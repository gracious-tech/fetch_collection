  <para style="h">Mme Saam</para>
  <para style="toc1">Mme Saam</para>
  <para style="toc2">Mme Saam</para>
  <para style="toc3">Saam</para>
  <para style="mt1">Mme Saam</para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="ms">Akpa Ñwed</para>
  <para style="mr">
    <ref loc="PSA 1-41">Mme Saam 1–41</ref></para>
  <para style="cl">Saam 1</para>
  <para style="s1">Usʌñ A-akaaha Inemesịd</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1" />Afọfọn anọ awo</para>
  <para style="q2" vid="PSA 1:1">i-imiisañake ke item mbon ibak</para>
  <para style="q1" vid="PSA 1:1">i-imiinyʌññọ ida ke usʌñ</para>
  <para style="q2" vid="PSA 1:1">a-mme anamidiọọk esañake</para>
  <para style="q2" vid="PSA 1:1">i-imiinyʌññọ itie ke itie mbon nsaha,<verse eid="PSA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2" />ado inemesịd amọ ado ke mbed <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 1:2">anye anyʌñ akere abaña mbed amọ uweemeayio ye akonayio.<verse eid="PSA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3" />Awo ado aba nte eto etọọhọ ke mben mme idịm mmọọñ,</para>
  <para style="q2" vid="PSA 1:3">a-asioho mfịd amọ ke akemini</para>
  <para style="q1" vid="PSA 1:3">a-mfañ amọ imiinyʌññọ ibeghe ,</para>
  <para style="q2" vid="PSA 1:3">se adodo a-ammọ enanam awuọñọ usʌñ.<verse eid="PSA 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4" />Mbon ibak ibaaha ntom!</para>
  <para style="q2" vid="PSA 1:4">Ammọ eba nte mbio</para>
  <para style="q2" vid="PSA 1:4">a-afịm asuanna.<verse eid="PSA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5" />Ke ntoro, mbon ibak idiidaaha ke ikpe,</para>
  <para style="q2" vid="PSA 1:5">mme anamidiọọk idiinyʌññọ iba ke atu ndinen awo.<verse eid="PSA 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6" />Sia <char style="nd">Abọọñ</char> ase ñkpọ abaña usʌñ ndinen awo,</para>
  <para style="q2" vid="PSA 1:6">ado usʌñ mme anamidiọọk aben awo akaa nsobo.<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="cl">Saam 2</para>
  <para style="s1">Adidem <char style="nd">Abọọñ</char> Amekke</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1" />Nsoo inam nọ mme idịd edʌk idiọọk adu,</para>
  <para style="q2" vid="PSA 2:1">ñko mme awo enyʌñ eduak idiọọk uduak ke ikpu-ikpu usʌñ?<verse eid="PSA 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2" />Mme ndidem isọñ edaaña eda</para>
  <para style="q2" vid="PSA 2:2">mme adaukara enyʌñ eboho ammọ-ammọ</para>
  <para style="q2" vid="PSA 2:2">enwana ye <char style="nd">Abọọñ</char> ye anye a-anye akeyette adan, ete,<verse eid="PSA 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3" />“Yak ñnyịn ibʌñ akpọnọ ammọ</para>
  <para style="q2" vid="PSA 2:3">inyʌñ ikọññọ mme ñkprọñ ammọ isio.”<verse eid="PSA 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4" />Anye a-atieghe ke ebekpo ke anyọñ asak;</para>
  <para style="q2" vid="PSA 2:4">
    <char style="nd">Abọọñ</char> adọọñ ammọ ndọk.<verse eid="PSA 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5" />Anye asua anọ ammọ ke iyadesịd amọ</para>
  <para style="q2" vid="PSA 2:5">anyʌñ adịkke ammọ ke ifiobesịd amọ, ate,<verse eid="PSA 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6" />“Ami mmenịm adidem mmi</para>
  <para style="q2" vid="PSA 2:6">ke Saiyọn, adisana abod mmi.”<verse eid="PSA 2:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="PSA 2:7" />Ñyaatañ mbaña ewʌhọ <char style="nd">Abọọñ</char>:</para>
  <para style="b" vid="PSA 2:7" />
  <para style="q1" vid="PSA 2:7">Anye akembo miin, “Afo ado ayịn mmi;</para>
  <para style="q2" vid="PSA 2:7">mfịn ami mmekappa ubon fiin.<verse eid="PSA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8" />Mbeeñe miin,</para>
  <para style="q2" vid="PSA 2:8">ndin ñyaayaak mme idịd unọ nte udeeme mfo,</para>
  <para style="q2" vid="PSA 2:8">mme utịd ederimbod nte inie mfo.<verse eid="PSA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9" />Afo ayaaboom ammọ ke esañ ukwak;</para>
  <para style="q2" vid="PSA 2:9">ayaanuak ammọ mbai-mbai nte ñkpọ e-ebotto ke aduañ.”<verse eid="PSA 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10" />Ke ntoro, ndufo ndidem, enie aniọñ;</para>
  <para style="q2" vid="PSA 2:10">ndufo mme akara ederimbod, ikpeme idem.<verse eid="PSA 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11" />Inam ñkpọ inọ <char style="nd">Abọọñ</char> ye ndịk</para>
  <para style="q2" vid="PSA 2:11">inyʌñ idaara ukara amọ ye uteeñe.<verse eid="PSA 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12" />Itʌm ayịn awodeen amọ inua, imiidooho ntoro anye ayaayat esịd</para>
  <para style="q2" vid="PSA 2:12">ndin usʌñ ndufo ayaidat ndufo adʌk ke nsobo,</para>
  <para style="q1" vid="PSA 2:12">sia ifiobesịd amọ akeme adibịppe ke etək-etək ini.</para>
  <para style="q2" vid="PSA 2:12">Afọfọn anọ afịd mbon e-edịbeke ke anye.<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="cl">Saam 3<note caller="+" style="f"><char style="fr" closed="false">3:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 3:1-8 ewet Saam 3:2-9</char></note></para>
  <para style="d">Saam Defid. Ke ini anye akefegheke abọkkọ ayịn amọ Absalọm.</para>
  <para style="s1">Akam E-ebọññọ ke Ñkịmñnwaña Ubakusen</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1" />
    <char style="nd">Abọọñ</char>, mme asua mmi ewak die!</para>
  <para style="q2" vid="PSA 3:1">Awo ifañ edakka eda eñkọbọ miin!<verse eid="PSA 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2" />Uwak awo etañ embaña miin ete,</para>
  <para style="q2" vid="PSA 3:2">“Abasi idiinyaañake anye.”<verse eid="PSA 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3" />Ado afo, <char style="nd">Abọọñ</char>, ado atuekọñ añkannake miin akʌk,</para>
  <para style="q2" vid="PSA 3:3">ubọọñ mmi, ye Anye a-anamma etịñiwuod mmi akoñ.<verse eid="PSA 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4" />Ami mbọọñ ñkoot <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 3:4">ndin anye atie ke adisana abod amọ añyie miin.<verse eid="PSA 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5" />Ami nsuuk nnaa ndaiya;</para>
  <para style="q2" vid="PSA 3:5">Mmaana ndemme, sia <char style="nd">Abọọñ</char> ammʌm miin akama.<verse eid="PSA 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6" />Ami ndiifegheke ndịk akpekọm mme awo tọsịn duoboduob</para>
  <para style="q2" vid="PSA 3:6">eñkanna miin ekʌk enyʌñ enam ikọ ye ami.<verse eid="PSA 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7" />Dakka da, <char style="nd">Abọọñ</char>!</para>
  <para style="q2" vid="PSA 3:7">Ñnyaaña miin, Abasi mmi!</para>
  <para style="q1" vid="PSA 3:7">Yʌppọ afịd mme asua mmi ke mbañ;</para>
  <para style="q2" vid="PSA 3:7">bʌñ eded mbon ibak.<verse eid="PSA 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8" />Adinyaaña ato <char style="nd">Abọọñ</char>.</para>
  <para style="q2" vid="PSA 3:8">Yak adidiọñ mfo adoro ikọd mfo ke idem.<verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="cl">Saam 4<note caller="+" style="f"><char style="fr" closed="false">4:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 4:1-8 ewet Saam 4:2-9</char></note></para>
  <para style="d">Anye ami anie adadusʌñ ke ikwọ.Ye mme ndido udʌk. Saam Defid.</para>
  <para style="s1">Akam Ndubiayio</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1" />Ñyie miin ke ini ami mma ukoot fiin,</para>
  <para style="q2" vid="PSA 4:1">Adinen Abasi mmi.</para>
  <para style="q1" vid="PSA 4:1">Mbappa miin mbaba sio ke ukuud mmi;</para>
  <para style="q2" vid="PSA 4:1">ntua miin mbọm nyʌñ kop akam mmi.<verse eid="PSA 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2" />Adaña die ke ndufo ediinam ubọọñ mmi akappa ñkpọ abuud?</para>
  <para style="q2" vid="PSA 4:2">Adaña die ke ndufo ediima ndukpọñ-ndukpọñ ñkpọ enyʌñ eyem mme nsu-nsu abasi?<verse eid="PSA 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3" />Ndufo idiọọñọ ibo ke <char style="nd">Abọọñ</char> asio anam akpanikọ awo utom amọ anịm asaña-asaña anọ idem amọ;</para>
  <para style="q2" vid="PSA 4:3">
    <char style="nd">Abọọñ</char> akop ke ini ami ñkoodo anye.<verse eid="PSA 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4" />Iba ke uteeñe ikiinam idiọọkñkpọ;</para>
  <para style="q2" vid="PSA 4:4">ke ini ndufo enaaha ke ñkpana ndufo,</para>
  <para style="q2" vid="PSA 4:4">iduuñọ esịd ndufo inyʌñ iba ke ndobuyio.<verse eid="PSA 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5" />Iwa mme uwa ndinen awo</para>
  <para style="q2" vid="PSA 4:5">inyʌñ ibuọt idem ke <char style="nd">Abọọñ</char>.<verse eid="PSA 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6" />
    <char style="nd">Abọọñ</char>, uwak awo esʌk ebịp ebo, “Anie adiidat uforo isọk ñnyịn?”</para>
  <para style="q2" vid="PSA 4:6">Yak unwana iso mfo ayama inọ ñnyịn.<verse eid="PSA 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7" />Yọhọ esịd mmi ye idaara</para>
  <para style="q2" vid="PSA 4:7">ke ini abakpa ye ufa ukọd ammọ eyọhọke isọñ.<verse eid="PSA 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8" />Ami ñyaasuuk nnaa ndaiya ke emem,</para>
  <para style="q2" vid="PSA 4:8">sia afo, <char style="nd">Abọọñ</char>, ikpọọñ,</para>
  <para style="q2" vid="PSA 4:8">anam nọ mba ke ifuuro.<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="cl">Saam 5<note caller="+" style="f"><char style="fr" closed="false">5:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 5:1-12 ewet Saam 5:2-13</char></note></para>
  <para style="d">Anye ami anie adadusʌñ ke ikwọ. Ekama adʌk. Saam Defid.</para>
  <para style="s1">Akam Ebọññọ Eyem Unwam</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1" />Kpañ utọñ kop ikọ mmi, <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 5:1">kere baña aseeme mmi.<verse eid="PSA 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2" />Kop ayịd a-ami ntuaha ñyem unwam,</para>
  <para style="q2" vid="PSA 5:2">Adidem mmi ye Abasi mmi,</para>
  <para style="q2" vid="PSA 5:2">sia ami mbọñ akam unọ fiin.<verse eid="PSA 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3" />
    <char style="nd">Abọọñ</char>, ubakusen afo akop uyio mmi;</para>
  <para style="q2" vid="PSA 5:3">ubakusen ami nnịm mme ebeeñe mmi ke iso mfo</para>
  <para style="q2" vid="PSA 5:3">ñnyʌñ mbed ye idodanyen.<verse eid="PSA 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4" />Sia afo udooho Abasi a-anemme esịd abaña ibak;</para>
  <para style="q2" vid="PSA 5:4">afo udaarake mbon ndoom.<verse eid="PSA 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5" />Mbon ntañidem ikanna ida</para>
  <para style="q2" vid="PSA 5:5">ke iso mfo.</para>
  <para style="q1" vid="PSA 5:5">Afo asuasua mme anam idiọọk;<verse eid="PSA 5:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 5:6" />afo asoosobo mme asʌhọ nsu.</para>
  <para style="q1" vid="PSA 5:6">Mme mbon afai ye mbon abiaña</para>
  <para style="q2" vid="PSA 5:6">afo, <char style="nd">Abọọñ</char>, asuasua.<verse eid="PSA 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7" />Ado ami, ato ke ntak ekamba ima mfo,</para>
  <para style="q2" vid="PSA 5:7">mmekeme adidʌk esịd ufọk mfo;</para>
  <para style="q1" vid="PSA 5:7">ke uteeñe ami mmetuak iwuod</para>
  <para style="q2" vid="PSA 5:7">ke adisana tembịd mfo.<verse eid="PSA 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8" />
    <char style="nd">Abọọñ</char>, ndat miin usʌñ ke adinenido mfo</para>
  <para style="q2" vid="PSA 5:8">mbaak mme asua mmi;</para>
  <para style="q2" vid="PSA 5:8">nam usʌñ mfo ado nnen-nnen ke iso mmi.<verse eid="PSA 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9" />Akpanikọ ndomokeed ibaaha ammọ ke inua;</para>
  <para style="q2" vid="PSA 5:9">esịd ammọ ayọhọ ye isiọ.</para>
  <para style="q1" vid="PSA 5:9">Usʌñitọñ ammọ ado anainwañ udi;</para>
  <para style="q2" vid="PSA 5:9">ekama edeme ammọ esʌhọ nsu.<verse eid="PSA 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10" />Biom ammọ ikpe, O Abasi!</para>
  <para style="q2" vid="PSA 5:10">Yak mbufiọk ammọ ado ñkpọiduọ anọ ammọ.</para>
  <para style="q1" vid="PSA 5:10">Bịn ammọ sioño ke ntak uwak idiọọkñkpọ ammọ,</para>
  <para style="q2" vid="PSA 5:10">sia ammọ e-esọñ iwuod ye afo.<verse eid="PSA 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11" />Ado yak afịd mbon se idịbe ke idak mfo enem esịd;</para>
  <para style="q2" vid="PSA 5:11">yak ammọ ekwọ ikwọ idaara afịd ini.</para>
  <para style="q1" vid="PSA 5:11">Tat ukpeme mfo fʌk ammọ,</para>
  <para style="q2" vid="PSA 5:11">nọ mbon e-emaaha anyịñ mfo edat esịd ke afo.<verse eid="PSA 5:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12" />Ke akpanikọ, <char style="nd">Abọọñ</char>, afo amediọñ mme adinen awo;</para>
  <para style="q2" vid="PSA 5:12">amekanna ammọ akʌk ye mfọn mfo nte adat atuekọñ awañ ammọ.<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="cl">Saam 6<note caller="+" style="f"><char style="fr" closed="false">6:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 6:1-10 ewet Saam 6:2-11</char></note></para>
  <para style="d">Anye ami anie adadusʌñ ke ikwọ. Ye mme ndido udʌk. Akeene <char style="tl">seminid.</char> Saam Defid.</para>
  <para style="s1">Akam Ebọññọ ke ini Afanekọñ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1" />
    <char style="nd">Abọọñ</char>, kuusua unnọ miin ke iyadesịd mfo</para>
  <para style="q2" vid="PSA 6:1">kuunyʌñ untʌnọ miin ke ifiobesịd mfo.<verse eid="PSA 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2" />Ntua miin mbọm, <char style="nd">Abọọñ</char>, sia idem ammem;</para>
  <para style="q2" vid="PSA 6:2">ñkọk miin, <char style="nd">Abọọñ</char>, sia mme akpọ mmi eba ke ndutʌhọ.<verse eid="PSA 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3" />Ukpọñ mmi aba ke akpọsọñ mfʌhọ.</para>
  <para style="q2" vid="PSA 6:3">Adiikpeene die, <char style="nd">Abọọñ</char>, adiikpeene die?<verse eid="PSA 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4" />Wọññọ, <char style="nd">Abọọñ</char>, nyʌñ ñnyaaña miin;</para>
  <para style="q2" vid="PSA 6:4">ñnyaaña miin ke ntak ima mfo a-adooho akenam ikpuuho.<verse eid="PSA 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5" />Ke atu mme akpañkpa awo ndomokeed itañña ase anyịñ mfo.</para>
  <para style="q2" vid="PSA 6:5">Anie awo utooro fiin ke udi?<verse eid="PSA 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6" />Ami mmekpa mba ato ke mmịm mmi.</para>
  <para style="b" vid="PSA 6:6" />
  <para style="q1" vid="PSA 6:6">Afịd akonayio ami mfiọọrọ ñkpana mmi ye mmọọñayịd;</para>
  <para style="q2" vid="PSA 6:6">ñnyʌñ nduọk mmọọñayịd ñyọhọ ñkpọnnaa mmi.<verse eid="PSA 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7" />Anyen añkịm anọ mfʌhọ;</para>
  <para style="q2" vid="PSA 6:7">anyen ambre ke ntak afịd mme asua mmi.<verse eid="PSA 6:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8" />Indakka miin ke iso, afịd ndufo mme anam ndoom,</para>
  <para style="q2" vid="PSA 6:8">sia <char style="nd">Abọọñ</char> a-akop uyio ayịd mmi.<verse eid="PSA 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9" />
    <char style="nd">Abọọñ</char> akop ntuaña ñkpeubọk mmi;</para>
  <para style="q2" vid="PSA 6:9">
    <char style="nd">Abọọñ</char> abọ akam mmi.<verse eid="PSA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10" />Afịd mme asua mmi eyaekịt abuud enyʌñ eba ke ndutʌhọ;</para>
  <para style="q2" vid="PSA 6:10">ammọ eyaetịmme edem, enyʌñ edia abuud ini keed ini keed.<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="cl">Saam 7<note caller="+" style="f"><char style="fr" closed="false">7:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 7:1-17 ewet Saam 7:2-18</char></note></para>
  <para style="d">
    <char style="tl">Sikaion</char> ake Defid, anye akekwọọhọ anọ <char style="nd">Abọọñ</char> ke abaña Kuus, awo ubon Benyamin.</para>
  <para style="s1">Afịd se <char style="nd">Abọọñ</char> Ase Anam Afọñ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1" />
    <char style="nd">Abọọñ</char> Abasi mmi, ami ndịbe ke afo;</para>
  <para style="q2" vid="PSA 7:1">ñnyaaña nyʌñ nsio miin ke ubọk afịd mbon se imbịne miin<verse eid="PSA 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2" />imiidooho ntoro ammọ eyaenwai miin nte ekpe</para>
  <para style="q2" vid="PSA 7:2">enyʌñ ensep mbai-mbai ibaaha awo se iñnyaaña ibọ isuuk.<verse eid="PSA 7:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3" />
    <char style="nd">Abọọñ</char> Abasi mmi, akpedo mmenam ami</para>
  <para style="q2" vid="PSA 7:3">ndin ndudue aba ke ubọk mmi;<verse eid="PSA 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4" />akpedo mmedat idiọọk nsio ufan mmi usiene eti ñkpọ</para>
  <para style="q2" vid="PSA 7:4">me ñyịp ñkpọ asua mmi ke unana ntak,<verse eid="PSA 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5" />yak asua mmi ambịne anyʌñ amboiyo miin iso;</para>
  <para style="q2" vid="PSA 7:5">yak anye asọnnọ uwem mmi ke isọñ</para>
  <para style="q2" vid="PSA 7:5">anyʌñ anam ami nnaa ke ntọñ.<verse eid="PSA 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6" />Dakka da, <char style="nd">Abọọñ</char>, ke iyadesịd mfo;</para>
  <para style="q2" vid="PSA 7:6">benne idem mfo ke abaña ifiobesịd mme asua mmi.</para>
  <para style="q2" vid="PSA 7:6">Demme, Abasi mmi; kpe unen.<verse eid="PSA 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7" />Yak mme esob ubon awo ukanna fiin ekʌk,</para>
  <para style="q2" vid="PSA 7:7">ke ini afo atieghe ke ebekpo ke ñkoñ-ñkoñ itie.<verse eid="PSA 7:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 7:8" />Yak <char style="nd">Abọọñ</char> akpe ikpe mme awo.</para>
  <para style="q1" vid="PSA 7:8">Kpe ikpe mmi, <char style="nd">Abọọñ</char>, nọ asaña akekem ye eti ido mmi,</para>
  <para style="q2" vid="PSA 7:8">nọ asaña akekem ye mfọnmma mmi, O Ataa Andikoñ.<verse eid="PSA 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9" />Nam ido afai mbon ibak atre</para>
  <para style="q2" vid="PSA 7:9">nyʌñ nam adinen awo asọọñọ ada;</para>
  <para style="q1" vid="PSA 7:9">afo, adinen Abasi</para>
  <para style="q2" vid="PSA 7:9">a-aduuñọke akikere ye esịd mme awo.<verse eid="PSA 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10" />Ñkoñ Ñkan Abasi ado atuekọñ mmi,</para>
  <para style="q2" vid="PSA 7:10">a-akenyaañake mbon se inen ke esịd.<verse eid="PSA 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11" />Abasi ado akpeunen ikpe,</para>
  <para style="q2" vid="PSA 7:11">Abasi a-awọttọ iyadesịd amọ afịd usen.<verse eid="PSA 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12" />Adieke anye imiikappake esịd,</para>
  <para style="q2" vid="PSA 7:12">anye ayaaban akañkañ amọ;</para>
  <para style="q2" vid="PSA 7:12">anye ayaakọọk utịgha amọ.<verse eid="PSA 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13" />Anye abeeñe mme ñkpọ ekọñ nsobo amọ;</para>
  <para style="q2" vid="PSA 7:13">anekke mme asak ikañ idañ amọ anịm.<verse eid="PSA 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14" />Awo akeedodo a-ayommoke idiọọk</para>
  <para style="q2" vid="PSA 7:14">akere mfịna anyʌñ aman unana idodanyen.<verse eid="PSA 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15" />Awo akeedodo a-atịppeke ube asioño ntan</para>
  <para style="q2" vid="PSA 7:15">kpa anye aduọ adʌk ube a-ammọ eketịppeke.<verse eid="PSA 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16" />Mfịna a-ammọ enamma atịmme akeene ammọ;</para>
  <para style="q2" vid="PSA 7:16">afai ammọ asọiyọ adoro ammọ ke iwuod.<verse eid="PSA 7:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17" />Ami ñyaanọ <char style="nd">Abọọñ</char> ekọọm ke ntak adinenido amọ;</para>
  <para style="q2" vid="PSA 7:17">Ami ñyaakwọ itooro anyịñ <char style="nd">Abọọñ</char> Andikoñ Ñkan.<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="cl">Saam 8<note caller="+" style="f"><char style="fr" closed="false">8:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 8:1-9 ewet Saam 8:2-10</char></note></para>
  <para style="d">Anye ami anie adadusʌñ ke ikwọ. Akeene <char style="tl">kittid.</char> Saam Defid.</para>
  <para style="s1">Utịppe Anyịñ <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1" />
    <char style="nd">Abọọñ</char>, <char style="nd">Abọọñ</char> ñnyịn,</para>
  <para style="q2" vid="PSA 8:1">anyịñ mfo akpon die ke afịd ederimbod!</para>
  <para style="b" vid="PSA 8:1" />
  <para style="q1" vid="PSA 8:1">Afo amedot ubọọñ mfo</para>
  <para style="q2" vid="PSA 8:1">ke mme hefịn.<verse eid="PSA 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2" />Ato ke itooro ntəkayịn ye ake mme nsek nditọ</para>
  <para style="q2" vid="PSA 8:2">afo amebọp akọ abaha mme asua mfo,</para>
  <para style="q2" vid="PSA 8:2">nọ akʌp asua ye asiousiene inua.<verse eid="PSA 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3" />Ami mmaatie ñkere mme hefịn mfo,</para>
  <para style="q2" vid="PSA 8:3">ubọkutom mme nnuunubọk mfo,</para>
  <para style="q1" vid="PSA 8:3">afiọñ ye mme ntantaafiọñ,</para>
  <para style="q2" vid="PSA 8:3">ake afo abonoke ke itie ammọ,<verse eid="PSA 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4" />nsoo ido ubonawo nọ afo akere abaña anye,</para>
  <para style="q2" vid="PSA 8:4">mme awo edo nsoo nọ afo ase ñkpọ abaña ammọ?<verse eid="PSA 8:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5" />Afo amenam ammọ esuuhọ etək-etək ekan mme enyere</para>
  <para style="q2" vid="PSA 8:5">anyʌñ ayat ammọ anyanya ubọọñ ye ukpono.<verse eid="PSA 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6" />Afo amaanam ammọ edo mme andikaara mme ubọkutom mfo;</para>
  <para style="q2" vid="PSA 8:6">afo abono afịd ñkpọ ke idak ñkpad ammọ:<verse eid="PSA 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7" />afịd udịmedọñ ye udịmenañ,</para>
  <para style="q2" vid="PSA 8:7">ye mme unam ke akai ikọd,<verse eid="PSA 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8" />mme inuen ke ikpaanyọñ,</para>
  <para style="q2" vid="PSA 8:8">ye iyak ke akpainyañ,</para>
  <para style="q2" vid="PSA 8:8">afịd se iwọk ke mme usʌñ akpainyañ.<verse eid="PSA 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9" />
    <char style="nd">Abọọñ</char>, <char style="nd">Abọọñ</char> ñnyịn,</para>
  <para style="q2" vid="PSA 8:9">anyịñ mfo akpon die ke afịd ederimbod!<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="cl">Saam 9<note caller="+" style="f"><char style="fr" closed="false">9:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 9:1-20 ewet Saam 9:2-21</char></note></para>
  <para style="d">Anye ami anie adadusʌñ ke ikwọ. Abaña “Ñkpa Ayịn awodeen.” Saam Defid.</para>
  <para style="s1">Kwọ Itooro Nọ <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1" />Ami ñyaunọ fiin ekọọm, <char style="nd">Abọọñ</char>, ke afịd esịd mmi;</para>
  <para style="q2" vid="PSA 9:1">Ñyaatañ mbaña afịd utịppe adinam mfo.<verse eid="PSA 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2" />Ami ñyaanem esịd ñnyʌñ ndaara ke afo;</para>
  <para style="q2" vid="PSA 9:2">Ñyaakwọ itooro anyịñ mfo, O Andikoñ Ñkan.<verse eid="PSA 9:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3" />Mme asua mmi etịmme edem;</para>
  <para style="q2" vid="PSA 9:3">ammọ eduọ enyʌñ esobo ke iso mfo.<verse eid="PSA 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4" />Sia afo amaabenne unen mmi ye ikọ mmi,</para>
  <para style="q2" vid="PSA 9:4">atie ke ebekpo nte akpe unen ikpe.<verse eid="PSA 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5" />Afo amesua anọ mme idịd anyʌñ asobo mbon ibak;</para>
  <para style="q2" vid="PSA 9:5">amesọọk anyịñ ammọ asio ke nsi-nsi nsi-nsi.<verse eid="PSA 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6" />Nsi-nsi nsobo asịm mme asua mmi,</para>
  <para style="q2" vid="PSA 9:6">afo amesobo afịd mme abio ammọ;</para>
  <para style="q2" vid="PSA 9:6">awo ikemekekeme aditoiyo ammọ aba.<verse eid="PSA 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7" />
    <char style="nd">Abọọñ</char> ada ukara ke nsi-nsi;</para>
  <para style="q2" vid="PSA 9:7">anye anịm ebekpo amọ adikpe ikpe.<verse eid="PSA 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8" />Anye akara ederimbod ke unen</para>
  <para style="q2" vid="PSA 9:8">anyʌñ akpe ikpe mme awo nte adotto.<verse eid="PSA 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9" />
    <char style="nd">Abọọñ</char> ado itie udịbe anọ mbon e-efiighe,</para>
  <para style="q2" vid="PSA 9:9">itie ubọkkọ ke ini afanekọñ.<verse eid="PSA 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10" />Mbon se idiọọñọ anyịñ mfo enie mbuọdidem ke idem mfo,</para>
  <para style="q2" vid="PSA 9:10">sia afo, <char style="nd">Abọọñ</char>, akenam ukpọññọ mbon se uyem fiin.<verse eid="PSA 9:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11" />Ikwọ itooro <char style="nd">Abọọñ</char>, a-adʌññọ ke Saiyọn;</para>
  <para style="q2" vid="PSA 9:11">Itañ inọ mme idịd se anye anam.<verse eid="PSA 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12" />Sia anye a-asioho usiene iyiib a-atoiyo;</para>
  <para style="q2" vid="PSA 9:12">anye ifreke ntuaña mbon ñkpọnnam.<verse eid="PSA 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13" />
    <char style="nd">Abọọñ</char>, se naña mme asua mmi eñkuut miin!</para>
  <para style="q2" vid="PSA 9:13">Ntua miin mbọm nyʌñ ndịppe miin sio ke inuaatob ñkpa,<verse eid="PSA 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14" />nọ ato do ntañ ase mfo</para>
  <para style="q2" vid="PSA 9:14">ke mme inuaatob Adiaha Saiyọn,</para>
  <para style="q2" vid="PSA 9:14">ñnyʌñ ndaara adinyaaña mfo do.<verse eid="PSA 9:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15" />Mme idịd eduọññọ edʌk ube a-ammọ eketịppeke;</para>
  <para style="q2" vid="PSA 9:15">iyịre ake ammọ ekedịppe amʌm ammọ ukod.<verse eid="PSA 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16" />Ediọọñọ <char style="nd">Abọọñ</char> eto ke mme unen adinam ammọ;</para>
  <para style="q2" vid="PSA 9:16">ubọkutom mbon ibak, kpa anye adiimʌm ammọ ukad.<verse eid="PSA 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17" />Mbon ibak esọiyọ edʌk ke itie mme akpañkpa,</para>
  <para style="q2" vid="PSA 9:17">afịd idịd se ifre Abasi.<verse eid="PSA 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18" />Ado Abasi idiifreke ayịn uweene tutu amama;</para>
  <para style="q2" vid="PSA 9:18">idodanyen mbon ñkpọnnam idiitakka tutu amama.<verse eid="PSA 9:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19" />Dakka da, <char style="nd">Abọọñ</char>, kuuyak ubon awo akan;</para>
  <para style="q2" vid="PSA 9:19">yak ekpe ikpe mme idịd ke iso mfo.<verse eid="PSA 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20" />Nam ammọ ekop ndịk, <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 9:20">yak mme idịd ediọọñọ ke mmimọ idoñño ñkaña awo.<verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="cl">Saam 10</para>
  <para style="s1">Akam Ebọññọ Eyem Unwam</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1" />
    <char style="nd">Abọọñ</char>, nsoo inam nọ afo ada nsan-nsan?</para>
  <para style="q2" vid="PSA 10:1">Nsoo inam nọ afo adịp idem mfo ke ini mfịna?<verse eid="PSA 10:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2" />Ke ntañidem amọ awo ibak atʌkkọ awo uweene,</para>
  <para style="q2" vid="PSA 10:2">e-eduọññọke edọñọ ndiọi uduak a-anye aduakka anọ ammọ.<verse eid="PSA 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3" />Anye aduaak inua abaña udọñ esịd amọ;</para>
  <para style="q2" vid="PSA 10:3">anye adiọñ mme adiọọkitọñ anyʌñ anam se idiọọk ye <char style="nd">Abọọñ</char>.<verse eid="PSA 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4" />Ke ntañidem amọ awo ibak iyemme Abasi;</para>
  <para style="q2" vid="PSA 10:4">ke afịd akikere amọ ufañ ibaaha inọ Abasi.<verse eid="PSA 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5" />Usʌñ amọ anie uforo afịd ini;</para>
  <para style="q2" vid="PSA 10:5">anye asịn mbed mfo;</para>
  <para style="q2" vid="PSA 10:5">asak afịd mme asua amọ nsaha.<verse eid="PSA 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6" />Anye abo idem amọ ate, “Ñkpọ ndomokeed idintəkkoke miin.”</para>
  <para style="q2" vid="PSA 10:6">Anye anwọñọ ate, “Awo ndomokeed idiikanna innam miin idiọọkñkpọ.”<verse eid="PSA 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7" />Inua amọ ayọhọ ye nsu ye ndịkke;</para>
  <para style="q2" vid="PSA 10:7">mfịna ye ibak esịne ke idak edeme amọ.<verse eid="PSA 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8" />Anye anaa ke itie udịbe a-akpereke mme esịd idʌñ;</para>
  <para style="q2" vid="PSA 10:8">asịne do awoot mbon ake imiidueghe.</para>
  <para style="q1" vid="PSA 10:8">Anyen ammọ asʌk ayep mbon se anye ayem idat uwem;<verse eid="PSA 10:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 10:9" />Anye adịbe abet nte ekpe ke itie nnaa ammọ.</para>
  <para style="q1" vid="PSA 10:9">Anye adịbe abet adimʌm mbon se imiinieghe unwam;</para>
  <para style="q2" vid="PSA 10:9">anye amʌm ammọ anyʌñ adʌt ammọ asịn ke iyịre amọ.<verse eid="PSA 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10" />Ammọ esobo, eduọññọ;</para>
  <para style="q2" vid="PSA 10:10">ammọ eduọññọ ke idak adudu amọ.<verse eid="PSA 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11" />Anye abo idem amọ, “Abasi idiikịtte tutu amama;</para>
  <para style="q2" vid="PSA 10:11">anye afʌk iso amọ inyʌññọ ikịt tutu amama.”<verse eid="PSA 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12" />Dakka da, <char style="nd">Abọọñ</char>! Benne ubọk mfo, O Abasi.</para>
  <para style="q2" vid="PSA 10:12">Kuufre mbon ake imiinieghe unwam.<verse eid="PSA 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13" />Nsoo ido ntak awo ibak asịnne Abasi ke ndek?</para>
  <para style="q2" vid="PSA 10:13">Nsoo inam anye abo,</para>
  <para style="q2" vid="PSA 10:13">“Anye idiñkoodo miin yak ndinam ibad”?<verse eid="PSA 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14" />Ado afo, Abasi, amekịt mfịna mbon ñkpọnnam;</para>
  <para style="q2" vid="PSA 10:14">afo ameda ase ukuud ammọ anyʌñ aben ayọ.</para>
  <para style="q1" vid="PSA 10:14">Mbon ake imiinieghe unwam eyaak idem ammọ esịn ke ukpeme mfo;</para>
  <para style="q2" vid="PSA 10:14">afo ado unwam nditọakpa.<verse eid="PSA 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15" />Buuñ ubọk awo ibak;</para>
  <para style="q2" vid="PSA 10:15">koot anam idiọọk yak adinam ibad ibak amọ</para>
  <para style="q2" vid="PSA 10:15">ake awo ndomokeed imiikpikidiọọñọke.<verse eid="PSA 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16" />
    <char style="nd">Abọọñ</char> ado adidem ke nsi-nsi nsi-nsi;</para>
  <para style="q2" vid="PSA 10:16">mme idịd eyaetak ke isọñ amọ.<verse eid="PSA 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17" />Afo, <char style="nd">Abọọñ</char>, kop se ido udọñ mbon ñkpọnnam;</para>
  <para style="q2" vid="PSA 10:17">afo asọọñọ amọ idem, anyʌñ akpañ utọñ anọ ntuaña ammọ,<verse eid="PSA 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18" />akpeme nditọakpa ye mbon se efiik,</para>
  <para style="q2" vid="PSA 10:18">mbaak mme ñkaña awo</para>
  <para style="q2" vid="PSA 10:18">edisịn mme awo ndịk ke idem aba.<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="cl">Saam 11</para>
  <para style="d">Ake adadusʌñ ke ikwọ. Saam Defid.</para>
  <para style="s1">Mbuọdidem ke <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1" />Ami ndịbe ke <char style="nd">Abọọñ</char>.</para>
  <para style="q2" vid="PSA 11:1">Die ndin ke afo akeme adimbo miin:</para>
  <para style="q2" vid="PSA 11:1">“Fuurọ nte inuen kaa abod mfo.<verse eid="PSA 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2" />Sia se, mbon ibak ekọọk utịgha ammọ;</para>
  <para style="q2" vid="PSA 11:2">ammọ eneeñe idañ ammọ edoot ke udʌk</para>
  <para style="q1" vid="PSA 11:2">nọ etie ke ekịm etop</para>
  <para style="q2" vid="PSA 11:2">mbon se inen ke esịd.<verse eid="PSA 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3" />Emaewuut itiad idakisọñ,</para>
  <para style="q2" vid="PSA 11:3">nsoo ke ndinen awo ekeme edinam?”<verse eid="PSA 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4" />
    <char style="nd">Abọọñ</char> aba ke adisana tembịd amọ;</para>
  <para style="q2" vid="PSA 11:4">
    <char style="nd">Abọọñ</char> aba ke ebekpo amọ ke anyọñ.</para>
  <para style="q1" vid="PSA 11:4">Anye atie do ase afịd awo ke isọñ;</para>
  <para style="q2" vid="PSA 11:4">anyen amọ aduuñọ ammọ.<verse eid="PSA 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5" />
    <char style="nd">Abọọñ</char> aduuñọ ndinen awo,</para>
  <para style="q2" vid="PSA 11:5">amaado mbon ibak, mbon e-emaaha afai,</para>
  <para style="q2" vid="PSA 11:5">anye asua ammọ ataa eti-eti.<verse eid="PSA 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6" />Anye ayaadep edịm</para>
  <para style="q2" vid="PSA 11:6">ufiob-ufiob ukañ ake asakka ye sọlfọ afʌk mbon ibak;</para>
  <para style="q2" vid="PSA 11:6">ataa ufiob afịm adiido udeeme ammọ.<verse eid="PSA 11:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7" />Sia <char style="nd">Abọọñ</char> ado adinen</para>
  <para style="q2" vid="PSA 11:7">anye ama unen;</para>
  <para style="q2" vid="PSA 11:7">adinen awo ayaakịt anye iso.<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="cl">Saam 12<note caller="+" style="f"><char style="fr" closed="false">12:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 12:1-8 ewet Saam 12:2-9</char></note></para>
  <para style="d">Ake adadusʌñ ke ikwọ. Akeene <char style="tl">seminid.</char> Saam Defid.</para>
  <para style="s1">Akam Ebọññọ Eyem Unwam</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1" />Sịn unwam, <char style="nd">Abọọñ</char>, sia awo anam akpanikọ ndomokeed ibaaha aba;</para>
  <para style="q2" vid="PSA 12:1">utọ mbon ado esop ke ubon awo.<verse eid="PSA 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2" />Afịd awo esʌhọ nsu enọ mbọhọidʌñ ammọ;</para>
  <para style="q2" vid="PSA 12:2">ammọ enem inua ke ñkpọkinua</para>
  <para style="q2" vid="PSA 12:2">ado edịb abiaña ke esịd ammọ.<verse eid="PSA 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3" />Yak <char style="nd">Abọọñ</char> akʌp inua afịd mme nneminua ke ñkpọkinua</para>
  <para style="q2" vid="PSA 12:3">ye afịd mbon se iduaak inua;<verse eid="PSA 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4" />mbon e-ebooho,</para>
  <para style="q2" vid="PSA 12:4">“Edeme ñnyịn ke idiikama inie edikan;</para>
  <para style="q2" vid="PSA 12:4">edeme ñnyịn adiinwana inọ ñnyịn, anie ido abọọñ inọọ ñnyịn?”<verse eid="PSA 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5" />“Ke ntak a-adooho enam mme uweene edo mbịme, mbon unana enyʌñ emịm mmịm,</para>
  <para style="q2" vid="PSA 12:5">
    <char style="nd">Abọọñ</char> abo, ami ñyaadakka nda.</para>
  <para style="q2" vid="PSA 12:5">Ñyaanyaaña ammọ mbaak mbon ake eyemme ammọ ikọ.”<verse eid="PSA 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6" />Mme ikọ <char style="nd">Abọọñ</char> inieghe ndo,</para>
  <para style="q2" vid="PSA 12:6">eba nte silfa e-enamma asana ke ikañ,</para>
  <para style="q2" vid="PSA 12:6">nte kold e-enamma asana akañ itiaba.<verse eid="PSA 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7" />Afo, <char style="nd">Abọọñ</char>, ayaakpeme mbon unana</para>
  <para style="q2" vid="PSA 12:7">ayaakpeme ñnyịn, ifak ñnyịn asio ke ubọk mme idiọọk awo ke nsi-nsi,<verse eid="PSA 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8" />e-ekpọọrọke esaña</para>
  <para style="q2" vid="PSA 12:8">ke ini ubon awo enọọhọ se idiọọk ukpono.<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="cl">Saam 13<note caller="+" style="f"><char style="fr" closed="false">13:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 13:1-6 ewet Saam 13:2-6</char></note></para>
  <para style="d">Ake adadusʌñ ke ikwọ. Saam Defid.</para>
  <para style="s1">Akam E-ebọññọ Eyem Unwam <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1" />Abọọñ, adiikpeene die <char style="nd">Abọọñ</char>? Afo ayamfre miin ke nsi-nsi?</para>
  <para style="q2" vid="PSA 13:1">Afo adindịp miin iso mfo ikpeene die?<verse eid="PSA 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2" />Ami ndiinwana ye akikere mmi nọ akpeene die</para>
  <para style="q2" vid="PSA 13:2">ndin kwa usen nnie mfʌhọ ke esịd mmi?</para>
  <para style="q2" vid="PSA 13:2">Asua mmi adiñkan ikpeene die?<verse eid="PSA 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3" />Suuk anyen nse miin nyʌñ bọọrọ, <char style="nd">Abọọñ</char> Abasi mmi.</para>
  <para style="q2" vid="PSA 13:3">Nam anyen mmi anwaña, me idooho ntoro ñyaadaiya idab ñkpa,<verse eid="PSA 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4" />ndin asua mmi ayaabo, “Ami mmekan anye,”</para>
  <para style="q2" vid="PSA 13:4">mbon se inyʌñ inam ikọ ye ami eyaedaara ke ami mmaaduọ.<verse eid="PSA 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5" />Ado ami mbuọt idem ke ima mfo ake imiikpuuho;</para>
  <para style="q2" vid="PSA 13:5">esịd mmi adaara ke adinyaaña mfo.<verse eid="PSA 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6" />Ami ñyaakwọ itooro <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 13:6">sia anye afọn ye ami.<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="cl">Saam 14</para>
  <para style="d">Ake etubom ikwọ. Saam Defid.</para>
  <para style="s1">Awo Ndomokeed Ikemeke Adikaaña Edem Ñwọt <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1" />Ndisịme awo abo ke esịd ammọ ate,</para>
  <para style="q2" vid="PSA 14:1">“Abasi ibaaha.”</para>
  <para style="q1" vid="PSA 14:1">Ammọ edoñño mbon ñwo, enañña abʌd-abʌd ido;</para>
  <para style="q2" vid="PSA 14:1">ibaaha awo ndomokeed se inam eti ñkpọ.<verse eid="PSA 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2" />
    <char style="nd">Abọọñ</char> atie ke anyọñ asuuk anyen</para>
  <para style="q2" vid="PSA 14:2">ase ubon awo</para>
  <para style="q1" vid="PSA 14:2">me ayaakịt awo ndomokeed se inie ifiọk,</para>
  <para style="q2" vid="PSA 14:2">ndomokeed a-ayemme Abasi.<verse eid="PSA 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3" />Afịd ammọ e-ewọññọ ekpọñ usʌñ, afịd ammọ e-ekappa mbubịk;</para>
  <para style="q2" vid="PSA 14:3">ibaaha awo ndomokeed a-anamma eti ñkpọ,</para>
  <para style="q2" vid="PSA 14:3">ibaaha awo ndomokeed.<verse eid="PSA 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4" />Afịd mme anamidiọọk ami isʌkkọ idiọọñọ ñkpọ?</para>
  <para style="b" vid="PSA 14:4" />
  <para style="q1" vid="PSA 14:4">Ammọ eta mbon mmi nte eta uyo;</para>
  <para style="q2" vid="PSA 14:4">akenaanam ammọ ikoodo <char style="nd">Abọọñ</char>.<verse eid="PSA 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5" />Ado se ammọ do, eba ke akpọsọñ ndịk,</para>
  <para style="q2" vid="PSA 14:5">sia Abasi mmọdo ke atu ndinen awo.<verse eid="PSA 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6" />Ndufo mbon mbubịk ebiat uduak mbon uweene,</para>
  <para style="q2" vid="PSA 14:6">ado <char style="nd">Abọọñ</char> ado itie udịbe ammọ.<verse eid="PSA 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7" />O, ubaha nte adinyaaña Isrel akpetooho Saiyọn adi!</para>
  <para style="q2" vid="PSA 14:7">Ke ini <char style="nd">Abọọñ</char> amaamaana aben ikọd amọ e-eketañña esio anyọñ adi,</para>
  <para style="q2" vid="PSA 14:7">yak Yekọb adaara, Isrel anyʌñ anem esịd!<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="cl">Saam 15</para>
  <para style="d">Saam Defid.</para>
  <para style="s1">Anie Awo Ikeme Adikpono <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1" />
    <char style="nd">Abọọñ</char>, anie awo ikeme adidʌñ ke adisana atayad mfo?</para>
  <para style="q2" vid="PSA 15:1">Anie awo adiidʌñ ke adisana abod mfo?<verse eid="PSA 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2" />Awo ake usʌñ amọ imiinieghe ndudue,</para>
  <para style="q2" vid="PSA 15:2">a-anamma se ifọn,</para>
  <para style="q2" vid="PSA 15:2">a-atañña akpanikọ ato awọñesịd amọ;<verse eid="PSA 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3" />ake edeme amọ imiidọkkọ adidọk,</para>
  <para style="q2" vid="PSA 15:3">i-imiinamma mbọhọidʌñ amọ idiọọkñkpọ,</para>
  <para style="q2" vid="PSA 15:3">inyʌññọ itañ idiọọk ibaña mbon mfen;<verse eid="PSA 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4" />awo a-asọọnọ idiọọk awo</para>
  <para style="q2" vid="PSA 15:4">ado akpono mbon se ibaak <char style="nd">Abọọñ</char>;</para>
  <para style="q1" vid="PSA 15:4">awo a-akponoke enwọñọ amọ akpekọm anam die;</para>
  <para style="q2" vid="PSA 15:4">inyʌññọ ikpʌhọ mme akikere ammọ;<verse eid="PSA 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5" />awo a-awuọdọ uweene akʌk ibọọhọ udod;</para>
  <para style="q2" vid="PSA 15:5">ibọọhọ ubọkedem ibiọọñọ unen awo i-imiidueghe.</para>
  <para style="b" vid="PSA 15:5" />
  <para style="q1" vid="PSA 15:5">Awo akeedodo a-anamma mme ñkpọ ami</para>
  <para style="q2" vid="PSA 15:5">idiifegheke ndịk.<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="cl">Saam 16</para>
  <para style="d">
    <char style="tl">Miktam</char> Defid.</para>
  <para style="s1">Mfọñ Ñkan Ndumek</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1" />Ñkpeme miin, Abasi mmi,</para>
  <para style="q2" vid="PSA 16:1">sia ami ndịbe ke afo.<verse eid="PSA 16:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2" />Ami mbo <char style="nd">Abọọñ</char> nte, “Afo ado <char style="nd">Abọọñ</char> mmi;</para>
  <para style="q2" vid="PSA 16:2">ke aboiyoke afo ami nnieghe eti ñkpọ mfen.”<verse eid="PSA 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3" />Ami ntañ mbaña ndisana awo ke abio nte,</para>
  <para style="q2" vid="PSA 16:3">“Ammọ edo mbon ukpono ake afịd idadesịd mmi adoroke ke ammọ.”<verse eid="PSA 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4" />Mbon e-efegheke ekeene mme abasi mfen eyaekịt akpọsọñ ukuud.</para>
  <para style="q2" vid="PSA 16:4">Ami ndiiduọkkọ uwa iyiib nnọ mme utọ mme abasi ado</para>
  <para style="q2" vid="PSA 16:4">ndiinyʌññọ ñkoot anyịñ ammọ ke ñkpọkinua mmi.<verse eid="PSA 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5" />
    <char style="nd">Abọọñ</char>, afo ikpọọñ ado udeeme mmi ye kọọb mmi;</para>
  <para style="q2" vid="PSA 16:5">afo anam afia mmi asọọñọ ada.<verse eid="PSA 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6" />Mme udʌk adaña eduọññọ ennọ miin ke mme itie inemesịd;</para>
  <para style="q2" vid="PSA 16:6">ke akpanikọ ami mmenie uyaiya udeeme.<verse eid="PSA 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7" />Ñyaatooro <char style="nd">Abọọñ</char> ake annọọhọ miin item;</para>
  <para style="q2" vid="PSA 16:7">ke akonayio ñko esịd mmi annọ miin item.<verse eid="PSA 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8" />Ami ñwuuk anyen mmi ke <char style="nd">Abọọñ</char> afịd ini.</para>
  <para style="q2" vid="PSA 16:8">Sia anye abaaha ke ubọk nnasia mmi, ñkpọ ndomokeed idintəkkoke miin.<verse eid="PSA 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9" />Ke ntoro esịd mmi anem, edeme mmi anyʌñ adaara;</para>
  <para style="q2" vid="PSA 16:9">idem mmi ñko ayaaba ke ifuuro,<verse eid="PSA 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10" />sia afo uduñkpọññọ miin ke abioekpo,</para>
  <para style="q2" vid="PSA 16:10">uduunyʌññọ uyak adinen awo akpanikọ mfo akịt mbiara.<verse eid="PSA 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11" />Afo amenam ami ndiọọñọ usʌñ uwem;</para>
  <para style="q2" vid="PSA 16:11">afo ayañyọhọ miin ye inemesịd ke iso mfo,</para>
  <para style="q2" vid="PSA 16:11">ye mme nsi-nsi inem ñkpọ ke ubọk nnasia mfo.<verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="cl">Saam 17</para>
  <para style="d">Akam Defid.</para>
  <para style="s1">Akam Awo I-imiidueghe Ñkpọ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1" />Ñkop miin, <char style="nd">Abọọñ</char>, ñkpeubọk mmi anen;</para>
  <para style="q2" vid="PSA 17:1">kpañ utọñ nọ ayịd mmi.</para>
  <para style="q1" vid="PSA 17:1">Kop akam mmi,</para>
  <para style="q2" vid="PSA 17:1">itooho ñkpọkinua nsu.<verse eid="PSA 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2" />Yak utoppo ikpe mmi uto fiin;</para>
  <para style="q2" vid="PSA 17:2">yak anyen mfo akịt se inen.<verse eid="PSA 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3" />Akpekọm afo aduuñọ esịd mmi ase,</para>
  <para style="q2" vid="PSA 17:3">akpekọm afo anse miin ke akonayio anyʌñ andomo miin ase,</para>
  <para style="q1" vid="PSA 17:3">afo ayaakịt ke ami nduakka idiọọk ndomokeed;</para>
  <para style="q2" vid="PSA 17:3">inua mmi idueghe.<verse eid="PSA 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4" />Akpesʌkado mbon awo ekenwanake edinnọọ ubọkedem,</para>
  <para style="q2" vid="PSA 17:4">ami mmekpeme idem mmi mbaña usʌñ mbon afai</para>
  <para style="q2" vid="PSA 17:4">akeene se ñkpọkinua mfo awuuk.<verse eid="PSA 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5" />Ukod mmi amuum mme usʌñ mfo akama;</para>
  <para style="q2" vid="PSA 17:5">ñkpad mmi ifiọnnọke.<verse eid="PSA 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6" />Ami ukoot fiin, Abasi mmi, sia afo ayañyie miin;</para>
  <para style="q2" vid="PSA 17:6">kpañ utọñ mfo nnọ miin nyʌñ kop akam mmi.<verse eid="PSA 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7" />Ñwọt miin mme utịppeñkpọ e-etooho akwa ima mfo,</para>
  <para style="q2" vid="PSA 17:7">afo a-anyaañake ke ubọk nnasia mfo</para>
  <para style="q2" vid="PSA 17:7">mbon e-edịbeke ke idak mfo yak ebọkkọ mbon usua ammọ.<verse eid="PSA 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8" />Nnịm miin nte ñkpọuto mfo;</para>
  <para style="q2" vid="PSA 17:8">ndịp miin ke mfuud mba mfo<verse eid="PSA 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9" />nsio ke ubọk mbon ibak ake eyemme edinsobo miin,</para>
  <para style="q2" vid="PSA 17:9">nsio ke ubọk mme asua eñkannake miin ekʌk.<verse eid="PSA 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10" />Ammọ efʌk esịd ammọ a-adoroke ufiọn,</para>
  <para style="q2" vid="PSA 17:10">ndin inua ammọ etañ ikọ isa-isa.<verse eid="PSA 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11" />Ammọ esaña eñkeene miin, idahami ammọ eñkanna miin ekʌk,</para>
  <para style="q2" vid="PSA 17:11">ewuuk anyen ense, nọ ato do entọ ke isọñ.<verse eid="PSA 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12" />Ammọ eba nte ekpe ake abiọọñ adọññọ nọ ayem se adia,</para>
  <para style="q2" vid="PSA 17:12">nte anafai ekpe a-anyannake ke itie udịbe.<verse eid="PSA 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13" />
    <char style="nd">Abọọñ</char>, dakka da, biọñọ ammọ, dooño ammọ duọñọ ke isọñ;</para>
  <para style="q2" vid="PSA 17:13">ben akañkañ mfo ñnyaaña miin sio ke ubọk mbon ibak.<verse eid="PSA 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14" />
    <char style="nd">Abọọñ</char>, dat ubọk mfo ñnyaaña miin sio ke ubọk mme utọ ibon ami,</para>
  <para style="q2" vid="PSA 17:14">ke ubọk mme awo ake udeeme amọ ke uwem abaaha ke ederimbod ami.</para>
  <para style="q1" vid="PSA 17:14">Yak se afo anịm anọọ mbon ibak ayọhọ ammọ idịb;</para>
  <para style="q2" vid="PSA 17:14">yak nditọ ammọ ñko edia eyʌkkọ kpa ke ado,</para>
  <para style="q2" vid="PSA 17:14">ndin yak ammọ enịm nsʌhọ enọ ntək nditọ ammọ.<verse eid="PSA 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15" />Amaado ami, akpanikọ mmi ayaawuọ ada ndin ami ñyaakịt iso mfo;</para>
  <para style="q2" vid="PSA 17:15">ami mmaademme, ñyaayʌkkọ ke adikịt mbid mfo.<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="cl">Saam 18<note caller="+" style="f"><char style="fr" closed="false">18:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 18:1-50 ewet Saam 18:2-51</char></note></para>
  <para style="d">Ake etubom mbon ikwọ. Saam Defid ayịnutom <char style="nd">Abọọñ</char>. Anye akekwọ ami anọ <char style="nd">Abọọñ</char> ke ini <char style="nd">Abọọñ</char> akenyaañake anye asio ke ubọk afịd mme asua amọ ñko ye ke ubọk Sọọl.</para>
  <para style="s1">Ikwọ Ekọọm Defid</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1" />Ami mmuma fiin, <char style="nd">Abọọñ</char>, adudu mmi.<verse eid="PSA 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2" />
    <char style="nd">Abọọñ</char> ado akwa itiad mmi, itie udịbe mmi ye ubọkkọ miin;</para>
  <para style="q2" vid="PSA 18:2">Abasi mmi ado akwa itiad mmi, ke anye ke ami ndʌk ndịbe,</para>
  <para style="q2" vid="PSA 18:2">atuekọñ mmi ye nnʌk adinyaaña mmi, akpọsọñ itie ubọkkọ mmi.<verse eid="PSA 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3" />Ami mmaakoot <char style="nd">Abọọñ</char>, a-adotto itooro,</para>
  <para style="q2" vid="PSA 18:3">ndin anye amañnyaaña miin asio ke ubọk mme asua mmi.<verse eid="PSA 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4" />Mme udʌk ñkpa emaembọọp miin;</para>
  <para style="q2" vid="PSA 18:4">mme ukwọ nsobo emaemfuuk miin.<verse eid="PSA 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5" />Mme udʌk udi emaeñkanna miin ekʌk;</para>
  <para style="q2" vid="PSA 18:5">mme afia ñkpa emaennaa miin ke iso.<verse eid="PSA 18:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6" />Ke nnananyen mmi ami mmaakoot <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 18:6">ami mmaatua nnọ Abasi mmi ñyem unwam.</para>
  <para style="q1" vid="PSA 18:6">Anye amaatie ke tembịd amọ akop uyio mmi;</para>
  <para style="q2" vid="PSA 18:6">ayịd mmi amaawuọ anye idem, adʌk anye utọñ.<verse eid="PSA 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7" />Isọñ amaanyeñ anyʌñ anyeeñe,</para>
  <para style="q2" vid="PSA 18:7">mme itiad idakisọñ mme ikpọabod emaenyek;</para>
  <para style="q2" vid="PSA 18:7">ammọ emaenyek sia esịd amaayat anye.<verse eid="PSA 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8" />Nsʌñikañ amaawuọ anye ke aduiwuo;</para>
  <para style="q2" vid="PSA 18:8">akwa ikañ amaanyʌñ awuọ anye ke inua,</para>
  <para style="q2" vid="PSA 18:8">eboho ikañ amaabịppe ato do asak.<verse eid="PSA 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9" />Anye amaabakka mme hefịn anyʌñ asọiyọ adi;</para>
  <para style="q2" vid="PSA 18:9">ñkịm-ñkịm ntọñanyọñ amaaba anye ke idak ikpad.<verse eid="PSA 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10" />Anye amaadoro ke anyọñ serubim anyʌñ afuurọ;</para>
  <para style="q2" vid="PSA 18:10">anyʌñ afuurọ adọọk ke mba afịm.<verse eid="PSA 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11" />Anye amaanam ekịm ado ufʌkñkpọ amọ,</para>
  <para style="q2" vid="PSA 18:11">ado kanopi akanna anye</para>
  <para style="q2" vid="PSA 18:11">mme ñkịm-ñkịm ntọñanyọñ edịm ke ikpaanyọñ.<verse eid="PSA 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12" />Amaato ke uyamma iso amọ anam mme ntọñanyọñ emaesaña</para>
  <para style="q2" vid="PSA 18:12">mme edịmitiad ye akebkeb.<verse eid="PSA 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13" />
    <char style="nd">Abọọñ</char> amaatuak ke anyọñ nte aduma;</para>
  <para style="q2" vid="PSA 18:13">uyio ataa Andikoñ Ñkan amaasakka.<verse eid="PSA 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14" />Anye amaatop mme idañ amọ anyʌñ asuan mme asua,</para>
  <para style="q2" vid="PSA 18:14">amaakama mme akpọsọñ akebkeb asuan ammọ.<verse eid="PSA 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15" />Mme abedeñ akpainyañ emaewuọñọ edudak ewọt idem</para>
  <para style="q2" vid="PSA 18:15">ndin mme itiad idakisọñ ederimbod emaewuọñọ edudak</para>
  <para style="q1" vid="PSA 18:15">ke uyio mfo, <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 18:15">ke inweek akewuọhọ ke aduiwuo mfo.<verse eid="PSA 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16" />Anye amaatie ke anyọñ asio ubọk ammʌm;</para>
  <para style="q2" vid="PSA 18:16">anye amandʌt miin asio ke ntotəño mmọọñ.<verse eid="PSA 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17" />Anye amamfak miin asio ke ubọk akpọsọñ asua mmi,</para>
  <para style="q2" vid="PSA 18:17">ansio ke ubọk mme asua ekesọññọ adudu eñkan miin.<verse eid="PSA 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18" />Ammọ emaetuaha ye ami ke usen ukuud mmi,</para>
  <para style="q2" vid="PSA 18:18">ado <char style="nd">Abọọñ</char> akedo ibededem mmi.<verse eid="PSA 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19" />Anye amansio miin asịn ke ñnwaña uyaiya itie;</para>
  <para style="q2" vid="PSA 18:19">anye amamfak miin sia anye amaanem esịd ye ami.<verse eid="PSA 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20" />
    <char style="nd">Abọọñ</char> anam ye ami akeene adinenido mmi;</para>
  <para style="q2" vid="PSA 18:20">anye amannọ miin utịb akeene naña ubọk mmi asana.<verse eid="PSA 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21" />Sia ami mmekpeme usʌñ <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 18:21">ami ndueghe ke adiwọññọ ñkpọñ Abasi mmi.<verse eid="PSA 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22" />Afịd mme mbed amọ enna miin ke iso;</para>
  <para style="q2" vid="PSA 18:22">ami ñwọññọke iso ñkpọñ mme ewʌhọ amọ.<verse eid="PSA 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23" />Ami mmenana ndo ke iso amọ</para>
  <para style="q2" vid="PSA 18:23">ñnyʌñ nsio idem mmi ke usʌñ idiọọkñkpọ.<verse eid="PSA 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24" />
    <char style="nd">Abọọñ</char> annọ miin utịb akeene adinenido mmi,</para>
  <para style="q2" vid="PSA 18:24">akeene naña ubọk mmi asana ke iso amọ.<verse eid="PSA 18:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25" />Afo anam akpanikọ ye mbon se inam akpanikọ ye afo,</para>
  <para style="q2" vid="PSA 18:25">afo awọt idem mfo nte anana ndo anọ mme anana ndo,<verse eid="PSA 18:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26" />afo amenịm idem mfo ke adisana ye mbon se isana</para>
  <para style="q2" vid="PSA 18:26">ado ye mbon mbubịk, afo amewọt ñkara.<verse eid="PSA 18:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27" />Afo anyaaña mbon e-esuuhọke idem</para>
  <para style="q2" vid="PSA 18:27">ado a-asuuhọ mbon e-enyaññake anyen.<verse eid="PSA 18:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28" />Afo, <char style="nd">Abọọñ</char>, anam utuenikañ mmi asak;</para>
  <para style="q2" vid="PSA 18:28">Abasi mmi akappa akịm mmi asịn ke unwana.<verse eid="PSA 18:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29" />Ato ke unwam mfo ami mmekan ñnwana ye udịm ekọñ;</para>
  <para style="q2" vid="PSA 18:29">ye Abasi mmi ami mmekan ntamma mfrọ akọ.<verse eid="PSA 18:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30" />Amaado Abasi, usʌñ amọ afọn ama:</para>
  <para style="q2" vid="PSA 18:30">Ikọ <char style="nd">Abọọñ</char> anana ndo;</para>
  <para style="q2" vid="PSA 18:30">anye afʌk afịd mbon se idịbe ke anye.<verse eid="PSA 18:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31" />Anie ado Abasi ke amaaboiyo <char style="nd">Abọọñ</char>?</para>
  <para style="q2" vid="PSA 18:31">Anie ñko ido Itiad ke imiibọhọke Abasi ñnyịn?<verse eid="PSA 18:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32" />Ado Abasi annọ miin adudu</para>
  <para style="q2" vid="PSA 18:32">anyʌñ anam usʌñ mmi asọọñọ ada anen.<verse eid="PSA 18:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33" />Anye anam ukod mmi aba nte ukod edob;</para>
  <para style="q2" vid="PSA 18:33">anye anam ami nda ke mme ñkoñ-ñkoñ itie.<verse eid="PSA 18:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34" />Anye akpeep ubọk mmi naña enwana ekọñ;</para>
  <para style="q2" vid="PSA 18:34">ubọk mmi akeme adinuuk utịgha brọns.<verse eid="PSA 18:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35" />Afo anam adinyaaña unwam mfo ado atuekọñ mmi,</para>
  <para style="q2" vid="PSA 18:35">ndin ubọk nnasia mfo ammʌm miin akama;</para>
  <para style="q2" vid="PSA 18:35">unwam mfo anam ami ñkpon.<verse eid="PSA 18:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36" />Afo amenọ ikpad mmi ñnwaña-ñnwaña usʌñ isañ,</para>
  <para style="q2" vid="PSA 18:36">mbaak itọñukod mmi adiyekke.<verse eid="PSA 18:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37" />Ami mmaabịne mme asua mmi ñnyʌñ ñkebọhọ ammọ;</para>
  <para style="q2" vid="PSA 18:37">ami ñkitịmmeke edem tutu nsobo afịd ammọ.<verse eid="PSA 18:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38" />Ami mmaasọnnọ ammọ tutu ammọ ikanna idakka ida;</para>
  <para style="q2" vid="PSA 18:38">ammọ emaeduọññọ ke idak ñkpad mmi.<verse eid="PSA 18:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39" />Afo amannọ miin adudu unwana ekọñ;</para>
  <para style="q2" vid="PSA 18:39">afo amaasuuhọ mbon usua mmi ke iso mmi.<verse eid="PSA 18:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40" />Afo amaanam mbon usua mmi etịmme edem efeeñe,</para>
  <para style="q2" vid="PSA 18:40">ndin ami mmaasobo mme asua mmi.<verse eid="PSA 18:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41" />Ammọ emaetua eyem unwam, ado awo ikibaaha se inyaaña ammọ,</para>
  <para style="q2" vid="PSA 18:41">emaekoot <char style="nd">Abọọñ</char>, ado anye ikibọọrọke ammọ.<verse eid="PSA 18:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42" />Ami mmaanuak ammọ tutu ammọ ekeñe nte mbio ake afịm abenne;</para>
  <para style="q2" vid="PSA 18:42">ami mmaasọnnọ ammọ nte nsọñ ke usʌñ.<verse eid="PSA 18:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43" />Afo ameñnyaaña miin asio ke ikọ ye mme awo;</para>
  <para style="q2" vid="PSA 18:43">amenam ami ndo etubom mme idịd.</para>
  <para style="q1" vid="PSA 18:43">Mme awo se ami mmeñkediọọñọke enam ñkpọ ennọ miin idahami,<verse eid="PSA 18:43" /></para>
  <para style="q2">
    <verse number="44" style="v" sid="PSA 18:44" />mbon idịd mfen esuuk iwuod ennọ;</para>
  <para style="q2" vid="PSA 18:44">ammọ emaesʌk ekokop uyio mmi, ammọ enam se mbo.<verse eid="PSA 18:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45" />Idem a-abọkkọ afịd ammọ;</para>
  <para style="q2" vid="PSA 18:45">ammọ enyeñ idem ewuọñọ ke itie akpọsọñ ubọkkọ ammọ edi.<verse eid="PSA 18:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46" />
    <char style="nd">Abọọñ</char> adu uwem! Itooro anie Akwa Itiad mmi!</para>
  <para style="q2" vid="PSA 18:46">Ubọọñ anie Abasi Andiñnyaaña miin!<verse eid="PSA 18:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47" />Anye ado Abasi ake asioho usiene iwuod mmi,</para>
  <para style="q2" vid="PSA 18:47">ake asuuhọke mme idịd anịm ke idak mmi,<verse eid="PSA 18:47" /></para>
  <para style="q2">
    <verse number="48" style="v" sid="PSA 18:48" />ake amfakka miin asio ke ubọk mme asua mmi.</para>
  <para style="q1" vid="PSA 18:48">Afo amambenne miin ke anyọñ akan mme asua mmi;</para>
  <para style="q2" vid="PSA 18:48">afo amaanam ami mbọkkọ awo afai.<verse eid="PSA 18:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49" />Ke ntoro, ami ñyautooro fiin, <char style="nd">Abọọñ</char>, ke atu mme idịd;</para>
  <para style="q2" vid="PSA 18:49">Ami ñyaakwọ itooro anyịñ mfo.<verse eid="PSA 18:49" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50" />Anye anọ adidem amọ ekamba adikan;</para>
  <para style="q2" vid="PSA 18:50">anye awọt anye ake emaekeyet adan inịm mfọn mma ima amọ,</para>
  <para style="q2" vid="PSA 18:50">anọ Defid ye ubon amọ ke nsi-nsi.<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="cl">Saam 19<note caller="+" style="f"><char style="fr" closed="false">19:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 19:1-14 ewet Saam 19:2-15</char></note></para>
  <para style="d">Ake etubom ikwọ. Saam Defid.</para>
  <para style="s1">Mme Utịppeñkpọ Abasi ye Ufọn Mbed Amọ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1" />Mme hefịn ebʌk ubọọñ Abasi;</para>
  <para style="q2" vid="PSA 19:1">mme ikpaanyọñ enyʌñ etañ se ubọk amọ anam.<verse eid="PSA 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2" />Ke usen ke usen ammọ eneme;</para>
  <para style="q2" vid="PSA 19:2">kwa akonayio ammọ eyaara ifiọk.<verse eid="PSA 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3" />Ammọ inieghe nneme, ikamake ikọ isem usem;</para>
  <para style="q2" vid="PSA 19:3">awo ikoppo uyom ito ammọ.<verse eid="PSA 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4" />Ado uyio ammọ awuọ adʌk afịd unadod,</para>
  <para style="q2" vid="PSA 19:4">ikọ ammọ asịm utịd ederimbod.</para>
  <para style="q1" vid="PSA 19:4">Ke mme hefịn Abasi anam atayad anịm anọ utịn.<verse eid="PSA 19:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 19:5" />Aba nte ebendọ ato ubeed amọ awuọ adi,</para>
  <para style="q2" vid="PSA 19:5">nte awo uko anem esịd adifeghe nduba amọ.<verse eid="PSA 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6" />Anye asakka ke mbeñ anyọñ keed</para>
  <para style="q2" vid="PSA 19:6">anyʌñ asaña akanna akewuọ mbeñ uko;</para>
  <para style="q2" vid="PSA 19:6">ñkpọ ndomokeed a-mmiikoppo ufiob amọ ibaaha.<verse eid="PSA 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7" />Mbed <char style="nd">Abọọñ</char> afọn ama,</para>
  <para style="q2" vid="PSA 19:7">ademme awo ukpọñ.</para>
  <para style="q1" vid="PSA 19:7">Mme ewʌhọ <char style="nd">Abọọñ</char> edo akpanikọ,</para>
  <para style="q2" vid="PSA 19:7">enam mme akọi enie aniọñ.<verse eid="PSA 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8" />Mme usʌñ <char style="nd">Abọọñ</char> enen,</para>
  <para style="q2" vid="PSA 19:8">enọ idaara ke esịd.</para>
  <para style="q1" vid="PSA 19:8">Mme mbed <char style="nd">Abọọñ</char> eyamma,</para>
  <para style="q2" vid="PSA 19:8">enọ anyen unwana.<verse eid="PSA 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9" />Uteeñe <char style="nd">Abọọñ</char> asana,</para>
  <para style="q2" vid="PSA 19:9">aba ke nsi-nsi.</para>
  <para style="q1" vid="PSA 19:9">Mme ewʌhọ <char style="nd">Abọọñ</char> edo akpanikọ,</para>
  <para style="q2" vid="PSA 19:9">ndin afịd ammọ edo ndinen.<verse eid="PSA 19:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10" />Ammọ e-esọñ udua ekan kold,</para>
  <para style="q2" vid="PSA 19:10">ekan ataa eti kold;</para>
  <para style="q1" vid="PSA 19:10">ammọ e-enem ekan adanakwọọk,</para>
  <para style="q2" vid="PSA 19:10">ekan adanakwọọk a-awuọhọ ke mba akwọọk.<verse eid="PSA 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11" />Edat ammọ etemme ayịnufọk mfo ñkpọ;</para>
  <para style="q2" vid="PSA 19:11">Ekamba udod asịne ke adinịm ammọ.<verse eid="PSA 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12" />Ado anie akeme adikịt mme ndudue ammọ?</para>
  <para style="q2" vid="PSA 19:12">Dakka nnọ ke mme ndedịbe ndudue mmi.<verse eid="PSA 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13" />Mʌm awo mfo kama mbaak ñkoinnam idiọọkñkpọ;</para>
  <para style="q2" vid="PSA 19:13">kuuyak ammọ eñkara miin.</para>
  <para style="q1" vid="PSA 19:13">Ndin ami ndiinieghe ndo,</para>
  <para style="q2" vid="PSA 19:13">ñnyʌñ nsana mbọkkọ mme ikpọ idiọọkñkpọ.<verse eid="PSA 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14" />Yak mme ikọ inua mmi ami ye akikere esịd mmi ami</para>
  <para style="q2" vid="PSA 19:14">unem fiin esịd,</para>
  <para style="q2" vid="PSA 19:14">
    <char style="nd">Abọọñ</char>, Itiad mmi ye Andimfak miin.<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="cl">Saam 20<note caller="+" style="f"><char style="fr" closed="false">20:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 20:1-9 ewet Saam 19:2-10</char></note></para>
  <para style="d">Ake etubom ikwọ. Saam Defid.</para>
  <para style="s1">Akam E-ebọññọ Eyem Edikan</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1" />Yak Abọọñ ubọọrọ fiin ke usen nnananyen;</para>
  <para style="q2" vid="PSA 20:1">yak anyịñ Abasi Yekọb ukpeme fiin.<verse eid="PSA 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2" />Yak anye anọ unwam ato adisana itie amọ usọk</para>
  <para style="q2" vid="PSA 20:2">anyʌñ unọ ibededem ato Saiyọn.<verse eid="PSA 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3" />Yak anye atoiyo afịd ñwaidem mfo</para>
  <para style="q2" vid="PSA 20:3">anyʌñ abọ mme ufọfọb uwa mfo.<verse eid="PSA 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4" />Yak anye unọ fiin se esịd mfo ayem</para>
  <para style="q2" vid="PSA 20:4">anyʌñ anam afịd uduak mfo awuọ awọt idem.<verse eid="PSA 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5" />Yak ñnyịn isio ñkpo idaara ke abaña adikan mfo</para>
  <para style="q2" vid="PSA 20:5">inyʌñ ibenne mme afọñidiọọñọ ñnyịn ke anyọñ ke anyịñ Abasi ñnyịn.</para>
  <para style="b" vid="PSA 20:5" />
  <para style="q1" vid="PSA 20:5">Yak Abọọñ anam afịd se afo abeeñe.<verse eid="PSA 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6" />Idahami mmediọọñọ mbo ke:</para>
  <para style="q2" vid="PSA 20:6">
    <char style="nd">Abọọñ</char> anọ anye emaekeyet adan adikan.</para>
  <para style="q1" vid="PSA 20:6">Anye atie ke adisana itie amọ ke anyọñ abọọrọ anye</para>
  <para style="q2" vid="PSA 20:6">ke adudu adinyaaña ubọk nnasia amọ.<verse eid="PSA 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7" />Ubaak awo enie idodanyen ke sariọd, ubaak ke enañmbakara,</para>
  <para style="q2" vid="PSA 20:7">ado ñnyịn inie idodanyen ke anyịñ <char style="nd">Abọọñ</char> Abasi ñnyịn.<verse eid="PSA 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8" />Edọñ ammọ edọñ ke isọñ ammọ enyʌñ eduọññọ,</para>
  <para style="q2" vid="PSA 20:8">ado ñnyịn idakka ida inyʌñ ida ñkpad iba.<verse eid="PSA 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9" />
    <char style="nd">Abọọñ</char>, nọ adidem adikan!</para>
  <para style="q2" vid="PSA 20:9">Bọọrọ ñnyịn imaukoot!<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="cl">Saam 21<note caller="+" style="f"><char style="fr" closed="false">21:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 21:1-13 ewet Saam 21:2-14</char></note></para>
  <para style="d">Ake etubom ikwọ. Saam Defid.</para>
  <para style="s1">Adikọọm <char style="nd">Abọọñ</char> ke Adinie Edikan</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1" />Adidem adat esịd ke adudu mfo, <char style="nd">Abọọñ</char>.</para>
  <para style="q2" vid="PSA 21:1">Idadesịd amọ akpon die ke mme adikan ake afo anọọhọ anye!<verse eid="PSA 21:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2" />Afo amenọ anye udọñ esịd amọ</para>
  <para style="q2" vid="PSA 21:2">unyʌññọ usịn ebeeñe ñkpọkinua amọ.<verse eid="PSA 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3" />Afo amaadikọọm anye ye mme nti adidiọñ</para>
  <para style="q2" vid="PSA 21:3">anyʌñ ayat anye anyanya ataa kold ke iwuod.<verse eid="PSA 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4" />Anye amaubeeñe uwem, ndin afo amaanọ anye,</para>
  <para style="q2" vid="PSA 21:4">mme anyan usen ke nsi-nsi nsi-nsi.<verse eid="PSA 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5" />Ato ke mme adikan ake afo akenọọhọ anye, ubọọñ amọ akpon;</para>
  <para style="q2" vid="PSA 21:5">afo amenọ anye ukpono ye uku.<verse eid="PSA 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6" />Ke akpanikọ afo amenọ anye mme adidiọñ i-imiidiikweeñeke</para>
  <para style="q2" vid="PSA 21:6">unwana iso mfo anyʌñ anam esịd anem anye.<verse eid="PSA 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7" />Sia adidem anie mbuọdidem ke <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 21:7">ato ke nsọọñọnda ima Ata Andikoñ Ñkan</para>
  <para style="q2" vid="PSA 21:7">anye idiisịkkeke.<verse eid="PSA 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8" />Ubọk mfo ayaamʌm afịd mme asua mfo;</para>
  <para style="q2" vid="PSA 21:8">ubọk nnasia mfo ayaamʌm mbon ammuumaaha fiin.<verse eid="PSA 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9" />Ke ini umauka ekọñ,</para>
  <para style="q2" vid="PSA 21:9">afo ayaafọp ammọ nte ke akwa ufiob ikañ.</para>
  <para style="q1" vid="PSA 21:9">
    <char style="nd">Abọọñ</char> ayaasobo ammọ ke ifiobesịd amọ,</para>
  <para style="q2" vid="PSA 21:9">ndin ikañ amọ ayaata ammọ.<verse eid="PSA 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10" />Afo ayaasobo ubon ammọ asio ke iso isọñ,</para>
  <para style="q2" vid="PSA 21:10">asobo emana ammọ asio ke atu uduud awo.<verse eid="PSA 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11" />Akpesʌkado ammọ eduakka idiọọk uduak ubaña fiin</para>
  <para style="q2" vid="PSA 21:11">enyʌñ enañña mme ibak-ibak ñkpọ, ammọ idiikịtte unen.<verse eid="PSA 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12" />Afo ayaanam ammọ ekanna edem ammọ</para>
  <para style="q2" vid="PSA 21:12">ke ini umauket ammọ ye utịgha mfo.<verse eid="PSA 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13" />Yak ebenne ubọọñ mfo ke adudu mfo, <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 21:13">ñnyịn iyaikwọ inyʌñ itooro adudu mfo.<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="cl">Saam 22<note caller="+" style="f"><char style="fr" closed="false">22:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 22:1-31 ewet Saam 22:2-32</char></note></para>
  <para style="d">Ake etubom ikwọ. Ekwọ nte “Uman Edob Ubakusen.” Saam Defid.</para>
  <para style="s1">Ndutʌhọ ye Itooro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1" />Abasi mmi, Abasi mmi, nsoo inam nọ afo afeghe añkpọñ miin?</para>
  <para style="q2" vid="PSA 22:1">Nsoo inam nọ afo ada nsan-nsan uñnyaañake miin,</para>
  <para style="q2" vid="PSA 22:1">unyʌññọ ukop ayịd ukuud mmi?<verse eid="PSA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2" />Abasi mmi, ami nseeme ukoot uweemeayio, ado afo umbọọrọke,</para>
  <para style="q2" vid="PSA 22:2">ke akonayio, ado ñkịtte emem.<verse eid="PSA 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3" />Kpayeado afo mmọdo atie ke ebekpo nte Andisana Ñkan;</para>
  <para style="q2" vid="PSA 22:3">afo ke Isrel etooro.<verse eid="PSA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4" />Mme eteete ñnyịn ekesịn mbuọdidem ammọ ke idem mfo;</para>
  <para style="q2" vid="PSA 22:4">ammọ emaebuọt idem ndin afo amaanyaaña ammọ.<verse eid="PSA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5" />Ammọ emaetua ukoot fiin, ndin emaebọkkọ;</para>
  <para style="q2" vid="PSA 22:5">emaebuọt idem ke afo, ndin ikikịtte abuud.<verse eid="PSA 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6" />Ado ami ndo utʌñ, ndooho awo,</para>
  <para style="q2" vid="PSA 22:6">afịd awo ensuenne, mme awo ensọọn.<verse eid="PSA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7" />Afịd mbon se iñkịt ensak esaha;</para>
  <para style="q2" vid="PSA 22:7">ammọ ensue, efuuñ iwuod.<verse eid="PSA 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8" />Ammọ ete, “Anye abuọt idem ke <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 22:8">yak <char style="nd">Abọọñ</char> anam anye abọkkọ.</para>
  <para style="q1" vid="PSA 22:8">Yak <char style="nd">Abọọñ</char> anyaaña anye,</para>
  <para style="q2" vid="PSA 22:8">sia anye akoppo inem ke <char style="nd">Abọọñ</char>.”<verse eid="PSA 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9" />Ado afo akensio miin ke idịb;</para>
  <para style="q2" vid="PSA 22:9">afo amaanam ami mbuọt idem ke afo, tọọñọ naña ñwọppọ eba eka mmi.<verse eid="PSA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10" />Tọọñọ ke emana emaeñyaak miin unọ fiin;</para>
  <para style="q2" vid="PSA 22:10">tọọñọ ke idịb eka mmi afo ado Abasi mmi.<verse eid="PSA 22:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11" />Kuunyọọñ usʌñ uñkpọñ,</para>
  <para style="q2" vid="PSA 22:11">sia mfịna akpere</para>
  <para style="q2" vid="PSA 22:11">ndin ibaaha awo se inyaaña.<verse eid="PSA 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12" />Uwak ñyaaraenañ eñkanna miin ekʌk</para>
  <para style="q2" vid="PSA 22:12">mme ñkpọsọñ ñyaaraenañ Basan eñkanna ekʌk.<verse eid="PSA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13" />Mme ekpe e-ekuunọkuun enyʌñ ewawai ñkpọ ndita ammọ</para>
  <para style="q2" vid="PSA 22:13">enwañña inua ammọ embaña miin.<verse eid="PSA 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14" />Eñnwañña miin eduọk nte mmọọñ,</para>
  <para style="q2" vid="PSA 22:14">ndin afịd mme akpọ mmi efekke.</para>
  <para style="q1" vid="PSA 22:14">Esịd mmi akappa aba nte aduañ;</para>
  <para style="q2" vid="PSA 22:14">atara ke esịd idem mmi.<verse eid="PSA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15" />Inua mmi asat nte usiọñ, udịd imbaaha aba</para>
  <para style="q2" vid="PSA 22:15">ndin edeme mmi adiana ke anyọñ inua mmi;</para>
  <para style="q2" vid="PSA 22:15">afo annịm miin ke ntọñ ñkpa.<verse eid="PSA 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16" />Mme ewa eñkanna miin ekʌk,</para>
  <para style="q2" vid="PSA 22:16">mme atu abʌd-abʌd awo eñkanna ekʌk;</para>
  <para style="q2" vid="PSA 22:16">ammọ eñkịm miin ubọk ye ukod.<verse eid="PSA 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17" />Afịd akpọ mmi ewuọñọ edudak;</para>
  <para style="q2" vid="PSA 22:17">mme awo ewuuk anyen ense enyʌñ esaha.<verse eid="PSA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18" />Ammọ edeeme mme afọñ mmi ke atu idem ammọ</para>
  <para style="q2" vid="PSA 22:18">enyʌñ esịn ukañ ebaña afọñidem mmi.<verse eid="PSA 22:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19" />Ado afo, <char style="nd">Abọọñ</char>, kuuda nsan-nsan uñkpọñ miin.</para>
  <para style="q2" vid="PSA 22:19">Afo ado adudu mmi; sọp di ñnyaaña miin.<verse eid="PSA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20" />Ñnyaaña miin sio ke akañkañ,</para>
  <para style="q2" vid="PSA 22:20">sio uwem mmi ke adudu mme ewa.<verse eid="PSA 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21" />Ñnyaaña miin sio ke inua mme ekpe;</para>
  <para style="q2" vid="PSA 22:21">nsio miin ke nnʌk ayaaraenañ ikọd.<verse eid="PSA 22:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22" />Ñyaabʌk anyịñ mfo nnọ ikọd mmi;</para>
  <para style="q2" vid="PSA 22:22">ke atu esob uwak awo mfo ami ñyautooro fiin.<verse eid="PSA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23" />Ndufo se ebaak <char style="nd">Abọọñ</char>, itooro anye!</para>
  <para style="q2" vid="PSA 22:23">Afịd ndufo ubon Yekọb, ikpono anye!</para>
  <para style="q2" vid="PSA 22:23">Iteeñe anye, afịd ndufo ubon Isrel!<verse eid="PSA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24" />Sia anye isuaha inyʌññọ isịn</para>
  <para style="q2" vid="PSA 22:24">ufen awo ukuud ke ndek;</para>
  <para style="q1" vid="PSA 22:24">anye idịppe anye iso amọ</para>
  <para style="q2" vid="PSA 22:24">ado akpañ utọñ akop ntuaña eseeme amọ.<verse eid="PSA 22:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25" />Itooro ake ami unọọhọ fiin ke akwa esob uto fiin;</para>
  <para style="q2" vid="PSA 22:25">ami ñyaasio akaaña mmi ke iso mbon se ubaak fiin.<verse eid="PSA 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26" />Uweene ayaadia anyʌñ ayʌkkọ;</para>
  <para style="q2" vid="PSA 22:26">mbon ake eyemme <char style="nd">Abọọñ</char> eyaetooro anye;</para>
  <para style="q2" vid="PSA 22:26">yak esịd ndufo edu uwem ke nsi-nsi!<verse eid="PSA 22:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27" />Afịd mme utịd ederimbod</para>
  <para style="q2" vid="PSA 22:27">eyaetoiyo enyʌñ ewọññọ ebịne <char style="nd">Abọọñ</char>,</para>
  <para style="q1" vid="PSA 22:27">ndin afịd mme ubon ke mme idịd</para>
  <para style="q2" vid="PSA 22:27">eyaetuak iwuod enọ anye,<verse eid="PSA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28" />sia ukara anie <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 22:28">anye anyʌñ akaara mme idịd.<verse eid="PSA 22:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29" />Afịd mme imọ awo ke iso isọñ eyaedia enyʌñ ekpono anye;</para>
  <para style="q2" vid="PSA 22:29">afịd mbon se isọiyọ idʌk ke ntọñ eyaetọọñọ edọñ enọ anye;</para>
  <para style="q2" vid="PSA 22:29">mbon i-imiikanna inịm idem ammọ ke uwem.<verse eid="PSA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30" />Ubon ayio iso eyaenam ñkpọ enọ anye;</para>
  <para style="q2" vid="PSA 22:30">eyaebʌk ebaña <char style="nd">Abọọñ</char> enọ mme emana ini iso.<verse eid="PSA 22:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31" />Ammọ eyaetañ ase ebaña adinenido amọ,</para>
  <para style="q2" vid="PSA 22:31">edọkkọ mbon se imiimanake diin ete:</para>
  <para style="q2" vid="PSA 22:31">Anye anam!<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="cl">Saam 23</para>
  <para style="d">Saam Defid.</para>
  <para style="s1">Eti Akpemeedọñ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1" />
    <char style="nd">Abọọñ</char> ado andimbọọk miin, nnanake ñkpọ ndomokeed.<verse eid="PSA 23:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 23:2" />Anye anam ami nsuuk nnaa ke awawa mbid,</para>
  <para style="q1" vid="PSA 23:2">anye andat akaa ifuuro-ifuuro mmọọñ,<verse eid="PSA 23:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 23:3" />anye ademme ukpọñ mmi.</para>
  <para style="q1" vid="PSA 23:3">Anye anam ami nsaña ke mme adinen usʌñ</para>
  <para style="q2" vid="PSA 23:3">ke ntak anyịñ amọ.<verse eid="PSA 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4" />Akpekọm ami nsaña</para>
  <para style="q2" vid="PSA 23:4">ke abedeñ se ikịm ikan,</para>
  <para style="q1" vid="PSA 23:4">ami ndiifegheke idiọọk,</para>
  <para style="q2" vid="PSA 23:4">sia afo mmọdo ye ami;</para>
  <para style="q1" vid="PSA 23:4">eto mfo ye esañ mfo,</para>
  <para style="q2" vid="PSA 23:4">ammọ endọñ miin esịd.<verse eid="PSA 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5" />Afo amebịt akpokoro annọ miin</para>
  <para style="q2" vid="PSA 23:5">ke iso mme asua mmi.</para>
  <para style="q1" vid="PSA 23:5">Afo ameñyet miin adan ke iwuod;</para>
  <para style="q2" vid="PSA 23:5">kọọb mmi ayọhọ aduọkkọ.<verse eid="PSA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6" />Ke akpanikọ mfọn ye ima mfo eyaeñkeene miin</para>
  <para style="q2" vid="PSA 23:6">ke afịd ayio uwem mmi,</para>
  <para style="q1" vid="PSA 23:6">ndin ami ñyaadʌñ ke ufọk <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 23:6">ke nsi-nsi.<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="cl">Saam 24</para>
  <para style="d">Saam Ake Defid.</para>
  <para style="s1">Anie Awo Ikeme Adidọọk ke Tembịd <char style="nd">Abọọñ</char>?</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1" />Ekondo ye afịd se iyọhọ ke esịd anie <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 24:1">ederimbod, ye afịd mbon se idʌñ ke anye;<verse eid="PSA 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2" />sia anye aketọọñọ anye ke mme akpainyañ</para>
  <para style="q2" vid="PSA 24:2">anyʌñ adot anye ke anyọñ mmọọñ.<verse eid="PSA 24:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3" />Anie akeme adidọọk abod <char style="nd">Abọọñ</char>?</para>
  <para style="q2" vid="PSA 24:3">Anie akeme adida ke adisana itie amọ?<verse eid="PSA 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4" />Awo se inie nsaana ubọk ye adisana esịd,</para>
  <para style="q2" vid="PSA 24:4">a-mmiibuọttọ idem ke ubobodñkpọ</para>
  <para style="q2" vid="PSA 24:4">inyʌññọ inwọñọ ñkpọ ke anyịñ nsu-nsu abasi.<verse eid="PSA 24:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5" />Ammọ eyaebọ adidiọñ eto <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 24:5">ndin Abasi Andinyaaña ammọ ayaanam yak ekịt ke ammọ emaenen.<verse eid="PSA 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6" />Naña emana ake eyemme anye aba ado ado,</para>
  <para style="q2" vid="PSA 24:6">ake eyemme iso mfo, Abasi Yekọb.<verse eid="PSA 24:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7" />Ibenne iwuod ndufo, ndufo mme inuaatob;</para>
  <para style="q2" vid="PSA 24:7">ibenne idem, ndufo mme ñkaan usʌñ,</para>
  <para style="q2" vid="PSA 24:7">nọ Adidem ubọọñ adʌk adi.<verse eid="PSA 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8" />Anie ido Adidem ubọọñ ami?</para>
  <para style="q2" vid="PSA 24:8">
    <char style="nd">Abọọñ</char> akpọsọñ ye uko,</para>
  <para style="q2" vid="PSA 24:8">
    <char style="nd">Abọọñ</char> uko ke ekọñ.<verse eid="PSA 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9" />Ibenne iwuod ndufo, ndufo mme inuaatob;</para>
  <para style="q2" vid="PSA 24:9">ibenne idem, ndufo mme ñkaan usʌñ,</para>
  <para style="q2" vid="PSA 24:9">nọ Adidem ubọọñ adʌk adi.<verse eid="PSA 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10" />Anye ado anie, Adidem ubọọñ ami?</para>
  <para style="q2" vid="PSA 24:10">
    <char style="nd">Abọọñ</char>, Andikponñkan,</para>
  <para style="q2" vid="PSA 24:10">anye ado Adidem ubọọñ.<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="cl">Saam 25</para>
  <para style="d">Ake Defid.</para>
  <para style="s1">Akam Ndadusʌñ ye Unwam</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1" />Ke afo, <char style="nd">Abọọñ</char> Abasi mmi,</para>
  <para style="q2" vid="PSA 25:1">ke ami nnie idodanyen.<verse eid="PSA 25:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2" />Ami mbuọt idem ke afo;</para>
  <para style="q2" vid="PSA 25:2">kuuyak ami ñkịt abuud,</para>
  <para style="q2" vid="PSA 25:2">kuunyʌñ uyak mme asua mmi eñkan miin.<verse eid="PSA 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3" />Baaba awo ndomokeed a-anieghe idodanyen ke afo</para>
  <para style="q2" vid="PSA 25:3">adiidia abuud ibaaha tutu amama,</para>
  <para style="q1" vid="PSA 25:3">ado abuud ayaamʌm mbon</para>
  <para style="q2" vid="PSA 25:3">e-enamma abiaña ke unana ntak.<verse eid="PSA 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4" />Ñwọt miin mme usʌñ mfo, <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 25:4">ñkpeep miin mme usʌñ mfo.<verse eid="PSA 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5" />Ndat miin usʌñ ke akpanikọ mfo nyʌñ ñkpeep miin,</para>
  <para style="q2" vid="PSA 25:5">sia afo ado Abasi Andinyaaña mmi,</para>
  <para style="q2" vid="PSA 25:5">ndin idodanyen mmi ado ke afo afịd usen.<verse eid="PSA 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6" />Toiyo, <char style="nd">Abọọñ</char>, ekamba mbọm ye ima mfo,</para>
  <para style="q2" vid="PSA 25:6">sia ammọ ebaaha tọọñọ ke esed.<verse eid="PSA 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7" />Kuutoiyo mme idiọọkñkpọ uyịn mmi</para>
  <para style="q2" vid="PSA 25:7">ye nsọñiwuod mmi;</para>
  <para style="q1" vid="PSA 25:7">ke ima mfo ntoiyo miin,</para>
  <para style="q2" vid="PSA 25:7">sia afo, <char style="nd">Abọọñ</char>, amefọn.<verse eid="PSA 25:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8" />
    <char style="nd">Abọọñ</char> afọn anyʌñ anen;</para>
  <para style="q2" vid="PSA 25:8">ke ntoro anye ayaatemme mme anamidiọọk usʌñ amọ.<verse eid="PSA 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9" />Anye adat mbon nsuukidem usʌñ ke se inen</para>
  <para style="q2" vid="PSA 25:9">anyʌñ akpeep ammọ usʌñ amọ.<verse eid="PSA 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10" />Afịd mme usʌñ <char style="nd">Abọọñ</char> edo imaima ye akpanikọ</para>
  <para style="q2" vid="PSA 25:10">anọ mbon e-enamma edioomo amọ.<verse eid="PSA 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11" />Ke ntak anyịñ mfo, <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 25:11">feen ndudue mmi, akpesʌkado anye akponno.<verse eid="PSA 25:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12" />Mme anie, ndin, edo mbon se ibaak <char style="nd">Abọọñ</char>?</para>
  <para style="q2" vid="PSA 25:12">Anye ayaatemme ammọ usʌñ a-anaaha nte ammọ emek.<verse eid="PSA 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13" />Ammọ eyaenie eduek ke ayio uwem ammọ,</para>
  <para style="q2" vid="PSA 25:13">ndin ubon ammọ eyaedat isọñ enie.<verse eid="PSA 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14" />
    <char style="nd">Abọọñ</char> ayaara esịd amọ anọ mbon se ibaak anye;</para>
  <para style="q2" vid="PSA 25:14">anye anam ammọ ediọọñọ edioomo amọ.<verse eid="PSA 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15" />Anyen mmi awʌhọ ke <char style="nd">Abọọñ</char> afịd ini,</para>
  <para style="q2" vid="PSA 25:15">sia anye ikpọọñ adiisio ukod mmi ke afia.<verse eid="PSA 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16" />Wọññọ nse miin nyʌñ ntua mbọm,</para>
  <para style="q2" vid="PSA 25:16">sia ami ndo ikpọọñ ñnyʌñ mba ke nnananyen.<verse eid="PSA 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17" />Ben mfịna esịd mmi sio</para>
  <para style="q2" vid="PSA 25:17">nyʌñ nsio miin ke ekamba ubiak mmi.<verse eid="PSA 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18" />Se ukuud mmi ye mbaba mmi</para>
  <para style="q2" vid="PSA 25:18">nyʌñ ben mme ndiọiñkpọ mmi sio.<verse eid="PSA 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19" />Se naña mme asua mmi ewak</para>
  <para style="q2" vid="PSA 25:19">ye naña ammọ enekke ensua!<verse eid="PSA 25:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20" />Kpeme uwem mmi nyʌñ ñnyaaña miin;</para>
  <para style="q2" vid="PSA 25:20">kuuyak ndia abuud,</para>
  <para style="q2" vid="PSA 25:20">sia ndịbe ke afo.<verse eid="PSA 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21" />Yak mfọnmma ye adinenido eñkpeme miin,</para>
  <para style="q2" vid="PSA 25:21">sia idodanyen mmi, <char style="nd">Abọọñ</char>, ado ke afo.<verse eid="PSA 25:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22" />O Abasi, fak Isrel sio,</para>
  <para style="q2" vid="PSA 25:22">ke afịd mme mfịna ammọ!<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="cl">Saam 26</para>
  <para style="d">Ake Defid.</para>
  <para style="s1">Akam Awo Ammiidueghe Ñkpọ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1" />Ndooro miin uyio, <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 26:1">sia ami mmedu adinen uwem;</para>
  <para style="q1" vid="PSA 26:1">ami mmenie mbuọdidem ke <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 26:1">ñnyʌññọ mfemme.<verse eid="PSA 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2" />
    <char style="nd">Abọọñ</char>, ndomo miin se,</para>
  <para style="q2" vid="PSA 26:2">duuñọ esịd mmi ye akikere mmi;<verse eid="PSA 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3" />sia ami mfreke nsọñọnda ima mfo</para>
  <para style="q2" vid="PSA 26:3">ñnyʌñ ndot anyen ke akpanikọ mfo.<verse eid="PSA 26:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4" />Ntieghe ye mbon e-esʌhọke nsu,</para>
  <para style="q2" vid="PSA 26:4">ñnyʌññọ ndian idem ye mbon mbubịk<verse eid="PSA 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5" />Ami nsuasua esob mme anam idiọọk</para>
  <para style="q2" vid="PSA 26:5">ñnyʌñ nsịn aditie ye mbon ibak.<verse eid="PSA 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6" />Ami mmeyie ubọk mmi ke adinenido,</para>
  <para style="q2" vid="PSA 26:6">ñnyʌñ ñkanna akpokoro uwa mfo, <char style="nd">Abọọñ</char>,<verse eid="PSA 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7" />ñkwọ itooro mfo ke akpọsọñ uyio</para>
  <para style="q2" vid="PSA 26:7">ñnyʌñ mbʌk afịd mme utịppe adinam mfo.<verse eid="PSA 26:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8" />
    <char style="nd">Abọọñ</char>, ami mmema ufọk a-afo adʌññọ,</para>
  <para style="q2" vid="PSA 26:8">itie se ubọọñ mfo adʌñ.<verse eid="PSA 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9" />Kuudat ukpọñ mmi usio udian ye mme anamidiọọk,</para>
  <para style="q2" vid="PSA 26:9">kuunyʌñ udat uwem mmi udian ye ake mbon afai,<verse eid="PSA 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10" />ake ubọk ammọ adọñọke utom ibak,</para>
  <para style="q2" vid="PSA 26:10">ake ubọk nnasia ammọ ayọhọke ye ubọkedem.<verse eid="PSA 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11" />Ami nsaña ke mfọnmma mmi;</para>
  <para style="q2" vid="PSA 26:11">mfak miin nyʌñ ntua miin mbọm.<verse eid="PSA 26:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12" />Ukod mmi ada ke unaisọñ;</para>
  <para style="q2" vid="PSA 26:12">ke akwa esob ami ñyaatooro <char style="nd">Abọọñ</char>.<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="cl">Saam 27</para>
  <para style="d">Ake Defid.</para>
  <para style="s1">Akam Itooro</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1" />
    <char style="nd">Abọọñ</char> ado unwana mmi ye adinyaaña mmi,</para>
  <para style="q2" vid="PSA 27:1">anie ke ami ndiifeghe?</para>
  <para style="q1" vid="PSA 27:1">
    <char style="nd">Abọọñ</char> ado itie udịbe uwem mmi,</para>
  <para style="q2" vid="PSA 27:1">anie ke ami ndiibaak?<verse eid="PSA 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2" />Ke ini mbon ibak esañake eñkpere</para>
  <para style="q2" vid="PSA 27:2">adita abʌkidem mmi,</para>
  <para style="q1" vid="PSA 27:2">ado mme asua mmi ye mbon utọk mmi</para>
  <para style="q2" vid="PSA 27:2">ediifiọnnọ iduọ.<verse eid="PSA 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3" />Akpekọm mbon ekọñ eñkanna miin ekʌk,</para>
  <para style="q2" vid="PSA 27:3">esịd mmi idiifegheke ndịk;</para>
  <para style="q1" vid="PSA 27:3">akpekọm ekọñ atịppe ke itie mmi,</para>
  <para style="q2" vid="PSA 27:3">ami ndiisʌk nnenie nsọọñọnda.<verse eid="PSA 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4" />Ñkpọ keed ke ami mbeeñe <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 27:4">kpa ado kpọd ke ñyem:</para>
  <para style="q1" vid="PSA 27:4">nte yak ndʌñ ke ufọk <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 27:4">ke afịd ayio uwem mmi,</para>
  <para style="q1" vid="PSA 27:4">nọ nse uyai <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 27:4">ñnyʌñ ñyem anye ke tembịd amọ.<verse eid="PSA 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5" />Sia ke usen nnananyen</para>
  <para style="q2" vid="PSA 27:5">anye ayamfʌk ke itie idʌñ amọ;</para>
  <para style="q1" vid="PSA 27:5">anye ayandịp ke idak adisana atayad amọ</para>
  <para style="q2" vid="PSA 27:5">anyʌñ andịppe adot ke anyọñ akwa itiad.<verse eid="PSA 27:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6" />Do ndin ke iwuod mmi adiikọñ</para>
  <para style="q2" vid="PSA 27:6">ikan ake mme asua eñkannake miin ekʌk;</para>
  <para style="q1" vid="PSA 27:6">ke adisana atayad amọ ami ñyaanam uwa ye ñkpo idaara;</para>
  <para style="q2" vid="PSA 27:6">ñyaakwọ ñnyʌñ nnam idaara nnọ <char style="nd">Abọọñ</char>.<verse eid="PSA 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7" />Kop uyio mmi ke ini ukoodo, <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 27:7">ntua miin mbọm nyʌñ ñyie miin.<verse eid="PSA 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8" />Esịd mmi atañ ubaña fiin ate, “Yem iso amọ!”</para>
  <para style="q2" vid="PSA 27:8">Ami ñyaayem iso mfo, <char style="nd">Abọọñ</char>.<verse eid="PSA 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9" />Kundịp miin iso mfo,</para>
  <para style="q2" vid="PSA 27:9">kuudat iyadesịd umbịne usio ke iso mfo;</para>
  <para style="q2" vid="PSA 27:9">afo akesʌk ado andiñnyaaña miin.</para>
  <para style="q1" vid="PSA 27:9">Kuñkpọñ miin, kuunyʌñ untop miin uduọọk,</para>
  <para style="q2" vid="PSA 27:9">Abasi Andiñnyaaña miin.<verse eid="PSA 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10" />Akpesʌkado nte ete ye eka mmi eñkpọññọ miin,</para>
  <para style="q2" vid="PSA 27:10">
    <char style="nd">Abọọñ</char> ayamben akama.<verse eid="PSA 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11" />Ñkpeep miin usʌñ mfo, <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 27:11">ndat miin saña ke usʌñ se ifọn</para>
  <para style="q2" vid="PSA 27:11">mbaak mbon se imfiik miin.<verse eid="PSA 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12" />Kuñyaak miin unọ udọñ mme asua mmi,</para>
  <para style="q2" vid="PSA 27:12">sia mme atie ntiense nsu edakka eda adinam ikọ ye ami,</para>
  <para style="q2" vid="PSA 27:12">etañ ndiọi ikọ embaña miin.<verse eid="PSA 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13" />Ami nsʌk nnenie nsọọñọnda ke ami:</para>
  <para style="q2" vid="PSA 27:13">Ami ñyaakịt mfọn <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 27:13">ke isọñ mme aduuwem.<verse eid="PSA 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14" />Bet <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 27:14">sọñ idem nyʌñ sọñ esịd</para>
  <para style="q2" vid="PSA 27:14">nyʌñ bet <char style="nd">Abọọñ</char>.<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="cl">Saam 28</para>
  <para style="d">Ake Defid.</para>
  <para style="s1">Akam E-ebọññọ Eyem Unwam</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1" />Afo ke ñkoot, <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 28:1">afo ado Itiad mmi,</para>
  <para style="q2" vid="PSA 28:1">kundeeme miin.</para>
  <para style="q1" vid="PSA 28:1">Sia afo ukpudop uyio,</para>
  <para style="q2" vid="PSA 28:1">ami ndiiba nte mbon e-etịkkeke edʌk ube.<verse eid="PSA 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2" />Kop ayịd a-ami ntuaha ñyem mbọm</para>
  <para style="q2" vid="PSA 28:2">naña nte ami ukoodo ñyem unwam,</para>
  <para style="q1" vid="PSA 28:2">nte mbenneke ubọk mmi</para>
  <para style="q2" vid="PSA 28:2">ñnyan ke Ataa Adisana Itie mfo.<verse eid="PSA 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3" />Kundʌt miin udakka ye mbon ibak,</para>
  <para style="q2" vid="PSA 28:3">ye mbon e-enamma abʌd-abʌd ñkpọ,</para>
  <para style="q1" vid="PSA 28:3">e-etañña ikọ emem-emem ye mbọhọidʌñ ammọ</para>
  <para style="q2" vid="PSA 28:3">ado enie idiọọkesịd ke esịd ammọ.<verse eid="PSA 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4" />Nọ ammọ utịb ubọkutom ammọ</para>
  <para style="q2" vid="PSA 28:4">ye utịb ibak ammọ;</para>
  <para style="q1" vid="PSA 28:4">nọ ammọ utịb ñkpọ se ubọk ammọ anam</para>
  <para style="q2" vid="PSA 28:4">nọ ammọ se idot ye ammọ.<verse eid="PSA 28:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5" />Sia ammọ imiinieghe mbaak inọ mme adinam <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 28:5">ye se ubọk amọ anam,</para>
  <para style="q1" vid="PSA 28:5">anye ayaawai ammọ abono ke isọñ</para>
  <para style="q2" vid="PSA 28:5">idiinyʌññọ itañ ammọ ibok aba tutu amama.<verse eid="PSA 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6" />Itooro anie <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 28:6">sia anye a-akop ayịd ake ami ntuaha ñyem mbọm.<verse eid="PSA 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7" />
    <char style="nd">Abọọñ</char> ado adudu mmi ye atuekọñ mmi;</para>
  <para style="q2" vid="PSA 28:7">esịd mmi abuọt idem ke anye, anye anyʌñ añnyaaña miin.</para>
  <para style="q1" vid="PSA 28:7">Esịd mmi ayọhọ ye idaara,</para>
  <para style="q2" vid="PSA 28:7">ndin ami ndat ikwọ mmi ntooro anye.<verse eid="PSA 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8" />
    <char style="nd">Abọọñ</char> ado adudu ikọd amọ,</para>
  <para style="q2" vid="PSA 28:8">akpọsọñ itie ubọkkọ adinyaaña anọ mbon ake emaekeyet adan inịm.<verse eid="PSA 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9" />Nyaaña ikọd mfo nyʌñ diọñ mbon e-edooho udeeme mfo;</para>
  <para style="q2" vid="PSA 28:9">do akpemeedọñ nọ ammọ nyʌñ kama ammọ ke nsi-nsi.<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="cl">Saam 29</para>
  <para style="d">Saam Defid.</para>
  <para style="s1">Uyio <char style="nd">Abọọñ</char> Ke Ayobio</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1" />Iben inọ <char style="nd">Abọọñ</char>, ndufo mbon anyọñ,</para>
  <para style="q2" vid="PSA 29:1">iben ubọọñ ye adudu inọ <char style="nd">Abọọñ</char>.<verse eid="PSA 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2" />Inọ <char style="nd">Abọọñ</char> ubọọñ a-adotto anyịñ amọ;</para>
  <para style="q2" vid="PSA 29:2">ikpono <char style="nd">Abọọñ</char>ke uyai adisanaido amọ.<verse eid="PSA 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3" />Uyio <char style="nd">Abọọñ</char> aba ke anyọñ mmọọñ;</para>
  <para style="q2" vid="PSA 29:3">Abasi ubọọñ atop nte aduma,</para>
  <para style="q2" vid="PSA 29:3">
    <char style="nd">Abọọñ</char> atop nte aduma ke anyọñ ikpọ mmọọñ.<verse eid="PSA 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4" />Uyio <char style="nd">Abọọñ</char> anie adudu;</para>
  <para style="q2" vid="PSA 29:4">uyio <char style="nd">Abọọñ</char> anie uku.<verse eid="PSA 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5" />Uyio <char style="nd">Abọọñ</char> asai mme sida;</para>
  <para style="q2" vid="PSA 29:5">
    <char style="nd">Abọọñ</char> asai mme sida Lebanọn mbai-mbai.<verse eid="PSA 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6" />Anye anam Lebanọn afrọ nte ñyịn enañ,</para>
  <para style="q2" vid="PSA 29:6">Siriọn nte ñyịn ayaaraenañ ikọd.<verse eid="PSA 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7" />Uyio <char style="nd">Abọọñ</char> asakka</para>
  <para style="q2" vid="PSA 29:7">ye akebkeb.<verse eid="PSA 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8" />Uyio <char style="nd">Abọọñ</char> anyeeñe akpautatan</para>
  <para style="q2" vid="PSA 29:8">
    <char style="nd">Abọọñ</char> anyeeñe Akpautatan Kades.<verse eid="PSA 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9" />Uyio <char style="nd">Abọọñ</char> anam edob aman ñyịn mbemiso akemini, uyio <char style="nd">Abọọñ</char> anwịn mme afriyo</para>
  <para style="q2" vid="PSA 29:9">anyʌñ ayaaña mme akai abono ukpọk.</para>
  <para style="q1" vid="PSA 29:9">Ndin ke tembịd amọ afịd awo ebọñ, “Ubọọñ!”<verse eid="PSA 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10" />
    <char style="nd">Abọọñ</char> atie ke ebekpo ke anyọñ ukwọ;</para>
  <para style="q2" vid="PSA 29:10">
    <char style="nd">Abọọñ</char> atie nte Adidem ke nsi-nsi.<verse eid="PSA 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11" />
    <char style="nd">Abọọñ</char> anọ ikọd amọ adudu;</para>
  <para style="q2" vid="PSA 29:11">
    <char style="nd">Abọọñ</char> adiọñ ikọd amọ ye emem.<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="cl">Saam 30<note caller="+" style="f"><char style="fr" closed="false">30:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 30:1-12 ewet Saam 3:2-13</char></note></para>
  <para style="d">Saam. Ikwọ. Ake udiọñ tembịd. Ake Defid.</para>
  <para style="s1">Akam Ekọọm</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1" />Ami ñyaukpono fiin, <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 30:1">sia afo amandịppe miin asio ke udem isọñ</para>
  <para style="q2" vid="PSA 30:1">uyakka mme asua mmi enem esịd embaña miin.<verse eid="PSA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2" />
    <char style="nd">Abọọñ</char> Abasi mmi, mmaukoot fiin ñyem unwam,</para>
  <para style="q2" vid="PSA 30:2">ndin afo amaanam udọñọ añkweeñe.<verse eid="PSA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3" />Afo, <char style="nd">Abọọñ</char>, amamben miin asio ke abioekpo;</para>
  <para style="q2" vid="PSA 30:3">afo amamfak miin asio ke ndobo udi.<verse eid="PSA 30:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4" />Ikwọ itooro <char style="nd">Abọọñ</char>, ndufo ndinen ikọd amọ;</para>
  <para style="q2" vid="PSA 30:4">itooro adisana anyịñ amọ.<verse eid="PSA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5" />Sia iyadesịd amọ ikpeeneke,</para>
  <para style="q2" vid="PSA 30:5">ado mfọn amọ ado ke nsi-nsi;</para>
  <para style="q1" vid="PSA 30:5">ntuaña akeme iba ke akonayio,</para>
  <para style="q2" vid="PSA 30:5">ado idaara adi ke ubakusen.<verse eid="PSA 30:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6" />Ke ini ami ñkedaaha afọn, mmaabo,</para>
  <para style="q2" vid="PSA 30:6">“Ami ndiitəkkoke idem tutu amama.”<verse eid="PSA 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7" />
    <char style="nd">Abọọñ</char>, ke ini afo akennọọhọ miin mfọn,</para>
  <para style="q2" vid="PSA 30:7">amaanam abod ubọọñ mmi asọọñọ ada;</para>
  <para style="q1" vid="PSA 30:7">ado ke ini akedịppe iso mfo,</para>
  <para style="q2" vid="PSA 30:7">idem amambọkkọ miin.<verse eid="PSA 30:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8" />Ñkukoot fiin, <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 30:8">ñketua ñkoot <char style="nd">Abọọñ</char> ñyem mbọm:<verse eid="PSA 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9" />“Nsoo idiido udod adieke eñkọppọ miin inua,</para>
  <para style="q2" vid="PSA 30:9">adieke ami nsọiyọke ndʌk udi?</para>
  <para style="q1" vid="PSA 30:9">Nte ntọñ ayautooro fiin?</para>
  <para style="q2" vid="PSA 30:9">Nte anye ayaatañ akpanikọ mfo?<verse eid="PSA 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10" />Kop, <char style="nd">Abọọñ</char>, nyʌñ ntua miin mbọm;</para>
  <para style="q2" vid="PSA 30:10">
    <char style="nd">Abọọñ</char>, do unwam mmi.”<verse eid="PSA 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11" />Afo amekanna ntuaña mmi asịn ke unek;</para>
  <para style="q2" vid="PSA 30:11">afo amansio miin afọñikpo ansịn idaara,<verse eid="PSA 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12" />nọ ato do esịd mmi akwọ itooro mfo, ke anyʌñ adop uyio.</para>
  <para style="q2" vid="PSA 30:12">
    <char style="nd">Abọọñ</char> Abasi mmi, ñyautooro fiin ke nsi-nsi.<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="cl">Saam 31<note caller="+" style="f"><char style="fr" closed="false">31:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 31:1-24 ewet Saam 31:2-35</char></note></para>
  <para style="d">Ake etubom ikwọ. Saam Defid.</para>
  <para style="s1">Akam E-ebọññọ Eyem Ukpeme</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1" />Ke afo, <char style="nd">Abọọñ</char>, ami ndịbe ke afo;</para>
  <para style="q2" vid="PSA 31:1">kuuyak ami ndia abuud;</para>
  <para style="q2" vid="PSA 31:1">dat adinenido mfo ñnyaaña miin.<verse eid="PSA 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2" />Kpañ utọñ mfo nnọ,</para>
  <para style="q2" vid="PSA 31:2">sọsọp di ñnyaaña,</para>
  <para style="q1" vid="PSA 31:2">do itiad udịbe mmi,</para>
  <para style="q2" vid="PSA 31:2">akpọsọñ itie ubọkkọ adiñnyaaña miin.<verse eid="PSA 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3" />Sia afo adooho itiad mmi ye itie ubọkkọ mmi,</para>
  <para style="q2" vid="PSA 31:3">ke ntak anyịñ mfo, ndat miin usʌñ.<verse eid="PSA 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4" />Kuuyak ndʌk afia e-ekọọhọ enịm ennọ miin,</para>
  <para style="q2" vid="PSA 31:4">sia afo ado itie udịbe mmi.<verse eid="PSA 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5" />Ami mmeyaak ukpọñ mmi usịn fiin ke ubọk;</para>
  <para style="q2" vid="PSA 31:5">mfak miin, <char style="nd">Abọọñ</char>, anam akpanikọ Abasi mmi.<verse eid="PSA 31:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6" />Ami mmesua mbon e-emʌmmọ mme ubobodñkpọ i-imiinieghe ufọn ekama;</para>
  <para style="q2" vid="PSA 31:6">amaado ami, mbuọt idem ke <char style="nd">Abọọñ</char>.<verse eid="PSA 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7" />Ami ñyaadaara ñnyʌñ nnem esịd ke ima mfo,</para>
  <para style="q2" vid="PSA 31:7">sia afo amaakịt ukuud mmi</para>
  <para style="q2" vid="PSA 31:7">anyʌñ adiọọñọ ubiak ukpọñ mmi.<verse eid="PSA 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8" />Afo uñyaaha miin usịn ke ubọk mme asua</para>
  <para style="q2" vid="PSA 31:8">ado anam ñkpad mmi abono ke itie se inwaña.<verse eid="PSA 31:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9" />Ntua miin mbọm, <char style="nd">Abọọñ</char>, sia mba ke nnananyen;</para>
  <para style="q2" vid="PSA 31:9">anyen amfuut anọ mfʌhọ,</para>
  <para style="q2" vid="PSA 31:9">ukpọñ ye idem mmi eba ke mfʌhọ.<verse eid="PSA 31:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10" />Uwem mmi ayọhọ ye mfʌhọ</para>
  <para style="q2" vid="PSA 31:10">ndin isua mmi ayọhọ ye mmịm;</para>
  <para style="q1" vid="PSA 31:10">inweek ambọkkọ anọ idiọọkñkpọ mmi,</para>
  <para style="q2" vid="PSA 31:10">mme akpọ mmi enyʌñ emeem.<verse eid="PSA 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11" />Ke ntak afịd mme asua mmi,</para>
  <para style="q2" vid="PSA 31:11">ami ndo ñkpọ nsaha nnọ mme mbọhọidʌñ mmi</para>
  <para style="q1" vid="PSA 31:11">ñnyʌñ ndo ñkpọ ndịk nnọ mme akpan ufan mmi,</para>
  <para style="q2" vid="PSA 31:11">mbon se iñkịt ke usʌñ efeeñe eñkpọñ.<verse eid="PSA 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12" />Emfre miin nte ebo ke ñkekpaakpa;</para>
  <para style="q2" vid="PSA 31:12">ami ñyeba nte mbomo usiọñ.<verse eid="PSA 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13" />Sia ami mmekop naña uwak awo esʌk esuuk uyio etañ,</para>
  <para style="q2" vid="PSA 31:13">“Ndịk aba afịd itie!”</para>
  <para style="q1" vid="PSA 31:13">Ammọ edʌk idiọọk adu embaña miin</para>
  <para style="q2" vid="PSA 31:13">enyʌñ edioomo naña edat uwem mmi.<verse eid="PSA 31:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14" />Ado ami mbuọt idem ke afo, <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 31:14">ami mbo ke, “Afo ado Abasi mmi.”<verse eid="PSA 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15" />Ini mmi asịne ke ubọk mfo;</para>
  <para style="q2" vid="PSA 31:15">ñnyaaña miin sio ke ubọk mme asua mmi,</para>
  <para style="q2" vid="PSA 31:15">ke ubọk mbon embịneke miin.<verse eid="PSA 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16" />Yak iso mfo ayamma anọ awo mfo;</para>
  <para style="q2" vid="PSA 31:16">ñnyaaña miin ke akwa ima mfo.<verse eid="PSA 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17" />Kuuyak ami ndia ndọk, <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 31:17">sia ami mmetua ayịd unọ fiin;</para>
  <para style="q1" vid="PSA 31:17">ado yak mbon ibak edia ndọk</para>
  <para style="q2" vid="PSA 31:17">enyʌñ edop uyio ke abioekpo.<verse eid="PSA 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18" />Yak ñkpọkinua nsu ammọ edobo,</para>
  <para style="q2" vid="PSA 31:18">sia ye ntañidem ye unana ukpono</para>
  <para style="q2" vid="PSA 31:18">ammọ etañ ikọ isa-isa edian ndinen awo.<verse eid="PSA 31:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19" />Adaña die ke nti ñkpọ</para>
  <para style="q2" vid="PSA 31:19">ake afo anịmme anọọ mbon se ubaak fiin ewak,</para>
  <para style="q1" vid="PSA 31:19">ye se afo anam nọ afịd awo ekịt,</para>
  <para style="q2" vid="PSA 31:19">anọ mbon se idịbe ke afo.<verse eid="PSA 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20" />Afo adịp ammọ ke itie udịbe ke iso mfo</para>
  <para style="q2" vid="PSA 31:20">mbaak mme ndiọi ibak ñkara mbon awo;</para>
  <para style="q1" vid="PSA 31:20">afo anịm ammọ ke ifuuro ke itie idʌñ mfo</para>
  <para style="q2" vid="PSA 31:20">mbaak mme edeme ndoduyio.<verse eid="PSA 31:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21" />Itooro anie <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 31:21">sia anye amañwọt miin mme utịppeñkpọ e-etooho ima amọ</para>
  <para style="q2" vid="PSA 31:21">ke ini ami ñkebaaha ke abio e-ekekannake ekʌk.<verse eid="PSA 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22" />Ke ini ndịk akennamma miin ami mmaabo,</para>
  <para style="q2" vid="PSA 31:22">“Embịne miin esio ke iso mfo!”</para>
  <para style="q1" vid="PSA 31:22">Ado afo amaakop ayịd ake ami ntuaha ñyem mbọm</para>
  <para style="q2" vid="PSA 31:22">ke ini ami ñkukoodo fiin ñyem unwam.<verse eid="PSA 31:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23" />Ima <char style="nd">Abọọñ</char>, afịd nti ikọd amọ!</para>
  <para style="q2" vid="PSA 31:23">
    <char style="nd">Abọọñ</char> akpeme mbon e-enamma akpanikọ ye anye,</para>
  <para style="q2" vid="PSA 31:23">ado asio mbon ntañidem usiene ayọhọ-ayọhọ<verse eid="PSA 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24" />Sọñ idem nyʌñ sọñ esịd,</para>
  <para style="q2" vid="PSA 31:24">afịd ndufo e-edotto anyen ke <char style="nd">Abọọñ</char>.<verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="cl">Saam 32</para>
  <para style="d">Ake Defid. <char style="tl">Maskil.</char></para>
  <para style="s1">Inemesịd A-abaaha Ke Adinie Adifeen</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1" />Afọfọn anọ awo</para>
  <para style="q2" vid="PSA 32:1">e-efeene mme ukwañido amọ,</para>
  <para style="q2" vid="PSA 32:1">e-enyʌññọ efʌk ndiọiñkpọ amọ.<verse eid="PSA 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2" />Afọfọn anọ awo</para>
  <para style="q2" vid="PSA 32:2">ake <char style="nd">Abọọñ</char> imiibatta idiọọkñkpọ amọ inọ anye</para>
  <para style="q2" vid="PSA 32:2">a-abiaña imiinyʌññọ iba ke sịbidịd amọ.<verse eid="PSA 32:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3" />Ke ini ami ñkedoppo uyio,</para>
  <para style="q2" vid="PSA 32:3">mme akpọ mmi emaeyeeme</para>
  <para style="q2" vid="PSA 32:3">ato ntuaña mmi ke afịd usen.<verse eid="PSA 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4" />Sia uweemeayio ye akonayio</para>
  <para style="q2" vid="PSA 32:4">ubọk mfo amandoro miin ke idem;</para>
  <para style="q1" vid="PSA 32:4">udịd amañkweeñe</para>
  <para style="q2" vid="PSA 32:4">nte ufiob a-awuọhọ ke ini ndaayio.<verse eid="PSA 32:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5" />Ndin ami mmaaben idiọọkñkpọ mmi unịm fiin ke iso</para>
  <para style="q2" vid="PSA 32:5">ñnyʌññọ mfʌk mme ukwaññkpọ mmi.</para>
  <para style="q1" vid="PSA 32:5">Ami mmaabo nte, “Ami ñyaayaara</para>
  <para style="q2" vid="PSA 32:5">mme ndudue mmi nnọ <char style="nd">Abọọñ</char>.”</para>
  <para style="q1" vid="PSA 32:5">Ndin afo amaafeen</para>
  <para style="q2" vid="PSA 32:5">mme ndudue mmi.<verse eid="PSA 32:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6" />Ke ntoro yak mme andunịm fiin ke akpanikọ ebọñ akam unọ fiin</para>
  <para style="q2" vid="PSA 32:6">ke ini eduukịt fiin;</para>
  <para style="q1" vid="PSA 32:6">ke akpanikọ mbufịd ñkpoon mmọọñ</para>
  <para style="q2" vid="PSA 32:6">idiisịmme ammọ.<verse eid="PSA 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7" />Afo ado itie udịbe mmi;</para>
  <para style="q2" vid="PSA 32:7">afo ayañkpeme miin asio ke mfịna</para>
  <para style="q2" vid="PSA 32:7">anyʌñ adat ikwọ ubọkkọ añkanna miin akʌk.<verse eid="PSA 32:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8" />Ami ñyautemme ñnyʌñ ukpeep fiin usʌñ a-anaaha afo asaña;</para>
  <para style="q2" vid="PSA 32:8">ami ñyaunọ fiin item ñnyʌñ ntịñ anyen use fiin ye anyen ima mmi.<verse eid="PSA 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9" />Kuuba nte enañmbakara me ñwaahadọñki,</para>
  <para style="q2" vid="PSA 32:9">ake adiinieghe ifiọk</para>
  <para style="q1" vid="PSA 32:9">a-anaaha esịn ammọ ukwak ye udʌk ke mbañ</para>
  <para style="q2" vid="PSA 32:9">imiidooho ntoro ammọ isañake ubịne.<verse eid="PSA 32:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10" />Ukuud a-akeeneke mbon ibak ewak,</para>
  <para style="q2" vid="PSA 32:10">ado ima <char style="nd">Abọọñ</char> ake imiikpuuho</para>
  <para style="q2" vid="PSA 32:10">akanna awo se inie mbuọdidem ke anye akʌk.<verse eid="PSA 32:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11" />Idaara ke <char style="nd">Abọọñ</char> inyʌñ inem esịd, ndufo mme ndinen awo;</para>
  <para style="q2" vid="PSA 32:11">ikwọ, afịd ndufo e-enieghe nti esịd!<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="cl">Saam 33</para>
  <para style="s1">Ikwọ Itooro Inọ <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1" />Ikwọ ke idaara Inọ <char style="nd">Abọọñ</char>, ndufo ndinen awo;</para>
  <para style="q2" vid="PSA 33:1">adot ndinen awo aditooro anye.<verse eid="PSA 33:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2" />Itooro <char style="nd">Abọọñ</char> ye ekpa;</para>
  <para style="q2" vid="PSA 33:2">ibre ikwọ inọ anye ke ndido udʌk duob.<verse eid="PSA 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3" />Ikwọ ufa ikwọ inọ anye;</para>
  <para style="q2" vid="PSA 33:3">itịm ibre, inyʌñ isio ñkpo idaara.<verse eid="PSA 33:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4" />Sia ikọ <char style="nd">Abọọñ</char> anen anyʌñ ado akpanikọ;</para>
  <para style="q2" vid="PSA 33:4">anye awọt akpanikọ ke afịd se anye anam.<verse eid="PSA 33:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5" />
    <char style="nd">Abọọñ</char> ama adinenido ye unenikpe;</para>
  <para style="q2" vid="PSA 33:5">ederimbod ayọhọ ye ima amọ ake imiikpuuho.<verse eid="PSA 33:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6" />Ekedat ikọ <char style="nd">Abọọñ</char> enam anyọñ,</para>
  <para style="q2" vid="PSA 33:6">ekedat inweek inua amọ enam mme udịm ntantaafiọñ.<verse eid="PSA 33:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7" />Anye akpuut mmọọñ inyañ adọñ ke mme atu;</para>
  <para style="q2" vid="PSA 33:7">akoono utəño mmọọñ adọñ ke mme itie ubon ñkpọ.<verse eid="PSA 33:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8" />Yak afịd ederimbod ebaak <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 33:8">yak afịd awo ke ekondo eteeñe anye.<verse eid="PSA 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9" />Sia anye amaatañ ikọ, ndin amaawuọ asu;</para>
  <para style="q2" vid="PSA 33:9">anye amaanọ ewʌhọ, ndin amaasọọñọ ada.<verse eid="PSA 33:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10" />
    <char style="nd">Abọọñ</char> abiat uduak mme idịd;</para>
  <para style="q2" vid="PSA 33:10">anye anam akikere mme ubon awo akpu.<verse eid="PSA 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11" />Ado uduak <char style="nd">Abọọñ</char> asọọñọ ada ke nsi-nsi,</para>
  <para style="q2" vid="PSA 33:11">akikere esịd amọ ada ke afịd emana.<verse eid="PSA 33:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12" />Afọfọn anọ idịd A-Abasi ammọ adooho <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 33:12">mbon a-anye amekke nte udeeme amọ.<verse eid="PSA 33:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13" />
    <char style="nd">Abọọñ</char> atie ke anyọñ asuuk anyen ase isọñ</para>
  <para style="q2" vid="PSA 33:13">anyʌñ akịt ubon awo;<verse eid="PSA 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14" />atie ke itie idʌñ amọ ase</para>
  <para style="q2" vid="PSA 33:14">afịd awo se idʌñ ke ederimbod,<verse eid="PSA 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15" />anye a-akebotto esịd afịd awo,</para>
  <para style="q2" vid="PSA 33:15">a-adiọọñọke afịd se ammọ enam.<verse eid="PSA 33:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16" />Ibaaha adidem ndomokeed a-abọkkọke ato ntak ekamba udịm ekọñ amọ;</para>
  <para style="q2" vid="PSA 33:16">ibaaha awo ekọñ ndomokeed a-abọkkọ ato ekamba adudu amọ.<verse eid="PSA 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17" />Idodanyen ke enañmbakara ikemeke adinyaaña awo ndomokeed;</para>
  <para style="q2" vid="PSA 33:17">kpa ye akwa adudu amọ anye ikanna inyaaña awo.<verse eid="PSA 33:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18" />Ado anyen <char style="nd">Abọọñ</char> awʌhọ ke mbon se ibaak anye,</para>
  <para style="q2" vid="PSA 33:18">mbon ake edotto anyen ke nsi-nsi ima amọ,<verse eid="PSA 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19" />adinyaaña ammọ nsio ke ñkpa</para>
  <para style="q2" vid="PSA 33:19">ñnyʌñ nnịm ammọ uwem ke ini akañ.<verse eid="PSA 33:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20" />Ñnyịn ibet <char style="nd">Abọọñ</char> ye idodanyen;</para>
  <para style="q2" vid="PSA 33:20">anye ado unwam ñnyịn ye atuekọñ ñnyịn.<verse eid="PSA 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21" />Esịd ñnyịn edaara ke anye,</para>
  <para style="q2" vid="PSA 33:21">sia ñnyịn iminie mbuọdidem ke adisana anyịñ amọ.<verse eid="PSA 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22" />Yak nsi-nsi ima mfo aba ye ñnyịn, <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 33:22">kpa naña ñnyịn idot anyen ke afo.<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="cl">Saam 34<note caller="+" style="f"><char style="fr" closed="false">34:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 34:1-22 ewet Saam 34:2-23</char></note></para>
  <para style="d">Ake Defid. Ke ini anye akenamma ñkpọ nte awo mbeiwuod ke iso Abimelek, a-akebịneke anye asio, ndin anye adakka anyọñ.</para>
  <para style="s1">Kpono <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1" />Ami ñyaakọọm <char style="nd">Abọọñ</char> afịd ini;</para>
  <para style="q2" vid="PSA 34:1">itooro amọ ayaaba ke ñkpọkinua mmi afịd ini.<verse eid="PSA 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2" />Ami ñyaabuuro mbuuro ke <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 34:2">yak mbon ñkpọnnam ekop enyʌñ edaara.<verse eid="PSA 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3" />Ikpono <char style="nd">Abọọñ</char> ye ami;</para>
  <para style="q2" vid="PSA 34:3">yak idiana keed itooro anyịñ amọ.<verse eid="PSA 34:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4" />Ami mmaayem <char style="nd">Abọọñ</char>, ndin anye amañyie miin;</para>
  <para style="q2" vid="PSA 34:4">añnyaaña asio ke afịd ndịk mmi.<verse eid="PSA 34:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5" />Iso anwaña mbon se iwuuk anyen ise anye;</para>
  <para style="q2" vid="PSA 34:5">kpaanaanam iso ammọ idiaha abuud.<verse eid="PSA 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6" />Awo unana ami amaaseeme akoot, ndin <char style="nd">Abọọñ</char> amaakop;</para>
  <para style="q2" vid="PSA 34:6">anye amaanyaaña anye asio ke afịd mfịna amọ.<verse eid="PSA 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7" />Enyere <char style="nd">Abọọñ</char> akanna mbon se ibaak anye akʌk,</para>
  <para style="q2" vid="PSA 34:7">anyʌñ anyaaña ammọ.<verse eid="PSA 34:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8" />Itap ise ke <char style="nd">Abọọñ</char> a-afọn;</para>
  <para style="q2" vid="PSA 34:8">afọfọn anọ awo a-adịbeke ke anye.<verse eid="PSA 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9" />Ibaak <char style="nd">Abọọñ</char>, ndufo mme ndisana ikọd amọ,</para>
  <para style="q2" vid="PSA 34:9">sia mbon se ibaak anye inanake ñkpọ ndomokeed.<verse eid="PSA 34:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10" />Mme ekpe ekeme ikop mmemidem ye abiọọñ,</para>
  <para style="q2" vid="PSA 34:10">ado mbon e-eyemme <char style="nd">Abọọñ</char> inanake eti ñkpọ ndomokeed.<verse eid="PSA 34:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11" />Idi, nditọ mmi, ikpañ utọñ innọ miin;</para>
  <para style="q2" vid="PSA 34:11">Ñyaikpeep ndufo mbaak <char style="nd">Abọọñ</char>.<verse eid="PSA 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12" />Anie awo ke atu ndufo ama uwem</para>
  <para style="q2" vid="PSA 34:12">anyʌñ ayem adikịt uwak usen eyọhọke ye nti ñkpọ?<verse eid="PSA 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13" />Kpeme edeme mfo akuutañ idiọọk</para>
  <para style="q2" vid="PSA 34:13">nyʌñ kpeme ñkpọkinua mfo akuusʌhọ nsu.<verse eid="PSA 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14" />Wọññọ kpọñ idiọọk nyʌñ nam se inen;</para>
  <para style="q2" vid="PSA 34:14">yem emem nyʌñ feghe bịne anye.<verse eid="PSA 34:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15" />Anyen <char style="nd">Abọọñ</char> ase ndinen awo,</para>
  <para style="q2" vid="PSA 34:15">ndin utọñ amọ anyʌñ akop eseeme ammọ;<verse eid="PSA 34:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16" />ado <char style="nd">Abọọñ</char> inenne iso ye mme anam idiọọk,</para>
  <para style="q2" vid="PSA 34:16">nọ ato do anye asọọk anyịñ ammọ asio ke iso isọñ.<verse eid="PSA 34:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17" />Mme ndinen awo eseeme, ndin <char style="nd">Abọọñ</char> akop ammọ;</para>
  <para style="q2" vid="PSA 34:17">anye anyaaña ammọ asio ke afịd mfịna ammọ.<verse eid="PSA 34:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18" />
    <char style="nd">Abọọñ</char> akpere mbon ake esịd abʌññọke</para>
  <para style="q2" vid="PSA 34:18">anyʌñ anyaaña mbon ake sịbidịd ammọ anuahake.<verse eid="PSA 34:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19" />Adinen awo akeme adinie uwak mfịna,</para>
  <para style="q2" vid="PSA 34:19">ado <char style="nd">Abọọñ</char> anyaaña anye asio ke afịd;<verse eid="PSA 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20" />anye akpeme afịd mme akpọ amọ,</para>
  <para style="q2" vid="PSA 34:20">ndomokeed ke atu ammọ idiibʌññọke.<verse eid="PSA 34:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21" />Idiọọk ayaawot ibak;</para>
  <para style="q2" vid="PSA 34:21">mme asua adinen awo eyaedue isob.<verse eid="PSA 34:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22" />
    <char style="nd">Abọọñ</char> ayaafak ikọd amọ;</para>
  <para style="q2" vid="PSA 34:22">awo ndomokeed a-adịbeke ke anye idiidueghe isob.<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="cl">Saam 35</para>
  <para style="d">Ake Defid.</para>
  <para style="s1">Akam E-ebọññọ Eyem Ukpeme Mbaak Mme Asua</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1" />
    <char style="nd">Abọọñ</char>, nam ikọ ye mbon e-enamma ikọ ye ami;</para>
  <para style="q2" vid="PSA 35:1">nwana ye mbon ake enwanake ye ami.<verse eid="PSA 35:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2" />Ben ukwakekọñ ye ñkpọ ekọñ;</para>
  <para style="q2" vid="PSA 35:2">dakka da nyʌñ di ñnyaaña miin.<verse eid="PSA 35:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3" />Sio eduad ye yafeliin</para>
  <para style="q2" vid="PSA 35:3">biọñọ mbon embịneke miin.</para>
  <para style="q1" vid="PSA 35:3">Mbo miin,</para>
  <para style="q2" vid="PSA 35:3">“Ami ndo adinyaaña mfo.”<verse eid="PSA 35:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4" />Yak mbon se iyem uwem mmi</para>
  <para style="q2" vid="PSA 35:4">ekịt abuud ye asuenne;</para>
  <para style="q1" vid="PSA 35:4">yak mbon se iyem nsobo mmi</para>
  <para style="q2" vid="PSA 35:4">etịmme edem ke ndutịme.<verse eid="PSA 35:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5" />Yak ammọ eba nte mbio ke iso afịm,</para>
  <para style="q2" vid="PSA 35:5">enyere <char style="nd">Abọọñ</char> anyʌñ abịn ammọ aduọọk;<verse eid="PSA 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6" />yak usʌñ ammọ akịm anyʌñ adọrọ,</para>
  <para style="q2" vid="PSA 35:6">enyere <char style="nd">Abọọñ</char> anyʌñ adiana ammọ.<verse eid="PSA 35:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7" />Sia ammọ edịppe iyịre ammọ ennọ miin ke unana ntak</para>
  <para style="q2" vid="PSA 35:7">enyʌñ edọk ukpe enịm ennọ miin ke unana ntak,<verse eid="PSA 35:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8" />yak nsobo awuọ ammọ adiwad-adiwad,</para>
  <para style="q2" vid="PSA 35:8">yak iyịre ammọ ekedịppe akọp ammọ aduọọk,</para>
  <para style="q2" vid="PSA 35:8">yak ammọ eduọ edʌk ukpe ammọ eketịppeke, esobo ammọ.<verse eid="PSA 35:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9" />Ndin ukpọñ mmi ayaadaara ke <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 35:9">anyʌñ anem esịd ke adinyaaña amọ.<verse eid="PSA 35:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10" />Afịd idem mmi ayaabo,</para>
  <para style="q2" vid="PSA 35:10">“Anie awo iba nte afo, <char style="nd">Abọọñ</char>?</para>
  <para style="q1" vid="PSA 35:10">Afo amenyaaña awo unana asio ke ubọk mme ñkpọsọñ ye mme anie adudu,</para>
  <para style="q2" vid="PSA 35:10">anyaaña mme unana awo ye mbon ukuud asio ke ubọk mbon e-etʌkkọ ammọ.”<verse eid="PSA 35:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11" />Mme afai-afai ntiense edaaña eda;</para>
  <para style="q2" vid="PSA 35:11">ammọ embiime ebaña mme ñkpọ se ami mmendiọọñọke.<verse eid="PSA 35:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12" />Ammọ eben idiọọk ensio miin usiene eti;</para>
  <para style="q2" vid="PSA 35:12">enyʌñ enam ami mba nte awo a-atieghe ikpo.<verse eid="PSA 35:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13" />Ado idaha ammọ ekedọñọke, ami mmaasịne afọñikpo</para>
  <para style="q2" vid="PSA 35:13">ñnyʌñ nsuuk idem mmi ke aditie utreudia.</para>
  <para style="q1" vid="PSA 35:13">Ke ini awo imiikibọọrọke akam mmi,<verse eid="PSA 35:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 35:14" />ami ñkeba ke mmọọñayịd</para>
  <para style="q2" vid="PSA 35:14">nte ebo ke ado ufan me ayịneka mmi.</para>
  <para style="q1" vid="PSA 35:14">Ami mba ke mfʌhọ</para>
  <para style="q2" vid="PSA 35:14">nte ebo ke ntua eka mmi.<verse eid="PSA 35:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15" />Ado ke ini ami ñkefiọnnọke, ammọ emaesoobo idem ammọ ke inemesịd;</para>
  <para style="q2" vid="PSA 35:15">mbon afai emaesoobo idem ammọ embaña miin ami ndiọọñọke.</para>
  <para style="q2" vid="PSA 35:15">Ammọ emaendọk miin, inyʌññọ idop.<verse eid="PSA 35:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16" />Ammọ emaensak miin esaha ke ibak-ibak usʌñ, nte mbon i-imiidiọọñọke Abasi</para>
  <para style="q2" vid="PSA 35:16">ammọ emaekwak ntakeded ense miin.<verse eid="PSA 35:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17" />
    <char style="nd">Abọọñ</char>, afo adiitie ikpeene die ise ñkpọ ami?</para>
  <para style="q2" vid="PSA 35:17">Mfak miin sio ke mme nsobo ammọ,</para>
  <para style="q2" vid="PSA 35:17">sio uwem mmi ke ubọk mme ekpe ami.<verse eid="PSA 35:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18" />Ami ñyaukọọm fiin ke ekamba atu awo;</para>
  <para style="q2" vid="PSA 35:18">ñyautooro fiin ke atu uwak awo.<verse eid="PSA 35:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19" />Kuuyak mbon e-edooho mme asua mmi ke unana ntak</para>
  <para style="q2" vid="PSA 35:19">edaara embaña;</para>
  <para style="q1" vid="PSA 35:19">kuuyak mbon ensuaha miin ke unana ntak</para>
  <para style="q2" vid="PSA 35:19">eñkeep ke idiọọkesịd;<verse eid="PSA 35:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20" />Ammọ itañña ikọ emem-emem,</para>
  <para style="q2" vid="PSA 35:20">ado ekere nsu-nsu ikọ ubiomikpe</para>
  <para style="q2" vid="PSA 35:20">ebaña mbon se idʌñ emem-emem ke abio.<verse eid="PSA 35:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21" />Ammọ ensak imam ibak ebo, “Aha! Aha!</para>
  <para style="q2" vid="PSA 35:21">Ñnyịn imikịt ke anyen ñnyịn.”<verse eid="PSA 35:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22" />
    <char style="nd">Abọọñ</char>, afo amekịt ami; kuudop uyio.</para>
  <para style="q2" vid="PSA 35:22">Kuunyọọñ usʌñ uñkpọñ, <char style="nd">Abọọñ</char>.<verse eid="PSA 35:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23" />Demme, nyʌñ dakka da kpe ikpe mmi!</para>
  <para style="q2" vid="PSA 35:23">Nam ikọ ke ntak mmi, Abasi mmi ye <char style="nd">Abọọñ</char> mmi.<verse eid="PSA 35:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24" />
    <char style="nd">Abọọñ</char> Abasi mmi, kpe ikpe mmi ke adinenido mfo;</para>
  <para style="q2" vid="PSA 35:24">kuuyak ammọ enem esịd embaña miin.<verse eid="PSA 35:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25" />Kuuyak ammọ ekere ke esịd ammọ ebo, “Ii, kpa naña ikiyem ado ado!”</para>
  <para style="q2" vid="PSA 35:25">me ebo ete, “Ñnyịn imiben anye imen.”<verse eid="PSA 35:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26" />Yak afịd mbon se inem esịd ibaña ukuud mmi</para>
  <para style="q2" vid="PSA 35:26">ekịt abuud ye ndutịme;</para>
  <para style="q1" vid="PSA 35:26">yak afịd mbon se ibuuro mbuuro imbaña</para>
  <para style="q2" vid="PSA 35:26">esịne afọñ abuud ye asuenne ke idem.<verse eid="PSA 35:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27" />Yak mbon se inem esịd ibaña unen ikpe mmi</para>
  <para style="q2" vid="PSA 35:27">esio ñkpo idaara enyʌñ enem esịd;</para>
  <para style="q1" vid="PSA 35:27">yak afịd ini ammọ ebo, “Yak ukpono anie <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 35:27">ake anemme esịd abaña ufọn awo amọ.”<verse eid="PSA 35:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28" />Edeme mmi ayaatañ abaña adinenido mfo,</para>
  <para style="q2" vid="PSA 35:28">ye itooro mfo ke afịd usen.<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="cl">Saam 36<note caller="+" style="f"><char style="fr" closed="false">36:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 36:1-12 ewet Saam 36:2-13</char></note></para>
  <para style="d">Ake etubom ikwọ. Ake Defid ayịnufọk <char style="nd">Abọọñ</char>.</para>
  <para style="s1">Idiọọkñkpọ Awo ye Mfọnido Abasi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1" />Mmenie etob nto Abasi ke esịd mmi</para>
  <para style="q2" vid="PSA 36:1">abaña idiọọkñkpọ awo ibak:</para>
  <para style="q1" vid="PSA 36:1">Mbaak Abasi ibaaha</para>
  <para style="q2" vid="PSA 36:1">ke iso ammọ.<verse eid="PSA 36:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2" />Ke anyen ammọ, ammọ ebiaña idem ammọ</para>
  <para style="q2" vid="PSA 36:2">tutu ikanna ikịt inyʌññọ ikan isua idiọọkñkpọ ammọ.<verse eid="PSA 36:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3" />Ikọ inua ammọ edo ibak ye abiaña;</para>
  <para style="q2" vid="PSA 36:3">ammọ inamma ñkpọ ye ifiọk inyʌññọ inam se ifọn.<verse eid="PSA 36:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4" />Ke idem ñkpana nnaa ammọ, ammọ ekere ibak;</para>
  <para style="q2" vid="PSA 36:4">ammọ esịn idem ammọ ke idiọọk usʌñ</para>
  <para style="q2" vid="PSA 36:4">inyʌññọ isịn se imiifọnnọ.<verse eid="PSA 36:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5" />Ima mfo, <char style="nd">Abọọñ</char>, asịm anyọñ,</para>
  <para style="q2" vid="PSA 36:5">akpanikọ mfo asịm ikpaanyọñ.<verse eid="PSA 36:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6" />Adinenido mfo aba nte mme abod se ikoñ ikan,</para>
  <para style="q2" vid="PSA 36:6">ikpe mfo aba nte akwa udem inyañ.</para>
  <para style="q2" vid="PSA 36:6">Afo, <char style="nd">Abọọñ</char>, anyaaña mme awo ye mme unam.<verse eid="PSA 36:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7" />O Abasi, ima mfo i-imiikpuuho asọñ die udua!</para>
  <para style="q2" vid="PSA 36:7">Mbon awo edịbe ke idak mba mfo.<verse eid="PSA 36:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8" />Ammọ edia eyʌkkọ ke uwak inie ufọk mfo;</para>
  <para style="q2" vid="PSA 36:8">afo anọ ammọ se enwọñ ato akpa inemesịd mfo.<verse eid="PSA 36:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9" />Sia idịm mmọọñ uwem ado ke afo;</para>
  <para style="q2" vid="PSA 36:9">ke unwana mfo ke ñnyịn ikịt unwana.<verse eid="PSA 36:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10" />Kaa iso ye ima mbon ake udiọọñọke fiin,</para>
  <para style="q2" vid="PSA 36:10">adinenido mfo ye mbon eti esịd.<verse eid="PSA 36:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11" />Kuuyak ñkpad mbon ntañidem ensịm miin,</para>
  <para style="q2" vid="PSA 36:11">kuunyʌñ uyak ubọk mbon ibak embịn miin esio.<verse eid="PSA 36:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12" />Se naña mbon ibak eduọññọ enaa,</para>
  <para style="q2" vid="PSA 36:12">etop ammọ eduọọk ke isọñ, ammọ ikanna idakka ida!<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="cl">Saam 37</para>
  <para style="d">Ake Defid.</para>
  <para style="s1">Mbuọdidem Ke <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1" />Kuufịna idem mfo ubaña mme abʌd-abʌd awo</para>
  <para style="q2" vid="PSA 37:1">kuunyʌñ ufịbe mbon se inam idiọọk;<verse eid="PSA 37:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2" />sia ikpeeneke ammọ eyaeyeppe nte mbid,</para>
  <para style="q2" vid="PSA 37:2">eyaesọp ekpañña nte awawa mfañ.<verse eid="PSA 37:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3" />Nie mbuọdidem ke <char style="nd">Abọọñ</char> nyʌñ nam se ifọn;</para>
  <para style="q2" vid="PSA 37:3">dʌñ ke isọñ nyʌñ kop inem ifuuro Abasi.<verse eid="PSA 37:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4" />Nem esịd ke <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 37:4">ndin anye ayaunọ fiin mme udọñ esịd mfo.<verse eid="PSA 37:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5" />Yaak usʌñ mfo nọ <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 37:5">buọt idem ke anye, ke anye ayaanam ami:<verse eid="PSA 37:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6" />Anye ayaanam eti utịb mfo ayamma nte usiere,</para>
  <para style="q2" vid="PSA 37:6">unen mfo ayamma nte utịn ufọọd uweemeayio.<verse eid="PSA 37:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7" />Ba ke ndobuyio ke iso <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 37:7">nyʌñ bet anye ke ime;</para>
  <para style="q1" vid="PSA 37:7">kuufịna idem mfo ubaña mbon e-eforoke ke usʌñ ammọ,</para>
  <para style="q2" vid="PSA 37:7">ke ini ammọ enamma ibak ñkara ammọ.<verse eid="PSA 37:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8" />Tre iyadesịd nyʌñ kpọñ ifiobesịd;</para>
  <para style="q2" vid="PSA 37:8">kuufịna idem, adat awo asịn ke idiọọk.<verse eid="PSA 37:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9" />Sia eyaesobo mme anamidiọọk,</para>
  <para style="q2" vid="PSA 37:9">ado mbon e-enieghe idodanyen ke <char style="nd">Abọọñ</char> eyaedat isọñ enie.<verse eid="PSA 37:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10" />Etək ini mbon ibak idiibaaha aba;</para>
  <para style="q2" vid="PSA 37:10">akpekọm ayeeyem ammọ, uduukịtte.<verse eid="PSA 37:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11" />Ado mbon nsuukidem eyaedat isọñ enie</para>
  <para style="q2" vid="PSA 37:11">enyʌñ ekop inem emem ye uforo.<verse eid="PSA 37:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12" />Mbon ibak eduak idiọọk uduak ebaña ndinen awo;</para>
  <para style="q2" vid="PSA 37:12">enyʌñ ekwaaha eded ese ammọ;<verse eid="PSA 37:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13" />ado <char style="nd">Abọọñ</char> asak mbon ibak,</para>
  <para style="q2" vid="PSA 37:13">sia adiọọñọ ke usen ammọ asʌk adi.<verse eid="PSA 37:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14" />Mbon ibak esio akañkañ</para>
  <para style="q2" vid="PSA 37:14">enyʌñ ekọọk utịgha</para>
  <para style="q1" vid="PSA 37:14">nọ ato do etʌkkọ mme uweene ye mbon unana,</para>
  <para style="q2" vid="PSA 37:14">yak ewot mbon se usʌñ ammọ enen.<verse eid="PSA 37:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15" />Ado akañkañ ammọ eyaekịm esịd ammọ,</para>
  <para style="q2" vid="PSA 37:15">mme utịgha ammọ ñko eyaebʌñọ.<verse eid="PSA 37:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16" />Etək ñkpọ a-andinen awo enieghe</para>
  <para style="q2" vid="PSA 37:16">a-afọn akan inie uwak mbon ibak;<verse eid="PSA 37:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17" />sia ubọk mbon ibak ayaabʌññọ,</para>
  <para style="q2" vid="PSA 37:17">ado <char style="nd">Abọọñ</char> amʌm ndinen awo akama.<verse eid="PSA 37:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18" />Mbon unana ndudue eba ke ukpeme <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 37:18">ndin udeeme ammọ adiiba ke nsi-nsi.<verse eid="PSA 37:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19" />Ammọ idiiyeemeke ke ini idiọọk ñkpọntịppe;</para>
  <para style="q2" vid="PSA 37:19">ke ini akañ ammọ eyaedia eyʌkkọ.<verse eid="PSA 37:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20" />Ado mbon ibak eyaetak:</para>
  <para style="q2" vid="PSA 37:20">Akpesʌkado mme asua <char style="nd">Abọọñ</char> ebaaha nte ñkpokpoñ ke ikọd,</para>
  <para style="q2" vid="PSA 37:20">ikañ ayaasobo ammọ, eyaesak ke nsʌñikañ.<verse eid="PSA 37:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21" />Mbon ibak ewuọt ndin ikpeeghe,</para>
  <para style="q2" vid="PSA 37:21">ado ndinen awo enọ ke ntadubọk;<verse eid="PSA 37:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22" />mbon se <char style="nd">Abọọñ</char> adiọñ eyaedat isọñ enie,</para>
  <para style="q2" vid="PSA 37:22">ado eyaesobo mbon a-anye asuuñọke.<verse eid="PSA 37:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23" />
    <char style="nd">Abọọñ</char> anam ñkpad awo</para>
  <para style="q2" vid="PSA 37:23">a-amaaha anye asọọñọ ada;<verse eid="PSA 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24" />akpesʌkado anye afiọnnọke, anye idiiduọhọ,</para>
  <para style="q2" vid="PSA 37:24">sia <char style="nd">Abọọñ</char> amʌm anye ke ubọk amọ.<verse eid="PSA 37:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25" />Ami ñkedo etəkayịn ndin idahami mmesọñ,</para>
  <para style="q2" vid="PSA 37:25">ado akenam ñkịtte naña efeghe ekpọñ ndinen awo</para>
  <para style="q2" vid="PSA 37:25">me naña nditọ ammọ ebeeñe ndidia.<verse eid="PSA 37:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26" />Ammọ edo ubọk enọ-enọ afịd ini enyʌñ ewuọt awo ñkpọ ke ntadubọk;</para>
  <para style="q2" vid="PSA 37:26">nditọ ammọ ediido adidiọñ.<verse eid="PSA 37:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27" />Wọññọ kpọñ idiọọk nyʌñ nam se ifọn;</para>
  <para style="q2" vid="PSA 37:27">ndin afo ayaadʌñ ke iso isọñ ke nsi-nsi.<verse eid="PSA 37:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28" />Sia <char style="nd">Abọọñ</char> ama mbon se inam unen</para>
  <para style="q2" vid="PSA 37:28">idiinyʌññọ ikpọñ mme anam akpanikọ.</para>
  <para style="b" vid="PSA 37:28" />
  <para style="q1" vid="PSA 37:28">Eyaesobo mme anamidiọọk afịd-afịd;</para>
  <para style="q2" vid="PSA 37:28">eyaesobo nditọ mbon ibak.<verse eid="PSA 37:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29" />Ndinen awo eyaedat isọñ enie</para>
  <para style="q2" vid="PSA 37:29">enyʌñ edʌñ do ke nsi-nsi.<verse eid="PSA 37:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30" />Inua ndinen awo etañ ikọ aniọñ,</para>
  <para style="q2" vid="PSA 37:30">edeme ammọ enyʌñ etañ se inen.<verse eid="PSA 37:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31" />Mbed Abasi ammọ asịne ammọ ke esịd;</para>
  <para style="q2" vid="PSA 37:31">ñkpad ammọ ifiọnnọke.<verse eid="PSA 37:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32" />Mbon ibak etie eyep mme ndinen awo,</para>
  <para style="q2" vid="PSA 37:32">eyem adiwot ammọ;<verse eid="PSA 37:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33" />ado <char style="nd">Abọọñ</char> idiiyaaha ammọ isịn ke ubọk mbon ibak</para>
  <para style="q2" vid="PSA 37:33">idiinyʌññọ iyak ebiom ammọ ikpe ke ini ebenne ammọ eka ikpe.<verse eid="PSA 37:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34" />Dot anyen ke <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 37:34">nyʌñ saña ke usʌñ amọ.</para>
  <para style="q1" vid="PSA 37:34">Anye ayaubenne fiin anịm ke anyọñ nọ adat isọñ anie;</para>
  <para style="q2" vid="PSA 37:34">emaesobo mbon ibak, afo ayaakịt.<verse eid="PSA 37:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35" />Ami mmekịt awo ibak ye awo anana mbọm</para>
  <para style="q2" vid="PSA 37:35">nte atiai ñkọk nte ukịm,<verse eid="PSA 37:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36" />ado ikikpeeneke anye amaaboiyo afep inyʌññọ iba aba;</para>
  <para style="q2" vid="PSA 37:36">akpesʌkado ami ñkeyemme anye, ñkekịtte anye.<verse eid="PSA 37:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37" />Kere baña awo a-afọnnọ ama, se adinen awo;</para>
  <para style="q2" vid="PSA 37:37">ini iso mbon ake eyemme emem ayaafọn.<verse eid="PSA 37:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38" />Ado eyaesobo afịd mme anamidiọọk;</para>
  <para style="q2" vid="PSA 37:38">ini iso idiibaaha inọ mbon ibak.<verse eid="PSA 37:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39" />Adinyaaña mme ndinen awo ato <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 37:39">anye ado akpọsọñ itie udịbe ammọ ke ini nnananyen.<verse eid="PSA 37:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40" />
    <char style="nd">Abọọñ</char> anwam ammọ anyʌñ afak ammọ;</para>
  <para style="q2" vid="PSA 37:40">anye afak ammọ asio ke ubọk mbon ibak anyʌñ anyaaña ammọ,</para>
  <para style="q2" vid="PSA 37:40">sia ammọ edịbeke ke anye.<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="cl">Saam 38<note caller="+" style="f"><char style="fr" closed="false">38:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 38:1-22 ewet Saam 38:2-23</char></note></para>
  <para style="d">Saam Defid. Ebeeñe.</para>
  <para style="s1">Akam E-ebọññọ Ke Ini Afanekọñ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1" />
    <char style="nd">Abọọñ</char>, kunduat miin ke iyadesịd mfo</para>
  <para style="q2" vid="PSA 38:1">kuunyʌñ untʌnọ miin ke ifiobesịd mfo.<verse eid="PSA 38:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2" />Mme idañ mfo eñkịm miin,</para>
  <para style="q2" vid="PSA 38:2">ndin ubọk mfo anyʌñ amfiik miin.<verse eid="PSA 38:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3" />Ke ntak iyadesịd mfo, nsọñidem imbaaha miin ke idem;</para>
  <para style="q2" vid="PSA 38:3">akpọ mmi inieghe nsọọñọ anọ idiọọkñkpọ mmi.<verse eid="PSA 38:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4" />Ndudue mmi amfiik miin</para>
  <para style="q2" vid="PSA 38:4">nte ndodoppo mbiomo ake awo imiikanna ibiom.<verse eid="PSA 38:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5" />Mme unan mmi etebe enyʌñ ebu</para>
  <para style="q2" vid="PSA 38:5">anọ ndisịme idiọọkñkpọ mmi.<verse eid="PSA 38:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6" />Ami mmenʌhọ tutu ñkọbọ ñnyʌñ mba ke ataa usuuk-usuuk itie;</para>
  <para style="q2" vid="PSA 38:6">nsaña ntua ayịd afịd usen.<verse eid="PSA 38:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7" />Akpọsọñ ubiak ambuuñ edem;</para>
  <para style="q2" vid="PSA 38:7">ñkoppo nsọñidem.<verse eid="PSA 38:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8" />Idem ammem miin, ñko mmenyʌñ mbʌñọ afịd-afịd;</para>
  <para style="q2" vid="PSA 38:8">ami mmetua ñnyʌñ mmịm-mmịm ke esịd.<verse eid="PSA 38:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9" />
    <char style="nd">Abọọñ</char>, afịd udọñ mmi una fiin inwañ-inwañ ke iso,</para>
  <para style="q2" vid="PSA 38:9">nsiama mmi inyʌññọ udịbe fiin.<verse eid="PSA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10" />Esịd anduọ, inweek ambọkkọ;</para>
  <para style="q2" vid="PSA 38:10">ukpọk unwana imbaaha aba ke anyen.<verse eid="PSA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11" />Mme ufan ye mme nsaña mmi emfeefeeñe miin ke ntak mme unan mmi;</para>
  <para style="q2" vid="PSA 38:11">mme mbọhọidʌñ mmi etie ke ataa anyan usʌñ.<verse eid="PSA 38:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12" />Mbon e-eyemme ediñwot miin ekọọk afia ammọ,</para>
  <para style="q2" vid="PSA 38:12">mbon e-eyemme edinnam miin idiọọk etañ ebaña nsobo mmi;</para>
  <para style="q2" vid="PSA 38:12">ammọ etie edinam ndudiọ ñnyʌñ nsʌhọ nsu afịd usen.<verse eid="PSA 38:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13" />Ami mba nte inan, ake imiikoppo ñkpọ,</para>
  <para style="q2" vid="PSA 38:13">nte imuum, ake imiitañña ikọ;<verse eid="PSA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14" />Ñkappa mba nte awo ake imiikoppo ñkpọ,</para>
  <para style="q2" vid="PSA 38:14">nte awo ake inua imiikanna ibọọrọ ikọ.<verse eid="PSA 38:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15" />
    <char style="nd">Abọọñ</char>, ami ubet fiin;</para>
  <para style="q2" vid="PSA 38:15">afo ayañyie miin, <char style="nd">Abọọñ</char> Abasi mmi.<verse eid="PSA 38:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16" />Sia ami mmaabo, “Kuuyak ammọ edat esịd embaña</para>
  <para style="q2" vid="PSA 38:16">me eduaak inua embaña ke ini ukod mmi afiọnnọke.”<verse eid="PSA 38:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17" />Sia aba nte ñyaaduọ,</para>
  <para style="q2" vid="PSA 38:17">ubiak mmi anyʌñ aba ye ami afịd ini.<verse eid="PSA 38:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18" />Ami mmeyaara nnamndue mmi;</para>
  <para style="q2" vid="PSA 38:18">idiọọkñkpọ mmi amfịna miin.<verse eid="PSA 38:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19" />Uwak awo edikappa edo mme asua mmi ke unana ntak;</para>
  <para style="q2" vid="PSA 38:19">mbon se insua ke unana ntak ewak.<verse eid="PSA 38:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20" />Mbon se idat idiọọk insio usiene eti</para>
  <para style="q2" vid="PSA 38:20">etaañ mme ikọ usua endian,</para>
  <para style="q2" vid="PSA 38:20">akpesʌkado ami ñyemme adinam se ifọn kpọd.<verse eid="PSA 38:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21" />
    <char style="nd">Abọọñ</char>, kuñkpọñ miin;</para>
  <para style="q2" vid="PSA 38:21">kuunyọọñ usʌñ uñkpọñ, Abasi mmi.<verse eid="PSA 38:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22" />Sọp di, di ñnyaaña miin,</para>
  <para style="q2" vid="PSA 38:22">
    <char style="nd">Abọọñ</char> mmi ye Andinyaaña mmi.<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="cl">Saam 39<note caller="+" style="f"><char style="fr" closed="false">39:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 39:1-13 ewet Saam 39:2-14</char></note></para>
  <para style="d">Ake etubom ikwọ. Ake Yedutun. Saam Defid.</para>
  <para style="s1">Akam Ñkpeubọk</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1" />Ami mmaabo, “Ñyaakpeme usʌñ mmi</para>
  <para style="q2" vid="PSA 39:1">ñnyʌñ ñkpan edeme mmi mbaña idiọọk;</para>
  <para style="q1" vid="PSA 39:1">ñyaaben ñkreñ mfʌk inua mmi</para>
  <para style="q2" vid="PSA 39:1">ke ini mbaaha ke iso mbon ibak.”<verse eid="PSA 39:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2" />Anam ami mmaadop uyio nte imuum,</para>
  <para style="q2" vid="PSA 39:2">ntañña ukpọk se ifọn.</para>
  <para style="q1" vid="PSA 39:2">Ado ubiak mmi anenekke akpon;<verse eid="PSA 39:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 39:3" />esịd amaamfiop miin ke idem.</para>
  <para style="q1" vid="PSA 39:3">Ke ini ami ñketieghe ñkere, ikañ amaabịppe asak;</para>
  <para style="q2" vid="PSA 39:3">ndin ami mmaadat edeme mmi ntañ ikọ:<verse eid="PSA 39:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4" />“<char style="nd">Abọọñ</char>, ñwọt miin utịd uwem mmi</para>
  <para style="q2" vid="PSA 39:4">ye ibad usen uwem mmi;</para>
  <para style="q2" vid="PSA 39:4">nam nọ ndiọọñọ naña uwem mmi imiidooho ñkpọ ndomokeed.<verse eid="PSA 39:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5" />Afo amenam usen uwem mmi aba nte ibifịk ekaubọk;</para>
  <para style="q2" vid="PSA 39:5">ayio uwem mmi idooho ñkpọ ndomokeed ke iso mfo.</para>
  <para style="q1" vid="PSA 39:5">Afịd awo edo kpasʌk ibifịk,</para>
  <para style="q2" vid="PSA 39:5">kpa ye idem mbon ekereke ke mmimọ imida afọn.<verse eid="PSA 39:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6" />“Ke akpanikọ afịd awo esaña nte ndukpọñ;</para>
  <para style="q2" vid="PSA 39:6">ke ikpu-ikpu ke ammọ efeeñe ekanna, ekoono inie ebono</para>
  <para style="q2" vid="PSA 39:6">idiọọñọke awo ake adiinie ke utịd.<verse eid="PSA 39:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7" />“Ado idahami, <char style="nd">Abọọñ</char>, nsoo ke ñyem?</para>
  <para style="q2" vid="PSA 39:7">Idodanyen mmi ado ke afo.<verse eid="PSA 39:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8" />Ñnyaaña miin sio ke afịd ndudue mmi;</para>
  <para style="q2" vid="PSA 39:8">kuunam ami ndo ñkpọ nsaha nnọ mbon ndisịme.<verse eid="PSA 39:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9" />Ñketie imuum; ñkʌppọke inua,</para>
  <para style="q2" vid="PSA 39:9">sia ado afo akenam ami.<verse eid="PSA 39:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10" />Sio ufen mfo ke idem mmi fep;</para>
  <para style="q2" vid="PSA 39:10">eta ubọk mfo ammia miin abet.<verse eid="PSA 39:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11" />Umauduat unyʌñ utʌnọ awo ke idiọọkñkpọ amọ,</para>
  <para style="q2" vid="PSA 39:11">afo ata inie ammọ nte utañkpọ,</para>
  <para style="q2" vid="PSA 39:11">ke akpanikọ afịd awo edo ñkaña ibifịk.<verse eid="PSA 39:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12" />“Kop akam mmi, <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 39:12">kpañ utọñ kop aseeme mmi;</para>
  <para style="q2" vid="PSA 39:12">kuusiit utọñ unọ ntuaña mmi.</para>
  <para style="q1" vid="PSA 39:12">Ndʌñ ye afo nte awo asenidịd,</para>
  <para style="q2" vid="PSA 39:12">asenawo, naña afịd mme eteete mmi ekedo.<verse eid="PSA 39:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13" />Fep anyen ke idem mmi, nọ ami ñkan mmaana ñkop inem uwem</para>
  <para style="q2" vid="PSA 39:13">mbemiso ami ndakka ñnyʌññọ mba aba.”<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="cl">Saam 40<note caller="+" style="f"><char style="fr" closed="false">40:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 40:1-17 ewet Saam 40:2-18</char></note></para>
  <para style="d">Ake etubom ikwọ. Ake Defid. Saam.</para>
  <para style="s1">Akam E-ebọñọ Eyem Unwam</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1" />Ami mmaame ntie mbet <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 40:1">anye amaawọññọ anse miin anyʌñ akop aseeme mmi.<verse eid="PSA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2" />Anye amandịppe miin asio ke ube adọrọke,</para>
  <para style="q2" vid="PSA 40:2">asio ke mbad ye akpʌk;</para>
  <para style="q1" vid="PSA 40:2">anye amaaben ukod mmi adot ke akwa itiad</para>
  <para style="q2" vid="PSA 40:2">anyʌñ anam ñkpad isañ mmi asọọñọ ada.<verse eid="PSA 40:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3" />Anye amansịn miin ufa ikwọ ke inua,</para>
  <para style="q2" vid="PSA 40:3">ikwọ itooro anọ Abasi ñnyịn.</para>
  <para style="q1" vid="PSA 40:3">Uwak awo eyaekịt enyʌñ ebaak <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 40:3">enyʌñ ebuọt idem ke anye.<verse eid="PSA 40:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4" />Afọfọn anọ awo</para>
  <para style="q2" vid="PSA 40:4">a-abuọttọ idem ke <char style="nd">Abọọñ</char></para>
  <para style="q1" vid="PSA 40:4">i-imiiseeghe mbon ntañidem,</para>
  <para style="q2" vid="PSA 40:4">iseeghe mbon e-ekeeneke mme nsu-nsu abasi.<verse eid="PSA 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5" />
    <char style="nd">Abọọñ</char> Abasi mmi,</para>
  <para style="q2" vid="PSA 40:5">mme utịppeñkpọ se afo anam ewak,</para>
  <para style="q2" vid="PSA 40:5">ye mme ñkpọ se afo aduak adinam inọọ ñnyịn.</para>
  <para style="q1" vid="PSA 40:5">Awo ndomokeed ikemeke adidomo idem ye afo;</para>
  <para style="q2" vid="PSA 40:5">akpedo ñkebo ntañ ñnyʌñ mbʌk se afo anam,</para>
  <para style="q2" vid="PSA 40:5">ekpa ewak ebọhọ ñkpekanna ntañ mma.<verse eid="PSA 40:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6" />Afo ukuyemme uwa ye enọ,</para>
  <para style="q2" vid="PSA 40:6">ado afo ametat utọñ mmi,</para>
  <para style="q2" vid="PSA 40:6">ufọfọb uwa ye uwa idiọọkñkpọ afo ukuyemme.<verse eid="PSA 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7" />Ndin ami mmaabo, “Se ami mi, ami mmedi,</para>
  <para style="q2" vid="PSA 40:7">ewet embaña miin ke ikpañwed.<verse eid="PSA 40:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8" />Abasi mmi, ami mmenie udọñ adinam uduak mfo;</para>
  <para style="q2" vid="PSA 40:8">mbed mfo mmọdo asịne ke esịd mmi.”<verse eid="PSA 40:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9" />Ami mmetañ mme utom adinyaaña mfo ke ekamba atu awo;</para>
  <para style="q2" vid="PSA 40:9">ñkʌppọ ñkpọkinua mmi, <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 40:9">nte afo adiọọñọke.<verse eid="PSA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10" />Ami ndịppe adinenido mfo ke esịd mmi;</para>
  <para style="q2" vid="PSA 40:10">Nsʌk ntatañ mbaña akpanikọ mfo ye unwam adinyaaña mfo.</para>
  <para style="q1" vid="PSA 40:10">Ndịppe ima mfo ye akpanikọ mfo</para>
  <para style="q2" vid="PSA 40:10">ke akwa atu awo.<verse eid="PSA 40:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11" />Kuuben mbọm mfo uñkpọñ miin, <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 40:11">yak ima ye akpanikọ mfo añkpeme miin afịd ini.<verse eid="PSA 40:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12" />Sia mme mfịna ake imiinieghe ibad eñkanna miin ekʌk;</para>
  <para style="q2" vid="PSA 40:12">mme idiọọkñkpọ mmi ewak tutu, eñkịm anyen, tutu mmọọnọke ñkpọ aba.</para>
  <para style="q1" vid="PSA 40:12">Ewak ekan ided iwuod mmi,</para>
  <para style="q2" vid="PSA 40:12">ndin esịd anduọ.<verse eid="PSA 40:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13" />Yak unem fiin esịd adiñnyaaña miin, <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 40:13">sọp di, <char style="nd">Abọọñ</char>, di ñnyaaña miin.<verse eid="PSA 40:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14" />Yak afịd mbon se iyem adidat uwem mmi</para>
  <para style="q2" vid="PSA 40:14">ekịt abuud ye ndutịme;</para>
  <para style="q1" vid="PSA 40:14">yak afịd mbon se iyem nsobo mmi</para>
  <para style="q2" vid="PSA 40:14">etịmme edem enyọñọ ke asuenne.<verse eid="PSA 40:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15" />Yak mbon embooho miin, “Aha! Aha!”</para>
  <para style="q2" vid="PSA 40:15">edịkke ebaña asuenne ammọ.<verse eid="PSA 40:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16" />Ado yak afịd mbon se uyem fiin</para>
  <para style="q2" vid="PSA 40:16">edaara enyʌñ enem esịd ke afo;</para>
  <para style="q1" vid="PSA 40:16">yak afịd mbon se inie udọñ inọ unwam adinyaaña mfo ebo afịd ini,</para>
  <para style="q2" vid="PSA 40:16">“<char style="nd">Abọọñ</char> akpon!”<verse eid="PSA 40:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17" />Ado amaado ami, ndo uweene ye awo unana;</para>
  <para style="q2" vid="PSA 40:17">yak <char style="nd">Abọọñ</char> akere ambaña miin.</para>
  <para style="q1" vid="PSA 40:17">Afo ado unwam mmi ye adinyaaña mmi;</para>
  <para style="q2" vid="PSA 40:17">afo ado Abasi mmi, kuukpeene.<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="cl">Saam 41<note caller="+" style="f"><char style="fr" closed="false">41:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 41:1-13 ewet Saam 41:2-14</char></note></para>
  <para style="d">Ake etubom ikwọ. Saam Defid.</para>
  <para style="s1">Akam E-ebọññọ Ke Ini Udọñọ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1" />Afọfọn anọ mbon e-ekereke ñkpọ ebaña mbon unana;</para>
  <para style="q2" vid="PSA 41:1">
    <char style="nd">Abọọñ</char> anam ammọ ebọkkọ ke ini nnananyen.<verse eid="PSA 41:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2" />
    <char style="nd">Abọọñ</char> akpeme anyʌñ anịm ammọ uwem,</para>
  <para style="q2" vid="PSA 41:2">ebat ammọ esịn ke atu mbon se ikịt unen ke isọñ;</para>
  <para style="q2" vid="PSA 41:2">anye iyakka ammọ inọ udọñ esịd mme asua ammọ.<verse eid="PSA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3" />
    <char style="nd">Abọọñ</char> amʌm ammọ akama ke nnaa udọñọ</para>
  <para style="q2" vid="PSA 41:3">anyʌñ akọk ammọ udọñọ.<verse eid="PSA 41:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4" />Ami mmaabo, “Ntua miin mbọm, <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 41:4">ñkọk udọñọ, sia ami mmenam idiọọkñkpọ ke iso mfo.”<verse eid="PSA 41:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5" />Mme asua mmi etañ embaña ke idiọọkesịd ete,</para>
  <para style="q2" vid="PSA 41:5">“Ini akee ke anye adiikpa nọ anyịñ amọ asop?”<verse eid="PSA 41:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6" />Keed ke atu ammọ amaadi adinse,</para>
  <para style="q2" vid="PSA 41:6">anye asʌhọ nsu, ke ini esịd amọ akereke ibak</para>
  <para style="q2" vid="PSA 41:6">ndin amaawuọ anye aketañ asaña ke esiin.<verse eid="PSA 41:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7" />Afịd mme asua mmi edọñọ adu embaña miin;</para>
  <para style="q2" vid="PSA 41:7">ammọ ekere idiọọk embaña miin, ete,<verse eid="PSA 41:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8" />“Ataa idiọọk udọñọ amʌm anye;</para>
  <para style="q2" vid="PSA 41:8">anye idiidakkake ida aba ke itie a-anye anaaha do.”<verse eid="PSA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9" />Idem akpan ufan mmi,</para>
  <para style="q2" vid="PSA 41:9">awo a-ami ñkenieghe mbuọdidem ke idem amọ,</para>
  <para style="q1" vid="PSA 41:9">a-akewanake ubọk ndidia ye ami,</para>
  <para style="q2" vid="PSA 41:9">akanna ada añnwana miin.<verse eid="PSA 41:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10" />Ado nie mbọm mbaña miin, <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 41:10">mbenne miin, nọ ato do nsio ammọ usiene<verse eid="PSA 41:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11" />Mmediọọñọ ke amenem esịd ye ami,</para>
  <para style="q2" vid="PSA 41:11">sia asua mmi iñkanna miin.<verse eid="PSA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12" />Ke ntak mfọnmma mmi afo ammʌm miin akama</para>
  <para style="q2" vid="PSA 41:12">anyʌñ amben miin anịm ke iso mfo ke nsi-nsi.<verse eid="PSA 41:12" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13" />Itooro anie <char style="nd">Abọọñ</char>, Abasi Isrel,</para>
  <para style="q2" vid="PSA 41:13">ke nsi-nsi tutu ke nsi-nsi.</para>
  <para style="qc" vid="PSA 41:13">Amen ye Amen.<verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="ms">Ayọhọ Ñwed II</para>
  <para style="mr">
    <ref loc="PSA 42-72">Mme Saam 42–72</ref></para>
  <para style="cl">Saam 42<note caller="+" style="f"><char style="fr" closed="false">42:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 42:1-11 ewet Saam 42:2-12.</char></note></para>
  <para style="d">Ake etubom mbon ikwọ. <char style="tl">Maskil</char> ake nditọ Kora.</para>
  <para style="s1">Adinie Udọñ Abasi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1" />Kpa naña ebed anweek ayem idịm mmọọñ,</para>
  <para style="q2" vid="PSA 42:1">ntoro ke ukpọñ mmi anweek uyem fiin, Abasi mmi.<verse eid="PSA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2" />Ukpọñ mmi akop nsaditọñ ayem Abasi, ayem aduuwem Abasi.</para>
  <para style="q2" vid="PSA 42:2">Ini akee ke ami ñkeme adika ñkesoobo ye Abasi?<verse eid="PSA 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3" />Mmọọñayịd mmi ado ndidia mmi</para>
  <para style="q2" vid="PSA 42:3">uweemeayio ye akonayio,</para>
  <para style="q1" vid="PSA 42:3">ke ini mme awo ekaaha iso embo miin,</para>
  <para style="q2" vid="PSA 42:3">“Mmọ Abasi mfo?”<verse eid="PSA 42:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4" />Ami mmetoiyo mme ñkpọ ami</para>
  <para style="q2" vid="PSA 42:4">nte ñnwaññake ukpọñ mmi:</para>
  <para style="q1" vid="PSA 42:4">naña ñkesika ufọk Abasi</para>
  <para style="q2" vid="PSA 42:4">ke idak ukpeme Ataa Akpọsọñ</para>
  <para style="q1" vid="PSA 42:4">ye ñkpo idaara ye itooro</para>
  <para style="q2" vid="PSA 42:4">ke atu akwa udịm mme anam usọrọ.<verse eid="PSA 42:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5" />Ukpọñ mmi, nsoo inam nọ afo afʌhọ?</para>
  <para style="q2" vid="PSA 42:5">Nsoo inam afo antịmede ke esịd idem?</para>
  <para style="q1" vid="PSA 42:5">Dot anyen ke Abasi,</para>
  <para style="q2" vid="PSA 42:5">ke ñyaasʌk ntooro anye,</para>
  <para style="q2" vid="PSA 42:5">Andinyaaña mmi ye Abasi mmi.<verse eid="PSA 42:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6" />Ukpọñ mmi afʌhọ ke esịd idem mmi;</para>
  <para style="q2" vid="PSA 42:6">ke ntoro ami ñyaatoiyo Abasi</para>
  <para style="q1" vid="PSA 42:6">tọọñọ ke isọñ Yọdan,</para>
  <para style="q2" vid="PSA 42:6">mme abod Hemọn, ato ke Abod Misaa.<verse eid="PSA 42:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7" />Udem akoot udem</para>
  <para style="q2" vid="PSA 42:7">ke uyom mme uduọmmọọñ mfo;</para>
  <para style="q1" vid="PSA 42:7">afịd mbufịd mmọọñ ye ubiọọñọ mmọọñ</para>
  <para style="q2" vid="PSA 42:7">emfʌk miin.<verse eid="PSA 42:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8" />Ke uweemeayio <char style="nd">Abọọñ</char> awuuk ima amọ,</para>
  <para style="q2" vid="PSA 42:8">ke akonayio ikwọ amọ aba ye ami,</para>
  <para style="q2" vid="PSA 42:8">mbọñ akam nnọ Abasi uwem mmi.<verse eid="PSA 42:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9" />Ami mbo Abasi a-adooho Itiad mmi,</para>
  <para style="q2" vid="PSA 42:9">“Nsoo inam afo amfre miin?</para>
  <para style="q1" vid="PSA 42:9">Ntaha a-anaaha ami nsaña mfʌhọ,</para>
  <para style="q2" vid="PSA 42:9">asua amfiik-e?”<verse eid="PSA 42:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10" />Mme akpọ mmi ebọ akpọsọñ ubiak</para>
  <para style="q2" vid="PSA 42:10">nte mme asua mmi enduọiyọ miin,</para>
  <para style="q1" vid="PSA 42:10">esʌk ekaiso embo miin afịd ini,</para>
  <para style="q2" vid="PSA 42:10">“Anye Abasi mfo-o?”<verse eid="PSA 42:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11" />Ukpọñ mmi, nsoo inam nọ afo afʌhọ?</para>
  <para style="q2" vid="PSA 42:11">Nsoo inam afo antịmede ke esịd idem?</para>
  <para style="q1" vid="PSA 42:11">Dot anyen ke Abasi,</para>
  <para style="q2" vid="PSA 42:11">ke ñyaasʌk ntooro anye,</para>
  <para style="q2" vid="PSA 42:11">Andinyaaña mmi ye Abasi mmi.<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="cl">Saam 43<note caller="+" style="f"><char style="fr" closed="false">43:0 </char><char style="ft" closed="false">Ke ataa uwak ikpañwed Hibru Saam 42 ye Saam 43 eyʌt edọñ nte Saam keed.</char></note></para>
  <para style="s1">Akam Ake Ebọññọ Ke Ini Afanekọñ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1" />Abasi mmi, ntoppo miin ikpe,</para>
  <para style="q2" vid="PSA 43:1">nyʌñ kpe ikpe iwuod mmi</para>
  <para style="q2" vid="PSA 43:1">baña idịd ammiinamma akpanikọ.</para>
  <para style="q1" vid="PSA 43:1">Mfak miin sio ke ubọk</para>
  <para style="q2" vid="PSA 43:1">mbon abiaña ye mbon ibak.<verse eid="PSA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2" />Afo ado Abasi itie ubọkkọ mmi.</para>
  <para style="q2" vid="PSA 43:2">Nsoo inam afo ansịn miin?</para>
  <para style="q1" vid="PSA 43:2">Ntaha a-anaaha ami nsaña mfʌhọ,</para>
  <para style="q2" vid="PSA 43:2">mbaña ufiik asua?<verse eid="PSA 43:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3" />Dọñ unwana mfo ye akpanikọ mfo nnọ miin,</para>
  <para style="q2" vid="PSA 43:3">yak ammọ endat miin usʌñ;</para>
  <para style="q1" vid="PSA 43:3">yak ammọ emben miin edi adisana abod mfo,</para>
  <para style="q2" vid="PSA 43:3">itie a-afo adʌññọ.<verse eid="PSA 43:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4" />Ndin ami ñyaaka ke iso akpokoro uwa Abasi,</para>
  <para style="q2" vid="PSA 43:4">kpa Abasi, idadesịd mmi ye inemesịd mmi.</para>
  <para style="q1" vid="PSA 43:4">Ami ñyautooro fiin ye ndidoudʌk,</para>
  <para style="q2" vid="PSA 43:4">O Abasi, Abasi mmi.<verse eid="PSA 43:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5" />Ukpọñ mmi, nsoo inam nọ afo afʌhọ?</para>
  <para style="q2" vid="PSA 43:5">Nsoo inam afo antịmede ke esịd idem?</para>
  <para style="q1" vid="PSA 43:5">Dot anyen ke Abasi,</para>
  <para style="q2" vid="PSA 43:5">ke ñyaasʌk ntooro anye,</para>
  <para style="q2" vid="PSA 43:5">Andinyaaña mmi ye Abasi mmi.<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="cl">Saam 44<note caller="+" style="f"><char style="fr" closed="false">44:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 44:1-26 ewet Saam 44:2-27</char></note></para>
  <para style="d">Ake etubom mbon ikwọ. Ake nditọ Kora. <char style="tl">Maskil.</char></para>
  <para style="s1">Akam Ake Ebọññọ Eyem Unwam</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1" />O Abasi, ñnyịn imikop ke utọñ ñnyịn;</para>
  <para style="q2" vid="PSA 44:1">mme eteete ñnyịn emaidọkkọ ñnyịn</para>
  <para style="q1" vid="PSA 44:1">se afo akenam ke ayio ammọ,</para>
  <para style="q2" vid="PSA 44:1">ke mme ayio ako.<verse eid="PSA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2" />Afo akedat ubọk mfo abịne mme idịd asio</para>
  <para style="q2" vid="PSA 44:2">anyʌñ abono mme eteete ñnyịn do;</para>
  <para style="q1" vid="PSA 44:2">afo amaasọnnọ mbon awo</para>
  <para style="q2" vid="PSA 44:2">anyʌñ anam mme eteete ñnyịn etọt.<verse eid="PSA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3" />Ikidooho akañkañ ammọ ke ekedat ebọ isọñ enie,</para>
  <para style="q2" vid="PSA 44:3">ikinyʌññọ ido ñkpọ ekọñ ammọ akenyaaña ammọ;</para>
  <para style="q1" vid="PSA 44:3">akedo ubọk nnasia mfo, adọọn ubọk mfo,</para>
  <para style="q2" vid="PSA 44:3">ye unwana iso mfo, sia afo amaama ammọ.<verse eid="PSA 44:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4" />Afo ado Adidem mmi ye Abasi mmi;</para>
  <para style="q2" vid="PSA 44:4">ake awuukọ mme adikan anọ Yekọb.<verse eid="PSA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5" />Ato ke unwam mfo ñnyịn inək mme asua ñnyịn iduọọk;</para>
  <para style="q2" vid="PSA 44:5">ato ke anyịñ mfo ñnyịn isọnnọ mme asua ñnyịn.<verse eid="PSA 44:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6" />Ami nsịnne mbuọdidem ke utịgha mmi,</para>
  <para style="q2" vid="PSA 44:6">akañkañ mmi inyʌññọ innọ adikan;<verse eid="PSA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7" />ado afo inyaaña ñnyịn asio ke ubọk mme asua ñnyịn,</para>
  <para style="q2" vid="PSA 44:7">anam mbon utọk ñnyịn edia abuud.<verse eid="PSA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8" />Ñnyịn iduaak inua ke Abasi afịd usen,</para>
  <para style="q2" vid="PSA 44:8">ndin ñnyịn iyaitooro anyịñ mfo ke nsi-nsi.<verse eid="PSA 44:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9" />Ado idahami afo amitop ñnyịn aduọọk anyʌñ isuuhọ ñnyịn itie;</para>
  <para style="q2" vid="PSA 44:9">usañake ye mbon ekọñ ñnyịn uwuọ aba.<verse eid="PSA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10" />Afo amaanam ñnyịn ituak edem-edem inọ mme asua,</para>
  <para style="q2" vid="PSA 44:10">ndin mbon usua ñnyịn ebịme ñkpọ ñnyịn.<verse eid="PSA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11" />Afo amaiyaak ñnyịn anọ nọ esobo nte edọñ</para>
  <para style="q2" vid="PSA 44:11">anyʌñ isuan ñnyịn adọñ ke atu mme idịd.<verse eid="PSA 44:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12" />Afo amaanyam ikọd mfo ke mbeñe ekọmudua,</para>
  <para style="q2" vid="PSA 44:12">ado unieghe udod ndomokeed uto adinyam ammọ.<verse eid="PSA 44:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13" />Afo amenam ñnyịn ido ñkpọ nsaha ke atu mme mbọhọidʌñ ñnyịn,</para>
  <para style="q2" vid="PSA 44:13">ñkpọ asuenne ye ñkpọ nsaha ke atu mbon e-ekannake ñnyịn ekʌk.<verse eid="PSA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14" />Afo amenam ñnyịn ido ñkpọ ufiid ke atu mme idịd;</para>
  <para style="q2" vid="PSA 44:14">ñkpọ nsaha ke atu mbon abio.<verse eid="PSA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15" />Mba ke asuenne afịd ini,</para>
  <para style="q2" vid="PSA 44:15">abuud anyʌñ amfʌk iso<verse eid="PSA 44:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16" />anọ esaha mbon se insuenne inyʌñ insueñ miin,</para>
  <para style="q2" vid="PSA 44:16">ke ntak asua, a-abeeñeke idem adisio usiene.<verse eid="PSA 44:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17" />Afịd ñkpọ ami amaadisịm ñnyịn,</para>
  <para style="q2" vid="PSA 44:17">akpesʌkado ñnyịn imiikufreke fiin;</para>
  <para style="q2" vid="PSA 44:17">ñnyịn ikinyʌññọ inam abiaña ibaña edioomo mfo.<verse eid="PSA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18" />Esịd ñnyịn ikitịmmeke edem;</para>
  <para style="q2" vid="PSA 44:18">ñkpad ñnyịn ikiwuọhọ ikpọñ usʌñ mfo.<verse eid="PSA 44:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19" />Ado afo amainuak ñnyịn anyʌñ anam ñnyịn ido se mme ewaikọd edubịnne;</para>
  <para style="q2" vid="PSA 44:19">afo amaaben ekamba ekịm ifʌk ñnyịn.<verse eid="PSA 44:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20" />Akpedo imaifre anyịñ Abasi ñnyịn</para>
  <para style="q2" vid="PSA 44:20">me imainyanna ubọk inọ asen abasi,<verse eid="PSA 44:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21" />nte anye Abasi ikpikiyaarake,</para>
  <para style="q2" vid="PSA 44:21">sia adooho anye adiọọñọ ndedịbe akikere esịd awo?<verse eid="PSA 44:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22" />Ado ke ntak mfo ñnyịn ikịt ñkpa afịd usen;</para>
  <para style="q2" vid="PSA 44:22">edat ñnyịn nte mme edọñ a-anaaha ewot.<verse eid="PSA 44:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23" />Benne idem, <char style="nd">Abọọñ</char>! Nsoo inam nọ adaiya?</para>
  <para style="q2" vid="PSA 44:23">Demme! Kuutop ñnyịn uduọk ke nsi-nsi.<verse eid="PSA 44:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24" />Nsoo inam afo adịp iso mfo</para>
  <para style="q2" vid="PSA 44:24">anyʌñ afre ukuud ye ufiik ñnyịn?<verse eid="PSA 44:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25" />Sia ñnyịn imisọiyọ ika ke ntọñ;</para>
  <para style="q2" vid="PSA 44:25">ikpọkidem ñnyịn adiana ke isọñ.<verse eid="PSA 44:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26" />Dakka da nyʌñ inyaaña ñnyịn;</para>
  <para style="q2" vid="PSA 44:26">ifak ñnyịn ke ntak nsọọñọnda ima mfo.<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="cl">Saam 45<note caller="+" style="f"><char style="fr" closed="false">45:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 45:1-17 ewet Saam 45:2-18.</char></note></para>
  <para style="d">Ake etubom mbon ikwọ. Ekwọ nte “Lili.” Ake nditọ Kora. <char style="tl">Maskil.</char> Ikwọ ndọ.</para>
  <para style="s1">Ke Abaña Ndọ Ufọk Ubọọñ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1" />Esịd mmi ayọhọ aduọi ye eti iwuod ikọ;</para>
  <para style="q2" vid="PSA 45:1">naña ntañ uto mmi nnọ adidem;</para>
  <para style="q2" vid="PSA 45:1">edeme mmi ado etoñwed awedñwed a-ayọhọke ye ifiọk.<verse eid="PSA 45:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2" />Afo afọn akan ke atu ideen</para>
  <para style="q2" vid="PSA 45:2">ñko eduọk mfọn ke ñkpọkinua mfo,</para>
  <para style="q2" vid="PSA 45:2">sia Abasi udiọñ ke nsi-nsi.<verse eid="PSA 45:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3" />Faak akañkañ mfo ke ñkañ, afo awo uko;</para>
  <para style="q2" vid="PSA 45:3">ben uyai ye ubọọñ sịne ke idem.<verse eid="PSA 45:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4" />Wat uko-uko ke ubọọñ mfo</para>
  <para style="q2" vid="PSA 45:4">ke ntak akpanikọ, nsuukidem ye unen;</para>
  <para style="q2" vid="PSA 45:4">yak ubọk nnasia mfo anam mme anie ndịk ñkpọ.<verse eid="PSA 45:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5" />Yak mme usọb idañ mfo akịm esịd mme asua adidem;</para>
  <para style="q2" vid="PSA 45:5">yak mme idịd eduọññọ ke idak ukod mfo.<verse eid="PSA 45:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6" />O Abasi<note caller="+" style="fe"><char style="fr" closed="false">45:6 </char><char style="ft" closed="false">Mi edat Adidem nte awo andida ke itie Abasi</char></note>, ebekpo mfo, adiida ke nsi-nsi nsi-nsi;</para>
  <para style="q2" vid="PSA 45:6">esañ unen adiido esañ ubọọñ mfo.<verse eid="PSA 45:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7" />Afo amema adinenido anyʌñ asua ukwañ ido;</para>
  <para style="q2" vid="PSA 45:7">ke ntoro Abasi, Abasi mfo, anam afo akoñ akan mme nsaña mfo</para>
  <para style="q2" vid="PSA 45:7">ke aduyet fiin adan inemesịd.<verse eid="PSA 45:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8" />Afịd afọñ mfo enie inem ufịk mee ye mme alo ye akesia;</para>
  <para style="q2" vid="PSA 45:8">ufọk ubọọñ e-ebanake ke nnʌk eniin</para>
  <para style="q2" vid="PSA 45:8">ikwọ e-ebreke ke ndido udʌk unọ fiin inemesịd.<verse eid="PSA 45:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9" />Nditọ ibaan mme ndidem esịne ke atu mme ibaan ukpono mfo;</para>
  <para style="q2" vid="PSA 45:9">anwaan ndọ abọọñ a-asịneke kold ake Ọfia ada ke ubọk nnasia mfo.<verse eid="PSA 45:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10" />Kop, ayịn awonwaan, nyʌñ nekke kpañ utọñ:</para>
  <para style="q2" vid="PSA 45:10">Fre baña mbon ndufo ye ufọk ete mfo.<verse eid="PSA 45:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11" />Yak uyai mfo adọñ adidem itọñ;</para>
  <para style="q2" vid="PSA 45:11">kpono anye, ke anye ado abọọñ mfo.<verse eid="PSA 45:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12" />Abio Tai ayaadi ye enọ,</para>
  <para style="q2" vid="PSA 45:12">mbon inie eyaeyem mfọn uto fiin.<verse eid="PSA 45:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13" />Adiaha adidem aba ubọọñ-ubọọñ ke ubeed amọ;</para>
  <para style="q2" vid="PSA 45:13">afọñidem amọ edat kold edọkkọ esịn uyai enam.<verse eid="PSA 45:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14" />Esịn anye mme udọdọk nsiine eben ebịne adidem;</para>
  <para style="q2" vid="PSA 45:14">mme ñkpʌk ubọikpa amọ ekeene anye,</para>
  <para style="q2" vid="PSA 45:14">mbon e-ekebenne edi ebo yak ediba ye anye.<verse eid="PSA 45:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15" />Eben ammọ edʌk ke idaara ye inemesịd,</para>
  <para style="q2" vid="PSA 45:15">ammọ edʌk akwa ufọk adidem.<verse eid="PSA 45:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16" />Nditọ ideen mfo eyaedat itie mme ete ndufo;</para>
  <para style="q2" vid="PSA 45:16">afo ayaaben ammọ anịm nte mbọọñ ke afịd abio.<verse eid="PSA 45:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17" />Ñyaanam etoiyo anyịñ mfo ke afịd emana;</para>
  <para style="q2" vid="PSA 45:17">ke ntoro mme idịd eyautooro fiin ke nsi-nsi nsi-nsi.<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="cl">Saam 46<note caller="+" style="f"><char style="fr" closed="false">46:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 46:1-11 ewet Saam 46:2-12.</char></note></para>
  <para style="d">Ake etubom mbon ikwọ. Ake nditọ Kora. Asaña nte <char style="tl">alamọd.</char> Ikwọ.</para>
  <para style="s1">Abasi Ado Akwa Ibededem Ñnyịn</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1" />Abasi ado itie udịbe ñnyịn ye adudu ñnyịn,</para>
  <para style="q2" vid="PSA 46:1">unwam ñnyịn ke ini akeedodo inieghe mfịna.<verse eid="PSA 46:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2" />Ke ntoro ñnyịn idiikoppo ndịk, akpekọm isọñ awuudo</para>
  <para style="q2" vid="PSA 46:2">me mme abod enyʌñ eduọññọ edọñọ inyañ,<verse eid="PSA 46:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3" />akpesʌkado mmọọñ amọ ayomoke anyʌñ afuut</para>
  <para style="q2" vid="PSA 46:3">mme abod enyʌñ enyek ke ufofuud ammọ.<verse eid="PSA 46:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4" />A-aba inyañ keed ake mme idịm amọ enamma esịd anem abio Abasi,</para>
  <para style="q2" vid="PSA 46:4">adisana itie ake Andikoñ Ñkan adʌññọ.<verse eid="PSA 46:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5" />Abasi mmọdo ke anye, anye idiiduọhọ;</para>
  <para style="q2" vid="PSA 46:5">Abasi ayaanyaaña anye ke usiere.<verse eid="PSA 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6" />Ñkpoiyo afịt ke mme idịd, mme abio eduọññọ;</para>
  <para style="q2" vid="PSA 46:6">anye abenne uyio, isọñ ayeeme.<verse eid="PSA 46:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7" />
    <char style="nd">Abọọñ</char> Andikponñkan mmọdo aba ye ñnyịn;</para>
  <para style="q2" vid="PSA 46:7">Abasi Yekọb ado itie ubọkkọ ñnyịn.<verse eid="PSA 46:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8" />Idise se <char style="nd">Abọọñ</char> anam,</para>
  <para style="q2" vid="PSA 46:8">mme ñwuudo se anye asịn ke ederimbod.<verse eid="PSA 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9" />Anye anam ekọñ atre</para>
  <para style="q2" vid="PSA 46:9">tutu akesịm utịd ederimbod.</para>
  <para style="q1" vid="PSA 46:9">Anye abuuñ utịgha anyʌñ abʌñ eduad mbai-mbai;</para>
  <para style="q2" vid="PSA 46:9">anye afọp mme atuekọñ ke ikañ.<verse eid="PSA 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10" />Anye ate, “Idobo, inyʌñ idiọọñọ ke ami ndo Abasi;</para>
  <para style="q2" vid="PSA 46:10">Ami ñyaakoñ ke atu mme idịd,</para>
  <para style="q2" vid="PSA 46:10">Ñyaakoñ ke ederimbod.”<verse eid="PSA 46:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11" />
    <char style="nd">Abọọñ</char> Andikponñkan mmọdo aba ye ñnyịn;</para>
  <para style="q2" vid="PSA 46:11">Abasi Yekọb ado itie ubọkkọ ñnyịn.<verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="cl">Saam 47<note caller="+" style="f"><char style="fr" closed="false">47:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 47:1-9 ewet Saam 47:2-10</char></note></para>
  <para style="d">Ake etubom mbon ikwọ. Ake nditọ ideen Kora. Saam.</para>
  <para style="s1">Abasi Akara Mme Idịd</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1" />Imia ubọk ndufo, afịd ndufo mme idịd;</para>
  <para style="q2" vid="PSA 47:1">isio ñkpo idaara inọ Abasi.<verse eid="PSA 47:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2" />Sia <char style="nd">Abọọñ</char> Andikoñ Ñkan anie uteeñe,</para>
  <para style="q2" vid="PSA 47:2">anye ado akwa Adidem ke afịd ederimbod.<verse eid="PSA 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3" />Anye asuuhọ mme idịd asịn ke idak ñnyịn,</para>
  <para style="q2" vid="PSA 47:3">anam mme awo eba ke idak ñkpad ñnyịn.<verse eid="PSA 47:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4" />Anye amaamek udeeme ñnyịn inọ ñnyịn,</para>
  <para style="q2" vid="PSA 47:4">uku Yekọb, a-anye akemaaha.<verse eid="PSA 47:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5" />Abasi adọọk anyọñ ke ñkpo idaara,</para>
  <para style="q2" vid="PSA 47:5">
    <char style="nd">Abọọñ</char> adọọk ke uyom mme adukpoñ.<verse eid="PSA 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6" />Ikwọ itooro inọ Abasi, ikwọ itooro;</para>
  <para style="q2" vid="PSA 47:6">ikwọ itooro inọ Adidem ñnyịn, ikwọ itooro.<verse eid="PSA 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7" />Sia Abasi ado Adidem afịd ederimbod;</para>
  <para style="q2" vid="PSA 47:7">ikwọ saam itooro inọ anye.<verse eid="PSA 47:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8" />Abasi akaara ke mme idịd;</para>
  <para style="q2" vid="PSA 47:8">Abasi atie ke adisana ebekpo amọ.<verse eid="PSA 47:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9" />Mme mbọọñ abio esoobo idem</para>
  <para style="q2" vid="PSA 47:9">nte mme ubon Abasi Ebraham,</para>
  <para style="q1" vid="PSA 47:9">sia Abasi anie mme ndidem isọñ;</para>
  <para style="q2" vid="PSA 47:9">Abasi anekke akoñ.<verse eid="PSA 47:9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="cl">Saam 48<note caller="+" style="f"><char style="fr" closed="false">48:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 48:1-14 ewet Saam 48:2-15.</char></note></para>
  <para style="d">Ikwọ. Saam nditọ ideen Kora.</para>
  <para style="s1">Abio Abasi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1" />
    <char style="nd">Abọọñ</char> akpon, anyʌñ anekke adot se etooro,</para>
  <para style="q2" vid="PSA 48:1">ke abio Abasi ñnyịn, ke adisana abod amọ.<verse eid="PSA 48:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2" />Ayaiya ke adikoñ amọ,</para>
  <para style="q2" vid="PSA 48:2">idadesịd afịd ederimbod,</para>
  <para style="q1" vid="PSA 48:2">nte abod Safọn, naña Abod Saiyọn aba adodo,</para>
  <para style="q2" vid="PSA 48:2">abio Akwa Adidem.<verse eid="PSA 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3" />Abasi mmọdo ke mme itie ukpeme atob amọ;</para>
  <para style="q2" vid="PSA 48:3">anye awọt idem amọ nte itie ubọkkọ amọ.<verse eid="PSA 48:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4" />Ke ini mme ndidem ekedianake keed,</para>
  <para style="q2" vid="PSA 48:4">ke ini ammọ ekekaaha ke udịm keed,<verse eid="PSA 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5" />ammọ emaekịt anye ndin idem amaakpa ammọ;</para>
  <para style="q2" vid="PSA 48:5">ammọ emaefeeñe ye akpọsọñ ndịk.<verse eid="PSA 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6" />Ñnyeñidem amaamʌm ammọ do,</para>
  <para style="q2" vid="PSA 48:6">ekop ubiak nte awonwaan a-abaaha ke uman.<verse eid="PSA 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7" />Afo amaasobo ammọ nte mme nsʌñikañ Taasis</para>
  <para style="q2" vid="PSA 48:7">a-akpọsọñ afịm a-atooho usakkautịn asobo mbai-mbai.<verse eid="PSA 48:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8" />Nte imaikikop,</para>
  <para style="q2" vid="PSA 48:8">kpa ntoro ke ñnyịn inyʌñ ikịt</para>
  <para style="q1" vid="PSA 48:8">ke abio <char style="nd">Abọọñ</char> Andikponñkan,</para>
  <para style="q2" vid="PSA 48:8">ke abio Abasi ñnyịn:</para>
  <para style="q1" vid="PSA 48:8">Abasi anam anye asọọñọ ada</para>
  <para style="q2" vid="PSA 48:8">ke nsi-nsi.<verse eid="PSA 48:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9" />Ke esịd tembịd mfo, O Abasi,</para>
  <para style="q2" vid="PSA 48:9">ñnyịn itie ikere ibaña ima mfo ake imiikpuuho.<verse eid="PSA 48:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10" />Kpa naña anyịñ mfo ado, O Abasi,</para>
  <para style="q2" vid="PSA 48:10">itooro mfo asịm mme utịd ederimbod;</para>
  <para style="q2" vid="PSA 48:10">ubọk nnasia mfo ayọhọ ye adinenido.<verse eid="PSA 48:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11" />Abod Saiyọn adaara,</para>
  <para style="q2" vid="PSA 48:11">mme esịdidʌñ Yuda enem esịd</para>
  <para style="q2" vid="PSA 48:11">ebaña mme ubiideikpe mfo.<verse eid="PSA 48:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12" />Isaña ikanna Saiyọn, isaña ikanna anye ikʌk,</para>
  <para style="q2" vid="PSA 48:12">ibat mme tọwa amọ,<verse eid="PSA 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13" />inekke ise mme ndibene amọ,</para>
  <para style="q2" vid="PSA 48:13">ise mme itie ukpeme atob amọ,</para>
  <para style="q1" vid="PSA 48:13">nọ ndufo ebʌk ebaña ammọ</para>
  <para style="q2" vid="PSA 48:13">enọ emana ini iso.<verse eid="PSA 48:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14" />Sia Abasi ami ado Abasi ñnyịn ke nsi-nsi nsi-nsi;</para>
  <para style="q2" vid="PSA 48:14">anye ayaado ndadusʌñ ñnyịn tutu akesịm utịd.<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="cl">Saam 49<note caller="+" style="f"><char style="fr" closed="false">49:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 49:1-20 ewet Saam 49:2-21</char></note></para>
  <para style="d">Ake etubom mbon ikwọ. Ake nditọ Kora. Saam.</para>
  <para style="s1">Kuubuọtidem Ke Inie</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1" />Ikop mme ikọ ami, afịd ndufo mme abio;</para>
  <para style="q2" vid="PSA 49:1">ikpañ utọñ, afịd ndufo se idʌñ ke ederimbod ami,<verse eid="PSA 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2" />mme usuuhọ-usuuhọ awo ye mme awo ke ikpọ itie,</para>
  <para style="q2" vid="PSA 49:2">mme anieñkpọ ye mme uweene ñko:<verse eid="PSA 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3" />Inua mmi ayaatañ ikọ aniọñ;</para>
  <para style="q2" vid="PSA 49:3">akikere esịd mmi ayaanọ ifiọk.<verse eid="PSA 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4" />Ami ñyaakpañ utọñ nnọ ñke;</para>
  <para style="q2" vid="PSA 49:4">ami ñyaadat ekpa nnam ebetọikọ mmi anwaña:<verse eid="PSA 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5" />Ntak ami ñkpedịkkeke ke mme ndiọi usen emaedi,</para>
  <para style="q2" vid="PSA 49:5">ke ini mbon ibak ye mbon abiaña eñkannake miin ekʌk,<verse eid="PSA 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6" />mbon se ibuọt idem ke imọ ammọ</para>
  <para style="q2" vid="PSA 49:6">e-enyʌññọ eduaak inua ebaña ñkpoon inie ammọ?<verse eid="PSA 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7" />Awo ndomokeed ikanna ifak uwem awo mfen</para>
  <para style="q2" vid="PSA 49:7">me adinọ Abasi usioisob ke iwuod ammọ,<verse eid="PSA 49:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8" />usioisob ke iwuod awo keed asọñ udua,</para>
  <para style="q2" vid="PSA 49:8">ekọmudua ndomokeed akenam ikemme,<verse eid="PSA 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9" />nọ ammọ ekpekaa iso edu uwem ke nsi-nsi</para>
  <para style="q2" vid="PSA 49:9">inyʌññọ ikịt mbiara.<verse eid="PSA 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10" />Sia afịd awo e-ekeme ikịt ke mbon aniọñ e-ekpa,</para>
  <para style="q2" vid="PSA 49:10">ke mme ndisịme ye mbon unana iwuod etatak ñko,</para>
  <para style="q2" vid="PSA 49:10">ekpọñ inie ammọ enọ mbon mfen.<verse eid="PSA 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11" />Udi ammọ adiido ufọk ammọ ke nsi-nsi,</para>
  <para style="q2" vid="PSA 49:11">itieidʌñ ammọ ke afịd emana,</para>
  <para style="q2" vid="PSA 49:11">akpesʌkado ammọ ekebenne anyịñ ammọ esio mme isọñ ammọ.<verse eid="PSA 49:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12" />Kpa ye inie ammọ, mme awo ikpeeneke ke iso isọñ</para>
  <para style="q2" vid="PSA 49:12">ammọ eba nte ndiọi unam ake etakka.<verse eid="PSA 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13" />Naña usʌñ mbon ake ebuọt idem ke idem ammọ aba adodo,</para>
  <para style="q2" vid="PSA 49:13">ye usʌñ mbon se ikeene ammọ ñko, e-emaaha se ammọ etañ.<verse eid="PSA 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14" />Ammọ eba nte edọñ a-adooho ana nte ekpa;</para>
  <para style="q2" vid="PSA 49:14">ñkpa adiido andibọọk ammọ</para>
  <para style="q2" vid="PSA 49:14">(ado mme ndinen awo eyaekan ammọ ke usiere).</para>
  <para style="q1" vid="PSA 49:14">Idem ammọ ayaatak ke udi,</para>
  <para style="q2" vid="PSA 49:14">ikperekekpere mfọọn itie idʌñ ammọ.<verse eid="PSA 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15" />Ado Abasi ayamfak asio ke adudu abioekpo;</para>
  <para style="q2" vid="PSA 49:15">anye ayandat miin anọ idem amọ.<verse eid="PSA 49:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16" />Kuudịkke ke mbon mfen emaekappa emọinyọ,</para>
  <para style="q2" vid="PSA 49:16">ke ini uku ufọk ammọ amaatọt;<verse eid="PSA 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17" />sia ammọ idiidatta ñkpọ ndomokeed inyọñ emaekpa,</para>
  <para style="q2" vid="PSA 49:17">uku ammọ idiisọiyọke ikeene ammọ.<verse eid="PSA 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18" />Akpesʌkado naña ammọ ebaaha ke uwem ammọ ebat idem ammọ ke mbon se ediọñ;</para>
  <para style="q2" vid="PSA 49:18">ndin mme awo utooro fiin ke umauforo;<verse eid="PSA 49:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19" />ammọ eyaekeene mbon e-emaekebem ammọ iso idakka isañ,</para>
  <para style="q2" vid="PSA 49:19">mbon i-imiidiikịtte unwana uwem aba ke nsi-nsi.<verse eid="PSA 49:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20" />Mbon se imọinyọ ado inieghe ikike</para>
  <para style="q2" vid="PSA 49:20">eba nte ndiọi unam ake esoboke.<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="cl">Saam 50</para>
  <para style="d">Saam Asaf.</para>
  <para style="s1">Se Inem Abasi Esịd</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1" />Akwa Abasi Ibom, Abasi, <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 50:1">atañ ikọ anyʌñ akoot ederimbod</para>
  <para style="q2" vid="PSA 50:1">tọọñọ ke usakkautịn tutu asịm usobutịn.<verse eid="PSA 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2" />Ke Saiyọn, ayaiya ama,</para>
  <para style="q2" vid="PSA 50:2">Abasi awuọ ayama.<verse eid="PSA 50:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3" />Abasi ñnyịn adi</para>
  <para style="q2" vid="PSA 50:3">idiinyʌññọ idop uyio;</para>
  <para style="q1" vid="PSA 50:3">ikañ asobo ke iso amọ,</para>
  <para style="q2" vid="PSA 50:3">akpọsọñ ayobio anyʌñ afịm akanna anye akʌk.<verse eid="PSA 50:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4" />Anye akoot anyọñ,</para>
  <para style="q2" vid="PSA 50:4">ye isọñ, nọ ato do anye akpe ikpe ikọd amọ:<verse eid="PSA 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5" />“Koot mbon emaekediọñ asaña-asaña bok nnọ miin,</para>
  <para style="q2" vid="PSA 50:5">ake ekedatta uwa enam edioomo ye ami.”<verse eid="PSA 50:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6" />Ndin anyọñ ebʌk adinenido amọ,</para>
  <para style="q2" vid="PSA 50:6">sia anye ado Abasi unen.<verse eid="PSA 50:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7" />Ikpañ utọñ, ikọd mmi, ndin ami ñyaatañ ikọ;</para>
  <para style="q2" vid="PSA 50:7">Ñyaasua inọ ndufo, Isrel:</para>
  <para style="q2" vid="PSA 50:7">Ami ndo Abasi, Abasi mfo.<verse eid="PSA 50:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8" />Ami ukoodo fiin ikpe mbaña mme uwa mfo</para>
  <para style="q2" vid="PSA 50:8">me ke abaña ufọfọb uwa mfo annaaha miin ke iso afịd ini.<verse eid="PSA 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9" />Ñyemme ayaaraenañ a-atooho abaenañ mfo</para>
  <para style="q2" vid="PSA 50:9">me ebod e-etooho abaebod mfo,<verse eid="PSA 50:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10" />sia afịd unam ke akai ado ami nnie,</para>
  <para style="q2" vid="PSA 50:10">ye ufene ke mme abod tọsịn (1,000).<verse eid="PSA 50:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11" />Mmediọọñọ afịd inuen ke mme abod,</para>
  <para style="q2" vid="PSA 50:11">ñko afịd ñkeñe unam se isaña ke ikọd ado ami nnie.<verse eid="PSA 50:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12" />Abiọọñ akpendọñ ñkpudọkkọke fiin,</para>
  <para style="q2" vid="PSA 50:12">sia ederimbod ye afịd se iyọhọ ke esịd edo ake mmi.<verse eid="PSA 50:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13" />Nte ami nta unam ñyaaraenañ</para>
  <para style="q2" vid="PSA 50:13">me ñnwọñ iyiib mme ebod?<verse eid="PSA 50:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14" />“Nam uwa ekọọm nọ Abasi,</para>
  <para style="q2" vid="PSA 50:14">sio mme akaaña mfo nọ Andikoñ Ñkan,<verse eid="PSA 50:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15" />nyʌñ ñkoot miin ke usen nnananyen;</para>
  <para style="q2" vid="PSA 50:15">ami ñyaunọ adikan, ndin afo ayañkpono miin.”<verse eid="PSA 50:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 50:16" />Ado Abasi abo awo ibak ate:</para>
  <para style="q1" vid="PSA 50:16">“Nsoo unen ke afo anie aditañ mme ewʌhọ mmi</para>
  <para style="q2" vid="PSA 50:16">me adiben edioomo mmi ntuuk ñkpọkinua mfo?<verse eid="PSA 50:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17" />Afo asuasua item mmi</para>
  <para style="q2" vid="PSA 50:17">anyʌñ aduọọk ikọ mmi ke edem mfo.<verse eid="PSA 50:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18" />Umaukịt inọ, afo adiana ye anye;</para>
  <para style="q2" vid="PSA 50:18">awuak idem mfo ye mme asịn efịbe.<verse eid="PSA 50:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19" />Afo akama inua mfo anam mbubịk</para>
  <para style="q2" vid="PSA 50:19">anyʌñ akama edeme mfo abot nsu.<verse eid="PSA 50:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20" />Afo atie atañ idiọọk ikọ abaña ayịneka mfo</para>
  <para style="q2" vid="PSA 50:20">anyʌñ adọk adidọk abaña ataa ayịn e-eka mfo akemanna.<verse eid="PSA 50:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21" />Naña afo akenamma mme ñkpọ ami nọ ami ndop uyio,</para>
  <para style="q2" vid="PSA 50:21">akekere ke mba ukem-ukem nte afo.</para>
  <para style="q1" vid="PSA 50:21">Ado idahami mmukoot fiin ikpe</para>
  <para style="q2" vid="PSA 50:21">ñnyʌñ mben mme ukwañido mfo unịm fiin ke iso.<verse eid="PSA 50:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22" />“Ikere ibaña ami, ndufo e-efreke Abasi,</para>
  <para style="q2" vid="PSA 50:22">imiidooho ntoro ami ñyaiwai ndufo mbai-mbai, ndin ibaaha awo se idiinyaaña ndufo:<verse eid="PSA 50:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23" />Mbon e-ewaaha uwa ekọọm eñkpono miin,</para>
  <para style="q2" vid="PSA 50:23">ndin amaado mbon enanake ndo ami Abasi ñyaawọt ammọ adinyaaña mmi.”<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="cl">Saam 51<note caller="+" style="f"><char style="fr" closed="false">51:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 51:1-19 ewet Saam 51:3-21</char></note></para>
  <para style="d">Ake etubom ikwọ. Saam Defid. Ke ini prọfed Natan akediighe abịne Defid ke anye amaakesịn efịbe ye Bedseba.</para>
  <para style="s1">Akam E-ebọññọ Eyem Adifeen</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1" />Nie mbọm mbaña miin, O Abasi,</para>
  <para style="q2" vid="PSA 51:1">ke ntak ima mfo ake imiikpuuho;</para>
  <para style="q1" vid="PSA 51:1">ke ntak ekamba mbọm mfo</para>
  <para style="q2" vid="PSA 51:1">kwokko mme ndudue mmi sio.<verse eid="PSA 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2" />Yet afịd ukwaññkpọ mmi sio</para>
  <para style="q2" vid="PSA 51:2">nyʌñ nam ami nsana ñkpọñ idiọọkñkpọ mmi.<verse eid="PSA 51:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3" />Sia ami mmediọọñọ mme ndudue mmi,</para>
  <para style="q2" vid="PSA 51:3">ndin idiọọkñkpọ mmi anyʌñ anna miin ke iso afịd ini.<verse eid="PSA 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4" />Ami mmudue fiin, kpa afo ikpọọñ,</para>
  <para style="q2" vid="PSA 51:4">mmenyʌñ nnam se idiọọk ke iso mfo;</para>
  <para style="q1" vid="PSA 51:4">ke ntoro afo amenen ke ubiideikpe mfo</para>
  <para style="q2" vid="PSA 51:4">anyʌñ anen ke ini afo akpeeghe ikpe.<verse eid="PSA 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5" />Ke akpanikọ ami ñkemana ke ukwañ,</para>
  <para style="q2" vid="PSA 51:5">eka mmi akeñyommo miin ke idiọọkñkpọ.<verse eid="PSA 51:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6" />Ado afo akeyem akpanikọ tọọñọ ke ntʌñidịb;</para>
  <para style="q2" vid="PSA 51:6">afo akeñkpeep miin aniọñ ke ndedịbe itie ado.<verse eid="PSA 51:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7" />Ñyet miin ke haisọb, ndin ami ñyaasana;</para>
  <para style="q2" vid="PSA 51:7">Ñyet miin, ndin ami ñyaasana ñkan sino.<verse eid="PSA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8" />Nam ami ñkop inemesịd ye idaara;</para>
  <para style="q2" vid="PSA 51:8">yak mme akpọ ake afo akebʌññọ edaara.<verse eid="PSA 51:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9" />Kuuse mme idiọọkñkpọ mmi</para>
  <para style="q2" vid="PSA 51:9">nyʌñ kwokko afịd mme ukwaññkpọ mmi sio.<verse eid="PSA 51:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10" />O Abasi, bot adisana esịd nsịn miin ke idem,</para>
  <para style="q2" vid="PSA 51:10">nyʌñ demme sịbidịd nsọọñọnda ke idem mmi.<verse eid="PSA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11" />Kumbịne miin usio ke iso mfo</para>
  <para style="q2" vid="PSA 51:11">kuunyʌñ umbọọ miin adisana Sịbidịd mfo.<verse eid="PSA 51:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12" />Maana nnọ miin inemesịd a-atooho adinyaaña mfo</para>
  <para style="q2" vid="PSA 51:12">nyʌñ nnọ miin adinyịmme sịbidịd, yak ammʌm miin akama.<verse eid="PSA 51:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13" />Ndin ami ñyaakpeep mme aduembed usʌñ mfo</para>
  <para style="q2" vid="PSA 51:13">nọ mme anamidiọọk etịmme ubịne fiin.<verse eid="PSA 51:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14" />O Abasi, nsio miin ke ubiomikpe uduọk iyiib</para>
  <para style="q2" vid="PSA 51:14">afo a-adooho Abasi Andinyaaña mmi,</para>
  <para style="q2" vid="PSA 51:14">ñko edeme mmi ayaakwọ adinenido mfo.<verse eid="PSA 51:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15" />
    <char style="nd">Abọọñ</char>, tat ñkpọkinua mmi,</para>
  <para style="q2" vid="PSA 51:15">ndin inua mmi ayaatañ itooro mfo.<verse eid="PSA 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16" />Afo uyemme uwa, akpeyem ñkpaunọ; afo unyʌññọ ukop inem ke mme ufọfọb uwa.<verse eid="PSA 51:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17" />Uwa mmi, O Abasi, ado sịbidịd mbʌññọesịd;</para>
  <para style="q2" vid="PSA 51:17">mbʌññọesịd ye esịd mfʌhọ</para>
  <para style="q2" vid="PSA 51:17">afo, O Abasi, uduusịnne.<verse eid="PSA 51:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18" />Yak unem fiin esịd adinam Saiyọn aforo,</para>
  <para style="q2" vid="PSA 51:18">ye adibọp mme ndibene Yeruselem.<verse eid="PSA 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19" />Ndin afo ayaakop inemesịd ke mme uwa ndinen awo</para>
  <para style="q2" vid="PSA 51:19">ke mme ufọfọb uwa e-efọppọ ifre;</para>
  <para style="q2" vid="PSA 51:19">ndin eyaewa mme ñyaaraenañ ke akpokoro uwa mfo.<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="cl">Saam 52<note caller="+" style="f"><char style="fr" closed="false">52:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 52:1-9 ewet Saam 52:3-11</char></note></para>
  <para style="d">Ake etubom ikwọ. <char style="tl">Maskil</char> ake Defid. Ke ini Dook, awo Edọm akekaaha akebo Sọọl ate: “Defid aka ufọk Ahimelek.”</para>
  <para style="s1">Abasi Ada Ukara</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1" />Afo awo uko, nsoo inam nọ afo aduaak inua abaña idiọọk?</para>
  <para style="q2" vid="PSA 52:1">Nsoo inam afo aduaak inua afịd usen,</para>
  <para style="q2" vid="PSA 52:1">afo a-adooho ñkpọ ndọk ke anyen Abasi?<verse eid="PSA 52:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2" />Afo a-anamma abiaña,</para>
  <para style="q2" vid="PSA 52:2">edeme mfo aduak nsobo;</para>
  <para style="q2" vid="PSA 52:2">anye aba nte akadañ e-ebannaban.<verse eid="PSA 52:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3" />Afo ama idiọọk utu ke eti ñkpọ,</para>
  <para style="q2" vid="PSA 52:3">nsu utu ke aditañ akpanikọ.<verse eid="PSA 52:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4" />Afo ama afịd ndiọi ikọ,</para>
  <para style="q2" vid="PSA 52:4">afo edeme abiaña!<verse eid="PSA 52:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5" />Ke akpanikọ Abasi ayausuuhọ fiin asịn ke nsobo nsi-nsi:</para>
  <para style="q2" vid="PSA 52:5">Anye ayauwappa fiin anyʌñ ubuuñ fiin asio ke atayad mfo;</para>
  <para style="q2" vid="PSA 52:5">anye ayauwịppe fiin asio ke isọñ mme aduuwem.<verse eid="PSA 52:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6" />Mme ndinen awo eyaekịt enyʌñ edịkke;</para>
  <para style="q2" vid="PSA 52:6">ammọ eyausak fiin, ebo ete,<verse eid="PSA 52:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7" />“Idahami se awo ado</para>
  <para style="q2" vid="PSA 52:7">i-imiikinamma Abasi ado ukad amọ</para>
  <para style="q1" vid="PSA 52:7">ado akebuọt idem ke akpọsọñ inie amọ</para>
  <para style="q2" vid="PSA 52:7">anyʌñ akọt ke adudu ato ke adisobo mbon mfen!”<verse eid="PSA 52:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8" />Ado ami mba nte eto ọlif</para>
  <para style="q2" vid="PSA 52:8">a-afọnnọ idem ke esịd ufọk Abasi;</para>
  <para style="q1" vid="PSA 52:8">Ami mbuọt idem ke nsọọñọnda ima Abasi</para>
  <para style="q2" vid="PSA 52:8">ke nsi-nsi nsi-nsi.<verse eid="PSA 52:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9" />Sia ami ñyautooro fiin afịd ini ke se afo anam</para>
  <para style="q2" vid="PSA 52:9">ke iso atu mme andunịm fiin ke akpanikọ.</para>
  <para style="q1" vid="PSA 52:9">Ndin ami ñyaadot anyen ke anyịñ mfo;</para>
  <para style="q2" vid="PSA 52:9">sia anyịñ mfo afọn.<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="cl">Saam 53<note caller="+" style="f"><char style="fr" closed="false">53:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 53:1-6 ewet Saam 53:2-7</char></note></para>
  <para style="d">Ake etubom ikwọ. Asañake akekem ye <char style="tl">Mahalad.</char> Saam <char style="tl">maskil</char> ake Defid.</para>
  <para style="s1">Baaba Awo Ndomokeed Ikemeke Adisịn Abasi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1" />Ndisịme awo abo ke esịd ammọ ate,</para>
  <para style="q2" vid="PSA 53:1">“Abasi ibaaha.”</para>
  <para style="q1" vid="PSA 53:1">Ammọ edoñño mbon ñwo, usʌñ ammọ anyʌñ ado ndiọi;</para>
  <para style="q2" vid="PSA 53:1">ibaaha awo ndomokeed se inam eti ido.<verse eid="PSA 53:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2" />Abasi atie ke anyọñ asuuk anyen ase ubon awo</para>
  <para style="q2" vid="PSA 53:2">me ayaakịt awo ndomokeed</para>
  <para style="q1" vid="PSA 53:2">se inie ifiọk,</para>
  <para style="q2" vid="PSA 53:2">ndomokeed se iyem Abasi.<verse eid="PSA 53:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3" />Afịd ammọ ekpọñ usʌñ, afịd ammọ ekappa mbubịk;</para>
  <para style="q2" vid="PSA 53:3">ibaaha awo ndomokeed se inam eti ñkpọ,</para>
  <para style="q2" vid="PSA 53:3">ibaaha awo ndomokeed.<verse eid="PSA 53:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4" />Afịd mme anamidiọọk ami isʌkkọ idiọọñọ ñkpọ ndomokeed?</para>
  <para style="b" vid="PSA 53:4" />
  <para style="q1" vid="PSA 53:4">Ammọ eta ikọd mmi nte eta uyo;</para>
  <para style="q2" vid="PSA 53:4">akenam ammọ iseemeke ikoot Abasi.<verse eid="PSA 53:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5" />Ado se ammọ do, eba ke akpọsọñ ndịk,</para>
  <para style="q2" vid="PSA 53:5">akpesʌkado ñkpọ ndịk imiikibaaha.</para>
  <para style="q1" vid="PSA 53:5">Abasi amaasuan mme akpọ mbon se ikinwana ye afo;</para>
  <para style="q2" vid="PSA 53:5">afo amaanam abuud amʌm ammọ, sia Abasi amaasịn ammọ ke ndek.<verse eid="PSA 53:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6" />O, ubaha nte adinyaaña Isrel akpetooho Saiyọn adi!</para>
  <para style="q2" vid="PSA 53:6">Ke ini Abasi amaanake aben ikọd amọ ake emaekesuan atịmme adi,</para>
  <para style="q2" vid="PSA 53:6">yak Yekọb adaara Isrel anyʌñ anem esịd!<verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="cl">Saam 54<note caller="+" style="f"><char style="fr" closed="false">54:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 54:1-7 ewet Saam 54:3-9</char></note></para>
  <para style="d">Ake etubom ikwọ. Ye mme ndido udʌk. Saam <char style="tl">maskil</char> ake Defid. Ke ini mbon Siif ekebịneke Sọọl ekebo ete, “Nte Defid idịbeke ke atu ñnyịn?”</para>
  <para style="s1">Adinịm Abasi Ke Akpanikọ Ke Ini Idomo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1" />O Abasi, dat anyịñ mfo ñnyaaña miin;</para>
  <para style="q2" vid="PSA 54:1">dat adudu mfo nam ikpe antoppo miin.<verse eid="PSA 54:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2" />O Abasi, kop akam mmi;</para>
  <para style="q2" vid="PSA 54:2">kpañ utọñ kop ikọ inua mmi.<verse eid="PSA 54:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3" />Ndiọi asua esʌk enwana ye mi,</para>
  <para style="q2" vid="PSA 54:3">mbon unana mbọm esʌk eyem adiñwot miin,</para>
  <para style="q2" vid="PSA 54:3">mbon i-imiinieghe mbaak inọ Abasi.<verse eid="PSA 54:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4" />Ke akpanikọ Abasi ado unwam mmi;</para>
  <para style="q2" vid="PSA 54:4">
    <char style="nd">Abọọñ</char> ado andiñkama miin.<verse eid="PSA 54:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5" />Yak idiọọk atịmme abịne mbon se insappa miin;</para>
  <para style="q2" vid="PSA 54:5">dat akpanikọ mfo sobo ammọ.<verse eid="PSA 54:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6" />Ami ñyaawa uwa imaesịd unọ fiin;</para>
  <para style="q2" vid="PSA 54:6">Ami ñyaatooro anyịñ mfo, <char style="nd">Abọọñ</char>, sia afọn.<verse eid="PSA 54:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7" />Afo amensio miin afep ke afịd mme mfịna mmi,</para>
  <para style="q2" vid="PSA 54:7">ñko anyen mmi akịt iduọ mme asua mmi.<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="cl">Saam 55<note caller="+" style="f"><char style="fr" closed="false">55:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 55:1-23 ewet Saam 55:2-24</char></note></para>
  <para style="d">Ake etubom ikwọ. Ye mme ndido udʌk. Saam <char style="tl">maskil</char> ake Defid.</para>
  <para style="s1">Ufan Abiaña Anye</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1" />O Abasi, kpañ utọñ kop akam mmi,</para>
  <para style="q2" vid="PSA 55:1">kuusịn ñkpeubọk mmi;<verse eid="PSA 55:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 55:2" />ñkop miin nyʌñ ñyie miin.</para>
  <para style="q1" vid="PSA 55:2">Akikere mmi antịmede miin anyʌñ amfịna<verse eid="PSA 55:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 55:3" />ke ntak se asua mmi atañ,</para>
  <para style="q2" vid="PSA 55:3">ke ntak ndiọi uduak mbon ibak;</para>
  <para style="q1" vid="PSA 55:3">sia ammọ eben ufen ensọk miin</para>
  <para style="q2" vid="PSA 55:3">enyʌñ edumbịnne miin ke iyadesịd ammọ.<verse eid="PSA 55:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4" />Esịd mmi aba ke ndutʌhọ;</para>
  <para style="q2" vid="PSA 55:4">ndịk ñkpa aduọ andoro miin ke idem.<verse eid="PSA 55:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5" />Ndịk mme ñnyeñidem ennọ mfịna ke idem;</para>
  <para style="q2" vid="PSA 55:5">uteeñe añkan miin ubọk.<verse eid="PSA 55:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6" />Ami mmaabo, “O, adieke ñkpenieghe mba nte ibiom!</para>
  <para style="q2" vid="PSA 55:6">Ami ñkpaafuuro ñkaa ñkeba ke emem.<verse eid="PSA 55:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7" />Ami ñkpaafuuro ñkaa anyan usʌñ</para>
  <para style="q2" vid="PSA 55:7">ñnyʌñ ñkeba ke akpautatan;<verse eid="PSA 55:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8" />Ami ñkpaasọp ñkaa itie idʌñ mmi,</para>
  <para style="q2" vid="PSA 55:8">Ndakka ñkpọñ akpọsọñ afịm mme ayobio.”<verse eid="PSA 55:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9" />Abọọñ, tịmede usʌñ mbon ibak, tịmede mme ikọ ammọ,</para>
  <para style="q2" vid="PSA 55:9">sia ami mmekịt afai ye utọk ke abio.<verse eid="PSA 55:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10" />Ke uweemeayio ye akonayio ammọ ekanna mme ndibene amọ ekʌk;</para>
  <para style="q2" vid="PSA 55:10">usua mme isuuñọ enyʌñ edọñọ ke esịd amọ.<verse eid="PSA 55:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11" />Mme adudu nsobo ekama utom ke abio ami;</para>
  <para style="q2" vid="PSA 55:11">mme uduak ibak ye mme nsu ikpọññọ mme efaak amọ.<verse eid="PSA 55:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12" />Adieke adooho asua ndomokeed amansọñ miin anyen,</para>
  <para style="q2" vid="PSA 55:12">ami ñkpaakeyọ anye;</para>
  <para style="q1" vid="PSA 55:12">akpedo asua mmi amaanam ntịme ye ami,</para>
  <para style="q2" vid="PSA 55:12">ami ñkpaakedịbe.<verse eid="PSA 55:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13" />Ado ado afo, awo nte ami,</para>
  <para style="q2" vid="PSA 55:13">awo nsaña mmi, akpan ufan mmi,<verse eid="PSA 55:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14" />ake ami ñkenieghe eti ewuana keed,</para>
  <para style="q2" vid="PSA 55:14">ke ufọk Abasi,</para>
  <para style="q1" vid="PSA 55:14">nte ñnyịn ikisaañake</para>
  <para style="q2" vid="PSA 55:14">ke atu mbon se ikpono Abasi.<verse eid="PSA 55:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15" />Yak ñkpa aben mme asua mmi ke unana idodanyen;</para>
  <para style="q2" vid="PSA 55:15">yak ammọ enyʌñ esọiyọ ye uwem edʌk abioekpo,</para>
  <para style="q2" vid="PSA 55:15">sia ibak adʌñ ammọ ke idem.<verse eid="PSA 55:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16" />Amaado ami, ami ñkoot Abasi,</para>
  <para style="q2" vid="PSA 55:16">ndin Abọọñ añnyaaña miin.<verse eid="PSA 55:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17" />Ndubiayio, ubakusen ye ufọọd uweemeayio</para>
  <para style="q2" vid="PSA 55:17">ami ntua nseeme ñyem unwam,</para>
  <para style="q2" vid="PSA 55:17">ndin anye akop uyio mmi.<verse eid="PSA 55:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18" />Anye amfak miin asio unọmọ ibaaha</para>
  <para style="q2" vid="PSA 55:18">ke ekọñ ake enwanake ye ami,</para>
  <para style="q2" vid="PSA 55:18">akpesʌkado uwak awo enamma ikọ ye ami.<verse eid="PSA 55:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19" />Abasi, a-adoroke ke ebekpo tọọñọ ke esed,</para>
  <para style="q2" vid="PSA 55:19">ake imiikpʌhọke,</para>
  <para style="q1" vid="PSA 55:19">anye ayaakop ammọ anyʌñ asuuhọ ammọ</para>
  <para style="q2" vid="PSA 55:19">sia ammọ inieghe mbaak Abasi.<verse eid="PSA 55:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20" />Awo nsaña mmi anam ikọ ye mme ufan amọ;</para>
  <para style="q2" vid="PSA 55:20">anye abiat edioomo amọ,<verse eid="PSA 55:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21" />Ikọinua amọ amem nte isek,</para>
  <para style="q2" vid="PSA 55:21">ado ekọñ asịne anye ke esịd;</para>
  <para style="q1" vid="PSA 55:21">mme ikọ amọ emem ekan adan,</para>
  <para style="q2" vid="PSA 55:21">ado ammọ edo mme akañkañ afai.<verse eid="PSA 55:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22" />Yaak mbiomo mfo nọ <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 55:22">ndin anye ayaukama fiin;</para>
  <para style="q1" vid="PSA 55:22">anye idiiyakka</para>
  <para style="q2" vid="PSA 55:22">adinen awo aduọ.<verse eid="PSA 55:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23" />Ado afo, Abasi, ayaasuuhọ idiọọk awo</para>
  <para style="q2" vid="PSA 55:23">asịn ke ube nsobo;</para>
  <para style="q1" vid="PSA 55:23">mbon uyem iyiib ye mbon abiaña</para>
  <para style="q2" vid="PSA 55:23">idiiduuho isịm mbakka iba usen uwem ammọ.</para>
  <para style="b" vid="PSA 55:23" />
  <para style="q1" vid="PSA 55:23">Ado amaado ami, mmenie mbuọdidem ke afo.<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="cl">Saam 56<note caller="+" style="f"><char style="fr" closed="false">56:0 </char><char style="ft" closed="false">ke usem Hibru</char></note><note caller="+" style="f"><char style="fr" closed="false">56:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 56:1-13 ewet Saam 56:2-14</char></note></para>
  <para style="d">Ake etubom ikwọ. Ekwọ ekeene uyioikwọ “Ibiom ke Afriyo Anyan Usʌñ.” Saam Defid, a-adooho <char style="tl">miktam.</char><note caller="+" style="f"><char style="fr" closed="false">56:0 </char><char style="ft" closed="false">abaña ñkpọ ikwọ</char></note> Ke ini mbon Filistia ekemʌmmọ anye ke Kad.</para>
  <para style="s1">Akam Mbuọdidem ke Abasi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1" />Nie mbọm mbaña miin, Abasi mmi,</para>
  <para style="q2" vid="PSA 56:1">sia mme mbon usua mmi esịn ifịk embịne miin;</para>
  <para style="q2" vid="PSA 56:1">ammọ efiik enam ekọñ ye ami afịd usen.<verse eid="PSA 56:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2" />Mme asua mmi edumbịnne miin afịd usen;</para>
  <para style="q2" vid="PSA 56:2">ke ntañidem ammọ uwak ammọ esʌk enam ekọñ ye ami.<verse eid="PSA 56:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3" />Ke ini ndịk ammʌmmọ miin, ami nie mbuọdidem mmi ke afo.<verse eid="PSA 56:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 56:4" />Ke Abasi, ake ami ntooroke ikọ amọ,</para>
  <para style="q1" vid="PSA 56:4">ami nnie mbuọdidem ke Abasi ñko ami nnieghe ndịk.</para>
  <para style="q2" vid="PSA 56:4">Nsoo ke ñkaña awo abʌkidem akeme adinnam?<verse eid="PSA 56:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5" />Ammọ edukpakka ikọ mmi afịd usen;</para>
  <para style="q2" vid="PSA 56:5">afịd ñkara ammọ ebaña iduọ mmi.<verse eid="PSA 56:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6" />Ammọ edʌk idiọọk edioomo, edịbe embet,</para>
  <para style="q2" vid="PSA 56:6">ammọ eyep ñkpadisañ mmi,</para>
  <para style="q2" vid="PSA 56:6">etie ebet adidat uwem mmi.<verse eid="PSA 56:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7" />Ke ntak ibak ammọ kuuyak ammọ ebọkkọ;</para>
  <para style="q2" vid="PSA 56:7">Abasi ke iyadesịd mfo, suuhọ mme idịd nịm.<verse eid="PSA 56:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8" />Wet ukuud mmi;</para>
  <para style="q2" vid="PSA 56:8">wet ibad mmọọñayịd mmi sịn ke ikpañwed mfo,<note caller="+" style="f"><char style="fr" closed="false">56:8 </char><char style="ft" closed="false">wet ibad mmọọñayịd mmi sịn ke ikpañwed mfo </char></note></para>
  <para style="q2" vid="PSA 56:8">nte ammọ isịneke ke ñwed ibad mfo?<verse eid="PSA 56:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9" />Ndin mme asua mmi eyaetịmme edem</para>
  <para style="q2" vid="PSA 56:9">ke ini ami ñkoodo ñyem unwam.</para>
  <para style="q2" vid="PSA 56:9">Ke ntom ke ami ndiidiọọñọ ke Abasi ada ye ami.<verse eid="PSA 56:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10" />Ke Abasi, ake ami ntooroke ikọ amọ,</para>
  <para style="q2" vid="PSA 56:10">ke <char style="nd">Abọọñ</char>, ake ami ntooroke ikọ amọ,<verse eid="PSA 56:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11" />ke Abasi ke ami mbuọt idem ñnyʌññọ mfeghe ndịk.</para>
  <para style="q2" vid="PSA 56:11">Nsoo ke awo akeme adinnam miin?<verse eid="PSA 56:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12" />Abasi mmi, ami mba ke idak akaaña unọ fiin;</para>
  <para style="q2" vid="PSA 56:12">Ami ñyaunọ fiin mme uwa ekọọm.<verse eid="PSA 56:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13" />Sia afo amemfak miin asio ke ñkpa</para>
  <para style="q2" vid="PSA 56:13">uyakka ukod mmi afiọnnọ,</para>
  <para style="q1" vid="PSA 56:13">nọ ami nsaña ke iso Abasi</para>
  <para style="q2" vid="PSA 56:13">ke unwana uwem.<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="cl">Saam 57<note caller="+" style="f"><char style="fr" closed="false">57:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 57:1-11 ewet Saam 57:2-12</char></note></para>
  <para style="d">Ake etubom ikwọ. Akeene uyioikwọ “Kuusobo.” Saam Defid. Ake <char style="tl">miktam</char>. Ke ini anye amaakefeghe abọkkọ Sọọl akedịbe ke abaitiad.</para>
  <para style="s1">Itooro ye Mbuọdidem Ke Ini Afanekọñ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1" />Nie mbọm mbaña miin, Abasi mmi, nie mbọm mbaña miin,</para>
  <para style="q2" vid="PSA 57:1">sia afo ado itie udịbe mmi.</para>
  <para style="q1" vid="PSA 57:1">Ami ñyaadịbe ke ndukpọñ mfuud mba mfo</para>
  <para style="q2" vid="PSA 57:1">tutu nsobo aboiyo afep.<verse eid="PSA 57:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2" />Ami ntua nnọ Abasi Andikoñ Ñkan,</para>
  <para style="q2" vid="PSA 57:2">nnọ Abasi, ake antoppoke miin ikpe.<verse eid="PSA 57:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3" />Anye atie ke hefịn añnyaaña miin</para>
  <para style="q2" vid="PSA 57:3">aduat mbon se isịn ifịk imbịne;</para>
  <para style="q2" vid="PSA 57:3">Abasi annọ ima ye akpanikọ amọ.<verse eid="PSA 57:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4" />Ami mba ke ufọọd mme ekpe;</para>
  <para style="q2" vid="PSA 57:4">eñkpak miin ñkedʌñ ke atu mme ndiọi unam,</para>
  <para style="q1" vid="PSA 57:4">ideen se eded ammọ eba nte eduad ye utịgha,</para>
  <para style="q2" vid="PSA 57:4">ake edeme ammọ e-edooho ubaban akañkañ.<verse eid="PSA 57:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5" />O Abasi, bọ ubọọñ, koñ kan mme hefịn;</para>
  <para style="q2" vid="PSA 57:5">yak ubọọñ mfo ayọhọ afịd ekondo.<verse eid="PSA 57:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6" />Ammọ etat iyịre enịm edikọp ukod mmi,</para>
  <para style="q2" vid="PSA 57:6">mfʌhọ amañyọhọ miin idem.</para>
  <para style="q1" vid="PSA 57:6">Ammọ etịppe ube ke usʌñisañ mmi,</para>
  <para style="q2" vid="PSA 57:6">ado ammọ eduọññọ edọñọ do ke idem ammọ.<verse eid="PSA 57:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7" />O Abasi, esịd mmi anie iwuuk,</para>
  <para style="q2" vid="PSA 57:7">esịd mmi anie iwuuk;</para>
  <para style="q2" vid="PSA 57:7">ami ñyaakwọ ikwọ ñnyʌñ nsio ñkpo ikwọ.<verse eid="PSA 57:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8" />Ukpọñ mmi, demme!</para>
  <para style="q2" vid="PSA 57:8">Hab ye ndidoudʌk, idemme!</para>
  <para style="q2" vid="PSA 57:8">Ami ñyaademme usiere.<verse eid="PSA 57:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9" />
    <char style="nd">Abọọñ</char>, ami ñyautooro fiin, ke atu mme idịd.</para>
  <para style="q2" vid="PSA 57:9">Ami ñyaakwọ ubaña fiin ke atu mbon awo.<verse eid="PSA 57:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10" />Sia ima mfo akpon, tutu akewuọ mme hefịn;</para>
  <para style="q2" vid="PSA 57:10">akpanikọ mfo asịm mme ikpaanyọñ.<verse eid="PSA 57:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11" />O Abasi, bọ ubọọñ, koñ kan mme hefịn;</para>
  <para style="q2" vid="PSA 57:11">yak ubọọñ mfo ayọhọ afịd ekondo.<verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="cl">Saam 58<note caller="+" style="f"><char style="fr" closed="false">58:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 58:1-11 ewet Saam 58:2-12</char></note></para>
  <para style="d">Ake etubom ikwọ. Akeene uyioikwọ “Kuusobo.” Saam ake Defid. Ake <char style="tl">miktam.</char></para>
  <para style="s1">Akam Ke Ini Afịdñkpọ Amaabiara</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1" />Nte ndufo mme andikara emetañ se inen?</para>
  <para style="q2" vid="PSA 58:1">Nte ndufo emekpe ikpe mbon awo ke unen?<verse eid="PSA 58:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2" />Iyoo, ndufo eduak ukwañ ke esịd ndufo,</para>
  <para style="q2" vid="PSA 58:2">ndin ubọk ndufo enam afai ke iso isọñ.<verse eid="PSA 58:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3" />Mbon ibak emaewaaña ekpọñ usʌñ tọọñọ ke ini emana ammọ;</para>
  <para style="q2" vid="PSA 58:3">ammọ emaebiaña tọọñọ ke ntʌñidịb, esuan mme nsu.<verse eid="PSA 58:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4" />Ifod ammọ aba nte ifod udʌkikọd,</para>
  <para style="q2" vid="PSA 58:4">nte ake asabọ ake amaakesiit utọñ amọ,<verse eid="PSA 58:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5" />ake adiiyemme adikop uyioikwọ andikama nsuuk,</para>
  <para style="q2" vid="PSA 58:5">akpọkọm ifiọk andikpek anye akpon die.<verse eid="PSA 58:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6" />O Abasi, bʌñ ammọ eded ke inua,</para>
  <para style="q2" vid="PSA 58:6">
    <char style="nd">Abọọñ</char>, wịppe mme eded mme ekpe ado sioño!<verse eid="PSA 58:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7" />Yak ammọ esop nte mmọọñ afeghe afrọ;</para>
  <para style="q2" vid="PSA 58:7">yak mme idañ ammọ etịp, ammọ emaedʌt utịgha.<verse eid="PSA 58:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8" />Yak ammọ eba nte ekwọọñ, a-atarake akappa udọd, ke ini anye asʌkkọ asaña,</para>
  <para style="q2" vid="PSA 58:8">nte akpa-ke-idịb nsekayịn, a-adiikịtte utịn.<verse eid="PSA 58:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9" />Mbemiso mme ako ndufo ekop ufiob ifiaikañ ñkukịm,</para>
  <para style="q2" vid="PSA 58:9">me ammọ edo awawa me nsaad, eyaekwọọk mbon ibak eduọọñọ.<verse eid="PSA 58:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10" />Mme ndinen awo eyaedaara ke ini ammọ emaekịt ke esio usiene iwuod ammọ,</para>
  <para style="q2" vid="PSA 58:10">ke ini ammọ emaenyiin ñkpad ammọ ke iyiib mbon ibak.<verse eid="PSA 58:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11" />Do ndin ke mme awo ediibo,</para>
  <para style="q2" vid="PSA 58:11">“Ke akpanikọ ndinen awo esʌk ebọbọ nti utịb;</para>
  <para style="q2" vid="PSA 58:11">ke akpanikọ Abasi andikpe ikpe ederimbod mmọdo.”<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="cl">Saam 59<note caller="+" style="f"><char style="fr" closed="false">59:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 59:1-17 ewet Saam 59:2-18</char></note></para>
  <para style="d">Ake etubom ikwọ. Akeene uyioikwọ “Kuusobo.” Saam ake Defid. Ake <char style="tl">miktam.</char> Ke ini Sọọl akedọññọ mme awo ekeyep ufọk Defid nọ ewot anye.</para>
  <para style="s1">Akam e-Ebọññọ Eyem Ukpeme</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1" />O Abasi, ñnyaaña miin sio ke ubọk mme asua mmi;</para>
  <para style="q2" vid="PSA 59:1">do ukpeme mmi mbaak mbon se inam ekọñ mme ami,<verse eid="PSA 59:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2" />Ñnyaaña miin sio ke ubọk mme anamidiọọk</para>
  <para style="q2" vid="PSA 59:2">nyʌñ ñnyaaña miin sio ke ubọk mbon se iyem iyiib mmi.<verse eid="PSA 59:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3" />Se naña ammọ edịbe eyem uwem mmi!</para>
  <para style="q2" vid="PSA 59:3">Ñkpọsọñ awo edʌk adu embaña miin</para>
  <para style="q2" vid="PSA 59:3">ke unana ndudue me idiọọkñkpọ mmi, <char style="nd">Abọọñ</char>.<verse eid="PSA 59:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4" />Ami ndueghe, ado ammọ ebeeñe idem adinwana ye ami.</para>
  <para style="q2" vid="PSA 59:4">Dakka da di ñnyaaña miin; se ukuud mmi!<verse eid="PSA 59:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5" />Afo, <char style="nd">Abọọñ</char> Abasi Andikponñkan;</para>
  <para style="q2" vid="PSA 59:5">afo a-adooho Abasi Isrel,</para>
  <para style="q1" vid="PSA 59:5">dakka da ke idem mfo ke nọ afịd mme idịd ufen;</para>
  <para style="q2" vid="PSA 59:5">kuutua mbon ibak abiaña mbọm.<verse eid="PSA 59:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6" />Ammọ etịmme edi ke ndubiayio,</para>
  <para style="q2" vid="PSA 59:6">edikpọi nte mme ewa,</para>
  <para style="q2" vid="PSA 59:6">enyʌñ eyep ekanna abio ekʌk.<verse eid="PSA 59:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7" />Se siwuọ ammọ ke inua,</para>
  <para style="q2" vid="PSA 59:7">ikọ inua ammọ esọp nte akañkañ,</para>
  <para style="q2" vid="PSA 59:7">ammọ enyʌñ ekere ebo, “Anie akeme adikop se ñnyịn itañ?”<verse eid="PSA 59:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8" />Ado afo, <char style="nd">Abọọñ</char> asak ammọ;</para>
  <para style="q2" vid="PSA 59:8">afo aduọi afịd mme idịd ado.<verse eid="PSA 59:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9" />Afo ado adudu mmi, ami use fiin,</para>
  <para style="q2" vid="PSA 59:9">afo, Abasi, ado itie ukpeme mmi,<verse eid="PSA 59:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 59:10" />Abasi mmi ake ami ñkemeke adibet edem ke ima amọ.</para>
  <para style="b" vid="PSA 59:10" />
  <para style="q1" vid="PSA 59:10">Abasi ayaaboiyo iso annọ miin</para>
  <para style="q2" vid="PSA 59:10">ayaanyʌñ anam yak ami nsak mbon se insappa miin ke ikọ inua.<verse eid="PSA 59:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11" />Ado kuuwot ammọ, <char style="nd">Abọọñ</char> atuekọñ ñnyịn,</para>
  <para style="q2" vid="PSA 59:11">imiidooho mbon mmi eyaefre.</para>
  <para style="q1" vid="PSA 59:11">Ke adudu mfo wịppe ammọ sioño</para>
  <para style="q2" vid="PSA 59:11">nyʌñ suuhọ ammọ nịm ke isọñ.<verse eid="PSA 59:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12" />Ke ntak ndiọiñkpọ inua ammọ,</para>
  <para style="q2" vid="PSA 59:12">ke ntak mme ikọ inua ammọ,</para>
  <para style="q2" vid="PSA 59:12">yak ntañidem uwem ammọ amʌm ammọ.</para>
  <para style="q1" vid="PSA 59:12">Ke ntak mme isuuñọ ye mme nsu ake ammọ etañña,<verse eid="PSA 59:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 59:13" />sobo ammọ ke iyadesịd mfo,</para>
  <para style="q2" vid="PSA 59:13">sobo ammọ kweeñe tutu ammọ ibaaha aba.</para>
  <para style="q1" vid="PSA 59:13">Ndin mme awo eyaediọọñọ ekewuọ utịd ederimbod</para>
  <para style="q2" vid="PSA 59:13">ke Abasi akara Yekọb.<verse eid="PSA 59:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14" />Ammọ etịmme edi ke ndubiayio,</para>
  <para style="q2" vid="PSA 59:14">edikpọi nte mme ewa,</para>
  <para style="q2" vid="PSA 59:14">enyʌñ eyep ekanna abio ekʌk.<verse eid="PSA 59:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15" />Ammọ eyooñ eyem ndidia</para>
  <para style="q2" vid="PSA 59:15">enyʌñ ebọñ ñkpo ke imiiyʌkkọke ammọ.<verse eid="PSA 59:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16" />Ado ami ñyaakwọ ntooro adudu mfo,</para>
  <para style="q2" vid="PSA 59:16">ke ubakusen ami ñyaakwọ ntooro ima mfo,</para>
  <para style="q1" vid="PSA 59:16">sia afo ado itie udịbe mmi,</para>
  <para style="q2" vid="PSA 59:16">ukpeme mmi ke ini mfịna.<verse eid="PSA 59:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17" />Afo ado adudu mmi, ami ñkwọ itooro unọ fiin;</para>
  <para style="q2" vid="PSA 59:17">afo, Abasi, ado itie udịbe mmi,</para>
  <para style="q2" vid="PSA 59:17">Abasi mmi ake ami ñkemeke adibet edem ke ima amọ.<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="cl">Saam 60<note caller="+" style="f"><char style="fr" closed="false">60:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 60:1-12 ewet Saam 60:3-14</char></note></para>
  <para style="d">Ake etubom ikwọ. Akeene uyioikwọ “Lili Edioomo.” <char style="tl">Miktam</char> ake Defid. E-edatta ekpeep ñkpọ. Ke ini anye akenwanake Aram Naharaim ye Aram Soba, ye ke ini Yoab aketịmmeke adi adisobo mbon Edọm awo tọsịn duob mme iba ke Abedeñ Inʌñ.</para>
  <para style="s1">Afo Amekeme Adibuọt Idem Ke Abasi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1" />Abasi, afo amaisịn ñnyịn, anyʌñ anaminua ke ñnyịn;</para>
  <para style="q2" vid="PSA 60:1">afo ameyat esịd ye ñnyịn, mbọk tañ ñnyịn bok!<verse eid="PSA 60:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2" />Afo amaanyeeñe isọñ anyʌñ akʌppọ anye anịm inwañ;</para>
  <para style="q2" vid="PSA 60:2">diọñ ñwuudo amọ, ke asʌk anyeeñe.<verse eid="PSA 60:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3" />Afo amenam mbon mfo ekịt ini nsọñọñkpọ;</para>
  <para style="q2" vid="PSA 60:3">afo aminọ ñnyịn ukọd a-anamma ñnyịn ifịmme.<verse eid="PSA 60:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4" />Ado afo amedịppe afọñidiọọñọ afʌk mbon se ubaak fiin,</para>
  <para style="q2" vid="PSA 60:4">yak ebọkkọ utịgha.<verse eid="PSA 60:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5" />Inyaaña ñnyịn nyʌñ inwam ñnyịn ye ubọk nnasia mfo,</para>
  <para style="q2" vid="PSA 60:5">nọ mbon se afo ama ebọkkọ.<verse eid="PSA 60:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6" />Abasi atie ke adisana itie amọ atañ abo:</para>
  <para style="q2" vid="PSA 60:6">“Ke adikan ami ñyaabakka Sekem nsio ndaaha</para>
  <para style="q2" vid="PSA 60:6">ñnyʌñ ndomo Abedeñ Sukọd.<verse eid="PSA 60:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7" />Kilied ado ake mmi, Manase anyʌñ ado ake mmi;</para>
  <para style="q2" vid="PSA 60:7">Ifrem ado itamukpeme anọ iwuod mmi,</para>
  <para style="q2" vid="PSA 60:7">Yuda ado esañubọọñ mmi.<verse eid="PSA 60:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8" />Mọb ado besịn uyieubọk mmi,</para>
  <para style="q2" vid="PSA 60:8">ke Edọm ke ami ntop ikpaukod mmi ndot;</para>
  <para style="q2" vid="PSA 60:8">Ke Filistia ke ami nsio ñkpo idaara.”<verse eid="PSA 60:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9" />Anie awo adimben miin idʌk akpọsọñ abio?</para>
  <para style="q2" vid="PSA 60:9">Anie adindat miin usʌñ ika Edọm?<verse eid="PSA 60:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10" />Nte idooho afo, Abasi, afo ake akisịnne ñnyịn</para>
  <para style="q2" vid="PSA 60:10">unyʌññọ usaña aba ye mbon ekọñ ñnyịn?<verse eid="PSA 60:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11" />Inọ ñnyịn unwam ke abaña mme asua,</para>
  <para style="q2" vid="PSA 60:11">sia unwam awo ibaaha ufọn ndomokeed.<verse eid="PSA 60:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12" />Ke Abasi ñnyịn iyainie adikan,</para>
  <para style="q2" vid="PSA 60:12">anye ayaanyʌñ afiik mme asua ñnyịn ke ñkpad.<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="cl">Saam 61<note caller="+" style="f"><char style="fr" closed="false">61:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 61:1-8 ewet Saam 61:2-9</char></note></para>
  <para style="d">Ake etubom ikwọ. Asaña ye mme ndido udʌk. Ake Defid.</para>
  <para style="s1">Ke Idak Ukpeme Abasi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1" />Kop ayịd mmi, O Abasi;</para>
  <para style="q2" vid="PSA 61:1">kpañ utọñ nọ akam mmi.<verse eid="PSA 61:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2" />Ami ntie ke mme utịd ederimbod mbọñ ukoot fiin,</para>
  <para style="q2" vid="PSA 61:2">ami ukoot fiin ñkeene naña esịd mmi amem,</para>
  <para style="q2" vid="PSA 61:2">mben miin kaa itiad ake akoñño añkan miin.<verse eid="PSA 61:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3" />Sia afo ado itie udịbe mmi,</para>
  <para style="q2" vid="PSA 61:3">akpọsọñ tọwa ake akanna mme asua.<verse eid="PSA 61:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4" />Andọñ miin adidʌñ ke atayad mfo ke nsi-nsi</para>
  <para style="q2" vid="PSA 61:4">ñnyʌñ ndịbe ke mfuud idak mba mfo.<verse eid="PSA 61:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5" />Sia afo, Abasi, amekop mme enwọñọ mmi;</para>
  <para style="q2" vid="PSA 61:5">afo amennọ miin akpọọkpọ udeeme, ake afo anọọhọ mbon se ibaak anyịñ mfo.<verse eid="PSA 61:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6" />Dian mme usen uwem nọ adidem,</para>
  <para style="q2" vid="PSA 61:6">yak anye akịt uwak emana.<verse eid="PSA 61:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7" />Yak anye atie ke ebekpo ke iso Abasi ke nsi-nsi;</para>
  <para style="q2" vid="PSA 61:7">nam ima ye akpanikọ mfo akpeme anye.<verse eid="PSA 61:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8" />Ndin ami ñyaakwọ ntooro anyịñ mfo ke nsi-nsi,</para>
  <para style="q2" vid="PSA 61:8">ñnyʌñ nsio mme akaaña mmi ke usen ke usen.<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="cl">Saam 62<note caller="+" style="f"><char style="fr" closed="false">62:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 62:1-12 ewet Saam 62:2-13</char></note></para>
  <para style="d">Ake etubom ikwọ. Ake Yedutun. Saam Defid.</para>
  <para style="s1">Abasi Anie Adudu Ye Mbọm</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1" />Ke akpanikọ ukpọñ mmi anie nduọkadudu ke Abasi;</para>
  <para style="q2" vid="PSA 62:1">adinyaaña mmi ato anye.<verse eid="PSA 62:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2" />Ke akpanikọ anye ado itiad mmi ye adinyaaña mmi;</para>
  <para style="q2" vid="PSA 62:2">anye ado itie udịbe mmi, ñkpọ ndomokeed intəkkoke.<verse eid="PSA 62:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3" />Ndufo ediikaiso inwana ye ami ikpeene die?</para>
  <para style="q2" vid="PSA 62:3">Nte afịd ndufo eyaentop miin eduọọk ke isọñ,</para>
  <para style="q2" vid="PSA 62:3">ke ndibene a-anyʌkkọke mi, ke akọ a-awuudoke mi?<verse eid="PSA 62:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4" />Ke akpanikọ ammọ eduak adindooro miin mfep</para>
  <para style="q2" vid="PSA 62:4">ke uyaiya itie mmi;</para>
  <para style="q2" vid="PSA 62:4">ammọ ema nsu.</para>
  <para style="q1" vid="PSA 62:4">Ammọ edat ñkpọkinua ammọ ediọñ,</para>
  <para style="q2" vid="PSA 62:4">ado esuuñọ ke esịd ammọ.<verse eid="PSA 62:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5" />Ii, ukpọñ mmi, bọ nduọkadudu ke Abasi;</para>
  <para style="q2" vid="PSA 62:5">idodanyen mmi ato anye.<verse eid="PSA 62:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6" />Ke akpanikọ anye ado itiad mmi ye adinyaaña mmi;</para>
  <para style="q2" vid="PSA 62:6">anye ado itie udịbe mmi, ñkpọ ndomokeed intəkkoke.<verse eid="PSA 62:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7" />Adinyaaña mmi ye ukpono mmi ekọñọ ke Abasi,</para>
  <para style="q2" vid="PSA 62:7">anye ado akwa itiad mmi, itie udịbe mmi.<verse eid="PSA 62:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8" />Ibuọt idem ke anye afịd ini, ndufo mbon awo;</para>
  <para style="q2" vid="PSA 62:8">inwañña esịd ndufo inọ anye,</para>
  <para style="q2" vid="PSA 62:8">sia Abasi ado itie udịbe ñnyịn.<verse eid="PSA 62:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9" />Ke akpanikọ mbon usuuhọ itie emana eba nte afịm;</para>
  <para style="q2" vid="PSA 62:9">mbon ikpọ itie emana edo nsu.</para>
  <para style="q1" vid="PSA 62:9">Adieke edotto ke udomoñkpọ, ammọ idooho ñkpọ ndomokeed:</para>
  <para style="q2" vid="PSA 62:9">naña ammọ iba iwuọñọke ñkpọ ñkọm etañ ammọ edian keed.<verse eid="PSA 62:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10" />Kuubuọt idem ke ñkanubọk</para>
  <para style="q2" vid="PSA 62:10">me adinie ikpu-ikpu idodanyen ke mme ñkpọ eyịppeyịp;</para>
  <para style="q1" vid="PSA 62:10">akpesʌkado mme inie ndufo etọttọ</para>
  <para style="q2" vid="PSA 62:10">ikiisịn esịd ndufo ke ammọ.<verse eid="PSA 62:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11" />Abasi atañ ñkpọ keed,</para>
  <para style="q2" vid="PSA 62:11">ado ami mmekop ñkpọ iba:</para>
  <para style="q1" vid="PSA 62:11">“Adudu unie fiin, Abasi,<verse eid="PSA 62:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 62:12" />ñko ke afo, <char style="nd">Abọọñ</char>, ke nsọọñọnda ima aba”;</para>
  <para style="q1" vid="PSA 62:12">ñko, “Afo anọ afịd awo utịb</para>
  <para style="q2" vid="PSA 62:12">akeene se ammọ enam.”<verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="cl">Saam 63<note caller="+" style="f"><char style="fr" closed="false">63:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 63:1-11 ewet Saam 63:2-12</char></note></para>
  <para style="d">Saam Defid. Ke ini anye akebaaha ke Akpautatan Yuda.</para>
  <para style="s1">Ima Abasi Akpon Akan Uwem</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1" />O Abasi, afo ado Abasi mmi,</para>
  <para style="q2" vid="PSA 63:1">ami mmenekke uyem fiin;</para>
  <para style="q1" vid="PSA 63:1">itọñ mfo andọñ miin</para>
  <para style="q2" vid="PSA 63:1">afịd idem mmi uyem fiin,</para>
  <para style="q1" vid="PSA 63:1">ke nsaad ufiob isọñ,</para>
  <para style="q2" vid="PSA 63:1">a-mmọọñ imiibaaha.<verse eid="PSA 63:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2" />Ami mmukịt fiin ke adisana itie mfo</para>
  <para style="q2" vid="PSA 63:2">ñnyʌñ ñkịt adudu ye ubọọñ mfo.<verse eid="PSA 63:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3" />Sia ima mfo afọn akan uwem,</para>
  <para style="q2" vid="PSA 63:3">ñkpọkinua mmi ayaunọ fiin ubọọñ.<verse eid="PSA 63:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4" />Ami ñyautooro fiin adaña nte ami nduuho uwem,</para>
  <para style="q2" vid="PSA 63:4">ndin ñyaabenne ubọk mmi ke anyọñ ñkpono anyịñ mfo.<verse eid="PSA 63:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5" />Ami ñyaakop uyʌkkọ nte ke ataa nsọñudua ndidia;</para>
  <para style="q2" vid="PSA 63:5">inua mmi ayaadat ñkpọkinua a-ayọhọke ye ikwọ utooro fiin.<verse eid="PSA 63:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6" />Ami utoiyo fiin ke ini nnaaha ke ikʌk mmi,</para>
  <para style="q2" vid="PSA 63:6">ami ñkere ubaña fiin ke mme ikpeghe akonayio.<verse eid="PSA 63:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7" />Sia afo ado unwam mmi,</para>
  <para style="q2" vid="PSA 63:7">ami ñkwọ ikwọ ke mfuud mba mfo.<verse eid="PSA 63:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8" />Ami nsọñ uyịre fiin;</para>
  <para style="q2" vid="PSA 63:8">ubọk nnasia mfo ammʌm miin akama.<verse eid="PSA 63:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9" />Eyaesobo mbon se iyem adiñwot miin;</para>
  <para style="q2" vid="PSA 63:9">ammọ eyaesuuho ekaiya mme ntotəño idak isọñ.<verse eid="PSA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10" />Eyaekappa ammọ enọ akañkañ</para>
  <para style="q2" vid="PSA 63:10">ndin ammọ eyaekappa edo ndidia enọ mme ewaikọd.<verse eid="PSA 63:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11" />Ado adidem ayaadaara ke Abasi;</para>
  <para style="q2" vid="PSA 63:11">afịd awo se ikinwọñọ ke anyịñ Abasi eyaewuana ke ubọọñ amọ,</para>
  <para style="q2" vid="PSA 63:11">ado eyaekʌp inua mbon nsu.<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="cl">Saam 64<note caller="+" style="f"><char style="fr" closed="false">64:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 64:1-10 ewet Saam 64:2-11</char></note></para>
  <para style="d">Ake etubom ikwọ. Saam Defid.</para>
  <para style="s1">Edaara Ke Ntak <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1" />Kop uyio mmi, Abasi mmi, naña ami nseeme;</para>
  <para style="q2" vid="PSA 64:1">kpeme uwem mmi mbaak uduak ibak mme asua mmi.<verse eid="PSA 64:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2" />Ndịp miin mbaak adu mbon ibak,</para>
  <para style="q2" vid="PSA 64:2">mbaak edioomo ndiọi awo.<verse eid="PSA 64:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3" />Ammọ eban edeme ammọ nte akañkañ</para>
  <para style="q2" vid="PSA 64:3">enyʌñ ewuuk ndiọi ikọ ammọ nte idañ ñkpa.<verse eid="PSA 64:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4" />Ammọ edịbe etop awo ammiidueghe isob;</para>
  <para style="q2" vid="PSA 64:4">ammọ etop usọp-usọp, ndịk ibaaha.<verse eid="PSA 64:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5" />Ammọ esọọñọ emọ-emọ esịd ke ndiọi uduak,</para>
  <para style="q2" vid="PSA 64:5">ammọ eneme ebaña adidịp mme afia ammọ;</para>
  <para style="q2" vid="PSA 64:5">ammọ ebo, “Anie adiikịt se ñnyịn inam?”<verse eid="PSA 64:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6" />Afịd ammọ edioomo ukwañ ikpe enyʌñ ebo,</para>
  <para style="q2" vid="PSA 64:6">“Ñnyịn imidioomo ataa eti uduak!”</para>
  <para style="q2" vid="PSA 64:6">Ke akpanikọ akikere ye esịd awo edo ndudiọ.<verse eid="PSA 64:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7" />Ado Abasi ayaatop ammọ ke mme idañ amọ;</para>
  <para style="q2" vid="PSA 64:7">ayaatịgha ammọ aduọọñọ ke unana idodanyen.<verse eid="PSA 64:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8" />Anye ayaanam edeme ammọ ekappa eta ammọ</para>
  <para style="q2" vid="PSA 64:8">anyʌñ aben ammọ adi ke nsobo;</para>
  <para style="q2" vid="PSA 64:8">afịd mbon se ikịt ammọ eyaesaha enyʌñ enyeeñe iwuod.<verse eid="PSA 64:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9" />Afịd awo eyaekop ndịk;</para>
  <para style="q2" vid="PSA 64:9">ammọ eyaebʌk ubọkutom Abasi</para>
  <para style="q2" vid="PSA 64:9">enyʌñ enekke ekere se anye anam.<verse eid="PSA 64:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10" />Mme ndinen awo eyaedaara ke <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 64:10">enyʌñ edịbe ke anye;</para>
  <para style="q2" vid="PSA 64:10">afịd mbon nti esịd eyaebọ ubọọñ ke anye!<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="cl">Saam 65<note caller="+" style="f"><char style="fr" closed="false">65:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 65:1-13 ewet Saam 65:2-14</char></note></para>
  <para style="d">Ake etubom ikwọ. Saam Defid. Ikwọ.</para>
  <para style="s1">Ake adaiwuod ikwọ. Saam ake Defid. Ikwọ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1" />O Abasi ñnyịn, itooro unie fiin, ke Saiyọn;</para>
  <para style="q2" vid="PSA 65:1">ñnyịn iyaisioño mme akaaña añnyịn ikinamma ye afo.<verse eid="PSA 65:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2" />Sia afo adooho Abasi a-akoppo akam;</para>
  <para style="q2" vid="PSA 65:2">afịd awo eyaedi ubịne fiin.<verse eid="PSA 65:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3" />Ke ini mme idiọọkñkpọ ñnyịn ekisịne ñnyịn ukad</para>
  <para style="q2" vid="PSA 65:3">afo akefeen mme ndudue ñnyịn.<verse eid="PSA 65:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4" />Afọfọn anọ mbon ake afo amekke</para>
  <para style="q2" vid="PSA 65:4">anyʌñ aben akpere nọ edi edidʌñ ke mme akwere mfo!</para>
  <para style="q1" vid="PSA 65:4">Mme nti ñkpọ ufọk mfo iyʌkkọ ñnyịn,</para>
  <para style="q2" vid="PSA 65:4">ye ake adisana tembịd mfo.<verse eid="PSA 65:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5" />Afo ibọọrọ ñnyịn ke uteeñe ye mme ndisana edinam,</para>
  <para style="q2" vid="PSA 65:5">Abasi Andinyaaña ñnyịn,</para>
  <para style="q1" vid="PSA 65:5">idodanyen afịd iso isọñ,</para>
  <para style="q2" vid="PSA 65:5">ye ake mme ñnyọọññkan akpainyañ,<verse eid="PSA 65:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6" />afo a-akebotto mme ikpọabod ke adudu mfo,</para>
  <para style="q2" vid="PSA 65:6">akedatta adudu abana idem mfo<verse eid="PSA 65:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7" />akenamma uyom inyañ adobo,</para>
  <para style="q2" vid="PSA 65:7">uyom mme mbufịd inyañ,</para>
  <para style="q2" vid="PSA 65:7">ye uyom mfịna mme idịd.<verse eid="PSA 65:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8" />Afịd ekondo ayọhọ ye uteeñe ke mme utịppeñkpọ mfo;</para>
  <para style="q2" vid="PSA 65:8">naña ayio asiere ye naña ndubiayio asuuhọ ke ekịm,</para>
  <para style="q2" vid="PSA 65:8">afo anam mme ikwọ idaara eba.<verse eid="PSA 65:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9" />Afo amaakere abaña isọñ anyʌñ anọ anye mmọọñ;</para>
  <para style="q2" vid="PSA 65:9">anam anye anwịm uwak mfịd.</para>
  <para style="q1" vid="PSA 65:9">Mme idịm Abasi eyọhọ ye mmọọñ</para>
  <para style="q2" vid="PSA 65:9">nọ anam abakpa anwịm anọ mme awo,</para>
  <para style="q2" vid="PSA 65:9">sia naña afo akeyem aba adodo.<verse eid="PSA 65:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10" />Afo amedọk isọñ utọinwañ anyʌñ aneeñe mme ebono amọ;</para>
  <para style="q2" vid="PSA 65:10">amenam anye amem ke adiduọk mmọọñ anyʌñ adiọñ mme mfịd amọ;<verse eid="PSA 65:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11" />Afo amaaben akwa mfọn mfo adiọñ isua</para>
  <para style="q2" vid="PSA 65:11">mme ukpad mbiomo mfo eyọhọ ye uwak inie.<verse eid="PSA 65:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12" />Mbid isọñ anaan afịd aboiyo adaña;</para>
  <para style="q2" vid="PSA 65:12">mme ntək abod eyọhọ ye idadesịd.<verse eid="PSA 65:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13" />Mme ufene ewak eyọhọ mme inwañ mbid</para>
  <para style="q2" vid="PSA 65:13">abakpa enwịm eyọhọ mme abedeñ;</para>
  <para style="q2" vid="PSA 65:13">ammọ esio ñkpo idaara enyʌñ ekwọ ikwọ.<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="cl">Saam 66</para>
  <para style="d">Ake etubom Ikwọ. Ikwọ. Saam.</para>
  <para style="s1">Ekwọ Itooro Abasi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1" />Afịd ederimbod, ibọñ ñkpo idaara inọ Abasi!<verse eid="PSA 66:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 66:2" />Ikwọ ubọọñ anyịñ amọ,</para>
  <para style="q2" vid="PSA 66:2">inam itooro amọ ado ñkpọ ubọọñ<verse eid="PSA 66:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3" />Ibo Abasi, “Mme uteeñe mfo enie die ñyọọ!</para>
  <para style="q2" vid="PSA 66:3">Adudu mfo akpon eti-eti,</para>
  <para style="q2" vid="PSA 66:3">anam mme asua mfo ekop ekamba ndịk ke iso mfo.<verse eid="PSA 66:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4" />Afịd ederimbod enʌhọ unọ fiin;</para>
  <para style="q2" vid="PSA 66:4">ammọ ekwọ itooro mfo,</para>
  <para style="q2" vid="PSA 66:4">ammọ ekwọ mme itooro anyịñ mfo.”<verse eid="PSA 66:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5" />Idi inyʌñ idise se Abasi anam,</para>
  <para style="q2" vid="PSA 66:5">se anye anam anọ uduud awo anie ñyọọ!<verse eid="PSA 66:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6" />Anye amaanam inyañ akappa ado nsaad isọñ,</para>
  <para style="q2" vid="PSA 66:6">ammọ emaesaña ke ukod eboiyo inyañ,</para>
  <para style="q2" vid="PSA 66:6">ndufo idi, yak ñnyịn idaara ke anye.<verse eid="PSA 66:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7" />Anye akara ke adudu amọ ke nsi-nsi,</para>
  <para style="q2" vid="PSA 66:7">anyen amọ asʌk ase mme idịd,</para>
  <para style="q2" vid="PSA 66:7">kuuyak mbon nsọñiwuod enam mfịna ye anye.<verse eid="PSA 66:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8" />Yak afịd awo, etooro Abasi ñnyịn</para>
  <para style="q2" vid="PSA 66:8">enam yak ekop uyio itooro amọ;<verse eid="PSA 66:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9" />anye amʌm uwem ñnyịn akama</para>
  <para style="q2" vid="PSA 66:9">inyʌññọ iyak ñkpad ñnyịn afiọnnọ.<verse eid="PSA 66:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10" />Sia afo, Abasi, amaidomo ñnyịn</para>
  <para style="q2" vid="PSA 66:10">afo amaanam ñnyịn isana nte silfa.<verse eid="PSA 66:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11" />Afo amaakoono ñnyịn adọñ ke ñkpakọb iyịre</para>
  <para style="q2" vid="PSA 66:11">amaanyʌñ idot ñnyịn uwak mbiomo ke edem.<verse eid="PSA 66:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12" />Afo amaanam mme awo idọọk ñnyịn iwuod esaña efrọ;</para>
  <para style="q2" vid="PSA 66:12">ñnyịn imaisaña ifrọ ke ikañ ye ke mmọọñ,</para>
  <para style="q2" vid="PSA 66:12">ado afo amaiben ñnyịn asịn ke itie uwak inie.<verse eid="PSA 66:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13" />Ami ñyaaben mme enọ ufọfọb uwa ndọọk ndi ke tembịd mfo</para>
  <para style="q2" vid="PSA 66:13">ñnyʌñ nsioño mme akaaña mmi unọ fiin,<verse eid="PSA 66:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14" />Mme akaaña ake ñkpọkinua mmi akenwọñọke ndin inua mmi akenyʌññọ atañ,</para>
  <para style="q2" vid="PSA 66:14">ke ini ami ñkebaaha ke mfịna.<verse eid="PSA 66:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15" />Ami ñyaawa mme unam se ikpoon unọ fiin</para>
  <para style="q2" vid="PSA 66:15">ye mme enọ akukịmedọñ ñko;</para>
  <para style="q2" vid="PSA 66:15">ami ñyaawa mme ñyaaraenañ ye ebod.<verse eid="PSA 66:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16" />Idi idikop, afịd ndufo se ibaak Abasi;</para>
  <para style="q2" vid="PSA 66:16">yak ami idọkkọ ndufo se anye anam annọọ miin.<verse eid="PSA 66:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17" />Ami ñkeseeme ñkoot anye ke inua mmi;</para>
  <para style="q2" vid="PSA 66:17">itooro amọ akeba ke edeme mmi.<verse eid="PSA 66:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18" />Akpedo mmaanie idiọọkñkpọ ke esịd mmi,</para>
  <para style="q2" vid="PSA 66:18">Abọọñ ikpikikpañña utọñ innọ;<verse eid="PSA 66:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19" />ado ke akpanikọ Abasi akpañ utọñ</para>
  <para style="q2" vid="PSA 66:19">anyʌñ akop akam mmi.<verse eid="PSA 66:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20" />Itooro anie Abasi,</para>
  <para style="q2" vid="PSA 66:20">ammiisịnne akam mmi</para>
  <para style="q2" vid="PSA 66:20">inyʌññọ itre adiñwọt miin ima amọ!<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="cl">Saam 67<note caller="+" style="f"><char style="fr" closed="false">67:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 67:1-7 ewet Saam 67:2-8</char></note></para>
  <para style="d">Ake etubom ikwọ. Ye mme ndido udʌk. Saam. Ikwọ.</para>
  <para style="s1">Edọkkọ Mme Idịd Ete Yak Etooro Abasi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1" />Yak Abasi itua ñnyịn mbọm anyʌñ idiọñ ñnyịn</para>
  <para style="q2" vid="PSA 67:1">anyʌñ anam iso amọ ayamma inọ ñnyịn;<verse eid="PSA 67:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2" />nọ ato do ediọọñọ mme usʌñ mfo ke isọñ,</para>
  <para style="q2" vid="PSA 67:2">enyʌñ ediọọñọ adinyaaña mfo ke atu afịd mme idịd.<verse eid="PSA 67:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3" />Yak mme awo utooro fiin, Abasi;</para>
  <para style="q2" vid="PSA 67:3">yak afịd awo utooro fiin.<verse eid="PSA 67:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4" />Yak mme idịd enem esịd enyʌñ edaara,</para>
  <para style="q2" vid="PSA 67:4">sia afo akaara mme awo ke unen</para>
  <para style="q2" vid="PSA 67:4">anyʌñ adat mme idịd ederimbod usʌñ.<verse eid="PSA 67:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5" />Yak mme awo utooro fiin, Abasi;</para>
  <para style="q2" vid="PSA 67:5">yak afịd awo utooro fiin.<verse eid="PSA 67:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6" />Isọñ anwịm mbunwịm amọ;</para>
  <para style="q2" vid="PSA 67:6">Abasi, Abasi ñnyịn, idiọñ ñnyịn.<verse eid="PSA 67:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7" />Yak Abasi akaiso idiọñ ñnyịn,</para>
  <para style="q2" vid="PSA 67:7">nọ ato do mme utịd ederimbod ebaak anye.<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="cl">Saam 68<note caller="+" style="f"><char style="fr" closed="false">68:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 68:1-35 ewet Saam 68:2-36</char></note></para>
  <para style="d">Ake etubom ikwọ. Ake Defid. Saam. Ikwọ.</para>
  <para style="s1">Abasi Ayaakan Ke Ekọñ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1" />Yak Abasi adakka ada, yak mme asua amọ esuana;</para>
  <para style="q2" vid="PSA 68:1">yak mbon usua amọ efeeñe ke iso amọ.<verse eid="PSA 68:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2" />Afo ayaafuut ammọ asio nte nsʌñikañ,</para>
  <para style="q2" vid="PSA 68:2">nte ndukpe atara ke iso ikañ,</para>
  <para style="q2" vid="PSA 68:2">yak mbon ibak etak ke iso Abasi.<verse eid="PSA 68:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3" />Ado yak ndinen awo enem esịd</para>
  <para style="q2" vid="PSA 68:3">enyʌñ edaara ke iso Abasi;</para>
  <para style="q2" vid="PSA 68:3">yak ammọ enem esịd enyʌñ edaara.<verse eid="PSA 68:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4" />Ikwọ inọ Abasi, ikwọ ke itooro anyịñ amọ,</para>
  <para style="q2" vid="PSA 68:4">ibenne anyịñ amọ ake asañake ke ntọñanyọñ;</para>
  <para style="q2" vid="PSA 68:4">idaara ke iso amọ, anyịñ amọ ado <char style="nd">Abọọñ</char><verse eid="PSA 68:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5" />Anye ado ete anọ nditọakpa, andikpeme mme ebekpa,</para>
  <para style="q2" vid="PSA 68:5">anye ado Abasi ke adisana itie idʌñ amọ,<verse eid="PSA 68:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6" />Abasi anọ mme ikpọọñ ufọkidʌñ;</para>
  <para style="q2" vid="PSA 68:6">anye adat mbon ñkpakọb awuọ ye ikwọ,</para>
  <para style="q2" vid="PSA 68:6">ado anam mbon nsọñiwuod edʌñ ke nsaad isọñ.<verse eid="PSA 68:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7" />Ke ini afo, Abasi, akebemme ikọd mfo iso awuọ,</para>
  <para style="q2" vid="PSA 68:7">ke ini afo akesañake aboiyo ke anaan,<verse eid="PSA 68:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8" />isọñ amaanyeñ, mme hefịn esaana edịm eyaak eduọk,</para>
  <para style="q2" vid="PSA 68:8">ke iso Abasi, Abasi ake Sainai,</para>
  <para style="q2" vid="PSA 68:8">ke iso Abasi, Abasi Isrel.<verse eid="PSA 68:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9" />Afo akenọọ uwak mbara, O Abasi;</para>
  <para style="q2" vid="PSA 68:9">afo amaasọọñọ akpan udeeme mfo idem ke ini mba.<verse eid="PSA 68:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10" />Ikọd mfo emaedʌk edʌñọ ke esịd,</para>
  <para style="q2" vid="PSA 68:10">ndin ato ke uyọhọ mfo, Abasi, afo amaanọ mme uweene ñkpọ.<verse eid="PSA 68:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11" />
    <char style="nd">Abọọñ</char> asuan ikọ,</para>
  <para style="q2" vid="PSA 68:11">ndin ibaan se isuan ikọ esaña ke ekamba udịm:<verse eid="PSA 68:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12" />“Ndidem ye mme udịm ekọñ efeeñe ke usọp;</para>
  <para style="q2" vid="PSA 68:12">mme ibaan se iba ke ufọk edeeme mbịme ekọñ.<verse eid="PSA 68:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13" />Akpọkọm idaha a-ndufo edaiyake ke mme ufọk edọñ,</para>
  <para style="q2" vid="PSA 68:13">mme mba ibiom mmi eyọhọ ye silfa,</para>
  <para style="q2" vid="PSA 68:13">mme ntañ amọ eyọhọ ye nsem-nsem kold.”<verse eid="PSA 68:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14" />Ke ini Andikoñ Ñkan akesuanna mme ndidem ke isọñ,</para>
  <para style="q2" vid="PSA 68:14">akeba nte sino aduọ ke Abod Salmọn.<verse eid="PSA 68:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15" />Abod Basan, abod ubọọñ,</para>
  <para style="q2" vid="PSA 68:15">Abod Basan, akpọsọñ abod,<verse eid="PSA 68:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16" />nsoo inam nọ ase ke isịnanyen, afo akpọsọñ abod,</para>
  <para style="q2" vid="PSA 68:16">abod a-Abasi amekke adida nte itie ukara,</para>
  <para style="q2" vid="PSA 68:16">itie ake <char style="nd">Abọọñ</char> ke idem amọ adiidʌñ ke nsi-nsi?<verse eid="PSA 68:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17" />Mme sariọd Abasi edo mme duob ke mme tọsịn</para>
  <para style="q2" vid="PSA 68:17">enyʌñ edo mme tọsịn ke mme tọsịn;</para>
  <para style="q2" vid="PSA 68:17">
    <char style="nd">Abọọñ</char> amaato ke Sainai adidʌk ke adisana itie amọ.<verse eid="PSA 68:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18" />Ke ini afo amaakedọọk ke anyọñ,</para>
  <para style="q2" vid="PSA 68:18">afo amaasịn uwak awo ukad;</para>
  <para style="q2" vid="PSA 68:18">afo amaabọi mme enọ ato mbon awo,</para>
  <para style="q1" vid="PSA 68:18">ye mbon nsọñiwuod,</para>
  <para style="q2" vid="PSA 68:18">nọ afo, <char style="nd">Abọọñ</char> Abasi, akpedʌñ do.<verse eid="PSA 68:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19" />Yak itooro anie <char style="nd">Abọọñ</char>, Abasi Andinyaaña ñnyịn,</para>
  <para style="q2" vid="PSA 68:19">a-abiommo mbiomo ñnyịn ke usen ke usen.<verse eid="PSA 68:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20" />Abasi ñnyịn ado Abasi ake anyaañake;</para>
  <para style="q2" vid="PSA 68:20">ubọkkọ ke ñkpa ato Abọọñ Andikara.<verse eid="PSA 68:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21" />Ke akpanikọ Abasi ayaanuak iwuod mme asua amọ,</para>
  <para style="q2" vid="PSA 68:21">ye ided-ided etịñiwuod mbon se ikaa iso ke ndiọiñkpọ ammọ.<verse eid="PSA 68:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22" />
    <char style="nd">Abọọñ</char> Abasi abo ate, “Ami ñyaakoono ammọ nto ke Basan ndi;</para>
  <para style="q2" vid="PSA 68:22">Ami ñyaasioño ammọ ke udem inyañ ndi,<verse eid="PSA 68:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23" />nọ ndufo enyiin ñkpad efrọ ke iyiib mme asua ndufo,</para>
  <para style="q2" vid="PSA 68:23">ndin mme edeme ewa ndufo eyaenie udeeme ammọ ñko.”<verse eid="PSA 68:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24" />Mme awo ekịt udịmisañ mfo, O Abasi,</para>
  <para style="q2" vid="PSA 68:24">udịmisañ Abasi mmi ye Adidem esañake ekedʌk adisana itie.<verse eid="PSA 68:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25" />Mbon ikwọ eboiyo iso, mme abre ñkpọ ekeene ammọ;</para>
  <para style="q2" vid="PSA 68:25">ubọikpa e-ebreke ntək ibịdubọk esaña ye ammọ.<verse eid="PSA 68:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26" />Itooro Abasi ke uwak atu awo;</para>
  <para style="q2" vid="PSA 68:26">itooro <char style="nd">Abọọñ</char> ke atu esob nditọ Isrel.<verse eid="PSA 68:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27" />Do ke etək ekpək Benyamin, adat ammọ usʌñ,</para>
  <para style="q2" vid="PSA 68:27">do ñko ke ekamba udịm mbọọñ Yuda,</para>
  <para style="q2" vid="PSA 68:27">mbọọñ ake Sebulọn ye Naftali eba ñko.<verse eid="PSA 68:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28" />Dat adudu mfo, Abasi;</para>
  <para style="q2" vid="PSA 68:28">iwọt ñnyịn adudu mfo, Abasi ñnyịn, naña afo akedak anam.<verse eid="PSA 68:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29" />Ke ntak tembịd mfo ke Yeruselem</para>
  <para style="q2" vid="PSA 68:29">ndidem eyaekoono mme enọ usọk fiin.<verse eid="PSA 68:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30" />Duat ndiọi unam ikọd ke atu ñnyanyaha,</para>
  <para style="q2" vid="PSA 68:30">ye udịm ñyaaraenañ ke atu mme ñyịn enañ mme idịd.</para>
  <para style="q1" vid="PSA 68:30">Ke emaekesuuhọ anye itie, yak idiọọk unam ikọd akoono mme ukwak silfa adi.</para>
  <para style="q2" vid="PSA 68:30">O Abasi, suan mme idịd e-emaaha ekọñ.<verse eid="PSA 68:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31" />Mme isʌñutom eyaeto Iyib edi;</para>
  <para style="q2" vid="PSA 68:31">Kuus eyaedi edinʌhọ enọ Abasi.<verse eid="PSA 68:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32" />Ndufo mme abio ederimbod, ikwọ ikwọ inọ Abasi,</para>
  <para style="q2" vid="PSA 68:32">ikwọ itooro inọ <char style="nd">Abọọñ</char>,<verse eid="PSA 68:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33" />inọ anye a-awatta aboiyo ke mme ñkoññkan hefịn, mme hefịn esed,</para>
  <para style="q2" vid="PSA 68:33">a-aduatta ke akpọsọñ uyio.<verse eid="PSA 68:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34" />Ndufo ikwọrọ adudu Abasi,</para>
  <para style="q2" vid="PSA 68:34">ake ubọọñ uyai amọ adoroke Isrel,</para>
  <para style="q2" vid="PSA 68:34">adudu amọ anyʌññọ aba ke mme hefịn.<verse eid="PSA 68:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35" />Afo, Abasi, amenie uteeñe ke adisana itie mfo;</para>
  <para style="q2" vid="PSA 68:35">Abasi Isrel anọ ikọd amọ adudu ye udịd.</para>
  <para style="b" vid="PSA 68:35" />
  <para style="q1" vid="PSA 68:35">Yak itooro anie Abasi!<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="cl">Saam 69<note caller="+" style="f"><char style="fr" closed="false">69:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 69:1-36 ewet Saam 69:2-37</char></note></para>
  <para style="d">Ake etubom ikwọ. Akeene uyioikwọ “Mme Lili.” Ake Defid.</para>
  <para style="s1">Ekeme Adibuọt Idem Ye Abasi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1" />Ñnyaaña miin, O Abasi,</para>
  <para style="q2" vid="PSA 69:1">sia mmọọñ adọọk adiñwuọ itọñ.<verse eid="PSA 69:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2" />Ami mmebʌhọ ke ntotəño akpʌk,</para>
  <para style="q2" vid="PSA 69:2">i-itie udodukod imiibaaha.</para>
  <para style="q1" vid="PSA 69:2">Ami mmedʌk ke ntəño mmọọñ,</para>
  <para style="q2" vid="PSA 69:2">mmọọñ ukwọ a-akọt amfʌk miin.<verse eid="PSA 69:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3" />Idem ammem ke adibọñ ñkpo ñyem unwam,</para>
  <para style="q2" vid="PSA 69:3">uyio ansịre miin ke itọñ.</para>
  <para style="q1" vid="PSA 69:3">Anyen añkịm miin,</para>
  <para style="q2" vid="PSA 69:3">ke adiyem Abasi mmi.<verse eid="PSA 69:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4" />Mbon se insua miin ke unana ntak</para>
  <para style="q2" vid="PSA 69:4">ewak ekan ided iwuod mmi;</para>
  <para style="q1" vid="PSA 69:4">mbon se insua miin ke unana ntak ewak,</para>
  <para style="q2" vid="PSA 69:4">mbon se iyem adinsobo miin.</para>
  <para style="q1" vid="PSA 69:4">Eñnyịk miin ete yak ami nnọ</para>
  <para style="q2" vid="PSA 69:4">se ami mmeñkeyịppe.<verse eid="PSA 69:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5" />Afo, Abasi, amediọọñọ ndisịme mmi;</para>
  <para style="q2" vid="PSA 69:5">ndudue mmi idịbeke ke iso mfo.<verse eid="PSA 69:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6" />
    <char style="nd">Abọọñ</char> Abasi Andikponñkan,</para>
  <para style="q2" vid="PSA 69:6">kuuyak mbon se idot anyen ke afo</para>
  <para style="q2" vid="PSA 69:6">ekịt asuenne ke ntak mmi;</para>
  <para style="q1" vid="PSA 69:6">O Abasi Isrel,</para>
  <para style="q2" vid="PSA 69:6">kuuyak mbon se uyem fiin</para>
  <para style="q2" vid="PSA 69:6">ekịt abuud ke ntak mmi.<verse eid="PSA 69:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7" />Sia ami mmeyọ ndọk ke ntak mfo,</para>
  <para style="q2" vid="PSA 69:7">abuud anyʌñ afʌk iso mmi.<verse eid="PSA 69:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8" />Ami mmekappa ndo awo asenidịd ke ubon mmi,</para>
  <para style="q2" vid="PSA 69:8">ndo asenawo nnọ mme nditọeka mmi;<verse eid="PSA 69:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9" />akpọsọñ ima ake nnieghe nnọ ufọk mfo iyakka mbọ emem,</para>
  <para style="q2" vid="PSA 69:9">mme usọñanyen ake mbon awo usọññọ fiin enduọññọ miin ke idem,<verse eid="PSA 69:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10" />Ke ini ami ntuaha ayịd ñnyʌñ ntre ndidia,</para>
  <para style="q2" vid="PSA 69:10">ana ami ñyọ emiom;<verse eid="PSA 69:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11" />ke ini ami nsịneke afọñikpo,</para>
  <para style="q2" vid="PSA 69:11">mme awo eben ado ennọ ñnyọọ.<verse eid="PSA 69:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12" />Mbon se itie ke inuaatob ensak miin,</para>
  <para style="q2" vid="PSA 69:12">ndin ami ñnyʌñ ndo ikwọ mbon inaam ukọd.<verse eid="PSA 69:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13" />Ado ami mbọñ akam unọ fiin, <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 69:13">ke ini mfọn mfo;</para>
  <para style="q1" vid="PSA 69:13">ke akwa ima mfo, O Abasi,</para>
  <para style="q2" vid="PSA 69:13">mbọọrọ miin ye nsọọñọnda adinyaaña mfo.<verse eid="PSA 69:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14" />Ñnyaaña miin sio ke akpʌk,</para>
  <para style="q2" vid="PSA 69:14">kuuyak ami mbʌhọ;</para>
  <para style="q1" vid="PSA 69:14">nsio miin ke ubọk mbon se insua miin,</para>
  <para style="q2" vid="PSA 69:14">nsio ke utʌñọ mmọọñ.<verse eid="PSA 69:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15" />Kuuyak mme mmọọñ ukwọ emfʌk miin</para>
  <para style="q2" vid="PSA 69:15">me udem amben amen</para>
  <para style="q2" vid="PSA 69:15">me ube akʌp inua ambaha miin.<verse eid="PSA 69:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16" />
    <char style="nd">Abọọñ</char>, mbọọrọ miin, ke ntak mfọn ima mfo;</para>
  <para style="q2" vid="PSA 69:16">ke akwa mbọm mfo, wọññọ iso nse miin.<verse eid="PSA 69:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17" />Kuudịp awo mfo iso,</para>
  <para style="q2" vid="PSA 69:17">sọp mbọọrọ miin, sia ami mba ke mfịna.<verse eid="PSA 69:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18" />Saña ñkpere nyʌñ mfak miin sio;</para>
  <para style="q2" vid="PSA 69:18">ñkpọk miin yaak mbaak mme asua mmi.<verse eid="PSA 69:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19" />Afo amediọọñọ naña emmiom miin, ensuenne enyʌñ ennọ ndọk;</para>
  <para style="q2" vid="PSA 69:19">afịd mme asua mmi eba ke iso mfo.<verse eid="PSA 69:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20" />Emiom ambuuñ miin esịd</para>
  <para style="q2" vid="PSA 69:20">anyʌñ anam ami mbaaha ufọn aba;</para>
  <para style="q1" vid="PSA 69:20">ami mmaayem mbọm, ado ibaaha ndomokeed,</para>
  <para style="q2" vid="PSA 69:20">ñyem mbon ndọñesịd, ado ñkekịtte ndomokeed.<verse eid="PSA 69:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21" />Ammọ esịn atidod ke ndidia mmi</para>
  <para style="q2" vid="PSA 69:21">enyʌñ ennọ fineka yak ñnwọñ ke nsaditọñ mmi.<verse eid="PSA 69:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22" />Yak akpokoro ndidia idaara ammọ akappa ado afia;</para>
  <para style="q2" vid="PSA 69:22">yak akappa ado idiọọk usiene ye afia anọ ammọ.<verse eid="PSA 69:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23" />Yak anyen akịm ammọ mbaak ammọ edikịt ñkpọ,</para>
  <para style="q2" vid="PSA 69:23">ñko yak edem ammọ anʌhọ ke nsi-nsi.<verse eid="PSA 69:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24" />Nwañña ifiobesịd mfo fʌk ammọ;</para>
  <para style="q2" vid="PSA 69:24">nam ifiobesịd mfo akpịkke ammọ iso.<verse eid="PSA 69:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25" />Yak itie idʌñ ammọ akappa ndoon;</para>
  <para style="q2" vid="PSA 69:25">kuuyak awo aba se idʌñ ke mme atayad ammọ.<verse eid="PSA 69:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26" />Sia ammọ ekọbọ mbon se afo atʌnọ</para>
  <para style="q2" vid="PSA 69:26">enyʌñ etañ ebaña ubiak mbon se afo afioomo.<verse eid="PSA 69:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27" />Dian ndudue ke ndudue nọ ammọ;</para>
  <para style="q2" vid="PSA 69:27">kuuyak ammọ enie ewuana ke adinyaaña mfo.<verse eid="PSA 69:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28" />Yak esọọk anyịñ ammọ esio ke ñwed uwem</para>
  <para style="q2" vid="PSA 69:28">kuuyak ewet esịn ye ake ndinen awo.<verse eid="PSA 69:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29" />Ado amaado ami, ambaaha ke ukuud ye ubiak.</para>
  <para style="q2" vid="PSA 69:29">O Abasi, yak adinyaaña mfo añkpeme miin.<verse eid="PSA 69:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30" />Ami ñyaatooro anyịñ Abasi ke ikwọ</para>
  <para style="q2" vid="PSA 69:30">ñnyʌñ nnọ anye ubọọñ ke ekọọm.<verse eid="PSA 69:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31" />Anyem ayaanem <char style="nd">Abọọñ</char> esịd akan ekamba ayaaraenañ,</para>
  <para style="q2" vid="PSA 69:31">akan ayaaraenañ a-anieghe nnʌk ye mbai.<verse eid="PSA 69:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32" />Mbon uweene eyaekịt enyʌñ enem esịd,</para>
  <para style="q2" vid="PSA 69:32">ndufo mbon se iyem Abasi, yak esịd ndufo akop uko!<verse eid="PSA 69:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33" />
    <char style="nd">Abọọñ</char> akop aseeme mbon unana</para>
  <para style="q2" vid="PSA 69:33">inyʌññọ isịn mbon ñkpakọb amọ ke ndek.<verse eid="PSA 69:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34" />Yak anyọñ mme isọñ etooro anye,</para>
  <para style="q2" vid="PSA 69:34">mme akpainyañ ye afịd se idọñọ ke esịd ammọ,<verse eid="PSA 69:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35" />sia Abasi ayaanyaaña Saiyọn</para>
  <para style="q2" vid="PSA 69:35">anyʌñ amaana abọp mme abio Yuda.</para>
  <para style="q1" vid="PSA 69:35">Do ndin mme awo eyaedʌñọ do enyʌñ edat anye enie;<verse eid="PSA 69:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="PSA 69:36" />Nditọ ikọd Abasi eyaedat anye enie,</para>
  <para style="q2" vid="PSA 69:36">ndin mbon se ima anyịñ amọ eyaedʌñọ do.<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="cl">Saam 70<note caller="+" style="f"><char style="fr" closed="false">70:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 70:1-5 ewet Saam 70:2-6.</char></note></para>
  <para style="d">Ake etubom ikwọ. Ake Defid. Ebeeñe.</para>
  <para style="s1">Abasi Ado Utịbe</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1" />Sọsọp di ñnyaaña miin, O Abasi;</para>
  <para style="q2" vid="PSA 70:1">di usọp-usọp, <char style="nd">Abọọñ</char>, di ñnyaaña miin.<verse eid="PSA 70:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2" />Yak mbon se iyem adidat uwem mmi</para>
  <para style="q2" vid="PSA 70:2">ekịt abuud ye ndutịme;</para>
  <para style="q1" vid="PSA 70:2">yak afịd mbon se iyem nsobo mmi</para>
  <para style="q2" vid="PSA 70:2">etịmme edem enyọñọ ke asuenne.<verse eid="PSA 70:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3" />Yak mbon se insak miin, “Aha! Aha!”</para>
  <para style="q2" vid="PSA 70:3">etịmme edem ke ntak abuud ammọ.<verse eid="PSA 70:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4" />Ado yak afịd awo se uyem fiin</para>
  <para style="q2" vid="PSA 70:4">edaara enyʌñ enem esịd ke afo;</para>
  <para style="q1" vid="PSA 70:4">yak mbon se inie udọñ unwam adinyaaña mfo ebo afịd ini,</para>
  <para style="q2" vid="PSA 70:4">“<char style="nd">Abọọñ</char> Abasi akpon!”<verse eid="PSA 70:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5" />Ado amaado ami, ami ndo uweene ye awo unana;</para>
  <para style="q2" vid="PSA 70:5">mbọk sọsọp di mbịne miin, O Abasi.</para>
  <para style="q1" vid="PSA 70:5">Afo ado unwam mmi ye adinyaaña ami,</para>
  <para style="q2" vid="PSA 70:5">
    <char style="nd">Abọọñ</char>, mbọk kuukpeene.<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="cl">Saam 71</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1" />Ke afo, <char style="nd">Abọọñ</char>, ke ami ndịbe,</para>
  <para style="q2" vid="PSA 71:1">kuuyak ami ndia abuud.<verse eid="PSA 71:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2" />Dat adinenido mfo ñnyaaña miin nyʌñ nam ami mbọkkọ;</para>
  <para style="q2" vid="PSA 71:2">kpañ utọñ mfo nnọ miin nyʌñ ñnyaaña miin.<verse eid="PSA 71:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3" />Do itiad udịbe mmi,</para>
  <para style="q2" vid="PSA 71:3">itie ake ami ñkemeke adika afịd ini;</para>
  <para style="q1" vid="PSA 71:3">nọ ewʌhọ nọ eñnyaaña miin,</para>
  <para style="q2" vid="PSA 71:3">sia afo ado ekamba itiad mmi ye itie ubọkkọ mmi.<verse eid="PSA 71:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4" />Abasi mmi, ñnyaaña miin sio ke ubọk mbon ibak,</para>
  <para style="q2" vid="PSA 71:4">nsio ke ubọk ndiọi awo ye mbon unana esịd mbọm.<verse eid="PSA 71:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5" />Sia afo amaado idodanyen mmi, <char style="nd">Abọọñ</char> Andikara,</para>
  <para style="q2" vid="PSA 71:5">nsọọñidem mmi tọọñọ ke uyịn.<verse eid="PSA 71:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6" />Ami mbuọt idem ke afo tọọñọ ke emana mmi;</para>
  <para style="q2" vid="PSA 71:6">afo akensio miin ke esịd idịb eka mmi.</para>
  <para style="q2" vid="PSA 71:6">Ami ñyautooro fiin ke nsi-nsi.<verse eid="PSA 71:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7" />Ami mmekappa ndo ñkpọ idiọọñọ nnọ uwak awo,</para>
  <para style="q2" vid="PSA 71:7">afo ado akpọsọñ itie udịbe mmi.<verse eid="PSA 71:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8" />Inua mmi ayọhọ ye itooro mfo,</para>
  <para style="q2" vid="PSA 71:8">ami ñyaatañ anwa-anwa mbaña uyai mfo afịd usen.<verse eid="PSA 71:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9" />Kunsaana miin uyaak ke ini usọñ mmi;</para>
  <para style="q2" vid="PSA 71:9">kuñkpọñ miin ke ini inweek mmi akweeñeke.<verse eid="PSA 71:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10" />Sia mme asua mmi itañña eti imbaña miin;</para>
  <para style="q2" vid="PSA 71:10">mbon se itie ibet adiñwot miin edʌk adu.<verse eid="PSA 71:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11" />Ammọ ete, “Abasi amaasịn anye;</para>
  <para style="q2" vid="PSA 71:11">bịne nyʌñ mʌm anye,</para>
  <para style="q2" vid="PSA 71:11">sia ibaaha awo se idiinyaaña anye.”<verse eid="PSA 71:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12" />Abasi mmi, kuñkpọñ miin unyọọñ usʌñ;</para>
  <para style="q2" vid="PSA 71:12">Abasi, sọp di, di ñnyaaña miin<verse eid="PSA 71:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13" />Yak mbon se indot miin uyio etak ke abuud;</para>
  <para style="q2" vid="PSA 71:13">yak mbon eyemme adinnam miin ibak</para>
  <para style="q2" vid="PSA 71:13">eyọhọ ye ndọk ye asuenne.<verse eid="PSA 71:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14" />Amaado ami, ñyaanie idodanyen afịd ini;</para>
  <para style="q2" vid="PSA 71:14">ami ñyaakaaka iso utooro fiin.<verse eid="PSA 71:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15" />Inua mmi ayaabʌk mme ndinen ido mfo,</para>
  <para style="q2" vid="PSA 71:15">mme utom adinyaaña mfo afịd usen,</para>
  <para style="q2" vid="PSA 71:15">akpesʌkado ami ndiidiọọñọke naña ñkpebʌk afịd ammọ.<verse eid="PSA 71:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16" />
    <char style="nd">Abọọñ</char> Andikara, ami ñyaadi ndikwọrọ mme ikpọ adinam mfo.</para>
  <para style="q2" vid="PSA 71:16">Ami ñyaakwọrọ mme ndinen adinam mfo, ake mfo ikpọọñ.<verse eid="PSA 71:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17" />O Abasi, tọọñọ ke uyịn mmi, afo ameñkpeep miin,</para>
  <para style="q2" vid="PSA 71:17">ñko tutu usen mfịn ami ntañ anwa-anwa mbaña mme utịppe adinam mfo.<verse eid="PSA 71:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18" />Akpọkọm ke ini usọñ mmi ye iwad,</para>
  <para style="q2" vid="PSA 71:18">Abasi mmi, kuñkpọñ miin,</para>
  <para style="q1" vid="PSA 71:18">tutu ami mbʌk mbaña adudu mfo nnọ emana mfen,</para>
  <para style="q2" vid="PSA 71:18">mme ikpọ adinam mfo nnọ mbon se idiidi ke ini iso.<verse eid="PSA 71:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19" />O Abasi, adinenido mfo, a-asịm mme hefịn,</para>
  <para style="q2" vid="PSA 71:19">afo a-anamma mme ikpọ ñkpọ</para>
  <para style="q2" vid="PSA 71:19">Anie ubit fiin, O Abasi?<verse eid="PSA 71:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20" />Akpesʌkado afo anamma yak ami ñkịt mme mfịna,</para>
  <para style="q2" vid="PSA 71:20">uwak ye idod,</para>
  <para style="q2" vid="PSA 71:20">afo ayaamaana anam nọ ami ndu uwem;</para>
  <para style="q1" vid="PSA 71:20">afo ayansio miin ke udem esịd isọñ</para>
  <para style="q2" vid="PSA 71:20">a-amaana amben miin adi abod.<verse eid="PSA 71:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21" />Afo ayaadian ukpono annọ miin</para>
  <para style="q2" vid="PSA 71:21">anyʌñ andọñ miin esịd ini keed mfen.<verse eid="PSA 71:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22" />Ami ñyautooro fiin ke ekpa</para>
  <para style="q2" vid="PSA 71:22">ke ntak akpanikọ mfo, Abasi mmi;</para>
  <para style="q1" vid="PSA 71:22">Ami ñyaakwọ itooro unọ fiin ke ndidoudʌk,</para>
  <para style="q2" vid="PSA 71:22">Adisana Abasi Isrel.<verse eid="PSA 71:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23" />Ñkpọkinua mmi ayaabọñ ñkpo idaara</para>
  <para style="q2" vid="PSA 71:23">ke ini ami ñkwọọhọ itooro unọ fiin,</para>
  <para style="q2" vid="PSA 71:23">ami ake afo anyaañake.<verse eid="PSA 71:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24" />Edeme mmi ayaabʌk mme ndinen adinam mfo</para>
  <para style="q2" vid="PSA 71:24">ke afịd usen,</para>
  <para style="q1" vid="PSA 71:24">sia mbon se ikiyem adinnọmọ miin</para>
  <para style="q2" vid="PSA 71:24">ekappa ekịt abuud mme ndutịme.<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="cl">Saam 72</para>
  <para style="d">Ake Sọlọmọn</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1" />O Abasi, nọ adidem mfo unen ikpe,</para>
  <para style="q2" vid="PSA 72:1">nọ ayịn adidem adinenido mfo.<verse eid="PSA 72:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2" />Yak anye akpe ikpe ikọd mfo ke adinenido,</para>
  <para style="q2" vid="PSA 72:2">anọ mbon ñkpọnnam mfo unen.<verse eid="PSA 72:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3" />Yak mme abod eben uforo esọk mbon awo,</para>
  <para style="q2" vid="PSA 72:3">yak ntək abod esịññe mfịd adinenido.<verse eid="PSA 72:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4" />Yak anye akpeme mbon ñkpọnnam</para>
  <para style="q2" vid="PSA 72:4">anyʌñ anyaaña nditọ mbon unana;</para>
  <para style="q2" vid="PSA 72:4">yak anye anyʌñ anuak mbon ufiik.<verse eid="PSA 72:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5" />Yak uteeñe amọ aba akpeene nte utịn,</para>
  <para style="q2" vid="PSA 72:5">akpeene nte afiọñ, ke afịd emana.<verse eid="PSA 72:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6" />Yak anye aba nte edịm a-aduọkkọke ke inwañ e-eketemme mbid,</para>
  <para style="q2" vid="PSA 72:6">nte edịm anọ isọñ mmọọñ.<verse eid="PSA 72:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7" />Yak ndinen awo eforo ke ayio amọ</para>
  <para style="q2" vid="PSA 72:7">uforo anyʌñ akaiso afiọrọ adaña nte afiọñ asʌkkọ aba ke iso isọñ.<verse eid="PSA 72:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8" />Yak anye akara tọọñọ ke akpainyañ keed tutu asịm akpainyañ mfen</para>
  <para style="q2" vid="PSA 72:8">anyʌñ atọọñọ ke Inyañ akewuọ utịd iso isọñ.<verse eid="PSA 72:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9" />Yak mme idịd ke akpautatan etuak iwuod enọ anye</para>
  <para style="q2" vid="PSA 72:9">yak mme asua amọ enyʌñ edai ntọñ.<verse eid="PSA 72:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10" />Yak ndidem Taasis ye ake ñnyan usʌñ</para>
  <para style="q2" vid="PSA 72:10">eben enọ ekọọm esọk anye.</para>
  <para style="q1" vid="PSA 72:10">Yak mme ndidem Seeba ye Seba</para>
  <para style="q2" vid="PSA 72:10">eben mme enọ esọk anye.<verse eid="PSA 72:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11" />Yak afịd mme ndidem etuak iwuod enọ anye</para>
  <para style="q2" vid="PSA 72:11">ñko yak afịd mme idịd enam ñkpọ enọ anye.<verse eid="PSA 72:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12" />Sia anye ayaanyaaña mbon unana se itua iseeme,</para>
  <para style="q2" vid="PSA 72:12">ye mbon ñkpọnnam i-idiinieghe awo se inwam ammọ.<verse eid="PSA 72:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13" />Anye ayaanie mbọm abaña mbon mmemidem ye mbon unana</para>
  <para style="q2" vid="PSA 72:13">anyʌñ anyaaña mbon unana asio ke ñkpa.<verse eid="PSA 72:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14" />Anye ayaanyaaña ammọ asio ke ufiik ye afai,</para>
  <para style="q2" vid="PSA 72:14">sia iyiib ammọ ado ñkpọuto ke iso amọ.<verse eid="PSA 72:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15" />Yak anye adu uwem akpeene!</para>
  <para style="q2" vid="PSA 72:15">Yak enọ anye kold a-atooho Seba.</para>
  <para style="q1" vid="PSA 72:15">Yak mme awo ebọñ akam enọ anye afịd ini</para>
  <para style="q2" vid="PSA 72:15">enyʌñ etooro anye afịd usen.<verse eid="PSA 72:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16" />Yak abakpa anwịm awak ayọhọ afịd isọñ;</para>
  <para style="q2" vid="PSA 72:16">tutu atara afʌk mme anyọñ abod.</para>
  <para style="q1" vid="PSA 72:16">Yak mme mbunwịm efiọọrọ nte Lebanọn</para>
  <para style="q2" vid="PSA 72:16">enyʌñ eseghe nte mbid inwañ.<verse eid="PSA 72:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17" />Yak anyịñ amọ asọọñọ ada ke nsi-nsi;</para>
  <para style="q2" vid="PSA 72:17">yak anye akaiso aba kpa nte naña utịn ayamma.</para>
  <para style="b" vid="PSA 72:17" />
  <para style="q1" vid="PSA 72:17">Ndin eyaediọñ afịd mme idịd ato ke anye,</para>
  <para style="q2" vid="PSA 72:17">ammọ eyaenyʌñ ekoot anye seediọñ.<verse eid="PSA 72:17" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18" />Itooro anie <char style="nd">Abọọñ</char>, Abasi Isrel,</para>
  <para style="q2" vid="PSA 72:18">anye ikpọọñ anam mme utịppe adinam.<verse eid="PSA 72:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19" />Itooro anie ubọọñ anyịñ amọ ke nsi-nsi;</para>
  <para style="q2" vid="PSA 72:19">yak afịd ederimbod ayọhọ ye ubọọñ amọ.</para>
  <para style="qc" vid="PSA 72:19">Amen ye Amen.<verse eid="PSA 72:19" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20" />Ami aben mme akam Defid, ayịn Yesi akesịm utịd.<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms">Ayọhọ ñwed iii</para>
  <para style="mr">
    <ref loc="PSA 73-89">Mme Saam 73–89</ref></para>
  <para style="cl">Saam 73</para>
  <para style="d">Saam ake Asaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1" />Ke akpanikọ Abasi afọn ye Isrel,</para>
  <para style="q2" vid="PSA 73:1">ye mbon se esịd ammọ asana.<verse eid="PSA 73:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2" />Ado amaado ami, ayak etək ñkpad mmi akpaakefiọnnọ;</para>
  <para style="q2" vid="PSA 73:2">etək ayak ukod akpaakemfiọnnọ.<verse eid="PSA 73:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3" />Sia ami mmaafịbe awo ñkịdidem</para>
  <para style="q2" vid="PSA 73:3">ke ini ami ñkekịtte uforo mbon ibak.<verse eid="PSA 73:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4" />Ammọ inieghe mfịna,</para>
  <para style="q2" vid="PSA 73:4">idem ammọ asọñ, ammọ enyʌñ ekop adudu.<verse eid="PSA 73:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5" />Uwak mbiomo uduud awo isịmeke ammọ;</para>
  <para style="q2" vid="PSA 73:5">mme udọñọ uduud awo imʌmmọ ammọ.<verse eid="PSA 73:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6" />Ado anam ammọ ekọñọ ntañidem nte ñkwaitọñ,</para>
  <para style="q2" vid="PSA 73:6">enyʌñ eben abom esịne ke idem ammọ nte afọñ.<verse eid="PSA 73:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7" />Usiọñ esịd ammọ asio ukwaññkpọ adi,</para>
  <para style="q2" vid="PSA 73:7">mme ndiọi akikere esịd ammọ inieghe adaña.<verse eid="PSA 73:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8" />Ammọ esak nsaha, etañ ke esịd ibak;</para>
  <para style="q2" vid="PSA 73:8">ke ntañidem ammọ edịkke awo ye ufiik.<verse eid="PSA 73:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9" />Ammọ enam inua ebaña hefịn,</para>
  <para style="q2" vid="PSA 73:9">edeme ammọ akara ke iso isọñ.<verse eid="PSA 73:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10" />Ke ntoro ikọd ammọ etịmme edikeene ammọ</para>
  <para style="q2" vid="PSA 73:10">enyʌñ enwọñ akpakʌb mmọọñ.<verse eid="PSA 73:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11" />Ndin ammọ ebo ete, “Abasi adiinam die idiọọñọ?</para>
  <para style="q2" vid="PSA 73:11">Nte Andikoñ Ñkan adiọọñọ ñkpọ ndomokeed?”<verse eid="PSA 73:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12" />Ntom ke mbon ibak eba,</para>
  <para style="q2" vid="PSA 73:12">ke afịd ini inieghe se ammọ ekere, ammọ enam utom ukọ inie.<verse eid="PSA 73:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13" />Ke akpanikọ ami nnịm esịd mmi asana ke ikpu-ikpu</para>
  <para style="q2" vid="PSA 73:13">ñnyʌñ ñyie ubọk mmi ke adinenido.<verse eid="PSA 73:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14" />Ami mmebọ ukuud afịd usen,</para>
  <para style="q2" vid="PSA 73:14">afịd ubakusen aben mme ufa ufen adi.<verse eid="PSA 73:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15" />Akpedo ami ñketañ anwa-anwa ntom,</para>
  <para style="q2" vid="PSA 73:15">ami ñkpaakesuuhọ mbuọdidem nditọ mfo.<verse eid="PSA 73:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16" />Ke ini ami ñkenwanake adidiọọñọ afịd ñkpọ ami,</para>
  <para style="q2" vid="PSA 73:16">anye amaanekke amfịna miin<verse eid="PSA 73:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17" />tutu ami ñkedidʌk adisana itie Abasi;</para>
  <para style="q2" vid="PSA 73:17">do ndin ke ami ñkedidiọọñọ utịd uwem ammọ.<verse eid="PSA 73:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18" />Ke akpanikọ afo adot ammọ ke ndọnnọ isọñ;</para>
  <para style="q2" vid="PSA 73:18">anyʌñ anək ammọ yak eduọññọ ke nsobo.<verse eid="PSA 73:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19" />Se naña ammọ etak ke nsobo ke unana idodanyen,</para>
  <para style="q2" vid="PSA 73:19">ndịk akwọọk ammọ aduọñọ afịd-afịd.<verse eid="PSA 73:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20" />Ammọ eba nte ndab ke ini awo ademmeke;</para>
  <para style="q2" vid="PSA 73:20">
    <char style="nd">Abọọñ</char>, afo amaadakka ada,</para>
  <para style="q2" vid="PSA 73:20">afo ayaasịn ammọ ke ndek nte ndukpọñ ñkpọ.<verse eid="PSA 73:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21" />Idaha se esịd mmi akefʌhọ</para>
  <para style="q2" vid="PSA 73:21">sịbidịd mmi akenyʌñ akịt ndutʌhọ,<verse eid="PSA 73:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22" />Ami ñkedo useme ye ndisịme,</para>
  <para style="q2" vid="PSA 73:22">ami ñkedo unam afai ke iso mfo.<verse eid="PSA 73:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23" />Kpayeado, ami mba ye afo afịd ini;</para>
  <para style="q2" vid="PSA 73:23">afo ammʌm miin ke ubọk nnasia mmi.<verse eid="PSA 73:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24" />Afo andat miin usʌñ ke item mfo,</para>
  <para style="q2" vid="PSA 73:24">ndin amaama, afo ayamben miin asịn ke ubọọñ.<verse eid="PSA 73:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25" />Anie ke ami nnie ke hefịn ukan fiin?</para>
  <para style="q2" vid="PSA 73:25">Ñko ederimbod inieghe ñkpọ ndomokeed se ami ñyem ke amaaboiyo ke afo.<verse eid="PSA 73:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26" />Abʌkidem ye esịd mmi ekeme iñyaañ</para>
  <para style="q2" vid="PSA 73:26">ado Abasi ado adudu anọ esịd mmi</para>
  <para style="q2" vid="PSA 73:26">ye udeeme mmi ke nsi-nsi.<verse eid="PSA 73:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27" />Mbon se ukpọñ fiin anyan usʌñ eyaetak;</para>
  <para style="q2" vid="PSA 73:27">afo ayaasobo mbon se idiinamma akpanikọ ye afo.<verse eid="PSA 73:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28" />Ado amaado ami, afọn ami adikpere Abasi.</para>
  <para style="q2" vid="PSA 73:28">Ami mmenam Abọọñ Andikara ado itie udịbe mmi;</para>
  <para style="q2" vid="PSA 73:28">Ami ñyaabʌk mbaña afịd mme adinam mfo.<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="cl">Saam 74</para>
  <para style="d">Saam <char style="tl">maskil</char> ake Asaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1" />O Abasi, nsoo ido nọ afo isịn ñnyịn ke nsi-nsi?</para>
  <para style="q2" vid="PSA 74:1">Nsoo inam nọ iyadesịd mfo asio ufiob ye mme edọñ ake afo abọọhọ?<verse eid="PSA 74:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2" />Toiyo idịd a-afo akedeppe ke ataa anyan ini,</para>
  <para style="q2" vid="PSA 74:2">mbon udeeme mfo, a-afo akefakka,</para>
  <para style="q2" vid="PSA 74:2">Abod Saiyọn, ake afo akedʌññọ.<verse eid="PSA 74:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3" />Wọññọ ñkpad mfo se mme nsi-nsi ñwuudo,</para>
  <para style="q2" vid="PSA 74:3">se afịd nsobo ake mme asua enamma ke adisana itie mfo.<verse eid="PSA 74:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4" />Mbon usua mfo ekuun ke itie afo akesooboke ye ñnyịn;</para>
  <para style="q2" vid="PSA 74:4">ammọ ewuuk ndaaha ammọ do nte mme idiọọñọ.<verse eid="PSA 74:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5" />Ammọ ekenam ñkpọ nte mbon e-ekamake ekịd</para>
  <para style="q2" vid="PSA 74:5">adisiak mfrọ ke esịd mme eto akai.<verse eid="PSA 74:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6" />Ammọ emaebʌñ afịd mme ñkpọ usọ</para>
  <para style="q2" vid="PSA 74:6">ke mme ekịd ye mme akpeti ammọ.<verse eid="PSA 74:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7" />Ammọ emaefọp adisana itie mfo eduọọk ke isọñ;</para>
  <para style="q2" vid="PSA 74:7">ammọ emaesappa itie idʌñ Anyịñ mfo.<verse eid="PSA 74:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8" />Ammọ emaebo ke esịd ammọ “Ñnyịn iyaisobo ammọ ataa afịd-afịd!”</para>
  <para style="q2" vid="PSA 74:8">Ammọ emaefọp afịd itie nte ekesikpono Abasi ke afịd isọñ.<verse eid="PSA 74:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9" />Awo inọọhọ ñnyịn mme idiọọñọ e-etooho Abasi;</para>
  <para style="q2" vid="PSA 74:9">mme prọfed ibaaha aba,</para>
  <para style="q2" vid="PSA 74:9">ndin ibaaha awo ñnyịn ndomokeed se idiọọñọ me ñkpọ ami adiikpeene die.<verse eid="PSA 74:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10" />O Abasi, asua aduusak fiin ikpeene die?</para>
  <para style="q2" vid="PSA 74:10">Nte asua adiisue anyịñ mfo ke nsi-nsi?<verse eid="PSA 74:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11" />Nsoo inam nọ afo adʌt ubọk mfo adat, ubọk nnasia mfo?</para>
  <para style="q2" vid="PSA 74:11">Diañña ubọk mfo ke esịd afọñ mfo nyʌñ sobo ammọ!<verse eid="PSA 74:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12" />Ado Abasi ado Adidem mmi tọọñọ ke usen edem;</para>
  <para style="q2" vid="PSA 74:12">anye aben adinyaaña adi ke ederimbod.<verse eid="PSA 74:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13" />Ado afo akebakka akpainyañ ke adudu mfo,</para>
  <para style="q2" vid="PSA 74:13">afo akebom iwuod mme amọn ke mmọọñ.<verse eid="PSA 74:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14" />Ado afo akenuak mme iwuod idiọọk unam mmọọñ</para>
  <para style="q2" vid="PSA 74:14">anyʌñ aben anye anọ nte ndita ke akpautatan.<verse eid="PSA 74:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15" />Afo akesiak mme idịm ye mme aba mmọọñ;</para>
  <para style="q2" vid="PSA 74:15">anyʌñ anam mme inyañ e-efegheke esat.<verse eid="PSA 74:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16" />Afo anie uweemeayio, akonayio anyʌñ ado ake mfo;</para>
  <para style="q2" vid="PSA 74:16">afo akenam utịn mme afiọñ.<verse eid="PSA 74:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17" />Ado afo akenịm afịd mme adaña ederimbod;</para>
  <para style="q2" vid="PSA 74:17">afo akenam ndaayio mme ukwọedịm.<verse eid="PSA 74:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18" />
    <char style="nd">Abọọñ</char> toiyo naña asua usak fiin,</para>
  <para style="q2" vid="PSA 74:18">naña ndisịme awo asueñ anyịñ mfo.<verse eid="PSA 74:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19" />Kuuyaak uwem ibiom mfo usịn ke ubọk mme afai unam;</para>
  <para style="q2" vid="PSA 74:19">Kuufre uwem ikọd mfo e-ebaaha ke ukuud ke nsi-nsi.<verse eid="PSA 74:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20" />Kpono edioomo mfo,</para>
  <para style="q2" vid="PSA 74:20">sia ñkpad mbon abom eyọhọ ke mme ñkịm-ñkịm itie ke isọñ.<verse eid="PSA 74:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21" />Kuuyak awo se efiik atịmme edem anyọñ ke asuenne;</para>
  <para style="q2" vid="PSA 74:21">yak awo uweene ye awo unana etooro anyịñ mfo.<verse eid="PSA 74:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22" />O Abasi, dakka da, nwana anwan iwuod mfo;</para>
  <para style="q2" vid="PSA 74:22">toiyo naña mme ndisịme awo usak fiin afịd usen.<verse eid="PSA 74:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23" />Kuufre akpọsọñ uyom mme asua mfo,</para>
  <para style="q2" vid="PSA 74:23">ñkpoyo utọk mme asua mfo, asʌkkọ akaka iso adọọk.<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="cl">Saam 75<note caller="+" style="f"><char style="fr" closed="false">75:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 75:1-10 ewet Saam 75:2-11.</char></note></para>
  <para style="d">Ake etubom ikwọ. Akeene uyioikwọ ake “Kuusobo.” Saam ake Asaf. Ikwọ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1" />Ñnyịn imutooro fiin, Abasi,</para>
  <para style="q2" vid="PSA 75:1">ñnyịn imutooro fiin, sia Anyịñ mfo a-akpere;</para>
  <para style="q2" vid="PSA 75:1">mme awo ebʌk ebaña mme utịppe adinam mfo.<verse eid="PSA 75:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2" />Afo abo, “Ami mmek ini ake ami ñkenịmme;</para>
  <para style="q2" vid="PSA 75:2">ami ndo andikpe ikpe ke unen.<verse eid="PSA 75:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3" />Ke ini ederimbod ye mme awo se idʌñ ke esịd enyeeñeke,</para>
  <para style="q2" vid="PSA 75:3">ado ami mmʌm mme abai amọ ñkama.<verse eid="PSA 75:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4" />Ami mmedọkkọ mbon ntañidem mbo, ‘Ikiiduaak inua aba,’</para>
  <para style="q2" vid="PSA 75:4">ñnyʌñ mbo mbon ibak, ‘Ikiidịppe mme nnʌk ndufo.<verse eid="PSA 75:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5" />Ikiidịppe mme nnʌk ndufo ke hefịn;</para>
  <para style="q2" vid="PSA 75:5">ikiinyʌñ itañ ikọ ke edu usọñanyen.’ ”<verse eid="PSA 75:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6" />Awo ndomokeed ibaaha ke usakkautịn me ke usobutịn</para>
  <para style="q2" vid="PSA 75:6">me ke akpautatan a-akemeke adibenne idem amọ.<verse eid="PSA 75:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7" />Ado Abasi akpe abiide:</para>
  <para style="q2" vid="PSA 75:7">anye asuuhọ awo keed, anye adịppe awo mfen.<verse eid="PSA 75:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8" />Kọọb mmọdo asịne ke ubọk <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 75:8">a-ayọhọke ye ukọd a-afịtte efuud e-enyʌññọ ewuak ye mme ñkpadia;</para>
  <para style="q1" vid="PSA 75:8">anye atọkkọ adọñ, ndin afịd mbon ibak ke ederimbod</para>
  <para style="q2" vid="PSA 75:8">enwọñ anye tutu asịm ataa ntak.<verse eid="PSA 75:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9" />Amaado ami, ami ñyaabʌk ami ke nsi-nsi;</para>
  <para style="q2" vid="PSA 75:9">Ami ñyaakwọ itooro nnọ Abasi Yekọb,<verse eid="PSA 75:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10" />abooho, “Ami ñyaakpịkke mme nnʌk afịd mbon ibak,</para>
  <para style="q2" vid="PSA 75:10">ado eyaebenne nnʌk adinen awo ke anyọñ.”<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="cl">Saam 76<note caller="+" style="f"><char style="fr" closed="false">76:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 76:1-12 ewet Saam 76:2-13.</char></note></para>
  <para style="d">Ake etubom ikwọ. Ye mme ndido udʌk. Saam ake Asaf. Ikwọ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1" />Ediọọñọ Abasi ke afịd Yuda;</para>
  <para style="q2" vid="PSA 76:1">anyịñ amọ akpon ke Isrel.<verse eid="PSA 76:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2" />Atayad amọ aba ke Salem,</para>
  <para style="q2" vid="PSA 76:2">itie idʌñ amọ aba ke Saiyọn.<verse eid="PSA 76:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3" />Do ke anye akebʌñ mme idañ e-eketoppo,</para>
  <para style="q2" vid="PSA 76:3">mme atuekọñ ye mme akañkañ, mme ñkpọ unwana ekọñ.<verse eid="PSA 76:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4" />Afo ameyamma ye unwana,</para>
  <para style="q2" vid="PSA 76:4">uyai ubọọñ mfo akpon akan mme ikpọabod e-enieghe uwak unamikọd.<verse eid="PSA 76:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5" />Ebịme mme ñkpọsọñ,</para>
  <para style="q2" vid="PSA 76:5">ammọ edaiya akpatre idab,</para>
  <para style="q1" vid="PSA 76:5">ibaaha awo keed ke atu akpọsọñ mbon ekọñ</para>
  <para style="q2" vid="PSA 76:5">akanna adịppe ubọk amọ.<verse eid="PSA 76:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6" />O Abasi Yekọb, ke adiduat mfo,</para>
  <para style="q2" vid="PSA 76:6">enañmbakara ye sariọd ekọñ esọñ eda.<verse eid="PSA 76:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7" />Afo ikpọọñ ado se ebaak.</para>
  <para style="q2" vid="PSA 76:7">Anie awo akeme adida ke iso mfo ke ini afo ayatta esịd?<verse eid="PSA 76:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8" />Afo aketie ke hefịn anọ ubiideikpe</para>
  <para style="q2" vid="PSA 76:8">ndin isọñ amaakop ndịk anyʌñ adop uyio,<verse eid="PSA 76:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9" />ke ini afo, O Abasi, akedakkake ada adikpe ikpe,</para>
  <para style="q2" vid="PSA 76:9">nọ anyaaña afịd mbon ñkpọnnam ke isọñ.<verse eid="PSA 76:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10" />Ke akpanikọ ifiobesịd mfo ye uduud awo aben itooro unọ fiin,</para>
  <para style="q2" vid="PSA 76:10">ndin mbon se ibọkkọ ifiobesịd mfo edat ukpeebñkpọ.<verse eid="PSA 76:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11" />Ndufo inam mme akaaña inọ <char style="nd">Abọọñ</char> Abasi ndufo inyʌñ isioño ammọ;</para>
  <para style="q2" vid="PSA 76:11">yak afịd mme idịd mbọhọidʌñ</para>
  <para style="q2" vid="PSA 76:11">ekoono mme enọ esọk Anye a-adooho se ebaak.<verse eid="PSA 76:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12" />Anye abʌñ sịbidịd mme andikara;</para>
  <para style="q2" vid="PSA 76:12">mme ndidem ederimbod ebaak anye.<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="cl">Saam 77<note caller="+" style="f"><char style="fr" closed="false">77:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 77:1-20 ewet Saam 77:2-21</char></note></para>
  <para style="d">Ake etubom ikwọ. Ake Yedutun. Ake Asaf. Saam.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1" />Ami mmaabọñ ñkoot Abasi nọ añnyaaña;</para>
  <para style="q2" vid="PSA 77:1">Ami mmaabọñ ñkoot Abasi yak akop uyio mmi.<verse eid="PSA 77:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2" />Ke ini ami ñkebaaha ke ukuud, ami mmaayem iso <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 77:2">ke akonayio ami mmaanyan ubọk, nduọkkọ adudu,</para>
  <para style="q2" vid="PSA 77:2">ami ñkinyʌññọ ñkop idọñesịd.<verse eid="PSA 77:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3" />Ami mmautoiyo fiin, O Abasi, mmaanyʌñ mmịm mmịm ayịd;</para>
  <para style="q2" vid="PSA 77:3">ami mmaakere ke esịd mmi, sịbidịd mmi amaanyʌñ asuuhọ.<verse eid="PSA 77:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4" />Afo amaanam anyen mmi ataba idab;</para>
  <para style="q2" vid="PSA 77:4">mfịna ikiyakka ami nsio uyio.<verse eid="PSA 77:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5" />Ami mmaakere mbaña mme usen edem,</para>
  <para style="q2" vid="PSA 77:5">mme anyan isua ini edem;<verse eid="PSA 77:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6" />Ami mmaatoiyo mme ikwọ mmi ke akonayio.</para>
  <para style="q2" vid="PSA 77:6">Mmaakere ke esịd mmi, ndin sịbidịd mmi</para>
  <para style="q2" vid="PSA 77:6">amaabịp abo:<verse eid="PSA 77:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7" />“Nte <char style="nd">Abọọñ</char> Abasi ayaisịn ke nsi-nsi?</para>
  <para style="q2" vid="PSA 77:7">Nte anye idiiwọttọ mfọn amọ aba?<verse eid="PSA 77:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8" />Nte nsọọñọnda ima amọ asop ke nsi-nsi?</para>
  <para style="q2" vid="PSA 77:8">Nte enwọñọ amọ akpu ke afịd emana?<verse eid="PSA 77:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9" />Nte Abasi afre aditua mbọm?</para>
  <para style="q2" vid="PSA 77:9">Me anye amʌm mbọm amọ akama ke ntak iyadesịd?”<verse eid="PSA 77:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10" />Ndin ami mmaakere mbo nte, “Ami ñyaabeeñe:</para>
  <para style="q2" vid="PSA 77:10">mme isua Andikoñ Ñkan akesioho ubọk nnasia amọ anyan.”<verse eid="PSA 77:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11" />Ami ñyaatoiyo mme edinam <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 77:11">ntoro, ami ñyaatoiyo mme utịppeñkpọ usen edem.<verse eid="PSA 77:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12" />Ami ñyaakere mbaña afịd mme utom mfo</para>
  <para style="q2" vid="PSA 77:12">ñnyʌñ ñkere mbaña afịd ikpọ edinam mfo ke esịd mmi.<verse eid="PSA 77:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13" />Mme usʌñ mfo, Abasi, edo adisana.</para>
  <para style="q2" vid="PSA 77:13">Akee abasi ikpon nte Abasi ñnyịn?<verse eid="PSA 77:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14" />Afo ado Abasi a-anamma mme utịppeñkpọ;</para>
  <para style="q2" vid="PSA 77:14">afo amewọt adudu mfo ke atu mme</para>
  <para style="q2" vid="PSA 77:14">idịd.<verse eid="PSA 77:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15" />Afo amaafak ikọd mfo ke akpọsọñ</para>
  <para style="q2" vid="PSA 77:15">ubọk mfo,</para>
  <para style="q2" vid="PSA 77:15">kpa nditọnditọ Yekọb mme Yosef.<verse eid="PSA 77:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16" />O Abasi, mme mmọọñ emaukịt fiin,</para>
  <para style="q2" vid="PSA 77:16">mme mmọọñ emaukịt fiin ndin edịkke;</para>
  <para style="q2" vid="PSA 77:16">mme udem inyañ emaetəkko.<verse eid="PSA 77:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17" />Ntọñanyọñ emaenwañña mmọọñ edịm eduọk</para>
  <para style="q2" vid="PSA 77:17">mme hefịn emaeyomo ye aduma;</para>
  <para style="q2" vid="PSA 77:17">mme idañ mfo emaefeeñe iso ye edem.<verse eid="PSA 77:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18" />Emaekop uyom aduma mfo ke idio,</para>
  <para style="q2" vid="PSA 77:18">akebkeb mfo amaanọ ederimbod unwana;</para>
  <para style="q2" vid="PSA 77:18">isọñ amaatịmede anyʌñ anyeñ.<verse eid="PSA 77:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19" />Akpọusʌñ mfo amaasaña akefrọ ke ufọọd akpainyañ,</para>
  <para style="q2" vid="PSA 77:19">usʌñ mfo amaasaña aboiyo ke ikpọ mmọọñ,</para>
  <para style="q2" vid="PSA 77:19">akpesʌkado awo imikikịtte mbọn ikpad mfo.<verse eid="PSA 77:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20" />Afo akedat ikọd mfo usʌñ nte udịm ufene</para>
  <para style="q2" vid="PSA 77:20">ke ubọk Moses ye Erọn.<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="cl">Saam 78</para>
  <para style="d">Saam <char style="tl">maskil</char> ake Asaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1" />Ikọd mmi, ikop ukpeebñkpọ mmi;</para>
  <para style="q2" vid="PSA 78:1">ikpan utọñ inọ ikọ inua mmi.<verse eid="PSA 78:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2" />Ami ñyaatat inua mmi ye ñke;</para>
  <para style="q2" vid="PSA 78:2">Ami ñyaatañ mme ndedịbe ñkpọ, mme ñkpọ ake esed,<verse eid="PSA 78:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3" />Mme ñkpọ se ñnyịn ikikop inyʌñ idiọọñọ,</para>
  <para style="q2" vid="PSA 78:3">mme ñkpọ se mme eteete ñnyịn emaekidọkkọ ñnyịn.<verse eid="PSA 78:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4" />Ñnyịn idiidịppe mme nditọnditọ ammọ;</para>
  <para style="q2" vid="PSA 78:4">ñnyịn iyaitañ inọ emana ini iso</para>
  <para style="q1" vid="PSA 78:4">mme adinam <char style="nd">Abọọñ</char> Abasi a-adotto itooro,</para>
  <para style="q2" vid="PSA 78:4">adudu amọ, ye mme utịppeñkpọ se anye akenam.<verse eid="PSA 78:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5" />Anye amaawuuk ewʌhọ anọ Yekọb</para>
  <para style="q2" vid="PSA 78:5">anyʌñ anịm mbed ke Isrel,</para>
  <para style="q1" vid="PSA 78:5">ake anye aketemmeke mme eteete ñnyịn</para>
  <para style="q2" vid="PSA 78:5">yak ekpeep nditọ ammọ,<verse eid="PSA 78:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6" />nọ emana mfen ediọọñọ ñko,</para>
  <para style="q2" vid="PSA 78:6">kpa nditọ idiimanake diin,</para>
  <para style="q2" vid="PSA 78:6">ndin ammọ ke idem ammọ eyaetañ enọ nditọ ammọ.<verse eid="PSA 78:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7" />Ndin ammọ eyaenie mbuọdidem ke Abasi</para>
  <para style="q2" vid="PSA 78:7">idiinyʌññọ ifre mme edinam amọ</para>
  <para style="q2" vid="PSA 78:7">ado enịm mme ewʌhọ amọ.<verse eid="PSA 78:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8" />Ammọ idiibaaha nte mme eteete ammọ,</para>
  <para style="q2" vid="PSA 78:8">emana nsọñiwuod mme mfịna,</para>
  <para style="q1" vid="PSA 78:8">ake esịd ammọ imiikiinamma akpanikọ ye Abasi,</para>
  <para style="q2" vid="PSA 78:8">ake mme sịbidịd ammọ imiikisọññọ ida ye anye.<verse eid="PSA 78:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9" />Ideen mbon Ifrem, akpesʌkado emaekekama utịgha,</para>
  <para style="q2" vid="PSA 78:9">emaekpaedem ke usen anwan;<verse eid="PSA 78:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10" />ammọ ikinịmme edioomo Abasi</para>
  <para style="q2" vid="PSA 78:10">ikinyʌññọ isaña ke mbed amọ.<verse eid="PSA 78:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11" />Ammọ emaefre se anye akenam,</para>
  <para style="q2" vid="PSA 78:11">mme utịppeñkpọ se anye akewọt ammọ.<verse eid="PSA 78:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12" />Anye amaanam mme utịppeñkpọ ke iso mme ikaan ammọ</para>
  <para style="q2" vid="PSA 78:12">ke isọñ Iyib, ke idịd ñkañ Soan.<verse eid="PSA 78:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13" />Anye amaabakka akpainyañ anyʌñ adat ammọ usʌñ aboiyo;</para>
  <para style="q2" vid="PSA 78:13">anye amaanam mmọọñ adakka ada nte ndibene.<verse eid="PSA 78:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14" />Anye amaakama ntọñanyọñ adat ammọ usʌñ ke uweemeayio</para>
  <para style="q2" vid="PSA 78:14">anyʌñ akama unwana ikañ ke akonayio.<verse eid="PSA 78:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15" />Anye amaasiak mme ikpọitiad ke anaan</para>
  <para style="q2" vid="PSA 78:15">anyʌñ anọ ammọ mmọọñ a-awakka nte mmọọñ akpainyañ;<verse eid="PSA 78:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16" />anye amaanam mme idịm esakka ewuọ ke abaitiad</para>
  <para style="q2" vid="PSA 78:16">anyʌñ anam mmọọñ afeghe nte mme inyañ.<verse eid="PSA 78:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17" />Ado ammọ emaenenekke enam idiọọkñkpọ,</para>
  <para style="q2" vid="PSA 78:17">esọñ iwuod ye Andikoñ Ñkan ke anaan.<verse eid="PSA 78:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18" />Ammọ emaekokoi edomo Abasi idomo</para>
  <para style="q2" vid="PSA 78:18">ke edibịp ndidia ake ammọ eyemme.<verse eid="PSA 78:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19" />Ammọ emaetañ idiọọk ikọ edian Abasi;</para>
  <para style="q2" vid="PSA 78:19">ammọ ekebo ete, “Nte Abasi a-akeme</para>
  <para style="q2" vid="PSA 78:19">adibịt akpokoro ke anaan?<verse eid="PSA 78:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20" />Ado akpanikọ ke anye amaamia itiad,</para>
  <para style="q2" vid="PSA 78:20">ndin mmọọñ amaatop awuọ,</para>
  <para style="q2" vid="PSA 78:20">mmọọñ amaafeghe awuọ awak,</para>
  <para style="q1" vid="PSA 78:20">ado nte anye akeme inyʌñ inọọ ñnyịn uyio?</para>
  <para style="q2" vid="PSA 78:20">Nte anye akeme adinọ mbon amọ unam?”<verse eid="PSA 78:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21" />Ke ini <char style="nd">Abọọñ</char> akekoppo ami, anye amaayat esịd;</para>
  <para style="q2" vid="PSA 78:21">ikañ amọ amaabịppe abaña Yekọb</para>
  <para style="q2" vid="PSA 78:21">ifiobesịd amọ amaanyʌñ adọọk abịne Isrel,<verse eid="PSA 78:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22" />sia ammọ ikinịmme Abasi ke akpanikọ</para>
  <para style="q2" vid="PSA 78:22">ikiinyʌññọ ibuọt idem ke adinyaaña amọ.<verse eid="PSA 78:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23" />Ado anye amaanọ mme ikpaanyọñ uyio;</para>
  <para style="q2" vid="PSA 78:23">anyʌñ akʌkkọ udọk mme hefịn;<verse eid="PSA 78:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24" />anye amaanam mana adep anọ ikọd amọ yak edia,</para>
  <para style="q2" vid="PSA 78:24">anye amaanọ ammọ abakpa ake hefịn.<verse eid="PSA 78:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25" />Mme awo emaedia ndidia ake mme enyere;</para>
  <para style="q2" vid="PSA 78:25">anye amaanọ ammọ afịd ndidia se ammọ ekekan adidia.<verse eid="PSA 78:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26" />Anye amaatat afịm a-atooho usakkautịn ke mme hefịn asuan</para>
  <para style="q2" vid="PSA 78:26">anyʌñ akama adudu amọ anam afịm usuuk afịme.<verse eid="PSA 78:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27" />Anye amaanam unam adep aduọkkọ ammọ ke idem nte ntọñ,</para>
  <para style="q2" vid="PSA 78:27">anyʌñ anam mme inuen eyọhọ nte ntan ke mben esʌk.<verse eid="PSA 78:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28" />Anye amaanam mme ñkpọ ami edʌk ebịne ammọ ke itie nnaaekọñ ammọ,</para>
  <para style="q2" vid="PSA 78:28">ekanna mme atayad ammọ ekʌk.<verse eid="PSA 78:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29" />Ammọ emaedia tutu ebọ uyʌkkọ;</para>
  <para style="q2" vid="PSA 78:29">anye amaanọ ammọ se ikidọñ ammọ itọñ.<verse eid="PSA 78:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30" />Ado mbemiso ammọ ekweeñe se ikidọñ ammọ itọñ,</para>
  <para style="q2" vid="PSA 78:30">kpa ke idaha ndidia asʌkkọ adọñọ ammọ ke inua,<verse eid="PSA 78:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31" />iyadesịd Abasi amaabịmme ye ammọ;</para>
  <para style="q2" vid="PSA 78:31">anye amaawot ataa ñkpọsọñ awo ke atu ammọ,</para>
  <para style="q2" vid="PSA 78:31">akpook ñkparawa Isrel aduọọñọ.<verse eid="PSA 78:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32" />Ke afịd ami, ammọ ekesʌk ekaka iso enam idiọọkñkpọ</para>
  <para style="q2" vid="PSA 78:32">ke afịd mme utịppeñkpọ amọ, ammọ ikinịmme Abasi ke akpanikọ.<verse eid="PSA 78:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33" />Ndin anye amaatre usen ammọ ke ikpu-ikpu</para>
  <para style="q2" vid="PSA 78:33">ye mme isua ammọ ke ndịk.<verse eid="PSA 78:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34" />Ini akeedodo Abasi akewotto ammọ, ammọ emaeyem iso amọ;</para>
  <para style="q2" vid="PSA 78:34">ammọ emaetịmme edem usọp-usọp emaana ebịne anye.<verse eid="PSA 78:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35" />Ammọ emaetoiyo ke Abasi akedo Itiad ammọ,</para>
  <para style="q2" vid="PSA 78:35">ke Abasi Andikoñ Ñkan akedo Andifak ammọ.<verse eid="PSA 78:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36" />Ado ammọ ekesitiik anye ke ñkpọkinua,</para>
  <para style="q2" vid="PSA 78:36">esʌhọ nsu enọ anye ke edeme ammọ;<verse eid="PSA 78:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37" />esịd ammọ ikisọññọ ida mme anye,</para>
  <para style="q2" vid="PSA 78:37">ammọ ikinamma akpanikọ ke edioomo amọ.<verse eid="PSA 78:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38" />Ado anye akesʌk anenie mbọm;</para>
  <para style="q2" vid="PSA 78:38">anye amaafeen ndudue ammọ</para>
  <para style="q2" vid="PSA 78:38">ikinyʌññọ isobo ammọ.</para>
  <para style="q1" vid="PSA 78:38">Ke ini ke ini anye amaamʌm iyadesịd amọ akama</para>
  <para style="q2" vid="PSA 78:38">ikinyʌññọ ibịmme ataa iyadesịd amọ.<verse eid="PSA 78:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39" />Anye amaatoiyo ke ammọ ekedo kpa abʌk,</para>
  <para style="q2" vid="PSA 78:39">afịm a-adooho amaafrọ itịmmeke aba idi.<verse eid="PSA 78:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40" />Ñke mfañ ke ammọ imiikitọọñọke nsọñiwuod</para>
  <para style="q2" vid="PSA 78:40">ye anye ke anaan</para>
  <para style="q2" vid="PSA 78:40">enyʌñ ebuuñ anye esịd ke mbiadaisọñ!<verse eid="PSA 78:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41" />Kwa ini kwa ini ammọ emaedomo Abasi idomo,</para>
  <para style="q2" vid="PSA 78:41">ammọ enọ Adisana Abasi Isrel ifiobesịd.<verse eid="PSA 78:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42" />Ammọ ikitoiyoke adudu amọ,</para>
  <para style="q2" vid="PSA 78:42">ke usen anye akefakka ammọ ke ubọk asua,<verse eid="PSA 78:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43" />usen anye akewọttọ mme idiọọñọ amọ ke Iyib</para>
  <para style="q2" vid="PSA 78:43">mme utịppeñkpọ amọ ke idịd Soan.<verse eid="PSA 78:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44" />Anye amaanam akpainyañ ammọ akappa iyiib;</para>
  <para style="q2" vid="PSA 78:44">ammọ ikikanna inwọñ mmọọñ idịm ammọ.<verse eid="PSA 78:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45" />Anye amaadọñ mme udịm nsʌñ nọ</para>
  <para style="q2" vid="PSA 78:45">eketaañ ammọ ewot,</para>
  <para style="q2" vid="PSA 78:45">ye mme mfuọd ekesoboke ammọ.<verse eid="PSA 78:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46" />Anye amaasịn ataktak nọ ata ñkpọ inwañ ammọ</para>
  <para style="q2" vid="PSA 78:46">ñko ñkukuñkpọyọriyọ amaabiat ñkpọ idọk ammọ.<verse eid="PSA 78:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47" />Anye amaadat edịmitiad asobo fain ammọ</para>
  <para style="q2" vid="PSA 78:47">mme eto fik-sikamọ ammọ ye ndedeñ.<verse eid="PSA 78:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48" />Anye amaakappa mme enañ ammọ anọ edịmitiad,</para>
  <para style="q2" vid="PSA 78:48">ndin anọ ufene ammọ aduma ikañ.<verse eid="PSA 78:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49" />Anye amaanwañña ufiob iyadesịd amọ afʌk ammọ,</para>
  <para style="q2" vid="PSA 78:49">ifiobesịd, ikpakkaesịd ye ndutịme,</para>
  <para style="q2" vid="PSA 78:49">udịm mme enyere nsobo.<verse eid="PSA 78:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50" />Anye amaadiọñ usʌñ anịm anọ iyadesịd amọ;</para>
  <para style="q2" vid="PSA 78:50">anye ikifakka uwem ammọ isio ke ñkpañña</para>
  <para style="q2" vid="PSA 78:50">ado amaayaak ammọ anọ idiọọk udọñọ.<verse eid="PSA 78:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51" />Anye amaawot afịd mme akpan ke Iyib,</para>
  <para style="q2" vid="PSA 78:51">mme akpa mfịd awodeen ke mme atayad Ham.<verse eid="PSA 78:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52" />Ado anye amaakoono ikọd amọ asio nte udịmedọñ;</para>
  <para style="q2" vid="PSA 78:52">anye amaadat ammọ usʌñ nte mme edọñ ewuọ ke anaan.<verse eid="PSA 78:52" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53" />Anye amaadat ammọ usʌñ ke ifuuro, ndin ammọ ikinieghe ndịk;</para>
  <para style="q2" vid="PSA 78:53">ado akpainyañ amaakọt afʌk mme asua ammọ.<verse eid="PSA 78:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54" />Ndin anye amaaben ammọ akewuọ adaña adisana isọñ amọ,</para>
  <para style="q2" vid="PSA 78:54">idʌñ etəkabod ake ubọk nnasia ammọ akebọọhọ.<verse eid="PSA 78:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55" />Anye amaabịne mme idịd asịññe ke iso ammọ</para>
  <para style="q2" vid="PSA 78:55">anyʌñ abaaña mme isọñ mbon ado anọ ammọ nte asaña-asaña udeeme ammọ;</para>
  <para style="q1" vid="PSA 78:55">ñko anye amaanam mme esiin Isrel edʌñ ke mme ufọk ammọ.<verse eid="PSA 78:55" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56" />Ado ammọ emaedomo Abasi idomo</para>
  <para style="q2" vid="PSA 78:56">enyʌñ esọñ iwuod ye Andikoñ Ñkan;</para>
  <para style="q2" vid="PSA 78:56">ammọ ikinịmme mme ewʌhọ amọ.<verse eid="PSA 78:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57" />Ammọ emaetre utọñ enyʌñ enana mbuọdidem nte mme eteete ammọ,</para>
  <para style="q2" vid="PSA 78:57">idooho se enie idodanyen nte idiọọk utịgha.<verse eid="PSA 78:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58" />Ammọ emaeyat Abasi esịd ato ke mme akpokoro uwa ammọ;</para>
  <para style="q2" vid="PSA 78:58">ammọ emaedịppe ufịb Abasi ato mme nsu-nsu abasi ammọ.<verse eid="PSA 78:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59" />Abasi amaanekke ayat esịd, akekop se ammọ etañ;</para>
  <para style="q2" vid="PSA 78:59">anye amaakanna edem afịd-afịd awọt Isrel.<verse eid="PSA 78:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60" />Anye amaasịn tabanakịd amọ ke Silo,</para>
  <para style="q2" vid="PSA 78:60">atayad ake anye akenamma anịm ke ufọọd mme awo.<verse eid="PSA 78:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61" />Anye amaadọñ akebe edioomo adudu amọ akaa ñkọbntem,</para>
  <para style="q2" vid="PSA 78:61">asịn ñkpọ uyai amọ ke ubọk mme asua.<verse eid="PSA 78:61" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62" />Anye amaanọ ikọd amọ yak ekpañña ke akañkañ;</para>
  <para style="q2" vid="PSA 78:62">anye amaayat esịd ye akpan udeeme amọ.<verse eid="PSA 78:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63" />Ikañ amaata ñkparawa ammọ,</para>
  <para style="q2" vid="PSA 78:63">ndin ubọikpa ammọ ikinieghe mme ikwọ ndọ;<verse eid="PSA 78:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64" />akañkañ amaasobo mme aku ammọ,</para>
  <para style="q2" vid="PSA 78:64">ndin mme ebekpa ammọ ikikanna itua ayịd.<verse eid="PSA 78:64" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65" />Ndin <char style="nd">Abọọñ</char> amaademme nte akedaadaiya,</para>
  <para style="q2" vid="PSA 78:65">nte awo ekọñ ademme ke idab inaam ukọd.<verse eid="PSA 78:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66" />Anye amaakan mme asua amọ,</para>
  <para style="q2" vid="PSA 78:66">anye amaasịn ammọ ke nsi-nsi abuud.<verse eid="PSA 78:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67" />Ke ntoro anye amaasịn mme atayad Yosef</para>
  <para style="q2" vid="PSA 78:67">anye ikimekke esiin Ifrem;<verse eid="PSA 78:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68" />ado anye amaamek esiin Yuda,</para>
  <para style="q2" vid="PSA 78:68">Abod Saiyọn, a-anye akemaaha.<verse eid="PSA 78:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69" />Anye amaabọp adisana itie amọ nte ñkoñ-ñkoñ anyọñ,</para>
  <para style="q2" vid="PSA 78:69">ukem nte ederimbod ake anye akenamma anịm ke nsi-nsi.<verse eid="PSA 78:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70" />Anye amaamek Defid ayịnufọk amọ</para>
  <para style="q2" vid="PSA 78:70">anyʌñ asio anye ke atu mme abaedọñ;<verse eid="PSA 78:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71" />akeben anye akpọñ adikpeme mme edọñ</para>
  <para style="q1" vid="PSA 78:71">nọ adido andikpeme edọñ ufọk Yekọb,</para>
  <para style="q2" vid="PSA 78:71">ake Isrel asaña-asaña udeeme amọ.<verse eid="PSA 78:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72" />Ñko Defid amaabọọk ammọ ke esịd akpanikọ;</para>
  <para style="q2" vid="PSA 78:72">amaadat ammọ usʌñ ke ubọk ikike.<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="cl">Saam 79</para>
  <para style="d">Saam ake Asaf</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1" />O Abasi, mme idịd ebom edʌk asaña-asaña udeeme mfo;</para>
  <para style="q2" vid="PSA 79:1">ammọ esappa adisana tembịd mfo,</para>
  <para style="q2" vid="PSA 79:1">ammọ esuuhọ Yeruselem enịm ke mbio.<verse eid="PSA 79:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2" />Ammọ ekpọñ akpo mme isʌñutom mfo</para>
  <para style="q2" vid="PSA 79:2">enịm nte ndita enọ mme inuen anyọñ,</para>
  <para style="q2" vid="PSA 79:2">abʌkidem ikọd mfo enọ mme unam ikọd.<verse eid="PSA 79:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3" />Ammọ eduọk iyiib nte mmọọñ</para>
  <para style="q2" vid="PSA 79:3">ekanna afịd Yeruselem ekʌk,</para>
  <para style="q2" vid="PSA 79:3">awo inyʌññọ iba se ibuuk mme akpañkpa.<verse eid="PSA 79:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4" />Ñnyịn idoñño ñkpọ emiom inọ mme mbọhọidʌñ ñnyịn,</para>
  <para style="q2" vid="PSA 79:4">idoñño ñkpọ nsaha ye asuenne inọ ñkanñkʌk.<verse eid="PSA 79:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5" />Adiikpeene die, <char style="nd">Abọọñ</char>? Afo uduuyat esịd ke nsi-nsi?</para>
  <para style="q2" vid="PSA 79:5">Ufịb mfo adiisak nte ikañ ikpeene die?<verse eid="PSA 79:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6" />Nwañña ifiobesịd mfo fʌk mme idịd</para>
  <para style="q2" vid="PSA 79:6">i-imuunyịmmeke fiin,</para>
  <para style="q1" vid="PSA 79:6">fʌk mme abioubọọñ</para>
  <para style="q2" vid="PSA 79:6">i-imiikoodo anyịñ mfo;<verse eid="PSA 79:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7" />sia ammọ emaesobo Yekọb</para>
  <para style="q2" vid="PSA 79:7">emaenyʌñ ebiat itie idʌñ amọ.<verse eid="PSA 79:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8" />Kuuben mme idiọọkñkpọ ake emana esed udot ñnyịn ke idem;</para>
  <para style="q2" vid="PSA 79:8">yak mbọm mfo adisịme ñnyịn usọp-usọp,</para>
  <para style="q2" vid="PSA 79:8">sia ñnyịn iminekke iyem unwam eti-eti.<verse eid="PSA 79:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9" />Inwam ñnyịn, Abasi Andinyaaña ñnyịn,</para>
  <para style="q2" vid="PSA 79:9">ke ntak ubọọñ anyịñ mfo;</para>
  <para style="q1" vid="PSA 79:9">fak ñnyịn sio nyʌñ feen mme idiọọkñkpọ ñnyịn</para>
  <para style="q2" vid="PSA 79:9">ke ntak anyịñ mfo.<verse eid="PSA 79:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10" />Mme idịd ekpenam die ebo ete,</para>
  <para style="q2" vid="PSA 79:10">“Mmọ Abasi ammọ?”</para>
  <para style="b" vid="PSA 79:10" />
  <para style="q1" vid="PSA 79:10">Nam ediọọñọ ke atu mme idịd, ke iso ñnyịn</para>
  <para style="q2" vid="PSA 79:10">ke afo amesio usiene iyiib ikọd mfo eduọkkọ.<verse eid="PSA 79:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11" />Yak mmịm mbon ñkpakọb edọọk edi ke iso mfo;</para>
  <para style="q2" vid="PSA 79:11">dat akpọsọñ ubọk mfo nyaaña mbon se emaekebiere ikpe ñkpa enọ.<verse eid="PSA 79:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12" />
    <char style="nd">Abọọñ</char>, sio usiene emiom ake mbọhọidʌñ ñnyịn unọọhọ fiin,</para>
  <para style="q2" vid="PSA 79:12">yaak dot ke ikpanesịd ammọ utịme itiaba.<verse eid="PSA 79:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13" />Ndin ñnyịn, ikọd mfo, mme edọñ ake afo abọọhọ,</para>
  <para style="q2" vid="PSA 79:13">iyautooro fiin ke nsi-nsi;</para>
  <para style="q1" vid="PSA 79:13">tọọñọ ke emana keed tutu emana asịm mfen,</para>
  <para style="q2" vid="PSA 79:13">iyaibʌk itooro mfo anwa-anwa.<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="cl">Saam 80<note caller="+" style="f"><char style="fr" closed="false">80:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 80:1-19 ewet Saam 80:2-20</char></note></para>
  <para style="d">Ake etubom ikwọ. Akeene uyioikwọ ake “Mme lili Edioomo.” Ake Asaf. Saam.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1" />O Akpemeedọñ Isrel, kop uyio ñnyịn,</para>
  <para style="q2" vid="PSA 80:1">afo a-adatta Yosef usʌñ nte udịmedọñ.</para>
  <para style="q1" vid="PSA 80:1">Afo a-atieghe ke ebekpo ke ufọọd mme serubim,</para>
  <para style="q2" vid="PSA 80:1">yamma wuọ <verse eid="PSA 80:1" /><verse number="2" style="v" sid="PSA 80:2" />ke iso Ifrem, Benyamin ye Manase.</para>
  <para style="q1" vid="PSA 80:2">Demme uko mfo;</para>
  <para style="q2" vid="PSA 80:2">Di, nyʌñ inyaaña ñnyịn.<verse eid="PSA 80:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3" />O Abasi, maana inọ ñnyịn adudu;</para>
  <para style="q2" vid="PSA 80:3">yak iso mfo ayamma inọ ñnyịn,</para>
  <para style="q2" vid="PSA 80:3">yak ñnyịn ibọ adinyaaña.<verse eid="PSA 80:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4" />
    <char style="nd">Abọọñ</char> Abasi Andikponñkan,</para>
  <para style="q2" vid="PSA 80:4">iyadesịd mfo adiiduuñọ ikpeene die</para>
  <para style="q2" vid="PSA 80:4">nọ afo uduukoppo akam ikọd mfo?<verse eid="PSA 80:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5" />Afo amenọ ammọ uyo mmọọñayịd,</para>
  <para style="q2" vid="PSA 80:5">afo amenam ammọ enwọñ mmọọñayịd ke ayọhọ ntəño usan.<verse eid="PSA 80:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6" />Afo amenam ñnyịn ido ñkpọ nsaha inọ mme mbọhọidʌñ ñnyịn,</para>
  <para style="q2" vid="PSA 80:6">mme asua ñnyịn enyʌñ iduọi ñnyịn.<verse eid="PSA 80:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7" />Maana inọ ñnyịn adudu, Abasi Andikponñkan;</para>
  <para style="q2" vid="PSA 80:7">yak iso mfo ayamma inọ ñnyịn,</para>
  <para style="q2" vid="PSA 80:7">nọ ñnyịn ibọ adinyaaña.<verse eid="PSA 80:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8" />Afo amaawịppe fain ato Iyib;</para>
  <para style="q2" vid="PSA 80:8">afo amaabiiñe mme idịd asioño anyʌñ atọ anye.<verse eid="PSA 80:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9" />Afo amaatem isọñ anọ anye,</para>
  <para style="q2" vid="PSA 80:9">anye amaasio adʌñ anyʌñ atara ayọhọ isọñ.<verse eid="PSA 80:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10" />Ndeeñ amọ amaafuuk mme ikpọabod,</para>
  <para style="q2" vid="PSA 80:10">mme ikpọ eto sida ye mme ñkọk amọ.<verse eid="PSA 80:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11" />Mme ñkọk amọ emaenyọọñ ekewuọ Akpainyañ,</para>
  <para style="q2" vid="PSA 80:11">mme ñkam amọ emaekesịm Inyañ.<verse eid="PSA 80:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12" />Nsoo inam nọ afo awuut mme ndibene amọ</para>
  <para style="q2" vid="PSA 80:12">anam afịd awo se ifrọ ke usʌñ ekịp kreb amọ?<verse eid="PSA 80:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13" />Mme ñyaaraedi eto ke akai ewai anye,</para>
  <para style="q2" vid="PSA 80:13">mme ntək unam eto ikọd enyʌñ eta anye.<verse eid="PSA 80:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14" />Tịmme ibịne ñnyịn, Abasi Andikponñkan!</para>
  <para style="q2" vid="PSA 80:14">Tie ke anyọñ nyʌñ se!</para>
  <para style="q1" vid="PSA 80:14">Kpeme fain ami,<verse eid="PSA 80:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 80:15" />adʌñ ake ubọk nnasia mfo aketọọhọ,</para>
  <para style="q2" vid="PSA 80:15">ayịn ake afo akebọọhọ anịm anọọ idem mfo.<verse eid="PSA 80:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16" />E-ekpịkke fain mfo eduọọk, e-efọp anye ke ikañ;</para>
  <para style="q2" vid="PSA 80:16">nduaiya mfo a-asobo ikọd mfo.<verse eid="PSA 80:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17" />Dat ubọk mfo dot awo a-abaaha ke ubọk nnasia mfo,</para>
  <para style="q2" vid="PSA 80:17">ayịn awo ake afo akebọọhọ anịm anọọ idem mfo.<verse eid="PSA 80:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18" />Ndin ñnyịn idiikannake edem uwọt fiin;</para>
  <para style="q2" vid="PSA 80:18">isọọñọ ñnyịn idem, ndin ñnyịn iyaikoot anyịñ mfo.<verse eid="PSA 80:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19" />Maana inọ ñnyịn adudu <char style="nd">Abọọñ</char> Abasi Andikponñkan,</para>
  <para style="q2" vid="PSA 80:19">yak iso mfo ayamma inọ ñnyịn,</para>
  <para style="q2" vid="PSA 80:19">nọ ñnyịn ibọ adinyaaña.<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="cl">Saam 81<note caller="+" style="f"><char style="fr" closed="false">81:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 81:1-16 ewet Saam 81:2-17</char></note></para>
  <para style="d">Ake etubom ikwọ. Akeene ikwọ <char style="tl">kittid.</char> Ake Asaf.</para>
  <para style="s1">Abasi I-inọ Ñnyịn Nsọñidem</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1" />Ndufo ikwọ ikwọ idaara inọ Abasi adudu ñnyịn;</para>
  <para style="q2" vid="PSA 81:1">isọñ uyio ibọñ ñkpo idaara inọ Abasi Yekọb!<verse eid="PSA 81:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2" />Itọọñọ ikwọ, imia ibịdubọk,</para>
  <para style="q2" vid="PSA 81:2">ibre mme anemuyio hab ye ndidoudʌk.<verse eid="PSA 81:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3" />Ifịt nnʌk akukịmedọñ ke Ufa Afiọñ,</para>
  <para style="q2" vid="PSA 81:3">ye ke afiọñ amaayọhọ, ke usen usọrọ ñnyịn;<verse eid="PSA 81:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4" />Ami ado ewʌhọ anọ Isrel,</para>
  <para style="q2" vid="PSA 81:4">ami ado mbed abio ake Abasi Yekọb.<verse eid="PSA 81:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5" />Ke ini Abasi akewuọhọ abịne mbon Iyib,</para>
  <para style="q2" vid="PSA 81:5">anye amaawet ami anọ Yosef nte ewʌhọ.</para>
  <para style="b" vid="PSA 81:5" />
  <para style="q1" vid="PSA 81:5">Ami mmaakop uyio a-mmendiọọñọke nte abo:<verse eid="PSA 81:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6" />“Ami mmaabiommo mbiomo ke mme afara ammọ; emaefakka ubọk ammọ esio ke akpasa.<verse eid="PSA 81:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7" />Ke ini mbaba ndufo emaeñkoot miin ndin ami mmainyaaña ndufo,</para>
  <para style="q2" vid="PSA 81:7">ami mmaatie ke ntọñ aduma iyie ndufo;</para>
  <para style="q2" vid="PSA 81:7">ami mmaidomo ndufo ke itie mmọọñ Meriba.<verse eid="PSA 81:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8" />Ikọd mmi, innọ utọñ, ndin ami ñyaikpan ndufo;</para>
  <para style="q2" vid="PSA 81:8">akpekapado ndufo eyaekappa ekpañ utọñ ennọ miin, Isrel!<verse eid="PSA 81:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9" />Ndufo idiinieghe asen abasi ke atu ndufo;</para>
  <para style="q2" vid="PSA 81:9">inaaha ndufo ekpono abasi mfen ke amaaboiyo ami.<verse eid="PSA 81:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10" />Ami ndo <char style="nd">Abọọñ</char> Abasi ndufo,</para>
  <para style="q2" vid="PSA 81:10">ake akibenne ndufo awuọ ato ke isọñ Iyib.</para>
  <para style="q2" vid="PSA 81:10">Ikʌppọ inua ndufo yak anwaña, ndin ami ñyaadọñ ñkpọ ñyọhọ.<verse eid="PSA 81:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11" />“Ado ikọd mmi ikpañña utọñ innọ miin,</para>
  <para style="q2" vid="PSA 81:11">Isrel ikamma isuuk iwuod innọ miin.<verse eid="PSA 81:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12" />Ke ntoro ami mmaakappa ammọ nnọ isọñesịd ammọ</para>
  <para style="q2" vid="PSA 81:12">Nọ ammọ esaña ekeene uduak esịd ammọ.<verse eid="PSA 81:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13" />“Adieke adooho ikọd mmi eyaenyịmme adikop uyio mmi,</para>
  <para style="q2" vid="PSA 81:13">adieke adooho Isrel eyaekeene mme usʌñ mmi,<verse eid="PSA 81:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14" />ami ñkpaasọp nsuuho mme asua ammọ nnịm</para>
  <para style="q2" vid="PSA 81:14">ñkpaanyʌñ ñkappa ubọk mmi mfiomo mme asua ammọ.<verse eid="PSA 81:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15" />Mbon se isua <char style="nd">Abọọñ</char> eyaenwuuno ke iso amọ,</para>
  <para style="q2" vid="PSA 81:15">ñko ufen ammọ ayaaba ke nsi-nsi.<verse eid="PSA 81:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16" />Ado eyainọ ndufo abakpa se ifọọn ikan;</para>
  <para style="q2" vid="PSA 81:16">ami ñyaadat adanakwọọk a-atooho itiad nnam ndufo ebọ uyʌkkọ.”<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="cl">Saam 82</para>
  <para style="d">Saam ake Asaf</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1" />Abasi atie iwuod ke akwa esob;</para>
  <para style="q2" vid="PSA 82:1">anye abiide ikpe ke atu mme “abasi”:<verse eid="PSA 82:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2" />“Ndufo ediika die iso ibiere ukwañ ikpe</para>
  <para style="q2" vid="PSA 82:2">inyʌñ ifeghe mbon ibak anyen?<verse eid="PSA 82:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3" />Ikpeme mbon mmemidem ye nditọakpa;</para>
  <para style="q2" vid="PSA 82:3">mʌm benne unen mme uweene ye mbon se efiik.<verse eid="PSA 82:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4" />Inyaaña mbon mmemidem ye uweene;</para>
  <para style="q2" vid="PSA 82:4">isio ammọ ke ubọk mbon ibak.<verse eid="PSA 82:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5" />“Mme ‘abasi’ idiọọñọke ñkpọ ndomokeed, ñkpọ ndomokeed inwañake ammọ.</para>
  <para style="q2" vid="PSA 82:5">Ammọ esaaña ke akịm;</para>
  <para style="q2" vid="PSA 82:5">afịd mme itiad idakisọñ ederimbod enyeeñe.<verse eid="PSA 82:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6" />“Ami mmaabo, ‘Ndufo edo mme “abasi”;</para>
  <para style="q2" vid="PSA 82:6">afịd ndufo edo nditọ Andikoñ Ñkan.’<verse eid="PSA 82:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7" />Ado ndufo eyaekpañña kpa nte mme ñkaña abʌk;</para>
  <para style="q2" vid="PSA 82:7">ndufo eyaeduọññọ ke ubọọñ nte mbọọñ mfen.”<verse eid="PSA 82:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8" />O Abasi, dakka da, biere ikpe nọ ederimbod,</para>
  <para style="q2" vid="PSA 82:8">sia afịd mme idịd edo udeeme mfo.<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="cl">Saam 83<note caller="+" style="f"><char style="fr" closed="false">83:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 83:1-18 ewet Saam 83:2-19</char></note></para>
  <para style="d">Ikwọ. Saam ake Asaf.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1" />O Abasi, mbọk kundop uyio;</para>
  <para style="q2" vid="PSA 83:1">Kuusiit utọñ mfo,</para>
  <para style="q2" vid="PSA 83:1">O Abasi, kuuda nsan-nsan.<verse eid="PSA 83:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2" />Se naña mme asua mfo enyamma,</para>
  <para style="q2" vid="PSA 83:2">se naña mbon usua edịppe iwuod ammọ.<verse eid="PSA 83:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3" />Ammọ edʌk adu ñkara ebaña ikọd mfo;</para>
  <para style="q2" vid="PSA 83:3">ammọ enyʌñ eduak idiọọk uduak ebaña mbon se afo ama.<verse eid="PSA 83:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4" />Ammọ ete, “Idi,” “yak ñnyịn isobo ammọ nte idịd,</para>
  <para style="q2" vid="PSA 83:4">mbaak awo aditoiyo anyịñ Isrel aba.”<verse eid="PSA 83:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5" />Ammọ edʌk adu ke esịd keed;</para>
  <para style="q2" vid="PSA 83:5">ammọ enam edioomo ubaña fiin,<verse eid="PSA 83:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6" />mme atayad Edọm ye ake nditọ Ismeel,</para>
  <para style="q2" vid="PSA 83:6">Mọb ye ubon Haka,<verse eid="PSA 83:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7" />Nditọ Baiblos, Amọn ye Amalek,</para>
  <para style="q2" vid="PSA 83:7">Filistia, ye mbon Tai.<verse eid="PSA 83:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8" />Kpa mbon Asiria ekeene edian ubọk ye ammọ</para>
  <para style="q2" vid="PSA 83:8">nọ esọọñọ ubon Lọọd idem.<verse eid="PSA 83:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9" />Nam ye ammọ ukem se afo akenam ye mbon Midian,</para>
  <para style="q2" vid="PSA 83:9">ukem se afo akenam mme Sisera ye Yabịn ke inyañ Kisọn,<verse eid="PSA 83:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10" />ake afo akesoboke ke Endọ</para>
  <para style="q2" vid="PSA 83:10">yak ekappa eba nte uduañ ke isọn.<verse eid="PSA 83:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11" />Nam nọ mme awuọiso awo ammọ eba nte Ọreb mme Seeb,</para>
  <para style="q2" vid="PSA 83:11">yak afịd nditọ mbọọñ ammọ eba nte Seba ye Salmuna,<verse eid="PSA 83:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12" />e-ekebooho, “Yak ñnyịn idat</para>
  <para style="q2" vid="PSA 83:12">mme isọñ ubọọk ufene Abasi inie.”<verse eid="PSA 83:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13" />O Abasi mmi, nam ammọ eba nte mbio,</para>
  <para style="q2" vid="PSA 83:13">nte mbio ke iso afịm.<verse eid="PSA 83:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14" />Nte ikañ a-ataaha akai,</para>
  <para style="q2" vid="PSA 83:14">me nte edemeikañ a-afọppọ mme abod,<verse eid="PSA 83:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15" />kpa ntoro ben akpọsọñ ayobio mfo bịne ammọ</para>
  <para style="q2" vid="PSA 83:15">nyʌñ dịkke ammọ ye ayobio mfo.<verse eid="PSA 83:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16" />
    <char style="nd">Abọọñ</char>, nam abuud afʌk iso ammọ,</para>
  <para style="q2" vid="PSA 83:16">nọ ammọ eyem anyịñ mfo.<verse eid="PSA 83:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17" />Yak ammọ ekịt abuud ye ayeemensia afịd ini;</para>
  <para style="q2" vid="PSA 83:17">yak ammọ etak ke asuenne.<verse eid="PSA 83:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18" />Nam ammọ ediọọñọ ebo ke afo, ake anyịñ mfo adooho <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 83:18">ke afo ikpọọñ ado Andikoñ Ñkan ke afịd ederimbod.<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="cl">Saam 84<note caller="+" style="f"><char style="fr" closed="false">84:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 84:1-12 ewet Saam 84:2-13</char></note></para>
  <para style="d">Saam ake etubom ikwọ. Akeene ndido ikwọ <char style="tl">kittid.</char> Ake nditọ ideen Kora.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1" />
    <char style="nd">Abọọñ</char> Andikponñkan,</para>
  <para style="q2" vid="PSA 84:1">itie idʌñ mfo ayaiya die!<verse eid="PSA 84:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2" />Ukpọñ mmi adọñ, anyʌñ akpa mba,</para>
  <para style="q2" vid="PSA 84:2">adidʌk ñkaa esịd akwere <char style="nd">Abọọñ</char>;</para>
  <para style="q1" vid="PSA 84:2">esịd mmi ye abʌkidem mmi etua eyem</para>
  <para style="q2" vid="PSA 84:2">aduuwem Abasi.<verse eid="PSA 84:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3" />Akpekọm nnʌñesiin akịt ufọk amọ,</para>
  <para style="q2" vid="PSA 84:3">akadañabasi anyʌñ anie efọk amọ ñko,</para>
  <para style="q2" vid="PSA 84:3">itie ake anye akamake nditọ amọ,</para>
  <para style="q1" vid="PSA 84:3">itie a-akpereke akpokoro uwa mfo,</para>
  <para style="q2" vid="PSA 84:3">
    <char style="nd">Abọọñ</char> Andikponñkan, Adidem mmi ye Abasi mmi.<verse eid="PSA 84:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4" />Afọfọn anọ mbon se idʌñ ke ufọk mfo;</para>
  <para style="q2" vid="PSA 84:4">ammọ utooro fiin ke nsi-nsi.<verse eid="PSA 84:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5" />Afọfọn anọ mbon se adudu ammọ ado ke afo,</para>
  <para style="q2" vid="PSA 84:5">mbon se esịd ammọ awʌhọ ke adika adisana itie mfo.<verse eid="PSA 84:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6" />Nte ammọ esañake eboiyo ke Abedeñ Baka,</para>
  <para style="q2" vid="PSA 84:6">ammọ enam anye ado itie mme ube mmọọñ edidiọñ;</para>
  <para style="q2" vid="PSA 84:6">edịmukwọ anyʌñ afʌk anye ye ñkpọdiọhọ mmọọñ.<verse eid="PSA 84:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7" />Ammọ ekọt ye adudu ke adudu,</para>
  <para style="q2" vid="PSA 84:7">tutu awo keedekeed akewuọ iso Abasi ke Saiyọn.<verse eid="PSA 84:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8" />Mbọk kop akam mmi, <char style="nd">Abọọñ</char> Abasi Andikponñkan;</para>
  <para style="q2" vid="PSA 84:8">kpañ utọñ nnọ miin, Abasi Yekọb.<verse eid="PSA 84:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9" />Tịm se atuekọñ ñnyịn, O Abasi;</para>
  <para style="q2" vid="PSA 84:9">dat mfọn mfo tịm se awo ake emaekeyet adan inịm.<verse eid="PSA 84:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10" />Usen keed ke ekwere mfo</para>
  <para style="q2" vid="PSA 84:10">afọn akan tọsịn usen ke itie mfen;</para>
  <para style="q1" vid="PSA 84:10">ami ñkpaama adido akpeme usʌñ ke ufọk Abasi mmi</para>
  <para style="q2" vid="PSA 84:10">ñkan adidʌñ ke atayad mbon ibak.<verse eid="PSA 84:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11" />Sia <char style="nd">Abọọñ</char> Abasi ado utịn ye atuekọñ;</para>
  <para style="q2" vid="PSA 84:11">
    <char style="nd">Abọọñ</char> ado andinọ mfọn ye ukpono;</para>
  <para style="q1" vid="PSA 84:11">anye ifʌttọ ubọk ke adinọ eti ñkpọ ndomokeed</para>
  <para style="q2" vid="PSA 84:11">esọk mbon se isañ uwem ammọ anana ndudue.<verse eid="PSA 84:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12" />
    <char style="nd">Abọọñ</char> Andikponñkan,</para>
  <para style="q2" vid="PSA 84:12">afọfọn anọ awo a-anieghe mbuọdidem ke afo.<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="cl">Saam 85<note caller="+" style="f"><char style="fr" closed="false">85:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 85:1-13 ewet Saam 85:2-14</char></note></para>
  <para style="d">Ake etubom ikwọ. Ake nditọ ideen Kora. Saam.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1" />O <char style="nd">Abọọñ</char> Abasi, afo amewọt isọñ mfo mfọn;</para>
  <para style="q2" vid="PSA 85:1">Afo amemaana anam mme ñkpọmfọn anọ Yekọb.<verse eid="PSA 85:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2" />Afo amaafeen ndudue ikọd mfo</para>
  <para style="q2" vid="PSA 85:2">anyʌñ afuuk afịd idiọọkñkpọ ammọ.<verse eid="PSA 85:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3" />Afo amaaben ifiobesịd mfo asio</para>
  <para style="q2" vid="PSA 85:3">anyʌñ akappa iso mfo akpọñ ikañ ifiobesịd mfo.<verse eid="PSA 85:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4" />O Abasi Adinyaaña ñnyịn, maana idemme ñnyịn,</para>
  <para style="q2" vid="PSA 85:4">nyʌñ ben iyadesịd mfo sio ikpọñ ñnyịn.<verse eid="PSA 85:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5" />Afo uduuyat esịd ye ñnyịn ke nsi-nsi?</para>
  <para style="q2" vid="PSA 85:5">Afo uduunam iyadesịd mfo aba ke afịd emana?<verse eid="PSA 85:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6" />Ado nte afo uduumaanake udemme ñnyịn idem aba,</para>
  <para style="q2" vid="PSA 85:6">nọ ikọd mfo ediidaara ke afo?<verse eid="PSA 85:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7" />O <char style="nd">Abọọñ</char>, iwọt ñnyịn nsọọñọnda ima mfo,</para>
  <para style="q2" vid="PSA 85:7">nyʌñ inọ ñnyịn adinyaaña mfo.<verse eid="PSA 85:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8" />Ami ñyaakpañ utọñ ñkop se <char style="nd">Abọọñ</char> Abasi atañ;</para>
  <para style="q2" vid="PSA 85:8">sia anye anwọñọ emem anọ ndinen amọ, nti ikọd amọ,</para>
  <para style="q2" vid="PSA 85:8">ado ke ammọ ekappa edo ndisịme.<verse eid="PSA 85:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9" />Ke akpanikọ adinyaaña amọ akpere mbon se ibaak anye,</para>
  <para style="q2" vid="PSA 85:9">nọ anam yak ubọọñ amọ adʌñ ke isọñ ñnyịn.<verse eid="PSA 85:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10" />Ima mme akpanikọ esoobo keed;</para>
  <para style="q2" vid="PSA 85:10">adinenido mme emem edutʌmmọ emọ-emọ inua.<verse eid="PSA 85:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11" />Akpanikọ atịppe awuọ ato ke ederimbod,</para>
  <para style="q2" vid="PSA 85:11">ndin adinenido atie ke hefịn asuuk iso ase.<verse eid="PSA 85:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12" />Ke akpanikọ <char style="nd">Abọọñ</char> Abasi ayaanọ se ifọn,</para>
  <para style="q2" vid="PSA 85:12">ñko isọñ ñnyịn ayaanwịm idọk amọ.<verse eid="PSA 85:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13" />Adinenido abem anye iso</para>
  <para style="q2" vid="PSA 85:13">anyʌñ aneeñe usʌñ anọ ikpadisañ amọ.<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="cl">Saam 86</para>
  <para style="d">Akam Defid</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1" />
    <char style="nd">Abọọñ</char> Abasi, mbọk kop nyʌñ mbọọrọ miin,</para>
  <para style="q2" vid="PSA 86:1">sia ami ndo uweene mme awo unana.<verse eid="PSA 86:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2" />Kpeme uwem mmi, sia ami mmenam akpanikọ ye afo;</para>
  <para style="q2" vid="PSA 86:2">nyaaña awo mfo a-anieghe mbuọdidem ke afo.</para>
  <para style="q1" vid="PSA 86:2">Afo ado Abasi mmi; <verse eid="PSA 86:2" /><verse number="3" style="v" sid="PSA 86:3" />ntua miin mbọm, O <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 86:3">sia ami nseeme ukoot fiin afịd usen.<verse eid="PSA 86:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4" />
    <char style="nd">Abọọñ</char>, nọ awo mfo idadesịd,</para>
  <para style="q2" vid="PSA 86:4">sia ami mbuọt idem ke afo.<verse eid="PSA 86:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5" />O <char style="nd">Abọọñ</char>, afo amefọn anyʌñ ama adifeen ndudue,</para>
  <para style="q2" vid="PSA 86:5">afo ayọhọ ye ima anọ mbon se ukoot fiin.<verse eid="PSA 86:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6" />
    <char style="nd">Abọọñ</char>, mbọk kop akam mmi;</para>
  <para style="q2" vid="PSA 86:6">Kpañ utọñ ke uyio ñkpeubọk mmi.<verse eid="PSA 86:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7" />Ami nseeme ukoot fiin, ke ini mbaaha ke ukuud,</para>
  <para style="q2" vid="PSA 86:7">ndin afo añyie miin.<verse eid="PSA 86:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8" />
    <char style="nd">Abọọñ</char>, ibaaha ake ubit fiin ke atu mme abasi:</para>
  <para style="q2" vid="PSA 86:8">ibaaha mme edinam se ekeme adiben ndomo ye ake mfo.<verse eid="PSA 86:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9" />
    <char style="nd">Abọọñ</char> Abasi, afịd mme idịd se afo akenam</para>
  <para style="q2" vid="PSA 86:9">eyaedi edituak iwuod ukpono fiin;</para>
  <para style="q2" vid="PSA 86:9">ammọ eyaeben ubọọñ enọ anyịñ mfo.<verse eid="PSA 86:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10" />Afo amekpon anyʌñ anam mme utịppe utom;</para>
  <para style="q2" vid="PSA 86:10">afo ikpọọñ kpọd ado Abasi.<verse eid="PSA 86:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11" />
    <char style="nd">Abọọñ</char> ñkpeep miin usʌñ mfo,</para>
  <para style="q2" vid="PSA 86:11">nọ ami mbuọt idem ke akpanikọ mfo;</para>
  <para style="q1" vid="PSA 86:11">nnọ miin nsọọñọnda esịd,</para>
  <para style="q2" vid="PSA 86:11">nọ ami ñkeme adibaak anyịñ mfo.<verse eid="PSA 86:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12" />Ami ñyautooro fiin, <char style="nd">Abọọñ</char> Abasi mmi, ke afịd esịd mmi;</para>
  <para style="q2" vid="PSA 86:12">ami ñyaakpono anyịñ mfo ke nsi-nsi.<verse eid="PSA 86:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13" />Sia ima se afo anie annọ miin anekke akpon;</para>
  <para style="q2" vid="PSA 86:13">afo amensio miin ke udem,</para>
  <para style="q2" vid="PSA 86:13">amensio ke ube ñkpa.<verse eid="PSA 86:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14" />O Abasi, mme asua ye mbon ntañidem esʌk enwana ye ami;</para>
  <para style="q2" vid="PSA 86:14">mbon unana mbọm esʌk eyem adiñwot miin;</para>
  <para style="q2" vid="PSA 86:14">ammọ inieghe ukpono unọ fiin.<verse eid="PSA 86:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15" />Ado afo, <char style="nd">Abọọñ</char>, ado Abasi esịd mbọm ye mfọn,</para>
  <para style="q2" vid="PSA 86:15">usọppọ iyadesịd, ado ayọhọ ye ima ye akpanikọ.<verse eid="PSA 86:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16" />Mbọk, kanna ñkeene miin nyʌñ ntua mbọm;</para>
  <para style="q2" vid="PSA 86:16">wọt adudu mfo ke ntak awo mfo;</para>
  <para style="q1" vid="PSA 86:16">ñnyaaña miin, sia ami nnam ñkpọ unọ fiin</para>
  <para style="q2" vid="PSA 86:16">ukem nte eka mmi akenamma.<verse eid="PSA 86:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17" />Nnọ miin idiọọñọ mfọn mfo,</para>
  <para style="q2" vid="PSA 86:17">yak mme asua mmi ekịt, abuud anyʌñ amʌm ammọ,</para>
  <para style="q2" vid="PSA 86:17">sia afo, <char style="nd">Abọọñ</char>, ameñnyaaña miin anyʌñ andọñ miin esịd.<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="cl">Saam 87</para>
  <para style="d">Ake nditọ ideen Kora. Saam. Ikwọ.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1" />Anye akesiak abio amọ adot ke adisana abod.<verse eid="PSA 87:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2" />
    <char style="nd">Abọọñ</char> ama mme inuaatob Saiyọn</para>
  <para style="q2" vid="PSA 87:2">akan afịd mme itieidʌñ Yekọb mfen.<verse eid="PSA 87:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3" />Ebʌk mme nti ñkpọ ubaña fiin,</para>
  <para style="q2" vid="PSA 87:3">abio Abasi:<verse eid="PSA 87:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4" />“Ami ñyaawet anyịñ Rahab ye Babilọn</para>
  <para style="q2" vid="PSA 87:4">nsịn ke atu mbon se indiọọñọ miin,</para>
  <para style="q1" vid="PSA 87:4">ukem ye Filistia, Tai ye Kuus,</para>
  <para style="q2" vid="PSA 87:4">ñyaanyʌñ mbo nte, ‘Anye ami akemana ke Saiyọn.’ ”<verse eid="PSA 87:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5" />Ke akpanikọ, eyaetañ ntom ebaña Saiyọn,</para>
  <para style="q2" vid="PSA 87:5">“Anye ami ye anye ako ke ekeman ke anye,</para>
  <para style="q2" vid="PSA 87:5">ñko Andikoñ Ñkan ke idem amọ ayaanam anye asọọñọ ada.”<verse eid="PSA 87:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6" />
    <char style="nd">Abọọñ</char> Abasi ayaawet ke ñwed usịn anyịñ mme awo ate,</para>
  <para style="q2" vid="PSA 87:6">“Anye ami akemana ke Saiyọn.”<verse eid="PSA 87:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7" />Ammọ emaenam ikwọ, eyaekwọ ebo ete,</para>
  <para style="q2" vid="PSA 87:7">“Afịd mme ntịppe idịm mmi eba ke mfo.”<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="cl">Saam 88<note caller="+" style="f"><char style="fr" closed="false">88:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 88:1-18 ewet Saam 88:2-19</char></note></para>
  <para style="d">Ikwọ. Saam Nditọ Ideen Kora. Ake etubom ikwọ. Akeene <char style="tl">Mahalad liinọd</char>. <char style="tl">Maskil</char> ake Heman, awo Esra.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1" />O <char style="nd">Abọọñ</char>, afo ado Abasi añnyaañake miin;</para>
  <para style="q2" vid="PSA 88:1">ami ntua ukoot fiin akonayio ye uweemeayio.<verse eid="PSA 88:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2" />Yak akam mmi adọọk adi ke iso mfo;</para>
  <para style="q2" vid="PSA 88:2">kanna utọñ mfo kop uyio aseeme mmi.<verse eid="PSA 88:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3" />Mfịna eñkan miin ubọk</para>
  <para style="q2" vid="PSA 88:3">ndin uwem mmi akpere ñkpa.<verse eid="PSA 88:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4" />Embat miin esịn ke atu mbon se ika udi;</para>
  <para style="q2" vid="PSA 88:4">ami ndiba nte awo i-idiinieghe udịd aba.<verse eid="PSA 88:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5" />Ensio miin esịn ke atu mme akpañkpa,</para>
  <para style="q2" vid="PSA 88:5">nte mbon se ewot edọñ ke udi,</para>
  <para style="q1" vid="PSA 88:5">ake afo umuutoiyoke aba,</para>
  <para style="q2" vid="PSA 88:5">emaekekpịkke esio ke ukpeme mfo.<verse eid="PSA 88:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6" />Afo amensịn miin ke ataa ntotəño ube,</para>
  <para style="q2" vid="PSA 88:6">ke udem akịmme akan.<verse eid="PSA 88:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7" />Ifiobesịd mfo andoro miin ke idem;</para>
  <para style="q2" vid="PSA 88:7">awawa mfo añkan miin ubọk.<verse eid="PSA 88:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8" />Afo amembọi mme akpan ufan mmi</para>
  <para style="q2" vid="PSA 88:8">amenyʌñ anam ammọ edinse miin ke mbubiam.</para>
  <para style="q1" vid="PSA 88:8">Eñkanna miin ekʌk, anam ñkanna ñnyaaña idem;<verse eid="PSA 88:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 88:9" />ukuud anam anyen añkịm.</para>
  <para style="b" vid="PSA 88:9" />
  <para style="q1" vid="PSA 88:9">
    <char style="nd">Abọọñ</char>, ami nseeme ukoot fiin afịd usen;</para>
  <para style="q2" vid="PSA 88:9">ami mmetat ubọk mmi ñnyan unọ fiin.<verse eid="PSA 88:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10" />Me afo uduunam mme utịppeñkpọ mfo unọ mme akpañkpa?</para>
  <para style="q2" vid="PSA 88:10">Me sịbidịd ammọ eyaeset enyʌñ utooro fiin?<verse eid="PSA 88:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11" />Nte ediibʌk mbʌk ima mfo ke udi,</para>
  <para style="q2" vid="PSA 88:11">ye akpanikọ mfo ke Nsobo?<verse eid="PSA 88:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12" />Ado nte ediọọñọ mme utịppeñkpọ mfo ke ekịm,</para>
  <para style="q2" vid="PSA 88:12">me mme ndinen adinam mfo ke isọñ ndueidem?<verse eid="PSA 88:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13" />
    <char style="nd">Abọọñ</char>, ami ntua ukoot fiin ñyem unwam;</para>
  <para style="q2" vid="PSA 88:13">kwa ubakusen akam mmi adi ke iso mfo.<verse eid="PSA 88:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14" />
    <char style="nd">Abọọñ</char>, nsoo inam nọ afo ansaana miin ayaak</para>
  <para style="q2" vid="PSA 88:14">anyʌñ andịp miin iso mfo?<verse eid="PSA 88:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15" />Ami mmebọ ufen tọọñọ ke uyịn mmi nyʌñ ñkpere ñkpa;</para>
  <para style="q2" vid="PSA 88:15">ami mmebọ mme ndịk mfo tutu nduọọk idodanyen.<verse eid="PSA 88:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16" />Ifiobesịd mfo amfʌk miin;</para>
  <para style="q2" vid="PSA 88:16">mfiomo mfo añkweeñe miin.<verse eid="PSA 88:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17" />Tọọñọ ubakusen tutu akonayio ammọ eñkanna miin ekʌk nte ndiọọñ;</para>
  <para style="q2" vid="PSA 88:17">ammọ emfʌk miin afịd-afịd.<verse eid="PSA 88:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18" />Afo amembọ miin ufan ye mbọhọidʌñ,</para>
  <para style="q2" vid="PSA 88:18">ekịm adido akpan ufan mmi.<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="cl">Saam 89<note caller="+" style="f"><char style="fr" closed="false">89:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 89:1-52 ewet Saam 89:2-53.</char></note></para>
  <para style="d">Ake <char style="tl">maskil</char> ake Etan, awo Esra.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1" />Ami ñyaakwọ akwa ima <char style="nd">Abọọñ</char> Abasi ke nsi-nsi;</para>
  <para style="q2" vid="PSA 89:1">ami ñyaakama inua mmi mbʌk akpanikọ mfo</para>
  <para style="q2" vid="PSA 89:1">ke afịd emana.<verse eid="PSA 89:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2" />Ami ñyaabʌk anwa-anwa mbo ke ima mfo ada ke nsi-nsi,</para>
  <para style="q2" vid="PSA 89:2">ke afo amewuuk akpanikọ ke idem hefịn.<verse eid="PSA 89:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3" />Afo akebo ate, “Ami mmenam edioomo ye awo ake ami mmekke,</para>
  <para style="q2" vid="PSA 89:3">ami mmenam enwọñọ ye Defid, awo mmi,<verse eid="PSA 89:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4" />‘Ami ñyaasiak ubon mfo nnịm ke nsi-nsi</para>
  <para style="q2" vid="PSA 89:4">ñnyʌñ nnam ebekpo mfo asọọñọ ada ke afịd emana.’ ”<verse eid="PSA 89:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5" />
    <char style="nd">Abọọñ</char>, mme hefịn etooro mme utịppeñkpọ mfo,</para>
  <para style="q2" vid="PSA 89:5">ye akpanikọ mfo ke esob ndisana awo.<verse eid="PSA 89:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6" />Anie ke ikpaanyọñ ke ekeme adidat ndomo ye <char style="nd">Abọọñ</char>?</para>
  <para style="q2" vid="PSA 89:6">Anie atie nte <char style="nd">Abọọñ</char> ke atu mbon udịm anyọñ?<verse eid="PSA 89:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7" />Ke esob ndisana awo, Abasi ke ebaak ekan;</para>
  <para style="q2" vid="PSA 89:7">anye anie uteeñe akan afịd se ikanna anye ikʌk.<verse eid="PSA 89:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8" />Anie atie nte afo, <char style="nd">Abọọñ</char> Abasi Andikponñkan?</para>
  <para style="q2" vid="PSA 89:8">Afo, <char style="nd">Abọọñ</char>, akpon akan, akpanikọ mfo anyʌñ ukanna fiin akʌk.<verse eid="PSA 89:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9" />Afo akara mbufịd inyañ;</para>
  <para style="q2" vid="PSA 89:9">mme awawa amọ emaedakka ida, afo asuuhọ ammọ.<verse eid="PSA 89:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10" />Afo akenuak Rahab nte keed ke atu mbon se ewot,</para>
  <para style="q2" vid="PSA 89:10">afo amaasuan mme asua mfo ke akpọsọñ ubọk mfo.<verse eid="PSA 89:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11" />Mme hefịn unie fiin, afo anyʌñ anie ederimbod ñko;</para>
  <para style="q2" vid="PSA 89:11">afo akesiak ekondo ye afịd se idọñọ ke esịd.<verse eid="PSA 89:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12" />Afo akebot adoro ye usuuk;</para>
  <para style="q2" vid="PSA 89:12">Tabọ ye Hemọn ekwọ idaara enọ anyịñ mfo.<verse eid="PSA 89:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13" />Ubọk mfo asaña ye adudu;</para>
  <para style="q2" vid="PSA 89:13">ubọk mfo anie inweek, ebenne ubọk nnasia mfo ke anyọñ.<verse eid="PSA 89:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14" />Adinenido mme unenikpe edo itiad idakisọñ ebekpo mfo;</para>
  <para style="q2" vid="PSA 89:14">ima ye akpanikọ ubem fiin iso.<verse eid="PSA 89:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15" />Afọfọn anọ mbon e-ediọọñọke adudaara fiin,</para>
  <para style="q2" vid="PSA 89:15">e-esañake ke unwana iso mfo, O <char style="nd">Abọọñ</char>.<verse eid="PSA 89:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16" />Ammọ enem esịd ke anyịñ mfo ke afịd usen;</para>
  <para style="q2" vid="PSA 89:16">ammọ ekwọ etooro adinenido mfo.<verse eid="PSA 89:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17" />Sia afo ado ubọọñ mme adudu ammọ,</para>
  <para style="q2" vid="PSA 89:17">mfọn mfo ñko abenne nnʌk ñnyịn ke anyọñ.<verse eid="PSA 89:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18" />Ke akpanikọ, atuekọñ ñnyịn anie <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 89:18">adidem ñnyịn anyʌñ anie Adisana Abasi Isrel.<verse eid="PSA 89:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19" />Ini keed afo amaatañ ikọ ke ñkukịd,</para>
  <para style="q2" vid="PSA 89:19">abo mme ndinen ikọd mfo ate:</para>
  <para style="q1" vid="PSA 89:19">“Ami mmesịn awo ekọñ adudu ke idem;</para>
  <para style="q2" vid="PSA 89:19">ami mmesio akparawa keed ke atu mme ikọd mmi nnịm.<verse eid="PSA 89:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20" />Ami mmekịt Defid awo mmi;</para>
  <para style="q2" vid="PSA 89:20">ami mmeyet anye adisana adan mmi.<verse eid="PSA 89:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21" />Ubọk mmi ayaamʌm anye akama;</para>
  <para style="q2" vid="PSA 89:21">ke akpanikọ ubọk mmi ayaanọ anye adudu.<verse eid="PSA 89:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22" />Mme asua idiikanna anye;</para>
  <para style="q2" vid="PSA 89:22">mbon ibak idiifʌnnọke anye.<verse eid="PSA 89:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23" />Ami ñyaanuak mme asua amọ ke iso amọ</para>
  <para style="q2" vid="PSA 89:23">ñnyʌñ ñyʌppọ mbon utọk amọ nduọñọ.<verse eid="PSA 89:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24" />Nsọọñọnda ima mmi ayaaba ye anye,</para>
  <para style="q2" vid="PSA 89:24">ato ke anyịñ mmi nnʌk amọ ayaadịppe ke anyọñ.<verse eid="PSA 89:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25" />Ami ñyaanam ubọk amọ akaara ke akpainyañ,</para>
  <para style="q2" vid="PSA 89:25">ubọk nnasia amọ anyʌñ akaara mme inyañ.<verse eid="PSA 89:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26" />Anye ayaabọñ añkoot miin, ate: ‘Afo ado Ete mmi,</para>
  <para style="q2" vid="PSA 89:26">Abasi mmi, Itiad Adinyaaña mmi.’<verse eid="PSA 89:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27" />Ñko ami ñyaasio anye nnịm nte akpan mmi,</para>
  <para style="q2" vid="PSA 89:27">andikoñ ñkan ke atu mme ndidem ederimbod.<verse eid="PSA 89:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28" />Ami ñyaanịm ima mmi nnọ anye ke nsi-nsi,</para>
  <para style="q2" vid="PSA 89:28">ndin edioomo mmi ye anye idiikpuuho ke nsi-nsi.<verse eid="PSA 89:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29" />Ami ñyaasiak ubon amọ nnịm ke nsi-nsi,</para>
  <para style="q2" vid="PSA 89:29">ebekpo amọ ayaasọọñọ ada adaña nte mme hefịn ebaaha.<verse eid="PSA 89:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30" />“Adieke nditọ ideen amọ ekpọññọ mbed mmi</para>
  <para style="q2" vid="PSA 89:30">inyʌññọ isaña ke mme ewʌhọ mmi,<verse eid="PSA 89:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31" />adieke ammọ ebiada mme mbed mmi</para>
  <para style="q2" vid="PSA 89:31">enyʌñ etre adinam uyio mmi,<verse eid="PSA 89:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32" />ami ñyaakama ikpa mmia ammọ ufen ke idiọọkñkpọ ammọ,</para>
  <para style="q2" vid="PSA 89:32">ñyaatịm ammọ ke ukwañido ammọ;<verse eid="PSA 89:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33" />ado ami ndiibọọhọ anye ima mmi,</para>
  <para style="q2" vid="PSA 89:33">ndiinyʌññọ ñkpọñ akpanikọ mmi.<verse eid="PSA 89:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34" />Ami ndiibiatta edioomo mmi</para>
  <para style="q2" vid="PSA 89:34">me adikpəho se ñkpọkinua mmi aketañ.<verse eid="PSA 89:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35" />Ami mmenwọñọ ke adisanaido mmi, akañ keed ami nte akpatre,</para>
  <para style="q2" vid="PSA 89:35">ami ndiinyʌññọ nsʌhọ nsu nnọ Defid,<verse eid="PSA 89:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36" />ke ubọọñ amọ ayaakaa iso aba ke nsi-nsi</para>
  <para style="q2" vid="PSA 89:36">ñko ebekpo amọ ayaasọọñọ ada ke iso mmi nte utịn;<verse eid="PSA 89:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37" />anye ayaasọọñọ ada ke nsi-nsi nte afiọñ,</para>
  <para style="q2" vid="PSA 89:37">nte ntiense akpanikọ ke ikpaanyọñ.”<verse eid="PSA 89:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38" />Ado afo amesịn, afo amese ke ndek,</para>
  <para style="q2" vid="PSA 89:38">afo amaanekke ayat esịd ye awo se emaekeyet adan inịm.<verse eid="PSA 89:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39" />Afo amekañ edioomo mfo ye awo mfo</para>
  <para style="q2" vid="PSA 89:39">amenyʌñ asappa anyanya ammọ ke ntọñ.<verse eid="PSA 89:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40" />Afo amewuut afịd ndibene amọ</para>
  <para style="q2" vid="PSA 89:40">anyʌñ asobo ñkpọsọñ itie amọ.<verse eid="PSA 89:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41" />Afịd awo se isaña ifrọ ke usʌñ ebịme anye;</para>
  <para style="q2" vid="PSA 89:41">anye akappa ado ñkpọ nsaha anọ mbọhọidʌñ amọ.<verse eid="PSA 89:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42" />Afo amedịppe ubọk nnasia mme asua amọ;</para>
  <para style="q2" vid="PSA 89:42">afo amenam afịd mme asua amọ edaara.<verse eid="PSA 89:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43" />Ke akpanikọ, afo amewọññọ mben akañkañ amọ</para>
  <para style="q2" vid="PSA 89:43">unyʌññọ unọ anye unwam ke ekọñ.<verse eid="PSA 89:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44" />Afo ametre akwa uyai amọ</para>
  <para style="q2" vid="PSA 89:44">anyʌñ atop ebekpo amọ aduọọk ke isọñ.<verse eid="PSA 89:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45" />Afo amekpịkke ini uyịn amọ;</para>
  <para style="q2" vid="PSA 89:45">afo amenyʌñ aben abuud afʌk anye ke idem.<verse eid="PSA 89:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46" />
    <char style="nd">Abọọñ</char>, adiikpeene die? Afo uduudịp idem mfo ke nsi-nsi?</para>
  <para style="q2" vid="PSA 89:46">Ifiobesịd mfo adiisak nte ikañ ikpeene die?<verse eid="PSA 89:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47" />Toiyo naña ayio uwem mmi aməho.</para>
  <para style="q2" vid="PSA 89:47">Se naña afo akebot afịd uduud awo ke ikpu-ikpu o!<verse eid="PSA 89:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48" />Anie akeme adidu uwem ndin ikpaaha ñkpa</para>
  <para style="q2" vid="PSA 89:48">me anie akeme adibọkkọ adudu udi?<verse eid="PSA 89:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49" />
    <char style="nd">Abọọñ</char>, akaan akwa ima mfo aba ke mmọọ,</para>
  <para style="q2" vid="PSA 89:49">ake afo akedatta akpanikọ mfo anwọñọ anọọ Defid?<verse eid="PSA 89:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50" />
    <char style="nd">Abọọñ</char>, toiyo naña esak awo mfo,</para>
  <para style="q2" vid="PSA 89:50">naña ami mbiom usọñanyen afịd mme idịd ke esịd mmi,<verse eid="PSA 89:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51" />mme usọñanyen ake mme asua mfo, <char style="nd">Abọọñ</char>, ensakka,</para>
  <para style="q2" vid="PSA 89:51">ake ammọ esakka afịd ikpadisañ awo mfo emaekeyet adan inịm.<verse eid="PSA 89:51" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52" />Itooro anie <char style="nd">Abọọñ</char> ke nsi-nsi</para>
  <para style="qc" vid="PSA 89:52">Amen ye Amen.<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms">Ayọhọ Ñwed IV</para>
  <para style="mr">
    <ref loc="PSA 90-106">Mme Saam 90–106</ref></para>
  <para style="cl">Saam 90</para>
  <para style="d">Akam Moses, awo Abasi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1" />
    <char style="nd">Abọọñ</char> Abasi, afo ado itieidʌñ ñnyịn</para>
  <para style="q2" vid="PSA 90:1">ke afịd emana.<verse eid="PSA 90:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2" />Mbemiso mme abod ekebañña</para>
  <para style="q2" vid="PSA 90:2">me afo umuukubotto afịd ekondo diin,</para>
  <para style="q2" vid="PSA 90:2">tọọñọ ke nsi-nsi tutu asịm ke nsi-nsi afo ado Abasi.<verse eid="PSA 90:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3" />Afo a-anam mbon awo etịmme enyọñ ke ntọñ,</para>
  <para style="q2" vid="PSA 90:3">ke adibo, “Etịmme enyọñ ke ntọñ, ndufo ubon awo.”<verse eid="PSA 90:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4" />Tọsịn isua ke iso mfo</para>
  <para style="q2" vid="PSA 90:4">etie nte usen keed aboiyo afep,</para>
  <para style="q2" vid="PSA 90:4">me nte ukpeme akonayio keed.<verse eid="PSA 90:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5" />Ado afo akwọọk mme awo aduọọk ke idab ñkpa,</para>
  <para style="q2" vid="PSA 90:5">ammọ eba nte ufa mbid ake ubakusen:<verse eid="PSA 90:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6" />Anye atịppe akọt ufa ke ubakusen,</para>
  <para style="q2" vid="PSA 90:6">ado asaat anyʌñ ayeppe ke ndubiayio.<verse eid="PSA 90:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7" />Iyadesịd mfo ikan ñnyịn ubọk</para>
  <para style="q2" vid="PSA 90:7">ndịk anyʌñ imʌm ñnyịn ato ifịdesịd mfo.<verse eid="PSA 90:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8" />Afo amaaben mme ukwaññkpọ ñnyịn anịm ke iso mfo,</para>
  <para style="q2" vid="PSA 90:8">amaanịm mme ndịbe ndiọiñkpọ ñnyịn anwa-anwa ke iso mfo.<verse eid="PSA 90:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9" />Afịd usen uwem ñnyịn aboiyo ke ifiobesịd mfo;</para>
  <para style="q2" vid="PSA 90:9">utịd uwem ñnyịn ado ke mmịm.<verse eid="PSA 90:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10" />Mme usen uwem ñnyịn akeme iwuọ isua ata mme duob,</para>
  <para style="q2" vid="PSA 90:10">me anaañ, udịd ñnyịn akpeben;</para>
  <para style="q1" vid="PSA 90:10">kpayeado uwak ini mme isua ami eyọhọ ye mfịna ye mfʌhọ,</para>
  <para style="q2" vid="PSA 90:10">sia ammọ eboiyo ke usọp, ndin ñnyịn inyọñ.<verse eid="PSA 90:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11" />Akpekapado ñnyịn imidiọọñọ adudu iyadesịd mfo!</para>
  <para style="q2" vid="PSA 90:11">Ifiobesịd mfo akpon nte uteeñe a-adotto ye afo.<verse eid="PSA 90:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12" />Ikpeep ñnyịn adibat mme usen ñnyịn,</para>
  <para style="q2" vid="PSA 90:12">nọ ñnyịn inie esịd aniọñ.<verse eid="PSA 90:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13" />Suuhọ esịd, <char style="nd">Abọọñ</char>! Adiikpeene die?</para>
  <para style="q2" vid="PSA 90:13">Tua ikọd mfo mbọm.<verse eid="PSA 90:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14" />Bak nam nsọọñọnda ima mfo iyʌkkọ ñnyịn ke ubakusen,</para>
  <para style="q2" vid="PSA 90:14">nọ ñnyịn ikwọ idaara inyʌñ inem esịd ke afịd usen uwem ñnyịn.<verse eid="PSA 90:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15" />Nam yak usen inemesịd ñnyịn awak nte afịd mme usen ake afo akikuudo ñnyịn,</para>
  <para style="q2" vid="PSA 90:15">yak awak nte mme isua ake ñnyịn ikikịtte mfịna.<verse eid="PSA 90:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16" />Nam ikọd mfo ekịt mme adinam mfo,</para>
  <para style="q2" vid="PSA 90:16">nam nditọ ammọ ekịt uyai mfo.<verse eid="PSA 90:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17" />Yak mfọn <char style="nd">Abọọñ</char> Abasi ñnyịn idodo ñnyịn ke idem;</para>
  <para style="q2" vid="PSA 90:17">nam utom se ubọk ñnyịn anam asọọñọ ada inọ ñnyịn,</para>
  <para style="q2" vid="PSA 90:17">ii, nam utom se ubọk ñnyịn anam asọọñọ ada.<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="cl">Saam 91</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1" />Awo akeedodo a-adʌññọ ke ndịbe itie Andikoñ Ñkan</para>
  <para style="q2" vid="PSA 91:1">ayaabọ emem ke mba Abasi Andikponñkan.<verse eid="PSA 91:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2" />Ami ñyaatañ mbaña <char style="nd">Abọọñ</char> nte, “Anye ado itie ubọkkọ ye itie udịbe mmi,</para>
  <para style="q2" vid="PSA 91:2">Abasi mmi, a-ami mbuọttọ idem ke anye.”<verse eid="PSA 91:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3" />Ke akpanikọ, anye ayaufak fiin</para>
  <para style="q2" vid="PSA 91:3">asio ke afia atautob</para>
  <para style="q2" vid="PSA 91:3">mme udọñọ nsobo.<verse eid="PSA 91:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4" />Anye ayaufʌk fiin ke ntañ amọ,</para>
  <para style="q2" vid="PSA 91:4">ñko afo amaadịbe ke idak mba amọ ayaakịt ubọkkọ;</para>
  <para style="q2" vid="PSA 91:4">akpanikọ amọ adiido atuekọñ mfo.<verse eid="PSA 91:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5" />Afo uduufegheke ñkpọ ndịk ke akonayio,</para>
  <para style="q2" vid="PSA 91:5">me idañ e-etoppo ke uweemeayio,<verse eid="PSA 91:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6" />me akwọkudịm udọñọ a-afeeñeke ke ekịm,</para>
  <para style="q2" vid="PSA 91:6">me udọñọñkpa a-asoboke ke ufọọd uweemeayio.<verse eid="PSA 91:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7" />Tọsịn ekeme ediduọññọ ke ñkañ mfo,</para>
  <para style="q2" vid="PSA 91:7">tọsịn duob ke ubọk nnasia mfo,</para>
  <para style="q2" vid="PSA 91:7">ado idiisañake ukpere fiin.<verse eid="PSA 91:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8" />Ke anyen mfo kpọd ke afo uduuse</para>
  <para style="q2" vid="PSA 91:8">unyʌñ ukịt ufen mbon ibak.<verse eid="PSA 91:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9" />Adieke afo abooho, “<char style="nd">Abọọñ</char> ado itie udịbe mmi,”</para>
  <para style="q2" vid="PSA 91:9">afo anyʌñ anam Andikoñ Ñkan itie idʌñ mfo,<verse eid="PSA 91:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10" />idiọọk ndomokeed iduuwuọhọ fiin idem,</para>
  <para style="q2" vid="PSA 91:10">unọmọ ndomokeed idiinyʌññọ iwuọ atayad mfo.<verse eid="PSA 91:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11" />Sia anye ayaanọ mme enyere amọ ewʌhọ ubaña fiin</para>
  <para style="q2" vid="PSA 91:11">nọ ukpeme fiin ke afịd usʌñ mfo;<verse eid="PSA 91:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12" />ammọ eyaudịppe fiin ke ubọk ammọ;</para>
  <para style="q2" vid="PSA 91:12">mbaak afo udutuak ukod mfo ke itiad.<verse eid="PSA 91:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13" />Afo ayaafiik ekpe mme abre ke ukod;</para>
  <para style="q2" vid="PSA 91:13">ayaasọọk ikpọ ekpe mme udʌkikọd ke ukod.<verse eid="PSA 91:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14" />“Sia anye ammaaha miin,” <char style="nd">Abọọñ</char> abo, “Ami ñyaanyaaña anye;</para>
  <para style="q2" vid="PSA 91:14">ami ñyaakpeme anye, sia anye adiọọñọ anyịñ mmi.<verse eid="PSA 91:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15" />Anye ayañkoot miin, ndin ami ñyaabọọrọ anye;</para>
  <para style="q2" vid="PSA 91:15">ami ñyaada ye anye ke ini mfịna,</para>
  <para style="q1" vid="PSA 91:15">ami ñyaanyaaña anye ñnyʌñ ñkpono anye.<verse eid="PSA 91:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16" />Ami ñyaayʌkkọ anye ye anyan isua uwem</para>
  <para style="q2" vid="PSA 91:16">ñnyʌñ ñwọt anye adinyaaña mmi.”<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="cl">Saam 92<note caller="+" style="f"><char style="fr" closed="false">92:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 92:1-15 ewet Saam 92:2-16.</char></note></para>
  <para style="d">Saam. Ikwọ. Ake usen Sabad</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1" />Afọn aditooro <char style="nd">Abọọñ</char> Abasi</para>
  <para style="q2" vid="PSA 92:1">adinyʌñ ñkwọ ikwọ nnọọ anyịñ mfo, O Andikoñ Ñkan,<verse eid="PSA 92:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2" />adibʌk ima mfo ke ubakusen,</para>
  <para style="q2" vid="PSA 92:2">ye akpanikọ mfo ke akonayio,<verse eid="PSA 92:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3" />ke ikwọ e-ebreke ke ndidoudʌk a-anieghe udʌk duob</para>
  <para style="q2" vid="PSA 92:3">ye uyioikwọ ke ekpa.<verse eid="PSA 92:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4" />Sia afo <char style="nd">Abọọñ</char>, amenam esịd mmi anem, ato ke adinam mfo;</para>
  <para style="q2" vid="PSA 92:4">ami ñkwọ ikwọ ke inemesịd ato ke mme ñkpọ se ubọk mfo anam.<verse eid="PSA 92:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5" />O <char style="nd">Abọọñ</char>, mme utom mfo ekpon eti-eti,</para>
  <para style="q2" vid="PSA 92:5">utom mfo akpon die, akikere mfo anyʌñ atʌñọ die!<verse eid="PSA 92:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6" />Mbon unana ifiọk idiọọñọke,</para>
  <para style="q2" vid="PSA 92:6">inyʌññọ inwaña mme ndisịme,<verse eid="PSA 92:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7" />ke akpesʌkado mbon ibak ekọttọ nte mbid</para>
  <para style="q2" vid="PSA 92:7">afịd mme anam idiọọk enyʌñ eforo,</para>
  <para style="q1" vid="PSA 92:7">eyaesobo ammọ ke nsi-nsi.<verse eid="PSA 92:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8" />Ado afo, O <char style="nd">Abọọñ</char>, ubenne fiin ke nsi-nsi.<verse eid="PSA 92:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9" />
    <char style="nd">Abọọñ</char>, ke akpanikọ mme asua mfo,</para>
  <para style="q2" vid="PSA 92:9">ke akpanikọ mme asua mfo eyaekịt nsobo;</para>
  <para style="q2" vid="PSA 92:9">afịd mme anamidiọọk eyaesuana.<verse eid="PSA 92:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10" />Afo amaabenne nnʌk mmi nte ake ayaaraenañ ikọd ke anyọñ;</para>
  <para style="q2" vid="PSA 92:10">enduọk miin mme nti adan.<verse eid="PSA 92:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11" />Anyen mmi akịt iduọ mme asua mmi,</para>
  <para style="q2" vid="PSA 92:11">utọñ mmi akop nsobo se isịm mme asua mmi.<verse eid="PSA 92:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12" />Ndinen awo eyaefọọn idem nte ekpad ayob,</para>
  <para style="q2" vid="PSA 92:12">ammọ eyaekọt nte eto sida ake Lebanọn;<verse eid="PSA 92:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13" />etọọhọ ke ufọk <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 92:13">ammọ eyaefiọọrọ ke akwere Abasi ñnyịn.<verse eid="PSA 92:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14" />Ammọ ediikaka iso enwịm mfịd ke usọñ,</para>
  <para style="q2" vid="PSA 92:14">ammọ eyaekaaka iso eseghe enyʌñ esịññe mfañ,<verse eid="PSA 92:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15" />enyʌñ etañ ebo, “<char style="nd">Abọọñ</char> anen ido;</para>
  <para style="q2" vid="PSA 92:15">anye ado Itiad mmi, ndin ibak ibaaha ke idem ammọ.”<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="cl">Saam 93</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1" />
    <char style="nd">Abọọñ</char> akara, ubọọñ asịne anye ke idem;</para>
  <para style="q2" vid="PSA 93:1">
    <char style="nd">Abọọñ</char> asịne ubọọñ ke idem, adudu anyʌñ ayọhọ anye idem;</para>
  <para style="q1" vid="PSA 93:1">ke akpanikọ, emaewuuk ederimbod ke itie amọ, asọñada inyʌññọ iwʌkkọ.<verse eid="PSA 93:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2" />Emaewuuk ebekpo mfo tọọñọ ke anyan ini;</para>
  <para style="q2" vid="PSA 93:2">afo adu tọọñọ ke nsi-nsi.<verse eid="PSA 93:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3" />
    <char style="nd">Abọọñ</char>, mme akpainyañ edịppe idem,</para>
  <para style="q2" vid="PSA 93:3">mme akpainyañ ebenne uyom ammọ;</para>
  <para style="q2" vid="PSA 93:3">mme akpainyañ ebenne uyom awawa ammọ.<verse eid="PSA 93:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4" />Anie adudu akan aduma ikpọ mmọọñ,</para>
  <para style="q2" vid="PSA 93:4">anie adudu akan mme ndubʌñ akpainyañ,</para>
  <para style="q2" vid="PSA 93:4">
    <char style="nd">Abọọñ</char> ke anyọñ akpon.<verse eid="PSA 93:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5" />
    <char style="nd">Abọọñ</char>, mme mbed mfo esọọñọ eda;</para>
  <para style="q2" vid="PSA 93:5">adisanaido ayọhọ ufọk mfo</para>
  <para style="q2" vid="PSA 93:5">ke nsi-nsi.<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="cl">Saam 94</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1" />
    <char style="nd">Abọọñ</char> ado Abasi a-asioho usiene.</para>
  <para style="q2" vid="PSA 94:1">O asio usiene Abasi, yamma!<verse eid="PSA 94:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2" />Abiideikpe ederimbod, dakka da;</para>
  <para style="q2" vid="PSA 94:2">nọ mbon ntañidem usiene se ikem ye ammọ.<verse eid="PSA 94:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3" />
    <char style="nd">Abọọñ</char>, adiikpeene die, ke mbon ibak,</para>
  <para style="q2" vid="PSA 94:3">mbon ibak ediidaara ikpeene die?<verse eid="PSA 94:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4" />Ammọ enwañña mme ikọ usọñanyen;</para>
  <para style="q2" vid="PSA 94:4">afịd mme anamidiọọk eyọhọ ye ñkpooninua.<verse eid="PSA 94:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5" />O <char style="nd">Abọọñ</char>, ammọ efiik ikọd mfo;</para>
  <para style="q2" vid="PSA 94:5">ammọ efiomo udeeme mfo.<verse eid="PSA 94:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6" />Ammọ ewot ebekpa ye asenawo;</para>
  <para style="q2" vid="PSA 94:6">ammọ ewoot nditọakpa.<verse eid="PSA 94:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7" />Ammọ ebo ete, “<char style="nd">Abọọñ</char> ikịtte;</para>
  <para style="q2" vid="PSA 94:7">Abasi Yekọb iseeghe.”<verse eid="PSA 94:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8" />Idat uwọdñkpọ, ndufo mbon unana iwuod ke atu mme awo;</para>
  <para style="q2" vid="PSA 94:8">ndufo mme ndisịme, idaha akee ke ediidiọọñọ idem?<verse eid="PSA 94:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9" />Nte andikibot utọñ ikoppo ñkpọ?</para>
  <para style="q2" vid="PSA 94:9">Nte andikibot anyen ikịtte ñkpọ?<verse eid="PSA 94:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10" />Nte anditʌnọ mme idịd ikemeke adinọ awo ufen?</para>
  <para style="q2" vid="PSA 94:10">Nte anye a-akpeebe ubonawo inieghe ifiọk?<verse eid="PSA 94:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11" />
    <char style="nd">Abọọñ</char> adiọọñọ afịd uduak awo;</para>
  <para style="q2" vid="PSA 94:11">anye adiọọñọ ke ammọ edo ikpu-ikpu.<verse eid="PSA 94:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12" />
    <char style="nd">Abọọñ</char>, afọfọn anọ awo ake afo atʌnọke,</para>
  <para style="q2" vid="PSA 94:12">anye ake afo akpeebe mbed mfo;<verse eid="PSA 94:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13" />afo anọ ammọ ifuuro ke usen mfịna,</para>
  <para style="q2" vid="PSA 94:13">tutu edọk ube enọ mbon ibak.<verse eid="PSA 94:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14" />Sia <char style="nd">Abọọñ</char> Abasi idiisịnne ikọd amọ;</para>
  <para style="q2" vid="PSA 94:14">anye ikemekekeme adikpọñ asaña-asaña udeeme amọ.<verse eid="PSA 94:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15" />Sia ubiideikpe ayaamaana awʌhọ ke adinenido,</para>
  <para style="q2" vid="PSA 94:15">ndin afịd mbon ndinen esịd eyaekeene anye.<verse eid="PSA 94:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16" />Anie adiidakka ida iñkeene miin inwana ye mbon ibak?</para>
  <para style="q2" vid="PSA 94:16">Anie adiidakka ida inwana ye mbon ibak innọ miin. Anie adiisọñ ida inwana ye mme anam idiọọk innọ miin?<verse eid="PSA 94:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17" />Imiikpidooho <char style="nd">Abọọñ</char> akenọọhọ unwam,</para>
  <para style="q2" vid="PSA 94:17">ñkpaakesọp ñkeba ke ndobo udi.<verse eid="PSA 94:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18" />Ke ini ami ñkebooho, “Ukod mmi afiọnnọ,”</para>
  <para style="q2" vid="PSA 94:18">nsọọñọnda ima mfo, <char style="nd">Abọọñ</char>, akemmʌm miin akama.<verse eid="PSA 94:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19" />Ke ini ami ñkenieghe akpọsọñ iduọesịd,</para>
  <para style="q2" vid="PSA 94:19">idọñesịd mfo akennọọ miin idaara.<verse eid="PSA 94:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20" />Nte ebekpo idiọọk uwem anie ewuana ye afo,</para>
  <para style="q2" vid="PSA 94:20">ebekpo a-adatta ukuud adi ato ke mme ewʌhọ amọ?<verse eid="PSA 94:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21" />Mbon ibak esoobo iwuod ebaña ndinen awo</para>
  <para style="q2" vid="PSA 94:21">enyʌñ ebiere ikpe ñkpa enọ mbon se imiidueghe.<verse eid="PSA 94:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22" />Ado <char style="nd">Abọọñ</char> a-akappa ado itie ubọkkọ mmi,</para>
  <para style="q2" vid="PSA 94:22">ye Abasi mmi, itiad ake ami ndịbeke.<verse eid="PSA 94:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23" />Anye ayaasio ammọ usiene idiọọkñkpọ ammọ</para>
  <para style="q2" vid="PSA 94:23">anyʌñ asobo ammọ ke ntak ibak ammọ;</para>
  <para style="q2" vid="PSA 94:23">
    <char style="nd">Abọọñ</char> Abasi ñnyịn ayaasobo ammọ.<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="cl">Saam 95</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1" />Ndufo idi, yak ikwọ ikwọ idaara inọ <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 95:1">yak isio ñkpo idaara inọ Itiad adinyaaña ñnyịn.<verse eid="PSA 95:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2" />Yak ñnyịn idi ke iso amọ ye ekọọm</para>
  <para style="q2" vid="PSA 95:2">inyʌñ itooro anye ke unek ye ikwọ.<verse eid="PSA 95:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3" />Sia <char style="nd">Abọọñ</char> ado akwa Abasi,</para>
  <para style="q2" vid="PSA 95:3">ekandịk Adidem akponno akan afịd mme abasi.<verse eid="PSA 95:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4" />Anye akama mme ntotəño esịd ederimbod ke ubọk amọ,</para>
  <para style="q2" vid="PSA 95:4">mme anyọñ abod enie anye ñko.<verse eid="PSA 95:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5" />Anye anie akpainyañ, sia anye akebot anye,</para>
  <para style="q2" vid="PSA 95:5">ubọk amọ ñko akebot nsaad isọñ.<verse eid="PSA 95:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6" />Ndufo edi, yak ñnyịn ituak iwuod ke ukpono</para>
  <para style="q2" vid="PSA 95:6">yak ñnyịn itọọñọ edọñ ke iso <char style="nd">Abọọñ</char> Andibod ñnyịn;<verse eid="PSA 95:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7" />sia anye ado Abasi ñnyịn,</para>
  <para style="q2" vid="PSA 95:7">ñnyịn ñko ido mbon awo ake anye abọọhọ,</para>
  <para style="q2" vid="PSA 95:7">mme ufene ake anye akpemeke.</para>
  <para style="b" vid="PSA 95:7" />
  <para style="q1" vid="PSA 95:7">Mfịn ami, adieke ndufo ekoppo uyio amọ,<verse eid="PSA 95:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8" />“Ikiisọñ esịd ndufo naña ekenam ke Meriba,</para>
  <para style="q2" vid="PSA 95:8">naña ndufo ekenam usen ado ke Masa ke anaan,<verse eid="PSA 95:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9" />itie a-mme eteete ndufo ekendomoke miin ese;</para>
  <para style="q2" vid="PSA 95:9">ammọ emaendomo miin, akpesʌkado ammọ emaekekịt se ami ñkenam.<verse eid="PSA 95:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10" />Ke isua aba, ami mmaayat esịd ye emana ado;</para>
  <para style="q2" vid="PSA 95:10">Ami mmaabo, ‘Ammọ edo mbon ake esịd ammọ awuọhọ akpọñ usʌñ,</para>
  <para style="q1" vid="PSA 95:10">ammọ inyʌññọ idiọọñọ usʌñ mmi.’<verse eid="PSA 95:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11" />Ndin ami mmaabo ke unwọñọ ke iyadesịd mmi,</para>
  <para style="q2" vid="PSA 95:11">‘Ammọ idiidʌkkọ ke nduọkadudu mmi.’ ”<verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="cl">Saam 96</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1" />Ikwọ ufa ikwọ inọ <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 96:1">afịd ederimbod ikwọ inọ <char style="nd">Abọọñ</char>.<verse eid="PSA 96:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2" />Ikwọ ikwọ inọ <char style="nd">Abọọñ</char>, itooro anyịñ amọ;</para>
  <para style="q2" vid="PSA 96:2">ibʌk adinyaaña amọ ke usen ke usen.<verse eid="PSA 96:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3" />Itañ ubọọñ amọ ke atu mme idịd,</para>
  <para style="q2" vid="PSA 96:3">mme utịppeñkpọ amọ ke atu afịd mme awo.<verse eid="PSA 96:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4" />Sia <char style="nd">Abọọñ</char> akpon anyʌñ adot itooro;</para>
  <para style="q2" vid="PSA 96:4">ado se ebaak anye ekan afịd mme abasi.<verse eid="PSA 96:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5" />Sia afịd mme abasi mme idịd edoñño ubobodñkpọ,</para>
  <para style="q2" vid="PSA 96:5">ado <char style="nd">Abọọñ</char> akenam mme hefịn.<verse eid="PSA 96:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6" />Uyai ye ukpono eba anye ke iso,</para>
  <para style="q2" vid="PSA 96:6">adudu ye ubọọñ eba ke adisana itie amọ.<verse eid="PSA 96:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7" />Ndufo inọ <char style="nd">Abọọñ</char>, afịd mme ubon ke mme idịd,</para>
  <para style="q2" vid="PSA 96:7">inọ <char style="nd">Abọọñ</char> ubọọñ ye adudu.<verse eid="PSA 96:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8" />Ndufo inọ <char style="nd">Abọọñ</char> ubọọñ a-adotto ye anyịñ amọ;</para>
  <para style="q2" vid="PSA 96:8">iben enọ idʌk idi ke mme akwere amọ.<verse eid="PSA 96:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9" />Ndufo ikpono <char style="nd">Abọọñ</char> ke uyai adisanaido amọ;</para>
  <para style="q2" vid="PSA 96:9">yak afịd ederimbod enyeñ idem ke iso amọ.<verse eid="PSA 96:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10" />Ibo ke atu mme idịd ite, “<char style="nd">Abọọñ</char> akaara.”</para>
  <para style="q2" vid="PSA 96:10">Ederimbod a-asọñ ada, isịkkeke ke itie amọ;</para>
  <para style="q2" vid="PSA 96:10">anye ayaabiide ikpe anọ mme awo ke unen.<verse eid="PSA 96:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11" />Yak mme anyọñ edaara, yak isọñ enem esịd;</para>
  <para style="q2" vid="PSA 96:11">yak inyañ ye afịd se idọñọ ke esịd ekpot.<verse eid="PSA 96:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12" />Yak inwañ ye afịd se idʌñọ ke anye enam idaara,</para>
  <para style="q2" vid="PSA 96:12">yak afịd mme eto ke akai ekwọ edaara.<verse eid="PSA 96:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13" />Yak afịd se ebot edaara ke iso <char style="nd">Abọọñ</char>, sia anye a-adi,</para>
  <para style="q2" vid="PSA 96:13">anye a-adi adibiide ikpe nnọọ ederimbod.</para>
  <para style="q2" vid="PSA 96:13">Anye ayaabiide ikpe ekondo ke unen</para>
  <para style="q2" vid="PSA 96:13">ye ake mme awo ke akpanikọ amọ.<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="cl">Saam 97</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1" />
    <char style="nd">Abọọñ</char> akara, yak ederimbod enem esịd;</para>
  <para style="q2" vid="PSA 97:1">yak mme esʌk edaara.<verse eid="PSA 97:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2" />Ntọñanyọñ ye akpọsọñ ekịm ekanna anye ekʌk;</para>
  <para style="q2" vid="PSA 97:2">adinenido mme unen edo itiad idakisọñ ebekpo amọ.<verse eid="PSA 97:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3" />Ikañ abem anye iso</para>
  <para style="q2" vid="PSA 97:3">anyʌñ ata mme asua amọ e-ekannake anye ekʌk.<verse eid="PSA 97:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4" />Akebkeb amọ anam ekondo ayamma;</para>
  <para style="q2" vid="PSA 97:4">ederimbod ekịt enyʌñ enyeñ idem.<verse eid="PSA 97:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5" />Mme ikpọabod etaara nte ndukpe ke iso <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 97:5">ke iso <char style="nd">Abọọñ</char> afịd iso isọñ.<verse eid="PSA 97:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6" />Mme hefịn ebʌk adinenido amọ,</para>
  <para style="q2" vid="PSA 97:6">afịd mme idịd ekịt ubọọñ amọ.<verse eid="PSA 97:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7" />Afịd mbon se ikpono mme ubobod usioidem ekịt abuud,</para>
  <para style="q2" vid="PSA 97:7">mbon se inam inua ke mme ubobodñkpọ,</para>
  <para style="q2" vid="PSA 97:7">ekpono anye, afịd ndufo mme abasi!<verse eid="PSA 97:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8" />Saiyọn akop anyʌñ adaara</para>
  <para style="q2" vid="PSA 97:8">ndin mme idʌñ ke Yuda enem esịd</para>
  <para style="q2" vid="PSA 97:8">ke ntak ubiideikpe mfo, <char style="nd">Abọọñ</char>.<verse eid="PSA 97:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9" />O <char style="nd">Abọọñ</char>, afo ado Andikoñ Ñkan ke afịd iso isọñ;</para>
  <para style="q2" vid="PSA 97:9">afo amekoñ akan afịd mme abasi.<verse eid="PSA 97:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10" />Yak mbon se ima <char style="nd">Abọọñ</char> esua idiọọkñkpọ,</para>
  <para style="q2" vid="PSA 97:10">sia anye akpeme uwem ndinen ikọd amọ</para>
  <para style="q2" vid="PSA 97:10">anyʌñ afak ammọ asio ke ubọk mbon ibak.<verse eid="PSA 97:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11" />Unwana ayamma anọ ndinen awo,</para>
  <para style="q2" vid="PSA 97:11">enyʌñ enọ mbon nti esịd idaara.<verse eid="PSA 97:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12" />Ndufo mme ndinen awo, idaara ke <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 97:12">inyʌñ itooro adisana anyịñ amọ.<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="cl">Saam 98</para>
  <para style="d">Saam</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1" />Ikwọ ufa ikwọ inọ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 98:1">sia anye anam mme utịppe ñkpọ;</para>
  <para style="q1" vid="PSA 98:1">ubọk nnasia amọ ye adisana ubọk amọ</para>
  <para style="q2" vid="PSA 98:1">enam adinyaaña enọ anye.<verse eid="PSA 98:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2" />
    <char style="nd">Abọọñ</char> anam yak ediọọñọ adinyaaña amọ</para>
  <para style="q2" vid="PSA 98:2">anyʌñ ayaara adinenido amọ anọ mme idịd.<verse eid="PSA 98:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3" />Anye amaatoiyo ima amọ</para>
  <para style="q2" vid="PSA 98:3">ye akpanikọ amọ anọ Isrel;</para>
  <para style="q1" vid="PSA 98:3">afịd mme utịd ederimbod ekịt</para>
  <para style="q2" vid="PSA 98:3">adinyaaña Abasi ñnyịn.<verse eid="PSA 98:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4" />Afịd ederimbod, isio ñkpo idaara inọ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 98:4">ibịmme isio ikwọ idaara ye mbre;<verse eid="PSA 98:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5" />ibre ikwọ ke ekpa inọ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 98:5">ibre ke ekpa ye uyioikwọ,<verse eid="PSA 98:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6" />ye adʌk ye uyom nnʌk akukịmedọñ,</para>
  <para style="q2" vid="PSA 98:6">isio ñkpo idaara ke iso <char style="nd">Abọọñ</char>, ye Adidem.<verse eid="PSA 98:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7" />Yak akpainyañ mme afịd se idọñọ ke esịd ekpot,</para>
  <para style="q2" vid="PSA 98:7">ekondo, ye afịd se idʌñ ke anye.<verse eid="PSA 98:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8" />Yak mme inyañ ekwak ubọk ammọ</para>
  <para style="q2" vid="PSA 98:8">yak mme ikpọabod ediana keed ekwọ ikwọ idaara;<verse eid="PSA 98:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9" />Yak ammọ ekwọ ke iso <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 98:9">sia anye asʌk adi adibiide ikpe nnọọ ederimbod.</para>
  <para style="q1" vid="PSA 98:9">Anye ayaabiide ikpe anọ ederimbod ke adinenido</para>
  <para style="q2" vid="PSA 98:9">anyʌñ anọ mme awo unen.<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="cl">Saam 99</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1" />
    <char style="nd">Abọọñ</char> akara,</para>
  <para style="q2" vid="PSA 99:1">yak mme idịd enyeñ idem;</para>
  <para style="q1" vid="PSA 99:1">anye atie ke ebekpo amọ ke atu mme serubim,</para>
  <para style="q2" vid="PSA 99:1">yak isọñ anyeeñe.<verse eid="PSA 99:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2" />
    <char style="nd">Abọọñ</char> akpon ke Saiyọn;</para>
  <para style="q2" vid="PSA 99:2">anye akoñ akan ke afịd mme idịd.<verse eid="PSA 99:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3" />Yak ammọ etooro ekandịk uteeñe anyịñ mfo;</para>
  <para style="q2" vid="PSA 99:3">anye ado adisana.<verse eid="PSA 99:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4" />Adidem akpon, anye ama unen,</para>
  <para style="q2" vid="PSA 99:4">afo amewuuk se ido adinen</para>
  <para style="q1" vid="PSA 99:4">afo amenam anọ Yekọb,</para>
  <para style="q2" vid="PSA 99:4">se inen inyʌñ ifọn.<verse eid="PSA 99:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5" />Ndufo itooro <char style="nd">Abọọñ</char> Abasi ñnyịn</para>
  <para style="q2" vid="PSA 99:5">inyʌñ ikpono anye ke itie udodukod amọ;</para>
  <para style="q2" vid="PSA 99:5">anye ado adisana.<verse eid="PSA 99:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6" />Moses mme Erọn ekeba ke atu mme aku amọ,</para>
  <para style="q2" vid="PSA 99:6">Samwel akedo keed ke atu mbon se ikikoot anyịñ amọ;</para>
  <para style="q2" vid="PSA 99:6">ammọ emaeseeme ekoot anyịñ <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 99:6">ndin anye amaabọọrọ ammọ.<verse eid="PSA 99:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7" />Anye aketañ ikọ ye ammọ ke abai ntọñanyọñ;</para>
  <para style="q2" vid="PSA 99:7">ammọ emaenịm mme mbed ye ewʌhọ se anye akenọọ ammọ.<verse eid="PSA 99:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8" />
    <char style="nd">Abọọñ</char> Abasi ñnyịn,</para>
  <para style="q2" vid="PSA 99:8">afo akebọọrọ ammọ;</para>
  <para style="q1" vid="PSA 99:8">afo akedo Abasi a-afeene anọ Isrel,</para>
  <para style="q2" vid="PSA 99:8">akpesʌkado afo akemiaha ammọ ufen ke ukwañido ammọ.<verse eid="PSA 99:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9" />Itooro <char style="nd">Abọọñ</char> Abasi ñnyịn</para>
  <para style="q2" vid="PSA 99:9">inyʌñ ikpono anye ke adisana abod amọ,</para>
  <para style="q2" vid="PSA 99:9">sia <char style="nd">Abọọñ</char> Abasi ñnyịn ado adisana.<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="cl">Saam 100</para>
  <para style="d">Saam. Ake adinọ itooro ekọọm</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1" />Ikwọ ikwọ idaara inọ <char style="nd">Abọọñ</char>, afịd ederimbod.<verse eid="PSA 100:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 100:2" />Ikpono <char style="nd">Abọọñ</char> ke inemesịd;</para>
  <para style="q2" vid="PSA 100:2">idi ke iso amọ ye mme ikwọ idaara.<verse eid="PSA 100:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3" />Ndufo idiọọñọ ibo ke <char style="nd">Abọọñ</char> ado Abasi.</para>
  <para style="q2" vid="PSA 100:3">Ado anye akibot ñnyịn, ñnyịn ñko ido ake amọ;</para>
  <para style="q2" vid="PSA 100:3">ñnyịn ido ikọd amọ, mme edọñ ake anye abọọhọ.<verse eid="PSA 100:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4" />Ndufo ikama ekọọm idʌk mme inuaatob amọ,</para>
  <para style="q2" vid="PSA 100:4">inyʌñ ikama itooro idʌk mme akwere amọ;</para>
  <para style="q2" vid="PSA 100:4">inọ anye ekọọm, inyʌñ itooro anyịñ amọ.<verse eid="PSA 100:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5" />Sia <char style="nd">Abọọñ</char> afọn, ima amọ anyʌñ aba ke nsi-nsi;</para>
  <para style="q2" vid="PSA 100:5">akpanikọ amọ anyʌñ akaiso aba ke afịd emana.<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="cl">Saam 101</para>
  <para style="d">Ake Defid. Saam.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1" />Ami ñyaakwọ ima ye adinen ikpe mfo;</para>
  <para style="q2" vid="PSA 101:1">
    <char style="nd">Abọọñ</char>, ami ñyaakwọ itooro mfo.<verse eid="PSA 101:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2" />Ami ñyaakpeme adidu uwem unana ndudue,</para>
  <para style="q2" vid="PSA 101:2">ini akee ke afo uduudi umbịne miin?</para>
  <para style="b" vid="PSA 101:2" />
  <para style="q1" vid="PSA 101:2">Ami ñyaanam ndubeghe ufọk mmi</para>
  <para style="q2" vid="PSA 101:2">ye esịd i-imiinieghe ubiomikpe.<verse eid="PSA 101:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3" />Ami ndiiseeghe ñkpọ ndomokeed a-adooho idiọọk</para>
  <para style="q2" vid="PSA 101:3">ke esịd unyịmme.</para>
  <para style="b" vid="PSA 101:3" />
  <para style="q1" vid="PSA 101:3">Ami mmesua se mbon unana mbuọdidem enam;</para>
  <para style="q2" vid="PSA 101:3">Ami ndiinieghe udeeme ke se ammọ enam.<verse eid="PSA 101:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4" />Mbon e-ewọññọke ekpọñ usʌñ eyaeda nsan-nsan eñkpọñ miin;</para>
  <para style="q2" vid="PSA 101:4">Ami ndiinieghe ñkpọ ndomokeed adinam ye se ido idiọọk.<verse eid="PSA 101:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5" />Awo keed akeedodo a-atañña idiọọk ikọ abaña mbọhọidʌñ ammọ ke ndịbe,</para>
  <para style="q2" vid="PSA 101:5">ami ñyaakʌp anye inua;</para>
  <para style="q1" vid="PSA 101:5">ami ndiiyọọhọ awo keed akeedodo,</para>
  <para style="q2" vid="PSA 101:5">a-akamake anyen usua ye esịd ntañidem.<verse eid="PSA 101:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6" />Anyen mmi adiise mbon e-enamma akpanikọ ke abio,</para>
  <para style="q2" vid="PSA 101:6">nọ ammọ ekpedʌñ ye ami;</para>
  <para style="q1" vid="PSA 101:6">awo i-isañ ammọ imiinieghe ndudue</para>
  <para style="q2" vid="PSA 101:6">ayaanam ñkpọ annọ miin.<verse eid="PSA 101:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7" />Awo ndomokeed a-anamma utom abiaña</para>
  <para style="q2" vid="PSA 101:7">idiidʌññọ ke ufọk mmi;</para>
  <para style="q1" vid="PSA 101:7">Awo ndomokeed a-asʌhọke nsu</para>
  <para style="q2" vid="PSA 101:7">idiidaaha ke iso mmi.<verse eid="PSA 101:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8" />Kwa ubakusen ami ñyaakʌp</para>
  <para style="q2" vid="PSA 101:8">afịd mbon ibak e-ebaññake ke abio inua;</para>
  <para style="q1" vid="PSA 101:8">ami ñyaasobo afịd mme anamidiọọk</para>
  <para style="q2" vid="PSA 101:8">ke abio <char style="nd">A-Abọọñ</char> anieghe.<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="cl">Saam 102<note caller="+" style="f"><char style="fr" closed="false">102:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 102:1-28 ewet Saam 102:2-29</char></note></para>
  <para style="d">Akam awo ñkpọnnam i-idem amemme ndin anye anam aseeme anọ <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1" />
    <char style="nd">Abọọñ</char>, kop akam mmi;</para>
  <para style="q2" vid="PSA 102:1">yak ayịd uyem adinyaaña mmi adi ubịne fiin.<verse eid="PSA 102:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2" />Kundịp miin iso mfo</para>
  <para style="q2" vid="PSA 102:2">ke ini ami mbaaha ke itie ukuud.</para>
  <para style="q1" vid="PSA 102:2">Kpañ utọñ nnọ miin;</para>
  <para style="q2" vid="PSA 102:2">ami mmaukoot, sọp mbọọrọ miin.<verse eid="PSA 102:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3" />Sia usen mmi asop nte nsʌñikañ;</para>
  <para style="q2" vid="PSA 102:3">akpọ mmi asak nte ifiaikañ.<verse eid="PSA 102:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4" />Esịd mmi abʌññọ anyʌñ ayeeme nte mbid;</para>
  <para style="q2" vid="PSA 102:4">ami mmefre adidia ndidia mmi.<verse eid="PSA 102:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5" />Ke ukuud mmi ami ñkuun ke akpọsọñ uyio</para>
  <para style="q2" vid="PSA 102:5">ndisʌhọ ikpaidem ye akpọ.<verse eid="PSA 102:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6" />Ami mba nte ñkịdikịd akpautatan,</para>
  <para style="q2" vid="PSA 102:6">nte ñkịdikịd ke atu ñwuudo itie.<verse eid="PSA 102:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7" />Ami ntaba idab; ndikappa mba</para>
  <para style="q2" vid="PSA 102:7">nte asaña ikpọọñ inuen ke anyọñ akọm.<verse eid="PSA 102:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8" />Mme asua mmi ensuenne miin afịd usen;</para>
  <para style="q2" vid="PSA 102:8">mbon e-ebọññọ ñkpo ke iwuod mmi ekama anyịñ mmi enam isuuñọ.<verse eid="PSA 102:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9" />Sia ami ndia ntọñ nte ndidia</para>
  <para style="q2" vid="PSA 102:9">ñnyʌñ ñwuaha se ñnwọñ ye mmọọñayịd<verse eid="PSA 102:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10" />ke ntak akwa ifiobesịd mfo,</para>
  <para style="q2" vid="PSA 102:10">sia afo amembenne miin ke anyọñ anyʌñ antop miin aduọọk.<verse eid="PSA 102:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11" />Mme usen mmi ebañña nte ndukpọñ ndubiayio;</para>
  <para style="q2" vid="PSA 102:11">ami mmeyeeme nte mbid.<verse eid="PSA 102:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12" />Ado afo, <char style="nd">Abọọñ</char>, atie ke ebekpo ke nsi-nsi;</para>
  <para style="q2" vid="PSA 102:12">anyịñ mfo ayaaba ke afịd emana.<verse eid="PSA 102:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13" />Afo ayaadakkada atua Saiyọn mbọm,</para>
  <para style="q2" vid="PSA 102:13">sia ini akem afo adiwọt anye mfọnido;</para>
  <para style="q2" vid="PSA 102:13">akemini ado a-adisịm.<verse eid="PSA 102:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14" />Sia mme itiad amọ e-enem nditọufọk mfo esịd;</para>
  <para style="q2" vid="PSA 102:14">ntọñ amọ a-anam ammọ enie mbọm.<verse eid="PSA 102:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15" />Mme idịd eyaebaak anyịñ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 102:15">afịd mme ndidem ke ekondo eyaekpono ubọọñ mfo.<verse eid="PSA 102:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16" />Sia <char style="nd">Abọọñ</char> ayaamaana abọp Saiyọn</para>
  <para style="q2" vid="PSA 102:16">anyʌñ awuọ ada ke ubọọñ amọ.<verse eid="PSA 102:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17" />Anye ayaabọọrọ akam mbon ñkpọnnam</para>
  <para style="q2" vid="PSA 102:17">anye idiisịnne ebeeñe ammọ ke ndek.<verse eid="PSA 102:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18" />Yak ewet ñkpọ ami enịm enọ emana ini iso</para>
  <para style="q2" vid="PSA 102:18">ke mbon a-awo imiibotto diin editooro <char style="nd">Abọọñ</char>:<verse eid="PSA 102:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19" />“<char style="nd">Abọọñ</char> atie ke adisana itie amọ ke anyọñ asuuk anyen ase,</para>
  <para style="q2" vid="PSA 102:19">anye amaatie ke hefịn ase ederimbod,<verse eid="PSA 102:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20" />nọ akop aseeme mbon ñkpakọb</para>
  <para style="q2" vid="PSA 102:20">anyʌñ asaana mbon se emaekebiere ikpe ñkpa enọ ayaak.”<verse eid="PSA 102:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21" />Eyaesian anyịñ <char style="nd">Abọọñ</char> ke Saiyọn</para>
  <para style="q2" vid="PSA 102:21">ye itooro amọ ke Yeruselem<verse eid="PSA 102:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22" />ke ini mme awo ye mme idịd</para>
  <para style="q2" vid="PSA 102:22">ebohoke adikpono <char style="nd">Abọọñ</char>.<verse eid="PSA 102:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23" />Ke isañ uwem mmi, anye amaabuuñ adudu mmi;</para>
  <para style="q2" vid="PSA 102:23">amaakpịkke isua uwem mmi.<verse eid="PSA 102:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24" />Ke ntoro ami mmaabo:</para>
  <para style="q1" vid="PSA 102:24">“Abasi mmi, kumbenne miin usio, ke ufọọd mme usen mmi;</para>
  <para style="q2" vid="PSA 102:24">mme isua mfo ekakaiso eba ke afịd emana.<verse eid="PSA 102:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25" />Ke aditọọñọ afo akesịn itiad idakisọñ ederimbod,</para>
  <para style="q2" vid="PSA 102:25">mme hefịn enyʌñ edo ubọkutom mfo.<verse eid="PSA 102:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26" />Ammọ eyaetak, ado afo asʌk abaaba;</para>
  <para style="q2" vid="PSA 102:26">afịd ammọ eyaetaha nte afọñ.</para>
  <para style="q1" vid="PSA 102:26">Afo ayaakpuuñọ ammọ nte afọñ</para>
  <para style="q2" vid="PSA 102:26">ndin eyaetop ammọ eduọọñọ.<verse eid="PSA 102:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27" />Ado afo ukpʌhọke,</para>
  <para style="q2" vid="PSA 102:27">mme isua mfo idiinyʌññọ inie utịd.<verse eid="PSA 102:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28" />Nditọ mme nditọufọk mfo eyaedʌñ ke iso mfo;</para>
  <para style="q2" vid="PSA 102:28">ubon ammọ eyaesọọñọ eda ke iso mfo.”<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="cl">Saam 103</para>
  <para style="d">Ake Defid.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1" />Ukpọñ mmi, tooro <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 103:1">afịd se imba miin ke idem, tooro adisana anyịñ amọ.<verse eid="PSA 103:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2" />Ukpọñ mmi tooro <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 103:2">kuunyʌñ ufre afịd mfọn amọ,<verse eid="PSA 103:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3" />anye a-afeene afịd ndiọiñkpọ mfo</para>
  <para style="q2" vid="PSA 103:3">anyʌñ ukọk fiin afịd udọñọ mfo,<verse eid="PSA 103:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4" />anye a-afakka uwem mfo asio ke ube</para>
  <para style="q2" vid="PSA 103:4">anyʌñ aben ima ye mbọm uyat fiin nte anyanya,<verse eid="PSA 103:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5" />anye a-anọọhọ mme udọñ mfo uyʌkkọ nti ñkpọ</para>
  <para style="q2" vid="PSA 103:5">nọ ato do uyịn mfo aseghe nte ake ntrukpuum.<verse eid="PSA 103:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6" />
    <char style="nd">Abọọñ</char> anam adinenido</para>
  <para style="q2" vid="PSA 103:6">anyʌñ abiide unenikpe anọ afịd mbon e-efiighe.<verse eid="PSA 103:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7" />Anye amaanam Moses adiọọñọ usʌñ amọ,</para>
  <para style="q2" vid="PSA 103:7">mme adinam amọ ke abaña nditọ Isrel:<verse eid="PSA 103:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8" />
    <char style="nd">Abọọñ</char> a-anie mbọm anyʌñ afọn ido,</para>
  <para style="q2" vid="PSA 103:8">isọppọ iyadesịd, ayọhọ ye ima.<verse eid="PSA 103:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9" />Anye idiidotto awo uyio afịd ini,</para>
  <para style="q2" vid="PSA 103:9">inyʌññọ iyadesịd ke nsi-nsi;<verse eid="PSA 103:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10" />anye inamma ñkpọ ye ñnyịn ikeene naña mme idiọọkñkpọ ñnyịn edo</para>
  <para style="q2" vid="PSA 103:10">inyʌññọ ikpe ñnyịn utịb ikeene mme nnamndue ñnyịn.<verse eid="PSA 103:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11" />Sia naña anyọñ anyọọñ akpọñ isọñ,</para>
  <para style="q2" vid="PSA 103:11">ima amọ anyʌñ akpon ntoro anọ mbon se ibaak anye;<verse eid="PSA 103:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12" />sia kpa naña usakkautịn anyọọñ akpọñ usobutịn,</para>
  <para style="q2" vid="PSA 103:12">kpa ntoro ke anye aben ndudue ñnyịn asio ikpọñ ñnyịn.<verse eid="PSA 103:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13" />Kpa naña ete anie mbọm abaña nditọ ammọ,</para>
  <para style="q2" vid="PSA 103:13">kpa ntoro ke <char style="nd">Abọọñ</char> anie mbọm anọ mbon se ibaak anye;<verse eid="PSA 103:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14" />sia anye a-adiọọñọ naña ekibot ñnyịn,</para>
  <para style="q2" vid="PSA 103:14">anye a-atoiyo ke ñnyịn ido abu.<verse eid="PSA 103:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15" />Uwem mme aduuwem aba nte mbid,</para>
  <para style="q2" vid="PSA 103:15">ammọ eseghe nte ñkpokpoñ a-abaaha ke inwañ;<verse eid="PSA 103:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16" />afịm, afịm anye ndin anye asop,</para>
  <para style="q2" vid="PSA 103:16">awo itoiyoke itie amọ aba.<verse eid="PSA 103:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17" />Ado tọọñọ ke nsi-nsi tutu ke nsi-nsi</para>
  <para style="q2" vid="PSA 103:17">ima <char style="nd">Abọọñ</char> aba ye mbon se ibaak anye,</para>
  <para style="q2" vid="PSA 103:17">adinenido amọ anyʌñ aba anọ nditọnditọ ammọ,<verse eid="PSA 103:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18" />ye mbon e-enịmme edioomo amọ</para>
  <para style="q2" vid="PSA 103:18">enyʌñ etoiyo adinịm mme mbed amọ.<verse eid="PSA 103:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19" />
    <char style="nd">Abọọñ</char> amaawuuk ebekpo amọ ke anyọñ,</para>
  <para style="q2" vid="PSA 103:19">ndin abioubọọñ amọ akaara afịd ñkpọ.<verse eid="PSA 103:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20" />Ndufo mme enyere amọ, itooro <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 103:20">ndufo mme ñkpọsọñ awo e-enamma se anye ayem,</para>
  <para style="q2" vid="PSA 103:20">mbon e-ekoppo item enọ ikọ amọ.<verse eid="PSA 103:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21" />Afịd mme udịm anyọñ, itooro <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 103:21">ndufo afịd nditọufọk amọ e-enamma uduak amọ.<verse eid="PSA 103:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22" />Itooro <char style="nd">Abọọñ</char> afịd ubọkutom amọ,</para>
  <para style="q2" vid="PSA 103:22">ke afịd itie ukara amọ.</para>
  <para style="b" vid="PSA 103:22" />
  <para style="q1" vid="PSA 103:22">Ukpọñ mmi, tooro <char style="nd">Abọọñ</char>.<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="cl">Saam 104</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1" />Ukpọñ mmi, tooro <char style="nd">Abọọñ</char>.</para>
  <para style="b" vid="PSA 104:1" />
  <para style="q1" vid="PSA 104:1">
    <char style="nd">Abọọñ</char> Abasi mmi, afo ado ataa akpọsọñ,</para>
  <para style="q2" vid="PSA 104:1">afo ameyọhọ ye ubọọñ mme uyai.<verse eid="PSA 104:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2" />
    <char style="nd">Abọọñ</char> aben unwana awañ idem amọ nte ewịra;</para>
  <para style="q2" vid="PSA 104:2">anye adette mme hefịn nte ekamba atayad<verse eid="PSA 104:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 104:3" />anye anyʌñ abịt abom ubeed anyọñ amọ ke mme mmọọñ ammọ,</para>
  <para style="q1" vid="PSA 104:3">Anye anam ntọñanyọñ ado sariọd amọ</para>
  <para style="q2" vid="PSA 104:3">anyʌñ awat ke mba afịm.<verse eid="PSA 104:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4" />Anye anam mme afịm edo isʌñutom<note caller="+" style="f"><char style="fr" closed="false">104:4 </char><char style="ft" closed="false">Akeme ido </char><char style="fqa" closed="false">mme enyere</char></note> amọ,</para>
  <para style="q2" vid="PSA 104:4">mme edemeikañ edo nditọufọk amọ.<verse eid="PSA 104:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5" />Anye anịm ederimbod ke itiad idakisọñ;</para>
  <para style="q2" vid="PSA 104:5">ñkpọ ituudo anye tutu amama.<verse eid="PSA 104:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6" />Afo afʌk anye ye ntotəño mmọọñ nte ewịra;</para>
  <para style="q2" vid="PSA 104:6">mme mmọọñ emaeda ke anyọñ abod.<verse eid="PSA 104:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7" />Ado ke nsuannọ mfo mme mmọọñ esat,</para>
  <para style="q2" vid="PSA 104:7">ke uyio aduma mfo ammọ emaefeeñe;<verse eid="PSA 104:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8" />ammọ efiọọrọ ke anyọñ mme ikpọabod,</para>
  <para style="q2" vid="PSA 104:8">esọiyọ edʌk ke abedeñ,</para>
  <para style="q2" vid="PSA 104:8">ekaa itie a-afo akenịmme anọọ ammọ.<verse eid="PSA 104:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9" />Afo amaanịm adaña a-ammọ imiidikanna iboiyo;</para>
  <para style="q2" vid="PSA 104:9">tutu amama ammọ idiifʌkkọ isọñ aba.<verse eid="PSA 104:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10" />Anye anam mmọọñ idịm anwañña mmọọñ adọñ ke mme abedeñ</para>
  <para style="q2" vid="PSA 104:10">anye afiọrọ ke ufọọd ikpọabod.<verse eid="PSA 104:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11" />Ammọ enọ afịd mme unam ikọd mmọọñ;</para>
  <para style="q2" vid="PSA 104:11">mme dọñki ikọd esuuk nsaditọñ ammọ.<verse eid="PSA 104:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12" />Mme inuen ke ikpaanyọñ ebọp ufọk ke mben mmọọñ;</para>
  <para style="q2" vid="PSA 104:12">ammọ edoro ke ñkọk eto ekwọ ikwọ.<verse eid="PSA 104:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13" />Anye atie ke ntotəño ubeed amọ aduọi mmọọñ ke anyọñ abod,</para>
  <para style="q2" vid="PSA 104:13">isọñ akop uyʌkkọ ato mfịd ubọkutom amọ.<verse eid="PSA 104:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14" />Anye anam nọ mbid atịppe anọ mme enañ,</para>
  <para style="q2" vid="PSA 104:14">ñko ñkpọ inwañ aba se mme awo etọ,</para>
  <para style="q2" vid="PSA 104:14">asio ndidia ato isọñ awuọ adi:<verse eid="PSA 104:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15" />mmịn a-anọọhọ awo idadesịd,</para>
  <para style="q2" vid="PSA 104:15">adan a-anamma iso ammọ ayamma,</para>
  <para style="q2" vid="PSA 104:15">ye uyo a-anọọhọ esịd ammọ uyʌkkọ.<verse eid="PSA 104:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16" />E-enekke eduọk mmọọñ enọ mme eto <char style="nd">Abọọñ</char> mfọn-mfọn,</para>
  <para style="q2" vid="PSA 104:16">mme sida Lebanọn a-anye aketọọhọ.<verse eid="PSA 104:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17" />Do ke mme inuen ebọp efọk ammọ;</para>
  <para style="q2" vid="PSA 104:17">ikpañinyañ anie itie idʌñ amọ ke mme yunipa.<verse eid="PSA 104:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18" />Mme ñkoñ-ñkoñ ikpọabod enie mme ebod ikọd;</para>
  <para style="q2" vid="PSA 104:18">mme abaitiad edo itie udịbe enọ mme ntəkenañ.<verse eid="PSA 104:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19" />Anye amaanam afiọñ nọ awʌt ini,</para>
  <para style="q2" vid="PSA 104:19">ñko utịn adiọọñọ ini se asuuhọ.<verse eid="PSA 104:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20" />Afo aben ekịm adi, anye akappa ado akonayio,</para>
  <para style="q2" vid="PSA 104:20">ndin afịd mme unam ke akai editiatiaara.<verse eid="PSA 104:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21" />Mme ekpe ekuun eyem se emʌm</para>
  <para style="q2" vid="PSA 104:21">enyʌñ eyem ndidia ammọ eto Abasi.<verse eid="PSA 104:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22" />Utịn asakka ndin ammọ edịbe;</para>
  <para style="q2" vid="PSA 104:22">nọ ammọ etịmme enyọñ edina ke mme ube ammọ.<verse eid="PSA 104:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23" />Ndin mme awo ewuọñọ ekaiya utom ammọ</para>
  <para style="q2" vid="PSA 104:23">enyʌñ enam utom ammọ tutu ndubiayio.<verse eid="PSA 104:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24" />
    <char style="nd">Abọọñ</char>, mme utom mfo ewak die?</para>
  <para style="q2" vid="PSA 104:24">Ke aniọñ ke afo akenam afịd ammọ;</para>
  <para style="q2" vid="PSA 104:24">ederimbod ayọhọ ye se afo aboot.<verse eid="PSA 104:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25" />Akpainyañ aba, akpon anyʌñ atara,</para>
  <para style="q2" vid="PSA 104:25">ayọhọ ye mme unam se awo imiikanna ibat,</para>
  <para style="q2" vid="PSA 104:25">mme aduuwem ñkpọ, ikpọ ye ntək.<verse eid="PSA 104:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26" />Do ke nsʌñikañ efiọọrọ ekaa iso ye edem,</para>
  <para style="q2" vid="PSA 104:26">ye idiọọk unam mmọọñ, a-afo akebotto yak abre mbre do.<verse eid="PSA 104:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27" />Afịd se afo akebot ekama anyen use fiin</para>
  <para style="q2" vid="PSA 104:27">yak anọ ammọ ndidia ke akemini.<verse eid="PSA 104:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28" />Afo amaanọ ammọ,</para>
  <para style="q2" vid="PSA 104:28">ammọ ekpuut ebon;</para>
  <para style="q1" vid="PSA 104:28">afo amaatat ubọk,</para>
  <para style="q2" vid="PSA 104:28">ammọ enie uyʌkkọ nti ñkpọ.<verse eid="PSA 104:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29" />Afo umaudịp iso mfo,</para>
  <para style="q2" vid="PSA 104:29">akpọsọñ ndịk amʌm ammọ;</para>
  <para style="q1" vid="PSA 104:29">umaubọ ammọ inweek,</para>
  <para style="q2" vid="PSA 104:29">ammọ ekpañña emaana ekappa ntọñ.<verse eid="PSA 104:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30" />Afo umaudọñ Sịbidịd mfo,</para>
  <para style="q2" vid="PSA 104:30">eboot ammọ,</para>
  <para style="q2" vid="PSA 104:30">afo amaana ademme iso isọñ.<verse eid="PSA 104:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31" />Yak ubọọñ <char style="nd">Abọọñ</char> aba ke nsi-nsi;</para>
  <para style="q2" vid="PSA 104:31">yak Abasi adat esịd ke mme utom amọ,<verse eid="PSA 104:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32" />anye a-aseeghe ederimbod, ndin ederimbod anyeñ,</para>
  <para style="q2" vid="PSA 104:32">anye ake atuuhọ mme abod, ndin ammọ esio nsʌñikañ.<verse eid="PSA 104:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33" />Ami ñyaakwọ nnọ <char style="nd">Abọọñ</char> ke afịd ayio uwem mmi;</para>
  <para style="q2" vid="PSA 104:33">ami ñyaakwọ itooro nnọ Abasi mmi ke adaña nte mbaaha ke uwem.<verse eid="PSA 104:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34" />Yak akikere esịd mmi anem anye esịd,</para>
  <para style="q2" vid="PSA 104:34">ke naña ami ndat esịd ke <char style="nd">Abọọñ</char>.<verse eid="PSA 104:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35" />Ado yak mme anamidiọọk esop ke iso isọñ</para>
  <para style="q2" vid="PSA 104:35">ñko mbon ibak ekuuba aba.</para>
  <para style="b" vid="PSA 104:35" />
  <para style="q1" vid="PSA 104:35">Ukpọñ mmi, tooro <char style="nd">Abọọñ</char>.</para>
  <para style="b" vid="PSA 104:35" />
  <para style="q1" vid="PSA 104:35">Tooro <char style="nd">Abọọñ</char>.<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="cl">Saam 105</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1" />Nọ <char style="nd">Abọọñ</char> itooro, sian anyịñ amọ;</para>
  <para style="q2" vid="PSA 105:1">nam nọ afịd idịd ediọọñọ ebaña se anye anam.<verse eid="PSA 105:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2" />Ikwọ inọ anye, ikwọ itooro inọ anye;</para>
  <para style="q2" vid="PSA 105:2">itañ ibaña afịd mme utịppe adinam se anye anam.<verse eid="PSA 105:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3" />Ubọọñ anie adisana anyịñ amọ;</para>
  <para style="q2" vid="PSA 105:3">yak esịd mbon e-eyemme <char style="nd">Abọọñ</char> edaara.<verse eid="PSA 105:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4" />Iwuuk anyen ise <char style="nd">Abọọñ</char> ye adudu amọ;</para>
  <para style="q2" vid="PSA 105:4">iyem iso amọ afịd-afịd ini.<verse eid="PSA 105:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5" />Itoiyo mme utịppeñkpọ se anye anam,</para>
  <para style="q2" vid="PSA 105:5">mme utịppeñkpọ amọ, ye mme ubiideikpe a-anye akenọọhọ,<verse eid="PSA 105:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6" />ndufo mme isʌñutom amọ, mme ntịppe ubon Ebraham,</para>
  <para style="q2" vid="PSA 105:6">mme andimek amọ, nditọ Yekọb.<verse eid="PSA 105:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7" />Anye ado <char style="nd">Abọọñ</char> Abasi ñnyịn;</para>
  <para style="q2" vid="PSA 105:7">mme ubiideikpe amọ aba ke afịd ederimbod.<verse eid="PSA 105:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8" />Anye atoiyo edioomo amọ ke nsi-nsi</para>
  <para style="q2" vid="PSA 105:8">enwọñọ anye akenamma ke tọsịn emana,<verse eid="PSA 105:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9" />edioomo a-anye akenamma ye Ebraham,</para>
  <para style="q2" vid="PSA 105:9">enwọñọ a-anye akenwọñọke anọ Aisik.<verse eid="PSA 105:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10" />Anye amaasọọñọ ami anọ Yekọb nte ewʌhọ;</para>
  <para style="q2" vid="PSA 105:10">anọ Isrel nte nsi-nsi edioomo:<verse eid="PSA 105:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11" />“Ami ñyainọ ndufo isọñ Kenan</para>
  <para style="q2" vid="PSA 105:11">nte udeeme ndufo.”<verse eid="PSA 105:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12" />Ke idaha ammọ imiikiwakka ke ibad,</para>
  <para style="q2" vid="PSA 105:12">enekke esịp, enyʌñ edo isenawo ke Kenan,<verse eid="PSA 105:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13" />ammọ emaeyoon eto idịd keed esịm idịd mfen,</para>
  <para style="q2" vid="PSA 105:13">etọọñọ ke abioubọọñ keed tutu ekesịm mfen.<verse eid="PSA 105:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14" />Anye ikiyakka awo ndomokeed afiik ammọ;</para>
  <para style="q2" vid="PSA 105:14">ke ntak ammọ anye amaasua anọ mme ndidem:<verse eid="PSA 105:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15" />“Ikiituuk mbon se ami mmaakeyet adan;</para>
  <para style="q2" vid="PSA 105:15">ikiinam mme prọfed mmi idiọọkñkpọ.”<verse eid="PSA 105:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16" />Anye amaanam akañ aba ke isọñ</para>
  <para style="q2" vid="PSA 105:16">anyʌñ abiat afịd usʌñ ammọ ekpedatta enie ndidia;<verse eid="PSA 105:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17" />ñko anye amaadọñ awodeen abem ammọ iso,</para>
  <para style="q2" vid="PSA 105:17">Yosef, ekenyamma nte afʌn.<verse eid="PSA 105:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18" />Ammọ emaenuak anye ukod ke akpọnọ,</para>
  <para style="q2" vid="PSA 105:18">ekọp anye itọñ ke ukwak,<verse eid="PSA 105:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19" />tutu se anye aketañ abaña awuọ asu,</para>
  <para style="q2" vid="PSA 105:19">tutu ikọ <char style="nd">Abọọñ</char> awuọ adomo awọt ke anye ado anam akpanikọ.<verse eid="PSA 105:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20" />Adidem amaadọñ abo yak etat anye esuuk,</para>
  <para style="q2" vid="PSA 105:20">andikara mme awo asaana anye ayaak.<verse eid="PSA 105:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21" />Anye amaanam anye ado etubom ke ufọk amọ,</para>
  <para style="q2" vid="PSA 105:21">andikara afịd se anye anie,<verse eid="PSA 105:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22" />nọ akpeep nditọ mbọọñ amọ se ekpenam naña anemme anye,</para>
  <para style="q2" vid="PSA 105:22">anyʌñ akpeep ñkpisọñ amọ aniọñ.<verse eid="PSA 105:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23" />Ndin Isrel emaedʌk Iyib;</para>
  <para style="q2" vid="PSA 105:23">Yekọb akedʌñ ke isọñ Ham nte asenawo<verse eid="PSA 105:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24" />
    <char style="nd">Abọọñ</char> amaanam mbio amọ enekke etọt;</para>
  <para style="q2" vid="PSA 105:24">anye amaanam ammọ enekke ewak ekan mme asua ammọ,<verse eid="PSA 105:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25" />mbon a-anye akesioho esịd ammọ asịn nọ esua ikọd amọ,</para>
  <para style="q2" vid="PSA 105:25">nọ edʌk idiọọk adu ebaña nditọufọk amọ.<verse eid="PSA 105:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26" />Anye amaadọñ Moses ayịnufọk amọ,</para>
  <para style="q2" vid="PSA 105:26">ye Erọn a-anye akemekke.<verse eid="PSA 105:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27" />Ammọ emaenam mme idiọọñọ amọ ke atu ammọ,</para>
  <para style="q2" vid="PSA 105:27">mme utịppeñkpọ amọ ke abio Ham.<verse eid="PSA 105:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28" />Anye amaadọñ ekịm anyʌñ anam isọñ akịm,</para>
  <para style="q2" vid="PSA 105:28">sia akpedo ammọ ikisọññọ iwuod ke ikọ amọ?<verse eid="PSA 105:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29" />Anye amaanam mmọọñ ammọ akappa ado iyiib,</para>
  <para style="q2" vid="PSA 105:29">ado anam iyak ammọ ekpañña.<verse eid="PSA 105:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30" />Mfuọd emaeyọhọ ke isọñ ammọ,</para>
  <para style="q2" vid="PSA 105:30">akedọọhọ akewuọ mme esịdubeed mme adidem ammọ.<verse eid="PSA 105:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31" />Anye amaatañ ikọ, ndin eboho nsʌñ ediyọhọ,</para>
  <para style="q2" vid="PSA 105:31">ye ebu ke afịd abio ammọ.<verse eid="PSA 105:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32" />Anye amaanam edịm ammọ akappa ado edịmitiad,</para>
  <para style="q2" vid="PSA 105:32">ye akebkeb ke afịd isọñ ammọ;<verse eid="PSA 105:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33" />anye amaanua mme eto fain ye fik ammọ atọọñ</para>
  <para style="q2" vid="PSA 105:33">anyʌñ abʌñ mme eto ke idịd ammọ.<verse eid="PSA 105:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34" />Anye amaatañ ikọ, ndin mme ñkukuñkpọyọriyọ emaedi,</para>
  <para style="q2" vid="PSA 105:34">mme ananaibad ataktak;<verse eid="PSA 105:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35" />ammọ emaeta afịd awawa ñkpọ ke isọñ ammọ,</para>
  <para style="q2" vid="PSA 105:35">eta se ammọ ekebʌkkọ ke isọñ ammọ.<verse eid="PSA 105:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36" />Ndin anye amaawoot afịd mme ntommana ke idʌñ ammọ,</para>
  <para style="q2" vid="PSA 105:36">mme akpa mfịd ammọ nte ideen.<verse eid="PSA 105:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37" />Anye amaaben Isrel asio, ammọ ekọọhọ silfa ye kold,</para>
  <para style="q2" vid="PSA 105:37">ke ufọọd esiin ammọ awo ndomokeed ifʌmmọke.<verse eid="PSA 105:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38" />Iyib emaenem esịd idaha ammọ ekenyọññọ,</para>
  <para style="q2" vid="PSA 105:38">sia ndịk Isrel amaamʌm ammọ.<verse eid="PSA 105:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39" />Anye amaaben ntọñanyọñ anịm nte ufʌkñkpọ</para>
  <para style="q2" vid="PSA 105:39">ye ikañ nọ anọ unwana akonayio.<verse eid="PSA 105:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40" />Ammọ emaebeeñe, ndin anye amaanọ ammọ asasa;</para>
  <para style="q2" vid="PSA 105:40">anye amaanọ ammọ ndidia ayʌkkọ ye uyo a-atooho anyọñ.<verse eid="PSA 105:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41" />Anye amaakʌppọ itiad, ndin mmọọñ awuọñọ;</para>
  <para style="q2" vid="PSA 105:41">awuọ nte inyañ ke akpautatan.<verse eid="PSA 105:41" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42" />Sia anye amaatoiyo adisana enwọñọ amọ</para>
  <para style="q2" vid="PSA 105:42">anye akenọọhọ ayịnufọk amọ Ebraham.<verse eid="PSA 105:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43" />Anye amaasịññe mbon amọ ye inemesịd,</para>
  <para style="q2" vid="PSA 105:43">mbon se anye akemek ye ñkpo idaara;<verse eid="PSA 105:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44" />anye amaanọ ammọ isọñ mme idịd,</para>
  <para style="q2" vid="PSA 105:44">ndin ammọ emaekappa edoñño mme adiaakpa enie se mbon mfen ekekpakpa utom;<verse eid="PSA 105:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45" />Nọ ammọ enịm mme ewʌhọ amọ</para>
  <para style="q2" vid="PSA 105:45">enyʌñ enịm mme mbed amọ.</para>
  <para style="b" vid="PSA 105:45" />
  <para style="q1" vid="PSA 105:45">Itooro <char style="nd">Abọọñ</char>.<note caller="+" style="f"><char style="fr" closed="false">105:45 </char><char style="ft" closed="false">Ke Hibru ado Halelu Ya</char></note><verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="cl">Saam 106</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1" />Itooro <char style="nd">Abọọñ</char>.<note caller="+" style="f"><char style="fr" closed="false">106:1 </char><char style="ft" closed="false">Ke Hibru ado Halelu Ya; se ñko ke Saam 106:48.</char></note></para>
  <para style="b" vid="PSA 106:1" />
  <para style="q1" vid="PSA 106:1">Inọ <char style="nd">Abọọñ</char> ekọọm, sia anye afọn;</para>
  <para style="q2" vid="PSA 106:1">ima amọ aba ke nsi-nsi.<verse eid="PSA 106:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2" />Anie ikpikan itañ mme ñkpọsọñ utom <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 106:2">me adinam itooro amọ awuọ ada ayọhọ-ayọhọ?<verse eid="PSA 106:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3" />Afọfọn anọ mbon enamma ñkpọ ke unen,</para>
  <para style="q2" vid="PSA 106:3">enam se ido unen afịd ini.<verse eid="PSA 106:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4" />
    <char style="nd">Abọọñ</char>, ntoiyo miin nyʌñ suuk anyen nse, ke ini afo awọttọ mbon mfo mfọn,</para>
  <para style="q2" vid="PSA 106:4">di ñnwam miin ke ini afo anyaañake ammọ,<verse eid="PSA 106:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5" />nọ ami ñkop inem mfọnọñkpọ mbon a-afo amekke,</para>
  <para style="q2" vid="PSA 106:5">nọ ami ñkeene ñwuana ke idaara idịd mfo</para>
  <para style="q2" vid="PSA 106:5">ñnyʌñ ndiana ye mbon inie mfo ke adinọ itooro.<verse eid="PSA 106:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6" />Ñnyịn iminam idiọọkñkpọ, kpa naña mme eteete ñnyịn ekenam;</para>
  <para style="q2" vid="PSA 106:6">ñnyịn iminam idiọọk inyʌñ inam ibak.<verse eid="PSA 106:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7" />Idaha mme eteete ñnyịn ekebaaha ke Iyib,</para>
  <para style="q2" vid="PSA 106:7">ammọ ikitoiyoke ikiinyʌññọ idọñ anyen ibaña mme utịppeñkpọ mfo;</para>
  <para style="q1" vid="PSA 106:7">ammọ ikitoiyoke uwak mfọn mfo,</para>
  <para style="q2" vid="PSA 106:7">ñko ammọ emaesọñ iwuod ke mben inyañ, Ndad-Ndad Inyañ.<verse eid="PSA 106:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8" />Ado anye amaanyaaña ammọ ke ntak anyịñ amọ,</para>
  <para style="q2" vid="PSA 106:8">nọ anye anam yak ediọọñọ akwa adudu amọ.<verse eid="PSA 106:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9" />Anye amaasua anọ Ndad-Ndad Akpainyañ, ndin anye amaasat;</para>
  <para style="q2" vid="PSA 106:9">anye amaadat ammọ asaña ke udem nte ebo ke esaaña ke akpautatan.<verse eid="PSA 106:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10" />Anye amaanyaaña ammọ asio ke ubọk mbon idiọọkesịd;</para>
  <para style="q2" vid="PSA 106:10">amaafak ammọ asio ke ubọk mme asua.<verse eid="PSA 106:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11" />Mmọọñ amaafʌk mme asua ammọ;</para>
  <para style="q2" vid="PSA 106:11">ibaaha awo ammọ ndomokeed se ikibọkkọ.<verse eid="PSA 106:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12" />Ndin ammọ emaenịm mme enwọñọ amọ</para>
  <para style="q2" vid="PSA 106:12">emaenyʌñ ekwọ itooro amọ.<verse eid="PSA 106:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13" />Ado ammọ emaesọp efre se anye akenam</para>
  <para style="q2" vid="PSA 106:13">ikiinyʌññọ ibet nọ uduak amọ awuọ awọt idem.<verse eid="PSA 106:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14" />Ke akpautatan, ammọ emaeyaak idem enọ udọñ ammọ;</para>
  <para style="q2" vid="PSA 106:14">ke anaan, ammọ emaedomo Abasi ese.<verse eid="PSA 106:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15" />Ke ntak ado anye amaanọ ammọ se ammọ ekebịp,</para>
  <para style="q2" vid="PSA 106:15">ado adọñ udọñọ nsobo anọ ammọ.<verse eid="PSA 106:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16" />Ke itie mbono, ammọ emaefịbe Moses</para>
  <para style="q2" vid="PSA 106:16">ye Erọn, e-ekenamma asana enọ <char style="nd">Abọọñ</char>.<verse eid="PSA 106:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17" />Isọñ amaakʌppọ anyʌñ amen Datan;</para>
  <para style="q2" vid="PSA 106:17">anye amaabuuk udịm Abiram.<verse eid="PSA 106:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18" />Ikañ amaabịppe ke atu mbon se ikikeene ammọ;</para>
  <para style="q2" vid="PSA 106:18">edemeikañ amaata mbon ibak.<verse eid="PSA 106:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19" />Ke Họreb ammọ emaenam ubobod ñyịn enañ</para>
  <para style="q2" vid="PSA 106:19">emaenyʌñ ekpono ubobodñkpọ e-ekenamma ke ukwak.<verse eid="PSA 106:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20" />Ammọ emaekpuho ubọọñ Abasi ammọ</para>
  <para style="q2" vid="PSA 106:20">ye enañ e-ebottobot, a-asitaaha mbid.<verse eid="PSA 106:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21" />Ammọ emaefre Abasi akenyaañake ammọ,</para>
  <para style="q2" vid="PSA 106:21">akenamma mme ikpọ ñkpọ ke Iyib,<verse eid="PSA 106:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22" />utịppeñkpọ ke isọñ Ham</para>
  <para style="q2" vid="PSA 106:22">ye mme ñyọọ adinam ke mben Ndad-Ndad Inyañ.<verse eid="PSA 106:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23" />Ndin anye amaabo ke imọ iyaisobo ammọ,</para>
  <para style="q2" vid="PSA 106:23">imiikpidooho Moses, a-anye akemekke,</para>
  <para style="q1" vid="PSA 106:23">akedaaha ke ufọọd iso amọ</para>
  <para style="q2" vid="PSA 106:23">adisuuhọ anye esịd mbaak adiwot ammọ.<verse eid="PSA 106:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24" />Ndin ammọ emaesịn uyaiya isọñ ke ndek;</para>
  <para style="q2" vid="PSA 106:24">ammọ ikinịmme enwọñọ amọ.<verse eid="PSA 106:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25" />Ammọ edukuunọ ke atayad ammọ</para>
  <para style="q2" vid="PSA 106:25">inyʌññọ ikop item inọ <char style="nd">Abọọñ</char>.<verse eid="PSA 106:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26" />Ndin anye amaabenne ubọk anwọñọ anọ ammọ</para>
  <para style="q2" vid="PSA 106:26">abo ke imọ iyainam ammọ eduọññọ ke anaan,<verse eid="PSA 106:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27" />inam nọ ubon ammọ eduọññọ ke atu mme idịd</para>
  <para style="q2" vid="PSA 106:27">inyʌñ isuan ammọ iyọhọ afịd iso isọñ.<verse eid="PSA 106:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28" />Ammọ emaeben idem ammọ edian ye Baal ake Pọọ</para>
  <para style="q2" vid="PSA 106:28">enyʌñ edia mme uwa e-ewaaha enọ mme abasi i-imiinieghe uwem;<verse eid="PSA 106:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29" />Ammọ emaedemme iyadesịd <char style="nd">Abọọñ</char> ke ibak adinam ammọ,</para>
  <para style="q2" vid="PSA 106:29">ndin udọñọ nsobo amaasakka ke atu ammọ.<verse eid="PSA 106:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30" />Ado Finehas amaadakka ada anọ ikpan</para>
  <para style="q2" vid="PSA 106:30">ndin udọñọ nsobo ado amaatre.<verse eid="PSA 106:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31" />Emaebat anye ami enọ anye nte adinenido</para>
  <para style="q2" vid="PSA 106:31">tutu ke nsi-nsi emana.<verse eid="PSA 106:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32" />Ke mben mmọọñ Meriba ammọ emaeyat <char style="nd">Abọọñ</char> esịd,</para>
  <para style="q2" vid="PSA 106:32">ndin mfịna amaasịm Moses ke ntak ammọ;<verse eid="PSA 106:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33" />sia ammọ emaesọñ iwuod ye Sịbidịd Abasi,</para>
  <para style="q2" vid="PSA 106:33">anam mme ikọ iyadesịd ewuọñọ Moses ke ñkpọkinua.<verse eid="PSA 106:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34" />Ammọ ikisoboke mbon awo</para>
  <para style="q2" vid="PSA 106:34">naña <char style="nd">Abọọñ</char> akedọñ ammọ,<verse eid="PSA 106:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35" />ado ammọ emaewuaha idem ye mme idịd</para>
  <para style="q2" vid="PSA 106:35">enyʌñ enam ñkpọ mme ekeene eduuwem ammọ.<verse eid="PSA 106:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36" />Ammọ emaekpono ubobodñkpọ mbon ado,</para>
  <para style="q2" vid="PSA 106:36">a-akedidooho afia anọ ammọ.<verse eid="PSA 106:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37" />Ammọ emaewa nditọ ideen ammọ</para>
  <para style="q2" vid="PSA 106:37">ye nditọ ibaan ammọ enọ nsu-nsu abasi.<verse eid="PSA 106:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38" />Ammọ emaeduọk iyiib i-imiidueghe isob</para>
  <para style="q2" vid="PSA 106:38">iyiib nditọ ideen ye nditọ ibaan ammọ,</para>
  <para style="q1" vid="PSA 106:38">ake ammọ ekewaaha enọ ubobodñkpọ Kenan,</para>
  <para style="q2" vid="PSA 106:38">ndin ami amaanam isọñ abiara ato ke iyiib ammọ.<verse eid="PSA 106:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39" />Ammọ emaesappa idem ammọ eto ke se ammọ ekenam;</para>
  <para style="q2" vid="PSA 106:39">ammọ emaekama idem ammọ enam akpara ke adinam ammọ.<verse eid="PSA 106:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40" />Ke ntoro, <char style="nd">Abọọñ</char> amaayat esịd ye mbon amọ</para>
  <para style="q2" vid="PSA 106:40">anyʌñ atọhọ abaña udeeme inie amọ.<verse eid="PSA 106:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41" />Anye amaayaak ammọ asịn ke ubọk mme idịd,</para>
  <para style="q2" vid="PSA 106:41">ñko mme asua ammọ emaekaara ammọ.<verse eid="PSA 106:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42" />Mbon usua ammọ emaefiik ammọ</para>
  <para style="q2" vid="PSA 106:42">enyʌñ enam ammọ esuuk iwuod enọ adudu ammọ.<verse eid="PSA 106:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43" />Uwak ini anye amaanyaaña ammọ,</para>
  <para style="q2" vid="PSA 106:43">ado ammọ emaeyịre ke nsọñiwuod</para>
  <para style="q2" vid="PSA 106:43">ammọ enyʌñ etak ke idiọọkñkpọ ammọ.<verse eid="PSA 106:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44" />Kpayeado anye amaakere abaña ukuud ammọ</para>
  <para style="q2" vid="PSA 106:44">ke ini anye akekoppo ntuaña ayịd ammọ;<verse eid="PSA 106:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45" />ke ntak ammọ, anye amaatoiyo edioomo amọ</para>
  <para style="q2" vid="PSA 106:45">ndin ke ntak akwa ima amọ, anye amaasuuhọ esịd.<verse eid="PSA 106:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46" />Anye amaanam afịd mbon se ikiisịn ammọ ukad</para>
  <para style="q2" vid="PSA 106:46">etua ammọ mbọm.<verse eid="PSA 106:46" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47" />Inyaaña ñnyịn, <char style="nd">Abọọñ</char> Abasi ñnyịn,</para>
  <para style="q2" vid="PSA 106:47">nyʌñ itañ ñnyịn to ke mme idịd,</para>
  <para style="q1" vid="PSA 106:47">nọ ñnyịn inọ adisana anyịñ mfo ekọọm</para>
  <para style="q2" vid="PSA 106:47">inyʌñ ibọ ubọọñ ke itooro mfo.<verse eid="PSA 106:47" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48" />Itooro anie <char style="nd">Abọọñ</char>, Abasi Isrel,</para>
  <para style="q2" vid="PSA 106:48">ke nsi-nsi tutu ke nsi-nsi.</para>
  <para style="b" vid="PSA 106:48" />
  <para style="q1" vid="PSA 106:48">Yak afịd mme awo ebo, “Amen!”</para>
  <para style="b" vid="PSA 106:48" />
  <para style="q1" vid="PSA 106:48">Itooro <char style="nd">Abọọñ</char>.<verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms">Ayọhọ Ñwed v</para>
  <para style="mr">
    <ref loc="PSA 107-150">Mme Saam 107–150</ref></para>
  <para style="cl">Saam 107</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1" />Inọ <char style="nd">Abọọñ</char> ekọọm, sia anye afọn;</para>
  <para style="q2" vid="PSA 107:1">ima amọ aba ke nsi-nsi.<verse eid="PSA 107:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2" />Yak mbon se <char style="nd">Abọọñ</char> afak asio etañ mbʌk ammọ,</para>
  <para style="q2" vid="PSA 107:2">mbon se anye akenyaaña asio ke ubọk mme asua,<verse eid="PSA 107:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3" />mbon se anye akekoono ke mme isọñ abok,</para>
  <para style="q2" vid="PSA 107:3">ato ke usakkautịn ye ke usobutịn, ke anyọñ-anyọñ ye ke usuuk-usuuk.<verse eid="PSA 107:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4" />Usʌk eyooñ ke mme mbiara isọñ akpautatan,</para>
  <para style="q2" vid="PSA 107:4">ikịtte itie ke abio se ammọ ekpebañña.<verse eid="PSA 107:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5" />Abiọọñ amaadọñ ammọ itọñ anyʌñ asat ammọ,</para>
  <para style="q2" vid="PSA 107:5">uwem awuọ akpọñ ammọ.<verse eid="PSA 107:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6" />Ndin ammọ emaetua enọ <char style="nd">Abọọñ</char>, ke idak mfịna ammọ,</para>
  <para style="q2" vid="PSA 107:6">anye amaanyʌñ anyaaña ammọ asio ke ukuud ammọ.<verse eid="PSA 107:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7" />Anye amaaben ammọ asaña ke nnen-nnen usʌñ</para>
  <para style="q2" vid="PSA 107:7">akaa abio se ammọ ekeme idʌñọ.<verse eid="PSA 107:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8" />Yak ammọ enọ <char style="nd">Abọọñ</char> ekọọm ke ntak nsọọñọnda ima amọ</para>
  <para style="q2" vid="PSA 107:8">ye ke utịppe adinam ake anye anamma anọ ubon awo,<verse eid="PSA 107:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9" />sia anye anam mbon nsaditọñ ekop uyʌkkọ</para>
  <para style="q2" vid="PSA 107:9">anyʌñ anọ mbon abiọọñ nti ñkpọ.<verse eid="PSA 107:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10" />Usʌk awo eketie ke ekịm, ke ataa ekịm,</para>
  <para style="q2" vid="PSA 107:10">mbon ñkpakọb ebọiyọ ufen ke idak akpọnọ ukwak,<verse eid="PSA 107:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11" />sia ammọ emaetre utọñ enọ mbed Abasi</para>
  <para style="q2" vid="PSA 107:11">enyʌñ esịn uduak Andikoñ Ñkan ke ndek.<verse eid="PSA 107:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12" />Ke ntoro anye amaanam ammọ ebọ nsaad ufen;</para>
  <para style="q2" vid="PSA 107:12">ammọ emaetuak ukod, ado awo ndomokeed ikibaaha se inọ ammọ unwam.<verse eid="PSA 107:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13" />Ndin ammọ emaetua enọ <char style="nd">Abọọñ</char>, ke idak mfịna ammọ,</para>
  <para style="q2" vid="PSA 107:13">ndin anye amaanyʌñ anyaaña ammọ asio ke ukuud ammọ.<verse eid="PSA 107:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14" />Anye amaasio ammọ ke ekịm, ke ataa ekịm</para>
  <para style="q2" vid="PSA 107:14">anyʌñ akịp akpọnọ ammọ.<verse eid="PSA 107:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15" />Yak ammọ enọ <char style="nd">Abọọñ</char> ekọọm ke ntak nsọọñọnda ima amọ</para>
  <para style="q2" vid="PSA 107:15">ye ke utịppe adinam ake anye anamma anọ ubon awo,<verse eid="PSA 107:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16" />sia anye amaabʌñ inuaatob brọns</para>
  <para style="q2" vid="PSA 107:16">anyʌñ asiak ukwak itịm.<verse eid="PSA 107:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17" />Usʌk ekekappa ndisịme ekeene usʌñ nsọñiwuod ammọ</para>
  <para style="q2" vid="PSA 107:17">enyʌñ ebọi ufen ke ntak ndiọiñkpọ ammọ.<verse eid="PSA 107:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18" />Afịd ndidia amaadooro ammọ</para>
  <para style="q2" vid="PSA 107:18">emaenyʌñ esaña ekpere inuaatob ñkpa.<verse eid="PSA 107:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19" />Ndin ammọ emaetua ekoot <char style="nd">Abọọñ</char>, ke idak mfịna ammọ,</para>
  <para style="q2" vid="PSA 107:19">anye amaanyʌñ anyaaña ammọ asio ke ukuud ammọ.<verse eid="PSA 107:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20" />Anye amaasio ikọ amọ adọñ anyʌñ akekọk ammọ;</para>
  <para style="q2" vid="PSA 107:20">anye amaafak ammọ asio ke udi.<verse eid="PSA 107:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21" />Yak ammọ enọ <char style="nd">Abọọñ</char> ekọọm ke ntak nsọọñọnda ima amọ</para>
  <para style="q2" vid="PSA 107:21">ye ke utịppe adinam ake anye anamma anọ ubon awo.<verse eid="PSA 107:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22" />Yak ammọ ewa uwa ekọọm</para>
  <para style="q2" vid="PSA 107:22">enyʌñ etañ ebaña utom amọ ye ikwọ idaara.<verse eid="PSA 107:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23" />Usʌk ekesaña ke nsʌñikañ ekaa akpainyañ;</para>
  <para style="q2" vid="PSA 107:23">ammọ ekedo mme anam ndubeghe ke mme ikpọ mmọọñ.<verse eid="PSA 107:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24" />Ammọ emaekịt utom <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 107:24">mme utịppe adinam amọ ke udem.<verse eid="PSA 107:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25" />Sia anye aketañ ikọ ndin ayobio asakka</para>
  <para style="q2" vid="PSA 107:25">anam afịmakpa adịppe idem.<verse eid="PSA 107:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26" />Ammọ emaedọọk ekaa anyọñ enyʌñ esọiyọ edʌk udem;</para>
  <para style="q2" vid="PSA 107:26">ke nnananyen ammọ ikpuub esịd ammọ amaameem.<verse eid="PSA 107:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27" />Ammọ emaeteññe enyʌñ efʌmmọ nte mme akpammịn;</para>
  <para style="q2" vid="PSA 107:27">ammọ ekeba ke utịd aniọñ ammọ.<verse eid="PSA 107:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28" />Ndin ammọ emaetua enọ <char style="nd">Abọọñ</char>, ke idak mfịna ammọ,</para>
  <para style="q2" vid="PSA 107:28">anye amaanyʌñ asio ammọ ke ukuud ammọ.<verse eid="PSA 107:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29" />Ndin anye amaanam ayobio adobo aforo adu;</para>
  <para style="q2" vid="PSA 107:29">amaakʌp mme afịmakpa inua.<verse eid="PSA 107:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30" />Ammọ emaenem esịd ke ini anye akedoboke,</para>
  <para style="q2" vid="PSA 107:30">ndin anye amaadat ammọ usʌñ akewuọ esʌk.<verse eid="PSA 107:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31" />Yak ammọ enọ <char style="nd">Abọọñ</char> ekọọm ke ntak nsọọñọnda ima amọ</para>
  <para style="q2" vid="PSA 107:31">ye ke utịppe adinam ake anye anamma anọ ubon awo.<verse eid="PSA 107:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32" />Yak ammọ ekpono anye ke mboho ikọd amọ</para>
  <para style="q2" vid="PSA 107:32">enyʌñ etooro anye ke esob mme ñkpisọñ.<verse eid="PSA 107:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33" />Anye amaanam mme inyañ ekappa edo akpautatan,</para>
  <para style="q2" vid="PSA 107:33">mme ufefeghe idịm ekappa nsaad isọñ,<verse eid="PSA 107:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34" />ñko nseghe isọñ adido inʌñ-inʌñ ndoon,</para>
  <para style="q2" vid="PSA 107:34">ke ntak ibak mbon se ikidʌñọ do.<verse eid="PSA 107:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35" />Anye amaanam akpautatan akappa ube mmọọñ</para>
  <para style="q2" vid="PSA 107:35">anyʌñ anam nsaad isọñ akappa ado idịm a-afegheke;<verse eid="PSA 107:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36" />do ke anye akeben mbon abiọọñ edidʌñ</para>
  <para style="q2" vid="PSA 107:36">ammọ emaesiak abio se ammọ ekeme ediba.<verse eid="PSA 107:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37" />Ammọ emaetọ inwañ enyʌñ etọ mme inwañ fain</para>
  <para style="q2" vid="PSA 107:37">idọk amaadikappa ado akpọmiọk;<verse eid="PSA 107:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38" />anye amaadiọñ ammọ, ndin ibad ammọ amaanekke atọt</para>
  <para style="q2" vid="PSA 107:38">anye ikinyʌññọ iyak udịmenañ ammọ etahade.<verse eid="PSA 107:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39" />Ndin ibad ammọ emaesọiyọ, enyʌñ esuuhọ ammọ</para>
  <para style="q2" vid="PSA 107:39">ke ntak ufiik, nnananyen ye ukuud;<verse eid="PSA 107:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40" />anye a-anwaññake emiom aduọk mbọọñ</para>
  <para style="q2" vid="PSA 107:40">anam ammọ eyooñ ke anaan u-usʌñ imiibaaha.<verse eid="PSA 107:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41" />Ado anye amaasio mbon unana ke itie nnananyen ammọ</para>
  <para style="q2" vid="PSA 107:41">anyʌñ anam mme ekpək ammọ etọt nte ufene.<verse eid="PSA 107:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42" />Ndinen awo ekịt enyʌñ edaara,</para>
  <para style="q2" vid="PSA 107:42">ado afịd mbon ibak ekuup inua.<verse eid="PSA 107:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43" />Yak anye a-anieghe ifiọk atịñ anyen ke mme ñkpọ ami</para>
  <para style="q2" vid="PSA 107:43">anyʌñ akere abaña mme utom ima <char style="nd">Abọọñ</char>.<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="cl">Saam 108<note caller="+" style="f"><char style="fr" closed="false">108:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 108:1-13 ewet Saam 108:2-14.</char></note></para>
  <para style="d">Ikwọ. Saam ake Defid</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1" />O Abasi, esịd mmi a-anie iwuuk;</para>
  <para style="q2" vid="PSA 108:1">ami ñyaakwọ ikwọ ñnyʌñ mmia ñkukwak ye afịd ukpọñ mmi.<verse eid="PSA 108:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2" />Hab ye ndidoudʌk, idemme!</para>
  <para style="q2" vid="PSA 108:2">Ami ñyaademme usiere.<verse eid="PSA 108:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3" />
    <char style="nd">Abọọñ</char> ami ñyautooro fiin, ke atu mme idịd;</para>
  <para style="q2" vid="PSA 108:3">ami ñyaakwọ ubaña fiin ke atu mbon awo.<verse eid="PSA 108:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4" />Sia ima mfo a-akpon, akoñ akan mme anyọñ;</para>
  <para style="q2" vid="PSA 108:4">akpanikọ mfo a-asịm ikpaanyọñ.<verse eid="PSA 108:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5" />O Abasi, bọ ubọọñ, koñ kan mme hefịn;</para>
  <para style="q2" vid="PSA 108:5">yak ubọọñ mfo ayọhọ afịd ekondo.<verse eid="PSA 108:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6" />Inyaaña ñnyịn nyʌñ inwam ñnyịn ye ubọk nnasia mfo,</para>
  <para style="q2" vid="PSA 108:6">nọ mbon a-afo amaaha enie ñkpọkñyak.<verse eid="PSA 108:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7" />Abasi atie ke adisana itie amọ abo:</para>
  <para style="q2" vid="PSA 108:7">“Ke adikan ñyaabakka Sekem nsio ndaaha</para>
  <para style="q2" vid="PSA 108:7">ñnyʌñ ndomo Abedeñ Sukọd nsio.<verse eid="PSA 108:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8" />Kilied ado ake mmi, Manase ado ake mmi;</para>
  <para style="q2" vid="PSA 108:8">Ifrem ado itamukpeme anọ iwuod mmi,</para>
  <para style="q2" vid="PSA 108:8">Yuda ado esañubọọñ mmi.<verse eid="PSA 108:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9" />Mọb ado besịn uyieubọk mmi,</para>
  <para style="q2" vid="PSA 108:9">ke Edọm ke ami ntop ikpaukod mmi ndot;</para>
  <para style="q2" vid="PSA 108:9">ke Filistia ami nsio ñkpo adikan.”<verse eid="PSA 108:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10" />Anie awo adimben miin idʌk akpọsọñ abio?</para>
  <para style="q2" vid="PSA 108:10">Anie adindat miin usʌñ ika Edọm?<verse eid="PSA 108:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11" />Nte idooho afo, Abasi, afo a-akisịnne ñnyịn,</para>
  <para style="q2" vid="PSA 108:11">unyʌññọ usaña aba ye mbon ekọñ ñnyịn?<verse eid="PSA 108:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12" />Inọ ñnyịn unwam ke abaña mme asua,</para>
  <para style="q2" vid="PSA 108:12">sia unwam awo ibaaha ufọn.<verse eid="PSA 108:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13" />Ke Abasi ñnyịn iyainie adikan,</para>
  <para style="q2" vid="PSA 108:13">anye ayaanyʌñ afiik mme asua ñnyịn ke ñkpad.<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="cl">Saam 109</para>
  <para style="d">Ake etubom ikwọ. Ake Defid. Saam.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1" />Abasi mmi, a-ami ntooroke,</para>
  <para style="q2" vid="PSA 109:1">kuudop uyio,<verse eid="PSA 109:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2" />sia mbon ibak ye mbon abiaña</para>
  <para style="q2" vid="PSA 109:2">ekuumọ inua ammọ embaña miin;</para>
  <para style="q2" vid="PSA 109:2">amọ ekama edeme nsu etañ ikọ embaña miin.<verse eid="PSA 109:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3" />Ammọ eñkanna miin ekʌk ye mme ikọ usuaesịd;</para>
  <para style="q2" vid="PSA 109:3">ammọ enam mfịna ye ami ke unana ntak.<verse eid="PSA 109:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4" />Ammọ endot miin uyio ke usiene ima a-ami nnieghe nnọ ammọ</para>
  <para style="q2" vid="PSA 109:4">ado ami ndo awo abọñ akam.<verse eid="PSA 109:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5" />Ammọ ensio miin usiene idiọọk ke eti,</para>
  <para style="q2" vid="PSA 109:5">enyʌñ ensua miin ke ima a-ami nnieghe nnọ ammọ.<verse eid="PSA 109:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6" />Mek awo ibak yak afiik asua mmi;</para>
  <para style="q2" vid="PSA 109:6">yak awo ndoduyio ada ke ubọk nnasia amọ.<verse eid="PSA 109:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7" />Emaekpe ikpe amọ, yak ekịt ndudue enọ anye,</para>
  <para style="q2" vid="PSA 109:7">ñko yak akam amọ abiom anye ikpe.<verse eid="PSA 109:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8" />Yak usen amọ aməho;</para>
  <para style="q2" vid="PSA 109:8">yak awo mfen adat itie utom amọ ke ukara.<verse eid="PSA 109:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9" />Yak nditọ amọ edo nditọakpa</para>
  <para style="q2" vid="PSA 109:9">ndin anwaan amọ ado ebekpa.<verse eid="PSA 109:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10" />Yak nditọ amọ edo ñyooñ inọọk;</para>
  <para style="q2" vid="PSA 109:10">yak ebịne ammọ esio ke mme ñwuudo ufọk ammọ.<verse eid="PSA 109:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11" />Yak anọewuọd abọ afịd se anye anie;</para>
  <para style="q2" vid="PSA 109:11">yak isenawo ebịme afịd se anye akekpa utom ke esịd.<verse eid="PSA 109:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12" />Yak awo ndomokeed akuufọn mfọn ye anye</para>
  <para style="q2" vid="PSA 109:12">me anie mbọm abaña nditọakpa amọ.<verse eid="PSA 109:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13" />Yak ekpịkke ubon amọ esio,</para>
  <para style="q2" vid="PSA 109:13">esọọk anyịñ ammọ esio ke emana mfen.<verse eid="PSA 109:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14" />Yak etoiyo mme ukwaññkpọ mme ete amọ ke iso <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 109:14">Yak ekuukwokko ndiọiñkpọ eka amọ esio.<verse eid="PSA 109:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15" />Yak ndiọiñkpọ ammọ esʌk ekaiso eda ke iso <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 109:15">nọ anye asọọk anyịñ ammọ asio ke iso isọñ.<verse eid="PSA 109:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16" />Sia tọọñọ anam anye ikikereke naña afọn mfọn,</para>
  <para style="q2" vid="PSA 109:16">ado akọbọ mbon uweene awot</para>
  <para style="q2" vid="PSA 109:16">ye mbon unana ye mbon mbʌññọesịd.<verse eid="PSA 109:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17" />Anye amaama adidọọñ akam,</para>
  <para style="q2" vid="PSA 109:17">yak atịmme abịne anye.</para>
  <para style="q1" vid="PSA 109:17">Anye ikikịtte ufọn adidiọñ awo,</para>
  <para style="q2" vid="PSA 109:17">yak adidiọñ anyọọñ usʌñ akpọñ anye.<verse eid="PSA 109:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18" />Anye akesịne isuuñọ nte afọñ amọ;</para>
  <para style="q2" vid="PSA 109:18">adʌk anye idem nte mmọọñ,</para>
  <para style="q2" vid="PSA 109:18">adʌk akpọ amọ nte adan.<verse eid="PSA 109:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19" />Yak aba nte ñweem afọñ ke eben ewañ ekanna anye,</para>
  <para style="q2" vid="PSA 109:19">nte ñkpahaisịn ke ebọp anye ke nsi-nsi.<verse eid="PSA 109:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20" />Yak anye ami ado utịb <char style="nd">Abọọñ</char> anọọhọ mme asua mmi,</para>
  <para style="q2" vid="PSA 109:20">mbon e-etañña idiọọk embaña miin.<verse eid="PSA 109:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21" />Ado afo, <char style="nd">Abọọñ</char> Andikara,</para>
  <para style="q2" vid="PSA 109:21">ñnwam miin ke ntak anyịñ mfo;</para>
  <para style="q2" vid="PSA 109:21">ñnyaaña miin ke ntak mfọnido ima mfo.<verse eid="PSA 109:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22" />Sia ami ndo uweene ñnyʌñ nnana ñkpọ,</para>
  <para style="q2" vid="PSA 109:22">ñko esịd mmi abʌññọ ke esịd idem mmi.<verse eid="PSA 109:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23" />Ami mmesop nte ndukpọñ ndubiayio;</para>
  <para style="q2" vid="PSA 109:23">eñnyeeñe miin nte ñkukuñkpọyọriyọ.<verse eid="PSA 109:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24" />Edọñ mmi ameem ke ntak utreudia;</para>
  <para style="q2" vid="PSA 109:24">idem mmi akpịññe anyʌñ anana abʌk.<verse eid="PSA 109:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25" />Ami ndo ñkpọ nsaha nnọ mme asua mmi;</para>
  <para style="q2" vid="PSA 109:25">ke ini ammọ eñkịtte miin ammọ efuuñ iwuod.<verse eid="PSA 109:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26" />
    <char style="nd">Abọọñ</char> Abasi mmi ñnwam miin;</para>
  <para style="q2" vid="PSA 109:26">ñnyaaña miin keene nsọọñọnda ima mfo.<verse eid="PSA 109:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27" />Nam ammọ ediọọñọ ke ado ubọk mfo,</para>
  <para style="q2" vid="PSA 109:27">ke afo <char style="nd">Abọọñ</char> anam ami.<verse eid="PSA 109:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28" />Ke ini ammọ esuuñọke, afo diọñ;</para>
  <para style="q2" vid="PSA 109:28">yak mbon eñyemme miin ikọ edia abuud,</para>
  <para style="q2" vid="PSA 109:28">ado yak ayịnufọk mfo adaara.<verse eid="PSA 109:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29" />Yak esịn mbon endotto miin uyio afọñidem ndọk</para>
  <para style="q2" vid="PSA 109:29">enyʌñ ewañ ammọ abuud nte ewịra.<verse eid="PSA 109:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30" />Ami ñyaakama inua mmi ñkpono <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 109:30">ke atu uwak awo, ami ñyaatooro anye.<verse eid="PSA 109:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31" />Sia anye ada ke ubọk nnasia mbon unana</para>
  <para style="q2" vid="PSA 109:31">adinyaaña uwem ammọ nsio ke atu mbon e-ebiereke ikpe ñkpa enọ ammọ.<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="cl">Saam 110</para>
  <para style="d">Ake Defid. Saam</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1" />
    <char style="nd">Abọọñ</char> abo abọọñ mmi:</para>
  <para style="b" vid="PSA 110:1" />
  <para style="q1" vid="PSA 110:1">“Tie ke ubọk nnasia mmi</para>
  <para style="q2" vid="PSA 110:1">tutu ami nnam mme asua mfo</para>
  <para style="q2" vid="PSA 110:1">ifịm udodukod nnọ ukod mfo.”<verse eid="PSA 110:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2" />
    <char style="nd">Abọọñ</char> ayaanyanna akwa esañubọọñ mfo ato ke Saiyọn, abo,</para>
  <para style="q2" vid="PSA 110:2">“Kaara ke ufọọd mme asua mfo!”<verse eid="PSA 110:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3" />Udịmekọñ mfo eyaenyịmme</para>
  <para style="q2" vid="PSA 110:3">ke usen se afo adinie anwan.</para>
  <para style="q1" vid="PSA 110:3">Esịne adisana uyai ke idem,</para>
  <para style="q2" vid="PSA 110:3">mme iwaad mfo eyaedi ubịne fiin</para>
  <para style="q2" vid="PSA 110:3">nte ndedeb a-atooho idịb ubakusen.<verse eid="PSA 110:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4" />
    <char style="nd">Abọọñ</char> amaanwọñọ</para>
  <para style="q2" vid="PSA 110:4">ndin anye idiikpuhoke akikere amọ:</para>
  <para style="q1" vid="PSA 110:4">“Afo ado aku ke nsi-nsi,</para>
  <para style="q2" vid="PSA 110:4">a-asañake akekem ke ukem ndaha Melkisedek.”<verse eid="PSA 110:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5" />
    <char style="nd">Abọọñ</char> mmọdo ke ubọk nnasia mfo;</para>
  <para style="q2" vid="PSA 110:5">anye ayaanuak ndidem ke usen ifiobesịd amọ.<verse eid="PSA 110:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6" />Anye ayaakpe ikpe anọ mme idịd, akoono mme akpañkpa akọọk</para>
  <para style="q2" vid="PSA 110:6">anyʌñ anuak mme andikara ke ukod ke afịd ederimbod.<verse eid="PSA 110:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7" />Anye ayaanwọñ mmọọñ ato etək idịm a-abaaha ke usʌñ,</para>
  <para style="q2" vid="PSA 110:7">ndin anye ayaabenne iwuod amọ ke anyọñ.<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="cl">Saam 111</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1" />Itooro <char style="nd">Abọọñ</char>.</para>
  <para style="b" vid="PSA 111:1" />
  <para style="q1" vid="PSA 111:1">Ami ñyaadịppe anyịñ <char style="nd">Abọọñ</char> ke afịd esịd mmi</para>
  <para style="q2" vid="PSA 111:1">ke eboho ndinen awo ye ke itie akeedodo ake mme awo ebohoke.<verse eid="PSA 111:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2" />Mme utom <char style="nd">Abọọñ</char> ado akwa utom;</para>
  <para style="q2" vid="PSA 111:2">afịd mbon e-ekoppo inem ke utom ekere ebaña utom amọ.<verse eid="PSA 111:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3" />Mme ñkpọ se anye anam ayọhọ ye ubọọñ ye ukpono,</para>
  <para style="q2" vid="PSA 111:3">ñko adinenido amọ aba ke nsi-nsi.<verse eid="PSA 111:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4" />Anye anam yak etoiyo mme utịppeñkpọ se anye anam;</para>
  <para style="q2" vid="PSA 111:4">
    <char style="nd">Abọọñ</char> ayọhọ ye mfọn ye mbọm.<verse eid="PSA 111:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5" />Anye anọ mbon se ibaak anye ndidia;</para>
  <para style="q2" vid="PSA 111:5">anye atoiyo edioomo amọ ke nsi-nsi.<verse eid="PSA 111:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6" />Anye awọt mbon amọ adudu utom amọ,</para>
  <para style="q2" vid="PSA 111:6">anọ ammọ mme isọñ idịd mfen.<verse eid="PSA 111:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7" />Mme utom u-ubọk amọ anamma edoñño akpanikọ ye nnen-nnen</para>
  <para style="q2" vid="PSA 111:7">afịd mme mbed amọ edo se edot anyen.<verse eid="PSA 111:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8" />Ammọ esọọñọ eda ke nsi-nsi nsi-nsi,</para>
  <para style="q2" vid="PSA 111:8">edaaha ke akpanikọ ye ke adinenido.<verse eid="PSA 111:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9" />Anye anọ mbon amọ ufak;</para>
  <para style="q2" vid="PSA 111:9">anye adịppe edioomo amọ adaaha ke nsi-nsi,</para>
  <para style="q2" vid="PSA 111:9">adisana ye utịppe edo anyịñ amọ.<verse eid="PSA 111:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10" />Mbaak <char style="nd">Abọọñ</char> ado ntọọñọ aniọñ;</para>
  <para style="q2" vid="PSA 111:10">afịd mbon e-ekeeneke mbed amọ e-enie mbufiọk.</para>
  <para style="q2" vid="PSA 111:10">Nsi-nsi itooro anie anye.<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="cl">Saam 112</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1" />Itooro <char style="nd">Abọọñ</char>.</para>
  <para style="b" vid="PSA 112:1" />
  <para style="q1" vid="PSA 112:1">Afọfọn anọ mbon e-ebaaha <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 112:1">mbon e-ekoppo akpọsọñ inemesịd ke mme ewʌhọ amọ.<verse eid="PSA 112:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2" />Nditọ ammọ eyaedoñño ñkpọsọñ ke abio;</para>
  <para style="q2" vid="PSA 112:2">eyaediọñ emana mme ndinen awo.<verse eid="PSA 112:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3" />Uforo ye inie eba ke mme ufọk ammọ,</para>
  <para style="q2" vid="PSA 112:3">adinenido ammọ asọọñọ ada ke nsi-nsi.<verse eid="PSA 112:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4" />Akpekọm ke ekịm usiere ikañ ayamma anọ ndinen awo,</para>
  <para style="q2" vid="PSA 112:4">anọ mbon e-efọnnọ enyʌñ enie mbọm enyʌñ enen.<verse eid="PSA 112:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5" />Eti ñkpọ ayaadi abịne mbon se ido ubọk enọenọ e-enyʌññọ ewuọt ke ntadubọk,</para>
  <para style="q2" vid="PSA 112:5">mbon e-enamma ñkpọ ammọ ke unen.<verse eid="PSA 112:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6" />Ke akpanikọ, mme ndinen awo idiinyeeñeke;</para>
  <para style="q2" vid="PSA 112:6">eyaetoiyo ammọ ke nsi-nsi.<verse eid="PSA 112:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7" />Ammọ idiinieghe ndịk ibaña idiọọk etob;</para>
  <para style="q2" vid="PSA 112:7">esịd ammọ enie iwuuk, ebuọt idem ke <char style="nd">Abọọñ</char>.<verse eid="PSA 112:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8" />Ekpeme esịd ammọ, ammọ idiikoppo ndịk;</para>
  <para style="q2" vid="PSA 112:8">ke akpatre ammọ eyaese mme asua ammọ ke edikan.<verse eid="PSA 112:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9" />Ammọ esuan mme inie ammọ enọ uweene ke ntadubọk,</para>
  <para style="q2" vid="PSA 112:9">adinenido ammọ asọọñọ ada ke nsi-nsi;</para>
  <para style="q2" vid="PSA 112:9">eyaedịppe nnʌk ammọ ke anyọñ ke ukpono.<verse eid="PSA 112:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10" />Mbon ibak eyaekịt enyʌñ eyat esịd,</para>
  <para style="q2" vid="PSA 112:10">ammọ eyaekwaaha ntakeded enyʌñ etaha ema;</para>
  <para style="q2" vid="PSA 112:10">udọñ mbon ibak eyaekappa edo ikpu-ikpu.<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="cl">Saam 113</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1" />Itooro <char style="nd">Abọọñ</char>.</para>
  <para style="b" vid="PSA 113:1" />
  <para style="q1" vid="PSA 113:1">Itooro <char style="nd">Abọọñ</char> ndufo nditọufọk amọ;</para>
  <para style="q2" vid="PSA 113:1">itooro anyịñ <char style="nd">Abọọñ</char>.<verse eid="PSA 113:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2" />Yak etooro anyịñ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 113:2">idahami ye ke nsi-nsi nsi-nsi.<verse eid="PSA 113:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3" />Tọọñọ ke usakkautịn tutu akesịm itie nte anye asop,</para>
  <para style="q2" vid="PSA 113:3">anyịñ <char style="nd">Abọọñ</char> ado se etooro.<verse eid="PSA 113:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4" />Ebenne anyịñ <char style="nd">Abọọñ</char> ke afịd mme idịd,</para>
  <para style="q2" vid="PSA 113:4">ubọọñ amọ akoñ akan mme anyọñ.<verse eid="PSA 113:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5" />Anie awo iba nte <char style="nd">Abọọñ</char> Abasi ñnyịn,</para>
  <para style="q2" vid="PSA 113:5">Anye a-atieghe ke ñkoñ-ñkoñ ebekpo,<verse eid="PSA 113:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6" />anye asuuk anyen ase</para>
  <para style="q2" vid="PSA 113:6">anyọñ ye isọñ?<verse eid="PSA 113:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7" />Anye abenne uweene asio ke abu</para>
  <para style="q2" vid="PSA 113:7">anyʌñ adịppe mbon unana asio ke itoon ntọñ;<verse eid="PSA 113:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8" />anye anam ammọ etie ye mme nditọ ideen mbọọñ,</para>
  <para style="q2" vid="PSA 113:8">ye nditọ ideen mbọọñ ikọd ammọ.<verse eid="PSA 113:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9" />Anye anam ada anie ayịn ke ufọk amọ</para>
  <para style="q2" vid="PSA 113:9">nte eka nditọ a-adatta esịd.</para>
  <para style="b" vid="PSA 113:9" />
  <para style="q1" vid="PSA 113:9">Itooro <char style="nd">Abọọñ</char>.<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="cl">Saam 114</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1" />Ke ini Isrel akewuọhọ ato Iyib adi,</para>
  <para style="q2" vid="PSA 114:1">Yekọb aketooho abio mbon asen usem,<verse eid="PSA 114:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2" />Yuda amaakappa ado adisana itie Abasi</para>
  <para style="q2" vid="PSA 114:2">Isrel akappa ado itie ukara amọ.<verse eid="PSA 114:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3" />Akpainyañ amaase anyʌñ afeghe,</para>
  <para style="q2" vid="PSA 114:3">Yọdan amaatịmme edem;<verse eid="PSA 114:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4" />mme ikpọabod emaetaam nte akukịmedọñ;</para>
  <para style="q2" vid="PSA 114:4">mme ntək abod enyʌñ etaam nte nditọ edọñ.<verse eid="PSA 114:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5" />Akpainyañ, ntak afo akefegheke-e?</para>
  <para style="q2" vid="PSA 114:5">Yọdan, nsoo ikido ntak afo aketịmmeke edem?<verse eid="PSA 114:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6" />Mme ikpọabod, nsoo ikido ntak yak ndufo etamma, nte akukịmedọñ,</para>
  <para style="q2" vid="PSA 114:6">ndufo mme ntək abod, nte nditọ edọñ?<verse eid="PSA 114:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7" />Nyeñ idem ke iso <char style="nd">Abọọñ</char>, afo ederimbod,</para>
  <para style="q2" vid="PSA 114:7">ke iso Abasi Yekọb,<verse eid="PSA 114:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8" />anye a-akenamma itiad ekappa ube mmọọñ,</para>
  <para style="q2" vid="PSA 114:8">mme nsọọñ itiad ekappa edo mme idịm mmọọñ.<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="cl">Saam 115</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1" />Idooho inọ ñnyịn, <char style="nd">Abọọñ</char>, idooho inọ ñnyịn</para>
  <para style="q2" vid="PSA 115:1">ado yak ubọọñ anie anyịñ mfo,</para>
  <para style="q2" vid="PSA 115:1">ke ntak ima ye akpanikọ mfo.<verse eid="PSA 115:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2" />Nsoo ido yak mme idịd ebo,</para>
  <para style="q2" vid="PSA 115:2">“Abasi ammọ aba ke mmọọ?”<verse eid="PSA 115:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3" />Abasi ñnyịn aba ke anyọñ;</para>
  <para style="q2" vid="PSA 115:3">anye anam se adodo anemme anye esịd.<verse eid="PSA 115:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4" />Ado se ammọ ekpono edo silfa ye kold,</para>
  <para style="q2" vid="PSA 115:4">ake ubọk awo anamma.<verse eid="PSA 115:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5" />Ammọ enie inua, ado itañña ikọ</para>
  <para style="q2" vid="PSA 115:5">enie anyen, ado ikịtte ñkpọ.<verse eid="PSA 115:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6" />Ammọ enie utọñ, ado ikoppo ñkpọ,</para>
  <para style="q2" vid="PSA 115:6">enie iwuo, ado inuunoke ñkpọ.<verse eid="PSA 115:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7" />Ammọ enie ubọk, ado ikanna ituuk ñkpọ,</para>
  <para style="q2" vid="PSA 115:7">ukod, ado ikanna isaña,</para>
  <para style="q2" vid="PSA 115:7">Ammọ inyʌññọ ikan itañ ikọ ke usʌñitọñ ammọ.<verse eid="PSA 115:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8" />Mbon e-enamma ammọ eyaeba nte ammọ,</para>
  <para style="q2" vid="PSA 115:8">kpa ntoro ye afịd mbon se ibuọt idem ke ammọ.<verse eid="PSA 115:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9" />Afịd ndufo nditọ Isrel, ibuọt idem ke <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 115:9">anye ado unwam ye atuekọñ ammọ.<verse eid="PSA 115:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10" />Ufọk Erọn, ibuọt idem ke <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 115:10">anye ado unwam ye atuekọñ ammọ.<verse eid="PSA 115:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11" />Ndufo mbon se ibaak anye, ibuọt idem ke <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 115:11">anye ado unwam ye atuekọñ ammọ.<verse eid="PSA 115:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12" />
    <char style="nd">Abọọñ</char> itoiyo ñnyịn ñko anye ayaidiọñ ñnyịn:</para>
  <para style="q2" vid="PSA 115:12">Anye ayaadiọñ mbon amọ Isrel,</para>
  <para style="q2" vid="PSA 115:12">anye ayaadiọñ ufọk Erọn,<verse eid="PSA 115:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13" />anye ayaadiọñ mbon se ibaak <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 115:13">ntək ye ikpọ ukem-ukem.<verse eid="PSA 115:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14" />Yak <char style="nd">Abọọñ</char> anam nọ afo akọt,</para>
  <para style="q2" vid="PSA 115:14">afo ye nditọ mfo.<verse eid="PSA 115:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15" />Yak <char style="nd">Abọọñ</char> udiọñ fiin,</para>
  <para style="q2" vid="PSA 115:15">Andinam anyọñ ye isọñ.<verse eid="PSA 115:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16" />Mme ñkoññkan hefịn enie <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 115:16">ado anye ayaak isọñ anọ ubonawo.<verse eid="PSA 115:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17" />Idooho mme akpañkpa etooro <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 115:17">mbon e-esọiyọke edʌk itie ndobo;<verse eid="PSA 115:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18" />ado ñnyịn idịppe <char style="nd">Abọọñ</char> ke anyọñ,</para>
  <para style="q2" vid="PSA 115:18">ke idahami ye ke nsi-nsi.</para>
  <para style="b" vid="PSA 115:18" />
  <para style="q1" vid="PSA 115:18">Itooro <char style="nd">Abọọñ</char>.<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="cl">Saam 116</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1" />Ami mmema <char style="nd">Abọọñ</char> sia anye amaakop uyio mmi;</para>
  <para style="q2" vid="PSA 116:1">anye amaakop ntuaayịd ake ami ñyemme mbọm.<verse eid="PSA 116:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2" />Sia anye amannọ miin ñkpañutọñ,</para>
  <para style="q2" vid="PSA 116:2">ami ñyaakoot anye ke naña nte ami mbaaha ke uwem.<verse eid="PSA 116:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3" />Mme udʌk ñkpa emaeñwaña miin,</para>
  <para style="q2" vid="PSA 116:3">ñnyeñidem udi amaadinsịm miin;</para>
  <para style="q2" vid="PSA 116:3">ukuud ye nnananyen emaeñkanna miin ekʌk.<verse eid="PSA 116:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4" />Ndin ami mmaakoot anyịñ <char style="nd">Abọọñ</char>:</para>
  <para style="q2" vid="PSA 116:4">“<char style="nd">Abọọñ</char> ñnyaaña miin!”<verse eid="PSA 116:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5" />
    <char style="nd">Abọọñ</char> ado adinen anyʌñ afọn ido;</para>
  <para style="q2" vid="PSA 116:5">Abasi ñnyịn ayọhọ ye esịd mbọm.<verse eid="PSA 116:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6" />
    <char style="nd">Abọọñ</char> asikpeme mme akọi;</para>
  <para style="q2" vid="PSA 116:6">ke ini ekensuuhọke itie, anye amañnyaaña miin.<verse eid="PSA 116:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7" />Ukpọñ mmi, tịmme kaa itie nduọkadudu mfo,</para>
  <para style="q2" vid="PSA 116:7">sia <char style="nd">Abọọñ</char> afọn ye afo.<verse eid="PSA 116:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8" />
    <char style="nd">Abọọñ</char>, sia afo ameñnyaaña miin asio ke ñkpa,</para>
  <para style="q2" vid="PSA 116:8">anyen mmi asio ke mmọọñayịd,</para>
  <para style="q2" vid="PSA 116:8">ukod mmi ke adifiọnnọ,<verse eid="PSA 116:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9" />nọ ami nsaña ke iso <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 116:9">ke isọñ mme andidu uwem.<verse eid="PSA 116:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10" />Ami mmaanie mbuọdidem ke <char style="nd">Abọọñ</char> ke ini ami ñkebooho,</para>
  <para style="q2" vid="PSA 116:10">“ukuud anekke ammʌm miin”<verse eid="PSA 116:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11" />ke esịd ndịk ami mmaabo,</para>
  <para style="q2" vid="PSA 116:11">“Afịd awo edo mme asʌhọ nsu.”<verse eid="PSA 116:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12" />Nsoo ke ndiinọ <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 116:12">ke afịd mfọn a-anye afọnnọ ye ami?<verse eid="PSA 116:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13" />Ami ñyaadịppe kọọb adinyaaña</para>
  <para style="q2" vid="PSA 116:13">ñnyʌñ ñkoot anyịñ <char style="nd">Abọọñ</char>.<verse eid="PSA 116:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14" />Ami ñyaasio mme akaaña mmi nnọ <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 116:14">ke iso afịd mbon amọ.<verse eid="PSA 116:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15" />Ñkpa ikọd <char style="nd">Abọọñ</char> e-enamma akpanikọ</para>
  <para style="q2" vid="PSA 116:15">ado ñkpọuto ke iso amọ.<verse eid="PSA 116:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16" />
    <char style="nd">Abọọñ</char>, ke akpanikọ ami ndo ayịnufọk mfo;</para>
  <para style="q2" vid="PSA 116:16">ami nnam ñkpọ unọ fiin kpa naña eka mmi akenam;</para>
  <para style="q2" vid="PSA 116:16">afo amekpọk akpọnọ mmi asioño.<verse eid="PSA 116:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17" />Ami ñyaawa uwa ekọọm unọ fiin</para>
  <para style="q2" vid="PSA 116:17">ñnyʌñ ñkoot anyịñ <char style="nd">Abọọñ</char>.<verse eid="PSA 116:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18" />Ami ñyaasio mme akaaña mmi nnọ <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 116:18">ke iso afịd mbon amọ,<verse eid="PSA 116:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19" />ke esịd akwere ufọk <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 116:19">ke ufọọd mfo, Yeruselem.</para>
  <para style="b" vid="PSA 116:19" />
  <para style="q1" vid="PSA 116:19">Itooro <char style="nd">Abọọñ</char>.<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="cl">Saam 117</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1" />Ndufo afịd mme idịd, itooro <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 117:1">yak afịd awo enekke ebenne itooro amọ ke anyọñ.<verse eid="PSA 117:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2" />Sia ima amọ akpon ye ñnyịn,</para>
  <para style="q2" vid="PSA 117:2">ñko akpanikọ Abasi asʌk aba ke nsi-nsi.</para>
  <para style="b" vid="PSA 117:2" />
  <para style="q1" vid="PSA 117:2">Itooro <char style="nd">Abọọñ</char>.<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="cl">Saam 118</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1" />Inọ <char style="nd">Abọọñ</char> ekọọm, sia anye afọn;</para>
  <para style="q2" vid="PSA 118:1">ima amọ aba ke nsi-nsi.<verse eid="PSA 118:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2" />Yak Isrel ebo:</para>
  <para style="q2" vid="PSA 118:2">“Ima amọ ado ke nsi-nsi.”<verse eid="PSA 118:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3" />Yak ufọk Erọn ebo:</para>
  <para style="q2" vid="PSA 118:3">“Ima amọ aba ke nsi-nsi.”<verse eid="PSA 118:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4" />Yak mbon se ibaak <char style="nd">Abọọñ</char> ebo:</para>
  <para style="q2" vid="PSA 118:4">“Ima amọ aba ke nsi-nsi.”<verse eid="PSA 118:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5" />Ke ini ñkpọ asọññọ, ami ntua nseeme nnọ <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 118:5">anye amben miin akaa itie a-anwañake.<verse eid="PSA 118:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6" />
    <char style="nd">Abọọñ</char> mmọdo ye ami; ami ndiikoppo ndịk.</para>
  <para style="q2" vid="PSA 118:6">Nsoo ke ñkaña awo akeme innam miin?<verse eid="PSA 118:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7" />
    <char style="nd">Abọọñ</char> mmọdo ye ami; anye ado andiñnwam miin.</para>
  <para style="q2" vid="PSA 118:7">Ami nse mme asua ke anyen adikan.<verse eid="PSA 118:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8" />Afọn awo adidịbe ke <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 118:8">akan adinie mbuọdidem ke mme awo.<verse eid="PSA 118:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9" />Afọn awo adidịbe ke <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 118:9">akan adinie mbuọdidem ke mme mbọọñ.<verse eid="PSA 118:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10" />Afịd idịd emaeñkanna miin ekʌk,</para>
  <para style="q2" vid="PSA 118:10">ado ke anyịñ <char style="nd">Abọọñ</char> ami mmaakpịkke ammọ nduọọk.<verse eid="PSA 118:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11" />Ammọ emaeñkanna miin ekʌk ke afịd mbeñ,</para>
  <para style="q2" vid="PSA 118:11">ado ke anyịñ <char style="nd">Abọọñ</char> ami mmaakpịkke ammọ nduọọk.<verse eid="PSA 118:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12" />Amọ emaeñkanna miin ekʌk nte akwọọk,</para>
  <para style="q2" vid="PSA 118:12">ado ikañ amaata ammọ usọp-usọp nte ñnyanyaha ke ikọd;</para>
  <para style="q2" vid="PSA 118:12">ke anyịñ <char style="nd">Abọọñ</char> ami mmaakpịkke amọ nduọọk.<verse eid="PSA 118:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13" />Emaennək miin ekaa edem ndin ñkpaakeduọ,</para>
  <para style="q2" vid="PSA 118:13">ado <char style="nd">Abọọñ</char> amañnwam miin.<verse eid="PSA 118:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14" />
    <char style="nd">Abọọñ</char> ado adudu ye inweek mmi;</para>
  <para style="q2" vid="PSA 118:14">anye akappa ado adinyaaña mmi.<verse eid="PSA 118:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15" />Ñkpo idaara ye adikan</para>
  <para style="q2" vid="PSA 118:15">eba ke mme atayad ndinen awo:</para>
  <para style="q1" vid="PSA 118:15">Ubọk nnasia <char style="nd">Abọọñ</char> anam mme ikpọ ñkpọ!<verse eid="PSA 118:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 118:16" />Edịppe ubọk nnasia <char style="nd">Abọọñ</char> ke anyọñ;</para>
  <para style="q2" vid="PSA 118:16">ubọk nnasia <char style="nd">Abọọñ</char> anam mme ikpọ ñkpọ!<verse eid="PSA 118:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17" />Ami ndiikpaaha ado ñyaadu uwem,</para>
  <para style="q2" vid="PSA 118:17">ñnyʌñ mbʌk se <char style="nd">Abọọñ</char> anam.<verse eid="PSA 118:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18" />
    <char style="nd">Abọọñ</char> anekke antʌnọ miin,</para>
  <para style="q2" vid="PSA 118:18">ado anye iñyakka miin inọ ñkpa.<verse eid="PSA 118:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19" />Beere inuaatob mme ndinen awo nnọ miin;</para>
  <para style="q2" vid="PSA 118:19">Ami ñyaadʌk ndi ñnyʌñ nnọ <char style="nd">Abọọñ</char> ekọọm.<verse eid="PSA 118:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20" />Inuaatob <char style="nd">Abọọñ</char> ado ami</para>
  <para style="q2" vid="PSA 118:20">ake mme ndinen awo esañake edʌk.<verse eid="PSA 118:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21" />Ami ñyaunọ fiin ekọọm sia afo amembọọrọ miin;</para>
  <para style="q2" vid="PSA 118:21">afo amekappa ado adinyaaña mmi.<verse eid="PSA 118:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22" />Itiad ake mme abọbufọk ekesịnne</para>
  <para style="q2" vid="PSA 118:22">akappa ado itiad inuuk;<verse eid="PSA 118:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23" />
    <char style="nd">Abọọñ</char> anam ami,</para>
  <para style="q2" vid="PSA 118:23">ndin anye ado utịbe ñkpọ ke anyen ñnyịn.<verse eid="PSA 118:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24" />
    <char style="nd">Abọọñ</char> anam ami ke usen mfịn ami;</para>
  <para style="q2" vid="PSA 118:24">yak ñnyịn idaara mfịn inyʌñ inem esịd.<verse eid="PSA 118:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25" />
    <char style="nd">Abọọñ</char>, inyaaña ñnyịn!</para>
  <para style="q2" vid="PSA 118:25">
    <char style="nd">Abọọñ</char>, nam ñnyịn ikịt mfọnọñkpọ!<verse eid="PSA 118:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26" />Afọfọn anọ anye a-adiighe ke anyịñ <char style="nd">Abọọñ</char>.</para>
  <para style="q2" vid="PSA 118:26">Ñnyịn imito ke ufọk <char style="nd">Abọọñ</char> idiọñ ndufo.<verse eid="PSA 118:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27" />
    <char style="nd">Abọọñ</char> ado Abasi,</para>
  <para style="q2" vid="PSA 118:27">ñko anye anam unwana amọ ayamma inọ ñnyịn.</para>
  <para style="q1" vid="PSA 118:27">Ikama mme ñkọk eto ke ubọk, ikeene isaña ke isañ idaara</para>
  <para style="q2" vid="PSA 118:27">tutu ewuọ mme nnʌk akpokoro uwa.<verse eid="PSA 118:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28" />Afo ado Abasi mmi, ami ñyaanyʌñ utooro fiin;</para>
  <para style="q2" vid="PSA 118:28">afo ado Abasi mmi, ami ñyaanyʌñ ukpono fiin.<verse eid="PSA 118:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29" />Inọ <char style="nd">Abọọñ</char> ekọọm, sia anye afọn;</para>
  <para style="q2" vid="PSA 118:29">ima amọ aba ke nsi-nsi.<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="cl">Saam 119</para>
  <para style="qa">Alef</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1" />Afọfọn anọ mbon ake usʌñ ammọ imiinieghe ndo,</para>
  <para style="q2" vid="PSA 119:1">e-esañake naña mbed <char style="nd">Abọọñ</char> atemme.<verse eid="PSA 119:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2" />Afọfọn anọ mbon enịmme ewʌhọ amọ</para>
  <para style="q2" vid="PSA 119:2">enyʌñ eyem anye ke afịd esịd ammọ,<verse eid="PSA 119:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3" />ammọ inamma idiọọk ndomokeed</para>
  <para style="q2" vid="PSA 119:3">ado ekeene usʌñ amọ.<verse eid="PSA 119:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4" />Afo amenie mme ewʌhọ ake afo anịmme</para>
  <para style="q2" vid="PSA 119:4">a-anaaha nte ekpono ayọhọ-ayọhọ.<verse eid="PSA 119:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5" />O, usʌñ mmi akpekap anie iwuuk</para>
  <para style="q2" vid="PSA 119:5">ke adikop item nnọọ mme ewʌhọ mfo.<verse eid="PSA 119:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6" />Ndọk idinsịmme miin</para>
  <para style="q2" vid="PSA 119:6">ke ini ami ñkereke mbaña afịd mbed mfo.<verse eid="PSA 119:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7" />Ami ñyautooro fiin ke esịd akpanikọ</para>
  <para style="q2" vid="PSA 119:7">ke idaha ñkpeebe ndinen mbed mfo.<verse eid="PSA 119:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8" />Ami ñyaanịm mme ewʌhọ mfo,</para>
  <para style="q2" vid="PSA 119:8">kuusioño idem uñkpọñ miin afịd-afịd.<verse eid="PSA 119:8" /></para>
  <para style="qa">Bed</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9" />Iwaad adiinam die iba ke usʌñ adinenido?</para>
  <para style="q2" vid="PSA 119:9">Ado adidu uwem ñkeene ikọ mfo.<verse eid="PSA 119:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10" />Ami uyem fiin ke afịd esịd mmi;</para>
  <para style="q2" vid="PSA 119:10">kuuyak ami ñwuọ ñkpọñ usʌñ mfo.<verse eid="PSA 119:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11" />Ami mmedịp ikọ mfo ke esịd mmi</para>
  <para style="q2" vid="PSA 119:11">mbaak ami ndinam idiọọkñkpọ.<verse eid="PSA 119:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12" />Itooro unie fiin, <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 119:12">ñkpeep miin ewʌhọ mfo.<verse eid="PSA 119:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13" />Ke ñkpọkinua mmi, ami ñyaamaana mbat</para>
  <para style="q2" vid="PSA 119:13">afịd mme mbed e-etooho inua mfo.<verse eid="PSA 119:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14" />Ami mmenem esịd adikeene ewʌhọ mfo,</para>
  <para style="q2" vid="PSA 119:14">nte awo anem esịd ke uwak inie.<verse eid="PSA 119:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15" />Ami mmekere mbaña mme ukpeebñkpọ mfo</para>
  <para style="q2" vid="PSA 119:15">ñnyʌñ ñkere usʌñ mfo.<verse eid="PSA 119:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16" />Ami mmenem esịd ke mme ewʌhọ mfo;</para>
  <para style="q2" vid="PSA 119:16">Ami ndiikpọññọ ikọ mfo.<verse eid="PSA 119:16" /></para>
  <para style="qa">Kimel</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17" />Fọn ido ye ayịnufọk mfo ke ini ami mbaaha ke uwem,</para>
  <para style="q2" vid="PSA 119:17">nọ ami ñkop item ikọ mfo<verse eid="PSA 119:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18" />Tat anyen mmi nọ ami ñkịt</para>
  <para style="q2" vid="PSA 119:18">mme utịppeñkpọ e-ebaaha ke mbed mfo.<verse eid="PSA 119:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19" />Ami ndo asenawo ke ederimbod;</para>
  <para style="q2" vid="PSA 119:19">kundịp miin mbed mfo.<verse eid="PSA 119:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20" />Ukpọñ mmi ayọhọ ke adiyem</para>
  <para style="q2" vid="PSA 119:20">mme mbed mfo afịd ini.<verse eid="PSA 119:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21" />Afo amesua anọ mbon ntañidem, mbon se esuuñọ,</para>
  <para style="q2" vid="PSA 119:21">mbon e-etịnne ekpọñ mme mbed mfo.<verse eid="PSA 119:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22" />Nsio miin fep ke ñnyọọ ye emiom ammọ;</para>
  <para style="q2" vid="PSA 119:22">sia ami mmenịm mme ewʌhọ mfo.<verse eid="PSA 119:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23" />Akpesʌkado mme mbọọñ etieghe keed embʌkkọ miin,</para>
  <para style="q2" vid="PSA 119:23">ayịnufọk mfo ayaakere abaña mme ewʌhọ mfo.<verse eid="PSA 119:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24" />Mme mbed mfo edo inemesịd mmi;</para>
  <para style="q2" vid="PSA 119:24">ammọ edoñño mme anọitem mmi.<verse eid="PSA 119:24" /></para>
  <para style="qa">Daled</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25" />Ensuuk miin enịm ke ntọñ;</para>
  <para style="q2" vid="PSA 119:25">mʌm uwem mmi kama akeene ikọ mfo.<verse eid="PSA 119:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26" />Ami mmaanam ibad eduuwem mmi ndin afo ambọọrọ miin;</para>
  <para style="q2" vid="PSA 119:26">ñkpeep miin mme ewʌhọ mfo.<verse eid="PSA 119:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27" />Nam yak mme usʌñ mbed mfo añnwaña miin,</para>
  <para style="q2" vid="PSA 119:27">nọ ami ñkere mbaña utịppe adinam mfo.<verse eid="PSA 119:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28" />Ukpọñ mmi aba ke mfʌhọ;</para>
  <para style="q2" vid="PSA 119:28">ben ikọ mfo nsọọñọ miin idem.<verse eid="PSA 119:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29" />Mben miin sio ke usʌñ abiaña;</para>
  <para style="q2" vid="PSA 119:29">nnọ miin mfọn mfo nyʌñ ñkpeep miin mbed mfo.<verse eid="PSA 119:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30" />Ami mmemek usʌñ akpanikọ;</para>
  <para style="q2" vid="PSA 119:30">ami mmewuuk esịd mmi ke mbed mfo.<verse eid="PSA 119:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31" />
    <char style="nd">Abọọñ</char>, ami mmemʌm mbed mfo ñkama;</para>
  <para style="q2" vid="PSA 119:31">kuuyak ami ndia ndọk.<verse eid="PSA 119:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32" />Ami mfeghe ke usʌñ mbed mfo</para>
  <para style="q2" vid="PSA 119:32">sia afo amenam ñkpọ anekke añnwaña miin.<verse eid="PSA 119:32" /></para>
  <para style="qa">He</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33" />
    <char style="nd">Abọọñ</char> ñkpeep miin usʌñ ewʌhọ mfo,</para>
  <para style="q2" vid="PSA 119:33">nọ ami ñkeene anye ñkewuọ akpatre.<verse eid="PSA 119:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34" />Nnọ miin mbufiọk nọ ami ñkan nnịm mbed mfo</para>
  <para style="q2" vid="PSA 119:34">ñnyʌñ ñkop item ke afịd esịd mmi.<verse eid="PSA 119:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35" />Ndat miin usʌñ ke ido mfo,</para>
  <para style="q2" vid="PSA 119:35">sia do ke ami ñkịt inemesịd.<verse eid="PSA 119:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36" />Wọññọ esịd mmi wọt mme mbed mfo</para>
  <para style="q2" vid="PSA 119:36">idooho ñkañ udod idem mmi.<verse eid="PSA 119:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37" />Wọññọ anyen mmi kpọñ usʌñ ñkpọ i-imiibaaha ufọn;</para>
  <para style="q2" vid="PSA 119:37">mʌm uwem mmi kama ke ikọ mfo.<verse eid="PSA 119:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38" />Nam enwọñọ ake afo akenwọñọke anọọ nditọufọk mfo,</para>
  <para style="q2" vid="PSA 119:38">nọ ato do ubaak fiin.<verse eid="PSA 119:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39" />Ben asuenne ami mfegheke sio,</para>
  <para style="q2" vid="PSA 119:39">sia mme mbed mfo afọn.<verse eid="PSA 119:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40" />Se naña ami ñyem mme mbed mfo!</para>
  <para style="q2" vid="PSA 119:40">Ke adinenido mfo mʌm uwem mmi kama.<verse eid="PSA 119:40" /></para>
  <para style="qa">Waw</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41" />
    <char style="nd">Abọọñ</char>, yak nsọọñọnda ima mfo adi ambịne miin,</para>
  <para style="q2" vid="PSA 119:41">adinyaaña mfo, naña enwọñọ mfo ado;<verse eid="PSA 119:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42" />ndin ami ñyaabọọrọ awo akeedodo andọọñọ miin ndọk,</para>
  <para style="q2" vid="PSA 119:42">sia ami mmenie mbuọdidem ke ikọ mfo.<verse eid="PSA 119:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43" />Kuusio ikọ akpanikọ mfo ke inua mmi,</para>
  <para style="q2" vid="PSA 119:43">sia ami mmesịn idodanyen mmi ke mme mbed mfo.<verse eid="PSA 119:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44" />Ami ñyaakaa iso nnịm mbed mfo afịd ini,</para>
  <para style="q2" vid="PSA 119:44">ke nsi-nsi nsi-nsi.<verse eid="PSA 119:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45" />Ami ñyaasaña naña mmama,</para>
  <para style="q2" vid="PSA 119:45">sia ami mmeyeem mme mbed mfo.<verse eid="PSA 119:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46" />Ami ñyaatañ mbaña mme mbed mfo ke iso ndidem</para>
  <para style="q2" vid="PSA 119:46">ñko ami ndiidiaha ndọk,<verse eid="PSA 119:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47" />ami mmekop inem ke mme mbed mfo</para>
  <para style="q2" vid="PSA 119:47">sia ami mmema ammọ.<verse eid="PSA 119:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48" />Ami mmeyem mme mbed mfo, ake ami mmaaha,</para>
  <para style="q2" vid="PSA 119:48">nọ ami ñkere ke isọñ esịd mmi mbaña mme ewʌhọ mfo.<verse eid="PSA 119:48" /></para>
  <para style="qa">Sayịn</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49" />Toiyo ikọ ake afo akenọọhọ ayịnufọk mfo,</para>
  <para style="q2" vid="PSA 119:49">sia afo amennọ miin idodanyen.<verse eid="PSA 119:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50" />Idọñesịd ke ufen ami mbọọhọ ado ami:</para>
  <para style="q2" vid="PSA 119:50">Enwọñọ mfo ayaamʌm uwem mmi akama.<verse eid="PSA 119:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51" />Mbon ñkịdidem ennọ ñnyọọ intuaha mbọm,</para>
  <para style="q2" vid="PSA 119:51">ado ami ndiitịmmeke ñkpọñ mbed mfo.<verse eid="PSA 119:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52" />
    <char style="nd">Abọọñ</char>, ami mmetoiyo mme mbed mfo ake esed,</para>
  <para style="q2" vid="PSA 119:52">ñko ami mmekịt idọñesịd ke ammọ.<verse eid="PSA 119:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53" />Ami nnie mbʌññọesịd ke ntak mbon ibak,</para>
  <para style="q2" vid="PSA 119:53">ake ewuọhọ ekpọñ mbed mfo.<verse eid="PSA 119:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54" />Mme ewʌhọ mfo edoñño iwuod ikọ ikwọ mmi</para>
  <para style="q2" vid="PSA 119:54">ke itie akeedodo ami mbaaha.<verse eid="PSA 119:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55" />
    <char style="nd">Abọọñ</char>, ami mmetoiyo anyịñ mfo ke akonayio,</para>
  <para style="q2" vid="PSA 119:55">nọ ato do ami ñkan nnịm mbed mfo.<verse eid="PSA 119:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56" />Naña ami nsinam ado ado;</para>
  <para style="q2" vid="PSA 119:56">ami mmekop item ake mme mbed mfo.<verse eid="PSA 119:56" /></para>
  <para style="qa">Hed</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57" />
    <char style="nd">Abọọñ</char>, afo ado udeeme mmi,</para>
  <para style="q2" vid="PSA 119:57">ami mmenam enwọñọ adikop mme ikọ mfo.<verse eid="PSA 119:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58" />Ami mmeyem iso mfo ke afịd esịd mmi;</para>
  <para style="q2" vid="PSA 119:58">nie mbọm mbaña miin keene naña enwọñọ mfo ado.<verse eid="PSA 119:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59" />Ami mmetịm nse usʌñ mmi</para>
  <para style="q2" vid="PSA 119:59">ñnyʌñ ñkanna ikpadisañ mmi ñwọt mme mbed mfo.<verse eid="PSA 119:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60" />Ami ñyaasọp idem, ñko ndiibiatta ini</para>
  <para style="q2" vid="PSA 119:60">adikpono mme ewʌhọ mfo.<verse eid="PSA 119:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61" />Akpesʌkado mbon ibak embọppọ miin ke udʌk,</para>
  <para style="q2" vid="PSA 119:61">ami ndiifreke mbed mfo.<verse eid="PSA 119:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62" />Ke ufọọd akonayio, ami ndakka nda adunọ fiin ekọọm</para>
  <para style="q2" vid="PSA 119:62">ke mme ndinen mbed mfo.<verse eid="PSA 119:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63" />Ami ndo ufan nnọ afịd mbon se ubaak fiin,</para>
  <para style="q2" vid="PSA 119:63">ye mbon e-ekeeneke mme mbed mfo.<verse eid="PSA 119:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64" />
    <char style="nd">Abọọñ</char>, ederimbod ayọhọ ye ima mfo,</para>
  <para style="q2" vid="PSA 119:64">ñkpeep miin mme ewʌhọ mfo.<verse eid="PSA 119:64" /></para>
  <para style="qa">Ted</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65" />
    <char style="nd">Abọọñ</char>, nam eti ñkpọ nọ ayịnufọk mfo</para>
  <para style="q2" vid="PSA 119:65">akeene naña asịne ke ikọ mfo.<verse eid="PSA 119:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66" />Ñkpeep miin ifiọk ye eti ubiideikpe,</para>
  <para style="q2" vid="PSA 119:66">sia ami mmenie mbuọdidem ke mme mbed mfo.<verse eid="PSA 119:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67" />Mbemiso ekennọ ufen, ami mmaawuọ ñkpọñ usʌñ,</para>
  <para style="q2" vid="PSA 119:67">ado idahami ami mmekop item ikọ mfo.<verse eid="PSA 119:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68" />Afo amefọn, ñko se afo anam afọn;</para>
  <para style="q2" vid="PSA 119:68">ñkpeep miin mme ewʌhọ mfo.<verse eid="PSA 119:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69" />Akpesʌkado mbon ñkịdidem emfiọññọ miin nsu,</para>
  <para style="q2" vid="PSA 119:69">ami mmenịm mme mbed mfo ke afịd esịd mmi.<verse eid="PSA 119:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70" />Esịd ammọ amaadodo ufiọn inyʌññọ inie mbọm,</para>
  <para style="q2" vid="PSA 119:70">ado ami ndat esịd ke mbed mfo.<verse eid="PSA 119:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71" />Amaafọn naña ekennọọ ukuud</para>
  <para style="q2" vid="PSA 119:71">nọ ami ñkpeep mme ewʌhọ mfo.<verse eid="PSA 119:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72" />Mbed a-atooho inua mfo asọñ udua annọ miin</para>
  <para style="q2" vid="PSA 119:72">akan mme tọsịn mbaak silfa ye kold.<verse eid="PSA 119:72" /></para>
  <para style="qa">Yod</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73" />Ubọk mfo akembot miin anyʌñ annam miin;</para>
  <para style="q2" vid="PSA 119:73">nnọ miin ifiọk adikpeep mme ewʌhọ mfo.<verse eid="PSA 119:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74" />Yak mbon se ubaak fiin edaara ke ini ammọ eñkịtte miin,</para>
  <para style="q2" vid="PSA 119:74">sia ami nsịn idodanyen mmi ke ikọ mfo.<verse eid="PSA 119:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75" />
    <char style="nd">Abọọñ</char>, ami mmediọọñọ, ke mme mbed mfo edoñño ndinen,</para>
  <para style="q2" vid="PSA 119:75">ndin ke akpanikọ ke afo amentʌkkọ miin.<verse eid="PSA 119:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76" />Yak nsọọñọ nda ima mfo ado idọñesịd annọ miin,</para>
  <para style="q2" vid="PSA 119:76">akeene naña akenwọñọ anọọ ayịnufọk mfo.<verse eid="PSA 119:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77" />Yak ima mfo adi ambịne miin nọ ami ndu uwem,</para>
  <para style="q2" vid="PSA 119:77">sia ikọ mfo ado idadesịd mmi.<verse eid="PSA 119:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78" />Yak mbon ñkịdidem edia abuud ke ntak ammọ ennamma miin se imiifọnnọ ke unana ntak;</para>
  <para style="q2" vid="PSA 119:78">ado ami ñyaasịn akikere ke mme mbed mfo.<verse eid="PSA 119:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79" />Yak mbon se ubaak fiin ekanna embịne miin,</para>
  <para style="q2" vid="PSA 119:79">mbon ake mme mbed mfo anwañake.<verse eid="PSA 119:79" /></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80" />Yak ami ñkeene mme ewʌhọ mfo ke afịd esịd mmi,</para>
  <para style="q2" vid="PSA 119:80">mbaak ami ndidia ndọk.<verse eid="PSA 119:80" /></para>
  <para style="qa">Kaf</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81" />Esịd mmi aduọ ke ami adiyem adinyaaña mfo,</para>
  <para style="q2" vid="PSA 119:81">ado ami mmesịn idodanyen mmi ke ikọ mfo.<verse eid="PSA 119:81" /></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82" />Anyen mmi añkpu ke adiyem enwọñọ mfo;</para>
  <para style="q2" vid="PSA 119:82">ami mbo, “idaha akee ke afo udundọñ miin esịd?”<verse eid="PSA 119:82" /></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83" />Akpesʌkado ami mbaaha nte ekpadukọd ke nsʌñikañ,</para>
  <para style="q2" vid="PSA 119:83">ami mfreke mme ewʌhọ mfo.<verse eid="PSA 119:83" /></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84" />Awo mfo adiibet ikpeene die?</para>
  <para style="q2" vid="PSA 119:84">Idaha akee ke afo adiimia mbon eñyịreke miin ufen?<verse eid="PSA 119:84" /></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85" />Mbon ñkịdidem etịppe ube ekama ekọọk afia ennọ miin,</para>
  <para style="q2" vid="PSA 119:85">a-adooho isañake ke mbed mfo.<verse eid="PSA 119:85" /></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86" />Adot se enie mbuọdidem ke afịd mme ewʌhọ mfo;</para>
  <para style="q2" vid="PSA 119:86">ñnwam miin sia entʌhọde miin ke unana ntak.<verse eid="PSA 119:86" /></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87" />Ayak etək ekpaensio miin ifep ke iso isọñ,</para>
  <para style="q2" vid="PSA 119:87">ado ami ñwuọhọ ñkpọñ mme mbed mfo.<verse eid="PSA 119:87" /></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88" />Ke ima mfo mʌm uwem mmi kama,</para>
  <para style="q2" vid="PSA 119:88">nọ ami ñkop item ke mbed a-atooho inua mfo.<verse eid="PSA 119:88" /></para>
  <para style="qa">Lamed</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89" />
    <char style="nd">Abọọñ</char>, ikọ mfo ado ke nsi-nsi,</para>
  <para style="q2" vid="PSA 119:89">anie iwuuk ke mme anyọñ.<verse eid="PSA 119:89" /></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90" />Akpanikọ mfo akaka iso ke afịd emana;</para>
  <para style="q2" vid="PSA 119:90">afo aketọọñọ ederimbod anye ñko asʌk asọọñọ aba.<verse eid="PSA 119:90" /></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91" />Mme mbed mfo ekaa iso eba edisịm ini ami,</para>
  <para style="q2" vid="PSA 119:91">sia afịd ñkpọ enam ñkpọ unọ fiin.<verse eid="PSA 119:91" /></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92" />Akpedo mbed mfo ikidooho idadesịd mmi,</para>
  <para style="q2" vid="PSA 119:92">ami ñkpaaketak ke ndutʌhọ mmi.<verse eid="PSA 119:92" /></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93" />Ami ndiifreke mme mbed mfo tutu amama,</para>
  <para style="q2" vid="PSA 119:93">sia ato ke ammọ afo annịm miin uwem.<verse eid="PSA 119:93" /></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94" />Ñnyaaña miin, sia ami ndo ake mfo,</para>
  <para style="q2" vid="PSA 119:94">Ami mmeyem mme edu unam ñkpọ mfo.<verse eid="PSA 119:94" /></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95" />Mbon ibak mmọdo eda ebet adintịmede miin,</para>
  <para style="q2" vid="PSA 119:95">ado ami ñkere mbaña mme mbed mfo.<verse eid="PSA 119:95" /></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96" />Ke afịd se ifọn ima, ami mmekịt adaña,</para>
  <para style="q2" vid="PSA 119:96">ado mbed mfo inieghe utịd.<verse eid="PSA 119:96" /></para>
  <para style="qa">Mem</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97" />O, sese naña ami mma mbed mfo!</para>
  <para style="q2" vid="PSA 119:97">Ami nsịn esịd ke anye afịd usen.<verse eid="PSA 119:97" /></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98" />Mme mbed mfo esʌk eba ye ami afịd ini</para>
  <para style="q2" vid="PSA 119:98">enyʌñ enam ami nnie aniọñ ñkan mme asua mmi.<verse eid="PSA 119:98" /></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99" />Ami mmenie ifiọk ñkan afịd mme andikpeeb mmi,</para>
  <para style="q2" vid="PSA 119:99">sia esịd mmi asịne ke mme mbed mfo.<verse eid="PSA 119:99" /></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100" />Ñkpọ añnwaña miin akan mme ñkpisọñ,</para>
  <para style="q2" vid="PSA 119:100">sia ami mmekop item nnọ ikọ mfo.<verse eid="PSA 119:100" /></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101" />Ami nsịnne ukod mmi ke afañ idiọọkñkpọ ndomokeed</para>
  <para style="q2" vid="PSA 119:101">nọ ami ñkan ñkop item nnọ ikọ mfo.<verse eid="PSA 119:101" /></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102" />Ami ñwuọhọ ñkpọñ mme mbed mfo;</para>
  <para style="q2" vid="PSA 119:102">sia afo ke idem mfo añkpeep miin.<verse eid="PSA 119:102" /></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103" />Ikọ mfo annem miin die ntom ke inua,</para>
  <para style="q2" vid="PSA 119:103">anem akan adanakwọọk ke inua mmi!<verse eid="PSA 119:103" /></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104" />Ami mmenie ndiọọñọidem nto mme mbed mfo;</para>
  <para style="q2" vid="PSA 119:104">ke ntoro mmesua afịd idiọọk afañ.<verse eid="PSA 119:104" /></para>
  <para style="qa">Nun</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105" />Ikọ mfo ado utuenikañ anọ ukod mmi,</para>
  <para style="q2" vid="PSA 119:105">ado unwana anọ usʌñ mmi.<verse eid="PSA 119:105" /></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106" />Ami mmaata unwọñọ mmaana nsọọñọ,</para>
  <para style="q2" vid="PSA 119:106">ke ami ñyaakeene mme ndinen mbed mfo.<verse eid="PSA 119:106" /></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107" />Ami mmebọ ufen eti-eti;</para>
  <para style="q2" vid="PSA 119:107">
    <char style="nd">Abọọñ</char>, mʌm uwem mmi kama akeene ikọ mfo.<verse eid="PSA 119:107" /></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108" />
    <char style="nd">Abọọñ</char>, bọ itooro a-atooho unyịmme inua mmi,</para>
  <para style="q2" vid="PSA 119:108">nyʌñ ñkpeep miin mme mbed mfo.<verse eid="PSA 119:108" /></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109" />Akpesʌkado ami mmesima adikama uwem mmi ke idem mmi,</para>
  <para style="q2" vid="PSA 119:109">ami ndiifreke mbed mfo.<verse eid="PSA 119:109" /></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110" />Mbon ibak ekọọk afia ennọ miin;</para>
  <para style="q2" vid="PSA 119:110">ado ami ñwuọhọ ñkpọñ usʌñ mfo.<verse eid="PSA 119:110" /></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111" />Mme mbed mfo edo udeeme mmi ke nsi-nsi;</para>
  <para style="q2" vid="PSA 119:111">ammọ edo idaara ake ami nnieghe ke esịd mmi.<verse eid="PSA 119:111" /></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112" />Esịd mmi asọọñọ ada adinam mme ewʌhọ mfo</para>
  <para style="q2" vid="PSA 119:112">tutu asịm ataa utịd.<verse eid="PSA 119:112" /></para>
  <para style="qa">Samek</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113" />Ami mmesua mbon esịd iba,</para>
  <para style="q2" vid="PSA 119:113">ado mmema mbed mfo.<verse eid="PSA 119:113" /></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114" />Afo ado itie udịbe ye atuekọñ mmi;</para>
  <para style="q2" vid="PSA 119:114">ami mmesịn idodanyen mmi ke ikọ mfo.<verse eid="PSA 119:114" /></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115" />Ndufo mme anam idiọọkñkpọ,</para>
  <para style="q2" vid="PSA 119:115">idaaña iñkpọñ miin, nọ ami nnịm mme mbed Abasi mmi!<verse eid="PSA 119:115" /></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116" />Abasi nnịm miin keene enwọñọ mfo, ndin ami ñyaadu uwem;</para>
  <para style="q2" vid="PSA 119:116">kuuyak idodanyen mmi akpa mfʌhọ.<verse eid="PSA 119:116" /></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117" />Mmʌm miin kama, ndin ami ñyaabọkkọ;</para>
  <para style="q2" vid="PSA 119:117">ami ndiisʌk nnenie mbaak nnọ mme ewʌhọ mfo.<verse eid="PSA 119:117" /></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118" />Afo amesịn afịd mbon ewuọhọ ekpọñ mme ewʌhọ mfo;</para>
  <para style="q2" vid="PSA 119:118">sia mme abiaña ammọ ewuọñọ ikpu-ikpu.<verse eid="PSA 119:118" /></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119" />Afo ameduọọñọ afịd mbon ibak ke ederimbod nte mbio;</para>
  <para style="q2" vid="PSA 119:119">ke ntoro ami mmema mme mbed mfo.<verse eid="PSA 119:119" /></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120" />Ndịk mfo anam abʌkidem mmi anyeñ;</para>
  <para style="q2" vid="PSA 119:120">ami nda ke uteeñe mbaña mme mbed mfo.<verse eid="PSA 119:120" /></para>
  <para style="qa">Ayịn</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121" />Ami mmenam se ifọn inyʌñ inen;</para>
  <para style="q2" vid="PSA 119:121">kuñyaak miin unọọ mbon se imfiik miin.<verse eid="PSA 119:121" /></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122" />Kịt bo ke ayịnufọk mfo ada yak afọn;</para>
  <para style="q2" vid="PSA 119:122">kuuyaak mbon ntañidem emfiik miin.<verse eid="PSA 119:122" /></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123" />Anyen mmi ifọnnọ aba, ke adiyem adinyaaña mfo,</para>
  <para style="q2" vid="PSA 119:123">ke adiyem adisana enwọñọ mfo.<verse eid="PSA 119:123" /></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124" />Nam ñkpọ ye ayịnufọk mfo ke ima</para>
  <para style="q2" vid="PSA 119:124">nyʌñ ñkpeep miin mme ewʌhọ mfo.<verse eid="PSA 119:124" /></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125" />Ami ndo ayịnufọk mfo; nnọ miin ikike</para>
  <para style="q2" vid="PSA 119:125">nọ mme mbed mfo añnwaña miin.<verse eid="PSA 119:125" /></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126" />
    <char style="nd">Abọọñ</char>, ini ado ami a-anaaha nte afo adịppe idem</para>
  <para style="q2" vid="PSA 119:126">sia ebiat mbed mfo.<verse eid="PSA 119:126" /></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127" />Sia ami mmema mme mbed mfo,</para>
  <para style="q2" vid="PSA 119:127">ñkan kold, mma ñkan ataa adisana kold,<verse eid="PSA 119:127" /></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128" />ñko sia ami ndatta afịd mbed mfo nte nnen-nnen,</para>
  <para style="q2" vid="PSA 119:128">ami mmesua ukeed idiọọk usʌñ.<verse eid="PSA 119:128" /></para>
  <para style="qa">Pe</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129" />Mme ewʌhọ mfo edo utịppe,</para>
  <para style="q2" vid="PSA 119:129">ke ntoro ami mmekop item ammọ.<verse eid="PSA 119:129" /></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130" />Adiben ikọ mfo ñyaara anwa-anwa anọ unwana;</para>
  <para style="q2" vid="PSA 119:130">anye anọ mme akọi ndiọọñọidem.<verse eid="PSA 119:130" /></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131" />Ami ñnweek inua inwañ,</para>
  <para style="q2" vid="PSA 119:131">ñyem mme mbed mfo.<verse eid="PSA 119:131" /></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132" />Kanna nse miin nyʌñ nie mbọm mbaña miin,</para>
  <para style="q2" vid="PSA 119:132">naña afo asinam afịd ini anọọ mbon se ima anyịñ mfo.<verse eid="PSA 119:132" /></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133" />Ñwọt miin usʌñ keene ikọ mfo,</para>
  <para style="q2" vid="PSA 119:133">kuuyak idiọọkñkpọ ndomokeed añkara miin.<verse eid="PSA 119:133" /></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134" />Mfak miin sio ke ndutʌhọ ubon awo;</para>
  <para style="q2" vid="PSA 119:134">nọ ami ñkop item mbed mfo.<verse eid="PSA 119:134" /></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135" />Nam nọ iso mfo ayama anọ ayịnufọk mfo</para>
  <para style="q2" vid="PSA 119:135">nyʌñ ñkpeep miin mme ewʌhọ mfo.<verse eid="PSA 119:135" /></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136" />Mmọọñayịd mmi afiọrọ nte idịm;</para>
  <para style="q2" vid="PSA 119:136">sia awo ikoppo item inọ mbed mfo.<verse eid="PSA 119:136" /></para>
  <para style="qa">Sade</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137" />
    <char style="nd">Abọọñ</char>, afo ado adinen,</para>
  <para style="q2" vid="PSA 119:137">mme mbed mfo ñko edo nnen-nnen.<verse eid="PSA 119:137" /></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138" />Mme ewʌhọ se afo aboon ke isọñ edoñño ndinen;</para>
  <para style="q2" vid="PSA 119:138">ammọ edo se awo adot anyen ayọhọ-ayọhọ.<verse eid="PSA 119:138" /></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139" />Akpọsọñ udọñ mmi anam idem ammem miin,</para>
  <para style="q2" vid="PSA 119:139">sia mme asua mmi etuut ikọ mfo enịm.<verse eid="PSA 119:139" /></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140" />Enekke etʌm edomo mme enwọñọ mfo,</para>
  <para style="q2" vid="PSA 119:140">ayịnufọk mfo anyʌñ ama ammọ.<verse eid="PSA 119:140" /></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141" />Akpesʌkado ndo ikpọọñ, enyʌñ ense ke ndek,</para>
  <para style="q2" vid="PSA 119:141">ami mfreke mme mbed mfo.<verse eid="PSA 119:141" /></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142" />Adinenido mfo ado ke nsi-nsi,</para>
  <para style="q2" vid="PSA 119:142">mbed mfo ñko ado akpanikọ.<verse eid="PSA 119:142" /></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143" />Mfịna ye ukuud ansịm miin;</para>
  <para style="q2" vid="PSA 119:143">ado mme mbed mfo ennọ miin inemesịd.<verse eid="PSA 119:143" /></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144" />Mme ewʌhọ mfo esʌk edo ndinen afịd ini;</para>
  <para style="q2" vid="PSA 119:144">nnọ miin ifiọk nọ ami ndu uwem.<verse eid="PSA 119:144" /></para>
  <para style="qa">Kof</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145" />
    <char style="nd">Abọọñ</char>; ami ukoot fiin ke afịd esịd; mbọọrọ miin,</para>
  <para style="q2" vid="PSA 119:145">ndin ami ñyaakop item mme ewʌhọ mfo.<verse eid="PSA 119:145" /></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146" />Ami mbọọñ ukoot fiin; ñnyaaña miin</para>
  <para style="q2" vid="PSA 119:146">ndin ami ñyaanịm mme mbed mfo.<verse eid="PSA 119:146" /></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147" />Atiwuọ usiere ami mmedemme, ntua ñyem unwam,</para>
  <para style="q2" vid="PSA 119:147">ami mmesịn idodanyen mmi ke ikọ mfo.<verse eid="PSA 119:147" /></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148" />Anyen mmi ana inwañ afịd akonayio</para>
  <para style="q2" vid="PSA 119:148">nọ ami nsịn akikere mmi ke mme enwọñọ mfo.<verse eid="PSA 119:148" /></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149" />Kop uyio mmi keene ntak ima mfo <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 119:149">mʌm uwem mmi keene ntak mme mbed mfo.<verse eid="PSA 119:149" /></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150" />Mbon e-enamma ibak ekpere;</para>
  <para style="q2" vid="PSA 119:150">ado ammọ enyọọñ usʌñ ekpọñ mbed mfo.<verse eid="PSA 119:150" /></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151" />
    <char style="nd">Abọọñ</char> kpayeado afo amekpere,</para>
  <para style="q2" vid="PSA 119:151">ñko afịd mbed mfo edo akpanikọ.<verse eid="PSA 119:151" /></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152" />Ke anyan ini koo ami mmaakpeep nto mbed mfo</para>
  <para style="q2" vid="PSA 119:152">ke afo akenam ammọ yak ediiba ke nsi-nsi.<verse eid="PSA 119:152" /></para>
  <para style="qa">Res</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153" />Kanna anyen se ufen mmi nyʌñ ñnyaaña miin,</para>
  <para style="q2" vid="PSA 119:153">sia ami mfreke mbed mfo.<verse eid="PSA 119:153" /></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154" />Kpe ikpe iwuod mmi ñnyʌñ mfak sio,</para>
  <para style="q2" vid="PSA 119:154">mʌm uwem mmi kama akeene enwọñọ mfo.<verse eid="PSA 119:154" /></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155" />Adinyaaña anyọọñ usʌñ akpọñ mbon ibak,</para>
  <para style="q2" vid="PSA 119:155">sia ammọ isiyemme mme ewʌhọ mfo.<verse eid="PSA 119:155" /></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156" />
    <char style="nd">Abọọñ</char> mbọm mfo akpon;</para>
  <para style="q2" vid="PSA 119:156">mʌm uwem mmi kama keene mme mbed mfo.<verse eid="PSA 119:156" /></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157" />Mme asua etʌkkọke uwem mmi ewak,</para>
  <para style="q2" vid="PSA 119:157">ado ami ntịmmeke ñkpọñ mme mbed mfo.<verse eid="PSA 119:157" /></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158" />Ami nse mbon unana mbuọdidem ke ndek,</para>
  <para style="q2" vid="PSA 119:158">sia ammọ ikoppo item inọ ikọ mfo.<verse eid="PSA 119:158" /></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159" />Se naña ami mma mme mbed mfo;</para>
  <para style="q2" vid="PSA 119:159">
    <char style="nd">Abọọñ</char>, mʌm uwem mmi kama keene ima mfo.<verse eid="PSA 119:159" /></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160" />Afịd ikọ mfo edo akpanikọ,</para>
  <para style="q2" vid="PSA 119:160">afịd ndinen mbed mfo eba ke nsi-nsi.<verse eid="PSA 119:160" /></para>
  <para style="qa">Sin ye Siin</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161" />Mme andikara eñkọbọ miin ke unana ntak,</para>
  <para style="q2" vid="PSA 119:161">ado esịd mmi anyeñ ke ikọ mfo.<verse eid="PSA 119:161" /></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162" />Ami mmedat esịd ke enwọñọ mfo</para>
  <para style="q2" vid="PSA 119:162">nte awo a-akịtte ekamba mbịme.<verse eid="PSA 119:162" /></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163" />Ami mmesua ñnyʌñ ñkpaaña nsa ke abiaña</para>
  <para style="q2" vid="PSA 119:163">ado mmema mbed mfo.<verse eid="PSA 119:163" /></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164" />Akañ itiaba ke usen ke ami nsutooro fiin</para>
  <para style="q2" vid="PSA 119:164">ke ntak ndinen mbed mfo.<verse eid="PSA 119:164" /></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165" />Ekamba emem ke mbon se ima mbed mfo enie,</para>
  <para style="q2" vid="PSA 119:165">ñko ibaaha se ikpinam ammọ efiọnnọ eduọ.<verse eid="PSA 119:165" /></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166" />
    <char style="nd">Abọọñ</char>, ami nda mbet adinyaaña mfo,</para>
  <para style="q2" vid="PSA 119:166">ñko ami ñnyʌñ ñkeene mme mbed mfo.<verse eid="PSA 119:166" /></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167" />Ami mmekop item mbed mfo,</para>
  <para style="q2" vid="PSA 119:167">sia ami mmenekke mma ammọ.<verse eid="PSA 119:167" /></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168" />Ami mmekop item nnam mme mbed mfo ye mme ewʌhọ mfo,</para>
  <para style="q2" vid="PSA 119:168">sia afo amediọọñọ afịd usʌñ mmi<verse eid="PSA 119:168" /></para>
  <para style="qa">Tau</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169" />
    <char style="nd">Abọọñ</char>, yak ntuaayịd mmi adọọk ubịne mfịn;</para>
  <para style="q2" vid="PSA 119:169">nam nọ ñkpọ añnwaña miin naña ado ke ikọ mfo.<verse eid="PSA 119:169" /></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170" />Yak akam mbʌññọesịd mmi adi ubịne fiin;</para>
  <para style="q2" vid="PSA 119:170">mfak miin keene naña ado ke enwọñọ mfo.<verse eid="PSA 119:170" /></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171" />Yak ñkpọkinua mmi ayọhọ ye itooro mfo;</para>
  <para style="q2" vid="PSA 119:171">sia afo ameñkpeep miin mme ewʌhọ mfo.<verse eid="PSA 119:171" /></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172" />Yak edeme mmi akwọ ikọ mfo;</para>
  <para style="q2" vid="PSA 119:172">sia afịd mme mbed mfo edo ndinen.<verse eid="PSA 119:172" /></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173" />Yak ubọk mfo abeeñe idem adiñnwam miin;</para>
  <para style="q2" vid="PSA 119:173">sia ami mmemek mme mbed mfo ndat.<verse eid="PSA 119:173" /></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174" />
    <char style="nd">Abọọñ</char> ami mmeyem adinyaaña mfo,</para>
  <para style="q2" vid="PSA 119:174">ñko mbed mfo annọ miin idadesịd.<verse eid="PSA 119:174" /></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175" />Nam ami ndu uwem nọ ami utooro fiin,</para>
  <para style="q2" vid="PSA 119:175">ñko yak mme mbed mfo emmʌm miin ekama.<verse eid="PSA 119:175" /></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176" />Ami mmeyooñ nte edọñ a-asoppo usʌñ.</para>
  <para style="q2" vid="PSA 119:176">Yem ayịnufọk mfo,</para>
  <para style="q2" vid="PSA 119:176">sia ami mfreke mme mbed mfo.<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="cl">Saam 120</para>
  <para style="d">Ikwọ adidọọk</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1" />Ami ñkoot <char style="nd">Abọọñ</char> ke ini nnananyen mmi,</para>
  <para style="q2" vid="PSA 120:1">ndin anye ambọọrọ miin.<verse eid="PSA 120:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2" />
    <char style="nd">Abọọñ</char> ñnyaaña miin,</para>
  <para style="q2" vid="PSA 120:2">sio ke ñkpọkinua nsu</para>
  <para style="q2" vid="PSA 120:2">ye mme edeme abiaña.<verse eid="PSA 120:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3" />Nsoo ke anye aduunam fiin,</para>
  <para style="q2" vid="PSA 120:3">ñko nsoo ñkpọ mfen,</para>
  <para style="q2" vid="PSA 120:3">afo edeme abiaña.<verse eid="PSA 120:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4" />Anye ayaakama mme idañ awo ekọñ umia fiin ufen,</para>
  <para style="q2" vid="PSA 120:4">ye asakikañ ñkañ a-atooho nsadañ.<verse eid="PSA 120:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5" />Adiọọk annọ miin sia ndʌñ ke Mesek,</para>
  <para style="q2" vid="PSA 120:5">sia ndʌñ ke mme atayad Keda!<verse eid="PSA 120:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6" />Ami mmedʌñ ñkpeene mbọhọ</para>
  <para style="q2" vid="PSA 120:6">ke atu mbon esuaha emem.<verse eid="PSA 120:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7" />Ami nda nnọ emem;</para>
  <para style="q2" vid="PSA 120:7">ado ami mmaatañ ikọ, ammọ eyem ekọñ.<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="cl">Saam 121</para>
  <para style="d">Ikwọ adidọọk</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1" />Ami mmedịppe anyen mmi nse mme ikpọabod,</para>
  <para style="q2" vid="PSA 121:1">unwam mmi ato uke?<verse eid="PSA 121:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2" />Adinyaaña mmi ato <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 121:2">Andinam anyọñ ye isọn.<verse eid="PSA 121:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3" />Anye idiiyakka ukod mfo afiọnnọ,</para>
  <para style="q2" vid="PSA 121:3">anye ake ukpemeke fiin idiidaiyake;<verse eid="PSA 121:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4" />ke akpanikọ, anye a-akpemeke Isrel</para>
  <para style="q2" vid="PSA 121:4">idiidaiyake idiinyʌññọ ikep anyen.<verse eid="PSA 121:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5" />
    <char style="nd">Abọọñ</char>ado andukpeme fiin,</para>
  <para style="q2" vid="PSA 121:5">
    <char style="nd">Abọọñ</char> ado andufʌk fiin ke ubọk nnasia mfo;<verse eid="PSA 121:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6" />ayio iduumiaha fiin ke uweemeayio,</para>
  <para style="q2" vid="PSA 121:6">afiọñ idiinyʌññọ umia ke akonayio.<verse eid="PSA 121:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7" />
    <char style="nd">Abọọñ</char> ayaukpeme fiin asio ke afịd idiọọk,</para>
  <para style="q2" vid="PSA 121:7">anye ayaakpeme uwem mfo;<verse eid="PSA 121:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8" />
    <char style="nd">Abọọñ</char> ayaakpeme adiwuọ ye adinyọñ mfo</para>
  <para style="q2" vid="PSA 121:8">idahami ye ke nsi-nsi.<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="cl">Saam 122</para>
  <para style="d">Ikwọ adidọọk. Ake Defid.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1" />Ami mmaanem esịd ye mbon ekembooho miin,</para>
  <para style="q2" vid="PSA 122:1">“Yak ñnyịn ika ufọk <char style="nd">Abọọñ</char>.”<verse eid="PSA 122:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2" />Ukod ñnyịn mmọdo ada</para>
  <para style="q2" vid="PSA 122:2">ke mme inuaatob mfo, Yeruselem.<verse eid="PSA 122:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3" />Ebọp Yeruselem nte abio</para>
  <para style="q2" vid="PSA 122:3">a-adianake itie keed.<verse eid="PSA 122:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4" />Itie ado ke mme aduuk edọọk anyọñ,</para>
  <para style="q2" vid="PSA 122:4">mme aduuk <char style="nd">Abọọñ</char>,</para>
  <para style="q1" vid="PSA 122:4">aditooro anyịñ <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 122:4">akeene mme ewʌhọ e-ekenọọhọ Isrel.<verse eid="PSA 122:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5" />Do ke mme ebekpo ubiideikpe eba,</para>
  <para style="q2" vid="PSA 122:5">mme ebekpo ufọk Defid.<verse eid="PSA 122:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6" />Ibọñ akam nọ Yeruselem anie emem:</para>
  <para style="q2" vid="PSA 122:6">“Yak mbon ake umaaha fiin enie ifuuro.<verse eid="PSA 122:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7" />Yak emem aba ke esịd ufọk mfo</para>
  <para style="q2" vid="PSA 122:7">ye ukpeme ke mme ikpọ ufọk ndufo.”<verse eid="PSA 122:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8" />Ke ntak ekpək ye mme ufan mmi,</para>
  <para style="q2" vid="PSA 122:8">ami ñyaabo, “Emem aba ke ufọọd ndufo.”<verse eid="PSA 122:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9" />Ke ntak ufọk <char style="nd">Abọọñ</char> Abasi ñnyịn,</para>
  <para style="q2" vid="PSA 122:9">ami ñyaayem uforo mfo.<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="cl">Saam 123</para>
  <para style="d">Ikwọ adidọọk.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1" />Ami mmebenne anyen mmi use fiin,</para>
  <para style="q2" vid="PSA 123:1">afo a-atieghe ke ebekpo ke anyọñ.<verse eid="PSA 123:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2" />Nte anyen ifʌn aseeghe ubọk eteufọk,</para>
  <para style="q2" vid="PSA 123:2">nte anyen afʌn awonwaan aseeghe ubọk ekaufọk,</para>
  <para style="q1" vid="PSA 123:2">kpa ntoro ke anyen ñnyịn ase <char style="nd">Abọọñ</char> Abasi ñnyịn,</para>
  <para style="q2" vid="PSA 123:2">tutu anye iwọt ñnyịn mbọm amọ.<verse eid="PSA 123:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3" />Itua ñnyịn mbọm, <char style="nd">Abọọñ</char>, itua ñnyịn mbọm,</para>
  <para style="q2" vid="PSA 123:3">sia ñnyịn imiyọ ananautịd abuud.<verse eid="PSA 123:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4" />Ñnyịn imiyọ ananautịd ndọk</para>
  <para style="q2" vid="PSA 123:4">a-atooho mbon ntañidem,</para>
  <para style="q2" vid="PSA 123:4">emiom a-atooho mbon ñkokkoidem.<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="cl">Saam 124</para>
  <para style="d">Ikwọ adidọọk. Ake Defid</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1" />Yak Isrel ebo,</para>
  <para style="q2" vid="PSA 124:1">akpedo <char style="nd">Abọọñ</char> ikibaaha ye ñkañ ñnyịn,<verse eid="PSA 124:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2" />akpedo <char style="nd">Abọọñ</char> ikibaaha ye ñkañ ñnyịn</para>
  <para style="q2" vid="PSA 124:2">idaha mbon awo ekenamma ikọ ye ñnyịn,<verse eid="PSA 124:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3" />ammọ ekpaekimen ñnyịn ndisi</para>
  <para style="q2" vid="PSA 124:3">idaha iyadesịd ammọ akefioppo ikañ-ikañ ye ñnyịn;<verse eid="PSA 124:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4" />mmọọñukwọ akpaakiben ñnyịn,</para>
  <para style="q2" vid="PSA 124:4">ufeghe ndiọọñ mmọọñ akpaakiben ñnyịn asio,<verse eid="PSA 124:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5" />mfofuud mmọọñ</para>
  <para style="q2" vid="PSA 124:5">akpaakikwọọk ñnyịn asio ke iso isọñ.<verse eid="PSA 124:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6" />Yak itooro anie <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 124:6">idiikiyakka ammọ iwai ñnyịn ke eded ammọ.<verse eid="PSA 124:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7" />Ñnyịn imibọkkọ nte inuen</para>
  <para style="q2" vid="PSA 124:7">abọkkọ afia ataikọd;</para>
  <para style="q1" vid="PSA 124:7">ebʌñ afia,</para>
  <para style="q2" vid="PSA 124:7">ndin ñnyịn imibọkkọ.<verse eid="PSA 124:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8" />Unwam ñnyịn ato anyịñ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 124:8">Andinam anyọñ ye isọñ.<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="cl">Saam 125</para>
  <para style="d">Ikwọ adidọọk.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1" />Mbon se ibuọt idem ye <char style="nd">Abọọñ</char> eba nte Abod Saiyọn,</para>
  <para style="q2" vid="PSA 125:1">i-imiikemeke adisịkke ado ada ke nsi-nsi.<verse eid="PSA 125:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2" />Kpa naña mme abod ekanna Yeruselem,</para>
  <para style="q2" vid="PSA 125:2">ntoro ke <char style="nd">Abọọñ</char> akanna ikọd amọ akʌk</para>
  <para style="q2" vid="PSA 125:2">idahami ye ke nsi-nsi.<verse eid="PSA 125:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3" />Esañ awo ibak idiituakka ida</para>
  <para style="q2" vid="PSA 125:3">ke isọñ se ekedeeme enọ ndinen awo,</para>
  <para style="q1" vid="PSA 125:3">sia ke ntak ado ndinen awo ekeme ikama</para>
  <para style="q2" vid="PSA 125:3">ubọk ammọ enam idiọọkñkpọ.<verse eid="PSA 125:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4" />
    <char style="nd">Abọọñ</char>, nam eti ye mbon edooho nti,</para>
  <para style="q2" vid="PSA 125:4">ye mbon se inen ke esịd.<verse eid="PSA 125:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5" />Amaado mbon ewakkake edʌk ukwañ usʌñ</para>
  <para style="q2" vid="PSA 125:5">
    <char style="nd">Abọọñ</char> ayaabenne ammọ asioño ye mme anamidiọọk.</para>
  <para style="b" vid="PSA 125:5" />
  <para style="q1" vid="PSA 125:5">Yak emem aba ye Isrel.<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="cl">Saam 126</para>
  <para style="d">Ikwọ adidọọk</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1" />Idaha <char style="nd">Abọọñ</char> akemaanake anọ nditọ Saiyọn mfọniso,</para>
  <para style="q2" vid="PSA 126:1">ñnyịn ikiba nte mbon ake edappake ndab.<verse eid="PSA 126:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2" />Inua ñnyịn amaayọhọ ye imam,</para>
  <para style="q2" vid="PSA 126:2">edeme ñnyịn ye mme ikwọ idaara.</para>
  <para style="q1" vid="PSA 126:2">Ndin emaetañ ke atu mme idịd,</para>
  <para style="q2" vid="PSA 126:2">“<char style="nd">Abọọñ</char> anam ikpọ ñkpọ anọ ammọ”<verse eid="PSA 126:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3" />
    <char style="nd">Abọọñ</char> anam ikpọ ñkpọ inọ ñnyịn,</para>
  <para style="q2" vid="PSA 126:3">ndin esịd ñnyịn ayọhọ ye idaara.<verse eid="PSA 126:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4" />
    <char style="nd">Abọọñ</char>, maana inọ ñnyịn mfọniso,</para>
  <para style="q2" vid="PSA 126:4">nte idịm a-abaaha ke Nekef.<verse eid="PSA 126:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5" />Mbon eketọọhọ ñkpọ ke mmọọñayịd</para>
  <para style="q2" vid="PSA 126:5">eyaedọk ye mme ikwọ idaara.<verse eid="PSA 126:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6" />Mbon etuahatua ewuọñọ,</para>
  <para style="q2" vid="PSA 126:6">ekaama ñkpasi ekaa aditọ,</para>
  <para style="q1" vid="PSA 126:6">eyaenyọñ edi ye mme ikwọ idaara,</para>
  <para style="q2" vid="PSA 126:6">ekaama mme mfịd inwañ.<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="cl">Saam 127</para>
  <para style="d">Ikwọ adidọọk. Ake Sọlọmọn.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1" />Ibọhọke <char style="nd">Abọọñ</char> abọp ufọk,</para>
  <para style="q2" vid="PSA 127:1">mme abọbufọk enam utom ikpu-ikpu.</para>
  <para style="q1" vid="PSA 127:1">Ibọhọke <char style="nd">Abọọñ</char> akpeme abio,</para>
  <para style="q2" vid="PSA 127:1">mme andikpeme eda ukpeme utak-utak.<verse eid="PSA 127:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2" />Ke utak-utak ke afo abak ademme</para>
  <para style="q2" vid="PSA 127:2">anyʌñ akpeene idaiya,</para>
  <para style="q1" vid="PSA 127:2">ayeem ndidia se adia,</para>
  <para style="q2" vid="PSA 127:2">sia anye anọ mbon se anye ama idab.<verse eid="PSA 127:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3" />Nditọ edo udeeme <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 127:3">mfịd idịb ado ñkpọ ayịnutom.<verse eid="PSA 127:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4" />Naña nte idañ aba ke ubọk awo uko</para>
  <para style="q2" vid="PSA 127:4">ntoro ke nditọ e-emanna ke ini iwaad eba.<verse eid="PSA 127:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5" />Afọfọn anọ awo</para>
  <para style="q2" vid="PSA 127:5">ake ekpad idañ amọ ayọhọke ye nditọ.</para>
  <para style="q1" vid="PSA 127:5">Ammọ idiikịtte abuud</para>
  <para style="q2" vid="PSA 127:5">ke ini ammọ emiaha nduba ye mme asua ammọ ke esob.<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="cl">Saam 128</para>
  <para style="d">Ikwọ adidọọk</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1" />Afọfọn anọ afịd mbon e-ebaaha Abọọñ,</para>
  <para style="q2" vid="PSA 128:1">e-esañake ke ñkobitem enọ anye.<verse eid="PSA 128:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2" />Afo ayaadia mfịd utom mfo;</para>
  <para style="q2" vid="PSA 128:2">adidiọñ ye uforo adiido ake mfo.<verse eid="PSA 128:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3" />Anwaan mfo adiiba nte fain anwịmme mfịd</para>
  <para style="q2" vid="PSA 128:3">ke esịd ufọk mfo;</para>
  <para style="q1" vid="PSA 128:3">nditọ mfo ediiba nte mme emịne ọlif</para>
  <para style="q2" vid="PSA 128:3">ekanna akpokoro mfo ekʌk.<verse eid="PSA 128:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4" />Ii, anyem adiido adidiọñ</para>
  <para style="q2" vid="PSA 128:4">anọ awo a-abaaha <char style="nd">Abọọñ</char>.<verse eid="PSA 128:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5" />Yak <char style="nd">Abọọñ</char> atie ke Saiyọn udiọñ fiin;</para>
  <para style="q2" vid="PSA 128:5">yak afo akịt uforo Yeruselem</para>
  <para style="q2" vid="PSA 128:5">ke afịd ayio uwem mfo.<verse eid="PSA 128:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6" />Yak afo adu uwem akịt nditọnditọ mfo,</para>
  <para style="q2" vid="PSA 128:6">emem aba ye Isrel.<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="cl">Saam 129</para>
  <para style="d">Ikwọ adidọọk</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1" />“Ammọ enekke emfiik miin tọọñọ ke uyịn mmi,”</para>
  <para style="q2" vid="PSA 129:1">yak Isrel ebo;<verse eid="PSA 129:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2" />“ammọ enekke emfiik miin tọọñọ ke uyịn mmi,</para>
  <para style="q2" vid="PSA 129:2">ado ammọ inieghe edikan ke iwuod mmi.<verse eid="PSA 129:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3" />Ideen ufʌñisọñ efʌñ edem mmi</para>
  <para style="q2" vid="PSA 129:3">enyʌñ enam mme ube ammọ anyọọñ.<verse eid="PSA 129:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4" />Ado <char style="nd">Abọọñ</char> ado adinen;</para>
  <para style="q2" vid="PSA 129:4">anye a-ñkpọk miin ayaak ke mme udʌk mbon ibak.”<verse eid="PSA 129:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5" />Yak afịd mbon esuaha Saiyọn</para>
  <para style="q2" vid="PSA 129:5">etịmme edem ke abuud.<verse eid="PSA 129:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6" />Yak ammọ eba nte mbid ke anyọñ akọmufọk,</para>
  <para style="q2" vid="PSA 129:6">ake ayeemeke mbemiso anye akan akọt;<verse eid="PSA 129:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7" />awo idọk ikanna ikọ anye iyọhọ ubọk,</para>
  <para style="q2" vid="PSA 129:7">awo a-akoonoke ñko ikoonoke yak ayọhọ ubọk.<verse eid="PSA 129:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8" />Yak mbon e-esañake eboiyo ekuubo ammọ,</para>
  <para style="q2" vid="PSA 129:8">“Adidiọñ <char style="nd">Abọọñ</char> aba ye ndufo;</para>
  <para style="q2" vid="PSA 129:8">Ñnyịn idiọñ ndufo ke anyịñ <char style="nd">Abọọñ</char>.”<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="cl">Saam 130</para>
  <para style="d">Ikwọ adidọọk</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1" />
    <char style="nd">Abọọñ</char>, ami mmetua unọ fiin ke isọñ esịd mmi;<verse eid="PSA 130:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 130:2" />
    <char style="nd">Abọọñ</char> kop uyio mmi.</para>
  <para style="q1" vid="PSA 130:2">Kpañ utọñ nnọ miin</para>
  <para style="q2" vid="PSA 130:2">ke ini ami ntuaha ñyem mbọm.<verse eid="PSA 130:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3" />
    <char style="nd">Abọọñ</char>, adieke afo akpekenịmme ibad ndiọiñkpọ,</para>
  <para style="q2" vid="PSA 130:3">
    <char style="nd">Abọọñ</char> anie awo ikpikan ida?<verse eid="PSA 130:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4" />Ado ye afo ndakkannọ aba,</para>
  <para style="q2" vid="PSA 130:4">nọ ñnyịn ikan inam ñkpọ unọ fiin ye uteeñe.<verse eid="PSA 130:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5" />Nda mbet <char style="nd">Abọọñ</char>, afịd idem mmi abet,</para>
  <para style="q2" vid="PSA 130:5">ñko ke ikọ amọ ke ami nsịn idodanyen mmi.<verse eid="PSA 130:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6" />Ami nda mbet <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 130:6">akan naña mme akpeme abio eda ebet ubakusen,</para>
  <para style="q2" vid="PSA 130:6">akan naña mme akpeme abio eda ebet ubakusen.<verse eid="PSA 130:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7" />Isrel, sịn idodanyen ke <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 130:7">sia ke <char style="nd">Abọọñ</char> ke nsọọñọnda ima aba</para>
  <para style="q2" vid="PSA 130:7">ñko anye ke ñkpọkñyak aba.<verse eid="PSA 130:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8" />Anye ke idem amọ ayaafak Isrel</para>
  <para style="q2" vid="PSA 130:8">asio ke afịd ndiọiñkpọ ammọ.<verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="cl">Saam 131</para>
  <para style="d">Ikwọ adidọọk. Ake Defid.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1" />
    <char style="nd">Abọọñ</char>, esịd mmi ikokkoke,</para>
  <para style="q2" vid="PSA 131:1">ami nsakka anyen,</para>
  <para style="q1" vid="PSA 131:1">nsịnne idem mmi ke mme ikpọ ñkpọ</para>
  <para style="q2" vid="PSA 131:1">me ñkpọ se ido ataa ñkpọ ñkpaidem innọ miin.<verse eid="PSA 131:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2" />Ado ami mmesuuhọ idem ñnyʌñ mba ke ndobuyio,</para>
  <para style="q2" vid="PSA 131:2">ami mba nte ayịn e-eka amaakesio ke eba a-abaaha ye eka amọ;</para>
  <para style="q2" vid="PSA 131:2">nte ayịn e-eka amaakesio ke eba ami mmekop uyʌkkọ.<verse eid="PSA 131:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3" />Isrel, sịn idodanyen mfo ke <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 131:3">idahami ye ke nsi-nsi.<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="cl">Saam 132</para>
  <para style="d">Ikwọ adidọọk.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1" />
    <char style="nd">Abọọñ</char>, toiyo Defid</para>
  <para style="q2" vid="PSA 132:1">ye afịd ñwaidem amọ.<verse eid="PSA 132:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2" />Anye amaanwọñọ unwọñọ anọ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 132:2">anye amaanam akaaña anọ Akpọsọñ Abasi Yekọb:<verse eid="PSA 132:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3" />“Ami ndiidʌkkọ ufọk mmi</para>
  <para style="q2" vid="PSA 132:3">me adidọọk ñkpọnnaa mmi,<verse eid="PSA 132:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4" />Ami ndiiyakka idab amba miin ke anyen</para>
  <para style="q2" vid="PSA 132:4">ñkpọkanyen mmi idiinyʌññọ iyeet idab,<verse eid="PSA 132:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5" />tutu ami nnịm itie nnọ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 132:5">itie idʌñ nnọ Akpọsọñ Abasi Yekọb.”<verse eid="PSA 132:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6" />Ñnyịn imaikop ke Efrata,</para>
  <para style="q2" vid="PSA 132:6">ñnyịn imaikịt anye ke mme inwañ Yaa:<verse eid="PSA 132:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7" />“Iyak ñnyịn ika itie idʌñ amọ,</para>
  <para style="q2" vid="PSA 132:7">iyak ñnyịn ituak iwuod ke itie udodukod amọ ibo,<verse eid="PSA 132:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8" />‘Dakka da, <char style="nd">Abọọñ</char>, nyʌñ di itie nduọkadudu mfo,</para>
  <para style="q2" vid="PSA 132:8">afo ye akebe edioomo adudu mfo.<verse eid="PSA 132:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9" />Yak esịn mme aku mfo adinenido;</para>
  <para style="q2" vid="PSA 132:9">yak ikọd mfo se inam akpanikọ ekwọ ikwọ idaara.’ ”<verse eid="PSA 132:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10" />Ke ntak isʌñutom mfo Defid,</para>
  <para style="q2" vid="PSA 132:10">kuusịn anye a-afo akeyette adan anịm.<verse eid="PSA 132:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11" />
    <char style="nd">Abọọñ</char> amaanwọñọ unwọñọ anọ Defid,</para>
  <para style="q2" vid="PSA 132:11">nsọọñọnda unwọñọ akpanikọ ake anye imiiduakka ikpəho:</para>
  <para style="q1" vid="PSA 132:11">“Keed ke atu ubon mfo</para>
  <para style="q2" vid="PSA 132:11">ke ami ndiidot ke ebekpo mfo.<verse eid="PSA 132:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12" />Adieke nditọ ideen mfo ediinịm edioomo mmi</para>
  <para style="q2" vid="PSA 132:12">ye mme ewʌhọ ake ami ndiikpeep ammọ,</para>
  <para style="q1" vid="PSA 132:12">ndin nditọ ideen ammọ eyaetie</para>
  <para style="q2" vid="PSA 132:12">ke ebekpo mfo ke nsi-nsi nsi-nsi.”<verse eid="PSA 132:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13" />Sia <char style="nd">Abọọñ</char> amek Saiyọn,</para>
  <para style="q2" vid="PSA 132:13">anye ayem anye ado itie idʌñ amọ, abo,<verse eid="PSA 132:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14" />“Ami ado itie nduọkadudu mmi ke nsi-nsi nsi-nsi;</para>
  <para style="q2" vid="PSA 132:14">mi ke ami ndiitie ke ebekpo, sia ami mmenie udọñ mbaña anye.<verse eid="PSA 132:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15" />Ami ñyaadiọñ anye ye uwak ñkpọ;</para>
  <para style="q2" vid="PSA 132:15">ñyaanọ uweene amọ ndidia nọ ayʌkkọ.<verse eid="PSA 132:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16" />Ami ñyaasịn mme aku amọ afọñidem adinyaaña,</para>
  <para style="q2" vid="PSA 132:16">ndin mbon amọ se inam akpanikọ eyaekwọ ikwọ idaara ke nsi-nsi.<verse eid="PSA 132:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17" />“Ami ñyaanam nnʌk atịppe anọ Defid ke itie ami</para>
  <para style="q2" vid="PSA 132:17">ñnyʌñ ndomo utuenikañ nnịm nnọ awo mmi emaekeyet adan.<verse eid="PSA 132:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18" />Ami ñyaasịn mme asua amọ afọñidem ndọk,</para>
  <para style="q2" vid="PSA 132:18">ado ñyaayat anye anyanya ayammake ke iwuod.”<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="cl">Saam 133</para>
  <para style="d">Ikwọ adidọọk. Ake Defid.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1" />Afọn anyʌñ anem die</para>
  <para style="q2" vid="PSA 133:1">nditọ Abasi edidʌñ itie keed ke ima!<verse eid="PSA 133:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2" />Atie nte anemufịk adan e-eduọkkọ ke iwuod,</para>
  <para style="q2" vid="PSA 133:2">a-adiattake adiwuọ ñwaebek,</para>
  <para style="q1" vid="PSA 133:2">a-adiattake ke ñwaebek Erọn,</para>
  <para style="q2" vid="PSA 133:2">asọiyọ adiwuọ itọñ ewịra amọ.<verse eid="PSA 133:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3" />Anye aba nte ndedeb Hemọn</para>
  <para style="q2" vid="PSA 133:3">aduọ ke Abod Saiyọn.</para>
  <para style="q1" vid="PSA 133:3">Sia do ke <char style="nd">Abọọñ</char> aduọk adidiọñ amọ,</para>
  <para style="q2" vid="PSA 133:3">kpa uwem ke nsi-nsi.<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="cl">Saam 134</para>
  <para style="d">Ikwọ adidọọk.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1" />Itooro <char style="nd">Abọọñ</char> afịd ndufo nditọufọk <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 134:1">e-enamma utom akonayio ke ufọk <char style="nd">Abọọñ</char>.<verse eid="PSA 134:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2" />Idịppe ubọk ndufo ke adisana itie</para>
  <para style="q2" vid="PSA 134:2">inyʌñ itooro <char style="nd">Abọọñ</char>.<verse eid="PSA 134:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3" />Yak <char style="nd">Abọọñ</char> udiọñ fiin ato ke Saiyọn,</para>
  <para style="q2" vid="PSA 134:3">anye a-anamma anyọñ ye isọñ.<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="cl">Saam 135</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1" />Itooro <char style="nd">Abọọñ</char>.</para>
  <para style="b" vid="PSA 135:1" />
  <para style="q1" vid="PSA 135:1">Itooro anyịñ <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 135:1">itooro anye, ndufo nditọufọk <char style="nd">Abọọñ</char>,<verse eid="PSA 135:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2" />ndufo e-enamma utom ke ufọk <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 135:2">ke mme akwere ufọk Abasi ñnyịn.<verse eid="PSA 135:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3" />Itooro <char style="nd">Abọọñ</char> sia <char style="nd">Abọọñ</char> afọn;</para>
  <para style="q2" vid="PSA 135:3">ikwọ itooro inọ anyịñ amọ, sia ado anem.<verse eid="PSA 135:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4" />Sia <char style="nd">Abọọñ</char> amek Yekọb yak ado ake amọ,</para>
  <para style="q2" vid="PSA 135:4">Isrel yak ado ñkpọuto a-anye anieghe.<verse eid="PSA 135:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5" />Ami mmediọọñọ ke <char style="nd">Abọọñ</char> a-akpon,</para>
  <para style="q2" vid="PSA 135:5">ke <char style="nd">Abọọñ</char> ñnyịn a-akpon akan afịd mme abasi.<verse eid="PSA 135:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6" />
    <char style="nd">Abọọñ</char> asinam se inem anye esịd,</para>
  <para style="q2" vid="PSA 135:6">ke anyọñ ye ke isọñ,</para>
  <para style="q2" vid="PSA 135:6">ke mme akpainyañ ye afịd mme udem ammọ.<verse eid="PSA 135:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7" />Anye anam ntọñanyọñ asakka ato utịd ederimbod;</para>
  <para style="q2" vid="PSA 135:7">anye adọñ akebkeb ye edịm</para>
  <para style="q2" vid="PSA 135:7">anyʌñ asịññe afịm ke mme itie ubonoñkpọ amọ.<verse eid="PSA 135:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8" />Anye akewoot mme akpan ke Iyib,</para>
  <para style="q2" vid="PSA 135:8">akpan ke mme awo ye ke mme unam.<verse eid="PSA 135:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9" />Anye amaadọñ mme idiọọñọ ye mme utịppeñkpọ amọ asịn ke atu ndufo, Iyib,</para>
  <para style="q2" vid="PSA 135:9">ebịne Fero ye afịd nditọufọk amọ.<verse eid="PSA 135:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10" />Anye amaasuan uwak idịd</para>
  <para style="q2" vid="PSA 135:10">anyʌñ awoot ñkpọsọñ ndidem:<verse eid="PSA 135:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11" />Sihọn adidem mbon Amọọ,</para>
  <para style="q2" vid="PSA 135:11">Ọk adidem mbon Basan,</para>
  <para style="q2" vid="PSA 135:11">ye afịd ndidem ke Kenan,<verse eid="PSA 135:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12" />ñko anye amaanọ isọñ ammọ nte udeeme,</para>
  <para style="q2" vid="PSA 135:12">udeeme anọ ikọd amọ Isrel.<verse eid="PSA 135:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13" />
    <char style="nd">Abọọñ</char>, anyịñ mfo ado ke nsi-nsi,</para>
  <para style="q2" vid="PSA 135:13">
    <char style="nd">Abọọñ</char>, etob mfo aba ke afịd emana.<verse eid="PSA 135:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14" />Sia <char style="nd">Abọọñ</char> ayaatoppo mbon amọ ikpe</para>
  <para style="q2" vid="PSA 135:14">anyʌñ anie mbọm abaña nditọufọk amọ.<verse eid="PSA 135:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15" />Mme ubobodñkpọ mme idịd edo silfa ye kold,</para>
  <para style="q2" vid="PSA 135:15">ake ubọk awo anamma.<verse eid="PSA 135:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16" />Ammọ enie inua, ado itañña ikọ,</para>
  <para style="q2" vid="PSA 135:16">enie anyen, ado ikịtte ñkpọ.<verse eid="PSA 135:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17" />Ammọ enie utọñ ado ikoppo ñkpọ,</para>
  <para style="q2" vid="PSA 135:17">ñko inweek ibaaha ke inua ammọ.<verse eid="PSA 135:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18" />Mbon e-enamma ammọ eyaeba nte ammọ,</para>
  <para style="q2" vid="PSA 135:18">kpa ntoro ye afịd mbon se ibuọt idem ke ammọ.<verse eid="PSA 135:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19" />Afịd ndufo mbon Isrel, itooro <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 135:19">ufọk Erọn, itooro <char style="nd">Abọọñ</char>;<verse eid="PSA 135:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20" />ufọk Lifai, itooro <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 135:20">ndufo se ibaak anye, itooro <char style="nd">Abọọñ</char>.<verse eid="PSA 135:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21" />Itooro ato ke Saiyọn anie <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 135:21">anie anye a-abaaha ke Yeruselem.</para>
  <para style="b" vid="PSA 135:21" />
  <para style="q1" vid="PSA 135:21">Itooro <char style="nd">Abọọñ</char>.<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="cl">Saam 136</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1" />Inọ <char style="nd">Abọọñ</char> ekọọm, sia anye afọn.</para>
  <para style="qr" vid="PSA 136:1">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2" />Inọ Abasi mme abasi ekọọm.</para>
  <para style="qr" vid="PSA 136:2">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3" />Inọ Abọọñ mme mbọọñ ekọọm:</para>
  <para style="qr" vid="PSA 136:3">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4" />Anye a-adooho anye ikpọọñ ado andinam ikpọ utịppeñkpọ,</para>
  <para style="qr" vid="PSA 136:4">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5" />Anye a-akenamma anyọñ ke ikike amọ,</para>
  <para style="qr" vid="PSA 136:5">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6" />Anye a-akedetteke ikpaisọñ adot ke mme mmọọñ,</para>
  <para style="qr" vid="PSA 136:6">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7" />Anye a-akenamma mme ikpọ ikañ,</para>
  <para style="qr" vid="PSA 136:7">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8" />Utịn adikara uweemeayio</para>
  <para style="qr" vid="PSA 136:8">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9" />Afiọñ ye ntantaafiọñ adikara akonayio;</para>
  <para style="qr" vid="PSA 136:9">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10" />Anye ake akewotto mme akpan mbon Iyib</para>
  <para style="qr" vid="PSA 136:10">Ima amọ aba ke nsi-nsi<verse eid="PSA 136:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11" />anyʌñ asio Isrel akpọñ ammọ</para>
  <para style="qr" vid="PSA 136:11">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12" />Ke akpọsọñ ubọk ye nsioñnyan ubọk;</para>
  <para style="qr" vid="PSA 136:12">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13" />Anye a-akebakkake Ndad-Ndad Akpainyañ</para>
  <para style="qr" vid="PSA 136:13">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14" />Anyʌñ anam Isrel asaña ke ufọọd amọ aboiyo</para>
  <para style="qr" vid="PSA 136:14">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15" />Ado akwọọk Fero ye udịm ekọñ amọ asịn ke Ndad-Ndad Inyañ;</para>
  <para style="qr" vid="PSA 136:15">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16" />Anye a-akebenne mbon amọ asaña aboiyo ke anaan</para>
  <para style="qr" vid="PSA 136:16">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17" />Anye a-akewotto mme ikpọ ndidem,</para>
  <para style="qr" vid="PSA 136:17">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18" />Anyʌñ awot ñkpọsọñ ndidem,</para>
  <para style="qr" vid="PSA 136:18">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19" />Sihọn adidem mbon Amọọ</para>
  <para style="qr" vid="PSA 136:19">Ima amọ aba ke nsi-nsi<verse eid="PSA 136:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20" />ye Ọk adidem mbon Basan</para>
  <para style="qr" vid="PSA 136:20">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21" />Anyʌñ anọ isọñ ammọ nte udeeme,</para>
  <para style="qr" vid="PSA 136:21">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22" />Udeeme anọ ayịnufọk amọ Isrel.</para>
  <para style="qr" vid="PSA 136:22">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23" />Anye amaitoiyo ñnyịn ke usʌhọde itie ñnyịn</para>
  <para style="qr" vid="PSA 136:23">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24" />Anyʌñ ifak ñnyịn asio ke ubọk mme asua ñnyịn.</para>
  <para style="qr" vid="PSA 136:24">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25" />Anye anọ afịd se ebobot ndidia.</para>
  <para style="qr" vid="PSA 136:25">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26" />Inọ Abasi hefịn ekọọm.</para>
  <para style="qr" vid="PSA 136:26">Ima amọ aba ke nsi-nsi.<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="cl">Saam 137</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1" />Ke mben inyañ Babilọn ke ñnyịn ikitie ikinyʌñ itua</para>
  <para style="q2" vid="PSA 137:1">ke ini ñnyịn ikitoiyoke Saiyọn.<verse eid="PSA 137:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2" />Do ke mme ikpọ eto</para>
  <para style="q2" vid="PSA 137:2">ñnyịn imaikọọñ mme ekpa ñnyịn,<verse eid="PSA 137:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3" />sia do ke mbon e-ekiimʌmmọ ñnyịn ekeyem ikwọ ito ñnyịn,</para>
  <para style="q2" vid="PSA 137:3">mbon e-ekiitʌkkọke ñnyịn ekeyem ikwọ idaara;</para>
  <para style="q2" vid="PSA 137:3">ammọ emaebo, “Ikwọ ikwọ Saiyọn keed inọ ñnyịn!”<verse eid="PSA 137:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4" />Ñnyịn idiinam die ikwọ ikwọ <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PSA 137:4">idaha ibaaha ke asen idịd?<verse eid="PSA 137:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5" />Ami ñkpufre fiin, Yeruselem,</para>
  <para style="q2" vid="PSA 137:5">yak ubọk nnasia mmi afre se anye adiọọñọ.<verse eid="PSA 137:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6" />Yak edeme mmi adiana ke anyọñ inua mmi</para>
  <para style="q2" vid="PSA 137:6">adieke ami mmuutoiyoke fiin,</para>
  <para style="q1" vid="PSA 137:6">adieke ami mmiibenneke Yeruselem</para>
  <para style="q2" vid="PSA 137:6">nte ñkoññkan idaara mmi.<verse eid="PSA 137:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7" />
    <char style="nd">Abọọñ</char>, toiyo se mbon Edọm ekenam</para>
  <para style="q2" vid="PSA 137:7">ke usen Yeruselem akeduọhọ.</para>
  <para style="q1" vid="PSA 137:7">Ammọ ekebo, “wuut anye duọọk”,</para>
  <para style="q2" vid="PSA 137:7">“wuut anye duọọk ke wuọ itiad idakisọñ amọ!”<verse eid="PSA 137:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8" />Adiaha Babilọn, e-enịmme enọ nsobo,</para>
  <para style="q2" vid="PSA 137:8">afọfọn anọ awo u-unọọhọ fiin utịb</para>
  <para style="q2" vid="PSA 137:8">akeene se afo anam ye ñnyịn.<verse eid="PSA 137:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9" />Awo ake amʌmmọ nditọ mfo</para>
  <para style="q2" vid="PSA 137:9">anyʌñ atọọñ ammọ ke mme ikpọ itiad ayaakop inemesịd.<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="cl">Saam 138</para>
  <para style="d">Ake Defid.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1" />
    <char style="nd">Abọọñ</char>, ami ñyautooro fiin ke afịd esịd mmi;</para>
  <para style="q2" vid="PSA 138:1">ke iso “mme abasi” ami ñyaakwọ itooro mfo.<verse eid="PSA 138:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2" />Ami ñyaatuak iwuod ke adisana itieukpono mfo</para>
  <para style="q2" vid="PSA 138:2">ñyaanyʌñ ntooro anyịñ mfo</para>
  <para style="q2" vid="PSA 138:2">ke ntak ima ye akpanikọ mfo i-imiidiikweeñeke,</para>
  <para style="q1" vid="PSA 138:2">sia afo amaabenne mme adisana ewʌhọ mfo</para>
  <para style="q2" vid="PSA 138:2">nọ akpon akan etob mfo.<verse eid="PSA 138:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3" />Ke ini ami ñkekoodo, afo amambọọrọ miin;</para>
  <para style="q2" vid="PSA 138:3">afo amaanam yak uko mmi akpon.<verse eid="PSA 138:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4" />
    <char style="nd">Abọọñ</char>, yak afịd ndidem ke ederimbod utooro fiin,</para>
  <para style="q2" vid="PSA 138:4">ke ini ammọ ekoppo ewʌhọ mfo.<verse eid="PSA 138:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5" />Yak ammọ ekwọ ebaña mme usʌñ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 138:5">sia ubọọñ <char style="nd">Abọọñ</char> akpon.<verse eid="PSA 138:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6" />Akpesʌkado <char style="nd">Abọọñ</char> akoñño, anye ase mbon nsuukidem ke anyen mbọm;</para>
  <para style="q2" vid="PSA 138:6">akpesʌkado anye akokkoke, anye akịt ammọ ke anyan usʌñ.<verse eid="PSA 138:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7" />Akpesʌkado ami nsañake ke ufọọd mfịna,</para>
  <para style="q2" vid="PSA 138:7">afo amaadịp uwem mmi.</para>
  <para style="q1" vid="PSA 138:7">Afo amaanyan ubọk abiọọñọ iyadesịd mme asua mmi;</para>
  <para style="q2" vid="PSA 138:7">afo akama ubọk nnasia mfo añnyaaña miin.<verse eid="PSA 138:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8" />
    <char style="nd">Abọọñ</char> ayantoppo miin ikpe;</para>
  <para style="q2" vid="PSA 138:8">
    <char style="nd">Abọọñ</char>, ima mfo aba ke nsi-nsi,</para>
  <para style="q2" vid="PSA 138:8">kuusịññe idem ukpọñ mme utom ake ubọk mfo anamma.<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="cl">Saam 139</para>
  <para style="d">Ake adaiwuod ke ikwọ. Saam ake Defid.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1" />
    <char style="nd">Abọọñ</char>, afo amenduuñọ miin,</para>
  <para style="q2" vid="PSA 139:1">anyʌñ andiọọñọ miin.<verse eid="PSA 139:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2" />Afo amediọọñọ idaha a-ami ntieghe ye idahami a-ami ndaaha;</para>
  <para style="q2" vid="PSA 139:2">afo ameda ke anyan itie adiọọñọ akikere mmi.<verse eid="PSA 139:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3" />Afo amediọọñọ idaha a-ami ñwuọhọwuọ ye idaha a-ami nnaahana;</para>
  <para style="q2" vid="PSA 139:3">afo amediọọñọ afịd usʌñ mmi.<verse eid="PSA 139:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4" />Mbemiso ami nsosio ikọ ntañ,</para>
  <para style="q2" vid="PSA 139:4">afo, <char style="nd">Abọọñ</char>, amedọdiọọñọ afịd-afịd.<verse eid="PSA 139:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5" />Afo ameñkanna miin akʌk ke iso ye ke edem,</para>
  <para style="q2" vid="PSA 139:5">afo anyʌñ andot miin ubọk ke iwuod.<verse eid="PSA 139:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6" />Utọ ifiọk ado ado ataa utịppeñkpọ annọ miin,</para>
  <para style="q2" vid="PSA 139:6">anekke akoñ akan se ami nsịme.<verse eid="PSA 139:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7" />Uke ke ami ñkpekaa ñkpọñ Sịbidịd mfo?</para>
  <para style="q2" vid="PSA 139:7">Ñkpefeghe ñka uke ñkpọñ iso mfo?<verse eid="PSA 139:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8" />Ami ñkpedọọk ñka anyọñ, afo mmọdo aba;</para>
  <para style="q2" vid="PSA 139:8">ami ñkpenịm itie nnaa mmi ke udem, afo mmọdo aba.<verse eid="PSA 139:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9" />Ami ñkpedakkanda ke mba usiere,</para>
  <para style="q2" vid="PSA 139:9">ami ñkpeba ke anyan mben akpainyañ,<verse eid="PSA 139:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10" />kpa do ubọk mfo ayandat miin usʌñ,</para>
  <para style="q2" vid="PSA 139:10">ubọk nnasia mfo ayaasọñ ammʌm miin.<verse eid="PSA 139:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11" />Ami ñkpebo, “Ke akpanikọ ekịm ayandịp miin</para>
  <para style="q2" vid="PSA 139:11">ndin unwana akappa ado akonayio añkanna miin akʌk,”<verse eid="PSA 139:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12" />ukpọk ekịm idiikịmme unọ fiin;</para>
  <para style="q2" vid="PSA 139:12">akonayio ayaayamma nte uweemeayio,</para>
  <para style="q2" vid="PSA 139:12">sia ekịm aba nte unwana unọ fiin.<verse eid="PSA 139:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13" />Sia afo akebot ataa esịd idem mmi;</para>
  <para style="q2" vid="PSA 139:13">afo akemfʌk miin ke idịb eka mmi.<verse eid="PSA 139:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14" />Ami utooro fiin sia afo akembot miin ke ndịk-ndịk ye utịppe-utịppe usʌñ;</para>
  <para style="q2" vid="PSA 139:14">mme utom mfo edo utịppe,</para>
  <para style="q2" vid="PSA 139:14">ami mmenekke ndiọọñọ ntoro.<verse eid="PSA 139:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15" />Ikpọkidem mmi ikidịbeke ke iso mfo</para>
  <para style="q2" vid="PSA 139:15">ke ini ekembotto miin ke ndedịbe itie,</para>
  <para style="q2" vid="PSA 139:15">ke ini ekendianna miin keed ke esịd isọñ.<verse eid="PSA 139:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16" />Anyen mfo amaakịt idaha awo imiikibotto ikpọkidem mmi;</para>
  <para style="q2" vid="PSA 139:16">emaewet afịd usen se ekenịm ennọọ miin ke ñwed mfo</para>
  <para style="q2" vid="PSA 139:16">mbemiso keed ke atu ammọ adiwuọ ada.<verse eid="PSA 139:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17" />Abasi, akikere mfo ado nsọñudua annọ miin!</para>
  <para style="q2" vid="PSA 139:17">Aditọ ammọ ndian akpon die!<verse eid="PSA 139:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18" />Akpedo ami ñkeyem adibat ammọ,</para>
  <para style="q2" vid="PSA 139:18">ammọ ekpaewak ekan ntan isọn,</para>
  <para style="q2" vid="PSA 139:18">idaha andemmeke, ami nsʌk mba ye afo.<verse eid="PSA 139:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19" />Abasi, akpekapado afo, ayaawot mbon ibak!</para>
  <para style="q2" vid="PSA 139:19">Idakka iñkpọñ miin, ndufo mbon e-eyemme inwọñ iyiib!<verse eid="PSA 139:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20" />Ammọ etañ ikọ ubaña fiin ye ibak ke esịd;</para>
  <para style="q2" vid="PSA 139:20">mme asua mfo ekama anyịñ mfo ke idiọọk usʌñ.<verse eid="PSA 139:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21" />
    <char style="nd">Abọọñ</char>, ado nte ami nsuaha mbon se usua fiin,</para>
  <para style="q2" vid="PSA 139:21">ñnyʌñ ntọhọ ye mbon ake esọññọ iwuod ye afo?<verse eid="PSA 139:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22" />Ami nnieghe ñkpọ mfen ñkan usua nnọ ammọ;</para>
  <para style="q2" vid="PSA 139:22">ami mbat ammọ nte mme asua mmi.<verse eid="PSA 139:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23" />Abasi, nduuñọ miin, nyʌñ diọọñọ esịd mmi;</para>
  <para style="q2" vid="PSA 139:23">ndomo miin nyʌñ diọọñọ ayeemensia akikere mmi.<verse eid="PSA 139:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24" />Se me aba usʌñ ndomokeed se ami ndue,</para>
  <para style="q2" vid="PSA 139:24">nyʌñ ndat miin saña ke usʌñ nsi-nsi.<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="cl">Saam 140<note caller="+" style="f"><char style="fr" closed="false">140:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 140:1-13 ewet Saam 140:2-14</char></note></para>
  <para style="d">Ake adaiwuod ke ikwọ. Saam ake Defid.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1" />
    <char style="nd">Abọọñ</char>, ñnyaaña miin sio ke ubọk mme anam idiọọkñkpọ;</para>
  <para style="q2" vid="PSA 140:1">ñkpeme miin ke ubọk mbon afai,<verse eid="PSA 140:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2" />e-ekereke ndoom ke esịd ammọ</para>
  <para style="q2" vid="PSA 140:2">e-enyʌññọ esiin ekọñ afịd ini.<verse eid="PSA 140:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3" />Ammọ enam edeme ammọ asọbọ nte ake udʌkikọd;</para>
  <para style="q2" vid="PSA 140:3">ifod ibọm aba ke mme ñkpọkinua ammọ.<verse eid="PSA 140:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4" />
    <char style="nd">Abọọñ</char>, nnịm miin ke ifuuro mbaak ubọk mbon ibak;</para>
  <para style="q2" vid="PSA 140:4">ñkpeme miin mbaak mbon afai,</para>
  <para style="q2" vid="PSA 140:4">ake eyemme adinuuk ukod mmi nọ ayekke.<verse eid="PSA 140:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5" />Mbon afai edịp afia ennọ miin;</para>
  <para style="q2" vid="PSA 140:5">ammọ edette udʌk iyịre enịm ennọ</para>
  <para style="q2" vid="PSA 140:5">enyʌñ ekọọk mme afia enịm ke usʌñ ake ami nsañake.<verse eid="PSA 140:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6" />Ami mmebo, <char style="nd">Abọọñ</char>, “Afo ado Abasi mmi”</para>
  <para style="q2" vid="PSA 140:6">
    <char style="nd">Abọọñ</char>, kop akam ake ami ntuaha ñyem mbọm.<verse eid="PSA 140:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7" />
    <char style="nd">Abọọñ</char> Andikara, akpọsọñ ufak mmi,</para>
  <para style="q2" vid="PSA 140:7">afo amfʌk miin iwuod ke usen anwan.<verse eid="PSA 140:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8" />
    <char style="nd">Abọọñ</char>, kuuyak mbon ibak enam uduak ammọ;</para>
  <para style="q2" vid="PSA 140:8">kuuyak akikere ammọ awuọ ada.<verse eid="PSA 140:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9" />Mbon eñkannake miin ekʌk edịppe iwuod ke asian;</para>
  <para style="q2" vid="PSA 140:9">yak ibak ñkpọkinua ammọ akanna afʌk ammọ.<verse eid="PSA 140:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10" />Yak ñkañ asakka ikañ aduọ atọ ammọ;</para>
  <para style="q2" vid="PSA 140:10">yak etop ammọ esịn ke ikañ</para>
  <para style="q2" vid="PSA 140:10">esịn ke udem, ake ammọ imiididakkake ida aba.<verse eid="PSA 140:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11" />Yak mbon inuaikọ ekuunie iwuuk ke isọñ;</para>
  <para style="q2" vid="PSA 140:11">yak mfịna ayem mbon afai.<verse eid="PSA 140:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12" />Ami mmediọọñọ ke <char style="nd">Abọọñ</char> akpe unen anọ mbon uweene</para>
  <para style="q2" vid="PSA 140:12">anyʌñ anam se inen ye mbon unana.<verse eid="PSA 140:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13" />Ke akpanikọ ndinen awo eyaetooro anyịñ mfo,</para>
  <para style="q2" vid="PSA 140:13">ñko nti awo eyaedʌñ ke iso mfo.<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="cl">Saam 141</para>
  <para style="d">Saam ake Defid.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1" />
    <char style="nd">Abọọñ</char>, ami ukoot fiin, sọp di mbịne miin;</para>
  <para style="q2" vid="PSA 141:1">kop ikood ake ami ukoodo fiin.<verse eid="PSA 141:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2" />Yak akam mmi aba ke iso mfo nte insensi;</para>
  <para style="q2" vid="PSA 141:2">yak ubọk ake ami mbenneke mi aba nte uwa ndubiayio.<verse eid="PSA 141:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3" />
    <char style="nd">Abọọñ</char>, nịm ukpeme nọ inua mmi;</para>
  <para style="q2" vid="PSA 141:3">nịm ukpeme ke usʌñ ñkpọkinua mmi.<verse eid="PSA 141:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4" />Kuuyak esịd mmi asịkke akpere idiọọkñkpọ</para>
  <para style="q2" vid="PSA 141:4">mbaak ami ndikeene nnam ibak</para>
  <para style="q1" vid="PSA 141:4">ye mbon e-edooho mbon ibak;</para>
  <para style="q2" vid="PSA 141:4">kuuyak ami ndia ndiin ammọ.<verse eid="PSA 141:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5" />Yak adinen awo ammia miin, anye ado awọt ima;</para>
  <para style="q2" vid="PSA 141:5">yak anye asua annọ miin, anye ado ado adan ke iwuod mmi.</para>
  <para style="q1" vid="PSA 141:5">Iwuod mmi idiisịnne anye,</para>
  <para style="q2" vid="PSA 141:5">sia akam mmi adiisʌk ido ubiọọñọ anọ utom ndiọi awo.<verse eid="PSA 141:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6" />Eyaeda ke mme mben etịñe itiad etop mme adaukara ammọ eduọọk,</para>
  <para style="q2" vid="PSA 141:6">ndin mbon ibak eyaediọọñọ ke mmaatañ ikọ mmi yak afọn.<verse eid="PSA 141:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7" />Ammọ eyaebo, “nte awo akịmme anyʌññọ asiak isọñ,</para>
  <para style="q2" vid="PSA 141:7">kpa ntoro ke esuan akpọ ñnyịn ke inua udi.”<verse eid="PSA 141:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8" />Ado anyen mmi awʌhọ ke afo, <char style="nd">Abọọñ</char> Andikara;</para>
  <para style="q2" vid="PSA 141:8">ke afo ke ami ndịbe, kuñyaak miin unọọ ñkpa.<verse eid="PSA 141:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9" />Ñkpeme miin sio ke mme afia a-mme anamidiọọk ekọọhọ,</para>
  <para style="q2" vid="PSA 141:9">sio ke mme afia ammọ enịmme ennọọ miin.<verse eid="PSA 141:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10" />Yak mbon ibak eduọ edʌk iyịre ammọ,</para>
  <para style="q2" vid="PSA 141:10">ke ini ami nsañake ifuuro-ifuuro mboiyo.<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="cl">Saam 142<note caller="+" style="f"><char style="fr" closed="false">142:0 </char><char style="ft" closed="false">Ke ikpañwed Hibru Saam 142:1-7 ewet Saam 142:2-8</char></note></para>
  <para style="d">Saam <char style="tl">maskil</char> ake Defid. Idaha anye akebaaha ke abaitiad. Akam.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1" />Ami ntua nseeme nnọ <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 142:1">ami ndịppe uyio mmi nnọ <char style="nd">Abọọñ</char> ñyem mbọm.<verse eid="PSA 142:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2" />Ami ñnwañña aseeme mmi nnọ anye;</para>
  <para style="q2" vid="PSA 142:2">ke iso amọ ke ami ntañ mfịna mmi.<verse eid="PSA 142:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3" />Ke ini sịbidịd amemme ke idem mmi,</para>
  <para style="q2" vid="PSA 142:3">ado afo akpeme usʌñ mmi.</para>
  <para style="q1" vid="PSA 142:3">Ke afañ ake ami nsañake</para>
  <para style="q2" vid="PSA 142:3">mme awo edịp afia ennọ miin.<verse eid="PSA 142:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4" />Se nyʌñ kịt, ke awo ndomokeed ibaaha ke ubọk nnasia mmi;</para>
  <para style="q2" vid="PSA 142:4">ibaaha awo se ikere ñkpọ imbaña miin.</para>
  <para style="q1" vid="PSA 142:4">Ami nnieghe itie udịbe;</para>
  <para style="q2" vid="PSA 142:4">ibaaha awo ndomokeed se ise ñkpọ ibaña uwem mmi.<verse eid="PSA 142:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5" />
    <char style="nd">Abọọñ</char>, ami nseeme unọ fiin;</para>
  <para style="q2" vid="PSA 142:5">Ami mbo ke “afo ado itie udịbe mmi,</para>
  <para style="q2" vid="PSA 142:5">udeeme mmi ke isọñ mme aduuwem.”<verse eid="PSA 142:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6" />Kop ntuaayịd mmi,</para>
  <para style="q2" vid="PSA 142:6">sia ami mmenekke ñyem unwam;</para>
  <para style="q1" vid="PSA 142:6">ñnyaaña miin sio ke ubọk mbon se imbịne miin,</para>
  <para style="q2" vid="PSA 142:6">sia ammọ esọñ adudu eti-eti eñkan miin.<verse eid="PSA 142:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7" />Ñnyaaña miin sio ke ñkpakọb mmi,</para>
  <para style="q2" vid="PSA 142:7">nọ ami ntooro anyịñ mfo.</para>
  <para style="q1" vid="PSA 142:7">Ndin mme ndinen awo eyaeboho ke ntak mmi</para>
  <para style="q2" vid="PSA 142:7">sia afo amefọn ye ami.<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="cl">Saam 143</para>
  <para style="d">Saam ake Defid.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1" />
    <char style="nd">Abọọñ</char>, kop akam mmi,</para>
  <para style="q2" vid="PSA 143:1">kpañ utọñ nọ aseeme ake ami ñyemme mbọm;</para>
  <para style="q1" vid="PSA 143:1">ke akpanikọ ye adinenido mfo</para>
  <para style="q2" vid="PSA 143:1">di ñnyaaña miin.<verse eid="PSA 143:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2" />Kuukoot ayịnufọk mfo ikpe,</para>
  <para style="q2" vid="PSA 143:2">sia ibaaha aduuwem awo se inen ke iso mfo.<verse eid="PSA 143:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3" />Asua ambịne miin,</para>
  <para style="q2" vid="PSA 143:3">anye ansọnnọ miin anịm ke isọñ;</para>
  <para style="q1" vid="PSA 143:3">anye anam ami ndʌñ ke ekịm</para>
  <para style="q2" vid="PSA 143:3">nte mbon ake emaekekpañña ke anyan ini.<verse eid="PSA 143:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4" />Ke ntoro sịbidịd mmi amem ke idem mmi;</para>
  <para style="q2" vid="PSA 143:4">esịd mmi akop mmemidem.<verse eid="PSA 143:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5" />Ami mmetoiyo mme usen edem;</para>
  <para style="q2" vid="PSA 143:5">ami mmekere mbaña afịd mme utom mfo</para>
  <para style="q2" vid="PSA 143:5">ñnyʌñ ñkere mbaña se ubọk mfo anam.<verse eid="PSA 143:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6" />Ami mmedette ubọk mmi unọ fiin;</para>
  <para style="q2" vid="PSA 143:6">Ami mmenie udọñ unọ fiin nte nsaad isọñ.<verse eid="PSA 143:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7" />
    <char style="nd">Abọọñ</char>, sọp mbọọrọ miin;</para>
  <para style="q2" vid="PSA 143:7">sịbidịd mmi akpa mba.</para>
  <para style="q1" vid="PSA 143:7">Kundịp miin iso mfo</para>
  <para style="q2" vid="PSA 143:7">imiidooho ami ndiiba nte mbon e-esọiyọke edʌk ube.<verse eid="PSA 143:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8" />Yak ubakusen aben etob nsọọñọnda ima mfo ansọk,</para>
  <para style="q2" vid="PSA 143:8">sia ami nsịn mbuọdidem mmi ke afo.</para>
  <para style="q1" vid="PSA 143:8">Ñwọt miin usʌñ a-akpenaaha ami ñka,</para>
  <para style="q2" vid="PSA 143:8">sia ami ñyaak uwem mmi usịn fiin ke ubọk.<verse eid="PSA 143:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9" />
    <char style="nd">Abọọñ</char>, ñnyaaña miin sio ke ubọk mme asua,</para>
  <para style="q2" vid="PSA 143:9">sia ami ndịp idem mmi ke afo.<verse eid="PSA 143:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10" />Ñkpeep miin adinam uduak mfo,</para>
  <para style="q2" vid="PSA 143:10">sia afo ado Abasi mmi;</para>
  <para style="q1" vid="PSA 143:10">yak eti sịbidịd mfo</para>
  <para style="q2" vid="PSA 143:10">andat miin aka unaisọñ.<verse eid="PSA 143:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11" />
    <char style="nd">Abọọñ</char>, ke ntak anyịñ mfo, nịm uwem mmi;</para>
  <para style="q2" vid="PSA 143:11">ke adinenido mfo, nsio miin ke afanekọñ.<verse eid="PSA 143:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12" />Ke nsọọñọnda ima mfo, kʌp mme asua mmi inua;</para>
  <para style="q2" vid="PSA 143:12">sobo afịd mbon eñyịreke miin,</para>
  <para style="q2" vid="PSA 143:12">sia ami ndo ayịnufọk mfo.<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="cl">Saam 144</para>
  <para style="d">Ake Defid.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1" />Itooro anie <char style="nd">Abọọñ</char> Itiad mmi,</para>
  <para style="q2" vid="PSA 144:1">anye a-akpeebe ubọk mmi anịm anọ ekọñ,</para>
  <para style="q2" vid="PSA 144:1">nnuunubọk mmi anọ anwan.<verse eid="PSA 144:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2" />Anye ado Abasi ima mmi ye itie ubọkkọ mmi,</para>
  <para style="q2" vid="PSA 144:2">akpọsọñ itie mmi ye adinyaaña mmi,</para>
  <para style="q1" vid="PSA 144:2">atuekọñ mmi, ake ami ndịbeke,</para>
  <para style="q2" vid="PSA 144:2">a-anamma mme awo esuuk iwuod ennọ miin.<verse eid="PSA 144:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3" />
    <char style="nd">Abọọñ</char>, nsoo ke ubon awo edo nọ afo ase ñkpọ abaña ammọ,</para>
  <para style="q2" vid="PSA 144:3">ñkaña abʌkidem ke afo akere ñkpọ abaña ammọ?<verse eid="PSA 144:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4" />Ammọ eba nte inweek;</para>
  <para style="q2" vid="PSA 144:4">mme usen ammọ eba nte ndukpọñ ake imiikpeeneke.<verse eid="PSA 144:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5" />
    <char style="nd">Abọọñ</char>, nyuuk mme hefịn mfo, nyʌñ sọiyọ di;</para>
  <para style="q2" vid="PSA 144:5">tuuk mme ikpọabod, nọ ammọ esioño nsʌñikañ.<verse eid="PSA 144:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6" />Dọñ akebkeb yak asuan mme asua;</para>
  <para style="q2" vid="PSA 144:6">tịgha idañ mfo yak ammọ eduba.<verse eid="PSA 144:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7" />Tie ke anyọñ nyan ubọk mfo;</para>
  <para style="q2" vid="PSA 144:7">mfak miin nyʌñ ñnyaaña miin</para>
  <para style="q1" vid="PSA 144:7">sio ke mme akpọsọñ mmọọñ,</para>
  <para style="q2" vid="PSA 144:7">ye ke ubọk isenawo<verse eid="PSA 144:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8" />ake inua ammọ eyọhọke ye nsu,</para>
  <para style="q2" vid="PSA 144:8">ake mme ubọk nnasia ammọ edooho abiaña.<verse eid="PSA 144:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9" />Abasi mmi, ami ñyaakwọ ufa ikwọ unọ fiin;</para>
  <para style="q2" vid="PSA 144:9">Ami ñyaabre ndidoudʌk udʌk duob unọ fiin,<verse eid="PSA 144:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10" />nnọ Anye anọọhọ mme ndidem adikan,</para>
  <para style="q2" vid="PSA 144:10">ake anyaañake awo amọ Defid.</para>
  <para style="b" vid="PSA 144:10" />
  <para style="q1" vid="PSA 144:10">Nsio ke eduad ñkpa; <verse eid="PSA 144:10" /><verse number="11" style="v" sid="PSA 144:11" />ñnyaaña miin sio ke akañkañ ñkpa</para>
  <para style="q2" vid="PSA 144:11">mfak miin sio ke ubọk isenawo</para>
  <para style="q1" vid="PSA 144:11">ake inua ammọ eyọhọke ye nsu;</para>
  <para style="q2" vid="PSA 144:11">ake ubọk nnasia ammọ edooho abiaña.<verse eid="PSA 144:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12" />Ndin nditọ ideen ñnyịn ke uyịn ammọ</para>
  <para style="q2" vid="PSA 144:12">eyaeba nte mme eto e-enekkeke ebọọk,</para>
  <para style="q1" vid="PSA 144:12">nditọ ibaan ñnyịn eyaeba nte mme abai</para>
  <para style="q2" vid="PSA 144:12">e-enamma nọ ekama ediọñ ufọk mbọọñ.<verse eid="PSA 144:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13" />Ise ñnyịn ayaayọhọ</para>
  <para style="q2" vid="PSA 144:13">ye afịd utọ inie.</para>
  <para style="q1" vid="PSA 144:13">Edọñ ñnyịn ayaatọt ke tọsịn,</para>
  <para style="q2" vid="PSA 144:13">ke tọsịn duob ke mme inwañ ñnyịn;<verse eid="PSA 144:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 144:14" />mme ñyaaraenañ ñnyịn eyaedʌt ndoppo mbiomo.</para>
  <para style="q1" vid="PSA 144:14">Baaba ñkpọ se ibiara idiibaaha,</para>
  <para style="q2" vid="PSA 144:14">uka ñkpakọb idiibaaha,</para>
  <para style="q2" vid="PSA 144:14">ntuaayịd ukuud idiibaaha ke mme efaak ñnyịn.<verse eid="PSA 144:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15" />Afọfọn anọ mbon se ikọ ami ado akpanikọ;</para>
  <para style="q2" vid="PSA 144:15">afọfọn anọ mbon se Abasi ammọ ado <char style="nd">Abọọñ</char>.<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="cl">Saam 145</para>
  <para style="d">Saam itooro. Ake Defid.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1" />Ami ñyaukpono fiin, Abasi ye Adidem mmi;</para>
  <para style="q2" vid="PSA 145:1">ami ñyaatooro anyịñ mfo ke nsi-nsi nsi-nsi.<verse eid="PSA 145:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2" />Afịd usen ami ñyautooro fiin</para>
  <para style="q2" vid="PSA 145:2">ñnyʌñ ndịppe anyịñ mfo ke nsi-nsi.<verse eid="PSA 145:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3" />
    <char style="nd">Abọọñ</char> akpon anyʌñ adot se etooro;</para>
  <para style="q2" vid="PSA 145:3">ikanna inwaña awo naña anye akpon.<verse eid="PSA 145:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4" />Emana keed etañ utom mfo enọ emana mfen;</para>
  <para style="q2" vid="PSA 145:4">ammọ etañ ebaña mme ikpọ ñkpọ se afo anam.<verse eid="PSA 145:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5" />Ammọ etañ ebaña uyai ubọọñ ubom mfo,</para>
  <para style="q2" vid="PSA 145:5">ñko ami ñyaakere mbana mme utịppe utom mfo.<verse eid="PSA 145:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6" />Ammọ etañ ebaña adudu uwak ñkpọ ndịk mfo,</para>
  <para style="q2" vid="PSA 145:6">ami ñyaabʌk mbaña mme ikpọ adinam mfo.<verse eid="PSA 145:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7" />Ammọ enam idaara ebaña uwak mfọn mfo</para>
  <para style="q2" vid="PSA 145:7">enyʌñ ekwọ adinenido mfo ke idaara.<verse eid="PSA 145:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8" />
    <char style="nd">Abọọñ</char> anie esịd mfọn ye mbọm,</para>
  <para style="q2" vid="PSA 145:8">isọppọ iyadesịd, ayọhọ ye ima.<verse eid="PSA 145:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9" />
    <char style="nd">Abọọñ</char> afọn ye afịd awo;</para>
  <para style="q2" vid="PSA 145:9">anye anie mbọm abaña afịd se anye akebot.<verse eid="PSA 145:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10" />
    <char style="nd">Abọọñ</char>, afịd utom mfo utooro fiin;</para>
  <para style="q2" vid="PSA 145:10">mbon akpanikọ mfo ukpono fiin.<verse eid="PSA 145:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11" />Ammọ ebʌk ubọọñ itie idʌñ mfo</para>
  <para style="q2" vid="PSA 145:11">enyʌñ etañ ebaña adudu mfo,<verse eid="PSA 145:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12" />nọ afịd awo ediọọñọ ebaña mme ikpọ adinam mfo</para>
  <para style="q2" vid="PSA 145:12">ye ubọọñ uyai ebekpo mfo.<verse eid="PSA 145:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13" />Ebekpo mfo ado nsi-nsi ebekpo,</para>
  <para style="q2" vid="PSA 145:13">ukara mfo ado ke afịd emana.</para>
  <para style="b" vid="PSA 145:13" />
  <para style="q1" vid="PSA 145:13">
    <char style="nd">Abọọñ</char> ke afịd enwọñọ amọ adot se ebuọt idem</para>
  <para style="q2" vid="PSA 145:13">ñko anye anam akpanikọ ke afịd se anye anam.<verse eid="PSA 145:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14" />
    <char style="nd">Abọọñ</char> amʌm afịd mbon e-eduọhọ</para>
  <para style="q2" vid="PSA 145:14">anyʌñ adịppe afịd mbon e-enʌhọke.<verse eid="PSA 145:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15" />Anyen afịd awo use fiin,</para>
  <para style="q2" vid="PSA 145:15">ñko afo anọ ammọ ndidia ke akem ini.<verse eid="PSA 145:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16" />Afo atat ubọk mfo</para>
  <para style="q2" vid="PSA 145:16">anyʌñ anọ afịd mme aduuwem udọñ esịd ammọ.<verse eid="PSA 145:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17" />
    <char style="nd">Abọọñ</char> ado adinen ke afịd usʌñ amọ</para>
  <para style="q2" vid="PSA 145:17">ñko anam akpanikọ ke afịd se anye anam.<verse eid="PSA 145:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18" />
    <char style="nd">Abọọñ</char> akpere afịd mbon e-ekoodo anye,</para>
  <para style="q2" vid="PSA 145:18">afịd mbon e-ekoodo anye ke akpanikọ.<verse eid="PSA 145:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19" />Anye anam udọñ mbon se ibaak anye;</para>
  <para style="q2" vid="PSA 145:19">anye akop ntuaña ammọ anyʌñ anyaaña ammọ.<verse eid="PSA 145:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20" />
    <char style="nd">Abọọñ</char> akpeme afịd mbon e-emaaha anye,</para>
  <para style="q2" vid="PSA 145:20">ado anye ayaasobo mbon ibak.<verse eid="PSA 145:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21" />Inua mmi ayaatañ itooro abaña <char style="nd">Abọọñ</char>.</para>
  <para style="q2" vid="PSA 145:21">Yak afịd se ebot etooro adisana anyịñ amọ</para>
  <para style="q2" vid="PSA 145:21">ke nsi-nsi nsi-nsi.<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="cl">Saam 146</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1" />Itooro <char style="nd">Abọọñ</char>.</para>
  <para style="b" vid="PSA 146:1" />
  <para style="q1" vid="PSA 146:1">Ukpọñ mmi, tooro <char style="nd">Abọọñ</char>.<verse eid="PSA 146:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2" />Ami ñyaatooro <char style="nd">Abọọñ</char> ke afịd uwem mmi;</para>
  <para style="q2" vid="PSA 146:2">Ami ñyaakwọ itooro nnọ Abasi mmi ke naña nte ami mbaaha ke uwem.<verse eid="PSA 146:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3" />Kuusịn mbuọdidem mfo ke mme mbọọñ,</para>
  <para style="q2" vid="PSA 146:3">ke ñkaña awo, ake imiikanna inyaaña awo.<verse eid="PSA 146:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4" />Sịbidịd ammọ amaawuọ, ammọ etịmme enyọñọ isọñ;</para>
  <para style="q2" vid="PSA 146:4">kpasʌk usen ado, uduak ammọ akappa ikpu-ikpu.<verse eid="PSA 146:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5" />Afọfọn anọ mbon ake unwam ammọ atooho Abasi Yekọb,</para>
  <para style="q2" vid="PSA 146:5">ake idodanyen ammọ abaaha ke <char style="nd">Abọọñ</char> Abasi ammọ.<verse eid="PSA 146:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6" />Anye ado Andinam anyọñ ye isọñ,</para>
  <para style="q2" vid="PSA 146:6">akpainyañ ye afịd se idọñọ ke esịd,</para>
  <para style="q2" vid="PSA 146:6">anye ado anam akpanikọ ke nsi-nsi.<verse eid="PSA 146:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7" />Anye akpe ikpe anọ mbon etʌkkọ</para>
  <para style="q2" vid="PSA 146:7">anyʌñ anọ mbon abiọọñ ndidia.</para>
  <para style="q1" vid="PSA 146:7">
    <char style="nd">Abọọñ</char> atat mbon ñkpakọb asuuk,<verse eid="PSA 146:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 146:8" />
    <char style="nd">Abọọñ</char> anam nnan ekịt usʌñ,</para>
  <para style="q1" vid="PSA 146:8">
    <char style="nd">Abọọñ</char> adịppe mbon se ufiik anuuk,</para>
  <para style="q2" vid="PSA 146:8">
    <char style="nd">Abọọñ</char> ama ndinen awo.<verse eid="PSA 146:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9" />
    <char style="nd">Abọọñ</char> akpeme asenawo</para>
  <para style="q2" vid="PSA 146:9">anyʌñ akama nditọakpa ye ebekpa,</para>
  <para style="q2" vid="PSA 146:9">ado anye abiat usʌñ mbon ibak.<verse eid="PSA 146:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10" />
    <char style="nd">Abọọñ</char> akara ke nsi-nsi,</para>
  <para style="q2" vid="PSA 146:10">Abasi mfo, O Saiyọn ke afịd emana.</para>
  <para style="b" vid="PSA 146:10" />
  <para style="q1" vid="PSA 146:10">Itooro <char style="nd">Abọọñ</char>.<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="cl">Saam 147</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1" />Itooro <char style="nd">Abọọñ</char>.</para>
  <para style="b" vid="PSA 147:1" />
  <para style="q1" vid="PSA 147:1">Afọn die adikwọ itooro nnọọ Abasi,</para>
  <para style="q2" vid="PSA 147:1">anem anyʌñ anen die adikwọ itooro nnọ anye!<verse eid="PSA 147:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2" />Ado <char style="nd">Abọọñ</char> abọp Yeruselem;</para>
  <para style="q2" vid="PSA 147:2">anye akoono nditọ Isrel se eketañ esio.<verse eid="PSA 147:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3" />Anye akọk mbon mbʌññọesịd</para>
  <para style="q2" vid="PSA 147:3">anyʌñ abọp unan ammọ.<verse eid="PSA 147:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4" />Anye anọ ibad ntantaafiọñ</para>
  <para style="q2" vid="PSA 147:4">anyʌñ akoot ammọ ke anyịñ.<verse eid="PSA 147:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5" />
    <char style="nd">Abọọñ</char> ñnyịn akpon anyʌñ asọñ adudu;</para>
  <para style="q2" vid="PSA 147:5">ifiọk amọ inieghe utịd.<verse eid="PSA 147:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6" />
    <char style="nd">Abọọñ</char> amʌm mbon nsuukidem akama</para>
  <para style="q2" vid="PSA 147:6">ado atop mbon ibak asịn ke isọñ.<verse eid="PSA 147:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7" />Ikwọ ikwọ itooro idadesịd inọ <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 147:7">ibre ikwọ inọ Abasi ñnyịn ke ekpa.<verse eid="PSA 147:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8" />Anye afʌk ikpaanyọñ ye ntọñanyọñ;</para>
  <para style="q2" vid="PSA 147:8">anye anọ isọñ edịm</para>
  <para style="q2" vid="PSA 147:8">anyʌñ anam mbid afịt ke ntək abod.<verse eid="PSA 147:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9" />Anye anọ mme enañ ndidia</para>
  <para style="q2" vid="PSA 147:9">ye mme ekọọñebʌkayob ke ini ammọ eseemeke enọ anye.<verse eid="PSA 147:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10" />Idadesịd amọ idooho ke adudu ake enañmbakara,</para>
  <para style="q2" vid="PSA 147:10">me inemesịd amọ ke ukod mbon ekọñ;<verse eid="PSA 147:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11" />
    <char style="nd">Abọọñ</char> adat esịd ke mbon se ibaak anye,</para>
  <para style="q2" vid="PSA 147:11">esịnne esịd ammọ ke nsọọñọnda ima amọ.<verse eid="PSA 147:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12" />Yeruselem, ikpono <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 147:12">Saiyọn, itooro Abasi ndufo.<verse eid="PSA 147:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13" />Anye anam mme ukwak inuaatob ndufo asọọñọ</para>
  <para style="q2" vid="PSA 147:13">anyʌñ adiọñ mbon e-ebaaha ye ndufo.<verse eid="PSA 147:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14" />Anye anam mme adaña ndufo enie emem</para>
  <para style="q2" vid="PSA 147:14">anyʌñ iyʌkkọ ndufo ye ataa eti wiid.<verse eid="PSA 147:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15" />Anye adọñ ikọ amọ utom ke ederimbod;</para>
  <para style="q2" vid="PSA 147:15">ikọ amọ asọp eti-eti.<verse eid="PSA 147:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16" />Anye adette sino nte idededọñ</para>
  <para style="q2" vid="PSA 147:16">anyʌñ asuan ndedeb nte ntọñ.<verse eid="PSA 147:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17" />Anye aduọk edịmitiad nte ñkeñe itiad.</para>
  <para style="q2" vid="PSA 147:17">Anie awo ikpikan ida ke sino atueb amọ?<verse eid="PSA 147:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18" />Anye adọñ ikọ amọ aditara ammọ;</para>
  <para style="q2" vid="PSA 147:18">anam afịm amọ atara, mmọọñ akan afeghe.<verse eid="PSA 147:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19" />Anye ayaara ikọ amọ anọ Yekọb,</para>
  <para style="q2" vid="PSA 147:19">mme mbed ye ewʌhọ amọ anọ Isrel.<verse eid="PSA 147:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20" />Anye inamma ami inọ idịd ndomokeed mfen;</para>
  <para style="q2" vid="PSA 147:20">ammọ idiọọñọke mme mbed amọ.</para>
  <para style="b" vid="PSA 147:20" />
  <para style="q1" vid="PSA 147:20">Itooro <char style="nd">Abọọñ</char>.<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="cl">Saam 148</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1" />Itooro <char style="nd">Abọọñ</char>.</para>
  <para style="b" vid="PSA 148:1" />
  <para style="q1" vid="PSA 148:1">Itie ke anyọñ itooro <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PSA 148:1">itooro anye ke ñkoñ-ñkoñ itie.<verse eid="PSA 148:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2" />Afịd mme enyere amọ itooro anye;</para>
  <para style="q2" vid="PSA 148:2">itooro anye, afịd mme udịm anyọñ amọ.<verse eid="PSA 148:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3" />Ayio ye afiọñ, itooro anye;</para>
  <para style="q2" vid="PSA 148:3">afịd ntantaafiọñ unwana, itooro anye.<verse eid="PSA 148:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4" />Ndufo mme ñkoñ-ñkoñ anyọñ, etooro anye</para>
  <para style="q2" vid="PSA 148:4">ye ndufo mme mmọọñ ke anyọñ ntọñanyọñ.<verse eid="PSA 148:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5" />Yak ammọ etooro anyịñ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 148:5">sia ekebot ammọ eto ke uyio amọ,<verse eid="PSA 148:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6" />ñko anye akenam ammọ eba ke nsi-nsi nsi-nsi,</para>
  <para style="q2" vid="PSA 148:6">anye amaanọ ewʌhọ ake imiidiboiyoke ifep.<verse eid="PSA 148:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7" />Itie ke isọñ itooro <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 148:7">afịd ndufo ikpọ unam ke akpainyañ ye ke mme udem,<verse eid="PSA 148:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8" />akebkeb ye edịmitiad, ntuhube ye ntọñanyọñ</para>
  <para style="q2" vid="PSA 148:8">afịm ayobio a-anamma uyio amọ,<verse eid="PSA 148:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9" />ndufo ikpọ ye afịd ntək abod</para>
  <para style="q2" vid="PSA 148:9">mme eto ake enwịmme mfịd ye afịd mme eto sida,<verse eid="PSA 148:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10" />ndiọi unam ikọd ye afịd enañ,</para>
  <para style="q2" vid="PSA 148:10">ntək unam ye inuen e-efuurọke,<verse eid="PSA 148:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11" />ndidem isọñ ye afịd mme idịd,</para>
  <para style="q2" vid="PSA 148:11">nditọ mbọọñ ye afịd mme akara isọñ,<verse eid="PSA 148:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12" />ñkparawa ye ubọikpa,</para>
  <para style="q2" vid="PSA 148:12">ñkaan ideen ye ntəkayịn.<verse eid="PSA 148:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13" />Yak ammọ etooro anyịñ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 148:13">sia anyịñ amọ ikpọọñ akoñ;</para>
  <para style="q2" vid="PSA 148:13">uyai amọ akoñ akan isọñ ye anyọñ.<verse eid="PSA 148:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14" />Anye abenne nnʌk ke anyọñ anọ ikọd amọ</para>
  <para style="q2" vid="PSA 148:14">itooro afịd ndinen nditọufọk amọ,</para>
  <para style="q2" vid="PSA 148:14">ake Isrel, mbon se ikpere esịd amọ.</para>
  <para style="b" vid="PSA 148:14" />
  <para style="q1" vid="PSA 148:14">Itooro <char style="nd">Abọọñ</char>.<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="cl">Saam 149</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1" />Itooro <char style="nd">Abọọñ</char>.</para>
  <para style="b" vid="PSA 149:1" />
  <para style="q1" vid="PSA 149:1">Ikwọ ufa ikwọ inọ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PSA 149:1">itooro amọ ke mboho mme andinịm ke akpanikọ.<verse eid="PSA 149:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2" />Yak Isrel anem esịd ke Andibod ammọ;</para>
  <para style="q2" vid="PSA 149:2">yak mbon Saiyọn enem esịd ke Adidem ammọ.<verse eid="PSA 149:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3" />Yak ammọ etooro anyịñ amọ ye unek</para>
  <para style="q2" vid="PSA 149:3">enyʌñ ekwọ ikwọ enọ anye ke ibịdubọk ye ekpa.<verse eid="PSA 149:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4" />Sia <char style="nd">Abọọñ</char> anie inemesịd ke mbon amọ;</para>
  <para style="q2" vid="PSA 149:4">anye ayat mbon nsuukidem anyanya adikan.<verse eid="PSA 149:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5" />Yak mbon akpanikọ amọ edaara ke ukpono ami</para>
  <para style="q2" vid="PSA 149:5">enyʌñ ekwọ ikwọ idaara ke mme ikʌk ammọ.<verse eid="PSA 149:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6" />Yak itooro Abasi aba ke inua ammọ</para>
  <para style="q2" vid="PSA 149:6">ye akañkañ inuaiba ke ubọk ammọ,<verse eid="PSA 149:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7" />nọ esio usiene ke atu mme idịd</para>
  <para style="q2" vid="PSA 149:7">enyʌñ emia mbon awo ufen,<verse eid="PSA 149:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8" />nọ ekọp ndidem ammọ ke ñkpakọb,</para>
  <para style="q2" vid="PSA 149:8">mbon ukpono ammọ ke akpọnọ ukwak,<verse eid="PSA 149:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9" />nọ ekpe ikpe ke iwuod ammọ naña ewet,</para>
  <para style="q2" vid="PSA 149:9">ubọọñ afịd mbon akpanikọ amọ ado mi.</para>
  <para style="b" vid="PSA 149:9" />
  <para style="q1" vid="PSA 149:9">Itooro <char style="nd">Abọọñ</char>.<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="cl">Saam 150</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1" />Itooro <char style="nd">Abọọñ</char>.</para>
  <para style="b" vid="PSA 150:1" />
  <para style="q1" vid="PSA 150:1">Itooro Abasi ke adisana itie amọ;</para>
  <para style="q2" vid="PSA 150:1">itooro anye ke akpọsọñ anyọñ amọ.<verse eid="PSA 150:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2" />Itooro anye ke mme utom adudu amọ;</para>
  <para style="q2" vid="PSA 150:2">itooro anye ke ataa ekamba ubom amọ.<verse eid="PSA 150:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3" />Itooro anye ke uyom adukpoñ,</para>
  <para style="q2" vid="PSA 150:3">itooro anye ke ekpa ye ndidoudʌk,<verse eid="PSA 150:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4" />itooro anye ke ibịdubọk ye ke unek,</para>
  <para style="q2" vid="PSA 150:4">itooro anye ke ndido udʌk ye ke adʌk,<verse eid="PSA 150:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5" />itooro anye ke adikwak mme simbal,</para>
  <para style="q2" vid="PSA 150:5">itooro anye ke akpọsọñ uyom mme simbal.<verse eid="PSA 150:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6" />Yak afịd ñkpọ se inweek inweek etooro <char style="nd">Abọọñ</char>.</para>
  <para style="b" vid="PSA 150:6" />
  <para style="q1" vid="PSA 150:6">Itooro <char style="nd">Abọọñ</char>.<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>