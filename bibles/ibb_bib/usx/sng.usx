  <para style="h">Mme Ikwọ Sọlọmọn</para>
  <para style="toc1">Mme Ikwọ Sọlọmọn</para>
  <para style="toc2">Mme Ikwọ Sọlọmọn</para>
  <para style="toc3">Ikwọ</para>
  <para style="mt1">Mme Ikwọ Sọlọmọn</para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />Mme Ikwọ Sọlọmọn<verse eid="SNG 1:1" /></para>
  <para style="b" />
  <para style="sp">Awonwaan</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2" />Yak anye antʌm miin inua ye ntʌminua ake inua amọ,</para>
  <para style="q2" vid="SNG 1:2">sia ima mfo annem miin esịd akan ukọd.<verse eid="SNG 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3" />Ufịk nti pefium mfo anneenem;</para>
  <para style="q2" vid="SNG 1:3">anyịñ mfo atie nte pefium e-eduọkkọ.</para>
  <para style="q2" vid="SNG 1:3">Idooho ñkpọ ñkpaidem ke ñkparawa ibaan uma fiin!<verse eid="SNG 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4" />Mben miin nọ mfeghe ye afo, nam nọ ñnyịn isọsọp!</para>
  <para style="q2" vid="SNG 1:4">Yak adidem andat miin adʌk ubeed amọ.</para>
  <para style="sp" vid="SNG 1:4">Mme Ufan</para>
  <para style="q1" vid="SNG 1:4">Ñnyịn imidaara inyʌñ ikop inem ke afo;</para>
  <para style="q2" vid="SNG 1:4">ñnyịn iyaitooro ima mfo ikan ukọd.</para>
  <para style="sp" vid="SNG 1:4">Awonwaan</para>
  <para style="q1" vid="SNG 1:4">Ammọ e-enen adukpono fiin!<verse eid="SNG 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5" />Nditọ ibaan Yeruselem,</para>
  <para style="q2" vid="SNG 1:5">ami ndo abubịd awo, ado mmeyaiya,</para>
  <para style="q1" vid="SNG 1:5">abubịd nte mme atayad Keda,</para>
  <para style="q2" vid="SNG 1:5">nte mme afọñ anyenusʌñ atayad Sọlọmọn.<verse eid="SNG 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6" />Kuutịñ anyen unse miin sia ami mmebre,</para>
  <para style="q2" vid="SNG 1:6">sia ayio amfọp anam yak ami ndo abubịd.</para>
  <para style="q1" vid="SNG 1:6">Nditọeka mmi ideen emaeyat esịd ye ami</para>
  <para style="q2" vid="SNG 1:6">enyʌñ enam ami nse ñkpọ mbaña mme inwañ fain;</para>
  <para style="q2" vid="SNG 1:6">ado anam ami ñketre adise ñkpọ mbaña inwañ fain mmi.<verse eid="SNG 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7" />Ndọkkọ miin, afo ake ami mmaaha,</para>
  <para style="q2" vid="SNG 1:7">itie se afo anọọ udịmedọñ mfo mbid</para>
  <para style="q2" vid="SNG 1:7">ye itie se afo anam edọñ mfo eduọk adudu ke ufọọd uweemeayio.</para>
  <para style="q1" vid="SNG 1:7">Ntak ami ñkpebaaha nte awonwaan a-afʌhọke ñkpọ afʌk iso-o</para>
  <para style="q2" vid="SNG 1:7">ye mme edọñ mme ufan mfo?<verse eid="SNG 1:7" /></para>
  <para style="sp">Mme Ufan</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8" />Adieke afo umuudiọọñọke, afo andiyaiya ñkan ke atu mme ibaan,</para>
  <para style="q2" vid="SNG 1:8">keene mme afañusʌñ a-mme edọñ esañake</para>
  <para style="q1" vid="SNG 1:8">nyʌñ nam mme ñyịn ebod mfo eta mbid do</para>
  <para style="q2" vid="SNG 1:8">ekpere mme atayad mme akpemeedọñ.<verse eid="SNG 1:8" /></para>
  <para style="sp">Awodeen</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9" />Edima mmi, ami udat fiin ndomo ye uman enañmbakara</para>
  <para style="q2" vid="SNG 1:9">ke atu mme enañmbakara ewatta sariọd ñkpọekọñ Fero.<verse eid="SNG 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10" />Mfʌk mfo eyaiya ye mme ñkpahautọñ,</para>
  <para style="q2" vid="SNG 1:10">ye mme ñkpọuto ke itọñ mfo.<verse eid="SNG 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11" />Ñnyịn iyainam ñkpahautọñ kold unọ fiin,</para>
  <para style="q2" vid="SNG 1:11">ake edọññọ silfa.<verse eid="SNG 1:11" /></para>
  <para style="sp">Awonwaan</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12" />Ke ini adidem aketieghe ke akpokoro ndidia,</para>
  <para style="q2" vid="SNG 1:12">pefium mmi amaasuan ufịk amọ.<verse eid="SNG 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13" />Awoima mmi ado etək ekpad mee annọ miin</para>
  <para style="q2" vid="SNG 1:13">a-aduọkkọ adudu ke ufọọd eba mmi.<verse eid="SNG 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14" />Awoima mmi ado eboho ñkpokpoñ hena annọ miin</para>
  <para style="q2" vid="SNG 1:14">a-atooho mme inwañ fain ake En Kedi.<verse eid="SNG 1:14" /></para>
  <para style="sp">Awodeen</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15" />Afo ayaiya die ntom, edima mmi!</para>
  <para style="q2" vid="SNG 1:15">Sai, ameyaiya tutu!</para>
  <para style="q2" vid="SNG 1:15">Anyen mfo ado mme ibiom.<verse eid="SNG 1:15" /></para>
  <para style="sp">Awonwaan</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16" />Afo ayaiya die ntom, awoima mmi!</para>
  <para style="q2" vid="SNG 1:16">Sai, se naña anduọhọ!</para>
  <para style="q2" vid="SNG 1:16">Ikʌk ñnyịn anyʌñ aseseghe.<verse eid="SNG 1:16" /></para>
  <para style="sp">Awodeen</para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17" />Abom ufọk ñnyịn edo sida;</para>
  <para style="q2" vid="SNG 1:17">eto anyọñ akọm ufọk ñnyịn edo fir.<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="sp">Awonwaan</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1" />Ami ndo roos ake Sarọn,</para>
  <para style="q2" vid="SNG 2:1">ye lili ake mme abedeñ.<verse eid="SNG 2:1" /></para>
  <para style="sp">Awodeen</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />Nte lili ke atu mme ñkukịm</para>
  <para style="q2" vid="SNG 2:2">ke edima mmi ado ke atu ñkparawa ibaan.<verse eid="SNG 2:2" /></para>
  <para style="sp">Awonwaan</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />Nte eto apịl ke atu mme eto ke akai</para>
  <para style="q2" vid="SNG 2:3">ke awoima mmi ado ke atu ñkparawa ideen.</para>
  <para style="q1" vid="SNG 2:3">Ami mmekop inemesịd aditie ke idak ndeeñ amọ,</para>
  <para style="q2" vid="SNG 2:3">ndin mfịd amọ anneenịññe miin ke inua.<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />Yak anye andat miin aka ke ufọk usọrọ,</para>
  <para style="q2" vid="SNG 2:4">ndin yak afọñidiọọñọ ake anye amfʌkkọ miin ado ima.<verse eid="SNG 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5" />Nsọọñọ miin idem ke mme nsaad ndomuyo kreb,</para>
  <para style="q2" vid="SNG 2:5">ndemme miin uwem ke mme apịl,</para>
  <para style="q2" vid="SNG 2:5">sia ami mmesʌkkọ nnọ ima.<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />Ubọk ufiin amọ asịne ke idak iwuod mmi,</para>
  <para style="q2" vid="SNG 2:6">ubọk nnasia amọ anyʌñ amfat miin.<verse eid="SNG 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />Nditọ ibaan Yeruselem, ami mmiwuuk ndufo</para>
  <para style="q2" vid="SNG 2:7">ke ntak mme edob ye mme ebed ikọd:</para>
  <para style="q1" vid="SNG 2:7">Ikiitọi, ikiinyʌñ idịppe nduduai ima</para>
  <para style="q2" vid="SNG 2:7">tutu anye ayem nọ idemme.<verse eid="SNG 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8" />Awoima mmi! Kpañ utọñ!</para>
  <para style="q2" vid="SNG 2:8">Se! Se anye adiighe mi,</para>
  <para style="q1" vid="SNG 2:8">asʌk ataam aboiyo ke mme ikpọabod,</para>
  <para style="q2" vid="SNG 2:8">asaña akanna adaña ntəkabod.<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />Awoima mmi abit edob imiidooho anye abit ñyịn ayaara ebed.</para>
  <para style="q2" vid="SNG 2:9">Se! Anye ada ado ke edem ndibene ñnyịn,</para>
  <para style="q1" vid="SNG 2:9">asʌk ase ke mme ubenafịm</para>
  <para style="q2" vid="SNG 2:9">ada ke mben akọ anyuuñọ.<verse eid="SNG 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10" />Awoima mmi amaatañ amaanyʌñ ambo miin ate,</para>
  <para style="q2" vid="SNG 2:10">“Dakka da, edima mmi,</para>
  <para style="q2" vid="SNG 2:10">uyai mmi, di mbịne miin.<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />Se! Ini atueb a-aboiyo;</para>
  <para style="q2" vid="SNG 2:11">edịm a-adep ama anyʌñ abiide.<verse eid="SNG 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12" />Mme ñkpokpoñ ewuọñọ ke unadod;</para>
  <para style="q2" vid="SNG 2:12">ini ukwọ ikwọ a-adi,</para>
  <para style="q1" vid="SNG 2:12">e-ekop uyio ikwọ mme ibiom</para>
  <para style="q2" vid="SNG 2:12">ke isọñ ñnyịn.<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />Eto fik abak asịññe mfịd amọ;</para>
  <para style="q2" vid="SNG 2:13">mme nseghe fain esuan inem ufịk ammọ.</para>
  <para style="q1" vid="SNG 2:13">Dakka da, di, awoima mmi;</para>
  <para style="q2" vid="SNG 2:13">uyai mmi, di mbịne miin.”<verse eid="SNG 2:13" /></para>
  <para style="sp">Awodeen</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />Ibiom mmi a-asịneke ke mme abaitiad,</para>
  <para style="q2" vid="SNG 2:14">a-abaaha ke mme itie ndịbe edem mme ikpọabod,</para>
  <para style="q1" vid="SNG 2:14">ñwọt miin iso mfo,</para>
  <para style="q2" vid="SNG 2:14">yak ami ñkop uyio mfo;</para>
  <para style="q1" vid="SNG 2:14">sia uyio mfo anenem,</para>
  <para style="q2" vid="SNG 2:14">iso mfo ayayaiya.<verse eid="SNG 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />Mʌm mme ewaikọd inọ ñnyịn,</para>
  <para style="q2" vid="SNG 2:15">kpa ntək ewaikọd</para>
  <para style="q1" vid="SNG 2:15">e-ebiada mme inwañ fain,</para>
  <para style="q2" vid="SNG 2:15">mme inwañ fain ñnyịn amaatọọñọ isịññe ñkpokpoñ.<verse eid="SNG 2:15" /></para>
  <para style="sp">Awonwaan</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />Awoima mmi ado ake mmi ami ñko ñnyʌñ ndo ake amọ;</para>
  <para style="q2" vid="SNG 2:16">anye asaaña ke atu mme lili.<verse eid="SNG 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17" />Tutu ayio asiere</para>
  <para style="q2" vid="SNG 2:17">mme ndukpọñ enyʌñ esop,</para>
  <para style="q1" vid="SNG 2:17">wọññọ da, awoima mmi,</para>
  <para style="q2" vid="SNG 2:17">nyʌñ ba nte asọbusọb ñyịn edob</para>
  <para style="q1" vid="SNG 2:17">me nte ñyịn ebed</para>
  <para style="q2" vid="SNG 2:17">ke mme itiad-itiad ntək abod.<verse eid="SNG 2:17" /></para>
  <para style="b" />
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1" />Afịd akonayio ke ikʌk mmi</para>
  <para style="q2" vid="SNG 3:1">ami mmaayem anye ake esịd mmi amaaha;</para>
  <para style="q2" vid="SNG 3:1">ami mmaayem anye, ado ñkekịtte anye.<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />Ami ñyaadakka nda idahami ñnyʌñ nsaña ñkanna abio,</para>
  <para style="q2" vid="SNG 3:2">ke mme efaak ye ke mme afe amọ;</para>
  <para style="q1" vid="SNG 3:2">ami ñyaayem anye ado ake esịd mmi amaaha.</para>
  <para style="q2" vid="SNG 3:2">Ndin ami mmaayem anye, ado ñkekịtte anye.<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />Mme akpemeabio emaeñkịt miin</para>
  <para style="q2" vid="SNG 3:3">naña ammọ ekesaañake ekanna eseet abio.</para>
  <para style="q2" vid="SNG 3:3">“Nte ndufo emekịt anye ado ake esịd mmi amaaha?”<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />Ami ñkekpọññọkpọñ ammọ ñkpeene</para>
  <para style="q2" vid="SNG 3:4">ke ini ñkekịtte anye ado ake esịd mmi amaaha.</para>
  <para style="q1" vid="SNG 3:4">Ami mmaamʌm anye ñnyʌññọ ñnyịmme adiyaak anye yak anyọñ</para>
  <para style="q2" vid="SNG 3:4">tutu ami mben anye ñkesịm ufọk eka mmi,</para>
  <para style="q2" vid="SNG 3:4">ke ubeed anye a-akeñyommoke miin.<verse eid="SNG 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />Nditọ ibaan Yeruselem, ami mmiwuuk ndufo nte</para>
  <para style="q2" vid="SNG 3:5">ke ntak mme edob ye mme ebed ke akpa inwañ:</para>
  <para style="q1" vid="SNG 3:5">ikiitịmede ikiinyʌñ idemme ima</para>
  <para style="q2" vid="SNG 3:5">tutu anye anie udọñ.<verse eid="SNG 3:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />Anie awo ido ami a-awuọhọ ke anaan adi</para>
  <para style="q2" vid="SNG 3:6">nte adaaha nsʌñikañ,</para>
  <para style="q1" vid="SNG 3:6">e-efiọññọke pefium ye mee ye insensi</para>
  <para style="q2" vid="SNG 3:6">e-ekamake afịd inem ñkpadia mme anyam udua enam?<verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />Se! Ado ukpadñkpọ Sọlọmọn,</para>
  <para style="q2" vid="SNG 3:7">mbonekọñ ata esaña ekpeme,</para>
  <para style="q2" vid="SNG 3:7">mbon se ekpono ekan ke Isrel,<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />afịd ammọ ekọñọ akañkañ,</para>
  <para style="q2" vid="SNG 3:8">afịd ammọ enie ifiọk ebaña ekọñ,</para>
  <para style="q1" vid="SNG 3:8">ammọ keedekeed ekọñọ akañkañ amọ ke ñkañ,</para>
  <para style="q2" vid="SNG 3:8">ebeeñe idem ebaña ñkpọ ndịk ke akonayio.<verse eid="SNG 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9" />Adidem Sọlọmọn amaanam ukpadñkpọ anọ idem amọ;</para>
  <para style="q2" vid="SNG 3:9">anye akekama eto a-atooho Lebanọn anam ukpadñkpọ ado.<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />Anye akekama silfa anam mme abai amọ,</para>
  <para style="q2" vid="SNG 3:10">akama kold anam eko amọ.</para>
  <para style="q1" vid="SNG 3:10">Akekama iduod-iduod afọñ afʌk akanna anyọñ ñkpọitie amọ,</para>
  <para style="q2" vid="SNG 3:10">akama ima abịt akanna esịd ñkpọitie ado.</para>
  <para style="q1" vid="SNG 3:10">Nditọ ibaan Yeruselem, <verse eid="SNG 3:10" /><verse number="11" style="v" sid="SNG 3:11" />iwuọñọ idi,</para>
  <para style="q2" vid="SNG 3:11">inyʌñ ise, ndufo nditọ ibaan Saiyọn.</para>
  <para style="q1" vid="SNG 3:11">Ise naña Adidem Sọlọmọn ayara anyanya,</para>
  <para style="q2" vid="SNG 3:11">anyanya e-eka amọ akeyatta anye</para>
  <para style="q1" vid="SNG 3:11">ke usen ndọ amọ,</para>
  <para style="q2" vid="SNG 3:11">usen e-esịd amọ akedaarake.<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="sp">Awodeen</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1" />Afo ayaiya die ntom, edima mmi!</para>
  <para style="q2" vid="SNG 4:1">Sai, ameyaiya tutu!</para>
  <para style="q2" vid="SNG 4:1">Anyen mfo ke esịd ufʌkiso mfo ado ibiom.</para>
  <para style="q1" vid="SNG 4:1">Ided mfo abit udịm ebod</para>
  <para style="q2" vid="SNG 4:1">e-esọiyọke eto ntəkabod Kilied.<verse eid="SNG 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2" />Eded mfo aba nte udịmedọñ esʌkkọ efat ided ema,</para>
  <para style="q2" vid="SNG 4:2">ewuọñọke ke itie uyieidem.</para>
  <para style="q1" vid="SNG 4:2">Ammọ keedekeed enie amanamba;</para>
  <para style="q2" vid="SNG 4:2">ibaaha ndomokeed ke atu ammọ asañake ikpọọñ.<verse eid="SNG 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3" />Ñkpọkinua mfo abit ñyiibe ididuod udʌkafọñ;</para>
  <para style="q2" vid="SNG 4:3">inua mfo ayaiya.</para>
  <para style="q1" vid="SNG 4:3">Akpọiso mfo ke esịd ufʌkiso mfo</para>
  <para style="q2" vid="SNG 4:3">atie nte ubaak pomekrened.<verse eid="SNG 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4" />Itọñ mfo abit tọwa Defid,</para>
  <para style="q2" vid="SNG 4:4">ekebọppọ ke uwak udịm itiad;</para>
  <para style="q1" vid="SNG 4:4">ekọọñ tọsịn atuekọñ do,</para>
  <para style="q2" vid="SNG 4:4">afịd ammọ edo mme atuekọñ mbonekọñ.<verse eid="SNG 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5" />Eba mfo aba nte nditọ edob iba,</para>
  <para style="q2" vid="SNG 4:5">ebit amanamba nditọ edob</para>
  <para style="q2" vid="SNG 4:5">e-esañake edia ndidia ke atu mme lili.<verse eid="SNG 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6" />Tutu ayio asiere</para>
  <para style="q2" vid="SNG 4:6">ndukpọñ anyʌñ asop,</para>
  <para style="q1" vid="SNG 4:6">Ami ñyaadọọk ñkaa ekamba abod mee</para>
  <para style="q2" vid="SNG 4:6">ye ke etək abod insensi.<verse eid="SNG 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7" />Afo ameyaiya afịd idem, edima mmi;</para>
  <para style="q2" vid="SNG 4:7">ndo ndomokeed ibaaha ke idem mfo.<verse eid="SNG 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8" />Kpọñ Lebanọn ñkeene miin, anwaanndọ mmi,</para>
  <para style="q2" vid="SNG 4:8">kpọñ Lebanọn ñkeene miin.</para>
  <para style="q1" vid="SNG 4:8">Sọiyọ ke anyọñ abod Amana,</para>
  <para style="q2" vid="SNG 4:8">to ke anyọñ abod Seni, ye ke atịñe abod Hemọn,</para>
  <para style="q1" vid="SNG 4:8">to ke itiennaa mme ekpe</para>
  <para style="q2" vid="SNG 4:8">ye ke ikpọabod mme ekpeñkem.<verse eid="SNG 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9" />Afo ameyịp esịd mmi, ayịneka mmi, anwaanndọ mmi;</para>
  <para style="q2" vid="SNG 4:9">afo ameyịp esịd mmi</para>
  <para style="q1" vid="SNG 4:9">ke akañ keed anyen ndise mfo,</para>
  <para style="q2" vid="SNG 4:9">ye ñkpọitọñ keed ake afo akọñọke.<verse eid="SNG 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10" />Ima mfo anem die ntom, ayịneka mmi, anwaanndọ mmi!</para>
  <para style="q2" vid="SNG 4:10">Ima mfo anem die ntom, anem akan ukọd,</para>
  <para style="q1" vid="SNG 4:10">ye inemufịk eti adan mfo</para>
  <para style="q2" vid="SNG 4:10">afọn akan afịd inem ñkpadia!<verse eid="SNG 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11" />Ñkpọkinua mfo atọi inịññe nte ndukpa adanakwọọk, anwaanndọ mmi;</para>
  <para style="q2" vid="SNG 4:11">mmọọñeba ye adanakwọọk esịne ke idak edeme mfo.</para>
  <para style="q1" vid="SNG 4:11">Inemufịk usịneñkpọ mfo</para>
  <para style="q2" vid="SNG 4:11">atie nte inemufịk ake Lebanọn.<verse eid="SNG 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12" />Afo ado inwañ ake ekọppọ enịm, ayịneka mmi, anwaanndọ mmi;</para>
  <para style="q2" vid="SNG 4:12">afo ado idịm ake etọọhọ ekanna, usʌñ mmọọñ ake esiide.<verse eid="SNG 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13" />Mme etoinwañ mfo edo inwañ pomekrened</para>
  <para style="q2" vid="SNG 4:13">ye nti mfịdeto,</para>
  <para style="q2" vid="SNG 4:13">ye mme eto hena ye naad,<verse eid="SNG 4:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="SNG 4:14" />naad ye safrọn,</para>
  <para style="q2" vid="SNG 4:14">kalamus ye sinamọn,</para>
  <para style="q2" vid="SNG 4:14">ye afịd mme kutọ-kutọ eto insensi,</para>
  <para style="q2" vid="SNG 4:14">ye mee ye mme alo</para>
  <para style="q2" vid="SNG 4:14">ye afịd mfọọn anem ufịk mfiọññọ eto.<verse eid="SNG 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15" />Afo ado inwañ idịm mmọọñ,</para>
  <para style="q2" vid="SNG 4:15">ube ufeghe mmọọñ</para>
  <para style="q2" vid="SNG 4:15">a-afegheke ato ke Lebanọn.<verse eid="SNG 4:15" /></para>
  <para style="sp">Awonwaan</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16" />Demme, afịm anyọñ,</para>
  <para style="q2" vid="SNG 4:16">nyʌñ di, afịm usuuk!</para>
  <para style="q1" vid="SNG 4:16">Ifịm ke inwañ mmi,</para>
  <para style="q2" vid="SNG 4:16">nọ inemufịk amọ asuana afịd itie.</para>
  <para style="q1" vid="SNG 4:16">Yak awoima mmi adʌk adi inwañ amọ</para>
  <para style="q2" vid="SNG 4:16">anyʌñ atabi mme nti mfịdeto amọ.<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">Awodeen</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1" />Ami mmedʌk ndi inwañ mmi, ayịneka mmi, anwaanndọ mmi;</para>
  <para style="q2" vid="SNG 5:1">Ami mmekoono mee mmi ye inem ñkpadia mmi.</para>
  <para style="q1" vid="SNG 5:1">Ami mmedia ndukpa akwọọk ye adanakwọọk mmi;</para>
  <para style="q2" vid="SNG 5:1">Ami mmenwọñ ukọd mmi ye mmọọñeba mmi.</para>
  <para style="sp" vid="SNG 5:1">Mme Ufan</para>
  <para style="q1" vid="SNG 5:1">Idia, mme ufan, inyʌñ inwọñ,</para>
  <para style="q2" vid="SNG 5:1">inwọñ uyọhọ ima ndufo.<verse eid="SNG 5:1" /></para>
  <para style="sp">Awonwaan</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2" />Ami mmaadaiya ado esịd mmi ikidaiyake.</para>
  <para style="q2" vid="SNG 5:2">Kpañ utọñ! Awoima mmi asʌk akọñ udọk:</para>
  <para style="q1" vid="SNG 5:2">“Beere nnọ miin, ayịneka mmi awonwaan, edima mmi,</para>
  <para style="q2" vid="SNG 5:2">ibiom mmi, anana ndo mmi.</para>
  <para style="q1" vid="SNG 5:2">Iwuod andʌppọ anọ mmọọñ ntuhube,</para>
  <para style="q2" vid="SNG 5:2">ided mmi adeññe anọ ndedeñ akonayio.”<verse eid="SNG 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />Ami mmesio afọñidem mmi,</para>
  <para style="q2" vid="SNG 5:3">ado se ntịmme mben nsịne?</para>
  <para style="q1" vid="SNG 5:3">Ami mmeyeyie ukod mmi;</para>
  <para style="q2" vid="SNG 5:3">ado se ntịmme nnam ammọ ebat?<verse eid="SNG 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />Awoima mmi asịn ubọk amọ ke mbaak eto,</para>
  <para style="q2" vid="SNG 5:4">esịd mmi atọọñọ aduọ ke ntak amọ.<verse eid="SNG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5" />Ami ndakka nda adibeere nnọ awoima mmi,</para>
  <para style="q2" vid="SNG 5:5">ubọk mmi anyʌñ atọi mee,</para>
  <para style="q1" vid="SNG 5:5">mmọọñ mee asaaña ke nnuunubọk mmi,</para>
  <para style="q2" vid="SNG 5:5">ke mme umʌmubọk ekọbudọk.<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />Ami mbeere nnọ awoima mmi,</para>
  <para style="q2" vid="SNG 5:6">ado awoima mmi amaadakka, anye amaanyọñ.</para>
  <para style="q2" vid="SNG 5:6">Esịd amanduọ ke unyọñ amọ.</para>
  <para style="q1" vid="SNG 5:6">Ami mmaayem anye ado ñkekịtte anye.</para>
  <para style="q2" vid="SNG 5:6">Ami mmaakoot anye ado anye ikiñyieghe.<verse eid="SNG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />Mme akpeme abio emaeñkịt miin</para>
  <para style="q2" vid="SNG 5:7">naña ammọ ekesaañake ekanna eseet abio.</para>
  <para style="q1" vid="SNG 5:7">Ammọ emmia miin, ammọ ennọññọ miin unan;</para>
  <para style="q2" vid="SNG 5:7">ammọ emaembọ miin ufọfʌhọ afọñidem mmi,</para>
  <para style="q2" vid="SNG 5:7">kpa mbon ukpeme mme ndibene!<verse eid="SNG 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />Nditọ ibaan Yeruselem, ami mmiwuuk ndufo nte,</para>
  <para style="q2" vid="SNG 5:8">adieke ndufo ekịtte awoima mmi,</para>
  <para style="q1" vid="SNG 5:8">nsoo ke ediitañ inọ anye?</para>
  <para style="q2" vid="SNG 5:8">Idọkkọ anye ke ami mmesʌkkọ nnọ ima.<verse eid="SNG 5:8" /></para>
  <para style="sp">Mme Ufan</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />Die ke awoima mfo afọn akan mbon mfen,</para>
  <para style="q2" vid="SNG 5:9">ñyaiyañkan ke atu mme ibaan?</para>
  <para style="q1" vid="SNG 5:9">Die ke awoima mfo afọn akan mbon mfen,</para>
  <para style="q2" vid="SNG 5:9">yak afo inọ ñnyịn utọ ewʌhọ ami?<verse eid="SNG 5:9" /></para>
  <para style="sp">Awonwaan</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />Awoima mmi ayamma anyʌñ ayiibe ñkem,</para>
  <para style="q2" vid="SNG 5:10">awuọ ada ke atu tọsịn duob.<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />Iwuod amọ ado ñyaiya ñkan kold;</para>
  <para style="q2" vid="SNG 5:11">ided amọ ado ñwaaña-ñwaaña</para>
  <para style="q2" vid="SNG 5:11">anyʌñ abre nte ekọọñebʌkayob.<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />Anyen amọ atie nte ibiom</para>
  <para style="q2" vid="SNG 5:12">ke mme mben mmọọñ idịm,</para>
  <para style="q1" vid="SNG 5:12">eyette ke mmọọñeba,</para>
  <para style="q2" vid="SNG 5:12">edịppeke edot nte ñkpọ mmaidem.<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />Mfʌk amọ eba nte mme ikʌk inem ñkpadia</para>
  <para style="q2" vid="SNG 5:13">asañake ye inemufịk adan.</para>
  <para style="q1" vid="SNG 5:13">Ñkpọkinua amọ eba nte mme lili</para>
  <para style="q2" vid="SNG 5:13">ake atọiyọ mee.<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />Mme ubọk amọ edo mme esañ kold</para>
  <para style="q2" vid="SNG 5:14">a-ayọhọke ye topas.</para>
  <para style="q1" vid="SNG 5:14">Idem amọ atie nte mmọnọ-mmọnọ nnʌkeniin</para>
  <para style="q2" vid="SNG 5:14">edatta nsọñudua itiad ebana.<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />Ukod amọ edo mme adaaha mabịd</para>
  <para style="q2" vid="SNG 5:15">e-eduwʌkkọ ke ataa eti kold.</para>
  <para style="q1" vid="SNG 5:15">Anye adiwuọ nda abit Lebanọn,</para>
  <para style="q2" vid="SNG 5:15">ayaiya nte mme sida amọ.<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />Inua amọ ado inịññe ke idem amọ;</para>
  <para style="q2" vid="SNG 5:16">anye ado uyai afịd-afịd.</para>
  <para style="q1" vid="SNG 5:16">Anye ami ado awoima mmi, anye ami ado ufan mmi,</para>
  <para style="q2" vid="SNG 5:16">nditọ ibaan Yeruselem.<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">Mme Ufan</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />Uke ke awoima mfo aka,</para>
  <para style="q2" vid="SNG 6:1">ñyaiyañkan ke atu mme ibaan?</para>
  <para style="q1" vid="SNG 6:1">Usʌñ uke ke awoima mfo akekanna adʌk,</para>
  <para style="q2" vid="SNG 6:1">yak ñnyịn ikpukeene fiin iyem anye?<verse eid="SNG 6:1" /></para>
  <para style="sp">Awonwaan</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2" />Awoima mmi amaasọiyọ akaa inwañ amọ,</para>
  <para style="q2" vid="SNG 6:2">ke mme ikʌknnaa nneem ufịk ñkpadia amọ,</para>
  <para style="q1" vid="SNG 6:2">adikisaaña nseet mme inwañ</para>
  <para style="q2" vid="SNG 6:2">ñnyʌñ ñkịppe mme lili.<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />Ami ndo ake awoima mmi awoima mmi anyʌñ ado ake mmi;</para>
  <para style="q2" vid="SNG 6:3">anye asaaña aseet ke atu mme lili.<verse eid="SNG 6:3" /></para>
  <para style="sp">Awodeen</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4" />Afo ameyaiya ukem-ukem nte Tiasa, edima mmi,</para>
  <para style="q2" vid="SNG 6:4">anyʌñ ayaiya nte Yeruselem,</para>
  <para style="q2" vid="SNG 6:4">amenie uteeñe nte mbon ekọñ e-ekamake mme afọñidiọọñọ.<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />Kunse ke anyen mfo;</para>
  <para style="q2" vid="SNG 6:5">sia ammọ emfoofuuk miin.</para>
  <para style="q1" vid="SNG 6:5">Ided mfo abit udịm ebod</para>
  <para style="q2" vid="SNG 6:5">e-esọiyọke eto Kilied.<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />Eded mfo aba nte udịm edọñ</para>
  <para style="q2" vid="SNG 6:6">ewuọñọke ke itie uyieidem edi.</para>
  <para style="q1" vid="SNG 6:6">Ammọ keedekeed enie amanamba,</para>
  <para style="q2" vid="SNG 6:6">ibaaha ndomokeed ke atu ammọ a-asoppo usʌñ.<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />Akpọiso mfo ke esịd ufʌkiso mfo</para>
  <para style="q2" vid="SNG 6:7">aba nte mbakka iba pomekrened.<verse eid="SNG 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />Akpekọm akpedo mbọọñibaan ata,</para>
  <para style="q2" vid="SNG 6:8">ye ibaan esa anaañ,</para>
  <para style="q2" vid="SNG 6:8">ye ananaibad ibaan ammiisappake idem;<verse eid="SNG 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9" />ado ibiom mmi, anana ndo mmi, ado asaña-asaña,</para>
  <para style="q2" vid="SNG 6:9">ukweeñe ayịn awonwaan e-eka amọ anieghe,</para>
  <para style="q2" vid="SNG 6:9">anye andikiman amaaha akan.</para>
  <para style="q1" vid="SNG 6:9">Ubọikpa emaekịt anye enyʌñ ekoot anye adidiọñ;</para>
  <para style="q2" vid="SNG 6:9">mbọọñibaan ye ibaan esa emaetooro anye.<verse eid="SNG 6:9" /></para>
  <para style="sp">Mme Ufan</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />Anie awo ido ami a-awuọhọ nte usiere,</para>
  <para style="q2" vid="SNG 6:10">asana nte afiọñ, ayamma nte utịn,</para>
  <para style="q2" vid="SNG 6:10">anie uku nte mme ntantaafiọñ e-esañake ke udịm?<verse eid="SNG 6:10" /></para>
  <para style="sp">Awodeen</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />Ami mmaasọiyọ ñkaa inwañ mme eto ekọm</para>
  <para style="q2" vid="SNG 6:11">adikise ufa sikọd ke abedeñ,</para>
  <para style="q1" vid="SNG 6:11">adise me mme fain emaesio emịne</para>
  <para style="q2" vid="SNG 6:11">me mme pomekrened emaesịññe ñkpokpoñ.<verse eid="SNG 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12" />Mbemiso ami ndiọọñọ,</para>
  <para style="q2" vid="SNG 6:12">udọñ mmi amamben miin asịn ke atu mme sariọd mbọọñ mbon mmi.<verse eid="SNG 6:12" /></para>
  <para style="sp">Mme Ufan</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13" />Tịmme di, tịmme di, O awo Sulam;</para>
  <para style="q2" vid="SNG 6:13">tịmme di, tịmme di, yak ñnyịn inekke use fiin!</para>
  <para style="sp" vid="SNG 6:13">Awodeen</para>
  <para style="q1" vid="SNG 6:13">Ntak a-ndufo eyemme adinekke nse awo Sulam</para>
  <para style="q2" vid="SNG 6:13">nte ese unek ake mme Mahanaim?<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Ke ikpañwed Hibru ufañ ami Is 6:13 ewet nte Is 7:1. </char></note><verse eid="SNG 6:13" /></para>
  <para style="b" />
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="q1">
    <note caller="+" style="f">
      <char style="fr" closed="false">7: </char>
      <char style="ft" closed="false">Ke ikpañwed Hibru Is 7:1-13 ewet nte Is 7:2-14.</char>
    </note> <verse number="1" style="v" sid="SNG 7:1" />Ukod mfo ke ikpaukod ayaiya eti-eti,</para>
  <para style="q2" vid="SNG 7:1">O adiaha abọọñ!</para>
  <para style="q1" vid="SNG 7:1">Mfọọn ukod mfo eba nte ñkpọ mbanaidem,</para>
  <para style="q2" vid="SNG 7:1">ubọkutom anam utomusọ.<verse eid="SNG 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2" />Akob mfo ado ikara-ikara iko ukọd</para>
  <para style="q2" vid="SNG 7:2">i-imiinanake uwawaak ukọd.</para>
  <para style="q1" vid="SNG 7:2">Itakisịn mfo ado ebono utọ abakpa</para>
  <para style="q2" vid="SNG 7:2">e-edatta lili etọ akọ ekanna.<verse eid="SNG 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3" />Eba mfo etie nte nditọ edob iba,</para>
  <para style="q2" vid="SNG 7:3">ebit amanamba nditọ edob.<verse eid="SNG 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4" />Itọñ mfo aba nte tọwa nnʌkeniin.</para>
  <para style="q1" vid="SNG 7:4">Anyen mfo ado ñkpọdiọhọ mmọọñ Hesbọn</para>
  <para style="q2" vid="SNG 7:4">a-abaaha akpere inuaatob Bad Rabim.</para>
  <para style="q1" vid="SNG 7:4">Akpọiwuo mfo aba nte tọwa Lebanọn</para>
  <para style="q2" vid="SNG 7:4">a-aseeghe Damaskọs.<verse eid="SNG 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5" />Iwuod mfo uyat fiin anyanya nte Abod Kamel.</para>
  <para style="q2" vid="SNG 7:5">Ided iwuod mfo aba nte udọdọk afọñ ubọọñ;</para>
  <para style="q2" vid="SNG 7:5">anyan uwawañ ided mfo asịn adidem ukad.<verse eid="SNG 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6" />Afo ameyaiya anyʌñ annọ miin inemesịd,</para>
  <para style="q2" vid="SNG 7:6">ima mmi, ye ñkpọ idadesịd mfo.<verse eid="SNG 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7" />Anyan idaha mfo aba nte ayob,</para>
  <para style="q2" vid="SNG 7:7">eba mfo ñko ebit eboho mfịd.<verse eid="SNG 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8" />Ami mmaabo, “Ami ñyaadọọk ekpad ayob;</para>
  <para style="q2" vid="SNG 7:8">Ami ñyaakịppe mfịd amọ.”</para>
  <para style="q1" vid="SNG 7:8">Yak eba mfo aba nte eboho kreb ke idem fain,</para>
  <para style="q2" vid="SNG 7:8">inem ufịk inua mfo atie nte mme apịl,<verse eid="SNG 7:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="SNG 7:9" />inua mfo ñko aba nte ukọd anịññeke akan.</para>
  <para style="sp" vid="SNG 7:9">Awonwaan</para>
  <para style="q1" vid="SNG 7:9">Ukọd ami akpekap akaa nnen-nnen abịne awoima mmi,</para>
  <para style="q2" vid="SNG 7:9">awere sʌñ-sʌñ asaaña ke ñkpọkinua ye eded.<verse eid="SNG 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10" />Ami ndo ake awoima mmi,</para>
  <para style="q2" vid="SNG 7:10">anye anie udọñ annọ miin.<verse eid="SNG 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11" />Di, awoima mmi, yak ñnyịn ika ke abioinwañ,</para>
  <para style="q2" vid="SNG 7:11">yak ñnyịn ikina ke mme esịdidʌñ ke akonayio.<verse eid="SNG 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12" />Yak ñnyịn ibak ika inwañ fain</para>
  <para style="q2" vid="SNG 7:12">ikise me mme fain emaesio emịne,</para>
  <para style="q1" vid="SNG 7:12">me ñkpokpoñ ammọ etaara,</para>
  <para style="q2" vid="SNG 7:12">ñko me pomekrened enyʌñ esio ñkpokpoñ;</para>
  <para style="q2" vid="SNG 7:12">ke itie ado ami ñyaunọ fiin ima mmi.<verse eid="SNG 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13" />Mme mandrek esioño inemufịk ammọ,</para>
  <para style="q2" vid="SNG 7:13">afịd inem ndidia ebono ke inuausʌñ ñnyịn,</para>
  <para style="q1" vid="SNG 7:13">ufa ye akaan</para>
  <para style="q2" vid="SNG 7:13">ake ami ñkekoonoke mbono unọọ fiin, awoima mmi.<verse eid="SNG 7:13" /></para>
  <para style="b" />
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1" />Akpekapado afo akeba nte ayịneka awodeen annọ miin,</para>
  <para style="q2" vid="SNG 8:1">e-ekekamake ke eba esịd eka mmi!</para>
  <para style="q1" vid="SNG 8:1">Ndin, ami ñkpukịt fiin ke esiin,</para>
  <para style="q2" vid="SNG 8:1">ami ñkpautʌm fiin inua,</para>
  <para style="q2" vid="SNG 8:1">ndin awo ndomokeed ikpinseghe miin ke ndek.<verse eid="SNG 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2" />Ami ñkpaudat fiin usʌñ</para>
  <para style="q2" vid="SNG 8:2">ñnyʌñ uben fiin ndʌk ufọk eka mmi,</para>
  <para style="q2" vid="SNG 8:2">anye a-akeñkpeebe miin.</para>
  <para style="q1" vid="SNG 8:2">Ami ñkpaunọ fiin ñwuaha ukọd nọ anwọñ,</para>
  <para style="q2" vid="SNG 8:2">inem mmọọñ mme pomekrened mmi.<verse eid="SNG 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3" />Ubọk ufiin amọ asịne ke idak iwuod mmi</para>
  <para style="q2" vid="SNG 8:3">ubọk nnasia amọ anyʌñ amfat miin.<verse eid="SNG 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4" />Nditọ ibaan Yeruselem, ami mmiwuuk ndufo nte</para>
  <para style="q2" vid="SNG 8:4">Ikiitịmede ikiinyʌñ idemme ima</para>
  <para style="q2" vid="SNG 8:4">tutu anye anie udọñ.<verse eid="SNG 8:4" /></para>
  <para style="sp">Mme Ufan</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5" />Anie ado ami a-atooho anaan awuọ adi</para>
  <para style="q2" vid="SNG 8:5">a-abereke awoima amọ ke idem?</para>
  <para style="sp" vid="SNG 8:5">Awonwaan</para>
  <para style="q1" vid="SNG 8:5">Ke idak eto apịl ke ami ñkudịppe fiin udọñ;</para>
  <para style="q2" vid="SNG 8:5">do ke eka mfo akuyommo fiin,</para>
  <para style="q2" vid="SNG 8:5">do ke anye ake uman aketuuho akuman fiin.<verse eid="SNG 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6" />Nnịm miin nte ufiikñkpọ idiọọñọ ke esịd mfo,</para>
  <para style="q2" vid="SNG 8:6">nte ufiikñkpọ idiọọñọ ke ubọk mfo;</para>
  <para style="q1" vid="SNG 8:6">sia ima asọñ adudu nte ñkpa,</para>
  <para style="q2" vid="SNG 8:6">ufịb amọ asọñ ubọk nte udi.</para>
  <para style="q1" vid="SNG 8:6">Anye asak nte ekamba ikañ,</para>
  <para style="q2" vid="SNG 8:6">nte ataa ekamba edemeikañ.<verse eid="SNG 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7" />Uwak mmọọñ ikanna inịme ima;</para>
  <para style="q2" vid="SNG 8:7">Mme inyañ ikanna ikwọọk anye iduọọk.</para>
  <para style="q1" vid="SNG 8:7">Adieke awo akpenọọhọ</para>
  <para style="q2" vid="SNG 8:7">afịd inie ke ufọk amọ ke ntak ima,</para>
  <para style="q2" vid="SNG 8:7">ekpeneenekke esịn anye ke ata ndek.<verse eid="SNG 8:7" /></para>
  <para style="sp">Mme Ufan</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8" />Ñnyịn iminie etək ayịneka awonwaan,</para>
  <para style="q2" vid="SNG 8:8">ndin eba amọ ikpoono ikem kaña.</para>
  <para style="q1" vid="SNG 8:8">Nsoo ke ñnyịn idiinam inọ ayịneka ñnyịn awonwaan</para>
  <para style="q2" vid="SNG 8:8">ke usen e-eyemme aditañ ikọ ndọ ibaña anye?<verse eid="SNG 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9" />Adieke anye adooho ndibene,</para>
  <para style="q2" vid="SNG 8:9">ñnyịn iyaibọp mme tọwa silfa inọ anye.</para>
  <para style="q1" vid="SNG 8:9">Adieke anye adooho usʌñ</para>
  <para style="q2" vid="SNG 8:9">ñnyịn iyaidat adukpọk sida ikọñ isịn anye.<verse eid="SNG 8:9" /></para>
  <para style="sp">Awonwaan</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10" />Ami ndo ndibene,</para>
  <para style="q2" vid="SNG 8:10">eba mmi ñko etie nte mme tọwa.</para>
  <para style="q1" vid="SNG 8:10">Ke ntoro ami mmekappa ndo ke anyen amọ</para>
  <para style="q2" vid="SNG 8:10">nte awo a-adatta uyʌkkọ adi.<verse eid="SNG 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11" />Sọlọmọn amaanie inwañ fain ke Baal Hamọn;</para>
  <para style="q2" vid="SNG 8:11">anye amaayaak inwañ fain amọ anọ mme adidʌñ.</para>
  <para style="q1" vid="SNG 8:11">Ammọ keedekeed akena edat se ito mfịdinwañ edi</para>
  <para style="q2" vid="SNG 8:11">sekel silfa tọsịn keed<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">A-adooho ñkpọ nte kilokram 12; ñko se ke Is 8:12.</char></note>.<verse eid="SNG 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12" />Ado inwañ fain mmi ana annọ miin adinọ;</para>
  <para style="q2" vid="SNG 8:12">sekel silfa tọsịn keed edo ake mfo, Sọlọmọn,</para>
  <para style="q2" vid="SNG 8:12">ndin ikie iba<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false">A-adooho ñkpọ nte kilokram 2.3.</char></note> anie mbon ekekpemeke mfịd ke inwañ.<verse eid="SNG 8:12" /></para>
  <para style="sp">Awodeen</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13" />Afo a-adʌññọ ke mme inwañ</para>
  <para style="q2" vid="SNG 8:13">ye mme ufan mfo ke isañ,</para>
  <para style="q2" vid="SNG 8:13">yak ami ñkop uyio mfo!<verse eid="SNG 8:13" /></para>
  <para style="sp">Awonwaan</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14" />Dakka di, awoima mmi,</para>
  <para style="q2" vid="SNG 8:14">nyʌñ ba nte edob</para>
  <para style="q1" vid="SNG 8:14">imiidooho ba nte nsek ebed</para>
  <para style="q2" vid="SNG 8:14">ke abod a-ayọhọke ye ñkpadia.<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>