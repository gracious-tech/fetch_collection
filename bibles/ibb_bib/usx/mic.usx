  <para style="h">Maika</para>
  <para style="toc1">Maika</para>
  <para style="toc2">Maika</para>
  <para style="toc3">Mai</para>
  <para style="mt1">Maika</para>
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />Ikọ <char style="nd">Abọọñ</char> a-akesịmme Maika awo Moresed ke ini ukara Yọtam, Ahas ye Hesikaiya, mme ndidem Yuda, ñkukịd a-anye akekịtte abaña Sameria ye Yeruselem ado ami:<verse eid="MIC 1:1" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2" />Ikop, ndufo mbon awo, afịd ndufo,</para>
  <para style="q2" vid="MIC 1:2">ikpañ utọñ, isọñ ye afịd se idʌñ ke esịd,</para>
  <para style="q1" vid="MIC 1:2">nọ <char style="nd">Abọọñ</char> Andikara ado ntiense ibaña ndufo,</para>
  <para style="q2" vid="MIC 1:2">
    <char style="nd">Abọọñ</char> atie ke adisana tembịd amọ.<verse eid="MIC 1:2" /></para>
  <para style="s1">Ubiereikpe Nnọọ Sameria ye Yeruselem</para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3" />Se! <char style="nd">Abọọñ</char> asʌk ato itieidʌñ amọ adi;</para>
  <para style="q2" vid="MIC 1:3">anye asọiyọ adi, anyʌñ asaña ke mme ñkoñ-ñkoñ itie ke ederimbod.<verse eid="MIC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4" />Mme ikpọabod eyeeme ke idak amọ,</para>
  <para style="q2" vid="MIC 1:4">mme abedeñ ñko esakka</para>
  <para style="q1" vid="MIC 1:4">nte akpọ atara ke ikañ,</para>
  <para style="q2" vid="MIC 1:4">nte mmọọñ atop awere atịkke abod.<verse eid="MIC 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5" />Afịd ami ato idiọọkñkpọ Yekọb,</para>
  <para style="q2" vid="MIC 1:5">ke ntak mme ndudue nditọ Isrel.</para>
  <para style="q1" vid="MIC 1:5">Nsoo ido idiọọkñkpọ Yekọb?</para>
  <para style="q2" vid="MIC 1:5">Idooho Sameria?</para>
  <para style="q1" vid="MIC 1:5">Nsoo ido ñkoñ-ñkoñ itie Yuda?</para>
  <para style="q2" vid="MIC 1:5">Idooho Yeruselem?<verse eid="MIC 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6" />“Ke ntak ado ami ñyaanam Sameria ado itoon mbio,</para>
  <para style="q2" vid="MIC 1:6">itie se etọ mme inwañ fain.</para>
  <para style="q1" vid="MIC 1:6">Ñyaaduọñọ mme itiad amọ ke abedeñ,</para>
  <para style="q2" vid="MIC 1:6">ñnyʌñ mfʌkkọ ifed idakisọñ amọ.<verse eid="MIC 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7" />Eyaeboom afịd mme ubobodñkpọ amọ mbai-mbai;</para>
  <para style="q2" vid="MIC 1:7">eyaefọp afịd mme enọ ke tembịd amọ ke ikañ;</para>
  <para style="q2" vid="MIC 1:7">ami ñyaasobo afịd mme ubobodñkpọ amọ.</para>
  <para style="q1" vid="MIC 1:7">Sia anye akekọọhọ mme enọ amọ ato utịb mme akpara,</para>
  <para style="q2" vid="MIC 1:7">ediisʌk ikama ammọ nte utịb mme akpara.”<verse eid="MIC 1:7" /></para>
  <para style="s1">Ntuaña ye Mfʌhọ</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8" />Ke ntak ami, ami ñyaatua ñnyʌñ nsio ñkpo;</para>
  <para style="q2" vid="MIC 1:8">ñyaasaña ukod ñkaña ñnyʌñ nsaña ifed.</para>
  <para style="q1" vid="MIC 1:8">Ñyaabọọñ ñkpo nte ewaikọd</para>
  <para style="q2" vid="MIC 1:8">ñnyʌñ ñyommo nte ñkịdikịd.<verse eid="MIC 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9" />Sia udọñọ nsobo Sameria inieghe ukọk;</para>
  <para style="q2" vid="MIC 1:9">atara akewuọ Yuda.</para>
  <para style="q1" vid="MIC 1:9">Akewuọ ataa inuaatob ikọd mmi,</para>
  <para style="q2" vid="MIC 1:9">awuọ kpa Yeruselem.<verse eid="MIC 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10" />Kuutañ ke Kad;</para>
  <para style="q2" vid="MIC 1:10">kuutua ayịd ndomokeed.</para>
  <para style="q1" vid="MIC 1:10">Ke Bed Opra</para>
  <para style="q2" vid="MIC 1:10">were ke ntọñ.<verse eid="MIC 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11" />Saña boiyo ifed ye ke abuud,</para>
  <para style="q2" vid="MIC 1:11">ndufo se edʌñọ ke Safia.</para>
  <para style="q1" vid="MIC 1:11">Mbon se idʌñọ ke Saanan</para>
  <para style="q2" vid="MIC 1:11">idiiwuọhọ idi.</para>
  <para style="q1" vid="MIC 1:11">Bed Esel aba ke mfʌhọ;</para>
  <para style="q2" vid="MIC 1:11">anye ukpemeke fiin aba.<verse eid="MIC 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12" />Mbon e-edʌññọ ke Marod enwịne ke ubiak,</para>
  <para style="q2" vid="MIC 1:12">etie ebet unwam,</para>
  <para style="q1" vid="MIC 1:12">sia afanekọñ a-ato <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="MIC 1:12">akewuọ kpa inuaatob Yeruselem.<verse eid="MIC 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13" />Ndufo se edʌñọ ke Lakis,</para>
  <para style="q2" vid="MIC 1:13">iyịt mme enañmbakara se isọp itọk ke sariọd.</para>
  <para style="q1" vid="MIC 1:13">Ndufo eba ke itie nte idiọọkñkpọ Adiaha Saiyọn aketọọñọ,</para>
  <para style="q2" vid="MIC 1:13">sia ekekịt mme ndudue Isrel ke idem ndufo.<verse eid="MIC 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14" />Ke ntoro ndufo eyaenọ mme enọ udiañña nsaña</para>
  <para style="q2" vid="MIC 1:14">esọk Moresed Kad.</para>
  <para style="q1" vid="MIC 1:14">Abio Aksịb adiido abiaña</para>
  <para style="q2" vid="MIC 1:14">anọ ndidem Isrel.<verse eid="MIC 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15" />Ñyaaben andidiikan ibịne ndufo</para>
  <para style="q2" vid="MIC 1:15">e-edʌññọ ke Maresa.</para>
  <para style="q1" vid="MIC 1:15">Mme ñkpisọñ Isrel</para>
  <para style="q2" vid="MIC 1:15">eyaefeeñe ekaa Adulam.<verse eid="MIC 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16" />Ikwat ided ndufo ke mfʌhọ,</para>
  <para style="q2" vid="MIC 1:16">inọ nditọ a-ndufo edatta esịd ebaña;</para>
  <para style="q1" vid="MIC 1:16">inam idem ndufo enie ebọ nte utere,</para>
  <para style="q2" vid="MIC 1:16">sia eyaekoono ammọ ekaa asen idịd.<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="s1">Uduak Awo ye Uduak Abasi</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1" />Adọdiọọk anọ mbon e-eduakka idiọọkñkpọ,</para>
  <para style="q2" vid="MIC 2:1">anọ mbon e-enaaha ke ikʌk ammọ eduak idiọọkñkpọ!</para>
  <para style="q1" vid="MIC 2:1">Ayio amaasiere, ammọ eben esịn ke adinam,</para>
  <para style="q2" vid="MIC 2:1">sia ammọ e-enie ukeme adinam ntoro.<verse eid="MIC 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2" />Ammọ esịn anyen ke mme inwañ enyʌñ edat enie,</para>
  <para style="q2" vid="MIC 2:2">ye ke mme ufọk, enyʌñ edat.</para>
  <para style="q1" vid="MIC 2:2">Ebọ mbon awo ufọk ammọ ke ñwo,</para>
  <para style="q2" vid="MIC 2:2">eyịp udeeme mbon awo.<verse eid="MIC 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3" />Ke ntoro, <char style="nd">Abọọñ</char> abo:</para>
  <para style="q1" vid="MIC 2:3">“Ami nsʌk nduak afanekọñ nnọ ibon ami,</para>
  <para style="q2" vid="MIC 2:3">a-adooho ndufo idiikanna ifak idem ndufo isio.</para>
  <para style="q1" vid="MIC 2:3">Ndufo idiikanna isaña aba asian-asian,</para>
  <para style="q2" vid="MIC 2:3">sia adiido ini nnananyen.<verse eid="MIC 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4" />Ke usen ado mbon awo eyainọ ndufo ñnyọọ;</para>
  <para style="q2" vid="MIC 2:4">ammọ eyaenyʌñ isoon ndufo ye ikwọ mfʌhọ ami ete:</para>
  <para style="q1" vid="MIC 2:4">‘Ñnyịn imitak ataa afịd-afịd;</para>
  <para style="q2" vid="MIC 2:4">e-ebakka udeeme mbon mmi.</para>
  <para style="q1" vid="MIC 2:4">Anye ambọ miin!</para>
  <para style="q2" vid="MIC 2:4">Anye a-aben mme inwañ ñnyịn anọ mbon i-itappa ñnyịn.’ ”<verse eid="MIC 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5" />Ke ntoro ndufo idiinieghe awo ndomokeed ke mbono <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="MIC 2:5">a-adiisịn ukañ ideeme isọñ ado.<verse eid="MIC 2:5" /></para>
  <para style="s1">Mme Prọfed Abiaña</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6" />Mme prọfed ammọ ete, “Kuutañ ñkukịd,</para>
  <para style="q2" vid="MIC 2:6">kuutañ ñkukịd ubaña mme ñkpọ ami;</para>
  <para style="q2" vid="MIC 2:6">ñnyịn idiidiaha asuenne.”<verse eid="MIC 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7" />Ndufo mme ubon Yekọb, me ekpa ebo,</para>
  <para style="q2" vid="MIC 2:7">“Abọọñ inieghe ime?</para>
  <para style="q2" vid="MIC 2:7">Anye akpaanam mme utọ ñkpọ ado?”</para>
  <para style="b" vid="MIC 2:7" />
  <para style="q1" vid="MIC 2:7">“Ado nte ikọ mmi inamma ufọn</para>
  <para style="q2" vid="MIC 2:7">inọ awo u-usʌñ amọ adooho nnen-nnen?<verse eid="MIC 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8" />Ke mmi-mmi, mbon mmi e-edaaña eda</para>
  <para style="q2" vid="MIC 2:8">nte mbon usua.</para>
  <para style="q1" vid="MIC 2:8">Ndufo emesịññe mme nsọñudua afọñ</para>
  <para style="q2" vid="MIC 2:8">ke idem mbon e-esañake eboiyo, ndin idọññọ anyen,</para>
  <para style="q2" vid="MIC 2:8">nte ideen e-enyọñọke ekọñ.<verse eid="MIC 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9" />Ndufo emebịne ibaan mbon mmi</para>
  <para style="q2" vid="MIC 2:9">esịññe ke nti ufọk ammọ.</para>
  <para style="q1" vid="MIC 2:9">Ndufo emeben adidiọñ mmi</para>
  <para style="q2" vid="MIC 2:9">ekpọñ nditọ ammọ ke nsi-nsi.<verse eid="MIC 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10" />Idaaña ida, ikaiya!</para>
  <para style="q2" vid="MIC 2:10">Sia idooho itie nduọkadudu ndufo ado ami,</para>
  <para style="q1" vid="MIC 2:10">sia e-esappa anye,</para>
  <para style="q2" vid="MIC 2:10">e-esobo anye, ibaaha naña ekan enyaaña aba.<verse eid="MIC 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11" />Adieke asʌhọ nsu ye awo abiaña adiighe adibo,</para>
  <para style="q2" vid="MIC 2:11">‘Ami ñyaakịt ñkukịd uwak ukọd ye bie unọ fiin,’</para>
  <para style="q2" vid="MIC 2:11">utọ prọfed ado ke ibon ami eyem!<verse eid="MIC 2:11" /></para>
  <para style="s1">Enwọñọ Adinyaaña</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12" />“Yekọb, ke akpanikọ ami ñyaikoono ndufo mbok;</para>
  <para style="q2" vid="MIC 2:12">ke akpanikọ ñyaatañ nsʌhọ Isrel mbok.</para>
  <para style="q1" vid="MIC 2:12">Ñyaakoono ammọ mbok itie keed nte mme edọñ ke ufọkedọñ,</para>
  <para style="q2" vid="MIC 2:12">nte udịmedọñ ke itie ndidia amọ;</para>
  <para style="q2" vid="MIC 2:12">itie ado adiiyọhọ ye mme awo.<verse eid="MIC 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13" />Andisiak usʌñ ayaadat ammọ usʌñ;</para>
  <para style="q2" vid="MIC 2:13">ammọ eyaesiak akọ ewuọñọ.</para>
  <para style="q1" vid="MIC 2:13">Adidem ammọ ayaato aboiyo mbemiso ammọ,</para>
  <para style="q2" vid="MIC 2:13">
    <char style="nd">Abọọñ</char> ado adaiwuod ammọ.”<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="s1">Esua Enọ mme Adaiwuod ye mme Prọfed</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1" />Ndin ami mmaabo,</para>
  <para style="q1" vid="MIC 3:1">“Ikpañ utọñ, ndufo mme adaaha Yekọb,</para>
  <para style="q2" vid="MIC 3:1">ndufo mme mbọọñ Isrel.</para>
  <para style="q1" vid="MIC 3:1">Nte ndufo ikpiyemme unen,<verse eid="MIC 3:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="MIC 3:2" />ndufo e-esuaha eti ñkpọ ado e-ema idiọọkñkpọ;</para>
  <para style="q1" vid="MIC 3:2">ndufo mme ayaara ikpaidem nsio ke idem mbon mmi,</para>
  <para style="q2" vid="MIC 3:2">enyʌñ ekappa abʌk esio ke akpọ ammọ;<verse eid="MIC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3" />e-etaaha abʌk mbon mmi,</para>
  <para style="q2" vid="MIC 3:3">efọọrọ ikpaidem ammọ</para>
  <para style="q2" vid="MIC 3:3">enyʌñ eboom akpọ ammọ mbai-mbai;</para>
  <para style="q1" vid="MIC 3:3">e-ekpokko ammọ nte unam se esịn ke ako ufrañ ñkpọ,</para>
  <para style="q2" vid="MIC 3:3">nte abʌk se esịn ke ako?”<verse eid="MIC 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4" />Ndin ammọ eyaetua ekoot <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="MIC 3:4">ado anye idiibọọrọke ammọ.</para>
  <para style="q1" vid="MIC 3:4">Ke ini ado anye ayaadịp ammọ iso</para>
  <para style="q2" vid="MIC 3:4">ato ke idiọọkñkpọ se ammọ enam.<verse eid="MIC 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5" />Ntom ke <char style="nd">Abọọñ</char> atañ:</para>
  <para style="q1" vid="MIC 3:5">“Amaado mme prọfed</para>
  <para style="q2" vid="MIC 3:5">e-ebenne mbon mmi etịn usʌñ,</para>
  <para style="q1" vid="MIC 3:5">ammọ ekwọrọ ‘emem’</para>
  <para style="q2" vid="MIC 3:5">adieke ammọ enieghe ñkpọ se edia,</para>
  <para style="q1" vid="MIC 3:5">ado ebeeñe idem adinwana ekọñ ye awo akeedodo</para>
  <para style="q2" vid="MIC 3:5">a-asịnne adinọ ammọ se edia.<verse eid="MIC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6" />Ke ntoro akonayio ayaifʌk ndufo, mme ñkukịd idiibaaha,</para>
  <para style="q2" vid="MIC 3:6">ye ekịm, idiọñ ñko ibaaha.</para>
  <para style="q1" vid="MIC 3:6">Utịn ayaasuuhọ anọ mme aku,</para>
  <para style="q2" vid="MIC 3:6">ndin uweemeayio ayaakappa akịm anọ ammọ.<verse eid="MIC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7" />Mme akịdñkukịd eyaekop abuud,</para>
  <para style="q2" vid="MIC 3:7">eyaesuenne mme mbiaidiọñ.</para>
  <para style="q1" vid="MIC 3:7">Afịd ammọ eyaefʌk iso ammọ</para>
  <para style="q2" vid="MIC 3:7">sia ibọọrọ ibaaha ito Abasi.”<verse eid="MIC 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8" />Ado amaado ami, ami ñyọhọ ye adudu,</para>
  <para style="q2" vid="MIC 3:8">ye Sịbidịd <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="MIC 3:8">ye unen ye uko,</para>
  <para style="q1" vid="MIC 3:8">adidọkkọ Yekọb mme ndudue amọ,</para>
  <para style="q2" vid="MIC 3:8">ñnyʌñ ndọkkọ Isrel idiọọkñkpọ amọ.<verse eid="MIC 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9" />Ikop ami, ndufo mme adaaha Yekọb,</para>
  <para style="q2" vid="MIC 3:9">ndufo mme mbọọñ Isrel,</para>
  <para style="q1" vid="MIC 3:9">e-esuaha unen</para>
  <para style="q2" vid="MIC 3:9">enyʌñ ekwaañ afịd se inen;<verse eid="MIC 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10" />e-edatta iyiib ebọp Saiyọn,</para>
  <para style="q2" vid="MIC 3:10">enyʌñ ebọp Yeruselem ye ibak.<verse eid="MIC 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11" />Mme adaaha amọ ebọ ubọkedem ndin ekpe ikpe,</para>
  <para style="q2" vid="MIC 3:11">mme aku amọ enyʌñ ekpeep ñkpọ ke ekọmudua,</para>
  <para style="q2" vid="MIC 3:11">mme prọfed amọ ebre idiọñ ke akʌk.</para>
  <para style="q1" vid="MIC 3:11">Ado ammọ eyem unwam <char style="nd">Abọọñ</char> enyʌñ ebo,</para>
  <para style="q2" vid="MIC 3:11">“Ado nte <char style="nd">Abọọñ</char> ibaaha ke atu ñnyịn?</para>
  <para style="q2" vid="MIC 3:11">Afanekọñ ndomokeed idiisịmme ñnyịn.”<verse eid="MIC 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12" />Ke ntoro ke ntak mfo,</para>
  <para style="q2" vid="MIC 3:12">eyaekịm Saiyọn ekappa nte inwañ,</para>
  <para style="q1" vid="MIC 3:12">Yeruselem adiido itoon mbio,</para>
  <para style="q2" vid="MIC 3:12">mbid ayaakọt afʌk abod tembịd.<verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="s1">Abod <char style="nd">Abọọñ</char></para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1" />Ke mme akpatre usen</para>
  <para style="q1" vid="MIC 4:1">eyaewuuk ekamba abod tembịd <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="MIC 4:1">akoñ akan afịd mme ñkpoon abod;</para>
  <para style="q1" vid="MIC 4:1">eyaedịppe anye nọ akoñ akan mme ntək abod,</para>
  <para style="q2" vid="MIC 4:1">mbon awo eyaeyịre udịm ekaa do.<verse eid="MIC 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 4:2" />Uwak mme idịd eyaedi edibo,</para>
  <para style="q1" vid="MIC 4:2">“Idi, yak ñnyịn idọọk ika ekamba abod <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="MIC 4:2">ika tembịd Abasi Yekọb.</para>
  <para style="q1" vid="MIC 4:2">Anye ayaikpeep ñnyịn usʌñ amọ,</para>
  <para style="q2" vid="MIC 4:2">nọ ato do ñnyịn isaña ke mme usʌñ amọ.”</para>
  <para style="q1" vid="MIC 4:2">Mbed ayaato Saiyọn awuọ,</para>
  <para style="q2" vid="MIC 4:2">ikọ <char style="nd">Abọọñ</char> ayaawuọ ato Yeruselem.<verse eid="MIC 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3" />Anye ayaakpe ikpe anọ uwak mbon awo,</para>
  <para style="q2" vid="MIC 4:3">anyʌñ anam emem ke atu mme ñkpọsọñ idịd ke anyan usʌñ.</para>
  <para style="q1" vid="MIC 4:3">Ammọ eyaemia mme akañkañ ammọ nọ ekappa ñkpọ ukịmisọñ,</para>
  <para style="q2" vid="MIC 4:3">ye mme eduad ammọ nọ ekappa ekọb ukọññkpọ.</para>
  <para style="q1" vid="MIC 4:3">Mme idịd idiibenne akañkañ ibịne emọ-emọ idịd,</para>
  <para style="q2" vid="MIC 4:3">ammọ idiinyʌññọ ibọ ukpeeb ke naña enwana ekọñ aba.<verse eid="MIC 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4" />Adiido anie idak eto fain amọ atie,</para>
  <para style="q2" vid="MIC 4:4">anie idak eto fik amọ atie,</para>
  <para style="q1" vid="MIC 4:4">awo ndomokeed idiinamma ammọ efeghe ndịk,</para>
  <para style="q2" vid="MIC 4:4">sia <char style="nd">Abọọñ</char> Andikponñkan Abasi atañ.<verse eid="MIC 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5" />Afịd mme idịd ekeme isaña</para>
  <para style="q2" vid="MIC 4:5">ke anyịñ mme abasi ammọ,</para>
  <para style="q1" vid="MIC 4:5">ado ñnyịn idiisaña ke anyịñ <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="MIC 4:5">Abasi ñnyịn ke nsi-nsi nsi-nsi.<verse eid="MIC 4:5" /></para>
  <para style="s1">Uduak <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6" />
    <char style="nd">Abọọñ</char> abo ate, “Ke usen ado,</para>
  <para style="q2" vid="MIC 4:6">ami ñyaakoono mme mbʌñọ;</para>
  <para style="q1" vid="MIC 4:6">ñyaakoono mbon ntañmfeb mbok,</para>
  <para style="q2" vid="MIC 4:6">ye mbon a-ami nnọọhọ mfiomo.<verse eid="MIC 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7" />Ñyaanam mme mbʌñọ edo mme nsʌhọ mmi,</para>
  <para style="q2" vid="MIC 4:7">mbon ebịneke esio ekappa edo akpọsọñ idịd.</para>
  <para style="q1" vid="MIC 4:7">
    <char style="nd">Abọọñ</char> ayaakaara ammọ ke Abod Saiyọn</para>
  <para style="q2" vid="MIC 4:7">tọọñọ ke usen ado tutu ke nsi-nsi.<verse eid="MIC 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8" />Amaado afo, ufọkanyọñ ukpeme udịmedọñ,</para>
  <para style="q2" vid="MIC 4:8">akpọsọñ itie Adiaha Saiyọn,</para>
  <para style="q1" vid="MIC 4:8">eyaemaana eyaak ukara unọ;</para>
  <para style="q2" vid="MIC 4:8">adidem ayaamaana abịne Adiaha Yeruselem.”<verse eid="MIC 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9" />Nsoo ido nọ ndufo etua enyʌñ esio ñkpo idahami,</para>
  <para style="q2" vid="MIC 4:9">nte ndufo inieghe adidem?</para>
  <para style="q1" vid="MIC 4:9">Ado nte adaukara ndufo asobo,</para>
  <para style="q2" vid="MIC 4:9">nọ ubiak imʌm ndufo nte awonwaan a-abaaha ke ubiakuman?<verse eid="MIC 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10" />Adiaha Saiyọn, naa nwịne ke ubiak,</para>
  <para style="q2" vid="MIC 4:10">nte awonwaan a-abaaha ke ubiakuman,</para>
  <para style="q1" vid="MIC 4:10">idahami ana afo akpọñ abio</para>
  <para style="q2" vid="MIC 4:10">akena ke anwa esiin.</para>
  <para style="q1" vid="MIC 4:10">Afo ayaakaa Babilọn;</para>
  <para style="q2" vid="MIC 4:10">eyaekunyaaña ke udo.</para>
  <para style="q1" vid="MIC 4:10">Do ke <char style="nd">Abọọñ</char> aduufak fiin</para>
  <para style="q2" vid="MIC 4:10">isio ke ubọk mme asua mfo.<verse eid="MIC 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11" />Ado idahami uwak mme idịd</para>
  <para style="q2" vid="MIC 4:11">ediana keed edi ikọ ye afo.</para>
  <para style="q1" vid="MIC 4:11">Ammọ ete, “Yak esappa anye,</para>
  <para style="q2" vid="MIC 4:11">yak anyen ñnyịn eduọi Saiyọn!”<verse eid="MIC 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12" />Ado ammọ idiọọñọke</para>
  <para style="q2" vid="MIC 4:12">akikere <char style="nd">Abọọñ</char>;</para>
  <para style="q1" vid="MIC 4:12">uduak amọ inwañake ammọ,</para>
  <para style="q2" vid="MIC 4:12">ke anye awoppo ammọ nte mfañ abakpa akaa afe ubeek abakpa.<verse eid="MIC 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13" />“Dakka da nyʌñ kọk ñkpọ, Adiaha Saiyọn,</para>
  <para style="q2" vid="MIC 4:13">sia ami ñyaunọ nnʌk ukwak;</para>
  <para style="q1" vid="MIC 4:13">ñyaunọ ukodenañ brọns,</para>
  <para style="q2" vid="MIC 4:13">ndin afo ayaaboom uwak mme idịd ñkeñe-ñkeñe.”</para>
  <para style="q1" vid="MIC 4:13">Afo ayaakpọñ mme ndiọi inie ammọ anọ <char style="nd">Abọọñ</char> asaña-asaña,</para>
  <para style="q2" vid="MIC 4:13">e-ekpọñ inie ammọ enọ <char style="nd">Abọọñ</char> afịd ederimbod.<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="s1">Adaukara Ekenwọñọke Eto Betlehem</para>
  <para style="q1">
    <note caller="+" style="f">
      <char style="fr" closed="false">5: </char>
      <char style="ft" closed="false">Ke mme ikpañwed Hibru ewet Mai 5:1 nte Mai 4:14, ñko Mai 5:2-15 nte Mai 5:1-14.</char>
    </note> <verse number="1" style="v" sid="MIC 5:1" />Ikoot udịmekọñ ndufo idahami, abio mbon udịmekọñ,</para>
  <para style="q2" vid="MIC 5:1">sia e-enam nnaaekọñ ikanna ñnyịn ekʌk.</para>
  <para style="q1" vid="MIC 5:1">Ammọ eyaemia adaiwuod Isrel</para>
  <para style="q2" vid="MIC 5:1">ufia ke mbañ ye esañ.<verse eid="MIC 5:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2" />“Ado afo, Betlehem Efrata,</para>
  <para style="q2" vid="MIC 5:2">akpesʌkado a-afo adooho etək ke atu mme ubon ke Yuda,</para>
  <para style="q1" vid="MIC 5:2">ayaato ke afo</para>
  <para style="q2" vid="MIC 5:2">awo ayaawuọ annọ miin a-adiikara Isrel,</para>
  <para style="q1" vid="MIC 5:2">ntịppe amọ ato ke esed,</para>
  <para style="q2" vid="MIC 5:2">tọọñọ ke ayio esed.”<verse eid="MIC 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3" />Ke ntoro eyaefeghe ekpọñ Isrel,</para>
  <para style="q2" vid="MIC 5:3">tutu akem idaha andiba ke uman amanna ayịn,</para>
  <para style="q1" vid="MIC 5:3">ndin nditọeka amọ ideen enyọñ edi</para>
  <para style="q2" vid="MIC 5:3">edidiana ye mbon Isrel.<verse eid="MIC 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4" />Anye ayaada akpeme udịmedọñ amọ</para>
  <para style="q2" vid="MIC 5:4">ke adudu <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="MIC 5:4">ke uteeñe anyịñ <char style="nd">Abọọñ</char> Abasi amọ.</para>
  <para style="q1" vid="MIC 5:4">Ndin ammọ eyaedʌñ ke ifuuro, sia uku amọ</para>
  <para style="q2" vid="MIC 5:4">ayaawuọ utịd ederimbod.<verse eid="MIC 5:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5" />Ndin anye adiido emem ñnyịn,</para>
  <para style="q2" vid="MIC 5:5">ke ini mbon Asiria emaedʌk isọñ ñnyịn,</para>
  <para style="q2" vid="MIC 5:5">enyʌñ esaña edọñọ mme akpọsọñ itie udịbe ñnyịn.</para>
  <para style="q1" vid="MIC 5:5">Ñnyịn idiibịne ammọ ye mme akpemeedọñ itiaba,</para>
  <para style="q2" vid="MIC 5:5">ye mme adaiso ekọñ itiaita,<verse eid="MIC 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6" />e-ediikara isọñ Asiria ye akañkañ,</para>
  <para style="q2" vid="MIC 5:6">isọñ Nimrọd ye akañkañ e-edʌttọ esio ke efọk ke mbeeñeidem ekọñ.</para>
  <para style="q1" vid="MIC 5:6">Anye ayainyaaña ñnyịn asio ke ubọk mbon Asiria,</para>
  <para style="q2" vid="MIC 5:6">ammọ emaedidʌk isọñ ñnyịn</para>
  <para style="q2" vid="MIC 5:6">inyʌñ isaña ikaaña mme adaña ñnyịn.<verse eid="MIC 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7" />Ñyọhọnsʌhọ Yekọb adiisịne</para>
  <para style="q2" vid="MIC 5:7">ke atu mme uwak awo</para>
  <para style="q1" vid="MIC 5:7">nte mbara a-atooho <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="MIC 5:7">nte edịm a-afiada ke mbid,</para>
  <para style="q1" vid="MIC 5:7">a-adooho idaaha ibet awo ndomokeed,</para>
  <para style="q2" vid="MIC 5:7">inyʌññọ idodanyen ke awo.<verse eid="MIC 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8" />Ñyọhọnsʌhọ Yekọb ayaasịne ke atu mme idịd,</para>
  <para style="q2" vid="MIC 5:8">ke atu uwak mbon awo,</para>
  <para style="q1" vid="MIC 5:8">nte ekpe ke atu ndiọi unam ke akai,</para>
  <para style="q2" vid="MIC 5:8">nte ñyịn ekpe ke atu udịmedọñ,</para>
  <para style="q1" vid="MIC 5:8">a-adooho naña asaña akaa asʌk awot ata,</para>
  <para style="q2" vid="MIC 5:8">ndin awo ndomokeed ikanna ifak isio.<verse eid="MIC 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9" />Eyaedịppe ubọk edikan mfo ewọt mme asua mfo,</para>
  <para style="q2" vid="MIC 5:9">ndin eyaesobo afịd mbon usua mfo.<verse eid="MIC 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10" />“Ke usen ado, <char style="nd">Abọọñ</char> ate,</para>
  <para style="q1" vid="MIC 5:10">“Ami ñyaasobo mme enañmbakara ndufo ke atu ndufo,</para>
  <para style="q2" vid="MIC 5:10">ñnyʌñ ñwuut mme sariọd ndufo.<verse eid="MIC 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11" />Ami ñyaasobo mme abio ke isọñ ndufo,</para>
  <para style="q2" vid="MIC 5:11">ñnyʌñ ñwuut mme ñkpọsọñ itie ndufo.<verse eid="MIC 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12" />Ami ñyaasobo mme ifọd ndufo,</para>
  <para style="q2" vid="MIC 5:12">ndin ndufo idiikanna iwuọ ifọd aba.<verse eid="MIC 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13" />Ami ñyaasobo mme ubobod ñkpọ ndufo</para>
  <para style="q2" vid="MIC 5:13">ye mme asaña-asaña itiad ke atu ndufo;</para>
  <para style="q1" vid="MIC 5:13">ndufo idiisuuho iwuod aba</para>
  <para style="q2" vid="MIC 5:13">inọ utom ubọk ndufo.<verse eid="MIC 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14" />Ami ñyaawịppe mme abai Asera nsio ke atu ndufo,</para>
  <para style="q2" vid="MIC 5:14">ke mmaawuut mme abio ndufo.<verse eid="MIC 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15" />Ami ñyaasio usiene ke iyadesịd ye abom</para>
  <para style="q2" vid="MIC 5:15">ke mme idịd i-imiikoppo uyio mmi.”<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="s1">Utọk <char style="nd">Abọọñ</char> ye Isrel</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1" />Kpañ utọñ kop se <char style="nd">Abọọñ</char> atañ:</para>
  <para style="q1" vid="MIC 6:1">“Dakka da, kpe ikpe mmi ke iso mme ekamba abod;</para>
  <para style="q2" vid="MIC 6:1">yak mme ntək abod ekop se afo anie aditañ.<verse eid="MIC 6:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2" />“Ikop utọk <char style="nd">Abọọñ</char>, ndufo mme ekamba abod;</para>
  <para style="q2" vid="MIC 6:2">ikpañ utọñ, ndufo mme nsi-nsi itiad idakisọñ ederimbod.</para>
  <para style="q1" vid="MIC 6:2">Sia <char style="nd">Abọọñ</char> anie utọk ye ikọd amọ;</para>
  <para style="q2" vid="MIC 6:2">anye akoot Isrel ikpe.<verse eid="MIC 6:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3" />“Ikọd mmi, nsoo ke ami inam ndufo?</para>
  <para style="q2" vid="MIC 6:3">Ke die ke ami ifiik ndufo? Imbọọrọ miin.<verse eid="MIC 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4" />Ami ñkisio ndufo ke Iyib,</para>
  <para style="q2" vid="MIC 6:4">ñnyʌñ ifak ndufo nsio ke isọñ ufʌn.</para>
  <para style="q1" vid="MIC 6:4">Ami mmaadọñ Moses nte idat ndufo usʌñ,</para>
  <para style="q2" vid="MIC 6:4">kpa ye Erọn ye Miriam.<verse eid="MIC 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5" />Ikọd mmi, itoiyo</para>
  <para style="q2" vid="MIC 6:5">se Balak adidem Mọb akeduak</para>
  <para style="q2" vid="MIC 6:5">ye se Balaam ayịn Beo akebọọrọ.</para>
  <para style="q1" vid="MIC 6:5">Itoiyo isañ ndufo tọọñọ ke Sitịm tutu Kilkal,</para>
  <para style="q2" vid="MIC 6:5">nọ ato do ndufo etoiyo mme ndinen adinam <char style="nd">Abọọñ</char>.”<verse eid="MIC 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6" />Nsoo ke ami ndiiben ndi iso <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="MIC 6:6">ñnyʌñ ntuak iwuod nnọ ñkoñ-ñkoñ Abasi?</para>
  <para style="q1" vid="MIC 6:6">Me ami ñkpedi ke iso amọ ye ufọfọb uwa,</para>
  <para style="q2" vid="MIC 6:6">ye nditọ enañ e-esọññọ isua keed?<verse eid="MIC 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7" />Me <char style="nd">Abọọñ</char> ayaanem esịd ye mme tọsịn akukịmedọñ,</para>
  <para style="q2" vid="MIC 6:7">ye udiọọñ adan ọlif tọsịn duob?</para>
  <para style="q1" vid="MIC 6:7">Me ñkpenọ akpa ayịn mmi ke ndudue mmi,</para>
  <para style="q2" vid="MIC 6:7">mfịd idem mmi ke idiọọkñkpọ ukpọñ mmi?<verse eid="MIC 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8" />O awo, anye uwọt fiin se ifọn.</para>
  <para style="q2" vid="MIC 6:8">Ndin nsoo ke <char style="nd">Abọọñ</char> ayem uto fiin?</para>
  <para style="q1" vid="MIC 6:8">Adinam se inen ñnyʌñ mma mbọm,</para>
  <para style="q2" vid="MIC 6:8">ñnyʌñ nsaña ke nsuukidem ye Abasi mfo.<verse eid="MIC 6:8" /></para>
  <para style="s1">Ndudue Isrel ye Ufen</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9" />Kpañ utọñ! <char style="nd">Abọọñ</char> asʌk akoot abio,</para>
  <para style="q2" vid="MIC 6:9">ndin adibaak anyịñ mfo ado aniọñ.</para>
  <para style="q2" vid="MIC 6:9">“Kpeme esañ ye Awo a-akemekke anye.<verse eid="MIC 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10" />Afo ufọk ndoom, me akpena ami nsʌk mfre mme inie a-afo akenieghe ke idiọọk usʌñ,</para>
  <para style="q2" vid="MIC 6:10">ye imək udomoñkpọ efa<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">Efa akedo udomo e-ekamake edomo nsaad ñkpọ</char></note>, a-adooho emaesuuñọ?<verse eid="MIC 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11" />Me a-ado se ami ñkpetoppo awo a-akamake mme ukwañ udomoñkpọ,</para>
  <para style="q2" vid="MIC 6:11">ye ekpad ndiọi udomoñkpọ?<verse eid="MIC 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12" />Mme imọ awo ndufo edo mbon afai;</para>
  <para style="q2" vid="MIC 6:12">mbon e-edʌñọke ye ndufo edo mbon nsu</para>
  <para style="q2" vid="MIC 6:12">ndin edeme ammọ etañ ikọ abiaña-abiaña.<verse eid="MIC 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13" />Ke ntoro, ami mmetọọñọ adisobo ndufo,</para>
  <para style="q2" vid="MIC 6:13">aditahade ndufo ke ntak mme ndiọiñkpọ ndufo.<verse eid="MIC 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14" />Eyaedia ñkpọ ado idiikoppo uyʌkkọ;</para>
  <para style="q2" vid="MIC 6:14">idịb ndufo adiisʌk inaa ukpọk.</para>
  <para style="q1" vid="MIC 6:14">Ndufo eyaetañ ebono ado idikịtte ndomokeed,</para>
  <para style="q2" vid="MIC 6:14">sia se ndufo etañ ebono ami ñyaayaak nnọ akañkañ.<verse eid="MIC 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15" />Ndufo eyaetọ ado idọkkọ;</para>
  <para style="q2" vid="MIC 6:15">eyaenyịmme adan ọlif, ado idiidatta adan ado inam ñkpọ,</para>
  <para style="q2" vid="MIC 6:15">eyaenuak kreb ado idiinwọññọ ukọd ado.<verse eid="MIC 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16" />Ndufo emenịm ewʌhọ Omri</para>
  <para style="q2" vid="MIC 6:16">ye afịd mme edinam ke ufọk Ehab;</para>
  <para style="q2" vid="MIC 6:16">emekeene mme eduuwem ammọ.</para>
  <para style="q1" vid="MIC 6:16">Ke ntoro ami ñyaiyaak ndufo nsịn ke atahade,</para>
  <para style="q2" vid="MIC 6:16">mbon ndufo ekappa edo ñkpọ ndọk;</para>
  <para style="q2" vid="MIC 6:16">eyaeyọ nsaha eto mme idịd.”<verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="s1">Ukuud Isrel</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1" />Utọ ukuud a-ami mbọọhọ mi!</para>
  <para style="q1" vid="MIC 7:1">Ami ntie nte awo a-atañña mfịd ke ini idọk</para>
  <para style="q2" vid="MIC 7:1">ke ini etañña mme ñkpọ se isʌhọ ke inwañ fain;</para>
  <para style="q1" vid="MIC 7:1">eboho kreb ibaaha se edia,</para>
  <para style="q2" vid="MIC 7:1">fik andọññọ itọñ abakka anwịm ibaaha.<verse eid="MIC 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2" />E-ekwọọk mme anam akpanikọ esio ke isọñ;</para>
  <para style="q2" vid="MIC 7:2">adinen awo ndomokeed isʌhọke.</para>
  <para style="q1" vid="MIC 7:2">Afịd awo ededịbe eyem adiduọk iyiib;</para>
  <para style="q2" vid="MIC 7:2">ebịne emọ-emọ ke mme iyịre.<verse eid="MIC 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3" />Naña ubọk iba e-ediọọñọ adinam idiọọk;</para>
  <para style="q2" vid="MIC 7:3">adaukara ayem mme enọ,</para>
  <para style="q1" vid="MIC 7:3">abiideikpe abọ ubọkedem,</para>
  <para style="q2" vid="MIC 7:3">mme anie adudu edomo se ammọ eyem,</para>
  <para style="q2" vid="MIC 7:3">afịd ammọ edọñọ idiọọk adu ukem.<verse eid="MIC 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4" />Andifọn ñkan ke atu ammọ atie nte akpab,</para>
  <para style="q2" vid="MIC 7:4">andinen ñkan adiọọk akan ñkukịm.</para>
  <para style="q1" vid="MIC 7:4">Usen Abasi adiighe aduse fiin adisịm,</para>
  <para style="q2" vid="MIC 7:4">usen a-mbon ukpeme esioho ñkpo.</para>
  <para style="q2" vid="MIC 7:4">Idahami ado usen ndutịme ndufo.<verse eid="MIC 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5" />Kuunie mbuọdidem ke mbọhọidʌñ;</para>
  <para style="q2" vid="MIC 7:5">kuudot anyen ke ufan.</para>
  <para style="q1" vid="MIC 7:5">Kpa ye awonwaan a-anaaha ufat fiin</para>
  <para style="q2" vid="MIC 7:5">kpeme ikọ inua mfo.<verse eid="MIC 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6" />Sia ayịn ikponoke ete amọ,</para>
  <para style="q2" vid="MIC 7:6">ayịn awonwaan adakka ikọ ye eka,</para>
  <para style="q1" vid="MIC 7:6">anwaan ayịn atọhọ ye eka ebe,</para>
  <para style="q2" vid="MIC 7:6">mme asua awo edo mbon esịd ufọk amọ.<verse eid="MIC 7:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7" />Ado amaado ami, ntie ke idodanyen mbet <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="MIC 7:7">ami mbet Abasi Andinyaaña mmi;</para>
  <para style="q2" vid="MIC 7:7">Abasi mmi ayañkop miin.<verse eid="MIC 7:7" /></para>
  <para style="s1">Isrel Ayaadakka Ada</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8" />Asua mmi, kunnọọ ñnyọọ!</para>
  <para style="q2" vid="MIC 7:8">Akpesʌkado ami mmeduọ, ñyaadakka nda.</para>
  <para style="q1" vid="MIC 7:8">Akpesʌkado a-ami ntieghe ke ekịm,</para>
  <para style="q2" vid="MIC 7:8">
    <char style="nd">Abọọñ</char> ayaado unwana mmi.<verse eid="MIC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9" />Sia ami mmedue anye,</para>
  <para style="q2" vid="MIC 7:9">ami ñyaayọ iyadesịd <char style="nd">Abọọñ</char>,</para>
  <para style="q1" vid="MIC 7:9">tutu anye akpe ikpe mmi</para>
  <para style="q2" vid="MIC 7:9">anyʌñ abiide ikpe mmi.</para>
  <para style="q1" vid="MIC 7:9">Anye ayansio miin adi adisịn ke unwana;</para>
  <para style="q2" vid="MIC 7:9">ami ñyaakịt adinenido amọ.<verse eid="MIC 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10" />Asua mmi ayaakịt,</para>
  <para style="q2" vid="MIC 7:10">ndin abuud ayaafʌk anye,</para>
  <para style="q1" vid="MIC 7:10">anye a-akembooho miin,</para>
  <para style="q2" vid="MIC 7:10">“Mmọ anye <char style="nd">Abọọñ</char> Abasi mfo?”</para>
  <para style="q1" vid="MIC 7:10">Anyen mmi ayaakịt iduọ amọ;</para>
  <para style="q2" vid="MIC 7:10">kpa idahami, eyaesọnnọ anye ke ñkpad</para>
  <para style="q2" vid="MIC 7:10">nte esọnnọ nsọñ ke mme efaak.<verse eid="MIC 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11" />Usen se ediibọp mme ndibene mfo asʌk adi,</para>
  <para style="q2" vid="MIC 7:11">usen se ediisịkke mme adaña mfo nọ amaana akpon.<verse eid="MIC 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12" />Ke usen ado mbon awo eyaedi ibịne ndufo,</para>
  <para style="q2" vid="MIC 7:12">eto Asiria ye mme abio ke Iyib,</para>
  <para style="q1" vid="MIC 7:12">tọọñọ ke Iyib tutu awuọ Yufretis</para>
  <para style="q2" vid="MIC 7:12">tọọñọ ke akpainyañ tutu akpainyañ,</para>
  <para style="q2" vid="MIC 7:12">tọọñọ ke ikpọabod tutu ikpọabod.<verse eid="MIC 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13" />Ederimbod ayaanaa ukpọk akeene mbon se idʌñ ke esịd,</para>
  <para style="q2" vid="MIC 7:13">ato ke mme adinam ammọ.<verse eid="MIC 7:13" /></para>
  <para style="s1">Akam ye Itooro</para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14" />Idat esañ ndufo ikpeme ikọd ndufo,</para>
  <para style="q2" vid="MIC 7:14">ufene a-atooho udeeme ndufo,</para>
  <para style="q1" vid="MIC 7:14">a-adʌññọ ke idem amọ ke akai,</para>
  <para style="q2" vid="MIC 7:14">ke mme isọñ e-efọnnọ ñkpọ.</para>
  <para style="q1" vid="MIC 7:14">Yak ammọ edia ke Basan ye Kilied</para>
  <para style="q2" vid="MIC 7:14">naña akedo ke mme usen edem.<verse eid="MIC 7:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15" />“Naña akedo ke ini a-ndufo eketooho Iyib edi,</para>
  <para style="q2" vid="MIC 7:15">ami ñyaawọt ammọ mme utịppeñkpọ mmi.”<verse eid="MIC 7:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16" />Mme idịd eyaekịt enyʌñ ekop abuud,</para>
  <para style="q2" vid="MIC 7:16">ebọi ammọ afịd adudu ammọ.</para>
  <para style="q1" vid="MIC 7:16">Ammọ eyaedat ubọk efʌk ke inua ammọ,</para>
  <para style="q2" vid="MIC 7:16">ndin utọñ ammọ ayaaforo inan.<verse eid="MIC 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17" />Ammọ ediidai ntọñ ke isọñ nte udʌkikọd,</para>
  <para style="q2" vid="MIC 7:17">nte mme unam e-enyọọnọ ke isọñ.</para>
  <para style="q1" vid="MIC 7:17">Eyaenyeñ idem ewuọñọ ke adu ammọ edi;</para>
  <para style="q2" vid="MIC 7:17">ammọ eyaewọññọ ke ndịk ekeene <char style="nd">Abọọñ</char> Abasi ñnyịn,</para>
  <para style="q2" vid="MIC 7:17">enyʌñ ubaak fiin.<verse eid="MIC 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18" />Anie Abasi itie nte afo,</para>
  <para style="q2" vid="MIC 7:18">a-adakkake anọ ke idiọọkñkpọ anyʌñ afeen ndudue</para>
  <para style="q2" vid="MIC 7:18">mme ñyọhọnsʌhọ udeeme amọ?</para>
  <para style="q1" vid="MIC 7:18">Afo uyatta esịd ke nsi-nsi,</para>
  <para style="q2" vid="MIC 7:18">ado akop inem aditua mbọm.<verse eid="MIC 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19" />Afo ayaamaana itua ñnyịn mbọm;</para>
  <para style="q2" vid="MIC 7:19">ayaafiik mme idiọọkñkpọ ñnyịn ke idak ukod mfo,</para>
  <para style="q2" vid="MIC 7:19">anyʌñ atop afịd mme ndudue ñnyịn adọñ ke udem inyañ.<verse eid="MIC 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20" />Afo ayaanam akpanikọ ye Yekọb,</para>
  <para style="q2" vid="MIC 7:20">anyʌñ awọt Ebraham mbọm,</para>
  <para style="q1" vid="MIC 7:20">kpa naña akenwọñọ anọọ mme ete ñnyịn</para>
  <para style="q2" vid="MIC 7:20">ke mme usen edem.<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>