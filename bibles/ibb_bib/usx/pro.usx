  <para style="h">Mme Ñke</para>
  <para style="toc1">Mme Ñke</para>
  <para style="toc2">Mme Ñke</para>
  <para style="toc3">Ñke</para>
  <para style="mt1">Mme Ñke</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="ms1">Uduak ye Ukodikọ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />Mme ñke Sọlọmọn, ayịn Defid, adidem Isrel:<verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />ke adinie aniọñ ye nnọitem;</para>
  <para style="q2" vid="PRO 1:2">ke adibọ ifiọk ye mbufiọk;<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />ke adibọ ukpeebñkpọ ke ido ndiọọñọidem,</para>
  <para style="q2" vid="PRO 1:3">adinam se inen inyʌñ ifọn inyʌñ idot;<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />ke adinọ mme akọi ndiọọñọidem,</para>
  <para style="q2" vid="PRO 1:4">nnọọ mme iwaad ifiọk ye mfarakeidem,<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />yak mbon aniọñ ekpañ utọñ enyʌñ edian ke ukpeebñkpọ ammọ</para>
  <para style="q2" vid="PRO 1:5">yak mbon eti iwuod enyʌñ ebọ ndadusʌñ,<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />ke adikama ndiọọñọ mme ñke ye mme ndọk,</para>
  <para style="q2" vid="PRO 1:6">mme ikọ ye mme uto mbon aniọñ.<verse eid="PRO 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />Mbaak <char style="nd">Abọọñ</char> ado ntọọñọ ifiọk,</para>
  <para style="q2" vid="PRO 1:7">ado mme ndisịme esua aniọñ ye item.<verse eid="PRO 1:7" /></para>
  <para style="ms1">Ntọọñọ Ikọ: Nnọitem Adifat Aniọñ Ndian ke Idem</para>
  <para style="s1">Ndʌdutọñ Aditre Adikop Ikood Ndiọi Awo</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />Ayịn mmi, kpañ utọñ nọ item ete mfo</para>
  <para style="q2" vid="PRO 1:8">kuunyʌñ ufre anyen ubaña ukpeebñkpọ eka mfo.<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />Ammọ edo uyaraiwuod se inọ iwuod mfo mfọn</para>
  <para style="q2" vid="PRO 1:9">enyʌñ edo ñkpọitọñ adibana itọñ mfo.<verse eid="PRO 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />Ayịn mmi, adieke ndiọi awo eyemme adutap fiin,</para>
  <para style="q2" vid="PRO 1:10">kuunyịmme unọọ ammọ.<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />Adieke ammọ ebooho, “Di diana ye ñnyịn;</para>
  <para style="q2" vid="PRO 1:11">yak ñnyịn idịbe ibem iyiib mbon i-imiidueghe,</para>
  <para style="q2" vid="PRO 1:11">yak ñnyịn idịbe ibet ukpọñ mbon i-imiinamma awo ibak;<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />yak ñnyịn iben ammọ imen ndisi, nte udi,</para>
  <para style="q2" vid="PRO 1:12">imen afịd, nte mbon e-eduọhọ edʌk ube;<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />ñnyịn iyainie nsio-nsio nti ñkpọ</para>
  <para style="q2" vid="PRO 1:13">inyʌñ iyọhọ mme ufọk ñnyịn ye mbịme;<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />diana ye ñnyịn;</para>
  <para style="q2" vid="PRO 1:14">afịd ñnyịn iyaiwuana ke mbịme ado,”<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />ayịn mmi, kuukeene ammọ ukaa,</para>
  <para style="q2" vid="PRO 1:15">kuusịn ukod ke usʌñ ammọ;<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />sia ikpad ammọ esọsọp adinam idiọọkñkpọ,</para>
  <para style="q2" vid="PRO 1:16">ammọ esọsọp ediduọk iyiib.<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />Ado ubiat ini aditat iyịre nduọọk</para>
  <para style="q2" vid="PRO 1:17">ke itie nte afịd inuen ekeme edikịt!<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />Utọ mbon ami edịbe ebem iyiib ammọ;</para>
  <para style="q2" vid="PRO 1:18">ammọ edịbe ebem idem ammọ kpọd!<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />Ami ado mme usʌñ mbon e-efegheke ebịne idiọọk udod;</para>
  <para style="q2" vid="PRO 1:19">anye ado abeben uwem mbon se inie anye afep.<verse eid="PRO 1:19" /></para>
  <para style="s1">Nduaiya Aniọñ</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />Ke eferife, aniọñ asʌk abọọñ ke akpọsọñ uyio,</para>
  <para style="q2" vid="PRO 1:20">anye asio ñkpo ke anwa mbono;<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />ke anyọñ ndibene anye asio ñkpo,</para>
  <para style="q2" vid="PRO 1:21">ke inuaatob abio anye atañ ikọ amọ:<verse eid="PRO 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />“Ndufo e-edooho mme akọi ediima akọi-akọi usʌñ ndufo ikpeene die?</para>
  <para style="q2" vid="PRO 1:22">Mbon nsaha ediikpeene die edikop inem ke edisak nsaha</para>
  <para style="q2" vid="PRO 1:22">mme ndisịme ediinyʌñ isua ifiọk ikpeene die?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />Idat nduaiya mmi ikappa esịd!</para>
  <para style="q2" vid="PRO 1:23">Ndin ami ñyaanwañña mme akikere mmi ifʌk ndufo,</para>
  <para style="q2" vid="PRO 1:23">Ami ñyaanam ndufo ediọọñọ mme ukpeebñkpọ mmi!<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />Ado sia ndufo esịnne adikop idaha ami ñkoodo</para>
  <para style="q2" vid="PRO 1:24">inyʌññọ iba ndomokeed se iwuuk anyen ise idaha se ami nsio ubọk mmi ñnyan,<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />sia ndufo imiikoppo item mmi ndomokeed</para>
  <para style="q2" vid="PRO 1:25">inyʌññọ ikop nduaiya mmi,<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />ami ñyaakappa nsak ke ini afanekọñ amaisịm ndufo;</para>
  <para style="q2" vid="PRO 1:26">ami ñyainọ ñnyọ ke ini nnananyen amaisịm ndufo,<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />ke ini nnananyen amaiben ndufo nte ayobio,</para>
  <para style="q2" vid="PRO 1:27">ke ini afanekọñ amaiben ndufo nte idio,</para>
  <para style="q2" vid="PRO 1:27">ke ini ukuud ye mfịna emaikan ndufo ubọk.<verse eid="PRO 1:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />“Idaha ado ammọ eyaeñkoot miin, ado ami ndiiyieghe;</para>
  <para style="q2" vid="PRO 1:28">ammọ eyaeñyem miin ado idiñkịtte miin,<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />sia ammọ emaesua ifiọk</para>
  <para style="q2" vid="PRO 1:29">ndin inyʌññọ imek adibaak <char style="nd">Abọọñ</char>.<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />Sia ammọ imiinyịmmeke edikop item mmi</para>
  <para style="q2" vid="PRO 1:30">enyʌñ esua nduaiya mmi,<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />ammọ eyaedia mfịd usʌñ ammọ</para>
  <para style="q2" vid="PRO 1:31">enyʌñ eyʌkkọ ye mfịd ndudiọ ammọ.<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />Sia unana nsọọñọnda mbon akọi adiiwot ammọ,</para>
  <para style="q2" vid="PRO 1:32">ndin uyʌkkọ mme ndisịme adiisobo ammọ;<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />ado awo akeedodo a-akpañña utọñ annọọ miin ayaadʌñ ke ifuuro</para>
  <para style="q2" vid="PRO 1:33">anyʌñ aba ke emem, ikoppo ndịk unọmọ.”<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">Mme Ufọn Aniọñ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />Ayịn awodeen mmi, adieke afo abọọhọ mme ikọ mmi</para>
  <para style="q2" vid="PRO 2:1">anyʌñ anịm mme ewʌhọ mmi ke esịd mfo,<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />asuuk utọñ mfo anọ aniọñ</para>
  <para style="q2" vid="PRO 2:2">anyʌñ asịn esịd mfo ke mbufiọk,<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />ke akpanikọ, adieke afo ayemme ikike</para>
  <para style="q2" vid="PRO 2:3">anyʌñ atua ayem ndiọọñọidem,<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />ndin adieke afo ayemme anye nte silfa</para>
  <para style="q2" vid="PRO 2:4">anyʌñ awuuk anyen ayem anye nte ndedịbe ñkpọuto,<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />idaha ado mbaak <char style="nd">Abọọñ</char> ayaunwaña fiin</para>
  <para style="q2" vid="PRO 2:5">afo ayaanyʌñ akịt ifiọk Abasi.<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />Sia <char style="nd">Abọọñ</char> anọ aniọñ;</para>
  <para style="q2" vid="PRO 2:6">ifiọk ye mbufiọk eto inua amọ.<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />Anye anịm uforo anọ ndinen awo,</para>
  <para style="q2" vid="PRO 2:7">anye ado atuekọñ anọ mbon i-ikpadisañ ammọ imiinieghe ndo,<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />sia anye akpeme usʌñ ndinen awo</para>
  <para style="q2" vid="PRO 2:8">anyʌñ akpeme usʌñ mme anam akpanikọ.<verse eid="PRO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />Ndin afo ayaadiọọñọ se ido eti ye se ifọn</para>
  <para style="q2" vid="PRO 2:9">ye se inen, afịd eti usʌñ ayaanekke unwaña.<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />Sia aniọñ ayaadʌk esịd mfo,</para>
  <para style="q2" vid="PRO 2:10">ñko ukpọñ mfo ayaakop inem abaña ifiọk.<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />Mfarakeidem ayaukpeme fiin,</para>
  <para style="q2" vid="PRO 2:11">mbufiọk ñko ayaukpeme fiin.<verse eid="PRO 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />Aniọñ ayaufak fiin asio ke usʌñ mbon ibak,</para>
  <para style="q2" vid="PRO 2:12">asio ke ubọk mbon i-ikọ ammọ edooho abiaña,<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />mbon e-emaekekpọñ mme nnen-nnen usʌñ</para>
  <para style="q2" vid="PRO 2:13">ekesaña ke mme usʌñ ekịm,<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />mbon e-ekoppo inem ke adinam se imiinenne</para>
  <para style="q2" vid="PRO 2:14">enyʌñ edaara ke abʌd-abʌd idiọọkñkpọ,<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />u-usʌñ ammọ akwañake</para>
  <para style="q2" vid="PRO 2:15">e-enyʌññọ edo mbon akpọsọñ ñkara.<verse eid="PRO 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />Aniọñ ayaanyʌñ ufak fiin asio ke ubọk awonwaan efịbe,</para>
  <para style="q2" vid="PRO 2:16">asio ke ubọk awonwaan akpara ye nneminua amọ,<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />a-amaakpọñ ebe uyịn amọ</para>
  <para style="q2" vid="PRO 2:17">anyʌñ afre edioomo a-anye akenamma ke iso Abasi.<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />Ke akpanikọ ufọk amọ aben awo asọiyọ akaa ñkpa</para>
  <para style="q2" vid="PRO 2:18">usʌñ amọ ñko aben akaa sịbidịd mme akpañkpa.<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />Ibaaha awo a-akaaha abịne anye atịmme anyọñ</para>
  <para style="q2" vid="PRO 2:19">me adisịm mme usʌñ uwem.<verse eid="PRO 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />Ke ntoro, afo uduusaña ke mme usʌñ nti awo</para>
  <para style="q2" vid="PRO 2:20">anyʌñ akeene usʌñ ndinen awo.<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />Sia ndinen awo eyaedu uwem ke isọñ,</para>
  <para style="q2" vid="PRO 2:21">mbon se inana ndo ñko eyaedʌñ do;<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />ado eyaesobo mbon ibak esio ke iso isọñ,</para>
  <para style="q2" vid="PRO 2:22">ndin eyaenyʌñ ewai mbon abiaña esio efep.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">Aniọñ Anọ Mfọnọñkpọ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />Ayịn mmi, kuufre item mmi,</para>
  <para style="q2" vid="PRO 3:1">ado nịm mme mbed mmi ke esịd mfo,<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />sia ammọ eyaenam isua uwem mfo anyọọñ</para>
  <para style="q2" vid="PRO 3:2">enyʌñ eben emem ye uforo usọk fiin.<verse eid="PRO 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />Kuuyak ima ye akpanikọ ukpọñ fiin;</para>
  <para style="q2" vid="PRO 3:3">kpaha ammọ kanna itọñ mfo,</para>
  <para style="q2" vid="PRO 3:3">wet ammọ ke itiadñwed ikpanesịd mfo.<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />Ndin afo ayaanie mfọn ye eti anyịñ</para>
  <para style="q2" vid="PRO 3:4">ke iso Abasi ye ke iso awo.<verse eid="PRO 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />Buọt idem ke <char style="nd">Abọọñ</char> ye afịd esịd mfo</para>
  <para style="q2" vid="PRO 3:5">kuunyʌñ udot anyen ke ndiọọñọidem mfo;<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />ke afịd usʌñ mfo suuk iwuod nọ anye,</para>
  <para style="q2" vid="PRO 3:6">ndin anye ayaanam mme usʌñ mfo enen.<verse eid="PRO 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />Kuuse idem mfo nte awo aniọñ;</para>
  <para style="q2" vid="PRO 3:7">baak <char style="nd">Abọọñ</char> nyʌñ sọọn idiọọkñkpọ<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />Ami ayaunọ fiin nsọñidem</para>
  <para style="q2" vid="PRO 3:8">anyʌñ anam akpọ mfo asọọñ.<verse eid="PRO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />Dat inie mfo kpono <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PRO 3:9">ye akpa mfịd mbunwịm inwañ mfo;<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />ndin mme ise mfo eyaeyọhọ eduọiyọ,</para>
  <para style="q2" vid="PRO 3:10">mme atu mfo ñko eyaeyọhọ ye ufa ukọd.<verse eid="PRO 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />Ayịn mmi, kuusịn ntʌnọ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PRO 3:11">kuunyʌñ utọhọ ubaña nsuannọ amọ,<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />sia <char style="nd">Abọọñ</char> atʌnọ mbon se anye ama,</para>
  <para style="q2" vid="PRO 3:12">kpa naña ete anam ye ayịn a-anye akoppo inemesịd abaña.<verse eid="PRO 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />Afọfọn anọ mbon e-ekịtte aniọñ,</para>
  <para style="q2" vid="PRO 3:13">mbon se inie mbufiọk,<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />sia aniọñ a-afọn akan silfa</para>
  <para style="q2" vid="PRO 3:14">anyʌñ aba udod akan kold.<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />Anye asọñ udua akan mme rubi;</para>
  <para style="q2" vid="PRO 3:15">ibaaha se afo ayem e-ekemeke adiben ndomo ye aniọñ.<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />Anyan uwem asịne ke ubọk nnasia amọ;</para>
  <para style="q2" vid="PRO 3:16">inie ye ukpono esịne ke ubọk ufiin amọ.<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />Mme usʌñ amọ edo inem-inem usʌñ,</para>
  <para style="q2" vid="PRO 3:17">ndin afịd usʌñ amọ edo emem.<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />Anye ado eto uwem anọ mbon e-emʌmmọ anye ekama,</para>
  <para style="q2" vid="PRO 3:18">mbon e-efatta anye ekama eyaebọ adidiọñ.<verse eid="PRO 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />
    <char style="nd">Abọọñ</char> akekama aniọñ asịn itiad idakisọñ ederimbod,</para>
  <para style="q2" vid="PRO 3:19">ke mbufiọk ke anye akewuuk mme hefịn ke itie;<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />ato ke ifiọk amọ, emaebakka mme udem,</para>
  <para style="q2" vid="PRO 3:20">ndin mme ikpaanyọñ esaana mbara eduọk.<verse eid="PRO 3:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />Ayịn mmi, kuuyak aniọñ ye mbufiọk efeppe ekpọñ anyen mfo,</para>
  <para style="q2" vid="PRO 3:21">nekke kpeme eti akikere ye mfarakeidem;<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />ammọ ediido uwem unọ fiin,</para>
  <para style="q2" vid="PRO 3:22">edo ñkpọ mbanaidem ke itọñ mfo.<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />Ndin afo ayaasaña ke ifuuro ke usʌñ mfo,</para>
  <para style="q2" vid="PRO 3:23">ndin uduutuakka ukod mfo.<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />Afo umausuuk una, uduukoppo ndịk;</para>
  <para style="q2" vid="PRO 3:24">umausuuk una, idab mfo ayaanem.<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />Kuunie ndịk ubaña adiwad nnananyen</para>
  <para style="q2" vid="PRO 3:25">me nsobo a-abenne awo ibak,<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />sia <char style="nd">Abọọñ</char> ayaaba ke ñkañ mfo</para>
  <para style="q2" vid="PRO 3:26">idiinyʌññọ iyak ukod mfo adʌk afia.<verse eid="PRO 3:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />Kuutre adinam mfọn nnọọ mbon edotto adibọ,</para>
  <para style="q2" vid="PRO 3:27">ke ini asịneke ke adudu mfo adinam.<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />Kuubo mbọhọidʌñ mfo,</para>
  <para style="q2" vid="PRO 3:28">“Tịmme di ñkpọñ ke ami ñyaunọ”;</para>
  <para style="q2" vid="PRO 3:28">ke ini adooho ñkpọ ado mmọdo aba ye afo.<verse eid="PRO 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />Kuuduak idiọọk ubaña mbọhọidʌñ mfo,</para>
  <para style="q2" vid="PRO 3:29">a-adʌññọ udiana fiin ke mbuọdidem.<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />Kuudot awo ndomokeed uyio ke unana ntak,</para>
  <para style="q2" vid="PRO 3:30">ke ini ammọ imuudueghe fiin.<verse eid="PRO 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />Kuufịbe mbon afai</para>
  <para style="q2" vid="PRO 3:31">kuunyʌñ umek usʌñ ammọ ndomokeed.<verse eid="PRO 3:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />Sia <char style="nd">Abọọñ</char> asua mbon abʌd-abʌd ido</para>
  <para style="q2" vid="PRO 3:32">ado anye adʌk adu ye ndinen awo.<verse eid="PRO 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />Isuuñọ <char style="nd">Abọọñ</char> anie ufọk mbon ibak,</para>
  <para style="q2" vid="PRO 3:33">ado anye adiọñ ufọk ndinen awo.<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />Anye asak mbon ntañidem e-enọọhọ awo ñnyọọ,</para>
  <para style="q2" vid="PRO 3:34">ado anọ mbon nsuukidem ye mbon ukuud mfọn.<verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />Mbon aniọñ ebọ ukpono enie,</para>
  <para style="q2" vid="PRO 3:35">ado mme ndisịme edia abuud ikpọọñ.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">Se Akpekpakpa, Yem Aniọñ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />Nditọ mmi, ikpañ utọñ inọ item ete;</para>
  <para style="q2" vid="PRO 4:1">ikpañ utọñ inyʌñ ibọ ndiọọñọidem.<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />Ami inọ ndufo eti ukpeeb,</para>
  <para style="q2" vid="PRO 4:2">ke ntoro ikiidiañña idem ikpọñ ukpeebñkpọ mmi.<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />Sia ami ñko ñkedo ayịn nnọ ete mmi,</para>
  <para style="q2" vid="PRO 4:3">ataa nsek, etəkayịn e-eka mmi akemaaha.<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />Ndin anye amañkpeep miin, anyʌñ ambo miin,</para>
  <para style="q2" vid="PRO 4:4">“Mʌm ikọ mmi ke afịd esịd mfo;</para>
  <para style="q2" vid="PRO 4:4">nịm mme mbed mmi, ndin afo ayaadu uwem.<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />Bọ aniọñ, bọ ndiọọñọidem;</para>
  <para style="q2" vid="PRO 4:5">kuufre mme ikọ mmi, kuunyʌñ uwọññọ ukpọñ ammọ.<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />Kuudakka ukpọñ aniọñ, ndin anye ayaukpeme fiin;</para>
  <para style="q2" vid="PRO 4:6">ma anye, ndin anye ayaukpeme fiin.<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />Ntọọñọ aniọñ ado ami: Bọ aniọñ.</para>
  <para style="q2" vid="PRO 4:7">Akpọkọm anye akpa afịd se afo anie, bọ ndiọọñọidem.<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />Ma anye, ndin anye ayaadịppe ndaha mfo;</para>
  <para style="q2" vid="PRO 4:8">fat anye dian ke idem, ndin anye ayaukpono fiin.<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />Anye ayaunọ fiin ñkpọ mbana se ayara ke iwuod mfo</para>
  <para style="q2" vid="PRO 4:9">anyʌñ uyat fiin uyaiya anyanya ubọọñ.”<verse eid="PRO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />Ayịn mmi, kpañ utọñ, dat se ami ntañ,</para>
  <para style="q2" vid="PRO 4:10">ndin isua uwem mfo ayaawak.<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />Ami mmunọ fiin item ke usʌñ aniọñ</para>
  <para style="q2" vid="PRO 4:11">ñnyʌñ udat fiin nsaña ke mme nnen-nnen usʌñ.<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />Ke usʌñ isañ mfo, uduunieghe ubiọọñọ;</para>
  <para style="q2" vid="PRO 4:12">afo umaufeghe itọk, uduutuakka ukod.<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />Mʌm item kama, kuusaana anye uyaak;</para>
  <para style="q2" vid="PRO 4:13">nekke kpeme anye mfọn-mfọn, sia anye ado uwem mfo.<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />Kuudot ikpad ke usʌñ mbon ibak</para>
  <para style="q2" vid="PRO 4:14">kuunyʌñ usaña ke usʌñ mme anamidiọọk.<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />Wọññọ kpọñ anye, kuusaña ke usʌñ ado;</para>
  <para style="q2" vid="PRO 4:15">wọññọ kpọñ usʌñ ado nyʌñ saña ke usʌñ mfo.<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />Sia ammọ ikemeke iduọk adudu tutu enam ibak;</para>
  <para style="q2" vid="PRO 4:16">e-enyịm ammọ idab tutu ammọ enam awo aduọ.<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />Ammọ eta uyo ibak</para>
  <para style="q2" vid="PRO 4:17">enyʌñ enwọñ ukọd afai.<verse eid="PRO 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />Usʌñ ndinen awo atie nte utịn ubakusen,</para>
  <para style="q2" vid="PRO 4:18">ayamma tutu awuọ ufọọd uweemeayio.<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />Ado usʌñ awo ibak atie nte akpọsọñ ekịm;</para>
  <para style="q2" vid="PRO 4:19">ammọ idiọọñọke se inam ammọ etuak ukod.<verse eid="PRO 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />Ayịn mmi, kpañ utọñ kop se ntañ;</para>
  <para style="q2" vid="PRO 4:20">wọññọ utọñ mfo nọ mme ikọ mmi.<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />Kuuyak ammọ efeppe ekpọñ anyen mfo,</para>
  <para style="q2" vid="PRO 4:21">sịn ammọ ke esịd mfo;<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />sia ammọ edo uwem enọ mbon e-ekịtte ammọ</para>
  <para style="q2" vid="PRO 4:22">enyʌñ edo nsọñidem enọ afịd idem.<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />Ke akannakan ami, kpeme esịd mfo,</para>
  <para style="q2" vid="PRO 4:23">sia afịd ñkpọ se afo anam eto do ewuọ.<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />Kuuyak inua mfo atañ nsappa-nsappa ikọ;</para>
  <para style="q2" vid="PRO 4:24">kuuyak abʌd-abʌd ikọ awuọ ato inua mfo.<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />Yak anyen mfo ase nnen-nnen;</para>
  <para style="q2" vid="PRO 4:25">wuuk anyen mfo ke iso mfo.<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />Nekke kere ñkpọ baña nte afo asịn ukod</para>
  <para style="q2" vid="PRO 4:26">nyʌñ nie iwuuk ke afịd mme usʌñ mfo.<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />Kuuwọññọ udʌk nnasia me ufiin;</para>
  <para style="q2" vid="PRO 4:27">yak ukod mfo awuọ akpọñ idiọọk ñkpọ.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">Ndʌdutọñ ke Abaña Efịbe</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />Ayịn awodeen mmi, kpañ utọñ nọ aniọñ mmi,</para>
  <para style="q2" vid="PRO 5:1">wọññọ utọñ mfo nọ ikọ ifiọk mmi,<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />nọ afo anie mfarakeidem</para>
  <para style="q2" vid="PRO 5:2">ñkpọkinua mfo ñko anịm ifiọk.<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />Sia ñkpọkinua awonwaan akpara atọi adanakwọọk,</para>
  <para style="q2" vid="PRO 5:3">ikọ amọ anyʌñ adọnọ akan adan;<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />ado ke utịd anye adoro nte mfañ atidod,</para>
  <para style="q2" vid="PRO 5:4">asọp nte afịd iso iba.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />Ukod amọ eka ke ñkpa;</para>
  <para style="q2" vid="PRO 5:5">ñkpadisañ amọ aka udi nnen-nnen.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />Anye inieghe akikere ndomokeed ibaña eduuwem;</para>
  <para style="q2" vid="PRO 5:6">usʌñ amọ ayoyo, ado anye idiọọñọke.<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />Idahami ndin, nditọ mmi ideen, ikpañ utọñ innọ miin;</para>
  <para style="q2" vid="PRO 5:7">ikiiwọññọ ikpọñ se ami ntañ inọọ ndufo.<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />Yak usʌñ ndufo anyọọñ akpọñ anye,</para>
  <para style="q2" vid="PRO 5:8">ikiisaña ikpere inuausʌñ ufọk amọ,<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />mbaak ndufo ididuọọk ukpono ndufo inọọ mbon mfen</para>
  <para style="q2" vid="PRO 5:9">ye uku<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">Akeme ido </char><char style="fqa" closed="false">mme isua</char></note> ndufo ñko inọọ awo ndoom,<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />mbaak mme isenawo edibịme inie ndufo</para>
  <para style="q2" vid="PRO 5:10">ndin afịd ufen ndufo akeforo ufọk awo mfen.<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />Ke utịd uwem ndufo, afo ayaatua akuun,</para>
  <para style="q2" vid="PRO 5:11">ke ini abʌk ye ikpọkidem ndufo emaebiara.<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />Ndufo eyaebo, “Se naña ñnyịn ikisua item!</para>
  <para style="q2" vid="PRO 5:12">Naña esịd ñnyịn akesua ntʌnọ!<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />Ami ñkekoppo item mme andikpeeb mmi</para>
  <para style="q2" vid="PRO 5:13">ñnyʌññọ ñwọññọ utọñ mmi nnọ mme anọitem mmi.<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />Ikpeenekekpeene ami mmaadʌk ekamba mfịna</para>
  <para style="q2" vid="PRO 5:14">ke esob ikọd Abasi.”<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />Nwọñ mmọọñ a-atooho ube mmọọñ mfo,</para>
  <para style="q2" vid="PRO 5:15">mmọọñ a-afeghekefeghe ke ube mmọọñ mfo.<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />Me akpena nte idịm mfo afiọrọ ke mme efaak,</para>
  <para style="q2" vid="PRO 5:16">mme mmọọñ idịm mfo eboiyo ke mme eferife?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />Yak ammọ unie fiin ikpọọñ,</para>
  <para style="q2" vid="PRO 5:17">kuudedei uwuana ye mme isenawo.<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />Yak ediọñ ñkpọdiọhọ mmọọñ mfo,</para>
  <para style="q2" vid="PRO 5:18">ñko afo ayaakop inem ke anwaan uyịn mfo.<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />Edima akoyo, uyaiya edob,</para>
  <para style="q2" vid="PRO 5:19">yak eba amọ uyʌkkọ fiin afịd ini,</para>
  <para style="q2" vid="PRO 5:19">yak ima amọ unaam fiin nte ukọd.<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />Ayịn awodeen mmi, nsoo inam yak anwaan awo mfen unaam fiin nte ukọd?</para>
  <para style="q2" vid="PRO 5:20">Nsoo ido nọ afat ikpanesịd awonwaan akpara?<verse eid="PRO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />Sia mme usʌñ mfo enaa ataa inwañ ke iso <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PRO 5:21">ndin anye aduuñọ afịd usʌñ mfo.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />Ndoom mbon ibak ado afia anọ ammọ;</para>
  <para style="q2" vid="PRO 5:22">mme udʌk idiọọkñkpọ ammọ ekpaha ammọ anye asọñ.<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />Ammọ eyaekpa ato ke unana mfarakeidem,</para>
  <para style="q2" vid="PRO 5:23">ndisịme ammọ ayaaben ammọ atịn usʌñ.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">Mme Ndʌdutọñ ke Abaña Ndisịme</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />Ayịn mmi, adieke afo atieghe ubiọñ anọọ mbọhọidʌñ mfo,</para>
  <para style="q2" vid="PRO 6:1">adieke afo atieghe ubiọñ anọọ asenawo,<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />afo amedat ikọ inua mfo akọp idem mfo,</para>
  <para style="q2" vid="PRO 6:2">ikọ inua mfo akappa ado afia unọ fiin.<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />Ayịn mmi, nam ntom nọ afakka idem mfo,</para>
  <para style="q2" vid="PRO 6:3">sia afo umauduọ udʌk ubọk mbọhọidʌñ mfo:</para>
  <para style="q1" vid="PRO 6:3">Kaa, tutu udịd ukweeñe;<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">Akeme ido </char><char style="fq" closed="false">Kaa, </char><char style="fqa" closed="false">nyʌñ suuhọ idem mfo,</char></note></para>
  <para style="q2" vid="PRO 6:3">ndin kuunọọ mbọhọidʌñ mfo emem!<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />Kuudaiya ndomo etək-etək,</para>
  <para style="q2" vid="PRO 6:4">kuuyak idab uyeet fiin.<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />Bọkkọ, nte edob abọkkọ ke ubọk atautob,</para>
  <para style="q2" vid="PRO 6:5">nte inuen abọkkọ andikọọk afia nnọọ anye.<verse eid="PRO 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />Afo ifu, kaa bịne akpaisọñ,</para>
  <para style="q2" vid="PRO 6:6">kpeep mme usʌñ amọ nyʌñ bọ aniọñ!<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />Akpaisọñ inieghe adaiso,</para>
  <para style="q2" vid="PRO 6:7">me aseutom, me andikara,<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />ado anye abon ndidia amọ ke ini ndaayio</para>
  <para style="q2" vid="PRO 6:8">anyʌñ akoono ndidia amọ abon ke ini idọk.<verse eid="PRO 6:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />Ifu, afo uduuna ukpeene die ke itie ado?</para>
  <para style="q2" vid="PRO 6:9">Idaha akee ke afo uduudemme ke idab mfo?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />Etək-etək idab, etək-etək iyeed,</para>
  <para style="q2" vid="PRO 6:10">etək-etək adibọp ubọk nduọk adudu,<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />ndin uweene ayaadi ubịne fiin nte inọ</para>
  <para style="q2" vid="PRO 6:11">unana ñko ayaadi nte awo amauke.<verse eid="PRO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />Awo ntịme ye awo anwan,</para>
  <para style="q2" vid="PRO 6:12">a-asañake ye idiọọk inua ikọ,<verse eid="PRO 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="PRO 6:13" />a-akeppe anyen amọ ke idiọọk usʌñ,</para>
  <para style="q2" vid="PRO 6:13">akama ukod amọ anọ idiọọñọ</para>
  <para style="q2" vid="PRO 6:13">anyʌñ atappa ke nnuunubọk amọ,<verse eid="PRO 6:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 6:14" />a-aduakka ibak ke esịd amọ,</para>
  <para style="q2" vid="PRO 6:14">afịd-afịd ini ana anye asịn mfịna.<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />Ke ntoro nsobo ayaasịm anye inikeed;</para>
  <para style="q2" vid="PRO 6:15">eyaesobo anye usọp-usọp, unwam idiibaaha.<verse eid="PRO 6:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="PRO 6:16" />Ñkpọ itiokeed ke <char style="nd">Abọọñ</char> asua,</para>
  <para style="li2" vid="PRO 6:16">ñkpọ itiaba edo mbubiam enọ anye:<verse eid="PRO 6:16" /></para>
  <para style="li3">
    <verse number="17" style="v" sid="PRO 6:17" />anyen ñkokkoidem,</para>
  <para style="li3" vid="PRO 6:17">edeme nsu,</para>
  <para style="li3" vid="PRO 6:17">ubọk a-aduọkkọ iyiib awo i-imiidueghe ñkpọ,<verse eid="PRO 6:17" /></para>
  <para style="li3">
    <verse number="18" style="v" sid="PRO 6:18" />esịd a-aduakka ibak,</para>
  <para style="li3" vid="PRO 6:18">ñkpad a-asọppọ adinam ndoom,<verse eid="PRO 6:18" /></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 6:19" />ntiense nsu a-ayọhọke ye abiaña</para>
  <para style="li3" vid="PRO 6:19">ye awo a-asịnne mfịna ke abio.<verse eid="PRO 6:19" /></para>
  <para style="s1">Ndʌdutọñ A-abañake Efịbe</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />Ayịn awodeen mmi, nịm ewʌhọ ete mfo</para>
  <para style="q2" vid="PRO 6:20">kuunyʌñ ufre ukpeebñkpọ eka mfo.<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />Kpaha ammọ ke esịd mfo afịd ini;</para>
  <para style="q2" vid="PRO 6:21">bọp ammọ kanna itọñ mfo.<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />Ke usʌñ isañ mfo, ammọ eyaudat fiin usʌñ;</para>
  <para style="q2" vid="PRO 6:22">ke ini afo adaiyake idab, ammọ eyaukpeme fiin;</para>
  <para style="q2" vid="PRO 6:22">afo umaudemme, ammọ eyaetañ ikọ unọ fiin.<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />Sia ewʌhọ ami ado utuenikañ,</para>
  <para style="q2" vid="PRO 6:23">ukpeebñkpọ ami ado unwana,</para>
  <para style="q1" vid="PRO 6:23">ndin ntʌnọ ye item</para>
  <para style="q2" vid="PRO 6:23">edo usʌñ uwem,<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />u-usioho fiin ekpọñ anwaan mbọhọidʌñ mfo,</para>
  <para style="q2" vid="PRO 6:24">ufak fiin esio ke nneem inua awonwaan akpara.<verse eid="PRO 6:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />Kuuyak itọñ udakka ke ntak uyai amọ</para>
  <para style="q2" vid="PRO 6:25">kuunyʌñ uyak anye akama anyen amọ utap fiin.<verse eid="PRO 6:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />Sia amekeme adinie akpara ke ikịme ñkpọ nte eboho uyo keed,</para>
  <para style="q2" vid="PRO 6:26">ado anwaan awo mfen ado ñkpọ se ikeme adidat uwem mfo.<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />Nte awodeen akeme adiwoppo ikañ ndot ke ifʌkkọ amọ</para>
  <para style="q2" vid="PRO 6:27">ndin ikañ ado itaaha afọñ amọ?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />Nte awodeen akeme adisaña ke ufiob ukañ</para>
  <para style="q2" vid="PRO 6:28">ndin ikañ itaaha ukod amọ?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />Kpa ntoro ke ado ye awo a-asịnne efịbe ye anwaan awo mfen;</para>
  <para style="q2" vid="PRO 6:29">ibaaha awo a-atuuhọ anye adiitre adibọ ufen.<verse eid="PRO 6:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />Mme awo itọhọke ye inọ adieke anye ayịppe ñkpọ</para>
  <para style="q2" vid="PRO 6:30">adia ke ntak abiọọñ.<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />Ado adieke emʌmmọ anye, ana anye akpe utịb akañ itiaba,</para>
  <para style="q2" vid="PRO 6:31">akpọkọm akpa anye afịd inie ke ufọk amọ.<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />Ado awo a-asịnne efịbe inieghe eti iwuod;</para>
  <para style="q2" vid="PRO 6:32">awo akeedodo a-anamma ido ami asobo idem amọ.<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />Ntiim ye ndọk edo udeeme amọ,</para>
  <para style="q2" vid="PRO 6:33">ibaaha se idiikan isọọk abuud amọ isio.<verse eid="PRO 6:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />Sia ufịb anam ebe aduọ abom,</para>
  <para style="q2" vid="PRO 6:34">ndin anye idiituaha mbọm ke ini anye asioho usiene.<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />Anye idiinyịmmeke adibọ isob;</para>
  <para style="q2" vid="PRO 6:35">anye ayaasịn ubọkedem, akọm akpekpon die.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s1">Ndʌdutọñ ke Abaña Awonwaan Efịbe</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />Ayịn awodeen mmi, nịm mme ikọ mmi</para>
  <para style="q2" vid="PRO 7:1">nyʌñ dịp mme mbed mmi ke esịd idem mfo.<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />Nịm mme mbed mmi ndin afo ayaadu uwem;</para>
  <para style="q2" vid="PRO 7:2">kpeme mme ukpeebñkpọ mmi nte ñkwaanyen mfo.<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />Bọp ammọ dian ke nnuunubọk mfo;</para>
  <para style="q2" vid="PRO 7:3">wet ammọ ke itiadñwed ikpanesịd mfo.<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />Bo aniọñ, “Afo ado ayịneka mmi awonwaan,”</para>
  <para style="q2" vid="PRO 7:4">nyʌñ bo ikike, “Afo ado ayakka mmi.”<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />Ammọ eyaufak fiin esio ke ubọk awonwaan efịbe,</para>
  <para style="q2" vid="PRO 7:5">ufak esio ke ubọk awonwaan akpara ye nneem inua ikọ amọ.<verse eid="PRO 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />Ke ubenafịm ufọk mmi</para>
  <para style="q2" vid="PRO 7:6">ami mmaada ñnyuuñọ ke abọbọọk nse.<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />Ami mmaakịt ke atu mme akọi,</para>
  <para style="q2" vid="PRO 7:7">ami mmaakịt ke atu mme iwaad,</para>
  <para style="q2" vid="PRO 7:7">akparawa i-imiikinieghe eti iwuod,<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />Anye akesaña ke usʌñ a-akpereke ibiọññọ amọ</para>
  <para style="q2" vid="PRO 7:8">asaña akaa mbeñ ufọk amọ<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />ke isọñ ndubi, naña ayio atọọñọke ifʌk awo idem,</para>
  <para style="q2" vid="PRO 7:9">naña ekịm akonayio adiighe.<verse eid="PRO 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />Ndin awonwaan amaawuọ adisoobo anye,</para>
  <para style="q2" vid="PRO 7:10">asịne afọñ nte akpara anyʌñ anie udọñ ñkara.<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />(Anye asịn ntịme inyʌññọ inie iso abuud,</para>
  <para style="q2" vid="PRO 7:11">akenaanam ñkpad amọ isịneke ke ufọk;<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />idahami anye awuọ anen, idahami anye ke anwa,</para>
  <para style="q2" vid="PRO 7:12">kwa ikọkkọ anye adiana.)<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />Anye amaamʌm akparawa ado anyʌñ atʌm anye inua</para>
  <para style="q2" vid="PRO 7:13">ye unana iso abuud anyʌñ abo anye ate:<verse eid="PRO 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />“Mfịn ami mmesio mme akaaña mmi,</para>
  <para style="q2" vid="PRO 7:14">ndin ami mmenie ndidia a-atooho uwa ewuana ke ufọk.<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />Ado anam ami ñkewuọ ndisoobo ye afo;</para>
  <para style="q2" vid="PRO 7:15">ami mmauyem fiin ndin mmukịt fiin!<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />Ami mmefʌk akwañ mmi</para>
  <para style="q2" vid="PRO 7:16">ye mme mfọọn afọñ linen e-etooho Iyib.<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />Ami mmeduọk pefium ke akwañ mmi</para>
  <para style="q2" vid="PRO 7:17">ake mee, mme alo ye eto sinamọn.<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />Di, yak ñnyịn inekke inwọñ ima tutu usiere;</para>
  <para style="q2" vid="PRO 7:18">yak inọ idem ñnyịn inemesịd ye ima!<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />Ebe mmi ibaaha ke ufọk;</para>
  <para style="q2" vid="PRO 7:19">anye aka anyan usʌñ isañ.<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />Anye amaaben ekpad amọ a-ayọhọke ye akʌk</para>
  <para style="q2" vid="PRO 7:20">ndin idiinyọññọ idi tutu ayọhọ afiọñ keed mfen.”<verse eid="PRO 7:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />Ye mme ikọ nneminua, anye amaaben akparawa ado atịn usʌñ;</para>
  <para style="q2" vid="PRO 7:21">anyʌñ atap anye ye inem ikọ.<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />Inikeed-inikeed anye amaakeene anye</para>
  <para style="q2" vid="PRO 7:22">nte abaakenañ e-ebenne ekaa adiwot</para>
  <para style="q1" vid="PRO 7:22">nte ndisịme edob<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">Ke Hibru </char><char style="fqa" closed="false">ndisịme</char></note> a-adʌkkọ afia<verse eid="PRO 7:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 7:23" />tutu idañ atịppe anye esịd,</para>
  <para style="q1" vid="PRO 7:23">nte inuen a-anekke akedʌk afia,</para>
  <para style="q2" vid="PRO 7:23">idiọọñọke ke uwem imọ ayaatak.<verse eid="PRO 7:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />Ke ntoro, nditọ mmi ideen, ikpañ utọñ innọ miin;</para>
  <para style="q2" vid="PRO 7:24">ikpañ utọñ ikop se ami ntañ.<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />Ikiiyak esịd ndufo akeene mme usʌñ amọ</para>
  <para style="q2" vid="PRO 7:25">me ayooñ adʌk afañ amọ.<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />Anye a-asobo uwak-uwak awo;</para>
  <para style="q2" vid="PRO 7:26">mbon se anye asobo e-ewak eti-eti.<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />Ufọk amọ ado usʌñ abioekpo,</para>
  <para style="q2" vid="PRO 7:27">a-adatta awo aka ubeed ñkpa.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">Ikood Aniọñ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />Ado nte aniọñ ikoodo yak uyio awuọ?</para>
  <para style="q2" vid="PRO 8:1">Ado nte mbufiọk idịppeke uyio amọ?<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />Anye adat itie amọ ke itie se ikoñ ikan ke usʌñ,</para>
  <para style="q2" vid="PRO 8:2">ke itie nte usʌñ asoobo;<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />ke mben inuaatob a-akaaha abio,</para>
  <para style="q2" vid="PRO 8:3">ke inuausʌñ, anye abọñ ke akpọsọñ uyio:<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />“Mme awo, ndufo ke ami ñkoot;</para>
  <para style="q2" vid="PRO 8:4">Ami mmedịppe uyio mmi ñkoot afịd ubonawo.<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />Ndufo e-edooho mme akọi, ibọ ndiọọñọidem;</para>
  <para style="q2" vid="PRO 8:5">ndufo e-edooho ndisịme, iwuuk esịd ndufo ke anye<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">Septuakin; Ke Hibru </char><char style="fq" closed="false">ndisịme, </char><char style="fqa" closed="false">inọ idem ndufo ukpeebñkpọ</char></note>.<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />Ikpañ utọñ, sia ami mmenie mme akpan ñkpọ aditañ;</para>
  <para style="q2" vid="PRO 8:6">ami ñkʌppọ inua mmi aditañ se inen.<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />Inua mmi atañ se ido akpanikọ,</para>
  <para style="q2" vid="PRO 8:7">sia ñkpọkinua mmi imaaha ibak.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Afịd ikọ ke inua mmi edo ndinen;</para>
  <para style="q2" vid="PRO 8:8">ibaaha ndomokeed a-akwañake me a-adooho abʌd-abʌd.<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />Afịd ammọ edo nnen-nnen enọ mbon se inie ikike;</para>
  <para style="q2" vid="PRO 8:9">ammọ edo nnen-nnen enọ mbon se ikịt ifiọk.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />Mek item mmi utu ke silfa</para>
  <para style="q2" vid="PRO 8:10">ifiọk utu ke eti kold,<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />sia aniọñ a-asọñudua akan nti rubi,</para>
  <para style="q2" vid="PRO 8:11">ndin ibaaha se afo ayem e-ekanna eben edomo ye anye.<verse eid="PRO 8:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />“Ami, aniọñ, ndʌñ keed ye ndiọọñọidem;</para>
  <para style="q2" vid="PRO 8:12">ñnyʌñ nnie ifiọk ye mfarakeidem.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />Adibaak <char style="nd">Abọọñ</char> ado adisua idiọọkñkpọ;</para>
  <para style="q2" vid="PRO 8:13">Ami mmesua ñkokkoidem ye asian,</para>
  <para style="q2" vid="PRO 8:13">ibak adinam ye abʌd-abʌd ikọ.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />Item ye eti iwuod edo ake mmi;</para>
  <para style="q2" vid="PRO 8:14">ami mmenie ikike, mmenie adudu.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />Ato ke ami ndidem ekaara</para>
  <para style="q2" vid="PRO 8:15">mme andikara enyʌñ enọ ewʌhọ se inen;<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />ato ke ami nditọ ideen abọọñ ekaara,</para>
  <para style="q2" vid="PRO 8:16">mme ndinen awo, afịd mbon e-ekaarake ke ederimbod.<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />Ami mmema mbon se imma miin,</para>
  <para style="q2" vid="PRO 8:17">mbon se iñyem miin enyʌñ eñkịt miin.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />Inie ye ukpono eba ye ami,</para>
  <para style="q2" vid="PRO 8:18">nsi-nsi inie ye uforo.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />Mfịd mmi a-afọn akan eti kold;</para>
  <para style="q2" vid="PRO 8:19">se ami ñnwịm a-afọn akan ataa eti silfa.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />Ami nsaña ke usʌñ adinenido,</para>
  <para style="q2" vid="PRO 8:20">ke mme usʌñ unen,<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />nnọ mbon se imma miin udeeme uwak ñkpọ</para>
  <para style="q2" vid="PRO 8:21">ñnyʌñ nnam akebe inie ammọ ayọhọ.<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />“<char style="nd">Abọọñ</char> akensio miin nte akpa ke atu mme ubọkutom amọ,</para>
  <para style="q2" vid="PRO 8:22">mbemiso mme utom amọ ke esed;<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />ekembot miin ke ataa esed koo,</para>
  <para style="q2" vid="PRO 8:23">ke ataa ntọọñọ, ke idaha ederimbod aketọọñọke.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />Ke idaha utʌñọ mmọọñ imiikibaaha, ke ekemman miin,</para>
  <para style="q2" vid="PRO 8:24">ke idaha mme idịm e-ekeyọhọke ye mmọọñ imiikibaaha;<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />mbemiso mme ikpọabod ekebono ke itie,</para>
  <para style="q2" vid="PRO 8:25">mbemiso ntək abod ekeba, emaemman miin,<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />mbemiso anye akebot ederimbod me mme inwañ</para>
  <para style="q2" vid="PRO 8:26">me abu ndomokeed ke ekondo.<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />Ami mmọdo ñkeba do idaha anye akewuuhọ mme hefịn ke itie,</para>
  <para style="q2" vid="PRO 8:27">idaha anye akebakkake isọñ ye anyọñ asio ke anyọñ iso udem,<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />idaha anye akedaahake ntọñanyọñ ke anyọñ</para>
  <para style="q2" vid="PRO 8:28">akenyʌññọ awuuk mme mmọọñ ke udem,<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />idaha anye akenọọhọ akpainyañ adaña amọ</para>
  <para style="q2" vid="PRO 8:29">mbaak mme mmọọñ ediboiyo ewʌhọ amọ,</para>
  <para style="q1" vid="PRO 8:29">ye ke ini anye akebakkake itiad idakisọñ ederimbod.<verse eid="PRO 8:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30" />Ini ado ami ñkikpọññọ ñkañ amọ.</para>
  <para style="q1" vid="PRO 8:30">Ami ñkeyọhọ ye idadesịd afịd usen,</para>
  <para style="q2" vid="PRO 8:30">ndaara adiba ke iso amọ afịd ini,<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />ñkop inemesịd ke afịd ederimbod amọ</para>
  <para style="q2" vid="PRO 8:31">ñnyʌñ ndaara ke ubonawo.<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />“Ke ntoro, nditọ mmi, ikpañ utọñ innọ miin;</para>
  <para style="q2" vid="PRO 8:32">afọfọn anọ mbon e-esañake ke mme usʌñ mmi.<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Ikpañ utọñ nọ item mmi inyʌñ ibọ aniọñ;</para>
  <para style="q2" vid="PRO 8:33">ikiisịn item mmi.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />Afọfọn anọ mbon e-ekpañña utọñ ennọ miin,</para>
  <para style="q2" vid="PRO 8:34">enịm ukpeme ke mme usʌñ mmi afịd usen,</para>
  <para style="q2" vid="PRO 8:34">etie ebet ke inuausʌñ mmi.<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />Sia mbon se iñkịt miin e-ekịt uwem</para>
  <para style="q2" vid="PRO 8:35">enyʌñ ebọ mfọn eto <char style="nd">Abọọñ</char>.<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />Ado mbon e-etreke adiñyem miin enam idem ammọ ibak;</para>
  <para style="q2" vid="PRO 8:36">afịd mbon e-ensuaha miin ema ñkpa.”<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">Mme Ikood Aniọñ ye Ndisịme</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />Aniọñ a-abọp ufọk amọ;</para>
  <para style="q2" vid="PRO 9:1">anye awuuk mboi amọ itiaba.<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />Anye a-atem ndidia amọ anyʌñ awuak ukọd amọ;</para>
  <para style="q2" vid="PRO 9:2">anye ñko abịt akpokoro ndidia amọ.<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />Anye a-asio nditọufọk amọ adọñ, anye ñko ada ko ke itie</para>
  <para style="q2" vid="PRO 9:3">akoñño akan ke abio akoot,<verse eid="PRO 9:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 9:4" />“Yak afịd mme akọi edi ufọk mmi!”</para>
  <para style="q1" vid="PRO 9:4">Anye abo mbon i-imiinieghe eti iwuod,<verse eid="PRO 9:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PRO 9:5" />“Idi, idia ndidia mmi</para>
  <para style="q2" vid="PRO 9:5">inyʌñ inwọñ ukọd ake ami ñwuaha.<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />Ikpọñ akọi-akọi usʌñ ndufo ndin ndufo eyaedu uwem;</para>
  <para style="q2" vid="PRO 9:6">isaña ke usʌñ ikike.”<verse eid="PRO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />Awo akeedodo a-akịtte ndudue anọ asak awo ñkpọ akoot usọñanyen anọ idem amọ;</para>
  <para style="q2" vid="PRO 9:7">awo akeedodo a-asuaha anọ awo ibak adat nsueñ anọ idem amọ.<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />Kuusua unọọ mme asak awo ñkpọ imiidooho ammọ eyausua fiin;</para>
  <para style="q2" vid="PRO 9:8">sua nọ mbon aniọñ ndin ammọ eyauma fiin.<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />Nọ mbon aniọñ item ndin ammọ eyaenenekke enie aniọñ;</para>
  <para style="q2" vid="PRO 9:9">kpeep ndinen awo ndin ammọ eyaedian ke ukpeebñkpọ ammọ.<verse eid="PRO 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />Mbaak <char style="nd">Abọọñ</char> ado ntọọñọ aniọñ,</para>
  <para style="q2" vid="PRO 9:10">ndin ifiọk Andisana Ñkan ado mbufiọk.<verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />Sia adiito ke aniọñ isua uwem mfo awak,</para>
  <para style="q2" vid="PRO 9:11">eyaenyʌñ edian uwak isua ke uwem mfo.<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />Adieke afo anieghe aniọñ, anye ayaunọ fiin utịb;</para>
  <para style="q2" vid="PRO 9:12">adieke afo adooho asak awo ñkpọ, afo uduubọ ufen ikpọọñ.<verse eid="PRO 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />Atịme-atịme awonwaan ado ndisịme;</para>
  <para style="q2" vid="PRO 9:13">anye ado akọi inyʌññọ idiọọñọ ñkpọ ndomokeed.<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />Anye atie ke inuausʌñ ufọk amọ,</para>
  <para style="q2" vid="PRO 9:14">ke ñkpọitie ke itie se ikoñ ikan ke abio,<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />akoot mbon se isaña iboiyo,</para>
  <para style="q2" vid="PRO 9:15">e-eboiyoke nnen-nnen ekaa ndubeghe ammọ,<verse eid="PRO 9:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="PRO 9:16" />“Yak afịd mme akọi edi ufọk mmi!”</para>
  <para style="q1" vid="PRO 9:16">Anye abo mbon i-imiinieghe eti iwuod ate,<verse eid="PRO 9:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 9:17" />“Uyeyịp mmọọñ a-anem;</para>
  <para style="q2" vid="PRO 9:17">ndidia edịbekedịbe edia anem!”<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />Ado ammọ idiọọñọke ke mme akpañkpa mmọdo eba,</para>
  <para style="q2" vid="PRO 9:18">ke mme isenawo amọ eba ke abioekpo.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="ms1">Mme Ñke Sọlọmọn</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />Mme ñke Sọlọmọn:</para>
  <para style="q1" vid="PRO 10:1">Ayịn awodeen a-anieghe aniọñ aben inemesịd asọk ete amọ,</para>
  <para style="q2" vid="PRO 10:1">ado ndisịme ayịn aben mfʌhọ asọk eka amọ.<verse eid="PRO 10:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />Ndiọi inie iseeneke awo ikpeene,</para>
  <para style="q2" vid="PRO 10:2">ado adinenido afak awo asio ke ñkpa.<verse eid="PRO 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />
    <char style="nd">Abọọñ</char> iyakka adinen awo atie abiọọñ,</para>
  <para style="q2" vid="PRO 10:3">ado anye abiat udọñ mbon ibak.<verse eid="PRO 10:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />Ubọk ifu anam awo aweene,</para>
  <para style="q2" vid="PRO 10:4">ado ubọk anam utom akọ inie.<verse eid="PRO 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />Awo a-akọọhọ mbunwịm ke ini idọk ado adiọọñọidem ayịn,</para>
  <para style="q2" vid="PRO 10:5">ado anye a-adaiyake idab ke ini idọk ado ayịn ndọk.<verse eid="PRO 10:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />Uwak adidiọñ ado anyanya adinen awo,</para>
  <para style="q2" vid="PRO 10:6">ado afai akan inua awo ibak.<verse eid="PRO 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />Anyịñ adinen awo ke ekama ke adidiọñ,</para>
  <para style="q2" vid="PRO 10:7">ado anyịñ awo ibak ayaabiara.<verse eid="PRO 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />Awo aniọñ anyịmme mme ewʌhọ,</para>
  <para style="q2" vid="PRO 10:8">ado akprak inua ndisịme akịt nsobo.<verse eid="PRO 10:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />Awo akeedodo a-asañake ke akpanikọ asaña ke ifuuro,</para>
  <para style="q2" vid="PRO 10:9">ado awo akeedodo a-asañake ke ñkwaña usʌñ, awo idiitreke adiyaara anye.<verse eid="PRO 10:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />Awo akeedodo a-akeppe anyen ke idiọọk usʌñ aben mfʌhọ adi,</para>
  <para style="q2" vid="PRO 10:10">ndin akprak inua ndisịme adʌk nsobo.<verse eid="PRO 10:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />Inua adinen awo ado idịm mmọọñuwem,</para>
  <para style="q2" vid="PRO 10:11">ado inua awo ibak adịp afai.<verse eid="PRO 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />Usua asịn utọk,</para>
  <para style="q2" vid="PRO 10:12">ado ima afʌk afịd ndudue.<verse eid="PRO 10:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />Aniọñ aba ke inua awo eti iwuod,</para>
  <para style="q2" vid="PRO 10:13">ado ikpa ana anọ edem ndisịme.<verse eid="PRO 10:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />Awo aniọñ abok ifiọk anịm,</para>
  <para style="q2" vid="PRO 10:14">ado inua ndisịme akoot nsobo.<verse eid="PRO 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />Inie imọ awo ado akpọsọñ abio ammọ,</para>
  <para style="q2" vid="PRO 10:15">unana ado nsobo mbon uweene.<verse eid="PRO 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />Utịb adinen awo ado uwem,</para>
  <para style="q2" vid="PRO 10:16">ado udod awo ibak ado idiọọkñkpọ ye ñkpa.<verse eid="PRO 10:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />Awo akeedodo a-akoppo ntʌnọ awọt usʌñ uwem,</para>
  <para style="q2" vid="PRO 10:17">ado awo akeedodo a-asuaha item atịn mbon mfen usʌñ.<verse eid="PRO 10:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />Awo akeedodo a-akamake nsu-nsu ñkpọkinua adịp usua</para>
  <para style="q2" vid="PRO 10:18">anyʌñ asuan ikọedem ado ndisịme.<verse eid="PRO 10:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />Idiọọkñkpọ itreke ke uwak ikọ,</para>
  <para style="q2" vid="PRO 10:19">ado mme adiọọñọidem awo efat edeme ammọ.<verse eid="PRO 10:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />Edeme adinen awo ado nsọñudua silfa,</para>
  <para style="q2" vid="PRO 10:20">ado esịd awo ibak inieghe ufọn ndomokeed.<verse eid="PRO 10:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />Ñkpọkinua adinen awo abọọk uwak awo,</para>
  <para style="q2" vid="PRO 10:21">ado mme ndisịme ekpañña eto unana ifiọk.<verse eid="PRO 10:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />Adidiọñ <char style="nd">Abọọñ</char> asaña ye inie,</para>
  <para style="q2" vid="PRO 10:22">akpọsọñ ufen isịneke.<verse eid="PRO 10:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />Ndisịme akop inem ke ibak akikere,</para>
  <para style="q2" vid="PRO 10:23">ado awo mbufiọk akop inem ke aniọñ.<verse eid="PRO 10:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />Se mbon ibak efeghe ayaasịme ammọ,</para>
  <para style="q2" vid="PRO 10:24">eyaenọ adinen awo udọñ esịd amọ.<verse eid="PRO 10:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />Ayobio amaafịme iboiyo, mbon ibak esop,</para>
  <para style="q2" vid="PRO 10:25">ado ndinen awo esọọñọ eda ke nsi-nsi.<verse eid="PRO 10:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />Kpa naña fineka aba ke eded ye naña nsʌñikañ aba ke anyen,</para>
  <para style="q2" vid="PRO 10:26">kpa ntoro ke mbon ifu eba ye mbon se idọñ ammọ.<verse eid="PRO 10:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />Uteeñe <char style="nd">Abọọñ</char> adian isua ke uwem,</para>
  <para style="q2" vid="PRO 10:27">ado eyaesio isua uwem awo ibak.<verse eid="PRO 10:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />Idodanyen adinen awo ado inemesịd,</para>
  <para style="q2" vid="PRO 10:28">ado idodanyen awo ibak ayaatak.<verse eid="PRO 10:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />Usʌñ <char style="nd">Abọọñ</char> ado itie udịbe anọ mfọnmma awo,</para>
  <para style="q2" vid="PRO 10:29">ado anye ado nsobo anọ mme anamidiọọk.<verse eid="PRO 10:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />Tutu amama awo idiisịkkeke adinen awo,</para>
  <para style="q2" vid="PRO 10:30">ado awo ibak idiidʌññọ ke isọñ.<verse eid="PRO 10:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />Mbunwịm aniọñ ato ke inua adinen awo,</para>
  <para style="q2" vid="PRO 10:31">ado atịme edeme ayaadobo.<verse eid="PRO 10:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />Ñkpọkinua ndinen awo e-ediọọñọ ñkpọ se ikịt mfọn,</para>
  <para style="q2" vid="PRO 10:32">ado inua awo ibak adiọọñọ ñkpọ se idiọọk kpọd.<verse eid="PRO 10:32" /></para>
  <para style="b" />
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />
    <char style="nd">Abọọñ</char> asua udomoñkpọ abiaña,</para>
  <para style="q2" vid="PRO 11:1">ado eti udomoñkpọ akịt mfọn ke iso amọ.<verse eid="PRO 11:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />Ntañidem amaadi, ndin asuenne adi ñko,</para>
  <para style="q2" vid="PRO 11:2">ado nsuukidem asaña ye aniọñ.<verse eid="PRO 11:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />Etiido ndinen awo adat ammọ usʌñ,</para>
  <para style="q2" vid="PRO 11:3">ado nsu-nsu uwem asobo mbon ñwo.<verse eid="PRO 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />Inie ado ikpu-ikpu ke usen abom,</para>
  <para style="q2" vid="PRO 11:4">ado adinenido afak awo asio ke ñkpa.<verse eid="PRO 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />Adinenido mbon mfọnmma anam usʌñ ammọ anen,</para>
  <para style="q2" vid="PRO 11:5">ado mbon ibak ekịt nsobo eto ke ndiọi ido ammọ.<verse eid="PRO 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />Adinenido nti awo afak ammọ,</para>
  <para style="q2" vid="PRO 11:6">ado ndiọi udọñ mbon mbubịk asịn ammọ ukad.<verse eid="PRO 11:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />Idodanyen ke idem ñkaña awo akpa ye ammọ;</para>
  <para style="q2" vid="PRO 11:7">afịd enwọñọ adudu ammọ ado ikpu-ikpu.<verse eid="PRO 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />Emaenyaaña adinen awo isio ke mfịna,</para>
  <para style="q2" vid="PRO 11:8">mfịna ado akappa akeene awo ibak.<verse eid="PRO 11:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />Abʌd-abʌd awo akama inua amọ abiat mme mbọhọidʌñ amọ,</para>
  <para style="q2" vid="PRO 11:9">ado ato ke ifiọk ndinen awo ebọkkọ.<verse eid="PRO 11:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />Ndinen awo emaeforo, abio edaara;</para>
  <para style="q2" vid="PRO 11:10">ado mbon ibak emaekịt nsobo, esio ñkpo idaara.<verse eid="PRO 11:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />Ato ke adidiọñ ndinen awo abio aforo,</para>
  <para style="q2" vid="PRO 11:11">ado ato ke inua mbon ibak abio akịt nsobo.<verse eid="PRO 11:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />Awo akeedodo a-asuenneke mbọhọidʌñ amọ inieghe eti iwuod,</para>
  <para style="q2" vid="PRO 11:12">ado awo mbufiọk afat edeme amọ.<verse eid="PRO 11:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />Awo mbia ayaara ikọ esịdidịb,</para>
  <para style="q2" vid="PRO 11:13">ado awo akpanikọ anịm ndedịbe ikọ.<verse eid="PRO 11:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />Unana ndadusʌñ anam idịd aduọ,</para>
  <para style="q2" vid="PRO 11:14">ado adikan ato uwak mme anọitem.<verse eid="PRO 11:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />Awo akeedodo a-atieghe ubiọñ anọ asenawo itreke adidʌk mfịna,</para>
  <para style="q2" vid="PRO 11:15">ado awo akeedodo a-asịnne aditie ubiọñ aba ke ifuuro.<verse eid="PRO 11:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />Awonwaan esịd mbọm abọ ukpono,</para>
  <para style="q2" vid="PRO 11:16">ado ideen unana mbọm ebọ inie kpọd.<verse eid="PRO 11:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />Mbon e-efọnnọ ido efọn mfọn enọ idem ammọ,</para>
  <para style="q2" vid="PRO 11:17">ado mbon ndoom eben nsobo esọk idem ammọ.<verse eid="PRO 11:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />Awo ibak adia akʌk atahade,</para>
  <para style="q2" vid="PRO 11:18">ado awo a-atọọhọ adinenido adọk eti udod.<verse eid="PRO 11:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />Ke akpanikọ adinen awo anie uwem,</para>
  <para style="q2" vid="PRO 11:19">ado awo akeedodo a-afegheke akeene idiọọk ido akịt ñkpa.<verse eid="PRO 11:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />Esịd a-atek <char style="nd">Abọọñ</char> abaña mbon e-enieghe abʌd-abʌd esịd,</para>
  <para style="q2" vid="PRO 11:20">ado anye a-akop inemesịd abaña mbon u-usʌñ ammọ ananake ndo.<verse eid="PRO 11:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />Nekke diọọñọ ami: Awo ibak idiitreke adibọ ufen,</para>
  <para style="q2" vid="PRO 11:21">ado ndinen awo eyaebọkkọ.<verse eid="PRO 11:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />Naña ñkpannuun kold aba ke inua edi</para>
  <para style="q2" vid="PRO 11:22">kpa ukem ado ke uyaiya awonwaan ammiinieghe mfarakeidem aba.<verse eid="PRO 11:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />Udọñ adinen awo atre ke eti kpọd,</para>
  <para style="q2" vid="PRO 11:23">ado idodanyen awo ibak atre ke iyadesịd.<verse eid="PRO 11:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />Awo a-adooho ubọk enọenọ, asʌk anenekke amọinyọ;</para>
  <para style="q2" vid="PRO 11:24">ado awo efaam atak kpa ke uweene.<verse eid="PRO 11:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />Awo ubọk enọenọ ayaaforo;</para>
  <para style="q2" vid="PRO 11:25">awo akeedodo a-afọnnọ mfọn ye mbon mfen eyaefọn mfọn ye anye ñko.<verse eid="PRO 11:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />Mme awo esịn isuuñọ enọ awo a-amʌmmọ ñkpọ ndidia anịm,</para>
  <para style="q2" vid="PRO 11:26">ado ebeeñe adidiọñ Abasi enọ awo a-abeeñeke idem adinyam ndidia.<verse eid="PRO 11:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />Awo akeedodo a-ayemme eti ñkpọ akịt mfọn,</para>
  <para style="q2" vid="PRO 11:27">ado mfịna asịm awo a-ayemme nsobo.<verse eid="PRO 11:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />Mbon e-ebuọttọ idem ke inie ammọ eyaeduọ,</para>
  <para style="q2" vid="PRO 11:28">ado ndinen awo eyaeseghe nte awawa mfañ.<verse eid="PRO 11:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />Afịm kpọd adiido udeeme awo ndomokeed a-adatta nsobo asọk ufọk amọ,</para>
  <para style="q2" vid="PRO 11:29">ndin ndisịme adiido ayịnufọk anọ awo aniọñ.<verse eid="PRO 11:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />Mbunwịm adinen awo ado eto uwem,</para>
  <para style="q2" vid="PRO 11:30">ndin awo a-anieghe aniọñ anyaaña mme uwem.<verse eid="PRO 11:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />Adieke ndinen awo ebọọhọ utịb ammọ mi ke isọñ,</para>
  <para style="q2" vid="PRO 11:31">nwaanwa dise mbon i-imiidiọọñọke Abasi ye mme anam idiọọkñkpọ!<verse eid="PRO 11:31" /></para>
  <para style="b" />
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />Awo akeedodo a-amaaha ntʌnọ ama ifiọk,</para>
  <para style="q2" vid="PRO 12:1">ado awo akeedodo a-asuaha item ado ndisịme.<verse eid="PRO 12:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />Nti awo ebọ mfọn eto <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PRO 12:2">ado anye abiom mbon se inie akikere ibak ikpe.<verse eid="PRO 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />Awo ndomokeed ikemeke inie iwuuk ato ke ndoom,</para>
  <para style="q2" vid="PRO 12:3">ado awo ikanna ibʌkkọ adʌñ adinen awo.<verse eid="PRO 12:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />Anwaan eti edu ado anyanya ebe amọ,</para>
  <para style="q2" vid="PRO 12:4">ado idiọọk anwaan esuenne atie nte ñkpọ a-akwaattakwaat akpọ amọ.<verse eid="PRO 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />Mme uduak adinen awo edo nnen-nnen,</para>
  <para style="q2" vid="PRO 12:5">ado item awo ibak ado abiaña.<verse eid="PRO 12:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />Ikọ awo ibak adịbe abet iyiib,</para>
  <para style="q2" vid="PRO 12:6">ado ikọ adinen awo afak ammọ.<verse eid="PRO 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />Ebọ mbon ibak itie ndin ammọ ibaaha aba,</para>
  <para style="q2" vid="PRO 12:7">ado ufọk adinen awo ada ke nsi-nsi.<verse eid="PRO 12:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />Etooro awo ekeene ndiọọñọidem amọ,</para>
  <para style="q2" vid="PRO 12:8">ado esọọn awo a-anieghe idiọọk esịd.<verse eid="PRO 12:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />A-afọn awo aditre adido ñkpọ ndomokeed ado anie ayịnufọk</para>
  <para style="q2" vid="PRO 12:9">akan adinam nte anye a-anie se ado ndin inieghe se adia.<verse eid="PRO 12:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />Ndinen awo ese ñkpọ ebaña ufọn mme unam ammọ,</para>
  <para style="q2" vid="PRO 12:10">ado mfọnñkan nti ido ndiọi awo edo ibak.<verse eid="PRO 12:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />Mbon se inam utom ke inwañ ammọ eyaenie akpọmiọk ndidia,</para>
  <para style="q2" vid="PRO 12:11">ado mbon se ifeghe ikeene ndukpọñ inieghe eti iwuod.<verse eid="PRO 12:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />Mbon ibak eyem akpọsọñ itie ndiọi awo,</para>
  <para style="q2" vid="PRO 12:12">ado adʌñ ndinen awo eda ke nsi-nsi.<verse eid="PRO 12:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />Abʌd-abʌd ikọ ndiọi awo edo afia anọ ammọ,</para>
  <para style="q2" vid="PRO 12:13">ndin ndinen awo ebọkkọ mfịna.<verse eid="PRO 12:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />Ato ke mfịd ñkpọkinua ammọ mbon awo eyọhọ ye nti ñkpọ,</para>
  <para style="q2" vid="PRO 12:14">ndin ubọkutom ammọ anọ ammọ utịb.<verse eid="PRO 12:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />Usʌñ mbon ndisịme atie nte eti usʌñ anọ ammọ,</para>
  <para style="q2" vid="PRO 12:15">ado mbon aniọñ ekpañ utọñ enọ item.<verse eid="PRO 12:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />Mbon ndisịme esọsọp ewọt iyadesịd,</para>
  <para style="q2" vid="PRO 12:16">ado adiọọñọidem awo iseeghe usọñanyen.<verse eid="PRO 12:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />Ntiense akpanikọ atañ akpanikọ,</para>
  <para style="q2" vid="PRO 12:17">ado ntiense nsu asʌhọ nsu.<verse eid="PRO 12:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />Mme ikọ anana iwuod awo ekịm nte mme eduad,</para>
  <para style="q2" vid="PRO 12:18">ado edeme mbon aniọñ anọ ukọk.<verse eid="PRO 12:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />Ñkpọkinua akpanikọ aba ke nsi-nsi,</para>
  <para style="q2" vid="PRO 12:19">ado edeme abiaña aba ke etək-etək ini.<verse eid="PRO 12:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />Abiaña asịne ke esịd mbon e-eduakka ndoom,</para>
  <para style="q2" vid="PRO 12:20">ado mbon e-eyemme emem enie idaara.<verse eid="PRO 12:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />Idiọọk ndomokeed isịmme adinen awo,</para>
  <para style="q2" vid="PRO 12:21">ado mbon ibak enie uwak-uwak mfịna.<verse eid="PRO 12:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />
    <char style="nd">Abọọñ</char> asua mme edeme nsu,</para>
  <para style="q2" vid="PRO 12:22">ado anye akop inemesịd abaña mbon akpanikọ.<verse eid="PRO 12:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />Mme adiọọñọidem awo enịm ifiọk ammọ enọ idem ammọ</para>
  <para style="q2" vid="PRO 12:23">ado esịd ndisịme asuan ndisịme amọ.<verse eid="PRO 12:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />Mme ubọk anam utom eyaekara,</para>
  <para style="q2" vid="PRO 12:24">ado utịd ifu adiisuuk ke ufefiik utom.<verse eid="PRO 12:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />Ayeemensia anam esịd awo adoppo,</para>
  <para style="q2" vid="PRO 12:25">ado eti ikọ anọ awo inemesịd.<verse eid="PRO 12:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />Ndinen awo etʌm emek mme ufan ammọ,</para>
  <para style="q2" vid="PRO 12:26">ado usʌñ mbon ibak adat ammọ awuọ akpọñ usʌñ.<verse eid="PRO 12:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />Mbon ifu ifọppọ utotob unam,</para>
  <para style="q2" vid="PRO 12:27">ado ubọk anam utom adia ato mme uwak unam se atop.<verse eid="PRO 12:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />Ke usʌñ adinenido uwem mmọdo;</para>
  <para style="q2" vid="PRO 12:28">ke usʌñ ado ke nsi-nsi uwem aba.<verse eid="PRO 12:28" /></para>
  <para style="b" />
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />Anieiwuod ayịn akop item ete amọ,</para>
  <para style="q2" vid="PRO 13:1">ado awo nsaha ikoppo nduaiya.<verse eid="PRO 13:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />Mme awo ebọ nti ufọn eto mfịd inua ammọ,</para>
  <para style="q2" vid="PRO 13:2">ado mbon abiaña enie udọñ enọ afai.<verse eid="PRO 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />Mbon e-ekpemeke inua ammọ ekpeme uwem ammọ,</para>
  <para style="q2" vid="PRO 13:3">ado mbon etañña ikọ isa-isa itreke ikịt mbiara.<verse eid="PRO 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />Awo ifu ikoppo uyʌkkọ,</para>
  <para style="q2" vid="PRO 13:4">ado ubọk anam utom ayaanie ayọhọ uyʌkkọ.<verse eid="PRO 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />Adinen awo asua abiaña,</para>
  <para style="q2" vid="PRO 13:5">ado mbon ibak edat</para>
  <para style="q2" vid="PRO 13:5">abuud ye asuenne enọ idem ammọ.<verse eid="PRO 13:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />Adinenido akpeme awo akpanikọ,</para>
  <para style="q2" vid="PRO 13:6">ado ibak akan anamidiọọk.<verse eid="PRO 13:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />Awo keed anam nte ido imọ awo, ado inieghe ñkpọ ndomokeed;</para>
  <para style="q2" vid="PRO 13:7">awo mfen anam nte ido uweene, ado anie uwak inie.<verse eid="PRO 13:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />Inie awo akeme adifak uwem ammọ,</para>
  <para style="q2" vid="PRO 13:8">ado uweene ikanna ibọọrọ nduaiya.<verse eid="PRO 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />Unwana adinen awo anekke ayamma,</para>
  <para style="q2" vid="PRO 13:9">ado efuut utuenikañ awo ibak eniime.<verse eid="PRO 13:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />Itie nte afanekọñ aba, ntañidem aba ke ndo,</para>
  <para style="q2" vid="PRO 13:10">ado ekịt aniọñ ye mbon se ikop item.<verse eid="PRO 13:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />Akʌk abiaña inieghe nsọọñọnda,</para>
  <para style="q2" vid="PRO 13:11">ado awo a-anwanake akʌk amọ ntək-ntək anam anye atọt.<verse eid="PRO 13:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />Usiondod idodanyen anam esịd adọñọ,</para>
  <para style="q2" vid="PRO 13:12">ado udọñ a-awuọhọ awọt idem ado eto uwem.<verse eid="PRO 13:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />Awo akeedodo a-asuaha item ayaabọ idiọọk utịb,</para>
  <para style="q2" vid="PRO 13:13">ado awo akeedodo a-akponoke ewʌhọ ayaabọ eti utịb.<verse eid="PRO 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />Ukpeebñkpọ awo aniọñ ado idịm mmọọñuwem,</para>
  <para style="q2" vid="PRO 13:14">awọññọ awo asio ke afia ñkpa.<verse eid="PRO 13:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />Etiiwuod abọ mfọn,</para>
  <para style="q2" vid="PRO 13:15">ado usʌñ abʌd-abʌd awo adat ammọ akaa nsobo.<verse eid="PRO 13:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />Afịd mme adiọọñọidem awo enam ñkpọ ye ifiọk,</para>
  <para style="q2" vid="PRO 13:16">ado mme ndisịme eyaara ndisịme ammọ.<verse eid="PRO 13:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />Isʌñutom ibak aduọ adʌk ntịme,</para>
  <para style="q2" vid="PRO 13:17">ado eti asañautom asaña ye ukọk.<verse eid="PRO 13:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />Awo akeedodo a-asịnne ntʌnọ akịt uweene ye nsobo,</para>
  <para style="q2" vid="PRO 13:18">ado awo akeedodo a-akoppo item abọ ukpono.<verse eid="PRO 13:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />Udọñ a-awuọhọ asu anọ ukpọñ inemesịd,</para>
  <para style="q2" vid="PRO 13:19">ado mme ndisịme esua ediwọññọ ñkpọñ idiọọk.<verse eid="PRO 13:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />Saña ye mbon aniọñ nyʌñ kappa do awo aniọñ,</para>
  <para style="q2" vid="PRO 13:20">sia nsaña ndisịme awo adia ndọk.<verse eid="PRO 13:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />Mfịna abịne anamidiọọk,</para>
  <para style="q2" vid="PRO 13:21">ado ndinen awo ebọ utịb nti ñkpọ.<verse eid="PRO 13:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />Eti awo anịm udeeme ñkpọ anọ nditọ nditọ amọ,</para>
  <para style="q2" vid="PRO 13:22">ado inie idiọọk awo ana anọ adinen awo.<verse eid="PRO 13:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />Ufa ikọd asio ndidia anọ uweene,</para>
  <para style="q2" vid="PRO 13:23">ado utʌk akwọọk anye aduọọk.<verse eid="PRO 13:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />Awo akeedodo a-asaanake ikpa ayaak a-asua nditọ amọ,</para>
  <para style="q2" vid="PRO 13:24">ado awo a-amaaha nditọ ammọ a-atịñ anyen atʌnọ ammọ.<verse eid="PRO 13:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />Ndinen awo edia ekop uyʌkkọ ke esịd ammọ,</para>
  <para style="q2" vid="PRO 13:25">ado idịb awo ibak atie abiọọñ.<verse eid="PRO 13:25" /></para>
  <para style="b" />
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />Awonwaan aniọñ adiọñ ufọk amọ,</para>
  <para style="q2" vid="PRO 14:1">ado ndisịme awonwaan akama ubọk amọ awuut ake amọ.<verse eid="PRO 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />Awo keed akeedodo a-abaaha <char style="nd">Abọọñ</char> asaña nnen-nnen,</para>
  <para style="q2" vid="PRO 14:2">ado mbon e-eseeghe anye ke mbio edo mbon se usʌñ ammọ akwaña.<verse eid="PRO 14:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />Inua ndisịme aduat ye ntañidem,</para>
  <para style="q2" vid="PRO 14:3">ado ñkpọkinua mbon aniọñ akpeme ammọ.<verse eid="PRO 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />Mme abaakenañ imiibaaha, usịnudia ufene ana ukpọk,</para>
  <para style="q2" vid="PRO 14:4">ado inweek abaakenañ anam mbunwịm awak.<verse eid="PRO 14:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />Ntiense akpanikọ ibiañake,</para>
  <para style="q2" vid="PRO 14:5">ado ntiense abiaña asiooño nsu ke inua.<verse eid="PRO 14:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />Asak awo ñkpọ ayem aniọñ ado ikịtte,</para>
  <para style="q2" vid="PRO 14:6">ado awo ikike anie ifiọk ke mmem-mmem usʌñ.<verse eid="PRO 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />Diañña nsaña ye ndisịme,</para>
  <para style="q2" vid="PRO 14:7">sia afo uduukịtte ifiọk ke ñkpọkinua ammọ.<verse eid="PRO 14:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />Aniọñ mme adiọọñọidem awo ado adikere mbaña usʌñ ammọ,</para>
  <para style="q2" vid="PRO 14:8">ado ntʌn mbon ndisịme ado abiaña.<verse eid="PRO 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />Mbon ndisịme eduọi aditua ñkpọfiọk mbaña idiọọkñkpọ,</para>
  <para style="q2" vid="PRO 14:9">ado eti uduak aba ke atu ndinen awo.<verse eid="PRO 14:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />Esịd keedekeed adiọọñọ ukuud amọ,</para>
  <para style="q2" vid="PRO 14:10">ndin awo mfen ikanna iwuana ke inemesịd amọ.<verse eid="PRO 14:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />Eyaesobo ufọk awo ibak,</para>
  <para style="q2" vid="PRO 14:11">ado atayad adinen awo ayaaseghe.<verse eid="PRO 14:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />Aba usʌñ a-abaaha nte anen,</para>
  <para style="q2" vid="PRO 14:12">ado ke akpatre anye adat awo akaa ñkpa.<verse eid="PRO 14:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />Kpa ke inua imam, iduọesịd akeme adiba,</para>
  <para style="q2" vid="PRO 14:13">ñko idaara akeme ikitre ke mfʌhọ<verse eid="PRO 14:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />Mbon unana mbuọdidem eyaebọ utịb ammọ ayọhọ-ayọhọ,</para>
  <para style="q2" vid="PRO 14:14">nti awo eyaenyʌñ ebọ utịb ammọ.<verse eid="PRO 14:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />Akọi anịm ñkpọ akeedodo,</para>
  <para style="q2" vid="PRO 14:15">ado mme adiọọñọidem awo ekere ebaña usʌñ ammọ.<verse eid="PRO 14:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />Awo aniọñ abaak <char style="nd">Abọọñ</char> anyʌñ asọọn idiọọkñkpọ,</para>
  <para style="q2" vid="PRO 14:16">ado iwuod afofiop ndisịme anye anyʌñ akop nsọọñọnda.<verse eid="PRO 14:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />Awo ifiobesịd anam ndisịme ñkpọ,</para>
  <para style="q2" vid="PRO 14:17">ndin esua awo idiọọk uduak.<verse eid="PRO 14:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />Mme akọi edadat ndisịme emana,</para>
  <para style="q2" vid="PRO 14:18">ado mme adiọọñọidem awo eyara anyanya ifiọk.<verse eid="PRO 14:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />Mme anam idiọọkñkpọ eyaetuak iwuod ke iso nti awo,</para>
  <para style="q2" vid="PRO 14:19">mbon ibak ñko eyaetuak iwuod ke inuaatob ndinen awo.<verse eid="PRO 14:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />Mme mbọhọidʌñ esọsọọn mbon uweene,</para>
  <para style="q2" vid="PRO 14:20">ado imọ awo anie uwak ufan.<verse eid="PRO 14:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />Ado idiọọkñkpọ awo adisọọn mbọhọidʌñ amọ,</para>
  <para style="q2" vid="PRO 14:21">ado afọfọn anọ awo a-afọnnọ mfọn ye mbon unana.<verse eid="PRO 14:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />Nte mbon e-eduakka ndoom isiwuọhọ ikpọñ usʌñ?</para>
  <para style="q2" vid="PRO 14:22">Ado mbon e-eduakka se ifọn ekịt ima ye akpanikọ.<verse eid="PRO 14:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />Afịd akpọsọñ utom enie udod,</para>
  <para style="q2" vid="PRO 14:23">ado uyaha ikọ aben awo asịn ke uweene kpọd.<verse eid="PRO 14:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />Inie mbon aniọñ ado anyanya ammọ,</para>
  <para style="q2" vid="PRO 14:24">ado ndisịme mme akọi asuuk ke ndisịme.<verse eid="PRO 14:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />Ntiense akpanikọ anyaaña uwem mbon awo,</para>
  <para style="q2" vid="PRO 14:25">ado ntiense nsu ado abiaña.<verse eid="PRO 14:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />Awo akeedodo a-anieghe mbaak <char style="nd">Abọọñ</char> anie akpọsọñ itie udịbe,</para>
  <para style="q2" vid="PRO 14:26">ado ayaanyʌñ ado itie udịbe anọ nditọ ammọ.<verse eid="PRO 14:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />Uteeñe <char style="nd">Abọọñ</char> ado idịm mmọọñuwem,</para>
  <para style="q2" vid="PRO 14:27">awọññọ awo asio ke mme afia ñkpa.<verse eid="PRO 14:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />Uwak awo edo ubọọñ adidem,</para>
  <para style="q2" vid="PRO 14:28">ado mbon awo imiibaaha, akpanabọọñ aba ke nsobo.<verse eid="PRO 14:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />Awo akeedodo a-anieghe ime anie ekamba mbufiọk,</para>
  <para style="q2" vid="PRO 14:29">ado awo ifiobesịd awọt ndisịme amọ anwa-anwa.<verse eid="PRO 14:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />Esịd amaaba ke emem a-anọ idem uwem,</para>
  <para style="q2" vid="PRO 14:30">ado ufịb akwakwat mme akpọ.<verse eid="PRO 14:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />Awo akeedodo a-afiighe uweene amiom Andibod ammọ,</para>
  <para style="q2" vid="PRO 14:31">ado awo akeedodo a-afọnnọ ido ye uweene anọ <char style="nd">Abọọñ</char> ukpono.<verse eid="PRO 14:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />Nnananyen amaadi, esuuhọ mbon ibak,</para>
  <para style="q2" vid="PRO 14:32">ado akpekọm ke ñkpa ndinen awo eyem udịbe ke <char style="nd">Abọọñ</char>.<verse eid="PRO 14:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />Aniọñ asịne ke esịd mbon mbufiọk</para>
  <para style="q2" vid="PRO 14:33">anye ayaara idem amọ kpa ke atu mbon ndisịme.<verse eid="PRO 14:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />Adinenido abenne idịd,</para>
  <para style="q2" vid="PRO 14:34">ado idiọọkñkpọ abiom mbon awo akeedodo ikpe.<verse eid="PRO 14:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />Adidem akop inemesịd ye ayịnufọk a-anieghe aniọñ,</para>
  <para style="q2" vid="PRO 14:35">ado idiọọk ayịnufọk anam esịd ayat anye.<verse eid="PRO 14:35" /></para>
  <para style="b" />
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />Usʌk-usʌk ibọọrọ aben iyadesịd afep,</para>
  <para style="q2" vid="PRO 15:1">ado idiọọk ikọ inua anenekke abenne iyadesịd.<verse eid="PRO 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />Edeme awo aniọñ adọdiọñ ifiọk,</para>
  <para style="q2" vid="PRO 15:2">ado inua ndisịme atañ utueeñ.<verse eid="PRO 15:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />Anyen <char style="nd">Abọọñ</char> aba ke afịd itie,</para>
  <para style="q2" vid="PRO 15:3">akpeme idiọọk ye eti.<verse eid="PRO 15:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />Usʌk-usʌk edeme ado eto uwem,</para>
  <para style="q2" vid="PRO 15:4">ado abʌd-abʌd edeme awowot sịbidịd.<verse eid="PRO 15:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />Ndisịme asua ntʌnọ ete ye eka,</para>
  <para style="q2" vid="PRO 15:5">ado awo akeedodo a-adatta item awọt ndiọọñọidem.<verse eid="PRO 15:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />Ufọk adinen awo adọñọ uwak nti ñkpọ,</para>
  <para style="q2" vid="PRO 15:6">ado akʌk awo ibak asaña ye nsobo.<verse eid="PRO 15:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />Ñkpọkinua awo aniọñ asuan ifiọk,</para>
  <para style="q2" vid="PRO 15:7">ado esịd mbon ndisịme inenne.<verse eid="PRO 15:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />Uwa mbon ndubiam atetek <char style="nd">Abọọñ</char> esịd,</para>
  <para style="q2" vid="PRO 15:8">ado akam ndinen awo enọ anye inemesịd.<verse eid="PRO 15:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />
    <char style="nd">Abọọñ</char> asua usʌñ mbon ibak,</para>
  <para style="q2" vid="PRO 15:9">ado anye ama mbon e-efegheke ekeene adinenido.<verse eid="PRO 15:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />Akpọsọñ ufen ana anọ awo a-awuọhọ akpọñ usʌñ;</para>
  <para style="q2" vid="PRO 15:10">awo a-asuaha item ayaakpa.<verse eid="PRO 15:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />Ñkpa ye Nsobo<note caller="+" style="f"><char style="fr" closed="false">15:11 </char><char style="ft" closed="false">Ke Hibru ado </char><char style="fqa" closed="false">Abadọn</char></note> enaa inwañ-inwañ ke iso <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PRO 15:11">nwaanwa dise esịd awo!<verse eid="PRO 15:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />Mbon nsaha imaaha nsuannọ,</para>
  <para style="q2" vid="PRO 15:12">anye asịn ammọ esọsọọn mbon aniọñ.<verse eid="PRO 15:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />Esịd idaara anam iso ayamma,</para>
  <para style="q2" vid="PRO 15:13">ado iduọesịd ananuak sịbidịd.<verse eid="PRO 15:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />Esịd ikike ayem ifiọk,</para>
  <para style="q2" vid="PRO 15:14">ado ndidia awo akọi ado ndisịme.<verse eid="PRO 15:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />Afịd usen mbon ukuud eyọhọ ye akpọsọñ mfʌhọ,</para>
  <para style="q2" vid="PRO 15:15">ado esịd idaara anie nsi-nsi usọrọ.<verse eid="PRO 15:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />Afọn adinie etək-etək ye uteeñe <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PRO 15:16">akan uwak inie ye akpọsọñ mfịna.<verse eid="PRO 15:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />Etək-etək ñkọñ e-enọọhọ ke ima a-afọn</para>
  <para style="q2" vid="PRO 15:17">akan ukọkʌk ñyịn enañ e-enọọhọ ke usua.<verse eid="PRO 15:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />Awo ifiobesịd asịn utọk,</para>
  <para style="q2" vid="PRO 15:18">ado awo a-anieghe ime anam utọk atre.<verse eid="PRO 15:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />Usʌñ awo ifu ayọhọ ye mme ñkukịm,</para>
  <para style="q2" vid="PRO 15:19">ado usʌñ adinen awo ado weeweewee.<verse eid="PRO 15:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />Ayịn awodeen a-anieghe aniọñ adat inemesịd asọk ete amọ,</para>
  <para style="q2" vid="PRO 15:20">ado ndisịme awodeen asịn eka amọ ke ndek.<verse eid="PRO 15:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />Ndisịme adat idadesịd asọk awo i-imiinieghe eti iwuod,</para>
  <para style="q2" vid="PRO 15:21">ado awo akeedodo a-anieghe mbufiọk anịm usʌñ amọ nnen-nnen.<verse eid="PRO 15:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />Mme uduak ekpu ato unana item,</para>
  <para style="q2" vid="PRO 15:22">ado ke ntak uwak mme anọitem ammọ ekịt unen.<verse eid="PRO 15:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />Awo akop inemesịd ke adinọ ibọọrọ se idot,</para>
  <para style="q2" vid="PRO 15:23">ndin eti ikọ afọn ke akemini!<verse eid="PRO 15:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />Usʌñ uwem adat adiọọñọidem awo akaa iso</para>
  <para style="q2" vid="PRO 15:24">mbaak ammọ editịkke edʌk abioekpo.<verse eid="PRO 15:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />
    <char style="nd">Abọọñ</char> atahade ufọk awo ntañidem,</para>
  <para style="q2" vid="PRO 15:25">ado anye anekke itiad adaña ebekpa anịm ke itie.<verse eid="PRO 15:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />Akikere mbon ndubiam atetek <char style="nd">Abọọñ</char> esịd,</para>
  <para style="q2" vid="PRO 15:26">ado nti ikọ edo ndisana ke iso amọ.<verse eid="PRO 15:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />Mbon idiọọkitọñ eben nsobo esịn ke mme ufọk ammọ,</para>
  <para style="q2" vid="PRO 15:27">ado awo a-asuaha ubọkedem ayaadu uwem.<verse eid="PRO 15:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />Esịd adinen awo adodomo mme ibọọrọ se anye anọ,</para>
  <para style="q2" vid="PRO 15:28">ado inua awo ibak asịññe ndiọi.<verse eid="PRO 15:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />
    <char style="nd">Abọọñ</char> anyọọñ usʌñ akpọñ mbon ibak,</para>
  <para style="q2" vid="PRO 15:29">ado anye akop akam ndinen awo.<verse eid="PRO 15:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />Unwana ke anyen awo edọñ utom anọ esịd idaara,</para>
  <para style="q2" vid="PRO 15:30">ndin eti etob anọ mme akpọ uwem.<verse eid="PRO 15:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />Awo akeedodo a-akoppo item uwem</para>
  <para style="q2" vid="PRO 15:31">ayaakop inem aditie ye mbon aniọñ.<verse eid="PRO 15:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />Mbon e-esuaha ntʌnọ esua idem ammọ,</para>
  <para style="q2" vid="PRO 15:32">ado awo a-akoppo item anie mbufiọk.<verse eid="PRO 15:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />Item aniọñ ado adibaak <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PRO 15:33">ndin nsuukidem aboiyo ukpono iso.<verse eid="PRO 15:33" /></para>
  <para style="b" />
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />Uduak ado akikere esịd uduudawo,</para>
  <para style="q2" vid="PRO 16:1">ado <char style="nd">Abọọñ</char> ado andinọ ibọọrọ se idot ye edeme.<verse eid="PRO 16:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />Afịd usʌñ awo atie nte ado adisana anọ ammọ,</para>
  <para style="q2" vid="PRO 16:2">ado <char style="nd">Abọọñ</char> adomo akikere.<verse eid="PRO 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />Yaak afịd se afo anam sịn <char style="nd">Abọọñ</char> ke ubọk,</para>
  <para style="q2" vid="PRO 16:3">ndin anye ayaanam uduak mfo anie iwuuk.<verse eid="PRO 16:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />
    <char style="nd">Abọọñ</char> anam afịd ñkpọ akesịm ke akem ini,</para>
  <para style="q2" vid="PRO 16:4">kpa ye awo ibak mbaak usen nnananyen.<verse eid="PRO 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />
    <char style="nd">Abọọñ</char> asua afịd mbon ntañidem.</para>
  <para style="q2" vid="PRO 16:5">Tịm diọọñọ bo ke: Ammọ idiitreke adibọ ufen.<verse eid="PRO 16:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />Ato ke ima ye akpanikọ efeen idiọọkñkpọ;</para>
  <para style="q2" vid="PRO 16:6">ato ke uteeñe <char style="nd">Abọọñ</char> ekpọñ idiọọkñkpọ.<verse eid="PRO 16:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />
    <char style="nd">Abọọñ</char> amaakop inem ke usʌñ awo akeedodo,</para>
  <para style="q2" vid="PRO 16:7">anye anam mme asua amọ enam emem ye anye.<verse eid="PRO 16:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />Afọn adinie etək-etək ke adinenido</para>
  <para style="q2" vid="PRO 16:8">akan akpọmiọk ke ukwañ.<verse eid="PRO 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />Mme awo enam uduak ammọ ke esịd ammọ,</para>
  <para style="q2" vid="PRO 16:9">ado <char style="nd">Abọọñ</char> anọ usʌñ ammọ iwuuk.<verse eid="PRO 16:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />Ñkpọkinua adidem atañ ikọ nte idiọñ,</para>
  <para style="q2" vid="PRO 16:10">ndin inua amọ ibiada unen.<verse eid="PRO 16:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />Mme nnekke-nnekke udomoñkpọ enie <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PRO 16:11">afịd udomo ke ekpad edo anye anam.<verse eid="PRO 16:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />Mme ndidem esua ukwañido,</para>
  <para style="q2" vid="PRO 16:12">sia ebọp ebekpo eto adinenido.<verse eid="PRO 16:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />Mme ndidem ekop inemesịd ke ñkpọkinua akpanikọ;</para>
  <para style="q2" vid="PRO 16:13">ammọ ema awo a-atañña se inen.<verse eid="PRO 16:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />Iyadesịd adidem ado isʌñutom ñkpa,</para>
  <para style="q2" vid="PRO 16:14">ado awo aniọñ ayaasuuk iyadesịd ado.<verse eid="PRO 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />Iso adidem amaayamma, ado awuọñọ uwem;</para>
  <para style="q2" vid="PRO 16:15">mfọn amọ atie nte ntọñanyọñ a-afʌhọke edịm ke ini utọ ñkpọ.<verse eid="PRO 16:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />A-anekke afọn adinie aniọñ akan adinie kold,</para>
  <para style="q2" vid="PRO 16:16">adinie ikike akan adinie silfa!<verse eid="PRO 16:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />Akpọusʌñ isañ adinen awo asọsọọn idiọọkñkpọ;</para>
  <para style="q2" vid="PRO 16:17">mbon e-ekpemeke usʌñ ammọ edịp uwem ammọ.<verse eid="PRO 16:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />Ntañidem abem nsobo iso,</para>
  <para style="q2" vid="PRO 16:18">sịbidịd ñkịdidem abem iduọ iso.<verse eid="PRO 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />A-afọn adinie nsuukidem ke sịbidịd ye mbon ukuud</para>
  <para style="q2" vid="PRO 16:19">akan adiwuana mbịme ye mbon ntañidem.<verse eid="PRO 16:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />Awo akeedodo a-akoppo item, aforo,<note caller="+" style="f"><char style="fr" closed="false">16:20 </char><char style="ft" closed="false">Akeme ido, </char><char style="fqa" closed="false">awo a-abattabat ikọ atañ akịt se ifọn</char></note></para>
  <para style="q2" vid="PRO 16:20">ndin afọfọn anọ awo a-anieghe mbuọdidem ke <char style="nd">Abọọñ</char>.<verse eid="PRO 16:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />Mme anie aniọñ ke esịd ke ekoot mbon mbufiọk,</para>
  <para style="q2" vid="PRO 16:21">ndin nneem ikọ enekke ebenne item.<verse eid="PRO 16:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />Ndiọọñọidem ado idịm mmọọñuwem anọ adiọọñọidem awo,</para>
  <para style="q2" vid="PRO 16:22">ado unana ifiọk adat ufen anọ mbon ndisịme.<verse eid="PRO 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />Esịd mbon aniọñ anam inua ammọ anie ndiọọñọidem,</para>
  <para style="q2" vid="PRO 16:23">ndin ñkpọkinua ammọ asọọñọ item.<verse eid="PRO 16:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />Nneem ikọ ado eboho adanakwọọk,</para>
  <para style="q2" vid="PRO 16:24">anem ke ukpọñ anyʌñ ado ukọk anọ mme akpọ.<verse eid="PRO 16:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />Aba usʌñ a-abaaha nte anen,</para>
  <para style="q2" vid="PRO 16:25">ado ke akpatre anye adat awo akaa ñkpa.<verse eid="PRO 16:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />Udọñ ndidia mme anam utom afọn anọ ammọ;</para>
  <para style="q2" vid="PRO 16:26">abiọọñ anək ammọ akaa iso.<verse eid="PRO 16:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />Abʌd-abʌd awo aduak ibak,</para>
  <para style="q2" vid="PRO 16:27">ndin ke ñkpọkinua ammọ anye aba nte ufiob ikañ.<verse eid="PRO 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />Abʌd-abʌd awo asịn mfịna,</para>
  <para style="q2" vid="PRO 16:28">ndin awo mbia asuan mme ufan ntandia.<verse eid="PRO 16:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />Awo abom atap mbọhọidʌñ ammọ</para>
  <para style="q2" vid="PRO 16:29">anyʌñ adat ammọ adʌk usʌñ i-imiifọnnọ.<verse eid="PRO 16:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />Awo akeedodo a-akeppe anyen amọ asʌk aduak ndoom;</para>
  <para style="q2" vid="PRO 16:30">awo akeedodo a-akoodo inua amọ atobo aduak idiọọkñkpọ.<verse eid="PRO 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />Iwuod iwad ado anyanya ubọọñ;</para>
  <para style="q2" vid="PRO 16:31">enie anye eto usʌñ adinenido.<verse eid="PRO 16:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />A-afọn adido awo ime akan adido awo ekọñ,</para>
  <para style="q2" vid="PRO 16:32">awo a-anieghe mfarakeidem ñkan awo a-adatta abio.<verse eid="PRO 16:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />E-etop afia esịn ke ekpaha,</para>
  <para style="q2" vid="PRO 16:33">ado afịd se ebiere ato <char style="nd">Abọọñ</char>.<verse eid="PRO 16:33" /></para>
  <para style="b" />
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />Nsaad uyo ke emem ye ndobo a-afọn</para>
  <para style="q2" vid="PRO 17:1">akan ufọk usọrọ a-ayọhọke ye afanekọñ.<verse eid="PRO 17:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />Ayịnufọk a-anieghe ndiọọñọidem ayaakara asuenneidem ayịn</para>
  <para style="q2" vid="PRO 17:2">anyʌñ anie udeeme adiaakpa nte keed ke atu nditọ ke ubon.<verse eid="PRO 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />Ako ana anọ silfa edeeme ñko ikañ ana anọ kold,</para>
  <para style="q2" vid="PRO 17:3">ado <char style="nd">Abọọñ</char> adomo esịd.<verse eid="PRO 17:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />Awo ibak akpañ utọñ anọ ñkpọkinua abiaña;</para>
  <para style="q2" vid="PRO 17:4">awo nsu akpañ utọñ anọ edeme nsobo.<verse eid="PRO 17:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />Awo akeedodo a-asakka uweene asịn Abod ammọ ke ndek;</para>
  <para style="q2" vid="PRO 17:5">awo akeedodo a-adaarake abaña nnananyen itreke adibọ ufen.<verse eid="PRO 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />Nditọnditọ edo anyanya enọ mbon usọñ,</para>
  <para style="q2" vid="PRO 17:6">Ete ye eka edo uku enọ nditọ ammọ.<verse eid="PRO 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />Nneem inua idotto ndisịme i-imiidiọọñọke abasi,</para>
  <para style="q2" vid="PRO 17:7">nwaanwa dise ndiọọkñkan a-adooho asʌhọ nsu nnọọ adaukara!<verse eid="PRO 17:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />Ubọkedem aba nte ibọk ke anyen awo andinọ;</para>
  <para style="q2" vid="PRO 17:8">ammọ ekere ke mfọniso ye uforo adiito do iwuọ afịd ini.<verse eid="PRO 17:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />Awo akeedodo a-ayemme ima afʌk ndudue,</para>
  <para style="q2" vid="PRO 17:9">ado awo akeedodo a-amaanake atañ se imaikiboiyo asuan mme ufan ntandia.<verse eid="PRO 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />Adiọọñọidem awo ama ntʌnọ</para>
  <para style="q2" vid="PRO 17:10">akan ubọkikpa ikie e-emiaha ndisịme awo.<verse eid="PRO 17:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />Mbon ndoom esịn nsọñiwuod ye <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PRO 17:11">eyaedọñ isʌñutom ñkpa enọ ammọ.<verse eid="PRO 17:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />Afọn adikisoobo amọnikọd ebọiyọ nditọ amọ</para>
  <para style="q2" vid="PRO 17:12">akan akọi a-asọọñọke ayịre ke ndisịme amọ.<verse eid="PRO 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />Idiọọkñkpọ idiikpọññọ ufọk</para>
  <para style="q2" vid="PRO 17:13">awo a-akpeeghe utịb idiọọk ke eti ñkpọ.<verse eid="PRO 17:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />Aditọọñọ utọk atie nte adifiọkkọ usʌñ mmọọñ;</para>
  <para style="q2" vid="PRO 17:14">ke ntak ado kuunam nọ utọk atọọñọ.<verse eid="PRO 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />Aditoppo adueñkpọ ikpe ye adibiom adinen awo ikpe,</para>
  <para style="q2" vid="PRO 17:15">
    <char style="nd">Abọọñ</char> asua naña iba.<verse eid="PRO 17:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />Nsoo ikpido ntak nọ mme ndisịme ekpekama akʌk ke ubọk eyem adidep aniọñ,</para>
  <para style="q2" vid="PRO 17:16">ke ini adooho aniọñ ikanna inwaña ammọ?<verse eid="PRO 17:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />Ufan anie ima afịd ini,</para>
  <para style="q2" vid="PRO 17:17">ayịneka awodeen amana anọ ini nnananyen.<verse eid="PRO 17:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />Awo i-imiinieghe eti iwuod atie ubiọñ</para>
  <para style="q2" vid="PRO 17:18">anyʌñ atie ubiọñ anọ mbọhọidʌñ.<verse eid="PRO 17:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />Awo akeedodo a-amaaha utọk a-ama idiọọkñkpọ;</para>
  <para style="q2" vid="PRO 17:19">awo akeedodo a-abọppọ anyan inuaatob ayem nsobo.<verse eid="PRO 17:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />Awo ake esịd amọ akwañake iforoke;</para>
  <para style="q2" vid="PRO 17:20">awo ake edeme amọ adooho abʌd-abʌd aduọ adʌk mfịna.<verse eid="PRO 17:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />Adinie ndisịme nte ayịn adat iduọesịd adi;</para>
  <para style="q2" vid="PRO 17:21">inemesịd ibaaha inọ ete ye eka ndisịme i-imiibaaha abasi.<verse eid="PRO 17:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />Esịd idaara ado eti ibọk,</para>
  <para style="q2" vid="PRO 17:22">ado esịd a-abaaha ke mfʌhọ asasaat akpọ.<verse eid="PRO 17:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />Awo ibak abọ ubọkedem ke ndịbe</para>
  <para style="q2" vid="PRO 17:23">nọ anye awọññọ usʌñ unen.<verse eid="PRO 17:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />Awo ikike anịm aniọñ ke iso,</para>
  <para style="q2" vid="PRO 17:24">ado anyen ndisịme ayoyo akanna utịd ederimbod.<verse eid="PRO 17:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />Ndisịme ayịn adat iduọesịd asọk ete amọ</para>
  <para style="q2" vid="PRO 17:25">anyʌñ adat idod asọk eka a-akemanna anye.<verse eid="PRO 17:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />Adieke adibọ adinen awo isob imiifọnnọ,</para>
  <para style="q2" vid="PRO 17:26">ke akpanikọ, adimia mme adaaha ukara e-enamma akpanikọ ikpa inenne.<verse eid="PRO 17:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />Awo a-anieghe ifiọk ababat ikọ atañ,</para>
  <para style="q2" vid="PRO 17:27">ñko awo a-anieghe ndiọọñọidem isọppọ iyadesịd.<verse eid="PRO 17:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />Idem mme ndisịme ebat ammọ nte mbon aniọñ ke ammọ ekpedop uyio,</para>
  <para style="q2" vid="PRO 17:28">enyʌñ ebat ammọ nte mbon ndiọọñọidem ke ammọ ekpefat edeme ammọ.<verse eid="PRO 17:28" /></para>
  <para style="b" />
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />Awo i-imiinieghe ima anam se inemme anye</para>
  <para style="q2" vid="PRO 18:1">anyʌñ atọọñọ utọk ke ufọọd nti ubiideikpe.<verse eid="PRO 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />Mme ndisịme ikoppo inem ke mbufiọk</para>
  <para style="q2" vid="PRO 18:2">ado ekop inem ke adisuan akikere ammọ.<verse eid="PRO 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />Ibak amaadi, asaña ye ndọk,</para>
  <para style="q2" vid="PRO 18:3">ndin abuud anyʌñ asaña ye asuenne.<verse eid="PRO 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />Ikọ inua ado ntotəño mmọọñ,</para>
  <para style="q2" vid="PRO 18:4">ado idịm aniọñ ado idịm a-afeghekefeghe.<verse eid="PRO 18:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />Ifọnnọ nọ ekwaañ ubiideikpe enọ awo ibak</para>
  <para style="q2" vid="PRO 18:5">me adinyʌñ mbọọ unen awo ammiidueghe.<verse eid="PRO 18:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />Ñkpọkinua ndisịme adat mfịna asọk ammọ,</para>
  <para style="q2" vid="PRO 18:6">ndin inua ammọ akoot ntiim anọ ammọ.<verse eid="PRO 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />Inua ndisịme ado mfịna anọ ammọ.</para>
  <para style="q2" vid="PRO 18:7">Ñkpọkinua ammọ ñko edo afia enọ uwem ammọ.<verse eid="PRO 18:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />Ikọ awo mbia atie nte inem ndidia;</para>
  <para style="q2" vid="PRO 18:8">ammọ esọiyọ edʌk ataa esịd idịb.<verse eid="PRO 18:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />Awo i-imiisọọñọke ke utom amọ</para>
  <para style="q2" vid="PRO 18:9">ado ayịneka awodeen anọ andisobo.<verse eid="PRO 18:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />Anyịñ <char style="nd">Abọọñ</char> ado akpọsọñ tọwa;</para>
  <para style="q2" vid="PRO 18:10">ndinen awo efeghe ekaa do enyʌñ ebọkkọ.<verse eid="PRO 18:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />Inie imọ awo ado akpọsọñ abio ammọ</para>
  <para style="q2" vid="PRO 18:11">ammọ ekere ke anye a-akoñ akan se etamma.<verse eid="PRO 18:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />Mbemiso iduọ asịm awo esịd amọ akokokko,</para>
  <para style="q2" vid="PRO 18:12">ado nsuukidem abem ukpono iso.<verse eid="PRO 18:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />Adibọọrọ ndin a-akpañ utọñ,</para>
  <para style="q2" vid="PRO 18:13">ado ndisịme ye abuud.<verse eid="PRO 18:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />Sịbidịd awo akeme iyọ udọñọ,</para>
  <para style="q2" vid="PRO 18:14">ado anie akeme adiyọ esịd abʌññọke?<verse eid="PRO 18:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />Esịd awo ikike abọ ifiọk,</para>
  <para style="q2" vid="PRO 18:15">sia utọñ awo aniọñ ayem anye akịt.<verse eid="PRO 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />Enọ abeere usʌñ</para>
  <para style="q2" vid="PRO 18:16">anyʌñ aben awo andinọ akaa ke iso mme ñkpisọñ.<verse eid="PRO 18:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />Ke ikpe andito ntañ ikọ atie nte anye anen,</para>
  <para style="q2" vid="PRO 18:17">tutu awo awuọ adibịp mbuume.<verse eid="PRO 18:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />Usịn afia abiide utọk</para>
  <para style="q2" vid="PRO 18:18">anyʌñ amuum anwan mme ñkpọsọñ awo.<verse eid="PRO 18:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />Ayịneka awodeen ake edueghe anye a-asọñ esịd akan akpọsọñ abio;</para>
  <para style="q2" vid="PRO 18:19">utọk atie nte mme inuaatob e-ekpahakekpaha.<verse eid="PRO 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />Ato ke mfịd inua ammọ idịb awo ayʌkkọ;</para>
  <para style="q2" vid="PRO 18:20">ato ke idọk ñkpọkinua ammọ ekop uyʌkkọ.<verse eid="PRO 18:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />Edeme anie adudu uwem ye ñkpa,</para>
  <para style="q2" vid="PRO 18:21">ndin mbon e-emaaha anye eyaedia mfịd amọ.<verse eid="PRO 18:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />Awo a-akịtte anwaan a-akịt eti ñkpọ</para>
  <para style="q2" vid="PRO 18:22">anyʌñ abọ mfọn ato <char style="nd">Abọọñ</char>.<verse eid="PRO 18:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />Uweene aseeme ayem mbọm,</para>
  <para style="q2" vid="PRO 18:23">ado imọ awo abọọrọ uyad-uyad.<verse eid="PRO 18:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />Awo a-anieghe mme ufan abiaña itreke idʌk nsobo,</para>
  <para style="q2" vid="PRO 18:24">ado aba ufan a-adianake awo ke idem akan ayịneka.<verse eid="PRO 18:24" /></para>
  <para style="b" />
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />A-afọn adido uweene u-usʌñ amọ ananake ndo</para>
  <para style="q2" vid="PRO 19:1">akan ndisịme i-ikọinua amọ adooho abʌd-abʌd.<verse eid="PRO 19:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />Udọñ i-imiisañake ye ifiọk ifọnnọ,</para>
  <para style="q2" vid="PRO 19:2">nwaanwa dise naña asọp ukod isañ imiidiisoppo usʌñ!<verse eid="PRO 19:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />Ndisịme ake awo adat awo anọ nsobo,</para>
  <para style="q2" vid="PRO 19:3">kpayeado ammọ eyat esịd ye <char style="nd">Abọọñ</char>.<verse eid="PRO 19:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />Inie akoot mme uwak ufan,</para>
  <para style="q2" vid="PRO 19:4">ado ataa akpan ufan ntandia uweene afefeghe akpọñ ammọ.<verse eid="PRO 19:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />Ntiense nsu idiitreke ibọ ufen,</para>
  <para style="q2" vid="PRO 19:5">awo akeedodo a-asʌhọke nsu idiibọkkọke.<verse eid="PRO 19:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />Uwak awo eyem mfọn eto andikara,</para>
  <para style="q2" vid="PRO 19:6">ndin afịd awo edo ufan ye awo a-anọọhọ enọ.<verse eid="PRO 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />Afịd mme ayakka mbon uweene esọsọọn ammọ,</para>
  <para style="q2" vid="PRO 19:7">nwaanwa dise naña mme ufan ammọ efeghe ekpọñ ammọ!</para>
  <para style="q1" vid="PRO 19:7">Akpesʌkado mme uweene efegheke ebịne ammọ ye ñkpeubọk,</para>
  <para style="q2" vid="PRO 19:7">awo ndomokeed ikịtte ammọ.<verse eid="PRO 19:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />Awo a-anieghe aniọñ ama uwem;</para>
  <para style="q2" vid="PRO 19:8">awo a-amaaha mbufiọk ayaasọp aforo.<verse eid="PRO 19:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />Ntiense nsu idiitreke ibọ ufen,</para>
  <para style="q2" vid="PRO 19:9">ñko awo akeedodo a-asʌhọke nsu ayaakịt nsobo.<verse eid="PRO 19:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />Ndisịme awo idotto adidu eti uwem,</para>
  <para style="q2" vid="PRO 19:10">anenekke adiọọk afʌn adikara nditọ ideen abọọñ!<verse eid="PRO 19:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />Aniọñ awo aman ime;</para>
  <para style="q2" vid="PRO 19:11">ado ke ufọn awo adifeen ndudue.<verse eid="PRO 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />Iyadesịd adidem atie nte ñkuun ekpe,</para>
  <para style="q2" vid="PRO 19:12">ado mfọn amọ atie nte mbara ke mbid.<verse eid="PRO 19:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />Ndisịme ayịn ado nsobo ete amọ,</para>
  <para style="q2" vid="PRO 19:13">ndin utọk-utọk anwaan atie nte</para>
  <para style="q2" vid="PRO 19:13">akọm ufọk a-adịtte atọi afịd ini.<verse eid="PRO 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />Mme ufọk ye inie edo udeeme se awo anie ato ete ye eka,</para>
  <para style="q2" vid="PRO 19:14">ado adiọọñọidem anwaan ato <char style="nd">Abọọñ</char>.<verse eid="PRO 19:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />Ifu asaña ye akpọsọñ idab,</para>
  <para style="q2" vid="PRO 19:15">ndin awo i-imiinieghe udọñ unam utom akpa abiọọñ.<verse eid="PRO 19:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />Awo akeedodo a-anịmme mme ewʌhọ anịm uwem ammọ,</para>
  <para style="q2" vid="PRO 19:16">ado awo akeedodo a-asịnne usʌñ amọ ke ndek ayaakpa.<verse eid="PRO 19:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />Awo akeedodo a-afọnnọ mfọn ye uweene awuọt <char style="nd">Abọọñ</char> ñkpọ,</para>
  <para style="q2" vid="PRO 19:17">Anye ayaanọ ammọ utịb ke se ammọ enam.<verse eid="PRO 19:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />Tʌnọ nditọ mfo, sia idodanyen aba do;</para>
  <para style="q2" vid="PRO 19:18">kuudo andikeene nsaña usʌñ ñkpa ammọ.<verse eid="PRO 19:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />Awo ifiobesịd ana akpe isob;</para>
  <para style="q2" vid="PRO 19:19">fak ammọ, ndin afo ayaamaana afak ammọ ke ini ke ini.<verse eid="PRO 19:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />Kpañ utọñ nọ item nyʌñ nyịmme ntʌnọ,</para>
  <para style="q2" vid="PRO 19:20">ndin ke utịd eyaubat fiin esịn ke atu mbon aniọñ.<verse eid="PRO 19:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />Uwak uduak esịne ke esịd awo,</para>
  <para style="q2" vid="PRO 19:21">ado uduak <char style="nd">Abọọñ</char> ikpọọñ awuọ ada.<verse eid="PRO 19:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />Udọñ awo ado ima ammiikpuuho<note caller="+" style="f"><char style="fr" closed="false">19:22 </char><char style="ft" closed="false">ammiisañake ye abiaña</char></note>;</para>
  <para style="q2" vid="PRO 19:22">afọn adido uweene akan adido asʌhọ nsu.<verse eid="PRO 19:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />Uteeñe <char style="nd">Abọọñ</char> anọ awo uwem;</para>
  <para style="q2" vid="PRO 19:23">ndin awo adu ke uyʌkkọ, mfịna isịmme anye.<verse eid="PRO 19:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />Awo ifu abuuk ubọk amọ ke usan;</para>
  <para style="q2" vid="PRO 19:24">anye idiikanna iben ikisịn ke inua amọ!<verse eid="PRO 19:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />Mia asak awo ñkpọ, ndin akọi ayaakpeeb ndiọọñọidem;</para>
  <para style="q2" vid="PRO 19:25">sua nọ awo mbufiọk, ndin ammọ eyaedat idem ifiọk.<verse eid="PRO 19:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />Awo akeedodo a-ayịppe ñkpọ ete ammọ anyʌñ abịne eka ammọ asio</para>
  <para style="q2" vid="PRO 19:26">ado ayịn abuud ye ndọk.<verse eid="PRO 19:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />Ayịn awodeen mmi, tre adikpañ utọñ nnọọ item,</para>
  <para style="q2" vid="PRO 19:27">ndin afo ayaatịn usʌñ akpọñ mme ikọ ifiọk.<verse eid="PRO 19:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />Abʌd-abʌd ntiense aduọi unen,</para>
  <para style="q2" vid="PRO 19:28">ndin inua awo ibak amen idiọọkñkpọ.<verse eid="PRO 19:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />Enịm mme isob enọ mme asak awo ñkpọ,</para>
  <para style="q2" vid="PRO 19:29">ndin ntiim anaa anọ edem ndisịme.<verse eid="PRO 19:29" /></para>
  <para style="b" />
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />Ukọd ado anọọ ñnyọọ ke ini bie adooho asịn anwan</para>
  <para style="q2" vid="PRO 20:1">awo akeedodo a-ammọ edatta etịn usʌñ inieghe aniọñ.<verse eid="PRO 20:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />Iyadesịd adidem asịn ndịk nte ñkuun ekpe;</para>
  <para style="q2" vid="PRO 20:2">mbon e-enamma esịd ayat anye eduọọk uwem ammọ.<verse eid="PRO 20:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />Ado ke ukpono awo aditre utọk,</para>
  <para style="q2" vid="PRO 20:3">ado afịd awo e-edooho ndisịme esọsọp aditọhọ utọk.<verse eid="PRO 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />Mbon ifu itọọhọ ñkpọ ke ini;</para>
  <para style="q2" vid="PRO 20:4">ndin ke ini idọk ammọ eyeem ado ikịtte ñkpọ ndomokeed.<verse eid="PRO 20:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />Mme uduak esịd awo edo ntotəño mmọọñ,</para>
  <para style="q2" vid="PRO 20:5">ado awo a-anieghe ikike adʌt ammọ asịññe.<verse eid="PRO 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />Uwak awo ebo ete mmimọ iminie ima ammiikpuuho,</para>
  <para style="q2" vid="PRO 20:6">ado anie akeme adikịt awo akpanikọ?<verse eid="PRO 20:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />Ndinen awo edu uwem unana ndudue;</para>
  <para style="q2" vid="PRO 20:7">afọfọn anọ nditọ ammọ ke ammọ emaeboiyo ifep.<verse eid="PRO 20:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />Adidem amaatie ke ebekpo amọ adikpe ikpe,</para>
  <para style="q2" vid="PRO 20:8">anye akama anyen amọ akeñ afịd ndiọi asio.<verse eid="PRO 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />Anie awo akeme adibo, “Ami mmenịm esịd mmi asana;</para>
  <para style="q2" vid="PRO 20:9">ami mmesana ñnyʌññọ nnie idiọọkñkpọ”?<verse eid="PRO 20:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />Nsio-nsio udob ye nsio-nsio udomoñkpọ,</para>
  <para style="q2" vid="PRO 20:10">
    <char style="nd">Abọọñ</char> asua naña ammọ iba.<verse eid="PRO 20:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />Kpa adinam ntəkayịn ke edat ediọọñọ ntəkayịn,</para>
  <para style="q2" vid="PRO 20:11">ndin adinam ammọ ado adisana ye nnen-nnen?<verse eid="PRO 20:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />Utọñ a-akoppo ye anyen a-akịtte,</para>
  <para style="q2" vid="PRO 20:12">ado <char style="nd">Abọọñ</char> anam naña ammọ iba.<verse eid="PRO 20:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />Kuuma idab imiidooho ntoro afo ayaaforo uweene;</para>
  <para style="q2" vid="PRO 20:13">taba idab ndin afo ayaanie ndidia anye ayọhọ asʌhọ.<verse eid="PRO 20:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />Andideb ate, “Ifọnnọ, ifọnnọ!”</para>
  <para style="q2" vid="PRO 20:14">Ndin anye adakka akekpọ inua abaña naña udeb afọn.<verse eid="PRO 20:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />Kold mmọdo, mme rubi akpọmiọk,</para>
  <para style="q2" vid="PRO 20:15">ado mme ñkpọkinua e-etañña ifiọk edo mme ñkpọuto e-esọbọke.<verse eid="PRO 20:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />Ben afọñ awo a-atieghe ubiọñ nọ asenawo;</para>
  <para style="q2" vid="PRO 20:16">kama anye ke ubiọñ akpedo anam anọ awo esiin.<verse eid="PRO 20:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />Ndidia e-enieghe ke ñwo anem eti-eti,</para>
  <para style="q2" vid="PRO 20:17">ado ke utịd inua adiiyọhọ ye ñkwaitiad.<verse eid="PRO 20:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />Edat item enam uduak;</para>
  <para style="q2" vid="PRO 20:18">ke ntoro afo akpenwana ekọñ, bọ ndadusʌñ.<verse eid="PRO 20:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />Awo mbia ayaara ikọ esịd idịb;</para>
  <para style="q2" vid="PRO 20:19">ke ntoro sọọn awo ñkeñinua.<verse eid="PRO 20:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />Adieke awo asueñe ete me eka amọ,</para>
  <para style="q2" vid="PRO 20:20">utuenikañ ammọ ayaanịme ke ataa ekịm.<verse eid="PRO 20:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />Udeeme adiaakpa e-esọppọ ebọ</para>
  <para style="q2" vid="PRO 20:21">idiinieghe adidiọñ ke utịd.<verse eid="PRO 20:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />Kuubo, “Ami ñyausio fiin usiene ke ndudue ami!”</para>
  <para style="q2" vid="PRO 20:22">Da bet <char style="nd">Abọọñ</char>, ndin anye ayaunwam asio usiene unọ fiin.<verse eid="PRO 20:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />
    <char style="nd">Abọọñ</char> asua nsio-nsio udomoñkpọ,</para>
  <para style="q2" vid="PRO 20:23">ndin udomo abiaña inemme anye esịd.<verse eid="PRO 20:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />
    <char style="nd">Abọọñ</char> awọt awo usʌñ.</para>
  <para style="q2" vid="PRO 20:24">Awo ada die ndin adiọọñọ usʌñ ammọ?<verse eid="PRO 20:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />Ado afia awo adisọp inua ñkaaña ñkpọ</para>
  <para style="q2" vid="PRO 20:25">ndin akema anye aditua ñkpọfiọk abaña mme akaaña amọ.<verse eid="PRO 20:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />Adidem a-anieghe aniọñ akekeñ mbon ibak asịññe;</para>
  <para style="q2" vid="PRO 20:26">anye awat ukwak ukọkñkpọ ke edem ammọ.<verse eid="PRO 20:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />Sịbidịd awo<note caller="+" style="f"><char style="fr" closed="false">20:27 </char><char style="ft" closed="false">Akeme adido ikọ awo</char></note> ado utuenikañ <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="PRO 20:27">a-atuenneke unwana asịn ke ataa ntotəño awọñesịd awo.<verse eid="PRO 20:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />Ima ye akpanikọ enịm adidem ke ifuuro;</para>
  <para style="q2" vid="PRO 20:28">ato ke ima ebekpo amọ asọọñọ ada.<verse eid="PRO 20:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />Uku ñkparawa ado adudu ammọ,</para>
  <para style="q2" vid="PRO 20:29">iwad ado ubọọñ mbon usọñ.<verse eid="PRO 20:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />Eta ye unan e-etʌk idiọọkñkpọ esio,</para>
  <para style="q2" vid="PRO 20:30">ndin ntiim ayet ataa awọñesịd awo.<verse eid="PRO 20:30" /></para>
  <para style="b" />
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />Esịd adidem aba nte mmọọñ idịm ke ubọk <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PRO 21:1">ake anye asiaha usʌñ anọ esọk afịd mbon se inem anye esịd.<verse eid="PRO 21:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />Awo akeme adikere ke mme usʌñ imọ e-enen,</para>
  <para style="q2" vid="PRO 21:2">ado <char style="nd">Abọọñ</char> aduuñọ esịd.<verse eid="PRO 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />Adinam se ido eti ye unen</para>
  <para style="q2" vid="PRO 21:3">a-anem <char style="nd">Abọọñ</char> esịd akan uwa.<verse eid="PRO 21:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />Ñkịdidem ye ntañidem,</para>
  <para style="q2" vid="PRO 21:4">afʌñikọd awo ibak, anwịm idiọọkñkpọ.<verse eid="PRO 21:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />Uduak adiọọñọidem awo anọ udod</para>
  <para style="q2" vid="PRO 21:5">kpa naña nsọbidem aben awo aka uweene.<verse eid="PRO 21:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />Inie a-atooho edeme abiaña</para>
  <para style="q2" vid="PRO 21:6">ado ntuhube a-ayeemeke ye afia ñkpa.<verse eid="PRO 21:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />Afai mbon ibak ayaaben ammọ asio,</para>
  <para style="q2" vid="PRO 21:7">sia ammọ esịn edinam se inen.<verse eid="PRO 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />Usʌñ idiọọk awo akwakwaña,</para>
  <para style="q2" vid="PRO 21:8">ado adinam eti awo ado nnen-nnen.<verse eid="PRO 21:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />A-afọn adidʌñ ke mben akọm</para>
  <para style="q2" vid="PRO 21:9">akan adiwuana ufọk ye utọk-utọk anwaan.<verse eid="PRO 21:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />Mbon ibak eyem ndoom;</para>
  <para style="q2" vid="PRO 21:10">mbọhọidʌñ ammọ ibọọhọ emem ito ammọ.<verse eid="PRO 21:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />Emaemia anọọ awo ñnyọọ ufen, akọi abọ aniọñ;</para>
  <para style="q2" vid="PRO 21:11">ke adikpañ utọñ nnọọ awo aniọñ ammọ ebọ ifiọk.<verse eid="PRO 21:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />Andinen Awo asuuk anyen adiọọñọ ufọk awo ibak</para>
  <para style="q2" vid="PRO 21:12">anyʌñ aben nsobo asọk anye.<verse eid="PRO 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />Awo akeedodo a-asiide utọñ abaha ntuaña uweene</para>
  <para style="q2" vid="PRO 21:13">ayaanyʌñ atua ndin idiibọọhọ ibọọrọ.<verse eid="PRO 21:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />Ndedịbe enọ asuuk iyadesịd,</para>
  <para style="q2" vid="PRO 21:14">ndin ubọkedem e-edịppe ke afọñ asuuk akpọsọñ iyadesịd.<verse eid="PRO 21:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />Emaenam unen, ado adat inemesịd asọk adinen awo</para>
  <para style="q2" vid="PRO 21:15">ado adat ndịk anọ mbon ndoom.<verse eid="PRO 21:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />Awo akeedodo a-awuọhọ akpọñ usʌñ ndiọọñọidem</para>
  <para style="q2" vid="PRO 21:16">aduọk adudu ke atu mme akpañkpa.<verse eid="PRO 21:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />Awo akeedodo a-amaaha udiauwem ayaakappa ado uweene;</para>
  <para style="q2" vid="PRO 21:17">awo akeedodo a-amaaha ukọd ye adan ọlif idiiforoke.<verse eid="PRO 21:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />Awo ibak akappa ado isob anọ adinen awo,</para>
  <para style="q2" vid="PRO 21:18">ndin awo nsu ado isob anọ awo akpanikọ<verse eid="PRO 21:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />A-afọn adidʌñ ke akpautatan</para>
  <para style="q2" vid="PRO 21:19">akan adidʌñ ye atọhọutọk ye atañutañ anwaan.<verse eid="PRO 21:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />Awo aniọñ abono nti ndidia ye adan ọlif enọ idem ammọ,</para>
  <para style="q2" vid="PRO 21:20">ado mme ndisịme edia ake ammọ afịd ema.<verse eid="PRO 21:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />Awo akeedodo a-ayemme adinenido ye ima</para>
  <para style="q2" vid="PRO 21:21">akịt uwem, uforo ye ukpono.<verse eid="PRO 21:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />Awo a-anieghe aniọñ akeme adika ekọñ ye abio mbon uko</para>
  <para style="q2" vid="PRO 21:22">anyʌñ awuut akpọsọñ itie mbuọdidem ammọ.<verse eid="PRO 21:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />Mbon e-ekpemeke inua ye edeme ammọ</para>
  <para style="q2" vid="PRO 21:23">esio idem ammọ ke afanekọñ.<verse eid="PRO 21:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />Awo ntañidem ye awo ñkịdidem, “Asak awo ñkpọ” ado anyịñ amọ,</para>
  <para style="q2" vid="PRO 21:24">anam ñkpọ ke usọñanyen iyadesịd.<verse eid="PRO 21:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />Udọñ awo ifu adiidat ñkpa isọk anye,</para>
  <para style="q2" vid="PRO 21:25">sia ubọk amọ a-asịn adituuk ñkpọ nnam.<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />Afịd usen anye asʌk ayeyem uwak,</para>
  <para style="q2" vid="PRO 21:26">ado adinen awo asʌk anọ ifʌttọ ubọk.<verse eid="PRO 21:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />Uwa awo ibak ado mbubiam,</para>
  <para style="q2" vid="PRO 21:27">akpan-akpan emaedat idi ke idiọọk akikere.<verse eid="PRO 21:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />Ntiense nsu ayaakịt nsobo,</para>
  <para style="q2" vid="PRO 21:28">ado awo a-anekkeke akpañ utọñ ayaatie ntiense mfọn-mfọn.<verse eid="PRO 21:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />Awo ibak anịm iso nsọọñ-nsọọñ,</para>
  <para style="q2" vid="PRO 21:29">ado adinen awo akere abaña usʌñ ammọ.<verse eid="PRO 21:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />Ibaaha aniọñ, ibaaha ikike, ibaaha ubonoñkpọ</para>
  <para style="q2" vid="PRO 21:30">a-akemeke adikan <char style="nd">Abọọñ</char>.<verse eid="PRO 21:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />Ebeeñe enañmbakara idem enọ usen ekọñ,</para>
  <para style="q2" vid="PRO 21:31">ado adikan aba ye <char style="nd">Abọọñ</char>.<verse eid="PRO 21:31" /></para>
  <para style="b" />
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />Eti anyịñ a-afọn akan akpọsọñ inie;</para>
  <para style="q2" vid="PRO 22:1">adinie ukpono a-afọn akan silfa ye kold.<verse eid="PRO 22:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />Imọ ye uweene enie ami ukem-ukem:</para>
  <para style="q2" vid="PRO 22:2">
    <char style="nd">Abọọñ</char> ado Andibod afịd ammọ.<verse eid="PRO 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />Adiọọñọidem awo akịt afanekọñ adʌk adịbe,</para>
  <para style="q2" vid="PRO 22:3">ado akọi asʌk aka ndin abọ unọmọ.<verse eid="PRO 22:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />Nsuukidem ado uteeñe <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="PRO 22:4">utịb amọ ado inie ye ukpono ye uwem.<verse eid="PRO 22:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />Afia ye itịkke eyọhọ ke usʌñ awo ibak,</para>
  <para style="q2" vid="PRO 22:5">ado mbon se iyem ikpeme uwem ammọ ekọkkọ idem ekpọñ ammọ usʌñ anyọọñ.<verse eid="PRO 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />Kpeep ntəkayịn usʌñ a-anaaha ammọ esaña,</para>
  <para style="q2" vid="PRO 22:6">ndin ammọ emaekpon idiiwọññọke ikpọñ usʌñ ado.<verse eid="PRO 22:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />Imọ akara uweene,</para>
  <para style="q2" vid="PRO 22:7">ndin awo ewuọd ado afʌn anọ andiwuọd.<verse eid="PRO 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />Awo akeedodo a-atọọhọ ukwaññkpọ adọk nsobo,</para>
  <para style="q2" vid="PRO 22:8">ndin adọọn a-ammọ efʌññọ ke iyadesịd ayaabʌññọ.<verse eid="PRO 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />Mbon ubọk enọ-enọ eyaebọ adidiọñ ke idem ammọ,</para>
  <para style="q2" vid="PRO 22:9">sia ammọ ewuanake ndidia ammọ ye uweene.<verse eid="PRO 22:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />Bịne anọ awo ñnyọọ sio, ndin mfịna atre;</para>
  <para style="q2" vid="PRO 22:10">utọk ye usọñanyen etre.<verse eid="PRO 22:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />Awo a-amaaha adisana esịd a-anyʌññọ atañ ikọ ke eti usʌñ</para>
  <para style="q2" vid="PRO 22:11">ayaanie adidem nte ufan.<verse eid="PRO 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />Anyen <char style="nd">Abọọñ</char> akpeme ifiọk,</para>
  <para style="q2" vid="PRO 22:12">ado anye abiat ikọ mbon abiaña.<verse eid="PRO 22:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />Ifu abo ate, “Ekpe mmọdo aba ke anwa!</para>
  <para style="q2" vid="PRO 22:13">Eyaeñwot miin ke afe idʌñ!”<verse eid="PRO 22:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />Inua awonwaan efịbe ado ntotəño ube;</para>
  <para style="q2" vid="PRO 22:14">awo a-abaaha ke iyadesịd <char style="nd">Abọọñ</char> aduọ adʌk anye.<verse eid="PRO 22:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />Ndisịme adọdʌñ ke esịd etəkayịn,</para>
  <para style="q2" vid="PRO 22:15">ado ikpa ntʌnọ ayaabịne ndisịme asio akaa anyan usʌñ.<verse eid="PRO 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />Awo a-akuudo uweene nọ inie amọ atọt</para>
  <para style="q2" vid="PRO 22:16">ye anye a-anọọhọ imọ mme enọ, naña ammọ iba eyaekappa edo uweene.<verse eid="PRO 22:16" /></para>
  <para style="ms1">Ikọ Aniọñ Edịb Mme Duob</para>
  <para style="s2">Akpa Ikọ</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />Kpañ utọñ nyʌñ kop ikọ mbon aniọñ;</para>
  <para style="q2" vid="PRO 22:17">sịn esịd mfo ke ñkpọ se ami ñkpeep,<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />sia ado ñkpọ inemesịd afo umausịn ammọ ke esịd mfo</para>
  <para style="q2" vid="PRO 22:18">anyʌñ anie afịd ammọ ke ñkpọkinua mfo.<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />Nọ ato do idodanyen mfo ado ke <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PRO 22:19">ami ukpeep fiin mfịn, kpa afo.<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />Nte ami ñwette ikọ edịb mme duob unọ fiin,</para>
  <para style="q2" vid="PRO 22:20">mme ikọ nnọitem ye ifiọk,<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />ukpeep fiin adido awo akpanikọ ñnyʌñ ntañ ukpeep fiin adidu uwem nnen-nnen ñnyʌñ ntañ akpanikọ,</para>
  <para style="q2" vid="PRO 22:21">nọ afo aben mme etob akpanikọ adi</para>
  <para style="q2" vid="PRO 22:21">adinọ mbon ake afo anamma ñkpọ anọọ?<verse eid="PRO 22:21" /></para>
  <para style="s2">Ayọhọ Ikọ Iba</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />Kuutʌk uweene sia ammọ edo uweene</para>
  <para style="q2" vid="PRO 22:22">ñko kuutʌkkọ awo ukuud ke ufọkesob,<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />sia <char style="nd">Abọọñ</char> ayaanwana ekọñ iwuod ammọ</para>
  <para style="q2" vid="PRO 22:23">ndin ayaadat uwem a-adatta uwem ammọ.<verse eid="PRO 22:23" /></para>
  <para style="s2">Ayọhọ Ikọ Ita</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />Kuunam ufan ye awo ifiobesịd,</para>
  <para style="q2" vid="PRO 22:24">kuunie ewuana ye awo a-asọppọ iyadesịd,<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />imiidooho afo amekeme adikpeep mme ido ammọ</para>
  <para style="q2" vid="PRO 22:25">a-anyʌñ aben idem mfo asịn ke afia.<verse eid="PRO 22:25" /></para>
  <para style="s2">Ayọhọ Ikọ Inaañ</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />Kuudo awo a-akọọmọ ubọk adisọọñọ ubiọñ</para>
  <para style="q2" vid="PRO 22:26">me awo a-atieghe ubiọñ anọ awo ke isọn;<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />adieke afo umuukanna ukpe,</para>
  <para style="q2" vid="PRO 22:27">ke iso mfo eyauwappa akwañ nnaa mfo ebọ.<verse eid="PRO 22:27" /></para>
  <para style="s2">Ayọhọ Ikọ Ition</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />Kuusịkke adaña esed</para>
  <para style="q2" vid="PRO 22:28">ake mme ikaan ekewuuhọ.<verse eid="PRO 22:28" /></para>
  <para style="s2">Ayọhọ Ikọ Itiokeed</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />Afo amekịt awo a-adiọọñọke utom amọ adinam?</para>
  <para style="q2" vid="PRO 22:29">Ammọ eyaenam utom ke iso mme ndidem;</para>
  <para style="q2" vid="PRO 22:29">ammọ idiinamma utom inọ ntək awo.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="s2">Ayọhọ Ikọ Itiaba</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />Afo umautie adidia ndidia ye adaukara,</para>
  <para style="q2" vid="PRO 23:1">nekke diọọñọ se enịm<note caller="+" style="f"><char style="fr" closed="false">23:1 </char><char style="ft" closed="false">Akeme ido, </char><char style="fqa" closed="false">anie awo</char></note> ke iso mfo,<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />ndin sịn ikwa ke itọñ mfo</para>
  <para style="q2" vid="PRO 23:2">akpedo afo ado awo idiọọkitọñ.<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />Kuuyem mme ndiin amọ,</para>
  <para style="q2" vid="PRO 23:3">sia ndidia ado ado abiaña.<verse eid="PRO 23:3" /></para>
  <para style="s2">Ayọhọ Ikọ Itiaita</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />Kuuwot idem mfo ke adiyem adimọinyọ;</para>
  <para style="q2" vid="PRO 23:4">kuunie mbuọdidem ke mbufiọk mfo.<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />Wọññọ anyen se inie, ndin ukịtte ammọ aba,</para>
  <para style="q2" vid="PRO 23:5">sia ke akpanikọ ammọ eyaetịppe mba</para>
  <para style="q2" vid="PRO 23:5">enyʌñ efuurọ ekaa ikpaanyọñ nte ntrukpuum.<verse eid="PRO 23:5" /></para>
  <para style="s2">Ayọhọ Ikọ Usʌkkeed</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />Kuudia ndidia a-awo umuunọọhọ ke afịd esịd,</para>
  <para style="q2" vid="PRO 23:6">kuuyem mme ndiin amọ;<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />sia anye ado utọ awo</para>
  <para style="q2" vid="PRO 23:7">a-akereke abaña ekọmudua ñkpọ afịd ini.</para>
  <para style="q1" vid="PRO 23:7">Anye ubo fiin, “Dia nyʌñ nwọñ,”</para>
  <para style="q2" vid="PRO 23:7">ado esịd amọ ibaaha ye afo.<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />Afo ayaakọk etək se akedia</para>
  <para style="q2" vid="PRO 23:8">ayaanyʌñ abiat ini mfo ke ekọọm.<verse eid="PRO 23:8" /></para>
  <para style="s2">Ayọhọ Ikọ Duob</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />Kuutañ ikọ ye mme ndisịme,</para>
  <para style="q2" vid="PRO 23:9">sia ammọ eyaesọọn mme ikọ ndiọọñọidem mfo.<verse eid="PRO 23:9" /></para>
  <para style="s2">Ayọhọ Ikọ Duob Mme Keed</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />Kuusịkke adaña esed</para>
  <para style="q2" vid="PRO 23:10">kuunyʌñ udʌk inwañ ayịnakpa,<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />sia Andikpeme ammọ ado akpọsọñ;</para>
  <para style="q2" vid="PRO 23:11">anye ayaakpe ikpe ammọ ye afo.<verse eid="PRO 23:11" /></para>
  <para style="s2">Ayọhọ Ikọ Duob Mme Iba</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />Sịn esịd mfo ke item</para>
  <para style="q2" vid="PRO 23:12">nyʌñ nam utọñ mfo akop mme ikọ ifiọk.<verse eid="PRO 23:12" /></para>
  <para style="s2">Ayọhọ Ikọ Duob Mme Ita</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />Kuutre aditʌnọ etəkayịn;</para>
  <para style="q2" vid="PRO 23:13">afo ukpumia ammọ ke ikpa, ammọ idiikpaaha.<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />Mia ammọ ke ikpa</para>
  <para style="q2" vid="PRO 23:14">ndin ayaafak ammọ asio ke ñkpa.<verse eid="PRO 23:14" /></para>
  <para style="s2">Ayọhọ Ikọ Duob Mme Inaañ</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />Ayịn mmi, adieke esịd mfo anieghe aniọñ,</para>
  <para style="q2" vid="PRO 23:15">ndin esịd mmi ayaanem eti-eti;<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />ataa awọñesịd mmi ayaadaara</para>
  <para style="q2" vid="PRO 23:16">ke ini ñkpọkinua mfo amaatañ se inen.<verse eid="PRO 23:16" /></para>
  <para style="s2">Ayọhọ Ikọ Duob Mme Ition</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />Kuuyak esịd mfo afịbe mme anam idiọọk,</para>
  <para style="q2" vid="PRO 23:17">ado kap sịn ifịk ke adibaak <char style="nd">Abọọñ</char> afịd ini.<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />Ke akpanikọ, idodanyen ini iso a-aba unọ fiin,</para>
  <para style="q2" vid="PRO 23:18">ndin idodanyen mfo idiikpuuho.<verse eid="PRO 23:18" /></para>
  <para style="s2">Ayọhọ Ikọ Duob Mme Itiokeed</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />Ayịn mmi, kpañ utọñ, nyʌñ bọ aniọñ,</para>
  <para style="q2" vid="PRO 23:19">sịn esịd mfo ke nnekke-nnekke usʌñ:<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />Kuudʌk ndʌk ye mbon enwọññọ ukọd ebọhọ</para>
  <para style="q2" vid="PRO 23:20">enyʌñ eta unam uwak-uwak,<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />sia mme akpammịn ye mbon idiọọkitọñ eforo uweene,</para>
  <para style="q2" vid="PRO 23:21">ndin akpọsọñ idab asịn ammọ ntaaha afọñ.<verse eid="PRO 23:21" /></para>
  <para style="s2">Ayọhọ Ikọ Duob Mme Itiaba</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />Kpañ utọñ nọ ete mfo, a-akunọọhọ fiin uwem,</para>
  <para style="q2" vid="PRO 23:22">kuunyʌñ usọọn eka mfo ke anye amaasọñ.<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />Dep akpanikọ ado kuunyanyam anye,</para>
  <para style="q2" vid="PRO 23:23">dian aniọñ, item ye ikike ñko.<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />Ete adinen ayịn akop ekamba inemesịd;</para>
  <para style="q2" vid="PRO 23:24">awodeen a-abonno anieiwuod ayịn adaara ke ayịn ado.<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />Yak ete ye eka mfo edaara;</para>
  <para style="q2" vid="PRO 23:25">yak andikuman fiin akop inemesịd!<verse eid="PRO 23:25" /></para>
  <para style="s2">Ayọhọ Ikọ Duob Mme Itiaita</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />Ayịn mmi, nnọ miin esịd mfo</para>
  <para style="q2" vid="PRO 23:26">nyʌñ yak anyen mfo akop inemesịd ke usʌñ mmi,<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />sia awonwaan efịbe ado ntotəño ube,</para>
  <para style="q2" vid="PRO 23:27">asaña esiin anwaan ndọ anyʌñ ado mfafaha ube mmọọñ.<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />Anye adịbe abet nte amauke</para>
  <para style="q2" vid="PRO 23:28">anyʌñ anam mbon abiaña ewak ke atu ideen.<verse eid="PRO 23:28" /></para>
  <para style="s2">Ayọhọ Ikọ Duob Mme Usʌkkeed</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />Anie awo anie ukuud? Anie awo anie mfʌhọ?</para>
  <para style="q2" vid="PRO 23:29">Anie awo anie nnananyen? Anie awo anie mfịna?</para>
  <para style="q2" vid="PRO 23:29">Anie awo anie ananantak unan? Anie awo anie anyen a-ayiibeke?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />Mbon e-ebiada ini etie enwọñ ukọd,</para>
  <para style="q2" vid="PRO 23:30">mbon e-ekaaha eketabi mme ntəño usan e-ekamake ewuak ukọd.<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />Kuuse ukọd ke anye amaamịneñ anyen,</para>
  <para style="q2" vid="PRO 23:31">ke anye amaadaaña ntak ke kọọb,</para>
  <para style="q2" vid="PRO 23:31">ke anye amaaboiyo mfọn-mfọn ke usʌñitọñ!<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />Ke utịd anye akọñ nte udʌkikọd</para>
  <para style="q2" vid="PRO 23:32">anyʌñ atop nte ibọm.<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />Anyen mfo eyaekịt mme asen-asen ñkpọ,</para>
  <para style="q2" vid="PRO 23:33">esịd mfo ayaanyʌñ akere mme ntịme-ntịme ñkpọ.<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />Afo adiiba nte awo a-adaiyake idab ke anyọñ mme akpainyañ</para>
  <para style="q2" vid="PRO 23:34">ke anyọñ ito ubom.<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />Afo ayaabo, “Ammọ entọ miin, ado inieghe se innam!</para>
  <para style="q2" vid="PRO 23:35">Ammọ emmia miin, ado ami ñkoppo ñkpọ ndomokeed!</para>
  <para style="q1" vid="PRO 23:35">Idaha akee ke ami ndiidemme</para>
  <para style="q2" vid="PRO 23:35">nọ ñkeyem ukọd mfen?”<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="s2">Ayọhọ Ikọ Edịb</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />Kuufịbe mbon ibak,</para>
  <para style="q2" vid="PRO 24:1">kuudʌk ndʌk ye ammọ;<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />sia esịd ammọ eduak afai,</para>
  <para style="q2" vid="PRO 24:2">inua ammọ enyʌñ etañ ebaña naña enam ntịme.<verse eid="PRO 24:2" /></para>
  <para style="s2">Ayọhọ Ikọ Edịb Mme Keed</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />Edat aniọñ ebọp ufọk,</para>
  <para style="q2" vid="PRO 24:3">enyʌñ ekama mbufiọk ewuuk anye;<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />ato ke ifiọk mme ubeed amọ eyọhọ</para>
  <para style="q2" vid="PRO 24:4">ye nti ye mfọọn ñkpọuto.<verse eid="PRO 24:4" /></para>
  <para style="s2">Ayọhọ Ikọ Edịb Mme Iba</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />Awo aniọñ anie adikan ato akpọsọñ adudu,</para>
  <para style="q2" vid="PRO 24:5">ndin mbon se inie ifiọk esio inweek ammọ.<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />Ke akpanikọ afo ameyem ndadusʌñ adinwana ekọñ,</para>
  <para style="q2" vid="PRO 24:6">adikan anyʌñ ato ke uwak mme anọitem.<verse eid="PRO 24:6" /></para>
  <para style="s2">Ayọhọ Ikọ Edịb Mme Ita</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />Aniọñ akpon abọhọ anọ mme ndisịme;</para>
  <para style="q2" vid="PRO 24:7">ke itie mbono ke inuaatob ammọ inaaha ekʌppọ inua ammọ.<verse eid="PRO 24:7" /></para>
  <para style="s2">Ayọhọ Ikọ Edịb Mme Inaañ</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />Awo akeedodo a-aduakka idiọọk</para>
  <para style="q2" vid="PRO 24:8">ediidiọọñọ anye nte awo ñkara.<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />Ñkara ndisịme ado idiọọkñkpọ,</para>
  <para style="q2" vid="PRO 24:9">mme awo enyʌñ esua enọ awo ñnyọọ.<verse eid="PRO 24:9" /></para>
  <para style="s2">Ayọhọ Ikọ Edịb Mme Ition</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />Adieke afo aduọhọ ke ini mfịna,</para>
  <para style="q2" vid="PRO 24:10">adudu mfo ado etək-etək!<verse eid="PRO 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />Fak mbon e-edatta eka ñkpa;</para>
  <para style="q2" vid="PRO 24:11">biọọñọ mbon e-edatta eka adiwot.<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />Adieke afo abooho, “Ado ñnyịn ikidiọọñọke ibaña ñkpọ ami,”</para>
  <para style="q2" vid="PRO 24:12">nte andidomo esịd idiidiọọñọke ibaña?</para>
  <para style="q1" vid="PRO 24:12">Nte andikpeme uwem mfo idiọọñọke ado?</para>
  <para style="q2" vid="PRO 24:12">Nte anye idiinọọhọ afịd awo utịb ikeene se ammọ enam?<verse eid="PRO 24:12" /></para>
  <para style="s2">Ayọhọ Ikọ Edịb Mme Itiokeed</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />Ayịn awodeen mmi, dia adanakwọọk, sia anye a-afọn;</para>
  <para style="q2" vid="PRO 24:13">adanakwọọk a-atooho ndukpa adanakwọọk anem kpa naña afo ama.<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />Diọọñọ ñko ke aniọñ atie nte adanakwọọk unọ fiin:</para>
  <para style="q2" vid="PRO 24:14">Adieke afo akịtte anye, idodanyen ini iso mmọdo aba unọọ fiin,</para>
  <para style="q2" vid="PRO 24:14">ndin idodanyen mfo idiikpuuho.<verse eid="PRO 24:14" /></para>
  <para style="s2">Ayọhọ Ikọ Edịb Mme Itiaba</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />Kuudịbe nte idiọọk inọ ukpere ufọk ndinen awo,</para>
  <para style="q2" vid="PRO 24:15">kuubịme itie idʌñ ammọ;<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />sia akpesʌkado ndinen awo eduọhọ akañ itiaba, ammọ eyaemaana edakka eda,</para>
  <para style="q2" vid="PRO 24:16">ado mbon ibak edutịn ke nnananyen amaadi.<verse eid="PRO 24:16" /></para>
  <para style="s2">Ayọhọ Ikọ Edịb Mme Itiaita</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />Kuudaara ke ini asua mfo amaaduọ;</para>
  <para style="q2" vid="PRO 24:17">ammọ emaetuak ukod, kuuyak esịd mfo adaara,<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />imiidooho <char style="nd">Abọọñ</char> ayaakịt anyʌñ asua</para>
  <para style="q2" vid="PRO 24:18">anyʌñ awọññọ iyadesịd amọ akpọñ ammọ.<verse eid="PRO 24:18" /></para>
  <para style="s2">Ayọhọ Ikọ Edịb Mme Usʌkkeed</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />Kuunie mfịna ubaña mme anamidiọọk</para>
  <para style="q2" vid="PRO 24:19">me adifịbe mbon ibak,<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />sia anamidiọọk inieghe idodanyen ini iso</para>
  <para style="q2" vid="PRO 24:20">ndin eyaenịme utuenikañ awo ibak.<verse eid="PRO 24:20" /></para>
  <para style="s2">Ayọhọ Ikọ Edịb Mme Duob</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />Ayịn mmi, baak <char style="nd">Abọọñ</char> ye adidem,</para>
  <para style="q2" vid="PRO 24:21">kuunyʌñ udiana ye mme asọñiwuod mbon utom ukara,<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />sia ñkpọ iba ado eyaeben usọp-usọp nsobo esọk ammọ,</para>
  <para style="q2" vid="PRO 24:22">ndin anie awo idiọọñọ se utọ afanekọñ ke ammọ ekeme ediben ndi?<verse eid="PRO 24:22" /></para>
  <para style="ms1">Mme Ikọ Aniọñ Mfen</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />Mbon ami esʌk edo kpa mme ikọ aniọñ:</para>
  <para style="q1" vid="PRO 24:23">Aditeeñe awo anyen ke ubiideikpe ifọnnọ:<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />Awo akeedodo a-abooho adueñkpọ, “Afo udueghe,”</para>
  <para style="q2" vid="PRO 24:24">mbon awo eyaesuuñọ anye, mme idịd enyʌñ esua enọ anye.<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />Ado ayaafọn anọ mbon e-ebiommo mme adueñkpọ ikpe,</para>
  <para style="q2" vid="PRO 24:25">ndin uwak adidiọñ eyaedi ebịne ammọ.<verse eid="PRO 24:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />Ibọọrọ a-adooho akpanikọ</para>
  <para style="q2" vid="PRO 24:26">atie nte aditʌm awo ñkpọkinua.<verse eid="PRO 24:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />Nekke nam utom ke anwaesiin</para>
  <para style="q2" vid="PRO 24:27">nyʌñ fuut mme inwañ mfo bono;</para>
  <para style="q2" vid="PRO 24:27">umaukweeñe ado, bọp ufọk mfo.<verse eid="PRO 24:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />Kuutie ntiense nsu ubaña mbọhọidʌñ mfo ke ntak imiibaaha,</para>
  <para style="q2" vid="PRO 24:28">nte afo akpaadat inua mfo atịn awo usʌñ?<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />Kuubo, “Ami ñyaanam ammọ naña ammọ ekennam miin;</para>
  <para style="q2" vid="PRO 24:29">Ami ñyaasio ammọ usiene ke se ammọ ekenam.”<verse eid="PRO 24:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />Ami ñkesaña mboiyo ke inwañ awo ifu,</para>
  <para style="q2" vid="PRO 24:30">nsaña mboiyo ke inwañ fain awo i-imiinieghe eti iwuod;<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />mbaraekpe amaayọhọ afịd itie,</para>
  <para style="q2" vid="PRO 24:31">mbid amaatịppe afịd ikọd,</para>
  <para style="q2" vid="PRO 24:31">ndibene itiad amaanyʌñ awuuro.<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />Ami mmaaben esịd mmi nsịn ke se ñkekịt</para>
  <para style="q2" vid="PRO 24:32">ñnyʌñ ñkpeep ñkpọ nto se ami ñkekịt:<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />Etək-etək idab, etək-etək iyeed,</para>
  <para style="q2" vid="PRO 24:33">etək adibọp ubọk nduọk adudu,<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />ndin uweene ayaadi ubịne fiin nte inọ</para>
  <para style="q2" vid="PRO 24:34">unana ñko ayaadi ubịne fiin nte amauke.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="ms1">Mme Ñke Sọlọmọn Mfen</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />Mme ñke Sọlọmọn mfen ake mme adaaha Hesikaiya, adidem Yuda eketuumọ ebono edo ami:<verse eid="PRO 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />Ado ubọọñ Abasi adidịp ñkpọ;</para>
  <para style="q2" vid="PRO 25:2">adiduuñọ ñkpọ ndiọọñọ ado ubọọñ ndidem.<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />Kpa naña mme hefịn ekoñ isọñ anyʌñ atʌñọ,</para>
  <para style="q2" vid="PRO 25:3">kpa ntoro ke awo imiikanna iduuñọ esịd ndidem.<verse eid="PRO 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />Kwokko mbad sio ke silfa,</para>
  <para style="q2" vid="PRO 25:4">ndin anamusọ silfa ayaakan anam usan;<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />sịññe mme ibak mbon utom ukara fep ke iso adidem,</para>
  <para style="q2" vid="PRO 25:5">ndin eyaewuuk ebekpo amọ ke adinenido.<verse eid="PRO 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />Kuudịppe idem mfo ke iso adidem,</para>
  <para style="q2" vid="PRO 25:6">kuunyʌñ udat itie ke atu mme ikpọ adaaha amọ;<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />a-afọn anye adubo fiin, “Dọọk di mi,”</para>
  <para style="q2" vid="PRO 25:7">akan anye adusuenne fiin ke iso mme adaaha amọ.</para>
  <para style="b" vid="PRO 25:7" />
  <para style="q1" vid="PRO 25:7">Se afo akịt ke anyen mfo<verse eid="PRO 25:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 25:8" />kuusọp uben ukaa esob,</para>
  <para style="q1" vid="PRO 25:8">afo uduunam die ke utịd</para>
  <para style="q2" vid="PRO 25:8">adieke mbọhọidʌñ mfo usuenneke fiin?<verse eid="PRO 25:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />Adieke abenne mbọhọidʌñ mfo akaa esob,</para>
  <para style="q2" vid="PRO 25:9">kuuyaara ikọ esịd idịb awo mfen,<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />imiidooho ntoro awo a-akoppo anye akeme adusuenne fiin</para>
  <para style="q2" vid="PRO 25:10">isoikpe mfo ayaanyʌñ asọọñọ ada.<verse eid="PRO 25:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />Naña mme apịl e-enamma ke kold esịne ke usan silfa</para>
  <para style="q2" vid="PRO 25:11">ke nnekke-nnekke ubiideikpe ado.<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />Nte ñkpọutọñ e-enamma ke kold me ñkpọ mmaidem eti kold mfen</para>
  <para style="q2" vid="PRO 25:12">kpa ntoro ke ntʌnọ abiideikpe a-anieghe aniọñ aba ke utọñ mme andikob.<verse eid="PRO 25:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />Nte ataa ndedeñ mmọọñ ke ini idọk</para>
  <para style="q2" vid="PRO 25:13">ntoro ke anam akpanikọ isʌñutom ado anọ andidọñ anye utom;</para>
  <para style="q2" vid="PRO 25:13">anye ademme sịbidịd eteufọk amọ.<verse eid="PRO 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />Nte mme ntọñanyọñ ye afịm i-imiisañake ye edịm</para>
  <para style="q2" vid="PRO 25:14">ntoro ke awo a-akpọọhọ inua ke mme enọ a-awo imiinọọhọ anye kpaanam ado.<verse eid="PRO 25:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />E-ekeme adikama ime ekpek adaukara,</para>
  <para style="q2" vid="PRO 25:15">ñko ifuuro-ifuuro edeme a-akeme adibuuñ akpọ.<verse eid="PRO 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />Adieke afo akịtte adanakwọọk, dia etək-etək,</para>
  <para style="q2" vid="PRO 25:16">amaawak abọhọ, afo ayaakọk.<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />Baabat ini se akaa ufọk mbọhọidʌñ mfo,</para>
  <para style="q2" vid="PRO 25:17">umaukaan ubọhọ, ammọ eyausua fiin.<verse eid="PRO 25:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />Awo a-atieghe ntiense nsu abaña mbọhọidʌñ amọ</para>
  <para style="q2" vid="PRO 25:18">aba nte akpeti me akañkañ me idañ a-asọbọke.<verse eid="PRO 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />Adinie idodanyen ke awo abiaña ke usen nnananyen</para>
  <para style="q2" vid="PRO 25:19">aba nte eded a-abʌññọke me ukod a-akọkkọke.<verse eid="PRO 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />Awo a-akwọọhọ ikwọ anọ mbon iduọesịd</para>
  <para style="q2" vid="PRO 25:20">aba nte awo a-asịññeke afọñidem ke usen atueb,</para>
  <para style="q2" vid="PRO 25:20">me nte fineka e-eduọkkọ ke anyenunan.<verse eid="PRO 25:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />Adieke abiọọñ adọññọ asua mfo, nọ anye ndidia yak adia;</para>
  <para style="q2" vid="PRO 25:21">adieke itọñ asatta anye, nọ anye mmọọñ yak anwọñ.<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />Ke adinam ntom, afo ayaadot ufiob ukañ ke iwuod amọ,</para>
  <para style="q2" vid="PRO 25:22">ndin <char style="nd">Abọọñ</char> ayaunọ fiin utịb.<verse eid="PRO 25:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />Edeme mbubịk, a-anamma ndịk awuọ ke iso awo</para>
  <para style="q2" vid="PRO 25:23">aba nte afịm adoro a-asañake ye adiwad edịm<verse eid="PRO 25:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />A-afọn adidʌñ ke mben akọm</para>
  <para style="q2" vid="PRO 25:24">akan adiwana ufọk ye utọk-utọk anwaan.<verse eid="PRO 25:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />Eti etob a-atooho anyan idịd adi</para>
  <para style="q2" vid="PRO 25:25">aba nte ndedeñ mmọọñ ke esịd awo a-akpaaha mba.<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />Ndinen awo e-eyaaha itie enọ mbon ibak</para>
  <para style="q2" vid="PRO 25:26">eba nte akpʌk idịm me utebe ñkpọdiọhọ mmọọñ.<verse eid="PRO 25:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />Ifọnnọ adidia adanakwọọk awak abọhọ,</para>
  <para style="q2" vid="PRO 25:27">ukpono inyʌññọ iba ke adiduuñọ mme ñkpọ se itəño.<verse eid="PRO 25:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />Awo i-imiinieghe mfarakeidem,</para>
  <para style="q2" vid="PRO 25:28">aba nte abio ake ndibene amọ amaawuuro.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />Nte sino ke ini ndaayio me edịm ke ini idọk,</para>
  <para style="q2" vid="PRO 26:1">ukpono idotto ndisịme.<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />Nte inuen ntadusʌñ ammiisọrọke me akadañabasi a-ataamataam,</para>
  <para style="q2" vid="PRO 26:2">isuuñọ ammiinieghe ntak idegheke.<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />Ikpa anie enañmbakara, ñkpaha anie dọñki,</para>
  <para style="q2" vid="PRO 26:3">ntoro ke ikpa anie edem mme ndisịme!<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />Kuubọọrọ ndisịme awo ukeene naña anye atʌnọ,</para>
  <para style="q2" vid="PRO 26:4">imiidooho ntoro afo ke idem mfo uduuba nte anye.<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />Bọọrọ ndisịme keene naña anye atʌnọ,</para>
  <para style="q2" vid="PRO 26:5">imiidooho ntoro anye ayaaforo awo aniọñ ke anyen amọ.<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />Adidọñ etob ke ubọk ndisịme</para>
  <para style="q2" vid="PRO 26:6">aba nte awo adikpịkke ukod amọ nsio me adinwọñ ibọk ñkpa.<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />Ñke ke inua ndisịme</para>
  <para style="q2" vid="PRO 26:7">aba nte ukod awo mbʌñọ i-imiibaaha ufọn.<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />Adinọ ndisịme ukpono</para>
  <para style="q2" vid="PRO 26:8">aba nte aditobo itiad ke ikañakpọ.<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />Ñke ke inua ndisịme</para>
  <para style="q2" vid="PRO 26:9">aba nte ñkukịm ke ubọk akpammịn.<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />Awo a-akpeeghe ndisịme me awo a-aboiyoke ke usʌñ utom</para>
  <para style="q2" vid="PRO 26:10">aba nte atịgha idañ a-anọọhọ awo unan ntịme-ntịme.<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />Kpa naña ewa atịmme abịne akikọi amọ</para>
  <para style="q2" vid="PRO 26:11">kpa ntoro ke mme ndisịme emaana enam ndisịme ammọ.<verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />Nte afo amekịt awo a-adatta idem ammọ nte mbon aniọñ?</para>
  <para style="q2" vid="PRO 26:12">Idodanyen a-aba anọ ndisịme akan ammọ.<verse eid="PRO 26:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />Ifu ate, “Ekpe mmọdo aba ke usʌñ,</para>
  <para style="q2" vid="PRO 26:13">aniendịk ekpe asʌk ayooñ ke usʌñ!”<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />Kpa naña udọk awọññọ ke iba udọk amọ,</para>
  <para style="q2" vid="PRO 26:14">kpa ntoro ke ifu awọññọ ke akwañ amọ.<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />Awo ifu abuuk ubọk amọ ke usan;</para>
  <para style="q2" vid="PRO 26:15">anye akop ifu eti-eti adisio ubọk ñkesịn ke inua amọ.<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />Ifu akịt idem amọ nte imọ imidiọọñọ ñkpọ</para>
  <para style="q2" vid="PRO 26:16">ikan awo itiaba ebọọrọke ye ikike.<verse eid="PRO 26:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />Awo a-asọppọ atop idem amọ asịn ke utọk i-imiibegheke anye</para>
  <para style="q2" vid="PRO 26:17">aba nte awo a-amʌmmọ idaad ewa ke utọñ.<verse eid="PRO 26:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18" />Kpa naña idaad atop</para>
  <para style="q2" vid="PRO 26:18">mme ikañ-ikañ idañ ñkpa<verse eid="PRO 26:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19" />kpa ntoro ke aba ye awo a-abiañake mbọhọidʌñ ammọ</para>
  <para style="q2" vid="PRO 26:19">anyʌñ abo, “Ami ñkebre mbre!”<verse eid="PRO 26:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />Ifia imiibaaha ikañ anịme;</para>
  <para style="q2" vid="PRO 26:20">mbia imiibaaha utọk akweeñe.<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />Nte ñkañ ke ndubek kpa ntoro ifia ke ikañ,</para>
  <para style="q2" vid="PRO 26:21">kpa ntoro ke awo utọk abara ikañ asịn ke utọk.<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />Ikọ awo mbia atie nte inem ndidia;</para>
  <para style="q2" vid="PRO 26:22">ammọ esọiyọ edʌk ataa esịd-esịd idem.<verse eid="PRO 26:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />Uyaiya ñkpọkinua e-enieghe udu ke esịd</para>
  <para style="q2" vid="PRO 26:23">Eba nte ako mbad e-edatta silfa edeppe.<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />Mme asua edịbe ke ñkpọkinua ammọ,</para>
  <para style="q2" vid="PRO 26:24">ado ke esịd ammọ ekama abiaña.<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />Akpesʌkado ikọ ammọ anemme, kuunịm ammọ ke akpanikọ,</para>
  <para style="q2" vid="PRO 26:25">sia mbubiam itiaba eyọhọ esịd ammọ.<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />Ammọ ekeme adikama abiaña edịb udu ammọ,</para>
  <para style="q2" vid="PRO 26:26">ado eyaeyaara ibak ammọ ke atayad mbono.<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />Awo akeedodo a-adọkkọ ukpe ayaaduọ adʌk anye;</para>
  <para style="q2" vid="PRO 26:27">adieke awo awereke itiad, itiad ado ayaatịmme awere aditọ ammọ.<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />Nsu-nsu edeme asasua mbon se anye abiat,</para>
  <para style="q2" vid="PRO 26:28">ndin nneminua asịn nsobo.<verse eid="PRO 26:28" /></para>
  <para style="b" />
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />Kuukpọọ inua ubaña ñkpọñ,</para>
  <para style="q2" vid="PRO 27:1">sia afo udiọọñọke se usen akeme adikama.<verse eid="PRO 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />Yak awo mfen utooro fiin, ke ato inua mfo;</para>
  <para style="q2" vid="PRO 27:2">awoesiin, ke ato ñkpọkinua mfo.<verse eid="PRO 27:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />Itiad adoppo, ntan ñko ado mbiomo,</para>
  <para style="q2" vid="PRO 27:3">ado iyadesịd ndisịme adoppo akan naña iba.<verse eid="PRO 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />Iyadesịd ado mfiomo ifiobesịd anyʌñ afuuk awo,</para>
  <para style="q2" vid="PRO 27:4">ado anie ikan ida ke iso ufịb?<verse eid="PRO 27:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />Anwa-anwa nsuannọ</para>
  <para style="q2" vid="PRO 27:5">a-afọn akan ndịbe ima.<verse eid="PRO 27:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />Ekeme edinie mbuọdidem ke mme unan a-atooho ufan,</para>
  <para style="q2" vid="PRO 27:6">ado asua anam ntʌminua awak.<verse eid="PRO 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />Awo ndiañyʌkkọ asịn adanakwọọk ke mbio,</para>
  <para style="q2" vid="PRO 27:7">ado idodñkpọ ado inịññe anọ awo abiọọñ.<verse eid="PRO 27:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />Awo ndomokeed a-afegheke akpọñ ufọk amọ</para>
  <para style="q2" vid="PRO 27:8">aba nte inuen a-afuurọke akpọñ efọk amọ.<verse eid="PRO 27:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />Pefium ye insensi enam esịd awo anem,</para>
  <para style="q2" vid="PRO 27:9">ñko inem ufan</para>
  <para style="q2" vid="PRO 27:9">awuọ ato item awọñesịd ammọ.<verse eid="PRO 27:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />Kuufeghe ukpọñ ufan mfo me ufan ufọk ndufo,</para>
  <para style="q2" vid="PRO 27:10">kuunyʌñ ukaa ufọk ayakka mfo umaunie mfịna,</para>
  <para style="q2" vid="PRO 27:10">mbọhọidʌñ a-akpereke a-afọn akan ayakka ke anyan usʌñ.<verse eid="PRO 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />Ayịn mmi, nie aniọñ nyʌñ nam esịd mmi anem;</para>
  <para style="q2" vid="PRO 27:11">ndin ami ñyaakan mbọọrọ awo akeedodo annọọhọ miin usọñanyen.<verse eid="PRO 27:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />Adiọọñọidem awo akịt afanekọñ adʌk adịbe,</para>
  <para style="q2" vid="PRO 27:12">ado akọi asʌk asaña aka anyʌñ abọ unọmọ.<verse eid="PRO 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />Ben afọñidem awo a-atieghe ubiọñ anọ asenawo;</para>
  <para style="q2" vid="PRO 27:13">kama anye ke ubiọñ akpedo anam anọ awo esiin.<verse eid="PRO 27:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />Awo ndomokeed akpebak adiọñ mbọhọidʌñ amọ ubakusen ke akpọsọñ uyio,</para>
  <para style="q2" vid="PRO 27:14">ediidat ado nte isuuñọ.<verse eid="PRO 27:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />Utọk-utọk anwaan aba nte ntọi</para>
  <para style="q2" vid="PRO 27:15">nsịtte akọm ufọk a-adịtte ke ini ayobio edịmukwọ;<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />adidomo aditre anye atie nte aditre afịm</para>
  <para style="q2" vid="PRO 27:16">me adimʌm adan ke ubọk.<verse eid="PRO 27:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />Naña ukwak aban ukwak,</para>
  <para style="q2" vid="PRO 27:17">kpa ntoro ke awo keed aban awo mfen.<verse eid="PRO 27:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />Andikpeme eto fik ayaadia mfịd amọ,</para>
  <para style="q2" vid="PRO 27:18">ñko awo akeedodo a-akpemeke eteufọk ammọ ayaabọ ukpono.<verse eid="PRO 27:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />Naña mmọọñ awọt ndukpọñ iso awo,</para>
  <para style="q2" vid="PRO 27:19">kpa ntoro ke uwem awo awọt se isịne anye ke esịd.<verse eid="PRO 27:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />Ñkpa ye Nsobo<note caller="+" style="f"><char style="fr" closed="false">27:20 </char><char style="ft" closed="false">Ke Hibru ado </char><char style="fqa" closed="false">Abadọn</char></note> kpaanam ikoppo uyʌkkọ,</para>
  <para style="q2" vid="PRO 27:20">ntoro ye anyen awo.<verse eid="PRO 27:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />Enam ako ukwak enọ silfa enyʌñ enam ñkpọdiọhọ ikañ enọ kold,</para>
  <para style="q2" vid="PRO 27:21">ado edomo mme awo ekeene itooro ammọ.<verse eid="PRO 27:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />Akpekọm afo akọk ndisịme ke udʌñ,</para>
  <para style="q2" vid="PRO 27:22">a-akama ñyịnudʌñ akọk ammọ nte abakpa,</para>
  <para style="q2" vid="PRO 27:22">afo uduukanna usio ndisịme ke idem ammọ.<verse eid="PRO 27:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />Kịt bo ke amediọọñọ naña mme ufene mfo eba,</para>
  <para style="q2" vid="PRO 27:23">nekke suuk anyen se udịmenañ mfo;<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />sia inie ibaaha ke nsi-nsi,</para>
  <para style="q2" vid="PRO 27:24">awo inyʌññọ inịm anyanya nsọọñọ inọ afịd emana.<verse eid="PRO 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />Emaekpot ñnyanyaha esio nọ ufa mbid emịne anyʌñ atịppe</para>
  <para style="q2" vid="PRO 27:25">enyʌñ ekoono mbid ke ntəkabod edʌk edi,<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />ñyịn edọñ eyaunọ fiin afọñ,</para>
  <para style="q2" vid="PRO 27:26">mme ebod eyaenyʌñ unọ fiin akʌk isọñ<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />Afo ayaanie uwak mmọọñeba ebod se ufọk mfo enwọñ</para>
  <para style="q2" vid="PRO 27:27">anyʌñ akama abọọk nditọufọk mfo ibaan.<verse eid="PRO 27:27" /></para>
  <para style="b" />
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />Awo ibak afeghe itọk ke ini awo imiibịneke anye,</para>
  <para style="q2" vid="PRO 28:1">ado adinen awo akop uko nte ekpe.<verse eid="PRO 28:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />Idịd amaaba ke ntịme, anye anie uwak mme andikara,</para>
  <para style="q2" vid="PRO 28:2">ado adaukara a-anieghe ikike ye ifiọk anekke anye anịm.<verse eid="PRO 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />Adaukara a-akuudo mbon uweene</para>
  <para style="q2" vid="PRO 28:3">atie nte ananautịd edịm a-adooho ifeene ñkpọinwañ.<verse eid="PRO 28:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />Mbon e-ewọññọke ekpọñ item etooro mbon ibak,</para>
  <para style="q2" vid="PRO 28:4">ado mbon se ikop item esọọn ammọ.<verse eid="PRO 28:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />Mme anam idiọọk idiọọñọke se inen,</para>
  <para style="q2" vid="PRO 28:5">ado anwaña mbon se iyem <char style="nd">Abọọñ</char> ayọhọ-ayọhọ.<verse eid="PRO 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />Afọn adido uweene nnana ndo</para>
  <para style="q2" vid="PRO 28:6">akan adido imọ ndo abʌd-abʌd awo.<verse eid="PRO 28:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />Adiọọñọidem ayịn akop item,</para>
  <para style="q2" vid="PRO 28:7">ado ansidʌk ndʌk ye mme adiauyʌkkọ asuenne ete amọ.<verse eid="PRO 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />Awo akeedodo a-akọọhọ inie ato adibọ udod nto uweene,</para>
  <para style="q2" vid="PRO 28:8">akọọk inie ado anịm anọ awo mfen, a-adiifọn ido ye mbon uweene.<verse eid="PRO 28:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />Awo akeedodo i-imiikpañña utọñ inọ item mmi,</para>
  <para style="q2" vid="PRO 28:9">idem ataa akam ammọ edo mbubiam.<verse eid="PRO 28:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />Awo akeedodo a-adatta adinen awo adʌk idiọọk usʌñ</para>
  <para style="q2" vid="PRO 28:10">ayaaduọ adʌk afia ammọ,</para>
  <para style="q2" vid="PRO 28:10">ado awo a-ananake ndo ayaabọ eti udeeme.<verse eid="PRO 28:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />Imọ awo akeme ido aniọñ ke anyen amọ;</para>
  <para style="q2" vid="PRO 28:11">awo a-adooho uweene anyʌñ anie ikike adiọọñọ ke anye abiaña idem ammọ.<verse eid="PRO 28:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />Adinen awo amaanie edikan, idaara akpon;</para>
  <para style="q2" vid="PRO 28:12">ado awo ibak amaadọọk ada ke ukara, mme awo edʌk edịbe.<verse eid="PRO 28:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />Awo akeedodo a-adịppe idiọọkñkpọ amọ iforoke,</para>
  <para style="q2" vid="PRO 28:13">ado awo a-ayaarake idiọọkñkpọ anyʌñ adiañña idem akpọñ ammọ ayaakịt mfọn.<verse eid="PRO 28:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />Afọfọn anọ awo a-abaaha <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="PRO 28:14">ado awo akeedodo a-asọññọ esịd adʌk mfịna.<verse eid="PRO 28:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />Ibak adaukara a-akarake mbon i-imiinieghe unwam</para>
  <para style="q2" vid="PRO 28:15">aba nte ekpe a-akuunọ me amọnikọd a-abịneke awo.<verse eid="PRO 28:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />Adaukara ananake aniọñ akara ke ufiik,</para>
  <para style="q2" vid="PRO 28:16">ado anye a-asuaha idiọọk udod ayaakop inem ukara akpeene.<verse eid="PRO 28:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />Awo ndomokeed ake esịd amọ amiaha anye ufen ke ntak uwodawo</para>
  <para style="q2" vid="PRO 28:17">adiiyem udịbe ke udi ñkpa;</para>
  <para style="q2" vid="PRO 28:17">ke awo ndomokeed amʌm anye.<verse eid="PRO 28:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />Awo u-usʌñ amọ ananake ndo a-anie ubọkkọ,</para>
  <para style="q2" vid="PRO 28:18">ado anye u-usʌñ amọ adooho abʌd-abʌd ayaaduọ adʌk ube.<verse eid="PRO 28:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />Mbon e-enamma utom ke inwañ ammọ eyaenie akpọmiọk ndidia,</para>
  <para style="q2" vid="PRO 28:19">ado mbon e-ebịneke ndab eyaekịt unana.<verse eid="PRO 28:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />Awo akpanikọ ayaabọ adidiọñ,</para>
  <para style="q2" vid="PRO 28:20">ado awo a-ayemme inie usọp-usọp idiitreke ibọ ufen.<verse eid="PRO 28:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />Adiwọt adusad ifọnnọ,</para>
  <para style="q2" vid="PRO 28:21">kpayeado awo ayaanam idiọọkñkpọ ke ntak mbeñe uyo.<verse eid="PRO 28:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />Mbon efaam eyem imọinyọ usọp-usọp</para>
  <para style="q2" vid="PRO 28:22">idiọọñọke ke nsobo asʌk abet ammọ.<verse eid="PRO 28:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />Awo akeedodo a-asuaha anọ awo ayaakịt mfọn ke utịd</para>
  <para style="q2" vid="PRO 28:23">akan awo a-akamake edeme amọ atiik awo.<verse eid="PRO 28:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />Awo akeedodo a-ayịppe ñkpọ ete me ake eka amọ</para>
  <para style="q2" vid="PRO 28:24">ndin abo, “Idooho idiọọkñkpọ,”</para>
  <para style="q2" vid="PRO 28:24">ado nsaña ye awo nsobo.<verse eid="PRO 28:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />Mbon idiọọkitọñ etọọñọ utọk,</para>
  <para style="q2" vid="PRO 28:25">ado mbon se idot anyen ke <char style="nd">Abọọñ</char> eyaeforo.<verse eid="PRO 28:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />Mbon e-enieghe mbuọdidem ke idem ammọ edo ndisịme,</para>
  <para style="q2" vid="PRO 28:26">ado mbon e-esañake ke aniọñ etie ke ifuuro.<verse eid="PRO 28:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />Mbon e-enọọhọ uweene enọ idiinanake ñkpọ ndomokeed,</para>
  <para style="q2" vid="PRO 28:27">ado mbon e-ebọọbọ anyen enam nte ikịtte ammọ ediibọ uwak isuuñọ.<verse eid="PRO 28:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />Mbon ibak emaedọọk eda ke ukara, mbon awo edʌk edịbe;</para>
  <para style="q2" vid="PRO 28:28">ado mbon ibak emaekịt nsobo, ndinen awo eforo.<verse eid="PRO 28:28" /></para>
  <para style="b" />
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />Awo akeedodo a-asọññọ aboditọñ ke emaetʌnọ anye ke uwak ini</para>
  <para style="q2" vid="PRO 29:1">adiisọsọp akịt nsobo, unyaaña ibaaha.<verse eid="PRO 29:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />Ndinen awo emaeforo, mbon awo edaara;</para>
  <para style="q2" vid="PRO 29:2">mbon ibak emaekaara, mme awo ekuun.<verse eid="PRO 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />Awo a-amaaha aniọñ adat idaara asọk ete amọ,</para>
  <para style="q2" vid="PRO 29:3">ado adʌk nsaña ye ibaan akpara atahade inie amọ.<verse eid="PRO 29:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />Adidem akama unen anọ idịd amọ nsọọñọnda,</para>
  <para style="q2" vid="PRO 29:4">ado mbon e-enieghe idiọọkitọñ ebaña ubọkedem ewuut anye.<verse eid="PRO 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />Mbon e-etiighe mme mbọhọidʌñ ammọ</para>
  <para style="q2" vid="PRO 29:5">ebịt iyịre enọ ukod ammọ.<verse eid="PRO 29:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />Mme anamidiọọk edʌk afia idiọọkñkpọ ammọ,</para>
  <para style="q2" vid="PRO 29:6">ado ndinen awo esio ñkpo idaara enyʌñ ekop inemesịd.<verse eid="PRO 29:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />Ndinen awo ekere ñkpọ ebaña unen mbon uweene,</para>
  <para style="q2" vid="PRO 29:7">ado mbon ibak inieghe utọ akikere ado.<verse eid="PRO 29:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />Mme asak awo ñkpọ esịn mfịna ke abio,</para>
  <para style="q2" vid="PRO 29:8">ado mbon aniọñ ewọññọ iyadesịd esio.<verse eid="PRO 29:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />Adieke awo aniọñ akaaha esob ye ndisịme,</para>
  <para style="q2" vid="PRO 29:9">ndisịme ayat esịd anyʌñ aduọi, ndin emem ibaaha.<verse eid="PRO 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />Mbon afai esua awo eti ido</para>
  <para style="q2" vid="PRO 29:10">enyʌñ eyem adiwot ndinen awo.<verse eid="PRO 29:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />Mme ndisịme ewọt afịd iyadesịd ammọ,</para>
  <para style="q2" vid="PRO 29:11">ado mbon aniọñ esịn emem ke utịd.<verse eid="PRO 29:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />Adieke adaukara akpañña utọñ anọ nsu,</para>
  <para style="q2" vid="PRO 29:12">afịd mbon utom amọ eyaekappa mbon ibak.<verse eid="PRO 29:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />Uweene ye afiikawo ewuana ñkpọ keed:</para>
  <para style="q2" vid="PRO 29:13">
    <char style="nd">Abọọñ</char> anọ naña ammọ iba anyen.<verse eid="PRO 29:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />Adieke adidem akpeeghe ikpe uweene ke unen,</para>
  <para style="q2" vid="PRO 29:14">ebekpo amọ ayaanie iwuuk ke nsi-nsi.<verse eid="PRO 29:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />Ikpa ye ntʌnọ enọ aniọñ,</para>
  <para style="q2" vid="PRO 29:15">ado ayịn ake awo imiitʌnọke asisuenne eka amọ.<verse eid="PRO 29:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />Mbon ibak emaeforo, idiọọkñkpọ atọt,</para>
  <para style="q2" vid="PRO 29:16">ado ndinen awo eyaekịt iduọ ammọ.<verse eid="PRO 29:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />Tʌnọ nditọ mfo, ndin ammọ eyaunọ fiin emem;</para>
  <para style="q2" vid="PRO 29:17">ammọ eyaedat nti ñkpọ se afo ayem usọk fiin.<verse eid="PRO 29:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />Itie a-ñkukịd imiibaaha, mme awo esaña naña ema;</para>
  <para style="q2" vid="PRO 29:18">ado afọfọn anọ awo a-akoppo item aniọñ.<verse eid="PRO 29:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />Idooho ikọ kpọd ke edat enekke nditọufọk;</para>
  <para style="q2" vid="PRO 29:19">sia akpesʌkado ammọ ediọọñọke, ammọ idiibọọrọke.<verse eid="PRO 29:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />Afo amekịt awo a-atañña ikọ usọp-usọp?</para>
  <para style="q2" vid="PRO 29:20">Idodanyen a-aba anọ ndisịme akan utọ ibon ado.<verse eid="PRO 29:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />Ayịnufọk e-edekkedek ekama tọọñọ ke uyịn</para>
  <para style="q2" vid="PRO 29:21">ayaakappa ado awo usọñanyen.<verse eid="PRO 29:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />Awo iyadesịd atọọñọ mfịna,</para>
  <para style="q2" vid="PRO 29:22">awo ifiobesịd anyʌñ anam uwak idiọọkñkpọ.<verse eid="PRO 29:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />Ntañidem asuuhọ awo itie,</para>
  <para style="q2" vid="PRO 29:23">ado awo nsuukidem ayaanie ukpono.<verse eid="PRO 29:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />Mme asaña nsaña ye inọ edo kpa asua ammọ;</para>
  <para style="q2" vid="PRO 29:24">esịn ammọ ke idak unwọñọ ndin ammọ ikanna itie ntiense.<verse eid="PRO 29:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />Ubaak awo anyen adiido afia,</para>
  <para style="q2" vid="PRO 29:25">ado awo akeedodo a-anieghe mbuọdidem ke <char style="nd">Abọọñ</char> aba ke ifuuro.<verse eid="PRO 29:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />Uwak awo eyem adikịt adaukara,</para>
  <para style="q2" vid="PRO 29:26">ado awo abọ unen ato <char style="nd">Abọọñ</char>.<verse eid="PRO 29:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />Adinen awo asua awo ñwo;</para>
  <para style="q2" vid="PRO 29:27">awo ibak asua adinen awo.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="ms1">Mme Ikọ Akọọ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Mme ikọ Akọọ ayịn Yake aketañña ado ami, ikọ e-eyaarake.</para>
  <para style="q1" vid="PRO 30:1">Ikọ ete ami aketañña anọ Itiel:</para>
  <para style="b" vid="PRO 30:1" />
  <para style="q1" vid="PRO 30:1">Abasi, ami mmekpa mba,</para>
  <para style="q2" vid="PRO 30:1">ado ami mmekeme adikan.<verse eid="PRO 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />Ke akpanikọ, ami ndo ataa unam,</para>
  <para style="p" vid="PRO 30:2">ndooho awo;</para>
  <para style="q2" vid="PRO 30:2">ami nnieghe mbufiọk awo.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />Ami ñkpeebe aniọñ,</para>
  <para style="q2" vid="PRO 30:3">ñnyʌññọ nnie ifiọk nsịm ake Adisana Awo.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />Anie awo ikaa anyọñ imaana itịmme idi?</para>
  <para style="q2" vid="PRO 30:4">Ubọk anie awo amʌm afịm?</para>
  <para style="q1" vid="PRO 30:4">Anie awo abọp mmọọñ ke afọñ?</para>
  <para style="q2" vid="PRO 30:4">Anie awo ado andiwuuk afịd utịd ederimbod?</para>
  <para style="q1" vid="PRO 30:4">Anye akere die, ayịn amọ anyʌñ akere die?</para>
  <para style="q2" vid="PRO 30:4">Ke akpanikọ afo amediọọñọ!<verse eid="PRO 30:4" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />“Afịd ikọ Abasi inieghe ndo;</para>
  <para style="q2" vid="PRO 30:5">Anye ado ukpeme anọ mbon e-edịbeke ke anye.<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />Kuudian ikọ ke ikọ amọ,</para>
  <para style="q2" vid="PRO 30:6">imiidooho anye ayaasua unọ fiin anyʌñ awọt ke afo ado awo nsu.<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />“<char style="nd">Abọọñ</char>, ñkpọ iba ke ami ubeeñe fiin,</para>
  <para style="q2" vid="PRO 30:7">kunsịn miin mbemiso ami ñkpa:<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />Yak abiaña ye nsu eda nsan-nsan eñkpọñ miin;</para>
  <para style="q2" vid="PRO 30:8">kuunam ami ndo akpọikpọi uweene me ndo imọ awo,</para>
  <para style="q2" vid="PRO 30:8">ado nnọ miin se ndia ke usen ke usen kpọd.<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />Imiidooho, ami ñyaamọinyọ mbọhọ ñnyʌñ usịn fiin,</para>
  <para style="q2" vid="PRO 30:9">ñnyʌñ mbo ‘Anie ado <char style="nd">Abọọñ</char>?’</para>
  <para style="q1" vid="PRO 30:9">Imiidooho, ami ñkappa akpọikpọi uweene ñnyʌñ ñyịp inọ,</para>
  <para style="q2" vid="PRO 30:9">ñnyʌñ nsuenne anyịñ Abasi mmi.<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />“Kuubiat ayịnufọk unọọ eteufọk amọ,</para>
  <para style="q2" vid="PRO 30:10">imiidooho anye ayausuuñọ fiin, ndin ayaukpa ñkpọ.<verse eid="PRO 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />“Aba mbon esuuñọke mme ete ammọ</para>
  <para style="q2" vid="PRO 30:11">inyʌññọ idiọñ mme eka ammọ;<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />mbon e-esanake ke anyen ammọ</para>
  <para style="q2" vid="PRO 30:12">ado iyette ndek ammọ isio;<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />mbon e-ekamake anyen ke anyọñ,</para>
  <para style="q2" vid="PRO 30:13">ese ñkpọ ke ndek;<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />mbon e-eded ammọ edooho akañkañ</para>
  <para style="q2" vid="PRO 30:14">ikwa enyʌñ edọñọ ke mbañ ammọ</para>
  <para style="q1" vid="PRO 30:14">nọ eta mme uweene esio ke ederimbod</para>
  <para style="q2" vid="PRO 30:14">ye mbon unana ke atu ubonawo.<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />“Itued anie nditọ ibaan iba.</para>
  <para style="q2" vid="PRO 30:15">Ammọ ebọọñ ‘Nọ! Nọ!’</para>
  <para style="b" vid="PRO 30:15" />
  <para style="li1" vid="PRO 30:15">“Ñkpọ ita eba a-adooho kpaanam ikoppo uyʌkkọ,</para>
  <para style="li2" vid="PRO 30:15">inaañ a-adooho kpaanam ibooho, ‘Akem!’:<verse eid="PRO 30:15" /></para>
  <para style="li3">
    <verse number="16" style="v" sid="PRO 30:16" />udi</para>
  <para style="li3" vid="PRO 30:16">ye idịb ada;</para>
  <para style="li3" vid="PRO 30:16">isọñ, a-adooho kpaanam ikoppo uyʌkkọ mmọọñ,</para>
  <para style="li3" vid="PRO 30:16">ye ikañ, a-adooho kpaanam ibooho, ‘Akem!’<verse eid="PRO 30:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />“Anyen a-anọọhọ ete ñnyọọ,</para>
  <para style="q2" vid="PRO 30:17">asoono usọñ eka,</para>
  <para style="q1" vid="PRO 30:17">mme ekọọñebʌkayob abedeñ eyaekọọñ esio,</para>
  <para style="q2" vid="PRO 30:17">utere eyaeta ammọ.<verse eid="PRO 30:17" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="18" style="v" sid="PRO 30:18" />“Aba ñkpọ ita se inekke iñkpa miin idem,</para>
  <para style="li2" vid="PRO 30:18">ñkpọ inaañ edo se ami mmiinieghe ifiọk mbaña:<verse eid="PRO 30:18" /></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 30:19" />usʌñ ntrukpuum ke ikpaanyọñ,</para>
  <para style="li3" vid="PRO 30:19">usʌñ udʌkikọd ke anyọñ itiad,</para>
  <para style="li3" vid="PRO 30:19">usʌñ nsʌñikañ ke ufọọd akpainyañ,</para>
  <para style="li3" vid="PRO 30:19">ye usʌñ awodeen ye abọikpa.<verse eid="PRO 30:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />“Usʌñ awonwaan efịbe ado ami:</para>
  <para style="q2" vid="PRO 30:20">Anye adia anyʌñ akwokko inua</para>
  <para style="q2" vid="PRO 30:20">ndin ate, ‘Ami nnamma idiọọk ndomokeed.’<verse eid="PRO 30:20" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="21" style="v" sid="PRO 30:21" />“Ke idak ñkpọ ita ederimbod anyeeñe,</para>
  <para style="li2" vid="PRO 30:21">ke idak ñkpọ inaañ anye ikanna iyọ:<verse eid="PRO 30:21" /></para>
  <para style="li3">
    <verse number="22" style="v" sid="PRO 30:22" />ayịnufọk a-akappake ado adidem,</para>
  <para style="li3" vid="PRO 30:22">ndisịme a-anieghe uwak ñkpọ se adia,<verse eid="PRO 30:22" /></para>
  <para style="li3">
    <verse number="23" style="v" sid="PRO 30:23" />mbuka awonwaan a-adọọhọ ndọ,</para>
  <para style="li3" vid="PRO 30:23">ye ayịnufọk awonwaan a-adatta itie ekaufọk amọ.<verse eid="PRO 30:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="PRO 30:24" />“Ñkpọ inaañ ke ederimbod edo ntək-ntək,</para>
  <para style="li2" vid="PRO 30:24">ado enie aniọñ ataa eti-eti:<verse eid="PRO 30:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="PRO 30:25" />Mme akpaisọñ edo unam etək udịd</para>
  <para style="li3" vid="PRO 30:25">ado ammọ ekoono ndidia ebono ke ndaayio;<verse eid="PRO 30:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="PRO 30:26" />mme akukọñitiad edo ekpu etək inweek,</para>
  <para style="li3" vid="PRO 30:26">ado ammọ enam itie idʌñ ammọ ke abaitiad;<verse eid="PRO 30:26" /></para>
  <para style="li2">
    <verse number="27" style="v" sid="PRO 30:27" />ñkukuñkpọyọriyọ inieghe adidem,</para>
  <para style="li3" vid="PRO 30:27">ado ammọ esaña keed ke udịm ke ikpeghe ke ikpeghe;<verse eid="PRO 30:27" /></para>
  <para style="li2">
    <verse number="28" style="v" sid="PRO 30:28" />e-ekeme adimʌm akpọk ke ubọk,</para>
  <para style="li3" vid="PRO 30:28">ado ekịt anye ke mme akwere adidem.<verse eid="PRO 30:28" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="29" style="v" sid="PRO 30:29" />“Aba ñkpọ ita e-esañake uko-uko</para>
  <para style="li2" vid="PRO 30:29">inaañ e-esañake ye uku ubọọñ:<verse eid="PRO 30:29" /></para>
  <para style="li3">
    <verse number="30" style="v" sid="PRO 30:30" />ekpe, akpọsọñ ke atu mme amọn, i-idiitịmmeke edem inọ ñkpọ ndomokeed<verse eid="PRO 30:30" /></para>
  <para style="li3">
    <verse number="31" style="v" sid="PRO 30:31" />asian akikọunen,</para>
  <para style="li3" vid="PRO 30:31">akpoebod,</para>
  <para style="li3" vid="PRO 30:31">ye adidem a-adiọọñọke ke ñkpọ ndomokeed inyeeñeke ebekpo imọ.<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />“Adieke afo anamma nte ndisịme anyʌñ akokko idem mfo,</para>
  <para style="q2" vid="PRO 30:32">me adieke afo aduakka idiọọkñkpọ,</para>
  <para style="q2" vid="PRO 30:32">mia ubọk mfo fʌk ke inua mfo!<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />Sia kpa naña uyọyʌt mmọọñeba asio bọta,</para>
  <para style="q2" vid="PRO 30:33">ye naña adifiakka iwuo anam iyiib awuọ,</para>
  <para style="q2" vid="PRO 30:33">kpa ntoro ke adisiak iyadesịd adat utọk adi.”<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="ms1">Mme Ikọ Adidem Lemuel</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Mme ikọ Adidem Lemuel, ñwuọnda ikọ e-eka amọ akekpeebe anye.<verse eid="PRO 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />Kpañ utọñ, ayịn mmi! Kpañ utọñ, ayịn ntʌñidịb mmi!</para>
  <para style="q2" vid="PRO 31:2">Kpañ utọñ, ayịn enwọñọ mmi, ibọọrọ akam mmi!<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />Kuubiat inweek<note caller="+" style="f"><char style="fr" closed="false">31:3 </char><char style="ft" closed="false">Akeme ido, </char><char style="fqa" closed="false">inie</char></note> mfo ye ibaan,</para>
  <para style="q2" vid="PRO 31:3">adudu mfo ke idem mbon e-esoboke ndidem.<verse eid="PRO 31:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />Lemuel, inaaha inọ ndidem,</para>
  <para style="q2" vid="PRO 31:4">inaaha inọ ndidem adinwọñ ukọd,</para>
  <para style="q2" vid="PRO 31:4">inaaha nte mme adaukara enie akpọsọñ udọñ adinwọñ bie,<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />mbaak ammọ edinwọñ ndin efre mme ewʌhọ se ekenịm,</para>
  <para style="q2" vid="PRO 31:5">enyʌñ ebọ afịd mbon se ekuut unen ammọ.<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />Yak bie ana anọ mbon e-eyemme aditak,</para>
  <para style="q2" vid="PRO 31:6">wain ana anọ mbon e-ebaaha ke ifịkesịd!<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />Yak ammọ enwọñ enyʌñ efre uweene ammọ</para>
  <para style="q2" vid="PRO 31:7">ke enyʌñ etoiyo ukuud ammọ aba.<verse eid="PRO 31:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />Sio uyio nọ mbon i-imiikanna isio uyio inọ idem ammọ,</para>
  <para style="q2" vid="PRO 31:8">sio uyio ke mme unen afịd mbon ñkpọnnam.<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />Sio uyio tañ nyʌñ biere ikpe ke unen;</para>
  <para style="q2" vid="PRO 31:9">nwana bọ unen mbon uweene ye mbon unana.<verse eid="PRO 31:9" /></para>
  <para style="ms1">Akpatre Ikọ: Anwaan Eti Edu</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />Anie akan akịt anwaan a-anieghe eti edu?</para>
  <para style="q2" vid="PRO 31:10">Ekọmudua amọ asọñ akan mme rubi.<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />Ebe amọ anie ayọhọ mbuọdidem ke idem amọ</para>
  <para style="q2" vid="PRO 31:11">inyʌññọ inana eti ñkpọ ndomokeed.<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />Ke afịd ayio uwem amọ,</para>
  <para style="q2" vid="PRO 31:12">anye aben se ifọn asọk ebe, idooho mfịna.<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />Anye asat idededọñ ye ndidi</para>
  <para style="q2" vid="PRO 31:13">ubọk amọ anyʌñ ama adinam utom.<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />Anye aba nte nsʌñikañ ñkpọudua,</para>
  <para style="q2" vid="PRO 31:14">a-abenne ndidia ato anyan usʌñ adi.<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />Anye abak ademme idab ke ayio imiinwañake diin;</para>
  <para style="q2" vid="PRO 31:15">anye anam ndidia anọ mbon ufọk amọ</para>
  <para style="q2" vid="PRO 31:15">anyʌñ adomo udeeme ake nditọufọk amọ ibaan.<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />Anye asuuk anyen ase ikọd anyʌñ adep anye;</para>
  <para style="q2" vid="PRO 31:16">ke atu akʌk se anye anwana anye atọ inwañ fain.<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />Anye anam utom amọ ke afịd esịd;</para>
  <para style="q2" vid="PRO 31:17">ubọk amọ asọñ akem se anam utom amọ.<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />Anye akịt abo ke unyam udua amọ a-aba udod,</para>
  <para style="q2" vid="PRO 31:18">utuenikañ amọ inyʌññọ inịme ke akonayio.<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />Anye akama eto utuak ndidi ke ubọk amọ</para>
  <para style="q2" vid="PRO 31:19">anye akama eto utuak afọñ ke nnuunubọk amọ.<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />Anye atat ubọk amọ anọ mbon uweene</para>
  <para style="q2" vid="PRO 31:20">anyʌñ anwam mbon unana.<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />Anye ikoppo ndịk ibaña ikọd ufọk amọ ke sino amaaduọ;</para>
  <para style="q2" vid="PRO 31:21">sia afịd ammọ esịneke ndad-ndad afọñ.<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />Anye anam mme afọñ ufʌk akwañ amọ;</para>
  <para style="q2" vid="PRO 31:22">esịn anye uyaiya nsọñudua afọñ linen ye iduod-iduod afọñ.<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />Ekpono ebe amọ ke inuaatob abio,</para>
  <para style="q2" vid="PRO 31:23">a-anye atieghe ke atu mme ñkpisọñ ke idʌñ.<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />Anye anam mme afọñ linen anyʌñ anyam ammọ,</para>
  <para style="q2" vid="PRO 31:24">anyʌñ anyam mme ñkịneisịn anọ mbon unyam udua.<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />Adudu ye ukpono edo afọñidem amọ;</para>
  <para style="q2" vid="PRO 31:25">anye akeme adisak mbaña mme usen e-ediighe ke iso.<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />Anye atañ ikọ ye aniọñ,</para>
  <para style="q2" vid="PRO 31:26">inua amọ anyʌñ ayọhọ ye item akpanikọ.<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />Anye asuuk anyen ase ndubeghe esịd ufọk amọ</para>
  <para style="q2" vid="PRO 31:27">inyʌññọ idia ndidia ifu.<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />Nditọ amọ edakka eda enyʌñ ekoot anye adidiọñ;</para>
  <para style="q2" vid="PRO 31:28">ebe amọ ñko, anyʌñ atooro anye:<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />“Uwak ibaan e-enam nti ñkpọ,</para>
  <para style="q2" vid="PRO 31:29">ado afo amefọn akan afịd ammọ.”<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />Ndokko ado abiaña, uyai ñko ado ke etək-etək ini;</para>
  <para style="q2" vid="PRO 31:30">ado awonwaan a-abaaha <char style="nd">Abọọñ</char> a-ado se etooro.<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />Kpono anye ke afịd se ubọk amọ anam,</para>
  <para style="q2" vid="PRO 31:31">yak mme utom amọ enyʌñ edat itooro esọk anye ke inuaatob abio.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>