  <para style="h">Matiu</para>
  <para style="toc1">Matiu</para>
  <para style="toc2">Matiu</para>
  <para style="toc3">Mat</para>
  <para style="mt1">Matiu</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s1">Ubon Emana Yisọs Krais</para>
  <para style="li4">
    <verse number="1" style="v" sid="MAT 1:1" />Mbʌk ubon emana Yisọs Krais ayịn Defid, ayịn Ebraham ado ami:<verse eid="MAT 1:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2" />Ebraham akebon Aisik,</para>
  <para style="li1" vid="MAT 1:2">Aisik abon Yekọb,</para>
  <para style="li1" vid="MAT 1:2">Yekọb abon Yuda ye nditọete amọ ideen,<verse eid="MAT 1:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 1:3" />Yuda abon Peres ye Seera, e-eka ammọ akedooho Tama,</para>
  <para style="li1" vid="MAT 1:3">Peres abon Esrọn,</para>
  <para style="li1" vid="MAT 1:3">Esrọn abon Ram,<verse eid="MAT 1:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 1:4" />Ram abon Aminadab,</para>
  <para style="li1" vid="MAT 1:4">Aminadab abon Nasọn,</para>
  <para style="li1" vid="MAT 1:4">Nasọn abon Salmọn,<verse eid="MAT 1:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="MAT 1:5" />Salmọn abon Boas, e-eka amọ akedooho Rehab,</para>
  <para style="li1" vid="MAT 1:5">Boas abon Obed, e-eka amọ akedooho Rud,</para>
  <para style="li1" vid="MAT 1:5">Obed abon Yesi,<verse eid="MAT 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="MAT 1:6" />ndin Yesi abon Adidem Defid.</para>
  <para style="b" vid="MAT 1:6" />
  <para style="li1" vid="MAT 1:6">Defid abon Sọlọmọn, e-eka amọ akedooho anwaan Yuria.<verse eid="MAT 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="MAT 1:7" />Sọlọmọn abon Rehoboam,</para>
  <para style="li1" vid="MAT 1:7">Rehoboam abon Abiya,</para>
  <para style="li1" vid="MAT 1:7">Abiya abon Asa,<verse eid="MAT 1:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="MAT 1:8" />Asa abon Yehosafad,</para>
  <para style="li1" vid="MAT 1:8">Yehosafad abon Yehoram,</para>
  <para style="li1" vid="MAT 1:8">Yehoram abon Usaiya,<verse eid="MAT 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="MAT 1:9" />Usaiya abon Yotam,</para>
  <para style="li1" vid="MAT 1:9">Yotam abon Ahas,</para>
  <para style="li1" vid="MAT 1:9">Ahas abon Esikaiya,<verse eid="MAT 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="MAT 1:10" />Esikaiya abon Manase,</para>
  <para style="li1" vid="MAT 1:10">Manase abon Amọn,</para>
  <para style="li1" vid="MAT 1:10">Amọn abon Yosaiya,<verse eid="MAT 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="MAT 1:11" />ndin Yosaiya abon Yekonaiya<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">a-adooho Yehoiyakin; se ñko ke ufañ 12</char></note> ye nditọeka amọ ideen, ke ini ekemuumọ nditọ Isrel eka Babilọn.<verse eid="MAT 1:11" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="12" style="v" sid="MAT 1:12" />Ke ini emaekemuum nditọ Isrel eka Babilọn:</para>
  <para style="li1" vid="MAT 1:12">Yekonaiya amaabon Sietiel,</para>
  <para style="li1" vid="MAT 1:12">Sietiel abon Serubabel,<verse eid="MAT 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="MAT 1:13" />Serubabel abon Abihud,</para>
  <para style="li1" vid="MAT 1:13">Abihud abon Eliakim,</para>
  <para style="li1" vid="MAT 1:13">Eliakim abon Asọ,<verse eid="MAT 1:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="MAT 1:14" />Asọ abon Sadọk,</para>
  <para style="li1" vid="MAT 1:14">Sadọk abon Akịm,</para>
  <para style="li1" vid="MAT 1:14">Akịm abon Elihud,<verse eid="MAT 1:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="MAT 1:15" />Elihud abon Eliasa,</para>
  <para style="li1" vid="MAT 1:15">Eliasa abon Matan,</para>
  <para style="li1" vid="MAT 1:15">Matan abon Yekọb,<verse eid="MAT 1:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="MAT 1:16" />ndin Yekọb abon Yosef ebe Mmeri, a-akedooho eka Yisọs e-ekoodo Krais.<verse eid="MAT 1:16" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="17" style="v" sid="MAT 1:17" />Ke ntoro, afịd ubon emana Yisọs ekedo duob mme inaañ tọọñọ ke Ebraham tutu asịm Defid, duob mme inaañ tọọñọ ke Defid tutu asịm ini ufʌn ke Babilọn, duob mme inaañ tọọñọ ke ini ufʌn ke Babilọn tutu asịm emana Krais.<verse eid="MAT 1:17" /></para>
  <para style="s1">Yosef Anyịmme Yisọs nte Ayịn Amọ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Naña emana Yisọs Krais akesaña ado ami:<note caller="+" style="f"><char style="fr" closed="false">1:18 </char><char style="ft" closed="false">naña Yisọs Krais aketọọñọ ado ami</char></note> Eka amọ Mmeri akena nte adọ Yosef, ado mbemiso ammọ edidʌñọ keed, Mmeri amaayommo ke adudu Adisana Sịbidịd. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Sia ebe amọ Yosef akedo adinen awo a-akenịmme mbed, ñko<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">akedo adinen awo</char></note> ikinyʌññọ iyem adisuenne anye anwa-anwa, anye amaanam akikere adisio anye ndọ ke ndịbe.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Ado ke anye amaakebiide ke esịd amọ ama adisio Mmeri ndọ, enyere Abọọñ amaabiọññọ anye ke ndab anyʌñ abo anye ate, “Yosef ayịn Defid, kuukop ndịk adiben Mmeri ñnyọñ ufọk nte anwaan mfo, sia ayịn a-anye ayommoke ato Adisana Sịbidịd. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Anye ayaaman ayịn awodeen, ndin afo ayaasio anye anyịñ Yisọs,<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="fq" closed="false">Yisọs </char><char style="ft" closed="false">ado Yọsua </char><char style="fqa" closed="false">ke usem Krik, </char><char style="ft" closed="false">awuọñọke </char><char style="fqa" closed="false"><char style="nd">Abọọñ</char> anyaaña.</char></note> sia anye adiinyaaña ikọd amọ isio ke ndiọiñkpọ ammọ.”<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Afịd ñkpọ ami akedat itie nọ ato do se Abọọñ Abasi aketañ ke inua mme prọfed asu: <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“Ñkpʌk abọikpa ayaayommo anyʌñ aman ayịn awodeen, ndin eyaekoot anye Imanduel”<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 7:14">Aisa 7:14</ref></char></char></note> (a-awuọñọke, “Abasi mmọdo aba ye ñnyịn”).<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Ke Yosef amaakedemme, anye amaanam se enyere Abọọñ Abasi aketemme anye, amaanyʌñ aben Mmeri anyọñ ufọk nte anwaan amọ. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Ado Yosef ikinieghe ewuana ye Mmeri tutu anye aman ayịn awodeen. Ndin Yosef amaasio anye anyịñ Yisọs.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s1">Mme Adiọọñọñkpọ Awo Ekese Krais</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Ke ini Yisọs amaakemana ke Betlehem ke Yudia ke ini ukara Adidem Herọd, mme adiọọñọñkpọ<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">mme adiọọñọñkpọ awo awuọñọ </char><char style="fqa" closed="false">mbon aniọñ</char></note> awo e-eketooho usakkautịn emaedi Yeruselem <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />edibịp ete, “Mmọ anye a-amanake nte adidem mme Yuu? Ñnyịn imaikịt ntantaafiọñ amọ ke ini akesakkake ndin imidi adikpono anye.”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Ke ini Adidem Herọd akekoppo ñkpọ ami, amaafịna anye ye afịd Yeruselem. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Ke ini anye amaakekoot afịd ikpọ aku ye mme andikpeeb mbed abon keed, anye amaabịp ammọ abaña itie a-akenaaha Krais adimana. <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Ammọ emaebọọrọ ete, “Ke Betlehem ke Yudia, sia ntom ke prọfed awet:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />“ ‘Ado afo, Betlehem, ke isọñ Yuda,</para>
  <para style="q2" vid="MAT 2:6">usịppe ke usʌñ ndomokeed ukan ke atu mme andikara Yuda;</para>
  <para style="q1" vid="MAT 2:6">sia ke afo ke andikara adiito,</para>
  <para style="q2" vid="MAT 2:6">anye adiido andikpeme ikọd mmi Isrel.’ ”<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Ndin Herọd amaakoot mme adiọọñọñkpọ awo ado ke ndịbe anyʌñ adiọọñọ ato ammọ ataa ini a-ntantaafiọñ akewuọhọ ada. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Ndin anye amaanọ ammọ eka Betlehem ate, “Ikaa ikinekke iyem ayịn ado. Imaisʌk ikikịt anye, inam nọ ami ndiọọñọ, nọ ami ñko ñnyʌñ ñka ñkekpono anye.”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Ke ammọ emaekekop se adidem aketañ, ammọ emaekaa iso ke isañ ammọ, ndin kpa ntantaafiọñ a-ammọ ekekịtte ke usakkautịn akedat ammọ usʌñ tutu aketre ke itie a-ayịn ado akebaaha. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Ke ammọ emaekekịt ntantaafiọñ ado, ammọ emaenekke enem esịd. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Ke emaekesịm ufọk a-ayịn akebaaha, ammọ emaekịt ayịn ye Mmeri eka amọ, ndin emaetuak iwuod enyʌñ ekpono anye. Ndin ammọ emaetat ekpad ñkpọuto ammọ enyʌñ enọ anye mme enọ: kold, frañkinsensi ye anemufịk adan. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Ndin sia emaekekpan ammọ ke ndab ebo ammọ ekuutịmme ekekịt Herọd aba, ammọ emaesaña usʌñ mfen enyọñọ abio ammọ.<verse eid="MAT 2:12" /></para>
  <para style="s1">Ufeghe Ñkaa Iyib</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Ke ammọ emaekenyọñọ, enyere Abọọñ amaawọt Yosef idem ke ndab ate, “Dakka da, ben ayịn ye eka amọ feghe kaa Iyib. Tie do tutu ami udọkkọ fiin idaha se uduunyọñ, sia Herọd ayaayem ayịn ado adiwot.”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Ndin anye amaadakka ada, aben ayịn ye eka ke akonayio akaa Iyib. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Do ke ammọ ekeba tutu Herọd akpa. Aketịppe ntom nọ se Abọọñ aketañ ato prọfed amọ asu: “Ke Iyib ke ami ñkekoot ayịn mmi nsio.”<verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Ke ini Herọd akediọọñọke ke mme adiọọñọñkpọ awo ado emaibiaña imọ, anye amaayat esịd ñkpa-ñkpa, anyʌñ anọ uyio ate ewoot afịd nditọ ideen ke Betlehem ye mme ñkanñkʌk a-mmiikisọññọ ikan isua iba akeene se anye akekop ato mme ntaifiọk ado abaña ini se ntantaafiọñ akewuọ ada. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Ke ntom se prọfed Yerimaiya aketañ amaasu:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“E-ekop uyio ke Rama,</para>
  <para style="q2" vid="MAT 2:18">ntuaña ye akpọsọñ mfʌhọ,</para>
  <para style="q1" vid="MAT 2:18">Ratiel atua abaña nditọ amọ</para>
  <para style="q2" vid="MAT 2:18">inyʌññọ ikop ndọñesịd,</para>
  <para style="q2" vid="MAT 2:18">sia ammọ ibaññake aba ke uwem.”<verse eid="MAT 2:18" /></para>
  <para style="s1">Utịmme Ñnyọñ Ñkaa Nasared</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Ke Herọd amaakekpa, enyere Abọọñ amaawọt Yosef idem ke ndab ke Iyib <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />anyʌñ abo anye ate, “Dakka da, ben ayịn ye eka amọ nyọñ isọñ Isrel, sia mbon e-ekeyemme edidat uwem amọ ekpañña.”<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Do ndin ke Yosef akedakka ada, aben ayịn ye eka atịmme anyọñ isọñ Isrel. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Ado ke ini anye akekoppo nte ebo ke Akelaus akeda ukara ke Yudia, ke itie ete amọ Herọd, ndịk amaanam anye adika do. Sia emaekekpan anye ke ndab ete anye akuukaa Yudia, anye amaakappa akaa ñkanñkʌk Kalili, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />anyʌñ akedʌñ do ke abio e-ekekoodo Nasared. Ke ntom, se mme prọfed eketañ amaasu: Ke ediikoot anye awo Nasared.<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">Yọọn Aduọkmmọọñ Aneeñe Usʌñ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Ke ini ado, Yọọn Aduọkmmọọñ amaadi adikwọrọ ikọ ke anaan Yudia, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />ate, “Ikappa esịd sia abioubọọñ hefịn akpere.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Anyem ado awo a-prọfed Aisaiya aketañña abaña ke ini anye akebooho ate:</para>
  <para style="q1" vid="MAT 3:3">“Uyio awo keed ke anaan abo,</para>
  <para style="q1" vid="MAT 3:3">‘Idiọñ usʌñ inọ Abọọñ,</para>
  <para style="q2" vid="MAT 3:3">inam mme nnen-nnen usʌñ inọ anye.’ ”<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Ekedat ided kamel enam afọñidem Yọọn, ndin anye amaabọbọ ñkpaha ikpa ke isịn. Ndidia amọ akedo ñkukuñkpọyọriyọ ye adanakwọọk. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Mme awo emaeto Yeruselem ye afịd Yudia, ye afịd ñkanñkʌk Yọdan ewuọ ebịne anye. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Ke ammọ emaekeyaara mme idiọọkñkpọ ammọ, anye amaaduọk ammọ mmọọñ ke Inyañ Yọdan.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Ado ke ini Yọọn Aduọkmmọọñ akekịtte uwak mme Farisi ye mme Sadusi nte ekeene edi itie a-anye akeduọkkọ mme awo mmọọñ, anye amaabịp ammọ ate, “Ndufo nditọ udʌkikọd, anie awo ikitemme ndufo ibo efeghe iyadesịd Abasi a-adiighe? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Iwọt mfịd idiọọñọ a-asañake akekem ye ukappa esịd. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Ikiikere ibo ke emekeme adibo idem ndufo, ‘Ñnyịn iminie Ebraham nte ete ñnyịn.’ Ami ibo ndufo nte ke Abasi akeme adinam mme itiad ami ekappa nditọ enọ Ebraham. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />E-ekọkọñ ekịd ke adʌñ mme eto, ndin eto akeedodo i-imiinwịmme eti mfịd, eyaekek anye enyʌñ etop esịn ke ikañ.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />“Ami ñkama mmọọñ inịm ndufo uduọkmmọọñ nnọ ukappaesịd. Ado anye a-adiidi iñkeene miin a-anie adudu añkan miin, a-adooho ami ndotto adisịññe anye ikpaukod ke ukod, adiikama Adisana Sịbidịd ye ikañ iduọk ndufo mmọọñ. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Anye a-akama abufịm amọ ke ubọk, ndin anye ayaakeñ abakpa asio ke ñkpata, akoono idem abakpa akebono ke ise, anyʌñ afọp ñkpata ke ikañ i-imiidiinịmeke.”<verse eid="MAT 3:12" /></para>
  <para style="s1">Uduọkmmọọñ Yisọs</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Akem Yisọs amaato Kalili adika Yọdan, nọ Yọọn akeduọk anye mmọọñ. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Ado Yọọn amaakpaaña nsa, ate, “Afo akpekap anduọk miin mmọọñ.”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Yisọs amaabọọrọ anye ate, <char style="wj">“Yak aba ntoro idahami; adot ñnyịn adinam ntom nọ ñnyịn inam afịd se inen adinam.”</char> Ndin Yọọn amaanyịmme.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Ekesʌk eduọduọk Yisọs mmọọñ ema, anye amaawuọ ke mmọọñ. Ndin ke ataa idahado hefịn amaabeere, ndin anye amaakịt naña Sịbidịd Abasi asọiyọ nte ibiom adidoro anye ke idem. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Ndin uyio amaato hefịn ate, “Anyem ado Ayịn mmi, a-ami mmaaha; esịd annem miin eti-eti abaña anye.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s1">Edomo Yisọs Idomo ke Anaan</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Akem Sịbidịd amaaben Yisọs akaa anaan nọ setan akedomo anye idomo. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Ke anye amaakeba ke utreudia ke usen aba ye akonayio aba, abiọọñ amaadọñ anye. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Ndin andidomo amaadibịne anye akebo, “Adieke afo adooho Ayịn Abasi, bo mme itiad ami ekappa edo uyo.”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Yisọs amaabọọrọ ate, <char style="wj">“E-ewet ete, ‘Idiidooho uyo ikpọọñ ke awo adiidat idu uwem, ado adiidat afịd ikọ a-atooho inua Abasi.’ ”</char><verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Akem setan amaaben anye akaa adisana abio anyʌñ akenam anye ada ke ataa anyọñ tembịd, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />anyʌñ abo anye, “Adieke afo adooho Ayịn Abasi, da mi tamma keduọ ke isọñ. Sia ewewet ebo:</para>
  <para style="q1" vid="MAT 4:6">“ ‘Anye ayaanọ mme enyere amọ ewʌhọ ubaña fiin,</para>
  <para style="q2" vid="MAT 4:6">ndin ammọ eyaudịppe fiin ke ubọk ammọ,</para>
  <para style="q2" vid="MAT 4:6">mbaak afo udutuak ukod mfo ke itiad.’ ”<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yisọs amaabọọrọ anye ate, <char style="wj">“Enyʌñ ewet ñko ebo: ‘Kuudomo Abọọñ Abasi mfo.’ ”</char><verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Setan amaamaana aben anye akaa ataa ñkoñ-ñkoñ abod anyʌñ akewọt anye afịd mme abioubọọñ ederimbod ye mme mmọnyọ ammọ. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Anye amaanyʌñ abo Yisọs ate, “Ami ñyaakappa afịd ami unọ fiin, adieke afo atuakka iwuod mfo ke isọñ anyʌñ añkpono miin.”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Yisọs amaabọọrọ anye ate, <char style="wj">“Dakka ñkpọñ miin Setan! Sia emaewewet ete: ‘Kpono Abọọñ Abasi mfo nyʌñ nam ñkpọ nọ anye ikpọọñ.’ ”</char><verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Setan amaakpọñ anye, ndin mme enyere emaedi edise ñkpọ ebaña anye.<verse eid="MAT 4:11" /></para>
  <para style="s1">Yisọs Atọọñọ Adikwọrọ Ikọ</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Ke ini Yisọs akekoppo ke emaesịn Yọọn ke ufọk ñkpakọb, anye amaatịmme anyọñ Kalili. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Ke anye amaakekpọñ Nasared, anye amaakaa akedʌñ ke Kapanum, abio a-akekpereke ibiok Kalili ke ubeñ Sebulọn ye Naftali. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Ke ntom se prọfed Aisaiya aketañ amaasu:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Isọñ Sebulọn ye isọñ Naftali,</para>
  <para style="q2" vid="MAT 4:15">ke Usʌñ Akpainyañ ke edem inyañ Yọdan,</para>
  <para style="q2" vid="MAT 4:15">Kalili mme Gentile,<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />mbon e-edʌññọ ke ekịm</para>
  <para style="q2" vid="MAT 4:16">e-ekịt ekamba unwana;</para>
  <para style="q1" vid="MAT 4:16">amaado mbon e-edʌññọ ke isọñ ndukpọñ ñkpa,</para>
  <para style="q2" vid="MAT 4:16">unwana ayamma anọ ammọ.”<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Tọọñọ ke ini ado Yisọs amaatọọñọ adikwọrọ ikọ ate, <char style="wj">“Ikappa esịd sia abioubọọñ hefịn akpere.”</char><verse eid="MAT 4:17" /></para>
  <para style="s1">Yisọs Akoot Mme Akpa Mbed Amọ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Naña Yisọs akesañake ke mben Akpainyañ Kalili, anye amaakịt nditọeka iba, Saimọn e-ekekoodo Pita, ye ayịneka amọ, Andru. Ammọ ekesʌk etop iyịre esịn ke ibiok, sia ammọ ekedo mme akọiyak. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yisọs amaabo ammọ, <char style="wj">“Idi, iñkeene miin, ndin ami ñyaidọñ ndufo ekekọ mbon awo.”</char> <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Ini keed ini keed ammọ emaekpọñ iyịre ammọ enyʌñ ekeene anye.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Anye akekpọñ ndo, anye amaakịt nditọeka iba mfen, Yems, ayịn Sebidi, ye ayịneka amọ, Yọọn. Ammọ ekesịne ke ubom ye ete ammọ, Sebidi, ediọñ iyịre. Yisọs amaasịn uyio akoot ammọ. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Ini keed ini keed ammọ emaekpọñ ubom ye ete ammọ ekeene anye.<verse eid="MAT 4:22" /></para>
  <para style="s1">Yisọs Akọk Mbon Udọñọ</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yisọs amaasaaña ke afịd Kalili akpeep ñkpọ ke mme sinakọk, akwọrọ eti etob abioubọọñ Abasi, anyʌñ akọk afịd udọñọ ye unana nsọñidem ke atu mbon awo do. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Etob amọ amaasuana ke afịd Siria, mme awo emaenyʌñ ekoono afịd mbon e-ekedọñọke nsio-nsio udọñọ, mbon e-ekedọñọke akpọsọñ mbiakidem, mbon se dimọn akesịn ukad, mbon se ikinie udọñọ atuatuak ye akpaubeñ esọk anye; ndin anye amaanyʌñ akọk ammọ. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Uwak atu awo e-eketooho Kalili, Dekapolis<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">a-adooho Mme Abio Duob</char></note>, Yeruselem, Yudia ye edem inyañ Yọdan emaekeene anye.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s1">Ukwọrọikọ ke Anyọñ Abod</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Ke ini Yisọs akekịtte atu awo, anye amaadọọk akaa aketie ke anyọñ abod. Mme mbed amọ emaekaa ebịne anye, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />ndin anye amaatọọñọ adikpeep ammọ ñkpọ,</para>
  <para style="m" vid="MAT 5:2">ate:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />
    <char style="wj">“Afọfọn anọ mbon e-eweeneke ke sịbidịd,</char></para>
  <para style="q2" vid="MAT 5:3">
    <char style="wj">sia abioubọọñ hefịn anie ammọ.</char><verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />
    <char style="wj">Afọfọn anọ mbon e-efʌhọke,</char></para>
  <para style="q2" vid="MAT 5:4">
    <char style="wj">sia eyaedọñ ammọ esịd.</char><verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />
    <char style="wj">Afọfọn anọ mbon e-enieghe ifuuro-ifuuro ido,</char></para>
  <para style="q2" vid="MAT 5:5">
    <char style="wj">sia ammọ eyaedat ederimbod enie.</char><verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />
    <char style="wj">Afọfọn anọ mbon e-ekoppo abiọọñ ye nsaditọñ adinenido,</char></para>
  <para style="q2" vid="MAT 5:6">
    <char style="wj">sia ammọ eyaekop uyʌkkọ.</char><verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />
    <char style="wj">Afọfọn anọ mbon e-etuaha awo mbọm,</char></para>
  <para style="q2" vid="MAT 5:7">
    <char style="wj">sia eyaetua ammọ mbọm.</char><verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />
    <char style="wj">Afọfọn anọ mbon e-esịd ammọ asanake,</char></para>
  <para style="q2" vid="MAT 5:8">
    <char style="wj">sia ammọ eyaekịt Abasi.</char><verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />
    <char style="wj">Afọfọn anọ mme anam emem,</char></para>
  <para style="q2" vid="MAT 5:9">
    <char style="wj">sia eyaekoot ammọ nditọ Abasi.</char><verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />
    <char style="wj">Afọfọn anọ mbon e-ekọbọke ke ntak adinenido,</char></para>
  <para style="q2" vid="MAT 5:10">
    <char style="wj">sia abioubọọñ hefịn anie ammọ.</char><verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />
    <char style="wj">“Afọfọn inọ ndufo ke ini mbon awo isueeñe ndufo, ikọbọ ndufo enyʌñ etañ afịd ndiọi ikọ idian ndufo ke ntak mmi.</char> <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" /><char style="wj">Inem esịd, inyʌñ idaara, sia utịb ndufo ayaakpon ke hefịn, sia kpasʌk ntom ke ekekọbọ mme prọfed e-ekibemme ndufo iso eba ke esed.</char><verse eid="MAT 5:12" /></para>
  <para style="s1">Inʌñ ye Unwana</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />
    <char style="wj">“Ndufo edo inʌñ ederimbod. Ado adieke inʌñ imiinieghe inem aba, die ke ekeme adinam nọ anye amaana anem? Anye ifọnnọ ke baaba usʌñ ndomokeed, ibọhọke aditop anye nduọọk, ñnyʌñ nsọnnọ ke ñkpad.</char><verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />
    <char style="wj">“Ndufo edo unwana ederimbod. Abio e-ebọppọ ke anyọñ abod ikemeke adidịbe.</char> <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" /><char style="wj">Awo isidomoke utuenikañ iben usan ifʌk, ado esidot anye ke ñkpọ udod utuenikañ nọ anye ayamma anọ afịd awo ke ufọk.</char> <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" /><char style="wj">Ke ukem usʌñ ami ana unwana ndufo ayamma ke iso mme awo, nọ ammọ ekịt nti utom ndufo enyʌñ etooro Ete ndufo ke hefịn.</char><verse eid="MAT 5:16" /></para>
  <para style="s1">Adinam Mbed Asu</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />
    <char style="wj">“Ikiikere ibo ke ami ñkedi adibiat Mbed me se mme Prọfed ekekpeep. Ami ñkidiighe adibabiat ammọ, ado ñkedi adinam ammọ esu.</char> <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" /><char style="wj">Ke akpanikọ ke ami idọkkọ ndufo, tutu anyọñ ye isọñ eboiyo efep, ndomo ntọi keed, ndomo ataa etək ntọi ikọ keed idiiwuọhọ ke Mbed ami tutu anye anam uduak a-akenaaha nte anye anam.</char> <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" /><char style="wj">Ke ntoro, awo akeedodo a-adiibiat ñkpọkọm ataa andisịp ñkan ke atu mme mbed ami me adinam nọ mbon mfen ekeene ebiat mme mbed ami, eyaedat awo ado nte ataa andisuuhọ ñkan ke abioubọọñ hefịn. Ado awo a-anịmme mme mbed ami anyʌñ akpeep mbon mfen abaña ammọ eyaedịppe anye itie ke abioubọọñ hefịn.</char> <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" /><char style="wj">Sia ami idọkkọ ndufo mbo ke ibọhọke adinenido ndufo akpon akan ake mme Farisi ye mme akpeeb mbed, ndufo idiikemekekeme idʌk abioubọọñ hefịn.</char><verse eid="MAT 5:20" /></para>
  <para style="s1">Uwodawo</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />
    <char style="wj">“Ndufo emekop naña eketañ enọ mbon esed ebo, ‘Ikiiwot awo, ndin awo akeedodo a-awotto awo, eyaedaaha anye ke ikpe ke esob.’</char> <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" /><char style="wj">Ado ami idọkkọ ndufo mbo ke awo akeedodo a-ayatta esịd ye ayịneka amọ</char><note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">Ke usem Krik adelfọs a-awuọñọke </char><char style="fq" closed="false">ayịneka </char><char style="fqa" closed="false">awodeen me awonwaan</char><char style="ft" closed="false">asʌk ada anọ emọ-emọ mbed, me awodeen me awonwaan a-anịmme Krais ke akpanikọ; se ñko ke Matiu 5:23. </char></note><char style="fm">,</char> <char style="wj">ayaadʌk ke ikpe. Ñko, awo akeedodo a-akoodo ayịneka amọ, ‘<char style="tl">Raka</char>,’</char><note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">Ke usem Aramaik </char><char style="fq" closed="false">Raka</char><char style="ft" closed="false">ado nsueñ</char></note><char style="wj">ayaabọọrọ mbuume ke iso esob. Ñko awo akeedodo a-abooho, ‘Afo ndisịme!’ ayaadʌk ke nsi-nsi ikañ.</char><verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />
    <char style="wj">“Ke ntoro, adieke afo adatta enọ mfo adi ke itie uwa, ndin atoiyo ke itie ado ke ayịneka mfo awodeen me awonwaan amaanie utọk ye afo,</char> <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" /><char style="wj">yaak enọ mfo ado nịm ke iso itie uwa. Kaa kenam emem ye ammọ diin, mbemiso afo atịmme adinọ enọ mfo.</char><verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />
    <char style="wj">“Nam emem ye awo usua mfo ke usọp mbemiso anye uben fiin awuọ esob. Nam emem idaha a-afo asʌkkọ asaña ye anye ke usʌñ, imiidooho awo usua mfo a-akeme ukappa fiin anọ abiideikpe, ndin abiideikpe ukappa fiin anọ adaaha, ndin ekeme utop fiin nsịn ke ufọk ñkpakọb.</char> <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" /><char style="wj">Ntañ akpanikọ inọ ndufo, afo uduuwuọhọ tutu afo a-akpe akpatre akʌk ama.</char><verse eid="MAT 5:26" /></para>
  <para style="s1">Efịbe</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />
    <char style="wj">“Ndufo emekop ke emaebo, ‘Ikiisịn efịbe.’</char> <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" /><char style="wj">Ado ami mbo ke awo a-aseeghe awonwaan ke idiọọk anyen akap asesịn efịbe ke esịd amọ.</char> <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" /><char style="wj">Anyen nnasia mfo akpedo ñkpọiduọ unọ fiin, kappa anye sio duọọk. A-afọn afo adinana ndido idem mfo keed, akan aditop afịd idem mfo nsịn ke nsi-nsi ikañ.</char> <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" /><char style="wj">Ñko ubọk nnasia mfo akpedo ñkpọiduọ unọ fiin, kpịkke anye top duọọk. A-afọn afo adinana ndido idem mfo keed ñkan afịd idem mfo aditak ke ikañ nsi-nsi.</char><verse eid="MAT 5:30" /></para>
  <para style="s1">Uwuọndọ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />
    <char style="wj">“Emaetatañ ebo ke awo akeedodo a-asịnne anwaan amọ ana anọ anye ñwed uwuọndọ.</char> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" /><char style="wj">Ado ami ibo ndufo ke awo akeedodo a-asịnne anwaan amọ, ibọhọke ke ntak efịbe, a-anam anye ado asaña esiin; ñko awo akeedodo a-adọọhọ awonwaan e-emaekesio ke ndọ a-asịn efịbe.</char><verse eid="MAT 5:32" /></para>
  <para style="s1">Mme Unwọñọ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />
    <char style="wj">“Ñko, ndufo emekop ke emaebo mme ete ñnyịn ke esed, ‘Ikiibiat enwọñọ ndufo, ado inịm enwọñọ a-ndufo enamma ye Abọọñ.’</char>  <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" /><char style="wj">Ado ami ibo ndufo, ikiinwọnwọñọ unwọñọ ndomokeed: me adooho ke hefịn, sia anye ado ebekpo Abasi,</char> <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" /><char style="wj">me ke ederimbod, sia anye ado udodukod Abasi, me ke Yeruselem, sia anye ado abio Ekamba Adidem.</char> <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" /><char style="wj">Ikiinyʌñ inwọñọ ke iwuod ndufo, sia ndufo inieghe adudu adinam ided keed akappa ado afia me abubịd.</char> <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" /><char style="wj">Ukweeñe se ndufo enie edibo ado ‘Ii’ me ‘Iyoo’; ñkpọ ndomokeed akpediana do, se ndufo etañ ato andidiọọk.</char><verse eid="MAT 5:37" /></para>
  <para style="s1">Usiene Aka ke Usiene</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />
    <char style="wj">“Ndufo emekop ke emaebo ‘Anyen aka ke anyen, eded anyʌñ aka ke eded.’</char>  <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" /><char style="wj">Ado ami ibo ndufo, ikiisio idiọọk awo usiene idiọọk. Utu ke ado, awo ndomokeed akpusiak fiin ufia ke mbañ ubọk nnasia, kanna mbañ edem uko nọ anye umia ñko.</char> <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" /><char style="wj">Ñko adieke awo ndomokeed ayemme adukoot fiin ikpe ke esob nọ ubọ afọñ anyọñidem mfo, nọ anye afọñidem mfo kọrọ.</char> <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" /><char style="wj">Awo ndomokeed akpukpak fiin nọ asaña itiad keed ye anye, kappa saña itiad iba.</char> <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" /><char style="wj">Nọ awo u-ubeeñeke fiin ñkpọ, kuunyʌñ utre adinọ awo a-ayemme ewuọd uto fiin.</char><verse eid="MAT 5:42" /></para>
  <para style="s1">Adima mme Asua</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />
    <char style="wj">“Ndufo emekop ke ekebo, ‘Ma mbọhọidʌñ mfo nyʌñ sua awo usua mfo.’ </char> <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" /><char style="wj">Ado ami ibo ndufo, ima mme asua ndufo inyʌñ ibọñ akam inọ mbon i-ikọbọke ndufo,</char> <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" /><char style="wj">nọ ndufo edo nditọ Ete ndufo a-abaaha ke hefịn; sia unwana utịn amọ ayayamma anọ nti ye ndiọi awo, anyʌñ anọ nti ye ndiọi awo edịm ukem-ukem.</char> <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" /><char style="wj">Adieke ndufo emaaha mbon i-imaaha ndufo ikpọọñ, nsoo udod ke ndufo ediibọ? Idooho kpa ntoro ke mbon ubọ taks enam?</char> <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" /><char style="wj">Ñko, ndufo ekpekọọm mbon ndufo ikpọọñ, nsoo ke ndufo enam ekan mbon mfen? Nte mbon i-imiidiọọñọke Abasi isinyʌññọ inam ukem ado?</char> <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" /><char style="wj">Ana ndufo efọn ema, kpa naña Ete ndufo ke hefịn afọn ama.</char><verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s1">Adinọ mme Uweene Ñkpọ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />
    <char style="wj">“Ikpeme idem ndufo, ikiinam nti ñkpọ ndufo ke iso mme awo ibo yak ammọ ikịt. Ekpenam ntom, ndufo idiibọọhọ Ete ndufo a-abaaha ke hefịn utịb.</char><verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />
    <char style="wj">“Ke ntoro, imainọ uweene ñkpọ, ikiisaña ifịt adukpoñ ikanna, itañ anwa-anwa naña mbon mbubịk esinam ke mme sinakọk ye ke mme efaak nọ ebọ itooro mbon awo. Akpanikọ ke idọkkọ ndufo, ammọ e-ebọbọ utịb ammọ.</char> <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" /><char style="wj">Ado ndufo imainọ uweene ñkpọ, ikiiyak ubọk ufiin ndufo adiọọñọ se ubọk nnasia anam,</char> <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" /><char style="wj">nọ enọ ndufo ado ke ndịbe. Ndin Ete ndufo a-akịtte se ndufo enam ke ndịbe ayainọ ndufo utịb.</char><verse eid="MAT 6:4" /></para>
  <para style="s1">Akam</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />
    <char style="wj">“Ñko ke ini ndufo ebọññọ akam, ikiinam nte mbon mbubịk, sia ammọ esima adida ke mme sinakọk ke mme inuuk efaak nọ mme awo ekịt ammọ. Ntañ akpanikọ inọ ndufo, ammọ ebọbọ utịb ammọ ayọhọ-ayọhọ.</char> <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" /><char style="wj">Ado ndufo imaibọñ akam, idʌk esịd ubeed ndufo, ikʌk usʌñ inyʌñ ibọñ akam inọ Ete ndufo ke ndịbe. Ndin Ete ndufo a-akịtte afịd ñkpọ se enam ke ndịbe, ayainọ ndufo utịb.</char> <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" /><char style="wj">Ñko, ke ini ndufo ebọññọ akam, ikiikprak inua nte mbon i-imiidiọọñọke Abasi, sia ammọ ekere ke akam adeghe akeene uwak ikọ.</char> <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" /><char style="wj">Ikiiba nte ammọ, sia Ete ndufo a-adọdiọọñọ se ndufo eyem mbemiso ndufo ebebịp.</char><verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />
    <char style="wj">“Naña akpena ndufo ebọñ akam ado ami:</char></para>
  <para style="q1" vid="MAT 6:9">
    <char style="wj">“ ‘Ete ñnyịn ke hefịn,</char></para>
  <para style="q1" vid="MAT 6:9">
    <char style="wj">ukpono anie anyịñ mfo,</char><verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />
    <char style="wj">yak abioubọọñ mfo adi,</char></para>
  <para style="q1" vid="MAT 6:10">
    <char style="wj">yak uduak mfo awuọ asu,</char></para>
  <para style="q2" vid="MAT 6:10">
    <char style="wj">ke ederimbod kpa naña ado ke hefịn.</char><verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />
    <char style="wj">Inọ ñnyịn ndidia ke usen ke usen.</char><verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />
    <char style="wj">Nyʌñ feen inọ ñnyịn ke mme idiọọkñkpọ ñnyịn,</char></para>
  <para style="q2" vid="MAT 6:12">
    <char style="wj">kpa naña ñnyịn ifeen inọọ mbon i-idueghe ñnyịn.</char><verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />
    <char style="wj">Kuunyʌñ uyak ñnyịn idʌk ke idomo,</char></para>
  <para style="q2" vid="MAT 6:13">
    <char style="wj">ado fak ñnyịn sio ke ubọk andidiọọk,</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">6:13 </char>
      <char style="ft" closed="false">Akeme ido </char>
      <char style="fq" closed="false">sio ke </char>
      <char style="fqa" closed="false">idiọọkñkpọ</char>
      <char style="ft" closed="false">; ubaak mme akpeedem ikpañwed edian </char>
      <char style="fqa" closed="false">keed, sia ake mfo ado abioubọọñ ye adudu ye ubọọñ ke nsinsi-nsinsi. Amen.</char>
    </note>
    <char style="wj">’</char><verse eid="MAT 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />
    <char style="wj">Sia ndufo imaifeen inọ mbon mfen ke ini a-ammọ idueghe ndufo, Ete ndufo ke hefịn ayaanyʌñ afeen inọ ndufo.</char> <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" /><char style="wj">Ado ndufo imiifeene inọ mbon mfen ke idiọọkñkpọ ammọ, Ete ndufo idiifeene idiọọkñkpọ ndufo ñko.</char><verse eid="MAT 6:15" /></para>
  <para style="s1">Utreudia</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />
    <char style="wj">“Ndufo imaitie utreudia, ikiikama iso mfʌhọ-mfʌhọ nte mbon mbubịk, sia ammọ esifiọmmọ iso nọ mme awo ediọọñọ ke mmimọ itre udia. Ntañ akpanikọ inọ ndufo, ammọ ebọbọ utịb ammọ ayọhọ-ayọhọ.</char> <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" /><char style="wj">Ke ntoro, ndufo imaitie utreudia, iyie iso, inyʌñ ifiọññọ adan,</char> <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" /><char style="wj">mbaak awo ndomokeed adidiọọñọ ke ndufo etre udia, ibọhọke Ete ndufo a-awo imiikịtte. Ndin Ete ndufo a-akịtte afịd se enam ke ndịbe, ayainọ ndufo utịb.</char><verse eid="MAT 6:18" /></para>
  <para style="s1">Mme Inie ke Hefịn</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />
    <char style="wj">“Ikiibọọk inie ibon inọọ idem ndufo mi ke ederimbod, ke itie se utañkpọ ye unamibak ekeme edita, ye ke itie se mme inọ ekeme adibom ndʌk ñnyʌñ ñyịp.</char> <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" /><char style="wj">Ado ibono inie inọ idem ndufo ke hefịn, ke itie se ñkakad ye utañkpọ imiikanna adita, ye itie se inọ imiikanna adibom ndʌk ñnyʌñ ñyịp.</char> <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" /><char style="wj">Sia itie nte ñkpọuto mfo ana, kpa do ke esịd mfo adiisịne.</char><verse eid="MAT 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />
    <char style="wj">“Anyen ado utuenikañ anọ abʌkidem. Adieke anyen ndufo akoppo nsọñidem,</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">6:22 </char>
      <char style="ft" closed="false">Ke usem Krik </char>
      <char style="fq" closed="false">nsọñidem</char>
      <char style="ft" closed="false">ke itie ami awuọñọ adifọn mfọn.</char>
    </note> <char style="wj">afịd idem ndufo adiiyọhọ ye unwana.</char> <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" /><char style="wj">Ado anyen ndufo imiikoppo nsọñidem,</char><note caller="+" style="f"><char style="fr" closed="false">6:23 </char><char style="ft" closed="false">Ke usem Krik </char><char style="fq" closed="false">imiikoppo nsọñidem</char><char style="ft" closed="false">ke itie ami awuọñọ adifaam efaam.</char></note> <char style="wj">afịd idem ndufo adiiyọhọ ye ekịm. Ndin unwana esịd idem ndufo amaado ekịm, ekịm ado adiikpon die?</char><verse eid="MAT 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />
    <char style="wj">“Awo ndomokeed ikemeke adido ayịnufọk nnọọ eteufọk iba: anye ayaama keed asua keed; mmiidooho ntoro anye ayaanekke adiana keed ke idem akan keed. Ndufo ikemeke adima Abasi ye akʌk ukem-ukem.</char><verse eid="MAT 6:24" /></para>
  <para style="s1">Ikiifịna Idem</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />
    <char style="wj">“Ke ntak ado ke ami ibo ndufo ikiifịna idem ibaña uwem ndufo, se ediidia me se ediinwọñ; me se ibaña ikpọkidem ndufo, se ediisịne. Nte uwem ikponno ikan ndidia, ikpọkidem inyʌññọ ikpon ikan afọñ?</char> <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" /><char style="wj">Ndufo ise mme inuen anyọñ; ammọ itọọhọtọ, idọkkọdọk, inyʌññọ ibono ke mme ise, ado Ete ndufo ke hefịn anọ ammọ ndidia. Nte ekọmudua ndufo ikponno ikan ammọ?</char> <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" /><char style="wj">Nte awo ndufo ndomokeed akeme adidian awa keed ke uwem amọ akeene naña anye afịna idem amọ</char><note caller="+" style="f"><char style="fr" closed="false">6:27 </char><char style="ft" closed="false">Akeme ido </char><char style="fq" closed="false">akeme adidian </char><char style="fqa" closed="false">kubid keed ke unyọọñ mfo</char></note><char style="wj">?</char><verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />
    <char style="wj">“Ñko ntak a-ndufo efịnake idem ebaña nsiine-e? Ikere ibaña mme ñkpokpoñ ke inwañ; ammọ inamma utom inyʌññọ idọk ñkpọ.</char> <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" /><char style="wj">Ado ami idọkkọ ndufo ke Sọlọmọn ke idem amọ ye afịd nsiine ubọọñ amọ ikiyaiyake nte keed ke atu mme ñkpokpoñ ami.</char> <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" /><char style="wj">Adieke Abasi anọọhọ ñkpokpoñ ke ikọd nsiine, a-adooho ammọ eba mfịn, ñkpọñ ekpooño ammọ efọọmọ ke ikañ, nsoo ikpinam ke anye anekke ase ñkpọ ibaña ndufo; ndufo mbon etək mbuọdidem?</char> <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" /><char style="wj">Ñko ikiifịna idem, ke edibo, ‘Nsoo ke ñnyịn idiidia?’ me ‘Nsoo ke ñnyịn idiiñwọñ?’ me ‘Nsoo ke ñnyịn idiisịne?’</char> <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" /><char style="wj">Sia mbon i-imiidiọọñọke Abasi esịn esịd ammọ ke afịd mme ñkpọ ami. Ete ndufo ke hefịn adọdiọọñọ ke ndufo emeyem mme ñkpọ ami.</char> <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" /><char style="wj">Ado ndufo ikap ibem iso iyem abioubọọñ ye adinenido Abasi, ndin eyaedian afịd mme ñkpọ ami inọ ndufo ñko.</char> <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" /><char style="wj">Ke ntoro, ikiifịna idem ibaña ñkpọñ a-adiisiere, sia ñkpọñ ayaase ñkpọ abaña idem amọ. Usen keedekeed e-enieñe mfịna se ikem ye ammọ.</char><verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s1">Adibiom Mbon Mfen Ikpe</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />
    <char style="wj">“Ikiibiom awo ikpe, mmiidooho ntoro eyaibiom ndufo ikpe.</char> <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" /><char style="wj">Sia ukem naña ndufo ebiom mbon mfen ikpe, kpa ntoro ke ediibiom ndufo ikpe, ñko se adodo a-ndufo edomoke enọọ awo mfen, kpa ukem ado ke ediidomo inọ ndufo.</char><verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />
    <char style="wj">“Ntak a-afo akịtte etək ndueeto ke anyen ayịneka mfo, ado ukịtte eka isua adukpọk u-usịneke fiin ke anyen-e?</char> <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" /><char style="wj">Afo akeme die adibo ayịneka mfo, ‘Yak nsio etək ibio ndukpad ke anyen mfo,’ ke ini adooho afịd ini ataa ekamba adukpọk mmọdo usịne fiin ke anyen?</char> <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" /><char style="wj">Afo awo mbubịk, kap to sio ekandịk adukpọk ke anyen mfo, ndin afo ayaakan anekke amọọnọ etək ibio ndukpad a-asịneke ke anyen ayịneka mfo.</char><verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />
    <char style="wj">“Kuunọọ mme ewa se ido adisana ñkpọ: kunyʌñ utop mme ñkpọuto mfo unọọ mme edi. Adieke afo anamma ntoro, mme edi ado ekeme edisọnnọ ammọ ke ñkpad eboiyo, ndin ekanna eda uwai fiin mbai-mbai.</char><verse eid="MAT 7:6" /></para>
  <para style="s1">Bịp, Yem, Kọñ</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />
    <char style="wj">“Beeñe ke eyaunọ; yem ke ayaakịt; kọñ ke eyaebeere usʌñ unọ.</char> <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" /><char style="wj">Sia awo keed akeedodo a-abeeñeke ayaabọ; awo a-ayemme ayaakịt; ñko awo a-akọññọ, eyaebeere usʌñ enọ anye.</char><verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />
    <char style="wj">“Anie awo ke atu ndufo ado ayịn amọ akpebeeñe anye uyo, anye anọ itiad?</char> <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" /><char style="wj">Me akpaanọ anye udʌkikọd ke ini anye abeeñeke iyak?</char> <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" /><char style="wj">Adieke ndufo e-edoññoke ndiọi ediọọñọke adinọ nditọ ndufo nti enọ, die ndin ke Ete ndufo ke hefịn imiidiinọọhọ mbon e-ebeeñeke anye nti enọ?</char> <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" /><char style="wj">Ke afịd ñkpọ, nam nọ mbon mfen naña afo akpema ammọ enam unọ fiin, sia anye ami ado ataa akpa Mbed Moses ye se mme Prọfed ekekpeep.</char><verse eid="MAT 7:12" /></para>
  <para style="s1">Ñnwaña-ñnwaña ye Mfafaha Inuaatob</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />
    <char style="wj">“Isaña iboiyo ke mfafaha inuaatob. Sia inuaatob a-akaaha nsobo ana inwañ anyʌñ anwaña, ñko uwak awo eboiyo edʌk do.</char> <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" /><char style="wj">Ado usʌñ uwem afafaha, ndin ibad-ibad awo ikpọọñ ekịt anye.</char><verse eid="MAT 7:14" /></para>
  <para style="s1">Nti ye Ndiọi Prọfed</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />
    <char style="wj">“Itịñ anyen ise mme prọfed abiaña. Ammọ esiine ided edọñ edi ibịne ndufo ado ke esịd ammọ edoñño mme afai ewaikọd.</char> <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" /><char style="wj">Eyaediọọñọ ammọ eto mfịd ammọ. Nte e-ekeme edikịppe ntọm nto mbaraekpe me fik nto akpab?</char> <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" /><char style="wj">Ke ntoro afịd nti eto enwịm nti mfịd, ado idiọọk eto anwịm idiọọk mfịd.</char> <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" /><char style="wj">Eti eto ikemeke inwịm idiọọk mfịd, ñko idiọọk eto ikemeke inwịm eti mfịd.</char> <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" /><char style="wj">Eto keed akeedodo i-imiinwịmme eti mfịd, e-ekpịkke anye esio enyʌñ etop esịn ke ikañ.</char> <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" /><char style="wj">Ke ntom, ndufo ediidiọọñọ ammọ ikeene mfịd ammọ.</char><verse eid="MAT 7:20" /></para>
  <para style="s1">Nti ye Ndiọi Mbed</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />
    <char style="wj">“Idooho afịd awo eñkoodo miin, ‘Abọọñ, Abọọñ’ ediidʌk abioubọọñ hefịn, ado sʌk mme andinam uduak Ete mmi a-abaaha ke hefịn.</char> <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" /><char style="wj">Uwak awo eyaembo miin ke usen ado, ‘Abọọñ, Abọọñ, nte ñnyịn ikitañña prọfesi ke anyịñ mfo, ibịn mme dimọn isịññe mme awo ke idem ke anyịñ mfo, inyʌñ inam mme utịppeñkpọ ke anyịñ mfo?’</char> <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" /><char style="wj">Ndin ami ñyaadọkkọ ammọ anwa-anwa nte: ‘Kpaanaanam ami ñkidiọọñọke ndufo. Indakka miin ke iso, ndufo mme anam idiọọkñkpọ.’</char><verse eid="MAT 7:23" /></para>
  <para style="s1">Mbon Aniọñ ye mme Ndisịme Abọbufọk</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />
    <char style="wj">“Ke ntoro, afịd awo e-ekoppo ikọ mmi enyʌñ eben ammọ esịn ke adinam, ebit awo aniọñ a-akebọppọ ufọk amọ ke anyọñ itiad.</char> <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" /><char style="wj">Edịm amaadep, mmọọñ amaatọ adọọk, afịm amaanyʌñ afịme amia ufọk ado, kpayeado anye ikiduọhọ, sia idakisọñ amọ akedo itiad.</char> <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" /><char style="wj">Ado ukeed awo e-ekoppo ikọ mmi, ado ibenne isịn ke adinam, etie nte ndisịme awo a-akebọppọ ufọk ke anyọñ ntan.</char> <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" /><char style="wj">Edịm amaadep, mmọọñ amaatọ adọọk, afịm amaanyʌñ afịme amia ufọk ado, ndin anye amaaduọ asuana.”</char><verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Ke ini Yisọs amaaketañ mme ikọ ami ama, idem amaakpa mme atu awo ato ke ukpeebñkpọ amọ, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />sia anye akekpeep ammọ nte awo a-anieghe adudu, idooho nte mme andikpeeb mbed ammọ.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s1">Yisọs Akọk Awo Akpamfia</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Ke ini Yisọs amaakesọiyọ ito abod idi, akwa atu awo emaekeene anye. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Awo akpamfia<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="ft" closed="false">Ke usem Krik </char><char style="fq" closed="false">akpamfia</char><char style="ft" closed="false">akewuọñọ mme nsio-nsio udọñọ ñkpọnta ke ikpọkidem.</char></note> amaadi aditọọñọ edọñ ke iso amọ ate: “Abọọñ, adieke afo amaaha, nnam miin nsana.”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Yisọs amaanyan ubọk amọ atuuk anye, abo anye ate, <char style="wj">“Ami mmenyịmme, sana!”</char> Kpa idahado, akpamfia amọ amaakweeñe. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Ndin Yisọs amaabo anye ate, <char style="wj">“Kịt bo ke udọkkọke awo ndomokeed. Ado kaa, kewọt aku idem mfo nyʌñ nọ enọ a-asañake akekem naña Moses aketemme nọ ado ñkpọ ntiense anọ ammọ.”</char><verse eid="MAT 8:4" /></para>
  <para style="s1">Mbuọdidem Awo Sentudiọn</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Ke ini Yisọs amaakedʌk Kapanum, awo ekọñ sentudiọn amaadi adikpeiye anye ayem unwam. <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />Anye amaabo Yisọs ate, “Abọọñ, ayịnufọk mmi ana ke ufọk adọñọ akpaubeñ anyʌñ aba ke ataa akpọsọñ ubiak.”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Yisọs amaabo anye, <char style="wj">“A-ado se ami ndi ndikọk anye?”</char><verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Ndin sentudiọn amaabọọrọ ate, “Abọọñ, ami ndotto se afo akpedʌk ke idak akọm ufọk mmi; ado kap sʌk tañ ikọ, ke ayịnufọk mmi ayaakop nsọñidem. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Sia ami ke idem mmi ndo awo a-anieghe ekamba adudu, ye mbon ekọñ ke idak mmi. Ndin mmekeme ibo awo anyem, ‘Kaa,’ anye anyʌñ akaa; ñnyʌñ mbo awo mfen, ‘Di mi,’ anye anyʌñ adi. Mmekeme ibo ayịnufọk mmi, ‘Nam ami,’ ndin anye anyʌñ anam.”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Ke Yisọs amaakekop ami, idem amaakpa anye, ndin anye amaabo mbon e-ekekeeneke anye ate, <char style="wj">“Ntañ akpanikọ inọ ndufo, kpaanam ami ñkịtte awo a-anieghe utọ ekamba mbuọdidem ami ke afịd isọñ Isrel.</char> <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" /><char style="wj">Ami idọkkọ ndufo, ataa uwak awo eyaeto ke usakkautịn ye usobutịn edidat itie ammọ ke usọrọ ye Ebraham, Aisik ye Yekọb ke abioubọọñ hefịn.</char> <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" /><char style="wj">Ado eyaebịn nditọ abioubọọñ etop esịn ke ekịm, ke itie a-ntuaña ye ntaeded ediiba.”</char><verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Ndin Yisọs amaabo sentudiọn ate, <char style="wj">“Nyọñ! Yak asu unọ fiin nte mbuọdidem mfo adooho.”</char> Ndin kpa idahado idem amaasọñ ayịnufọk amọ.<verse eid="MAT 8:13" /></para>
  <para style="s1">Yisọs Akọk Uwak Awo Udọñọ</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Idaha a-Yisọs akekaaha ufọk Pita, anye amaakịt eka anwaan Pita naña ana ke ikʌk ye ufiobidem. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Yisọs amaatuuk ubọk amọ, ufiobidem ado amaakweeñe anye, ndin anye amaadakka ada akenam ndidia anọ Yisọs.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Ke ndubiayio usen ado, emaekoono uwak mbon ñkpọnsọb a-ndiọi sịbidịd akefịnake esọk anye. Anye amaadat ikọ inua abịn mme ndiọi sịbidịd anyʌñ akọk afịd mbon udọñọ. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Ami akedo adinam nọ se prọfed Aisaiya aketañ asu:</para>
  <para style="q1" vid="MAT 8:17">“Anye amaabiom mme mmemidem ñnyịn,</para>
  <para style="q2" vid="MAT 8:17">anyʌñ ayọ mme udọñọ ñnyịn.”<verse eid="MAT 8:17" /></para>
  <para style="s1">Ekọmudua Adikeene Yisọs</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Ke Yisọs amaakekịt mme atu awo naña ewak, anye amaanọ mme mbed amọ uyio ate ekappa eka edem ibiok uko. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Ndin akpeeb mbed keed amaadibịne anye akebo ate, “Andikpeeb, ami ñyaukeene fiin ñkaa nte afo akaaka.”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Yisọs amaabọọrọ anye ate, <char style="wj">“Mme ewaikọd enieñe adu, mme inuen anyọñ enyʌñ enieñe efọk, ado Ayịn Awo inieghe itie nte anye adaak iwuod.”</char><verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Mbed Yisọs mfen amaabo anye ate, “Abọọñ, yak ami ñka diin ñkebuuk ete mmi.”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Ado Yisọs amaabo anye, <char style="wj">“Ñkeene miin, nyʌñ yak mme akpañkpa ebuuk mme akpañkpa ammọ.”</char><verse eid="MAT 8:22" /></para>
  <para style="s1">Yisọs Anam Ayobio Adobo</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Akem Yisọs amaadʌk ubom, mme mbed amọ emaenyʌñ ekeene anye. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Inikeed inikeed, ataa akpọsọñ ayobio amaatọọñọ ke ibiok ado, tutu mbufuud akpa afʌk ubom. Ado Yisọs akesʌk adaiya. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Mme mbed emaeketọi anye ke idab ete, “Abọọñ, inyaaña ñnyịn mbaak ñnyịn idisịp.”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Yisọs amaabọọrọ, <char style="wj">“Ndufo mbon etək mbuọdidem, nsinam idem inyeñ ndufo ntom?”</char> Ndin anye amaadakka ada anyʌñ asua anọ ayobio ye mbufuud akpa, ndin afịd ñkpọ amaadobo.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Idem amaanekke akpa ammọ ndin ammọ emaebịp ete, “Nsoo utọ awo ado ami? Kpa afịm ye mbufuud inyañ ekop ikọ enọ anye.”<verse eid="MAT 8:27" /></para>
  <para style="s1">Yisọs Akọk Ideen Ñkpọnsọb Iba</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Ke Yisọs amaakekanna akewuọ edem inyañ ukañ idʌñ Kadarin<note caller="+" style="f"><char style="fr" closed="false">8:28 </char><char style="ft" closed="false">Usʌk ikpañwed ewet </char><char style="fqa" closed="false">Kekesin</char><char style="ft" closed="false">; ubaak ewet </char><char style="fqa" closed="false">Kerasin</char></note>, ideen iba a-adimọn akesọppọ emaeto ukañ a-mme udi ebaaha ewuọñọ edisoobo ye anye. Afai-afai ido ammọ ikisiyakka nọ awo ndomokeed asaña ke usʌñ ado aboiyo. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Ammọ emaesio ñkpo ete, “Ayịn Abasi, nsoo ke afo ayem ito ñnyịn? Afo adi adinọọ ñnyịn ufen mbemiso ini ekemekke enịm adikem?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Itie ami ikinyọọñọ usʌñ ikpọñ itie u-uwak udịm edi ekebaaha edia ñkpọ. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Ndin mme dimọn ami emaekpeiye Yisọs ete, “Mbọk adieke afo ibịnne ñnyịn asịññe, idọñ ñnyịn ke idem mme udịm edi ako.”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Yisọs amaabo ammọ ate, <char style="wj">“Ikaa!”</char> Ammọ emaenyʌñ ewuọñọ ekedọñọ ke idem mme edi ado. Ndin afịd udịm edi ado emaefeeñe ediatta ekeduọ edọñọ ibiok enyʌñ ekpañña ke mmọọñ ado. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Mme akpeme edi ado emaefeeñe ekebʌk afịd ñkpọ ami ye se ikitịppe inọ ideen a-mme dimọn akesọppọ enọ mbon abio. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Ndin afịd mbon abio ado emaewuọñọ ekaa edikisoobo Yisọs; ndin ammọ ekekekịt anye, emaekpeiye Yisọs ete yak anye akpọñ ñkanñkʌk mmimọ.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">Yisọs Afeen Anyʌñ Akọk Awo Akpaubeñ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Yisọs amaasọiyọ adʌk ubom akanna akewuọ idʌñ ammọ. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Mme awo emaeben awo udọñọ akpaubeñ, a-akenaaha ke aya esọk anye. Ke Yisọs amaakekịt mbuọdidem ammọ, anye amaabo awo akpaubeñ ado ate, <char style="wj">“Ayịn mmi, sọñ esịd, sia efeen mme idiọọkñkpọ mfo.”</char><verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Ubaak mme akpeeb mbed ekekop ami, ammọ emaebo ke esịd ammọ ete, “Awo ami asuuk Abasi uyio.”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Yisọs a-amaakediọọñọ akikere ammọ, amaabo, <char style="wj">“Ntak a-ndufo enieñeke ndiọi akikere ke esịd ndufo-o?</char> <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" /><char style="wj">Akee imem ikan: adibo, ‘Efeen mme idiọọkñkpọ mfo, me adibo, Dakka da saña’?</char> <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" /><char style="wj">Ado ami ñyem inam ndufo ediọọñọ ke Ayịn Awo anie adudu ke isọñ adifeen mme idiọọkñkpọ.”</char> Ndin anye amaabo awo akpaubeñ ado ate, <char style="wj">“Dakka da, ben aya mfo nyʌñ nyọñ ufọk.”</char> <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Ndin awo ado amaadakka ada anyọñ ufọk. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Ke ini atu awo ekekịtte ñkpọ ami, ammọ emaekop akpọsọñ ñkpaidem, enyʌñ etooro Abasi, a-akenọọhọ awo utọ adudu ado.<verse eid="MAT 9:8" /></para>
  <para style="s1">Ikood Matiu</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Ke Yisọs amaakekpọñ itie ado, anye amaakịt awodeen a-akekereke Matiu naña atie ke atayad ubọ taks. Yisọs amaabo anye, <char style="wj">“Ñkeene miin,”</char> Matiu amaadakka ada anyʌñ akeene anye.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Ke ini Yisọs akesʌkkọ adia ndidia ndubi ke ufọk Matiu, uwak mme abọọ taks ye mme ndiọi awo emaedi edidia ndidia ye anye ye mme mbed amọ. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Ke ini mme Farisi ekekịtte ami, ammọ emaebịp mme mbed Yisọs ebo, “Ntak eteufọk ndufo asidiaha ndidia ye mme abọọ taks ye mme anam idiọọkñkpọ-ọ?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Yisọs akekop ami, anye amaabo, <char style="wj">“Ado mbon udọñọ esiyem abiaibọk, idooho mbon nsọñidem esiyem.</char> <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" /><char style="wj">Ado ikaa ikikpeep se ami awuọñọ: ‘Ami ñyem mbọm, idooho uwa.’ Sia ami ñkidiighe adikoot ndinen awo, ado ñkedi adikoot mme anam idiọọkñkpọ.”</char><verse eid="MAT 9:13" /></para>
  <para style="s1">Ebịp Yisọs Ebaña Utreudia</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Ndin mme mbed Yọọn emaedibịp anye ete, “Nsoo ido ntak a-ñnyịn ye mme Farisi isitreke ndidia, ado mme mbed mfo itreke?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Yisọs amaabọọrọ ammọ ate, <char style="wj">Isenawo ebendọ ekpenam die efʌhọ ke ini ebendọ abaaha ye ammọ? Ado ini ayaadi e-ediiben ebendọ idakka ikpọñ ammọ, ini ado ndin ke ammọ ediitre udia.</char><verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />
    <char style="wj">Awo ndomokeed isibenne ufa afọñ ikịm idian isiit adudu akaan afọñ, sia ufa afọñ ado amaadiañña, ayaanam itie se ikiwakka ado adiọọk akan akpa.</char> <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" /><char style="wj">Ñko awo isibenne ufa ukọd inwañña idọñ ke akaan ikịmukọd, adieke enamma ntom, adudu ufa ukọd ayaaduat ikịmukọd abom, ukọd anyʌñ aduọkkọ. Ufa ukọd kpọd ke ana edọñ ke ufa ikịmukọd ndin ikịmukọd ye ukọd eyaekpeene.</char><verse eid="MAT 9:17" /></para>
  <para style="s1">Yisọs Anam Ayịn Abọikpa Aset anyʌñ Akọk Awonwaan Udọñọ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Ke ini anye akesʌkkọ atañ ikọ anọ ammọ, keed ke atu mme adaaha ke sinakọk amaadi, aditọọñọ edọñ ke iso amọ anyʌñ abo, “Ayịn mmi awonwaan asʌk akpa idahami, ado di didot anye ubọk, ndin anye ayaadu uwem.” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Yisọs amaadakka ada ye mme mbed amọ akeene anye.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Kpa ke ukem ini ado, awonwaan keed a-akedọñọke uwuọiyiib ke isua duob mme iba amaato edem-edem asaña akpere Yisọs anyʌñ atuuk mben afọñidem amọ. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Anye amaabo idem amọ, “Ami ñkpesʌk ñkan ntuuk afọñidem amọ, ñyaakop nsọñidem.”<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Yisọs amaakanna iso akịt anye, anyʌñ abo anye, <char style="wj">“Sọñ idem, ayịn awonwaan, mbuọdidem mfo u-ukọk fiin.”</char> Idahado-idahado idem amaasọñ awonwaan ado.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Ke ini Yisọs amaakedʌk ufọk adaukara ke sinakọk ami, anyʌñ akịt atu awo e-ekenamma uyom ye mbon e-ekefịtte adʌk, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />anye amaabo, <char style="wj">“Iwuọñọ mi, etək abọikpa ami ikpaahakpa, anye adadaiya.”</char> Ado ammọ emaesaha anye. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Ado ke mbon awo emaekewuọñọ anwa, anye amaadʌk esịd ufọk anyʌñ amʌm etək abọikpa ado ke ubọk abenne, ndin anye amaadakka ada. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Mbʌk ami amaatara ayọhọ afịd ñkanñkʌk ado.<verse eid="MAT 9:26" /></para>
  <para style="s1">Yisọs Akọk mme Nnan ye Imuum</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Ke Yisọs amaakekpọñ efaak ado, ideen iba e-ekedooho nnan emaebọñ ekeene anye ete, “Yisọs Ayịn Defid, itua ñnyịn mbọm.”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Ndin ke Yisọs amaakekewuọ ufọk ado, mme nnan iba ami emaekeene anye, ndin anye amaabịp ammọ ate, <char style="wj">“Ndufo emenịm ke ami mmekeme adinam ñkpọ ami?”</char></para>
  <para style="p" vid="MAT 9:28">Ammọ emaebọọrọ, “Abọọñ, iminịm.”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Ndin anye amaatuuk ammọ anyen anyʌñ abo <char style="wj">“Yak asu inọ ndufo nte mbuọdidem ndufo adooho”;</char> <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />ndin ammọ emaetịmme ekịt ñkpọ. Ado Yisọs amaanekke adət ammọ utọñ ate, <char style="wj">“Ikiiyak awo ndomokeed adiọọñọ abaña adinam ami.”</char> <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Ado ammọ emaedaaña ekesuan etob ami ebaña anye ke afịd ñkanñkʌk efaak ado.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Ke idaha ammọ ekesʌkkọ ewọwuọ do, emaeben awodeen keed a-dimọn akesọppọ, akenyʌññọ ado imuum esọk Yisọs. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Ndin ke anye amaakebịne dimọn ado isio, imuum ado amaatañ ikọ. Idem amaakpa atu awo, ammọ emaenyʌñ ebo, “Kpaanam awo ikịtte utọ ñkpọ ami ke Isrel.”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Ado mme Farisi emaebo, “Anye akama adudu akpan abọọñ mme dimọn abịn mme ndiọi adudu asio.”<verse eid="MAT 9:34" /></para>
  <para style="s1">Mme Anam Utom Iwakka</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yisọs amaasaaña akaa afịd mme abio ye mme idʌñ, akpeep ñkpọ ke mme sinakọk ammọ, asuan eti etob abioubọọñ anyʌñ akọk afịd udọñọ ye unana nsọñidem. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Ke ini Yisọs akekịtte atu awo, mbọm ammọ amaanam anye, sia ammọ emaekịt mfịna inyʌññọ inie unwam, eba nte mme edọñ i-imiinieghe andikpeme. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Ndin anye amaabo mme mbed amọ ate, <char style="wj">“Idọk anekke akpon, ado mme anam utom iwakka.</char> <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" /><char style="wj">Ibeeñe Abọọñ idọk ate anọ mbon utom edi inwañ idọk amọ.”</char><verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s1">Yisọs Adọñ Mbed Duob mme Iba Utom</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Yisọs amaakoot mbed duob mme iba amọ, anyʌñ anọ ammọ adudu adibịn mme ndiọi sịbidịd nsịññe mme awo ke idem ñnyʌñ ñkọk nsio-nsio udọñọ ye ubiak.<verse eid="MAT 10:1" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="2" style="v" sid="MAT 10:2" />Anyịñ mme mbed duob mme iba ado edoñño ami:</para>
  <para style="b" vid="MAT 10:2" />
  <para style="li1" vid="MAT 10:2">Akpa ke atu ammọ ado Saimọn (e-ediọọñọke nte Pita), ye ayịneka amọ Andru;</para>
  <para style="li1" vid="MAT 10:2">Yems ayịn Sebidi, ye ayịneka amọ Yọọn;<verse eid="MAT 10:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 10:3" />Filib ye Batolomiu;</para>
  <para style="li1" vid="MAT 10:3">Tọmọs ye Matiu abọọ taks;</para>
  <para style="li1" vid="MAT 10:3">Yems ayịn Alfiọs, ye Tadiọs;<verse eid="MAT 10:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 10:4" />Saimọn a-adooho Amaidʌñ ye Yudas Iskariọd, a-aketappa anye anọ ñkpa.<verse eid="MAT 10:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Yisọs amaasio awo duob mme iba ami adọñ utom, anyʌñ anọ ammọ item ate: <char style="wj">“Ikiikaa atu mme Gentile, ikiinyʌñ idʌk abio mbon Sameria ndomokeed.</char> <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" /><char style="wj">Ado ikaa ibịne mme edọñ ufọk Isrel e-emaekesop.</char> <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" /><char style="wj">Ndin imaika, ikwọrọ ibo ke abioubọọñ hefịn a-akpere.</char> <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" /><char style="wj">Ikọk mbon udọñọ, inam mme akpañkpa eset, inam mbon akpamfia</char><note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false">Ke usem Krik </char><char style="fq" closed="false">akpamfia</char><char style="ft" closed="false">akewuọñọ mme nsio-nsio udọñọ ñkpọnta ke ikpọkidem.</char></note> <char style="wj">esaana, ibịn mme dimọn isịññe. Ndufo ebọ ke mfọn, inyʌñ inọ ñko ke mfọn.</char><verse eid="MAT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9" />
    <char style="wj">“Ndufo ikiikama kold me silfa, me kọpa ke ñkpahaisịn akʌk ndufo,</char> <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" /><char style="wj">ikiikama ekpad isañ, me ukpʌhọ afọñ me ikpaukod me esañ, sia anamutom adot ñkpọ ayịnutom.</char> <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" /><char style="wj">Ke abio me idʌñ akeedodo a-ndufo edʌkkọ, iyem eti awo inyʌñ iba ke ufọk amọ ye anye tutu ndufo ekpọñ do.</char> <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" /><char style="wj">Imaidʌk esịd ufọk ado, ikọọm mme anie ufọk.</char> <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" /><char style="wj">Adieke ufọk ado adotto, yak emem ndufo asʌhọ do; adieke ufọk ado miidotto, yak emem ndufo atịmme ikeene ndufo.</char> <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" /><char style="wj">Adieke awo imiidaarake ndufo, imiinyʌññọ ikpañ utọñ ikop se enie editañ, iwuọñọ ke ufọk me utọ idʌñ ado, inyʌñ ikeñ ntan ñkpad ndufo ibono do.</char> <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" /><char style="wj">Ke akpanikọ, ami ibo ndufo, ke usen ubiideikpe amaakem, ayaakap ifọn inọ Sọdọm ye Komora akan utọ abio ado.</char><verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />
    <char style="wj">“Ami isio ndufo ndọñ nte edọñ ke ufọọd mme ewaikọd. Ke ntoro, ana ekara ñkara nte udʌkikọd enyʌñ esuuhọ idem nte ibiom.</char> <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" /><char style="wj">Ikap inekke ikpeme idem ndufo, sia eyaimuum ndufo eyaak enọ mme esob ikpaisọñ enyʌñ imia ndufo ke mme sinakọk.</char> <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" /><char style="wj">Eyaiben ndufo ekaa iso mme adaukara ye mme ndidem ke ntak mmi, nọ ndufo edo ntiense enọ ammọ ye mme Gentile.</char> <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" /><char style="wj">Ado emaimuum ndufo ika, ikiifịna ibaña se ediitañ me naña ediitañ ikọ, sia eyainọ ndufo se ediitañ ini amaakem,</char> <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" /><char style="wj">sia ikappa ido ndufo ediitañ ikọ, ado Sịbidịd Ete ndufo adiitañ ikọ ito ndufo.</char><verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />
    <char style="wj">“Ayịneka ayaatap ayịneka anọ ñkpa, ete ayaanyʌñ atap ayịn amọ anọ ñkpa; nditọ eyaesọñ iwuod ye mme eka ye ete ammọ, enyʌñ enam ewot ammọ.</char> <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" /><char style="wj">Afịd awo eyaisua ndufo ke ntak mmi, ado awo a-adiisọñ ida ikisịm utịd ayaanie adinyaaña.</char> <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" /><char style="wj">Emaikọbọ ndufo ke idʌñ keed, ifeeñe ikaa idʌñ mfen; ndin emaifịna ndufo ke idʌñ anye ado, ifeeñe ikaa itie mfen. Ke akpanikọ ami ibo ndufo, idiisañake ikanna afịd abio Isrel ima mbemiso Ayịn Awo adi.</char><verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />
    <char style="wj">“Ayịn ufọkñwed isikponno ikan andikpeeb, ayịnufọk isinyʌññọ ikpon ikan eteufọk.</char> <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" /><char style="wj">A-afọn nditọ ufọkñwed ediba nte mme andikpeeb ammọ, nditọufọk ñko enyʌñ eba nte mme eteufọk ammọ. Adieke ekoodo eteufọk Belsibọb, die ndin ke awo imiidiikoodo mbon ufọk amọ anyịñ se idiọọk ikan ado!</char><verse eid="MAT 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />
    <char style="wj">“Ke ntoro ikiifeghe ammọ, sia afịd ñkpọ se efọfʌk idahami eyaeyaara, se ededịp ñko ayaanaa ke eferife.</char> <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" /><char style="wj">Se ami idọkkọ ndufo ke ndịbe, itañ anwa-anwa; se ekop ke odu, ikibọọñ ke anyọñ akọm.</char> <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" /><char style="wj">Ikiifeghe mbon e-ekanna ewot ikpọkidem ado ikanna iwot ukpọñ; ikap ifeghe Anye a-akanna awot ikpọkidem ye ukpọñ ke nsi-nsi ikañ.</char> <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" /><char style="wj">Nte awo inyamma nsiak iba ke kọbọ keed? Ado ammọ ndomokeed ikanna iduọ ke isọñ ke ini Ete ndufo miidiọọñọke ibaña.</char><note caller="+" style="f"><char style="fr" closed="false">10:29 </char><char style="ft" closed="false">Akeme ido </char><char style="fqa" closed="false">uduak</char><char style="ft" closed="false">me</char><char style="fqa" closed="false">ifiọk</char></note> <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" /><char style="wj">E-ediọọñọ kpak ibad afịd ided iwuod ndufo.</char> <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" /><char style="wj">Ke ntoro, ufọn ndufo adikop ndịk ibaaha; ndufo emesọñ ekọmudua ekan uwak mme nsiak.</char><verse eid="MAT 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />
    <char style="wj">“Ke ntoro, awo akeedodo añnyịmmeke miin anwa-anwa ke iso mbon awo, ami ñyaanyʌñ ñnyịmme anye anwa-anwa ke iso Ete mmi ke hefịn.</char> <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" /><char style="wj">Ado awo akeedodo añkañña miin ke iso mbon awo, ami ñyaanyʌñ ñkañ anye ke iso Ete mmi ke hefịn.</char><verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />
    <char style="wj">“Ikiikere ke ami ñkedi adiben emem ndi ke ederimbod; ami ñkeben akañkañ ndi, idooho emem.</char> <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" /><char style="wj">Sia ami ndi adinam nọ</char></para>
  <para style="q1" vid="MAT 10:35">
    <char style="wj">“ ‘ayịn atọhọ ye ete,</char></para>
  <para style="q2" vid="MAT 10:35">
    <char style="wj">ayịn awonwaan anyʌñ atọhọ ye eka,</char></para>
  <para style="q1" vid="MAT 10:35">
    <char style="wj">anwaan ayịn atọhọ ye eka ebe.</char><verse eid="MAT 10:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36" />
    <char style="wj">Mme asua awo ediito esịdufọk amọ.’</char><verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />
    <char style="wj">“Awo akeedodo a-amaaha ete me eka amọ añkan miin, idotto adikoot idem amọ indian miin; awo a-amaaha ayịn me ayịn awonwaan amọ añkan miin idotto adikoot idem amọ indian miin.</char> <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" /><char style="wj">Awo akeedodo i-imiibenne krọs amọ iñkeene miin, idotto adikoot idem amọ indian miin.</char> <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" /><char style="wj">Awo akeedodo a-ayemme uwem amọ ayaaduọọk anye, ndin awo akeedodo a-aduọhọ uwem amọ ke ntak mmi, ayaanyaaña anye.</char><verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />
    <char style="wj">“Awo akeedodo i-idaarake ndufo, andaara miin, ndin awo akeedodo a-anyʌññọ andaara miin adaara andikindọñ miin.</char> <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" /><char style="wj">Awo akeedodo a-adaarake prọfed ke ntak a-anye adooho prọfed ayaabọ utịb prọfed; awo akeedodo a-anyʌññọ adaara adisana awo ke ntak a-anye adooho adisana ayaanyʌñ abọ utịb adisana awo.</char> <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" /><char style="wj">Ñko awo ndomokeed akpenọ keed ke atu mbon ami kọọb ndedeñ mmọọñ nọ anwọñ ke ntak a-anye adooho mbed mmi, ntañ akpanikọ inọ ndufo, awo ado idiikemekekeme iduọọk utịb amọ.”</char><verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s1">Yisọs ye Yọọn Aduọkmmọọñ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Ke Yisọs amaakekpeep mme mbed amọ duob mme iba ima, anye amaadakka do akaa adikpeep ñkpọ ñnyʌñ ñkwọrọ ikọ ke mme abio Kalili.<note caller="+" style="f"><char style="fr" closed="false">11:1 </char><char style="ft" closed="false">Ke Krik </char><char style="fq" closed="false">ke </char><char style="fqa" closed="false">mme abio ammọ</char></note><verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Ke ini Yọọn, a-akesịneke ke ufọk ñkpakọb, aketieghe akop mme utom se Krais akenañña, anye amaasio mme mbed amọ adọñ ate ekebịp <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />anye ebo, “Afo ado anye a-akenaaha nte adi, me a-ado se ñnyịn itie ibet awo mfen?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Yisọs amaabọọrọ ate, <char style="wj">“Itịmme ikaa ikidọkkọ Yọọn se ndufo ekop enyʌñ ekịt:</char> <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" /><char style="wj">Mme nnan ekịt usʌñ, mme mbʌñọ esaña isañ, mme akpamfia</char><note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="ft" closed="false">Ke usem Krik </char><char style="fq" closed="false">akpamfia</char><char style="ft" closed="false">akewuọñọ mme nsio-nsio udọñọ ñkpọnta ke ikpọkidem.</char></note> <char style="wj">esaana, mme inan ekop ñkpọ, enam mme akpañkpa eset, ndin enyʌñ ekwọrọ eti mbʌk Abasi enọ mme uweene.</char> <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" /><char style="wj">Afọfọn anọ awo akeedodo a-amiididuọhọ ke ntak mmi.”</char><verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Ke ini mme mbed Yọọn emaekedaaña enyọñọ, Yisọs amaatọọñọ aditañ ikọ nnọọ atu awo mbaña Yọọn, ate: <char style="wj">“Nsoo ke ndufo ekewuọ ekaa adikise ke anaan? Ñnyanyaha a-afịm anyeeñeke?</char> <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" /><char style="wj">Imiidooho ntoro, nsoo ke ndufo ekewuọ ekaa adikise? Awodeen a-asịneke uyaiya afọñidem? Iyoo, mbon e-esịneke uyaiya afọñidem ebañña ke mme akwere ndidem.</char> <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" /><char style="wj">Nsoo ndin ke ndufo ekewuọñọ ekaa adise? Prọfed? Ii, ami idọkkọ ndufo, anye akpon akan prọfed.”</char> <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" /><char style="wj">Anye ami ado anye e-ekewette ebaña, ete “ ‘Sese, ami ñyaadọñ isʌñutom mmi ubem fiin iso</char></para>
  <para style="q2" vid="MAT 11:10">
    <char style="wj">nọ adiikidiọñ usʌñ anịm unọ fiin.’</char><verse eid="MAT 11:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />
    <char style="wj">Ke akpanikọ ami idọkkọ ndufo nte ke atu afịd se ibaan eman, akenam ibaaha ndomokeed a-akponno akan Yọọn Aduọkmmọọñ; kpayeado andisịp ñkan ke abioubọọñ hefịn a-akpon akan anye.</char> <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" /><char style="wj">Tọọñọ ke ini Yọọn Aduọkmmọọñ, tutu awuọ idahami, abioubọọñ hefịn a-akịt afai, ndin mbon afai eyem idat afai nnie anye.</char> <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" /><char style="wj">Sia afịd mme Prọfed ye Mbed emaetañ prọfesi tutu Yọọn adidi.</char> <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" /><char style="wj">Ndin ndufo ekpenyịmme adinịm se ntañ, anye ado Elaiya a-akenaaha atịmme adi.</char> <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" /><char style="wj">Awo akeedodo a-anieghe utọñ, yak anye akop!</char><verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />
    <char style="wj">“Nsoo ke ami ñkpedat ndomo ye emana ami? Ammọ eba nte ntəkayịn e-etieghe ke mme anwa udua ebọñ ekoot emọ-emọ ete:</char><verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />
    <char style="wj">“ ‘Ñnyịn imaifịt adʌk inọ ndufo,</char></para>
  <para style="q2" vid="MAT 11:17">
    <char style="wj">ado ndufo ikinekke;</char></para>
  <para style="q1" vid="MAT 11:17">
    <char style="wj">imaikwọ ikwọ ikpo,</char></para>
  <para style="q2" vid="MAT 11:17">
    <char style="wj">ado ndufo ikifʌhọke.’</char><verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />
    <char style="wj">Sia Yọọn amaadi, idiaha ñkpọ, inyʌññọ inwọñ ukọd, ndin ammọ ete, ‘Anye anie dimọn.’</char> <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" /><char style="wj">Ayịn Awo amaadi, adia ñkpọ anyʌñ anwọñ ukọd, ndin ammọ ete, ‘Anyem ado adiauyʌkkọ ye akpammịn, ufan mme abọọ taks ye mme anam idiọọkñkpọ.’ Ado edat utom aniọñ ediọọñọ ke aniọñ anen.”</char><verse eid="MAT 11:19" /></para>
  <para style="s1">Adọdiọọk Anọ mme Abio I-imiikappake Esịd</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Ndin Yisọs amaatọọñọ adisua nnọọ mme abio se anye akenañña mme uwak utịppeñkpọ, sia ammọ ikikamma adikappa esịd. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" /><char style="wj">“Adọdiọọk inọ ndufo Korasin! Adọdiọọk inọ ndufo Bedsaida! Sia akpedo ekenam afịd mme utịppeñkpọ ami ke Tai ye Sidọn, mbon ado ekpaekesịne afọñ ikpo ekappa esịd enyʌñ enekke etua ñkpọfiọk tọọñọ ako.</char> <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" /><char style="wj">Ado ami ibo ndufo ke ayaafọn ye Tai ye Sidọn ke usen ubiideikpe ikan ndufo.</char> <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" /><char style="wj">Ñko amaado afo Kapanum, afo ayem nọ ubenne fiin ekewuọ mme hefịn? Iyoo, afo uduusọiyọ uka Hedis.</char><note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">A-adooho abioekpo</char></note> <char style="wj">Sia akpedo ekenam afịd mme utịppeñkpọ ami ke Sọdọm, mmọdo akpesọọñọ ada tutu usen mfịn.</char> <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" /><char style="wj">Ado ami ibo ndufo ke ayaafọn ye abio Sọdọm ke usen ubiideikpe ikan ndufo.”</char><verse eid="MAT 11:24" /></para>
  <para style="s1">Eyaara Ete eto Ayịn</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Ndin akedikem ini ado, Yisọs amaabo, <char style="wj">“Ami mmutooro fiin, Ete, Abọọñ a-abaaha ke hefịn ye ke isọñ, sia afo amedịp mbon aniọñ ye mme adiọọñọñkpọ mme ñkpọ ami, anyʌñ ayaara ammọ anọ ntəkayịn.</char> <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" /><char style="wj">Ii, Ete sia se ikunem fiin esịd adinam adodo.</char><verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />
    <char style="wj">“Ete mmi amaayaak afịd ñkpọ ansịn miin ke ubọk. Awo ndomokeed idiọọñọke Ayịn ke mmiibọhọke Ete, kpa naña awo ndomokeed mmiidiọọñọke Ete ke mmiibọhọke Ayịn, ye mbon se Ayịn amek adiyaara anye nnọọ.</char><verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />
    <char style="wj">“Idi imbịne miin, afịd ndufo e-ekpaaha mba enyʌñ ebiom ndoppo mbiomo, ndin ami ñyainọ ndufo nduọkadudu.</char> <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" /><char style="wj">Iben akpọnọ mmi ikọñọ inyʌñ ikpeep ñkpọ into miin sia ami ndo sʌñ-sʌñ ñnyʌñ nnie nsuukidem ke esịd, ndin ndufo eyaenie nduọkadudu enọ ukpọñ ndufo.</char> <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" /><char style="wj">Sia akpọnọ mmi ado mmem-mmem, mbiomo mmi anyʌñ ayakka.”</char><verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s1">Yisọs ado Abọọñ Sabad</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Ke ini ado, Yisọs amaasaña aboiyo ke mme inwañ mfịd ke usen Sabad. Abiọọñ amaadọñ mme mbed amọ, ke ntak ado, ammọ emaetọọñọ adikịppe usʌk mfịd ado nta. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Ke ini mme Farisi ekekịtte ami ammọ emaebo anye ete, “Se! Mme mbed mfo esʌk enam se mbed akpan ke usen Sabad.”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Yisọs amaabọọrọ ate: <char style="wj">“Nte ndufo ikoodo se Defid akenam ke ini abiọọñ akedọññọ anye ye mme nsaña amọ?</char> <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" /><char style="wj">Anye amaadʌk ufọk Abasi ndin anye ye mme nsaña amọ emaeben adisana uyo eta, ñkpọ se mbed akekpan ñkaña awo adinam, ibọhọke mme aku Abasi ikpọọñ?</char> <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" /><char style="wj">Me ado nte ndufo ikoodo ke Mbed naña ebo ke mme aku se ikinie ubiọñutom ke tembịd esappa usen Sabad, ado inieghe ubiomikpe?</char> <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" /><char style="wj">Ami ntañ inọ ndufo mbo ke ñkpọ a-akponno akan tembịd mmọ mi.</char> <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" /><char style="wj">Akpedo ndufo emediọọñọ se mme ikọ ami ewuọñọ, ‘Ami ñyem mbọm, idooho uwa,’ ndufo ikpikibiommo mbon i-imiidueghe ikpe.</char> <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" /><char style="wj">Sia Ayịn Awo ado Abọọñ Sabad.”</char><verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Yisọs akekpọñ itie ado, anye amaakaa akedʌk sinakọk ammọ, <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />anyʌñ akịt awo keed do a-akedọñọke akpaubeñ. Sia ammọ ekeyemme usʌñ adidot Yisọs ikọ, ammọ emaebịp anye ete, “Nte mbed anyịmme ekọk awo udọñọ ke usen Sabad?”<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Anye amaabọọrọ ammọ ate, <char style="wj">“Adieke awo ndufo ndomokeed anieghe edọñ, ndin edọñ ado aduọ adʌk ube ke usen Sabad, nte anye ikpisịnne ubọk idʌt edọñ ado isio ke ube ado?</char> <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" /><char style="wj">Nte awo ikponno ekọmudua ikan edọñ? Ke ntoro, mbed ikpanna adinam eti ñkpọ ke usen Sabad.”</char><verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Ndin anye amaabo awo ado, <char style="wj">“Nyan ubọk mfo.”</char> Awo ado amaanyʌñ anyan ubọk amọ, ndin ubọk amọ amaamaana akappa adeghe ataa afịd-afịd ukem-ukem nte ubọk anye ako. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Ado mme Farisi ekekpọñ itie ado, ammọ emaekedioomo naña ediida iwot Yisọs.<verse eid="MAT 12:14" /></para>
  <para style="s1">Isʌñutom a-Abasi Amekke</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Yisọs amaakediọọñọ se ammọ ekedioomo, anye amaakpọñ itie ado. Uwak awo emaekeene anye, ndin anye amaanyʌñ akọk afịd mbon se ikidọñọ. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Anye amaadʌt ammọ utọñ ate ekuutañ ñkpọ ndomokeed ibaña imọ inọọ mbon mfen. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Aketịppe ntom nọ se Abasi aketañ ato prọfed Aisaiya asu:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Anye ami ado ayịnufọk mmi a-ami mmekke,</para>
  <para style="q2" vid="MAT 12:18">anye a-ami mmaaha, a-ami ñnyʌññọ nnem esịd mbaña;</para>
  <para style="q1" vid="MAT 12:18">Ami ñyaasịn anye Sịbidịd mmi ke idem,</para>
  <para style="q2" vid="MAT 12:18">ndin anye ayaanam unen anwa-anwa anọ afịd mme idịd.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Anye idiitọhọke, idiinyʌññọ ibọñ ñkpo;</para>
  <para style="q2" vid="MAT 12:19">awo ndomokeed idiikoppo uyio amọ ke mme efaak.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Anye idiibuuñọ ñnyanyaha a-anyʌkkọke,</para>
  <para style="q2" vid="MAT 12:20">idiinyʌññọ inịme afọñ utuenikañ a-adueñedueñ,</para>
  <para style="q1" vid="MAT 12:20">tutu anye anọ unen a-atooho adikan.<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />Ke anyịñ amọ ke mme idịd ediikọọñ idodanyen ammọ.”<verse eid="MAT 12:21" /></para>
  <para style="s1">Yisọs ye Belsibọb</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Akem ammọ emaeben awodeen a-dimọn akesịnne ukad a-akenyʌññọ ado nnan ye imuum esọk anye; ndin Yisọs amaakọk anye udọñọ, ndin anye amaakan atañ ikọ anyʌñ akịt usʌñ. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Ami amaakpa afịd awo idem eti-eti; ammọ emaenyʌñ ebo, “Me anye ami akpedo Ayịn Defid?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Ado mme Farisi ekekop ami, ammọ emaebo, “Ado ke adudu Belsibọb, akpan abọọñ mme dimọn ikpọọñ, ke awo ami akeme adibịn mme dimọn nsio awo ke idem.”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Yisọs amaakediọọñọ akikere ammọ amaabo ammọ ate, <char style="wj">“Abioubọọñ akeedodo a-abakkake ada, ayaawuuro, ñko abio me ufọk akeedodo a-anwanake ye idem amọ, idiisọọñọke ida.</char> <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" /><char style="wj">Setan akpebịn Setan asio, anye anwana ye idem amọ. Die ke abioubọọñ amọ adiikan isọọñọ ida?</char> <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" /><char style="wj">Ndin, akpedo ndat Belsibọb mbịn mme dimọn nsịññe, ke adudu anie ke mbon ndufo edat ebịn ammọ esịññe? Ke ntak ami, ammọ eyaedo mme abiideikpe inọ ndufo. </char> <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" /><char style="wj">Ado akpedo ami ndat Sịbidịd Abasi mbịn mme dimọn nsịññe, abioubọọñ Abasi adisịm ndufo.</char><verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />
    <char style="wj">“Ñko awo ndomokeed adiikan die idʌk ufọk akpọsọñ awo ikoono ñkpọ amọ ibọhọke anye abem iso abọp akpọsọñ awo ado anịm? Idahado ndin ke anye adiikan ibịme ñkpọ ke ufọk amọ ikoono.</char><verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />
    <char style="wj">“Awo akeedodo i-imiidaaha ye ami, anwanwana ye ami, ñko awo akeedodo i-imiinyʌññọ iñkeene miin itañ ibək, asuasuan.</char> <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" /><char style="wj">Ndin ami ntañ inọ ndufo, eyaefeen afịd idiọọkñkpọ ye nsuukuyio enọ mme awo, ado idiifeene ikọ emiom e-etañña edian Adisana Sịbidịd.</char> <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" /><char style="wj">Eyaefeen enọ awo akeedodo a-atañña idiọọk ikọ adian Ayịn Awo, ado adifeen ibaaha inọ awo akeedodo a-atañña ikọ emiom adian Adisana Sịbidịd, ke emana ami, me ke emana ini iso.</char><verse eid="MAT 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />
    <char style="wj">“Inam eto afọn ndin mfịd amọ ayaafọn, ado ekpenam eto adiọọk, mfịd amọ ayaanyʌñ adiọọk, sia ediọọñọ eto ekeene mfịd amọ.</char> <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" /><char style="wj">Ndufo nditọ udʌkikọd, die ke ndufo e-edooho ibak ekeme editañ ñkpọ ndomokeed se ifọn, sia se iwuọ awo ke inua ato se ifịghe anye ke esịd.</char> <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" /><char style="wj">Eti awo asisịññe nti ñkpọ e-edọñọke anye ke idem, idiọọk awo anyʌñ asịññe ndiọiñkpọ e-edọñọke anye ke idem.</char> <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" /><char style="wj">Ado ami idọkkọ ndufo mbo ke usen ikpe, afịd awo eyaetañ ikọ idem ammọ ebaña abʌd-abʌd ikọ a-ammọ eketañña.</char> <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" /><char style="wj">Sia ediidat ikọ ndufo itoppo ndufo ikpe, kpa naña ikọ ndufo adiibiom ndufo ikpe.”</char><verse eid="MAT 12:37" /></para>
  <para style="s1">Idiọọñọ Yọna</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Ndin usʌk mme Farisi ye mme andikpeeb mbed emaebo anye, “Andikpeeb, ñnyịn iyem adikịt idiọọñọ uto fiin.”<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Anye amaabọọrọ. <char style="wj">“Emana mbon ibak ye emana mbon efịbe eyem idiọọñọ! Ado awo idiinọọhọ ammọ idiọọñọ ndomokeed ibọhọke idiọọñọ prọfed Yọna.</char> <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" /><char style="wj">Sia kpa naña Yọna akesịne ke idịb ekamba iyak ke usen ita ye akonayio ita, kpa ntoro ke Ayịn Awo adiisịne ke esịd isọñ usen ita ye akonayio ita.</char> <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" /><char style="wj">Ke usen ikpe, mbon Ninife eyaedaaña eda ke ikpe ye emana ami enyʌñ esua enọ anye; sia ammọ emaekappa esịd ke ntak ukwọrọikọ Yọna, ndin idahami se ikpon ikan Yọna mmọ mi.</char> <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" /><char style="wj">Abọọñanwaan Usuuk ayaadakka ada anyʌñ abiom emana ami ikpe, anyʌñ asua anọ anye, sia anye amaato ataa utịd ederimbod adi adikpañ utọñ ñkop aniọñ Sọlọmọn, ndin se ikpon ikan Sọlọmọn mmọ aba ami.</char><verse eid="MAT 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />
    <char style="wj">“Idiọọk sịbidịd amaawuọ awo ke idem anye asisasaña ayooñ ayem itie nte abọ nduọkadudu, ado ikịtte.</char> <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" /><char style="wj">Ke ini anye imiikịtte itie, anye ate, ‘Ami ñyaatịmme ñnyọñ ufọk añkekpọññọ.’ Anye amaato idi, anyʌñ adikịt naña ufọk ado ana ukpọk, awo idʌññọ, emaekwọọk asana enyʌñ eneeñe ñkpọ ebono,</char> <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" /><char style="wj">akem anye akaa akekoono sịbidịd itiaba ebakka ibak ekan anye, ndin ammọ ekaa ekedʌñọ do. Ndin utịd awo ado akappa adiọọk akan akpa. Naña adiiba adodo ye emana ibak ami.”</char><verse eid="MAT 12:45" /></para>
  <para style="s1">Eka ye Nditọeka Yisọs</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Ke ini Yisọs akesʌkkọ atañ ikọ ye atu awo, eka ye nditọeka amọ ideen emaeda ke anwa ebet eyem editañ ikọ ye anye. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Awo amaadidọkkọ anye ate: “Eka mfo ye nditọeka mfo ideen mmọdo eda ke anwa eyem editañ ikọ ye afo.”<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Ke ibọọrọ anye amaabo, <char style="wj">“Anie awo ido eka mmi, mme anie awo inyʌñ idoñño nditọeka mmi ideen?”</char> <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Ndin anye amaanyan ubọk awọt mme mbed amọ ate, <char style="wj">“Eka mmi ye nditọeka mmi ideen edoñño ami.</char> <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" /><char style="wj">Sia awo keed akeedodo a-anamma uduak Ete mmi ke hefịn ado ayịneka mmi awodeen ye ayịneka mmi awonwaan ye eka mmi.”</char><verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s1">Ñke Atọinwañ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Kpa ke usen ado Yisọs amaawuọ ke ufọk akaa aketie ke mben ibiok. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Mme atu awo emaedibono ekanna anye ekʌk. Atu awo emaewak tutu adido se anye adakka aketie ke esịd ubom ke ini afịd awo ekedudakka ke mben mmọọñ. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Ndin anye amaatañ uwak ñkpọ anọ ammọ ke ñke ate, <char style="wj">“Atọinwañ akekaa aditọ ñkpasi.</char> <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" /><char style="wj">Naña anye akesʌkkọ asuan ñkpasi, usʌk emaeduọññọ ke akpọusʌñ, ndin mme inuen emaedikoono ammọ eta.</char> <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" /><char style="wj">Usʌk emaeduọññọ ke isọñ itiad, isọñ a-mmiifọnnọ ñkpọ. Ammọ emaetịppe usọp-usọp, sia isọñ ikitʌñọke;</char> <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" /><char style="wj">ado ke ini utịn amaakesakka amia ammọ, ammọ emaeyeeme sia ammọ ikinieghe adʌñ.</char> <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" /><char style="wj">Mme ñkpasi mfen ekeduọññọ ke ikọd ñkukịm ndin ikọd amaakọt afʌk ammọ.</char> <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" /><char style="wj">Kpayeado mme ñkpasi mfen emaeduọññọ ke eti isọñ enyʌñ enwuum mfịd; usʌk enwịm mfịd ikie, usʌk enwịm mfịd ata, usʌk enwịm mfịd edịb mme duob ekan se eketọ. </char> <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" /><char style="wj">Awo akeedodo a-anieghe utọñ, yak anye akop.”</char><verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Mme mbed amọ emaedi ebịne anye enyʌñ edibịp anye ebo, “Ntak a-afo akamake ñke atañ ikọ anọọ mme awo-o?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Anye amaabọọrọ ammọ, <char style="wj">“Sia inọ ndufo ikpọọñ unen adinie ifiọk mbaña mme ndedịbe ñkpọ abioubọọñ hefịn, ado awo inọhọ mbon mfen. </char> <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" /><char style="wj">Awo akeedodo a-anieghe ñkpọ eyaenọ anye awak akan, ndin anye ayaanie akan naña anye ayem. Ado awo i-imiinieghe, kpa etək a-anye anieghe, eyaebọ anye.</char> <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" /><char style="wj">Ntak ami anam nọ ntañ ikọ nnọ mme awo ke ñke nọ ato do:</char></para>
  <para style="q1" vid="MAT 13:13">
    <char style="wj">“Akpesʌkado a-ammọ ekịtte, ado imọọnọke,</char></para>
  <para style="q2" vid="MAT 13:13">
    <char style="wj">akpesʌkado a-ammọ ekpañña utọñ, ado ikoppo, inyʌññọ inwaña ammọ.</char><verse eid="MAT 13:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14" />
    <char style="wj">Ke ntom ke brọfesi Aisaiya adiisu ammọ ke idem:</char></para>
  <para style="q1" vid="MAT 13:14">
    <char style="wj">“ ‘Ndufo ediisʌk ikokop, ado idiinwañake;</char></para>
  <para style="q2" vid="MAT 13:14">
    <char style="wj">ndufo ediisʌk ikekịt ado idiimọọnọke.</char><verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />
    <char style="wj">Sia esịd ibon ami a-adoro ufiọn;</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">a-asọñ ammọ adikop ñkpọ ke utọñ ammọ,</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">ñkọ enyʌñ ebọọp anyen ammọ.</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="wj">Imiidooho ntoro ammọ ekpaemọọnọ ñkpọ,</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">utọñ ammọ ekpaenyʌñ ekop ñkpọ,</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">ñkpọ anyʌñ anwaña ke esịd ammọ,</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="wj">ammọ ekpaenyʌñ ekappa esịd, ndin ami ñkpaakọk ammọ.’</char><verse eid="MAT 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />
    <char style="wj">Ado afọfọn anọ anyen ndufo sia ammọ ekịt, ye utọñ ndufo, sia ammọ ekop.</char> <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" /><char style="wj">Sia ke akpanikọ ke ami ntañ inọọ ndufo, uwak mme prọfed ye ndinen awo emaeyem adikịt mme ñkpọ se ndufo ekịt, ado ikikịtte, emaenyʌñ eyem adikop mme ñkpọ se ndufo ekop, ado ikikoppo.</char><verse eid="MAT 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />
    <char style="wj">“Ikpañ utọñ ndin ikop se ñke atọinwañ awuọñọ.</char> <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" /><char style="wj">Awo amaakop ikọ abioubọọñ, ado ikọ ado inwañake anye, andidiọọk adi adiwịppe se eketọ ke esịd ammọ. Anye ami ado ñkpasi a-akeduọhọ ke akpọusʌñ.</char> <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" /><char style="wj">Ñkpasi a-akeduọhọ ke isọñ itiad ada anọ awo a-abọọhọ ikọ Abasi ke inemesịd idaha anye akoppo do.</char> <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" /><char style="wj">Ado sia ikọ ami imiinieghe adʌñ anye aba ke ataa ibio-ibio ini. Ukuud ye ndutʌhọ emaedi ke ntak ikọ Abasi ado, ammọ esọsọp ekpañña ewuọñọ.</char> <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" /><char style="wj">Ñkpasi a-akeduọhọ ke ikọd ñkukịm ada anọ awo a-akoppo ikọ Abasi, ado mfịna uwem ami ye abiaña inie ederimbod edikọt efʌk ikọ ado, iyakka nọ anye anwịm mfịd.</char> <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" /><char style="wj">Ado ñkpasi a-aduọhọ ke eti isọñ ada anọ awo a-akoppo ikọ Abasi; ikọ ami anyʌñ anwaña anye. Anye ami ado anye a-anwịmme mfịd, usʌk akañ ikie, usʌk akañ ata, usʌk akañ edịb mme duob ekan se eketọ.”</char><verse eid="MAT 13:23" /></para>
  <para style="s1">Ñke A-abañake Mbid</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yisọs amaamaana atañ ñke mfen anọ ammọ ate: <char style="wj">“Abioubọọñ hefịn atie nte awo a-atọọhọ eti ñkpasi ke inwañ amọ.</char> <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" /><char style="wj">Ado akonayio keed, ke ini afịd awo ekesʌkkọ edaiya idab, asua amọ amaaditọ mbid adọñ ke ufọọd abakpa anyʌñ adakka anyọñ.</char> <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" /><char style="wj">Ke ini abakpa amaaketịppe anyʌñ awuọñọ mfañ, mbid ñko amaanyʌñ atịppe.</char><verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />
    <char style="wj">“Nditọufọk anie inwañ emaedi ebịne anye edibo, ‘Ete, nte afo ukuutọọhọ nti ñkpasi ke inwañ mfo? Mbid aketo uke ndin aditịppe?’</char><verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />
    <char style="wj">“Anye amaabọọrọ ate, ‘Asua akenam ami.’</char></para>
  <para style="p" vid="MAT 13:28">
    <char style="wj">“Nditọufọk emaebịp anye, ‘Nte afo ameyem nọ ñnyịn ikiwịp ammọ isịññe?’</char><verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />
    <char style="wj">“Anye amaabọọrọ ate, ‘Iyoo, sia idaha a-ndufo ewịppeke mme mbid ami, emekeme ediwịppe abakpa ñko ye mbid.</char> <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" /><char style="wj">Yak naña ammọ iba ekọt itie keed tutu akem ini idọk. Ke ini ado ami ñyaadọkkọ mme adọkidọk nte: Ibem iso iwịppe mbid inyʌñ ibọp ke abek ke abek inịm nọ edifọp, ndin ikpịkke abakpa ikibon ke ise mmi.’ ”</char><verse eid="MAT 13:30" /></para>
  <para style="s1">Mme Ñke Ñkpasi Mọstad ye Yiis</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Yisọs amaamaana atop ñke mfen anọ ammọ: <char style="wj">“Abioubọọñ hefịn atie nte ñkpasi mọstad a-awo akebenne atọ ke inwañ amọ.</char> <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" /><char style="wj">Akpesʌkado a-anye asịppe akan ke atu afịd mme ñkpasi, ado amaakpon anye akappa ado eto inwañ andikpon ñkan, adido se mme inuen anyọñ edisọrọ ke mme ñkọk amọ.”</char><verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Anye amaamaana atop ñke mfen anọ ammọ ate: <char style="wj">“Abioubọọñ hefịn atie nte yiis a-awonwaan abenne awuak ye udomo ndomuyo ata</char><note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="ft" closed="false">Ñkpọ nte kilokram 27</char></note> <char style="wj">tutu anye akappa atịt akem afịd efiak uyo.”</char><verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yisọs aketañ afịd ñkpọ ami anọ atu awo ke ñke; anye ikitañña ñkpọ ndomokeed inọ ammọ ke imiidooho ke ñke. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Ntoro ke se prọfed aketañ akewuọ asu:</para>
  <para style="q1" vid="MAT 13:35">“Ami ndiitañ ikọ ke ñke,</para>
  <para style="q2" vid="MAT 13:35">ñnyʌñ ntañ mme ñkpọ se ikidịbe tọọñọ ke aditọọñọ ederimbod.”<verse eid="MAT 13:35" /></para>
  <para style="s1">Enam nọ Ñke Mbid Anwaña</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Ndin anye amaakpọñ atu awo akedʌk ufọk. Mme mbed amọ emaedibo anye ete, “Nam nọ ñke mbid ke inwañ inwaña ñnyịn.”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Anye amaabọọrọ ammọ ate, <char style="wj">“Andikitọ eti ñkpasi ado Ayịn Awo.</char> <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" /><char style="wj">Inwañ ado ederimbod, ndin eti ñkpasi ada anọ nditọ abioubọọñ. Mme mbid eda enọ nditọ andidiọọk,</char> <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" /><char style="wj">ndin awo usua a-aketọọhọ mme mbid ado andidiọọk. Ini idọk ado utịd ederimbod, ndin mme adọkidọk edoñño mme enyere.</char><verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />
    <char style="wj">“Naña ewịppe mbid esịññe efọp ke ikañ, ntoro ke adiido ke utịd ederimbod.</char> <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" /><char style="wj">Ayịn Awo ayaadọñ mme enyere amọ, ndin ammọ eyaewaak afịd ñkpọ iduọ se ido ntak idiọọkñkpọ ye mbon se inam ndiọi esịññe ke abioubọọñ amọ. </char> <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" /><char style="wj">Eyaetoomo ammọ edọñ ke ñkpọdiọhọ edemeikañ ake ntuaña ye ntaeded ediikpon.</char> <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" /><char style="wj">Ndin ndinen awo eyaeyamma nte utịn ke abioubọọñ Ete ammọ. Awo akeedodo a-anieghe utọñ, yak anye akop.</char><verse eid="MAT 13:43" /></para>
  <para style="s1">Mme Ñke Ñkpọuto e-Edịppedịp ye Nsọñudua Mme</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />
    <char style="wj">“Abioubọọñ hefịn atie nte ñkpọuto e-edịppedịp ke isọñ. Ke ini awo akekịtte ñkpọuto ado, anye amaana adịp anye, ndin ke inemesịd anye akenyam afịd ñkpọ se anye akenie akedep isọñ ado.</char><verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />
    <char style="wj">“Ke adimaana ntañ, abioubọọñ hefịn atie nte anyamudua a-ayemme ataa uyaiya nsọñudua mme.</char> <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" /><char style="wj">Ke ini anye akekịtte ataa eti amọ, anye atịmme anyọñ akenyam afịd ñkpọ se anye akenie anyʌñ akedep nsọñudua mme ado.</char><verse eid="MAT 13:46" /></para>
  <para style="s1">Ñke A-abañake Iyịre</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />
    <char style="wj">“Ke adimaana ntañ, abioubọọñ hefịn atie nte iyịre e-eketoppo esịn ke ibiok ndin anye amʌm afịd utọ iyak.</char> <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" /><char style="wj">Ke ini iyịre ado amaakeyọhọ ye iyak, mme akọiyak edʌt anye edisịm abod. Ndin ammọ emaesuuk etie esat nti iyak esịññe edọñ ke akpasa, ado etoomo mbon se imiifọnnọ eduọọñọ.</char> <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" /><char style="wj">Adiiba ntom ke utịd ini. Mme enyere eyaedi edibakka mbon ibak ediañña ekpọñ ndinen awo,</char> <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" /><char style="wj">enyʌñ etoomo mbon ibak edọñ ke ñkpọdiọhọ ekamba edemeikañ, ke itie nte ntuaña ye ntaeded ediiba.”</char><verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Yisọs amaabịp ammọ ate, <char style="wj">“Nte afịd ñkpọ ami inwaña ndufo?”</char></para>
  <para style="p" vid="MAT 13:51">Ammọ emaebọọrọ, “Ii.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Anye amaabo ammọ, <char style="wj">“Ke ntoro, andikpeeb mbed akeedodo e-emaekekpeep anye ñkpọ abioubọọñ hefịn atie nte anieufọk a-asịññeke mme ufa ye ñkaan ñkpọuto amọ ke ufọk ubonoñkpọ amọ.”</char><verse eid="MAT 13:52" /></para>
  <para style="s1">Prọfed Ammiinieghe Ukpono</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Ke ini Yisọs amaakekama mme ñke ami akpeep ñkpọ ima, anye amaakpọñ itie ado. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Anye akediwuọ idʌñ ammọ, amaatọọñọ adikpeep mme awo ñkpọ ke sinakọk ammọ, ndin idem amaakpa mbon se ikikop se anye akekpeep. Ammọ emaebịp ete, “Anye akebọọ utọ aniọñ ami ye adudu unam utịppeñkpọ ami ato uke? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Idooho ayịn akabinta ado ami? Idooho Mmeri ado anyịñ eka amọ? Yems, Yosef, Saimọn ye Yudas inyʌññọ ido nditọeka amọ? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Nte afịd nditọeka amọ ibaan ibaññake ye ñnyịn mi? Ndin awo ami akebọọ afịd ñkpọ ami ato mọọ?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Ammọ emaenyʌñ eyat esịd ebaña anye.</para>
  <para style="p" vid="MAT 13:57">Ado Yisọs amaabo ammọ, <char style="wj">“Ado ke idʌñ amọ ye ke ufọk amọ ke prọfed imiinieghe ukpono.”</char><verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Anye ikinamma uwak utịppeñkpọ do ato unana mbuọdidem ammọ.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">Ekpịkke Yọọn Aduọkmmọọñ Iwuod</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Ke ini ado, Herọd andikara amaakop etob abaña Yisọs. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Anye amaabo nditọufọk amọ, “Ana ado Yọọn Aduọkmmọọñ ado ami; anye a-aset ke ñkpa! Ntak ado anam mme adudu utịppeñkpọ eba anye ke idem.”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Herọd amaamʌm Yọọn, abọp ñkpaha ukwak, anyʌñ asịn anye ke ñkpakọb ke ntak Herọdias, anwaan ayịneka amọ Filib, <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />sia Yọọn amaasibo anye, “Mbed a-akpan afo adiben anwaan ayịneka mfo ndọ.” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Herọd amaayem adiwot Yọọn, ado anye akebaak mbon awo anyen, sia ammọ ekedat Yọọn nte prọfed.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Ke ini usọrọ usen emana Herọd, ayịn awonwaan Herọdias amaanek unek ke iso mme isenawo, ndin ado amaanem Herọd esịd eti-eti. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Ado amaanam Herọd anwọñọ ke imọ iyainọ anye ñkpọ akeedodo a-anye abeeñeke. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Ke eka amọ amaakedọọñ anye, anye amaabo, “Nnọ miin iwuod Yọọn Aduọkmmọọñ ke usan.” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Adidem amaafʌhọ, ado ke ntak mme enwọñọ a-anye akenamma ke iso isenawo amọ, anye amaanọ uyio ate enọ ayịn awonwaan Herọdias se anye akebeeñe. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Ndin anye amaadọñ ekekpịkke Yọọn iwuod ke ufọk ñkpakọb. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Emaeben iwuod ami ke usan ekenọ abọikpa ado; ndin anye amaaben akenọ eka amọ. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Mme mbed Yọọn emaediben akpo Yọọn ekebuuk. Ndin ammọ emaekaa ekedọkkọ Yisọs.<verse eid="MAT 14:12" /></para>
  <para style="s1">Yisọs Anọ Tọsịn Awo Ition Ndidia</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Ke ini Yisọs amaakebọ etob ami, anye amaadakka, asaña ke ubom akaa ndobo-ndobo itie a-anye akekanna akeba ke idem amọ ikpọọñ. Ado mme atu awo ekekop ami, ammọ emaekpọñ mme abio, esaña ke ukod ekeene anye. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Ke anye amaakedibeghe ke isọñ anyʌñ akịt atu awo, mbọm amaanam anye; anye amaanyʌñ akọk mbon awo udọñọ ammọ.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Ndubiayio akedi, mme mbed emaekaa ekebo anye, “Itie ami anyọọñ usʌñ akpọñ nte mme awo edʌñọ, ñko ayio asọñ. Bo mme atu awo ami enyọñọ nọ ammọ eka mme esịdidʌñ ekedep ndidia se ediidia.”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Ado Yisọs amaabọọrọ ammọ ate, <char style="wj">“Ufọn ammọ adinyọñọ ibaaha, ndufo ke idem ndufo inọ ammọ ñkpọ edia.”</char><verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Mme mbed emaebọọrọ anye ete, “Ñnyịn inie uyo ition ye iyak iba kpọd.”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Anye amaabo, <char style="wj">“Ikoono ammọ insọk miin.”</char> <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Anye amaanọ uyio ate mbon awo esuuk etie ke mbid, ndin anye amaaben mme uyo ition ye iyak iba ado, abenne anyen ase hefịn anyʌñ anọ ekọọm, ndin abuuñ mme uyo ami anọ mme mbed ate ammọ enọ atu awo. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Afịd awo emaeta enyʌñ ekop uyʌkkọ, ndin mme mbed emaetañ mbeñe se ikiyọhọ isʌhọ ñyọọhọ-ñyọọhọ akpasa duob mme iba. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Ñkpọ nte ideen tọsịn ition ekedia ñkpọ ado, ke esioho ibaan ye ntəkayịn efep.<verse eid="MAT 14:21" /></para>
  <para style="s1">Yisọs Asaña ke Anyọñ Mmọọñ</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Idaha-idaha ado, Yisọs amaanam mme mbed edọñọ ubom ebem anye iso eka ke edem inyañ uko, ke ini anye akenamma mme atu awo ado enyọñọ. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Ke Yisọs amaakenam mme atu awo enyọñọ, anye amaadọọk anyọñ abod ke idem amọ ikpọọñ adikibọñ akam. Anye akesʌk aba do ikpọọñ tutu ayio akịm, <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />ado ubom akeba ke ufọọd akpa, anyọọñ usʌñ akpọñ esʌk, ndin akpọsọñ afịm ye inua akpa emaedakka etəkko ubom eti-eti.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Ke ñkpọ nte ñkanika inaañ usiere, Yisọs amaawuọ asaña ke anyọñ ibiok abịne mme mbed amọ. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Ke ini mme mbed ekekịtte anye nte asaña ke anyọñ ibiok, ndịk amaanam ammọ. Ammọ emaesio ñkpo ato akpọsọñ ndịk ete, “Ekpo ke ado!”<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Ado idaha-idaha ado Yisọs amaabo ammọ ate, <char style="wj">“Isọñ esịd! Ami ke ado, ikiifeghe ndịk.”</char><verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Pita amaabọọrọ anye ate, “Abọọñ, akpedo afo ke ado, bo nọ ami nsaña ke anyọñ mmọọñ ubịne fiin.”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Yisọs amaabo anye, <char style="wj">“Di.”</char></para>
  <para style="p" vid="MAT 14:29">Ndin Pita amaawuọ ke ubom anyʌñ atọọñọ adisaña ke anyọñ mmọọñ mbịne Yisọs. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Ado anye akekịt ndufuud akpa, ndịk amaanam anye, anye anyʌñ atọọñọ adideñ, ndin anye amaabọñ ke akpọsọñ uyio ate, “Abọọñ, ñnyaaña miin.”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Ke ndo-ndo ado, Yisọs amaasio ubọk amọ anyan anyʌñ amʌm anye, anyʌñ abo anye ate: <char style="wj">“Afo awo etək mbuọdidem, nsoo ikinam nọ afo anie eyịghe?”</char><verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Ammọ ekedọọk edʌk ubom, afịm amaadobo. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Mbon se ikidọñọ ke ubom emaenyuuk iwuod ke iso amọ ke ukpono enyʌñ ebo, “Ke akpanikọ afo ado Ayịn Abasi.”<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Ke ammọ emaekekaaña inyañ, ammọ emaebeghe ke esʌk Yenesaded. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Ndin ke ini ideen idʌñ ado emaekedidiọọñọ ke Yisọs ke ado, ammọ emaesuan etob enọ afịd ñkanñkʌk abio ado. Mme awo emaenyʌñ ekoono afịd mbon udọñọ ammọ esọk anye, <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />enyʌñ ekpeiye anye ete akap asʌk ayak mbon udọñọ ado etuuk mben afọñ amọ. Ndin afịd awo se ikituuk mben afọñ amọ emaekop nsọñidem.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s1">Ñkpọ se Isappa Awo</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Ndin usʌk mme Farisi ye mme akpeeb mbed emaeto Yeruselem edi ebịne Yisọs enyʌñ ekebịp anye ete, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Nsoo ido nọ mme mbed mfo ebiat edu unamñkpọ mme ñkpisọñ esed? Ammọ isiyieghe ubọk mbemiso edia ñkpọ!”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Yisọs amaabọọrọ ammọ ate, <char style="wj">“Nsoo ido nọ ndufo ñko ebiat ewʌhọ Abasi ke edu unamñkpọ ndufo?</char> <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" /><char style="wj">Sia Abasi akebo, ‘Kpono ete ye eka mfo’; ndin ‘Ana ewot awo akeedodo a-asuuñọke ete me eka amọ.’</char> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" /><char style="wj">Ado ndufo ebo ke adieke awo abooho ke se ikpikikama inọọ ete me eka amọ unwam ado, ‘asaña-asaña enọ a-anieghe Abasi,’</char> <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" /><char style="wj">ammọ inaaha edat ekpono ete me eka ammọ. Ke ntom, ndufo emebiat ikọ Abasi ke edu unamñkpọ ndufo.</char> <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" /><char style="wj">Ndufo mbon mbubịk! Aisaiya amaanen ke ini anye aketañña prọfesi ibaña ndufo ate:</char><verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />
    <char style="wj">“ ‘Mbon ami eñkpono miin ke ñkpọkinua ammọ,</char></para>
  <para style="q2" vid="MAT 15:8">
    <char style="wj">ado esịd ammọ amaañkpọñ miin anyọọñ usʌñ.</char><verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />
    <char style="wj">Ammọ eñkpono miin ke ikpu-ikpu usʌñ,</char></para>
  <para style="q2" vid="MAT 15:9">
    <char style="wj">mme ukpeebñkpọ ammọ akọñọ ke mme mbed awo.’ ”</char><verse eid="MAT 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Yisọs amaakoot atu awo anyʌñ abo ammọ ate, <char style="wj">“Ikpañ utọñ nọ inwaña.</char> <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" /><char style="wj">Se idʌk awo inua isappake awo, ado se iwuọ awo ke inua asappa awo.”</char><verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Ndin mme mbed emaedi ebịne anye enyʌñ edibịp anye ete, “Afo amediọọñọ ke mme Farisi emaekop idiọọkesịd ke ikọ a-afo aketañña do?”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Anye amaabọọrọ ate, <char style="wj">“Eto akeedodo ake Ete mmi ke hefịn imiitọọhọ eyaewịppe ke adʌñ esio.</char> <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" /><char style="wj">Ikpọñ ammọ, ammọ edo mme adadusʌñ ado edoñño nnan.</char><note caller="+" style="f"><char style="fr" closed="false">15:14 </char><char style="ft" closed="false">Usʌk mme ikpañwed ebo </char><char style="fq" closed="false">nnan </char><char style="fqa" closed="false">e-edatta nnan usʌñ</char></note> <char style="wj">Adieke nnan adatta nnan usʌñ ammọ awo iba eyaeduọññọ edọñọ ube.”</char><verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Ndin Pita amaabo, “Nam ñke ami inwaña ñnyịn.”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Yisọs amaabọọrọ ate, <char style="wj">“Inyʌññọ inwaña ndufo ñko?</char> <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" /><char style="wj">Nte ndufo ikanna ikịt ke se idʌk awo inua aboiyo adʌk idịb, ndin etọrọ anye esio?</char> <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" /><char style="wj">Ado mme ñkpọ ewuọhọ awo ke inua eto esịd, ndin ado anam ammọ edeghe.</char> <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" /><char style="wj">Sia afịd ndiọi akikere eto esịd awo ewuọñọ: uwodawo, efịbe, use, inọ, utie ntiense nsu, adidọk.</char> <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" /><char style="wj">Mme ñkpọ ami enam awo adeghe. Ado adidia ñkpọ ke mbad ubọk inamma awo adeghe. ”</char><verse eid="MAT 15:20" /></para>
  <para style="s1">Mbuọdidem Awonwaan Kenan</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yisọs akekpọñ itie ado, anye amaakaa ñkanñkʌk Tai ye Sidọn. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Ndin ke ebe ado, awonwaan Kenan keed ke ñkanñkʌk ado amaadi abịne anye, aditua abo anye ate, “Abọọñ, Ayịn Defid, ntua miin mbọm. Dimọn a-atʌkkọ ayịn mmi awonwaan ndin anye abọ ufen eti-eti.”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Ado Yisọs ikiibọọrọke anye ikọ ndomokeed. Ndin mme mbed amọ emaekpeiye anye ete, “Nam mma ami adakka, mbaak anye adika iso abọọñ ñkpo ikeene ñnyịn.”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Anye amaabọọrọ ate, <char style="wj">“Ekendọñ miin enọ edọñ ufọk Isrel e-emaekesop kpọd.”</char><verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Ado awonwaan ado amaasaña adisịm anye anyʌñ atọọñọ edọñ ke iso amọ, ate, “Abọọñ, ñnyaaña miin.”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Anye amaabọọrọ ate, <char style="wj">“Inenne adiben ndidia ntəkayịn ntop nnọọ mme ewa.”</char><verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Ado mma ado amaasọsọp abọọrọ ate, “Ii, Abọọñ, ado idem mme ewa esitañ mbeñe e-eduọññọke eto akpokoro eteufọk ammọ edia.”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Ndin Yisọs amaabọọrọ anye ate, <char style="wj">“Mma, afo amenie ekamba mbuọdidem. Eyaak ebeeñe mfo unọ.”</char> Ndin kpa ke ebe ado idem amaamaana asọñ ayịn amọ.<verse eid="MAT 15:28" /></para>
  <para style="s1">Yisọs Anọ Awo Tọsịn Inaañ Ndidia</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yisọs amaato do akaa akesịm mben Inyañ Kalili, ndin anye amaadọọk anyọñ abod akesuuk atie. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Ndin uwak atu awo emaebịne anye, eben mme mbʌñọ, mme nnan, mme imuum ye uwak mbon udọñọ mfen ebịne anye, ediyaak ammọ ebonno anye ke iso, ndin anye amaanyʌñ akọk ammọ udọñọ. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Idem amaakpa atu awo adikịt naña mme imuum etañ ikọ, mme mbʌñọ esaña isañ, mme nnan enyʌñ ekịt usʌñ, ndin ammọ emaetooro Abasi Isrel.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Ndin Yisọs amaakoot mme mbed amọ anyʌñ abo ammọ ate, <char style="wj">“Ami mmekop udʌk mbaña ibon ami; ammọ ebaba ye ami usen ita idiaha ñkpọ ndomokeed. Ñyemme adibo ammọ enyọñ abiọọñ, mbaak edikisʌkkọ ke usʌñ.”</char><verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Mme mbed amọ emaebọọrọ anye ete, “Ke mmọọ ke ñnyịn idiikịt uyo ke esịd idʌñ ami nọ akem utọ atu awo ami?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Yisọs amaabịp ammọ ate, <char style="wj">“Ndufo enie uyo ifañ?”</char></para>
  <para style="p" vid="MAT 15:34">Ammọ emaebọọrọ, “Itiaba, ye ibad-ibad ñkeñe iyak.”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Anye amaabo atu awo esuuk etie ke isọñ. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Ndin anye amaaben uyo itiaba ye iyak ifañ ado, ndin ke anye amaakenọ Abasi ekọm, amaabuuñ ammọ, anyʌñ akappa anọ mme mbed amọ, ndin ammọ emaedeeme enọ atu awo. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Afịd ammọ emaedia enyʌñ ekop uyʌkkọ. Ke emaekedia ema, mme mbed emaekoono mbeñe se ikisʌhọ eyọhọ akpasa itiaba. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Ibad mbon e-ekediaha ñkpọ ekedo tọsịn inaañ, ke esioho ibaan ye ntəkayịn efep. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Ke ini Yisọs amaakesio atu awo unyọñ, anye amaadakka akedʌk ubom akaa ñkanñkʌk Makadan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s1">Uyem Idiọọñọ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Mme Farisi ye mme Sadusi emaedi edidomo Yisọs ke adibo anye yak iwọt mmimọ idiọọñọ a-atooho hefịn.<verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />Yisọs amaabọọrọ, <char style="wj">“Ndubiayio amaadi ndufo ebo, ‘Anyọñ ayaayaiya, sia ikpaanyọñ ado ndad-ndad,’</char> <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" /><char style="wj">ndin ke ubakusen ndufo ebo, ‘Mfịn ayobio ayaaba, sia ikpaanyọñ adat ndin anyọñ anyʌñ afʌhọ.’ Ndufo emediọọñọ naña ekappa idiọọñọ ikpaanyọñ, ado idiọọñọke adikappa idiọọñọ ini ntom.</char> <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" /><char style="wj">Emana mbon mbubịk ye emana mbon efịbe eyem idiọọñọ, ado awo idiinọọñọ ammọ idiọọñọ ke amaaboiyo idiọọñọ Yọna.”</char> Ndin Yisọs amaakpọñ ammọ adakka anyọñ.<verse eid="MAT 16:4" /></para>
  <para style="s1">Yiis mme Farisi ye mme Sadusi</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Mme mbed Yisọs, ke ini ammọ emaekekanna eka edem ibiok uko, emaefre adiben uyo. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yisọs amaabo ammọ, <char style="wj">“Inekke ikpeme, inyʌñ ikpeme idem ndufo mbaak yiis mme Farisi ye mme Sadusi.”</char><verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Ammọ emaeneme ke ufọọd ammọ ebo, “Ado sia ñnyịn ikibenne uyo ndomokeed idi.”<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Yisọs amaadiọọñọ se ammọ ekeneme, ndin anye amaabo ammọ, <char style="wj">“Ndufo mbon etək mbuọdidem, ntak etañña ke atu ndufo ebo ke ikamake uyo-o?</char> <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" /><char style="wj">Isʌkkọ inwanwaña ndufo? Ndufo itoiyoke uyo ition e-ekenọọhọ tọsịn awo ition ye ibad akpasa se ndufo ekekoono?</char> <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" /><char style="wj">Itoiyoke ñko uyo itiaba e-ekenọọhọ awo tọsịn inaañ ye ibad akpasa se ndufo ekekoono?</char> <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" /><char style="wj">Anam die nọ idiinwañake ndufo ke ami ñketañña mbaña uyo? Ado ikpeme idem ndufo ke abaña yiis mme Farisi ye Sadusi.”</char> <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Do ndin amaanwaña ammọ ke anye akebo ammọ ekpeme idem ebaña ukpeebñkpọ mme Farisi ye mme Sadusi, idooho yiis asinamma uyo atịt.<verse eid="MAT 16:12" /></para>
  <para style="s1">Pita Asọọñọ ke Yisọs ado Krais</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Ke ini Yisọs amaakedi utịd Siseria Filipai, anye amaabịp mme mbed amọ mbịme ate: <char style="wj">“Anie ke mme awo ebo ke Ayịn Awo ado?”</char><verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Ammọ emaebọọrọ, “Ubaak ebo Yọọn Aduọkmmọọñ; ubaak ebo Elaiya; ubaak ete, Yerimaiya me keed ke atu mme prọfed.”<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Ndin anye amaabịp ammọ ate, <char style="wj">“Ado ndufo ebo ke ami ndo anie?”</char><verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Ndin Saimọn Pita amaabọọrọ, “Afo ado Krais, Ayịn ndu-ndu Abasi.”<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Yisọs amaabọọrọ anye ate, <char style="wj">“Saimọn ayịn Yọna, afo ado awo e-emaedọdiọñ, sia ikidooho abʌk ye iyiib ekeyaara ami unọọ fiin, ado Ete mmi ke hefịn.</char> <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" /><char style="wj">Ke ntoro, ami udọkkọ fiin nte afo ado Pita,</char><note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="ft" closed="false">Ke usem Krik </char><char style="fq" closed="false">Pita</char><char style="ft" closed="false">awuọñọ </char><char style="fq" closed="false">itiad.</char></note> <char style="wj">ndin ke anyọñ itiad ami, ami ñyaabọp ufọkabasi mmi, ndin inuaatob Hedis</char><note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="ft" closed="false">Hedis awuọñọ abioekpo</char></note> <char style="wj">idiikanna anye.</char> <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" /><char style="wj">Ami ñyaunọ fiin mme ukpọhọde abioubọọñ hefịn: se adodo a-afo abọppọ ke isọñ, eyaebọp ke hefịn, ñko se adodo a-afo atatta ke isọñ eyaetat ke hefịn.”</char> <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Ndin anye amaakpan mme mbed amọ ate ekuudọkkọ awo ndomokeed ke imọ ido Krais.<verse eid="MAT 16:20" /></para>
  <para style="s1">Yisọs Atañ Abaña Ñkpa Amọ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Tọọñọ ke ini ado Yisọs amaatọọñọ aditañ anwa-anwa anọ mme mbed amọ ke ana imọ ika Yeruselem ikibọ nsio-nsio ufen ke ubọk mme ñkpisọñ, mme ñkpoon aku ye mme andikpeeb mbed, ñko ke ana ewot anye, ndin ke ayọhọ usen ita eyaenam anye aset ke ñkpa.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Ndin Pita amaaben anye asịkke ada nsan-nsan anyʌñ atọọñọ adisua nnọọ anye ate, “Abasi akan, Abọọñ! Tutu amama utọ ñkpọ ami idiitịppe unọ fiin.”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Ado Yisọs amaakanna anyʌñ abo Pita, <char style="wj">“Ndakka miin ke iso, Setan! Afo ado ñkpọiduọ annọ miin; afo ukereke ñkpọ a-abañake Abasi, ado akere ñkpọ a-abañake uduud awo.”</char><verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Ndin Yisọs amaabo mme mbed amọ, <char style="wj">“Awo ndomokeed ayemme iñkeene miin ana akañ idem amọ, aben krọs amọ anyʌñ añkeene miin.</char> <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" /><char style="wj">Awo akeedodo a-ayemme adinyaaña uwem</char><note caller="+" style="f"><char style="fr" closed="false">16:25 </char><char style="ft" closed="false">Ke usem Krik ekeme edikappa nte </char><char style="fqa" closed="false">uwem</char><char style="ft" closed="false">enyʌñ ekeme ikappa nte </char><char style="fqa" closed="false">ukpọñ</char><char style="ft" closed="false">; se ñko ke ufañ 26</char></note> <char style="wj">amọ ayaaduọọk anye. Ado awo akeedodo a-aduọhọ uwem amọ ke ntak mmi, ayaanyaaña anye.</char> <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" /><char style="wj">Nsoo ndin idiido udod ke awo adinie afịd ederimbod ado aduọọk ukpọñ amọ? Me nsoo ke awo akeme adinọ nte ukpʌhọ ñkpọ ke ukpọñ amọ?</char> <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" /><char style="wj">Sia Ayịn Awo asʌk adi ke ubọọñ Ete amọ ye mme enyere amọ, ndin anye ayaanọ awo keedekeed utịb a-akemme ye se anye akenam.</char><verse eid="MAT 16:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 16:28" />
    <char style="wj">“Ke akpanikọ ke ami idọkkọ ndufo, aba ubaak awo e-edaaha ke itie ami i-imiidiikịtte ñkpa tutu ammọ ekịt Ayịn Awo nte adi ke abioubọọñ amọ.”</char><verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">Ukpəho Uduud</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Usen itiokeed amaakeboiyo, Yisọs amaadat Pita, Yems ye Yọọn, ayịneka Yems adọọk ñkoñ-ñkoñ abod keed enyʌñ ekeba do ke idem ammọ ikpọọñ. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Do ke uduud amọ akekpəho ke iso ammọ. Iso amọ amaayamma nte utịn, ndin afọñ amọ amaakappa afia nte unwana. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Ndin ete ise Moses ye Elaiya emaewuọñọ edeppe, edineme nneme ye Yisọs.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Ndin Pita amaabo Yisọs ate, “Abọọñ, afọn ñnyịn adiba mi. Adieke afo amaaha ami ñyaabọp atayad ita, keed unie fiin, keed anie Moses, keed anie Elaiya.”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Naña anye akesʌkkọ atatañ ikọ, ñyamma-ñyamma ntọñanyọñ amaadifʌk ammọ, ndin uyio amaato ntọñanyọñ ado awuọ ate, “Anye ami ado Ayịn mmi, a-ami mmaaha ñnyʌñ nnem esịd ye anye eti-eti. Ikpañ utọñ inọ anye!”<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Ke ini mbed amọ ekekoppo ami, ammọ emaeduọññọ ke isọñ efʌk iso ke ndịk. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Ado Yisọs amaadituuk ammọ ate, <char style="wj">“Idakka ida, ikiikop ndịk.”</char> <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Ke ini ammọ ekedịppeke iso, ammọ ikikịtte awo ndomokeed aba, ibọhọke Yisọs.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Naña ammọ ekesʌkkọ esọiyọ ke abod ado, Yisọs amaanọ ammọ ewʌhọ ate, <char style="wj">“Ikiitañ se ekịt inọọ awo ndomokeed tutu enam nọ Ayịn Awo aset ke ñkpa.”</char><verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Mme mbed emaebịp anye, “Ntak a-mme andikpeeb mbed ebooho ke ana Elaiya abem iso adi-e?”<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Yisọs amaabọọrọ ate, <char style="wj">“Ke akpanikọ, Elaiya ayaadi adimaana nneeñe afịd ñkpọ mbon.</char> <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" /><char style="wj">Ado ami idọkkọ ndufo, Elaiya amaadidi, ado ammọ ikidiọọñọke anye, ndin ekappa enam anye se ammọ ekeduaduak. Kpa ukem usʌñ ado ke Ayịn Awo adiibọ ufen ke ubọk ammọ.”</char> <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Ke ini ado mbed amọ ekekere ke anye aketañ ikọ ami anọ ammọ abaña Yọọn Aduọkmmọọñ.<verse eid="MAT 17:13" /></para>
  <para style="s1">Yisọs Akọk Etəkayịn Awodeen a-Anieghe Dimọn</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Ke ini ammọ emaekedisịme atu awo, awodeen keed amaasaña akpere Yisọs anyʌñ atọọñọ edọñ ke iso amọ. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />Ndin anye amaabo, “Abọọñ, tua ayịn mmi mbọm, anye ado ndukpi anyʌñ abọ ufen eti-eti. Anye asiduọ adʌk ikañ ye mmọọñ uwak ini. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Mmaaben anye nsọk mme mbed mfo ado ammọ ikikanna ikọk anye.”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Yisọs amaabọọrọ ate, <char style="wj">“Ndufo mbon emana unana mbuọdidem ye ukwañ uwem, ami ndiiba ye ndufo ñkpeene die? Iben ayịn akparawa ado insọk miin mi.”</char> <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yisọs amaawuuk dimọn ado ndin dimọn amaawuọ etək akparawa ado ke idem, ndin idem amaasọñ anye tọọñọ ke idaha ado.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Akem mme mbed emaedibịne Yisọs ndịbe-ndịbe enyʌñ ekebịp anye ete, “Ntak a-ñnyịn imiikikanna adibịn dimọn ado nsio-o?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Anye amaabọọrọ, <char style="wj">“Sia mbuọdidem ndufo ado ataa etək-etək. Ntañ akpanikọ inọ ndufo, ekpenie mbuọdidem akpesʌkkọ asịp nte ñkpasi mọstad, emekeme ibo ekamba abod ami, ‘Dakka ke itie ami kaa ñko, ndin anye ayaadakka.’ Ñkpọ ndomokeed idiisọññọ ikan ndufo.</char> [<verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" /><char style="wj">Ado ekeme ibịn dimọn anye ami ke akam ye utreudia.”</char>]<note caller="+" style="f"><char style="fr" closed="false">17:21 </char><char style="ft" closed="false">Usʌk ikpañwed esịn mme ikọ ake abitte se iba ke Maak 9:29 </char></note><verse eid="MAT 17:21" /></para>
  <para style="s1">Yisọs Atañ Abaña Ñkpa Amọ Ayọhọ Ñke Mba</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Ammọ emaekedisoobo ke Kalili, Yisọs amaabo, <char style="wj">“Eyaetap Ayịn Awo esịn ke ubọk mme awo.</char> <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" /><char style="wj">Ammọ eyaewot anye, ndin ke ayọhọ usen ita eyaenam anye aset ke ñkpa.”</char> Ndin mme mbed amọ emaefʌhọ eti-eti.<verse eid="MAT 17:23" /></para>
  <para style="s1">Taks Tembịd</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Yisọs ye mbed amọ emaekedisịm Kapanum, mme abọọ taks tembịd a-akedooho drakma iba, emaedibịp Pita, “Ado nte eteufọk ndufo isikpeeghe taks tembịd?”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Anye amaabọọrọ, “Asikpe.”</para>
  <para style="p" vid="MAT 17:25">Ke ini Pita akedʌkkọ ufọk, Yisọs akedo akpa awo aditañ ikọ. Anye amaabo, <char style="wj">“Saimọn, nsoo ido akikere mfo? Mme ndidem ederimbod ebọ isob ye taks eto mme anie: me ebọ eto nditọ ammọ me ebọ eto mbon mfen?”</char><verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Pita amaabọọrọ, “Mbon mfen.”</para>
  <para style="p" vid="MAT 17:26">Yisọs amaabo anye, <char style="wj">“Ndin e-esio mme nditọ efep.</char> <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" /><char style="wj">Ado mbaak ñnyịn ididue ammọ, kaa ibiok ako, nyʌñ top uwaam mfo sịn. Ben akpa iyak a-afo uduumʌm, tat anye inua, ndin ayaakịt drakma inaañ. Ben anye sọk ammọ ke taks mmi ye ake ndufo.”</char><verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s1">Andikpon Ñkan ke Abioubọọñ Hefịn</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Ke ini ado mme mbed Yisọs emaedibịne anye enyʌñ ekebịp, “Anie ido andikpon ñkan ke abioubọọñ hefịn?”<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Yisọs amaakoot etəkayịn anyʌñ anam anye adida ke ufọọd ammọ. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Ndin anye amaabo ammọ, <char style="wj">“Ntañ akpanikọ inọ ndufo, ibọhọke ndufo ekpəho enyʌñ ekappa eba nte ntəkayịn, ndufo idiidʌkkọ abioubọọñ hefịn.</char> <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" /><char style="wj">Ke ntoro, awo akeedodo a-asuuhọke idem amọ nte etəkayịn ami, anye ado andikpon ñkan ke abioubọọñ hefịn.</char> <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" /><char style="wj">Awo akeedodo a-adaarake etəkayịn keed ntom ke ntak anyịñ mmi, andaara miin.</char><verse eid="MAT 18:5" /></para>
  <para style="s1">Adinam Awo Aduọ</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />
    <char style="wj">“Ado awo a-adooho ñkpọiduọ anọ keed ke atu ntəkayịn ami a-abuọttọ idem ye ami, akpaafọn ekọọñ anye ekamba itiad ke itọñ enyʌñ enam anye adeñ ke ntotəño akpainyañ.</char> <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" /><char style="wj">Adọdiọọk anọ ederimbod ke ntak mme ñkpọiduọ e-enamma mme awo enam idiọọkñkpọ. Ñkpọ ntoro ana atịppe, ado adọdiọọk anọ awo a-anamma nọ ñkpọ ntoro atịppe.</char> <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" /><char style="wj">Ubọk mfo me ukod mfo akpedo ñkpọiduọ unọ fiin, kpịkke anye sio nyʌñ top anye duọọk. Afọn afo adidʌk ke uwem nsi-nsi ye unọmọ me nte mbʌñọ akan afo adisaña ye ubọk iba me ukod iba ñkedʌk ikañ nsi-nsi.</char> <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" /><char style="wj">Ñko anyen mfo akpedo ñkpọiduọ unọ fiin, kappa anye sio nyʌñ top anye duọọk. Afọn afo adidʌk ke uwem nsi-nsi ye anyen keed akan afo adinie anyen iba ñkedʌk ke ikañ nsi-nsi.</char><verse eid="MAT 18:9" /></para>
  <para style="s1">Ñke Ñyooñ Edọñ</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />
    <char style="wj">“Ikpeme, mbaak ndufo idisọọn keed ke atu ntəkayịn ami. Sia ami idọkkọ ndufo ke mme enyere ammọ esʌk ekaka iso eba ke iso Ete mmi ke hefịn.</char> [<verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" /><char style="wj">Sia Ayịn Awo akedi adinyaaña mbon se isop.</char>]<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">Usʌk mme ikpañwed esịn mme ikọ se iba ke Luk 19:10</char></note><verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />
    <char style="wj">“Ndufo ekere die, adieke awo anieghe edọñ ikie, ndin keed ke atu ammọ asop usʌñ, nte anye idiikpọññọ anaañ mme duob mme usʌkkeed ado ke abod ika ikiyem keed andikisop?</char> <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" /><char style="wj">Ke akpanikọ ke idọkkọ ndufo, adieke anye akịtte edọñ keed ado, anye ayaanem esịd abaña anye ado akan anaañ mme duob mme usʌkkeed ako i-imiikisoppo.</char> <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" /><char style="wj">Ukem-ukem ado, idooho uduak Ete ndufo ke hefịn nọ ndomokeed ke atu ntəkayịn ami ekpesop.</char><verse eid="MAT 18:14" /></para>
  <para style="s1">Ke Abaña Idiọọkñkpọ ke Ufọkabasi</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />
    <char style="wj">“Adieke ayịneka</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">18:15 </char>
      <char style="ft" closed="false">Ke usem Krik adelfọs ada anọ </char>
      <char style="fq" closed="false">ayịneka </char>
      <char style="fqa" closed="false">awodeen me awonwaan</char>
      <char style="ft" closed="false">atañ abaña emọ-emọ mbed Krais, me ado awodeen me awonwaan a-anịmme Krais ke akpanikọ; se ñko ke Matiu 18:21 ye Matiu 18:35</char>
    </note> <char style="wj">mfo ke Krais anamma idiọọkñkpọ,</char><note caller="+" style="f"><char style="fr" closed="false">18:15 </char><char style="ft" closed="false">Usʌk mme ikpañwed ewet </char><char style="fqa" closed="false">unam fiin idiọọkñkpọ </char></note> <char style="wj">kaa ke neme ye anye ikpọọñ, ke ufọọd ndufo awo iba. Ammọ ekpekpañ utọñ ekop se afo atañ, afo ayaamaana adat ammọ anie.</char> <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" /><char style="wj">Ado adieke ammọ imiikpañña utọñ, dat awo keed me iba saña, nọ ato do ‘esọọñọ afịd ikọ eto inua ntiense awo iba me ita.’</char> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" /><char style="wj">Adieke ammọ esʌkkọ esịn adikop, ke tañ nọ ufọkabasi, ñko adieke ammọ esịnne adikop nnọọ ufọkabasi, dat ammọ naña nte afo akpedat mbon i-imiidiọọñọke Abasi me mme abọọ taks.</char><verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />
    <char style="wj">“Ke akpanikọ ke idọkkọ ndufo, se adodo a-ndufo ebọppọ ke isọñ, eyaebọp ke hefịn, se adodo a-ndufo etatta ke isọñ, eyaetat ke hefịn.</char><verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />
    <char style="wj">“Ke akpanikọ ke mmaana idọkkọ ndufo, adieke awo iba ke atu ndufo ke isọñ enyịmmeke adibeeñe ñkpọ akeedodo, Ete ndufo ke hefịn ayainọ ndufo.</char> <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" /><char style="wj">Sia itie nte awo iba me ita eboho ke anyịñ mmi, ami mmọdo mba ke atu ammọ.”</char><verse eid="MAT 18:20" /></para>
  <para style="s1">Ñke Anana Mbọm Ayịnufọk</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Ndin Pita amaabịne Yisọs akebo, “Abọọñ, akañ ifañ ke ami nnie adifeen nnọọ ayịneka mmi awodeen me ayịneka mmi awonwaan adieke anye andueghe miin? Ana nte ayọhọ akañ itiaba?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yisọs amaabọọrọ anye ate, <char style="wj">“Ami ubo fiin idooho akañ itiaba, ado akañ ata mme duob mme itiaba.</char><note caller="+" style="f"><char style="fr" closed="false">18:22 </char><char style="ft" closed="false">Akeme inyʌñ ndo </char><char style="fq" closed="false">ata mme duob </char><char style="fqa" closed="false">itie itiaba</char></note><verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />
    <char style="wj">“Ke ntoro, abioubọọñ hefịn atie nte adidem a-akeyemme adinam ibad akʌk amọ ye nditọufọk amọ.</char> <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" /><char style="wj">Ini unam ibad amaakedisịm, ammọ emaeben awo a-akekamake anye tọsịn ekpad kold</char><note caller="+" style="f"><char style="fr" closed="false">18:24 </char><char style="ft" closed="false">Ke usem Krik ado </char><char style="fqa" closed="false">tọsịn talen duob</char><char style="ft" closed="false">; talen keed ado akʌk utom usen debra ke isua edịb.</char></note> <char style="wj">duob edi ke iso amọ.</char> <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" /><char style="wj">Anye ikinieghe usʌñ adikpe isọn ami. Ke ntoro, eteufọk amọ amaanọ uyio ate enyam anye ye anwaan ye nditọ ye afịd inie amọ, nọ eben ekpe isọn ado.</char><verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />
    <char style="wj">“Ke ayịnufọk amọ akekoppo ami, anye amaaduọ ke iso eteufọk, atọọñọ edọñ, akpeiye, abo ‘Nie ime ye ami, ke ñyaukpe afịd akʌk mfo.’</char> <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" /><char style="wj">Ndin eteufọk amọ amaatua anye mbọm, afeen isʌñ amọ, anyʌñ ayaak anye anyọñ.</char><verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />
    <char style="wj">“Ado ke ini ayịnufọk ami anyọññọ, anye amaadibommo ayịnufọk mfen a-akekamake anye isʌñ akʌk silfa talen ikie.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">18:28 </char>
      <char style="ft" closed="false">Ke Krik ado </char>
      <char style="fqa" closed="false">denarii ikie; </char>
      <char style="ft" closed="false">denarius keed akesido akʌk utom usen debra (Se ke Matiu 20:2)</char>
    </note> <char style="wj">Anye amaasịn anye afiaitọñ, afʌt anye itọñ, anyʌñ abo anye ate, ‘Ñkpe se afo añkama miin.’</char><verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />
    <char style="wj">“Ayịnufọk ami amaaduọ anye ke ukod anyʌñ akpeiye anye abo: ‘Nie ime ye ami ke ñyaukpe.’</char><verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />
    <char style="wj">“Ado anye ikinyịmmeke. Utu ke ado, anye amaanam esịn anye ke ufọk ñkpakọb tutu anye akpe isʌñ ado ama.</char> <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" /><char style="wj">Mme nditọufọk mbon ako emaenekke efʌhọ ke idaha a-ammọ ekekịtte se ikitịppe, ndin ammọ emaekaa ekedọkkọ eteufọk ammọ afịd ñkpọ se ikiitịppe.</char><verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />
    <char style="wj">“Ndin eteufọk amaadọñ ekoot ayịnufọk ado adi, anyʌñ adibo anye, ‘Afo ibak ayịnufọk, ami mmaafeen afịd isʌñ mfo unọ fiin sia afo amañkpeiye miin.</char> <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" /><char style="wj">Nte afo ñko ukpunieghe mbọm ubaña emọ-emọ ayịnufọk mfen naña ami ñkenie mbọm ubaña fiin?’</char> <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" /><char style="wj">Ke iyadesịd, eteufọk amaakappa anye anọ mme anọ awo ufen, tutu anye akpe afịd isʌñ amọ.</char><verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />
    <char style="wj">“Ntom ke Ete mmi ke hefịn adiinam ye ndufo keedekeed, ibọhọke ndufo efeen enọ ayịneka ndufo awodeen me ayịneka awonwaan ke afịd esịd ndufo.”</char><verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s1">Uwuọndọ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Ke ini Yisọs amaaketañ mme ikọ ami ima, anye amaakpọñ Kalili akaa ke efaak Yudia ke edem Yọdan mbeñ uko. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Mme uwak atu awo emaekeene anye, ndin anye amaakọk ammọ udọñọ.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Mme Farisi ifañ emaebịne anye adidomo anye idomo. Ammọ emaebịp anye ete, “Nte ado nnen-nnen ñkpọ awodeen adisio anwaan amọ ndọ ke ntak akeedodo?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Anye amaabọọrọ ate, <char style="wj">“Ndufo ikikoodo ke tọọñọ ke aditọọñọ Andibod ‘akebot ammọ awodeen ye awonwaan,’</char> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" /><char style="wj">anyʌñ abo ate, ‘Ke ntak ami, awodeen ayaakpọñ ete ye eka amọ anyʌñ akediana ye anwaan amọ, ndin ammọ awo iba eyaekappa edo abʌk keed’?</char> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" /><char style="wj">Ndin ammọ idooho awo iba aba, ado edido abʌk keed. Ke ntoro, se Abasi amaakedian, yak awo ndomokeed akuudiañña.”</char><verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Ammọ emaemaana ebịp anye ete, “Nsoo ndin ikinam nọ Moses akebo yak awo anọ anwaan amọ ñwed uwuọndọ anyʌñ asio anye unyọñ?”<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Yisọs amaabọọrọ ammọ ate, “<char style="wj">Moses akenyịmme ndufo esịññe ibaan ndufo ndọ ato ntak isọñesịd ndufo. Ado ikidooho ntoro tọọñọ ke aditọọñọ</char>. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" /><char style="wj">Ami ibo ndufo ke awo akeedodo a-asịnne anwaan amọ, ibọhọke ke ntak efịbe, anyʌñ adọ awonwaan mfen, a-asịn efịbe.”</char><verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Mme mbed emaebo anye, “Akpedo ñkpọ anwaan ye ebe aba ntom, afọn awo aditre adidọ ndo.”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Yisọs amaabọọrọ ate, <char style="wj">“Idooho afịd awo ekan enyịmme ukpeebñkpọ ami, ibọhọke mbon se Abasi amaakenọ ukeme adinyịmme.</char> <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" /><char style="wj">Sia aba mme itọ a-adooho ammọ ekemana ntoro, anyʌñ aba mme itọ a-adooho mbon mfen enam nọ ammọ eba ntoro, ñko anyʌñ aba mbon e-ebiereke adidu uwem nte mme itọ ke ntak abioubọọñ hefịn. Awo a-akanna anyịmme ñkpọ ami yak anyịmme.”</char><verse eid="MAT 19:12" /></para>
  <para style="s1">Ntəkayịn ye Yisọs</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Ndin mbon awo emaeben ntəkayịn esọk Yisọs nọ anye adot ammọ ubọk anyʌñ abọñ akam anọ ammọ. Ado mme mbed amọ emaesua enọ mbon e-ekebenne ammọ edi.<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />Yisọs amaabo ate, <char style="wj">“Yak ntəkayịn edi embịne miin, ke awo akpan ammọ, sia abioubọọñ hefịn anie utọ mbon ami.”</char> <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Ke ini anye amaakedot ammọ ubọk ama, anye amaakpọñ do akaa itie mfen.<verse eid="MAT 19:15" /></para>
  <para style="s1">Imọ Awo ye Abioubọọñ Abasi</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Akem awodeen keed amaasaña abịne Yisọs akebịp anye ate, “Andikpeeb, nsoo eti ñkpọ ke ami ñkpenam nọ nnie nsi-nsi uwem?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Yisọs amaabọọrọ ate, <char style="wj">“Ntak a-afo ambịppe miin abaña se ifọn-ọ? Awo keed kpọd aba a-afọnnọ. Adieke afo ayemme uwem nsi-nsi, nịm mme mbed Abasi.”</char><verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Awodeen ado amaabịp anye ate, “Mme akee mbed?”</para>
  <para style="p" vid="MAT 19:18">Yisọs amaabọọrọ ate, <char style="wj">“Kuuwot awo, kuusịn efịbe, kuuyịp inọ, kuutie ntiense nsu,</char> <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" /><char style="wj">kpono ete ye eka mfo, nyʌñ ma mbọhọidʌñ mfo nte idem mfo.”</char><verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Akparawa ado amaabọọrọ ate, “Mmenịm afịd mme mbed ami. Nsoo mfen isʌhọ?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yisọs amaabọọrọ anye ate, <char style="wj">“Akpedo ameyem adifọn mmaa, kaa ke nyam inie mfo nyʌñ kpọñ akʌk nọ mme uweene, ndin afo ayaanie nsọñudua inie ke hefịn. Ndin di diñkeene miin.”</char><verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Ke ini akparawa ami akekoppo ñkpọ ami anye amaadakka anyọñ ke mfʌhọ, sia anye amaanie ñkpọ eti-eti.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Ndin Yisọs amaabo mme mbed amọ ate, “<char style="wj">Ntañ akpanikọ inọ ndufo, asọñ anie ñkpọ awo adidʌk abioubọọñ hefịn.</char> <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" /><char style="wj">Ami mmemaana ntañ inọ ndufo nte ke ado mmem-mmem ñkpọ kamel adiboiyo ke adudu abiaween akan anie ñkpọ awo adidʌk abioubọọñ Abasi.”</char><verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Ke ini mme mbed ekekoppo ikọ ami, idem amaakpa ammọ eti-eti, anam ammọ emaebịp anye ete, “Anie awo ndin adiikan inie adinyaaña?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yisọs amaabenne anyen ase ammọ anyʌñ abo, <char style="wj">“Ñkpọ ami asọñ ye awo, ado ye Abasi afịd ñkpọ ado mmem-mmem.”</char><verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Pita amaabọọrọ anye ate, “Ñnyịn imikpọñ afịd ñkpọ inyʌñ ukeene fiin! Nsoo ndin idiido utịb ñnyịn?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Yisọs amaabo ammọ ate, <char style="wj">“Ntañ akpanikọ inọ ndufo, ke ini a-afịd ñkpọ adiikappa ufa, ke ini Ayịn Awo adiitie ke ebekpo ubọọñ amọ, ndufo e-eñkeeneke miin eyaetie ke mme ebekpo duob mme iba adibiide ikpe nnọọ mme esiin Isrel duob mme iba.</char> <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" /><char style="wj">Ndin afịd awo e-emaekekpọñ mme ufọk, me nditọeka ideen me nditọeka ibaan, me ete, me eka me anwaan</char><note caller="+" style="f"><char style="fr" closed="false">19:29 </char><char style="ft" closed="false">Usʌk mme ikpañwed inieghe </char><char style="fq" closed="false">me anwaan.</char></note> <char style="wj">me nditọ, me ikọd inwañ ke ntak mmi eyaebọ utịb akañ ikie enyʌñ enie uwem nsi-nsi.</char> <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" /><char style="wj">Ado uwak awo e-eboiyoke iso, eyaekappa ekpere edem, ndin uwak e-ekpeeghe edem, eyaekappa eboiyo iso.”</char><verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s1">Ñke Mme Anam Utom ke Inwañ Fain</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />
    <char style="wj">“Abioubọọñ hefịn aba nte anie inwañ a-akewuọhọ ke ufọk ataa ubakusen adikidat mbon utom nọ edinam utom ke inwañ fain amọ.</char> <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" /><char style="wj">Anye amaanyịmme ikpe mbon utom ado denarius</char><note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">denarius keed akesido akʌk utom usen debra</char></note> <char style="wj">keed ke usen, anyʌñ anọ ammọ ekaiya utom ke inwañ fain amọ.</char><verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />
    <char style="wj">“Anye amaamaana awuọ ke ñkpọ nte ñkanika usʌkkeed ubakusen, ke ñkpọ nte awa ita amaakeboiyo, anyʌñ akekịt mbon utom mfen naña eda ke anwa udua, inamma ñkpọ ndomokeed.</char> <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" /><char style="wj">Ndin anye amaabo ammọ ate, ‘Ndufo ñko ikeene ikaa inwañ fain mmi ikinam utom, ndin ami ñyaikpe ndufo akʌk se inen.’</char> <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" /><char style="wj">Ammọ emaenyʌñ ekaiya.</char></para>
  <para style="p" vid="MAT 20:5">
    <char style="wj">“Ñkpọ nte awa ita emaekeboiyo, ke ñkpọ nte ñkanika duob mme iba uweemeayio, anye amaamana anam ukem-ukem ñkpọ ado.</char> <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" /><char style="wj">Ñko ke ñkanika ition uweemeayio anye amaamana awuọ anyʌñ akekịt mbon mfen nte eda, ndin anye amaabịp ammọ ate, ‘Nsoo ido nọ ndufo eda mi inamma ñkpọ ndomokeed?’</char><verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />
    <char style="wj">“Ammọ emaebọọrọ ete, ‘Sia awo ndomokeed ikpeeghe ñnyịn utom.’</char></para>
  <para style="p" vid="MAT 20:7">
    <char style="wj">“Anye amaabo ammọ ate, ‘Ndufo ñko ikaa ke inwañ utom mmi ñko.’</char><verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />
    <char style="wj">“Ke ndubiayio, anie inwañ fain amaabo akamautom amọ ate, ‘Koot mme anam utom nyʌñ kpe ammọ akʌk ammọ, tọọñọ ke mbon e-ekediighe akpatre tutu akesịm mbon e-ekediighe akpa.</char><verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />
    <char style="wj">“Ke ntoro, mbon e-ekediighe utom ke ñkanika ition emaewuọ ekebọ denarius keedekeed.</char> <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" /><char style="wj">Ke ini mbon e-eketooho edi utom emaekedi ammọ emaekere edibọ ñkan ado, ado ammọ ñko ekebọ ukem denarius keedekeed.</char> <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" /><char style="wj">Ke ammọ emaekebọ, ammọ emaedukuunọ ye anie inwañ ete,</char> <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" /><char style="wj">‘Mbon e-ekediighe edem ekenam utom awa keed kpọd ndin afo akpe ammọ ukem-ukem naña ikpe ñnyịn, akpesʌkado ñnyịn imaikibọ ufen afịd usen inyʌñ inam utom ke idak ufiob ayio.’</char><verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />
    <char style="wj">“Anye amaabọọrọ keed ke atu ammọ ate, ‘Ufan mmi, ami utʌkkọ fiin; nte ñnyịn ikinyịmmeke denarius keed ke usen?</char> <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" /><char style="wj">Ben akʌk mfo nyọñ. Ami ñnyʌñ mma adikpe akpatre awo naña ukpe fiin.</char> <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" /><char style="wj">Nte ami nnieghe unen adinam se mma ye akʌk mmi? Ntak afo akpediọọhọ esịd sia ami mmefọn ido-o?’</char><verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />
    <char style="wj">“Ke ntoro, akpatre awo ayaakappa ado akpa, ndin akpa ayaanyʌñ akappa ado akpatre.”</char><verse eid="MAT 20:16" /></para>
  <para style="s1">Yisọs Atañ Abaña Ñkpa Amọ Ayọhọ Akañ Ita</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Yisọs akeka Yeruselem, ndin ke usʌñ anye amaakoot mme mbed amọ duob mme iba asịkke ada anyʌñ abo ammọ ate, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" /><char style="wj">“Ñnyịn ika Yeruselem, ndin eyaeyaak Ayịn Awo esịn ke ubọk mme ñkpoon aku ye mme andikpeeb mbed. Ammọ eyaebiere ikpe ñkpa enọ anye.</char> <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" /><char style="wj">Eyaenyʌñ eyaak anye esịn ke ubọk mme Gentile nọ edọọñ anye ndọk, emia anye, enyʌñ ekọñ anye ke krọs. Ke ayọhọ usen ita anye ayaaset ke ñkpa adʌk ke uwem.”</char><verse eid="MAT 20:19" /></para>
  <para style="s1">Ebeeñe Eka Nditọ Sebidi</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Akema eka nditọ Sebidi amaadi ye nditọ ideen amọ aditọọñọ edọñ anyʌñ anịm anye ebeeñe ke iso.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Ndin Yisọs amaabịp anye ate, <char style="wj">“Nsoo ke ayem?”</char></para>
  <para style="p" vid="MAT 20:21">Ndin anye amaabo ate, “Nwọñọ bo ke nditọ ideen mmi iba ami eyautie fiin ke ubọk nnasia ye ke ufiin ke abioubọọñ mfo.”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Yisọs amaabo ammọ, <char style="wj">“Ndufo idiọọñọke se ndufo ebeeñe. Ndufo eyaekan enwọñ kọọb a-ami ndiinwọñ?”</char></para>
  <para style="p" vid="MAT 20:22">Ammọ emaebọọrọ ete, “Ñnyịn imikan.”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Anye amaabo ammọ ate, <char style="wj">“Afọn, eyaenwọñ eto kọọb mmi, ado amaado aditie ke ubọk nnasia me ke ubọk ufiin mmi, idooho ami nnie adinọ. Mme itie ado anie mbon e-Ete mmi akebeeñeke anịm anọ.”</char><verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Ke ini mme mbed duob ako ekekoppo ñkpọ ami, ammọ emaeyat esịd eti-eti ye nditọeka Sebidi iba ami. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Ndin Yisọs amaakoot ammọ abok ate, <char style="wj">“Ndufo emediọọñọ ebo ke atu mme Gentile mme adaukara efọfʌnnọ ammọ, ndin mme ñkpisọñ ammọ ewọt adudu a-ammọ edatta ekaara ammọ.</char> <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" /><char style="wj">Inaaha utọ ñkpọ ami atịppe ke atu ndufo. Iyoo, ado awo a-ayemme adikpon ke atu ndufo ana ado ayịnufọk ndufo,</char> <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" /><char style="wj">ndin awo a-anyʌññọ ayem adido akpa ke atu ndufo ana ado afʌn ndufo,</char> <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" /><char style="wj">kpa naña Ayịn Awo imiikidieghe ibo edinam ñkpọ enọ anye, ado akedi nọ adinam ñkpọ anọ ubon awo, anyʌñ ayaak uwem amọ nte ñkpọufak anọ mme awo.”</char><verse eid="MAT 20:28" /></para>
  <para style="s1">Mme Nnan Iba Emọọnọ Usʌñ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Nte Yisọs ye mme mbed amọ ekekpọññọ Yeriko, ekamba atu awo emaekeene anye. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Nnan iba e-eketieghe ke mben usʌñ, ekekop ke Yisọs asʌk adiboiyo, ammọ emaebọñ ñkpo ete, “Abọọñ, Ayịn Defid, nie mbọm ibaña ñnyịn.”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Ndin mme atu awo emaesua enọ ammọ, ebo yak ammọ ekʌp inua, ado ammọ emaenenekke ebọñ, “Abọọñ! Ayịn Defid, tua ñnyịn mbọm.”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Yisọs amaatuak ada, akoot ammọ anyʌñ abịp ate, <char style="wj">“Nsoo ke eyem nnam inọ ndufo?”</char><verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Ammọ emaebo anye ete, “Abọọñ, ñnyịn iyem ikịt usʌñ.”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Yisọs amaatua ammọ mbọm anyʌñ atuuk ammọ anyen, ndin ammọ emaemaana ekịt ñkpọ kpa idahado, enyʌñ edakka ekeene anye.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">Yisọs Adʌk Yeruselem nte Adidem</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Naña ammọ esʌkkọ ekpere Yeruselem, enyʌñ edisịm Betfas ke Abod Ọlif, Yisọs amaadọñ mbed amọ iba, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />ate, <char style="wj">“Ikaa idʌñ a-adaaha ke iso ndufo ko. Imaidʌk, eyaekịt dọñki e-eyịtte ke idʌk ye ñyịn amọ. Itat ammọ idat insọk.</char> <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" /><char style="wj">Adieke awo ndomokeed asioho uyio, ibo ke Abọọñ ayem ammọ, ndin anye ayaanọ ammọ edi ini keed.”</char><verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Aketịppe ntom nọ prọfesi ami asu:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“Dọkkọ Adiaha Saiyọn ate,</para>
  <para style="q2" vid="MAT 21:5">‘Sese, adidem mfo asʌk adi ubịne,</para>
  <para style="q1" vid="MAT 21:5">awo nsuukidem, awat ke dọñki ye</para>
  <para style="q2" vid="MAT 21:5">abaak dọñki.’ ”<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Mme mbed emaekaa ekenam naña Yisọs aketemme ammọ. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Ammọ emaedat dọñki ye abaakenañ edi enyʌñ ebịt afọñ anyọñidem ammọ nọ Yisọs adọọk atie. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Ataa ekandịk atu awo emaebịt mme afọñ anyọñidem ammọ ke akpọusʌñ, ke ini usʌk awo ekekpịkkeke mme ñkọk eto ebiit ke usʌñ. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Mme atu awo se ikisaña anye ke iso ye mbon se ikikeene anye ke edem emaekwaaha ñkpo ete:</para>
  <para style="q1" vid="MAT 21:9">“Hosana<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false">Hosana ato usem Hibru awuọñọke “Nyaaña” akema adido ikọ itooro; se ñko ke Matiu 21:15</char></note> anie Ayịn Defid!”</para>
  <para style="b" vid="MAT 21:9" />
  <para style="q1" vid="MAT 21:9">“Afọfọn anọ anye a-adiighe ke anyịñ Abọọñ!”</para>
  <para style="b" vid="MAT 21:9" />
  <para style="q1" vid="MAT 21:9">“Hosana<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false">Hosana ato usem Hibru awuọñọke “Nyaaña” akema adido ikọ itooro; se ñko ke Matiu 21:15</char></note> ke ataa ikpa anyọñ hefịn.”<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Ke ini Yisọs akedʌkkọ Yeruselem, afịd abio amaakpəkko. Mme awo emaebịp ebo, “Anie awo ido ami?”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Mme atu awo emaebọọrọ ete, “Anye ado Yisọs, prọfed a-atooho Nasared ke Kalili.”<verse eid="MAT 21:11" /></para>
  <para style="s1">Yisọs ke Tembịd</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Yisọs amaadʌk akwere tembịd akebịn mme awo e-ekedeppedep enyʌñ enyaanyam ñkpọ do asịññe. Anye amaanyʌñ akekanna mme akpokoro mme akpəho akʌk ye mme ñkpọitie mme anyam ibiom aduọọñọ. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Ndin anye amaabo ammọ, <char style="wj">“E-ewewet ebo, ‘Ediikoot ufọk mmi ufọk ubọñ akam,’ ado ndufo emeben anye enịm ‘afe mbon inọ.’ ”</char><verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Akem mme nnan ye mme mbʌñọ emaedibịne anye ke tembịd, anye amaanyʌñ akọk ammọ udọñọ. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Ado ke ini mme ikpọ aku ye mme akpeeb mbed ekekịtte mme utịppe ñkpọ se anye akenam ye naña ntəkayịn ekesʌk ebọñ ke mme akwere tembịd ete, “Hosana anie Ayịn Defid,” esịd amaadiọọk ammọ ñkpa-ñkpa.<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />Ammọ emaebịp anye ete, “Amekop se ntəkayịn ami etañ?”</para>
  <para style="p" vid="MAT 21:16">Yisọs amaabọọrọ, <char style="wj">“Ii, akenam ndufo ikoodo nte ebo,</char></para>
  <para style="q1" vid="MAT 21:16">
    <char style="wj">“ ‘Ato ke inua ntəkayịn ye mme nsek nditọ, afo</char></para>
  <para style="q2" vid="MAT 21:16">
    <char style="wj">Abọọñ, amenam ekọọm awuọ ubịne fiin?’ ”</char><verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Ndin anye amaakpọñ ammọ do awuọ akaa Betani akena do ke akonayio ado.<verse eid="MAT 21:17" /></para>
  <para style="s1">Yisọs Asuuñọ Eto Fik</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Ke ubakusen, naña Yisọs atịmmeke aka Yeruselem, abiọọñ amaadọñ anye. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Ke anye akekịtte eto fik keed ke mben usʌñ, anye amaasaña akpere eto ami, ado anye ikikịtte mfịd ndomokeed, ibọhọke mfañ ikpọọñ. Ndin anye amaabo eto ami, <char style="wj">“Uduunwịmme mfịd aba ke nsi-nsi.”</char> Idahado-idahado, eto ado amaayeeme.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Ke ini mme mbed ekekịtte ami, idem amaakpa ammọ, ammọ emaenyʌñ ebịp ete, “Eto fik ado akenam die akpa usọp-usọp ntoro?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Yisọs amaabọọrọ, <char style="wj">“Ami ntañ akpanikọ inọ ndufo, adieke ndufo enieghe mbuọdidem ndin inieghe eyịghe, idooho se ekenam eto fik ado ikpọọñ ke ndufo ekeme edinam, ado ndufo emekeme ibo ekamba abod ami ‘Kaa keduọ dʌk akpainyañ,’ ndin ayaanyʌñ atịppe ntoro.</char> <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" /><char style="wj">Adieke enieghe mbuọdidem eyaebọ se adodo a-ndufo ebọññọ akam ebeñe.”</char><verse eid="MAT 21:22" /></para>
  <para style="s1">Eyem Adidiọọñọ nte Yisọs Adat Adudu</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Yisọs amaadʌk akwere tembịd ndin ke ini anye akesʌkkọ akpeep ñkpọ, mme ikpọ aku ye mme ñkpisọñ emaedibịne anye enyʌñ ebịp ete, “Nsutọ adudu ke afo adat anañña mme ñkpọ ami? Ñko anie akunọọ fiin adudu ami?”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yisọs amaabọọrọ ammọ ate, <char style="wj">“Ami ñyaanyʌñ ibịp ndufo mbịme keed. Adieke ndufo embọọrọke miin, ami ñyaatañ inọ ndufo adudu a-ami ndatta nnañña mme ñkpọ ami.</char> <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" /><char style="wj">Uduọkmmọọñ Yọọn aketo uke? Aketo hefịn, me aketo awo?”</char></para>
  <para style="p" vid="MAT 21:25">Ammọ emaedọñọ adu ke atu idem ammọ ete, “Ñnyịn ikpibo, ‘Aketo hefịn,’ anye ayaabo, ‘Ndin nsoo ikido ndufo inịmme anye ke akpanikọ?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Ado ñnyịn ikpibo, ‘Aketo awo,’ ñnyịn ibaabaak se mme awo ekeme inam sia afịd awo ekere ke Yọọn akedo prọfed.”<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Ndin ke ibọọrọ ammọ emaebo Yisọs, “Ñnyịn idiọọñọke.”</para>
  <para style="p" vid="MAT 21:27">Ndin Yisọs amaabo, <char style="wj">“Ami ñko ndiitañña inọ ndufo nte ami ndat adudu nnañña mme ñkpọ ami.</char><verse eid="MAT 21:27" /></para>
  <para style="s1">Ñke Nditọ Ideen Iba</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />
    <char style="wj">“Ndufo ekere die ebaña ñke ami? Ete keed amaaba a-akenieghe nditọ ideen iba. Ndin anye amaabịne akpa akebo, ‘Yịn mmi, kaa utom mfịn ke inwañ.’</char><verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />
    <char style="wj">“Anye amaabọọrọ, ‘Ndiikaaha,’ ado akema akpəho akikere anyʌñ adika.</char><verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />
    <char style="wj">“Ndin ete amaakaa abịne ayịn añko anyʌñ akedọñ anye ukem utom ado. Anye amaabọọrọ, ‘Ete, ñyaaka’ ado ikikaaha.</char><verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />
    <char style="wj">“Anie awo ke atu nditọ ideen iba ami ikinam uduak ete amọ?”</char></para>
  <para style="p" vid="MAT 21:31">Ammọ emaebọọrọ ete, “Akpa awo.”</para>
  <para style="p" vid="MAT 21:31">Yisọs amaabo ammọ, <char style="wj">“Ami ntañ akpanikọ inọ ndufo, mme abọọ taks ye mme akpara eyaibem ndufo iso edʌk abioubọọñ Abasi.</char> <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" /><char style="wj">Sia Yọọn amaadi adiwọt ndufo nnen-nnen usʌñ ado ndufo ikinịmme anye ke akpanikọ, ado mme abọọ taks ye mme akpara emaenịm anye ke akpanikọ. Kpayeado, ndufo ikikappake esịd, ikinyʌññọ inịm anye ke akpanikọ.</char><verse eid="MAT 21:32" /></para>
  <para style="s1">Ñke Mme Atọinwañ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />
    <char style="wj">“Ikpañ utọñ ikop ñke mfen: Anie isọñ keed amaaba a-aketọọhọ inwañ fain. Anye amaabọp akọ akanna inwañ ado, atịppe itie unam ukọd, anyʌñ abọp anyọñukpeme do. Akem anye amaakappa inwañ fain ado anọ mme atọinwañ ate ekpeme, ndin adakka akaa isañ ke itie mfen.</char> <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" /><char style="wj">Ke ini idọk akekpereke, anye amaadọñ nditọufọk amọ ebịne mme atọinwañ ado nọ ekebọi mfịd inwañ imọ edi.</char><verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />
    <char style="wj">“Mme atọinwañ ami emaemuum nditọufọk ami; emia keed idiọọk-idiọọk, ewot keed, enyʌñ etọọñ ayọhọ ita ke itiad.</char> <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" /><char style="wj">Ndin anye amaamaana adọñ mme nditọufọk mfen e-ekewakka ekan akpa. Mme atọinwañ ami emaenam ukem-ukem naña ekenam ye akpa nditọufọk.</char> <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" /><char style="wj">Ke akpatre, anye amaadọñ ayịn amọ abịne ammọ, ndin ke akikere amọ, anye amaabo ‘Ammọ eyaekpono ayịn mmi.’</char><verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />
    <char style="wj">“Ado mme atọinwañ ami ekekịt ayịn amọ, ammọ emaebo emọ-emọ ete, ‘Anye ami ado adiaakpa. Idi yak ñnyịn iwot anye iben udeeme inie amọ idat.’</char> <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" /><char style="wj">Ndin ammọ emaemʌm anye etop esio ke inwañ fain ado, enyʌñ ewot anye.</char><verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />
    <char style="wj">“Anie inwañ fain amaadi, nsoo ke anye adiinam mme atọinwañ ami?”</char><verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Ammọ emaebọọrọ, “Anye ayaawot mbubịk ibon ado anyʌñ akappa inwañ fain ado anọ mme atọinwañ mfen e-ediinọ anye udeeme mfịd amọ ke ini idọk.”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yisọs amaabo ammọ, <char style="wj">“Kpaanam ndufo ikoodo ke Ñwed Abasi nte ebo:</char></para>
  <para style="q1" vid="MAT 21:42">
    <char style="wj">“ ‘Itiad a-mme abọbufọk ekesịnne</char></para>
  <para style="q2" vid="MAT 21:42">
    <char style="wj">akappa ado itiad inuuk;</char></para>
  <para style="q1" vid="MAT 21:42">
    <char style="wj">Abọọñ anam ami,</char></para>
  <para style="q2" vid="MAT 21:42">
    <char style="wj">ndin ado utịppe ñkpọ ke anyen ñnyịn’?</char><verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />
    <char style="wj">“Ndin ami idọkkọ ndufo nte ke eyaibọ ndufo abioubọọñ Abasi enọ mbio mfen e-ediinwịm mfịd amọ.</char> <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" /><char style="wj">Awo akeedodo a-aduọhọ ke itiad ami ayaabomo ñkeñe-ñkeñe, ado awo i-itiad ami aduọhọ atọ anye adiinuanuaha.”</char><verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Ke ini mme ñkpoon aku ye mme Farisi ekekoppo mme ñke ami, ammọ emaediọọñọ ke anye aketañ ikọ ami ibaña mmimọ. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Ndin ammọ emaeyem usʌñ naña ekpesaña emʌm anye, ado ammọ emaebaak mme atu awo, sia mme awo ekedat anye nte prọfed.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s1">Ñke Usọrọ Ndọ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yisọs amaamaana atañ ikọ anọ ammọ ke ñke ate, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" /><char style="wj">“Abioubọọñ hefịn atie nte adidem a-akenamma usọrọ ndọ anọ ayịn amọ awodeen.</char> <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" /><char style="wj">Anye amaadọñ nditọufọk amọ ekebo mbon e-emaekekoot usọrọ ete edi, ado ammọ esịn edidi.</char><verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />
    <char style="wj">“Ndin anye amaamaana adọñ nditọufọk e-ekewakka ekan akpa ate, ‘Idọkkọ mbon e-ekekoodo usọrọ ete ke mmenam ndidia mma: E-ewot mme abaakenañ ye ikpọ uman enañ mmi ndin afịd ñkpọ abono ke nde. Idi usọrọ ndọ.’</char><verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />
    <char style="wj">“Ado ammọ ikikpañña utọñ, utu ke ado emaetịmme ekaiya ñkpọ mfen; keed akaa inwañ amọ, mfen akaa ndubeghe idem amọ.</char> <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" /><char style="wj">Mbon ako emaemuum nditọufọk amọ etʌkkọ enyʌñ ewoot ammọ.</char> <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" /><char style="wj">Esịd amaakpakka adidem eti-eti. Anye amaanọ mbon ekọñ amọ ekewoot mme awodawo ado enyʌñ efọp abio ammọ.</char><verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />
    <char style="wj">“Ndin anye amaabo nditọufọk amọ, ‘E-ebeeñe usọrọ ndọ ema, ado mbon se ami ñkekoot ikidotto adidi.</char> <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" /><char style="wj">Ikaa ndin ke mme inuuk efaak ikikoot mme awo akeedodo a-ndufo ekịtte nọ edi usọrọ.’</char> <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" /><char style="wj">Ndin mme nditọufọk amọ emaewuọñọ ekaiya mme efaak ekekoono mme awo akeedodo a-ammọ ekekanna ekịt, nti ye ndiọi, ndin itie usọrọ ndọ amaayọhọ ye isenawo.</char><verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />
    <char style="wj">“Ado ke ini adidem akedʌkkọ adi adikịt mme isenawo, anye amaakịt awo keed i-imiikisịneke afọñ ndọ.</char> <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" /><char style="wj">Ndin anye amaabịp anye ate, ‘Ufan, akesaña die adʌk mmi ke ini mmuusịneke afọñ ndọ?’ Ado awo ami ikikanna isio uyio.</char><verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />
    <char style="wj">“Ndin adidem amaabo mme akpeme itie usọrọ ate, ‘Bọp anye ubọk ye ukod nyʌñ top anye duọọk ke anwa ke ekịm, itie nte ntuaña ye ntaeded ediiba.’</char><verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />
    <char style="wj">“Sia akpesʌkado ekootto uwak awo, ibad-ibad ke emek.”</char><verse eid="MAT 22:14" /></para>
  <para style="s1">Ukpe Taks Nnọọ Ukara Sisa</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Akem mme Farisi emaewuọñọ ekedioomo naña ammọ ediisaña imʌm anye ke ikọ amọ. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Ammọ emaedọñ mme mbed ammọ ye mbon ñka Herọd ekebo anye ete, “Andikpeeb, ñnyịn imidiọọñọ ibo ke afo ado adinen awo, ñko ke afo akpeep usʌñ Abasi akeene akpanikọ. Afo ubaaha awo anyen, sia afo useeghe se awo ado. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Tañ inọ ñnyịn ndin, nsoo ido akikere mfo? Nte anen ñnyịn adikpe taks<note caller="+" style="f"><char style="fr" closed="false">22:17 </char><char style="ft" closed="false">Asaña-asaña taks ukara ake mbon ekebaaha ke idak ukara Sisa ekesikpeeghe, ado mme amanaisọñ Rom ikisikpeeghe</char></note> nnọọ ukara Sisa me inenne?”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Ado Yisọs, sia anye amaakediọọñọ mbubịk esịd ammọ amaabo, <char style="wj">“Ndufo mbon mbubịk, ntak a-ndufo eyemme edintap miin-e?</char> <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" /><char style="wj">Iñwọt akʌk a-ndufo edatta ekpe taks.”</char> Ammọ emaedat denarius esọk anye, <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />ndin anye amaabịp ammọ, <char style="wj">“Ndise anie ido ami? Anyịñ anie ke ewet?”</char><verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Ammọ emaebọọrọ, “Ake Sisa.”</para>
  <para style="p" vid="MAT 22:21">Ndin anye amaabo ammọ, <char style="wj">“Ke ntoro, isaana se ido ake Sisa iyaak inọ Sisa, inyʌñ isaana se ido ake Abasi iyaak inọ Abasi.”</char><verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Ammọ ekekop ami, idem amaakpa ammọ. Ndin ammọ emaedaaña ekpọñ anye.<verse eid="MAT 22:22" /></para>
  <para style="s1">Ndọ ke Ini Adised ke Ñkpa</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Kpa ke usen ado mme Sadusi, i-imiinịmme adised ke ñkpa ke akpanikọ, emaedibịne Yisọs ye mbịme keed, ete, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“Andikpeeb, Moses akibo ñnyịn ate awodeen akpekpa inieghe nditọ, ayịneka amọ ana aben anwaan amọ adọ anyʌñ abon nditọ anọ anye. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Ndin nditọeka ideen itiaba ekeba ke atu ñnyịn. Akpa amaadọ anwaan anyʌñ adikpa, inieghe ayịn. Ndin sia anye mmiikinieghe ayịn, anye amaakpọñ anwaan anọ ayịneka amọ awodeen. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Ukem ñkpọ ami aketịppe anọ ayọhọ ayịneka amọ awodeen iba ye ita tutu akesịm ayọhọ itiaba. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Ke akpatre, awonwaan ado amaadikpa. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Amaaba ntom, ke ini adised ke ñkpa, awonwaan ami adiido anwaan anie awo ke atu nditọeka itiaba ami, sia adooho afịd ammọ emaedọ anye?”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yisọs amaabọọrọ ammọ ate, <char style="wj">“Ndufo emenam ndudue sia ikọ Abasi inwañake ndufo; ndufo inyʌññọ idiọọñọ adudu Abasi.</char> <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" /><char style="wj">Ke ini adised ke ñkpa mme awo idiidọọhọ ndọ, awo idinyʌññọ inọ mme awo ke ndọ. Ammọ ediiba nte mme enyere ke hefịn.</char> <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" /><char style="wj">Ado ke abaña adised ke ñkpa ndufo ikoodo se Abasi akibo ndufo,</char> <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" /><char style="wj">‘Ami ndo Abasi Ebraham, Abasi Aisik, ye Abasi Yekọb?’ Anye idooho Abasi mme akpañkpa, ado Abasi mme aduuwem.”</char><verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Ke ini mme atu awo ekekoppo ami, idem amaakpa ammọ ke ukpeebñkpọ amọ.<verse eid="MAT 22:33" /></para>
  <para style="s1">Akaakan Mbed</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Ke ini mme Farisi emaekekop ke Yisọs amaakʌp mme Sadusi inua, ammọ emaekọọk iwuod atọ keed. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Awo keed ke atu ammọ, ataifiọk mbed, amaadomo anye ye mbịme ami, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Andikpeeb, anye akee ado akaakan ke atu mme Mbed?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Yisọs amaabọọrọ, <char style="wj">“ ‘Ma Abọọñ Abasi mfo ke afịd esịd mfo, ye ke afịd ukpọñ mfo, ye ke afịd akikere mfo.’</char> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" /><char style="wj">Anye ami ado akpa ye akaakan mbed.</char> <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" /><char style="wj">Ayọhọ mbed iba abit akpa: ‘Ma mbọhọidʌñ mfo nte idem mfo.’</char> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" /><char style="wj">Afịd Mbed ye mme Prọfed ekọñọ ke mbed iba ami.”</char><verse eid="MAT 22:40" /></para>
  <para style="s1">Krais Ado Ayịn Anie?</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Ke ini mme Farisi emaekebono keed, Yisọs amaabịp ammọ ate, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" /><char style="wj">“Nsoo ke ndufo ekere ebaña Krais? Anye ado ayịn anie?”</char></para>
  <para style="p" vid="MAT 22:42">Ammọ emaebọọrọ, “Ayịn Defid.”<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Ndin anye amaabo ammọ, <char style="wj">“Asaña die ado Defid, ke atañña ikọ ke adudu Sịbidịd akoot anye ‘Abọọñ’? Sia anye abo ntom,</char><verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />
    <char style="wj">“ ‘Abọọñ amaabo Abọọñ mmi</char></para>
  <para style="q2" vid="MAT 22:44">
    <char style="wj">“Tie ke ubọk nnasia mmi,</char></para>
  <para style="q1" vid="MAT 22:44">
    <char style="wj">tutu ami nsịn mme asua</char></para>
  <para style="q2" vid="MAT 22:44">
    <char style="wj">mfo ke idak ukod mfo.” ’</char><verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />
    <char style="wj">Adieke Defid akoodo anye ‘Abọọñ,’ anye anam die ado ayịn amọ?”</char> <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Awo ndomokeed ikikanna ibọọrọ, ndin tọọñọ ke usen ado awo ndomokeed ikinieghe uko adimaana mbịp anye mbịme mfen aba.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s1">Ndʌdutọñ ke Abaña Mbubịk</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Ndin Yisọs amaatañ ikọ anọ mme atu awo ye mme mbed amọ: <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" /><char style="wj">“Mme andikpeeb mbed ye mme Farisi etie ke ñkpọitie Moses.</char> <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" /><char style="wj">Ke ntoro ana ndufo etʌm ese enyʌñ enam se ammọ idọkkọ ndufo, ado ikiiyak se ammọ enam ado uwọdñkpọ inọ ndufo, sia ammọ inamma se ammọ ekwọrọ.</char> <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" /><char style="wj">Ammọ ebọp udob mbiomo edot mbon mfen ke afara, ado ammọ ke idem ammọ ibeeñeke idem adidịppe nnuun ubọk ammọ keed adinam mme ñkpọ ado.</char><verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />
    <char style="wj">“Afịd ñkpọ se ammọ enam ado nọ ato do mme awo ekịt; nte filakteri, adoho adiwet ikọ Abasi ndian ke akpọiso</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">23:5 </char>
      <char style="ft" closed="false">Ntək akebe se ewet mme ufañ ikọ Abasi edian ke akpọisio ye ke ubọk </char>
    </note> <char style="wj">ñnyʌñ nnam ñkpoon afọñ ubọñ akam ammọ anyọọñ;</char> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" /><char style="wj">ammọ ema itie ukpono ke mme itie usọrọ ye mme ñwuọnda ñkpọitie ke mme sinakọk;</char> <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" /><char style="wj">ammọ ema nọ mme awo ekọọm ammọ ke edu ukpono ke mme anwa udua ye adikoot ammọ, ‘Andikpeeb.’</char><verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />
    <char style="wj">“Ndufo ikiiyak awo ikoot ndufo ‘Andikpeeb,’ sia ndufo enie Andikpeeb keed kpọd, afịd ndufo enyʌñ edo nditọeka.</char> <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" /><char style="wj">Ndufo inaaha ekoot awo ndomokeed ke isọñ ‘ete,’ sia ndufo enie Ete keed kpọd, ndin anye aba ke hefịn.</char> <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" /><char style="wj">Ikiinyʌñ iyak awo ikoot ndufo mme ‘anọitem’ sia ndufo enie Anọitem keed kpọd, a-adooho Krais.</char> <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" /><char style="wj">Andikpon ñkan ke atu ndufo ana ado ayịnufọk ndufo.</char> <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" /><char style="wj">Awo akeedodo a-akokkoke idem amọ eyaesuuhọ anye, ñko awo a-asuuhọke idem amọ eyaebenne anye.</char><verse eid="MAT 23:12" /></para>
  <para style="s1">Isuuñọ Itiaba a-Asịmme mme Akpeeb Mbed ye mme Farisi</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />
    <char style="wj">“Adọdiọọk inọ ndufo mme ntaifiọk mbed ye mme Farisi, ndufo mbon mbubịk! Ndufo emekʌk udọk abioubọọñ hefịn ebaha mbon awo. Ndufo ke idem ndufo idʌkkọ, inyʌññọ iyak mbon mfen e-eyemme edidʌk eboiyo edʌk.</char> [<verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" /><char style="wj">Adọdiọọk inọ ndufo mme akpeeb mbed ye mme Farisi, ndufo mbon mbubịk! Ndufo ema adifiik mme ebekpa mbọọ ufọk, enyʌñ ewọt idem ke adibọñ ñnyan akam. Ke ntoro, ndufo eyaenekke ebọ akpọsọñ ufen.</char>]<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">Usʌk mme ikpañwed esịn mme ikọ se iba ke Maak 12:40 ye Luk 20:47.</char></note><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />
    <char style="wj">“Adọdiọọk inọ ndufo mme akpeeb mbed ye mme Farisi, ndufo mbon mbubịk! Ndufo esaaña ke mmọọñ ye ke abod eyem ukpọk awo keed se enam nọ akappa esịd ikeene ndufo, ado awo amaakappa esịd, ndufo e-enam anye adọdiọọk ñkemba adot se adʌk ikañ nsi-nsi nte ndufo ke idem ndufo.</char><verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />
    <char style="wj">“Adọdiọọk inọ ndufo mme nnan adadusʌñ! Ndufo esibo, ‘Awo akpenwọñọ unwọñọ ke tembịd ke iwuọñọke ñkpọ ndomokeed, ado akpenwọñọ ke kold a-tembịd, ke unwọñọ ado abọp anye.’</char> <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" /><char style="wj">Ndufo mme ndisịme ye mme nnan! Akee akpon ekọmudua akan: kold me tembịd a-anamma kold ado adisana?</char> <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" /><char style="wj">Ndufo emaana ebo, ‘Adieke awo anwọñọke unwọñọ ke itie uwa, ado iwuọñọke ñkpọ ndomokeed, ado awo ndomokeed a-anwọñọke ñkpọ ke enọ a-adoroke ke itie uwa, unwọñọ ado abọp anye.’</char> <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" /><char style="wj">Ndufo mme nnan! Akee akpon akan; enọ me itie uwa a-anamma nọ enọ ado adisana?</char> <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" /><char style="wj">Ke ntoro, awo akeedodo anwọñọke ke anyịñ itie uwa, anwọñọ ye afịd ñkpọ se idoro ke anye.</char> <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" /><char style="wj">Ñko, awo akeedodo anwọñọke ke anyịñ tembịd anwọñọ ke tembịd ado ye anye a-adʌññọ do.</char> <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" /><char style="wj">Ñko awo akeedodo anwọñọke ke hefịn, anwọñọ ke ebekpo Abasi ye anye a-atieghe do.</char><verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />
    <char style="wj">“Adọdiọọk inọ ndufo, mme akpeeb mbed ye mme Farisi, ndufo mbon mbubịk! Ndufo esikpe utịb tembịd mbakka keed ke itie duob ekewuọ ataa akpatre mfañ ke inwañ, ado etre ataa akpan ñkpọ ke mbed a-abañake unen, mbọm ye mbuọdidem. Akpena ndufo ekpe utịb tembịd, ado ikpinaaha etre edinam mme ñkpọ se ikap ikpokpon ikan ami.</char> <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" /><char style="wj">Ndufo mme nnan adadusʌñ! Ndufo emedʌkkọ nsʌñ esio ke ukọd, ado eben kamel emen.</char><verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />
    <char style="wj">“Adọdiọọk inọ ndufo mme akpeeb mbed ye mme Farisi, ndufo mbon mbubịk! Ndufo eyet edem kọọb ye edem usan ndufo asana ado eyaak esịd ayọhọ ye idiọọkitọñ ye adinọ idem ndufo inemesịd.</char> <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" /><char style="wj">Nnan Farisi! To yet esịd kọọb ye esịd usan, ndin edem ayaanyʌñ asana.</char><verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />
    <char style="wj">“Adọdiọọk inọ ndufo mme akpeeb mbed ye mme Farisi, ndufo mbon mbubịk, ndufo eba nte mme itiad udi edeppeke, a-adoro ayaiyake, ado esịd ayọhọ ye akpọ mme akpañkpa ye afịd mme ndedeghe ñkpọ.</char> <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" /><char style="wj">Ke ukem usʌñ ami ke ido ndufo ke anwa abit mme ndinen awo, ado esịd ndufo eyọhọ ye mbubịk ye ibak.</char><verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />
    <char style="wj">“Adọdiọọk inọ ndufo mme akpeeb mbed ye mme Farisi, ndufo mbon mbubịk, ndufo ebọp mme itiad udi enọ mme prọfed enyʌñ ebana mme itiad udi ndinen awo.</char> <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" /><char style="wj">Ndin ndufo ebo, ‘Ñnyịn ikpikikeeneke iwuana ke uduọk iyiib mme prọfed akpedo ñnyịn imaiba ke ayio mme eteete ñnyịn.’</char> <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" /><char style="wj">Ke ndufo editie ntiense ntom, ndufo emebiom idem ndufo ikpe nte ke edoñño nditọ mbon e-ekewotto mme prọfed.</char> <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" /><char style="wj">Ika iso ndin, inyʌñ inam ndiọi ubọkutom a-mme eteete ndufo eketọọñọke ima!</char><verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />
    <char style="wj">“Ndufo mme udʌkikọd! Ndufo mme nditọ udʌkikọd! Ediinam die ibọkkọ ubiomikpe nsi-nsi ikañ?</char> <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" /><char style="wj">Ke ntak ado ke ami ndọñ mme prọfed, ntaifiọk ye mme andikpeeb inọọ ndufo. Ubaak ammọ ndufo eyaewoot enyʌñ ekọọñ ke eto; usʌk ndufo eyaemia ke mme sinakọk ndufo enyʌñ edubịnne usʌk ke abio ke abio.</char> <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" /><char style="wj">Ndin afịd iyiib mme ndinen awo se eduọk ke ederimbod eyaidoro ndufo ke iwuod, tọọñọ ke iyiib Ebeel, a-akedooho adinen awo tutu asịm iyiib Sakaraiya, ayịn Berekia, a-ndufo ekewotto ke ufọọd tembịd ye itie uwa.</char> <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" /><char style="wj">Ami ntañ akpanikọ inọ ndufo, afịd ñkpọ ami adiidoro emana ami ke iwuod.</char><verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />
    <char style="wj">“O Yeruselem, O Yeruselem, ndufo e-ewotto mme prọfed enyʌñ etọọñ mbon e-enọọhọ isọk ndufo ke itiad, akañ ifañ ke ami ñyem adikoot nditọ ndufo mbok itie keed, nte eka unen abok nditọ ke idak mba amọ, ado ndufo inyịmmeke.</char> <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" /><char style="wj">Sese, eyaak ñwuudo ufọk ndufo inọ ndufo.</char> <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" /><char style="wj">Sia ami ntañ inọ ndufo, ndufo idiñkịtte miin aba tutu ndufo ebo, ‘Afọfọn anọ anye a-adiighe ke anyịñ Abọọñ.’ ”</char><verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">Uwuud Tembịd ye mme Idiọọñọ Utịd Ayio</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Ke ini Yisọs akesʌkkọ asaña awuo akpọñ tembịd, mme mbed amọ emaedikoot anye ewọt mme ufọk ke tembịd. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Anye amaabịp ammọ ate, <char style="wj">“Ndufo emekịt afịd mme ñkpọ ami? Ami ntañ akpanikọ inọ ndufo, itiad ndomokeed mi idiidoroke ke itiad mfen; eyaetoomo afịd ammọ eduọọñọ ke isọñ.”</char><verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Naña Yisọs aketieghe ke Abod Ọlif mme mbed emaedibịne anye ndịbe-ndịbe ekebịp anye ete, “Tañ inọ ñnyịn, idaha akee ke ñkpọ ami adiitịppe, nsoo idiinyʌñ ido idiọọñọ adidi mfo ye utịd ayio?”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yisọs amaabọọrọ ate, <char style="wj">“Inekke ikpeme mbaak awo ndomokeed adibiaña ndufo.</char> <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" /><char style="wj">Sia uwak eyaedi ke anyịñ mmi edibo, ‘Ami ndo Krais,’ eyaenyʌñ ebiaña uwak awo.</char> <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" /><char style="wj">Ndufo eyaekop ebaña ekọñ ye etob ekọñ, ado ikịt ebo ke esịd ndufo itịmekede. Mme ñkpọ ntoro ana etịppe, ado utịd idiidiighe diin.</char> <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" /><char style="wj">Idịd ayaanwana ye idịd, abioubọọñ ayaanwana ye abioubọọñ. Akañ ye unyeñisọñ eyaebañña ke uwak itie.</char> <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" /><char style="wj">Afịd ami edoñño ntọọñọ ubiak uman.</char><verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />
    <char style="wj">“Ndin eyaikappa ndufo enọ mbio e-ediitʌkkọ inyʌñ iwoot ndufo, ñko afịd idịd eyaisua ndufo ke ntak anyịñ mmi.</char> <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" /><char style="wj">Ke ini ado uwak awo eyaekpọñ mbuọdidem, etap emọ-emọ enọ, enyʌñ edusuara idem ammọ.</char> <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" /><char style="wj">Uwak prọfed nsu eyaewuọñọ edi enyʌñ edibiaaña uwak awo.</char> <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" /><char style="wj">Ke ntak adooho ibak ayaatọt, ima ataa uwak awo ayaadeññe,</char> <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" /><char style="wj">ado awo a-asọọñọke ada akewuọ utịd ayaanie adinyaaña.</char> <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" /><char style="wj">Ndin eyaekwọrọ eti etob abioubọọñ ami ke afịd ederimbod nte ntiense enọ afịd idịd. Idaha ado ndin ke utịd adiidi.</char><verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />
    <char style="wj">“Ndin umaukịt nte, ‘mbubiam ñkpọ a-adatta nsobo adi,’ ada ke adisana itie, naña prọfed Dandiel aketañ, yak akood ñwed adiọọñọ,</char> <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" /><char style="wj">ndin yak mbon se iba ke Yudia efeeñe ekaiya mme ñkpoon abod.</char> <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" /><char style="wj">Ke awo ndomokeed a-adoroke ke anyọñ akọm ufọk asọiyọ akaa adikisio ñkpọ ke ufọk ado.</char> <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" /><char style="wj">Ke awo ndomokeed a-abaaha ke inwañ atịmme akaa adikidat afọñ anyọñidem amọ.</char> <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" /><char style="wj">Ado, mbọm ibaan e-esañake ye idịb ye ibaan mbon e-esʌkkọ enọnọ mme nsekayịn eba ke utọ mme usen ado!</char> <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" /><char style="wj">Ibọñ akam ibo adifeghe ndufo akuudo ke ini akpọsọñ atueb me ke usen Sabad.</char> <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" /><char style="wj">Sia ke ini ado akpọsọñ ukuud ayaaba adooho akenanam ibaaha, ñko idiinyʌññọ ibaba tọọñọ ke aditọọñọ ederimbod tutu idahami.</char><verse eid="MAT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 24:22" />
    <char style="wj">“Awo miikpikinamma mme usen ado aməho, awo ndomokeed ikpibọkkọke; ado ke ntak mme andimek Abasi, eyaenam mme usen ado aməho.</char> <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" /><char style="wj">Ke ini ado awo ndomokeed akpibo ndufo, ‘Se mi, se Krais mi!’ me, ‘Se anye ko!’ ikiinịm ke akpanikọ.</char> <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" /><char style="wj">Sia mme nsu-nsu Krais ye mme prọfed nsu eyaewuọñọ edi edinañña mme ñkpoon idiọọñọ ye mme utịppeñkpọ nọ ebiaña mbon awo, adieke ammọ ekanna, kpa mme ndimek ikọd Abasi.</char> <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" /><char style="wj">Se, mmebabak idọkkọ ndufo do mbemiso ini ado.</char><verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />
    <char style="wj">“Ndin awo ndomokeed akpidọkkọ ndufo, ‘Se anye ko ke anaan,’ ikiika do. Akpedo ebo, ‘Se anye mi, ke mme esịd ubeed,’ ikiinịm ke akpanikọ.</char> <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" /><char style="wj">Sia kpa naña eda ke usobutịn ekịt akebkeb a-asakkake ato usakkautịn, kpa ntoro ke adidi Ayịn Awo adiiba.</char> <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" /><char style="wj">Itie akeedodo a-akpo ñkpọ anaaha, kpa ndo ke mme utere ediikiboho.</char><verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />
    <char style="wj">“Ndutʌhọ ini ado amaasʌk ikwekweeñe,</char></para>
  <para style="q1" vid="MAT 24:29">
    <char style="wj">“ ‘utịn ayaabre,</char></para>
  <para style="q2" vid="MAT 24:29">
    <char style="wj">afiọñ idiinọọhọ unwana amọ aba,</char></para>
  <para style="q1" vid="MAT 24:29">
    <char style="wj">mme ntantaafiọñ eyaeduọññọ eto ikpaanyọñ ke isọñ,</char></para>
  <para style="q2" vid="MAT 24:29">
    <char style="wj">ndin eyaenyeeñe mme adudu e-ebaaha ke hefịn.’</char><verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />
    <char style="wj">“Ke ini ado idiọọñọ Ayịn Awo ayaawuọ ada ke hefịn. Ndin afịd uduod awo ke ederimbod</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">24:30 </char>
      <char style="ft" closed="false">Akeme ido mme ubon abio ado</char>
    </note> <char style="wj">eyaefʌhọ ke ammọ emaekịt Ayịn Awo naña adi ke ntọñanyọñ hefịn ke adudu ye ekamba ubọọñ.</char> <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" /><char style="wj">Anye ayaadọñ mme enyere amọ edifịt adukpoñ ke akpọsọñ uyio enam ikood, ndin ammọ eyaekoono mme andimek ikọd amọ eto ke afịd inuuk afịm inaañ tọọñọ ke utịd mme hefịn keed tutu awuọ utịd uko.</char><verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />
    <char style="wj">“Ndin, ndufo idat ukpeebñkpọ ito eto fik: Ke ado anye amaasịññe nseghe ñkọk, amaana ko mme mfañ ewuọñọ, ndin edat ado ediọọñọ ke ndaayio akpere.</char> <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" /><char style="wj">Kpayeado ndufo emaekịt afịd mme ñkpọ ami, eyaediọọñọ ebo ke ini</char><note caller="+" style="f"><char style="fr" closed="false">24:33 </char><char style="ft" closed="false">Akeme ido etañ ebaña awodeen</char></note> <char style="wj">akpere, mmọdo kpa ke inuausʌñ.</char> <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" /><char style="wj">Ntañ akpanikọ inọ ndufo, emana ami idiiboiyoke ifep tutu mme ñkpọ ami etịppe.</char> <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" /><char style="wj">Anyọñ ye isọñ eyaeboiyo efep, ado mme ikọ mmi tutu amama idiiboiyoke ifep.</char><verse eid="MAT 24:35" /></para>
  <para style="s1">Awo Idiọọñọke Usen ye Awa</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />
    <char style="wj">“Amaado usen ado, me awa ñkanika ado, awo ndomokeed idiọọñọke; kpa mme enyere ke hefịn, me Ayịn,</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">24:36 </char>
      <char style="ft" closed="false">Usʌk mme ikpañwed inieghe </char>
      <char style="fqa" closed="false">me Ayịn awodeen.</char>
    </note> <char style="wj">ke imiibọhọke Ete ikpọọñ.</char> <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" /><char style="wj">Naña akeba ke ayio Nua, kpa ntoro ke adiiba ke adidi Ayịn Awo.</char> <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" /><char style="wj">Sia ke ini ado mbemiso mmọọñ ukwọ, mme awo ekesʌk edọ ndọ, enyʌñ enọ ke ndọ tutu usen a-Nua akedʌkkọ ubom;</char> <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" /><char style="wj">ndin ammọ ikidiọọñọke ñkpọ ndomokeed ibaña se idiitịppe tutu mmọọñ ukwọ adibeen afịd ammọ afep. Kpa ntoro ke adiiba ke adidi Ayịn Awo.</char> <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" /><char style="wj">Ideen iba eyaeba ke inwañ, ado eyaeben keed ekpọñ añko.</char> <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" /><char style="wj">Ibaan iba ediisʌk ikọk ñkpọ ke itie ukọkñkpọ, ado eyaeben keed, ekpọñ keed.</char><verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />
    <char style="wj">“Ke ntoro ikpeme, sia ndufo idiọọñọke me nsoo usen ke Abọọñ ndufo adiidi.</char> <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" /><char style="wj">Ado idiọọñọ ntom: Adieke anieufọk akpekediọọñọke ini akonayio i-inọ adiidi ufọk amọ, anye akpaakekpeme ufọk amọ, ndin ikpikiyakka nọ inọ adʌk.</char> <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" /><char style="wj">Ndin ana ndufo ñko ebeeñe idem, sia Ayịn Awo adiidi ke awa a-ndufo mmiibeeñeke ibed anye.</char><verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />
    <char style="wj">“Anie awo ndin ado anam akpanikọ ye anie aniọñ ayịnufọk e-eteufọk amọ anịmme ke iwuod mme nditọufọk mfen ke afịd ufọk amọ nọ anye asinọ ammọ ndidia ke akemini?</char> <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" /><char style="wj">Adiifọfọn inọ ayịnufọk e-eteufọk amọ adiidikịt anye naña anam utom amọ, ke eteufọk amọ amaanyọñ idi.</char> <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" /><char style="wj">Ntañ akpanikọ inọ ndufo, anye ayaanịm anye nte akpeme afịd inie amọ.</char> <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" /><char style="wj">Ado akpedo ayịnufọk ami ado awo ibak ye mbubịk, ndin anye abo idem amọ, ‘Eteufọk mmi ayaakekpeene,’</char> <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" /><char style="wj">ndin anye atọọñọ adifiomo emọ-emọ nditọufọk, adia ñkpọ anyʌñ anwọñ ñkpọ ye mme akpammịn.</char> <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" /><char style="wj">Eteufọk amọ ayaanyọñ adi ke usen ayịnufọk ami mmiikibekke anyen ye ke awa a-anye miidiọọñọke.</char> <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" /><char style="wj">Eteufọk amọ ayaamia anye ñkpa-ñkpa, anyʌñ anọ anye aka itie mbon mbubịk, nte ntuaña ye ntaeded ediiba.</char><verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">Ñke a-Abañake mme Ubọikpa Duob</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />
    <char style="wj">“Ke ini ado abioubọọñ hefịn adiiba nte ubọikpa duob e-ekebenne utuenikañ ammọ ewuọñọ eka adikikịt ebendọ.</char> <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" /><char style="wj">Ition ke atu ammọ ekedo ndisịme, ition edoñño mme adiọọñọidem.</char> <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" /><char style="wj">Akpesʌkado a-mme ndisịme ekekamake mme utuenikañ, ammọ ikikamake adan ikañ.</char> <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" /><char style="wj">Ado mbon aniọñ emaekama adan ikañ ke iko ye ke utuenikañ ammọ.</char> <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" /><char style="wj">Ebendọ amaabiat ini adidi, ndin idab amaabọkkọ ammọ.</char><verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />
    <char style="wj">“Ado ke ufọọd akonayio, emaebọñ ñkpọ, ‘Sese ebendọ! Iwuọñọ ikaa ikisoobo ye anye!’</char><verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />
    <char style="wj">“Ndin afịd ubọikpa emaedemme ke idab enyʌñ esịññe inua afọñ utuenikañ ammọ.</char> <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" /><char style="wj">Ndin mme ndisịme emaebo mme adiọọñọidem, ‘Inọ ñnyịn etək adan ikañ sia utuenikañ ñnyịn eyaeniime.’</char><verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />
    <char style="wj">“Ado ammọ emaebọọrọ, ‘Iyoo, adan ikañ idiikemme ñnyịn ye ndufo. Akpaafọn ndufo eka ebịne mme anyam adan ekedep.’</char><verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />
    <char style="wj">“Ado idaha ammọ ekaiyake adidep adan ikañ, ebendọ amaadiwuọ. Mbon e-ekebeeñeke idem emaedʌk ufọk usọrọ ndọ ye anye, ndin emaekʌk usʌñ.</char><verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />
    <char style="wj">“Akema mme ubọikpa mbon ako emaediwuọ enyʌñ ebo, ‘Abọọñ, Abọọñ, kʌkkọ usʌñ inọ ñnyịn!’</char><verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />
    <char style="wj">“Ado ebendọ amaabọọrọ, ‘Ke akpanikọ ke idọkkọ ndufo, ami idiọọñọke ndufo.’</char><verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />
    <char style="wj">“Ke ntoro, itaba idab ikpeme, sia ndufo idiọọñọke usen me awa.</char><verse eid="MAT 25:13" /></para>
  <para style="s1">Ñke a-Abañake mme Ekpad Kold</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />
    <char style="wj">“Ñko, abioubọọñ hefịn adiiba nte awo a-akaaha isañ, a-akekoodo mme nditọufọk amọ anyʌñ ayaak inie amọ anọ ammọ.</char> <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" /><char style="wj">Awo keed, anye amaanọ ekpad kold ition, mfen ekpad iba, ayọhọ ita ekpad</char><note caller="+" style="f"><char style="fr" closed="false">25:15 </char><char style="ft" closed="false">Ke usem Krik </char><char style="fqa" closed="false">talen ition … </char><char style="fqa" closed="false">talen iba … talen keed</char><char style="ft" closed="false">; ñko ke afịd ñke ami; talen keed akedo akʌk utom usen debra ke isua edịb. </char></note> <char style="wj">keed, kwa awo naña ukeme ammọ ado. Ndin anye amaadakka akaa isañ.</char> <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" /><char style="wj">Awo a-akebọọhọ ekpad kold ition amaasọp aketọọñọ ubịn udua, anyʌñ anie ekpad kold ition mfen nte udod.</char> <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" /><char style="wj">Awo a-akebọọhọ ekpad iba, amaanyʌñ anam udod ekpad iba ke ukem usʌñ ado.</char> <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" /><char style="wj">Ado awo a-akebọọhọ ekpad keed, amaakaa aketịppe isọñ adịp akʌk eteufọk amọ.</char><verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />
    <char style="wj">“Ke anyan ini amaakeboiyo, eteufọk ammọ amaato adi, adiduuñọ ñwed ibad akʌk ye ammọ.</char> <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" /><char style="wj">Awo a-akebọọhọ ekpad kold ition amaaben ekpad ition mfen adi anyʌñ adibo ate, ‘Ete, afo akennọ ekpad kold ition, se ition mfen se ami ñkenwana mi.’</char><verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />
    <char style="wj">“Eteufọk amọ amaabọọrọ, ‘Amenam afọn, eti anam akpanikọ ayịnufọk! Afo amenam akpanikọ ke ntək ñkpọ; ami ñyaunọ fiin se ikpon ikan ami. Di diwana ke inemesịd eteufọk mfo!’</char><verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />
    <char style="wj">“Awo a-akebọọhọ ekpad kold iba amaanyʌñ adi adibo, ‘Eteufọk, afo akennọ ekpad kold iba, se iba mfen se ami ñkenwana mi.’</char><verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />
    <char style="wj">“Eteufọk amọ amaabọọrọ, ‘Amenam afọn, eti anam akpanikọ ayịnufọk! Afo amenam akpanikọ ke ntək ñkpọ; ami ñyaunọ fiin se ikpon ikan ami. Di diwana ke inemesịd eteufọk mfo!’</char><verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />
    <char style="wj">“Ke akpatre, awo e-ekenọọhọ ekpad kold keed amaawuọ adi adibo eteufọk ate, ‘Ete, ami mmaadiọọñọ ke afo ado akpọsọñ awo a-adọkkọ ke itie afo umuutọọhọ, anyʌññọ akoono ke itie afo umuukubonoke.</char> <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" /><char style="wj">Ke ntoro, ami mmaakop ndịk, ndin ami mmaakaa ñkedịp ekpad kold mfo ke isọñ. Se anye mi, ake mfo kedo, mbọ do.’</char><verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />
    <char style="wj">“Ado eteufọk amọ amaabọọrọ anye ate, ‘Afo ibak, ifu ayịnufọk! Awuọ afo amaadiọọñọ ke ami nsidọk ke itie a-ami mmeñketọọhọ ñnyʌñ ñkoono ke itie a-ami mmeñkebonoke?</char> <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" /><char style="wj">Ndin akpekena afo aben akʌk mmi akenọ mme akamakʌk; a-ami ntooho ndi mi ñkpaabọ akʌk mmi ye udod.</char><verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />
    <char style="wj">“ ‘Ndin idahami, bọ anye ekpad kold ami kappa nọ awo se inie ekpad duob.</char> <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" /><char style="wj">Sia awo akeedodo a-anieghe ñkpọ eyaenọ anye awak akan ado, ñko anye ayaanie akan se ikem anye. Awo akeedodo idiinieghe ñkpọ, eyaebọ etək se anye anenie.</char> <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" /><char style="wj">Amaado ayịnufọk i-imiifọnnọ ke usʌñ ndomokeed, top anye duọọk ke anwa, ke ekịm, ke itie ntuaña ye ntaeded ediiba.’</char><verse eid="MAT 25:30" /></para>
  <para style="s1">Mme Edọñ ye Ebod</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />
    <char style="wj">“Ayịn Awo amaadi ke ubọọñ amọ, ye afịd mme enyere amọ, anye ayaadat itie amọ ke ebekpo ubọọñ amọ.</char> <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" /><char style="wj">Eyaebək afịd idịd ke iso amọ, ñko anye ayaabakka mme awo nte akpemeedọñ abakka edọñ ye ebod.</char> <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" /><char style="wj">Anye ayaabon mme edọñ ke ubọk nnasia anyʌñ abon mme ebod ke ufiin.</char><verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />
    <char style="wj">“Ndin Adidem ayaabo mbon e-ebaaha ke ubọk nnasia amọ ate, ‘Idi ndufo ake Ete mmi adiọññọ, idat ñkpọ adiaakpa ndufo, abioubọọñ e-ekenịmme inọọ ndufo tọọñọ ke ntọọñọ ederimbod.</char> <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" /><char style="wj">Sia ndufo emaennọ miin ndidia idaha abiọọñ akendọññọ, idaha itọñ akensatta, ndufo emaennọ miin ñkpọ ñnwọñ, emaenyʌñ endaara miin esịn ke atu ndufo ke idaha a-ami ñkedooho asenawo.</char> <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" /><char style="wj">Idaha a-ami ñkenanake afọñ ndufo emaennọ miin afọñ; idaha a-ami ñkedọñọke, ndufo emaese ñkpọ embaña miin; idaha a-ami ñkesịneke ke ñkpakọb, ndufo emaenyʌñ edinse miin.’</char><verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />
    <char style="wj">“Ndin ndinen awo eyaebọọrọ anye ebo: ‘Abọọñ, idaha akee ke ikukịt nte abiọọñ udọñ ndin ñnyịn unọ ndidia, me itọñ akusat ndin ñnyịn unọ ñkpọ anwọñ?</char> <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" /><char style="wj">Idaha akee ke afo akedo asenawo ndin ñnyịn udaara fiin, me nte anana afọñ ndin ñnyịn unọ afọñ?</char> <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" /><char style="wj">Idaha akee ke afo akedọñọ me akesịne ke ñkpakọb ndin ñnyịn iduse fiin?’</char><verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />
    <char style="wj">“Ndin Adidem ayaabọọrọ, ‘Ke akpanikọ ke idọkkọ ndufo, kpa nte ekenamma enọọ keed ke atu nditọeka mmi, ekenam ennọ miin?’</char><verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />
    <char style="wj">“Ndin anye ayaabo mbon se iba ke ubọk ufiin amọ ate, ‘Indakka miin ke iso, ndufo mbon isuuñọ, ikaa ke nsi-nsi ikañ e-ekebarake enịm enọ setan ye mme enyere amọ.</char> <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" /><char style="wj">Sia abiọọñ amandọñ miin, ado ndufo ikinnọọhọ ndidia, itọñ amansat, ado ndufo ikinnọọhọ ñkpọ ndomokeed nọ ñnwọñ.</char> <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" /><char style="wj">Ami ñkedo asenawo, ado ndufo ikindarake miin; ami mmaanana afọñ ado ndufo ikinsịnne miin afọñ; ami mmaadọñọ ñnyʌñ mba ke ñkpakọb ado ndufo ikidinseeghe miin.’</char><verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />
    <char style="wj">“Ammọ ñko eyaebọọrọ, ‘Abọọñ, idaha akee ke ñnyịn ikikịt naña abiọọñ udọñ me itọñ usat me nte asenawo me anana afọñ me adọọdọñọ me aba ke ñkpakọb, ndin ñnyịn unwamma fiin?’</char><verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />
    <char style="wj">“Ndin anye ayaabọọrọ ammọ, ‘Ke akpanikọ ke idọkkọ ndufo, kpa naña ndufo eketre adinam ami nnọọ keed ke atu ntək-ntək ami, ndufo eketre adinam innọọ miin.’</char><verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />
    <char style="wj">“Ndin ammọ eyaedʌk ke nsi-nsi ufen, ndin ndinen awo eyaedʌk ke nsi-nsi uwem.”</char><verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">Edʌk Idiọọk Edioomo Ebaña Yisọs</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Ke Yisọs amaaketañ afịd ñkpọ ami ima, anye amaabo mme mbed amọ ate, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" /><char style="wj">“Nte ndufo ediọọñọke, Usọrọ Nsaña Mboiyo ayaaba ke usen iba ke iso, ndin eyaeyaak Ayịn Awo enọ nọ ekọñ ke krọs.”</char><verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Akem mme ñkpoon aku ye mme ñkpisọñ ammọ emaebono ke akwere ekamba aku, a-akekereke Kaifas. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Ammọ emaedioomo adimʌm Yisọs ke ndịbe ñnyʌñ ñwot anye. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Ammọ emaebo ete, “Ado idiidooho ke ini usọrọ ami, mmiidooho, mme awo ekeme adisịn ntịme.”<verse eid="MAT 26:5" /></para>
  <para style="s1">Eyet Yisọs Adan ke Betani</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Idaha a-Yisọs akesʌkkọ aba ke Betani ke ufọk Saimọn awo Akpamfia, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />awonwaan keed amaadʌk abịne anye, akama atu adan alabasta, ye ataa nsọñudua pefium, a-anye akeduọkkọ Yisọs ke iwuod ke ini anye akesʌkkọ anyʌkkọ abere ke akpokoro.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Ke ini mme mbed ekekịtte ami, esịd amaadiọọk ammọ eti-eti. Ammọ emaebịp ete, “Ntak ebahake adan ami-e? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Adan ami ado se ekpenyam nsọñudua enyʌñ eben akʌk ado enọ mme uweene.”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Ke Yisọs amaakediọọñọ ami, anye amaabịp ammọ, <char style="wj">“Ntak a-ndufo efịnake awonwaan ami-e? Anye anam ñkpọ a-ayaiyake annọ miin.</char> <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" /><char style="wj">Mme uweene ediisʌk ibaba ye ndufo, ado ami ndiibaaha ye ndufo afịd ini.</char> <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" /><char style="wj">Ke ini anye amfiọññọke pefium ami ke idem, anye akenam ami adimbeeñe miin idem nnọọ ini e-ediimbuuk miin.</char> <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" /><char style="wj">Ami ntañ akpanikọ inọ ndufo, itie akeedodo e-ediikwọrọ eti etob ami ke afịd ederimbod eyaetañ se anye anam ami ke edidat ado ntoiyo anye.”</char><verse eid="MAT 26:13" /></para>
  <para style="s1">Yudas Anyịmme Aditap Yisọs</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Akekem keed ke atu mme mbed duob mme iba amọ, anye e-ekekoodo Yudas Iskariọd, amaabịne mme ñkpoon aku <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />anyʌñ akebịp ammọ ete, “Nsoo ke ndufo enyịmme adinnọ adieke ntappa anye inọọ ndufo?” Ndin ammọ emaebat mbaak akpoho silfa edịb mme duob enọ anye. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Tọọñọ ke ini ado Yudas amaayep ufañ a-anye adiitap Yisọs inọ ammọ.<verse eid="MAT 26:16" /></para>
  <para style="s1">Akpatre Ndidia Ndubi</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Ke akpa usen Usọrọ Uyo a-yiis imiisịneke, mme mbed emaedibịne Yisọs enyʌñ ekebịp anye ete, “Ke mmọọ ke afo abo ñnyịn ibeeñe idem unọ fiin nọ adia Usọrọ Nsaña Mboiyo?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Anye amaabọọrọ ammọ ate, <char style="wj">“Ikaa abio ikikịt awodeen keed inyʌñ idọkkọ anye ete, ‘Andikpeeb abo: Ini e-ekenịmme ennọọ akpere. Ami ndiidia Usọrọ Nsaña Mboiyo ye mbed mmi ke ufọk mfo.’ ”</char> <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Ke ntoro mme mbed emaenam naña Yisọs akebo ammọ enam, emaenyʌñ enam mbeeñeidem enọ Usọrọ Nsaña Mboiyo.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Akediwuọ ndubiayio, Yisọs amaanyʌkkọ abere ke akpokoro ndidia ye mme mbed amọ duob mme iba. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Ndin ke ini ammọ ekesʌkkọ edia ñkpọ, anye amaabo, <char style="wj">“Ntañ akpanikọ inọ ndufo, awo keed ke atu ndufo ayantap miin.”</char><verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Ammọ emaefʌhọ eti-eti, emaenyʌñ etọọñọ adibịp anye keedekeed, “Abọọñ, mmenịm ke idooho ami ke akọm?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Yisọs amaabọọrọ, <char style="wj">“Andisịn ubọk amọ ke usan ndidia ye ami adintap.</char> <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" /><char style="wj">Ayịn Awo ana anyọñ, kpa naña ewet ebaña anye. Ado adọdiọọk anọ awo a-adiitap Ayịn Awo. Akpaakefọn ye awo ado adieke anye imiikpikimanakemana.”</char><verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Ndin Yudas, anye a-adiitap anye, amaabo, “Andikpeeb, mmenịm ke idooho ami ke atañ abaña?”</para>
  <para style="p" vid="MAT 26:25">Yisọs amaabọọrọ anye ate, <char style="wj">“Afo ado anditañ ntoro.”</char><verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Ke ini ammọ ekesʌkkọ edia ñkpọ, Yisọs amaaben uyo, ndin ke anye amaakenọ ekọọm ima, anye amaabuuñ anyʌñ anọ mme mbed amọ, abo <char style="wj">“Ibọ ita; ami ado ikpọkidem mmi.”</char><verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Akem anye amaaben kọọb, ke anye amaakenọ Abasi ekọọm, anye amaakpọñ anọ ammọ ate, <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" /><char style="wj">“Inwọñ ami, afịd ndufo, ami ado iyiib</char><note caller="+" style="f"><char style="fr" closed="false">26:28 </char><char style="ft" closed="false">Usʌk mme ikpañwed ebo </char><char style="fqa" closed="false">ufa ado</char></note> <char style="wj">mmi, iyiib edioomo eduọkkọ enọ uwak awo nọ efeen mme idiọọkñkpọ.</char> <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" /><char style="wj">Tọọñọ ke idahami, ami ibo ndufo ke ami ndiinwọññọ se ito mfịd fain ami aba tutu usen ado akem a-ndiinwọñ anye ufa ye ndufo ke abioubọọñ Ete mmi.”</char><verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Ke ammọ emaekekwọ ikwọ ima, afịd ammọ emaewuọñọ ekaa Abod Ọlif.<verse eid="MAT 26:30" /></para>
  <para style="s1">Yisọs Ayaara ke Pita Ayaikañ Imọ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Ndin Yisọs amaabo ammọ ate, <char style="wj">“Kpa ke akonayio ami afịd ndufo eyaeduọọk mbuọdidem ke idem mmi, e-efeeñe eñkpọñ, sia ewet ete:</char></para>
  <para style="q1" vid="MAT 26:31">
    <char style="wj">“ ‘Ami ñyaayʌppọ akpemeedọñ,</char></para>
  <para style="q2" vid="MAT 26:31">
    <char style="wj">ndin mme atu edọñ eyaesuana.’</char><verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />
    <char style="wj">Ado ami mmaaset ke ñkpa, ami ñyaibem ndufo iso ñkaa Kalili.”</char><verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Pita amaabọọrọ anye ate, “Afịd awo ekpeduọduọọk mbuọdidem ke idem mfo, efeghe ukpọñ fiin, ami ndiifegheke.”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Yisọs amaabọọrọ anye ate: <char style="wj">“Ntañ akpanikọ unọ fiin, idem akonayio ami, mbemiso akikọunen akpọk, afo ayañkañ miin akañ ita.”</char><verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Pita amaabo anye ate, “Akpekọm awuọñọ ami adikpa ye afo, ami nduukañña fiin.” Ndin afịd mme mbed mbon ako ekesʌk etañ kpa ukem ado.<verse eid="MAT 26:35" /></para>
  <para style="s1">Kedsemeni</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Ndin Yisọs amaasaña ye mme mbed amọ akaa itie keed ekekoodo Kedsemeni, amaanyʌñ abo mme mbed amọ ate, <char style="wj">“Ndufo itie mi nọ ami ñka ñkebọñ akam.”</char> <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Anye amaadat Pita ye nditọ ideen Sebidi iba akaa do, ndin anye amaatọọñọ akop akpọsọñ mfʌhọ, anyʌñ aba anye mfịna-mfịna. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Anye ndin amaabo ammọ ate, <char style="wj">“Ukpọñ mmi ayọhọ ye mfʌhọ tutu akpere ñkpa. Itie mi inyʌñ itaba idab ye ami.”</char><verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Ke amaanake asaña aka iso etək, anye amaaduọ ke isọñ akʌp iso anyʌñ abọñ akam ate, <char style="wj">“Ete mmi, akpedo usʌñ aba, ben kọọb ami fep nnọ miin. Ado ke ado ke uduak mmi, yak ado ke uduak mfo.”</char><verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Anye amaatịmme abịne mme mbed amọ, ado akekịt nte ammọ esʌk edadaiya, anye amaabịp Pita ate, <char style="wj">“Awuọñọ ndufo ikanna aditaba idab ye ami ke ukpọk awa keed?</char> <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" /><char style="wj">Itaba idab inyʌñ ibọñ akam mbaak ndufo ididʌk idomo. Sịbidịd a-anyịmme, ado ikpọkidem a-akop mmemidem.”</char><verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Anye amaatịmme akaa akebọñ akam ayọhọ akañ iba, <char style="wj">“Ete mmi, akpedo kọọb ami ikemeke adimboiyo ibọhọke ami ñnwọñ anye, yak uduak mfo asu.”</char><verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Ke ini anye aketịmmeke adi anye amaadikịt mme mbed amọ naña esʌk edadaiya, sia idab amaayeet ammọ. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Anye amaadakka akpọñ ammọ anyʌñ atịmme akebọñ akam ayọhọ akañ ita, asʌk abọñ kpa ukem ukod akam ado.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Akem anye amaatịmme abịne mme mbed amọ anyʌñ adibo ammọ ate, <char style="wj">“Ndufo esʌk edadaiya enyʌñ eba ke nduọk adudu? Se ini akem, ndin eyaak Ayịn Awo esịn ke ubọk mme anam idiọọkñkpọ.</char> <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" /><char style="wj">Idakka ida! Yak ñnyịn ika! Se awo antappa miin adiighe mi!”</char><verse eid="MAT 26:46" /></para>
  <para style="s1">Emʌm Yisọs</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Idaha a-anye akesʌkkọ atañ ikọ do, Yudas, keed ke atu mme mbed duob mme iba, amaadiwuọ. Ekamba atu awo e-ekekamake mme akañkañ ye mme akpeti, a-mme ñkpoon aku ye mme ñkpisọñ ekedọññọ enọ Yisọs emaesaña ye anye. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Ndin awo a-akebooho itap anye amaanọ ammọ idiọọñọ: “Awo se ami ntʌm inua ado awo ado; imʌm anye.” <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Ini keed, Yudas amaakaa abịne Yisọs akekọọm anye ate, “Mmekọọm-o, Andikpeeb!” Anyʌñ atʌm anye inua.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Yisọs amaabọọrọ ate, <char style="wj">“Ufan, nam se akedi adinam.”</char><note caller="+" style="f"><char style="fr" closed="false">26:50 </char><char style="ft" closed="false">Usʌk ewet, </char><char style="fqa" closed="false">“Ufan, nsoo ido ntak a-afo adiighe?” </char></note></para>
  <para style="p" vid="MAT 26:50">Ndin mme ideen ke atu awo ado emaewuọ edi, edifiik Yisọs emʌm. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Ke ntak ado, keed ke atu mme mbed Yisọs amaasio akañkañ akpi ayịnufọk ekamba aku, anyʌñ akpịkke anye utọñ asio.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Ndin Yisọs amaabo anye, <char style="wj">“Sịn akañkañ mfo ke efọk, sia afịd awo se isio akañkañ ke efọk ediikpa ke akañkañ.</char> <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" /><char style="wj">Ado nte afo akere ke ami ñkpikanna ñkoot Ete mmi, ndin anye akpesọsọp annọ miin udịm mme enyere se iwak ikan duob mme iba ediñkpeme miin?</char> <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" /><char style="wj">Ado die ndin ke ikọ Abasi adiisu a-abooho ke ana atịppe ke utọ usʌñ ami?”</char><verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Ke awa ado Yisọs amaabo mme atu awo ate, <char style="wj">“Ado nte ami ndo asịn ntịme ke abio nọ ndufo ewuọñọ ekaama mme eduad ye mme akpeti edi edimmʌm miin? Ami mmaasitie ñkpeep ñkpọ ke afe tembịd ke usen ke usen, ado kpaanaanam ndufo idueghe indot ubọk ke idem.</char> <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" /><char style="wj">Idahami afịd ami atịppe nọ se mme prọfed ekewet ke ñwed Abasi asu.”</char> Ndin afịd mme mbed emaefeeñe ekpọñ anye.<verse eid="MAT 26:56" /></para>
  <para style="s1">Yisọs ke Iso Sanhidrin</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Mbon e-ekemʌmmọ Yisọs emaeben anye ekaa ebịne Kaifas, ekamba aku, itie a-mme andikpeeb mbed ye mme ñkpoon ñkpisọñ ekebohoke. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Ado Pita amaakpeeñ ñkpad isañ, akeene anye ke nsan-nsan, tutu akesịm esịd akwere ekamba aku. Anye ñko amaadʌk akesuuk atie ye mbon ukpeme ekamba aku nọ anye akịt naña utịd adiido.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Afịd mme ñkpoon aku ye afịd mme esob Sanhidrin emaeyem nsu-nsu ikọ ntiense se etañ edian Yisọs nọ ediikan iwot anye. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Ado ammọ ikikanna ikịt usʌñ ndomokeed, akpesʌkado uwak nsu-nsu ntiense emaewuọñọ edi.</para>
  <para style="p" vid="MAT 26:60">Ke akpatre ntiense iba emaewuọñọ edi, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />enyʌñ edibo ete, “Awo ami akebo, ‘Ami mmenie adudu adiwuut tembịd Abasi ñnyʌñ mmaana mbọp anye ke usen ita.’ ”<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Ndin ekamba aku amaadakka ada anyʌñ abo Yisọs, “Nte afo unieghe ibọọrọ? Nsoo ikọ ntiense ke mme awo etañ udian ami?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Ado Yisọs ikisioho uyio.</para>
  <para style="p" vid="MAT 26:63">Ekamba aku amaabo anye, “Ami mmunọ fiin iwuuk ke idak unwọñọ ke anyịñ ndu-ndu Abasi adidọkkọ ñnyịn me afo ado Krais, Ayịn Abasi.”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Yisọs amaabọọrọ anye ate, <char style="wj">“Ado afo atañ ntoro. Ado ami ntañ inọ afịd ndufo mbo ke tọọñọ ke idahami kaa iso, ndufo eyaekịt Ayịn Awo nte atie ke ubọk nnasia Akwa Abasi, anyʌñ adi ke ntọñanyọñ hefịn.”</char><verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Ndin ekamba aku amaawai afọñidem amọ anyʌñ abo, “Anye asuuk Abasi uyio! Nsoo ido ufọn a-ñnyịn iyemme uwak ntiense idahami aba? Se do, idahami ndufo emekop nsuukuyio ami. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Nsoo ido akikere ndufo?”</para>
  <para style="p" vid="MAT 26:66">Ammọ emaebọọrọ ete, “Anye adot ñkpa.”<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Ndin ammọ emaetọọñ anye etab ke iso enyʌñ etọ anye eta. Ubaak awo emaesiak anye ufia <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />enyʌñ ebo anye ete, “Krais, tañ prọfesi inọ ñnyịn. Anie awo umia fiin idahado?”<verse eid="MAT 26:68" /></para>
  <para style="s1">Pita Akañ Yisọs</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Ke ukem ini ado Pita aketie ke esịd akwere, ndin abọikpa ayịnufọk keed amaadi adibo anye, “Afo ñko akedo nsaña Yisọs awo Kalili.”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Ado Pita amaakañ ke iso afịd ammọ ate, “Ami ndiọọñọke se afo atañ abaña.”<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Ke anye amaakewuọ aka ke inuaatob, abọikpa ayịnufọk mfen amaakịt anye anyʌñ adọkkọ mme awo e-ekebaaha do ate, “Awo ami akedo nsaña Yisọs awo Nasared.”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Pita amaamaana akañ ye unwọñọ ate: “Ami ndiọọñọke ete ado!”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Ke etək ini amaakeboiyo, mbon se ikida do emaebịne Pita enyʌñ ekebo anye ate, “Ke akpanikọ afo ado keed ke atu ammọ; uyio ikọ mfo uyaara fiin.”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Ndin Pita amaatọọñọ adikoot isuuñọ nnọọ idem amọ, anyʌñ anwọñọ anọ ammọ ate, “Ami ndiọọñọke ete ado!”</para>
  <para style="p" vid="MAT 26:74">Kpa idahado, akikọunen amaakpọk. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Ndin Pita amaatoiyo ikọ se Yisọs aketañ, <char style="wj">“Mbemiso akikọunen akpọk, afo ayañkañ miin akañ ita.”</char> Ndin anye amaawuọ esiin anyʌñ aketua idod-idod ayịd.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">Yudas Ayịre Ekpan</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Tuhi-tuhi ubakusen, afịd mme ñkpoon aku ye mme ñkpisọñ abio emaenam edioomo ebaña naña ediiwot Yisọs. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Ndin ammọ emaebọp anye enyʌñ eben anye ekaa ekeyaak enọ Pailed, adaiwuod ukara.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Ke ini Yudas, awo a-akenyamma Yisọs anọ mme Yuu, amaakekịt ke ebiere ikpe ñkpa enọ Yisọs, anye amaatua ñkpọfiọk, akpəho akikere abaña ndudue amọ anyʌñ aben akpoho edịb mme duob a-anye akebọọhọ asọk mme ñkpoon aku ye mme ñkpisọñ. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Anye amaabo ammọ ate, “Ami mmenam idiọọkñkpọ ke aditap iyiib i-imiidueghe.” Ammọ emaebọọrọ ete,</para>
  <para style="p" vid="MAT 27:4">“Anye ado ibeghe die ñnyịn? Ndubeghe mfo ado ado.”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Ndin anye amaatoomo akʌk ado abono ke tembịd anyʌñ adakka akeyịt idem awot.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Mme ñkpoon aku emaekoono akʌk ado enyʌñ ebo, “Mbed akpan adisịn akʌk ami ke ufọk unịm akʌk; sia ado akʌk iyiib awo.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Ammọ emaebiere adiben akʌk ado ñkedep isọñ abodabañ ndat nnịm nte itie ubuuk mme isenawo. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Ntak adodo i-isọñ ado akereke Isọñ Iyiib tutu asịm mfịn ami. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Ndin ikọ a-prọfed Yerimaiya aketañña amaasu: “Ammọ emaeben mbaak silfa edịb mme duob, ekọmudua a-nditọ Isrel ekenyịmmeke adikpe ke iwuod amọ, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />edep inwañ abodabañ kpa naña nte Abọọñ akennọọ ewʌhọ.”<verse eid="MAT 27:10" /></para>
  <para style="s1">Yisọs ke Iso Pailed</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Ndin emaeben Yisọs edi ke iso adaiwuod ukara, ndin adaiwuod ukara amaabịp anye mbịme ami, “Afo ado adidem mme Yuu?”</para>
  <para style="p" vid="MAT 27:11">Yisọs amaabọọrọ ate, <char style="wj">“Akap ado afo atañ.”</char><verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Ke ini mme ñkpoon aku ye mme ñkpisọñ ekedotto anye uyio, anye ikibọọrọke ammọ ikọ ndomokeed. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Ndin Pailed amaabo anye ate, “Nte afo ukoppo afịd ikọ se ammọ udot fiin ami?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Ado ke ataa ñkpaidem adaiwuod ukara, anye ikibọọrọke ikọ ndomokeed ke abaña mme ndoduyio ami.<verse eid="MAT 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Ke ini usọrọ, akesido ido adaiwuod ukara adisaana awo ñkpakọb keed akeedodo a-mbon idʌñ eyemme nnọọ ammọ. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Ke ini ado, ataa abʌd-abʌd awo ñkpakọb keed amaaba a-akekereke Yisọs<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="ft" closed="false">Ataa uwak mme ikpañwed inieghe </char><char style="fq" closed="false">Yisọs</char><char style="ft" closed="false">ke anyịñ ami; se ñko ke Matiu 27:17.</char></note> Barabas. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Anam ke ini atu awo emaekeboho, Pailed amaabo ammọ ate, “Anie awo ke eyem ñyaak inọ ndufo: Yisọs Barabas me Yisọs e-ekoodo Krais?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Pailed amaadiọọñọ abo ke aketo ke ntak ufọn idem ammọ akenam nọ ammọ ekeyaak Yisọs inọ imọ.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Idaha a-Pailed aketieghe ke ñkpọitie ubiideikpe, anwaan amọ amaanọ etob ami esọk anye ate, “Kuunie ñkpọ ndomokeed adinam ye eti awo ado; esịd antịmede miin mfịn ami ato ke ndab añkedappake mbaña anye.”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Ado mme ikpọ aku ye mme ñkpisọñ emaedọọñ atu awo ete ebo Pailed asaana Barabas ayaak, ado awot Yisọs.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Anam ke ini adaiwuod ukara aketañña ikọ anyʌñ abịp ammọ ate, “Anie ke atu awo iba ami ke ndufo eyem ñyaak inọ?”</para>
  <para style="p" vid="MAT 27:21">Ammọ emaebọọrọ, “Barabas.”<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Pailed amaabịp ammọ ate, “Ke ntoro, nsoo ke ndufo eyem nnam ye Yisọs e-ekoodo Krais?”</para>
  <para style="p" vid="MAT 27:22">Afịd ammọ emaebo, “Ikọñ anye ke krọs!”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Pailed amaabịp ammọ, “Ntak-a? Nsoo idiọọkñkpọ ke anye anam?”</para>
  <para style="p" vid="MAT 27:23">Ado ammọ emaenenekke ebọñ ke akpọsọñ uyio ete, “Ikọñ anye ke krọs!”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Ndin Pailed akekịt ke inieghe se imọ ikan adinam, ñko ke atu awo eyaetọọñọ ntịme, anye amaaben mmọọñ ayie ubọk ke iso atu awo anyʌñ abo, “Ami nsañake ñkpọ do ye iyiib awo ami. Ado ndubeghe ndufo!”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Ndin afịd atu awo emaebọọrọ ete, “Yak iyiib amọ idoro ñnyịn ye nditọ ñnyịn ke iwuod!”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Ndin anye amaayaak Barabas anọ ammọ. Ke ini anye amaakenam nọ emia Yisọs ema, anye amaayaak anye anọ ammọ nọ ekọñ anye ke krọs.<verse eid="MAT 27:26" /></para>
  <para style="s1">Mbon Ekọñ Edọọñ Yisọs Ndọk</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Ndin mbon ekọñ adaiwuod ukara emaeben Yisọs edʌk ekamba akwere (Pretorium) adaiwuod ukara enyʌñ eben afịd udịm mbon ekọñ ekanna anye ekʌk. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Ndin ammọ emaesịññe anye afọñidem enyʌñ eben ndad-ndad afọñ ewañ anye. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Ke emaekedọk ñnyanyaha ñkukịm nte anyanya emaeben edot anye ke iwuod enyʌñ eben esañ esịn anye ke ubọk nnasia. Ndin ammọ emaetọọñọ edọñ enọ anye, enyʌñ edọọñ anye ndọk, ebo, “Itọñ uwem asọñ adidem mme Yuu!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Ndin ammọ emaetọ anye etab enyʌñ ebọ anye esañ ado eyʌppọ anye ke iwuod uwak-uwak ini. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Ke ini ammọ emaekesuenne anye ima, ammọ emaesio anye ndad-ndad afọñ ado enyʌñ eben afọñidem amọ esịn anye, ndin eben anye ekaa adikikọñ ke krọs.<verse eid="MAT 27:31" /></para>
  <para style="s1">Ekọñ Yisọs ke Krọs</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Ke ammọ emaekewuọ, ammọ emaekịt awodeen keed a-aketooho Siriin, a-akekereke Saimọn. Ndin ammọ emaemʌm anye enam anye abiom krọs ado. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Ammọ emaekesịm itie keed e-ekekoodo Kọlkọta (awuọñọke “itie ñkpọkpọrọ”). <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Ke itie ado ammọ emaenọ Yisọs ukọd nọ anwọñ, ewuaha ye idod-idod ukọd; ado ke anye amaaketʌm mmịn ado, anye amaasịn adinwọñ. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Ammọ emaekekọñ anye ke krọs ima, ammọ emaesịn ukañ edeeme afọñidem amọ edat. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Ndin emaesuuk etie do ekpeme anye. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Ke anyọñ krọs ado ammọ emaewet ikọ ndoduyio ebana anye, ete:</para>
  <para style="pc" vid="MAT 27:37">
    <char style="sc">Ami ado Yisọs, Adidem mme Yuu.</char><verse eid="MAT 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38" />Ndin emaekọñ mme ndiọi awo iba edian anye, keed ke ubọk nnasia, keed ke ubọk ufiin. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Mbon se ikiboiyo ke usʌñ emaesueñ anye, efuuñ iwuod, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />enyʌñ ebo ete, “Afo a-aduakka adiwuut tembịd mmaana ndat usen ita mbọp, nyaaña idem mfo! Akpedo afo ado Ayịn Abasi sọiyọ ke krọs di!” <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Kpa ke ukem usʌñ ado, mme ñkpoon aku, ye mme andikpeeb mbed ye mme ñkpisọñ emaenọ anye ñnyọọ. <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />Ammọ emaebo ete, “Anye amaanyaaña mbon mfen ado anye ikanna inyaaña idem amọ. Anye ado adidem Isrel! Yak anye asọiyọ ke krọs adi idahami, ndin ñnyịn iyainịm anye ke akpanikọ. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Anye anịm Abasi ke akpanikọ; idahami yak Abasi anyaaña anye adieke ayemme anye, sia anye akebo, ‘Ami ndo Ayịn Abasi.’ ” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Kpa ke ukem usʌñ ado, idem mme inọ e-ekekọññọ ke krọs edian anye emaekeene esueñ anye.<verse eid="MAT 27:44" /></para>
  <para style="s1">Ñkpa Yisọs</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Tọọñọ ke ñkanika duob mme iba uweemeayio tutu awuọ ñkanika ita uweemeayio ekịm amaafʌk afịd isọñ. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Ndin ke ñkpọ nte ñkanika ita uweemeayio, Yisọs amaabọñ ke akpọsọñ uyio ate, <char style="tl"><char style="wj">“Eli, Eli,</char></char><note caller="+" style="f"><char style="fr" closed="false">27:46 </char><char style="ft" closed="false">Usʌk mme ikpañwed ewet, </char><char style="fqa" closed="false">Eloi, Eloi</char></note> <char style="tl"><char style="wj">lema sabaktani?”</char></char> (a-awuọñọke, <char style="wj">“Abasi mmi, Abasi mmi, nsoo inam nọ afo añkpọñ miin?”</char>).<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Ke ini usʌk mbon se ikida ikpere ekekoppo, ammọ emaebo, “Anye akoot Elaiya.”<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />Ndin keed ke atu ammọ amaasọsọp afeghe akedat kusa atot ke eto, anyiin ke wain fineka, anyʌñ anọ Yisọs nọ anwọñ. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Ado mbon ako emaebo, “Isaana anye iyaak ndin. Yak ise me Elaiya ayaadinyaaña anye.”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Ado ke Yisọs amaaketua ke akpọsọñ uyio ini keed mfen, anye amaasaana sịbidịd amọ ayaak.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Kpa ke idahado, afọñ ikpeghe tembịd amaasakka iba tọọñọ ke anyọñ tutu asịm isọñ. Isọñ amaanyeñ, mme itiad emaesaiya, <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />mme udi emaenyʌñ ekuumọ, ndin mme ikpọkidem uwak ndisana awo emaeset ke ñkpa. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Ammọ emaewuọñọ ke mme udi edi, ke ini Yisọs amaakeset ke ñkpa, enyʌñ ekewọt uwak awo idem ke adisana abio.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Sentudiọn ye mbon mfen e-ekekpemeke Yisọs ekekịt unyeñisọñ ye afịd se ikitịppe, ammọ emaekop akpọsọñ ndịk enyʌñ ebo, “Ke akpanikọ, awo ami akedo Ayịn Abasi!”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Uwak ibaan emaeba do, eda nsan-nsan ese, kpa mme ibaan ado e-ekekeeneke Yisọs tọọñọ ke Kalili enyʌñ ese ñkpọ ebaña anye. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Ubaak ke atu ammọ ekedo Mmeri Makdalin, Mmeri eka Yems ye Yosef,<note caller="+" style="f"><char style="fr" closed="false">27:56 </char><char style="ft" closed="false">Ke usem Krik </char><char style="fqa" closed="false">Yoses, </char><char style="ft" closed="false">ado usʌñ mfen naña ekoot </char><char style="fq" closed="false">Yosef </char></note> ye eka nditọ Sebidi.<verse eid="MAT 27:56" /></para>
  <para style="s1">Ubuuk Yisọs</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Ke amaakekpere ndubiayio, imọ awo keed a-aketooho Arimatia, a-akekereke Yosef, a-adooho anye amaakappa ado mbed Yisọs, amaadi. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Anye amaabịne Pailed akebo yak inọ akpo Yisọs. Ndin Pailed amaanọ uyio ate eyaak enọ anye. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yosef amaaben akpo Yisọs awañ ke afọñ linen a-asanake, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />anyʌñ asịn ke ufa udi amọ a-anye akedọkkọ ke abaitiad. Anye amaawere ekamba itiad akwe inua udi ado anyʌñ adakka anyọñ. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Mmeri Makdalin ye Mmeri anye ako emaetie do esak iso ese udi.<verse eid="MAT 27:61" /></para>
  <para style="s1">Mme Akpeme Udi Yisọs</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Ke edem usen, a-akedooho edem usen Mbeeñe Idem amaakekweeñe, mme ñkpoon aku ye mme Farisi emaesaña keed ebịne Pailed. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Ammọ emaekebo anye, “Abọọñ awo, ñnyịn imitoiyo ibo ke awo abiaña ami, ke ini anye akebaaha ke uwem, amaabo, ‘Ami ñyaaset ke ayọhọ usen ita.’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Ke ntoro, nọ uyio bo etʌm ekpeme udi ado tutu ayọhọ usen ita, mbaak mme mbed amọ edidiyịp anye etịmme ekedọkkọ mbon awo ebo ke anye a-aset ke ñkpa. Akpatre abiaña ami ayaadiọọk akan akpa.”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Pailed amaabo ammọ ate, “Idat akpeme udi keed, ikaa ikinekke ikpeme itie ado naña ndufo ekpekakan.” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Ammọ emaedakka ekenekke ekọp udi, edian mme idiọọñọ ke itiad udi enyʌñ enịm mme mbon ekọñ do.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">Yisọs a-Aset ke Ñkpa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Ke usen Sabad amaakeboiyo, ke usiere akpa usen ke udua, Mmeri Makdalin ye Mmeri anye ako emaekaa adikise udi.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />Ndin ataa akpọsọñ unyeñisọñ amaaba, sia enyere Abọọñ, a-aketooho hefịn adi, amaadiwere itiad asio anyʌñ adọọk atie ke anyọñ itiad ado. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Iso amọ akeba nte akebkeb, afọñ amọ anyʌñ afia nte sino. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Ndịk amaanam mme akpeme udi ndin idem amaanyeñ ammọ tutu ekappa eba nte mbon ñkpa.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Enyere ado amaabo ibaan ado ate, “Ikiikop ndịk, sia mmediọọñọ ke ndufo eyem Yisọs e-ekekọññọ ke krọs.” <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Anye ibaaha mi, sia anye a-aset ke ñkpa kpa naña anye akebo. Idi idise itie se anye akenaa. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />“Ndin isọsọp ikaa ikidọkkọ mme mbed amọ ete, ‘Anye a-aset ke ñkpa, ndin idahami anye i-ibem ndufo iso akaa Kalili; do ke ediikikịt anye.’ Idahado mmiidọkkọ ndufo.”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Ke ndịk ado ye idaara mme ibaan ado emaesọsọp ekpọñ itie udi enyʌñ efeeñe ekaa adikidọkkọ mme mbed amọ. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Ke ndo-ndo ado, Yisọs amaasoobo ammọ. Anye amaabo ammọ, <char style="wj">“Ekọọm do-o”</char> Ndin mme ibaan ado emaebịne anye, eduọññọ anye ke ukod enyʌñ ekpono anye. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Ndin Yisọs amaabo ammọ ate, <char style="wj">“Ikiifeghe ndịk. Ikaa ikidọkkọ nditọeka mmi ideen ibo yak ammọ eka Kalili; ndin ammọ eyaeñkịt miin do.”</char><verse eid="MAT 28:10" /></para>
  <para style="s1">Etob mme Akpeme Udi</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Ke ibaan ado emaekedaaña, ubaak mme akpeme udi emaedaaña edʌk abio ekedọkkọ mme ñkpoon aku afịd se ikitịppe. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Mme ñkpoon aku emaesoobo ye mme ñkpisọñ, ndin ke emaekenam edioomo ema, emaeyaak uwak akʌk enọ mbon ekọñ, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />enyʌñ enọ ammọ iwuuk ami: “Ikop se ediitañ mi, ‘Mme mbed amọ ekedi ke akonayio, idaha a-ñnyịn ikidaiyake, ediyịp anye.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Ñko adaiwuod ukara akpekop ñkpọ ami, ñnyịn iminwọñọ adinam afịd ñkpọ adikịt mbo ke ndufo idʌkkọ mfịna.” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Ammọ emaebọ akʌk ami enyʌñ enam naña mme ñkpoon aku eketemme ammọ, ndin mbʌk ami asʌk ababa ke atu mme Yuu tutu asịm usen mfịn.<verse eid="MAT 28:15" /></para>
  <para style="s1">Ekamba Ewʌhọ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Ke ukem ini ado, mme mbed duob mme keed emaetọọñọ isañ ekaa Kalili, ke anyọñ ekamba abod a-Yisọs akebiideke adisoobo ye ammọ. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Ke ini ammọ emaekekịt anye, ammọ emaeduọññọ anye ke ukod ekpono anye, akpesʌkado ubaak ammọ ekenieghe eyịghe. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Ndin Yisọs amaadi aditañ ikọ ye ammọ abo, <char style="wj">“E-eyaak afịd adudu ke hefịn ye ke isọñ ennọ miin.</char> <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" /><char style="wj">Ke ntoro, ikaa ke afịd mme idịd, ikikọ mme mbed, iduọk ammọ mmọọñ ke anyịñ Ete ye Ayịn ye Adisana Sịbidịd,</char> <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" /><char style="wj">inyʌñ ikpeep ammọ adinịm afịd mme mbed a-ami inọọhọ ndufo. Ndin ke akpanikọ, ami mbaba ye ndufo afịd ini, tutu asịm utịd emana.”</char><verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>