  <para style="h">Akpa Ñwed Krọnikịd</para>
  <para style="toc1">Akpa Ñwed Krọnikịd</para>
  <para style="toc2">Akpa Ñwed Krọnikịd</para>
  <para style="toc3">1Krọn</para>
  <para style="mt1">Akpa Ñwed Krọnikịd</para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s1">Mbʌk Esed Tọọñọ ke Adam Tutu Awuọ Ebraham</para>
  <para style="s2">Ake Nditọ Ideen Nua</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 1:1" />Adam, Sed, Enos,<verse eid="1CH 1:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 1:2" />Kenan, Mahalalel, Yared,<verse eid="1CH 1:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 1:3" />Inọk, Metusela, Lamek,</para>
  <para style="li1" vid="1CH 1:3">Nua.<verse eid="1CH 1:3" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="4" style="v" sid="1CH 1:4" />Mme nditọ Nua: Sem, Ham ye Yafed.<verse eid="1CH 1:4" /></para>
  <para style="s2">Mbon Yafed</para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5" />Nditọ ideen Yafed:</para>
  <para style="li2" vid="1CH 1:5">Koma, Makọk, Madai, Yafan, Tubal, Mesek ye Tiras.<verse eid="1CH 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 1:6" />Nditọ ideen Koma:</para>
  <para style="li2" vid="1CH 1:6">Askenas, Rifad ye Tokama.<verse eid="1CH 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7" />Nditọ ideen Yafan:</para>
  <para style="li2" vid="1CH 1:7">Elisa, Taasis, mbon Kid ye mbon Rodan.<verse eid="1CH 1:7" /></para>
  <para style="s2">Mbon Ham</para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8" />Mme nditọ ideen Ham:</para>
  <para style="li2" vid="1CH 1:8">Kuus, Iyib, Pud ye Kenan.<verse eid="1CH 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9" />Nditọ Kuus:</para>
  <para style="li2" vid="1CH 1:9">Seba, Hafila, Sabta, Raama ye Sabteka.</para>
  <para style="li1" vid="1CH 1:9">Nditọ Raama ideen:</para>
  <para style="li2" vid="1CH 1:9">Seba ye Dedan.<verse eid="1CH 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 1:10" />Kuus akedo ete</para>
  <para style="li2" vid="1CH 1:10">Nimrọd, a-akedidooho akpọsọñ awo ekọñ ke ederimbod.<verse eid="1CH 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11" />Iyib akedo ete anọ</para>
  <para style="li2" vid="1CH 1:11">mbon Lud, mbon Anam, mbon Lehab, mbon Naftu, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />mbon Patrus, mbon Kaslu (a-mbon Filistia eketooho ammọ ewuọ) ye mbon Kaftọ.<verse eid="1CH 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13" />Kenan akedo ete anọ</para>
  <para style="li2" vid="1CH 1:13">Sidọn a-akedooho akpa ayịn amọ, ye mbon Hed, <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />mbon Yebus, mbon Amọọ, mbon Keekasi, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />mbon Hif, mbon Akaid, mbon Sin, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />mbon Afaad, mbon Sema ye mbon Hamad.<verse eid="1CH 1:16" /></para>
  <para style="s2">Mbon Sem</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17" />Nditọ ideen Sem:</para>
  <para style="li2" vid="1CH 1:17">Elam, Asọọ, Afasad, Lud ye Aram.</para>
  <para style="li1" vid="1CH 1:17">Nditọ ideen Aram:</para>
  <para style="li2" vid="1CH 1:17">Us, Hul, Keta ye Mesek.<verse eid="1CH 1:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18" />Afasad akedo ete anọ Sela,</para>
  <para style="li2" vid="1CH 1:18">ndin Sela ado ete anọ Ebee.<verse eid="1CH 1:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 1:19" />Nditọ ideen iba ke ekeman enọ Ebee:</para>
  <para style="li2" vid="1CH 1:19">Keed akekere Pelek, sia idaha anye akemanake ke ekebakka ederimbod; ndin ekesio ayịneka amọ awodeen Yoktan.<verse eid="1CH 1:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20" />Yoktan akedo ete anọ</para>
  <para style="li2" vid="1CH 1:20">Almodad, Selef, Hasamafed, Yera, <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />Hadoram, Usal, Dikla, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />Obal, Abimel, Seba, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />Ọfia, Hafila ye Yobab. Afịd ami ekedoñño nditọ ideen Yoktan.<verse eid="1CH 1:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="1CH 1:24" />Sem, Afasad, Sela,<verse eid="1CH 1:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 1:25" />Ebee, Pelek, Reu,<verse eid="1CH 1:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 1:26" />Seruk, Nahọ, Tera<verse eid="1CH 1:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 1:27" />ye Ebram (a-adooho Ebraham).<verse eid="1CH 1:27" /></para>
  <para style="s1">Ubon mme Ebraham</para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 1:28" />Nditọ Ebraham: Aisik ye Ismeel.<verse eid="1CH 1:28" /></para>
  <para style="s2">Ntọọñọ Ubon Haka</para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29" />Ubon Ammọ ekedoñño Ami:</para>
  <para style="li2" vid="1CH 1:29">Nebaiyọd akedo akpan anọ Ismeel, Keda, Adbeel, Mibsam, <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />Misma, Duma, Masa, Hadad, Tema, <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />Yetọọ, Nafis ye Kedema.</para>
  <para style="li4" vid="1CH 1:31">Mme nditọ ideen Ismeel ekedo ami.<verse eid="1CH 1:31" /></para>
  <para style="s2">Mme Ntịppe Ubon Ketura</para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32" />Nditọ ideen se ekeman enọ Ketura, anwaan esa Ebraham:</para>
  <para style="li2" vid="1CH 1:32">Sịmran, Yoksan, Medan, Midian, Isbak ye Sua.</para>
  <para style="li1" vid="1CH 1:32">Nditọ ideen Yoksan:</para>
  <para style="li2" vid="1CH 1:32">Seba ye Dedan.<verse eid="1CH 1:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33" />Nditọ ideen Midian ekedo</para>
  <para style="li2" vid="1CH 1:33">Efa, Efe, Hanọk, Abida ye Elda.</para>
  <para style="li4" vid="1CH 1:33">Afịd emi ekedo ntịppe Ketura.<verse eid="1CH 1:33" /></para>
  <para style="s2">Ntịppe Sera</para>
  <para style="li4">
    <verse number="34" style="v" sid="1CH 1:34" />Ebraham akedo ete anọ Aisik.</para>
  <para style="li1" vid="1CH 1:34">Nditọ ideen Aisik:</para>
  <para style="li2" vid="1CH 1:34">Isọ ye Isrel.<verse eid="1CH 1:34" /></para>
  <para style="s1">Nditọ Ideen Isọ</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35" />Nditọ ideen Isọ ekedo</para>
  <para style="li2" vid="1CH 1:35">Elifas, Rewel, Yeus, Yalam ye Kora.<verse eid="1CH 1:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36" />Nditọ ideen Elifas ekedo</para>
  <para style="li2" vid="1CH 1:36">Teman, Ọma, Sefo, Katam ye Kenas;</para>
  <para style="li2" vid="1CH 1:36">Timna akeman Amalek.<verse eid="1CH 1:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37" />Nditọ ideen Rewel ekedoñño:</para>
  <para style="li2" vid="1CH 1:37">Nahad, Seera, Sama ye Misa.<verse eid="1CH 1:37" /></para>
  <para style="s2">Mbon Sei E-Ebaaha ke Edọm</para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38" />Nditọ ideen Sei</para>
  <para style="li2" vid="1CH 1:38">ekedoñño Lotan, Sobal, Sibiọn, Ana, Disọn, Esa ye Disan.<verse eid="1CH 1:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39" />Nditọ ideen Lotan ekedoñño:</para>
  <para style="li2" vid="1CH 1:39">Hori ye Homam. Timna akedo ayịneka awonwaan Lotan.<verse eid="1CH 1:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40" />Nditọ ideen Sobal ekedoñño:</para>
  <para style="li2" vid="1CH 1:40">Alfan, Manahad, Ebal, Sefo ye Ọnam.</para>
  <para style="li1" vid="1CH 1:40">Nditọ ideen Sibiọn ekedoñño:</para>
  <para style="li2" vid="1CH 1:40">Aiya ye Ana.<verse eid="1CH 1:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41" />Ayịn awodeen Ana akedo:</para>
  <para style="li2" vid="1CH 1:41">Disọn.</para>
  <para style="li1" vid="1CH 1:41">Nditọ ideen Disọn</para>
  <para style="li2" vid="1CH 1:41">ekedoñño Hemdan, Esban, Itran ye Keran.<verse eid="1CH 1:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42" />Nditọ ideen Esa ekedoñño:</para>
  <para style="li2" vid="1CH 1:42">Bilhan, Saafan ye Akan.</para>
  <para style="li1" vid="1CH 1:42">Nditọ ideen Disan ekedoñño:</para>
  <para style="li2" vid="1CH 1:42">Us ye Aran.<verse eid="1CH 1:42" /></para>
  <para style="s2">Mme Andikara Edọm</para>
  <para style="li4">
    <verse number="43" style="v" sid="1CH 1:43" />Mme ndidem se ikikara ke Edọm mbemiso awo Isrel ndomokeed adikara ekedoñño ami:</para>
  <para style="li1" vid="1CH 1:43">Bela ayịn Beo, a-abio amọ akekereke Dinhaba.<verse eid="1CH 1:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44" />Ke Bela amaakekpa, Yobab ayịn Seera aketooho Bosra amaadat itie amọ nte adidem.<verse eid="1CH 1:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45" />Ke Yobab amaakekpa, Husam aketooho isọñ Teman amaadat itie amọ nte adidem.<verse eid="1CH 1:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46" />Ke ini Husam amaakekpa, Hadad ayịn Bedad, a-akekanna Midian ke ekọñ ke idịd Mọb, amaadat itie amọ nte adidem. Ekekoot abio amọ Aafịd.<verse eid="1CH 1:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47" />Ke Hadad amaakekpa, Samla aketooho Masreka amaadat itie amọ nte adidem.<verse eid="1CH 1:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48" />Ke ini Samla amaakekpa, Sọọl aketooho Rehobod ke mben inyañ amaadat itie amọ nte adidem.<verse eid="1CH 1:48" /></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49" />Ke Sọọl amaakekpa, Baal-Hanan ayịn Akbọ amaadat itie amọ nte adidem.<verse eid="1CH 1:49" /></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50" />Ke Baal-Hanan amaakekpa, Hadad amaadat itie amọ nte adidem. Abio amọ akekere Pau, ndin anyịñ anwaan amọ akedo Mehetabel ayịn awonwaan Matred, a-akedooho ayịn awonwaan Me-Sahab. <verse eid="1CH 1:50" /><verse number="51" style="v" sid="1CH 1:51" />Hadad ñko amaakpa.</para>
  <para style="b" vid="1CH 1:51" />
  <para style="li4" vid="1CH 1:51">Mme mbọọñ abio Edọm ekedoñño:</para>
  <para style="li1" vid="1CH 1:51">Timna, Alfa, Yeted, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />Oholibama, Ela, Pinọn, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />Kenas, Teman, Mibsa, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />Makdiel ye Iram.</para>
  <para style="li4" vid="1CH 1:54">Mbon ami ekedoñño mme mbọọñ ke Edọm.<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s1">Nditọ Ideen Isrel</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 2:1" />Mbon ami ekedoñño nditọ ideen Isrel: Rubịn, Simiọn, Lifai, Yuda, Isaka, Sebulọn, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />Daan, Yosef, Benyamin, Naftali, Kad ye Asaa.<verse eid="1CH 2:2" /></para>
  <para style="s1">Yuda</para>
  <para style="s2">Tutu Akesịm Nditọ Ideen Hesrọn</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3" />Nditọ ideen Yuda:</para>
  <para style="li2" vid="1CH 2:3">ekedoñño Er, Ọnan ye Sela. Nditọ ita ami ekemana eto awonwaan Kenan, ayịn awonwaan Sua.</para>
  <para style="li2" vid="1CH 2:3">(Er, akpa ayịn Yuda, akedo ibak ke iso <char style="nd">Abọọñ</char>; ke ntoro <char style="nd">Abọọñ</char> amaawot anye.)<verse eid="1CH 2:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 2:4" />Anwan ayịn Yuda, a-akedooho Tama amaaman Peres ye Seera anọ Yuda.</para>
  <para style="li4" vid="1CH 2:4">Anye akenie nditọ ideen ition ke afịd.<verse eid="1CH 2:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5" />Nditọ ideen Peres:</para>
  <para style="li2" vid="1CH 2:5">ekedoñño Hesrọn ye Hamul.<verse eid="1CH 2:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6" />Nditọ ideen Seera:</para>
  <para style="li2" vid="1CH 2:6">ekedoñño Simri, Etan, Heman, Kalkol ye Daada awo ition ke afịd.<verse eid="1CH 2:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7" />Ayịn awodeen Kaami:</para>
  <para style="li2" vid="1CH 2:7">Akaa<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">Akaa awuọñọ ntịme; Akaa asʌk ado Akan ke ñwed Yọsua</char></note>, a-akebenne mfịna asọk Isrel ke adinam idiọọk ido mbiat ewʌhọ akeene naña anye akekoono mme asaña-asaña ñkpọ emaekekpan.<verse eid="1CH 2:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8" />Ayịn awodeen Etan:</para>
  <para style="li2" vid="1CH 2:8">Asaria<verse eid="1CH 2:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9" />Nditọ ideen ekemanake enọ Hesrọn ekedoñño:</para>
  <para style="li2" vid="1CH 2:9">Yerameel, Ram ye Kaleb<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">Ke Hibru Kaleb asʌk ado Kelubad</char></note>.<verse eid="1CH 2:9" /></para>
  <para style="s2">Tọọñọ ke Ram Ayịn Awodeen Hesrọn</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10" />Ram akedo ete Aminadab,</para>
  <para style="li1" vid="1CH 2:10">ndin Aminadab akedo ete Nasọn, adadusʌñ nditọ Yuda.<verse eid="1CH 2:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 2:11" />Nasọn akedo ete Salmọn,</para>
  <para style="li1" vid="1CH 2:11">Salmọn ete Boas,<verse eid="1CH 2:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 2:12" />Boas ado ete anọ Obed</para>
  <para style="li1" vid="1CH 2:12">ndin Obed ado ete anọ Yesi.<verse eid="1CH 2:12" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13" />Yesi akedo ete anọ</para>
  <para style="li2" vid="1CH 2:13">Eliab akpa ayịn amọ; udiana ayịn akedo Abinadab,</para>
  <para style="li2" vid="1CH 2:13">Simei akedo ayọhọ ita, <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />Netanel akedo ayọhọ inaañ,</para>
  <para style="li2" vid="1CH 2:14">Radai akedo ayọhọ ition, <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />Osem ayọhọ itiokeed</para>
  <para style="li2" vid="1CH 2:15">ndin ayọhọ itiaba akedo Defid.<verse eid="1CH 2:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="1CH 2:16" />Nditọeka amọ ibaan ekedoñño Seruya ye Abikel.</para>
  <para style="li3" vid="1CH 2:16">Nditọ ideen ita a-Seruya akenieghe ekedoñño Abisai, Yoab ye Asahel.<verse eid="1CH 2:16" /></para>
  <para style="li3">
    <verse number="17" style="v" sid="1CH 2:17" />Abikel akedo eka Amasa, ake ete amọ a-akedooho Yeta awo ufọk Ismeel.<verse eid="1CH 2:17" /></para>
  <para style="s2">Kaleb Ayịn Hesrọn</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18" />Kaleb ayịn Hesrọn amaanie nditọ ato anwan amọ Asuba (ñko ye Yeriọd). Nditọ ideen amọ ekedoñño ami:</para>
  <para style="li2" vid="1CH 2:18">Yesa, Sobab ye Adọn.<verse eid="1CH 2:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 2:19" />Ke ini Asuba amaakekpa, Kaleb amaaben Efrad adọ, a-akenyʌññọ aman Họọ anọ anye.<verse eid="1CH 2:19" /></para>
  <para style="li2">
    <verse number="20" style="v" sid="1CH 2:20" />Họọ akedo ete Uri, ndin Uri ado ete Besalel.<verse eid="1CH 2:20" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21" />Akem, Hesrọn, ke ini anye amaakeyọhọ isua ata, anye amaadọ ayịn awonwaan Makia a-akedooho ete Kilied. Anye amaanam ima ye anye, ndin anye amaaman Sekub anọ anye.<verse eid="1CH 2:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 2:22" />Sekub akedo ete Yai, akeseeghe ñkpọ abaña abio edịb mme ita ke Kilied.<verse eid="1CH 2:22" /></para>
  <para style="li2">
    <verse number="23" style="v" sid="1CH 2:23" />(Ado Kesọọ ye Aram emaekan ubọk ebọ Hafọd Yai, ukem ado ñko ye Kenad ñkọrọ mme ñkanñkʌk idʌñ ata.)</para>
  <para style="li4" vid="1CH 2:23">Afịd ammọ ekedoñño mme ubon Makia ete Kilied.<verse eid="1CH 2:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24" />Ke ini Hesrọn amaakekpa ke Kaleb Efrata, Abiya anwaan Hesrọn amaaman Asọọ anọ anye a-akedooho ete Tekoa.<verse eid="1CH 2:24" /></para>
  <para style="s2">Yerameel Ayịn Hesrọn</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25" />Nditọ ideen Yerameel akpan Hesrọn:</para>
  <para style="li2" vid="1CH 2:25">Ram akpan amọ, Buna, Oren, Osem ye Ahiya. <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />Yerameel amaanie anwan mfen, a-akekereke Atara; anye akedo eka Ọnam.<verse eid="1CH 2:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27" />Nditọ ideen Ram akpan Yerameel ekedoñño:</para>
  <para style="li2" vid="1CH 2:27">Maas, Yamịn ye Ekee.<verse eid="1CH 2:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28" />Mme nditọ ideen Ọnam:</para>
  <para style="li2" vid="1CH 2:28">Samai ye Yada.</para>
  <para style="li1" vid="1CH 2:28">Mme nditọ ideen Samai:</para>
  <para style="li2" vid="1CH 2:28">Nadab ye Abisuọ. <verse eid="1CH 2:28" /><verse number="29" style="v" sid="1CH 2:29" />Anwaan Abisuọ akekere Abihel, a-akemanna Aaban ye Molid.<verse eid="1CH 2:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30" />Mme nditọ ideen Nadab:</para>
  <para style="li2" vid="1CH 2:30">Seled ye Apaim. Seled amaakpa ado ikinieghe nditọ.<verse eid="1CH 2:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31" />Ayịn awodeen Apaim:</para>
  <para style="li2" vid="1CH 2:31">Isi, a-akedooho ete Sesan. Sesan akedo ete Alai.<verse eid="1CH 2:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32" />Nditọ ideen Yada, ayịneka Samai:</para>
  <para style="li2" vid="1CH 2:32">Yeta ye Yọnatan. Yeta amaakpa ikinieghe nditọ.<verse eid="1CH 2:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33" />Mme nditọ ideen Yọnatan:</para>
  <para style="li2" vid="1CH 2:33">Peled ye Sasa.</para>
  <para style="li4" vid="1CH 2:33">Ammọ ekedoñño mme ntịppe ubon Yerameel.<verse eid="1CH 2:33" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34" />Sesan ikinieghe nditọ ideen ndomokeed, sʌk nditọ ibaan ikpọọñ.</para>
  <para style="li2" vid="1CH 2:34">Anye amaanie ayịnufọk a-akedooho awo Iyib a-akekereke Yaaha. <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />Sesan amaanọ ayịnufọk amọ Yaaha ayịn amọ awonwaan ke ndọ, ndin anye amaaman Atai anọ anye.<verse eid="1CH 2:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36" />Atai akedo ete Natan,</para>
  <para style="li1" vid="1CH 2:36">Natan akedo ete Saabad,<verse eid="1CH 2:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 2:37" />Saabad ado ete Efaal,</para>
  <para style="li1" vid="1CH 2:37">Efaal ado ete Obed,<verse eid="1CH 2:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 2:38" />Obed ete Yehu,</para>
  <para style="li1" vid="1CH 2:38">Yehu ete Asaria,<verse eid="1CH 2:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 2:39" />Asaria ete Heles,</para>
  <para style="li1" vid="1CH 2:39">Heles ete Eleasa,<verse eid="1CH 2:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 2:40" />Eleasa ete Sismai,</para>
  <para style="li1" vid="1CH 2:40">Sismai ete Salum,<verse eid="1CH 2:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 2:41" />Salum ete Yekamia,</para>
  <para style="li1" vid="1CH 2:41">ndin Yekamia ado ete Elisama.<verse eid="1CH 2:41" /></para>
  <para style="s2">Ubon Kaleb</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42" />Mme nditọ ideen Kaleb ayịneka Yerameel:</para>
  <para style="li2" vid="1CH 2:42">Mesa akedo akpan amọ, a-akedooho ete Siif,</para>
  <para style="li2" vid="1CH 2:42">ye akpa ayịn amọ Maresa, a-akedooho ete Hibrọn.<verse eid="1CH 2:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43" />Mme nditọ ideen Hibrọn:</para>
  <para style="li2" vid="1CH 2:43">Kora, Tapua, Rekem ye Sema.<verse eid="1CH 2:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 2:44" />Sema akedo ete Raham,</para>
  <para style="li2" vid="1CH 2:44">ndin Raham ado ete Yọkeem.</para>
  <para style="li1" vid="1CH 2:44">Rekem akedo ete Samai.<verse eid="1CH 2:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 2:45" />Ayịn awodeen Samai akedo Maon,</para>
  <para style="li2" vid="1CH 2:45">ndin Maon akedo ete Bed Sọọ.<verse eid="1CH 2:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46" />Anwaan esa Kaleb a-akekereke Efa akedo eka anọ</para>
  <para style="li2" vid="1CH 2:46">Haran, Mosa ye Kases.</para>
  <para style="li2" vid="1CH 2:46">Haran akedo ete Kases.<verse eid="1CH 2:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47" />Mme nditọ ideen Yadai:</para>
  <para style="li2" vid="1CH 2:47">Rekem, Yọtam, Kesan, Pelet, Efa ye Saaf.<verse eid="1CH 2:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48" />Anwaan esa Kaleb a-akekereke Maaka akedo eka anọ</para>
  <para style="li2" vid="1CH 2:48">Seba ye Tihana.<verse eid="1CH 2:48" /></para>
  <para style="li2">
    <verse number="49" style="v" sid="1CH 2:49" />Anye amaanyʌñ aman Saaf a-akedooho ete anọ Madmana</para>
  <para style="li2" vid="1CH 2:49">ñko ye Sefa ete Makbena ye Kibie.</para>
  <para style="li1" vid="1CH 2:49">Ayịn Kaleb awonwaan akedo Aksa.<verse eid="1CH 2:49" /></para>
  <para style="li4">
    <verse number="50" style="v" sid="1CH 2:50" />Mme ntịppe ubon Kaleb ekedo ami.</para>
  <para style="b" vid="1CH 2:50" />
  <para style="li1" vid="1CH 2:50">Mme nditọ ideen Họọ akpa ayịn Efrata:</para>
  <para style="li2" vid="1CH 2:50">Sobal ete Kiriad Yerịm, <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />Salma ete Betlehem, ye Haref ete Bed Kade.<verse eid="1CH 2:51" /></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52" />Mbon ubon Sobal ete Kiriad Yerịm ekedoñño:</para>
  <para style="li2" vid="1CH 2:52">Haro, mbakka iba Manahad, <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />ye mme ubon Kiriad Yerịm: mbon Itraid, mbon Pud, Sumad ye mbon Misrai. Mmi ke ubon mbon Sora ye mbon Estaol aketọọñọ.<verse eid="1CH 2:53" /></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54" />Mbon ubon Salma:</para>
  <para style="li2" vid="1CH 2:54">Betlehem, mbon Netofa, Atrọd Bed Yoab, mbakka iba mbon Manahad, mbon Sora, <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />ye ake ubon mme awedñwed e-ekedʌññọ ke Yabes: mbon Tirad, Simied ye mbon Sukad. Ammọ ekedoñño mbon Keen e-eketooho ke Hamad edi, ete mbon Rekab.<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s2">Nditọ Ideen Defid</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 3:1" />Nditọ ideen ekemanna enọ Defid ke Hibrọn ekedoñño emi:</para>
  <para style="b" vid="1CH 3:1" />
  <para style="li1" vid="1CH 3:1">Akpan akedo Amnọn ayịn Ahinoam aketooho Yesriil;</para>
  <para style="li1" vid="1CH 3:1">Udọ akedo Dandiel ayịn Abikel ake Kamel;<verse eid="1CH 3:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 3:2" />ayọhọ ita akedo Absalọm ayịn Maaka ayịn awonwaan Talmai adidem Kesọọ;</para>
  <para style="li1" vid="1CH 3:2">ayọhọ inaañ akedo Adọniya ayịn Hakịd;<verse eid="1CH 3:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 3:3" />ayọhọ ition akedo Sefatia ayịn Abital;</para>
  <para style="li1" vid="1CH 3:3">ndin ayọhọ itiokeed akedo Itreem, aketooho anwaan amọ Ekla.<verse eid="1CH 3:3" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="4" style="v" sid="1CH 3:4" />Nditọ itiokeed ami ke ekeman enọ Defid ke Hibrọn, idaha anye akedaaha ukara nte adidem ke isua itiaba ye afiọñ itiokeed.</para>
  <para style="b" vid="1CH 3:4" />
  <para style="b" vid="1CH 3:4" />
  <para style="lh" vid="1CH 3:4">Defid amaakara ke Yeruselem ke isua edịb mme duob mme ita, <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />ndin mme nditọ se ekeman ke Yeruselem enọ anye edoñño ami:</para>
  <para style="b" vid="1CH 3:5" />
  <para style="li1" vid="1CH 3:5">Samua<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">Samua asʌk ado Simie</char></note>, Sobab, Natan ye Sọlọmọn. Bedseba ayịn awonwaan Amiel, akeman nditọ inaañ ami.<verse eid="1CH 3:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 3:6" />Mbon mfen ekedoñño Ibha, Elisua, Elifeled, <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />Noka, Nefek, Yafia, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />Elisama, Eliada ye Elifeled, afịd ekedoñño usʌkkeed.<verse eid="1CH 3:8" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="9" style="v" sid="1CH 3:9" />Afịd ami ekedoñño nditọ ideen Defid, ke esioho nditọ ideen amọ se ibaan esa amọ ekeman efep. Ndin Tama akedo ayịneka ammọ awonwaan.<verse eid="1CH 3:9" /></para>
  <para style="s2">Mme Ndidem Yuda</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10" />Ayịn Sọlọmọn akedo Rehoboam,</para>
  <para style="li1" vid="1CH 3:10">Abiya ayịn amọ,</para>
  <para style="li1" vid="1CH 3:10">Asa ayịn amọ,</para>
  <para style="li1" vid="1CH 3:10">Yehosafad ayịn amọ,<verse eid="1CH 3:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 3:11" />Yehoram<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">Ke Hibru Yehoram asʌk ado Yoram</char></note> ayịn amọ,</para>
  <para style="li1" vid="1CH 3:11">Ahasaiya ayịn amọ,</para>
  <para style="li1" vid="1CH 3:11">Yoas ayịn amọ,<verse eid="1CH 3:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 3:12" />Amasaiya ayịn amọ,</para>
  <para style="li1" vid="1CH 3:12">Asaria ayịn amọ,</para>
  <para style="li1" vid="1CH 3:12">Yọtam ayịn amọ,<verse eid="1CH 3:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 3:13" />Ahas ayịn amọ,</para>
  <para style="li1" vid="1CH 3:13">Hesikaiya ayịn amọ,</para>
  <para style="li1" vid="1CH 3:13">Manase ayịn amọ,<verse eid="1CH 3:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 3:14" />Amọn ayịn amọ,</para>
  <para style="li1" vid="1CH 3:14">Yosaiya ayịn amọ.<verse eid="1CH 3:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15" />Mme nditọ ideen Yosaiya:</para>
  <para style="li2" vid="1CH 3:15">Yohanan akpa ayịn,</para>
  <para style="li2" vid="1CH 3:15">Yehoiyakịm ayọhọ ayịn iba,</para>
  <para style="li2" vid="1CH 3:15">Sedekaiya ayọhọ ita,</para>
  <para style="li2" vid="1CH 3:15">Salum ayọhọ inaañ.<verse eid="1CH 3:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16" />Mbon ekedatta itie Yehoiyakịm:</para>
  <para style="li2" vid="1CH 3:16">Yehoiyakịn<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">Ke Hibru Yekonaiya asʌk ado ukem nte Yehoiyakịn; se ñko ke 1 Kr 3:17</char></note> ayịn amọ,</para>
  <para style="li2" vid="1CH 3:16">ye Sedekaiya.<verse eid="1CH 3:16" /></para>
  <para style="s2">Ntịppe Ubọọñ ke Isua Ufen Amaakekweeñe</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17" />Ntịppe ubon Yehoiyakịn ekesịnne ukad:</para>
  <para style="li2" vid="1CH 3:17">Sieltiel ayịn amọ, <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />Malkiram, Pedaiya, Senasa, Yekamia, Hosama ye Nedabia.<verse eid="1CH 3:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19" />Nditọ ideen Pedaiya:</para>
  <para style="li2" vid="1CH 3:19">Serubabel ye Simei.</para>
  <para style="li1" vid="1CH 3:19">Nditọ ideen Serubabel:</para>
  <para style="li2" vid="1CH 3:19">Mesulam ye Hananaiya. Selomid akedo ayịneka ammọ awonwaan. <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />Mme awo ition mfen emaeba: Hasuba, Ohel, Berekia, Hasadia ye Yusab-Hesed.<verse eid="1CH 3:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21" />Ntịppe ubon Hananaiya:</para>
  <para style="li2" vid="1CH 3:21">Pelatia ye Yesaiya, ndin ye nditọ ideen Refaiya, ake Anan, ye ake Obadaiya ndin ye ake Sekanaiya.<verse eid="1CH 3:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22" />Ntịppe ubon Sekanaiya:</para>
  <para style="li2" vid="1CH 3:22">Semaiya ye nditọ amọ ideen: Hatus, Ikal, Baria, Neeria ye Safad, afịd ammọ ekedoñño itiokeed.<verse eid="1CH 3:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23" />Mme nditọ ideen Neeria:</para>
  <para style="li2" vid="1CH 3:23">Elioenai, Hesikaiya ye Asrikam, afịd ammọ ekedoñño ita.<verse eid="1CH 3:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24" />Mme nditọ ideen Elioenai:</para>
  <para style="li2" vid="1CH 3:24">Hodafia, Eliasịb, Pelatia, Akub, Yohanan, Delaiya ye Anani, afịd ammọ ekedoñño itiaba.<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s2">Mme Abio Yuda Mfen</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 4:1" />Mme ntịppe ubon Yuda:</para>
  <para style="li2" vid="1CH 4:1">Peres, Hesrọn, Kaami, Họọ ye Sobal.<verse eid="1CH 4:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2" />Reiya ayịn Sobal akedo ete Yahad, ndin Yahad akedo ete Ahumai ye Lahad. Mme ubon Sora akedo ami.<verse eid="1CH 4:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3" />Mme nditọ ideen Etam ake Edọm:</para>
  <para style="li2" vid="1CH 4:3">Yesriil, Isma ye Idbas. Ayịneka ammọ awonwaan akekere Haseleponi. <verse eid="1CH 4:3" /><verse number="4" style="v" sid="1CH 4:4" />Penuel akedo ete Kedọ, ndin Esaa ado ete Husa.</para>
  <para style="li1" vid="1CH 4:4">Mbon se ikido ntịppe ubon Họọ ekedo ami, akpan Efrata ye ete Betlehem.<verse eid="1CH 4:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5" />Asọọ ete Tekoa akedọ ibaan iba, Hela ye Naara.<verse eid="1CH 4:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6" />Naara amaaman Ahusam, Hefa, Temeni ye Haahastari anọ anye. Mbon ami ekedoñño ntịppe Naara.<verse eid="1CH 4:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7" />Mme nditọ ideen Hela:</para>
  <para style="li2" vid="1CH 4:7">Sered, Soha, Etnan, <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />ye Kos, a-akedooho ete Anub ye Hasobeba ye mme ubon Ahahel ayịn Harum.<verse eid="1CH 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9" />Yabes amaanie ukpono akan nditọeka amọ ideen. Eka amọ akesio anye Yabes, abo ate, “Ami ñkeman anye ke ubiak.” <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />Yabes amaatua anọ Abasi Isrel, “Sai, afo akpekap andiọñ miin anyʌñ atat efaak mmi! Yak ubọk mfo aba ye ami, anyʌñ ansio miin ke idiọọk mbaak ami mbọkkọ ubiak.” Ndin Abasi amaanam ebeeñe amọ.<verse eid="1CH 4:10" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11" />Kelub, ayịneka awodeen Suha, akedo ete Mehia, a-akedooho ete Estọn. <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />Estọn akedo ete Bed Rafa, Pasei ye Tehina ete Ir Nahas. Mbon ami ekedoñño ideen ke abio Reka.<verse eid="1CH 4:12" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13" />Nditọ ideen Kenas:</para>
  <para style="li2" vid="1CH 4:13">Otniel ye Seraiya.</para>
  <para style="li1" vid="1CH 4:13">Nditọ ideen Otniel:</para>
  <para style="li2" vid="1CH 4:13">Hatad ye Meonotai. <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />Menotai akedo ete Ọfra.</para>
  <para style="li1" vid="1CH 4:14">Seraiya akedo ete Yoab,</para>
  <para style="li2" vid="1CH 4:14">ete Kee Harasim. Ekekoot anye anyịñ ami sia mbon ammọ ekedoñño nta mme anam utomusọ.<verse eid="1CH 4:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15" />Mme nditọ Kaleb ayịn Yefune:</para>
  <para style="li2" vid="1CH 4:15">Iru, Ela ye Naam.</para>
  <para style="li1" vid="1CH 4:15">Ayịn awodeen Ela:</para>
  <para style="li2" vid="1CH 4:15">Kenas.<verse eid="1CH 4:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16" />Mme nditọ ideen Yehalele:</para>
  <para style="li2" vid="1CH 4:16">Siif, Siifa, Tiria ye Asarel.<verse eid="1CH 4:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17" />Mme nditọ ideen Esra:</para>
  <para style="li2" vid="1CH 4:17">Yeta, Mered, Efa ye Yalọn.</para>
  <para style="li1" vid="1CH 4:17">Keed ke atu ibaan Mered akeman Miriam, Samai ye Isba ete Estemoa. <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />Nditọ se Bitia ayịn awonwaan Fero a-Mered akedọọhọ ekedo ami.</para>
  <para style="li1" vid="1CH 4:18">Anwaan amọ a-aketooho ekpək Yuda amaaman Yered ete Kedọ, Heba ete Soko, ye Yekutied ete Sanoa.<verse eid="1CH 4:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19" />Mme nditọ ideen anwan Hodia, a-akedooho ayịneka awonwaan Naham:</para>
  <para style="li2" vid="1CH 4:19">ete Keila awo Kaam, ye Estemoa awo Maakad.<verse eid="1CH 4:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20" />Mme nditọ ideen Simọn:</para>
  <para style="li2" vid="1CH 4:20">Amnọn, Rina, Ben-Hanan ye Tilọn.</para>
  <para style="li1" vid="1CH 4:20">Mme ntịppe ubon ake Isi:</para>
  <para style="li2" vid="1CH 4:20">Sohed ye Ben-Sohed.<verse eid="1CH 4:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21" />Nditọ ideen Sela ayịn Yuda:</para>
  <para style="li2" vid="1CH 4:21">Er akedo ete Leka, Laada ado ete Maresa ye mme ubon mme anam utom udʌk linen ke Bed Asbee,<verse eid="1CH 4:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 4:22" />Yokịm, mme ideen abio Koseba, ye Yoas ye Saraf, a-akekarake ke Mọb ye Yasubi Lehem. (Mme ñwednnịm ikọ ami edoñño ake usen esed.) <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />Ammọ ekedoñño mme abodabañ, e-ekebaññake ke Netaim ye Kedera; ammọ ekedʌñ do enyʌñ enam utom enọ adidem.<verse eid="1CH 4:23" /></para>
  <para style="s1">Simiọn</para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24" />Mme ntịppe ubon Simiọn:</para>
  <para style="li2" vid="1CH 4:24">Nemuel, Yamịn, Yarịb, Seera ye Sọọl;<verse eid="1CH 4:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25" />Salum akedo ayịn Sọọl, Mibsam ye Misma ekedoñño nditọ amọ ideen.<verse eid="1CH 4:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26" />Mme ntịppe ubon Misma:</para>
  <para style="li2" vid="1CH 4:26">Hamuel akedo ayịn amọ, Saku ye Simei ñko ekedoñño nditọ ideen amọ.<verse eid="1CH 4:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27" />Simei akenie nditọ ideen duob mme ition ye nditọ ibaan itiokeed, ado nditọeka amọ ideen ikinieghe uwak nditọ; ke ntoro afịd ubon ammọ ikiwakka nte mbon Yuda. <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />Ammọ ekedʌñọ ke Beeseba, Molada, Hasa Sual, <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />Bilha, Esem, Tolad, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />Betuel, Họma, Siklak, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />Bed Makabod, Hasa Susịm, Bed Biri ye Saaraim. Mme abio ammọ ekedoñño ami tutu adikem ini ukara adidem Defid. <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />Mme ñkanñkʌk abio ammọ ekedoñño Etam, Ain, Rimọn, Token ye Asan, abio ition, <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />ye afịd mme abio ekebaaha ekpere mme idịd ami tutu akewuọ Baalad. Mme itie idʌñ ammọ ekedoñño emi.</para>
  <para style="b" vid="1CH 4:33" />
  <para style="li4" vid="1CH 4:33">Ndin ammọ emaenịm ñwed mbʌk emana ammọ.<verse eid="1CH 4:33" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="34" style="v" sid="1CH 4:34" />Mesobab; Yamlek;</para>
  <para style="li1" vid="1CH 4:34">Yosaa ayịn Amasaiya; <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />Yuel;</para>
  <para style="li1" vid="1CH 4:35">Yehu ayịn Yosibia, a-akedooho ayịn Seraiya, ayịn Asiel;<verse eid="1CH 4:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 4:36" />ñko Elioenai; Yaakoba; Yesohaiya;</para>
  <para style="li1" vid="1CH 4:36">Asaiya; Adiel; Yesimiel; Benaiya;<verse eid="1CH 4:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 4:37" />ye Sisa ayịn Sifi, a-akedooho ayịn Alon, ayịn Yedaiya, ayịn Simri, ayịn Semaiya.<verse eid="1CH 4:37" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="38" style="v" sid="1CH 4:38" />Mme ideen e-ekoodo anyịñ ammọ mi ekedoñño mme adadusʌñ ke ubon ammọ.</para>
  <para style="b" vid="1CH 4:38" />
  <para style="p" vid="1CH 4:38">Ekpək ammọ amaatọt eti-eti, <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />ndin ammọ emaesanna ekpọñ Kedọ ke utịd usakkautịn ukañ itịkke adikiyem ndidia nnọọ ufene ammọ. <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />Ammọ emaekịt itie se ikifọn, ye nti mbid, isọñ ado amaanyʌñ anwaña, anaa sʌñ ke emem. Ubaak mbon Ham emaedọdʌñ do.<verse eid="1CH 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41" />Mme ideen e-ekewette anyịñ ammọ emaedi ke ayio Hesikaiya adidem Yuda. Ammọ emaenwana mbon Ham ke mme itie idʌñ ammọ enyʌñ enwana ye mbon Meunịm e-ekebaaha do ñko enyʌñ esobo ammọ afịd-afịd, tutu naña aba ke mfịn ami. Ndin ammọ emaedʌñ ke itie isọñ ammọ, sia ndidia amaaba anọ ufene ammọ. <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />Ndin awo ikie ition e-ekedooho mbon Simiọn, ake Pelatia, Neeria, Refaiya ye Usiel nditọ ideen Isi ekedatta usʌñ emaekaa ekeyọhọ abio edem abot Sei. <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />Ammọ emaewot mbon Amalek e-ekesʌhọke, ndin ammọ esʌk edọdʌñ do tutu asịm mfịn ami.<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s1">Rubịn</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 5:1" />Mme nditọ Rubịn a-akedooho akpa ayịn ke ufọk Isrel (anye akedo akpa ayịn, ado ke ini anye akesappake ñkpana ndọ ete amọ, emaeyaak mme unen amọ nte akpa ayịn enọ nditọ Yosef ayịn Isrel; ke ntoro anyịñ amọ ikisịneke ke ñwed emana ubon ado naña akpesaña akekem ye unen emana amọ, <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />akpesʌkado Yuda akedooho andisọñidem ñkan ke atu nditọeka amọ ideen, ndin andikara awuọ ato anye, unen mme akpa ayịn akenie Yosef), <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />mme nditọ ideen Rubịn akpa ayịn ke ubon Isrel:</para>
  <para style="b" vid="1CH 5:3" />
  <para style="li2" vid="1CH 5:3">Hanọk, Palu, Hesrọn ye Kaami.<verse eid="1CH 5:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4" />Ntịppe ubon Yuel:</para>
  <para style="li2" vid="1CH 5:4">Semaiya ado ayịn amọ, Kọk ñko ayịn amọ,</para>
  <para style="li2" vid="1CH 5:4">Simei ayịn amọ, <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />Maika ayịn amọ,</para>
  <para style="li2" vid="1CH 5:5">Reiya ayịn amọ, Baal ayịn amọ,<verse eid="1CH 5:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 5:6" />ndin Beera ayịn amọ awodeen, ake Tiklad-Pilesa<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">Ke Hibru Tiklad-Pilnesa asʌk ado Tiklad-Pilesa; se ñko ke 1 Kr 5:26</char></note> adidem Asiria akebenne anyọñ asen idịd. Beera akedo adadusʌñ ubon Rubịn.<verse eid="1CH 5:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7" />Mme nditọeka ammọ ke esiin, naña ekewet ke ñwed emana ammọ:</para>
  <para style="li2" vid="1CH 5:7">Yeiyel abọọñ ammọ, ye Sakaraiya, <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />ye Bela ayịn Asas, ayịn Sema, ayịn Yuel.</para>
  <para style="b" vid="1CH 5:8" />
  <para style="p" vid="1CH 5:8">Ammọ ekedʌñọ tọọñọ ke Arowa tutu aben akewuọ Nebo ye Baal Mọọn. <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />Ke edem ukañ usakkautịn ammọ ekedʌñọ ekpere akpautatan tutu akewuọ inyañ Yufretis, sia ufene ammọ amaawak ke Kilied.<verse eid="1CH 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 5:10" />Ke ayio ukara Sọọl ammọ emaenwana ekọñ ye mbon Haka, emaenyʌñ ekan ammọ; ammọ ekedʌñọ ke mme itieidʌñ mbon Haka ke afịd edem usakkautịn Kilied.<verse eid="1CH 5:10" /></para>
  <para style="s1">Kaad</para>
  <para style="li4">
    <verse number="11" style="v" sid="1CH 5:11" />Mbon Kad emaedʌñọ ekpere ammọ ke Basan, tutu akewuọ Saleka:<verse eid="1CH 5:11" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="12" style="v" sid="1CH 5:12" />Yuel akedo abọọñ, Safam ado udiana, ndin Yanai ye Safad, ke abio Basan.<verse eid="1CH 5:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13" />Mme ufọk ammọ, ke ubon ke ubon, ekedoñño:</para>
  <para style="li2" vid="1CH 5:13">Maikel, Mesulam, Seba, Yorai, Yakan, Sia ye Ebee, itiaba ke afịd.<verse eid="1CH 5:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14" />Nditọ ideen Abihel ayịn Huri ekedo ami: ayịn Yarowa, ayịn Kilied, ayịn Maikel, ayịn Yesisai, ayịn Yado, ayịn Bus.<verse eid="1CH 5:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15" />Ahi ayịn Abdiel, ayịn Kuuni, akedo abọọñ ufọk ammọ.<verse eid="1CH 5:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="1CH 5:16" />Mbon Kad ekedʌñọ ke Kilied ke abio Basan, ye ke mme ñkanñkʌk idʌñ, ye ke afịd isọñ awawa mbid ke Sarọn tutu akewuọ adaña.<verse eid="1CH 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17" />Emaewet afịd ami esịn ke ñwed emana ke ini ayio ukara Yọtam adidem Yuda ye ini Yerobuam adidem Isrel.<verse eid="1CH 5:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />Mbon ubon Rubịn, ye mbon Kad ye ubaak esiin Manase ekenie ibad awo tọsịn aba mme inaañ, mme ikie itiaba mme ata (44,760) e-ekebeeñeke idem ekọñ, mme akobidem ideen e-ekpekanna ekama atuekọñ ye akañkañ, e-enyʌññọ ekeme adikama utịgha, e-ekenyʌññọ ebọ ukpeeb adinwana ekọñ. <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />Ammọ emaenwana ekọñ ye mbon Haka, Yetọọ, Nafis ye Nodab. <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />Emaenwam ammọ adinwaña ekọñ ye ammọ, ndin Abasi amaayak mbon Haka ye afịd mme ufan ammọ asịn ammọ ke ubọk, sia ammọ emaeseeme ekoot anye ke idaha ekọñ ado. Anye amaabọọrọ akam ammọ, sia ammọ emaebuọt idem ye anye. <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />Ammọ emaekoono mme ufene mbon Haka kamel tọsịn aba mme duob (50,000), edọñ tọsịn ikie iba mme aba mme duob (250,000) ye dọñki tọsịn iba (2,000). Ammọ emaenyʌñ emʌm awo tọsịn ikie keed (100,000) enyọñ ke ñkanubọk, <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />uwak awo emaetak ke afịd, sia ekọñ akenie Abasi. Ndin ammọ emaedʌñ ke isọñ ado tutu adikem idaha ebịneke ammọ esioño.<verse eid="1CH 5:22" /></para>
  <para style="s1">Mbakka Iba Ubon Mbon Manase</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />Mbon awo ke mbakka iba esiin Manase emaewak eti-eti; ammọ ekedʌñọ ke isọñ tọọñọ ke Basan aben akewuọ Baal Hemọn, a-adooho ke Seni (Abod Hemọn).<verse eid="1CH 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 5:24" />Mbon se ikido mme iwuod ke ubon ammọ ekedom: Efa, Isi, Eliel, Asriel, Yerimaiya, Hodafia ye Yadiel. Ammọ ekedoñño mbon uko, mme awuọ etob awo ye mme adaiwuod ke ubon ammọ. <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" />Ado ammọ ikinamma akpanikọ ye Abasi mme eteete ammọ, emaenyʌñ enam akpara ye mme abasi mbon idʌñ, ado Abasi amaakebiat ke iso ammọ. <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />Ndin Abasi Isrel amaabukko sịbidịd Pul adidem Asiria (a-adooho, Tiklad-Pilesa adidem Asiria), a-akebenne mbon Rubịn, mbon Kad ye ubaak esiin Manase asioño aka asen idịd. Anye amaaben ammọ akaa Hala, Habọ, Hara ye ke inyañ Kosan, ake ammọ ebaññake tutu mfịn ami.<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s1">Lifai</para>
  <para style="li1">
    <note caller="+" style="f">
      <char style="fr" closed="false">6: </char>
      <char style="ft" closed="false">Ke Hibru 1 Kr 6:1-15 ewet 1 Kr 5:27-41, ñko 1 Kr 6:16-81 ewet 1 Kr 6:1-66</char>
    </note> <verse number="1" style="v" sid="1CH 6:1" />Mme nditọ ideen Lifai:</para>
  <para style="li2" vid="1CH 6:1">ekedoñño Kesọn, Kohad ye Merari.<verse eid="1CH 6:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2" />Mme nditọ ideen Kohad:</para>
  <para style="li2" vid="1CH 6:2">Amram, Isaa, Hibrọn ye Usiel.<verse eid="1CH 6:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3" />Mme nditọ Amram:</para>
  <para style="li2" vid="1CH 6:3">Erọn, Moses ye Miriam.</para>
  <para style="li1" vid="1CH 6:3">Mme nditọ ideen Erọn:</para>
  <para style="li2" vid="1CH 6:3">ekedoñño Nadab, Abihu, Eliasa ye Itama.<verse eid="1CH 6:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4" />Eliasa akedo ete anọ Finehas,</para>
  <para style="li2" vid="1CH 6:4">Finehas ete Abisua,<verse eid="1CH 6:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5" />Abisua ete Buki,</para>
  <para style="li2" vid="1CH 6:5">Buki ete Usi<verse eid="1CH 6:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6" />Usi ete Serahaiya,</para>
  <para style="li2" vid="1CH 6:6">Serahaiya ete Meraiyọd,<verse eid="1CH 6:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7" />Meraiyọd ete Amaria,</para>
  <para style="li2" vid="1CH 6:7">Amaria ete Ahitub,<verse eid="1CH 6:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8" />Ahitub ete Sadọk,</para>
  <para style="li2" vid="1CH 6:8">Sadọk ete Ahimaas,<verse eid="1CH 6:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9" />Ahimaas ete Asaria,</para>
  <para style="li2" vid="1CH 6:9">Asaria ete Yohanan,<verse eid="1CH 6:9" /></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10" />Yohanan ete Asaria.</para>
  <para style="li2" vid="1CH 6:10">Asaria akedo aku a-akenamma utom ke tembịd Sọlọmọn akebọppọ ke Yeruselem.<verse eid="1CH 6:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11" />Asaria akedo ete Amaria,</para>
  <para style="li2" vid="1CH 6:11">Amaria ete Ahitub,<verse eid="1CH 6:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12" />Ahitub ete Sadọk,</para>
  <para style="li2" vid="1CH 6:12">Sadọk ete Salum,<verse eid="1CH 6:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13" />Salum ete Hilkia,</para>
  <para style="li2" vid="1CH 6:13">Hilkia ete Asaria,<verse eid="1CH 6:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14" />Asaria ete Seraiya,</para>
  <para style="li2" vid="1CH 6:14">ndin Seraiya akedo ete Yosadak<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">Ke Hibru Yosadak ado ukem nte Yehosadak; se ñko 1 Kr 6:15</char></note>.<verse eid="1CH 6:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 6:15" />Ekebịne Yosadak esio idaha <char style="nd">Abọọñ</char> akebịneke Yuda ye Yeruselem asịn ke asen idịd ato ke ubọk Nebukadnesa.<verse eid="1CH 6:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16" />Mme nditọ ideen Lifai:</para>
  <para style="li2" vid="1CH 6:16">Kesọn<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">Ke Hibru Kesọn asʌk ado Kesọm; se ñko ke 1 Kr 6:17, 20, 43, 62 ye 71</char></note>, Kohad ye Merari.<verse eid="1CH 6:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17" />Anyịñ nditọ ideen Kesọn edoñño ami:</para>
  <para style="li2" vid="1CH 6:17">Libni ye Simei.<verse eid="1CH 6:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18" />Mme nditọ ideen Kohad:</para>
  <para style="li2" vid="1CH 6:18">Amram, Isaa, Hibrọn ye Usiel.<verse eid="1CH 6:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19" />Mme nditọ ideen Merari:</para>
  <para style="li2" vid="1CH 6:19">Mahli ye Musi.</para>
  <para style="b" vid="1CH 6:19" />
  <para style="li4" vid="1CH 6:19">Ubon mme nditọ Lifai edoñño ami e-ebatta ekeene mme ete ammọ:<verse eid="1CH 6:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20" />Ake Kesọn:</para>
  <para style="li2" vid="1CH 6:20">Libni ayịn amọ, Yahad ayịn amọ,</para>
  <para style="li2" vid="1CH 6:20">Sima ayịn amọ, <verse eid="1CH 6:20" /><verse number="21" style="v" sid="1CH 6:21" />Yoa ayịn,</para>
  <para style="li2" vid="1CH 6:21">Iddo ayịn amọ, Seera ayịn amọ</para>
  <para style="li2" vid="1CH 6:21">ndin Yeterai ayịn amọ.<verse eid="1CH 6:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22" />Mme ntịppe ubon Kohad:</para>
  <para style="li2" vid="1CH 6:22">Aminadab ayịn amọ, Kora ayịn amọ,</para>
  <para style="li2" vid="1CH 6:22">Asiaa ayịn amọ, <verse eid="1CH 6:22" /><verse number="23" style="v" sid="1CH 6:23" />Elkana ayịn amọ,</para>
  <para style="li2" vid="1CH 6:23">Ebiasaf ayịn amọ, Asiaa ayịn amọ,<verse eid="1CH 6:23" /></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24" />Tahad ayịn amọ, Uriel ayịn amọ,</para>
  <para style="li2" vid="1CH 6:24">Usaiya ayịn amọ ye Sọọl ayịn amọ.<verse eid="1CH 6:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25" />Mme ntịppe ubon Elkana:</para>
  <para style="li2" vid="1CH 6:25">Amasai, Ahimod,<verse eid="1CH 6:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 6:26" />Elkana ayịn amọ, Sofai ayịn amọ,</para>
  <para style="li2" vid="1CH 6:26">Nahad ayịn amọ, <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" />Eliab ayịn amọ,</para>
  <para style="li2" vid="1CH 6:27">Yeroham ayịn amọ, Elkana ayịn amọ</para>
  <para style="li2" vid="1CH 6:27">ye Samwel ayịn amọ.<verse eid="1CH 6:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28" />Mme nditọ ideen Samwel:</para>
  <para style="li2" vid="1CH 6:28">Yuel akedo akpa ayịn</para>
  <para style="li2" vid="1CH 6:28">ndin Abiya ado ayọhọ ayịn iba.<verse eid="1CH 6:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29" />Mme ntịppe ubon Merari:</para>
  <para style="li2" vid="1CH 6:29">Mahli, Libni ayịn amọ,</para>
  <para style="li2" vid="1CH 6:29">Simei ayịn amọ, Usa ayịn amọ,<verse eid="1CH 6:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 6:30" />Simei ayịn amọ, Hakia ayịn amọ</para>
  <para style="li2" vid="1CH 6:30">ye Asaiya ayịn amọ.<verse eid="1CH 6:30" /></para>
  <para style="s2">Mme Akwọikwọ ke Tembịd</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />Mme ideen se Defid akesioño anịm abo yak ese ñkpọ ebaña ikwọ ke ufọk <char style="nd">Abọọñ</char> idaha akebe edioomo akedinaaha do aduọk adudu edoñño ami. <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />Ammọ emaekwọ ikwọ ke iso atayad, ke atayad mbono, tutu adiwuọ idaha Sọlọmọn akebọppọ itie ukpono <char style="nd">Abọọñ</char> ke Yeruselem. Ammọ emaenam utom naña nte ndutʌm e-ekewette enịm enọ ammọ akesaña.<verse eid="1CH 6:32" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="33" style="v" sid="1CH 6:33" />Mme ideen se ikinam utom keed ye nditọ ideen ammọ edo ami:</para>
  <para style="b" vid="1CH 6:33" />
  <para style="li1" vid="1CH 6:33">Tọọñọ ke mbon Kohad:</para>
  <para style="li2" vid="1CH 6:33">ekedo Heman, awo akwọikwọ,</para>
  <para style="li2" vid="1CH 6:33">ayịn Yuel, ayịn Samwel,<verse eid="1CH 6:33" /></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34" />ayịn Elkana, ayịn Yeroham,</para>
  <para style="li2" vid="1CH 6:34">ayịn Eliel, ayịn Toa,<verse eid="1CH 6:34" /></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 6:35" />ayịn Suuf, ayịn Elkana,</para>
  <para style="li2" vid="1CH 6:35">ayịn Mahad, ayịn Amasai,<verse eid="1CH 6:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36" />ayịn Elkana, ayịn Yuel,</para>
  <para style="li2" vid="1CH 6:36">ayịn Asaria, ayịn Sefanaiya,<verse eid="1CH 6:36" /></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 6:37" />ayịn Tahad, ayịn Asiaa,</para>
  <para style="li2" vid="1CH 6:37">ayịn Ebiasaf, ayịn Kora,<verse eid="1CH 6:37" /></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 6:38" />ayịn Isaa, ayịn Kohad,</para>
  <para style="li2" vid="1CH 6:38">ayịn Lifai, ayịn Isrel,<verse eid="1CH 6:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39" />ye Heman awo nsaña Asaf, a-akedaaha anye ke ubọk nnasia:</para>
  <para style="li2" vid="1CH 6:39">Asaf ayịn Berekia, ayịn Simei,<verse eid="1CH 6:39" /></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40" />ayịn Maikel, ayịn Baaseiya,</para>
  <para style="li2" vid="1CH 6:40">ayịn Malkiya, <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />ayịn Etni,</para>
  <para style="li2" vid="1CH 6:41">ayịn Seera, ayịn Adaiya,<verse eid="1CH 6:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42" />ayịn Etan, ayịn Sima,</para>
  <para style="li2" vid="1CH 6:42">ayịn Simei <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />ayịn Yahad,</para>
  <para style="li2" vid="1CH 6:43">ayịn Kesọn, ayịn Lifai;<verse eid="1CH 6:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44" />ndin tọọñọ ke mme nsaña ammọ, mbon Merari, ekebañña ke ubọk ufiin amọ:</para>
  <para style="li2" vid="1CH 6:44">Etan akedo ayịn Kisi, ayịn Abdi,</para>
  <para style="li2" vid="1CH 6:44">ayịn Maluk <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />ayịn Hasabaiya,</para>
  <para style="li2" vid="1CH 6:45">ayịn Amasaiya, ayịn Hilkia,<verse eid="1CH 6:45" /></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 6:46" />ayịn Amsi, ayịn Bani,</para>
  <para style="li2" vid="1CH 6:46">ayịn Sema, <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />ayịn Mahli,</para>
  <para style="li2" vid="1CH 6:47">ayịn Musi, ayịn Merari,</para>
  <para style="li2" vid="1CH 6:47">ayịn Lifai.<verse eid="1CH 6:47" /></para>
  <para style="b" />
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />Mme mbon Lifai ammọ ke ekedeeme afịd mme ubiọñutom se ikisʌhọ ke tabanakịd, ufọk Abasi enọ. <verse eid="1CH 6:48" /><verse number="49" style="v" sid="1CH 6:49" />Ado Erọn ye mbon ubon ammọ ekedoñño mbon se ikiben ñkpọ ufọb uwa idi ke itie akpokoro uwa ye ke akpokoro itie ufọb insensi nọ akekem ye afịd se ekenam ke Ata Adisana Itie, ke adinam ñkpeubọk nnọ Isrel, naña asaña akekem ke afịd se Moses isʌñutom Abasi aketemme.<verse eid="1CH 6:49" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50" />Mme ntịppe ubon Erọn ekedom:</para>
  <para style="li2" vid="1CH 6:50">Eliasa ayịn amọ, Finehas ayịn amọ,</para>
  <para style="li2" vid="1CH 6:50">Abisua ayịn amọ, <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />Buki ayịn amọ,</para>
  <para style="li2" vid="1CH 6:51">Usi ayịn amọ, Serahaiya ayịn amọ,<verse eid="1CH 6:51" /></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52" />Meraiyọd ayịn amọ, Amaria ayịn amọ,</para>
  <para style="li2" vid="1CH 6:52">Ahitub ayịn amọ, <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />Sadọk ayịn amọ</para>
  <para style="li2" vid="1CH 6:53">ye Ahimaas ayịn amọ.<verse eid="1CH 6:53" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="54" style="v" sid="1CH 6:54" />Mme itie idʌñ ekedeemeke enọ ammọ adidʌñ nte idʌñ ammọ (ekenọ ammọ ntịppe ubon Erọn e-eketooho ubon Kohad, sia akpa udeeme akenie ammọ):<verse eid="1CH 6:54" /></para>
  <para style="li1">
    <verse number="55" style="v" sid="1CH 6:55" />Ke abio Yuda ekenọ ammọ Hibrọn ye mme ñkanñkʌk inwañ amọ. <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />(Ado mme inwañ ye mme abio e-ekannake idʌñ ado ekenọ Kaleb ayịn Yefune.) <verse eid="1CH 6:56" /><verse number="57" style="v" sid="1CH 6:57" />Ke ntoro ekenọ ntịppe ubon Erọn itie Hibrọn (idʌñ itie ubọkkọ), ye Libna, Yattia, Estemoa, <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />Hilen, Debi, <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />Asan, Yuta ye Bed Semes, ediana ye afịd mfọọn inwañ mbid ammọ.<verse eid="1CH 6:59" /></para>
  <para style="li1">
    <verse number="60" style="v" sid="1CH 6:60" />Ndin tọọñọ ke aduuk Benyamin, ekenọ ammọ Kibiọn, Keba, Alemed ye Anatod, adiana keed ye mme mben inwañ mbid ammọ.</para>
  <para style="li4" vid="1CH 6:60">Afịd ibad mme idʌñ se ekedeeme ke atu ufọọd mbon Koha akedo duob mme ita.<verse eid="1CH 6:60" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="61" style="v" sid="1CH 6:61" />Ekedeeme abio duob enọ mme ntịppe esiin Kohad ke atu ubaak mbakka iba ke se ekenọ ubon Manase.<verse eid="1CH 6:61" /></para>
  <para style="li1">
    <verse number="62" style="v" sid="1CH 6:62" />Emaedeeme ke esiin ke esiin enọ mme ntịppe ubon Kesọn, abio duob mme ita, ato ke aduuk Isaka, Asaa ye Naftali, ndin ye ubaak aduuk Manase a-abaaha ke Basan.<verse eid="1CH 6:62" /></para>
  <para style="li1">
    <verse number="63" style="v" sid="1CH 6:63" />Mme ntịppe ubon Merari, esiin ke esiin, ekedeeme abio duob mme iba enọ ammọ eto ke aduuk mme Rubịn, Kad ye Sebulọn.<verse eid="1CH 6:63" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="64" style="v" sid="1CH 6:64" />Ndin nditọ Isrel emaenọ mme Lifai mme abio ami ye mme inwañ mbid ammọ.<verse eid="1CH 6:64" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="65" style="v" sid="1CH 6:65" />Tọọñọ ke aduuk Yuda, Simiọn ye Benyamin ammọ emaedeeme mme abio se emaekesiasiak anyịñ.<verse eid="1CH 6:65" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="66" style="v" sid="1CH 6:66" />Emaeyaak ubaak itie idʌñ mbon Kohad enọ nte mme abio se ikito ke ubon Ifrem.<verse eid="1CH 6:66" /></para>
  <para style="li1">
    <verse number="67" style="v" sid="1CH 6:67" />Ke ñkañ anyọñ-anyọñ abio Ifrem ekenọ ammọ Sekem (idʌñ ubọkkọ), ye Kesa, <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />Yekmeem, Bed Họrọn, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />Aiyalọn ye Kad Rimọn, adiana keed ye mme inwañ mbid ammọ.<verse eid="1CH 6:69" /></para>
  <para style="li1">
    <verse number="70" style="v" sid="1CH 6:70" />Ndin tọọñọ ke mbakka iba ubon Manase nditọ Isrel emaenọ Anee ye Bileem, adiana keed ye mme inwañ mbid ammọ, tutu akewuọ utịd ñkañ ubon esiin mme Kohad.<verse eid="1CH 6:70" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="71" style="v" sid="1CH 6:71" />Mme mbon Kesọn emaebọ itie ami:</para>
  <para style="li1" vid="1CH 6:71">Tọọñọ ke mbakka iba aduuk nditọ Manase ammọ emaebọ Kolan ke Basan ye Astarọd, adiana keed ye mme inwañ mbid ammọ;<verse eid="1CH 6:71" /></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72" />ke aduuk Isaka ammọ emaebọ Kedes, Daberad, <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />Ramọd ye Anem, adiana ye mme inwañ mbid ammọ;<verse eid="1CH 6:73" /></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74" />ke aduuk Asaa ammọ emaebọ Masal, Abdọn, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />Hukọk ye Rehob, adiana ye mme inwañ mbid ammọ;<verse eid="1CH 6:75" /></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76" />ndin ke aduuk Naftali ammọ emaebọ Kedes ke Kalili, Hamọn ye Kiriataim, adiana ye mme inwañ mbid ammọ.<verse eid="1CH 6:76" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="77" style="v" sid="1CH 6:77" />Mbon Merari (ubaak mbon Lifai) emaebọ mme itie ami:</para>
  <para style="li1" vid="1CH 6:77">Tọọñọ ke aduuk Sebulọn ammọ emaebọ Yokneem, Kata, Rimọnọ ye Tabọ, adiana keed ye mme inwañ mbid ammọ;<verse eid="1CH 6:77" /></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78" />ke aduuk Rubịn ke edem ñkan Yọdan ke ñkan usakkautịn Yeriko ammọ emaebọ Besa ke anaan, Yahas, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />Kedemọd ye Mefaad, adiana ye mme inwañ mbid ammọ;<verse eid="1CH 6:79" /></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80" />ndin tọọñọ ke aduuk Kad ammọ emaebọ Ramọd ke Kilied, Mahanaim, <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />Hesbọn ye Yasa adiana ye mme inwañ mbid ammọ.<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s1">Isaka</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 7:1" />Mme nditọ ideen Isaka:</para>
  <para style="li2" vid="1CH 7:1">Tola, Pua, Yasub ye Simrọn, inaañ ke afịd.<verse eid="1CH 7:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2" />Mme nditọ ideen Tola:</para>
  <para style="li2" vid="1CH 7:2">Usi, Refaiya, Yeriel, Yamai, Ibsam ye Samwel, mme adaiwuod ufọk ammọ. Ke idaha ukara Defid, mme ntịppe ubon Tola ekediọọñọke nte mbon anwan ke ubon ammọ ekedo tọsịn edịb mme iba mme ikie itiokeed (22,600).<verse eid="1CH 7:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3" />Ayịn awodeen Usi:</para>
  <para style="li2" vid="1CH 7:3">Israhia.</para>
  <para style="li1" vid="1CH 7:3">Mme nditọ ideen Israhia:</para>
  <para style="li2" vid="1CH 7:3">Maikel, Obadaiya, Yuel ye Isia. Afịd ammọ awo ition ekedoñño mme mbọọñ. <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />Ke naña ñwed ntịppe emana ubon ammọ atañ, ammọ ekenie awo tọsịn edịb mme duob mme itiokeed (36,000) ke mbeeñeidem anwan, sia ammọ emaenie uwak ibaan ndọ ye ntəkayịn.<verse eid="1CH 7:4" /></para>
  <para style="li4">
    <verse number="5" style="v" sid="1CH 7:5" />Mme nditọete ammọ e-ekedoññoke mme anwana ekọñ e-eketooho afịd mme ubon Isaka, naña ewet ke ntịppe emana ammọ, ekedo awo tọsịn anaañ mme itiaba (87,000) ke afịd.<verse eid="1CH 7:5" /></para>
  <para style="s1">Benyamin</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6" />Nditọ ideen Benyamin ita:</para>
  <para style="li2" vid="1CH 7:6">Bela, Beka ye Yediayel.<verse eid="1CH 7:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7" />Nditọ ideen Bela:</para>
  <para style="li2" vid="1CH 7:7">Esbon, Usi, Usiel, Yerimọd ye Iri, mme adaiwuod ke mme ufọk naña afịd ition. Mme ñwed ntịppe emana ammọ akebat mbon anwan awo tọsịn edịb mme iba mme edịb mme duob mme inaañ (22,034).<verse eid="1CH 7:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8" />Mme nditọ ideen Beka:</para>
  <para style="li2" vid="1CH 7:8">Semira, Yoas, Eliesa, Elioenai, Omri, Yeremọd, Abiya, Anatod ye Alemed. Afịd ami ekedo nditọ ideen Beka. <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />Ke mme ñwed ntịppe emana ammọ emaewet mme iwuod ufọk ye mbio anwan awo tọsịn edịb mme ikie iba (20,200).<verse eid="1CH 7:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10" />Ayịn awodeen Yediayel:</para>
  <para style="li2" vid="1CH 7:10">Bilhan.</para>
  <para style="li1" vid="1CH 7:10">Mme nditọ ideen Bilhan:</para>
  <para style="li2" vid="1CH 7:10">Yeus, Benyamin, Ehud, Kenaana, Setan, Taasis ye Ahisaha. <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />Afịd nditọ ideen Yediayel ami ekedoñño mme adaiwuod ufọk. Mbon anwan awo tọsịn duob mme itiaba mme ikie iba (17,200) emaeba ke mbeeñeidem adiwuọ ñkaa ekọñ.<verse eid="1CH 7:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12" />Mbon Supịm ye Hupịm ekedoñño ntịppe ubon Ir, ye mme Husịm ntịppe ubon Ahaa.<verse eid="1CH 7:12" /></para>
  <para style="s1">Naftali</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13" />Mme nditọ ideen Naftali:</para>
  <para style="li2" vid="1CH 7:13">ekedoñño Yasiel, Kuuni, Yesa ye Silem, ntịppe ubon Bilha.<verse eid="1CH 7:13" /></para>
  <para style="s1">Manase</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14" />Mme ntịppe ubon Manase:</para>
  <para style="li2" vid="1CH 7:14">Asriel akedo ntịppe ubon a-aketooho anwaan esa amọ a-akedooho awonwaan Aram. Anye amaaman Makia ete Kilied. <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />Makia amaadat anwaan amọ ato mbon Hupịm ye Supịm. Anyịñ ayịneka amọ awonwaan akedo Maaka. Ntịppe ubon mfen akekere Selofehad, a-akenieghe nditọ ibaan ikpọọñ. <verse eid="1CH 7:15" /><verse number="16" style="v" sid="1CH 7:16" />Anwaan Makia a-akekereke Maaka amaaman ayịn ndin esio anye anyịñ Peres. Ayịneka amọ awodeen akekere Seres, ndin nditọ amọ ideen ekedoñño Ulam ye Rakem.<verse eid="1CH 7:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17" />Ayịn awodeen Ulam:</para>
  <para style="li2" vid="1CH 7:17">Bedan.</para>
  <para style="li1" vid="1CH 7:17">Mbon se ikido nditọ Kilied ayịn Makia, ayịn Manase ekedom.<verse eid="1CH 7:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 7:18" />Ayịneka amọ awonwaan Hamoleked amaaman Isọd, Abiesa ye Mahla.<verse eid="1CH 7:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19" />Nditọ ideen Semida ekedo:</para>
  <para style="li2" vid="1CH 7:19">Ahian, Sekem, Liki ye Aniam.<verse eid="1CH 7:19" /></para>
  <para style="s1">Ifrem</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20" />Mme ntịppe ubon Ifrem:</para>
  <para style="li2" vid="1CH 7:20">Sutela, Bered ayịn amọ,</para>
  <para style="li2" vid="1CH 7:20">Tahad ayịn amọ, Elieda ayịn amọ,</para>
  <para style="li2" vid="1CH 7:20">Tahad ayịn amọ, <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />Saabad ayịn amọ</para>
  <para style="li2" vid="1CH 7:21">ye Sutela ayịn amọ.</para>
  <para style="li2" vid="1CH 7:21">(Esaa ye Elied ke mme amanaisọñ mbon Kad ekewot, ke idaha ammọ ekekaaha adibọ ufene ammọ. <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />Ifrem ete ammọ amaatua ayịd abaña ammọ ke uwak usen, ndin mbon atʌñ amọ emaedi edidọñ anye esịd. <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />Akem anye amaana anam ima ye anwaan amọ, ndin anye amaayommo anyʌñ aman ayịn. Anye amaasio anye anyịñ Beria, sia ndiọọkiso amaaba ke ubon amọ. <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />Ayịn amọ awonwaan akedo Seera, a-akebọppọ idak ye anyọñ Bed Họrọn ñko ye Useen Seera.)<verse eid="1CH 7:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 7:25" />Refa akedo ayịn amọ, Resef ñko akedo ayịn amọ,</para>
  <para style="li2" vid="1CH 7:25">Tela kpa ayịn amọ, Tahan ayịn amọ,<verse eid="1CH 7:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 7:26" />Ladan ayịn amọ, Amihud ayịn amọ,</para>
  <para style="li2" vid="1CH 7:26">Elisama ayịn amọ, <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />Nọn ayịn amọ</para>
  <para style="li2" vid="1CH 7:27">ye Yọsua ayịn amọ.<verse eid="1CH 7:27" /></para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 7:28" />Isọñ ammọ ye itie idʌñ ammọ amaawuọ Beteel ye mme ñkanñkʌk abio, Naaran ke edem usakkautịn, Kesa ye mme abio amọ ke edem usobutịn, ndin Sekem ye afịd mme abio amọ eba tutu akewuọ Ayaa ye mme abio amọ. <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />Mme idʌñ se ikiba ke mme adaña Manase ekedo Bed San, Taanak, Mekido ye Dọọ, ukem-ukem ye mme abio ammọ. Mme ubon Yosef, ayịn Isrel emaedʌñ ke mme abio ado.<verse eid="1CH 7:29" /></para>
  <para style="s1">Asaa</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30" />Mme nditọ ideen Asaa:</para>
  <para style="li2" vid="1CH 7:30">Imna, Isfa, Isfi ye Beria. Ayịneka ammọ awonwaan akedo Sera.<verse eid="1CH 7:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31" />Mme nditọ Beria:</para>
  <para style="li2" vid="1CH 7:31">Heba ye Malkiel, a-akedooho ete Bisaid.<verse eid="1CH 7:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32" />Heba akedo ete Yafled, Soma ye Hotam ye ayịneka ammọ awonwaan Sua.<verse eid="1CH 7:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33" />Mme nditọ ideen Yafled:</para>
  <para style="li2" vid="1CH 7:33">Pasak, Bimhal ye Asfad.</para>
  <para style="li4" vid="1CH 7:33">Mme nditọ ideen Yafled ekedoñño ami:<verse eid="1CH 7:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34" />Mme nditọ ideen Soma:</para>
  <para style="li2" vid="1CH 7:34">Ahi, Roka, Huba ye Aram.<verse eid="1CH 7:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35" />Nditọ ideen ayịneka amọ Helem ekedoñño:</para>
  <para style="li2" vid="1CH 7:35">Sofa, Imna, Seles ye Amal.<verse eid="1CH 7:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36" />Mme nditọ ideen Sofa:</para>
  <para style="li2" vid="1CH 7:36">Suwa, Hanefa, Sual, Beri, Imra, <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />Besa, Hod, Sama, Silsa, Itran ye Bera.<verse eid="1CH 7:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38" />Mme nditọ ideen Yeta:</para>
  <para style="li2" vid="1CH 7:38">Yefune, Pispa ye Ara.<verse eid="1CH 7:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39" />Mme nditọ ideen Ulla:</para>
  <para style="li2" vid="1CH 7:39">Ara, Haniel ye Risia.<verse eid="1CH 7:39" /></para>
  <para style="li4">
    <verse number="40" style="v" sid="1CH 7:40" />Afịd ami ekedo mme ntịppe ubon Asaa, mme adadusʌñ ke ufọk, ñwuọnda ideen, ñkpọsọñ mme anwana ekọñ ye mme awuọiso awo. Mme ideen se ikibeeñe idem unwana ekọñ naña ebat ke ñwed ubon ammọ akedo awo tọsịn edịb mme itiokeed (26,000).<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s1">Ntịppe Emana Sọọl ake Aketooho Benyamin</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 8:1" />Benyamin akedo ete anọ:</para>
  <para style="li2" vid="1CH 8:1">Bela akpan ayịn amọ,</para>
  <para style="li2" vid="1CH 8:1">Asbel udọ amọ, Ahara ado etəkudọ,<verse eid="1CH 8:1" /></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 8:2" />Noha ayọhọ ayịn inaañ ye Rafa ayọhọ ayịn ition.<verse eid="1CH 8:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3" />Nditọ ideen Bela ekedoñño:</para>
  <para style="li2" vid="1CH 8:3">Ada, Kera, Abihud, <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />Abisua, Neman, Ahoa, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />Kera<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">Kera ado ete Ehud</char></note>, Sefufan ye Huram.<verse eid="1CH 8:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6" />Mbon ami ekedoñño mme ntịppe ubon Ehud, ekedooho mme adaiwuod ufọk enọ mme andidʌñ ke Keba ye mbon se eketañ nọ ekaa abio Manahad:<verse eid="1CH 8:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7" />Neman, Ahiya, ye Kera, e-eketañña ammọ ndin akenyʌññọ ado ete Usa ye Ahihud.<verse eid="1CH 8:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8" />Emaeman nditọ ideen enọ Saharaim ke Mọb ke anye amaakesio mme ibaan amọ Husịm ye Baara ndọ. <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />Aketo anwaan amọ Hodes anye amaanie Yobab, Sibia, Mesa, Malkam, <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />Yeus, Sakia ye Meema. Mme nditọ ideen amọ ekedom, mme adaiwuod ufọk. <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />Anye amaanie Abitub ye Elpaal ato anwaan amọ Husịm.<verse eid="1CH 8:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12" />Nditọ ideen Elpaal:</para>
  <para style="li2" vid="1CH 8:12">ekedoñño Ebee, Misam, Semed (a-akebọppọ Ọnọ ye Lod ye mme ñkanñkʌk idʌñ), <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />ndin Beria ye Sema, ekedooho mme adaiwuod ufọk enọ mme andidʌñ ke Aiyalọn ndin ye andikibịne mme andidʌñ ke Kad nsioño.<verse eid="1CH 8:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14" />Ahio, Sasak, Yeremọd, <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />Sebadaiya, Arad, Eda, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />Maikel, Ispa ye Yoha ekedoñño nditọ ideen Beria.<verse eid="1CH 8:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17" />Sebadaiya, Mesulam, Hiski, Heba, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />Ismerai, Islia ye Yobab ekedoñño nditọ ideen Elpaal.<verse eid="1CH 8:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19" />Yakịm, Sikri, Sabdi, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />Elienai, Siletai, Eliel, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />Adaiya, Beraiya ye Simrad ekedoñño nditọ ideen enọ Simei.<verse eid="1CH 8:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22" />Ispan, Eba, Eliel, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />Abdọn, Sikri, Hanan, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />Hananaiya, Elam, Antọtiya, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />Ifdeiya ye Penuel ekedoñño nditọ ideen enọ Sasak.<verse eid="1CH 8:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26" />Samserai, Seharia, Atalia, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />Yaaresia, Elaiya ye Sikri ekedoñño nditọ ideen Yeroham.<verse eid="1CH 8:27" /></para>
  <para style="li4">
    <verse number="28" style="v" sid="1CH 8:28" />Afịd mbon ami ekedoñño mme adaiwuod ufọk, mme mbọọñ naña ewet ke ñwed ntịppe ubon ammọ, ndin ammọ ekedʌñọ ke Yeruselem.<verse eid="1CH 8:28" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29" />Yeiyel ete Kibiọn akedʌñ ke Kibiọn.</para>
  <para style="li2" vid="1CH 8:29">Anyịñ anwaan amọ akedo Maaka, <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />ndin akpa ayịn amọ akedo Abdọn, mbon se ikidiana ekedoñño Su, Kisi, Baal, Ner, Nadab, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />Kedọ, Ahio, Seka <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />ye Miklọd, a-akedooho ete Simee. Ammọ ñko emaedʌñ ekpere mme ekpək ammọ ke Yeruselem.<verse eid="1CH 8:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33" />Nee akedo ete Kisi, Kisi ado ete Sọọl, ndin Sọọl ado ete Yọnatan, Malki-Sua, Abinadab ye Es-Baal<note caller="+" style="f"><char style="fr" closed="false">8:33 </char><char style="ft" closed="false">Es-Baal asʌk ado Is-Bosed</char></note>.<verse eid="1CH 8:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34" />Ayịn awodeen Yọnatan:</para>
  <para style="li2" vid="1CH 8:34">akedo Merib-Baal<note caller="+" style="f"><char style="fr" closed="false">8:34 </char><char style="ft" closed="false">Meribaal asʌk ado Mefibosed</char></note>, a-akedooho ete Maika.<verse eid="1CH 8:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35" />Nditọ ideen Maika:</para>
  <para style="li2" vid="1CH 8:35">ekedo Pitọn, Melek, Taria ye Ahas.<verse eid="1CH 8:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 8:36" />Ahas akedo ete Yehoada, Yehoada akedo ete Alemed, Asmafed ye Simri, ndin Simri akedo ete Mosa. <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />Mosa akedo ete Binee; Rafa akedo ayịn amọ, Eleasa ayịn amọ ye Asel ayịn amọ.<verse eid="1CH 8:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38" />Asel akenie nditọ ideen itiokeed, ndin anyịñ ammọ ekedoñño ami:</para>
  <para style="li2" vid="1CH 8:38">Asrikam, Bokeru, Ismeel, Seria, Obadaiya ye Hanan. Afịd ibon ami ekedoñño nditọ ideen Asel.<verse eid="1CH 8:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39" />Mme nditọ ideen ayịneka amọ Esek ekedoñño:</para>
  <para style="li2" vid="1CH 8:39">Ulam akpan ayịn, Yeus udọ ayịn ndin Elifeled ayọhọ ayịn ita. <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />Nditọ ideen Ulam ekedoñño mme uko ke ekọñ ammiifegheke ndịk, e-ekemekke adikama idañ. Ammọ emaenie uwak nditọ ideen ye nditọnditọ ideen, 150 (ikie keed mme aba mme duob) ke afịd.</para>
  <para style="li1" vid="1CH 8:40">Afịd ami ekedoñño ntịppe ubon Benyamin.<verse eid="1CH 8:40" /></para>
  <para style="b" />
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />Emaewet anyịñ afịd mbon Isrel ke ñwed ntịppe emana mme ndidem Isrel ye ake mme Yuda. Emaemʌm ammọ nte ifʌn ekaa ke Babilọn ato ke ntak unana ammọ adinam akpanikọ ye Abasi.<verse eid="1CH 9:1" /></para>
  <para style="s1">Mme Awo ke Yeruselem</para>
  <para style="li4">
    <verse number="2" style="v" sid="1CH 9:2" />Akpa mbon se ikitịmme ididʌñ ke itie idʌñ a-akedooho udeeme ammọ ke abio ammọ ekedoñño usʌk nditọ Isrel, mme aku, mme Lifai ye mme anamutom ke tembịd.<verse eid="1CH 9:2" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="3" style="v" sid="1CH 9:3" />Mbon se ikito Yuda, eto Benyamin, enyʌñ eto Ifrem ye Manase ake ekedʌññọ ke Yeruselem ekedoñño:<verse eid="1CH 9:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4" />Utai ayịn Amihud, ayịn Omri, ayịn Imri, ayịn Bani, awo ntịppe ubon Peres ayịn Yuda.<verse eid="1CH 9:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5" />Mbon Sela ekedoñño:</para>
  <para style="li2" vid="1CH 9:5">Asaiya akpan ayịn ye nditọ ideen amọ.<verse eid="1CH 9:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6" />Se ikito Seera:</para>
  <para style="li2" vid="1CH 9:6">Yeuwel.</para>
  <para style="li4" vid="1CH 9:6">Mbon e-eketooho Yuda ekedoñño awo 690 (ikie itiokeed mme anaañ mme duob).<verse eid="1CH 9:6" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="7" style="v" sid="1CH 9:7" />Mbon se ikito ubon Benyamin ekedoñño:</para>
  <para style="li1" vid="1CH 9:7">Salu ayịn Mesulam, ayịn Hodafia, ayịn Hasenua;<verse eid="1CH 9:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 9:8" />Ibneiya ayịn Yeroham;</para>
  <para style="li1" vid="1CH 9:8">Ela ayịn Usi, a-akedooho ayịn Mikri;</para>
  <para style="li1" vid="1CH 9:8">ye Mesulam ayịn Sefatia, ayịn Rewel, ayịn Ibniya.<verse eid="1CH 9:8" /></para>
  <para style="li4">
    <verse number="9" style="v" sid="1CH 9:9" />Mbon e-eketooho Benyamin, naña ekewet ke ñwed ntịppe ubon ammọ, ekedoñño awo 956 (ikie usʌkkeed mme aba mme duob mme itiokeed). Afịd mbon ami ekedoñño mme adaiwuod ke ufọk ammọ.<verse eid="1CH 9:9" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="10" style="v" sid="1CH 9:10" />Mbon se ikito ubon mme aku ekedo:</para>
  <para style="li1" vid="1CH 9:10">Yedaiya; Yehoarib; Yakịn;<verse eid="1CH 9:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 9:11" />Asaria ayịn Hilkia, a-akedooho ayịn Mesulam, ayịn Sadọk, ayịn Meraiyọd, ayịn Ahitub, adaaha a-aseeghe ñkpọ abaña ufọk Abasi;<verse eid="1CH 9:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 9:12" />Adaiya akedo ayịn Yeroham, a-akedooho ayịn Pasọ, ayịn Malkiya;</para>
  <para style="li1" vid="1CH 9:12">ndin Maasai akedo ayịn Adiel, a-akedooho ayịn Yasera, ayịn Mesulam, ayịn Mesilemid, ayịn Imma.<verse eid="1CH 9:12" /></para>
  <para style="li4">
    <verse number="13" style="v" sid="1CH 9:13" />Mme aku, ake ekedoññoke mme adaiwuod ufọk, ekedo ibad awo tọsịn keed mme ikie itiaba mme ata (1,760). Ammọ ekedoñño mme akop idem ideen, mbon se ikise ñkpọ ibaña utom ke ufọk Abasi.<verse eid="1CH 9:13" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="14" style="v" sid="1CH 9:14" />Ke atu ubon mme Lifai ekedoñño:</para>
  <para style="li1" vid="1CH 9:14">Semaiya ayịn Hasub, a-akedooho ayịn Asrikam, ayịn Hasabaiya, awo Merari;<verse eid="1CH 9:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 9:15" />Bakbaka, Heres, Kalal ye Matania ayịn Mika, a-akedooho ayịn Sikri, ayịn Asaf;<verse eid="1CH 9:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 9:16" />Obadaiya ayịn Semaiya, a-akedooho ayịn Kalal, ayịn Yedutun;</para>
  <para style="li1" vid="1CH 9:16">ndin Berekia ayịn Asa, a-akedooho ayịn Elkana, akedʌññọ ke abio mbon Netofa.<verse eid="1CH 9:16" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="17" style="v" sid="1CH 9:17" />Mme akpeme inuaatob ekedoñño:</para>
  <para style="li1" vid="1CH 9:17">Salum, Akub, Talmọn, Ahiman ye mbon Lifai ammọ, Salum abọọñ ammọ <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />a-akebaaha ke Inuaatob Adidem ke edem usakkautịn, tutu adiwuọ ini ami. Mbon se ikido mme akpeme inuaatob itie mboho mme Lifai ekedoñño ami.<verse eid="1CH 9:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 9:19" />Salum ayịn Kore, a-akedooho ayịn Ebiasaf, ayịn Kora, ye emọemọ mbon ukpeme inuaatob e-eketooho ufọk ammọ (mbon Kora) ekenie ubiọñutom adikpeme ntondʌk itie atayad ukem naña mme eteete ammọ ekenie ubiọñutom adikpeme ntondʌk inuausʌñ itie idʌñ <char style="nd">Abọọñ</char>.<verse eid="1CH 9:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 9:20" />Ke ntọọñọ Finehas ayịn Eliasa akedo ekamba awo akeseeghe ñkpọ abaña mme inuaatob, ndin <char style="nd">Abọọñ</char> amaaba ye anye.<verse eid="1CH 9:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 9:21" />Sakaraiya ayịn Mesedemia akedo akpeme inuaatob ke ntondʌk itie atayad mbono.<verse eid="1CH 9:21" /></para>
  <para style="li4">
    <verse number="22" style="v" sid="1CH 9:22" />Afịd-afịd, mbon se ekesio nọ edo mme andikpeme inuaatob ke ntondʌk ekedo awo 212 (ikie iba mme duob mme iba). Emaewet ammọ anyịñ ekeene ini emana ammọ ke abio ammọ.</para>
  <para style="b" vid="1CH 9:22" />
  <para style="p" vid="1CH 9:22">Ado Defid ye Samwel akịdñkukịd ekenọọ mme akpeme inuaatob itie utom ami ke akpanikọ. <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />Ammọ ye mbon ubon ammọ ekenie ubiọñutom adikpeme inuaatob ufọk <char style="nd">Abọọñ</char>, ufọk e-ekoodo atayad mbono. <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />Mme akpeme inuaatob ekebañña ke naña mbañ inaañ: usakkautịn, usobutịn, anyọñ-anyọñ ye usuuk-usuuk. <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />Mme emọ-emọ mbon Lifai ammọ e-etooho abio ammọ akena esidi ke ini ke ini edinwam ke utom ke mme ikpeghe usen itiaba. <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />Ado mme adaiwuod ukpeme inuaatob inaañ ami, e-ekedooho mme Lifai, ke ekenọọ ubiọñutom ke esịd ubeed ke idak akpanikọ ye itie unịm akʌk ke ufọk Abasi. <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />Ammọ ekenie ediba afịd akonayio ekpeme ekanna ufọk Abasi, sia akena nte ammọ ekpeme anye; ammọ ñko ekese ñkpọ ebaña ñyịn ukpọhọde e-ekamake ebeere anye kwa ubakusen.<verse eid="1CH 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />Ubaak ammọ ekese ñkpọ ebaña mme ñkpọ ekesikamake enam utom ke tembịd; emaebat ammọ idaha se ekoono edʌk edi ye idaha se ekoono ewuọ. <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />Ekenọ mbon mfen ubiọñutom adise ñkpọ mbaña mme ñkpoduoho ufọk ye afịd mme ñkpọ mfen ke adisana akpokoro uwa, adiana ye mme asaña-asaña ndomuyo ye ukọd, ye adan ọlif, insensi, ye mme anemufịk ñkpọ. <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />Ado ubaak mme aku ekese ñkpọ ebaña adiwuak mme anemufịk adan ami. <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />Lifai keed a-akekereke Matitia, akpan Salum awo Kora, ke ekeyaak ubiọñutom aditem uyo ukama nnam uwa enọ ke idak akpanikọ. <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />Ubaak mbon Kohad, ye mbon Lifai ammọ ekenie ubiọñutom adibenne uyo edotto ke akpokoro mbono ke afịd usen Sabad.<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />Mbon e-ekedooho mme akwọikwọ, mme adaiwuod ufọk mme Lifai, emaeba ke esịd ufọk tembịd ndin emaesio ammọ efep ke mme utom mfen sia ammọ ekese ñkpọ ebaña utom do uweemeayio ye akonayio.<verse eid="1CH 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34" />Afịd ibon ami ekedoñño mme adaiwuod ke ubon mme Lifai, mme mbọọñ naña ewet ke ñwed ntịppe ubon, ndin ammọ ekedʌñọ ke Yeruselem.<verse eid="1CH 9:34" /></para>
  <para style="s1">Ntịppe Ubon Sọọl</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35" />Yeiyel ete Kibiọn akedʌñ ke Kibiọn.</para>
  <para style="li2" vid="1CH 9:35">Anyịñ anwaan amọ akedo Maaka, <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />ndin akpan ayịn amọ akedo Abdọn, mbon se ikidiana ekedoñño Su, Kisi, Baal, Nee, Nadab, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />Kedọ, Ahio, Sakaraiya ye Miklọd. <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />Miklọd akedo ete Simeem. Ammọ ñko emaedʌñọ ekpere mme ekpək ammọ ke Yeruselem.<verse eid="1CH 9:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39" />Nee akedo ete Kisi, Kisi ado ete Sọọl, ndin Sọọl ado ete Yọnatan, Malki-Sua, Abinadab ye Es-Baal.<verse eid="1CH 9:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40" />Ayịn awodeen Yọnatan:</para>
  <para style="li2" vid="1CH 9:40">akedo Merib-Baal, a-akedooho ete Maika.<verse eid="1CH 9:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41" />Nditọ ideen Maika:</para>
  <para style="li2" vid="1CH 9:41">ekedo Pitọn, Melek, Taria ye Ahas.<verse eid="1CH 9:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42" />Ahas akedo ete Yada, Yada akedo ete Alemed, Asmafed ye Simri, ndin Simri akedo ete Mosa. <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />Mosa akedo ete Binee; Refaiya akedo ayịn amọ, Eleasa ayịn amọ ye Asel ayịn amọ.<verse eid="1CH 9:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44" />Asel akenie nditọ ideen itiokeed, ndin anyịñ ammọ ekedom:</para>
  <para style="li2" vid="1CH 9:44">Asrikam, Bokeru, Ismeel, Seria, Obadaiya ye Hanan. Mbon ami ekedoñño nditọ ideen Asel.<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s1">Sọọl Adat Uwem Amọ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />Akem mbon Filistia emaenwana ye nditọ Isrel; mbon Isrel emaefeeñe ke iso ammọ, ndin uwak emaekpañña ke Abod Kilboa. <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />Mbon Filistia emaesọọñọ ebịne Sọọl ye nditọ ideen amọ, ndin ammọ emaewot nditọ ideen amọ Yọnatan, Abinadab ye Malki-Sua. <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />Ekọñ ami amaasọñ adudu ke ukañ Sọọl, ndin ke ini mme atobidañ ekekanna anye ubọk, ammọ emaenọ anye unan.<verse eid="1CH 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4" />Sọọl amaabo akama ñkpọekọñ amọ ate, “Sio akañkañ mfo nyʌñ ñwot miin, imiidooho ntoro mbon ammiifọọrọke edʌd ami eyaediñwot miin enyʌñ ensappa miin.”</para>
  <para style="p" vid="1CH 10:4">Ado abiom ñkpọekọñ amọ amaakop akpọsọñ ndịk ndin asịn adinam ntoro; ke ntoro Sọọl amaaben akañkañ amọ anyʌñ akịm idem amọ awot. <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />Ke ini abiom ñkpọekọñ akekịtte ke Sọọl amaakpa, anye ñko amaaduọ akʌbọ ke akañkañ amọ anyʌñ akeene akpa. <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />Ndin Sọọl ye nditọ ideen amọ ita emaekpañña, ndin afịd mbon ufọk amọ emaekpañña ñko.<verse eid="1CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7" />Ke ini afịd mbon Isrel ke abedeñ ekekịtte ke mbon ekọñ emaefeeñe ndin ke Sọọl ye nditọ ideen amọ ita emaekpañña, ammọ emaefeeñe ekpọñ mme abio ammọ. Ndin mbon Filistia emaedi ediben edʌñọ.<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />Edem usen, ke mbon Filistia emaekedi edisịññe mme akpañkpa ñkpọ ke idem, ammọ emaekịt ke Sọọl ye nditọ ideen amọ emaekpañña ke Abod Kilboa. <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />Ammọ emaesịññe anye ñkpọ ke idem enyʌñ eben iwuod amọ ye ñkpọekọñ amọ, ndin edọñ isʌñutom esọk afịd abio mbon Filistia ekesuan etob ami ke atu mme ubobod abasi ammọ ye mbon ammọ. <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />Ammọ emaeben ñkpọekọñ amọ ekọọñ ke itieukpono ubobod abasi ammọ enyʌñ ekọọñ iwuod amọ ke itieukpono Dakọn.<verse eid="1CH 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11" />Ke ini mbon se idʌñ ke Yabes Kilied ekekoppo se mbon Filistia ekenam Sọọl, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />afịd mme akop uko mbon ekọñ ammọ emaekaa ekekoono mme akpo Sọọl ye ake nditọ amọ ideen enyọñ edi Yabes. Ammọ emaebuuk mme akpọ ammọ ke idak ekamba eto afriyo ke Yabes, ndin emaetie utreudia ke usen itiaba.<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />Sọọl akekpa sia anye ikinamma akpanikọ ye <char style="nd">Abọọñ</char>; anye ikinịmme ikọ <char style="nd">Abọọñ</char> ndin akenyʌñ ayem akikere ato mme idiọñ abaña ndadusʌñ, <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />ndin ikibịppe <char style="nd">Abọọñ</char>. Ke ntoro <char style="nd">Abọọñ</char> amaayaak anye anọ ñkpa anyʌñ ayaak abio asịn Defid ayịn Yesi ke ubọk.<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s1">Defid Ado Adidem ke Isrel</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />Afịd mbon Isrel emaedisoobo iwuod ye Defid ke Hibrọn enyʌñ ebo anye ete, “Ñnyịn ido abʌk ye iyiib mfo. <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />Ke mme usen edem, ke idaha Sọọl akedooho adidem, afo akedo awo akesidatta Isrel usʌñ akaa ekọñ. Ñko <char style="nd">Abọọñ</char> Abasi mfo amaudọkkọ fiin ate, ‘Afo ayaado andikpeme ikọd mmi Isrel, ndin afo ayaado andikara ammọ.’ ”<verse eid="1CH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3" />Ndin ke ini afịd mme ñkpisọñ ke Isrel emaekedisoobo ye Adidem Defid ke Hibrọn, anye amaanam edioomo ye ammọ ke Hibrọn ke iso <char style="nd">Abọọñ</char>, ndin ammọ emaeyet Defid adan nte adidem enọ Isrel, naña <char style="nd">Abọọñ</char> akenwọñọ ato inua Samwel.<verse eid="1CH 11:3" /></para>
  <para style="s1">Defid Akan Yeruselem</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />Defid ye afịd mbon Isrel emaenam isañ edʌk Yeruselem (a-adooho Yebus). Mbon Yebus e-ekedʌññọ do <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />Yebus emaebo Defid, “Afo uduudʌkkọ mi.” Kpayeado Defid amaadʌk anyʌñ adat akpọsọñ itie ke Saiyọn, a-adooho Abio Defid.<verse eid="1CH 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6" />Defid amaabo ate, “Awo ndomokeed se ida iso ekọñ adinwana mbon Yebus ayaado adaiso ekọñ.” Yoab ayịn Seruya akedo akpa awo adito ndọọk, ke ntoro anye amaabọ itie ado.<verse eid="1CH 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7" />Ndin Defid amaadat akpọsọñ itie Saiyọn anam itieidʌñ amọ, ndin emaekoot itie ado Abio Defid. <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />Anye amaabọp abio ado akanna anye akʌk, tọọñọ ke mme mben tutu akewuọ mme ñkanñkʌk ndibene, ke ini Yoab aketọọñọke ntak adiọñ mme abio ado. <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />Ndin Defid amaanenekke akop uko, sia <char style="nd">Abọọñ</char> Andikponñkan amaaba ye anye.<verse eid="1CH 11:9" /></para>
  <para style="s1">Mme Uko Mbon Ekọñ Defid</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />Mbon ami ekedoñño mbọọñ ke atu mbon uko ekọñ Defid, ammọ ye afịd mbon Isrel, emaenọ ubọọñ amọ akpọsọñ ibededem adinam ukara amọ atara ke afịd isọñ, naña <char style="nd">Abọọñ</char> akenwọñọ. <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />Anyịñ mme ñkpọsọñ mbonekọñ Defid edoñño emi:</para>
  <para style="p" vid="1CH 11:11">Yasobiim, awo Hakmon, akedo abọọñ ke atu mme adaaha; anye amaabenne eduad amọ anwana ye awo ikie ita (300), ake anye akewotto akañ keed ke iso ekọñ keed.<verse eid="1CH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12" />Andikidiana anye akedo Eliasa ayịn Dodai awo Ahoa, keed ke atu mbon uko ekọñ ita. <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />Anye akeba ye Defid ke Pas Damịm idaha ake mbon Filistia ekebohoke ke ndo edinwana ekọñ. Ke itie inwañ a-akeyọhọke ye baali, mme mbon ekọñ emaefeeñe ke iso mbon Filistia. <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />Ado ammọ emaedat itie ammọ ke ufọọd inwañ. Ammọ emaetuak eda enyʌñ ewoot mbon Filistia ebono ke isọñ, ndin <char style="nd">Abọọñ</char> amaanọ ekamba edikan.<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />Awo ita ke atu mme adaaha ekọñ edịb mme duob emaetịkke ebịne Defid ke abaitiad Adulam, ke ini udịm mbon ekọñ Filistia ekenamma nnaaekọñ ekanna ke Abedeñ Refaim. <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />Ke ini ado Defid akeba ke akpọsọñ itie, ndin mbon ukpeme Filistia ekeba ke Betlehem. <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />Defid amaayem mmọọñ se anwọñ, ndin anye amaabo, “O, ubaha nte awo akpekoiyo unwọnwọñ mmọọñ annọ miin ke ube mmọọñ a-akpereke inuaatob Betlehem!” <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />Ke ntoro, mme adaaha mbon ekọñ Ita emaesiak usʌñ eboiyo ke ufọọd udịm mbon Filistia, ekekoi mmọọñ ke ube mmọọñ ke inuaatob Betlehem enyʌñ eben esọk Defid. Ado anye amaasịn adinwọñ mmọọñ ado; utu ke ado, anye amaakappa akaaña mmọọñ ado aduọk anọ <char style="nd">Abọọñ</char>. <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />Anye amaabo, “Abasi akan ami adikpinam utọ ñkpọ ami! Ana nte ami ñnwọñ iyiib mbon ake ekenyịmmeke edikpikiduọọk uwem ammọ?” Sia ammọ ekenyịmmeke edikpikiduọọk uwem ammọ ekedat mmọọñ ami edi, Defid idiinwọññọ mmọọñ ado.</para>
  <para style="p" vid="1CH 11:19">Utọ ado akedo mme ñwuọnda adinam ñkpọsọñ mbon uko ekọñ ita ado.<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />Abisai ayịneka awodeen Yoab akedo adaiwuod ke atu mme adaaha Ita ami. Anye amaadịppe eduad amọ anwana awo ikie ita (300), ake anye akewotto, ndin anye amaakappa awuọ etob nte awo Ita ami. <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />Anye amaanie ukpono akañ iba akan mbon Ita ado anyʌñ akappa ado etubom adaiso ekọñ anọ ammọ, akpesʌkado awo ikibatta anye isịn ke atu ammọ.<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />Benaiya ayịn Yehoiyada, awo uko ke ekọñ aketooho Kabseel, amaanam mme awuọ etob ñkpoon utom uko. Anye amaawot ata ñkpọsọñ mbon ekọñ Mọb iba ekesọññọ adudu ekan. Anye amaanyʌñ asọiyọ adʌk ube ke usen sino akenekkeke aduọ awak akewot ekpe. <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />Ndin anye amaawot awo Iyib a-akenyọọñọ kubid ition<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">A-adooho ñkpọ nte ikpad 7 1/2 me mita 2.3</char></note>. Akpesʌkado awo Iyib ami amaakekama eduad a-akebaaha nte eto udọk afọñ ke ubọk amọ, Benaiya amaakama ibio akpeti eto anwana ye anye. Anye amaawappa awo Iyib ami eduad ke ubọk abọ anyʌñ akama kpa eduad awo ado awot anye. <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />Mme utọ ado ekedoñño mme ñwuọnda utom uko Benaiya, ayịn Yehoiyada; anye ñko amaanyʌñ awuọ etob nte mme ñkpọsọñ mbon ekọñ ita ado. <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />Emaenịm anye ke ataa ekamba itie ukpono ekan afịd mme awo edịb mme duob ado, ado awo ikisịnne anye ke atu mme ñkpọsọñ awo Ita ado. Ndin Defid amaanịm anye nte adaiwuod ke atu mbon ukpeme amọ.<verse eid="1CH 11:25" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="26" style="v" sid="1CH 11:26" />Mme ñkpoon mbon ekọñ ado ekedoñño:</para>
  <para style="b" vid="1CH 11:26" />
  <para style="li1" vid="1CH 11:26">Asahel ayịneka awodeen Yoab,</para>
  <para style="li1" vid="1CH 11:26">Elhanan ayịn Dodo aketooho Betlehem,<verse eid="1CH 11:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 11:27" />Samod awo Harọ,</para>
  <para style="li1" vid="1CH 11:27">Heles awo Pelọn,<verse eid="1CH 11:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 11:28" />Ira ayịn Ikes a-atooho Tekoa,</para>
  <para style="li1" vid="1CH 11:28">Abiesa a-atooho Anatod,<verse eid="1CH 11:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 11:29" />Sibekai awo Husa,</para>
  <para style="li1" vid="1CH 11:29">Ilai awo Ahoa,<verse eid="1CH 11:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 11:30" />Maharai awo Netofa,</para>
  <para style="li1" vid="1CH 11:30">Heled ayịn Baana awo Netofa,<verse eid="1CH 11:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 11:31" />Itai ayịn Ribai a-atooho Kibie ke Benyamin,</para>
  <para style="li1" vid="1CH 11:31">Benaiya awo Piratọn,<verse eid="1CH 11:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 11:32" />Hurai a-atooho ñkañ abedeñ Kaas,</para>
  <para style="li1" vid="1CH 11:32">Abiel awo Abad,<verse eid="1CH 11:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 11:33" />Asmafed awo Baharum,</para>
  <para style="li1" vid="1CH 11:33">Eliaba awo Saalbọn,<verse eid="1CH 11:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 11:34" />nditọ ideen Hasem awo Kisọn,</para>
  <para style="li1" vid="1CH 11:34">Yọnatan ayịn Sakee awo Hara,<verse eid="1CH 11:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 11:35" />Ahiam ayịn Sakaa awo Hara,</para>
  <para style="li1" vid="1CH 11:35">Elifal ayịn Ọr,<verse eid="1CH 11:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 11:36" />Hefa awo Mekerad,</para>
  <para style="li1" vid="1CH 11:36">Ahiya awo Pelọn,<verse eid="1CH 11:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 11:37" />Hesro awo Kamel,</para>
  <para style="li1" vid="1CH 11:37">Naarai ayịn Esbai,<verse eid="1CH 11:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 11:38" />Yuel ayịneka awodeen Natan,</para>
  <para style="li1" vid="1CH 11:38">Miba ayịn Hakri,<verse eid="1CH 11:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 11:39" />Selek awo Amọn,</para>
  <para style="li1" vid="1CH 11:39">Naharai awo Beerod, akama ñkpọ ekọñ Yoab ayịn Seruya,<verse eid="1CH 11:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 11:40" />Ira awo Itriad,</para>
  <para style="li1" vid="1CH 11:40">Kareb awo Itriad,<verse eid="1CH 11:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 11:41" />Yuria awo Hed,</para>
  <para style="li1" vid="1CH 11:41">Saabad ayịn Alai,<verse eid="1CH 11:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 11:42" />Adina ayịn Sisa awo Rubịn, a-akedooho ekamba awo ke atu mbon Rubịn, ndin ye mme awo edịb mme duob ekebaaha ye anye,<verse eid="1CH 11:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 11:43" />Hanan ayịn Maaka,</para>
  <para style="li1" vid="1CH 11:43">Yosafad awo Mitan,<verse eid="1CH 11:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 11:44" />Usaiya awo Asterad,</para>
  <para style="li1" vid="1CH 11:44">Sama ye Yeiyel mme nditọ Hotam awo Arowa,<verse eid="1CH 11:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 11:45" />Yediayel ayịn Simri,</para>
  <para style="li1" vid="1CH 11:45">ayịneka amọ Yoha awo Tis,<verse eid="1CH 11:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 11:46" />Eliel awo Mahafa,</para>
  <para style="li1" vid="1CH 11:46">Yeribai ye Yosafia ayịn Elnaam,</para>
  <para style="li1" vid="1CH 11:46">Itma awo Mọb,<verse eid="1CH 11:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 11:47" />Eliel, Obed ye Yaasiel awo Mesoba.<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s1">Ñkpọsọñ Mbon Anwan Ediana ye Defid</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 12:1" />Mme ideen se ikidi ibịne Defid ke Siklak ekedom, ke ini ekebịneke anye esio ke iso Sọọl ayịn Kisi (ammọ ekesịne ke atu ñkpọsọñ mbon ekọñ se ikinwam anye ke ekọñ; <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />ammọ emaekama mme utịgha emaenyʌñ enie ukeme editịgha idañ me editop ñkwaitiad ke ubọk ufiin me ke nnasia; ammọ ekedoñño aduuk Sọọl e-eketooho ubon Benyamin):<verse eid="1CH 12:2" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="3" style="v" sid="1CH 12:3" />Ahiesa abọọñ ammọ ye Yoas ayịn Semaa awo Kibie;</para>
  <para style="li1" vid="1CH 12:3">Yesiel ye Pelet nditọ Asmafed;</para>
  <para style="li1" vid="1CH 12:3">Beraka, Yehu awo Anatod, <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />ye Ismaiya awo Kibiọn, ekamba awo ekọñ ke atu mme Edịb mme Duob, a-akedooho adaaha ke atu Edịb mme Duob;</para>
  <para style="li1" vid="1CH 12:4">Yerimaiya, Yahasiel, Yohanan, Yoosabad awo Kedera<note caller="+" style="f"><char style="fr" closed="false">12:4 </char><char style="ft" closed="false">Ke Hibru ayọhọ ikpeghe iba ke ufañ ami (Yerimaiya … Kedera) ewet 1 Kr 12:5, ñko 1 Kr 12:5-40 ewet 1 Kr 12:6-41</char></note>, <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />Elusai, Yerimọd, Belia, Semaria ye Sefatia awo Haruf;<verse eid="1CH 12:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 12:6" />Elkana, Isia, Asarel, Yoesa ye Yasobiim awo Kora;<verse eid="1CH 12:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 12:7" />ye Yuela ye Sebadaiya ayịn Yeroham aketooho Kedọ.<verse eid="1CH 12:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />Ubaak mbon Kad emaewuọñọ ebịne Defid ke akpọsọñ itieudịbe amọ ke anaan. Ammọ ekedo mme akop adudu mbon anwan, ekebaaha ke mbeeñeidem ekọñ enyʌñ enie ukeme adikama atuekọñ ye eduad. Iso ammọ ekedoñño iso mme ekpe, ndin ammọ emaenyʌñ esọp usọb nte edob ke mme anyọñ abod.<verse eid="1CH 12:8" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9" />Esaa akedo abọọñ,</para>
  <para style="li1" vid="1CH 12:9">Obadaiya akedo udiana adadusʌñ, Eliab ado ayọhọ ita,<verse eid="1CH 12:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10" />Mismana ayọhọ inaañ, Yerimaiya ayọhọ ition,<verse eid="1CH 12:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11" />Atai ayọhọ itiokeed, Eliel ayọhọ itiaba,<verse eid="1CH 12:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12" />Yohanan ayọhọ itiaita, Elsabad ayọhọ usʌkkeed,<verse eid="1CH 12:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13" />Yerimaiya ayọhọ duob ye Makbanai ayọhọ duob mme keed.<verse eid="1CH 12:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14" />Mbon Kad ami ekedoñño ikpọ mme adaiso ekọñ; andisịb ñkan amaanie ukeme adinwana awo ikie (100), ñko andikpon ñkan amaanie ukeme adinwana awo tọsịn keed (1,000). <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />Ammọ ekesaña eboiyo inyañ Yọdan ke akpa afiọñ ke ini mmọọñ aketọọhọ afiọrọ afịd mben amọ, ndin enyʌñ enam afịd awo se ikidʌñ ke unaisọñ efeghe, enyọñ usakkautịn ye usobutịn.<verse eid="1CH 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />Ubaak mbon Benyamin ye ubaak ideen Yuda emaenyʌñ edi ebịne Defid ke akpọsọñ itieudịbe amọ. <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />Defid amaawuọ akesoobo ammọ anyʌñ abo ammọ ate, “Adieke ndufo ediighe ke emem ediñnwam miin, ami mmebeeñe idem nọ ndufo edisaña ye ami. Ado adieke ndufo ediighe edintap miin nnọọ mbon usua mmi ke ini ubọk mmi imiiyemme afai, yak Abasi mme eteete ñnyịn akịt anyʌñ akpe ikpe inọ ndufo.”<verse eid="1CH 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18" />Akem sịbidịd amaadi adidoro Amasai ke idem, andikido abọọñ ke ikpeghe Edịb mme Duob, ndin anye amaabo:</para>
  <para style="q1" vid="1CH 12:18">“Defid, ñnyịn ido ake mfo!</para>
  <para style="q2" vid="1CH 12:18">Ñnyịn ida ye afo, ayịn Yesi!</para>
  <para style="q1" vid="1CH 12:18">Uforo unie fiin,</para>
  <para style="q2" vid="1CH 12:18">uforo anyʌñ anie afịd mbon se unwam fiin,</para>
  <para style="q3" vid="1CH 12:18">sia Abasi mfo ayaunwam fiin.”</para>
  <para style="p" vid="1CH 12:18">Ndin Defid amaadaara ammọ anyʌñ anam ammọ mme adadusʌñ ke atu mbon ekọñ se itañ mbịme amọ.<verse eid="1CH 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />Ubaak mbon Manase emaewuọñọ ekeene Defid ke idaha anye akesañake ye mbon Filistia adinwana Sọọl. (Anye ye mbon amọ ikinwamma mbon Filistia sia, ke emaekedọñọ adu, mme adaukara ammọ emaebịne anye esio. Ammọ emaebo ete, “Ayaadat iwuod ñnyịn adieke anye afegheke abịne eteufọk amọ Sọọl.”) <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />Ke ini Defid akekaaha Siklak, mme ideen Manase se ikiwọññọ ikeene anye ekedo ami: Adna, Yoosabad, Yediayel, Maikel, Yoosabad, Elihu ye Siletai, adaiwuod ke ikpeghe tọsịn keed ke Manase. <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />Ammọ emaenwam Defid adinwana ye mbon esiyịppe ñkpọ, sia afịd ammọ ekedo mme anie adudu mbon anwan, ndin ammọ ekedo mme adaiso ekọñ. <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />Ke usen ke usen, mme awo emaedi edinwam Defid, tutu anye anie ataa ekamba udịmekọñ, nte udịmekọñ Abasi.<verse eid="1CH 12:22" /></para>
  <para style="s1">Mbon Mfen Ediana ye Defid ke Hibrọn</para>
  <para style="li4">
    <verse number="23" style="v" sid="1CH 12:23" />Ibad ideen se ikidi ibịne Defid ke mbeeñe idem ekọñ ke Hibrọn edikappa abio Sọọl nsịn anye ke ubọk, naña <char style="nd">Abọọñ</char> aketañ ake adom:<verse eid="1CH 12:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24" />tọọñọ ke Yuda awo tọsịn itiokeed mme ikie itiaita (6,800) ekama atuekọñ ye eduad eba ke mbeeñeidem ekọñ;<verse eid="1CH 12:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25" />tọọñọ ke Simiọn, mbon anwan awo tọsịn itiaba mme ikie keed (7,100) eba ke mbeeñeidem anwan;<verse eid="1CH 12:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26" />tọọñọ ke Lifai awo tọsịn inaañ mme ikie itiokeed (4,600), <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />adiana ye Yehoiyada, adadusʌñ ufọk Erọn, ye ideen tọsịn ita mme ikie itiaba (3,700), <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />ndin Sadọk, uko akparawa ekọñ, ye ikpọawo edịb mme iba (22) e-eketooho ufọk amọ;<verse eid="1CH 12:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29" />tọọñọ ke ñkan Benyamin, ntịppe ubon Sọọl, awo tọsịn ita (3,000), ataa uwak ammọ emaesọọñọ eda ye ufọk Sọọl tutu idaha ado;<verse eid="1CH 12:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30" />tọọñọ ke Ifrem, mme asọñ adudu mbon ekọñ, ewuọhọ etob ke ñkañ idʌñ ammọ ekedo awo tọsịn edịb mme ikie itiaita (20,800);<verse eid="1CH 12:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31" />tọọñọ ke ubaak ubon mbon Manase, awo tọsịn duob mme itiaita (18,000) ke ekesio ke anyịñ ke anyịñ yak edi edinam Defid abọọñ;<verse eid="1CH 12:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32" />tọọñọ ke Isaka, ideen se ikidiọọñọ ini ado enyʌñ ediọọñọ se Isrel akpena anam ye mme mbọọñ ikie iba (200), ye afịd mme ekpək ammọ ke idak ukara ammọ;<verse eid="1CH 12:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33" />tọọñọ ke Sebulọn, mme anie ifiọk mbon ekọñ emaekebeeñe idem anwan ye afịd mme ñkpọ ekọñ, adinwam Defid ye ayọhọ ndukoppo keed ekedo awo tọsịn aba mme duob (50,000);<verse eid="1CH 12:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34" />tọọñọ ke Naftali ikpọawo ekọñ tọsịn keed, ediana mme ideen tọsịn edịb mme duob mme itiaba (37,000) ekama mme atuekọñ ye mme eduad;<verse eid="1CH 12:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35" />tọọñọ ke Daan, awo tọsịn edịb mme itiaita mme ikie itiokeed (28,600) emaeba ke mbeeñeidem ekọñ;<verse eid="1CH 12:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36" />tọọñọ ke Asaa, awo tọsịn aba (40,000) ekenieghe ifiọk unwana ekọñ emaebeeñe idem ekọñ;<verse eid="1CH 12:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37" />tọọñọ ke edem usakkautịn ñkan Yọdan, atọọñọke ke Rubịn, Kad ye ubaak esiin Manase, mme awo tọsịn ikie mme edịb (120,000) emaebeeñe idem ye afịd ñkpọekọñ.<verse eid="1CH 12:37" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="38" style="v" sid="1CH 12:38" />Afịd ibon ami ekedo mbon unwana ekọñ e-ekenyịmmeke adinwam ke mme ndaha ami.</para>
  <para style="b" vid="1CH 12:38" />
  <para style="pm" vid="1CH 12:38">Ammọ emaedi Hibrọn ye ayọhọ unyịmme ye mbeeñeidem adinam Defid ado adidem anọ afịd Isrel. Afịd mbon Isrel mfen ñko ekenyʌñ enie esịd keed adinam Defid ado adidem. <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />Mme ideen ami ekeba ye Defid usen ita, edia enyʌñ enwọñ, sia mbon ubon ammọ emaenọ ammọ afịd se ammọ ekpeyem. <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />Ñko, mme mbọhọidʌñ ammọ e-eketooho ataa anyan usʌñ nte Isaka, Sebulọn ye Naftali emaedi ekoono ndidia ammọ ke anyọñ dọñki, kamel, ñwaahadọñki ye mme abaakenañ utominwañ. Mme ñkpọ emaeba uwak-uwak nte ndomuyo, mme eboho fik, nsaad kreb, ukọd, adan ọlif, mme enañ ye mme edọñ, sia idaara amaaba ke Isrel.<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s1">Adiben Akebe Edioomo Ñnyọñ Ndi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />Defid amaaneme ye ikpọ mbon ukara amọ keedekeed, mme adaiso udịmekọñ tọsịn (1,000) ye mme adaiso udịmekọñ ikie (100). <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />Akem Defid amaadọkkọ afịd esob ufọk Isrel, “Akpedo afọn ye ndufo ñko akpedo ado uduak <char style="nd">Abọọñ</char> Abasi, yak ñnyịn inọ etob esọk ikọd ñnyịn ke anyan usʌñ ye ke ñkped-ñkped ke afịd ñkanñkʌk abio Isrel, ñko ye mme aku mme Lifai e-ebaaha ye ammọ ke mme abio ammọ ye ke mme inwañ ubọọk ufene, nọ ediwuana ye ñnyịn. <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />Yak ñnyịn imaana iben akebe edioomo Abasi ñnyịn idi, sia ñnyịn ikibịppe ibaña anye ke idaha Sọọl akedaaha ukara.” <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />Afịd esob ufọk Isrel emaenyịmme adinam ami, sia akedo ñkpọ se ifọn ke anyen afịd awo.<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />Ndin Defid amaabono afịd Isrel, tọọñọ ke Inyañ Sihọ ke Iyib tutu akewuọ Lebo Hamad, adiben akebe edioomo Abasi nto Kiriad Yerịm. <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />Defid ye afịd Isrel emaekaa ke Baala ake Yuda (Kiriad Yerịm) edikiben akebe edioomo Abasi <char style="nd">Abọọñ</char>, do nto ndi, e-edotto ke ufọọd ikpeghe serubim, akebe edioomo e-ekoodo ke Anyịñ ado.<verse eid="1CH 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7" />Ammọ emaeben akebe edioomo Abasi esio ekpọñ ufọk Abinadab ke ufa ukpadñkpọ, Usa ye Ahio eba ekpeme anye. <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />Defid ye afịd nditọ Isrel emaenam idaara ke afịd ukeme ammọ enọ Abasi, ye mme ikwọ ye mme ekpa, mme ndidoudʌk, mme ibịdubọk, nsak, mme simbal ye mme adukpoñ.<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />Ke ammọ emaekediwuọ itie ukọkñkpọ Kidọn, Usa amaanyan ubọk amʌm akebe edioomo, sia mme enañ emaetuak ukod eteññe. <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />Ikañ iyadesịd <char style="nd">Abọọñ</char> amaabịppe ata Usa, ndin anye amaamia anye anịm ke isọñ sia anye amaaben ubọk amọ aketuuk akebe edioomo Abasi. Anye amaakpa ke ndo ke iso Abasi.<verse eid="1CH 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11" />Ndin Defid amaayat esịd sia iyadesịd <char style="nd">Abọọñ</char> amaasịm Usa, ndin tutu usen mfịn ami ekoot itie ado Peres Usa.<verse eid="1CH 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12" />Defid amaakop ndịk abaña Abasi usen ado, ndin amaanyʌñ abịp ate, “Ndiinam die mben akebe edioomo Abasi yak adiba ye ami?” <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />Anye ikibenne akebe edioomo ami nọ adiba ye anye ke abio Defid. Utu ke ado, anye akeben aka ufọk Obed-Edom awo Kad. <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />Akebe edioomo Abasi amaaba ye ubon Obed-Edom ke ufọk amọ ke afiọñ ita, ndin <char style="nd">Abọọñ</char> amaadiọñ afịd ufọk amọ ye afịd ñkpọ se anye akenie.<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s1">Ufọk Defid ye Ubon Amọ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />Akema Hiram adidem Tai amaadọñ mme isʌñutom anọ Defid, adian ye mme mboi eto sida, mme akọọkufọk itiad ye mme akọñeto edikibọp ufọk abọọñ nnọ anye. <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />Ndin Defid amaadiọọñọ ke <char style="nd">Abọọñ</char> amaisio imọ anịm nte adidem andikara Isrel ndin ke edịppe abioubọọñ imọ ke anyọñ ato ke ntak ikọd amọ Isrel.<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />Ke Yeruselem Defid amaanie uwak ibaan anyʌñ akappa ado ete uwak nditọ ideen ye nditọ ibaan. <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />Mme anyịñ nditọ se ekeman enọ anye ke Yeruselem edoñño ami: Samua, Sobab, Natan, Sọlọmọn, <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />Ibha, Elisua, Elpeled, <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />Noka, Nefek, Yafia, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />Elisama, Beeliada ye Elifeled.<verse eid="1CH 14:7" /></para>
  <para style="s1">Defid Akan Mbon Filistia ke Ekọñ</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />Ke ini mbon Filistia emaekekop ke emaeyet Defid adan nte adidem afịd Isrel, ammọ emaedọọk ekaa ke afịd adudu adikiyem anye, ado Defid amaakop abaña amaanyʌñ awuọ akaa akesoobo ye ammọ. <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />Akem mbon Filistia emaedi ediyọhọ ke abedeñ Refaim; <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />Ke ntoro Defid amaabịp Abasi ate: “Nte ami ñka ñkenwana ye mbon Filistia? Nte afo ayaayaak ammọ ansịn miin ke ubọk?”</para>
  <para style="p" vid="1CH 14:10">
    <char style="nd">Abọọñ</char> amaabọọrọ anye ate, “Kaa, ami ñyaayaak ammọ usịn fiin ke ubọk.”<verse eid="1CH 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11" />Ndin Defid ye ideen amọ emaekaa ke Baal Perasịm, do ke anye akekan ammọ. Anye amaabo, “Naña mmọọñ abomo awuọñọ, kpa ntoro ke Abasi aboom mme asua mmi ato ubọk mmi.” Ntak ado anam ekedikoot itie ado Baal Perasịm. <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />Mbon Filistia emaefeeñe ekpọñ mme abasi ammọ do, ndin Defid amaanọ uyio ate yak efọp afịd ammọ ke ikañ.<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />Ini keed mfen mbon Filistia emaemaana edinwana ke abedeñ; <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />ke ntoro Defid amaabịp Abasi, ndin Abasi amaabọọrọ anye ate, “Kuubịne ammọ nnen-nnen, ado tọ akọ kanna ammọ nyʌñ nwana ye ammọ ke itie mme eto pọpla. <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />Imaisʌk ikokop uyom ntịm ñkpad isañ ke mme anyọñ eto pọpla ami, iwuọñọ ikaa ikinwana ye ammọ, sia ado adiiwọt ke Abasi ibem iso awuọ akaa adikiwoot mbon ekọñ Filistia.” <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />Ndin Defid amaanam naña Abasi aketemme anye, ndin ammọ emaewot afịd mbon ekọñ Filistia, tọọñọ ke Kibiọn tutu akewuọ Kesa.<verse eid="1CH 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17" />Ndin etob Defid amaawuọ afịd idʌñ, ndin <char style="nd">Abọọñ</char> amaanam afịd mme idịd ebaak anye.<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s1">Eben Akebe Edioomo Abasi edi Yeruselem</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />Ke Defid amaakebọp ufọk anọ idem amọ ke Abio Defid, anye amaatịm itie anọ akebe edioomo Abasi anyʌñ atuak afe anọ anye. <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />Akem Defid amaabo ate, “Inaaha awo ndomokeed ke imiibọhọke mme Lifai ikpọọñ enie adiben akebe edioomo Abasi, sia <char style="nd">Abọọñ</char> amek ammọ adiben akebe edioomo <char style="nd">Abọọñ</char> ndin adinyʌñ nnam utom ke iso amọ ke nsi-nsi.”<verse eid="1CH 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3" />Defid amaakoot afịd Isrel abok atọ keed ke Yeruselem adiben akebe edioomo <char style="nd">Abọọñ</char> ndi itie ekediọññọ enọ anye.<verse eid="1CH 15:3" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="4" style="v" sid="1CH 15:4" />Defid amaakoot abon itie keed afịd ntịppe ubon Erọn ye mme Lifai:<verse eid="1CH 15:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5" />Tọọñọ ke ubon Kohad,</para>
  <para style="li2" vid="1CH 15:5">Uriel adadusʌñ ye nditọete 120 (ikie keed mme edịb);<verse eid="1CH 15:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6" />ke ubon Merari,</para>
  <para style="li2" vid="1CH 15:6">Asaiya adadusʌñ ye nditọete 220 (ikie iba mme edịb);<verse eid="1CH 15:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7" />ke ubon Kesọn<note caller="+" style="f"><char style="fr" closed="false">15:7 </char><char style="ft" closed="false">Ke Hibru Kesọm ado ukem ye Kesọn</char></note>,</para>
  <para style="li2" vid="1CH 15:7">Yuel adadusʌñ ye nditọete 130 (ikie keed mme edịb mme duob);<verse eid="1CH 15:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8" />ke ubon Elisafan,</para>
  <para style="li2" vid="1CH 15:8">Semaiya adadusʌñ ye nditọete 200 (ikie iba);<verse eid="1CH 15:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9" />ke ubon Hibrọn,</para>
  <para style="li2" vid="1CH 15:9">Eliel adadusʌñ ye nditọete 80 (anaañ);<verse eid="1CH 15:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10" />ke ubon Usiel,</para>
  <para style="li2" vid="1CH 15:10">Aminadab adadusʌñ ye nditọete 112 (ikie keed mme duob mme iba).<verse eid="1CH 15:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />Akem Defid amaasịn uyio akoot Sadọk ye Abiata andikido aku, ndin ye Uriel, Asaiya, Yuel, Semaiya, Eliel ye Aminadab awo Lifai. <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />Anye amaabo ammọ ate, “Ndufo edo mme iwuod ke ubon mme Lifai ami; ndufo ye mbon Lifai mfen ana nte enam idem ndufo esana enyʌñ eben akebe edioomo <char style="nd">Abọọñ</char>, Abasi Isrel, edi itie ami ñkebeeñeke nnịm nnọ anye. <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />Akedo sia ndufo, mme Lifai, ikibenne anye idi ke akpa ini <char style="nd">Abọọñ</char> Abasi ñnyịn akeyatta esịd ye ñnyịn. Ñnyịn ikibịppe anye ibaña naña ikpinam anye ke usʌñ a-afọnnọ.” <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />Ndin mme aku ye mme Lifai emaenam idem ammọ esana mbaak ammọ ekeben akebe edioomo <char style="nd">Abọọñ</char>, Abasi Isrel. <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />Ndin mbon Lifai emaeben akebe edioomo Abasi ye mme ukwak ke afara ammọ, naña Moses aketemme ye naña asaña akekem ye ikọ <char style="nd">Abọọñ</char>.<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />Defid amaadọkkọ mme adadusʌñ mbon Lifai ate yak esio mbon Lifai ammọ enịm nte mbon ikwọ edikama mme ndido ikwọ nnam uyom idaara: mme ndidoudʌk, mme ekpa ye mme simbal.<verse eid="1CH 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17" />Ndin mme Lifai emaemek Heman ayịn Yuel; ke ñkañ aduuk amọ, emek Asaf ayịn Berekia; ndin ke ñkañ nditọete ammọ, emek mbon Merari, Etan ayịn Kusaiya; <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />ndin ye mme nditọete ammọ mfen ekedianake ammọ ke ndaha: Sakaraiya, Yaasiel, Semiramod, Yehiel, Unni, Eliab, Benaiya, Maaseiya, Matitia Elifelehu, Mikneiya Obed-Edom ye Yeiyel mme akpeme inuaatob.<verse eid="1CH 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19" />Mme mbon ikwọ Heman, Asaf ye Etan ekena nte efịt ndido ake brọns; <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />Akena Sakaraiya, Yaasiel<note caller="+" style="f"><char style="fr" closed="false">15:20 </char><char style="ft" closed="false">Yaasiel asʌk ado Asiel ke Hibru</char></note>, Semiramod, Yehiel, Unni, Eliab, Maaseiya ye Benaiya ebre mme ndidoudʌk nte ake <char style="tl">alamọd,</char> <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />Ndin Matitia, Elifelehu, Mikneiya, Obed-Edom, Yeiyel ye Asasia ekena nte ebre mme ekpa nte ake <char style="tl">Seminid.</char> <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />Kenania andikido iwuod mbon Lifai akedo adadusʌñ ke ikwọ; ubiọñutom amọ akedo ado sia anye amaadiọọñọ anyʌñ anie asaña-asaña enọ.<verse eid="1CH 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23" />Berekia ye Elkana ekena nte edo mme akpeme inuausʌñ nnọ akebe edioomo. <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />Sebania, Yosafad, Netanel, Amasai, Sakaraiya, Benaiya ye Eliesa aku ekena nte efịt adukpoñ ke iso akebe edioomo Abasi. Obed-Edom ye Yehia ñko ekena nte ekpeme inuausʌñ akebe edioomo.<verse eid="1CH 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />Ndin Defid ye mme ñkpisọñ Isrel ye mme ikpọ mme adaiso udịmekọñ ake ikpeghe tọsịn keed emaekaa adikiben akebe edioomo <char style="nd">Abọọñ</char> ke ufọk Obed-Edom, ke idaara. <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />Sia Abasi amaakenwam mme Lifai ekebenne akebe edioomo <char style="nd">Abọọñ</char>, emaewa ñyaara enañ itiaba ye akukịmedọñ itiaba. <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />Ndin emaesịn Defid uyaiya afọñ linen, ukem naña ekesịn afịd mme Lifai e-ekebenne akebe edioomo ado, kpa ye mbon ikwọ, ye mbon Kenania, a-akeseeghe ñkpọ abaña ikwọ ye mbon ikwọ. Defid amaanyʌñ asịne afọñ aboditọñ ake linen. <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />Ndin afịd mbon Isrel emaeben akebe edioomo <char style="nd">Abọọñ</char> ye ñkpo, ye ufịt uyom nnʌk akukịmedọñ ye mme adukpoñ, ye ake mme simbal, ye adibre mme ndidoudʌk ye mme ekpa.<verse eid="1CH 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29" />Idaha akebe edioomo <char style="nd">Abọọñ</char> akesʌkkọ adʌk Abio Defid, Maikal ayịn awonwaan Sọọl amaada ke ubenafịm ase. Ke anye amaakekịt Adidem Defid naña anek unek anyʌñ adaara, anye amaase anye ke ndek ke esịd amọ.<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="s1">Adinam Uwa Itooro Mbaña Akebe Edioomo Abasi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />Ammọ emaeben akebe edioomo Abasi edʌk edinịm ke esịd atayad ake Defid akewuuhọ anọ anye, ndin ammọ emaenyʌñ ewa ufọfọb uwa ye uwa adidiana keed ke iso Abasi. <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />Ke Defid amaakema ufọfọb uwa ye uwa ewuana, anye amaadiọñ mbon awo ke anyịñ <char style="nd">Abọọñ</char>. <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />Ndin anye amaanọ eboho uyo keed, ye eboho uyo enwannanwan ye eboho nsaad ndomuyo, edeeme enọ afịd mbon Isrel, ibaan ye ideen.<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />Anye amaamek ubaak mbon Lifai adinam utom ke itie akebe edioomo <char style="nd">Abọọñ</char>, adinọ anye ubọọñ, ñkọọm, ñnyʌñ ntooro <char style="nd">Abọọñ</char>, Abasi Isrel: <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />Asaf akedo abọọñ, ndin udiana amọ ke ndaha ekedoñño Sakaraiya, ndin Yaasiel, Semiramod, Yehiel, Matitia, Eliab, Benaiya, Obed-Edom ye Yeiyel. Akena nte ammọ ebre mme ndidoudʌk ye mme ekpa, Asaf akena nte anyeghe mme simbal, <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />ndin mme aku Benaiya ye Yahasiel ekena nte efịt mme adukpoñ ndin-ndin ke iso akebe edioomo Abasi.<verse eid="1CH 16:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />Ke usen ado Defid amaamek Asaf ye mbon nsaña amọ adinọ <char style="nd">Abọọñ</char> itooro ke usʌñ ami:<verse eid="1CH 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8" />Nọ <char style="nd">Abọọñ</char> itooro, koot anyịñ amọ;</para>
  <para style="q2" vid="1CH 16:8">ben se anye anam tañ nọ afịd mme idịd.<verse eid="1CH 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9" />Ikwọ inọ anye, ikwọ itooro inọ anye;</para>
  <para style="q2" vid="1CH 16:9">itañ ibaña afịd mme utịppe adinam se anye anam.<verse eid="1CH 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10" />Ubọọñ anie adisana anyịñ amọ;</para>
  <para style="q2" vid="1CH 16:10">yak esịd mbon e-eyemme <char style="nd">Abọọñ</char> edaara.<verse eid="1CH 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11" />Iwuuk anyen ise <char style="nd">Abọọñ</char> ye adudu amọ;</para>
  <para style="q2" vid="1CH 16:11">iyem iso amọ afịd-afịd ini.<verse eid="1CH 16:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12" />Itoiyo mme utịppeñkpọ se anye anam,</para>
  <para style="q2" vid="1CH 16:12">mme utịppeñkpọ amọ, ye mme ubiideikpe a-anye akenọọhọ,<verse eid="1CH 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13" />ndufo mme isʌñutom amọ, mme ntịppe ubon Isrel,</para>
  <para style="q2" vid="1CH 16:13">mme andimek amọ, mme nditọ Yekọb.<verse eid="1CH 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14" />Anye ado <char style="nd">Abọọñ</char> Abasi ñnyịn;</para>
  <para style="q2" vid="1CH 16:14">ubiideikpe amọ aba ke afịd ederimbod.<verse eid="1CH 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15" />Anye atoiyo edioomo amọ ke nsi-nsi,</para>
  <para style="q2" vid="1CH 16:15">enwọñọ anye akenamma ke tọsịn emana,<verse eid="1CH 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16" />edioomo a-anye akenamma ye Ebraham,</para>
  <para style="q2" vid="1CH 16:16">enwọñọ a-anye akenwọñọke anọ Aisik.<verse eid="1CH 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17" />Anye amaasọọñọ ami anọ Yekọb nte ewʌhọ</para>
  <para style="q2" vid="1CH 16:17">anyʌñ anọ nditọ Isrel nte nsi-nsi edioomo:<verse eid="1CH 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18" />“Ami ñyainọ ndufo isọñ Kenan</para>
  <para style="q2" vid="1CH 16:18">nte udeeme ndufo.”<verse eid="1CH 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19" />Ke idaha ammọ imiikiwakka ke ibad,</para>
  <para style="q2" vid="1CH 16:19">enekke esịp, enyʌñ edo isenawo ke esịd,<verse eid="1CH 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20" />ammọ emaeyooñ eto idịd keed esịm idịd mfen,</para>
  <para style="q2" vid="1CH 16:20">etọọñọ ke abio keed tutu esịm mfen.<verse eid="1CH 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21" />Anye ikiyakka awo ndomokeed afiik ammọ;</para>
  <para style="q2" vid="1CH 16:21">ke ntak ammọ anye amaasua anọ mme ndidem:<verse eid="1CH 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22" />“Ikiituuk mbon se ami mmaakeyet adan;</para>
  <para style="q2" vid="1CH 16:22">ikiinam mme prọfed mmi idiọọkñkpọ.”<verse eid="1CH 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23" />Ikwọ inọ <char style="nd">Abọọñ</char>, afịd ederimbod;</para>
  <para style="q2" vid="1CH 16:23">ikwọrọ adinyaaña amọ ke usen ke usen.<verse eid="1CH 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24" />Itañ ubọọñ amọ ke atu mme idịd,</para>
  <para style="q2" vid="1CH 16:24">mme utịppeñkpọ amọ ke atu afịd mme awo.<verse eid="1CH 16:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25" />Sia <char style="nd">Abọọñ</char> akpon anyʌñ anekke adot itooro;</para>
  <para style="q2" vid="1CH 16:25">anye ado se ebaak ekan afịd mme abasi.<verse eid="1CH 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26" />Sia afịd mme abasi mme idịd edoñño ubobodñkpọ,</para>
  <para style="q2" vid="1CH 16:26">ado <char style="nd">Abọọñ</char> akenam mme hefịn.<verse eid="1CH 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27" />Uyai ye ukpono eba anye ke iso;</para>
  <para style="q2" vid="1CH 16:27">adudu ye idadesịd enyʌñ eba ke itie idʌñ amọ.<verse eid="1CH 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28" />Inọ <char style="nd">Abọọñ</char>, afịd ndufo mme ubon ke idịd,</para>
  <para style="q2" vid="1CH 16:28">inọ <char style="nd">Abọọñ</char> ubọọñ ye adudu.<verse eid="1CH 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29" />Ndufo inọ <char style="nd">Abọọñ</char> ubọọñ a-adotto ye anyịñ amọ,</para>
  <para style="q2" vid="1CH 16:29">iben enọ idi ke iso amọ.</para>
  <para style="q1" vid="1CH 16:29">Ikpono <char style="nd">Abọọñ</char> ke uyai adisana itie amọ.<verse eid="1CH 16:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="1CH 16:30" />Inie ndịk ke iso amọ, afịd mme idịd!</para>
  <para style="q2" vid="1CH 16:30">Ederimbod asọọñọ ada; ikemeke adifemme.<verse eid="1CH 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31" />Yak mme anyọñ edaara, yak mme isọñ enyʌñ enem esịd;</para>
  <para style="q2" vid="1CH 16:31">yak ammọ etañ ke atu mme idịd, “<char style="nd">Abọọñ</char> akaara!”<verse eid="1CH 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32" />Yak inyañ ibom afuut, ye afịd se iba anye ke esịd;</para>
  <para style="q2" vid="1CH 16:32">yak mme akpa inwañ eba ke idaara, ye afịd ñkpọ se iba anye ke esịd.<verse eid="1CH 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33" />Yak mme eto ke akai ekwọ,</para>
  <para style="q2" vid="1CH 16:33">yak ammọ ekwọ ke idadesịd ke iso <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="1CH 16:33">sia anye adi adikpe ikpe ederimbod.<verse eid="1CH 16:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34" />Inọ <char style="nd">Abọọñ</char> ekọọm, sia anye afọn;</para>
  <para style="q2" vid="1CH 16:34">ima amọ ado ke nsi-nsi.<verse eid="1CH 16:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35" />Isio ñkpo, “Inyaaña ñnyịn, Abasi Andinyaaña ñnyịn;</para>
  <para style="q2" vid="1CH 16:35">tañ ñnyịn bok nyʌñ isio ñnyịn fep ke mme idịd,</para>
  <para style="q1" vid="1CH 16:35">nọ ñnyịn inọ adisana anyịñ mfo ekọọm,</para>
  <para style="q2" vid="1CH 16:35">inyʌñ ibọ ubọọñ ke itooro mfo.”<verse eid="1CH 16:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36" />Itooro anie <char style="nd">Abọọñ</char>, Abasi Isrel,</para>
  <para style="q2" vid="1CH 16:36">ke nsi-nsi tutu ke nsi-nsi.</para>
  <para style="m" vid="1CH 16:36">Ndin afịd awo emaebọọrọ, “Amen” ye “Itooro <char style="nd">Abọọñ</char>.”<verse eid="1CH 16:36" /></para>
  <para style="b" />
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />Ndin Defid amaakpọñ abio Asaf ye mme nsaña amọ mbemiso akebe edioomo <char style="nd">Abọọñ</char> adinam ñkpọ do ndin-ndin, akeene mme ndutʌm usen keedekeed. <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />Anye amaanyʌñ akpọñ Obed-Edom ye mme nsaña amọ awo ata mme itiaita adinam ñkpọ do ye ammọ. Obed-Edom ayịn Yedutun, ñko ye Hosaa, ekedoñño mme akpeme inuaatob.<verse eid="1CH 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39" />Defid amaakpọñ Sadọk, aku ye mme aku ammọ mfen ke iso tabanakịd <char style="nd">Abọọñ</char> ke ñkoñ-ñkoñ itie ke Kibiọn <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />adinọ <char style="nd">Abọọñ</char> ufọfọb uwa ke akpokoro ufọp uwa ndin-ndin, ke ubakusen ye ndubiayio, ukem-ukem ye afịd se ewet ke Mbed <char style="nd">Abọọñ</char>, anye akenọọhọ Isrel. <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />Mbon se ikiba ye ammọ ekedoñño Heman ye Yedutun ye mbon mfen ekemekke enyʌñ esiak anyịñ adinọ <char style="nd">Abọọñ</char> ekọọm, “sia ima amọ aba ke nsi-nsi.” <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />Heman ye Yedutun ekenie ubiọñutom adifịt adukpoñ ye simbal ñko ye adibre mme ndido mfen nnọọ adisana ikwọ ukpono. Ekedaaha nditọ ideen Yedutun ke inuaatob.<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />Ndin afịd awo emaenyʌñ enyọñọ ufọk ammọ keedekeed, ndin Defid amaatịmme anyọñ akaa adikidiọñ ufọk amọ.<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s1">Enwọñọ Abasi Anwọñọke Anọ Defid</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />Ke ini Defid amaaketie ke ufọk ubọọñ amọ, anye amaabo prọfed Natan ate, “Se miin mi, ndʌñ ke ufọk sida, ke ini akebe edioomo <char style="nd">Abọọñ</char> asịneke ke idak atayad.”<verse eid="1CH 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2" />Natan amaabọọrọ Defid ate, “Se adodo a-afo anieghe ke esịd, nam, sia Abasi mmọdo aba mme afo.”<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />Ado ke akonayio ado, uyio Abasi amaabo Natan, ate:<verse eid="1CH 17:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4" />“Kaa kedọkkọ isʌñutom mmi Defid, ‘Se <char style="nd">Abọọñ</char> atañ ado ami: Idooho afo uduubọp ufọk ake ami ndiidʌñ ke esịd. <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />Ami ndʌññọ ke ufọk tọọñọ ke usen ami ñkebenne Isrel nsio ke Iyib tutu usen mfịn ami. Ami mmesaña tọọñọ ke atayad keed tutu ñkesịm mfen, tọọñọ ke itie idʌñ keed kaa kewuọ mfen. <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />Ke afịd usʌñisañ mmi ye nditọ Isrel, akenam ami mmaadọkkọ keed ke atu mme andikara<note caller="+" style="f"><char style="fr" closed="false">17:6 </char><char style="ft" closed="false">mme abiideikpe: se ñko ke 1 Kr 17:10</char></note> ammọ ami ñkenọọhọ mbo ebọọk ikọd mmi Isrel nte, “Nsoo ido ke ndufo ekama sida ebọp ufọk ennọ miin?” ’<verse eid="1CH 17:6" /></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7" />“Idahami ndin, dọkkọ isʌñutom mmi Defid, ‘Se <char style="nd">Abọọñ</char> Andikponñkan atañ ado ami: ami ñkuben fiin ñkpọñ itie ubọọk ufene, uben nsio ke ukpeme ufene, ñnyʌñ umek fiin andikara ikọd mmi Isrel. <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />Ami mmeba ye afo ke itie nte afo akaaka, ndin ami mmediañña afịd mme asua mfo mfep ke iso mfo. Idahami ami ñyaanam anyịñ mfo aba nte anyịñ mme ñkpọsọñ awo ke ederimbod. <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />Ami ñyaanịm itie nnọ ikọd mmi Isrel ñnyʌñ nsọọñọ ammọ nnịm nọ ammọ enie itieidʌñ ammọ, mbaak awo adifịna ammọ aba. Mbon ibak idiifiighe ammọ aba, nte naña ammọ ekenam ke aditọọñọ <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />nte e-enyʌññọ enam tọọñọ ko ke ini ami ñkemekke mme adaaha nnọ mme ikọd mmi Isrel. Ami ñyaanyʌñ nsuuk afịd mme usua mfo nnịm.</para>
  <para style="pm" vid="1CH 17:10">“ ‘Ami mmenwọñọ unọ fiin nte ke <char style="nd">Abọọñ</char> ayaabọp ufọk unọ fiin: <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />Mme usen uwem mfo ke isọñ emaekweeñe ndin afo anyʌñ anyọñ aka akeba ye mme eteete mfo, Ami ñyaabenne mfịd mfo yak adat itie mfo, keed ke atu nditọ ideen mfo, ndin Ami ñyaanam ubọọñ amọ asọọñọ ada. <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />Anye ado awo adiibọp ufọk innọ miin, ndin Ami ñyaawuuk ebekpo ubọọñ amọ ke nsi-nsi. <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />Ami ñyaado ete amọ, ndin anye ayaanyʌñ ado ayịn mmi. Ami ndiibenne ima mmi nsio ñkpọñ anye tutu amama, naña ami ñkeben nsio ñkpọñ mbon ekebaaha mbemiso afo. <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />Ami ñyaanam anye akaara ke ufọk mmi ye abioubọọñ mmi ke nsi-nsi; ebekpo ubọọñ amọ ayaaba ke nsi-nsi.’ ”<verse eid="1CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15" />Natan amaakedọkkọ Defid afịd mme ikọ ñkukịd ami.<verse eid="1CH 17:15" /></para>
  <para style="s1">Akam Defid</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />Ndin adidem Defid amaadʌk aketie ke iso <char style="nd">Abọọñ</char>, anyʌñ abo ate,</para>
  <para style="pm" vid="1CH 17:16">“Ami ndo anie awo, <char style="nd">Abọọñ</char> Abasi, ndin ubon mmi ado nsoo, ake afo ambenne miin adiwuọ utọ ekamba itie ami? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />Ndin aba nte ami isʌkkọ ikekem ke anyen mfo, Abasi mmi, afo ametañ ikọ abaña ini iso ufọk isʌñutom mfo. Afo, <char style="nd">Abọọñ</char> Abasi, amenyʌñ anse miin nte ebo ke ami ndo ataa andikpon ñkan ke atu mme awo.<verse eid="1CH 17:17" /></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18" />“Nsoo ñkpọ mfen ke Defid akeme aditañ unọọ fiin ke Afo adikpono isʌñutom mfo? Sia Afo amediọọñọ isʌñutom mfo, <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" /><char style="nd">Abọọñ</char>. Ke ntak isʌñutom mfo ye ke uduak mfo, afo amenam afịd ikpọ ñkpọ ami anyʌñ anam ediọọñọ ebaña afịd mme ikpọ enwọñọ ami.<verse eid="1CH 17:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20" />“Ibaaha anditie nte afo, <char style="nd">Abọọñ</char>, ñko inyʌññọ iba Abasi mfen kpa afo ikpọọñ, nte naña ñnyịn ikop ke utọñ ñnyịn. <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />Ndin mme anie iba nte ikọd mfo Isrel, idịd keed ke iso isọñ ake Abasi akekaaha akefak asio anọ idem amọ, anyʌñ anịm anyịñ anọ idem mfo, anyʌñ anam ñkpoon ye mme utịbe ñkpọ ke adibịne mme idịd ye mme abasi ammọ nsịññe ke iso ikọd mfo, ake afo akefakka asio ke isọñ Iyib? <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />Afo amaanam ikọd mfo Isrel edo asaña-asaña ake mfo ke nsi-nsi, afo ñko, <char style="nd">Abọọñ</char>, amaanyʌñ akappa ado Abasi ammọ.<verse eid="1CH 17:22" /></para>
  <para style="pm">
    <verse number="23" style="v" sid="1CH 17:23" />“Ndin, <char style="nd">Abọọñ</char>, yak enwọñọ a-afo anamma abaña isʌñutom mfo ye ufọk amọ asọọñọ ada ke nsi-nsi. Nam naña afo akenwọñọ, <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />nọ anye asọọñọ ada ñko ma anyịñ mfo akpon ke nsi-nsi. Ndin mme awo eyaebo ete, ‘Ado <char style="nd">Abọọñ</char> Andikponñkan, Abasi andikara Isrel, ado Abasi Isrel!’ Ndin ufọk awo mfo Defid ayaasọọñọ ada ke iso mfo.<verse eid="1CH 17:24" /></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25" />“Afo, Abasi mmi, ameyaara anọ afʌnadeen mfo ate ke afo ayaabọp ufọk anọ anye. Ntom ke afʌnadeen mfo anie uko adibọñ akam unọọ fiin. <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />Afo, <char style="nd">Abọọñ</char>, ado Abasi! Afo amaanwọñọ mme nti ñkpọ ami anọ awo mfo. <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />Idahami unem fiin esịd adidiọñ ufọk afʌnadeen mfo, nọ anye akaiso aba ke iso mfo ke nsi-nsi; sia afo, <char style="nd">Abọọñ</char>, amediọñ anye, ndin eyaediọñ anye ke nsi-nsi.”<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s1">Mme Edikan Defid</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />Nte ini akaaha iso, Defid amaakan mbon Filistia amaanyʌñ asịn ammọ ke idak ukara amọ, anye amaaben Kad ye mme ñkanñkʌk idʌñ asio ke ukara mbon Filistia.<verse eid="1CH 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2" />Defid ñko amaakan mbon Mọb, ndin ammọ emaekappa edo ifʌn amọ enyʌñ ekpe isob enọ anye.<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />Ke akanna ado, Defid amaakan Hadadesa adidem Soba, ke ñkanñkʌk Hamad, ke idaha anye akekaaha adisọọñọ ukara amọ ke edem inyañ Yufretis. <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />Defid amaamʌm sariọd amọ tọsịn keed (1,000), anyʌñ amʌm mbon uwad sariọd tọsịn itiaba (7,000) ye mbon ekọñ e-esañake ke ukod awo tọsịn edịb (20,000). Anye amaakpok mme sariọd ado akpan asịb ado ayaak enañ sariọd ikie abono.<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />Ke ini mbon Aram ke Damaskọs ekedieghe edinwam Hadadesa adidem Soba, Defid amaawot awo ammọ tọsịn edịb mme iba (22,000). <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />Anye amaanịm itie mbonekọñ ke idʌñ ubọọñ Aram ke Damaskọs, ndin mme mbon Aram ekeba ke idak ukara amọ enyʌñ ekpe isob enọ anye. <char style="nd">Abọọñ</char> amaanọ Defid edikan ke itie akeedodo anye akekaaha.<verse eid="1CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7" />Defid amaakoono mme atuekọñ kold ake mme adaaha Hadadesa ekekamake anyʌñ akoono ammọ adikaa Yeruselem. <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />Defid amaakoono uwak udomo brọns, tọọñọ ke ñkan Teba<note caller="+" style="f"><char style="fr" closed="false">18:8 </char><char style="ft" closed="false">Ke Hibru Tibhad asʌk ado Teba</char></note> ye Kun, mme abio Hadadesa, a-Sọlọmọn akekamake anam ekamba abesịn brọns, mme abai ye nsio-nsio ñkpoduoho brọns.<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />Ke ini Tou adidem Hamad akekoppo ke Defid amaakan afịd udịmekọñ Hadadesa adidem Soba, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />anye amaadọñ ayịn amọ Hadoram abịne adidem Defid akekọọm anye anyʌñ atooro anye ke adikikan Hadadesa ke ekọñ, sia adooho Hadadesa amaasiba ke ekọñ ye Tou. Hadoram amaakoono afịd mme nsio-nsio ñkpoduoho kold, silfa ye ake brọns adi.<verse eid="1CH 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11" />Adidem Defid amaayaak mme ñkpoduoho ami asaña-asaña anọ <char style="nd">Abọọñ</char>, kpa naña anye akenam ye mme silfa ye mme kold a-anye akekoonoke ato afịd mme idịd ami: Edọm ye Mọb, mbon Amọn ye mbon Filistia, ye Amalek.<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />Abisai ayịn Seruya amaawot mbon e-etooho Edọm awo tọsịn duob mme itiaita (18,000) ke Abedeñ Inʌñ. <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />Anye amaanịm mme itie mbonekọñ ke Edọm, ndin ata afịd mbon Edọm emaekappa eba ke idak ukara Defid. <char style="nd">Abọọñ</char> amaanọ Defid edikan ke afịd itie nte anye akekaaka.<verse eid="1CH 18:13" /></para>
  <para style="s1">Mme Adaaha Defid</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />Defid amaakara ke afịd Isrel, anyʌñ anam se ido unen ye se inen anọ afịd ikọd amọ.<verse eid="1CH 18:14" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="15" style="v" sid="1CH 18:15" />Yoab ayịn Seruya akedo adaiwuod ekọñ, Yehosafad ayịn Ahilud akedo anamibad;<verse eid="1CH 18:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 18:16" />Sadọk ayịn Ahitub ye Ahimelek ayịn Abiata ekedoñño mme aku;</para>
  <para style="li1" vid="1CH 18:16">Safsa akedo awedñwed;<verse eid="1CH 18:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 18:17" />Benaiya ayịn Yehoiyada akekara mbon Kered ye mbon Peled;</para>
  <para style="li1" vid="1CH 18:17">ndin nditọ ideen Defid ekedoñño mme mbọọñ mme adaaha ukara e-ebaaha ke ñkañ adidem.<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s1">Defid Akan Mbon Amọn</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />Nte ñkpọ akaaha iso, Nahas adidem mbon Amọn amaakpa, ndin ayịn amọ amaadat itie amọ nte adidem. <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />Defid amaakere ke esịd amọ ate, “Ami ñyaafọn ido ye Hanun ayịn Nahas, sia ete amọ amaafọn ido ye ami,” Ndin Defid amaasio mme isʌñutom adọñ abo ekedọñ Hanun esịd ke ntak ñkpa ete amọ.</para>
  <para style="p" vid="1CH 19:2">Ke mme isʌñutom Defid emaekedisoobo ye Hanun ke isọñ mbon Amọn adiseeme ye anye, <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />mme adaiso mbon ekọñ Amọn emaebo Hanun, “Afo akere abo ke Defid anam ami adikpono ete mfo ke adinọ isʌñutom edi ediseeme ye afo? Nte idooho mme isʌñutom amọ edi ubịne fiin ediduuñọ ñnyʌñ ñyep idʌñ mfo ma edooro idịd ami ke ubọọñ?” <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" />Ndin Hanun amaamuum mme ikpọ isʌñutom Defid, akwaat ammọ ided, afat mme afọñ ammọ mbai-mbai ke efʌd, anyʌñ abịn ammọ ate enyọñọ.<verse eid="1CH 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5" />Ke ini awo adidọkkọke Defid abaña se ikitịppe inọ mme isʌñutom ami, anye amaadọñ mbon utom amọ ekesoobo ammọ, sia emaenekke esuenne ammọ ataa eti-eti. Adidem amaabo ammọ ate, “Iba ke Yeriko tutu ñwaebek ndufo amaana atịppe, mbemiso ndufo etịmme enyọñ edi.”<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />Ke ini mbon Amọn ekekịtte ebo ke mmimọ imiyat Defid esịd, Hanun ye mbon Amọn emaenọ talen silfa tọsịn keed (1,000)<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">A-adooho ñkpọ nte tọọn 38 me metrịk tọọn 34</char></note> adikikpe mbọọ mme sariọd ye mbon uwad sariọd e-etooho Aram Naharaim, Aram Maaka ye Soba. <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />Ammọ emaekpe mme sariọd ye mbon uwad sariọd tọsịn edịb mme duob mme iba (32,000), ukem ado ye adidem Maaka ye udịmekọñ amọ, ekedieghe edinam nnaaekọñ ekpere Medeba, ke ini mbon Amọn ekewuọñọke ke abio ammọ enyʌñ edibono eba ke mbeeñeidem ediwuọ ñkaa ekọñ.<verse eid="1CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8" />Defid akekop ami, anye amaasio Yoab ye afịd udịm mbon unwana ekọñ adọñ. <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />Mbon Amọn emaewuọñọ edibeeñe idem eda ke udịm unwana ekọñ ke inuaatob abio ammọ, ke ini mme ndidem e-ekediighe eketieghe ke idem ammọ ke ñnwaña-ñnwaña itie.<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10" />Yoab amaakịt ke mme udịmekọñ mmọdo eba ke iso ye ke edem amọ, anye ndin amaasat ubaak mme nta anwanaekọñ ke Isrel anyʌñ asio ammọ adọñ eka ekenwana ye mbon Aram. <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />Anye amaasịn ubaak mbon ekọñ se ikisʌhọ ke idak ndadusʌñ Abisai ayịneka amọ awodeen, ndin emaedọñ ammọ eka ekenwana ye mbon Amọn. <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />Yoab amaabo ate, “Adieke mbon Aram esọññọ adudu eñkan miin, ana ndufo ediñnyaaña miin; ado mbon Amọn ekpesọñ adudu ikan ndufo, ndin ami ñyainyaaña ndufo. <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />Ikop uko, yak ñnyịn inyʌñ inwana uko-uko inọ ikọd ñnyịn ye mme abio ake Abasi ñnyịn. <char style="nd">Abọọñ</char> ayaanam se ifọn anye ke anyen.”<verse eid="1CH 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14" />Ndin Yoab ye udịmekọñ ekesañake ye anye emaewuọñọ ekaa edinwana ye mbon Aram, ndin mbon Aram emaefeeñe ke iso amọ. <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />Ke ini mbon Amọn ekekịtte ebo ke mbon Aram ekesʌk efeeñe, ammọ ñko emaefeeñe ke iso ayịneka amọ Abisai enyʌñ ekedʌk abio. Ndin Yoab amaatịmme anyọñ akaa Yeruselem.<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />Ke ini mbon Aram ekekịtte ebo ke Isrel ikan mmimọ, ammọ emaedọñ mme isʌñutom enyʌñ enam eben mbon Aram edi edem inyañ Yufretis, Sopak adaiwuod mbonekọñ Hadadesa akedat ammọ usʌñ.<verse eid="1CH 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17" />Ke emaekedọkkọ Defid ñkpọ ami, anye amaakoot afịd mbon Isrel anyʌñ aboiyo Yọdan; anye amaasaña abịne ammọ anyʌñ atịm udịmekọñ amọ ke mbeeñeidem ke nsakiso ammọ. Defid amaaneeñe ammọ ke udịm ke mbeeñeidem adisoobo ye mbon Aram ke ekọñ, ndin ammọ emaenyʌñ enwana ye anye. <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />Ado mbon Aram emaefeeñe ke iso Isrel, ndin Defid amaawot mbon ake ekewatta sariọd ammọ awo tọsịn itiaba (7,000) ye mbon ekọñ ake ekesañake ke ukod ammọ tọsịn aba (40,000). Anye amaanyʌñ awot Sopak adaiso ekọñ ammọ.<verse eid="1CH 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19" />Ke ini mme akama utom ukara Hadadesa ekekịtte ke mbon Isrel emaekan ammọ, ammọ emaekekpe emem ye Defid enyʌñ ekappa esịne ke idak ukara amọ.</para>
  <para style="p" vid="1CH 19:19">Ndin mbon Aram ikinyịmmeke adinwam mbon Amọn aba.<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s1">Adimʌm Raba</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />Ke ntọọñọ isua amaakebakka, ke ini ndidem esiwuọñọke eka ekọñ, Yoab amaadat mme udịmekọñ amọ awuọ. Anye amaanịm isọñ mbon Amọn ukpọk anyʌñ akaa ke Raba akekanna anye akʌk, ado Defid akeba ke Yeruselem. Yoab amaanwana ye isọñ Raba anyʌñ anịm anye ke nsobo. <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />Defid amaayaara anyanya ke iwuod adidem ammọ; udob amọ akedo talen kold keed<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">A-adooho ñkpọ nte kilokram 34</char></note>, ekenyʌñ enam anye ke nsọñudua itiad ndin emaenyʌñ eben anye edot Defid ke iwuod. Anye amaakoono ataa uwak ñkpọ mbịme ato abio ado <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />anyʌñ asịññe mme awo se ikiba do, adeeme ammọ anọ utom ye uyọọkñkpọ ye mme ukịmisọñ ñkọrọ mme ekịd. Defid akenam ami ke afịd mme abio Amọn. Akem Defid ye afịd udịmekọñ amọ emaenyọñọ ekaa Yeruselem.<verse eid="1CH 20:3" /></para>
  <para style="s1">Ekọñ ye Mbon Filistia</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />Ke ini amaakeboiyo, ekọñ amaatịppe ye mbon Filistia, ke Kesa. Ke ini ado Sibekai awo Husa amaawot Sipai, awo keed ke atu ntịppe ubon mbon Refaim, ndin mbon Filistia emaeba ke idak ukara mbon Isrel.<verse eid="1CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5" />Ke ekọñ mfen ye mbon Filistia, Elhanan, ayịn Yaiye amaawot Laami ayịneka awodeen Koloyad awo Kad, a-akekamake eduad e-esañ amọ akebaaha nte eto udọkafọñ.<verse eid="1CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6" />Kpa ke iso ekọñ mfen, e-ekenwanake ke Kad, ekaa anyan awodeen keed amaaba a-akenieghe nnuunubọk itiokeed ke ubọk amọ naña iba ye nnuun ukod itiokeed ke ukod amọ naña iba, afịd akedo edịb mme inaañ. Anye ñko aketo ubon Rafa. <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />Ke ini anye akenọọhọ Isrel ñnyọọ, Yọnatan ayịn Simei, ayịneka awodeen Defid, amaawot anye.<verse eid="1CH 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8" />Mbon ami ekedoñño mbon ubon Rafa ke Kad, ndin ammọ emaekpañña ke ubọk Defid ye ikọd amọ.<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s1">Defid Abat Mbon Ekọñ Amọ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />Setan amaadakka ada anam ikọ ye nditọ Isrel anyʌñ anyịk Defid nọ anam ubadawo ke Isrel. <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />Ndin Defid amaabo Yoab ye mme adaiso mbon ekọñ ate, “Ikaa ikibat mbon Isrel tọọñọ ke Beeseba tutu akewuọ Daan. Ndin inyọñ idindọkkọ miin nọ ami ndiọọñọ me ammọ ewak die.”<verse eid="1CH 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3" />Ado Yoab amaabọọrọ, “<char style="nd">Abọọñ</char> akpekap anam udịmekọñ amọ awak ke itie ikie (100) akan naña akedo. Abọọñ mmi ye adidem mmi, nte ammọ idooho ikọd mfo? Nsoo inam nọ abọọñ mmi ayem adinam utọ ñkpọ ami? Nsoo inam yak anye akpeben ndudue anọ Isrel?”<verse eid="1CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4" />Ado uyio adidem amaasọñ akan uyio Yoab; ndin Yoab amaadakka anyʌñ asaaña ke afịd Isrel akem atịmme anyọñ adi Yeruselem. <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />Yoab amaakedọkkọ Defid ibad mme anwana ekọñ se iba: Ke afịd isọñ Isrel akedo ideen miliọn keed mme tọsịn ikie keed (1,100,000) ekeba se ikikan adikama akañkañ, adiana ye awo tọsịn ikie inaañ mme ata mme duob (470,000) ke Yuda.<verse eid="1CH 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6" />Ado Yoab ikisịnne mbon Lifai ye mbon Benyamin ke ibad ami, sia ewʌhọ adidem amaadiọọk anye esịd. <verse eid="1CH 21:6" /><verse number="7" style="v" sid="1CH 21:7" />Ewʌhọ ami ñko akedo idiọọkñkpọ ke iso Abasi; ndin anye amaamia Isrel ufen.<verse eid="1CH 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8" />Akem Defid amaabo Abasi, “Ami mmenam ekamba idiọọkñkpọ ke adinam ami. Idahami, ami mmuukpeiye fiin, ben ndudue awo mfo fep. Ami mmenam ataa ndisịme ñkpọ.”<verse eid="1CH 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />
    <char style="nd">Abọọñ</char> amaabo Kad, akịdñkukịd nnọọ Defid, <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />“Kaa kedọkkọ Defid, ‘Ami ado se <char style="nd">Abọọñ</char> atañ: Ami unọ fiin usʌñ ñkpọ ita. Mek keed ke atu ammọ sio se ami mben umia fiin ufen.’ ”<verse eid="1CH 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11" />Ndin Kad amaakaa abịne Defid akebo anye, “Ntom ke <char style="nd">Abọọñ</char> abo: ‘Mek se afo ama: <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />akañ isua ita, me edikwọọk ndufo nduọọk ke iso mme asua ndufo ke afiọñ ita, ndin akañkañ ammọ ikanna ndufo ekʌk, me eduad <char style="nd">Abọọñ</char>, ye mme usen idiọọk udọñọ ke abio, ye enyere <char style="nd">Abọọñ</char> adisobo afịd itʌñ ye inuuk ke Isrel ke usen ita.’ Ndin idahami, biere naña ami mbo ñkedọkkọ awo a-akendọññọ miin.”<verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />Defid amaabo Kad, “Ami mba ke ataa ekamba mfʌhọ. Yak ami nduọ ndʌk ubọk <char style="nd">Abọọñ</char>, sia mbọm amọ anekke akpon; ado kuuyak ami nduọ ndʌk ubọk awo.”<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />Ndin <char style="nd">Abọọñ</char> amaadọñ udọñọ nsobo asịn ke Isrel, ndin ideen Isrel tọsịn ata mme duob (70,000) emaeduọññọ ekpañña. <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />Ndin Abasi amaadọñ enyere akesobo Yeruselem. Ado naña enyere akenamma ntoro, <char style="nd">Abọọñ</char> amaakịt anyʌñ asịññe idem akpọñ nsobo ami anyʌñ abo enyere a-akesoboke mme awo, “Akem! Sio ubọk mfo.” Enyere <char style="nd">Abọọñ</char> mmọdo akeda ke iso afe ubeek abakpa Arauna<note caller="+" style="f"><char style="fr" closed="false">21:15 </char><char style="ft" closed="false">Ke Hibru Ọọnan asʌk ado Arauna; se ñko ke ufañ 1 Kr 21:18-28</char></note> awo Yebus.<verse eid="1CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16" />Defid amaadịppe anyen anyʌñ akịt enyere <char style="nd">Abọọñ</char> naña ada ke ufọọd hefịn ye ederimbod, ye akañkañ ke ubọk amọ ase afịd Yeruselem. Ndin Defid ye mme ñkpisọñ, emaesịne ntaha afọñ, enyʌñ eduọñọ efʌk iso ke isọñ.<verse eid="1CH 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17" />Defid amaabo Abasi, “Nte idooho ami ñkenọọ uyio mbo ebat mme anwana ekọñ? Ami, akpemeedọñ, mmenam idiọọkñkpọ ñnyʌñ ndue. Mbon ami edoñño mme edọñ. Nsoo ke ammọ enam? <char style="nd">Abọọñ</char> Abasi mmi, yak ubọk mfo andoro miin ye ufọk mmi ikpọọñ ke idem, ado kuuyak udọñọ ami asʌhọ ye ikọd mfo.”<verse eid="1CH 21:17" /></para>
  <para style="s1">Defid Abọp Akpokoro Uwa</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />Ndin enyere <char style="nd">Abọọñ</char> amaanọ Kad uyio ewʌhọ ate adọkkọ Defid yak anye adakka adọọk akebọp akpokoro uwa anọ <char style="nd">Abọọñ</char> ke ñkañ ntondʌk afe ubeek abakpa Arauna awo Yebus. <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />Ndin Defid amaadọọk akaa ke ñkobitem naña Kad aketañ anọ anye ke anyịñ <char style="nd">Abọọñ</char>.<verse eid="1CH 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20" />Ke ini Arauna asʌkkọ asaat mfịd, anye amaakanna anyen anyʌñ akịt enyere; nditọ ideen amọ inaañ e-ekebaaha mme anye emaekedịp idem ammọ. <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />Akem Defid amaasaña akpere, ndin ke ini Arauna akedịppeke iso anyʌñ akịt anye, Arauna amaakpọñ afe ubeek abakpa anyʌñ afʌk isọ ke isọñ atuak iwuod amọ anọ Defid.<verse eid="1CH 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22" />Defid amaabo Arauna ate, “Nnọ miin afe ubeek abakpa mfo yak ami ndat mbọp akpokoro uwa nnọ <char style="nd">Abọọñ</char>, mbaak udọñọ nsobo ami atre. Nyam anye nnọ miin ke ayọhọ ekọmudua amọ.”<verse eid="1CH 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23" />Arauna amaabo Defid ate, “Dat! Yak abọọñ mmi adidem anam se adodo anemme anye esịd. Se, ami ñyaanọ ayaaraenañ ke ñkpọ uwa, mme akpeti ubeek abakpa nte ifia, ye abakpa nte enọ ñkpasi. Ami ñyaanọ afịd mme ñkpọ ami.”<verse eid="1CH 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24" />Ado adidem Defid amaabọọrọ Arauna ate, “Iyoo, ami mmeyịre ntañ ke ana ñkpe afịd ekọmudua. Ami ndiibenne nnọ <char style="nd">Abọọñ</char> se ido ake mfo, me adiwa ufọfọb uwa ake imiñkpaaha miin ñkpọ ndomokeed.”<verse eid="1CH 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25" />Ndin Defid amaakpe Arauna sekel kold ikie itiokeed (600)<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="ft" closed="false">A-adooho ñkpọ nte kilokram 6.9</char></note> ke itie isọñ ado. <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />Defid amaabọp akpokoro uwa ke ndo anọ <char style="nd">Abọọñ</char> anyʌñ awa mme ufọfọb uwa ye uwa adiwuanakeed. Anye amaakoot <char style="nd">Abọọñ</char>, ndin <char style="nd">Abọọñ</char> amaayie anye ke ikañ aketooho anyọñ adiduọ ke akpokoro uwa ufọfọb uwa.<verse eid="1CH 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27" />Akem <char style="nd">Abọọñ</char> amaatañ ikọ ye enyere, ndin anye amaasịn afịd amọ ke efọk. <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />Ke idaha ado, ke Defid amaakekịt ke <char style="nd">Abọọñ</char> amaabọọrọ anye ke afe ubeek abakpa Arauna awo Yebus, anye amaanam mme uwa ke ndo. <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />Itie tabanakịd <char style="nd">Abọọñ</char>, ake Moses akebọppọ ke anaan, ye itie ufọb uwa ekebañña idaha ado ke anyọñ-anyọñ ukan Kibiọn. <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />Ado Defid ikikanna ika ke iso amọ adikibịp nto Abasi, sia anye amaakop ndịk abaña eduad enyere <char style="nd">Abọọñ</char>.<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />Akem Defid amaabo, “Ufọk <char style="nd">Abọọñ</char> Abasi abiida ke mmi, ñko akpokoro ake ufọfọb uwa nditọ Isrel adiinyʌñ iba mi.”<verse eid="1CH 22:1" /></para>
  <para style="s1">Mbeeñeidem Adibọp Tembịd</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />Ndin Defid amaanọ uyio ate yak ekoot afịd mme isenawo se idʌñọ ke Isrel, ndin ke atu ammọ anye amaamek mme akpịkke itiad ediidiọñ itiad se ediidat ibọp ufọk Abasi. <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />Defid amaanịm ata uwak ukwak adidat nnam akpohoukwak udọk inuausʌñ ye mme ñkpaha, ye uwak brọns adoppoke akan se edomo. <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />Anye amaanyʌñ anọ uwak eto sida ake awo imiikanna ibad, sia mbon Sidọn ye Tai emaeben ata uwak eto ami esọk Defid.<verse eid="1CH 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5" />Defid amaabo ate, “Ayịn mmi Sọlọmọn ado nsek ye akọi, ado ufọk e-eyemme adibọp nnọọ <char style="nd">Abọọñ</char> ana akpon, ayaiya eti-eti, awuọ etob, anie uku anyʌñ ayaiya ke anyen afịd mme idịd ke ederimbod. Ke ntoro, ami ñyaanam mbeeñeidem nnọ anye.” Ndin Defid amaanam ata ekamba mbeeñeidem mbemiso ñkpa amọ.<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />Ndin anye amaakoot ayịn amọ Sọlọmọn anyʌñ anọ anye uyio ate abọp ufọk anọ <char style="nd">Abọọñ</char>, Abasi Isrel. <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />Defid amaabo Sọlọmọn ate: “Ayịn mmi, ami mmaanie ke esịd mmi adibọp ufọk nnọọ ke Anyịñ <char style="nd">Abọọñ</char> Abasi mmi. <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />Ado uyio <char style="nd">Abọọñ</char> adiñwuọ miin idem ate, ‘Afo ameduọk uwak iyiib anyʌñ anwana uwak ekọñ. Inaaha afo abọp ufọk ke Anyịñ mmi, sia afo ameduọk uwak iyiib ke isọñ ke iso mmi. <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />Ado afo ayaanie ayịn adiido awo emem ye nsuukidem, ndin ami ñyaanọ anye nduọkadudu ke atu uwak mme asua amọ ke afịd ndaha. Anyịñ amọ adiido Sọlọmọn<note caller="+" style="f"><char style="fr" closed="false">22:9 </char><char style="ft" closed="false">Sọlọmọn atie nte ikọ Hibru awuọñọke </char><char style="fq" closed="false">emem.</char></note>, ndin ami ñyaanam Isrel anie emem anyʌñ aba ke ifuuro ke idaha ukara amọ. <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />Anye ado awo adiibọp ufọk inọ Anyịñ mmi. Anye ayaado ayịn mmi, ndin ami ñko ñyaado ete amọ. Ndin ami ñyaanam ebekpo abioubọọñ amọ ada ke afịd Isrel ke nsi-nsi.’<verse eid="1CH 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11" />“Idahami, ayịn mmi, yak <char style="nd">Abọọñ</char> aba ye afo, ñko afo ayaakịt unen anyʌñ abọp ufọk <char style="nd">Abọọñ</char>, Abasi mfo, naña anye aketañ ke ayaanam. <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />Yak <char style="nd">Abọọñ</char> unọ fiin ndiọọñọidem ye ifiọk unam ñkpọ ke anye amaunịm fiin nte adaiwuod ke Isrel, nọ afo anịm mbed <char style="nd">Abọọñ</char> Abasi mfo. <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />Ndin afo ayaakịt unen adieke afo atịmme akpeme mme ewʌhọ ye mme mbed <char style="nd">Abọọñ</char> akenọọhọ Isrel ato Moses. Sọñ idem nyʌñ sọñ esịd. Kuukop ndịk kuunyʌñ ukop mmemidem.<verse eid="1CH 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14" />“Ami mmenekke ntịñ anyen ke adibono ñkpọ se edat ebọp tembịd <char style="nd">Abọọñ</char> talen kold tọsịn ikie (100,000)<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">A-adooho ñkpọ nte tọọn 3,750 me metrịk tọọn 3,400</char></note>, talen silfa miliọn keed (1,000,000)<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">A-adooho ñkpọ nte tọọn 37,500 me metrịk tọọn 34,000</char></note>, ataa uwak brọns ye ukwak adoppoke eti-eti akan se edomo, ye eto ye itiad. Afo amenyʌñ akeme adidian ke mme ñkpọ ami. <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />Afo amenie uwak mbon utom: mme akpịkke itiad, mme akọọkufọk ye mme akọñeto, ukem ye nsio-nsio mbon e-enieghe ifiọk afịd utomusọ <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />ke kold ye silfa, brọns ye ukwak mbon ubọkutom i-imiinieghe ibad. Idahami tọọñọ utom, ndin yak <char style="nd">Abọọñ</char> aba ye afo.”<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />Akem Defid amaanọ afịd mme adaaha ke Isrel uyio ate edinwam ayịn amọ Sọlọmọn. <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />Anye amaabo ammọ ate, “Nte idooho <char style="nd">Abọọñ</char> Abasi ndufo aba ye ndufo? Nte anye inọọhọ ndufo nduọkadudu ke afịd idaha? Sia anye amaayaak mbon ekedʌññọ ke isọñ ami asịn ke ubọk mmi, ndin ñko isọñ ami anyʌñ asịne <char style="nd">Abọọñ</char> ye ikọd amọ ke ubọk. <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />Idahami inịm esịd ye ukpọñ ndufo ke adiyem <char style="nd">Abọọñ</char> Abasi ndufo. Itọọñọ adibọp tembịd <char style="nd">Abọọñ</char> Abasi, nọ ndufo eben akebe edioomo <char style="nd">Abọọñ</char> Abasi ye mme ndisana ñkpọ e-enieghe Abasi edi ke tembịd ediibọp inọ Anyịñ <char style="nd">Abọọñ</char>.”<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s1">Mme Lifai</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />Ke Defid amaakesọñ anyʌñ ayọhọ ye isua, anye amaanam ayịn amọ Sọlọmọn adidem ke afịd Isrel.<verse eid="1CH 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2" />Anye amaanyʌñ akoot mme adaaha ke afịd Isrel abon itie keed, ukem ado ñko ye mme aku ye mme Lifai. <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />Mme Lifai e-ekeyọhọke isua edịb mme duob me akanna ado ke ekebat, ndin afịd ibad ideen ammọ akedo awo tọsịn edịb mme duob mme itiaita (38,000). <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />Defid amaabo ate, “Ke atu ami, tọsịn edịb mme inaañ (24,000) ana nte ese ñkpọ ebaña utom ke tembịd <char style="nd">Abọọñ</char> ñko tọsịn itiokeed (6,000) ana eba nte mme adaaha ye mme abiideikpe. <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />Tọsịn inaañ (4,000) ana nte edo mme akpeme inuaatob, ndin tọsịn inaañ (4,000) ana nte etooro <char style="nd">Abọọñ</char> ye mme ñkukwak ami ñkenọọhọ ke ntak ami.”<verse eid="1CH 23:5" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="6" style="v" sid="1CH 23:6" />Defid amaabakka mbon Lifai adọñ ke nsio-nsio ikpeghe akemme ye nditọ Lifai: Kesọn, Kohad ye Merari.<verse eid="1CH 23:6" /></para>
  <para style="s1">Mbon Kesọn</para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 23:7" />Se ikinie mbon Kesọn:</para>
  <para style="li2" vid="1CH 23:7">Ladan ye Simei.<verse eid="1CH 23:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8" />Nditọ ideen Ladan:</para>
  <para style="li2" vid="1CH 23:8">Yehiel akpan, Setam ye Yuel, ekedo ita ke afịd.<verse eid="1CH 23:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9" />Nditọ Simei:</para>
  <para style="li2" vid="1CH 23:9">Selọmọd, Hasiel ye Haran ekedoñño ita ke afịd.</para>
  <para style="li2" vid="1CH 23:9">(Mbon se ikidoñño mme adaiwuod ufọk Ladan ekedom.)<verse eid="1CH 23:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10" />Ndin nditọ ideen Simei:</para>
  <para style="li2" vid="1CH 23:10">Yahad, Sisa, Yeus ye Beria.</para>
  <para style="li2" vid="1CH 23:10">Mme nditọ ideen Simei ekedom, inaañ ke afịd.<verse eid="1CH 23:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 23:11" />(Yahad akedo akpa ndin Sisaa ado udiana, ado Yeus ye Beria ikinieghe uwak nditọ ideen; ke ntoro ekebat ammọ nte ubon keed ye ubiọñutom keed.)<verse eid="1CH 23:11" /></para>
  <para style="s1">Mbon Kohad</para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 23:12" />Nditọ ideen Kohad:</para>
  <para style="li2" vid="1CH 23:12">Amram, Isaa, Hibrọn ye Usiel, ekedoñño inaañ ke afịd.<verse eid="1CH 23:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13" />Nditọ ideen Amram:</para>
  <para style="li2" vid="1CH 23:13">Erọn ye Moses.</para>
  <para style="li2" vid="1CH 23:13">Emaesio Erọn enịm, anye ye ntịppe emana amọ ke nsi-nsi, adinam mme nsana ñkan ñkpọ esana, adifọp mme uwa ke iso <char style="nd">Abọọñ</char>, adinam ñkpọ ke iso amọ adinyʌñ nnọọ adidiọñ ke anyịñ amọ ke nsi-nsi. <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />Ekebat nditọ Moses awo Abasi nte ubaak esiin ake Lifai.<verse eid="1CH 23:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15" />Nditọ ideen Moses:</para>
  <para style="li2" vid="1CH 23:15">Kesọm ye Eliesa.<verse eid="1CH 23:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16" />Ntịppe ubon Kesọm:</para>
  <para style="li2" vid="1CH 23:16">Subeel akedo akpa.<verse eid="1CH 23:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17" />Ntịppe Eliesa:</para>
  <para style="li2" vid="1CH 23:17">Rehabia akedo akpan.</para>
  <para style="li2" vid="1CH 23:17">(Eliesa ikinieghe nditọ ideen mfen, ado nditọ ideen Rehabia emaewak eti-eti.)<verse eid="1CH 23:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18" />Nditọ ideen Isaa:</para>
  <para style="li2" vid="1CH 23:18">Selọmid akedo akpan.<verse eid="1CH 23:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19" />Nditọ ideen Hibrọn:</para>
  <para style="li2" vid="1CH 23:19">Yeria akpa, Amaria ayọhọ iba,</para>
  <para style="li2" vid="1CH 23:19">Yahasiel ayọhọ ita ndin Yekameem ayọhọ inaañ.<verse eid="1CH 23:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20" />Nditọ Usiel:</para>
  <para style="li2" vid="1CH 23:20">Maika akpan ye Isia udọ.<verse eid="1CH 23:20" /></para>
  <para style="s1">Mbon Merari</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 23:21" />Nditọ ideen Merari:</para>
  <para style="li2" vid="1CH 23:21">Mahli ye Musi.</para>
  <para style="li1" vid="1CH 23:21">Nditọ ideen Mahli:</para>
  <para style="li2" vid="1CH 23:21">Eliasa ye Kisi.<verse eid="1CH 23:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22" />(Eliasa amaakpa inieghe nditọ ideen ndomokeed: anye akenie nditọ ibaan ikpọọñ. Mme ayakka ammọ, nditọ ideen Kisi, emaedọi ammọ.)<verse eid="1CH 23:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23" />Nditọ ideen Musi:</para>
  <para style="li2" vid="1CH 23:23">Mahli, Eda ye Yerimọd, ita ke afịd.<verse eid="1CH 23:23" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="24" style="v" sid="1CH 23:24" />Mbon ntịppe ubon Lifai ke ufọk ammọ ekedoñño ami, mme mbọọñ ufọk naña ekesịn anyịñ ammọ enyʌñ ebat ammọ awo ke awo, a-adooho, mme anam utom emaekeyọhọ isua edịb me akanna ado ekesinamma ñkpọ ke tembịd <char style="nd">Abọọñ</char>. <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />Sia Defid amaabo ate, “Sia <char style="nd">Abọọñ</char>, Abasi Isrel, amaanọ mbon amọ nduọkadudu anye amaanyʌñ adidʌñ ke Yeruselem ke nsi-nsi, <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />mbon Lifai ikinieghe adibiom tabanakịd me mme ñkpoduoho esidatta enam utom amọ aba.” <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />Ke abaña akpatre ikọitem Defid, ekebat mbon Lifai se ikiyọhọ isua edịb ke emana me akanna ado.<verse eid="1CH 23:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28" />Utom mme Lifai akedo adinwam nditọ Erọn ke adinam ñkpọ ke tembịd <char style="nd">Abọọñ</char>: adise ñkpọ mbaña esịd akwere, mme esịd ubeed, adinam mme ndisana ñkpọ ukpono Abasi esana ye adinam mme utom mfen ke ufọk Abasi. <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />Ammọ ekese ñkpọ ebaña uyo esioho enịm ke akpokoro, asaña-asaña ndomuyo uwa, uyo se yiis imiisịneke, aditem ye adinuakka, ye afịd udomo ñkpọ ye ubom. <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />Ammọ ñko ekena nte esida afịd ubakusen ekọọm enyʌñ etooro <char style="nd">Abọọñ</char>. Akena nte ammọ enam ukem ami ke ndubiayio <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />ndin ini keed akeedodo e-efọppọ uwa enọ <char style="nd">Abọọñ</char> ke mme usen Sabad, ke mme usọrọ Ufa Afiọñ ye ke mme ndimek usọrọ. Ammọ ekenie adinam ñkpọ nnọ <char style="nd">Abọọñ</char> afịd-afịd ini ke ukem-ukem ibad ye ke usʌñ eketañña enọ ammọ.<verse eid="1CH 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32" />Ndin mme Lifai emaenam mme ubiọñutom ammọ ke atayad mbono, ke Adisana Itie ndin, ke idak nditọete ammọ e-edooho ntịppe ubon Erọn, ke utom itie tembịd <char style="nd">Abọọñ</char>.<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s1">Ikpeghe Mme Aku</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />Mme ikpeghe ntịppe ubon Erọn ekedoñño ami:</para>
  <para style="p" vid="1CH 24:1">Nditọ ideen Erọn ekedoñño Nadab, Abihu, Eliasa ye Itama. <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />Ado Nadab ye Abihu emaekpañña mbemiso ete ammọ akpa, ndin ammọ ikinieghe nditọ ideen; ntom Eliasa ye Itama ekenam utom nte mme aku. <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />Ke unwam Sadọk awo ntịppe ubon Eliasa ye Ahimelek awo ntịppe ubon Itama, Defid amaabakka ammọ adọñ ke ikpeghe ke ndaha unam utom ammọ. <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />Emaekịt ata uwak ibad ñkpoon awo ke atu ntịppe ubon mme Eliasa akan ake ubon mme Itama, ndin emaebakka ammọ naña akekem: ebakka iwuod ufọk duob mme itiokeed eto ubon Eliasa, enyʌñ ebakka iwuod ufọk itiaita eto ntịppe ubon mme Itama. <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />Ammọ emaebaaña awo adusad ibaaha ke adikisịn afia, sia mme adaaha ufọkabasi ye mme adaaha ke Abasi mmọdo ekebañña ke atu ubon Eliasa ye ake Itama ñko.<verse eid="1CH 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6" />Awedñwed Semaiya ayịn Netanel, awo Lifai, amaawet mme anyịñ ammọ ke iso adidem ye mme adaaha: aku Sadọk, Ahimelek ayịn Abiata ye mme iwuod ke ubon mme aku ye ake mme Lifai, edat ubon keed eto Eliasa ndin enyʌñ edat keed eto ubon Itama.<verse eid="1CH 24:6" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7" />Akpa afia ekesịnne akeduọ anọ Yehoarib,</para>
  <para style="li1" vid="1CH 24:7">ayọhọ iba aduọ anọ Yedaiya,<verse eid="1CH 24:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8" />ayọhọ ita aduọ anọ Harim,</para>
  <para style="li1" vid="1CH 24:8">ayọhọ inaañ aduọ anọ Seorim,<verse eid="1CH 24:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9" />ayọhọ ition aduọ anọ Malkiya,</para>
  <para style="li1" vid="1CH 24:9">ayọhọ itiokeed aduọ anọ Miyamịn,<verse eid="1CH 24:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10" />ayọhọ itiaba aduọ anọ Hakos,</para>
  <para style="li1" vid="1CH 24:10">ayọhọ itiaita aduọ anọ Abiya,<verse eid="1CH 24:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11" />ayọhọ usʌkkeed aduọ anọ Yesua,</para>
  <para style="li1" vid="1CH 24:11">ayọhọ duob aduọ anọ Sekanaiya,<verse eid="1CH 24:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12" />duob mme keed akeduọ anọ Eliasịb,</para>
  <para style="li1" vid="1CH 24:12">ayọhọ duob mme iba aduọ anọ Yakịm,<verse eid="1CH 24:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13" />ayọhọ duob mme ita aduọ anọ Hupa,</para>
  <para style="li1" vid="1CH 24:13">duob mme inaañ aduọ anọ Yesibeeb,<verse eid="1CH 24:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14" />ayọhọ duob mme ition akeduọ anọ Bilka,</para>
  <para style="li1" vid="1CH 24:14">ayọhọ duob mme itiokeed aduọ anọ Imaa,<verse eid="1CH 24:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15" />duob mme itiaba aduọ anọ Hesie,</para>
  <para style="li1" vid="1CH 24:15">duob mme itiaita aduọ anọ Hapises,<verse eid="1CH 24:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16" />ayọhọ duob mme usʌkkeed aduọ anọ Petahia,</para>
  <para style="li1" vid="1CH 24:16">ayọhọ edịb aduọ anọ Yehesikeel,<verse eid="1CH 24:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17" />ayọhọ edịb mme keed aduọ anọ Yakịn,</para>
  <para style="li1" vid="1CH 24:17">edịb mme iba aduọ anọ Kamul,<verse eid="1CH 24:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18" />edịb mme ita aduọ anọ Delaiya,</para>
  <para style="li1" vid="1CH 24:18">ndin edịb mme inaañ aduọ anọ Maasia.<verse eid="1CH 24:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19" />Naña ubono ñkpọ itie unam utom nnọọ Abasi ammọ akeba adom ke ammọ emaedʌk tembịd <char style="nd">Abọọñ</char>, akeene mme ewʌhọ eteete ammọ Erọn akenịmme anọ ammọ, naña nte <char style="nd">Abọọñ</char>, Abasi Isrel aketemme anye.<verse eid="1CH 24:19" /></para>
  <para style="s1">Nsʌhọ mme Lifai</para>
  <para style="li4">
    <verse number="20" style="v" sid="1CH 24:20" />Amaado nsʌhọ ntịppe ubon mme Lifai:</para>
  <para style="b" vid="1CH 24:20" />
  <para style="li1" vid="1CH 24:20">Atọọñọ ke nditọ ideen Amram: Subeel;</para>
  <para style="li2" vid="1CH 24:20">atọọñọ ke nditọ ideen Subeel: Yedeiya.<verse eid="1CH 24:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 24:21" />Amaado Rehabia, atọọñọ ke nditọ amọ, Isia akedo akpan.<verse eid="1CH 24:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22" />Tọọñọ ke mbon Isaa: Selomod;</para>
  <para style="li2" vid="1CH 24:22">tọọñọ ke ayịn Selomod: Yahad.<verse eid="1CH 24:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23" />Nditọ ideen Hibrọn:</para>
  <para style="li2" vid="1CH 24:23">Yeria akedo akpa, Amaria ado ayọhọ iba, Yahasiel ado ayọhọ ita ndin Yekameem ado ayọhọ inaañ.<verse eid="1CH 24:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24" />Nditọ ideen Usiel: Maika;</para>
  <para style="li2" vid="1CH 24:24">Nditọ ideen Maika: Samia.<verse eid="1CH 24:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 24:25" />Ayịneka awodeen Maika: Isia;</para>
  <para style="li2" vid="1CH 24:25">atọọñọ ke nditọ ideen Isia: Sakaraiya.<verse eid="1CH 24:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26" />Nditọ ideen Merari: Mahli ye Musi.</para>
  <para style="li2" vid="1CH 24:26">Ayịn awodeen Yaasia: Beno.<verse eid="1CH 24:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27" />Nditọ ideen Merari:</para>
  <para style="li2" vid="1CH 24:27">tọọñọ ke Yaasia: Beno, Soham, Saku ye Ibri.<verse eid="1CH 24:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28" />Tọọñọ ke Mahli: Eliasa, a-mmiikinieghe ayịn.<verse eid="1CH 24:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29" />Tọọñọ ke Kisi: ayịn Kisi: Yerameel.<verse eid="1CH 24:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30" />Ndin ye nditọ ideen Musi: Mahli, Eda ye Yerimọd.</para>
  <para style="b" vid="1CH 24:30" />
  <para style="li4" vid="1CH 24:30">Mbon ami ekedoñño mbon Lifai, akeene ubon ammọ.<verse eid="1CH 24:30" /></para>
  <para style="b" />
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31" />Ammọ ñko emaenyʌñ esịn afia, ukem naña mbon ubon ammọ ekedooho ntịppe ubon Erọn ekenam, ke iso Adidem Defid ye iso Sadọk, Ahimelek, ye mme adaiwuod ufọk mme aku ye mbon Lifai. Naña ekenam ye ekpək ubon mbon se ikpoon ikan, kpasʌk ukem ado ke ekenam ye ubon mbon se isịp ikan.<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s1">Mbon Ikwọ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />Defid, adiana ye mme adaiso ekọñ, emaesio ubaak nditọ ideen Asaf enịm, Heman ye Yedutun adinam utom aditañ uduak Abasi, adiana ye adibre mme ekpa, mme ndidoudʌk ye mme simbal. Ami ado ñwed ibad ideen e-ekenamma utom ami:<verse eid="1CH 25:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2" />Tọọñọ ke nditọ ideen Asaf:</para>
  <para style="li2" vid="1CH 25:2">Saku, Yosef, Netania ye Asarela. Nditọ ideen Asaf ekebañña ke idak ndadusʌñ Asaf, a-aketañña prọfesi a-adooho uduak Abasi ke idak ndadusʌñ adidem.<verse eid="1CH 25:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3" />Ke abaña Yedutun, tọọñọ ke nditọ ideen amọ:</para>
  <para style="li2" vid="1CH 25:3">Kedalia, Seri, Yesaiya, Simei, Hasabaiya ye Matitia, naña afịd itiokeed, ke idak ndadusʌñ ete ammọ Yedutun, a-aketañña prọfesi, akama ekpa akọọm anyʌñ atooro <char style="nd">Abọọñ</char>.<verse eid="1CH 25:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4" />Amaado Heman, tọọñọ ke nditọ ideen amọ:</para>
  <para style="li2" vid="1CH 25:4">Bukia, Matania, Usiel, Subeel ye Yerimọd; Hananaiya, Hanani, Eliata, Kidalti ye Romamti-Esa; Yosbekasa, Maloti, Hotia ye Mahasiọd.<verse eid="1CH 25:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 25:5" />(Afịd ami ekedoñño nditọ ideen Heman awo ñkukịd adidem. Ekenọ anye ammọ ato ke mme enwọñọ Abasi akenwọñọke adidịppe adudu amọ ke ndaaha. Abasi amaanọ Heman nditọ ideen duob mme inaañ ye nditọ ibaan ita.)<verse eid="1CH 25:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6" />Afịd ideen ami ekebañña ke idak ndadusʌñ ete ammọ ke adikwọ ikwọ ke tembịd <char style="nd">Abọọñ</char>, ye mme simbal, mme ndidoudʌk ye mme ekpa, ke adinam ñkpọ ke ufọk Abasi.</para>
  <para style="p" vid="1CH 25:6">Asaf, Yedutun ye Heman ekebañña ke idak ndadusʌñ adidem.<verse eid="1CH 25:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 25:7" />Adiana ye mme nditọete ammọ, afịd ammọ emaebọ ukpeeb, ediọọñọ enyʌñ enie enọ ke ukwọ ikwọ nnọọ <char style="nd">Abọọñ</char>, ammọ ekedo 288 (ikie iba mme anaañ mme itiaita). <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />Ntəkayịn ye ikpọawo ukem-ukem, mme andikpeeb ye mbon se ekpeep, emaesịn afia adinam mme ubiọñutom ammọ.<verse eid="1CH 25:8" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="9" style="v" sid="1CH 25:9" />Akpa afia, a-akenieghe Asaf, akeduọ anọ Yosef,</para>
  <para style="li1" vid="1CH 25:9">nditọ ideen amọ ye nditọete amọ</para>
  <para style="li1" vid="1CH 25:9">udiana akeduọ anọ Kedalia,</para>
  <para style="li1" vid="1CH 25:9">anye ye nditọete amọ ye nditọ ideen amọ<verse eid="1CH 25:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 25:10" />ayọhọ ita aduọ anọ Saku,</para>
  <para style="li1" vid="1CH 25:10">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 25:11" />ayọhọ inaañ aduọ anọ Isri<note caller="+" style="f"><char style="fr" closed="false">25:11 </char><char style="ft" closed="false">Isri asʌk ado Seri</char></note>,</para>
  <para style="li1" vid="1CH 25:11">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 25:12" />ayọhọ ition aduọ anọ Netania,</para>
  <para style="li1" vid="1CH 25:12">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 25:13" />ayọhọ itiokeed aduọ anọ Bukia,</para>
  <para style="li1" vid="1CH 25:13">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 25:14" />ayọhọ itiaba aduọ anọ Yesarela<note caller="+" style="f"><char style="fr" closed="false">25:14 </char><char style="ft" closed="false">Yesarela asʌk ado Asarela</char></note>,</para>
  <para style="li1" vid="1CH 25:14">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 25:15" />ayọhọ itiaita aduọ anọ Yesaiya,</para>
  <para style="li1" vid="1CH 25:15">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 25:16" />ayọhọ usʌkkeed aduọ anọ Matania,</para>
  <para style="li1" vid="1CH 25:16">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 25:17" />ayọhọ duob aduọ anọ Simei,</para>
  <para style="li1" vid="1CH 25:17">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 25:18" />ayọhọ duob mme keed akenie Asarel<note caller="+" style="f"><char style="fr" closed="false">25:18 </char><char style="ft" closed="false">Asarel asʌk ado Usiel</char></note>,</para>
  <para style="li1" vid="1CH 25:18">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 25:19" />ayọhọ duob mme iba akenie Hasabaiya,</para>
  <para style="li1" vid="1CH 25:19">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 25:20" />ayọhọ duob mme ita aduọ anọ Subeel,</para>
  <para style="li1" vid="1CH 25:20">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 25:21" />ayọhọ duob mme inaañ akenie Matitia,</para>
  <para style="li1" vid="1CH 25:21">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 25:22" />ayọhọ duob mme ition akeduọ anọ Yeremọd,</para>
  <para style="li1" vid="1CH 25:22">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 25:23" />ayọhọ duob mme itiokeed aduọ anọ Hananaiya,</para>
  <para style="li1" vid="1CH 25:23">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 25:24" />ayọhọ duob mme itiaba akenie Yosbekasa,</para>
  <para style="li1" vid="1CH 25:24">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 25:25" />ayọhọ duob mme itiaita akenie Hanani,</para>
  <para style="li1" vid="1CH 25:25">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 25:26" />ayọhọ duob mme usʌkkeed aduọ anọ Maloti,</para>
  <para style="li1" vid="1CH 25:26">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 25:27" />ayọhọ edịb aduọ anọ Eliata,</para>
  <para style="li1" vid="1CH 25:27">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 25:28" />ayọhọ edịb mme keed akenie Hotia,</para>
  <para style="li1" vid="1CH 25:28">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 25:29" />ayọhọ edịb mme iba akenie Kidalti,</para>
  <para style="li1" vid="1CH 25:29">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 25:30" />ayọhọ edịb mme ita akenie Mahasiọd,</para>
  <para style="li1" vid="1CH 25:30">nditọ ideen amọ ye nditọete amọ<verse eid="1CH 25:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 25:31" />ayọhọ edịb mme inaañ akeduọ anọ Romamti-Esa,</para>
  <para style="li1" vid="1CH 25:31">nditọ ideen amọ ye nditọete amọ.<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s1">Mme Akpeme Inuaatob</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 26:1" />Ikpeghe ekebakkake mme akpeme inuaatob:</para>
  <para style="b" vid="1CH 26:1" />
  <para style="li4" vid="1CH 26:1">Tọọñọ ke mbon Kora:</para>
  <para style="li1" vid="1CH 26:1">Meselemia ayịn Kore, keed ke atu nditọ ideen Asaf. <verse eid="1CH 26:1" /><verse number="2" style="v" sid="1CH 26:2" />Meselemia amaanie nditọ ideen:</para>
  <para style="li2" vid="1CH 26:2">Sakaraiya akedo akpa ayịn, Yediayel ado udiana,</para>
  <para style="li2" vid="1CH 26:2">Sebadaiya ado ayọhọ ita, Yatniel ado ayọhọ inaañ,<verse eid="1CH 26:2" /></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 26:3" />Elam ayọhọ ition, Yehohanan ayọhọ itiokeed</para>
  <para style="li2" vid="1CH 26:3">ndin Eliehoenai ado ayọhọ itiaba.<verse eid="1CH 26:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 26:4" />Obed-Edom ñko amaanie nditọ ideen:</para>
  <para style="li2" vid="1CH 26:4">Semaiya akedo akpa ayịn, Yehosabad ado udiana,</para>
  <para style="li2" vid="1CH 26:4">Yoa ado ayọhọ ita, Sakaa ado ayọhọ inaañ,</para>
  <para style="li2" vid="1CH 26:4">Netanel akedo ayọhọ ition, <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />Amiel ado ayọhọ itiokeed,</para>
  <para style="li2" vid="1CH 26:5">Isaka ayọhọ itiaba ndin Peuletai ado ayọhọ itiaita.</para>
  <para style="li2" vid="1CH 26:5">(Sia Abasi amaadiọñ Obed-Edom.)<verse eid="1CH 26:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 26:6" />Semaiya ayịn Obed-Edom amaanie nditọ ideen, e-ekedoññoke mme adaiwuod ke ubon ete ammọ sia ammọ ekedoñño ideen se inie ukeme. <verse eid="1CH 26:6" /><verse number="7" style="v" sid="1CH 26:7" />Nditọ ideen Semaiya:</para>
  <para style="li2" vid="1CH 26:7">Otni, Refeel, Obed ye Elsabad;</para>
  <para style="li2" vid="1CH 26:7">mme nditọete amọ Elihu ye Semakia ekedoñño ñko ideen se inie ukeme.<verse eid="1CH 26:7" /></para>
  <para style="li4">
    <verse number="8" style="v" sid="1CH 26:8" />Afịd ami ekedoñño ntịppe ubon Obed-Edom; ammọ ye nditọ ideen ammọ ye nditọete ammọ emaenie ukeme ye adudu adinam utom, ntịppe mbon ubon Obed-Edom ekedo awo ata mme iba ke afịd.<verse eid="1CH 26:8" /></para>
  <para style="li4">
    <verse number="9" style="v" sid="1CH 26:9" />Meselemia amaanie nditọ ideen ye nditọete, e-ekedooho mme akop idem ideen duob mme itiaita ke afịd.<verse eid="1CH 26:9" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="10" style="v" sid="1CH 26:10" />Hosaa awo Merari amaanie nditọ ideen:</para>
  <para style="li2" vid="1CH 26:10">Akpa Simri (akpesʌkado anye imiikidooho akpa ayịn, ete amọ amaamek anye nte akpa),<verse eid="1CH 26:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 26:11" />Hilkia udiana, Tabalia ayọhọ ita</para>
  <para style="li2" vid="1CH 26:11">ndin Sakaraiya ayọhọ inaañ.</para>
  <para style="li4" vid="1CH 26:11">Nditọ ideen ye nditọete Hosaa ekedo duob mme ita ke afịd.<verse eid="1CH 26:11" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="12" style="v" sid="1CH 26:12" />Mme ikpeghe mbon ukpeme inuaatob ami, a-atooho mme adadusʌñ ammọ, emaenie mme ubiọñutom adinam ke tembịd <char style="nd">Abọọñ</char>, ukem naña nditọete ammọ ekenie. <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />Ekesịn afia enọ afịd mme inuaatob keedekeed, akeene mme ubon ammọ, etʌk ye ikpọ ukem-ukem.<verse eid="1CH 26:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 26:14" />Afia ukpeme inuaatob ñkañ usakkautịn akeduọ anọ Selemia<note caller="+" style="f"><char style="fr" closed="false">26:14 </char><char style="ft" closed="false">Selemia asʌk ado Meselemia</char></note>.</para>
  <para style="li1" vid="1CH 26:14">Ndin emaesịn afia enọ ayịn amọ Sakaraiya, awo aniọñ, anọitem, ndin afia ake Inuaatob Adoro-adoro amaadʌk anọ anye.<verse eid="1CH 26:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 26:15" />Afia ñkañ Inuaatob Usuuk-usuuk amaadʌk anọ Obed-Edom, ndin afia ufọk ñkpoduoho amaadʌk anọ nditọ ideen amọ.<verse eid="1CH 26:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 26:16" />Afia mbeñ ñkañ Inuaatob Usobutịn ye Inuaatob Saleked ke anyọñ anyọñ efaak amaaduọ anọ Supịm ye Hosaa.</para>
  <para style="b" vid="1CH 26:16" />
  <para style="li4" vid="1CH 26:16">Mbon ukpeme emaenyʌñ eba ke itie ukpeme:<verse eid="1CH 26:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 26:17" />Mbon Lifai itiokeed ekeba ke ñkañ usakkautịn kwa usen,</para>
  <para style="li1" vid="1CH 26:17">inaañ eba ke ñkañ adoro-adoro kwa usen,</para>
  <para style="li1" vid="1CH 26:17">inaañ ñko eba ke ñkañ usuuk-usuuk kwa usen</para>
  <para style="li1" vid="1CH 26:17">ndin iba ke ini keed eba ke ufọk ubonoñkpọ.<verse eid="1CH 26:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 26:18" />Amaado esob ñkañ usobutịn, inaañ ekeba ke usʌñ ndin iba eba ke esịd esob.<verse eid="1CH 26:18" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="19" style="v" sid="1CH 26:19" />Mme ikpeghe e-ekebañake mme akpeme inuaatob e-ekedooho ntịppe ubon Kora ye Merari ekedo ami.<verse eid="1CH 26:19" /></para>
  <para style="s1">Mme Akamaakʌk ye mme Adaaha Mfen</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />Emọ-emọ mbon Lifai ammọ ye Ahiya ekedoñño mbon se ikise ñkpọ ibaña itie unịm akʌk ye mme inie ufọk Abasi ye itie ubono mme asaña-asaña ñkpọ emaekediọñ.<verse eid="1CH 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21" />Mme ntịppe ubon Ladan, e-ekedooho mbon Kesọn eto ke Ladan ñko e-ekedooho mme adaiwuod ufọk a-akenieghe Ladan awo Kesọn, ekedoñño Yehieli, <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" />nditọ ideen Yehieli, Setam ye ayịneka amọ Yuel. Ammọ ekese ñkpọ ebaña mme itie unịm akʌk ke tembịd <char style="nd">Abọọñ</char>.<verse eid="1CH 26:22" /></para>
  <para style="b" />
  <para style="li4">
    <verse number="23" style="v" sid="1CH 26:23" />Tọọñọ ke ubon Amram, mbon Isaa, mbon Hibrọn ye mbon Usiel:<verse eid="1CH 26:23" /></para>
  <para style="b" />
  <para style="li2">
    <verse number="24" style="v" sid="1CH 26:24" />Subeel, awo ntịppe ubon Kesọm ayịn Moses, akedo adaaha akeseeghe ñkpọ abaña mme itie unịm akʌk. <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" />Nditọete amọ e-eketooho Eliesa: Rehabia ayịn amọ, Yesaiya ayịn amọ, Yoram ayịn amọ, Sikri ayịn amọ ye Selomid ayịn amọ.<verse eid="1CH 26:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 26:26" />(Selomid ye nditọete amọ ekedoñño mbon se ise ñkpọ ibaña mme ubeed itie unịm mme ñkpọuto ake Adidem Defid amaakediọñ ye mme adaiwuod ufọk ekedooho mme adaiso ekọñ ke mme tọsịn (1,000) ye mme adaiso ekọñ ke mme ikie (100), ye mme adaiso ekọñ mfen. <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />Ubaak ñkpọ mbịme ekọñ ammọ emaeyaak enọ adiben ñkama ndiọñ itie tembịd <char style="nd">Abọọñ</char>. <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />Ndin afịd ñkpọ se Samwel abia ñkukịd akediọñ ye Sọọl ayịn Kisi, Abna ayịn Nee ye Yoab ayịn Seruya, ndin ye afịd mme asaña-asañañkpọ mfen e-ekenịmme akeba ke idak ukpeme Selomid ye nditọete amọ.)<verse eid="1CH 26:28" /></para>
  <para style="li2">
    <verse number="29" style="v" sid="1CH 26:29" />Tọọñọ ke mbon Isaa:</para>
  <para style="li2" vid="1CH 26:29">Emaenọ Kenania ye nditọ amọ ideen mme ubiọñutom a-mmiidooho ke itie tembịd, nte mme adaaha ye mme abiideikpe ke Isrel.<verse eid="1CH 26:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 26:30" />Tọọñọ ke Hibrọn:</para>
  <para style="li2" vid="1CH 26:30">Hasabaiya ye nditọete amọ mme akop idem ideen ikie itiaba (700) ekese ñkpọ ebaña Isrel ñkañ edem usobutịn Yọdan ke afịd mme utom <char style="nd">Abọọñ</char> ye utom adidem. <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />Amaado mbon Hibrọn, Yeria akedo abọọñ ammọ akeene se ekewet ke ñwed ntịppe emana ubon ammọ.</para>
  <para style="li2" vid="1CH 26:31">(Ke ayọhọ isua aba ake Defid akedaaha ukara emaeduuñọ mme ñwednnịm ikọ, ndin emaekịt mme akop idem ideen ke atu mbon Hibrọn ke Yasa ke Kilied. <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />Yeraiya akenie nditọete ikie edịb mme itiaba (2,700), ekedooho mme akop idem ideen ye mme adaiwuod ufọk, ndin Adidem Defid amaasịn ammọ adise ñkpọ mbaña mbon Rubịn, mbon Kad ye ubaak esiin Manase ke abaña afịd ñkpọ se ikibaña Abasi ye se ikibaña adidem.)<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s1">Ikpeghe Mbon Ekọñ</para>
  <para style="li4">
    <verse number="1" style="v" sid="1CH 27:1" />Anyem ado anyịñ mbon Isrel, mme adaiwuod ufọk, mme adaiso ekọñ ke tọsịn (1,000) ye mme etubom ekọñ ke ikie (100), ye mme ñkpisọñ ammọ, e-ekenamma ñkpọ enọ adidem ke se ibaña ñkpọ ake ñkañ mbon ekọñ ekebaaha ke ukpeme ke afiọñ ke afiọñ ke afịd isua. Ikpeghe ekọñ keedekeed akenie ideen tọsịn edịb mme inaañ (24,000).<verse eid="1CH 27:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="1CH 27:2" />Andikise ñkpọ mbaña akpa ikpeghe, ke akpa afiọñ, akedo Yasobiim ayịn Sabdiel. Ideen tọsịn edịb mme inaañ (24,000) ekeba ke ikpeghe amọ. <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />Anye akedo awo ntịppe ubon Peres ye etubom afịd mme adaiso ekọñ ke akpa afiọñ.<verse eid="1CH 27:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 27:4" />Andikise ñkpọ mbaña ikpeghe ke ayọhọ afiọñ iba akedo Dodai awo Ahoa; Miklọd akedo adadusʌñ ke ikpeghe ñkañ amọ. Ideen tọsịn edịb mme inaañ (24,000) ekeba ke ikpeghe amọ.<verse eid="1CH 27:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 27:5" />Adaiso ekọñ ayọhọ ita, ke ayọhọ afiọñ ita, akedo Benaiya ayịn aku Yehoiyada. Anye akedo abọọñ ndin ideen tọsịn edịb mme inaañ (24,000) ekeba ke ikpeghe amọ. <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />Awo ami akedo Benaiya a-akedooho ekamba awo ekọñ keed ke atu awo Edịb mme Duob ñko anye akekara Edịb mme Duob ami. Ayịn awodeen amọ Amisabad akese ñkpọ abaña ikpeghe amọ.<verse eid="1CH 27:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 27:7" />Ayọhọ inaañ, ake ayọhọ afiọñ inaañ, akedo Asahel ayịneka awodeen Yoab; ayịn amọ Sebadaiya akedo andikidat itie amọ. Ideen tọsịn edịb mme inaañ (24,000) ekeba ke ikpeghe amọ.<verse eid="1CH 27:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 27:8" />Ayọhọ ition, ke ayọhọ afiọñ ition, akedo adaiso ekọñ Samhud awo Isra. Ideen tọsịn edịb mme inaañ (24,000) ekeba ke ikpeghe amọ.<verse eid="1CH 27:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 27:9" />Ayọhọ itiokeed, ke ayọhọ afiọñ itiokeed, akedo Ira ayịn Ikes awo Tekoa. Ideen tọsịn edịb mme inaañ (24,000) ekeba ke ikpeghe amọ.<verse eid="1CH 27:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 27:10" />Ayọhọ itiaba, ke ayọhọ afiọñ itiaba, akedo Heles awo Pelọn, aketooho Ifrem. Ideen tọsịn edịb mme inaañ (24,000) ekeba ke ikpeghe amọ.<verse eid="1CH 27:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 27:11" />Ayọhọ itiaita, ke ayọhọ afiọñ itiaita, akedo Sibekai awo Husa, aketooho Seera. Ideen tọsịn edịb mme inaañ (24,000) ekeba ke ikpeghe amọ.<verse eid="1CH 27:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 27:12" />Ayọhọ usʌkkeed, ke ayọhọ afiọñ usʌkkeed, akedo Abiesa awo Anatod, aketooho ubon Benyamin. Ideen tọsịn edịb mme inaañ (24,000) ekeba ke ikpeghe amọ.<verse eid="1CH 27:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 27:13" />Ayọhọ duob, ke ayọhọ afiọñ duob, akedo Maharai awo Netofa, aketooho Seera. Ideen tọsịn edịb mme inaañ (24,000) ekeba ke ikpeghe amọ.<verse eid="1CH 27:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 27:14" />Ayọhọ duob mme keed, ke ayọhọ afiọñ duob mme keed, akedo Benaiya awo Piratọn, aketooho Ifrem. Ideen tọsịn edịb mme inaañ (24,000) ekeba ke ikpeghe amọ.<verse eid="1CH 27:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 27:15" />Ayọhọ duob mme iba, ke ayọhọ afiọñ duob mme iba, akedo Heldai awo Netofa, aketooho ubon Otniel. Ideen tọsịn edịb mme inaañ (24,000) ekeba ke ikpeghe amọ.<verse eid="1CH 27:15" /></para>
  <para style="s1">Mme Adadusʌñ ke Mme Ekpək</para>
  <para style="li4">
    <verse number="16" style="v" sid="1CH 27:16" />Mme adadusʌñ ke mme esiin Isrel:</para>
  <para style="b" vid="1CH 27:16" />
  <para style="li1" vid="1CH 27:16">ke ñkañ mme Rubịn: akedo Eliesa ayịn Sikri;</para>
  <para style="li1" vid="1CH 27:16">ke ñkañ mbon Simiọn: ado Sefatia ayịn Maaka;<verse eid="1CH 27:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 27:17" />ke ñkañ Lifai: ado Hasabaiya ayịn Kemuel;</para>
  <para style="li1" vid="1CH 27:17">ke ñkañ Erọn: ado Sadọk;<verse eid="1CH 27:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 27:18" />ke ñkañ Yuda: ado Elihu, ayịneka awodeen Defid;</para>
  <para style="li1" vid="1CH 27:18">ke ñkañ Isaka: ado Omri ayịn Maikel;<verse eid="1CH 27:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 27:19" />ke ñkañ Sebulọn: ado Ismaiya ayịn Obadaiya;</para>
  <para style="li1" vid="1CH 27:19">ke ñkañ Naftali: ado Yerimọd ayịn Asriel;<verse eid="1CH 27:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 27:20" />ke ñkañ mme Ifrem: Hosie ayịn Asasia;</para>
  <para style="li1" vid="1CH 27:20">ke mbakka iba esiin ñkañ Manase: ado Yuel ayịn Pedaiya;<verse eid="1CH 27:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 27:21" />ke mbakka iba esiin ñkañ Manase ke Kilied: ado Iddo ayịn Sakaraiya;</para>
  <para style="li1" vid="1CH 27:21">ke ñkañ Benyamin: ado Yaasiel ayịn Abna;<verse eid="1CH 27:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 27:22" />ke ñkañ Daan: ado Asarel ayịn Yeroham.</para>
  <para style="b" vid="1CH 27:22" />
  <para style="li4" vid="1CH 27:22">Mbon ami ekedoñño mme adadusʌñ ke mme esiin Isrel.<verse eid="1CH 27:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23" />Defid ikidatta ideen se ido isua edịb me asịppe akan ado, sia <char style="nd">Abọọñ</char> amaanwọñọ adinam Isrel ewak nte ntantaafiọñ ke ikpaanyọñ. <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />Yoab ayịn Seruya amaatọọñọ adibat ideen, ado ikikweeñeke. Iyadesịd Abasi amaabịne Isrel ato ke ntak ubadawo ami, ndin awo ikiwette ibad awo ami isịn ke ñwed Adidem Defid.<verse eid="1CH 27:24" /></para>
  <para style="s1">Mme Ase Ñkpọ Mbaña Utom Adidem</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 27:25" />Asmafed ayịn Adiel akese ñkpọ abaña ubeed unịm ñkpọ adidem.</para>
  <para style="li1" vid="1CH 27:25">Yọnatan ayịn Usaiya akedo andise ñkpọ mbaña ufọk ubonoñkpọ ke mme efaak, ye ke abio, mme idʌñ ye mme itie ukpeme.<verse eid="1CH 27:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 27:26" />Esri ayịn Kelub akese ñkpọ abaña mbon utom se ikinam utom ke inwañ.<verse eid="1CH 27:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 27:27" />Simei awo Ramad akese ñkpọ abaña inwañ mfịd fain.</para>
  <para style="li1" vid="1CH 27:27">Sabdi awo Sifam akese ñkpọ abaña idọk inwañ fain.<verse eid="1CH 27:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 27:28" />Baal-Hanan awo Kede akese ñkpọ abaña ọlif ye mme eto fik-sikamọ ke mben abod usobutịn.</para>
  <para style="li1" vid="1CH 27:28">Yoas akese ñkpọ abaña adinọ adan ọlif.<verse eid="1CH 27:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 27:29" />Sitrai awo Sarọn akese ñkpọ abaña mme udịmenañ e-etaaha mbid ke Sarọn.</para>
  <para style="li1" vid="1CH 27:29">Safad ayịn Adlai akese ñkpọ abaña mme udịmenañ ke usuuk-usuuk.<verse eid="1CH 27:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 27:30" />Obil awo Ismeel akese ñkpọ abaña mme kamel.</para>
  <para style="li1" vid="1CH 27:30">Yedeiya awo Meronọd akese ñkpọ abaña mme dọñki.<verse eid="1CH 27:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 27:31" />Yasis awo Haka akese ñkpọ abaña mme udịmedọñ.</para>
  <para style="li4" vid="1CH 27:31">Afịd ibon ami ekese ñkpọ ebaña inie Adidem Defid.<verse eid="1CH 27:31" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="32" style="v" sid="1CH 27:32" />Yọnatan, ayịneka awodeen ete Defid, akedo anọitem, adiọọñọ ñkpọ awodeen a-ayọhọke ye aniọñ anyʌñ ado awedñwed.</para>
  <para style="li1" vid="1CH 27:32">Yehiel ayịn Hakmon akese ñkpọ abaña nditọ adidem.<verse eid="1CH 27:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 27:33" />Ahitofel akesinọ adidem item.</para>
  <para style="li1" vid="1CH 27:33">Husai awo Akaid akedo awo adu adidem.<verse eid="1CH 27:33" /></para>
  <para style="li4">
    <verse number="34" style="v" sid="1CH 27:34" />(Ahitofel amaakpọñ itie ukara amọ anọ Yehoiyada ayịn Benaiya ye Abiata.)</para>
  <para style="li1" vid="1CH 27:34">Yoab akedo adaiso udịmekọñ adidem.<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s1">Uduak Defid ke abaña Tembịd</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />Defid amaakoot afịd mme adaaha ke Isrel ate esoobo ke Yeruselem: mme ikpọawo e-ekeseeghe ñkpọ ebaña mme esiin Isrel, mme adaiso ekọñ e-ekeseeghe ñkpọ ebaña ikpeghe mbon utom adidem, mme adaiso ekọñ ke mme tọsịn (1,000) ye mme adaiso ekọñ ke mme ikie (100), ye mme adaaha e-ekeseeghe ñkpọ ebaña afịd inie ye ufene e-ekenieghe adidem ye nditọ amọ ideen, adiana ye mme ikpọawo ufọk ubọọñ, mbon ekọñ ye afịd ideen uko mme anwana anwan.<verse eid="1CH 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2" />Adidem Defid amaadakka ada ke ukod amọ abo ate: “Ikpañ utọñ innọ miin, ikọd mmi Isrel. Ami mmaanie ke esịd mmi adibọp ufọk nte itie nduọkadudu nnọ akebe edioomo <char style="nd">Abọọñ</char>, nte udodukod Abasi ñnyịn, ndin ami mmaanam uduak adibọp anye. <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />Ado Abasi amambo miin ate, ‘Inaaha afo abọp ufọk anọ Anyịñ mmi, sia afo ado awo anwanaekọñ ñko amenyʌñ aduọk iyiib.’<verse eid="1CH 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4" />“Ado <char style="nd">Abọọñ</char>, Abasi Isrel, amammek miin asio ke afịd ufọk ñnyịn adido adidem nnọ Isrel ke nsi-nsi. Anye amaamek Yuda nte adaiwuod, ndin ato ke ubon Yuda anye amek ubon mmi, ndin ato ke atu nditọ ideen ete mmi anye amaanem esịd adimmek miin adidem nnọọ Isrel. <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />Ke afịd nditọ ideen mmi, <char style="nd">Abọọñ</char> annọ miin uwak, anye amaamek Sọlọmọn ayịn mmi aditie ke ifịm ubọọñ ebekpo <char style="nd">Abọọñ</char> nnọ Isrel. <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />Anye amambo miin ate: ‘Sọlọmọn ayịn mfo ado awo ansidiibọp ufọk mmi ye mme akwere mmi, sia ami mmemek anye adido ayịn mmi, ndin ami ñyaado ete amọ. <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />Ami ñyaawuuk ebekpo ubọọñ amọ ke nsi-nsi adieke anye adiituak ida ke adinam ewʌhọ mmi ye mme mbed mmi, nte naña enam ke ini ami.’<verse eid="1CH 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8" />“Ke ntoro idahami ami mmidʌt ndufo utọñ ke iso afịd Isrel ye ke esob <char style="nd">Abọọñ</char>, ndin ñko nọ Abasi ñnyịn akop: Ikpeme adinịm afịd mme ewʌhọ <char style="nd">Abọọñ</char> Abasi ndufo, nọ ndufo edat eti isọñ ami enie enyʌñ eyaak enọ mbon mfen nte ñkpọ adiaakpa ke nsi-nsi.<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />“Ndin afo, ayịn mmi Sọlọmọn, nịm Abasi ete mfo ke akpanikọ, nyʌñ nam ñkpọ nọ anye ye ukpono ke uyọhọesịd, sia <char style="nd">Abọọñ</char> aduuñọ afịd esịd anyʌñ adiọọñọ afịd akikere. Adieke afo ayemme anye, afo ayaakịt anye; ado adieke afo asịnne anye, anye ayausịn fiin ke nsi-nsi. <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />Diọọñọ ndin, ke <char style="nd">Abọọñ</char> amaumek fiin ate yak abọp itieukpono. Sọñ idem nyʌñ nam utom ado.”<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />Ndin Defid amaanọ ayịn amọ Sọlọmọn ñwed mbeeñeidem ubọp tembịd, ufọk amọ, ubeed udọñ ñkpọ amọ, ñkañ anyọñ-anyọñ, mme ñkañ esịd ubeed ye itie unam ñkpeubọk. <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />Anye amaanọ anye afịd ñkpọ mbeeñeidem se Sịbidịd akesịn ke esịd amọ ke abaña tembịd <char style="nd">Abọọñ</char> ye afịd mme ñkanñkʌk ubeed, ake itie unịm akʌk tembịd Abasi ye ake itie enịmme enọ ndisana ñkpọ tembịd. <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />Anye amaanọ item abaña mme ikpeghe mme aku ye mbon Lifai, ye afịd utom e-enamma ke tembịd <char style="nd">Abọọñ</char>, ukem ado ye afịd mme ñkpoduoho e-ekamake enam utom. <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />Anye amaanịm kold se inie udob anọ afịd ñkpọ kold nọ ekama enam mme nsio-nsio utom, ndin ye udob silfa anọ afịd ñkpọ silfa nọ edat enam nsio-nsio utom: <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />udob kold ke ñkpọ udod utuenikañ kold ye mme ikañ ammọ, ye udob udodikañ keedekeed ye mme utuenikañ amọ, ye udob silfa ke udodikañ silfa keedekeed ye mme ikañ amọ akeene se ido utom udodikañ keedekeed; <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />udob kold akpokoro adisana akpokoro uyo keedekeed; udob silfa ake mme akpokoro silfa; <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />udob eti kold e-enọọhọ mme ikpañ ukịmñkpọ, mme besịn usiime mmọọñ ye udodñkpọ; udob kold anọ usan kold keedekeed; udob silfa anọ usan silfa keedekeed; <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />ndin udob kold e-emaeketem anie akpokoro uwa insensi. Anye ñko amaanyʌñ anọ anye ndadusʌñ ke abaña sariọd, ado awuọñọ, serubim ake kold etaarake mba ammọ efʌk akebe edioomo <char style="nd">Abọọñ</char>.<verse eid="1CH 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19" />Defid aketañ abo, “Afịd ñkpọ ami mmewet nsịn ke ñwed akeene ubọk <char style="nd">Abọọñ</char> ke idem mmi, ndin anye anam ami ndiọọñọ afịd ntotəño uduak ami.”<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />Defid ñko amaadọkkọ Sọlọmọn ayịn amọ ate, “Sọñ idem nyʌñ kop uko, nyʌñ nam utom ami. Kuukop ndịk kuunyʌñ ukpa mba, sia <char style="nd">Abọọñ</char> Abasi, Abasi mmi, mmọdo aba ye afo. Anye idiikpuuho, idiinyʌññọ ifeghe ukpọñ fiin tutu afịd utom ke abaña tembịd <char style="nd">Abọọñ</char> akweeñe. <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />Mme ikpeghe mme aku ye mbon Lifai ebañña ke mbeeñeidem adinam afịd utom ke tembịd Abasi, ye afịd mbon se ikinyịmme e-enieghe ifiọk nsio-nsio ubọkutom eyaunwam fiin ke afịd mme utom ami. Mme adaaha ye afịd awo eyaekpono afịd ewʌhọ mfo.”<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s1">Mme Enọ Edidat Mbọp Tembịd</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />Akem adidem Defid amaabo afịd esob ate: “Ayịn mmi Sọlọmọn, anye A-Abasi akemekke, ado etəkayịn ye akọi. Ubiọñutom akpon, sia ufọkabọọñ ami idooho ake awo, ado ake <char style="nd">Abọọñ</char> Abasi. <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />Ye afịd inie mmi ami mmebono ñkpọ nnọ tembịd Abasi mmi, kold nọ enam utom kold, silfa nọ enam utom silfa, brọns nọ enam utom brọns, ukwak nọ enam utom ukwak ye eto nọ enam utom eto, ndian ọniks se edat esịn mben ekanna, tọkwọis, nsio-nsio ñkem itiad, ye afịd nsio-nsio mfọọn itiad ye mabịd, afịd ami akedo uwak-uwak. <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />Ke akanna ado, ke ñwaidem mmi ke utom tembịd Abasi mmi ami mmenọ akpọ-akpọ inie kold ye silfa ke tembịd Abasi mmi, akan afịd ñkpọ se nnọ ke adisana tembịd ami: <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />talen kold tọsịn ita<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">A-adooho ñkpọ nte tọọn 110 me metrịk tọọn 100</char></note> (kold ake Ọfia) ye tọsịn silfa itiaba<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">A-adooho ñkpọ nte tọọn 260 me metrịk tọọn 235</char></note>, ke adikama ndot mme ndibene ufọk ami, <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />ke adikama nnam utom kold ye utom silfa, ye afịd mme utom a-anaaha nte mme anam utomusọ enam. Idahami, mme anie awo ibeeñe idem adidiọñ idem ammọ nnịm nnọọ <char style="nd">Abọọñ</char> mfịn ami?”<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />Akem mme adaiwuod ke mme ufọk, mme adaaha ke mme esiin Isrel, mme adaiso ekọñ ke mme tọsịn ye mme adaiso ekọñ ke mme ikie, ye ikpọawo ekeseeghe ñkpọ ebaña utom adidem emaenọ mme enọ awo ikinyịkkenyịk ammọ. <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />Ammọ emaenọ talen tọsịn ition<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">A-adooho ñkpọ nte tọọn 190 me metrịk tọọn 170</char></note> ye darik kold tọsịn duob<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">A-adooho ñkpọ nte kilokram 84</char></note>, talen silfa tọsịn duob<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">A-adooho ñkpọ nte tọọn 380 me metrịk tọọn 340</char></note>, talen brọns tọsịn duob mme itiaita<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">A-adooho ñkpọ nte tọọn 675 me metrịk tọọn 610</char></note> ye ukwak tọsịn ikie<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">A-adooho ñkpọ nte tọọn 3,800 me metrịk tọọn 3,400</char></note> se edat enam utom ke tembịd Abasi. <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />Awo keed akeedodo a-akenieghe nsọñudua itiad amaanọ ammọ nọ enịm ke itie unịm ñkpọ tembịd <char style="nd">Abọọñ</char> a-akebaaha ke idak ukpeme Yehiel awo Kesọn. <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />Mme awo emaenem esịd ebaña naña mme adadusʌñ ammọ ekebọọrọ ke eti usʌñ, sia ammọ emaenọ <char style="nd">Abọọñ</char> ke ntadubọk ke afịdesịd. Adidem Defid amaanyʌñ anem esịd eti-eti.<verse eid="1CH 29:9" /></para>
  <para style="s1">Akam Defid</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />Defid amaatooro <char style="nd">Abọọñ</char> ke iso afịd esob, abo ate,</para>
  <para style="q1" vid="1CH 29:10">“Itooro unie fiin, <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="1CH 29:10">Abasi mme ete ñnyịn Isrel,</para>
  <para style="q2" vid="1CH 29:10">tọọñọ ke nsi-nsi tutu ke nsi-nsi.<verse eid="1CH 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11" />Ake mfo, <char style="nd">Abọọñ</char> ado ubom ye adudu</para>
  <para style="q2" vid="1CH 29:11">ndin itooro ye ubọọñ ye uku,</para>
  <para style="q2" vid="1CH 29:11">ke afịd ñkpọ ke anyọñ ye ke ederimbod ado ake mfo.</para>
  <para style="q1" vid="1CH 29:11">Ake mfo, <char style="nd">Abọọñ</char>, ado abioubọọñ;</para>
  <para style="q2" vid="1CH 29:11">afo ke edịppe nte iwuod ekan afịd ñkpọ.<verse eid="1CH 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12" />Inie ye ukpono uto fiin awuọ;</para>
  <para style="q2" vid="1CH 29:12">afo ado andikara afịd ñkpọ.</para>
  <para style="q1" vid="1CH 29:12">Inweek ye adudu usịne fiin ke ubọk</para>
  <para style="q2" vid="1CH 29:12">aditọọrọ ñnyʌñ nnọọ afịd ñkpọ ukeme.<verse eid="1CH 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13" />Idahami, Abasi ñnyịn, imunọ fiin ekọọm,</para>
  <para style="q2" vid="1CH 29:13">inyʌñ itooro uyaiya anyịñ mfo.<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14" />“Ado ami ndo anie, mbon mmi edoñño mme anie, nọ ñnyịn ikpikeme adinọ ke ntadubọk ntom? Afịd ñkpọ uto fiin, ndin ñnyịn imunọ fiin se ikito ubọk mfo. <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />Ñnyịn idoñño isenawo ye mme adidʌñ ke iso mfo, naña mme eteete ñnyịn ekedoñño. Mme usen ñnyịn ke ederimbod atie nte ndukpọñ, idodanyen ibaaha. <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" /><char style="nd">Abọọñ</char> Abasi ñnyịn, afịd mme ñkpọ ami ake ñnyịn inọọhọ ke edidat mbọp tembịd nnọọ Adisana Anyịñ mfo ato ubọk mfo, ndin afịd ammọ unie fiin. <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />Abasi mmi, ami mmediọọñọ ke afo amesiduuñọ esịd anyʌñ anem esịd ye nsọọñọnda. Afịd mme ñkpọ ami nnọ ke ntadubọk ye esịd akpanikọ. Ndin idahami ami mmekịt ye idadesịd naña ikọd mfo e-ebaaha mi unọọ fiin ke ntadubọk. <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" /><char style="nd">Abọọñ</char>, Abasi mme ete ñnyịn Ebraham, Aisik ye Isrel, nịm mme udọñ ye akikere ami ke esịd ikọd mfo ke nsi-nsi, nyʌñ nam esịd ammọ enam akpanikọ unọ fiin. <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />Ndin nọ ayịn mmi Sọlọmọn ataa ayọhọ ukpono adinịm mme ewʌhọ mfo, mme mbed ye ubiere mfo adinyʌñ nnam afịd ñkpọ adibọp ekamba ufọkubọọñ ake ami mmaakebono ñkpọ nnọ.”<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />Akem Defid amaabo afịd esob ate, “Itooro <char style="nd">Abọọñ</char> Abasi ndufo.” Ndin afịd ammọ emaetooro <char style="nd">Abọọñ</char>, Abasi mme ete ammọ; ammọ emaenyuuk iwuod, eduọ ke isọñ enọ <char style="nd">Abọọñ</char> ye adidem.<verse eid="1CH 29:20" /></para>
  <para style="s1">Enyịmme Sọlọmọn nte Adidem</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />Edem usen ammọ emaenam uwa enọ <char style="nd">Abọọñ</char> enyʌñ enọ anye mme ufọfọb uwa: ñyaaraenañ tọsịn keed (1,000), akukịmedọñ tọsịn keed (1,000) ye ñyịn akukịmedọñ tọsịn keed (1,000), adiana ye mme enọ ukọd, ye mme uwak uwa mfen anọ afịd Isrel. <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />Ammọ emaeta enyʌñ enwọñ ye ayọhọ idadesịd ke iso <char style="nd">Abọọñ</char> ke usen ado.</para>
  <para style="p" vid="1CH 29:22">Akem ammọ emaenyịmme Sọlọmọn ayịn Defid nte adidem ayọhọ akañ iba, eyet anye adan ke iso <char style="nd">Abọọñ</char> adido adaukara ye Sadọk adido aku. <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />Ndin Sọlọmọn amaatie ke ebekpo <char style="nd">Abọọñ</char> nte adidem ke itie ete amọ Defid. Anye amaaforo ndin afịd Isrel emaekop uyio amọ. <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />Afịd mme adaaha ye mme anwana ekọñ, ukem ye afịd nditọ ideen Adidem Defid, emaenwọñọ adisuuk iwuod nnọọ Adidem Sọlọmọn.<verse eid="1CH 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 29:25" />
    <char style="nd">Abọọñ</char> amaanekke adịppe Sọlọmọn ke iso afịd Isrel anyʌñ anọ anye uku ufọkubọọñ a-adooho akenaanam awo inọọhọ adidem ndomokeed ke afịd Isrel.<verse eid="1CH 29:25" /></para>
  <para style="s1">Ñkpa Defid</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />Defid ayịn Yesi akedo adidem ke afịd Isrel. <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />Anye amaakaara Isrel ke isua aba, isua itiaba ke Hibrọn, ndin isua edịb mme duob mme ita ke Yeruselem. <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />Anye akekpa ke ataa eti isua, ke amaakekop inem anyan uwem, inie ye ukpono. Ayịn amọ Sọlọmọn amaadat itie amọ nte adidem.<verse eid="1CH 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 29:29" />Ke abaña mme ñkpọ ukara Adidem Defid, ke ntọọñọ tutu asịm utịd, emaewet ammọ ke ñwed Samwel abia ñkukịd, ñwed ake prọfed Natan ye ñwed ake Kad abia ñkukịd, <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />adiana ye mme ñkpọ ubọọñ amọ ye adudu, ndin ye mme naña itie amọ akeba ye Isrel ye mme ebekpo ke afịd mme isọñ mfen.<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>