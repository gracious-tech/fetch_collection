  <para style="h">Emọs</para>
  <para style="toc1">Emọs</para>
  <para style="toc2">Emọs</para>
  <para style="toc3">Emọs</para>
  <para style="mt1">Emọs</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />Mme ikọ Emọs, keed ke atu mme akpemeedọñ ke Tekoa; ñkukịd a-anye akekịtte abaña Isrel isua iba mbemiso unyekisọñ, ke ini Usaiya akedooho adidem ke Yuda, ñko Yerobuam ayịn Yehoas akedo adidem ke Isrel.<verse eid="AMO 1:1" /></para>
  <para style="b" />
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2" />Anye akebo:</para>
  <para style="q1" vid="AMO 1:2">“<char style="nd">Abọọñ</char> atie ke Saiyọn akpọi</para>
  <para style="q2" vid="AMO 1:2">anyʌñ atie ke Yeruselem asakka nte aduma;</para>
  <para style="q1" vid="AMO 1:2">mbid mme akpemeedọñ asaat,</para>
  <para style="q2" vid="AMO 1:2">anyọñ abod Kamel anyʌñ ayeeme.”<verse eid="AMO 1:2" /></para>
  <para style="s1">Ubiereikpe mme Mbọhọidʌñ Isrel</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />Ami ado se <char style="nd">Abọọñ</char> atañ:</para>
  <para style="q1" vid="AMO 1:3">“Ke ntak idiọọkñkpọ Damaskọs ita,</para>
  <para style="q2" vid="AMO 1:3">akpekọm ado inaañ, ami ndiikpəhoke akikere.</para>
  <para style="q1" vid="AMO 1:3">Sia anye amaanuak Kilied</para>
  <para style="q2" vid="AMO 1:3">ke mme akpeti e-enieghe eded,<verse eid="AMO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4" />Ami ñyaakịm ikañ nsịn ke ufọk Hasel</para>
  <para style="q2" vid="AMO 1:4">a-adiita mme ñkpọsọñ itie Ben-Hadad.<verse eid="AMO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5" />Ñyaawuut inuaatob Damaskọs;</para>
  <para style="q2" vid="AMO 1:5">ñyaasobo adidem a-abaaha ke Abedeñ Afen</para>
  <para style="q1" vid="AMO 1:5">ye anye a-akamake esañ ubọọñ ke Bed-Idịn.</para>
  <para style="q2" vid="AMO 1:5">Mbon Aram eyaekaa ntañmfeb ke Kii,”</para>
  <para style="q2" vid="AMO 1:5">
    <char style="nd">Abọọñ</char> atañ.<verse eid="AMO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />Ami ado se <char style="nd">Abọọñ</char> atañ:</para>
  <para style="q1" vid="AMO 1:6">“Ke ntak idiọọkñkpọ Kasa ita,</para>
  <para style="q2" vid="AMO 1:6">akpekọm inaañ, ami ndiikpəhoke akikere,</para>
  <para style="q1" vid="AMO 1:6">sia anye amaasịn mme atu awo ke ñkpakọb,</para>
  <para style="q2" vid="AMO 1:6">anyʌñ anyam ammọ anọ Edọm,<verse eid="AMO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7" />ami ñyaakịm ikañ nsịn ke mme ndibene Kasa</para>
  <para style="q2" vid="AMO 1:7">a-adiita mme ñkpọsọñ itie amọ.<verse eid="AMO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8" />Ñyaasobo adidem Asdọd</para>
  <para style="q2" vid="AMO 1:8">ye anye a-akamake esañ ubọọñ ke Askelọn.</para>
  <para style="q1" vid="AMO 1:8">Ñyaawọññọ ubọk mmi ñkpọñ Ekrọn,</para>
  <para style="q2" vid="AMO 1:8">tutu akpatre mbon Filistia ekpañña,”</para>
  <para style="q2" vid="AMO 1:8">
    <char style="nd">Abọọñ</char> Andikara atañ.<verse eid="AMO 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />Ami ado se <char style="nd">Abọọñ</char> atañ:</para>
  <para style="q1" vid="AMO 1:9">“Ke ntak idiọọkñkpọ Tai ita,</para>
  <para style="q2" vid="AMO 1:9">akpekọm inaañ, ami ndiikpəhoke akikere.</para>
  <para style="q1" vid="AMO 1:9">Sia anye amaanyam afịd atu mbon ntañmfeb anọ Edọm,</para>
  <para style="q2" vid="AMO 1:9">itoiyoke edioomo nditọeka,<verse eid="AMO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10" />ami ñyaakịm ikañ nsịn ke mme ndibene Tai</para>
  <para style="q2" vid="AMO 1:10">a-adiita mme ñkpọsọñ itie amọ.”<verse eid="AMO 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />Ami ado se <char style="nd">Abọọñ</char> atañ:</para>
  <para style="q1" vid="AMO 1:11">“Ke ntak idiọọkñkpọ Edọm ita,</para>
  <para style="q2" vid="AMO 1:11">akpekọm inaañ, ami ndiikpəhoke akikere.</para>
  <para style="q1" vid="AMO 1:11">Sia anye amaabịne ayịnete amọ ye akañkañ,</para>
  <para style="q2" vid="AMO 1:11">anyʌñ awoot mme ibaan ke idʌñ,</para>
  <para style="q1" vid="AMO 1:11">sia iyadesịd amọ amaakpeene abọhọ,</para>
  <para style="q2" vid="AMO 1:11">ifiobesịd amọ amaanyʌñ asak inieghe nsuuk,<verse eid="AMO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12" />ami ñyaakịm ikañ nsịn ke Teman</para>
  <para style="q2" vid="AMO 1:12">a-adiita mme ñkpọsọñ itie Bosra.”<verse eid="AMO 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />Ami ado se <char style="nd">Abọọñ</char> atañ:</para>
  <para style="q1" vid="AMO 1:13">“Ke ntak idiọọkñkpọ Amọn ita,</para>
  <para style="q2" vid="AMO 1:13">akpekọm inaañ, ami ndiikpəhoke akikere.</para>
  <para style="q1" vid="AMO 1:13">Sia anye amaasai ibaan idịb akʌppọ ke Kilied,</para>
  <para style="q2" vid="AMO 1:13">nọ anye asịkke mme adaña ammọ,<verse eid="AMO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14" />ami ñyaakịm ikañ nsịn ke mme ndibene Raba</para>
  <para style="q2" vid="AMO 1:14">a-adiita mme ñkpọsọñ itie amọ</para>
  <para style="q1" vid="AMO 1:14">ke ufọọd ñkpo ke usen ekọñ,</para>
  <para style="q2" vid="AMO 1:14">ye akpọsọñ afịm ke usen ayobio.<verse eid="AMO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15" />Adidem amọ ayaakaa ntañmfeb,</para>
  <para style="q2" vid="AMO 1:15">anye ye mme adaaha amọ ini keed,”</para>
  <para style="q2" vid="AMO 1:15">
    <char style="nd">Abọọñ</char> atañ.<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />Ami ado se <char style="nd">Abọọñ</char> atañ:</para>
  <para style="q1" vid="AMO 2:1">“Ke ntak idiọọkñkpọ Mọb ita,</para>
  <para style="q2" vid="AMO 2:1">akpekọm inaañ, ami ndiikpəhoke akikere.</para>
  <para style="q1" vid="AMO 2:1">Sia anye amaafọp</para>
  <para style="q2" vid="AMO 2:1">mme akpọ ndidem Edọm ke ikañ tutu aforo ntọñ,<verse eid="AMO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2" />ami ñyaakịm ikañ nsịn ke Mọb</para>
  <para style="q2" vid="AMO 2:2">a-adiita mme ñkpọsọñ itie ke Keriọd.</para>
  <para style="q1" vid="AMO 2:2">Mọb ayaakpa ke ndutʌhọ</para>
  <para style="q2" vid="AMO 2:2">ke ufọọd ñkpo ekọñ ye ke ufịt adukpoñ.<verse eid="AMO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3" />Ñyaasobo andikara amọ,</para>
  <para style="q2" vid="AMO 2:3">ñnyʌñ ñwot afịd mme adaaha ye anye,”</para>
  <para style="q2" vid="AMO 2:3">
    <char style="nd">Abọọñ</char> atañ.<verse eid="AMO 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />Ami ado se <char style="nd">Abọọñ</char> atañ:</para>
  <para style="q1" vid="AMO 2:4">“Ke ntak idiọọkñkpọ Yuda ita,</para>
  <para style="q2" vid="AMO 2:4">akpekọm inaañ, ami ndiikpəhoke akikere.</para>
  <para style="q1" vid="AMO 2:4">Sia ammọ emaesịn mbed <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="AMO 2:4">inyʌññọ inịm mme ewʌhọ amọ,</para>
  <para style="q1" vid="AMO 2:4">sia mme abasi abiaña emaedat ammọ etịn usʌñ,</para>
  <para style="q2" vid="AMO 2:4">mme abasi a-mme eteete ammọ ekekeeneke,<verse eid="AMO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5" />ami ñyaakịm ikañ nsịn ke Yuda,</para>
  <para style="q2" vid="AMO 2:5">a-adiita mme ñkpọsọñ itie Yeruselem.”<verse eid="AMO 2:5" /></para>
  <para style="s1">Ubiereikpe Isrel</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />Ami ado se <char style="nd">Abọọñ</char> atañ:</para>
  <para style="q1" vid="AMO 2:6">“Ke ntak idiọọkñkpọ Isrel ita,</para>
  <para style="q2" vid="AMO 2:6">akpekọm inaañ, ami ndiikpəhoke akikere.</para>
  <para style="q1" vid="AMO 2:6">Ammọ enyam nti awo ebọ silfa,</para>
  <para style="q2" vid="AMO 2:6">enyʌñ enyam mbon uweene ebọ ukod ikpaukod iba.<verse eid="AMO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7" />Ammọ efiik iwuod mme uweene</para>
  <para style="q2" vid="AMO 2:7">nte ntan ke isọñ,</para>
  <para style="q2" vid="AMO 2:7">inyʌññọ ikpe unenikpe inọ mbon se efiik.</para>
  <para style="q1" vid="AMO 2:7">Ete ye ayịn enaa ye abọikpa keed</para>
  <para style="q2" vid="AMO 2:7">enyʌñ esappa adisana anyịñ mmi.<verse eid="AMO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8" />Ammọ esuuk enaa ke mben afịd akpokoro uwa</para>
  <para style="q2" vid="AMO 2:8">ye mme afọñ e-ekebọọhọ ke ubiọñ.</para>
  <para style="q1" vid="AMO 2:8">Ke esịd ufọk abasi ammọ</para>
  <para style="q2" vid="AMO 2:8">ammọ enwọñ mmịn e-ekebọọhọ nte isob.<verse eid="AMO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9" />“Ado ami mmaasobo mbon Amọọ ke iso ammọ,</para>
  <para style="q2" vid="AMO 2:9">akpesʌkado a-ammọ ekedunyọññọ nte mme eto sida,</para>
  <para style="q2" vid="AMO 2:9">enyʌñ esọñ idem nte eto afriyo.</para>
  <para style="q1" vid="AMO 2:9">Mmaasobo mfịd ammọ ke anyọñ</para>
  <para style="q2" vid="AMO 2:9">ye mme adʌñ ke idak isọñ.<verse eid="AMO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10" />Ami ñkisioño ndufo ke Iyib mben ndọọk ndi,</para>
  <para style="q2" vid="AMO 2:10">ñnyʌñ idat ndufo usʌñ ke isua aba ke anaan</para>
  <para style="q2" vid="AMO 2:10">adinọọ ndufo isọñ mbon Amọọ.<verse eid="AMO 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11" />“Ami ñko mmaamek mme prọfed ke atu nditọ ndufo,</para>
  <para style="q2" vid="AMO 2:11">ye mbon Nasariin ke atu mme ñkparawa.</para>
  <para style="q1" vid="AMO 2:11">Nte ami idooho akpanikọ, nditọ Isrel?”</para>
  <para style="q2" vid="AMO 2:11">
    <char style="nd">Abọọñ</char> atañ.<verse eid="AMO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12" />“Ado ndufo emaenam mbon Nasariin enwọñ mmịn,</para>
  <para style="q2" vid="AMO 2:12">enyʌñ enọ mme prọfed iwuuk ete ekuukịt ñkukịd.<verse eid="AMO 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13" />“Amaakem, ñyaikọk ndufo,</para>
  <para style="q2" vid="AMO 2:13">kpa naña ukpadñkpọ akọk ñkpọ ke ini edọññọ abakpa.<verse eid="AMO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14" />Asọbitọk idiibọkkọke,</para>
  <para style="q2" vid="AMO 2:14">ñkpọsọñ awo idiikanna ikoot inweek ammọ,</para>
  <para style="q2" vid="AMO 2:14">ndin awo ekọñ idiikanna inyaaña uwem amọ.<verse eid="AMO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15" />Atob utịgha idiikanna ituak ida,</para>
  <para style="q2" vid="AMO 2:15">awo ekọñ asọp ukod itọk idiifegheke ibọkkọ,</para>
  <para style="q2" vid="AMO 2:15">ndin awad enañmbakara idiinyaañake uwem amọ.<verse eid="AMO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16" />Akpekọm awo ekọñ a-anieghe adudu akan</para>
  <para style="q2" vid="AMO 2:16">ayaafeghe ifed ke usen ado,”</para>
  <para style="q2" vid="AMO 2:16">
    <char style="nd">Abọọñ</char> atañ.<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="s1">Ekoot mme Ntiense Ebaña Isrel</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />Ikop ikọ ami, nditọ Isrel, ikọ <char style="nd">A-Abọọñ</char> atañña ibaña ndufo, abaña afịd ekpək añkesịññeke ke Iyib mben ndọọk ndi:<verse eid="AMO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2" />“Afo ikpọọñ ke ami mmek</para>
  <para style="q2" vid="AMO 3:2">ke atu afịd mme ekpək ke ederimbod;</para>
  <para style="q1" vid="AMO 3:2">ke ntoro ami ñyaimia ndufo ufen</para>
  <para style="q2" vid="AMO 3:2">ke ntak afịd ndiọiñkpọ ndufo.”<verse eid="AMO 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3" />Nte awo iba ekeme edisaña keed</para>
  <para style="q2" vid="AMO 3:3">ibọhọke ammọ enyịmme edinam ntoro?<verse eid="AMO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4" />Nte ekpe asikuun ke akai</para>
  <para style="q2" vid="AMO 3:4">ke ini anye imiikịtte unam se ata?</para>
  <para style="q1" vid="AMO 3:4">Nte anye asisio uyio ke itie nnaa amọ</para>
  <para style="q2" vid="AMO 3:4">ke ini anye imiimʌmmọ ñkpọ?<verse eid="AMO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5" />Nte inuen asifuurọ akedʌk afia ke isọñ</para>
  <para style="q2" vid="AMO 3:5">ke ini ndidia imiisịneke ke afia?</para>
  <para style="q1" vid="AMO 3:5">Nte afia asitamma ke isọñ</para>
  <para style="q2" vid="AMO 3:5">ke ini anye imiimʌmmọ ñkpọ ndomokeed?<verse eid="AMO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6" />Ke ini adukpoñ asioho uyio ke abio,</para>
  <para style="q2" vid="AMO 3:6">nte mme awo isinyeññe idem?</para>
  <para style="q1" vid="AMO 3:6">Ke ini nsobo adʌkkọ abio,</para>
  <para style="q2" vid="AMO 3:6">nte isidooho <char style="nd">Abọọñ</char> asinam?<verse eid="AMO 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7" />Ke akpanikọ <char style="nd">Abọọñ</char> Andikara inamma ñkpọ ndomokeed</para>
  <para style="q2" vid="AMO 3:7">ke anye imiiyaarake uduak amọ</para>
  <para style="q2" vid="AMO 3:7">inọ nditọufọk amọ mme prọfed.<verse eid="AMO 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8" />Ekpe akuun</para>
  <para style="q2" vid="AMO 3:8">anie idiidịkkeke?</para>
  <para style="q1" vid="AMO 3:8">
    <char style="nd">Abọọñ</char> Andikara atañ,</para>
  <para style="q2" vid="AMO 3:8">anie imiidiitañña prọfesi?<verse eid="AMO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9" />Dọkkọ mme ñkpọsọñ itie Asdọd</para>
  <para style="q2" vid="AMO 3:9">ye mme ñkpọsọñ itie Iyib:</para>
  <para style="q1" vid="AMO 3:9">“Isoobo idem ndufo ke abod Sameria;</para>
  <para style="q2" vid="AMO 3:9">ise ekamba ntịme a-abaaha ke esịd amọ</para>
  <para style="q2" vid="AMO 3:9">ye ufiik ke atu mme awo.”<verse eid="AMO 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10" />“Ammọ idiọọñọke adinam se inen,” <char style="nd">Abọọñ</char> atañ,</para>
  <para style="q2" vid="AMO 3:10">“e-ebonoke se ammọ ekoono ke mbịme</para>
  <para style="q2" vid="AMO 3:10">ke mme ñkpọsọñ itie ammọ.”<verse eid="AMO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11" />Ke ntoro ami ado se <char style="nd">Abọọñ</char> Andikara atañ:</para>
  <para style="q1" vid="AMO 3:11">“Asua ayaakan abio mfo,</para>
  <para style="q2" vid="AMO 3:11">awuut mme ñkpọsọñ itie mfo,</para>
  <para style="q2" vid="AMO 3:11">anyʌñ abịme mme ñkpọsọñ itie mfo.”<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />Ami ado se <char style="nd">Abọọñ</char> atañ:</para>
  <para style="q1" vid="AMO 3:12">“Kpa naña akpemeedọñ asio ke inua ekpe</para>
  <para style="q2" vid="AMO 3:12">akpọ ukod iba kpọd me ubaak utọñ,</para>
  <para style="q1" vid="AMO 3:12">kpa ntoro ke ediinyaaña nditọ Isrel e-edʌññọ ke Sameria,</para>
  <para style="q2" vid="AMO 3:12">ke iwuod ikʌk kpọd</para>
  <para style="q2" vid="AMO 3:12">ye ubaak afọñ a-atooho itie nnaa.”<verse eid="AMO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13" />“Ikop ami inyʌñ inọ ikọ ntiense ibaña ubon Yekọb,” <char style="nd">Abọọñ</char> atañ, <char style="nd">Abọọñ</char> Abasi Andikponñkan.<verse eid="AMO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14" />“Ke usen a-ami mmiaha Isrel ufen ke ntak idiọọkñkpọ amọ,</para>
  <para style="q2" vid="AMO 3:14">ñyaawuut mme akpokoro uwa ke Beteel;</para>
  <para style="q1" vid="AMO 3:14">eyaekpịkke mme nnʌk akpokoro uwa efep,</para>
  <para style="q2" vid="AMO 3:14">enyʌñ enyuuk ebon ke isọñ.<verse eid="AMO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15" />Ami ñyaawuut ufọk winta</para>
  <para style="q2" vid="AMO 3:15">ndian ye ufọk ndaayio;</para>
  <para style="q1" vid="AMO 3:15">eyaewuut mme ufọk e-ekamake nnʌkeniin ebana,</para>
  <para style="q2" vid="AMO 3:15">eyaenyʌñ ewuut mme ikpọ ufọk idʌñ,”</para>
  <para style="q2" vid="AMO 3:15">
    <char style="nd">Abọọñ</char> atañ.<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="s1">Isrel Itịmmeke Ikeene Abasi</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1" />Ikop ikọ ami, ndufo mme enañ Basan ke Abod Sameria,</para>
  <para style="q2" vid="AMO 4:1">ndufo ibaan e-efiighe uweene enyʌñ etʌkkọ mbon unana,</para>
  <para style="q2" vid="AMO 4:1">e-enyʌññọ ebo mme ebe ndufo, “Idat ukọd isọk ñnyịn!”<verse eid="AMO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2" />
    <char style="nd">Abọọñ</char> Andikara anwọñọ ke adisana anyịñ amọ:</para>
  <para style="q2" vid="AMO 4:2">“Ke akpanikọ ini ayaadi</para>
  <para style="q1" vid="AMO 4:2">ediiben ndufo ke uwaam ifep,</para>
  <para style="q2" vid="AMO 4:2">tutu ataa akpatre ke atu ndufo ke uwaam ukọ iyak.<verse eid="AMO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3" />Ndufo keedekeed ediisaña nnen-nnen ewuọ</para>
  <para style="q2" vid="AMO 4:3">ekeene ñwuudo ndibene.</para>
  <para style="q1" vid="AMO 4:3">Eyaitop ndufo eduọñọ yak eka ke Hamọn,”</para>
  <para style="q2" vid="AMO 4:3">
    <char style="nd">Abọọñ</char> atañ.<verse eid="AMO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4" />“Ikaa ikinam idiọọkñkpọ ke Beteel;</para>
  <para style="q2" vid="AMO 4:4">ikaa Kilkal ikinam kpasʌk idiọọkñkpọ anenekke awak.</para>
  <para style="q1" vid="AMO 4:4">Idat mme uwa ndufo idi afịd ubakusen,</para>
  <para style="q2" vid="AMO 4:4">mbaak duob ndufo kwa isua ita.<verse eid="AMO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5" />Ifọp uyo a-asịneke yiis nte uwa ekọọm</para>
  <para style="q2" vid="AMO 4:5">inyʌñ inam inua ibaña enọ imaesịd ndufo;</para>
  <para style="q1" vid="AMO 4:5">iwọk inua ibaña ammọ, ndufo mbon Isrel,</para>
  <para style="q2" vid="AMO 4:5">sia se afo ama adinam adoodo,”</para>
  <para style="q2" vid="AMO 4:5">
    <char style="nd">Abọọñ</char> Andikara atañ.<verse eid="AMO 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6" />“Ami ñkinọọ ndufo idịb abiọọñ ke afịd abio</para>
  <para style="q2" vid="AMO 4:6">ye unana uyo ke afịd idʌñ,</para>
  <para style="q1" vid="AMO 4:6">ado ndufo itịmmeke iñkeene miin,”</para>
  <para style="q2" vid="AMO 4:6">
    <char style="nd">Abọọñ</char> atañ.<verse eid="AMO 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7" />“Ami mmaamʌm edịm, ndin anye ideppe inọ ndufo</para>
  <para style="q2" vid="AMO 4:7">ke idọk akesʌkkọ ado afiọñ ita ke iso.</para>
  <para style="q1" vid="AMO 4:7">Mmaanọ edịm ke idʌñ keed,</para>
  <para style="q2" vid="AMO 4:7">ado mmaamʌm ñkama ke idʌñ mfen.</para>
  <para style="q1" vid="AMO 4:7">Inwañ keed amaanie edịm;</para>
  <para style="q2" vid="AMO 4:7">mfen ikinieghe, ndin anye asaat.<verse eid="AMO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8" />Mme awo emaedutịn ke abio ke abio eyem mmọọñ,</para>
  <para style="q2" vid="AMO 4:8">ado ikinieghe se iwak ikem se enwọñ,</para>
  <para style="q1" vid="AMO 4:8">ado ndufo ikitịmmeke iñkeene miin,”</para>
  <para style="q2" vid="AMO 4:8">
    <char style="nd">Abọọñ</char> atañ.<verse eid="AMO 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9" />“Uwak ini ami mmaatahade inwañ ye inwañ fain ndufo,</para>
  <para style="q2" vid="AMO 4:9">nsobo ammọ ke udọñọ ye ke ntọdibọ.</para>
  <para style="q1" vid="AMO 4:9">Ñkukuñkpọyọriyọ amaata eto fik ye ọlif ndufo,</para>
  <para style="q2" vid="AMO 4:9">ado ndufo itịmmeke iñkeene miin,”</para>
  <para style="q2" vid="AMO 4:9">
    <char style="nd">Abọọñ</char> atañ.<verse eid="AMO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10" />“Ami mmaadọñ ndiọi udọñọ nsobo ke atu ndufo,</para>
  <para style="q2" vid="AMO 4:10">kpa naña ñkenam ke Iyib.</para>
  <para style="q1" vid="AMO 4:10">Ami mmaawoot ñkparawa ndufo ke akañkañ,</para>
  <para style="q2" vid="AMO 4:10">dian ye mme enañmbakara se ekekoono.</para>
  <para style="q1" vid="AMO 4:10">Ami mmaanam mme nduduiwuo ndufo eyọhọ ye utebe nnaaekọñ ndufo,</para>
  <para style="q2" vid="AMO 4:10">kpayeado ndufo itịmmeke iñkeene miin,”</para>
  <para style="q2" vid="AMO 4:10">
    <char style="nd">Abọọñ</char> atañ.<verse eid="AMO 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11" />“Ami mmaatop ndusʌk ndufo ñkappa nnịm</para>
  <para style="q2" vid="AMO 4:11">ukem naña ñkenam Sọdọm ye Komora.</para>
  <para style="q1" vid="AMO 4:11">Ndufo eketie nte ntaikañ eto e-edappake ke ikañ,</para>
  <para style="q2" vid="AMO 4:11">ado ndufo itịmmeke iñkeene miin,”</para>
  <para style="q2" vid="AMO 4:11">
    <char style="nd">Abọọñ</char> atañ.<verse eid="AMO 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12" />“Ke ntoro ami ado se mbo nnam ye ndufo, Isrel,</para>
  <para style="q2" vid="AMO 4:12">ndin sia mbooho nnam ami ye ndufo, Isrel,</para>
  <para style="q2" vid="AMO 4:12">ibeeñe idem adisoobo ye Abasi ndufo.”<verse eid="AMO 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13" />Anye a-anamma mme ikpọabod,</para>
  <para style="q2" vid="AMO 4:13">a-anamma afịm,</para>
  <para style="q2" vid="AMO 4:13">a-anyʌññọ ayaara akikere amọ anọ ubon awo,</para>
  <para style="q1" vid="AMO 4:13">a-anamma usiere akappa ekịm,</para>
  <para style="q2" vid="AMO 4:13">anyʌñ anuakka mme ñkoñ-ñkoñ itie ke ederimbod,</para>
  <para style="q2" vid="AMO 4:13">
    <char style="nd">Abọọñ</char> Abasi Andikponñkan ado anyịñ amọ.<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s1">Aseeme ye Ikood Ukappaesịd</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />Ikop ikọ ami, Isrel, aseeme ami ke mbenne ibaña ndufo:<verse eid="AMO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2" />“Mboppo Isrel aduọ,</para>
  <para style="q2" vid="AMO 5:2">idakkake ida ke nsi-nsi,</para>
  <para style="q1" vid="AMO 5:2">emaekpọñ anye ke isọñ amọ,</para>
  <para style="q2" vid="AMO 5:2">awo ndomokeed ibaaha se ibenne anye.”<verse eid="AMO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />Ami ado se <char style="nd">Abọọñ</char> Andikara atañ anọ Isrel:</para>
  <para style="q1" vid="AMO 5:3">“Abio mfo a-asañake ye ñkpọsọñ tọsịn keed awuọ,</para>
  <para style="q2" vid="AMO 5:3">adiisʌhọ ikie keed kpọd;</para>
  <para style="q1" vid="AMO 5:3">idʌñ mfo a-asañake ye ñkpọsọñ ikie keed awuọ</para>
  <para style="q2" vid="AMO 5:3">adiisʌhọ duob kpọd.”<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />Ami ado se <char style="nd">Abọọñ</char> atañ anọ Isrel:</para>
  <para style="q1" vid="AMO 5:4">“Iñyem miin inyʌñ idu uwem;<verse eid="AMO 5:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 5:5" />ikiiyem Beteel,</para>
  <para style="q1" vid="AMO 5:5">ikiikaa Kilkal,</para>
  <para style="q2" vid="AMO 5:5">ikiinam isañ ikaa Beeseba.</para>
  <para style="q1" vid="AMO 5:5">Sia Kilkal eyaedoñño mbon ntañmfeb,</para>
  <para style="q2" vid="AMO 5:5">ndin eyaesuuho Beteel anye idooho ñkpọ ndomokeed.”<verse eid="AMO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6" />Iyem <char style="nd">Abọọñ</char> inyʌñ idu uwem,</para>
  <para style="q2" vid="AMO 5:6">imiidooho ntoro anye ayaakwọọk mme esiin Yosef nte ikañ;</para>
  <para style="q1" vid="AMO 5:6">ayaasobo ammọ,</para>
  <para style="q2" vid="AMO 5:6">ndin Beteel idiinieghe awo ndomokeed se idiinịmme anye.<verse eid="AMO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7" />A-aba mme awo e-ekappake unenikpe esịn ke idod,</para>
  <para style="q2" vid="AMO 5:7">enyʌñ etop adinenido eduọọk ke isọñ.<verse eid="AMO 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8" />Anye a-akenamma Pleiades ye Orion,</para>
  <para style="q2" vid="AMO 5:8">a-akekappake ufọọd akonayio asịn ke usiere,</para>
  <para style="q2" vid="AMO 5:8">anyʌñ anam uweemeayio akappa akonayio,</para>
  <para style="q1" vid="AMO 5:8">a-akoodo mmọọñ ke akpainyañ</para>
  <para style="q2" vid="AMO 5:8">anyʌñ aduọk ammọ ke iso isọñ,</para>
  <para style="q2" vid="AMO 5:8">
    <char style="nd">Abọọñ</char> ado anyịñ amọ.<verse eid="AMO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9" />Ke unwana asiide awo anyen anye asobo mme ñkpọsọñ itie,</para>
  <para style="q2" vid="AMO 5:9">anyʌñ aben nsobo asọk abio e-ebọppọ ndibene ukpeme ekanna.<verse eid="AMO 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10" />Aba mbon e-esuaha awo a-asọọñọke amʌm unenikpe ke esob akama,</para>
  <para style="q2" vid="AMO 5:10">enyʌñ esua awo a-atañña akpanikọ.<verse eid="AMO 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11" />Ndufo ebọ uweene taks ke se imiidooho ñkpọ</para>
  <para style="q2" vid="AMO 5:11">enyʌñ ebọ taks ke abakpa ammọ.</para>
  <para style="q1" vid="AMO 5:11">Ke ntoro, akpesʌkado a-ndufo ebọppọ ikpọ ufọk itiad,</para>
  <para style="q2" vid="AMO 5:11">ndufo idiidʌññọ do;</para>
  <para style="q1" vid="AMO 5:11">akpesʌkado a-ndufo etọọhọ mfọọn inwañ fain,</para>
  <para style="q2" vid="AMO 5:11">ndufo idiinwọññọ ukọd ammọ.<verse eid="AMO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12" />Sia mmediọọñọ ibad ndudue ndufo,</para>
  <para style="q2" vid="AMO 5:12">ye naña idiọọkñkpọ ndufo akpoon.</para>
  <para style="b" vid="AMO 5:12" />
  <para style="q1" vid="AMO 5:12">Aba mbon e-efiike mme nti awo enyʌñ ebọ ubọkedem,</para>
  <para style="q2" vid="AMO 5:12">enyʌñ esịn adinọ mme uweene unenikpe ke ufọkesob.<verse eid="AMO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13" />Ke ntoro adiọọñọidem awo adop uyio ke utọ ini ado,</para>
  <para style="q2" vid="AMO 5:13">sia mme ini adiọọhọ.<verse eid="AMO 5:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14" />Iyem eti ñkpọ, ikiiyem idiọọk,</para>
  <para style="q2" vid="AMO 5:14">nọ ndufo edu uwem.</para>
  <para style="q1" vid="AMO 5:14">Ndin <char style="nd">Abọọñ</char> Abasi Andikponñkan ayaaba ye ndufo,</para>
  <para style="q2" vid="AMO 5:14">kpa naña ndufo ebo ke anye mmọdo.<verse eid="AMO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15" />Isua se idiọọk, ima se ifọn;</para>
  <para style="q2" vid="AMO 5:15">inịm unenikpe ke mme ufọkesob.</para>
  <para style="q1" vid="AMO 5:15">Akemeido <char style="nd">Abọọñ</char> Abasi Andikponñkan ayaatua nsʌhọ</para>
  <para style="q2" vid="AMO 5:15">Yosef mbọm.<verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />Ke ntoro ami ado se Abọọñ, <char style="nd">Abọọñ</char>, Abasi Andikponñkan, atañ:</para>
  <para style="q1" vid="AMO 5:16">“Ntuaña ayaaba ke afịd mme efaak,</para>
  <para style="q2" vid="AMO 5:16">ye mme aseeme ukuud ke afịd anwa abio.</para>
  <para style="q1" vid="AMO 5:16">Eyaekoot mme atọinwañ editua ayịd</para>
  <para style="q2" vid="AMO 5:16">ye mbon ukuud ete editua.<verse eid="AMO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17" />Ntuaña ayaaba ke afịd mme inwañ fain</para>
  <para style="q2" vid="AMO 5:17">sia ñyaaboiyo ndʌk ke ufọọd ndufo,”</para>
  <para style="q2" vid="AMO 5:17">
    <char style="nd">Abọọñ</char> atañ.<verse eid="AMO 5:17" /></para>
  <para style="s1">Usen <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18" />Adọdiọọk anọ awo a-ayemme</para>
  <para style="q2" vid="AMO 5:18">usen <char style="nd">Abọọñ</char>!</para>
  <para style="q1" vid="AMO 5:18">Ntak a-afo ayemme usen <char style="nd">Abọọñ</char>-o?</para>
  <para style="q2" vid="AMO 5:18">Usen ado adiido ekịm, idooho unwana.<verse eid="AMO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19" />Adiitie nte awo afeghe abọkkọ ekpe,</para>
  <para style="q2" vid="AMO 5:19">ndin akesoobo amọnikọd,</para>
  <para style="q1" vid="AMO 5:19">nte anye akedʌk ufọk amọ</para>
  <para style="q2" vid="AMO 5:19">anyʌñ abet ubọk amọ ke ndibene</para>
  <para style="q2" vid="AMO 5:19">ndin udʌkikọd akọñ anye.<verse eid="AMO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20" />Nte usen <char style="nd">Abọọñ</char> idiidooho ekịm, idooho unwana,</para>
  <para style="q2" vid="AMO 5:20">abubịd ekịm, u-unwana imiibaaha?<verse eid="AMO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21" />Ami mmesua ñnyʌñ nnsịn mme usọrọ edu ukpono abasi ndufo ke ndek;</para>
  <para style="q2" vid="AMO 5:21">mme esob ndufo edo utebe ñkpọ ennọ miin.<verse eid="AMO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22" />Akpesʌkado a-ndufo ebenne mme ufọfọb uwa ye uwa ñkpasi ensọk miin,</para>
  <para style="q2" vid="AMO 5:22">ami ndiibọọhọ ammọ.</para>
  <para style="q1" vid="AMO 5:22">Akpesʌkado a-ndufo ebenne ndimek uwa ewuana emem edi,</para>
  <para style="q2" vid="AMO 5:22">ami ndiidatta ammọ ke ñkpọ.<verse eid="AMO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23" />Iben uyom ikwọ ndufo ikaa!</para>
  <para style="q2" vid="AMO 5:23">Ami ndiikpañña utọñ nnọ mbiiñe ikwọ mme ekpa ndufo.<verse eid="AMO 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24" />Ado yak unenikpe awere nte inyañ,</para>
  <para style="q2" vid="AMO 5:24">adinenido nte idịm i-imiitreke!<verse eid="AMO 5:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25" />“Ubon Isrel, nte ndufo emaekoono uwa ye mme enọ ensọk miin,</para>
  <para style="q2" vid="AMO 5:25">ke isua aba a-ndufo ekebaaha ke anaan?<verse eid="AMO 5:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26" />Ndufo emedịppe iso ndem adidem ndufo ke anyọñ,</para>
  <para style="q2" vid="AMO 5:26">adaaha mme ubobodñkpọ ndufo,</para>
  <para style="q2" vid="AMO 5:26">ntantaafiọñ abasi ndufo,</para>
  <para style="q2" vid="AMO 5:26">a-ndufo ekenamma enọọ idem ndufo.<verse eid="AMO 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27" />Ke ntoro ami ñyaanam ndufo ekedoñño ntañmfeb ke Damaskọs,”</para>
  <para style="q2" vid="AMO 5:27">
    <char style="nd">Abọọñ</char> atañ, a-anyịñ amọ adooho Abasi Andikponñkan.<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s1">Adọdiọọk Anọ Mbon e-Ebaaha ke Ndueidem</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1" />Adọdiọọk anọ mbon e-ebaaha ke ndueidem ke Saiyọn,</para>
  <para style="q2" vid="AMO 6:1">ye ndufo e-enieghe mbuọdidem ke Abod Sameria,</para>
  <para style="q1" vid="AMO 6:1">ndufo mme ikpọawo ke ñwuọnda idịd,</para>
  <para style="q2" vid="AMO 6:1">a-nditọ Isrel ekaaha ebịne!<verse eid="AMO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2" />Kaa Kalne ke se anye;</para>
  <para style="q2" vid="AMO 6:2">ke to do kaa akwa Hamad,</para>
  <para style="q2" vid="AMO 6:2">ndin suuk kaa Kad ke Filistia.</para>
  <para style="q1" vid="AMO 6:2">Nte afọn ye ammọ akan mme abioubọọñ ndufo naña iba?</para>
  <para style="q2" vid="AMO 6:2">Nte isọñ ammọ akpon akan a-ndufo?<verse eid="AMO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3" />Ndufo emesịkke usen nsobo,</para>
  <para style="q2" vid="AMO 6:3">enyʌñ enam ukara afai akpere.<verse eid="AMO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4" />Ndufo ena ke ñkpana e-edatta nnʌk eniin ebana,</para>
  <para style="q2" vid="AMO 6:4">enyʌñ enyanna eduọk adudu ke mme ñkpọitie ndufo.</para>
  <para style="q1" vid="AMO 6:4">Ndufo eta ñyịn edọñ se emek</para>
  <para style="q2" vid="AMO 6:4">ye mme ukọkʌk ñyịn enañ.<verse eid="AMO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5" />Ndufo ebre mme ndido udʌk ndufo nte Defid,</para>
  <para style="q2" vid="AMO 6:5">enyʌñ enam mme ñkpọ ubre ikwọ.<verse eid="AMO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6" />Ndufo enwọñ ukọd ke ayọhọ usan afere,</para>
  <para style="q2" vid="AMO 6:6">enyʌñ efiọññọ adan se ifọn ikan,</para>
  <para style="q2" vid="AMO 6:6">ado ndufo ifʌhọke ibaña ñwuudo Yosef.<verse eid="AMO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7" />Ke ntoro ndufo eyaedo keed ke atu mme akpa mbon ediika ntañmfeb;</para>
  <para style="q2" vid="AMO 6:7">ndia ye unwọññkpọ ndufo eyaetre.<verse eid="AMO 6:7" /></para>
  <para style="s1">
    <char style="nd">Abọọñ</char> Imaaha Ntañidem Isrel</para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />
    <char style="nd">Abọọñ</char> Andikara amaanwọñọ ke idem amọ, <char style="nd">Abọọñ</char> Abasi Andikponñkan atañ:</para>
  <para style="q1" vid="AMO 6:8">“Mmesua ntañidem Yekọb,</para>
  <para style="q2" vid="AMO 6:8">ñnyʌñ nsua mme ñkpọsọñ itie amọ;</para>
  <para style="q1" vid="AMO 6:8">ñyaayaak abio ado nnọ</para>
  <para style="q2" vid="AMO 6:8">ye afịd ñkpọ ke esịd amọ.”<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />Adieke ekpọññọ awo duob ke ufọk, ammọ ñko eyaekpañña. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />Ndin adieke ayakka a-adiighe adiben mme akpo nsịññe ke ufọk ñkefọp abịppe awo akeedodo a-akpedịbeke do, “Nte aba awo mfen ye afo?” ndin anye abo, “Iyoo,” ndin anye ayaadian do abo, “Dop uyio! Inaaha nte ñnyịn isiak anyịñ <char style="nd">Abọọñ</char>.”<verse eid="AMO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11" />Sia <char style="nd">Abọọñ</char> a-anọ ewʌhọ,</para>
  <para style="q2" vid="AMO 6:11">ndin anye ayaanuak ekamba ufọk ñkeñe-ñkeñe,</para>
  <para style="q2" vid="AMO 6:11">anyʌñ anuak etək ufọk mbai-mbai.<verse eid="AMO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12" />Nte mme enañmbakara esifeeñe ke anyọñ itiad?</para>
  <para style="q2" vid="AMO 6:12">Nte awo ayaadat ñyaaraenañ afʌñ akpainyañ?</para>
  <para style="q1" vid="AMO 6:12">Ado ndufo emekappa unenikpe esịn ke ibọkñkpa,</para>
  <para style="q2" vid="AMO 6:12">ndin mfịd eti ido akappa ado idod-idod;<verse eid="AMO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13" />ndufo e-edaarake ke edikan Lo Deba<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">Lo Deba </char><char style="ft" closed="false">awuọñọ </char><char style="fqa" closed="false">ikpuikpu.</char></note></para>
  <para style="q2" vid="AMO 6:13">enyʌñ ebo, “Nte ñnyịn ikikanna Kanaim<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">Kanaim </char><char style="ft" closed="false">awuọñọke </char><char style="fqa" closed="false">mme nnʌk </char><char style="ft" closed="false">; </char><char style="fqa" closed="false">nnʌk </char><char style="ft" closed="false">ado idiọọñọ adudu.</char></note> ke adudu idem ñnyịn?”<verse eid="AMO 6:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14" />Sia <char style="nd">Abọọñ</char> Abasi Andikponñkan atañ,</para>
  <para style="q2" vid="AMO 6:14">“Ñyaabenne idịd edinwana ye ndufo, Isrel,</para>
  <para style="q1" vid="AMO 6:14">a-adiifiik ndufo ke afịd usʌñ</para>
  <para style="q2" vid="AMO 6:14">tọọñọ ke Lebo Hamad tutu asịm ke itịkke Araba.”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s1">Ñkukuñkpọyọriyọ, Ikañ ye Udʌk Ñked</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />Ami ado se <char style="nd">Abọọñ</char> Andikara akeñwọt miin: anye akesʌk anam ndutʌm abaña ñkukuñkpọyọriyọ ke ini emaekedọk ñkpọinwañ adidem kpa ke ini mfịd inwañ e-eketọọhọ akpatre eketọọñọke editịppe. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />Ke ini ammọ emaekenam isọñ asana ana ifed, ami mmaaseeme ñkoot nte, “<char style="nd">Abọọñ</char> Andikara, feen! Yekọb adiinam die idu uwem? Anye asịp abọhọ!”<verse eid="AMO 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3" />Ke ntoro <char style="nd">Abọọñ</char> amaamʌm idem.</para>
  <para style="p" vid="AMO 7:3">“Ami idiitịppeke,” <char style="nd">Abọọñ</char> amaatañ.<verse eid="AMO 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />Ami ado se <char style="nd">Abọọñ</char> Andikara akeñwọt miin: <char style="nd">Abọọñ</char> Andikara akebo yak edat ikañ emia ufen; ikañ amaanam ekamba ntotəño inyañ asat anyʌñ asobo isọñ. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />Akem ami mmaaseeme ñkoot Abasi: “<char style="nd">Abọọñ</char> Andikara, ami mmuukpe fiin ubọk, tre! Yekọb adiinam die idu uwem? Anye asịp abọhọ!”<verse eid="AMO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6" />Ke ntoro <char style="nd">Abọọñ</char> amaamʌm idem.</para>
  <para style="p" vid="AMO 7:6">“Anyem ñko idiitịppeke,” <char style="nd">Abọọñ</char> Andikara amaatañ.<verse eid="AMO 7:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />Ami ado se anye akeñwọt: <char style="nd">Abọọñ</char> akeda akpere ndibene e-ekedatta udʌk ñked ebọp, ye udʌk ñked ke ubọk amọ. <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />Akem <char style="nd">Abọọñ</char> ambịp miin abo, “Emọs, nsoo ke afo akịt?”</para>
  <para style="p" vid="AMO 7:8">Ami mmaabọọrọ, “Udʌk ñked.”</para>
  <para style="p" vid="AMO 7:8">Akem <char style="nd">Abọọñ</char> amaabo, “Se, ami mmenịm udʌk ñked ke atu ikọd mmi Isrel; ami ndiifeene nnọ ammọ aba.<verse eid="AMO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9" />“Ñyaasobo mme ñkoñ-ñkoñ itie Aisik,</para>
  <para style="q2" vid="AMO 7:9">ñnyʌñ ñwuut mme ndisana itie ke Isrel;</para>
  <para style="q2" vid="AMO 7:9">ñyaadịppe akañkañ mmi ñnwana ye ufọk Yerobuam.”<verse eid="AMO 7:9" /></para>
  <para style="s1">Emọs ye Amasaiya</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />Akem Amasaiya a-akedooho aku ke Beteel amaadọñ utom anọ Yerobuam adidem Isrel ate: “Emọs a-adʌk idiọọk adu ubaña fiin ke isọñ abio Isrel. Isọñ ikanna adiyọ afịd ikọ amọ. <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />Sia se Emọs atañ ado ami:</para>
  <para style="q1" vid="AMO 7:11">“ ‘Yerobuam ayaakpa ke akañkañ,</para>
  <para style="q2" vid="AMO 7:11">ndin Isrel idiitreke adika ntañmfeb,</para>
  <para style="q2" vid="AMO 7:11">ewuọ ekpọñ isọñemana ammọ.’ ”<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />Ndin Amasaiya amaabo Emọs, “Wuọ nyọñ, afo akịdñkukịd! Tịmme kaa ke isọñ Yuda. Ke nwana idem, dia ñkpọ ke udo nyʌñ tañ prọfesi mfo ke udo. <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />Kuutañ prọfesi mfo aba ke Beteel, sia umi ado adisana itie adidem ye tembịd abio adidem.”<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />Emọs amaabọọrọ Amasaiya, “Ami ñkedooho prọfed kpak ndooho ayịn prọfed, ñkedo akpemeedọñ, ñkenyʌñ nse ñkpọ mbaña mme eto sikamọ-fik. <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />Ado <char style="nd">Abọọñ</char> amamben miin asio ke ukpeme edọñ anyʌñ ambo miin, ‘Kaa, ke tañ prọfesi nọ ikọd mmi Isrel.’ <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />Ndin idahami, kop ikọ <char style="nd">Abọọñ</char>. Afo abo,</para>
  <para style="q1" vid="AMO 7:16">“ ‘Kuutañ prọfesi ubaña Isrel,</para>
  <para style="q2" vid="AMO 7:16">nyʌñ tre ukwọrọikọ mbaña ubon Aisik.’<verse eid="AMO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17" />“Ke ntoro ami ado se <char style="nd">Abọọñ</char> atañ:</para>
  <para style="q1" vid="AMO 7:17">“ ‘Anwaan mfo ayaakappa akpara ke abio,</para>
  <para style="q2" vid="AMO 7:17">ndin nditọ mfo ideen ye ibaan eyaekpañña ke akañkañ.</para>
  <para style="q1" vid="AMO 7:17">Eyaedomo isọñ mfo ebakka,</para>
  <para style="q2" vid="AMO 7:17">ndin afo ke idem mfo uduukpa ke idʌñ mbon i-imiidiọọñọke Abasi.</para>
  <para style="q1" vid="AMO 7:17">Ndin Isrel idiitreke adika ntañmfeb,</para>
  <para style="q2" vid="AMO 7:17">ewuọ ekpọñ isọñ emana ammọ.’ ”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s1">Akpasa Ndad-ndad Mfịd</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />Ami ado se <char style="nd">Abọọñ</char> Andikara akeñwọt miin: akpasa ndad-ndad mfịd. <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />Anye amambịp miin, “Nsoo ke afo akịt, Emọs?”</para>
  <para style="p" vid="AMO 8:2">Ami mmaabọọrọ, “Akpasa ndad-ndad mfịd.”</para>
  <para style="p" vid="AMO 8:2">Akem <char style="nd">Abọọñ</char> amambo miin, “Ini akem anọ ikọd mmi Isrel; ami ndiiyaaha ammọ aba.<verse eid="AMO 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3" />“Ke usen ado,” <char style="nd">Abọọñ</char> Andikara atañ, “mme ikwọ ke tembịd eyaekappa ntuaña. Eyaetoomo uwak-uwak akpo awo eboon afịd itie! Ndopuyio!”<verse eid="AMO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4" />Ikop ami, ndufo e-etʌkkọke mbon unana,</para>
  <para style="q2" vid="AMO 8:4">enyʌñ esọọn mme uweene ke isọñ,<verse eid="AMO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 8:5" />ndufo e-ebooho,</para>
  <para style="q1" vid="AMO 8:5">“Idaha akee ke Ufa Afiọñ adiiboiyo</para>
  <para style="q2" vid="AMO 8:5">nọ ñnyịn inyam abakpa,</para>
  <para style="q1" vid="AMO 8:5">ini akee ke Sabad adiikweeñe</para>
  <para style="q2" vid="AMO 8:5">nọ ñnyịn ikpiben wiid ika udua?”</para>
  <para style="q1" vid="AMO 8:5">E-enam udomoñkpọ yak asịb,</para>
  <para style="q2" vid="AMO 8:5">ado e-enam ekọmudua akpon,</para>
  <para style="q2" vid="AMO 8:5">e-enyʌñ etʌk awo ke ukwañ udomoñkpọ,<verse eid="AMO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6" />e-edep mbon uweene ke silfa</para>
  <para style="q2" vid="AMO 8:6">ye mbon unana ke ukod ikpaukod iba,</para>
  <para style="q2" vid="AMO 8:6">e-enyam kpa mbio a-atooho wiid.<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />
    <char style="nd">Abọọñ</char> amaanwọñọ ke idem amọ, Asian Yekọb: “Tutu amama, ami ndiifreke ñkpọ ndomokeed a-ammọ enamma.<verse eid="AMO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8" />“Nte isọñ idiinyeññe ke ntak ami,</para>
  <para style="q2" vid="AMO 8:8">ndin afịd mbon se idʌñ ke esịd efʌhọ?</para>
  <para style="q1" vid="AMO 8:8">Afịd isọñ ayaadakka ada nte akpa Nail;</para>
  <para style="q2" vid="AMO 8:8">anye ayaatịmede ndin aduọ</para>
  <para style="q2" vid="AMO 8:8">nte inyañ Iyib.<verse eid="AMO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9" />“Ke usen ado,” <char style="nd">Abọọñ</char> Andikara atañ,</para>
  <para style="q1" vid="AMO 8:9">ami ñyaanam utịn asuuhọ ke ufọọd uweemeayio,</para>
  <para style="q2" vid="AMO 8:9">ñnyʌñ nnam ekịm afʌk isọñ ke ataa uweemeayio.<verse eid="AMO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10" />Ami ñyaanam mme usọrọ ukpono abasi ndufo ekappa edo mfʌhọ,</para>
  <para style="q2" vid="AMO 8:10">ndin afịd ikwọ eyaekappa edo ntuaña.</para>
  <para style="q1" vid="AMO 8:10">Ñyaanam afịd nsiine ndufo edo ntaaha afọñ,</para>
  <para style="q2" vid="AMO 8:10">ñnyʌñ ikwaat ndufo ided ke iwuod.</para>
  <para style="q1" vid="AMO 8:10">Ñyaanam ini ado akappa ado mfʌhọ anọ ukweeñe ayịn keed,</para>
  <para style="q2" vid="AMO 8:10">ndin utịd amọ ado idod-idod usen.<verse eid="AMO 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11" />
    <char style="nd">Abọọñ</char> Andikara atañ: “Mme usen esʌk edi</para>
  <para style="q2" vid="AMO 8:11">a-ami ndiidọñ akañ ke afịd isọñ;</para>
  <para style="q1" vid="AMO 8:11">idooho akañ ndidia mme nsaditọñ mmọọñ,</para>
  <para style="q2" vid="AMO 8:11">ado akañ ukop ikọ <char style="nd">Abọọñ</char>.<verse eid="AMO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12" />Mme awo eyaeyooñ tọọñọ ke akpainyañ keed tutu esịm akpainyañ mfen,</para>
  <para style="q2" vid="AMO 8:12">enyʌñ esaaña tọọñọ ke adoro tutu ke usakkautịn</para>
  <para style="q1" vid="AMO 8:12">eyeem ikọ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="AMO 8:12">ado ammọ idiikịtte.<verse eid="AMO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13" />“Ke usen ado</para>
  <para style="q1" vid="AMO 8:13">“mme mfọọn ubọikpa ye ñkpọsọñ ñkparawa</para>
  <para style="q2" vid="AMO 8:13">eyaekpa mba ke ntak nsaditọñ.<verse eid="AMO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14" />Mbon e-enwọñọke ke idiọọkñkpọ Sameria;</para>
  <para style="q2" vid="AMO 8:14">e-ebooho, ‘Kpa naña abasi mfo adu uwem, Daan,’</para>
  <para style="q2" vid="AMO 8:14">me, ‘Kpa naña abasi Beeseba adu uwem’</para>
  <para style="q2" vid="AMO 8:14">ammọ eyaeduọññọ, idakkake ida aba ke nsi-nsi.”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s1">Eyaesobo Isrel</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />Ami mmaakịt <char style="nd">Abọọñ</char> naña ada akpere akpokoro uwa, anye amaanyʌñ abo:</para>
  <para style="q1" vid="AMO 9:1">“Yʌppọ mme anyọñ eto abai ado</para>
  <para style="q2" vid="AMO 9:1">nọ ato do mme abọbọọk udọk enyeeñe.</para>
  <para style="q1" vid="AMO 9:1">Nam ammọ eduọññọ edoro ke iwuod afịd awo;</para>
  <para style="q2" vid="AMO 9:1">mbon e-esʌhọke ami ñyaawot ke akañkañ.</para>
  <para style="q1" vid="AMO 9:1">Ndomokeed idiifegheke ikaa itie mfen,</para>
  <para style="q2" vid="AMO 9:1">ndomokeed idiibọkkọke.<verse eid="AMO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2" />Akpekọm ammọ edọk isọñ yak atʌñọ,</para>
  <para style="q2" vid="AMO 9:2">kpa ke ndo ubọk mmi ayaaben ammọ.</para>
  <para style="q1" vid="AMO 9:2">Akpekọm ammọ ekpedọọk ekesịm mme anyọñ,</para>
  <para style="q2" vid="AMO 9:2">ke ndo ami ñyaaben ammọ nsọiyọ.<verse eid="AMO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3" />Akpekọm ammọ edịp idem ammọ ke anyọñ abod Kamel,</para>
  <para style="q2" vid="AMO 9:3">ke ndo ami ñyaabịne ammọ nsuuk ñnyʌñ mmuum ammọ.</para>
  <para style="q1" vid="AMO 9:3">Akpekọm ammọ edịbe ekpọñ iso mmi ke ataa isọñ akpainyañ,</para>
  <para style="q2" vid="AMO 9:3">ke ndo ñyaanọ udʌkikọd uyio akekọñ ammọ.<verse eid="AMO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4" />Akpekọm mme asua ammọ ekoono ammọ nte ntañmfeb,</para>
  <para style="q2" vid="AMO 9:4">ke udo ami ñyaadọñ akañkañ akewot ammọ.</para>
  <para style="b" vid="AMO 9:4" />
  <para style="q1" vid="AMO 9:4">“Ami ñyaawuuk anyen mmi nse ammọ</para>
  <para style="q2" vid="AMO 9:4">ke idiọọk, idooho ke eti.”<verse eid="AMO 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5" />
    <char style="nd">Abọọñ</char>, <char style="nd">Abọọñ</char> Andikponñkan;</para>
  <para style="q1" vid="AMO 9:5">anye a-atuuk isọñ, isọñ ayeeme,</para>
  <para style="q2" vid="AMO 9:5">ndin afịd mbon e-edʌññọ ke esịd efʌhọ;</para>
  <para style="q1" vid="AMO 9:5">afịd isọñ edakka eda nte akpainyañ Nail,</para>
  <para style="q2" vid="AMO 9:5">akem esuuhọ nte inyañ Iyib;<verse eid="AMO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6" />anye a-abọp ñkoñ-ñkoñ ufọk ubọọñ amọ ke anyọñ,</para>
  <para style="q2" vid="AMO 9:6">anyʌñ awuuk itiad idakisọñ amọ ke isọñ;</para>
  <para style="q1" vid="AMO 9:6">anye a-akoot mmọọñ ke akpainyañ</para>
  <para style="q2" vid="AMO 9:6">anyʌñ aduọk ammọ ke iso isọñ,</para>
  <para style="q2" vid="AMO 9:6">
    <char style="nd">Abọọñ</char> ado anyịñ amọ.<verse eid="AMO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7" />“Nte ndufo idooho mbon Isrel</para>
  <para style="q2" vid="AMO 9:7">ukem innọ miin nte mbon Kuus?”</para>
  <para style="q2" vid="AMO 9:7">
    <char style="nd">Abọọñ</char> atañ.</para>
  <para style="q1" vid="AMO 9:7">Nte ami ñkebenne Isrel ke Iyib ndọọk ndi,</para>
  <para style="q2" vid="AMO 9:7">mbon Filistia nto ke Kaftọ,</para>
  <para style="q2" vid="AMO 9:7">ye mbon Aram e-etooho Kii?<verse eid="AMO 9:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8" />“Ke akpanikọ anyen <char style="nd">Abọọñ</char> Andikara</para>
  <para style="q2" vid="AMO 9:8">asʌk ase idịd idiọọkñkpọ.</para>
  <para style="q1" vid="AMO 9:8">Ami ñyaasobo anye</para>
  <para style="q2" vid="AMO 9:8">nsio ke iso isọñ.</para>
  <para style="q1" vid="AMO 9:8">Ado ami ndiisoboke afịd</para>
  <para style="q2" vid="AMO 9:8">ubon Yekọb,”</para>
  <para style="q2" vid="AMO 9:8">
    <char style="nd">Abọọñ</char> atañ.<verse eid="AMO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9" />“Sia ñyaanọ ewʌhọ,</para>
  <para style="q2" vid="AMO 9:9">ñyaanyʌñ ñnyeeñe nditọ Isrel</para>
  <para style="q2" vid="AMO 9:9">ke atu afịd mme idịd,</para>
  <para style="q1" vid="AMO 9:9">kpa naña ekeñ mfịd ke ukeñ,</para>
  <para style="q2" vid="AMO 9:9">ndin mbeñe amọ idisịmme isọñ.<verse eid="AMO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10" />Afịd mme anamidiọọk ke atu ikọd mmi</para>
  <para style="q2" vid="AMO 9:10">eyaekpañña ke akañkañ,</para>
  <para style="q1" vid="AMO 9:10">afịd mbon e-ebooho,</para>
  <para style="q2" vid="AMO 9:10">‘Nsobo idiisịmme, inyʌññọ isoobo ye ñnyịn.’<verse eid="AMO 9:10" /></para>
  <para style="s1">Utịmme Mbenne Isrel Nnịm</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />“Ke usen ado</para>
  <para style="q1" vid="AMO 9:11">“Ami ñyaadiọñ ñwuudo ufọk Defid;</para>
  <para style="q2" vid="AMO 9:11">ñyaasiit mme mboomo ndibene amọ,</para>
  <para style="q2" vid="AMO 9:11">ami ñyaamaana ndiọñ ñwuudo amọ,</para>
  <para style="q2" vid="AMO 9:11">nnam anye aba naña akesiba,<verse eid="AMO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12" />nọ ammọ ekeme edidat nsʌhọ Edọm nnie</para>
  <para style="q2" vid="AMO 9:12">ye afịd idịd e-ekereke anyịñ mmi,”</para>
  <para style="q2" vid="AMO 9:12">
    <char style="nd">Abọọñ</char> a-adiinam mme ñkpọ ami atañ.<verse eid="AMO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13" />“Mme usen esʌk edi,” <char style="nd">Abọọñ</char> atañ,</para>
  <para style="q1" vid="AMO 9:13">ini a-andidọk adiisọp ikan anditọtọ,</para>
  <para style="q2" vid="AMO 9:13">ndin anditọ asọp ukod akan andisọnnọ kreb.</para>
  <para style="q1" vid="AMO 9:13">Ufa ukọd ayaatọi ke mme ikpọabod,</para>
  <para style="q2" vid="AMO 9:13">anyʌñ afiọrọ ke afịd ntək abod,<verse eid="AMO 9:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="AMO 9:14" />ndin ñyaatañ ikọd mmi Isrel nsio ke ntañmfeb.</para>
  <para style="b" vid="AMO 9:14" />
  <para style="q1" vid="AMO 9:14">“Ammọ eyaemaana ebọp mme ñwuudo abio, enyʌñ edʌñọ ke esịd ammọ.</para>
  <para style="q2" vid="AMO 9:14">Ammọ eyaetọ mme inwañ fain enyʌñ enwọñ ukọd ammọ;</para>
  <para style="q2" vid="AMO 9:14">ammọ eyaenam inwañ enyʌñ edia mme mfịd.<verse eid="AMO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15" />Ami ñyaatọ Isrel ke isọñ ammọ,</para>
  <para style="q2" vid="AMO 9:15">ke nsi-nsi awo idiiwịppeke ammọ aba isio</para>
  <para style="q2" vid="AMO 9:15">ke isọñ a-ami nnọọhọ ammọ,”</para>
  <para style="m" vid="AMO 9:15">
    <char style="nd">Abọọñ</char> Abasi ndufo atañ.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>