<usx version="3.0">
  <book code="NAM" style="id">- Ibibio Contemporary Bible 2025 (Ñwed Abasi ke Ikọ Ibibio Ayo Mfịn)</book>
  <para style="rem">Copyright © 2020, 2025 by Biblica, Inc.®</para>
  <para style="h">Nahum</para>
  <para style="toc1">Nahum</para>
  <para style="toc2">Nahum</para>
  <para style="toc3">Nah</para>
  <para style="mt1">Nahum</para>
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />Prọfesi a-abañake Ninife. Ñwed ñkukịd Nahum awo Elkos.<verse eid="NAM 1:1" /></para>
  <para style="b" />
  <para style="s1">Iyadesịd <char style="nd">Abọọñ</char> ye Ninife</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2" />
    <char style="nd">Abọọñ</char> ado afịbe ufịb ye asio usiene Abasi;</para>
  <para style="q2" vid="NAM 1:2">
    <char style="nd">Abọọñ</char> asisio usiene anyʌñ ayọhọ ye ifiobesịd.</para>
  <para style="q1" vid="NAM 1:2">
    <char style="nd">Abọọñ</char> asisio mme asua amọ usiene</para>
  <para style="q2" vid="NAM 1:2">anyʌñ akọọrọ ifiobesịd afʌk mbon utọk amọ.<verse eid="NAM 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3" />
    <char style="nd">Abọọñ</char> isọppọ iyadesịd ado akpon ke adudu;</para>
  <para style="q2" vid="NAM 1:3">
    <char style="nd">Abọọñ</char> idiiyakka mbon edueghe isob ebọkkọ.</para>
  <para style="q1" vid="NAM 1:3">Usʌñ amọ asịne ke idio ye ke ayobio,</para>
  <para style="q2" vid="NAM 1:3">ñko ntọñanyọñ ado abu ukod amọ.<verse eid="NAM 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4" />Anye aduat akpainyañ anyʌñ anam anye asat;</para>
  <para style="q2" vid="NAM 1:4">anye anam afịd mme inyañ esaat.</para>
  <para style="q1" vid="NAM 1:4">Basan ye Kamel e-eyeppe,</para>
  <para style="q2" vid="NAM 1:4">ñko nseghe Lebanọn a-ayeppe.<verse eid="NAM 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5" />Mme ikpọabod e-enyeñ ke iso amọ</para>
  <para style="q2" vid="NAM 1:5">ñko ntək abod e-esuana.</para>
  <para style="q1" vid="NAM 1:5">Ederimbod a-anyeñ ke iso amọ,</para>
  <para style="q2" vid="NAM 1:5">ederimbod ye afịd se idʌñ ke esịd amọ.<verse eid="NAM 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6" />Anie awo ikpikeme iyọ ifiobesịd amọ?</para>
  <para style="q2" vid="NAM 1:6">Anie ikpikeme iyọ iyadesịd amọ?</para>
  <para style="q1" vid="NAM 1:6">E-eduọk iyadesịd amọ nte ikañ;</para>
  <para style="q2" vid="NAM 1:6">mme ikpọ itiad e-ebomo ke isọ amọ.<verse eid="NAM 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7" />
    <char style="nd">Abọọñ</char> afọn,</para>
  <para style="q2" vid="NAM 1:7">itie udịbe ke ini afanekọñ.</para>
  <para style="q1" vid="NAM 1:7">Anye akpeme mbon se ibuọt idem ye anye,<verse eid="NAM 1:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="NAM 1:8" />ado anye adiidat akwa atọ mmọọñ</para>
  <para style="q1" vid="NAM 1:8">aben Ninife adisịm utịd;</para>
  <para style="q2" vid="NAM 1:8">anye ayaabịne mme asua amọ akedọñ ke udem ekịm.<verse eid="NAM 1:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9" />Se adodo a-ammọ eduakka ebaña <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="NAM 1:9">anye ayaaben adiwuọ utịd;</para>
  <para style="q2" vid="NAM 1:9">afanekọñ idiitịppeke ayọhọ akañ iba.<verse eid="NAM 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10" />Ammọ eyaewaña ke ñkukịm,</para>
  <para style="q2" vid="NAM 1:10">enyʌñ ekpa mmịn eto ukọd ammọ;</para>
  <para style="q2" vid="NAM 1:10">eyaeta ammọ nte nsaad ñnyanyaha.<verse eid="NAM 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11" />Ninife, awo keed ato ke afo awuọ adi,</para>
  <para style="q2" vid="NAM 1:11">awo a-aduakka ibak abaña <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="NAM 1:11">a-anyʌññọ akere idiọọk akikere.<verse eid="NAM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12" />Ntom ke <char style="nd">Abọọñ</char> atañ:</para>
  <para style="q1" vid="NAM 1:12">“Akpesʌkado a-ammọ ewakka enyʌñ enie uwak ufan ke ini ekọñ,</para>
  <para style="q2" vid="NAM 1:12">eyaesobo ammọ; ñko ammọ eyaenyʌñ eboiyo efep.</para>
  <para style="q1" vid="NAM 1:12">Akpesʌkado ke ami mmautʌhọde fiin, Yuda,</para>
  <para style="q2" vid="NAM 1:12">ami nduutʌhọkede fiin aba.<verse eid="NAM 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13" />Idahami ami ñyaabʌñ akpọnọ ammọ nsio ke itọñ mfo,</para>
  <para style="q2" vid="NAM 1:13">ñnyʌñ ñkpok ukad mfo nsioño.”<verse eid="NAM 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14" />Ninife, <char style="nd">Abọọñ</char> a-anọ ewʌhọ ubaña fiin:</para>
  <para style="q2" vid="NAM 1:14">“Afo uduunieghe ubon se ikere anyịñ mfo.</para>
  <para style="q1" vid="NAM 1:14">Ami ñyaasobo mme usọsọi ñkpọ ye mme ubobodñkpọ</para>
  <para style="q2" vid="NAM 1:14">e-ebaaha ke tembịd mme abasi ndufo.</para>
  <para style="q1" vid="NAM 1:14">Ami ñyaadiọñ udi ndufo nnịm,</para>
  <para style="q2" vid="NAM 1:14">sia ndufo ifọnnọ.”<verse eid="NAM 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15" />Se, ko ke mme ikpọabod,</para>
  <para style="q2" vid="NAM 1:15">mme ukod mbon e-ebenne eti etob edi,</para>
  <para style="q2" vid="NAM 1:15">e-ekwọrọke emem!</para>
  <para style="q1" vid="NAM 1:15">Yuda, dia idaara usọrọ mfo,</para>
  <para style="q2" vid="NAM 1:15">nyʌñ sio akaaña mfo.</para>
  <para style="q1" vid="NAM 1:15">Mbon ibak iduutịmekede fiin aba;</para>
  <para style="q2" vid="NAM 1:15">eyaesobo ammọ afịd-afịd esio<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">Ke mme ikpañwed Hibru ewet ufañ ami Nah 1:15 nte Nah 2:1.</char></note>.<verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="s1">Ninife Ayaaduọ</para>
  <para style="q1">
    <note caller="+" style="f">
      <char style="fr" closed="false">2: </char>
      <char style="ft" closed="false">Ke mme ikpañwed Hibru ewet Nah 2:1-13 nte Nah 2:2-14.</char>
    </note> <verse number="1" style="v" sid="NAM 2:1" />Awo ekọñ adʌk ubịne fiin, Ninife.</para>
  <para style="q2" vid="NAM 2:1">Ikpeme akọekọñ,</para>
  <para style="q2" vid="NAM 2:1">ikpeme akpọusʌñ,</para>
  <para style="q2" vid="NAM 2:1">ibeeñe idem,</para>
  <para style="q2" vid="NAM 2:1">idọñ idem ye afịd adudu ndufo!<verse eid="NAM 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2" />
    <char style="nd">Abọọñ</char> ayaaben uyai Yekọb atịmme adi</para>
  <para style="q2" vid="NAM 2:2">nte uyai Isrel,</para>
  <para style="q1" vid="NAM 2:2">akpesʌkado mme andisobo emaesobo, ammọ esio</para>
  <para style="q2" vid="NAM 2:2">enyʌñ ebiat mme fain ammọ.<verse eid="NAM 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3" />Mme atuekọñ mbon ekọñ edo ndad-ndad;</para>
  <para style="q2" vid="NAM 2:3">ñkpọsọñ mbon ekọñ ammọ esịne ididuod afọñ.</para>
  <para style="q1" vid="NAM 2:3">Ñkprañ ukwak amịneñ ke anyọñ sariọd</para>
  <para style="q2" vid="NAM 2:3">ke usen e-ebeeñeke ammọ idem;</para>
  <para style="q2" vid="NAM 2:3">eduad yunipa ammọ ayaanekke afịm.<verse eid="NAM 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4" />Mme sariọd ewuọñọ esuana ekanna mme efaak,</para>
  <para style="q2" vid="NAM 2:4">eyọọrọ ekaa iso ye edem ke mme ufed abio.</para>
  <para style="q1" vid="NAM 2:4">Ammọ eba nte ikañ nsadañ;</para>
  <para style="q2" vid="NAM 2:4">esọp nte akebkeb.<verse eid="NAM 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5" />Ninife atañ ikọ anọ mme adadusʌñ ammọ,</para>
  <para style="q2" vid="NAM 2:5">ado ammọ esʌk etuak ukod eduọññọ ke usʌñ.</para>
  <para style="q1" vid="NAM 2:5">Ammọ esọp itọk esịm ndibene ammọ;</para>
  <para style="q2" vid="NAM 2:5">enịm atuekọñ ukpeme ke itie.<verse eid="NAM 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6" />E-ebeere mme inuaatob inyañ enịm inwañ</para>
  <para style="q2" vid="NAM 2:6">ufọk adidem anyʌñ aduọ.<verse eid="NAM 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7" />E-enọ ewʌhọ ebo yak Ninife</para>
  <para style="q2" vid="NAM 2:7">awuọ, e-enyʌñ esio anye eduọọk.</para>
  <para style="q1" vid="NAM 2:7">Mme ifʌn ibaan amọ emịm nte ibiom,</para>
  <para style="q2" vid="NAM 2:7">enyʌñ emia eba ammọ.<verse eid="NAM 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8" />Ninife aba nte ube mmọọñ</para>
  <para style="q2" vid="NAM 2:8">a-mmọọñ amọ adịtte ama.</para>
  <para style="q1" vid="NAM 2:8">Ammọ etua, “Itre! Itre!”</para>
  <para style="q2" vid="NAM 2:8">Ado awo ndomokeed ikannake iso.<verse eid="NAM 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9" />Ibịme silfa ado!</para>
  <para style="q2" vid="NAM 2:9">Ibịme kold ado!</para>
  <para style="q1" vid="NAM 2:9">Ñkpọuto ado barasuene,</para>
  <para style="q2" vid="NAM 2:9">inie a-atooho afịd mme ñkpọuto amọ!<verse eid="NAM 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10" />E-etem anye ukpọk, e-ebịme anye, e-etem anye ifed!</para>
  <para style="q2" vid="NAM 2:10">Esịd a-aduọ, edọñ a-ameem,</para>
  <para style="q2" vid="NAM 2:10">idem a-anyeñ, afịd iso a-aduọkkọ.<verse eid="NAM 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11" />Mmọ ube ekpe idahami,</para>
  <para style="q2" vid="NAM 2:11">itie a-ammọ enọọhọ nditọ ammọ ndidia,</para>
  <para style="q1" vid="NAM 2:11">itie se ayaara ye uman ekpe ekekaa,</para>
  <para style="q2" vid="NAM 2:11">ñko nditọ ekpe, inieghe se efeghe?<verse eid="NAM 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12" />Ekpe amaawot se ikem nditọ amọ,</para>
  <para style="q2" vid="NAM 2:12">anyʌñ asịn unam afiaitọñ anọ anwaan amọ,</para>
  <para style="q1" vid="NAM 2:12">ayọhọ itie nnaa amọ ye se anye awot,</para>
  <para style="q2" vid="NAM 2:12">adọñ unam a-anye awotto ke itie nnaa amọ ayọhọ.<verse eid="NAM 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13" />“Ami ñyaanam ikọ ye afo.”</para>
  <para style="q2" vid="NAM 2:13">
    <char style="nd">Abọọñ</char> Andikponñkan atañ,</para>
  <para style="q1" vid="NAM 2:13">“Ami ñyaafọp mme sariọd mfo ke edemeikañ,</para>
  <para style="q2" vid="NAM 2:13">ñko akañkañ ayaadia mme ñkparawa ekpe ndufo.</para>
  <para style="q2" vid="NAM 2:13">Ami ndiinịmme ñkpọ se afo awai ata unọ ke ederimbod.</para>
  <para style="q1" vid="NAM 2:13">Awo idiikoppo uyio mme isʌñutom mfo</para>
  <para style="q2" vid="NAM 2:13">aba ke iso isọñ.”<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="s1">Adọdiọọk anọ Ninife</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1" />Adọdiọọk anọ abio afai,</para>
  <para style="q2" vid="NAM 3:1">a-ayọhọke ye nsu,</para>
  <para style="q1" vid="NAM 3:1">a-ayọhọke ye mbịme,</para>
  <para style="q2" vid="NAM 3:1">a-ammiinanake se awai eta!<verse eid="NAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2" />Uyom ikpa,</para>
  <para style="q2" vid="NAM 3:2">uyom ñkwaaha mme ikara ukwak,</para>
  <para style="q1" vid="NAM 3:2">uyom itọk mme enañmbakara</para>
  <para style="q2" vid="NAM 3:2">ye mme ntəkko sariọd!<verse eid="NAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3" />Mbon enañmbakara e-edịppe</para>
  <para style="q2" vid="NAM 3:3">mmịneñ-mmịneñ akañkañ</para>
  <para style="q2" vid="NAM 3:3">ye ñyayamma eduad!</para>
  <para style="q1" vid="NAM 3:3">Uwak se enọmọ,</para>
  <para style="q2" vid="NAM 3:3">eboho mme akpo awo,</para>
  <para style="q1" vid="NAM 3:3">akpo ewak ekan se ebat,</para>
  <para style="q2" vid="NAM 3:3">mme awo etuak ukod ke mme akpo eduọ,<verse eid="NAM 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4" />afịd ado ke ntak atịme udọñ akpara,</para>
  <para style="q2" vid="NAM 3:4">e-ekaiyake idiọñ,</para>
  <para style="q1" vid="NAM 3:4">e-ekesịnne mme idịd ifʌn ke ntak akpara amọ,</para>
  <para style="q2" vid="NAM 3:4">ye mme awo ke ntak ifọd amọ.<verse eid="NAM 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5" />
    <char style="nd">Abọọñ</char> Andikponñkan atañ: “Ami mmenam ikọ ye afo,</para>
  <para style="q2" vid="NAM 3:5">ami ñyaadịppe mme ñkpịn mfo ufʌk iso.</para>
  <para style="q1" vid="NAM 3:5">Ami ñyaaben ifed mfo ñwọt mme idịd,</para>
  <para style="q2" vid="NAM 3:5">ñnyʌñ ñwọt mme abioubọọñ abuud mfo.<verse eid="NAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6" />Ami ñyauduọk fiin ñkpọ ndọk ke idem,</para>
  <para style="q2" vid="NAM 3:6">ami ñyausịn fiin ke ndek,</para>
  <para style="q2" vid="NAM 3:6">ñnyʌñ nnam afo ado ñkpọ ndise.<verse eid="NAM 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7" />Afịd mbon se ukịt fiin eyaefeeñe enyʌñ ebo,</para>
  <para style="q2" vid="NAM 3:7">‘Ninife aduọkkọ abono, anie idiitua inọ anye?’</para>
  <para style="q2" vid="NAM 3:7">Ke mmọọ ke ami ndiikịt awo se udọñ fiin esịd?”<verse eid="NAM 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8" />Nte afo amefọn akan Tebes,</para>
  <para style="q2" vid="NAM 3:8">a-abaaha ke Nail,</para>
  <para style="q2" vid="NAM 3:8">a-mmọọñ akannake anye akʌk?</para>
  <para style="q1" vid="NAM 3:8">Inyañ akedo ukpeme amọ,</para>
  <para style="q2" vid="NAM 3:8">mmọọñ ado ndibene amọ.<verse eid="NAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9" />Kuus ye Iyib ekedo ananautịd adudu amọ;</para>
  <para style="q2" vid="NAM 3:9">Pud ye Libia ekedo mme nsaña amọ.<verse eid="NAM 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10" />Kpayeado emaemʌm anye nte mbuodekọñ</para>
  <para style="q2" vid="NAM 3:10">enyʌñ esio anye efep ke abio.</para>
  <para style="q1" vid="NAM 3:10">Emaeboom ntəkayịn amọ mbai-mbai</para>
  <para style="q2" vid="NAM 3:10">ke afịd ñwakka usʌñ.</para>
  <para style="q1" vid="NAM 3:10">Emaesịn afia ebaña mme adaaha amọ,</para>
  <para style="q2" vid="NAM 3:10">enyʌñ edọñ mme ñkpisọñ amọ ke ñkpọnọ.<verse eid="NAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11" />Ukọd ayaanyʌñ unaam fiin ñko;</para>
  <para style="q2" vid="NAM 3:11">afo ayaakedịbe</para>
  <para style="q2" vid="NAM 3:11">anyʌñ ayem itie udịbe ato asua.<verse eid="NAM 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12" />Afịd ñkpọsọñ itie mfo eba nte eto fik,</para>
  <para style="q2" vid="NAM 3:12">ye mme akpa mfịd ammọ;</para>
  <para style="q1" vid="NAM 3:12">ke ini enyegheke ammọ,</para>
  <para style="q2" vid="NAM 3:12">mme fik ado eduọ edʌk inua mme andidia.<verse eid="NAM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13" />Se mme udịmekọñ mfo,</para>
  <para style="q2" vid="NAM 3:13">afịd ammọ edo mme idek.</para>
  <para style="q1" vid="NAM 3:13">Inuaatob isọñ emana mfo</para>
  <para style="q2" vid="NAM 3:13">ana inwañ anọ mme asua mfo;</para>
  <para style="q2" vid="NAM 3:13">ikañ ata itịm inuaatob mfo.<verse eid="NAM 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14" />Bọ mmọọñ nịm mbaak ini eduukanna ikʌk,</para>
  <para style="q2" vid="NAM 3:14">sọọñọ mme ñkpọsọñ itie mfo!</para>
  <para style="q1" vid="NAM 3:14">Nuakka mbad,</para>
  <para style="q2" vid="NAM 3:14">sọnnọ nsọñ,</para>
  <para style="q2" vid="NAM 3:14">diọñ utom itiad ukọọk ufọk!<verse eid="NAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15" />Do ke ikañ aduuta fiin;</para>
  <para style="q2" vid="NAM 3:15">eduad ayaukpịkke fiin anịm,</para>
  <para style="q2" vid="NAM 3:15">ammọ eduuta fiin nte eboho ñkukuñkpọyọriyọ.</para>
  <para style="q1" vid="NAM 3:15">Tọt nte ataktak,</para>
  <para style="q2" vid="NAM 3:15">tọt nte ñkukuñkpọyọriyọ!<verse eid="NAM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16" />Afo amenam ibad mbon unyamudua mfo ewak,</para>
  <para style="q2" vid="NAM 3:16">tutu ammọ ewak ekan ntantaafiọñ ke anyọñ,</para>
  <para style="q2" vid="NAM 3:16">ado nte ñkukuñkpọyọriyọ, ammọ enịm isọñ anaan,</para>
  <para style="q2" vid="NAM 3:16">enyʌñ efuurọ enyọñ.<verse eid="NAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17" />Mbon ukpeme mfo ebit ñkukuñkpọyọriyọ,</para>
  <para style="q2" vid="NAM 3:17">mme adaaha mfo nte eboho ñkukuñkpọyọriyọ</para>
  <para style="q2" vid="NAM 3:17">e-edianake ke ndibene ke ndedeñ usen,</para>
  <para style="q1" vid="NAM 3:17">ado ayio amaasakka ammọ efuurọ enyọñ,</para>
  <para style="q2" vid="NAM 3:17">ndin awo idiọọñọke itie nte ekaiya.<verse eid="NAM 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18" />Adidem Asiria, mme akpemeedọñ<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">A-adooho, mme andikara</char></note> mfo eba idab-idab;</para>
  <para style="q2" vid="NAM 3:18">mbọọñ mfo esuuk enaa eduọk adudu.</para>
  <para style="q1" vid="NAM 3:18">Mbon mfo e-esuana ke anyọñ ikpọabod,</para>
  <para style="q2" vid="NAM 3:18">awo ibaaha se ikoot ammọ ibok.<verse eid="NAM 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19" />Ibaaha se idiikan ukọk fiin;</para>
  <para style="q2" vid="NAM 3:19">unan mfo adiitre ke ñkpa.</para>
  <para style="q1" vid="NAM 3:19">Afịd mbon se ikop etob ubaña fiin,</para>
  <para style="q2" vid="NAM 3:19">ekwak ubọk ammọ ke iduọ mfo,</para>
  <para style="q1" vid="NAM 3:19">sia anie awo idiidiọọñọke</para>
  <para style="q2" vid="NAM 3:19">ndoom mfo i-imiinieghe utịd?<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>