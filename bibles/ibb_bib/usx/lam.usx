  <para style="h">Eseeme</para>
  <para style="toc1">Eseeme</para>
  <para style="toc2">Eseeme</para>
  <para style="toc3">Ese</para>
  <para style="mt1">Eseeme</para>
  <chapter number="1" style="c" sid="LAM 1" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1" />Anam die nọ abio a-mme awo ekeyọhọke ke esịd,</para>
  <para style="q2" vid="LAM 1:1">akappa ana ukpọk!</para>
  <para style="q1" vid="LAM 1:1">Anam die nọ anye atie nte ebekpa,</para>
  <para style="q2" vid="LAM 1:1">anye a-akedooho akpọsọñ ke atu mme idịd!</para>
  <para style="q1" vid="LAM 1:1">Anye a-akedooho abọọñanwaan ke atu mme esiin idịd</para>
  <para style="q2" vid="LAM 1:1">akappa ado afʌn idahami.<verse eid="LAM 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2" />Anye atua ndod-ndod ayịd ke akonayio,</para>
  <para style="q2" vid="LAM 1:2">mmọọñayịd adiaat anye ke mfʌk.</para>
  <para style="q1" vid="LAM 1:2">Ke atu afịd mbon ima amọ</para>
  <para style="q2" vid="LAM 1:2">ndomokeed ibaaha se idọñ anye esịd.</para>
  <para style="q1" vid="LAM 1:2">Afịd mme ufan amọ ebiaña anye;</para>
  <para style="q2" vid="LAM 1:2">ammọ ekappa edo mme asua amọ.<verse eid="LAM 1:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3" />Ke ukuud ye akpọsọñ utom emaeboiyo,</para>
  <para style="q2" vid="LAM 1:3">Yuda adakka akaa asenidịd.</para>
  <para style="q1" vid="LAM 1:3">Anye adʌñ ke atu mme idịd;</para>
  <para style="q2" vid="LAM 1:3">anye ikịtte itie nduọkadudu.</para>
  <para style="q1" vid="LAM 1:3">Afịd mbon e-ebịneke anye eboiyo ekpọñ anye</para>
  <para style="q2" vid="LAM 1:3">ke ufọọd ukuud amọ.<verse eid="LAM 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4" />Mme akpọusʌñ e-ekaaha Saiyọn efʌhọ,</para>
  <para style="q2" vid="LAM 1:4">sia awo ndomokeed idiighe mme ndimek usọrọ amọ.</para>
  <para style="q1" vid="LAM 1:4">Afịd mme usʌñ inuaatob amọ enaa ñwuudo,</para>
  <para style="q2" vid="LAM 1:4">mme aku amọ eseeme,</para>
  <para style="q1" vid="LAM 1:4">mme ubọikpa amọ efʌhọ,</para>
  <para style="q2" vid="LAM 1:4">ndin anye aba ke idod-idod ntaeded.<verse eid="LAM 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5" />Mme asua amọ ekappa edoñño mme eteufọk amọ;</para>
  <para style="q2" vid="LAM 1:5">mme asua amọ eba ke emem.</para>
  <para style="q1" vid="LAM 1:5">
    <char style="nd">Abọọñ</char> aben mfʌhọ anọ anye,</para>
  <para style="q2" vid="LAM 1:5">ke ntak uwak idiọọkñkpọ amọ.</para>
  <para style="q1" vid="LAM 1:5">Ntəkayịn edʌk ufʌn,</para>
  <para style="q2" vid="LAM 1:5">mbon ntañmfeb ke iso asua.<verse eid="LAM 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6" />Afịd uku amaakpọñ</para>
  <para style="q2" vid="LAM 1:6">Adiaha Saiyọn.</para>
  <para style="q1" vid="LAM 1:6">Mme akpanabọọñ amọ etie nte edob</para>
  <para style="q2" vid="LAM 1:6">imiikịtte mbid se eta;</para>
  <para style="q1" vid="LAM 1:6">ke mmemidem, ammọ efeeñe</para>
  <para style="q2" vid="LAM 1:6">ke iso andibịne.<verse eid="LAM 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7" />Ke mme usen ukuud ye ndutịn amọ</para>
  <para style="q2" vid="LAM 1:7">Yeruselem atoiyo afịd ñkpọuto</para>
  <para style="q2" vid="LAM 1:7">e-ekedooho ake amọ ke mme usen edem.</para>
  <para style="q1" vid="LAM 1:7">Ke ini mbon amọ ekeduọññọke ke ubọk mme asua,</para>
  <para style="q2" vid="LAM 1:7">awo ndomokeed ikibaaha adinwam anye.</para>
  <para style="q1" vid="LAM 1:7">Mme asua amọ emaese anye,</para>
  <para style="q2" vid="LAM 1:7">enyʌñ esaha ke nsobo amọ.<verse eid="LAM 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8" />Yeruselem amaanam idiọọkñkpọ ekamba-ekamba,</para>
  <para style="q2" vid="LAM 1:8">ndin ke ntoro anye isanake.</para>
  <para style="q1" vid="LAM 1:8">Afịd mbon e-ekekponoke anye ese anye ke ndek,</para>
  <para style="q2" vid="LAM 1:8">sia afịd ammọ emaekịt ifed amọ;</para>
  <para style="q1" vid="LAM 1:8">anye ke idem amọ amịm</para>
  <para style="q2" vid="LAM 1:8">anyʌñ atịmme edem.<verse eid="LAM 1:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9" />Mbad amọ ayịre anye ke afọñ,</para>
  <para style="q2" vid="LAM 1:9">anye ikikereke ibaña ini iso amọ.</para>
  <para style="q1" vid="LAM 1:9">Iduọ amọ akedo ñkpọ ñkpaidem;</para>
  <para style="q2" vid="LAM 1:9">awo ndomokeed ikibaaha adinọ anye idọñesịd.</para>
  <para style="q1" vid="LAM 1:9">“<char style="nd">Abọọñ</char>, se ñkpọ baña ukuud mmi,</para>
  <para style="q2" vid="LAM 1:9">sia asua akan.”<verse eid="LAM 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10" />Asua amaadot ubọk</para>
  <para style="q2" vid="LAM 1:10">ke afịd ñkpọuto amọ;</para>
  <para style="q1" vid="LAM 1:10">anye amaakịt mme idịd i-imiidiọọñọke Abasi</para>
  <para style="q2" vid="LAM 1:10">naña edʌk adisana itie amọ,</para>
  <para style="q1" vid="LAM 1:10">mbon a-afo akekpanna</para>
  <para style="q2" vid="LAM 1:10">adidʌk ke esob mfo.<verse eid="LAM 1:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11" />Afịd mbon amọ eseeme</para>
  <para style="q2" vid="LAM 1:11">naña ammọ eyem ndidia;</para>
  <para style="q1" vid="LAM 1:11">ammọ ekpuuño mme ñkpọuto ammọ ebọ ndidia</para>
  <para style="q2" vid="LAM 1:11">nọ ammọ edu uwem.</para>
  <para style="q1" vid="LAM 1:11">“<char style="nd">Abọọñ</char>, se nyʌñ kere baña,</para>
  <para style="q2" vid="LAM 1:11">sia ense miin ke ndek.”<verse eid="LAM 1:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12" />“Nte idooho ñkpọ inọ ndufo, afịd ndufo e-esañake eboiyo?</para>
  <para style="q2" vid="LAM 1:12">Kanna anyen mfo nyʌñ se.</para>
  <para style="q1" vid="LAM 1:12">Aba ufen a-atieghe nte ufen mmi</para>
  <para style="q2" vid="LAM 1:12">e-ekebenne endot miin ke idem,</para>
  <para style="q1" vid="LAM 1:12">
    <char style="nd">A-Abọọñ</char> akebenne andot miin</para>
  <para style="q2" vid="LAM 1:12">ke usen ikañ-ikañ iyadesịd amọ?<verse eid="LAM 1:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13" />“Anye adọñ ikañ ato ke anyọñ,</para>
  <para style="q2" vid="LAM 1:13">adọñ asọiyọ adidʌk mme akpọ mmi.</para>
  <para style="q1" vid="LAM 1:13">Anye atat iyịre anịm anọ ukod mmi,</para>
  <para style="q2" vid="LAM 1:13">anyʌñ anam ami ntịmme edem.</para>
  <para style="q1" vid="LAM 1:13">Anye anam ami mba ke nsobo,</para>
  <para style="q2" vid="LAM 1:13">ñkpamba afịd anyan usen.<verse eid="LAM 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14" />“Emaetobo idiọọkñkpọ mmi esịn ke akpọnọ<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">Ke ataa uwak mme ikpañwed Hibru; uwak mme ikpañwed Hibru ye Septuakin akeme ido </char><char style="fqa" closed="false">Anye amaasuuk anyen ase mme idiọọkñkpọ mmi</char></note>;</para>
  <para style="q2" vid="LAM 1:14">akedat ubọk amọ adọk ammọ adian itie keed.</para>
  <para style="q1" vid="LAM 1:14">Emaeben ammọ eñwañ miin ke itọñ,</para>
  <para style="q2" vid="LAM 1:14">ndin <char style="nd">Abọọñ</char> anam inweek imbaaha aba.</para>
  <para style="q1" vid="LAM 1:14">Anye añyaak miin asịn ke ubọk</para>
  <para style="q2" vid="LAM 1:14">mbon se ami ndiikanna ñnwana anwan.<verse eid="LAM 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15" />“<char style="nd">Abọọñ</char> asịn</para>
  <para style="q2" vid="LAM 1:15">afịd mbon uko ke atu mmi;</para>
  <para style="q1" vid="LAM 1:15">anye akoot udịmekọñ nọ enwana ye ami</para>
  <para style="q2" vid="LAM 1:15">nọ ewoot ñkparawa mmi.</para>
  <para style="q1" vid="LAM 1:15">Ke ukwak unyịmme ukọd amọ <char style="nd">Abọọñ</char> asọnnọ</para>
  <para style="q2" vid="LAM 1:15">Adiaha Yuda.<verse eid="LAM 1:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16" />“Ntak a-ami ntuaha ayịd ado ami,</para>
  <para style="q2" vid="LAM 1:16">anyen mmi anyʌñ afiọrọ ye mmọọñayịd.</para>
  <para style="q1" vid="LAM 1:16">Awo ndomokeed ibaaha ikpere se indọñ miin esịd,</para>
  <para style="q2" vid="LAM 1:16">awo ndomokeed ibaaha aditịmme idemme sịbidịd mmi.</para>
  <para style="q1" vid="LAM 1:16">Nditọ mmi edo mbon unana</para>
  <para style="q2" vid="LAM 1:16">Sia asua a-akan.”<verse eid="LAM 1:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17" />Saiyọn asio ubọk amọ anyan,</para>
  <para style="q2" vid="LAM 1:17">ado ibaaha awo se inọ anye idọñesịd.</para>
  <para style="q1" vid="LAM 1:17">
    <char style="nd">Abọọñ</char> anịm mbed anọ Yekọb,</para>
  <para style="q2" vid="LAM 1:17">nọ mme mbọhọidʌñ amọ ekappa edo mme asua amọ;</para>
  <para style="q1" vid="LAM 1:17">Yeruselem akappa ado</para>
  <para style="q2" vid="LAM 1:17">ñkpọ i-imiisanake ke atu ammọ.<verse eid="LAM 1:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18" />“<char style="nd">Abọọñ</char> ado adinen,</para>
  <para style="q2" vid="LAM 1:18">kpayeado ami mmaasọñ iwuod ye ewʌhọ amọ.</para>
  <para style="q1" vid="LAM 1:18">Ikpañ utọñ, afịd mbon awo;</para>
  <para style="q2" vid="LAM 1:18">ise ufen mmi.</para>
  <para style="q1" vid="LAM 1:18">Ñkparawa ye ubọikpa mmi</para>
  <para style="q2" vid="LAM 1:18">ekaa asen idịd ekedʌk ufʌñ.<verse eid="LAM 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19" />“Ami mmaakoot mme ufan mmi,</para>
  <para style="q2" vid="LAM 1:19">ado ammọ emaembiaña miin.</para>
  <para style="q1" vid="LAM 1:19">Mme aku ye ñkpisọñ mmi</para>
  <para style="q2" vid="LAM 1:19">emaekpañña ke abio</para>
  <para style="q1" vid="LAM 1:19">ke ini ammọ ekeyemme ndidia</para>
  <para style="q2" vid="LAM 1:19">se edat edu uwem.<verse eid="LAM 1:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20" />“<char style="nd">Abọọñ</char>, se naña ukuud ammʌm miin!</para>
  <para style="q2" vid="LAM 1:20">Ami mba ke ndutʌhọ ke esịd idem mmi,</para>
  <para style="q1" vid="LAM 1:20">mmenyʌñ ñkop mfịna ke esịd mmi eti-eti,</para>
  <para style="q2" vid="LAM 1:20">sia ami ñkedo ataa awo nsọñiwuod.</para>
  <para style="q1" vid="LAM 1:20">Ke anwa, akañkañ asịn ntuaña;</para>
  <para style="q2" vid="LAM 1:20">ke esịd ufọk, ñkpa kpọd aba.<verse eid="LAM 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21" />“Mme awo emaekop eseeme mmi,</para>
  <para style="q2" vid="LAM 1:21">ado ibaaha awo se indọñ miin esịd.</para>
  <para style="q1" vid="LAM 1:21">Afịd mme asua mmi emaekop ebaña ukuud mmi;</para>
  <para style="q2" vid="LAM 1:21">ammọ edaara ebaña se afo anam.</para>
  <para style="q1" vid="LAM 1:21">Afo akpekap aben usen a-aketañña abaña adi,</para>
  <para style="q2" vid="LAM 1:21">nọ ammọ ekappa etie nte ami.<verse eid="LAM 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22" />“Yak afịd ndiọi ido ammọ adi ubịne fiin;</para>
  <para style="q2" vid="LAM 1:22">nam ye ammọ</para>
  <para style="q1" vid="LAM 1:22">naña afo akenam ye ami</para>
  <para style="q2" vid="LAM 1:22">ke ntak afịd ndiọiñkpọ mmi.</para>
  <para style="q1" vid="LAM 1:22">Mme mmịm mmi ewak</para>
  <para style="q2" vid="LAM 1:22">ndin esịd mmi akpa mba.”<verse eid="LAM 1:22" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1" />Kap se naña <char style="nd">Abọọñ</char> akefʌk Adiaha Saiyọn</para>
  <para style="q2" vid="LAM 2:1">ye ntọñ iyadesịd amọ!</para>
  <para style="q1" vid="LAM 2:1">Anye amaanwịn uku Isrel</para>
  <para style="q2" vid="LAM 2:1">ke anyọñ aduọọk ke isọñ;</para>
  <para style="q1" vid="LAM 2:1">anye ikitoiyoke udodukod amọ</para>
  <para style="q2" vid="LAM 2:1">ke usen iyadesịd amọ.<verse eid="LAM 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2" />Ke unana mbọm <char style="nd">Abọọñ</char> amaasobo</para>
  <para style="q2" vid="LAM 2:2">afịd mme itieidʌñ Yekọb;</para>
  <para style="q1" vid="LAM 2:2">ke ifiobesịd amọ anye amaawuut</para>
  <para style="q2" vid="LAM 2:2">mme ñkpọsọñ itie Adiaha Yuda abon.</para>
  <para style="q1" vid="LAM 2:2">Anye amaasuuhọ abio adidem ye nditọ ideen abọọñ amọ</para>
  <para style="q2" vid="LAM 2:2">adisịm isọñ ke asuenne.<verse eid="LAM 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3" />Ke ikañ-ikañ iyadesịd anye amaakpịkke</para>
  <para style="q2" vid="LAM 2:3">afịd nnʌk<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="ft" closed="false">me </char><char style="fq" closed="false">Nnʌk</char><char style="ft" closed="false">ada anọ adudu; se ñko ke Ese 2:17</char></note> Isrel asio.</para>
  <para style="q1" vid="LAM 2:3">Anye amaadʌt ubọk nnasia amọ asio</para>
  <para style="q2" vid="LAM 2:3">ke ini asañake akpere asua.</para>
  <para style="q1" vid="LAM 2:3">Anye amaasak ke Yekọb nte edemeikañ</para>
  <para style="q2" vid="LAM 2:3">a-ataaha afịd ñkpọ se ikpere anye.<verse eid="LAM 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4" />Anye a-adʌt utịgha amọ nte asua;</para>
  <para style="q2" vid="LAM 2:4">ubọk nnasia amọ aba ke mbeeñeidem.</para>
  <para style="q1" vid="LAM 2:4">Nte asua a-anye awotto</para>
  <para style="q2" vid="LAM 2:4">afịd mbon se anye anem esịd abaña;</para>
  <para style="q1" vid="LAM 2:4">anye amaanwañña iyadesịd amọ nte ikañ</para>
  <para style="q2" vid="LAM 2:4">afʌk ke atayad Adiaha Saiyọn.<verse eid="LAM 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5" />
    <char style="nd">Abọọñ</char> atie nte asua;</para>
  <para style="q2" vid="LAM 2:5">anye a-aben Isrel amen.</para>
  <para style="q1" vid="LAM 2:5">Anye a-amen afịd mme ufọk ubọọñ amọ</para>
  <para style="q2" vid="LAM 2:5">anyʌñ awuut mme ñkpọsọñ itie amọ.</para>
  <para style="q1" vid="LAM 2:5">Anye a-anam mfʌhọ ye eseeme atọt</para>
  <para style="q2" vid="LAM 2:5">anọ Adiaha Yuda.<verse eid="LAM 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6" />Anye a-anam itieidʌñ amọ akappa aba nte inwañ;</para>
  <para style="q2" vid="LAM 2:6">anye a-awuut itie mbono amọ.</para>
  <para style="q1" vid="LAM 2:6">
    <char style="nd">Abọọñ</char> anam Saiyọn afre</para>
  <para style="q2" vid="LAM 2:6">mme ndimek usọrọ amọ, mme usen Sabad amọ;</para>
  <para style="q1" vid="LAM 2:6">ke ikañ-ikañ iyadesịd amọ anye a-asịn</para>
  <para style="q2" vid="LAM 2:6">adidem ye aku.<verse eid="LAM 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7" />
    <char style="nd">Abọọñ</char> a-asịn akpokoro uwa amọ</para>
  <para style="q2" vid="LAM 2:7">anyʌñ awuọ akpọñ adisana itie amọ.</para>
  <para style="q1" vid="LAM 2:7">Anye a-aben mme ndibene akwere amọ</para>
  <para style="q2" vid="LAM 2:7">asịn asua amọ ke ubọk;</para>
  <para style="q1" vid="LAM 2:7">ammọ ebenne uyio ebọñ ñkpo ke ufọk <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="LAM 2:7">nte ke usen e-enamma adimek usọrọ.<verse eid="LAM 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8" />
    <char style="nd">Abọọñ</char> amaabiide adiwuut</para>
  <para style="q2" vid="LAM 2:8">ndibene a-akannake Adiaha Saiyọn akʌk.</para>
  <para style="q1" vid="LAM 2:8">Anye amaasio udʌk udomoñkpọ anyan</para>
  <para style="q2" vid="LAM 2:8">inyʌññọ imʌm ubọk amọ ke adisobo.</para>
  <para style="q1" vid="LAM 2:8">Anye amaanam mme akọ ye ndibene eseeme;</para>
  <para style="q2" vid="LAM 2:8">ammọ eyeeme atọ keed.<verse eid="LAM 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9" />Inuaatob amọ amaatịkke adʌk isọñ,</para>
  <para style="q2" vid="LAM 2:9">eto usịn usʌñ ammọ anye amaabʌñ anyʌñ asobo.</para>
  <para style="q1" vid="LAM 2:9">Adidem amọ ye nditọ ideen abọọñ amọ emaekaa asen idịd nte ifʌn,</para>
  <para style="q2" vid="LAM 2:9">mbed ibaaha aba,</para>
  <para style="q1" vid="LAM 2:9">mme prọfed amọ inyʌññọ ikịt</para>
  <para style="q2" vid="LAM 2:9">ñkukịd aba ito <char style="nd">Abọọñ</char>.<verse eid="LAM 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10" />Mme ñkpisọñ Adiaha Saiyọn</para>
  <para style="q2" vid="LAM 2:10">etie ke isọñ ke ndobuyio;</para>
  <para style="q1" vid="LAM 2:10">ammọ esiime ntọñ ke iwuod ammọ,</para>
  <para style="q2" vid="LAM 2:10">enyʌñ esịne afọñikpo.</para>
  <para style="q1" vid="LAM 2:10">Mme ubọikpa Yeruselem</para>
  <para style="q2" vid="LAM 2:10">esuuk iwuod ammọ ke isọñ.<verse eid="LAM 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11" />Anyen mmi akịm anọ utua ayịd,</para>
  <para style="q2" vid="LAM 2:11">ami mba ke akpọsọñ ukuud;</para>
  <para style="q1" vid="LAM 2:11">esịd mmi awuọ aduọkkọ ke isọñ,</para>
  <para style="q2" vid="LAM 2:11">sia esobo mbon mmi,</para>
  <para style="q1" vid="LAM 2:11">sia ntəkayịn ye mme nsek nditọ esʌkkọ</para>
  <para style="q2" vid="LAM 2:11">ke mme efaak ke abio.<verse eid="LAM 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12" />Ammọ ebo mme eka ammọ,</para>
  <para style="q2" vid="LAM 2:12">“Mmọ uyo ye ukọd?”</para>
  <para style="q1" vid="LAM 2:12">naña ammọ ekop mmemidem nte mbon edatta unan</para>
  <para style="q2" vid="LAM 2:12">ke mme efaak ke abio,</para>
  <para style="q1" vid="LAM 2:12">naña uwem ammọ asʌk aboiyo afep</para>
  <para style="q2" vid="LAM 2:12">ke ubọk mme eka ammọ.<verse eid="LAM 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13" />Nsoo ke ami mbo ntañ unọ fiin?</para>
  <para style="q2" vid="LAM 2:13">Nsoo ke ami mbo ndat ndomo ye afo,</para>
  <para style="q2" vid="LAM 2:13">Adiaha Yeruselem?</para>
  <para style="q1" vid="LAM 2:13">Nsoo ke ami mbo ndat ndomo ye afo,</para>
  <para style="q2" vid="LAM 2:13">nọ ami ñkeme adunọọ fiin idọñesịd</para>
  <para style="q2" vid="LAM 2:13">Abọikpa Saiyọn?</para>
  <para style="q1" vid="LAM 2:13">Unan mfo atəño nte akpainyañ.</para>
  <para style="q2" vid="LAM 2:13">Anie ikeme adukọk fiin?<verse eid="LAM 2:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14" />Mme ñkukịd mme prọfed mfo</para>
  <para style="q2" vid="LAM 2:14">ekedoñño nsu, inyʌññọ iwuọñọ ñkpọ;</para>
  <para style="q1" vid="LAM 2:14">ammọ ikiyaarake idiọọkñkpọ mfo</para>
  <para style="q2" vid="LAM 2:14">nọ etre aduben ñnyọñ ke ntañmfeb.</para>
  <para style="q1" vid="LAM 2:14">Mme ñkukịd se ammọ ekunọọ fiin</para>
  <para style="q2" vid="LAM 2:14">ekedoñño nsu, enyʌñ udat etịn usʌñ.<verse eid="LAM 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15" />Afịd mbon e-esañake eboiyo ke efaak mfo</para>
  <para style="q2" vid="LAM 2:15">unọ fiin ñnyọọ;</para>
  <para style="q1" vid="LAM 2:15">ammọ esaha enyʌñ enyeghe iwuod</para>
  <para style="q2" vid="LAM 2:15">ebaña Adiaha Yeruselem:</para>
  <para style="q1" vid="LAM 2:15">“Nte abio ekekoodo</para>
  <para style="q2" vid="LAM 2:15">ataa uyai,</para>
  <para style="q2" vid="LAM 2:15">inemesịd afịd ederimbod ado ami?”<verse eid="LAM 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16" />Afịd mme asua mfo enwañña inua ammọ</para>
  <para style="q2" vid="LAM 2:16">nọ atara ubaña fiin;</para>
  <para style="q1" vid="LAM 2:16">ammọ esaha enyʌñ ekwaaha eded ammọ,</para>
  <para style="q2" vid="LAM 2:16">enyʌñ ebo, “ñnyịn imiben anye afre imen.</para>
  <para style="q1" vid="LAM 2:16">Ami ado usen a-ñnyịn ikitieghe ibet;</para>
  <para style="q2" vid="LAM 2:16">ñnyịn imidu uwem ikịt anye.”<verse eid="LAM 2:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17" />
    <char style="nd">Abọọñ</char> anam se anye akeduak;</para>
  <para style="q2" vid="LAM 2:17">anye a-anam ikọ amọ asu,</para>
  <para style="q2" vid="LAM 2:17">a-anye aketañña ke anyan ini.</para>
  <para style="q1" vid="LAM 2:17">Anye utop fiin asio ituaha mbọm,</para>
  <para style="q2" vid="LAM 2:17">anye anam asua mfo adat esịd ubaña fiin,</para>
  <para style="q2" vid="LAM 2:17">anyʌñ adịppe nnʌk mme asua mfo.<verse eid="LAM 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18" />Esịd mbon awo</para>
  <para style="q2" vid="LAM 2:18">etua enọ <char style="nd">Abọọñ</char>.</para>
  <para style="q1" vid="LAM 2:18">Afo ndibene Adiaha Saiyọn,</para>
  <para style="q2" vid="LAM 2:18">yak mmọọñayịd mfo afiọrọ nte inyañ</para>
  <para style="q2" vid="LAM 2:18">ke uweemeayio ye akonayio;</para>
  <para style="q1" vid="LAM 2:18">kuunọọ idem mfo nduọkadudu,</para>
  <para style="q2" vid="LAM 2:18">kuuyak mmọọñayịd mfo atre.<verse eid="LAM 2:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19" />Dakka da, tua ayịd ke akonayio,</para>
  <para style="q2" vid="LAM 2:19">ke ini ukpeme akonayio amaatọọñọ,</para>
  <para style="q1" vid="LAM 2:19">nwañña esịd mfo nte mmọọñ</para>
  <para style="q2" vid="LAM 2:19">ke iso <char style="nd">Abọọñ</char>.</para>
  <para style="q1" vid="LAM 2:19">Benne ubọk mfo nọ anye</para>
  <para style="q2" vid="LAM 2:19">baña uwem nditọ mfo,</para>
  <para style="q1" vid="LAM 2:19">e-esʌkkọke ke ntak abiọọñ</para>
  <para style="q2" vid="LAM 2:19">ke afịd ibiọññọ efaak.<verse eid="LAM 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20" />“<char style="nd">Abọọñ</char>, se nyʌñ kere baña:</para>
  <para style="q2" vid="LAM 2:20">Anie ke afo anam ntom akpa?</para>
  <para style="q1" vid="LAM 2:20">Nte ibaan ana eta nditọ ammọ,</para>
  <para style="q2" vid="LAM 2:20">nditọ a-ammọ ebọọkọ?</para>
  <para style="q1" vid="LAM 2:20">Ana nte ewot aku ye prọfed</para>
  <para style="q2" vid="LAM 2:20">ke adisana itieukpono <char style="nd">Abọọñ</char>?<verse eid="LAM 2:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21" />“Ntəkayịn ye ñkaan awo enaa itie keed</para>
  <para style="q2" vid="LAM 2:21">ke ntọñ ke mme efaak;</para>
  <para style="q1" vid="LAM 2:21">ñkparawa ye ubọikpa mmi</para>
  <para style="q2" vid="LAM 2:21">emaekpañña ke akañkañ.</para>
  <para style="q1" vid="LAM 2:21">Afo amaawoot ammọ ke usen iyadesịd mfo;</para>
  <para style="q2" vid="LAM 2:21">amaawoot ammọ utuaha mbọm.<verse eid="LAM 2:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22" />“Naña afo akoot ke usen usọrọ,</para>
  <para style="q2" vid="LAM 2:22">kpa ntoro ke afo akoot ndịk annọ miin ke afịd usʌñ.</para>
  <para style="q1" vid="LAM 2:22">Ke usen iyadesịd <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="LAM 2:22">awo ndomokeed ikibọkkọke inyʌññọ idu uwem;</para>
  <para style="q1" vid="LAM 2:22">mbon a-ami ñkekamake ñnyʌñ mbọọk</para>
  <para style="q2" vid="LAM 2:22">asua mmi asobo.”<verse eid="LAM 2:22" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1" />Ami ndo awodeen a-akịtte ukuud</para>
  <para style="q2" vid="LAM 3:1">ato ke ikpa iyadesịd <char style="nd">Abọọñ</char>.<verse eid="LAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2" />Anye ambịne miin asio, anyʌñ anam ami nsaña</para>
  <para style="q2" vid="LAM 3:2">ke ekịm utu ke unwana;<verse eid="LAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3" />ke akpanikọ, anye amaakanna ubọk amọ amfʌnnọ miin</para>
  <para style="q2" vid="LAM 3:3">ndin-ndin, afịd usen.<verse eid="LAM 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4" />Anye a-anam ikpọkidem ye abʌkidem mmi ekaana</para>
  <para style="q2" vid="LAM 3:4">anyʌñ abʌñ mme akpọ mmi.<verse eid="LAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5" />Anye ammʌm miin, anyʌñ añkanna miin akʌk</para>
  <para style="q2" vid="LAM 3:5">ke idod ye akpọsọñ ufen.<verse eid="LAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6" />Anye anam ami ndʌñ ke ekịm</para>
  <para style="q2" vid="LAM 3:6">nte mbon ekekpaññake ke anyan ini.<verse eid="LAM 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7" />Anye a-abọp ndibene ansịn miin mbaak ami ndikan mbọkkọ;</para>
  <para style="q2" vid="LAM 3:7">anye a-amfiik miin anịm ye mme akpọnọ.<verse eid="LAM 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8" />Akpekọm ke ini ami ñkoodo me nseemeke ñyem unwam,</para>
  <para style="q2" vid="LAM 3:8">anye abet usʌñ abaha akam mmi.<verse eid="LAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9" />Anye a-afiọk usʌñ mmi ke mme eboho itiad;</para>
  <para style="q2" vid="LAM 3:9">anye a-anam usʌñ mmi akwaña.<verse eid="LAM 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10" />Kpa nte amọnikọd a-anaaha abet,</para>
  <para style="q2" vid="LAM 3:10">nte ekpe ke ndịbe<verse eid="LAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11" />anye amandʌt miin ke usʌñ anyʌñ antịm,</para>
  <para style="q2" vid="LAM 3:11">anyʌñ adakka añkpọñ miin, nnieghe unwam.<verse eid="LAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12" />Anye amaadʌt utịgha amọ,</para>
  <para style="q2" vid="LAM 3:12">anyʌñ añket miin ke mme idañ amọ.<verse eid="LAM 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13" />Anye amaakịm esịd mmi</para>
  <para style="q2" vid="LAM 3:13">ye mme idañ e-etooho ekpad idañ amọ.<verse eid="LAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14" />Ami mmekappa ndo ñkpọ nsaha nnọ afịd mbon mmi;</para>
  <para style="q2" vid="LAM 3:14">afịd usen ammọ ensak miin nsaha ke ikwọ.<verse eid="LAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15" />Anye a-añyʌkkọ miin ye idod-idod mfañ,</para>
  <para style="q2" vid="LAM 3:15">anyʌñ annọ miin atidod nọ ñnwọñ.<verse eid="LAM 3:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16" />Anye a-ambeek miin eded ke ñkwaitiad;</para>
  <para style="q2" vid="LAM 3:16">anye a-ansọnnọ miin anịm ke ntọñ.<verse eid="LAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17" />Emaembọ miin emem;</para>
  <para style="q2" vid="LAM 3:17">ami mmefre se uforo ado.<verse eid="LAM 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18" />Ke ntoro ami mbo, “Uku mmi ibaaha aba</para>
  <para style="q2" vid="LAM 3:18">ye afịd se ami ñkedot anyen nto <char style="nd">Abọọñ</char>.”<verse eid="LAM 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19" />Ami mmetoiyo ukuud mmi ye ndutịn mmi,</para>
  <para style="q2" vid="LAM 3:19">idod-idod ikọñ ye atidod.<verse eid="LAM 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20" />Ami mmenekke ntoiyo ammọ,</para>
  <para style="q2" vid="LAM 3:20">ndin ukpọñ mmi afʌhọ ke esịd idem mmi.<verse eid="LAM 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21" />Ado ami anam ami ntoiyo;</para>
  <para style="q2" vid="LAM 3:21">ke ntoro ami mmenie idodanyen.<verse eid="LAM 3:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22" />Ke ntak akwa ima <char style="nd">Abọọñ</char>, ñnyịn itakka</para>
  <para style="q2" vid="LAM 3:22">sia mbọm ammọ ikpuuho.<verse eid="LAM 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23" />Anye ado ufa afịd ubakusen;</para>
  <para style="q2" vid="LAM 3:23">mfọn mfo akpon eti-eti.<verse eid="LAM 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24" />Ami mbo ke idem mmi, “<char style="nd">Abọọñ</char> ado udeeme mmi;</para>
  <para style="q2" vid="LAM 3:24">ke ntoro ami ñyaabet anye.”<verse eid="LAM 3:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25" />
    <char style="nd">Abọọñ</char> afọn ye mbon e-edotto anyen ke anye,</para>
  <para style="q2" vid="LAM 3:25">anọ awo ayemme anye;<verse eid="LAM 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26" />afọn adidodop ntie mbet</para>
  <para style="q2" vid="LAM 3:26">adinyaaña <char style="nd">Abọọñ</char>.<verse eid="LAM 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27" />Afọn awo adiyọ ukuud</para>
  <para style="q2" vid="LAM 3:27">ke ini uyịn amọ.<verse eid="LAM 3:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28" />Yak anye atie ikpọọñ ke ndobuyio,</para>
  <para style="q2" vid="LAM 3:28">sia ado <char style="nd">Abọọñ</char> adot anye ke idem.<verse eid="LAM 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29" />Yak anye akʌp iso amọ ke ntọñ,</para>
  <para style="q2" vid="LAM 3:29">akeme ido idodanyen ayaaba.<verse eid="LAM 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30" />Yak anye ayaak mbañ amọ anọ awo ayemme adisiak anye ufia,</para>
  <para style="q2" vid="LAM 3:30">yak anye anyʌñ ayọhọ ye abuud.<verse eid="LAM 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31" />Sia <char style="nd">Abọọñ</char> iduọhọ awo ndomokeed</para>
  <para style="q2" vid="LAM 3:31">ke nsi-nsi.<verse eid="LAM 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32" />Akpesʌkado a-anye abenne mfʌhọ adi, anye ayaatua mbọm,</para>
  <para style="q2" vid="LAM 3:32">sia akwa ima amọ idiitreke.<verse eid="LAM 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33" />Sia anye ikoiyokoi iben ukuud</para>
  <para style="q2" vid="LAM 3:33">me mfʌhọ isọk awo ndomokeed.<verse eid="LAM 3:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34" />Adisọnnọ afịd mbon ñkpakọb ke ederimbod</para>
  <para style="q2" vid="LAM 3:34">ke idakikpad,<verse eid="LAM 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35" />adisịn adinọ mme awo unen ammọ</para>
  <para style="q2" vid="LAM 3:35">ke iso Andikoñ Ñkan Abasi,<verse eid="LAM 3:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36" />aditre adinọ ammọ unen;</para>
  <para style="q2" vid="LAM 3:36">nte <char style="nd">Abọọñ</char> idiikịtte utọ ñkpọ ado?<verse eid="LAM 3:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37" />Anie akeme aditañ ndin anye atịppe</para>
  <para style="q2" vid="LAM 3:37">adieke <char style="nd">Abọọñ</char> imiinịmme nte ewʌhọ.<verse eid="LAM 3:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38" />Nte itooho ke inua Andikoñ Ñkan Abasi</para>
  <para style="q2" vid="LAM 3:38">ke idiọọk ye nti ñkpọ eto ewuọ?<verse eid="LAM 3:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39" />Nsoo ido ntak a-mme aduuwem ekpeseemeke</para>
  <para style="q2" vid="LAM 3:39">ke ini emiaha ammọ ufen ke idiọọkñkpọ ammọ?<verse eid="LAM 3:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40" />Yak ñnyịn iduuñọ mme usʌñ ñnyịn inyʌñ idomo ammọ ise,</para>
  <para style="q2" vid="LAM 3:40">yak ñnyịn inyʌñ itịmme ikeene <char style="nd">Abọọñ</char>.<verse eid="LAM 3:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41" />Yak ñnyịn ibenne esịd ñnyịn ye ubọk ñnyịn</para>
  <para style="q2" vid="LAM 3:41">inọ Abasi ke anyọñ, inyʌñ ibo:<verse eid="LAM 3:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42" />“Ñnyịn iminam idiọọk inyʌñ isọñ iwuod</para>
  <para style="q2" vid="LAM 3:42">ndin afo ufeene.<verse eid="LAM 3:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43" />“Afo ameben iyadesịd afʌk idem mfo anyʌñ ibịne ñnyịn;</para>
  <para style="q2" vid="LAM 3:43">afo amewot utuaha mbọm.<verse eid="LAM 3:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44" />Afo ameben ntọñanyọñ afʌk idem mfo,</para>
  <para style="q2" vid="LAM 3:44">mbaak akam ndomokeed adiboiyo.<verse eid="LAM 3:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45" />Afo amenam ñnyịn ikappa ido ifịm ye mbio</para>
  <para style="q2" vid="LAM 3:45">ke atu mme idịd.<verse eid="LAM 3:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46" />“Afịd mme asua ñnyịn enwañña inua ammọ</para>
  <para style="q2" vid="LAM 3:46">enịm inwañ ibaña ñnyịn.<verse eid="LAM 3:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47" />Ñnyịn imibọ ufen ito akpọsọñ ndịk ye ndedịbe unọmọ,</para>
  <para style="q2" vid="LAM 3:47">ñwuudo ye nsobo.”<verse eid="LAM 3:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48" />Idịm mmọọñayịd awuọ ke anyen mmi,</para>
  <para style="q2" vid="LAM 3:48">sia esobo mbon mmi.<verse eid="LAM 3:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49" />Mmọọñayịd idiitreke adiwuọ ke anyen mmi,</para>
  <para style="q2" vid="LAM 3:49">adiisʌk ikaka iso iwuọ,<verse eid="LAM 3:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50" />tutu <char style="nd">Abọọñ</char> asuuk anyen ase</para>
  <para style="q2" vid="LAM 3:50">ke hefịn anyʌñ akịt.<verse eid="LAM 3:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51" />Se ami ñkịt a-aben mfʌhọ asọk ukpọñ mmi,</para>
  <para style="q2" vid="LAM 3:51">ke ntak afịd ibaan ke abio mmi.<verse eid="LAM 3:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52" />Mbon e-ekedooho mme asua mmi ke unana ntak</para>
  <para style="q2" vid="LAM 3:52">eduñbịnne miin nte inuen.<verse eid="LAM 3:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53" />Ammọ emaedomo ukeme adiñwot miin ke ube,</para>
  <para style="q2" vid="LAM 3:53">enyʌñ etoomo itiad entọọñ;<verse eid="LAM 3:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54" />mmọọñ amaatọ afʌk iwuod mmi,</para>
  <para style="q2" vid="LAM 3:54">ndin ami mmaakere ke ñyaatak.<verse eid="LAM 3:54" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55" />
    <char style="nd">Abọọñ</char>, ami ñkekoot anyịñ mfo,</para>
  <para style="q2" vid="LAM 3:55">ke ntotəño esịd ube.<verse eid="LAM 3:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56" />Afo amaakop ñkpeubọk mmi, “Kuusiit utọñ mfo</para>
  <para style="q2" vid="LAM 3:56">ubaha ntuaña mmi.”<verse eid="LAM 3:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57" />Afo amaasịkke akpere ke ini ami ñkukoodo fiin,</para>
  <para style="q2" vid="LAM 3:57">ndin afo amaabo, “Kuufeghe ndịk.”<verse eid="LAM 3:57" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58" />
    <char style="nd">Abọọñ</char>, afo akekpe ikpe mmi;</para>
  <para style="q2" vid="LAM 3:58">afo akefak uwem mmi.<verse eid="LAM 3:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59" />
    <char style="nd">Abọọñ</char>, afo amekịt idiọọk e-enamma ye ami.</para>
  <para style="q2" vid="LAM 3:59">Ben ikpe mmi kpe!<verse eid="LAM 3:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60" />Afo amekịt utọ usiene a-ammọ edinsioho miin,</para>
  <para style="q2" vid="LAM 3:60">afịd se ammọ eduak embaña miin.<verse eid="LAM 3:60" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61" />
    <char style="nd">Abọọñ</char>, afo amekop afịd mme usọñanyen ammọ,</para>
  <para style="q2" vid="LAM 3:61">afịd se ammọ eduak embaña miin,<verse eid="LAM 3:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62" />se mme asua mmi etañ ke adu enyʌñ edukuunọ</para>
  <para style="q2" vid="LAM 3:62">embaña miin afịd usen.<verse eid="LAM 3:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63" />Tat anyen mfo se ammọ! Ke etieghetie me ke edaahada,</para>
  <para style="q2" vid="LAM 3:63">ammọ ensak miin esaha ke ikwọ ammọ.<verse eid="LAM 3:63" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64" />
    <char style="nd">Abọọñ</char>, nọ ammọ utịb a-adotto ye ammọ,</para>
  <para style="q2" vid="LAM 3:64">ke se ubọk ammọ enam.<verse eid="LAM 3:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65" />Fʌk esịd ammọ ke ufʌkñkpọ,</para>
  <para style="q2" vid="LAM 3:65">ndin yak isuuñọ mfo adoro ammọ!<verse eid="LAM 3:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66" />Dat iyadesịd mfo bịne ammọ <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="LAM 3:66">nyʌñ sobo ammọ fep ke idak mme hefịn.<verse eid="LAM 3:66" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1" />Kase naña kold aduọọk uyai amọ,</para>
  <para style="q2" vid="LAM 4:1">uyaiya kold akpa anyen!</para>
  <para style="q1" vid="LAM 4:1">Emaesuan mme ndisana itiad,</para>
  <para style="q2" vid="LAM 4:1">ke afịd inuuk ke efaak.<verse eid="LAM 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2" />Adodie nọ ñkpọuto nditọ Saiyọn,</para>
  <para style="q2" vid="LAM 4:2">e-ekọmudua ammọ ekesidooho ke kold,</para>
  <para style="q1" vid="LAM 4:2">idahami edat ammọ nte abañ aduañ,</para>
  <para style="q2" vid="LAM 4:2">utom ubọk abodñkpọ!<verse eid="LAM 4:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3" />Kpa mme ewaikọd esisịññe eba</para>
  <para style="q2" vid="LAM 4:3">enọ nditọ ammọ,</para>
  <para style="q1" vid="LAM 4:3">ado ikọd mmi ekappa esọñ esịd,</para>
  <para style="q2" vid="LAM 4:3">nte mme ọstrik ke akpautatan.<verse eid="LAM 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4" />Ke ntak nsaditọñ, edeme nsekayịn</para>
  <para style="q2" vid="LAM 4:4">adiana ke nsịñ;</para>
  <para style="q1" vid="LAM 4:4">ntəkayịn ebeeñe uyo,</para>
  <para style="q2" vid="LAM 4:4">ado awo ndomokeed inọọhọ ammọ.<verse eid="LAM 4:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5" />Mbon e-ekesidiaha inem ndidia,</para>
  <para style="q2" vid="LAM 4:5">eyesaña ke efaak nte mbon unana.</para>
  <para style="q1" vid="LAM 4:5">Mbon e-ekebọọhọ ke ufọk ubọọñ</para>
  <para style="q2" vid="LAM 4:5">idahami ena ke eboho ntọñ.<verse eid="LAM 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6" />Ufen i-ikọd mmi ebọọhọ</para>
  <para style="q2" vid="LAM 4:6">a-akpon akan ake Sọdọm,</para>
  <para style="q1" vid="LAM 4:6">e-ekesoboke ini keed,</para>
  <para style="q2" vid="LAM 4:6">ndin ubọk ndomokeed ikinyaañake anye.<verse eid="LAM 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7" />Mme akpanabọọñ ammọ emaesaana ekan sino,</para>
  <para style="q2" vid="LAM 4:7">enyʌñ efia ekan mmọọñeba,</para>
  <para style="q1" vid="LAM 4:7">idem ammọ eyiibe ekan mme nsọñudua itiad,</para>
  <para style="q2" vid="LAM 4:7">mbid ammọ atie nte nsọñudua itiad a-asịneke bru ke esịd.<verse eid="LAM 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8" />Ado idahami ammọ ebre ekan ekịm ikañ;</para>
  <para style="q2" vid="LAM 4:8">awo idiọọñọke ammọ aba ke efaak.</para>
  <para style="q1" vid="LAM 4:8">Ikpaidem ammọ asaat adiana ammọ ke akpọ;</para>
  <para style="q2" vid="LAM 4:8">anye akappa asaat nte eto.<verse eid="LAM 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9" />A-afọn ye mbon e-ekewotto ke akañkañ</para>
  <para style="q2" vid="LAM 4:9">akan mbon e-ekpaññake ke ntak akañ;</para>
  <para style="q1" vid="LAM 4:9">abiọọñ akwaat ammọ, ammọ ekpañña</para>
  <para style="q2" vid="LAM 4:9">ke ntak unana ndidia a-atooho inwañ.<verse eid="LAM 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10" />Ibaan esịd mbọm edat ubọk ammọ</para>
  <para style="q2" vid="LAM 4:10">etem nditọ ammọ,</para>
  <para style="q1" vid="LAM 4:10">e-ekekappake edo ndidia enọ ammọ</para>
  <para style="q2" vid="LAM 4:10">ke ini ekesoboke ikọd mmi.<verse eid="LAM 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11" />
    <char style="nd">Abọọñ</char> anam ifiobesịd amọ ayọhọ;</para>
  <para style="q2" vid="LAM 4:11">anye anwañña ikañ-ikañ iyadesịd amọ.</para>
  <para style="q1" vid="LAM 4:11">Anye amaakịm ikañ asịn ke Saiyọn,</para>
  <para style="q2" vid="LAM 4:11">a-aketaaha tutu asịm mme idakisọñ amọ.<verse eid="LAM 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12" />Mme ndidem isọñ ikinịmme ke akpanikọ,</para>
  <para style="q2" vid="LAM 4:12">me mbonawo ke ederimbod ndomokeed,</para>
  <para style="q1" vid="LAM 4:12">ibo ke mme asua ye mbon utọk ekeme edidʌk</para>
  <para style="q2" vid="LAM 4:12">mme inuaatob Yeruselem.<verse eid="LAM 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13" />Ado ami amaatịppe ke ntak ndiọiñkpọ mme prọfed amọ,</para>
  <para style="q2" vid="LAM 4:13">ye ndiọi ido mme aku amọ,</para>
  <para style="q1" vid="LAM 4:13">e-eduọkkọ iyiib ndinen awo</para>
  <para style="q2" vid="LAM 4:13">ke esịd abio amọ.<verse eid="LAM 4:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14" />Idahami ammọ edutịn ke mme efaak,</para>
  <para style="q2" vid="LAM 4:14">nte ammọ edoñño nnan.</para>
  <para style="q1" vid="LAM 4:14">Ammọ esappa idem ammọ ye iyiib</para>
  <para style="q2" vid="LAM 4:14">a-anamma awo ndomokeed ikemeke adituuk afọñ ammọ.<verse eid="LAM 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15" />“Idakka mi! Ndufo edo ndedeghe!” Mme awo ebọñ ñkpo enọ ammọ.</para>
  <para style="q2" vid="LAM 4:15">“Idakka! Idakka! Ikiituuk ñnyịn!”</para>
  <para style="q1" vid="LAM 4:15">Ke ini ammọ efeeñeke enyʌñ edutịn,</para>
  <para style="q2" vid="LAM 4:15">mme awo ke mme idịd ebo,</para>
  <para style="q2" vid="LAM 4:15">“Ammọ ikemeke adidʌñ mi aba.”<verse eid="LAM 4:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16" />
    <char style="nd">Abọọñ</char> ke idem amọ amaasuan ammọ;</para>
  <para style="q2" vid="LAM 4:16">anye ikpemeke ammọ aba.</para>
  <para style="q1" vid="LAM 4:16">Mme aku inieghe ukpono aba,</para>
  <para style="q2" vid="LAM 4:16">mme ñkpisọñ inieghe mfọn.<verse eid="LAM 4:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17" />Afen ñko, anyen ñnyịn amaakịm,</para>
  <para style="q2" vid="LAM 4:17">ke ini iyemme mbon e-ekpinwamma ñnyịn;</para>
  <para style="q1" vid="LAM 4:17">ñnyịn ida ke anyọñ tọwa ise,</para>
  <para style="q2" vid="LAM 4:17">idịd i-imiikikanna inyaaña ñnyịn.<verse eid="LAM 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18" />Mme awo ekeene mbọn ikpad ñnyịn ibịne,</para>
  <para style="q2" vid="LAM 4:18">ndin ñnyịn ikikanna isaña ke mme efaak ñnyịn.</para>
  <para style="q1" vid="LAM 4:18">Utịd ñnyịn akpere, emaebat mme usen ñnyịn,</para>
  <para style="q2" vid="LAM 4:18">sia utịd ñnyịn amaadisịm.<verse eid="LAM 4:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19" />Mbon se ibịne ñnyịn emaesọp</para>
  <para style="q2" vid="LAM 4:19">ekan ntrukpuum ke anyọñ;</para>
  <para style="q1" vid="LAM 4:19">ammọ emaibịne ñnyịn edọọk ke mme ikpọabod</para>
  <para style="q2" vid="LAM 4:19">enyʌñ edịbe ke akpautatan ibet ñnyịn.<verse eid="LAM 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20" />Emaemʌm anye <char style="nd">A-Abọọñ</char> akeyette adan, kpa ibifịk uwem ñnyịn,</para>
  <para style="q2" vid="LAM 4:20">ke mme afia ammọ.</para>
  <para style="q1" vid="LAM 4:20">Ñnyịn ikikere ibo ke idak mfuud amọ,</para>
  <para style="q2" vid="LAM 4:20">ñnyịn iyaidu uwem ke atu mme idịd.<verse eid="LAM 4:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21" />Nem esịd nyʌñ daara, Adiaha Edọm,</para>
  <para style="q2" vid="LAM 4:21">afo a-adʌññọ ke isọñ Us.</para>
  <para style="q1" vid="LAM 4:21">Ado eyaenyʌñ eben kọọb ado unọ fiin ñko;</para>
  <para style="q2" vid="LAM 4:21">afo ayaanwọñ anye unaam, ndin utat afọñ esuuk ifed.<verse eid="LAM 4:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22" />Adiaha Saiyọn, ufen mfo ayaatre;</para>
  <para style="q2" vid="LAM 4:22">anye idiinamma ntañmfeb mfo akpeene.</para>
  <para style="q1" vid="LAM 4:22">Adiaha Edọm, ado anye ayaamia idiọọkñkpọ mfo ufen,</para>
  <para style="q2" vid="LAM 4:22">anyʌñ ayaara ibak mfo anwa-anwa.<verse eid="LAM 4:22" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1" />
    <char style="nd">Abọọñ</char>, toiyo, se ikitịppe inọọ ñnyịn;</para>
  <para style="q2" vid="LAM 5:1">nekke se, nyʌñ kịt asuenne ñnyịn.<verse eid="LAM 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2" />E-ekappa udeeme ñnyịn eyaak enọ mme isenawo,</para>
  <para style="q2" vid="LAM 5:2">e-enọ mbon asen idịd mme ufọk idʌñ ñnyịn.<verse eid="LAM 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3" />Ñnyịn imikappa idoñño nditọakpa,</para>
  <para style="q2" vid="LAM 5:3">mme eka ñnyịn edoñño mme ebekpa.<verse eid="LAM 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4" />Ana ñnyịn idep mmọọñ a-ñnyịn inwọññọ;</para>
  <para style="q2" vid="LAM 5:4">ekeme adinie ifia ñnyịn ke ekọmudua kpọd.<verse eid="LAM 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5" />Mbon i-ibịneke ñnyịn imʌm ñnyịn ke itịghitịghi;</para>
  <para style="q2" vid="LAM 5:5">ñnyịn imikpa mba inyʌññọ inie nduọkadudu.<verse eid="LAM 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6" />Ñnyịn imaisuuk iwuod inọ Iyib ye Asiria</para>
  <para style="q2" vid="LAM 5:6">nọ inie uyo se ikem ñnyịn.<verse eid="LAM 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7" />Mme eteete ñnyịn e-ekenamma idiọọkñkpọ ibaaha aba,</para>
  <para style="q2" vid="LAM 5:7">ndin ñnyịn ibọ ufen ammọ.<verse eid="LAM 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8" />Mme ifʌn eyikaara ñnyịn,</para>
  <para style="q2" vid="LAM 5:8">ndin ibaaha awo se inyaaña ñnyịn isio ke ubọk ammọ.<verse eid="LAM 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9" />Ñnyịn ikereke ibaña uwem ñnyịn, nọ inie uyo</para>
  <para style="q2" vid="LAM 5:9">ke ntak akañkañ abaaha ke akpautatan.<verse eid="LAM 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10" />Ikpaidem ñnyịn afiop nte ebohoikañ,</para>
  <para style="q2" vid="LAM 5:10">ufiobidem i-imʌm ñnyịn akeene abiọọñ.<verse eid="LAM 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11" />Emaesappa ibaan ke Saiyọn,</para>
  <para style="q2" vid="LAM 5:11">ye ñkpʌk ibaan ke mme abio Yuda.<verse eid="LAM 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12" />E-ebọp mme akpanabọọñ ubọk eyịt ke anyọñ;</para>
  <para style="q2" vid="LAM 5:12">awo ikponoke mme ñkpisọñ.<verse eid="LAM 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13" />Ñkparawa e-ebọ ufen ke afe ukọkñkpọ;</para>
  <para style="q2" vid="LAM 5:13">nditọ ideen eduọññọ anọ udob ifia.<verse eid="LAM 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14" />Mme ñkpisọñ ibaaha aba ke inuaatob abio;</para>
  <para style="q2" vid="LAM 5:14">ñkparawa etre mbiiñe ammọ.<verse eid="LAM 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15" />Idaara awuọ akpọñ esịd ñnyịn;</para>
  <para style="q2" vid="LAM 5:15">unek ñnyịn akappa ado mfʌhọ.<verse eid="LAM 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16" />Anyanya ayaara ke iwuod ñnyịn aduọ.</para>
  <para style="q2" vid="LAM 5:16">Adọdiọọk inọ ñnyịn, sia ñnyịn iminam idiọọkñkpọ!<verse eid="LAM 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17" />Ke ntak ami esịd ñnyịn akpa mba,</para>
  <para style="q2" vid="LAM 5:17">ke ntak mme ñkpọ ami anyen ikịm ñnyịn,<verse eid="LAM 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18" />ke ntak Abod Saiyọn, a-anaaha ke nsobo,</para>
  <para style="q2" vid="LAM 5:18">mme ewaikọd esaña ke anyọñ amọ.<verse eid="LAM 5:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19" />Afo, <char style="nd">Abọọñ</char>, akara ke nsi-nsi;</para>
  <para style="q2" vid="LAM 5:19">ebekpo mfo asọọñọ ada ke afịd emana.<verse eid="LAM 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20" />Nsoo inam afo asʌk asifre ñnyịn anyen?</para>
  <para style="q2" vid="LAM 5:20">Nsoo inam afo isịn ñnyịn nọ akpeene ntom?<verse eid="LAM 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21" />
    <char style="nd">Abọọñ</char>, dat ñnyịn tịmme nọ idem mfo, yak ñnyịn idiitịmme inyọñọ;</para>
  <para style="q2" vid="LAM 5:21">nam mme usen ñnyịn ekappa edo ufa naña akedo ke esed,<verse eid="LAM 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22" />ibọhọke afo amaitop ñnyịn aduọọk afịd-afịd,</para>
  <para style="q2" vid="LAM 5:22">a-anyʌñ ayat esịd ye ñnyịn abọhọ adaña.<verse eid="LAM 5:22" /></para>
  <chapter eid="LAM 5" />
</usx>