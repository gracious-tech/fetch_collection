  <para style="h">Aisaiya</para>
  <para style="toc1">Aisaiya</para>
  <para style="toc2">Aisaiya</para>
  <para style="toc3">Aisa</para>
  <para style="mt1">Aisaiya</para>
  <chapter number="1" style="c" sid="ISA 1" />
  <para style="p">
    <verse number="1" style="v" sid="ISA 1:1" />Ñkukịd a-abañake Yuda ye Yeruselem ake Aisaiya ayịn Emọs akekịtte ke ini ukara Usaiya, Yọtam, Ahas ye Hesikaiya, mme ndidem ke Yuda.<verse eid="ISA 1:1" /></para>
  <para style="b" />
  <para style="s1">Idịd Nsọñiwuod</para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 1:2" />Iñkop miin, ndufo mme hefịn! Unadod, ikpañ utọñ!</para>
  <para style="q2" vid="ISA 1:2">Sia Abọọñ atañ ikọ:</para>
  <para style="q1" vid="ISA 1:2">“Ami ñkebọọk nditọ ñnyʌñ ñkama ammọ,</para>
  <para style="q2" vid="ISA 1:2">ado ammọ ekappa esọñ iwuod ye ami.<verse eid="ISA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 1:3" />Ekamba ayaaraenañ adiọọñọ eteufọk amọ,</para>
  <para style="q2" vid="ISA 1:3">dọñki adiọọñọ itie usịnudia ufene andinie anye,</para>
  <para style="q1" vid="ISA 1:3">ado Isrel idiọọñọke,</para>
  <para style="q2" vid="ISA 1:3">inwañake mbon mmi.”<verse eid="ISA 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 1:4" />Adọdiọọk anọ idịd idiọọkñkpọ,</para>
  <para style="q2" vid="ISA 1:4">mbon i-idiọọkñkpọ ammọ akponno,</para>
  <para style="q1" vid="ISA 1:4">eboho mme anamidiọọk,</para>
  <para style="q2" vid="ISA 1:4">nditọ e-emaekeyaak enọ mbiara!</para>
  <para style="q1" vid="ISA 1:4">Ammọ etịmme ekpọñ <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="ISA 1:4">ammọ esịn Adisana Abasi Isrel ke ndek</para>
  <para style="q2" vid="ISA 1:4">enyʌñ ekanna edem ammọ ewọt anye.<verse eid="ISA 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 1:5" />Ntak ekpesʌkkọ ekaiso umia fiin-e?</para>
  <para style="q2" vid="ISA 1:5">Nsoo inam asʌk akaiso ke nsọñiwuod?</para>
  <para style="q1" vid="ISA 1:5">Afịd iwuod mfo anieñe unan,</para>
  <para style="q2" vid="ISA 1:5">afịd esịd mfo anieñe unọmọ.<verse eid="ISA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 1:6" />Atọọñọ ke esịd ekaikpad mfo tutu asịm atịñ iwuod mfo</para>
  <para style="q2" vid="ISA 1:6">nsọñidem ibaaha,</para>
  <para style="q1" vid="ISA 1:6">sʌk mme unan ye mbọnikpa ikpọọñ</para>
  <para style="q2" vid="ISA 1:6">ye mme anainwañ inia ebañña,</para>
  <para style="q1" vid="ISA 1:6">a-awo imiikwokkoke imiinyʌññọ ibọp ke afọñ</para>
  <para style="q2" vid="ISA 1:6">me adikama adan ọlif nsọbọ.<verse eid="ISA 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 1:7" />Idịd mfo awuudo,</para>
  <para style="q2" vid="ISA 1:7">ikañ amaata mme abio mfo;</para>
  <para style="q1" vid="ISA 1:7">mme isenawo enịm inwañ mfo anaan</para>
  <para style="q2" vid="ISA 1:7">ke iso mfo, enam ado ñwuudo nte naña mme isenawo ekpekan ubọk ebọ.<verse eid="ISA 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 1:8" />E-edakka ekpọñ adiaha Saiyọn</para>
  <para style="q2" vid="ISA 1:8">nte idak mfuudo ke inwañ fain,</para>
  <para style="q1" vid="ISA 1:8">nte atayad ke inwañ kukumba,</para>
  <para style="q2" vid="ISA 1:8">nte abio se iduọ ke ubọk ndiọi awo.<verse eid="ISA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 1:9" />Imiikpidooho <char style="nd">Abọọñ</char> Andikponñkan</para>
  <para style="q2" vid="ISA 1:9">akeyaak nsʌhọ ubon anịm inọọ ñnyịn,</para>
  <para style="q1" vid="ISA 1:9">ñnyịn ikpikiba nte Sọdọm,</para>
  <para style="q2" vid="ISA 1:9">ñnyịn ikpikiba nte Komora.<verse eid="ISA 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 1:10" />Ikop ikọ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 1:10">ndufo mme andikara Sọdọm;</para>
  <para style="q1" vid="ISA 1:10">ikpañ utọñ ikop item Abasi,</para>
  <para style="q2" vid="ISA 1:10">ndufo mbon Komora!<verse eid="ISA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 1:11" />“Mme uwak uwa ndufo,</para>
  <para style="q2" vid="ISA 1:11">nsoo ke ammọ edo ennọọ miin?”</para>
  <para style="q2" vid="ISA 1:11">
    <char style="nd">Abọọñ</char> atañ.</para>
  <para style="q1" vid="ISA 1:11">Ami mmenie ufọfọb uwa e-ewakka ekem,</para>
  <para style="q2" vid="ISA 1:11">ake akukịmedọñ ye akpọñ ukọkʌk unam e-enieghe isek;</para>
  <para style="q1" vid="ISA 1:11">Ami ñkoppo inemesịd</para>
  <para style="q2" vid="ISA 1:11">ke iyiib ñyaaraenañ ye mme ñyịn edọñ ye mme ebod.<verse eid="ISA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 1:12" />Ndufo emaedi ke iso mmi,</para>
  <para style="q2" vid="ISA 1:12">anie iyem ñkpọ ami ito ndufo,</para>
  <para style="q2" vid="ISA 1:12">mme ndutịme ami ke mme esob mmi?<verse eid="ISA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 1:13" />Itre adiben mme enọ i-imiiwuọhọ idi!</para>
  <para style="q2" vid="ISA 1:13">Insensi ndufo ado mbubiam ke iso mmi.</para>
  <para style="q1" vid="ISA 1:13">Mme Ufa Afiọñ, mme Sabad ye mme Mbono.</para>
  <para style="q2" vid="ISA 1:13">Ami ñkanna ñyọ mme mboho ndufo i-imiifọnnọ usʌñ.<verse eid="ISA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 1:14" />Mme usọrọ Ufa Afiọñ ndufo ye mme ini usọrọ e-emekke enịm</para>
  <para style="q2" vid="ISA 1:14">ami mmesua ammọ ke afịd uwem mmi.</para>
  <para style="q1" vid="ISA 1:14">Ammọ e-ekappa edo mbiomo ennọ miin;</para>
  <para style="q2" vid="ISA 1:14">Ami mmekpa mba adibiom ammọ.<verse eid="ISA 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 1:15" />Ndufo emaetat ubọk ebọñ akam,</para>
  <para style="q2" vid="ISA 1:15">ami ndịp anyen mmi ibaha ndufo;</para>
  <para style="q1" vid="ISA 1:15">akọm ebọñ uwak akam,</para>
  <para style="q2" vid="ISA 1:15">ami ñkpañña utọñ.</para>
  <para style="b" vid="ISA 1:15" />
  <para style="q1" vid="ISA 1:15">Ubọk ndufo ayọhọ ye iyiib!<verse eid="ISA 1:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 1:16" />Iyie inyʌñ inam idem ndufo asana.</para>
  <para style="q2" vid="ISA 1:16">Iben ndiọi adinam ndufo insio miin ke iso;</para>
  <para style="q2" vid="ISA 1:16">itre adinam se idiọọk.<verse eid="ISA 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 1:17" />Ikpeep adinam eti; iyem unen.</para>
  <para style="q2" vid="ISA 1:17">Ibọọrọ ikọ inọ mbon se efiik.</para>
  <para style="q1" vid="ISA 1:17">Ibere ye nditọakpa;</para>
  <para style="q2" vid="ISA 1:17">ibere ye mme ebekpa ke ikpe.<verse eid="ISA 1:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 1:18" />“Idi idahami, yak ñnyịn ikpe ikọ ami ibiere,”</para>
  <para style="q2" vid="ISA 1:18">
    <char style="nd">Abọọñ</char> atañ.</para>
  <para style="q1" vid="ISA 1:18">“Akpekọm ndiọiñkpọ ndufo ekpeba nte iduod,</para>
  <para style="q2" vid="ISA 1:18">ammọ eyaesana nte sino;</para>
  <para style="q1" vid="ISA 1:18">akpekọm ammọ ekpeyiibe nte anya,</para>
  <para style="q2" vid="ISA 1:18">ammọ eyaeba nte idededọñ.<verse eid="ISA 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 1:19" />Adieke ndufo enyịmmeke enyʌñ ekop item,</para>
  <para style="q2" vid="ISA 1:19">ndufo eyaedia mme nti ñkpọ ke isọñ;<verse eid="ISA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 1:20" />ado adieke ndufo esịnne enyʌñ esọñ iwuod,</para>
  <para style="q2" vid="ISA 1:20">akañkañ ayaisobo ndufo.”</para>
  <para style="q1" vid="ISA 1:20">Inua <char style="nd">Abọọñ</char> atañ.<verse eid="ISA 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 1:21" />Se naña abio akpanikọ</para>
  <para style="q2" vid="ISA 1:21">akappa ado akpara!</para>
  <para style="q1" vid="ISA 1:21">Ini keed anye akeyọhọ ye unen;</para>
  <para style="q2" vid="ISA 1:21">adinenido amaasidʌñ ke anye,</para>
  <para style="q2" vid="ISA 1:21">ado idahami mme awodawo eyedʌñọ!<verse eid="ISA 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 1:22" />Mme silfa ndufo ekappa ñkpọ ñkarafañ,</para>
  <para style="q2" vid="ISA 1:22">ewaak mmọọñ ke nti ukọd ndufo.<verse eid="ISA 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 1:23" />Mme adaukara ndufo edo mbon nsọñiwuod;</para>
  <para style="q2" vid="ISA 1:23">edo nsaña mbon inọ;</para>
  <para style="q1" vid="ISA 1:23">afịd ammọ ema ubọkedem</para>
  <para style="q2" vid="ISA 1:23">enyʌñ efeghe ebịne mme enọ.</para>
  <para style="q1" vid="ISA 1:23">Ammọ ikpemeke unen nditọakpa;</para>
  <para style="q2" vid="ISA 1:23">ikpe mme ebekpa inyʌññọ idi ke iso ammọ.<verse eid="ISA 1:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="ISA 1:24" />Ke ntoro Abọọñ, <char style="nd">Abọọñ</char> Andikponñkan,</para>
  <para style="q2" vid="ISA 1:24">Akpọsọñ Abasi Isrel, anọ uyio:</para>
  <para style="q1" vid="ISA 1:24">“Sai! Ami ñyaanwañña iyadesịd mmi ndot mme asua mmi</para>
  <para style="q2" vid="ISA 1:24">ñnyʌñ nsio usiene ke iwuod mme asua mmi.<verse eid="ISA 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 1:25" />Ami ñyaakanna ubọk mmi inʌmọ ndufo<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="ft" closed="false">Etañ ebaña Yeruselem</char></note>;</para>
  <para style="q2" vid="ISA 1:25">Ami ñyaanyʌñ ñyet ñkarafañ ndufo ndaara nsio afịd-afịd</para>
  <para style="q2" vid="ISA 1:25">ñnyʌñ nsio afịd mme ndek ndufo.<verse eid="ISA 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 1:26" />Ami ñyaamaana ndịppe mbọọñ ndufo ndot naña akesiba ke mme usen edem,</para>
  <para style="q2" vid="ISA 1:26">mme adaukara ndufo nte naña akesiba ke ntọọñọ.</para>
  <para style="q1" vid="ISA 1:26">Amaakweeñe ke ado eyaikoot ndufo</para>
  <para style="q2" vid="ISA 1:26">Abio Adinenido,</para>
  <para style="q2" vid="ISA 1:26">Abio Akpanikọ.”<verse eid="ISA 1:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="ISA 1:27" />Eyaefak Saiyọn ke unen,</para>
  <para style="q2" vid="ISA 1:27">mme atua ñkpọfiọk ke atu amọ ye adinenido.<verse eid="ISA 1:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 1:28" />Ado eyaebʌñ mbon nsọñiwuod ye mme anamidiọọk,</para>
  <para style="q2" vid="ISA 1:28">ñko mbon esịnne <char style="nd">Abọọñ</char> eyaesobo.<verse eid="ISA 1:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="ISA 1:29" />“Abuud ayaimʌm ndufo abaña mme ndisana ikpọ afriyo</para>
  <para style="q2" vid="ISA 1:29">a-ndufo enemme esịd ebaña;</para>
  <para style="q1" vid="ISA 1:29">ndufo eyaedia abuud ebaña mme inwañ</para>
  <para style="q2" vid="ISA 1:29">a-ndufo emekke.<verse eid="ISA 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 1:30" />Ndufo eyaeba nte ekamba afriyo ye ñyeeme mfañ,</para>
  <para style="q2" vid="ISA 1:30">nte inwañ a-mmọọñ imiibaaha.<verse eid="ISA 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 1:31" />Uko awodeen adiibit ikañ emuum</para>
  <para style="q2" vid="ISA 1:31">utom amọ nte ndubekikañ;</para>
  <para style="q1" vid="ISA 1:31">naña iba ediisak keed,</para>
  <para style="q2" vid="ISA 1:31">ndin awo ndomokeed idiikanna inịme ikañ ado.”<verse eid="ISA 1:31" /></para>
  <chapter eid="ISA 1" />
  <chapter number="2" style="c" sid="ISA 2" />
  <para style="s1">Abod <char style="nd">Abọọñ</char></para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 2:1" />Anyem ado se Aisaiya ayịn Emọs akekịt abaña Yuda ye Yeruselem:<verse eid="ISA 2:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="ISA 2:2" />Ke mme akpatre usen</para>
  <para style="q1" vid="ISA 2:2">eyaenam abod tembịd <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ISA 2:2">akoñ akan afịd mme ñkpoon abod;</para>
  <para style="q1" vid="ISA 2:2">eyaedịppe anye yak akoñ akan mme ntək abod,</para>
  <para style="q2" vid="ISA 2:2">ndin afịd mme idịd eyaeyịre udịm ekaa do.<verse eid="ISA 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 2:3" />Uwak mbon awo eyaedi enyʌñ ebo,</para>
  <para style="q1" vid="ISA 2:3">“Idi, yak ñnyịn idọọk ika ekamba abod <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 2:3">ika tembịd Abasi Yekọb.</para>
  <para style="q1" vid="ISA 2:3">Anye ayaikpeep ñnyịn mme usʌñ amọ,</para>
  <para style="q2" vid="ISA 2:3">nọ ato do ñnyịn isaña ke mme usʌñ amọ.”</para>
  <para style="q1" vid="ISA 2:3">Mbed ayaato Saiyọn awuọ,</para>
  <para style="q2" vid="ISA 2:3">ikọ <char style="nd">Abọọñ</char> ayaawuọ ato Yeruselem.<verse eid="ISA 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 2:4" />Anye ayaakpe ikpe anọ mme idịd</para>
  <para style="q2" vid="ISA 2:4">anyʌñ anam emem ke atu uwak mbon awo.</para>
  <para style="q1" vid="ISA 2:4">Ammọ eyaemia mme akañkañ ammọ yak ekappa ñkpọ ukịmisọñ</para>
  <para style="q2" vid="ISA 2:4">ñkọ mme eduad ammọ yak ekappa ekọb ukọñkpọ.</para>
  <para style="q1" vid="ISA 2:4">Mme idịd idiibenne akañkañ ibịne emọ-emọ idịd,</para>
  <para style="q2" vid="ISA 2:4">ammọ idiinyʌññọ ibọ ukpeeb ke unwana ekọñ aba.<verse eid="ISA 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 2:5" />Idi, mbon ubon Yekọb,</para>
  <para style="q2" vid="ISA 2:5">yak ñnyịn isaña ke unwana <char style="nd">Abọọñ</char>.<verse eid="ISA 2:5" /></para>
  <para style="s1">Usen <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 2:6" />Afo, <char style="nd">Abọọñ</char>, amekpọñ mbon mfo,</para>
  <para style="q2" vid="ISA 2:6">mbon ubon Yekọb.</para>
  <para style="q1" vid="ISA 2:6">Ammọ eyọhọ ke adinịm mme ukpono edem Usakkautịn;</para>
  <para style="q2" vid="ISA 2:6">ammọ ekpeep ubre idiọñ nte mbon Filistia,</para>
  <para style="q2" vid="ISA 2:6">enyʌñ enyịmme mme ubonoñkpọ ye mme edu unaññañkpọ mbon ukpono ndem.<verse eid="ISA 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 2:7" />Isọñ ammọ ayọhọ ye silfa ye kold;</para>
  <para style="q2" vid="ISA 2:7">inie ammọ inieghe utịd.</para>
  <para style="q1" vid="ISA 2:7">Isọñ ammọ ayọhọ ye mme enañmbakara;</para>
  <para style="q2" vid="ISA 2:7">mme sariọd ammọ inieghe utịd.<verse eid="ISA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 2:8" />Isọñ ammọ ayọhọ ye ntək ubobod abasi;</para>
  <para style="q2" vid="ISA 2:8">ammọ enyuuk iwuod enọ se ubọk ammọ enam,</para>
  <para style="q2" vid="ISA 2:8">se mme nnuunubọk ammọ enam.<verse eid="ISA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 2:9" />Nọ esuuho mbon awo itie,</para>
  <para style="q2" vid="ISA 2:9">enyʌñ enam afịd awo enie nsuukidem,</para>
  <para style="q2" vid="ISA 2:9">kuudakka unọọ ammọ.<verse eid="ISA 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 2:10" />Kedʌk ke mme itiad, dịbe ke isọñ,</para>
  <para style="q2" vid="ISA 2:10">kpọñ ndịk iso <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ISA 2:10">ye uku ubọọñ amọ!<verse eid="ISA 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 2:11" />Eyaesuuhọ anyen mbon ñkokkoidem</para>
  <para style="q2" vid="ISA 2:11">enyʌñ esuuhọ ntañidem uduud awo;</para>
  <para style="q1" vid="ISA 2:11">
    <char style="nd">Abọọñ</char> ikpọọñ ke ediidịppe ke usen ado.<verse eid="ISA 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 2:12" />
    <char style="nd">Abọọñ</char> Andikponñkan anịm usen anọ</para>
  <para style="q2" vid="ISA 2:12">afịd mbon ntañidem ye ñkoñ-ñkoñ idaha,</para>
  <para style="q1" vid="ISA 2:12">afịd mbon se idịppe idem</para>
  <para style="q2" vid="ISA 2:12">(ndin eyaesuuhọ ammọ),<verse eid="ISA 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 2:13" />afịd mme eto sida Lebanọn, ñnyan ye ñkoñ-ñkoñ idaha,</para>
  <para style="q2" vid="ISA 2:13">ye afịd mme afriyo Basan,<verse eid="ISA 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 2:14" />afịd mme ñkoñ-ñkoñ ikpọabod</para>
  <para style="q2" vid="ISA 2:14">ye afịd mme ñkoñ-ñkoñ ntək abod,<verse eid="ISA 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 2:15" />afịd ñkoñ-ñkoñ idaha tọwa</para>
  <para style="q2" vid="ISA 2:15">ye ñkpọsọñ ndibene,<verse eid="ISA 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 2:16" />afịd mme nsʌñikañ unyam udua ake Taasis</para>
  <para style="q2" vid="ISA 2:16">ye afịd nsʌñikañ se inie uku.<verse eid="ISA 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 2:17" />Eyaesuuhọ ñkokkoidem ubon awo,</para>
  <para style="q2" vid="ISA 2:17">enyʌñ esuuhọ ntañidem mbon awo;</para>
  <para style="q1" vid="ISA 2:17">
    <char style="nd">Abọọñ</char> ikpọọñ ke ediidịppe ke usen ado,<verse eid="ISA 2:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ISA 2:18" />mme ubobod abasi eyaefeeñe esoomo.<verse eid="ISA 2:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="ISA 2:19" />Mme awo eyaefeeñe edịbe ke mme abaitiad</para>
  <para style="q2" vid="ISA 2:19">ye mme ndudu ke isọñ,</para>
  <para style="q1" vid="ISA 2:19">ekpọñ aniendịk iso <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ISA 2:19">ye uku ubọọñ amọ,</para>
  <para style="q2" vid="ISA 2:19">ke anye amaadakka ada adinyeeñe unadod.<verse eid="ISA 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 2:20" />Ke usen ado mme awo eyaetoomo</para>
  <para style="q2" vid="ISA 2:20">mme ubobod abasi silfa ye mme ntək ubobod abasi kold</para>
  <para style="q1" vid="ISA 2:20">a-ammọ ekenamma ekama ekpono,</para>
  <para style="q2" vid="ISA 2:20">enọ mme ayood ye mme ñkpekpem.<verse eid="ISA 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 2:21" />Ammọ eyaefeeñe edọñọ mme abaitiad</para>
  <para style="q2" vid="ISA 2:21">ye mme ufañ itiad e-ekọñọkekọñọ</para>
  <para style="q1" vid="ISA 2:21">ekpọñ aniendịk iso <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ISA 2:21">ye uku ubọọñ amọ,</para>
  <para style="q2" vid="ISA 2:21">ke ini anye amaadakka adinyeeñe ekondo.<verse eid="ISA 2:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 2:22" />Tre adinie idodanyen ke ñkaña ubon awo,</para>
  <para style="q2" vid="ISA 2:22">e-enieghe ibifịk kpọd ke aduiwuo ammọ.</para>
  <para style="q2" vid="ISA 2:22">Nsoo inam anọ ammọ ekamba ukpono?<verse eid="ISA 2:22" /></para>
  <chapter eid="ISA 2" />
  <chapter number="3" style="c" sid="ISA 3" />
  <para style="s1">Ubiereikpe Nnọọ Yeruselem ye Yuda</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 3:1" />Se idahami, Abọọñ,</para>
  <para style="q2" vid="ISA 3:1">
    <char style="nd">Abọọñ</char> Andikponñkan</para>
  <para style="q1" vid="ISA 3:1">ayem adibọ Yeruselem ye Yuda</para>
  <para style="q2" vid="ISA 3:1">enọ ye unwam amọ:</para>
  <para style="q1" vid="ISA 3:1">afịd enọ ndidia ye afịd enọ mmọọñ,<verse eid="ISA 3:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="ISA 3:2" />mme ñkpọsọñ ye mbon ekọñ,</para>
  <para style="q1" vid="ISA 3:2">abiideikpe ye prọfed</para>
  <para style="q2" vid="ISA 3:2">abiaidiọñ ye ñkpisọñ,<verse eid="ISA 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 3:3" />etubom awo aba mme duob ye adaaha,</para>
  <para style="q2" vid="ISA 3:3">anọitem, adiọọñọ ñkpọ ke utomusọ ye ata abiamfa.<verse eid="ISA 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 3:4" />“Ami ñyaanam mme iwaad edo mme adaaha ammọ;</para>
  <para style="q2" vid="ISA 3:4">ntəkayịn ediikara ammọ.”<verse eid="ISA 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 3:5" />Mme awo eyaefiik emọ-emọ,</para>
  <para style="q2" vid="ISA 3:5">awodeen ye awodeen, mbọhọidʌñ ye mbọhọidʌñ.</para>
  <para style="q1" vid="ISA 3:5">Iwaad eyaedakka eda ikọ ye mme ikpọawo,</para>
  <para style="q2" vid="ISA 3:5">mbon i-imiinieghe se edo ye mbon ukpono.<verse eid="ISA 3:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 3:6" />Awodeen ayaamʌm keed ke atu nditọeka amọ ideen</para>
  <para style="q2" vid="ISA 3:6">ke ufọk ete amọ, anyʌñ abo,</para>
  <para style="q1" vid="ISA 3:6">“Afo amesịne afọñ ufʌkidem, afo di do adadusʌñ ñnyịn;</para>
  <para style="q2" vid="ISA 3:6">di se ñkpọ baña ñwuudo a-afịgheke mi!”<verse eid="ISA 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 3:7" />Ado ke usen ado anye ayaasio ñkpo ayịd,</para>
  <para style="q2" vid="ISA 3:7">“Ami nnieghe nsuuk.</para>
  <para style="q1" vid="ISA 3:7">Ami nnieghe ndidia me afọñ ke ufọk mmi;</para>
  <para style="q2" vid="ISA 3:7">kunnam miin adadusʌñ unọọ mbon awo.”<verse eid="ISA 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 3:8" />Yeruselem ateññe,</para>
  <para style="q2" vid="ISA 3:8">Yuda asʌk aduọ;</para>
  <para style="q1" vid="ISA 3:8">mme ikọ ye mme adinam ammọ ewọt nsọñiwuod ye <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 3:8">ekaiso ebiat ubọọñ iso amọ.<verse eid="ISA 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 3:9" />Naña iso ammọ eba enọ ikọ ntiense ebaña ammọ;</para>
  <para style="q2" vid="ISA 3:9">ammọ eneeñe idiọọkñkpọ ammọ enịm nte Sọdọm;</para>
  <para style="q2" vid="ISA 3:9">ammọ idịppedịp anye.</para>
  <para style="q1" vid="ISA 3:9">Adọdiọọk anọ ammọ!</para>
  <para style="q2" vid="ISA 3:9">Ammọ eben nsobo enọ idem ammọ.<verse eid="ISA 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 3:10" />Dọkkọ ndinen awo ke adiifọfọn ye ammọ,</para>
  <para style="q2" vid="ISA 3:10">sia ammọ eyaekop inem mfịd ubọkutom ammọ.<verse eid="ISA 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 3:11" />Adọdiọọk anọ mbon ibak!</para>
  <para style="q2" vid="ISA 3:11">Nsobo asịm ammọ!</para>
  <para style="q1" vid="ISA 3:11">Eyaekpe ammọ utịb</para>
  <para style="q2" vid="ISA 3:11">ke se ubọk ammọ anam.<verse eid="ISA 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 3:12" />Iwaad efiik mbon mmi,</para>
  <para style="q2" vid="ISA 3:12">ibaan ekara ammọ.</para>
  <para style="q1" vid="ISA 3:12">Mbon mmi, mme adadusʌñ ndufo itịn ndufo usʌñ;</para>
  <para style="q2" vid="ISA 3:12">ammọ iwọññọ ndufo ekpọñ usʌñ.<verse eid="ISA 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ISA 3:13" />
    <char style="nd">Abọọñ</char> adat itie amọ ke esob;</para>
  <para style="q2" vid="ISA 3:13">anye adakka ada adikpe ikpe nnọọ mme awo.<verse eid="ISA 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 3:14" />
    <char style="nd">Abọọñ</char> adʌk ke ikpe</para>
  <para style="q2" vid="ISA 3:14">abaña mme ñkpisọñ ye mbon se idat mbon amọ usʌñ:</para>
  <para style="q1" vid="ISA 3:14">“Afo ado awo se ibiat inwañ fain mmi;</para>
  <para style="q2" vid="ISA 3:14">mme ñkpọ se ebọ mme uweene ke ñkanubọk eba ke mme ufọk ndufo.<verse eid="ISA 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 3:15" />Awuọñọ die inọọ ndufo adinuak mbon mmi</para>
  <para style="q2" vid="ISA 3:15">ye adinyʌñ ñkọk iso mbon uweene?”</para>
  <para style="q2" vid="ISA 3:15">Abọọñ atañ, <char style="nd">Abọọñ</char> Andikponñkan.<verse eid="ISA 3:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 3:16" />
    <char style="nd">Abọọñ</char> abo,</para>
  <para style="q2" vid="ISA 3:16">“Ibaan Saiyọn ekpoon ekokko idem,</para>
  <para style="q1" vid="ISA 3:16">esaña esio itọñ enyan;</para>
  <para style="q2" vid="ISA 3:16">esuan anyen use,</para>
  <para style="q1" vid="ISA 3:16">edọdọọñ isañ enyʌñ etop itakisịn,</para>
  <para style="q2" vid="ISA 3:16">mme ñkpọ mmaidem ammọ esʌk esio uyio nte ñkanika ke itọñukod ammọ.<verse eid="ISA 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 3:17" />Ke ami <char style="nd">Abọọñ</char> ayaanam inia ata ibaan Saiyọn ke iwuod;</para>
  <para style="q2" vid="ISA 3:17">
    <char style="nd">Abọọñ</char> ayaanam etịñiwuod ammọ ekappa ebọ.”<verse eid="ISA 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 3:18" />Ke usen ado Abọọñ ayaawappa ammọ uyai abọ: ñkpọ itọñubọk ye uyadiwuod ye mfọọn ñkwaitọñ, <verse eid="ISA 3:18" /><verse number="19" style="v" sid="ISA 3:19" />mme ñkpọutọñ ye mme ñkpọubọk ye mme ufʌkñkpọ, <verse eid="ISA 3:19" /><verse number="20" style="v" sid="ISA 3:20" />mme mbọbọiwuod ye mme ñkwaukod ye mme ñkịneisịn, mme ekpeme inemufịk adan ye mme ibọk, <verse eid="ISA 3:20" /><verse number="21" style="v" sid="ISA 3:21" />mme ñkpannuun idiọọñọ ye mme ñkpannuun iwuo, <verse eid="ISA 3:21" /><verse number="22" style="v" sid="ISA 3:22" />mfọọn ñnyan afọñ ye mbioubọk afọñ ye mme nduọ-nduọ afọñ, mme ekpadubọk <verse eid="ISA 3:22" /><verse number="23" style="v" sid="ISA 3:23" />ye mme ukịdiso, ye mme mfọọn afọñ linen ye mme ntək anyanya ye mme afọñ ufʌkitọñ.<verse eid="ISA 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 3:24" />Utu ke inemufịk adiido idiọọk utebe;</para>
  <para style="q2" vid="ISA 3:24">utu ke ñkịneisịn, adiido udʌk;</para>
  <para style="q1" vid="ISA 3:24">utu ke uyaiya ided iwuod, ebọ;</para>
  <para style="q2" vid="ISA 3:24">utu ke uyaiya afọñ, afọñikpo;</para>
  <para style="q2" vid="ISA 3:24">utu ke uyai, mbọn ikañ.<verse eid="ISA 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 3:25" />Ideen ndufo eyaeduọññọ ke afịd,</para>
  <para style="q2" vid="ISA 3:25">mbon ekọñ ndufo eyaekpañña ke ekọñ.<verse eid="ISA 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 3:26" />Inuaatob Saiyọn ayaaseeme anyʌñ afʌhọ;</para>
  <para style="q2" vid="ISA 3:26">anye ayaakappa awoñkpọnnam, atie ke isọñ.<verse eid="ISA 3:26" /></para>
  <chapter eid="ISA 3" />
  <chapter number="4" style="c" sid="ISA 4" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 4:1" />Ke usen ado ibaan itiaba</para>
  <para style="q2" vid="ISA 4:1">eyaemʌm awodeen keed</para>
  <para style="q1" vid="ISA 4:1">enyʌñ ebo, “Ñnyịn iyaidia ndidia idem ñnyịn</para>
  <para style="q2" vid="ISA 4:1">inyʌñ isịn idem ñnyịn afọñ;</para>
  <para style="q1" vid="ISA 4:1">yak ikap ikekere anyịñ udian fiin. Ben abuud ñnyịn fep!”<verse eid="ISA 4:1" /></para>
  <para style="s1">Ñkọk <char style="nd">Abọọñ</char></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 4:2" />Ke usen ado Ñkọk <char style="nd">Abọọñ</char> ayaayaiya anyʌñ anie ubọọñ, ndin mfịd isọñ ayaado uyai ye ubọọñ anọ nsʌhọ Isrel. <verse eid="ISA 4:2" /><verse number="3" style="v" sid="ISA 4:3" />Mbon se isʌhọ ke Saiyọn, se iba ke Yeruselem, ke ediikoot ndisana, afịd mbon se ebat esịn ke atu mme aduuwem ke Yeruselem. <verse eid="ISA 4:3" /><verse number="4" style="v" sid="ISA 4:4" /><char style="nd">Abọọñ</char> ayaayet ndek ibaan Saiyọn; anye ayaakwokko mme ntọi iyiib asio ke Yeruselem ato ke sịbidịd ikpe ye sịbidịd ikañ. <verse eid="ISA 4:4" /><verse number="5" style="v" sid="ISA 4:5" />Ndin <char style="nd">Abọọñ</char> ayaabot ke afịd Abod Saiyọn ye ke afịd mbon se iboho do eboho nsʌñikañ ke uweemeayio ye akpọsọñ ikañ a-asakka ke akonayio; sia ubọọñ Abasi ayaado ikpoto anọ ukeed ñkpọ. <verse eid="ISA 4:5" /><verse number="6" style="v" sid="ISA 4:6" />Anye adiido itie idʌñ ye ndeeñ anọ ufiob ke usen, ye itie ubọkkọ ye itie udịbe ke ini ayobio ye edịm.<verse eid="ISA 4:6" /></para>
  <chapter eid="ISA 4" />
  <chapter number="5" style="c" sid="ISA 5" />
  <para style="s1">Ikwọ Inwañ Fain</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 5:1" />Ami ñyaakwọ ikwọ nnọ anye a-ami mmaaha</para>
  <para style="q2" vid="ISA 5:1">ikwọ a-abañake inwañ fain amọ:</para>
  <para style="q1" vid="ISA 5:1">Awoima mmi amaanie inwañ fain</para>
  <para style="q2" vid="ISA 5:1">ke nseghe anyọñ abod.<verse eid="ISA 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 5:2" />Anye amaadọk isọñ anyʌñ akoono mme itiad asịññe</para>
  <para style="q2" vid="ISA 5:2">anyʌñ atọ mme fain a-anye akemekke.</para>
  <para style="q1" vid="ISA 5:2">Anye amaabọp tọwa ukpeme ke esịd</para>
  <para style="q2" vid="ISA 5:2">anyʌñ anam afe utem ukọd ñko.</para>
  <para style="q1" vid="ISA 5:2">Ndin anye akeyem nti mbunwịm eto kreb,</para>
  <para style="q2" vid="ISA 5:2">ado anye akenwịm ndiọi mfịd kpọd.<verse eid="ISA 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 5:3" />“Idahami ndufo mbon se idʌñ ke Yeruselem ye mbon Yuda,</para>
  <para style="q2" vid="ISA 5:3">ikpe ikpe ke ufọọd mmi ye inwañ fain mmi.<verse eid="ISA 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 5:4" />Nsoo ñkpọ mfen ke ekpekenam enọ inwañ fain mmi</para>
  <para style="q2" vid="ISA 5:4">akan se ami nnam nnọ anye?</para>
  <para style="q1" vid="ISA 5:4">Ini se ami ñkeyem nti kreb,</para>
  <para style="q2" vid="ISA 5:4">nsoo inam anye akenwịm ndiọi kpọd?<verse eid="ISA 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 5:5" />Idahami ami ñyaudọkkọ fiin</para>
  <para style="q2" vid="ISA 5:5">se ami ñyem adinam ke inwañ fain mmi:</para>
  <para style="q1" vid="ISA 5:5">Ami ñyaaben akọ amọ mfep,</para>
  <para style="q2" vid="ISA 5:5">ndin eyaesobo anye;</para>
  <para style="q1" vid="ISA 5:5">Ami ñyaaboom ndibene amọ</para>
  <para style="q2" vid="ISA 5:5">ndin eyaesọnnọ anye.<verse eid="ISA 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 5:6" />Ami ñyaanam anye ado anaan,</para>
  <para style="q2" vid="ISA 5:6">awo ikpokko eto amọ, inyʌññọ itọ ñkpọ ke esịd,</para>
  <para style="q2" vid="ISA 5:6">ndin akpab ye ñkukịm ediikọt do.</para>
  <para style="q1" vid="ISA 5:6">Ami ñyaawuuk mme ntọñanyọñ</para>
  <para style="q2" vid="ISA 5:6">mbaak edịm adidep aduọkkọ anye.”<verse eid="ISA 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 5:7" />Inwañ fain <char style="nd">Abọọñ</char> Andikponñkan</para>
  <para style="q2" vid="ISA 5:7">ado idịd Isrel,</para>
  <para style="q1" vid="ISA 5:7">ndin mbon Yuda</para>
  <para style="q2" vid="ISA 5:7">edo mme fain a-anye akenemme esịd abaña.</para>
  <para style="q1" vid="ISA 5:7">Ndin anye amaayem unen, ado akekịt uduọkiyiib;</para>
  <para style="q2" vid="ISA 5:7">ayem adinenido, ado akop ntuaña ñkpọnnam.<verse eid="ISA 5:7" /></para>
  <para style="s1">Mme Isuuñọ ye Ikpe</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 5:8" />Adọdiọọk unọ fiin a-abenne ufọk adian ye ufọk</para>
  <para style="q2" vid="ISA 5:8">anyʌñ aben inwañ adian ye inwañ</para>
  <para style="q1" vid="ISA 5:8">tutu itie ibaaha se isʌhọ aba</para>
  <para style="q2" vid="ISA 5:8">ndin afo a-adʌñ ikpọọñ ke isọñ.<verse eid="ISA 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 5:9" />
    <char style="nd">Abọọñ</char> Andikponñkan atañ anwa-anwa ami ñkop:</para>
  <para style="q1" vid="ISA 5:9">“Ke akpanikọ mme ikpọ ufọk eyaekappa edo ñwuudo,</para>
  <para style="q2" vid="ISA 5:9">mme ikpọ mfọọn ufọk idiinieghe mme andidʌñ ke esịd.<verse eid="ISA 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 5:10" />Afəñ inwañ fain duob adiinwịm ikad fain keed kpọd se ekama enam ikịm<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">A-adooho ñkpọ nte lita 22.</char></note> ukọd keed;</para>
  <para style="q2" vid="ISA 5:10">ayọhọ homa<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">A-adooho ñkpọ nte kilokram 160.</char></note> ñkpasi keed adiinwịm udomoñkpọ efa<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">A-adooho ñkpọ nte kilokram 16</char></note> keed kpọd.”<verse eid="ISA 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 5:11" />Adọdiọọk anọ mbon ebakka edemme idab ubakusen</para>
  <para style="q2" vid="ISA 5:11">efeghe ebịne ukọd,</para>
  <para style="q1" vid="ISA 5:11">e-enyʌññọ etaba idab akonayio</para>
  <para style="q2" vid="ISA 5:11">tutu ukọd asak ammọ ke idem nte ikañ.<verse eid="ISA 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 5:12" />Ammọ enie mme ekpa ye mme ndidoudʌk ke itie usọrọ ammọ,</para>
  <para style="q2" vid="ISA 5:12">mme adʌk ye mme ibịdubọk ye ukọd,</para>
  <para style="q1" vid="ISA 5:12">ado ammọ inieghe ukpono inọ mme adinam <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 5:12">ukpono ibaaha inọ mme utom ubọk amọ.<verse eid="ISA 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 5:13" />Ke ntoro eyaetañ mbon mmi ekaa asen idịd</para>
  <para style="q2" vid="ISA 5:13">akeene unana adidiọọñọ;</para>
  <para style="q1" vid="ISA 5:13">mme ñkpisọñ eyaekpañña abiọọñ,</para>
  <para style="q2" vid="ISA 5:13">ndin mme ñkaña awo eyaekop nsaditọñ.<verse eid="ISA 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 5:14" />Ke ntoro Ñkpa atat akpọmbañ amọ,</para>
  <para style="q2" vid="ISA 5:14">atat ekpainua amọ anịm inwañ;</para>
  <para style="q1" vid="ISA 5:14">mme awuọiso awo ye ñkaña awo ammọ</para>
  <para style="q2" vid="ISA 5:14">ye afịd mbon ntịme ye mbon ammọ e-emiaha nduba unwọñ ukọd eyaeduọññọ edọñọ do.<verse eid="ISA 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 5:15" />Ke ntoro eyaesuuhọ mme awo itie</para>
  <para style="q2" vid="ISA 5:15">eyaenyʌñ esuuhọ afịd awo,</para>
  <para style="q2" vid="ISA 5:15">enyʌñ esuuhọ anyen mbon ntañidem.<verse eid="ISA 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 5:16" />Ado <char style="nd">Abọọñ</char> Andikponñkan ayaakoñ ke ubọọñ adinen ikpe amọ,</para>
  <para style="q2" vid="ISA 5:16">ndin adisana Abasi ayaanam ediọọñọ adisana ido amọ ato nti utom amọ.<verse eid="ISA 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 5:17" />Mme edọñ eyaeta mbid ke itie ndidia ammọ;</para>
  <para style="q2" vid="ISA 5:17">mme ñyịn edọñ<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="ft" closed="false">Septuakin; ke Hibru </char><char style="fqa" closed="false">mme isenawo ediidia</char></note> eyaedia eto ñwuudo mbon imọ.<verse eid="ISA 5:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 5:18" />Adọdiọọk anọ mbon e-ekamake udʌk abiaña edʌt idiọọkñkpọ,</para>
  <para style="q2" vid="ISA 5:18">enyʌñ ekama ibak nte idʌk ukpadñkpọ,<verse eid="ISA 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 5:19" />mbon se ibo, “Yak Abasi anam usọp-usọp;</para>
  <para style="q2" vid="ISA 5:19">yak anye anam utom amọ asọp idem</para>
  <para style="q2" vid="ISA 5:19">nọ ato do ñnyịn ikịt anye.</para>
  <para style="q1" vid="ISA 5:19">Yak uduak Adisana Abasi Isrel,</para>
  <para style="q2" vid="ISA 5:19">asaña akpere, yak anye adi yak ekịt,</para>
  <para style="q2" vid="ISA 5:19">nọ ato do ñnyịn idiọọñọ anye.”<verse eid="ISA 5:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 5:20" />Adọdiọọk anọ mbon e-ebenne idiọọk ekoot eti</para>
  <para style="q2" vid="ISA 5:20">enyʌñ eben eti ekoot idiọọk,</para>
  <para style="q1" vid="ISA 5:20">e-ebenne ekịm ekoot unwana</para>
  <para style="q2" vid="ISA 5:20">enyʌñ eben unwana ekoot ekịm,</para>
  <para style="q1" vid="ISA 5:20">e-ebenne idod ekoot inịññe</para>
  <para style="q2" vid="ISA 5:20">enyʌñ eben inịññe ekoot idod.<verse eid="ISA 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 5:21" />Adọdiọọk anọ mbon e-ekịtte idem ammọ nte mbon aniọñ</para>
  <para style="q2" vid="ISA 5:21">ye mme adiọọñọñkpọ ke anyen ammọ.<verse eid="ISA 5:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 5:22" />Adọdiọọk anọ mbon e-edooho uko ke itie unwọñ ukọd</para>
  <para style="q2" vid="ISA 5:22">ye mme andikan ke uwuak ukọd,<verse eid="ISA 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 5:23" />e-esaanake mme adueñkpọ eyaak ke ntak ubọkedem,</para>
  <para style="q2" vid="ISA 5:23">ado etre adinọ mbon i-imiidueghe unen ammọ.<verse eid="ISA 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 5:24" />Ke ntoro, adaña nte mme edemeikañ edaiya akpọ abakpa</para>
  <para style="q2" vid="ISA 5:24">ye naña nsaad mbid asuuhọ ke edemeikañ,</para>
  <para style="q1" vid="ISA 5:24">kpa ntoro ke adʌñ ammọ adiibu</para>
  <para style="q2" vid="ISA 5:24">enyʌñ efuut mme ñkpokpoñ ammọ eduọk nte abu;</para>
  <para style="q1" vid="ISA 5:24">sia ammọ emaesịn mbed <char style="nd">Abọọñ</char> Andikponñkan</para>
  <para style="q2" vid="ISA 5:24">enyʌñ esịn ikọ Adisana Abasi Isrel ke ndek.<verse eid="ISA 5:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 5:25" />Ke ntoro iyadesịd <char style="nd">Abọọñ</char> asak nte ikañ abaña mbon amọ;</para>
  <para style="q2" vid="ISA 5:25">ubọk amọ adịppe anyʌñ amia ammọ abono ke isọñ.</para>
  <para style="q1" vid="ISA 5:25">Mme ikpọabod enyeñ,</para>
  <para style="q2" vid="ISA 5:25">mme akpo awo ñko eseppe nte mbio ke mme efaak.</para>
  <para style="b" vid="ISA 5:25" />
  <para style="q1" vid="ISA 5:25">Ado kpa ye ado, iyadesịd amọ iwọññọke edem,</para>
  <para style="q2" vid="ISA 5:25">ubọk amọ asʌk adedịppe ke anyọñ.<verse eid="ISA 5:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="ISA 5:26" />Anye adịppe afọñidiọọñọ anọ mme idịd e-ebaaha nsan-nsan,</para>
  <para style="q2" vid="ISA 5:26">anye afịt ifiom anọ mbon e-ebaaha ke mme utịd ederimbod.</para>
  <para style="q1" vid="ISA 5:26">Se ammọ ediighe mi,</para>
  <para style="q2" vid="ISA 5:26">usọp-usọp, ubiat ini ibaaha!<verse eid="ISA 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 5:27" />Ibaaha awo ammọ ndomokeed se ikop mmemidem me iduọ,</para>
  <para style="q2" vid="ISA 5:27">ibaaha awo ammọ ndomokeed se iteeñ idab me se idaiya;</para>
  <para style="q1" vid="ISA 5:27">ñkpahaisịn ammọ inyʌññọ itara ammọ ke isịn,</para>
  <para style="q2" vid="ISA 5:27">idʌk ikpaukod inyʌññọ itara.<verse eid="ISA 5:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 5:28" />Idañ ammọ esọp,</para>
  <para style="q2" vid="ISA 5:28">afịd utịgha ammọ etobbo udʌk asọñ;</para>
  <para style="q1" vid="ISA 5:28">ukod enañmbakara ammọ eba nte ñkpọ itiadikañ,</para>
  <para style="q2" vid="ISA 5:28">mme ukod sariọd ammọ ebit afịm ayobio.<verse eid="ISA 5:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 5:29" />Uyom ñkuun ammọ ebit ake ekpeikọd,</para>
  <para style="q2" vid="ISA 5:29">ammọ ekuun nte nditọ ekpe;</para>
  <para style="q1" vid="ISA 5:29">ammọ ekuun ke emaemʌm unam ndita</para>
  <para style="q2" vid="ISA 5:29">enyʌñ eben ammọ efeghe ndin awo unyaaña ibaaha.<verse eid="ISA 5:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 5:30" />Ammọ eyaekuun ke usen ado</para>
  <para style="q2" vid="ISA 5:30">nte uyom akpainyañ.</para>
  <para style="q1" vid="ISA 5:30">Ndin awo a-akannake anyen ase abio,</para>
  <para style="q2" vid="ISA 5:30">adiikịt ekịm ye nnananyen kpọd;</para>
  <para style="q2" vid="ISA 5:30">mme ntọñanyọñ eyaenyʌñ ekịm efʌk utịn.<verse eid="ISA 5:30" /></para>
  <chapter eid="ISA 5" />
  <chapter number="6" style="c" sid="ISA 6" />
  <para style="s1">Ubiọñutom Aisaiya</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 6:1" />Ke isua A-Adidem Usaiya akekpaaha, ami mmaakịt Abọọñ, ke anyọñ ye ubọọñ, naña atie ke ebekpo; ndin afọñ ubọọñ amọ amaayọhọ afịd a-tembịd. <verse eid="ISA 6:1" /><verse number="2" style="v" sid="ISA 6:2" />Ke anyọñ amọ mme serafim ekedoro, ammọ keedekeed ekenie mba itiokeed: ammọ emaeben mba iba efʌk iso, eben mba iba efʌk ukod, enyʌñ eben mba iba efuurọ. <verse eid="ISA 6:2" /><verse number="3" style="v" sid="ISA 6:3" />Ammọ ekesʌk ebọọñ ekoot emọ-emọ ete:</para>
  <para style="q1" vid="ISA 6:3">“Adisana, adisana, adisana ado <char style="nd">Abọọñ</char> Andikponñkan;</para>
  <para style="q2" vid="ISA 6:3">afịd ederimbod ayọhọ ye ubọọñ amọ.”<verse eid="ISA 6:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="ISA 6:4" />Ke adikop uyio ammọ, inuaatob ye mme inuausʌñ emaenyeñ ndin tembịd amaayọhọ ye nsʌñikañ.<verse eid="ISA 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 6:5" />Ami mmaatua mbo. “Adọdiọọk annọ miin!” “Ami mmetak! Sia ami ndo awo ndedeghe ñkpọkinua, ami ñnyʌñ ndʌñ ke atu mbon ndedeghe ñkpọkinua, ndin anyen mmi akịt Adidem, <char style="nd">Abọọñ</char> Andikponñkan.”<verse eid="ISA 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 6:6" />Akem keed ke atu mme serafim amaafuurọ ambịne miin akama ndubekikañ ke ubọk, a-anye akekamake ufadikañ asio ke akpokoro uwa. <verse eid="ISA 6:6" /><verse number="7" style="v" sid="ISA 6:7" />Anye amaadat ndubekikañ ado antuuk miin inua ate, “Se, anyem utuuk fiin ñkpọkinua; eben ndudue mfo efep enyʌñ efeen unọ ke mme idiọọkñkpọ mfo.”<verse eid="ISA 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 6:8" />Ndin ami mmaakop uyio Abọọñ naña abo, “Anie ke ami ndiidọñ? Anie adiika inọ ñnyịn?”</para>
  <para style="p" vid="ISA 6:8">Ami mmaabo, “Se miin mi. Ndọñ miin!”<verse eid="ISA 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 6:9" />Anye amaabo, “Kaa ke dọkkọ ibon ami:</para>
  <para style="q1" vid="ISA 6:9">“ ‘Ikaa iso ikop, ado inaaha inwaña;</para>
  <para style="q2" vid="ISA 6:9">ikaa iso ikịt, ado idiọọñọke.’<verse eid="ISA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 6:10" />Nam esịd mbon ami edoro ufiọn;</para>
  <para style="q2" vid="ISA 6:10">nam utọñ ammọ adoppo</para>
  <para style="q2" vid="ISA 6:10">nyʌñ fʌk ammọ ñkịm ke anyen.</para>
  <para style="q1" vid="ISA 6:10">Imiidooho ntoro ammọ ekeme ikama anyen ammọ ekịt ñkpọ,</para>
  <para style="q2" vid="ISA 6:10">ekop ñkpọ ke utọñ ammọ,</para>
  <para style="q2" vid="ISA 6:10">esịd ammọ anyʌñ anam ñkpọ anwaña ammọ,</para>
  <para style="q1" vid="ISA 6:10">ammọ ndin ewọññọ edem ekpọñ idiọọk enyʌñ ebọ ukọk.”<verse eid="ISA 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 6:11" />Ndin ami mmaabo, “Adiikpeene die, <char style="nd">Abọọñ</char>?”</para>
  <para style="p" vid="ISA 6:11">Anye amaabọọrọ:</para>
  <para style="q1" vid="ISA 6:11">“Tutu mme abio eba ke nsobo</para>
  <para style="q2" vid="ISA 6:11">enyʌñ enana mme awo se idʌñ,</para>
  <para style="q1" vid="ISA 6:11">tutu efeeñe ekpọñ mme ufọk</para>
  <para style="q2" vid="ISA 6:11">mme inwañ ñko ebiaña enyʌñ etahade,<verse eid="ISA 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 6:12" />tutu <char style="nd">Abọọñ</char> abịn afịd awo ekaa anyan usʌñ</para>
  <para style="q2" vid="ISA 6:12">afịd awo enyʌñ efeeñe ekpọñ isọñ afịd-afịd.<verse eid="ISA 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 6:13" />Akpekọm mbakka duob akpesʌhọ ke idʌñ,</para>
  <para style="q2" vid="ISA 6:13">esʌk ediimamaana esobo anye.</para>
  <para style="q1" vid="ISA 6:13">Ado naña nte terebin ye afriyo</para>
  <para style="q2" vid="ISA 6:13">ekpọñ adʌñ ke emaekpịkke ammọ enịm ke isọñ,</para>
  <para style="q2" vid="ISA 6:13">ukem ado ke adisana mfịd adiido adʌñ ke isọñ ado.”<verse eid="ISA 6:13" /></para>
  <chapter eid="ISA 6" />
  <chapter number="7" style="c" sid="ISA 7" />
  <para style="s1">Idiọọñọ Imanduel</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 7:1" />Ke ini Ahas ayịn Yọtam, ayịn Usaiya, a-akedooho adidem ke Yuda, Adidem Aram a-akedooho Resịn ye Peka ayịn awodeen Remalia adidem Isrel emaekaa adinwana ekọñ ye Yeruselem, ado ammọ ikikanna anye ubọk.<verse eid="ISA 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 7:2" />Ndin emaedọkkọ ufọk Defid ebo, “Aram akediana keed ye Ifrem”; ke ntoro esịd amaaduọ Ahas ye mbon amọ, kpa naña afịm anyeeñe mme eto ke akai.<verse eid="ISA 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 7:3" />Ndin <char style="nd">Abọọñ</char> amaabo Aisaiya, “Wuọ, afo ye ayịn mfo Sie-Yasub, kaa ke soobo ye Ahas ke utịd usaña mmọọñ ke Anyọñ Ñkpọdiọhọ mmọọñ, ke usʌñ Inwañ Ayedafọñ. <verse eid="ISA 7:3" /><verse number="4" style="v" sid="ISA 7:4" />Bo anye, ‘Tịm kpeme idem, suuhọ idem, kuunyʌñ ukop ndịk. Kuunie iduọesịd ubaña ikpitok ifia iba esakka usʌk-usʌk, ke ntak akpọsọñ iyadesịd Resịn ye Aram ye ayịn Remalia. <verse eid="ISA 7:4" /><verse number="5" style="v" sid="ISA 7:5" />Aram, Ifrem ye ayịn Remalia ekọọk iwuod ebaña iduọ mfo, ete, <verse eid="ISA 7:5" /><verse number="6" style="v" sid="ISA 7:6" />“Yak ñnyịn ikinwana ibọ Yuda; yak ñnyịn ikpok anye ideeme inọ idem ñnyịn, inyʌñ inam ayịn Tabeel ado adidem do.” <verse eid="ISA 7:6" /><verse number="7" style="v" sid="ISA 7:7" />Kpayeado se <char style="nd">Abọọñ</char> Andikara atañ ado ami:</para>
  <para style="q1" vid="ISA 7:7">“ ‘Idiitịppeke,</para>
  <para style="q2" vid="ISA 7:7">utọ ado ibaaha,<verse eid="ISA 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 7:8" />sia iwuod Aram ado Damaskọs,</para>
  <para style="q2" vid="ISA 7:8">ñko iwuod Damaskọs ado Resịn ikpọọñ.</para>
  <para style="q1" vid="ISA 7:8">Ke ufọọd isua ata mme ition</para>
  <para style="q2" vid="ISA 7:8">Ifrem ayaasuana akan se ado aduuk keed.<verse eid="ISA 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 7:9" />Iwuod Ifrem ado Sameria,</para>
  <para style="q2" vid="ISA 7:9">ñko iwuod Sameria ado ayịn Remalia ikpọọñ.</para>
  <para style="q1" vid="ISA 7:9">Adieke afo umuusọọñọke uda ke mbuọdidem mfo,</para>
  <para style="q2" vid="ISA 7:9">afo uduudaahada aba.’ ”<verse eid="ISA 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 7:10" />
    <char style="nd">Abọọñ</char> amaamaana atañ ikọ anọ Ahas, <verse eid="ISA 7:10" /><verse number="11" style="v" sid="ISA 7:11" />“Bịp <char style="nd">Abọọñ</char> Abasi mfo idiọọñọ, me ke ntəñoñkan idakisọñ mme ke ñkoññkan anyọñ.”<verse eid="ISA 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 7:12" />Ado Ahas amaabo, “Ami ndiibịppe; ami ndiinyʌññọ ndomo <char style="nd">Abọọñ</char> idomo.”<verse eid="ISA 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 7:13" />Akem Aisaiya amaabo, “Ikop idahami, ndufo ufọk Defid! Ado nte ikemme ndufo adidomo ime ubonawo? Ndufo eyaenyʌñ edomo ime Abasi mmi ñko? <verse eid="ISA 7:13" /><verse number="14" style="v" sid="ISA 7:14" />Ke ntoro Abọọñ ke idem amọ ayainọ ndufo idiọọñọ: Ñkpʌk abọikpa ayaayommo anyʌñ aman ayịn awodeen, ndin ayaakoot anye Imanduel.<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="fq" closed="false">Imanduel </char><char style="ft" closed="false">awuọñọ </char><char style="fqa" closed="false">Abasi mmọdo ye ñnyịn.</char></note> <verse eid="ISA 7:14" /><verse number="15" style="v" sid="ISA 7:15" />Anye adiisidia nsọọñ mmọọñeba ye adanakwọọk ke anye amaatịm idiọọñọ adisịn idiọọk ñnyʌñ mmek eti, <verse eid="ISA 7:15" /><verse number="16" style="v" sid="ISA 7:16" />ado mbemiso ayịn awodeen ami adiọọñọidem akem se asịn idiọọk anyʌñ amek eti, isọñ ndidem iba a-afo anekkeke abaak ediina ukpọk. <verse eid="ISA 7:16" /><verse number="17" style="v" sid="ISA 7:17" /><char style="nd">Abọọñ</char> ayaunọ fiin ye mbon mfo ye ufọk ete mfo ayio i-imiikibaaha tọọñọ Ifrem akediañña akpọñ Yuda, anye ayaaben adidem Asiria adi.”<verse eid="ISA 7:17" /></para>
  <para style="s1">Asiria Akappa Ñkpọutom <char style="nd">Abọọñ</char></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 7:18" />Ke usen ado <char style="nd">Abọọñ</char> ayaafịt ifiom akoot mme nsʌñ e-etooho inuaakpa Nail ke Iyib ye mme akwọọk e-etooho Asiria. <verse eid="ISA 7:18" /><verse number="19" style="v" sid="ISA 7:19" />Afịd ammọ eyaeteññe eketie ke itịkke abedeñ ye ke mme ndudu abaitiad, ke afịd mme ikọd ñkukịm ye afịd mme aba mmọọñ. <verse eid="ISA 7:19" /><verse number="20" style="v" sid="ISA 7:20" />Ke usen ado Abọọñ ayaakama akadañ ebọọhọ ke ekọmudua eto edem Inyañ Yufretis, a-adooho adidem Asiria, nọ akama akwat ided iwuod ndufo ye ided ke ndedịbe idem ndufo, anyʌñ akwaat ñwaebek ndufo ñko. <verse eid="ISA 7:20" /><verse number="21" style="v" sid="ISA 7:21" />Ke usen ado, awo ayaanịm ñyịn enañ keed ye ebod iba ke uwem. <verse eid="ISA 7:21" /><verse number="22" style="v" sid="ISA 7:22" />Akeene akpọmiọk mmọọñeba a-ammọ enọọhọ, nsọọñ mmọọñeba ayaaba se edia. Afịd mbon se isʌhọ ke idʌñ eyaedia nsọọñ mmọọñeba ye adanakwọọk. <verse eid="ISA 7:22" /><verse number="23" style="v" sid="ISA 7:23" />Ke usen ado, ke afịd itie se fain ekeba e-ekeyọhọke tọsịn keed (1,000) a-akpaaha udomoñkpọ tọsịn sekel silfa keed (1,000)<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false">A-adooho ñkpọ nte kilokram 12.</char></note>, ñkukịm ye mbaraekpe ikpọọñ ediiba. <verse eid="ISA 7:23" /><verse number="24" style="v" sid="ISA 7:24" />Ntautob eyaekaa do ye utịgha ye eduad, sia ikọd ado adiiyọhọ ye ñkukịm ye mbaraekpe. <verse eid="ISA 7:24" /><verse number="25" style="v" sid="ISA 7:25" />Amaado afịd mme ntəkabod se ekekama udọk ekịm, afo uduukaaha do aba akeene ndịk ñkukịm ye mbaraekpe; ammọ eyaekappa edo mme itie se ekpọk enañ esuuk, mme edọñ ñko enyʌñ efeeñe do.<verse eid="ISA 7:25" /></para>
  <chapter eid="ISA 7" />
  <chapter number="8" style="c" sid="ISA 8" />
  <para style="s1">Aisaiya ye Nditọ Ekappa Idiọọñọ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 8:1" />
    <char style="nd">Abọọñ</char> amambo miin, “Ben ekamba ikpañwed nyʌñ kama ñkaña etoñwed wet: Maha-Salal-Has-Bas.”<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="fq" closed="false">Maha-Salal-Has-Bas </char><char style="ft" closed="false">awuọñọ </char><char style="fqa" closed="false">adisọp nsobo, adisọp ñkoono mbịme</char><char style="ft" closed="false">; se ñko ke Aisa 8:3.</char></note> <verse eid="ISA 8:1" /><verse number="2" style="v" sid="ISA 8:2" />Ami mmaasịn uyio ñkoot Yuria aku abasi ye Sakaraiya ayịn Yeberekia nte mme ntiense akpanikọ nnọ idem mmi. <verse eid="ISA 8:2" /><verse number="3" style="v" sid="ISA 8:3" />Ndin ami mmaanam ima ye prọfed awonwaan, ndin anye amaayommo anyʌñ aman ayịn awodeen. Ndin Abọọñ amaambo miin, “Sio anye anyịñ Maha-Salal-Has-Bas. <verse eid="ISA 8:3" /><verse number="4" style="v" sid="ISA 8:4" />Sia mbemiso ayịn ado adiọọñọ adibo ‘Ete mmi’ me ‘Eka mmi,’ adidem Asiria ayaakoono imọ Damaskọs ye mme mbịme Sameria.”<verse eid="ISA 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 8:5" />
    <char style="nd">Abọọñ</char> amaamaana andọkkọ miin:<verse eid="ISA 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 8:6" />“Sia ibon ami e-esịn</para>
  <para style="q2" vid="ISA 8:6">mmọọñ Siloa a-afegheke sʌñ-sʌñ</para>
  <para style="q1" vid="ISA 8:6">enyʌñ edaara ebaña Resịn</para>
  <para style="q2" vid="ISA 8:6">ye ayịn awodeen Remalia,<verse eid="ISA 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 8:7" />ke ntoro Abọọñ a-abeeñe idem adinọ ammọ</para>
  <para style="q2" vid="ISA 8:7">akpọsọñ mmọọñ a-atọọhọ ato inyañ Yufretis,</para>
  <para style="q2" vid="ISA 8:7">adidem Asiria ye afịd uku amọ.</para>
  <para style="q1" vid="ISA 8:7">Anye ayaayọhọ afịd mme usañammọọñ amọ,</para>
  <para style="q2" vid="ISA 8:7">ayọhọ mme mben inyañ amọ,<verse eid="ISA 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 8:8" />anyʌñ akwọọk adʌk Yuda, afeghe akanna anye,</para>
  <para style="q2" vid="ISA 8:8">aboiyo tutu asịm itọñ.</para>
  <para style="q1" vid="ISA 8:8">Mme mba amọ eyaetaara efʌk afịd unaisọñ mfo,</para>
  <para style="q2" vid="ISA 8:8">Imanduel!”<verse eid="ISA 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 8:9" />Idịppe uyio ñkpo ekọñ, ndufo mme idịd, inyʌñ isuana!</para>
  <para style="q2" vid="ISA 8:9">Ikpañ utọñ, ndufo mme idịd ke nsan-nsan.</para>
  <para style="q1" vid="ISA 8:9">Ibeeñe idem inọ ekọñ, inyʌñ isuana!</para>
  <para style="q2" vid="ISA 8:9">Ibeeñe idem inọ ekọñ, inyʌñ isuana!<verse eid="ISA 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 8:10" />Inam ñkọọkiwuod ndufo, ado eyaesuan uduak ndufo;</para>
  <para style="q2" vid="ISA 8:10">ikọọk iwuod ibaña uduak ndufo, ado idiisọọñọke ida,</para>
  <para style="q2" vid="ISA 8:10">sia Abasi mmọdo aba ye ñnyịn.<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="ft" closed="false">Ke Hibru ado </char><char style="fqa" closed="false">Imanduel</char></note><verse eid="ISA 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 8:11" />Ami ado se <char style="nd">Abọọñ</char> andọkkọ miin ke ini akpọsọñ ubọk amọ andoroke miin ke idem, andʌt miin utọñ ate ñkukeene usʌñ mbon ami:<verse eid="ISA 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 8:12" />“Kuukoot idiọọk adu</para>
  <para style="q2" vid="ISA 8:12">afịd se ibon ami ekoot idiọọk adu;</para>
  <para style="q1" vid="ISA 8:12">kuukop ndịk ubaña se ammọ ekop ndịk ebaña,</para>
  <para style="q2" vid="ISA 8:12">kuunyʌñ ubaak anye.<verse eid="ISA 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 8:13" />
    <char style="nd">Abọọñ</char> Andikponñkan ikpọọñ ke afo adiidat nte adisana,</para>
  <para style="q2" vid="ISA 8:13">anye ikpọọñ ke afo anie adibaak,</para>
  <para style="q2" vid="ISA 8:13">anye ikpọọñ ke afo akeme adikop ndịk mbaña.<verse eid="ISA 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 8:14" />Anye adiido adisana itie;</para>
  <para style="q2" vid="ISA 8:14">anọ Isrel ye Yuda</para>
  <para style="q1" vid="ISA 8:14">anye adiido itiad a-anamma mme awo etuak ukod</para>
  <para style="q2" vid="ISA 8:14">ye ekamba itiad a-anamma mme awo eduọññọ.</para>
  <para style="q1" vid="ISA 8:14">Ndin amaado mbon Yeruselem anye adiido</para>
  <para style="q2" vid="ISA 8:14">afia ye ñkpọiduọ.<verse eid="ISA 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 8:15" />Uwak ammọ eyaetuak ukod;</para>
  <para style="q2" vid="ISA 8:15">ammọ eyaeduọññọ enyʌñ ebʌñọ,</para>
  <para style="q2" vid="ISA 8:15">eyaekọọk afia enọ ammọ enyʌñ emʌm ammọ.”<verse eid="ISA 8:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 8:16" />Wuuk ikọ ntiense ndʌdutọñ ami</para>
  <para style="q2" vid="ISA 8:16">nyʌñ sọọñọ idiọọñọ item Abasi nọ mme mbed mmi.<verse eid="ISA 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 8:17" />Ami ñyaabet Abọọñ,</para>
  <para style="q2" vid="ISA 8:17">a-adịppe mbon e-etooho ubon Yekọb iso amọ.</para>
  <para style="q1" vid="ISA 8:17">Ami ñyaadot anyen mmi ke anye.<verse eid="ISA 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 8:18" />Se ami mi, ye nditọ <char style="nd">A-Abọọñ</char> akennọọhọ miin. Ñnyịn ido mme idiọọñọ ye mme ñkpọ uwọdñkpọ ke Isrel a-atooho <char style="nd">Abọọñ</char> Andikponñkan, a-adʌññọ ke Abod Saiyọn.<verse eid="ISA 8:18" /></para>
  <para style="s1">Ekịm Akappa ado Unwana</para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 8:19" />Ke ini awo udọkkọke fiin abo yak akaa useñkpọ ato mme abreidiọñ ye mme sịbidịd, e-etañña ikọ ke ekek ye etək-etək uyio, nte ikpinaaha ndufo ebịp eto Abasi ndufo? Nsoo inam ndufo eduuñọ ñkpọ e-ebañake mme aduuwem eto mme akpañkpa? <verse eid="ISA 8:19" /><verse number="20" style="v" sid="ISA 8:20" />Iduuñọ ito item Abasi ye ikọ ntiense ndʌdutọñ. Adieke awo ndomokeed imiitañña ikọ ikeene ikọ ami, ammọ inieghe unwana usiere. <verse eid="ISA 8:20" /><verse number="21" style="v" sid="ISA 8:21" />Ke nnananyen ye abiọọñ, ammọ eyaeyooñ ekanna ke unadod. Abiọọñ amaanekke adọñ ammọ, esịd ayaayat ammọ, ñko, ke ini ammọ ebenneke iso, eyaesuuñọ adidem ye Abasi ammọ. <verse eid="ISA 8:21" /><verse number="22" style="v" sid="ISA 8:22" />Ndin ammọ eyaekanna anyen ese unadod ado ukweeñe se ediikịt ado nnananyen ye ekịm ye akpọsọñ ndịk, ndin eyaenək ammọ esịn ke ataa ekamba ekịm.<verse eid="ISA 8:22" /></para>
  <chapter eid="ISA 8" />
  <chapter number="9" style="c" sid="ISA 9" />
  <para style="p">
    <note caller="+" style="f">
      <char style="fr" closed="false">9: </char>
      <char style="ft" closed="false">Ke ikpañwed Hibru, ewet Ais 9:1 nte Ais 8:23, ñko Ais 9:2-21 ewet Ais 9:1-20</char>
    </note> <verse number="1" style="v" sid="ISA 9:1" />Ado mfʌhọ idiibaaha aba inọ mbon e-ekebaaha ke nnananyen. Ke usen edem anye amaasuuhọ isọñ Sebulọn ye Naftali, ado ke ini iso anye ayaadịppe Kalili ake mme idịd ke Usʌñ Akpainyañ, ke edem Yọdan.<verse eid="ISA 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 9:2" />Mbon awo e-esañake ke ekịm</para>
  <para style="q2" vid="ISA 9:2">e-ekịt ekamba unwana;</para>
  <para style="q1" vid="ISA 9:2">amaado mbon e-edʌññọ ke isọñ abedeñ ekịm</para>
  <para style="q2" vid="ISA 9:2">unwana a-ayamma anọ ammọ.<verse eid="ISA 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 9:3" />Afo amenam idịd atara</para>
  <para style="q2" vid="ISA 9:3">anyʌñ anam idadesịd ammọ ayọhọ;</para>
  <para style="q1" vid="ISA 9:3">ammọ edaara ke iso mfo</para>
  <para style="q2" vid="ISA 9:3">kpa naña mbon awo edaara ebaña idọk,</para>
  <para style="q1" vid="ISA 9:3">kpa naña mbon ekọñ edaara</para>
  <para style="q2" vid="ISA 9:3">ke ini ammọ edeemeke mbịme ñkpọ.<verse eid="ISA 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 9:4" />Sia kpa naña akedo ke usen e-ekekanna Mbon Midian,</para>
  <para style="q2" vid="ISA 9:4">ndufo emeboom</para>
  <para style="q1" vid="ISA 9:4">mbiomo a-akekakka ammọ,</para>
  <para style="q2" vid="ISA 9:4">akpọnọ a-akekọñọke ammọ ke afara,</para>
  <para style="q2" vid="ISA 9:4">adọọn mbon e-ekefiighe ammọ.<verse eid="ISA 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 9:5" />Afịd ikpaukod mbon ekọñ ekekamake ke ekọñ</para>
  <para style="q2" vid="ISA 9:5">ye afịd afọñ se ekewere ke iyiib</para>
  <para style="q1" vid="ISA 9:5">ado se ediifọfọp</para>
  <para style="q2" vid="ISA 9:5">ammọ ñko ediido adan enọ ikañ.<verse eid="ISA 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 9:6" />Sia ayịn amana inọ ñnyịn,</para>
  <para style="q2" vid="ISA 9:6">i-inọ ñnyịn ayịn,</para>
  <para style="q2" vid="ISA 9:6">ukara ayaadoro anye ke afara.</para>
  <para style="q1" vid="ISA 9:6">Ndin eyaekoot anye</para>
  <para style="q2" vid="ISA 9:6">Utịbe Anọitem, Akpọsọñ Abasi,</para>
  <para style="q2" vid="ISA 9:6">Nsi-nsi Ete, Abọọñ Emem.<verse eid="ISA 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 9:7" />Ke akpọsọñ ukara amọ ye emem</para>
  <para style="q2" vid="ISA 9:7">utịd idiibaaha.</para>
  <para style="q1" vid="ISA 9:7">Anye ayaakara ke ebekpo Defid</para>
  <para style="q2" vid="ISA 9:7">ye ke abioubọọñ amọ,</para>
  <para style="q1" vid="ISA 9:7">asiak anyʌñ asọọñọ amʌm anye akama</para>
  <para style="q2" vid="ISA 9:7">ke unen ye ke adinenido</para>
  <para style="q2" vid="ISA 9:7">tọọñọ ke ini ado tutu ke nsi-nsi.</para>
  <para style="q1" vid="ISA 9:7">Akpọsọñ ima e-enieghe enọ <char style="nd">Abọọñ</char> Andikponñkan</para>
  <para style="q2" vid="ISA 9:7">ayaanam ami awuọ asu.<verse eid="ISA 9:7" /></para>
  <para style="s1">Iyadesịd <char style="nd">Abọọñ</char>ke Abaña Isrel</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 9:8" />Abọọñ a-anọ etob a-abañake Yekọb;</para>
  <para style="q2" vid="ISA 9:8">anye ayaadoro Isrel ke idem.<verse eid="ISA 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 9:9" />Afịd awo eyaediọọñọ anye,</para>
  <para style="q2" vid="ISA 9:9">Ifrem ye afịd mbon se idʌñ ke Sameria,</para>
  <para style="q1" vid="ISA 9:9">e-etañña ye ntañidem</para>
  <para style="q2" vid="ISA 9:9">ye ñkokkoidem ke esịd,<verse eid="ISA 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 9:10" />“Mme itiad ubọbufọk eduọññọ ke isọñ,</para>
  <para style="q2" vid="ISA 9:10">ado ñnyịn iyaikama udọdiọñ itiad imaana ibọp;</para>
  <para style="q1" vid="ISA 9:10">emaekek mme eto fik,</para>
  <para style="q2" vid="ISA 9:10">ado ñnyịn iyaikama sida ikpʌhọ ke itie ammọ.”<verse eid="ISA 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 9:11" />Ado <char style="nd">Abọọñ</char> asọọñọ mme asua Resịn idem abaña ammọ,</para>
  <para style="q2" vid="ISA 9:11">anyʌñ adịppe mme asua ammọ nduduai ke idem.<verse eid="ISA 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 9:12" />Mbon Aram ke edem usakkautịn ye mbon Filistia ke edem usobutịn</para>
  <para style="q2" vid="ISA 9:12">enwañña inua eben Isrel emen.</para>
  <para style="b" vid="ISA 9:12" />
  <para style="q1" vid="ISA 9:12">Ado kpa ye ado, iyadesịd amọ itịmmeke edem,</para>
  <para style="q2" vid="ISA 9:12">ubọk amọ ñko asʌk adedịppe ke anyọñ.<verse eid="ISA 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ISA 9:13" />Ado mme awo itịmmeke ibịne ansikimia ammọ,</para>
  <para style="q2" vid="ISA 9:13">ammọ ñko inyʌññọ iyem <char style="nd">Abọọñ</char> Andikponñkan.<verse eid="ISA 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 9:14" />Ke ntoro <char style="nd">Abọọñ</char> ayaakpịkke iwuod ye isịm asio ke Isrel,</para>
  <para style="q2" vid="ISA 9:14">ndak ayob ye ñnyanyaha ke usen keed;<verse eid="ISA 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 9:15" />mme ñkpisọñ ye mme awuọiso awo edo mme iwuod,</para>
  <para style="q2" vid="ISA 9:15">mme prọfed e-ekpeebe nsu edo isịm.<verse eid="ISA 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 9:16" />Mbon e-ekpemeke idịd ami e-etịn ammọ usʌñ,</para>
  <para style="q2" vid="ISA 9:16">enyʌñ etịn mbon e-ekpemekekpeme usʌñ ñko.<verse eid="ISA 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 9:17" />Ke ntoro Abọọñ idiikoppo inemesịd ye ñkparawa,</para>
  <para style="q2" vid="ISA 9:17">anye ñko idiinieghe mbọm ibaña nditọakpa ye mme ebekpa,</para>
  <para style="q1" vid="ISA 9:17">sia afịd awo edo ibak ye mbon se imiikponoke Abasi,</para>
  <para style="q2" vid="ISA 9:17">afịd inua etañ atịme.</para>
  <para style="b" vid="ISA 9:17" />
  <para style="q1" vid="ISA 9:17">Ado kpa ye ado, iyadesịd amọ iwọññọke edem,</para>
  <para style="q2" vid="ISA 9:17">ubọk amọ ñko asʌk adedịppe ke anyọñ.<verse eid="ISA 9:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 9:18" />Ke akpanikọ ibak asak nte ikañ;</para>
  <para style="q2" vid="ISA 9:18">anye atata mbaraekpe ye ñkukịm,</para>
  <para style="q1" vid="ISA 9:18">akpọsọñ inuaikañ atata esịd akai,</para>
  <para style="q2" vid="ISA 9:18">anam nsʌñikañ amọ awere adọọk anyọñ nte adaaha.<verse eid="ISA 9:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 9:19" />Ke iyadesịd <char style="nd">Abọọñ</char> Andikponñkan</para>
  <para style="q2" vid="ISA 9:19">eyaefọp isọñ</para>
  <para style="q1" vid="ISA 9:19">mme awo ñko ediiba nte adan ikañ enọ ikañ;</para>
  <para style="q2" vid="ISA 9:19">ammọ idiisaanake emọ-emọ iyaak.<verse eid="ISA 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 9:20" />Ke ubọk nnasia, ammọ eyaeta,</para>
  <para style="q2" vid="ISA 9:20">ado esʌk ekop abiọọñ;</para>
  <para style="q1" vid="ISA 9:20">ke ubọk ufiin, ammọ eyaedia</para>
  <para style="q2" vid="ISA 9:20">ado ikoppo uyʌkkọ.</para>
  <para style="q1" vid="ISA 9:20">Ammọ keedekeed eyaedia eto abʌk nditọ ammọ.<verse eid="ISA 9:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="ISA 9:21" />Manase ayaadia ato Ifrem, Ifrem ñko ayaadia ato Manase;</para>
  <para style="q2" vid="ISA 9:21">ammọ mba eyaediana ekanna enwana ye Yuda.</para>
  <para style="b" vid="ISA 9:21" />
  <para style="q1" vid="ISA 9:21">Ado kpa ye ado, iyadesịd amọ iwọññọke ikpọñ,</para>
  <para style="q2" vid="ISA 9:21">ubọk amọ ñko asʌk adedịppe ke anyọñ.<verse eid="ISA 9:21" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 9" />
  <chapter number="10" style="c" sid="ISA 10" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 10:1" />Adọdiọọk anọ mbon e-enamma ukwañ mbed,</para>
  <para style="q2" vid="ISA 10:1">mbon se inam mme ewʌhọ ufiik,<verse eid="ISA 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 10:2" />adibọ uweene mme unen ammọ</para>
  <para style="q2" vid="ISA 10:2">enyʌñ emʌm unen mbon e-efiighe ke atu mbon mmi,</para>
  <para style="q1" vid="ISA 10:2">enam mme ebekpa ekappa edo ndita ammọ</para>
  <para style="q2" vid="ISA 10:2">enyʌñ ebọ nditọakpa ñkpọ ke ñwo.<verse eid="ISA 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 10:3" />Nsoo ke afo uduunam ke usen ikpe,</para>
  <para style="q2" vid="ISA 10:3">ke ini nsobo atooho anyan usʌñ adi?</para>
  <para style="q1" vid="ISA 10:3">Afo uduufeghe ubịne anie ukubọ unwam?</para>
  <para style="q2" vid="ISA 10:3">Mmọọ ke uduunịm inie mfo?<verse eid="ISA 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 10:4" />Ibaha se idiisʌhọke ikan adinwịne ye ndịk ke atu mbon ñkpakọb,</para>
  <para style="q2" vid="ISA 10:4">imiidooho adikpa ye mbon se ewot.</para>
  <para style="b" vid="ISA 10:4" />
  <para style="q1" vid="ISA 10:4">Ado kpa ye ado, iyadesịd amọ iwọññọke ikpọñ,</para>
  <para style="q2" vid="ISA 10:4">ubọk amọ ñko asʌk adedịppe ke anyọñ.<verse eid="ISA 10:4" /></para>
  <para style="s1">Ubiereikpe Abasi ke Abaña Asiria</para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 10:5" />“Adọdiọọk anọ Asiria, esañ iyadesịd mmi,</para>
  <para style="q2" vid="ISA 10:5">akpeti ifịdesịd mmi asịne anye ke ubọk!<verse eid="ISA 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 10:6" />Ami ndọñ anye nnọ idịd i-imiidiọọñọke Abasi,</para>
  <para style="q2" vid="ISA 10:6">ñnyʌñ ndọñ anye abịne mbon se iñyat miin esịd,</para>
  <para style="q1" vid="ISA 10:6">nọ abọ mbịme ye ñkpọ ñwo,</para>
  <para style="q2" vid="ISA 10:6">anyʌñ asọnnọ ammọ nte nsọñ ke mme efaak.<verse eid="ISA 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 10:7" />Ado idooho uduak amọ ado ami,</para>
  <para style="q2" vid="ISA 10:7">idooho se anye anie ke esịd ado ami;</para>
  <para style="q1" vid="ISA 10:7">uduak amọ ado adibiat,</para>
  <para style="q2" vid="ISA 10:7">adinyʌñ ñkịt mbo ke uwak mme idịd eboiyo efep.<verse eid="ISA 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 10:8" />Anye abo. ‘Nte mme adaiso ekọñ mmi idooho ndidem?’<verse eid="ISA 10:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="ISA 10:9" />‘Nte Kalno ibaaha ukem nte Kaakemis?</para>
  <para style="q1" vid="ISA 10:9">Nte Hamad ibaaha nte Apad,</para>
  <para style="q2" vid="ISA 10:9">Sameria ñko inyʌññọ iba nte Damaskọs?<verse eid="ISA 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 10:10" />Naña ubọk mmi akebọọ mme abioubọọñ a-mme ubobod ñkpọ ammọ ekekanna ake Yeruselem ye Sameria;<verse eid="ISA 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 10:11" />nte ami ndiinamma ye Yeruselem ye ubobod ñkpọ amọ</para>
  <para style="q2" vid="ISA 10:11">kpa se ami ñkenam ye Sameria ye ubobod abasi amọ?’ ”<verse eid="ISA 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 10:12" />Ke Abọọñ amaakweeñe afịd utom amọ ke abaña Abod Saiyọn ye Yeruselem, anye ayaabo, “Ami ñyaamia adidem Asiria ufen ke ukokoi ntañidem ke esịd amọ ye ñkokkoidem ke anyen amọ <verse eid="ISA 10:12" /><verse number="13" style="v" sid="ISA 10:13" />Sia anye abo:</para>
  <para style="q1" vid="ISA 10:13">“ ‘Ato ke adudu ubọk mmi ami nnam ami,</para>
  <para style="q2" vid="ISA 10:13">ñko ke aniọñ mmi, sia ami mmenie mbufiọk.</para>
  <para style="q1" vid="ISA 10:13">Ami mmaawʌkkọ adaña mme idịd,</para>
  <para style="q2" vid="ISA 10:13">ami mmaakoono ñkpọ ke ufọk unịm inie ammọ;</para>
  <para style="q2" vid="ISA 10:13">nte akpọsọñ awo ami mmaasuuhọ ndidem ammọ itie.<verse eid="ISA 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 10:14" />Kpa naña awo anyanna ubọk amọ abịne efọk inuen,</para>
  <para style="q2" vid="ISA 10:14">kpa ntoro ke ubọk mmi akenyanna abịne inie mme idịd;</para>
  <para style="q1" vid="ISA 10:14">kpa naña mme awo ekoono mme ñkwa unen e-ekesịnne,</para>
  <para style="q2" vid="ISA 10:14">kpa ntoro ke ami ñkekoono afịd mme idịd mbon;</para>
  <para style="q1" vid="ISA 10:14">ndomokeed imiaha mba,</para>
  <para style="q2" vid="ISA 10:14">inyʌññọ ikʌppọ inua isio uyio inam uyom.’ ”<verse eid="ISA 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 10:15" />Nte ekịd akeme ikoñ ñkan andikama anye,</para>
  <para style="q2" vid="ISA 10:15">me uyọọkñkpọ akeme adiduaak inua</para>
  <para style="q2" vid="ISA 10:15">mbaña awo andikama anye?</para>
  <para style="q1" vid="ISA 10:15">Nte ukwak akeme adinwịn</para>
  <para style="q1" vid="ISA 10:15">awo se idịppe anye ke anyọñ?</para>
  <para style="q2" vid="ISA 10:15">Me akpeti akeme adinam inua</para>
  <para style="q2" vid="ISA 10:15">ye anye imiidooho eto?<verse eid="ISA 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 10:16" />Ke ntoro, Abọọñ, <char style="nd">Abọọñ</char> Andikponñkan,</para>
  <para style="q2" vid="ISA 10:16">ayaadọñ idiọọk udọñọ ke atu mme akobidem mbon ekọñ amọ;</para>
  <para style="q1" vid="ISA 10:16">ke idak ubọọñ amọ ikañ ayaabịppe asak</para>
  <para style="q2" vid="ISA 10:16">nte akpọsọñ ikañ.<verse eid="ISA 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 10:17" />Unwana Isrel ayaakappa aba nte ikañ,</para>
  <para style="q2" vid="ISA 10:17">Adisana Awo ammọ akappa edemeikañ;</para>
  <para style="q1" vid="ISA 10:17">ke usen keed anye ayaasak anyʌñ ata</para>
  <para style="q2" vid="ISA 10:17">mme ñkukịm amọ ye mme mbaraekpe amọ.<verse eid="ISA 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 10:18" />Akpọmiọk inie mme akai amọ ye mme nseghe inwañ amọ</para>
  <para style="q2" vid="ISA 10:18">anye ayaasobo afịd-afịd,</para>
  <para style="q2" vid="ISA 10:18">nte naña awo udọñọ ayeet aboiyo afep.<verse eid="ISA 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 10:19" />Mme ñyọhọnsʌhọ eto ke mme akai amọ ediido ibad-ibad</para>
  <para style="q2" vid="ISA 10:19">a-adooho etəkayịn akeme adiwet ammọ nnịm.<verse eid="ISA 10:19" /></para>
  <para style="s1">Ñyọhọnsʌhọ Isrel</para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 10:20" />Ke usen ado ñyọhọnsʌhọ Isrel,</para>
  <para style="q2" vid="ISA 10:20">mbon Yekọb se ibọkkọ,</para>
  <para style="q1" vid="ISA 10:20">idiinieghe idodanyen aba ke anye</para>
  <para style="q2" vid="ISA 10:20">a-akekpọkkọke ammọ aduọọk</para>
  <para style="q1" vid="ISA 10:20">ado ayaanie mbuọdidem akpan-akpan ke <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 10:20">Ukweeñe Adisana ke Isrel.<verse eid="ISA 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 10:21" />Ñyọhọnsʌhọ ayaatịmme anyọñ, ñyọhọnsʌhọ ufọk Yekọb</para>
  <para style="q2" vid="ISA 10:21">ayaatịmme anyọñ abịne Akpọsọñ Abasi.<verse eid="ISA 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 10:22" />Isrel, akpekọm mbon mfo ekpewak nte ntan ke mben inyañ,</para>
  <para style="q2" vid="ISA 10:22">ñyọhọnsʌhọ kpọd adiitịmme inyọñ idi.</para>
  <para style="q1" vid="ISA 10:22">Ebiere nsobo enịm,</para>
  <para style="q2" vid="ISA 10:22">a-akponno anyʌñ anen.<verse eid="ISA 10:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 10:23" />Abọọñ, <char style="nd">Abọọñ</char> Andikponñkan, ayaanam</para>
  <para style="q2" vid="ISA 10:23">ubiideikpe ewʌhọ nsobo ke afịd ederimbod.<verse eid="ISA 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 10:24" />Ke ntoro se Abọọñ, <char style="nd">Abọọñ</char> Andikponñkan, atañ ado ami:</para>
  <para style="q1" vid="ISA 10:24">“Ikọd mmi e-edʌññọ ke Saiyọn,</para>
  <para style="q2" vid="ISA 10:24">ikiikop ndịk ibaña mbon Asiria,</para>
  <para style="q1" vid="ISA 10:24">i-imiaha ndufo ke ukwak</para>
  <para style="q2" vid="ISA 10:24">enyʌñ edịppe akpeti ibaña ndufo, naña mbon Iyib ekenam.<verse eid="ISA 10:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 10:25" />Ke ini imiikpeeneke iyadesịd mmi ke abaña ndufo ayaatre,</para>
  <para style="q2" vid="ISA 10:25">ñyaanyʌñ ñkanna iyadesịd mmi nse adisobo ammọ.”<verse eid="ISA 10:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="ISA 10:26" />
    <char style="nd">Abọọñ</char> Andikponñkan ayaamia ammọ ke ikpa abọñ,</para>
  <para style="q2" vid="ISA 10:26">kpa naña anye akenam ye mbon Midian ke itiad Ọreb;</para>
  <para style="q1" vid="ISA 10:26">ñko anye ayaadịppe esañ amọ anyan ke anyọñ mmọọñ,</para>
  <para style="q2" vid="ISA 10:26">kpa naña anye akenam ke Iyib.<verse eid="ISA 10:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 10:27" />Ke usen ado eyaedịppe mbiomo ammọ edooro ke afara mfo,</para>
  <para style="q2" vid="ISA 10:27">efọọrọ akpọnọ ammọ esio ke itọñ mfo;</para>
  <para style="q1" vid="ISA 10:27">eyaebuuñ akpọnọ ado</para>
  <para style="q2" vid="ISA 10:27">sia afo amenekke akpon ubom.<verse eid="ISA 10:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="ISA 10:28" />Ammọ edʌk Aiyad;</para>
  <para style="q2" vid="ISA 10:28">ammọ eboiyo ke Mikrọn;</para>
  <para style="q2" vid="ISA 10:28">ammọ etañ ndidia ebono ke Mikmas.<verse eid="ISA 10:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 10:29" />Ammọ esaña eboiyo, enyʌñ ebo,</para>
  <para style="q2" vid="ISA 10:29">“Ñnyịn iyainaa ke Keba nsiereayio.”</para>
  <para style="q1" vid="ISA 10:29">Rama anyeñ;</para>
  <para style="q2" vid="ISA 10:29">Kibie ake Sọọl afeghe.<verse eid="ISA 10:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 10:30" />Tua ke akpọsọñ uyio, Adiaha Kalim!</para>
  <para style="q2" vid="ISA 10:30">Kpañ utọñ Laisa!</para>
  <para style="q2" vid="ISA 10:30">Mbọm Anatod!<verse eid="ISA 10:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 10:31" />Madmena aba ke itọk;</para>
  <para style="q2" vid="ISA 10:31">mbon Kebịm edʌk edịbe.<verse eid="ISA 10:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 10:32" />Usen mfịn ammọ eyaetre ke Nọb;</para>
  <para style="q2" vid="ISA 10:32">ammọ eyaenyeghe ubọk eta ammọ</para>
  <para style="q1" vid="ISA 10:32">ke abod Adiaha Saiyọn,</para>
  <para style="q2" vid="ISA 10:32">ke etəkabod Yeruselem.<verse eid="ISA 10:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="ISA 10:33" />Se, Abọọñ, <char style="nd">Abọọñ</char> Andikponñkan,</para>
  <para style="q2" vid="ISA 10:33">ayaakpeeñe mme ñkọk eto afep ke ekamba adudu.</para>
  <para style="q1" vid="ISA 10:33">Eyaekpịkke ñkpoon eto efep,</para>
  <para style="q2" vid="ISA 10:33">eyaekpok ikpọ ñnyan eto ebon ke isọñ.<verse eid="ISA 10:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 10:34" />Anye ayaakpok mfʌhọ akai ke ekịt afep;</para>
  <para style="q2" vid="ISA 10:34">Lebanọn ayaaduọ ke ubọk Andikponñkan.<verse eid="ISA 10:34" /></para>
  <chapter eid="ISA 10" />
  <chapter number="11" style="c" sid="ISA 11" />
  <para style="s1">Ñkọk A-atooho Ufọk Yesi</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 11:1" />Ñkọk ayaatịppe awuọ ke adʌñ Yesi;</para>
  <para style="q2" vid="ISA 11:1">ato ke adʌñ amọ Ñkọk ayaanwịm mfịd.<verse eid="ISA 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 11:2" />Sịbidịd <char style="nd">Abọọñ</char> ayaadoro anye ke idem;</para>
  <para style="q2" vid="ISA 11:2">Sịbidịd aniọñ ye mbufiọk,</para>
  <para style="q2" vid="ISA 11:2">Sịbidịd nnọitem ye adudu,</para>
  <para style="q2" vid="ISA 11:2">Sịbidịd ifiọk ye mbaak Abasi,<verse eid="ISA 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 11:3" />anye ayaakop idadesịd ato mbaak Abọọñ.</para>
  <para style="b" vid="ISA 11:3" />
  <para style="q1" vid="ISA 11:3">Anye idiikpeeghe ikpe ikeene se anye akịt ke anyen amọ,</para>
  <para style="q2" vid="ISA 11:3">me adibiide ñkeene se anye akop ke utọñ amọ;<verse eid="ISA 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 11:4" />ado ke adinenido anye ayaakpe ikpe anọ mbon unana,</para>
  <para style="q2" vid="ISA 11:4">anye ayaakama unen anọ anam ubiere abaña mme uweene ke ederimbod.</para>
  <para style="q1" vid="ISA 11:4">Anye ayaamia ederimbod ke esañ inua amọ;</para>
  <para style="q2" vid="ISA 11:4">anyʌñ awot mbon ibak ke ibifịk ñkpọkinua amọ.<verse eid="ISA 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 11:5" />Adinenido adiido ñkpaha isịn amọ,</para>
  <para style="q2" vid="ISA 11:5">akpanikọ ayaawaña akanna isịn amọ.<verse eid="ISA 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 11:6" />Ewaikọd ayaadʌñ ye ñyịn edọñ,</para>
  <para style="q2" vid="ISA 11:6">ekpeñkem ayaanaa keed ye ebod,</para>
  <para style="q1" vid="ISA 11:6">ñyịn enañ ye ekpe ye unam isua keed ke emana eyaenaa keed;</para>
  <para style="q2" vid="ISA 11:6">etəkayịn adiinyʌñ idat ammọ usʌñ.<verse eid="ISA 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 11:7" />Enañ ayaadia ñkpọ keed ye amọnikọd,</para>
  <para style="q2" vid="ISA 11:7">nditọ ammọ eyaenaa keed,</para>
  <para style="q2" vid="ISA 11:7">ekpe ayaata mbid nte ayaaraenañ.<verse eid="ISA 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 11:8" />Nsekayịn ayaabre mbre akpere adudu abre,</para>
  <para style="q2" vid="ISA 11:8">etəkayịn ayaanyʌñ asịn ubọk amọ ke efọk ibọm.<verse eid="ISA 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 11:9" />Mme unam ami idiinamma ammọ idiọọk idiinyʌññọ isobo ammọ</para>
  <para style="q2" vid="ISA 11:9">ke afịd ndisana ikpọabod mmi,</para>
  <para style="q1" vid="ISA 11:9">sia ederimbod adiiyọhọ ye ifiọk <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ISA 11:9">kpa naña mmọọñ afʌk akpainyañ.<verse eid="ISA 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 11:10" />Ke usen ado Adʌñ Yesi ayaawuọ ada nte afọñidiọọñọ anọ mbon awo; mme idịd eyaetəkko ekeene anye ke akwọkudịm, ndin itie nduọkadudu amọ adiiyọhọ ye ubọọñ. <verse eid="ISA 11:10" /><verse number="11" style="v" sid="ISA 11:11" />Ke usen ado Abọọñ ayaanyanna ubọk amọ ayọhọ akañ iba adibọ ñyọhọnsʌhọ mbon e-ekebọkkọke eto Asiria, eto Usuuk Iyib, eto Adoro Iyib, eto Kuus, eto Elam, eto Babilọn, eto Hamad ye mme unaisọñ Mediterenia.<verse eid="ISA 11:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 11:12" />Anye ayaadịppe afọñidiọọñọ anọ mme idịd,</para>
  <para style="q2" vid="ISA 11:12">anyʌñ akoono mbon Isrel se ekesuan ke mme idịd abok;</para>
  <para style="q1" vid="ISA 11:12">anye ayaakoono mbon Yuda se ikisuana ke mbañ inaañ ederimbod abok</para>
  <para style="q2" vid="ISA 11:12">ke mbañ inaañ ederimbod.<verse eid="ISA 11:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 11:13" />Ufịb Ifrem ayaasop,</para>
  <para style="q2" vid="ISA 11:13">eyaenyʌñ esobo mbon usua Yuda;</para>
  <para style="q1" vid="ISA 11:13">Ifrem idiinyʌññọ ifịbe Yuda,</para>
  <para style="q2" vid="ISA 11:13">Yuda ñko idiisịnne ntịme ye Ifrem.<verse eid="ISA 11:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 11:14" />Ammọ eyaesọiyọ edʌk usuuk usobutịn Filistia;</para>
  <para style="q2" vid="ISA 11:14">ammọ eyaediana keed ebịme ñkpọ mbon se iba ke edem usakkautịn.</para>
  <para style="q1" vid="ISA 11:14">Ammọ eyaekan Edọm ye Mọb,</para>
  <para style="q2" vid="ISA 11:14">ndin mbon Amọn eyaedo ifʌn enọ ammọ.<verse eid="ISA 11:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 11:15" />
    <char style="nd">Abọọñ</char> ayaanam</para>
  <para style="q2" vid="ISA 11:15">ekamba akpainyañ Iyib asat;</para>
  <para style="q1" vid="ISA 11:15">anye ayaakama akpọsọñ afịm ubọk amọ</para>
  <para style="q2" vid="ISA 11:15">akwọọk anyọñ Inyañ Yufretis.</para>
  <para style="q1" vid="ISA 11:15">Anye ayaabakka inyañ ado asịn ke itie idịm itiaba</para>
  <para style="q2" vid="ISA 11:15">nọ ato do awo akeedodo asịne ikpaukod asaña aboiyo.<verse eid="ISA 11:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 11:16" />Ñnwaña usʌñ ayaaba anọ ñyọhọnsʌhọ mbon amọ</para>
  <para style="q2" vid="ISA 11:16">esʌhọke ke Asiria,</para>
  <para style="q1" vid="ISA 11:16">naña akeba anọ Isrel</para>
  <para style="q2" vid="ISA 11:16">idaha ammọ eketooho Iyib ewuọñọ edi.<verse eid="ISA 11:16" /></para>
  <chapter eid="ISA 11" />
  <chapter number="12" style="c" sid="ISA 12" />
  <para style="s1">Mme Ikwọ Ekọọm</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 12:1" />Ke usen ado afo ayaabo;</para>
  <para style="q1" vid="ISA 12:1">“Ami ñyaukọọm fiin <char style="nd">Abọọñ</char>.</para>
  <para style="q2" vid="ISA 12:1">Akpesʌkado a-afo akeyatta esịd ye ami,</para>
  <para style="q1" vid="ISA 12:1">iyadesịd mfo awọññọ iso añkpọñ</para>
  <para style="q2" vid="ISA 12:1">ndin afo amendọñ miin esịd.<verse eid="ISA 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 12:2" />Ke akpanikọ Abasi ado adinyaaña mmi;</para>
  <para style="q2" vid="ISA 12:2">ami ñyaabuọt idem ndin ndiikoppo ndịk.</para>
  <para style="q1" vid="ISA 12:2">
    <char style="nd">Abọọñ</char>, kpa <char style="nd">Abọọñ</char> ke idem amọ, ado adudu mmi ye ibededem<note caller="+" style="f"><char style="fr" closed="false">12:2 </char><char style="ft" closed="false">Akeme ido, </char><char style="fqa" closed="false">ikwọ</char></note> mmi;</para>
  <para style="q2" vid="ISA 12:2">anye akappa ado adinyaaña mmi.”<verse eid="ISA 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 12:3" />Ke idaara afo ayaakoi mmọọñ</para>
  <para style="q2" vid="ISA 12:3">ato ube adinyaaña.<verse eid="ISA 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 12:4" />Ke usen ado afo ayaabo:</para>
  <para style="q1" vid="ISA 12:4">“Nọ <char style="nd">Abọọñ</char> itooro, koot anyịñ amọ;</para>
  <para style="q2" vid="ISA 12:4">nam yak mme idịd ediọọñọ se anye anam,</para>
  <para style="q2" vid="ISA 12:4">enyʌñ edịppe anyịñ amọ ke anyọñ.<verse eid="ISA 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 12:5" />Kwọ nọ <char style="nd">Abọọñ</char>, sia anye anam mme utịppe ñkpọ;</para>
  <para style="q2" vid="ISA 12:5">yak afịd ederimbod ediọọñọ ami.<verse eid="ISA 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 12:6" />Bọñ ke akpọsọñ uyio nyʌñ kwọ ikwọ idaara, mbon Saiyọn,</para>
  <para style="q2" vid="ISA 12:6">sia Adisana Abasi Isrel ado akpọsọñ ke atu ndufo.”<verse eid="ISA 12:6" /></para>
  <chapter eid="ISA 12" />
  <chapter number="13" style="c" sid="ISA 13" />
  <para style="s1">Prọfesi A-abañake Babilọn</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 13:1" />Prọfesi a-abañake Babilọn naña Aisaiya ayịn Emọs akekịt:<verse eid="ISA 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 13:2" />Dịppe afọñidiọọñọ ke anainwañ anyọñ abod,</para>
  <para style="q2" vid="ISA 13:2">bọñ ñkpo nọ ammọ;</para>
  <para style="q1" vid="ISA 13:2">nyan ubọk tappa ammọ</para>
  <para style="q2" vid="ISA 13:2">nọ esaña edʌk ke mme inuaatob mme adot ukpono.<verse eid="ISA 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 13:3" />Ami mmenọ mbon a-ami ñkediọññọ nnịm mbeeñe ekọñ uyio;</para>
  <para style="q2" vid="ISA 13:3">ami mmedọkkọ mbon ekọñ mmi yak enam ekeene iyadesịd mmi,</para>
  <para style="q2" vid="ISA 13:3">mbon e-edaarake ke edikan mmi.<verse eid="ISA 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 13:4" />Kpañ utọñ, kop uyom ke mme ikpọabod,</para>
  <para style="q2" vid="ISA 13:4">nte ake ekamba atu awo!</para>
  <para style="q1" vid="ISA 13:4">Kpañ utọñ, kop akpọsọñ uyom ke atu mme idịd,</para>
  <para style="q2" vid="ISA 13:4">nte mme idịd ederimbod e-ebohoke itie keed!</para>
  <para style="q1" vid="ISA 13:4">
    <char style="nd">Abọọñ</char> Andikponñkan asʌk atañ</para>
  <para style="q2" vid="ISA 13:4">mbon ekọñ anịm anọ anwan.<verse eid="ISA 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 13:5" />Ammọ eto mme anyan idịd,</para>
  <para style="q2" vid="ISA 13:5">eto mme utịd ikpaanyọñ;</para>
  <para style="q1" vid="ISA 13:5">
    <char style="nd">Abọọñ</char> ye mme ñkpọekọñ iyadesịd amọ</para>
  <para style="q2" vid="ISA 13:5">adisobo afịd mme idịd.<verse eid="ISA 13:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 13:6" />Tua, sia usen <char style="nd">Abọọñ</char> akpere;</para>
  <para style="q2" vid="ISA 13:6">anye ayaadi nte nsobo a-atooho Andikponñkan<note caller="+" style="f"><char style="fr" closed="false">13:6 </char><char style="ft" closed="false">Ke Hibru ado, </char><char style="fqa" closed="false">Sadai</char></note>.<verse eid="ISA 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 13:7" />Ke ntak ami, afịd ubọk eyaemem,</para>
  <para style="q2" vid="ISA 13:7">afịd esịd eyaeyeeme ye ndịk.<verse eid="ISA 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 13:8" />Ndịk ayaamʌm ammọ;</para>
  <para style="q2" vid="ISA 13:8">ubiak ye ndutʌhọ eyaemʌm ammọ;</para>
  <para style="q2" vid="ISA 13:8">ammọ eyaemiañña nte awonwaan ake uman abiakka.</para>
  <para style="q1" vid="ISA 13:8">Ammọ eyaese idem ammọ ke ñkpaidem,</para>
  <para style="q2" vid="ISA 13:8">mme iso ammọ esak nte edemeikañ.<verse eid="ISA 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 13:9" />Se, usen <char style="nd">Abọọñ</char> asʌk adi,</para>
  <para style="q2" vid="ISA 13:9">idiọọk usen asañake ye ibak ye akpọsọñ iyadesịd,</para>
  <para style="q1" vid="ISA 13:9">adisobo isọñ</para>
  <para style="q2" vid="ISA 13:9">ñnyʌñ nsobo mme anamidiọọk e-ebaaha ke esịd amọ.<verse eid="ISA 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 13:10" />Mme ntantaafiọñ ikpaanyọñ ye mme uwak udịm ammọ</para>
  <para style="q2" vid="ISA 13:10">idiiwọttọ uyamma ammọ.</para>
  <para style="q1" vid="ISA 13:10">Utịn a-asakkake ayaakịm</para>
  <para style="q2" vid="ISA 13:10">afiọñ ñko idiiwọttọ uyamma amọ.<verse eid="ISA 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 13:11" />Ami ñyaamia ederimbod ufen akeene ndiọiñkpọ amọ,</para>
  <para style="q2" vid="ISA 13:11">mbon ibak akeene ndiọiñkpọ ammọ.</para>
  <para style="q1" vid="ISA 13:11">Ami ñyaatre ñkokkoidem mbon ntañidem,</para>
  <para style="q2" vid="ISA 13:11">ñnyʌñ nsuuho ntañidem mbon afai.<verse eid="ISA 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 13:12" />Ami ñyaanam mme awo esọbọ ekan nsọñudua kold,</para>
  <para style="q2" vid="ISA 13:12">enana ekan kold a-atooho Ọfia.<verse eid="ISA 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 13:13" />Ke ntoro ami ñyaanam mme ikpaanyọñ enyeñ;</para>
  <para style="q2" vid="ISA 13:13">ederimbod ñko ayaanyeghe asịkke akpọñ itie amọ</para>
  <para style="q1" vid="ISA 13:13">ato ntak iyadesịd <char style="nd">Abọọñ</char> Andikponñkan,</para>
  <para style="q2" vid="ISA 13:13">ke usen ufiob iyadesịd amọ.<verse eid="ISA 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 13:14" />Nte ñyịn edob e-ebịnekebịne,</para>
  <para style="q2" vid="ISA 13:14">nte edọñ i-imiinieghe andikpeme,</para>
  <para style="q1" vid="ISA 13:14">afịd ammọ eyaetịmme enyọñ ebịne mbon ammọ,</para>
  <para style="q2" vid="ISA 13:14">ammọ eyaefeeñe enyọñ isọñ emana ammọ<verse eid="ISA 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 13:15" />Eyaekịm awo akeedodo e-emʌmmọ ewot;</para>
  <para style="q2" vid="ISA 13:15">eyaekpok afịd mbon e-emʌmmọ ke akañkañ ewot.<verse eid="ISA 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 13:16" />Eyaetọ mme nsekayịn ammọ esuan ñkeñe-ñkeñe ke iso ammọ;</para>
  <para style="q2" vid="ISA 13:16">eyaebịme mme ñkpọufọk ammọ enyʌñ esappa ibaan ammọ.<verse eid="ISA 13:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ISA 13:17" />Ke akpanikọ, ami ñyaasịn asuan ke ufọọd ammọ ye mbon Med,</para>
  <para style="q2" vid="ISA 13:17">i-imiiyemme ibaña silfa</para>
  <para style="q2" vid="ISA 13:17">inyʌññọ ikop inemesịd ito kold.<verse eid="ISA 13:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 13:18" />Mme utịgha ammọ eyaewot ñkparawa;</para>
  <para style="q2" vid="ISA 13:18">ammọ idiinieghe mbọm ibaña mme nsekayịn,</para>
  <para style="q2" vid="ISA 13:18">idiinyʌññọ ise ntəkayịn ye esịd mbọm.<verse eid="ISA 13:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 13:19" />Babilọn, ñkpọuto mme idịd,</para>
  <para style="q2" vid="ISA 13:19">ñkpọ utañ ase ye ñkpọ ubọọñ mbon Babilọn,</para>
  <para style="q1" vid="ISA 13:19">ke Abasi adiiben ammọ ifep</para>
  <para style="q2" vid="ISA 13:19">nte Sọdọm ye Komora.<verse eid="ISA 13:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 13:20" />Awo ndomokeed idiidʌññọ ke esịd amọ;</para>
  <para style="q2" vid="ISA 13:20">awo ndomokeed idiibaaha do ke afịd emana;</para>
  <para style="q1" vid="ISA 13:20">mme akpeme ufene e-esañakesaña idiinyʌññọ ibọp atayad ammọ do,</para>
  <para style="q2" vid="ISA 13:20">mme akpemeedọñ idiinịmme udịmedọñ ammọ do yak eduọk adudu.<verse eid="ISA 13:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 13:21" />Ado mme unam e-edʌññọ ke akpautatan ediina do,</para>
  <para style="q2" vid="ISA 13:21">mme ewaikọd ediiyọhọ mme ufọk amọ;</para>
  <para style="q1" vid="ISA 13:21">do ke mme ñkịdikịd ediidʌñọ,</para>
  <para style="q2" vid="ISA 13:21">do ñko ke mme ebod ikọd ediitaam ñkprek.<verse eid="ISA 13:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 13:22" />Mme haiyena eyaedʌñ ke mme ñkpọsọñ itie ammọ,</para>
  <para style="q2" vid="ISA 13:22">mme ewaikọd eyaenyʌñ edʌñ ke mme mfọọn akwere ndidem ammọ.</para>
  <para style="q1" vid="ISA 13:22">Ini amọ a-akpere,</para>
  <para style="q2" vid="ISA 13:22">ndin mme usen amọ idiikpeeneke.<verse eid="ISA 13:22" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 13" />
  <chapter number="14" style="c" sid="ISA 14" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 14:1" />
    <char style="nd">Abọọñ</char> ayaakop mbọm abaña Yekọb;</para>
  <para style="q2" vid="ISA 14:1">ini keed mfen anye ayaamek Isrel</para>
  <para style="q2" vid="ISA 14:1">anyʌñ anọ ammọ itie idʌñ ke isọñ ammọ.</para>
  <para style="q1" vid="ISA 14:1">Mme isenawo eyaediana ye ammọ,</para>
  <para style="q2" vid="ISA 14:1">enyʌñ ediana keed ye ufọk Yekọb.<verse eid="ISA 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 14:2" />Mme idịd eyaeben ammọ</para>
  <para style="q2" vid="ISA 14:2">enyọñ mme itie idʌñ ammọ.</para>
  <para style="q1" vid="ISA 14:2">Ndin Isrel eyaedat mme idịd enie,</para>
  <para style="q2" vid="ISA 14:2">enyʌñ enam ammọ ekappa edo nditọufọk ideen ye ibaan ke isọñ <char style="nd">Abọọñ</char>.</para>
  <para style="q1" vid="ISA 14:2">Ammọ eyaenam mbon se ikisịn ammọ ifʌn ekappa edo ifʌn,</para>
  <para style="q2" vid="ISA 14:2">enyʌñ ekaara mbon se ikifiik ammọ.<verse eid="ISA 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 14:3" />Ke usen ake <char style="nd">Abọọñ</char> ufakka fiin asio ke ukuud ye ndutʌhọ ye akpọsọñ utom e-ekusịnne fiin, <verse eid="ISA 14:3" /><verse number="4" style="v" sid="ISA 14:4" />afo ayaatop ufiid ami abaña adidem Babilọn:</para>
  <para style="q1" vid="ISA 14:4">Se naña afiikawo adisịm utịd!</para>
  <para style="q2" vid="ISA 14:4">Se naña ifiobesịd amọ atre!<verse eid="ISA 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 14:5" />
    <char style="nd">Abọọñ</char> abuuñ esañ idiọọk awo,</para>
  <para style="q2" vid="ISA 14:5">esañubọọñ mme akama ukara,<verse eid="ISA 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 14:6" />a-akemiaha mme awo ke iyadesịd</para>
  <para style="q2" vid="ISA 14:6">ye mme eta i-imiitreke,</para>
  <para style="q1" vid="ISA 14:6">ndin ke ifiobesịd asuuhọ mme idịd</para>
  <para style="q2" vid="ISA 14:6">ye akpọsọñ usua i-imiitreke.<verse eid="ISA 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 14:7" />Afịd mme idʌñ eba ke nduọkadudu ye emem;</para>
  <para style="q2" vid="ISA 14:7">enyʌñ esio ikwọ ekwọ.<verse eid="ISA 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 14:8" />Kpa mme eto yunipa ye mme eto sida ke Lebanọn</para>
  <para style="q2" vid="ISA 14:8">unọ fiin ñnyọọ enyʌñ ebo,</para>
  <para style="q1" vid="ISA 14:8">“Idaha e-emausuuhọ fiin inịm,</para>
  <para style="q2" vid="ISA 14:8">awo ndomokeed idiighe idikpịkke ñnyịn iduọọk.”<verse eid="ISA 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 14:9" />Abioekpo asịne ntịme</para>
  <para style="q2" vid="ISA 14:9">adisoobo ye afo ke adidi mfo;</para>
  <para style="q1" vid="ISA 14:9">anye anam sịbidịd mbon se ikikpañña edukọọm fiin;</para>
  <para style="q2" vid="ISA 14:9">afịd mbon se ikido mme adadusʌñ ke ederimbod;</para>
  <para style="q1" vid="ISA 14:9">anye anam ammọ edakka ekpọñ mme ebekpo ammọ;</para>
  <para style="q2" vid="ISA 14:9">afịd mbon se ikido ndidem ke mme idịd.<verse eid="ISA 14:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 14:10" />Afịd ammọ eyaebọọrọ,</para>
  <para style="q2" vid="ISA 14:10">ammọ eyaubo fiin,</para>
  <para style="q1" vid="ISA 14:10">“Afo ñko amekop mmemidem, kpa naña ñnyịn iba;</para>
  <para style="q2" vid="ISA 14:10">afo amekappa aba nte ñnyịn.”<verse eid="ISA 14:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 14:11" />Eben afịd adudu mfo edọñ ke udi,</para>
  <para style="q2" vid="ISA 14:11">ye uyom mme ekpa mfo;</para>
  <para style="q1" vid="ISA 14:11">ndọñ etara ke idak mfo</para>
  <para style="q2" vid="ISA 14:11">mme utʌñ ufʌk fiin.<verse eid="ISA 14:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 14:12" />Se naña afo ato ke hefịn aduọ,</para>
  <para style="q2" vid="ISA 14:12">ntanta usiere, ayịn usiere!</para>
  <para style="q1" vid="ISA 14:12">Usio fiin eduọọk ke isọñ,</para>
  <para style="q2" vid="ISA 14:12">afo a-adooho ke ini keed amaasuuhọ mme idịd!<verse eid="ISA 14:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 14:13" />Afo amaabo ke esịd mfo,</para>
  <para style="q2" vid="ISA 14:13">“Ami ñyaadọọk ñkaa mme hefịn;</para>
  <para style="q1" vid="ISA 14:13">ami ñyaadịppe ebekpo mmi</para>
  <para style="q2" vid="ISA 14:13">anyọọñ akan mme ntantaafiọñ Abasi;</para>
  <para style="q1" vid="ISA 14:13">ami ñyaatie ke ubọọñ ke abod mbono,</para>
  <para style="q2" vid="ISA 14:13">ke ñkoññkan etịñe Abod Safọn.<verse eid="ISA 14:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 14:14" />Ami ñyaadọọk mbọhọ etịñe ntọñanyọñ;</para>
  <para style="q2" vid="ISA 14:14">ami ñyaanam idem mmi aba nte Andikoñ Ñkan Abasi.”<verse eid="ISA 14:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 14:15" />Ado usuuhọ fiin enịm ke ndaha mme akpañkpa,</para>
  <para style="q2" vid="ISA 14:15">usuuhọ fiin esịn ke ntəño ñkan ube.<verse eid="ISA 14:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 14:16" />Mbon se ukịt fiin ewuuk anyen use fiin,</para>
  <para style="q2" vid="ISA 14:16">idem akpa ammọ abaña uwem mfo:</para>
  <para style="q1" vid="ISA 14:16">“Me awo a-akenyeeñeke ederimbod</para>
  <para style="q2" vid="ISA 14:16">anyʌñ anam mme abioubọọñ enyeñ ado ami?<verse eid="ISA 14:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 14:17" />Me awo a-akenamma ederimbod akappa anaan,</para>
  <para style="q2" vid="ISA 14:17">a-akekanna mme abio</para>
  <para style="q2" vid="ISA 14:17">inyʌññọ iyak mme ifʌn amọ etịmme enyọñ abio ammọ ado ami?”<verse eid="ISA 14:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 14:18" />Afịd mme ndidem mme idịd esuuk enaa ke itie ubọọñ ammọ,</para>
  <para style="q2" vid="ISA 14:18">anie udi amọ anie.<verse eid="ISA 14:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 14:19" />Ado usio fiin ke udi mfo eduọọk</para>
  <para style="q2" vid="ISA 14:19">nte ñkọk e-esịnne;</para>
  <para style="q1" vid="ISA 14:19">ufʌk fiin ke mme akpo mbon e-emaekewot,</para>
  <para style="q2" vid="ISA 14:19">ye mbon se ekekịm ke akañkañ,</para>
  <para style="q2" vid="ISA 14:19">mbon se ikisọiyọ idʌk ube itiad.</para>
  <para style="q1" vid="ISA 14:19">Nte akpo awo e-efiighe ke ñkpad,<verse eid="ISA 14:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="ISA 14:20" />afo uduukeeneke ammọ uba ke itie ikpo,</para>
  <para style="q1" vid="ISA 14:20">sia afo amebiat abio mfo</para>
  <para style="q2" vid="ISA 14:20">anyʌñ awot mbon mfo.</para>
  <para style="b" vid="ISA 14:20" />
  <para style="b" vid="ISA 14:20" />
  <para style="q1" vid="ISA 14:20">Ke esiak anyịñ nditọ mbon ibak aba</para>
  <para style="q2" vid="ISA 14:20">tutu amama.<verse eid="ISA 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 14:21" />Diọñ itie se ediwot nditọ amọ</para>
  <para style="q2" vid="ISA 14:21">ke ntak ndiọiñkpọ mme eteete ammọ;</para>
  <para style="q1" vid="ISA 14:21">ammọ inaaha edakkaeda enyʌñ eben isọñ enie</para>
  <para style="q2" vid="ISA 14:21">enyʌñ efʌk isọñ ye mme abio ammọ.<verse eid="ISA 14:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 14:22" />“Ami ñyaadakka nda ñnwana ekọñ ye ammọ,”</para>
  <para style="q2" vid="ISA 14:22">
    <char style="nd">Abọọñ</char> Andikponñkan atañ.</para>
  <para style="q1" vid="ISA 14:22">“Ami ñyaasọọk anyịñ Babilọn ye nsʌhọ amọ mfep,</para>
  <para style="q2" vid="ISA 14:22">nditọ amọ ye ubon amọ,”</para>
  <para style="q2" vid="ISA 14:22">
    <char style="nd">Abọọñ</char> atañ.<verse eid="ISA 14:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 14:23" />“Ami ñyaanam anye akappa ado itie idʌñ anọ mme ñkịdikịd</para>
  <para style="q2" vid="ISA 14:23">anyʌñ akappa ado ndua;</para>
  <para style="q1" vid="ISA 14:23">ami ñyaakwọọk anye ye ayañ nsobo,”</para>
  <para style="q2" vid="ISA 14:23">
    <char style="nd">Abọọñ</char> Andikponñkan atañ.<verse eid="ISA 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 14:24" />
    <char style="nd">Abọọñ</char> Andikponñkan anwọñọ,</para>
  <para style="q1" vid="ISA 14:24">“Ke akpanikọ, kpa naña ami nduak adinam, kpa ntoro ke adiido,</para>
  <para style="q2" vid="ISA 14:24">ñko naña ami ñyem, kpa ntoro ke adiitịppe.<verse eid="ISA 14:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 14:25" />Ami ñyaasọnnọ mbon Asiria ke isọñ mmi;</para>
  <para style="q2" vid="ISA 14:25">ami ñyaasọnnọ ammọ mbono ke mme ikpọabod mmi.</para>
  <para style="q1" vid="ISA 14:25">Eyaedooro mbon mmi mbiomo amọ efep,</para>
  <para style="q2" vid="ISA 14:25">eyaenyʌñ edooro mbiomo amọ ke afara ammọ efep.”<verse eid="ISA 14:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="ISA 14:26" />Ami ado uduak e-ebiereke ebaña afịd ekondo;</para>
  <para style="q2" vid="ISA 14:26">anyem ado ubọk a-anyannake afʌk afịd mme idịd.<verse eid="ISA 14:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 14:27" />Sia <char style="nd">Abọọñ</char> Andikponñkan amaabiide,</para>
  <para style="q2" vid="ISA 14:27">anie akeme adibiat uduak amọ?</para>
  <para style="q2" vid="ISA 14:27">Ubọk amọ anyanna, anie akeme adinam anye atịmme edem?<verse eid="ISA 14:27" /></para>
  <para style="s1">Prọfesi A-abañake Mbon Filistia</para>
  <para style="p">
    <verse number="28" style="v" sid="ISA 14:28" />Ekenọ prọfesi ami ke isua a-adidem Ahas akekpaaha:<verse eid="ISA 14:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 14:29" />Ikiidaara, afịd ndufo mbon Filistia,</para>
  <para style="q2" vid="ISA 14:29">ibo ke esañ a-akimiaha ndufo abʌññọ;</para>
  <para style="q1" vid="ISA 14:29">ibọm ayaato ke adʌñ udʌkikọd ado awuọ,</para>
  <para style="q2" vid="ISA 14:29">mfịd amọ adiiba nte ika, ifod udʌkikọd.<verse eid="ISA 14:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 14:30" />Mme akpọikpọi uweene eyaekịt mfuudo,</para>
  <para style="q2" vid="ISA 14:30">mbon unana ñko eyaenaa ke ifuuro.</para>
  <para style="q1" vid="ISA 14:30">Ado ñyaasobo adʌñ ubon mfo ke akañ;</para>
  <para style="q2" vid="ISA 14:30">akañ ñko ayaawot ñyọhọnsʌhọ ubon mfo.<verse eid="ISA 14:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="ISA 14:31" />Itua, ndufo inuaatob! Iseeme, ndufo abio!</para>
  <para style="q2" vid="ISA 14:31">Iyeeme, afịd ndufo mbon Filistia!</para>
  <para style="q1" vid="ISA 14:31">Adaaha nsʌñikañ ato adoro adi,</para>
  <para style="q2" vid="ISA 14:31">ndin ndomokeed ibaaha anye a-adaaha edem ke atu mbon ekọñ amọ.<verse eid="ISA 14:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 14:32" />Nsoo ibọọrọ ke ediinọ</para>
  <para style="q2" vid="ISA 14:32">mme isʌñutom e-etooho idịd ado edi?</para>
  <para style="q1" vid="ISA 14:32">“<char style="nd">Abọọñ</char> a-amaana abọp Saiyọn,</para>
  <para style="q2" vid="ISA 14:32">ndin ke anye ke mbon ukuud amọ ediikịt itie udịbe.”<verse eid="ISA 14:32" /></para>
  <chapter eid="ISA 14" />
  <chapter number="15" style="c" sid="ISA 15" />
  <para style="s1">Prọfesi A-abañake Mọb</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 15:1" />Prọfesi a-abañake Mọb:</para>
  <para style="q1" vid="ISA 15:1">Ar ke Mọb atak,</para>
  <para style="q2" vid="ISA 15:1">esobo anye ke akonayio keed!</para>
  <para style="q1" vid="ISA 15:1">Kii ke Mọb atak,</para>
  <para style="q2" vid="ISA 15:1">esobo anye ke akonayio keed!<verse eid="ISA 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 15:2" />Dibon adọọk akaa ke itieukpono amọ,</para>
  <para style="q2" vid="ISA 15:2">ke mme ñkoñ-ñkoñ itie amọ aditua;</para>
  <para style="q2" vid="ISA 15:2">Mọb atua abaña Nebo ye Medeba.</para>
  <para style="q1" vid="ISA 15:2">Ekwaat iwuod afịd awo</para>
  <para style="q2" vid="ISA 15:2">enyʌñ ekwaat afịd ñwaebek esio.<verse eid="ISA 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 15:3" />Ammọ esịne afọñikpo ke mme efaak;</para>
  <para style="q2" vid="ISA 15:3">ke mme anyọñ akọm ye ke mme afe</para>
  <para style="q1" vid="ISA 15:3">afịd ammọ etua,</para>
  <para style="q2" vid="ISA 15:3">enyanna enaa ke ntuaña.<verse eid="ISA 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 15:4" />Hesbọn ye Eliele etua ke akpọsọñ uyio,</para>
  <para style="q2" vid="ISA 15:4">ekop uyio ammọ ke Yahas.</para>
  <para style="q1" vid="ISA 15:4">Ke ntoro mbon ekọñ Mọb etuaaña,</para>
  <para style="q2" vid="ISA 15:4">esịd anyʌñ aduọ ammọ.<verse eid="ISA 15:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 15:5" />Esịd mmi atua abaña Mọb;</para>
  <para style="q2" vid="ISA 15:5">mbon amọ se ibọkkọ ekọñ efeghe tutu ekesịm Soa,</para>
  <para style="q2" vid="ISA 15:5">tutu ekesịm Eklad Selisiya.</para>
  <para style="q1" vid="ISA 15:5">Ammọ edọọk anyọñ abod Luhid,</para>
  <para style="q2" vid="ISA 15:5">esaña eka esʌk etua;</para>
  <para style="q1" vid="ISA 15:5">ke usʌñ e-ekaaha Horonaim</para>
  <para style="q2" vid="ISA 15:5">ammọ eseeme ebaña nsobo ammọ.<verse eid="ISA 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 15:6" />Mme mmọọñ Nimrim esat,</para>
  <para style="q2" vid="ISA 15:6">mbid ñko enyʌñ eyeeme;</para>
  <para style="q1" vid="ISA 15:6">inwañ ammọ ibaaha aba</para>
  <para style="q2" vid="ISA 15:6">ñkpọ ndomokeed se ido awawa ibaaha aba.<verse eid="ISA 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 15:7" />Mme inie se ammọ ekenwana ebono,</para>
  <para style="q2" vid="ISA 15:7">ammọ ekoono ekaa ke Abedeñ mme Pọpla.<verse eid="ISA 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 15:8" />Uyom ayịd ammọ asịm adaña Mọb;</para>
  <para style="q2" vid="ISA 15:8">ntuaña ammọ asịm Ekleim,</para>
  <para style="q2" vid="ISA 15:8">eseeme ammọ asịm Bee Elim.<verse eid="ISA 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 15:9" />Mme mmọọñ Dimon eyọhọ ye iyiib,</para>
  <para style="q2" vid="ISA 15:9">ado ami nsʌk ndiinanam se ikan ado ke Dimon,</para>
  <para style="q1" vid="ISA 15:9">ñnyʌñ ndọñ ekpe abịne mbon Mọb se ibọkkọ ekọñ</para>
  <para style="q2" vid="ISA 15:9">ye mbon se isʌhọ ke isọñ ado.<verse eid="ISA 15:9" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 15" />
  <chapter number="16" style="c" sid="ISA 16" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 16:1" />Nọ nditọedọñ esọk adidem ke abio nte taks,</para>
  <para style="q1" vid="ISA 16:1">ato Sela, akaaña akpautatan,</para>
  <para style="q2" vid="ISA 16:1">tutu asịm abod Adiaha Saiyọn.<verse eid="ISA 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 16:2" />Nte mme inuen e-efịmmefịm</para>
  <para style="q2" vid="ISA 16:2">ye mbon se enək esio ke efọk,</para>
  <para style="q1" vid="ISA 16:2">kpa ntoro ke ibaan Mọb eba</para>
  <para style="q2" vid="ISA 16:2">ke inua ufeghe mmọọñ Anọn.<verse eid="ISA 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 16:3" />“Biere ke esịd mfo,” nte Mọb atañña.</para>
  <para style="q2" vid="ISA 16:3">“Nọ ubiere.</para>
  <para style="q1" vid="ISA 16:3">Nam ndukpọñ mfo aba nte ekịm akonayio,</para>
  <para style="q2" vid="ISA 16:3">ke ufọọd uweemeayio.</para>
  <para style="q1" vid="ISA 16:3">Dịp mbon se ibọkkọ ñkpakọb,</para>
  <para style="q2" vid="ISA 16:3">kuunyʌñ unam mbon e-ebọkkọke ekọñ ibak.<verse eid="ISA 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 16:4" />Yak mbon Mọb se ibọkkọ ekọñ eba ye afo;</para>
  <para style="q2" vid="ISA 16:4">do ubọkkọ nọ ammọ to ubọk mbon nsobo.”</para>
  <para style="b" vid="ISA 16:4" />
  <para style="q1" vid="ISA 16:4">Utịd afiikawo ayaadi,</para>
  <para style="q2" vid="ISA 16:4">nsobo ñko ayaakweeñe;</para>
  <para style="q2" vid="ISA 16:4">mbon akpọsọñ ufiik eyaesoomo ke isọñ.<verse eid="ISA 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 16:5" />Ediikama ima isiak ebekpo ubọọñ;</para>
  <para style="q2" vid="ISA 16:5">awodeen ayaatie do ke akpanikọ;</para>
  <para style="q2" vid="ISA 16:5">anye adiito ufọk<note caller="+" style="f"><char style="fr" closed="false">16:5 </char><char style="ft" closed="false">Ke Hibru ado </char><char style="fqa" closed="false">atayad.</char></note> Defid,</para>
  <para style="q1" vid="ISA 16:5">anye a-akpeeghe ikpe ke unen</para>
  <para style="q2" vid="ISA 16:5">anyʌñ asọp ke adiyem adinenido.<verse eid="ISA 16:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 16:6" />Ñnyịn imikop ntañidem Mọb,</para>
  <para style="q2" vid="ISA 16:6">se naña ñkokkoidem amọ ñko akpon!</para>
  <para style="q1" vid="ISA 16:6">Ñkịdidem amọ, ntañidem amọ ye usọñanyen amọ;</para>
  <para style="q2" vid="ISA 16:6">ado ñkpooninua amọ ado ukpọk.<verse eid="ISA 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 16:7" />Ke ntoro mbon Mọb etuaña,</para>
  <para style="q2" vid="ISA 16:7">ammọ ediana keed etua ebaña Mọb.</para>
  <para style="q1" vid="ISA 16:7">Eseeme enyʌñ efʌhọ</para>
  <para style="q2" vid="ISA 16:7">ebaña nsaad ndomuyo a-atooho Kii Haresed.<verse eid="ISA 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 16:8" />Mme inwañ Hesbọn eyeeme,</para>
  <para style="q2" vid="ISA 16:8">ye mme fain Sibma ñko.</para>
  <para style="q1" vid="ISA 16:8">Mbọọñ ke mme idịd</para>
  <para style="q2" vid="ISA 16:8">esọnnọ nti fain,</para>
  <para style="q1" vid="ISA 16:8">a-adooho amaakesesịm Yasa ini keed koo</para>
  <para style="q2" vid="ISA 16:8">anyʌñ atara asịm akpautatan.</para>
  <para style="q1" vid="ISA 16:8">Ñkọk ammọ etara ewuọñọ</para>
  <para style="q2" vid="ISA 16:8">tutu esịm akpainyañ<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">Akeme ido Ikpaikpa Akpainyañ.</char></note>.<verse eid="ISA 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 16:9" />Ke ntoro ami ntua, kpa naña Yasa atua,</para>
  <para style="q2" vid="ISA 16:9">mbaña mme fain Sibma.</para>
  <para style="q1" vid="ISA 16:9">Hesbọn ye Eliele,</para>
  <para style="q2" vid="ISA 16:9">ami mmifʌk ndufo ye mmọọñayịd!</para>
  <para style="q1" vid="ISA 16:9">Ñkpo idaara ke abaña mme ndad-ndad mfịd ndufo</para>
  <para style="q2" vid="ISA 16:9">ye ke mme idọk mfo edobo.<verse eid="ISA 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 16:10" />Esio idaara ye inemesịd efep ke mme inwañ mfịd mfo</para>
  <para style="q2" vid="ISA 16:10">awo ndomokeed ikwọọhọ ikwọ inyʌññọ ibọñ ñkpo ke mme inwañ fain;</para>
  <para style="q1" vid="ISA 16:10">awo ndomokeed inyʌññọ iben mfịd fain ika mme afe unam ukọd,</para>
  <para style="q2" vid="ISA 16:10">sia ami mmetre afịd ubọñ ñkpo.<verse eid="ISA 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 16:11" />Esịd mmi aseeme abaña Mọb nte ekpa,</para>
  <para style="q2" vid="ISA 16:11">ntəño esịd mmi abaña Kii Haresed.<verse eid="ISA 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 16:12" />Mọb amaadọọk ke ñkoñ-ñkoñ itie amọ,</para>
  <para style="q2" vid="ISA 16:12">idem amọ amem;</para>
  <para style="q1" vid="ISA 16:12">ke ini anye akaaha ñwommo amọ adikibọñ akam,</para>
  <para style="q2" vid="ISA 16:12">ado ibaaha ufọn.<verse eid="ISA 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 16:13" />Anyem ado ikọ se <char style="nd">Abọọñ</char> amaaketatañ abaña Mọb. <verse eid="ISA 16:13" /><verse number="14" style="v" sid="ISA 16:14" />Ado idahami <char style="nd">Abọọñ</char> abo: “Ke ufañ isua ita, naña ayịnufọk a-mbedutom abọppọ akpebatta ammọ, eyaemiom ubọọñ Mọb enyʌñ ese afịd mbon amọ ke ndek, ndin mbon amọ se idiibọkkọ ekọñ ediido ibad-ibad enyʌñ eba mmeme-mmeme.”<verse eid="ISA 16:14" /></para>
  <chapter eid="ISA 16" />
  <chapter number="17" style="c" sid="ISA 17" />
  <para style="s1">Prọfesi A-abañake Damaskọs</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 17:1" />Prọfesi a-abañake Damaskọs:</para>
  <para style="q1" vid="ISA 17:1">“Ke akpanikọ Damaskọs idiidooho aba abio,</para>
  <para style="q2" vid="ISA 17:1">ado adiido itoon.<verse eid="ISA 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 17:2" />Mme awo eyaewuọñọ ekpọñ mme abio Aro</para>
  <para style="q2" vid="ISA 17:2">enọ mme udịmedọñ, ammọ eyaenyʌñ enaa do,</para>
  <para style="q2" vid="ISA 17:2">awo ndomokeed idiibaaha se inam ammọ ekop ndịk.<verse eid="ISA 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 17:3" />Akpọsọñ abio ayaasop akpọñ Ifrem,</para>
  <para style="q2" vid="ISA 17:3">adudu ubọọñ ayaakpọñ Damaskọs;</para>
  <para style="q1" vid="ISA 17:3">nsʌhọ Aram ayaabit</para>
  <para style="q2" vid="ISA 17:3">ubọọñ nditọ Isrel,”</para>
  <para style="q2" vid="ISA 17:3">Abọọñ Andikponñkan atañ.<verse eid="ISA 17:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 17:4" />“Ke usen ado ubọọñ Yekọb ayaafoño;</para>
  <para style="q2" vid="ISA 17:4">akpọñ ke idem amọ ayaatak.<verse eid="ISA 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 17:5" />Anye adiiba nte naña mbon idọk ekpok ndadaha abakpa,</para>
  <para style="q2" vid="ISA 17:5">ekoono ñkwa abakpa ekọọhọ ke ubọk;</para>
  <para style="q1" vid="ISA 17:5">nte mbon e-ekoonoke ñyọhọnsʌhọ ikpitok abakpa</para>
  <para style="q2" vid="ISA 17:5">ke Abedeñ Refaim.<verse eid="ISA 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 17:6" />Ado usʌk ñyọhọnsʌhọ ikpitok abakpa eyaeba,</para>
  <para style="q2" vid="ISA 17:6">nte ke ini e-emiaha eto ọlif,</para>
  <para style="q1" vid="ISA 17:6">ekpọñ ọlif iba me ita ke mme ñkọk e-ebaaha ke atịñe,</para>
  <para style="q2" vid="ISA 17:6">ekpọñ inaañ me ition ke ñkọk anwịmme nọ awak,”</para>
  <para style="q2" vid="ISA 17:6">
    <char style="nd">Abọọñ</char>, Abasi Isrel atañ.<verse eid="ISA 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 17:7" />Ke usen ado mme awo eyaebịne Andibod ammọ</para>
  <para style="q2" vid="ISA 17:7">enyʌñ ekanna anyen ese Adisana Abasi Isrel.<verse eid="ISA 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 17:8" />Ammọ idiiseeghe mme itieukpono,</para>
  <para style="q2" vid="ISA 17:8">mme ubọkutom ubọk ammọ,</para>
  <para style="q1" vid="ISA 17:8">ammọ idiinyʌññọ inie ukpono inọ mme abai Asera</para>
  <para style="q2" vid="ISA 17:8">ye mme itieukpono insensi se ubọk ammọ enam.<verse eid="ISA 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 17:9" />Ke usen ado mme ñkpọsọñ abio ammọ, a-ammọ ekekpọññọ ke ntak nditọ Isrel, adiibit mme itie se ekesịn ekpọñ yak mbid akọt afʌk. Ndin afịd adiido nsobo.<verse eid="ISA 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 17:10" />Afo amefre Abasi Andunyaaña fiin;</para>
  <para style="q2" vid="ISA 17:10">afo utoiyoke Itiad, ye itie udịbe mfo.</para>
  <para style="q1" vid="ISA 17:10">Ke ntoro, akpesʌkado a-afo atọọhọ mme mfịdinwañ se ifọọn ikan</para>
  <para style="q2" vid="ISA 17:10">ye mme fain e-etoboketobo eto asen idịd,<verse eid="ISA 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 17:11" />akpesʌkado ke usen a-afo atọọhọ ammọ, afo anam ammọ ekọt,</para>
  <para style="q2" vid="ISA 17:11">ñko ke ubakusen a-afo atọọhọ ammọ, afo anam ammọ etịppe,</para>
  <para style="q1" vid="ISA 17:11">kpa ye ado idọk adiiba nte ikpu-ikpu</para>
  <para style="q2" vid="ISA 17:11">ke usen udọñọ ye ubiak i-imiikoppo ukọk.<verse eid="ISA 17:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 17:12" />Adọdiọọk anọ uwak mme idịd e-eyatta akpọsọñ esịd,</para>
  <para style="q2" vid="ISA 17:12">eyomo nte akpainyañ a-anamma akpọsọñ uyom!</para>
  <para style="q1" vid="ISA 17:12">Adọdiọọk anọ mbon e-ekuunọ,</para>
  <para style="q2" vid="ISA 17:12">ekuun nte ekamba mmọọñ akuun!<verse eid="ISA 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 17:13" />Akpesʌkado mme awo ekuunọ naña ufeghe mmọọñ akuun,</para>
  <para style="q2" vid="ISA 17:13">anye amaasua inọ ammọ, ammọ efeeñe eka anyan usʌñ,</para>
  <para style="q1" vid="ISA 17:13">afịm aben ammọ nte mbio ke mme anyọñ abod,</para>
  <para style="q2" vid="ISA 17:13">nte uwewere mbid ke iso akpọsọñ ayobio.<verse eid="ISA 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 17:14" />Ke ndubiayio, adiwad ndịk!</para>
  <para style="q2" vid="ISA 17:14">Mbemiso ubakusen, ammọ enyọñ!</para>
  <para style="q1" vid="ISA 17:14">Anyem ado udeeme mbon se ibịme ñkpọ ñnyịn,</para>
  <para style="q2" vid="ISA 17:14">utịb mbon e-ebịmeke inie ñnyịn.<verse eid="ISA 17:14" /></para>
  <chapter eid="ISA 17" />
  <chapter number="18" style="c" sid="ISA 18" />
  <para style="s1">Prọfesi A-abañake Kuus</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 18:1" />Adọdiọọk anọ isọñ ñkukuñkpọyọriyọ</para>
  <para style="q2" vid="ISA 18:1">ke mben inyañ Kuus,<verse eid="ISA 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 18:2" />a-adọññọ mme isʌñutom esaña ke akpainyañ</para>
  <para style="q2" vid="ISA 18:2">ke mme ubom ñnyanyaha ke anyọñ mmọọñ.</para>
  <para style="b" vid="ISA 18:2" />
  <para style="q1" vid="ISA 18:2">Ikaa, ndufo mme asọbusọb isʌñutom,</para>
  <para style="q1" vid="ISA 18:2">ibịne mbon enyọọñọ anyan enyʌñ enie ndọnọ ikpaidem,</para>
  <para style="q2" vid="ISA 18:2">mbon a-ndịk ammọ amʌmmọ mme awo ke anyan usʌñ,</para>
  <para style="q1" vid="ISA 18:2">idịd mbon afai ye asen usem,</para>
  <para style="q2" vid="ISA 18:2">ake mme inyañ ebakkake isọñ ammọ.<verse eid="ISA 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 18:3" />Afịd ndufo se iba ke ekondo,</para>
  <para style="q2" vid="ISA 18:3">ndufo e-edʌññọ ke ederimbod,</para>
  <para style="q1" vid="ISA 18:3">emaedịppe afọñidiọọñọ ke mme ikpọabod,</para>
  <para style="q2" vid="ISA 18:3">ndufo eyaekịt,</para>
  <para style="q1" vid="ISA 18:3">ñko emaefịt adukpoñ,</para>
  <para style="q2" vid="ISA 18:3">ndufo eyaekop.<verse eid="ISA 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 18:4" />Se <char style="nd">Abọọñ</char> atañ annọọ miin ado ami:</para>
  <para style="q2" vid="ISA 18:4">“Ami ñyaadop uyio ñnyʌñ ntie ke ebekpo mmi nse,</para>
  <para style="q1" vid="ISA 18:4">nte ufiob a-awuọhọ ato utịn,</para>
  <para style="q2" vid="ISA 18:4">nte adaaha mbara ke ufiob ini idọk.”<verse eid="ISA 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 18:5" />Sia, mbemiso ini idọk, ke ini mme ñkpokpoñ emaekweeñe,</para>
  <para style="q2" vid="ISA 18:5">ñkpokpoñ anyʌñ akappa ado ndad-ndad kreb,</para>
  <para style="q1" vid="ISA 18:5">anye ayaakama akọbọ akpok mme ñkọk ammọ,</para>
  <para style="q2" vid="ISA 18:5">anyʌñ akpok mme ntiañña ñkọk akoono.<verse eid="ISA 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 18:6" />Eyaebono afịd ammọ enọ mme inuen ikpọabod</para>
  <para style="q2" vid="ISA 18:6">ye mme ndiọi unam;</para>
  <para style="q1" vid="ISA 18:6">mme inuen eyaekama ammọ edia afịd ini ndaayio</para>
  <para style="q2" vid="ISA 18:6">mme ndiọi unam ke afịd ini ndedeñ atueb.<verse eid="ISA 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 18:7" />Ke ini ado eyaeben mme enọ esọk <char style="nd">Abọọñ</char> Andikponñkan</para>
  <para style="q1" vid="ISA 18:7">eto mbon e-enyọọñọ enyʌñ edọnọ ikpaidem,</para>
  <para style="q2" vid="ISA 18:7">eto mbon se mme awo enekke ebaak,</para>
  <para style="q1" vid="ISA 18:7">idịd mbon afai ye asen usem,</para>
  <para style="q2" vid="ISA 18:7">a-mme inyañ ebakkake isọñ ammọ,</para>
  <para style="m" vid="ISA 18:7">eyaeben mme enọ ami edi ke Abod Saiyọn, itie e-ekoodo Anyịñ <char style="nd">Abọọñ</char> Andikponñkan.<verse eid="ISA 18:7" /></para>
  <chapter eid="ISA 18" />
  <chapter number="19" style="c" sid="ISA 19" />
  <para style="s1">Prọfesi A-abañake Iyib</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 19:1" />Prọfesi a-abañake Iyib:</para>
  <para style="q1" vid="ISA 19:1">Se, <char style="nd">Abọọñ</char> a-awat ke ntọñanyọñ a-asọppọ,</para>
  <para style="q2" vid="ISA 19:1">ndin asʌk adi isọñ Iyib.</para>
  <para style="q1" vid="ISA 19:1">Mme ubobod abasi Iyib enyeñ idem ke iso amọ,</para>
  <para style="q2" vid="ISA 19:1">esịd anyʌñ aduọ mbon Iyib ke ndịk.<verse eid="ISA 19:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ISA 19:2" />“Ami ñyaasịn anwan ke ufọọd awo Iyib ye emọ-emọ awo Iyib;</para>
  <para style="q2" vid="ISA 19:2">ayịneka ayaanwana ye ayịneka,</para>
  <para style="q2" vid="ISA 19:2">mbọhọidʌñ ayaanwana ye mbọhọidʌñ,</para>
  <para style="q2" vid="ISA 19:2">abio ayaanwana ye abio,</para>
  <para style="q2" vid="ISA 19:2">idịd ayaanwana ye idịd.<verse eid="ISA 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 19:3" />Esịd ayaaduọ nditọ Iyib,</para>
  <para style="q2" vid="ISA 19:3">ndin ami ñyaanam uduak ammọ akappa ado ikpu-ikpu;</para>
  <para style="q1" vid="ISA 19:3">ammọ eyaekebịp mme ubobod abasi ye mme sịbidịd ñkpañña,</para>
  <para style="q2" vid="ISA 19:3">mme nsañaekpo ye mme mbiaidiọñ.<verse eid="ISA 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 19:4" />Ami ñyaasaana nditọ Iyib ñyaak</para>
  <para style="q2" vid="ISA 19:4">nsịn ke ubọk eteufọk ibak,</para>
  <para style="q1" vid="ISA 19:4">ndin aniendịk adidem ayaakara ammọ,”</para>
  <para style="q2" vid="ISA 19:4">Abọọñ atañ, <char style="nd">Abọọñ</char> Andikponñkan.<verse eid="ISA 19:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 19:5" />Mmọọñ inyañ ayaasat,</para>
  <para style="q2" vid="ISA 19:5">afịd isọñ mmọọñ ñko ayaasat.<verse eid="ISA 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 19:6" />Mme usʌñmmọọñ eyaetebe;</para>
  <para style="q2" vid="ISA 19:6">mme idịm Iyib eyaesuuhọ enyʌñ esat.</para>
  <para style="q1" vid="ISA 19:6">Ñnyanyaha, ye mme eto mben inyañ eyaeyeeme,<verse eid="ISA 19:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="ISA 19:7" />ye afịd se etọ ke mben mmọọñ Nail</para>
  <para style="q2" vid="ISA 19:7">ke inua akpa inyañ.</para>
  <para style="q1" vid="ISA 19:7">Afịd inwañ se etọ ke mben Nail</para>
  <para style="q2" vid="ISA 19:7">eyaesat, afịm ayaanyʌñ asuan ndin ammọ ibaaha aba.<verse eid="ISA 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 19:8" />Mme akọiyak eyaemịm mmịm enyʌñ eseeme,</para>
  <para style="q2" vid="ISA 19:8">afịd mbon se itop uwaam isịn ke inyañ Nail;</para>
  <para style="q1" vid="ISA 19:8">mbon se itop iyịre isịn ke mmọọñ</para>
  <para style="q2" vid="ISA 19:8">eyaeyeppe eto ntuaña.<verse eid="ISA 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 19:9" />Mbon e-ekamake mfañ flaks enam ñkpọ eyaenie iduọesịd,</para>
  <para style="q2" vid="ISA 19:9">idodanyen ayaakweeñe akpọñ mbon se ituak mfọọn afọñ linen.<verse eid="ISA 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 19:10" />Ukuud ayaamʌm mbon e-enamma utom afọñ,</para>
  <para style="q2" vid="ISA 19:10">ñko mme anwana akʌk nto utom usen eyaenie mbʌññọesịd.<verse eid="ISA 19:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 19:11" />Mme adaaha Soan idooho ñkpọ mfen ikan ndisịme;</para>
  <para style="q2" vid="ISA 19:11">item se mbon aniọñ Fero enọ ibaaha ufọn.</para>
  <para style="q1" vid="ISA 19:11">Afo akeme die adibo Fero,</para>
  <para style="q2" vid="ISA 19:11">“Ami ndo keed ke atu mbon aniọñ,</para>
  <para style="q2" vid="ISA 19:11">mbed mme ndidem esed”?<verse eid="ISA 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 19:12" />Ndufo mbon aniọñ eba ke mmọọ idahami?</para>
  <para style="q2" vid="ISA 19:12">Yak ammọ uwọt fiin enyʌñ enam afo adiọọñọ</para>
  <para style="q1" vid="ISA 19:12">se <char style="nd">Abọọñ</char> Andikponñkan</para>
  <para style="q2" vid="ISA 19:12">aduak abaña Iyib.<verse eid="ISA 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 19:13" />Mbon utom Soan ekappa ndisịme,</para>
  <para style="q2" vid="ISA 19:13">ebiaña mme adadusʌñ ke Memfis</para>
  <para style="q1" vid="ISA 19:13">mme adaaha mbon amọ</para>
  <para style="q2" vid="ISA 19:13">etịn Iyib usʌñ.<verse eid="ISA 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 19:14" />
    <char style="nd">Abọọñ</char> anwañña sịbidịd mfʌmmọ</para>
  <para style="q2" vid="ISA 19:14">adọñ ammọ ke idem;</para>
  <para style="q1" vid="ISA 19:14">ammọ enam Iyib esaña nteññe-nteññe ke afịd se anye anam,</para>
  <para style="q2" vid="ISA 19:14">nte awo inaam ukọd ateññe ke akikọi amọ.<verse eid="ISA 19:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 19:15" />Inieghe se Iyib akeme adinam,</para>
  <para style="q2" vid="ISA 19:15">iwuod me isịm, ndak ayob mme ñnyanyaha.<verse eid="ISA 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 19:16" />Ke usen ado nditọ Iyib eyaekappa edo mbon idek. Ammọ eyaenyeñ ye akpọsọñ ndịk ke <char style="nd">Abọọñ</char> Andikponñkan amaadịppe ubọk abaña ammọ. <verse eid="ISA 19:16" /><verse number="17" style="v" sid="ISA 19:17" />Isọñ Yuda ñko ayaasịn nditọ Iyib akpọsọñ ndịk; afịd mbon se idiikop anyịñ Yuda eyaekop ndịk, ke ntak se <char style="nd">Abọọñ</char> Andikponñkan aduak abaña ammọ.<verse eid="ISA 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 19:18" />Ke usen ado mme abio Iyib ition eyaesem usem Kenan enyʌñ enwọñọ adisuuk iwuod nnọọ <char style="nd">Abọọñ</char> Andikponñkan. Keed ke atu ammọ adiikere Abio Utịn.<verse eid="ISA 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 19:19" />Ke usen ado akpokoro uwa ayaaba anọ <char style="nd">Abọọñ</char> ke ufọọd isọñ Iyib, ndin ubobodñkpọ aditoiyo ayaaba anọ <char style="nd">Abọọñ</char> ke adaña amọ. <verse eid="ISA 19:19" /><verse number="20" style="v" sid="ISA 19:20" />Anye adiido idiọọñọ ye ntiense inọ <char style="nd">Abọọñ</char> Andikponñkan ke isọñ Iyib. Ammọ emaetua ekoot <char style="nd">Abọọñ</char>ke ntak mbon e-efiighe ammọ, anye ayaadọñ andinyaaña ye andikpeme anọ ammọ, anye ayaanyaaña ammọ. <verse eid="ISA 19:20" /><verse number="21" style="v" sid="ISA 19:21" />Ke ntoro <char style="nd">Abọọñ</char> ayaayaara idem amọ anọ nditọ Iyib, ndin ke usen ado ammọ eyaenyịmme <char style="nd">Abọọñ</char>. Ammọ eyaekpono anye ye mme uwa ye mme enọ mfịd; ammọ eyaenam mme akaaña enọ <char style="nd">Abọọñ</char> enyʌñ esio mme akaaña ammọ. <verse eid="ISA 19:21" /><verse number="22" style="v" sid="ISA 19:22" /><char style="nd">Abọọñ</char> ayaamia Iyib ufen ye udọñọ nsobo; anye ayaamia ammọ anyʌñ akọk ammọ. Ammọ eyaewọññọ ebịne <char style="nd">Abọọñ</char>, anye ayaakpañ utọñ anọ aseeme ammọ anyʌñ akọk ammọ.<verse eid="ISA 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 19:23" />Ke usen ado ekamba akpọusʌñ ayaaba ato ke Iyib akewuọ Asiria. Mbon Asiria eyaekaa Iyib ndin mbon Iyib eyaenyʌñ ekaa Asiria. Mbon Iyib ye mbon Asiria eyaediana keed ekpono Abasi. <verse eid="ISA 19:23" /><verse number="24" style="v" sid="ISA 19:24" />Ke usen ado Isrel ayaado ayọhọ ita, akeene Iyib ye Asiria, edo adidiọñ enọ ederimbod. <verse eid="ISA 19:24" /><verse number="25" style="v" sid="ISA 19:25" /><char style="nd">Abọọñ</char> Andikponñkan ayaadiọñ ammọ, abo, “Afọfọn anọ Iyib ikọd mmi, Asiria ubọkutom mmi, ye Isrel udeeme mmi.”<verse eid="ISA 19:25" /></para>
  <chapter eid="ISA 19" />
  <chapter number="20" style="c" sid="ISA 20" />
  <para style="s1">Prọfesi A-abañake Iyib ye Kuus</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 20:1" />Ke isua e-ekamba adaiso ekọñ, Saakọn, a-adidem Asiria akedọññọ akediighe Asdọd adinwana anyʌñ adat anye, <verse eid="ISA 20:1" /><verse number="2" style="v" sid="ISA 20:2" />Abọọñ amaatañ ikọ ato inua Aisaiya ayịn Emọs, ate “Sio afọñikpo ke idem mfo ye ikpaukod ke ukod mfo.” Anye amaanyʌñ anam ntoro, asaña ifed ye ñkaña ukod.<verse eid="ISA 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 20:3" />Akem Abọọñ amaabo ate, “Kpa naña Aisaiya ayịnutom mmi asaña ifed isịneke ikpaukod ke isua ita, nte idiọọñọ adiwọt nsobo a-adiighe abịne Iyib ye Kuus, <verse eid="ISA 20:3" /><verse number="4" style="v" sid="ISA 20:4" />kpa ntoro ke adidem Asiria adiikoono nditọ Iyib ekeduọññọke ke ekọñ ye nditọ ntañmfeb Kuus ifed, isịneke ikpaukod, ntək-ntək ye ikpọ, efʌd abono inwañ, nọ abuud amʌm Iyib. <verse eid="ISA 20:4" /><verse number="5" style="v" sid="ISA 20:5" />Mbon e-ekenieghe mbuọdidem ke Kuus enyʌñ enam inua ke Iyib eyaekop abuud ye asuenne. <verse eid="ISA 20:5" /><verse number="6" style="v" sid="ISA 20:6" />Ke usen ado mbon e-edʌññọ ke mben mmọọñ umi eyaebo, ‘Se sitịppe inọ mbon a-ñnyịn ikidotto anyen ke idem ammọ, mbon a-ñnyịn ikifeeñeke ibịne ibo yak inọ unwam enyʌñ inyaaña ñnyịn esio ke ubọk adidem mbon Asiria! Ñnyịn idiinam die ibọkkọ?’ ”<verse eid="ISA 20:6" /></para>
  <chapter eid="ISA 20" />
  <chapter number="21" style="c" sid="ISA 21" />
  <para style="s1">Prọfesi A-abañake Babilọn</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 21:1" />Prọfesi a-abañake Akpautatan a-adaaha akpere Akpainyañ:</para>
  <para style="q1" vid="ISA 21:1">Kpa naña afịm ayobio afịme aboiyo ke usuuk isọñ,</para>
  <para style="q2" vid="ISA 21:1">kpa ntoro ke asua ato akpautatan,</para>
  <para style="q2" vid="ISA 21:1">ato abio ndịk adi.<verse eid="ISA 21:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ISA 21:2" />Eñwọt miin aniendịk ñkukịd:</para>
  <para style="q2" vid="ISA 21:2">Atabawo asʌk atap, awo mbịme asʌk akoono mbịme.</para>
  <para style="q1" vid="ISA 21:2">Elam, nwana! Media, kanna kʌk!</para>
  <para style="q2" vid="ISA 21:2">Ami ñyaanam afịd ñkuun a-anye akenamma atre.<verse eid="ISA 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 21:3" />Ñkpọ ami anam ami ñkop ubiak ke idem mmi,</para>
  <para style="q2" vid="ISA 21:3">ubiak ammʌm miin, nte ubiak awonwaan a-abaaha ke uman;</para>
  <para style="q1" vid="ISA 21:3">idem antịmede miin abaña se ami ñkop,</para>
  <para style="q2" vid="ISA 21:3">idem añkpa miin ke se ami ñkịt.<verse eid="ISA 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 21:4" />Esịd mmi atịmede,</para>
  <para style="q2" vid="ISA 21:4">ndịk anam idem añnyeñ miin;</para>
  <para style="q1" vid="ISA 21:4">ndubi a-ami ñkeyemme</para>
  <para style="q2" vid="ISA 21:4">akappa ado akpọsọñ ndịk annọ miin.<verse eid="ISA 21:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 21:5" />Ammọ ebịt akpokoro,</para>
  <para style="q2" vid="ISA 21:5">ammọ ebịt ufʌkisọñ,</para>
  <para style="q2" vid="ISA 21:5">ammọ edia, ammọ enwọñ!</para>
  <para style="q1" vid="ISA 21:5">Idakka ida, ndufo adaaha mbonekọñ,</para>
  <para style="q2" vid="ISA 21:5">ifiọññọ adan ke atuekọñ ndufo!<verse eid="ISA 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 21:6" />Se Abọọñ atañ annọọ miin ado ami:</para>
  <para style="q1" vid="ISA 21:6">“Kaa, nịm awoukpeme</para>
  <para style="q2" vid="ISA 21:6">yak anye anọ etob abaña se anye akịt.<verse eid="ISA 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 21:7" />Anye amaakịt mme sariọd</para>
  <para style="q2" vid="ISA 21:7">ye mme udịm enañmbakara,</para>
  <para style="q1" vid="ISA 21:7">mbon ewatta dọñki</para>
  <para style="q2" vid="ISA 21:7">me mbon ewatta kamel,</para>
  <para style="q1" vid="ISA 21:7">yak anye akpañ utọñ atịñ anyen,</para>
  <para style="q2" vid="ISA 21:7">yak anye abeeñe idem ayọhọ-ayọhọ.”<verse eid="ISA 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 21:8" />Awoukpeme amaabọñ,</para>
  <para style="q1" vid="ISA 21:8">“Abọọñ mmi, usen ke usen, ami nda ke anyọñ tọwa ukpeme;</para>
  <para style="q2" vid="ISA 21:8">afịd akonayio ami nda ke itie utom mmi.<verse eid="ISA 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 21:9" />Se, ete keed asʌk awat ke sariọd adi</para>
  <para style="q2" vid="ISA 21:9">ye udịm enañmbakara.</para>
  <para style="q1" vid="ISA 21:9">Ndin anye anọ ibọọrọ adi:</para>
  <para style="q2" vid="ISA 21:9">‘Babilọn aduọ, aduọ!</para>
  <para style="q1" vid="ISA 21:9">Afịd mme ubobod abasi amọ</para>
  <para style="q2" vid="ISA 21:9">eboomo enaa ke isọñ!’ ”<verse eid="ISA 21:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 21:10" />Ikọd mmi e-esọnnọke ke afe ubeek abakpa,</para>
  <para style="q2" vid="ISA 21:10">ami udọkkọ fiin se ami ñkop</para>
  <para style="q1" vid="ISA 21:10">nto <char style="nd">Abọọñ</char> Andikponñkan,</para>
  <para style="q2" vid="ISA 21:10">nto Abasi Isrel.<verse eid="ISA 21:10" /></para>
  <para style="s1">Prọfesi A-abañake Edọm</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 21:11" />Prọfesi a-abañake Duma:</para>
  <para style="q1" vid="ISA 21:11">Awo añkoot miin ato Sei,</para>
  <para style="q2" vid="ISA 21:11">“Awoukpeme, nsoo isʌhọ inọ akonayio ami?</para>
  <para style="q2" vid="ISA 21:11">Awoukpeme, nsoo isʌhọ inọ akonayio ami?”<verse eid="ISA 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 21:12" />Awoukpeme abọọrọ,</para>
  <para style="q2" vid="ISA 21:12">“Ubakusen asʌk adi, ado akonayio ñko asʌk adi.</para>
  <para style="q1" vid="ISA 21:12">Akpedo akpaabịp, ndin bịp;</para>
  <para style="q2" vid="ISA 21:12">nyʌñ maana tịmme di.”<verse eid="ISA 21:12" /></para>
  <para style="s1">Prọfesi A-abañake Arebia</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 21:13" />Prọfesi a-abañake Arebia:</para>
  <para style="q1" vid="ISA 21:13">ndufo mbon isañ Dedan,</para>
  <para style="q2" vid="ISA 21:13">e-enaaha ke mme akai ikọd Arebia,<verse eid="ISA 21:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 21:14" />idat mmọọñ isọk mbon nsaditọñ;</para>
  <para style="q1" vid="ISA 21:14">ndufo e-edʌññọ ke Tema,</para>
  <para style="q2" vid="ISA 21:14">iben ndidia isọk mbon itọk ekọñ.<verse eid="ISA 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 21:15" />Ammọ efeghe ebọkkọ eduad,</para>
  <para style="q2" vid="ISA 21:15">ebọkkọ udʌdnsio eduad,</para>
  <para style="q1" vid="ISA 21:15">ebọkkọ nnʌhọ-nnʌhọ utịgha</para>
  <para style="q2" vid="ISA 21:15">ye ufiob a-atooho ekọñ.<verse eid="ISA 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 21:16" />Se Abọọñ atañ annọọ miin ado ami: “Ke ufọọd isua keed, nte ayịnufọk a-asịneke ke idak ubiọñ ndubeghe akpebatta, afịd ubọọñ Keda ayaasịm utịd. <verse eid="ISA 21:16" /><verse number="17" style="v" sid="ISA 21:17" />Mbon e-ebọkkọke mme ntautob utịgha, mbon ekọñ Keda, ediido ibad-ibad.” <char style="nd">Abọọñ</char>, Abasi Isrel, atañ.<verse eid="ISA 21:17" /></para>
  <chapter eid="ISA 21" />
  <chapter number="22" style="c" sid="ISA 22" />
  <para style="s1">Prọfesi A-abañake Yeruselem</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 22:1" />Prọfesi a-abañake Abedeñ Ñkukịd:</para>
  <para style="q1" vid="ISA 22:1">Nsoo ñkpọ utịmede fiin esịd idahami,</para>
  <para style="q2" vid="ISA 22:1">nọ afịd ndufo efeeñe ekedoro ke anyọñ akọm,<verse eid="ISA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 22:2" />afo abio a-ayọhọke ye ntịme,</para>
  <para style="q2" vid="ISA 22:2">afo abio ntịme ye akpọsọñ uyom?</para>
  <para style="q1" vid="ISA 22:2">Mbon ñkpañña mfo ikikpaaha ke eduad,</para>
  <para style="q2" vid="ISA 22:2">ikinyʌññọ ikpa ke ekọñ.<verse eid="ISA 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 22:3" />Afịd mme adaiwuod ndufo ediana keed efeeñe;</para>
  <para style="q2" vid="ISA 22:3">mbon e-emʌmmọ ammọ ikamake utịgha.</para>
  <para style="q1" vid="ISA 22:3">Ekeben afịd ndufo se ekemʌm ekedọñ ke ñkpakọb itie keed,</para>
  <para style="q2" vid="ISA 22:3">ndufo emaefeeñe ke ini asua ndufo akebaaha ke anyan usʌñ.<verse eid="ISA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 22:4" />Ke ntoro ami mmaabo, “Kanna edem ñkpọñ miin;</para>
  <para style="q2" vid="ISA 22:4">yak ami ntua ndod-ndod ayịd.</para>
  <para style="q1" vid="ISA 22:4">Kuuyem adindọñ miin esịd</para>
  <para style="q2" vid="ISA 22:4">mbaña nsobo ikọd mmi.”<verse eid="ISA 22:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 22:5" />Abọọñ, <char style="nd">Abọọñ</char> Andikponñkan, a-anie usen</para>
  <para style="q2" vid="ISA 22:5">ntịme ye ufiik ye ndịk</para>
  <para style="q2" vid="ISA 22:5">ke Abedeñ Ñkukịd,</para>
  <para style="q1" vid="ISA 22:5">usen e-ediiwuut mme ndibene</para>
  <para style="q2" vid="ISA 22:5">enyʌñ etua enọ mme ikpọabod.<verse eid="ISA 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 22:6" />Elam aben idañ,</para>
  <para style="q2" vid="ISA 22:6">ye mbon se iwat sariọd ye enañmbakara amọ;</para>
  <para style="q2" vid="ISA 22:6">Kii afʌkkọ atuekọñ.<verse eid="ISA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 22:7" />Mme mfọọn abedeñ mfo eyọhọ ye mme sariọd,</para>
  <para style="q2" vid="ISA 22:7">enyʌñ enọ mme awad enañmbakara ekekpeme mme inuaatob abio.<verse eid="ISA 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 22:8" />Abọọñ amaafʌkkọ mme ñkpọ se ikpeme Yuda anịm inwañ,</para>
  <para style="q2" vid="ISA 22:8">ndin ke usen ado afo akekanna abịne</para>
  <para style="q2" vid="ISA 22:8">mme ñkpọekọñ ke Ufọkubọọñ ake Akai Lebanọn.<verse eid="ISA 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 22:9" />Afo amaakịt ke ndibene Abio Defid</para>
  <para style="q2" vid="ISA 22:9">emaewuuro ke nsio-nsio itie;</para>
  <para style="q1" vid="ISA 22:9">afo amaadọñ mmọọñ</para>
  <para style="q2" vid="ISA 22:9">ke Usuuhọ Ube mmọọñ.<verse eid="ISA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 22:10" />Afo amaabat mme ufọk ke Yeruselem</para>
  <para style="q2" vid="ISA 22:10">anyʌñ awuut mme ufọk nọ esọọñọ mme ndibene.<verse eid="ISA 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 22:11" />Afo amaabọp ñkpọdiọhọ mmọọñ ke ufọọd ndibene iba</para>
  <para style="q2" vid="ISA 22:11">anọ mmọọñ Akaan Ñkpọdiọhọ Mmọọñ,</para>
  <para style="q1" vid="ISA 22:11">ado afo ukuseeghe Andikinam anye,</para>
  <para style="q2" vid="ISA 22:11">unyʌññọ unie ukpono unọ Andikikọọk iwuod ibaña anye anyan ini koo.<verse eid="ISA 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 22:12" />Abọọñ, <char style="nd">Abọọñ</char> Andikponñkan,</para>
  <para style="q2" vid="ISA 22:12">amaukoot fiin ke usen ado ate</para>
  <para style="q1" vid="ISA 22:12">atua anyʌñ aseeme,</para>
  <para style="q2" vid="ISA 22:12">awịppe ided mfo asio anyʌñ asịne afọñikpo.<verse eid="ISA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 22:13" />Ado se, idaara ye ñkpoyo mmọdo,</para>
  <para style="q2" vid="ISA 22:13">uwot enañ ye uwot edọñ,</para>
  <para style="q2" vid="ISA 22:13">uta unam ye unwọñ ukọd!</para>
  <para style="q1" vid="ISA 22:13">Afo ate, “Yak ñnyịn idia inyʌñ inwọñ,</para>
  <para style="q2" vid="ISA 22:13">sia ñkpọñ ñnyịn iyaikpa!”<verse eid="ISA 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 22:14" />
    <char style="nd">Abọọñ</char> Andikponñkan ayaara ami annọ miin ke utọñ mmi: “Tutu usen ñkpa mfo adifeen idiibaaha inọ idiọọkñkpọ ami,” <char style="nd">Abọọñ</char> Andikponñkan atañ.<verse eid="ISA 22:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="ISA 22:15" />Se <char style="nd">Abọọñ</char> Andikponñkan, atañ ado ami:</para>
  <para style="q1" vid="ISA 22:15">Kaa, ke tañ ye akamaufọk ami,</para>
  <para style="q2" vid="ISA 22:15">kaa bịne Sebna akamautom ke esa abọọñ:<verse eid="ISA 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 22:16" />Nsoo ke afo anam mi, ñko anie akunọọ fiin unen</para>
  <para style="q2" vid="ISA 22:16">adidomo udi ñkpịkke nnọọ idem mfo mi,</para>
  <para style="q1" vid="ISA 22:16">adiọñ udi mfo ke ñkoñ-ñkoñ itie,</para>
  <para style="q2" vid="ISA 22:16">anyʌñ akọñ itiad adiọñ anịm nte akpatre itie nduọkadudu mfo?<verse eid="ISA 22:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ISA 22:17" />Kpeme idem, afo akpọsọñ awo, sia <char style="nd">Abọọñ</char> ayaaditʌm umʌm fiin</para>
  <para style="q2" vid="ISA 22:17">ñnyʌñ utop fiin nsio.<verse eid="ISA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 22:18" />Anye ayaunwịn fiin nte ikara,</para>
  <para style="q2" vid="ISA 22:18">anyʌñ utop fiin asịn ke ekamba idịd.</para>
  <para style="q1" vid="ISA 22:18">Do ke afo uduukukpa,</para>
  <para style="q2" vid="ISA 22:18">kpasʌk do ke mme sariọd a-afo akponoke anyʌñ akamake akokko idem</para>
  <para style="q2" vid="ISA 22:18">ediikappa ido ñkpọ asuenne inọ ufọk eteufọk mfo.<verse eid="ISA 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 22:19" />Ami ñyausio fiin mfep ke itie utom mfo,</para>
  <para style="q2" vid="ISA 22:19">ñnyʌñ uben fiin nsio ke ndaha mfo.<verse eid="ISA 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 22:20" />Ke usen ado ami ñyaasịn uyio ñkoot isʌñutom mmi, Eliakịm ayịn Hilkia. <verse eid="ISA 22:20" /><verse number="21" style="v" sid="ISA 22:21" />Ami ñyaasịn anye afọñ mfo ñnyʌñ ñwañ anye mbọbọisịn mfo ñnyʌñ ñyaak adudu mfo nnọ anye. Anye ayaado ete anọ mbon se idʌñ ke Yeruselem ye mbon Yuda. <verse eid="ISA 22:21" /><verse number="22" style="v" sid="ISA 22:22" />Ami ñyaadot ñyịn ukpọhọde ufọk Defid ke afara amọ; se anye abeere awo ndomokeed idiikanna ibet, ñko se anye abet awo ndomokeed idiikanna ibeere. <verse eid="ISA 22:22" /><verse number="23" style="v" sid="ISA 22:23" />Ami ñyaakọñ anye nte mboi nsịn ke itie asọọñọ ada; anye ayaakappa ado ñkpọitie ukpono anọ ufọk ete amọ. <verse eid="ISA 22:23" /><verse number="24" style="v" sid="ISA 22:24" />Afịd ubọọñ ubon amọ adiikọñọ anye ye nditọ, afịd ntək ñkpoduoho amọ, atọọñọke ke ikara usan tutu asịm mme abañ.<verse eid="ISA 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 22:25" />“Ke usen ado, <char style="nd">Abọọñ</char> Andikponñkan anọ uyio, mboi e-ekọññọ esịn ke akpọsọñ itie se inie nsọọñọnda ayaawʌkkọ; anye ayaasaiya anyʌñ aduọññọ, eyaenyʌñ ekpịkke mbiomo a-akọñọke anye ke itọñ eduọọk.” <char style="nd">Abọọñ</char> atañ.<verse eid="ISA 22:25" /></para>
  <chapter eid="ISA 22" />
  <chapter number="23" style="c" sid="ISA 23" />
  <para style="s1">Prọfesi A-abañake Tai</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 23:1" />Prọfesi a-abañake Tai:</para>
  <para style="q1" vid="ISA 23:1">Itua, ndufo nsʌñikañ Taasis!</para>
  <para style="q2" vid="ISA 23:1">Sia esobo Tai,</para>
  <para style="q2" vid="ISA 23:1">ammọ inieghe ufọk me udua mben mmọọñ aba.</para>
  <para style="q1" vid="ISA 23:1">Tọọñọ ke isọñ Saiprọs</para>
  <para style="q2" vid="ISA 23:1">ikọ ato akesịm ammọ.<verse eid="ISA 23:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ISA 23:2" />Iba ke ndobuyio, ndufo mbon e-ebaaha ke isọñ ñkanñkʌk mmọọñ</para>
  <para style="q2" vid="ISA 23:2">ye ndufo ikpọ mme anyamudua ke Sidọn,</para>
  <para style="q2" vid="ISA 23:2">a-mme awadinyañ enamma nọ eforo.<verse eid="ISA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 23:3" />Ke mme ikpọ mmọọñ</para>
  <para style="q2" vid="ISA 23:3">ñkwa abakpa Sihọ ato awuọ adi;</para>
  <para style="q1" vid="ISA 23:3">idọk ke Nail akedo usʌñ ukọ akʌk ke Tai,</para>
  <para style="q2" vid="ISA 23:3">anye amaakappa ekamba itieudua anọ mme idịd.<verse eid="ISA 23:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 23:4" />Yak abuud umʌm fiin, Sidọn, ye afo akpọsọñ itie akpainyañ,</para>
  <para style="q2" vid="ISA 23:4">sia akpainyañ a-atañ:</para>
  <para style="q1" vid="ISA 23:4">“Akenam uman intuakka miin, ami ñko ñnyʌññọ mman ayịn;</para>
  <para style="q2" vid="ISA 23:4">akenam ami mbọọhọ nditọ ideen ake nseeghe ñkpọ mbaña nditọ ibaan.”<verse eid="ISA 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 23:5" />Ikọ amaadiwuọ Iyib,</para>
  <para style="q2" vid="ISA 23:5">ammọ ediiba ke ntaeded akeene etob se ito Tai idi.<verse eid="ISA 23:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 23:6" />Iwọññọ ikaa Taasis;</para>
  <para style="q2" vid="ISA 23:6">ita eded, ndufo mbon isọñ ñkanñkʌk mmọọñ.<verse eid="ISA 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 23:7" />Nte abio mbre ndufo ado ami,</para>
  <para style="q2" vid="ISA 23:7">akaan, akaan abio,</para>
  <para style="q1" vid="ISA 23:7">a-ñkpad amọ abenne anye</para>
  <para style="q2" vid="ISA 23:7">akenịm ke ataa anyan-anyan idʌñ?<verse eid="ISA 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 23:8" />Anie awo akenam uduak ami abaña Tai,</para>
  <para style="q2" vid="ISA 23:8">andinọ mme anyanya,</para>
  <para style="q1" vid="ISA 23:8">a-mme anyamudua amọ edooho mme nditọ mbọọñ,</para>
  <para style="q2" vid="ISA 23:8">a-mme anyamudua amọ ewuọhọ etob ke ekondo?<verse eid="ISA 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 23:9" />
    <char style="nd">Abọọñ</char> Andikponñkan akeduak ami,</para>
  <para style="q2" vid="ISA 23:9">adisuuhọ ntañidem amọ ye afịd mmọnyọ amọ,</para>
  <para style="q2" vid="ISA 23:9">adinyʌñ nsuuhọ afịd mme awuọ etob awo ke ekondo.<verse eid="ISA 23:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 23:10" />Kịm isọñ mfo kpa naña ammọ enam ke mben akpainyañ Nail,</para>
  <para style="q2" vid="ISA 23:10">Afo Ayịn Awonwaan Taasis,</para>
  <para style="q2" vid="ISA 23:10">sia afo unieghe itie mbeghe aba.<verse eid="ISA 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 23:11" />
    <char style="nd">Abọọñ</char> anyan ubọk amọ awọt akpainyañ,</para>
  <para style="q2" vid="ISA 23:11">anyʌñ anam mme abioubọọñ amọ enyeeñe.</para>
  <para style="q1" vid="ISA 23:11">Anye anọ ewʌhọ abaña Fonisia</para>
  <para style="q2" vid="ISA 23:11">ate yak esobo ñkpọsọñ itie ke abio amọ.<verse eid="ISA 23:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 23:12" />Anye ate, “Yak mbre mfo atre</para>
  <para style="q2" vid="ISA 23:12">idahami, Mboppo Adiaha Sidọn e-esọnnọke!</para>
  <para style="b" vid="ISA 23:12" />
  <para style="q1" vid="ISA 23:12">“Dakka ke anyọñ, kaaña kaa Saiprọs;</para>
  <para style="q2" vid="ISA 23:12">kpa ke ukañ udo uduukịtte emem.”<verse eid="ISA 23:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 23:13" />Se isọñ mbon Babilọn,</para>
  <para style="q2" vid="ISA 23:13">mbon a-awo imiibatta aba ke ñkpọ!</para>
  <para style="q1" vid="ISA 23:13">Mbon Asiria enam anye akappa</para>
  <para style="q2" vid="ISA 23:13">itie nnaa anọ ndiọi unam akpautatan;</para>
  <para style="q1" vid="ISA 23:13">ammọ ebọp mme ikpọ anyọñukpeme ammọ,</para>
  <para style="q2" vid="ISA 23:13">ammọ ewuut ñkpọsọñ itie ammọ ebono,</para>
  <para style="q2" vid="ISA 23:13">enyʌñ enam ammọ ekappa ataha.<verse eid="ISA 23:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 23:14" />Itua, ndufo nsʌñikañ Taasis!</para>
  <para style="q2" vid="ISA 23:14">Sia esobo akpọsọñ itie ndufo!<verse eid="ISA 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 23:15" />Ke ini ado eyaefre Tai ke isua ata mme duob, ukem nte isua uwem adidem. Ado ke utịd isua ata mme duob ami, ñkpọ ayaatịppe anọ Tai nọ asaña akekem ye ikọ ikwọ akpara:<verse eid="ISA 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 23:16" />“Ben ekpa, saña kanna abio,</para>
  <para style="q2" vid="ISA 23:16">afo akpara emaekefre anyen;</para>
  <para style="q1" vid="ISA 23:16">tịm bre ekpa ado, kwọ uwak ikwọ,</para>
  <para style="q2" vid="ISA 23:16">yak ekama ado utoiyo fiin.”<verse eid="ISA 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 23:17" />Ke utịd isua ata mme duob ami, <char style="nd">Abọọñ</char> ayaasuuk anyen ase Tai atʌnọ anye. Anye ayaamaana atịmme akenam akpara amọ, adia ekamba udod, anyʌñ akama idem amọ anyam udua ke afịd mme abioubọọñ ke ekondo. <verse eid="ISA 23:17" /><verse number="18" style="v" sid="ISA 23:18" />Ado eyaeben udod ye akʌk se anye abọ enịm asaña-asaña enọ <char style="nd">Abọọñ</char>; awo idiidọññọ anye ke ufọk, idiinyʌññọ ikoono ibon inịm inọ anye. Eyaenọ mbon e-edʌññọ ye <char style="nd">Abọọñ</char> udod amọ, nọ ekama edep akpọmiọk ndidia ye mfọọn afọñ.<verse eid="ISA 23:18" /></para>
  <chapter eid="ISA 23" />
  <chapter number="24" style="c" sid="ISA 24" />
  <para style="s1">Nsobo A-atooho <char style="nd">Abọọñ</char> Asịm Ederimbod</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 24:1" />Se, <char style="nd">Abọọñ</char> ayaanam ederimbod anaa ukpọk</para>
  <para style="q2" vid="ISA 24:1">anyʌñ asobo anye;</para>
  <para style="q1" vid="ISA 24:1">anye ayaabiat iso ederimbod</para>
  <para style="q2" vid="ISA 24:1">anyʌñ asuan mbon se idʌñ ke esịd;<verse eid="ISA 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 24:2" />adiido ukem ado</para>
  <para style="q2" vid="ISA 24:2">anọ aku kpa ye ñkaña awo,</para>
  <para style="q2" vid="ISA 24:2">anọ eteufọk kpa ye ayịnufọk amọ,</para>
  <para style="q2" vid="ISA 24:2">anọ ekaufọk kpa ye ayịnufọk amọ,</para>
  <para style="q2" vid="ISA 24:2">anọ anyamudua kpa ye adebudua,</para>
  <para style="q2" vid="ISA 24:2">anọ awo ewuọd kpa ye awuọdakʌk,</para>
  <para style="q2" vid="ISA 24:2">anọ akamaisọn kpa ye awuọdakʌk.<verse eid="ISA 24:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 24:3" />Eyaesobo isọñ afịd-afịd</para>
  <para style="q2" vid="ISA 24:3">enyʌñ ebịme anye afịd-afịd.</para>
  <para style="q1" vid="ISA 24:3">Abọọñ ado atañ ikọ ami.<verse eid="ISA 24:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 24:4" />Isọñ asaat anyʌñ ayeeme,</para>
  <para style="q2" vid="ISA 24:4">Ederimbod atua anyʌñ ayeeme,</para>
  <para style="q2" vid="ISA 24:4">mme hefịn etua ye isọñ.<verse eid="ISA 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 24:5" />Mme adʌñisọñ e-esappa isọñ;</para>
  <para style="q2" vid="ISA 24:5">ammọ e-ebiat mme mbed,</para>
  <para style="q1" vid="ISA 24:5">ebiat mme ewʌhọ</para>
  <para style="q2" vid="ISA 24:5">enyʌñ ebiat nsi-nsi edioomo.<verse eid="ISA 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 24:6" />Ke ntoro isuuñọ afʌk isọñ;</para>
  <para style="q2" vid="ISA 24:6">mme adʌñisọñ ana eyọ ndudue ammọ.</para>
  <para style="q1" vid="ISA 24:6">Ke ntoro e-efọp mme adʌñisọñ ke ikañ,</para>
  <para style="q2" vid="ISA 24:6">ndin ibad-ibad awo esʌhọ.<verse eid="ISA 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 24:7" />Ufa ukọd a-asat ama, akaan fain a-anyʌñ ayeeme;</para>
  <para style="q2" vid="ISA 24:7">afịd mme abre mbre ekuun.<verse eid="ISA 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 24:8" />Mme anemuyio ibịdubọk edobo,</para>
  <para style="q2" vid="ISA 24:8">uyom mbon mbre inemesịd atre,</para>
  <para style="q2" vid="ISA 24:8">anemuyio hab isioho uyio.<verse eid="ISA 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 24:9" />Ammọ inwọññọ ukọd aba ke ini ekwọọhọ ikwọ;</para>
  <para style="q2" vid="ISA 24:9">bie ado idod ñkpọ anọ mbon se inwọñ.<verse eid="ISA 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 24:10" />Mbiara abio ana ukpọk;</para>
  <para style="q2" vid="ISA 24:10">esiit usʌñ se esaña edʌk afịd ufọk.<verse eid="ISA 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 24:11" />Ammọ etua ke mme akpọusʌñ isañ eyem ukọd;</para>
  <para style="q2" vid="ISA 24:11">afịd idaara akappa mfʌhọ,</para>
  <para style="q2" vid="ISA 24:11">etre afịd ñkpo idaara ke iso isọñ.<verse eid="ISA 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 24:12" />Abio a-abiaña ama,</para>
  <para style="q2" vid="ISA 24:12">e-ekpok inuaatob amọ ñkeñe-ñkeñe.<verse eid="ISA 24:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 24:13" />Kpa ntoro ke adiido ye isọñ</para>
  <para style="q2" vid="ISA 24:13">ye mme idịd,</para>
  <para style="q1" vid="ISA 24:13">kpa naña emaemia eto ọlif,</para>
  <para style="q2" vid="ISA 24:13">me naña kreb asʌhọ ke emaekịppe mfịd ema.<verse eid="ISA 24:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 24:14" />Ammọ edịppe uyio ammọ, ebọñ ñkpo idaara;</para>
  <para style="q2" vid="ISA 24:14">ammọ etọọñọ ke usobutịn etañ ase <char style="nd">Abọọñ</char>.<verse eid="ISA 24:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 24:15" />Ke ntoro ke usakkautịn inọ <char style="nd">Abọọñ</char> itooro;</para>
  <para style="q2" vid="ISA 24:15">ibenne anyịñ <char style="nd">Abọọñ</char>, kpa Abasi Isrel,</para>
  <para style="q2" vid="ISA 24:15">ke mme unaisọñ ñkanñkʌk mmọọñ.<verse eid="ISA 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 24:16" />Tọọñọ ke utịd ederimbod ñnyịn imikop uyio ikwọ:</para>
  <para style="q2" vid="ISA 24:16">“Ubọọñ anie Andinen Ñkan.”</para>
  <para style="b" vid="ISA 24:16" />
  <para style="q1" vid="ISA 24:16">Ado ami mbo, “Ami mmetaha mma, ami mmetaha mma!</para>
  <para style="q2" vid="ISA 24:16">Adọdiọọk annọ miin!</para>
  <para style="q1" vid="ISA 24:16">Mbon abiaña esʌk ebiaña!</para>
  <para style="q2" vid="ISA 24:16">Ammọ ekama abiaña ebiaña abiaña!”<verse eid="ISA 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 24:17" />Ndịk ye ube ye afia enaa ubet fiin,</para>
  <para style="q2" vid="ISA 24:17">mbon ederimbod.<verse eid="ISA 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 24:18" />Awo keed akeedodo a-afegheke ke amaakop uyom ndịk</para>
  <para style="q2" vid="ISA 24:18">ayaaduọ adʌk ube;</para>
  <para style="q1" vid="ISA 24:18">awo keed akeedodo a-adọọhọ awuọ ke ube,</para>
  <para style="q2" vid="ISA 24:18">afia ayaamʌm anye.</para>
  <para style="b" vid="ISA 24:18" />
  <para style="q1" vid="ISA 24:18">Mme inuaatob mme hefịn enaa inwañ,</para>
  <para style="q2" vid="ISA 24:18">mme idakisọñ ederimbod enyeñ.<verse eid="ISA 24:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 24:19" />Ederimbod awuudo afịd,</para>
  <para style="q2" vid="ISA 24:19">ederimbod asuana mbai-mbai,</para>
  <para style="q2" vid="ISA 24:19">ederimbod anyeeñe akpọsọñ-akpọsọñ.<verse eid="ISA 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 24:20" />Ederimbod akanna nte awo inaam ukọd,</para>
  <para style="q2" vid="ISA 24:20">anye ateññe nte afịm aben atayad;</para>
  <para style="q1" vid="ISA 24:20">mbiomo nsọñiwuod amọ adoppo eti-eti,</para>
  <para style="q2" vid="ISA 24:20">anam anye aduọ, idiinyʌññọ idakka ida aba ke nsi-nsi.<verse eid="ISA 24:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 24:21" />Ke usen ado ufen <char style="nd">Abọọñ</char> ayaamia</para>
  <para style="q2" vid="ISA 24:21">mme adudu ke mme anyọñ</para>
  <para style="q2" vid="ISA 24:21">ye mme ndidem ke isọñ.<verse eid="ISA 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 24:22" />Eyaetañ ammọ ebon itie keed nte udịmenañ</para>
  <para style="q2" vid="ISA 24:22">nte naña ebọp mbon ñkpakọb edọñ ke ube;</para>
  <para style="q1" vid="ISA 24:22">eyaedọñ ammọ ke ufọk ñkpakọb eyịt usʌñ,</para>
  <para style="q2" vid="ISA 24:22">enyʌñ emia ammọ ufen ke uwak usen emaeboiyo.<verse eid="ISA 24:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 24:23" />Idem ayaakpa afiọñ,</para>
  <para style="q2" vid="ISA 24:23">abuud ayaanam utịn;</para>
  <para style="q1" vid="ISA 24:23">sia <char style="nd">Abọọñ</char> Andikponñkan ayaada ukara</para>
  <para style="q2" vid="ISA 24:23">ke Abod Saiyọn ye ke Yeruselem,</para>
  <para style="q2" vid="ISA 24:23">ye ke iso mme ñkpisọñ amọ, ke ekamba ubọọñ.<verse eid="ISA 24:23" /></para>
  <chapter eid="ISA 24" />
  <chapter number="25" style="c" sid="ISA 25" />
  <para style="s1">Itooro anie <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 25:1" />
    <char style="nd">Abọọñ</char>, afo ado Abasi mmi;</para>
  <para style="q2" vid="ISA 25:1">ami ñyaudịppe fiin ke anyọñ ñnyʌñ ntooro anyịñ mfo,</para>
  <para style="q1" vid="ISA 25:1">sia ke ataa akpanikọ</para>
  <para style="q2" vid="ISA 25:1">afo amenam mme utịbe ñkpọ,</para>
  <para style="q2" vid="ISA 25:1">mme ñkpọ ekeduakka ebaña ke anyan ini.<verse eid="ISA 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 25:2" />Afo amenam abio aba nte ifịm mbio,</para>
  <para style="q2" vid="ISA 25:2">akpọsọñ abio akappa nsobo,</para>
  <para style="q1" vid="ISA 25:2">akpọsọñ abio isenawo ibaaha aba;</para>
  <para style="q2" vid="ISA 25:2">awo idiimaanake ibọp anye aba.<verse eid="ISA 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 25:3" />Ke ntoro mme ñkpọsọñ awo eyaukpono fiin;</para>
  <para style="q2" vid="ISA 25:3">mme abio afai idịd eyaubaak fiin.<verse eid="ISA 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 25:4" />Afo ado itie udịbe anọ mme uweene,</para>
  <para style="q2" vid="ISA 25:4">itie udịbe anọ mbon eyemme unwam ke ini unọmọ, ado</para>
  <para style="q1" vid="ISA 25:4">itieidʌñ ke ini ayobio</para>
  <para style="q2" vid="ISA 25:4">ye idak ndeeñ ke ini ufiob.</para>
  <para style="q1" vid="ISA 25:4">Sia ibifịk awo afai</para>
  <para style="q2" vid="ISA 25:4">aba nte afịm ayobio amia ndibene<verse eid="ISA 25:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="ISA 25:5" />ye nte ufiob ke akpautatan.</para>
  <para style="q1" vid="ISA 25:5">Afo ametre uyom isenawo;</para>
  <para style="q2" vid="ISA 25:5">nte naña ekama ndedeñ ntọñanyọñ esuuhọ ufiob,</para>
  <para style="q2" vid="ISA 25:5">ntoro ke ikwọ mbon afai adop.<verse eid="ISA 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 25:6" />Ke ekamba anyọñ abod ami <char style="nd">Abọọñ</char> Andikponñkan ayaanam</para>
  <para style="q2" vid="ISA 25:6">usọrọ nti ndidia anọ afịd mbon awo,</para>
  <para style="q1" vid="ISA 25:6">usọrọ e-ekamake nti ukọd,</para>
  <para style="q2" vid="ISA 25:6">mme unam se ifọn ikan ye mme ukọd se inekke ifọn ikan.<verse eid="ISA 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 25:7" />Ke ekamba abod ami anye ayaabiat</para>
  <para style="q2" vid="ISA 25:7">afọñ ñkpa a-afʌkkọ afịd mbon awo,</para>
  <para style="q1" vid="ISA 25:7">ye afọñ a-afʌkkọ afịd mme idịd;<verse eid="ISA 25:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="ISA 25:8" />anye ayaaben ñkpa afep ke nsi-nsi.</para>
  <para style="q1" vid="ISA 25:8">
    <char style="nd">Abọọñ</char> Andikara ayaakwokko mmọọñayịd</para>
  <para style="q2" vid="ISA 25:8">ke iso afịd awo;</para>
  <para style="q1" vid="ISA 25:8">anye ayaaben abuud afep ke atu ikọd amọ</para>
  <para style="q2" vid="ISA 25:8">ke afịd ederimbod.</para>
  <para style="q1" vid="ISA 25:8">
    <char style="nd">Abọọñ</char> atañ.<verse eid="ISA 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 25:9" />Ke usen ado ammọ eyaebo,</para>
  <para style="q1" vid="ISA 25:9">“Ke akpanikọ anyem ado Abasi ñnyịn;</para>
  <para style="q2" vid="ISA 25:9">ñnyịn ikibuọt idem ye anye, anye akenyʌñ inyaaña ñnyịn.</para>
  <para style="q1" vid="ISA 25:9">Anyem ado <char style="nd">Abọọñ</char>, ñnyịn imainịm anye ke akpanikọ;</para>
  <para style="q2" vid="ISA 25:9">yak ñnyịn idaara inyʌñ inem esịd ke adinyaaña amọ.”<verse eid="ISA 25:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 25:10" />Ubọk <char style="nd">Abọọñ</char> ayaadoro ke ekamba abod ami;</para>
  <para style="q2" vid="ISA 25:10">ado eyaesọnnọ Mọb ke isọñ ammọ</para>
  <para style="q2" vid="ISA 25:10">naña esọnnọ ñnyanyaha ke itie uduọñọ mbio.<verse eid="ISA 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 25:11" />Ammọ eyaenyan ubọk ammọ do,</para>
  <para style="q2" vid="ISA 25:11">naña mbon ewọk enyanna ubọk ammọ idaha ewọkkọ ewọk.</para>
  <para style="q1" vid="ISA 25:11">Abasi ayaasuuhọ ntañidem ammọ,</para>
  <para style="q2" vid="ISA 25:11">iseeghe mbufiọk ubọk ammọ.<verse eid="ISA 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 25:12" />Anye ayaawuut mme ikpọ ñkoñ-ñkoñ ndibene ndufo</para>
  <para style="q2" vid="ISA 25:12">anyʌñ asuuhọ ammọ anịm;</para>
  <para style="q1" vid="ISA 25:12">anye ayaanịm ammọ ke isọñ,</para>
  <para style="q2" vid="ISA 25:12">kpa ke ataa ntọñ isọñ.<verse eid="ISA 25:12" /></para>
  <chapter eid="ISA 25" />
  <chapter number="26" style="c" sid="ISA 26" />
  <para style="s1">Ikwọ Itooro</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 26:1" />Ke usen ado eyaekwọ ikwọ ami ke isọñ Yuda:</para>
  <para style="q1" vid="ISA 26:1">Ñnyịn iminie akpọsọñ abio;</para>
  <para style="q2" vid="ISA 26:1">Abasi a-anam adinyaaña</para>
  <para style="q2" vid="ISA 26:1">ado mme ndibene ye akọekọñ.<verse eid="ISA 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 26:2" />Beere mme inuaatob</para>
  <para style="q2" vid="ISA 26:2">nọ adinen idịd adʌk,</para>
  <para style="q2" vid="ISA 26:2">idịd e-enieghe mbuọdidem.<verse eid="ISA 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 26:3" />Afo ayaanịm ke ataa emem</para>
  <para style="q2" vid="ISA 26:3">mbon e-esịd ammọ akọñọke ke afo,</para>
  <para style="q2" vid="ISA 26:3">sia ammọ e-edot anyen ke afo.<verse eid="ISA 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 26:4" />Dot anyen ke <char style="nd">Abọọñ</char> ke nsi-nsi,</para>
  <para style="q2" vid="ISA 26:4">sia <char style="nd">Abọọñ</char>, <char style="nd">Abọọñ</char> ke idem amọ, ado Itiad nsi-nsi.<verse eid="ISA 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 26:5" />Anye asuuhọ mbon se idʌñ ke ñkoñ-ñkoñ itie,</para>
  <para style="q2" vid="ISA 26:5">asuuhọ abio se ikoñ;</para>
  <para style="q1" vid="ISA 26:5">asọnnọ anye ke isọñ</para>
  <para style="q2" vid="ISA 26:5">anyʌñ atop anye aduọọk ke abu.<verse eid="ISA 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 26:6" />Esọnnọ anye ke ñkpad,</para>
  <para style="q2" vid="ISA 26:6">ñkpad mbon se efiik,</para>
  <para style="q2" vid="ISA 26:6">ñkpadisañ mbon uweene.<verse eid="ISA 26:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 26:7" />Usʌñ mme ndinen awo ana inwañ-inwañ;</para>
  <para style="q2" vid="ISA 26:7">afo, Adinen Abasi, nam usʌñ nti awo adọnọ.<verse eid="ISA 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 26:8" />Ke ntoro, Abọọñ, ñnyịn isaña ke idak mbed mfo,</para>
  <para style="q2" vid="ISA 26:8">ubet fiin;</para>
  <para style="q1" vid="ISA 26:8">anyịñ mfo ye eti etob mfo</para>
  <para style="q2" vid="ISA 26:8">edo udọñ esịd ñnyịn.<verse eid="ISA 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 26:9" />Ukpọñ mmi anekke uyem fiin ke akonayio;</para>
  <para style="q2" vid="ISA 26:9">ke usiere sịbidịd mmi uyem fiin.</para>
  <para style="q1" vid="ISA 26:9">Mme ubiedikpe mfo emaedi ke ederimbod,</para>
  <para style="q2" vid="ISA 26:9">mme idịd ke ekondo eyaekpeep adinenido.<verse eid="ISA 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 26:10" />Ado emaewọt awo ibak mfọn,</para>
  <para style="q2" vid="ISA 26:10">ammọ ikpeebe adinenido;</para>
  <para style="q1" vid="ISA 26:10">kpa ke isọñ mme ndinen awo ammọ esʌk ekaka iso enam idiọọkñkpọ</para>
  <para style="q2" vid="ISA 26:10">inyʌññọ ikpono ubọọñ <char style="nd">Abọọñ</char>.<verse eid="ISA 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 26:11" />
    <char style="nd">Abọọñ</char>, ubọk mfo adịppe ke anyọñ,</para>
  <para style="q2" vid="ISA 26:11">ado ammọ ikịtte.</para>
  <para style="q1" vid="ISA 26:11">Yak ammọ ekịt ekamba udọñ a-afo anieghe abaña ikọd mfo enyʌñ ekop abuud.</para>
  <para style="q2" vid="ISA 26:11">Yak ikañ e-ekenịmme enọ mme asua mfo asobo ammọ.<verse eid="ISA 26:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 26:12" />
    <char style="nd">Abọọñ</char>, afo amainọ ñnyịn emem;</para>
  <para style="q2" vid="ISA 26:12">afịd se ñnyịn inie ado se afo akenam inọọ ñnyịn.<verse eid="ISA 26:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 26:13" />
    <char style="nd">Abọọñ</char> Abasi ñnyịn, ke aboiyoke afo mme mbọọñ mfen ikaara ñnyịn,</para>
  <para style="q2" vid="ISA 26:13">ado anyịñ mfo ikpọọñ ke ñnyịn ikpono.<verse eid="ISA 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 26:14" />Idahami ammọ ekpañña, ammọ iduuho uwem aba;</para>
  <para style="q2" vid="ISA 26:14">mme sịbidịd ammọ idakkake ida.</para>
  <para style="q1" vid="ISA 26:14">Afo amaamia ammọ ufen anyʌñ asobo ammọ;</para>
  <para style="q2" vid="ISA 26:14">afo amaasọọk afịd se ekpedat etoiyo ammọ.<verse eid="ISA 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 26:15" />Afo amenam idịd atọt, <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="ISA 26:15">afo amenam idịd atọt.</para>
  <para style="q1" vid="ISA 26:15">Afo amebọ ubọọñ anọ idem mfo;</para>
  <para style="q2" vid="ISA 26:15">afo amesịkke afịd mme adaña ke isọñ.<verse eid="ISA 26:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 26:16" />
    <char style="nd">Abọọñ</char>, ammọ emaubịne fiin ke ini ukuud ammọ;</para>
  <para style="q2" vid="ISA 26:16">ke ini afo aketʌnọke ammọ,</para>
  <para style="q2" vid="ISA 26:16">akesọọsọñ ammọ adikan mbọñ akam.<verse eid="ISA 26:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 26:17" />Nte awonwaan idịb ayemme adiman ayịn</para>
  <para style="q2" vid="ISA 26:17">amiañña anyʌñ atua ke ntak ubiak,</para>
  <para style="q2" vid="ISA 26:17">kpa ntoro ke ñnyịn ikiba ke iso mfo, <char style="nd">Abọọñ</char>.<verse eid="ISA 26:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 26:18" />Ñnyịn ikisaña ye idịb, ñnyịn imaimiañña ke ubiakuman,</para>
  <para style="q2" vid="ISA 26:18">ado ñnyịn ikiman afịm.</para>
  <para style="q1" vid="ISA 26:18">Ñnyịn ibenne adinyaaña isọk ekondo,</para>
  <para style="q2" vid="ISA 26:18">mbon ederimbod inyʌññọ inie uwem.<verse eid="ISA 26:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="ISA 26:19" />Ado mme akpañkpa mfo eyaedu uwem, <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="ISA 26:19">mme akpo ammọ eyaeset ke udi;</para>
  <para style="q1" vid="ISA 26:19">yak mbon se idʌñ ke abu</para>
  <para style="q2" vid="ISA 26:19">edemme enyʌñ esio ñkpo idaara,</para>
  <para style="q1" vid="ISA 26:19">mbara mfo aba nte mbara ubakusen;</para>
  <para style="q2" vid="ISA 26:19">isọñ ayaaman akpo amọ.<verse eid="ISA 26:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 26:20" />Ikaa, ikọd mmi, idʌk mme ubeed ndufo</para>
  <para style="q2" vid="ISA 26:20">inyʌñ ibet usʌñ isịn idem ndufo;</para>
  <para style="q1" vid="ISA 26:20">idịp idem ndufo ke etək ini</para>
  <para style="q2" vid="ISA 26:20">tutu iyadesịd amọ aboiyo afep.<verse eid="ISA 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 26:21" />Ke akpanikọ, <char style="nd">Abọọñ</char> asʌk awuọ ke itie idʌñ amọ adi</para>
  <para style="q2" vid="ISA 26:21">adimia mbon ederimbod ufen ke mme ndiọiñkpọ ammọ.</para>
  <para style="q1" vid="ISA 26:21">Ederimbod ayaayaara mme iyiib ekeduọkkọ ke anye;</para>
  <para style="q2" vid="ISA 26:21">isọñ idiidịppe nditọ amọ se ikikpa afai aba.<verse eid="ISA 26:21" /></para>
  <chapter eid="ISA 26" />
  <chapter number="27" style="c" sid="ISA 27" />
  <para style="s1">Adinyaaña Isrel</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 27:1" />Ke usen ado,</para>
  <para style="q1" vid="ISA 27:1">
    <char style="nd">Abọọñ</char> ayaamia ufen ye akañkañ amọ,</para>
  <para style="q2" vid="ISA 27:1">anie ndịk, ekamba ye akop adudu akañkañ amọ;</para>
  <para style="q1" vid="ISA 27:1">idiọọk unam mmọọñ ñwọwọññọ udʌkikọd,</para>
  <para style="q2" vid="ISA 27:1">idiọọk unam mmọọñ ñwawañña udʌkikọd;</para>
  <para style="q1" vid="ISA 27:1">anye ayaawot aniendịk unam ke esịd akpainyañ.<verse eid="ISA 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 27:2" />Ke usen ado;</para>
  <para style="q1" vid="ISA 27:2">“Kwọ baña anwịm mfịd inwañ fain:<verse eid="ISA 27:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="ISA 27:3" />Ami, <char style="nd">Abọọñ</char>, nse anye anyen;</para>
  <para style="q2" vid="ISA 27:3">ami nduọk anye mmọọñ afịd ini.</para>
  <para style="q1" vid="ISA 27:3">Ami ñkpeme anye uweemeayio ye akonayio</para>
  <para style="q2" vid="ISA 27:3">mbaak awo ndomokeed adinam anye idiọọk.<verse eid="ISA 27:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 27:4" />Ami ñyatta esịd.</para>
  <para style="q1" vid="ISA 27:4">Akpekapado mbaraekpe ye ñkukịm emaeba se imbiọñọ miin!</para>
  <para style="q2" vid="ISA 27:4">Ami ñkpaasaña mbịne ammọ ke ekọñ;</para>
  <para style="q2" vid="ISA 27:4">ami ñkpaafọp afịd ammọ ke ikañ.<verse eid="ISA 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 27:5" />Imiidooho ntoro yak ammọ edi embịne miin nte itie udịbe;</para>
  <para style="q2" vid="ISA 27:5">yak ammọ enam emem ye ami,</para>
  <para style="q2" vid="ISA 27:5">ii, yak ammọ enam emem ye ami.”<verse eid="ISA 27:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 27:6" />Ke mme usen ediighe ke iso Yekọb ayaadọñ adʌñ ke isọñ,</para>
  <para style="q2" vid="ISA 27:6">Isrel ayaatịppe anyʌñ akọt</para>
  <para style="q2" vid="ISA 27:6">anyʌñ ayọhọ afịd ederimbod ye mfịd amọ.<verse eid="ISA 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 27:7" />Nte <char style="nd">Abọọñ</char> amaamia anye</para>
  <para style="q2" vid="ISA 27:7">ukem naña anye akemia mbon se ikimia anye?</para>
  <para style="q1" vid="ISA 27:7">Ado nte ewot anye</para>
  <para style="q2" vid="ISA 27:7">ukem naña ekewot mbon se ikiwot anye?<verse eid="ISA 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 27:8" />Ke anwan ye ntañnsio afo amaamʌm anye;</para>
  <para style="q2" vid="ISA 27:8">ye akpọsọñ iyadesịd amọ, anye amaabịn anye asio atop aduọọk,</para>
  <para style="q2" vid="ISA 27:8">nte ke usen afịm ayobio edem usakkautịn afịmeke.<verse eid="ISA 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 27:9" />Ke ntom, ndin, ke ediifeen idiọọkñkpọ Yekọb,</para>
  <para style="q2" vid="ISA 27:9">ndin ami adiido ayọhọ mfịd adikama nsọọk idiọọkñkpọ amọ mfep:</para>
  <para style="q1" vid="ISA 27:9">Ke ini anye amaanam afịd mme itiad akpokoro uwa</para>
  <para style="q2" vid="ISA 27:9">eba nte akañ ekọkkọ ñkeñe-ñkeñe,</para>
  <para style="q1" vid="ISA 27:9">mme abai Asera ndomokeed me insensi mme akpokoro uwa</para>
  <para style="q2" vid="ISA 27:9">idiisọọñọke ida.<verse eid="ISA 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 27:10" />Akpọsọñ abio ana ukpọk,</para>
  <para style="q2" vid="ISA 27:10">idʌñ ekefeeñeke ekpọñ, esịn nte anaan;</para>
  <para style="q1" vid="ISA 27:10">do mme enañ eta mbid,</para>
  <para style="q2" vid="ISA 27:10">do ammọ enaa;</para>
  <para style="q2" vid="ISA 27:10">ammọ ekwat ñkọk amọ enịm ukpọk.<verse eid="ISA 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 27:11" />Mme ñkọk amọ emaesat, ebuuñ ammọ esio,</para>
  <para style="q2" vid="ISA 27:11">ndin ibaan edikoono ammọ ekama ebara ikañ.</para>
  <para style="q1" vid="ISA 27:11">Sia mbon ami edo mbon i-imiinieghe ifiọk;</para>
  <para style="q2" vid="ISA 27:11">ke ntoro Andibod ammọ inieghe mbọm ibaña ammọ,</para>
  <para style="q2" vid="ISA 27:11">Andibod ammọ ñko iwọttọ ammọ mfọn.<verse eid="ISA 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 27:12" />Ke usen ado <char style="nd">Abọọñ</char> ayaasara ñkpọ tọọñọ ke ufeghe mmọọñ Yufretis tutu asịm Inyañ Wadi ke Iyib, ndin afo, Isrel, eyautañ fiin keedekeed ebok. <verse eid="ISA 27:12" /><verse number="13" style="v" sid="ISA 27:13" />Ke usen ado ñko eyaefịt ekamba adukpoñ. Mbon ekekpaññake ke Asiria ye mbon ntañnsio ke Iyib eyaedikpono <char style="nd">Abọọñ</char> ke adisana ekamba abod Yeruselem.<verse eid="ISA 27:13" /></para>
  <chapter eid="ISA 27" />
  <chapter number="28" style="c" sid="ISA 28" />
  <para style="s1">Adọdiọọk Anọ Mme Adaiwuod ke Ifrem ye Yuda</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 28:1" />Adọdiọọk anọ ntinya ado, ntañidem mme akpammịn Ifrem,</para>
  <para style="q2" vid="ISA 28:1">tutu asịm ñyeeme ñkpokpoñ amọ, ubọọñ uyai amọ,</para>
  <para style="q1" vid="ISA 28:1">ebenne ewuuk ke nseghe abedeñ;</para>
  <para style="q2" vid="ISA 28:1">ke abio ado, asian mbon se ukọd asuuhọ itie!<verse eid="ISA 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 28:2" />Ke akpanikọ, <char style="nd">Abọọñ</char> a-anie anye a-anieghe adudu anyʌñ akop uko.</para>
  <para style="q2" vid="ISA 28:2">Nte edịmitiad ye ayobio nsobo,</para>
  <para style="q1" vid="ISA 28:2">nte asọọñ ukod edịm ye akpọsọñ ukod ndiọọñedịm,</para>
  <para style="q2" vid="ISA 28:2">anye ayaatop anye ke adudu aduọọk ke isọñ.<verse eid="ISA 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 28:3" />Ntinya ado, ntañidem mme akpammịn Ifrem,</para>
  <para style="q2" vid="ISA 28:3">eyaesọnnọ anye ke idakikpad.<verse eid="ISA 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 28:4" />Ñyeeme ñkpokpoñ ado, ubọọñ uyai amọ,</para>
  <para style="q2" vid="ISA 28:4">e-ebenne ewuuk ke nseghe abedeñ,</para>
  <para style="q1" vid="ISA 28:4">adiiba nte mme fik e-edatta mbemiso ini idọk;</para>
  <para style="q2" vid="ISA 28:4">ini akeedodo a-mme awo ekịtte anye enyʌñ etuuk anye ke ubọk,</para>
  <para style="q2" vid="ISA 28:4">ammọ emen ammọ.<verse eid="ISA 28:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 28:5" />Ke usen ado <char style="nd">Abọọñ</char> Andikponñkan</para>
  <para style="q2" vid="ISA 28:5">adiido anyanya ubọọñ, ado</para>
  <para style="q1" vid="ISA 28:5">uyaiya ntinya</para>
  <para style="q2" vid="ISA 28:5">anọ ñyọhọnsʌhọ ikọd amọ.<verse eid="ISA 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 28:6" />Anye adiido sịbidịd ukpeunen</para>
  <para style="q2" vid="ISA 28:6">anọ anye a-atieghe ke ikpe,</para>
  <para style="q1" vid="ISA 28:6">itie adudu</para>
  <para style="q2" vid="ISA 28:6">anọ mbon se ikpaap ida inwana ekọñ ke inuaatob.<verse eid="ISA 28:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 28:7" />Mbon ami ñko enyʌñ eteeñe ke ntak ukọd</para>
  <para style="q2" vid="ISA 28:7">enyʌñ eyọọrọ ke ntak bie:</para>
  <para style="q1" vid="ISA 28:7">Mme aku ye mme prọfed eteeñe ke ntak bie</para>
  <para style="q2" vid="ISA 28:7">ñko ukọd anyʌñ anam ammọ edutịn;</para>
  <para style="q1" vid="ISA 28:7">ammọ eyọọrọ ke ntak ukọd,</para>
  <para style="q2" vid="ISA 28:7">ammọ eteeñe idaha ekịtte ñkukịd;</para>
  <para style="q2" vid="ISA 28:7">enyʌñ eteeñe ke ini enọọhọ ubiideikpe.<verse eid="ISA 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 28:8" />Afịd akpokoro eyọhọ ye akikọi</para>
  <para style="q2" vid="ISA 28:8">inyʌññọ iba itie ndomokeed i-imiibatta.<verse eid="ISA 28:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 28:9" />“Anie awo ke anye anwana adikpeep?</para>
  <para style="q2" vid="ISA 28:9">Anie ke anye ayem inam etob ami anwaña?</para>
  <para style="q1" vid="ISA 28:9">Me ntəkayịn e-etreke uwọp eba,</para>
  <para style="q2" vid="ISA 28:9">me mbon e-esʌkkọ esosio ke eba?<verse eid="ISA 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 28:10" />Sia ado:</para>
  <para style="q2" vid="ISA 28:10">Nam ami, nam ako,</para>
  <para style="q2" vid="ISA 28:10">mbed aba anọ anye ami, mbed aba anọ anye ako;</para>
  <para style="q2" vid="ISA 28:10">etək-etək mi, etək-etək ko.”<verse eid="ISA 28:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 28:11" />Ndin ke ntoro, ye mme asen ñkpọkinua ye mme asen edeme usem</para>
  <para style="q2" vid="ISA 28:11">Abasi ayaatañ ikọ anọ ibon ami,<verse eid="ISA 28:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 28:12" />a-anye akebooho ate,</para>
  <para style="q2" vid="ISA 28:12">“Itie nduọkadudu ado ami, yak mbon mmemidem eduọk adudu;”</para>
  <para style="q1" vid="ISA 28:12">ñko, “Itie nnaa nduọkadudu ado ami,”</para>
  <para style="q2" vid="ISA 28:12">ado ammọ ikamma ikpañ utọñ.<verse eid="ISA 28:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 28:13" />Ke ntoro, ikọ Abọọñ ayaado anọ ammọ:</para>
  <para style="q2" vid="ISA 28:13">Nam ami, nam ako,</para>
  <para style="q2" vid="ISA 28:13">mbed aba anọ anye ami, mbed aba anọ anye ako;</para>
  <para style="q2" vid="ISA 28:13">etək-etək mi, etək-etək ko;</para>
  <para style="q1" vid="ISA 28:13">nọ ato do naña ammọ eka ammọ eyaeduọ ñkpaedem;</para>
  <para style="q2" vid="ISA 28:13">ammọ eyaedat unan enyʌñ eduọ edʌk afia, ndin eyaemʌm ammọ.<verse eid="ISA 28:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 28:14" />Ke ntoro ikop ikọ <char style="nd">Abọọñ</char>, ndufo mbon nsaha</para>
  <para style="q2" vid="ISA 28:14">e-ekarake ibon ami ke Yeruselem.<verse eid="ISA 28:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 28:15" />Ndufo enam inua ebo, “Ñnyịn iminam edioomo ye ñkpa,</para>
  <para style="q2" vid="ISA 28:15">ke abioekpo mme akpañkpa ñnyịn iminie edioomo.</para>
  <para style="q1" vid="ISA 28:15">Ke ini nsobo afịmeke aboiyo,</para>
  <para style="q2" vid="ISA 28:15">anye idiituuho ñnyịn,</para>
  <para style="q1" vid="ISA 28:15">sia ñnyịn iminam abiaña ado itie udịbe ñnyịn,</para>
  <para style="q2" vid="ISA 28:15">nsu-nsu uwem anyʌñ ado itie udịbe ñnyịn.”<verse eid="ISA 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 28:16" />Ke ntoro se <char style="nd">Abọọñ</char> Andikara atañ ado ami:</para>
  <para style="q1" vid="ISA 28:16">“Ke akpanikọ, ami mmenịm itiad ke Saiyọn, itiad e-emaekedomo ese,</para>
  <para style="q2" vid="ISA 28:16">nsọñudua itiad inuuk e-ebenne esịn nsọọñọnda itiad idakisọñ;</para>
  <para style="q1" vid="ISA 28:16">awo a-abuọttọ idem ye anye</para>
  <para style="q2" vid="ISA 28:16">tutu amama idiinieghe ayeemensia.<verse eid="ISA 28:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 28:17" />Ami ñyaanam unen ado udomoñkpọ,</para>
  <para style="q2" vid="ISA 28:17">adinenido ñko adiido udʌk udomoñkpọ;</para>
  <para style="q1" vid="ISA 28:17">edịmitiad ayaakwọọk nsu-nsu itie udịbe mfo ado,</para>
  <para style="q2" vid="ISA 28:17">ndin mmọọñ ayaafʌk itie udịbe mfo.<verse eid="ISA 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 28:18" />Eyaebiat akaaña mfo ye ñkpa efep;</para>
  <para style="q2" vid="ISA 28:18">edioomo mfo ye mbon abioekpo idiisọññọ ida.</para>
  <para style="q1" vid="ISA 28:18">Ke ini nsobo afịmeke adiboiyo</para>
  <para style="q2" vid="ISA 28:18">anye ayaumia fiin anịm.<verse eid="ISA 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 28:19" />Naña ini se anye adedi anye ayauben fiin afep;</para>
  <para style="q2" vid="ISA 28:19">ke ubakusen akeeneke ubakusen, ke uweemeayio ye ke akonayio,</para>
  <para style="q2" vid="ISA 28:19">anye ayaaben afep.”</para>
  <para style="b" vid="ISA 28:19" />
  <para style="q1" vid="ISA 28:19">Unie ifiọk mbaña etob ami</para>
  <para style="q2" vid="ISA 28:19">ayaaben ataa ndịk adi.<verse eid="ISA 28:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 28:20" />Ikʌk aməho akan se eneeñe idem,</para>
  <para style="q2" vid="ISA 28:20">ndoppo afọñ asịp akan se akama afʌk idem.<verse eid="ISA 28:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 28:21" />
    <char style="nd">Abọọñ</char> ayaadakka ada kpa naña akenam ke Abod Perasịm,</para>
  <para style="q2" vid="ISA 28:21">anye ayaadịppe idem amọ naña akenam ke Abedeñ Kibiọn;</para>
  <para style="q1" vid="ISA 28:21">adinam utom amọ, utịbe utom amọ,</para>
  <para style="q2" vid="ISA 28:21">anyʌñ anam utom amọ, utom ñkpaidem amọ.<verse eid="ISA 28:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 28:22" />Tre esaha mfo idahami,</para>
  <para style="q2" vid="ISA 28:22">imiidooho ntoro akpọnọ mfo ayaadoppo akan ami;</para>
  <para style="q1" vid="ISA 28:22">Abọọñ, <char style="nd">Abọọñ</char> Andikponñkan, andọkkọ miin</para>
  <para style="q2" vid="ISA 28:22">abaña nsobo e-ebiereke enọ afịd isọñ.<verse eid="ISA 28:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="ISA 28:23" />Kpañ utọñ nyʌñ kop uyio mmi;</para>
  <para style="q2" vid="ISA 28:23">kpañ utọñ nyʌñ kop se ami ntañ.<verse eid="ISA 28:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 28:24" />Ke ini atọinwañ asifʌññọ isọñ anịm anọ utọ, nte anye asifʌñ isọñ ke nsi-nsi?</para>
  <para style="q2" vid="ISA 28:24">Nte anye adiikaka iso itịppe inyʌñ idọk isọñ?<verse eid="ISA 28:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 28:25" />Anye amaadiọñ isọñ yak anekke ana,</para>
  <para style="q2" vid="ISA 28:25">nte anye ikpitọọhọ karawe inyʌñ isuan kumin?</para>
  <para style="q1" vid="ISA 28:25">Nte anye itọọhọ wiid ke itie amọ,</para>
  <para style="q2" vid="ISA 28:25">baali ke inwañ amọ,</para>
  <para style="q2" vid="ISA 28:25">ye speel ke inwañ amọ?<verse eid="ISA 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 28:26" />Abasi amọ atemme anye</para>
  <para style="q2" vid="ISA 28:26">anyʌñ akpeep anye eti usʌñ.<verse eid="ISA 28:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="ISA 28:27" />Awo ikamake akpeti ibeek karawe,</para>
  <para style="q2" vid="ISA 28:27">inyʌññọ iwere ukpadñkpọ idot ke anyọñ kumin;</para>
  <para style="q1" vid="ISA 28:27">ekama adọọn eyuup karawe esio,</para>
  <para style="q2" vid="ISA 28:27">enyʌñ emia kumin ke eto.<verse eid="ISA 28:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 28:28" />Ana ekọk ñkwa abakpa ndin enam uyo;</para>
  <para style="q2" vid="ISA 28:28">sia inaaha ebeek anye ke nsi-nsi.</para>
  <para style="q1" vid="ISA 28:28">Ekeme ediwere ikpad ukpadñkpọ ke anyọñ ammọ,</para>
  <para style="q2" vid="ISA 28:28">ado awo ikamake enañmbakara ikọk abakpa.<verse eid="ISA 28:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 28:29" />Afịd ami eto Abọọñ Andikponñkan,</para>
  <para style="q2" vid="ISA 28:29">u-uduak amọ adooho utịppe,</para>
  <para style="q2" vid="ISA 28:29">a-aniọñ amọ anyʌññọ afọn eti-eti.<verse eid="ISA 28:29" /></para>
  <chapter eid="ISA 28" />
  <chapter number="29" style="c" sid="ISA 29" />
  <para style="s1">Adọdiọọk anọ Abio Defid</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 29:1" />Adọdiọọk unọ fiin, Ariel, Ariel,</para>
  <para style="q2" vid="ISA 29:1">abio a-Defid akedʌññọ!</para>
  <para style="q1" vid="ISA 29:1">Dian isua ke isua</para>
  <para style="q2" vid="ISA 29:1">nyʌñ nam mme usọrọ mfo ekaiso.<verse eid="ISA 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 29:2" />Ado ami ñyaakanna Ariel ñkʌk;</para>
  <para style="q2" vid="ISA 29:2">anye ayaatua anyʌñ aseeme,</para>
  <para style="q2" vid="ISA 29:2">anye adiiba nte akpokoro uwa mben ikañ annọ miin.<verse eid="ISA 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 29:3" />Ami ñyaanaa ukpeme fiin ke afịd ñkañ;</para>
  <para style="q2" vid="ISA 29:3">Ami ñyaukanna fiin ñkʌk ye mme tọwa,</para>
  <para style="q2" vid="ISA 29:3">ñnyʌñ mbọp mme ñkpọsọñ itie ukpeme ubaña fiin.<verse eid="ISA 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 29:4" />Eyausuuhọ fiin enịm, afo ayaanaa ke isọñ atañ ikọ;</para>
  <para style="q2" vid="ISA 29:4">uyio mfo adiido mmịm-mmịm ato ke abu awuọ adi.</para>
  <para style="q1" vid="ISA 29:4">Uyio mfo ayaawuọ nte uyio ekpoñkpa ato isọñ;</para>
  <para style="q2" vid="ISA 29:4">uyio mfo ayaanuun ato abu isọñ awuọ adi.<verse eid="ISA 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 29:5" />Ado mme uwak asua mfo eyaekappa eba nte ndọdọnọ abu,</para>
  <para style="q2" vid="ISA 29:5">ikpọ mbon afai eyaebit mbio e-ekwọọhọ eduọk.</para>
  <para style="q1" vid="ISA 29:5">Usọp-usọp, ini keed ini keed,<verse eid="ISA 29:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 29:6" />
    <char style="nd">Abọọñ</char> Andikponñkan ayaadi</para>
  <para style="q1" vid="ISA 29:6">ye aduma ye unyekisọñ ye akpọsọñ uyom,</para>
  <para style="q2" vid="ISA 29:6">ye ayobio ye akpọsọñ afịm ye akpọsọñ edemeikañ a-ataahata asobo.<verse eid="ISA 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 29:7" />Ndin afịd ikpọ atu mme idịd enwanake ye Ariel,</para>
  <para style="q2" vid="ISA 29:7">afịd mbon se inwana ye anye enyʌñ ekanna anye ye mme ñkpọsọñ itie amọ ekʌk,</para>
  <para style="q1" vid="ISA 29:7">eyaeba nte naña aba ke ndab,</para>
  <para style="q2" vid="ISA 29:7">ye ñkukịd ke akonayio,<verse eid="ISA 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 29:8" />kpa naña awo abiọọñ adappa naña adia ndidia,</para>
  <para style="q2" vid="ISA 29:8">ado ademme ye idịb abiọọñ;</para>
  <para style="q1" vid="ISA 29:8">kpa naña awo nsaditọñ adappa naña anwọñ ñkpọ,</para>
  <para style="q2" vid="ISA 29:8">ado ademme nte awo mmemidem ye nsaditọñ.</para>
  <para style="q1" vid="ISA 29:8">Kpa ntoro ke adiido ye afịd mme idịd</para>
  <para style="q2" vid="ISA 29:8">e-enwanake ekọñ ye Abod Saiyọn.<verse eid="ISA 29:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 29:9" />Ndufo inie eyịghe inyʌñ iba ke ñkpaidem,</para>
  <para style="q2" vid="ISA 29:9">isịn adikịt usʌñ inyʌñ iforo nnan;</para>
  <para style="q1" vid="ISA 29:9">ikop inaam, ado ke ato ke ukọd,</para>
  <para style="q2" vid="ISA 29:9">iteeñe ado ke ato ke bie.<verse eid="ISA 29:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 29:10" />
    <char style="nd">Abọọñ</char> anam akpọsọñ idab imʌm ndufo:</para>
  <para style="q2" vid="ISA 29:10">Anye ifʌk ndufo anyen (mme prọfed);</para>
  <para style="q2" vid="ISA 29:10">anye ifʌk ndufo iwuod (mme akịdñkukịd).<verse eid="ISA 29:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 29:11" />Afịd ñkukịd ami idooho ñkpọ ndomokeed unọ fiin ikan mme ikọ e-enịmme idiọọñọ ke ñwed. Ndin adieke afo ayaaha ñwed ami anọọ awo se ikan ikoot, anyʌñ abo, “Mbọk, koot anye ami,” ammọ eyaebọọrọ, “Ami ñkanna; emaefiik idiọọñọ ke anye.” <verse eid="ISA 29:11" /><verse number="12" style="v" sid="ISA 29:12" />Ado afo akpenọ awo i-imiikanna ikoot ñwed ami, anyʌñ abo, “Mbọk, koot anye ami,” ammọ eyaebọọrọ, “Ami nnọọhọ adikoot ñwed.”<verse eid="ISA 29:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="ISA 29:13" />
    <char style="nd">Abọọñ</char> ate:</para>
  <para style="q1" vid="ISA 29:13">“Ibon ami edi embịne miin ke inua ammọ</para>
  <para style="q2" vid="ISA 29:13">enyʌñ eñkpono miin ke ñkpọkinua ammọ,</para>
  <para style="q2" vid="ISA 29:13">ado esịd ammọ eda nsan-nsan eñkpọñ miin.</para>
  <para style="q1" vid="ISA 29:13">Ukpono a-ammọ eñkponoke miin</para>
  <para style="q2" vid="ISA 29:13">akọñọ ke mme mbed e-ekpeebe ammọ.<verse eid="ISA 29:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 29:14" />Ke ntoro ini keed mfen ami ñyaanam idem akpa ibon ami</para>
  <para style="q2" vid="ISA 29:14">ke utịppeñkpọ ye utịppeñkpọ;</para>
  <para style="q1" vid="ISA 29:14">aniọñ mbon aniọñ ayaatak,</para>
  <para style="q2" vid="ISA 29:14">mbufiọk mbon ntaifiọk ayaasop.”<verse eid="ISA 29:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 29:15" />Adọdiọọk anọ mbon e-ekaaha akpọsọñ ntotəño itie</para>
  <para style="q2" vid="ISA 29:15">adidịp mme uduak ammọ mbaak <char style="nd">Abọọñ</char> adidiọọñọ,</para>
  <para style="q1" vid="ISA 29:15">mbon e-enamma utom ammọ ke ekịm enyʌñ ekere,</para>
  <para style="q2" vid="ISA 29:15">“Anie awo ikịt ñnyịn? Anie awo idiidiọọñọ?”<verse eid="ISA 29:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 29:16" />Afo asịn ñkpọ akanna,</para>
  <para style="q2" vid="ISA 29:16">anyʌñ akere ke abodabañ adiiba nte aduañ!</para>
  <para style="q1" vid="ISA 29:16">Nte se ebot akeme adibo andibod anye,</para>
  <para style="q2" vid="ISA 29:16">“Idooho afo akembot miin”?</para>
  <para style="q1" vid="ISA 29:16">Nte abañ akeme adibo abodabañ,</para>
  <para style="q2" vid="ISA 29:16">“Afo udiọọñọke ñkpọ ndomokeed”?<verse eid="ISA 29:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ISA 29:17" />Ke ataa ibio-ibio ini, nte Lebanọn idiikappake ido isọñ nseghe,</para>
  <para style="q2" vid="ISA 29:17">ndin isọñ nseghe anyʌñ akappa aba nte akai?<verse eid="ISA 29:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 29:18" />Ke usen ado inan ayaakop mme ikọ esịneke ke ñwed,</para>
  <para style="q2" vid="ISA 29:18">ndin ato ke mfʌhọ ye ekịm</para>
  <para style="q2" vid="ISA 29:18">anyen nnan ayaakịt usʌñ.<verse eid="ISA 29:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 29:19" />Ini keed mfen mbon nsuukidem eyaedaara ke <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="ISA 29:19">mbon unana eyaedaara ke Adisana Awo Isrel.<verse eid="ISA 29:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 29:20" />Mbon isọñesịd eyaesoomo,</para>
  <para style="q2" vid="ISA 29:20">mbon nsaha eyaesoomo,</para>
  <para style="q2" vid="ISA 29:20">ñko eyaekpok afịd mbon se ikama anyen iyem idiọọkñkpọ adinam efep;<verse eid="ISA 29:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 29:21" />mbon e-ekamake ikọ ebiom awo ikpe,</para>
  <para style="q2" vid="ISA 29:21">e-ekọọhọ afia enọ mbon e-edaaha ikpe ye ammọ ke esob,</para>
  <para style="q2" vid="ISA 29:21">enyʌñ ekama nsu-nsu ikọ ntiense ebiọñọ mbon i-imiidueghe adinie unenikpe.<verse eid="ISA 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 29:22" />Ke ntoro kop se <char style="nd">Abọọñ</char>, a-akefakka Ebraham, atañ anọ ubon Yekọb:</para>
  <para style="q1" vid="ISA 29:22">“Abuud idiinamma Yekọb aba;</para>
  <para style="q2" vid="ISA 29:22">iso ammọ idiibaaha ntọñ-ntọñ aba.<verse eid="ISA 29:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 29:23" />Ke ini ammọ ekịtte nditọ ammọ ke atu ammọ,</para>
  <para style="q2" vid="ISA 29:23">utom ubọk mmi,</para>
  <para style="q1" vid="ISA 29:23">ammọ eyaenịm anyịñ mmi nte adisana;</para>
  <para style="q2" vid="ISA 29:23">ammọ eyaediọọñọ adisana ido Adisana Awo Yekọb,</para>
  <para style="q2" vid="ISA 29:23">eyaenyʌñ eba ke uteeñe ke iso Abasi Isrel.<verse eid="ISA 29:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 29:24" />Mbon se sịbidịd ammọ eyooñ eyaebọ ifiọk;</para>
  <para style="q2" vid="ISA 29:24">mbon nsuukuyio eyaenyịmme item.”<verse eid="ISA 29:24" /></para>
  <chapter eid="ISA 29" />
  <chapter number="30" style="c" sid="ISA 30" />
  <para style="s1">Adọdiọọk Anọ Abio Nsọñiwuod</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 30:1" />“Adọdiọọk anọ nditọ nsọñiwuod,”</para>
  <para style="q2" vid="ISA 30:1">
    <char style="nd">Abọọñ</char> atañ,</para>
  <para style="q1" vid="ISA 30:1">“mbon e-enamma uduak i-imiidooho ake mmi,</para>
  <para style="q2" vid="ISA 30:1">e-edʌkkọ edioomo, ado itooho ke sịbidịd mmi,</para>
  <para style="q2" vid="ISA 30:1">ekọọk idiọọkñkpọ edot ke idiọọkñkpọ;<verse eid="ISA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 30:2" />e-esọiyọke eka Iyib</para>
  <para style="q2" vid="ISA 30:2">ke ini imiibọọhọ uyio into miin;</para>
  <para style="q1" vid="ISA 30:2">eyemme unwam eto ukpeme Fero,</para>
  <para style="q2" vid="ISA 30:2">eyemme itie udịbe eto ndeeñ Iyib.<verse eid="ISA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 30:3" />Ado ukpeme Fero adiido ñkpọ abuud unọ fiin,</para>
  <para style="q2" vid="ISA 30:3">mfuud Iyib adiiben asuenne usọk fiin.<verse eid="ISA 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 30:4" />Akpesʌkado ammọ enieghe mme adaaha ke Soan,</para>
  <para style="q2" vid="ISA 30:4">mme isʌñutom ammọ enyʌñ eto Hanes edi,<verse eid="ISA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 30:5" />eyaesịn afịd awo ke abuud</para>
  <para style="q2" vid="ISA 30:5">ato mbon i-imiibaaha ufọn inọ ammọ,</para>
  <para style="q1" vid="ISA 30:5">i-imiibenne unwam me ufọn idi,</para>
  <para style="q2" vid="ISA 30:5">ado sʌk abuud ye asuenne.”<verse eid="ISA 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 30:6" />Prọfesi a-abañake mme unam ke Nekef:</para>
  <para style="q1" vid="ISA 30:6">Ke eboiyoke ke isọñ nsọñọñkpọ ye ndutʌhọ,</para>
  <para style="q2" vid="ISA 30:6">isọñ ñyaara ye uman ekpe,</para>
  <para style="q2" vid="ISA 30:6">mme ibọm ye mme utatamma udʌkikọd,</para>
  <para style="q1" vid="ISA 30:6">mme isʌñutom ebiom inie ammọ ke edem dọñki,</para>
  <para style="q2" vid="ISA 30:6">mme ñkpọuto ammọ ke mme ekʌñ kamel,</para>
  <para style="q1" vid="ISA 30:6">ekaa idịd i-imiibaaha ufọn,<verse eid="ISA 30:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="ISA 30:7" />ekaa Iyib, u-unwam ammọ imiibaaha ufọn ndomokeed.</para>
  <para style="q1" vid="ISA 30:7">Ke ntoro ami ñkoot anye</para>
  <para style="q2" vid="ISA 30:7">Rahab Ammiinamma-Ñkpọ Ndomokeed.<verse eid="ISA 30:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 30:8" />Kaa idahami, wet ke itiadñwed nọ ammọ,</para>
  <para style="q2" vid="ISA 30:8">wet anye ke ñwed,</para>
  <para style="q1" vid="ISA 30:8">ke mme usen ediighe ke iso,</para>
  <para style="q2" vid="ISA 30:8">anye akeme adido nsi-nsi ntiense.<verse eid="ISA 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 30:9" />Sia mbon ami edo mbon afai, nditọ abiaña,</para>
  <para style="q2" vid="ISA 30:9">nditọ i-imiimaaha adikop item <char style="nd">Abọọñ</char>.<verse eid="ISA 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 30:10" />Ammọ ebo mme akịdñkukịd,</para>
  <para style="q2" vid="ISA 30:10">“Ikiikịt mme ñkukịd aba!”</para>
  <para style="q1" vid="ISA 30:10">Enyʌñ ebo mme prọfed,</para>
  <para style="q2" vid="ISA 30:10">“Ikiinọọ ñnyịn mme ñkukịd a-adooho akpanikọ aba!</para>
  <para style="q1" vid="ISA 30:10">Idọkkọ ñnyịn mme inem ñkpọ,</para>
  <para style="q2" vid="ISA 30:10">itañ mme nsu-nsu ñkukịd.<verse eid="ISA 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 30:11" />Ikpọñ usʌñ ami,</para>
  <para style="q2" vid="ISA 30:11">ikiisaña ke afañ ami,</para>
  <para style="q1" vid="ISA 30:11">inyʌñ itre aditọhọ ye ñnyịn</para>
  <para style="q2" vid="ISA 30:11">mbaña Adisana Abasi Isrel!”<verse eid="ISA 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 30:12" />Ke ntoro ikop se Adisana Abasi Isrel atañ:</para>
  <para style="q1" vid="ISA 30:12">“Sia ndufo emesịn etob ami,</para>
  <para style="q2" vid="ISA 30:12">ebuọt idem ye mbon ufiik,</para>
  <para style="q2" vid="ISA 30:12">enyʌñ edot anyen ke abiaña,<verse eid="ISA 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 30:13" />idiọọkñkpọ ami ayaado inọ ndufo</para>
  <para style="q2" vid="ISA 30:13">nte anyan ndibene, amaakesaiya ayem adiduọ,</para>
  <para style="q2" vid="ISA 30:13">aduọhọ ini keed usọp-usọp.<verse eid="ISA 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 30:14" />Anye ayaaboomo mbai-mbai nte ako aduañ,</para>
  <para style="q2" vid="ISA 30:14">asuana mbọm ibaaha</para>
  <para style="q1" vid="ISA 30:14">ke atu ñkpoho amọ, tutu awo idiikịtte ibio ndomokeed</para>
  <para style="q2" vid="ISA 30:14">se ekama edappa ukañ ke atʌñikañ,</para>
  <para style="q2" vid="ISA 30:14">me se ekama ekoi mmọọñ ke abañ.”<verse eid="ISA 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 30:15" />Se <char style="nd">Abọọñ</char> Andikara, Adisana Abasi Isrel, abo ado ami:</para>
  <para style="q1" vid="ISA 30:15">“Adinyaaña mfo asịne ke ukappaesịd ye nduọkadudu,</para>
  <para style="q2" vid="ISA 30:15">adudu mfo aba ke ndobuyio ye mbuọdidem,</para>
  <para style="q2" vid="ISA 30:15">ado afo unieghe ndomokeed ke atu ammọ.<verse eid="ISA 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 30:16" />Afo ate, ‘Iyoo, ñnyịn iyaifeeñe ke anyọñ enañmbakara.’</para>
  <para style="q2" vid="ISA 30:16">Ke ntoro afo ayaafeghe!</para>
  <para style="q1" vid="ISA 30:16">Afo ate, ‘Ñnyịn iyaiwat iwuọ ke mme asọp usọp enañ.’</para>
  <para style="q2" vid="ISA 30:16">Ke ntoro mbon se ubịne fiin eyaesọp eti-eti!<verse eid="ISA 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 30:17" />Tọsịn keed eyaefeghe</para>
  <para style="q2" vid="ISA 30:17">ke ndịkke awo keed;</para>
  <para style="q1" vid="ISA 30:17">ke ndịkke awo ition</para>
  <para style="q2" vid="ISA 30:17">afịd ndufo eyaefeeñe,</para>
  <para style="q1" vid="ISA 30:17">tutu ikpọñ ndufo</para>
  <para style="q2" vid="ISA 30:17">nte afọñidiọọñọ ke anyọñ ekamba abod,</para>
  <para style="q2" vid="ISA 30:17">nte afọñidiọọñọ ke anyọñ etəkabod.”<verse eid="ISA 30:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 30:18" />Ado <char style="nd">Abọọñ</char> anie udọñ aditua ndufo mbọm;</para>
  <para style="q2" vid="ISA 30:18">ke ntoro anye ayaadakka ada itua ndufo mbọm.</para>
  <para style="q1" vid="ISA 30:18">Sia <char style="nd">Abọọñ</char> ado Abasi akpe unen.</para>
  <para style="q2" vid="ISA 30:18">Afọfọn anọ afịd mbon se itie ibet anye!<verse eid="ISA 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 30:19" />Mbon Saiyọn, e-edʌññọ ke Yeruselem, ndufo idiituaha ayịd aba. Anye adiifọn die ido ye ndufo ke ini ndufo etuaha enọọ anye eyem unwam! Anye ayaibọọrọ ndufo, anye amaasʌk akokop. <verse eid="ISA 30:19" /><verse number="20" style="v" sid="ISA 30:20" />Akpesʌkado Abọọñ inọọhọ ndufo uyo ukuud ye mmọọñ ndutʌhọ, awo idiidịppe mme andikpeeb ndufo aba; ndufo eyaedat anyen ndufo ekịt ammọ. <verse eid="ISA 30:20" /><verse number="21" style="v" sid="ISA 30:21" />Akpekọm ndufo ekanna nnasia me ufiin, mme utọñ ndufo eyaekop uyio ke edem ndufo, a-abooho, “Usʌñ ado ami; saña ke anye.” <verse eid="ISA 30:21" /><verse number="22" style="v" sid="ISA 30:22" />Ndin ndufo eyaesappa mme ubobod abasi ndufo e-efʌkkọ ke silfa ye mme ubobod ñkpọ ndufo e-ekamake kold efʌk; ndufo eyaetop ammọ eduọk nte afọñ itieisọñ enyʌñ ebo ammọ, “Iwuọñọ ndin!”<verse eid="ISA 30:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="ISA 30:23" />Anye ayaanyʌñ adọñ edịm anọ mme mfịd se ndufo etọ ke isọñ, ndin ndidia se ito isọñ ado ayaanem anyʌñ awak. Ke usen ado mme ufene ndufo eyaeta mbid ke mme unaisọñ. <verse eid="ISA 30:23" /><verse number="24" style="v" sid="ISA 30:24" />Mme ñyaaraenañ ye mme dọñki e-enamma utom ke ikọd eyaeta ikịm, e-ekamake ñkpọ ukịm isọñ ye udọk esuan. <verse eid="ISA 30:24" /><verse number="25" style="v" sid="ISA 30:25" />Ke ekamba usen uwodawo, ke ini mme tọwa eduọññọke, mmọọñ ayaato mme ikpọabod ye afịd ntək nti abod awuọ. <verse eid="ISA 30:25" /><verse number="26" style="v" sid="ISA 30:26" />Afiọñ ayaayamma nte utịn, ndin unwana utịn ayaayamma akañ itiaba akan naña asiyama, nte unwana a-ayọhọke usen itiaba, ke ini <char style="nd">Abọọñ</char> amaabọp unan ikọd amọ anyʌñ akọk mme unan ammọ a-anye akenọọhọ.<verse eid="ISA 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 30:27" />Se, Anyịñ <char style="nd">Abọọñ</char> ato anyan itie,</para>
  <para style="q2" vid="ISA 30:27">ye akpọsọñ iyadesịd ye nsʌñikañ nte ntọñanyọñ;</para>
  <para style="q1" vid="ISA 30:27">ñkpọkinua amọ ayọhọ ye iyadesịd,</para>
  <para style="q2" vid="ISA 30:27">edeme amọ ñko anyʌñ aba nte ikañ a-ataahata.<verse eid="ISA 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 30:28" />Ibifịk amọ aba nte akpọsọñ mmọọñ a-atọọhọ,</para>
  <para style="q2" vid="ISA 30:28">adọọk asịm itọñ.</para>
  <para style="q1" vid="ISA 30:28">Anye anyeghe mme idịd ke ukeñ nsobo;</para>
  <para style="q2" vid="ISA 30:28">anye adot ke akpọmbañ mme awo</para>
  <para style="q2" vid="ISA 30:28">udʌk adʌttọ ammọ akpọñ usʌñ.<verse eid="ISA 30:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 30:29" />Ndin ndufo eyaekwọ</para>
  <para style="q2" vid="ISA 30:29">kpa nte ke akonayio a-ndufo ediaha idaara adisana usọrọ;</para>
  <para style="q1" vid="ISA 30:29">esịd ndufo ayaadaara</para>
  <para style="q2" vid="ISA 30:29">nte naña mbon se ifịt mme adʌk edakka eda eka</para>
  <para style="q1" vid="ISA 30:29">ekamba abod <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 30:29">eka Ekamba Itiad Isrel.<verse eid="ISA 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 30:30" />
    <char style="nd">Abọọñ</char> ayaanam mme awo ekop uyio ubọọñ amọ,</para>
  <para style="q2" vid="ISA 30:30">ayaanyʌñ anam ammọ ekịt naña ubọk amọ asọiyọ ke isọñ</para>
  <para style="q1" vid="ISA 30:30">ye akpọsọñ iyadesịd ye ikañ a-ataahata,</para>
  <para style="q2" vid="ISA 30:30">ye akpọsọñ uyom anyọñ, aduma ye edịmitiad.<verse eid="ISA 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 30:31" />Uyio <char style="nd">Abọọñ</char> ayaasuan Asiria;</para>
  <para style="q2" vid="ISA 30:31">anye ayaamia ammọ abon ke isọñ ye esañ amọ.<verse eid="ISA 30:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 30:32" />Afịd ikpa se <char style="nd">Abọọñ</char> amia ammọ</para>
  <para style="q2" vid="ISA 30:32">ye akpeti ufen amọ</para>
  <para style="q1" vid="ISA 30:32">ediiba nte uyom ikwọ a-atooho ibịdubọk ye mme ndido,</para>
  <para style="q2" vid="ISA 30:32">naña anye akama mme eta ubọk amọ anwana anwan ye ammọ.<verse eid="ISA 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ISA 30:33" />Akpeene ekebeeñe Tofed idem;</para>
  <para style="q2" vid="ISA 30:33">emaebeeñe anye idem enịm enọ adidem.</para>
  <para style="q1" vid="ISA 30:33">Enam ube ikañ amọ atʌñọ anyʌñ anwaña,</para>
  <para style="q2" vid="ISA 30:33">ye ekamba ebohoikañ ye ifia;</para>
  <para style="q1" vid="ISA 30:33">ibifịk <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 30:33">nte udịmikañ esịnne sọlfọ,</para>
  <para style="q2" vid="ISA 30:33">anam anye anekke asak.<verse eid="ISA 30:33" /></para>
  <chapter eid="ISA 30" />
  <chapter number="31" style="c" sid="ISA 31" />
  <para style="s1">Adọdiọọk Anọ Mbon e-Ebuọttọ Idem ke Iyib</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 31:1" />Adọdiọọk anọ mbon e-esọiyọke eka Iyib ekeyem unwam,</para>
  <para style="q2" vid="ISA 31:1">e-ebuọttọ idem ke enañmbakara,</para>
  <para style="q1" vid="ISA 31:1">e-enieghe idodanyen ke uwak sariọd ammọ</para>
  <para style="q2" vid="ISA 31:1">ye ke akpọsọñ adudu mme awad enañmbakara ammọ,</para>
  <para style="q1" vid="ISA 31:1">ado iseeghe Adisana Abasi Isrel,</para>
  <para style="q2" vid="ISA 31:1">inyʌññọ iyem unwam ito <char style="nd">Abọọñ</char>.<verse eid="ISA 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 31:2" />Ado anye ñko anie ifiọk anyʌñ akeme adiben nsobo ndi;</para>
  <para style="q2" vid="ISA 31:2">anye ikpʌhọke mme ikọ amọ.</para>
  <para style="q1" vid="ISA 31:2">Anye ayaadakka ada anwana ye idịd ibak ado,</para>
  <para style="q2" vid="ISA 31:2">anwana ye mbon enwamma mme anamidiọọk.<verse eid="ISA 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 31:3" />Ado mbon Iyib edo ñkaña awo, idooho Abasi;</para>
  <para style="q2" vid="ISA 31:3">mme enañmbakara ammọ edo unam, idooho sịbidịd.</para>
  <para style="q1" vid="ISA 31:3">Ke ini <char style="nd">Abọọñ</char> anyanna ubọk amọ,</para>
  <para style="q2" vid="ISA 31:3">mbon se inwam eyaetuak ukod,</para>
  <para style="q2" vid="ISA 31:3">mbon se enwam eyaeduọññọ;</para>
  <para style="q2" vid="ISA 31:3">eyaesobo afịd ammọ akañ keed.<verse eid="ISA 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 31:4" />Se <char style="nd">Abọọñ</char> atañ annọ miin ado ami:</para>
  <para style="q1" vid="ISA 31:4">“Kpa naña ekpe akuun,</para>
  <para style="q2" vid="ISA 31:4">ekamba ekpe ye ndita amọ,</para>
  <para style="q1" vid="ISA 31:4">ñko akpesʌkado ekoodo udịm mme akpemeedọñ</para>
  <para style="q2" vid="ISA 31:4">yak afịd ammọ ebịne anye,</para>
  <para style="q1" vid="ISA 31:4">idem inyeññe anye ibaña uyom ammọ</para>
  <para style="q2" vid="ISA 31:4">inyʌññọ ifịna ibaña akpọsọñ uyom ammọ;</para>
  <para style="q1" vid="ISA 31:4">ke ntoro <char style="nd">Abọọñ</char> Andikponñkan ayaasọiyọ adi</para>
  <para style="q2" vid="ISA 31:4">adinwana ekọñ ke Abod Saiyọn ye ke mme ñkoñ-ñkoñ itie amọ.<verse eid="ISA 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 31:5" />Nte mme inuen e-efuurọke ke anyọñ,</para>
  <para style="q2" vid="ISA 31:5">
    <char style="nd">Abọọñ</char> Andikponñkan ayaakpeme Yeruselem;</para>
  <para style="q1" vid="ISA 31:5">anye ayaakpeme anyʌñ akpọk anye ayaak,</para>
  <para style="q2" vid="ISA 31:5">anye ‘ayaasaña ke anyọñ amọ aboiyo’ anyʌñ afak anye.”<verse eid="ISA 31:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 31:6" />Inyọñ idi, ndufo nditọ Isrel, ibịne Anye a-ndufo ekenamma nsọñiwuod ebaña. <verse eid="ISA 31:6" /><verse number="7" style="v" sid="ISA 31:7" />Sia ke usen ado afịd ndufo eyaesịn mme ubobod abasi silfa ye kold u-ubọk idiọọkñkpọ ndufo enamma.<verse eid="ISA 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 31:8" />“Asiria idiiduọhọ ito eduad ubọk awo;</para>
  <para style="q2" vid="ISA 31:8">eduad a-mmiidooho ake ubọkawo ayaasobo ammọ.</para>
  <para style="q1" vid="ISA 31:8">Ammọ eyaeduọññọ ke afịd,</para>
  <para style="q2" vid="ISA 31:8">eyaenyʌñ ekoono ñkparawa ideen ammọ esịn ke utom ufiik.<verse eid="ISA 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 31:9" />Ibededem ammọ ayaaduọ ato ke ntak ndịk;</para>
  <para style="q2" vid="ISA 31:9">ke adikịt ndaha idiọọñọ ekọñ, mme adaiso ekọñ ammọ eyaekop ndịk,”</para>
  <para style="q1" vid="ISA 31:9">
    <char style="nd">Abọọñ</char> atañ,</para>
  <para style="q2" vid="ISA 31:9">i-ikañ amọ abaaha ke Saiyọn,</para>
  <para style="q2" vid="ISA 31:9">a-ñkpọdiọhọ ikañ amọ abaaha ke Yeruselem.<verse eid="ISA 31:9" /></para>
  <chapter eid="ISA 31" />
  <chapter number="32" style="c" sid="ISA 32" />
  <para style="s1">Abioubọọñ Adinenido</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 32:1" />Se, adidem ayaakara ke adinenido</para>
  <para style="q2" vid="ISA 32:1">mme mbọọñ ñko eyaekaara ke unen.<verse eid="ISA 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 32:2" />Ammọ keedekeed ediiba nte itie ukpeme mbaak afịm</para>
  <para style="q2" vid="ISA 32:2">ye itie a-awo adịbeke abọkkọ ayobio,</para>
  <para style="q1" vid="ISA 32:2">nte udịm mmọọñ ke akpautatan</para>
  <para style="q2" vid="ISA 32:2">ye ndukpọñ ekamba itiad ke isọñ nsaditọñ.<verse eid="ISA 32:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 32:3" />Ndin anyen mbon se ikịt anye idiikʌbọke aba,</para>
  <para style="q2" vid="ISA 32:3">ndin utọñ mbon ekoppo eyaekpañ utọñ.<verse eid="ISA 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 32:4" />Esịd ndịk ayaadiọọñọ anyʌñ abọ ifiọk,</para>
  <para style="q2" vid="ISA 32:4">edeme ekek ñko ayaanekke atañ ikọ anye adọnọ.<verse eid="ISA 32:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 32:5" />Awo idiibenne ndisịme aba ikoot awo eti iwuod,</para>
  <para style="q2" vid="ISA 32:5">awo idiinyʌññọ iben awo ndutịme ikoot awo ukpono.<verse eid="ISA 32:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 32:6" />Sia mme ntʌn etañ ikọ ndisịme-ndisịme,</para>
  <para style="q2" vid="ISA 32:6">esịd ammọ asʌk akere adinam idiọọk:</para>
  <para style="q1" vid="ISA 32:6">Ammọ ekpeep idiọọk ido,</para>
  <para style="q2" vid="ISA 32:6">enyʌñ esuan se imiidooho akpanikọ ebaña <char style="nd">Abọọñ</char>;</para>
  <para style="q1" vid="ISA 32:6">mbon abiọọñ ammọ eyaak idịb ukpọk,</para>
  <para style="q2" vid="ISA 32:6">mbon nsaditọñ ammọ esịn adinọ mmọọñ.<verse eid="ISA 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 32:7" />Mbon ndutịme ekama ibak-ibak usʌñ,</para>
  <para style="q2" vid="ISA 32:7">ammọ ekama ñkara usʌñ</para>
  <para style="q1" vid="ISA 32:7">ye nsu esobo mme uweene,</para>
  <para style="q2" vid="ISA 32:7">akpesʌkado aseeme mbon unana anenne.<verse eid="ISA 32:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 32:8" />Ado awo eti iwuod anam nti akikere,</para>
  <para style="q2" vid="ISA 32:8">ammọ enyʌñ eda enọ nti akikere.<verse eid="ISA 32:8" /></para>
  <para style="s1">Ibaan Yeruselem</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 32:9" />Ndufo ibaan unana akikere,</para>
  <para style="q2" vid="ISA 32:9">idakka ida inyʌñ ikpañ utọñ innọ miin;</para>
  <para style="q1" vid="ISA 32:9">ndufo nditọ ibaan e-ekereke ke eba ke ifuuro,</para>
  <para style="q2" vid="ISA 32:9">ikop se ami ñyem aditañ!<verse eid="ISA 32:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 32:10" />Ke etək-etək ini akanna isua keed</para>
  <para style="q2" vid="ISA 32:10">ndufo e-ebaaha ke ifuuro eyaekop ñnyeñidem;</para>
  <para style="q1" vid="ISA 32:10">idọk kreb ayaakpu</para>
  <para style="q2" vid="ISA 32:10">ñko idọk mfịd idiibaaha.<verse eid="ISA 32:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 32:11" />Inyeñ idem, ndufo ibaan e-ebaaha ke ndueidem;</para>
  <para style="q2" vid="ISA 32:11">yak ndịk inam ndufo, nditọ ibaan e-ekereke ke iba ke ifuuro!</para>
  <para style="q1" vid="ISA 32:11">Isịññe mme mfọọn afọñ ndufo</para>
  <para style="q2" vid="ISA 32:11">inyʌñ ikama ntaha afọñ ifʌk idem ndufo.<verse eid="ISA 32:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 32:12" />Imia eba ndufo ibaña nti inwañ,</para>
  <para style="q2" vid="ISA 32:12">ye mbunwịm fain,<verse eid="ISA 32:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 32:13" />amaado isọñ ikọd mmi,</para>
  <para style="q2" vid="ISA 32:13">isọñ i-ikpọ ñkukịm ye mbaraekpe efʌkkọ;</para>
  <para style="q1" vid="ISA 32:13">ke akpanikọ, itua ibaña afịd mme ufọk idaara</para>
  <para style="q2" vid="ISA 32:13">ye abio mbre ami.<verse eid="ISA 32:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 32:14" />Eyaefeeñe ekpọñ akpọsọñ abio,</para>
  <para style="q2" vid="ISA 32:14">abio akpọsọñ uyom ayaanaa ukpọk;</para>
  <para style="q1" vid="ISA 32:14">ikpọ ufọk ye anyọñukpeme eyaekappa edo mbiadaisọñ ke nsi-nsi,</para>
  <para style="q2" vid="ISA 32:14">ñkpọ idaara mme dọñki, itie uta mbid mme udịmedọñ,<verse eid="ISA 32:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 32:15" />tutu enwañña Sịbidịd eto anyọñ iduọk ñnyịn,</para>
  <para style="q2" vid="ISA 32:15">akpautatan akappa ado eti isọñ,</para>
  <para style="q2" vid="ISA 32:15">eti isọñ ñko anyʌñ atie nte akai.<verse eid="ISA 32:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 32:16" />Unenikpe <char style="nd">Abọọñ</char> ayaadʌñ ke akpautatan,</para>
  <para style="q2" vid="ISA 32:16">adinenido amọ ayaanyʌñ adʌñ ke eti isọñ.<verse eid="ISA 32:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 32:17" />Mfịd utom adinenido ado adiido emem;</para>
  <para style="q2" vid="ISA 32:17">utịb amọ adiido ifuuro ye unanandịk ke nsi-nsi.<verse eid="ISA 32:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 32:18" />Ikọd mmi eyaedʌñ ke mme ufọk emem,</para>
  <para style="q2" vid="ISA 32:18">ke mme ifuuro ufọk,</para>
  <para style="q2" vid="ISA 32:18">ke mme itie nduọkadudu amfịna imiibaaha.<verse eid="ISA 32:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 32:19" />Akpesʌkado akpọsọñ edịmitiad anịmme akai anaan,</para>
  <para style="q2" vid="ISA 32:19">abio ñko anyʌñ anaa ukpọk afịd-afịd,<verse eid="ISA 32:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 32:20" />die ke ndufo ediibọ adidiọñ,</para>
  <para style="q2" vid="ISA 32:20">ke aditọ mfịd ke afịd mben idịm,</para>
  <para style="q2" vid="ISA 32:20">adinyʌñ nsaana mme enañ ye dọñki ndufo ñyaak esaña naña emama.<verse eid="ISA 32:20" /></para>
  <chapter eid="ISA 32" />
  <chapter number="33" style="c" sid="ISA 33" />
  <para style="s1">Mfʌhọ ye Unwam</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 33:1" />Adọdiọọk unọ fiin, awo nsobo,</para>
  <para style="q2" vid="ISA 33:1">afo a-awo imiisoboke!</para>
  <para style="q1" vid="ISA 33:1">Adọdiọọk unọ fiin, atabawo,</para>
  <para style="q2" vid="ISA 33:1">afo a-awo imiitappa!</para>
  <para style="q1" vid="ISA 33:1">Afo umautre adisobo,</para>
  <para style="q2" vid="ISA 33:1">eyausobo fiin;</para>
  <para style="q1" vid="ISA 33:1">afo umautre aditap,</para>
  <para style="q2" vid="ISA 33:1">eyautap fiin.<verse eid="ISA 33:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ISA 33:2" />
    <char style="nd">Abọọñ</char>, nie mbọm ibaña ñnyịn;</para>
  <para style="q2" vid="ISA 33:2">ñnyịn imuyem fiin.</para>
  <para style="q1" vid="ISA 33:2">Do adudu ñnyịn afịd ubakusen,</para>
  <para style="q2" vid="ISA 33:2">adinyaaña ñnyịn ke ini afanekọñ.<verse eid="ISA 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 33:3" />Ke uyom mbonekọñ mfo mbon awo efeeñe;</para>
  <para style="q2" vid="ISA 33:3">afo umaudakka ke anyọñ, mme idịd esuana.<verse eid="ISA 33:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 33:4" />Mbịme ndufo, O mme idịd, e-edọkkọ nte mme nsek ñkukuñkpọyọriyọ edọk;</para>
  <para style="q2" vid="ISA 33:4">mme awo etama efʌk anye nte udịm ñkukuñkpọyọriyọ.<verse eid="ISA 33:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 33:5" />Ubọọñ anie <char style="nd">Abọọñ</char>, sia anye adʌñ ke anyọñ;</para>
  <para style="q2" vid="ISA 33:5">anye ayaayọhọ Saiyọn ye unen ye adinenido.<verse eid="ISA 33:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 33:6" />Anye ayaado nsọọñọnda itiad idakisọñ inọ ndufo ke afịd ayio,</para>
  <para style="q2" vid="ISA 33:6">imọ ufọk adinyaaña ye aniọñ ye ifiọk;</para>
  <para style="q2" vid="ISA 33:6">uteeñe <char style="nd">Abọọñ</char> ado ñyịn ukpọhọde ñkpọuto<note caller="+" style="f"><char style="fr" closed="false">33:6 </char><char style="ft" closed="false">Akeme ido </char><char style="fq" closed="false">ado </char><char style="fqa" closed="false">ñkpọuto a-atooho anye</char></note> ami.<verse eid="ISA 33:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 33:7" />Se, mme akop idem ideen ammọ etua ke akpọsọñ uyio ke mme efaak;</para>
  <para style="q2" vid="ISA 33:7">mme isʌñutom emem etua idod-idod ayịd.<verse eid="ISA 33:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 33:8" />Mme akpọusʌñ enaa ukpọk,</para>
  <para style="q2" vid="ISA 33:8">mme akaisañ ndomokeed ibaaha ke mme usʌñ.</para>
  <para style="q1" vid="ISA 33:8">E-ebiat edioomo efep,</para>
  <para style="q2" vid="ISA 33:8">enyʌñ esịn mme ntiense amọ ke ndek,</para>
  <para style="q2" vid="ISA 33:8">awo ikponoke awo ndomokeed aba.<verse eid="ISA 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 33:9" />Isọñ a-asat amaanyʌñ abiara ama,</para>
  <para style="q2" vid="ISA 33:9">Lebanọn a-akop abuud anyʌñ ayeeme;</para>
  <para style="q1" vid="ISA 33:9">Sarọn aba nte Araba,</para>
  <para style="q2" vid="ISA 33:9">mme mfañ Basan ye Kamel eduọññọ.<verse eid="ISA 33:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 33:10" />“Idahami ami ñyaadakka ke anyọñ,” <char style="nd">Abọọñ</char> atañ.</para>
  <para style="q2" vid="ISA 33:10">“Idahami ñyaadakka nda;</para>
  <para style="q2" vid="ISA 33:10">idahami ke edindịppe miin ke anyọñ.<verse eid="ISA 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 33:11" />Afo ayommo mbio abakpa,</para>
  <para style="q2" vid="ISA 33:11">anyʌñ aman akpọ ñnyanyaha;</para>
  <para style="q2" vid="ISA 33:11">ibifịk mfo ado ikañ u-usoboke fiin.<verse eid="ISA 33:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 33:12" />Eyaefọp mbon awo tutu ammọ ekappa ntọñ;</para>
  <para style="q2" vid="ISA 33:12">nte ikọd ñkukịm e-etemme eyaefọp ammọ.”<verse eid="ISA 33:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ISA 33:13" />Afo a-abaaha ke anyan usʌñ, ikop se ami nnam;</para>
  <para style="q2" vid="ISA 33:13">afo a-abaaha ñkped-ñkped, inyịmme adudu mmi!<verse eid="ISA 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 33:14" />Mme anam idiọọkñkpọ ke Saiyọn e-ekop akpọsọñ ndịk;</para>
  <para style="q2" vid="ISA 33:14">ñnyeñidem anam mbon i-imiibaaha Abasi:</para>
  <para style="q1" vid="ISA 33:14">“Anie ke atu ñnyịn ikeme adidʌñ ye ikañ nsobo?</para>
  <para style="q2" vid="ISA 33:14">Anie ke atu ñnyịn ikeme adidʌñ ye nsi-nsi ikañ?”<verse eid="ISA 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 33:15" />Mbon e-esañake ke adinenido</para>
  <para style="q2" vid="ISA 33:15">enyʌñ etañ se inen,</para>
  <para style="q1" vid="ISA 33:15">e-esịnne udod a-atooho ñkanubọk</para>
  <para style="q2" vid="ISA 33:15">enyʌñ ekpan ubọk ammọ adibọ ubọkedem,</para>
  <para style="q1" vid="ISA 33:15">enyʌñ esiit utọñ ammọ adikop edioomo uwot awo</para>
  <para style="q2" vid="ISA 33:15">enyʌñ ebọọp anyen ammọ ekpọñ adikere idiọọk;<verse eid="ISA 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 33:16" />ammọ edo mbon se idiidʌñ ke mme anyọñ abod,</para>
  <para style="q2" vid="ISA 33:16">itie udịbe ammọ adiido ke akpọsọñ itie anyọñ abod.</para>
  <para style="q1" vid="ISA 33:16">Eyaenọ ammọ uyo,</para>
  <para style="q2" vid="ISA 33:16">mmọọñ idiinyʌññọ inana ammọ.<verse eid="ISA 33:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ISA 33:17" />Anyen mfo ayaakịt adidem ke mmọnyọ amọ</para>
  <para style="q2" vid="ISA 33:17">anyʌñ akịt idʌñ a-atarake anyʌñ akpon eti-eti.<verse eid="ISA 33:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 33:18" />Ke akikere mfo afo ayaakere abaña mme ndịk usen edem:</para>
  <para style="q2" vid="ISA 33:18">“Mmọ anye ekamba adaaha ado?</para>
  <para style="q1" vid="ISA 33:18">Mmọ awo akesibọọhọ utomo?</para>
  <para style="q2" vid="ISA 33:18">Mmọ adaaha a-aseeghe ñkpọ abaña mme tọwa?”<verse eid="ISA 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 33:19" />Afo uduukịtte mbon ñkokkoidem ado aba,</para>
  <para style="q2" vid="ISA 33:19">mbon u-umuudiọọñọke edeme ikọ ammọ,</para>
  <para style="q2" vid="ISA 33:19">ake usem ammọ adooho asen ndin inwañake awo.<verse eid="ISA 33:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 33:20" />Se Saiyọn, abio mme usọrọ ñnyịn;</para>
  <para style="q2" vid="ISA 33:20">anyen mfo ayaakịt Yeruselem,</para>
  <para style="q2" vid="ISA 33:20">itie idʌñ emem, atayad a-awo imiiduakka iben mfep;</para>
  <para style="q1" vid="ISA 33:20">mboi amọ ayaasọọñọ ada kwak,</para>
  <para style="q2" vid="ISA 33:20">udʌk amọ ndomokeed idiikpịkkeke.<verse eid="ISA 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 33:21" />Do <char style="nd">Abọọñ</char> adiido Akpọsọñ inọ ñnyịn.</para>
  <para style="q2" vid="ISA 33:21">Anye adiiba nte itie ikpọ inyañ ye mme idịm.</para>
  <para style="q1" vid="ISA 33:21">Ubom e-ekamake udeñ ewat idiiboiyoke ke esịd,</para>
  <para style="q2" vid="ISA 33:21">ikpọ nsʌñikañ ñko idiiboiyoke do.<verse eid="ISA 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 33:22" />Sia <char style="nd">Abọọñ</char> ado abiideikpe ñnyịn,</para>
  <para style="q2" vid="ISA 33:22">
    <char style="nd">Abọọñ</char> ado andinọọ ñnyịn mbed,</para>
  <para style="q1" vid="ISA 33:22">
    <char style="nd">Abọọñ</char> ado adidem ñnyịn;</para>
  <para style="q2" vid="ISA 33:22">anye ado andidiinyaaña ñnyịn.<verse eid="ISA 33:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="ISA 33:23" />Udʌk mfo atara:</para>
  <para style="q2" vid="ISA 33:23">Inyʌññọ itịm imʌm eto adaaha yak afọn,</para>
  <para style="q2" vid="ISA 33:23">awo inyʌññọ itat afọñ itakubom.</para>
  <para style="q1" vid="ISA 33:23">Ndin eyaedemme uwak mbịme</para>
  <para style="q2" vid="ISA 33:23">mme mbʌñọ ñko eyaekoono mbịme.<verse eid="ISA 33:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 33:24" />Awo ndomokeed a-adʌññọ ke Saiyọn idiibooho, “Idem insọññọ miin”;</para>
  <para style="q2" vid="ISA 33:24">eyaenyʌñ efeen mme idiọọkñkpọ mbon se idʌññọ do.<verse eid="ISA 33:24" /></para>
  <chapter eid="ISA 33" />
  <chapter number="34" style="c" sid="ISA 34" />
  <para style="s1">Ubiideikpe A-anieghe mme Idịd</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 34:1" />Isịkke idi, ndufo mme idịd, inyʌñ ikpañ utọñ;</para>
  <para style="q2" vid="ISA 34:1">inekke itịñ anyen, ndufo mme idịd!</para>
  <para style="q1" vid="ISA 34:1">Yak isọñ akop, ye afịd se idọñọ ke esịd,</para>
  <para style="q2" vid="ISA 34:1">ederimbod, ye afịd se ito esịd iwuọ!<verse eid="ISA 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 34:2" />
    <char style="nd">Abọọñ</char> a-ayat esịd ye afịd mme idịd;</para>
  <para style="q2" vid="ISA 34:2">iyadesịd amọ adoro afịd mbonekọñ ammọ ke idem.</para>
  <para style="q1" vid="ISA 34:2">Anye ayaasobo ammọ ataa afịd-afịd,</para>
  <para style="q2" vid="ISA 34:2">anye ayaayaak ammọ anọ yak ewoot.<verse eid="ISA 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 34:3" />Eyaetop mbon ñkpañña ammọ eduọọk,</para>
  <para style="q2" vid="ISA 34:3">mme akpo ammọ eyaetebe;</para>
  <para style="q2" vid="ISA 34:3">iyiib ammọ ayaaduọkkọ ayọhọ mme ikpọabod.<verse eid="ISA 34:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 34:4" />Afịd mme ntantaafiọñ ke ikpaanyọñ eyaeyeeme</para>
  <para style="q2" vid="ISA 34:4">enyʌñ efʌd mme hefịn nte ikpañwed;</para>
  <para style="q1" vid="ISA 34:4">afịd mme aniendịk udịm anyọñ eyaeduọ</para>
  <para style="q2" vid="ISA 34:4">nte ñyeeme mfañ fain eduọññọ,</para>
  <para style="q2" vid="ISA 34:4">nte nsaad mfịd fik eduọññọ ekpọñ eto fik.<verse eid="ISA 34:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 34:5" />Eduad mmi anwọñ ayʌkkọ ke mme hefịn;</para>
  <para style="q2" vid="ISA 34:5">se, anye asọiyọ ke ikpe abaña Edọm,</para>
  <para style="q2" vid="ISA 34:5">mbon a-ami nsoboke afịd-afịd.<verse eid="ISA 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 34:6" />Eduad <char style="nd">Abọọñ</char> ayọhọ ye iyiib,</para>
  <para style="q2" vid="ISA 34:6">efʌk anye ke akpọñ;</para>
  <para style="q1" vid="ISA 34:6">iyiib mme edọñ ye mme ebod,</para>
  <para style="q2" vid="ISA 34:6">akpọñ a-atooho ekpuud mme akukịmedọñ.</para>
  <para style="q1" vid="ISA 34:6">Sia <char style="nd">Abọọñ</char> anie uwa ke Bosra</para>
  <para style="q2" vid="ISA 34:6">ye ekamba uwa ke isọñ Edọm.<verse eid="ISA 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 34:7" />Ndin mme abaakenañ utominwañ ñko eyaeduọ ye ammọ,</para>
  <para style="q2" vid="ISA 34:7">mme ñyịn enañ ye ñyaaraenañ.</para>
  <para style="q1" vid="ISA 34:7">Isọñ ammọ adiifiọọrọ ye iyiib,</para>
  <para style="q2" vid="ISA 34:7">ndin abu adiidʌppọ ye akpọñ.<verse eid="ISA 34:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 34:8" />Sia <char style="nd">Abọọñ</char> anie usen usiene,</para>
  <para style="q2" vid="ISA 34:8">isua utịb, abaña ndubeghe Saiyọn.<verse eid="ISA 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 34:9" />Mme idịm Edọm eyaekappa itai,</para>
  <para style="q2" vid="ISA 34:9">abu ammọ nte ikañ sọlfọ;</para>
  <para style="q2" vid="ISA 34:9">isọñ amọ ayaaba nte ufiob itai!<verse eid="ISA 34:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 34:10" />Anye idiinịmeke akonayio ye uweemeayio;</para>
  <para style="q2" vid="ISA 34:10">nsʌñikañ amọ ayaadakka ke anyọñ ke nsi-nsi.</para>
  <para style="q1" vid="ISA 34:10">Anye ayaanaa ke nsobo tọọñọ ke emana tutu emana;</para>
  <para style="q2" vid="ISA 34:10">awo ndomokeed idiisañake do aba iboiyo.<verse eid="ISA 34:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 34:11" />Ñkịdikịd akpautatan ye abọñ ñkpo ñkịdikịd eyaeben anye enie;</para>
  <para style="q2" vid="ISA 34:11">ekamba ñkịdikịd ye ekọọñebʌkayob eyaebọp efọk do.</para>
  <para style="q1" vid="ISA 34:11">Abasi ayaanyan ubọk amọ abaña Edọm,</para>
  <para style="q2" vid="ISA 34:11">idʌk udomoñkpọ ndutịme</para>
  <para style="q2" vid="ISA 34:11">ye ikpọ udʌk mfʌhọ.<verse eid="ISA 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 34:12" />Mme mbọọñ amọ idiinieghe ñkpọ ndomokeed se ekoot abioubọọñ,</para>
  <para style="q2" vid="ISA 34:12">afịd nditọ ideen adidem eyaesoomo.<verse eid="ISA 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 34:13" />Ñkukịm eyaekọt efʌk mme ikpọ ufọk amọ,</para>
  <para style="q2" vid="ISA 34:13">akpab ye mbaraekpe eyaefʌk mme ñkpọsọñ itie amọ.</para>
  <para style="q1" vid="ISA 34:13">Anye ayaaba nte itieidʌñ anọ mme ewaikọd,</para>
  <para style="q2" vid="ISA 34:13">ado ufọkidʌñ anọ mme ñkịdikịd.<verse eid="ISA 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 34:14" />Mme unam akpautatan eyaesoobo ye mme haiyena,</para>
  <para style="q2" vid="ISA 34:14">mme ebod ikọd eyaemai enọ emọ-emọ;</para>
  <para style="q1" vid="ISA 34:14">do ñko ke mme unam akonayio ediina</para>
  <para style="q2" vid="ISA 34:14">enyʌñ ekịt ndo nte itie nduọkadudu enọ idem ammọ.<verse eid="ISA 34:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 34:15" />Ñkịdikịd ayaabọp efọk adʌñ anyʌñ adọñ ñkwa,</para>
  <para style="q2" vid="ISA 34:15">anye ayaaboot ammọ, anyʌñ abọọk nditọ amọ</para>
  <para style="q2" vid="ISA 34:15">ke idak ndukpọñ mba amọ;</para>
  <para style="q1" vid="ISA 34:15">do ñko ke mme uman ntrukpuum ediiboho,</para>
  <para style="q2" vid="ISA 34:15">ye mme akpoñka ammọ.<verse eid="ISA 34:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 34:16" />Se ke ñwed <char style="nd">Abọọñ</char> nyʌñ koot:</para>
  <para style="q1" vid="ISA 34:16">ndomokeed ke atu ami idiisoppo,</para>
  <para style="q2" vid="ISA 34:16">ibaaha ndomokeed se idiiduakka inie akpoñka amọ.</para>
  <para style="q1" vid="ISA 34:16">Sia ado inua amọ anọ ewʌhọ ami,</para>
  <para style="q2" vid="ISA 34:16">Sịbidịd amọ ñko ayaakoono afịd ammọ abok itie keed.<verse eid="ISA 34:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 34:17" />Anye abakka mme isọñ anọ ammọ;</para>
  <para style="q2" vid="ISA 34:17">ubọk amọ adeeme ammọ akeene udomo.</para>
  <para style="q1" vid="ISA 34:17">Ammọ eyaedat anye enie ke nsi-nsi</para>
  <para style="q2" vid="ISA 34:17">enyʌñ edʌñ do ke emana ye emana.<verse eid="ISA 34:17" /></para>
  <chapter eid="ISA 34" />
  <chapter number="35" style="c" sid="ISA 35" />
  <para style="s1">Idaara Mbon Enyaañake</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 35:1" />Akpautatan ye nsaad isọñ eyaedaara;</para>
  <para style="q2" vid="ISA 35:1">anaan ayaadaara anyʌñ asịññe ñkpokpoñ.</para>
  <para style="q1" vid="ISA 35:1">Nte krokus, <verse eid="ISA 35:1" /><verse number="2" style="v" sid="ISA 35:2" />anye ayaasaiya anyʌñ atara;</para>
  <para style="q2" vid="ISA 35:2">anye ayaadaara akpọsọñ anyʌñ abọñ ñkpo idaara.</para>
  <para style="q1" vid="ISA 35:2">Eyaenọ anye ubọọñ Lebanọn,</para>
  <para style="q2" vid="ISA 35:2">mmọnyọ Kamel ye Sarọn;</para>
  <para style="q1" vid="ISA 35:2">ammọ eyaekịt ubọọñ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 35:2">mmọnyọ Abasi ñnyịn.<verse eid="ISA 35:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 35:3" />Sọọñọ mme ubọk amemme,</para>
  <para style="q2" vid="ISA 35:3">nekke daaha mme akpọ eyemme edifemme;<verse eid="ISA 35:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 35:4" />bo mbon esịd ndịk,</para>
  <para style="q2" vid="ISA 35:4">“Isọñ idem, ikiifeghe ndịk;</para>
  <para style="q1" vid="ISA 35:4">Abasi ndufo ayaadi,</para>
  <para style="q2" vid="ISA 35:4">anye ayaadi ye usiene;</para>
  <para style="q1" vid="ISA 35:4">ye adisana utịb,</para>
  <para style="q2" vid="ISA 35:4">anye ayaadi aduunyaaña fiin.”<verse eid="ISA 35:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 35:5" />Ini ado ke anyen nnan adiitara,</para>
  <para style="q2" vid="ISA 35:5">utọñ inan anyʌñ asịtte.<verse eid="ISA 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 35:6" />Ntoro ke mbʌñọ adiitamma nte edob,</para>
  <para style="q2" vid="ISA 35:6">edeme imuum ayaabọñ ñkpo idaara.</para>
  <para style="q1" vid="ISA 35:6">Mmọọñ ayaawuọ ato anaan,</para>
  <para style="q2" vid="ISA 35:6">mme idịm ñko ke akpautatan.<verse eid="ISA 35:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 35:7" />Ufiob ntan ayaakappa ñkpọdiọhọ mmọọñ,</para>
  <para style="q2" vid="ISA 35:7">isọñ nsaditọñ ayaakappa ado itie se mmọọñ atop awuọ.</para>
  <para style="q1" vid="ISA 35:7">Ke itie ewaikọd akesinaaha,</para>
  <para style="q2" vid="ISA 35:7">mbid ye ñnyanyaha ye papirus eyaekọt.<verse eid="ISA 35:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 35:8" />Ndin akpọusʌñ ayaaba do;</para>
  <para style="q2" vid="ISA 35:8">ediikoot anye Adisana Usʌñ;</para>
  <para style="q2" vid="ISA 35:8">anye ayaanyʌñ ado ntoro anọ mbon e-esañake ke Usʌñ ado.</para>
  <para style="q1" vid="ISA 35:8">Mbon i-imiisanake idiisañake do iboiyo;</para>
  <para style="q2" vid="ISA 35:8">mme ibak ndisịme idiinyʌññọ isaña do.<verse eid="ISA 35:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 35:9" />Ekpe ndomokeed idiibaaha do,</para>
  <para style="q2" vid="ISA 35:9">me unam ndomokeed a-ataaha awo;</para>
  <para style="q2" vid="ISA 35:9">ammọ ndomokeed idiibaaha do.</para>
  <para style="q1" vid="ISA 35:9">Ado mbon efakka ikpọọñ ediisaña do,<verse eid="ISA 35:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="ISA 35:10" />ndin mbon se <char style="nd">Abọọñ</char> afak eyaetịmme enyọñ edi.</para>
  <para style="q1" vid="ISA 35:10">Ammọ eyaedʌk Saiyọn ye ikwọ;</para>
  <para style="q2" vid="ISA 35:10">nsi-nsi idaara adiido anyanya ke iwuod ammọ.</para>
  <para style="q1" vid="ISA 35:10">Inemesịd ye idaara eyaeboiyo ammọ iso,</para>
  <para style="q2" vid="ISA 35:10">ndin mfʌhọ ye nsiama eyaefeeñe ekaa anyan.<verse eid="ISA 35:10" /></para>
  <chapter eid="ISA 35" />
  <chapter number="36" style="c" sid="ISA 36" />
  <para style="s1">Senakerib Akaa Ikọ ye Yeruselem</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 36:1" />Ke ayọhọ isua duob mme inaañ ke ukara Adidem Hesikaiya, Senakerib adidem Asiria amaakaa ekọñ ye afịd mme ñkpọsọñ abio Yuda anyʌñ akoono ammọ adat anie. <verse eid="ISA 36:1" /><verse number="2" style="v" sid="ISA 36:2" />Akem adidem Asiria amaadọñ adaiso ekọñ amọ asaña ye uwak udịmekọñ eto Lakis ebịne Adidem Hesikaiya ke Yeruselem. Ke ini adaiso ekọñ aketuakka ada ke mben Ñkpọdiọhọ Mmọọñ Anyọñ, ke usʌñ a-akaaha Inwañ Ayedafọñ, <verse eid="ISA 36:2" /><verse number="3" style="v" sid="ISA 36:3" />Eliakịm ayịn Hilkia aseñkpọ mbaña ufọkadidem, Sebna awedñwed, ye Yoa ayịn Asaf awedmbʌk ñkpọntịppe abio emaewuọñọ ekesoobo anye.<verse eid="ISA 36:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 36:4" />Ekamba adaiso ekọñ amaabo ammọ, “Idọkkọ Hesikaiya:</para>
  <para style="pm" vid="ISA 36:4">“ ‘Ntom ke ekamba adidem, kpa adidem Asiria, abo: Uko mfo ami asọọñọ ada ke nsoo? <verse eid="ISA 36:4" /><verse number="5" style="v" sid="ISA 36:5" />Afo abo ke iminie item inyʌñ inie adudu inọ ekọñ, ado afo atañ uyaha ikọ. Anie awo ke afo adot anyen, yak afo asọñ iwuod ye ami? <verse eid="ISA 36:5" /><verse number="6" style="v" sid="ISA 36:6" />Se, ami mmediọọñọ ke afo abet idem ke Iyib, nsakka ubaak ñnyanyaha ado, a-akịmme ubọk awo keed akeedodo a-abereke ke anye. Kpa ntoro ke Fero adidem Iyib aba ye afịd mbon e-enieghe idodanyen ke anye. <verse eid="ISA 36:6" /><verse number="7" style="v" sid="ISA 36:7" />Ado adieke afo ambooho miin, “Ñnyịn inie idodanyen ke <char style="nd">Abọọñ</char> Abasi ñnyịn,” nte idooho anye ke Hesikaiya akesioño mme ñkoñ-ñkoñ itie ye mme akpokoro uwa amọ, ndin abo Yuda ye Yeruselem, “Ana ndufo etuak iwuod ke iso akpokoro uwa ami”?<verse eid="ISA 36:7" /></para>
  <para style="pm">
    <verse number="8" style="v" sid="ISA 36:8" />“ ‘Di ndin, dʌk edioomo unyịmme ye eteufọk mmi, adidem Asiria: ami ñyaunọ fiin enañmbakara tọsịn iba (2,000), adieke afo akanna anie mme andiwad ammọ! <verse eid="ISA 36:8" /><verse number="9" style="v" sid="ISA 36:9" />Die ndin ke afo akan akaa ikọ ye andisịb ñkan ke atu mme adaaha eteufọk mmi, akpesʌkado afo adotto anyen ke mme sariọd ye mme awad enañmbakara<note caller="+" style="f"><char style="fr" closed="false">36:9 </char><char style="ft" closed="false">Akeme ido </char><char style="fqa" closed="false">mme awad sariọd</char></note> Iyib? <verse eid="ISA 36:9" /><verse number="10" style="v" sid="ISA 36:10" />Ke aboiyoke ado, nte ami mmedi adinwana ekọñ ñnyʌñ nsobo isọñ ami ke <char style="nd">Abọọñ</char> imiiyịmmeke? <char style="nd">Abọọñ</char> ke idem amọ akendọkkọ miin ate yak ndọọk ñka anwan ye idịd ami ñnyʌñ nsobo anye.’ ”<verse eid="ISA 36:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 36:11" />Ndin Eliakịm, Sebna ye Yoa emaedọkkọ adaiso ekọñ ete, “Mbọk tañ ikọ nọ nditọufọk mfo ke usem Aram, sia ñnyịn imikop usem ado. Kuutañ ikọ ye ñnyịn ke usem Hibru mbaak afịd mbon se idoro ke ndibene abio edikop.”<verse eid="ISA 36:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 36:12" />Ado adaiso ekọñ amaabọọrọ ate, “Ado nte eteufọk mmi akendọñ miin ate ndudọkkọ fiin ye eteufọk mfo ikpọñ mme ñkpọ ami, ke ntañ nnọọ mbon e-edoroke ke ndibene abio, a-adooho ammọ ye ndufo, eyaedia uduañ ndufo enyʌñ enwọñ ikịm ndufo?”<verse eid="ISA 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 36:13" />Ndin adaiso ekọñ amaadakka ada anyʌñ adịppe uyio atañ ke usem Hibru, “Ikop mme ikọ ekamba adidem, kpa adidem Asiria! <verse eid="ISA 36:13" /><verse number="14" style="v" sid="ISA 36:14" />Ntom ke adidem abo: Ikiiyak Hesikaiya ibiaña ndufo. Anye idiikanna ifak ndufo! <verse eid="ISA 36:14" /><verse number="15" style="v" sid="ISA 36:15" />Ikiiyak Hesikaiya ikpak ndufo nọ ebuọt idem ke <char style="nd">Abọọñ</char>, anye amaabo, ‘Ke akpanikọ <char style="nd">Abọọñ</char> ayaifak ñnyịn; abio ami idiiduọhọ idʌk ubọk adidem Asiria.’<verse eid="ISA 36:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 36:16" />“Ikiikpañ utọñ inọọ Hesikaiya. Se adidem Asiria atañ ado ami: Inam emem ye ami inyʌñ idi imbịne miin. Ndin ndufo keedekeed eyaedia mfịd eto fain ndufo ye eto fik ndufo enyʌñ enwọñ mmọọñ eto ube mmọọñ ndufo, <verse eid="ISA 36:16" /><verse number="17" style="v" sid="ISA 36:17" />tutu ami ndi ndiben ndufo ñkaa isọñ a-abaaha nte ake ndufo: isọñ abakpa ye ufa ukọd, isọñ uyo ye mme inwañ fain.<verse eid="ISA 36:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 36:18" />“Ikiiyak Hesikaiya itịn ndufo usʌñ ke anye amaabo, ‘<char style="nd">Abọọñ</char> ayainyaaña ñnyịn.’ Akenaanam aba naña mme abasi idịd mfen enyaaña mme isọñ ammọ esio ke ubọk adidem Asiria? <verse eid="ISA 36:18" /><verse number="19" style="v" sid="ISA 36:19" />Mmọ mme abasi Hamad ye Apad? Mmọ mme abasi Sefafaim? Ammọ enyaaña Sameria esio ke ubọk mmi? <verse eid="ISA 36:19" /><verse number="20" style="v" sid="ISA 36:20" />Anie ke atu mme abasi mme idịd ami akeme adinyaaña mme isọñ ammọ nsio ke ubọk mmi? Ke die ndin ke <char style="nd">Abọọñ</char> akeme adinyaaña Yeruselem nsio ke ubọk mmi?”<verse eid="ISA 36:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 36:21" />Ado mbon awo emaeba ke ndobuyio inyʌññọ itañ ikọ ndomokeed ke ibọọrọ, sia adidem amaanọ ewʌhọ ate, “Ikiibọọrọ anye.”<verse eid="ISA 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 36:22" />Akem Eliakịm ayịn Hilkia aseñkpọ mbaña ufọkadidem, Sebna awedñwed, ye Yoa ayịn Asaf, akamañwed ñkpọntịppe ke abio, emaebịne Hesikaiya, ye ñwaiya afọñ ke idem, enyʌñ ekedọkkọ anye se adaiso ekọñ aketañ.<verse eid="ISA 36:22" /></para>
  <chapter eid="ISA 36" />
  <chapter number="37" style="c" sid="ISA 37" />
  <para style="s1">Ñkukịd A-abañake Adinyaaña Yeruselem</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 37:1" />Ke ini Adidem Hesikaiya akekoppo ikọ ami, anye amaawai afọñ amọ anyʌñ asịne afọñikpo akaa akedʌk tembịd <char style="nd">Abọọñ</char>. <verse eid="ISA 37:1" /><verse number="2" style="v" sid="ISA 37:2" />Anye amaadọñ Eliakịm aseñkpọ mbaña ufọkadidem, Sebna awedñwed ye mme adaiso ke atu mme aku, afịd ammọ esiine afọñikpo, ate eka ebịne prọfed Aisaiya ayịn Emọs. <verse eid="ISA 37:2" /><verse number="3" style="v" sid="ISA 37:3" />Ammọ emaedọkkọ anye, “Kop se Hesikaiya atañ mi: Mfịn ami ado usen mfʌhọ ye ntʌnọ ye asuenne, kpa naña mme nsekayịn eyem edimana ke ini uman ado inweek ibaaha se mme eka eman ammọ. <verse eid="ISA 37:3" /><verse number="4" style="v" sid="ISA 37:4" />Akeme adido <char style="nd">Abọọñ</char> Abasi mfo ayaakop ikọ adaiso ekọñ, e-eteufọk amọ, adidem Asiria, adọññọ yak adimiom aduuwem Abasi, ndin anye ayaaduat anye akeene ikọ se <char style="nd">Abọọñ</char> Abasi mfo akop. Ke ntoro bọñ akam nọ mbon se iyọhọ isʌhọ.”<verse eid="ISA 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 37:5" />Idaha a-mme adaaha adidem Hesikaiya ekedisooboke ye Aisaiya, <verse eid="ISA 37:5" /><verse number="6" style="v" sid="ISA 37:6" />Aisaiya amaabo ammọ, “Idọkkọ eteufọk ndufo, ‘Kop se <char style="nd">Abọọñ</char> atañ mi: Kuukop ndịk ubaña se afo akop, mme ikọ a-mme nditọufọk adidem Asiria ebenne emmiom miin. <verse eid="ISA 37:6" /><verse number="7" style="v" sid="ISA 37:7" />Kpañ utọñ! Ayaaba etob keed a-adooho anye amaakop, anye ayem aditịmme ñnyọñ abio amọ, do ke ami ndiinam nọ ewot anye ke akañkañ.’ ”<verse eid="ISA 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 37:8" />Ke adaiso ekọñ akekoppo ke adidem Asiria amaakpọñ Lakis, anye amaatịmme edem ndin amaadikịt naña anye anwana ye Libna.<verse eid="ISA 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 37:9" />Ndin Senakerib amaabọ etob ke Taihaka, adidem Kuus, asʌk asaña adi adinwana ekọñ ye anye. Ke anye amaakekop ami, anye amaadọñ mme isʌñutom anọ Hesikaiya ye ikọ ami: <verse eid="ISA 37:9" /><verse number="10" style="v" sid="ISA 37:10" />“Dọkkọ Hesikaiya adidem Yuda: Kuuyak abasi ake afo abuọttọ idem ubiaña fiin ke ini anye abooho, ‘Awo idiiyaaha Yeruselem isịn ke ubọk adidem Asiria.’ <verse eid="ISA 37:10" /><verse number="11" style="v" sid="ISA 37:11" />Ke akpanikọ afo amekop se mme ndidem Asiria enam afịd mme idịd, ke adisobo ammọ ataa afịd-afịd. Ndin eyaunyaaña fiin? <verse eid="ISA 37:11" /><verse number="12" style="v" sid="ISA 37:12" />Nte mme abasi mme idịd ado a-mbon se ikimbem miin iso ikara Asiria ekesoboke emaenyaaña ammọ, mme abasi Kosan, Haran, Resef ye mbon Idịn e-ekebaaha ke Tel Asaa? <verse eid="ISA 37:12" /><verse number="13" style="v" sid="ISA 37:13" />Mmọ adidem Hamad me adidem Apad? Mmọ ndidem abio Laiye, Sefafaim, Hena ye Iffa?”<verse eid="ISA 37:13" /></para>
  <para style="s1">Akam Hesikaiya</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 37:14" />Hesikaiya amaabọ mme isʌñutom ñwedetob anyʌñ akoot. Ndin anye amaadọọk akaa tembịd <char style="nd">Abọọñ</char> anyʌñ aketat anye anịm ke iso <char style="nd">Abọọñ</char>. <verse eid="ISA 37:14" /><verse number="15" style="v" sid="ISA 37:15" />Ndin Hesikaiya amaabọñ akam anọ <char style="nd">Abọọñ</char>: <verse eid="ISA 37:15" /><verse number="16" style="v" sid="ISA 37:16" /><char style="nd">Abọọñ</char> Andikponñkan, Abasi Isrel, a-atieghe ke ufọọd serubim, afo ikpọọñ ado Abasi ke afịd mme abioubọọñ ke ederimbod. Afo anam anyọñ ye isọñ. <verse eid="ISA 37:16" /><verse number="17" style="v" sid="ISA 37:17" />Kpañ utọñ, <char style="nd">Abọọñ</char>; nyʌñ kop; tat anyen mfo, <char style="nd">Abọọñ</char>, nyʌñ kịt; kop afịd mme ikọ se Senakerib adọñ nọ esịn anyịñ Aduuwem Abasi ke ndek.<verse eid="ISA 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 37:18" />“Abọọñ, ado akpanikọ ke ndidem Asiria esobo mbon awo ami ye mme isọñ ammọ. <verse eid="ISA 37:18" /><verse number="19" style="v" sid="ISA 37:19" />Ammọ etoomo mme abasi ammọ edọñ ke ikañ enyʌñ esobo ammọ, sia ammọ ikidooho mme abasi ado edo eto ye itiad, se ubọk awo anam. <verse eid="ISA 37:19" /><verse number="20" style="v" sid="ISA 37:20" />Idahami, <char style="nd">Abọọñ</char> Abasi ñnyịn, fak ñnyịn sio ke ubọk amọ, nọ afịd mme idịd ediọọñọ ke afo ikpọọñ, <char style="nd">Abọọñ</char>, ado Abasi.”<verse eid="ISA 37:20" /></para>
  <para style="s1">Iduọ Senakerib</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 37:21" />Ndin Aisaiya ayịn Emọs amaanọ etob esọk Hesikaiya: Ntom ke <char style="nd">Abọọñ</char>, Abasi Isrel, abo: Sia afo umaubọñ akam unnọ miin ubaña Senakerib adidem Asiria, <verse eid="ISA 37:21" /><verse number="22" style="v" sid="ISA 37:22" />kop ikọ se <char style="nd">Abọọñ</char> atañ abaña anye:</para>
  <para style="q1" vid="ISA 37:22">Mboppo Ayịn Awonwaan Saiyọn</para>
  <para style="q2" vid="ISA 37:22">use fiin ke ndek anyʌñ usak fiin.</para>
  <para style="q1" vid="ISA 37:22">Ayịn awonwaan Yeruselem</para>
  <para style="q2" vid="ISA 37:22">anyeghe iwuod amọ naña afo afegheke.<verse eid="ISA 37:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 37:23" />Anie ke afo ase ke mbio anyʌñ amiom?</para>
  <para style="q2" vid="ISA 37:23">Afo adịppe uyio mfo abaña anie,</para>
  <para style="q1" vid="ISA 37:23">anyʌñ adịppe anyen mfo ke ntañidem?</para>
  <para style="q2" vid="ISA 37:23">Abaña Adisana Abasi Isrel!<verse eid="ISA 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 37:24" />Afo amekama isʌñutom mfo</para>
  <para style="q2" vid="ISA 37:24">amiom <char style="nd">Abọọñ</char>.</para>
  <para style="q1" vid="ISA 37:24">Afo amenyʌñ abo,</para>
  <para style="q2" vid="ISA 37:24">Ye uwak sariọd mmi</para>
  <para style="q1" vid="ISA 37:24">ami mmedọọk nsịm mme atịñe ikpọabod,</para>
  <para style="q2" vid="ISA 37:24">ataa anyọñ abod Lebanọn.</para>
  <para style="q1" vid="ISA 37:24">Ami mmekpok mme ñnyọọññkan eto sida amọ,</para>
  <para style="q2" vid="ISA 37:24">mme mfọọn edimek eto yunipa amọ.</para>
  <para style="q1" vid="ISA 37:24">Ami mmesịm ataa akpatre atịñe amọ,</para>
  <para style="q2" vid="ISA 37:24">mme mfọọnñkan akai amọ.<verse eid="ISA 37:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 37:25" />Ami mmetịppe mme ube mmọọñ ke mme asen idịd,</para>
  <para style="q2" vid="ISA 37:25">ñnyʌñ ñnwọñ mmọọñ nto do.</para>
  <para style="q1" vid="ISA 37:25">Ye ekaikpad mmi</para>
  <para style="q2" vid="ISA 37:25">ami mmenam afịd mme idịm ke Iyib esat.<verse eid="ISA 37:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="ISA 37:26" />Ado nte afo ukoppo?</para>
  <para style="q2" vid="ISA 37:26">Akpeene ami ñkebiere.</para>
  <para style="q1" vid="ISA 37:26">Ke mme usen edem ami mmaanam uduak;</para>
  <para style="q2" vid="ISA 37:26">idahami ami mmenam anye awuọ asu,</para>
  <para style="q1" vid="ISA 37:26">ke afo amenam mme ñkpọsọñ abio</para>
  <para style="q2" vid="ISA 37:26">ekappa edo mme eboho itiad.<verse eid="ISA 37:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 37:27" />Mbon ammọ, u-udịd amaakweeñe,</para>
  <para style="q2" vid="ISA 37:27">idem anyʌñ abọkkọ e-ekop abuud.</para>
  <para style="q1" vid="ISA 37:27">Ammọ eba nte eto ke inwañ,</para>
  <para style="q2" vid="ISA 37:27">nte ndisi awawa emịne,</para>
  <para style="q1" vid="ISA 37:27">nte mbid a-atịppeke ke akọm,</para>
  <para style="q2" vid="ISA 37:27">asaat mbemiso anye akọt.<verse eid="ISA 37:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="ISA 37:28" />Ado ami mmediọọñọ nte afo aba</para>
  <para style="q2" vid="ISA 37:28">ye ini se afo adi ye ini anyʌññọ anyọñ</para>
  <para style="q2" vid="ISA 37:28">ye naña afo atọhọ ye ami.<verse eid="ISA 37:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 37:29" />Sia afo atọhọke ye ami,</para>
  <para style="q2" vid="ISA 37:29">ñko sia usọñanyen mfo amaadiwuọ utọñ mmi,</para>
  <para style="q1" vid="ISA 37:29">ami ñyaasịn ekọb mmi ke iwuo mfo</para>
  <para style="q2" vid="ISA 37:29">ye ukwak mmi ke inua mfo,</para>
  <para style="q1" vid="ISA 37:29">ndin ami ñyaanam afo atịmme anyọñ</para>
  <para style="q2" vid="ISA 37:29">kpa ke usʌñ afo aketooho adi.<verse eid="ISA 37:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ISA 37:30" />Hesikaiya, ami adiido idiọọñọ unọ fiin:</para>
  <para style="q1" vid="ISA 37:30">Isua ami afo uduudia se itịppe ke idem amọ,</para>
  <para style="q2" vid="ISA 37:30">ndin ayọhọ isua iba se itịppe ito akpa ado.</para>
  <para style="q1" vid="ISA 37:30">Ado ke ayọhọ isua ita tọ nyʌñ dọk,</para>
  <para style="q2" vid="ISA 37:30">tọ mme inwañ fain nyʌñ dia mme mfịd ammọ.<verse eid="ISA 37:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 37:31" />Inikeed mfen nsʌhọ abioubọọñ Yuda</para>
  <para style="q2" vid="ISA 37:31">ayaanie adʌñ ke idak isọñ anyʌñ anwịm mfịd ke anyọñ.<verse eid="ISA 37:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 37:32" />Sia nsʌhọ ayaato ke Yeruselem awuọ adi,</para>
  <para style="q2" vid="ISA 37:32">mbon e-ebọkkọke eyaenyʌñ eto Abod Saiyọn.</para>
  <para style="q1" vid="ISA 37:32">Akpọsọñ udọñ <char style="nd">Abọọñ</char> Andikponñkan adiinam ami awuọ asu.<verse eid="ISA 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ISA 37:33" />Ke ntoro se <char style="nd">Abọọñ</char> atañ ado ami abaña adidem Asiria:</para>
  <para style="q1" vid="ISA 37:33">Anye idiidʌkkọ abio ami,</para>
  <para style="q2" vid="ISA 37:33">idiinyʌññọ itop idañ mi.</para>
  <para style="q1" vid="ISA 37:33">Anye idiikamake atuekọñ ibịne abio ami,</para>
  <para style="q2" vid="ISA 37:33">idiinyʌññọ ibọp nnaaekọñ ikanna anye ikʌk.<verse eid="ISA 37:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 37:34" />Usʌñ nte anye aketo adi ke anye adisaña inyọñ;</para>
  <para style="q2" vid="ISA 37:34">anye idiidʌkkọ abio ami,</para>
  <para style="q2" vid="ISA 37:34">
    <char style="nd">Abọọñ</char> abo.<verse eid="ISA 37:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ISA 37:35" />“Ami ñyaakpeme abio ami ñnyʌñ ñnyaaña anye,</para>
  <para style="q2" vid="ISA 37:35">ke ntak mmi ye ke ntak afʌnadeen mmi Defid!”<verse eid="ISA 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ISA 37:36" />Akem enyere <char style="nd">Abọọñ</char> amaakaa akewot awo tọsịn ikie mme anaañ mme ition (185,000) ke nnaaekọñ Asiria. Mbon awo ekedemme ubakusen edemusen, sese afịd akedo mme akpo awo! <verse eid="ISA 37:36" /><verse number="37" style="v" sid="ISA 37:37" />Ndin Senakerib adidem Asiria amaasuan nnaaekọñ amọ anyʌñ atịmme edem anyọñ. Anye amaanyọñ Ninife anyʌñ akeba do.<verse eid="ISA 37:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ISA 37:38" />Usen keed, nte anye akesʌkkọ akpono abasi amọ Nisrọk ke tembịd, nditọ ideen amọ Adramelek ye Saresa emaewot anye ke akañkañ, ndin ammọ emaefeeñe ekaa isọñ Ararad. Ndin Esahadọn ayịn amọ amaadat itie amọ nte adidem.<verse eid="ISA 37:38" /></para>
  <chapter eid="ISA 37" />
  <chapter number="38" style="c" sid="ISA 38" />
  <para style="s1">Udọñọ Hesikaiya</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 38:1" />Ke ini ado Hesikaiya amaadọñọ akpere ñkpa. Prọfed Aisaiya ayịn Emọs amaakaa abịne anye anyʌñ akebo, “Se <char style="nd">Abọọñ</char> atañ ado ami: Tịm ufọk mfo nịm, sia afo ayaakpa; uduukoppo nsọñidem.”<verse eid="ISA 38:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 38:2" />Hesikaiya amaawọññọ iso ase ndibene anyʌñ abọñ akam anọ <char style="nd">Abọọñ</char>, <verse eid="ISA 38:2" /><verse number="3" style="v" sid="ISA 38:3" />“<char style="nd">Abọọñ</char> toiyo naña ami nsisaña ke iso mfo ke akpanikọ ye ke afịd esịd mmi ñnyʌñ nnam se inen ke iso mfo.” Ndin Hesikaiya amaatua ataa idod-idod ayịd.<verse eid="ISA 38:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 38:4" />Akem uyio <char style="nd">Abọọñ</char> amaadisịm Aisaiya: <verse eid="ISA 38:4" /><verse number="5" style="v" sid="ISA 38:5" />“Kaa kedọkkọ Hesikaiya, ‘se <char style="nd">Abọọñ</char>, Abasi ete mfo Defid atañ ado ami: Ami mmekop akam mfo mmenyʌñ ñkịt mmọọñayịd mfo; ami ñyaadian isua duob mme ition ke isua uwem mfo. <verse eid="ISA 38:5" /><verse number="6" style="v" sid="ISA 38:6" />Ami ñko ñyaufak fiin ye abio ami nsio ke ubọk adidem Asiria. Ami ñyaakpeme abio ami.<verse eid="ISA 38:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 38:7" />“ ‘Idiọọñọ <char style="nd">Abọọñ</char> ado ami adinam yak afo adiọọñọ ke <char style="nd">Abọọñ</char> ayaanam se anye akenwọñọ ami. <verse eid="ISA 38:7" /><verse number="8" style="v" sid="ISA 38:8" />Ami ñyaanam ndukpọñ ake utịn anọọhọ atịmme edem ikpad duob naña anye akesaña asọiyọ ntondọọk usʌñufọk Ahas.’ ” Kpa ntoro unwana utịn amaatịmme edem ikpad duob naña anye akesaña asọiyọ.<verse eid="ISA 38:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="ISA 38:9" />Ñwed ake Hesikaiya adidem Yuda akewette ke ini udọñọ amọ amaakekweeñe nọ anye akop nsọñidem ado ami:<verse eid="ISA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 38:10" />Ami mmaabo, “Ke mbakka iba isua uwem mmi</para>
  <para style="q2" vid="ISA 38:10">nte ana ami mboiyo ke inuaatob ñkpa</para>
  <para style="q2" vid="ISA 38:10">yak embọ miin mme isua mmi se isʌhọ?”<verse eid="ISA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 38:11" />Ami mmaabo, “Ami ndiitịmmeke ñkịt <char style="nd">Abọọñ</char> ke idem amọ aba</para>
  <para style="q2" vid="ISA 38:11">ke isọñ mme aduuwem;</para>
  <para style="q1" vid="ISA 38:11">ami ndiimaanake nse awo nte ami aba,</para>
  <para style="q2" vid="ISA 38:11">me adiba ye mbon e-edʌññọ ke ederimbod idahami.<verse eid="ISA 38:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 38:12" />Nte atayad akpemeedọñ, ewuut ufọk mmi</para>
  <para style="q2" vid="ISA 38:12">enyʌñ embọ ufọk mmi.</para>
  <para style="q1" vid="ISA 38:12">Nte adọk afọñ ami mmenwịn uwem mmi,</para>
  <para style="q2" vid="ISA 38:12">ndin anye añkpịkke miin asio ke ñkpọ utuak afọñ;</para>
  <para style="q2" vid="ISA 38:12">uweemeayio ye akonayio afo amaanam utịd mmi adisịm.<verse eid="ISA 38:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 38:13" />Ami mmaabet ke ime tutu usiere,</para>
  <para style="q2" vid="ISA 38:13">ado nte ekpe anye amaabuuñ afịd mme akpọ mmi;</para>
  <para style="q2" vid="ISA 38:13">uweemeayio ye akonayio afo amaanam utịd mmi adisịm.<verse eid="ISA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 38:14" />Ami mmaatua nte akadañabasi me akpantaña,</para>
  <para style="q2" vid="ISA 38:14">Ami mmaamịm nte uyio ibiom a-afʌhọke.</para>
  <para style="q1" vid="ISA 38:14">Anyen mmi amaamem naña ami ñkeseeghe mme hefịn.</para>
  <para style="q2" vid="ISA 38:14">Nnananyen ansịm miin; <char style="nd">Abọọñ</char>, disịn unwam nnọ!”<verse eid="ISA 38:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 38:15" />Ado nsoo ke ami ñkeme aditañ?</para>
  <para style="q2" vid="ISA 38:15">Anye atañ ikọ ye ami, anye ke idem amọ anyʌñ anam ami.</para>
  <para style="q1" vid="ISA 38:15">Ami ñyaasaña ke nsuukidem ke afịd ayio uwem mmi</para>
  <para style="q2" vid="ISA 38:15">ke ntak ndutʌhọ ukpọñ mmi ami.<verse eid="ISA 38:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 38:16" />
    <char style="nd">Abọọñ</char>, ke mme ñkpọ ntom mme awo edu uwem;</para>
  <para style="q2" vid="ISA 38:16">sịbidịd mmi ñko anyʌñ akịt uwem ke mme ñkpọ ami ñko.</para>
  <para style="q1" vid="ISA 38:16">Afo amaatịmme annọ miin nsọñidem,</para>
  <para style="q2" vid="ISA 38:16">anyʌñ anam ami ndu uwem.<verse eid="ISA 38:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 38:17" />Ke akpanikọ akedo ke ufọn mmi</para>
  <para style="q2" vid="ISA 38:17">ami adiyọ utọ ndutʌhọ ado.</para>
  <para style="q1" vid="ISA 38:17">Ke ima mfo afo amansio miin</para>
  <para style="q2" vid="ISA 38:17">ke ube nsobo;</para>
  <para style="q1" vid="ISA 38:17">afịd idiọọkñkpọ mmi afo ameduọk ammọ</para>
  <para style="q2" vid="ISA 38:17">ke edem mfo.<verse eid="ISA 38:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 38:18" />Sia udi ikemeke adutooro fiin,</para>
  <para style="q2" vid="ISA 38:18">ñkpa ikemeke adikwọ itooro mfo;</para>
  <para style="q1" vid="ISA 38:18">mbon e-edʌñọke ke udi</para>
  <para style="q2" vid="ISA 38:18">ikemeke inie idodanyen ke mfọn mfo.<verse eid="ISA 38:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 38:19" />Mme aduuwem, mme aduuwem, ammọ utooro fiin,</para>
  <para style="q2" vid="ISA 38:19">naña ami nnam mfịn ami;</para>
  <para style="q1" vid="ISA 38:19">mme anie nditọ edọkkọ nditọ ammọ</para>
  <para style="q2" vid="ISA 38:19">ebaña mfọn mfo.<verse eid="ISA 38:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 38:20" />
    <char style="nd">Abọọñ</char> ayañnyaaña miin,</para>
  <para style="q2" vid="ISA 38:20">ndin ñnyịn iyaikwọ ikwọ ke mme ndido udʌk</para>
  <para style="q1" vid="ISA 38:20">ke afịd ayio uwem ñnyịn</para>
  <para style="q2" vid="ISA 38:20">ke tembịd <char style="nd">Abọọñ</char>.<verse eid="ISA 38:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 38:21" />Aisaiya amaabo, “Inuakka mmeme mfañ fik idian ke ndufuud ado, ndin anye ayaakop nsọñidem.”<verse eid="ISA 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 38:22" />Hesikaiya amaabịp, “Nsoo idiido idiọọñọ ke ami ñyaadọọk ñka ke tembịd <char style="nd">Abọọñ</char>?”<verse eid="ISA 38:22" /></para>
  <chapter eid="ISA 38" />
  <chapter number="39" style="c" sid="ISA 39" />
  <para style="s1">Mme Isʌñutom e-Etooho Babilọn</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 39:1" />Ke ini ado Maduk-Baladan ayịn Baladan adidem Babilọn amaanọ mme ñwedetob ye enọ esọk Hesikaiya, sia anye amaakop abaña udọñọ amọ ye nsọñidem. <verse eid="ISA 39:1" /><verse number="2" style="v" sid="ISA 39:2" />Hesikaiya amaabọ mme isʌñutom ami ke inemesịd anyʌñ awọọt ammọ se ikidọñọ ke mme ufọk ubonoñkpọ amọ: silfa, kold, anemufịk adan, nti adan ọlif, afịd ñkpọekọñ amọ ye afịd ñkpọ se ekekịt ke atu mme ñkpọuto amọ. Ibaaha ñkpọ ndomokeed ke ufọk adidem me ke afịd idak ukara amọ ake Hesikaiya imiikiwọttọ ammọ.<verse eid="ISA 39:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 39:3" />Akem prọfed Aisaiya amaakaa abịne Adidem Hesikaiya akebịp, “Nsoo ke ideen ado ekebo, ñko ammọ eketo uke edi?”</para>
  <para style="p" vid="ISA 39:3">Hesikaiya amaabọọrọ. “Eketo anyan idịd, ammọ eketo Babilọn edi embịne miin.”<verse eid="ISA 39:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 39:4" />Ndin prọfed amaabịp, “Nsoo ke ammọ ekekịt ke akwere adidem?”</para>
  <para style="p" vid="ISA 39:4">Hesikaiya amaabo, “Ammọ emaekịt afịd ñkpọ ke akwere adidem. Ibaaha ñkpọuto ke atu inie mmi a-ami mmeñkewọttọ ammọ.”<verse eid="ISA 39:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 39:5" />Ndin Aisaiya amaabo Hesikaiya, “Kop ikọ <char style="nd">Abọọñ</char> Andikponñkan: <verse eid="ISA 39:5" /><verse number="6" style="v" sid="ISA 39:6" />Ke akpanikọ ini ayaadi a-afịd ñkpọ ke ufọkubọọñ mfo, ye afịd se mbon se ikubem fiin iso ikaara ekebono tutu awuọ usen mfịn, ediikoono inyọñ Babilọn. Ñkpọ ndomokeed idiisʌhọke, <char style="nd">Abọọñ</char> atañ. <verse eid="ISA 39:6" /><verse number="7" style="v" sid="ISA 39:7" />Ndin ubaak mbon ubon mfo, abʌk ye iyiib mfo se ediiman unọ fiin, eyaeben ammọ esio, ammọ eyaekappa mme itọ ke ufọkubọọñ adidem Babilọn.”<verse eid="ISA 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 39:8" />Hesikaiya amaabọọrọ Aisaiya, “Ikọ <char style="nd">Abọọñ</char> se afo atañ afọn,” sia anye amaakere, “Emem ye ifuuro eyaeba ke ayio uwem mmi.”<verse eid="ISA 39:8" /></para>
  <chapter eid="ISA 39" />
  <chapter number="40" style="c" sid="ISA 40" />
  <para style="s1">Idọñesịd e-Enọọhọ Nditọ Abasi</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 40:1" />Dọñ esịd, dọñ ikọd mmi esịd,</para>
  <para style="q2" vid="ISA 40:1">Abasi ndufo atañ.<verse eid="ISA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 40:2" />Tañ ke sʌñ-sʌñ uyio nọ Yeruselem,</para>
  <para style="q2" vid="ISA 40:2">nyʌñ tịm dọkkọ anye</para>
  <para style="q1" vid="ISA 40:2">ke anye anam mme ñkpọsọñ utom amọ ama,</para>
  <para style="q2" vid="ISA 40:2">ke e-ekpe utịb mme idiọọkñkpọ amọ,</para>
  <para style="q1" vid="ISA 40:2">ke anye abọ ato ubọk <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ISA 40:2">utịb ndiọiñkpọ amọ akañ iba.<verse eid="ISA 40:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 40:3" />Kop uyio andikood:</para>
  <para style="q1" vid="ISA 40:3">“Idiọñ usʌñ inọ <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ISA 40:3">ke anaan;</para>
  <para style="q1" vid="ISA 40:3">inam nnen-nnen</para>
  <para style="q2" vid="ISA 40:3">akpọusʌñ ke akpautatan inọ Abasi ñnyịn.<verse eid="ISA 40:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 40:4" />Eyaedịppe afịd abedeñ ke anyọñ,</para>
  <para style="q2" vid="ISA 40:4">enyʌñ esuan afịd ikpọabod ye ntəkabod;</para>
  <para style="q1" vid="ISA 40:4">eyaenekke isọñ se ikwaña enịm,</para>
  <para style="q2" vid="ISA 40:4">mmʌkkọ-mmʌkkọ isọñ ayaakappa unaisọñ.<verse eid="ISA 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 40:5" />Akem eyaeyaara ubọọñ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 40:5">ndin afịd uduud awo eyaediana keed ekịt anye.</para>
  <para style="q1" vid="ISA 40:5">Sia inua <char style="nd">Abọọñ</char> atañ.”<verse eid="ISA 40:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 40:6" />Uyio ate, “Tua ke akpọsọñ uyio.”</para>
  <para style="q2" vid="ISA 40:6">Ndin ami mmaabo, “Nsoo ke ami ndiitua?”</para>
  <para style="b" vid="ISA 40:6" />
  <para style="q1" vid="ISA 40:6">“Afịd awo ebit mbid,</para>
  <para style="q2" vid="ISA 40:6">afịd nti utom akpanikọ ammọ enyʌñ ebit ñkpokpoñ ke inwañ.<verse eid="ISA 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 40:7" />Mme mbid eyeeme, mme ñkpokpoñ ñko eduọññọ,</para>
  <para style="q2" vid="ISA 40:7">sia ibifịk <char style="nd">Abọọñ</char> afịm ammọ.</para>
  <para style="q2" vid="ISA 40:7">Ke akpanikọ mme awo edo mbid.<verse eid="ISA 40:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 40:8" />Mme mbid eyeeme, mme ñkpokpoñ ñko eduọññọ,</para>
  <para style="q2" vid="ISA 40:8">ado ikọ Abasi ada ke nsi-nsi.”<verse eid="ISA 40:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 40:9" />Afo a-abenne eti mbʌk adi Saiyọn,</para>
  <para style="q2" vid="ISA 40:9">dọọk kaa anyọñ ekamba abod.</para>
  <para style="q1" vid="ISA 40:9">Afo a-abenne eti mbʌk adi Yeruselem,</para>
  <para style="q2" vid="ISA 40:9">dịppe uyio mfo nyʌñ sio ñkpo,</para>
  <para style="q1" vid="ISA 40:9">dịppe anye ke anyọñ ke adudu, kuufeghe ndịk,</para>
  <para style="q2" vid="ISA 40:9">dọkkọ mme abio Yuda,</para>
  <para style="q2" vid="ISA 40:9">“Se Abasi mfo mi!”<verse eid="ISA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 40:10" />Se, <char style="nd">Abọọñ</char> Andikara adi ye adudu,</para>
  <para style="q2" vid="ISA 40:10">anye anyʌñ akara ke akpọsọñ ubọk.</para>
  <para style="q1" vid="ISA 40:10">Se, anye asaña ye utịb amọ,</para>
  <para style="q2" vid="ISA 40:10">ñkpọ ayịnutom amọ anyʌñ asaña ye anye.<verse eid="ISA 40:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 40:11" />Anye akama mme edọñ amọ nte akpemeedọñ:</para>
  <para style="q2" vid="ISA 40:11">Anye akama ufene ke ubọk amọ,</para>
  <para style="q1" vid="ISA 40:11">anyʌñ aben nditọedọñ adian ke ikpanesịd amọ;</para>
  <para style="q2" vid="ISA 40:11">anyʌñ adat mbon ekamake nsek nditọ usʌñ usʌk-usʌk.<verse eid="ISA 40:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 40:12" />Anie awo adomo mmọọñ ke esịd ekaubọk amọ,</para>
  <para style="q2" vid="ISA 40:12">me adibakka mme hefịn ke ekaubọk amọ?</para>
  <para style="q1" vid="ISA 40:12">Anie awo amʌm abu ke isọñ adọñ ke akpasa,</para>
  <para style="q2" vid="ISA 40:12">me adidomo mme ikpọabod ke udomoñkpọ</para>
  <para style="q2" vid="ISA 40:12">ye ntəkabod ke udomoñkpọ?<verse eid="ISA 40:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 40:13" />Anie awo akeme adidiọọñọ Sịbidịd<note caller="+" style="f"><char style="fr" closed="false">40:13 </char><char style="ft" closed="false">Akeme ido </char><char style="fqa" closed="false">esịd</char></note> <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 40:13">me adikpeep <char style="nd">Abọọñ</char> nte anọitem amọ?<verse eid="ISA 40:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 40:14" />Anie ke <char style="nd">Abọọñ</char> akekaa akekịt abo nọ adikpeep anye ñkpọ,</para>
  <para style="q2" vid="ISA 40:14">ndin anie akekpeep anye nnen-nnen usʌñ?</para>
  <para style="q1" vid="ISA 40:14">Anie ado awo a-akekpeebe anye ifiọk,</para>
  <para style="q2" vid="ISA 40:14">me adiwọt anye usʌñ ikike?<verse eid="ISA 40:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 40:15" />Ke akpanikọ mme idịd ebit ntọi mmọọñ ke abañ mmọọñ;</para>
  <para style="q2" vid="ISA 40:15">edat ammọ nte abu ke udomoñkpọ;</para>
  <para style="q2" vid="ISA 40:15">anye adomo mme isu nte edo ataa abu.<verse eid="ISA 40:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 40:16" />Lebanọn ikemme ke ikañ akpokoro uwa,</para>
  <para style="q2" vid="ISA 40:16">mme unam ammọ ñko ikemme ke ufọfọb uwa.<verse eid="ISA 40:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 40:17" />Afịd mme idịd idooho ñkpọ ndomokeed ke iso amọ;</para>
  <para style="q2" vid="ISA 40:17">anye adat ammọ nte ñkpọ i-imiibaaha ufọn,</para>
  <para style="q2" vid="ISA 40:17">enyʌñ esịp atataa eti-eti.<verse eid="ISA 40:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 40:18" />Anie ndin ke afo uduudat ukudomo ye Abasi?</para>
  <para style="q2" vid="ISA 40:18">Akee ubobodñkpọ ke afo uduudat ukudomo ye anye?<verse eid="ISA 40:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 40:19" />Amaado ubobodñkpọ, ubọk anamusọ akenam anye,</para>
  <para style="q2" vid="ISA 40:19">anamutom kold akama kold adiọñ anye,</para>
  <para style="q2" vid="ISA 40:19">anyʌñ adiọñ akpọnọ silfa anọ anye.<verse eid="ISA 40:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 40:20" />Awo a-aweeneke akan se akpenọọ utọ enọ ado</para>
  <para style="q2" vid="ISA 40:20">asat eto i-imiiduakka adibiara;</para>
  <para style="q1" vid="ISA 40:20">ammọ eyem anamusọ se idiọọñọ utom</para>
  <para style="q2" vid="ISA 40:20">yak adibot ubobodñkpọ i-imiiduakka inyʌkkọ nduọ.<verse eid="ISA 40:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 40:21" />Ado nte afo udiọọñọke?</para>
  <para style="q2" vid="ISA 40:21">Ado nte afo ukoppo?</para>
  <para style="q1" vid="ISA 40:21">Ado nte awo ikudọkkọke fiin tọọñọ ke ntọọñọ?</para>
  <para style="q2" vid="ISA 40:21">Ado nte afo unieghe ifiọk ubaña tọọñọ ekenam ederimbod?<verse eid="ISA 40:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 40:22" />Anye atie ke ebekpo ke ikara ederimbod,</para>
  <para style="q2" vid="ISA 40:22">ikọd amọ ebit mme ataktak.</para>
  <para style="q1" vid="ISA 40:22">Anye adette mme hefịn nte ikpotto,</para>
  <para style="q2" vid="ISA 40:22">anyʌñ atat ammọ nte atayad se edʌñ.<verse eid="ISA 40:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 40:23" />Anye anam nditọ ideen adidem iwuọñọke ñkpọ ndomokeed,</para>
  <para style="q2" vid="ISA 40:23">anyʌñ asuuhọ mme akama ukara ke ederimbod ami anịm nte ukpọk ñkpọ.<verse eid="ISA 40:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 40:24" />Ikpeenekekpeene eketọ ammọ,</para>
  <para style="q2" vid="ISA 40:24">ikpeenekekpeene ekesịn ammọ ke isọñ,</para>
  <para style="q2" vid="ISA 40:24">Ikpeenekekpeene ammọ edọñ adʌñ ke isọñ,</para>
  <para style="q1" vid="ISA 40:24">anye afuut ammọ ndin ammọ eyeeme,</para>
  <para style="q2" vid="ISA 40:24">ndin afịm ayobio akwọọk ammọ aduọọk nte mbio.<verse eid="ISA 40:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="ISA 40:25" />“Anie ke afo uduudat udomo ye ami?</para>
  <para style="q2" vid="ISA 40:25">Me anie ido ñka ye ami?” Adisana Abasi Keed atañ.<verse eid="ISA 40:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 40:26" />Dịppe anyen mfo nyʌñ se mme hefịn:</para>
  <para style="q2" vid="ISA 40:26">Anie akebot afịd ami?</para>
  <para style="q1" vid="ISA 40:26">Anye a-asịññeke mme udịm anyọñ keedekeed</para>
  <para style="q2" vid="ISA 40:26">anyʌñ akoot ammọ keedekeed ke anyịñ.</para>
  <para style="q1" vid="ISA 40:26">Ke ntak akpọsọñ adudu ye ukeme amọ,</para>
  <para style="q2" vid="ISA 40:26">ndomokeed ke atu ammọ isoppo.<verse eid="ISA 40:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="ISA 40:27" />Nsoo inam afo aseeme idem, Yekọb?</para>
  <para style="q2" vid="ISA 40:27">Nsoo inam nọ afo abo, Isrel ate,</para>
  <para style="q1" vid="ISA 40:27">“Usʌñ mmi adịbe ke iso <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="ISA 40:27">Abasi iseeghe ñkpọ ibaña se imbeghe miin”?<verse eid="ISA 40:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 40:28" />Ado nte afo udiọọñọke?</para>
  <para style="q2" vid="ISA 40:28">Ado nte afo ukoppo?</para>
  <para style="q1" vid="ISA 40:28">
    <char style="nd">Abọọñ</char> ado nsi-nsi Abasi,</para>
  <para style="q2" vid="ISA 40:28">Andibod afịd mme utịd ederimbod.</para>
  <para style="q1" vid="ISA 40:28">Anye idiikpaaha mba, idem idiinyʌññọ imem anye,</para>
  <para style="q2" vid="ISA 40:28">ifiọk amọ awo ikanna idiọọñọ.<verse eid="ISA 40:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 40:29" />Anye anọ mbon mmemidem inweek,</para>
  <para style="q2" vid="ISA 40:29">anyʌñ anam ukeme awak anọ mbon mmemidem.<verse eid="ISA 40:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 40:30" />Mme iwaad ekeme adikop mmemidem enyʌñ ekpa mba,</para>
  <para style="q2" vid="ISA 40:30">ñkparawa ideen etuak ukod enyʌñ eduọ;<verse eid="ISA 40:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 40:31" />ado mbon se idot anyen ke <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ISA 40:31">eyaedemme adudu ammọ.</para>
  <para style="q1" vid="ISA 40:31">Ammọ eyaefuurọ ke mba nte mme ntrukpuum;</para>
  <para style="q2" vid="ISA 40:31">ammọ eyaefeghe ado idiikpaaha mba,</para>
  <para style="q2" vid="ISA 40:31">ammọ eyaesaña ado idiikoppo mmemidem.<verse eid="ISA 40:31" /></para>
  <chapter eid="ISA 40" />
  <chapter number="41" style="c" sid="ISA 41" />
  <para style="s1">Andinwam Isrel</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 41:1" />“Ndufo mme isu, iba ke ndobuyio ke iso mmi,</para>
  <para style="q2" vid="ISA 41:1">Yak mme idịd edemme adudu ammọ!</para>
  <para style="q1" vid="ISA 41:1">Yak ammọ ewuọ edi enyʌñ esio uyio;</para>
  <para style="q2" vid="ISA 41:1">yak ñnyịn isoobo keed ke itie ikpe.”<verse eid="ISA 41:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ISA 41:2" />“Anie ademme anye a-akebaaha ke edem usakkautịn,</para>
  <para style="q2" vid="ISA 41:2">a-akoodo anye ke adinenido asio anọ utom?</para>
  <para style="q1" vid="ISA 41:2">Anye ayaak mme idịd anọ anye,</para>
  <para style="q2" vid="ISA 41:2">anyʌñ asuuhọ mme ndidem ke iso amọ.</para>
  <para style="q1" vid="ISA 41:2">Anye akama akañkañ amọ anam ammọ ekappa abu,</para>
  <para style="q2" vid="ISA 41:2">akama utịgha amọ anam ammọ eba nte mbio se efefịm.<verse eid="ISA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 41:3" />Anye abịne ammọ ndin asaña ke ifuuro, ñkpọ ndomokeed iwaaha anye</para>
  <para style="q2" vid="ISA 41:3">ke usʌñ u-ukod amọ imiisañake akpa.<verse eid="ISA 41:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 41:4" />Anie anam ami akewuọ utịd,</para>
  <para style="q2" vid="ISA 41:4">akootto mme ubon tọọñọ ke editọñọ?</para>
  <para style="q1" vid="ISA 41:4">Ami, <char style="nd">Abọọñ</char>, ye akpa ke atu ammọ</para>
  <para style="q2" vid="ISA 41:4">ñko ye akpatre, ami ndo anye.”<verse eid="ISA 41:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 41:5" />Mme isu ekịt anye enyʌñ ekop ndịk;</para>
  <para style="q2" vid="ISA 41:5">mme utịd ederimbod enyeñ.</para>
  <para style="q1" vid="ISA 41:5">Ammọ esaña ekpere enyʌñ ewuọ edi;<verse eid="ISA 41:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 41:6" />ammọ enwam emọemọ</para>
  <para style="q2" vid="ISA 41:6">enyʌñ ebo nsaña ammọ, “Isọñ idem!”<verse eid="ISA 41:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 41:7" />Anamutom ukwak asọọñọ anamusọ idem,</para>
  <para style="q2" vid="ISA 41:7">ñko andikama ukọññkpọ nnam nọ adọnọ</para>
  <para style="q2" vid="ISA 41:7">asọọñọ andikọñ ukwak idem.</para>
  <para style="q1" vid="ISA 41:7">Awo keed atañ abaña adomutịm ate, “Anye afọñ.”</para>
  <para style="q2" vid="ISA 41:7">Awo mfen akọñ ubobodñkpọ ke akpohoukwak mbaak anye adinyʌkkọ aduọ.<verse eid="ISA 41:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 41:8" />“Ama ado afo, Isrel, ayịnutom mmi,</para>
  <para style="q2" vid="ISA 41:8">Yekọb, anye ami mmekke,</para>
  <para style="q2" vid="ISA 41:8">ndufo ubon Ebraham ufan mmi,<verse eid="ISA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 41:9" />ami ñkiben ndufo nto mme utịd ederimbod,</para>
  <para style="q2" vid="ISA 41:9">ikoot ndufo nto mme ataa nsan-nsan inuuk amọ.</para>
  <para style="q1" vid="ISA 41:9">Ami ñkebo, ‘Ndufo edo isʌñutom mmi’;</para>
  <para style="q2" vid="ISA 41:9">ami mmimek ndufo ñnyʌññọ isịn ndufo.<verse eid="ISA 41:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 41:10" />Ke ntoro ikiifeghe ndịk, sia ami mmọdo ye ndufo;</para>
  <para style="q2" vid="ISA 41:10">ikiiyak esịd itịmede ndufo, sia ami ndo Abasi ndufo.</para>
  <para style="q1" vid="ISA 41:10">Ami ñyaisọọñọ ndufo idem ñnyʌñ inwam ndufo;</para>
  <para style="q2" vid="ISA 41:10">ami ñyaibenne ndufo ye adinen ubọk nnasia mmi.<verse eid="ISA 41:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 41:11" />“Ke akpanikọ afịd mbon se itọhọ ye afo</para>
  <para style="q2" vid="ISA 41:11">eyaekop abuud enyʌñ ebọ asuenne;</para>
  <para style="q1" vid="ISA 41:11">mbon se ubiọọñọ fiin</para>
  <para style="q2" vid="ISA 41:11">ediiba nte ukpọk ñkpọ enyʌñ etak.<verse eid="ISA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 41:12" />Akpesʌkado afo ayemme mme asua mfo,</para>
  <para style="q2" vid="ISA 41:12">afo uduukịtte ammọ.</para>
  <para style="q1" vid="ISA 41:12">Mbon e-enwanake ekọñ ye afo</para>
  <para style="q2" vid="ISA 41:12">idiiwuọñọke baaba ñkpọ ndomokeed.<verse eid="ISA 41:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 41:13" />Sia ami ndo <char style="nd">Abọọñ</char> Abasi ndufo</para>
  <para style="q2" vid="ISA 41:13">a-amʌmmọ ubọk nnasia ndufo,</para>
  <para style="q1" vid="ISA 41:13">anyʌñ ibo ndufo, ikiinyeñ idem;</para>
  <para style="q2" vid="ISA 41:13">ami ñyainwam ndufo.<verse eid="ISA 41:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 41:14" />Ikiifeghe ndịk, ndufo utʌñ Yekọb,</para>
  <para style="q2" vid="ISA 41:14">etək Isrel, ikiifeghe ndịk,</para>
  <para style="q1" vid="ISA 41:14">sia ami ke idem mmi ñyainyaaña ndufo,” <char style="nd">Abọọñ</char> atañ,</para>
  <para style="q2" vid="ISA 41:14">Andifak ndufo, Adisana Abasi Isrel.<verse eid="ISA 41:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 41:15" />“Se, ami ñyaanam ndufo eba nte ekamba akpeti ubeek abakpa,</para>
  <para style="q2" vid="ISA 41:15">ñyaanam afo ado ufa anyʌñ asọp, ye uwak eded.</para>
  <para style="q1" vid="ISA 41:15">Ndufo eyaesat mme ikpọabod enyʌñ ekọk ammọ,</para>
  <para style="q2" vid="ISA 41:15">enyʌñ enam mme ntək abod ekappa edo mbio.<verse eid="ISA 41:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 41:16" />Ndufo eyaekeñ ammọ, afịm ayaaben ammọ asio,</para>
  <para style="q2" vid="ISA 41:16">ndin akpọsọñ ayobio ayaafịm ammọ aduọọk.</para>
  <para style="q1" vid="ISA 41:16">Ado ndufo eyaedaara ke <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ISA 41:16">enyʌñ ebọ ubọọñ eto Adisana Abasi Isrel.<verse eid="ISA 41:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ISA 41:17" />“Mme uweene ye mbon unana eyem mmọọñ,</para>
  <para style="q2" vid="ISA 41:17">ado ibaaha;</para>
  <para style="q2" vid="ISA 41:17">edeme ammọ asat ke ntak nsaditọñ.</para>
  <para style="q1" vid="ISA 41:17">Ado ami <char style="nd">Abọọñ</char> ñyaabọọrọ ammọ;</para>
  <para style="q2" vid="ISA 41:17">Ami, Abasi Isrel, ndiikpọññọ ammọ.<verse eid="ISA 41:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 41:18" />Ami ñyaanam mme inyañ esakka ke mme ñkoñ-ñkoñ mbiara itie,</para>
  <para style="q2" vid="ISA 41:18">mme idịm ñko eyaeto abedeñ esakka.</para>
  <para style="q1" vid="ISA 41:18">Ami ñyaanam akpautatan akappa mme ñkpọdiọhọ mmọọñ,</para>
  <para style="q2" vid="ISA 41:18">nsaad isọñ ayaakappa ufeghe mmọọñ.<verse eid="ISA 41:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 41:19" />Ami ñyaatọ ke akpautatan</para>
  <para style="q2" vid="ISA 41:19">eto sida ye eto akasia, eto meetel ye eto ọlif.</para>
  <para style="q1" vid="ISA 41:19">Ami ñyaanam mme yunipa etịppe ke mbiadaisọñ,</para>
  <para style="q2" vid="ISA 41:19">ñyaanam fir ye saipres ekọt itie keed,<verse eid="ISA 41:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 41:20" />nọ mme awo ekịt enyʌñ ediọọñọ,</para>
  <para style="q2" vid="ISA 41:20">ekere ebaña enyʌñ ebọ ifiọk,</para>
  <para style="q1" vid="ISA 41:20">ke ubọk <char style="nd">Abọọñ</char> anam ami,</para>
  <para style="q2" vid="ISA 41:20">Adisana Abasi Isrel abot anye.<verse eid="ISA 41:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 41:21" />“Iben ebeeñe ndufo idi,”</para>
  <para style="q2" vid="ISA 41:21">
    <char style="nd">Abọọñ</char> atañ.</para>
  <para style="q1" vid="ISA 41:21">“Iben mme ikọ mfaaña ndufo idi,”</para>
  <para style="q2" vid="ISA 41:21">Adidem Yekọb atañ.<verse eid="ISA 41:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 41:22" />“Itañ inọ ñnyịn, ndufo mme ubobod abasi,</para>
  <para style="q2" vid="ISA 41:22">se idiitịppe.</para>
  <para style="q1" vid="ISA 41:22">Itañ idọkkọ ñnyịn se mme ñkaan ñkpọ ekedo,</para>
  <para style="q2" vid="ISA 41:22">yak ñnyịn itịm ise ammọ</para>
  <para style="q2" vid="ISA 41:22">inyʌñ idiọọñọ utịd ammọ.</para>
  <para style="q1" vid="ISA 41:22">Imiidooho itañ mme ñkpọ se idiidi ke iso inọ ñnyịn,<verse eid="ISA 41:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="ISA 41:23" />itañ inọ ñnyịn se idiitịppe ke ini iso,</para>
  <para style="q2" vid="ISA 41:23">yak ñnyịn idiọọñọ ke ndufo edo mme abasi.</para>
  <para style="q1" vid="ISA 41:23">Inam ñkpọ, me ado eti me ado idiọọk,</para>
  <para style="q2" vid="ISA 41:23">yak ñnyịn idịkke inyʌñ iyọhọ ye ndịk.<verse eid="ISA 41:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 41:24" />Ado ndufo emesịp ekan ikpu-ikpu ñkpọ,</para>
  <para style="q2" vid="ISA 41:24">mme utom ndufo ñko iwuọñọke ñkpọ ndomokeed;</para>
  <para style="q2" vid="ISA 41:24">awo ndomokeed se imek ndufo ado mbubiam.<verse eid="ISA 41:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="ISA 41:25" />“Ami mmedemme udọñ awo keed ke adoro, ndin anye adi,</para>
  <para style="q2" vid="ISA 41:25">awo a-atooho usakka utịn a-akoodo anyịñ mmi.</para>
  <para style="q1" vid="ISA 41:25">Anye atịm mme mbọọñ nte ammọ edo udʌñ,</para>
  <para style="q2" vid="ISA 41:25">nte anye ado abodabañ a-asọnnọke aduañ anam se ama.<verse eid="ISA 41:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 41:26" />Anie aketañ ami tọọñọ ke ntọọñọ, yak ñnyịn idiọọñọ,</para>
  <para style="q2" vid="ISA 41:26">me aketañ anịm, nọ ñnyịn ikpibo, ‘Anye amaanen’?</para>
  <para style="q1" vid="ISA 41:26">Ibaaha awo se ikitañ ikọ ami,</para>
  <para style="q2" vid="ISA 41:26">ibaaha awo se ikibem iso itañ inọọ ñnyịn,</para>
  <para style="q2" vid="ISA 41:26">awo ndomokeed ikikoppo mme ikọ uto fiin.<verse eid="ISA 41:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 41:27" />Ami ñkedo akpa awo adidọkkọ Saiyọn mbo, ‘Se, se ammọ mi!’</para>
  <para style="q2" vid="ISA 41:27">Ami mmaanọ Yeruselem isʌñutom a-akamake eti etob.<verse eid="ISA 41:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 41:28" />Ami nse ado ñkịtte awo ndomokeed,</para>
  <para style="q2" vid="ISA 41:28">ndomokeed ibaaha ke atu mme abasi se inọ item,</para>
  <para style="q2" vid="ISA 41:28">ndomokeed ibaaha adinọ ibọọrọ ke ini ami mbịppe ammọ.<verse eid="ISA 41:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 41:29" />Se, afịd ammọ edo abiaña!</para>
  <para style="q2" vid="ISA 41:29">Mme ubọkutom ammọ edo ukpọk;</para>
  <para style="q2" vid="ISA 41:29">mme ubobodñkpọ ammọ edo afịm ye ndutịme.<verse eid="ISA 41:29" /></para>
  <chapter eid="ISA 41" />
  <chapter number="42" style="c" sid="ISA 42" />
  <para style="s1">Isʌñutom <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 42:1" />“Anye ami ado ayịnufọk mmi, a-ami mmʌmmọ ñkama,</para>
  <para style="q2" vid="ISA 42:1">adimek awo mmi a-annemme miin esịd;</para>
  <para style="q1" vid="ISA 42:1">Ami ñyaadot anye Sịbidịd mmi ke idem,</para>
  <para style="q2" vid="ISA 42:1">ndin anye ayaaben unen asọk mme idịd.<verse eid="ISA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 42:2" />Anye idiibọññọ ñkpo, idiinyʌññọ itua ayịd,</para>
  <para style="q2" vid="ISA 42:2">idiinyʌññọ idịppe uyio amọ ke mme efaak.<verse eid="ISA 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 42:3" />Anye idiibuuño mbiaña akpọ ñnyanyaha,</para>
  <para style="q2" vid="ISA 42:3">idiinyʌññọ inịme aduek ifiaikañ.</para>
  <para style="q1" vid="ISA 42:3">Ke akpanikọ anye ayaakpe ikpe amọ ke unen;<verse eid="ISA 42:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 42:4" />esịd idiiduọhọ anye, idem idiinyʌññọ imem anye</para>
  <para style="q1" vid="ISA 42:4">tutu anye awuuk unen ke ederimbod.</para>
  <para style="q2" vid="ISA 42:4">Ke ukpeebñkpọ amọ ke mbon isuọ ediinie idodanyen.”<verse eid="ISA 42:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 42:5" />Se Abasi a-adooho <char style="nd">Abọọñ</char> atañ ado ami,</para>
  <para style="q1" vid="ISA 42:5">Andibod mme hefịn, a-anyʌññọ atat ammọ asuan,</para>
  <para style="q2" vid="ISA 42:5">anye a-adetteke ederimbod ye afịd se ikọt ke esịd amọ,</para>
  <para style="q2" vid="ISA 42:5">andinọ ikọd amọ ibifịk,</para>
  <para style="q2" vid="ISA 42:5">anyʌñ anọ mbon se isaña ke esịd uwem:<verse eid="ISA 42:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 42:6" />“Ami, <char style="nd">Abọọñ</char>, mmiikoot ndufo ke adinenido;</para>
  <para style="q2" vid="ISA 42:6">ami ñyaimʌm ndufo ubọk.</para>
  <para style="q1" vid="ISA 42:6">Ami ñyainịm ndufo ñnyʌñ nnam ndufo</para>
  <para style="q2" vid="ISA 42:6">edo edioomo enọ ubon awo,</para>
  <para style="q2" vid="ISA 42:6">enyʌñ edo unwana enọ mme Gentile,<verse eid="ISA 42:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 42:7" />etat anyen se ido nnan,</para>
  <para style="q2" vid="ISA 42:7">ekpọk mbon ñkpakọb eyaak,</para>
  <para style="q2" vid="ISA 42:7">enyʌñ etat mbon se isịne ke ufọk ñkpakọb ke ekịm eyaak.<verse eid="ISA 42:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 42:8" />“Ami ndo <char style="nd">Abọọñ</char>; anyịñ mmi ado ado!</para>
  <para style="q2" vid="ISA 42:8">Ami ndiiyaaha ubọọñ mmi nnọ awo mfen,</para>
  <para style="q2" vid="ISA 42:8">ndiinyʌññọ ñyaak itooro mmi nnọ mme abasi ubọkawo.<verse eid="ISA 42:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 42:9" />Se, ñkaan ñkpọ edat itie,</para>
  <para style="q2" vid="ISA 42:9">mme ufa ñkpọ edo se ntañ anwa-anwa;</para>
  <para style="q1" vid="ISA 42:9">mbemiso ammọ ewuọ esu,</para>
  <para style="q2" vid="ISA 42:9">ami mmenam ndufo ediọọñọ.”<verse eid="ISA 42:9" /></para>
  <para style="s1">Ikwọ Itooro <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 42:10" />Ikwọ ufa ikwọ inọ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 42:10">ikwọ itooro amọ tutu asịm utịd ederimbod,</para>
  <para style="q1" vid="ISA 42:10">afo a-adʌkkọ akpainyañ, ye afịd se idọñọ ke esịd,</para>
  <para style="q2" vid="ISA 42:10">ndufo mme isu ye afịd mbon se idʌñ ke esịd.<verse eid="ISA 42:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 42:11" />Yak anaan ye mme abio amọ ebenne uyio ammọ;</para>
  <para style="q2" vid="ISA 42:11">yak mme itieidʌñ ake Keda adʌññọ edaara.</para>
  <para style="q1" vid="ISA 42:11">Yak mbon Sela ekwọ ye inemesịd;</para>
  <para style="q2" vid="ISA 42:11">yak ammọ esio ñkpo ke mme anyọñ ikpọabod.<verse eid="ISA 42:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 42:12" />Yak ammọ enọ <char style="nd">Abọọñ</char> ubọọñ,</para>
  <para style="q2" vid="ISA 42:12">enyʌñ edịppe itooro amọ ke mme isu.<verse eid="ISA 42:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 42:13" />
    <char style="nd">Abọọñ</char> ayaawuọ adi nte andikan,</para>
  <para style="q2" vid="ISA 42:13">nte awo ekọñ anye ayaadịppe akpọsọñ udọñ amọ;</para>
  <para style="q1" vid="ISA 42:13">anye ayaadịppe uyio ekọñ, ye ñkpo,</para>
  <para style="q2" vid="ISA 42:13">ayaanyʌñ akan mme asua amọ.<verse eid="ISA 42:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 42:14" />“Ke ataa anyan ini ami mmedop uyio,</para>
  <para style="q2" vid="ISA 42:14">ami mmeba ke ndobuyio ñnyʌñ mmʌm idem mmi ñkama.</para>
  <para style="q1" vid="ISA 42:14">Ado idahami, nte awonwaan ayemme iman ayịn,</para>
  <para style="q2" vid="ISA 42:14">ami mmetua, inweek amben, esịd ñko ayem iñkịppe.<verse eid="ISA 42:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 42:15" />Ami ñyaasobo mme ikpọabod ye mme ntəkabod,</para>
  <para style="q2" vid="ISA 42:15">ñnyʌñ nnam ñkpọ esaat ke afịd inwañ ammọ;</para>
  <para style="q1" vid="ISA 42:15">ami ñyaanam mme inyañ eforo mme isu,</para>
  <para style="q2" vid="ISA 42:15">ñnyʌñ nnam mme ñkpọdiọhọ mmọọñ esat.<verse eid="ISA 42:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 42:16" />Ami ñyaadat mme nnan usʌñ nsaña ke mme itie a-ammọ imiidiọọñọke,</para>
  <para style="q2" vid="ISA 42:16">ke mme usʌñ i-imiimegheke ammọ ami ñyaakpeme ammọ;</para>
  <para style="q1" vid="ISA 42:16">ami ñyaanam ekịm akappa unwana anọ ammọ</para>
  <para style="q2" vid="ISA 42:16">ñnyʌñ nnam mme mfraha itie edọnọ.</para>
  <para style="q1" vid="ISA 42:16">Mme ñkpọ ami edo se ami ndiinam;</para>
  <para style="q2" vid="ISA 42:16">ami ndiisịnne ammọ.<verse eid="ISA 42:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 42:17" />Ado amaado mbon se ibuọt idem ke usọsọi ñkpọ,</para>
  <para style="q2" vid="ISA 42:17">mbon se ibo mme ubobodñkpọ, ‘Ndufo edo mme abasi ñnyịn,’</para>
  <para style="q2" vid="ISA 42:17">eyaetịmme edem enyọñ ye ekamba abuud.<verse eid="ISA 42:17" /></para>
  <para style="s1">Isrel Ado Nnan ye Inan</para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 42:18" />“Ikop, ndufo mme inan;</para>
  <para style="q2" vid="ISA 42:18">ise, ndufo mme nnan, inyʌñ ikịt usʌñ!<verse eid="ISA 42:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 42:19" />Anie ado nnan ke amaaboiyo ayịnufọk mmi,</para>
  <para style="q2" vid="ISA 42:19">ye inan nte isʌñutom a-ami ndọññọ?</para>
  <para style="q1" vid="ISA 42:19">Anie ado nnan nte anye a-abaaha ke edioomo ye ami,</para>
  <para style="q2" vid="ISA 42:19">nnan nte ayịnufọk <char style="nd">Abọọñ</char>?<verse eid="ISA 42:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 42:20" />Ndufo emekịt uwak ñkpọ, ado ikpañña utọñ;</para>
  <para style="q2" vid="ISA 42:20">utọñ ndufo enaa inwañ, ado ndufo ikoppo.”<verse eid="ISA 42:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 42:21" />Anem <char style="nd">Abọọñ</char> esịd</para>
  <para style="q2" vid="ISA 42:21">ke ntak adinenido amọ</para>
  <para style="q2" vid="ISA 42:21">adinam mbed amọ akpon anyʌñ anie ubọọñ.<verse eid="ISA 42:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 42:22" />Ado mbon ami edo mbon se emaekewo ye mbon ekebịmeke mbịme,</para>
  <para style="q2" vid="ISA 42:22">etap afịd ammọ edọñ ke ube</para>
  <para style="q2" vid="ISA 42:22">imiidooho edịp ammọ ke ufọk ñkpakọb.</para>
  <para style="q1" vid="ISA 42:22">Ammọ ekappa mbon se emaekewo,</para>
  <para style="q2" vid="ISA 42:22">awo ibaaha adinyaaña ammọ;</para>
  <para style="q1" vid="ISA 42:22">enam ammọ ekappa mbịme,</para>
  <para style="q2" vid="ISA 42:22">ibaaha awo se ibo, “Nam ammọ etịmme enyọñ.”<verse eid="ISA 42:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="ISA 42:23" />Anie ke atu ndufo adiikpañ utọñ ikop,</para>
  <para style="q2" vid="ISA 42:23">me adinọ ñkpañutọñ ke ini amaadi?<verse eid="ISA 42:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 42:24" />Anie akesaana Yekọb anọ yak ado ñkpọ mbịme,</para>
  <para style="q2" vid="ISA 42:24">ye Isrel ñko yak ado ñkpọ ñwo?</para>
  <para style="q1" vid="ISA 42:24">Nte ikidooho <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 42:24">a-ndufo edueghe ato idiọọkñkpọ?</para>
  <para style="q1" vid="ISA 42:24">Sia ammọ inyịmmeke ikeene usʌñ amọ;</para>
  <para style="q2" vid="ISA 42:24">ammọ ikikponoke mbed amọ.<verse eid="ISA 42:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 42:25" />Ke ntoro anye amaaduọk ikañ iyadesịd afʌk ammọ,</para>
  <para style="q2" vid="ISA 42:25">afai ekọñ.</para>
  <para style="q1" vid="ISA 42:25">Anye afʌk ammọ ke edemeikañ, kpayeado ikinwañake ammọ;</para>
  <para style="q2" vid="ISA 42:25">anye amaata ammọ, ado ammọ ibenne isịn ke esịd.<verse eid="ISA 42:25" /></para>
  <chapter eid="ISA 42" />
  <chapter number="43" style="c" sid="ISA 43" />
  <para style="s1">Ukweeñe Andinyaaña Isrel</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 43:1" />Ado idahami, se <char style="nd">Abọọñ</char> atañ ado ami,</para>
  <para style="q2" vid="ISA 43:1">andikubot fiin, Yekọb,</para>
  <para style="q2" vid="ISA 43:1">andikubot fiin, Isrel:</para>
  <para style="q1" vid="ISA 43:1">“Kuufeghe ndịk, sia ami mmufak fiin;</para>
  <para style="q2" vid="ISA 43:1">ami mmukoot fiin ke anyịñ; afo ado ake mmi.<verse eid="ISA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 43:2" />Umausaña ke mme mmọọñ uboiyo,</para>
  <para style="q2" vid="ISA 43:2">ami ñyaaba ye afo;</para>
  <para style="q1" vid="ISA 43:2">umaunyʌñ usaña ke mme inyañ uboiyo,</para>
  <para style="q2" vid="ISA 43:2">ammọ iduukwọọkọ fiin iduọọk.</para>
  <para style="q1" vid="ISA 43:2">Afo umausaña ke ikañ uboiyo,</para>
  <para style="q2" vid="ISA 43:2">ikañ iduufọppọ fiin;</para>
  <para style="q2" vid="ISA 43:2">edemeikañ iduutaaha fiin.<verse eid="ISA 43:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 43:3" />Sia ami ndo <char style="nd">Abọọñ</char> Abasi mfo,</para>
  <para style="q2" vid="ISA 43:3">Adisana Abasi Isrel, Andunyaaña fiin;</para>
  <para style="q1" vid="ISA 43:3">ami mmenọ Iyib nte ufak mfo,</para>
  <para style="q2" vid="ISA 43:3">Kuus ye Seba ke itie mfo.<verse eid="ISA 43:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 43:4" />Sia afo adooho ñkpọuto ye ñkpọ ukpono ke iso mmi,</para>
  <para style="q2" vid="ISA 43:4">ñko sia adooho ami mmuma fiin,</para>
  <para style="q1" vid="ISA 43:4">ami ñyaaben mme awo ñkpuho ke itie mfo,</para>
  <para style="q2" vid="ISA 43:4">ñkpuho mme idịd ke itie uwem mfo.<verse eid="ISA 43:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 43:5" />Kuuyak idem unyeñ, sia ami mmọdo ye afo;</para>
  <para style="q2" vid="ISA 43:5">ami ñyaaben nditọ mfo nto usakkautịn ndi,</para>
  <para style="q2" vid="ISA 43:5">ñnyʌñ ukoono fiin nto usobutịn.<verse eid="ISA 43:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 43:6" />Ami ñyaadọkkọ adoro, ‘Saana ammọ yaak!’</para>
  <para style="q2" vid="ISA 43:6">ñnyʌñ ndọkkọ usuuk, ‘Kuumʌm ammọ ukama.’</para>
  <para style="q1" vid="ISA 43:6">Koono nditọ mmi ideen to anyan usʌñ di,</para>
  <para style="q2" vid="ISA 43:6">ye nditọ mmi ibaan to mme utịd ederimbod di;<verse eid="ISA 43:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 43:7" />afịd mbon se ekoot edian anyịñ mmi,</para>
  <para style="q2" vid="ISA 43:7">a-ami ñkebotto nnọ ubọọñ mmi,</para>
  <para style="q2" vid="ISA 43:7">mbon se ami ñkebot ñnyʌñ nnam.”<verse eid="ISA 43:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 43:8" />Dat mbon e-enieghe anyen ado edo nnan,</para>
  <para style="q2" vid="ISA 43:8">e-enieghe utọñ ado edo inan wuọ.<verse eid="ISA 43:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 43:9" />Afịd mme idịd ebono itie keed,</para>
  <para style="q2" vid="ISA 43:9">ndin afịd awo esoobo.</para>
  <para style="q1" vid="ISA 43:9">Anie ke atu mme abasi ammọ akeyaara ami anọ ammọ,</para>
  <para style="q2" vid="ISA 43:9">anyʌñ atañ inọ ñnyịn abaña ñkaan ñkpọ?</para>
  <para style="q1" vid="ISA 43:9">Yak ammọ eben ntiense ammọ edi ediwọt idiọọñọ ke ammọ emaenen,</para>
  <para style="q2" vid="ISA 43:9">nọ mbon mfen ekop enyʌñ ebo, “Ado akpanikọ.”<verse eid="ISA 43:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 43:10" />
    <char style="nd">Abọọñ</char> atañ ate “Ndufo edo ntiense mmi,</para>
  <para style="q2" vid="ISA 43:10">ye isʌñutom a-ami mmekke,</para>
  <para style="q1" vid="ISA 43:10">nọ ndufo ediọọñọ enyʌñ ennịm miin ke akpanikọ</para>
  <para style="q2" vid="ISA 43:10">enyʌñ ediọọñọ ke ami ndo anye.”</para>
  <para style="q1" vid="ISA 43:10">Ibaaha abasi mfen ekebotto mbemiso ami,</para>
  <para style="q2" vid="ISA 43:10">inyʌññọ idiibaba mfen ke aboiyoke ami.<verse eid="ISA 43:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 43:11" />Ami, kpa idem ami, ndo <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 43:11">amaaboiyo ke ami andinyaaña mfen ibaaha.<verse eid="ISA 43:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 43:12" />Ami mmeyaara ñnyʌñ ñnyaaña ñnyʌñ ntommo,</para>
  <para style="q2" vid="ISA 43:12">ami, idooho asen abasi ke atu ndufo.</para>
  <para style="q1" vid="ISA 43:12">
    <char style="nd">Abọọñ</char> atañ, “Ndufo edo mme ntiense ke ami ndo Abasi.”<verse eid="ISA 43:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="ISA 43:13" />Ke akpanikọ, tọọñọ ke usen edem ami ndo anye.</para>
  <para style="q1" vid="ISA 43:13">Ibaaha awo a-akemeke adifak nsio ke ubọk mmi.</para>
  <para style="q2" vid="ISA 43:13">Ami ñkpenam ñkpọ, anie awo ikeme adikpuho?<verse eid="ISA 43:13" /></para>
  <para style="s1">Mbọm Abasi ye Idiọọk Ido Isrel</para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 43:14" />Se <char style="nd">Abọọñ</char> atañ ado ami,</para>
  <para style="q2" vid="ISA 43:14">Andufak fiin, Adisana Abasi Isrel:</para>
  <para style="q1" vid="ISA 43:14">“Ke ntak mfo ñyaadọñ eka Babilọn,</para>
  <para style="q2" vid="ISA 43:14">enyʌñ ekoono afịd mbon Babilọn edi nte ifʌn,</para>
  <para style="q2" vid="ISA 43:14">ke mme nsʌñikañ a-ammọ ekekamake etañ idem.<verse eid="ISA 43:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 43:15" />Ami ndo <char style="nd">Abọọñ</char>, Adisana Abasi mfo,</para>
  <para style="q2" vid="ISA 43:15">Andibod Isrel, Adidem mfo.”<verse eid="ISA 43:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 43:16" />Se <char style="nd">Abọọñ</char> atañ ado ami,</para>
  <para style="q2" vid="ISA 43:16">anye a-akenamma usʌñ asakka ke ufọọd akpainyañ,</para>
  <para style="q2" vid="ISA 43:16">akpọusʌñ ke ikpọ mmọọñ,<verse eid="ISA 43:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 43:17" />a-akemuumọ mme sariọd ye mme enañmbakara asio,</para>
  <para style="q2" vid="ISA 43:17">mbon ekọñ ye mbon se isaña ye ammọ,</para>
  <para style="q1" vid="ISA 43:17">ammọ enyʌñ enaa do, tutu amama idiidakkake ida aba,</para>
  <para style="q2" vid="ISA 43:17">emaeniime, emaetre edisak nte afọñ utuenikañ:<verse eid="ISA 43:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 43:18" />“Fre mme ñkaan ñkpọ;</para>
  <para style="q2" vid="ISA 43:18">kuusịn esịd ke mme ñkpọ usen edem.<verse eid="ISA 43:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 43:19" />Se, ami nsʌk nnam ufa ñkpọ!</para>
  <para style="q2" vid="ISA 43:19">Idahami anye atịppe; ado nte afo ukịtte?</para>
  <para style="q1" vid="ISA 43:19">Ami nsʌk nsiak usʌñ ke anaan ikọd</para>
  <para style="q2" vid="ISA 43:19">ye mme idịm ke mbiara isọñ.<verse eid="ISA 43:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 43:20" />Ndiọi unam afai eñkpono miin,</para>
  <para style="q2" vid="ISA 43:20">mme ewaikọd ye ñkịdikịd,</para>
  <para style="q1" vid="ISA 43:20">sia ami mmenọ mmọọñ ke anaan,</para>
  <para style="q2" vid="ISA 43:20">ye mme idịm ke mbiara isọñ,</para>
  <para style="q1" vid="ISA 43:20">nọ enọ ikọd mmi mmọọñ, mme ndimek ikọd mmi,<verse eid="ISA 43:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="ISA 43:21" />mbon a-ami ñkebotto nnịm nnọ idem mmi</para>
  <para style="q2" vid="ISA 43:21">nọ ammọ ebʌk itooro mmi.<verse eid="ISA 43:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 43:22" />“Kpayeado afo uñkoodo miin, Yekọb,</para>
  <para style="q2" vid="ISA 43:22">afo ukpaaha mba umbaña miin, Isrel.<verse eid="ISA 43:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 43:23" />Afo ubenne edọñ unsọk miin nte ufọfọb uwa,</para>
  <para style="q2" vid="ISA 43:23">unyʌññọ uñkpono miin ye mme uwa mfo.</para>
  <para style="q1" vid="ISA 43:23">Ami ufʌnnọke fiin ye mme enọ mfịd,</para>
  <para style="q2" vid="ISA 43:23">ñnyʌññọ nnam insensi se ñyem nto ubọk mfo ukakak fiin.<verse eid="ISA 43:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 43:24" />Afo udeppe anemufịk eto kalamus ndomokeed unnọ miin,</para>
  <para style="q2" vid="ISA 43:24">unyʌññọ umbana miin idem uto mme akpọñ uwa mfo.</para>
  <para style="q1" vid="ISA 43:24">Ado afo amemfʌnnọ miin ye idiọọkñkpọ mfo,</para>
  <para style="q2" vid="ISA 43:24">anyʌñ anam esịd ambʌññọ miin abaña mme ndudue mfo.<verse eid="ISA 43:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="ISA 43:25" />“Ami, kpa ami, ndo anye a-akwokkoke</para>
  <para style="q2" vid="ISA 43:25">mme ndudue mfo, ke ntak mmi,</para>
  <para style="q2" vid="ISA 43:25">ñnyʌññọ ntoiyo ndiọiñkpọ mfo aba.<verse eid="ISA 43:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 43:26" />Maana ntoiyo miin mme usen edem,</para>
  <para style="q2" vid="ISA 43:26">yak ñnyịn idiana keed ifaaña ibaña ñkpọ ami;</para>
  <para style="q2" vid="ISA 43:26">tañ unana ndudue mfo ke ikpe ami.<verse eid="ISA 43:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 43:27" />Akpa ete mfo amaanam idiọọkñkpọ;</para>
  <para style="q2" vid="ISA 43:27">mbon se ami ñkedọñ yak edikpeep ndufo emaesọñ iwuod ye ami.<verse eid="ISA 43:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 43:28" />Ke ntoro ami mmaasuenne mme adaaha ke tembịd mfo;</para>
  <para style="q2" vid="ISA 43:28">ami mmaayaak Yekọb nnọ nsobo</para>
  <para style="q2" vid="ISA 43:28">ñnyʌñ ñyaak Isrel nnọ nte ñkpọ nsaha.<verse eid="ISA 43:28" /></para>
  <chapter eid="ISA 43" />
  <chapter number="44" style="c" sid="ISA 44" />
  <para style="s1">Isrel Adimek Ubon</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 44:1" />“Ado idahami kpañ utọñ, Yekọb, isʌñutom mmi,</para>
  <para style="q2" vid="ISA 44:1">Isrel, anye a-ami mmekke.<verse eid="ISA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 44:2" />Se <char style="nd">Abọọñ</char> atañ ado ami,</para>
  <para style="q2" vid="ISA 44:2">anye a-akunamma fiin, a-akubotto fiin asịn ke idịb,</para>
  <para style="q2" vid="ISA 44:2">a-anyʌññọ aduunyaaña fiin:</para>
  <para style="q1" vid="ISA 44:2">Yekọb, isʌñutom mmi, kuufeghe ndịk,</para>
  <para style="q2" vid="ISA 44:2">Yesurun,<note caller="+" style="f"><char style="fr" closed="false">44:2 </char><char style="fq" closed="false">Yesurun </char><char style="ft" closed="false">awuọñọ </char><char style="fqa" closed="false">andido andinen, </char><char style="ft" closed="false">a-adooho Isrel.</char></note> a-ami mmekke.<verse eid="ISA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 44:3" />Sia ami ñyaaduọk mmọọñ ke nsaad isọñ,</para>
  <para style="q2" vid="ISA 44:3">ye mme idịm ke nsaad isọñ;</para>
  <para style="q1" vid="ISA 44:3">ami ñyaanwañña Sịbidịd mmi ndot nditọ mfo ke idem,</para>
  <para style="q2" vid="ISA 44:3">ñnyʌñ nnọ ubon mfo adidiọñ mmi.<verse eid="ISA 44:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 44:4" />Ammọ eyaesaiya nte mbid ke nseghe ikọd,</para>
  <para style="q2" vid="ISA 44:4">nte ikpọ eto ke mben mme idịm e-efegheke.<verse eid="ISA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 44:5" />Usʌk eyaebo, ‘Ami ndo ake <char style="nd">Abọọñ</char>’;</para>
  <para style="q2" vid="ISA 44:5">usʌk eyaekoot anyịñ ammọ edian Yekọb;</para>
  <para style="q1" vid="ISA 44:5">usʌk ñko eyaewet ke ubọk ammọ, ‘Ake <char style="nd">Abọọñ</char>,’</para>
  <para style="q2" vid="ISA 44:5">enyʌñ edat Isrel nte anyịñ ammọ.<verse eid="ISA 44:5" /></para>
  <para style="s1">
    <char style="nd">Abọọñ</char>, Idooho Ubobod Ñkpọ</para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 44:6" />“Se <char style="nd">Abọọñ</char> atañ ado ami,</para>
  <para style="q2" vid="ISA 44:6">Adidem Isrel ye Andifak, <char style="nd">Abọọñ</char> Andikponñkan:</para>
  <para style="q1" vid="ISA 44:6">Ami ndo akpa, ami ñnyʌñ ndo akpatre;</para>
  <para style="q2" vid="ISA 44:6">amaaboiyo ke ami Abasi mfen ibaaha.<verse eid="ISA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 44:7" />Anie ndin aba nte ami? Yak anye aditañ mi.</para>
  <para style="q2" vid="ISA 44:7">Yak anye awuọ ada ke iso mmi anyʌñ atañ anwa-anwa</para>
  <para style="q1" vid="ISA 44:7">se itịppe tọọñọ ami ñkenọ ikọd mmi itie ke esed,</para>
  <para style="q2" vid="ISA 44:7">ye se idiidi ke ini iso,</para>
  <para style="q2" vid="ISA 44:7">ntoro, yak ammọ etañ se idiidi ke ini iso.<verse eid="ISA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 44:8" />Kuunyeñ idem, kuunyʌñ ufeghe ndịk.</para>
  <para style="q2" vid="ISA 44:8">Nte ami ñkitañña ikọ ami, ñkinyʌññọ nnọ uyio ami anyan ini koo?</para>
  <para style="q1" vid="ISA 44:8">Ndufo edo mme ntiense mmi. Nte Abasi mfen aba ke amaaboiyo ami?</para>
  <para style="q2" vid="ISA 44:8">Iyoo, ibaaha Itiad mfen; Ami ndiọọñọke ndomokeed.”<verse eid="ISA 44:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 44:9" />Afịd mbon se inam ubobodñkpọ idooho ñkpọ ndomokeed,</para>
  <para style="q2" vid="ISA 44:9">ndin mme ñkpọ se ammọ ebat ke ñkpọuto edo ikpu-ikpu.</para>
  <para style="q1" vid="ISA 44:9">Mbon se ikpitañ ikọ inọ ammọ edo nnan;</para>
  <para style="q2" vid="ISA 44:9">ammọ enana ifiọk, enyʌñ edia ndọk idem ammọ.<verse eid="ISA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 44:10" />Anie abot abasi me anam ubobodñkpọ,</para>
  <para style="q2" vid="ISA 44:10">i-imiinieghe udod ndomokeed?<verse eid="ISA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 44:11" />Mbon se inam ado eyaebọ asuenne;</para>
  <para style="q2" vid="ISA 44:11">utọ mme anam utomusọ ado edo ñkaña awo.</para>
  <para style="q1" vid="ISA 44:11">Yak afịd ammọ ediboho keed enyʌñ edat itie ammọ;</para>
  <para style="q2" vid="ISA 44:11">eyaenam ndịk ye abuud enam ammọ.<verse eid="ISA 44:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 44:12" />Anamutom ukwak aben ñkpọutom amọ,</para>
  <para style="q2" vid="ISA 44:12">anyʌñ akama anye anam ñkpọ ke ukañ;</para>
  <para style="q1" vid="ISA 44:12">anye akama mme ukọññkpọ anam ubobodñkpọ,</para>
  <para style="q2" vid="ISA 44:12">anye akama adudu ubọk amọ akaa iso abot anye.</para>
  <para style="q1" vid="ISA 44:12">Abiọọñ adọñ anye, udịd anyʌñ abọkkọ anye;</para>
  <para style="q2" vid="ISA 44:12">anye inwọññọ mmọọñ, inweek anyʌñ abọkkọ anye.<verse eid="ISA 44:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 44:13" />Akọñeto akama udʌk adomo,</para>
  <para style="q2" vid="ISA 44:13">anyʌñ akama etoñwed anịm idiọọñọ;</para>
  <para style="q1" vid="ISA 44:13">anye a-akama anuun atọọñọ utom,</para>
  <para style="q2" vid="ISA 44:13">anyʌñ akama mme kọmpas anịm idiọọñọ.</para>
  <para style="q1" vid="ISA 44:13">Anye abot anye ke mbid awo,</para>
  <para style="q2" vid="ISA 44:13">mbid awo ke afịd ubọọñ amọ,</para>
  <para style="q2" vid="ISA 44:13">nọ anye adʌñ ke ñwommo.<verse eid="ISA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 44:14" />Anye akpok mme sida,</para>
  <para style="q2" vid="ISA 44:14">imiikpemeke anye akeben saipres me afriyo.</para>
  <para style="q1" vid="ISA 44:14">Anye anam eto ado akọt ye mme eto mfen ke akai,</para>
  <para style="q2" vid="ISA 44:14">imiidooho anye atọ eto afịm, edịm anyʌñ anam anye akọt.<verse eid="ISA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 44:15" />Ekama anye ebara ikañ;</para>
  <para style="q2" vid="ISA 44:15">anye aben usʌk akama anam idem amọ afiop,</para>
  <para style="q2" vid="ISA 44:15">anye abara ikañ anyʌñ anam uyo.</para>
  <para style="q1" vid="ISA 44:15">Ado anye ñko anam abasi anyʌñ akpono anye;</para>
  <para style="q2" vid="ISA 44:15">anye anam ubobodñkpọ, anyʌñ atuak iwuod anọ anye.<verse eid="ISA 44:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 44:16" />Mbakka iba eto ke anye akama abara ikañ;</para>
  <para style="q2" vid="ISA 44:16">anye akama ado anam ndidia amọ,</para>
  <para style="q2" vid="ISA 44:16">anye afọp unam amọ anyʌñ adia ayʌkkọ.</para>
  <para style="q1" vid="ISA 44:16">Anye anyʌñ anam idem amọ afiop anyʌñ abo,</para>
  <para style="q2" vid="ISA 44:16">“Ah! Idem amfiop miin; ami mmekịt ikañ.”<verse eid="ISA 44:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 44:17" />Anye akama mbon se isʌhọ anam abasi, ubobodñkpọ amọ;</para>
  <para style="q2" vid="ISA 44:17">anye anyuuk iwuod anyʌñ akpono anye.</para>
  <para style="q1" vid="ISA 44:17">Anye abọñ akam anọ anye ate,</para>
  <para style="q2" vid="ISA 44:17">“Ñnyaaña miin! Afo ado abasi mmi!”<verse eid="ISA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 44:18" />Ammọ idiọọñọke ñkpọ ndomokeed, ammọ inieghe ifiọk ibaña ñkpọ ndomokeed;</para>
  <para style="q2" vid="ISA 44:18">e-eyọọñọ ammọ anyen mbaak ammọ edikịt usʌñ,</para>
  <para style="q2" vid="ISA 44:18">enyʌñ esiit ammọ esịd anam ammọ ikanna idiọọñọ ñkpọ.<verse eid="ISA 44:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 44:19" />Awo ndomokeed isuuhọ itie ikere,</para>
  <para style="q2" vid="ISA 44:19">ibaaha awo ndomokeed se inie ifiọk me eti iwuod adibo,</para>
  <para style="q1" vid="ISA 44:19">“Ami ñkekama mbakka amọ iba mbara ikañ;</para>
  <para style="q2" vid="ISA 44:19">ami mmaanyʌñ ñkama ukañ amọ nnam uyo,</para>
  <para style="q2" vid="ISA 44:19">ami mmaafọp unam ñnyʌñ nta.</para>
  <para style="q1" vid="ISA 44:19">Me ado se ñkpekama se isʌhọ nnam mbubiam ñkpọ?</para>
  <para style="q2" vid="ISA 44:19">Me ado se ami ñkpenyuuk iwuod nnọ ukpịd eto?”<verse eid="ISA 44:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 44:20" />Utọ awo ado adia ntọñ; awo ammiinịmme ke akpanikọ atịn anye usʌñ;</para>
  <para style="q2" vid="ISA 44:20">anye ikanna inyaaña idem amọ, inyʌññọ ikan ibo,</para>
  <para style="q2" vid="ISA 44:20">“Nte ñkpọ ami ke ubọk nnasia mmi idooho nsu?”<verse eid="ISA 44:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 44:21" />Yekọb, toiyo mme ñkpọ ami,</para>
  <para style="q2" vid="ISA 44:21">amaado afo, Isrel, afo ado isʌñutom mmi.</para>
  <para style="q1" vid="ISA 44:21">Ami ñkunam fiin, afo ado isʌñutom mmi;</para>
  <para style="q2" vid="ISA 44:21">Isrel, ami nduufreke fiin.<verse eid="ISA 44:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 44:22" />Ami mmekwọọk mme ndudue mfo mfep nte ntọñanyọñ,</para>
  <para style="q2" vid="ISA 44:22">ndiọiñkpọ mfo nte ntuhube ubakusen.</para>
  <para style="q1" vid="ISA 44:22">Tịmme ñkeene miin,</para>
  <para style="q2" vid="ISA 44:22">sia ami mmufak fiin.<verse eid="ISA 44:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="ISA 44:23" />Ikwọ ikwọ idaara, ndufo mme hefịn, sia <char style="nd">Abọọñ</char> a-anam ami;</para>
  <para style="q2" vid="ISA 44:23">ibọñ ke akpọsọñ uyio, ndufo mbon se iba ke esịd isọñ.</para>
  <para style="q1" vid="ISA 44:23">Ibomo ikwọ ikwọ, ndufo mme ikpọabod,</para>
  <para style="q2" vid="ISA 44:23">ndufo mme akai ye afịd eto ndufo,</para>
  <para style="q1" vid="ISA 44:23">sia <char style="nd">Abọọñ</char> a-afak Yekọb,</para>
  <para style="q2" vid="ISA 44:23">anye a-awọt ubọọñ amọ ke Isrel.<verse eid="ISA 44:23" /></para>
  <para style="s1">Eyaedʌñọ ke Yeruselem</para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 44:24" />Se <char style="nd">Abọọñ</char> abo ado ami,</para>
  <para style="q2" vid="ISA 44:24">Andufak fiin, a-akubotto fiin ke idịb:</para>
  <para style="b" vid="ISA 44:24" />
  <para style="q1" vid="ISA 44:24">Ami ndo <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 44:24">Andinam afịd ñkpọ,</para>
  <para style="q2" vid="ISA 44:24">a-anyannake afịd mme hefịn,</para>
  <para style="q2" vid="ISA 44:24">a-ntatta ederimbod ke idem mmi ikpọọñ,<verse eid="ISA 44:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 44:25" />anye a-abiada idiọọñọ mme nsu-nsu prọfed</para>
  <para style="q2" vid="ISA 44:25">ñnyʌñ nnam amọ ekappa useme,<verse eid="ISA 44:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 44:26" />anye a-anamma uyio nditọufọk amọ</para>
  <para style="q2" vid="ISA 44:26">anyʌñ anam mme utañunịm ikọ isʌñutom amọ ewuọ esu,</para>
  <para style="b" vid="ISA 44:26" />
  <para style="q1" vid="ISA 44:26">a-atañña abaña Yeruselem ate, eyaedʌñ ke anye,</para>
  <para style="q2" vid="ISA 44:26">atañ abaña mme abio Yuda ate, eyaemaana ebọp ammọ,</para>
  <para style="q2" vid="ISA 44:26">anyʌñ atañ abaña mme ñwuudo ammọ ate, ami ñyaamaana mbọp ammọ,<verse eid="ISA 44:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 44:27" />anye a-atañña ye utəño mmọọñ ate, sat,</para>
  <para style="q2" vid="ISA 44:27">ndin ami ñyaanam mme idịm ndufo esat,<verse eid="ISA 44:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 44:28" />anye a-atañña abaña Sairọs ate, anye ado akpemeedọñ mmi,</para>
  <para style="q2" vid="ISA 44:28">ayaanyʌñ anam afịd se ami nnem esịd mbaña;</para>
  <para style="q1" vid="ISA 44:28">anye ayaatañ abaña Yeruselem ate, yak emaana ebọp anye,</para>
  <para style="q2" vid="ISA 44:28">anyʌñ atañ abaña tembịd ate, yak esịn mme itiad idakisọñ amọ.<verse eid="ISA 44:28" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 44" />
  <chapter number="45" style="c" sid="ISA 45" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 45:1" />“Kop se <char style="nd">Abọọñ</char> atañ abaña awo a-anye ayette adan,</para>
  <para style="q2" vid="ISA 45:1">atañ anọ Sairọs, a-ami mmʌmmọ ubọk nnasia amọ</para>
  <para style="q1" vid="ISA 45:1">nọ asuuhọ mme idịd ke iso amọ</para>
  <para style="q2" vid="ISA 45:1">anyʌñ abọ ndidem ñkpọ ekọñ ammọ,</para>
  <para style="q1" vid="ISA 45:1">ate adibeere usʌñ anọ anye</para>
  <para style="q2" vid="ISA 45:1">mbaak edibet mme inuaatob:<verse eid="ISA 45:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 45:2" />Ami ñyaasaña iso unọ fiin</para>
  <para style="q2" vid="ISA 45:2">ñyaanyʌñ nsuan mme ikpọabod;</para>
  <para style="q1" vid="ISA 45:2">ami ñyaabʌñ mme inuaatob brọns,</para>
  <para style="q2" vid="ISA 45:2">ñnyʌñ ñkpok mme akọ ukwak.<verse eid="ISA 45:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 45:3" />Ami ñyaunọ fiin mme ndedịbe ñkpọuto,</para>
  <para style="q2" vid="ISA 45:3">imọ e-ebonoke ke ndedịbe itie,</para>
  <para style="q1" vid="ISA 45:3">nọ afo adiọọñọ ke ami ndo <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 45:3">Abasi Isrel, u-ukoodo fiin ke anyịñ.<verse eid="ISA 45:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 45:4" />Ke ntak Yekọb isʌñutom mmi,</para>
  <para style="q2" vid="ISA 45:4">ye Isrel adimek ikọd mmi,</para>
  <para style="q1" vid="ISA 45:4">ami ukoot fiin ke anyịñ</para>
  <para style="q2" vid="ISA 45:4">ñnyʌñ unọ fiin anyịñ ukpono,</para>
  <para style="q2" vid="ISA 45:4">akpesʌkado afo undiọọñọke miin.<verse eid="ISA 45:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 45:5" />Ami ndo <char style="nd">Abọọñ</char>, ndin mfen ibaaha;</para>
  <para style="q2" vid="ISA 45:5">amaaboiyo ami Abasi mfen ibaaha.</para>
  <para style="q1" vid="ISA 45:5">Ami ñyausọọñọ fiin idem,</para>
  <para style="q2" vid="ISA 45:5">akpesʌkado afo undiọọñọke miin,<verse eid="ISA 45:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 45:6" />nọ ato ke ntọọñọ usakka utịn</para>
  <para style="q2" vid="ISA 45:6">tutu awuọ itie a-anye asoppo</para>
  <para style="q1" vid="ISA 45:6">mme awo ediidiọọñọ ke ibaaha mfen ke aboiyoke ami.</para>
  <para style="q2" vid="ISA 45:6">Ami ndo <char style="nd">Abọọñ</char>, ndin mfen ibaaha.<verse eid="ISA 45:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 45:7" />Ami ñkenam unwana ñnyʌñ mbot ekịm,</para>
  <para style="q2" vid="ISA 45:7">Ami mben uforo ndi ñnyʌñ mbot nsobo;</para>
  <para style="q2" vid="ISA 45:7">Ami, <char style="nd">Abọọñ</char>, nnam afịd mme ñkpọ ami.<verse eid="ISA 45:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 45:8" />“Ndufo mme hefịn ke anyọñ, idep mbara adinenido mmi;</para>
  <para style="q2" vid="ISA 45:8">yak mme ntọñanyọñ enam anye adep asọiyọ isọñ.</para>
  <para style="q1" vid="ISA 45:8">Yak isọñ abeere yak atara,</para>
  <para style="q2" vid="ISA 45:8">yak adinyaaña atịppe awuọ adi,</para>
  <para style="q1" vid="ISA 45:8">yak adinenido afiọrọ ye anye;</para>
  <para style="q2" vid="ISA 45:8">Ami, <char style="nd">Abọọñ</char>, mbot anye.<verse eid="ISA 45:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 45:9" />“Adọdiọọk anọ mbon etọhọke ye Andibod ammọ,</para>
  <para style="q2" vid="ISA 45:9">mbon i-imiidooho ñkpọ ndomokeed ikan mme ako mbad</para>
  <para style="q2" vid="ISA 45:9">ke atu mme usiọñ ke isọñ.</para>
  <para style="q1" vid="ISA 45:9">Nte aduañ akeme adibo abodabañ,</para>
  <para style="q2" vid="ISA 45:9">‘Nsoo ke afo abot?’</para>
  <para style="q1" vid="ISA 45:9">Nte utom mfo akeme adibo,</para>
  <para style="q2" vid="ISA 45:9">‘Abodabañ inieghe ubọk’?<verse eid="ISA 45:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 45:10" />Adọdiọọk anọ awo a-abooho ete amọ,</para>
  <para style="q2" vid="ISA 45:10">‘Nsoo ke afo abon?’</para>
  <para style="q1" vid="ISA 45:10">me adibo eka amọ,</para>
  <para style="q2" vid="ISA 45:10">‘Nsoo ke afo aman?’<verse eid="ISA 45:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 45:11" />“Se <char style="nd">Abọọñ</char> atañ ado ami,</para>
  <para style="q2" vid="ISA 45:11">Adisana Abasi Isrel, ye Andibod anye:</para>
  <para style="q1" vid="ISA 45:11">Ke abaña mme ñkpọ se idi ke iso,</para>
  <para style="q2" vid="ISA 45:11">afo amekeme adimbịp miin ñkpọ mbaña nditọ mmi,</para>
  <para style="q2" vid="ISA 45:11">me adinnọ miin ewʌhọ mbaña utom ubọk mmi?<verse eid="ISA 45:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 45:12" />Ami ndo andikinam ederimbod</para>
  <para style="q2" vid="ISA 45:12">ñnyʌñ mbot awo ndọñ ke esịd.</para>
  <para style="q1" vid="ISA 45:12">Ubọk mmi ataat mme hefịn;</para>
  <para style="q2" vid="ISA 45:12">ami ñwuuk afịd udịm ammọ.<verse eid="ISA 45:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 45:13" />Ami ñyaadịppe Sairọs ñkama ke adinenido mmi:</para>
  <para style="q2" vid="ISA 45:13">Ami ñyaanam afịd usʌñ amọ anen.</para>
  <para style="q1" vid="ISA 45:13">Anye ayaamaana abọp abio mmi</para>
  <para style="q2" vid="ISA 45:13">anyʌñ anọ mme ntañmfeb ekọñ ñkpọkñyak,</para>
  <para style="q1" vid="ISA 45:13">ado idiidooho ke ekọmudua me ke utịb,</para>
  <para style="q2" vid="ISA 45:13">
    <char style="nd">Abọọñ</char> Andikponñkan atañ.”<verse eid="ISA 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 45:14" />Se <char style="nd">Abọọñ</char> atañ ado ami:</para>
  <para style="q1" vid="ISA 45:14">“Mme ñkpọ se enam ke Iyib ye mme ñkpọudua Kuus,</para>
  <para style="q2" vid="ISA 45:14">ye mme ñnyan Sabiin ado;</para>
  <para style="q1" vid="ISA 45:14">ammọ eyaedi ubịne fiin</para>
  <para style="q2" vid="ISA 45:14">enyʌñ edo ake mfo;</para>
  <para style="q1" vid="ISA 45:14">ammọ eyaesaña usʌk-usʌk ukeene fiin,</para>
  <para style="q2" vid="ISA 45:14">esaña ukeene fiin ye ñkpọnọ ke ukod ye ubọk.</para>
  <para style="q1" vid="ISA 45:14">Ammọ eyaenyuuk iwuod unọ fiin,</para>
  <para style="q2" vid="ISA 45:14">enyʌñ ukpe fiin ubọk, ete,</para>
  <para style="q1" vid="ISA 45:14">‘Ke akpanikọ Abasi mmọdo ye afo, ndin mfen ibaaha;</para>
  <para style="q2" vid="ISA 45:14">abasi mfen ibaaha.’ ”<verse eid="ISA 45:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 45:15" />Ke akpanikọ afo ado Abasi a-adịppedịp idem mfo,</para>
  <para style="q2" vid="ISA 45:15">Abasi ye Andinyaaña Isrel.<verse eid="ISA 45:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 45:16" />Afịd mbon se ibot mme ubobodñkpọ eyaekịt abuud ye asuenne;</para>
  <para style="q2" vid="ISA 45:16">ammọ eyaediana keed edia asuenne.<verse eid="ISA 45:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 45:17" />Ado <char style="nd">Abọọñ</char> ayaanyaaña Isrel</para>
  <para style="q2" vid="ISA 45:17">ye nsi-nsi adinyaaña;</para>
  <para style="q1" vid="ISA 45:17">afo uduukịtte abuud ye asuenne</para>
  <para style="q2" vid="ISA 45:17">ke afịd ayio ke nsi-nsi.<verse eid="ISA 45:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ISA 45:18" />Sia se <char style="nd">Abọọñ</char> atañ ado ami,</para>
  <para style="q1" vid="ISA 45:18">anye andikibot mme hefịn,</para>
  <para style="q2" vid="ISA 45:18">anye ado Abasi;</para>
  <para style="q1" vid="ISA 45:18">andikidiọñ ñnyʌñ nnam ederimbod,</para>
  <para style="q2" vid="ISA 45:18">anye aketọọñọ anye,</para>
  <para style="q1" vid="ISA 45:18">anye ikibotto anye ibo adina ukpọk,</para>
  <para style="q2" vid="ISA 45:18">ado akebot anye yak ado se edʌñ ke esịd,</para>
  <para style="q1" vid="ISA 45:18">anye ate:</para>
  <para style="q1" vid="ISA 45:18">“Ami ndo <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 45:18">ndin mfen ibaaha.<verse eid="ISA 45:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 45:19" />Ami ntañña ikọ ke ndịbe,</para>
  <para style="q2" vid="ISA 45:19">ñnyʌññọ ntañ nto isọñ ekịm;</para>
  <para style="q1" vid="ISA 45:19">ami mbooho ubon Yekọb,</para>
  <para style="q2" vid="ISA 45:19">‘Iñyem miin ke ikpu-ikpu.’</para>
  <para style="q1" vid="ISA 45:19">Ami, <char style="nd">Abọọñ</char>, ntañ akpanikọ;</para>
  <para style="q2" vid="ISA 45:19">ami ntañ se inen.<verse eid="ISA 45:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 45:20" />“Iboho itie keed inyʌñ ikọọk iwuod;</para>
  <para style="q2" vid="ISA 45:20">isoobo idem, ndufo mbon e-ebọkkọke ekọñ eto mme idịd.</para>
  <para style="q1" vid="ISA 45:20">Mbon se ikama usọsọi ñkpọ ke eto isaña enana ifiọk,</para>
  <para style="q2" vid="ISA 45:20">e-ebọññọ akam enọ mme abasi imiikanna inyaaña.<verse eid="ISA 45:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 45:21" />Itañ se ikpinaa nte aba, inyʌñ iben anye idi,</para>
  <para style="q2" vid="ISA 45:21">yak ammọ etie keed ekọọk iwuod.</para>
  <para style="q1" vid="ISA 45:21">Anie ikiyaara ñkpọ ami ke anyan ini koo,</para>
  <para style="q2" vid="ISA 45:21">anie ikitañ ñkpọ ami tọọñọ ke anyan usen edem?</para>
  <para style="q1" vid="ISA 45:21">Nte idooho ami, <char style="nd">Abọọñ</char>?</para>
  <para style="q2" vid="ISA 45:21">Ndin ibaaha Abasi mfen ke imiibọhọke ami,</para>
  <para style="q1" vid="ISA 45:21">adinen Abasi ye Andinyaaña;</para>
  <para style="q2" vid="ISA 45:21">ibaaha mfen ibọhọke ami.<verse eid="ISA 45:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 45:22" />“Iwọññọ iñkeene miin inyʌñ ibọ adinyaaña,</para>
  <para style="q2" vid="ISA 45:22">afịd ndufo utịd ederimbod;</para>
  <para style="q2" vid="ISA 45:22">sia ami ndo Abasi, ndin mfen ibaaha.<verse eid="ISA 45:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 45:23" />Ami mmetommo idem mmi ñnwọñọ,</para>
  <para style="q2" vid="ISA 45:23">inua mmi atañ ke idak afịd akpanikọ</para>
  <para style="q2" vid="ISA 45:23">ikọ a-awo imiidiikpəhoke:</para>
  <para style="q1" vid="ISA 45:23">Afịd edọñ eyaetọọñọ ennọ miin;</para>
  <para style="q2" vid="ISA 45:23">afịd edeme ediinwọñọ ke ami.<verse eid="ISA 45:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 45:24" />Ammọ eyaetañ embaña miin ete, ‘Ke <char style="nd">Abọọñ</char> ikpọọñ</para>
  <para style="q2" vid="ISA 45:24">ke enie ñkpọkñyak ye adudu.’ ”</para>
  <para style="q1" vid="ISA 45:24">Afịd mbon se ikinwana ye anye</para>
  <para style="q2" vid="ISA 45:24">eyaedi ebịne anye enyʌñ ekịt asuenne.<verse eid="ISA 45:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 45:25" />Ado afịd ubon Isrel</para>
  <para style="q2" vid="ISA 45:25">eyaebọ ñkpọkñyak ye unen eto <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 45:25">eyaenyʌñ ekama <char style="nd">Abọọñ</char> enam inua.<verse eid="ISA 45:25" /></para>
  <chapter eid="ISA 45" />
  <chapter number="46" style="c" sid="ISA 46" />
  <para style="s1">Mme Abasi Babilọn</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 46:1" />Bel anyuuk iwuod, Nebo asọiyọ ke ndaha amọ;</para>
  <para style="q2" vid="ISA 46:1">mme unam mbiomo ebiom mme ubobodñkpọ ammọ.</para>
  <para style="q1" vid="ISA 46:1">Mme ubobodñkpọ se ebiom ekanna edodoppo,</para>
  <para style="q2" vid="ISA 46:1">ado ekamba mbiomo anọ mbon e-ekpaaha mba.<verse eid="ISA 46:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 46:2" />Ammọ esuuk eda enyʌñ enyuuk iwuod itie keed;</para>
  <para style="q2" vid="ISA 46:2">ikanna ibiommo mbiomo ado,</para>
  <para style="q2" vid="ISA 46:2">ammọ ke idem ammọ edʌk ifʌn.<verse eid="ISA 46:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 46:3" />“Ikpañ utọñ innọ miin, ndufo nditọ Yekọb,</para>
  <para style="q2" vid="ISA 46:3">afịd nsʌhọ ubon Isrel,</para>
  <para style="q1" vid="ISA 46:3">ndufo mbon a-ami ñkemʌmmọ ñkama tọọñọ ke ini uman ndufo,</para>
  <para style="q2" vid="ISA 46:3">ñnyʌñ ñkama tọọñọ ke ini ndufo ekemanake.<verse eid="ISA 46:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 46:4" />Tutu ini usọñ ye ke iwuod iwad ndufo</para>
  <para style="q2" vid="ISA 46:4">ami ndo anye, ami ndo anye a-adiimʌm ndufo ikama.</para>
  <para style="q1" vid="ISA 46:4">Ami ñkibot ndufo, ami ñyaanyʌñ ikama ndufo;</para>
  <para style="q2" vid="ISA 46:4">ami ñyaikama ndufo, ami ñyaanyʌñ ifak ndufo.<verse eid="ISA 46:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 46:5" />“Ndufo edindat miin idomo ye anie, ediinyʌñ imbat miin ukem-ukem ye anie?</para>
  <para style="q2" vid="ISA 46:5">Anie ke ndufo ediiben idomo ye ami yak ese me ñnyịn ido ukem?<verse eid="ISA 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 46:6" />Usʌk enwañña kold eto ekpad ammọ,</para>
  <para style="q2" vid="ISA 46:6">enyʌñ edomo silfa ke udomoñkpọ;</para>
  <para style="q1" vid="ISA 46:6">ammọ ekpe anamusọ kold ete adikama abot abasi,</para>
  <para style="q2" vid="ISA 46:6">ammọ enyʌñ enyuuk iwuod ekpono anye.<verse eid="ISA 46:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 46:7" />Ammọ edịppe anye edot ke afara enyʌñ ebiom anye;</para>
  <para style="q2" vid="ISA 46:7">ammọ edịppe anye edot ke itie amọ, anye anyʌñ ada do.</para>
  <para style="q2" vid="ISA 46:7">Ke itie ado anye ikanna idakka.</para>
  <para style="q1" vid="ISA 46:7">Akọm awo atua anọ anye, anye ikanna ibọọrọ;</para>
  <para style="q2" vid="ISA 46:7">anye ikanna inyaaña ammọ isio ke mfịna ammọ.<verse eid="ISA 46:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 46:8" />“Itoiyo ami, isịn anye ke esịd,</para>
  <para style="q2" vid="ISA 46:8">itịm inịm anye ke akikere, ndufo mbon nsọñiwuod.<verse eid="ISA 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 46:9" />Itoiyo mme ñkaan ñkpọ, mme ñkpọ anyan ini koo;</para>
  <para style="q2" vid="ISA 46:9">ami ndo Abasi, ndin mfen ibaaha;</para>
  <para style="q2" vid="ISA 46:9">ami ndo Abasi, ndin mfen ibaaha nte ami.<verse eid="ISA 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 46:10" />Ami nnam ediọọñọ utịd eto ntọọñọ,</para>
  <para style="q2" vid="ISA 46:10">tọọñọ ke ini esed, se idiidi ke iso.</para>
  <para style="q1" vid="ISA 46:10">Ami mbo, ‘Uduak mmi ayaada,</para>
  <para style="q2" vid="ISA 46:10">ami ñko ñyaanam afịd se innem miin esịd.’<verse eid="ISA 46:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 46:11" />Ami mmekoot inuen afai nto edem usakkautịn;</para>
  <para style="q2" vid="ISA 46:11">nto anyan idịd, awodeen a-adiinam uduak mmi asu.</para>
  <para style="q1" vid="ISA 46:11">Se ami ntañ, kpa ado ke ami ndiinam yak asu;</para>
  <para style="q2" vid="ISA 46:11">se ami nduak, kpa ado ke ndiinam.<verse eid="ISA 46:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 46:12" />Ikpañ utọñ innọ miin, ndufo mbon isọñesịd,</para>
  <para style="q2" vid="ISA 46:12">ndufo e-edaaha anyan usʌñ ekpọñ adinenido mmi.<verse eid="ISA 46:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 46:13" />Ami nsʌk mben adinenido mmi ñkpere,</para>
  <para style="q2" vid="ISA 46:13">anye inyọọñọ usʌñ aba;</para>
  <para style="q2" vid="ISA 46:13">adinyaaña mmi idiikpeeneke aba.</para>
  <para style="q1" vid="ISA 46:13">Ami ñyaanyaaña Saiyọn,</para>
  <para style="q2" vid="ISA 46:13">ñnyʌñ nnọ Isrel mmọnyọ mmi.<verse eid="ISA 46:13" /></para>
  <chapter eid="ISA 46" />
  <chapter number="47" style="c" sid="ISA 47" />
  <para style="s1">Iduọ Babilọn</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 47:1" />“Sọiyọ kaa, tie ke abu,</para>
  <para style="q2" vid="ISA 47:1">Mboppo Ayịn Awonwaan Babilọn;</para>
  <para style="q1" vid="ISA 47:1">sọiyọ ke ebekpo tie ke isọñ,</para>
  <para style="q2" vid="ISA 47:1">ñwuọnda abio Babilọn.</para>
  <para style="q1" vid="ISA 47:1">Awo iduukoodo fiin aba</para>
  <para style="q2" vid="ISA 47:1">mmeme me ñkpʌk.<verse eid="ISA 47:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 47:2" />Kama itiad ukọkñkpọ kọk ndomuyo;</para>
  <para style="q2" vid="ISA 47:2">yaara ufʌkiso mfo.</para>
  <para style="q1" vid="ISA 47:2">Dịppe ñkịneisịn mfo, yak emọọnọ ñkpad mfo,</para>
  <para style="q2" vid="ISA 47:2">nyʌñ saña boiyo ke mme idịm.<verse eid="ISA 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 47:3" />Eyaewọt ifed mfo anwa-anwa</para>
  <para style="q2" vid="ISA 47:3">enyʌñ efʌkkọ abuud mfo.</para>
  <para style="q1" vid="ISA 47:3">Ami ñyaasio usiene;</para>
  <para style="q2" vid="ISA 47:3">ami ndiiyaaha awo ndomokeed.”<verse eid="ISA 47:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 47:4" />Andifak ñnyịn, <char style="nd">Abọọñ</char> Andikponñkan ado anyịñ amọ,</para>
  <para style="q2" vid="ISA 47:4">anye ado Adisana Abasi Isrel.<verse eid="ISA 47:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 47:5" />“Tie ke ndobuyio, dʌk kaa ke ekịm,</para>
  <para style="q2" vid="ISA 47:5">abio abọọñanwaan nditọ Babilọn;</para>
  <para style="q1" vid="ISA 47:5">awo iduukoodo fiin aba</para>
  <para style="q2" vid="ISA 47:5">abọọñanwaan mme abioubọọñ.<verse eid="ISA 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 47:6" />Ami mmaayat esịd ye ikọd mmi,</para>
  <para style="q2" vid="ISA 47:6">ñnyʌñ nsappa mme udeeme mmi;</para>
  <para style="q1" vid="ISA 47:6">ami mmaayaak ammọ ndọñ ke ubọk mfo,</para>
  <para style="q2" vid="ISA 47:6">ndin afo ukutuaha ammọ mbọm.</para>
  <para style="q1" vid="ISA 47:6">Kpa ye mme mbon e-emaesọñ ke emana,</para>
  <para style="q2" vid="ISA 47:6">afo amaadot ammọ ataa ndodoppo mbiomo.<verse eid="ISA 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 47:7" />Afo ate, ‘Ami ndo nsi-nsi,</para>
  <para style="q2" vid="ISA 47:7">nsi-nsi abọọñanwaan!’</para>
  <para style="q1" vid="ISA 47:7">Ado afo ukukereke mme ñkpọ ami,</para>
  <para style="q2" vid="ISA 47:7">unyʌññọ ukere ubaña se ikeme aditịppe.<verse eid="ISA 47:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 47:8" />“Idahami ndin, ikpañ utọñ, ndufo mbon e-emaaha udiauwem,</para>
  <para style="q2" vid="ISA 47:8">e-ebaaha ke itie ifuuro ndufo</para>
  <para style="q1" vid="ISA 47:8">ebo idem ndufo,</para>
  <para style="q2" vid="ISA 47:8">‘Ami mba, ndin ibaaha mfen ke imiibọhọke ami.</para>
  <para style="q1" vid="ISA 47:8">Ami ndiidooho ebekpa</para>
  <para style="q2" vid="ISA 47:8">ndiinyʌññọ mbọ ufen ñkpañña nditọ.’<verse eid="ISA 47:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 47:9" />Naña iba ami eyaubeghe fiin</para>
  <para style="q2" vid="ISA 47:9">ke etək ini, ke usen keed:</para>
  <para style="q2" vid="ISA 47:9">Ñkpañña nditọ ye ebekpa.</para>
  <para style="q1" vid="ISA 47:9">Ammọ eyaedi ubịne fiin nte ayọhọ utịb,</para>
  <para style="q2" vid="ISA 47:9">akpekọm idiọñ mfo</para>
  <para style="q2" vid="ISA 47:9">ye afịd ñkpọsọñ ibọk mfo ewak die.<verse eid="ISA 47:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 47:10" />Afo abuọt idem ke ndoom mfo</para>
  <para style="q2" vid="ISA 47:10">anyʌñ abo, ‘Awo ndomokeed iñkịtte miin.’</para>
  <para style="q1" vid="ISA 47:10">Aniọñ ye ifiọk mfo ubiaña fiin</para>
  <para style="q2" vid="ISA 47:10">ke ini afo abooho idem mfo,</para>
  <para style="q2" vid="ISA 47:10">‘Ami ikpọọñ mba, ibaaha mfen ke amaaboiyo ami.’<verse eid="ISA 47:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 47:11" />Nsobo ayaadi ubịne fiin,</para>
  <para style="q2" vid="ISA 47:11">afo uduudiọọñọke naña uduusuuk anye.</para>
  <para style="q1" vid="ISA 47:11">Unọmọ ayaukeene fiin</para>
  <para style="q2" vid="ISA 47:11">a-afo uduuduakka ikan ñyọọ ye ekọmudua;</para>
  <para style="q1" vid="ISA 47:11">afanekọñ a-afo uduukanna uda ukịt</para>
  <para style="q2" vid="ISA 47:11">ayaatịppe adiwad-adiwad unọ fiin.<verse eid="ISA 47:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 47:12" />“Kaa iso ndin ye ibọk mfo</para>
  <para style="q2" vid="ISA 47:12">ye uwak idiọñ mfo,</para>
  <para style="q2" vid="ISA 47:12">a-afo akesịnne idem tọọñọ ke uyịn mfo.</para>
  <para style="q1" vid="ISA 47:12">Akemeido ayaafọn ye afo,</para>
  <para style="q2" vid="ISA 47:12">akemeido ayaanam akpọsọñ ndịk aba.<verse eid="ISA 47:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 47:13" />Afịd mme item se afo abọọ enanam afo akpa mba!</para>
  <para style="q2" vid="ISA 47:13">Yak mme ase ikpaanyọñ mfo ewuọñọ edi,</para>
  <para style="q1" vid="ISA 47:13">mme ase ntantaafiọñ ntañ ñkpọntịppe kwa afiọñ,</para>
  <para style="q2" vid="ISA 47:13">yak ammọ unyaaña fiin esio ke se iyem aditịppe unọọ fiin.<verse eid="ISA 47:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 47:14" />Ke akpanikọ ammọ ebit ikpitok;</para>
  <para style="q2" vid="ISA 47:14">ikañ ayaata ammọ.</para>
  <para style="q1" vid="ISA 47:14">Ammọ ikemeke adinyaaña idem ammọ</para>
  <para style="q2" vid="ISA 47:14">ito adudu ikañ ado.</para>
  <para style="q1" vid="ISA 47:14">Ammọ idooho ukañ se ebara ewue;</para>
  <para style="q2" vid="ISA 47:14">anyem idooho ikañ se ebara etie ekpere.<verse eid="ISA 47:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 47:15" />Afịd se ammọ edo unọọ fiin edo ami,</para>
  <para style="q2" vid="ISA 47:15">mbon ami ado se afo anam ñkpọ abaña,</para>
  <para style="q2" vid="ISA 47:15">anyʌñ asịn idem tọọñọ ke uyịn mfo.</para>
  <para style="q1" vid="ISA 47:15">Afịd ammọ ekaiso ke ndudue ammọ;</para>
  <para style="q2" vid="ISA 47:15">ibaaha ndomokeed se ikeme aduunyaaña fiin.<verse eid="ISA 47:15" /></para>
  <chapter eid="ISA 47" />
  <chapter number="48" style="c" sid="ISA 48" />
  <para style="s1">Isrel Asọñiwuod</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 48:1" />“Ndufo ikpañ utọñ ikop anyem, ubon Yekọb,</para>
  <para style="q2" vid="ISA 48:1">ndufo e-ekoodo anyịñ edian Isrel</para>
  <para style="q2" vid="ISA 48:1">e-enyʌññọ eto ubon Yuda,</para>
  <para style="q1" vid="ISA 48:1">ndufo e-edatta mme unwọñọ ke anyịñ Abọọñ</para>
  <para style="q2" vid="ISA 48:1">e-enyʌññọ etommo Abasi Isrel;</para>
  <para style="q2" vid="ISA 48:1">ado idooho ke akpanikọ me ke adinenido,<verse eid="ISA 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 48:2" />ndufo e-ekoodo idem ndufo mme amanaisọñ adisana abio</para>
  <para style="q2" vid="ISA 48:2">e-enyʌññọ edot anyen ke Abasi Isrel,</para>
  <para style="q2" vid="ISA 48:2">Abọọñ Andikponñkan ado anyịñ amọ:<verse eid="ISA 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 48:3" />Ami mmaatañ mbaña ñkaan ñkpọ anyan ini koo,</para>
  <para style="q2" vid="ISA 48:3">inua mmi amaatañ mme ñkpọ ndin ami ñko mmaanam ediọọñọ mme ñkpọ ami;</para>
  <para style="q2" vid="ISA 48:3">ke adiyok ami mmaanam ñkpọ mbaña, ndin ammọ emaenyʌñ ewuọ esu.<verse eid="ISA 48:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 48:4" />Sia ami mmaadiọọñọ naña afo akesọñ iwuod aketre;</para>
  <para style="q2" vid="ISA 48:4">mme asịb itọñ mfo akedo ukwak,</para>
  <para style="q2" vid="ISA 48:4">ñko akpọiso mfo akedo brọns.<verse eid="ISA 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 48:5" />Ke ntoro ami mmaudọkkọ fiin mme ñkpọ ami anyan ini koo;</para>
  <para style="q2" vid="ISA 48:5">mbemiso ammọ etịppe ami mmaasian ammọ unọ fiin</para>
  <para style="q1" vid="ISA 48:5">mbaak afo uduukan ubo,</para>
  <para style="q2" vid="ISA 48:5">‘Mme ubobodñkpọ mmi ekenam ammọ esu;</para>
  <para style="q2" vid="ISA 48:5">ubobodñkpọ eto ye abasi ukwak mmi ekewuuk ammọ.’<verse eid="ISA 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 48:6" />Afo amekop mme ñkpọ ami; kanna anyen se afịd ammọ.</para>
  <para style="q2" vid="ISA 48:6">Nte afo uduunyịmmeke ammọ?</para>
  <para style="b" vid="ISA 48:6" />
  <para style="q1" vid="ISA 48:6">“Atọọñọ ke idahami kaa iso ami ñyaudọkkọ fiin mbaña mme ufa ñkpọ,</para>
  <para style="q2" vid="ISA 48:6">mme ndedịbe ñkpọ a-afo uduudiọọñọke.<verse eid="ISA 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 48:7" />Ebot ammọ idahami, idooho ke anyan ini;</para>
  <para style="q2" vid="ISA 48:7">ndufo ikoppo ibaña ammọ mbemiso mfịn ami.</para>
  <para style="q1" vid="ISA 48:7">Ke ntoro ndufo ikemeke adibo,</para>
  <para style="q2" vid="ISA 48:7">‘Ii, ami mmaadiọọñọ mbaña ammọ.’<verse eid="ISA 48:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 48:8" />Afo ukoppo, inyʌññọ unwaña;</para>
  <para style="q2" vid="ISA 48:8">tọọñọ ke esed utọñ mfo ikʌppọke.</para>
  <para style="q1" vid="ISA 48:8">Ami mmenekke ndiọọñọ mbaña naña afo aforo mforo;</para>
  <para style="q2" vid="ISA 48:8">ekuukoot fiin ayịn nsọñiwuod tọọñọ ke ini a-afo akemanake.<verse eid="ISA 48:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 48:9" />Ke ntak anyịñ mmi ami ñyaamaana nsịkke usen iyadesịd nnịm;</para>
  <para style="q2" vid="ISA 48:9">ke ntak itooro mmi ami mmemaana mmʌm anye ñkama ukpọñ fiin,</para>
  <para style="q2" vid="ISA 48:9">mbaak ami ndusobo fiin ataa afịd-afịd.<verse eid="ISA 48:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 48:10" />Se, ami mmunam fiin asana, ado idooho nte silfa;</para>
  <para style="q2" vid="ISA 48:10">ami mmudomo fiin ke akpọsọñ ikañ ndutʌhọ.<verse eid="ISA 48:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 48:11" />Ke ntak mmi, kpa ke ntak mmi, ami mmenam ami.</para>
  <para style="q2" vid="ISA 48:11">Ami ñkeme die adinam nọ esịn anyịñ mmi ke ndek?</para>
  <para style="q2" vid="ISA 48:11">Ami ndiiyaaha ubọọñ mmi nnọ awo mfen.<verse eid="ISA 48:11" /></para>
  <para style="s1">Ekpọk Isrel Eyaak</para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 48:12" />“Kpañ utọñ nnọ miin, Yekọb,</para>
  <para style="q2" vid="ISA 48:12">Isrel, a-ami ñkoodo:</para>
  <para style="q1" vid="ISA 48:12">ami ndo anye;</para>
  <para style="q2" vid="ISA 48:12">ami ndo akpa, ami ñnyʌñ ndo akpatre.<verse eid="ISA 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 48:13" />Ado ubọk mmi akenịm itiad idakisọñ ederimbod,</para>
  <para style="q2" vid="ISA 48:13">ubọk nnasia mmi ñko aketat mme hefịn;</para>
  <para style="q1" vid="ISA 48:13">ke ini ami ñkoodo ammọ,</para>
  <para style="q2" vid="ISA 48:13">afịd ammọ edakka eda akañ keed.<verse eid="ISA 48:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 48:14" />“Idiboho itie keed, afịd ndufo, inyʌñ ikpañ utọñ:</para>
  <para style="q2" vid="ISA 48:14">Akee ke atu ubobodñkpọ ami</para>
  <para style="q2" vid="ISA 48:14">ake idọkkọ ndufo mme ñkpọ ami?</para>
  <para style="q1" vid="ISA 48:14">Adimek nsaña Abọọñ</para>
  <para style="q2" vid="ISA 48:14">ayaanam uduak amọ abaña Babilọn.<verse eid="ISA 48:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 48:15" />Ami, kpa ami ke idem mmi, mmetañ;</para>
  <para style="q2" vid="ISA 48:15">ii, ami mmekoot anye.</para>
  <para style="q1" vid="ISA 48:15">Ami ñyaaben anye ndi,</para>
  <para style="q2" vid="ISA 48:15">anye ayaanyʌñ anam utom amọ mfọn-mfọn.<verse eid="ISA 48:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 48:16" />“Sịkke ñkpere miin nyʌñ kpañ utọñ kop ikọ ami:</para>
  <para style="q1" vid="ISA 48:16">“Tọọñọ ke akpa ntọd ami ntañña ikọ ke ndịbe;</para>
  <para style="q2" vid="ISA 48:16">ke ini anye atịppeke, ami mmọdo mba.”</para>
  <para style="b" vid="ISA 48:16" />
  <para style="q1" vid="ISA 48:16">Ndin idahami <char style="nd">Abọọñ</char> Andikara andọñ miin,</para>
  <para style="q2" vid="ISA 48:16">añyọhọke ye Sịbidịd amọ.<verse eid="ISA 48:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ISA 48:17" />Se <char style="nd">Abọọñ</char> atañ ado ami,</para>
  <para style="q2" vid="ISA 48:17">andufak fiin, Adisana Abasi Isrel:</para>
  <para style="q1" vid="ISA 48:17">“Ami ndo <char style="nd">Abọọñ</char> Abasi mfo,</para>
  <para style="q2" vid="ISA 48:17">u-ukpeebe fiin se ifọn ikan ye afo,</para>
  <para style="q2" vid="ISA 48:17">u-utemmeke fiin usʌñ se afo akeme adisaña.<verse eid="ISA 48:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 48:18" />Akpekapado afo amaakpañ utọñ anọ mme ewʌhọ mmi,</para>
  <para style="q2" vid="ISA 48:18">emem mfo akpeba nte inyañ,</para>
  <para style="q2" vid="ISA 48:18">mfọnọñkpọ mfo nte awawa atop ke akpainyañ.<verse eid="ISA 48:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 48:19" />Ubon mfo ekpekeba nte ntan isọñ,</para>
  <para style="q2" vid="ISA 48:19">nditọ mfo nte ananaibad ñkwa ntan;</para>
  <para style="q1" vid="ISA 48:19">awo ikpisọọhọke anyịñ ammọ isio,</para>
  <para style="q2" vid="ISA 48:19">awo ikpinyʌññọ isobo ammọ ke iso mmi.”<verse eid="ISA 48:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 48:20" />Idakka ikpọñ Babilọn,</para>
  <para style="q2" vid="ISA 48:20">ifeeñe ikpọñ mbon Babilọn!</para>
  <para style="q1" vid="ISA 48:20">Inọ etob ami ye ñkpo idaara</para>
  <para style="q2" vid="ISA 48:20">inyʌñ ikwọrọ anye.</para>
  <para style="q1" vid="ISA 48:20">Inọ anye aka mme utịd ederimbod;</para>
  <para style="q2" vid="ISA 48:20">bo, “<char style="nd">Abọọñ</char> afak isʌñutom amọ Yekọb.”<verse eid="ISA 48:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 48:21" />Ammọ ikikoppo nsaditọñ idaha anye akedatta ammọ usʌñ ke mme akpautatan;</para>
  <para style="q2" vid="ISA 48:21">anye amaanam mmọọñ awuọ ke itiad anọ ammọ;</para>
  <para style="q1" vid="ISA 48:21">anye amaasiak itiad,</para>
  <para style="q2" vid="ISA 48:21">ndin mmọọñ amaatop awuọ.<verse eid="ISA 48:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="ISA 48:22" />“Emem ibaaha inọ mbon ibak,” <char style="nd">Abọọñ</char> atañ.<verse eid="ISA 48:22" /></para>
  <chapter eid="ISA 48" />
  <chapter number="49" style="c" sid="ISA 49" />
  <para style="s1">Isʌñutom <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 49:1" />Ikpañ utọñ innọ miin, ndufo mme abio isu;</para>
  <para style="q2" vid="ISA 49:1">ikop ami, ndufo mme nsan-nsan idịd:</para>
  <para style="q1" vid="ISA 49:1">Mbemiso ami ñkemana <char style="nd">Abọọñ</char> amañkoot miin;</para>
  <para style="q2" vid="ISA 49:1">ke idịb eka mmi anye amaakoot anyịñ miin.<verse eid="ISA 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 49:2" />Anye anam inua mmi asọp nte akañkañ ebanna,</para>
  <para style="q2" vid="ISA 49:2">ke ndukpọñ ubọk amọ anye amandịp miin;</para>
  <para style="q1" vid="ISA 49:2">anye amaanam ami ñkappa mba nte idañ etʌkkọ nọ amọnọ,</para>
  <para style="q2" vid="ISA 49:2">amaanyʌñ andịp miin ke ekpad idañ amọ.<verse eid="ISA 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 49:3" />Anye amambo miin, “Afo ado isʌñutom mmi,</para>
  <para style="q2" vid="ISA 49:3">Isrel, a-ami ndiiwọt mmọnyọ mmi.”<verse eid="ISA 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 49:4" />Ado ami mmaabo, “Ami mmenam utom ke ikpu-ikpu;</para>
  <para style="q2" vid="ISA 49:4">ami mmesio inweek mmi nnọ ñkpọ i-imiibaaha ufọn ndomokeed.</para>
  <para style="q1" vid="ISA 49:4">Ado se ido ake mmi asịne ke ubọk <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 49:4">ndin utịb mmi aba ye Abasi mmi.”<verse eid="ISA 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 49:5" />Idahami <char style="nd">Abọọñ</char> ate,</para>
  <para style="q2" vid="ISA 49:5">anye akembotto miin ke idịb adidido isʌñutom amọ,</para>
  <para style="q1" vid="ISA 49:5">adiben Yekọb ntịmme nsọk anye,</para>
  <para style="q2" vid="ISA 49:5">ñnyʌñ ñkoono Isrel mbok nnọ idem amọ,</para>
  <para style="q1" vid="ISA 49:5">sia ami mmenie ukpono ke iso <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 49:5">ndin Abasi mmi ado adudu mmi,<verse eid="ISA 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 49:6" />anye ate:</para>
  <para style="q1" vid="ISA 49:6">“Ado ataa etək ñkpọ afo adido isʌñutom mmi</para>
  <para style="q2" vid="ISA 49:6">nọ adimaana adiọñ mme esiin Yekọb</para>
  <para style="q2" vid="ISA 49:6">anyʌñ aben mbon Isrel se ami ñkenịm anyọñ adi.</para>
  <para style="q1" vid="ISA 49:6">Ami ñyaunam fiin ado unwana anọ mme Gentile,</para>
  <para style="q2" vid="ISA 49:6">nọ adinyaaña mmi asịm utịd ederimbod.”<verse eid="ISA 49:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 49:7" />Se <char style="nd">Abọọñ</char> atañ ado ami,</para>
  <para style="q2" vid="ISA 49:7">Andifak ye Ukweeñe Adisana Abasi Isrel,</para>
  <para style="q1" vid="ISA 49:7">anye se afịd awo ese ke ndek ye anye a-mme idịd esuaha,</para>
  <para style="q2" vid="ISA 49:7">ayịnufọk mme mbọọñ:</para>
  <para style="q1" vid="ISA 49:7">“Ndidem eyaukịt fiin enyʌñ edakka eda,</para>
  <para style="q2" vid="ISA 49:7">mbọọñ eyaekịt enyʌñ esuuk iwuod,</para>
  <para style="q1" vid="ISA 49:7">ke ntak <char style="nd">Abọọñ</char>, anam akpanikọ,</para>
  <para style="q2" vid="ISA 49:7">Ukweeñe Adisana Abasi Isrel, u-umekke fiin.”<verse eid="ISA 49:7" /></para>
  <para style="s1">Adimaana Ndiọñ Isrel</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 49:8" />Se <char style="nd">Abọọñ</char> atañ ado ami:</para>
  <para style="q1" vid="ISA 49:8">“Ke ini mfọn mmi ami ñyaubọọrọ fiin,</para>
  <para style="q2" vid="ISA 49:8">ñko ke usen adinyaaña ami ñyaunwam fiin;</para>
  <para style="q1" vid="ISA 49:8">ami ñyaunịm fiin ñnyʌñ unam fiin</para>
  <para style="q2" vid="ISA 49:8">ado edioomo anọ ikọd mmi,</para>
  <para style="q1" vid="ISA 49:8">nọ aditịmme adiọñ isọñ</para>
  <para style="q2" vid="ISA 49:8">anyʌñ amaana adeeme mme mbiaña udeeme,<verse eid="ISA 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 49:9" />anyʌñ adibo mbon ñkpakọb, ‘Iwuọ idi,’</para>
  <para style="q2" vid="ISA 49:9">ye mbon e-ebaaha ke ekịm, ‘Ibọ ñkpọkñyak!’</para>
  <para style="b" vid="ISA 49:9" />
  <para style="q1" vid="ISA 49:9">“Ammọ eyaedia ñkpọ ke mben usʌñ,</para>
  <para style="q2" vid="ISA 49:9">enyʌñ ekịt nseghe mbid ke afịd ntəkabod amaakesaat.<verse eid="ISA 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 49:10" />Ammọ idiikoppo abiọọñ me nsaditọñ,</para>
  <para style="q2" vid="ISA 49:10">ufiob akpautatan idiifọppọ ammọ, ayio ñko idiimiaha ammọ.</para>
  <para style="q1" vid="ISA 49:10">Anye a-akoppo mbọm abaña ammọ ayaadat ammọ usʌñ,</para>
  <para style="q2" vid="ISA 49:10">anyʌñ adat ammọ aboiyo ke mben mmọọñ.<verse eid="ISA 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 49:11" />Ami ñyaanam afịd ikpọabod ekappa unaisọñ,</para>
  <para style="q2" vid="ISA 49:11">ndin eyaedịppe mme akpọusʌñ isañ mmi.<verse eid="ISA 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 49:12" />Se, ammọ eyaeto anyan itie edi,</para>
  <para style="q2" vid="ISA 49:12">usʌk eto adoro, usʌk eto usobutịn,</para>
  <para style="q2" vid="ISA 49:12">usʌk eto mme efaak Aswan.”<verse eid="ISA 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ISA 49:13" />Isio ñkpo idaara, ndufo mme hefịn;</para>
  <para style="q2" vid="ISA 49:13">idat esịd, ndufo isọñ;</para>
  <para style="q2" vid="ISA 49:13">ibịmme ikwọ ikwọ, ndufo ikpọabod!</para>
  <para style="q1" vid="ISA 49:13">Sia <char style="nd">Abọọñ</char> adọñ ikọd amọ esịd,</para>
  <para style="q2" vid="ISA 49:13">ayaanyʌñ akop mbọm abaña mbon amọ se iba ke ndutʌhọ.<verse eid="ISA 49:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 49:14" />Ado Saiyọn amaabo, “<char style="nd">Abọọñ</char> ansịn miin,</para>
  <para style="q2" vid="ISA 49:14">
    <char style="nd">Abọọñ</char> amfre miin anyen.”<verse eid="ISA 49:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 49:15" />“Nte eka akeme adifre ayịn a-anye anọọhọ eba</para>
  <para style="q2" vid="ISA 49:15">me aditre adikop mbọm mbaña ayịn a-anye amanna?</para>
  <para style="q1" vid="ISA 49:15">Akpesʌkado a-anye akemeke adifre,</para>
  <para style="q2" vid="ISA 49:15">ami nduufreke fiin!<verse eid="ISA 49:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 49:16" />Se, ami mmumịñ fiin ke esịd ekaubọk mmi;</para>
  <para style="q2" vid="ISA 49:16">mme ndibene mfo emba miin ke iso ke nsi-nsi.<verse eid="ISA 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 49:17" />Nditọ mfo esọp efeghe enyọñ edi,</para>
  <para style="q2" vid="ISA 49:17">ndin mbon se ikusobo fiin edakka ukpọñ fiin.<verse eid="ISA 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 49:18" />Dịppe anyen mfo ke anyọñ nyʌñ se kanna;</para>
  <para style="q2" vid="ISA 49:18">afịd nditọ mfo ukanna fiin ekʌk enyʌñ edi ubịne fiin.</para>
  <para style="q1" vid="ISA 49:18">Adaña nte ami nduuho uwem,” <char style="nd">Abọọñ</char> atañ,</para>
  <para style="q2" vid="ISA 49:18">“afo ayaasịne ammọ ke idem nte mme ñkpọ mbanaidem;</para>
  <para style="q2" vid="ISA 49:18">afo ayaasịne ammọ, nte anwaanndọ.<verse eid="ISA 49:18" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="ISA 49:19" />“Akpesʌkado emaubiat fiin enyʌñ enam afo ado ukpọk,</para>
  <para style="q2" vid="ISA 49:19">isọñ mfo anyʌñ anaa mbiara,</para>
  <para style="q1" vid="ISA 49:19">idahami afo ayaasịp abọhọ anọ mbon mfo,</para>
  <para style="q2" vid="ISA 49:19">ndin mbon ekutaaha fiin ediiba ke anyan usʌñ ukpọñ fiin.<verse eid="ISA 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 49:20" />Nditọ e-emanake ke ini mfʌhọ mfo</para>
  <para style="q2" vid="ISA 49:20">eyaesʌk etañ usịn fiin ke utọñ ete,</para>
  <para style="q1" vid="ISA 49:20">‘Itie ami asịp abọhọ inọ ñnyịn;</para>
  <para style="q2" vid="ISA 49:20">inọ ñnyịn itie amaanake akpon se ñnyịn idʌñ.’<verse eid="ISA 49:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 49:21" />Ndin afo ayaabo ke esịd mfo,</para>
  <para style="q2" vid="ISA 49:21">‘Anie akeman nditọ ami innọ miin?</para>
  <para style="q1" vid="ISA 49:21">Ami ñkeba ke mfʌhọ ñnyʌñ ndo ada;</para>
  <para style="q2" vid="ISA 49:21">ami ñkedo ntañmfeb ekọñ enyʌñ ensịn miin.</para>
  <para style="q2" vid="ISA 49:21">Anie awo akebọọk ibon ami?</para>
  <para style="q1" vid="ISA 49:21">Ami ñkedo ikpọọñ,</para>
  <para style="q2" vid="ISA 49:21">ado mbon ami, ammọ eto uke edi?’ ”<verse eid="ISA 49:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 49:22" />Se <char style="nd">Abọọñ</char> Andikara atañ ado ami:</para>
  <para style="q1" vid="ISA 49:22">“Se, ami ñyaasịn uyio ñkoot mme idịd,</para>
  <para style="q2" vid="ISA 49:22">ami ñyaadịppe afọñidiọọñọ mmi nnọ mme idịd;</para>
  <para style="q1" vid="ISA 49:22">ammọ eyaekama nditọ ideen mfo ke ubọk eben edi,</para>
  <para style="q2" vid="ISA 49:22">enyʌñ ekama nditọ ibaan mfo ke ifʌkkọ ammọ.<verse eid="ISA 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 49:23" />Ndidem ediido mme ete unọ fiin,</para>
  <para style="q2" vid="ISA 49:23">mme mbọọñibaan ammọ ediido mme adeb mfo.</para>
  <para style="q1" vid="ISA 49:23">Ammọ eyaenyuuk iwuod unọ fiin, enyʌñ ekʌp iso ammọ ke isọñ;</para>
  <para style="q2" vid="ISA 49:23">ammọ eyaenweem abu ke ñkpad mfo.</para>
  <para style="q1" vid="ISA 49:23">Ini ado ke afo uduudiọọñọ ke ami ndo <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="ISA 49:23">mbon e-enieghe idodanyen ke ami idiidiaha abuud.”<verse eid="ISA 49:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="ISA 49:24" />Nte ekeme edikoono mbịme nto mbon ekọñ,</para>
  <para style="q2" vid="ISA 49:24">me edifak mme ifʌn nsio ke ubọk mbon ñkpọsọñ?<verse eid="ISA 49:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 49:25" />Ado se <char style="nd">Abọọñ</char> atañ ado ami:</para>
  <para style="q1" vid="ISA 49:25">“Ii, eyaebọ mme ifʌn ke ubọk mbon ekọñ,</para>
  <para style="q2" vid="ISA 49:25">enyʌñ ebọ mbịme ke ubọk ñkpọsọñ awo;</para>
  <para style="q1" vid="ISA 49:25">ami ñyaanwana ye mbon se inwana ye afo,</para>
  <para style="q2" vid="ISA 49:25">ñko ami ñyaanyaaña nditọ mfo.<verse eid="ISA 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 49:26" />Ami ñyaanam mbon u-ufiighe fiin eta abʌkidem ammọ;</para>
  <para style="q2" vid="ISA 49:26">iyiib ammọ ayaakappa anaam ammọ nte ukọd.</para>
  <para style="q1" vid="ISA 49:26">Idaha ado ke afịd ubonawo ediidiọọñọ</para>
  <para style="q2" vid="ISA 49:26">ke ami, <char style="nd">Abọọñ</char>, ndo Andunyaaña fiin,</para>
  <para style="q2" vid="ISA 49:26">Andufak fiin, Akpọsọñ Abasi Yekọb.”<verse eid="ISA 49:26" /></para>
  <chapter eid="ISA 49" />
  <chapter number="50" style="c" sid="ISA 50" />
  <para style="s1">Idiọọkñkpọ Isrel ye Ñkobitem Ayịnufọk</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 50:1" />Se <char style="nd">Abọọñ</char> atañ ado ami:</para>
  <para style="q1" vid="ISA 50:1">“Mmọ ñwed uwuọndọ eka mfo</para>
  <para style="q2" vid="ISA 50:1">a-ami ñkebenne nsio anye ndọ?</para>
  <para style="q1" vid="ISA 50:1">Akee ke atu mbon isọn mmi</para>
  <para style="q2" vid="ISA 50:1">ke ami ñkunyam fiin nnọ?</para>
  <para style="q1" vid="ISA 50:1">Ke ntak idiọọkñkpọ ndufo emainyam ndufo;</para>
  <para style="q2" vid="ISA 50:1">ke ntak mbuka ido ndufo ke ekesio eka ndufo ndọ.<verse eid="ISA 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 50:2" />Ke ini ami ñkediighe, nsoo ikinam nọ awo ndomokeed imiikibaaha?</para>
  <para style="q2" vid="ISA 50:2">Ke ini ami ñkekoodo, nsoo ikinam awo ndomokeed ikibaaha se ibọọrọ?</para>
  <para style="q1" vid="ISA 50:2">Ado nte ubọk mmi akemooməho akan se ñkpunyaaña fiin?</para>
  <para style="q2" vid="ISA 50:2">Ado nte ami nnieghe adudu adufak fiin?</para>
  <para style="q1" vid="ISA 50:2">Ke ñkaña nduaiya ami mmaanam akpainyañ asat,</para>
  <para style="q2" vid="ISA 50:2">nnam mme inyañ ekappa akpautatan;</para>
  <para style="q1" vid="ISA 50:2">iyak ammọ ebʌttọ ke ntak unana mmọọñ,</para>
  <para style="q2" vid="ISA 50:2">enyʌñ ekpañña ke ntak nsaditọñ.<verse eid="ISA 50:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 50:3" />Ami ñkama ekịm mfʌk mme hefịn,</para>
  <para style="q2" vid="ISA 50:3">ñnyʌñ nnam afọñikpo ado ufʌkñkpọ ammọ.”<verse eid="ISA 50:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 50:4" />
    <char style="nd">Abọọñ</char> Andikara annọ miin asaña-asaña edeme se ñkama ñkpeep ñkpọ,</para>
  <para style="q2" vid="ISA 50:4">adidiọọñọ ikọ se ikeme adisọọñọ mbon e-ekpaaha mba.</para>
  <para style="q1" vid="ISA 50:4">Anye andemme miin kwa ubakusen,</para>
  <para style="q2" vid="ISA 50:4">ademme utọñ mmi yak ñkop nte awo e-enọọhọ item.<verse eid="ISA 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 50:5" />
    <char style="nd">Abọọñ</char> Andikara atat utọñ mmi;</para>
  <para style="q2" vid="ISA 50:5">ami ndooho awo nsọñiwuod,</para>
  <para style="q2" vid="ISA 50:5">ami ñkannake edem.<verse eid="ISA 50:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 50:6" />Ami mmaawọññọ edem mmi nnọ mbon se ikimmia miin,</para>
  <para style="q2" vid="ISA 50:6">ñwọññọ mbañ mmi nnọ mbon se ikiñwịppe ñwaebek;</para>
  <para style="q1" vid="ISA 50:6">ami ñkidịppe iso mmi</para>
  <para style="q2" vid="ISA 50:6">mbaña nsaha ye utọetab.<verse eid="ISA 50:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 50:7" />Sia <char style="nd">Abọọñ</char> Andikara añnwam miin,</para>
  <para style="q2" vid="ISA 50:7">awo idinsuenneke miin.</para>
  <para style="q1" vid="ISA 50:7">Ke ntoro ami mmenịm iso mmi nte itiad,</para>
  <para style="q2" vid="ISA 50:7">sia ami mmediọọñọ ke abuud idinnamma miin.<verse eid="ISA 50:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 50:8" />Andiñnyaaña miin akpere.</para>
  <para style="q2" vid="ISA 50:8">Anie awo idiiben ikpe imbịne miin?</para>
  <para style="q2" vid="ISA 50:8">Yak ñnyịn ida ise emọ-emọ!</para>
  <para style="q1" vid="ISA 50:8">Anie ado awo utọk mmi?</para>
  <para style="q2" vid="ISA 50:8">Yak anye adi ambịne miin!<verse eid="ISA 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 50:9" />
    <char style="nd">Abọọñ</char> Andikara ado andiiñnwam miin.</para>
  <para style="q2" vid="ISA 50:9">Anie adiisua innọ miin?</para>
  <para style="q1" vid="ISA 50:9">Afịd ammọ eyaewuọ anyen nte afọñ;</para>
  <para style="q2" vid="ISA 50:9">mme utañkpọ eyaeta ammọ esio.<verse eid="ISA 50:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 50:10" />Anie ke atu ndufo ibaak <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ISA 50:10">inyʌñ inam ikọ isʌñutom amọ?</para>
  <para style="q1" vid="ISA 50:10">Yak mbon se isaña ke ekịm,</para>
  <para style="q2" vid="ISA 50:10">i-imiinieghe ikañ,</para>
  <para style="q1" vid="ISA 50:10">ebuọt idem ke anyịñ <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ISA 50:10">enyʌñ ebet edem ke Abasi ammọ.<verse eid="ISA 50:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 50:11" />Ado idahami, afịd ndufo se idomo ikañ</para>
  <para style="q2" vid="ISA 50:11">enyʌñ enọ idem ndufo mme ikañ emuum,</para>
  <para style="q1" vid="ISA 50:11">ikaa ikisaña ke unwana ikañ ndufo</para>
  <para style="q2" vid="ISA 50:11">ye mme ikañ emuum a-ndufo eyịtte yak asak.</para>
  <para style="q1" vid="ISA 50:11">Se ndufo ediibọ ke ubọk mmi ado ami:</para>
  <para style="q2" vid="ISA 50:11">Ndufo eyaenaa ke ndutʌhọ.<verse eid="ISA 50:11" /></para>
  <chapter eid="ISA 50" />
  <chapter number="51" style="c" sid="ISA 51" />
  <para style="s1">Nsi-nsi Adinyaaña Saiyọn</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 51:1" />“Ikpañ utọñ innọ miin, ndufo e-ebịneke adinenido</para>
  <para style="q2" vid="ISA 51:1">ye mbon e-eyemme <char style="nd">Abọọñ</char>;</para>
  <para style="q1" vid="ISA 51:1">ise itiad e-ekekamake ikpịkke ndufo esio</para>
  <para style="q2" vid="ISA 51:1">ye ube itiad e-ekisiooho ndufo;<verse eid="ISA 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 51:2" />ise Ebraham, ete ndufo,</para>
  <para style="q2" vid="ISA 51:2">ye Sera, a-akimanna ndufo.</para>
  <para style="q1" vid="ISA 51:2">Ini ami ñkekoodo anye, anye akedo awo keed kpọd,</para>
  <para style="q2" vid="ISA 51:2">ndin ami mmaadiọñ anye, ñnyʌñ nnam anye ado uwak.<verse eid="ISA 51:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 51:3" />Ke akpanikọ <char style="nd">Abọọñ</char> ayaadọñ Saiyọn esịd,</para>
  <para style="q2" vid="ISA 51:3">ayaanyʌñ ase afịd ñwuudo amọ ye esịd mbọm;</para>
  <para style="q1" vid="ISA 51:3">anye ayaanam mme akpautatan ammọ ekappa eba nte Idịn,</para>
  <para style="q2" vid="ISA 51:3">mme ndoon ammọ eba nte inwañ <char style="nd">Abọọñ</char>.</para>
  <para style="q1" vid="ISA 51:3">Eyaekop inemesịd ye idaara ke esịd amọ,</para>
  <para style="q2" vid="ISA 51:3">enyʌñ enọ ekọọm ye uyioikwọ.<verse eid="ISA 51:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 51:4" />“Ikọd mmi, ikpañ utọñ innọ miin;</para>
  <para style="q2" vid="ISA 51:4">idịd mmi, ikop uyio mmi:</para>
  <para style="q1" vid="ISA 51:4">Ewʌhọ ayanto miin awuọ;</para>
  <para style="q2" vid="ISA 51:4">ukpe unen mmi ayaakappa ado unwana anọ mme idịd.<verse eid="ISA 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 51:5" />Adinenido mmi asaña akpere usọp-usọp,</para>
  <para style="q2" vid="ISA 51:5">adinyaaña mmi asʌk adi ke usʌñ,</para>
  <para style="q2" vid="ISA 51:5">ubọk mmi ayaaben ukpe unen asọk mme idịd.</para>
  <para style="q1" vid="ISA 51:5">Mbon isu eyaense miin</para>
  <para style="q2" vid="ISA 51:5">enyʌñ ebet ubọk mmi ye idodanyen.<verse eid="ISA 51:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 51:6" />Idịppe anyen ndufo ise mme hefịn,</para>
  <para style="q2" vid="ISA 51:6">ise idak isọñ;</para>
  <para style="q1" vid="ISA 51:6">mme hefịn eyaesop nte nsʌñikañ,</para>
  <para style="q2" vid="ISA 51:6">ederimbod ayaayeeme nte afọñ</para>
  <para style="q2" vid="ISA 51:6">mme andidʌñ ke anye eyaekpañña nte nsʌñ.</para>
  <para style="q1" vid="ISA 51:6">Ado adinyaaña mmi adiiba ke nsi-nsi,</para>
  <para style="q2" vid="ISA 51:6">adinenido mmi idiikpuhoke tutu amaama.<verse eid="ISA 51:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 51:7" />“Iñkop miin, ndufo e-ediọọñọke se inen,</para>
  <para style="q2" vid="ISA 51:7">ndufo e-ebenne item mmi esịn ke esịd ndufo:</para>
  <para style="q1" vid="ISA 51:7">Ikiifeghe ndọk ñkaña abʌkidem</para>
  <para style="q2" vid="ISA 51:7">me adikop ndịk mbaña mme usọñanyen ammọ.<verse eid="ISA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 51:8" />Sia utañkpọ ayaata ammọ nte afọñ;</para>
  <para style="q2" vid="ISA 51:8">utʌñ ayaata ammọ nte idededọñ.</para>
  <para style="q1" vid="ISA 51:8">Ado adinenido mmi ayaaba ke nsi-nsi,</para>
  <para style="q2" vid="ISA 51:8">adinyaaña mmi ayaaba ke afịd emana.”<verse eid="ISA 51:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 51:9" />Demme, demme, ubọk <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 51:9">sịn idem mfo afọñ adudu!</para>
  <para style="q1" vid="ISA 51:9">Demme, naña akenam ke mme usen edem,</para>
  <para style="q2" vid="ISA 51:9">nte ke mme emana esed.</para>
  <para style="q1" vid="ISA 51:9">Nte idooho afo akekpok Rahab mbai-mbai,</para>
  <para style="q2" vid="ISA 51:9">akenyʌñ akịm idiọọk unam?<verse eid="ISA 51:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 51:10" />Nte idooho afo akenam nọ inyañ asat,</para>
  <para style="q2" vid="ISA 51:10">mme ikpọ ntotəño mmọọñ,</para>
  <para style="q1" vid="ISA 51:10">akenamma usʌñ ke ufọọd akpainyañ</para>
  <para style="q2" vid="ISA 51:10">nọ mbon e-ekefakka ekeme isaña mboiyo?<verse eid="ISA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 51:11" />Mbon se <char style="nd">Abọọñ</char> afak eyaetịmme enyọñ edi.</para>
  <para style="q1" vid="ISA 51:11">Ammọ ediidʌk Saiyọn ye ikwọ;</para>
  <para style="q2" vid="ISA 51:11">nsi-nsi idaara adiido anyanya ke iwuod ammọ.</para>
  <para style="q1" vid="ISA 51:11">Inemesịd ye idaara eyaeboiyo ammọ iso,</para>
  <para style="q2" vid="ISA 51:11">ndin mfʌhọ ye nsiama eyaefeeñe ekaa anyan.<verse eid="ISA 51:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 51:12" />“Ami, ami ke idem mmi, ndo idọñesịd mfo.</para>
  <para style="q2" vid="ISA 51:12">Afo ado anie a-afegheke ñkaña awo,</para>
  <para style="q2" vid="ISA 51:12">ubon awo e-edooho ñkaña mbid,<verse eid="ISA 51:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 51:13" />yak afo afre <char style="nd">Abọọñ</char> Andubod fiin,</para>
  <para style="q2" vid="ISA 51:13">a-atatta mme hefịn,</para>
  <para style="q2" vid="ISA 51:13">a-anyʌññọ asịn itiad idakisọñ ederimbod,</para>
  <para style="q1" vid="ISA 51:13">yak afo adʌñ ke akpọsọñ ndịk afịd usen</para>
  <para style="q2" vid="ISA 51:13">ke ntak iyadesịd awo ufiik,</para>
  <para style="q2" vid="ISA 51:13">a-asọññọ ayịre ke nsobo?</para>
  <para style="q1" vid="ISA 51:13">Ndin mmọ anye iyadesịd afiikawo?<verse eid="ISA 51:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 51:14" />Mbon ñkpakọb e-enʌhọke ke ndịk eyaesọsọp ebọkkọ;</para>
  <para style="q1" vid="ISA 51:14">ammọ idiikpaaha ke ñkpakọb,</para>
  <para style="q2" vid="ISA 51:14">ammọ ñko idiinanake ndidia.<verse eid="ISA 51:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 51:15" />Sia ami ndo <char style="nd">Abọọñ</char> Abasi mfo,</para>
  <para style="q2" vid="ISA 51:15">a-adịppeke akpainyañ yak ayobio afịme,</para>
  <para style="q2" vid="ISA 51:15">
    <char style="nd">Abọọñ</char> Andikponñkan ado anyịñ mmi.<verse eid="ISA 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 51:16" />Ami mmesịn ikọ mmi ke inua mfo,</para>
  <para style="q2" vid="ISA 51:16">ñnyʌñ ufʌk fiin ke ndukpọñ ubọk mmi.</para>
  <para style="q1" vid="ISA 51:16">Ami añkenịmme mme hefịn ke itie ammọ,</para>
  <para style="q2" vid="ISA 51:16">añkesịnne itiad idakisọñ ederimbod,</para>
  <para style="q2" vid="ISA 51:16">añnyʌññọ mbo Saiyọn, ‘Ndufo edo ikọd mmi.’ ”<verse eid="ISA 51:16" /></para>
  <para style="s1">Kọọb Iyadesịd <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 51:17" />Demme, demme!</para>
  <para style="q2" vid="ISA 51:17">Dakka da, Yeruselem,</para>
  <para style="q1" vid="ISA 51:17">afo a-akenwọññọ mmọọñ ato ubọk <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ISA 51:17">kọọb iyadesịd amọ,</para>
  <para style="q1" vid="ISA 51:17">afo a-akenwọññọ tutu akweeñe ntak,</para>
  <para style="q2" vid="ISA 51:17">kpa iko a-anamma yak mme awo efịmme.<verse eid="ISA 51:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 51:18" />Ke atu afịd nditọ se anye akeman</para>
  <para style="q2" vid="ISA 51:18">ibaaha ndomokeed se ikidat anye usʌñ;</para>
  <para style="q1" vid="ISA 51:18">ke atu afịd nditọ se anye akebọọk</para>
  <para style="q2" vid="ISA 51:18">ibaaha ndomokeed se ikimʌm anye ubọk.<verse eid="ISA 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 51:19" />Mme afanekọñ ami edi ubịne fiin ñkemba,</para>
  <para style="q2" vid="ISA 51:19">anie akeme adudọñ fiin esịd?</para>
  <para style="q1" vid="ISA 51:19">Ñwuudo ye nsobo, akañ ye akañkañ,</para>
  <para style="q2" vid="ISA 51:19">anie akeme adudọñ fiin esịd?<verse eid="ISA 51:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 51:20" />Nditọ mfo e-esʌkkọ;</para>
  <para style="q2" vid="ISA 51:20">ammọ enaa ke afịd ikọkkọ efaak,</para>
  <para style="q2" vid="ISA 51:20">nte edob e-emʌmmọ ke afia.</para>
  <para style="q1" vid="ISA 51:20">Ammọ eyọhọ ye iyadesịd <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 51:20">ye ntʌnọ Abasi mfo.<verse eid="ISA 51:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ISA 51:21" />Ke ntoro kop ami, afo awo ukuud,</para>
  <para style="q2" vid="ISA 51:21">a-akoppo inaam, ado itooho ke ukọd.<verse eid="ISA 51:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 51:22" />Se <char style="nd">Abọọñ</char> Andikara mfo atañ ado ami,</para>
  <para style="q2" vid="ISA 51:22">Abasi mfo, a-akpemeke ikọd amọ:</para>
  <para style="q1" vid="ISA 51:22">“Se, ami mmesio kọọb a-akenamma afo afʌmmọ</para>
  <para style="q2" vid="ISA 51:22">ke ubọk mfo mfep;</para>
  <para style="q1" vid="ISA 51:22">afo uduunwọññọ aba iko iyadesịd mmi tutu amama,</para>
  <para style="q2" vid="ISA 51:22">ato kọọb ado.<verse eid="ISA 51:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 51:23" />Ami ñyaaben anye nsịn ke ubọk mbon se umia fiin ufen,</para>
  <para style="q2" vid="ISA 51:23">e-ekubooho fiin,</para>
  <para style="q2" vid="ISA 51:23">‘Duọ nyanna naa yak ñnyịn udọọk fiin isaña.’</para>
  <para style="q1" vid="ISA 51:23">Ndin afo amaanam edem mfo aba nte isọñ,</para>
  <para style="q2" vid="ISA 51:23">nte akpọusʌñ e-esañake.”<verse eid="ISA 51:23" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 51" />
  <chapter number="52" style="c" sid="ISA 52" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 52:1" />Saiyọn, demme, demme,</para>
  <para style="q2" vid="ISA 52:1">sịn idem mfo afọñ adudu!</para>
  <para style="q1" vid="ISA 52:1">Sịne mme mfọọn afọñ ubọọñ mfo,</para>
  <para style="q2" vid="ISA 52:1">Yeruselem, adisana abio.</para>
  <para style="q1" vid="ISA 52:1">Awo ake imiifọọrọke edʌd ye mbon e-emaesappa</para>
  <para style="q2" vid="ISA 52:1">idiidʌkkọ ke esịd mfo aba.<verse eid="ISA 52:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 52:2" />Keñ abu ke ñkpad mfo sio;</para>
  <para style="q2" vid="ISA 52:2">Yeruselem, dakka da ke anyọñ, tie ke ubọọñ.</para>
  <para style="q1" vid="ISA 52:2">Fak idem mfo sio ke mme akpọnọ ke itọñ mfo,</para>
  <para style="q2" vid="ISA 52:2">Ayịn awonwaan Saiyọn, a-adooho ifʌn idahami.<verse eid="ISA 52:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 52:3" />Sia se <char style="nd">Abọọñ</char> atañ ado ami:</para>
  <para style="q1" vid="ISA 52:3">“Ekunyam fiin ke ñkaña,</para>
  <para style="q2" vid="ISA 52:3">ñko eyaufak fiin, awo inyʌññọ iyem akʌk.”<verse eid="ISA 52:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 52:4" />Sia se <char style="nd">Abọọñ</char> Andikara atañ ado ami:</para>
  <para style="q1" vid="ISA 52:4">“Ke akpa ini, ikọd mmi emaekaa Iyib ekedʌñ;</para>
  <para style="q2" vid="ISA 52:4">ado idahami mbon Asiria efiik ammọ.<verse eid="ISA 52:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 52:5" />“Ndin idahami nsoo ke ami nnie mi?” <char style="nd">Abọọñ</char> atañ.</para>
  <para style="q1" vid="ISA 52:5">“Sia emaekoono ikọd mmi ke ñkaña,</para>
  <para style="q2" vid="ISA 52:5">ndin mbon se ikara ammọ enọ ammọ ndọk,”</para>
  <para style="q2" vid="ISA 52:5">
    <char style="nd">Abọọñ</char> atañ.</para>
  <para style="q1" vid="ISA 52:5">“Ndin afịd usen</para>
  <para style="q2" vid="ISA 52:5">eka iso esịn anyịñ mmi ke ndek.<verse eid="ISA 52:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 52:6" />Ke ntoro ikọd mmi eyaediọọñọ anyịñ mmi;</para>
  <para style="q2" vid="ISA 52:6">ke ntoro amaakem ke usen ado ammọ eyaediọọñọ</para>
  <para style="q1" vid="ISA 52:6">ke ado ami ñketañ ikọ ami.</para>
  <para style="q2" vid="ISA 52:6">Ii, ado ami.”<verse eid="ISA 52:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 52:7" />Ayaiya die ke mme anyọñ ikpọabod</para>
  <para style="q2" vid="ISA 52:7">ñkpad mbon e-ebenne nti etob edi,</para>
  <para style="q1" vid="ISA 52:7">anye a-akwọrọke emem,</para>
  <para style="q2" vid="ISA 52:7">anye a-abenne nti mbʌk adi,</para>
  <para style="q2" vid="ISA 52:7">anye a-akwọrọke adinyaaña,</para>
  <para style="q1" vid="ISA 52:7">anye a-abooho Saiyọn,</para>
  <para style="q2" vid="ISA 52:7">“Abasi mfo akaara!”<verse eid="ISA 52:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 52:8" />Ikpañ utọñ! Mbon ukpeme mfo edịppe uyio ammọ ke anyọñ.</para>
  <para style="q2" vid="ISA 52:8">Ke uyio keed ammọ esio ñkpo idaara.</para>
  <para style="q1" vid="ISA 52:8">Ke ini <char style="nd">Abọọñ</char> atịmmeke anyọñ Saiyọn,</para>
  <para style="q2" vid="ISA 52:8">ammọ eyaekịt ke anyen ammọ.<verse eid="ISA 52:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 52:9" />Ibịmme inyʌñ idiana keed ikwọ ikwọ idaara,</para>
  <para style="q2" vid="ISA 52:9">ndufo ñwuudo Yeruselem,</para>
  <para style="q1" vid="ISA 52:9">sia <char style="nd">Abọọñ</char> a-adọñ ikọd amọ esịd,</para>
  <para style="q2" vid="ISA 52:9">anye a-afak Yeruselem.<verse eid="ISA 52:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 52:10" />
    <char style="nd">Abọọñ</char> ayaatat adisana ubọk amọ</para>
  <para style="q2" vid="ISA 52:10">ke anyen afịd mme idịd,</para>
  <para style="q1" vid="ISA 52:10">ndin afịd mme utịd ederimbod eyaekịt</para>
  <para style="q2" vid="ISA 52:10">adinyaaña Abasi ñnyịn.<verse eid="ISA 52:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 52:11" />Iwuọñọ, iwuọñọ, iwuọñọ ikpọñ itie ado!</para>
  <para style="q2" vid="ISA 52:11">Ikiituuk ndedeghe ñkpọ ndomokeed!</para>
  <para style="q1" vid="ISA 52:11">Iwuọñọ ikpọñ anye inyʌñ isana,</para>
  <para style="q2" vid="ISA 52:11">ndufo e-ekamake mme ñkpoduoho ufọk <char style="nd">Abọọñ</char>.<verse eid="ISA 52:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 52:12" />Ado ndufo idiiwuọñọke itọk-itọk,</para>
  <para style="q2" vid="ISA 52:12">idiinyʌññọ ifefeññe iwuọñọ;</para>
  <para style="q1" vid="ISA 52:12">sia <char style="nd">Abọọñ</char> ayaibem ndufo asio,</para>
  <para style="q2" vid="ISA 52:12">Abasi Isrel ayaado ukpeme inọ ndufo ke edem.<verse eid="ISA 52:12" /></para>
  <para style="s1">Ufen ye Ubọọñ Ayịnufọk</para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 52:13" />Se, ayịnufọk mmi ayaanam ñkpọ ye aniọñ;</para>
  <para style="q2" vid="ISA 52:13">eyaeben anye enyʌñ edịppe anye ke anyọñ enyʌñ enọ anye ubọọñ.<verse eid="ISA 52:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 52:14" />Kpa naña idem akekpa uwak awo abaña anye;</para>
  <para style="q2" vid="ISA 52:14">emaenịm anye ndo a-akekpəhọke anye uduud akan aduuwem awo ndomokeed,</para>
  <para style="q2" vid="ISA 52:14">enyʌñ ebiat anye uyai ekan mbid awo;<verse eid="ISA 52:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 52:15" />anye ayaasiime uwak mme idịd,</para>
  <para style="q2" vid="ISA 52:15">ndidem eyaekʌp inua ammọ ke ntak amọ.</para>
  <para style="q1" vid="ISA 52:15">Sia se awo imiikidọkkọke ammọ, ammọ eyaekịt,</para>
  <para style="q2" vid="ISA 52:15">ñko se ammọ imiikikoppo, ammọ eyaediọọñọ.<verse eid="ISA 52:15" /></para>
  <para style="b" />
  <chapter eid="ISA 52" />
  <chapter number="53" style="c" sid="ISA 53" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 53:1" />Anie awo inịm mbʌk ñnyịn ke akpanikọ,</para>
  <para style="q2" vid="ISA 53:1">anie awo ke eyaara ubọk <char style="nd">Abọọñ</char> ewọt?<verse eid="ISA 53:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 53:2" />Anye akekọt ke iso amọ nte nsek emịne,</para>
  <para style="q2" vid="ISA 53:2">ye nte adʌñ a-atooho nsaad isọñ awuọ.</para>
  <para style="q1" vid="ISA 53:2">Anye ikinieghe uyai me ubọọñ akpenamma nọ ñnyịn ima anye,</para>
  <para style="q2" vid="ISA 53:2">ibaaha ñkpọ ke naña anye aba a-akpenamma nọ ñnyịn iyem anye.<verse eid="ISA 53:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 53:3" />Ubonawo emaese anye ke ndek enyʌñ esịn anye,</para>
  <para style="q2" vid="ISA 53:3">awo ufen, a-amegheke ye ubiak.</para>
  <para style="q1" vid="ISA 53:3">Nte awo se mbon awo edịp iso ammọ,</para>
  <para style="q2" vid="ISA 53:3">emaesịn anye ke ndek, ñnyịn ñko imainịm anye ke usuuhọ idaha.<verse eid="ISA 53:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 53:4" />Ke akpanikọ anye akebọ ubiak ñnyịn</para>
  <para style="q2" vid="ISA 53:4">amaana abọ ufen ñnyịn ñko,</para>
  <para style="q1" vid="ISA 53:4">ado ñnyịn ikidat nte ke Abasi akemia anye ufen,</para>
  <para style="q2" vid="ISA 53:4">amia anye, anyʌñ anọ anye ufen.<verse eid="ISA 53:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 53:5" />Ado ekekịm anye ke ntak ukwañido ñnyịn,</para>
  <para style="q2" vid="ISA 53:5">ekesọọk anye ke ntak ndiọiñkpọ ñnyịn;</para>
  <para style="q1" vid="ISA 53:5">ufen a-akebenne emem isọk ñnyịn akedoro anye ke idem,</para>
  <para style="q2" vid="ISA 53:5">ndin ato ke mme unan amọ ñnyịn ibọ edikọk.<verse eid="ISA 53:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 53:6" />Afịd ñnyịn, nte edọñ, imitịn usʌñ,</para>
  <para style="q2" vid="ISA 53:6">ñnyịn keedekeed imiwuọñọ ikeene usʌñ ñnyịn;</para>
  <para style="q1" vid="ISA 53:6">ndin <char style="nd">Abọọñ</char> adot anye</para>
  <para style="q2" vid="ISA 53:6">idiọọkñkpọ afịd ñnyịn.<verse eid="ISA 53:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 53:7" />Emaefiik anye enyʌñ ekuut anye,</para>
  <para style="q2" vid="ISA 53:7">kpayeado anye ikikʌppọke inua amọ;</para>
  <para style="q1" vid="ISA 53:7">emaeben anye nte ñyịn edọñ ekaa itie esiwotto unam,</para>
  <para style="q2" vid="ISA 53:7">ñko naña edọñ imiisisiooho uyio ke iso mbon se ikwaat anye ided,</para>
  <para style="q2" vid="ISA 53:7">kpa ntoro ñko anye ikikʌppọke inua amọ.<verse eid="ISA 53:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 53:8" />Ke ufiik ye ikpe ke ekeben anye esio.</para>
  <para style="q2" vid="ISA 53:8">Kpayeado, anie ke atu mbon amọ akefaaña?</para>
  <para style="q1" vid="ISA 53:8">Sia emaekpịkke anye esio ke isọñ mme aduuwem;</para>
  <para style="q2" vid="ISA 53:8">ekemia anye ufen ke ntak ndudue ikọd mmi.<verse eid="ISA 53:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 53:9" />Emaenọ anye udi ke atu mme ndiọi awo,</para>
  <para style="q2" vid="ISA 53:9">ye mme imọ awo ke ini ñkpa amọ,</para>
  <para style="q1" vid="ISA 53:9">akpesʌkado a-anye imiikinamma afai ndomokeed,</para>
  <para style="q2" vid="ISA 53:9">abiaña ndomokeed ikinyʌññọ iba ke inua amọ.<verse eid="ISA 53:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 53:10" />Kpayeado akedo uduak <char style="nd">Abọọñ</char> adisọnnọ anye ñnyʌñ nnam anye abọ ufen,</para>
  <para style="q2" vid="ISA 53:10">ñko akpesʌkado <char style="nd">Abọọñ</char> anamma uwem amọ ado enọ uwa ndudue ufak idiọọkñkpọ,</para>
  <para style="q1" vid="ISA 53:10">anye ayaakịt nditọnditọ amọ, ayaanyʌñ anam mme usen amọ akpeene,</para>
  <para style="q2" vid="ISA 53:10">ndin uduak <char style="nd">Abọọñ</char> ayaaseghe ke ubọk amọ.<verse eid="ISA 53:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 53:11" />Anye amaabọ ufen ama,</para>
  <para style="q2" vid="ISA 53:11">ayaakịt unwana uwem anyʌñ akop uyʌkkọ;</para>
  <para style="q1" vid="ISA 53:11">ato ke ifiọk amọ adinen ayịnufọk mmi ayaanam ikpe atoppo uwak awo,</para>
  <para style="q2" vid="ISA 53:11">anye ayaabiom mme idiọọkñkpọ ammọ.<verse eid="ISA 53:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 53:12" />Ke ntoro ami ñyaanọ anye itie ye mme awuọiso awo,</para>
  <para style="q2" vid="ISA 53:12">anye ayaadeeme mme mbịme ye mme ñkpọsọñ,</para>
  <para style="q1" vid="ISA 53:12">sia anye amaanwañña uwem amọ aduọk ke ñkpa,</para>
  <para style="q2" vid="ISA 53:12">emaenyʌñ ebat anye esịn ke atu mme anam idiọọkñkpọ.</para>
  <para style="q1" vid="ISA 53:12">Sia anye amaabiom idiọọkñkpọ uwak awo,</para>
  <para style="q2" vid="ISA 53:12">anyʌñ anam ñkpeubọk abaña mme anamidiọọk.<verse eid="ISA 53:12" /></para>
  <chapter eid="ISA 53" />
  <chapter number="54" style="c" sid="ISA 54" />
  <para style="s1">Ubọọñ Ini Iso Saiyọn</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 54:1" />“Kwọ, afo ada,</para>
  <para style="q2" vid="ISA 54:1">afo a-adooho kpaanam umanna ayịn;</para>
  <para style="q1" vid="ISA 54:1">bịmme sio kwọ, sio ñkpo idaara,</para>
  <para style="q2" vid="ISA 54:1">afo a-adooho akenam ubiak uman ituuhọ;</para>
  <para style="q1" vid="ISA 54:1">sia nditọ ikpọọñ awonwaan e-ewak</para>
  <para style="q2" vid="ISA 54:1">ekan nditọ anye a-adọọhọ ebe,”</para>
  <para style="q2" vid="ISA 54:1">
    <char style="nd">Abọọñ</char> atañ.<verse eid="ISA 54:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 54:2" />“Nam itie atayad mfo akpon,</para>
  <para style="q2" vid="ISA 54:2">tat mme afọñ ikpeghe atayad mfo nọ aka anyan,</para>
  <para style="q2" vid="ISA 54:2">Kuumʌm ukama;</para>
  <para style="q1" vid="ISA 54:2">dʌt udʌk mfo nọ anyọọñ,</para>
  <para style="q2" vid="ISA 54:2">sọọñọ mme mboi mfo.<verse eid="ISA 54:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 54:3" />Sia afo ayaatara aka nnasia ye ufiin;</para>
  <para style="q2" vid="ISA 54:3">mbon ubon mfo eyaebọ mme idịd mfen itie,</para>
  <para style="q2" vid="ISA 54:3">enyʌñ edʌñ ke mme ñwuudo abio ammọ.<verse eid="ISA 54:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 54:4" />“Kuufeghe ndịk; sia abuud iduunamma fiin.</para>
  <para style="q2" vid="ISA 54:4">Kuufeghe asuenne; awo iduusuenneke fiin.</para>
  <para style="q1" vid="ISA 54:4">Afo ayaafre asuenne uyịn mfo,</para>
  <para style="q2" vid="ISA 54:4">uduunyʌññọ utoiyo aba idiọọk itie ebekpa mfo.<verse eid="ISA 54:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 54:5" />Sia Andubod fiin ado ebe mfo,</para>
  <para style="q2" vid="ISA 54:5">
    <char style="nd">Abọọñ</char> Andikponñkan ado anyịñ amọ,</para>
  <para style="q1" vid="ISA 54:5">Adisana Abasi Isrel ado andufak fiin;</para>
  <para style="q2" vid="ISA 54:5">ekoot anye Abasi afịd ederimbod.<verse eid="ISA 54:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 54:6" />
    <char style="nd">Abọọñ</char> ayaamaana ukoot fiin adat</para>
  <para style="q2" vid="ISA 54:6">nte afo akedo anwaan ekesịnne, anyʌñ anie mbʌññọesịd ke sịbidịd;</para>
  <para style="q1" vid="ISA 54:6">anwaan akedọọhọ ndọ ke uyịn,</para>
  <para style="q2" vid="ISA 54:6">ado edisịn anye,” Abasi mfo atañ.<verse eid="ISA 54:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 54:7" />“Ke etək ini ami mmaukpọñ fiin,</para>
  <para style="q2" vid="ISA 54:7">ado ke akpọsọñ mbọm ñyaamaana uben fiin ntịmme ndi.<verse eid="ISA 54:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 54:8" />Ke adiwad iyadesịd</para>
  <para style="q2" vid="ISA 54:8">ami mmaudịp fiin iso mmi ke etək ini,</para>
  <para style="q1" vid="ISA 54:8">ado ke nsi-nsi mfọnido</para>
  <para style="q2" vid="ISA 54:8">ami ñyaakop mbọm ubaña fiin,”</para>
  <para style="q2" vid="ISA 54:8">
    <char style="nd">Abọọñ</char> Andufak fiin atañ.<verse eid="ISA 54:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 54:9" />“Anye ami aba nte ayio Nua annọ miin,</para>
  <para style="q2" vid="ISA 54:9">a-ami ñkenwọñọke ke mmọọñ Nua idiimaanake ifʌk ederimbod aba.</para>
  <para style="q1" vid="ISA 54:9">Ke ntoro idahami, ami mmenwọñọ ke ndiiyatta esịd aba ye afo,</para>
  <para style="q2" vid="ISA 54:9">ndiinyʌññọ nsua unọ fiin aba.<verse eid="ISA 54:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 54:10" />Akpesʌkado mme ikpọabod enyeeñeke,</para>
  <para style="q2" vid="ISA 54:10">enyʌñ ewʌkkọ mme ntəkabod,</para>
  <para style="q1" vid="ISA 54:10">ado nsi-nsi ima a-ami nnieghe unọọ fiin idiinyeeñeke,</para>
  <para style="q2" vid="ISA 54:10">edioomo emem mmi idiinyʌññọ isịkke,”</para>
  <para style="q2" vid="ISA 54:10">
    <char style="nd">Abọọñ</char>, a-anieghe mbọm ubaña fiin, atañ.<verse eid="ISA 54:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 54:11" />“Abio ukuud, a-ayobio atọọhọ, i-imiinyʌññọ ikop ndọñesịd,</para>
  <para style="q2" vid="ISA 54:11">ami ñyaamaana ñkama nsọñudua itiad ubọp fiin,</para>
  <para style="q2" vid="ISA 54:11">itiad idakisọñ mfo adiido lapis lasuli.<verse eid="ISA 54:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 54:12" />Ami ñyaakama rubi mbọp ndibene ñkanñkʌk ikpọ ufọk mfo,</para>
  <para style="q2" vid="ISA 54:12">ñnyʌñ mbọp mme inuaatob mfo ke nsem-nsem nsọñudua itiad,</para>
  <para style="q2" vid="ISA 54:12">ye afịd ndibene mfo ke nsọñudua itiad.<verse eid="ISA 54:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 54:13" />
    <char style="nd">Abọọñ</char> adiido andikpeeb afịd nditọ mfo,</para>
  <para style="q2" vid="ISA 54:13">ndin emem ammọ ayaakpon.<verse eid="ISA 54:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 54:14" />Adinenido aduunam fiin asọọñọ ada:</para>
  <para style="q1" vid="ISA 54:14">Ukaraufiik ayaakaa anyan usʌñ ukpọñ fiin;</para>
  <para style="q2" vid="ISA 54:14">afo uduunieghe ntak adifeghe ndịk.</para>
  <para style="q1" vid="ISA 54:14">Eyaesio akpọsọñ ndịk ukpọñ fiin;</para>
  <para style="q2" vid="ISA 54:14">anye iduukpereke fiin.<verse eid="ISA 54:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 54:15" />Awo ndomokeed akpedi ekọñ ye afo, idiidooho ami nnam;</para>
  <para style="q2" vid="ISA 54:15">awo akeedodo se idi ekọñ ye afo ayaasuuk iwuod anọ edikan mfo.<verse eid="ISA 54:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ISA 54:16" />“Se, ado ami ñkebot adomutịm</para>
  <para style="q2" vid="ISA 54:16">a-afịmme ukañ tutu anye abịppe asak,</para>
  <para style="q2" vid="ISA 54:16">anyʌñ nnam ñkpọekọñ a-adotto ye ubọkutom amọ.</para>
  <para style="q1" vid="ISA 54:16">Ado ami ñko ñkebot andibiad nọ anam ubi;<verse eid="ISA 54:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="ISA 54:17" />ñkpọekọñ ndomokeed e-edommo adikama ubiat fiin idiikịtte unen,</para>
  <para style="q2" vid="ISA 54:17">afo ñko ayaasua anọ afịd edeme u-udianna fiin ikọ.</para>
  <para style="q1" vid="ISA 54:17">Ami ado udeeme nditọufọk <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 54:17">ndin ami anyʌñ ado se itoppo ammọ ikpe ke iso mmi,”</para>
  <para style="q2" vid="ISA 54:17">
    <char style="nd">Abọọñ</char> atañ.<verse eid="ISA 54:17" /></para>
  <chapter eid="ISA 54" />
  <chapter number="55" style="c" sid="ISA 55" />
  <para style="s1">Ikood e-Enọọhọ Mbon Nsaditọñ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 55:1" />“Idi, afịd ndufo se itọñ asat,</para>
  <para style="q2" vid="ISA 55:1">idi ke mme mmọọñ;</para>
  <para style="q1" vid="ISA 55:1">ye ndufo i-imiinieghe akʌk,</para>
  <para style="q2" vid="ISA 55:1">idi, idep inyʌñ idia!</para>
  <para style="q1" vid="ISA 55:1">Idi, idep ukọd ye mmọọñeba,</para>
  <para style="q2" vid="ISA 55:1">idooho ke akʌk inyʌññọ ido ke ekọmudua.<verse eid="ISA 55:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 55:2" />Nsoo inam ndufo ebiat akʌk ke se imiidooho ndidia,</para>
  <para style="q2" vid="ISA 55:2">enyʌñ enam utom enọ se uyʌkkọ imiibaaha?</para>
  <para style="q1" vid="ISA 55:2">Ikpañ utọñ, ikpañ utọñ innọ miin, inyʌñ idia se ifọn,</para>
  <para style="q2" vid="ISA 55:2">afo ayaanem esịd abaña nti inie mfo.<verse eid="ISA 55:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 55:3" />Innọ miin utọñ inyʌñ idi imbịne miin;</para>
  <para style="q2" vid="ISA 55:3">ikpañ utọñ, nọ ndufo edu uwem.</para>
  <para style="q1" vid="ISA 55:3">Ami ñyaanam nsi-nsi edioomo ye ndufo,</para>
  <para style="q2" vid="ISA 55:3">ima akpanikọ a-ñkenwọñọke nnọ Defid.<verse eid="ISA 55:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 55:4" />Se, ami mmenam anye ado ntiense anọ mme idịd,</para>
  <para style="q2" vid="ISA 55:4">adaukara ye adaiso ekọñ anọ mme idịd.<verse eid="ISA 55:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 55:5" />Ke akpanikọ afo ayaakoot mme idịd a-afo umuudiọọñọke,</para>
  <para style="q2" vid="ISA 55:5">ñko mme idịd a-afo umuudiọọñọke eyaefeghe ubịne fiin,</para>
  <para style="q1" vid="ISA 55:5">ke ntak <char style="nd">Abọọñ</char> Abasi mfo,</para>
  <para style="q2" vid="ISA 55:5">Adisana Abasi Isrel,</para>
  <para style="q2" vid="ISA 55:5">sia anye unọ fiin mmọnyọ.”<verse eid="ISA 55:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 55:6" />Yem <char style="nd">Abọọñ</char> ke ini akemeke adikịt anye;</para>
  <para style="q2" vid="ISA 55:6">koot anye ke ini anye akpereke.<verse eid="ISA 55:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 55:7" />Yak mbon ibak ekpọñ usʌñ ammọ,</para>
  <para style="q2" vid="ISA 55:7">yak ndiọi awo ekpọñ akikere ammọ.</para>
  <para style="q1" vid="ISA 55:7">Yak ammọ ekanna ebịne <char style="nd">Abọọñ</char>, ndin anye ayaatua ammọ mbọm,</para>
  <para style="q2" vid="ISA 55:7">ye Abasi ñnyịn, sia anye ayaafeen ke afịd esịd.<verse eid="ISA 55:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 55:8" />“Sia akikere mmi idooho akikere ndufo,</para>
  <para style="q2" vid="ISA 55:8">mme usʌñ mmi inyʌññọ ido ake ndufo,”</para>
  <para style="q2" vid="ISA 55:8">
    <char style="nd">Abọọñ</char> atañ.<verse eid="ISA 55:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 55:9" />“Kpa naña mme hefịn enyọọñ ekan isọñ,</para>
  <para style="q2" vid="ISA 55:9">kpa ntoro ke mme usʌñ mmi enyọọñ ekan mme usʌñ ndufo,</para>
  <para style="q2" vid="ISA 55:9">mme akikere mmi enyʌñ enyọọñ ekan mme akikere ndufo.<verse eid="ISA 55:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 55:10" />Adaña nte edịm ye sino</para>
  <para style="q2" vid="ISA 55:10">etooho hefịn esọiyọ edi,</para>
  <para style="q1" vid="ISA 55:10">ado itịmmeke edem aba inyọñ do</para>
  <para style="q2" vid="ISA 55:10">ke imiiduọkkọ mmọọñ ke isọñ</para>
  <para style="q1" vid="ISA 55:10">inyʌñ inam mme ñkpọ etịppe enyʌñ ekọt efiọọrọ,</para>
  <para style="q2" vid="ISA 55:10">nọ enwịm mfịd enọ mme atọinwañ enyʌñ enọ mme awo ñkpọ ndidia,<verse eid="ISA 55:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 55:11" />kpa ntoro ke ado ye ikọ a-awuọhọ ke inua mmi:</para>
  <para style="q2" vid="ISA 55:11">anye idiitịmmeke idi imbịne miin ukpọk,</para>
  <para style="q1" vid="ISA 55:11">ado ayaanam se ami nduak,</para>
  <para style="q2" vid="ISA 55:11">anyʌñ anam uduak ami ñkedọññọ anye yak anam.<verse eid="ISA 55:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 55:12" />Afo ayaawuọ ke idaara,</para>
  <para style="q2" vid="ISA 55:12">enyʌñ udat fiin usʌñ ke emem;</para>
  <para style="q1" vid="ISA 55:12">mme ikpọabod ye ntəkabod</para>
  <para style="q2" vid="ISA 55:12">eyaebịmme ke ikwọ ke iso mfo,</para>
  <para style="q1" vid="ISA 55:12">ye afịd mme eto ke inwañ</para>
  <para style="q2" vid="ISA 55:12">eyaemia ubọk ammọ.<verse eid="ISA 55:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 55:13" />Utu ke ikọd ñkukịm, yunipa ayaatịppe,</para>
  <para style="q2" vid="ISA 55:13">ñko utu ke ntan, meetel ayaatịppe.</para>
  <para style="q1" vid="ISA 55:13">Anyem adiido nọ ato do esuan etob <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 55:13">ke nsi-nsi idiọọñọ,</para>
  <para style="q2" vid="ISA 55:13">a-adiiba ke nsi-nsi.”<verse eid="ISA 55:13" /></para>
  <chapter eid="ISA 55" />
  <chapter number="56" style="c" sid="ISA 56" />
  <para style="s1">Adinyaaña Mbon Mfen</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 56:1" />Se <char style="nd">Abọọñ</char> atañ ado ami:</para>
  <para style="q1" vid="ISA 56:1">“Tịm unenikpe kama</para>
  <para style="q2" vid="ISA 56:1">nyʌñ nam se ifọn,</para>
  <para style="q1" vid="ISA 56:1">sia adinyaaña mmi akpere,</para>
  <para style="q2" vid="ISA 56:1">ndin adinenido mmi ayaasọp ayaara.<verse eid="ISA 56:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 56:2" />Afọfọn anọ awo a-anamma ami,</para>
  <para style="q2" vid="ISA 56:2">awo a-anekkeke amʌm anye akama,</para>
  <para style="q1" vid="ISA 56:2">a-anekkeke anịm Sabad, inyʌññọ isappa anye,</para>
  <para style="q2" vid="ISA 56:2">anyʌñ asiooño ubọk akpọñ adinam idiọọk.”<verse eid="ISA 56:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 56:3" />Ke adidʌñ ndomokeed a-adianna idem ye <char style="nd">Abọọñ</char> abo,</para>
  <para style="q2" vid="ISA 56:3">“Ke akpanikọ <char style="nd">Abọọñ</char> ayansio miin ke atu ikọd amọ afep.”</para>
  <para style="q1" vid="ISA 56:3">Ndin ke itọ ndomokeed abo,</para>
  <para style="q2" vid="ISA 56:3">“Ami ndo sʌk nsaad eto.”<verse eid="ISA 56:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 56:4" />Sia se <char style="nd">Abọọñ</char> atañ ado ami:</para>
  <para style="q1" vid="ISA 56:4">“Amaado mme itọ e-enịmme mme Sabad mmi,</para>
  <para style="q2" vid="ISA 56:4">e-emekke se innem miin esịd,</para>
  <para style="q2" vid="ISA 56:4">enyʌñ esọọñọ emʌm edioomo mmi ekama,<verse eid="ISA 56:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 56:5" />ke esịd tembịd mmi ye mme ndibene amọ, ami ñyaanọ ammọ</para>
  <para style="q2" vid="ISA 56:5">ñkpọ aditoiyo ye anyịñ</para>
  <para style="q2" vid="ISA 56:5">a-afọnnọ akan nditọ ideen ye ibaan;</para>
  <para style="q1" vid="ISA 56:5">ami ñyaanọ ammọ nsi-nsi anyịñ</para>
  <para style="q2" vid="ISA 56:5">a-adiiba ke nsi-nsi.<verse eid="ISA 56:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 56:6" />Ye mme adidʌñ e-edianna idem ye <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ISA 56:6">ke adinam ñkpọ nnọ anye,</para>
  <para style="q1" vid="ISA 56:6">adima anyịñ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 56:6">ñnyʌñ ndo nditọufọk amọ,</para>
  <para style="q1" vid="ISA 56:6">afịd mbon e-enịmme Sabad inyʌññọ isappa anye,</para>
  <para style="q2" vid="ISA 56:6">e-enyʌññọ esọọñọ emʌm edioomo mmi ekama;<verse eid="ISA 56:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 56:7" />mbon ami ke ami ndiidat ñka ke adisana ekamba abod mmi,</para>
  <para style="q2" vid="ISA 56:7">ñnyʌñ nnọ ammọ inemesịd ke ufọk ubọñ akam mmi.</para>
  <para style="q1" vid="ISA 56:7">Ñyaabọ mme ufọfọb uwa ye mme uwa enọ ammọ</para>
  <para style="q2" vid="ISA 56:7">ke akpokoro uwa mmi;</para>
  <para style="q1" vid="ISA 56:7">sia eyaekoot ufọk mmi</para>
  <para style="q2" vid="ISA 56:7">ufọk ubọñ akam afịd mme idịd.”<verse eid="ISA 56:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 56:8" />
    <char style="nd">Abọọñ</char> Andikara abo,</para>
  <para style="q2" vid="ISA 56:8">anye a-atañña nditọ Isrel e-ekekoonoke esio atịme adi:</para>
  <para style="q1" vid="ISA 56:8">“Ami ñyaanyʌñ ñkoono mbon mfen nnịm nnọ ammọ</para>
  <para style="q2" vid="ISA 56:8">ke amaaboiyo mbon e-emaeketatañ edi.”<verse eid="ISA 56:8" /></para>
  <para style="s1">Abasi Asua Anọ Mbon Ibak</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 56:9" />Idi, afịd ndufo mme unam ke inwañ,</para>
  <para style="q2" vid="ISA 56:9">idi inyʌñ idita, afịd ndufo mme unam ke akai!<verse eid="ISA 56:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 56:10" />Mbon ekpemeke Isrel edo nnan,</para>
  <para style="q2" vid="ISA 56:10">afịd ammọ enana ifiọk,</para>
  <para style="q1" vid="ISA 56:10">afịd ammọ edo idob ewa,</para>
  <para style="q2" vid="ISA 56:10">ammọ ikanna ikpọi;</para>
  <para style="q1" vid="ISA 56:10">ammọ esuuk enaa enyʌñ edappa ndab,</para>
  <para style="q2" vid="ISA 56:10">ammọ ema adidaiya idab.<verse eid="ISA 56:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 56:11" />Ammọ edo mme ewa e-enieghe akpọsọñ udọñ adidia ndidia;</para>
  <para style="q2" vid="ISA 56:11">kpaanam ammọ ikoppo uyʌkkọ.</para>
  <para style="q1" vid="ISA 56:11">Ammọ edo mme akpemeedọñ i-imiinieghe ikike,</para>
  <para style="q2" vid="ISA 56:11">afịd ammọ ewọññọ ekeene usʌñ ammọ,</para>
  <para style="q2" vid="ISA 56:11">ammọ eyem ufọn idem ammọ.<verse eid="ISA 56:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 56:12" />Ammọ keedekeed ebo, “Idi, yak ami mben ukọd ndi!</para>
  <para style="q2" vid="ISA 56:12">Yak ñnyịn inwọñ bie tutu ikop uyʌkkọ!</para>
  <para style="q1" vid="ISA 56:12">Ndin ñkpọñ adiiba nte mfịn,</para>
  <para style="q2" vid="ISA 56:12">imiidooho anye anenekke afọn akan.”<verse eid="ISA 56:12" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 56" />
  <chapter number="57" style="c" sid="ISA 57" />
  <para style="q1">
    <verse number="1" style="v" sid="ISA 57:1" />Nti awo etak,</para>
  <para style="q2" vid="ISA 57:1">ndin ibegheke awo ndomokeed;</para>
  <para style="q1" vid="ISA 57:1">e-ekoono mme anam akpanikọ esio,</para>
  <para style="q2" vid="ISA 57:1">ndin inwañake awo ndomokeed</para>
  <para style="q1" vid="ISA 57:1">ibo ke ekoono mme ndinen awo edọọk</para>
  <para style="q2" vid="ISA 57:1">mbaak ammọ edikeene ewana ke idiọọk.<verse eid="ISA 57:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 57:2" />Mbon e-esañake nnen-nnen</para>
  <para style="q2" vid="ISA 57:2">edʌk ke emem;</para>
  <para style="q2" vid="ISA 57:2">e-ebọ nduọk adudu ke ñkpa ammọ.<verse eid="ISA 57:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 57:3" />“Ado amaado ndufo, idi mi, ndufo nditọ abiaidiọñ,</para>
  <para style="q2" vid="ISA 57:3">ndufo nditọ mme asịn efịbe ye mme akpara!<verse eid="ISA 57:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 57:4" />Anie ke ndufo enọ ñyọọ?</para>
  <para style="q2" vid="ISA 57:4">Anie ke ndufo enwañña inua</para>
  <para style="q2" vid="ISA 57:4">enyʌñ esio edeme enyan ebaña?</para>
  <para style="q1" vid="ISA 57:4">Nte ndufo idooho ubon nsọñiwuod,</para>
  <para style="q2" vid="ISA 57:4">nditọ mme asu nsu?<verse eid="ISA 57:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 57:5" />Ndufo eyọhọ ye akpọsọñ udọñ efịbe ke idak mme afriyo</para>
  <para style="q2" vid="ISA 57:5">ye ke idak mfuud afịd mme awawa eto;</para>
  <para style="q1" vid="ISA 57:5">ndufo ewa nditọ ndufo ke mme ñkpoho abedeñ</para>
  <para style="q2" vid="ISA 57:5">ye ke mme idak nsaiya abod.<verse eid="ISA 57:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 57:6" />Udeeme ndufo eba ye mme ubobodñkpọ e-edʌñọke ke ndọnọ itiad abedeñ;</para>
  <para style="q2" vid="ISA 57:6">ke akpanikọ, ammọ edo udeeme ndufo.</para>
  <para style="q1" vid="ISA 57:6">Ke akpanikọ ndufo emeduọk mmịn uwa ukọd enọ ammọ</para>
  <para style="q2" vid="ISA 57:6">enyʌñ enọ mme enọ ñkpasi.</para>
  <para style="q2" vid="ISA 57:6">Nte ami mmekeme adisịññe idem ñkpọñ mme ñkpọ ami?<verse eid="ISA 57:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 57:7" />Ndufo emenam itie nnaa ndufo ke anyọñ uyaiya abod;</para>
  <para style="q2" vid="ISA 57:7">do ke ndufo ekedọọk ekaa ekenam mme uwa.<verse eid="ISA 57:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 57:8" />Ke mme edem udọk ndufo ye mme abọbọọk inuausʌñ,</para>
  <para style="q2" vid="ISA 57:8">ndufo emebono mme idiọọñọ ibọk ndufo.</para>
  <para style="q1" vid="ISA 57:8">Ke adidiañña iñkpọñ miin, ndufo emefʌkkọ ñkpana ndufo,</para>
  <para style="q2" vid="ISA 57:8">e-edọọk edʌk, enyʌñ ebeere anye enịm inwañ;</para>
  <para style="q1" vid="ISA 57:8">ndufo emaedʌk edioomo ye mbon a-ndufo emaaha ñkpana ammọ,</para>
  <para style="q2" vid="ISA 57:8">emaenyʌñ ese ifed ammọ ye udọñinaa.<verse eid="ISA 57:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 57:9" />Ndufo emaedat adan ọlif ekaa ebịne Molek,</para>
  <para style="q2" vid="ISA 57:9">enyʌñ enam mme inemufịk pefium ndufo ewak.</para>
  <para style="q1" vid="ISA 57:9">Ndufo emaedọñ mme isʌñutom ndufo eka anyan itie;</para>
  <para style="q2" vid="ISA 57:9">ndin emaesuuhọ edʌk ataa ntotəño itie mbon ñkpañña!<verse eid="ISA 57:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 57:10" />Emaenam idem imem ndufo ke akpọsọñ ndukpo,</para>
  <para style="q2" vid="ISA 57:10">ado ndufo idiibooho, ‘idodanyen ibaaha.’</para>
  <para style="q1" vid="ISA 57:10">Emaekịt naña ekeme edimaana ndemme adudu ndufo,</para>
  <para style="q2" vid="ISA 57:10">ke ntoro ndufo ikikpaaha mba.<verse eid="ISA 57:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 57:11" />“Anie ke ndufo enekke ekop ndịk ebaña enyʌñ ebaak</para>
  <para style="q2" vid="ISA 57:11">yak ndufo idiikanna inam akpanikọ ye ami,</para>
  <para style="q1" vid="ISA 57:11">inyʌññọ intoiyo miin</para>
  <para style="q2" vid="ISA 57:11">itoiyo iben ñkpọ ami isịn ke esịd?</para>
  <para style="q1" vid="ISA 57:11">Idooho ke ntak ami ndoppo uyio ke anyan ini</para>
  <para style="q2" vid="ISA 57:11">ndin ndufo imbaaha miin?<verse eid="ISA 57:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 57:12" />Ami ñyaayaara adinenido ndufo ye mme utom ndufo,</para>
  <para style="q2" vid="ISA 57:12">ado ammọ idiidoroke ndufo udod.<verse eid="ISA 57:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 57:13" />Ke ini afo atuaha ayem unwam,</para>
  <para style="q2" vid="ISA 57:13">yak mme ubobodñkpọ mfo unyaaña fiin!</para>
  <para style="q1" vid="ISA 57:13">Afịm ayaakoono afịd ammọ afep,</para>
  <para style="q2" vid="ISA 57:13">ñkaña ibifịk ayaafịm ammọ aduọọñọ.</para>
  <para style="q1" vid="ISA 57:13">Ado awo akeedodo a-adịbeke ke ami,</para>
  <para style="q2" vid="ISA 57:13">ayaaben isọñ anie</para>
  <para style="q2" vid="ISA 57:13">anyʌñ aben adisana abod mmi anie.”<verse eid="ISA 57:13" /></para>
  <para style="s1">Idọñesịd Mbon Mbʌññọesịd</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 57:14" />Ndin eyaebo:</para>
  <para style="q1" vid="ISA 57:14">“Bọp, bọp, diọñ usʌñ!</para>
  <para style="q2" vid="ISA 57:14">Sịññe mme ñkpọiduọ ke usʌñ ikọd mmi fep.”<verse eid="ISA 57:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 57:15" />Sia se Andikoñ ye Andidaubọọñ atañ ado ami;</para>
  <para style="q2" vid="ISA 57:15">anye a-aduuho uwem ke nsi-nsi, a-anyịñ amọ adooho adisana:</para>
  <para style="q1" vid="ISA 57:15">“Ami ndʌñ ke ñkoñ-ñkoñ adisana itie,</para>
  <para style="q2" vid="ISA 57:15">ñnyʌñ ndʌñ ye awo e-esịd amọ abʌññọke anyʌñ anie mmem-mmem sịbidịd,</para>
  <para style="q1" vid="ISA 57:15">adidemme sịbidịd mbon e-ebaaha ke usuuhọ itie</para>
  <para style="q2" vid="ISA 57:15">ñnyʌñ ndemme esịd a-abʌññọke.<verse eid="ISA 57:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 57:16" />Ami ndiisuuhọ ammọ uyio ke nsi-nsi,</para>
  <para style="q2" vid="ISA 57:16">ami ndiinyʌññọ ñyat esịd afịd ini,</para>
  <para style="q1" vid="ISA 57:16">sia ammọ eyaesʌkkọ ke ntak mmi,</para>
  <para style="q2" vid="ISA 57:16">kpa mbon a-ami mbotto.<verse eid="ISA 57:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 57:17" />Esịd amañyat miin abaña idiọọk udọñ idiọọkñkpọ ammọ;</para>
  <para style="q2" vid="ISA 57:17">ami mmaamia ammọ ufen, ñnyʌñ ndịp iso mmi ke ntak iyadesịd,</para>
  <para style="q2" vid="ISA 57:17">ado ammọ esʌk ekaa iso ke ñkoinnam usʌñ ammọ.<verse eid="ISA 57:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 57:18" />Ami mmekịt mme usʌñ ammọ, ado ami ñyaakọk ammọ;</para>
  <para style="q2" vid="ISA 57:18">ami ñyaadat ammọ usʌñ ñnyʌñ mmaana nnọ mbon ntuaña Isrel idọñesịd,<verse eid="ISA 57:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="ISA 57:19" />mbot itooro ndot ke ñkpọkinua ammọ.</para>
  <para style="q1" vid="ISA 57:19">Emem, emem, anie mbon e-ebaha nsan-nsan ye ñkped-ñkped,”</para>
  <para style="q2" vid="ISA 57:19">
    <char style="nd">Abọọñ</char> atañ.</para>
  <para style="q1" vid="ISA 57:19">“Ñko ami ñyaakọk ammọ.”<verse eid="ISA 57:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 57:20" />Ado mbon ibak ebit mmọọñ akpainyañ a-atoppo,</para>
  <para style="q2" vid="ISA 57:20">idiikanna iduọk adudu,</para>
  <para style="q2" vid="ISA 57:20">a-afịm amọ atoppo ndek ye mbad.<verse eid="ISA 57:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 57:21" />Abasi mmi abo ate, “Emem ibaaha inọ awo ibak.”<verse eid="ISA 57:21" /></para>
  <chapter eid="ISA 57" />
  <chapter number="58" style="c" sid="ISA 58" />
  <para style="s1">Ata Utreudia</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 58:1" />“Bọñ ke akpọsọñ uyio, kuumʌm ukama.</para>
  <para style="q2" vid="ISA 58:1">Dịppe uyio mfo ke anyọñ nte adukpoñ.</para>
  <para style="q1" vid="ISA 58:1">Nam ikọd mmi ediọọñọ ebaña nsọñiwuod ammọ,</para>
  <para style="q2" vid="ISA 58:1">ubon Yekọb ñko ediọọñọ ebaña ndiọiñkpọ ammọ.<verse eid="ISA 58:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 58:2" />Sia ke usen ke usen ammọ eñyem miin;</para>
  <para style="q2" vid="ISA 58:2">aba nte ammọ enie udọñ adidiọọñọ mme usʌñ mmi,</para>
  <para style="q1" vid="ISA 58:2">nte ebo ke ammọ edo idịd e-enamma se ifọn</para>
  <para style="q2" vid="ISA 58:2">inyʌññọ ikpọñ mme ewʌhọ Abasi amọ.</para>
  <para style="q1" vid="ISA 58:2">Ammọ embịp miin ebaña ndinen ubiere,</para>
  <para style="q2" vid="ISA 58:2">enyʌñ eba nte enie udọñ Abasi adikpere ammọ.<verse eid="ISA 58:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 58:3" />Ammọ ebo, ‘nsoo ido nọ ñnyịn itie utreudia,’</para>
  <para style="q2" vid="ISA 58:3">‘ado afo ukịtte?</para>
  <para style="q1" vid="ISA 58:3">Nsoo ido nọ ñnyịn isuuhọ idem ñnyịn,</para>
  <para style="q2" vid="ISA 58:3">ndin afo ukịtte?’</para>
  <para style="b" vid="ISA 58:3" />
  <para style="q1" vid="ISA 58:3">“Ado ke usen utreudia ndufo, ndufo enam naña inem ndufo esịd,</para>
  <para style="q2" vid="ISA 58:3">enyʌñ etʌk afịd mbon utom.<verse eid="ISA 58:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 58:4" />Utreudia ndufo atre ke utọk ye ntịme,</para>
  <para style="q2" vid="ISA 58:4">ye ke aditọ emọ-emọ mme eta ibak.</para>
  <para style="q1" vid="ISA 58:4">Ndufo ikemeke aditie utreudia naña enam mfịn,</para>
  <para style="q2" vid="ISA 58:4">ndin ekere ke akpena ekop uyio ndufo ke anyọñ.<verse eid="ISA 58:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 58:5" />Nte utọ utreudia se ami mmek ado ami,</para>
  <para style="q2" vid="ISA 58:5">usen keed kpọd se mme awo esuuhọ idem ammọ?</para>
  <para style="q1" vid="ISA 58:5">Nte ukweeñe ñkpọ ado adinyuuk iwuod nte akpọ ñnyanyaha,</para>
  <para style="q2" vid="ISA 58:5">ye adisuuk nnaa ke afọñikpo ye ke ntọñ?</para>
  <para style="q1" vid="ISA 58:5">Se ndufo ekoot utreudia adodo,</para>
  <para style="q2" vid="ISA 58:5">usen se <char style="nd">Abọọñ</char> anyịmme?<verse eid="ISA 58:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 58:6" />“Nte idooho utọ utreudia ami ke ami mmek:</para>
  <para style="q1" vid="ISA 58:6">adikpọk mme akpọnọ ukwañ ikpe,</para>
  <para style="q2" vid="ISA 58:6">ñnyʌñ ntat mme udʌk akpọnọ,</para>
  <para style="q1" vid="ISA 58:6">adisaana mbon e-efiike ñyaak,</para>
  <para style="q2" vid="ISA 58:6">ñnyʌñ mbʌñ afịd akpọnọ?<verse eid="ISA 58:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 58:7" />Nte idooho adiwana ndidia ndufo ye mbọm abiọọñ</para>
  <para style="q2" vid="ISA 58:7">ye adinọ mme ñyooñ uweene itie idʌñ,</para>
  <para style="q1" vid="ISA 58:7">afo umaukịt mbon se isaña ifed, asịn ammọ afọñ,</para>
  <para style="q2" vid="ISA 58:7">idooho adikanna edem ñwọt abʌk ye iyiib mfo?<verse eid="ISA 58:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 58:8" />Ndin unwana mfo ayaayamma nte usiere,</para>
  <para style="q2" vid="ISA 58:8">adikọk mfo ñko ayaasọp awuọ awọt idem;</para>
  <para style="q1" vid="ISA 58:8">ndin adinenido<note caller="+" style="f"><char style="fr" closed="false">58:8 </char><char style="ft" closed="false">Akeme ido </char><char style="fqa" closed="false">andido andinen </char><char style="fq" closed="false">mfo</char></note> mfo ayaaboiyo iso unọ fiin,</para>
  <para style="q2" vid="ISA 58:8">ubọọñ <char style="nd">Abọọñ</char> ayaado ukpeme unọ fiin ke edem.<verse eid="ISA 58:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 58:9" />Ndin afo ayaakoot, ndin <char style="nd">Abọọñ</char> ayaanyʌñ abọọrọ;</para>
  <para style="q2" vid="ISA 58:9">afo ayaatua ayem unwam, anye ayaanyʌñ abo: Se ami mi.</para>
  <para style="b" vid="ISA 58:9" />
  <para style="q1" vid="ISA 58:9">“Adieke afo aduọhọ akpọnọ ufiik,</para>
  <para style="q2" vid="ISA 58:9">ye unyan ubọk ye idiọọk ikọ inua,<verse eid="ISA 58:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 58:10" />ñko afo ukpuwa idem mfo, unam ñkpọ unọ mbon abiọọñ,</para>
  <para style="q2" vid="ISA 58:10">anyʌñ anọ mbon se efiik se inana ammọ,</para>
  <para style="q1" vid="ISA 58:10">unwana mfo ayaayamma ke akịm,</para>
  <para style="q2" vid="ISA 58:10">unwana mfo ayaanyʌñ aba nte ufọọd uweemeayio.<verse eid="ISA 58:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 58:11" />
    <char style="nd">Abọọñ</char> ayaukpeme fiin afịd ini;</para>
  <para style="q2" vid="ISA 58:11">anye ayaunọ fiin uyʌkkọ ke nsaad isọñ,</para>
  <para style="q2" vid="ISA 58:11">ayaanyʌñ usọọñọ fiin idem.</para>
  <para style="q1" vid="ISA 58:11">Afo adiitie nte inwañ enekkeke eduọk mmọọñ,</para>
  <para style="q2" vid="ISA 58:11">nte idịm a-mmọọñ amọ imiitreke.<verse eid="ISA 58:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 58:12" />Mbon mfo eyaemaana ebọp ñwuudo ñkaan abio,</para>
  <para style="q2" vid="ISA 58:12">eyaenyʌñ edịppe akpọsọñ ñkaan itiad idakisọñ;</para>
  <para style="q1" vid="ISA 58:12">eyaukoot fiin Adiọñ Ñwuudo Ndibene,</para>
  <para style="q2" vid="ISA 58:12">Andimaana Ndiọñ mme Akpọusʌñ ye mme Itieidʌñ.<verse eid="ISA 58:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ISA 58:13" />“Afo akpekpan ukod mfo aditre ibiat mbed Sabad,</para>
  <para style="q2" vid="ISA 58:13">anyʌñ atre adinam naña afo ama ke adisana usen mmi,</para>
  <para style="q1" vid="ISA 58:13">adieke afo akoodo Sabad inem,</para>
  <para style="q2" vid="ISA 58:13">anyʌñ akoot adisana usen <char style="nd">Abọọñ</char> ukpono,</para>
  <para style="q1" vid="ISA 58:13">afo ñko akpekpono anye ke aditre adisaña ke usʌñ mfo,</para>
  <para style="q2" vid="ISA 58:13">unyʌññọ unam naña afo ama, me aditañ atịme ikọ,<verse eid="ISA 58:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 58:14" />afo ayaakịt inemesịd mfo ke <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 58:14">ami ñyaanam afo awat ke ubọọñ ke mme ñkoñ-ñkoñ isọñ,</para>
  <para style="q2" vid="ISA 58:14">anyʌñ adia usọrọ ke udeeme ete mfo Yekọb.”</para>
  <para style="q1" vid="ISA 58:14">Inua <char style="nd">Abọọñ</char> atañ ami.<verse eid="ISA 58:14" /></para>
  <chapter eid="ISA 58" />
  <chapter number="59" style="c" sid="ISA 59" />
  <para style="s1">Idiọọkñkpọ, Adiyaara ye Ñkpọkñyak</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 59:1" />Ke akpanikọ ubọk <char style="nd">Abọọñ</char> iməhoke ibọhọ anye adinyaaña,</para>
  <para style="q2" vid="ISA 59:1">utọñ amọ inyʌññọ idoppo ikan se anye akop ikọ.<verse eid="ISA 59:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 59:2" />Ado mme ndiọiñkpọ ndufo idiañña</para>
  <para style="q2" vid="ISA 59:2">ndufo akpọñ Abasi;</para>
  <para style="q1" vid="ISA 59:2">ndiọiñkpọ ndufo edịp iso amọ ikpọñ ndufo,</para>
  <para style="q2" vid="ISA 59:2">mbaak anye akop.<verse eid="ISA 59:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 59:3" />Sia ubọk ndufo ayọhọ ye iyiib,</para>
  <para style="q2" vid="ISA 59:3">mme nnuunubọk ndufo eyọhọ ye ndudue.</para>
  <para style="q1" vid="ISA 59:3">Ñkpọkinua ndufo esʌhọ nsu,</para>
  <para style="q2" vid="ISA 59:3">edeme ndufo enyʌñ etañ mme ibak-ibak ñkpọ.<verse eid="ISA 59:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 59:4" />Awo ndomokeed iyemme adinen ikpe;</para>
  <para style="q2" vid="ISA 59:4">awo ndomokeed ikpeeghe ikpe ke akpanikọ.</para>
  <para style="q1" vid="ISA 59:4">Ammọ ebuọt idem ke ukpọk mfaaña, enyʌñ esʌhọ nsu;</para>
  <para style="q2" vid="ISA 59:4">ammọ eyommo mfịna enyʌñ eman ibak.<verse eid="ISA 59:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 59:5" />Ammọ eboot mme ñkwa ibọm,</para>
  <para style="q2" vid="ISA 59:5">enyʌñ etuak ufọk utuudekpe.</para>
  <para style="q1" vid="ISA 59:5">Awo akeedodo ataha ñkwa ammọ ayaakpa,</para>
  <para style="q2" vid="ISA 59:5">ndin emaebom keed, ayaaboot ibọm.<verse eid="ISA 59:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 59:6" />Ñkpukọọkọọmọ ammọ ifọññọ ke afọñ;</para>
  <para style="q2" vid="ISA 59:6">ammọ ikanna ifʌk idem ammọ ye se ammọ enam.</para>
  <para style="q1" vid="ISA 59:6">Mme adinam ammọ edo ibak,</para>
  <para style="q2" vid="ISA 59:6">mme adinam afai eba ke ubọk ammọ.<verse eid="ISA 59:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 59:7" />Ukod ammọ efeghe ebịne idiọọkñkpọ;</para>
  <para style="q2" vid="ISA 59:7">ammọ esọp adiduọk iyiib i-imiidueghe.</para>
  <para style="q1" vid="ISA 59:7">Ammọ ebịne ndiọi ndutʌm;</para>
  <para style="q2" vid="ISA 59:7">mme adinam afai edo idiọọñọ usʌñ ammọ.<verse eid="ISA 59:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 59:8" />Ammọ idiọọñọke usʌñ emem;</para>
  <para style="q2" vid="ISA 59:8">adinen ikpe inyʌññọ iba ke mme usʌñ ammọ.</para>
  <para style="q1" vid="ISA 59:8">Ammọ ekanna usʌñ ammọ enịm ñkwaña-ñkwaña;</para>
  <para style="q2" vid="ISA 59:8">ibaaha awo ndomokeed adiisaña do ikịt emem.<verse eid="ISA 59:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ISA 59:9" />Ke ntoro adinen ikpe asanna ikpọñ ñnyịn;</para>
  <para style="q2" vid="ISA 59:9">adinenido ñko isịmme ñnyịn.</para>
  <para style="q1" vid="ISA 59:9">Ñnyịn iyem unwana, ado afịd itie ado akịm;</para>
  <para style="q2" vid="ISA 59:9">iyem uyamma, ado ñnyịn isaña ke ntotəño ndukpọñ.<verse eid="ISA 59:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 59:10" />Nte nnan ñnyịn iweeweere ubọk ke ndibene,</para>
  <para style="q2" vid="ISA 59:10">iyeem usʌñ ñnyịn nte mbon i-imiinieghe anyen.</para>
  <para style="q1" vid="ISA 59:10">Ke ufọọd uweemeayio ñnyịn ifʌmmọ nte ado ndubiayio;</para>
  <para style="q2" vid="ISA 59:10">ke atu mme ñkpọsọñ, ñnyịn iba nte mme akpañkpa.<verse eid="ISA 59:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 59:11" />Afịd ñnyịn ikuun nte amọnikọd;</para>
  <para style="q2" vid="ISA 59:11">inyʌñ imịm mmịm ke mfʌhọ nte mme ibiom.</para>
  <para style="q1" vid="ISA 59:11">Ñnyịn iyem unen, ado ikịtte ndomokeed;</para>
  <para style="q2" vid="ISA 59:11">iyem adinyaaña, ado anye aba nsan-nsan ikpọñ ñnyịn.<verse eid="ISA 59:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ISA 59:12" />Sia ndudue ñnyịn ewak ke iso mfo,</para>
  <para style="q2" vid="ISA 59:12">ndin mme idiọọkñkpọ ñnyịn etie ntiense ibaña ñnyịn.</para>
  <para style="q1" vid="ISA 59:12">Mme ndudue ñnyịn eba ye ñnyịn afịd ini,</para>
  <para style="q2" vid="ISA 59:12">ñnyịn ñko imidiọọñọ mme idiọọkñkpọ ñnyịn:<verse eid="ISA 59:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 59:13" />nsọñiwuod ye ibak adinam ye <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 59:13">imikanna edem ñnyịn iwọt Abasi ñnyịn,</para>
  <para style="q1" vid="ISA 59:13">isịn nsọk nsọñiwuod ye ufiik,</para>
  <para style="q2" vid="ISA 59:13">itañ mme nsu se mme esịd ñnyịn ekere.<verse eid="ISA 59:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 59:14" />Ke ntak ado ebịn unenikpe etịmme edem,</para>
  <para style="q2" vid="ISA 59:14">ndin adinenido ada nsan-nsan;</para>
  <para style="q1" vid="ISA 59:14">akpanikọ ayʌt aduọ ke mme efaak,</para>
  <para style="q2" vid="ISA 59:14">akpanikọ ikanna idʌk.<verse eid="ISA 59:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 59:15" />Ibaaha nte ekan ekịt akpanikọ,</para>
  <para style="q2" vid="ISA 59:15">ñko awo akeedodo a-asọọnọ idiọọkñkpọ akappa ado mbịme anọ unam.</para>
  <para style="b" vid="ISA 59:15" />
  <para style="q1" vid="ISA 59:15">
    <char style="nd">Abọọñ</char> amaase ndin esịd ikinemme anye</para>
  <para style="q2" vid="ISA 59:15">ibaña naña unenikpe imiikibaaha.<verse eid="ISA 59:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 59:16" />Anye amaakịt ke ibaaha awo ndomokeed,</para>
  <para style="q2" vid="ISA 59:16">idem amaakpa anye ke ikibaaha awo se ikpe ubọk ibaña;</para>
  <para style="q1" vid="ISA 59:16">ke ntoro ubọk amọ amaabọ adinyaaña anọ anye,</para>
  <para style="q2" vid="ISA 59:16">ndin adinenido amọ amaamʌm anye akama.<verse eid="ISA 59:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 59:17" />Anye amaasịne adinenido nte afọñ ikpanesịd,</para>
  <para style="q2" vid="ISA 59:17">ye itam adinyaaña ke iwuod amọ;</para>
  <para style="q1" vid="ISA 59:17">anye asịne mme afọñ usio usiene,</para>
  <para style="q2" vid="ISA 59:17">anyʌñ awañ idem amọ ke akpọsọñ udọñ nte afọñidem.<verse eid="ISA 59:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 59:18" />Akeene se ammọ enam,</para>
  <para style="q2" vid="ISA 59:18">kpa ntoro ke anye adiinọ ammọ utịb,</para>
  <para style="q1" vid="ISA 59:18">anọ usua amọ iyadesịd,</para>
  <para style="q2" vid="ISA 59:18">mbon utọk amọ ndiọi adinam ammọ;</para>
  <para style="q2" vid="ISA 59:18">anye ayaanọ mme abio isu se idot ye ammọ.<verse eid="ISA 59:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 59:19" />Tọọñọ ke edem usobutịn, mme awo eyaefeghe anyịñ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 59:19">ñko tọọñọ ke usakkautịn, ammọ eyaekpono ubọọñ ammọ.</para>
  <para style="q1" vid="ISA 59:19">Sia anye ayaadi nte ntịmmeedem mmọọñ atọ</para>
  <para style="q2" vid="ISA 59:19">i-ibifịk <char style="nd">Abọọñ</char> anəkko.<verse eid="ISA 59:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 59:20" />“Andifak ayaadi ke Saiyọn,</para>
  <para style="q2" vid="ISA 59:20">abịne mbon se iba ke Yekọb, e-ekappake esịd ekpọñ ndiọiñkpọ ammọ,”</para>
  <para style="q2" vid="ISA 59:20">
    <char style="nd">Abọọñ</char> atañ.<verse eid="ISA 59:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 59:21" />
    <char style="nd">Abọọñ</char> abo, “Amaado ami, edioomo mmi ye ammọ ado ami, Sịbidịd mmi, u-udoroke fiin ke idem, iduukpọññọ fiin, ñko ikọ mmi a-nsịnne ke inua mfo adiidoro ke ñkpọkinua mfo afịd ini, adoro ke ñkpọkinua nditọ mfo ye ke ñkpọkinua ubon ammọ, tọọñọ ke ini ami tutu ke nsi-nsi,” <char style="nd">Abọọñ</char> atañ.<verse eid="ISA 59:21" /></para>
  <chapter eid="ISA 59" />
  <chapter number="60" style="c" sid="ISA 60" />
  <para style="s1">Ubọọñ Saiyọn</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 60:1" />“Dakka da, ñnyʌñ yamma, sia unwana mfo adi,</para>
  <para style="q2" vid="ISA 60:1">ndin ubọọñ <char style="nd">Abọọñ</char> u-udoro fiin ke idem.<verse eid="ISA 60:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 60:2" />Se, ekịm afʌk isọñ,</para>
  <para style="q2" vid="ISA 60:2">ndin akpọsọñ ekịm afʌk mbon awo,</para>
  <para style="q1" vid="ISA 60:2">ado <char style="nd">Abọọñ</char> adọọk udoro fiin ke idem</para>
  <para style="q2" vid="ISA 60:2">ndin ubọọñ amọ abiọññọ unọ fiin.<verse eid="ISA 60:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 60:3" />Mme idịd eyaedi ebịne unwana mfo,</para>
  <para style="q2" vid="ISA 60:3">ndidem ñko eyaebịne uyamma mfo ke usiere.<verse eid="ISA 60:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 60:4" />“Tat anyen mfo nyʌñ nekke se kanna:</para>
  <para style="q2" vid="ISA 60:4">Afịd awo esoobo idem enyʌñ edi ubịne fiin;</para>
  <para style="q1" vid="ISA 60:4">nditọ ideen mfo eto anyan usʌñ edi,</para>
  <para style="q2" vid="ISA 60:4">ndin enyʌñ ekama nditọ ibaan mfo ke ifʌkkọ.<verse eid="ISA 60:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 60:5" />Idaha ado ke afo adiise ndin iso anyʌñ utara,</para>
  <para style="q2" vid="ISA 60:5">esịd mfo ayaanyeñ anyʌñ ayọhọ ye idaara;</para>
  <para style="q1" vid="ISA 60:5">eyaeben mme inie akpainyañ usọk fiin,</para>
  <para style="q2" vid="ISA 60:5">afo ke inie mme idịd adiidi ibịne.<verse eid="ISA 60:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 60:6" />Udịm kamel eyaefʌk isọñ mfo,</para>
  <para style="q2" vid="ISA 60:6">mme ñyịn kamel Midian ye ake Efa.</para>
  <para style="q1" vid="ISA 60:6">Afịd mbon se ito Seba eyaenyʌñ edi,</para>
  <para style="q2" vid="ISA 60:6">ekama kold ye insensi,</para>
  <para style="q2" vid="ISA 60:6">enyʌñ edịppe uyio etooro <char style="nd">Abọọñ</char>.<verse eid="ISA 60:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 60:7" />Eyaekoono afịd ufene Keda edibono unọ fiin,</para>
  <para style="q2" vid="ISA 60:7">mme akukịmedọñ Nebaiyọd eyaenam ñkpọ unọ fiin,</para>
  <para style="q1" vid="ISA 60:7">eyaebọ ammọ nte uwa ke akpokoro uwa mmi,</para>
  <para style="q2" vid="ISA 60:7">ami ñyaanyʌñ ndiọñ tembịd ubọọñ mmi.<verse eid="ISA 60:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 60:8" />“Mme anie ido ami e-efuurọke edi nte ntọñanyọñ,</para>
  <para style="q2" vid="ISA 60:8">nte mme ibiom e-efuurọke eka efọk ammọ?<verse eid="ISA 60:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 60:9" />Ke akpanikọ mme isu ense miin;</para>
  <para style="q2" vid="ISA 60:9">mme nsʌñikañ Taasis eboiyo iso,</para>
  <para style="q1" vid="ISA 60:9">e-ekoono nditọ mfo eto anyan itie,</para>
  <para style="q2" vid="ISA 60:9">ye silfa mme kold ammọ,</para>
  <para style="q1" vid="ISA 60:9">ke ukpono <char style="nd">Abọọñ</char> Abasi mfo,</para>
  <para style="q2" vid="ISA 60:9">Adisana Abasi Isrel,</para>
  <para style="q2" vid="ISA 60:9">sia anye u-unọ fiin mmọnyọ.<verse eid="ISA 60:9" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 60:10" />“Isenawo eyaemaana ebọp mme ndibene mfo,</para>
  <para style="q2" vid="ISA 60:10">ñko ndidem ammọ eyaenam ñkpọ unọ fiin.</para>
  <para style="q1" vid="ISA 60:10">Akpesʌkado ke iyadesịd ami mmaumia fiin,</para>
  <para style="q2" vid="ISA 60:10">ke mfọn ami ñyautua fiin mbọm.<verse eid="ISA 60:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 60:11" />Mme inuaatob mfo ediina inwañ afịd ini,</para>
  <para style="q2" vid="ISA 60:11">awo idiibette ammọ, uweemeayio me akonayio,</para>
  <para style="q1" vid="ISA 60:11">nọ mme awo eben inie mme idịd usọk fiin,</para>
  <para style="q2" vid="ISA 60:11">ndidem ammọ eda iso ke isañ ubọọñ.<verse eid="ISA 60:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 60:12" />Idịd me abio u-umuukponoke fiin eyaetak;</para>
  <para style="q2" vid="ISA 60:12">eyaesobo ammọ afịd-afịd.<verse eid="ISA 60:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ISA 60:13" />“Ubọọñ Lebanọn ayaadi ubịne fiin,</para>
  <para style="q2" vid="ISA 60:13">yunipa, fir ye saipres eyaediana do;</para>
  <para style="q1" vid="ISA 60:13">nọ ekama ebana adisana itie mmi;</para>
  <para style="q2" vid="ISA 60:13">ami ñko ñyaadịppe ubọọñ itie ado nnọ ñkpad mmi.<verse eid="ISA 60:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 60:14" />Nditọ mbon se ufiik fiin eyaedisuuk iwuod unọ fiin;</para>
  <para style="q2" vid="ISA 60:14">afịd mbon se use fiin ke ndek eyaetuak iwuod ke ukod mfo,</para>
  <para style="q1" vid="ISA 60:14">eyaenyʌñ ukoot fiin Abio <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 60:14">Saiyọn Adisana Abasi Isrel.<verse eid="ISA 60:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 60:15" />“Akpesʌkado emaekusịn fiin enyʌñ usua,</para>
  <para style="q2" vid="ISA 60:15">awo ndomokeed isañake iboiyo ika isañ,</para>
  <para style="q1" vid="ISA 60:15">ami ñyaunam fiin ado nsi-nsi ñkpọuto</para>
  <para style="q2" vid="ISA 60:15">ye idadesịd afịd mme emana.<verse eid="ISA 60:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 60:16" />Afo ayaanwọñ mmọọñeba mme idịd,</para>
  <para style="q2" vid="ISA 60:16">ndin eyaubọọk fiin ke mme eba ufọk ndidem.</para>
  <para style="q1" vid="ISA 60:16">Ini ado ke afo uduudiọọñọ ke ami, <char style="nd">Abọọñ</char>, ndo Adinyaaña mfo,</para>
  <para style="q2" vid="ISA 60:16">Ufak mfo, Akpọsọñ Abasi Yekọb.<verse eid="ISA 60:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 60:17" />Utu ke brọns ami ñyaaben kold ndi,</para>
  <para style="q2" vid="ISA 60:17">ye silfa ke itie ukwak.</para>
  <para style="q1" vid="ISA 60:17">Utu ke eto ami ñyaaben brọns usọk fiin,</para>
  <para style="q2" vid="ISA 60:17">ukwak ke itie mme itiad.</para>
  <para style="q1" vid="ISA 60:17">Ami ñyaanam emem ado andukara fiin,</para>
  <para style="q2" vid="ISA 60:17">ndin nsọñidem ado adaukara mfo.<verse eid="ISA 60:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 60:18" />Ibaaha aba naña ediikop afai ke isọñ mfo,</para>
  <para style="q2" vid="ISA 60:18">me ñwuudo me nsobo ke idak mme adaña mfo,</para>
  <para style="q1" vid="ISA 60:18">ado afo ayaakoot mme ndibene mfo Adinyaaña,</para>
  <para style="q2" vid="ISA 60:18">akoot inuaatob mfo Itooro.<verse eid="ISA 60:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 60:19" />Utịn idiidooho unwana mfo aba ke uweemeayio,</para>
  <para style="q2" vid="ISA 60:19">unwana afiọñ idiinyʌññọ iyamma unọ fiin,</para>
  <para style="q1" vid="ISA 60:19">sia <char style="nd">Abọọñ</char> adiido nsi-nsi unwana mfo,</para>
  <para style="q2" vid="ISA 60:19">ndin Abasi mfo adiido ubọọñ mfo.<verse eid="ISA 60:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 60:20" />Utịn mfo idiisuuhọke aba,</para>
  <para style="q2" vid="ISA 60:20">afiọñ mfo idiinyʌññọ isop aba;</para>
  <para style="q1" vid="ISA 60:20">
    <char style="nd">Abọọñ</char> adiido nsi-nsi unwana mfo,</para>
  <para style="q2" vid="ISA 60:20">ndin mme usen mfʌhọ mfo eyaetre.<verse eid="ISA 60:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 60:21" />Ndin afịd ikọd mfo eyaedo mme ndinen,</para>
  <para style="q2" vid="ISA 60:21">ñko ammọ eyaedat isọñ enie ke nsi-nsi.</para>
  <para style="q1" vid="ISA 60:21">Ammọ edo emịne a-ami ntọọhọ,</para>
  <para style="q2" vid="ISA 60:21">utom ubọk mmi,</para>
  <para style="q2" vid="ISA 60:21">adiwọt mmọnyọ mmi.<verse eid="ISA 60:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 60:22" />Nsuuhoñkan ke atu ndufo ayaakappa ado tọsịn keed,</para>
  <para style="q2" vid="ISA 60:22">nsịbñkan ayaado akpọsọñ idịd.</para>
  <para style="q1" vid="ISA 60:22">Ami ndo <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="ISA 60:22">ke akemini ami ñyaanam anye usọp-usọp.”<verse eid="ISA 60:22" /></para>
  <chapter eid="ISA 60" />
  <chapter number="61" style="c" sid="ISA 61" />
  <para style="s1">Isua Mfọn <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 61:1" />Sịbidịd <char style="nd">Abọọñ</char> Andikara andoro miin ke idem,</para>
  <para style="q2" vid="ISA 61:1">sia <char style="nd">Abọọñ</char> añyet miin adan</para>
  <para style="q2" vid="ISA 61:1">yak nsuan eti mbʌk nnọ mbon uweene.</para>
  <para style="q1" vid="ISA 61:1">Anye andọñ miin ate mben ndọñesịd nsọk mbon mbʌññọesịd,</para>
  <para style="q2" vid="ISA 61:1">ate nsuan etob ñkpọkñyak nnọ mme ifʌn ekọñ,</para>
  <para style="q2" vid="ISA 61:1">ñnyʌñ ñkwọrọ ñkpọkñyak nnọ mbon ñkpakọb<note caller="+" style="f"><char style="fr" closed="false">61:1 </char><char style="ft" closed="false">Ke Hibru; Septuakin akeme ido </char><char style="fq" closed="false">mbon </char><char style="fqa" closed="false">nnan</char><char style="fq" closed="false">mbon </char><char style="fqa" closed="false">i-imiikịtte usʌñ</char><char style="fq" closed="false">mbon </char><char style="fqa" closed="false">i-imiimọọnọke ñkpọ</char></note> e-ebaaha ke ekịm,<verse eid="ISA 61:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 61:2" />ñkwọrọ isua mfọnido <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ISA 61:2">ye usen usiene Abasi ñnyịn,</para>
  <para style="q1" vid="ISA 61:2">ñnyʌñ ndọñ afịd mbon mfʌhọ esịd,<verse eid="ISA 61:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="ISA 61:3" />adise ñkpọ mbaña mbon e-ebaha ke mfʌhọ ke Saiyọn,</para>
  <para style="q1" vid="ISA 61:3">nnọ ammọ anyanya uyai</para>
  <para style="q2" vid="ISA 61:3">ke itie ntọñ,</para>
  <para style="q1" vid="ISA 61:3">adan idaara</para>
  <para style="q2" vid="ISA 61:3">ke itie mfʌhọ,</para>
  <para style="q1" vid="ISA 61:3">ye afọñ itooro</para>
  <para style="q2" vid="ISA 61:3">ke itie sịbidịd unana idodanyen.</para>
  <para style="q1" vid="ISA 61:3">Ediikoot ammọ afriyo adinenido,</para>
  <para style="q2" vid="ISA 61:3">ñkpọ <char style="nd">A-Abọọñ</char> atọhọ</para>
  <para style="q2" vid="ISA 61:3">adiyaara mmọnyọ amọ.<verse eid="ISA 61:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="ISA 61:4" />Ammọ eyaemaana ebọp akaan ñwuudo abio,</para>
  <para style="q2" vid="ISA 61:4">enyʌñ emaana ebọp mme itie se ekebiat;</para>
  <para style="q1" vid="ISA 61:4">ammọ eyaemaana edemme mme ñwuudo abio</para>
  <para style="q2" vid="ISA 61:4">emaekewuut ke mme uwak emana.<verse eid="ISA 61:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 61:5" />Mme isenawo eyaekpeme mme ufene ndufo;</para>
  <para style="q2" vid="ISA 61:5">mbon asenidịd eyaenam utom ke inwañ ndufo enyʌñ ediọñ fain ndufo.<verse eid="ISA 61:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 61:6" />Ndin ediikoot ndufo mme aku <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 61:6">eyaikoot ndufo mme akwọrọikọ Abasi.</para>
  <para style="q1" vid="ISA 61:6">Ndufo eyaedia eto imọ mme idịd,</para>
  <para style="q2" vid="ISA 61:6">eyaenyʌñ ekama inie ammọ ekpọ inua.<verse eid="ISA 61:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 61:7" />Utu ke abuud</para>
  <para style="q2" vid="ISA 61:7">ndufo eyaebọ ñkpọ ñkemba,</para>
  <para style="q1" vid="ISA 61:7">utu ke asuenne</para>
  <para style="q2" vid="ISA 61:7">ndufo eyaedaara ebaña udeeme ndufo.</para>
  <para style="q1" vid="ISA 61:7">Ke ntoro ndufo eyaebọ udeeme ndufo ñkemba ke isọñ ndufo,</para>
  <para style="q2" vid="ISA 61:7">ndin nsi-nsi idaara adiido udeeme ndufo.<verse eid="ISA 61:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 61:8" />“Sia ami, <char style="nd">Abọọñ</char>, mmema unenikpe;</para>
  <para style="q2" vid="ISA 61:8">ami mmesua ñwo ye idiọọk adinam.</para>
  <para style="q1" vid="ISA 61:8">Ke idak akpanikọ mmi ñyaanọ ikọd mmi ñkpọ ayịnutom,</para>
  <para style="q2" vid="ISA 61:8">ñnyʌñ nnam nsi-nsi edioomo ye ammọ.<verse eid="ISA 61:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 61:9" />Eyaediọọñọ ubon ammọ ke atu mme idịd</para>
  <para style="q2" vid="ISA 61:9">ye mme nditọ ammọ ke atu mbon awo.</para>
  <para style="q1" vid="ISA 61:9">Afịd mbon se ikịt ammọ eyaediọọñọ</para>
  <para style="q2" vid="ISA 61:9">ke ammọ edo mbon se <char style="nd">Abọọñ</char> adiọñ.”<verse eid="ISA 61:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 61:10" />Ami mmekop inem ekamba-ekamba ke <char style="nd">Abọọñ</char>;</para>
  <para style="q2" vid="ISA 61:10">ukpọñ mmi adaara ke Abasi mmi.</para>
  <para style="q1" vid="ISA 61:10">Sia anye ansịn miin mme afọñ adinyaaña,</para>
  <para style="q2" vid="ISA 61:10">anyʌñ ambana miin idem ke afọñ adinenido amọ,</para>
  <para style="q1" vid="ISA 61:10">kpa naña ebendọ abana iwuod amọ nte aku,</para>
  <para style="q2" vid="ISA 61:10">ye naña anwaanndọ abana idem amọ ye mme ñkpọ mbanaidem.<verse eid="ISA 61:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 61:11" />Sia naña isọñ anam yak emịne atịppe awuọ,</para>
  <para style="q2" vid="ISA 61:11">inwañ anyʌñ anam mfịd ekọt,</para>
  <para style="q1" vid="ISA 61:11">kpa ntoro ke <char style="nd">Abọọñ</char> Andikara adiinam adinenido</para>
  <para style="q2" vid="ISA 61:11">ye itooro etịppe ewuọ eto afịd mme idịd.<verse eid="ISA 61:11" /></para>
  <chapter eid="ISA 61" />
  <chapter number="62" style="c" sid="ISA 62" />
  <para style="s1">Ufa Anyịñ Saiyọn</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 62:1" />Ke ntak Saiyọn ami ndiidoppo uyio,</para>
  <para style="q2" vid="ISA 62:1">ke ntak Yeruselem ami ndiitieghe sʌñ,</para>
  <para style="q1" vid="ISA 62:1">tutu ini aditoppo anye ke akpanikọ ayamma nte usiere,</para>
  <para style="q2" vid="ISA 62:1">adinyaaña amọ nte utuenikañ a-asakka.<verse eid="ISA 62:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 62:2" />Mme idịd eyaekịt utoppo ikpe mfo,</para>
  <para style="q2" vid="ISA 62:2">afịd mme ndidem eyaenyʌñ ekịt ubọọñ mfo;</para>
  <para style="q1" vid="ISA 62:2">eyaukoot fiin ufa anyịñ</para>
  <para style="q2" vid="ISA 62:2">i-inua <char style="nd">Abọọñ</char> adiinọ.<verse eid="ISA 62:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 62:3" />Afo ayaado ataa uyaiya anyanya ke ubọk <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 62:3">anyanya ubọọñ ke ekaubọk Abasi mfo.<verse eid="ISA 62:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 62:4" />Awo iduukoodo fiin aba Se Efeghe Ekpọñ,</para>
  <para style="q2" vid="ISA 62:4">inyʌññọ ikoot isọñ mfo Ndoon.</para>
  <para style="q1" vid="ISA 62:4">Ado eyaukoot fiin Hefsiba,<note caller="+" style="f"><char style="fr" closed="false">62:4 </char><char style="fq" closed="false">Hefsiba </char><char style="ft" closed="false">awuọñọ </char><char style="fqa" closed="false">inemesịd mmi akọñọ ke anye (awonwaan).</char></note></para>
  <para style="q2" vid="ISA 62:4">enyʌñ ekoot isọñ mfo Biula<note caller="+" style="f"><char style="fr" closed="false">62:4 </char><char style="fq" closed="false">Biula </char><char style="ft" closed="false">awuọñọ </char><char style="fqa" closed="false">udọ ndọ.</char></note>;</para>
  <para style="q1" vid="ISA 62:4">sia <char style="nd">Abọọñ</char> ayaanem esịd ubaña fiin,</para>
  <para style="q2" vid="ISA 62:4">ndin eyaenọ isọñ mfo ke ndọ<verse eid="ISA 62:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 62:5" />kpa naña akparawa adọ abọikpa,</para>
  <para style="q2" vid="ISA 62:5">kpa ntoro ke Andubọb fiin aduudọ fiin;</para>
  <para style="q1" vid="ISA 62:5">kpa naña ebendọ akop inemesịd abaña anwaanndọ amọ,</para>
  <para style="q2" vid="ISA 62:5">kpa ntoro ke Abasi mfo adiinem esịd ubaña fiin.<verse eid="ISA 62:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 62:6" />Yeruselem, ami mmenọ mme akpeme abio eka mme ndibene mfo;</para>
  <para style="q2" vid="ISA 62:6">ammọ idiidoppo uyio uweemeayio me akonayio.</para>
  <para style="q1" vid="ISA 62:6">Ndufo e-ekoodo <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 62:6">ikiinọọ idem ndufo nduọkadudu,<verse eid="ISA 62:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 62:7" />ikiinyʌñ inọọ anye nduọkadudu tutu anye abọp Yeruselem,</para>
  <para style="q2" vid="ISA 62:7">anyʌñ anam anye ado ñkpọ itooro anọ ekondo.<verse eid="ISA 62:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 62:8" />
    <char style="nd">Abọọñ</char> amaanwọñọ ke ubọk nnasia amọ</para>
  <para style="q2" vid="ISA 62:8">ye ke akpọsọñ ubọk amọ:</para>
  <para style="q1" vid="ISA 62:8">“Tutu amama ami ndiiyaaha abakpa ndufo nnọ</para>
  <para style="q2" vid="ISA 62:8">mme asua ndufo nte ndidia,</para>
  <para style="q1" vid="ISA 62:8">ñko ibaaha aba naña mbon asenidịd ediinwọñ ufa ukọd ndufo</para>
  <para style="q2" vid="ISA 62:8">a-ndufo ekekpaaha utom ke esịd;<verse eid="ISA 62:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 62:9" />ado mbon edọkkọ anye ediidia anye,</para>
  <para style="q2" vid="ISA 62:9">enyʌñ etooro <char style="nd">Abọọñ</char>,</para>
  <para style="q1" vid="ISA 62:9">mbon se inyʌñ ikoono kreb ediinwọñ ito anye</para>
  <para style="q2" vid="ISA 62:9">ke mme esob adisana itie mmi.”<verse eid="ISA 62:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ISA 62:10" />Isaña iboiyo, isaña iboiyo ke mme inuaatob!</para>
  <para style="q2" vid="ISA 62:10">Idiọñ usʌñ inọ mbon awo.</para>
  <para style="q1" vid="ISA 62:10">Ibọp, ibọp mme usʌñ!</para>
  <para style="q2" vid="ISA 62:10">Isịññe mme itiad.</para>
  <para style="q1" vid="ISA 62:10">Idịppe afọñidiọọñọ inọ mme idịd.<verse eid="ISA 62:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 62:11" />
    <char style="nd">Abọọñ</char> anọ uyio</para>
  <para style="q2" vid="ISA 62:11">tutu asịm mme utịd ederimbod:</para>
  <para style="q1" vid="ISA 62:11">“Bo Adiaha Saiyọn,</para>
  <para style="q2" vid="ISA 62:11">‘Se, Andunyaaña fiin adi!</para>
  <para style="q1" vid="ISA 62:11">Se, utịb amọ aba ye anye,</para>
  <para style="q2" vid="ISA 62:11">ñko utịb amọ asaña ye anye.’ ”<verse eid="ISA 62:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 62:12" />Ediikoot ammọ Ndisana Awo,</para>
  <para style="q2" vid="ISA 62:12">mbon se <char style="nd">Abọọñ</char> afak;</para>
  <para style="q1" vid="ISA 62:12">eyaenyʌñ ikoot ndufo Mbon Eyemme,</para>
  <para style="q2" vid="ISA 62:12">Abio a-awo imiifegheke ikpọñ aba.<verse eid="ISA 62:12" /></para>
  <chapter eid="ISA 62" />
  <chapter number="63" style="c" sid="ISA 63" />
  <para style="s1">Usen Usiene ye Adifak Abasi</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 63:1" />Anie awo ado ami a-atooho Edọm adi,</para>
  <para style="q2" vid="ISA 63:1">ato Bosra, ndaana-ndaana ñkem aduọkkọ ke afọñ amọ?</para>
  <para style="q1" vid="ISA 63:1">Anie awo ado ami, e-esịnne anye afọñidem ubọọñ,</para>
  <para style="q2" vid="ISA 63:1">a-awuọhọ asaña ye uko adudu amọ?</para>
  <para style="b" vid="ISA 63:1" />
  <para style="q1" vid="ISA 63:1">“Ado ami, a-nsuanna etob adikan,</para>
  <para style="q2" vid="ISA 63:1">ñnyaaña ke adudu.”<verse eid="ISA 63:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="ISA 63:2" />Nsoo inam afọñ mfo ado ndad-ndad,</para>
  <para style="q2" vid="ISA 63:2">nte ake mbon e-edịgheke ukwak ke afe unyịmme ukọd?<verse eid="ISA 63:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ISA 63:3" />“Ami mmedịghe afe unyịmme ukọd ke idem mmi ikpọọñ;</para>
  <para style="q2" vid="ISA 63:3">ke afịd mme idịd, awo ndomokeed ikibaaha ye ami.</para>
  <para style="q1" vid="ISA 63:3">Ami mmaafiik ammọ ke iyadesịd mmi,</para>
  <para style="q2" vid="ISA 63:3">ñnyʌñ nsọnnọ ammọ ke ifịdesịd mmi;</para>
  <para style="q1" vid="ISA 63:3">iyiib ammọ amaatiamma ke mme nsiine mmi,</para>
  <para style="q2" vid="ISA 63:3">anyʌñ adʌk afịd afọñ mmi.<verse eid="ISA 63:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 63:4" />Akedo usen usiene annọ miin;</para>
  <para style="q2" vid="ISA 63:4">isua ami adifak amaadikem.<verse eid="ISA 63:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 63:5" />Ami mmaase, ado ikibaaha awo ndomokeed se ikiinwam,</para>
  <para style="q2" vid="ISA 63:5">idem amañkpa miin ke awo ndomokeed ikiinọọhọ unwam;</para>
  <para style="q1" vid="ISA 63:5">ndin ubọk mmi ikpọọñ amaabọ adinyaaña annọ miin,</para>
  <para style="q2" vid="ISA 63:5">ifịdesịd mmi amammʌm miin akama.<verse eid="ISA 63:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 63:6" />Ami mmaasọnnọ mme idịd ke iyadesịd mmi;</para>
  <para style="q2" vid="ISA 63:6">ke ifịdesịd mmi ami mmaanam ukọd anaam ammọ,</para>
  <para style="q2" vid="ISA 63:6">ñnyʌñ nduọk iyiib ammọ ke isọñ.”<verse eid="ISA 63:6" /></para>
  <para style="s1">Itooro ye Akam</para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 63:7" />Ami ñyaatañ mbaña mme mfọnido <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 63:7">mme ñkpọ se anye anam e-edotto itooro,</para>
  <para style="q2" vid="ISA 63:7">akeene afịd se <char style="nd">Abọọñ</char> anam inọọ ñnyịn;</para>
  <para style="q1" vid="ISA 63:7">ii, uwak nti ñkpọ</para>
  <para style="q2" vid="ISA 63:7">a-anye anamma anọ Isrel,</para>
  <para style="q2" vid="ISA 63:7">akeene mbọm ye uwak mfọn amọ.<verse eid="ISA 63:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 63:8" />Anye amaabo, “Ke akpanikọ ammọ edo ikọd mmi,</para>
  <para style="q2" vid="ISA 63:8">nditọ se idiinam akpanikọ innọ miin”;</para>
  <para style="q2" vid="ISA 63:8">ke ntoro anye amaakappa ado Andinyaaña ammọ.<verse eid="ISA 63:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 63:9" />Ke afịd ndutʌhọ ammọ anye ñko amaabọ ndutʌhọ,</para>
  <para style="q2" vid="ISA 63:9">ndin enyere iso amọ amaanyaaña ammọ.</para>
  <para style="q1" vid="ISA 63:9">Ke ima ye mbọm amọ anye amaafak ammọ;</para>
  <para style="q2" vid="ISA 63:9">anye amaadịppe ammọ ke anyọñ, anyʌñ akama ammọ</para>
  <para style="q2" vid="ISA 63:9">ke afịd mme usen edem.<verse eid="ISA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 63:10" />Kpayeado ammọ emaesọñ iwuod,</para>
  <para style="q2" vid="ISA 63:10">enyʌñ enam Adisana Sịbidịd amọ afʌhọ.</para>
  <para style="q1" vid="ISA 63:10">Ke ntoro anye amaawọññọ edem anyʌñ akappa ado asua ammọ,</para>
  <para style="q2" vid="ISA 63:10">anye ke idem amọ amaanwana ye ammọ.<verse eid="ISA 63:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 63:11" />Ndin ikọd amọ emaetoiyo mme usen edem,</para>
  <para style="q2" vid="ISA 63:11">mme usen Moses ye mbon amọ;</para>
  <para style="q1" vid="ISA 63:11">mmọ anye a-akesañake ye ammọ aboiyo akpainyañ,</para>
  <para style="q2" vid="ISA 63:11">ye akpemeedọñ ufene amọ?</para>
  <para style="q1" vid="ISA 63:11">Mmọ anye akedọññọ</para>
  <para style="q2" vid="ISA 63:11">Adisana Sịbidịd amọ ke atu ammọ,<verse eid="ISA 63:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 63:12" />a-akedọññọ ubọk ubọọñ adudu amọ</para>
  <para style="q2" vid="ISA 63:12">nọ aba ke ubọk nnasia Moses,</para>
  <para style="q1" vid="ISA 63:12">a-akebakkake mme mmọọñ ke iso ammọ,</para>
  <para style="q2" vid="ISA 63:12">yak anọ idem amọ nsi-nsi etob,<verse eid="ISA 63:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 63:13" />a-akebenne ammọ asaña aboiyo ke ntotəño itie?</para>
  <para style="q1" vid="ISA 63:13">Nte enañmbakara ke anwa abio,</para>
  <para style="q2" vid="ISA 63:13">ammọ ikiduọhọ;<verse eid="ISA 63:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 63:14" />nte mme enañ e-esọiyọke eka unaisọñ,</para>
  <para style="q2" vid="ISA 63:14">Sịbidịd <char style="nd">Abọọñ</char> amaanọ ammọ nduọkadudu.</para>
  <para style="q1" vid="ISA 63:14">Ntom ke afo akedat ikọd mfo usʌñ,</para>
  <para style="q2" vid="ISA 63:14">nọ anam anyịñ ubọọñ anọ idem mfo.<verse eid="ISA 63:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ISA 63:15" />To ke hefịn suuk anyen nyʌñ se,</para>
  <para style="q2" vid="ISA 63:15">ke ñkoñ-ñkoñ ebekpo mfo, adisana ye ubọọñ.</para>
  <para style="q1" vid="ISA 63:15">Mmọ nsịnifịk mfo ye adudu mfo?</para>
  <para style="q2" vid="ISA 63:15">E-eben sʌñ-sʌñ ido ye mbọm mfo ikpọñ ñnyịn.<verse eid="ISA 63:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 63:16" />Ado afo ado Ete ñnyịn,</para>
  <para style="q2" vid="ISA 63:16">akpesʌkado Ebraham imiidiọọñọke ñnyịn,</para>
  <para style="q2" vid="ISA 63:16">Isrel ñko idiọọñọke ñnyịn;</para>
  <para style="q1" vid="ISA 63:16">afo, <char style="nd">Abọọñ</char>, ado Ete ñnyịn,</para>
  <para style="q2" vid="ISA 63:16">anyịñ mfo ado Ufak ñnyịn tọọñọ ke esed.<verse eid="ISA 63:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 63:17" />
    <char style="nd">Abọọñ</char>, ntaha a-afo anamma nọ ñnyịn itịn ikpọñ mme usʌñ mfo</para>
  <para style="q2" vid="ISA 63:17">anyʌñ isọñ ñnyịn esịd nọ ñnyịn ikuuteeñe fiin-e?</para>
  <para style="q1" vid="ISA 63:17">Tịmme edem di ke ntak mme isʌñutom mfo,</para>
  <para style="q2" vid="ISA 63:17">mme ubon e-edooho udeeme mfo.<verse eid="ISA 63:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 63:18" />Ke etək ini ikọd mfo emaebọ adisana itie mfo enie,</para>
  <para style="q2" vid="ISA 63:18">ado idahami mme asua ñnyịn esọnnọ adisana itie mfo.<verse eid="ISA 63:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 63:19" />Ñnyịn ido ake mfo tọọñọ ke esed;</para>
  <para style="q2" vid="ISA 63:19">ado idoho afo akara ammọ,</para>
  <para style="q2" vid="ISA 63:19">awo ikoodo ammọ idian anyịñ mfo.<verse eid="ISA 63:19" /></para>
  <para style="b" />
  <para style="b" />
  <chapter eid="ISA 63" />
  <chapter number="64" style="c" sid="ISA 64" />
  <para style="q1">
    <note caller="+" style="f">
      <char style="fr" closed="false">64: </char>
      <char style="ft" closed="false">Ke ikpañwed Hibru Ais 64:1 ewet nte Ais 63:19b, ye Ais 64:2-12 ewet nte Ais 64:1-11. </char>
    </note> <verse number="1" style="v" sid="ISA 64:1" />Sai, akpekapado afo ayaawai mme hefịn anyʌñ asọiyọ adi,</para>
  <para style="q2" vid="ISA 64:1">nọ mme ikpọabod ekpenyeeñe ke iso mfo!<verse eid="ISA 64:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 64:2" />Nte naña ikañ ata mme ñkọk eto,</para>
  <para style="q2" vid="ISA 64:2">anyʌñ anam mmọọñ afịt,</para>
  <para style="q1" vid="ISA 64:2">sọiyọ di dinam yak mme asua ediọọñọ anyịñ mfo,</para>
  <para style="q2" vid="ISA 64:2">nyʌñ nam mme idịd enyeñ ke iso mfo!<verse eid="ISA 64:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 64:3" />Sia ke ini afo akenamma mme utịppe ñkpọ a-ñnyịn imiikibekke anyen,</para>
  <para style="q2" vid="ISA 64:3">afo amaasọiyọ adi, ndin mme ikpọabod emaenyeeñe ke iso mfo.<verse eid="ISA 64:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 64:4" />Atọọñọ ke mme ini esed akenam awo ndomokeed ikoppo,</para>
  <para style="q2" vid="ISA 64:4">utọñ ndomokeed ikoppo,</para>
  <para style="q1" vid="ISA 64:4">anyen ndomokeed ikịtte Abasi mfen ke imiibọhọke afo,</para>
  <para style="q2" vid="ISA 64:4">a-anamma ñkpọ anọọ mbon e-etieghe ebet anye.<verse eid="ISA 64:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 64:5" />Afo ado unwam anọ mbon se inam eti ke idadesịd,</para>
  <para style="q2" vid="ISA 64:5">e-etoiyoke mme usʌñ mfo.</para>
  <para style="q1" vid="ISA 64:5">Ado ke ini ñnyịn ikikaaha iso inam idiọọkñkpọ ye ammọ,</para>
  <para style="q2" vid="ISA 64:5">afo amaayat esịd.</para>
  <para style="q2" vid="ISA 64:5">Die ndin ke ñnyịn ikeme adibọkkọ?<verse eid="ISA 64:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 64:6" />Afịd ñnyịn imikappa iba nte ndedeghe ibon,</para>
  <para style="q2" vid="ISA 64:6">ndin afịd ndinen adinam ñnyịn etie nte mbaad ntaaha afọñ;</para>
  <para style="q1" vid="ISA 64:6">afịd ñnyịn imaiyeeme nte mfañ,</para>
  <para style="q2" vid="ISA 64:6">ñko nte afịm mme idiọọkñkpọ ñnyịn ikwọọk ñnyịn eduọọk.<verse eid="ISA 64:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 64:7" />Awo ndomokeed ikoodo anyịñ mfo,</para>
  <para style="q2" vid="ISA 64:7">inyʌññọ idomo ukeme adumʌm fiin ñkama;</para>
  <para style="q1" vid="ISA 64:7">sia afo amedịp iso mfo ibaaha ñnyịn,</para>
  <para style="q2" vid="ISA 64:7">amenyʌñ iyaak ñnyịn anọ mme idiọọkñkpọ ñnyịn.<verse eid="ISA 64:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ISA 64:8" />Kpayeado afo, <char style="nd">Abọọñ</char>, ado Ete ñnyịn.</para>
  <para style="q2" vid="ISA 64:8">Ñnyịn ido aduañ, afo ado abodabañ;</para>
  <para style="q2" vid="ISA 64:8">afịd ñnyịn ido mme utom ubọk mfo.<verse eid="ISA 64:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 64:9" />
    <char style="nd">Abọọñ</char>, kuuyat esịd ubọhọ adaña;</para>
  <para style="q2" vid="ISA 64:9">kuutoiyo mme idiọọkñkpọ ñnyịn ke nsi-nsi.</para>
  <para style="q1" vid="ISA 64:9">O! Ñnyịn imukpe fiin ubọk, ise ñnyịn,</para>
  <para style="q2" vid="ISA 64:9">sia afịd ñnyịn ido ikọd mfo.<verse eid="ISA 64:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 64:10" />Mme ndisana abio mfo ekappa anaan isọñ;</para>
  <para style="q2" vid="ISA 64:10">idem Saiyọn ado anaan isọñ, Yeruselem ñwuudo abio.<verse eid="ISA 64:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 64:11" />Adisana tembịd ubọọñ ñnyịn, a-mme ete ñnyịn ekesutooroke fiin,</para>
  <para style="q2" vid="ISA 64:11">efọp ke ikañ,</para>
  <para style="q2" vid="ISA 64:11">ndin afịd mme ñkpọuto ñnyịn ebiaña ebono ke isọñ.<verse eid="ISA 64:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 64:12" />Ke afịd ami emaeboiyo, <char style="nd">Abọọñ</char>, afo ayaamʌm idem mfo akama?</para>
  <para style="q2" vid="ISA 64:12">Afo ayaadop uyio anyʌñ imia ñnyịn ufen aboiyo adaña?<verse eid="ISA 64:12" /></para>
  <chapter eid="ISA 64" />
  <chapter number="65" style="c" sid="ISA 65" />
  <para style="s1">Ubiereikpe ye Adinyaaña</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 65:1" />“Ami mmaayaara idem mmi nnọ mbon i-imiikibịppe imbaña miin;</para>
  <para style="q2" vid="ISA 65:1">mbon i-imiikiñyemme miin emaeñkịt miin.</para>
  <para style="q1" vid="ISA 65:1">Idịd i-imiikikoodo anyịñ mmi,</para>
  <para style="q2" vid="ISA 65:1">ami mmaabo, ‘Se miin mi, se miin mi.’<verse eid="ISA 65:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 65:2" />Afịd usen ami mmenyanna ubọk mmi</para>
  <para style="q2" vid="ISA 65:2">nnọ mbon nsọñiwuod,</para>
  <para style="q1" vid="ISA 65:2">e-esañake ke mme usʌñ i-imiifọnnọ,</para>
  <para style="q2" vid="ISA 65:2">efeghe ekeene udọñ akikere ammọ,<verse eid="ISA 65:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 65:3" />mbon e-ekaaha iso eñyat miin esịd,</para>
  <para style="q2" vid="ISA 65:3">kpa ke iso mmi,</para>
  <para style="q1" vid="ISA 65:3">enam mme uwa ke mme inwañ,</para>
  <para style="q2" vid="ISA 65:3">enyʌñ efọp insensi ke akpokoro uwa a-ntək itiad ubọbufọk;<verse eid="ISA 65:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 65:4" />e-etieghe ke mme udi,</para>
  <para style="q2" vid="ISA 65:4">ekama mme akonayio ammọ etaba ndedịbe idab;</para>
  <para style="q1" vid="ISA 65:4">e-etaaha abʌk edi,</para>
  <para style="q2" vid="ISA 65:4">a-mme ako ndidia ammọ edọñọke unam ye ñkọñ i-imiisanake;<verse eid="ISA 65:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 65:5" />mbon e-ebooho, ‘Sanna da; kuudi uñkpere miin,</para>
  <para style="q2" vid="ISA 65:5">sia ami mmesana ñkan se afo akpere!’</para>
  <para style="q1" vid="ISA 65:5">Mme utọ ibon ntoro edo nsʌñikañ ke mme aduiwuo mmi,</para>
  <para style="q2" vid="ISA 65:5">ikañ a-akaaha iso asak afịd usen.<verse eid="ISA 65:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ISA 65:6" />“Se, ewet anye edaaha ke iso mmi:</para>
  <para style="q2" vid="ISA 65:6">ami ndiidoppo uyio, ado ñyaasio ammọ usiene ayọhọ-ayọhọ;</para>
  <para style="q2" vid="ISA 65:6">ami ñyaasio usiene nsịn ke mme ifʌkkọ ammọ,<verse eid="ISA 65:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 65:7" />mme ndiọiñkpọ ndufo ye mme ndiọiñkpọ mme eteete ndufo,”</para>
  <para style="q2" vid="ISA 65:7">
    <char style="nd">Abọọñ</char> atañ.</para>
  <para style="q1" vid="ISA 65:7">“Sia ammọ emaefọp uwa ke mme ikpọabod,</para>
  <para style="q2" vid="ISA 65:7">enyʌñ emmiom miin ke mme anyọñ ntək abod,</para>
  <para style="q1" vid="ISA 65:7">ami ñyaadomo ayọhọ ekọmudua ke mme ñkaan adinam ammọ</para>
  <para style="q2" vid="ISA 65:7">ndọñ ke ifʌkkọ ammọ.”<verse eid="ISA 65:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 65:8" />Se <char style="nd">Abọọñ</char> atañ ado ami:</para>
  <para style="q1" vid="ISA 65:8">“Kpa naña ekịt ufa mmịn ke eboho fain</para>
  <para style="q2" vid="ISA 65:8">ndin mme awo ebo, ‘Kuusobo anye,</para>
  <para style="q2" vid="ISA 65:8">mfọn mmọdo asʌk asịne ke anye,’</para>
  <para style="q1" vid="ISA 65:8">kpa ntoro ke ndiinam mbaña mme isʌñutom mmi;</para>
  <para style="q2" vid="ISA 65:8">ami ndiisoboke ammọ afịd.<verse eid="ISA 65:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 65:9" />Ami ñyaaben mme ubon e-etooho Yekọb,</para>
  <para style="q2" vid="ISA 65:9">ye Yuda, mbon se idiiben mme ikpọabod mmi inie;</para>
  <para style="q1" vid="ISA 65:9">mme ndimek ikọd mmi eyaeben ammọ enie,</para>
  <para style="q2" vid="ISA 65:9">do ñko ke mme isʌñutom mmi ediidʌñ.<verse eid="ISA 65:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 65:10" />Sarọn ayaakappa ado awawa mbid anọ mme ufene,</para>
  <para style="q2" vid="ISA 65:10">Abedeñ Akọọ ayaado itie nduọkadudu anọ mme udịmedọñ,</para>
  <para style="q2" vid="ISA 65:10">anọ ikọd mmi e-eñyemme miin.<verse eid="ISA 65:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ISA 65:11" />“Ado amaado ndufo e-ekpọññọ <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ISA 65:11">enyʌñ efre adisana ekamba abod mmi,</para>
  <para style="q1" vid="ISA 65:11">e-ebịtte akpokoro enọ Mfọniso,</para>
  <para style="q2" vid="ISA 65:11">enyʌñ edọñ ñwuaha ukọd eyọhọ mme usan enọọ Ini Iso,<verse eid="ISA 65:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 65:12" />ami ñyainịm ndufo nnọ akañkañ,</para>
  <para style="q2" vid="ISA 65:12">ndin afịd ndufo eyaeduọññọ ke afai,</para>
  <para style="q1" vid="ISA 65:12">sia ami mmaikoot ndufo ado ndufo ikibọọrọke,</para>
  <para style="q2" vid="ISA 65:12">ami mmaatañ ikọ ado ndufo ikikpañña utọñ.</para>
  <para style="q1" vid="ISA 65:12">Ndufo emaenam idiọọk ke iso mmi,</para>
  <para style="q2" vid="ISA 65:12">enyʌñ emek se iminnemme miin esịd.”<verse eid="ISA 65:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 65:13" />Ke ntoro se <char style="nd">Abọọñ</char> Andikara atañ ado ami:</para>
  <para style="q1" vid="ISA 65:13">“Mme isʌñutom mmi eyaedia ñkpọ,</para>
  <para style="q2" vid="ISA 65:13">ado ndufo eyaesaña abiọọñ;</para>
  <para style="q1" vid="ISA 65:13">mme isʌñutom mmi eyaenwọñ ñkpọ,</para>
  <para style="q2" vid="ISA 65:13">ado ndufo eyaekop nsaditọñ;</para>
  <para style="q1" vid="ISA 65:13">mme isʌñutom mmi eyaedaara,</para>
  <para style="q2" vid="ISA 65:13">ado ndufo eyaekịt abuud.<verse eid="ISA 65:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 65:14" />Mme isʌñutom mmi eyaekwọ ikwọ,</para>
  <para style="q2" vid="ISA 65:14">eto idaara a-atooho awọñesịd ammọ,</para>
  <para style="q1" vid="ISA 65:14">ado ndufo eyaetua</para>
  <para style="q2" vid="ISA 65:14">eto mfʌhọ esịd ndufo</para>
  <para style="q2" vid="ISA 65:14">enyʌñ etua eto akpọsọñ mbʌññọesịd ke sịbidịd.<verse eid="ISA 65:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 65:15" />Ndufo eyaekpọñ anyịñ ndufo</para>
  <para style="q2" vid="ISA 65:15">enọ mme ndimek mmi ekama enam mme isuuñọ ammọ;</para>
  <para style="q1" vid="ISA 65:15">
    <char style="nd">Abọọñ</char> Andikara ayauwot fiin,</para>
  <para style="q2" vid="ISA 65:15">ado amaado mme isʌñutom amọ, anye ayaanọ anyịñ mfen.<verse eid="ISA 65:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 65:16" />Awo afo ñko ayaasua anọ edeme akeedodo udianna fiin ikọ a-ayemme adidiọñ adi ke abio</para>
  <para style="q2" vid="ISA 65:16">adiinam ado ke anyịñ Abasi akpanikọ keed;</para>
  <para style="q1" vid="ISA 65:16">awo ndomokeed anwọñọke ñkpọ ke isọñ</para>
  <para style="q2" vid="ISA 65:16">adiinwọñọ ke anyịñ Abasi akpanikọ keed.</para>
  <para style="q1" vid="ISA 65:16">Sia eyaefre mme ñkaan mfịna</para>
  <para style="q2" vid="ISA 65:16">enyʌñ edịp ammọ ke anyen mmi.<verse eid="ISA 65:16" /></para>
  <para style="s1">Mme Ufa Anyọñ ye Ufa Isọñ</para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 65:17" />“Se, ami ñyaabot</para>
  <para style="q2" vid="ISA 65:17">mme ufa hefịn ye ufa ederimbod.</para>
  <para style="q1" vid="ISA 65:17">Awo idiitoiyoke mme ñkaan ñkpọ,</para>
  <para style="q2" vid="ISA 65:17">idiinyʌññọ isịne ammọ ke esịd.<verse eid="ISA 65:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 65:18" />Ado daara ñnyʌñ kop inemesịd ke nsi-nsi</para>
  <para style="q2" vid="ISA 65:18">ke se ami ñyem adibot,</para>
  <para style="q1" vid="ISA 65:18">sia ami ñyaabot Yeruselem nọ ado ñkpọ inemesịd,</para>
  <para style="q2" vid="ISA 65:18">mbon amọ ñko edo ñkpọ idadesịd.<verse eid="ISA 65:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 65:19" />Ami ñyaadaara mbaña Yeruselem,</para>
  <para style="q2" vid="ISA 65:19">ñnyʌñ ñkop inemesịd nto mbon amọ;</para>
  <para style="q1" vid="ISA 65:19">uyom ntuaña ye utua ayịd</para>
  <para style="q2" vid="ISA 65:19">awo idiikoppo do aba.<verse eid="ISA 65:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ISA 65:20" />“Tutu amama idiibaaha</para>
  <para style="q2" vid="ISA 65:20">nsekayịn a-aduuho uwem ke ñkpọ nte usen ifañ,</para>
  <para style="q2" vid="ISA 65:20">me akaanadeen i-imiiduuho uwem iyọhọ afịd isua uwem amọ;</para>
  <para style="q1" vid="ISA 65:20">anye a-akpaaha ke isua ikie</para>
  <para style="q2" vid="ISA 65:20">ediidat nte ataa etəkayịn;</para>
  <para style="q1" vid="ISA 65:20">anye a-atreke adisịm isua ikie,</para>
  <para style="q2" vid="ISA 65:20">ediidat anye nte awo isuuñọ.<verse eid="ISA 65:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 65:21" />Ammọ eyaebọp mme ufọk enyʌñ edʌñ ke esịd;</para>
  <para style="q2" vid="ISA 65:21">eyaetọ inwañ fain enyʌñ edia mfịd amọ.<verse eid="ISA 65:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 65:22" />Ammọ idiibọppọ ufọk aba nọ mbon mfen ediben edʌñ,</para>
  <para style="q2" vid="ISA 65:22">me etọ ñkpọ ndin mbon mfen edidadia.</para>
  <para style="q1" vid="ISA 65:22">Kpa naña mme usen eto eba,</para>
  <para style="q2" vid="ISA 65:22">kpa ntoro ye mme usen ikọd mmi ediido;</para>
  <para style="q1" vid="ISA 65:22">mme ndimek mmi eyaekop inem ekpeene</para>
  <para style="q2" vid="ISA 65:22">ke mme utom ubọk ammọ.<verse eid="ISA 65:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 65:23" />Ammọ idiinamma utom ikpu-ikpu,</para>
  <para style="q2" vid="ISA 65:23">ammọ idiinyʌññọ iman nditọ inọ ndiọọkiso;</para>
  <para style="q1" vid="ISA 65:23">sia ammọ ediido mbon se <char style="nd">Abọọñ</char> adiọñ,</para>
  <para style="q2" vid="ISA 65:23">ammọ ye mme ubon ammọ.<verse eid="ISA 65:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 65:24" />Mbemiso ammọ ekokoot ami ñyaabọọrọ;</para>
  <para style="q2" vid="ISA 65:24">naña ammọ esʌkkọ etatañ ikọ ami ñyaakop.<verse eid="ISA 65:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 65:25" />Ewaikọd ye ñyịn edọñ eyaedia ndidia itie keed,</para>
  <para style="q2" vid="ISA 65:25">ekpe ayaanyʌñ ata ikịm nte enañ,</para>
  <para style="q2" vid="ISA 65:25">ndin abu adiido ndidia udʌkikọd.</para>
  <para style="q1" vid="ISA 65:25">Ammọ idiinọọhọ unọmọ, idiinyʌññọ isobo</para>
  <para style="q2" vid="ISA 65:25">ke afịd ndisana ikpọabod mmi,”</para>
  <para style="q2" vid="ISA 65:25">
    <char style="nd">Abọọñ</char> atañ.<verse eid="ISA 65:25" /></para>
  <chapter eid="ISA 65" />
  <chapter number="66" style="c" sid="ISA 66" />
  <para style="s1">Ubiereikpe ye Idodanyen</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 66:1" />Se <char style="nd">Abọọñ</char> atañ ado ami:</para>
  <para style="q1" vid="ISA 66:1">“Hefịn ado ebekpo mmi,</para>
  <para style="q2" vid="ISA 66:1">isọñ anyʌñ ado udodukod mmi.</para>
  <para style="q1" vid="ISA 66:1">Akee ado ufọk se afo uduubọp unnọ miin?</para>
  <para style="q2" vid="ISA 66:1">Ñke adiido itie nduọkadudu mmi?<verse eid="ISA 66:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 66:2" />Idooho ubọk mmi akenañña afịd mme ñkpọ ami,</para>
  <para style="q2" vid="ISA 66:2">ndin ammọ edibañña?”</para>
  <para style="q2" vid="ISA 66:2">
    <char style="nd">Abọọñ</char> atañ anwa-anwa.</para>
  <para style="b" vid="ISA 66:2" />
  <para style="q1" vid="ISA 66:2">“Mbon se ami nse ke anyen mfọn edo ami:</para>
  <para style="q2" vid="ISA 66:2">mbon se isuuhọ idem inyʌñ inie mbʌññọesịd ke sịbidịd,</para>
  <para style="q2" vid="ISA 66:2">ye mbon se ikọ mmi anyeñ amọ idem.<verse eid="ISA 66:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 66:3" />Ado awo akeedodo a-awaaha ayaaraenañ</para>
  <para style="q2" vid="ISA 66:3">aba nte keed ke atu mbon e-ewotto awo,</para>
  <para style="q1" vid="ISA 66:3">ñko awo akeedodo a-awaaha ñyịn edọñ</para>
  <para style="q2" vid="ISA 66:3">aba nte awo a-abuuñọ ewa itọñ;</para>
  <para style="q1" vid="ISA 66:3">awo akeedodo a-anamma uwa abakpa</para>
  <para style="q2" vid="ISA 66:3">aba nte awo a-awaaha iyiib edi,</para>
  <para style="q1" vid="ISA 66:3">ñko awo akeedodo a-afọppọ insensi aditoiyo</para>
  <para style="q2" vid="ISA 66:3">aba nte keed ke atu mme akpono ndem.</para>
  <para style="q1" vid="ISA 66:3">Ammọ emek usʌñ ammọ,</para>
  <para style="q2" vid="ISA 66:3">ammọ enyʌñ ekop inemesịd ke mme mbubiam ammọ;<verse eid="ISA 66:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 66:4" />ke ntoro ami ñko ñyaamek nsaad ufen nnọ ammọ</para>
  <para style="q2" vid="ISA 66:4">ñyaanyʌñ nnọ ammọ se ammọ ebaak.</para>
  <para style="q1" vid="ISA 66:4">Sia idaha añkekoodo, awo ndomokeed ikibọọrọke,</para>
  <para style="q2" vid="ISA 66:4">idaha a-ñketañña ikọ, awo ndomokeed ikikpañña utọñ.</para>
  <para style="q1" vid="ISA 66:4">Ammọ emaenam idiọọk ke iso mmi,</para>
  <para style="q2" vid="ISA 66:4">enyʌñ emek se iminnemme miin esịd.”<verse eid="ISA 66:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ISA 66:5" />Ikop ikọ <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="ISA 66:5">ndufo e-enyekke idem ke ikọ amọ:</para>
  <para style="q1" vid="ISA 66:5">“Mbon mfo u-usuaha fiin,</para>
  <para style="q2" vid="ISA 66:5">enyʌññọ usio fiin efep ke ntak anyịñ mmi, ebo,</para>
  <para style="q1" vid="ISA 66:5">‘Yak <char style="nd">Abọọñ</char> abọ ubọọñ,</para>
  <para style="q2" vid="ISA 66:5">nọ ato do ñnyịn ikịt idaara mfo!’</para>
  <para style="q2" vid="ISA 66:5">Ado ammọ eyaekop abuud.<verse eid="ISA 66:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 66:6" />Kop ñkpoyo a-atooho abio,</para>
  <para style="q2" vid="ISA 66:6">kop uyom a-atooho tembịd!</para>
  <para style="q1" vid="ISA 66:6">Ado uyom <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="ISA 66:6">asʌkkọ akpe mme asua amọ afịd se idot ye ammọ.<verse eid="ISA 66:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ISA 66:7" />“Mbemiso ubiakuman atuuk anye,</para>
  <para style="q2" vid="ISA 66:7">anye aman ayịn;</para>
  <para style="q1" vid="ISA 66:7">mbemiso ubiak adi adisịme anye,</para>
  <para style="q2" vid="ISA 66:7">anye amaaman ayịn awodeen.<verse eid="ISA 66:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 66:8" />Anie akenam akop mme utọ ñkpọ ami?</para>
  <para style="q2" vid="ISA 66:8">Anie akenam akịt mme ñkpọ se iba ntom?</para>
  <para style="q1" vid="ISA 66:8">Nte abio akeme adimana ke usen keed,</para>
  <para style="q2" vid="ISA 66:8">me ekeme edinam idịd aba ke etək-etək ini?</para>
  <para style="q1" vid="ISA 66:8">Kpayeado ikpeeneke Saiyọn atọọñọ uman</para>
  <para style="q2" vid="ISA 66:8">ke anye amanna nditọ amọ.<verse eid="ISA 66:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 66:9" />Nte ami mmenam uman atuuk awonwaan</para>
  <para style="q2" vid="ISA 66:9">ndin nnamma nọ aman?”</para>
  <para style="q2" vid="ISA 66:9">
    <char style="nd">Abọọñ</char> atañ.</para>
  <para style="q1" vid="ISA 66:9">“Me ami ñkpasiit idịb</para>
  <para style="q2" vid="ISA 66:9">ke ini mmaanam uman akweeñe?”</para>
  <para style="q2" vid="ISA 66:9">Abasi mfo atañ.<verse eid="ISA 66:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 66:10" />“Idaara ye Yeruselem inyʌñ ikop inemesịd ye anye,</para>
  <para style="q2" vid="ISA 66:10">afịd ndufo se ema anye;</para>
  <para style="q1" vid="ISA 66:10">idaara ekamba-ekamba ye anye,</para>
  <para style="q2" vid="ISA 66:10">afịd ndufo se efʌhọ ebaña anye.<verse eid="ISA 66:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 66:11" />Sia ndufo eyaebọọk enyʌñ ekop uyʌkkọ</para>
  <para style="q2" vid="ISA 66:11">ke mme eba idọñesịd amọ;</para>
  <para style="q1" vid="ISA 66:11">ndufo eyaenwọñ ayọhọ-ayọhọ</para>
  <para style="q2" vid="ISA 66:11">enyʌñ enem esịd ebaña ufọfiọọrọ akpọmiọk inie amọ.”<verse eid="ISA 66:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 66:12" />Sia se <char style="nd">Abọọñ</char> atañ ado ami:</para>
  <para style="q1" vid="ISA 66:12">“Ami ñyaayaak emem nnọ anye nte inyañ,</para>
  <para style="q2" vid="ISA 66:12">ye inie mme idịd nte idịm a-afiọọrọke;</para>
  <para style="q1" vid="ISA 66:12">ndin ndufo eyaewọp eba, enyʌñ iben ndufo ekama ke ubọk amọ,</para>
  <para style="q2" vid="ISA 66:12">enyʌñ item ndufo ke edọñ amọ.<verse eid="ISA 66:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 66:13" />Naña eka adọñ ayịn amọ esịd,</para>
  <para style="q2" vid="ISA 66:13">kpa ntoro ke ami ndiidọñ ndufo esịd;</para>
  <para style="q2" vid="ISA 66:13">ndufo eyaenyʌñ ekop ndọñesịd ebaña Yeruselem.”<verse eid="ISA 66:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ISA 66:14" />Ndufo emaekịt ami, esịd ndufo ayaadaara,</para>
  <para style="q2" vid="ISA 66:14">ndin ndufo eyaenyʌñ efiọọrọ nte mbid;</para>
  <para style="q1" vid="ISA 66:14">ubọk <char style="nd">Abọọñ</char> ayaayaara anọ mme isʌñutom amọ,</para>
  <para style="q2" vid="ISA 66:14">ado anye ayaawọt mme asua amọ iyadesịd amọ.<verse eid="ISA 66:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 66:15" />Se, <char style="nd">Abọọñ</char> asʌk adi ye ikañ,</para>
  <para style="q2" vid="ISA 66:15">ndin mme sariọd amọ eba nte afịm ayobio;</para>
  <para style="q1" vid="ISA 66:15">anye ayaawọt iyadesịd amọ ye ifiobesịd,</para>
  <para style="q2" vid="ISA 66:15">anyʌñ atʌnọ ye mme edemeikañ.<verse eid="ISA 66:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 66:16" />Sia ye ikañ ye akañkañ amọ</para>
  <para style="q2" vid="ISA 66:16">
    <char style="nd">Abọọñ</char> ayaanam ubiideikpe ye afịd awo,</para>
  <para style="q2" vid="ISA 66:16">ndin mbon se <char style="nd">Abọọñ</char> adiiwot eyaewak.<verse eid="ISA 66:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 66:17" />“Mbon se itịm idem ammọ inịm asana edika mme inwañ, e-ekeeneke awo a-abaaha ke atu mbon se ita abʌk edi, mme ekpu ye mme ndedeghe ñkpọ mfen, eyaediana keed ye anye a-ammọ ekeeneke ekịt nsobo ammọ,” <char style="nd">Abọọñ</char> atañ.<verse eid="ISA 66:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 66:18" />“Ndin ami, ke ntak se ammọ edioomo enyʌñ enam, ami ñyaadi ndikoono mme awo ke afịd idịd ye mme usem, ndin ammọ eyaedikịt ubọọñ mmi.<verse eid="ISA 66:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 66:19" />“Ami ñyaanịm idiọọñọ ke atu ammọ, ami ñyaanyʌñ ndọñ usʌk mbon se ibọkkọ nọ eka mme idịd, eka Taasis, eka ebịne mbon Libia ye mbon Lidia (e-ewuọhọ etob nte mbon utob idañ), eka Tubal ye Kriis, enyʌñ eka mme abio isu i-imiikoppo etob mmi inyʌññọ ikịt ubọọñ mmi. Ammọ eyaekwọrọ ubọọñ mmi ke atu mme idịd. <verse eid="ISA 66:19" /><verse number="20" style="v" sid="ISA 66:20" />Ndin ammọ eyaeben afịd ikọd mfo edi, eto afịd mme idịd, edi adisana ekamba abod mmi ke Yeruselem nte enọ se ammọ enọ <char style="nd">Abọọñ</char>, edoro ke anyọñ enañmbakara, ke mme sariọd ye mme ukpadñkpọ, ye ke mme ñyịn enañ ye mme kamel,” <char style="nd">Abọọñ</char> atañ. “Ammọ eyaeben ammọ edi, nte nditọ Isrel eben mme enọ abakpa ammọ, edọñ ke nsaana iko e-esikamake ke usen usọrọ edi ke tembịd <char style="nd">Abọọñ</char>. <verse eid="ISA 66:20" /><verse number="21" style="v" sid="ISA 66:21" />Ndin ami ñyaasio usʌk ammọ ñko yak edo mme aku ye mme Lifai,” se <char style="nd">Abọọñ</char> atañ ado ami.<verse eid="ISA 66:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="ISA 66:22" />“Naña mme ufa anyọñ ye ufa ederimbod a-ami nnamma adiikpeene ke iso mmi, kpa ntoro ke anyịñ mfo ye ake nditọnditọ mfo ediikpeene,” <char style="nd">Abọọñ</char> atañ. <verse eid="ISA 66:22" /><verse number="23" style="v" sid="ISA 66:23" />“Tọọñọ ke Ufa Afiọñ keed wuọ mfen, nyʌñ tọọñọ ke Sabad keed wuọ mfen, afịd ubonawo eyaedi edinyuuk iwuod ke iso mmi,” <char style="nd">Abọọñ</char> atañ ami. <verse eid="ISA 66:23" /><verse number="24" style="v" sid="ISA 66:24" />“Ndin ammọ eyaewuọ ekese akpo mbon e-ekesọññọ iwuod ye ami; mme utʌñ e-etaaha ammọ idiikpaaha, ikañ a-ataaha ammọ idiinịmeke, ndin ammọ ediido ñkpọ ekamba itekesịd enọ afịd ubonawo.”<verse eid="ISA 66:24" /></para>
  <chapter eid="ISA 66" />
</usx>