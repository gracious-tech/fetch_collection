  <para style="h">Habakuk</para>
  <para style="toc1">Habakuk</para>
  <para style="toc2">Habakuk</para>
  <para style="toc3">Hab</para>
  <para style="mt1">Habakuk</para>
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />Ñkukịd a-Prọfed Habakuk Akebọọhọ.<verse eid="HAB 1:1" /></para>
  <para style="b" />
  <para style="s1">Mfịna Habakuk</para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 1:2" />
    <char style="nd">Abọọñ</char>, adiikpeene die ami adikoot ñyem unwam,</para>
  <para style="q2" vid="HAB 1:2">ado afo ukpañña utọñ?</para>
  <para style="q1" vid="HAB 1:2">Me aditua unọ fiin mbaña, “Afai!”</para>
  <para style="q2" vid="HAB 1:2">ado afo uñnyaañake?<verse eid="HAB 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 1:3" />Ntak a-afo anamma nọ ami ñkịt ukwaññkpọ-ọ?</para>
  <para style="q2" vid="HAB 1:3">Ntak afo ayọọhọ idiọọkñkpọ-ọ?</para>
  <para style="q1" vid="HAB 1:3">Nsobo ye afai eba ke iso mmi;</para>
  <para style="q2" vid="HAB 1:3">utọk a-aba, ndin anwan ayọyọhọ.<verse eid="HAB 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 1:4" />Ke ntoro mbed akpa ubeñ keed,</para>
  <para style="q2" vid="HAB 1:4">ndin unenikpe ibaaha aba.</para>
  <para style="q1" vid="HAB 1:4">Mbon ibak e-ekanna nti awo ekʌk,</para>
  <para style="q2" vid="HAB 1:4">nọ ato do enam ukwañ ikpe.<verse eid="HAB 1:4" /></para>
  <para style="s1">Ibọọrọ <char style="nd">Abọọñ</char></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 1:5" />“Se mme idịd nyʌñ tịñ anyen se,</para>
  <para style="q2" vid="HAB 1:5">nyʌñ ba ke ataa ñkpaidem.</para>
  <para style="q1" vid="HAB 1:5">Sia ami ñyaanam ñkpọ ke emana ndufo,</para>
  <para style="q2" vid="HAB 1:5">a-ndufo imiidiinịmme ke akpanikọ,</para>
  <para style="q2" vid="HAB 1:5">akpekọm ekpekidọọdọkkọ ndufo.<verse eid="HAB 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 1:6" />Ami ñyaabenne mbon Babilọn ke anyọñ,</para>
  <para style="q2" vid="HAB 1:6">mbon unana mbọm ye mbon afai,</para>
  <para style="q1" vid="HAB 1:6">e-esaañake ke afịd ederimbod</para>
  <para style="q2" vid="HAB 1:6">nọ ebọi ufọkidʌñ i-imiidooho ake ammọ.<verse eid="HAB 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 1:7" />Ammọ edoñño mbon se ebaak enyʌñ ekop ndịk ebaña;</para>
  <para style="q2" vid="HAB 1:7">ammọ edoñño mbed enọ idem ammọ</para>
  <para style="q2" vid="HAB 1:7">enyʌñ edịppe ubọọñ ammọ.<verse eid="HAB 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 1:8" />Mme enañmbakara ammọ esọp ekan anawịdekpe,</para>
  <para style="q2" vid="HAB 1:8">efaiya ekan ewaikọd ke akonayio.</para>
  <para style="q1" vid="HAB 1:8">Mbon udoro ke anyọñ enañmbakara ammọ esịn iwuod etaam;</para>
  <para style="q2" vid="HAB 1:8">mbon uwad enañmbakara ammọ eto anyan usʌñ.</para>
  <para style="q1" vid="HAB 1:8">Ammọ efuurọ nte ntrukpuum asọiyọ ke usọp afʌk ndita;<verse eid="HAB 1:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="HAB 1:9" />afịd ammọ edi ye akikere afai.</para>
  <para style="q1" vid="HAB 1:9">Mme udịm ammọ esaña nte idio ke akpautatan</para>
  <para style="q2" vid="HAB 1:9">enyʌñ etañ mbon ñkpakọb ebon nte ntan.<verse eid="HAB 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 1:10" />Ammọ esak mme ndidem esaha</para>
  <para style="q2" vid="HAB 1:10">enyʌñ ese mme mbọọñ ke ndek.</para>
  <para style="q1" vid="HAB 1:10">Ammọ esak afịd ñkpọsọñ abio;</para>
  <para style="q2" vid="HAB 1:10">ke adidat ntan mbọp usʌñisañ ammọ ekan ammọ.<verse eid="HAB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 1:11" />Akem ammọ esaña eboiyo nte afịm, enyʌñ ekaa iso-iso,</para>
  <para style="q2" vid="HAB 1:11">mbon ndudue, a-adudu ammọ adooho abasi ammọ.”<verse eid="HAB 1:11" /></para>
  <para style="s1">Mfịna Habakuk Ayọhọ Iba</para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 1:12" />
    <char style="nd">Abọọñ</char>, nte afo ukubaaha tọọñọ ke nsi-nsi?</para>
  <para style="q2" vid="HAB 1:12">Abasi mmi, kpa Adisana mmi, afo uduukpaaha ke nsi-nsi.</para>
  <para style="q1" vid="HAB 1:12">
    <char style="nd">Abọọñ</char>, afo akenịm ammọ nọ ekpe ikpe;</para>
  <para style="q2" vid="HAB 1:12">afo, Akwa Itiad mmi, akenịm ammọ nọ emia awo ufen.<verse eid="HAB 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 1:13" />Anyen mfo esana ekan se ekpese idiọọk;</para>
  <para style="q2" vid="HAB 1:13">afo ukemeke inyịmme idiọọk adinam.</para>
  <para style="q1" vid="HAB 1:13">Ntak a-afo anyịmmeke anọọ mbon abiaña-a?</para>
  <para style="q2" vid="HAB 1:13">Ntak a-afo adoppo uyio ke ini mbon ibak</para>
  <para style="q2" vid="HAB 1:13">efiighe mbon e-enieghe nti ido-o?<verse eid="HAB 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 1:14" />Afo amenam mme awo ekappa etie nte iyak ke akpainyañ,</para>
  <para style="q2" vid="HAB 1:14">nte mme unam ke akpainyañ i-imiinieghe andikara.<verse eid="HAB 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 1:15" />Idiọọk asua adʌt afịd ammọ ke mme uwaam asio,</para>
  <para style="q2" vid="HAB 1:15">anye amʌm ammọ ke iyịre amọ,</para>
  <para style="q1" vid="HAB 1:15">a-adọñ ammọ ke ukpadiyịre amọ;</para>
  <para style="q2" vid="HAB 1:15">ntoro ndin anye a-adaara anyʌñ anem esịd.<verse eid="HAB 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 1:16" />Ke ntoro anye a-awa uwa anọ iyịre amọ</para>
  <para style="q2" vid="HAB 1:16">anyʌñ afọp insensi anọ ukpadiyịre amọ,</para>
  <para style="q1" vid="HAB 1:16">sia ato ke iyịre amọ anye adu inem uwem,</para>
  <para style="q2" vid="HAB 1:16">anyʌñ akop inem ato ndidia se anye amek.<verse eid="HAB 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 1:17" />Nte ana anye akaiso anwañña iyịre amọ,</para>
  <para style="q2" vid="HAB 1:17">asobo mme idịd ke unana mbọm?<verse eid="HAB 1:17" /></para>
  <para style="b" />
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="q1">
    <verse number="1" style="v" sid="HAB 2:1" />Ami ñyaada ke itie ukpeme mmi</para>
  <para style="q2" vid="HAB 2:1">ñnyʌñ nda ke anyọñ tọwa;</para>
  <para style="q1" vid="HAB 2:1">ami ñyaase se anye adiitañ innọ miin,</para>
  <para style="q2" vid="HAB 2:1">ye ibọọrọ se ami ndiinọ ke mfịna<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">Akeme ido </char><char style="fq" closed="false">ye ibọọrọ </char><char style="fqa" closed="false">se ndiinọ ke emaesua innọ</char></note> ami.<verse eid="HAB 2:1" /></para>
  <para style="s1">Ibọọrọ <char style="nd">Abọọñ</char></para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2" />Akem <char style="nd">Abọọñ</char> amaabọọrọ:</para>
  <para style="q1" vid="HAB 2:2">“Wet adiyaara ami</para>
  <para style="q2" vid="HAB 2:2">nyʌñ kap anye sịn ke mme itiadñwed</para>
  <para style="q2" vid="HAB 2:2">nọ asuanetob aben anye afeghe.<verse eid="HAB 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 2:3" />Sia adiyaara ami abet ini ekenịmme;</para>
  <para style="q2" vid="HAB 2:3">anye atañ abaña utịd,</para>
  <para style="q2" vid="HAB 2:3">idiinyʌññọ inam abiaña.</para>
  <para style="q1" vid="HAB 2:3">Akpesʌkado a-anye akpeeneke, bet anye;</para>
  <para style="q2" vid="HAB 2:3">idiitreke adidi</para>
  <para style="q2" vid="HAB 2:3">idiinyʌññọ ikpeene.<verse eid="HAB 2:3" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HAB 2:4" />“Se, asua akokko idem;</para>
  <para style="q2" vid="HAB 2:4">mme uduak esịd amọ idooho nnen-nnen,</para>
  <para style="q2" vid="HAB 2:4">ado adinen awo adiidu uwem ke akpanikọ amọ,<verse eid="HAB 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 2:5" />ke akpanikọ, ukọd abiaña anye;</para>
  <para style="q2" vid="HAB 2:5">anye ado awo ñkokkoidem inyʌññọ inie emem.</para>
  <para style="q1" vid="HAB 2:5">Sia anye adọrọitọñ nte udi,</para>
  <para style="q2" vid="HAB 2:5">anyʌñ atie nte ñkpa, ikoppo uyʌkkọ;</para>
  <para style="q1" vid="HAB 2:5">anye a-akoono afịd idịd abon anọ idem amọ,</para>
  <para style="q2" vid="HAB 2:5">anyʌñ atañ afịd awo nte ifʌn.<verse eid="HAB 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HAB 2:6" />“Nte afịd ammọ idiisakka anye imam ke ikwọ ye ke ñke, ete,</para>
  <para style="q1" vid="HAB 2:6">“ ‘Adọdiọọk anọ awo a-abonno inie e-eyịppeyịp</para>
  <para style="q2" vid="HAB 2:6">anyʌñ anam idem amọ imọ ato ñkanubọk!</para>
  <para style="q2" vid="HAB 2:6">Adiikpeene die ñkpọ ami adisʌk ikaa iso?’<verse eid="HAB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 2:7" />Nte mbon isọn mfo idiidakkake ida ini keed?</para>
  <para style="q2" vid="HAB 2:7">Nte ammọ idiidemmeke inam nọ afo anyeñ idem?</para>
  <para style="q2" vid="HAB 2:7">Ndin afo ayaakappa ado ndidia ammọ.<verse eid="HAB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 2:8" />Sia afo amaawo ñwo ye uwak idịd,</para>
  <para style="q2" vid="HAB 2:8">mbon se isʌhọ eyaenyʌñ uwo fiin ñwo.</para>
  <para style="q1" vid="HAB 2:8">Sia afo amaaduọk iyiib mme awo;</para>
  <para style="q2" vid="HAB 2:8">afo amaasobo mme isọñ ye abio ye afịd awo se idọñọ ke esịd ammọ.<verse eid="HAB 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HAB 2:9" />“Adọdiọọk anọ awo a-abọppọ ufọk amọ ke idiọọk udod,</para>
  <para style="q2" vid="HAB 2:9">a-anịmme efọk amọ ke anyọñ</para>
  <para style="q2" vid="HAB 2:9">nọ abọkkọ nsobo!<verse eid="HAB 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 2:10" />Afo amaaduak nsobo anọ uwak awo,</para>
  <para style="q2" vid="HAB 2:10">aben abuud anọ ufọk mfo anyʌñ aduọọk uwem mfo.<verse eid="HAB 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 2:11" />Mme itiad ke ndibene eyaetua,</para>
  <para style="q2" vid="HAB 2:11">ndin mme mboi e-enamma ke eto eyaebọọrọ anye.<verse eid="HAB 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="HAB 2:12" />“Adọdiọọk anọ awo a-abọppọ abio ato uduọk iyiib,</para>
  <para style="q2" vid="HAB 2:12">anyʌññọ abọp abio ke ukwañ ikpe!<verse eid="HAB 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 2:13" />Nte idooho <char style="nd">Abọọñ</char> Andikponñkan akenịm</para>
  <para style="q2" vid="HAB 2:13">ate ke utom mme awo ado ifia ubara ikañ,</para>
  <para style="q2" vid="HAB 2:13">ke mme idịd ekpañña utom enọ idem ammọ ke ikpu-ikpu?<verse eid="HAB 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 2:14" />Sia ederimbod adiiyọhọ ye ifiọk ubọọñ <char style="nd">Abọọñ</char></para>
  <para style="q2" vid="HAB 2:14">kpa naña mmọọñ afʌk akpainyañ.<verse eid="HAB 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HAB 2:15" />“Adọdiọọk anọ awo a-anọọhọ mme mbọhọidʌñ amọ ukọd nọ anwọñ,</para>
  <para style="q2" vid="HAB 2:15">a-atọkkọke anye asio ke atu ukọd tutu anye anaam ammọ,</para>
  <para style="q2" vid="HAB 2:15">nọ anye akeme adikịt ifed ammọ!<verse eid="HAB 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 2:16" />Utu ke ubọọñ abuud ayauyọhọ fiin iso.</para>
  <para style="q2" vid="HAB 2:16">Idahami ini mfo akanna adisịm! Nwọñ nyʌñ yak ifed mfo aba anwa-anwa!</para>
  <para style="q1" vid="HAB 2:16">Kọọb a-atooho ubọk nnasia <char style="nd">Abọọñ</char> asʌk akanna ubịne fiin,</para>
  <para style="q2" vid="HAB 2:16">asuenne ayaanyʌñ afʌk ubọọñ mfo.<verse eid="HAB 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 2:17" />Afai a-afo anamma ye Lebanọn ayaufʌk fiin,</para>
  <para style="q2" vid="HAB 2:17">ndin nsobo a-afo anamma mme unam ayausịn fiin ndịk.</para>
  <para style="q1" vid="HAB 2:17">Sia afo ameduọk iyiib mbon awo;</para>
  <para style="q2" vid="HAB 2:17">afo amesobo mme isọñ ye abio ye afịd awo se idọñọ ke esịd ammọ.<verse eid="HAB 2:17" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="HAB 2:18" />“Nsoo ufọn ke ubobod abasi anam anọ andibod anye?</para>
  <para style="q2" vid="HAB 2:18">Me mbid ñkpọ a-akpeebe awo nsu?</para>
  <para style="q1" vid="HAB 2:18">Sia awo a-abotto anye abuọt idem ke se ubọk amọ anam;</para>
  <para style="q2" vid="HAB 2:18">anye a-anam mme adisọi ñkpọ e-edooho imuum.<verse eid="HAB 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 2:19" />Adọdiọọk anọ awo a-abooho eto, ‘Du uwem!’</para>
  <para style="q2" vid="HAB 2:19">Me adibo ananauwem itiad, ‘Demme!’</para>
  <para style="q1" vid="HAB 2:19">Nte anye akpa akan anọ ndadusʌñ?</para>
  <para style="q2" vid="HAB 2:19">Efʌk anye ke kold ye silfa;</para>
  <para style="q2" vid="HAB 2:19">ibifịk ibaaha anye ke idem.”<verse eid="HAB 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="HAB 2:20" />
    <char style="nd">Abọọñ</char> mmọdo ke adisana tembịd amọ;</para>
  <para style="q2" vid="HAB 2:20">yak afịd ekondo edobo ke iso amọ.<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="s1">Akam Habakuk</para>
  <para style="d">
    <verse number="1" style="v" sid="HAB 3:1" />Akam Prọfed Habakuk A-asañake ye <char style="tl">Ikwọ</char>.<verse eid="HAB 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2" />
    <char style="nd">Abọọñ</char>, ami mmekop etob adudu mfo;</para>
  <para style="q2" vid="HAB 3:2">
    <char style="nd">Abọọñ</char>, mme utom mfo e-ennam miin ndịk.</para>
  <para style="q1" vid="HAB 3:2">Tịmme nam ammọ ke usen ñnyịn,</para>
  <para style="q2" vid="HAB 3:2">ke ayio ñnyịn nam ediọọñọ ammọ;</para>
  <para style="q2" vid="HAB 3:2">ke iyadesịd toiyo mbọm.<verse eid="HAB 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3" />Abasi aketo ke Teman adi,</para>
  <para style="q2" vid="HAB 3:3">Adisana Abasi aketo ke Abod Paran adi.</para>
  <para style="q1" vid="HAB 3:3">Ubọọñ amọ amaafʌk anyọñ,</para>
  <para style="q2" vid="HAB 3:3">itooro amọ anyʌñ ayọhọ ke ederimbod.<verse eid="HAB 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4" />Uku amọ akeyamma nte utịn;</para>
  <para style="q2" vid="HAB 3:4">uyamma amọ awuọñọ anye ke ubọk,</para>
  <para style="q2" vid="HAB 3:4">a-adudu amọ akedịbeke.<verse eid="HAB 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5" />Idiọọk udọñọ amaasaña anye ke iso;</para>
  <para style="q2" vid="HAB 3:5">ñkeñe idiọọk udọñọ anyʌñ akeene ñkpad isañ amọ.<verse eid="HAB 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6" />Anye amaada, anyʌñ anyeeñe ederimbod;</para>
  <para style="q2" vid="HAB 3:6">anye amaase, anyʌñ anam mme idịd enyeñ idem.</para>
  <para style="q1" vid="HAB 3:6">Mme ikpọabod esed emaesaiya mbai-mbai,</para>
  <para style="q2" vid="HAB 3:6">mme ñkaan ntək abod emaesuuhọ</para>
  <para style="q2" vid="HAB 3:6">ado anye asʌk akaka iso ke nsi-nsi.<verse eid="HAB 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7" />Ami mmaakịt mme atayad Kusan ke itie ukuud,</para>
  <para style="q2" vid="HAB 3:7">mme itie idʌñ Mbon Midian ke mfịna.<verse eid="HAB 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8" />
    <char style="nd">Abọọñ</char>, nte afo akeyat esịd ye mme inyañ?</para>
  <para style="q2" vid="HAB 3:8">Nte iyadesịd mfo akebaña mme idịm?</para>
  <para style="q1" vid="HAB 3:8">Nte afo aketọhọ ye akpainyañ</para>
  <para style="q2" vid="HAB 3:8">ke ini afo akewatta ke mme enañmbakara mfo</para>
  <para style="q2" vid="HAB 3:8">ye mme sariọd mfo akaa adikan?<verse eid="HAB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9" />Afo amaafʌkkọ utịgha mfo,</para>
  <para style="q2" vid="HAB 3:9">anyʌñ akoot ate unọ fiin uwak idañ.</para>
  <para style="q1" vid="HAB 3:9">Afo amaadat mme inyañ abakka isọñ;<verse eid="HAB 3:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="HAB 3:10" />mme ikpọabod emaukịt fiin enyʌñ emiañña.</para>
  <para style="q1" vid="HAB 3:10">Ikpọ mmọọñ edịm emaesaña eboiyo;</para>
  <para style="q2" vid="HAB 3:10">mme udem emaekuun,</para>
  <para style="q2" vid="HAB 3:10">emaenyʌñ enam akpa adakka ke anyọñ.<verse eid="HAB 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11" />Utịn ye afiọñ emaetuak eda ke anyọñ</para>
  <para style="q2" vid="HAB 3:11">ini uyamma idañ mfo a-afuurọke,</para>
  <para style="q2" vid="HAB 3:11">ke amịneñmịneñ eduad mfo.<verse eid="HAB 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12" />Ke ifiobesịd afo amaatuak isañ adʌk ederimbod;</para>
  <para style="q2" vid="HAB 3:12">ke iyadesịd afo amaanyʌñ anuak mme idịd.<verse eid="HAB 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13" />Afo amaawuọ adi adinọ ikọd mfo ñkpọkñyak,</para>
  <para style="q2" vid="HAB 3:13">adinyaaña anye a-afo akeyette adan.</para>
  <para style="q1" vid="HAB 3:13">Afo amaaboom adadusʌñ ke isọñ mbon ibak,</para>
  <para style="q2" vid="HAB 3:13">afo amaakpọk anye afọñ tọọñọ ke iwuod tutu ñkpad.<verse eid="HAB 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14" />Afo amaadat eduad amọ akịm anye iwuod</para>
  <para style="q2" vid="HAB 3:14">ke ini mbon ekọñ amọ ekebịmmeke edi adisuan ñnyịn,</para>
  <para style="q1" vid="HAB 3:14">esaña uko-uko nte eyem adita</para>
  <para style="q2" vid="HAB 3:14">mbon mbaba e-ekebaaha ke itie udịbe.<verse eid="HAB 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15" />Afo amaasọnnọ akpainyañ ye mme enañmbakara mfo,</para>
  <para style="q2" vid="HAB 3:15">anyʌñ abəkko mme ikpọ mmọọñ.<verse eid="HAB 3:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16" />Ami mmaakop ndin esịd mmi anyʌñ atịmede,</para>
  <para style="q2" vid="HAB 3:16">ñkpọkinua mmi anyeñ ke uyom ado;</para>
  <para style="q1" vid="HAB 3:16">mme akpọ mmi eyeeme,</para>
  <para style="q2" vid="HAB 3:16">ukod anyʌñ anyeñ.</para>
  <para style="q1" vid="HAB 3:16">Ado ñyaabet ke ime tutu usen afanekọñ</para>
  <para style="q2" vid="HAB 3:16">a-adiidi ibịne mbon se idinwana ye ñnyịn.<verse eid="HAB 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17" />Akpesʌkado eto fik idiisioho mfịd</para>
  <para style="q2" vid="HAB 3:17">ndin kreb ibaaha ke fain,</para>
  <para style="q1" vid="HAB 3:17">akpesʌkado mfịd ọlif akpu,</para>
  <para style="q2" vid="HAB 3:17">ndin mme inwañ inwịmme se edia,</para>
  <para style="q1" vid="HAB 3:17">akpesʌkado edọñ imiibaaha ke abaedọñ,</para>
  <para style="q2" vid="HAB 3:17">mme enañ inyʌññọ iba ke abaenañ,<verse eid="HAB 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18" />ado ami ñyaadaara ke <char style="nd">Abọọñ</char>,</para>
  <para style="q2" vid="HAB 3:18">ami ñyaakop inem ke Abasi Andinyaaña mmi.<verse eid="HAB 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19" />
    <char style="nd">Abọọñ</char> Andikara ado adudu mmi;</para>
  <para style="q2" vid="HAB 3:19">anye anam ukod mmi atie nte ukod edob,</para>
  <para style="q2" vid="HAB 3:19">anye annọ miin ukeme adisaña ke ataa ñkoñ-ñkoñ itie.</para>
  <para style="d" vid="HAB 3:19">Ake adadusʌñ ke ubre ikwọ. Ke mme ndido ñkukwak mmi.<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>