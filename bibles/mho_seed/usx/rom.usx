<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">ROMANS - Kwamashi 2022</book>
  <para style="h">AkwaRoma</para>
  <para style="toc1">Diñoro dya Paulu kwa AkwaRoma</para>
  <para style="toc2">AkwaRoma</para>
  <para style="toc3">Rom</para>
  <para style="mt2">Diñoro dya Paulu kwa</para>
  <para style="mt1">AkwaRoma</para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="rem">MN, TC, MN, HS, MB, RS, CC, glosses checked</para>
  <para style="s1">Kuvumenena</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />Yame no Paulu mupika Krisitu Yesu, oyu na ethsiwa kwikara kanganda no ku torweriwa ku rongithsa Muthzimbu Ouwa wa Nyambi, <verse eid="ROM 1:1" /><verse number="2" style="v" sid="ROM 1:2" />ou a kumbwethzire kukare kakwakukethzenthzi mu Mañoro oakenu. <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />Ou Muthzimbu Ouwa po waa amba keyi ya Mwane, oyu werekiwire konu wenthzi mu mukuta wa Fumu Davida. <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />Wa monaharithsiwire ci Mwana Nyambi ou a pinduriwire kwafu kokoro o Mupepo Oukenu, yodiyo Yesu Krisitu Fumu wetu. <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />Kenthzi aye, twaa tambura thsihemo nokoro o kwikara tunganda ku tongwera matunga oahe eyi naa wa tendera Nyambi ci a tawe no ku mu yuvera, ci a rete direma ku dithzina dyenthzi. <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />Eyi yaa pakerera namwe amwe na mwithsiwa kwikara anua Yesu Krisitu.<verse eid="ROM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />Naa ñorera mwahe amwe mu di mu Roma, amwe mu na shimiwa kwa Nyambi no kwithsiwa ci anuenthzi owakenu.<figure style="fig" alt="Paul writing" file="cn02078c.tif" size="col" loc="Rom 1:1-7" copy="Cook" ref="1.1-7">Paulu aa ñora</figure></para>
  <para style="p" vid="ROM 1:7">Nyambi Tata wetu na Fumu Yesu Krisitu a mi pe thsihemo no thsiyaro.<verse eid="ROM 1:7" /></para>
  <para style="s1">Paulu aa fota ku ka hungera ku Roma</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />Thso kutanga, naa kanderera kwa Nyambi wange mwa Yesu Krisitu mukaci kenu mwahe, inene anu mu kaye kokahe aa tongaura yo thsitawo thsenu ku kwenthzi. <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />Nyambi aa twethsa ku pa ombangi ci eyi ni amba ya shemwa, aye oyu ni kwamena ko mucima wange ouhe ko ku rongithsa Muthzimbu Ouwa wa Mwane. Na dimuka ci naa mi rombereranga thsikati thsothsihe. <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />Thsimweya kweyi ni na rombereranga po naa rombanga Nyambi ci keshima yenthzi, a roithse wangu dikuñwa na ni mi hungerithse.<verse eid="ROM 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 1:11" />Inene naa fota nene ci nga na ni mi hungerithse ci na ni mi pe thsipa thso Mupepo wa Nyambi, ethsi nga thsi mi tanarithsa. <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />Naa fota ci amwe name twa ku na citanarithse oandu ko thsitawo thsetu.<verse eid="ROM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13" />Andengenu, naa fota ci mu dimuke ci na ni fotanga rorungi ku na mi hungerithsa, unone na ni kwangithsiwanga shime pano. Naa fota ku na kwama mu kaci kenu no ku na mona ima yo Mupepo, eci edi na ni i mono mu kaci kAnukenge amweya.<verse eid="ROM 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 1:14" />Ni nangiwa ku rongithsa anu wahe, ikare Magerike nji akwakuthsiarera, ikare owanyanyami nji etomba. <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />Mweyo, naa fota nene ku na mi honga Muthzimbu Ouwa wa Nyambi namwe amwe mu di mu Roma.<verse eid="ROM 1:15" /></para>
  <para style="s1">Okoro o Muthzimbu Ouwa</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />Ka ni fererire honyi Muthzimbu Ouwa, inene odiyo okoro wa Nyambi o ku yoyithsa awa a tawa wahe, ku tanga Majuda mbeci ku keye Anukenge.<note caller="+" style="f"><char style="fr" closed="false">1.16 </char><char style="ft" closed="false">Magerike.</char></note> <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />Inene mou Muthzimbu Ouwa, owawa wa Nyambi waa hokoriwa ohura na hura ko thsitawo. Eci edi aa amba Mañoro ci: “Owawawa kenge mba yoya ko thsitawo.<note caller="+" style="f"><char style="fr" closed="false">1.17 </char><char style="ft" closed="false">Nji ci “Oyu tendiwa o muwawa ko thsitawo kenge a ku yoya.”</char></note>”<verse eid="ROM 1:17" /></para>
  <para style="s1">Oanthzi wa Nyambi kwanu owamango</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />Inene oanthzi wa Nyambi waa hokoriwa ku tunda ku wiru, ku na rwithsa thsivi nomango yoihe yanu, awa a na dyaterera oshemwa komango wo. <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />Eyi a na roera ku dimuka anu keyi ya Nyambi a na i dimuka, pakuninga ci Nyambi naa i wa dimukithsa. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />Inene ku tunda apa kombiwerire kaye, mikarero thza Nyambi thzi shimoniwa, ao okoro wenthzi o diyere nonyambi wenthzi, na i cimonaharithsa nawa. Yaa yuvithsithsiwa keyi a kwamine, mweyo, kwithsa oyu wa ku hamura.<verse eid="ROM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 1:21" />Inene shaanga ci a dimukire Nyambi, ka mu remekire eci Nyambi nji ku kanderera ku kwenthzi. Eanekera yo na i piruka yo tumbako, no micima thzo thzothzitomba na thziraura. <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />Aa cishimba ci a nyanyami, unone na piruka etomba. <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />Kupita ci a rombere aye o kutethzima, Nyambi shifu, awo aa rombera ekupuro yo ku pitura anu, enyunyi, eyama neharawi.<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />Mweyo, Nyambi naa wa thsierera ci a tende yoimango eyi thzi fota micima thzo, karo a di necikumbwethza yo ruthziho ro ku fithsa honyi, ku retera kashwahu erama yo mu kaciko. <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />Na pirura oshemwa wa Nyambi ku u tenda yo kwangera, karo aa rombera no ku kwamena eyi ombire Nyambi, kupita ku rombera aye mumbi wayo, aye oyu na roera ku shangariwa diyere! Ameni.<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />Mukaci keyi, Nyambi naa wa thsierera ci a yoye kecikumbwethza yo ku fithsa honyi. Mane ambuyama wo na thsii mikarero ethzi thzi na roera no ku tateka ku rara nambuyama aenthzo. <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />Mofoci nakwerume, nawo na thsii mikarero ethzi thzi na roera nambuyama, awo aa cikumbwethza ku rara nakwerume aenthzo. Akwerume aa tenda enu yo ku fithsa honyi nakwerume aenthzo, karo aa tambura mu kaciko humbithso ethzi thzi na roera etenda yo.<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />Pakuninga ci na kana kwikara nodimukero shemwa keyi ya Nyambi, Nyambi naa wa thsierera mwianekera yo yokwipa ci a tende eyi i na kana ku roera ku tendiwa. <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />A na yara mishovoshovo thzothzihe thzomango, thsivi, rununa, thsithzimbo, mbamba, kwipaa, mikwangarakanyi, mamvo, kwangera, no ruhopo. <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />Akwa kwipithsa anu amweya mathzina, aa thzimba Nyambi, akwa kashwahu akwa mununa, karo akwa ku cishangara. Mane aa vuruka mikarero thzimweya thzothzingi thzo ku tenda omango. Ka yuverire ashemi wo. <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />Ka yuvithsithsa, ka kwama eyi a na kumbwethza, karo ka di no thsihemo no ñeke kwanu amweya. <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />Shaanga ci a na dimuka ci murao ouwawa wa Nyambi waa amba ci munu yomuhe o ku tenda eyi aa roera ku fa, ka twarererire pohuma ku i tenda komango o ku piterera, unone aa tawethza nowa i kwama.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="rem">MN, TC, MN, MB, RS, HS, CC</para>
  <para style="s1">Raturo thza Nyambi</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />Mweyo, owe o ratura muenthzoe munu, kwithsa edi wa ku i hamura. Inene mu kuratura muenthzoe munu waa ciratura othsinda inene waa ratura muenthzoe mwinu eyi o tenda nowe. <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />Tu na dimuka ci Nyambi kenge a ku ratura komu ku na roera anu awa a tenda enu yo kengeyo. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />Uno honi ngeci waa ratura muenthzoe pa ku tenda enu yo kengeyo, owe honi ne waa anekera ci kenge wa ku para ku raturo thza Nyambi nji? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />Nji waa shwahura thsihemo thsa Nyambi thsothsikuru nene, nothzui wenthzi, no kukwatamucima kwenthzi? Ene ko dimukire ci thsihemo thsa Nyambi thsaa ku twara ku kucera?<verse eid="ROM 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 2:5" />Unone mukaci ko mukanayuva woe no mucima woe o kukana ku cera, waa ciungumekera humbithso thzoe. Inene diyuwa dyoanthzi wa Nyambi dyaa keya, ou thza ku hokoriwa raturo thzenthzi thzothziwawa. <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />Kenge a ku ratura munu no munu kokuthza ketenda yenthzi. <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />Kenge a ku pa mwoyo o diyere awa a ootera ku kwama yoiwa ko ku fotafota kutethzima no direma, mane no kukana ku fa. <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />Uno honi awa a di noñondi no kukana ku shupwera oshemwa, unone aa shupwera omango, Nyambi kenge a ku wa anthzipera no ku wa ratura. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />Kenge kwa kwikara dikando dyodikuru no dikarara kwa munu yomuhe oyu tenda omango, ku tatekera Majuda mbeci honi Anukenge. <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />Unone kenge kwa kwikara kutethzima no direma no thsiyaro kowa a tenda yoiwa, ku tatekera Majuda mbeci honi Anukenge. <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />Inene Nyambi ka a wana mavwevwe.<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />Wahe awa na tende thsivi ko kupira murao kenge a ku fa ko kupira murao. Karo wahe awa na tende thsivi o kwa di mushi thzo murao kenge a ku raturiwa ko murao. <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />Inene kadi cingwa awa a teerera murao o ku u variwa awa a tendiwa owawawa pa meho a Nyambi, unone awa a u hengeka wodiyo a tendiwa owawawa. <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />Inene Anukenge, awo o kupira murao, ngeci awopo a tenda ko micima thzo eyi u na raerera murao, aekara no murao mu mwo, shaanga ci ka di no murao. <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />Aa monithsa ci eraerera yo murao i na ñoriwa mu micima thzo. Mumoneno wo nao waa pa ombangi, karo eanekera yo yaa wa retera ci a cinyenge nji ku wemanena. <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />Eyi kenge ya ku tendahara mu diyuwa edi a ku ratura Nyambi ka Krisitu Yesu etenda yanu yo ku mukunda, eci edi u amba Muthzimbu Ouwa ou ni rongithsa.<verse eid="ROM 2:16" /></para>
  <para style="s1">Majuda no Murao</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />Unone owe o cithsa ci o Mujuda waa citinga pa murao no ku cishangarera Nyambi. <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />O na dimuka eshima ya Nyambi no ku tawethza yoiwa nene, inene murao na u i ku rongithsa. <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />Waa tawa shemwa ci yowe o muendithsi o tupuputwa no mwethzi owa a di mu mirema. <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />O mukwakuronga wetomba no murongithsi wanuke, inene waa tawa ci murao wa Nyambi waa ku pa odimukero noshemwa yo ku yara.<verse eid="ROM 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 2:21" />Uno honi owe o na rongithsanga amweya ne, ine honi eyi o kanena ku cirongithsa othsinda? Owe o na honganga ci kadi o mu kwa kwithza, ine honi owe eyi o withzera? <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />Owe na ambanga ci kadi o mukwa ku rembeka, ine honi owe eyi o rembekera? Owe na thzimbi ekupuro, ine honi eyi o withzera enu yo mu matembere ayo? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />Owe o na cishangara mukaci ko murao, unone waa shwahura Nyambi ko ku cora murao wenthzi. <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />Inene ku na ñoriwa mu Mañoro ci: “Anukenge aa yengwera dithzina dya Nyambi mukaci kenu amwe mwa Majuda.”<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />Ngeci waa hengeka murao, apo honi mukanda woe wa shemwa. Unone ngeci ko hengekire murao ne mukanda woe ne ine nga u ku kwathsa? <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />Mweyo, ngeci Munukenge aa hengeka eraerera yo murao wa Nyambi, ene Nyambi ne nga ka a mu shimbi ci wa ku thza ku mukanda nji? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />Amwe mwa Majuda, kenge mwa ku raturiwa kwAnukenge, inene mwaa cora murao shaanga ci mu di nao, o ku ñoriwa, karo mwakwa ku thza ku mukanda. Unone awo Anukenge aa hengeka murao wa Nyambi shaanga ci ka thza ku mukanda.<verse eid="ROM 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 2:28" />Inene Mujuda shemwa po kadi cingwa oyu di Mujuda peuru, nji ci o mukanda o peuru o perama. <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />Dyombo, Mujuda shemwa po munu oyu di Mujuda mu kaci, pakuninga ci mukanda po thsinu thso mu mucima ko Mupepo kadi ko murao o ku ñoriwa. Munu o kengeyo kushangariwa kwenthzi po kadi kwanu unone kwa Nyambi.<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="rem">MN, TC, MN, MB, RS, HS, CC</para>
  <para style="s1">Orurami wa Nyambi</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />Thsine ethsi thsi reta ci Majuda ekare ku rupara? Ene mukanda ne waa kwathsa thsimweya nji? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />Ii, waa kwathsa mu makuñwa oahe. Inene, thso kutanga Majuda shime a piwire maywi a Nyambi. <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />Ngeci amweya kukwo ka ruramine ne, ene kukana ku rurama kwo ne kenge nga ku retera Nyambi ci a rurama? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />Dyombo! Shaanga ci anu wahe wekare akwakwangera, Nyambi aye po wa ku amba yoshemwa. Eci edi ku na ñoriwa ci:</para>
  <para style="q1" vid="ROM 3:4">“Waa roera ku monahara owawa mweyi o amba,</para>
  <para style="q2" vid="ROM 3:4">ci eamba yoe ya ku ku endere nawa o ku thzekithsiwa.”<verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />Unone ngeci omango wetu waa monaharithsa owawa wa Nyambi, apo honi ne tu ambe ngepi? Ene tu ambe ci Nyambi wa dipethso pa ku tu pa humbithso nji? (Naa amba ko muambero wanu.) <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />Dyombo, kadi kengeyo! Inene Nyambi nga kadi muwawa ne, ngepi nga a twethsa ku ratura kaye? <verse eid="ROM 3:6" /><verse number="7" style="v" sid="ROM 3:7" />Unone ngeci kukana ku rurama kwange, kwaa kwathsa ku monaharithsa oshemwa no kutethzima kwa Nyambi, Nyambi ne ine nga a ni ratwera eci o thsivi? <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />Uno honi anu amweya ko ku fota ku twipithsa mathzina a amba ci shime na tu amba ci: “Tu tendenu thsivi ci owa u keye!” Anu awa a amba enu yo kengeyo aa roera ku piwa humbithso.<verse eid="ROM 3:8" /></para>
  <para style="s1">Kwithsa munu o muwawa</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />Uno honi, atwe twa Majuda ne twaa pita anu amweya nji ngepi? Dyombo, kadi kengeyo! Na tu mi monithsa ci Majuda nAnukenge po wahe mofoci, wahe mushi thzokoro o thsivi a di. <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />Eci edi ku na ñoriwa ci:</para>
  <para style="q1" vid="ROM 3:10">“Kwithsa munu o muwawa, shaanga yofoci kwithsa.<verse eid="ROM 3:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="ROM 3:11" />Kwithsa o ku yuvithsithsa,</para>
  <para style="q2" vid="ROM 3:11">karo kwithsa oyu fotafota Nyambi.<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />Wahe na tundu kwa Nyambi,</para>
  <para style="q2" vid="ROM 3:12">wahe ka kwathsire thsimweya.</para>
  <para style="q1" vid="ROM 3:12">Kwithsa oyu tenda yoiwa,</para>
  <para style="q2" vid="ROM 3:12">kwithsa shaanga yofoci.”<verse eid="ROM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />“Midyu thzo thzaa cipitura eci thsidi thso ku yahama,</para>
  <para style="q2" vid="ROM 3:13">madimi o a neirera kwangera.”</para>
  <para style="q1" vid="ROM 3:13">“Miromo thzo thzaa amba yo kwipaa eci ohungu o diyoka.”<verse eid="ROM 3:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ROM 3:14" />“Tunwa to tu na yara makuya no ndurungera.”<verse eid="ROM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />“Edyato yo ya ku yakamena ku kwipaa.<verse eid="ROM 3:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16" />Kokuhe oku a thza, kwipa no makando yaa wa shupwera.<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />Karo ka dimukire dikuñwa dyo thsiyaro.”<verse eid="ROM 3:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18" />“Ka yapire Nyambi.”<verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />Uno honi tu na dimuka ci eyi i di mu murao yoihe, yaa ambera awa di mushi thzao ci kwa kwikara shaanga munu yofoci oyu wa ku hamura, no ku monithsa kaye kokahe ci ka di no murandu kwa Nyambi. <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />Inene kwithsa munu o kwikara o muwawa pa meho a Nyambi ketenda yo murao. Unone murao po waa tu dimukithsa thsivi thsetu.<verse eid="ROM 3:20" /></para>
  <para style="s1">Owawa ko Thsitawo</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />Uno honi, Nyambi na a tu monithsa dyo ku tendiwa owawawa pa meho enthzi. Kadi cingwa ko murao, shaanga ikare ci murao nakwakukethza a pire ombangi wedyo dikuñwa. <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />Nyambi aa tu tenda owawawa mukaci ko thsitawo thsetu kwa Yesu Krisitu. Eyi Nyambi aa i tenda kowa na tawa wahe. Kwithsa thsiano mu kaciko,<verse eid="ROM 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 3:23" />inene anu wahe na tende thsivi, mweyo, wahe na kwanga ku kuma ku kutethzima kwa Nyambi. <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />Unone ko thsipa thso kengekenge thso thsihemo thsenthzi, anu wahe aa twethsa ku piruka owawawa ka Krisitu Yesu oyu wa wa paturire.<verse eid="ROM 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 3:25" />Inene Yesu Krisitu po Nyambi wa mu hangurire ci na ekare thsiyambero thsevi konyinga wenthzi. Eyi yaa tamburiwa ko thsitawo. Nyambi wa tendire kengeyo ku monithsa owawa wenthzi, inene mu kucithzua mucima konyambi wenthzi wa thsiererire evi yowa a tendire thsivi ku kare. <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />Uno honi Nyambi aa monaharithsa owawa wenthzi ko thsino thsikati kwanu wahe ko ku tenda owawawa anu wevi awa a na tawa kwa Yesu.<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />Pa ine karo tu cishangarera? Kwithsa! Ko ku hengeka murao nji? Dyombo, unone ko thsitawo pohuma. <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />Inene twaa tawa ci shime ko thsitawo pohuma munu mbeci ekare o muwawa pa meho a Nyambi kadi ketenda yo murao. <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />Ene Nyambi ne Nyambi o Majuda pohuma nji? Ene kadi nAnukenge nawo Nyambi wo? Ii, nawo Nyambi wo, <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />pakuninga ci ku di Nyambi yofoci, oyu wa ku tenda anu ko thsitawo thso kwikara owawawa, ikare Majuda nji Anukenge. <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />Ene apo honi ne twaa monithsa ci twaa pwithsa murao ko thsitawo nji? Dyombo, ka tu u pwithsire unone twaa u tanarithsa.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="rem">MN, TC, MN, MB, RS, HS, CC</para>
  <para style="s1">Aburahama aa tendiwa o muwawa ko thsitawo</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />Wangu tu ambe ine keyi a wanine konu mukwathsañuru wetu Aburahama? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />Ngeci Aburahama shime a tendiwire o muwawa ketenda yenthzi, apo honi kenge nga a i cishangarera. Uno honi tumba a cishangara pa meho a Nyambi. <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />Inene Mañoro aa amba ci: “Aburahama wa tawire ya Nyambi, mweyo, mukaci ko thsitawo thsenthzi Nyambi wa mu varire ci muwawa.”<verse eid="ROM 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 4:4" />Munu oyu na kwama, eyi a na horo ka i variwire ci thsipa, unone yaa variwa ci eyi a na wana pekwama yenthzi. <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />Uno honi o kukana ku kurupera ekwama, unone aa kurupera Nyambi oyu na tendanga owawa anu wevi, thsitawo thsenthzi thsaa variwa ci owawa. <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />Davida naye wa i ambire ou a ambire yo thsiyauthzi thso munu oyu a tara Nyambi ci muwawa ko kupira ekwama, ou a ambire ci:<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />“Akwa thsiyauthzi</para>
  <para style="q2" vid="ROM 4:7">awa na teteriwa mirandu thzo,</para>
  <para style="q2" vid="ROM 4:7">nowa na thsikiwera evi yo!<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />Wa thsiyauthzi munu</para>
  <para style="q2" vid="ROM 4:8">oyu a kana ku varera evi yenthzi Fumu.”<verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />Ene ethsi thsiyauthzi ne thsakwa ku thza ku mukanda pohuma nji, nji mofoci kengeyo nakwakukana ku thza ku mukanda? Inene twaa amba ci thsitawo thsa Aburahama thsa mu reterire ci a variwe ci muwawa. <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />Eyi ne ngepi ya tendaharire? Ene shime a variwire ci muwawa o ku shime ku thza ku mukanda nji, nji munyima thzo ku thza ku mukanda? Nedi kadi munyima thzo ku thza ku mukanda, unone o ku shime.<verse eid="ROM 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 4:11" />Shime a tamburire thsimonithso thso mukanda kwikara thsitamba thsowawa ou a tamburire mukaci ko thsitawo thsenthzi o ku shime ku thza ku mukanda. Mweyo, Aburahama yodiyo tata owa na tawa kwa Nyambi wahe, karo Nyambi aa wa tambura ci a wawa shaanga ci ka thza ku mukanda. <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />Karo yodiyo tata owa a thza ku mukanda, kadi cingwa mukaci kokuthza kwo ku mukanda, unone mukaci ko ku yoya mwoyo o thsitawo o ku cipitura eci ou a yoyire tata wetu Aburahama o ku shime ku thza ku mukanda.<verse eid="ROM 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />Nyambi ka a kumbwethzire Aburahama nanahokenthzi ku tambura kaye mukaci ko ku hengeka murao, unone nedi kowawa ou u na keyanga ko thsitawo. <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />Ngeci thsikumbwethzo thsa Nyambi po kenge thsa ku piwa pohuma awa a hengeka murao, apo honi thsitawo ka thsi kwathsire thsimweya, karo no thsikumbwethzo thsa Nyambi nga thsa kenge. <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />Inene murao waa reta oanthzi wa Nyambi, uno honi po kupira murao kwithsa ku cora murao.<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />Mweyo, thsikumbwethzo thsaa keya ko thsitawo ci thsikare thsipa thsa Nyambi. Ethsi thsipa thsaa piwa kwanahoka a Aburahama, kadi awa hengeka pohuma murao, unone nowa di no thsitawo eci thsa Aburahama, aye tata wetu twahe. <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />Eci edi ku na ñoriwa ci: “Ni na ku tende tata o matunga oangi.” Aye po tata wetu pa meho a Nyambi, oyu a tawire yenthzi, aye oyu pa mwoyo kwafu karo yodiyo wombire enu eyi ya pirireko.<verse eid="ROM 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 4:18" />Aburahama wa tawire no ku kurupera po kupira okurupero, ci ekare tata o matunga oangi, eci dyodi a i kumbwethziwire ci: “Kenge mbo wikara nanahoka owangi.” <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />Shime ekarire no myaka thzo ku fota ku kwana dikumi dyo makumi, unone thsitawo thsenthzi ka thsa faraterire ou a anekerire yerama yenthzi eyi yekarire eci yo kufa mukaci ko ku kurupara nene, karo no munuwenthzi Sara shime ekarire mvumi.<verse eid="ROM 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 4:20" />Aburahama ka a tamangerire mu thsitawo thsenthzi keyi a mu kumbwethzire Nyambi, unone wa tanarire mu thsitawo no ku pa Nyambi kutethzima. <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />Shime a rakwire shemwa ci Nyambi kenge mba a tenda eyi a mu kumbwethzire. <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />Mweyo, Nyambi wa varire Aburahama ci muwawa mukaci ko thsitawo thsenthzi. <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />Unone ao maywi o ku amba ci: “O na variwa ci muwawa” ka a ñoriwerire aye pohuma yofoci, <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />unone shime a ñoriwerire natwe kengeyo atwe tu variwa ci twawawa, atwe tu tawa ku kwenthzi oyu wa pindurire Yesu Fumu wetu kwafu. <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />Wa piwire ci epaiwe mukaci ko thsivi thsetu, karo wa pinduriwire kwafu ci tu tendiwe owawawa pa meho a Nyambi.<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="rem">AM, TC, MN, MB, RS, HS, CC</para>
  <para style="s1">Thsiyaro thsa Nyambi</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />Mweyo, pakuninga ci na tu tendiwa owawawa ko thsitawo, mu thsiyaro tu di na Nyambi mwa Fumu wetu Yesu Krisitu. <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />Mu mwenthzi Yesu na tu wana dikuñwa ko thsitawo ku kuma mothsino thsihemo omu tu nemana. Tu na nyanyuka honi mukaci ko ku kurupera ku kekara mu kutethzima kwa Nyambi. <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />Kadi eyo pohuma, unone karo twaa nyanyuka mu makando etu, ko ku dimuka ci makando aa reta muooto, <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />muooto waa reta mukarero o shemwa, karo mukarero o shemwa waa reta okurupero, <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />karo ou okurupero ka wa retithsera ku ena, inene Nyambi na a pingurwera thsishimo thsenthzi mu micima thzetu ko Mupepo Oukenu oyu a tu pire.<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />O ku shimbi twekarera o ku faratera, ko thsikati ethsi thsi na roera, Krisitu wa fererire anu owamango. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />Inene kadi nene ci munu a fere munu o muwawa, shaanga ci munu kenge nga a keshuka ku fera munu o muwa. <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />Unone Nyambi naa tu monithsa okuru o thsishimo thsenthzi pakuninga ci o ku shimbi twekarera anu wevi, Krisitu wa tu fererire.<verse eid="ROM 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 5:9" />Pakuninga honi ci na tu tendiwa owawawa konyinga wenthzi, yoshemwa kenge a ku tu yoyithsa kuanthzi wa Nyambi. <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />Inene ou twekarire akwethzimbo ya Nyambi, wa tu huthserire ku kwenthzi aye thsinda ko kufa kwa Mwane. Pakuninga honi ci na tu huthseriwa kwa Nyambi, yoshemwa kenge twa ku yoyithsiwa ko mwoyo wa Mwane. <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />Uno honi kadi eyo pohuma, unone twaa nyanyuka karo mukaci keyi na a tu tendera Nyambi mwa Fumu wetu Yesu Krisitu oyu naa tu huthsera kwa Nyambi.<verse eid="ROM 5:11" /></para>
  <para style="s1">Adama na Krisitu</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />Mweyo, dyodi thsa keyire thsivi mu kaye mukaci ko munu yofoci aye Adama, karo thsivi na thsi reta kufa, dyo na ku yamba kufa anu wahe, inene wahe na tende thsivi. <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />Thsivi thsekarire mu kaye murao o ku u shime ku piwa, unone thsivi ka thsi variwire po kupira murao. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />Uno honi kufa kwa tuminine ku tatekera kwa Adama shime ku na kuma kwa Mushe. Mane kwekarire nokoro shaanga peuru thzowa a kanine ku tenda thsivi eci ethsi a tendire Adama, aye thsikupuro thsa Krisitu oyu a ningire Nyambi ci aa keya.<verse eid="ROM 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 5:15" />Uno honi thsipa thsa Nyambi thso kengekenge ka thsi cishokire no murandu wa Adama. Inene murandu oyu munu yofoci, aye Adama, wa reterire anu owangi kufa. Uno honi thsihemo thsa Nyambi no thsipa thsenthzi thsotetero kwanu owangi koyu munu yofoci, aye Yesu Krisitu po ikuru nene. <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />Karo ko thzi di thsiano mu kaci ko thsipa thsa Nyambi no thsivi thsoya munu yofoci. Inene thsivi thsa Adama thsa retire raturo thzo humbithso, uno honi thsipa thsa Nyambi thso kengekenge thsaa tu retera ku tendiwa owawawa pa meho a Nyambi, shaanga ci tu di no murandu wevi yoingi. <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />Inene ngeci murandu wa munu yofoci wa retire ci kufa kwikare nokoro mukaci ko munu yofoci, yoshemwa awa a na tambura thsihemo thsa Nyambi thsothsikuru no thsipa thsowawa kenge a ku tumina mu mwoyo mukaci ko munu yofoci, aye Yesu Krisitu.<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />Mweyo, dyodi wengenithsire murandu ofoci anu wahe mu raturo, no thsitenda thsofoci thsowawa dyo thsi na retera anu wahe ku tendiwa owawawa no ku piwa mwoyo. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />Inene dyodi a tendiwire owangi kwikara anu wevi mukaci ko kukana kuyuvera kwa munu yofoci, dya ku tendiwa owawawa anu owangi mukaci ko kuyuvera kwa munu yofoci.<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />Murao wa piwire ci thsivi thsi monahare kongi, uno honi thsivi ou thsa vurire, thsihemo athso thsa vurire kupiterera. <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />Mweyo, dyodi thsekarire thsivi nokoro peuru thzanu ko ku wa retera kufa, no thsihemo thsa Nyambi dyo thsa kwikara nokoro kowawa, ku reta mwoyo o diyere ka Yesu Krisitu Fumu wetu.<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="rem">AM, MN, MB, RS, HS, CC</para>
  <para style="s1">Ku fa ku thsivi, no ku yoya mwa Krisitu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />Uno honi ine tu amba? Ene tu twarerere ku tenda thsivi ci thsihemo thsa Nyambi thsi monahare kongi? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />Dyombo, kadi kengeyo! Ngepi edi nga tu twarerera ku yoya mu thsivi atwe na tu fu ku thsivi? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />Ene ka mu dimukire ci twahe atwe na tu korovethziwa mwa Krisitu Yesu, na tu korovethziwa mu kufa kwenthzi nji? <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />Mweyo, ou twa korovethziwire, twa fire no ku vumbekiwa nenthzi ci nga dyodi a pinduriwire Krisitu kwafu ko kutethzima kwa Nyambi Tata, natwe twa ku yoye mwoyo oupe.<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />Pakuninga ci na tu ciwaneka nenthzi pofoci mu kufa kwenthzi, kenge twa ku pinduriwa kwafu eci edi a pinduriwire. <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />Tu na dimuka ci onu wetu o kare mwirama yetu wa pamareriwire na Krisitu pa mbinda, ci okoro o thsivi wekara peuru thzo myoyo thzetu, ci nga twekara karo apika ku thsivi. <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />Inene munu yoihe a fa, na rukururiwa kukoro o thsivi.<verse eid="ROM 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 6:8" />Uno honi ngeci na tu fu na Krisitu, twaa tawa ci kenge mba tu yoya karo nenthzi. <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />Inene tu na dimuka ci Krisitu ko ku pinduriwa kwafu, mbera ka a fu karo. Kufa ka ku di nokoro karo pa penthzi. <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />Inene kufa oku a fire, shime a fire ku thsivi rofoci pohuma karo ro mamaneneno, uno honi mwoyo ou a yoya aa yoya kwa Nyambi.<verse eid="ROM 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 6:11" />Mweyo, namwe kengeyo mwaa roera ku civara ci na mu fu ku thsivi no ku yoya kwa Nyambi mwa Krisitu Yesu. <verse eid="ROM 6:11" /><verse number="12" style="v" sid="ROM 6:12" />Thsivi thsa endithsa mwirama yenu yo ku twethsa ku fa, thsa mi tenda ci mu shupwere ecikumbwethza yathso yoimango. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />Karo mwa pa thsivi epo yerama yenu ci i kwamithsiwe mu makuñwa oamango. Unone mu cipake kwa Nyambi eci anu awa na tundithsiwa mu kufa no ku retiwa mu mwoyo. Karo mu pe epo yerama yenu ku kwenthzi ci a i cikwathsithse mu mwenu ku tenda enu yowawa. <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />Thsivi ka thsi di honi nokoro pa penu, inene ka mu di mushi thzo murao, unone mushi thzo thsihemo thsa Nyambi mu di.<verse eid="ROM 6:14" /></para>
  <para style="s1">Apika kuwawa</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />Ngepi honi? Ene tu tende thsivi pakuninga ci ka tu di mushi thzo murao, unone mushi thzo thsihemo thsa Nyambi? Dyombo, kadi kengeyo! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />Ene ka mu dimukire ci munu aekara mupika kweyi a na shupwera nji? Mwaa twethsa kwikara apika thsivi athso thso ku twara ku kufa, nji ku cihangwera ku yuvera Nyambi ayo yo ku twara kuwawa. <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />Uno honi tu kanderere kwa Nyambi, inene amwe mwekarire apika thsivi, pano honi na mu tawa ko micima thzenu thzothzihe erongithsa eyi na mu piwa. <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />Na mu paturiwa honi ku thsivi karo na mu pikuriwa kuwawa.<verse eid="ROM 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 6:19" />Naa amba ko ku cikwathsithsa miambero thzanu mukaci ko ku faratera kwenu mu kuyuvithsithsa. Pa kutanga mwa citendire apika kwinu yo dithziro nomango o kupiterera, pano honi mu cipe mwathsinda kwikara apika kuwawa ci mwikare owakenu. <verse eid="ROM 6:19" /><verse number="20" style="v" sid="ROM 6:20" />Ou mwekarire apika thsivi, mwa rukurukire kweyi yowawa. <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />Uno honi owa mwine mwa waninepo ku tenda enu eyi i mi fithsa honyi thsino thsikati? Inene mahurerero weyo po kufa. <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />Pakuninga honi ci na mu paturiwa ku thsivi no ku piruka apika Nyambi, eyi na mu wana po yaa twara ku kukenithsiwa no ku piwa mwoyo o diyere ku hura. <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />Inene muyambo o thsivi po kufa, unone thsipa thso kengekenge thso thsihemo thsa Nyambi po mwoyo o diyere mwa Krisitu Yesu Fumu wetu.<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="rem">AM, MN, MB, RS, HS, CC</para>
  <para style="s1">Mukwathsitawo na rukururiwa ku mirao thzo Thsijuda</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />Aenthzange mu thsitawo, pakuninga ci naa amba nowa a na dimuka murao, ene ka mu dimukire ci murao po wa anga pohuma munu o ku yoya nji? <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />Mweyo, mbuyama a angiwa ku murao kwa munuwenthzi, o ku yoya munuwenthzi. Uno honi ngeci munuwenthzi ayepo fa, oyo mbuyama na rukuruka ku murao ou na u mwanga kwa munuwenthzi. <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />Uno honi kenge a kwithsiwa o mirembe ngeci ayepo yekiwa kwa mukwerume wao munuwenthzi o ku yoya. Unone munuwenthzi o ku na fu, oyo mbuyama ko murao na rukuruka, karo ngeci ayepo yekiwa kwa mukwerume wao, tumba ethsiwa ci wa mirembe.<verse eid="ROM 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 7:4" />Uno honi aenthzange, dyo i di noku ku kwenu. Namwe kengeyo mu na fu ku murao, inene mwepo yerama ya Krisitu. Pano honi mu nekara anuenthzi, aye oyu naa pinduriwa kwafu ci nga tu twethse kwimena Nyambi ima. <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />Ou twa yoyire kerama, ecikumbwethza yo thsivi yo ku shangumuniwa ku murao ya kwamine mwirama yetu, unone ya tu twarire ku kufa. <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />Uno honi na tu rukururiwa ku murao, inene na tu fu ku thsinu ethsi thsa twangire. Mweyo, Mupepo Oukenu kenge a tu kwathsa ku kwamena Nyambi ko dikuñwa dyodipe, karo kadi ko dikuñwa dyo ku shupwera murao o ku ñoriwa.<verse eid="ROM 7:6" /></para>
  <para style="s1">Murao no thsivi</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />Wangu tu ambe ine? Ene tu ambe ci murao po thsivi nji? Dyombo, kadi kengeyo! Uno honi murao odiyo u na tu dimukithsa thsivi. Inene napoci u ambe ci: “Wa cikumbwethza thsinu thsa muenthzoe,” nga ka ni dimuka ci ku cikumbwethza thsinu thsa muenthzange po imango. <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />Unone mukaci ko thsiraerera, thsivi na thsi wana dikuñwa dyo ku ni retera ci ni cikumbwethze enu yo mishovoshovo. Inene ko kupira murao, thsivi thsi na fu. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />Shime naa yoya ou kwa pirire murao, unone thsiraerera ou thsa keyire, thsivi thsa pwethzumukire ame no ku fa. <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />Na monine ci athso thsiraerera ethsi thsa roerire ci nga thsi na reta mwoyo thsa retire kufa. <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />Thsivi thsi na wana ndau thzo ku niangera ko ku cikwathsithsa thsiraerera, thsi na nipaa kethso thsiraerera. <verse eid="ROM 7:11" /><verse number="12" style="v" sid="ROM 7:12" />Mweyo, ao murao po ukenu karo no thsiraerera thsao thsikenu, thsiwawa karo thsiwa.<verse eid="ROM 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 7:13" />Ene thsiya thsinu thsothsiwa ne na thsi ni retera kufa nji? Dyombo! Thsivi thsodiyo na thsi tende kengeyo. Ko ku kwamithsa thsinu thsothsiwa, thsivi na thsi ni retera kufa ci thsi monahare nawa ci thsivi. Mweyo honi, ko thsiraerera thsivi thsi nekara thsivi nene ku piterera.<verse eid="ROM 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />Inene tu na dimuka ci Murao waa tunda kwa Nyambi, uno honi ame po no munu oyu yoya mu nyama, o ku urithsiwa eci mupika ku thsivi. <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />Ka ni yuvithsithsire eyi ni tenda, inene ka ni tendire eyi ni fota ku tenda, unone naa tenda ethsi ni na thzimbi. <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />Ko ku tenda ethsi ni na kana ku fota ku tenda, naa tawa ci murao po uwa. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />Mweyo, kadi cingwa yame oyu tenda kengeyo, unone thsivi ethsi thsi di mu mwange.<verse eid="ROM 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 7:18" />Inene ni na dimuka ci mu mwange mwithsa thsinu thsothsiwa, ame konu wange. Inene naa fotanga ci ni tende yoiwa, unone naa kwanga ku tenda kengeyo. <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />Inene kadi no mukwa ku tenda owa ou ni fota ku tenda, unone naa tenda omango ou ni na kana ku fota ku tenda. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />Ngeci naa tenda thsinu ethsi ni na kana ku fota, kadi cingwa yame ni thsi tenda, unone thsivi ethsi thsi di mu mwange.<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />Mweyo, naa wana murao o kenge ci, yoihe ni fota ku kwama yoiwa, omango waekara nange. <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />Inene mucima wange waa nyanyukera murao wa Nyambi, <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />unone naa mona murao umweya ou u kwama mu mwange, ou u rwithsa maano ange no ku ni tenda thsinthzinda thso murao o thsivi ethsi thsi kwama mu mwange. <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />Mayuwane othsimo wange! Edye oyu wa ku ni amwena kweyi erama i ni twara ku kufa? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />Naa kanderera kwa Nyambi, aye oyu ni patura ka Yesu Krisitu Fumu wetu!</para>
  <para style="p" vid="ROM 7:25">Mweyo, mu na mono edi i di: Mu maano ange naa fota shemwa ku hengeka murao wa Nyambi, uno honi mwirama yange yo thsivi no mupika ku murao o thsivi.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="rem">TA, MN, MB, RS, HS, CC</para>
  <para style="s1">Mwoyo ko Mupepo</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />Mweyo honi, kwithsa raturo kowa a di mwa Krisitu Yesu. <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />Inene murao o Mupepo o mwoyo na u mi<note caller="+" style="f"><char style="fr" closed="false">8.2 </char><char style="ft" closed="false">Mañoro amweya aa amba ci </char><char style="ft" closed="false">“Na u mi patura</char><char style="ft" closed="false">”. Amweya ci </char><char style="ft" closed="false">“Na u ni patura.”</char></note> patura mwa Krisitu Yesu ku murao o thsivi no ku kufa. <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />Inene Nyambi na a tende ethsi wa kanine ku twethsa ku tenda murao wa Mushe mukaci ko kufaratera kwerama. Naa ratura ethsi thsi endithsa erama ko ku tuma Mwanenthzi, oyu wa keyire mu thsikupuro thserama yo thsivi. Mweyo, wa na raturire thsivi mweyo erama. <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />Wa tendire kenge ci owawa ou u na fotahara mu murao ci nga u yarithsiwerere mu mwetu, ka tu shupwerire eshima yerama, unone twaa shupwera Mupepo.<verse eid="ROM 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 8:5" />Inene awa a na yoyo keshima yerama aa pakera maano o kwinu yerama, uno honi awa a na yoyo ko Mupepo aa pakera maano o kwinu yo Mupepo. <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />Ku pakera maano efota yerama po kufa, uno honi ku yoya keyi a fota Mupepo po yaa twara ku mwoyo no thsiyaro. <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />Inene maano aa a na pakeriwa kwifota yerama aa rwithsa Nyambi, ka a cihuthsa kushi thzo murao wa Nyambi, karo tumba a tende kengeyo. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />Awa shupwera efota yerama yo tumba twethsa ku roerithsa Nyambi.<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />Uno honi amwe ka mu yoyire keshima yerama yenu, unone ko Mupepo, ngeci shemwa Mupepo wa Nyambi mu mwenu a di. Ngeci munu ka a di no Mupepo wa Krisitu, ka a di kwa Krisitu. <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />Uno honi ngeci Krisitu mu mwenu a di, apo honi shaanga yoyi i fa erama yenu mukaci ko thsivi, Mupepo aa mi pa mwoyo, inene na mu tendiwa owawawa pa meho a Nyambi. <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />Ngeci Mupepo wa Nyambi, aye oyu wa pindurire Yesu kwafu po mu mwenu a di, aye oyu wa pindurire Krisitu kwafu kenge a ku pa kengeyo mwoyo kwirama yenu yo ku twethsa ku fa, ko Mupepo wenthzi oyu yoya mu mwenu.<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />Mweyo, andengenu, tu nangiwa, uno honi kadi kwirama, kadi ku yoya kefota yerama. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />Ngeci mwaa yoya kerama kenge mwa ku fa, unone ngeci ko Mupepo mwa epaa etenda yoimango yerama, kenge mwa ku yoya. <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />Inene wahe awa a na endithsiwa ku Mupepo wa Nyambi po wodiyo ana Nyambi.<verse eid="ROM 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 8:15" />Ka mwa tamburire Mupepo o ku mi tenda apika ci nga mu yoye mu wowa karo, unone Mupepo oyu mwa tamburire wa miañurire kwikara ana Nyambi, aye kenthzi twaethsa Nyambi ci: “Aba, Tata!” <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />Aye Mupepo thsinda aa pa ombangi no mipepo thzetu ci twana Nyambi. <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />Apo honi ngeci twana, twashwana. Twashwana kutethzima kwa Nyambi, karo twaenthza Krisitu mu kushwana, ngeci twaa nyanda shemwa nenthzi ci nga natwe twa ku tambure kutethzima kwenthzi.<verse eid="ROM 8:17" /></para>
  <para style="s1">Kutethzima oku ku keya</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />Naa shimba ci makando o rerodino tumba nga a anekethziwa ku kutethzima oku kwa ku hokoriwa ku kwetu. <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />Kaye kokahe ka na taterera nene thsikati ethsi a ku hokora Nyambi anenthzi. <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />Inene yumbiwa ya pakiwire mu kutumina ko mbango, uno honi kadi keshima yayo, unone keshima yoyu wa i pakire kengeyo. Uno honi ko u di okurupero, <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />ci kaye ako kenge ka ku paturiwa ku kwangiwa ku kwipa no ku retiwa mu kurukuruka ko kutethzima kwana Nyambi.<verse eid="ROM 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 8:22" />Inene tu na dimuka ci kaye kokahe ku na kuma thsino thsikati na ka shiri mukaci ko kukora ko ku ninga eci mbuyama o ku nyatithsa. <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />Kadi kaye pohuma, unone natwe, atwe tu di no mutomwa o Mupepo, twaa shirera mu kaci o ku tu taterera nene kwañuriwa kwetu kwikara ana Nyambi, ako kupaturiwa kwerama yetu. <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />Inene kou okurupero twa yoyithsiwire. Uno honi okurupero o ku monahara po kadi okurupero. Edye o ku kurupera eyi a di nayo? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />Uno honi ngeci twaa kurupera ethsi tu shime ku wana, twaa thsi taterera kothzui.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />Mofoci kengeyo, Mupepo aa tu kwathsa mu kufaratera kwetu. Ka tu dimuka eyi tu na roera ku romberera, unone aye Mupepo aa tu romberera keshiro yo kukana ku twethsa ku tongonona. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />Karo oyu na fotithsithsanga micima thzetu na dimuka maano o Mupepo, inene Mupepo aa direreranga akwakutawa kokuthza komu a na shimena Nyambi.<verse eid="ROM 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />Karo tu na dimuka ci Nyambi aa tenda enu yoihe ku kwamena pofoci nawa kowa a na mu shimi, awa naethsa kokuthza kesheteka yenthzi. <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />Inene awa a dimukire cimo, wa wa hangurire cimo ci a ku shimbe thsikupuro thsa Mwane, ci Mwane ekare mwedi mu kaci kapenthzi owangi. <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />Karo awa a hangurire cimo, karo wa wethsire, awa ethsire, karo wa wa tendire owawawa, karo awa a tendire owawawa wa wa pire kutethzima kwenthzi.<verse eid="ROM 8:30" /></para>
  <para style="s1">Okuru o thsishimo thsa Nyambi</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />Uno honi ine tu amba keyi enu eyi? Ngeci Nyambi aa twimanena, edye nga o tu rwithsa? <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />Aye oyu wa kanine kwandwa Mwane shemwa unone wa u tu pire twahe, ngepi honi nga a ku kwanga ku tu pa ko thsihemo mofoci na Mwane enu yoihe? <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />Edye oyu wa ku thzekithsa awa naa hangura Nyambi? Nyambi yodiyo na tendanga anu kwikara owawawa. <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />Edye honi wa ku tu ratura? Kwithsa, inene Krisitu Yesu wa tu fererire karo wa pinduriwire kwafu, oyu di ku dyoko dyo rudyo dya Nyambi, aye oyu na tu rombereranga.<verse eid="ROM 8:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ROM 8:35" />Edye oyu wa ku tu tepa ku thsishimo thsa Krisitu? Ene kenge ya kwikara dikando nji, nji dikarara, nji kunyandithsiwa, nji ndombo, nji wira, nji okaru, nji mwere? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />Eci edi ku na ñoriwa ci: “Mukaci koe twaepaiwa diyuwa no diyuwa.</para>
  <para style="q2" vid="ROM 8:36">Twaa shimbiwa eci mangu aa a ka paiwa.”<verse eid="ROM 8:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37" />Dyombo, mweyi enu yoihe eyi twaa pita awa na othzo kenthzi aye oyu naa tu shimi!<verse eid="ROM 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ROM 8:38" />Inene naa tawa shemwa ci kwithsa ethsi nga thsi tu tepa ku thsishimo thsa Nyambi, ikare kufa, nji mwoyo, nji tungeru, nji yoikoro, nji enu eyi i diko pano nji eyi i keya, nji okoro, <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />nji ore, nji othzungi, nji ngara thsinu mu kaye, kwithsa ethsi thsa ku twethsa ku tu tepa ku thsishimo thsa Nyambi oku ku di mwa Krisitu Yesu Fumu wetu.<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="rem">TA, MN, HS, CC</para>
  <para style="s1">Nyambi no mbunga ethzi a cihangwerire</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />Naa amba oshemwa mwa Krisitu, ka niangerire. Mumoneno wange ou u endithsiwa ku Mupepo Oukenu waa pa ombangi ci ka niangerire. <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />Mathsiwa ange akuru, karo ni di no thsorokoto thzi shipu mu mucima wange. <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />Inene kenge nga ni cikumbwethza ci ame ni kutiwe no ku tetiwa kwa Krisitu mukaci ko mukuta wange, <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />awo Maisiraele. Shime añuriwire kwikara ana Nyambi. Nyambi wa hokorire kutethzima kwenthzi kukwo, wa ciangireno eyuvano, wa wa pire Murao, wa wa pire ku rombera mu Tembere no ku wa pa ekumbwethzo. <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />Aa tunderera kwakwathsañuru, no Krisitu naye kodiyo a tunderera konu, aye Nyambi oyu tumina enu yoihe karo aa roera ku shangariwa diyere! Ameni.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />Kadi cingwa ci thsikumbwethzo thsa Nyambi thsi na kanga, unone kadi cingwa wahe anahoka a Isiraele Maisiraele. <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />Karo kwikara anahoka a Aburahama ka i ambire anenthzi shemwa. Mañoro aa amba ci: “Anahoka a Isaka pohuma wa ku variwa ci oe.” <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />Eyo yaa monithsa ci awa erekiwire kerama kadi cingwa wodiyo ana Nyambi, unone awa erekiwire ko thsikumbwethzo wodiyo a na variwa ci ana Aburahama. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />Inene eyi yodiyo thsa ambire thsikumbwethzo ci: “Kenge na ku ka huka kethsino thsikati mwaka ou u keya, apo Sara kenge a kwikara no mwana o mukwerumeana.”<verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />Kadi eyo pohuma, unone Rabeka ou a thzire poremu, wa shamurukire marambi, tata wo po mukwathsañuru wetu Isaka. <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />Unone o kwa shime ku shamurukiwa, o kwa shime ku tenda yoiwa nji yoimango, eanekera ya Nyambi yo ku hangura anu ya monaharire. <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />Nyambi a ethsanga anu kadi kekwama yo yoiwa nji yoimango. Nyambi wa amberire Rabeka ci: “Mwanoe shokuru kenge a ku kwamena shoonye.” <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />Eci edi ku na ñoriwa ci: “Na shimine Jakovo, unone na thzimbire Isau.”<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />Wangu tu ambe ine honi? Ene Nyambi ne wa dipethso nji? Dyombo! <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />Inene wa amberire Mushe ci:</para>
  <para style="q1" vid="ROM 9:15">“Kenge na kwikara no ñeke koyu ni na foto ku monithsa ñeke,</para>
  <para style="q2" vid="ROM 9:15">karo kenge na ku yuvera ñekeñeke oyu ni na foto ku yuvera ñekeñeke.”<verse eid="ROM 9:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="ROM 9:16" />Mweyo, ka imanine peshima nji ecikatathza yo munu, unone i nemana pa ñeke thza Nyambi. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />Inene Mañoro aa amba ci Nyambi wa amberire Faro ci: “Na ku kwamine fumu ci nga ni monithse okoro wange mu moe karo ci dithzina dyange dya ku dimukiwe mu kaye kokahe.” <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />Mu na mono honi, Nyambi aa fera ñeke awa a na foto ku fera ñeke, karo aa karupithsa micima awa a na foto ku karupithsa micima.<verse eid="ROM 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />Ngwa yumweya ku kwenu kenge a amba ci: “Ine honi eyi a na tu peranga murandu Nyambi? Inene edye nga kana eshima ya Nyambi?” <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />Uno honi yowe odye, owe o munu, ci o cihuthsahuthse na Nyambi? Ene ethsi thsi nombiwa ne kenge nga thsi ambera mukwakuthsumba ci: “Ine eyi o na niumbera kenge?” <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />Ene mukwakumba ne ka a di nokoro o kumba pa diinya dyofoci dyoma kafuma ko ku kwamithsa yo direma noka ko ku kwamithsa yo dingana nji?<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />Mofoci, shaanga ci Nyambi o di noroero o ku monithsa oanthzi wenthzi nokoro wenthzi, unone aa kwata mucima kowa u keyera oanthzi wenthzi, awa na roera ku thzirithsiwa. <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />Aa kwamanga kengeyo ci a monithse okuru o kutethzima kwenthzi kowa a na tambura ñeke thzenthzi, awa a roethsiwerire cimo kutethzima. <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />Yatwe ethsire, kadi ku tunderera pohuma ku Majuda, unone noku kwAnukenge. <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />Eci edi a ambire Nyambi ka mukwakukethza Hosea ci:</para>
  <para style="q1" vid="ROM 9:25">“Awa na kana kwikaranga anuange, kenge na ku wethsa ‘anuange’.</para>
  <para style="q2" vid="ROM 9:25">Karo kenge na ku shima awa na kanine ku shima.”<verse eid="ROM 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ROM 9:26" />“Karo momuya mu ndau omu a amberiwire ci:</para>
  <para style="q2" vid="ROM 9:26">‘Kadi mwanuange,’</para>
  <para style="q1" vid="ROM 9:26">modiyo a kwithsiwera ci ‘ana Nyambi oyu yoya.’”<verse eid="ROM 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 9:27" />Karo keyi ya Isiraele, mukwakukethza Isaya wa ambire ci:</para>
  <para style="q1" vid="ROM 9:27">“Shaanga ci taro thzo Maisiraele thzikare eci ruheke ro pa dikambo dyo diwate,</para>
  <para style="q2" vid="ROM 9:27">kenge kwa ku yoyithsiwa pohuma mathsiarethzi.<verse eid="ROM 9:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ROM 9:28" />Inene Fumu kenge</para>
  <para style="q2" vid="ROM 9:28">a ku ratura wanguwangu kaye kokahe.”<verse eid="ROM 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ROM 9:29" />Eci Isaya edi okethzire ci:</para>
  <para style="q1" vid="ROM 9:29">“Nga Fumu Shokoro Ouhe<note caller="+" style="f"><char style="fr" closed="false">9.29 </char><char style="ft" closed="false">Diywi dyo Thsigerike dyaa amba ci “Fumu o Mashwarare o mu Wiru.”</char></note> ka a tu thsierire anahoka,</para>
  <para style="q2" vid="ROM 9:29">nga na twikara eci Sodoma,</para>
  <para style="q2" vid="ROM 9:29">no ku piruka eci Gomora.”<note caller="+" style="f"><char style="fr" closed="false">9.29 </char><char style="ft" closed="false">Sodoma na Gomora: Nyambi wa tumekire aa mambongi edi nanu wahe awa tungiremo inene shime na tendanga omango oukuru.</char></note><note caller="-" style="x"><char style="xo" closed="false">9.29 </char><char style="xt" closed="false"><ref loc="ISA 1:9">Isa 1.9</ref>.</char></note><verse eid="ROM 9:29" /></para>
  <para style="s1">Kukanakutawa kwa Isiraele</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />Wangu tu ambe ine honi? Kenge tu amba ci Anukenge awa kanine ku koña owawa na tendiwa owawawa pa meho a Nyambi ko thsitawo. <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />Uno honi Maisiraele awa shupwerire murao ci ekare owawawa pa meho a Nyambi, ka na twethsa ku tenda kengeyo. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />Thsine na thsi wa kwangithsa? Na kwanga, inene ka kwamine kengeyo ko thsitawo unone kekwama. A kuñukire pa diwe dyo ku kuñukithsa. <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />Eci edi i na ñoriwa ci:</para>
  <para style="q1" vid="ROM 9:33">“O mone, naa paka mu Sione diwe dyo ku kuñukithsa anu,</para>
  <para style="q2" vid="ROM 9:33">karo diwe dyo ku wa withsa,</para>
  <para style="q1" vid="ROM 9:33">unone o ku tawa ku kwenthzi mbera ka a fithsiwa honyi.”<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="rem">TA, MN, HS, CC</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />Andengenu, eshima yo mucima wange no thsirombero thsange kwa Nyambi po ci aenthzange Maisiraele nga yoyithsiwe. <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />Naa pa ombangi ci aa shima nene Nyambi, uno honi oko ku shima nene kwo ka ku nungiwire podimukero o shemwa. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />Inene ka na yuvithsithsa omu a tendera Nyambi anu kwikara owawawa. Awo ko ku fota dikuñwa dyo athsinda, ka cihuthsire kushi thzowawa wa Nyambi. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />Inene Krisitu yodiyo ohura weanekera yo murao wa Mushe eyi wa piwerire. Mweyo, yomuhe o ku tawa ku kwenthzi, aa tendiwa omuwawa pa meho a Nyambi.<verse eid="ROM 10:4" /></para>
  <para style="s1">Kuyoyithsiwa po kwanu wahe</para>
  <para style="m">
    <verse number="5" style="v" sid="ROM 10:5" />Inene Mushe wa ñorire kenge keyi yowawa o ku tunderera ku ku shupwera Murao ci: “Munu o ku tenda eyi u amba Murao, kenge a ku yoya kayo.” <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />Uno honi owawa ko thsitawo waa amba ci: “Wa amba mu mucima woe ci: ‘Edye oyu wa ku thzina mu wiru?’” (ci a ka rete Krisitu pa kaye), <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />“inji ci: ‘Edye oyu wa ku thza kushi thzo kaye?’ ” (ci a ka pindure Krisitu kwafu). <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />Unone waa amba ine? Eyi u na amba po eyi, “Diywi dya Nyambi pepi di di nenu, mu kanwa koe di di no mu mucima woe,” adyo diywi dyo thsitawo edi tu honga. <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />Inene ngeci owepo citawera ko kanwa koe ci Yesu po Fumu, no ku tawa mu mucima woe ci Nyambi wa mu pindurire kwafu, kenge wa ku yoyithsiwa. <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />Inene ko mucima munu aa tawa no ku tendiwa omuwawa, karo ko kanwa munu aa citawera no ku yoyithsiwa. <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />Eci edi amba Mañoro ci: “Yomuhe o ku tawa ku kwenthzi ka a ku fithsiwa honyi.” <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />Inene kwithsa thsiano mu kaci ko Majuda nAnukenge, waheno Fumu wo yofoci, oyu na panga thsiyauthzi wahe awa na mu rombanga. <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />Eci edi ku na ñoriwa ci: “Munu yomuhe oyu wa kwithsa pa dithzina dya Fumu kenge a ku yoyithsiwa.”<verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />Uno honi, ngepi nga a rombera koyu a na kana ku tawa? Karo ngepi nga a tawa koyu a na kana ku yuva yenthzi? Karo ngepi nga a yuva yenthzi ngeci kwithsa oyu na wa hongo. <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />Karo ngepi edi nga a honga munu ngeci ka a tumiwire? Eci edi ku na ñoriwa ci: “Kadi owa noko edyato eyi i reta Muthzimbu Ouwa.”<note caller="-" style="x"><char style="xo" closed="false">10.15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">Isa 52.7</ref>; <ref loc="NAM 1:15">Nah 1.15</ref>.</char></note><verse eid="ROM 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 10:16" />Uno honi kadi cingwa anu wahe a na tawa Muthzimbu Ouwa. Inene Mukwakukethza Isaya wa ambire ci: “Fumu, edye oyu naa tawa muthzimbu wetu?” <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />Mweyo, thsitawo thsaa keya ko ku yuva, ako ku yuva Muthzimbu Ouwa keyi ya Krisitu. <verse eid="ROM 10:17" /><verse number="18" style="v" sid="ROM 10:18" />Uno honi naepura ci: “Ene ka na yuvu ya Krisitu nji? Dyombo, yoshemwa na yuvu, inene ku na ñoriwa ci:</para>
  <para style="q1" vid="ROM 10:18">“Muvumo o diywi dyo na u thzi ñua mu kaye kokahe,</para>
  <para style="q2" vid="ROM 10:18">mane maywi o na a ka kuma ku hura thzo kaye.”<verse eid="ROM 10:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />Karo naepura ci: “Ene Maisiraele ne ka yuvithsithsire nji?” Thso kutanga, Mushe aa amba ci:</para>
  <para style="q1" vid="ROM 10:19">“Kenge na ku mi tendithsa mbamba kanu awa a di ci kadi ditunga.</para>
  <para style="q2" vid="ROM 10:19">Kenge na ku mi anthzipithsa kanu watomba.”<verse eid="ROM 10:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />Karo Isaya wa ambire kondume ou a ambire ci:</para>
  <para style="q1" vid="ROM 10:20">“Na ni waniwa kowa na kana ku ni fotafota,</para>
  <para style="q2" vid="ROM 10:20">Na ni cihokora kowa na kana ku nipaura.”<verse eid="ROM 10:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21" />Unone keyi ya Isiraele a amba ci:</para>
  <para style="q1" vid="ROM 10:21">“Na ni orora moko ange diyuwa mutumbi,</para>
  <para style="q2" vid="ROM 10:21">kwanu o kukana kuyuvera, awa na ni pirukera.”<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="rem">TA, MN, HS, CC</para>
  <para style="s1">Mathsiarethzi a Isiraele</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />Uno honi nipure ci: Ene Nyambi ne naa kana anuenthzi nji? Dyombo! Ame po no Muisiraele shemwa, mwanahoka wa Aburahama, ku tunderera ku mukuta wa Benjamini.<verse eid="ROM 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 11:2" />Nyambi ka naa kana anuenthzi, awa a hangurire cimo ku tunda ku matatekero. Ene ka mu dimukire eyi a amba Mañoro keyi ya Eliya ou a dirererire kwa Nyambi Maisiraele ci: <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />“Fumu, nepaa akwakukethza oe no ku umburura tutara toe. Yame pohuma ni na thsiarapo karo name aa fota ku nipaa.”<verse eid="ROM 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 11:4" />Nyambi ne ngepi a mu tawire? Wa ambire ci: “Ni na cipakera nothsinda anu o 7,000 awa na kana ku rombera Baale.”<verse eid="ROM 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 11:5" />Mofoci no thsino thsikati, ko a di mathsiarethzi, awa na hanguriwa ko thsihemo thsa Nyambi. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />Uno honi pakuninga ci na a wa hangura ko thsihemo thsenthzi, apo honi kadi cingwa aa wa hangura kekwama yo. Napoci kengeyo, thsihemo thsa Nyambi nga kadi thsihemo shemwa.<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />Ine ne honi? Maisiraele a kwangire ku wana eyi a koñine. Akwakuhanguriwa na i wana, uno honi amweya wahe na karupithsiwa micima. <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />Eci edi ku na ñoriwa ci:</para>
  <para style="q1" vid="ROM 11:8">“Nyambi naa wa pa mupepo o turo.</para>
  <para style="q2" vid="ROM 11:8">Meho o ka a monine,</para>
  <para style="q2" vid="ROM 11:8">no matwi o kadi a ku yuva,</para>
  <para style="q1" vid="ROM 11:8">ku na kuma no thsino thsikati.”<verse eid="ROM 11:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="ROM 11:9" />Davida aa amba ci:</para>
  <para style="q1" vid="ROM 11:9">Edika yo nga ikare thsiraha no kashaka,</para>
  <para style="q2" vid="ROM 11:9">ikare thsikuñu, a we no ku piwa murandu.<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />Meho o nga a thsikiwe ci a mona,</para>
  <para style="q2" vid="ROM 11:10">no miongo thzo thzi kundumane diyere.<verse eid="ROM 11:10" /></para>
  <para style="s1">Anukenge aa shomeneniwamo</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />Naepura karo, ene Majuda ne shime kuñukire ci a wererere nji? Dyombo! Uno honi mukaci ko murandu wo, kuyoyithsiwa na ku keye kwAnukenge ci Majuda a tende mbamba. <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />Uno honi ngeci murandu wo na u retera rufumo kaye, karo ngeci kukwanga kwo na ku retera thsiyauthzi Anukenge, thsa ku kuma kupi thsiyauthzi ethsi thsa kwikarako taro thzo ou thza ku kwanenena?<verse eid="ROM 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />Naa ambera amwe mwAnukenge. Edi ni di ci no kanganda kwAnukenge, naa cishangarera ekwama yange, <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />ko ku kurupera ci ngwa kenge nga ni tendithsa mbamba aenthzange Majuda, ci nga ni yoyithseko amweya. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />Inene ngeci kukaniwa kwo po kuhuthsera kaye kwa Nyambi, ku tamburiwa kwo honi ne, kadi kenge ya kwikara mwoyo ku tunderera kwafu? <verse eid="ROM 11:15" /><verse number="16" style="v" sid="ROM 11:16" />Ngeci mbaravura thzo dikende ethzi thzi piwa kwa Nyambi eci mutomwa thzikenu, dikende dyodihe dikenu. Karo ngeci muthzithzi ukenu, no mite nathzo thzikenu.<figure style="fig" alt="Grafting in a branch" file="gt00121.jpg" size="col" loc="Rom 11:13-16" copy="Gordon" ref="11.17-24">Ku shomenena mute</figure><verse eid="ROM 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 11:17" />Uno honi ngeci mite thzimweya thza tetiwireko, owe honi, shaanga ci o muywera o mu murundu no shomeneniwa mu kaci ko Majuda, pano honi mwaa citapera ku kuyameniwa ku muthzithzi o muywera o mu diumbo, <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />mwa shwahura mite ethzi na thzi tetiwako. Ngepi nga o cinuneka, o dimuke ci kadi cingwa yowe o na tanarithsa muthzithzi, unone muthzithzi odiyo u na ku tanarithsa. <verse eid="ROM 11:18" /><verse number="19" style="v" sid="ROM 11:19" />Ngwa kenge nga o amba ci: “Ethzo mite thza tetiwireko ci ame ni shomeneniwe mu ndau thzathzo.” <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />Ii, eyo ya shemwa. Unone o dimuke ci na thzi tetiwako mukaci ko kukana kwo ku tawa, owe o dimo mukaci ko thsitawo. Mweyo, wa cinuneka unone o yape. <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />Inene ngeci Nyambi ka andwire mite thzathso shemwa, namwe ka a ku miandwa.<verse eid="ROM 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 11:22" />Pano honi o mone thsihemo thsa Nyambi apa thsi kuma, nokaru wenthzi apa u kuma. Okaru kowa na u, unone thsihemo ku kwenu, ngeci amwepo mwikara pohuma mu thsihemo thsenthzi. Ngeci kadi kengeyo, namwe kenge mwa ku tetiwako. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />Karo shaanga awo ngeci ka ku twarerera mu kukana ku tawa kwo, kenge a ku shomeneniwamo, inene Nyambi po o di nokoro o ku wa shomenenamo karo. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />Owe po o mute ou wa tetiwire ku muywera o mu murundu. Ngeci Nyambi keshima yenthzi wa ku shomenenine ku muywera wenthzi o ku kuna, eyi ya kana ku enderera nenu edi yekara, athzo honi mite thzathso shemwa ne, kadi kenge a ku ciroithsera ku thzi shomenenamo karo!<verse eid="ROM 11:24" /></para>
  <para style="s1">Thsihemo thsa Nyambi kwanu wahe</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />Andengenu, ko di di diano edi ni fota ci mu di dimuke ci katere mwa ku cinuneke. Mukanayuva o Maisiraele ka wa kwikarerera, kenge wa kwikarako shime apa thza ku kwanena taro thzAnukenge ou a ku keya kwa Krisitu. <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />Kenge modiyo a ku yoyithsiwera Isiraele yomuhe, eci edi i na ñoriwa ci:</para>
  <para style="q1" vid="ROM 11:26">“Muamweni kenge a ku tunderera mu Sione,</para>
  <para style="q2" vid="ROM 11:26">kenge a ku tundithsa omango ouhe kwa Jakovo,<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />ethsi thsodiyo thsa kwikara thsiyuvano thsangeno,</para>
  <para style="q2" vid="ROM 11:27">ou na ku tundithsa evi yo.”<verse eid="ROM 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28" />Ko ku vara omu na kanena Muthzimbu Ouwa, awo Majuda po akwethzimbo ya Nyambi mukaci kenu. Uno honi ko ku vara edi a hanguriwire, ashimiwa a Nyambi mukaci kakwathsañuru wo. <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />Inene epa no kwithsiwa kwa Nyambi ka ya huthsiwa. <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />Amwe mwAnukenge ka mwa yuverire Nyambi mwikati yo ku manyima, unone pano na mu tambura ñeke mukaci ko kukana kuyuvera ko Majuda. <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />Mofoci, nawo na tende mukanayuva ci nga ko ñeke ethzi thzi monithsiwa ku kwenu, nawo nga a tambure ñeke. <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />Inene Nyambi naanga anu wahe mu mukanayuva, ci nga a monithse ñeke kwanu wahe.<verse eid="ROM 11:32" /></para>
  <para style="s1">Ku shangariwe Nyambi</para>
  <para style="q1">
    <verse number="33" style="v" sid="ROM 11:33" />Mayuwane rufumo rwa Nyambi pongi! Onyanyami nodimukero wenthzi i thzungi nene.</para>
  <para style="q2" vid="ROM 11:33">Edye oyu nga twethsa ku tongonona maraturo enthzi?</para>
  <para style="q2" vid="ROM 11:33">Edye oyu nga yuvithsithsa makuñwa enthzi?<verse eid="ROM 11:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34" />“Edye na dimuka maano a Fumu,</para>
  <para style="q2" vid="ROM 11:34">nji edye oyu nga mu honga?”<verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />“Nji edye oyu wa mu pa thsinu,</para>
  <para style="q2" vid="ROM 11:35">ci Nyambi nga a thsi kure?”<verse eid="ROM 11:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="ROM 11:36" />Inene enu yoihe yaa tunda ku kwenthzi, karo ya ekarako kokoro wenthzi, karo yaa tendiwera aye.</para>
  <para style="q2" vid="ROM 11:36">Kutethzima kwikare ku kwenthzi diyere. Ameni.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="rem">TA, MN, MB, RS, HS, CC</para>
  <para style="s1">Ku yoyera ku kwamena Nyambi mu mwoyo oupe</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />Mweyo, andengenu, naa mi adikanena ko ñekeñeke thza Nyambi ci mu tupwere erama yenu kwa Nyambi kwikara thsiyambero thsothsiyumi, thsothsikenu, karo thso ku roerithsa Nyambi. Edi dyodiyo dikuñwa dyodiwa dyo ku rombera Nyambi. <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />Mwa temununa mikarero thzo kano kaye, unone mu thsie Nyambi a mi pirure mu kaci, a pirure maano enu. Mbeci honi mwa ku twethse ku yuvithsithsa eshima ya Nyambi, ayo yoiwa, yo ku mu roerithsa, karo yo kwononoka.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />Inene ko thsihemo ethsi na ni piwa naa amba ku kwenu mwahe ci mwa anekera ci mwakuru mu thsivaka kupita edi mu di. Mwikare neanekera yo ku cihuthsa kushi. Munu no munu a cirature kopa thsi kuma thsitawo ethsi naa mu pa Nyambi. <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />Dyodi i di erama yetu nepo yoingi, karo thsipo no thsipo thsi di nekwama yathso, <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />dyo i di nerama ya Krisitu, shaanga ci twangi, twerama yofoci mwa Krisitu, twahe tu na nunganungiwa.<verse eid="ROM 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 12:6" />Tu di nepa yo ku cithsiathsia kokuthza komu naa tu pera Nyambi ko thsihemo thsenthzi. Ngeci thsipa thsoe po kukethza, okethze kokuthza ko thsitawo thsoe. <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />Ngeci thsipa thsoe po ku kwamena, o kwamene. Ngeci orongithsi, o rongithse omu ku na roera. <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />Ngeci ku tanarithsa amweya micima, o tende kengeyo. Ngeci thsipa thsoe po kupa, o pe. Ngeci oendithsi, o endithse ko ku pakerako maano. Ngeci ku monithsa ñeke, o tende kengeyo ko thsinyanyu.<verse eid="ROM 12:8" /></para>
  <para style="s1">Emonithso yo Mukrisitu o shemwa</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />Thsishimo thsenu thsikare thso shemwa. Mu thzimbe yoimango, karo mu tanarithse yoiwa. <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />Mu cishime oandu eci edi a cishima oandu ana munu yofoci, mu ciremeke oandu mu kaci kenu. <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />Mwa vapa, unone mu kwame nene no ku kwamena Fumu ko mucima wenu ouhe. <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />Mu nyanyuke mukaci kokurupero wenu. Mu tanare micima mu makando, mu rombere ko muooto. <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />Mu citapere naenthzenu akwakutawa eyi mu di nayo o kwa na piri, karo mu tambure nawa munu yomuhe.<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />Mu rombe Nyambi ku fiyawera awa mi nyandithsa. Mwa wa kuta, unone mu rombe Nyambi ci a wa fiyawere. <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />Mu nyanyuke nowa a na nyanyuka, mu dire nowa a dira. <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />Mu yoye ko thsianekera thsofoci namweya. Mwa cinuneka, unone mu ambaure nowa a di kushi. Mwa cimona onyanyami.<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />Mwa huthsera omango nomango. Mu mamere ci mwaa kwama enu eyi a na vara anu wahe ci iwa. <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />Mu kwame momuhe omu mu na twethsera ci mu yoye ko thsiyaro nanu wahe. <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />Ashimiwa ange, mwa huthsera omango, unone mu i thsiere oanthzi wa Nyambi, inene ku na ñoriwa ci: “Ditoto po dyange, kenge na ku wa kura,” Fumu aa amba. <verse eid="ROM 12:19" /><verse number="20" style="v" sid="ROM 12:20" />Karo ku na ñoriwa ci:</para>
  <para style="q1" vid="ROM 12:20">“Ngeci mukwathsithzimbo thsoe aa fa nthzara, o mu pe yo ku dya.</para>
  <para style="q2" vid="ROM 12:20">Ngeci aa fa dinotwa, o mu pe meyu o ku nwa.</para>
  <para style="q1" vid="ROM 12:20">Ko ku kwama kengeyo kenge wa ku rundumeka makara o mudiro o honyi pa mutwi wenthzi.”<verse eid="ROM 12:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 12:21" />Mwa othziwa kumango, unone mu othze omango kowa.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="rem">ML, MN, MB, RS, HS, CC</para>
  <para style="s1">Edi mu na roera ku remeka awa di peturo</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />Munu yomuhe aa roera ku cihuthsa kushi thzowa di peturo mu kutumina, inene muendithsi yomuhe Nyambi naa mu hangura, aa endithsa kokoro wa Nyambi. <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />Mweyo, munu yomuhe o ku shwahura oendithsi aa shwahura eyi naa hangura Nyambi, karo kenge a ku piwa humbithso. <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />Inene munu o ku tenda yoiwa tumba nga a yapa aendithsi, unone o kwipithsa yodiyo o ku yapa aendithsi. Ene waa fota ku yoya ko kukana ku yapa aendithsi nji? O tende yoiwa, aendithsi kenge a ku shangara. <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />Inene aendithsi po angamba Nyambi, aa ku tangerera ku ku twara kweyi yoiwa. Unone ngeci waa tenda yoimango waa roera ku wa yapa, inene yo shemwa a di nokoro o ku ku pa humbithso. Awo po angamba Nyambi, aa wa tumena ku na pa humbithso awa tenda yoimango. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />Mweyo, munu aa roera ku cihuthsa kushi thzaendithsi, kadi ko ku yapa pohuma humbithso, unone mukaci ko ku dimuka eyi i na roera ku tendiwa.<verse eid="ROM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6" />Karo ngeyi mu na tereranga. Inene aendithsi aa kwamena Nyambi o kwa kwama ekwama yo. <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />Mu futwere anu wahe awa na mu korotera, mu tere ngara mutero kwanu awa a na roera ku tereriwa. Karo mu pe direma kwanu wahe awa a na roera ku remekiwa.<verse eid="ROM 13:7" /></para>
  <para style="s1">Eyi i na roera ku munu no munu</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />Mwekara no makongo kwa munu shime makongo edi mu na roera ku cishima oandu, inene o ku shima muenthzenthzi aa hengeka murao. <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />Inene eraerera yo ku amba ci: “Kadi o mukwa ku rembeka, kadi o mukwa kwipaa, kadi o mukwa kwithza, kadi o mukwa ku cikumbwethza,” neraerera imweya kengeyo, i na cipundeka mwethsi thsiraerera thsofoci thso ku amba ci: “O shime muenthzoe eci edi wa cishima othsinda.” <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />Thsishimo ka thsa tenda omango kwa muenthzoe. Mweyo, thsishimo thsaa yarithserera murao ouhe.<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />Mwaa roera ku tenda kengeyo, inene mu na dimuka ci thsino thsikati ne thsikati thso ngepi. Thsino po thsikati thso ku pinduka pa turo. Inene thsikati thso kuyoyithsiwa kwetu pepi thsi di kupita uya twa tangire ku tawa. <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />Othsiku u na thzi honi, diyuwa di tamba ku va. Tu thsienu ekwama yo mirema, tu shimbe erwithsa eyi twa ku rwithsa mu mwethzi. <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />Mweyo, pakuninga ci na tu henyena ku mwethzi o diyuwa, twaa roera ku yoya ko direma, kadi kedika yo kaye notakwa nji ruthziho nji ongurunde nji mamvo nji mbamba. <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />Uno honi mu cishupeke Fumu Yesu Krisitu, karo mwa tawethza ecikumbwethza yerama ku mi endithsa.<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="rem">TA, MN, MB, RS, HS, CC</para>
  <para style="s1">Wa ratura yumweya</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />Mu tambure mukwakutawa o ku faratera mu thsitawo, uno honi mwa cikanyeka nenthzi keyi yo mianekerero thzenthzi. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />Inene munu yumweya aa tawa ci aa twethsa ku dya ngara thsinu, uno honi o thsitawo thso ku faratera aa dya pohuma miroho. <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />Oyu dya ngara thsinu a shomorora oyu kana ku dya enu yoihe, karo oyu kana ku dya ngara thsinu a ratura oyu dya ngara thsinu, inene Nyambi na mu tambura. <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />Yowe odye ci o rature ngamba wa munu wao? Ñathsire wenthzi yo na roera ku mu ratura nji aa tanara nji aa wa. Kenge a ku tanara, inene Fumu aa twethsa ku mu tanarithsa.<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />Munu yumweya aa shimba ci diyuwa dimweya dikuru mu thsivaka ku pita amweya, unone yumweya aa anekera ci oahe mayuwa mofoci. Munu no munu a tende ethsi a rakwa shemwa mu maano enthzi. <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />Oyu na hengeka diyuwa dyofoci kwikara dyodikuru mu thsivaka, aa kwama kengeyo ko ku remeka Fumu. Oyu dya ngara thsinu, aa tenda kengeyo ko ku remeka Fumu, inene aa pa okanderero kwa Nyambi o ku shime ku dya. Karo noyu kana ku dya ngara thsinu aa tenda kengeyo mukaci ka Fumu, karo aa pa okanderero kwa Nyambi. <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />Inene ku kwetu kwithsa oyu na ciyoyera, karo kwithsa oyu na ciferanga. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />Inene ngeci twaa yoya, twaa yoyera kwa Fumu, ngeci twaa fa, twaa fera kwa Fumu. Mweyo, nji twaa yoya nji twaa fa, twakwa Fumu.<verse eid="ROM 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 14:9" />Inene eyi yodiyo a fererire Krisitu no ku pinduka karo kwafu, ci nga ekare Fumu wafu nayumi. <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" />Ine eyi o ratwera muenthzoe mukwakutawa? Ine eyi o shomorwera muenthzoe mukwakutawa? Inene twahe kenge twa kwimana pa rupara ro thsipura thsa Nyambi thso ku ratwera. <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />Inene ku na ñoriwa ci:</para>
  <para style="q1" vid="ROM 14:11">Ame ni yoya, Fumu aa amba,</para>
  <para style="q1" vid="ROM 14:11">munu no munu kenge a ku tongama pa rupara rwange,</para>
  <para style="q2" vid="ROM 14:11">karo dimi no dimi kenge thza ku citawera ci no Nyambi.<verse eid="ROM 14:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />Mweyo, munu no munu kenge a ku citawera pa meho a Nyambi.<verse eid="ROM 14:12" /></para>
  <para style="s1">Wa withsa muenthzoe mukwakutawa</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />Mweyo, tu thsienu ku ciraturaratura honi, unone tu mone ci twa kwangithsa amweya nji kwikara thsiparaka thsa yumweya. <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />Ni na dimuka karo naa rakwa shemwa mwa Fumu Yesu ci kwithsa thso dithziro athso thsothsinda. Uno honi thsa dithziro koyu na anekera ci thsa dithziro. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />Inene ngeci waa korithsa ku mucima muenthzoe kethsi o dya, apo honi ko endire mu thsishimo. Keyi o dya wepithsa mwoyo o munu oyu a fererire Krisitu. <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />Mweyo, ethsi mu shimba ci thsiwa, mu mone ci kwithsa oyu thsi ninga ci thsimango. <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />Inene Kutumina kwa Nyambi po kadi kwa ku dya no ku nwa unone kwa owawa no thsiyaro no thsinyanyu mu Mupepo Oukenu. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />Munu yomuhe o ku kwamena Krisitu kedi dikuñwa kenge a ku roerithsa Nyambi, karo anu kenge a ku mu tawethza.<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />Mweyo, tu koñomekenu yo ku reta thsiyaro neyi yumba thsitawo thso munu no munu ku kwetu.<verse eid="ROM 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 14:20" />Mwepithsa ekwama ya Nyambi mukaci kedya. Edya yoihe ikenu, uno honi kadi iwa ku dya ngara thsinu thso ku retithsera yumweya ku kuñuka. <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />Ku di nawa ku kana ku dya nyama nji ku nwa waine nji ku tenda ngara thsinu ngeci thsaa twethsa ku withsa muenthzoe mukwakutawa.<verse eid="ROM 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 14:22" />Eyi o na tawa keyi, o i cipakere mu kaci koe na Nyambi. Wa thsiyauthzi munu o kukana ku ciratura thsinda keyi a na mono ci yaa roera. <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />Uno honi yomuhe o ku tamangera ci aa roera ku dya nji dyombo, ngeci ayepo dya a tenda thsivi. Inene ka a shupwerire omu a na tawera, karo enu yoihe yo kukana ku tunderera ku thsitawo po thsivi.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="rem">MN, MN, MB, RS, HS, CC</para>
  <para style="s1">Mu temunune Krisitu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />Atwe tu na tanara mu thsitawo twaa roera ku cithzua micima mukaci kakwakutawa aenthzetu awa na faratera. Ka tu roerire ku tenda yo ku nyanyukithsa atwe pohuma. <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />Munu no munu ku kwetu a roerithse muenthzenthzi ko ku mu tendera yoiwa no ku mu umba mu thsitawo. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />Inene shaanga Krisitu ka a tendire yo ku cinyanyukithsa yothsinda, unone eci dyodi ku na ñoriwa ci: “Kushwahura kowa ku shwahura ku na wera pa pange.” <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />Inene enu yoihe eyi ya ñoriwire kukare, shime ya ñoriwerire ku tu rongithsa, ci ko mucima outhzui notanarithso o Mañoro tu twethse kwikara nokurupero.<verse eid="ROM 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 15:5" />Nyambi oyu na panga othzui notanarithso a mi pe ku yoya ko thsianekera thsofoci nanu amweya eci edi a tendire Krisitu Yesu, <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />ci mwahe mwikare no maano ofoci, no diywi dyofoci ci mu shangare Nyambi no Tata wa Fumu wetu Yesu Krisitu.<verse eid="ROM 15:6" /></para>
  <para style="s1">Muthzimbu Ouwa po wa Majuda nAnukenge</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />Mweyo, mu citambure oandu nawa eci Krisitu edi naa mi tambura ci mu twethse ku pa direma kwa Nyambi. <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />Inene naa mi tongwera ci Krisitu shime a pirukire ngamba o Majuda ku monithsa ci Nyambi wa ku rurama, no ku yarithserera eyi a kumbwethzire kwakwathsañuruetu. <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />Karo shime a keyire ci Anukenge nawo a twethse ku shangara Nyambi mukaci ko ñeke thzenthzi eci edi ku na ñoriwa ci:</para>
  <para style="q1" vid="ROM 15:9">“Mweyo, kenge na ku ku shangara mu kaci kAnukenge,</para>
  <para style="q2" vid="ROM 15:9">karo kenge na ku shangara dithzina dyoe ko membo.”<verse eid="ROM 15:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10" />Kuna ñoriwa karo ci:</para>
  <para style="q1" vid="ROM 15:10">“Amwe mwAnukenge, mu roere nanuenthzi.”<verse eid="ROM 15:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11" />Pamweya karo ci:</para>
  <para style="q1" vid="ROM 15:11">“Mu shangare Fumu, mwahe amwe mwanukenge,</para>
  <para style="q2" vid="ROM 15:11">Mu mu shangare, mwahe amwe mwa mambunga.”<verse eid="ROM 15:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />Isaya naye karo wa ambire ci:</para>
  <para style="q1" vid="ROM 15:12">“Mwanahoka wa Jese kenge mba a keya,</para>
  <para style="q2" vid="ROM 15:12">oyu wa ku endithsa Anukenge,</para>
  <para style="q1" vid="ROM 15:12">karo kenge mba paka okurupero wo ku kwenthzi.”<verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />Uno honi Nyambi, aye oyu mu na kurupera, a mi pe thsinyanyu thso kuyara no thsiyaro mukaci ko thsitawo thsenu, ci okurupero wenu u twarerere ku kura kokoro o Mupepo Oukenu.<verse eid="ROM 15:13" /></para>
  <para style="s1">Ekwama ya Paulu</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />Andengenu, ame naa tawa shemwa ci mu na yara owa, mu di nodimukero o kuyara, karo mwaa twethsa ku cirongithsa oandu. <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />Uno honi na ni mi ñorera kondume mwiambaura imweya, ci ni i mi vurukithse, mukaci ko thsihemo ethsi na a ni pa Nyambi. <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />Nyambi wa ni hangurire ci nikare mukwakukwama wa Krisitu Yesu kwAnukenge. Wa ni pire ekwama yopurisita yo ku rongithsa Muthzimbu wenthzi Ouwa. Nyambi wa tendire eyi ci Mupepo Oukenu u twethse ku tenda Anukenge kwikara eyambero yoikenu yo ku mu roerithsa.<verse eid="ROM 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 15:17" />Pakuninga ci kwa Krisitu Yesu ni di, naa twethsa honi ku cishangara mwikwama yange kwa Nyambi. <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />Unone ka ni keshuka ku amba ngara thsinu shime yekwama eyi na a kwama Krisitu kange ku reta Anukenge ku kuyuvera Nyambi ko maywi netenda yange mu kaciko. <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />Shime a tawire kokoro wemonithso nekomokithsa kokoro o Mupepo wa Nyambi. Mweyo, na ni tongora ko kuyara yo Muthzimbu Ouwa keyi ya Krisitu mu mandau oahe ku tatekera ku Yerusalema shime ku ka kuma mu ditunga dya Iliriko. <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />Unone eshima yange po ku honga Muthzimbu Ouwa keyi ya Krisitu mu mandau aa a kana ku yuva ya Krisitu, ci na umbera pa mushisho wa munu yumweya. <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />Eci edi ku na ñoriwa ci:</para>
  <para style="q1" vid="ROM 15:21">“Awa kanine ku tongweriwa yenthzi kenge mba mona,</para>
  <para style="q2" vid="ROM 15:21">karo awa kanine ku yuva yenthzi kenge mba yuvithsithsa.”<verse eid="ROM 15:21" /></para>
  <para style="s1">Eceka ya Paulu yo ku ka hungera ku Roma</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />Eyi po yodiyo na i ni kwangithsanga rorungi ku na mi hungerithsa.<verse eid="ROM 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 15:23" />Pano honi ka ni di karo no ndau thzekwama mo ano matunga, shime na ni shimbi myaka thzothzingi o ku ni fotanga ku na mi hungerithsa. <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />Naa kurupera ku na mi hungerithsa ou na ku na pita ku thza ku Sipeini. Ou na ku mana ku cikora kwikara nenu mbeci honi na ku fote ci mu ni kwathse mu ruendo rwange.<verse eid="ROM 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 15:25" />Pano po mu dikuñwa ni di ku thza ku Yerusalema ku ka kwathsa akwakutawa a Fumu awa diko. <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />Inene makereke o mu Masedonia no mu Akaya na i wa roerithsa ku tendera koreko akwakutawa wahepwe o ku Yerusalema. <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />Wodiyo athsinda na shimi nene ku tenda kengeyo, karo shemwa shemwa a di no makongo ku kwo. Inene ngeci Anukenge na tambura thsiyauthzi thso mupepo thso Muthzimbu Ouwa ku tunderera ku Majuda, nawo aa roera ku wa kwathsa kewana yo. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />Mweyo, ou na ku mana eyi ekwama no ku ka kumithsa eyi ya ku korekiwa, kenge na ku na pita oko o ku ni thza ku Sipeini. <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />Karo ni na dimuka ci ku keya kwange ku na mi hungerithsa kenge kwa ku mi retithsera ci Krisitu a mi fiyawere ko kuyara.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />Andengenu, naa mi adikanena mwa Fumu Yesu Krisitu no thsishimo thsa Mupepo ci mu ciwane nange mu ku tanarithsa ku ni romberera kwa Nyambi. <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />Mu rombere ci Nyambi a ni amwene kwakwakukana ku tawa o mu Judea, karo mu rombere ci eyi ekwathsa ni twara ku Yerusalema i twethse ku ka tamburiwa nawa kwanua Nyambi oku i thza. <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />Mweyo, kenge na ku keya oko o ku ni na nyanyuka nene ngeci Nyambi waa ku i shime, kenge na ku na cikora kuyooyera ou na ku nekara nenu. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />Naa rombera ci Nyambi oyu na panga thsiyaro ekare nenu mwahe. Ameni.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="rem">AM, MN, MB, RS, HS</para>
  <para style="s1">Paulu aa vumenena</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />Naa mi pa ombangi keyi ya ndumbuthzetu Febe, ngamba o kereke thzo mu Sengeria. <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />Naa mi romba ci mu mu tambure mu dithzina dya Fumu ko dikuñwa edi di na roera akwakutawa. Karo mu mu kwathse enu yoihe eyi nga a fota ku kwenu, inene naa kwathsa anu owangi, mane name kengeyo.<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />Mu ni vumenenene Purisila na Akwila, awa ni na kwamena pofocino mwikwama ya Krisitu Yesu. <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />A kokire myoyo thzo pa thsaara mukaci kange. Naa kanderera kukwo, kadi ame pohuma unone no makereke oahe Anukenge aa kanderera kukwo. <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />Karo mu ni vumenenene no kereke ethzi thzi na ciwanenanga mu nthzio thzo.</para>
  <para style="p" vid="ROM 16:5">Mu ni vumenenene Epeneto mushimiwa wange, oyu wa tangire ku tawa kwa Krisitu mu Asia. <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />Mu ni vumenenene Madiya oyu naa kwama nene ku mi kwathsa. <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />Mu ni vumenenene Anderonika na Junia, aenthzange Majuda awa nekara nange mu kamenga. A na dimukiwa nene mu kaci ko tunganda, karo wodiyo a tangire ku tawa kwa Krisitu ame o ku ni shime. <verse eid="ROM 16:7" /><verse number="8" style="v" sid="ROM 16:8" />Mu ni vumenenene Ampiliatasi, oyu na shima mwa Fumu. <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />Mu ni vumenenene Uribano, muenthzetu mwikwama ya Krisitu, mofoci kengeyo na mushimiwa wange Sitakisi.<verse eid="ROM 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 16:10" />Mu ni vumenenene Apele, oyu naa tawethziwa mwa Krisitu. Karo mu ni vumenenene awa di mu mwanda wa Arisitobulu. <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />Mu ni vumenenene muenthzange Mujuda Herodioni. Mu ni vumenenene o mu mwanda wa Narisiso awa na tawa kwa Fumu. <verse eid="ROM 16:11" /><verse number="12" style="v" sid="ROM 16:12" />Mu ni vumenenene Tirifena na Tirifosa awa kwamena Fumu. Mu ni vumenenene Perisisi mushimiwa wange, oyu naa kwamena nene Fumu. <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" />Mu ni vumenenene Rufusi, oyu naa hanguriwa kwa Fumu, karo mu ni vumenenene no mama wenthzi oyu naa piruka mama name.<verse eid="ROM 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 16:14" />Mu ni vumenenene Asinkirito, Fulegoni, Heremesi, Patirobasi, Heremasi, nakwakutawa amweya wahe awa a nekarangano. <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />Mu vumenene Filologo no Julia, no Nerea na ndumbuthzenthzi, no Olimpa nakwakutawa wahe awa a dino. <verse eid="ROM 16:15" /><verse number="16" style="v" sid="ROM 16:16" />Mu civumenenange namweya ko thsitawo. Makereke a Krisitu oahe aa mi vumenena.<verse eid="ROM 16:16" /></para>
  <para style="s1">Eraerera yo mamaneneno</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />Andengenu, naa mi romba honi ci mu mamere awa reta kucitepatepa no ku kuñukithsa thsitawo thsenu eyi i rwithsa erongithsa eyi na mu rongithsiwa. Mu tunde kukwo. <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />Inene anu o kengeyo ka kwamenine Fumu wetu Krisitu, unone eshima yo. Ko maywi o oawa no maywi o o ku nthzembereka a angera o woto micima. <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />Anu wahe na yuvu ci mwaa yuvera Fumu, mweyo, naa nyanyuka mukaci kenu, uno honi naa fota ci mu nyanyame kweyi yoiwa, no kupira murandu kweyi yoimango.<verse eid="ROM 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 16:20" />Nyambi o thsiyaro tamba kwororora Satana kushi thzedyato yenu. Thsihemo thsa Fumu wetu Yesu Krisitu thsikare nenu.<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />Timoti, aye oyu ni kwamena pofoci nenthzi, aa mi vumenena, mofoci kengeyo na Lusiusi, Jasoni na Sosipatere, aenthzange Majuda nawo aa mi vumenena.<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />Ame no Teritiusi, oyu naa ñoro edi diñoro naa mi vumenena mu dithzina dya Fumu.<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />Gayusi oyu na ni tamburanga no ku tamburanga kengeyo kereke thzothzihe aa mi vumenena. Erasito mukwakunyunga madi o mbongi, na Kwarito muenthzetu aa mi vumenena. <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />[Thsihemo thsa Fumu wetu Yesu Krisitu thsikare nenu. Ameni.]<note caller="+" style="f"><char style="fr" closed="false">16.24 </char><char style="ft" closed="false">Ka thzi di mu mañoro o kutanga.</char></note><verse eid="ROM 16:24" /></para>
  <para style="s1">Thsirombero thso ku yemekera</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />Kutethzima honi kwikare kwa Nyambi, aye o ku twethsa ku mi koropithsa, eci dyodi u amba Muthzimbu Ouwa ou ni honga, ao Muthzimbu wa Yesu Krisitu, kokuthza kehokora yo diano edi dya horekiwire ko myaka na myaka. <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />Uno honi, eñora yakwakukethza na i reta ci oshemwa u hokoriwe ku matunga oahe. Nyambi o diyere naa i raerera kengeyo, ci anu nga tawe ku kwenthzi no ku mu yuvera. <verse eid="ROM 16:26" /><verse number="27" style="v" sid="ROM 16:27" />Kutethzima kwikare diyere kwa Nyambi aye o munyanyami pohuma, mwa Yesu Krisitu! Ameni.<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>