<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id"/>
  <para style="h">Salmos</para>
  <para style="toc3">Sal</para>
  <para style="toc2">Salmos</para>
  <para style="toc1">Salmos</para>
  <para style="mt">Salmos</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="s1">Prólogo</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 1:1"/>¡Inmensamente feliz<note caller="+" style="f"><char style="fr" closed="false">1.1 </char><char style="ft" closed="false">Lit. <char style="nd">Bienaventurado.</char></char></note> es el varón que no anduvo en consejo de impíos,</para>
  <para style="q" vid="PSA 1:1">Ni se detuvo en camino de pecadores,</para>
  <para style="q" vid="PSA 1:1">Ni se sentó en silla de burladores!<verse eid="PSA 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 1:2"/>Sino en la Ley de <char style="nd">Yavé</char> halla complacencia,</para>
  <para style="q" vid="PSA 1:2">Y en su Ley reflexiona de día y de noche.<verse eid="PSA 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 1:3"/>Será como árbol plantado junto a corrientes de agua</para>
  <para style="q" vid="PSA 1:3">Que da su fruto a su tiempo</para>
  <para style="q" vid="PSA 1:3">Y su follaje no se marchita.</para>
  <para style="q" vid="PSA 1:3">Todo lo que hace tendrá éxito.<verse eid="PSA 1:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 1:4"/>No así los impíos,</para>
  <para style="q" vid="PSA 1:4">Que son como cáscara de grano levantada por el viento.<verse eid="PSA 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 1:5"/>Por tanto, no se levantarán los impíos en el juicio.<verse eid="PSA 1:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 1:6"/>Porque <char style="nd">Yavé</char> conoce el camino de los justos,</para>
  <para style="q" vid="PSA 1:6">Pero la senda de los impíos lleva a destrucción.<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 2:1"/>¿Para qué están en tumulto las naciones,</para>
  <para style="q" vid="PSA 2:1">Y los pueblos maquinan cosas vanas?<verse eid="PSA 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 2:2"/>Los reyes de la tierra se levantarán,</para>
  <para style="q" vid="PSA 2:2">Y gobernantes conspirarán unidos</para>
  <para style="q" vid="PSA 2:2">Contra <char style="nd">Yavé</char> y contra su Ungido, y dicen:<verse eid="PSA 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 2:3"/>¡Rompamos sus ataduras</para>
  <para style="q" vid="PSA 2:3">Y quitemos de nosotros sus cuerdas!<verse eid="PSA 2:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 2:4"/>El que está sentado en los cielos se reirá.</para>
  <para style="q" vid="PSA 2:4">
    <char style="nd">ʼAdonay</char> se burlará de ellos.<verse eid="PSA 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 2:5"/>Luego les hablará en su furor.</para>
  <para style="q" vid="PSA 2:5">Los conturbará en su ira.<verse eid="PSA 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 2:6"/>
    <char style="wj">Yo mismo consagré</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">2.6 </char>
      <char style="ft" closed="false">Lit. he consagrado.</char>
    </note> <char style="wj">a mi Rey sobre Sion, </char></para>
  <para style="q" vid="PSA 2:6">
    <char style="wj">Mi Montaña Santa.</char><verse eid="PSA 2:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 2:7"/>
    <char style="wj">Yo promulgaré el decreto.</char></para>
  <para style="q" vid="PSA 2:7">
    <char style="nd">Yavé</char> me dijo:</para>
  <para style="q" vid="PSA 2:7">
    <char style="wj">Mi Hijo eres Tú,</char></para>
  <para style="q" vid="PSA 2:7">
    <char style="wj">Yo te engendré hoy.</char><verse eid="PSA 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 2:8"/>
    <char style="wj">Pídeme y te daré los pueblos en posesión,</char></para>
  <para style="q" vid="PSA 2:8">
    <char style="wj">Y como herencia tuya los confines de la tierra.</char><verse eid="PSA 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 2:9"/>Los quebrantarás con vara de hierro.</para>
  <para style="q" vid="PSA 2:9">Los harás añicos como vasija de alfarero.<verse eid="PSA 2:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 2:10"/>Ahora pues, oh reyes, actúen con sabiduría.</para>
  <para style="q" vid="PSA 2:10">Acepten amonestación, jueces de la tierra:<verse eid="PSA 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 2:11"/>Sirvan a <char style="nd">Yavé</char> con temor</para>
  <para style="q" vid="PSA 2:11">Y regocíjense con temblor.<verse eid="PSA 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 2:12"/>Besen los pies al Hijo</para>
  <para style="q" vid="PSA 2:12">No sea que se enoje y perezcan en el camino,</para>
  <para style="q" vid="PSA 2:12">Pues de repente arde su ira.</para>
  <para style="q" vid="PSA 2:12">Inmensamente felices<note caller="+" style="f"><char style="fr" closed="false">2.12 </char><char style="ft" closed="false">Lit. <char style="nd">Bienaventurado</char>.</char></note> son los que se refugian en Él.<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="s1">Salmo de David cuando huía de su hijo Absalón</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 3:1"/>¡Oh <char style="nd">Yavé</char>, cómo se multiplicaron mis opresores!</para>
  <para style="q" vid="PSA 3:1">Muchos son los que se levantan contra mí.<verse eid="PSA 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 3:2"/>Muchos dicen de mí:</para>
  <para style="q" vid="PSA 3:2">No hay salvación en <char style="nd">ʼElohim</char> para él. <char style="tl">Selah</char><note caller="+" style="f"><char style="fr" closed="false">3.2 </char><char style="ft" closed="false"><char style="nd">Selah</char>. Probablemente piensen en esto.</char></note><verse eid="PSA 3:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 3:3"/>Pero Tú, oh <char style="nd">Yavé</char>, eres escudo alrededor de mí,</para>
  <para style="q" vid="PSA 3:3">Mi gloria, y el que levanta mi cabeza.<verse eid="PSA 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 3:4"/>Clamé a <char style="nd">Yavé</char> con mi voz.<verse eid="PSA 3:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 3:5"/>Yo me acosté y dormí,</para>
  <para style="q" vid="PSA 3:5">Y desperté, porque <char style="nd">Yavé</char> me sustenta.<verse eid="PSA 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 3:6"/>No temeré a decenas de millares de personas</para>
  <para style="q" vid="PSA 3:6">Me sitien que alrededor.<verse eid="PSA 3:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 3:7"/>¡Levántate, oh <char style="nd">Yavé</char>, sálvame, <char style="nd">ʼElohim</char> mío!</para>
  <para style="q" vid="PSA 3:7">Porque Tú eres el que golpea a todos mis enemigos en la mejilla</para>
  <para style="q" vid="PSA 3:7">Y quebrantas los dientes de los impíos.<verse eid="PSA 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 3:8"/>La salvación corresponde a <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 3:8">Sobre tu pueblo sea tu bendición. <char style="tl">Selah</char><verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="s1">Al director del coro, con instrumentos de cuerda. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 4:1"/>¡Oh <char style="nd">ʼElohim</char> de mi justicia, respóndeme cuando clamo!</para>
  <para style="q" vid="PSA 4:1">Tú que me diste holgura en la estrechez,</para>
  <para style="q" vid="PSA 4:1">Ten compasión de mí y escucha mi oración.<verse eid="PSA 4:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 4:2"/>Oh hijos de <char style="add">los</char> hombres,</para>
  <para style="q" vid="PSA 4:2">¿Por cuánto tiempo convertirán mi honra en infamia?</para>
  <para style="q" vid="PSA 4:2">¿Hasta cuando amarán vanidad y buscarán la mentira? <char style="tl">Selah</char><verse eid="PSA 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 4:3"/>Sepan, pues, que <char style="nd">Yavé</char> apartó al piadoso para Él.<verse eid="PSA 4:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 4:4"/>Aírense, pero no pequen.</para>
  <para style="q" vid="PSA 4:4">Mediten en su corazón sobre sus camas.</para>
  <para style="q" vid="PSA 4:4">Guarden silencio. <char style="tl">Selah</char><verse eid="PSA 4:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 4:5"/>Ofrezcan sacrificios de justicia,</para>
  <para style="q" vid="PSA 4:5">Y confíen en <char style="nd">Yavé</char>.<verse eid="PSA 4:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 4:6"/>Muchos dicen: ¡Oh, que viéramos algún bien!</para>
  <para style="q" vid="PSA 4:6">¡Oh <char style="nd">Yavé</char>, levanta sobre nosotros la luz de tu rostro!<verse eid="PSA 4:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 4:7"/>Diste alegría a mi corazón,</para>
  <para style="q" vid="PSA 4:7">Mayor que la de ellos, aun cuando abundan en grano y mosto.<verse eid="PSA 4:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 4:8"/>En paz me acostaré y así dormiré,</para>
  <para style="q" vid="PSA 4:8">Porque solo Tú, <char style="nd">Yavé</char>, me haces vivir confiado.<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="s1">Al director del coro, para instrumentos de viento. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 5:1"/>Escucha, oh <char style="nd">Yavé</char>, mis palabras.</para>
  <para style="q" vid="PSA 5:1">Considera mi susurro.<verse eid="PSA 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 5:2"/>Oye el sonido de mi clamor,</para>
  <para style="q" vid="PSA 5:2">Rey mío y <char style="nd">ʼElohim</char> mío, porque a Ti oro.<verse eid="PSA 5:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 5:3"/>Oh <char style="nd">Yavé</char>, oyes mi voz de mañana.</para>
  <para style="q" vid="PSA 5:3">De mañana la presentaré ante Ti,</para>
  <para style="q" vid="PSA 5:3">Y esperaré.<verse eid="PSA 5:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 5:4"/>Porque Tú no eres un <char style="nd">ʼElohim</char> que se complace en la maldad,</para>
  <para style="q" vid="PSA 5:4">Ni el hombre impío mora contigo.<verse eid="PSA 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 5:5"/>Los arrogantes no se presentarán delante de Ti.</para>
  <para style="q" vid="PSA 5:5">Aborreces a todos los perversos.<verse eid="PSA 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 5:6"/>Destruirás a los que hablan mentira.</para>
  <para style="q" vid="PSA 5:6">
    <char style="nd">Yavé</char> aborrece al hombre sanguinario y engañador.<verse eid="PSA 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 5:7"/>Pero yo entraré en tu Casa por la abundancia de tu firme amor,</para>
  <para style="q" vid="PSA 5:7">Y con reverencia me postraré hacia tu santo Templo.<verse eid="PSA 5:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 5:8"/>Guíame, oh <char style="nd">Yavé</char>, en tu justicia,</para>
  <para style="q" vid="PSA 5:8">A causa de mis adversarios.</para>
  <para style="q" vid="PSA 5:8">Allana tu camino delante de mí.<verse eid="PSA 5:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 5:9"/>Porque no hay veracidad en su lenguaje.</para>
  <para style="q" vid="PSA 5:9">Su corazón es destructivo,</para>
  <para style="q" vid="PSA 5:9">Sepulcro abierto es su garganta.</para>
  <para style="q" vid="PSA 5:9">Con su lengua hablan lisonjas.<verse eid="PSA 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 5:10"/>Oh <char style="nd">ʼElohim</char>, castígalos.</para>
  <para style="q" vid="PSA 5:10">Caigan por sus propios consejos.</para>
  <para style="q" vid="PSA 5:10">Échalos a causa de la multitud de sus transgresiones,</para>
  <para style="q" vid="PSA 5:10">Porque se rebelaron contra Ti.<verse eid="PSA 5:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 5:11"/>Pero, ¡alégrense todos los que confían en Ti!</para>
  <para style="q" vid="PSA 5:11">¡Den voces de júbilo porque Tú los defiendes para siempre!</para>
  <para style="q" vid="PSA 5:11">¡Regocíjense en Ti los que aman tu Nombre!<verse eid="PSA 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 5:12"/>Porque Tú, oh <char style="nd">Yavé</char>, bendecirás al justo,</para>
  <para style="q" vid="PSA 5:12">Como con un escudo lo rodearás de tu favor.<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="s1">Al director del coro, con instrumentos de cuerda. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 6:1"/>Oh <char style="nd">Yavé</char>, no me reprendas en tu furor.</para>
  <para style="q" vid="PSA 6:1">Ni me disciplines en tu ardiente ira.<verse eid="PSA 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 6:2"/>Ten compasión de mí, oh <char style="nd">Yavé</char>, porque desfallezco.</para>
  <para style="q" vid="PSA 6:2">Sáname, oh <char style="nd">Yavé</char>, porque mis huesos están conturbados,<verse eid="PSA 6:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 6:3"/>Y también mi alma en gran manera.</para>
  <para style="q" vid="PSA 6:3">Y Tú, oh <char style="nd">Yavé</char>… ¿hasta cuándo?<verse eid="PSA 6:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 6:4"/>Vuélvete, <char style="nd">Yavé</char>, rescata mi alma.</para>
  <para style="q" vid="PSA 6:4">Sálvame por tu misericordia.<verse eid="PSA 6:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 6:5"/>Porque en la muerte no habrá memoria de Ti.</para>
  <para style="q" vid="PSA 6:5">En el <char style="tl">Seol</char>,<note caller="+" style="f"><char style="fr" closed="false">6.5<char style="tl">Seol</char>: lugar de los muertos. </char><char style="ft" closed="false">En el Nuevo Pacto se tradujo Hades, el mundo invisible, el lugar de los muertos, que no debe confundirse con el Lago de Fuego, que es el lugar de condenación eterna.</char></note> ¿quién te dará gracias?<verse eid="PSA 6:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 6:6"/>Estoy agotado de tanto gemir.</para>
  <para style="q" vid="PSA 6:6">Todas las noches inundo de lágrimas mi almohada.</para>
  <para style="q" vid="PSA 6:6">Con mis lágrimas empapo mi cama.<verse eid="PSA 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 6:7"/>Mis ojos están nublados de tanto sufrir.</para>
  <para style="q" vid="PSA 6:7">Han envejecido a causa de todos mis adversarios.<verse eid="PSA 6:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 6:8"/>Apártense de mí todos los que hacen iniquidad,</para>
  <para style="q" vid="PSA 6:8">Porque <char style="nd">Yavé</char> oyó la voz de mi llanto.<verse eid="PSA 6:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 6:9"/>
    <char style="nd">Yavé</char> escuchó mi súplica.</para>
  <para style="q" vid="PSA 6:9">
    <char style="nd">Yavé</char> recibió mi oración:<verse eid="PSA 6:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 6:10"/>Sean todos mis enemigos avergonzados y muy conturbados,</para>
  <para style="q" vid="PSA 6:10">Que sean vueltos atrás,</para>
  <para style="q" vid="PSA 6:10">Que sean de repente avergonzados.<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="s1">Oda de David, que cantó a <char style="nd">Yavé</char> por causa de las palabras de Cus benjaminita</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 7:1"/>¡Oh <char style="nd">Yavé, ʼElohim</char> mío, en Ti me refugio!</para>
  <para style="q" vid="PSA 7:1">¡Sálvame y líbrame de todos los que me persiguen!<verse eid="PSA 7:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 7:2"/>No sea que el enemigo desgarre mi vida como león,</para>
  <para style="q" vid="PSA 7:2">Que despedace, y no haya quien libre.<verse eid="PSA 7:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 7:3"/>Oh <char style="nd">Yavé, ʼElohim</char> mío, si hice esto,</para>
  <para style="q" vid="PSA 7:3">Si hay iniquidad en mis manos,<verse eid="PSA 7:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 7:4"/>Si pagué con perversidad al que estaba en paz conmigo,</para>
  <para style="q" vid="PSA 7:4">Más bien libré al que sin causa era mi adversario,<verse eid="PSA 7:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 7:5"/>Que el enemigo persiga mi vida y la tome,</para>
  <para style="q" vid="PSA 7:5">Que pisotee en tierra mi vida,</para>
  <para style="q" vid="PSA 7:5">Y haga bajar mi honor hasta el polvo. <char style="tl">Selah</char><verse eid="PSA 7:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 7:6"/>¡Levántate, oh <char style="nd">Yavé</char>, en tu ira!</para>
  <para style="q" vid="PSA 7:6">¡Álzate contra la furia de mis adversarios,</para>
  <para style="q" vid="PSA 7:6">Y despierta a mi favor en el juicio que convocaste!<verse eid="PSA 7:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 7:7"/>¡Que te rodee la asamblea de naciones,</para>
  <para style="q" vid="PSA 7:7">Y sobre ella preside Tú desde lo alto!<verse eid="PSA 7:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 7:8"/>Oh <char style="nd">Yavé</char>, Tú, Impartidor de justicia a los pueblos:</para>
  <para style="q" vid="PSA 7:8">¡Júzgame, <char style="nd">Yavé</char>, conforme a mi rectitud,</para>
  <para style="q" vid="PSA 7:8">Conforme a la integridad que hay en mí!<verse eid="PSA 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 7:9"/>¡Acábese la perversidad de los perversos,</para>
  <para style="q" vid="PSA 7:9">Y sea el justo firmemente establecido!</para>
  <para style="q" vid="PSA 7:9">Porque es justo el <char style="nd">ʼElohim</char> que prueba <char style="add">el</char> corazón</para>
  <para style="q" vid="PSA 7:9">Y lo más íntimo de mi personalidad.<note caller="+" style="f"><char style="fr" closed="false">7.9 </char><char style="ft" closed="false">Lit. riñones. En la cultura hebrea, probablemente, el aspecto más íntimo de la personalidad.</char></note><verse eid="PSA 7:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 7:10"/>Mi escudo es <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 7:10">Quien salva a los rectos de corazón.<verse eid="PSA 7:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 7:11"/>
    <char style="nd">ʼElohim</char> es Juez justo.</para>
  <para style="q" vid="PSA 7:11">Es un <char style="nd">ʼElohim</char> que sentencia cada día.<verse eid="PSA 7:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 7:12"/>Si el hombre no se convierte, afilará su espada.</para>
  <para style="q" vid="PSA 7:12">Tensará su arco y apuntará.<verse eid="PSA 7:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 7:13"/>Se preparó sus armas mortales,</para>
  <para style="q" vid="PSA 7:13">Y dispuso sus flechas abrasadoras.<verse eid="PSA 7:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 7:14"/>Ahí están los dolores de parto de la iniquidad.</para>
  <para style="q" vid="PSA 7:14">Concibió perversidad y dio a luz la falsedad.<verse eid="PSA 7:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 7:15"/>Hizo un hoyo y lo ahondó.</para>
  <para style="q" vid="PSA 7:15">¡Pero él mismo cayó en el foso preparado!<verse eid="PSA 7:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 7:16"/>Su perversidad se revierte sobre su cabeza,</para>
  <para style="q" vid="PSA 7:16">Y su violencia desciende sobre su coronilla.<verse eid="PSA 7:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 7:17"/>Alabaré a <char style="nd">Yavé</char> conforme a su justicia</para>
  <para style="q" vid="PSA 7:17">Y cantaré alabanzas al Nombre de <char style="nd">Yavé</char> el Altísimo.<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="s1">Al director del coro, con notas. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 8:1"/>¡Oh <char style="nd">Yavé</char>, <char style="nd">ʼAdonay</char> nuestro,</para>
  <para style="q" vid="PSA 8:1">Cuán majestuoso es tu Nombre en toda la tierra!</para>
  <para style="b" vid="PSA 8:1"/>
  <para style="q" vid="PSA 8:1">Colocaste tu majestad sobre los cielos.<verse eid="PSA 8:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 8:2"/>De la boca de los niños y de los que maman</para>
  <para style="q" vid="PSA 8:2">Estableciste una fortaleza frente a tus adversarios</para>
  <para style="q" vid="PSA 8:2">Para silenciar al enemigo y al vengador.<verse eid="PSA 8:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 8:3"/>Cuando contemplo tus cielos, la obra de tus dedos,</para>
  <para style="q" vid="PSA 8:3">La luna y las estrellas que Tú afirmaste,<verse eid="PSA 8:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 8:4"/>Digo: ¿Qué es el hombre, para que te acuerdes de él,</para>
  <para style="q" vid="PSA 8:4">El hijo de hombre, para que te preocupes por él?<verse eid="PSA 8:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 8:5"/>Lo hiciste un poco menor que los ángeles.</para>
  <para style="q" vid="PSA 8:5">Lo coronaste de gloria y honor.<verse eid="PSA 8:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 8:6"/>Lo haces dominar sobre las obras de tus manos.</para>
  <para style="q" vid="PSA 8:6">Colocaste todas las cosas debajo de sus pies:<verse eid="PSA 8:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 8:7"/>Ovejas y bueyes, todo ello,</para>
  <para style="q" vid="PSA 8:7">Y también las bestias del campo,<verse eid="PSA 8:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 8:8"/>Las aves del cielo y los peces del mar,</para>
  <para style="q" vid="PSA 8:8">Todo cuanto pasa por los senderos de los mares.<verse eid="PSA 8:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 8:9"/>¡Oh <char style="nd">Yavé</char>, <char style="nd">ʼAdonay</char> nuestro,</para>
  <para style="q" vid="PSA 8:9">Cuán majestuoso es tu Nombre en toda la tierra!<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="s1">Al director del coro. Según <char style="tl">Mut-labbén</char> (melodía del canto “Morir por un hijo”). Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 9:1"/>Daré gracias a <char style="nd">Yavé</char> con todo mi corazón.</para>
  <para style="q" vid="PSA 9:1">Contaré todas tus maravillas.<verse eid="PSA 9:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 9:2"/>Me alegraré y me regocijaré en Ti.</para>
  <para style="q" vid="PSA 9:2">Cantaré alabanza a tu Nombre, oh Altísimo.<verse eid="PSA 9:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 9:3"/>Cuando mis enemigos se volvieron atrás,</para>
  <para style="q" vid="PSA 9:3">Tropezaron y perecieron delante de Ti.<verse eid="PSA 9:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 9:4"/>Porque Tú mantuviste mi justicia y mi causa.</para>
  <para style="q" vid="PSA 9:4">Te sentaste en el trono a juzgar justamente.<verse eid="PSA 9:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 9:5"/>Reprendiste a las naciones,</para>
  <para style="q" vid="PSA 9:5">Destruíste a los perversos,</para>
  <para style="q" vid="PSA 9:5">Borraste su nombre para siempre.<verse eid="PSA 9:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 9:6"/>El enemigo sucumbió en desolación eterna,</para>
  <para style="q" vid="PSA 9:6">Destruiste sus ciudades,</para>
  <para style="q" vid="PSA 9:6">Y con ellas se desvaneció su recuerdo.<verse eid="PSA 9:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 9:7"/>Pero <char style="nd">Yavé</char> permanece para siempre.</para>
  <para style="q" vid="PSA 9:7">Él estableció su trono para el juicio<verse eid="PSA 9:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 9:8"/>Y juzgará al mundo con justicia.</para>
  <para style="q" vid="PSA 9:8">Hará juicio con equidad a las naciones.<verse eid="PSA 9:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 9:9"/>
    <char style="nd">Yavé</char> será un refugio, una torre alta para el oprimido,</para>
  <para style="q" vid="PSA 9:9">Un baluarte y fortaleza en tiempos de angustia.<verse eid="PSA 9:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 9:10"/>En Ti confiarán los que conocen tu Nombre,</para>
  <para style="q" vid="PSA 9:10">Por cuanto Tú, oh <char style="nd">Yavé</char>, no abandonas a los que te buscan.<verse eid="PSA 9:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 9:11"/>¡Canten alabanzas a <char style="nd">Yavé</char>, Quien mora en Sion!</para>
  <para style="q" vid="PSA 9:11">¡Anuncien entre los pueblos sus proezas!<verse eid="PSA 9:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 9:12"/>Porque Aquel que demanda la sangre se acuerda de ellos.</para>
  <para style="q" vid="PSA 9:12">No olvida el clamor de los afligidos.<verse eid="PSA 9:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 9:13"/>Oh <char style="nd">Yavé</char>, ten compasión de mí.</para>
  <para style="q" vid="PSA 9:13">Mira mi aflicción a causa de los que me aborrecen.</para>
  <para style="q" vid="PSA 9:13">Tú, que me levantas de las puertas de la muerte,<verse eid="PSA 9:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 9:14"/>Para que cuente todas tus alabanzas</para>
  <para style="q" vid="PSA 9:14">En las puertas de la hija de Sion,</para>
  <para style="q" vid="PSA 9:14">Y me regocije en tu salvación.<verse eid="PSA 9:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 9:15"/>Las naciones se hundieron en la fosa que cavaron,</para>
  <para style="q" vid="PSA 9:15">Sus pies fueron atrapados en la red que ellos mismos escondieron.<verse eid="PSA 9:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 9:16"/>
    <char style="nd">Yavé</char> se dio a conocer.</para>
  <para style="q" vid="PSA 9:16">Impartió justicia.</para>
  <para style="q" vid="PSA 9:16">El perverso fue atrapado en la obra de sus propias manos.</para>
  <para style="q" vid="PSA 9:16">Meditación. <char style="tl">Selah</char><verse eid="PSA 9:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 9:17"/>Los perversos serán trasladados al <char style="tl">Seol</char>,</para>
  <para style="q" vid="PSA 9:17">Todas las gentes que se olvidan de <char style="nd">ʼElohim</char>.<verse eid="PSA 9:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 9:18"/>Porque el pobre no será olvidado para siempre,</para>
  <para style="q" vid="PSA 9:18">Ni perecerá la esperanza de los afligidos para siempre.<verse eid="PSA 9:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 9:19"/>¡Levántate, oh <char style="nd">Yavé</char>, y no prevalezca el mortal!</para>
  <para style="q" vid="PSA 9:19">¡Sean las naciones juzgadas delante de Ti!<verse eid="PSA 9:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 9:20"/>¡Infúndeles tu terror, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 9:20">Y conozcan las naciones que no son sino hombres!<verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 10:1"/>¿Por qué estás lejos, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 10:1">Y te escondes en tiempos de angustia?<verse eid="PSA 10:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 10:2"/>Por la arrogancia del impío el pobre es consumido.</para>
  <para style="q" vid="PSA 10:2">¡Caigan en las trampas que ellos mismos inventaron!<verse eid="PSA 10:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 10:3"/>Porque el impío se jacta de lo que su alma ansía,</para>
  <para style="q" vid="PSA 10:3">Y el avaro maldice y desprecia a <char style="nd">Yavé</char>.<verse eid="PSA 10:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 10:4"/>Con altivez de su semblante, el perverso no averigua.</para>
  <para style="q" vid="PSA 10:4">
    <char style="nd">ʼElohim</char> no está en sus pensamientos.<verse eid="PSA 10:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 10:5"/>En todo tiempo sus caminos son torcidos.</para>
  <para style="q" vid="PSA 10:5">Tiene tus juicios lejos de su vista.</para>
  <para style="q" vid="PSA 10:5">Desprecia a todos sus adversarios.<verse eid="PSA 10:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 10:6"/>Dice en su corazón: No seré conmovido.</para>
  <para style="q" vid="PSA 10:6">A través de todas las generaciones, no estaré en adversidad.<verse eid="PSA 10:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 10:7"/>Su boca está llena de maldición, engaños, opresión.</para>
  <para style="q" vid="PSA 10:7">Debajo de su lengua hay vejación y maldad.<verse eid="PSA 10:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 10:8"/>Se sienta al acecho, cerca de las aldeas.</para>
  <para style="q" vid="PSA 10:8">En escondrijos asesina al inocente.</para>
  <para style="b" vid="PSA 10:8"/>
  <para style="q" vid="PSA 10:8">Sus ojos acechan para caerle al desvalido.<verse eid="PSA 10:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 10:9"/>Acecha en lo encubierto, como un león desde su guarida</para>
  <para style="q" vid="PSA 10:9">Espera para arrebatar al pobre.</para>
  <para style="q" vid="PSA 10:9">Arrebata al pobre, lo atrae a su red.<verse eid="PSA 10:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 10:10"/>Se encoge, se agazapa,</para>
  <para style="q" vid="PSA 10:10">Y el indefenso cae en sus fuertes garras.<verse eid="PSA 10:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 10:11"/>Dice en su corazón: <char style="nd">ʼEL</char><note caller="+" style="f"><char style="fr" closed="false">10.11 </char><char style="ft" closed="false"><char style="nd">ʼEL </char>es un nombre de <char style="nd">ʼElohim</char>.</char></note> olvidó,</para>
  <para style="q" vid="PSA 10:11">Escondió su rostro, no verá jamás.<verse eid="PSA 10:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 10:12"/>¡Levántate, oh <char style="nd">Yavé</char>!</para>
  <para style="q" vid="PSA 10:12">¡Oh <char style="nd">ʼEL,</char> levanta tu mano,</para>
  <para style="q" vid="PSA 10:12">Y no te olvides del humilde!<verse eid="PSA 10:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 10:13"/>¿Por qué el perverso menosprecia a <char style="nd">ʼElohim</char>?</para>
  <para style="q" vid="PSA 10:13">Porque en su corazón piensa que no le pedirás cuenta.<verse eid="PSA 10:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 10:14"/>Sin embargo Tú lo ves,</para>
  <para style="q" vid="PSA 10:14">Porque observas el agravio y la vejación,</para>
  <para style="q" vid="PSA 10:14">Para retribuirlos con tu mano.</para>
  <para style="q" vid="PSA 10:14">¡A Ti se encomienda el desvalido!</para>
  <para style="q" vid="PSA 10:14">¡Tú eres el defensor del huérfano!<verse eid="PSA 10:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 10:15"/>Quebranta el brazo del malvado y del perverso.</para>
  <para style="q" vid="PSA 10:15">Persigue su impiedad hasta que no haya ninguna.<verse eid="PSA 10:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 10:16"/>
    <char style="nd">Yavé</char> es Rey para siempre jamás.</para>
  <para style="q" vid="PSA 10:16">Las naciones que ocupaban su tierra perecerán.<verse eid="PSA 10:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 10:17"/>Oh <char style="nd">Yavé</char>, Tú has oído el anhelo de los humildes.</para>
  <para style="q" vid="PSA 10:17">Fortaleces sus corazones, tienes atento tu oído<verse eid="PSA 10:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 10:18"/>A fin de vindicar a los huérfanos y a los oprimidos,</para>
  <para style="q" vid="PSA 10:18">Para que el hombre de la tierra no los aterrorice más.<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="s1">Al director del coro. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 11:1"/>En <char style="nd">Yavé</char> me refugio.</para>
  <para style="b" vid="PSA 11:1"/>
  <para style="q" vid="PSA 11:1">¿Cómo puedes decir a mi alma:</para>
  <para style="q" vid="PSA 11:1">Huye como ave a tu montaña?<verse eid="PSA 11:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 11:2"/>Pues ahí están los perversos que tensan el arco.</para>
  <para style="q" vid="PSA 11:2">Preparan su flecha en la cuerda</para>
  <para style="q" vid="PSA 11:2">Para dispararla en la oscuridad a los de corazón recto.<verse eid="PSA 11:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 11:3"/>Si son destruidos los fundamentos,</para>
  <para style="q" vid="PSA 11:3">¿Qué puede hacer el justo?<verse eid="PSA 11:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 11:4"/>
    <char style="nd">Yavé</char> está en su santo Templo.</para>
  <para style="q" vid="PSA 11:4">
    <char style="nd">Yavé</char> tiene en los cielos su trono.</para>
  <para style="q" vid="PSA 11:4">Sus ojos observan,</para>
  <para style="q" vid="PSA 11:4">Sus párpados examinan a los hijos de los hombres.<verse eid="PSA 11:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 11:5"/>
    <char style="nd">Yavé</char> prueba al justo,</para>
  <para style="q" vid="PSA 11:5">Pero su alma aborrece al perverso</para>
  <para style="q" vid="PSA 11:5">Y al que ama violencia.<verse eid="PSA 11:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 11:6"/>Hará llover carbones encendidos sobre los perversos,</para>
  <para style="q" vid="PSA 11:6">Fuego, azufre y viento abrasador.</para>
  <para style="q" vid="PSA 11:6">Tal será la porción de la copa de ellos.<verse eid="PSA 11:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 11:7"/>Porque <char style="nd">Yavé</char> es justo.</para>
  <para style="q" vid="PSA 11:7">Él ama la justicia.</para>
  <para style="q" vid="PSA 11:7">Los rectos contemplarán su rostro.<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="s1">Al director del coro. Con arpa en octava baja. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 12:1"/>¡Salva, oh <char style="nd">Yavé</char>, porque se acaban los piadosos!</para>
  <para style="q" vid="PSA 12:1">Porque desaparecen los fieles entre los hijos de <char style="add">los</char> hombres.<verse eid="PSA 12:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 12:2"/>Hablan vanidades, cada uno a su prójimo.</para>
  <para style="q" vid="PSA 12:2">Hablan con labios lisonjeros y doblez de corazón.<verse eid="PSA 12:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 12:3"/>¡Corte <char style="nd">Yavé</char> todos los labios lisonjeros,</para>
  <para style="q" vid="PSA 12:3">La boca que habla altanerías!<verse eid="PSA 12:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 12:4"/>Los que dicen: Prevaleceremos con nuestra lengua.</para>
  <para style="q" vid="PSA 12:4">Nuestros labios son nuestros.</para>
  <para style="q" vid="PSA 12:4">¿Quién es <char style="nd">ʼAdón</char> sobre nosotros?<verse eid="PSA 12:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 12:5"/>
    <char style="wj">Por la opresión a los pobres, </char></para>
  <para style="q" vid="PSA 12:5">
    <char style="wj">Por el gemido del menesteroso, </char></para>
  <para style="q" vid="PSA 12:5">
    <char style="wj">Ahora me levantaré, dice <char style="nd">Yavé</char>.</char></para>
  <para style="q" vid="PSA 12:5">
    <char style="wj">Pondré en seguridad al que por ella suspira.</char><verse eid="PSA 12:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 12:6"/>Las Palabras de <char style="nd">Yavé</char> son Palabras puras,</para>
  <para style="q" vid="PSA 12:6">Como plata refinada en un crisol en la tierra</para>
  <para style="q" vid="PSA 12:6">Purificada siete veces.<verse eid="PSA 12:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 12:7"/>Tú los guardarás, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 12:7">Los guardarás de esta generación para siempre.<verse eid="PSA 12:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 12:8"/>Por todos lados los impíos deambulan</para>
  <para style="q" vid="PSA 12:8">Cuando la vileza es exaltada entre los hijos de <char style="add">los</char> hombres.<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="s1">Al director del coro. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 13:1"/>¿Hasta cuándo, oh <char style="nd">Yavé</char>?</para>
  <para style="q" vid="PSA 13:1">¿Me olvidarás para siempre?</para>
  <para style="q" vid="PSA 13:1">¿Hasta cuándo esconderás tu rostro de mí?<verse eid="PSA 13:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 13:2"/>¿Hasta cuándo pensaré profundamente</para>
  <para style="q" vid="PSA 13:2">Con tristeza en mi corazón cada día?</para>
  <para style="q" vid="PSA 13:2">¿Hasta cuándo mi enemigo será enaltecido sobre mí?<verse eid="PSA 13:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 13:3"/>¡Considera, oh <char style="nd">Yavé, ʼElohim</char> mío, y respóndeme!</para>
  <para style="q" vid="PSA 13:3">Ilumina mis ojos, no sea que duerma el sueño de la muerte,<verse eid="PSA 13:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 13:4"/>No sea que mi enemigo diga: ¡Lo vencí!</para>
  <para style="q" vid="PSA 13:4">Mis adversarios gozan cuando soy sacudido.<verse eid="PSA 13:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 13:5"/>Confío en tu misericordia,</para>
  <para style="q" vid="PSA 13:5">Y mi corazón se gozará en tu salvación.<verse eid="PSA 13:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 13:6"/>Cantaré a <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 13:6">Porque me llenó de bienes.<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="s1">Al director del coro. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 14:1"/>El necio dice en su corazón: ¡No existe <char style="nd">ʼElohim</char>!</para>
  <para style="q" vid="PSA 14:1">Están corrompidos, hicieron obras repugnantes.</para>
  <para style="q" vid="PSA 14:1">No hay quien haga el bien.<verse eid="PSA 14:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 14:2"/>
    <char style="nd">Yavé</char> miró desde los cielos sobre los hijos de <char style="add">los</char> hombres</para>
  <para style="q" vid="PSA 14:2">Para ver si había algún entendido que buscara a <char style="nd">ʼElohim</char>.<verse eid="PSA 14:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 14:3"/>Todos se desviaron. Juntamente se corrompieron.</para>
  <para style="q" vid="PSA 14:3">No hay quien haga lo bueno, ni siquiera uno.<verse eid="PSA 14:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 14:4"/>¿No tienen discernimiento todos los que hacen iniquidad,</para>
  <para style="q" vid="PSA 14:4">Que devoran a mi pueblo como si comieran pan</para>
  <para style="q" vid="PSA 14:4">Y no invocan a <char style="nd">Yavé</char>?<verse eid="PSA 14:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 14:5"/>Allí temblarán de espanto,</para>
  <para style="q" vid="PSA 14:5">Porque <char style="nd">ʼElohim</char> está con la generación de los justos.<verse eid="PSA 14:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 14:6"/>Se burlan del consejo del pobre,</para>
  <para style="q" vid="PSA 14:6">Pero <char style="nd">Yavé</char> es su refugio.<verse eid="PSA 14:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 14:7"/>¡Oh, que de Sion venga la salvación de Israel!</para>
  <para style="q" vid="PSA 14:7">Cuando <char style="nd">Yavé</char> restaure a su pueblo cautivo,</para>
  <para style="q" vid="PSA 14:7">Se regocijará Jacob y se alegrará Israel.<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="s1">Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 15:1"/>Oh <char style="nd">Yavé</char>, ¿quién morará en tu Tabernáculo?</para>
  <para style="q" vid="PSA 15:1">¿Quién morará en tu Montaña Santa?<verse eid="PSA 15:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 15:2"/>El que vive en integridad y hace justicia,</para>
  <para style="q" vid="PSA 15:2">Y habla la verdad en su corazón.<verse eid="PSA 15:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 15:3"/>El que no calumnia con su boca,</para>
  <para style="q" vid="PSA 15:3">Ni hace mal a su amigo,</para>
  <para style="q" vid="PSA 15:3">Ni levanta un reproche contra su prójimo,<verse eid="PSA 15:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 15:4"/>En cuyos ojos el vil es menospreciado,</para>
  <para style="q" vid="PSA 15:4">Pero honra a los que temen a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 15:4">El que jura en daño suyo y no cambia,<verse eid="PSA 15:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 15:5"/>Quien no presta su dinero con interés,</para>
  <para style="q" vid="PSA 15:5">Ni acepta soborno contra el inocente.</para>
  <para style="b" vid="PSA 15:5"/>
  <para style="q" vid="PSA 15:5">El que hace estas cosas jamás será movido.<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="s1">Canto a media voz, de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 16:1"/>Guárdame, oh <char style="nd">ʼElohim</char>, porque en Ti me refugio.<verse eid="PSA 16:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 16:2"/>Dije a <char style="nd">Yavé</char>: Tú eres mi <char style="nd">ʼAdonay</char>.</para>
  <para style="q" vid="PSA 16:2">No tengo bien fuera de Ti.<verse eid="PSA 16:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 16:3"/>Para los santos y los íntegros que están en la tierra</para>
  <para style="q" vid="PSA 16:3">Es toda mi complacencia.<verse eid="PSA 16:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 16:4"/>Multiplicarán sus dolores los que sirven a otro <char style="tl">ʼelohim</char>.</para>
  <para style="q" vid="PSA 16:4">No derramaré sus libaciones de sangre,</para>
  <para style="q" vid="PSA 16:4">Ni estarán sus nombres en mis labios.<verse eid="PSA 16:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 16:5"/>
    <char style="nd">Yavé</char> es la porción de mi herencia y de mi copa.</para>
  <para style="q" vid="PSA 16:5">Tú sustentas firmemente mi parcela.<verse eid="PSA 16:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 16:6"/>Las cuerdas me cayeron en lugares deleitosos</para>
  <para style="q" vid="PSA 16:6">Y es hermosa la heredad que me corresponde.<verse eid="PSA 16:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 16:7"/>Bendeciré a <char style="nd">Yavé</char> que me aconseja,</para>
  <para style="q" vid="PSA 16:7">Aun en las noches me corrige las partes más íntimas de mi personalidad.<note caller="+" style="f"><char style="fr" closed="false">16.7 </char><char style="ft" closed="false">Lit. riñones.</char></note><verse eid="PSA 16:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 16:8"/>A <char style="nd">Yavé</char> coloqué continuamente delante de mí.</para>
  <para style="q" vid="PSA 16:8">Porque está a mi derecha, no seré movido.<verse eid="PSA 16:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 16:9"/>Por lo cual se alegra mi corazón,</para>
  <para style="q" vid="PSA 16:9">Y se regocija mi gloria.</para>
  <para style="q" vid="PSA 16:9">Mi cuerpo reposará también confiadamente,<verse eid="PSA 16:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 16:10"/>Porque no abandonarás mi alma en el <char style="tl">Seol</char>,</para>
  <para style="q" vid="PSA 16:10">Ni permitirás que tu Santo experimente corrupción.<verse eid="PSA 16:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 16:11"/>Me mostrarás la senda de la vida.</para>
  <para style="q" vid="PSA 16:11">En tu Presencia hay plenitud de gozo,</para>
  <para style="q" vid="PSA 16:11">Delicias a tu mano derecha para siempre.<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="s1">Oración de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 17:1"/>Oye, oh <char style="nd">Yavé</char>, una causa justa, atiende mi clamor.</para>
  <para style="q" vid="PSA 17:1">Escucha mi oración hecha con labios sin engaño.<verse eid="PSA 17:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 17:2"/>De tu Presencia proceda mi defensa.</para>
  <para style="q" vid="PSA 17:2">Vean tus ojos la rectitud.<verse eid="PSA 17:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 17:3"/>Tú probaste mi corazón.</para>
  <para style="q" vid="PSA 17:3">Me visitaste de noche,</para>
  <para style="q" vid="PSA 17:3">Me pasaste por el crisol y nada <char style="add">inicuo</char> hallaste.</para>
  <para style="q" vid="PSA 17:3">Resolví que mi boca no cometa transgresión.<verse eid="PSA 17:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 17:4"/>En cuanto a las obras humanas,</para>
  <para style="q" vid="PSA 17:4">Con la Palabra de tus labios</para>
  <para style="q" vid="PSA 17:4">Me guardé de las sendas del violento.<verse eid="PSA 17:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 17:5"/>Mis pasos se mantuvieron en tus caminos.</para>
  <para style="q" vid="PSA 17:5">Mis pies no resbalarán.<verse eid="PSA 17:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 17:6"/>Oh <char style="nd">ʼElohim</char>, yo te invocaré,</para>
  <para style="q" vid="PSA 17:6">Y Tú me responderás.</para>
  <para style="q" vid="PSA 17:6">Inclina tu oído hacia mí y escucha mis palabras.<verse eid="PSA 17:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 17:7"/>¡Haz tus misericordias maravillosas!</para>
  <para style="q" vid="PSA 17:7">Tú eres Quien salvas a quienes se refugian a tu mano derecha,</para>
  <para style="q" vid="PSA 17:7">De los que se levantan contra ellos.<verse eid="PSA 17:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 17:8"/>Guárdame como a la pupila de tus ojos,</para>
  <para style="q" vid="PSA 17:8">Escóndeme bajo la sombra de tus alas<verse eid="PSA 17:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 17:9"/>De la presencia de los perversos que me oprimen,</para>
  <para style="q" vid="PSA 17:9">De los enemigos mortales que me rodean.<verse eid="PSA 17:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 17:10"/>Protegidos están en su prosperidad.</para>
  <para style="q" vid="PSA 17:10">Con su boca hablan arrogancias.<verse eid="PSA 17:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 17:11"/>Ahora cercaron nuestros pasos.</para>
  <para style="q" vid="PSA 17:11">Fijan su mirada en echarnos a tierra,<verse eid="PSA 17:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 17:12"/>Como león ansioso de desgarrar su presa,</para>
  <para style="q" vid="PSA 17:12">Como cachorro de león agazapado en su cueva.<verse eid="PSA 17:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 17:13"/>¡Levántate, oh <char style="nd">Yavé</char>!</para>
  <para style="q" vid="PSA 17:13">¡Hazle frente!</para>
  <para style="q" vid="PSA 17:13">Haz que sea derribado.</para>
  <para style="q" vid="PSA 17:13">Con tu espada libra mi alma del inicuo,<verse eid="PSA 17:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 17:14"/>Y con tu mano, oh <char style="nd">Yavé</char>, de los hombres del mundo,</para>
  <para style="q" vid="PSA 17:14">Cuya porción está en esta vida,</para>
  <para style="q" vid="PSA 17:14">Cuyo vientre Tú llenas con tus tesoros.</para>
  <para style="b" vid="PSA 17:14"/>
  <para style="q" vid="PSA 17:14">¡Sean saciados, pues, sus hijos,</para>
  <para style="q" vid="PSA 17:14">Y dejen las migajas a sus nietos!<verse eid="PSA 17:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 17:15"/>Yo veré tu rostro en justicia,</para>
  <para style="q" vid="PSA 17:15">Estaré satisfecho cuando despierte a tu semejanza.<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="s1">Al director del coro. Salmo de David, esclavo de <char style="nd">Yavé</char>, el cual habló a <char style="nd">Yavé</char> las palabras de este canto el día cuando <char style="nd">Yavé</char> lo libró de la mano de todos sus enemigos, y de la mano de Saúl.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 18:1"/>Dijo: ¡Te amo, oh <char style="nd">Yavé</char>, Fortaleza mía!<verse eid="PSA 18:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 18:2"/>¡<char style="nd">Yavé</char>, Roca mía y Castillo mío, y mi Libertador!</para>
  <para style="q" vid="PSA 18:2">
    <char style="nd">ʼElohim</char> mío y Fortaleza mía, en Quien me refugio,</para>
  <para style="q" vid="PSA 18:2">Mi Escudo y mi Cuerno de salvación, mi alta Torre.<verse eid="PSA 18:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 18:3"/>Invoco a <char style="nd">Yavé</char>, Quien es digno de alabanza,</para>
  <para style="q" vid="PSA 18:3">Y soy salvo de mis enemigos.<verse eid="PSA 18:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 18:4"/>Me rodearon los lazos de la muerte,</para>
  <para style="q" vid="PSA 18:4">Sentí el espanto de los torrentes de Belial.<verse eid="PSA 18:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 18:5"/>Me rodearon las ligaduras del <char style="tl">Seol</char>,</para>
  <para style="q" vid="PSA 18:5">Las trampas de la muerte vinieron sobre mí.<verse eid="PSA 18:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 18:6"/>En mi angustia invoqué a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 18:6">Clamé a mi <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 18:6">Y Él oyó mi voz desde su Templo.</para>
  <para style="q" vid="PSA 18:6">Mi clamor delante de Él llegó a sus oídos.<verse eid="PSA 18:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 18:7"/>La tierra se conmovió y tembló.</para>
  <para style="q" vid="PSA 18:7">También temblaron los fundamentos de las montañas.</para>
  <para style="q" vid="PSA 18:7">Fueron sacudidos porque Él estaba airado.<verse eid="PSA 18:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 18:8"/>De su nariz se levantó una humareda,</para>
  <para style="q" vid="PSA 18:8">Un fuego de su boca devoró,</para>
  <para style="q" vid="PSA 18:8">Carbones fueron encendidos por Él.<verse eid="PSA 18:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 18:9"/>Inclinó los cielos,</para>
  <para style="q" vid="PSA 18:9">Y descendió con densas tinieblas bajo sus pies.<verse eid="PSA 18:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 18:10"/>Cabalgó sobre un querubín y voló.</para>
  <para style="q" vid="PSA 18:10">Se precipitó sobre las alas del viento.<verse eid="PSA 18:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 18:11"/>Puso oscuridad como escondedero</para>
  <para style="q" vid="PSA 18:11">Con su Tabernáculo alrededor de Él,</para>
  <para style="q" vid="PSA 18:11">Oscuridad de agua,</para>
  <para style="q" vid="PSA 18:11">Densas nubes bajo el cielo.<verse eid="PSA 18:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 18:12"/>El fulgor de su Presencia</para>
  <para style="q" vid="PSA 18:12">Atravesó las densas nubes.</para>
  <para style="q" vid="PSA 18:12">Descargó granizo y carbones encendidos.<verse eid="PSA 18:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 18:13"/>
    <char style="nd">Yavé</char> tronó desde el cielo.</para>
  <para style="q" vid="PSA 18:13">
    <char style="nd">ʼElyón</char> dio su voz:</para>
  <para style="q" vid="PSA 18:13">¡Granizo y carbones encendidos!<verse eid="PSA 18:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 18:14"/>Disparó sus flechas y los dispersó.</para>
  <para style="q" vid="PSA 18:14">Relámpagos en abundancia, y los confundió.<verse eid="PSA 18:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 18:15"/>Entonces aparecieron los lechos del agua</para>
  <para style="q" vid="PSA 18:15">Y se descubrieron los cimientos del mundo</para>
  <para style="q" vid="PSA 18:15">Ante tu bramido, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 18:15">Por el soplo del aliento de tu nariz.<verse eid="PSA 18:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 18:16"/>Envió desde lo alto y me tomó,</para>
  <para style="q" vid="PSA 18:16">Me sacó de muchas aguas.<verse eid="PSA 18:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 18:17"/>Me libró de mi poderoso enemigo</para>
  <para style="q" vid="PSA 18:17">Y de los que me aborrecían,</para>
  <para style="q" vid="PSA 18:17">Porque eran más fuertes que yo.<verse eid="PSA 18:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 18:18"/>Me enfrentaron en el día de mi calamidad,</para>
  <para style="q" vid="PSA 18:18">Pero <char style="nd">Yavé</char> fue mi apoyo.<verse eid="PSA 18:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 18:19"/>Me sacó a un lugar espacioso.</para>
  <para style="q" vid="PSA 18:19">Me rescató, porque se complació en mí.<verse eid="PSA 18:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 18:20"/>
    <char style="nd">Yavé</char> me premió conforme a mi justicia.</para>
  <para style="q" vid="PSA 18:20">Me retribuyó según la pureza de mis manos.<verse eid="PSA 18:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 18:21"/>Porque guardé los caminos de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 18:21">Y no me aparté impíamente de mi <char style="nd">ʼElohim</char>.<verse eid="PSA 18:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 18:22"/>Pues todos sus Preceptos estuvieron delante de mí,</para>
  <para style="q" vid="PSA 18:22">Y no aparté de mí sus Estatutos.<verse eid="PSA 18:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 18:23"/>También fui irreprensible ante Él</para>
  <para style="q" vid="PSA 18:23">Y me guardé de cometer iniquidad.<verse eid="PSA 18:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 18:24"/>Por eso <char style="nd">Yavé</char> recompensó mi rectitud,</para>
  <para style="q" vid="PSA 18:24">La pureza de mis manos ante sus ojos.<verse eid="PSA 18:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PSA 18:25"/>Con el bondadoso se mostrará bondadoso,</para>
  <para style="q" vid="PSA 18:25">Y recto con el hombre recto.<verse eid="PSA 18:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 18:26"/>Puro se mostrará con el puro,</para>
  <para style="q" vid="PSA 18:26">Y con el perverso se mostrará severo.<verse eid="PSA 18:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 18:27"/>En verdad, Tú salvas al pueblo afligido,</para>
  <para style="q" vid="PSA 18:27">Y humillas los ojos altivos.<verse eid="PSA 18:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PSA 18:28"/>Oh <char style="nd">Yavé</char>, Tú enciendes mi lámpara.</para>
  <para style="q" vid="PSA 18:28">¡Mi <char style="nd">ʼElohim</char> ilumina mi oscuridad!<verse eid="PSA 18:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 18:29"/>Porque contigo desbarataré ejércitos,</para>
  <para style="q" vid="PSA 18:29">Con mi <char style="nd">ʼElohim</char> saltaré sobre un muro.<verse eid="PSA 18:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PSA 18:30"/>El camino de <char style="nd">ʼElohim</char> es perfecto.</para>
  <para style="q" vid="PSA 18:30">La Palabra de <char style="nd">Yavé</char>, acrisolada.</para>
  <para style="q" vid="PSA 18:30">Él es escudo a todos los que se refugian en Él.<verse eid="PSA 18:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 18:31"/>Porque, ¿quién es <char style="nd">ʼEloah</char> aparte de <char style="nd">Yavé</char>?</para>
  <para style="q" vid="PSA 18:31">¿Y quién es la Roca fuera de nuestro <char style="nd">ʼElohim</char>?<verse eid="PSA 18:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PSA 18:32"/>Porque <char style="nd">ʼEL</char> es Quien me ata con vigor,</para>
  <para style="q" vid="PSA 18:32">Y que perfecciona mi camino,<verse eid="PSA 18:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 18:33"/>Que fortalece mis pies para que sean como de venado</para>
  <para style="q" vid="PSA 18:33">Y me sostiene firme en mis alturas,<verse eid="PSA 18:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 18:34"/>Que adiestra mis manos para la batalla,</para>
  <para style="q" vid="PSA 18:34">De modo que mis brazos puedan tensar el arco de bronce.<verse eid="PSA 18:34"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="35" style="v" sid="PSA 18:35"/>Me diste también el escudo de tu salvación,</para>
  <para style="q" vid="PSA 18:35">Tu mano derecha me sostuvo</para>
  <para style="q" vid="PSA 18:35">Y tu benignidad me engrandeció.<verse eid="PSA 18:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 18:36"/>Ensanchaste mis pasos debajo de mí,</para>
  <para style="q" vid="PSA 18:36">Y mis pies no resbalaron.<verse eid="PSA 18:36"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="37" style="v" sid="PSA 18:37"/>Perseguí a mis enemigos, los alcancé,</para>
  <para style="q" vid="PSA 18:37">Y no regresé hasta que fueron aniquilados.<verse eid="PSA 18:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 18:38"/>Les di golpes repetidos,</para>
  <para style="q" vid="PSA 18:38">Y no pudieron levantarse,</para>
  <para style="q" vid="PSA 18:38">Cayeron debajo de mis pies.<verse eid="PSA 18:38"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="39" style="v" sid="PSA 18:39"/>Me armaste de valor para la guerra,</para>
  <para style="q" vid="PSA 18:39">Doblegaste a los que me resistían.<verse eid="PSA 18:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 18:40"/>Pusiste en fuga a mis enemigos,</para>
  <para style="q" vid="PSA 18:40">Para que yo venciera a quienes me aborrecían.<verse eid="PSA 18:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 18:41"/>Clamaron, pero no hubo quien los librara,</para>
  <para style="q" vid="PSA 18:41">Aun a <char style="nd">Yavé</char>, pero no les respondió.<verse eid="PSA 18:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 18:42"/>Los desmenucé como polvo ante el viento,</para>
  <para style="q" vid="PSA 18:42">Los eché fuera como el barro de las calles.<verse eid="PSA 18:42"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="43" style="v" sid="PSA 18:43"/>Me libraste de las contiendas del pueblo.</para>
  <para style="q" vid="PSA 18:43">Me designaste jefe de las naciones.</para>
  <para style="q" vid="PSA 18:43">Un pueblo que no conocía me sirve.<verse eid="PSA 18:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 18:44"/>Tan pronto me oyen, me obedecen,</para>
  <para style="q" vid="PSA 18:44">Los extranjeros se sometieron a mí.<verse eid="PSA 18:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 18:45"/>Los hijos de extranjeros desfallecen</para>
  <para style="q" vid="PSA 18:45">Y salen temblando de sus fortalezas.<verse eid="PSA 18:45"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="46" style="v" sid="PSA 18:46"/>¡Viva <char style="nd">Yavé</char>! ¡Bendita sea mi Roca!</para>
  <para style="q" vid="PSA 18:46">Sea enaltecido el <char style="nd">ʼElohim</char> de mi salvación,<verse eid="PSA 18:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 18:47"/>
    <char style="nd">ʼEL,</char> Quien ejecuta mi venganza</para>
  <para style="q" vid="PSA 18:47">Y me somete pueblos.<verse eid="PSA 18:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 18:48"/>Él me libra de mis enemigos.</para>
  <para style="q" vid="PSA 18:48">Me enaltece sobre los que se alzan contra mí</para>
  <para style="q" vid="PSA 18:48">Y me libras del hombre violento.<verse eid="PSA 18:48"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="49" style="v" sid="PSA 18:49"/>Por tanto, yo te daré gracias,</para>
  <para style="q" vid="PSA 18:49">Oh <char style="nd">Yavé</char>, entre las naciones,</para>
  <para style="q" vid="PSA 18:49">Y cantaré alabanzas a tu Nombre.<verse eid="PSA 18:49"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="50" style="v" sid="PSA 18:50"/>Él da gran liberación a su rey</para>
  <para style="q" vid="PSA 18:50">Y muestra misericordia a su ungido:</para>
  <para style="q" vid="PSA 18:50">A David y a su descendencia para siempre.<verse eid="PSA 18:50"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="s1">Al director del coro. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 19:1"/>Los cielos cuentan la gloria de <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 19:1">Y el firmamento declara la obra de sus manos.<verse eid="PSA 19:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 19:2"/>Día tras día pronuncian su mensaje,</para>
  <para style="q" vid="PSA 19:2">Y noche tras noche proclaman sabiduría.<verse eid="PSA 19:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 19:3"/>No hay lengua ni palabras</para>
  <para style="q" vid="PSA 19:3">En las cuales no sea oída la voz de ellos.<verse eid="PSA 19:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 19:4"/>Su expresión llega a toda la tierra,</para>
  <para style="q" vid="PSA 19:4">Y sus Palabras hasta los confines del mundo.</para>
  <para style="b" vid="PSA 19:4"/>
  <para style="q" vid="PSA 19:4">En ellos puso tabernáculo para el sol,<verse eid="PSA 19:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 19:5"/>Y éste, como esposo que sale de su aposento,</para>
  <para style="q" vid="PSA 19:5">Se alegra como atleta para recorrer su camino.<verse eid="PSA 19:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 19:6"/>De un extremo de los cielos es su salida,</para>
  <para style="q" vid="PSA 19:6">Y su órbita hasta el término de ellos.</para>
  <para style="q" vid="PSA 19:6">Nada queda escondido de su calor.<verse eid="PSA 19:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 19:7"/>La Ley de <char style="nd">Yavé</char> es perfecta.</para>
  <para style="q" vid="PSA 19:7">Restaura el alma.</para>
  <para style="q" vid="PSA 19:7">El testimonio de <char style="nd">Yavé</char> es fiel.</para>
  <para style="q" vid="PSA 19:7">Hace sabio al sencillo.<verse eid="PSA 19:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 19:8"/>Los Preceptos de <char style="nd">Yavé</char> son rectos.</para>
  <para style="q" vid="PSA 19:8">Alegran el corazón.</para>
  <para style="q" vid="PSA 19:8">El Mandamiento de <char style="nd">Yavé</char> es puro,</para>
  <para style="q" vid="PSA 19:8">Alumbra los ojos.<verse eid="PSA 19:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 19:9"/>El temor a <char style="nd">Yavé</char> es limpio,</para>
  <para style="q" vid="PSA 19:9">Permanece para siempre.</para>
  <para style="q" vid="PSA 19:9">Los Juicios de <char style="nd">Yavé</char> son verdaderos,</para>
  <para style="q" vid="PSA 19:9">Todos justos.<verse eid="PSA 19:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 19:10"/>Deseables son más que el oro,</para>
  <para style="q" vid="PSA 19:10">Más que mucho oro afinado,</para>
  <para style="q" vid="PSA 19:10">Y más dulces que la miel,</para>
  <para style="q" vid="PSA 19:10">Aun la que destila del panal.<verse eid="PSA 19:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 19:11"/>Tu esclavo es además amonestado por ellos.</para>
  <para style="q" vid="PSA 19:11">En guardarlos hay grande galardón.<verse eid="PSA 19:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 19:12"/>¿Quién reconocerá sus propios errores?</para>
  <para style="q" vid="PSA 19:12">Declárame inocente de los que me son ocultos.<verse eid="PSA 19:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 19:13"/>Aparta también a tu esclavo de las soberbias,</para>
  <para style="q" vid="PSA 19:13">Que no me dominen.</para>
  <para style="q" vid="PSA 19:13">Entonces seré íntegro</para>
  <para style="q" vid="PSA 19:13">Y declarado absuelto de gran transgresión.<verse eid="PSA 19:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 19:14"/>Sean aceptos los dichos de mi boca delante de Ti</para>
  <para style="q" vid="PSA 19:14">Y la meditación de mi corazón,</para>
  <para style="q" vid="PSA 19:14">Oh <char style="nd">Yavé</char>, Roca mía y Redentor mío.<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="s1">Al director del coro. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 20:1"/>
    <char style="nd">Yavé</char> te responda en el día de la adversidad.</para>
  <para style="q" vid="PSA 20:1">El Nombre del <char style="nd">ʼElohim</char> de Jacob te defienda,<verse eid="PSA 20:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 20:2"/>Te envíe ayuda desde el Santuario</para>
  <para style="q" vid="PSA 20:2">Y desde Sion te sostenga.<verse eid="PSA 20:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 20:3"/>Se acuerde de todas tus ofrendas</para>
  <para style="q" vid="PSA 20:3">Y acepte tus holocaustos. <char style="tl">Selah</char><verse eid="PSA 20:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 20:4"/>Te dé conforme al deseo de tu corazón</para>
  <para style="q" vid="PSA 20:4">Y cumpla todos tus propósitos.<verse eid="PSA 20:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 20:5"/>Nosotros nos alegraremos en tu salvación</para>
  <para style="q" vid="PSA 20:5">Y levantaremos pendón en el Nombre de nuestro <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 20:5">
    <char style="nd">Yavé</char> te conceda todas tus peticiones.<verse eid="PSA 20:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 20:6"/>Ahora sé que <char style="nd">Yavé</char> salva a su ungido.</para>
  <para style="q" vid="PSA 20:6">Le responderá desde sus santos cielos</para>
  <para style="q" vid="PSA 20:6">Con la potencia salvadora de su mano derecha.<verse eid="PSA 20:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 20:7"/>Éstos confían en carruajes de guerra,</para>
  <para style="q" vid="PSA 20:7">Y aquéllos en caballos,</para>
  <para style="q" vid="PSA 20:7">Pero nosotros nos gloriamos del Nombre de <char style="nd">Yavé</char>, nuestro <char style="nd">ʼElohim. </char><verse eid="PSA 20:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 20:8"/>Ellos flaquean y caen,</para>
  <para style="q" vid="PSA 20:8">Pero nosotros nos levantamos y estamos firmes.<verse eid="PSA 20:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 20:9"/>¡Salva, oh <char style="nd">Yavé</char>!</para>
  <para style="q" vid="PSA 20:9">¡Que el Rey nos responda el día cuando lo invoquemos!<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="s1">Al director del coro. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 21:1"/>Oh <char style="nd">Yavé</char>, el rey se alegrará en tu poder,</para>
  <para style="q" vid="PSA 21:1">Y en tu salvación ¡cuánto se regocijará!<verse eid="PSA 21:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 21:2"/>Le diste el deseo de su corazón</para>
  <para style="q" vid="PSA 21:2">Y no le retuviste la petición de sus labios. <char style="tl">Selah</char><verse eid="PSA 21:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 21:3"/>Con bendiciones de bien saliste a su encuentro.</para>
  <para style="q" vid="PSA 21:3">Corona de oro puro pusiste en su cabeza.<verse eid="PSA 21:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 21:4"/>Vida te pidió,</para>
  <para style="q" vid="PSA 21:4">Y se la concediste,</para>
  <para style="q" vid="PSA 21:4">Largura de días, eternamente y para siempre.<verse eid="PSA 21:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 21:5"/>Grande es su gloria por tu salvación.</para>
  <para style="q" vid="PSA 21:5">Pusiste sobre él honor y majestad.<verse eid="PSA 21:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 21:6"/>Lo bendijiste para siempre.</para>
  <para style="q" vid="PSA 21:6">Lo llenaste de alegría con tu Presencia<verse eid="PSA 21:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 21:7"/>Por cuanto el rey confía en <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 21:7">Por la misericordia de <char style="nd">ʼElyón</char>, no será conmovido.<verse eid="PSA 21:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 21:8"/>Tu mano alcanzará a todos tus enemigos.</para>
  <para style="q" vid="PSA 21:8">Tu mano derecha alcanzará a los que te aborrecen.<verse eid="PSA 21:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 21:9"/>Los pondrás en horno de fuego en el tiempo de tu ira.</para>
  <para style="q" vid="PSA 21:9">
    <char style="nd">Yavé</char> los deshará en su ira,</para>
  <para style="q" vid="PSA 21:9">Y el fuego los consumirá.<verse eid="PSA 21:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 21:10"/>Destruirás su producto de la tierra,</para>
  <para style="q" vid="PSA 21:10">Y su descendencia de entre los hijos de hombres.<verse eid="PSA 21:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 21:11"/>Porque tramaron el mal contra Ti.</para>
  <para style="q" vid="PSA 21:11">Fraguaron un complot,</para>
  <para style="q" vid="PSA 21:11">Pero no prevalecerán.<verse eid="PSA 21:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 21:12"/>Pues Tú les harás volver la espalda</para>
  <para style="q" vid="PSA 21:12">Al apuntar tu arco contra sus rostros.<verse eid="PSA 21:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 21:13"/>¡Engrandécete, oh <char style="nd">Yavé</char>, con tu fortaleza!</para>
  <para style="q" vid="PSA 21:13">Cantaremos y alabaremos tu poderío.<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="s1">Al director del coro. Según el canto: Una sierva es la aurora. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 22:1"/>¡<char style="nd">ʼEL</char> mío, <char style="nd">ʼEL</char> mío!</para>
  <para style="q" vid="PSA 22:1">¿Por qué me desamparaste?</para>
  <para style="q" vid="PSA 22:1">¿Por qué estás lejos de mi salvación y de las palabras de mi clamor?<verse eid="PSA 22:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 22:2"/>
    <char style="nd">ʼElohim</char> mío, clamo de día, y no respondes,</para>
  <para style="q" vid="PSA 22:2">Y de noche, y no hay descanso para mí.<verse eid="PSA 22:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 22:3"/>Pero Tú eres santo,</para>
  <para style="q" vid="PSA 22:3">¡Tú, que moras entre las alabanzas de Israel!<verse eid="PSA 22:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 22:4"/>En Ti confiaron nuestros antepasados.</para>
  <para style="q" vid="PSA 22:4">Confiaron, y Tú los libraste.<verse eid="PSA 22:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 22:5"/>Clamaron a Ti, y fueron librados.</para>
  <para style="q" vid="PSA 22:5">Confiaron en Ti, y no fueron avergonzados.<verse eid="PSA 22:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 22:6"/>Pero yo soy gusano y no hombre,</para>
  <para style="q" vid="PSA 22:6">Oprobio de los hombres y despreciado por el pueblo.<verse eid="PSA 22:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 22:7"/>Todos los que me ven me escarnecen.</para>
  <para style="q" vid="PSA 22:7">Hacen una mueca con los labios.</para>
  <para style="q" vid="PSA 22:7">Menean la cabeza y dicen:<verse eid="PSA 22:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 22:8"/>Se encomendó a <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 22:8">Líbrelo Él.</para>
  <para style="q" vid="PSA 22:8">Que Él lo rescate,</para>
  <para style="q" vid="PSA 22:8">Puesto que se complacía en Él.<verse eid="PSA 22:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 22:9"/>Pero Tú eres el que me sacó del vientre.</para>
  <para style="q" vid="PSA 22:9">Me diste confianza aun cuando estaba a los pechos de mi madre.<verse eid="PSA 22:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 22:10"/>A Ti fui entregado desde la matriz,</para>
  <para style="q" vid="PSA 22:10">Desde el vientre de mi madre Tú eres mi <char style="nd">ʼEL.</char><verse eid="PSA 22:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 22:11"/>No te alejes de Mí, porque la angustia está cerca,</para>
  <para style="q" vid="PSA 22:11">Porque no hay quien ayude.<verse eid="PSA 22:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 22:12"/>Me rodearon muchos toros.</para>
  <para style="q" vid="PSA 22:12">Fuertes toros de Basán me rodearon.<verse eid="PSA 22:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 22:13"/>Abren su boca contra mí</para>
  <para style="q" vid="PSA 22:13">Como león voraz y rugiente.<verse eid="PSA 22:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 22:14"/>Soy derramado como aguas</para>
  <para style="q" vid="PSA 22:14">Y todos mis huesos se descoyuntan.</para>
  <para style="q" vid="PSA 22:14">Mi corazón se volvió como cera.</para>
  <para style="q" vid="PSA 22:14">Se derritió entre mis órganos.<verse eid="PSA 22:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 22:15"/>Mi vigor está seco como tiesto</para>
  <para style="q" vid="PSA 22:15">Y mi lengua se pega a mis mandíbulas.</para>
  <para style="q" vid="PSA 22:15">¡Me pones en el polvo de la muerte!<verse eid="PSA 22:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 22:16"/>Perros me rodearon.</para>
  <para style="q" vid="PSA 22:16">Me cercó cuadrilla de perversos.</para>
  <para style="q" vid="PSA 22:16">Horadaron mis manos y mis pies.<verse eid="PSA 22:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 22:17"/>Puedo contar todos mis huesos.</para>
  <para style="q" vid="PSA 22:17">Ellos me miran y me observan.<verse eid="PSA 22:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 22:18"/>Reparten entre sí mis ropas,</para>
  <para style="q" vid="PSA 22:18">Y sobre mi túnica echan suertes.<verse eid="PSA 22:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 22:19"/>Pero Tú, oh <char style="nd">Yavé</char>, ¡no te alejes!</para>
  <para style="q" vid="PSA 22:19">Fortaleza mía, ¡Apresúrate a socorrerme!<verse eid="PSA 22:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 22:20"/>¡Libra de la espada el alma mía,</para>
  <para style="q" vid="PSA 22:20">Del poder del perro mi vida!<verse eid="PSA 22:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 22:21"/>¡Sálvame de la boca del león</para>
  <para style="q" vid="PSA 22:21">Y de los cuernos de los toros salvajes!</para>
  <para style="q" vid="PSA 22:21">¡Me has respondido!<verse eid="PSA 22:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PSA 22:22"/>Anunciaré tu Nombre a mis hermanos.</para>
  <para style="q" vid="PSA 22:22">En medio de la congregación te alabaré.<verse eid="PSA 22:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 22:23"/>Los que temen a <char style="nd">Yavé</char>, alábenlo.</para>
  <para style="q" vid="PSA 22:23">Glorifíquenlo, toda la descendencia de Jacob,</para>
  <para style="q" vid="PSA 22:23">Y témanle, toda la descendencia de Israel,<verse eid="PSA 22:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 22:24"/>Porque no menospreció ni aborreció el dolor del afligido,</para>
  <para style="q" vid="PSA 22:24">Ni de él ocultó su rostro,</para>
  <para style="q" vid="PSA 22:24">Sino cuando clamó a Él,</para>
  <para style="q" vid="PSA 22:24">Lo escuchó.<verse eid="PSA 22:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PSA 22:25"/>De Ti viene mi alabanza en la gran congregación.</para>
  <para style="q" vid="PSA 22:25">Cumpliré mis votos delante de los que te temen.<verse eid="PSA 22:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 22:26"/>¡Los pobres comerán y serán saciados!</para>
  <para style="q" vid="PSA 22:26">¡Alabarán a <char style="nd">Yavé</char> los que lo buscan!</para>
  <para style="q" vid="PSA 22:26">¡Que su corazón viva para siempre!<verse eid="PSA 22:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 22:27"/>Se acordarán y volverán a <char style="nd">Yavé</char> de todos los confines de la tierra,</para>
  <para style="q" vid="PSA 22:27">Y todas las familias de las naciones se postrarán delante de Ti.<verse eid="PSA 22:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 22:28"/>Porque de <char style="nd">Yavé</char> es el reino,</para>
  <para style="q" vid="PSA 22:28">Y Él gobierna las naciones.<verse eid="PSA 22:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PSA 22:29"/>Comerán y se postrarán</para>
  <para style="q" vid="PSA 22:29">Todos los poderosos de la tierra,</para>
  <para style="q" vid="PSA 22:29">Los que bajan al polvo se postrarán ante Él,</para>
  <para style="q" vid="PSA 22:29">Los que no pueden conservar viva su alma.<verse eid="PSA 22:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PSA 22:30"/>Una futura generación le servirá.</para>
  <para style="q" vid="PSA 22:30">Esto se dirá de <char style="nd">ʼAdonay </char>hasta la próxima generación.<verse eid="PSA 22:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 22:31"/>Acudirán y declararán su justicia,</para>
  <para style="q" vid="PSA 22:31">Anunciarán a pueblo que nacerá que Él hizo esto.<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="s1">Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 23:1"/>
    <char style="nd">Yavé</char> es mi Pastor.</para>
  <para style="q" vid="PSA 23:1">Nada me faltará.<verse eid="PSA 23:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 23:2"/>En lugares de tiernos prados me hace descansar.</para>
  <para style="q" vid="PSA 23:2">Junto a aguas de reposo me conduce.<verse eid="PSA 23:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 23:3"/>Restaura mi alma.</para>
  <para style="q" vid="PSA 23:3">Me guía por sendas de justicia por amor a su Nombre.<verse eid="PSA 23:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 23:4"/>Aunque ande por el valle de la sombra de muerte,</para>
  <para style="q" vid="PSA 23:4">No temeré algún mal,</para>
  <para style="q" vid="PSA 23:4">Porque Tú estás conmigo.</para>
  <para style="q" vid="PSA 23:4">Tu vara y tu cayado me confortan.<verse eid="PSA 23:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 23:5"/>Aderezas mesa delante de mí en presencia de mis adversarios.</para>
  <para style="q" vid="PSA 23:5">Unges mi cabeza con aceite.</para>
  <para style="q" vid="PSA 23:5">Mi copa rebosa.<verse eid="PSA 23:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 23:6"/>Ciertamente el bien y la misericordia me escoltarán todos los días de mi vida,</para>
  <para style="q" vid="PSA 23:6">Y en la Casa de <char style="nd">Yavé</char> moraré por largos días.<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="s1">Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 24:1"/>De <char style="nd">Yavé</char> es la tierra y lo que hay en ella,</para>
  <para style="q" vid="PSA 24:1">El mundo y los que habitan en él.<verse eid="PSA 24:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 24:2"/>Porque Él la fundó sobre los mares</para>
  <para style="q" vid="PSA 24:2">Y la afirmó sobre las corrientes de agua.<verse eid="PSA 24:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 24:3"/>¿Quién subirá a la Montaña de <char style="nd">Yavé</char>?</para>
  <para style="q" vid="PSA 24:3">¿Quién podrá estar en pie en su Santuario?<verse eid="PSA 24:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 24:4"/>El limpio de manos y puro de corazón,</para>
  <para style="q" vid="PSA 24:4">El que no elevó su alma a la falsedad</para>
  <para style="q" vid="PSA 24:4">Ni juró con engaño.<verse eid="PSA 24:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 24:5"/>Él recibirá bendición de <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 24:5">Y la justicia del <char style="nd">ʼElohim</char> de su salvación.<verse eid="PSA 24:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 24:6"/>Esta es la generación de los que lo buscan,</para>
  <para style="q" vid="PSA 24:6">De los que buscan tu rostro, <char style="add">oh</char> <char style="nd">ʼElohim</char> de Jacob. <char style="tl">Selah</char><verse eid="PSA 24:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 24:7"/>¡Alcen, oh puertas, sus cabezas!</para>
  <para style="q" vid="PSA 24:7">¡Sean levantados, portales eternos,</para>
  <para style="q" vid="PSA 24:7">Y entrará el Rey de gloria!<verse eid="PSA 24:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 24:8"/>¿Quién es este Rey de gloria?</para>
  <para style="q" vid="PSA 24:8">¡<char style="nd">Yavé</char>, el Fuerte y Poderoso!</para>
  <para style="q" vid="PSA 24:8">¡<char style="nd">Yavé</char>, el Poderoso en batalla!<verse eid="PSA 24:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 24:9"/>¡Alcen, oh puertas, sus cabezas!</para>
  <para style="q" vid="PSA 24:9">¡Sean levantados, portales eternos,</para>
  <para style="q" vid="PSA 24:9">Y entrará el Rey de gloria!<verse eid="PSA 24:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 24:10"/>¿Quién es este Rey de gloria?</para>
  <para style="q" vid="PSA 24:10">¡<char style="nd">Yavé</char> de las huestes!</para>
  <para style="q" vid="PSA 24:10">¡Él es el Rey de gloria! <char style="tl">Selah</char><verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="s1">Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 25:1"/>A Ti, oh <char style="nd">Yavé</char>, levanto mi alma.<verse eid="PSA 25:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 25:2"/>¡<char style="nd">ʼElohim</char> mío, en Ti confío!</para>
  <para style="q" vid="PSA 25:2">No sea yo avergonzado,</para>
  <para style="q" vid="PSA 25:2">No se alegren de mí mis enemigos.<verse eid="PSA 25:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 25:3"/>Ciertamente ninguno de los que confían en Ti será avergonzado.</para>
  <para style="q" vid="PSA 25:3">Serán avergonzados los que se rebelan sin causa.<verse eid="PSA 25:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 25:4"/>Muéstrame, oh <char style="nd">Yavé</char>, tus caminos,</para>
  <para style="q" vid="PSA 25:4">Enséñame tus sendas.<verse eid="PSA 25:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 25:5"/>Encamíname en tu verdad y enséñame,</para>
  <para style="q" vid="PSA 25:5">Porque Tú eres el <char style="nd">ʼElohim</char> de mi salvación.</para>
  <para style="b" vid="PSA 25:5"/>
  <para style="q" vid="PSA 25:5">En Ti espero todo el día.<verse eid="PSA 25:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 25:6"/>Acuérdate, oh <char style="nd">Yavé</char>, de tu compasión y de tu misericordia que son perpetuas.<verse eid="PSA 25:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 25:7"/>No te acuerdes de los pecados de mi juventud y de mis transgresiones.</para>
  <para style="q" vid="PSA 25:7">Conforme a tu misericordia acuérdate de mí,</para>
  <para style="q" vid="PSA 25:7">Por tu bondad, oh <char style="nd">Yavé</char>.<verse eid="PSA 25:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 25:8"/>Bueno y justo es <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 25:8">Él muestra el camino a los pecadores.<verse eid="PSA 25:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 25:9"/>Encamina a los humildes en justicia,</para>
  <para style="q" vid="PSA 25:9">Y enseña a los mansos su senda.<verse eid="PSA 25:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 25:10"/>Todas las sendas de <char style="nd">Yavé</char> son misericordia y verdad</para>
  <para style="q" vid="PSA 25:10">Para los que observan su Pacto y sus Preceptos.<verse eid="PSA 25:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 25:11"/>Por amor a tu Nombre, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 25:11">Perdonas también mi iniquidad, que es grande.<verse eid="PSA 25:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 25:12"/>¿Quién es el hombre que teme a <char style="nd">Yavé</char>?</para>
  <para style="q" vid="PSA 25:12">Él le enseñará el camino que debe escoger.<verse eid="PSA 25:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 25:13"/>Su alma gozará de bienestar,</para>
  <para style="q" vid="PSA 25:13">Y su descendencia heredará la tierra.<verse eid="PSA 25:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 25:14"/>El secreto de <char style="nd">Yavé</char> es para los que le temen.</para>
  <para style="q" vid="PSA 25:14">A ellos hará conocer su Pacto.<verse eid="PSA 25:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 25:15"/>Mis ojos están siempre fijos en <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 25:15">Porque Él sacará mis pies de la red.<verse eid="PSA 25:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 25:16"/>Mírame y ten misericordia de mí,</para>
  <para style="q" vid="PSA 25:16">Porque estoy solo y afligido.<verse eid="PSA 25:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 25:17"/>Las angustias de mi corazón se aumentaron.</para>
  <para style="q" vid="PSA 25:17">¡Sácame de mis congojas!<verse eid="PSA 25:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 25:18"/>Mira mi aflicción y mis fatigas,</para>
  <para style="q" vid="PSA 25:18">Y perdona todos mis pecados.<verse eid="PSA 25:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 25:19"/>¡Mira cómo se multiplicaron mis enemigos,</para>
  <para style="q" vid="PSA 25:19">Y con violento odio me aborrecen!<verse eid="PSA 25:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 25:20"/>¡Guarda mi alma y líbrame!</para>
  <para style="q" vid="PSA 25:20">No sea yo avergonzado,</para>
  <para style="q" vid="PSA 25:20">Porque en Ti me refugio.<verse eid="PSA 25:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 25:21"/>Integridad y rectitud me guarden,</para>
  <para style="q" vid="PSA 25:21">Porque en Ti espero.<verse eid="PSA 25:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 25:22"/>¡Oh <char style="nd">ʼElohim</char>, redime a Israel de todas sus angustias!<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="s1">Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 26:1"/>Defiéndeme, oh <char style="nd">Yavé</char>, porque en mi integridad anduve,</para>
  <para style="q" vid="PSA 26:1">Y en <char style="nd">Yavé</char> confié sin titubear.<verse eid="PSA 26:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 26:2"/>Examíname, oh <char style="nd">Yavé</char>, y pruébame.</para>
  <para style="q" vid="PSA 26:2">Escudriña lo más íntimo de mi personalidad<note caller="+" style="f"><char style="fr" closed="false">26.2 </char><char style="ft" closed="false">Lit. riñones. </char></note> y mi corazón,<verse eid="PSA 26:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 26:3"/>Porque tu misericordia está delante de mis ojos</para>
  <para style="q" vid="PSA 26:3">Y ando en tu verdad.<verse eid="PSA 26:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 26:4"/>No me siento con hombres falsos</para>
  <para style="q" vid="PSA 26:4">Ni ando con hipócritas.<verse eid="PSA 26:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 26:5"/>Aborrezco la reunión de perversos</para>
  <para style="q" vid="PSA 26:5">Y no me sentaré con los inicuos.<verse eid="PSA 26:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 26:6"/>Lavaré en inocencia mis manos,</para>
  <para style="q" vid="PSA 26:6">Y así andaré en torno a tu altar, oh <char style="nd">Yavé</char>,<verse eid="PSA 26:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 26:7"/>Para hacer resonar mi voz de gratitud</para>
  <para style="q" vid="PSA 26:7">Y contar todas tus maravillas.<verse eid="PSA 26:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 26:8"/>Oh <char style="nd">Yavé</char>, yo amo la Casa donde moras,</para>
  <para style="q" vid="PSA 26:8">Y el lugar donde reside tu gloria.<verse eid="PSA 26:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 26:9"/>No arrebates mi alma con los pecadores,</para>
  <para style="q" vid="PSA 26:9">Ni mi vida con hombres sanguinarios,<verse eid="PSA 26:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 26:10"/>En las manos de los cuales está el crimen,</para>
  <para style="q" vid="PSA 26:10">Cuya mano derecha está llena de sobornos.<verse eid="PSA 26:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 26:11"/>En cuanto a mí, andaré en mi integridad.</para>
  <para style="q" vid="PSA 26:11">¡Redímeme y ten misericordia de mí!<verse eid="PSA 26:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 26:12"/>Mis pies están en suelo firme.</para>
  <para style="q" vid="PSA 26:12">Bendeciré a <char style="nd">Yavé</char> en las congregaciones.<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="s1">Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 27:1"/>
    <char style="nd">Yavé</char> es mi Luz y mi Salvación,</para>
  <para style="q" vid="PSA 27:1">¿De quién temeré?</para>
  <para style="q" vid="PSA 27:1">
    <char style="nd">Yavé</char> es la Fortaleza de mi vida,</para>
  <para style="q" vid="PSA 27:1">¿De quién me aterrorizaré?<verse eid="PSA 27:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 27:2"/>Cuando se juntaron contra mí los perversos para devorar mi carne,</para>
  <para style="q" vid="PSA 27:2">Mis adversarios y mis enemigos tropezaron y cayeron.<verse eid="PSA 27:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 27:3"/>Aunque un ejército acampe contra mí,</para>
  <para style="q" vid="PSA 27:3">No temerá mi corazón.</para>
  <para style="q" vid="PSA 27:3">Aunque contra mí se levante guerra,</para>
  <para style="q" vid="PSA 27:3">Yo estaré confiado.<verse eid="PSA 27:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 27:4"/>Una cosa le pedí a <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 27:4">Ésta buscaré:</para>
  <para style="q" vid="PSA 27:4">Que esté yo en la Casa de <char style="nd">Yavé</char> todos los días de mi vida,</para>
  <para style="q" vid="PSA 27:4">Para contemplar la hermosura de <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 27:4">Y para meditar en su Templo.<verse eid="PSA 27:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 27:5"/>Porque Él me esconderá en su Tabernáculo en el día del mal.</para>
  <para style="q" vid="PSA 27:5">Me ocultará en lo reservado de su Tabernáculo.</para>
  <para style="q" vid="PSA 27:5">Me pondrá en alto sobre una roca.<verse eid="PSA 27:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 27:6"/>Mi cabeza será levantada sobre mis enemigos que estén alrededor,</para>
  <para style="q" vid="PSA 27:6">Y en su Tabernáculo ofreceré sacrificios con clamor de júbilo.</para>
  <para style="q" vid="PSA 27:6">Cantaré, sí, entonaré salmos a <char style="nd">Yavé</char>.<verse eid="PSA 27:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 27:7"/>¡Escucha, oh <char style="nd">Yavé</char>, cuando clamo con mi voz!</para>
  <para style="q" vid="PSA 27:7">¡Ten compasión de mí y respóndeme!<verse eid="PSA 27:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 27:8"/>Mi corazón me dice de Ti:</para>
  <para style="q" vid="PSA 27:8">¡Busca su rostro!</para>
  <para style="q" vid="PSA 27:8">Tu rostro buscaré, oh <char style="nd">Yavé</char>.<verse eid="PSA 27:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 27:9"/>No escondas tu rostro de mí,</para>
  <para style="q" vid="PSA 27:9">Ni rechaces con ira a tu esclavo.</para>
  <para style="q" vid="PSA 27:9">Has sido mi Ayuda.</para>
  <para style="q" vid="PSA 27:9">No me abandones</para>
  <para style="q" vid="PSA 27:9">Ni me desampares,</para>
  <para style="q" vid="PSA 27:9">Oh <char style="nd">ʼElohim</char> de mi salvación.<verse eid="PSA 27:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 27:10"/>Aunque mi padre y mi madre me abandonen,</para>
  <para style="q" vid="PSA 27:10">
    <char style="nd">Yavé</char> me recogerá.<verse eid="PSA 27:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 27:11"/>Enséñame, oh <char style="nd">Yavé</char>, tu camino,</para>
  <para style="q" vid="PSA 27:11">Y guíame por senda llana, a causa de mis enemigos.<verse eid="PSA 27:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 27:12"/>No me entregues a la voluntad de mis adversarios,</para>
  <para style="q" vid="PSA 27:12">Porque se levantaron contra mí testigos falsos que respiran violencia.<verse eid="PSA 27:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 27:13"/>Hubiera yo desmayado</para>
  <para style="q" vid="PSA 27:13">Si no creyera que veré la bondad de <char style="nd">Yavé</char> en la tierra de los vivientes.<verse eid="PSA 27:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 27:14"/>Espera a <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 27:14">¡Sé fortalecido y aliéntese tu corazón!</para>
  <para style="q" vid="PSA 27:14">¡Sí, espera a <char style="nd">Yavé</char>!<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="s1">Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 28:1"/>A Ti clamo, oh <char style="nd">Yavé</char>, Roca mía.</para>
  <para style="q" vid="PSA 28:1">No enmudezcas para mí,</para>
  <para style="q" vid="PSA 28:1">Porque si Tú enmudeces para mí,</para>
  <para style="q" vid="PSA 28:1">Seré como los que bajan a la fosa.<verse eid="PSA 28:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 28:2"/>Oye la voz de mis súplicas cuando clamo a Ti,</para>
  <para style="q" vid="PSA 28:2">Cuando levanto mis manos hacia tu Santuario.<verse eid="PSA 28:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 28:3"/>No me arrastres junto con los impíos,</para>
  <para style="q" vid="PSA 28:3">Quienes hacen iniquidad</para>
  <para style="q" vid="PSA 28:3">Y hablan de paz con su prójimo,</para>
  <para style="q" vid="PSA 28:3">Pero la perversidad está en sus corazones.<verse eid="PSA 28:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 28:4"/>Dales conforme a su obra y según la perversidad de sus hechos.</para>
  <para style="q" vid="PSA 28:4">Retribúyeles de acuerdo con las obras de sus manos.</para>
  <para style="q" vid="PSA 28:4">¡Dales su recompensa!<verse eid="PSA 28:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 28:5"/>Porque no entienden los hechos de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 28:5">Ni las obras de sus manos,</para>
  <para style="q" vid="PSA 28:5">Él los derribará y no los edificará.<verse eid="PSA 28:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 28:6"/>¡Bendito sea <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 28:6">Porque escuchó la voz de mi súplica!<verse eid="PSA 28:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 28:7"/>
    <char style="nd">Yavé</char> es mi Fortaleza y mi Escudo.</para>
  <para style="q" vid="PSA 28:7">Confió mi corazón en Él</para>
  <para style="q" vid="PSA 28:7">Y fui ayudado,</para>
  <para style="q" vid="PSA 28:7">Por lo cual se regocija mi corazón.</para>
  <para style="q" vid="PSA 28:7">Lo alabaré con mi canto.<verse eid="PSA 28:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 28:8"/>
    <char style="nd">Yavé</char> es la Fortaleza <char style="add">de su pueblo</char>,</para>
  <para style="q" vid="PSA 28:8">Y el Refugio salvador de su ungido.<verse eid="PSA 28:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 28:9"/>¡Salva a tu pueblo,</para>
  <para style="q" vid="PSA 28:9">Y bendice tu heredad!</para>
  <para style="q" vid="PSA 28:9">¡Pastoréalos y cárgalos para siempre!<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="s1">Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 29:1"/>¡Tributen a <char style="nd">Yavé</char>, oh hijos de los poderosos!</para>
  <para style="q" vid="PSA 29:1">¡Tributen a <char style="nd">Yavé</char> la gloria y el poder!<verse eid="PSA 29:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 29:2"/>¡Tributen a <char style="nd">Yavé</char> la gloria debida a su Nombre!</para>
  <para style="q" vid="PSA 29:2">¡Póstrense ante <char style="nd">Yavé</char> en el esplendor de la santidad!<verse eid="PSA 29:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 29:3"/>Voz de <char style="nd">Yavé</char> sobre las aguas:</para>
  <para style="q" vid="PSA 29:3">¡El <char style="nd">ʼElohim</char> de gloria truena!</para>
  <para style="q" vid="PSA 29:3">¡<char style="nd">Yavé</char> está sobre muchas aguas!<verse eid="PSA 29:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 29:4"/>Voz de <char style="nd">Yavé</char> es poderosa,</para>
  <para style="q" vid="PSA 29:4">Voz de <char style="nd">Yavé</char> es majestuosa.<verse eid="PSA 29:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 29:5"/>Voz de <char style="nd">Yavé</char> que quiebra los cedros,</para>
  <para style="q" vid="PSA 29:5">
    <char style="nd">Yavé</char> destroza los cedros del Líbano.<verse eid="PSA 29:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 29:6"/>Él hace saltar al Líbano como un becerro.<verse eid="PSA 29:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 29:7"/>Voz de <char style="nd">Yavé</char> que enciende llamaradas.<verse eid="PSA 29:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 29:8"/>Voz de <char style="nd">Yavé</char> que estremece el desierto.</para>
  <para style="q" vid="PSA 29:8">
    <char style="nd">Yavé</char> sacude al desierto de Cades.<verse eid="PSA 29:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 29:9"/>Voz de <char style="nd">Yavé</char> que estremece los robles y desnuda los bosques.</para>
  <para style="q" vid="PSA 29:9">En su Templo todos proclaman su gloria.<verse eid="PSA 29:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 29:10"/>
    <char style="nd">Yavé</char> preside en el diluvio.</para>
  <para style="q" vid="PSA 29:10">
    <char style="nd">Yavé</char> se sienta como Rey para siempre.<verse eid="PSA 29:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 29:11"/>
    <char style="nd">Yavé</char> dará fortaleza a su pueblo.</para>
  <para style="q" vid="PSA 29:11">
    <char style="nd">Yavé</char> bendecirá a su pueblo con paz.<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="s1">Canto para la dedicación del Templo. Salmo de David.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 30:1"/>Te exalto oh <char style="nd">Yavé</char>, porque me levantaste,</para>
  <para style="q" vid="PSA 30:1">Y no dejaste que mis enemigos se alegraran de mí.<verse eid="PSA 30:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 30:2"/>¡Oh <char style="nd">Yavé</char>, mi <char style="nd">ʼElohim</char>!</para>
  <para style="q" vid="PSA 30:2">Clamé a Ti, y me sanaste.<verse eid="PSA 30:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 30:3"/>¡Oh <char style="nd">Yavé</char>, sacaste mi vida del <char style="tl">Seol</char>,</para>
  <para style="q" vid="PSA 30:3">De entre los que bajan a la tumba me mantuviste vivo!<verse eid="PSA 30:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 30:4"/>Canten salmos a <char style="nd">Yavé</char>, ustedes sus santos,</para>
  <para style="q" vid="PSA 30:4">Y celebren la memoria de su santidad.<verse eid="PSA 30:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 30:5"/>Por un momento es su ira,</para>
  <para style="q" vid="PSA 30:5">Pero su favor dura toda la vida.</para>
  <para style="q" vid="PSA 30:5">Por la noche dura el llanto,</para>
  <para style="q" vid="PSA 30:5">Pero al amanecer viene la alegría.<verse eid="PSA 30:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 30:6"/>En mi prosperidad me decía:</para>
  <para style="q" vid="PSA 30:6">No seré conmovido jamás,<verse eid="PSA 30:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 30:7"/>Porque con tu favor, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 30:7">Me afirmaste como fuerte montaña.</para>
  <para style="q" vid="PSA 30:7">Escondiste tu rostro, fui turbado.<verse eid="PSA 30:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 30:8"/>A Ti clamé, oh <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 30:8">A <char style="nd">Yavé</char> dirigí mi súplica.<verse eid="PSA 30:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 30:9"/>¿Qué provecho hay en mi muerte cuando baje a la tumba?</para>
  <para style="q" vid="PSA 30:9">¿Te alabará el polvo?</para>
  <para style="q" vid="PSA 30:9">¿Anunciará tu verdad?<verse eid="PSA 30:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 30:10"/>Escucha, oh <char style="nd">Yavé</char>, y ten compasión de mí.</para>
  <para style="q" vid="PSA 30:10">¡Oh <char style="nd">Yavé</char>, sé mi Ayudador!<verse eid="PSA 30:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 30:11"/>Cambiaste mi lamento en danza,</para>
  <para style="q" vid="PSA 30:11">Desataste mi tela áspera y me vestiste de alegría.<verse eid="PSA 30:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 30:12"/>Por tanto, a Ti cantaré, Gloria mía, y no estaré callado.</para>
  <para style="q" vid="PSA 30:12">¡Oh <char style="nd">Yavé</char>, mi <char style="nd">ʼElohim</char>, te daré gracias para siempre!<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="s1">Al director del coro. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 31:1"/>En Ti, oh <char style="nd">Yavé</char>, me refugié.</para>
  <para style="q" vid="PSA 31:1">No sea yo avergonzado jamás.</para>
  <para style="q" vid="PSA 31:1">Líbrame en tu justicia.<verse eid="PSA 31:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 31:2"/>Inclina tu oído a mí y rescátame pronto.</para>
  <para style="b" vid="PSA 31:2"/>
  <para style="q" vid="PSA 31:2">¡Sé Tú mi Roca fuerte, mi Fortaleza para salvarme!<verse eid="PSA 31:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 31:3"/>Porque Tú eres mi Roca y mi Fortaleza,</para>
  <para style="q" vid="PSA 31:3">Por amor a tu Nombre</para>
  <para style="q" vid="PSA 31:3">Me guías y me encaminas.<verse eid="PSA 31:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 31:4"/>¡Sácame de la red que me tendieron,</para>
  <para style="q" vid="PSA 31:4">Porque Tú eres mi Refugio!<verse eid="PSA 31:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 31:5"/>En tu mano encomiendo mi espíritu.</para>
  <para style="q" vid="PSA 31:5">Tú, oh <char style="nd">Yavé, ʼElohim</char> me redimiste de verdad.<verse eid="PSA 31:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 31:6"/>Aborrezco a los que confían en ídolos vanos,</para>
  <para style="q" vid="PSA 31:6">Pero confío en <char style="nd">Yavé</char>.<verse eid="PSA 31:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 31:7"/>Me regocijaré y me alegraré en tu misericordia,</para>
  <para style="q" vid="PSA 31:7">Porque viste mi aflicción,</para>
  <para style="q" vid="PSA 31:7">Conociste las angustias de mi alma,<verse eid="PSA 31:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 31:8"/>No me entregaste en mano del enemigo,</para>
  <para style="q" vid="PSA 31:8">Pusiste mis pies en lugar amplio.<verse eid="PSA 31:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 31:9"/>Ten misericordia de mí, oh <char style="nd">Yavé</char>, porque estoy en angustia.</para>
  <para style="q" vid="PSA 31:9">Mis ojos, mi alma y mis órganos internos se debilitaron por la angustia.<verse eid="PSA 31:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 31:10"/>Porque mi vida se agotó de tristeza, y mis años de suspirar.</para>
  <para style="q" vid="PSA 31:10">A causa de mi iniquidad mi vigor decayó</para>
  <para style="q" vid="PSA 31:10">Y se consumen mis huesos.<verse eid="PSA 31:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 31:11"/>Soy objeto de oprobio para todos mis adversarios,</para>
  <para style="q" vid="PSA 31:11">Y para mis vecinos, objeto de horror,</para>
  <para style="q" vid="PSA 31:11">Y de horror para mis conocidos.</para>
  <para style="q" vid="PSA 31:11">Los que me ven en la calle huyen de mí.<verse eid="PSA 31:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 31:12"/>Fui olvidado de sus corazones como un muerto.</para>
  <para style="q" vid="PSA 31:12">Soy como un vaso quebrado.<verse eid="PSA 31:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 31:13"/>Oigo la calumnia de muchos.</para>
  <para style="q" vid="PSA 31:13">El terror me asalta por todas partes</para>
  <para style="q" vid="PSA 31:13">Mientras conspiran unidos contra mí</para>
  <para style="q" vid="PSA 31:13">Y traman quitarme la vida.<verse eid="PSA 31:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 31:14"/>Pero en Ti, oh <char style="nd">Yavé</char>, fijé mi confianza.</para>
  <para style="q" vid="PSA 31:14">Digo: Tú eres mi <char style="nd">ʼElohim</char>.<verse eid="PSA 31:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 31:15"/>En tu mano están mis tiempos.</para>
  <para style="q" vid="PSA 31:15">Líbrame de la mano de mis enemigos y de mis perseguidores.<verse eid="PSA 31:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 31:16"/>Resplandezca tu rostro sobre tu esclavo.</para>
  <para style="q" vid="PSA 31:16">¡Sálvame por tu misericordia!<verse eid="PSA 31:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 31:17"/>No sea yo avergonzado, oh <char style="nd">Yavé</char>, porque te invoco.</para>
  <para style="b" vid="PSA 31:17"/>
  <para style="q" vid="PSA 31:17">¡Sean avergonzados los malos,</para>
  <para style="q" vid="PSA 31:17">Bajen en silencio al <char style="tl">Seol</char>!<verse eid="PSA 31:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 31:18"/>Enmudezcan los labios mentirosos</para>
  <para style="q" vid="PSA 31:18">Que hablan insolencias contra el justo con soberbia y desprecio.<verse eid="PSA 31:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 31:19"/>¡Cuán grande es tu bondad</para>
  <para style="q" vid="PSA 31:19">Que guardaste para los que te temen,</para>
  <para style="q" vid="PSA 31:19">Que obraste para los hijos de los hombres que en Ti confían!<verse eid="PSA 31:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 31:20"/>En lo secreto de tu Presencia los ocultas de la conspiración del hombre.</para>
  <para style="q" vid="PSA 31:20">En un Tabernáculo los guardarás de las contiendas de lenguas.<verse eid="PSA 31:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 31:21"/>¡Bendito sea <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 31:21">Porque hizo maravillosa su misericordia para conmigo en ciudad fortificada!<verse eid="PSA 31:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 31:22"/>En mi premura, me dije:</para>
  <para style="q" vid="PSA 31:22">¡Cortado soy de tu Presencia!</para>
  <para style="q" vid="PSA 31:22">Pero Tú oíste la voz de mis súplicas</para>
  <para style="q" vid="PSA 31:22">Cuando clamé a Ti.<verse eid="PSA 31:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 31:23"/>Amen a <char style="nd">Yavé</char> ustedes, todos sus santos.</para>
  <para style="q" vid="PSA 31:23">
    <char style="nd">Yavé</char> guarda a los fieles,</para>
  <para style="q" vid="PSA 31:23">Pero retribuye con creces al que actúa con soberbia.<verse eid="PSA 31:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 31:24"/>Sean esforzados todos ustedes, los que esperan en <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 31:24">Y tome aliento su corazón.<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="s1">Instrucción (<char style="tl">Maskil</char>) de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 32:1"/>Inmensamente feliz es aquel</para>
  <para style="q" vid="PSA 32:1">A quien es perdonada su transgresión</para>
  <para style="q" vid="PSA 32:1">Y cubierto su pecado.<verse eid="PSA 32:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 32:2"/>Inmensamente feliz es el hombre</para>
  <para style="q" vid="PSA 32:2">A quien <char style="nd">Yavé</char> no atribuye iniquidad,</para>
  <para style="q" vid="PSA 32:2">Y en el espíritu del cual no hay engaño.<verse eid="PSA 32:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 32:3"/>Mientras callé, se consumieron mis huesos</para>
  <para style="q" vid="PSA 32:3">En mi gemir todo el día.<verse eid="PSA 32:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 32:4"/>Porque de día y de noche pesó sobre mí tu mano.</para>
  <para style="q" vid="PSA 32:4">Hasta que mi vigor se convirtió</para>
  <para style="q" vid="PSA 32:4">En sequedades de verano. <char style="tl">Selah</char><verse eid="PSA 32:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 32:5"/>Mi pecado confesé y no encubrí mi iniquidad.</para>
  <para style="q" vid="PSA 32:5">Dije: Confesaré mis transgresiones a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 32:5">Y Tú perdonaste la culpa de mi pecado. <char style="tl">Selah</char><verse eid="PSA 32:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 32:6"/>Por esto todo santo ora a Ti</para>
  <para style="q" vid="PSA 32:6">En un tiempo cuando puedes ser hallado.</para>
  <para style="q" vid="PSA 32:6">Ciertamente en la inundación de muchas aguas,</para>
  <para style="q" vid="PSA 32:6">Éstas no llegarán a él.<verse eid="PSA 32:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 32:7"/>Tú eres mi Refugio.</para>
  <para style="q" vid="PSA 32:7">Me guardas de la angustia.</para>
  <para style="q" vid="PSA 32:7">Me rodeas con cantos de liberación. <char style="tl">Selah</char><verse eid="PSA 32:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 32:8"/>
    <char style="wj">Te haré entender</char></para>
  <para style="q" vid="PSA 32:8">
    <char style="wj">Y te enseñaré el camino en el cual debes andar.</char></para>
  <para style="q" vid="PSA 32:8">
    <char style="wj">Sobre Ti fijaré mis ojos y te aconsejaré. </char><verse eid="PSA 32:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 32:9"/>
    <char style="wj">No sean como el caballo o la mula,</char></para>
  <para style="q" vid="PSA 32:9">
    <char style="wj">Sin entendimiento,</char></para>
  <para style="q" vid="PSA 32:9">
    <char style="wj">Cuya boca debe ser frenada con freno y rienda</char></para>
  <para style="q" vid="PSA 32:9">
    <char style="wj">Para que se acerquen a Ti.</char><verse eid="PSA 32:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 32:10"/>Muchos dolores hay para el impío,</para>
  <para style="q" vid="PSA 32:10">Pero al que confía en <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 32:10">Lo rodea la misericordia.<verse eid="PSA 32:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 32:11"/>¡Alégrense, oh justos, en <char style="nd">Yavé</char>, y regocíjense!</para>
  <para style="q" vid="PSA 32:11">¡Canten con júbilo todos los rectos de corazón!<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 33:1"/>¡Alégrense, oh justos, en <char style="nd">Yavé</char>!</para>
  <para style="q" vid="PSA 33:1">En los íntegros es hermosa la alabanza.<verse eid="PSA 33:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 33:2"/>Den gracias a <char style="nd">Yavé</char> con arpa.</para>
  <para style="q" vid="PSA 33:2">Cántenle con el arpa de diez cuerdas.<verse eid="PSA 33:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 33:3"/>Cántenle canto nuevo.</para>
  <para style="q" vid="PSA 33:3">¡Háganlo bien, tañan con júbilo!<verse eid="PSA 33:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 33:4"/>Pues recta es la Palabra de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 33:4">Y toda su obra es hecha con fidelidad.<verse eid="PSA 33:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 33:5"/>Él ama la rectitud y la justicia.</para>
  <para style="q" vid="PSA 33:5">De la misericordia de <char style="nd">Yavé</char> está llena la tierra.<verse eid="PSA 33:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 33:6"/>Por la Palabra de <char style="nd">Yavé</char> fueron hechos los cielos,</para>
  <para style="q" vid="PSA 33:6">Y todas sus constelaciones por el aliento de su boca.<verse eid="PSA 33:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 33:7"/>Él reúne como en una pila las aguas del mar.</para>
  <para style="q" vid="PSA 33:7">Él pone en depósitos los abismos.<verse eid="PSA 33:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 33:8"/>¡Tema a <char style="nd">Yavé</char> toda la tierra!</para>
  <para style="q" vid="PSA 33:8">¡Tiemblen delante de Él todos los habitantes del mundo!<verse eid="PSA 33:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 33:9"/>Porque Él dijo y fue hecho.</para>
  <para style="q" vid="PSA 33:9">Él ordenó y apareció.<verse eid="PSA 33:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 33:10"/>
    <char style="nd">Yavé</char> anula el consejo de las naciones.</para>
  <para style="q" vid="PSA 33:10">Él frustra los planes de los pueblos.<verse eid="PSA 33:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 33:11"/>El consejo de <char style="nd">Yavé</char> permanece para siempre,</para>
  <para style="q" vid="PSA 33:11">Y los planes de su corazón por todas las generaciones.<verse eid="PSA 33:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 33:12"/>¡Cuán bendecida es la nación cuyo <char style="nd">ʼElohim</char> es <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 33:12">El pueblo que Él escogió como su propia heredad!<verse eid="PSA 33:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 33:13"/>
    <char style="nd">Yavé</char> ve desde el cielo.</para>
  <para style="q" vid="PSA 33:13">Mira a todos los hijos de <char style="add">los</char> hombres.<verse eid="PSA 33:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 33:14"/>Desde el lugar de su morada</para>
  <para style="q" vid="PSA 33:14">Observa a todos los habitantes de la tierra.<verse eid="PSA 33:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 33:15"/>El que forma los corazones de todos ellos</para>
  <para style="q" vid="PSA 33:15">Considera todas sus acciones.<verse eid="PSA 33:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 33:16"/>El rey no se salva por la multitud del ejército,</para>
  <para style="q" vid="PSA 33:16">Ni el poderoso escapa por la mucha fuerza.<verse eid="PSA 33:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 33:17"/>Vano es el caballo para la victoria.</para>
  <para style="q" vid="PSA 33:17">No libra a cualquiera con su gran fuerza.<verse eid="PSA 33:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 33:18"/>Ahí está el ojo de <char style="nd">Yavé</char> sobre los que le temen,</para>
  <para style="q" vid="PSA 33:18">Sobre los que esperan en su misericordia<verse eid="PSA 33:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 33:19"/>Para salvar su vida de la muerte</para>
  <para style="q" vid="PSA 33:19">Y mantenerlos vivos en tiempo de hambre.<verse eid="PSA 33:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 33:20"/>Nuestras almas esperan a <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 33:20">Él es nuestra Ayuda y nuestro Escudo.<verse eid="PSA 33:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 33:21"/>Por tanto, en Él se alegra nuestro corazón,</para>
  <para style="q" vid="PSA 33:21">Porque confiamos en su santo Nombre.<verse eid="PSA 33:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 33:22"/>Que tu misericordia, oh <char style="nd">Yavé</char>, sea sobre nosotros,</para>
  <para style="q" vid="PSA 33:22">Según esperamos en Ti.<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="s1">Salmo de David. Cuando cambió su conducta ante Abimelec, quien lo echó y él salió</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 34:1"/>Bendeciré a <char style="nd">Yavé</char> en todo tiempo.</para>
  <para style="q" vid="PSA 34:1">Su alabanza estará de continuo en mi boca.<verse eid="PSA 34:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 34:2"/>En <char style="nd">Yavé</char> se gloriará mi alma.</para>
  <para style="q" vid="PSA 34:2">Lo oirán los mansos y se alegrarán.<verse eid="PSA 34:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 34:3"/>Engrandezcan a <char style="nd">Yavé</char> conmigo,</para>
  <para style="q" vid="PSA 34:3">Y exaltemos juntos su Nombre.<verse eid="PSA 34:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 34:4"/>Busqué a <char style="nd">Yavé</char> y Él me respondió,</para>
  <para style="q" vid="PSA 34:4">Y me libró de todos mis temores.<verse eid="PSA 34:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 34:5"/>Los que miraron a Él fueron iluminados,</para>
  <para style="q" vid="PSA 34:5">Y sus semblantes nunca serán avergonzados.<verse eid="PSA 34:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 34:6"/>Este pobre clamó,</para>
  <para style="q" vid="PSA 34:6">Y <char style="nd">Yavé</char> lo escuchó,</para>
  <para style="q" vid="PSA 34:6">Y lo salvó de todas sus angustias.<verse eid="PSA 34:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 34:7"/>El Ángel de <char style="nd">Yavé</char> acampa alrededor de los que le temen,</para>
  <para style="q" vid="PSA 34:7">Y los rescata.<verse eid="PSA 34:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 34:8"/>Prueben y vean que <char style="nd">Yavé</char> es bueno.</para>
  <para style="q" vid="PSA 34:8">¡Cuán feliz es el varón que confía en Él!<verse eid="PSA 34:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 34:9"/>Teman a <char style="nd">Yavé</char>, ustedes sus santos,</para>
  <para style="q" vid="PSA 34:9">Porque nada falta a los que le temen.<verse eid="PSA 34:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 34:10"/>Los cachorros de león necesitan y sufren hambre,</para>
  <para style="q" vid="PSA 34:10">Pero los que buscan a <char style="nd">Yavé</char> no carecen de ningún bien.<verse eid="PSA 34:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 34:11"/>Vengan, hijos, escúchenme.</para>
  <para style="q" vid="PSA 34:11">Les enseñaré el temor a <char style="nd">Yavé</char>.<verse eid="PSA 34:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 34:12"/>¿Quién es el hombre que desea vida,</para>
  <para style="q" vid="PSA 34:12">Que desea muchos días para ver el bien?<verse eid="PSA 34:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 34:13"/>Guarda tu boca del mal</para>
  <para style="q" vid="PSA 34:13">Y tus labios de hablar engaño.<verse eid="PSA 34:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 34:14"/>Apártate del mal y haz el bien.</para>
  <para style="q" vid="PSA 34:14">Busca la paz y persíguela.<verse eid="PSA 34:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 34:15"/>Los ojos de <char style="nd">Yavé</char> están hacia los justos,</para>
  <para style="q" vid="PSA 34:15">Y sus oídos atentos al clamor de ellos.<verse eid="PSA 34:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 34:16"/>El rostro de <char style="nd">Yavé</char> está contra los perversos,</para>
  <para style="q" vid="PSA 34:16">Para cortar su memoria de la tierra.<verse eid="PSA 34:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 34:17"/>Claman los justos,</para>
  <para style="q" vid="PSA 34:17">Y <char style="nd">Yavé</char> los oye</para>
  <para style="q" vid="PSA 34:17">Y los libra de todas sus angustias.<verse eid="PSA 34:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 34:18"/>Cercano está <char style="nd">Yavé</char> a los quebrantados de corazón,</para>
  <para style="q" vid="PSA 34:18">Y salva a los contritos de espíritu.<verse eid="PSA 34:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 34:19"/>Muchas son las aflicciones del justo,</para>
  <para style="q" vid="PSA 34:19">Pero de todas ellas lo libra <char style="nd">Yavé</char>.<verse eid="PSA 34:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 34:20"/>Él guarda todos sus huesos.</para>
  <para style="q" vid="PSA 34:20">Ni uno de ellos es quebrado.<verse eid="PSA 34:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 34:21"/>Matará al malo la maldad,</para>
  <para style="q" vid="PSA 34:21">Y los que aborrecen al justo serán culpables.<verse eid="PSA 34:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 34:22"/>
    <char style="nd">Yavé</char> redime la vida de sus esclavos.</para>
  <para style="q" vid="PSA 34:22">No serán condenados cuantos en Él confían.<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="s1">Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 35:1"/>¡Oh <char style="nd">Yavé</char>, contiende con los que contienden contra mí!</para>
  <para style="q" vid="PSA 35:1">¡Pelea contra los que combaten contra mí!<verse eid="PSA 35:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 35:2"/>¡Echa mano al escudo y al broquel,<note caller="+" style="f"><char style="fr" closed="false">35.2 </char><char style="ft" closed="false">Escudo era el que se ataba a los brazos y cubría el pecho. Broquel, un escudo pequeño que el soldado llevaba en su mano. Algunos traducen “pavés”, que era un escudo de gran tamaño que cubría casi todo el cuerpo.</char></note></para>
  <para style="q" vid="PSA 35:2">Y levántate en mi ayuda!<verse eid="PSA 35:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 35:3"/>Saca la lanza y cierra el paso a mis perseguidores.</para>
  <para style="q" vid="PSA 35:3">Dí a mi alma: ¡Yo soy tu Salvación!<verse eid="PSA 35:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 35:4"/>Sean avergonzados y confundidos</para>
  <para style="q" vid="PSA 35:4">Los que buscan mi vida.</para>
  <para style="q" vid="PSA 35:4">Sean vueltos atrás y confundidos</para>
  <para style="q" vid="PSA 35:4">Los que traman mi mal.<verse eid="PSA 35:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 35:5"/>Sean como la cáscara de grano arrebatada por el viento,</para>
  <para style="q" vid="PSA 35:5">Y acóselos el Ángel de <char style="nd">Yavé</char>.<verse eid="PSA 35:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 35:6"/>Sea su camino tenebroso y resbaladizo,</para>
  <para style="q" vid="PSA 35:6">Y el Ángel de <char style="nd">Yavé</char> los persiga.<verse eid="PSA 35:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 35:7"/>Porque sin causa me tendieron su red,</para>
  <para style="q" vid="PSA 35:7">Sin motivo cavaron fosa para mi vida.<verse eid="PSA 35:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 35:8"/>Véngale destrucción inesperada.</para>
  <para style="q" vid="PSA 35:8">Atrápelo la red que él mismo tendió,</para>
  <para style="q" vid="PSA 35:8">Y caiga en ella con igual destrucción.<verse eid="PSA 35:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 35:9"/>Mi alma se deleitará en <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 35:9">Se regocijará en su salvación.<verse eid="PSA 35:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 35:10"/>Todos mis huesos dirán:</para>
  <para style="q" vid="PSA 35:10">Oh <char style="nd">Yavé</char>, ¿quién como Tú,</para>
  <para style="q" vid="PSA 35:10">Que libras al débil del que es demasiado fuerte para él,</para>
  <para style="q" vid="PSA 35:10">Y al pobre y menesteroso del que lo despoja?<verse eid="PSA 35:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 35:11"/>Se levantan testigos falsos</para>
  <para style="q" vid="PSA 35:11">De lo que no sé me preguntan.<verse eid="PSA 35:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 35:12"/>Me devuelven mal por bien</para>
  <para style="q" vid="PSA 35:12">Para desolación a mi alma.<verse eid="PSA 35:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 35:13"/>Yo en cambio, al estar ellos enfermos,</para>
  <para style="q" vid="PSA 35:13">Me vestía de ropa áspera</para>
  <para style="q" vid="PSA 35:13">Y afligía mi alma con ayuno,</para>
  <para style="q" vid="PSA 35:13">Hasta que mi súplica a favor de ellos me era concedida.<verse eid="PSA 35:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 35:14"/>Como por mi amigo o hermano actuaba,</para>
  <para style="q" vid="PSA 35:14">Como el que llora por su madre,</para>
  <para style="q" vid="PSA 35:14">Afligido me humillaba.<verse eid="PSA 35:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 35:15"/>Pero ellos, en mi adversidad se alegraron,</para>
  <para style="q" vid="PSA 35:15">Y se reunieron contra mí.</para>
  <para style="q" vid="PSA 35:15">Atacantes se reunieron contra mí,</para>
  <para style="q" vid="PSA 35:15">Y yo no lo entendía.</para>
  <para style="q" vid="PSA 35:15">Me despedazaban sin cesar.<verse eid="PSA 35:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 35:16"/>Como profanos burladores en las fiestas</para>
  <para style="q" vid="PSA 35:16">Rechinaron contra mí sus dientes.<verse eid="PSA 35:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 35:17"/>Oh <char style="nd">ʼAdonay</char>, ¿hasta cuándo consentirás esto?</para>
  <para style="q" vid="PSA 35:17">¡Libra mi vida de sus destrucciones,</para>
  <para style="q" vid="PSA 35:17">Mi única vida de los leones!<verse eid="PSA 35:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 35:18"/>Yo te daré gracias en la gran congregación,</para>
  <para style="q" vid="PSA 35:18">Te alabaré entre un pueblo numeroso.<verse eid="PSA 35:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 35:19"/>No se alegren de mí los que sin causa son mis enemigos,</para>
  <para style="q" vid="PSA 35:19">Ni guiñan el ojo los que me aborrecen sin causa.<verse eid="PSA 35:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 35:20"/>Por cuanto no hablan de paz,</para>
  <para style="q" vid="PSA 35:20">Sino inventan palabras calumniosas contra los mansos de la tierra.<verse eid="PSA 35:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 35:21"/>Ensanchan su boca contra mí, y dicen:<verse eid="PSA 35:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 35:22"/>¡Oh <char style="nd">Yavé</char>, Tú lo viste! ¡No calles!</para>
  <para style="q" vid="PSA 35:22">¡Oh <char style="nd">ʼAdonay</char>, no estés lejos de mí!<verse eid="PSA 35:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 35:23"/>¡Despierta y levántate a hacer justicia, <char style="nd">ʼElohim</char> mío y <char style="nd">ʼAdonay </char>mío!<verse eid="PSA 35:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 35:24"/>Júzgame conforme a tu justicia, oh <char style="nd">Yavé ʼElohim</char> mío,</para>
  <para style="q" vid="PSA 35:24">Que no se alegren ellos de mí.<verse eid="PSA 35:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 35:25"/>No digan ellos en su corazón:</para>
  <para style="q" vid="PSA 35:25">¡Ajá, aquí está lo que queríamos!</para>
  <para style="q" vid="PSA 35:25">No digan: ¡Lo devoramos!<verse eid="PSA 35:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PSA 35:26"/>Sean avergonzados y confundidos juntos</para>
  <para style="q" vid="PSA 35:26">Los que de mi mal se alegran.</para>
  <para style="q" vid="PSA 35:26">Vístanse de vergüenza y deshonor</para>
  <para style="q" vid="PSA 35:26">Los que se engrandecen sobre mí.<verse eid="PSA 35:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 35:27"/>Canten de júbilo y alégrense los que favorecen mi justicia,</para>
  <para style="q" vid="PSA 35:27">Y digan continuamente:</para>
  <para style="q" vid="PSA 35:27">¡Engrandecido sea <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 35:27">Quien se complace en la prosperidad de su esclavo!<verse eid="PSA 35:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 35:28"/>Mi lengua hablará de tu justicia y de tu alabanza todo el día.<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="s1">Al director del coro. Salmo de David, esclavo de Yavé</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 36:1"/>La transgresión del impío habla a su corazón.</para>
  <para style="q" vid="PSA 36:1">No hay temor a <char style="nd">ʼElohim</char> delante de sus ojos.<verse eid="PSA 36:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 36:2"/>Se jacta ante sus propios ojos</para>
  <para style="q" vid="PSA 36:2">De que su iniquidad no será descubierta ni aborrecida.<verse eid="PSA 36:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 36:3"/>Las palabras de su boca son iniquidad y engaño.</para>
  <para style="q" vid="PSA 36:3">Dejó de ser sabio, de hacer el bien.<verse eid="PSA 36:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 36:4"/>Trama iniquidad sobre su cama.</para>
  <para style="q" vid="PSA 36:4">Se mantiene en camino no bueno.</para>
  <para style="q" vid="PSA 36:4">No aborrece lo malo.<verse eid="PSA 36:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 36:5"/>Oh <char style="nd">Yavé</char>, tu misericordia llega hasta el cielo,</para>
  <para style="q" vid="PSA 36:5">Y hasta las nubes tu fidelidad.<verse eid="PSA 36:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 36:6"/>Tu justicia es como las montañas de <char style="nd">ʼEL,</char><note caller="+" style="f"><char style="fr" closed="false">36.6 </char><char style="ft" closed="false"><char style="nd">ʼEL </char>es un nombre de <char style="nd">ʼElohim</char>.</char></note></para>
  <para style="q" vid="PSA 36:6">Tus juicios, como inmenso abismo.</para>
  <para style="q" vid="PSA 36:6">Tú, oh <char style="nd">Yavé</char>, preservas al hombre y la bestia.<verse eid="PSA 36:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 36:7"/>¡Oh <char style="nd">ʼElohim</char>, cuán preciosa es tu misericordia!</para>
  <para style="q" vid="PSA 36:7">Por eso los hombres se amparan bajo la sombra de tus alas.<verse eid="PSA 36:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 36:8"/>Son plenamente saciados con la abundancia de tu casa,</para>
  <para style="q" vid="PSA 36:8">Les das de beber del torrente de tus delicias.<verse eid="PSA 36:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 36:9"/>Porque contigo está el manantial de la vida.</para>
  <para style="q" vid="PSA 36:9">En tu luz vemos la luz.<verse eid="PSA 36:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 36:10"/>Extiende tu misericordia a los que te conocen,</para>
  <para style="q" vid="PSA 36:10">Y tu justicia a los rectos de corazón.<verse eid="PSA 36:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 36:11"/>No me alcance el pie de la soberbia,</para>
  <para style="q" vid="PSA 36:11">Ni me mueva la mano del inicuo.<verse eid="PSA 36:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 36:12"/>Ahí cayeron los que obran iniquidad,</para>
  <para style="q" vid="PSA 36:12">Fueron derribados,</para>
  <para style="q" vid="PSA 36:12">Y no pueden levantarse.<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="s1">Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 37:1"/>No te impacientes a causa de los malignos,</para>
  <para style="q" vid="PSA 37:1">Ni tengas envidia de los que hacen iniquidad.<verse eid="PSA 37:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 37:2"/>Porque como hierba, serán pronto marchitados,</para>
  <para style="q" vid="PSA 37:2">Y como la hierba verde se secarán.<verse eid="PSA 37:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 37:3"/>Confía en <char style="nd">Yavé</char> y practica el bien.</para>
  <para style="q" vid="PSA 37:3">Así vivirás en la tierra y te apacentarás de la fidelidad.<verse eid="PSA 37:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 37:4"/>Deléitate también en <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 37:4">Y Él te dará los deseos de tu corazón.<verse eid="PSA 37:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 37:5"/>Encomienda a <char style="nd">Yavé</char> tu camino,</para>
  <para style="q" vid="PSA 37:5">Confía en Él,</para>
  <para style="q" vid="PSA 37:5">Y Él hará.<verse eid="PSA 37:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 37:6"/>Exhibirá tu justicia como la luz,</para>
  <para style="q" vid="PSA 37:6">Y tu derecho como el mediodía.<verse eid="PSA 37:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 37:7"/>Guarda silencio ante <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 37:7">Y espéralo con paciencia.</para>
  <para style="q" vid="PSA 37:7">No te impacientes a causa del que prospera en su camino,</para>
  <para style="q" vid="PSA 37:7">A causa del hombre que maquina perversidades.<verse eid="PSA 37:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 37:8"/>Deja la ira, desecha el enojo,</para>
  <para style="q" vid="PSA 37:8">No te excites de alguna manera a hacer el mal.<verse eid="PSA 37:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 37:9"/>Porque los perversos serán cortados,</para>
  <para style="q" vid="PSA 37:9">Pero los que esperan en <char style="nd">Yavé</char> heredarán la tierra.<verse eid="PSA 37:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 37:10"/>Pues dentro de poco el perverso no existirá.</para>
  <para style="q" vid="PSA 37:10">Examinarás con diligencia su lugar, y no estará allí.<verse eid="PSA 37:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 37:11"/>Pero los mansos poseerán la tierra,</para>
  <para style="q" vid="PSA 37:11">Y se deleitarán con abundante paz.<verse eid="PSA 37:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 37:12"/>Maquina el inicuo contra el justo,</para>
  <para style="q" vid="PSA 37:12">Y cruje sus dientes contra él.<verse eid="PSA 37:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 37:13"/>
    <char style="nd">ʼAdonay </char>se ríe de él,</para>
  <para style="q" vid="PSA 37:13">Porque ve que le llega su día.<verse eid="PSA 37:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 37:14"/>Los impíos desenvainaron espada y tensaron su arco</para>
  <para style="q" vid="PSA 37:14">Para derribar al pobre y al menesteroso,</para>
  <para style="q" vid="PSA 37:14">Para matar a los rectos de conducta.<verse eid="PSA 37:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 37:15"/>Su espada penetrará en su propio corazón,</para>
  <para style="q" vid="PSA 37:15">Y sus arcos serán quebrados.<verse eid="PSA 37:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 37:16"/>Mejor es lo poco del justo,</para>
  <para style="q" vid="PSA 37:16">Que la abundancia de muchos perversos.<verse eid="PSA 37:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 37:17"/>Porque los brazos de los perversos serán quebrados,</para>
  <para style="q" vid="PSA 37:17">Pero <char style="nd">Yavé</char> sostiene a los justos.<verse eid="PSA 37:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 37:18"/>
    <char style="nd">Yavé</char> conoce los días de los íntegros,</para>
  <para style="q" vid="PSA 37:18">Y la heredad de ellos será eterna.<verse eid="PSA 37:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 37:19"/>No serán avergonzados en tiempo adverso,</para>
  <para style="q" vid="PSA 37:19">Y en días de hambre serán saciados.<verse eid="PSA 37:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 37:20"/>Pero los perversos perecerán.</para>
  <para style="q" vid="PSA 37:20">Los enemigos de <char style="nd">Yavé</char> serán consumidos</para>
  <para style="q" vid="PSA 37:20">Como el verdor de los prados.</para>
  <para style="q" vid="PSA 37:20">Desvanecerán como el humo.<verse eid="PSA 37:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 37:21"/>El perverso toma prestado y no paga,</para>
  <para style="q" vid="PSA 37:21">Pero el justo es compasivo y da.<verse eid="PSA 37:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 37:22"/>Porque los benditos por Él heredarán la tierra,</para>
  <para style="q" vid="PSA 37:22">Pero los malditos por Él serán cortados.<verse eid="PSA 37:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 37:23"/>Por <char style="nd">Yavé</char> son establecidos los pasos del hombre</para>
  <para style="q" vid="PSA 37:23">En cuyo camino Él se deleita.<verse eid="PSA 37:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 37:24"/>Aunque caiga, no quedará postrado,</para>
  <para style="q" vid="PSA 37:24">Porque <char style="nd">Yavé</char> sostiene su mano.<verse eid="PSA 37:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PSA 37:25"/>Fui joven, y ahora soy anciano,</para>
  <para style="q" vid="PSA 37:25">Y no he visto justo desamparado,</para>
  <para style="q" vid="PSA 37:25">Ni a su descendencia que mendigue pan.<verse eid="PSA 37:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 37:26"/>En todo tiempo tiene misericordia, y presta,</para>
  <para style="q" vid="PSA 37:26">Y sus descendientes son para bendición.<verse eid="PSA 37:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PSA 37:27"/>Apártate del mal y practica la rectitud,</para>
  <para style="q" vid="PSA 37:27">Y vivirás para siempre.<verse eid="PSA 37:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 37:28"/>Porque <char style="nd">Yavé</char> ama la justicia,</para>
  <para style="q" vid="PSA 37:28">Y no desampara a sus piadosos.</para>
  <para style="q" vid="PSA 37:28">Para siempre son guardados sus santos,</para>
  <para style="q" vid="PSA 37:28">Pero la descendencia de los perversos será cortada.<verse eid="PSA 37:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PSA 37:29"/>Los justos heredarán la tierra,</para>
  <para style="q" vid="PSA 37:29">Y vivirán en ella para siempre.<verse eid="PSA 37:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PSA 37:30"/>La boca del justo expresa sabiduría y habla justicia.<verse eid="PSA 37:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 37:31"/>La Ley de su <char style="nd">ʼElohim</char> está en su corazón.</para>
  <para style="q" vid="PSA 37:31">Sus pasos no resbalan.<verse eid="PSA 37:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PSA 37:32"/>El perverso acecha al justo</para>
  <para style="q" vid="PSA 37:32">Y trata de matarlo.<verse eid="PSA 37:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 37:33"/>
    <char style="nd">Yavé</char> no lo dejará en su mano,</para>
  <para style="q" vid="PSA 37:33">Ni permitirá que sea condenado cuando sea juzgado.<verse eid="PSA 37:33"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="34" style="v" sid="PSA 37:34"/>Espera a <char style="nd">Yavé</char> y guarda tu camino.</para>
  <para style="q" vid="PSA 37:34">Él te exaltará para que poseas la tierra.</para>
  <para style="q" vid="PSA 37:34">Cuando los perversos sean cortados,</para>
  <para style="q" vid="PSA 37:34">Tú lo verás.<verse eid="PSA 37:34"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="35" style="v" sid="PSA 37:35"/>He visto al perverso en gran poder</para>
  <para style="q" vid="PSA 37:35">Extenderse como árbol frondoso en su propio suelo.<verse eid="PSA 37:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 37:36"/>Pero luego pasó y no fue más,</para>
  <para style="q" vid="PSA 37:36">Lo busqué, y no fue hallado.<verse eid="PSA 37:36"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="37" style="v" sid="PSA 37:37"/>Considera al hombre recto y mira al justo,</para>
  <para style="q" vid="PSA 37:37">Porque hay un final feliz para el hombre de paz.<verse eid="PSA 37:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 37:38"/>Pero los transgresores serán destruidos por completo.</para>
  <para style="q" vid="PSA 37:38">La posteridad de los perversos será cortada.<verse eid="PSA 37:38"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="39" style="v" sid="PSA 37:39"/>La salvación de los justos es de <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 37:39">Él es su Fortaleza en el tiempo de angustia.<verse eid="PSA 37:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 37:40"/>
    <char style="nd">Yavé</char> los ayuda y los libra.</para>
  <para style="q" vid="PSA 37:40">Los liberta de los perversos y los salva,</para>
  <para style="q" vid="PSA 37:40">Porque se refugian en Él.<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="s1">Salmo de David. En conmemoración</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 38:1"/>Oh <char style="nd">Yavé</char>, no me reprendas con tu indignación,</para>
  <para style="q" vid="PSA 38:1">Ni me castigues con tu ardiente ira.<verse eid="PSA 38:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 38:2"/>Porque tus flechas se clavaron en mí,</para>
  <para style="q" vid="PSA 38:2">Y tu mano descendió sobre mí.<verse eid="PSA 38:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 38:3"/>Nada íntegro hay en mi cuerpo a causa de tu indignación,</para>
  <para style="q" vid="PSA 38:3">Ni hay paz en mis huesos a causa de mi pecado.<verse eid="PSA 38:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 38:4"/>Porque mis iniquidades sobrepasan mi cabeza,</para>
  <para style="q" vid="PSA 38:4">Y como pesada carga se agravan sobre mí.<verse eid="PSA 38:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 38:5"/>Mis heridas hieden y supuran por causa de mi locura.<verse eid="PSA 38:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 38:6"/>Estoy encorvado y abatido en gran manera.</para>
  <para style="q" vid="PSA 38:6">Todo el día ando ensombrecido<verse eid="PSA 38:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 38:7"/>Porque mis órganos internos están llenos de ardor,</para>
  <para style="q" vid="PSA 38:7">Y nada sano hay en mi cuerpo.<verse eid="PSA 38:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 38:8"/>Estoy debilitado y molido en extremo.</para>
  <para style="q" vid="PSA 38:8">Gimo a causa de la perturbación de mi corazón.<verse eid="PSA 38:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 38:9"/>¡Oh <char style="nd">ʼAdonay</char>, ante Ti está todo mi deseo,</para>
  <para style="q" vid="PSA 38:9">Y mi suspiro no te es oculto!<verse eid="PSA 38:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 38:10"/>Mi corazón palpita, me falta el vigor,</para>
  <para style="q" vid="PSA 38:10">Y aun la luz de mis ojos me falta.<verse eid="PSA 38:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 38:11"/>Mis amigos y mis compañeros están lejos de mi herida.</para>
  <para style="q" vid="PSA 38:11">Mis allegados permanecen a distancia.<verse eid="PSA 38:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 38:12"/>Los que buscan mi vida</para>
  <para style="q" vid="PSA 38:12">Me arman trampas.</para>
  <para style="q" vid="PSA 38:12">Los que procuran ofenderme</para>
  <para style="q" vid="PSA 38:12">Me amenazan con destrucción y traman fraudes todo el día.<verse eid="PSA 38:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 38:13"/>Pero yo, como si fuera sordo no escucho,</para>
  <para style="q" vid="PSA 38:13">Y soy como un mudo, que no abre su boca.<verse eid="PSA 38:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 38:14"/>Sí, soy como un hombre que no oye,</para>
  <para style="q" vid="PSA 38:14">Y en cuya boca no hay respuesta.<verse eid="PSA 38:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 38:15"/>Porque en Ti, oh <char style="nd">Yavé</char>, espero.</para>
  <para style="q" vid="PSA 38:15">Tú, <char style="nd">ʼAdonay</char>, mi <char style="nd">ʼElohim</char>, me responderás.<verse eid="PSA 38:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 38:16"/>Porque dije: No se alegren de mí.</para>
  <para style="q" vid="PSA 38:16">No se engrandezcan contra mí cuando mi pie resbale,<verse eid="PSA 38:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 38:17"/>Porque estoy a punto de caer</para>
  <para style="q" vid="PSA 38:17">Y mi dolor está continuamente ante mí.<verse eid="PSA 38:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 38:18"/>Por tanto, confieso mi iniquidad.</para>
  <para style="q" vid="PSA 38:18">Me contristé por mi pecado.<verse eid="PSA 38:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 38:19"/>Pero mis enemigos son vigorosos y fuertes,</para>
  <para style="q" vid="PSA 38:19">Y se aumentaron los que me aborrecen sin causa.<verse eid="PSA 38:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 38:20"/>Los que pagan mal por bien me son hostiles,</para>
  <para style="q" vid="PSA 38:20">Porque sigo lo bueno.<verse eid="PSA 38:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 38:21"/>¡No me desampares, oh <char style="nd">Yavé</char>, mi <char style="nd">ʼElohim</char>!</para>
  <para style="q" vid="PSA 38:21">¡No te alejes de mí!<verse eid="PSA 38:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 38:22"/>¡Apresúrate a socorrerme, oh <char style="nd">ʼAdonay</char>, salvación mía!<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="s1">Al director del coro, para Jedutún.<note caller="+" style="f"><char style="fr" closed="false">39.1 </char><char style="ft" closed="false">Jedutún era un levita instructor.</char></note> Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 39:1"/>Dije: Guardaré mis caminos para no pecar con mi boca.</para>
  <para style="q" vid="PSA 39:1">Llevaré mordaza en mi boca</para>
  <para style="q" vid="PSA 39:1">Mientras los perversos estén frente a mí.<verse eid="PSA 39:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 39:2"/>Enmudecí con silencio.</para>
  <para style="q" vid="PSA 39:2">Me callé, aun en cuanto a lo bueno,</para>
  <para style="q" vid="PSA 39:2">Y se agravó mi dolor.<verse eid="PSA 39:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 39:3"/>Mi corazón se enardeció.</para>
  <para style="q" vid="PSA 39:3">En mi meditación ardió el fuego.</para>
  <para style="b" vid="PSA 39:3"/>
  <para style="q" vid="PSA 39:3">
    <char style="add">Entonces</char> hablé con mi lengua:<verse eid="PSA 39:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 39:4"/>Oh <char style="nd">Yavé</char>, dime mi final,</para>
  <para style="q" vid="PSA 39:4">Cuál es la medida de mis días.</para>
  <para style="q" vid="PSA 39:4">Permíteme saber cuán pasajero soy.<verse eid="PSA 39:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 39:5"/>En verdad, diste a mis días término corto,</para>
  <para style="q" vid="PSA 39:5">Y mi edad es como nada ante Ti.</para>
  <para style="q" vid="PSA 39:5">Ciertamente es completa vanidad todo hombre que vive. <char style="tl">Selah</char><verse eid="PSA 39:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 39:6"/>Ciertamente como un fantasma de realidad anda el hombre,</para>
  <para style="q" vid="PSA 39:6">Ciertamente en vano se agita,</para>
  <para style="q" vid="PSA 39:6">Amontona riquezas y no sabe quién las recogerá.<verse eid="PSA 39:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 39:7"/>Y ahora, <char style="nd">ʼAdonay</char>, ¿qué espero?</para>
  <para style="q" vid="PSA 39:7">Mi esperanza está en Ti.<verse eid="PSA 39:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 39:8"/>Líbrame de todas mis transgresiones.</para>
  <para style="q" vid="PSA 39:8">No me coloques como escarnio de los necios.<verse eid="PSA 39:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 39:9"/>Enmudecí, no abrí mi boca,</para>
  <para style="q" vid="PSA 39:9">Porque Tú lo dispusiste.<verse eid="PSA 39:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 39:10"/>Quita de sobre mí tu azote,</para>
  <para style="q" vid="PSA 39:10">Porque perezco por el golpe de tu mano.<verse eid="PSA 39:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 39:11"/>Corriges al hombre con castigos por su iniquidad.</para>
  <para style="q" vid="PSA 39:11">Como polilla carcomes lo que es precioso para él.</para>
  <para style="q" vid="PSA 39:11">Ciertamente todo hombre es solo un soplo. <char style="tl">Selah</char><verse eid="PSA 39:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 39:12"/>Escucha mi oración, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 39:12">Y presta oído a mi clamor.</para>
  <para style="q" vid="PSA 39:12">No guardes silencio ante mis lágrimas,</para>
  <para style="q" vid="PSA 39:12">Porque soy un forastero ante Ti,</para>
  <para style="q" vid="PSA 39:12">Y un advenedizo como todos mis antepasados.<verse eid="PSA 39:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 39:13"/>Aparta de mí tu mirada para que yo sonría,</para>
  <para style="q" vid="PSA 39:13">Antes que yo parta y no exista más.<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="s1">Al director del coro. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 40:1"/>Pacientemente esperé a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 40:1">Y se inclinó hacia mí y escuchó mi clamor.<verse eid="PSA 40:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 40:2"/>Me sacó del pozo de la desesperación, del lodo cenagoso.</para>
  <para style="q" vid="PSA 40:2">Asentó mis pies sobre una roca y afirmó mis pasos.<verse eid="PSA 40:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 40:3"/>Puso en mi boca un canto nuevo,</para>
  <para style="q" vid="PSA 40:3">Alabanza a nuestro <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 40:3">Muchos verán esto.</para>
  <para style="q" vid="PSA 40:3">Temerán y confiarán en <char style="nd">Yavé</char><verse eid="PSA 40:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 40:4"/>¡Cuán bendecido es el varón quien fijó en <char style="nd">Yavé</char> su confianza,</para>
  <para style="q" vid="PSA 40:4">Que no mira a los soberbios</para>
  <para style="q" vid="PSA 40:4">Ni a los que se desvían hacia la falsedad!<verse eid="PSA 40:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 40:5"/>¡Oh <char style="nd">Yavé</char>, mi <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 40:5">Aumentaste tus maravillas y tus designios para nosotros!</para>
  <para style="q" vid="PSA 40:5">¡Nadie puede compararse contigo!</para>
  <para style="q" vid="PSA 40:5">Si los anuncio y hablo de ellos,</para>
  <para style="q" vid="PSA 40:5">No pueden ser enumerados.<verse eid="PSA 40:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 40:6"/>Sacrificio y ofrenda no te agradan.</para>
  <para style="q" vid="PSA 40:6">Abriste mis oídos.</para>
  <para style="q" vid="PSA 40:6">No demandas holocausto y sacrificio que apacigua.<verse eid="PSA 40:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 40:7"/>Entonces dije: Aquí vengo.</para>
  <para style="q" vid="PSA 40:7">En la cabecilla del rollo está escrito acerca de Mí.<verse eid="PSA 40:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 40:8"/>Oh mi <char style="nd">ʼElohim</char>, hacer tu voluntad me agrada,</para>
  <para style="q" vid="PSA 40:8">Y tu Ley está dentro de mi corazón.<verse eid="PSA 40:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 40:9"/>Anuncié justicia en la gran congregación.</para>
  <para style="q" vid="PSA 40:9">Ciertamente no refrené mis labios.</para>
  <para style="q" vid="PSA 40:9">Tú lo sabes, oh Yavé,<verse eid="PSA 40:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 40:10"/>Ni encubrí tu justicia dentro de mi corazón.</para>
  <para style="q" vid="PSA 40:10">He proclamado tu fidelidad y tu salvación.</para>
  <para style="q" vid="PSA 40:10">No oculté de la gran congregación tu misericordia y tu verdad.<verse eid="PSA 40:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 40:11"/>Tú, oh <char style="nd">Yavé</char>, no retengas de mí tu compasión.</para>
  <para style="q" vid="PSA 40:11">Que tu misericordia y tu verdad me guarden siempre.<verse eid="PSA 40:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 40:12"/>Porque me rodearon calamidades incontables.</para>
  <para style="q" vid="PSA 40:12">Me alcanzaron mis iniquidades,</para>
  <para style="q" vid="PSA 40:12">Y no puedo levantar la vista.</para>
  <para style="q" vid="PSA 40:12">Son más numerosas que los cabellos de mi cabeza,</para>
  <para style="q" vid="PSA 40:12">Y mi corazón me falla.<verse eid="PSA 40:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 40:13"/>¡Oh <char style="nd">Yavé</char>, complácete en librarme!</para>
  <para style="q" vid="PSA 40:13">¡Apresúrate, oh <char style="nd">Yavé</char>, a socorrerme!<verse eid="PSA 40:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 40:14"/>¡Sean avergonzados y humillados</para>
  <para style="q" vid="PSA 40:14">Los que buscan mi vida para destruirla!</para>
  <para style="q" vid="PSA 40:14">Sean vueltos atrás y deshonrados</para>
  <para style="q" vid="PSA 40:14">Los que se deleitan en mi calamidad.<verse eid="PSA 40:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 40:15"/>Queden consternados a causa de su vergüenza</para>
  <para style="q" vid="PSA 40:15">Los que me dicen: ¡Ea, ea!<verse eid="PSA 40:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 40:16"/>¡Regocíjense y alégrense en Ti todos los que te buscan!</para>
  <para style="q" vid="PSA 40:16">Digan siempre los que aman tu salvación:</para>
  <para style="q" vid="PSA 40:16">¡Engrandecido sea <char style="nd">Yavé</char>!<verse eid="PSA 40:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 40:17"/>Aunque estoy afligido y necesitado,</para>
  <para style="q" vid="PSA 40:17">
    <char style="nd">ʼAdonay </char>pensará en mí.</para>
  <para style="q" vid="PSA 40:17">Tú eres mi ayuda y mi Libertador.</para>
  <para style="q" vid="PSA 40:17">¡Mi <char style="nd">ʼElohim</char>, no te tardes!<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="s1">Al director del coro. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 41:1"/>¡Oh cuán bendecido es el que piensa en el pobre!</para>
  <para style="q" vid="PSA 41:1">En el día malo <char style="nd">Yavé</char> lo librará.<verse eid="PSA 41:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 41:2"/>
    <char style="nd">Yavé</char> lo protegerá y le dará vida.</para>
  <para style="q" vid="PSA 41:2">Será bendito en la tierra,</para>
  <para style="q" vid="PSA 41:2">Y no lo entregarás a la voluntad de sus enemigos.<verse eid="PSA 41:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 41:3"/>
    <char style="nd">Yavé</char> lo sustentará en el lecho de dolor.</para>
  <para style="q" vid="PSA 41:3">En su enfermedad suavizarás su cama.<verse eid="PSA 41:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 41:4"/>Dije yo: Oh <char style="nd">Yavé</char>, ten compasión de mí.</para>
  <para style="q" vid="PSA 41:4">Sana mi alma, porque pequé contra Ti.<verse eid="PSA 41:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 41:5"/>Mis enemigos hablan mal de mí y preguntan:</para>
  <para style="q" vid="PSA 41:5">¿Cuándo morirá y perecerá su nombre?<verse eid="PSA 41:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 41:6"/>Cuando viene a verme, habla falsedad.</para>
  <para style="q" vid="PSA 41:6">Su corazón recoge perversidades.</para>
  <para style="q" vid="PSA 41:6">Cuando sale las divulga.<verse eid="PSA 41:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 41:7"/>Todos los que me aborrecen murmuran reunidos contra mí.</para>
  <para style="q" vid="PSA 41:7">Maquinan la perversidad contra mí y dicen:<verse eid="PSA 41:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 41:8"/>Algo perverso fue derramado sobre él.</para>
  <para style="q" vid="PSA 41:8">Cuando caiga en cama, no volverá a levantarse.<verse eid="PSA 41:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 41:9"/>Aun el hombre de mi paz en quien yo confiaba,</para>
  <para style="q" vid="PSA 41:9">Que comía de mi pan,</para>
  <para style="q" vid="PSA 41:9">Levantó contra mí su talón.<verse eid="PSA 41:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 41:10"/>Pero Tú, oh <char style="nd">Yavé</char>, ten compasión de mí.</para>
  <para style="q" vid="PSA 41:10">Levántame para que le dé recompensa.<verse eid="PSA 41:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 41:11"/>En esto sé que te complaces en mí:</para>
  <para style="q" vid="PSA 41:11">En que mi enemigo no proclame triunfo sobre mí.<verse eid="PSA 41:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 41:12"/>En cuanto a mí, en mi integridad me sostienes,</para>
  <para style="q" vid="PSA 41:12">Y me establecerás en tu Presencia para siempre.<verse eid="PSA 41:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 41:13"/>¡Bendito sea <char style="nd">Yavé</char> el <char style="nd">ʼElohim</char> de Israel,</para>
  <para style="q" vid="PSA 41:13">Desde la eternidad y hasta la eternidad! ¡Amén y amén!<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="s1">Al director del coro. Instrucción (<char style="tl">Maskil</char>) de los hijos de Coré</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 42:1"/>Como el venado anhela las corrientes de agua,</para>
  <para style="q" vid="PSA 42:1">Así, oh <char style="nd">ʼElohim</char>, te anhela mi alma.<verse eid="PSA 42:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 42:2"/>Mi alma tiene sed de <char style="nd">ʼEL,</char> del <char style="nd">ʼElohim</char> vivo.</para>
  <para style="q" vid="PSA 42:2">¿Cuándo iré y apareceré ante <char style="nd">ʼElohim</char>?<verse eid="PSA 42:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 42:3"/>Mis lágrimas fueron mi alimento día y noche,</para>
  <para style="q" vid="PSA 42:3">Mientras me dicen todos los días:</para>
  <para style="q" vid="PSA 42:3">¿Dónde está tu <char style="nd">ʼElohim</char>?<verse eid="PSA 42:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 42:4"/>Me acuerdo de estas cosas,</para>
  <para style="q" vid="PSA 42:4">Y derramo mi alma dentro de mí.</para>
  <para style="q" vid="PSA 42:4">Porque yo marchaba con la multitud</para>
  <para style="q" vid="PSA 42:4">Y la conducía a la Casa de <char style="nd">ʼElohim</char></para>
  <para style="q" vid="PSA 42:4">Con voz de júbilo y acción de gracias,</para>
  <para style="q" vid="PSA 42:4">De una multitud en fiesta solemne.<verse eid="PSA 42:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 42:5"/>¿Por qué te abates, oh alma mía,</para>
  <para style="q" vid="PSA 42:5">Y te turbas dentro de mí?</para>
  <para style="q" vid="PSA 42:5">Espera a <char style="nd">ʼElohim</char>, porque aún lo alabaré.</para>
  <para style="q" vid="PSA 42:5">¡Por la ayuda de su presencia!<verse eid="PSA 42:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 42:6"/>Oh <char style="nd">ʼElohim</char>, mi alma está abatida dentro de mí.</para>
  <para style="q" vid="PSA 42:6">Por tanto, me acordaré de Ti desde la tierra del Jordán,</para>
  <para style="q" vid="PSA 42:6">Y desde las cumbres de Hermón, desde la montaña Mizar.<verse eid="PSA 42:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 42:7"/>Un abismo llama a otro con la voz de tus cascadas,</para>
  <para style="q" vid="PSA 42:7">Todas tus ondas y tus olas pasaron sobre mí.<verse eid="PSA 42:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 42:8"/>De día <char style="nd">Yavé</char> enviará su misericordia,</para>
  <para style="q" vid="PSA 42:8">Y de noche su canto estará conmigo,</para>
  <para style="q" vid="PSA 42:8">Una oración al <char style="nd">ʼEL</char> de mi vida.<verse eid="PSA 42:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 42:9"/>Diré a <char style="nd">ʼEL</char>: Roca mía, ¿por qué te olvidaste de mí?</para>
  <para style="q" vid="PSA 42:9">¿Por qué ando enlutado a causa de la opresión del enemigo?<verse eid="PSA 42:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 42:10"/>Como el que quebranta mis huesos,</para>
  <para style="q" vid="PSA 42:10">Mis enemigos me afrentan</para>
  <para style="q" vid="PSA 42:10">Mientras me dicen cada día:</para>
  <para style="q" vid="PSA 42:10">¿Dónde está tu <char style="nd">ʼElohim</char>?<verse eid="PSA 42:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 42:11"/>¿Por qué te abates, alma mía, y gimes dentro de mí?</para>
  <para style="q" vid="PSA 42:11">Espera a <char style="nd">ʼElohim</char>, porque aún lo alabaré.</para>
  <para style="q" vid="PSA 42:11">¡Salvación mía y <char style="nd">ʼElohim</char> mío!<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 43:1"/>Júzgame, oh <char style="nd">ʼElohim</char>, y defiende mi causa.</para>
  <para style="q" vid="PSA 43:1">Líbrame de gente impía, del hombre engañador y perverso.<verse eid="PSA 43:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 43:2"/>Porque Tú eres el <char style="nd">ʼElohim</char> de mi fortaleza.</para>
  <para style="b" vid="PSA 43:2"/>
  <para style="q" vid="PSA 43:2">¿Por qué me desechaste?</para>
  <para style="q" vid="PSA 43:2">¿Por qué ando enlutado a causa de la opresión del enemigo?<verse eid="PSA 43:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 43:3"/>Envía tu luz y tu verdad.</para>
  <para style="q" vid="PSA 43:3">Éstas me guiarán.</para>
  <para style="q" vid="PSA 43:3">Ellas me conducirán a tu Montaña Santa y a tus moradas.<verse eid="PSA 43:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 43:4"/>Entonces iré al altar de <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 43:4">Al <char style="nd">ʼEL</char> de mi alegría y regocijo,</para>
  <para style="q" vid="PSA 43:4">Y te alabaré con el arpa, oh <char style="nd">ʼElohim</char>, mi <char style="nd">ʼElohim</char>.<verse eid="PSA 43:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 43:5"/>¿Por qué te abates, oh alma mía,</para>
  <para style="q" vid="PSA 43:5">Y por qué te turbas dentro de mí?</para>
  <para style="b" vid="PSA 43:5"/>
  <para style="q" vid="PSA 43:5">Espera a <char style="nd">ʼElohim</char>, porque aún lo alabaré.</para>
  <para style="q" vid="PSA 43:5">¡El Ayudador de mi presencia y mi <char style="nd">ʼElohim</char>!<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="s1">Al director del coro. Instrucción (<char style="tl">Maskil</char>) de los hijos de Coré</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 44:1"/>Oh <char style="nd">ʼElohim</char>, escuchamos con nuestros oídos,</para>
  <para style="q" vid="PSA 44:1">Nos contaron nuestros antepasados</para>
  <para style="q" vid="PSA 44:1">Las obras que Tú hiciste en sus días,</para>
  <para style="q" vid="PSA 44:1">En los tiempos antiguos.<verse eid="PSA 44:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 44:2"/>Con tu mano expulsaste a las naciones</para>
  <para style="q" vid="PSA 44:2">Para establecerlos a ellos.</para>
  <para style="q" vid="PSA 44:2">Abatiste a los pueblos y los echaste.<verse eid="PSA 44:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 44:3"/>No poseyeron la tierra por su espada,</para>
  <para style="q" vid="PSA 44:3">Ni los libró su brazo,</para>
  <para style="q" vid="PSA 44:3">Sino tu mano derecha, tu brazo y la luz de tu rostro,</para>
  <para style="q" vid="PSA 44:3">Porque te complaciste en ellos.<verse eid="PSA 44:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 44:4"/>Tú eres mi Rey, oh <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 44:4">¡Ordena las victorias de Jacob!<verse eid="PSA 44:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 44:5"/>Por medio de Ti sacudiremos a nuestros enemigos.</para>
  <para style="q" vid="PSA 44:5">En tu Nombre pisotearemos a los que se levantan contra nosotros.<verse eid="PSA 44:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 44:6"/>Porque no confiaré en mi arco,</para>
  <para style="q" vid="PSA 44:6">Ni mi espada me salvará.<verse eid="PSA 44:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 44:7"/>Pero Tú nos salvaste de nuestros adversarios</para>
  <para style="q" vid="PSA 44:7">Y avergonzaste a los que nos aborrecen.<verse eid="PSA 44:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 44:8"/>En <char style="nd">ʼElohim</char> nos gloriaremos todo el día</para>
  <para style="q" vid="PSA 44:8">Y alabaremos tu Nombre para siempre. <char style="tl">Selah</char><verse eid="PSA 44:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 44:9"/>Pero nos desechaste y nos avergonzaste.</para>
  <para style="q" vid="PSA 44:9">No sales con nuestros ejércitos.<verse eid="PSA 44:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 44:10"/>Nos haces retroceder del adversario.</para>
  <para style="q" vid="PSA 44:10">Los que nos aborrecen nos saquean.<verse eid="PSA 44:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 44:11"/>Nos entregas como ovejas para el matadero</para>
  <para style="q" vid="PSA 44:11">Y nos esparciste entre las naciones.<verse eid="PSA 44:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 44:12"/>Vendes a tu pueblo por nada.</para>
  <para style="q" vid="PSA 44:12">Ningún beneficio exiges por ellos.<verse eid="PSA 44:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 44:13"/>Nos convertiste en oprobio de nuestros vecinos,</para>
  <para style="q" vid="PSA 44:13">En escarnio y burla de los que nos rodean.<verse eid="PSA 44:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 44:14"/>Nos pusiste como refrán entre las naciones,</para>
  <para style="q" vid="PSA 44:14">Un objeto de burla en medio de los pueblos.<verse eid="PSA 44:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 44:15"/>Todo el día mi deshonor está delante de mí</para>
  <para style="q" vid="PSA 44:15">Y la confusión cubre mi cara,<verse eid="PSA 44:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 44:16"/>Por la voz del que me critica y deshonra</para>
  <para style="q" vid="PSA 44:16">Por causa del enemigo y del vengativo.<verse eid="PSA 44:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 44:17"/>Todo esto nos vino,</para>
  <para style="q" vid="PSA 44:17">Pero no nos olvidamos de Ti,</para>
  <para style="q" vid="PSA 44:17">Ni fuimos infieles a tu Pacto.<verse eid="PSA 44:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 44:18"/>Nuestro corazón no se volvió atrás,</para>
  <para style="q" vid="PSA 44:18">Ni nuestros pasos se desviaron de tu senda.<verse eid="PSA 44:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 44:19"/>Pero Tú nos aplastaste en un sitio de chacales,</para>
  <para style="q" vid="PSA 44:19">Y nos cubriste con la sombra de muerte.<verse eid="PSA 44:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 44:20"/>Si nos olvidamos del Nombre de nuestro <char style="nd">ʼElohim</char></para>
  <para style="q" vid="PSA 44:20">O alzamos nuestras manos a un <char style="tl">ʼelohim</char> extraño,<verse eid="PSA 44:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 44:21"/>¿<char style="nd">ʼElohim</char> no demandaría esto?</para>
  <para style="q" vid="PSA 44:21">Porque Él conoce los secretos del corazón.<verse eid="PSA 44:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 44:22"/>Pero por tu causa nos matan cada día.</para>
  <para style="q" vid="PSA 44:22">Somos considerados como ovejas para el matadero.<verse eid="PSA 44:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 44:23"/>Despiértate, <char style="nd">ʼAdonay</char>. ¿Por qué duermes?</para>
  <para style="q" vid="PSA 44:23">Despiértate, no nos rechaces para siempre.<verse eid="PSA 44:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 44:24"/>¿Por qué escondes tu rostro</para>
  <para style="q" vid="PSA 44:24">Y te olvidas de la aflicción y de nuestra opresión?<verse eid="PSA 44:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PSA 44:25"/>Porque nuestra alma está agobiada hasta el polvo</para>
  <para style="q" vid="PSA 44:25">Y nuestro cuerpo está pegado a la tierra.<verse eid="PSA 44:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 44:26"/>Levántate, sé nuestra Ayuda.</para>
  <para style="q" vid="PSA 44:26">Redímenos por tu misericordia.<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="s1">Al director del coro. Sobre lirios. Instrucción (<char style="tl">Maskil</char>) de los hijos de Coré. Canción de amor</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 45:1"/>Rebosa mi corazón palabra buena.</para>
  <para style="q" vid="PSA 45:1">Dirijo al Rey mi canto.</para>
  <para style="q" vid="PSA 45:1">Mi boca es como pluma de experto escriba.<verse eid="PSA 45:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 45:2"/>Eres el más hermoso de los hijos de los hombres.</para>
  <para style="q" vid="PSA 45:2">La gracia se derramó en tus labios.</para>
  <para style="q" vid="PSA 45:2">Por tanto, <char style="nd">ʼElohim</char> te bendijo para siempre.<verse eid="PSA 45:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 45:3"/>¡Átate tu espada a tu cintura, oh Guerrero,</para>
  <para style="q" vid="PSA 45:3">Con tu esplendor y con tu majestad!<verse eid="PSA 45:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 45:4"/>Cabalga en tu majestad</para>
  <para style="q" vid="PSA 45:4">Y triunfa por la causa de la verdad, la humildad y la justicia.</para>
  <para style="q" vid="PSA 45:4">Que tu mano derecha te enseñe cosas asombrosas.<verse eid="PSA 45:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 45:5"/>Tus flechas son agudas.</para>
  <para style="q" vid="PSA 45:5">Pueblos caen debajo de Ti.</para>
  <para style="q" vid="PSA 45:5">Tus flechas agudas penetrarán en el corazón de los enemigos del Rey.<verse eid="PSA 45:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 45:6"/>Tu trono, oh <char style="nd">ʼElohim</char>, es eterno y para siempre.</para>
  <para style="q" vid="PSA 45:6">Cetro<note caller="+" style="f"><char style="fr" closed="false">45.6 </char><char style="ft" closed="false">Cetro: Vara de oro labrada con primor que usaban los reyes como insignia de dignidad.</char></note> de justicia es el cetro de tu reino.<verse eid="PSA 45:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 45:7"/>Amaste la justicia y aborreciste la perversidad,</para>
  <para style="q" vid="PSA 45:7">Por tanto, te ungió <char style="nd">ʼElohim</char>, el <char style="nd">ʼElohim</char> tuyo,</para>
  <para style="q" vid="PSA 45:7">Con aceite de alegría más que a tus compañeros.<verse eid="PSA 45:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 45:8"/>Mirra, áloe y casia exhalan todas tus ropas.</para>
  <para style="q" vid="PSA 45:8">Desde los palacios de marfil te recrean instrumentos de cuerda.<verse eid="PSA 45:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 45:9"/>Hijas de reyes están entre tus honorables damas.</para>
  <para style="q" vid="PSA 45:9">A su mano derecha está la reina con oro de Ofir.<verse eid="PSA 45:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 45:10"/>Escucha, hija, atiende, e inclina tu oído.</para>
  <para style="q" vid="PSA 45:10">Olvida tu pueblo y la casa de tu padre.<verse eid="PSA 45:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 45:11"/>Deseará el Rey tu hermosura.</para>
  <para style="q" vid="PSA 45:11">E inclínate ante Él, porque Él es tu <char style="nd">ʼAdonay</char>.<verse eid="PSA 45:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 45:12"/>La hija de Tiro vendrá con un presente.</para>
  <para style="q" vid="PSA 45:12">Los ricos entre los pueblos buscarán tu favor.<verse eid="PSA 45:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 45:13"/>Toda gloriosa es la princesa en su palacio.</para>
  <para style="q" vid="PSA 45:13">Entretejida de oro es su ropa.<verse eid="PSA 45:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 45:14"/>Con ropas bordadas será llevada ante el Rey.</para>
  <para style="q" vid="PSA 45:14">Con compañeras vírgenes que irán tras ella</para>
  <para style="q" vid="PSA 45:14">Será llevada a Ti.<verse eid="PSA 45:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 45:15"/>Serán llevadas con alegría y regocijo.</para>
  <para style="q" vid="PSA 45:15">Entrarán en el palacio del Rey.<verse eid="PSA 45:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 45:16"/>En lugar de tus padres estarán tus hijos,</para>
  <para style="q" vid="PSA 45:16">A quienes harás príncipes en toda la tierra.<verse eid="PSA 45:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 45:17"/>Haré perpetua la memoria de tu nombre en todas las generaciones,</para>
  <para style="q" vid="PSA 45:17">Por lo cual los pueblos te darán gracias eternamente y para siempre.<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="s1">Al director del coro. Salmo de los hijos de Coré, sobre instrumentos de tonos altos. Canto</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 46:1"/>
    <char style="nd">ʼElohim</char> es nuestro Refugio y Fortaleza,</para>
  <para style="q" vid="PSA 46:1">Un auxilio muy presente en la tribulación.<verse eid="PSA 46:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 46:2"/>Por tanto, no temeremos aunque la tierra sea removida,</para>
  <para style="q" vid="PSA 46:2">Y las montañas se traspasen al corazón del mar,<verse eid="PSA 46:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 46:3"/>Aunque bramen y espumen sus aguas,</para>
  <para style="q" vid="PSA 46:3">Y tiemblen las montañas a causa de su ímpetu. <char style="tl">Selah</char><verse eid="PSA 46:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 46:4"/>Hay un río cuyas corrientes alegran la ciudad de <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 46:4">El Santuario, morada del <char style="nd">ʼElyón</char>.<verse eid="PSA 46:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 46:5"/>
    <char style="nd">ʼElohim</char> está en medio de ella.</para>
  <para style="q" vid="PSA 46:5">No será conmovida.</para>
  <para style="q" vid="PSA 46:5">
    <char style="nd">ʼElohim</char> la ayudará al clarear la mañana.<verse eid="PSA 46:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 46:6"/>Braman las naciones,</para>
  <para style="q" vid="PSA 46:6">Se tambalean los reinos.</para>
  <para style="q" vid="PSA 46:6">Él emite su voz.</para>
  <para style="q" vid="PSA 46:6">Se derrite la tierra.<verse eid="PSA 46:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 46:7"/>
    <char style="nd">Yavé</char> de las huestes está con nosotros.</para>
  <para style="q" vid="PSA 46:7">Nuestro Refugio es el <char style="nd">ʼElohim</char> de Jacob. <char style="tl">Selah</char><verse eid="PSA 46:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 46:8"/>Vengan y miren las obras de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 46:8">Quien causó asolamientos en la tierra,<verse eid="PSA 46:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 46:9"/>Quien hace cesar las guerras hasta el fin de la tierra,</para>
  <para style="q" vid="PSA 46:9">Quien quiebra el arco, rompe la lanza</para>
  <para style="q" vid="PSA 46:9">Y quema los carruajes en el fuego.<verse eid="PSA 46:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 46:10"/>Estén quietos y reconozcan que Yo soy <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 46:10">Seré exaltado entre las naciones.</para>
  <para style="q" vid="PSA 46:10">Seré enaltecido en la tierra.<verse eid="PSA 46:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 46:11"/>
    <char style="nd">Yavé</char> de las huestes está con nosotros.</para>
  <para style="q" vid="PSA 46:11">Nuestra Fortaleza es el <char style="nd">ʼElohim</char> de Jacob. <char style="tl">Selah</char><verse eid="PSA 46:11"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="s1">Al director del coro. Salmo de los hijos de Coré</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 47:1"/>¡Pueblos todos, aplaudan!</para>
  <para style="q" vid="PSA 47:1">¡Aclamen a <char style="nd">ʼElohim</char> con voz de júbilo!<verse eid="PSA 47:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 47:2"/>Porque <char style="nd">Yavé</char> el <char style="nd">ʼElyón</char> es temible,</para>
  <para style="q" vid="PSA 47:2">Rey grande sobre toda la tierra.<verse eid="PSA 47:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 47:3"/>Él somete los pueblos a nosotros,</para>
  <para style="q" vid="PSA 47:3">Las naciones bajo nuestros pies.<verse eid="PSA 47:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 47:4"/>Él nos eligió nuestra herencia,</para>
  <para style="q" vid="PSA 47:4">El Esplendor de Jacob, a quien amó. <char style="tl">Selah</char><verse eid="PSA 47:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 47:5"/>
    <char style="nd">ʼElohim</char> asciende con aclamación de júbilo,</para>
  <para style="q" vid="PSA 47:5">
    <char style="nd">Yavé</char> con sonido de trompeta.<note caller="+" style="f"><char style="fr" closed="false">47.5 </char><char style="ft" closed="false">Lit. cuerno.</char></note><verse eid="PSA 47:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 47:6"/>¡Canten a <char style="nd">ʼElohim</char>, canten!</para>
  <para style="q" vid="PSA 47:6">¡Canten a nuestro Rey, canten!<verse eid="PSA 47:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 47:7"/>Porque <char style="nd">ʼElohim</char> es el Rey de toda la tierra.</para>
  <para style="q" vid="PSA 47:7">¡Canten con entendimiento!<verse eid="PSA 47:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 47:8"/>¡<char style="nd">ʼElohim</char> reina sobre las naciones!</para>
  <para style="q" vid="PSA 47:8">¡<char style="nd">ʼElohim</char> se sienta en su santo trono!<verse eid="PSA 47:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 47:9"/>Los jefes de las naciones se reúnen como pueblo del <char style="nd">ʼElohim</char> de Abraham,</para>
  <para style="q" vid="PSA 47:9">Porque de <char style="nd">ʼElohim</char> son los escudos de la tierra,</para>
  <para style="q" vid="PSA 47:9">Él es sumamente exaltado.<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="s1">Canto. Salmo de los hijos de Coré</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 48:1"/>¡Grande es <char style="nd">Yavé</char> y digno de suprema alabanza!</para>
  <para style="q" vid="PSA 48:1">En la ciudad de nuestro <char style="nd">ʼElohim</char>, su Montaña Santa.<verse eid="PSA 48:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 48:2"/>Hermosa elevación, el gozo de toda la tierra</para>
  <para style="q" vid="PSA 48:2">Es la Montaña Sion en el lejano norte, la ciudad del gran Rey.<verse eid="PSA 48:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 48:3"/>En sus palacios <char style="nd">ʼElohim</char> se presentó como una Fortaleza.<verse eid="PSA 48:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 48:4"/>Porque ciertamente se aliaron los reyes,</para>
  <para style="q" vid="PSA 48:4">Avanzaron unidos.<verse eid="PSA 48:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 48:5"/>La miraron, fueron asombrados.</para>
  <para style="q" vid="PSA 48:5">Se aterrorizaron, huyeron alarmados.<verse eid="PSA 48:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 48:6"/>Allí se apoderó de ellos un temblor,</para>
  <para style="q" vid="PSA 48:6">Angustia como de parturienta.<verse eid="PSA 48:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 48:7"/>Con el viento que sopla del oriente</para>
  <para style="q" vid="PSA 48:7">Quiebras las naves de Tarsis.<verse eid="PSA 48:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 48:8"/>Como lo oímos, lo vimos en la ciudad de <char style="nd">Yavé</char> de las huestes,</para>
  <para style="q" vid="PSA 48:8">La ciudad de nuestro <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 48:8">
    <char style="nd">ʼElohim</char> la afirmará para siempre. <char style="tl">Selah</char><verse eid="PSA 48:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 48:9"/>Nos acordamos de tu misericordia, oh <char style="nd">ʼElohim</char>, en tu Templo.<verse eid="PSA 48:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 48:10"/>Como tu Nombre, oh <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 48:10">Así es tu alabanza hasta los confines de la tierra.</para>
  <para style="q" vid="PSA 48:10">Tu mano derecha está llena de justicia.<verse eid="PSA 48:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 48:11"/>¡Alégrese la Montaña Sion!</para>
  <para style="q" vid="PSA 48:11">¡Regocíjense las hijas de Judá</para>
  <para style="q" vid="PSA 48:11">A causa de tus juicios!<verse eid="PSA 48:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 48:12"/>Anden alrededor de Sion y rodéenla.</para>
  <para style="q" vid="PSA 48:12">Cuenten sus torres.<verse eid="PSA 48:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 48:13"/>Observen atentamente su muro exterior.</para>
  <para style="q" vid="PSA 48:13">Contemplen sus palacios</para>
  <para style="q" vid="PSA 48:13">Para que lo cuenten a la generación venidera.<verse eid="PSA 48:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 48:14"/>Porque este <char style="nd">ʼElohim</char> es nuestro <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 48:14">Eternamente y para siempre.</para>
  <para style="q" vid="PSA 48:14">¡Él nos guiará hasta la muerte!<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="s1">Al director del coro. Salmo de los hijos de Coré</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 49:1"/>Oigan esto, pueblos todos,</para>
  <para style="q" vid="PSA 49:1">Escuchen todos los habitantes del mundo,<verse eid="PSA 49:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 49:2"/>Tanto los humildes como los de alto nivel,</para>
  <para style="q" vid="PSA 49:2">Ricos y pobres juntamente.<verse eid="PSA 49:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 49:3"/>Mi boca hablará sabiduría,</para>
  <para style="q" vid="PSA 49:3">Y la meditación de mi corazón entendimiento.<verse eid="PSA 49:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 49:4"/>Inclinaré al proverbio mi oído.</para>
  <para style="q" vid="PSA 49:4">Declararé con el arpa mi dicho.<verse eid="PSA 49:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 49:5"/>¿Por qué tengo que temer en días de adversidad</para>
  <para style="q" vid="PSA 49:5">Cuando me rodea la iniquidad de mis adversarios,<verse eid="PSA 49:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 49:6"/>Que confían en la abundancia de sus posesiones,</para>
  <para style="q" vid="PSA 49:6">Y se jactan de sus inmensas riquezas?<verse eid="PSA 49:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 49:7"/>Ninguno de ellos puede de algún modo redimir al hermano,</para>
  <para style="q" vid="PSA 49:7">Ni pagar su rescate a <char style="nd">ʼElohim</char>.<verse eid="PSA 49:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 49:8"/>Porque la redención de su vida es costosa,</para>
  <para style="q" vid="PSA 49:8">Y nunca será suficiente,<verse eid="PSA 49:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 49:9"/>Para que viva eternamente</para>
  <para style="q" vid="PSA 49:9">Y jamás pase a corrupción.<verse eid="PSA 49:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 49:10"/>Porque ve que aun los sabios mueren</para>
  <para style="q" vid="PSA 49:10">Igual como perecen el ignorante y el necio,</para>
  <para style="q" vid="PSA 49:10">Y dejan a otros sus riquezas.<verse eid="PSA 49:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 49:11"/>Su íntima aspiración es que sus casas sean eternas,</para>
  <para style="q" vid="PSA 49:11">Sus moradas, por todas las generaciones.</para>
  <para style="q" vid="PSA 49:11">A sus tierras dan sus nombres.<verse eid="PSA 49:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 49:12"/>Pero el hombre no permanecerá con honra.</para>
  <para style="q" vid="PSA 49:12">Es como las bestias que perecen.<verse eid="PSA 49:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 49:13"/>Esta es la senda de los necios,</para>
  <para style="q" vid="PSA 49:13">Y de aquellos que tras ellos aprueban sus palabras. <char style="tl">Selah</char><verse eid="PSA 49:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 49:14"/>Como un rebaño están destinados al <char style="tl">Seol</char>,</para>
  <para style="q" vid="PSA 49:14">La muerte los pastorea.</para>
  <para style="q" vid="PSA 49:14">Los rectos se enseñorearán de ellos por la mañana,</para>
  <para style="q" vid="PSA 49:14">Se consumirá su buen parecer,</para>
  <para style="q" vid="PSA 49:14">Y el <char style="tl">Seol</char> será su morada.<verse eid="PSA 49:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 49:15"/>Pero <char style="nd">ʼElohim</char> redimirá mi alma del poder del <char style="tl">Seol</char>,</para>
  <para style="q" vid="PSA 49:15">Porque me llevará consigo. <char style="tl">Selah</char><verse eid="PSA 49:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 49:16"/>No temas cuando alguno se enriquece,</para>
  <para style="q" vid="PSA 49:16">Cuando aumenta el esplendor de su casa.<verse eid="PSA 49:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 49:17"/>Porque nada llevará al morir,</para>
  <para style="q" vid="PSA 49:17">Ni descenderá su esplendor tras él.<verse eid="PSA 49:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 49:18"/>Aunque se congratule mientras vive,</para>
  <para style="q" vid="PSA 49:18">Aunque sea alabado porque prospera,<verse eid="PSA 49:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 49:19"/>Se irá a la generación de sus antepasados</para>
  <para style="q" vid="PSA 49:19">Y nunca jamás verá la luz.<verse eid="PSA 49:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 49:20"/>El hombre que vive con honor,</para>
  <para style="q" vid="PSA 49:20">Pero no entiende <char style="add">esto</char>,</para>
  <para style="q" vid="PSA 49:20">Es como las bestias que perecen.<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="s1">Salmo de Asaf</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 50:1"/>El poderoso <char style="nd">ʼEL,</char> <char style="nd">ʼElohim</char>, <char style="nd">Yavé</char> habló</para>
  <para style="q" vid="PSA 50:1">Y convocó a la tierra desde el oriente hasta el occidente.<verse eid="PSA 50:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 50:2"/>Desde Sion, perfección de hermosura, <char style="nd">ʼElohim</char> resplandeció.<verse eid="PSA 50:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 50:3"/>Que venga nuestro <char style="nd">ʼElohim</char>, y no en silencio.</para>
  <para style="q" vid="PSA 50:3">Un fuego devorador lo precede,</para>
  <para style="q" vid="PSA 50:3">Y alrededor de Él ruge una gran tempestad.<verse eid="PSA 50:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 50:4"/>Desde lo alto convoca a los cielos</para>
  <para style="q" vid="PSA 50:4">Y a la tierra para juzgar a su pueblo:<verse eid="PSA 50:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 50:5"/>
    <char style="wj">Júntenme a mis santos,</char></para>
  <para style="q" vid="PSA 50:5">
    <char style="wj">Los que hicieron un Pacto conmigo con sacrificio.</char><verse eid="PSA 50:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 50:6"/>
    <char style="wj">Los cielos proclamarán su justicia,</char></para>
  <para style="q" vid="PSA 50:6">
    <char style="wj">Porque <char style="nd">ʼElohim</char> es el Juez. Selah</char><verse eid="PSA 50:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 50:7"/>
    <char style="wj">Escucha, pueblo mío, y hablaré.</char></para>
  <para style="q" vid="PSA 50:7">
    <char style="wj">Testificaré contra ti, Israel.</char></para>
  <para style="q" vid="PSA 50:7">
    <char style="wj">Yo soy <char style="nd">ʼElohim</char>, el <char style="nd">ʼElohim</char> tuyo.</char><verse eid="PSA 50:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 50:8"/>
    <char style="wj">No te reprendo por tus sacrificios.</char></para>
  <para style="q" vid="PSA 50:8">
    <char style="wj">Tus ofrendas encendidas están siempre delante de Mí.</char><verse eid="PSA 50:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 50:9"/>
    <char style="wj">No aceptaré becerros de tu casa,</char></para>
  <para style="q" vid="PSA 50:9">
    <char style="wj">Ni machos cabríos de tus corrales.</char><verse eid="PSA 50:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 50:10"/>
    <char style="wj">Porque mía es toda bestia del bosque</char></para>
  <para style="q" vid="PSA 50:10">
    <char style="wj">Y los ganados sobre 1.000 colinas.</char><verse eid="PSA 50:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 50:11"/>
    <char style="wj">Conozco todas las aves de las montañas,</char></para>
  <para style="q" vid="PSA 50:11">
    <char style="wj">Y todo lo que se mueve en el campo es mío.</char><verse eid="PSA 50:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 50:12"/>
    <char style="wj">Si tuviera hambre, </char></para>
  <para style="q" vid="PSA 50:12">
    <char style="wj">No te lo diría a ti,</char></para>
  <para style="q" vid="PSA 50:12">
    <char style="wj">Porque mío es el mundo y todo lo que contiene.</char><verse eid="PSA 50:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 50:13"/>
    <char style="wj">¿Yo como carne de becerros? </char></para>
  <para style="q" vid="PSA 50:13">
    <char style="wj">¿Bebo sangre de machos cabríos?</char><verse eid="PSA 50:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 50:14"/>
    <char style="wj">Ofrece a <char style="nd">ʼElohim</char> sacrificio de acción de gracias. </char></para>
  <para style="q" vid="PSA 50:14">
    <char style="wj">Paga a <char style="nd">ʼElyón</char> tus votos. </char><verse eid="PSA 50:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 50:15"/>
    <char style="wj">Invócame en el día de la angustia.</char></para>
  <para style="q" vid="PSA 50:15">
    <char style="wj">Te libraré, </char></para>
  <para style="q" vid="PSA 50:15">
    <char style="wj">Y tú me honrarás.</char><verse eid="PSA 50:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 50:16"/>
    <char style="wj">al perverso <char style="nd">ʼElohim</char> dice:</char></para>
  <para style="q" vid="PSA 50:16">
    <char style="wj">¿Qué derecho tienes tú para recitar mis Estatutos, </char></para>
  <para style="q" vid="PSA 50:16">
    <char style="wj">Y tomar mi Pacto en tu boca?</char><verse eid="PSA 50:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 50:17"/>
    <char style="wj">Porque tú aborreces la corrección, </char></para>
  <para style="q" vid="PSA 50:17">
    <char style="wj">Y das tu espalda a mis Palabras.</char><verse eid="PSA 50:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 50:18"/>
    <char style="wj">Si ves a un ladrón, te complaces con él,</char></para>
  <para style="q" vid="PSA 50:18">
    <char style="wj">Y te asocias con los adúlteros.</char><verse eid="PSA 50:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 50:19"/>
    <char style="wj">Permites que tu boca se pierda en lo malo,</char></para>
  <para style="q" vid="PSA 50:19">
    <char style="wj">Y tu lengua trama el engaño.</char><verse eid="PSA 50:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 50:20"/>
    <char style="wj">Te sientas, hablas contra tu hermano,</char></para>
  <para style="q" vid="PSA 50:20">
    <char style="wj">Y difamas al hijo de tu propia madre.</char><verse eid="PSA 50:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 50:21"/>
    <char style="wj">Estas cosas hiciste, </char></para>
  <para style="q" vid="PSA 50:21">
    <char style="wj">Y Yo callé.</char></para>
  <para style="q" vid="PSA 50:21">
    <char style="wj">Pensaste que Yo soy como tú.</char></para>
  <para style="q" vid="PSA 50:21">
    <char style="wj">Pero te reprenderé y las expondré delante de tus ojos.</char><verse eid="PSA 50:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PSA 50:22"/>
    <char style="wj">Entiendan esto, los que se olvidan de <char style="nd">ʼEloah</char>,</char></para>
  <para style="q" vid="PSA 50:22">
    <char style="wj">No sea que los quebrante sin que haya quien los libre.</char><verse eid="PSA 50:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 50:23"/>
    <char style="wj">El que ofrece sacrificio de acción de gracias me honra,</char></para>
  <para style="q" vid="PSA 50:23">
    <char style="wj">Y al que ordena rectamente su camino</char></para>
  <para style="q" vid="PSA 50:23">
    <char style="wj">Le mostraré la salvación de <char style="nd">ʼElohim</char>.</char><verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="s1">Al director del coro. Salmo de David, cuando el profeta Natán fue a él, después que él se unió con Betsabé</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 51:1"/>Ten compasión de mí, oh <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 51:1">Conforme a tu misericordia.</para>
  <para style="q" vid="PSA 51:1">Según tu gran clemencia</para>
  <para style="q" vid="PSA 51:1">Borra mis transgresiones.<verse eid="PSA 51:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 51:2"/>Lávame completamente de mi iniquidad,</para>
  <para style="q" vid="PSA 51:2">Y purifícame de mi pecado.<verse eid="PSA 51:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 51:3"/>Porque yo reconozco mis transgresiones.</para>
  <para style="q" vid="PSA 51:3">Mi pecado está siempre delante de mí.<verse eid="PSA 51:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 51:4"/>Contra Ti, solo contra Ti pequé,</para>
  <para style="q" vid="PSA 51:4">E hice lo malo ante tus ojos.</para>
  <para style="q" vid="PSA 51:4">Así que eres justo cuando hablas,</para>
  <para style="q" vid="PSA 51:4">E intachable cuando juzgas.<verse eid="PSA 51:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 51:5"/>Mira que en iniquidad fui formado,</para>
  <para style="q" vid="PSA 51:5">Y en pecado me concibió mi madre.<verse eid="PSA 51:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 51:6"/>Mira que Tú deseas verdad en lo íntimo,</para>
  <para style="q" vid="PSA 51:6">Y en la parte secreta me harás conocer sabiduría.<verse eid="PSA 51:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 51:7"/>Purifícame con hisopo y seré puro.</para>
  <para style="q" vid="PSA 51:7">Lávame, y seré más blanco que la nieve.<verse eid="PSA 51:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 51:8"/>¡Hazme oír gozo y alegría!</para>
  <para style="q" vid="PSA 51:8">¡Regocíjense los huesos que humillaste!<verse eid="PSA 51:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 51:9"/>Oculta tu rostro de mis pecados</para>
  <para style="q" vid="PSA 51:9">Y borra todas mis iniquidades.<verse eid="PSA 51:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 51:10"/>Oh <char style="nd">ʼElohim</char>, crea en mí un corazón puro</para>
  <para style="q" vid="PSA 51:10">Y renueva un espíritu establecido dentro de mí.<verse eid="PSA 51:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 51:11"/>No me eches de tu Presencia,</para>
  <para style="q" vid="PSA 51:11">Ni quites de mí tu Santo Espíritu.<verse eid="PSA 51:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 51:12"/>Vuélveme el gozo de tu salvación,</para>
  <para style="q" vid="PSA 51:12">Y un espíritu noble me sustente.<verse eid="PSA 51:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 51:13"/>Entonces enseñaré a los transgresores tus caminos,</para>
  <para style="q" vid="PSA 51:13">Y los pecadores se convertirán a Ti.<verse eid="PSA 51:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 51:14"/>Líbrame de homicidios, oh <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 51:14">
    <char style="nd">ʼElohim</char> de mi salvación,</para>
  <para style="q" vid="PSA 51:14">Y mi lengua cantará con gozo tu justicia.<verse eid="PSA 51:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 51:15"/>Oh <char style="nd">ʼAdonay</char>, abre mis labios,</para>
  <para style="q" vid="PSA 51:15">Para que mi boca declare tu alabanza.<verse eid="PSA 51:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 51:16"/>Porque no deseas sacrificio,</para>
  <para style="q" vid="PSA 51:16">Que de otro modo, yo daría.</para>
  <para style="q" vid="PSA 51:16">No eres complacido con holocausto.<verse eid="PSA 51:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 51:17"/>Los sacrificios de <char style="nd">ʼElohim</char> son un espíritu quebrantado.</para>
  <para style="q" vid="PSA 51:17">No despreciarás Tú, oh <char style="nd">ʼElohim</char>, al corazón contrito y humillado.<verse eid="PSA 51:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 51:18"/>Haz bien con tu benevolencia a Sion.</para>
  <para style="q" vid="PSA 51:18">Edifica los muros de Jerusalén.<verse eid="PSA 51:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 51:19"/>Entonces te agradarán los sacrificios de justicia,</para>
  <para style="q" vid="PSA 51:19">El holocausto u ofrenda completamente quemada.</para>
  <para style="q" vid="PSA 51:19">Entonces serán ofrecidos becerros sobre tu altar.<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="s1">Al director del coro. Instrucción (<char style="tl">Maskil</char>) de David, cuando Doeg Edomita dio aviso a Saúl, y le dijo: David entró en casa de Ahimelec</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 52:1"/>¿Por qué te jactas de ser perverso, oh poderoso?</para>
  <para style="q" vid="PSA 52:1">La misericordia de <char style="nd">ʼEL</char> es continua.<verse eid="PSA 52:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 52:2"/>Tu lengua diseña destrucción.</para>
  <para style="q" vid="PSA 52:2">Produce engaño, como una navaja afilada.<verse eid="PSA 52:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 52:3"/>Tú amas más el mal que el bien,</para>
  <para style="q" vid="PSA 52:3">La mentira más bien que hablar lo recto. <char style="tl">Selah</char><verse eid="PSA 52:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 52:4"/>Tú amas todas las palabras que devoran, oh lengua engañosa.<verse eid="PSA 52:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 52:5"/>Por tanto, <char style="nd">ʼEL</char> te destruirá para siempre.</para>
  <para style="q" vid="PSA 52:5">Te arrastrará,</para>
  <para style="q" vid="PSA 52:5">Te arrancará de la tierra de los vivientes</para>
  <para style="q" vid="PSA 52:5">Y te desarraigará de la tierra de los vivientes. <char style="tl">Selah</char><verse eid="PSA 52:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 52:6"/>Verán los justos y temerán.</para>
  <para style="q" vid="PSA 52:6">Se reirán de él y dirán:<verse eid="PSA 52:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 52:7"/>¡Miren al hombre que no tomó a <char style="nd">ʼElohim</char> como su Fortaleza,</para>
  <para style="q" vid="PSA 52:7">Sino confió en la abundancia de sus riquezas</para>
  <para style="q" vid="PSA 52:7">Y fue fuerte en su perversidad!<verse eid="PSA 52:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 52:8"/>Pero yo estaré como olivo frondoso en la Casa de <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 52:8">Porque en la misericordia de <char style="nd">ʼElohim</char> confío eternamente y para siempre.<verse eid="PSA 52:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 52:9"/>Te daré gracias para siempre por lo que hiciste,</para>
  <para style="q" vid="PSA 52:9">Y esperaré en tu Nombre,</para>
  <para style="q" vid="PSA 52:9">Porque es bueno en presencia de tus devotos.<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="s1">Al director del coro. Al estilo de duelo (<char style="tl">Mahalath</char>). Instrucción (<char style="tl">Maskil</char>) de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 53:1"/>El necio dijo en su corazón: No hay <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 53:1">Están corrompidos.</para>
  <para style="q" vid="PSA 53:1">Cometieron repugnante injusticia.</para>
  <para style="q" vid="PSA 53:1">No hay uno que haga lo recto.<verse eid="PSA 53:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 53:2"/>
    <char style="nd">ʼElohim</char> miró desde el cielo a los hijos de hombres</para>
  <para style="q" vid="PSA 53:2">Para ver si hay alguno que entiende,</para>
  <para style="q" vid="PSA 53:2">Que busca a <char style="nd">ʼElohim</char>.<verse eid="PSA 53:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 53:3"/>Cada uno de ellos se apartó.</para>
  <para style="q" vid="PSA 53:3">Juntamente se volvieron corruptos.</para>
  <para style="q" vid="PSA 53:3">No hay quien hace lo bueno,</para>
  <para style="q" vid="PSA 53:3">Ni siquiera uno.<verse eid="PSA 53:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 53:4"/>¿Los que practican iniquidad no saben</para>
  <para style="q" vid="PSA 53:4">Que devoran a mi pueblo como si comieran pan,</para>
  <para style="q" vid="PSA 53:4">Y no invocaron a <char style="nd">ʼElohim</char>?<verse eid="PSA 53:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 53:5"/>Allí, donde nada había que temer, tuvieron gran terror.</para>
  <para style="q" vid="PSA 53:5">Porque <char style="nd">ʼElohim</char> dispersó a los que acamparon contra ti,</para>
  <para style="q" vid="PSA 53:5">Los avergonzaste,</para>
  <para style="q" vid="PSA 53:5">Porque <char style="nd">ʼElohim</char> los rechazó.<verse eid="PSA 53:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 53:6"/>¡Oh, que venga de Sion la salvación de Israel!</para>
  <para style="q" vid="PSA 53:6">Cuando <char style="nd">ʼElohim</char> restaure de la cautividad a su pueblo,</para>
  <para style="q" vid="PSA 53:6">¡Que se regocije Jacob, y se alegre Israel!<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="s1">Al director del coro. Sobre instrumentos de cuerda. Instrucción. (<char style="tl">Maskil</char>) de David, cuando llegaron los zifeos y dijeron a Saúl: ¿No se esconde David entre nosotros?</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 54:1"/>Oh <char style="nd">ʼElohim</char>, sálvame por tu Nombre,</para>
  <para style="q" vid="PSA 54:1">Y defiéndeme con tu poder.<verse eid="PSA 54:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 54:2"/>Oh <char style="nd">ʼElohim</char>, escucha mi oración.</para>
  <para style="q" vid="PSA 54:2">Escucha las palabras de mi boca.<verse eid="PSA 54:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 54:3"/>Porque extraños se levantaron contra mí,</para>
  <para style="q" vid="PSA 54:3">Y hombres violentos buscan mi vida.</para>
  <para style="q" vid="PSA 54:3">No colocaron a <char style="nd">ʼElohim</char> delante de ellos. <char style="tl">Selah</char><verse eid="PSA 54:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 54:4"/>Ciertamente <char style="nd">ʼElohim</char> es el que me ayuda.</para>
  <para style="q" vid="PSA 54:4">
    <char style="nd">ʼAdonay</char> es Quien sostiene mi vida.<verse eid="PSA 54:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 54:5"/>Él hace volver el mal contra mis enemigos.</para>
  <para style="q" vid="PSA 54:5">Por tu fidelidad, destrúyelos.<verse eid="PSA 54:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 54:6"/>Voluntariamente te ofreceré sacrificio.</para>
  <para style="q" vid="PSA 54:6">Oh <char style="nd">Yavé</char>, daré gracias a tu Nombre</para>
  <para style="q" vid="PSA 54:6">Porque es bueno,<verse eid="PSA 54:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 54:7"/>Porque me libraste de toda angustia</para>
  <para style="q" vid="PSA 54:7">Y mis ojos vieron la ruina de mis enemigos.<verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="s1">Al director del coro. Con música de cuerdas. Instrucción (<char style="tl">Maskil</char>) de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 55:1"/>Oh <char style="nd">ʼElohim</char>, escucha mi oración,</para>
  <para style="q" vid="PSA 55:1">Y no te escondas de mi súplica.<verse eid="PSA 55:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 55:2"/>Está atento y respóndeme.</para>
  <para style="q" vid="PSA 55:2">Estoy inquieto y conturbado en mi oración<verse eid="PSA 55:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 55:3"/>A causa de la voz del enemigo.</para>
  <para style="q" vid="PSA 55:3">Por la opresión del perverso,</para>
  <para style="q" vid="PSA 55:3">Porque bajan aflicción sobre mí,</para>
  <para style="q" vid="PSA 55:3">Y me persiguen con furor.<verse eid="PSA 55:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 55:4"/>Mi corazón se retuerce dentro de mí.</para>
  <para style="q" vid="PSA 55:4">Me asaltan terrores de <char style="add">la</char> muerte.<verse eid="PSA 55:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 55:5"/>Temor y temblor vienen sobre mí.</para>
  <para style="q" vid="PSA 55:5">El terror me cubre,<verse eid="PSA 55:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 55:6"/>Y digo: ¡Oh, si yo tuviera alas como una paloma!</para>
  <para style="q" vid="PSA 55:6">Volaría yo y descansaría.<verse eid="PSA 55:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 55:7"/>Ciertamente huiría lejos.</para>
  <para style="q" vid="PSA 55:7">Viviría en el desierto. <char style="tl">Selah</char><verse eid="PSA 55:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 55:8"/>Me apresuraría a escapar del viento borrascoso de la tempestad,</para>
  <para style="q" vid="PSA 55:8">Del aguacero fuerte y la tormenta.<verse eid="PSA 55:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 55:9"/>Destrúyelos, oh <char style="nd">ʼAdonay</char>, confunde sus lenguas,</para>
  <para style="q" vid="PSA 55:9">Porque vi en la ciudad violencia y disputa.<verse eid="PSA 55:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 55:10"/>Día y noche rondan sobre sus muros.</para>
  <para style="q" vid="PSA 55:10">La iniquidad y la aventura están en medio de ella.<verse eid="PSA 55:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 55:11"/>Destrucción hay dentro de ella.</para>
  <para style="q" vid="PSA 55:11">Opresión y engaño no se apartan de sus calles.<verse eid="PSA 55:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 55:12"/>Porque no es un enemigo el que me agravia.</para>
  <para style="q" vid="PSA 55:12">Si fuera así, lo soportaría.</para>
  <para style="q" vid="PSA 55:12">Ni se levantó contra mí el que me aborrece.</para>
  <para style="q" vid="PSA 55:12">Podría ocultarme de él.<verse eid="PSA 55:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 55:13"/>Sino tú, un hombre igual a mí,</para>
  <para style="q" vid="PSA 55:13">Mi compañero, mi íntimo amigo.<verse eid="PSA 55:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 55:14"/>Juntos teníamos dulce comunión,</para>
  <para style="q" vid="PSA 55:14">Y con intimidad andábamos en la Casa de <char style="nd">ʼElohim</char>.<verse eid="PSA 55:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 55:15"/>Que la muerte los sorprenda,</para>
  <para style="q" vid="PSA 55:15">Que desciendan vivos al <char style="tl">Seol</char>,</para>
  <para style="q" vid="PSA 55:15">Porque hay maldad en su habitación, en medio de ellos.<verse eid="PSA 55:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 55:16"/>Pero yo clamaré a <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 55:16">Y <char style="nd">Yavé</char> me salvará.<verse eid="PSA 55:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 55:17"/>Al llegar la noche, por la mañana y a mediodía</para>
  <para style="q" vid="PSA 55:17">Me quejaré y gemiré,</para>
  <para style="q" vid="PSA 55:17">Y Él escuchará mi voz.<verse eid="PSA 55:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 55:18"/>Él rescata en paz mi alma del ataque contra mí,</para>
  <para style="q" vid="PSA 55:18">Aunque muchos se enfrenten contra mí.<verse eid="PSA 55:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 55:19"/>
    <char style="nd">ʼEL</char> escuchará y los afligirá,</para>
  <para style="q" vid="PSA 55:19">Él, Quien está entronizado desde tiempo antiguo. <char style="tl">Selah</char></para>
  <para style="q" vid="PSA 55:19">Porque ellos no cambian,</para>
  <para style="q" vid="PSA 55:19">Por tanto no temen a <char style="nd">ʼElohim</char>.<verse eid="PSA 55:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 55:20"/>
    <char style="add">El inicuo</char> extiende sus manos</para>
  <para style="q" vid="PSA 55:20">Contra los que estaban en paz con él.</para>
  <para style="q" vid="PSA 55:20">Viola su pacto.<verse eid="PSA 55:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 55:21"/>Su boca fue más blanda que mantequilla,</para>
  <para style="q" vid="PSA 55:21">Pero hay contienda en su corazón.</para>
  <para style="q" vid="PSA 55:21">Más suaves que aceite son sus palabras,</para>
  <para style="q" vid="PSA 55:21">Pero son como espadas desenvainadas.<verse eid="PSA 55:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PSA 55:22"/>Echa sobre <char style="nd">Yavé</char> tu carga,</para>
  <para style="q" vid="PSA 55:22">Y Él te sustentará.</para>
  <para style="q" vid="PSA 55:22">Jamás dejará caído al justo.<verse eid="PSA 55:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 55:23"/>Oh <char style="nd">ʼElohim</char>, Tú los harás bajar a la fosa de destrucción.</para>
  <para style="q" vid="PSA 55:23">Los sanguinarios y engañadores no vivirán la mitad de sus días.</para>
  <para style="b" vid="PSA 55:23"/>
  <para style="q" vid="PSA 55:23">Pero yo confío en Ti.<verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="s1">Al director del coro. Sobre la paloma silenciosa en parajes muy lejanos.</para>
  <para style="s1">Canto a media voz (<char style="tl">Mictam</char>) de David, cuando los filisteos lo capturaron en Gat</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 56:1"/>Oh <char style="nd">ʼElohim</char>, ten compasión de mí,</para>
  <para style="q" vid="PSA 56:1">Porque el hombre me pisotea, me devora,</para>
  <para style="q" vid="PSA 56:1">Me oprime y me combate todo el día.<verse eid="PSA 56:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 56:2"/>Los que me asaltan me pisotean todo el día,</para>
  <para style="q" vid="PSA 56:2">Porque son muchos los que con soberbia pelean contra mí.<verse eid="PSA 56:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 56:3"/>El día cuando temo, confío en Ti.<verse eid="PSA 56:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 56:4"/>En <char style="nd">ʼElohim</char>, la Palabra de Quien alabo,</para>
  <para style="q" vid="PSA 56:4">En <char style="nd">ʼElohim</char> confío, no temeré.</para>
  <para style="q" vid="PSA 56:4">¿Qué puede hacerme el hombre?<verse eid="PSA 56:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 56:5"/>Todo el día pervierten mis palabras.</para>
  <para style="q" vid="PSA 56:5">Contra mí son todos sus pensamientos para mal.<verse eid="PSA 56:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 56:6"/>Conspiran, acechan, observan atentamente mis pasos en acecho de mi vida.<verse eid="PSA 56:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 56:7"/>Pésalos a causa de su perversidad.</para>
  <para style="q" vid="PSA 56:7">Con furia derriba los pueblos, oh ʼElohim.<verse eid="PSA 56:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 56:8"/>Tomaste en cuenta mis huidas.</para>
  <para style="q" vid="PSA 56:8">Coloca mis lágrimas en tu botella.</para>
  <para style="q" vid="PSA 56:8">¿No están ellas en tu rollo?<verse eid="PSA 56:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 56:9"/>El día cuando yo te invoque retrocederán mis enemigos.</para>
  <para style="q" vid="PSA 56:9">Esto sé porque <char style="nd">ʼElohim</char> está a mi favor.<verse eid="PSA 56:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 56:10"/>Oh <char style="nd">ʼElohim</char>, tu Palabra alabo,</para>
  <para style="q" vid="PSA 56:10">Oh <char style="nd">Yavé</char>, tu Palabra alabo.<verse eid="PSA 56:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 56:11"/>En <char style="nd">ʼElohim</char> confié, no temeré.</para>
  <para style="q" vid="PSA 56:11">¿Qué puede hacerme el hombre?<verse eid="PSA 56:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 56:12"/>Oh <char style="nd">ʼElohim</char>, sobre mí están los votos.</para>
  <para style="q" vid="PSA 56:12">Te pagaré ofrendas de acción de gracias,<verse eid="PSA 56:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 56:13"/>Porque libraste mi vida de la muerte</para>
  <para style="q" vid="PSA 56:13">Y mis pies de tropezar,</para>
  <para style="q" vid="PSA 56:13">Para que ande delante de <char style="nd">ʼElohim</char></para>
  <para style="q" vid="PSA 56:13">En la luz de los que viven.<verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="s1">Al director del coro. A modo de “No destruyas.”</para>
  <para style="s1">Canto a media voz (<char style="tl">Mictam</char>) de David, en la cueva, cuando huía de Saúl</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 57:1"/>Ten compasión de mí, oh <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 57:1">Ten compasión de mí.</para>
  <para style="q" vid="PSA 57:1">Porque mi alma confía en Ti,</para>
  <para style="q" vid="PSA 57:1">Y en la sombra de tus alas me amparo</para>
  <para style="q" vid="PSA 57:1">Hasta que pase la destrucción.<verse eid="PSA 57:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 57:2"/>Clamaré a <char style="nd">ʼElohim</char> <char style="nd">ʼElyón</char>,</para>
  <para style="q" vid="PSA 57:2">A <char style="nd">ʼEL,</char> Quien me favorece.<verse eid="PSA 57:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 57:3"/>Él enviará desde el cielo</para>
  <para style="q" vid="PSA 57:3">Y me salvará de la infamia del que me oprime. <char style="tl">Selah</char></para>
  <para style="q" vid="PSA 57:3">
    <char style="nd">ʼElohim</char> enviará su misericordia y su verdad.<verse eid="PSA 57:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 57:4"/>Mi vida está en medio de leones.</para>
  <para style="q" vid="PSA 57:4">Estoy tendido entre los que respiran fuego.</para>
  <para style="q" vid="PSA 57:4">Hijos de hombres, sus dientes son lanzas y flechas,</para>
  <para style="q" vid="PSA 57:4">Y su lengua, espada aguda.<verse eid="PSA 57:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 57:5"/>¡Exaltado seas sobre los cielos, oh <char style="nd">ʼElohim</char>!</para>
  <para style="q" vid="PSA 57:5">¡Tu gloria sea sobre toda la tierra!<verse eid="PSA 57:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 57:6"/>Tendieron una red ante mis pies para doblegar mi vida.</para>
  <para style="q" vid="PSA 57:6">Cavaron un hoyo delante de mí</para>
  <para style="q" vid="PSA 57:6">Y ellos cayeron en él. <char style="tl">Selah</char><verse eid="PSA 57:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 57:7"/>Mi corazón está establecido, oh <char style="nd">ʼElohim.</char></para>
  <para style="q" vid="PSA 57:7">Está firme mi corazón.</para>
  <para style="q" vid="PSA 57:7">Cantaré y entonaré salmos.<verse eid="PSA 57:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 57:8"/>Despierta, alma mía.</para>
  <para style="q" vid="PSA 57:8">Despierten, arpa y lira.</para>
  <para style="q" vid="PSA 57:8">Yo despertaré el alba.<verse eid="PSA 57:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 57:9"/>Te daré gracias entre los pueblos, oh <char style="nd">ʼAdonay</char>.</para>
  <para style="q" vid="PSA 57:9">Te cantaré salmos en las naciones.<verse eid="PSA 57:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 57:10"/>Porque tu misericordia es grande hasta los cielos,</para>
  <para style="q" vid="PSA 57:10">Y tu verdad, hasta las nubes.<verse eid="PSA 57:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 57:11"/>Exaltado seas sobre los cielos, oh <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 57:11">Y tu gloria sea por encima de toda la tierra.<verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="s1">Al director del coro. Al modo de “No destruyas”</para>
  <para style="s1">Canto a media voz (<char style="tl">Mictam</char>) de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 58:1"/>Magistrados: ¿Ustedes pronuncian justicia en verdad?</para>
  <para style="q" vid="PSA 58:1">¿Juzgan rectamente, oh hijos de hombre?<verse eid="PSA 58:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 58:2"/>No, en su corazón ustedes maquinan perversidad.</para>
  <para style="q" vid="PSA 58:2">Hacen que pese sobre la tierra la violencia de sus manos.<verse eid="PSA 58:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 58:3"/>Los perversos se extravían desde la matriz.</para>
  <para style="q" vid="PSA 58:3">Se descarriaron, hablan mentiras desde cuando nacieron.<verse eid="PSA 58:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 58:4"/>Tienen veneno como veneno de serpiente.</para>
  <para style="q" vid="PSA 58:4">Son como una víbora sorda que cierra su oído,<verse eid="PSA 58:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 58:5"/>Y no oye la voz de los encantadores,</para>
  <para style="q" vid="PSA 58:5">Aun del más hábil en encantamientos.<verse eid="PSA 58:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 58:6"/>Oh <char style="nd">ʼElohim</char>, rompe sus dientes en la boca de ellos.</para>
  <para style="q" vid="PSA 58:6">Quiebra los colmillos de los leoncillos, oh <char style="nd">Yavé</char>,<verse eid="PSA 58:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 58:7"/>Que floten como agua que se pierde.</para>
  <para style="q" vid="PSA 58:7">Cuando disparen sus flechas, sean éstas despuntadas.<verse eid="PSA 58:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 58:8"/>Que sean como un caracol que se deslíe,</para>
  <para style="q" vid="PSA 58:8">Como aborto de mujer, no vean el sol.<verse eid="PSA 58:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 58:9"/>Antes que sus ollas sientan el fuego de los espinos,</para>
  <para style="q" vid="PSA 58:9">Él los barrerá como con remolino de viento,</para>
  <para style="q" vid="PSA 58:9">Los verdes y los que arden por igual.<verse eid="PSA 58:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 58:10"/>El justo se alegrará cuando vea la venganza.</para>
  <para style="q" vid="PSA 58:10">Lavará sus pies en la sangre del perverso.<verse eid="PSA 58:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 58:11"/>Entonces dirá el hombre:</para>
  <para style="q" vid="PSA 58:11">¡Ciertamente hay galardón para el justo!</para>
  <para style="q" vid="PSA 58:11">¡Ciertamente hay <char style="nd">ʼElohim</char> que juzga en la tierra!<verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="s1">Al director del coro. Al modo de “No destruyas”.</para>
  <para style="s1">Canto a media voz (<char style="tl">Mictam</char>) de David, cuando Saúl envió a vigilar la casa para matarlo</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 59:1"/>¡Oh <char style="nd">ʼElohim</char> mío, líbrame de mis enemigos!</para>
  <para style="q" vid="PSA 59:1">¡Oh <char style="nd">ʼElohim</char> mío, ponme a salvo</para>
  <para style="q" vid="PSA 59:1">De los que se levantan contra mí!<verse eid="PSA 59:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 59:2"/>Líbrame de los que hacen iniquidad,</para>
  <para style="q" vid="PSA 59:2">Y sálvame de hombres sanguinarios.<verse eid="PSA 59:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 59:3"/>Porque ciertamente pusieron emboscada a mi vida.</para>
  <para style="q" vid="PSA 59:3">Hombres fieros lanzan ataque contra mí,</para>
  <para style="q" vid="PSA 59:3">No por mi transgresión ni por mi pecado, oh <char style="nd">Yavé</char>.<verse eid="PSA 59:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 59:4"/>Sin culpa mía corren y se preparan contra mí.</para>
  <para style="q" vid="PSA 59:4">Despierta para ayudarme y mira.<verse eid="PSA 59:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 59:5"/>Tú, <char style="nd">Yavé ʼElohim</char> de las huestes, el <char style="nd">ʼElohim</char> de Israel.</para>
  <para style="q" vid="PSA 59:5">Despierta para castigar a todas las naciones.</para>
  <para style="q" vid="PSA 59:5">No tengas compasión de ningún traidor inicuo. <char style="tl">Selah</char><verse eid="PSA 59:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 59:6"/>Regresan al anochecer.</para>
  <para style="q" vid="PSA 59:6">Aúllan como perros y rodean la ciudad.<verse eid="PSA 59:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 59:7"/>Ciertamente pronuncian con su boca.</para>
  <para style="q" vid="PSA 59:7">Espadas hay en sus labios,</para>
  <para style="q" vid="PSA 59:7">Porque dicen: ¿Quién escucha?<verse eid="PSA 59:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 59:8"/>Pero Tú, oh <char style="nd">Yavé</char>, te ríes de ellos.</para>
  <para style="q" vid="PSA 59:8">Te burlas de todas las naciones.<verse eid="PSA 59:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 59:9"/>Oh Fortaleza mía, espero en Ti.</para>
  <para style="q" vid="PSA 59:9">
    <char style="nd">ʼElohim</char> es mi Fortaleza.<verse eid="PSA 59:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 59:10"/>Mi <char style="nd">ʼElohim</char>, con su misericordia saldrá a encontrarme.</para>
  <para style="q" vid="PSA 59:10">
    <char style="nd">ʼElohim</char> hará que yo vea mi deseo en mis adversarios.<verse eid="PSA 59:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 59:11"/>No los mates, no sea que olvide mi pueblo.</para>
  <para style="q" vid="PSA 59:11">Dispérsalos con tu poder y humíllalos, oh <char style="nd">ʼAdonay</char>, Escudo nuestro.<verse eid="PSA 59:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 59:12"/>Por el pecado de sus bocas,</para>
  <para style="q" vid="PSA 59:12">Por las palabras de sus labios sean ellos presos en su orgullo,</para>
  <para style="q" vid="PSA 59:12">Y por las maldiciones y la mentira que dicen.<verse eid="PSA 59:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 59:13"/>Acábalos con furor.</para>
  <para style="q" vid="PSA 59:13">Acábalos para que no existan,</para>
  <para style="q" vid="PSA 59:13">Y que se conozca hasta los confines de la tierra que <char style="nd">ʼElohim</char> gobierna en Jacob. <char style="tl">Selah</char><verse eid="PSA 59:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 59:14"/>Regresan al anochecer.</para>
  <para style="q" vid="PSA 59:14">Aúllan como perros y rodean la ciudad.<verse eid="PSA 59:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 59:15"/>Vagan buscando alimento</para>
  <para style="q" vid="PSA 59:15">Y gruñen si no están satisfechos.<verse eid="PSA 59:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 59:16"/>Pero yo cantaré de tu poder.</para>
  <para style="q" vid="PSA 59:16">Alabaré de mañana tu misericordia,</para>
  <para style="q" vid="PSA 59:16">Porque fuiste mi Fortaleza y mi Refugio en el día de mi angustia.<verse eid="PSA 59:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 59:17"/>Oh Fortaleza mía, te cantaré salmos.</para>
  <para style="q" vid="PSA 59:17">Porque Tú, <char style="nd">ʼElohim</char>, eres Fortaleza,</para>
  <para style="q" vid="PSA 59:17">Y el <char style="nd">ʼElohim</char> que me muestra misericordia.<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="s1">Al director del coro. Al modo del “Lirio del Testimonio”</para>
  <para style="s1">Canto a media voz (<char style="tl">Mictam</char>) de David, cuando combatió contra Siria Mesopotámica y contra Siria de Soba, y Joab regresó y derrotó a 12.000 edomitas en el valle de la Sal.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 60:1"/>Oh <char style="nd">ʼElohim</char>, Tú nos rechasaste.</para>
  <para style="q" vid="PSA 60:1">Tú nos desechaste, rompiste nuestras defensas.</para>
  <para style="q" vid="PSA 60:1">Te airaste. Vuelve a nosotros.<verse eid="PSA 60:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 60:2"/>Hiciste temblar la tierra, la agrietaste.</para>
  <para style="q" vid="PSA 60:2">Repara sus grietas, porque se tambalea.<verse eid="PSA 60:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 60:3"/>Hiciste sufrir a tu pueblo cosas duras.</para>
  <para style="q" vid="PSA 60:3">Nos hiciste beber vino de aturdimiento.<verse eid="PSA 60:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 60:4"/>Pero a tus fieles diste un estandarte</para>
  <para style="q" vid="PSA 60:4">Para que sea desplegado por causa de la verdad. <char style="tl">Selah</char><verse eid="PSA 60:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 60:5"/>Sálvanos con tu mano derecha, y respóndenos,</para>
  <para style="q" vid="PSA 60:5">Para que sean librados tus amados.<verse eid="PSA 60:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 60:6"/>
    <char style="nd">ʼElohim</char> respondió desde su Santuario:</para>
  <para style="q" vid="PSA 60:6">
    <char style="wj">¡Yo me alegraré!</char></para>
  <para style="q" vid="PSA 60:6">
    <char style="wj">Repartiré a Siquem,</char></para>
  <para style="q" vid="PSA 60:6">
    <char style="wj">Y mediré el valle de Sucot.</char><verse eid="PSA 60:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 60:7"/>
    <char style="wj">Mío es Galaad y mío es Manasés,</char></para>
  <para style="q" vid="PSA 60:7">
    <char style="wj">Efraín es el casco de mi cabeza,</char></para>
  <para style="q" vid="PSA 60:7">
    <char style="wj">Judá, mi cetro,</char><verse eid="PSA 60:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 60:8"/>
    <char style="wj">Moab, vasija para lavarme.</char></para>
  <para style="q" vid="PSA 60:8">
    <char style="wj">Sobre Edom echaré mi sandalia,</char></para>
  <para style="q" vid="PSA 60:8">
    <char style="wj">Y sobre Filistea lanzaré mi grito de victoria.</char><verse eid="PSA 60:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 60:9"/>¿Quién me conducirá a la ciudad fortificada?</para>
  <para style="q" vid="PSA 60:9">¿Quién me guiará a Edom?<verse eid="PSA 60:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 60:10"/>¿No eres Tú, oh <char style="nd">ʼElohim</char>, Quien nos rechazaste</para>
  <para style="q" vid="PSA 60:10">Y no sales con nuestros ejércitos, oh <char style="nd">ʼElohim</char>?<verse eid="PSA 60:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 60:11"/>Socórrenos ante el adversario,</para>
  <para style="q" vid="PSA 60:11">Porque vana es la liberación del hombre.<verse eid="PSA 60:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 60:12"/>Con <char style="nd">ʼElohim</char> haremos proezas.</para>
  <para style="q" vid="PSA 60:12">Él pisoteará a nuestros adversarios.<verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="s1">Al director del coro. Con música de cuerdas. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 61:1"/>Oh <char style="nd">ʼElohim</char>, oye mi clamor.</para>
  <para style="q" vid="PSA 61:1">Atiende mi súplica.<verse eid="PSA 61:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 61:2"/>Cuando mi corazón desmaya,</para>
  <para style="q" vid="PSA 61:2">Clamo a Ti desde el extremo de la tierra:</para>
  <para style="q" vid="PSA 61:2">Llévame a la Roca que es más alta que yo.<verse eid="PSA 61:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 61:3"/>Porque Tú fuiste mi Refugio,</para>
  <para style="q" vid="PSA 61:3">Torre fuerte contra el enemigo.<verse eid="PSA 61:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 61:4"/>Permite que yo viva en tu Tabernáculo para siempre</para>
  <para style="q" vid="PSA 61:4">Y que me refugie al amparo de tus alas. <char style="tl">Selah</char><verse eid="PSA 61:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 61:5"/>Porque Tú, <char style="nd">ʼElohim</char>, oíste mis votos.</para>
  <para style="q" vid="PSA 61:5">Diste heredad a los que temen tu Nombre.<verse eid="PSA 61:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 61:6"/>Prolongarás la vida del rey.</para>
  <para style="q" vid="PSA 61:6">Sus años serán como muchas generaciones.<verse eid="PSA 61:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 61:7"/>Estará para siempre delante de <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 61:7">Prepara misericordia y verdad para que lo preserven.<verse eid="PSA 61:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 61:8"/>Así cantaré alabanza a tu Nombre para siempre,</para>
  <para style="q" vid="PSA 61:8">A fin de pagar mis votos cada día.<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="s1">Al director del coro, para Jedutún. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 62:1"/>Solo en <char style="nd">ʼElohim</char> se aquieta mi alma.</para>
  <para style="q" vid="PSA 62:1">De Él viene mi salvación.<verse eid="PSA 62:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 62:2"/>Solo Él es mi Roca, mi Salvación, mi Refugio.</para>
  <para style="q" vid="PSA 62:2">No seré grandemente sacudido.<verse eid="PSA 62:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 62:3"/>¿Hasta cuándo atacarán a un hombre todos juntos para matarlo,</para>
  <para style="q" vid="PSA 62:3">Para derribarlo como a un muro desplomado o a una cerca insegura?<verse eid="PSA 62:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 62:4"/>Solo consultan para derribarlo de su alta posición.</para>
  <para style="q" vid="PSA 62:4">Se deleitan en la falsedad.</para>
  <para style="q" vid="PSA 62:4">Bendicen con su boca,</para>
  <para style="q" vid="PSA 62:4">Pero maldicen en su interior. <char style="tl">Selah</char><verse eid="PSA 62:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 62:5"/>Solo en <char style="nd">ʼElohim</char> cálmate, alma mía,</para>
  <para style="q" vid="PSA 62:5">Porque de Él viene mi esperanza.<verse eid="PSA 62:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 62:6"/>Solo Él es mi Roca, mi Salvación, mi alto Refugio.</para>
  <para style="q" vid="PSA 62:6">No seré sacudido.<verse eid="PSA 62:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 62:7"/>En <char style="nd">ʼElohim</char> está mi salvación y mi gloria.</para>
  <para style="q" vid="PSA 62:7">La Roca de mi fortaleza,</para>
  <para style="q" vid="PSA 62:7">Mi Refugio está en <char style="nd">ʼElohim</char>.<verse eid="PSA 62:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 62:8"/>Oh pueblo, confíen en Él en todo tiempo.</para>
  <para style="q" vid="PSA 62:8">Derramen su corazón ante Él.</para>
  <para style="q" vid="PSA 62:8">
    <char style="nd">ʼElohim</char> es nuestro Refugio. <char style="tl">Selah</char><verse eid="PSA 62:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 62:9"/>Los hombres de bajo grado son solo vanidad.</para>
  <para style="q" vid="PSA 62:9">Y los hombres de alto rango son una mentira.</para>
  <para style="q" vid="PSA 62:9">Puestos en balanza suben,</para>
  <para style="q" vid="PSA 62:9">Juntos son más livianos que un soplo.<verse eid="PSA 62:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 62:10"/>No confíen en la opresión,</para>
  <para style="q" vid="PSA 62:10">Ni se envanezcan en el robo.</para>
  <para style="q" vid="PSA 62:10">Si se aumentan las riquezas,</para>
  <para style="q" vid="PSA 62:10">No fijen el corazón en ellas.<verse eid="PSA 62:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 62:11"/>Una vez habló <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 62:11">Dos veces oí esto:</para>
  <para style="q" vid="PSA 62:11">Que el poder es de <char style="nd">ʼElohim</char>.<verse eid="PSA 62:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 62:12"/>La misericordia es tuya, oh <char style="nd">ʼAdonay</char>,</para>
  <para style="q" vid="PSA 62:12">Porque Tú pagas a cada uno según su obra.<verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="s1">Salmo de David, compuesto cuando estaba en el desierto de Judá</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 63:1"/>Oh <char style="nd">ʼElohim</char>, Tú eres mi <char style="nd">ʼEL</char>.</para>
  <para style="q" vid="PSA 63:1">Ansiosamente te busqué.</para>
  <para style="q" vid="PSA 63:1">Mi alma tiene sed de Ti.</para>
  <para style="q" vid="PSA 63:1">Mi cuerpo te anhela en tierra árida y deshabitada,</para>
  <para style="q" vid="PSA 63:1">Donde no hay agua.<verse eid="PSA 63:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 63:2"/>Así te busqué en el Santuario</para>
  <para style="q" vid="PSA 63:2">Para ver tu poder y tu gloria.<verse eid="PSA 63:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 63:3"/>Porque tu misericordia es mejor que la vida,</para>
  <para style="q" vid="PSA 63:3">Mis labios te alabarán.<verse eid="PSA 63:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 63:4"/>Por tanto te bendeciré en mi vida.</para>
  <para style="q" vid="PSA 63:4">En tu Nombre alzaré mis manos.<verse eid="PSA 63:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 63:5"/>Como con médula y sustancia está saciada mi alma.</para>
  <para style="q" vid="PSA 63:5">Mi boca te alaba con labios jubilosos.<verse eid="PSA 63:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 63:6"/>Cuando en mi cama me acuerdo de Ti,</para>
  <para style="q" vid="PSA 63:6">Cuando medito en Ti en las vigilias<note caller="+" style="f"><char style="fr" closed="false">63.6 </char><char style="ft" closed="false">Dividían la noche en cuatro partes llamada vigilias: de 6 a 9, de 9 a 12, de 12 a 3, de 3 a 6. </char></note> de la noche.<verse eid="PSA 63:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 63:7"/>Porque Tú eres mi Socorro.</para>
  <para style="q" vid="PSA 63:7">Bajo la sombra de tus alas canto con gozo.<verse eid="PSA 63:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 63:8"/>Mi alma está apegada a Ti.</para>
  <para style="q" vid="PSA 63:8">Tu mano derecha me sostiene.<verse eid="PSA 63:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 63:9"/>Pero los que buscan mi vida para destruirla</para>
  <para style="q" vid="PSA 63:9">Caerán en las profundidades más bajas de la tierra.<verse eid="PSA 63:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 63:10"/>Serán destruidos a filo de espada.</para>
  <para style="q" vid="PSA 63:10">Serán presa de los chacales.<verse eid="PSA 63:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 63:11"/>Pero el rey se regocija en <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 63:11">Cualquiera que jura por Él será alabado,</para>
  <para style="q" vid="PSA 63:11">Porque las bocas de los que dicen mentiras serán tapadas.<verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="s1">Al director del coro. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 64:1"/>Escucha, oh <char style="nd">ʼElohim</char>, la voz de mi queja:</para>
  <para style="q" vid="PSA 64:1">Preserva mi vida del terror de perversos.<verse eid="PSA 64:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 64:2"/>Ocúltame de la conspiración de malhechores,</para>
  <para style="q" vid="PSA 64:2">Del tumulto de los que hacen iniquidad,<verse eid="PSA 64:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 64:3"/>Que afilan sus lenguas como una espada,</para>
  <para style="q" vid="PSA 64:3">Y la emplean como su flecha en un lenguaje amargo<verse eid="PSA 64:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 64:4"/>Para dispararlas en oculto al inocente.</para>
  <para style="q" vid="PSA 64:4">De repente disparan sus flechas, sin que teman.<verse eid="PSA 64:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 64:5"/>Se animan unos a otros en su perverso designio</para>
  <para style="q" vid="PSA 64:5">Y planean esconder trampas.</para>
  <para style="q" vid="PSA 64:5">Dicen: ¿Quién las verá?<verse eid="PSA 64:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 64:6"/>Traman injusticias y dicen:</para>
  <para style="q" vid="PSA 64:6">Estamos listos con una conspiración bien concebida.</para>
  <para style="q" vid="PSA 64:6">Tanto el pensamiento íntimo como el corazón del hombre son profundos.<verse eid="PSA 64:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 64:7"/>Pero <char style="nd">ʼElohim</char> les dispara una flecha.</para>
  <para style="q" vid="PSA 64:7">De repente vendrán sus plagas.<verse eid="PSA 64:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 64:8"/>Así que ellas los hacen tropezar.</para>
  <para style="q" vid="PSA 64:8">Los que los ven menean la cabeza.<verse eid="PSA 64:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 64:9"/>Entonces temerán todos los hombres.</para>
  <para style="q" vid="PSA 64:9">Proclamarán la obra de <char style="nd">ʼElohim</char></para>
  <para style="q" vid="PSA 64:9">Y entenderán sus hechos.<verse eid="PSA 64:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 64:10"/>El justo se alegrará en <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 64:10">Y se confiará en Él.</para>
  <para style="q" vid="PSA 64:10">Se gloriarán todos los rectos de corazón.<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="s1">Al director del coro. Salmo de David. Canto</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 65:1"/>A Ti te corresponde la alabanza en Sion, oh <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 65:1">A Ti se pagará el voto.<verse eid="PSA 65:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 65:2"/>Tú escuchas la oración.</para>
  <para style="q" vid="PSA 65:2">A Ti acudirá todo hombre.<verse eid="PSA 65:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 65:3"/>Las palabras de iniquidad prevalecen contra mí.</para>
  <para style="q" vid="PSA 65:3">Tú perdonas nuestras transgresiones.<verse eid="PSA 65:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 65:4"/>Inmensamente feliz es aquél a quien Tú escoges</para>
  <para style="q" vid="PSA 65:4">Y acercas a Ti para que viva en tus patios.<note caller="+" style="f"><char style="fr" closed="false">65.4 </char><char style="ft" closed="false">En el Templo construido por Herodes había tres: uno para los gentiles, otros para los israelitas y otro para los sacerdotes.</char></note></para>
  <para style="q" vid="PSA 65:4">Seremos saciados con la abundancia de tu Casa, de tu santo Templo.<verse eid="PSA 65:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 65:5"/>Nos responderás con tremendas proezas de justicia,</para>
  <para style="q" vid="PSA 65:5">Oh <char style="nd">ʼElohim</char> de nuestra salvación.</para>
  <para style="q" vid="PSA 65:5">¡Tú eres la Esperanza de todos los confines de la tierra,</para>
  <para style="q" vid="PSA 65:5">Y del más lejano mar!<verse eid="PSA 65:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 65:6"/>Tú, el que afirmas las montañas con tu fortaleza,</para>
  <para style="q" vid="PSA 65:6">Atado con valentía.<verse eid="PSA 65:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 65:7"/>El que calma el estruendo de los mares,</para>
  <para style="q" vid="PSA 65:7">El estruendo de sus olas,</para>
  <para style="q" vid="PSA 65:7">Y el alboroto de las naciones.<verse eid="PSA 65:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 65:8"/>Los que viven en los confines se asombran de tus maravillas.</para>
  <para style="q" vid="PSA 65:8">Tú haces clamar con júbilo al alba y al ocaso.<verse eid="PSA 65:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 65:9"/>Visitas la tierra y la inundas.</para>
  <para style="q" vid="PSA 65:9">La enriqueces muchísimo.</para>
  <para style="q" vid="PSA 65:9">El torrente de <char style="nd">ʼElohim</char> está lleno de agua.</para>
  <para style="q" vid="PSA 65:9">Preparas el grano de ellos</para>
  <para style="q" vid="PSA 65:9">Porque así Tú preparas la tierra.<verse eid="PSA 65:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 65:10"/>Inundas sus surcos,</para>
  <para style="q" vid="PSA 65:10">Haces descender el agua en sus canales,</para>
  <para style="q" vid="PSA 65:10">Ablandas sus terrones,</para>
  <para style="q" vid="PSA 65:10">Y bendices sus brotes.<verse eid="PSA 65:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 65:11"/>Coronas el año con generosidad,</para>
  <para style="q" vid="PSA 65:11">Y tus sendas destilan sustancia.<verse eid="PSA 65:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 65:12"/>Gotean los pastizales del desierto,</para>
  <para style="q" vid="PSA 65:12">Y las colinas se atan con regocijo.<verse eid="PSA 65:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 65:13"/>Los prados se cubren de rebaños,</para>
  <para style="q" vid="PSA 65:13">Los valles se cubren de grano.</para>
  <para style="q" vid="PSA 65:13">Dan gritos de júbilo y cantan.<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="s1">Al director del coro. Canto. Salmo</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 66:1"/>Aclame a <char style="nd">ʼElohim</char>, toda la tierra.<verse eid="PSA 66:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 66:2"/>Canten la gloria de su Nombre.</para>
  <para style="q" vid="PSA 66:2">Hagan gloriosa su alabanza.<verse eid="PSA 66:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 66:3"/>Digan a <char style="nd">ʼElohim</char>:</para>
  <para style="q" vid="PSA 66:3">¡Cuán asombrosas son tus obras!</para>
  <para style="q" vid="PSA 66:3">Por la grandeza de tu poder</para>
  <para style="q" vid="PSA 66:3">Se someterán a Ti tus enemigos.<verse eid="PSA 66:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 66:4"/>Toda la tierra te adorará</para>
  <para style="q" vid="PSA 66:4">Y cantará alabanzas a Ti.</para>
  <para style="q" vid="PSA 66:4">Cantarán salmos a tu Nombre. <char style="tl">Selah</char><verse eid="PSA 66:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 66:5"/>Vengan y contemplen las obras de <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 66:5">Admirable en sus hechos para los hijos de <char style="add">los</char> hombres.<verse eid="PSA 66:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 66:6"/>Convirtió el mar en tierra seca.</para>
  <para style="q" vid="PSA 66:6">Por el río pasaron a pie.</para>
  <para style="q" vid="PSA 66:6">Allí nos regocijamos en Él.<verse eid="PSA 66:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 66:7"/>Él gobierna con su poder para siempre.</para>
  <para style="q" vid="PSA 66:7">Sus ojos vigilan las naciones.</para>
  <para style="q" vid="PSA 66:7">No se enaltezcan los rebeldes. <char style="tl">Selah</char><verse eid="PSA 66:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 66:8"/>Bendigan, pueblos, a nuestro <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 66:8">Y proclamen la voz de su alabanza.<verse eid="PSA 66:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 66:9"/>Él preserva la vida a nuestra alma</para>
  <para style="q" vid="PSA 66:9">Y no permite que resbale nuestro pie.<verse eid="PSA 66:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 66:10"/>Porque Tú nos probaste, oh <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 66:10">Nos purificaste en el crisol como se purifica la plata.<verse eid="PSA 66:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 66:11"/>Nos metiste en la red.</para>
  <para style="q" vid="PSA 66:11">Pusiste sobre nuestra cintura una carga muy pesada.<verse eid="PSA 66:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 66:12"/>Ordenaste que los hombres cabalgaran sobre nuestras cabezas.</para>
  <para style="q" vid="PSA 66:12">Pasamos por el fuego y por el agua.</para>
  <para style="q" vid="PSA 66:12">Pero luego nos sacaste a la abundancia.<verse eid="PSA 66:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 66:13"/>Entraré en tu Casa con holocaustos.</para>
  <para style="q" vid="PSA 66:13">Te pagaré mis votos<verse eid="PSA 66:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 66:14"/>Que pronunciaron mis labios,</para>
  <para style="q" vid="PSA 66:14">Que mi boca dijo cuando estaba angustiado.<verse eid="PSA 66:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 66:15"/>Te ofreceré holocaustos engordados con el humo de carneros.</para>
  <para style="q" vid="PSA 66:15">Te ofreceré becerros y machos cabríos. <char style="tl">Selah</char><verse eid="PSA 66:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 66:16"/>Vengan, escuchen todos los que temen a <char style="nd">ʼElohim</char></para>
  <para style="q" vid="PSA 66:16">Y relataré lo que hizo por mi vida.<verse eid="PSA 66:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 66:17"/>A Él clamé con mi boca,</para>
  <para style="q" vid="PSA 66:17">Y Él fue exaltado con mi lengua.<verse eid="PSA 66:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 66:18"/>Si en mi corazón tuviera yo iniquidad</para>
  <para style="q" vid="PSA 66:18">
    <char style="nd">ʼAdonay</char> no me habría escuchado.<verse eid="PSA 66:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 66:19"/>Pero ciertamente <char style="nd">ʼElohim</char> me escuchó</para>
  <para style="q" vid="PSA 66:19">Y atendió la voz de mi súplica.<verse eid="PSA 66:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 66:20"/>Bendito sea <char style="nd">ʼElohim</char>, Quien no desechó mi oración,</para>
  <para style="q" vid="PSA 66:20">Ni apartó de mí su misericordia.<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="s1">Al director del coro. Con instrumentos de cuerda. Salmo. Canto</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 67:1"/>
    <char style="nd">ʼElohim</char> tenga compasión de nosotros y nos bendiga,</para>
  <para style="q" vid="PSA 67:1">Resplandezca su rostro sobre nosotros, <char style="tl">Selah</char><verse eid="PSA 67:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 67:2"/>Para que tu camino sea conocido en la tierra,</para>
  <para style="q" vid="PSA 67:2">Y tu salvación en todas las naciones.<verse eid="PSA 67:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 67:3"/>Que los pueblos te alaben, oh <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 67:3">Que todos los pueblos te alaben.<verse eid="PSA 67:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 67:4"/>Que se regocijen y canten con júbilo las naciones.</para>
  <para style="q" vid="PSA 67:4">Porque Tú juzgarás a los pueblos con equidad,</para>
  <para style="q" vid="PSA 67:4">Y guiarás a las naciones de la tierra. <char style="tl">Selah</char><verse eid="PSA 67:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 67:5"/>Que te alaben los pueblos, oh <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 67:5">Que todos los pueblos te alaben.<verse eid="PSA 67:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 67:6"/>La tierra dio su fruto.</para>
  <para style="q" vid="PSA 67:6">
    <char style="nd">ʼElohim</char>, el <char style="nd">ʼElohim</char> nuestro, nos bendice.<verse eid="PSA 67:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 67:7"/>
    <char style="nd">ʼElohim</char> nos bendiga.</para>
  <para style="q" vid="PSA 67:7">Que le teman todos los confines de la tierra.<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="s1">Al director del coro. Salmo de David. Canto</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 68:1"/>Levántese <char style="nd">ʼElohim</char>, sean esparcidos sus enemigos.</para>
  <para style="q" vid="PSA 68:1">Huyan de tu Presencia los que lo aborrecen.<verse eid="PSA 68:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 68:2"/>Desvanécelos como se desvanece el humo.</para>
  <para style="q" vid="PSA 68:2">Como se derrite la cera ante el fuego,</para>
  <para style="q" vid="PSA 68:2">Perezcan así los perversos en la Presencia de <char style="nd">ʼElohim</char>.<verse eid="PSA 68:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 68:3"/>Pero que se alegren los justos,</para>
  <para style="q" vid="PSA 68:3">Y sean regocijados ante <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 68:3">Que se regocijen con alegría.<verse eid="PSA 68:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 68:4"/>Canten a <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 68:4">Canten salmos a su Nombre.</para>
  <para style="q" vid="PSA 68:4">Exalten al que cabalga sobre los cielos.</para>
  <para style="q" vid="PSA 68:4">
    <char style="nd">YA</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">68.4 </char>
      <char style="ft" closed="false">
        <char style="nd">YA</char> es abreviatura de <char style="nd">Yavé</char>.</char>
    </note> es su Nombre.</para>
  <para style="q" vid="PSA 68:4">Regocíjense ante Él.<verse eid="PSA 68:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 68:5"/>Padre de huérfanos y Juez de viudas es <char style="nd">ʼElohim</char> en su Santuario,<verse eid="PSA 68:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 68:6"/>El <char style="nd">ʼElohim</char> que hace un hogar a los desamparados,</para>
  <para style="q" vid="PSA 68:6">Quien saca los cautivos a prosperidad.</para>
  <para style="q" vid="PSA 68:6">Pero los rebeldes viven en tierra seca.<verse eid="PSA 68:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 68:7"/>Oh <char style="nd">ʼElohim</char>, cuando saliste delante de tu pueblo,</para>
  <para style="q" vid="PSA 68:7">Cuando anduviste por el desierto, <char style="tl">Selah</char><verse eid="PSA 68:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 68:8"/>La tierra tembló.</para>
  <para style="q" vid="PSA 68:8">Los cielos también destilaron ante <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 68:8">La misma <char style="add">Montaña</char> Sinaí tembló ante la Presencia de <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 68:8">El <char style="nd">ʼElohim</char> de Israel.<verse eid="PSA 68:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 68:9"/>Una lluvia abundante derramaste, oh <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 68:9">Tú reanimaste tu heredad</para>
  <para style="q" vid="PSA 68:9">Cuando estaba exhausta.<verse eid="PSA 68:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 68:10"/>Tus criaturas se establecieron en ella,</para>
  <para style="q" vid="PSA 68:10">La que en tu bondad, oh <char style="nd">ʼElohim</char>, proveíste para el pobre.<verse eid="PSA 68:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 68:11"/>
    <char style="nd">ʼAdonay</char> da la orden,</para>
  <para style="q" vid="PSA 68:11">Y una gran hueste de mujeres anuncia las buenas noticias.<verse eid="PSA 68:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 68:12"/>Huyeron, huyeron los reyes de ejércitos,</para>
  <para style="q" vid="PSA 68:12">Y las que se quedaban en casa repartían los despojos.<verse eid="PSA 68:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 68:13"/>Aunque fueron echados entre los tiestos,</para>
  <para style="q" vid="PSA 68:13">Serán como alas de paloma cubiertas de plata</para>
  <para style="q" vid="PSA 68:13">Y sus plumas, con brillo de oro.<verse eid="PSA 68:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 68:14"/>Cuando el Omnipotente esparció allí a los reyes</para>
  <para style="q" vid="PSA 68:14">Fue como cuando nieva en Salmón.<verse eid="PSA 68:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 68:15"/>Montaña de <char style="nd">ʼElohim</char> es la montaña de Basán.</para>
  <para style="q" vid="PSA 68:15">Una montaña alta es la de Basán.<verse eid="PSA 68:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 68:16"/>¿Por qué, oh montañas de picos,</para>
  <para style="q" vid="PSA 68:16">Miran con envidia a la Montaña que <char style="nd">ʼElohim</char> deseó para su morada?</para>
  <para style="q" vid="PSA 68:16">Ciertamente <char style="nd">Yavé</char> morará en ella para siempre.<verse eid="PSA 68:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 68:17"/>Las carrozas de <char style="nd">ʼElohim</char> son miríadas de miríadas, y millares de millares.</para>
  <para style="q" vid="PSA 68:17">Desde Sinaí, <char style="nd">ʼAdonay</char> avanza entre ellas al Santuario.<verse eid="PSA 68:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 68:18"/>Ascendiste a lo alto,</para>
  <para style="q" vid="PSA 68:18">Llevaste cautivos a <char style="add">tus</char> cautivos.</para>
  <para style="q" vid="PSA 68:18">Recibiste dones entre los hombres,</para>
  <para style="q" vid="PSA 68:18">Aun de los rebeldes,</para>
  <para style="q" vid="PSA 68:18">Para que <char style="nd">YA ʼElohim</char> more allí.<verse eid="PSA 68:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 68:19"/>Bendito sea <char style="nd">ʼAdonay</char>,</para>
  <para style="q" vid="PSA 68:19">Quien diariamente lleva nuestra carga,</para>
  <para style="q" vid="PSA 68:19">El <char style="nd">ʼEL</char> de nuestra salvación. <char style="tl">Selah</char><verse eid="PSA 68:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 68:20"/>Nuestro <char style="nd">ʼEL</char> es el <char style="nd">ʼEL</char> de salvación.</para>
  <para style="q" vid="PSA 68:20">A <char style="nd">Yavé</char> nuestro <char style="nd">ʼAdonay</char> corresponde el librar de la muerte.<verse eid="PSA 68:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 68:21"/>Ciertamente <char style="nd">ʼElohim</char> herirá la cabeza de sus enemigos,</para>
  <para style="q" vid="PSA 68:21">La coronilla cabelluda del que anda en sus transgresiones.<verse eid="PSA 68:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PSA 68:22"/>
    <char style="nd">ʼAdonay</char> dijo: <char style="wj">De Basán los devolveré.</char></para>
  <para style="q" vid="PSA 68:22">
    <char style="wj">Los devolveré de las profundidades del mar,</char><verse eid="PSA 68:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 68:23"/>
    <char style="wj">Para que tu pie los aplaste en sangre,</char></para>
  <para style="q" vid="PSA 68:23">
    <char style="wj">Y la lengua de tus perros tenga su porción de tus enemigos.</char><verse eid="PSA 68:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PSA 68:24"/>Vieron tu cortejo, oh <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 68:24">El cortejo de mi <char style="nd">ʼEL,</char> mi Rey en el Santuario.<verse eid="PSA 68:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 68:25"/>Los cantores van adelante,</para>
  <para style="q" vid="PSA 68:25">Los músicos detrás.</para>
  <para style="q" vid="PSA 68:25">Entre unos y otros van las doncellas que tocan panderetas.<verse eid="PSA 68:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PSA 68:26"/>Bendigan a <char style="nd">ʼElohim</char> en las congregaciones,</para>
  <para style="q" vid="PSA 68:26">Al <char style="nd">ʼAdonay</char> de la fuente de Israel.<verse eid="PSA 68:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 68:27"/>Allí está Benjamín, el menor, quien los dirige,</para>
  <para style="q" vid="PSA 68:27">Los jefes de Judá con su multitud,</para>
  <para style="q" vid="PSA 68:27">Los jefes de Zabulón,</para>
  <para style="q" vid="PSA 68:27">Los jefes de Neftalí.<verse eid="PSA 68:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PSA 68:28"/>Tu <char style="nd">ʼElohim</char> comandó tu fuerza.</para>
  <para style="q" vid="PSA 68:28">Oh <char style="nd">ʼElohim</char>, Tú actuaste por nosotros.</para>
  <para style="q" vid="PSA 68:28">Muéstrate fuerte.<verse eid="PSA 68:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PSA 68:29"/>Por causa de tu Templo en Jerusalén los reyes te traerán regalos.<verse eid="PSA 68:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 68:30"/>Reprende las bestias salvajes que están entre los juncos,</para>
  <para style="q" vid="PSA 68:30">La manada de toros con los becerros de los pueblos,</para>
  <para style="q" vid="PSA 68:30">Que pisotean las piezas de plata.</para>
  <para style="q" vid="PSA 68:30">Esparce a los pueblos que se complacen en la guerra.<verse eid="PSA 68:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 68:31"/>Embajadores vendrán de Egipto.</para>
  <para style="q" vid="PSA 68:31">Etiopía extenderá sus manos a <char style="nd">ʼElohim</char>.<verse eid="PSA 68:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PSA 68:32"/>Oh reinos de la tierra, canten a <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 68:32">Canten salmos a <char style="nd">ʼAdonay</char>. <char style="tl">Selah</char><verse eid="PSA 68:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 68:33"/>Al que cabalga sobre el cielo de los cielos,</para>
  <para style="q" vid="PSA 68:33">Que son desde la antigüedad,</para>
  <para style="q" vid="PSA 68:33">Ciertamente emite su voz, su poderosa voz.<verse eid="PSA 68:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 68:34"/>Atribuyan fortaleza a <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 68:34">Su magnificencia es sobre Israel</para>
  <para style="q" vid="PSA 68:34">Y su poder está en las nubes.<verse eid="PSA 68:34"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="35" style="v" sid="PSA 68:35"/>¡Oh <char style="nd">ʼElohim</char>, Tú eres asombroso desde tu Santuario!</para>
  <para style="q" vid="PSA 68:35">El mismo <char style="nd">ʼEL</char> de Israel da vigor y poder al pueblo.</para>
  <para style="q" vid="PSA 68:35">¡Bendito sea <char style="nd">ʼElohim</char>!<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="s1">Al director del coro. Según “Los lirios”. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 69:1"/>Sálvame, oh <char style="nd">ʼElohim</char>, porque las aguas amenazan mi vida.<verse eid="PSA 69:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 69:2"/>Estoy hundido en lodo profundo,</para>
  <para style="q" vid="PSA 69:2">Y no hay donde asentar pie.</para>
  <para style="q" vid="PSA 69:2">Entré en aguas profundas,</para>
  <para style="q" vid="PSA 69:2">Y un diluvio me inunda.<verse eid="PSA 69:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 69:3"/>Estoy cansado de llamar.</para>
  <para style="q" vid="PSA 69:3">Mi garganta enronqueció.</para>
  <para style="q" vid="PSA 69:3">Mis ojos desfallecen mientras espero a mi <char style="nd">ʼElohim</char>.<verse eid="PSA 69:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 69:4"/>Aumentaron más que los cabellos de mi cabeza los que me odian sin causa.</para>
  <para style="q" vid="PSA 69:4">Son fuertes los que quieren destruirme.</para>
  <para style="q" vid="PSA 69:4">Se declararon enemigos míos sin causa.</para>
  <para style="q" vid="PSA 69:4">Y tengo que pagar lo que no robé.<verse eid="PSA 69:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 69:5"/>Oh <char style="nd">ʼElohim</char>, Tú conoces mi insensatez.</para>
  <para style="q" vid="PSA 69:5">Mis pecados no te son ocultos.<verse eid="PSA 69:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 69:6"/>No sean avergonzados por mi causa los que en Ti esperan,</para>
  <para style="q" vid="PSA 69:6">Oh <char style="nd">ʼAdonay Yavé</char> de las huestes.</para>
  <para style="q" vid="PSA 69:6">No sean avergonzados por mi causa los que te buscan,</para>
  <para style="q" vid="PSA 69:6">Oh <char style="nd">ʼAdonay Yavé</char> de las huestes.</para>
  <para style="q" vid="PSA 69:6">Que los que te buscan no sean deshonrados por mí,</para>
  <para style="q" vid="PSA 69:6">Oh <char style="nd">ʼElohim</char> de Israel.<verse eid="PSA 69:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 69:7"/>Porque por tu causa he sufrido afrenta.</para>
  <para style="q" vid="PSA 69:7">Vergüenza cubrió mi semblante.<verse eid="PSA 69:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 69:8"/>Me volví extraño para mis hermanos,</para>
  <para style="q" vid="PSA 69:8">Y extranjero para los hijos de mi madre.<verse eid="PSA 69:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 69:9"/>Porque el celo de tu Casa me consume,</para>
  <para style="q" vid="PSA 69:9">Y las ofensas de los que te reprochan</para>
  <para style="q" vid="PSA 69:9">Cayeron sobre mí.<verse eid="PSA 69:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 69:10"/>Me afligí a mí mismo con ayuno.</para>
  <para style="q" vid="PSA 69:10">Y esto fue mi afrenta.<verse eid="PSA 69:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 69:11"/>Usé tela áspera como ropa,</para>
  <para style="q" vid="PSA 69:11">Y fui para ellos un refrán.<verse eid="PSA 69:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 69:12"/>Los que se sientan en la puerta murmuran contra mí,</para>
  <para style="q" vid="PSA 69:12">Y soy el canto de los borrachos.<verse eid="PSA 69:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 69:13"/>Pero yo elevo mi oración a Ti, oh <char style="nd">Yavé</char>, en el tiempo aceptable.</para>
  <para style="q" vid="PSA 69:13">Oh <char style="nd">ʼElohim</char>, por la grandeza de tu misericordia,</para>
  <para style="q" vid="PSA 69:13">Respóndeme con la verdad de tu salvación.<verse eid="PSA 69:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 69:14"/>Sácame del lodo,</para>
  <para style="q" vid="PSA 69:14">Y no dejes que me hunda.</para>
  <para style="q" vid="PSA 69:14">Que yo sea librado de los que me aborrecen</para>
  <para style="q" vid="PSA 69:14">Y de las aguas profundas.<verse eid="PSA 69:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 69:15"/>Que no me ahogue el diluvio de agua,</para>
  <para style="q" vid="PSA 69:15">Ni me sorba el abismo,</para>
  <para style="q" vid="PSA 69:15">Ni la fosa cierre sobre mí su boca.<verse eid="PSA 69:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 69:16"/>Respóndeme, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 69:16">Porque tu misericordia es buena.</para>
  <para style="q" vid="PSA 69:16">Vuélvete a mí conforme a la grandeza de tu misericordia.<verse eid="PSA 69:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 69:17"/>No escondas tu rostro de tu esclavo,</para>
  <para style="q" vid="PSA 69:17">Porque estoy en angustia.</para>
  <para style="q" vid="PSA 69:17">Respóndeme prontamente.<verse eid="PSA 69:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 69:18"/>Acércate a mi vida y redímela.</para>
  <para style="q" vid="PSA 69:18">Rescátame a causa de mis enemigos.<verse eid="PSA 69:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 69:19"/>Tú conoces mi afrenta, mi vergüenza y mi oprobio.</para>
  <para style="q" vid="PSA 69:19">Delante de Ti están todos mis adversarios.<verse eid="PSA 69:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 69:20"/>La afrenta quebrantó mi corazón,</para>
  <para style="q" vid="PSA 69:20">Y estoy enfermo.</para>
  <para style="q" vid="PSA 69:20">Busqué compasión, y no hubo,</para>
  <para style="q" vid="PSA 69:20">Y consoladores, pero ninguno hallé.<verse eid="PSA 69:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 69:21"/>Me dieron además hiel como alimento,</para>
  <para style="q" vid="PSA 69:21">Y en mi sed me dieron a beber vinagre.<verse eid="PSA 69:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PSA 69:22"/>Vuélvase su mesa delante de ellos una trampa.</para>
  <para style="q" vid="PSA 69:22">Y cuando ellos estén seguros en paz,</para>
  <para style="q" vid="PSA 69:22">Se convierta en trampa para ellos.<verse eid="PSA 69:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 69:23"/>Sean oscurecidos sus ojos para que no vean,</para>
  <para style="q" vid="PSA 69:23">Y que sus cinturas tiemblen continuamente.<verse eid="PSA 69:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PSA 69:24"/>Derrama tu indignación sobre ellos,</para>
  <para style="q" vid="PSA 69:24">Y alcánzalos con tu ardiente furor.<verse eid="PSA 69:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 69:25"/>Sea su campamento desolado,</para>
  <para style="q" vid="PSA 69:25">Que nadie viva en sus tiendas.<verse eid="PSA 69:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 69:26"/>Porque persiguen al que Tú mismo mataste,</para>
  <para style="q" vid="PSA 69:26">Y comentan el dolor de los que Tú heriste.<verse eid="PSA 69:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PSA 69:27"/>Añade iniquidad a su iniquidad,</para>
  <para style="q" vid="PSA 69:27">Y no entren ellos en tu justicia.<verse eid="PSA 69:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 69:28"/>Sean borrados del rollo de la vida,</para>
  <para style="q" vid="PSA 69:28">Y no sean inscritos con los justos.<verse eid="PSA 69:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PSA 69:29"/>Pero yo estoy afligido y adolorido.</para>
  <para style="q" vid="PSA 69:29">Que tu salvación me ponga en alto, oh <char style="nd">ʼElohim</char>.<verse eid="PSA 69:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 69:30"/>Yo alabaré el Nombre de <char style="nd">ʼElohim</char> con canto,</para>
  <para style="q" vid="PSA 69:30">Y lo exaltaré con acción de gracias.<verse eid="PSA 69:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 69:31"/>Y agradará a <char style="nd">Yavé</char> más que el sacrificio de un buey,</para>
  <para style="q" vid="PSA 69:31">O un novillo con cuernos y pezuñas.<verse eid="PSA 69:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PSA 69:32"/>Lo ven los humildes y se alegran.</para>
  <para style="q" vid="PSA 69:32">Ustedes, los que buscan a <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 69:32">Que reviva su corazón.<verse eid="PSA 69:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 69:33"/>Porque <char style="nd">Yavé</char> oye a los menesterosos,</para>
  <para style="q" vid="PSA 69:33">Y no desprecia a sus prisioneros.<verse eid="PSA 69:33"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="34" style="v" sid="PSA 69:34"/>¡Alábenlo los cielos y la tierra,</para>
  <para style="q" vid="PSA 69:34">Los mares, y todo lo que se mueve en ellos!<verse eid="PSA 69:34"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="35" style="v" sid="PSA 69:35"/>Porque <char style="nd">ʼElohim</char> salvará a Sion,</para>
  <para style="q" vid="PSA 69:35">Y edificará las ciudades de Judá</para>
  <para style="q" vid="PSA 69:35">Para que vivan allí y las posean.<verse eid="PSA 69:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 69:36"/>Los descendientes de tus esclavos la heredan,</para>
  <para style="q" vid="PSA 69:36">Y los que aman tu Nombre habitarán en ella.<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="s1">Al director del coro. Salmo de David. En conmemoración</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 70:1"/>Oh <char style="nd">ʼElohim</char>, apresúrate a librarme.</para>
  <para style="q" vid="PSA 70:1">Apresúrate, oh <char style="nd">Yavé</char>, a socorrerme.<verse eid="PSA 70:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 70:2"/>Sean avergonzados y humillados</para>
  <para style="q" vid="PSA 70:2">Los que buscan mi vida,</para>
  <para style="q" vid="PSA 70:2">Sean vueltos atrás y confundidos</para>
  <para style="q" vid="PSA 70:2">Los que desean mi mal.<verse eid="PSA 70:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 70:3"/>Sean vueltos atrás a causa de su vergüenza</para>
  <para style="q" vid="PSA 70:3">Los que dicen: ¡Ea, ea!<verse eid="PSA 70:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 70:4"/>Regocíjense y alégrense en Ti todos los que te buscan.</para>
  <para style="q" vid="PSA 70:4">Y aquellos que aman tu salvación digan siempre:</para>
  <para style="q" vid="PSA 70:4">¡Engrandecido sea <char style="nd">ʼElohim</char>!<verse eid="PSA 70:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 70:5"/>Pero yo estoy afligido y menesteroso.</para>
  <para style="q" vid="PSA 70:5">Oh <char style="nd">ʼElohim</char>, apresúrate a mí.</para>
  <para style="q" vid="PSA 70:5">Tú eres mi Ayudador y mi Libertador.</para>
  <para style="q" vid="PSA 70:5">Oh <char style="nd">Yavé</char>, no demores.<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 71:1"/>Oh <char style="nd">Yavé</char>, en Ti me refugié.</para>
  <para style="q" vid="PSA 71:1">No sea yo avergonzado jamás.<verse eid="PSA 71:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 71:2"/>¡Líbrame en tu justicia y rescátame!</para>
  <para style="q" vid="PSA 71:2">¡Inclina a mí tu oído y sálvame!<verse eid="PSA 71:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 71:3"/>Sé Roca de habitación para mí</para>
  <para style="q" vid="PSA 71:3">A la cual yo acuda continuamente.</para>
  <para style="q" vid="PSA 71:3">Tú diste mandamiento para salvarme,</para>
  <para style="q" vid="PSA 71:3">Porque Tú eres mi Roca y mi Fortaleza.<verse eid="PSA 71:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 71:4"/>Oh mi <char style="nd">ʼElohim</char>, rescátame de la mano del perverso,</para>
  <para style="q" vid="PSA 71:4">De la mano del hombre malhechor y violento.<verse eid="PSA 71:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 71:5"/>Porque Tú, oh <char style="nd">ʼAdonay Yavé</char>, eres mi Esperanza,</para>
  <para style="q" vid="PSA 71:5">Mi Confianza desde mi juventud.<verse eid="PSA 71:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 71:6"/>Por Ti fui sustentado desde mi nacimiento.</para>
  <para style="q" vid="PSA 71:6">Tú eres Quien me sacó del vientre de mi madre.</para>
  <para style="q" vid="PSA 71:6">Mi alabanza es para Ti continuamente.<verse eid="PSA 71:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 71:7"/>Fui asombro para muchos,</para>
  <para style="q" vid="PSA 71:7">Porque Tú eres mi fuerte Refugio.<verse eid="PSA 71:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 71:8"/>Llena está mi boca de tu alabanza,</para>
  <para style="q" vid="PSA 71:8">Y de tu gloria todo el día.<verse eid="PSA 71:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 71:9"/>No me deseches en el tiempo de la vejez,</para>
  <para style="q" vid="PSA 71:9">Ni me desampares cuando se agote mi fuerza.<verse eid="PSA 71:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 71:10"/>Porque mis enemigos hablaron contra mí,</para>
  <para style="q" vid="PSA 71:10">Y los que acechan mi vida consultaron<verse eid="PSA 71:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 71:11"/>Y dijeron: <char style="nd">ʼElohim</char> lo desamparó.</para>
  <para style="q" vid="PSA 71:11">¡Persíganlo y agárrenlo, pues no hay quien lo libre!<verse eid="PSA 71:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 71:12"/>¡Oh <char style="nd">ʼElohim</char>, no te alejes de mí!</para>
  <para style="q" vid="PSA 71:12">¡Oh mi <char style="nd">ʼElohim</char>, apresúrate a socorrerme!<verse eid="PSA 71:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 71:13"/>Sean avergonzados y consumidos los adversarios de mi vida.</para>
  <para style="q" vid="PSA 71:13">Sean cubiertos de vergüenza y confusión los que procuran hacerme daño.<verse eid="PSA 71:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 71:14"/>En cuanto a mí, esperaré continuamente,</para>
  <para style="q" vid="PSA 71:14">Y te alabaré aun más y más.<verse eid="PSA 71:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 71:15"/>Mi boca proclamará tu justicia y tu salvación todo el día,</para>
  <para style="q" vid="PSA 71:15">Aunque no sepa sus límites.<verse eid="PSA 71:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 71:16"/>Iré a los poderosos hechos de <char style="nd">ʼAdonay Yavé</char>.</para>
  <para style="q" vid="PSA 71:16">Mencionaré tu justicia, la tuya sola.<verse eid="PSA 71:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 71:17"/>Tú, <char style="nd">ʼElohim</char>, me enseñaste desde mi juventud,</para>
  <para style="q" vid="PSA 71:17">Y aún declaro tus maravillosos hechos.<verse eid="PSA 71:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 71:18"/>Y aun en la vejez y las canas no me desampares, oh <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 71:18">Hasta que proclame tu fuerza a esta generación,</para>
  <para style="q" vid="PSA 71:18">Tu poder a todos los que vienen.<verse eid="PSA 71:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 71:19"/>Porque tu justicia, oh <char style="nd">ʼElohim</char>, llega hasta los cielos.</para>
  <para style="q" vid="PSA 71:19">Tú has hecho grandes cosas.</para>
  <para style="q" vid="PSA 71:19">¿Quién como Tú, oh <char style="nd">ʼElohim</char>?<verse eid="PSA 71:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 71:20"/>Tú Quien me mostraste muchas angustias y calamidades,</para>
  <para style="q" vid="PSA 71:20">Volverás a darme vida,</para>
  <para style="q" vid="PSA 71:20">Y volverás a levantarme de las profundidades de la tierra.<verse eid="PSA 71:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 71:21"/>Que Tú aumentes mi grandeza</para>
  <para style="q" vid="PSA 71:21">Y vuelvas a consolarme.<verse eid="PSA 71:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PSA 71:22"/>También te alabaré con el salterio,<note caller="+" style="f"><char style="fr" closed="false">71.22 </char><char style="ft" closed="false">Salterio: Instrumento de muchas cuerdas.</char></note></para>
  <para style="q" vid="PSA 71:22">A causa de tu verdad, oh <char style="nd">ʼElohim</char> mío,</para>
  <para style="q" vid="PSA 71:22">Te cantaré salmos con el arpa, ¡oh Santo de Israel!<verse eid="PSA 71:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 71:23"/>Mis labios se alegrarán de gozo cuando te cante salmos,</para>
  <para style="q" vid="PSA 71:23">Y mi alma, que Tú redimiste.<verse eid="PSA 71:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 71:24"/>Mi boca también susurrará todo el día tu justicia,</para>
  <para style="q" vid="PSA 71:24">Porque fueron avergonzados y humillados</para>
  <para style="q" vid="PSA 71:24">Los que buscan mi calamidad.<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="s1">Salmo de Salomón</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 72:1"/>Oh <char style="nd">ʼElohim</char>, da tus juicios al rey,</para>
  <para style="q" vid="PSA 72:1">Y tu justicia al hijo del rey.<verse eid="PSA 72:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 72:2"/>Él juzgará a tu pueblo con rectitud,</para>
  <para style="q" vid="PSA 72:2">Y a tus afligidos con justicia.<verse eid="PSA 72:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 72:3"/>Que las montañas traigan paz al pueblo,</para>
  <para style="q" vid="PSA 72:3">Y las colinas, justicia.<verse eid="PSA 72:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 72:4"/>Que Él defienda al afligido del pueblo,</para>
  <para style="q" vid="PSA 72:4">Que salve a los hijos del menesteroso,</para>
  <para style="q" vid="PSA 72:4">Y quebrante al opresor.<verse eid="PSA 72:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 72:5"/>Que te teman mientras duren el sol y la luna,</para>
  <para style="q" vid="PSA 72:5">A través de todas las generaciones.<verse eid="PSA 72:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 72:6"/>Que Él baje como lluvia sobre la hierba antes de cortarla,</para>
  <para style="q" vid="PSA 72:6">Como aguaceros que riegan la tierra.<verse eid="PSA 72:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 72:7"/>Que en sus días florezcan los justos,</para>
  <para style="q" vid="PSA 72:7">Y abunde la paz hasta que no haya luna.<verse eid="PSA 72:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 72:8"/>Que Él también domine de mar a mar,</para>
  <para style="q" vid="PSA 72:8">Y desde el río hasta los confines de la tierra.<verse eid="PSA 72:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 72:9"/>Que ante Él se inclinen los nómadas del desierto,</para>
  <para style="q" vid="PSA 72:9">Y sus enemigos laman el polvo.<verse eid="PSA 72:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 72:10"/>Que los reyes de Tarsis y las islas le traigan regalos.</para>
  <para style="q" vid="PSA 72:10">Que los reyes de Sabá y Seba le ofrezcan dones.<verse eid="PSA 72:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 72:11"/>Que se postren ante Él todos los reyes,</para>
  <para style="q" vid="PSA 72:11">Y todas las naciones le sirvan.<verse eid="PSA 72:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 72:12"/>Porque Él librará al necesitado que clama por ayuda,</para>
  <para style="q" vid="PSA 72:12">También al afligido y al que no tiene ayudador.<verse eid="PSA 72:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 72:13"/>Tendrá compasión del pobre y necesitado,</para>
  <para style="q" vid="PSA 72:13">Y salvará las vidas de los menesterosos.<verse eid="PSA 72:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 72:14"/>Rescatará sus vidas de opresión y violencia,</para>
  <para style="q" vid="PSA 72:14">Y la sangre de ellos será preciosa ante sus ojos.<verse eid="PSA 72:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 72:15"/>¡Que viva y se le dé el oro de Sabá!</para>
  <para style="q" vid="PSA 72:15">¡Y que oren por él continuamente,</para>
  <para style="q" vid="PSA 72:15">Y que todo el día lo bendigan!<verse eid="PSA 72:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 72:16"/>Que haya abundancia de grano en la tierra, en la cima de las montañas.</para>
  <para style="q" vid="PSA 72:16">Que su fruto se agite como el Líbano,</para>
  <para style="q" vid="PSA 72:16">Y los de la ciudad florezcan como la hierba de la tierra.<verse eid="PSA 72:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 72:17"/>¡Que tu Nombre dure por siempre!</para>
  <para style="q" vid="PSA 72:17">Que tu Nombre sea propagado mientras brille el sol,</para>
  <para style="q" vid="PSA 72:17">Y que los hombres sean bendecidos por él.</para>
  <para style="q" vid="PSA 72:17">Que todas las naciones los llamen Inmensamente felices.<verse eid="PSA 72:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 72:18"/>¡Bendito sea <char style="nd">Yavé ʼElohim</char>, el <char style="nd">ʼElohim</char> de Israel,</para>
  <para style="q" vid="PSA 72:18">El único que hace maravillas!<verse eid="PSA 72:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 72:19"/>¡Bendito para siempre sea tu Nombre glorioso,</para>
  <para style="q" vid="PSA 72:19">Y que toda la tierra sea llena de tu gloria! ¡Amén y amén!<verse eid="PSA 72:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 72:20"/>Terminaron las oraciones de David hijo de Isaí.<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="s1">Salmo de Asaf</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 73:1"/>Ciertamente <char style="nd">ʼElohim</char> es bueno con Israel,</para>
  <para style="q" vid="PSA 73:1">Con los que son puros de corazón.<verse eid="PSA 73:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 73:2"/>En cuanto a mí, casi se deslizan mis pies.</para>
  <para style="q" vid="PSA 73:2">Por poco resbalan mis pasos.<verse eid="PSA 73:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 73:3"/>Porque tuve envidia de los arrogantes</para>
  <para style="q" vid="PSA 73:3">Al ver la prosperidad de los perversos.<verse eid="PSA 73:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 73:4"/>Porque no hay dolores en su muerte,</para>
  <para style="q" vid="PSA 73:4">Y su cuerpo está lleno de grasa.<verse eid="PSA 73:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 73:5"/>No pasan trabajos como los otros hombres,</para>
  <para style="q" vid="PSA 73:5">Ni son plagados como los demás.<verse eid="PSA 73:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 73:6"/>Por tanto la arrogancia es su collar.</para>
  <para style="q" vid="PSA 73:6">Los envuelve un manto de violencia.<verse eid="PSA 73:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 73:7"/>Los ojos se les saltan por la gordura,</para>
  <para style="q" vid="PSA 73:7">Y logran con creces los deseos del corazón.<verse eid="PSA 73:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 73:8"/>Se burlan y hablan perversamente de opresión.</para>
  <para style="q" vid="PSA 73:8">Hablan con altanería.<verse eid="PSA 73:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 73:9"/>Ponen su boca hacia el cielo,</para>
  <para style="q" vid="PSA 73:9">Pero su boca desfila por la tierra.<verse eid="PSA 73:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 73:10"/>Por tanto su pueblo vuelve a este lugar,</para>
  <para style="q" vid="PSA 73:10">Y bebe aguas en abundancia.<verse eid="PSA 73:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 73:11"/>Y dicen: ¿Cómo puede <char style="nd">ʼEL</char> saber?</para>
  <para style="q" vid="PSA 73:11">¿Hay conocimiento en <char style="nd">ʼElyón</char>?<verse eid="PSA 73:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 73:12"/>Ciertamente así son los perversos,</para>
  <para style="q" vid="PSA 73:12">Y fácilmente aumentan su riqueza.<verse eid="PSA 73:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 73:13"/>En verdad, en vano guardé puro mi corazón,</para>
  <para style="q" vid="PSA 73:13">Y lavé mis manos en inocencia.<verse eid="PSA 73:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 73:14"/>Pues soy azotado todo el día,</para>
  <para style="q" vid="PSA 73:14">Y castigado cada mañana.<verse eid="PSA 73:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 73:15"/>Si dijera yo: Hablaré como ellos,</para>
  <para style="q" vid="PSA 73:15">Claro que traicionaría a la generación de tus hijos.<verse eid="PSA 73:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 73:16"/>Cuando meditaba para entender esto,</para>
  <para style="q" vid="PSA 73:16">Fue ardua tarea para mí.<verse eid="PSA 73:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 73:17"/>Hasta que al entrar en el Santuario de <char style="nd">ʼEL</char></para>
  <para style="q" vid="PSA 73:17">Percibí el fin de ellos.<verse eid="PSA 73:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 73:18"/>Ciertamente los colocaste en deslizaderos,</para>
  <para style="q" vid="PSA 73:18">Los lanzaste a la destrucción.<verse eid="PSA 73:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 73:19"/>¡Cómo son destruidos de repente!</para>
  <para style="q" vid="PSA 73:19">¡Son absolutamente consumidos por repentinos terrores!<verse eid="PSA 73:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 73:20"/>Como cuando uno despierta de un sueño,</para>
  <para style="q" vid="PSA 73:20">Así <char style="nd">ʼAdonay</char>, cuando Tú despiertes,</para>
  <para style="q" vid="PSA 73:20">Despreciarás su apariencia.<verse eid="PSA 73:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 73:21"/>Cuando mi corazón se amargaba</para>
  <para style="q" vid="PSA 73:21">Y me sentía traspasado,<verse eid="PSA 73:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 73:22"/>Era entonces torpe e ignorante,</para>
  <para style="q" vid="PSA 73:22">Como una bestia ante Ti.<verse eid="PSA 73:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 73:23"/>Sin embargo, yo siempre estoy contigo.</para>
  <para style="q" vid="PSA 73:23">Tú sostienes mi mano derecha.<verse eid="PSA 73:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 73:24"/>Me guiarás con tu consejo,</para>
  <para style="q" vid="PSA 73:24">Y después me recibirás en gloria.<verse eid="PSA 73:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PSA 73:25"/>¿A quién tengo yo en el cielo sino a Ti?</para>
  <para style="q" vid="PSA 73:25">Y fuera de Ti, nada deseo en la tierra.<verse eid="PSA 73:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 73:26"/>Mi cuerpo y mi corazón desfallecen,</para>
  <para style="q" vid="PSA 73:26">Pero <char style="nd">ʼElohim</char> es la Fuerza de mi corazón</para>
  <para style="q" vid="PSA 73:26">Y mi Porción para siempre.<verse eid="PSA 73:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PSA 73:27"/>Porque ciertamente los que se alejan de Ti perecerán.</para>
  <para style="q" vid="PSA 73:27">Tú destruyes a aquellos que son infieles a Ti.<verse eid="PSA 73:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 73:28"/>En cuanto a mí, la cercanía de <char style="nd">ʼElohim</char> es mi dicha.</para>
  <para style="q" vid="PSA 73:28">En <char style="nd">ʼAdonay Yavé</char> está mi refugio,</para>
  <para style="q" vid="PSA 73:28">Para que cuente todas tus obras.<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="s1">Instrucción (<char style="tl">Maskil</char>) de Asaf</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 74:1"/>Oh <char style="nd">ʼElohim</char>, ¿por qué nos desechaste para siempre?</para>
  <para style="q" vid="PSA 74:1">¿Por qué humea tu ira contra las ovejas de tu prado?<verse eid="PSA 74:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 74:2"/>Acuérdate de tu congregación,</para>
  <para style="q" vid="PSA 74:2">La que compraste desde tiempo antiguo,</para>
  <para style="q" vid="PSA 74:2">La que redimiste para que sea tribu de tu heredad,</para>
  <para style="q" vid="PSA 74:2">Y de esta Montaña Sion, donde moras.<verse eid="PSA 74:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 74:3"/>Dirige tus pasos hacia las perpetuas desolaciones.</para>
  <para style="q" vid="PSA 74:3">Todo destruyó el enemigo en el Santuario.<verse eid="PSA 74:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 74:4"/>Tus adversarios vociferan en medio de tu lugar de reunión.</para>
  <para style="q" vid="PSA 74:4">Pusieron como insignias sus propios estandartes.<verse eid="PSA 74:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 74:5"/>Se parecen a los que levantan hachas en un bosque de árboles.<verse eid="PSA 74:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 74:6"/>Y ahora todas sus entalladuras destruyen con hachas y martillos.<verse eid="PSA 74:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 74:7"/>Y hasta los cimientos quemaron tu Santuario.</para>
  <para style="q" vid="PSA 74:7">Profanaron el lugar de morada de tu Nombre.<verse eid="PSA 74:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 74:8"/>Dijeron en su corazón:</para>
  <para style="q" vid="PSA 74:8">Destruyámoslos por completo.</para>
  <para style="q" vid="PSA 74:8">Y quemaron todas las congregaciones de <char style="nd">ʼEL</char> en la tierra.<verse eid="PSA 74:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 74:9"/>No vemos nuestras insignias,</para>
  <para style="q" vid="PSA 74:9">Ya no hay profeta,</para>
  <para style="q" vid="PSA 74:9">Ni hay entre nosotros quien sepa hasta cuándo.<verse eid="PSA 74:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 74:10"/>¿Hasta cuándo, oh <char style="nd">ʼElohim</char>, nos seguirá afrentando el adversario?</para>
  <para style="q" vid="PSA 74:10">¿Seguirá blasfemando tu Nombre para siempre?<verse eid="PSA 74:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 74:11"/>¿Por qué retraes tu mano?</para>
  <para style="q" vid="PSA 74:11">¿Por qué escondes tu mano derecha en tu regazo?</para>
  <para style="q" vid="PSA 74:11">¡Destrúyelos!<verse eid="PSA 74:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 74:12"/>Sin embargo, <char style="nd">ʼElohim</char> es mi Rey desde antaño,</para>
  <para style="q" vid="PSA 74:12">Quien hace obras de salvación en la tierra.<verse eid="PSA 74:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 74:13"/>Tú dividiste el mar con tu poder.</para>
  <para style="q" vid="PSA 74:13">Quebraste en las aguas las cabezas de los monstruos.<verse eid="PSA 74:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 74:14"/>Tú aplastaste las cabezas de cocodrilo.</para>
  <para style="q" vid="PSA 74:14">Lo diste como comida a las criaturas del desierto.<verse eid="PSA 74:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 74:15"/>Tú abriste fuentes y torrentes.</para>
  <para style="q" vid="PSA 74:15">Secaste corrientes impetuosas.<verse eid="PSA 74:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 74:16"/>Tuyo es el día, tuya también la noche.</para>
  <para style="q" vid="PSA 74:16">Tú preparaste la luz y el sol.<verse eid="PSA 74:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 74:17"/>Tú estableciste todos los límites de la tierra.</para>
  <para style="q" vid="PSA 74:17">Tú hiciste verano e invierno.<verse eid="PSA 74:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 74:18"/>Recuerda esto, oh <char style="nd">Yavé</char>, que el enemigo te ofendió,</para>
  <para style="q" vid="PSA 74:18">Y gente insensata blasfemó tu Nombre.<verse eid="PSA 74:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 74:19"/>No entregues la vida de tu tórtola a las bestias salvajes.</para>
  <para style="q" vid="PSA 74:19">No olvides para siempre la vida de tu pobre.<verse eid="PSA 74:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 74:20"/>Considera el Pacto,</para>
  <para style="q" vid="PSA 74:20">Porque los lugares oscuros de la tierra están llenos de habitaciones de violencia.<verse eid="PSA 74:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 74:21"/>No permitas que el oprimido regrese avergonzado.</para>
  <para style="q" vid="PSA 74:21">Ordena que los afligidos y menesterosos alaben tu Nombre.<verse eid="PSA 74:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PSA 74:22"/>¡Levántate, oh <char style="nd">ʼElohim</char>, y defiende tu propia causa!</para>
  <para style="q" vid="PSA 74:22">Recuerda cómo el insensato te ofende todo el día.<verse eid="PSA 74:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 74:23"/>No olvides la voz de tus adversarios,</para>
  <para style="q" vid="PSA 74:23">El tumulto de los que se levantan contra Ti,</para>
  <para style="q" vid="PSA 74:23">Que sube de continuo.<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="s1">Al director del coro. Según “No destruyas”. Salmo de Asaf. Canto</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 75:1"/>Gracias te damos, oh <char style="nd">ʼElohim</char>, te damos gracias,</para>
  <para style="q" vid="PSA 75:1">Porque tu Nombre está cerca.</para>
  <para style="q" vid="PSA 75:1">Los hombres declaran tus maravillosas obras.<verse eid="PSA 75:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 75:2"/>
    <char style="wj">Cuando Yo selecciono un tiempo determinado,</char></para>
  <para style="q" vid="PSA 75:2">
    <char style="wj">Soy Yo Quien juzga con equidad.</char><verse eid="PSA 75:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 75:3"/>
    <char style="wj">Cuando se disuelva la tierra y todos los que viven en ella,</char></para>
  <para style="q" vid="PSA 75:3">
    <char style="wj">Yo mismo sostendré sus columnas.</char> <char style="tl">Selah</char><verse eid="PSA 75:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 75:4"/>
    <char style="wj">Dije a los jactanciosos: No se jacten.</char></para>
  <para style="q" vid="PSA 75:4">
    <char style="wj">Y a los perversos: No alcen su cuerno,</char><verse eid="PSA 75:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 75:5"/>
    <char style="wj">Ni levanten su cuerno en alto,</char></para>
  <para style="q" vid="PSA 75:5">
    <char style="wj">Ni hablen con orgullo insolente.</char><verse eid="PSA 75:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 75:6"/>Porque ni del oriente ni del occidente,</para>
  <para style="q" vid="PSA 75:6">Ni del desierto viene la exaltación,<verse eid="PSA 75:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 75:7"/>Sino <char style="nd">ʼElohim</char> es el Juez.</para>
  <para style="q" vid="PSA 75:7">A éste humilla y a aquél enaltece.<verse eid="PSA 75:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 75:8"/>Hay una copa en la mano de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 75:8">Y el vino fermenta.</para>
  <para style="q" vid="PSA 75:8">Está bien mezclado y lo derramará.</para>
  <para style="q" vid="PSA 75:8">Y tendrá que ser sorbido hasta sus sedimentos.</para>
  <para style="q" vid="PSA 75:8">¡Ciertamente todos los perversos de la tierra lo beberán!<verse eid="PSA 75:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 75:9"/>Pero yo lo declararé para siempre.</para>
  <para style="q" vid="PSA 75:9">Cantaré salmos al <char style="nd">ʼElohim</char> de Jacob.<verse eid="PSA 75:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 75:10"/>Él quebrará el cuerno de los perversos,</para>
  <para style="q" vid="PSA 75:10">Pero el cuerno de los justos será exaltado.<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="s1">Al director del coro. Con instrumentos de cuerda. Salmo de Asaf. Canto</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 76:1"/>
    <char style="nd">ʼElohim</char> es conocido en Judá,</para>
  <para style="q" vid="PSA 76:1">Y en Israel es grande su Nombre.<verse eid="PSA 76:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 76:2"/>En Salén está su Tabernáculo.</para>
  <para style="q" vid="PSA 76:2">Su lugar de morada también está en Sion.<verse eid="PSA 76:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 76:3"/>Allí quebró las flechas encendidas,</para>
  <para style="q" vid="PSA 76:3">El escudo y la espada y las armas de guerra. <char style="tl">Selah</char><verse eid="PSA 76:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 76:4"/>¡Eres esplendoroso!</para>
  <para style="q" vid="PSA 76:4">¡Más majestuoso que las montañas de caza!<verse eid="PSA 76:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 76:5"/>Los valientes fueron saqueados.</para>
  <para style="q" vid="PSA 76:5">Duermen su sueño.</para>
  <para style="q" vid="PSA 76:5">Ninguno de los soldados pudo usar sus manos.<verse eid="PSA 76:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 76:6"/>¡A tu reprensión, oh <char style="nd">ʼElohim</char> de Jacob,</para>
  <para style="q" vid="PSA 76:6">Tanto jinete como caballo fueron lanzados a un sueño mortal!<verse eid="PSA 76:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 76:7"/>¡Tú, solo Tú debes ser temido!</para>
  <para style="q" vid="PSA 76:7">¿Y quién puede permanecer en tu Presencia cuando estás airado?<verse eid="PSA 76:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 76:8"/>Desde los cielos hiciste oír la sentencia.</para>
  <para style="q" vid="PSA 76:8">La tierra tuvo temor y permaneció quieta<verse eid="PSA 76:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 76:9"/>Cuando <char style="nd">ʼElohim</char> se levantó a juzgar,</para>
  <para style="q" vid="PSA 76:9">A salvar a todos los mansos de la tierra. <char style="tl">Selah</char><verse eid="PSA 76:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 76:10"/>Ciertamente las iras del hombre te exaltarán,</para>
  <para style="q" vid="PSA 76:10">Y te atarás con los sobrevivientes de las iras.<verse eid="PSA 76:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 76:11"/>Hagan votos a <char style="nd">Yavé</char> su <char style="nd">ʼElohim</char> y cúmplanlos.</para>
  <para style="q" vid="PSA 76:11">Que todos los que lo rodean traigan presentes al que debe ser temido.<verse eid="PSA 76:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 76:12"/>Él humillará el espíritu de magistrados.</para>
  <para style="q" vid="PSA 76:12">Él es temido por los reyes de la tierra.<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="s1">Al director del coro. Para Jedutún. Salmo de Asaf</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 77:1"/>Mi voz se levanta a <char style="nd">ʼElohim</char> y clamaré.</para>
  <para style="q" vid="PSA 77:1">Mi voz se levanta a <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 77:1">Y Él me oirá.<verse eid="PSA 77:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 77:2"/>En el día de mi angustia busqué a <char style="nd">ʼAdonay</char>.</para>
  <para style="q" vid="PSA 77:2">A Él levanté mi mano de noche sin descanso.</para>
  <para style="q" vid="PSA 77:2">Mi alma rehusaba ser consolada.<verse eid="PSA 77:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 77:3"/>Me acuerdo de <char style="nd">ʼElohim</char> y me conmuevo.</para>
  <para style="q" vid="PSA 77:3">Me lamento y mi espíritu desmaya. <char style="tl">Selah</char><verse eid="PSA 77:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 77:4"/>Mantienes mis párpados abiertos.</para>
  <para style="q" vid="PSA 77:4">Estoy turbado y no puedo hablar.<verse eid="PSA 77:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 77:5"/>Consideré los días de antaño,</para>
  <para style="q" vid="PSA 77:5">Los años de tiempos pasados.<verse eid="PSA 77:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 77:6"/>Recuerdo mi canto en la noche.</para>
  <para style="b" vid="PSA 77:6"/>
  <para style="q" vid="PSA 77:6">Medito en mi corazón,</para>
  <para style="q" vid="PSA 77:6">Y mi espíritu escudriña:<verse eid="PSA 77:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 77:7"/>¿Desechará <char style="nd">ʼAdonay</char> para siempre,</para>
  <para style="q" vid="PSA 77:7">Y no volverá a ser favorable?<verse eid="PSA 77:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 77:8"/>¿Cesó por completo su misericordia?</para>
  <para style="q" vid="PSA 77:8">¿Se extinguió para siempre su promesa?<verse eid="PSA 77:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 77:9"/>¿Olvidó <char style="nd">ʼEL</char> ser bondadoso?</para>
  <para style="q" vid="PSA 77:9">¿En su ira retiró su compasión? <char style="tl">Selah</char><verse eid="PSA 77:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 77:10"/>Entonces dije: Es mi enfermedad:</para>
  <para style="q" vid="PSA 77:10">Que la mano derecha de <char style="nd">ʼElyón</char> cambió.<verse eid="PSA 77:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 77:11"/>Me acordaré de las obras de <char style="nd">YA</char>,</para>
  <para style="q" vid="PSA 77:11">¡Sí! Recordaré tus maravillas de antaño.<verse eid="PSA 77:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 77:12"/>Meditaré en toda tu obra,</para>
  <para style="q" vid="PSA 77:12">Y hablaré sobre tus proezas.<verse eid="PSA 77:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 77:13"/>¡Oh <char style="nd">ʼElohim</char>, santo es tu camino!</para>
  <para style="q" vid="PSA 77:13">¿Cuál <char style="tl">ʼelohim</char> es tan grande como nuestro <char style="nd">ʼElohim</char>?<verse eid="PSA 77:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 77:14"/>Tú eres el <char style="nd">ʼElohim</char> que obra maravillas.</para>
  <para style="q" vid="PSA 77:14">Hiciste notorio entre los pueblos tu poder.<verse eid="PSA 77:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 77:15"/>Con tu poder redimiste a tu pueblo,</para>
  <para style="q" vid="PSA 77:15">A los hijos de Jacob y de José. <char style="tl">Selah</char><verse eid="PSA 77:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 77:16"/>Te vieron las aguas, oh <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 77:16">Las aguas te vieron y se angustiaron.</para>
  <para style="q" vid="PSA 77:16">Los abismos también se estremecieron.<verse eid="PSA 77:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 77:17"/>Espesas nubes derramaron agua.</para>
  <para style="q" vid="PSA 77:17">Los nubarrones tronaron.</para>
  <para style="q" vid="PSA 77:17">También tus flechas centellaron.<verse eid="PSA 77:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 77:18"/>El ruido de tu trueno estaba en el remolino de viento.</para>
  <para style="q" vid="PSA 77:18">Los relámpagos iluminaron el mundo.</para>
  <para style="q" vid="PSA 77:18">Tembló y se estremeció la tierra.<verse eid="PSA 77:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 77:19"/>Abriste tu camino en el mar</para>
  <para style="q" vid="PSA 77:19">Y tus senderos en las aguas caudalosas,</para>
  <para style="q" vid="PSA 77:19">Para que tus pisadas no fueran conocidas.<verse eid="PSA 77:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 77:20"/>Como un rebaño guiaste a tu pueblo</para>
  <para style="q" vid="PSA 77:20">Por medio de Moisés y Aarón.<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="s1">Instrucción (<char style="tl">Maskil</char>) de Asaf</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 78:1"/>Escucha, pueblo mío, mi instrucción.</para>
  <para style="q" vid="PSA 78:1">Inclina tus oídos a las palabras de mi boca.<verse eid="PSA 78:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 78:2"/>Abriré mi boca en proverbio.</para>
  <para style="q" vid="PSA 78:2">Declararé dichos de antaño de difícil comprensión,<verse eid="PSA 78:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 78:3"/>Los cuales oímos y conocimos.</para>
  <para style="b" vid="PSA 78:3"/>
  <para style="q" vid="PSA 78:3">Nos los relataron nuestros antepasados.<verse eid="PSA 78:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 78:4"/>No los encubriremos a sus hijos.</para>
  <para style="q" vid="PSA 78:4">Contaremos a la generación venidera las alabanzas de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 78:4">Y su poder y las maravillosas obras que hizo.<verse eid="PSA 78:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 78:5"/>Él estableció testimonio en Jacob,</para>
  <para style="q" vid="PSA 78:5">Y estableció Ley en Israel,</para>
  <para style="q" vid="PSA 78:5">La cual mandó a nuestros antepasados</para>
  <para style="q" vid="PSA 78:5">Que la enseñaran a sus hijos,<verse eid="PSA 78:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 78:6"/>A fin de que la generación venidera <char style="add">la</char> supiera,</para>
  <para style="q" vid="PSA 78:6">Los hijos que iban a nacer,</para>
  <para style="q" vid="PSA 78:6">Con el fin de que se levantaran y la dijeran a sus hijos,<verse eid="PSA 78:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 78:7"/>Para que en <char style="nd">ʼElohim</char> depositen su confianza,</para>
  <para style="q" vid="PSA 78:7">Y no olviden las obras de <char style="nd">ʼEL,</char></para>
  <para style="q" vid="PSA 78:7">Sino que guarden sus Mandamientos,<verse eid="PSA 78:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 78:8"/>Y no sean como sus antepasados,</para>
  <para style="q" vid="PSA 78:8">Generación terca y rebelde,</para>
  <para style="q" vid="PSA 78:8">Generación que no preparó su corazón,</para>
  <para style="q" vid="PSA 78:8">Y su espíritu no fue fiel a <char style="nd">ʼEL.</char><verse eid="PSA 78:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 78:9"/>Los hijos de Efraín, arqueros equipados,</para>
  <para style="q" vid="PSA 78:9">Dieron la espalda en el día de la batalla.<verse eid="PSA 78:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 78:10"/>No guardaron el Pacto de <char style="nd">ʼElohim</char></para>
  <para style="q" vid="PSA 78:10">Y rehusaron andar en su Ley.<verse eid="PSA 78:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 78:11"/>Olvidaron sus obras.</para>
  <para style="q" vid="PSA 78:11">Él hizo maravillas ante sus antepasados en la tierra de Egipto.<verse eid="PSA 78:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 78:12"/>Delante de sus antepasados realizó maravillas en la tierra de Egipto.</para>
  <para style="q" vid="PSA 78:12">En el campo de Zoán<verse eid="PSA 78:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 78:13"/>Dividió el mar y los pasó.</para>
  <para style="q" vid="PSA 78:13">Detuvo las aguas como en una pila.<verse eid="PSA 78:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 78:14"/>De día los guiaba con nube,</para>
  <para style="q" vid="PSA 78:14">Con resplandor de fuego toda la noche.<verse eid="PSA 78:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 78:15"/>Hendió las peñas del desierto</para>
  <para style="q" vid="PSA 78:15">Y les dio a beber raudales sin medida.<verse eid="PSA 78:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 78:16"/>Sacó arroyos de la peña</para>
  <para style="q" vid="PSA 78:16">Y las aguas corrieron como ríos.<verse eid="PSA 78:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 78:17"/>Pero ellos aún continuaron pecando contra Él.</para>
  <para style="q" vid="PSA 78:17">Se rebelaron contra <char style="nd">ʼElyón</char> en el desierto<verse eid="PSA 78:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 78:18"/>Y en sus corazones tentaron a <char style="nd">ʼEL.</char></para>
  <para style="q" vid="PSA 78:18">Pidieron comida según su deseo.<verse eid="PSA 78:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 78:19"/>Hablaron contra <char style="nd">ʼElohim</char>:</para>
  <para style="q" vid="PSA 78:19">¿Puede <char style="nd">ʼEL</char> preparar una mesa en el desierto?<verse eid="PSA 78:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 78:20"/>Sí, Él golpeó la roca</para>
  <para style="q" vid="PSA 78:20">Y brotaron aguas y se desbordaron torrentes.</para>
  <para style="q" vid="PSA 78:20">¿Puede Él dar también pan?</para>
  <para style="q" vid="PSA 78:20">¿Proveerá carne para su pueblo?<verse eid="PSA 78:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 78:21"/>Por tanto, oyó <char style="nd">Yavé</char> y se indignó.</para>
  <para style="q" vid="PSA 78:21">Un fuego se encendió contra Jacob,</para>
  <para style="q" vid="PSA 78:21">Y una ira subió contra Israel,<verse eid="PSA 78:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 78:22"/>Por cuanto no creyeron en <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 78:22">Ni confiaron en su salvación.<verse eid="PSA 78:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 78:23"/>Sin embargo, mandó a las nubes desde arriba,</para>
  <para style="q" vid="PSA 78:23">Y abrió las puertas del cielo.<verse eid="PSA 78:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 78:24"/>Hizo llover sobre ellos maná para comer</para>
  <para style="q" vid="PSA 78:24">Y les dio alimento del cielo.<verse eid="PSA 78:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 78:25"/>Pan de ángeles comió el hombre.</para>
  <para style="q" vid="PSA 78:25">Les envió comida en abundancia.<verse eid="PSA 78:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PSA 78:26"/>Sopló en el cielo el viento del este</para>
  <para style="q" vid="PSA 78:26">Y con su poder atrajo el viento del sur.<verse eid="PSA 78:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 78:27"/>Esparció sobre ellos carne como polvo,</para>
  <para style="q" vid="PSA 78:27">Criaturas aladas como la arena de los mares.<verse eid="PSA 78:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 78:28"/>Las soltó en medio del campamento alrededor de sus tiendas.<verse eid="PSA 78:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 78:29"/>Comieron y se hartaron,</para>
  <para style="q" vid="PSA 78:29">Y les cumplió su deseo.<verse eid="PSA 78:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PSA 78:30"/>Antes que ellos saciaran su apetito,</para>
  <para style="q" vid="PSA 78:30">Cuando la comida estaba en sus bocas,<verse eid="PSA 78:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 78:31"/>Surgió contra ellos la ira divina</para>
  <para style="q" vid="PSA 78:31">Que mató a algunos de los fornidos de ellos</para>
  <para style="q" vid="PSA 78:31">Y sometió a los jóvenes escogidos de Israel.<verse eid="PSA 78:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PSA 78:32"/>A pesar de eso, siguieron en pecado</para>
  <para style="q" vid="PSA 78:32">Y no dieron crédito a sus maravillas.<verse eid="PSA 78:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 78:33"/>Por tanto consumió sus días en vanidad,</para>
  <para style="q" vid="PSA 78:33">Y sus años en temor.<verse eid="PSA 78:33"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="34" style="v" sid="PSA 78:34"/>Cuando los hería de muerte,</para>
  <para style="q" vid="PSA 78:34">Lo buscaban.</para>
  <para style="q" vid="PSA 78:34">Se arrepentían y con diligencia lo buscaban.<verse eid="PSA 78:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 78:35"/>Se acordaban que <char style="nd">ʼElohim</char> era su Roca,</para>
  <para style="q" vid="PSA 78:35">Y <char style="nd">ʼEL,</char> <char style="nd">ʼElyón</char>, su Redentor.<verse eid="PSA 78:35"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="36" style="v" sid="PSA 78:36"/>Lo lisonjeaban con su boca</para>
  <para style="q" vid="PSA 78:36">Y le mentían con su lengua.<verse eid="PSA 78:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 78:37"/>Pues sus corazones no eran firmes hacia Él,</para>
  <para style="q" vid="PSA 78:37">Ni eran fieles a su Pacto.<verse eid="PSA 78:37"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="38" style="v" sid="PSA 78:38"/>Pero Él por misericordia perdonó su iniquidad</para>
  <para style="q" vid="PSA 78:38">Y no los destruyó.</para>
  <para style="q" vid="PSA 78:38">Con frecuencia contuvo su ira</para>
  <para style="q" vid="PSA 78:38">Y no despertó todo su enojo.<verse eid="PSA 78:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 78:39"/>Recordó que no eran sino carne,</para>
  <para style="q" vid="PSA 78:39">Un soplo que pasa y no regresa.<verse eid="PSA 78:39"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="40" style="v" sid="PSA 78:40"/>¡Cuán a menudo se rebelaron contra Él en el desierto</para>
  <para style="q" vid="PSA 78:40">Y lo contristaron en terreno no habitado!<verse eid="PSA 78:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 78:41"/>Vez tras vez tentaron a <char style="nd">ʼEL.</char></para>
  <para style="q" vid="PSA 78:41">Irritaron al Santo de Israel.<verse eid="PSA 78:41"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="42" style="v" sid="PSA 78:42"/>No se acordaron de su poder,</para>
  <para style="q" vid="PSA 78:42">Del día cuando los redimió del adversario:<verse eid="PSA 78:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 78:43"/>Cuando realizó en Egipto sus señales,</para>
  <para style="q" vid="PSA 78:43">Y sus maravillas en la tierra de Zoán.<verse eid="PSA 78:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 78:44"/>Cuando convirtió sus ríos en sangre,</para>
  <para style="q" vid="PSA 78:44">Y ellos no pudieron beber de sus manantiales.<verse eid="PSA 78:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 78:45"/>Cuando envió entre ellos enjambres de moscas que los devoraban</para>
  <para style="q" vid="PSA 78:45">Y ranas que los destruían.<verse eid="PSA 78:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 78:46"/>Cuando entregó a los saltamontes sus cosechas</para>
  <para style="q" vid="PSA 78:46">Y el fruto de su trabajo a la langosta.<verse eid="PSA 78:46"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="47" style="v" sid="PSA 78:47"/>Él destruyó sus viñas con granizo</para>
  <para style="q" vid="PSA 78:47">Y sus sicómoros con escarcha.<verse eid="PSA 78:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 78:48"/>Él entregó al granizo sus vacadas</para>
  <para style="q" vid="PSA 78:48">Y a los rayos sus ganados.<verse eid="PSA 78:48"/></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 78:49"/>Envió sobre ellos su ardiente ira,</para>
  <para style="q" vid="PSA 78:49">Enojo, indignación y angustia,</para>
  <para style="q" vid="PSA 78:49">Una banda de mensajeros destructores.<verse eid="PSA 78:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 78:50"/>Él dispuso un camino para su ira</para>
  <para style="q" vid="PSA 78:50">Y no libró sus vidas de la muerte.</para>
  <para style="q" vid="PSA 78:50">Entregó sus vidas a la pestilencia<verse eid="PSA 78:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 78:51"/>E hirió a todos los primogénitos de Egipto,</para>
  <para style="q" vid="PSA 78:51">Las primicias de su virilidad en las tiendas de Cam.<verse eid="PSA 78:51"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="52" style="v" sid="PSA 78:52"/>Pero dirigió a su pueblo como ovejas,</para>
  <para style="q" vid="PSA 78:52">Y como rebaño los guió por el desierto.<verse eid="PSA 78:52"/></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 78:53"/>Los condujo con seguridad para que no temieran,</para>
  <para style="q" vid="PSA 78:53">Pero el mar cubrió a sus enemigos.<verse eid="PSA 78:53"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="54" style="v" sid="PSA 78:54"/>Los llevó hasta la frontera de su Tierra Santa,</para>
  <para style="q" vid="PSA 78:54">Al país montañoso que adquirió su mano derecha.<verse eid="PSA 78:54"/></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 78:55"/>Echó a las naciones de delante de ellos.</para>
  <para style="q" vid="PSA 78:55">Con medida <char style="add">les</char> repartió las tierras de ellos en heredad,</para>
  <para style="q" vid="PSA 78:55">E hizo que las tribus de Israel vivieran en sus tiendas.<verse eid="PSA 78:55"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="56" style="v" sid="PSA 78:56"/>Pero ellos tentaron y provocaron a <char style="nd">ʼElyón</char> <char style="nd">ʼElohim</char></para>
  <para style="q" vid="PSA 78:56">Y no guardaron sus Testimonios.<verse eid="PSA 78:56"/></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 78:57"/>Regresaron y actuaron deslealmente como sus antepasados.</para>
  <para style="q" vid="PSA 78:57">Tal como sus antepasados, fueron desleales.</para>
  <para style="q" vid="PSA 78:57">Se desviaron como arco torcido.<verse eid="PSA 78:57"/></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 78:58"/>Lo provocaron con sus lugares altos</para>
  <para style="q" vid="PSA 78:58">Y despertaron su celo con sus imágenes de talla.<verse eid="PSA 78:58"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="59" style="v" sid="PSA 78:59"/>Cuando <char style="nd">ʼElohim</char> oyó, se indignó</para>
  <para style="q" vid="PSA 78:59">Y aborreció a Israel en gran manera.<verse eid="PSA 78:59"/></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 78:60"/>Por lo cual abandonó el Tabernáculo de Silo,</para>
  <para style="q" vid="PSA 78:60">El Tabernáculo que estableció entre los hombres.<verse eid="PSA 78:60"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="61" style="v" sid="PSA 78:61"/>Entregó su poder a la cautividad</para>
  <para style="q" vid="PSA 78:61">Y su resplandor en mano del adversario.<verse eid="PSA 78:61"/></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 78:62"/>Entregó también su pueblo a la espada</para>
  <para style="q" vid="PSA 78:62">Y se indignó contra su heredad.<verse eid="PSA 78:62"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="63" style="v" sid="PSA 78:63"/>El fuego devoró a sus jóvenes,</para>
  <para style="q" vid="PSA 78:63">Y sus doncellas no tuvieron cantos nupciales.<verse eid="PSA 78:63"/></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 78:64"/>Sus sacerdotes cayeron a espada,</para>
  <para style="q" vid="PSA 78:64">Y sus viudas no hicieron lamentación.<verse eid="PSA 78:64"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="65" style="v" sid="PSA 78:65"/>Pero entonces, como el que duerme,</para>
  <para style="q" vid="PSA 78:65">Como un valiente que se recupera del vino</para>
  <para style="q" vid="PSA 78:65">Despertó <char style="nd">ʼAdonay</char><verse eid="PSA 78:65"/></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 78:66"/>E hirió a sus adversarios por detrás.</para>
  <para style="q" vid="PSA 78:66">Puso sobre ellos afrenta perpetua.<verse eid="PSA 78:66"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="67" style="v" sid="PSA 78:67"/>Desechó la tienda de José</para>
  <para style="q" vid="PSA 78:67">Y no eligió a la tribu de Efraín,<verse eid="PSA 78:67"/></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 78:68"/>Sino escogió a la tribu de Judá</para>
  <para style="q" vid="PSA 78:68">Y la Montaña de Sion, que Él amó.<verse eid="PSA 78:68"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="69" style="v" sid="PSA 78:69"/>Construyó en las alturas su Santuario</para>
  <para style="q" vid="PSA 78:69">Como la tierra que fundó para siempre.<verse eid="PSA 78:69"/></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 78:70"/>También escogió a David, su esclavo,</para>
  <para style="q" vid="PSA 78:70">Y lo tomó de los rebaños.<verse eid="PSA 78:70"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="71" style="v" sid="PSA 78:71"/>Lo trajo de detrás de las ovejas que tenían crías</para>
  <para style="q" vid="PSA 78:71">Para que apacentara a Jacob su pueblo</para>
  <para style="q" vid="PSA 78:71">Y a Israel su heredad.<verse eid="PSA 78:71"/></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 78:72"/>Los pastoreó según la integridad de su corazón,</para>
  <para style="q" vid="PSA 78:72">Y los guió con la destreza de sus manos.<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="s1">Salmo de Asaf</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 79:1"/>Oh <char style="nd">ʼElohim</char>, las naciones invadieron tu heredad.</para>
  <para style="q" vid="PSA 79:1">Profanaron tu Santuario</para>
  <para style="q" vid="PSA 79:1">Y redujeron a escombros a Jerusalén.<verse eid="PSA 79:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 79:2"/>Dieron los cadáveres de tus esclavos</para>
  <para style="q" vid="PSA 79:2">Como comida a las aves del cielo,</para>
  <para style="q" vid="PSA 79:2">La carne de tus santos a las bestias de la tierra.<verse eid="PSA 79:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 79:3"/>Derramaron la sangre de ellos como agua alrededor de Jerusalén,</para>
  <para style="q" vid="PSA 79:3">Y no hay quien los sepulte.<verse eid="PSA 79:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 79:4"/>Fuimos afrenta de nuestros vecinos,</para>
  <para style="q" vid="PSA 79:4">Escarnio y burla de los que nos rodean.<verse eid="PSA 79:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 79:5"/>¿Hasta cuándo, oh <char style="nd">Yavé</char>?</para>
  <para style="q" vid="PSA 79:5">¿Estarás airado para siempre?</para>
  <para style="q" vid="PSA 79:5">¿Arderá tu celo como fuego?<verse eid="PSA 79:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 79:6"/>Derrama tu ira sobre las naciones que no te conocen</para>
  <para style="q" vid="PSA 79:6">Y sobre los reinos que no invocan tu Nombre,<verse eid="PSA 79:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 79:7"/>Porque devoraron a Jacob,</para>
  <para style="q" vid="PSA 79:7">Y desolaron su morada.<verse eid="PSA 79:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 79:8"/>No recuerdes contra nosotros las iniquidades de nuestros antepasados.</para>
  <para style="q" vid="PSA 79:8">Salgan pronto a encontrarnos tus misericordias,</para>
  <para style="q" vid="PSA 79:8">Porque estamos muy abatidos.<verse eid="PSA 79:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 79:9"/>Oh <char style="nd">ʼElohim</char> de nuestra salvación, ayúdanos,</para>
  <para style="q" vid="PSA 79:9">Para la gloria de tu Nombre.</para>
  <para style="q" vid="PSA 79:9">Líbranos y perdona nuestros pecados por amor a tu Nombre.<verse eid="PSA 79:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 79:10"/>¿Por qué deben decir los gentiles:</para>
  <para style="q" vid="PSA 79:10">Dónde está su <char style="nd">ʼElohim</char>?</para>
  <para style="q" vid="PSA 79:10">Sea proclamada a los gentiles y ante nuestros ojos</para>
  <para style="q" vid="PSA 79:10">La venganza de la sangre de tus esclavos que fue derramada.<verse eid="PSA 79:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 79:11"/>Llegue ante Ti el gemido de los cautivos.</para>
  <para style="q" vid="PSA 79:11">Conforme a la grandeza de tu poder</para>
  <para style="q" vid="PSA 79:11">Preserva a los sentenciados a muerte.<verse eid="PSA 79:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 79:12"/>Devuelve en su regazo a nuestros vecinos siete veces</para>
  <para style="q" vid="PSA 79:12">La infamia con la cual te afrentaron, ¡oh <char style="nd">ʼAdonay</char>!<verse eid="PSA 79:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 79:13"/>Así nosotros, pueblo tuyo y ovejas de tu prado,</para>
  <para style="q" vid="PSA 79:13">Te daremos gracias para siempre.</para>
  <para style="q" vid="PSA 79:13">A todas las generaciones contaremos de tu alabanza.<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="s1">Al director del coro. Según “Sobre lirios”. Testimonio. Salmo de Asaf</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 80:1"/>Oh Pastor de Israel, escucha.</para>
  <para style="q" vid="PSA 80:1">Tú, que pastoreas a José como un rebaño,</para>
  <para style="q" vid="PSA 80:1">Tú, que estás entronizado entre querubines, ¡Resplandece!<verse eid="PSA 80:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 80:2"/>Delante de Efraín, de Benjamín y de Manasés,</para>
  <para style="q" vid="PSA 80:2">Despierta tu poder</para>
  <para style="q" vid="PSA 80:2">Y ven a salvarnos.<verse eid="PSA 80:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 80:3"/>Restáuranos, oh <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 80:3">Haz resplandecer tu rostro,</para>
  <para style="q" vid="PSA 80:3">Y seremos salvos.<verse eid="PSA 80:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 80:4"/>Oh <char style="nd">Yavé, ʼElohim</char> de las huestes,</para>
  <para style="q" vid="PSA 80:4">¿Hasta cuándo estarás airado contra la oración de tu pueblo?<verse eid="PSA 80:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 80:5"/>Los alimentaste con pan de lágrimas.</para>
  <para style="q" vid="PSA 80:5">Les diste a beber lágrimas en abundancia.<verse eid="PSA 80:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 80:6"/>Nos conviertes en escarnio de nuestros vecinos,</para>
  <para style="q" vid="PSA 80:6">Y nuestros enemigos se burlan de nosotros.<verse eid="PSA 80:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 80:7"/>Oh <char style="nd">ʼElohim</char> de las huestes, restáuranos.</para>
  <para style="q" vid="PSA 80:7">Haz resplandecer tu rostro,</para>
  <para style="q" vid="PSA 80:7">Y seremos salvos.<verse eid="PSA 80:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 80:8"/>Trajiste una vid de Egipto.</para>
  <para style="q" vid="PSA 80:8">Expulsaste las naciones</para>
  <para style="q" vid="PSA 80:8">Y la plantaste.<verse eid="PSA 80:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 80:9"/>Limpiaste delante de ella.</para>
  <para style="q" vid="PSA 80:9">Desarrolló profunda raíz y llenó la tierra.<verse eid="PSA 80:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 80:10"/>Las montañas fueron cubiertas con su sombra,</para>
  <para style="q" vid="PSA 80:10">Y con sus ramas los cedros de <char style="nd">ʼElohim</char>.<verse eid="PSA 80:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 80:11"/>Extendió sus ramas hasta el mar</para>
  <para style="q" vid="PSA 80:11">Y hasta el río sus retoños.<verse eid="PSA 80:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 80:12"/>¿Por qué derribaste sus cercas</para>
  <para style="q" vid="PSA 80:12">De modo que recogen sus frutos todos los que pasan por el camino?<verse eid="PSA 80:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 80:13"/>El jabalí la destroza,</para>
  <para style="q" vid="PSA 80:13">Y las bestias del campo la devoran.<verse eid="PSA 80:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 80:14"/>Oh <char style="nd">ʼElohim</char> de las huestes, vuelve, te rogamos.</para>
  <para style="q" vid="PSA 80:14">Mira desde el cielo, considera,</para>
  <para style="q" vid="PSA 80:14">Y cuida esta viña.<verse eid="PSA 80:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 80:15"/>La cepa que plantó tu mano derecha</para>
  <para style="q" vid="PSA 80:15">Y la rama que fortaleciste para Ti<verse eid="PSA 80:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 80:16"/>Está quemada con fuego y cortada.</para>
  <para style="q" vid="PSA 80:16">Perezcan por la reprensión de tu rostro.<verse eid="PSA 80:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 80:17"/>Que tu mano sea sobre el varón de tu mano derecha,</para>
  <para style="q" vid="PSA 80:17">Sobre el Hijo de Hombre que para Ti fortaleciste.<verse eid="PSA 80:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 80:18"/>Así no nos apartaremos de Ti.</para>
  <para style="q" vid="PSA 80:18">Revívemos e invocaremos tu Nombre.<verse eid="PSA 80:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 80:19"/>Oh <char style="nd">Yavé, ʼElohim</char> de las huestes, restáuranos.</para>
  <para style="q" vid="PSA 80:19">Que tu rostro resplandezca,</para>
  <para style="q" vid="PSA 80:19">Y seremos salvos.<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="s1">Al director del coro. Según Geteos. Salmo de Asaf</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 81:1"/>Canten con gozo a <char style="nd">ʼElohim</char>, Fortaleza nuestra.</para>
  <para style="q" vid="PSA 81:1">Aclamen con júbilo al <char style="nd">ʼElohim</char> de Jacob.<verse eid="PSA 81:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 81:2"/>Eleven un canto, batan el pandero, la suave lira<note caller="+" style="f"><char style="fr" closed="false">81.2 </char><char style="ft" closed="false">Lira: Antiguo instrumento músico de varias cuerdas tensas en un marco. </char></note> y el arpa.<verse eid="PSA 81:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 81:3"/>Soplen la corneta en la Nueva Luna en el día de nuestra fiesta,<verse eid="PSA 81:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 81:4"/>Porque estatuto es para Israel,</para>
  <para style="q" vid="PSA 81:4">Ordenanza del <char style="nd">ʼElohim</char> de Jacob.<verse eid="PSA 81:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 81:5"/>Lo estableció como testimonio en José</para>
  <para style="q" vid="PSA 81:5">Cuando salió de la tierra de Egipto.</para>
  <para style="q" vid="PSA 81:5">Escuché un lenguaje que no conocía.<verse eid="PSA 81:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 81:6"/>
    <char style="wj">Quité su hombro de debajo de la carga. </char></para>
  <para style="q" vid="PSA 81:6">
    <char style="wj">Sus manos fueron libradas del peso de los cestos. </char><verse eid="PSA 81:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 81:7"/>
    <char style="wj">En la angustia clamaste,</char></para>
  <para style="q" vid="PSA 81:7">
    <char style="wj">Y Yo te rescaté.</char></para>
  <para style="q" vid="PSA 81:7">
    <char style="wj">Te respondí en el secreto del trueno.</char></para>
  <para style="q" vid="PSA 81:7">
    <char style="wj">Te probé junto al agua de Meriba. <char style="tl">Selah</char></char><verse eid="PSA 81:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 81:8"/>
    <char style="wj">Escucha, pueblo mío, y te amonestaré.</char></para>
  <para style="q" vid="PSA 81:8">
    <char style="wj">Oh Israel, si me escuchas,</char><verse eid="PSA 81:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 81:9"/>
    <char style="wj">Que no haya en medio de ti <char style="tl">ʼelohim</char> extraño,</char></para>
  <para style="q" vid="PSA 81:9">
    <char style="wj">Ni adores algún <char style="tl">ʼelohim</char> extranjero.</char><verse eid="PSA 81:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 81:10"/>
    <char style="wj">Yo soy <char style="nd">Yavé</char>, </char></para>
  <para style="q" vid="PSA 81:10">
    <char style="wj">Tu <char style="nd">ʼElohim</char>,</char></para>
  <para style="q" vid="PSA 81:10">
    <char style="wj">El que te sacó de la tierra de Egipto.</char></para>
  <para style="q" vid="PSA 81:10">
    <char style="wj">¡Abre tu boca, y Yo la llenaré!</char><verse eid="PSA 81:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 81:11"/>
    <char style="wj">Pero mi pueblo no escuchó mi voz.</char></para>
  <para style="q" vid="PSA 81:11">
    <char style="wj">Israel no me obedeció.</char><verse eid="PSA 81:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 81:12"/>
    <char style="wj">Por eso los entregué a la dureza de su corazón,</char></para>
  <para style="q" vid="PSA 81:12">
    <char style="wj">Para que anduvieran según sus propios designios.</char><verse eid="PSA 81:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 81:13"/>
    <char style="wj">¡Oh, si mi pueblo me escuchara!</char></para>
  <para style="q" vid="PSA 81:13">
    <char style="wj">¡Que Israel anduviera en mis caminos!</char><verse eid="PSA 81:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 81:14"/>
    <char style="wj">Prontamente Yo sometería a sus enemigos</char></para>
  <para style="q" vid="PSA 81:14">
    <char style="wj">Y volvería mi mano contra sus adversarios.</char><verse eid="PSA 81:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 81:15"/>
    <char style="wj">Los que aborrecen a <char style="nd">Yavé</char> se le someterían,</char></para>
  <para style="q" vid="PSA 81:15">
    <char style="wj">Pero su castigo duraría para siempre.</char><verse eid="PSA 81:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 81:16"/>
    <char style="wj">Pero a ti te sustentaría con lo más fino del trigo</char></para>
  <para style="q" vid="PSA 81:16">
    <char style="wj">Y te saciaría con miel de la roca.</char><verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="s1">Salmo de Asaf</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 82:1"/>
    <char style="nd">ʼElohim</char> toma su posición en la asamblea de los <char style="tl">ʼelohim</char>.</para>
  <para style="q" vid="PSA 82:1">Juzga en medio de los <char style="tl">ʼelohim</char>.<verse eid="PSA 82:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 82:2"/>¿Hasta cuándo juzgarán injustamente,</para>
  <para style="q" vid="PSA 82:2">Y mostrarán parcialidad a los perversos? <char style="tl">Selah</char><verse eid="PSA 82:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 82:3"/>Defiendan al débil y al huérfano.</para>
  <para style="q" vid="PSA 82:3">Hagan justicia al afligido y al menesteroso.<verse eid="PSA 82:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 82:4"/>Rescaten al débil y al necesitado.</para>
  <para style="q" vid="PSA 82:4">Líbrenlos de mano de los perversos.<verse eid="PSA 82:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 82:5"/>No saben ni entienden.</para>
  <para style="q" vid="PSA 82:5">Andan en la oscuridad.</para>
  <para style="q" vid="PSA 82:5">Son conmovidos todos los cimientos de la tierra.<verse eid="PSA 82:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 82:6"/>Yo dije: Ustedes son <char style="tl">ʼelohim</char>.</para>
  <para style="q" vid="PSA 82:6">Todos ustedes son hijos del <char style="nd">ʼElyón</char>.<verse eid="PSA 82:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 82:7"/>Sin embargo, como hombres morirán.</para>
  <para style="q" vid="PSA 82:7">Caerán como cualquiera de los gobernantes.<verse eid="PSA 82:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 82:8"/>Levántate, oh <char style="nd">ʼElohim</char>, juzga la tierra,</para>
  <para style="q" vid="PSA 82:8">Porque Tú posees todas las naciones.<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="s1">Canto. Salmo de Asa</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 83:1"/>Oh <char style="nd">ʼElohim</char>, no permanezcas en silencio.</para>
  <para style="q" vid="PSA 83:1">Oh <char style="nd">ʼElohim</char>, no calles, no estés imperturbable.<verse eid="PSA 83:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 83:2"/>Pues <char style="add">mira que</char> rugen tus enemigos,</para>
  <para style="q" vid="PSA 83:2">Y los que te aborrecen levantan la cabeza.<verse eid="PSA 83:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 83:3"/>Astutamente consultaron contra tu pueblo.</para>
  <para style="q" vid="PSA 83:3">Conspiran contra tus protegidos.<verse eid="PSA 83:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 83:4"/>Dijeron: Vengan.</para>
  <para style="q" vid="PSA 83:4">Destruyámoslos para que no sean nación.</para>
  <para style="q" vid="PSA 83:4">Que no haya más memoria del nombre de Israel.<verse eid="PSA 83:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 83:5"/>Porque con consentimiento conspiraron juntos.</para>
  <para style="q" vid="PSA 83:5">Contra Ti hacen un pacto:<verse eid="PSA 83:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 83:6"/>Las tiendas de Edom y los ismaelitas, Moab y los agarenos,<verse eid="PSA 83:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 83:7"/>Gebal, Amón y Amalec, Filistea con los habitantes de Tiro,<verse eid="PSA 83:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 83:8"/>También Asiria se unió a ellos.</para>
  <para style="q" vid="PSA 83:8">Sirven de brazo a los hijos de Lot. <char style="tl">Selah</char><verse eid="PSA 83:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 83:9"/>Haz con ellos como con Madián,</para>
  <para style="q" vid="PSA 83:9">Como con Sísara,</para>
  <para style="q" vid="PSA 83:9">Como con Jabín en el torrente de Cisón,<verse eid="PSA 83:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 83:10"/>Que fueron destruidos en Endor</para>
  <para style="q" vid="PSA 83:10">Y fueron como abono para la tierra.<verse eid="PSA 83:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 83:11"/>Haz a sus nobles como a Oreb y a Zeeb,</para>
  <para style="q" vid="PSA 83:11">Y a todos sus jefes como a Zeba y Zalmuna,<verse eid="PSA 83:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 83:12"/>Porque dijeron:</para>
  <para style="q" vid="PSA 83:12">Tomemos como posesión nuestra los prados de <char style="nd">ʼElohim</char>.<verse eid="PSA 83:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 83:13"/>Oh <char style="nd">ʼElohim</char> mío, conviértelos como un remolino de polvo,</para>
  <para style="q" vid="PSA 83:13">Como hojarasca ante el viento,<verse eid="PSA 83:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 83:14"/>Como fuego que consume el bosque,</para>
  <para style="q" vid="PSA 83:14">Como una llama incendia las montañas.<verse eid="PSA 83:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 83:15"/>Persíguelos así con tu tempestad</para>
  <para style="q" vid="PSA 83:15">Y aterrorízalos con tu tormenta.<verse eid="PSA 83:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 83:16"/>Llena sus caras de deshonra,</para>
  <para style="q" vid="PSA 83:16">Para que busquen tu Nombre, oh <char style="nd">Yavé</char>.<verse eid="PSA 83:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 83:17"/>Sean avergonzados y turbados para siempre.</para>
  <para style="q" vid="PSA 83:17">Sean humillados y perezcan,<verse eid="PSA 83:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 83:18"/>Y sepan que solo Tú, tu Nombre es <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 83:18">Eres el <char style="nd">ʼElyón</char> sobre toda la tierra.<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="s1">Al director del coro. Sobre los Geteos. Salmo de los hijos de Coré</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 84:1"/>¡Cuán maravillosas son tus moradas, oh <char style="nd">Yavé</char> de las huestes!<verse eid="PSA 84:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 84:2"/>Mi alma anhela</para>
  <para style="q" vid="PSA 84:2">Y aun desea ardientemente los patios de <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 84:2">Mi corazón y mi carne cantan con gozo al <char style="nd">ʼElohim</char> vivo.<verse eid="PSA 84:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 84:3"/>Aun el pajarillo halla casa,</para>
  <para style="q" vid="PSA 84:3">Y la golondrina nido para ella donde colocar sus polluelos.</para>
  <para style="q" vid="PSA 84:3">Cerca de tus altares, oh <char style="nd">Yavé</char> de las huestes, Rey mío y <char style="nd">ʼElohim</char> mío.<verse eid="PSA 84:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 84:4"/>¡Inmensamente felices son los que moran en tu Casa!</para>
  <para style="q" vid="PSA 84:4">Perpetuamente te alaban. <char style="tl">Selah</char><verse eid="PSA 84:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 84:5"/>¡Inmensamente feliz es el hombre que tiene en Ti su fuerza,</para>
  <para style="q" vid="PSA 84:5">En cuyo corazón están tus caminos!<verse eid="PSA 84:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 84:6"/>Al atravesar el Valle de Lágrimas, hacen en él un estanque.</para>
  <para style="q" vid="PSA 84:6">La lluvia temprana también lo cubre con bendiciones.<verse eid="PSA 84:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 84:7"/>Irán de poder en poder.</para>
  <para style="q" vid="PSA 84:7">Cada uno aparece ante <char style="nd">ʼElohim</char> en Sion.<verse eid="PSA 84:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 84:8"/>Oh <char style="nd">Yavé, ʼElohim</char> de las huestes, escucha mi oración.</para>
  <para style="q" vid="PSA 84:8">Presta oído, oh <char style="nd">ʼElohim</char> de Jacob. <char style="tl">Selah</char><verse eid="PSA 84:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 84:9"/>Mira, oh <char style="nd">ʼElohim</char>, Escudo nuestro.</para>
  <para style="q" vid="PSA 84:9">Mira el rostro de tu ungido.<verse eid="PSA 84:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 84:10"/>Pues mejor es un día en sus patios que 1.000 <char style="add">fuera de ellos</char>.</para>
  <para style="q" vid="PSA 84:10">Prefiero estar en la puerta de la Casa de mi <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 84:10">Que vivir en las tiendas de perversidad.<verse eid="PSA 84:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 84:11"/>Porque Sol y Escudo es <char style="nd">Yavé ʼElohim</char>,</para>
  <para style="q" vid="PSA 84:11">Gracia y gloria da <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 84:11">No retendrá el bien a los que andan en integridad.<verse eid="PSA 84:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 84:12"/>¡Oh <char style="nd">Yavé</char> de las huestes, cuán feliz es el hombre que confía en Ti!<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="s1">Al director del coro. Salmo de los hijos de Coré</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 85:1"/>Oh <char style="nd">Yavé</char>, fuiste favorable a tu tierra.</para>
  <para style="q" vid="PSA 85:1">Devolviste a los cautivos de Jacob.<verse eid="PSA 85:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 85:2"/>Perdonaste la iniquidad de tu pueblo.</para>
  <para style="q" vid="PSA 85:2">Cubriste todos sus pecados. <char style="tl">Selah</char><verse eid="PSA 85:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 85:3"/>Retiraste toda tu indignación.</para>
  <para style="q" vid="PSA 85:3">Te apartaste de tu ardiente ira.<verse eid="PSA 85:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 85:4"/>Restáuranos, oh <char style="nd">ʼElohim</char> de nuestra salvación.</para>
  <para style="q" vid="PSA 85:4">Que cese tu ira contra nosotros.<verse eid="PSA 85:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 85:5"/>¿Estarás airado contra nosotros para siempre?</para>
  <para style="q" vid="PSA 85:5">¿Extenderás tu ira a todas las generaciones?<verse eid="PSA 85:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 85:6"/>¿No volverás Tú a darnos vida</para>
  <para style="q" vid="PSA 85:6">Para que tu pueblo se regocije en Ti?<verse eid="PSA 85:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 85:7"/>¡Muéstranos, oh <char style="nd">Yavé</char>, tu misericordia</para>
  <para style="q" vid="PSA 85:7">Y danos tu salvación!<verse eid="PSA 85:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 85:8"/>Escucharé lo que diga <char style="nd">ʼEL,</char> el <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 85:8">Porque hablará paz a su pueblo y a sus santos</para>
  <para style="q" vid="PSA 85:8">Para que no vuelvan a la insensatez.<verse eid="PSA 85:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 85:9"/>Ciertamente tu salvación está cerca a los que te temen,</para>
  <para style="q" vid="PSA 85:9">Para que la gloria more en nuestra tierra.<verse eid="PSA 85:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 85:10"/>La misericordia y la verdad se encontraron.</para>
  <para style="q" vid="PSA 85:10">La justicia y la paz se besaron.<verse eid="PSA 85:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 85:11"/>La verdad brota de la tierra,</para>
  <para style="q" vid="PSA 85:11">Y la justicia mira desde el cielo.<verse eid="PSA 85:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 85:12"/>Ciertamente <char style="nd">Yavé</char> dará lo bueno,</para>
  <para style="q" vid="PSA 85:12">Y nuestra tierra dará su fruto.<verse eid="PSA 85:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 85:13"/>La justicia irá delante de Él,</para>
  <para style="q" vid="PSA 85:13">Y sus pisadas serán <char style="add">nuestro</char> camino.<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="s1">Oración de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 86:1"/>Oh <char style="nd">Yavé</char>, inclina tu oído y escúchame.</para>
  <para style="q" vid="PSA 86:1">Porque estoy afligido y necesitado.<verse eid="PSA 86:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 86:2"/>Guarda mi alma, porque soy piadoso.</para>
  <para style="q" vid="PSA 86:2">Oh <char style="nd">ʼElohim</char> mío, salva a tu esclavo que confía en Ti.<verse eid="PSA 86:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 86:3"/>Oh <char style="nd">ʼAdonay</char>, ten compasión de mí,</para>
  <para style="q" vid="PSA 86:3">Porque a Ti clamo todo el día.<verse eid="PSA 86:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 86:4"/>Oh <char style="nd">ʼAdonay</char>, alegra el alma de tu esclavo,</para>
  <para style="q" vid="PSA 86:4">Porque a Ti levanto mi alma.<verse eid="PSA 86:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 86:5"/>Porque Tú, <char style="nd">ʼAdonay</char>, eres bueno y perdonador,</para>
  <para style="q" vid="PSA 86:5">Grande en misericordia para todos los que te invocan.<verse eid="PSA 86:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 86:6"/>Oh <char style="nd">Yavé</char>, escucha mi oración</para>
  <para style="q" vid="PSA 86:6">Y atiende a la voz de mis súplicas.<verse eid="PSA 86:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 86:7"/>En el día de mi angustia te llamaré,</para>
  <para style="q" vid="PSA 86:7">Porque Tú me responderás.<verse eid="PSA 86:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 86:8"/>Oh <char style="nd">ʼAdonay</char>, no hay uno como Tú entre los <char style="tl">ʼelohim</char>,</para>
  <para style="q" vid="PSA 86:8">Ni obras que igualen tus obras.<verse eid="PSA 86:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 86:9"/>Oh <char style="nd">ʼAdonay</char>, vendrán todas las naciones que hiciste,</para>
  <para style="q" vid="PSA 86:9">Se postrarán delante de Ti</para>
  <para style="q" vid="PSA 86:9">Y glorificarán tu Nombre.<verse eid="PSA 86:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 86:10"/>Porque Tú eres grande,</para>
  <para style="q" vid="PSA 86:10">Hacedor de maravillas.</para>
  <para style="b" vid="PSA 86:10"/>
  <para style="q" vid="PSA 86:10">¡Solo Tú eres <char style="nd">ʼElohim</char>!<verse eid="PSA 86:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 86:11"/>Enséñame, oh <char style="nd">Yavé</char>, tu camino.</para>
  <para style="q" vid="PSA 86:11">Caminaré en tu verdad.</para>
  <para style="q" vid="PSA 86:11">Afirma mi corazón para que tema tu Nombre.<verse eid="PSA 86:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 86:12"/>Oh <char style="nd">ʼAdonay</char>, <char style="nd">ʼElohim</char> mío, te alabaré con todo mi corazón.</para>
  <para style="q" vid="PSA 86:12">Glorificaré tu Nombre para siempre.<verse eid="PSA 86:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 86:13"/>Porque tu misericordia es grande hacia mí,</para>
  <para style="q" vid="PSA 86:13">Libraste mi alma de las profundidades del <char style="tl">Seol</char>.<verse eid="PSA 86:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 86:14"/>Oh <char style="nd">ʼElohim</char>, hombres arrogantes se levantaron contra mí,</para>
  <para style="q" vid="PSA 86:14">Y una banda de violentos busca mi vida.</para>
  <para style="q" vid="PSA 86:14">No te colocaron delante de ellos.<verse eid="PSA 86:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 86:15"/>Pero Tú, <char style="nd">ʼAdonay</char>, eres un <char style="nd">ʼEL</char> misericordioso y compasivo,</para>
  <para style="q" vid="PSA 86:15">Lento para la ira y grande en misericordia y verdad.<verse eid="PSA 86:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 86:16"/>Mírame y ten compasión de mí.</para>
  <para style="q" vid="PSA 86:16">Da tu fortaleza a tu esclavo,</para>
  <para style="q" vid="PSA 86:16">Y salva al hijo de tu esclava.<verse eid="PSA 86:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 86:17"/>Muéstrame una señal para bien.</para>
  <para style="q" vid="PSA 86:17">Que <char style="add">la</char> vean los que me aborrecen</para>
  <para style="q" vid="PSA 86:17">Y sean avergonzados.</para>
  <para style="q" vid="PSA 86:17">Porque Tú, oh <char style="nd">Yavé</char>, me ayudaste y me consolaste.<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="s1">Salmo de los hijos de Coré. Canto</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 87:1"/>Su cimiento está en las santas montañas.<verse eid="PSA 87:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 87:2"/>Ama <char style="nd">Yavé</char> las puertas de Sion</para>
  <para style="q" vid="PSA 87:2">Más que todas las tiendas de Jacob.<verse eid="PSA 87:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 87:3"/>Cosas gloriosas se dicen de ti,</para>
  <para style="q" vid="PSA 87:3">¡Oh ciudad de <char style="nd">ʼElohim</char>! <char style="tl">Selah</char><verse eid="PSA 87:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 87:4"/>
    <char style="wj">Mencionaré a Rahab y a Babilonia entre los que me conocen. </char></para>
  <para style="q" vid="PSA 87:4">
    <char style="wj">Ahí están Filistea, Tiro y Etiopía: </char></para>
  <para style="q" vid="PSA 87:4">
    <char style="wj">Éste nació allá.</char><verse eid="PSA 87:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 87:5"/>De Sion se dirá: Éste y aquél nacieron en ella,</para>
  <para style="q" vid="PSA 87:5">Y el mismo <char style="nd">ʼElyón</char> la establecerá.<verse eid="PSA 87:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 87:6"/>
    <char style="nd">Yavé</char> contará al registrar a los pueblos:</para>
  <para style="q" vid="PSA 87:6">
    <char style="wj">Éste nació allí.</char> <char style="tl">Selah</char><verse eid="PSA 87:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 87:7"/>Entonces tanto los que cantan</para>
  <para style="q" vid="PSA 87:7">Como los que tocan flautas dirán:</para>
  <para style="q" vid="PSA 87:7">¡Todas mis fuentes están en ti!<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="s1">Canto. Salmo de los hijos de Coré. Al director del coro, al estilo de duelo (<char style="tl">Leannoth</char>). Instrucción (<char style="tl">Maskil</char>) de Hemán ezraíta.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 88:1"/>Oh <char style="nd">Yavé, ʼElohim</char> de mi salvación,</para>
  <para style="q" vid="PSA 88:1">Día y noche clamo delante de Ti.<verse eid="PSA 88:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 88:2"/>Llegue mi oración a tu Presencia.</para>
  <para style="q" vid="PSA 88:2">Inclina tu oído a mi clamor.<verse eid="PSA 88:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 88:3"/>Porque mi alma está harta de aflicciones,</para>
  <para style="q" vid="PSA 88:3">Y mi vida se acerca al <char style="tl">Seol</char>.<verse eid="PSA 88:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 88:4"/>Soy contado entre los que descienden al sepulcro.</para>
  <para style="q" vid="PSA 88:4">Soy como un varón sin fuerza,<verse eid="PSA 88:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 88:5"/>Olvidado entre los muertos,</para>
  <para style="q" vid="PSA 88:5">Como los asesinados que están tendidos en la tumba,</para>
  <para style="q" vid="PSA 88:5">De quienes ya no te acuerdas, y son cortados de tu mano.<verse eid="PSA 88:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 88:6"/>Me colocaste en la fosa más profunda,</para>
  <para style="q" vid="PSA 88:6">En lugares oscuros, en las profundidades.<verse eid="PSA 88:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 88:7"/>Tu ira pesa sobre mí.</para>
  <para style="q" vid="PSA 88:7">Me afliges con todas tus olas. <char style="tl">Selah</char><verse eid="PSA 88:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 88:8"/>Alejaste a mis conocidos de mí.</para>
  <para style="q" vid="PSA 88:8">Me pusiste como un objeto de repugnancia para ellos.</para>
  <para style="q" vid="PSA 88:8">Estoy encerrado y no puedo salir.<verse eid="PSA 88:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 88:9"/>Mis ojos se enfermaron por causa de la aflicción.</para>
  <para style="b" vid="PSA 88:9"/>
  <para style="q" vid="PSA 88:9">Cada día te invoco, oh <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 88:9">Extiendo mis manos hacia Ti:<verse eid="PSA 88:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 88:10"/>¿Harás milagros a favor de los muertos?</para>
  <para style="q" vid="PSA 88:10">¿Se levantarán los muertos para alabarte? <char style="tl">Selah</char><verse eid="PSA 88:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 88:11"/>¿Se anunciará en el sepulcro tu misericordia,</para>
  <para style="q" vid="PSA 88:11">Tu fidelidad en el <char style="tl">Abadón</char>?<note caller="+" style="f"><char style="fr" closed="false">88.11 </char><char style="ft" closed="false"><char style="tl">Abadón:</char> lugar de perdición.</char></note><verse eid="PSA 88:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 88:12"/>¿Serán reconocidas tus maravillas en la oscuridad,</para>
  <para style="q" vid="PSA 88:12">Y tu justicia en la tierra del olvido?<verse eid="PSA 88:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 88:13"/>Pero yo te invoco, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 88:13">Clamo por ayuda.</para>
  <para style="q" vid="PSA 88:13">De mañana mi súplica llega delante de Ti.<verse eid="PSA 88:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 88:14"/>¿Por qué, oh <char style="nd">Yavé</char>, desechas mi alma?</para>
  <para style="q" vid="PSA 88:14">¿Por qué escondes de mí tu rostro?<verse eid="PSA 88:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 88:15"/>Desde mi juventud estuve afligido y necesitado.</para>
  <para style="q" vid="PSA 88:15">Sufrí tus terrores.</para>
  <para style="q" vid="PSA 88:15">Estuve turbado.<verse eid="PSA 88:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 88:16"/>Tu ardiente ira pasó sobre mí.</para>
  <para style="q" vid="PSA 88:16">Tus terrores me destruyeron.<verse eid="PSA 88:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 88:17"/>Me rodean de continuo como aguas.</para>
  <para style="q" vid="PSA 88:17">En conjunto me cercaron.<verse eid="PSA 88:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 88:18"/>Alejaste de mí a mis amigos y compañeros.</para>
  <para style="q" vid="PSA 88:18">Solo la oscuridad es mi compañera.<verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="s1">Instrucción (<char style="tl">Maskil</char>) de Etán ezraíta</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 89:1"/>Las misericordias de <char style="nd">Yavé</char> cantaré perpetuamente.</para>
  <para style="q" vid="PSA 89:1">Con mi boca proclamaré tu fidelidad.<verse eid="PSA 89:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 89:2"/>Porque dije: La misericordia será edificada para siempre.</para>
  <para style="q" vid="PSA 89:2">En los cielos estableces tu fidelidad.<verse eid="PSA 89:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 89:3"/>
    <char style="wj">Pacté con mi escogido.</char></para>
  <para style="q" vid="PSA 89:3">
    <char style="wj">Juré a David mi esclavo:</char><verse eid="PSA 89:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 89:4"/>
    <char style="wj">Estableceré tu descendencia para siempre</char></para>
  <para style="q" vid="PSA 89:4">
    <char style="wj">Y edificaré tu trono para todas tus generaciones.</char> <char style="tl">Selah</char><verse eid="PSA 89:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 89:5"/>Los cielos alabarán tus maravillas, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 89:5">Y tu fidelidad en la congregación de los santos.<verse eid="PSA 89:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 89:6"/>Porque, ¿quién en los cielos es comparable a <char style="nd">Yavé</char>?</para>
  <para style="q" vid="PSA 89:6">¿Quién entre los hijos de <char style="nd">ʼEL</char> es como <char style="nd">Yavé</char>?<verse eid="PSA 89:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 89:7"/>
    <char style="nd">ʼEL</char> es grandemente temido en la congregación de los santos,</para>
  <para style="q" vid="PSA 89:7">Asombroso por encima de todos los que están alrededor de Él.<verse eid="PSA 89:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 89:8"/>Oh <char style="nd">Yavé, ʼElohim</char> de las huestes, ¿quién como Tú, oh poderoso <char style="nd">YA</char>?</para>
  <para style="q" vid="PSA 89:8">Tu fidelidad también te rodea.<verse eid="PSA 89:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 89:9"/>Tú dominas la braveza del mar.</para>
  <para style="q" vid="PSA 89:9">Cuando se levantan sus olas,</para>
  <para style="q" vid="PSA 89:9">Tú las calmas.<verse eid="PSA 89:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 89:10"/>Tú quebrantaste <char style="add">al monstruo </char>Rahab.</para>
  <para style="q" vid="PSA 89:10">Como a uno que es herido de muerte</para>
  <para style="q" vid="PSA 89:10">Esparciste a tus enemigos con tu poderoso brazo.<verse eid="PSA 89:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 89:11"/>Tuyos son los cielos.</para>
  <para style="q" vid="PSA 89:11">Tuya también la tierra,</para>
  <para style="q" vid="PSA 89:11">El mundo y todo lo que contiene.</para>
  <para style="q" vid="PSA 89:11">Tú los fundaste.<verse eid="PSA 89:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 89:12"/>Tú creaste el norte y el sur.</para>
  <para style="q" vid="PSA 89:12">La montaña Tabor y la montaña Hermón se regocijan en tu Nombre.<verse eid="PSA 89:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 89:13"/>Tienes un brazo potente.</para>
  <para style="q" vid="PSA 89:13">Poderosa es tu mano.</para>
  <para style="q" vid="PSA 89:13">Tu mano derecha es exaltada.<verse eid="PSA 89:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 89:14"/>La justicia y el juicio justo son el cimiento de tu trono.</para>
  <para style="q" vid="PSA 89:14">La misericordia y la verdad van delante de Ti.<verse eid="PSA 89:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 89:15"/>Inmensamente feliz es el pueblo que conoce el clamor de júbilo.</para>
  <para style="q" vid="PSA 89:15">Andarán a la luz de tu rostro, oh <char style="nd">Yavé</char>.<verse eid="PSA 89:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 89:16"/>En tu Nombre se regocijan todo el día,</para>
  <para style="q" vid="PSA 89:16">Y en justicia son exaltados.<verse eid="PSA 89:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 89:17"/>Porque Tú eres el esplendor de su fuerza,</para>
  <para style="q" vid="PSA 89:17">Y por tu buena voluntad exaltas nuestro poder.<verse eid="PSA 89:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 89:18"/>Porque de <char style="nd">Yavé</char> es nuestro escudo,</para>
  <para style="q" vid="PSA 89:18">De nuestro Rey, el Santo de Israel.<verse eid="PSA 89:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 89:19"/>En un tiempo hablaste en visión a tus santos.</para>
  <para style="q" vid="PSA 89:19">Dijiste: <char style="wj">Di ayuda a uno que es poderoso.</char></para>
  <para style="q" vid="PSA 89:19">
    <char style="wj">Exalté a uno escogido del pueblo.</char><verse eid="PSA 89:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 89:20"/>
    <char style="wj">Hallé a David mi esclavo.</char></para>
  <para style="q" vid="PSA 89:20">
    <char style="wj">Lo ungí con mi aceite santo.</char><verse eid="PSA 89:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 89:21"/>
    <char style="wj">Mi mano estará siempre con él.</char></para>
  <para style="q" vid="PSA 89:21">
    <char style="wj">Mi brazo también lo fortalecerá.</char><verse eid="PSA 89:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PSA 89:22"/>
    <char style="wj">El enemigo no lo engañará,</char></para>
  <para style="q" vid="PSA 89:22">
    <char style="wj">Ni el hijo del perverso lo afligirá.</char><verse eid="PSA 89:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 89:23"/>
    <char style="wj">Porque Yo quebrantaré a sus adversarios delante de él,</char></para>
  <para style="q" vid="PSA 89:23">
    <char style="wj">Y golpearé a los que lo aborrecen.</char><verse eid="PSA 89:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PSA 89:24"/>
    <char style="wj">Mi fidelidad y mi misericordia estarán con él,</char></para>
  <para style="q" vid="PSA 89:24">
    <char style="wj">Y en mi Nombre será exaltado su poder.</char><verse eid="PSA 89:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 89:25"/>
    <char style="wj">Pondré también su mano sobre el mar,</char></para>
  <para style="q" vid="PSA 89:25">
    <char style="wj">Y su mano derecha sobre los ríos.</char><verse eid="PSA 89:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PSA 89:26"/>
    <char style="wj">Él clamará a mi <char style="nd">ʼEL</char>: ¡Tú eres mi Padre,</char></para>
  <para style="q" vid="PSA 89:26">
    <char style="wj">Mi <char style="nd">ʼEL</char> y la Roca de mi salvación!</char><verse eid="PSA 89:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 89:27"/>
    <char style="wj">Yo también lo constituiré como primogénito,</char></para>
  <para style="q" vid="PSA 89:27">
    <char style="wj">El más excelso de los reyes de la tierra.</char><verse eid="PSA 89:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PSA 89:28"/>
    <char style="wj">Para siempre le mantendré mi misericordia,</char></para>
  <para style="q" vid="PSA 89:28">
    <char style="wj">Y mi Pacto con él será confirmado.</char><verse eid="PSA 89:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 89:29"/>
    <char style="wj">Así estableceré su descendencia para siempre,</char></para>
  <para style="q" vid="PSA 89:29">
    <char style="wj">Y su trono como los días del cielo.</char><verse eid="PSA 89:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PSA 89:30"/>
    <char style="wj">Si sus hijos abandonan mi Ley,</char></para>
  <para style="q" vid="PSA 89:30">
    <char style="wj">Y no andan en mis Ordenanzas,</char><verse eid="PSA 89:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 89:31"/>
    <char style="wj">Si profanan mis Estatutos</char></para>
  <para style="q" vid="PSA 89:31">
    <char style="wj">Y no guardan mis Mandamientos,</char><verse eid="PSA 89:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 89:32"/>
    <char style="wj">Entonces castigaré con vara su transgresión</char></para>
  <para style="q" vid="PSA 89:32">
    <char style="wj">Y con azotes su iniquidad.</char><verse eid="PSA 89:32"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="33" style="v" sid="PSA 89:33"/>
    <char style="wj">Pero no retiraré de él mi misericordia,</char></para>
  <para style="q" vid="PSA 89:33">
    <char style="wj">Ni faltaré a mi fidelidad.</char><verse eid="PSA 89:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 89:34"/>
    <char style="wj">No violaré mi Pacto,</char></para>
  <para style="q" vid="PSA 89:34">
    <char style="wj">Ni alteraré lo que pronunciaron mis labios.</char><verse eid="PSA 89:34"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="35" style="v" sid="PSA 89:35"/>
    <char style="wj">Una vez juré por mi santidad,</char></para>
  <para style="q" vid="PSA 89:35">
    <char style="wj">Y no mentiré a David: </char><verse eid="PSA 89:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 89:36"/>
    <char style="wj">Su descendencia será para siempre,</char></para>
  <para style="q" vid="PSA 89:36">
    <char style="wj">Y su trono como el sol delante de Mí.</char><verse eid="PSA 89:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 89:37"/>
    <char style="wj">Será establecido para siempre, como la luna,</char></para>
  <para style="q" vid="PSA 89:37">
    <char style="wj">Testigo fiel en el firmamento. <char style="tl">Selah</char> </char><verse eid="PSA 89:37"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="38" style="v" sid="PSA 89:38"/>Pero ahora Tú <char style="add">lo</char> desechas y rechazas.</para>
  <para style="q" vid="PSA 89:38">Estás lleno de ira contra tu ungido.<verse eid="PSA 89:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 89:39"/>Rompiste el Pacto con tu esclavo.</para>
  <para style="q" vid="PSA 89:39">Profanaste su corona hasta la tierra.<verse eid="PSA 89:39"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="40" style="v" sid="PSA 89:40"/>Destruiste todos sus muros.</para>
  <para style="q" vid="PSA 89:40">Arruinaste sus fortalezas.<verse eid="PSA 89:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 89:41"/>Todos los que pasan por el camino lo saquean.</para>
  <para style="q" vid="PSA 89:41">Es <char style="add">objeto de</char> reproche para sus vecinos.<verse eid="PSA 89:41"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="42" style="v" sid="PSA 89:42"/>Exaltaste la mano derecha de sus adversarios.</para>
  <para style="q" vid="PSA 89:42">Alegraste a todos sus enemigos.<verse eid="PSA 89:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 89:43"/>También embotaste el filo de su espada,</para>
  <para style="q" vid="PSA 89:43">Y no lo afirmaste en la batalla.<verse eid="PSA 89:43"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="44" style="v" sid="PSA 89:44"/>Cesaste su esplendor</para>
  <para style="q" vid="PSA 89:44">Y echaste a tierra su trono.<verse eid="PSA 89:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 89:45"/>Acortaste los días de su juventud.</para>
  <para style="q" vid="PSA 89:45">Lo cubriste de vergüenza. <char style="tl">Selah</char><verse eid="PSA 89:45"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="46" style="v" sid="PSA 89:46"/>¿Hasta cuándo, oh <char style="nd">Yavé</char>?</para>
  <para style="q" vid="PSA 89:46">¿Te esconderás para siempre?</para>
  <para style="q" vid="PSA 89:46">¿Arderá tu ira como fuego?<verse eid="PSA 89:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 89:47"/>Recuerda cuál es la duración de mi vida.</para>
  <para style="q" vid="PSA 89:47">¡Con qué vanidad creaste a todos los hijos de hombres!<verse eid="PSA 89:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 89:48"/>¿Cuál hombre vivirá sin sufrir muerte?</para>
  <para style="q" vid="PSA 89:48">¿Puede él librar su alma del poder del <char style="tl">Seol</char>? <char style="tl">Selah</char><verse eid="PSA 89:48"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="49" style="v" sid="PSA 89:49"/>Oh <char style="nd">ʼAdonay</char>, ¿dónde están sus primeras misericordias</para>
  <para style="q" vid="PSA 89:49">Que en tu fidelidad juraste a David?<verse eid="PSA 89:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 89:50"/>Acuérdate, oh <char style="nd">ʼAdonay</char>, del reproche a tus esclavos,</para>
  <para style="q" vid="PSA 89:50">Que llevo en mi seno de muchos pueblos.<verse eid="PSA 89:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 89:51"/>Porque tus enemigos, oh <char style="nd">Yavé</char>, deshonraron</para>
  <para style="q" vid="PSA 89:51">Con lo cual reprocharon las pisadas de tu ungido.<verse eid="PSA 89:51"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="52" style="v" sid="PSA 89:52"/>¡Bendito sea <char style="nd">Yavé</char> para siempre!</para>
  <para style="q" vid="PSA 89:52">Amén y amén.<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="s1">Oración de Moisés, varón de <char style="nd">ʼElohim</char></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 90:1"/>Oh <char style="nd">ʼAdonay</char>, Tú fuiste nuestro Refugio en todas las generaciones.<verse eid="PSA 90:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 90:2"/>Antes que nacieran las montañas,</para>
  <para style="q" vid="PSA 90:2">O formaras la tierra y el mundo,</para>
  <para style="q" vid="PSA 90:2">Desde la eternidad y hasta la eternidad,</para>
  <para style="q" vid="PSA 90:2">Tú eres <char style="nd">ʼEL.</char><verse eid="PSA 90:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 90:3"/>Devuelves el hombre al polvo,</para>
  <para style="q" vid="PSA 90:3">Y dices: <char style="wj">Conviértanse, hijos de hombres.</char><verse eid="PSA 90:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 90:4"/>Porque 1.000 años delante de tus ojos son como el día de ayer que pasó,</para>
  <para style="q" vid="PSA 90:4">O como una de las vigilias de la noche.<verse eid="PSA 90:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 90:5"/>Los arrastras con torrentes de agua.</para>
  <para style="q" vid="PSA 90:5">Son como un sueño.</para>
  <para style="q" vid="PSA 90:5">Son como la hierba que crece en la mañana.<verse eid="PSA 90:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 90:6"/>En la mañana reverdece y florece,</para>
  <para style="q" vid="PSA 90:6">Hacia la llegada de la noche se marchita y se seca.<verse eid="PSA 90:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 90:7"/>Porque somos consumidos con tu ira,</para>
  <para style="q" vid="PSA 90:7">Y con tu furor somos turbados.<verse eid="PSA 90:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 90:8"/>Colocaste nuestras iniquidades ante Ti,</para>
  <para style="q" vid="PSA 90:8">Nuestras cosas ocultas a la luz de tu rostro.<verse eid="PSA 90:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 90:9"/>Porque todos nuestros días declinan a causa de tu ira.</para>
  <para style="q" vid="PSA 90:9">Terminamos nuestros años como un suspiro.<verse eid="PSA 90:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 90:10"/>Los días de nuestra vida son 70 años,</para>
  <para style="q" vid="PSA 90:10">Y en los robustos, 80 años.</para>
  <para style="q" vid="PSA 90:10">Sin embargo, su fortaleza es molestia y trabajo,</para>
  <para style="q" vid="PSA 90:10">Porque pronto pasan y volamos.<verse eid="PSA 90:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 90:11"/>¿Quién entiende el poder de tu ira</para>
  <para style="q" vid="PSA 90:11">Y tu indignación como debes ser temido?<verse eid="PSA 90:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 90:12"/>Enséñanos a contar nuestros días</para>
  <para style="q" vid="PSA 90:12">De tal modo que traigamos al corazón sabiduría.<verse eid="PSA 90:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 90:13"/>Vuélvete, oh <char style="nd">Yavé</char>. ¿Hasta cuándo?</para>
  <para style="q" vid="PSA 90:13">Ten compasión de tus esclavos.<verse eid="PSA 90:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 90:14"/>En la mañana sácianos de tu misericordia,</para>
  <para style="q" vid="PSA 90:14">Y cantaremos y nos alegraremos todos nuestros días.<verse eid="PSA 90:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 90:15"/>Alégranos según los días que nos afligiste,</para>
  <para style="q" vid="PSA 90:15">Y los años en los cuales vimos el mal.<verse eid="PSA 90:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 90:16"/>Que tu obra aparezca en tus esclavos,</para>
  <para style="q" vid="PSA 90:16">Y tu majestad en sus hijos.<verse eid="PSA 90:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 90:17"/>Sea la gracia de <char style="nd">ʼAdonay</char> nuestro <char style="nd">ʼElohim</char> sobre nosotros,</para>
  <para style="q" vid="PSA 90:17">Y nos confirme la obra de nuestras manos.</para>
  <para style="q" vid="PSA 90:17">¡Sí, confirma la obra de nuestras manos!<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 91:1"/>El que mora al abrigo del <char style="nd">ʼElyón</char></para>
  <para style="q" vid="PSA 91:1">Morará bajo la sombra del <char style="nd">Shadday</char>.<verse eid="PSA 91:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 91:2"/>Diré yo a <char style="nd">Yavé</char>:</para>
  <para style="q" vid="PSA 91:2">¡Refugio mío y Fortaleza mía,</para>
  <para style="q" vid="PSA 91:2">Mi <char style="nd">ʼElohim</char>, en Quien confío!<verse eid="PSA 91:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 91:3"/>Él te librará de la trampa del cazador,</para>
  <para style="q" vid="PSA 91:3">Y de la mortal pestilencia.<verse eid="PSA 91:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 91:4"/>Con sus plumas te cubrirá,</para>
  <para style="q" vid="PSA 91:4">Y debajo de sus alas te refugiarás.</para>
  <para style="q" vid="PSA 91:4">Escudo y adarga<note caller="+" style="f"><char style="fr" closed="false">91.4 </char><char style="ft" closed="false">Adarga: pequeño escuelo de cuero casi siempre ovalado.</char></note> es su verdad.<verse eid="PSA 91:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 91:5"/>No temerás el terror nocturno,</para>
  <para style="q" vid="PSA 91:5">Ni a flecha que vuele de día,<verse eid="PSA 91:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 91:6"/>Ni a pestilencia que ande en <char style="add">la</char> oscuridad,</para>
  <para style="q" vid="PSA 91:6">Ni a mortandad que a mediodía destruya.<verse eid="PSA 91:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 91:7"/>Caerán a tu lado 1.000,</para>
  <para style="q" vid="PSA 91:7">Y 10.000 a tu mano derecha,</para>
  <para style="q" vid="PSA 91:7">Pero a ti no llegará.<verse eid="PSA 91:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 91:8"/>Ciertamente mirarás con tus ojos,</para>
  <para style="q" vid="PSA 91:8">Y verás la recompensa de los perversos.<verse eid="PSA 91:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 91:9"/>Por cuanto pusiste a <char style="nd">Yavé</char>, mi Refugio,</para>
  <para style="q" vid="PSA 91:9">A <char style="nd">ʼElyón</char> como tu Lugar de morada,<verse eid="PSA 91:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 91:10"/>No te vendrá mal,</para>
  <para style="q" vid="PSA 91:10">Ni alguna plaga tocará tu morada.<verse eid="PSA 91:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 91:11"/>Pues a sus ángeles mandará con respecto a Ti,</para>
  <para style="q" vid="PSA 91:11">Que te guarden en todos tus caminos.<verse eid="PSA 91:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 91:12"/>En sus manos te llevarán</para>
  <para style="q" vid="PSA 91:12">Para que tu pie no tropiece en piedra.<verse eid="PSA 91:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 91:13"/>Sobre el león y el áspid<note caller="+" style="f"><char style="fr" closed="false">91.13 </char><char style="ft" closed="false">Áspid: Culebra venenosa propia de Egipto que puede alcanzar dos metros de longitud.</char></note> pisarás.</para>
  <para style="q" vid="PSA 91:13">Pisotearás al cachorro de león y al dragón.<verse eid="PSA 91:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 91:14"/>
    <char style="wj">Me amó,</char></para>
  <para style="q" vid="PSA 91:14">
    <char style="wj">Por tanto Yo lo libraré.</char></para>
  <para style="q" vid="PSA 91:14">
    <char style="wj">Lo pondré en alto,</char></para>
  <para style="q" vid="PSA 91:14">
    <char style="wj">Porque conoció mi Nombre.</char><verse eid="PSA 91:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 91:15"/>
    <char style="wj">Me invocará</char></para>
  <para style="q" vid="PSA 91:15">
    <char style="wj">Y Yo le responderé.</char></para>
  <para style="q" vid="PSA 91:15">
    <char style="wj">Estaré con él en la angustia.</char></para>
  <para style="q" vid="PSA 91:15">
    <char style="wj">Lo libraré y lo glorificaré.</char><verse eid="PSA 91:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 91:16"/>
    <char style="wj">Lo saciaré de larga vida y le mostraré mi salvación.</char><verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="s1">Salmo. Canto para el sábado</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 92:1"/>Bueno es alabar a <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 92:1">Y cantar salmos a tu Nombre, oh <char style="nd">ʼElyón</char>.<verse eid="PSA 92:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 92:2"/>Anunciar por la mañana tu misericordia</para>
  <para style="q" vid="PSA 92:2">Y tu fidelidad cada noche<verse eid="PSA 92:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 92:3"/>Con el decacordio y el salterio,<note caller="+" style="f"><char style="fr" closed="false">92.3 </char><char style="ft" closed="false">Decacordio: Instrumento músico de diez cuerdas. Salterio: Instrumento músico de 12 cuerdas hechas con intestino grueso de ovejas. Se pulsaba con los dedos. </char></note></para>
  <para style="q" vid="PSA 92:3">Con el armonioso tono del arpa.<verse eid="PSA 92:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 92:4"/>Porque Tú, oh <char style="nd">Yavé</char>, me alegraste con lo que hiciste.</para>
  <para style="q" vid="PSA 92:4">Por las obras de tus manos doy gritos de júbilo.<verse eid="PSA 92:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 92:5"/>¡Cuán grandes son tus obras, oh <char style="nd">Yavé</char>!</para>
  <para style="q" vid="PSA 92:5">Tus pensamientos son muy profundos.<verse eid="PSA 92:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 92:6"/>El hombre necio no sabe</para>
  <para style="q" vid="PSA 92:6">Y el insensato no entiende esto:<verse eid="PSA 92:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 92:7"/>Que cuando los perversos brotan como hierba,</para>
  <para style="q" vid="PSA 92:7">Y florecen todos los que hacen iniquidad,</para>
  <para style="q" vid="PSA 92:7">
    <char style="add">Solo sucede</char> para que sean destruidos eternamente.<verse eid="PSA 92:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 92:8"/>Pero Tú, oh <char style="nd">Yavé</char>, eres altísimo para siempre.<verse eid="PSA 92:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 92:9"/>Porque ya veo que tus enemigos, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 92:9">Ya veo que tus enemigos perecen.</para>
  <para style="q" vid="PSA 92:9">Son dispersados todos los obradores de iniquidad.<verse eid="PSA 92:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 92:10"/>Pero Tú aumentarás mi fuerza como la del búfalo.</para>
  <para style="b" vid="PSA 92:10"/>
  <para style="q" vid="PSA 92:10">Seré ungido con aceite fresco.<verse eid="PSA 92:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 92:11"/>Y mis ojos mirarán por encima de mis enemigos.</para>
  <para style="q" vid="PSA 92:11">Mis oídos escucharán</para>
  <para style="q" vid="PSA 92:11">Con respecto a los perversos que se levantan contra mí.<verse eid="PSA 92:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 92:12"/>El justo florecerá como la palmera.</para>
  <para style="q" vid="PSA 92:12">Crecerá como un cedro en el Líbano.<verse eid="PSA 92:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 92:13"/>Plantados en la Casa de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 92:13">Florecerán en los patios de nuestro <char style="nd">ʼElohim</char>.<verse eid="PSA 92:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 92:14"/>Aun en la vejez darán fruto.</para>
  <para style="q" vid="PSA 92:14">Estarán llenos de savia y muy verdes<verse eid="PSA 92:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 92:15"/>Para manifestar que <char style="nd">Yavé</char> es recto.</para>
  <para style="q" vid="PSA 92:15">Mi Roca es.</para>
  <para style="q" vid="PSA 92:15">En Él no hay injusticia.<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 93:1"/>
    <char style="nd">Yavé</char> reina.</para>
  <para style="q" vid="PSA 93:1">Está cubierto de majestad.</para>
  <para style="q" vid="PSA 93:1">
    <char style="nd">Yavé</char> se cubrió y se ató con poder.</para>
  <para style="q" vid="PSA 93:1">El mundo está en verdad firmemente establecido</para>
  <para style="q" vid="PSA 93:1">Y no será conmovido.<verse eid="PSA 93:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 93:2"/>Tu trono está establecido desde la antigüedad.</para>
  <para style="q" vid="PSA 93:2">Tú eres desde la eternidad.<verse eid="PSA 93:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 93:3"/>Oh <char style="nd">Yavé</char>, los torrentes se levantan.</para>
  <para style="q" vid="PSA 93:3">Las crecientes alzaron su voz.</para>
  <para style="q" vid="PSA 93:3">Los ríos levantan sus olas estruendosas.<verse eid="PSA 93:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 93:4"/>
    <char style="nd">Yavé</char> en las alturas es más poderoso</para>
  <para style="q" vid="PSA 93:4">Que el estruendo de muchas aguas,</para>
  <para style="q" vid="PSA 93:4">Que las poderosas olas del mar.<verse eid="PSA 93:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 93:5"/>Tus Testimonios son completamente confirmados.</para>
  <para style="q" vid="PSA 93:5">La santidad conviene a tu Casa,</para>
  <para style="q" vid="PSA 93:5">Oh <char style="nd">Yavé</char>, para siempre.<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 94:1"/>¡Oh <char style="nd">Yavé</char>, <char style="nd">ʼEL</char> vengador!</para>
  <para style="q" vid="PSA 94:1">¡Oh <char style="nd">ʼEL</char> vengador, resplandece!<verse eid="PSA 94:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 94:2"/>¡Levántate, oh Juez de la tierra,</para>
  <para style="q" vid="PSA 94:2">Da la recompensa a los soberbios!<verse eid="PSA 94:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 94:3"/>¿Hasta cuándo los perversos, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 94:3">Hasta cuándo se gozarán los perversos?<verse eid="PSA 94:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 94:4"/>Parlotean insolencias, hablan arrogancias.</para>
  <para style="q" vid="PSA 94:4">Se jactan todos los que cometen perversidad.<verse eid="PSA 94:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 94:5"/>A tu pueblo quebrantan, oh <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 94:5">Oprimen a tu heredad.<verse eid="PSA 94:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 94:6"/>Asesinan a la viuda y al extranjero,</para>
  <para style="q" vid="PSA 94:6">Y matan a los huérfanos.<verse eid="PSA 94:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 94:7"/>Y dicen: El <char style="nd">YA</char> no ve,</para>
  <para style="q" vid="PSA 94:7">Ni discierne el <char style="nd">ʼElohim</char> de Jacob.<verse eid="PSA 94:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 94:8"/>Entiendan ustedes, necios del pueblo.</para>
  <para style="q" vid="PSA 94:8">¿Cuándo entenderán ustedes los fatuos?<verse eid="PSA 94:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 94:9"/>El que hizo el oído, ¿no escucha?</para>
  <para style="q" vid="PSA 94:9">El que formó el ojo, ¿no mira?<verse eid="PSA 94:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 94:10"/>El que amonesta a las naciones, ¿no reprenderá?</para>
  <para style="q" vid="PSA 94:10">El que enseña al hombre el saber, ¿no sabrá?<verse eid="PSA 94:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 94:11"/>
    <char style="nd">Yavé</char> conoce los pensamientos del hombre,</para>
  <para style="q" vid="PSA 94:11">Que son vanidad.<verse eid="PSA 94:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 94:12"/>¡Inmensamente feliz es el varón a quien Tú, oh <char style="nd">YA</char>, disciplinas,</para>
  <para style="q" vid="PSA 94:12">Y a quien Tú enseñas tu Ley!<verse eid="PSA 94:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 94:13"/>Para darle descanso en los días de adversidad</para>
  <para style="q" vid="PSA 94:13">Mientras se cava una fosa para los perversos.<verse eid="PSA 94:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 94:14"/>Porque <char style="nd">Yavé</char> no abandonará a su pueblo,</para>
  <para style="q" vid="PSA 94:14">Ni desamparará a su heredad.<verse eid="PSA 94:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 94:15"/>Porque el juicio volverá a ser justo,</para>
  <para style="q" vid="PSA 94:15">Y todos los rectos de corazón lo seguirán.<verse eid="PSA 94:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 94:16"/>¿Quién se levantará por mí contra los malhechores?</para>
  <para style="q" vid="PSA 94:16">¿Quién se mantendrá en pie por mí contra los que practican perversidad?<verse eid="PSA 94:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 94:17"/>Si <char style="nd">Yavé</char> no me ayuda,</para>
  <para style="q" vid="PSA 94:17">Pronto mi alma moraría en el silencio.<verse eid="PSA 94:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 94:18"/>Si yo digo: ¡Mi pie resbala!</para>
  <para style="q" vid="PSA 94:18">Tu misericordia, oh <char style="nd">Yavé</char>, me sostendrá.<verse eid="PSA 94:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 94:19"/>Cuando mis inquietudes se multiplican dentro de mí,</para>
  <para style="q" vid="PSA 94:19">Tus consolaciones deleitan mi alma.<verse eid="PSA 94:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 94:20"/>¿Se aliará contigo el trono de iniquidad</para>
  <para style="q" vid="PSA 94:20">Que por medio de decretos cometa agravios?<verse eid="PSA 94:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 94:21"/>Conspiran juntos contra la vida del justo</para>
  <para style="q" vid="PSA 94:21">Y condenan a muerte al inocente.<verse eid="PSA 94:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PSA 94:22"/>Pero <char style="nd">Yavé</char> fue mi Fortaleza,</para>
  <para style="q" vid="PSA 94:22">Y mi <char style="nd">ʼElohim</char>, la Roca de mi refugio.<verse eid="PSA 94:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 94:23"/>Él devolverá sobre ellos su iniquidad</para>
  <para style="q" vid="PSA 94:23">Y los destruirá en su maldad.</para>
  <para style="q" vid="PSA 94:23">
    <char style="nd">Yavé</char> nuestro <char style="nd">ʼElohim</char> los destruirá.<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 95:1"/>¡Vengan, cantemos con gozo a <char style="nd">Yavé</char>!</para>
  <para style="q" vid="PSA 95:1">¡Aclamemos con júbilo a la Roca de nuestra salvación!<verse eid="PSA 95:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 95:2"/>Entremos ante su Presencia con acción de gracias,</para>
  <para style="q" vid="PSA 95:2">Aclamémoslo con salmos.<verse eid="PSA 95:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 95:3"/>Porque <char style="nd">Yavé</char> es <char style="nd">ʼEL</char> grande,</para>
  <para style="q" vid="PSA 95:3">Y gran Rey sobre todos los <char style="tl">ʼelohim</char>.<verse eid="PSA 95:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 95:4"/>En su mano están las profundidades de la tierra.</para>
  <para style="q" vid="PSA 95:4">Suyas son las alturas de las montañas.<verse eid="PSA 95:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 95:5"/>Suyo es el mar, pues Él lo hizo,</para>
  <para style="q" vid="PSA 95:5">Y sus manos formaron la tierra seca.<verse eid="PSA 95:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 95:6"/>Vengan, adoremos y postrémonos.</para>
  <para style="q" vid="PSA 95:6">Arrodillémonos <char style="add">ante</char> la Presencia de <char style="nd">Yavé</char>, nuestro Hacedor,<verse eid="PSA 95:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 95:7"/>Porque Él es nuestro <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 95:7">Nosotros el pueblo de su prado y ovejas de su mano.</para>
  <para style="b" vid="PSA 95:7"/>
  <para style="q" vid="PSA 95:7">Si ustedes oyen hoy su voz,<verse eid="PSA 95:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 95:8"/>
    <char style="wj">No endurezcan sus corazones como en Meriba,</char></para>
  <para style="q" vid="PSA 95:8">
    <char style="wj">Como en el día de Masa en el desierto,</char><verse eid="PSA 95:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 95:9"/>
    <char style="wj">Cuando me tentaron sus antepasados.</char></para>
  <para style="q" vid="PSA 95:9">
    <char style="wj">Me probaron, aunque vieron mi obra.</char><verse eid="PSA 95:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 95:10"/>
    <char style="wj">Durante 40 años estuve disgustado con aquella generación,</char></para>
  <para style="q" vid="PSA 95:10">
    <char style="wj">Y dije: Es un pueblo que divaga en su corazón,</char></para>
  <para style="q" vid="PSA 95:10">
    <char style="wj">Y no conoce mis caminos.</char><verse eid="PSA 95:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 95:11"/>
    <char style="wj">Por tanto, juré en mi ira</char></para>
  <para style="q" vid="PSA 95:11">
    <char style="wj">Que no entrarán en mi reposo.</char><verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 96:1"/>¡Canten a <char style="nd">Yavé</char> un canto nuevo!</para>
  <para style="q" vid="PSA 96:1">¡Cante a <char style="nd">Yavé</char> toda la tierra!<verse eid="PSA 96:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 96:2"/>¡Canten a <char style="nd">Yavé</char>, bendigan su Nombre!</para>
  <para style="q" vid="PSA 96:2">Anuncien de día en día su salvación.<verse eid="PSA 96:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 96:3"/>Proclamen su gloria entre las naciones,</para>
  <para style="q" vid="PSA 96:3">Entre todos los pueblos, sus maravillosas obras.<verse eid="PSA 96:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 96:4"/>Porque grande es <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 96:4">Y digno de suprema alabanza.</para>
  <para style="q" vid="PSA 96:4">Él debe ser temido por encima de todos los <char style="tl">ʼelohim</char>.<verse eid="PSA 96:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 96:5"/>Porque todos los <char style="tl">ʼelohim</char> de los pueblos son ídolos.</para>
  <para style="q" vid="PSA 96:5">Pero <char style="nd">Yavé</char> hizo los cielos.<verse eid="PSA 96:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 96:6"/>Esplendor y majestad hay ante Él.</para>
  <para style="q" vid="PSA 96:6">Fortaleza y hermosura hay en su Santuario.<verse eid="PSA 96:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 96:7"/>Tributen a <char style="nd">Yavé</char>, oh familias de los pueblos.</para>
  <para style="q" vid="PSA 96:7">Tributen a <char style="nd">Yavé</char> gloria y fortaleza.<verse eid="PSA 96:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 96:8"/>Tributen a <char style="nd">Yavé</char> la gloria debida a su Nombre.</para>
  <para style="q" vid="PSA 96:8">Lleven ofrenda y entren en sus patios.<verse eid="PSA 96:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 96:9"/>Adoren a <char style="nd">Yavé</char> en la hermosura de la santidad.</para>
  <para style="q" vid="PSA 96:9">Tiemble ante Él toda la tierra.<verse eid="PSA 96:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 96:10"/>Digan entre las naciones: ¡<char style="nd">Yavé</char> reina!</para>
  <para style="q" vid="PSA 96:10">Ciertamente el mundo está firmemente establecido.</para>
  <para style="q" vid="PSA 96:10">No será conmovido.</para>
  <para style="q" vid="PSA 96:10">Él juzgará a los pueblos con equidad.<verse eid="PSA 96:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 96:11"/>¡Alégrense los cielos</para>
  <para style="q" vid="PSA 96:11">Y regocíjese la tierra!</para>
  <para style="q" vid="PSA 96:11">Brame el mar y todo lo que contiene.<verse eid="PSA 96:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 96:12"/>Exáltese el campo y todo lo que hay en él.</para>
  <para style="b" vid="PSA 96:12"/>
  <para style="q" vid="PSA 96:12">Entonces todos los árboles del bosque cantarán con gozo<verse eid="PSA 96:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 96:13"/>Delante de <char style="nd">Yavé</char> Quien viene,</para>
  <para style="q" vid="PSA 96:13">Porque viene a juzgar la tierra.</para>
  <para style="q" vid="PSA 96:13">Él juzgará al mundo con justicia</para>
  <para style="q" vid="PSA 96:13">Y a los pueblos con su fidelidad.<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 97:1"/>¡<char style="nd">Yavé</char> reina!</para>
  <para style="q" vid="PSA 97:1">¡Regocíjese la tierra!</para>
  <para style="q" vid="PSA 97:1">¡Alégrese la multitud de islas!<verse eid="PSA 97:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 97:2"/>Nubes y densa oscuridad lo rodean.</para>
  <para style="q" vid="PSA 97:2">Justicia y equidad son el fundamento de su trono.<verse eid="PSA 97:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 97:3"/>Fuego avanza delante de Él</para>
  <para style="q" vid="PSA 97:3">Que quema alrededor a sus adversarios.<verse eid="PSA 97:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 97:4"/>Sus relámpagos iluminan el orbe.</para>
  <para style="q" vid="PSA 97:4">La tierra mira y se estremece.<verse eid="PSA 97:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 97:5"/>Ante la presencia de <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 97:5">Las montañas se derriten como cera,</para>
  <para style="q" vid="PSA 97:5">Ante la presencia del <char style="nd">ʼAdonay</char> de toda la tierra.<verse eid="PSA 97:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 97:6"/>Los cielos declaran su justicia,</para>
  <para style="q" vid="PSA 97:6">Y todos los pueblos ven su gloria.<verse eid="PSA 97:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 97:7"/>Sean avergonzados</para>
  <para style="q" vid="PSA 97:7">Todos los que sirven a imágenes talladas,</para>
  <para style="q" vid="PSA 97:7">Quienes se jactan de ídolos.</para>
  <para style="q" vid="PSA 97:7">Póstrense ante Él todos los <char style="tl">ʼelohim</char>.<verse eid="PSA 97:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 97:8"/>Oyó Sion y se alegró,</para>
  <para style="q" vid="PSA 97:8">Y las hijas de Judá se regocijaron</para>
  <para style="q" vid="PSA 97:8">A causa de tus juicios, oh <char style="nd">Yavé</char>.<verse eid="PSA 97:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 97:9"/>Porque Tú, oh <char style="nd">Yavé</char>, eres <char style="nd">ʼElyón</char> sobre toda la tierra.</para>
  <para style="q" vid="PSA 97:9">Tú eres exaltado por encima de todos los <char style="tl">ʼelohim</char>.<verse eid="PSA 97:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 97:10"/>Aborrezcan el mal ustedes los que aman a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 97:10">Quien preserva las almas de sus santos.</para>
  <para style="q" vid="PSA 97:10">
    <char style="nd">ʼEL</char> los libra de la mano de los perversos.<verse eid="PSA 97:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 97:11"/>Luz hay sembrada para el justo,</para>
  <para style="q" vid="PSA 97:11">Y alegría para los rectos de corazón.<verse eid="PSA 97:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 97:12"/>Alégrense ustedes, los justos, en <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 97:12">Y den gracias a la memoria de su santo Nombre.<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="s1">Salmo</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 98:1"/>Canten a <char style="nd">Yavé</char> un canto nuevo,</para>
  <para style="q" vid="PSA 98:1">Porque Él hizo maravillosas cosas.</para>
  <para style="q" vid="PSA 98:1">Su mano derecha y su santo brazo ganaron la victoria para Él.<verse eid="PSA 98:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 98:2"/>
    <char style="nd">Yavé</char> hizo notoria su salvación.</para>
  <para style="q" vid="PSA 98:2">Ha manifestado su justicia a la vista de las naciones.<verse eid="PSA 98:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 98:3"/>Ha recordado su misericordia y su fidelidad a la casa de Israel.</para>
  <para style="q" vid="PSA 98:3">Todos los confines de la tierra vieron la salvación de nuestro <char style="nd">ʼElohim</char>.<verse eid="PSA 98:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 98:4"/>¡Aclamen a <char style="nd">Yavé</char> toda la tierra!</para>
  <para style="q" vid="PSA 98:4">¡Prorrumpan y canten de gozo y canten salmos!<verse eid="PSA 98:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 98:5"/>Canten salmos a <char style="nd">Yavé</char> con arpa</para>
  <para style="q" vid="PSA 98:5">Y con voz de canto,<verse eid="PSA 98:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 98:6"/>Con trompetas y al sonido de la corneta.</para>
  <para style="q" vid="PSA 98:6">¡Aclamen con gozo ante el Rey <char style="nd">Yavé</char>!<verse eid="PSA 98:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 98:7"/>Brame el mar y los que moran en él,</para>
  <para style="q" vid="PSA 98:7">El mundo, y los que en él habitan.<verse eid="PSA 98:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 98:8"/>Batan sus manos los ríos.</para>
  <para style="q" vid="PSA 98:8">Que las montañas en conjunto se regocijen<verse eid="PSA 98:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 98:9"/>Delante de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 98:9">Porque Él viene a juzgar la tierra.</para>
  <para style="q" vid="PSA 98:9">Juzgará al mundo con justicia,</para>
  <para style="q" vid="PSA 98:9">Y a los pueblos con equidad.<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 99:1"/>¡<char style="nd">Yavé</char> reina! ¡Tiemblen los pueblos!</para>
  <para style="q" vid="PSA 99:1">Él mora entre los querubines.</para>
  <para style="q" vid="PSA 99:1">¡Que se conmueva la tierra!<verse eid="PSA 99:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 99:2"/>
    <char style="nd">Yavé</char> es grande en Sion,</para>
  <para style="q" vid="PSA 99:2">Y Él es exaltado sobre todos los pueblos.<verse eid="PSA 99:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 99:3"/>Que alaben tu grande y asombroso Nombre.</para>
  <para style="q" vid="PSA 99:3">¡Santo es Él!<verse eid="PSA 99:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 99:4"/>La fuerza del Rey ama la justicia.</para>
  <para style="q" vid="PSA 99:4">Tú has ejecutado equidad y justicia en Jacob.<verse eid="PSA 99:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 99:5"/>Exalten a <char style="nd">Yavé</char> nuestro <char style="nd">ʼElohim,</char></para>
  <para style="q" vid="PSA 99:5">Y póstrense ante el estrado de sus pies,</para>
  <para style="q" vid="PSA 99:5">¡Santo es Él!<verse eid="PSA 99:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 99:6"/>Moisés y Aarón estuvieron entre sus sacerdotes,</para>
  <para style="q" vid="PSA 99:6">Y Samuel estuvo entre los que invocaron su Nombre.</para>
  <para style="q" vid="PSA 99:6">Invocaban a <char style="nd">Yavé</char>, y Él les respondía.<verse eid="PSA 99:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 99:7"/>En la columna de nube hablaba con ellos.</para>
  <para style="q" vid="PSA 99:7">Ellos guardaron sus Testimonios y el estatuto que Él les dio.<verse eid="PSA 99:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 99:8"/>Oh <char style="nd">Yavé, ʼElohim</char> nuestro, Tú les respondías.</para>
  <para style="q" vid="PSA 99:8">Fuiste para ellos un <char style="nd">ʼEL</char> perdonador,</para>
  <para style="q" vid="PSA 99:8">Aunque vindicador de sus <char style="add">malas</char> obras.<verse eid="PSA 99:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 99:9"/>Exalten a <char style="nd">Yavé</char> nuestro <char style="nd">ʼElohim</char></para>
  <para style="q" vid="PSA 99:9">Y póstrense hacia su Montaña Santa,</para>
  <para style="q" vid="PSA 99:9">Porque <char style="nd">Yavé</char> nuestro <char style="nd">ʼElohim</char> es santo.<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="s1">Salmo de acción de gracias</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 100:1"/>¡Canten con júbilo a <char style="nd">Yavé</char>, <char style="add">gentes de</char> toda la tierra!<verse eid="PSA 100:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 100:2"/>Sirvan a <char style="nd">Yavé</char> con alegría.</para>
  <para style="q" vid="PSA 100:2">Vengan ante Él con regocijo.<verse eid="PSA 100:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 100:3"/>Reconozcan que <char style="nd">Yavé</char> es <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 100:3">Él nos hizo y no nosotros mismos.</para>
  <para style="q" vid="PSA 100:3">Pueblo suyo somos, y ovejas de su prado.<verse eid="PSA 100:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 100:4"/>Entren por sus puertas con acción de gracias,</para>
  <para style="q" vid="PSA 100:4">Por sus patios con alabanza.</para>
  <para style="q" vid="PSA 100:4">Denle gracias, bendigan su Nombre,<verse eid="PSA 100:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 100:5"/>Porque <char style="nd">Yavé</char> es bueno.</para>
  <para style="b" vid="PSA 100:5"/>
  <para style="q" vid="PSA 100:5">Para siempre es su misericordia,</para>
  <para style="q" vid="PSA 100:5">Y su fidelidad para todas las generaciones.<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="s1">Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 101:1"/>Cantaré de tu misericordia y justicia.</para>
  <para style="q" vid="PSA 101:1">A Ti, oh <char style="nd">Yavé</char>, cantaré salmos.<verse eid="PSA 101:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 101:2"/>Observaré atentamente el camino de la integridad.</para>
  <para style="q" vid="PSA 101:2">¿Cuándo vendrás a mí?</para>
  <para style="b" vid="PSA 101:2"/>
  <para style="q" vid="PSA 101:2">Andaré en la integridad de mi corazón en medio de mi casa.<verse eid="PSA 101:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 101:3"/>No pondré ante mis ojos cosa indigna.</para>
  <para style="q" vid="PSA 101:3">Aborrezco la obra de los que se desvían.</para>
  <para style="q" vid="PSA 101:3">No me atrapará.<verse eid="PSA 101:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 101:4"/>El corazón perverso se apartará de mí.</para>
  <para style="q" vid="PSA 101:4">No reconoceré al perverso.<verse eid="PSA 101:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 101:5"/>Destruiré al que secretamente calumnia a su prójimo.</para>
  <para style="q" vid="PSA 101:5">No soportaré al altivo de ojos y orgulloso de corazón.<verse eid="PSA 101:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 101:6"/>Sobre los fieles de la tierra fijaré mis ojos</para>
  <para style="q" vid="PSA 101:6">Para que estén conmigo.</para>
  <para style="q" vid="PSA 101:6">El que anda en camino de integridad me servirá.<verse eid="PSA 101:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 101:7"/>No vivirá en mi casa el que practica fraude,</para>
  <para style="q" vid="PSA 101:7">El que habla mentira no permanecerá delante de mí.<verse eid="PSA 101:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 101:8"/>Por las mañanas destruiré a todos los perversos de la tierra,</para>
  <para style="q" vid="PSA 101:8">Para extirpar de la ciudad de <char style="nd">Yavé</char> a todos los malhechores.<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="s1">Oración de un afligido que desmaya, y derrama su queja delante de <char style="nd">Yavé</char>.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 102:1"/>Escucha mi oración, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 102:1">Y llegue mi clamor a Ti.<verse eid="PSA 102:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 102:2"/>No escondas de mí tu rostro en el día de mi angustia.</para>
  <para style="q" vid="PSA 102:2">Inclina a mí tu oído.</para>
  <para style="q" vid="PSA 102:2">El día cuando te invoco apresúrate a responderme.<verse eid="PSA 102:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 102:3"/>Porque mis días se disuelven como humo,</para>
  <para style="q" vid="PSA 102:3">Y mis huesos arden como una chimenea.<verse eid="PSA 102:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 102:4"/>Mi corazón está herido.</para>
  <para style="q" vid="PSA 102:4">Se marchita como la hierba.</para>
  <para style="q" vid="PSA 102:4">En verdad olvido comer mi pan.<verse eid="PSA 102:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 102:5"/>Por la voz de mi gemido</para>
  <para style="q" vid="PSA 102:5">Mis huesos se pegaron a mi carne.<verse eid="PSA 102:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 102:6"/>Soy semejante a la lechuza del desierto.</para>
  <para style="q" vid="PSA 102:6">Soy como un búho de las soledades.<verse eid="PSA 102:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 102:7"/>Estoy desvelado.</para>
  <para style="q" vid="PSA 102:7">Me siento como pájaro solo en un tejado.<verse eid="PSA 102:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 102:8"/>Mis enemigos me afrentan todo el día.</para>
  <para style="q" vid="PSA 102:8">Los que contra mí se enfurecen</para>
  <para style="q" vid="PSA 102:8">Se conjuraron contra mí.<verse eid="PSA 102:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 102:9"/>He comido cenizas como pan</para>
  <para style="q" vid="PSA 102:9">Y mezclado mi bebida con lágrimas<verse eid="PSA 102:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 102:10"/>A causa de tu indignación y de tu ira,</para>
  <para style="q" vid="PSA 102:10">Porque me levantaste y me lanzaste.<verse eid="PSA 102:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 102:11"/>Mis días son una sombra que se prolonga,</para>
  <para style="q" vid="PSA 102:11">Y me marchito como hierba.<verse eid="PSA 102:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 102:12"/>Pero Tú, oh <char style="nd">Yavé</char>, permaneces para siempre,</para>
  <para style="q" vid="PSA 102:12">Y tu Nombre por todas las generaciones.<verse eid="PSA 102:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 102:13"/>Te levantarás, tendrás misericordia de Sion,</para>
  <para style="q" vid="PSA 102:13">Porque es tiempo de tener compasión de ella,</para>
  <para style="q" vid="PSA 102:13">Pues llegó el tiempo señalado.<verse eid="PSA 102:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 102:14"/>Ciertamente tus esclavos hallan deleite en sus piedras,</para>
  <para style="q" vid="PSA 102:14">Y tienen compasión del polvo de ella.<verse eid="PSA 102:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 102:15"/>Así las naciones temerán al Nombre de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 102:15">Y todos los reyes de la tierra <char style="add">temerán</char> tu gloria.<verse eid="PSA 102:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 102:16"/>Porque <char style="nd">Yavé</char> habrá edificado a Sion</para>
  <para style="q" vid="PSA 102:16">Será visto en su gloria.<verse eid="PSA 102:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 102:17"/>Ha considerado la oración de los desposeídos,</para>
  <para style="q" vid="PSA 102:17">Y no habrá despreciado su ruego.<verse eid="PSA 102:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 102:18"/>Esto será escrito para la generación venidera,</para>
  <para style="q" vid="PSA 102:18">Para que un pueblo que está aún por nacer alabe a <char style="nd">YA</char>,<verse eid="PSA 102:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 102:19"/>Porque miró desde lo alto de su Santuario.</para>
  <para style="q" vid="PSA 102:19">Desde el cielo <char style="nd">Yavé</char> miró a la tierra<verse eid="PSA 102:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 102:20"/>Para escuchar el gemido de los presos,</para>
  <para style="q" vid="PSA 102:20">Para libertar a los sentenciados a muerte.<verse eid="PSA 102:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 102:21"/>Que digan en Sion la fama de <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 102:21">Y su alabanza en Jerusalén,<verse eid="PSA 102:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 102:22"/>Cuando los pueblos y reinos sean juntamente congregados,</para>
  <para style="q" vid="PSA 102:22">Para servir a <char style="nd">Yavé</char>.<verse eid="PSA 102:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 102:23"/>Él debilitó mi fuerza en el camino.</para>
  <para style="q" vid="PSA 102:23">Acortó mis días.<verse eid="PSA 102:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 102:24"/>Digo: Oh <char style="nd">ʼEL</char> mío, no me levantes en la mitad de mis días.</para>
  <para style="q" vid="PSA 102:24">Tus años son por todas las generaciones.<verse eid="PSA 102:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PSA 102:25"/>Desde la antigüedad fundaste la tierra,</para>
  <para style="q" vid="PSA 102:25">Y los cielos son obra de sus manos.<verse eid="PSA 102:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 102:26"/>Ellos perecerán,</para>
  <para style="q" vid="PSA 102:26">Pero Tú permaneces.</para>
  <para style="q" vid="PSA 102:26">Todos ellos se desgastarán como una ropa,</para>
  <para style="q" vid="PSA 102:26">Como una ropa los cambiarás,</para>
  <para style="q" vid="PSA 102:26">Y pasarán.<verse eid="PSA 102:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PSA 102:27"/>Pero Tú eres el mismo,</para>
  <para style="q" vid="PSA 102:27">Y tus años no tendrán fin.<verse eid="PSA 102:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 102:28"/>Los hijos de tus esclavos vivirán seguros,</para>
  <para style="q" vid="PSA 102:28">Y sus descendientes serán establecidos delante de Ti.<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="s1">Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 103:1"/>Bendice, alma mía, a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 103:1">Y bendiga todo mi ser su santo Nombre.<verse eid="PSA 103:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 103:2"/>Bendice, alma mía, a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 103:2">Y no olvides ninguno de sus beneficios.<verse eid="PSA 103:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 103:3"/>Él es Quien perdona todas tus iniquidades,</para>
  <para style="q" vid="PSA 103:3">Quien sana todas tus dolencias,<verse eid="PSA 103:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 103:4"/>Quien rescata del hoyo tu vida,</para>
  <para style="q" vid="PSA 103:4">Quien te corona de misericordia y compasión,<verse eid="PSA 103:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 103:5"/>Quien sacia tu boca con buenas cosas,</para>
  <para style="q" vid="PSA 103:5">De modo que te rejuvenezcas como el águila.<verse eid="PSA 103:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 103:6"/>
    <char style="nd">Yavé</char> es Quien hace justicia</para>
  <para style="q" vid="PSA 103:6">Y juicios justos para todos los oprimidos.<verse eid="PSA 103:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 103:7"/>Dio a conocer sus caminos a Moisés,</para>
  <para style="q" vid="PSA 103:7">Y a los hijos de Israel sus obras.<verse eid="PSA 103:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 103:8"/>Compasivo y bondadoso es <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 103:8">Lento para la ira y grande en misericordia.<verse eid="PSA 103:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 103:9"/>No contenderá para siempre,</para>
  <para style="q" vid="PSA 103:9">Ni para siempre guardará <char style="add">el enojo</char>.<verse eid="PSA 103:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 103:10"/>No nos trató según nuestras iniquidades,</para>
  <para style="q" vid="PSA 103:10">Ni nos retribuyó según nuestros pecados.<verse eid="PSA 103:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 103:11"/>Porque como la altura de los cielos sobre la tierra,</para>
  <para style="q" vid="PSA 103:11">Engrandeció su misericordia hacia los que le temen.<verse eid="PSA 103:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 103:12"/>Tan lejos como está el oriente del occidente</para>
  <para style="q" vid="PSA 103:12">Removió de nosotros nuestras transgresiones.<verse eid="PSA 103:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 103:13"/>Como un padre tiene compasión de <char style="add">sus</char> hijos,</para>
  <para style="q" vid="PSA 103:13">Así <char style="nd">Yavé</char> tiene compasión de los que le temen.<verse eid="PSA 103:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 103:14"/>Porque Él conoce nuestra condición.</para>
  <para style="q" vid="PSA 103:14">Se acuerda de que somos polvo.<verse eid="PSA 103:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 103:15"/>Como la hierba son los días del hombre.</para>
  <para style="q" vid="PSA 103:15">Florece como una flor del campo.<verse eid="PSA 103:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 103:16"/>Cuando el viento pasa sobre ella, ya no existe,</para>
  <para style="q" vid="PSA 103:16">Y su lugar ya no la reconoce.<verse eid="PSA 103:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 103:17"/>Pero la misericordia de <char style="nd">Yavé</char> es desde la eternidad</para>
  <para style="q" vid="PSA 103:17">Hasta la eternidad sobre los que le temen,</para>
  <para style="q" vid="PSA 103:17">Y su justicia sobre los hijos de los hijos,<verse eid="PSA 103:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 103:18"/>Sobre los que observan su Pacto</para>
  <para style="q" vid="PSA 103:18">Y recuerdan sus Preceptos para practicarlos.<verse eid="PSA 103:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 103:19"/>
    <char style="nd">Yavé</char> estableció en los cielos su trono,</para>
  <para style="q" vid="PSA 103:19">Y su reino domina sobre todo.<verse eid="PSA 103:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 103:20"/>Bendigan a <char style="nd">Yavé</char>, ustedes sus ángeles,</para>
  <para style="q" vid="PSA 103:20">Poderosos en fortaleza,</para>
  <para style="q" vid="PSA 103:20">Que ejecutan su Palabra,</para>
  <para style="q" vid="PSA 103:20">Al obedecer la voz de su mandato.<verse eid="PSA 103:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 103:21"/>Bendigan a <char style="nd">Yavé</char>, ustedes todas sus huestes,</para>
  <para style="q" vid="PSA 103:21">Ministros suyos que hacen su voluntad.<verse eid="PSA 103:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 103:22"/>Bendigan a <char style="nd">Yavé</char> ustedes, todas sus obras,</para>
  <para style="q" vid="PSA 103:22">En todos los lugares de su señorío.</para>
  <para style="q" vid="PSA 103:22">Bendice, oh alma mía, a <char style="nd">Yavé</char>.<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 104:1"/>Bendice, alma mía, a <char style="nd">Yavé</char>.</para>
  <para style="b" vid="PSA 104:1"/>
  <para style="q" vid="PSA 104:1">¡Oh <char style="nd">Yavé, ʼElohim</char> mío, cuánto te has engrandecido!</para>
  <para style="q" vid="PSA 104:1">Estás cubierto de esplendor y majestad.<verse eid="PSA 104:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 104:2"/>Te cubres como con un manto de luz.</para>
  <para style="q" vid="PSA 104:2">Extiendes el cielo como una cortina.<verse eid="PSA 104:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 104:3"/>Él coloca sobre las aguas las vigas de sus altas moradas.</para>
  <para style="q" vid="PSA 104:3">Él convierte las nubes en su carroza.</para>
  <para style="q" vid="PSA 104:3">Él anda sobre las alas del viento.<verse eid="PSA 104:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 104:4"/>Él designa los vientos como sus mensajeros,</para>
  <para style="q" vid="PSA 104:4">Y las llamas de fuego, como sus ministros.<verse eid="PSA 104:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 104:5"/>Él estableció la tierra sobre sus cimientos</para>
  <para style="q" vid="PSA 104:5">Para que no sea sacudida.<verse eid="PSA 104:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 104:6"/>Le colocaste como una ropa el abismo.</para>
  <para style="b" vid="PSA 104:6"/>
  <para style="q" vid="PSA 104:6">Las aguas estaban sobre las montañas.<verse eid="PSA 104:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 104:7"/>A tu reprensión huyeron,</para>
  <para style="q" vid="PSA 104:7">Se precipitaron al estruendo de tu trueno.<verse eid="PSA 104:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 104:8"/>Subieron las montañas,</para>
  <para style="q" vid="PSA 104:8">Bajaron los valles al lugar que estableciste para ellos.<verse eid="PSA 104:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 104:9"/>Les fijaste un límite que no traspasarán,</para>
  <para style="q" vid="PSA 104:9">De manera que no volverán a cubrir la tierra.<verse eid="PSA 104:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 104:10"/>Él envía manantiales por los valles.</para>
  <para style="q" vid="PSA 104:10">Ellos fluyen entre las montañas.<verse eid="PSA 104:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 104:11"/>Dan de beber a todas las bestias del campo.</para>
  <para style="q" vid="PSA 104:11">Mitigan su sed los asnos monteses.<verse eid="PSA 104:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 104:12"/>Junto a ellos habitan las aves del cielo.</para>
  <para style="q" vid="PSA 104:12">Elevan voces entre las ramas.<verse eid="PSA 104:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 104:13"/>Él riega las montañas desde sus altas cámaras.</para>
  <para style="q" vid="PSA 104:13">Con el fruto de las obras de Él está saciada la tierra.<verse eid="PSA 104:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 104:14"/>Él desarrolla el pasto para el ganado,</para>
  <para style="q" vid="PSA 104:14">Y la vegetación para el servicio del hombre</para>
  <para style="q" vid="PSA 104:14">De tal modo que saque alimento de la tierra,<verse eid="PSA 104:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 104:15"/>Y vino que alegra el corazón del hombre,</para>
  <para style="q" vid="PSA 104:15">El aceite para que brille su semblante</para>
  <para style="q" vid="PSA 104:15">Y el pan que sustenta la vida del hombre.<verse eid="PSA 104:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 104:16"/>Los árboles de <char style="nd">Yavé</char> beben su savia,</para>
  <para style="q" vid="PSA 104:16">Los cedros del Líbano que Él plantó,<verse eid="PSA 104:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 104:17"/>Donde las aves construyen sus nidos,</para>
  <para style="q" vid="PSA 104:17">La cigüeña, cuya casa está en los cipreses,<verse eid="PSA 104:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 104:18"/>Las altas montañas para las cabras monteses,</para>
  <para style="q" vid="PSA 104:18">Las peñas, madrigueras de los conejos.<verse eid="PSA 104:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 104:19"/>Él hizo la luna para las estaciones.</para>
  <para style="q" vid="PSA 104:19">El sol conoce el punto de su ocaso.<verse eid="PSA 104:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 104:20"/>Pones la oscuridad y es de noche.</para>
  <para style="q" vid="PSA 104:20">En ella corretean todos los animales del bosque.<verse eid="PSA 104:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 104:21"/>Los leoncillos rugen tras la presa</para>
  <para style="q" vid="PSA 104:21">Y buscan de <char style="nd">ʼEL</char> su comida.<verse eid="PSA 104:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 104:22"/>Al salir el sol se retiran</para>
  <para style="q" vid="PSA 104:22">Y se echan en sus guaridas.<verse eid="PSA 104:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 104:23"/>Sale el hombre a su trabajo,</para>
  <para style="q" vid="PSA 104:23">A su labor hasta el anochecer.<verse eid="PSA 104:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PSA 104:24"/>¡Cuán innumerables son tus obras, oh <char style="nd">Yavé</char>!</para>
  <para style="q" vid="PSA 104:24">Hiciste todas ellas con sabiduría.</para>
  <para style="q" vid="PSA 104:24">La tierra está llena de tus posesiones.<verse eid="PSA 104:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PSA 104:25"/>Ahí está el grande y ancho mar,</para>
  <para style="q" vid="PSA 104:25">Donde hay enjambre de incontables animales,</para>
  <para style="q" vid="PSA 104:25">Tanto pequeños como grandes.<verse eid="PSA 104:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 104:26"/>Allí navegan los barcos,</para>
  <para style="q" vid="PSA 104:26">
    <char style="add">Y el </char>cocodrilo que formaste para que juguetee en él.<verse eid="PSA 104:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PSA 104:27"/>Todos ellos esperan en Ti</para>
  <para style="q" vid="PSA 104:27">Para que les des su comida en su tiempo.<verse eid="PSA 104:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 104:28"/>Les das, ellos recogen.</para>
  <para style="q" vid="PSA 104:28">Abres tu mano,</para>
  <para style="q" vid="PSA 104:28">Y se sacian con lo bueno.<verse eid="PSA 104:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PSA 104:29"/>Ocultas tu rostro</para>
  <para style="q" vid="PSA 104:29">Y ellos se desmayan.</para>
  <para style="q" vid="PSA 104:29">Les retiras su aliento,</para>
  <para style="q" vid="PSA 104:29">Y ellos expiran y vuelven a su polvo.<verse eid="PSA 104:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 104:30"/>Envías tu aliento,</para>
  <para style="q" vid="PSA 104:30">Son creados,</para>
  <para style="q" vid="PSA 104:30">Y renuevas la superficie de la tierra.<verse eid="PSA 104:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="PSA 104:31"/>¡Sea la gloria de <char style="nd">Yavé</char> para siempre!</para>
  <para style="q" vid="PSA 104:31">¡Que se alegre <char style="nd">Yavé</char> en sus obras!<verse eid="PSA 104:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 104:32"/>Él mira a la tierra,</para>
  <para style="q" vid="PSA 104:32">Y ella tiembla,</para>
  <para style="q" vid="PSA 104:32">Él toca las montañas,</para>
  <para style="q" vid="PSA 104:32">Y ellas humean.<verse eid="PSA 104:32"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="33" style="v" sid="PSA 104:33"/>A <char style="nd">Yavé</char> cantaré en mi vida,</para>
  <para style="q" vid="PSA 104:33">Mientras tenga vida cantaré salmos a mi <char style="nd">ʼElohim</char>.<verse eid="PSA 104:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 104:34"/>Sea agradable a Él mi meditación.</para>
  <para style="q" vid="PSA 104:34">Yo me regocijaré en <char style="nd">Yavé</char>.<verse eid="PSA 104:34"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="35" style="v" sid="PSA 104:35"/>Sean exterminados de la tierra los pecadores</para>
  <para style="q" vid="PSA 104:35">Y los perversos dejen de ser.</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q" vid="PSA 104:35">¡Bendice, alma mía, a <char style="nd">Yavé</char>!</para>
  <para style="q" vid="PSA 104:35">¡Alaben a <char style="nd">YA</char>!<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 105:1"/>Den gracias a <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 105:1">Invoquen su Nombre.</para>
  <para style="q" vid="PSA 105:1">Proclamen sus obras entre los pueblos.<verse eid="PSA 105:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 105:2"/>Cántenle, cántenle salmos.</para>
  <para style="q" vid="PSA 105:2">Hablen de todas sus maravillas.<verse eid="PSA 105:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 105:3"/>Gloríense en su santo Nombre.</para>
  <para style="q" vid="PSA 105:3">Alégrese el corazón de los que buscan a <char style="nd">Yavé</char>.<verse eid="PSA 105:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 105:4"/>Busquen a <char style="nd">Yavé</char> y su poder.</para>
  <para style="q" vid="PSA 105:4">Busquen continuamente su rostro.<verse eid="PSA 105:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 105:5"/>Recuerden las maravillas que hizo Él,</para>
  <para style="q" vid="PSA 105:5">De sus prodigios y de los juicios de su boca,<verse eid="PSA 105:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 105:6"/>¡Oh ustedes, descendencia de Abraham su esclavo,</para>
  <para style="q" vid="PSA 105:6">Hijos de Jacob, su escogido!<verse eid="PSA 105:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 105:7"/>Él es <char style="nd">Yavé</char> nuestro <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 105:7">En toda la tierra están sus juicios.<verse eid="PSA 105:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 105:8"/>Recordó para siempre su Pacto,</para>
  <para style="q" vid="PSA 105:8">El Pacto que ordenó para 1.000 generaciones,<verse eid="PSA 105:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 105:9"/>Que hizo con Abraham,</para>
  <para style="q" vid="PSA 105:9">Y su juramento a Isaac,<verse eid="PSA 105:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 105:10"/>Que estableció a Jacob por estatuto,</para>
  <para style="q" vid="PSA 105:10">A Israel como un Pacto sempiterno<verse eid="PSA 105:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 105:11"/>Al decir: A ti te daré la tierra de Canaán</para>
  <para style="q" vid="PSA 105:11">Como porción de tu heredad.<verse eid="PSA 105:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 105:12"/>Cuando ellos eran unos pocos,</para>
  <para style="q" vid="PSA 105:12">En verdad muy pocos,</para>
  <para style="q" vid="PSA 105:12">Y forasteros en ella,<verse eid="PSA 105:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 105:13"/>Y vagaban de nación en nación,</para>
  <para style="q" vid="PSA 105:13">Y de <char style="add">un</char> reino a otro pueblo.<verse eid="PSA 105:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 105:14"/>No permitió que alguno los oprimiera.</para>
  <para style="q" vid="PSA 105:14">Y por amor a ellos reprendió a reyes.<verse eid="PSA 105:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 105:15"/>
    <char style="wj">No toquen a mis ungidos, </char></para>
  <para style="q" vid="PSA 105:15">
    <char style="wj">Ni hagan daño a mis profetas. </char><verse eid="PSA 105:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 105:16"/>Trajo hambre sobre la tierra.</para>
  <para style="q" vid="PSA 105:16">Destruyó toda provisión de pan.<verse eid="PSA 105:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 105:17"/>Envió un varón delante de ellos.</para>
  <para style="q" vid="PSA 105:17">A José, vendido como esclavo.<verse eid="PSA 105:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 105:18"/>Afligieron sus pies con grilletes.</para>
  <para style="q" vid="PSA 105:18">Él mismo fue puesto en cadenas,<verse eid="PSA 105:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 105:19"/>Hasta que se cumplió su predicción.</para>
  <para style="q" vid="PSA 105:19">La Palabra de <char style="nd">Yavé</char> lo probó.<verse eid="PSA 105:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 105:20"/>El rey envió y lo soltó.</para>
  <para style="q" vid="PSA 105:20">El soberano de pueblos lo libertó.<verse eid="PSA 105:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 105:21"/>Lo puso como administrador de su casa,</para>
  <para style="q" vid="PSA 105:21">Y gobernador de todas sus posesiones,<verse eid="PSA 105:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 105:22"/>Para encarcelar a sus gobernantes</para>
  <para style="q" vid="PSA 105:22">Como él quisiera,</para>
  <para style="q" vid="PSA 105:22">Y enseñar sabiduría a sus ancianos.<verse eid="PSA 105:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 105:23"/>Israel también fue a Egipto,</para>
  <para style="q" vid="PSA 105:23">Así que Jacob peregrinó en la tierra de Cam.<verse eid="PSA 105:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 105:24"/>Él aumentó a su pueblo grandemente,</para>
  <para style="q" vid="PSA 105:24">Hasta que fueron más fuertes que sus adversarios.<verse eid="PSA 105:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 105:25"/>Cambió el corazón de éstos</para>
  <para style="q" vid="PSA 105:25">Para que aborrecieran a su pueblo,</para>
  <para style="q" vid="PSA 105:25">Para que obraran astutamente contra sus esclavos.<verse eid="PSA 105:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PSA 105:26"/>Envió a Moisés su esclavo,</para>
  <para style="q" vid="PSA 105:26">Y a Aarón, al cual escogió.<verse eid="PSA 105:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 105:27"/>Puso en ellos las palabras de sus señales,</para>
  <para style="q" vid="PSA 105:27">Y sus maravillas en la tierra de Cam.<verse eid="PSA 105:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 105:28"/>Envió oscuridad y oscureció.</para>
  <para style="q" vid="PSA 105:28">Y ellos no fueron rebeldes a las Palabras de Él.<verse eid="PSA 105:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PSA 105:29"/>Convirtió sus aguas en sangre</para>
  <para style="q" vid="PSA 105:29">Y mató sus peces.<verse eid="PSA 105:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 105:30"/>Llenó su tierra de ranas</para>
  <para style="q" vid="PSA 105:30">Hasta en las alcobas de sus reyes.<verse eid="PSA 105:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="PSA 105:31"/>Habló, y llegaron enjambres de moscas y piojos en todo su territorio.<verse eid="PSA 105:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 105:32"/>Les dio lluvia de granizo y llamas de fuego en su tierra.<verse eid="PSA 105:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 105:33"/>Destrozó sus viñas y sus higueras</para>
  <para style="q" vid="PSA 105:33">Y quebró los árboles de su territorio.<verse eid="PSA 105:33"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="34" style="v" sid="PSA 105:34"/>Habló, y llegaron saltamontes y pulgones sinnúmero,<verse eid="PSA 105:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 105:35"/>Y devoraron toda la vegetación en su tierra</para>
  <para style="q" vid="PSA 105:35">Y se comieron el fruto de su suelo.<verse eid="PSA 105:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 105:36"/>Golpeó también a todo primogénito en su tierra,</para>
  <para style="q" vid="PSA 105:36">Las primicias de todo su vigor.<verse eid="PSA 105:36"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="37" style="v" sid="PSA 105:37"/>Luego los sacó con plata y oro.</para>
  <para style="q" vid="PSA 105:37">Entre sus tribus no hubo quien tropezara.<verse eid="PSA 105:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 105:38"/>Egipto se alegró de que salieran,</para>
  <para style="q" vid="PSA 105:38">Porque su terror había caído sobre ellos.<verse eid="PSA 105:38"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="39" style="v" sid="PSA 105:39"/>Extendió una nube como cubierta</para>
  <para style="q" vid="PSA 105:39">Y fuego para iluminar la noche.<verse eid="PSA 105:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 105:40"/>Pidieron,</para>
  <para style="q" vid="PSA 105:40">Y Él atrajo codornices</para>
  <para style="q" vid="PSA 105:40">Y los sació de pan del cielo.<verse eid="PSA 105:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 105:41"/>Abrió la peña,</para>
  <para style="q" vid="PSA 105:41">Y brotaron aguas.</para>
  <para style="q" vid="PSA 105:41">Corrieron por los sequedales <char style="add">como</char> un río.<verse eid="PSA 105:41"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="42" style="v" sid="PSA 105:42"/>Porque recordó su santa Promesa</para>
  <para style="q" vid="PSA 105:42">
    <char style="add">Dada</char> a su esclavo Abraham.<verse eid="PSA 105:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 105:43"/>Sacó a su pueblo con gozo,</para>
  <para style="q" vid="PSA 105:43">Con canto de júbilo a sus escogidos.<verse eid="PSA 105:43"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="44" style="v" sid="PSA 105:44"/>Y también les dio las tierras de las naciones,</para>
  <para style="q" vid="PSA 105:44">Y tomaron posesión del trabajo de los pueblos,<verse eid="PSA 105:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 105:45"/>Para que guardaran sus Estatutos,</para>
  <para style="q" vid="PSA 105:45">Y observaran sus Leyes. ¡Alaben a <char style="nd">YA</char>!<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 106:1"/>¡Aleluya! Den gracias a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 106:1">Porque Él es bueno,</para>
  <para style="q" vid="PSA 106:1">Porque para siempre es su misericordia.<verse eid="PSA 106:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 106:2"/>¿Quién puede contar las proezas de <char style="nd">Yavé</char>?</para>
  <para style="q" vid="PSA 106:2">¿Quién proclama toda su alabanza?<verse eid="PSA 106:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 106:3"/>¡Dichosos los que guardan recto juicio,</para>
  <para style="q" vid="PSA 106:3">Los que practican justicia en todo tiempo!<verse eid="PSA 106:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 106:4"/>Acuérdate de mí, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 106:4">Según tu buena voluntad para tu pueblo.</para>
  <para style="q" vid="PSA 106:4">Visítame con tu salvación,<verse eid="PSA 106:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 106:5"/>Para que yo vea el bien de tus escogidos,</para>
  <para style="q" vid="PSA 106:5">Para que me regocije por la alegría de tu pueblo,</para>
  <para style="q" vid="PSA 106:5">Que me gloríe con tu heredad.<verse eid="PSA 106:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 106:6"/>Como nuestros antepasados pecamos.</para>
  <para style="q" vid="PSA 106:6">Cometimos iniquidad.</para>
  <para style="q" vid="PSA 106:6">Nos portamos perversamente.<verse eid="PSA 106:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 106:7"/>Nuestros antepasados no entendieron tus maravillas en Egipto.</para>
  <para style="q" vid="PSA 106:7">No recordaron tus numerosas bondades,</para>
  <para style="q" vid="PSA 106:7">Sino se rebelaron junto al mar, en el mar Rojo.<verse eid="PSA 106:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 106:8"/>Pero Él los salvó por amor a su Nombre</para>
  <para style="q" vid="PSA 106:8">Para que fuera evidente su poder.<verse eid="PSA 106:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 106:9"/>Reprendió al mar Rojo</para>
  <para style="q" vid="PSA 106:9">Y lo secó,</para>
  <para style="q" vid="PSA 106:9">Y los condujo por las profundidades,</para>
  <para style="q" vid="PSA 106:9">Como por un desierto.<verse eid="PSA 106:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 106:10"/>Así los salvó de <char style="add">la</char> mano del que <char style="add">los</char> odiaba,</para>
  <para style="q" vid="PSA 106:10">Y los redimió de la mano del enemigo.<verse eid="PSA 106:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 106:11"/>Cubrieron las aguas a sus adversarios,</para>
  <para style="q" vid="PSA 106:11">No quedó ni uno de ellos.<verse eid="PSA 106:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 106:12"/>Entonces creyeron a sus Palabras,</para>
  <para style="q" vid="PSA 106:12">Y cantaron su alabanza.<verse eid="PSA 106:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 106:13"/>Muy pronto olvidaron sus obras.</para>
  <para style="q" vid="PSA 106:13">No esperaron su consejo.<verse eid="PSA 106:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 106:14"/>Con avidez desearon comer en el desierto,</para>
  <para style="q" vid="PSA 106:14">Y en lugar despoblado tentaron a <char style="nd">ʼElohim</char>.<verse eid="PSA 106:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 106:15"/>Él les dio lo que pidieron,</para>
  <para style="q" vid="PSA 106:15">Pero envió mortandad sobre ellos.<verse eid="PSA 106:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 106:16"/>Tuvieron envidia de Moisés en el campamento,</para>
  <para style="q" vid="PSA 106:16">Y de Aarón, el consagrado a <char style="nd">Yavé</char>.<verse eid="PSA 106:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 106:17"/>Se abrió la tierra</para>
  <para style="q" vid="PSA 106:17">Y se tragó a Datán,</para>
  <para style="q" vid="PSA 106:17">Y cubrió al grupo de Abiram.<verse eid="PSA 106:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 106:18"/>Un fuego se encendió contra su grupo.</para>
  <para style="q" vid="PSA 106:18">La llama devoró a los perversos.<verse eid="PSA 106:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 106:19"/>Hicieron un becerro en Horeb.</para>
  <para style="q" vid="PSA 106:19">Se postraron ante una imagen de fundición.<verse eid="PSA 106:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 106:20"/>Así cambiaron la Gloria de ellos</para>
  <para style="q" vid="PSA 106:20">Por la imagen de un becerro que come hierba.<verse eid="PSA 106:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 106:21"/>Olvidaron al <char style="nd">ʼEL</char>, su Salvador,</para>
  <para style="q" vid="PSA 106:21">Quien hizo grandes cosas en Egipto,<verse eid="PSA 106:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 106:22"/>Maravillas en la tierra de Cam,</para>
  <para style="q" vid="PSA 106:22">Portentos en el mar Rojo.<verse eid="PSA 106:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 106:23"/>Por tanto Él dijo que los destruiría.</para>
  <para style="q" vid="PSA 106:23">Si no fuera porque Moisés su escogido,</para>
  <para style="q" vid="PSA 106:23">Se puso en la brecha delante de Él</para>
  <para style="q" vid="PSA 106:23">Con la intención de que no los destruyera.<verse eid="PSA 106:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PSA 106:24"/>Luego despreciaron <char style="add">la</char> tierra deseable.</para>
  <para style="q" vid="PSA 106:24">No creyeron en la Palabra de Él,<verse eid="PSA 106:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 106:25"/>Sino murmuraron en sus tiendas.</para>
  <para style="q" vid="PSA 106:25">No escucharon la voz de <char style="nd">Yavé</char>.<verse eid="PSA 106:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 106:26"/>Por tanto les juró</para>
  <para style="q" vid="PSA 106:26">Que caerían en el desierto,<verse eid="PSA 106:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 106:27"/>Que dispersaría su descendencia entre las naciones</para>
  <para style="q" vid="PSA 106:27">Y los esparciría por las tierras.<verse eid="PSA 106:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PSA 106:28"/>Se unieron también a Baal-peor</para>
  <para style="q" vid="PSA 106:28">Y comieron lo sacrificado a los muertos.<verse eid="PSA 106:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 106:29"/>Así <char style="add">lo</char> provocaron a ira con sus obras,</para>
  <para style="q" vid="PSA 106:29">Y una mortandad irrumpió entre ellos.<verse eid="PSA 106:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PSA 106:30"/>Pero Finees se levantó e intervino,</para>
  <para style="q" vid="PSA 106:30">Y la mortandad se detuvo,<verse eid="PSA 106:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 106:31"/>Y le fue atribuido como justicia</para>
  <para style="q" vid="PSA 106:31">Por todas las generaciones para siempre.<verse eid="PSA 106:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PSA 106:32"/>También <char style="add">lo</char> provocaron a ira en las aguas de Meriba,</para>
  <para style="q" vid="PSA 106:32">Y salió mal Moisés por causa de ellos,<verse eid="PSA 106:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 106:33"/>Porque hicieron rebelar su espíritu,</para>
  <para style="q" vid="PSA 106:33">Y él habló precipitadamente con sus labios.<verse eid="PSA 106:33"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="34" style="v" sid="PSA 106:34"/>No destruyeron a los pueblos,</para>
  <para style="q" vid="PSA 106:34">Como <char style="nd">Yavé</char> les mandó,<verse eid="PSA 106:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 106:35"/>Sino se mezclaron con gentiles.</para>
  <para style="q" vid="PSA 106:35">Aprendieron sus prácticas,<verse eid="PSA 106:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 106:36"/>Y sirvieron a sus ídolos,</para>
  <para style="q" vid="PSA 106:36">Los cuales fueron una trampa.<verse eid="PSA 106:36"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="37" style="v" sid="PSA 106:37"/>Sacrificaron sus hijos y sus hijas a los demonios<verse eid="PSA 106:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 106:38"/>Y derramaron sangre inocente,</para>
  <para style="q" vid="PSA 106:38">La sangre de sus hijos y de sus hijas,</para>
  <para style="q" vid="PSA 106:38">A quienes sacrificaron a los ídolos de Canaán,</para>
  <para style="q" vid="PSA 106:38">Y la tierra fue contaminada con la sangre.<verse eid="PSA 106:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 106:39"/>Así se contaminaron con las prácticas de ellos,</para>
  <para style="q" vid="PSA 106:39">Y se prostituyeron con sus hechos.<verse eid="PSA 106:39"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="40" style="v" sid="PSA 106:40"/>Por tanto la ira de <char style="nd">Yavé</char> se encendió contra su pueblo,</para>
  <para style="q" vid="PSA 106:40">Y Él repugnó su heredad.<verse eid="PSA 106:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 106:41"/>Los entregó en <char style="add">la</char> mano de los gentiles,</para>
  <para style="q" vid="PSA 106:41">Y aquellos que los odiaban gobernaron sobre ellos.<verse eid="PSA 106:41"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="42" style="v" sid="PSA 106:42"/>Sus enemigos también los oprimieron,</para>
  <para style="q" vid="PSA 106:42">Y fueron sometidos bajo su poder.<verse eid="PSA 106:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 106:43"/>Muchas veces los libró,</para>
  <para style="q" vid="PSA 106:43">Pero ellos se rebelaron contra su consejo en su designio,</para>
  <para style="q" vid="PSA 106:43">Y así se hundieron en su iniquidad.<verse eid="PSA 106:43"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="44" style="v" sid="PSA 106:44"/>Sin embargo, Él miraba su angustia</para>
  <para style="q" vid="PSA 106:44">Y escuchaba su clamor.<verse eid="PSA 106:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 106:45"/>Recordaba su Pacto por amor a ellos,</para>
  <para style="q" vid="PSA 106:45">Y se compadecía según la grandeza de su misericordia.<verse eid="PSA 106:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 106:46"/>También promovió que fueran <char style="add">objeto</char> de misericordia</para>
  <para style="q" vid="PSA 106:46">Por parte de todos los que los tenían cautivos.<verse eid="PSA 106:46"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="47" style="v" sid="PSA 106:47"/>Oh <char style="nd">Yavé, ʼElohim</char> nuestro, sálvanos.</para>
  <para style="q" vid="PSA 106:47">Recógenos de entre las naciones,</para>
  <para style="q" vid="PSA 106:47">Para que demos gracias a tu santo Nombre</para>
  <para style="q" vid="PSA 106:47">Y nos gloriemos en tus alabanzas.<verse eid="PSA 106:47"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="48" style="v" sid="PSA 106:48"/>¡Bendito sea <char style="nd">Yavé</char>, el <char style="nd">ʼElohim</char> de Israel,</para>
  <para style="q" vid="PSA 106:48">Desde la eternidad hasta la eternidad!</para>
  <para style="q" vid="PSA 106:48">Y todo el pueblo diga: ¡Amén! ¡Aleluya!<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 107:1"/>¡Den gracias a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 107:1">Porque Él es bueno,</para>
  <para style="q" vid="PSA 107:1">Porque para siempre es su misericordia!<verse eid="PSA 107:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 107:2"/>Que lo digan los redimidos de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 107:2">Los que redimió del poder del adversario,<verse eid="PSA 107:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 107:3"/>Y los que congregó de las tierras,</para>
  <para style="q" vid="PSA 107:3">Del oriente y del occidente, del norte y del sur.<verse eid="PSA 107:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 107:4"/>Ellos vagaron en un desierto, en región despoblada.</para>
  <para style="q" vid="PSA 107:4">No hallaron un camino hacia una ciudad habitada.<verse eid="PSA 107:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 107:5"/>Tenían hambre y sed.</para>
  <para style="q" vid="PSA 107:5">Sus almas desfallecían en ellos.<verse eid="PSA 107:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 107:6"/>Pero clamaron a <char style="nd">Yavé</char> en su angustia.</para>
  <para style="q" vid="PSA 107:6">Él los libró de sus aflicciones.<verse eid="PSA 107:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 107:7"/>Los condujo por un camino recto</para>
  <para style="q" vid="PSA 107:7">Para ir a una ciudad habitada.<verse eid="PSA 107:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 107:8"/>¡Den gracias a <char style="nd">Yavé</char> por su misericordia</para>
  <para style="q" vid="PSA 107:8">Y por sus maravillas para los hijos de <char style="add">los </char>hombres!<verse eid="PSA 107:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 107:9"/>Porque Él sacia al alma que tiene sed</para>
  <para style="q" vid="PSA 107:9">Y llena de bien al alma que tiene hambre.<verse eid="PSA 107:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 107:10"/>Vivían en oscuridad y sombra de muerte,</para>
  <para style="q" vid="PSA 107:10">Prisioneros en aflicción y cadenas,<verse eid="PSA 107:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 107:11"/>Por cuanto fueron rebeldes a las Palabras de <char style="nd">ʼEL</char></para>
  <para style="q" vid="PSA 107:11">Y trataron con desprecio el consejo del <char style="nd">ʼElyón</char>.<verse eid="PSA 107:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 107:12"/>Por tanto Él quebrantó sus corazones con trabajo.</para>
  <para style="q" vid="PSA 107:12">Cayeron y no hubo quien los ayudara.<verse eid="PSA 107:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 107:13"/>Pero en su angustia clamaron a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 107:13">Él los libró de sus aflicciones.<verse eid="PSA 107:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 107:14"/>Los sacó de la oscuridad y de la sombra de muerte,</para>
  <para style="q" vid="PSA 107:14">Y rompió sus ataduras.<verse eid="PSA 107:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 107:15"/>¡Den gracias a <char style="nd">Yavé</char> por su misericordia,</para>
  <para style="q" vid="PSA 107:15">Y por sus maravillas para los hijos de <char style="add">los</char> hombres!<verse eid="PSA 107:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 107:16"/>Porque quebró las puertas de bronce,</para>
  <para style="q" vid="PSA 107:16">Y desmenuzó los cerrojos de hierro.<verse eid="PSA 107:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 107:17"/>Fueron afligidos los necios a causa de su camino rebelde,</para>
  <para style="q" vid="PSA 107:17">Y a causa de sus iniquidades fueron afligidos.<verse eid="PSA 107:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 107:18"/>Su vida aborreció toda clase de alimento,</para>
  <para style="q" vid="PSA 107:18">Y se acercaron a las puertas de la muerte.<verse eid="PSA 107:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 107:19"/>Pero a <char style="nd">Yavé</char> clamaron en su angustia.</para>
  <para style="q" vid="PSA 107:19">Él los libró de sus aflicciones.<verse eid="PSA 107:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 107:20"/>Envió su Palabra y los sanó,</para>
  <para style="q" vid="PSA 107:20">Y <char style="add">los</char> libró de sus destrucciones.<verse eid="PSA 107:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 107:21"/>¡Den gracias a <char style="nd">Yavé</char> por su misericordia</para>
  <para style="q" vid="PSA 107:21">Y por sus maravillas para los hijos de <char style="add">los </char>hombres!<verse eid="PSA 107:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 107:22"/>Ofrezcan también sacrificios de acción de gracias</para>
  <para style="q" vid="PSA 107:22">Y proclamen sus obras con júbilo.<verse eid="PSA 107:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 107:23"/>Los que bajan en naves al mar,</para>
  <para style="q" vid="PSA 107:23">Los cuales hacen negocios sobre inmensas aguas.<verse eid="PSA 107:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 107:24"/>Ellos vieron las obras de <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 107:24">Y sus maravillas en las profundidades.<verse eid="PSA 107:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 107:25"/>Porque Él habló y levantó un viento tempestuoso</para>
  <para style="q" vid="PSA 107:25">Que levantó las olas del mar.<verse eid="PSA 107:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PSA 107:26"/>Subían hacia los cielos,</para>
  <para style="q" vid="PSA 107:26">Bajaban a las profundidades,</para>
  <para style="q" vid="PSA 107:26">Su alma se derretía en su desesperación.<verse eid="PSA 107:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 107:27"/>Temblaban y se tambaleaban como ebrios,</para>
  <para style="q" vid="PSA 107:27">Y toda su pericia fue inútil.<verse eid="PSA 107:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PSA 107:28"/>En su angustia clamaron a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 107:28">Y Él los sacó de sus angustias.<verse eid="PSA 107:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 107:29"/>Calmó la tormenta</para>
  <para style="q" vid="PSA 107:29">De tal modo que sus olas se apaciguaron.<verse eid="PSA 107:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 107:30"/>Entonces se alegraron porque se calmaron.</para>
  <para style="q" vid="PSA 107:30">Y así los guía al puerto que anhelan.<verse eid="PSA 107:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="PSA 107:31"/>¡Den gracias a <char style="nd">Yavé</char> por su misericordia,</para>
  <para style="q" vid="PSA 107:31">Y por sus maravillas para los hijos de <char style="add">los</char> hombres!<verse eid="PSA 107:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 107:32"/>Exáltenlo en la congregación del pueblo,</para>
  <para style="q" vid="PSA 107:32">Y alábenlo en la reunión de los ancianos.<verse eid="PSA 107:32"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="33" style="v" sid="PSA 107:33"/>Él cambia ríos en desierto</para>
  <para style="q" vid="PSA 107:33">Y manantiales de aguas en sequedales,<verse eid="PSA 107:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 107:34"/>La tierra fructífera en estéril,</para>
  <para style="q" vid="PSA 107:34">Por la perversidad de los que viven en ella.<verse eid="PSA 107:34"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="35" style="v" sid="PSA 107:35"/>Él convierte el desierto en estanques de aguas,</para>
  <para style="q" vid="PSA 107:35">Y la tierra seca en manantiales.<verse eid="PSA 107:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 107:36"/>Allí coloca a los que tienen hambre,</para>
  <para style="q" vid="PSA 107:36">Para que establezcan una ciudad habitada.<verse eid="PSA 107:36"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="37" style="v" sid="PSA 107:37"/>Siembran campos y plantan viñas</para>
  <para style="q" vid="PSA 107:37">Y recogen abundante fruto.<verse eid="PSA 107:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 107:38"/>Los bendice,</para>
  <para style="q" vid="PSA 107:38">Y se multiplican grandemente.</para>
  <para style="b" vid="PSA 107:38"/>
  <para style="q" vid="PSA 107:38">No permite que disminuya su ganado<verse eid="PSA 107:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 107:39"/>Cuando son menguados y abatidos</para>
  <para style="q" vid="PSA 107:39">Por medio de opresión, aflicción y tristeza.<verse eid="PSA 107:39"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="40" style="v" sid="PSA 107:40"/>Él derrama menosprecio sobre los nobles,</para>
  <para style="q" vid="PSA 107:40">Y los destina a vagar errantes en un desierto.<verse eid="PSA 107:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 107:41"/>Pero Él pone en alto a los pobres lejos de la aflicción</para>
  <para style="q" vid="PSA 107:41">Y hace que <char style="add">sus</char> familias sean como un rebaño.<verse eid="PSA 107:41"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="42" style="v" sid="PSA 107:42"/>Los rectos lo ven y se alegran,</para>
  <para style="q" vid="PSA 107:42">Pero toda injusticia cierra su boca.<verse eid="PSA 107:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 107:43"/>¿Quién es sabio?</para>
  <para style="q" vid="PSA 107:43">Observe estas cosas,</para>
  <para style="q" vid="PSA 107:43">Y entenderá las misericordias de <char style="nd">Yavé</char>.<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="s1">Canto. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 108:1"/>Mi corazón está firme, oh <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 108:1">Cantaré y entonaré salmos.</para>
  <para style="q" vid="PSA 108:1">Esta es mi gloria.<verse eid="PSA 108:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 108:2"/>Despierten, arpa y lira,<note caller="+" style="f"><char style="fr" closed="false">108.2 </char><char style="ft" closed="false">Lira: Antiguo instrumento músico de varias cuerdas tensas en un marco. </char></note></para>
  <para style="q" vid="PSA 108:2">Yo despertaré el alba.<verse eid="PSA 108:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 108:3"/>Oh <char style="nd">Yavé</char>, te daré gracias entre los pueblos.</para>
  <para style="q" vid="PSA 108:3">Entre las naciones te cantaré salmos,<verse eid="PSA 108:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 108:4"/>Porque tu misericordia es más grande que los cielos,</para>
  <para style="q" vid="PSA 108:4">Y hasta los cielos tu verdad.<verse eid="PSA 108:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 108:5"/>Exaltado seas por encima de los cielos, oh <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 108:5">Y tu gloria por encima de toda la tierra.<verse eid="PSA 108:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 108:6"/>Para que sean librados tus amados,</para>
  <para style="q" vid="PSA 108:6">Salva con tu mano derecha, y respóndeme.<verse eid="PSA 108:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 108:7"/>
    <char style="nd">ʼElohim</char> respondió en su Santuario:</para>
  <para style="q" vid="PSA 108:7">
    <char style="wj">Yo me alegraré. </char></para>
  <para style="q" vid="PSA 108:7">
    <char style="wj">Repartiré a Siquem. </char></para>
  <para style="q" vid="PSA 108:7">
    <char style="wj">Y mediré el valle de Sucot.</char><verse eid="PSA 108:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 108:8"/>
    <char style="wj">Mío es Galaad, </char></para>
  <para style="q" vid="PSA 108:8">
    <char style="wj">Mío es Manasés.</char></para>
  <para style="q" vid="PSA 108:8">
    <char style="wj">También Efraín es el casco de mi cabeza.</char></para>
  <para style="q" vid="PSA 108:8">
    <char style="wj">Judá es mi cetro.</char><verse eid="PSA 108:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 108:9"/>
    <char style="wj">Moab es la vasija en la cual me lavo.</char></para>
  <para style="q" vid="PSA 108:9">
    <char style="wj">Sobre Edom lanzaré mi sandalia.</char></para>
  <para style="q" vid="PSA 108:9">
    <char style="wj">Sobre Filistea proclamaré victoria.</char><verse eid="PSA 108:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 108:10"/>¿Quién me conducirá a la ciudad fortificada?</para>
  <para style="q" vid="PSA 108:10">¿Quién me guiará hasta Edom?<verse eid="PSA 108:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 108:11"/>¿Tú, mismo, oh <char style="nd">ʼElohim</char>, no nos rechazaste?</para>
  <para style="q" vid="PSA 108:11">¿Y no sales con nuestros ejércitos, oh <char style="nd">ʼElohim</char>?<verse eid="PSA 108:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 108:12"/>Socórrenos contra el adversario,</para>
  <para style="q" vid="PSA 108:12">Porque vana es la liberación del hombre.<verse eid="PSA 108:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 108:13"/>Por medio de <char style="nd">ʼElohim</char> haremos proezas.</para>
  <para style="q" vid="PSA 108:13">Él pisoteará a nuestros enemigos.<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="s1">Al director del coro. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 109:1"/>Oh <char style="nd">ʼElohim</char> de mi alabanza, no te calles.<verse eid="PSA 109:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 109:2"/>Porque la boca de los perversos y de los engañadores se abrió contra mí.</para>
  <para style="q" vid="PSA 109:2">Hablaron contra mí con lengua mentirosa.<verse eid="PSA 109:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 109:3"/>Con palabras de odio me rodearon,</para>
  <para style="q" vid="PSA 109:3">Y sin causa lucharon contra mí.<verse eid="PSA 109:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 109:4"/>Son mis adversarios para pagar mi amor,</para>
  <para style="q" vid="PSA 109:4">Pero yo hablo contigo.<verse eid="PSA 109:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 109:5"/>Me devuelven mal por bien,</para>
  <para style="q" vid="PSA 109:5">Y odio por mi amor.<verse eid="PSA 109:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 109:6"/>
    <char style="add">Dicen</char>: Levanta contra él a un perverso,</para>
  <para style="q" vid="PSA 109:6">Y esté un acusador a su mano derecha.<verse eid="PSA 109:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 109:7"/>Resulte culpable cuando sea juzgado,</para>
  <para style="q" vid="PSA 109:7">Y que su oración sea pecado.<verse eid="PSA 109:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 109:8"/>Sean pocos sus días.</para>
  <para style="q" vid="PSA 109:8">Tome otro su oficio.<verse eid="PSA 109:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 109:9"/>Sean huérfanos sus hijos,</para>
  <para style="q" vid="PSA 109:9">Y su esposa, viuda.<verse eid="PSA 109:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 109:10"/>Vaguen errantes sus hijos y mendiguen,</para>
  <para style="q" vid="PSA 109:10">Y busquen su pan lejos de sus casas arruinadas.<verse eid="PSA 109:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 109:11"/>Que el acreedor se apodere de todo lo que tiene,</para>
  <para style="q" vid="PSA 109:11">Y extraños saqueen el fruto de su trabajo.<verse eid="PSA 109:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 109:12"/>No tenga quien le extienda misericordia,</para>
  <para style="q" vid="PSA 109:12">Ni quien se compadezca de sus huérfanos.<verse eid="PSA 109:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 109:13"/>Sean exterminadas todas sus futuras generaciones.</para>
  <para style="q" vid="PSA 109:13">Sea el nombre de ellos borrado en la siguiente generación.<verse eid="PSA 109:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 109:14"/>Que la iniquidad de sus antepasados sea recordada ante <char style="nd">Yavé,</char></para>
  <para style="q" vid="PSA 109:14">Y que no sea borrado el pecado de su madre.<verse eid="PSA 109:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 109:15"/>Que estén siempre delante de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 109:15">Y corte Él de la tierra el recuerdo de ellos,<verse eid="PSA 109:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 109:16"/>Por cuanto no recordó mostrar misericordia,</para>
  <para style="q" vid="PSA 109:16">Sino persiguió al hombre afligido y menesteroso,</para>
  <para style="q" vid="PSA 109:16">Al quebrantado de corazón, para matarlo.<verse eid="PSA 109:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 109:17"/>También amó la maldición,</para>
  <para style="q" vid="PSA 109:17">Así que le llegó.</para>
  <para style="q" vid="PSA 109:17">No se deleitó en la bendición,</para>
  <para style="q" vid="PSA 109:17">Por tanto ésta estuvo lejos de él.<verse eid="PSA 109:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 109:18"/>Se cubrió de maldición como con su manto,</para>
  <para style="q" vid="PSA 109:18">Por lo cual la dejó entrar en su cuerpo como agua,</para>
  <para style="q" vid="PSA 109:18">Y como aceite en sus huesos.<verse eid="PSA 109:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 109:19"/>Que le sea como ropa con la cual se cubra</para>
  <para style="q" vid="PSA 109:19">Y como cinturón que lo ate siempre.<verse eid="PSA 109:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 109:20"/>Que ésta sea la recompensa de <char style="nd">Yavé</char> a mis acusadores</para>
  <para style="q" vid="PSA 109:20">Y a los que hablan mal contra mi vida.<verse eid="PSA 109:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 109:21"/>Pero Tú, oh <char style="nd">Yavé</char>, el <char style="nd">ʼAdonay</char>,</para>
  <para style="q" vid="PSA 109:21">Trata conmigo por amor a tu Nombre.</para>
  <para style="q" vid="PSA 109:21">Líbrame, porque tu misericordia es buena.<verse eid="PSA 109:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 109:22"/>Porque yo estoy afligido y necesitado.</para>
  <para style="q" vid="PSA 109:22">Mi corazón está herido dentro de mí.<verse eid="PSA 109:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 109:23"/>Paso como una sombra cuando se extiende,</para>
  <para style="q" vid="PSA 109:23">Soy echado fuera como el saltamonte.<verse eid="PSA 109:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 109:24"/>Mis rodillas están débiles a causa del ayuno,</para>
  <para style="q" vid="PSA 109:24">Y mi carne desfallece por falta de sustancia.<verse eid="PSA 109:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 109:25"/>Fui para ellos un objeto de reproche.</para>
  <para style="q" vid="PSA 109:25">Cuando me miran, menean su cabeza.<verse eid="PSA 109:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PSA 109:26"/>¡Ayúdame, oh <char style="nd">Yavé, ʼElohim</char> mío!</para>
  <para style="q" vid="PSA 109:26">¡Sálvame según tu misericordia!<verse eid="PSA 109:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 109:27"/>Que ellos entiendan que ésta es tu mano,</para>
  <para style="q" vid="PSA 109:27">Que Tú, oh <char style="nd">Yavé</char>, hiciste esto.<verse eid="PSA 109:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 109:28"/>Que ellos maldigan, pero Tú, bendice.</para>
  <para style="q" vid="PSA 109:28">Cuando se levanten, sean avergonzados,</para>
  <para style="q" vid="PSA 109:28">Pero tu esclavo estará alegre.<verse eid="PSA 109:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PSA 109:29"/>Que mis acusadores sean cubiertos de deshonra,</para>
  <para style="q" vid="PSA 109:29">Y que ellos mismos se cubran de vergüenza como un manto.<verse eid="PSA 109:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 109:30"/>Daré muchas gracias con mi boca a <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 109:30">En medio de muchos lo alabaré,<verse eid="PSA 109:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 109:31"/>Porque Él se coloca a la mano derecha del necesitado,</para>
  <para style="q" vid="PSA 109:31">Para salvar su vida de los que lo juzgan.<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="s1">Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 110:1"/>Dice <char style="nd">Yavé</char> a mi <char style="nd">ʼAdonay</char>:</para>
  <para style="q" vid="PSA 110:1">
    <char style="wj">Siéntate a mi mano derecha,</char></para>
  <para style="q" vid="PSA 110:1">
    <char style="wj">Hasta que pongas a tus enemigos como estrado de tus pies.</char><verse eid="PSA 110:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 110:2"/>
    <char style="nd">Yavé</char> enviará desde Sion el cetro<note caller="+" style="f"><char style="fr" closed="false">110.2 </char><char style="ft" closed="false">Cetro: Vara de oro labrada con primor que usaban los reyes como insignia de dignidad.</char></note> de tu poder.</para>
  <para style="q" vid="PSA 110:2">Domina en medio de tus enemigos<verse eid="PSA 110:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 110:3"/>En el día de tu poder.</para>
  <para style="q" vid="PSA 110:3">En la hermosura de la santidad desde el seno de la aurora,</para>
  <para style="q" vid="PSA 110:3">Con ornamento santo desde el vientre de la aurora,</para>
  <para style="q" vid="PSA 110:3">Tu juventud te es <char style="add">como</char> el rocío.<verse eid="PSA 110:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 110:4"/>
    <char style="nd">Yavé</char> juró y no cambiará:</para>
  <para style="q" vid="PSA 110:4">
    <char style="wj">Tú eres sacerdote para siempre según el orden de Melquisedec.</char><verse eid="PSA 110:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 110:5"/>
    <char style="nd">ʼAdonay</char> está a tu mano derecha.</para>
  <para style="q" vid="PSA 110:5">Quebrantará reyes en el día de su ira.<verse eid="PSA 110:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 110:6"/>Juzgará entre las naciones,</para>
  <para style="q" vid="PSA 110:6">Las llenará de cadáveres.</para>
  <para style="q" vid="PSA 110:6">Quebrantará a los gobernantes sobre la extensa tierra.<verse eid="PSA 110:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 110:7"/>Beberá del arroyo en el camino,</para>
  <para style="q" vid="PSA 110:7">Por tanto levantará <char style="add">su</char> cabeza.<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="s1">¡Aleluya!</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 111:1"/>Daré gracias a <char style="nd">Yavé</char> con todo <char style="add">mi</char> corazón</para>
  <para style="q" vid="PSA 111:1">En la compañía de los rectos y en la congregación.<verse eid="PSA 111:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 111:2"/>Grandes son las obras de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 111:2">Estudiadas por todos los que se deleitan en ellas.<verse eid="PSA 111:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 111:3"/>Espléndida y majestuosa es su obra,</para>
  <para style="q" vid="PSA 111:3">Y su justicia permanece para siempre.<verse eid="PSA 111:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 111:4"/>Hizo memorables sus maravillas.</para>
  <para style="q" vid="PSA 111:4">Clemente y misericordioso es <char style="nd">Yavé</char>.<verse eid="PSA 111:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 111:5"/>Dio alimento a los que le temen.</para>
  <para style="q" vid="PSA 111:5">Para siempre se acordará de su Pacto.<verse eid="PSA 111:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 111:6"/>El poder de sus obras manifestó a su pueblo</para>
  <para style="q" vid="PSA 111:6">Al darle la heredad de las naciones.<verse eid="PSA 111:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 111:7"/>Las obras de sus manos son verdad y justicia.</para>
  <para style="q" vid="PSA 111:7">Todos sus Preceptos son firmes.<verse eid="PSA 111:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 111:8"/>Afirmados eternamente y para siempre,</para>
  <para style="q" vid="PSA 111:8">Hechos con verdad y rectitud.<verse eid="PSA 111:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 111:9"/>Envió redención a su pueblo.</para>
  <para style="q" vid="PSA 111:9">Estableció su Pacto para siempre.</para>
  <para style="q" vid="PSA 111:9">Santo y asombroso es su Nombre.<verse eid="PSA 111:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 111:10"/>El principio de la sabiduría es el temor a <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 111:10">Buen entendimiento tienen todos los que lo practican.</para>
  <para style="q" vid="PSA 111:10">Su alabanza permanece para siempre.<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="s1">¡Aleluya!</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 112:1"/>¡Aleluya! Inmensamente feliz es el hombre que teme a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 112:1">Que grandemente se deleita en sus Mandamientos.<verse eid="PSA 112:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 112:2"/>Sus descendientes serán poderosos en la tierra.</para>
  <para style="q" vid="PSA 112:2">La generación de los rectos será bendita.<verse eid="PSA 112:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 112:3"/>Suficiencia y riquezas hay en su casa,</para>
  <para style="q" vid="PSA 112:3">Y su justicia permanece para siempre.<verse eid="PSA 112:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 112:4"/>Luz resplandece en las tinieblas para el recto.</para>
  <para style="q" vid="PSA 112:4">Es bondadoso, compasivo y justo.<verse eid="PSA 112:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 112:5"/>Anda bien el hombre que es bondadoso y presta.</para>
  <para style="q" vid="PSA 112:5">Mantendrá su causa en el juicio.<verse eid="PSA 112:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 112:6"/>Porque él nunca será conmovido,</para>
  <para style="q" vid="PSA 112:6">El justo será recordado para siempre.<verse eid="PSA 112:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 112:7"/>No tendrá temor de malas noticias.</para>
  <para style="q" vid="PSA 112:7">Su corazón está firme, confiado en <char style="nd">Yavé</char>.<verse eid="PSA 112:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 112:8"/>Su corazón está sostenido.</para>
  <para style="q" vid="PSA 112:8">No temerá hasta que mire desde arriba a sus adversarios.<verse eid="PSA 112:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 112:9"/>El reparte libremente a los pobres.</para>
  <para style="q" vid="PSA 112:9">Su justicia permanece para siempre.</para>
  <para style="q" vid="PSA 112:9">Su poder es exaltado con honor.<verse eid="PSA 112:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 112:10"/>Lo verá el perverso y se angustiará.</para>
  <para style="q" vid="PSA 112:10">Crujirá sus dientes y se consumirá.</para>
  <para style="q" vid="PSA 112:10">El deseo de los perversos perecerá.<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="s1">¡Aleluya!</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 113:1"/>¡Alaben, esclavos de <char style="nd">Yavé</char>!</para>
  <para style="q" vid="PSA 113:1">¡Alaben el Nombre de <char style="nd">Yavé</char>!<verse eid="PSA 113:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 113:2"/>¡Bendito sea el Nombre de <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 113:2">Desde ahora y para siempre!<verse eid="PSA 113:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 113:3"/>Desde el nacimiento del sol hasta su ocaso</para>
  <para style="q" vid="PSA 113:3">Sea alabado el Nombre de <char style="nd">Yavé</char>.<verse eid="PSA 113:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 113:4"/>
    <char style="nd">Yavé</char> es excelso sobre todas las naciones,</para>
  <para style="q" vid="PSA 113:4">Sobre el cielo su gloria.<verse eid="PSA 113:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 113:5"/>¿Quién es como <char style="nd">Yavé</char>, nuestro <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 113:5">Quien está entronizado en las alturas,<verse eid="PSA 113:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 113:6"/>Quien se humilla para mirar en el cielo y en la tierra?<verse eid="PSA 113:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 113:7"/>Él levanta del polvo al pobre</para>
  <para style="q" vid="PSA 113:7">Y saca del basurero al indigente,<verse eid="PSA 113:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 113:8"/>Para hacerlos sentar con líderes,</para>
  <para style="q" vid="PSA 113:8">Con los líderes de su pueblo.<verse eid="PSA 113:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 113:9"/>Él coloca en la casa a la estéril</para>
  <para style="q" vid="PSA 113:9">Como madre gozosa de hijos.</para>
  <para style="b" vid="PSA 113:9"/>
  <para style="q" vid="PSA 113:9">¡Aleluya!<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 114:1"/>Cuando Israel salió de Egipto,</para>
  <para style="q" vid="PSA 114:1">La casa de Jacob de un pueblo de lengua extraña,<verse eid="PSA 114:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 114:2"/>Judá fue su santuario,</para>
  <para style="q" vid="PSA 114:2">E Israel, su dominio.<verse eid="PSA 114:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 114:3"/>El mar <char style="add">lo</char> vio y huyó,</para>
  <para style="q" vid="PSA 114:3">El Jordán retrocedió.<verse eid="PSA 114:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 114:4"/>Las montañas saltaron como carneros,</para>
  <para style="q" vid="PSA 114:4">Las colinas, como corderos.<verse eid="PSA 114:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 114:5"/>¿Qué te ocurrió, oh mar, que huiste?</para>
  <para style="q" vid="PSA 114:5">¿Y tú, oh Jordán, que retrocediste?<verse eid="PSA 114:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 114:6"/>¿<char style="add">Ustedes, oh montañas</char>, que saltan como carneros,</para>
  <para style="q" vid="PSA 114:6">Y ustedes, oh colinas, como corderos?<verse eid="PSA 114:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 114:7"/>Tiembla, oh tierra, ante <char style="nd">ʼAdonay</char>,</para>
  <para style="q" vid="PSA 114:7">Ante el <char style="nd">ʼElohim</char> de Jacob,<verse eid="PSA 114:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 114:8"/>Quien convirtió la peña en un estanque de aguas,</para>
  <para style="q" vid="PSA 114:8">Y el pedernal en manantial de aguas.<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 115:1"/>No a nosotros, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 115:1">No a nosotros,</para>
  <para style="q" vid="PSA 115:1">Sino a tu Nombre da gloria,</para>
  <para style="q" vid="PSA 115:1">Por tu misericordia y por tu verdad.<verse eid="PSA 115:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 115:2"/>¿Por qué deben decir los gentiles:</para>
  <para style="q" vid="PSA 115:2">Dónde está su <char style="nd">ʼElohim</char>?<verse eid="PSA 115:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 115:3"/>Nuestro <char style="nd">ʼElohim</char> está en el cielo.</para>
  <para style="q" vid="PSA 115:3">Hizo todo lo que quiso.<verse eid="PSA 115:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 115:4"/>Los ídolos de ellos son de plata y oro,</para>
  <para style="q" vid="PSA 115:4">Obra de manos de hombres.<verse eid="PSA 115:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 115:5"/>Tienen bocas, pero no hablan.</para>
  <para style="q" vid="PSA 115:5">Tienen ojos, pero no ven.<verse eid="PSA 115:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 115:6"/>Tienen orejas, pero no oyen.</para>
  <para style="q" vid="PSA 115:6">Tienen fosas nasales, pero no perciben olor.<verse eid="PSA 115:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 115:7"/>Tienen manos, pero no palpan.</para>
  <para style="q" vid="PSA 115:7">Tienen pies, pero no andan.</para>
  <para style="b" vid="PSA 115:7"/>
  <para style="q" vid="PSA 115:7">No hablan con su garganta.<verse eid="PSA 115:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 115:8"/>Los que los hacen</para>
  <para style="q" vid="PSA 115:8">Y todos los que confían en ellos</para>
  <para style="q" vid="PSA 115:8">Son semejantes a ellos.<verse eid="PSA 115:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 115:9"/>¡Oh Israel, confía en <char style="nd">Yavé</char>!</para>
  <para style="q" vid="PSA 115:9">Él es tu Ayuda y Escudo.<verse eid="PSA 115:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 115:10"/>¡Oh casa de Aarón, confía en <char style="nd">Yavé</char>!</para>
  <para style="q" vid="PSA 115:10">Él es tu Ayuda y tu Escudo.<verse eid="PSA 115:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 115:11"/>Los que temen a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 115:11">Confíen en <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 115:11">Él es su Ayuda y su Escudo.<verse eid="PSA 115:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 115:12"/>
    <char style="nd">Yavé</char> se acordó de nosotros,</para>
  <para style="q" vid="PSA 115:12">Él nos bendecirá.</para>
  <para style="q" vid="PSA 115:12">Bendecirá a la casa de Israel,</para>
  <para style="q" vid="PSA 115:12">Bendecirá a la casa de Aarón.<verse eid="PSA 115:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 115:13"/>Bendecirá a los que temen a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 115:13">A los pequeños y a los grandes.<verse eid="PSA 115:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 115:14"/>
    <char style="nd">Yavé</char> aumentará bendición</para>
  <para style="q" vid="PSA 115:14">Sobre ustedes y sobre sus hijos.<verse eid="PSA 115:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 115:15"/>Benditos sean ustedes por <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 115:15">Quien hizo el cielo y la tierra.<verse eid="PSA 115:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 115:16"/>El cielo es el cielo de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 115:16">Pero Él dio la tierra a los hijos de <char style="add">los</char> hombres.<verse eid="PSA 115:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 115:17"/>No alaban los muertos a <char style="nd">YA</char>,</para>
  <para style="q" vid="PSA 115:17">Ni cualquiera que baja al silencio.<verse eid="PSA 115:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 115:18"/>Pero nosotros bendecimos a <char style="nd">YA</char> desde ahora y para siempre.</para>
  <para style="b" vid="PSA 115:18"/>
  <para style="q" vid="PSA 115:18">¡Aleluya!<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 116:1"/>Amo a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 116:1">Porque escucha mi voz y mis súplicas,<verse eid="PSA 116:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 116:2"/>Porque inclina a mí su oído.</para>
  <para style="q" vid="PSA 116:2">Por tanto, <char style="add">lo</char> invocaré mientras viva.<verse eid="PSA 116:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 116:3"/>Me rodearon las ataduras de la muerte.</para>
  <para style="q" vid="PSA 116:3">Me cayeron los terrores del <char style="tl">Seol</char>.</para>
  <para style="q" vid="PSA 116:3">Hallé angustia y tristeza.<verse eid="PSA 116:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 116:4"/>Entonces invoqué el Nombre de <char style="nd">Yavé</char>:</para>
  <para style="q" vid="PSA 116:4">Oh <char style="nd">Yavé</char>, te busco, libra mi alma.<verse eid="PSA 116:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 116:5"/>Bondadoso y justo es <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 116:5">Sí, misericordioso es nuestro <char style="nd">ʼElohim</char>.<verse eid="PSA 116:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 116:6"/>
    <char style="nd">Yavé</char> guarda a los sencillos.</para>
  <para style="q" vid="PSA 116:6">Estaba yo postrado</para>
  <para style="q" vid="PSA 116:6">Y Él me salvó.<verse eid="PSA 116:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 116:7"/>Vuelve, alma mía, a tu reposo,</para>
  <para style="q" vid="PSA 116:7">Porque <char style="nd">Yavé</char> te llenó de bien.<verse eid="PSA 116:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 116:8"/>Tú libraste mi vida de la muerte,</para>
  <para style="q" vid="PSA 116:8">Mis ojos, de las lágrimas,</para>
  <para style="q" vid="PSA 116:8">Y mis pies, de tropezar.<verse eid="PSA 116:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 116:9"/>Andaré delante de <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 116:9">En la tierra de los vivientes.<verse eid="PSA 116:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 116:10"/>Creí, por tanto hablé:</para>
  <para style="q" vid="PSA 116:10">Estoy afligido en gran manera.<verse eid="PSA 116:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 116:11"/>Y dije en mi apresuramiento:</para>
  <para style="q" vid="PSA 116:11">Todo hombre es mentiroso.<verse eid="PSA 116:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 116:12"/>¿Qué pagaré a <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 116:12">Por todos sus beneficios para mí?<verse eid="PSA 116:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 116:13"/>Levantaré la copa de la salvación</para>
  <para style="q" vid="PSA 116:13">E invocaré el Nombre de <char style="nd">Yavé</char>.<verse eid="PSA 116:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 116:14"/>A <char style="nd">Yavé</char> cumpliré mis votos</para>
  <para style="q" vid="PSA 116:14">En presencia de todo su pueblo.<verse eid="PSA 116:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 116:15"/>Estimada es a los ojos de <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 116:15">La muerte de sus santos.<verse eid="PSA 116:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 116:16"/>Oh <char style="nd">Yavé</char>, ciertamente yo soy tu esclavo.</para>
  <para style="q" vid="PSA 116:16">Esclavo tuyo soy, hijo de tu esclava,</para>
  <para style="q" vid="PSA 116:16">Tú desataste mis ataduras.<verse eid="PSA 116:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 116:17"/>Te ofreceré sacrificio de acción de gracias</para>
  <para style="q" vid="PSA 116:17">E invocaré el Nombre de <char style="nd">Yavé</char>.<verse eid="PSA 116:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 116:18"/>A <char style="nd">Yavé</char> cumpliré mis votos,</para>
  <para style="q" vid="PSA 116:18">En presencia de todo su pueblo,<verse eid="PSA 116:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 116:19"/>En los patios de la Casa de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 116:19">En medio de <char style="add">ti</char>, oh Jerusalén.</para>
  <para style="b" vid="PSA 116:19"/>
  <para style="q" vid="PSA 116:19">¡Aleluya!<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 117:1"/>Alaben a <char style="nd">Yavé</char>, todas las naciones.</para>
  <para style="q" vid="PSA 117:1">Alábenlo todos los pueblos.<verse eid="PSA 117:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 117:2"/>Porque su misericordia es grande para nosotros</para>
  <para style="q" vid="PSA 117:2">Y la fidelidad de <char style="nd">Yavé</char> es para siempre.</para>
  <para style="b" vid="PSA 117:2"/>
  <para style="q" vid="PSA 117:2">¡Aleluya!<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 118:1"/>Den gracias a <char style="nd">Yavé</char>, porque Él es bueno,</para>
  <para style="q" vid="PSA 118:1">Porque para siempre es su misericordia.<verse eid="PSA 118:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 118:2"/>Diga ahora Israel:</para>
  <para style="q" vid="PSA 118:2">Que para siempre es su misericordia.<verse eid="PSA 118:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 118:3"/>Diga la casa de Aarón:</para>
  <para style="q" vid="PSA 118:3">Que para siempre es su misericordia.<verse eid="PSA 118:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 118:4"/>Digan ahora los que temen a <char style="nd">Yavé</char>:</para>
  <para style="q" vid="PSA 118:4">Que para siempre es su misericordia.<verse eid="PSA 118:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 118:5"/>En mi angustia clamé a <char style="nd">YA</char>,</para>
  <para style="q" vid="PSA 118:5">Y <char style="nd">YA</char> me respondió</para>
  <para style="q" vid="PSA 118:5">Y me colocó en lugar amplio.<verse eid="PSA 118:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 118:6"/>
    <char style="nd">Yavé</char> está conmigo,</para>
  <para style="q" vid="PSA 118:6">No temeré</para>
  <para style="q" vid="PSA 118:6">Lo que me haga el hombre.<verse eid="PSA 118:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 118:7"/>
    <char style="nd">Yavé</char> está conmigo entre los que me ayudan.</para>
  <para style="q" vid="PSA 118:7">Por tanto veré mi deseo en los que me odian.<verse eid="PSA 118:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 118:8"/>Mejor es refugiarse en <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 118:8">Que confiar en hombre.<verse eid="PSA 118:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 118:9"/>Mejor es refugiarse en <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 118:9">Que confiar en los poderosos.<verse eid="PSA 118:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 118:10"/>Todas las naciones me rodearon.</para>
  <para style="q" vid="PSA 118:10">En el Nombre de <char style="nd">Yavé</char> yo las destruiré.<verse eid="PSA 118:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 118:11"/>Me rodearon,</para>
  <para style="q" vid="PSA 118:11">Sí, me asediaron.</para>
  <para style="q" vid="PSA 118:11">En el Nombre de <char style="nd">Yavé</char> ciertamente las destruiré.<verse eid="PSA 118:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 118:12"/>Me rodearon como abejas.</para>
  <para style="q" vid="PSA 118:12">Se extinguieron como fuego de espinos.</para>
  <para style="q" vid="PSA 118:12">En el Nombre de <char style="nd">Yavé</char> yo ciertamente las destruiré.<verse eid="PSA 118:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 118:13"/>Ustedes me empujaron con violencia</para>
  <para style="q" vid="PSA 118:13">De modo que estaba cayendo,</para>
  <para style="q" vid="PSA 118:13">Pero me ayudó <char style="nd">Yavé</char>.<verse eid="PSA 118:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 118:14"/>Mi Fortaleza y mi Canto es <char style="nd">YA</char>.</para>
  <para style="q" vid="PSA 118:14">Él es mi salvación.<verse eid="PSA 118:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 118:15"/>Voz de júbilo y de salvación hay en las tiendas de los justos.</para>
  <para style="q" vid="PSA 118:15">La mano derecha de <char style="nd">Yavé</char> hace proezas.<verse eid="PSA 118:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 118:16"/>La mano derecha de <char style="nd">Yavé</char> está levantada en alto.</para>
  <para style="q" vid="PSA 118:16">La mano derecha de <char style="nd">Yavé</char> realiza hazañas.<verse eid="PSA 118:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 118:17"/>No moriré, sino viviré,</para>
  <para style="q" vid="PSA 118:17">Y contaré las obras de <char style="nd">YA</char>.<verse eid="PSA 118:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 118:18"/>Me disciplinó severamente <char style="nd">YA</char>,</para>
  <para style="q" vid="PSA 118:18">Pero no me entregó a la muerte.<verse eid="PSA 118:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 118:19"/>Ábranme las puertas de la justicia.</para>
  <para style="q" vid="PSA 118:19">Entraré por ellas,</para>
  <para style="q" vid="PSA 118:19">Daré gracias a <char style="nd">YA</char>.<verse eid="PSA 118:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 118:20"/>Esta es la puerta de <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 118:20">Por ella entrarán los justos.<verse eid="PSA 118:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 118:21"/>Te alabaré porque me escuchaste,</para>
  <para style="q" vid="PSA 118:21">Y fuiste mi salvación.<verse eid="PSA 118:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PSA 118:22"/>La piedra que desecharon los edificadores</para>
  <para style="q" vid="PSA 118:22">Es cabeza del ángulo.<verse eid="PSA 118:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 118:23"/>Esta es la obra de <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 118:23">Es maravillosa ante nuestros ojos.<verse eid="PSA 118:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PSA 118:24"/>Este es el día que hizo <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 118:24">¡Regocijémonos y alegrémonos en él!<verse eid="PSA 118:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PSA 118:25"/>Te imploramos, oh <char style="nd">Yavé.</char> ¡Sálvanos ahora!</para>
  <para style="q" vid="PSA 118:25">Te rogamos, oh <char style="nd">Yavé</char> que nos prosperes ahora.<verse eid="PSA 118:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PSA 118:26"/>¡Bendito el que viene en el Nombre de Yavé!</para>
  <para style="q" vid="PSA 118:26">Desde la Casa de <char style="nd">Yavé</char> los bendecimos.<verse eid="PSA 118:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 118:27"/>
    <char style="nd">ʼEL</char> es <char style="nd">Yavé</char>, y nos dio luz,</para>
  <para style="q" vid="PSA 118:27">Aten con cuerdas sacrificios festivos a los cuernos del altar.<verse eid="PSA 118:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PSA 118:28"/>Tú eres mi <char style="nd">ʼEL,</char> y te doy gracias.</para>
  <para style="q" vid="PSA 118:28">Tú eres mi <char style="nd">ʼElohim,</char> te exaltaré.<verse eid="PSA 118:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PSA 118:29"/>Den gracias a <char style="nd">Yavé</char> porque Él es bueno,</para>
  <para style="q" vid="PSA 118:29">Porque para siempre es su misericordia.<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 119:1"/>Inmensamente felices son los de proceder intachable,</para>
  <para style="q" vid="PSA 119:1">Quienes andan en la Ley de <char style="nd">Yavé</char>.<verse eid="PSA 119:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 119:2"/>Inmensamente felices son los que observan sus Testimonios,</para>
  <para style="q" vid="PSA 119:2">Los que lo buscan de todo corazón.<verse eid="PSA 119:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 119:3"/>Ellos tampoco cometen injusticia.</para>
  <para style="q" vid="PSA 119:3">Andan en los caminos de Él.<verse eid="PSA 119:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 119:4"/>Tú nos ordenaste</para>
  <para style="q" vid="PSA 119:4">Que guardemos tus Preceptos con diligencia.<verse eid="PSA 119:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 119:5"/>¡Cómo anhelo que sean establecidos mis caminos,</para>
  <para style="q" vid="PSA 119:5">Para guardar tus Estatutos!<verse eid="PSA 119:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 119:6"/>Entonces no sería yo avergonzado</para>
  <para style="q" vid="PSA 119:6">Cuando observe todos tus Mandamientos.<verse eid="PSA 119:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 119:7"/>Te daré gracias con rectitud de corazón</para>
  <para style="q" vid="PSA 119:7">Cuando aprenda tus rectos juicios.<verse eid="PSA 119:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 119:8"/>Guardaré tus Estatutos.</para>
  <para style="q" vid="PSA 119:8">No me abandones completamente.<verse eid="PSA 119:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 119:9"/>¿Cómo puede un joven guardar puro su camino?</para>
  <para style="q" vid="PSA 119:9">Al mantenerlo según tu Palabra.<verse eid="PSA 119:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 119:10"/>Con todo mi corazón te he buscado.</para>
  <para style="q" vid="PSA 119:10">No permitas que me desvíe de tus Mandamientos.<verse eid="PSA 119:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 119:11"/>Tu Palabra atesoré en mi corazón</para>
  <para style="q" vid="PSA 119:11">Para no pecar contra Ti.<verse eid="PSA 119:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 119:12"/>Bendito seas Tú, oh <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 119:12">Enséñame tus Estatutos.<verse eid="PSA 119:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 119:13"/>Con mis labios conté</para>
  <para style="q" vid="PSA 119:13">Todas las Ordenanzas de tu boca.<verse eid="PSA 119:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 119:14"/>Me he regocijado en el camino de tus Testimonios,</para>
  <para style="q" vid="PSA 119:14">Tanto como en todas <char style="add">las</char> riquezas.<verse eid="PSA 119:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 119:15"/>Meditaré en tus Ordenanzas.</para>
  <para style="q" vid="PSA 119:15">Consideraré tus caminos.<verse eid="PSA 119:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 119:16"/>Me deleitaré en tus Estatutos.</para>
  <para style="q" vid="PSA 119:16">No olvidaré tu Palabra.<verse eid="PSA 119:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 119:17"/>Concede beneficio a tu esclavo,</para>
  <para style="q" vid="PSA 119:17">Que yo viva y guarde tu Palabra.<verse eid="PSA 119:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 119:18"/>Abre mis ojos,</para>
  <para style="q" vid="PSA 119:18">Para que yo vea las maravillas de tu Ley.<verse eid="PSA 119:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 119:19"/>Soy un peregrino en la tierra.</para>
  <para style="q" vid="PSA 119:19">No encubras de mí tus Mandamientos.<verse eid="PSA 119:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 119:20"/>Mi alma se quebranta con el anhelo</para>
  <para style="q" vid="PSA 119:20">De seguir tus Ordenanzas en todo tiempo.<verse eid="PSA 119:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 119:21"/>Tú reprendes a los arrogantes.</para>
  <para style="q" vid="PSA 119:21">Son malditos los que se desvían de tus Mandamientos.<verse eid="PSA 119:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 119:22"/>Aparta de mí el oprobio y el menosprecio,</para>
  <para style="q" vid="PSA 119:22">Porque he guardado tus Testimonios.<verse eid="PSA 119:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 119:23"/>Aunque los magistrados se sienten</para>
  <para style="q" vid="PSA 119:23">Y hablen contra mí,</para>
  <para style="q" vid="PSA 119:23">Tu esclavo medita en tus Estatutos.<verse eid="PSA 119:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 119:24"/>Tus Testimonios son también mi deleite y mis consejeros.<verse eid="PSA 119:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PSA 119:25"/>Postrada en el polvo está mi alma.</para>
  <para style="q" vid="PSA 119:25">Dame vida según tu Palabra.<verse eid="PSA 119:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 119:26"/>Te declaré mis caminos,</para>
  <para style="q" vid="PSA 119:26">Y me respondiste.</para>
  <para style="q" vid="PSA 119:26">Enséñame tus Estatutos.<verse eid="PSA 119:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PSA 119:27"/>Hazme entender la vía de tus Estatutos</para>
  <para style="q" vid="PSA 119:27">Para que yo medite en sus maravillas.<verse eid="PSA 119:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 119:28"/>Mi vida se disuelve a causa de la tristeza.</para>
  <para style="q" vid="PSA 119:28">Fortaléceme según tu Palabra.<verse eid="PSA 119:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PSA 119:29"/>Aparta de mí el camino falso,</para>
  <para style="q" vid="PSA 119:29">Y con bondad concédeme tu Ley.<verse eid="PSA 119:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 119:30"/>Escogí el camino fiel.</para>
  <para style="q" vid="PSA 119:30">Me enfrenté a tus Ordenanzas.<verse eid="PSA 119:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="PSA 119:31"/>Me apegué a tus Testimonios, oh <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 119:31">No me entregues a la vergüenza.<verse eid="PSA 119:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 119:32"/>Correré por el camino de tus Mandamientos,</para>
  <para style="q" vid="PSA 119:32">Porque Tú ensancharás mi corazón.<verse eid="PSA 119:32"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="33" style="v" sid="PSA 119:33"/>Enséñame, oh <char style="nd">Yavé</char>, la vía de tus Estatutos,</para>
  <para style="q" vid="PSA 119:33">Y lo guardaré hasta el fin.<verse eid="PSA 119:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 119:34"/>Dame entendimiento para que yo observe tu Ley,</para>
  <para style="q" vid="PSA 119:34">Y la observaré de todo corazón.<verse eid="PSA 119:34"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="35" style="v" sid="PSA 119:35"/>Hazme andar por la senda de sus Mandamientos,</para>
  <para style="q" vid="PSA 119:35">Porque en ella me deleito.<verse eid="PSA 119:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 119:36"/>Inclina mi corazón a tus Testimonios,</para>
  <para style="q" vid="PSA 119:36">Y no a ganancia deshonesta.<verse eid="PSA 119:36"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="37" style="v" sid="PSA 119:37"/>Aparta mis ojos para que no miren vanidad.</para>
  <para style="q" vid="PSA 119:37">Revíveme en tus caminos.<verse eid="PSA 119:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 119:38"/>Establece tu Palabra para tu esclavo,</para>
  <para style="q" vid="PSA 119:38">Como la que produce reverencia a Ti.<verse eid="PSA 119:38"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="39" style="v" sid="PSA 119:39"/>Aleja de mí la reprobación que temo,</para>
  <para style="q" vid="PSA 119:39">Porque tus Ordenanzas son buenas.<verse eid="PSA 119:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 119:40"/>Mira, yo anhelo tus Preceptos.</para>
  <para style="q" vid="PSA 119:40">Revíveme en tu justicia.<verse eid="PSA 119:40"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="41" style="v" sid="PSA 119:41"/>Venga a mí, oh <char style="nd">Yavé</char>, tu misericordia,</para>
  <para style="q" vid="PSA 119:41">Tu salvación, conforme a tu Palabra,<verse eid="PSA 119:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 119:42"/>A fin de que tenga respuesta para el que me reprueba,</para>
  <para style="q" vid="PSA 119:42">Porque confío en tu Palabra.<verse eid="PSA 119:42"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="43" style="v" sid="PSA 119:43"/>No quites de mi boca en algún momento la Palabra de verdad,</para>
  <para style="q" vid="PSA 119:43">Porque yo confío en tus Ordenanzas.<verse eid="PSA 119:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 119:44"/>Así observaré tu Ley continuamente,</para>
  <para style="q" vid="PSA 119:44">Eternamente y para siempre.<verse eid="PSA 119:44"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="45" style="v" sid="PSA 119:45"/>Andaré en libertad,</para>
  <para style="q" vid="PSA 119:45">Porque busco tus Preceptos.<verse eid="PSA 119:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 119:46"/>Delante de reyes hablaré también de tus Testimonios,</para>
  <para style="q" vid="PSA 119:46">Y no me avergonzaré.<verse eid="PSA 119:46"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="47" style="v" sid="PSA 119:47"/>Me deleitaré en tus Mandamientos,</para>
  <para style="q" vid="PSA 119:47">Los cuales amo.<verse eid="PSA 119:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 119:48"/>Alzaré mis manos hacia tus Mandamientos,</para>
  <para style="q" vid="PSA 119:48">Los cuales amo,</para>
  <para style="q" vid="PSA 119:48">Y meditaré en tus Estatutos.<verse eid="PSA 119:48"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="49" style="v" sid="PSA 119:49"/>Recuerda la promesa <char style="add">dada</char> a tu esclavo,</para>
  <para style="q" vid="PSA 119:49">En la cual me ordenaste esperar.<verse eid="PSA 119:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 119:50"/>Ella es mi consuelo en mi aflicción,</para>
  <para style="q" vid="PSA 119:50">Porque tu Palabra me da vida.<verse eid="PSA 119:50"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="51" style="v" sid="PSA 119:51"/>Muchos se burlan de mí,</para>
  <para style="q" vid="PSA 119:51">Pero no me apartan de tu Ley.<verse eid="PSA 119:51"/></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 119:52"/>Recuerdo tus antiguas Ordenanzas, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 119:52">Y me consuelo.<verse eid="PSA 119:52"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="53" style="v" sid="PSA 119:53"/>Indignación ardiente se apoderó de mí</para>
  <para style="q" vid="PSA 119:53">A causa de los perversos que abandonan tu Ley.<verse eid="PSA 119:53"/></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 119:54"/>Tus Estatutos fueron cantos para mí</para>
  <para style="q" vid="PSA 119:54">En la casa de mi peregrinaje.<verse eid="PSA 119:54"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="55" style="v" sid="PSA 119:55"/>Recuerdo tu Nombre en la noche, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 119:55">Y observo tu Ley.<verse eid="PSA 119:55"/></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 119:56"/>Esto me sucedió</para>
  <para style="q" vid="PSA 119:56">Para que yo observe tus Preceptos.<verse eid="PSA 119:56"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="57" style="v" sid="PSA 119:57"/>Mi posesión es <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 119:57">Prometí que observaré tus Palabras.<verse eid="PSA 119:57"/></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 119:58"/>Busqué tu favor con todo mi corazón.</para>
  <para style="q" vid="PSA 119:58">Sé bondadoso conmigo, según tu Palabra.<verse eid="PSA 119:58"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="59" style="v" sid="PSA 119:59"/>Consideré mis caminos</para>
  <para style="q" vid="PSA 119:59">Y volví mis pies a tus Testimonios.<verse eid="PSA 119:59"/></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 119:60"/>Me apresuré, no me demoré</para>
  <para style="q" vid="PSA 119:60">En guardar tus Mandamientos.<verse eid="PSA 119:60"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="61" style="v" sid="PSA 119:61"/>Las cuerdas de los perversos me rodearon,</para>
  <para style="q" vid="PSA 119:61">Pero no olvidé tu Ley.<verse eid="PSA 119:61"/></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 119:62"/>A medianoche me levanto</para>
  <para style="q" vid="PSA 119:62">Para darte gracias por tus justas Ordenanzas.<verse eid="PSA 119:62"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="63" style="v" sid="PSA 119:63"/>Soy compañero de todos los que te temen,</para>
  <para style="q" vid="PSA 119:63">Y de los que observan sus Preceptos.<verse eid="PSA 119:63"/></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 119:64"/>Oh <char style="nd">Yavé</char>, la tierra está llena de tu misericordia.</para>
  <para style="q" vid="PSA 119:64">Enséñame tus Estatutos.<verse eid="PSA 119:64"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="65" style="v" sid="PSA 119:65"/>Oh <char style="nd">Yavé</char>, bien hiciste a tu esclavo según tu Palabra.<verse eid="PSA 119:65"/></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 119:66"/>Enséñame buen discernimiento y conocimiento,</para>
  <para style="q" vid="PSA 119:66">Porque creo tus Mandamientos.<verse eid="PSA 119:66"/></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 119:67"/>Antes de ser afligido me extravié,</para>
  <para style="q" vid="PSA 119:67">Pero ahora observo tu Palabra.<verse eid="PSA 119:67"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="68" style="v" sid="PSA 119:68"/>Bueno eres Tú</para>
  <para style="q" vid="PSA 119:68">Y haces lo bueno.</para>
  <para style="q" vid="PSA 119:68">Enséñame tus Estatutos.<verse eid="PSA 119:68"/></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 119:69"/>Los arrogantes forjaron mentira contra mí.</para>
  <para style="q" vid="PSA 119:69">Yo observo tus Preceptos de todo corazón.<verse eid="PSA 119:69"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="70" style="v" sid="PSA 119:70"/>Los corazones de ellos están cubiertos de grasa.</para>
  <para style="q" vid="PSA 119:70">Yo me deleito en tu Ley.<verse eid="PSA 119:70"/></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 119:71"/>Fue bueno para mí que fui afligido,</para>
  <para style="q" vid="PSA 119:71">Para que aprenda tus Estatutos.<verse eid="PSA 119:71"/></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 119:72"/>Mejor me es la Ley de tu boca</para>
  <para style="q" vid="PSA 119:72">Que millares de oro y plata.<verse eid="PSA 119:72"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="73" style="v" sid="PSA 119:73"/>Tus manos me hicieron y me afirmaron.</para>
  <para style="q" vid="PSA 119:73">Dame entendimiento para que aprenda tus Mandamientos.<verse eid="PSA 119:73"/></para>
  <para style="q">
    <verse number="74" style="v" sid="PSA 119:74"/>Que los que te reverencian</para>
  <para style="q" vid="PSA 119:74">Me vean y se alegren,</para>
  <para style="q" vid="PSA 119:74">Porque confié en tu Palabra.<verse eid="PSA 119:74"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="75" style="v" sid="PSA 119:75"/>Sé, oh <char style="nd">Yavé</char>, que tus juicios con justos,</para>
  <para style="q" vid="PSA 119:75">Y que me afligiste según tu fidelidad.<verse eid="PSA 119:75"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="76" style="v" sid="PSA 119:76"/>Oh, que tu misericordia me consuele,</para>
  <para style="q" vid="PSA 119:76">Conforme prometiste a tu esclavo.<verse eid="PSA 119:76"/></para>
  <para style="q">
    <verse number="77" style="v" sid="PSA 119:77"/>Que tu compasión venga a mí,</para>
  <para style="q" vid="PSA 119:77">Para que yo viva,</para>
  <para style="q" vid="PSA 119:77">Porque tu Ley es mi deleite.<verse eid="PSA 119:77"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="78" style="v" sid="PSA 119:78"/>Sean avergonzados los arrogantes,</para>
  <para style="q" vid="PSA 119:78">Porque sin causa me calumnian,</para>
  <para style="q" vid="PSA 119:78">Pero yo meditaré en tus Preceptos.<verse eid="PSA 119:78"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="79" style="v" sid="PSA 119:79"/>Que se vuelvan a mí los que te temen,</para>
  <para style="q" vid="PSA 119:79">Los que conocen tus Testimonios.<verse eid="PSA 119:79"/></para>
  <para style="q">
    <verse number="80" style="v" sid="PSA 119:80"/>Sea mi corazón íntegro en tus Estatutos,</para>
  <para style="q" vid="PSA 119:80">Para que no sea avergonzado.<verse eid="PSA 119:80"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="81" style="v" sid="PSA 119:81"/>Mi alma desfallece por tu salvación.</para>
  <para style="q" vid="PSA 119:81">Pero confío en tu Palabra.<verse eid="PSA 119:81"/></para>
  <para style="q">
    <verse number="82" style="v" sid="PSA 119:82"/>Se consumen mis ojos <char style="add">esperando</char> tu Palabra,</para>
  <para style="q" vid="PSA 119:82">Mientras digo: ¿Cuándo me consolará?<verse eid="PSA 119:82"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="83" style="v" sid="PSA 119:83"/>Aunque soy como odre en el humo,</para>
  <para style="q" vid="PSA 119:83">No olvido tus Estatutos.<verse eid="PSA 119:83"/></para>
  <para style="q">
    <verse number="84" style="v" sid="PSA 119:84"/>¿Cuántos son los días de tu esclavo?</para>
  <para style="q" vid="PSA 119:84">¿Cuándo juzgarás a los que me persiguen?<verse eid="PSA 119:84"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="85" style="v" sid="PSA 119:85"/>Los arrogantes me cavaron fosa,</para>
  <para style="q" vid="PSA 119:85">Los que no concuerdan con tu Ley.<verse eid="PSA 119:85"/></para>
  <para style="q">
    <verse number="86" style="v" sid="PSA 119:86"/>Todos tus Mandamientos son fieles.</para>
  <para style="q" vid="PSA 119:86">Me persiguen con engaño. Ayúdame.<verse eid="PSA 119:86"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="87" style="v" sid="PSA 119:87"/>Casi me destruyen en la tierra,</para>
  <para style="q" vid="PSA 119:87">Pero yo no abandono tus Preceptos.<verse eid="PSA 119:87"/></para>
  <para style="q">
    <verse number="88" style="v" sid="PSA 119:88"/>Vivifícame según tu misericordia,</para>
  <para style="q" vid="PSA 119:88">Y observaré los Testimonios de tu boca.<verse eid="PSA 119:88"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="89" style="v" sid="PSA 119:89"/>Para siempre, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 119:89">Tu Palabra permanece en el cielo.<verse eid="PSA 119:89"/></para>
  <para style="q">
    <verse number="90" style="v" sid="PSA 119:90"/>Por todas las generaciones es tu fidelidad.</para>
  <para style="q" vid="PSA 119:90">Tú estableciste la tierra, y permanece.<verse eid="PSA 119:90"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="91" style="v" sid="PSA 119:91"/>Por tu mandato subsisten hasta hoy <char style="add">todas las cosas</char>,</para>
  <para style="q" vid="PSA 119:91">Porque todas ellas te sirven como esclavas.<verse eid="PSA 119:91"/></para>
  <para style="q">
    <verse number="92" style="v" sid="PSA 119:92"/>Si tu Ley no fuera mi deleite,</para>
  <para style="q" vid="PSA 119:92">Entonces habría perecido en mi aflicción.<verse eid="PSA 119:92"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="93" style="v" sid="PSA 119:93"/>Jamás olvido tus Preceptos,</para>
  <para style="q" vid="PSA 119:93">Porque con ellos me vivificaste.<verse eid="PSA 119:93"/></para>
  <para style="q">
    <verse number="94" style="v" sid="PSA 119:94"/>Tuyo soy. ¡Sálvame!</para>
  <para style="q" vid="PSA 119:94">Porque busqué tus Preceptos.<verse eid="PSA 119:94"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="95" style="v" sid="PSA 119:95"/>Me esperan los perversos para destruirme.</para>
  <para style="q" vid="PSA 119:95">Pero yo considero tus Testimonios.<verse eid="PSA 119:95"/></para>
  <para style="q">
    <verse number="96" style="v" sid="PSA 119:96"/>En toda perfección he visto límite.</para>
  <para style="q" vid="PSA 119:96">Tu Mandamiento es inmensamente amplio.<verse eid="PSA 119:96"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="97" style="v" sid="PSA 119:97"/>¡Oh, cuánto amo yo tu Ley!</para>
  <para style="q" vid="PSA 119:97">Todo el día es mi meditación.<verse eid="PSA 119:97"/></para>
  <para style="q">
    <verse number="98" style="v" sid="PSA 119:98"/>Tus Mandamientos me hacen más sabio que mis enemigos,</para>
  <para style="q" vid="PSA 119:98">Porque siempre están conmigo.<verse eid="PSA 119:98"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="99" style="v" sid="PSA 119:99"/>Tengo mejor entendimiento que todos mis maestros,</para>
  <para style="q" vid="PSA 119:99">Porque tus Testimonios son mi meditación.<verse eid="PSA 119:99"/></para>
  <para style="q">
    <verse number="100" style="v" sid="PSA 119:100"/>Entiendo más que los ancianos,</para>
  <para style="q" vid="PSA 119:100">Porque observo tus Preceptos.<verse eid="PSA 119:100"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="101" style="v" sid="PSA 119:101"/>De todo mal camino contuve mis pies,</para>
  <para style="q" vid="PSA 119:101">Para observar tu Palabra.<verse eid="PSA 119:101"/></para>
  <para style="q">
    <verse number="102" style="v" sid="PSA 119:102"/>No me aparté de tus Ordenanzas,</para>
  <para style="q" vid="PSA 119:102">Porque Tú mismo me enseñaste.<verse eid="PSA 119:102"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="103" style="v" sid="PSA 119:103"/>¡Cuán dulces son tus Palabras a mi paladar,</para>
  <para style="q" vid="PSA 119:103">Más que miel a mi boca!<verse eid="PSA 119:103"/></para>
  <para style="q">
    <verse number="104" style="v" sid="PSA 119:104"/>De sus Preceptos recibo entendimiento,</para>
  <para style="q" vid="PSA 119:104">Por tanto aborrezco todo camino falso.<verse eid="PSA 119:104"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="105" style="v" sid="PSA 119:105"/>Lámpara a mis pies es tu Palabra,</para>
  <para style="q" vid="PSA 119:105">Y lumbrera a mi camino.<verse eid="PSA 119:105"/></para>
  <para style="q">
    <verse number="106" style="v" sid="PSA 119:106"/>Juré observar tus justas Ordenanzas.</para>
  <para style="q" vid="PSA 119:106">Lo cumpliré</para>
  <para style="q" vid="PSA 119:106">Y lo confirmo:</para>
  <para style="q" vid="PSA 119:106">Guardaré tus justas Ordenanzas.<verse eid="PSA 119:106"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="107" style="v" sid="PSA 119:107"/>Estoy afligido en gran manera.</para>
  <para style="q" vid="PSA 119:107">Oh <char style="nd">Yavé</char>, vivifícame según tu Palabra.<verse eid="PSA 119:107"/></para>
  <para style="q">
    <verse number="108" style="v" sid="PSA 119:108"/>Acepta las ofrendas voluntarias de mi boca, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 119:108">Y enséñame tus Ordenanzas.<verse eid="PSA 119:108"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="109" style="v" sid="PSA 119:109"/>Mi vida está de continuo en peligro,</para>
  <para style="q" vid="PSA 119:109">Pero yo no olvido tu Ley.<verse eid="PSA 119:109"/></para>
  <para style="q">
    <verse number="110" style="v" sid="PSA 119:110"/>Los perversos me tienden una trampa,</para>
  <para style="q" vid="PSA 119:110">Pero yo no me desvío de tus Preceptos.<verse eid="PSA 119:110"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="111" style="v" sid="PSA 119:111"/>Tus Testimonios son mi herencia eterna,</para>
  <para style="q" vid="PSA 119:111">Porque ellos son el gozo de mi corazón.<verse eid="PSA 119:111"/></para>
  <para style="q">
    <verse number="112" style="v" sid="PSA 119:112"/>Incliné mi corazón a cumplir tus Estatutos,</para>
  <para style="q" vid="PSA 119:112">De continuo hasta el fin.<verse eid="PSA 119:112"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="113" style="v" sid="PSA 119:113"/>Aborrezco a los de doble ánimo,</para>
  <para style="q" vid="PSA 119:113">Pero amo tu Ley.<verse eid="PSA 119:113"/></para>
  <para style="q">
    <verse number="114" style="v" sid="PSA 119:114"/>Tú eres mi Refugio y mi Escudo.</para>
  <para style="q" vid="PSA 119:114">Confío en tu Palabra.<verse eid="PSA 119:114"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="115" style="v" sid="PSA 119:115"/>Apártense de mí, perversos,</para>
  <para style="q" vid="PSA 119:115">Para que yo observe los Mandamientos de mi <char style="nd">ʼElohim</char>.<verse eid="PSA 119:115"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="116" style="v" sid="PSA 119:116"/>Susténtame según tu Palabra para que viva</para>
  <para style="q" vid="PSA 119:116">Y no dejes que sea avergonzado de mi esperanza.<verse eid="PSA 119:116"/></para>
  <para style="q">
    <verse number="117" style="v" sid="PSA 119:117"/>Susténtame para que sea salvo,</para>
  <para style="q" vid="PSA 119:117">Para que yo observe de continuo tus Estatutos.<verse eid="PSA 119:117"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="118" style="v" sid="PSA 119:118"/>Rechazas a todos los que se desvían de tus Estatutos,</para>
  <para style="q" vid="PSA 119:118">Porque su astucia es falsedad.<verse eid="PSA 119:118"/></para>
  <para style="q">
    <verse number="119" style="v" sid="PSA 119:119"/>Removiste de la tierra <char style="add">como</char> escoria a todos los perversos.</para>
  <para style="q" vid="PSA 119:119">Por tanto, amo tus Testimonios.<verse eid="PSA 119:119"/></para>
  <para style="q">
    <verse number="120" style="v" sid="PSA 119:120"/>Mi carne se estremece de temor a Ti,</para>
  <para style="q" vid="PSA 119:120">Y ante tus juicios me lleno de pavor.<verse eid="PSA 119:120"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="121" style="v" sid="PSA 119:121"/>Actué con justicia y rectitud.</para>
  <para style="q" vid="PSA 119:121">No me abandones a mis opresores.<verse eid="PSA 119:121"/></para>
  <para style="q">
    <verse number="122" style="v" sid="PSA 119:122"/>Sé garante de tu esclavo para bien,</para>
  <para style="q" vid="PSA 119:122">Que no me opriman los arrogantes.<verse eid="PSA 119:122"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="123" style="v" sid="PSA 119:123"/>Mis ojos desfallecen por tu salvación,</para>
  <para style="q" vid="PSA 119:123">Y por la Palabra de tu justicia.<verse eid="PSA 119:123"/></para>
  <para style="q">
    <verse number="124" style="v" sid="PSA 119:124"/>Haz con tu esclavo según tu misericordia,</para>
  <para style="q" vid="PSA 119:124">Y enséñame tus Estatutos.<verse eid="PSA 119:124"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="125" style="v" sid="PSA 119:125"/>Yo soy tu esclavo.</para>
  <para style="q" vid="PSA 119:125">Dame entendimiento para comprender tus Testimonios.<verse eid="PSA 119:125"/></para>
  <para style="q">
    <verse number="126" style="v" sid="PSA 119:126"/>Es tiempo de actuar, oh <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 119:126">Porque invalidaron tu Ley.<verse eid="PSA 119:126"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="127" style="v" sid="PSA 119:127"/>Por tanto amo tus Mandamientos</para>
  <para style="q" vid="PSA 119:127">Más que el oro, sí, más que el oro fino.<verse eid="PSA 119:127"/></para>
  <para style="q">
    <verse number="128" style="v" sid="PSA 119:128"/>Por tanto estimo rectos todos tus Preceptos</para>
  <para style="q" vid="PSA 119:128">Con respecto a todas las cosas.</para>
  <para style="q" vid="PSA 119:128">Aborrezco todo camino falso.<verse eid="PSA 119:128"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="129" style="v" sid="PSA 119:129"/>¡Maravillosos son tus Testimonios!</para>
  <para style="q" vid="PSA 119:129">Por tanto los observa mi alma.<verse eid="PSA 119:129"/></para>
  <para style="q">
    <verse number="130" style="v" sid="PSA 119:130"/>La exposición de tus Palabras alumbra.</para>
  <para style="q" vid="PSA 119:130">Da entendimiento a los simples.<verse eid="PSA 119:130"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="131" style="v" sid="PSA 119:131"/>Abrí bien mi boca y suspiré,</para>
  <para style="q" vid="PSA 119:131">Porque anhelaba tus Mandamientos.<verse eid="PSA 119:131"/></para>
  <para style="q">
    <verse number="132" style="v" sid="PSA 119:132"/>Mírame y ten misericordia de mí,</para>
  <para style="q" vid="PSA 119:132">Como acostumbras con los que aman tu Nombre.<verse eid="PSA 119:132"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="133" style="v" sid="PSA 119:133"/>Afirma mis pasos con tu Palabra,</para>
  <para style="q" vid="PSA 119:133">Y no permitas que alguna iniquidad me domine.<verse eid="PSA 119:133"/></para>
  <para style="q">
    <verse number="134" style="v" sid="PSA 119:134"/>Líbrame de la violencia de los hombres,</para>
  <para style="q" vid="PSA 119:134">Y observaré tus Mandamientos.<verse eid="PSA 119:134"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="135" style="v" sid="PSA 119:135"/>Haz resplandecer tu rostro sobre tu esclavo,</para>
  <para style="q" vid="PSA 119:135">Y enséñame tus Estatutos.<verse eid="PSA 119:135"/></para>
  <para style="q">
    <verse number="136" style="v" sid="PSA 119:136"/>Manantiales de agua bajarán de mis ojos,</para>
  <para style="q" vid="PSA 119:136">Porque ellos no observan tu Ley.<verse eid="PSA 119:136"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="137" style="v" sid="PSA 119:137"/>Justo eres Tú, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 119:137">Y rectos son tus juicios.<verse eid="PSA 119:137"/></para>
  <para style="q">
    <verse number="138" style="v" sid="PSA 119:138"/>Tus Testimonios nos mandaste con justicia,</para>
  <para style="q" vid="PSA 119:138">Y extraordinaria fidelidad.<verse eid="PSA 119:138"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="139" style="v" sid="PSA 119:139"/>Mi celo me consume,</para>
  <para style="q" vid="PSA 119:139">Porque mis adversarios olvidaron tus Palabras.<verse eid="PSA 119:139"/></para>
  <para style="q">
    <verse number="140" style="v" sid="PSA 119:140"/>Tu Palabra es muy pura,</para>
  <para style="q" vid="PSA 119:140">Por tanto, tu esclavo la ama.<verse eid="PSA 119:140"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="141" style="v" sid="PSA 119:141"/>Soy pequeño y despreciado,</para>
  <para style="q" vid="PSA 119:141">
    <char style="add">Pero</char> no olvido tus Preceptos.<verse eid="PSA 119:141"/></para>
  <para style="q">
    <verse number="142" style="v" sid="PSA 119:142"/>Tu justicia es eterna,</para>
  <para style="q" vid="PSA 119:142">Y tu Ley es verdad.<verse eid="PSA 119:142"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="143" style="v" sid="PSA 119:143"/>La aflicción y la angustia me alcanzaron,</para>
  <para style="q" vid="PSA 119:143">
    <char style="add">Pero</char> tus Mandamientos son mi delicia.<verse eid="PSA 119:143"/></para>
  <para style="q">
    <verse number="144" style="v" sid="PSA 119:144"/>Tus Testimonios son justicia eterna.</para>
  <para style="q" vid="PSA 119:144">Dame entendimiento para que viva.<verse eid="PSA 119:144"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="145" style="v" sid="PSA 119:145"/>Clamo con todo mi corazón.</para>
  <para style="q" vid="PSA 119:145">Respóndeme, oh <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 119:145">Observaré tus Estatutos.<verse eid="PSA 119:145"/></para>
  <para style="q">
    <verse number="146" style="v" sid="PSA 119:146"/>A Ti clamo: ¡Sálvame!</para>
  <para style="q" vid="PSA 119:146">Y observaré tus Testimonios.<verse eid="PSA 119:146"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="147" style="v" sid="PSA 119:147"/>Me levanté antes del alba y clamé.</para>
  <para style="q" vid="PSA 119:147">Espero tu Palabra.<verse eid="PSA 119:147"/></para>
  <para style="q">
    <verse number="148" style="v" sid="PSA 119:148"/>Mis ojos se anticipan a las vigilias de la noche</para>
  <para style="q" vid="PSA 119:148">Para meditar en tu Palabra.<verse eid="PSA 119:148"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="149" style="v" sid="PSA 119:149"/>Oye mi voz según tu misericordia.</para>
  <para style="q" vid="PSA 119:149">Vivifícame, oh <char style="nd">Yavé</char>, según tus Ordenanzas.<verse eid="PSA 119:149"/></para>
  <para style="q">
    <verse number="150" style="v" sid="PSA 119:150"/>Los que siguen la perversidad se acercan.</para>
  <para style="q" vid="PSA 119:150">Están lejos de tu Ley.<verse eid="PSA 119:150"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="151" style="v" sid="PSA 119:151"/>Tú, oh <char style="nd">Yavé</char>, estás cerca,</para>
  <para style="q" vid="PSA 119:151">Y todos tus Mandamientos son verdad.<verse eid="PSA 119:151"/></para>
  <para style="q">
    <verse number="152" style="v" sid="PSA 119:152"/>Desde antaño conocí tus Testimonios,</para>
  <para style="q" vid="PSA 119:152">Que Tú estableciste para siempre.<verse eid="PSA 119:152"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="153" style="v" sid="PSA 119:153"/>Mira mi aflicción y rescátame,</para>
  <para style="q" vid="PSA 119:153">Porque yo no olvido tu Ley.<verse eid="PSA 119:153"/></para>
  <para style="q">
    <verse number="154" style="v" sid="PSA 119:154"/>Defiende mi causa y redímeme,</para>
  <para style="q" vid="PSA 119:154">Vivifícame según tu Palabra.<verse eid="PSA 119:154"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="155" style="v" sid="PSA 119:155"/>Lejos de los perversos está la salvación,</para>
  <para style="q" vid="PSA 119:155">Porque no buscan tus Estatutos.<verse eid="PSA 119:155"/></para>
  <para style="q">
    <verse number="156" style="v" sid="PSA 119:156"/>Oh <char style="nd">Yavé</char>, grandes son tus misericordias.</para>
  <para style="q" vid="PSA 119:156">Vivifícame según tus Ordenanzas.<verse eid="PSA 119:156"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="157" style="v" sid="PSA 119:157"/>Muchos son mis perseguidores y mis adversarios,</para>
  <para style="q" vid="PSA 119:157">
    <char style="add">Pero</char> yo no me aparto de tus Testimonios.<verse eid="PSA 119:157"/></para>
  <para style="q">
    <verse number="158" style="v" sid="PSA 119:158"/>Veo a los traidores y me disgusto,</para>
  <para style="q" vid="PSA 119:158">Porque ellos no observan tu Palabra.<verse eid="PSA 119:158"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="159" style="v" sid="PSA 119:159"/>Considera cuánto amo tus Preceptos.</para>
  <para style="q" vid="PSA 119:159">Vivifícame, oh <char style="nd">Yavé</char>, según tu misericordia.<verse eid="PSA 119:159"/></para>
  <para style="q">
    <verse number="160" style="v" sid="PSA 119:160"/>La suma de tu Palabra es verdad,</para>
  <para style="q" vid="PSA 119:160">Y eterna cada una de tus justas Ordenanzas.<verse eid="PSA 119:160"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="161" style="v" sid="PSA 119:161"/>Príncipes me persiguen sin causa,</para>
  <para style="q" vid="PSA 119:161">Pero mi corazón tiene temor a tus Palabras.<verse eid="PSA 119:161"/></para>
  <para style="q">
    <verse number="162" style="v" sid="PSA 119:162"/>Me regocijo en tu Palabra</para>
  <para style="q" vid="PSA 119:162">Como el que halla gran despojo.<verse eid="PSA 119:162"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="163" style="v" sid="PSA 119:163"/>Aborrezco y repugno la mentira.</para>
  <para style="q" vid="PSA 119:163">Amo tu Ley.<verse eid="PSA 119:163"/></para>
  <para style="q">
    <verse number="164" style="v" sid="PSA 119:164"/>Siete veces al día te alabo</para>
  <para style="q" vid="PSA 119:164">A causa de tus justas Ordenanzas.<verse eid="PSA 119:164"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="165" style="v" sid="PSA 119:165"/>Mucha paz tienen los que aman su Ley,</para>
  <para style="q" vid="PSA 119:165">Y no hay tropiezo para ellos.<verse eid="PSA 119:165"/></para>
  <para style="q">
    <verse number="166" style="v" sid="PSA 119:166"/>Oh <char style="nd">Yavé</char>, espero tu salvación</para>
  <para style="q" vid="PSA 119:166">Y practico tus Mandamientos.<verse eid="PSA 119:166"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="167" style="v" sid="PSA 119:167"/>Mi alma observa tus Testimonios,</para>
  <para style="q" vid="PSA 119:167">Y los ama intensamente.<verse eid="PSA 119:167"/></para>
  <para style="q">
    <verse number="168" style="v" sid="PSA 119:168"/>Observo tus Preceptos y tus Testimonios,</para>
  <para style="q" vid="PSA 119:168">Porque todos mis caminos están delante de Ti.<verse eid="PSA 119:168"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="169" style="v" sid="PSA 119:169"/>Llegue mi clamor ante Ti, oh <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 119:169">Dame entendimiento según tu Palabra.<verse eid="PSA 119:169"/></para>
  <para style="q">
    <verse number="170" style="v" sid="PSA 119:170"/>Llegue mi súplica ante Ti.</para>
  <para style="q" vid="PSA 119:170">Líbrame según tu Palabra.<verse eid="PSA 119:170"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="171" style="v" sid="PSA 119:171"/>Mis labios rebozan alabanza</para>
  <para style="q" vid="PSA 119:171">Cuando Tú me enseñas tus Estatutos.<verse eid="PSA 119:171"/></para>
  <para style="q">
    <verse number="172" style="v" sid="PSA 119:172"/>Hablará mi lengua tu Palabra,</para>
  <para style="q" vid="PSA 119:172">Porque todos tus Mandamientos son justicia.<verse eid="PSA 119:172"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="173" style="v" sid="PSA 119:173"/>Esté tu mano lista para socorrerme,</para>
  <para style="q" vid="PSA 119:173">Porque escogí tus Ordenanzas.<verse eid="PSA 119:173"/></para>
  <para style="q">
    <verse number="174" style="v" sid="PSA 119:174"/>Anhelo tu salvación, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 119:174">Y tu Ley es mi deleite.<verse eid="PSA 119:174"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="175" style="v" sid="PSA 119:175"/>Viva mi alma y te alabe,</para>
  <para style="q" vid="PSA 119:175">Y que me ayuden tus Ordenanzas.<verse eid="PSA 119:175"/></para>
  <para style="q">
    <verse number="176" style="v" sid="PSA 119:176"/>Anduve errante como oveja perdida.</para>
  <para style="q" vid="PSA 119:176">Busca a tu esclavo,</para>
  <para style="q" vid="PSA 119:176">Porque no olvido tus Mandamientos.<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="s1">Canto de ascenso gradual<note caller="+" style="f"><char style="fr" closed="false">120.1 </char><char style="ft" closed="false">Gradual: O de las subidas, o peregrinaciones. Probablemente se cantaban en las subidas anuales a Jerusalén.</char></note></para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 120:1"/>En mi angustia clamé a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 120:1">Y Él me respondió.<verse eid="PSA 120:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 120:2"/>Oh <char style="nd">Yavé</char>, libra mi vida de labios mentirosos,</para>
  <para style="q" vid="PSA 120:2">De una lengua engañadora.<verse eid="PSA 120:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 120:3"/>¿Qué se te dará,</para>
  <para style="q" vid="PSA 120:3">O qué más se te hará,</para>
  <para style="q" vid="PSA 120:3">Oh lengua engañosa?<verse eid="PSA 120:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 120:4"/>Agudas flechas de guerrero,</para>
  <para style="q" vid="PSA 120:4">
    <char style="add">Forjadas</char> con brasas de enebro.<note caller="+" style="f"><char style="fr" closed="false">120.4 </char><char style="ft" closed="false">Enebro: arbusto de madera muy dura.</char></note><verse eid="PSA 120:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 120:5"/>¡Ay de mí, porque vivo desterrado en Mesec,</para>
  <para style="q" vid="PSA 120:5">Y habito entre las tiendas de Cedar!<verse eid="PSA 120:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 120:6"/>Mucho tiempo estuvo mi alma</para>
  <para style="q" vid="PSA 120:6">Con los que aborrecen la paz.<verse eid="PSA 120:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 120:7"/>Yo soy pacífico, pero cuando hablo,</para>
  <para style="q" vid="PSA 120:7">Ellos me declaran la guerra.<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="s1">Canto de ascenso gradual</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 121:1"/>Levantaré mis ojos a las montañas.</para>
  <para style="q" vid="PSA 121:1">¿De dónde vendrá mi socorro?<verse eid="PSA 121:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 121:2"/>Mi socorro <char style="add">viene</char> de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 121:2">Quien hizo <char style="add">el</char> cielo y <char style="add">la</char> tierra.<verse eid="PSA 121:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 121:3"/>No permitirá que tu pie resbale,</para>
  <para style="q" vid="PSA 121:3">Ni se dormirá el que te guarda.<verse eid="PSA 121:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 121:4"/>Ciertamente, no se adormecerá ni dormirá,</para>
  <para style="q" vid="PSA 121:4">El que guarda a Israel.<verse eid="PSA 121:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 121:5"/>
    <char style="nd">Yavé</char> es tu Guardador,</para>
  <para style="q" vid="PSA 121:5">
    <char style="nd">Yavé</char> es tu Sombra a tu mano derecha.<verse eid="PSA 121:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 121:6"/>El sol no te fatigará de día,</para>
  <para style="q" vid="PSA 121:6">Ni la luna de noche.<verse eid="PSA 121:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 121:7"/>
    <char style="nd">Yavé</char> te protegerá de todo mal.</para>
  <para style="q" vid="PSA 121:7">Él guardará tu alma.<verse eid="PSA 121:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 121:8"/>
    <char style="nd">Yavé</char> guardará tu salida y tu entrada</para>
  <para style="q" vid="PSA 121:8">Desde ahora y para siempre.<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="s1">Canto de ascenso gradual de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 122:1"/>Yo me alegraba cuando me decían:</para>
  <para style="q" vid="PSA 122:1">Vayamos a la Casa de <char style="nd">Yavé</char>.<verse eid="PSA 122:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 122:2"/>Nuestros pies están plantados dentro de tus puertas,</para>
  <para style="q" vid="PSA 122:2">Oh Jerusalén.<verse eid="PSA 122:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 122:3"/>Jerusalén está edificada</para>
  <para style="q" vid="PSA 122:3">Como una ciudad compacta,<verse eid="PSA 122:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 122:4"/>Adonde suben las tribus de <char style="nd">YA</char>,</para>
  <para style="q" vid="PSA 122:4">Según una Ordenanza para Israel,</para>
  <para style="q" vid="PSA 122:4">A dar gracias al Nombre de <char style="nd">Yavé</char>,<verse eid="PSA 122:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 122:5"/>Porque allá están establecidos tronos de juicio,</para>
  <para style="q" vid="PSA 122:5">Los tronos de la casa de David.<verse eid="PSA 122:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 122:6"/>Oren por la paz de Jerusalén:</para>
  <para style="q" vid="PSA 122:6">Que prosperen los que te aman,<verse eid="PSA 122:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 122:7"/>Que haya paz dentro de tus muros</para>
  <para style="q" vid="PSA 122:7">Y prosperidad dentro de tus palacios.<verse eid="PSA 122:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 122:8"/>Por amor a mis hermanos y a mis amigos, diré ahora:</para>
  <para style="q" vid="PSA 122:8">Haya paz dentro de ti.<verse eid="PSA 122:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 122:9"/>Por amor a la Casa de <char style="nd">Yavé</char> nuestro <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 122:9">Oraré por tu bien.<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="s1">Canto de ascenso gradual</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 123:1"/>A Ti, que habitas en los cielos, levanto mis ojos,</para>
  <para style="q" vid="PSA 123:1">A Ti que estás entronizado en los cielos.<verse eid="PSA 123:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 123:2"/>Ciertamente como los ojos de los esclavos</para>
  <para style="q" vid="PSA 123:2">
    <char style="add">Miran</char> la mano de su amo,</para>
  <para style="q" vid="PSA 123:2">Y los ojos de la esclava la mano de su ama,</para>
  <para style="q" vid="PSA 123:2">Así nuestros ojos miran a <char style="nd">Yavé</char> nuestro <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 123:2">Hasta que tenga misericordia de nosotros.<verse eid="PSA 123:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 123:3"/>Ten misericordia de nosotros, oh <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 123:3">Ten compasión de nosotros.</para>
  <para style="q" vid="PSA 123:3">Porque estamos saturados de desprecio.<verse eid="PSA 123:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 123:4"/>Saturada está nuestra alma</para>
  <para style="q" vid="PSA 123:4">Con la burla de los que están en holgura,</para>
  <para style="q" vid="PSA 123:4">Y con el desprecio de los arrogantes.<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="s1">Canto gradual de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 124:1"/>Si <char style="nd">Yavé</char> no estuviera a favor de nosotros,</para>
  <para style="q" vid="PSA 124:1">Que <char style="add">lo</char> diga ahora Israel:<verse eid="PSA 124:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 124:2"/>Si <char style="nd">Yavé</char> no estuviera a favor de nosotros</para>
  <para style="q" vid="PSA 124:2">Cuando los hombres se levantaron contra nosotros,<verse eid="PSA 124:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 124:3"/>Entonces nos habrían tragado vivos,</para>
  <para style="q" vid="PSA 124:3">Cuando el furor de ellos se encendió contra nosotros.<verse eid="PSA 124:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 124:4"/>Entonces nos habrían anegado las aguas,</para>
  <para style="q" vid="PSA 124:4">Y el torrente hubiera pasado a nuestra alma.<verse eid="PSA 124:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 124:5"/>Entonces el torrente nos habría inundado.</para>
  <para style="q" vid="PSA 124:5">Sobre nuestras vidas habrían pasado las aguas impetuosas.<verse eid="PSA 124:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 124:6"/>Bendito sea <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 124:6">Quien no nos entregó como presa de los dientes de ellos.<verse eid="PSA 124:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 124:7"/>Como un ave que escapa de la trampa del cazador,</para>
  <para style="q" vid="PSA 124:7">Así escapó nuestra alma.</para>
  <para style="q" vid="PSA 124:7">¡La trampa se rompió,</para>
  <para style="q" vid="PSA 124:7">Y nosotros escapamos!<verse eid="PSA 124:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 124:8"/>Nuestro socorro está en el Nombre de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 124:8">Quien hizo el cielo y la tierra.<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="s1">Canto de ascenso gradual</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 125:1"/>Los que confían en <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 125:1">Son como la Montaña Sion,</para>
  <para style="q" vid="PSA 125:1">Que no se mueve, sino permanece para siempre.<verse eid="PSA 125:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 125:2"/>Como Jerusalén tiene montañas alrededor de ella,</para>
  <para style="q" vid="PSA 125:2">Así <char style="nd">Yavé</char> está alrededor de su pueblo</para>
  <para style="q" vid="PSA 125:2">Desde ahora y para siempre.<verse eid="PSA 125:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 125:3"/>Porque no reposará el cetro de la perversidad</para>
  <para style="q" vid="PSA 125:3">Sobre la heredad de los justos,</para>
  <para style="q" vid="PSA 125:3">Para que los justos no extiendan sus manos a la iniquidad.<verse eid="PSA 125:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 125:4"/>Oh <char style="nd">Yavé</char>, concede bien a los buenos</para>
  <para style="q" vid="PSA 125:4">Y a los que son rectos en su corazón.<verse eid="PSA 125:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 125:5"/>Pero a los que se apartan a sus caminos torcidos,</para>
  <para style="q" vid="PSA 125:5">
    <char style="nd">Yavé</char> los llevará con los que hacen iniquidad.</para>
  <para style="b" vid="PSA 125:5"/>
  <para style="q" vid="PSA 125:5">¡Paz sea sobre Israel!<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="s1">Canto de ascenso gradual</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 126:1"/>Cuando <char style="nd">Yavé</char> devuelva a los cautivos de Sion,</para>
  <para style="q" vid="PSA 126:1">Seremos como los que sueñan.<verse eid="PSA 126:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 126:2"/>Entonces nuestras bocas se llenarán de risa,</para>
  <para style="q" vid="PSA 126:2">Y nuestras lenguas de alabanza.</para>
  <para style="b" vid="PSA 126:2"/>
  <para style="q" vid="PSA 126:2">Entonces dirán entre las naciones:</para>
  <para style="q" vid="PSA 126:2">¡Grandes cosas hizo <char style="nd">Yavé</char> por éstos!<verse eid="PSA 126:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 126:3"/>¡<char style="nd">Yavé</char> hizo grandes cosas por nosotros!</para>
  <para style="q" vid="PSA 126:3">¡Estamos alegres!<verse eid="PSA 126:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 126:4"/>Devuelve a nuestros cautivos, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 126:4">Como los torrentes en el Neguev.<verse eid="PSA 126:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 126:5"/>Los que siembran con lágrimas</para>
  <para style="q" vid="PSA 126:5">Con regocijo segarán.<verse eid="PSA 126:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 126:6"/>El que va de un lado a otro llorando</para>
  <para style="q" vid="PSA 126:6">Y lleva el saco de semilla,</para>
  <para style="q" vid="PSA 126:6">Ciertamente volverá con regocijo</para>
  <para style="q" vid="PSA 126:6">Y traerá sus manojos.<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="s1">Canto de ascenso gradual de Salomón</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 127:1"/>Si <char style="nd">Yavé</char> no edifica la casa,</para>
  <para style="q" vid="PSA 127:1">En vano trabajan los que la edifican.</para>
  <para style="q" vid="PSA 127:1">Si <char style="nd">Yavé</char> no guarda la ciudad,</para>
  <para style="q" vid="PSA 127:1">En vano vela el vigilante.<verse eid="PSA 127:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 127:2"/>En vano ustedes se levantan de madrugada,</para>
  <para style="q" vid="PSA 127:2">Se van tarde a descansar,</para>
  <para style="q" vid="PSA 127:2">Y comen el pan de dolorosos trabajos,</para>
  <para style="q" vid="PSA 127:2">Porque Él da el sueño a sus amados.<verse eid="PSA 127:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 127:3"/>Ciertamente herencia de <char style="nd">Yavé</char> son los hijos.</para>
  <para style="q" vid="PSA 127:3">El fruto del vientre es una recompensa.<verse eid="PSA 127:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 127:4"/>Como flechas en la mano del guerrero,</para>
  <para style="q" vid="PSA 127:4">Así son los hijos que llegan en la juventud.<verse eid="PSA 127:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 127:5"/>Inmensamente feliz es el varón</para>
  <para style="q" vid="PSA 127:5">Que llena su caja portátil de flechas con ellos.</para>
  <para style="q" vid="PSA 127:5">No será avergonzado</para>
  <para style="q" vid="PSA 127:5">Cuando hablen con sus enemigos en la puerta.<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="s1">Canto de ascenso gradual</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 128:1"/>Inmensamente feliz es todo el que teme a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 128:1">Quien anda en sus caminos.<verse eid="PSA 128:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 128:2"/>Cuando tú comas del fruto de tus manos</para>
  <para style="q" vid="PSA 128:2">Serás inmensamente feliz y saldrás bien.<verse eid="PSA 128:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 128:3"/>Tu esposa será como vid fructífera dentro de tu casa,</para>
  <para style="q" vid="PSA 128:3">Tus hijos, como retoños de olivo alrededor de tu mesa.<verse eid="PSA 128:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 128:4"/>Ciertamente así será bendecido el hombre</para>
  <para style="q" vid="PSA 128:4">Que teme a <char style="nd">Yavé</char>.<verse eid="PSA 128:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 128:5"/>Desde Sion te bendiga <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 128:5">Y que veas la prosperidad de Jerusalén todos los días de tu vida,<verse eid="PSA 128:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 128:6"/>Que en verdad veas tus nietos.</para>
  <para style="b" vid="PSA 128:6"/>
  <para style="q" vid="PSA 128:6">Paz sea sobre Israel.<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="s1">Canto de ascenso gradual</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 129:1"/>Muchas veces me persiguieron desde mi juventud.</para>
  <para style="q" vid="PSA 129:1">Que <char style="add">lo</char> diga ahora Israel:<verse eid="PSA 129:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 129:2"/>Muchas veces me persiguieron desde mi juventud,</para>
  <para style="q" vid="PSA 129:2">Pero no prevalecieron contra mí.<verse eid="PSA 129:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 129:3"/>Los aradores araron sobre mi espalda.</para>
  <para style="q" vid="PSA 129:3">Hicieron largos surcos.<verse eid="PSA 129:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 129:4"/>
    <char style="nd">Yavé</char> es justo,</para>
  <para style="q" vid="PSA 129:4">Cortó las cuerdas de los perversos.<verse eid="PSA 129:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 129:5"/>Sean avergonzados y vueltos atrás</para>
  <para style="q" vid="PSA 129:5">Todos los que aborrecen a Sion.<verse eid="PSA 129:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 129:6"/>Sean como <char style="add">la</char> hierba de las azoteas</para>
  <para style="q" vid="PSA 129:6">Que se marchita antes de crecer,<verse eid="PSA 129:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 129:7"/>Con la cual el cosechero no llena su mano,</para>
  <para style="q" vid="PSA 129:7">Ni el regazo el que ata manojos.<verse eid="PSA 129:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 129:8"/>Ni le dicen los que pasan:</para>
  <para style="q" vid="PSA 129:8">La bendición de <char style="nd">Yavé</char> sea sobre ustedes,</para>
  <para style="q" vid="PSA 129:8">Los bendecimos en el Nombre de <char style="nd">Yavé</char>.<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="s1">Canto de ascenso gradual</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 130:1"/>Oh <char style="nd">Yavé</char>, de lo profundo de mi ser clamo a Ti.<verse eid="PSA 130:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 130:2"/>¡Oh <char style="nd">ʼAdonay</char>, escucha mi voz!</para>
  <para style="q" vid="PSA 130:2">Estén atentos tus oídos</para>
  <para style="q" vid="PSA 130:2">A la voz de mis súplicas.<verse eid="PSA 130:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 130:3"/>Si Tú, <char style="nd">YA</char>, tomas en cuenta las iniquidades,</para>
  <para style="q" vid="PSA 130:3">¿Quién, oh <char style="nd">ʼAdonay</char>, puede mantenerse en pie?<verse eid="PSA 130:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 130:4"/>Pero en Ti hay perdón</para>
  <para style="q" vid="PSA 130:4">Para que seas reverenciado.<verse eid="PSA 130:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 130:5"/>Espero a <char style="nd">Yavé</char>. Mi alma espera.</para>
  <para style="q" vid="PSA 130:5">En tu Palabra fijo mi esperanza.<verse eid="PSA 130:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 130:6"/>Más que los centinelas a la mañana,</para>
  <para style="q" vid="PSA 130:6">Mi alma espera a <char style="nd">ʼAdonay</char>.</para>
  <para style="q" vid="PSA 130:6">¡<char style="add">Sí</char>, más que los centinelas la mañana!<verse eid="PSA 130:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 130:7"/>Oh Israel, espera a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 130:7">Porque en <char style="nd">Yavé</char> hay misericordia,</para>
  <para style="q" vid="PSA 130:7">Y en Él hay gran redención.<verse eid="PSA 130:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 130:8"/>Él redimirá a Israel de todas sus iniquidades.<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="s1">Canto de ascenso gradual de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 131:1"/>Oh <char style="nd">Yavé</char>, no se envaneció mi corazón,</para>
  <para style="q" vid="PSA 131:1">Ni mis ojos se enaltecieron,</para>
  <para style="q" vid="PSA 131:1">Ni anduve tras grandezas,</para>
  <para style="q" vid="PSA 131:1">Ni en cosas demasiado difíciles para mí.<verse eid="PSA 131:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 131:2"/>Ciertamente calmé y tranquilicé mi alma,</para>
  <para style="q" vid="PSA 131:2">Como un bebé destetado de su madre.</para>
  <para style="q" vid="PSA 131:2">Como un bebé destetado está mi alma dentro de mí.<verse eid="PSA 131:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 131:3"/>Espera, oh Israel, a <char style="nd">Yavé</char></para>
  <para style="q" vid="PSA 131:3">Desde ahora y para siempre.<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="s1">Canto de ascenso gradual</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 132:1"/>Acuérdate, oh <char style="nd">Yavé,</char> de David,</para>
  <para style="q" vid="PSA 132:1">Y de toda su aflicción.<verse eid="PSA 132:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 132:2"/>De cómo juró a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 132:2">Y prometió al Fuerte de Jacob:<verse eid="PSA 132:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 132:3"/>Ciertamente no entraré en mi tienda,</para>
  <para style="q" vid="PSA 132:3">Ni subiré a mi cama.<verse eid="PSA 132:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 132:4"/>No concederé sueño a mis ojos,</para>
  <para style="q" vid="PSA 132:4">Ni a mis párpados calma,<verse eid="PSA 132:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 132:5"/>Hasta que halle lugar para <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 132:5">Tabernáculo para el Fuerte de Jacob.<verse eid="PSA 132:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 132:6"/>Ciertamente oímos de ello en Efrata.</para>
  <para style="q" vid="PSA 132:6">Lo hallamos en el campo del bosque.<verse eid="PSA 132:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 132:7"/>Entremos en su Tabernáculo,</para>
  <para style="q" vid="PSA 132:7">Postrémonos ante el estrado de sus pies.<verse eid="PSA 132:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 132:8"/>Oh <char style="nd">Yavé</char>, levántate <char style="add">y ven</char> al lugar de tu reposo,</para>
  <para style="q" vid="PSA 132:8">Tú y el Arca de tu poder.<verse eid="PSA 132:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 132:9"/>Que tus sacerdotes se vistan de justicia,</para>
  <para style="q" vid="PSA 132:9">Y se regocijen tus santos.<verse eid="PSA 132:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 132:10"/>Por amor a David tu esclavo,</para>
  <para style="q" vid="PSA 132:10">No vuelvas el rostro de tu ungido.<verse eid="PSA 132:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 132:11"/>En verdad <char style="nd">Yavé</char> juró a David,</para>
  <para style="q" vid="PSA 132:11">Y no se retractará de ello:</para>
  <para style="q" vid="PSA 132:11">
    <char style="wj">De tu descendencia sentaré en tu trono.</char><verse eid="PSA 132:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 132:12"/>
    <char style="wj">Si tus hijos observan mi Pacto,</char></para>
  <para style="q" vid="PSA 132:12">
    <char style="wj">Y mi testimonio que Yo les enseño,</char></para>
  <para style="q" vid="PSA 132:12">
    <char style="wj">Tus hijos también se sentarán en tu trono para siempre.</char><verse eid="PSA 132:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 132:13"/>
    <char style="wj">Porque <char style="nd">Yavé</char> escogió a Sion.</char></para>
  <para style="q" vid="PSA 132:13">
    <char style="wj">La deseó para morada suya: </char><verse eid="PSA 132:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 132:14"/>
    <char style="wj">Este es el lugar de mi reposo para siempre.</char></para>
  <para style="q" vid="PSA 132:14">
    <char style="wj">Aquí moraré, porque lo deseé.</char><verse eid="PSA 132:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 132:15"/>
    <char style="wj">Con abundancia bendeciré su provisión,</char></para>
  <para style="q" vid="PSA 132:15">
    <char style="wj">Y saciaré de pan a sus necesitados.</char><verse eid="PSA 132:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 132:16"/>
    <char style="wj">Vestiré con salvación a sus sacerdotes,</char></para>
  <para style="q" vid="PSA 132:16">
    <char style="wj">Y sus santos darán voces de júbilo.</char><verse eid="PSA 132:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 132:17"/>
    <char style="wj">Allí retoñará el poder de David.</char></para>
  <para style="q" vid="PSA 132:17">
    <char style="wj">Dispuse una lámpara para mi ungido.</char><verse eid="PSA 132:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 132:18"/>
    <char style="wj">A sus enemigos vestiré de vergüenza,</char></para>
  <para style="q" vid="PSA 132:18">
    <char style="wj">Pero sobre él resplandecerá su corona.</char><verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="s1">Canto de ascenso gradual de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 133:1"/>¡Miren cuán bueno y cuán agradable es</para>
  <para style="q" vid="PSA 133:1">Que los hermanos vivan juntos en unidad!<verse eid="PSA 133:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 133:2"/>Es como el buen aceite sobre la cabeza</para>
  <para style="q" vid="PSA 133:2">Que baja sobre la barba,</para>
  <para style="q" vid="PSA 133:2">La barba de Aarón,</para>
  <para style="q" vid="PSA 133:2">Y baja hasta el borde de sus ropas.<verse eid="PSA 133:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 133:3"/>Como el rocío de la montaña Hermón,</para>
  <para style="q" vid="PSA 133:3">Que baja sobre las montañas de Sion,</para>
  <para style="q" vid="PSA 133:3">Porque allá <char style="nd">Yavé</char> envía bendición: vida eterna.<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="s1">Canto de ascenso gradual</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 134:1"/>Miren, bendigan a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 134:1">Ustedes, todos los esclavos de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 134:1">Los que sirven de noche en la Casa de <char style="nd">Yavé</char>.<verse eid="PSA 134:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 134:2"/>Levanten sus manos hacia el Santuario,</para>
  <para style="q" vid="PSA 134:2">Y bendigan a <char style="nd">Yavé</char>.<verse eid="PSA 134:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 134:3"/>Que <char style="nd">Yavé</char>, el que hizo el cielo y la tierra,</para>
  <para style="q" vid="PSA 134:3">Te bendiga desde Sion.<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="s1">¡Aleluya!</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 135:1"/>Alaben el Nombre de <char style="nd">Yavé</char>.</para>
  <para style="b" vid="PSA 135:1"/>
  <para style="q" vid="PSA 135:1">Alábenlo, esclavos de <char style="nd">Yavé</char>,<verse eid="PSA 135:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 135:2"/>Ustedes quienes están en la Casa de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 135:2">En los patios de la Casa de nuestro <char style="nd">ʼElohim</char>.<verse eid="PSA 135:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 135:3"/>¡Aleluya, porque <char style="nd">Yavé</char> es bueno!</para>
  <para style="q" vid="PSA 135:3">Canten salmos a su Nombre,</para>
  <para style="q" vid="PSA 135:3">Porque <char style="add">eso</char> es agradable.<verse eid="PSA 135:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 135:4"/>Porque <char style="nd">YA</char> escogió a Jacob para Él,</para>
  <para style="q" vid="PSA 135:4">A Israel como su posesión.<verse eid="PSA 135:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 135:5"/>Porque yo sé que <char style="nd">Yavé</char> es grande,</para>
  <para style="q" vid="PSA 135:5">Y que nuestro <char style="nd">ʼAdonay</char> está por encima de todos los <char style="tl">ʼelohim</char>.<verse eid="PSA 135:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 135:6"/>
    <char style="nd">Yavé</char> hace todo lo que quiere,</para>
  <para style="q" vid="PSA 135:6">Tanto en el cielo como en la tierra,</para>
  <para style="q" vid="PSA 135:6">En los mares y en todos los abismos.<verse eid="PSA 135:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 135:7"/>Él impulsa</para>
  <para style="q" vid="PSA 135:7">Para que las nieblas suban desde los confines de la tierra.</para>
  <para style="q" vid="PSA 135:7">Produce relámpagos para la lluvia,</para>
  <para style="q" vid="PSA 135:7">Saca de sus tesoros el viento.<verse eid="PSA 135:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 135:8"/>Él fue el que mató a los primogénitos de Egipto,</para>
  <para style="q" vid="PSA 135:8">Tanto del hombre como del animal.<verse eid="PSA 135:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 135:9"/>En medio de Ti, oh Egipto, envió señales y prodigios,</para>
  <para style="q" vid="PSA 135:9">Contra Faraón y todos sus esclavos.<verse eid="PSA 135:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 135:10"/>Destruyó a muchas naciones,</para>
  <para style="q" vid="PSA 135:10">Y mató a reyes poderosos:<verse eid="PSA 135:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 135:11"/>A Sehón rey de los amorreos,</para>
  <para style="q" vid="PSA 135:11">A Og rey de Basán,</para>
  <para style="q" vid="PSA 135:11">Y a todos los reyes de Canaán.<verse eid="PSA 135:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 135:12"/>Dio la tierra de ellos</para>
  <para style="q" vid="PSA 135:12">Como heredad a su pueblo Israel.<verse eid="PSA 135:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 135:13"/>Oh <char style="nd">Yavé</char>, eterno es tu Nombre.</para>
  <para style="q" vid="PSA 135:13">Tu memoria, oh <char style="nd">Yavé</char>, por todas las generaciones.<verse eid="PSA 135:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 135:14"/>Porque <char style="nd">Yavé</char> juzgará a su pueblo</para>
  <para style="q" vid="PSA 135:14">Y tendrá compasión de sus esclavos.<verse eid="PSA 135:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 135:15"/>Los ídolos de las naciones son <char style="add">de</char> plata y oro,</para>
  <para style="q" vid="PSA 135:15">Obra de manos de hombre.<verse eid="PSA 135:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 135:16"/>Tienen bocas, pero no hablan.</para>
  <para style="q" vid="PSA 135:16">Tienen ojos, pero no ven.<verse eid="PSA 135:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 135:17"/>Tienen orejas, pero no oyen,</para>
  <para style="q" vid="PSA 135:17">Tampoco hay aliento en sus bocas.<verse eid="PSA 135:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 135:18"/>Los que las hacen son semejantes a ellos,</para>
  <para style="q" vid="PSA 135:18">Y todo el que confía en ellos.<verse eid="PSA 135:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 135:19"/>¡Oh casa de Israel, bendiga a <char style="nd">Yavé</char>!</para>
  <para style="q" vid="PSA 135:19">¡Oh casa de Aarón, bendiga a <char style="nd">Yavé</char>!<verse eid="PSA 135:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 135:20"/>¡Oh casa de Leví, bendiga a <char style="nd">Yavé</char>!</para>
  <para style="q" vid="PSA 135:20">¡Los que temen a <char style="nd">Yavé</char>, bendigan a <char style="nd">Yavé</char>!<verse eid="PSA 135:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 135:21"/>¡Desde Sion, bendito sea <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 135:21">Quien mora en Jerusalén!</para>
  <para style="b" vid="PSA 135:21"/>
  <para style="q" vid="PSA 135:21">¡Aleluya!<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 136:1"/>Den gracias a <char style="nd">Yavé</char> porque Él es bueno,</para>
  <para style="q" vid="PSA 136:1">Porque para siempre es su misericordia.<verse eid="PSA 136:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 136:2"/>Den gracias al <char style="nd">ʼElohim</char> de los <char style="tl">ʼelohim</char>,</para>
  <para style="q" vid="PSA 136:2">Porque para siempre es su misericordia.<verse eid="PSA 136:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 136:3"/>Den gracias al <char style="nd">ʼAdón</char> de los <char style="tl">ʼadón</char>,</para>
  <para style="q" vid="PSA 136:3">Porque para siempre es su misericordia.<verse eid="PSA 136:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 136:4"/>Al único que hace grandes maravillas,</para>
  <para style="q" vid="PSA 136:4">Porque para siempre es su misericordia.<verse eid="PSA 136:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 136:5"/>Al que hizo los cielos con entendimiento,</para>
  <para style="q" vid="PSA 136:5">Porque para siempre es su misericordia.<verse eid="PSA 136:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 136:6"/>Al que afirmó la tierra sobre las aguas,</para>
  <para style="q" vid="PSA 136:6">Porque para siempre es su misericordia.<verse eid="PSA 136:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 136:7"/>Al que hizo grandes luminarias,</para>
  <para style="q" vid="PSA 136:7">Porque para siempre es su misericordia.<verse eid="PSA 136:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 136:8"/>El sol para que domine de día,</para>
  <para style="q" vid="PSA 136:8">Porque para siempre es su misericordia.<verse eid="PSA 136:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 136:9"/>La luna y las estrellas para que dominen de noche,</para>
  <para style="q" vid="PSA 136:9">Porque para siempre es su misericordia.<verse eid="PSA 136:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 136:10"/>Al que mató a los primogénitos de Egipto,</para>
  <para style="q" vid="PSA 136:10">Porque para siempre es su misericordia.<verse eid="PSA 136:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 136:11"/>Y sacó a Israel de en medio de ellos,</para>
  <para style="q" vid="PSA 136:11">Porque para siempre es su misericordia.<verse eid="PSA 136:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 136:12"/>Con mano fuerte y brazo extendido,</para>
  <para style="q" vid="PSA 136:12">Porque para siempre es su misericordia.<verse eid="PSA 136:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 136:13"/>Al que dividió el mar Rojo en dos,</para>
  <para style="q" vid="PSA 136:13">Porque para siempre es su misericordia.<verse eid="PSA 136:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 136:14"/>Y pasó a Israel por el medio,</para>
  <para style="q" vid="PSA 136:14">Porque para siempre es su misericordia.<verse eid="PSA 136:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 136:15"/>Echó a Faraón y a su ejército en el mar Rojo,</para>
  <para style="q" vid="PSA 136:15">Porque para siempre es su misericordia.<verse eid="PSA 136:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 136:16"/>Al que condujo a su pueblo por el desierto,</para>
  <para style="q" vid="PSA 136:16">Porque para siempre es su misericordia.<verse eid="PSA 136:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 136:17"/>Al que mató a grandes reyes,</para>
  <para style="q" vid="PSA 136:17">Porque para siempre es su misericordia.<verse eid="PSA 136:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 136:18"/>Y mató a reyes poderosos,</para>
  <para style="q" vid="PSA 136:18">Porque para siempre es su misericordia.<verse eid="PSA 136:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 136:19"/>A Sehón, rey de los amorreos,</para>
  <para style="q" vid="PSA 136:19">Porque para siempre es su misericordia.<verse eid="PSA 136:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 136:20"/>Y a Og, rey de Basán,</para>
  <para style="q" vid="PSA 136:20">Porque para siempre es su misericordia.<verse eid="PSA 136:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 136:21"/>Y dio la tierra de ellos como heredad,</para>
  <para style="q" vid="PSA 136:21">Porque para siempre es su misericordia.<verse eid="PSA 136:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 136:22"/>Como heredad a Israel su esclavo,</para>
  <para style="q" vid="PSA 136:22">Porque para siempre es su misericordia.<verse eid="PSA 136:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 136:23"/>Al que en nuestro abatimiento se acordó de nosotros,</para>
  <para style="q" vid="PSA 136:23">Porque para siempre es su misericordia.<verse eid="PSA 136:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 136:24"/>Y nos rescató de nuestros adversarios,</para>
  <para style="q" vid="PSA 136:24">Porque para siempre es su misericordia.<verse eid="PSA 136:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 136:25"/>Al que da alimento a toda criatura,</para>
  <para style="q" vid="PSA 136:25">Porque para siempre es su misericordia.<verse eid="PSA 136:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PSA 136:26"/>Den gracias al <char style="nd">ʼEL</char> del cielo,</para>
  <para style="q" vid="PSA 136:26">¡Porque para siempre es su misericordia!<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 137:1"/>Junto a los ríos de Babilonia nos sentábamos y llorábamos</para>
  <para style="q" vid="PSA 137:1">Cuando recordábamos a Sion.</para>
  <para style="q" vid="PSA 137:1">Sobre los sauces, en medio de ella,<verse eid="PSA 137:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 137:2"/>Colgábamos nuestras arpas.<verse eid="PSA 137:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 137:3"/>Porque allí nuestros cautivadores nos pedían cantos,</para>
  <para style="q" vid="PSA 137:3">Y nuestros atormentadores, alegría:</para>
  <para style="q" vid="PSA 137:3">¡Cántennos alguno de los cantos de Sion!<verse eid="PSA 137:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 137:4"/>¿Cómo podemos cantar el canto de <char style="nd">Yavé</char> en tierra extranjera?<verse eid="PSA 137:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 137:5"/>Si me olvido de Ti, oh Jerusalén,</para>
  <para style="q" vid="PSA 137:5">Que mi mano derecha pierda su destreza.<verse eid="PSA 137:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 137:6"/>Que mi lengua se pegue a mi paladar</para>
  <para style="q" vid="PSA 137:6">Si no te recuerdo,</para>
  <para style="q" vid="PSA 137:6">Si no exalto a Jerusalén por encima de mi mayor gozo.<verse eid="PSA 137:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 137:7"/>Recuerda, oh <char style="nd">Yavé</char>, contra los hijos de Edom</para>
  <para style="q" vid="PSA 137:7">El día de Jerusalén, quienes dijeron: Arrásenla.</para>
  <para style="q" vid="PSA 137:7">Arrásenla, arrásenla hasta sus mismos cimientos<verse eid="PSA 137:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 137:8"/>Oh hija de Babilonia, la devastadora.</para>
  <para style="q" vid="PSA 137:8">¡Dichoso el que te pague</para>
  <para style="q" vid="PSA 137:8">Por el mal que nos hiciste!<verse eid="PSA 137:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 137:9"/>¡Dichoso el que agarre a tus pequeños</para>
  <para style="q" vid="PSA 137:9">Y los estrelle contra la peña!<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="s1">Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 138:1"/>Oh <char style="nd">Yavé</char>, te doy gracias con todo mi corazón.</para>
  <para style="q" vid="PSA 138:1">Te cantaré alabanzas delante de los <char style="tl">ʼelohim</char>.<verse eid="PSA 138:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 138:2"/>Me postraré hacia tu santo Templo</para>
  <para style="q" vid="PSA 138:2">Y daré gracias a tu Nombre por tu misericordia y tu verdad,</para>
  <para style="q" vid="PSA 138:2">Porque engrandeciste tu Palabra por encima de todo tu Nombre.<verse eid="PSA 138:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 138:3"/>El día cuando invoqué,</para>
  <para style="q" vid="PSA 138:3">Tú me respondiste.</para>
  <para style="q" vid="PSA 138:3">Me volviste atrevido con fortaleza en mi alma.<verse eid="PSA 138:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 138:4"/>Todos los reyes de la tierra te darán gracias, oh <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 138:4">Cuando oigan las Palabras de tu boca.<verse eid="PSA 138:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 138:5"/>Y cantarán de los caminos de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 138:5">¡Porque grande es la gloria de <char style="nd">Yavé</char>!<verse eid="PSA 138:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 138:6"/>Porque aunque <char style="nd">Yavé</char> es exaltado,</para>
  <para style="q" vid="PSA 138:6">Sin embargo, atiende al humilde,</para>
  <para style="q" vid="PSA 138:6">Pero al altivo conoce de lejos.<verse eid="PSA 138:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 138:7"/>Aunque yo ande en medio de la aflicción,</para>
  <para style="q" vid="PSA 138:7">Tú me vivificarás.</para>
  <para style="q" vid="PSA 138:7">Extenderás tu mano contra la ira de mis enemigos,</para>
  <para style="q" vid="PSA 138:7">Y me salvará tu mano derecha.<verse eid="PSA 138:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 138:8"/>
    <char style="nd">Yavé</char> hará lo que concierne a mí.</para>
  <para style="q" vid="PSA 138:8">Oh <char style="nd">Yavé</char>, tu misericordia es para siempre,</para>
  <para style="q" vid="PSA 138:8">No desampares la obra de tus manos.<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="s1">Al director del coro. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 139:1"/>Oh <char style="nd">Yavé</char>, Tú me escudriñaste y conociste.<verse eid="PSA 139:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 139:2"/>Tú sabes cuándo me siento</para>
  <para style="q" vid="PSA 139:2">Y cuándo me pongo en pie,</para>
  <para style="q" vid="PSA 139:2">De lejos entiendes mi pensamiento.<verse eid="PSA 139:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 139:3"/>Vigilas cuando camino</para>
  <para style="q" vid="PSA 139:3">Y cuando reposo,</para>
  <para style="q" vid="PSA 139:3">Y estás íntimamente familiarizado con todos mis caminos.<verse eid="PSA 139:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 139:4"/>Aun antes que haya una palabra en mi lengua,</para>
  <para style="q" vid="PSA 139:4">Ciertamente, oh <char style="nd">Yavé</char>, Tú la sabes toda.<verse eid="PSA 139:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 139:5"/>Me rodeaste por detrás y por delante,</para>
  <para style="q" vid="PSA 139:5">Y pusiste tu mano sobre mí.<verse eid="PSA 139:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 139:6"/>
    <char style="add">Tal</char> conocimiento es demasiado maravilloso para mí.</para>
  <para style="q" vid="PSA 139:6">Alto es, no puedo alcanzarlo.<verse eid="PSA 139:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 139:7"/>¿A dónde puedo irme de tu Espíritu?</para>
  <para style="q" vid="PSA 139:7">¿O a dónde puedo huir de tu Presencia?<verse eid="PSA 139:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 139:8"/>Si subo al cielo, allí estás Tú,</para>
  <para style="q" vid="PSA 139:8">Y si en el <char style="tl">Seol</char> preparo mi cama,</para>
  <para style="q" vid="PSA 139:8">Mira, allí estás Tú.<verse eid="PSA 139:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 139:9"/>Si tomo las alas del alba</para>
  <para style="q" vid="PSA 139:9">Y vivo en la parte más remota del mar,<verse eid="PSA 139:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 139:10"/>Aun allí me guiará tu mano</para>
  <para style="q" vid="PSA 139:10">Y me sostendrá tu mano derecha.<verse eid="PSA 139:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 139:11"/>Si digo: Ciertamente la oscuridad me cubrirá,</para>
  <para style="q" vid="PSA 139:11">La luz a mi alrededor será la noche.<verse eid="PSA 139:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 139:12"/>Aun la oscuridad no es oscura para Ti,</para>
  <para style="q" vid="PSA 139:12">La noche resplandece como el día.</para>
  <para style="q" vid="PSA 139:12">Lo mismo son la oscuridad y la luz.<verse eid="PSA 139:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 139:13"/>Tú formaste mis órganos internos.</para>
  <para style="q" vid="PSA 139:13">Me tejiste en el vientre de mi madre.<verse eid="PSA 139:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 139:14"/>Te doy gracias,</para>
  <para style="q" vid="PSA 139:14">Porque soy temerosa y maravillosamente formado.</para>
  <para style="q" vid="PSA 139:14">Maravillosas son tus obras,</para>
  <para style="q" vid="PSA 139:14">Y mi alma lo sabe muy bien.<verse eid="PSA 139:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 139:15"/>No fueron encubiertos de Ti mis huesos,</para>
  <para style="q" vid="PSA 139:15">Cuando en secreto fui hecho,</para>
  <para style="q" vid="PSA 139:15">Y entretejido en las profundidades de la tierra.<verse eid="PSA 139:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 139:16"/>Tus ojos vieron mi embrión,</para>
  <para style="q" vid="PSA 139:16">Y en tu rollo estaban escritos todos</para>
  <para style="q" vid="PSA 139:16">Los días que me fueron ordenados,</para>
  <para style="q" vid="PSA 139:16">Cuando aún <char style="add">no existía</char> uno de ellos.<verse eid="PSA 139:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 139:17"/>¡Oh <char style="nd">ʼEL,</char> cuán preciosos me son tus pensamientos!</para>
  <para style="q" vid="PSA 139:17">¡Cuán inmensa es la suma de ellos!<verse eid="PSA 139:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 139:18"/>Si los cuento, serían más que la arena.</para>
  <para style="q" vid="PSA 139:18">Cuando despierto, aún estoy contigo.<verse eid="PSA 139:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 139:19"/>¡Oh <char style="nd">ʼEloah</char>, si mataras al perverso,</para>
  <para style="q" vid="PSA 139:19">Si, por tanto, se alejan de mí los hombres sanguinarios!<verse eid="PSA 139:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 139:20"/>Porque hablan contra Ti perversamente,</para>
  <para style="q" vid="PSA 139:20">Y tus enemigos toman <char style="add">tu Nombre</char> en vano.<verse eid="PSA 139:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 139:21"/>Oh <char style="nd">Yavé</char>, ¿No aborrezco a los que te aborrecen?</para>
  <para style="q" vid="PSA 139:21">¿No repugno a los que se levantan contra Ti?<verse eid="PSA 139:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 139:22"/>Con absoluto odio los aborrezco.</para>
  <para style="q" vid="PSA 139:22">Son mis enemigos.<verse eid="PSA 139:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 139:23"/>Escudríñame, oh <char style="nd">ʼEL,</char> y conoce mi corazón.</para>
  <para style="q" vid="PSA 139:23">Pruébame y conoce mis ansiosos pensamientos,<verse eid="PSA 139:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 139:24"/>Ve si hay en mí camino de perversidad</para>
  <para style="q" vid="PSA 139:24">Y guíame en el camino eterno.<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="s1">Al director del coro. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 140:1"/>Rescátame, oh <char style="nd">Yavé</char>, de hombres perversos.</para>
  <para style="q" vid="PSA 140:1">Guárdame de hombres violentos<verse eid="PSA 140:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 140:2"/>Que maquinan cosas malas en <char style="add">sus</char> corazones.</para>
  <para style="q" vid="PSA 140:2">Continuamente promueven guerras,<verse eid="PSA 140:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 140:3"/>Afilan su lengua como serpiente.</para>
  <para style="q" vid="PSA 140:3">Veneno de víbora hay debajo de sus labios. <char style="tl">Selah</char><verse eid="PSA 140:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 140:4"/>Guárdame, oh <char style="nd">Yavé</char>, de las manos de los perversos.</para>
  <para style="q" vid="PSA 140:4">Guárdame de hombres violentos,</para>
  <para style="q" vid="PSA 140:4">Que se proponen que vacilen mis pies.<verse eid="PSA 140:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 140:5"/>Soberbios esconden trampa y cuerdas contra mí,</para>
  <para style="q" vid="PSA 140:5">Junto al sendero me extienden una red. <char style="tl">Selah</char><verse eid="PSA 140:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 140:6"/>Digo a <char style="nd">Yavé</char>: Tú eres mi <char style="nd">ʼElohim</char>.</para>
  <para style="q" vid="PSA 140:6">Presta oído, oh <char style="nd">Yavé</char>, a la voz de mis súplicas.<verse eid="PSA 140:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 140:7"/>Oh <char style="nd">Yavé</char> <char style="nd">ʼAdonay</char>, Fortaleza de mi salvación,</para>
  <para style="q" vid="PSA 140:7">Cubriste mi cabeza en el día de la batalla.<verse eid="PSA 140:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 140:8"/>No concedas, oh <char style="nd">Yavé</char>, los deseos del perverso.</para>
  <para style="q" vid="PSA 140:8">No promuevas su designio de ser ellos exaltados. <char style="tl">Selah</char><verse eid="PSA 140:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 140:9"/>En cuanto a la cabeza de los que me rodean,</para>
  <para style="q" vid="PSA 140:9">Cúbralos la perversidad de sus propios labios.<verse eid="PSA 140:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 140:10"/>Que caigan sobre ellos carbones encendidos.</para>
  <para style="q" vid="PSA 140:10">Que sean echados al fuego</para>
  <para style="q" vid="PSA 140:10">En abismos profundos de donde no puedan salir.<verse eid="PSA 140:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 140:11"/>Que el difamador no sea establecido en la tierra.</para>
  <para style="q" vid="PSA 140:11">Que el mal cace velozmente al varón violento.<verse eid="PSA 140:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 140:12"/>Yo sé que <char style="nd">Yavé</char> defiende la causa del afligido,</para>
  <para style="q" vid="PSA 140:12">Y la justicia para el pobre.<verse eid="PSA 140:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 140:13"/>Ciertamente los justos darán gracias a tu Nombre,</para>
  <para style="q" vid="PSA 140:13">Los rectos vivirán en tu Presencia.<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="s1">Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 141:1"/>¡Oh <char style="nd">Yavé</char>, a Ti clamo, apresúrate hacia mí!</para>
  <para style="q" vid="PSA 141:1">Presta oído a mi voz cuando te invoco.<verse eid="PSA 141:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 141:2"/>Que mi oración sea contada como incienso delante de Ti,</para>
  <para style="q" vid="PSA 141:2">El levantamiento de mis manos como <char style="add">la</char> ofrenda de la tarde.<verse eid="PSA 141:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 141:3"/>Pon, oh <char style="nd">Yavé</char>, un guardia sobre mi boca.</para>
  <para style="q" vid="PSA 141:3">Vigila la puerta de mis labios.<verse eid="PSA 141:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 141:4"/>No inclines mi corazón a alguna cosa perversa,</para>
  <para style="q" vid="PSA 141:4">Para que haga obras de perversidad</para>
  <para style="q" vid="PSA 141:4">Con hombres que practican iniquidad,</para>
  <para style="q" vid="PSA 141:4">Y no me dejes probar sus golosinas.<verse eid="PSA 141:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 141:5"/>Que el justo me castigue con bondad</para>
  <para style="q" vid="PSA 141:5">Y me reprenda.</para>
  <para style="q" vid="PSA 141:5">No permitas que el aceite del impío embellezca mi cabeza.</para>
  <para style="b" vid="PSA 141:5"/>
  <para style="q" vid="PSA 141:5">Porque aun mi oración está contra las obras perversas.<verse eid="PSA 141:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 141:6"/>Sean lanzados sus jueces por las laderas de la peña.</para>
  <para style="q" vid="PSA 141:6">Y oigan mis palabras, porque son agradables.<verse eid="PSA 141:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 141:7"/>Como cuando uno ara y rompe la tierra,</para>
  <para style="q" vid="PSA 141:7">Nuestros huesos fueron esparcidos en la boca del <char style="tl">Seol</char>.<verse eid="PSA 141:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 141:8"/>Pero mis ojos están hacia Ti, oh <char style="nd">Yavé</char>, <char style="nd">ʼAdonay</char>.</para>
  <para style="q" vid="PSA 141:8">En Ti me refugio.</para>
  <para style="q" vid="PSA 141:8">No me dejes indefenso.<verse eid="PSA 141:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 141:9"/>Guárdame de las trampas que me tendieron</para>
  <para style="q" vid="PSA 141:9">Y de las trampas de los que cometen iniquidad.<verse eid="PSA 141:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 141:10"/>Que los perversos caigan en sus propias redes</para>
  <para style="q" vid="PSA 141:10">Mientras yo paso con seguridad.<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="s1">Instrucción (<char style="tl">Maskil</char>) de David cuando estaba en la cueva. Oración</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 142:1"/>Con mi voz clamo a <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 142:1">Con mi voz suplico a <char style="nd">Yavé</char>.<verse eid="PSA 142:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 142:2"/>Ante Él derramo mi queja.</para>
  <para style="q" vid="PSA 142:2">Declaro mi aflicción ante Él.<verse eid="PSA 142:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 142:3"/>Cuando mi espíritu desmayaba dentro de mí,</para>
  <para style="q" vid="PSA 142:3">Tú conociste mi sendero.</para>
  <para style="q" vid="PSA 142:3">En el camino por donde ando</para>
  <para style="q" vid="PSA 142:3">Ellos me escondieron una trampa.<verse eid="PSA 142:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 142:4"/>Miro a la derecha y observo</para>
  <para style="q" vid="PSA 142:4">Que no hay uno quien me atienda.</para>
  <para style="q" vid="PSA 142:4">No hay escape para mí.</para>
  <para style="q" vid="PSA 142:4">Nadie se preocupa por mi vida.<verse eid="PSA 142:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 142:5"/>A Ti clamo, oh <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 142:5">Digo: Tú eres mi Refugio,</para>
  <para style="q" vid="PSA 142:5">Mi porción en la tierra de los que viven.<verse eid="PSA 142:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 142:6"/>Presta oído a mi clamor,</para>
  <para style="q" vid="PSA 142:6">Porque estoy muy abatido.</para>
  <para style="q" vid="PSA 142:6">Líbrame de mis perseguidores,</para>
  <para style="q" vid="PSA 142:6">Porque son demasiado fuertes para mí.<verse eid="PSA 142:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 142:7"/>Saca mi vida de la prisión,</para>
  <para style="q" vid="PSA 142:7">Para que dé gracias a tu Nombre.</para>
  <para style="b" vid="PSA 142:7"/>
  <para style="q" vid="PSA 142:7">Me rodearán los justos,</para>
  <para style="q" vid="PSA 142:7">Porque Tú me tratarás con abundancia.<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="s1">Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 143:1"/>Oh <char style="nd">Yavé</char>, escucha mi oración.</para>
  <para style="q" vid="PSA 143:1">Presta oído a mis súplicas.</para>
  <para style="q" vid="PSA 143:1">Por tu fidelidad, por tu justicia respóndeme.<verse eid="PSA 143:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 143:2"/>No entres a juicio con tu esclavo,</para>
  <para style="q" vid="PSA 143:2">Porque ante tu vista ningún hombre que viva es justo.<verse eid="PSA 143:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 143:3"/>Porque el enemigo persiguió mi vida.</para>
  <para style="q" vid="PSA 143:3">Humilló mi vida hasta el suelo.</para>
  <para style="q" vid="PSA 143:3">Me obligó a habitar en tenebrosidad, como los muertos.<verse eid="PSA 143:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 143:4"/>Por tanto, mi espíritu desfallece dentro de mí,</para>
  <para style="q" vid="PSA 143:4">Mi corazón está desolado.<verse eid="PSA 143:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 143:5"/>Recuerdo los días de antaño.</para>
  <para style="q" vid="PSA 143:5">Medito en todas tus obras.</para>
  <para style="q" vid="PSA 143:5">Reflexiono sobre la obra de tus manos.<verse eid="PSA 143:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 143:6"/>A Ti levanto mis manos.</para>
  <para style="q" vid="PSA 143:6">Mi alma te <char style="add">anhela</char> como una tierra seca. <char style="tl">Selah</char><verse eid="PSA 143:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 143:7"/>Oh <char style="nd">Yavé</char>, respóndeme pronto.</para>
  <para style="q" vid="PSA 143:7">Mi espíritu desfallece.</para>
  <para style="q" vid="PSA 143:7">No escondas de mí tu rostro,</para>
  <para style="q" vid="PSA 143:7">O seré como los que bajan a la fosa.<verse eid="PSA 143:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 143:8"/>Que yo escuche por la mañana tu misericordia,</para>
  <para style="q" vid="PSA 143:8">Porque en Ti confío.</para>
  <para style="q" vid="PSA 143:8">Enséñame el camino en el cual debo andar,</para>
  <para style="q" vid="PSA 143:8">Porque a Ti levanto mi alma.<verse eid="PSA 143:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 143:9"/>Oh <char style="nd">Yavé</char>, líbrame de mis enemigos.</para>
  <para style="q" vid="PSA 143:9">Me refugio en Ti.<verse eid="PSA 143:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 143:10"/>Enséñame a hacer tu voluntad,</para>
  <para style="q" vid="PSA 143:10">Porque Tú eres mi <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 143:10">Que tu buen Espíritu me guíe por tierra nivelada.<verse eid="PSA 143:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 143:11"/>Revíveme, oh <char style="nd">Yavé</char>, por amor a tu Nombre.</para>
  <para style="q" vid="PSA 143:11">Por tu justicia saca mi alma de la aflicción.<verse eid="PSA 143:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 143:12"/>Con tu misericordia corta a mis adversarios</para>
  <para style="q" vid="PSA 143:12">Y destruye a todos los que afligen mi alma,</para>
  <para style="q" vid="PSA 143:12">Porque soy tu esclavo.<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="s1">Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 144:1"/>¡Bendito sea <char style="nd">Yavé</char>, mi Roca,</para>
  <para style="q" vid="PSA 144:1">Que adiestra mis manos para la guerra</para>
  <para style="q" vid="PSA 144:1">Y mis dedos para la batalla!<verse eid="PSA 144:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 144:2"/>Mi Misericordia y mi Fortaleza,</para>
  <para style="q" vid="PSA 144:2">Mi alta Torre y mi Libertador,</para>
  <para style="q" vid="PSA 144:2">Mi Escudo, en Quien me refugio,</para>
  <para style="q" vid="PSA 144:2">Quien sujeta mi pueblo a mí.<verse eid="PSA 144:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 144:3"/>Oh <char style="nd">Yavé</char>, ¿qué es el hombre</para>
  <para style="q" vid="PSA 144:3">Para que Tú tengas conocimiento de él,</para>
  <para style="q" vid="PSA 144:3">O el hijo del hombre para que pienses en él?<verse eid="PSA 144:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 144:4"/>El hombre es como un suspiro.</para>
  <para style="q" vid="PSA 144:4">Sus días son como una sombra que pasa.<verse eid="PSA 144:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 144:5"/>Oh <char style="nd">Yavé</char>, inclina tus cielos y desciende.</para>
  <para style="q" vid="PSA 144:5">Toca las montañas para que humeen.<verse eid="PSA 144:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 144:6"/>Despacha relámpagos y dispérsalos.</para>
  <para style="q" vid="PSA 144:6">Envía tus flechas y confúndelos.<verse eid="PSA 144:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 144:7"/>Extiende tu mano desde lo alto.</para>
  <para style="q" vid="PSA 144:7">Rescátame y líbrame de las aguas caudalosas,</para>
  <para style="q" vid="PSA 144:7">De la mano de extranjeros,<verse eid="PSA 144:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 144:8"/>Cuyas bocas hablan engaño</para>
  <para style="q" vid="PSA 144:8">Y cuya mano derecha es falsedad.<verse eid="PSA 144:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 144:9"/>Oh <char style="nd">ʼElohim</char>, a Ti cantaré canto nuevo,</para>
  <para style="q" vid="PSA 144:9">Con salterio de diez cuerdas<note caller="+" style="f"><char style="fr" closed="false">144.9 </char><char style="ft" closed="false">El decacordio era el salterio de diez cuerdas.</char></note> te cantaré salmos.<verse eid="PSA 144:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 144:10"/>Quien da salvación a los reyes,</para>
  <para style="q" vid="PSA 144:10">Y rescatas a tu esclavo David de la espada perversa.<verse eid="PSA 144:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 144:11"/>Rescátame y líbrame de la mano de extranjeros,</para>
  <para style="q" vid="PSA 144:11">Cuyas bocas hablan engaño,</para>
  <para style="q" vid="PSA 144:11">Cuya boca y mano derecha son falsedad.<verse eid="PSA 144:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 144:12"/>Sean nuestros hijos en su juventud como plantas crecidas,</para>
  <para style="q" vid="PSA 144:12">Y nuestras hijas como columnas de esquinas labradas.<verse eid="PSA 144:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 144:13"/>Estén llenos nuestros graneros</para>
  <para style="q" vid="PSA 144:13">Y provean toda clase de producto,</para>
  <para style="q" vid="PSA 144:13">Nuestros rebaños se reproduzcan por miles,</para>
  <para style="q" vid="PSA 144:13">Y diez miles en nuestros campos.<verse eid="PSA 144:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 144:14"/>Nuestros bueyes estén fuertes para el trabajo,</para>
  <para style="q" vid="PSA 144:14">Sin ruptura y sin pérdida,</para>
  <para style="q" vid="PSA 144:14">Y no haya clamor de alarma en nuestras plazas.<verse eid="PSA 144:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 144:15"/>Inmensamente feliz es el pueblo a quien esto le sucede.</para>
  <para style="q" vid="PSA 144:15">Inmensamente feliz es el pueblo cuyo <char style="nd">ʼElohim</char> es <char style="nd">Yavé</char>.<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="s1">Alabanza. Salmo de David</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 145:1"/>Te exaltaré, mi <char style="nd">ʼElohim</char>, oh Rey,</para>
  <para style="q" vid="PSA 145:1">Y bendeciré tu Nombre eternamente y para siempre.<verse eid="PSA 145:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 145:2"/>Cada día te bendeciré y alabaré tu Nombre</para>
  <para style="q" vid="PSA 145:2">Eternamente y para siempre.<verse eid="PSA 145:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 145:3"/>Grande es <char style="nd">Yavé</char>, y digno de suprema alabanza,</para>
  <para style="q" vid="PSA 145:3">Y su grandeza es inescrutable.<verse eid="PSA 145:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 145:4"/>Una generación a otra generación alabará tus obras,</para>
  <para style="q" vid="PSA 145:4">Y declarará tus poderosas obras.<verse eid="PSA 145:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 145:5"/>Meditaré en el glorioso esplendor de tu majestad</para>
  <para style="q" vid="PSA 145:5">Y en tus maravillosas obras.<verse eid="PSA 145:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 145:6"/>Hablarán los hombres del poder de tus asombrosas obras,</para>
  <para style="q" vid="PSA 145:6">Y yo contaré tu grandeza.<verse eid="PSA 145:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 145:7"/>Con anhelo proclamarán la memoria de tu gran bondad,</para>
  <para style="q" vid="PSA 145:7">Y clamarán de tu justicia con regocijo.<verse eid="PSA 145:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 145:8"/>Clemente y misericordioso es <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PSA 145:8">Lento para la ira y grande en misericordia.<verse eid="PSA 145:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 145:9"/>
    <char style="nd">Yavé</char> es bueno para todos,</para>
  <para style="q" vid="PSA 145:9">Y sus misericordias están sobre todas sus obras.<verse eid="PSA 145:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 145:10"/>Oh <char style="nd">Yavé</char>, todas tus obras te darán gracias,</para>
  <para style="q" vid="PSA 145:10">Y tus santos te bendecirán.<verse eid="PSA 145:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 145:11"/>Hablarán de la gloria de tu reino,</para>
  <para style="q" vid="PSA 145:11">Y conversarán sobre tu poder.<verse eid="PSA 145:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 145:12"/>Para proclamar a los hijos de hombres tus poderosas obras,</para>
  <para style="q" vid="PSA 145:12">Y la gloria de la majestad de tu reino.<verse eid="PSA 145:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 145:13"/>Tu reino es eterno,</para>
  <para style="q" vid="PSA 145:13">Y tu señorío por todas las generaciones.<verse eid="PSA 145:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 145:14"/>
    <char style="nd">Yavé</char> sostiene a todos los que caen</para>
  <para style="q" vid="PSA 145:14">Y levanta a todos los que están doblegados.<verse eid="PSA 145:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 145:15"/>Los ojos de todos miran a Ti.</para>
  <para style="q" vid="PSA 145:15">Y en su tiempo Tú les das su alimento.<verse eid="PSA 145:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 145:16"/>Abres tu mano</para>
  <para style="q" vid="PSA 145:16">Y sacias el deseo de todo ser viviente.<verse eid="PSA 145:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 145:17"/>Justo es <char style="nd">Yavé</char> en todos sus procedimientos,</para>
  <para style="q" vid="PSA 145:17">Y bondadoso en todas sus obras.<verse eid="PSA 145:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 145:18"/>Cerca está <char style="nd">Yavé</char> de todos los que lo invocan,</para>
  <para style="q" vid="PSA 145:18">De todos los que lo invocan en verdad.<verse eid="PSA 145:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 145:19"/>Cumplirá el deseo de los que le temen.</para>
  <para style="q" vid="PSA 145:19">Escuchará también su clamor,</para>
  <para style="q" vid="PSA 145:19">Y los salvará.<verse eid="PSA 145:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 145:20"/>
    <char style="nd">Yavé</char> guarda a todos los que lo aman,</para>
  <para style="q" vid="PSA 145:20">Pero destruirá a los perversos.<verse eid="PSA 145:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 145:21"/>Mi boca hablará la alabanza de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 145:21">¡Y todo ser viviente bendecirá su santo Nombre</para>
  <para style="q" vid="PSA 145:21">Eternamente y para siempre!<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 146:1"/>¡Aleluya!</para>
  <para style="b" vid="PSA 146:1"/>
  <para style="q" vid="PSA 146:1">¡Alaba, alma mía, a <char style="nd">Yavé</char>!<verse eid="PSA 146:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 146:2"/>Alabaré a <char style="nd">Yavé</char> en mi vida.</para>
  <para style="q" vid="PSA 146:2">Cantaré alabanzas a mi <char style="nd">ʼElohim</char> mientras viva.<verse eid="PSA 146:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 146:3"/>No confíen en gobernantes,</para>
  <para style="q" vid="PSA 146:3">En un hijo de hombre, en quien no hay salvación.<verse eid="PSA 146:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 146:4"/>Sale su espíritu, vuelve a la tierra.</para>
  <para style="q" vid="PSA 146:4">Ese mismo día perecen sus planes.<verse eid="PSA 146:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 146:5"/>Inmensamente feliz es aquél</para>
  <para style="q" vid="PSA 146:5">Cuya Ayuda es el <char style="nd">ʼElohim</char> de Jacob,</para>
  <para style="q" vid="PSA 146:5">Cuya esperanza está en <char style="nd">Yavé</char> su <char style="nd">ʼElohim</char>,<verse eid="PSA 146:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 146:6"/>Quien hizo <char style="add">el</char> cielo y <char style="add">la</char> tierra,</para>
  <para style="q" vid="PSA 146:6">El mar y todo lo que hay en ellos,</para>
  <para style="q" vid="PSA 146:6">Quien guarda <char style="add">su</char> fidelidad para siempre,<verse eid="PSA 146:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 146:7"/>Quien ejecuta justicia a los oprimidos,</para>
  <para style="q" vid="PSA 146:7">Quien da alimento a los hambrientos.</para>
  <para style="b" vid="PSA 146:7"/>
  <para style="q" vid="PSA 146:7">
    <char style="nd">Yavé</char> liberta a los prisioneros,<verse eid="PSA 146:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 146:8"/>
    <char style="nd">Yavé</char> <char style="add">da vista</char> a los ciegos,</para>
  <para style="q" vid="PSA 146:8">
    <char style="nd">Yavé</char> endereza a los encorvados,</para>
  <para style="q" vid="PSA 146:8">
    <char style="nd">Yavé</char> ama a los justos,<verse eid="PSA 146:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 146:9"/>
    <char style="nd">Yavé</char> protege a los extranjeros,</para>
  <para style="q" vid="PSA 146:9">Él sostiene al huérfano y a la viuda,</para>
  <para style="q" vid="PSA 146:9">Pero Él trastorna el camino de los perversos.<verse eid="PSA 146:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 146:10"/>Reinará <char style="nd">Yavé</char> para siempre,</para>
  <para style="q" vid="PSA 146:10">Tu <char style="nd">ʼElohim</char>, oh Sion, por todas las generaciones.</para>
  <para style="b" vid="PSA 146:10"/>
  <para style="q" vid="PSA 146:10">¡Aleluya!<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 147:1"/>¡Aleluya!</para>
  <para style="b" vid="PSA 147:1"/>
  <para style="q" vid="PSA 147:1">Porque es bueno cantar salmos a nuestro <char style="nd">ʼElohim</char>,</para>
  <para style="q" vid="PSA 147:1">Porque agradable, hermosa es la alabanza.<verse eid="PSA 147:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 147:2"/>
    <char style="nd">Yavé</char> edifica a Jerusalén.</para>
  <para style="q" vid="PSA 147:2">Él reúne a los desterrados de Israel.<verse eid="PSA 147:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 147:3"/>Él sana a los quebrantados de corazón</para>
  <para style="q" vid="PSA 147:3">Y venda sus heridas.<verse eid="PSA 147:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 147:4"/>Él cuenta el número de las estrellas.</para>
  <para style="q" vid="PSA 147:4">Él da nombres a todas ellas.<verse eid="PSA 147:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 147:5"/>Grande es nuestro <char style="nd">ʼAdonay</char></para>
  <para style="q" vid="PSA 147:5">Y prominente en fortaleza.</para>
  <para style="q" vid="PSA 147:5">Su entendimiento es infinito.<verse eid="PSA 147:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 147:6"/>
    <char style="nd">Yavé</char> sostiene a los afligidos.</para>
  <para style="q" vid="PSA 147:6">Él abate a los perversos hasta la tierra.<verse eid="PSA 147:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 147:7"/>Canten a <char style="nd">Yavé</char> con acción de gracias.</para>
  <para style="q" vid="PSA 147:7">Canten salmos a nuestro <char style="nd">ʼElohim</char> con el arpa,<verse eid="PSA 147:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 147:8"/>Quien cubre de nubes el cielo,</para>
  <para style="q" vid="PSA 147:8">Quien provee lluvia para la tierra,</para>
  <para style="q" vid="PSA 147:8">Quien desarrolla la hierba en las montañas.<verse eid="PSA 147:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 147:9"/>Él da a la bestia su alimento,</para>
  <para style="q" vid="PSA 147:9">A las crías de los cuervos que claman.<verse eid="PSA 147:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 147:10"/>No se deleita con la fuerza del caballo,</para>
  <para style="q" vid="PSA 147:10">No se complace en las piernas de un hombre.<verse eid="PSA 147:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 147:11"/>
    <char style="nd">Yavé</char> favorece a los que le temen,</para>
  <para style="q" vid="PSA 147:11">Los que esperan su misericordia.<verse eid="PSA 147:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 147:12"/>¡Alaba a <char style="nd">Yavé</char>, oh Jerusalén!</para>
  <para style="q" vid="PSA 147:12">¡Alaba a tu <char style="nd">ʼElohim</char>, oh Sion!<verse eid="PSA 147:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 147:13"/>Porque Él refuerza los cerrojos de tus puertas,</para>
  <para style="q" vid="PSA 147:13">Él bendice a tus hijos dentro de ti.<verse eid="PSA 147:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 147:14"/>Él establece paz en tus fronteras,</para>
  <para style="q" vid="PSA 147:14">Él te sacia con lo mejor del trigo.<verse eid="PSA 147:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 147:15"/>Él envía su mandato a la tierra,</para>
  <para style="q" vid="PSA 147:15">Su Palabra corre velozmente.<verse eid="PSA 147:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 147:16"/>Él da nieve como lana,</para>
  <para style="q" vid="PSA 147:16">Él esparce la escarcha como ceniza.<verse eid="PSA 147:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 147:17"/>Él lanza su nieve como migas.</para>
  <para style="q" vid="PSA 147:17">¿Quién puede resistir su helada?<verse eid="PSA 147:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 147:18"/>Envía su Palabra,</para>
  <para style="q" vid="PSA 147:18">Y la derrite,</para>
  <para style="q" vid="PSA 147:18">Impulsa su viento para que sople,</para>
  <para style="q" vid="PSA 147:18">Y fluyan las aguas.<verse eid="PSA 147:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 147:19"/>Él declara sus Palabras a Jacob,</para>
  <para style="q" vid="PSA 147:19">Sus Estatutos y Ordenanzas a Israel.<verse eid="PSA 147:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 147:20"/>No trató así con ninguna nación.</para>
  <para style="q" vid="PSA 147:20">Ninguna otra conoció sus ordenanzas.</para>
  <para style="b" vid="PSA 147:20"/>
  <para style="q" vid="PSA 147:20">¡Aleluya! ¡Aleluya!<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 148:1"/>¡Aleluya!</para>
  <para style="b" vid="PSA 148:1"/>
  <para style="q" vid="PSA 148:1">Alaben a <char style="nd">Yavé</char> desde los cielos.</para>
  <para style="q" vid="PSA 148:1">Alábenlo en las alturas.<verse eid="PSA 148:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 148:2"/>Alábenlo, todos sus ángeles.</para>
  <para style="q" vid="PSA 148:2">Alábenlo, todas sus huestes.<verse eid="PSA 148:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 148:3"/>Alábenlo, sol y luna.</para>
  <para style="q" vid="PSA 148:3">Alábenlo, todas lucientes estrellas.<verse eid="PSA 148:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 148:4"/>Alábenlo, los más altos cielos,</para>
  <para style="q" vid="PSA 148:4">Y las aguas que están sobre los cielos.<verse eid="PSA 148:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 148:5"/>Alaben el Nombre de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 148:5">Porque Él mandó,</para>
  <para style="q" vid="PSA 148:5">Y fueron creados.<verse eid="PSA 148:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 148:6"/>Y los estableció eternamente y para siempre.</para>
  <para style="q" vid="PSA 148:6">Él dio un decreto que no pasará.<verse eid="PSA 148:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 148:7"/>Alaben a <char style="nd">Yavé</char> desde la tierra:</para>
  <para style="q" vid="PSA 148:7">Cetáceos y todos los abismos,<verse eid="PSA 148:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 148:8"/>El fuego y el granizo, la nieve y el vapor,</para>
  <para style="q" vid="PSA 148:8">El viento tempestuoso que ejecuta su Palabra,<verse eid="PSA 148:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 148:9"/>Las montañas y todas las colinas,</para>
  <para style="q" vid="PSA 148:9">Árboles frutales y todo cedro,<verse eid="PSA 148:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 148:10"/>Los animales salvajes y todo ganado,</para>
  <para style="q" vid="PSA 148:10">Reptiles y ave alada,<verse eid="PSA 148:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 148:11"/>Reyes de la tierra y todos los pueblos,</para>
  <para style="q" vid="PSA 148:11">Magistrados y todos los jueces de la tierra,<verse eid="PSA 148:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 148:12"/>Tanto jóvenes varones como doncellas,</para>
  <para style="q" vid="PSA 148:12">Los ancianos y los niños,<verse eid="PSA 148:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 148:13"/>Alaben el Nombre de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PSA 148:13">Porque solo su Nombre es exaltado.</para>
  <para style="q" vid="PSA 148:13">Su gloria está por encima de la tierra y el cielo.<verse eid="PSA 148:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 148:14"/>Y Él levantó un poder para su pueblo,</para>
  <para style="q" vid="PSA 148:14">Alabanza para todos sus fieles,</para>
  <para style="q" vid="PSA 148:14">De los hijos de Israel, un pueblo cercano a Él.</para>
  <para style="b" vid="PSA 148:14"/>
  <para style="q" vid="PSA 148:14">¡Aleluya! ¡Aleluya!<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 149:1"/>¡Aleluya!</para>
  <para style="b" vid="PSA 149:1"/>
  <para style="q" vid="PSA 149:1">Canten a <char style="nd">Yavé</char> un canto nuevo</para>
  <para style="q" vid="PSA 149:1">Su alabanza esté en la congregación de los santos.<verse eid="PSA 149:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 149:2"/>Alégrese Israel en su Hacedor.</para>
  <para style="q" vid="PSA 149:2">Regocíjense en su Rey los hijos de Sion.<verse eid="PSA 149:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 149:3"/>Alaben su Nombre con danza.</para>
  <para style="q" vid="PSA 149:3">Cántenle alabanzas con pandero y arpa.<verse eid="PSA 149:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 149:4"/>Porque <char style="nd">Yavé</char> se complace en su pueblo,</para>
  <para style="q" vid="PSA 149:4">Embellecerá a los humildes con salvación.<verse eid="PSA 149:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 149:5"/>Que los fieles exalten su gloria.</para>
  <para style="q" vid="PSA 149:5">Que canten con regocijo en sus camas.<verse eid="PSA 149:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 149:6"/>Que enaltezcan a <char style="nd">ʼEL</char> con su boca,</para>
  <para style="q" vid="PSA 149:6">Con una espada de dos filos en su mano<verse eid="PSA 149:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 149:7"/>Para ejecutar venganza sobre las naciones</para>
  <para style="q" vid="PSA 149:7">Y castigo sobre los pueblos,<verse eid="PSA 149:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 149:8"/>Para atar a sus reyes con cadenas,</para>
  <para style="q" vid="PSA 149:8">Y a sus nobles con grilletes de hierro,<verse eid="PSA 149:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 149:9"/>Para ejecutar la sentencia escrita sobre ellos.</para>
  <para style="q" vid="PSA 149:9">Éste será un honor para todos sus fieles.</para>
  <para style="b" vid="PSA 149:9"/>
  <para style="q" vid="PSA 149:9">¡Aleluya! ¡Aleluya!<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 150:1"/>¡Aleluya!</para>
  <para style="b" vid="PSA 150:1"/>
  <para style="q" vid="PSA 150:1">Alaben a <char style="nd">ʼEL</char> en su Santuario.</para>
  <para style="q" vid="PSA 150:1">Alábenlo en su esplendoroso firmamento.<verse eid="PSA 150:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 150:2"/>Alábenlo por sus poderosas obras.</para>
  <para style="q" vid="PSA 150:2">Alábenlo según su excelente grandeza.<verse eid="PSA 150:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 150:3"/>Alábenlo con el sonido de la trompeta.</para>
  <para style="q" vid="PSA 150:3">Alábenlo con arpa y lira.<verse eid="PSA 150:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 150:4"/>Alábenlo con pandero y danza.</para>
  <para style="q" vid="PSA 150:4">Alábenlo con instrumentos de cuerda y flautas.<verse eid="PSA 150:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 150:5"/>Alábenlo con címbalos resonantes.</para>
  <para style="q" vid="PSA 150:5">Alábenlo con címbalos de júbilo.<verse eid="PSA 150:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 150:6"/>¡Todo lo que respira alabe a <char style="nd">Yavé</char>!</para>
  <para style="b" vid="PSA 150:6"/>
  <para style="q" vid="PSA 150:6">¡Aleluya!<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
