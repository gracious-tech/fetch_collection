<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PRO" style="id"/>
  <para style="h">Proverbios</para>
  <para style="toc3">Pr</para>
  <para style="toc2">Proverbios</para>
  <para style="toc1">Proverbios</para>
  <para style="mt">Proverbios</para>
  <chapter number="1" style="c" sid="PRO 1"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 1:1"/>Los proverbios de Salomón, hijo de David, rey de Israel,<verse eid="PRO 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 1:2"/>Para conocer sabiduría y disciplina,</para>
  <para style="q" vid="PRO 1:2">Para comprender las palabras de inteligencia,<verse eid="PRO 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 1:3"/>Para recibir disciplina y enseñanza,</para>
  <para style="q" vid="PRO 1:3">Justicia, derecho y equidad,<verse eid="PRO 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 1:4"/>Para dar sagacidad al incauto,</para>
  <para style="q" vid="PRO 1:4">Y a los jóvenes conocimiento y discreción.<verse eid="PRO 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 1:5"/>Oirá el sabio y aumentará el saber,</para>
  <para style="q" vid="PRO 1:5">Y el entendido obtendrá habilidades.<verse eid="PRO 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 1:6"/>Entenderá el proverbio y el dicho profundo,</para>
  <para style="q" vid="PRO 1:6">Las palabras de los sabios y sus enigmas.<verse eid="PRO 1:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 1:7"/>El principio de la sabiduría es el temor a <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PRO 1:7">Los insensatos desprecian la sabiduría y la disciplina.<verse eid="PRO 1:7"/></para>
  <para style="s1">Clamor de la sabiduría</para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 1:8"/>Escucha, hijo mío, la enseñanza de tu padre,</para>
  <para style="q" vid="PRO 1:8">Y no abandones la instrucción de tu madre,<verse eid="PRO 1:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 1:9"/>Porque hermosa diadema será en tu cabeza</para>
  <para style="q" vid="PRO 1:9">Y collar en tu cuello.<verse eid="PRO 1:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 1:10"/>Hijo mío, si los pervertidos te quieren seducir,</para>
  <para style="q" vid="PRO 1:10">No consientas.<verse eid="PRO 1:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 1:11"/>Si dicen: Ven con nosotros a tender trampas mortales,</para>
  <para style="q" vid="PRO 1:11">Acechemos sin motivo al inocente.<verse eid="PRO 1:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 1:12"/>¡Los devoraremos vivos, como el <char style="tl">Seol</char>,<note caller="+" style="f"><char style="fr" closed="false">1.12 <char style="tl">Seol</char>: mundo de los muertos.</char></note></para>
  <para style="q" vid="PRO 1:12">Enteros, como los que bajan a la fosa!<verse eid="PRO 1:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 1:13"/>Hallaremos objetos valiosos.</para>
  <para style="q" vid="PRO 1:13">Llenaremos nuestras casas del botín.<verse eid="PRO 1:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 1:14"/>Comparte tu suerte con nosotros,</para>
  <para style="q" vid="PRO 1:14">Y tengamos todos una sola bolsa.<verse eid="PRO 1:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 1:15"/>Hijo mío, no andes en el camino de ellos.</para>
  <para style="q" vid="PRO 1:15">Aparta tu pie de sus senderos,<verse eid="PRO 1:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 1:16"/>Porque sus pies corren hacia el mal</para>
  <para style="q" vid="PRO 1:16">Y se apresuran a derramar sangre.<verse eid="PRO 1:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 1:17"/>En vano se tiende la red</para>
  <para style="q" vid="PRO 1:17">Ante los ojos de las aves.<verse eid="PRO 1:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 1:18"/>Pero ellos colocan trampas a su propia sangre,</para>
  <para style="q" vid="PRO 1:18">Y ante sus propias vidas tienden acechanza.<verse eid="PRO 1:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 1:19"/>Tales son los senderos del que es dado a codicia,</para>
  <para style="q" vid="PRO 1:19">La cual quita la vida a los que la tienen.<verse eid="PRO 1:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 1:20"/>La Sabiduría clama en las calles</para>
  <para style="q" vid="PRO 1:20">Y da su voz en las plazas.<verse eid="PRO 1:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 1:21"/>Proclama sobre los muros,</para>
  <para style="q" vid="PRO 1:21">Y en las entradas de las puertas pregona sus palabras:<verse eid="PRO 1:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 1:22"/>Oh simples ¿hasta cuándo amarán la ingenuidad?</para>
  <para style="q" vid="PRO 1:22">¿Hasta cuando los burladores amarán la burla,</para>
  <para style="q" vid="PRO 1:22">Los insensatos aborrecerán el saber?<verse eid="PRO 1:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 1:23"/>¡Regresen ante mi reprensión,</para>
  <para style="q" vid="PRO 1:23">Y les manifestaré mi espíritu,</para>
  <para style="q" vid="PRO 1:23">Y les haré conocer mis palabras!<verse eid="PRO 1:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 1:24"/>Pero por cuanto llamé y rehusaron.</para>
  <para style="q" vid="PRO 1:24">Extendí mi mano, y no hubo quién escuchara.<verse eid="PRO 1:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 1:25"/>Desecharon todo mi consejo,</para>
  <para style="q" vid="PRO 1:25">Y no quisieron mi reprensión.<verse eid="PRO 1:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 1:26"/>Yo también me reiré cuando llegue su calamidad</para>
  <para style="q" vid="PRO 1:26">Y me burlaré cuando los alcance lo que temen.<verse eid="PRO 1:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PRO 1:27"/>Cuando lo que temen venga como destrucción,</para>
  <para style="q" vid="PRO 1:27">Su calamidad llegue como un remolino de viento</para>
  <para style="q" vid="PRO 1:27">Y vengan sobre ustedes tribulación y angustia.<verse eid="PRO 1:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PRO 1:28"/>Entonces me llamarán, y no responderé,</para>
  <para style="q" vid="PRO 1:28">Me buscarán, pero no me hallarán,<verse eid="PRO 1:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 1:29"/>Por cuanto aborrecieron el conocimiento</para>
  <para style="q" vid="PRO 1:29">Y no escogieron el temor a <char style="nd">Yavé</char>.<verse eid="PRO 1:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 1:30"/>No quisieron mi consejo</para>
  <para style="q" vid="PRO 1:30">Y menospreciaron toda reprensión mía.<verse eid="PRO 1:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 1:31"/>Entonces comerán el fruto de su camino</para>
  <para style="q" vid="PRO 1:31">Y se saciarán de sus propios consejos.<verse eid="PRO 1:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PRO 1:32"/>El descarrío de los simples los matará,</para>
  <para style="q" vid="PRO 1:32">Y la dejadez de los necios los destruirá.<verse eid="PRO 1:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 1:33"/>Pero el que me escuche vivirá confiadamente</para>
  <para style="q" vid="PRO 1:33">Y estará tranquilo, sin temor al mal.<verse eid="PRO 1:33"/></para>
  <chapter eid="PRO 1"/>
  <chapter number="2" style="c" sid="PRO 2"/>
  <para style="s1">Absoluta excelencia de la sabiduría</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 2:1"/>Hijo mío, si aceptas mis palabras,</para>
  <para style="q" vid="PRO 2:1">Y guardas mis mandamientos dentro de ti,<verse eid="PRO 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 2:2"/>Eres de oído atento a la sabiduría,</para>
  <para style="q" vid="PRO 2:2">E inclinas tu corazón a la inteligencia,<verse eid="PRO 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 2:3"/>Si invocas a la prudencia,</para>
  <para style="q" vid="PRO 2:3">Y al entendimiento alzas tu voz,<verse eid="PRO 2:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 2:4"/>Si la procuras como a la plata,</para>
  <para style="q" vid="PRO 2:4">Y la rebuscas como a tesoros escondidos,<verse eid="PRO 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 2:5"/>Entonces entenderás el temor a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PRO 2:5">Y hallarás el conocimiento de <char style="nd">ʼElohim</char>.<verse eid="PRO 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 2:6"/>Porque <char style="nd">Yavé</char> da la sabiduría.</para>
  <para style="q" vid="PRO 2:6">De su boca procede la ciencia y la inteligencia.<verse eid="PRO 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 2:7"/>Él atesora el acierto para los hombres rectos,</para>
  <para style="q" vid="PRO 2:7">Es escudo al que anda en integridad.<verse eid="PRO 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 2:8"/>Es el que guarda las sendas de la justicia,</para>
  <para style="q" vid="PRO 2:8">Y preserva el camino de sus santos.<verse eid="PRO 2:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 2:9"/>Entonces entenderás la justicia y el derecho,</para>
  <para style="q" vid="PRO 2:9">La equidad y todo buen camino.<verse eid="PRO 2:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 2:10"/>Cuando la sabiduría entre en tu corazón</para>
  <para style="q" vid="PRO 2:10">Y el conocimiento sea dulce a tu alma,<verse eid="PRO 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 2:11"/>Te guardará la discreción.</para>
  <para style="q" vid="PRO 2:11">Te preservará la prudencia<verse eid="PRO 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 2:12"/>Para librarte del camino malo</para>
  <para style="q" vid="PRO 2:12">Del hombre que habla cosas perversas,<verse eid="PRO 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 2:13"/>De los que abandonan los caminos rectos</para>
  <para style="q" vid="PRO 2:13">Para andar por sendas tenebrosas,<verse eid="PRO 2:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 2:14"/>De los que gozan haciendo el mal,</para>
  <para style="q" vid="PRO 2:14">Y se alegran en las perversidades del vicio,<verse eid="PRO 2:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 2:15"/>Cuyas sendas son tortuosas,</para>
  <para style="q" vid="PRO 2:15">Y sus caminos extraviados.<verse eid="PRO 2:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PRO 2:16"/>Te librará de la mujer ajena,</para>
  <para style="q" vid="PRO 2:16">De la extraña que endulza sus palabras,<verse eid="PRO 2:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 2:17"/>Que abandona al compañero de su juventud</para>
  <para style="q" vid="PRO 2:17">Y olvida el Pacto de su <char style="nd">ʼElohim</char>.<verse eid="PRO 2:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 2:18"/>Su casa se inclina hacia la muerte,</para>
  <para style="q" vid="PRO 2:18">Sus sendas hacia el país de las sombras.<verse eid="PRO 2:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 2:19"/>Cuantos entran en ella no regresan,</para>
  <para style="q" vid="PRO 2:19">Ni retoman los senderos de la vida.<verse eid="PRO 2:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 2:20"/>Para que sigas el buen camino</para>
  <para style="q" vid="PRO 2:20">Y guardes los senderos del justo.<verse eid="PRO 2:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 2:21"/>Porque los rectos vivirán en la tierra,</para>
  <para style="q" vid="PRO 2:21">Y los de limpio corazón permanecerán en ella.<verse eid="PRO 2:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 2:22"/>Pero el perverso será cortado de la tierra,</para>
  <para style="q" vid="PRO 2:22">Y de ella serán desarraigados los transgresores.<verse eid="PRO 2:22"/></para>
  <chapter eid="PRO 2"/>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="s1">Exhortación a la obediencia</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 3:1"/>Hijo mío, no olvides mis enseñanzas,</para>
  <para style="q" vid="PRO 3:1">Y tu corazón guarde mis mandamientos.<verse eid="PRO 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 3:2"/>Porque largura de días, años de vida</para>
  <para style="q" vid="PRO 3:2">Y paz te aumentarán.<verse eid="PRO 3:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PRO 3:3"/>Nunca se aparten de ti la misericordia y la verdad.</para>
  <para style="q" vid="PRO 3:3">Átalas a tu cuello.</para>
  <para style="q" vid="PRO 3:3">Escríbelas en la tabla de tu corazón,<verse eid="PRO 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 3:4"/>Y hallarás gracia y buena opinión</para>
  <para style="q" vid="PRO 3:4">Ante los ojos de <char style="nd">ʼElohim</char> y del hombre.<verse eid="PRO 3:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 3:5"/>Confía en <char style="nd">Yavé</char> con todo tu corazón,</para>
  <para style="q" vid="PRO 3:5">Y no te apoyes en tu propia inteligencia.<verse eid="PRO 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 3:6"/>Reconócelo en todos tus caminos,</para>
  <para style="q" vid="PRO 3:6">Y Él enderezará tus sendas.<verse eid="PRO 3:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 3:7"/>No seas sabio en tu propia opinión.</para>
  <para style="q" vid="PRO 3:7">Teme a <char style="nd">Yavé</char></para>
  <para style="q" vid="PRO 3:7">Y apártate del mal,<verse eid="PRO 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 3:8"/>Porque será medicina a tu ombligo</para>
  <para style="q" vid="PRO 3:8">Y tuétano a tus huesos.<verse eid="PRO 3:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PRO 3:9"/>Honra a <char style="nd">Yavé</char> con tus bienes</para>
  <para style="q" vid="PRO 3:9">Y con las primicias de todos tus frutos.<verse eid="PRO 3:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 3:10"/>Tus graneros se henchirán de abundancia,</para>
  <para style="q" vid="PRO 3:10">Y tus lagares rebosarán de mosto.<verse eid="PRO 3:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 3:11"/>Hijo mío, no menosprecies el castigo de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PRO 3:11">Ni te fatigues de su corrección.<verse eid="PRO 3:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 3:12"/>Porque <char style="nd">Yavé</char> disciplina al que ama,</para>
  <para style="q" vid="PRO 3:12">Como el padre al hijo en quien se complace.<verse eid="PRO 3:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 3:13"/>Inmensamente feliz el hombre que halla sabiduría</para>
  <para style="q" vid="PRO 3:13">Y el que obtiene la inteligencia.<verse eid="PRO 3:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 3:14"/>Porque su provecho es mayor que el de la plata,</para>
  <para style="q" vid="PRO 3:14">Y su resultado es mejor que el oro fino.<verse eid="PRO 3:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 3:15"/>Es más preciosa que las perlas,</para>
  <para style="q" vid="PRO 3:15">Nada de lo que desees podrá compararse con ella.<verse eid="PRO 3:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 3:16"/>Abundancia de días hay en su mano derecha,</para>
  <para style="q" vid="PRO 3:16">Y en su izquierda, riquezas y honra.<verse eid="PRO 3:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 3:17"/>Sus caminos son agradables,</para>
  <para style="q" vid="PRO 3:17">Y en todas sus sendas hay paz.<verse eid="PRO 3:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 3:18"/>Es árbol de vida a los que echan mano a ella,</para>
  <para style="q" vid="PRO 3:18">Y los que la retienen son inmensamente felices.<verse eid="PRO 3:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PRO 3:19"/>
    <char style="nd">Yavé</char> fundó la tierra con sabiduría</para>
  <para style="q" vid="PRO 3:19">Y con entendimiento afirmó los cielos.<verse eid="PRO 3:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 3:20"/>Con su conocimiento fueron divididos los océanos</para>
  <para style="q" vid="PRO 3:20">Y las nubes destilan rocío.<verse eid="PRO 3:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 3:21"/>Hijo mío, no se aparten estas cosas de tus ojos.</para>
  <para style="q" vid="PRO 3:21">Guarda la sabiduría y la discreción,<verse eid="PRO 3:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 3:22"/>Y serán vida a tu alma y gracia a tu cuello.<verse eid="PRO 3:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 3:23"/>Entonces andarás con seguridad en tu camino</para>
  <para style="q" vid="PRO 3:23">Y tu pie no tropezará.<verse eid="PRO 3:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 3:24"/>Cuando te acuestas, no tendrás temor.</para>
  <para style="q" vid="PRO 3:24">Te acostarás,</para>
  <para style="q" vid="PRO 3:24">Y tu sueño será dulce.<verse eid="PRO 3:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 3:25"/>No temerás el pavor repentino,</para>
  <para style="q" vid="PRO 3:25">Ni cuando llega el ataque de los perversos,<verse eid="PRO 3:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 3:26"/>Porque <char style="nd">Yavé</char> será tu Confianza.</para>
  <para style="q" vid="PRO 3:26">Él guardará tu pie de caer en la trampa.<verse eid="PRO 3:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PRO 3:27"/>No retengas el bien a quien es debido,</para>
  <para style="q" vid="PRO 3:27">Cuando tienes el poder para hacerlo.<verse eid="PRO 3:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 3:28"/>No digas a tu prójimo:</para>
  <para style="q" vid="PRO 3:28">Anda y vuelve, mañana te lo daré,</para>
  <para style="q" vid="PRO 3:28">Cuando tienes contigo qué darle.<verse eid="PRO 3:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PRO 3:29"/>No trames el mal contra el prójimo</para>
  <para style="q" vid="PRO 3:29">Que habita confiado junto a ti.<verse eid="PRO 3:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 3:30"/>No tengas pleito con alguno sin causa,</para>
  <para style="q" vid="PRO 3:30">Si no te hizo agravio.<verse eid="PRO 3:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 3:31"/>No envidies al hombre violento,</para>
  <para style="q" vid="PRO 3:31">Ni escojas alguno de sus caminos,<verse eid="PRO 3:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 3:32"/>Porque <char style="nd">Yavé</char> aborrece al perverso.</para>
  <para style="q" vid="PRO 3:32">Su íntima comunión es con los rectos.<verse eid="PRO 3:32"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="33" style="v" sid="PRO 3:33"/>La maldición de <char style="nd">Yavé</char> está sobre la casa del impío,</para>
  <para style="q" vid="PRO 3:33">Pero bendice la morada de los justos.<verse eid="PRO 3:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 3:34"/>Ciertamente Él se burla de los que se burlan</para>
  <para style="q" vid="PRO 3:34">Y da gracia a los humildes.<verse eid="PRO 3:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 3:35"/>Los sabios heredarán honra,</para>
  <para style="q" vid="PRO 3:35">Pero los necios cargarán la afrenta.<verse eid="PRO 3:35"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="4" style="c" sid="PRO 4"/>
  <para style="s1">Utilidad de la sabiduría</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 4:1"/>Escuchen, hijos, la instrucción de un padre</para>
  <para style="q" vid="PRO 4:1">Y estén atentos para adquirir entendimiento,<verse eid="PRO 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 4:2"/>Porque les doy buena doctrina.</para>
  <para style="q" vid="PRO 4:2">No abandonen mi enseñanza,<verse eid="PRO 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 4:3"/>Pues yo también fui hijo de mi padre,</para>
  <para style="q" vid="PRO 4:3">Afectuoso y singular delante de mi madre.<verse eid="PRO 4:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 4:4"/>Él me enseñaba y me decía:</para>
  <para style="q" vid="PRO 4:4">Retenga tu corazón mis palabras,</para>
  <para style="q" vid="PRO 4:4">Guarda mis mandamientos, y vivirás.<verse eid="PRO 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 4:5"/>Adquiere sabiduría, adquiere entendimiento.</para>
  <para style="q" vid="PRO 4:5">No te olvides ni te apartes de los dichos de mi boca.<verse eid="PRO 4:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 4:6"/>No la abandones, y ella te guardará.</para>
  <para style="q" vid="PRO 4:6">Ámala, y ella te protegerá.<verse eid="PRO 4:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 4:7"/>¡Sabiduría ante todo! Adquiere sabiduría,</para>
  <para style="q" vid="PRO 4:7">Y sobre toda posesión adquiere entendimiento.<verse eid="PRO 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 4:8"/>Exáltala, y ella te engrandecerá,</para>
  <para style="q" vid="PRO 4:8">Cuando la abraces te honrará.<verse eid="PRO 4:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 4:9"/>Pondrá en tu cabeza guirnalda de gracia.</para>
  <para style="q" vid="PRO 4:9">Te otorgará corona de esplendor.<verse eid="PRO 4:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 4:10"/>Escucha, hijo mío, y recibe mis palabras,</para>
  <para style="q" vid="PRO 4:10">Y se te multiplicarán años de vida.<verse eid="PRO 4:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 4:11"/>Te encaminé por el camino de la sabiduría</para>
  <para style="q" vid="PRO 4:11">Y te indiqué las sendas de rectitud.<verse eid="PRO 4:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 4:12"/>Cuando camines, tus pasos no tendrán estorbo.</para>
  <para style="q" vid="PRO 4:12">Y si corres, no tropezarás.<verse eid="PRO 4:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 4:13"/>Aférrate a la disciplina y no la dejes.</para>
  <para style="q" vid="PRO 4:13">Guárdala, porque ella es tu vida.<verse eid="PRO 4:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PRO 4:14"/>No entres por el camino del perverso,</para>
  <para style="q" vid="PRO 4:14">Ni vayas por el sendero de los malos.<verse eid="PRO 4:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 4:15"/>Evítalo, no pases por él.</para>
  <para style="q" vid="PRO 4:15">Desvíate de él, pasa de largo.<verse eid="PRO 4:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 4:16"/>Porque ellos no duermen si no hacen daño,</para>
  <para style="q" vid="PRO 4:16">Y se les quita el sueño si no hacen caer <char style="add">a alguien</char>.<verse eid="PRO 4:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 4:17"/>Porque comen pan de iniquidad</para>
  <para style="q" vid="PRO 4:17">Y beben vino de violencia.<verse eid="PRO 4:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 4:18"/>Pero la senda de los justos es como la luz del alba,</para>
  <para style="q" vid="PRO 4:18">Que va en aumento hasta que el día es perfecto.<verse eid="PRO 4:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 4:19"/>El camino de los impíos es como la oscuridad:</para>
  <para style="q" vid="PRO 4:19">No saben en qué tropiezan.<verse eid="PRO 4:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 4:20"/>Hijo mío, atiende mis palabras.</para>
  <para style="q" vid="PRO 4:20">Inclina tu oído a mis dichos.<verse eid="PRO 4:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 4:21"/>No se aparten de tus ojos.</para>
  <para style="q" vid="PRO 4:21">Guárdalos en lo profundo de tu corazón,<verse eid="PRO 4:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 4:22"/>Pues son vida a los que los hallan</para>
  <para style="q" vid="PRO 4:22">Y sanidad a todo su cuerpo.<verse eid="PRO 4:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 4:23"/>Con toda diligencia, guarda tu corazón,</para>
  <para style="q" vid="PRO 4:23">Porque de él <char style="add">emana</char> la vida.<verse eid="PRO 4:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 4:24"/>Aparta de ti la boca perversa</para>
  <para style="q" vid="PRO 4:24">Y aleja de ti la falsedad de labios.<verse eid="PRO 4:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 4:25"/>Tus ojos miren de frente</para>
  <para style="q" vid="PRO 4:25">Y dirige tu mirada hacia lo que está delante.<verse eid="PRO 4:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 4:26"/>Reflexiona en la senda de tus pies,</para>
  <para style="q" vid="PRO 4:26">Y sean rectos todos tus caminos.<verse eid="PRO 4:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 4:27"/>No te desvíes a la derecha ni a la izquierda.</para>
  <para style="q" vid="PRO 4:27">Aparta tu pie del mal.<verse eid="PRO 4:27"/></para>
  <chapter eid="PRO 4"/>
  <chapter number="5" style="c" sid="PRO 5"/>
  <para style="s1">Oposición a la inmoralidad sexual</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 5:1"/>Hijo mío, atiende a mi sabiduría,</para>
  <para style="q" vid="PRO 5:1">E inclina tu oído a mi entendimiento,<verse eid="PRO 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 5:2"/>Para que guardes discreción</para>
  <para style="q" vid="PRO 5:2">Y tus labios conserven conocimiento.<verse eid="PRO 5:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PRO 5:3"/>Porque los labios de la mujer inmoral destilan miel,</para>
  <para style="q" vid="PRO 5:3">Y su paladar es más suave que el aceite.<verse eid="PRO 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 5:4"/>Pero su propósito es amargo como el ajenjo</para>
  <para style="q" vid="PRO 5:4">Y agudo como espada de dos filos.<verse eid="PRO 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 5:5"/>Sus pies descienden a la muerte.</para>
  <para style="q" vid="PRO 5:5">Sus pasos se precipitan al <char style="tl">Seol</char>.<verse eid="PRO 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 5:6"/>No considera el camino de la vida.</para>
  <para style="q" vid="PRO 5:6">Sus sendas son inestables, pero ella no lo sabe.<verse eid="PRO 5:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 5:7"/>Ahora, pues, hijos, escúchenme.</para>
  <para style="q" vid="PRO 5:7">No se aparten de las palabras de mi boca:<verse eid="PRO 5:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 5:8"/>Aleja de ella tu camino.</para>
  <para style="q" vid="PRO 5:8">No te acerques a la puerta de su casa<verse eid="PRO 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 5:9"/>No sea que des a otros tu vigor,</para>
  <para style="q" vid="PRO 5:9">Y tus años al cruel.<verse eid="PRO 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 5:10"/>No sea que los extraños se llenen de tus fuerzas,</para>
  <para style="q" vid="PRO 5:10">Y tu esfuerzo se quede en casa ajena.<verse eid="PRO 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 5:11"/>Gemirás cuando te llegue el desenlace,</para>
  <para style="q" vid="PRO 5:11">Y se consuma la carne de tu cuerpo.<verse eid="PRO 5:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 5:12"/>Entonces dirás: ¡Cómo aborrecí la corrección,</para>
  <para style="q" vid="PRO 5:12">Y mi corazón menospreció la reprensión!<verse eid="PRO 5:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 5:13"/>¡No hice caso a la voz de mis maestros,</para>
  <para style="q" vid="PRO 5:13">Ni presté oído a mis instructores!<verse eid="PRO 5:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 5:14"/>Casi en la cima de todo mal estuve</para>
  <para style="q" vid="PRO 5:14">En medio de la asamblea y de la congregación.<verse eid="PRO 5:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 5:15"/>Bebe el agua de tu propia cisterna,</para>
  <para style="q" vid="PRO 5:15">Y el agua fresca de tu propio pozo.<verse eid="PRO 5:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 5:16"/>¿Se derramarán afuera tus manantiales,</para>
  <para style="q" vid="PRO 5:16">Tus corrientes de aguas por las plazas?<verse eid="PRO 5:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 5:17"/>¡Sean solamente tuyos,</para>
  <para style="q" vid="PRO 5:17">Y no de extraños contigo!<verse eid="PRO 5:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 5:18"/>Sea bendito tu manantial</para>
  <para style="q" vid="PRO 5:18">Y regocíjate con la esposa de tu juventud,<verse eid="PRO 5:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 5:19"/>Como hermosa venada o graciosa gacela,</para>
  <para style="q" vid="PRO 5:19">Sus pechos te satisfagan en todo tiempo,</para>
  <para style="q" vid="PRO 5:19">Y recréate siempre con su amor.<verse eid="PRO 5:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 5:20"/>¿Por qué, hijo mío, estarás apasionado con mujer ajena,</para>
  <para style="q" vid="PRO 5:20">Y abrazarás el seno de una extraña?<verse eid="PRO 5:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 5:21"/>Porque los caminos del hombre están ante los ojos de <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PRO 5:21">Él observa todas sus sendas.<verse eid="PRO 5:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 5:22"/>En su propia iniquidad quedará atrapado el inicuo.</para>
  <para style="q" vid="PRO 5:22">Será atado con las cuerdas de su propio pecado.<verse eid="PRO 5:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 5:23"/>Morirá por falta de corrección,</para>
  <para style="q" vid="PRO 5:23">Extraviado en la inmensidad de su locura.<verse eid="PRO 5:23"/></para>
  <chapter eid="PRO 5"/>
  <chapter number="6" style="c" sid="PRO 6"/>
  <para style="s1">Oposición a ser fiador, a la pereza y al adulterio</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 6:1"/>Hijo mío, si saliste fiador por tu prójimo,</para>
  <para style="q" vid="PRO 6:1">Si empeñaste tu palabra a un extraño,<verse eid="PRO 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 6:2"/>Si te enredaste con tus palabras,</para>
  <para style="q" vid="PRO 6:2">Y quedaste atrapado con los dichos de tu boca,<verse eid="PRO 6:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 6:3"/>Haz esto ahora, hijo mío, y líbrate.</para>
  <para style="q" vid="PRO 6:3">Ya que caíste en las manos de tu prójimo:</para>
  <para style="q" vid="PRO 6:3">Vé, humíllate e importuna a tu prójimo.<verse eid="PRO 6:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 6:4"/>No concedas sueño a tus ojos,</para>
  <para style="q" vid="PRO 6:4">Ni adormecimiento a tus párpados.<verse eid="PRO 6:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 6:5"/>Líbrate como gacela de la mano <char style="add">del cazador</char>,</para>
  <para style="q" vid="PRO 6:5">Como un ave de la trampa.<verse eid="PRO 6:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 6:6"/>Mira a la hormiga, oh perezoso,</para>
  <para style="q" vid="PRO 6:6">Observa sus caminos y sé sabio,<verse eid="PRO 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 6:7"/>La cual, sin tener jefe,</para>
  <para style="q" vid="PRO 6:7">Ni gobernador, ni soberano,<verse eid="PRO 6:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 6:8"/>Prepara en el verano su comida.</para>
  <para style="q" vid="PRO 6:8">En el tiempo de la cosecha guarda su sustento.<verse eid="PRO 6:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 6:9"/>¿Hasta cuándo estarás acostado, oh perezoso?</para>
  <para style="q" vid="PRO 6:9">¿Cuándo te levantarás de tu sueño?<verse eid="PRO 6:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 6:10"/>Un rato duermes, otro dormitas,</para>
  <para style="q" vid="PRO 6:10">Un rato cruzas los brazos y descansas.<verse eid="PRO 6:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 6:11"/>Te llega la miseria como un vagabundo,</para>
  <para style="q" vid="PRO 6:11">Y tu necesidad como un hombre armado.<verse eid="PRO 6:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 6:12"/>Hombre depravado es el hombre inicuo,</para>
  <para style="q" vid="PRO 6:12">Que anda en la perversidad de su boca,<verse eid="PRO 6:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 6:13"/>Guiña con un ojo, menea los pies,</para>
  <para style="q" vid="PRO 6:13">Hace señas con los dedos.<verse eid="PRO 6:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 6:14"/>En su corazón hay perversidades,</para>
  <para style="q" vid="PRO 6:14">Maquina maldades, y continuamente busca rencillas.<verse eid="PRO 6:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 6:15"/>Por tanto, su calamidad vendrá de repente.</para>
  <para style="q" vid="PRO 6:15">Súbitamente será quebrantado y no habrá remedio.<verse eid="PRO 6:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PRO 6:16"/>Seis <char style="add">cosas</char> aborrece <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PRO 6:16">Y aun siete repugna su alma:<verse eid="PRO 6:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 6:17"/>Ojos altivos, boca mentirosa,</para>
  <para style="q" vid="PRO 6:17">Manos que derraman sangre inocente,<verse eid="PRO 6:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 6:18"/>Corazón que maquina planes perversos,</para>
  <para style="q" vid="PRO 6:18">Pies presurosos para correr al mal,<verse eid="PRO 6:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 6:19"/>Testigo falso que habla mentiras,</para>
  <para style="q" vid="PRO 6:19">Y el que enciende discordias entre sus hermanos.<verse eid="PRO 6:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 6:20"/>Hijo mío, guarda el mandamiento de tu padre,</para>
  <para style="q" vid="PRO 6:20">Y no abandones la instrucción de tu madre.<verse eid="PRO 6:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 6:21"/>Átalos continuamente a tu corazón,</para>
  <para style="q" vid="PRO 6:21">Enlázalos en torno a tu cuello.<verse eid="PRO 6:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 6:22"/>Cuando camines, te guiarán.</para>
  <para style="q" vid="PRO 6:22">Cuando duermas, te protegerán.</para>
  <para style="q" vid="PRO 6:22">Hablarán contigo al despertar.<verse eid="PRO 6:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 6:23"/>Porque el mandamiento es lámpara,</para>
  <para style="q" vid="PRO 6:23">La enseñanza es luz</para>
  <para style="q" vid="PRO 6:23">Y camino de vida las reprensiones de la instrucción.<verse eid="PRO 6:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 6:24"/>Te guardarán de la mala mujer,</para>
  <para style="q" vid="PRO 6:24">De la blandura de la boca de la mujer extraña.<verse eid="PRO 6:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 6:25"/>No codicies en tu corazón su hermosura,</para>
  <para style="q" vid="PRO 6:25">Ni dejes que te cautive con sus párpados.<verse eid="PRO 6:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 6:26"/>Porque si la prostituta busca una hogaza de pan,</para>
  <para style="q" vid="PRO 6:26">La adúltera caza una vida preciosa.<verse eid="PRO 6:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 6:27"/>¿Tomará el hombre fuego en su seno,</para>
  <para style="q" vid="PRO 6:27">Sin que ardan sus ropas?<verse eid="PRO 6:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 6:28"/>¿Andará un hombre sobre brasas,</para>
  <para style="q" vid="PRO 6:28">Sin que se quemen sus pies?<verse eid="PRO 6:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 6:29"/>Así sucederá con el que se une a la mujer de su prójimo.</para>
  <para style="q" vid="PRO 6:29">Ninguno que la toque quedará impune.<verse eid="PRO 6:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PRO 6:30"/>¿No desprecian al ladrón aunque robe</para>
  <para style="q" vid="PRO 6:30">Para llenar su estómago cuando tiene hambre?<verse eid="PRO 6:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 6:31"/>Si es sorprendido, tiene que pagar siete veces</para>
  <para style="q" vid="PRO 6:31">Y entregar todo lo que tiene en su casa.<verse eid="PRO 6:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 6:32"/>Pues el adúltero es hombre sin cordura,</para>
  <para style="q" vid="PRO 6:32">Destructor de sí mismo es el que lo hace.<verse eid="PRO 6:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 6:33"/>Heridas y deshonra hallará,</para>
  <para style="q" vid="PRO 6:33">Y su afrenta no será borrada.<verse eid="PRO 6:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 6:34"/>Porque los celos son la ira del hombre.</para>
  <para style="q" vid="PRO 6:34">En el día de la venganza no perdonará,<verse eid="PRO 6:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 6:35"/>Ni aceptará algún rescate.</para>
  <para style="q" vid="PRO 6:35">No se aplacará aunque ofrezcas muchos regalos.<verse eid="PRO 6:35"/></para>
  <chapter eid="PRO 6"/>
  <chapter number="7" style="c" sid="PRO 7"/>
  <para style="s1">Artimañas de la prostituta</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 7:1"/>Hijo mío, guarda mis palabras</para>
  <para style="q" vid="PRO 7:1">Y atesora mis mandamientos dentro de ti.<verse eid="PRO 7:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 7:2"/>Guarda mis mandamientos y vive,</para>
  <para style="q" vid="PRO 7:2">Y mi enseñanza como la niña de tu ojo.<verse eid="PRO 7:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 7:3"/>Átalos a tus dedos.</para>
  <para style="q" vid="PRO 7:3">Escríbelos en la tabla de tu corazón.<verse eid="PRO 7:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 7:4"/>Dí a la sabiduría: Tú eres mi hermana.</para>
  <para style="q" vid="PRO 7:4">Llama al entendimiento <char style="add">tu</char> íntimo amigo,<verse eid="PRO 7:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 7:5"/>Para que te guarden de la mujer ajena,</para>
  <para style="q" vid="PRO 7:5">De la seductora <char style="add">que</char> lisonjea con sus palabras.<verse eid="PRO 7:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 7:6"/>Pues cuando desde la ventana de mi casa</para>
  <para style="q" vid="PRO 7:6">Observaba entre las celosías,<verse eid="PRO 7:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 7:7"/>Vi entre los ingenuos.</para>
  <para style="q" vid="PRO 7:7">Observé entre los jóvenes</para>
  <para style="q" vid="PRO 7:7">A un joven falto de entendimiento<verse eid="PRO 7:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 7:8"/>Que pasaba por la calle cerca de la esquina de ella.</para>
  <para style="q" vid="PRO 7:8">Caminaba en dirección a la casa de ella<verse eid="PRO 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 7:9"/>Al anochecer, cuando ya oscurecía,</para>
  <para style="q" vid="PRO 7:9">En medio de la noche y la oscuridad.<verse eid="PRO 7:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 7:10"/>Y ahí estaba una mujer que <char style="add">salía</char> a encontrarlo,</para>
  <para style="q" vid="PRO 7:10">Astuta de corazón, vestida de prostituta,<verse eid="PRO 7:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 7:11"/>Bullanguera y desenfrenada.</para>
  <para style="q" vid="PRO 7:11">Sus pies no pueden permanecer en casa,<verse eid="PRO 7:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 7:12"/>Unas veces en las calles, otras en las plazas,</para>
  <para style="q" vid="PRO 7:12">Acecha en todas las esquinas.<verse eid="PRO 7:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 7:13"/>Lo agarró y lo besó,</para>
  <para style="q" vid="PRO 7:13">Y descaradamente le dijo:<verse eid="PRO 7:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 7:14"/>Prometí sacrificios de paz.</para>
  <para style="q" vid="PRO 7:14">Hoy pagué mis votos.<verse eid="PRO 7:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 7:15"/>Por tanto salí a encontrarte,</para>
  <para style="q" vid="PRO 7:15">A buscar diligentemente tu rostro, y te hallé.<verse eid="PRO 7:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 7:16"/>Preparé mi cama con colchas.</para>
  <para style="q" vid="PRO 7:16">La tendí con lino de Egipto.<verse eid="PRO 7:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 7:17"/>Perfumé mi cama con mirra, áloes, y canela.<verse eid="PRO 7:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 7:18"/>Ven, deleitémonos con caricias hasta el alba.</para>
  <para style="q" vid="PRO 7:18">Embriaguémonos de amores,<verse eid="PRO 7:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 7:19"/>Porque mi esposo no está en casa.</para>
  <para style="q" vid="PRO 7:19">Emprendió un largo viaje.<verse eid="PRO 7:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 7:20"/>Llevó consigo una bolsa de dinero.</para>
  <para style="q" vid="PRO 7:20">El día de luna nueva volverá a su casa.<verse eid="PRO 7:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 7:21"/>Lo rindió con la mucha suavidad de sus palabras.</para>
  <para style="q" vid="PRO 7:21">Lo sedujo con sus labios lisonjeros.<verse eid="PRO 7:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 7:22"/>Súbitamente se fue tras ella,</para>
  <para style="q" vid="PRO 7:22">Como el buey al matadero,</para>
  <para style="q" vid="PRO 7:22">Como un venado que se enredó en la trampa,<verse eid="PRO 7:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 7:23"/>Como ave que se lanza contra la red,</para>
  <para style="q" vid="PRO 7:23">Sin saber que le costará la vida,</para>
  <para style="q" vid="PRO 7:23">Hasta que una flecha le traspasa el hígado.<verse eid="PRO 7:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 7:24"/>Ahora pues, hijos, escúchenme.</para>
  <para style="q" vid="PRO 7:24">Presten atención a las palabras de mi boca:<verse eid="PRO 7:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 7:25"/>No dejes que tu corazón se aparte a los caminos de ella,</para>
  <para style="q" vid="PRO 7:25">Ni te extravíes por sus sendas.<verse eid="PRO 7:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 7:26"/>Porque ella dejó muchos heridos,</para>
  <para style="q" vid="PRO 7:26">Y aun los más fuertes fueron asesinados por ella.<verse eid="PRO 7:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 7:27"/>Su casa es el camino al <char style="tl">Seol</char>,</para>
  <para style="q" vid="PRO 7:27">Que desciende a las cámaras de la muerte.<verse eid="PRO 7:27"/></para>
  <chapter eid="PRO 7"/>
  <chapter number="8" style="c" sid="PRO 8"/>
  <para style="s1">Excelencia y eternidad de la sabiduría</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 8:1"/>¿No clama la sabiduría,</para>
  <para style="q" vid="PRO 8:1">Y el entendimiento hace oír su voz?<verse eid="PRO 8:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 8:2"/>En las cimas de las alturas junto al camino,</para>
  <para style="q" vid="PRO 8:2">En las encrucijadas de los senderos, allí está ella.<verse eid="PRO 8:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 8:3"/>Junto a las puertas, en la entrada de la ciudad,</para>
  <para style="q" vid="PRO 8:3">En el acceso a las puertas, ella da voces:<verse eid="PRO 8:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 8:4"/>¡Oh hombres, a ustedes clamo!</para>
  <para style="q" vid="PRO 8:4">Mi voz se dirige a los hijos de los hombres.<verse eid="PRO 8:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 8:5"/>Oh simples, aprendan prudencia.</para>
  <para style="q" vid="PRO 8:5">Y ustedes, insensatos, dispongan su corazón.<verse eid="PRO 8:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 8:6"/>Escuchen, porque diré cosas excelentes,</para>
  <para style="q" vid="PRO 8:6">Y abriré mis labios para cosas rectas.<verse eid="PRO 8:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 8:7"/>Mi boca pronunciará verdad.</para>
  <para style="q" vid="PRO 8:7">La maldad es repugnancia para mis labios.<verse eid="PRO 8:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 8:8"/>Todas las palabras de mi boca son con justicia.</para>
  <para style="q" vid="PRO 8:8">En ellas nada hay torcido o perverso.<verse eid="PRO 8:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 8:9"/>Son claras para el que entiende</para>
  <para style="q" vid="PRO 8:9">Y rectas para los que hallan el conocimiento.<verse eid="PRO 8:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 8:10"/>Reciban mi enseñanza y no plata,</para>
  <para style="q" vid="PRO 8:10">Conocimiento, mejor que oro fino.<verse eid="PRO 8:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 8:11"/>Pues mejor es la sabiduría que las perlas.</para>
  <para style="q" vid="PRO 8:11">Nada de lo que desees podrá compararse con ella.<verse eid="PRO 8:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 8:12"/>Yo, la sabiduría, moro con la prudencia,</para>
  <para style="q" vid="PRO 8:12">Y descubro el conocimiento y la discreción.<verse eid="PRO 8:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 8:13"/>El temor a <char style="nd">Yavé</char> es aborrecer el mal.</para>
  <para style="q" vid="PRO 8:13">Aborrezco la soberbia, la arrogancia, el mal camino y la boca perversa.<verse eid="PRO 8:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 8:14"/>Mío es el consejo y la eficiente sabiduría.</para>
  <para style="q" vid="PRO 8:14">Mía es la inteligencia y mía la valentía.<verse eid="PRO 8:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 8:15"/>Por mí reinan los reyes,</para>
  <para style="q" vid="PRO 8:15">Y los magistrados administran justicia.<verse eid="PRO 8:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 8:16"/>Por mí gobiernan los príncipes</para>
  <para style="q" vid="PRO 8:16">Y los nobles que juzgan la tierra.<verse eid="PRO 8:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 8:17"/>Yo amo a los que me aman.</para>
  <para style="q" vid="PRO 8:17">Me hallan los que temprano me buscan.<verse eid="PRO 8:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 8:18"/>Las riquezas y la honra están conmigo,</para>
  <para style="q" vid="PRO 8:18">Riquezas y justicia perdurables.<verse eid="PRO 8:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 8:19"/>Mi fruto es mejor que el oro,</para>
  <para style="q" vid="PRO 8:19">Aun que el oro puro,</para>
  <para style="q" vid="PRO 8:19">Y mi ganancia mejor que la plata escogida.<verse eid="PRO 8:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 8:20"/>Yo ando por camino de justicia,</para>
  <para style="q" vid="PRO 8:20">Por los senderos de equidad,<verse eid="PRO 8:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 8:21"/>Para hacer que los que me aman obtengan su heredad.</para>
  <para style="q" vid="PRO 8:21">Y para que yo llene sus tesoros.<verse eid="PRO 8:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PRO 8:22"/>
    <char style="nd">Yavé</char> me poseía en el principio,</para>
  <para style="q" vid="PRO 8:22">Ya de antiguo, antes de sus obras.<verse eid="PRO 8:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 8:23"/>Eternamente estaba establecida,</para>
  <para style="q" vid="PRO 8:23">Antes de haber tierra.<verse eid="PRO 8:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 8:24"/>Nací antes que existieran los océanos,</para>
  <para style="q" vid="PRO 8:24">Antes que existieran las fuentes de muchas aguas.<verse eid="PRO 8:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 8:25"/>Antes que las montañas fueran fundadas,</para>
  <para style="q" vid="PRO 8:25">Antes de las colinas, fui yo engendrada.<verse eid="PRO 8:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 8:26"/>Cuando Él no había hecho la tierra, ni los campos,</para>
  <para style="q" vid="PRO 8:26">Ni el primer polvo del mundo.<verse eid="PRO 8:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 8:27"/>Cuando estableció los cielos, allí estaba yo.</para>
  <para style="q" vid="PRO 8:27">Cuando trazó el horizonte sobre la superficie del océano,<verse eid="PRO 8:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 8:28"/>Cuando afirmó los cielos arriba,</para>
  <para style="q" vid="PRO 8:28">Cuando afirmó las fuentes del océano,<verse eid="PRO 8:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 8:29"/>Cuando señaló al mar su estatuto,</para>
  <para style="q" vid="PRO 8:29">Para que las aguas no traspasaran su mandato,</para>
  <para style="q" vid="PRO 8:29">Cuando estableció los fundamentos de la tierra,<verse eid="PRO 8:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 8:30"/>Yo estaba junto a Él como arquitecto.</para>
  <para style="q" vid="PRO 8:30">Diariamente era su deleite.</para>
  <para style="q" vid="PRO 8:30">Me regocijaba ante Él siempre.<verse eid="PRO 8:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 8:31"/>Me regocijaba en su tierra habitada,</para>
  <para style="q" vid="PRO 8:31">Y tenía mi deleite con los hijos de los hombres.<verse eid="PRO 8:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PRO 8:32"/>Ahora pues, hijos, escúchenme.</para>
  <para style="q" vid="PRO 8:32">Inmensamente felices los que guardan mis caminos.<verse eid="PRO 8:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 8:33"/>Atiendan la instrucción, sean sabios</para>
  <para style="q" vid="PRO 8:33">Y no la menosprecien.<verse eid="PRO 8:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 8:34"/>¡Inmensamente feliz es el hombre que me escucha,</para>
  <para style="q" vid="PRO 8:34">Que vigila en mis portones cada día,</para>
  <para style="q" vid="PRO 8:34">Que espera en el umbral de mis entradas!<verse eid="PRO 8:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 8:35"/>Porque el que me halla,</para>
  <para style="q" vid="PRO 8:35">Halla la vida y alcanza el favor de <char style="nd">Yavé</char>.<verse eid="PRO 8:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PRO 8:36"/>Pero el que peca contra mí, defrauda su propia alma.</para>
  <para style="q" vid="PRO 8:36">Todos los que me aborrecen aman la muerte.<verse eid="PRO 8:36"/></para>
  <chapter eid="PRO 8"/>
  <chapter number="9" style="c" sid="PRO 9"/>
  <para style="s1">La sabiduría y la mujer necia</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 9:1"/>La sabiduría edificó su casa.</para>
  <para style="q" vid="PRO 9:1">Labró sus siete columnas.<verse eid="PRO 9:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 9:2"/>Degolló sus animales,</para>
  <para style="q" vid="PRO 9:2">Mezcló su vino,</para>
  <para style="q" vid="PRO 9:2">Sirvió su mesa,<verse eid="PRO 9:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 9:3"/>Y envió a sus criadas</para>
  <para style="q" vid="PRO 9:3">A pregonarlo desde las más altas cumbres de la ciudad:<verse eid="PRO 9:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 9:4"/>¡El que sea simple, venga acá!</para>
  <para style="q" vid="PRO 9:4">Al falto de entendimiento le quiero hablar:<verse eid="PRO 9:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 9:5"/>¡Vengan, coman de mis manjares,</para>
  <para style="q" vid="PRO 9:5">Y beban del vino que mezclé!<verse eid="PRO 9:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 9:6"/>¡Dejen la necedad y vivan,</para>
  <para style="q" vid="PRO 9:6">Pongan sus pies en el camino del entendimiento!<verse eid="PRO 9:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 9:7"/>El que corrige al burlador se acarrea insultos.</para>
  <para style="q" vid="PRO 9:7">El que reprende al perverso se acarrea afrenta.<verse eid="PRO 9:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 9:8"/>No reprendas al burlador, no sea que te aborrezca.</para>
  <para style="q" vid="PRO 9:8">Reprende al sabio, y te amará.<verse eid="PRO 9:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 9:9"/>Da al sabio, y será aun más sabio.</para>
  <para style="q" vid="PRO 9:9">Enseña al justo, y aumentará su saber.<verse eid="PRO 9:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 9:10"/>El temor a <char style="nd">Yavé</char> es el principio de la sabiduría,</para>
  <para style="q" vid="PRO 9:10">Y el conocimiento del Santísimo es el entendimiento.<verse eid="PRO 9:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 9:11"/>Porque por mí se aumentarán tus días,</para>
  <para style="q" vid="PRO 9:11">Y años de vida se te añadirán.<verse eid="PRO 9:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 9:12"/>Si eres sabio, para ti mismo eres sabio,</para>
  <para style="q" vid="PRO 9:12">Y si eres burlador, solo tú llevarás el daño.<verse eid="PRO 9:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 9:13"/>La mujer necia es alborotadora.</para>
  <para style="q" vid="PRO 9:13">Es simple y nada sabe.<verse eid="PRO 9:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 9:14"/>Se sienta en la puerta de su casa,</para>
  <para style="q" vid="PRO 9:14">O en los lugares más altos de la ciudad<verse eid="PRO 9:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 9:15"/>Para llamar a los que pasan,</para>
  <para style="q" vid="PRO 9:15">A los que van directo por sus sendas:<verse eid="PRO 9:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 9:16"/>¡Todos los ingenuos vengan acá!</para>
  <para style="q" vid="PRO 9:16">Y dice a los faltos de cordura:<verse eid="PRO 9:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 9:17"/>¡El agua robada es dulce!</para>
  <para style="q" vid="PRO 9:17">¡El pan comido en oculto es sabroso!<verse eid="PRO 9:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 9:18"/>No saben ellos que allí están los muertos,</para>
  <para style="q" vid="PRO 9:18">Y que sus invitados están tendidos en lo profundo del <char style="tl">Seol</char>.<verse eid="PRO 9:18"/></para>
  <chapter eid="PRO 9"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="s1">Contrastes</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 10:1"/>Proverbios de Salomón.</para>
  <para style="q" vid="PRO 10:1">El hijo sabio alegra al padre,</para>
  <para style="q" vid="PRO 10:1">Pero el hijo necio es tristeza de su madre.<verse eid="PRO 10:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 10:2"/>Los tesoros de perversidad no son de provecho,</para>
  <para style="q" vid="PRO 10:2">Pero la justicia libra de la muerte.<verse eid="PRO 10:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 10:3"/>
    <char style="nd">Yavé</char> no deja padecer hambre al justo,</para>
  <para style="q" vid="PRO 10:3">Pero impide que se sacie el apetito de los perversos.<verse eid="PRO 10:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 10:4"/>La mano negligente empobrece,</para>
  <para style="q" vid="PRO 10:4">Pero la mano de los diligentes enriquece.<verse eid="PRO 10:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 10:5"/>El que recoge en verano es hijo sensato,</para>
  <para style="q" vid="PRO 10:5">Pero el que duerme en la cosecha es un hijo que avergüenza.<verse eid="PRO 10:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 10:6"/>Hay bendiciones sobre la cabeza del justo,</para>
  <para style="q" vid="PRO 10:6">Pero la boca de los perversos oculta violencia.<verse eid="PRO 10:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 10:7"/>La memoria del justo será bendita,</para>
  <para style="q" vid="PRO 10:7">Pero el nombre del perverso se pudrirá.<verse eid="PRO 10:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 10:8"/>El sabio de corazón acepta los mandamientos,</para>
  <para style="q" vid="PRO 10:8">Pero el insensato charlatán se hunde.<verse eid="PRO 10:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 10:9"/>El que camina en integridad anda confiado,</para>
  <para style="q" vid="PRO 10:9">Pero el que pervierte sus caminos será puesto en descubierto.<verse eid="PRO 10:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 10:10"/>El que guiña el ojo causa tristeza,</para>
  <para style="q" vid="PRO 10:10">Pero el que reprende francamente hace la paz.<verse eid="PRO 10:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 10:11"/>La boca del justo es manantial de vida,</para>
  <para style="q" vid="PRO 10:11">Pero la boca del necio oculta violencia.<verse eid="PRO 10:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 10:12"/>El odio provoca rencillas,</para>
  <para style="q" vid="PRO 10:12">Pero el amor cubre todas las faltas.<verse eid="PRO 10:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 10:13"/>La sabiduría está en los labios del entendido,</para>
  <para style="q" vid="PRO 10:13">Pero la vara es para la espalda del que carece de entendimiento.<verse eid="PRO 10:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 10:14"/>Los sabios atesoran conocimiento,</para>
  <para style="q" vid="PRO 10:14">Pero la boca del necio es ruina cercana.<verse eid="PRO 10:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 10:15"/>La fortuna del rico es su fortaleza,</para>
  <para style="q" vid="PRO 10:15">La ruina de los necesitados es su pobreza.<verse eid="PRO 10:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 10:16"/>El salario del justo es para vida,</para>
  <para style="q" vid="PRO 10:16">El lucro del perverso, para pecado.<verse eid="PRO 10:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 10:17"/>El que acepta la instrucción está en senda de vida,</para>
  <para style="q" vid="PRO 10:17">Pero el que desecha la reprensión se extravía.<verse eid="PRO 10:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 10:18"/>Los labios rectos aplacan el odio,</para>
  <para style="q" vid="PRO 10:18">Pero el que esparce calumnia es un necio.<verse eid="PRO 10:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 10:19"/>En las muchas palabras no falta pecado,</para>
  <para style="q" vid="PRO 10:19">Pero el que refrena sus labios es prudente.<verse eid="PRO 10:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 10:20"/>La boca del justo es plata pura,</para>
  <para style="q" vid="PRO 10:20">Pero el corazón del perverso es nada.<verse eid="PRO 10:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 10:21"/>Los labios del justo nutren a muchos,</para>
  <para style="q" vid="PRO 10:21">Pero los necios mueren por falta de entendimiento.<verse eid="PRO 10:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 10:22"/>La bendición de <char style="nd">Yavé</char> es la que enriquece,</para>
  <para style="q" vid="PRO 10:22">Y Él no le añade tristeza.<verse eid="PRO 10:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 10:23"/>La perversidad es como deporte para el necio.</para>
  <para style="q" vid="PRO 10:23">Así es la sabiduría para el hombre de entendimiento.<verse eid="PRO 10:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 10:24"/>Lo que teme el perverso, eso le vendrá,</para>
  <para style="q" vid="PRO 10:24">Pero el deseo de los justos les será concedido.<verse eid="PRO 10:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 10:25"/>Cuando pasa el remolino de viento, desaparece el perverso,</para>
  <para style="q" vid="PRO 10:25">Pero el justo tiene fundamento eterno.<verse eid="PRO 10:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 10:26"/>Como vinagre a los dientes y humo a los ojos,</para>
  <para style="q" vid="PRO 10:26">Así es el perezoso para quienes lo comisionan.<verse eid="PRO 10:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 10:27"/>El temor a <char style="nd">Yavé</char> aumenta los días,</para>
  <para style="q" vid="PRO 10:27">Pero los años de los perversos serán acortados.<verse eid="PRO 10:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 10:28"/>La esperanza de los justos es alegría,</para>
  <para style="q" vid="PRO 10:28">Pero la esperanza de los perversos perecerá.<verse eid="PRO 10:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 10:29"/>El camino de <char style="nd">Yavé</char> es fortaleza para el íntegro,</para>
  <para style="q" vid="PRO 10:29">Pero ruina para los malhechores.<verse eid="PRO 10:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 10:30"/>El justo no será sacudido jamás,</para>
  <para style="q" vid="PRO 10:30">Pero los perversos no habitarán la tierra.<verse eid="PRO 10:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 10:31"/>La boca del justo destila sabiduría,</para>
  <para style="q" vid="PRO 10:31">Pero la lengua perversa será cortada.<verse eid="PRO 10:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 10:32"/>Los labios del justo destilan lo aceptable,</para>
  <para style="q" vid="PRO 10:32">Pero la boca de los perversos lo que es pervertido.<verse eid="PRO 10:32"/></para>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 11:1"/>La balanza falsa es repugnancia a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PRO 11:1">Pero la pesa cabal es su complacencia.<verse eid="PRO 11:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 11:2"/>Cuando irrumpe la soberbia, viene la deshonra,</para>
  <para style="q" vid="PRO 11:2">Pero la sabiduría está con los humildes.<verse eid="PRO 11:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 11:3"/>La integridad de los rectos los guía,</para>
  <para style="q" vid="PRO 11:3">Pero la perversidad de los infieles los destruirá.<verse eid="PRO 11:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 11:4"/>De nada sirven las riquezas en el día de la ira,</para>
  <para style="q" vid="PRO 11:4">Pero la justicia librará de la muerte.<verse eid="PRO 11:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 11:5"/>La justicia del intachable le allana el camino,</para>
  <para style="q" vid="PRO 11:5">Pero el perverso caerá por su propia perversidad.<verse eid="PRO 11:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 11:6"/>La rectitud del justo lo librará,</para>
  <para style="q" vid="PRO 11:6">Pero el traidor quedará atrapado en su codicia.<verse eid="PRO 11:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 11:7"/>Cuando muere el impío, perece su esperanza.</para>
  <para style="q" vid="PRO 11:7">La esperanza de los hombres fuertes perecerá.<verse eid="PRO 11:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 11:8"/>El justo es librado de la tribulación,</para>
  <para style="q" vid="PRO 11:8">Pero el perverso toma su lugar.<verse eid="PRO 11:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 11:9"/>El impío hunde al prójimo con su boca,</para>
  <para style="q" vid="PRO 11:9">Pero los justos serán librados por medio del conocimiento.<verse eid="PRO 11:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 11:10"/>La ciudad festeja el éxito de los justos,</para>
  <para style="q" vid="PRO 11:10">Y cuando perecen los impíos canta de júbilo.<verse eid="PRO 11:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 11:11"/>Con la bendición de los rectos la ciudad prospera,</para>
  <para style="q" vid="PRO 11:11">Pero la boca de los perversos la arruina.<verse eid="PRO 11:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 11:12"/>El que desprecia al prójimo no tiene juicio,</para>
  <para style="q" vid="PRO 11:12">Pero el hombre de entendimiento calla.<verse eid="PRO 11:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 11:13"/>El que anda chismeando revela secretos,</para>
  <para style="q" vid="PRO 11:13">Pero el hombre que es de espíritu fiel se guarda el asunto.<verse eid="PRO 11:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 11:14"/>Cuando falta dirección, el pueblo cae,</para>
  <para style="q" vid="PRO 11:14">Pero en la multitud de consejeros hay liberación.<verse eid="PRO 11:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 11:15"/>El que sale fiador del extraño se perjudica,</para>
  <para style="q" vid="PRO 11:15">Pero el que aborrece ser garante vive seguro.<verse eid="PRO 11:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 11:16"/>La mujer agraciada adquiere honra,</para>
  <para style="q" vid="PRO 11:16">Y los hombres audaces adquieren riquezas.<verse eid="PRO 11:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 11:17"/>El misericordioso hace bien a su alma,</para>
  <para style="q" vid="PRO 11:17">Pero el cruel daña su propia carne.<verse eid="PRO 11:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 11:18"/>El perverso logra ganancias engañosas,</para>
  <para style="q" vid="PRO 11:18">Pero el que siembra justicia tiene galardón seguro.<verse eid="PRO 11:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 11:19"/>La firmeza de rectitud es para vida,</para>
  <para style="q" vid="PRO 11:19">Pero el que sigue la perversidad busca su propia muerte.<verse eid="PRO 11:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 11:20"/>Repugnancia a <char style="nd">Yavé</char> son los de corazón perverso,</para>
  <para style="q" vid="PRO 11:20">Pero los de camino intachable son su deleite.<verse eid="PRO 11:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 11:21"/>Con toda certeza, el malo no quedará sin castigo,</para>
  <para style="q" vid="PRO 11:21">Pero la descendencia de los justos será librada.<verse eid="PRO 11:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 11:22"/>Como anillo de oro en el hocico de un cerdo,</para>
  <para style="q" vid="PRO 11:22">Es la mujer hermosa que carece de discreción.<verse eid="PRO 11:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 11:23"/>El anhelo de los justos es solo el bien,</para>
  <para style="q" vid="PRO 11:23">Pero la expectativa de los impíos es ira.<verse eid="PRO 11:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 11:24"/>Hay quienes reparten,</para>
  <para style="q" vid="PRO 11:24">Y más se les añade.</para>
  <para style="q" vid="PRO 11:24">Hay quienes retienen más de lo justo,</para>
  <para style="q" vid="PRO 11:24">Y acaban en la indigencia.<verse eid="PRO 11:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 11:25"/>El alma generosa será enriquecida,</para>
  <para style="q" vid="PRO 11:25">Y el que sacia a otros, también será saciado.<verse eid="PRO 11:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 11:26"/>El pueblo lo maldecirá al que acapara grano,</para>
  <para style="q" vid="PRO 11:26">Pero la cabeza del que lo vende obtendrá bendición.<verse eid="PRO 11:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 11:27"/>El que busca el bien, halla favor,</para>
  <para style="q" vid="PRO 11:27">Pero el que busca el mal,</para>
  <para style="q" vid="PRO 11:27">Éste le vendrá.<verse eid="PRO 11:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 11:28"/>El que confía en sus riquezas caerá,</para>
  <para style="q" vid="PRO 11:28">Pero los justos reverdecerán como el follaje.<verse eid="PRO 11:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 11:29"/>El que perturba su casa,</para>
  <para style="q" vid="PRO 11:29">Heredará el viento,</para>
  <para style="q" vid="PRO 11:29">Y el necio será esclavo del sabio de corazón.<verse eid="PRO 11:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 11:30"/>El fruto del justo es árbol de vida,</para>
  <para style="q" vid="PRO 11:30">Y el que gana almas es sabio.<verse eid="PRO 11:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 11:31"/>Si el justo será recompensado en la tierra,</para>
  <para style="q" vid="PRO 11:31">¡Cuánto más el impío y el pecador!<verse eid="PRO 11:31"/></para>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 12:1"/>El que ama la corrección ama el conocimiento,</para>
  <para style="q" vid="PRO 12:1">Pero el que aborrece la reprensión es estúpido.<verse eid="PRO 12:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 12:2"/>El bueno obtendrá el favor de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PRO 12:2">Pero Él condenará al hombre de malos designios.<verse eid="PRO 12:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 12:3"/>El hombre no se afianzará por medio de la perversidad,</para>
  <para style="q" vid="PRO 12:3">Pero la raíz de los justos nunca será removida.<verse eid="PRO 12:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 12:4"/>La mujer virtuosa es corona de su esposo,</para>
  <para style="q" vid="PRO 12:4">Pero la que lo avergüenza es como carcoma en sus huesos.<verse eid="PRO 12:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 12:5"/>Los pensamientos de los justos son rectos,</para>
  <para style="q" vid="PRO 12:5">Pero los consejos de los impíos, engaño.<verse eid="PRO 12:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 12:6"/>Las palabras de los perversos son asechanzas mortales,</para>
  <para style="q" vid="PRO 12:6">Pero la boca de los rectos los librará.<verse eid="PRO 12:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 12:7"/>Se derrumban los perversos y ya no existen,</para>
  <para style="q" vid="PRO 12:7">Pero la casa de los justos permanecerá.<verse eid="PRO 12:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 12:8"/>Según su sabiduría es alabado el hombre,</para>
  <para style="q" vid="PRO 12:8">Pero el perverso de corazón será despreciado.<verse eid="PRO 12:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 12:9"/>Mejor es el poco estimado,</para>
  <para style="q" vid="PRO 12:9">Pero que tiene un esclavo,</para>
  <para style="q" vid="PRO 12:9">Que el que se alaba y carece de pan.<verse eid="PRO 12:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 12:10"/>El justo tiene en consideración la vida de su bestia,</para>
  <para style="q" vid="PRO 12:10">Pero aun la compasión de los perversos es cruel.<verse eid="PRO 12:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 12:11"/>El que labra su tierra, se saciará de pan,</para>
  <para style="q" vid="PRO 12:11">Pero el que persigue lo vano carece de entendimiento.<verse eid="PRO 12:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 12:12"/>El perverso codicia el botín de los perversos,</para>
  <para style="q" vid="PRO 12:12">Pero la raíz de los justos produce.<verse eid="PRO 12:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 12:13"/>En la transgresión de sus labios se enreda el perverso,</para>
  <para style="q" vid="PRO 12:13">Pero el justo escapará de la aflicción.<verse eid="PRO 12:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 12:14"/>De lo que uno habla, se saciará,</para>
  <para style="q" vid="PRO 12:14">Y por lo que uno hace, le pagarán.<verse eid="PRO 12:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 12:15"/>El camino del necio es recto ante sus propios ojos,</para>
  <para style="q" vid="PRO 12:15">Pero el que escucha el consejo es sabio.<verse eid="PRO 12:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 12:16"/>La ira del necio es conocida al instante,</para>
  <para style="q" vid="PRO 12:16">Pero el prudente pasa por alto la ofensa.<verse eid="PRO 12:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 12:17"/>El testigo veraz declara lo que es recto,</para>
  <para style="q" vid="PRO 12:17">Pero el testigo falso engaña.<verse eid="PRO 12:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 12:18"/>Hay quien pronuncia palabras como estocadas,</para>
  <para style="q" vid="PRO 12:18">Pero la boca de los sabios es medicina.<verse eid="PRO 12:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 12:19"/>El labio veraz permanece para siempre,</para>
  <para style="q" vid="PRO 12:19">Pero la boca mentirosa, solo un instante.<verse eid="PRO 12:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 12:20"/>Hay engaño en el corazón del que trama el mal,</para>
  <para style="q" vid="PRO 12:20">Pero para los consejeros de la paz hay alegría.<verse eid="PRO 12:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 12:21"/>Ninguna iniquidad es deseada por el justo,</para>
  <para style="q" vid="PRO 12:21">Pero los perversos están llenos de mal.<verse eid="PRO 12:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 12:22"/>Repugnancia es a <char style="nd">Yavé</char> el labio mentiroso,</para>
  <para style="q" vid="PRO 12:22">Pero su deleite está en los que obran fielmente.<verse eid="PRO 12:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 12:23"/>El hombre prudente encubre su conocimiento,</para>
  <para style="q" vid="PRO 12:23">Pero el corazón de los necios proclama su necedad.<verse eid="PRO 12:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 12:24"/>La mano del diligente señoreará,</para>
  <para style="q" vid="PRO 12:24">Pero la indolente será tributaria.<verse eid="PRO 12:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 12:25"/>La congoja abate el corazón del hombre,</para>
  <para style="q" vid="PRO 12:25">Pero la buena palabra lo alegra.<verse eid="PRO 12:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 12:26"/>El justo sirve de guía a su prójimo,</para>
  <para style="q" vid="PRO 12:26">Pero el camino de los perversos los hace errar.<verse eid="PRO 12:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 12:27"/>El indolente no asará ni su propia presa.</para>
  <para style="q" vid="PRO 12:27">¡Precioso tesoro del hombre es la diligencia!<verse eid="PRO 12:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 12:28"/>En la senda de la justicia está la vida,</para>
  <para style="q" vid="PRO 12:28">En su sendero no hay muerte.<verse eid="PRO 12:28"/></para>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 13:1"/>El hijo sabio acepta la disciplina de su padre,</para>
  <para style="q" vid="PRO 13:1">Pero el burlador no escucha la corrección.<verse eid="PRO 13:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 13:2"/>Del fruto de su boca el hombre comerá el bien,</para>
  <para style="q" vid="PRO 13:2">Pero el alma de los traidores se nutre de violencia.<verse eid="PRO 13:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 13:3"/>El que guarda su boca preserva su vida,</para>
  <para style="q" vid="PRO 13:3">Pero al que mucho abre sus labios le vendrá ruina.<verse eid="PRO 13:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 13:4"/>El alma del perezoso desea, y nada alcanza,</para>
  <para style="q" vid="PRO 13:4">Pero el alma del diligente será prosperada.<verse eid="PRO 13:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 13:5"/>El justo aborrece la palabra de mentira,</para>
  <para style="q" vid="PRO 13:5">Pero el perverso es odioso y trae deshonra.<verse eid="PRO 13:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 13:6"/>La justicia guarda al de perfecto camino,</para>
  <para style="q" vid="PRO 13:6">Pero la perversidad arruina al pecador.<verse eid="PRO 13:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 13:7"/>Hay quienes se enriquecen, y nada tienen,</para>
  <para style="q" vid="PRO 13:7">Y hay quienes son pobres, y tienen grandes riquezas.<verse eid="PRO 13:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 13:8"/>El rescate de la vida del hombre puede ser su riqueza,</para>
  <para style="q" vid="PRO 13:8">Pero el pobre no escucha censuras.<verse eid="PRO 13:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 13:9"/>La luz de los justos brilla de alegría,</para>
  <para style="q" vid="PRO 13:9">Pero la lámpara de los impíos se apagará.<verse eid="PRO 13:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 13:10"/>Con la soberbia solo se provoca contienda,</para>
  <para style="q" vid="PRO 13:10">Pero con los que admiten consejo está la sabiduría.<verse eid="PRO 13:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 13:11"/>Riqueza sin esfuerzo se desvanece,</para>
  <para style="q" vid="PRO 13:11">Pero el que recoge con mano laboriosa la aumenta.<verse eid="PRO 13:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 13:12"/>La esperanza que tarda es tormento del corazón,</para>
  <para style="q" vid="PRO 13:12">Pero árbol de vida es el deseo cumplido.<verse eid="PRO 13:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 13:13"/>El que menosprecia la palabra será destruido,</para>
  <para style="q" vid="PRO 13:13">Pero el que teme el mandamiento será recompensado.<verse eid="PRO 13:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 13:14"/>La enseñanza del sabio es manantial de vida,</para>
  <para style="q" vid="PRO 13:14">Que aparta de las trampas de la muerte.<verse eid="PRO 13:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 13:15"/>El buen entendimiento produce gracia,</para>
  <para style="q" vid="PRO 13:15">Pero el camino de los traidores es duro.<verse eid="PRO 13:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 13:16"/>El sagaz actúa con conocimiento,</para>
  <para style="q" vid="PRO 13:16">Pero el necio despliega su insensatez.<verse eid="PRO 13:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 13:17"/>El mensajero perverso caerá en desgracia,</para>
  <para style="q" vid="PRO 13:17">Pero el enviado fiel es medicina.<verse eid="PRO 13:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 13:18"/>Miseria y oprobio para el que rechaza la corrección,</para>
  <para style="q" vid="PRO 13:18">Pero el que acepta la reprensión será honrado.<verse eid="PRO 13:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 13:19"/>El deseo cumplido deleita el alma,</para>
  <para style="q" vid="PRO 13:19">Apartarse del mal es repugnancia a los necios.<verse eid="PRO 13:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 13:20"/>El que anda con sabios será sabio,</para>
  <para style="q" vid="PRO 13:20">Pero el que se reúne con los necios sufrirá daño.<verse eid="PRO 13:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 13:21"/>La adversidad persigue a los pecadores,</para>
  <para style="q" vid="PRO 13:21">Para los justos abunda el bien.<verse eid="PRO 13:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 13:22"/>La herencia del bueno queda en su familia,</para>
  <para style="q" vid="PRO 13:22">Pero la riqueza del pecador está reservada para el justo.<verse eid="PRO 13:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 13:23"/>El barbecho<note caller="+" style="f"><char style="fr" closed="false">13.23 </char><char style="ft" closed="false">Barbecho: Terreno labrantío que se deja sin sembrar.</char></note> de los pobres abunda en alimento,</para>
  <para style="q" vid="PRO 13:23">Pero es arrasado por falta de justicia.<verse eid="PRO 13:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 13:24"/>El que detiene el castigo aborrece a su hijo,</para>
  <para style="q" vid="PRO 13:24">El que lo ama prontamente lo disciplina.<verse eid="PRO 13:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 13:25"/>El justo come y sacia su apetito,</para>
  <para style="q" vid="PRO 13:25">Pero el estómago de los perversos padece escasez.<verse eid="PRO 13:25"/></para>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 14:1"/>La mujer sabia edifica su casa,</para>
  <para style="q" vid="PRO 14:1">La necia con sus manos la derriba.<verse eid="PRO 14:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 14:2"/>El que anda en su rectitud teme a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PRO 14:2">Pero el de caminos torcidos lo desprecia.<verse eid="PRO 14:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 14:3"/>En la boca del necio hay una vara para su espalda,</para>
  <para style="q" vid="PRO 14:3">Pero los sabios son protegidos por sus labios.<verse eid="PRO 14:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 14:4"/>Donde no hay bueyes el establo está limpio,</para>
  <para style="q" vid="PRO 14:4">Pero mucho rendimiento hay por la fuerza del buey.<verse eid="PRO 14:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 14:5"/>El testigo veraz no miente,</para>
  <para style="q" vid="PRO 14:5">Pero el testigo falso respira mentiras.<verse eid="PRO 14:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 14:6"/>El burlador busca la sabiduría y no la halla,</para>
  <para style="q" vid="PRO 14:6">Pero el conocimiento es fácil para el que tiene entendimiento.<verse eid="PRO 14:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 14:7"/>Apártate de la presencia del necio,</para>
  <para style="q" vid="PRO 14:7">Porque en él no hallarás palabras de conocimiento.<verse eid="PRO 14:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 14:8"/>Entender el camino es sabiduría del sagaz,</para>
  <para style="q" vid="PRO 14:8">Pero la necedad de los necios es engaño.<verse eid="PRO 14:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 14:9"/>Se burla el necio del pecado,</para>
  <para style="q" vid="PRO 14:9">Pero entre los rectos hay buena voluntad.<verse eid="PRO 14:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 14:10"/>El corazón conoce su propia amargura,</para>
  <para style="q" vid="PRO 14:10">Y en su alegría no participa el extraño.<verse eid="PRO 14:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 14:11"/>La casa de los perversos será asolada,</para>
  <para style="q" vid="PRO 14:11">Pero la morada de los rectos florecerá.<verse eid="PRO 14:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 14:12"/>Hay camino que al hombre parece derecho,</para>
  <para style="q" vid="PRO 14:12">Pero su fin es camino de muerte.<verse eid="PRO 14:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 14:13"/>Aun entre risas llora el corazón,</para>
  <para style="q" vid="PRO 14:13">Y el final de la alegría es tristeza.<verse eid="PRO 14:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 14:14"/>El insensato se hartará de sus propios caminos,</para>
  <para style="q" vid="PRO 14:14">Pero el hombre bueno estará satisfecho con el suyo.<verse eid="PRO 14:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 14:15"/>El ingenuo cree cualquier cosa,</para>
  <para style="q" vid="PRO 14:15">Pero el prudente considera sus pasos.<verse eid="PRO 14:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 14:16"/>El sabio teme y se aparta del mal,</para>
  <para style="q" vid="PRO 14:16">Pero el necio se lanza confiado.<verse eid="PRO 14:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 14:17"/>El que fácilmente se aíra hará locuras,</para>
  <para style="q" vid="PRO 14:17">Y el hombre perverso será aborrecido.<verse eid="PRO 14:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 14:18"/>Los ingenuos heredan insensatez,</para>
  <para style="q" vid="PRO 14:18">Pero el prudente se corona de conocimiento.<verse eid="PRO 14:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 14:19"/>Los perversos se inclinarán ante los buenos,</para>
  <para style="q" vid="PRO 14:19">Y los perversos ante las puertas del justo.<verse eid="PRO 14:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 14:20"/>El pobre es odiado aun por su vecino,</para>
  <para style="q" vid="PRO 14:20">Pero muchos son los que aman al rico.<verse eid="PRO 14:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 14:21"/>El que menosprecia a su prójimo peca,</para>
  <para style="q" vid="PRO 14:21">Pero el que se compadece de los pobres es inmensamente feliz.<verse eid="PRO 14:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 14:22"/>¿No yerran los que piensan mal?</para>
  <para style="q" vid="PRO 14:22">Pero misericordia y verdad son para los que piensan el bien.<verse eid="PRO 14:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 14:23"/>En toda labor hay fruto,</para>
  <para style="q" vid="PRO 14:23">Pero la palabra solo de labios lleva a la indigencia.<verse eid="PRO 14:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 14:24"/>Corona de los sabios es su riqueza,</para>
  <para style="q" vid="PRO 14:24">Pero la insensatez de los necios es locura.<verse eid="PRO 14:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 14:25"/>Un testigo veraz salva vidas,</para>
  <para style="q" vid="PRO 14:25">Pero el engañador habla mentiras.<verse eid="PRO 14:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 14:26"/>En el temor a <char style="nd">Yavé</char> hay fuerte confianza</para>
  <para style="q" vid="PRO 14:26">Que servirá de refugio a los hijos.<verse eid="PRO 14:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 14:27"/>El temor a <char style="nd">Yavé</char> es manantial de vida,</para>
  <para style="q" vid="PRO 14:27">Que aparta de las trampas de la muerte.<verse eid="PRO 14:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 14:28"/>En la multitud de pueblo está la gloria del rey,</para>
  <para style="q" vid="PRO 14:28">Y en la falta de pueblo la flaqueza del gobernante.<verse eid="PRO 14:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 14:29"/>El que tarda en airarse tiene gran entendimiento,</para>
  <para style="q" vid="PRO 14:29">Pero el impulsivo exalta la necedad.<verse eid="PRO 14:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 14:30"/>Un corazón tranquilo es vida para el cuerpo,</para>
  <para style="q" vid="PRO 14:30">Pero la envidia es carcoma en los huesos.<verse eid="PRO 14:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 14:31"/>El que oprime al pobre afrenta a su Hacedor,</para>
  <para style="q" vid="PRO 14:31">Pero lo honra el que favorece al necesitado.<verse eid="PRO 14:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 14:32"/>Por su propia maldad será derribado el perverso,</para>
  <para style="q" vid="PRO 14:32">Pero el justo tiene refugio en su muerte.<verse eid="PRO 14:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 14:33"/>En el corazón del que tiene entendimiento reposa la sabiduría,</para>
  <para style="q" vid="PRO 14:33">Aun en medio de necios se da a conocer.<verse eid="PRO 14:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 14:34"/>La justicia enaltece a una nación,</para>
  <para style="q" vid="PRO 14:34">Pero el pecado es afrenta para los pueblos.<verse eid="PRO 14:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 14:35"/>La benevolencia del rey es para el esclavo prudente,</para>
  <para style="q" vid="PRO 14:35">Pero su enojo contra el que lo avergüenza.<verse eid="PRO 14:35"/></para>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 15:1"/>La amable respuesta aplaca la ira,</para>
  <para style="q" vid="PRO 15:1">Pero la palabra hiriente aumenta el furor.<verse eid="PRO 15:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 15:2"/>La lengua de los sabios hace aceptable el conocimiento,</para>
  <para style="q" vid="PRO 15:2">La boca de los necios expresa insensatez.<verse eid="PRO 15:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 15:3"/>Los ojos de <char style="nd">Yavé</char> están en todo lugar,</para>
  <para style="q" vid="PRO 15:3">Y observan a malos y a buenos.<verse eid="PRO 15:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 15:4"/>Árbol de vida es la boca apacible,</para>
  <para style="q" vid="PRO 15:4">Pero la perversa es quebrantamiento de espíritu.<verse eid="PRO 15:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 15:5"/>El necio desprecia el consejo de su padre,</para>
  <para style="q" vid="PRO 15:5">Pero el que acepta la corrección es sagaz.<verse eid="PRO 15:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 15:6"/>En la casa del justo hay gran riqueza,</para>
  <para style="q" vid="PRO 15:6">Pero en las ganancias del perverso hay aflicción.<verse eid="PRO 15:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 15:7"/>Los labios de los sabios esparcen conocimiento,</para>
  <para style="q" vid="PRO 15:7">No así el corazón de los necios.<verse eid="PRO 15:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 15:8"/>Repugnancia a <char style="nd">Yavé</char> es el sacrificio de los perversos,</para>
  <para style="q" vid="PRO 15:8">Pero la oración de los rectos es su deleite.<verse eid="PRO 15:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 15:9"/>Repugnancia a <char style="nd">Yavé</char> es el camino del perverso,</para>
  <para style="q" vid="PRO 15:9">Pero Él ama al que sigue la justicia.<verse eid="PRO 15:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 15:10"/>La disciplina molesta al que abandona el camino.</para>
  <para style="q" vid="PRO 15:10">El que aborrece la corrección morirá.<verse eid="PRO 15:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 15:11"/>El <char style="tl">Seol</char> y el <char style="tl">Abadón</char><note caller="+" style="f"><char style="fr" closed="false">15.11 <char style="tl">Seol</char>: mundo de los muertos. <char style="tl">Abadón</char>: lugar de perdición.</char></note> están delante de <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PRO 15:11">¡Cuánto más los corazones de los hijos de hombres!<verse eid="PRO 15:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 15:12"/>El escarnecedor no ama al que lo reprende,</para>
  <para style="q" vid="PRO 15:12">Ni busca a los sabios.<verse eid="PRO 15:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 15:13"/>Un corazón alegre hermosea el rostro,</para>
  <para style="q" vid="PRO 15:13">Pero el dolor del corazón abate el ánimo.<verse eid="PRO 15:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 15:14"/>El corazón entendido busca el conocimiento,</para>
  <para style="q" vid="PRO 15:14">Pero la boca de los necios se apacienta de la insensatez.<verse eid="PRO 15:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 15:15"/>Todos los días del afligido son difíciles,</para>
  <para style="q" vid="PRO 15:15">Pero el de corazón alegre <char style="add">tiene</char> un banquete continuo.<verse eid="PRO 15:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 15:16"/>Más vale poco con el temor a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PRO 15:16">Que grandes tesoros con tumulto.<verse eid="PRO 15:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 15:17"/>Mejor es ración de legumbres donde hay amor,</para>
  <para style="q" vid="PRO 15:17">Que buey engordado donde hay rencor.<verse eid="PRO 15:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 15:18"/>El hombre iracundo provoca contiendas,</para>
  <para style="q" vid="PRO 15:18">Pero el lento para la ira apacigua la rencilla.<verse eid="PRO 15:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 15:19"/>El camino del perezoso es como un cercado de espinos,</para>
  <para style="q" vid="PRO 15:19">Pero la senda de los rectos es llana.<verse eid="PRO 15:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 15:20"/>El hijo sabio alegra al padre,</para>
  <para style="q" vid="PRO 15:20">Pero el hombre necio menosprecia a su madre.<verse eid="PRO 15:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 15:21"/>La necedad divierte al falto de entendimiento,</para>
  <para style="q" vid="PRO 15:21">Pero el hombre prudente endereza su andar.<verse eid="PRO 15:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 15:22"/>Sin consulta, los planes se frustran,</para>
  <para style="q" vid="PRO 15:22">Pero tienen éxito con muchos consejeros.<verse eid="PRO 15:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 15:23"/>El hombre se alegra con la respuesta de su boca.</para>
  <para style="q" vid="PRO 15:23">¡Cuán buena es la palabra oportuna!<verse eid="PRO 15:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 15:24"/>El prudente sube por el camino de la vida,</para>
  <para style="q" vid="PRO 15:24">Que lo aparta de la bajada al <char style="tl">Seol</char>.<verse eid="PRO 15:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 15:25"/>
    <char style="nd">Yavé</char> destruye la casa del soberbio,</para>
  <para style="q" vid="PRO 15:25">Pero afirma el lindero de la viuda.<verse eid="PRO 15:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 15:26"/>Repugnancia a <char style="nd">Yavé</char> son los pensamientos del perverso,</para>
  <para style="q" vid="PRO 15:26">Pero las palabras de los puros le son placenteras.<verse eid="PRO 15:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 15:27"/>El que aspira a ganancias deshonestas arruina su casa,</para>
  <para style="q" vid="PRO 15:27">Pero el que aborrece el soborno vivirá.<verse eid="PRO 15:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 15:28"/>El corazón del justo medita la respuesta,</para>
  <para style="q" vid="PRO 15:28">Pero la boca del perverso derrama malas cosas.<verse eid="PRO 15:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 15:29"/>
    <char style="nd">Yavé</char> está lejos de los perversos,</para>
  <para style="q" vid="PRO 15:29">Pero escucha la oración de los justos.<verse eid="PRO 15:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 15:30"/>La luz de los ojos alegra el corazón,</para>
  <para style="q" vid="PRO 15:30">Y una buena noticia nutre los huesos.<verse eid="PRO 15:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 15:31"/>Oído que escucha sana reprensión,</para>
  <para style="q" vid="PRO 15:31">Vivirá entre los sabios.<verse eid="PRO 15:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 15:32"/>El que rechaza la corrección menosprecia su vida,</para>
  <para style="q" vid="PRO 15:32">El que escucha la amonestación adquiere entendimiento.<verse eid="PRO 15:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 15:33"/>El temor a <char style="nd">Yavé</char> es escuela de sabiduría,</para>
  <para style="q" vid="PRO 15:33">Y antes del honor está la humildad.<verse eid="PRO 15:33"/></para>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="s1">Con respecto a la vida y a la conducta</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 16:1"/>Del hombre son los planes del corazón,</para>
  <para style="q" vid="PRO 16:1">Pero de <char style="nd">Yavé</char> la respuesta de la boca.<verse eid="PRO 16:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 16:2"/>Al hombre le parecen limpios todos sus caminos,</para>
  <para style="q" vid="PRO 16:2">Pero <char style="nd">Yavé</char> pesa los espíritus.<verse eid="PRO 16:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 16:3"/>Encomienda a <char style="nd">Yavé</char> tus obras,</para>
  <para style="q" vid="PRO 16:3">Y tus pensamientos serán afirmados.<verse eid="PRO 16:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 16:4"/>
    <char style="nd">Yavé</char> mismo hizo todas las cosas para Él,</para>
  <para style="q" vid="PRO 16:4">Aun al perverso para el día malo.<verse eid="PRO 16:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 16:5"/>Repugnancia es a <char style="nd">Yavé</char> todo altivo de corazón,</para>
  <para style="q" vid="PRO 16:5">Ciertamente no quedará impune.<verse eid="PRO 16:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 16:6"/>Por la misericordia y la verdad se borra la iniquidad,</para>
  <para style="q" vid="PRO 16:6">Y por el temor a <char style="nd">Yavé</char> se aparta uno del mal.<verse eid="PRO 16:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 16:7"/>Cuando los caminos del hombre agradan a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PRO 16:7">Él hace que aun sus enemigos estén en paz con él.<verse eid="PRO 16:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 16:8"/>Mejor es un poco con justicia,</para>
  <para style="q" vid="PRO 16:8">Que gran ganancia con injusticia.<verse eid="PRO 16:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 16:9"/>El corazón del hombre traza su camino,</para>
  <para style="q" vid="PRO 16:9">Pero <char style="nd">Yavé</char> afirma sus pasos.<verse eid="PRO 16:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 16:10"/>Hay una decisión divina en los labios del rey:</para>
  <para style="q" vid="PRO 16:10">Que su boca no yerre en la sentencia.<verse eid="PRO 16:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 16:11"/>Peso y balanzas justas son de <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PRO 16:11">Todas las pesas de la bolsa son obra suya.<verse eid="PRO 16:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 16:12"/>Repugnancia es que los reyes cometan perversidad,</para>
  <para style="q" vid="PRO 16:12">Porque el trono se afianza con la justicia.<verse eid="PRO 16:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 16:13"/>Los reyes aprueban los labios sinceros,</para>
  <para style="q" vid="PRO 16:13">Y aman al que habla lo recto.<verse eid="PRO 16:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 16:14"/>La ira del rey es mensajero de muerte,</para>
  <para style="q" vid="PRO 16:14">Pero el hombre sabio lo apaciguará.<verse eid="PRO 16:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 16:15"/>En la serenidad del rostro del rey está la vida,</para>
  <para style="q" vid="PRO 16:15">Y su favor es como nube de lluvia tardía.<verse eid="PRO 16:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 16:16"/>Mejor es adquirir sabiduría que oro,</para>
  <para style="q" vid="PRO 16:16">Y obtener entendimiento es más que plata.<verse eid="PRO 16:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 16:17"/>El camino de los rectos es apartarse del mal,</para>
  <para style="q" vid="PRO 16:17">El que guarda su camino preserva su vida.<verse eid="PRO 16:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 16:18"/>Antes del quebrantamiento está la soberbia,</para>
  <para style="q" vid="PRO 16:18">Y antes de la caída, la altivez de espíritu.<verse eid="PRO 16:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 16:19"/>Es mejor ser humilde de espíritu con los humildes</para>
  <para style="q" vid="PRO 16:19">Que repartir despojos con los soberbios.<verse eid="PRO 16:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 16:20"/>El que atiende la palabra hallará el bien,</para>
  <para style="q" vid="PRO 16:20">Y el que confía en <char style="nd">Yavé</char> es inmensamente feliz.<verse eid="PRO 16:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 16:21"/>El sabio de corazón será llamado entendido,</para>
  <para style="q" vid="PRO 16:21">Y la dulzura de labios aumenta el saber.<verse eid="PRO 16:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 16:22"/>Manantial de vida es el entendimiento para el que lo posee,</para>
  <para style="q" vid="PRO 16:22">Pero el castigo de los necios es su misma necedad.<verse eid="PRO 16:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 16:23"/>El corazón del sabio muestra prudente su boca,</para>
  <para style="q" vid="PRO 16:23">Y sus labios aumentan el saber.<verse eid="PRO 16:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 16:24"/>Panal de miel son las palabras agradables.</para>
  <para style="q" vid="PRO 16:24">Dulces para el alma y saludables para los huesos.<verse eid="PRO 16:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 16:25"/>Hay camino que al hombre <char style="add">parece</char> derecho,</para>
  <para style="q" vid="PRO 16:25">Pero su fin es camino de muerte.<verse eid="PRO 16:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 16:26"/>La persona que labora para ella misma</para>
  <para style="q" vid="PRO 16:26">Trabaja porque su boca lo obliga.<verse eid="PRO 16:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 16:27"/>El hombre perverso desentierra el mal,</para>
  <para style="q" vid="PRO 16:27">Y lleva en sus labios fuego abrasador.<verse eid="PRO 16:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 16:28"/>El hombre perverso provoca contienda,</para>
  <para style="q" vid="PRO 16:28">Y el chismoso separa a los mejores amigos.<verse eid="PRO 16:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 16:29"/>El hombre violento persuade a su amigo,</para>
  <para style="q" vid="PRO 16:29">Y lo hace andar por camino no bueno,<verse eid="PRO 16:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 16:30"/>El que guiña los ojos trama perversidades,</para>
  <para style="q" vid="PRO 16:30">El que frunce los labios realiza el mal.<verse eid="PRO 16:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 16:31"/>Corona de honra es la cabeza cana,</para>
  <para style="q" vid="PRO 16:31">Se halla en el camino de la justicia.<verse eid="PRO 16:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 16:32"/>El lento para la ira es mejor que el valiente,</para>
  <para style="q" vid="PRO 16:32">Y el que domina su espíritu que el que captura una ciudad.<verse eid="PRO 16:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 16:33"/>Las suertes se echan sobre la ropa,</para>
  <para style="q" vid="PRO 16:33">Pero toda decisión es de <char style="nd">Yavé</char>.<verse eid="PRO 16:33"/></para>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 17:1"/>Más vale un bocado seco y con tranquilidad,</para>
  <para style="q" vid="PRO 17:1">Que casa llena de sacrificios injustos con contienda.<verse eid="PRO 17:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 17:2"/>El esclavo prudente se impondrá al hijo que deshonra,</para>
  <para style="q" vid="PRO 17:2">Y con los hermanos compartirá la herencia.<verse eid="PRO 17:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 17:3"/>El crisol para la plata y la hornaza para el oro,</para>
  <para style="q" vid="PRO 17:3">Pero <char style="nd">Yavé</char> prueba los corazones.<verse eid="PRO 17:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 17:4"/>El malhechor hace caso al labio inicuo,</para>
  <para style="q" vid="PRO 17:4">Y el mentiroso escucha la boca detractora.<verse eid="PRO 17:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 17:5"/>El que se burla del pobre afrenta a su Hacedor,</para>
  <para style="q" vid="PRO 17:5">El que se alegra de la calamidad no quedará impune.<verse eid="PRO 17:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 17:6"/>Corona de los ancianos son sus nietos,</para>
  <para style="q" vid="PRO 17:6">Honra de los hijos son sus padres.<verse eid="PRO 17:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 17:7"/>No conviene al necio el lenguaje excelente,</para>
  <para style="q" vid="PRO 17:7">¡Cuánto menos al príncipe el labio mentiroso!<verse eid="PRO 17:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 17:8"/>El soborno le parece piedra mágica al que lo practica:</para>
  <para style="q" vid="PRO 17:8">A donde se dirija halla prosperidad.<verse eid="PRO 17:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 17:9"/>El que busca amistad encubre la falta,</para>
  <para style="q" vid="PRO 17:9">Pero el que la divulga aparta al amigo.<verse eid="PRO 17:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 17:10"/>Una sola reprensión es más eficaz para el prudente</para>
  <para style="q" vid="PRO 17:10">Que 100 golpes al imprudente.<verse eid="PRO 17:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 17:11"/>El rebelde no busca sino el mal.</para>
  <para style="q" vid="PRO 17:11">Un mensajero cruel será enviado contra él.<verse eid="PRO 17:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 17:12"/>Mejor es encontrarse con una osa despojada de sus crías,</para>
  <para style="q" vid="PRO 17:12">Que con un necio empeñado en su insensatez.<verse eid="PRO 17:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 17:13"/>Al que paga cosas malas por cosas buenas,</para>
  <para style="q" vid="PRO 17:13">El mal no se aparta de su casa.<verse eid="PRO 17:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 17:14"/>El que comienza una contienda suelta las aguas.</para>
  <para style="q" vid="PRO 17:14">Desiste, pues, antes que estalle el pleito.<verse eid="PRO 17:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 17:15"/>El que justifica al impío y el que condena al justo,</para>
  <para style="q" vid="PRO 17:15">Ambos igualmente son repugnancia a <char style="nd">Yavé</char>.<verse eid="PRO 17:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 17:16"/>¿Para qué sirve el dinero en mano del necio?</para>
  <para style="q" vid="PRO 17:16">¿Para adquirir sabiduría sin entendimiento?<verse eid="PRO 17:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 17:17"/>En todo tiempo ama el amigo,</para>
  <para style="q" vid="PRO 17:17">Y el hermano nace para <char style="add">el tiempo</char> de angustia.<verse eid="PRO 17:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 17:18"/>El hombre carente de entendimiento da pronto la mano,</para>
  <para style="q" vid="PRO 17:18">Y sale fiador de su vecino.<verse eid="PRO 17:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 17:19"/>El que ama la transgresión ama la disputa,</para>
  <para style="q" vid="PRO 17:19">Y el que abre mucho la puerta busca su ruina.<verse eid="PRO 17:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 17:20"/>El corazón engañoso no halla el bien,</para>
  <para style="q" vid="PRO 17:20">Y el de boca perversa cae en el mal.<verse eid="PRO 17:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 17:21"/>El que engendra a un insensato le resulta para su tristeza,</para>
  <para style="q" vid="PRO 17:21">Y el padre de un necio no tiene alegría.<verse eid="PRO 17:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 17:22"/>El corazón alegre es una buena medicina,</para>
  <para style="q" vid="PRO 17:22">Pero un espíritu quebrantado seca los huesos.<verse eid="PRO 17:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 17:23"/>El perverso toma soborno de su seno</para>
  <para style="q" vid="PRO 17:23">Para pervertir el curso de la justicia.<verse eid="PRO 17:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 17:24"/>En el rostro del entendido se refleja la sabiduría,</para>
  <para style="q" vid="PRO 17:24">Pero los ojos del necio vagan hasta el extremo de la tierra.<verse eid="PRO 17:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 17:25"/>El hijo necio es pesadumbre de su padre,</para>
  <para style="q" vid="PRO 17:25">Y amargura de la que lo dio a luz.<verse eid="PRO 17:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 17:26"/>Ciertamente no es bueno condenar al justo,</para>
  <para style="q" vid="PRO 17:26">Ni golpear a nobles que hacen lo recto.<verse eid="PRO 17:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 17:27"/>El que refrena sus palabras tiene entendimiento,</para>
  <para style="q" vid="PRO 17:27">Y el de espíritu sereno es hombre prudente.<verse eid="PRO 17:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 17:28"/>Aun el necio cuando calla es tenido por sabio,</para>
  <para style="q" vid="PRO 17:28">El que cierra sus labios es entendido.<verse eid="PRO 17:28"/></para>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 18:1"/>El que se desvía busca su propio deseo,</para>
  <para style="q" vid="PRO 18:1">Y se enfada contra todo consejo.<verse eid="PRO 18:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 18:2"/>El necio no se deleita en el entendimiento,</para>
  <para style="q" vid="PRO 18:2">Sino solo en exponer lo que piensa.<verse eid="PRO 18:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 18:3"/>Cuando viene la impiedad viene también el desprecio,</para>
  <para style="q" vid="PRO 18:3">Y con la deshonra viene la afrenta.<verse eid="PRO 18:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 18:4"/>Las palabras de la boca de un hombre son aguas profundas,</para>
  <para style="q" vid="PRO 18:4">Torrente caudaloso es la fuente de la sabiduría.<verse eid="PRO 18:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 18:5"/>No es bueno mostrar preferencia por el perverso,</para>
  <para style="q" vid="PRO 18:5">Para desviar al justo en el juicio.<verse eid="PRO 18:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 18:6"/>Los labios del necio traen contienda,</para>
  <para style="q" vid="PRO 18:6">Y su boca clama por azotes.<verse eid="PRO 18:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 18:7"/>La boca del necio es su ruina,</para>
  <para style="q" vid="PRO 18:7">Y sus labios, trampa para su alma.<verse eid="PRO 18:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 18:8"/>Las palabras del chismoso son como delicados manjares</para>
  <para style="q" vid="PRO 18:8">Que penetran hasta el fondo de sus órganos internos.<verse eid="PRO 18:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 18:9"/>El negligente en su obra es hermano del disipador.<verse eid="PRO 18:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 18:10"/>Torre fuerte es el Nombre de <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PRO 18:10">A ella corre el justo y está a salvo.<verse eid="PRO 18:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 18:11"/>Las riquezas del rico son su ciudad fortificada,</para>
  <para style="q" vid="PRO 18:11">Como un alto muro en su imaginación.<verse eid="PRO 18:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 18:12"/>Antes del quebrantamiento el corazón del hombre es altivo,</para>
  <para style="q" vid="PRO 18:12">Y antes de la honra está la humildad.<verse eid="PRO 18:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 18:13"/>Al que responde antes de escuchar,</para>
  <para style="q" vid="PRO 18:13">Le es insensatez y deshonra.<verse eid="PRO 18:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 18:14"/>El buen ánimo del hombre soporta su enfermedad,</para>
  <para style="q" vid="PRO 18:14">Pero el ánimo abatido, ¿quién lo soportará?<verse eid="PRO 18:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 18:15"/>El corazón del entendido adquiere conocimiento,</para>
  <para style="q" vid="PRO 18:15">Y conocimiento busca el oído de los sabios.<verse eid="PRO 18:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 18:16"/>El regalo de un hombre le abre camino</para>
  <para style="q" vid="PRO 18:16">Y lo conduce a la presencia de los grandes.<verse eid="PRO 18:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 18:17"/>El primero que se defiende parece ser justo,</para>
  <para style="q" vid="PRO 18:17">Hasta que llega su prójimo y lo investiga.<verse eid="PRO 18:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 18:18"/>Echar suerte pone fin a la disputa,</para>
  <para style="q" vid="PRO 18:18">Y decide entre los poderosos.<verse eid="PRO 18:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 18:19"/>El hermano ofendido es más tenaz que ciudad fuerte,</para>
  <para style="q" vid="PRO 18:19">Y los litigios, más que los cerrojos de una fortaleza.<verse eid="PRO 18:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 18:20"/>Con el fruto de la boca del hombre llenará su estómago.</para>
  <para style="q" vid="PRO 18:20">Con el producto de sus labios se saciará.<verse eid="PRO 18:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 18:21"/>La muerte y la vida están en poder de la boca.</para>
  <para style="q" vid="PRO 18:21">El que la ama comerá su fruto.<verse eid="PRO 18:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 18:22"/>El que halla esposa halla el bien,</para>
  <para style="q" vid="PRO 18:22">Y alcanza el favor de <char style="nd">Yavé</char>.<verse eid="PRO 18:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 18:23"/>El pobre se expresa con súplicas,</para>
  <para style="q" vid="PRO 18:23">El rico responde con durezas.<verse eid="PRO 18:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 18:24"/>Hay amigos que causan ruina al hombre,</para>
  <para style="q" vid="PRO 18:24">Pero hay un amigo más fiel que un hermano.<verse eid="PRO 18:24"/></para>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 19:1"/>Mejor es el pobre que anda en su integridad,</para>
  <para style="q" vid="PRO 19:1">Que el de labios perversos y necio.<verse eid="PRO 19:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 19:2"/>La persona sin conocimiento no es buena,</para>
  <para style="q" vid="PRO 19:2">Y el que se apresura con sus pies tropieza.<verse eid="PRO 19:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 19:3"/>La insensatez del hombre destruye su camino,</para>
  <para style="q" vid="PRO 19:3">Y luego su corazón se irrita contra <char style="nd">Yavé</char>.<verse eid="PRO 19:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 19:4"/>Las riquezas atraen muchos amigos,</para>
  <para style="q" vid="PRO 19:4">Pero el pobre es abandonado por su amigo.<verse eid="PRO 19:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 19:5"/>El testigo falso no quedará impune,</para>
  <para style="q" vid="PRO 19:5">Y el que alienta mentiras no escapará.<verse eid="PRO 19:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 19:6"/>Muchos buscan el favor del generoso,</para>
  <para style="q" vid="PRO 19:6">Y todos son amigos del hombre que da regalos.<verse eid="PRO 19:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 19:7"/>Todos los hermanos del pobre lo aborrecen,</para>
  <para style="q" vid="PRO 19:7">¡Cuánto más se alejarán de él sus amigos!</para>
  <para style="q" vid="PRO 19:7">Los persigue con palabras, pero ya no están.<verse eid="PRO 19:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 19:8"/>El que adquiere cordura se ama a sí mismo,</para>
  <para style="q" vid="PRO 19:8">Al que guarda la prudencia le irá bien.<verse eid="PRO 19:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 19:9"/>El testigo falso no se irá sin castigo,</para>
  <para style="q" vid="PRO 19:9">Y el que alienta mentiras perecerá.<verse eid="PRO 19:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 19:10"/>El lujo no conviene al insensato,</para>
  <para style="q" vid="PRO 19:10">¡Cuánto menos al esclavo tener dominio sobre gobernantes!<verse eid="PRO 19:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 19:11"/>La cordura del hombre detiene su furor,</para>
  <para style="q" vid="PRO 19:11">Y su honra es pasar por alto la ofensa.<verse eid="PRO 19:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 19:12"/>Rugido de león es la amenaza del rey,</para>
  <para style="q" vid="PRO 19:12">Rocío sobre la hierba su favor.<verse eid="PRO 19:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 19:13"/>El hijo necio es la ruina de su padre,</para>
  <para style="q" vid="PRO 19:13">Y gotera continua las contiendas de una esposa.<verse eid="PRO 19:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 19:14"/>Casa y fortuna son herencia de los padres,</para>
  <para style="q" vid="PRO 19:14">Pero la esposa prudente es un regalo de <char style="nd">Yavé</char>.<verse eid="PRO 19:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 19:15"/>La pereza produce un sueño profundo,</para>
  <para style="q" vid="PRO 19:15">Y la persona ociosa pasará hambre.<verse eid="PRO 19:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 19:16"/>El que guarda el mandamiento, guarda su vida,</para>
  <para style="q" vid="PRO 19:16">Pero el que menosprecia sus caminos morirá.<verse eid="PRO 19:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 19:17"/>El que da al pobre presta a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PRO 19:17">Y Él le dará su recompensa.<verse eid="PRO 19:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 19:18"/>Corrige a tu hijo mientras haya esperanza,</para>
  <para style="q" vid="PRO 19:18">Pero no se exceda tu alma para destruirlo.<verse eid="PRO 19:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 19:19"/>El hombre de gran ira sufrirá castigo,</para>
  <para style="q" vid="PRO 19:19">Pero si lo perdonas, lo tendrá que aumentar.<verse eid="PRO 19:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 19:20"/>Escucha el consejo y acepta la corrección</para>
  <para style="q" vid="PRO 19:20">Para que seas sabio.<verse eid="PRO 19:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 19:21"/>Muchos designios hay en el corazón del hombre,</para>
  <para style="q" vid="PRO 19:21">Pero el propósito de <char style="nd">Yavé</char> es el que prevalece.<verse eid="PRO 19:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 19:22"/>Lo que los hombres aprecian es la lealtad:</para>
  <para style="q" vid="PRO 19:22">Es preferible ser pobre que engañador.<verse eid="PRO 19:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 19:23"/>El temor a <char style="nd">Yavé</char> es para vida,</para>
  <para style="q" vid="PRO 19:23">El que lo tiene vivirá satisfecho,</para>
  <para style="q" vid="PRO 19:23">Y no será visitado por el mal.<verse eid="PRO 19:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 19:24"/>El perezoso mete la mano en el plato,</para>
  <para style="q" vid="PRO 19:24">Pero ni aun a su boca lo llevará.<verse eid="PRO 19:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 19:25"/>Golpea al burlador, y el ingenuo será prudente,</para>
  <para style="q" vid="PRO 19:25">Corrige al entendido, y aumentará su saber.<verse eid="PRO 19:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 19:26"/>El que roba a su padre y echa fuera a su madre</para>
  <para style="q" vid="PRO 19:26">Es hijo que trae vergüenza y deshonra.<verse eid="PRO 19:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 19:27"/>Hijo mío, deja de oír consejos</para>
  <para style="q" vid="PRO 19:27">Que te apartan de las palabras de sabiduría.<verse eid="PRO 19:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 19:28"/>El testigo perverso se burla de la justicia,</para>
  <para style="q" vid="PRO 19:28">Y la boca de los impíos encubre la iniquidad.<verse eid="PRO 19:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 19:29"/>Hay castigos preparados para los burladores,</para>
  <para style="q" vid="PRO 19:29">Y azotes para la espalda del necio.<verse eid="PRO 19:29"/></para>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 20:1"/>El vino es burlador y alborotador el licor,</para>
  <para style="q" vid="PRO 20:1">Y cualquiera que en ello se desvía no es sabio.<verse eid="PRO 20:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 20:2"/>Como rugido de león es la ira del rey,</para>
  <para style="q" vid="PRO 20:2">El que provoca su ira expone su propia vida.<verse eid="PRO 20:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 20:3"/>Honra del hombre es evitar la contienda,</para>
  <para style="q" vid="PRO 20:3">Pero todo insensato se envolverá en ella.<verse eid="PRO 20:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 20:4"/>En otoño no ara el holgazán,</para>
  <para style="q" vid="PRO 20:4">Rebuscará en la cosecha y nada hallará.<verse eid="PRO 20:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 20:5"/>Como agua profunda es el propósito en el corazón del hombre,</para>
  <para style="q" vid="PRO 20:5">Pero el hombre entendido logrará extraerlo.<verse eid="PRO 20:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 20:6"/>Muchos hombres proclaman su propia bondad,</para>
  <para style="q" vid="PRO 20:6">Pero un hombre fiel, ¿quién lo hallará?<verse eid="PRO 20:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 20:7"/>El justo camina en su integridad,</para>
  <para style="q" vid="PRO 20:7">Después de él, sus hijos son muy dichosos.<verse eid="PRO 20:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 20:8"/>Un rey sentado en el tribunal,</para>
  <para style="q" vid="PRO 20:8">Con su mirada disipa toda maldad.<verse eid="PRO 20:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 20:9"/>¿Quién podrá decir:</para>
  <para style="q" vid="PRO 20:9">Tengo mi conciencia limpia,</para>
  <para style="q" vid="PRO 20:9">Estoy purificado de mi pecado?<verse eid="PRO 20:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 20:10"/>Pesa falsa y medida falsa,</para>
  <para style="q" vid="PRO 20:10">Ambas son repugnancia a <char style="nd">Yavé</char>.<verse eid="PRO 20:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 20:11"/>Aun el muchacho es conocido por sus hechos,</para>
  <para style="q" vid="PRO 20:11">Si su conducta es limpia y recta.<verse eid="PRO 20:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 20:12"/>El oído que oye y el ojo que ve,</para>
  <para style="q" vid="PRO 20:12">Ambas cosas las hizo <char style="nd">Yavé</char>.<verse eid="PRO 20:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 20:13"/>No ames el sueño</para>
  <para style="q" vid="PRO 20:13">No sea que te empobrezcas.</para>
  <para style="q" vid="PRO 20:13">Abre tus ojos y te saciarás de pan.<verse eid="PRO 20:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 20:14"/>Es malo, es malo, dice el comprador,</para>
  <para style="q" vid="PRO 20:14">Pero cuando se va, se jacta.<verse eid="PRO 20:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 20:15"/>Existe el oro y multitud de piedras preciosas,</para>
  <para style="q" vid="PRO 20:15">Pero los labios sabios son algo más precioso.<verse eid="PRO 20:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 20:16"/>Tómale la ropa al que salió fiador de un extraño,</para>
  <para style="q" vid="PRO 20:16">Y tómale prenda cuando da garantía a los forasteros.<verse eid="PRO 20:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 20:17"/>Sabroso es al hombre el pan mal adquirido,</para>
  <para style="q" vid="PRO 20:17">Pero después su boca estará llena de fragmentos de piedra.<verse eid="PRO 20:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 20:18"/>Confirma los planes por medio del consejo,</para>
  <para style="q" vid="PRO 20:18">Y con sabias estrategias haz la guerra.<verse eid="PRO 20:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 20:19"/>El que revela secretos levanta calumnia,</para>
  <para style="q" vid="PRO 20:19">Por tanto, no te metas con un chismoso.<verse eid="PRO 20:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 20:20"/>Al que insulte a su padre o a su madre,</para>
  <para style="q" vid="PRO 20:20">Se le apagará su lámpara en medio de la oscuridad.<verse eid="PRO 20:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 20:21"/>Herencia adquirida con robo al comienzo,</para>
  <para style="q" vid="PRO 20:21">Al fin no será bendita.<verse eid="PRO 20:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 20:22"/>No digas: Yo me vengaré.</para>
  <para style="q" vid="PRO 20:22">Espera a <char style="nd">Yavé</char>, y Él te salvará.<verse eid="PRO 20:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 20:23"/>Las pesas desiguales son repugnancia a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PRO 20:23">Y una balanza con trampa no es buena.<verse eid="PRO 20:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 20:24"/>De <char style="nd">Yavé</char> son los pasos del hombre,</para>
  <para style="q" vid="PRO 20:24">¿Cómo, pues, podrá el hombre entender su camino?<verse eid="PRO 20:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 20:25"/>Trampa es al hombre el voto apresurado,</para>
  <para style="q" vid="PRO 20:25">Y después de hacerlo, reflexionar.<verse eid="PRO 20:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 20:26"/>El rey sabio dispersa a los perversos,</para>
  <para style="q" vid="PRO 20:26">Y hace pasar sobre ellos la rueda de trillar.<verse eid="PRO 20:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 20:27"/>Lámpara de <char style="nd">Yavé</char> es el espíritu del hombre,</para>
  <para style="q" vid="PRO 20:27">Que escudriña lo más recóndito del ser.<verse eid="PRO 20:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 20:28"/>Misericordia y verdad preservan al rey,</para>
  <para style="q" vid="PRO 20:28">Y la clemencia sustenta su trono.<verse eid="PRO 20:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 20:29"/>La gloria de los jóvenes es su fortaleza,</para>
  <para style="q" vid="PRO 20:29">Y el esplendor de los ancianos, sus canas.<verse eid="PRO 20:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 20:30"/>Las marcas de los azotes purifican del mal,</para>
  <para style="q" vid="PRO 20:30">Y los golpes llegan a lo íntimo del corazón.<verse eid="PRO 20:30"/></para>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 21:1"/>Como los repartimientos de las aguas,</para>
  <para style="q" vid="PRO 21:1">Así el corazón del rey está en la mano de <char style="nd">Yavé</char>.</para>
  <para style="q" vid="PRO 21:1">A todo lo que quiere lo inclina.<verse eid="PRO 21:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 21:2"/>Todo camino del hombre es recto en su propia opinión,</para>
  <para style="q" vid="PRO 21:2">Pero <char style="nd">Yavé</char> pesa los corazones.<verse eid="PRO 21:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 21:3"/>
    <char style="nd">Yavé</char> prefiere el derecho y la justicia en vez de los sacrificios.<verse eid="PRO 21:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 21:4"/>Ojos altivos, corazón arrogante,</para>
  <para style="q" vid="PRO 21:4">Y la lámpara de los perversos son pecado.<verse eid="PRO 21:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 21:5"/>Los planes del diligente solo traen ganancia,</para>
  <para style="q" vid="PRO 21:5">Los del precipitado, solo indigencia.<verse eid="PRO 21:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 21:6"/>Acumular tesoros con boca mentirosa</para>
  <para style="q" vid="PRO 21:6">Es vanidad ilusoria y trampa de muerte.<verse eid="PRO 21:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 21:7"/>La violencia de los impíos los arrastrará,</para>
  <para style="q" vid="PRO 21:7">Por cuanto se niegan a obrar con justicia.<verse eid="PRO 21:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 21:8"/>La senda del vicioso es torcida y extraña,</para>
  <para style="q" vid="PRO 21:8">Las acciones del puro son rectas.<verse eid="PRO 21:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 21:9"/>Más vale vivir en rincón de azotea,</para>
  <para style="q" vid="PRO 21:9">Que en casa espaciosa con mujer rencillosa.<verse eid="PRO 21:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 21:10"/>Afán del perverso es desear el mal,</para>
  <para style="q" vid="PRO 21:10">Su prójimo nunca halla favor ante sus ojos.<verse eid="PRO 21:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 21:11"/>Cuando el burlador es castigado, el simple se hace prudente,</para>
  <para style="q" vid="PRO 21:11">Y cuando el sabio es instruido, adquiere conocimiento.<verse eid="PRO 21:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 21:12"/>El justo considera la casa del impío,</para>
  <para style="q" vid="PRO 21:12">Y precipita al impío a la ruina.<verse eid="PRO 21:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 21:13"/>El que cierra sus oídos al clamor del pobre</para>
  <para style="q" vid="PRO 21:13">No será escuchado cuando grite.<verse eid="PRO 21:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 21:14"/>Un regalo en secreto aplaca la ira,</para>
  <para style="q" vid="PRO 21:14">Y un soborno bajo el manto, el gran furor.<verse eid="PRO 21:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 21:15"/>Alegría para el justo es que se haga justicia,</para>
  <para style="q" vid="PRO 21:15">Pero terror para los que practican iniquidad.<verse eid="PRO 21:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 21:16"/>Hombre que se extravía del camino de la sabiduría</para>
  <para style="q" vid="PRO 21:16">Va a parar a la asamblea de los difuntos.<verse eid="PRO 21:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 21:17"/>El que ama el deleite será un hombre pobre,</para>
  <para style="q" vid="PRO 21:17">Quien ama el vino y los ungüentos no enriquecerá.<verse eid="PRO 21:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 21:18"/>El impío está en lugar del justo y</para>
  <para style="q" vid="PRO 21:18">El que pervierte ocupa el puesto de los rectos.<verse eid="PRO 21:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 21:19"/>Más vale habitar en tierra desierta,</para>
  <para style="q" vid="PRO 21:19">Que con mujer rencillosa e iracunda.<verse eid="PRO 21:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 21:20"/>Preciosos tesoros y aceite hay en la casa del sabio,</para>
  <para style="q" vid="PRO 21:20">Pero el hombre insensato los dilapida.<verse eid="PRO 21:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 21:21"/>El que va tras la justicia y la misericordia</para>
  <para style="q" vid="PRO 21:21">Halla vida, prosperidad y honra.<verse eid="PRO 21:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 21:22"/>El sabio conquista la ciudad de los poderosos,</para>
  <para style="q" vid="PRO 21:22">Y humilla la fortaleza en la que ella confía.<verse eid="PRO 21:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 21:23"/>El que guarda su boca y su lengua</para>
  <para style="q" vid="PRO 21:23">Guarda su alma de penurias.<verse eid="PRO 21:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 21:24"/>El soberbio presuntuoso tiene por nombre insolente,</para>
  <para style="q" vid="PRO 21:24">Y obra con saña y furor.<verse eid="PRO 21:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 21:25"/>Los deseos del perezoso lo matan,</para>
  <para style="q" vid="PRO 21:25">Pues sus manos no quieren trabajar.<verse eid="PRO 21:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 21:26"/>Todo el día desea y desea más,</para>
  <para style="q" vid="PRO 21:26">Pero el justo da y no escatima.<verse eid="PRO 21:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 21:27"/>Los sacrificios del perverso son repugnancia,</para>
  <para style="q" vid="PRO 21:27">¡Cuánto más cuando los ofrece con malicia!<verse eid="PRO 21:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 21:28"/>El testigo falso perecerá,</para>
  <para style="q" vid="PRO 21:28">Pero el que atiende, habla perpetuamente.<verse eid="PRO 21:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 21:29"/>El perverso se presenta desafiante,</para>
  <para style="q" vid="PRO 21:29">Pero el recto examina su camino.<verse eid="PRO 21:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 21:30"/>No hay habilidad, ni inteligencia,</para>
  <para style="q" vid="PRO 21:30">Ni consejo frente a <char style="nd">Yavé</char>.<verse eid="PRO 21:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 21:31"/>El caballo es preparado para el día de la batalla,</para>
  <para style="q" vid="PRO 21:31">Pero la victoria es de <char style="nd">Yavé</char>.<verse eid="PRO 21:31"/></para>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 22:1"/>Más vale el buen nombre que las muchas riquezas,</para>
  <para style="q" vid="PRO 22:1">Y el ser apreciado más que la plata y el oro.<verse eid="PRO 22:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 22:2"/>El rico y el pobre tienen esto en común:</para>
  <para style="q" vid="PRO 22:2">
    <char style="nd">Yavé</char> los hizo a todos ellos.<verse eid="PRO 22:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 22:3"/>El prudente ve el mal y se aparta,</para>
  <para style="q" vid="PRO 22:3">Pero los ingenuos siguen y reciben el daño.<verse eid="PRO 22:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 22:4"/>En las huellas de la humildad y del temor a <char style="nd">Yavé</char>,</para>
  <para style="q" vid="PRO 22:4">Andan riqueza, honor y vida.<verse eid="PRO 22:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 22:5"/>Espinos y lazos hay en el camino de los perversos,</para>
  <para style="q" vid="PRO 22:5">El que guarda su alma se aparta de ellos.<verse eid="PRO 22:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 22:6"/>Instruye al niño en el camino que debe seguir,</para>
  <para style="q" vid="PRO 22:6">Aun cuando sea viejo no se apartará de él.<verse eid="PRO 22:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 22:7"/>El rico domina al pobre,</para>
  <para style="q" vid="PRO 22:7">Y el que pide prestado es esclavo del prestamista.<verse eid="PRO 22:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 22:8"/>El que siembra maldad cosecha desgracia,</para>
  <para style="q" vid="PRO 22:8">Y la vara de su arrogancia se consumirá.<verse eid="PRO 22:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 22:9"/>El que tiene ojo generoso será bendecido,</para>
  <para style="q" vid="PRO 22:9">Porque repartió su pan con el pobre.<verse eid="PRO 22:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 22:10"/>Echa fuera al escarnecedor, y se irá la discordia,</para>
  <para style="q" vid="PRO 22:10">Y también saldrán la contienda y las afrentas.<verse eid="PRO 22:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 22:11"/>El que ama la pureza de corazón,</para>
  <para style="q" vid="PRO 22:11">El que tiene gracia en sus labios</para>
  <para style="q" vid="PRO 22:11">Tendrá como amigo al propio rey.<verse eid="PRO 22:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 22:12"/>Los ojos de <char style="nd">Yavé</char> velan por la verdad,</para>
  <para style="q" vid="PRO 22:12">Y Él descubre el engaño de los traicioneros.<verse eid="PRO 22:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 22:13"/>Dice el perezoso: Afuera hay un león.</para>
  <para style="q" vid="PRO 22:13">En plena calle me matará.<verse eid="PRO 22:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 22:14"/>Abismo profundo es la boca de la mujer ajena.</para>
  <para style="q" vid="PRO 22:14">El aborrecido de <char style="nd">Yavé</char> caerá allí.<verse eid="PRO 22:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 22:15"/>La necedad se pega al corazón del niño.</para>
  <para style="q" vid="PRO 22:15">La vara de la corrección se la apartará.<verse eid="PRO 22:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 22:16"/>El que oprime al pobre enriquece.</para>
  <para style="q" vid="PRO 22:16">Quien da al rico se empobrece.<verse eid="PRO 22:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 22:17"/>Inclina tu oído, escucha las palabras de los sabios</para>
  <para style="q" vid="PRO 22:17">Y aplica tu corazón a mis enseñanzas,<verse eid="PRO 22:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 22:18"/>Porque será bueno que las guardes dentro de ti,</para>
  <para style="q" vid="PRO 22:18">Y las establezcas sobre tus labios,<verse eid="PRO 22:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 22:19"/>Para que pongas en <char style="nd">Yavé</char> tu confianza.</para>
  <para style="q" vid="PRO 22:19">Te instruiré también a ti.<verse eid="PRO 22:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 22:20"/>¿No te escribí cosas excelentes de consejos y enseñanzas,<verse eid="PRO 22:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 22:21"/>Para que conozcas la certeza de los dichos de verdad,</para>
  <para style="q" vid="PRO 22:21">Y las hagas llegar a los que te son enviados?<verse eid="PRO 22:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PRO 22:22"/>No explotes al pobre, porque es pobre,</para>
  <para style="q" vid="PRO 22:22">Ni atropelles al desgraciado en la puerta,<verse eid="PRO 22:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 22:23"/>Porque <char style="nd">Yavé</char> defenderá su causa</para>
  <para style="q" vid="PRO 22:23">Y quitará la vida a los que la quitan a otro.<verse eid="PRO 22:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 22:24"/>No hagas amistad con el hombre iracundo,</para>
  <para style="q" vid="PRO 22:24">Ni te hagas acompañar del hombre violento,<verse eid="PRO 22:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 22:25"/>No sea que te acostumbres a sus caminos,</para>
  <para style="q" vid="PRO 22:25">Y coloques lazo a tu propia alma.<verse eid="PRO 22:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 22:26"/>No seas tú de los que dan la mano,</para>
  <para style="q" vid="PRO 22:26">Y salen fiadores de deudas.<verse eid="PRO 22:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 22:27"/>Si no tienes con qué pagar,</para>
  <para style="q" vid="PRO 22:27">¿Por qué te quitarán tu propia cama?<verse eid="PRO 22:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PRO 22:28"/>No remuevas el lindero antiguo</para>
  <para style="q" vid="PRO 22:28">Que colocaron tus antepasados.<verse eid="PRO 22:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 22:29"/>¿Has visto hombre diligente en su obra?</para>
  <para style="q" vid="PRO 22:29">Estará delante de los reyes y no de la gentuza.<verse eid="PRO 22:29"/></para>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 23:1"/>Cuando te sientes a comer con un <char style="tl">ʼadón</char>,</para>
  <para style="q" vid="PRO 23:1">Considera bien lo que está delante de ti,<verse eid="PRO 23:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 23:2"/>Y pon cuchillo a tu garganta</para>
  <para style="q" vid="PRO 23:2">Si tienes gran apetito.<verse eid="PRO 23:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 23:3"/>No codicies sus manjares delicados,</para>
  <para style="q" vid="PRO 23:3">Porque son pan de engaño.<verse eid="PRO 23:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 23:4"/>No te afanes por hacer riquezas.</para>
  <para style="q" vid="PRO 23:4">Sé prudente y desiste.<verse eid="PRO 23:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 23:5"/>Si les diriges una mirada, ya no están.</para>
  <para style="q" vid="PRO 23:5">Les salieron alas como un águila que vuela a los cielos.<verse eid="PRO 23:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PRO 23:6"/>No comas pan con el avaro,</para>
  <para style="q" vid="PRO 23:6">Ni codicies sus manjares,<verse eid="PRO 23:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 23:7"/>Porque como piensa en su corazón, así es.</para>
  <para style="q" vid="PRO 23:7">Come y bebe, te dirá,</para>
  <para style="q" vid="PRO 23:7">Pero su corazón no está contigo.<verse eid="PRO 23:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 23:8"/>Vomitarás el bocado que comiste</para>
  <para style="q" vid="PRO 23:8">Y perderás tus suaves palabras.<verse eid="PRO 23:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 23:9"/>No hables a oídos del insensato,</para>
  <para style="q" vid="PRO 23:9">Porque despreciará la prudencia de tus razones.<verse eid="PRO 23:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 23:10"/>No cambies de lugar el lindero antiguo,</para>
  <para style="q" vid="PRO 23:10">Ni entres en el campo de los huérfanos,<verse eid="PRO 23:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 23:11"/>Porque su Redentor es fuerte,</para>
  <para style="q" vid="PRO 23:11">Y defenderá contra ti la causa de ellos.<verse eid="PRO 23:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PRO 23:12"/>Aplica tu corazón a la enseñanza,</para>
  <para style="q" vid="PRO 23:12">Y tus oídos a las palabras sabias.<verse eid="PRO 23:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 23:13"/>No retraigas la corrección al muchacho,</para>
  <para style="q" vid="PRO 23:13">Si lo castigas con vara, no morirá.<verse eid="PRO 23:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 23:14"/>Lo castigarás con vara,</para>
  <para style="q" vid="PRO 23:14">Y librarás su alma del <char style="tl">Seol</char>.<verse eid="PRO 23:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 23:15"/>Hijo mío, si tu corazón es sabio,</para>
  <para style="q" vid="PRO 23:15">También a mí se me alegrará el corazón,<verse eid="PRO 23:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 23:16"/>Mi ser interno también se alegrará</para>
  <para style="q" vid="PRO 23:16">Cuando tus labios hablen cosas rectas.<verse eid="PRO 23:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 23:17"/>No tenga tu corazón envidia de los pecadores.</para>
  <para style="q" vid="PRO 23:17">Más bien, persevera en el temor a <char style="nd">Yavé</char> en todo tiempo.<verse eid="PRO 23:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 23:18"/>Porque ciertamente hay un porvenir,</para>
  <para style="q" vid="PRO 23:18">Y tu esperanza no será frustrada.<verse eid="PRO 23:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PRO 23:19"/>Escucha tú, hijo mío, sé sabio,</para>
  <para style="q" vid="PRO 23:19">Y dirige tu corazón por el buen camino.<verse eid="PRO 23:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 23:20"/>No estés con los bebedores de vino,</para>
  <para style="q" vid="PRO 23:20">Ni con los comedores de carne,<verse eid="PRO 23:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 23:21"/>Porque el ebrio y el glotón empobrecerán,</para>
  <para style="q" vid="PRO 23:21">Y el dormitar hará vestir harapos.<verse eid="PRO 23:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PRO 23:22"/>Escucha a tu padre que te engendró,</para>
  <para style="q" vid="PRO 23:22">Y no desprecies a tu madre cuando sea anciana.<verse eid="PRO 23:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 23:23"/>Adquiere la verdad y no la vendas,</para>
  <para style="q" vid="PRO 23:23">También sabiduría, instrucción y entendimiento.<verse eid="PRO 23:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 23:24"/>El padre del justo se alegrará en gran manera.</para>
  <para style="q" vid="PRO 23:24">El que engendra un hijo sabio se gozará con él.<verse eid="PRO 23:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 23:25"/>Alégrense tu padre y tu madre,</para>
  <para style="q" vid="PRO 23:25">Y regocíjese la que te dio a luz.<verse eid="PRO 23:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 23:26"/>Dame, hijo mío, tu corazón</para>
  <para style="q" vid="PRO 23:26">Y observen tus ojos mis caminos.<verse eid="PRO 23:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 23:27"/>Porque fosa profunda es la prostituta,</para>
  <para style="q" vid="PRO 23:27">Y pozo angosto la mujer extraña.<verse eid="PRO 23:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 23:28"/>También ella, como asaltante, acecha,</para>
  <para style="q" vid="PRO 23:28">Y entre los hombres multiplica a los traicioneros.<verse eid="PRO 23:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PRO 23:29"/>¿Para quién es el ay?</para>
  <para style="q" vid="PRO 23:29">¿Para quién las tristezas?</para>
  <para style="q" vid="PRO 23:29">¿Para quién las contiendas?</para>
  <para style="q" vid="PRO 23:29">¿Para quién el quejido?</para>
  <para style="q" vid="PRO 23:29">¿Para quién las heridas sin causa?</para>
  <para style="q" vid="PRO 23:29">¿Para quién los ojos enrojecidos?<verse eid="PRO 23:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 23:30"/>Para el que se detiene en el vino,</para>
  <para style="q" vid="PRO 23:30">Para los que prueban licores mezclados.<verse eid="PRO 23:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 23:31"/>No mires al vino cuando rojea,</para>
  <para style="q" vid="PRO 23:31">Y lanza destellos en la copa,</para>
  <para style="q" vid="PRO 23:31">Porque se entra suavemente,<verse eid="PRO 23:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 23:32"/>Pero al fin, muerde como una serpiente.</para>
  <para style="q" vid="PRO 23:32">Pica como una víbora.<verse eid="PRO 23:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 23:33"/>Tus ojos mirarán cosas extrañas,</para>
  <para style="q" vid="PRO 23:33">Y tu corazón hablará cosas perversas.<verse eid="PRO 23:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 23:34"/>Serás como el que está acostado en alta mar,</para>
  <para style="q" vid="PRO 23:34">Como el que duerme en el palo de un velero,<verse eid="PRO 23:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 23:35"/>Y dirás: Me golpearon y no me dolió,</para>
  <para style="q" vid="PRO 23:35">Me azotaron, pero no lo sentí.</para>
  <para style="q" vid="PRO 23:35">Cuando despierte, lo volveré a buscar.<verse eid="PRO 23:35"/></para>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 24:1"/>No envidies a los perversos,</para>
  <para style="q" vid="PRO 24:1">Ni desees estar con ellos.<verse eid="PRO 24:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 24:2"/>Porque su corazón trama violencia,</para>
  <para style="q" vid="PRO 24:2">Y sus labios hablan gran injusticia.<verse eid="PRO 24:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PRO 24:3"/>Con la sabiduría se edifica una casa,</para>
  <para style="q" vid="PRO 24:3">Con la prudencia se afirma,<verse eid="PRO 24:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 24:4"/>Con el conocimiento se llenan sus cuartos</para>
  <para style="q" vid="PRO 24:4">De todo bien preciado y agradable.<verse eid="PRO 24:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 24:5"/>Mejor es el varón sabio que el fuerte.</para>
  <para style="q" vid="PRO 24:5">El hombre de conocimiento aumenta su poder.<verse eid="PRO 24:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 24:6"/>Porque con estrategia harás tu guerra,</para>
  <para style="q" vid="PRO 24:6">Y en la multitud de consejeros está la victoria.<verse eid="PRO 24:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 24:7"/>La sabiduría está demasiado alta para el necio.</para>
  <para style="q" vid="PRO 24:7">En la puerta no abrirá su boca.<verse eid="PRO 24:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 24:8"/>Al que trama el mal</para>
  <para style="q" vid="PRO 24:8">Lo llamarán hombre de malas intenciones.<verse eid="PRO 24:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 24:9"/>La intención del insensato es pecado,</para>
  <para style="q" vid="PRO 24:9">El burlador es detestado por los hombres.<verse eid="PRO 24:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 24:10"/>Si flaqueas en el día de la adversidad,</para>
  <para style="q" vid="PRO 24:10">También tu fuerza se reducirá.<verse eid="PRO 24:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 24:11"/>¡Libra a los que son llevados a la muerte!</para>
  <para style="q" vid="PRO 24:11">¡Rescata a los que se tambalean hacia a la matanza!<verse eid="PRO 24:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 24:12"/>Si dices: En verdad, no lo supimos.</para>
  <para style="q" vid="PRO 24:12">El que pesa los corazones, ¿no lo sabrá?</para>
  <para style="q" vid="PRO 24:12">¿No lo sabrá el que vigila tu vida,</para>
  <para style="q" vid="PRO 24:12">Y paga al hombre según sus obras?<verse eid="PRO 24:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PRO 24:13"/>Come miel, hijo mío, pues es buena.</para>
  <para style="q" vid="PRO 24:13">Sí, el panal es dulce a tu paladar.<verse eid="PRO 24:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 24:14"/>Así aprópiate de la sabiduría para tu vida.</para>
  <para style="q" vid="PRO 24:14">Si la hallas, habrá un porvenir,</para>
  <para style="q" vid="PRO 24:14">Y tu esperanza no será frustrada.<verse eid="PRO 24:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 24:15"/>Oh impío, no aceches la tienda del justo</para>
  <para style="q" vid="PRO 24:15">Ni saquees su lugar de reposo,<verse eid="PRO 24:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 24:16"/>Porque siete veces cae el justo y se vuelve a levantar,</para>
  <para style="q" vid="PRO 24:16">Pero los impíos tropiezan en la calamidad.<verse eid="PRO 24:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 24:17"/>Si tu enemigo cae, no te alegres,</para>
  <para style="q" vid="PRO 24:17">Y si tropieza, no se regocije tu corazón,<verse eid="PRO 24:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 24:18"/>No sea que <char style="nd">Yavé</char> lo vea y le desagrade,</para>
  <para style="q" vid="PRO 24:18">Y aparte de sobre él su enojo.<verse eid="PRO 24:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 24:19"/>No te impacientes a causa de los malhechores,</para>
  <para style="q" vid="PRO 24:19">Ni tengas envidia de los pecadores,<verse eid="PRO 24:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 24:20"/>Porque para el perverso no habrá buen fin,</para>
  <para style="q" vid="PRO 24:20">Y la lámpara de los impíos será apagada.<verse eid="PRO 24:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 24:21"/>Hijo mío: Teme a <char style="nd">Yavé</char> y también al rey.</para>
  <para style="q" vid="PRO 24:21">No te asocies con los sediciosos,<verse eid="PRO 24:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 24:22"/>Porque su calamidad viene de repente,</para>
  <para style="q" vid="PRO 24:22">Y la ruina que viene de ambos, ¿quién la conocerá?<verse eid="PRO 24:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PRO 24:23"/>También estos son dichos de los sabios:</para>
  <para style="q" vid="PRO 24:23">No es bueno hacer acepción de personas en el juicio.<verse eid="PRO 24:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 24:24"/>El que dice al impío: Eres justo,</para>
  <para style="q" vid="PRO 24:24">Lo maldecirán los pueblos,</para>
  <para style="q" vid="PRO 24:24">Y lo detestarán las naciones.<verse eid="PRO 24:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 24:25"/>Pero los que lo reprenden serán apreciados,</para>
  <para style="q" vid="PRO 24:25">Y una gran bendición vendrá sobre ellos.<verse eid="PRO 24:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PRO 24:26"/>Besados serán los labios</para>
  <para style="q" vid="PRO 24:26">Del que responde palabras rectas.<verse eid="PRO 24:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 24:27"/>Prepara tus labores de afuera,</para>
  <para style="q" vid="PRO 24:27">Y disponlas en tus campos,</para>
  <para style="q" vid="PRO 24:27">Y después edifica tu casa.<verse eid="PRO 24:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 24:28"/>No testifiques sin causa contra tu prójimo,</para>
  <para style="q" vid="PRO 24:28">Ni engañes con tus labios.<verse eid="PRO 24:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 24:29"/>No digas: Le haré como él me hizo,</para>
  <para style="q" vid="PRO 24:29">Le retribuiré conforme a su obra.<verse eid="PRO 24:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PRO 24:30"/>Pasé junto al campo de un hombre perezoso,</para>
  <para style="q" vid="PRO 24:30">Por la viña de un hombre falto de entendimiento,<verse eid="PRO 24:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 24:31"/>Y ahí todo estaba cubierto de espinas.</para>
  <para style="q" vid="PRO 24:31">Su superficie estaba cubierta de ortigas,</para>
  <para style="q" vid="PRO 24:31">Y su muro de piedra, derribado.<verse eid="PRO 24:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 24:32"/>Observé esto y reflexioné.</para>
  <para style="q" vid="PRO 24:32">Lo vi y aprendí la lección:<verse eid="PRO 24:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 24:33"/>Un poco de sueño, un poco de dormitar,</para>
  <para style="q" vid="PRO 24:33">Un poco de cruzar las manos para descansar,<verse eid="PRO 24:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 24:34"/>Así vendrá tu miseria como un vagabundo,</para>
  <para style="q" vid="PRO 24:34">Y tu escasez como un hombre armado.<verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="s1">Lecciones y comparaciones</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 25:1"/>También éstos son proverbios de Salomón, que transcribieron los varones de Ezequías, rey de Judá:<verse eid="PRO 25:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 25:2"/>Gloria de <char style="nd">ʼElohim</char> es encubrir un asunto,</para>
  <para style="q" vid="PRO 25:2">Pero honra del rey es escudriñarlo.<verse eid="PRO 25:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 25:3"/>Así como la altura de los cielos y la profundidad de la tierra,</para>
  <para style="q" vid="PRO 25:3">El corazón de los reyes es inescrutable.<verse eid="PRO 25:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 25:4"/>Quita la escoria de la plata,</para>
  <para style="q" vid="PRO 25:4">Y saldrá un vaso para el platero.<verse eid="PRO 25:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 25:5"/>Aparta al perverso de la presencia del rey,</para>
  <para style="q" vid="PRO 25:5">Y su trono se afianzará en justicia.<verse eid="PRO 25:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 25:6"/>No te alabes delante del rey,</para>
  <para style="q" vid="PRO 25:6">Ni estés en el lugar de los grandes.<verse eid="PRO 25:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 25:7"/>Mejor es que te diga: Sube acá,</para>
  <para style="q" vid="PRO 25:7">Que ser humillado en presencia de un noble</para>
  <para style="q" vid="PRO 25:7">A quien vieron tus ojos.<verse eid="PRO 25:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 25:8"/>No te des prisa en pleitear,</para>
  <para style="q" vid="PRO 25:8">Porque ¿qué harás al final</para>
  <para style="q" vid="PRO 25:8">Cuando tu prójimo te haya avergonzado?<verse eid="PRO 25:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 25:9"/>Discute tu causa con tu prójimo,</para>
  <para style="q" vid="PRO 25:9">Y no des a conocer el secreto de otro,<verse eid="PRO 25:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 25:10"/>No sea que te deshonre el que lo oye,</para>
  <para style="q" vid="PRO 25:10">Y tu mala fama no pueda repararse.<verse eid="PRO 25:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 25:11"/>Manzana de oro con adornos de plata</para>
  <para style="q" vid="PRO 25:11">Es la palabra dicha oportunamente.<verse eid="PRO 25:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 25:12"/>Zarcillo de oro y joya de oro fino</para>
  <para style="q" vid="PRO 25:12">Es el que reprende al sabio que tiene oído dócil.<verse eid="PRO 25:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 25:13"/>Frescura de nieve en tiempo de cosecha</para>
  <para style="q" vid="PRO 25:13">Es el mensajero fiel para el que lo envía,</para>
  <para style="q" vid="PRO 25:13">Pues refresca la vida de su <char style="tl">ʼadón</char>.<verse eid="PRO 25:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 25:14"/>Como nubes y vientos sin lluvia,</para>
  <para style="q" vid="PRO 25:14">Es el que se jacta falsamente de sus regalos.<verse eid="PRO 25:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 25:15"/>Con longanimidad se persuade al gobernante,</para>
  <para style="q" vid="PRO 25:15">Pues la lengua amable quebranta los huesos.<verse eid="PRO 25:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 25:16"/>¿Hallaste miel? Come lo que te baste,</para>
  <para style="q" vid="PRO 25:16">No sea que cuando estés lleno la vomites.<verse eid="PRO 25:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 25:17"/>No frecuente tu pie la casa de tu vecino,</para>
  <para style="q" vid="PRO 25:17">No sea que se canse de ti, y te aborrezca.<verse eid="PRO 25:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 25:18"/>Martillo, cuchillo y flecha aguda,</para>
  <para style="q" vid="PRO 25:18">Es el hombre que da falso testimonio contra su prójimo.<verse eid="PRO 25:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 25:19"/>Como diente roto y pie descoyuntado,</para>
  <para style="q" vid="PRO 25:19">Es confiar en el traicionero en el día de la angustia.<verse eid="PRO 25:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 25:20"/>Como el que se quita la ropa en tiempo frío</para>
  <para style="q" vid="PRO 25:20">Y como vinagre sobre el bicarbonato de sodio</para>
  <para style="q" vid="PRO 25:20">Es cantar canciones al corazón afligido.<verse eid="PRO 25:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 25:21"/>Si tu enemigo tiene hambre, dale de comer.</para>
  <para style="q" vid="PRO 25:21">Si tiene sed, dale de beber.<verse eid="PRO 25:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 25:22"/>Porque carbones encendidos amontonas sobre su cabeza,</para>
  <para style="q" vid="PRO 25:22">Y <char style="nd">Yavé</char> te recompensará.<verse eid="PRO 25:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 25:23"/>Como el viento del norte atrae la lluvia,</para>
  <para style="q" vid="PRO 25:23">La boca detractora, el rostro airado.<verse eid="PRO 25:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 25:24"/>Mejor es vivir en un rincón de la azotea</para>
  <para style="q" vid="PRO 25:24">Que en casa espaciosa con esposa pendenciera.<verse eid="PRO 25:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PRO 25:25"/>Como agua fresca a la persona sedienta</para>
  <para style="q" vid="PRO 25:25">Son las buenas noticias desde lejanas tierras.<verse eid="PRO 25:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 25:26"/>Manantial turbio y pozo en ruinas</para>
  <para style="q" vid="PRO 25:26">Es el justo que flaquea ante el perverso.<verse eid="PRO 25:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 25:27"/>Comer mucha miel no es bueno,</para>
  <para style="q" vid="PRO 25:27">Ni es bueno buscar la propia gloria.<verse eid="PRO 25:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 25:28"/>Como una ciudad cuyo muro fue derribado,</para>
  <para style="q" vid="PRO 25:28">Es el hombre que no domina su propio espíritu.<verse eid="PRO 25:28"/></para>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 26:1"/>No conviene la nieve en el verano</para>
  <para style="q" vid="PRO 26:1">Ni la lluvia en la cosecha,</para>
  <para style="q" vid="PRO 26:1">Ni la honra al necio.<verse eid="PRO 26:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 26:2"/>Como pájaro que aletea y golondrina que vuela,</para>
  <para style="q" vid="PRO 26:2">Así la maldición sin causa no se cumple.<verse eid="PRO 26:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 26:3"/>El látigo para el caballo, el cabestro para el asno</para>
  <para style="q" vid="PRO 26:3">Y la vara para la espalda del necio.<verse eid="PRO 26:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 26:4"/>No respondas al necio según su necedad,</para>
  <para style="q" vid="PRO 26:4">Para que no seas tú como él.<verse eid="PRO 26:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 26:5"/>Responde al necio como merece su necedad,</para>
  <para style="q" vid="PRO 26:5">Para que él no se estime sabio.<verse eid="PRO 26:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 26:6"/>El que envía mensaje por medio de un necio</para>
  <para style="q" vid="PRO 26:6">Corta sus pies y bebe violencia.<verse eid="PRO 26:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 26:7"/>Al lisiado le cuelgan las piernas inútiles.</para>
  <para style="q" vid="PRO 26:7">Así es el proverbio en la boca del necio.<verse eid="PRO 26:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 26:8"/>Como sujetar una piedra en la honda,</para>
  <para style="q" vid="PRO 26:8">Así es el que da honores al necio.<verse eid="PRO 26:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 26:9"/>Como espina que cae en la mano de un borracho,</para>
  <para style="q" vid="PRO 26:9">Así es el proverbio en boca de los necios.<verse eid="PRO 26:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 26:10"/>Como arquero que dispara contra cualquiera,</para>
  <para style="q" vid="PRO 26:10">Es el que contrata a insensatos y vagabundos.<verse eid="PRO 26:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 26:11"/>Como perro que vuelve a su vómito,</para>
  <para style="q" vid="PRO 26:11">Así el necio repite su insensatez.<verse eid="PRO 26:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 26:12"/>¿Has visto a alguien sabio en su propia opinión?</para>
  <para style="q" vid="PRO 26:12">Más se puede esperar de un necio que de él.<verse eid="PRO 26:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 26:13"/>Dice el perezoso:</para>
  <para style="q" vid="PRO 26:13">El león está en el camino,</para>
  <para style="q" vid="PRO 26:13">Hay un león en la plaza.<verse eid="PRO 26:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 26:14"/>Como la puerta gira sobre sus bisagras,</para>
  <para style="q" vid="PRO 26:14">Así también el perezoso en su cama.<verse eid="PRO 26:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 26:15"/>El perezoso mete su mano en el plato,</para>
  <para style="q" vid="PRO 26:15">Y le repugna aun llevar la comida a su boca.<verse eid="PRO 26:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 26:16"/>El perezoso se cree más sabio</para>
  <para style="q" vid="PRO 26:16">Que siete hombres que responden con discreción.<verse eid="PRO 26:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 26:17"/>El que se mete en pleito ajeno</para>
  <para style="q" vid="PRO 26:17">Es como el que agarra un perro por las orejas.<verse eid="PRO 26:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 26:18"/>Como el loco furioso que lanza dardos<note caller="+" style="f"><char style="fr" closed="false">26.18 </char><char style="ft" closed="false">Dardo: lanza pequeña y delgada que se tira con la mano.</char></note> encendidos y flechas mortales,<verse eid="PRO 26:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 26:19"/>Así es el que engaña a su prójimo</para>
  <para style="q" vid="PRO 26:19">Y luego dice: Solo era una broma.<verse eid="PRO 26:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 26:20"/>Sin leña se apaga el fuego,</para>
  <para style="q" vid="PRO 26:20">Y donde no hay chismoso, cesa la contienda.<verse eid="PRO 26:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 26:21"/>El carbón para las brasas y la leña para el fuego,</para>
  <para style="q" vid="PRO 26:21">Y el pendenciero para encender la contienda.<verse eid="PRO 26:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 26:22"/>Las palabras del chismoso son manjares,</para>
  <para style="q" vid="PRO 26:22">Que bajan hasta lo más recóndito del ser.<verse eid="PRO 26:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 26:23"/>Como escoria de plata echada sobre un tiesto</para>
  <para style="q" vid="PRO 26:23">Son los labios enardecidos y el corazón perverso.<verse eid="PRO 26:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 26:24"/>Disimula con sus labios el que odia,</para>
  <para style="q" vid="PRO 26:24">Pero en su interior trama el engaño.<verse eid="PRO 26:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 26:25"/>Aunque hable amigablemente, no le creas,</para>
  <para style="q" vid="PRO 26:25">Porque siete repugnancias hay en su corazón.<verse eid="PRO 26:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 26:26"/>Aunque con disimulo encubra su odio,</para>
  <para style="q" vid="PRO 26:26">Su perversidad será descubierta en la congregación.<verse eid="PRO 26:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 26:27"/>El que cave una fosa, caerá en ella,</para>
  <para style="q" vid="PRO 26:27">Y al que ruede una piedra, le caerá encima.<verse eid="PRO 26:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 26:28"/>La lengua mentirosa odia a los que aflige,</para>
  <para style="q" vid="PRO 26:28">Y la boca lisonjera causa ruina.<verse eid="PRO 26:28"/></para>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 27:1"/>No te jactes del mañana,</para>
  <para style="q" vid="PRO 27:1">Pues no sabes lo que traerá el día.<verse eid="PRO 27:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 27:2"/>Alábete el otro y no tu propia boca,</para>
  <para style="q" vid="PRO 27:2">El extraño, y no tus propios labios.<verse eid="PRO 27:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 27:3"/>Pesada es la piedra, y la arena pesa,</para>
  <para style="q" vid="PRO 27:3">Pero la incitación de un necio es más pesada que ambas.<verse eid="PRO 27:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 27:4"/>Cruel es la ira e impetuoso el furor,</para>
  <para style="q" vid="PRO 27:4">Pero ¿quién puede mantenerse en pie ante la envidia?<verse eid="PRO 27:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 27:5"/>Mejor es reprensión manifiesta,</para>
  <para style="q" vid="PRO 27:5">Que amor oculto.<verse eid="PRO 27:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 27:6"/>Leales son las heridas de un amigo,</para>
  <para style="q" vid="PRO 27:6">Pero engañosos los besos del que odia.<verse eid="PRO 27:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 27:7"/>La persona saciada pisotea el panal,</para>
  <para style="q" vid="PRO 27:7">Pero para la hambrienta, hasta lo amargo <char style="add">le</char> es dulce.<verse eid="PRO 27:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 27:8"/>Cual ave que se va de su nido,</para>
  <para style="q" vid="PRO 27:8">Así es el hombre que se va de su lugar.<verse eid="PRO 27:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 27:9"/>Los ungüentos y los vinos alegran el corazón,</para>
  <para style="q" vid="PRO 27:9">Así el consejo de un hombre es dulce para su amigo.<verse eid="PRO 27:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 27:10"/>No abandones a tu amigo, ni al amigo de tu padre,</para>
  <para style="q" vid="PRO 27:10">Ni vayas a casa de tu hermano en el día de tu aflicción.</para>
  <para style="q" vid="PRO 27:10">Mejor es el vecino cerca que el hermano lejos.<verse eid="PRO 27:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 27:11"/>Sé sabio, hijo mío, y alegra mi corazón,</para>
  <para style="q" vid="PRO 27:11">Así tendré que responder al que me ultraje.<verse eid="PRO 27:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 27:12"/>El prudente ve el mal y se aparta,</para>
  <para style="q" vid="PRO 27:12">Pero los ingenuos siguen, y reciben el daño.<verse eid="PRO 27:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 27:13"/>Quítale la ropa al que sale fiador de un extraño,</para>
  <para style="q" vid="PRO 27:13">Y tómale prenda al que confía en la mujer extraña.<verse eid="PRO 27:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 27:14"/>Al que bendice a su prójimo de madrugada a gritos</para>
  <para style="q" vid="PRO 27:14">Por maldición se le contará.<verse eid="PRO 27:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 27:15"/>Una gotera continua en tiempo de lluvia</para>
  <para style="q" vid="PRO 27:15">Y una esposa pendenciera son iguales.<verse eid="PRO 27:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 27:16"/>Pretender refrenarla es como refrenar el viento,</para>
  <para style="q" vid="PRO 27:16">O sujetar aceite en la mano derecha.<verse eid="PRO 27:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 27:17"/>El hierro con el hierro se afila.</para>
  <para style="q" vid="PRO 27:17">Así estimula el hombre el semblante de su amigo.<verse eid="PRO 27:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 27:18"/>El que cuida su higuera comerá higos,</para>
  <para style="q" vid="PRO 27:18">Y el que atiende los intereses de su <char style="tl">ʼadón</char> recibirá honores.<verse eid="PRO 27:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 27:19"/>Como el rostro se refleja en el agua,</para>
  <para style="q" vid="PRO 27:19">Así el corazón del hombre refleja al hombre.<verse eid="PRO 27:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 27:20"/>El <char style="tl">Seol</char> y el <char style="tl">Abadón</char><note caller="+" style="f"><char style="fr" closed="false">27.20 <char style="tl">Seol</char>: mundo de los muertos. <char style="tl">Abadón</char>: lugar de perdición.</char></note> no se sacian jamás.</para>
  <para style="q" vid="PRO 27:20">Así los ojos del hombre nunca se sacian.<verse eid="PRO 27:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 27:21"/>El crisol prueba la plata y la hornaza el oro,</para>
  <para style="q" vid="PRO 27:21">Y al hombre, la boca del que lo alaba.<verse eid="PRO 27:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 27:22"/>Aunque machaques al necio con el pisón del mortero entre el grano partido,</para>
  <para style="q" vid="PRO 27:22">Su necedad no se apartará de él.<verse eid="PRO 27:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 27:23"/>Observa bien la condición de tus ovejas,</para>
  <para style="q" vid="PRO 27:23">Atiende tus rebaños.<verse eid="PRO 27:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 27:24"/>Porque las riquezas no duran para siempre,</para>
  <para style="q" vid="PRO 27:24">Ni se transmite una corona de generación en generación.<verse eid="PRO 27:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 27:25"/>Salen las verduras, aparece el retoño</para>
  <para style="q" vid="PRO 27:25">Y los vegetales de las montañas son cosechados.<verse eid="PRO 27:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 27:26"/>Las ovejas proveen tu ropa,</para>
  <para style="q" vid="PRO 27:26">Y las cabras el precio del campo,<verse eid="PRO 27:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 27:27"/>Las cabras proveen leche para tu alimento,</para>
  <para style="q" vid="PRO 27:27">Para el alimento de tu casa y el sustento de tus esclavas.<verse eid="PRO 27:27"/></para>
  <chapter eid="PRO 27"/>
  <chapter number="28" style="c" sid="PRO 28"/>
  <para style="s1">Proverbios expresados en antítesis</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 28:1"/>Huye el impío sin que nadie lo persiga,</para>
  <para style="q" vid="PRO 28:1">Pero como león está confiado el justo.<verse eid="PRO 28:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 28:2"/>Por la rebelión de la tierra sus jefes son muchos,</para>
  <para style="q" vid="PRO 28:2">Pero por el hombre entendido y sabio permanece estable.<verse eid="PRO 28:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 28:3"/>El hombre pobre que explota a los indigentes</para>
  <para style="q" vid="PRO 28:3">Es como lluvia torrencial que no deja pan.<verse eid="PRO 28:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 28:4"/>Los que abandonan la Ley alaban al impío.</para>
  <para style="q" vid="PRO 28:4">Los que la guardan contienden con ellos.<verse eid="PRO 28:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 28:5"/>Los perversos no entienden la justicia,</para>
  <para style="q" vid="PRO 28:5">Pero el que busca a <char style="nd">Yavé</char> lo entiende todo.<verse eid="PRO 28:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 28:6"/>Mejor es el pobre que anda en su integridad,</para>
  <para style="q" vid="PRO 28:6">Que rico de caminos torcidos.<verse eid="PRO 28:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 28:7"/>El que observa la Ley es hijo inteligente,</para>
  <para style="q" vid="PRO 28:7">El que se reúne con glotones avergüenza a su padre.<verse eid="PRO 28:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 28:8"/>El que aumenta su fortuna con interés y usura</para>
  <para style="q" vid="PRO 28:8">Acumula para el que se compadece de los pobres.<verse eid="PRO 28:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 28:9"/>Al que aparta su oído para no oír la Ley,</para>
  <para style="q" vid="PRO 28:9">Aun su oración es una repugnancia.<verse eid="PRO 28:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 28:10"/>El que extravía al recto por el mal camino</para>
  <para style="q" vid="PRO 28:10">Caerá en su propia fosa,</para>
  <para style="q" vid="PRO 28:10">Pero los íntegros heredarán el bien.<verse eid="PRO 28:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 28:11"/>El hombre rico es sabio en su propia opinión,</para>
  <para style="q" vid="PRO 28:11">Pero el entendido pobre lo escudriña.<verse eid="PRO 28:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 28:12"/>Cuando triunfa el justo hay gran esplendor,</para>
  <para style="q" vid="PRO 28:12">Cuando se yerguen los impíos, los hombres se esconden.<verse eid="PRO 28:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 28:13"/>El que encubre sus pecados no prosperará,</para>
  <para style="q" vid="PRO 28:13">Pero el que los confiesa y se aparta alcanzará misericordia.<verse eid="PRO 28:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 28:14"/>¡Inmensamente feliz es el hombre que teme siempre!</para>
  <para style="q" vid="PRO 28:14">Pero el que endurece su corazón caerá en la desgracia.<verse eid="PRO 28:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 28:15"/>León rugiente y oso hambriento,</para>
  <para style="q" vid="PRO 28:15">Es el gobernante impío sobre un pueblo pobre.<verse eid="PRO 28:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 28:16"/>El gobernante falto de entendimiento aumenta la extorsión,</para>
  <para style="q" vid="PRO 28:16">Pero el que aborrece la avaricia alargará sus días.<verse eid="PRO 28:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 28:17"/>El hombre culpable de homicidio hacia la fosa huye.</para>
  <para style="q" vid="PRO 28:17">¡Nadie lo detenga!<verse eid="PRO 28:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 28:18"/>El que anda en integridad será librado,</para>
  <para style="q" vid="PRO 28:18">Pero el que oscila entre dos caminos caerá de repente.<verse eid="PRO 28:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 28:19"/>El que labra su tierra se saciará de pan,</para>
  <para style="q" vid="PRO 28:19">Pero el que persigue vanidades se hartará de pobreza.<verse eid="PRO 28:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 28:20"/>El hombre leal tendrá muchas bendiciones,</para>
  <para style="q" vid="PRO 28:20">Pero el que se apresura a enriquecerse no quedará impune.<verse eid="PRO 28:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 28:21"/>Hacer acepción de personas no es bueno,</para>
  <para style="q" vid="PRO 28:21">Pero, ¡hasta por un bocado de pan puede transgredir un hombre!<verse eid="PRO 28:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 28:22"/>El hombre de mirada desleal se afana por enriquecer,</para>
  <para style="q" vid="PRO 28:22">Y no sabe que lo alcanzará la miseria.<verse eid="PRO 28:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 28:23"/>El que reprende al hombre hallará mayor gracia</para>
  <para style="q" vid="PRO 28:23">Que el de boca lisonjera.<verse eid="PRO 28:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 28:24"/>El que roba a padre o madre y dice que no es pecado,</para>
  <para style="q" vid="PRO 28:24">Es compañero del destructor.<verse eid="PRO 28:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 28:25"/>El arrogante suscita contiendas,</para>
  <para style="q" vid="PRO 28:25">Pero el que confía en <char style="nd">Yavé</char> prosperará.<verse eid="PRO 28:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 28:26"/>El que confía en su propio corazón es un necio,</para>
  <para style="q" vid="PRO 28:26">Pero el que anda en sabiduría será librado.<verse eid="PRO 28:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 28:27"/>El que da al pobre no tendrá necesidad,</para>
  <para style="q" vid="PRO 28:27">Pero el que aparta de él sus ojos tendrá muchas maldiciones.<verse eid="PRO 28:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 28:28"/>Cuando se levantan los perversos, los hombres se esconden,</para>
  <para style="q" vid="PRO 28:28">Pero cuando perecen, aumentan los justos.<verse eid="PRO 28:28"/></para>
  <chapter eid="PRO 28"/>
  <chapter number="29" style="c" sid="PRO 29"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 29:1"/>El hombre que al ser reprendido es indómito,</para>
  <para style="q" vid="PRO 29:1">Será quebrantado de repente,</para>
  <para style="q" vid="PRO 29:1">Y no habrá para él medicina.<verse eid="PRO 29:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 29:2"/>Cuando aumentan los justos, el pueblo se regocija.</para>
  <para style="q" vid="PRO 29:2">Cuando gobierna el impío, el pueblo gime.<verse eid="PRO 29:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 29:3"/>El que ama la sabiduría, alegra a su padre,</para>
  <para style="q" vid="PRO 29:3">Pero el que se junta con prostitutas, destruye su riqueza.<verse eid="PRO 29:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 29:4"/>Un rey justo estabiliza el país,</para>
  <para style="q" vid="PRO 29:4">Pero el que lo carga de impuestos lo destruye.<verse eid="PRO 29:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 29:5"/>El hombre que lisonjea a su prójimo</para>
  <para style="q" vid="PRO 29:5">Tiende una red a sus pasos.<verse eid="PRO 29:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 29:6"/>En la transgresión del hombre perverso hay trampa,</para>
  <para style="q" vid="PRO 29:6">Pero el justo cantará y se alegrará.<verse eid="PRO 29:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 29:7"/>Preocupa al justo la causa de los pobres,</para>
  <para style="q" vid="PRO 29:7">Y el perverso no entiende esa preocupación.<verse eid="PRO 29:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 29:8"/>Los burladores agitan la ciudad,</para>
  <para style="q" vid="PRO 29:8">Pero los sabios aplacan la ira.<verse eid="PRO 29:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 29:9"/>Si un sabio contiende con un necio,</para>
  <para style="q" vid="PRO 29:9">Aunque se enoje éste o se ría, no tendrá reposo.<verse eid="PRO 29:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 29:10"/>Los hombres sanguinarios aborrecen al íntegro,</para>
  <para style="q" vid="PRO 29:10">Pero los rectos se preocupan por su vida.<verse eid="PRO 29:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 29:11"/>El necio da rienda suelta a su ira,</para>
  <para style="q" vid="PRO 29:11">Pero el sabio la reprime.<verse eid="PRO 29:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 29:12"/>Si el gobernante atiende a palabras mentirosas,</para>
  <para style="q" vid="PRO 29:12">Todos sus ministros serán perversos.<verse eid="PRO 29:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 29:13"/>El pobre y el opresor tienen esto en común:</para>
  <para style="q" vid="PRO 29:13">A ambos <char style="nd">Yavé</char> les iluminó los ojos.<verse eid="PRO 29:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 29:14"/>Si el rey juzga a los pobres con verdad,</para>
  <para style="q" vid="PRO 29:14">Su trono será establecido para siempre.<verse eid="PRO 29:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 29:15"/>La vara y la reprensión dan sabiduría,</para>
  <para style="q" vid="PRO 29:15">Pero el muchacho consentido avergonzará a su madre.<verse eid="PRO 29:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 29:16"/>Cuando los perversos se multiplican, aumenta la transgresión,</para>
  <para style="q" vid="PRO 29:16">Pero los justos presenciarán la caída de ellos.<verse eid="PRO 29:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 29:17"/>Corrige a tu hijo y te dará descanso,</para>
  <para style="q" vid="PRO 29:17">Y dará satisfacciones a tu alma.<verse eid="PRO 29:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 29:18"/>Donde no hay visión profética, el pueblo se desenfrena.</para>
  <para style="q" vid="PRO 29:18">Pero, ¡inmensamente feliz es el que guarda la Ley!<verse eid="PRO 29:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 29:19"/>El esclavo no se corrige solo con palabras,</para>
  <para style="q" vid="PRO 29:19">Porque entiende, pero no hace caso.<verse eid="PRO 29:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 29:20"/>¿Has visto a un hombre precipitado en sus palabras?</para>
  <para style="q" vid="PRO 29:20">Más esperanza hay del necio que de él.<verse eid="PRO 29:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 29:21"/>El que mima a un esclavo desde la niñez,</para>
  <para style="q" vid="PRO 29:21">Al final lo tendrá como un hijo.<verse eid="PRO 29:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 29:22"/>El hombre iracundo levanta contiendas,</para>
  <para style="q" vid="PRO 29:22">Y el furioso comete muchas transgresiones.<verse eid="PRO 29:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 29:23"/>La soberbia del hombre lo abate,</para>
  <para style="q" vid="PRO 29:23">Pero el de espíritu humilde recibirá honra.<verse eid="PRO 29:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 29:24"/>El cómplice del ladrón aborrece su propia vida,</para>
  <para style="q" vid="PRO 29:24">Oye la maldición, pero no lo denuncia.<verse eid="PRO 29:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 29:25"/>El temor al hombre coloca una trampa,</para>
  <para style="q" vid="PRO 29:25">Pero el que confía en <char style="nd">Yavé</char> estará seguro.<verse eid="PRO 29:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 29:26"/>Muchos buscan el favor del gobernante,</para>
  <para style="q" vid="PRO 29:26">Pero la sentencia para el hombre viene de <char style="nd">Yavé</char>.<verse eid="PRO 29:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 29:27"/>El hombre inicuo es aborrecido por los justos,</para>
  <para style="q" vid="PRO 29:27">Y el de camino recto es aborrecido por los perversos.<verse eid="PRO 29:27"/></para>
  <chapter eid="PRO 29"/>
  <chapter number="30" style="c" sid="PRO 30"/>
  <para style="s1">Las palabras de Agur</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 30:1"/>Palabras de Agur, hijo de Jaqué, el de Masá. La profecía. Declaración del varón a Itiel y a Ucal.<verse eid="PRO 30:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 30:2"/>En verdad soy el más ignorante de los hombres,</para>
  <para style="q" vid="PRO 30:2">Y no tengo entendimiento humano.<verse eid="PRO 30:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 30:3"/>No aprendí sabiduría,</para>
  <para style="q" vid="PRO 30:3">Ni comprendo la ciencia del Santo.<verse eid="PRO 30:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 30:4"/>¿Quién subió a los cielos, y descendió?</para>
  <para style="q" vid="PRO 30:4">¿Quién encerró los vientos en sus puños?</para>
  <para style="q" vid="PRO 30:4">¿Quién ató las aguas en un paño?</para>
  <para style="q" vid="PRO 30:4">¿Quién afirmó todos los términos de la tierra?</para>
  <para style="q" vid="PRO 30:4">¿Cuál es su Nombre, y el nombre de su Hijo, si sabes?<verse eid="PRO 30:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PRO 30:5"/>Toda Palabra de <char style="nd">ʼElohim</char> es limpia.</para>
  <para style="q" vid="PRO 30:5">Él es Escudo a los que en Él esperan.<verse eid="PRO 30:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 30:6"/>No añadas a sus Palabras,</para>
  <para style="q" vid="PRO 30:6">Para que no te reprenda,</para>
  <para style="q" vid="PRO 30:6">Y seas hallado mentiroso.<verse eid="PRO 30:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PRO 30:7"/>Dos cosas te pedí,</para>
  <para style="q" vid="PRO 30:7">No me las niegues mientras viva:<verse eid="PRO 30:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 30:8"/>Aparta de mí la vanidad y la mentira,</para>
  <para style="q" vid="PRO 30:8">Y no me des pobreza ni riqueza.</para>
  <para style="q" vid="PRO 30:8">Mantenme con el pan necesario,<verse eid="PRO 30:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 30:9"/>No sea que me sacie y te niegue, o diga:</para>
  <para style="q" vid="PRO 30:9">¿Quién es <char style="nd">Yavé</char>?</para>
  <para style="q" vid="PRO 30:9">O que, por ser pobre robe</para>
  <para style="q" vid="PRO 30:9">Y blasfeme el Nombre de mi <char style="nd">ʼElohim</char>.<verse eid="PRO 30:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PRO 30:10"/>No acuses al esclavo ante su <char style="tl">ʼadón</char>,</para>
  <para style="q" vid="PRO 30:10">No sea que te maldiga, y seas hallado culpable.<verse eid="PRO 30:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PRO 30:11"/>Hay quien maldice a su padre,</para>
  <para style="q" vid="PRO 30:11">Y no bendice a su madre.<verse eid="PRO 30:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 30:12"/>Hay quien es puro en su propia opinión,</para>
  <para style="q" vid="PRO 30:12">Pero no está lavado de su impureza.<verse eid="PRO 30:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 30:13"/>Hay quien mira con ojos altivos</para>
  <para style="q" vid="PRO 30:13">Y párpados bien levantados por arrogancia.<verse eid="PRO 30:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 30:14"/>Hay quien tiene dientes como espadas</para>
  <para style="q" vid="PRO 30:14">Y muelas como cuchillos</para>
  <para style="q" vid="PRO 30:14">Para devorar a los pobres de la tierra</para>
  <para style="q" vid="PRO 30:14">Y a los necesitados de entre los hombres.<verse eid="PRO 30:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PRO 30:15"/>La sanguijuela tiene dos hijas: Dame y Dame.</para>
  <para style="q" vid="PRO 30:15">Tres cosas hay que nunca se sacian,</para>
  <para style="q" vid="PRO 30:15">Aun la cuarta jamás dice: ¡Basta!<verse eid="PRO 30:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 30:16"/>El <char style="tl">Seol</char>, la matriz estéril,</para>
  <para style="q" vid="PRO 30:16">La tierra, que no se harta de agua,</para>
  <para style="q" vid="PRO 30:16">Y el fuego, que nunca dice: ¡Basta!<verse eid="PRO 30:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PRO 30:17"/>Ojo que se burla del padre</para>
  <para style="q" vid="PRO 30:17">Y desprecia la obediencia a la madre,</para>
  <para style="q" vid="PRO 30:17">¡Arránquenlo los cuervos del valle</para>
  <para style="q" vid="PRO 30:17">Y devórenlo los polluelos del buitre!<verse eid="PRO 30:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PRO 30:18"/>Tres cosas me son ocultas,</para>
  <para style="q" vid="PRO 30:18">Y tampoco comprendo la cuarta:<verse eid="PRO 30:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 30:19"/>El rastro del águila en el aire,</para>
  <para style="q" vid="PRO 30:19">El rastro de la culebra sobre la peña,</para>
  <para style="q" vid="PRO 30:19">El rastro de la nave en el mar,</para>
  <para style="q" vid="PRO 30:19">Y el rastro del hombre en la doncella.<verse eid="PRO 30:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PRO 30:20"/>Así procede la mujer adúltera:</para>
  <para style="q" vid="PRO 30:20">Come, se limpia la boca y dice:</para>
  <para style="q" vid="PRO 30:20">Nada malo hice.<verse eid="PRO 30:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PRO 30:21"/>Por tres cosas se estremece la tierra,</para>
  <para style="q" vid="PRO 30:21">Y la cuarta no puede soportar:<verse eid="PRO 30:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 30:22"/>Por el esclavo, cuando llega a reinar,</para>
  <para style="q" vid="PRO 30:22">Por el necio, cuando se harta de pan,<verse eid="PRO 30:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 30:23"/>Por la mujer aborrecida, cuando se casa,</para>
  <para style="q" vid="PRO 30:23">Y por una esclava, cuando desplaza a su señora.<verse eid="PRO 30:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PRO 30:24"/>Cuatro cosas son pequeñas en la tierra,</para>
  <para style="q" vid="PRO 30:24">Pero mucha más sabias que los sabios:<verse eid="PRO 30:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 30:25"/>Las hormigas, pueblo no fuerte,</para>
  <para style="q" vid="PRO 30:25">Pero preparan su sustento en el verano;<verse eid="PRO 30:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 30:26"/>Los conejos, pueblo nada esforzado,</para>
  <para style="q" vid="PRO 30:26">Pero hacen su casa en la roca;<verse eid="PRO 30:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 30:27"/>Las langostas, que no tienen rey,</para>
  <para style="q" vid="PRO 30:27">Pero salen todas en cuadrillas;<verse eid="PRO 30:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 30:28"/>Las lagartijas, que se agarran con la mano,</para>
  <para style="q" vid="PRO 30:28">Pero están en los palacios reales.<verse eid="PRO 30:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PRO 30:29"/>Tres cosas hay de hermoso andar,</para>
  <para style="q" vid="PRO 30:29">Y la cuarta pasea muy bien:<verse eid="PRO 30:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 30:30"/>El león, el más fuerte entre todas las bestias,</para>
  <para style="q" vid="PRO 30:30">Que no se vuelve atrás por nada;<verse eid="PRO 30:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 30:31"/>El gallo que erguido camina,</para>
  <para style="q" vid="PRO 30:31">También el macho cabrío,</para>
  <para style="q" vid="PRO 30:31">Y un rey, cuando sus tropas están con él.<verse eid="PRO 30:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PRO 30:32"/>Si te enalteciste neciamente,</para>
  <para style="q" vid="PRO 30:32">O tramaste el mal, pon tu mano sobre tu boca.<verse eid="PRO 30:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 30:33"/>Porque así como al batir la leche se saca mantequilla,</para>
  <para style="q" vid="PRO 30:33">Y al que recio se suena le sale sangre,</para>
  <para style="q" vid="PRO 30:33">El que provoca la ira causará contienda.<verse eid="PRO 30:33"/></para>
  <chapter eid="PRO 30"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="s1">Exhortación al rey</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 31:1"/>Palabras del rey Lemuel,</para>
  <para style="q" vid="PRO 31:1">La profecía que le enseñó su madre:<verse eid="PRO 31:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 31:2"/>¿Qué te diré, hijo mío?</para>
  <para style="q" vid="PRO 31:2">¡Oh, hijo de mi vientre!</para>
  <para style="q" vid="PRO 31:2">¿Qué te diré, hijo de mis votos?<verse eid="PRO 31:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 31:3"/>No des tu fuerza a las mujeres,</para>
  <para style="q" vid="PRO 31:3">Ni tus caminos al que destruye a los reyes.<verse eid="PRO 31:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PRO 31:4"/>No es de reyes, oh Lemuel,</para>
  <para style="q" vid="PRO 31:4">Ni es de los reyes beber vino,</para>
  <para style="q" vid="PRO 31:4">Ni de los gobernantes el licor.<verse eid="PRO 31:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 31:5"/>No sea que al beber, olviden lo que se decretó,</para>
  <para style="q" vid="PRO 31:5">Y perviertan el derecho de todos los afligidos.<verse eid="PRO 31:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 31:6"/>Den el licor fuerte al desfallecido,</para>
  <para style="q" vid="PRO 31:6">Y el vino a los de ánimo amargado,<verse eid="PRO 31:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 31:7"/>Para que beban y olviden su necesidad,</para>
  <para style="q" vid="PRO 31:7">Y ya no se acuerden de su miseria.<verse eid="PRO 31:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PRO 31:8"/>Abre tu boca a favor del mudo,</para>
  <para style="q" vid="PRO 31:8">Defiende la causa de todos los abandonados.<verse eid="PRO 31:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 31:9"/>Abre tu boca, juzga con justicia</para>
  <para style="q" vid="PRO 31:9">Y defiende al pobre y al necesitado.<verse eid="PRO 31:9"/></para>
  <para style="s1">Elogio a la mujer virtuosa</para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 31:10"/>Mujer virtuosa, ¿quién la hallará?</para>
  <para style="q" vid="PRO 31:10">Porque su estima sobrepasa largamente a la de las piedras preciosas.<verse eid="PRO 31:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 31:11"/>El corazón de su esposo está confiado en ella,</para>
  <para style="q" vid="PRO 31:11">Y no carecerá de ganancias.<verse eid="PRO 31:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 31:12"/>Ella le dará bien y no mal</para>
  <para style="q" vid="PRO 31:12">Todos los días de su vida.<verse eid="PRO 31:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 31:13"/>Busca la lana y el lino,</para>
  <para style="q" vid="PRO 31:13">Y diligentemente trabaja con sus manos.<verse eid="PRO 31:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 31:14"/>Es como la nave del mercader,</para>
  <para style="q" vid="PRO 31:14">Que trae su pan desde lejos.<verse eid="PRO 31:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 31:15"/>Se levanta cuando aún es noche,</para>
  <para style="q" vid="PRO 31:15">Da alimento a su familia,</para>
  <para style="q" vid="PRO 31:15">Y la porción asignada a sus criadas.<verse eid="PRO 31:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 31:16"/>Evalúa un campo y lo compra,</para>
  <para style="q" vid="PRO 31:16">Y del fruto de sus manos planta una viña.<verse eid="PRO 31:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 31:17"/>Ciñe con firmeza su cintura,</para>
  <para style="q" vid="PRO 31:17">Y esfuerza sus brazos.<verse eid="PRO 31:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 31:18"/>Ve que sus negocios van bien.</para>
  <para style="q" vid="PRO 31:18">Su lámpara no se apaga de noche.<verse eid="PRO 31:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 31:19"/>Aplica sus manos a la rueca,</para>
  <para style="q" vid="PRO 31:19">Y sus dedos manejan el huso.<note caller="+" style="f"><char style="fr" closed="false">31.19 </char><char style="ft" closed="false">Rueca: Instrumento para hilar. Huso: Instrumento para hilar torciendo la hebra.</char></note><verse eid="PRO 31:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 31:20"/>Extiende su mano al pobre,</para>
  <para style="q" vid="PRO 31:20">Sí, alarga sus manos al necesitado.<verse eid="PRO 31:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 31:21"/>No tiene temor por su familia a causa de la nieve,</para>
  <para style="q" vid="PRO 31:21">Porque toda su familia lleva ropas dobles de color escarlata.<verse eid="PRO 31:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 31:22"/>Teje tapices para sí.</para>
  <para style="q" vid="PRO 31:22">De lino fino y púrpura es su vestido.<verse eid="PRO 31:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 31:23"/>Su esposo es conocido en la puerta</para>
  <para style="q" vid="PRO 31:23">Cuando se sienta con los ancianos de la tierra.<verse eid="PRO 31:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 31:24"/>
    <char style="add">Ella</char> hace ropa de lino y la vende,</para>
  <para style="q" vid="PRO 31:24">Y provee cinturones al mercader.<verse eid="PRO 31:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 31:25"/>Está vestida de fuerza y dignidad,</para>
  <para style="q" vid="PRO 31:25">Y sonríe ante el mañana.<verse eid="PRO 31:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 31:26"/>Abre su boca con sabiduría,</para>
  <para style="q" vid="PRO 31:26">Y la ley de la clemencia está en su lengua.<verse eid="PRO 31:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 31:27"/>Vigila la marcha de su casa,</para>
  <para style="q" vid="PRO 31:27">Y no come su pan de ociosidad.<verse eid="PRO 31:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 31:28"/>Sus hijos crecen, y la consideran inmensamente feliz,</para>
  <para style="q" vid="PRO 31:28">Su esposo también la alaba y dice:<verse eid="PRO 31:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 31:29"/>Muchas mujeres hicieron el bien,</para>
  <para style="q" vid="PRO 31:29">Pero tú las superaste a todas.<verse eid="PRO 31:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 31:30"/>Engañosa es la gracia y vana la hermosura,</para>
  <para style="q" vid="PRO 31:30">La mujer que teme a <char style="nd">Yavé</char> será alabada.<verse eid="PRO 31:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 31:31"/>¡Denle del fruto de sus manos,</para>
  <para style="q" vid="PRO 31:31">Y que sus mismas obras la alaben en la puerta!<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
