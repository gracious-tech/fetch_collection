<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">Romawa</para>
  <para style="toc1">Nungvullǝ Gi Bulus Sua Ya ROMAWA</para>
  <para style="toc2">Romawa</para>
  <para style="toc3">Romawa</para>
  <para style="mt2">Nungvullǝ Gi Bulus Sua Ya</para>
  <para style="mt1">ROMAWA</para>
  <para style="imt1">Bǝ Gabnung Ba</para>
  <para style="ip">Nungvullǝ Gi Bulus Sua Ya Romawa i vullǝ yangbǝ mablǝi bǝ wuo gi Bulus sua ya kǝm pinwa Roma lǝ. Nungkwɔ dǝu yidɗi kwɔ nungɓǝlǝ bǝ tonungto dang ya Krista bǝilǝ lona tuab yang, i bǝ dǝi suo, itǝ Spaniya. U vullǝ yangbǝ u gei nungkwɔ u ibǝi bǝ dǝnyi ya Krista langkwoi i nungkwɔ a tǝi nwongǝi ya Krista nung wam bǝi ɓǝ. Nungvullǝ kwɔ ǝn ba gi Bulus ǝndǝi.</para>
  <para style="ip">Tthasua bǝ gumbǝi ya kǝm pinwa kwɔ Roma ɓǝ langkwoi dǝu gei bǝ pinwa gu loilǝ ɓǝ, Bulus gei lo ba nungvullǝ ɓǝ: &lt;&lt; Ba a langǝ i ɓǝ gei lǝi kwɔ Fuh dǝ yayuu matthǝ tthǝulǝ ɓǝ: Tthǝn tthǝ bǝ dǝnyi tthǝ baipiu la nwasiu tǝlǝ bǝ al lo&gt;&gt; (1.17).</para>
  <para style="ip">Bulus yang gei ba loba lǝ. Yayuu ǝndǝi, ya Yahudawa i yakwɔ ǝnya Yahudawa lǝu kwɔ, dǝna yidɗi i ji matthǝ i Fuh lǝ, bakwɔ i ǝndǝi nathǝ ttha nung a ɓko dǝna loyigwoi i ilǝ. I dǝ yayuu matthǝ i Fuh tthǝ Yeso Kristi dang bǝ dǝnyitthǝ. Tthasi Bulus gei nwongǝi a fuu dang kǝptha i Kristi kwɔ wuo tthǝn tthǝ bǝ kǝptha i Fuh lǝ. Ya dǝba a langǝ i tthǝ i bǝ ǝǝ a langǝ i i Fuh langkwoi i iulǝ nǝkwam i Ɓyang bǝgǝ ttha nung aɓau i ɓuiɓua. Dang nung angǝ a 5-8 Bulus langɓǝ yǝb nungkwɔ i to zuu gi Fuh lǝ bko ɓǝ langkwoi i ttha Ɓyang gi Fuh dang nwongǝi ya dǝba a langǝ i. Yang ya nwatummi gi Yeso kongtha i bǝ ɓyib ba angǝ nǝnǝ ya Yahudawa i yakwɔ ǝnya Yahudawa lǝu kwɔ ǝǝ matthǝ nungkwɔ Fuh dǝna yidɗi lǝ yayuu tthǝ ǝndǝi ɓa. U al lo angǝ bǝ la Yeso kwɔ ya Yahudawa la kwɔ dang nungkwɔ Fuh dǝna yidɗi kwɔ yangbǝ u wullǝ yayuu ǝndǝi tǝi nung a langǝ i Fuh dang Yeso Kristi, langkwoi u dǝba a langǝ i tthǝng angǝ ya Yahudawa lilotthǝ bǝ la Yeso u. Nǝsua Bulus vullǝ lǝikwɔ nwongǝi ya Krista a ǝǝ ɓǝ, manung ba nunglǝi bǝ yidɗi bǝi dang bǝ kǝbtha i yakun. U lǝi i lo nung vullǝ ɓǝ kwɔ lǝ nungto lǝ Fuh tthǝ, nungto ya Krista lǝ losua gu langkwoi lǝ thatthǝ, langkwoi bǝ ɓyib ba lonyi. U al lo nungvullǝ ɓǝ i ba abo langkwoi i ba bǝ kha bǝi tthǝ Fuh.</para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />Ɓang Bulus vull;u nungvullǝ kwɔ, ɓang thǝb gi Yeso Kristi langkwoi ya nwatummi kwɔ Fuh mko langkwoi lubǝim yangbǝ ǝn gei ba a langǝ i gu ɓǝ.<verse eid="ROM 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 1:2" />Nwaba a langǝ i kwɔ Fuh gwab nwuo lakku nwa ya gei ba a tthasi gu, manungkwɔ i vullǝ dang nungvullǝ ba gu a langǝ i ɓǝ. <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />Nwaba a langǝ i ɓǝ dǝna gei ba Yuiu, Dangbang ɓi Yeso Kristi: kwɔ dang sual tthǝ thayuu, i siu dang ya bie Dawuda; <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />kwɔ dang Ɓyang a langǝ i gu lǝ yui Fuh, i gong ttha Fuh u mǝrrǝmmu lǝ Yui Fuh i bǝ ǝrr gu i nwongǝi dang ɓua: Yeso Dangbang ɓi. <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />Tthǝu lǝ Fuh tom nung a langǝ i tthǝ bǝ ǝǝlǝ ya nwatummi lǝba Kristi, yangbǝ ǝn osi lǝ ya losua angǝ a ǝndǝi i dǝba a langǝ i langkwoi i tonungto i ba gu. <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />Nungkwɔ langɓǝ iɓǝ yakwɔ Roma ɓǝ, kwɔ Fuh lubǝi yangbǝ i ǝlǝ a bǝ Yeso Kristi ɓǝ.<verse eid="ROM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />Langkwoi nungkwɔ Ən vullǝ ɓǝtthǝ ǝndǝi kwɔ dang Roma kwɔ Fuh dǝna yidɗi langkwoi lubǝi yangbǝ ɓa ǝlǝ yayuu gu a langǝ i:</para>
  <para style="p" vid="ROM 1:7">Kaso Fuh Daa ɓi langkwoi Dangbang Yeso Kristi dǝɓǝ nung a langǝ i i tǝmmi.<verse eid="ROM 1:7" /></para>
  <para style="s">Bǝ Pinwa To Sakko Lǝ Fuh</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />Nwasiu, ǝn to sakko lǝ Fuhm tthǝ Yeso Kristi lǝ ba ɓǝ ǝndǝi, bakwɔ longwam ǝndǝi dǝna lǝ bǝ dǝba a langǝ i ɓǝ. <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />Fuh lǝ ya karnwam angǝ nung kwɔ ǝn gei kwɔ ǝn ba a langǝ i Fuh kwɔ dǝm tou nung to tthǝ i dang nyim ǝndǝi i bǝ gei ba langǝ i gi Yuiu, Fuh ibǝing vii ǝndǝi dǝm nhǝm baɓǝ <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />lona kwɔ ǝndǝi dǝm pinwa; Dǝm yam geigǝ Fuh dang nung a langǝ i gu mabǝm nunglǝi tthǝ yangbǝ ǝntǝ sua ɓǝ. <verse eid="ROM 1:10" /><verse number="11" style="v" sid="ROM 1:11" />Bakwɔ dǝm yiɗi ɗing bǝ ɓyǝa ɓǝ, yangbǝ ǝn gab nungdǝ Ɓyang khana lo a Langǝ i tthǝ yangbǝ ɓa dǝi nyimtthǝ. <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />Nungkwɔ Dǝm gei kwɔ nungɓǝlǝ i bǝ dǝnyimtthǝ mǝn nwong ɓǝ ɓa dǝi nyimtthǝ, langɓǝ ɓa nwongǝm ǝn dǝi nyimtthǝ i bǝ dǝnyitthǝ ɓǝ.<verse eid="ROM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13" />Ɓa nhǝm, ya ǝnthǝm, kwɔ ǝn ɗulǝi lona kpaatthǝ yangbǝ ǝn wuo suaɓǝ, kwoi vii ǝndǝi nung akun dǝna nannǝm bǝ to manungɓǝ. Dǝm yiɗi bǝ mǝrrǝm yakun dang ɓǝ langɓǝ, manungkwɔ ǝn to dang yakun kwɔ ǝn ya Yahudawa lǝu ɓǝ. <verse eid="ROM 1:13" /><verse number="14" style="v" sid="ROM 1:14" />Bakwɔ Fuh dǝm nung to bǝ gei nwaba a langǝ i lǝ yayuu ǝndǝi ɓǝ, lǝ ya yahudawa i yakwɔ ǝn ya Helinawa lǝu ɓǝ, yakwɔ ibǝ nung i yakwɔ ibǝi lǝu ɓǝ. <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />Nungkwɔ yang, dǝm yiɗi ɗing bǝ gei ɓǝ nwaba a langǝ i tthǝ langɓǝ iya kwɔ ǝǝ Roma ɓǝ.<verse eid="ROM 1:15" /></para>
  <para style="s">Ttha Ba A Langǝ i</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />Ən lǝ tthǝkku bǝ gei ba a langǝ iu, bakwɔ ǝn ttha Fuh babǝ soblo yakwɔ ǝndǝi dǝba a langǝ i tthǝɓǝ: la nwasiu ǝn ba ya Yahudawa, langkwoi yakwɔ ǝnya Yahudawa lǝu ɓǝ. <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />Bakwɔ ba a langǝ i taɓi natthǝ lǝikwɔ Fuh kwoi ɓilǝ wulǝ suo lo nunglǝi a langǝ i: kwɔ i ǝǝ i ulǝ tthǝn tthǝ bǝ dǝnyitthǝ la nwasiu tǝlǝ bǝ al lo. Manungkwɔ nung vullǝ gei ɓǝ angǝ,&lt;&lt;Yuu akwɔ dǝna to nungkwɔ Fuh dǝna yidɗi kwɔ a ǝǝ dang bǝ dǝnyitthǝ a tǝi nwongǝi.&gt;&gt;<verse eid="ROM 1:17" /></para>
  <para style="s">Nung aɓau Gi Thayuu</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />Nyi gi Fuh fug wayi lǝ tthǝ nung a ɓko ǝndǝi langkwoi i mullub gi yayuu kwɔ mullub gi nan ba a langǝ i. <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />Fuh ɗab luai, bakwɔ nungkwɔ i ibǝi lǝ ba Fuh kwɔ kaitthǝ nǝkwam tthǝi lǝ, bakwɔ Fuh i nko lǝ mab nungɓǝ kaitthǝ. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />Baipiu vii kwɔ Fuh mab longwam kwɔ, nung to gi Fuh kwɔ ɓi ɓuan ɓi ɓiu kwɔ, i ttha gu a ɗing langkwoi i nung a langǝ i gu i ɓyǝa kaitthǝ; i ɓyǝa dang nungkwɔ Fuh mab ɓǝ. Yayuu kwɔ yangǝu i bko kwɔ i to nung aɓau ɓǝ! <verse eid="ROM 1:20" /><verse number="21" style="v" sid="ROM 1:21" />I i Fuhng, kwoi i du ghaali kwɔ ǝn abo ɓǝlǝu, i tou sakkou. Kwoi bǝ nhǝm bagi mǝrrǝm lǝ nung a nǝkwam, langkwoi bǝ nhǝm ba a nǝkwam yitthǝ i bǝthǝl kwɔ i ibǝ nungǝu ɓǝ. <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />I gei angǝ i yigg ɗing, kwoi i ǝn ya sullǝ; <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />Kwɔ i wab Fuh ya nwongǝi kwɔ thǝmmu ɓǝ, dǝnni wab killǝng kwɔ i kai i na thayuu mangǝn yuu ko nurug ko nungbyang ko nungkwɔ dǝna krom i biwa ɓǝ.<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />Langkwoi nungkwɔ Fuh dǝ yayuu ɓǝkwɔ lǝ nung to ɓillǝng kwɔ nyii dǝna yiɗi ɓǝ, langkwoi i nung to tthǝkku lǝ tha. <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />I prǝm ba a langǝ i lo Fuh lǝ pǝllǝ, langkwoi i wab langkwoi i to nung to lǝ nungkwɔ Fuh mab nwathan ya mab nungɓǝ i nko lǝ, yuu akwɔ i kha laɗing ɓǝ! Dǝitthǝ manungɓǝ.<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />Bakwɔ i to nungkwɔ, Fuh ji lǝ bǝ yiɗi bǝi kwɔ to tthǝkku niɓǝ. I yasi dǝna lo i yasi nungkwɔ Fuh gwab lǝu ɓǝ. <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />Manungɓǝni yaɓǝi ɓǝ yitthǝ bǝ lo i yasi dǝna lo i tha. Yaɓǝi to nungto tthǝkku i ttha, manung ɓǝnni yang Fuh a wuilǝ bǝ lagbǝi kwɔ natha i nungto aɓau gi ɓǝ.<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />Bakwɔ yayuu akwɔ labǝ dǝ ba a langǝ i bǝ ibǝ Fuh dang nyi, u ji nyi bǝ nhǝm ba sullǝ, yangbǝ i to nungkwɔ kaso bǝ yayuu to thǝɓǝ. <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />Dangwa a ɓko ǝndǝi yitthǝi, mungkullum, bǝ yiɗi lo, bǝ la yakun, bǝ tthǝng bǝi yi dang wai, thǝb bǝi, kwatha, ɗambǝi i bǝ libǝi dang wa. Dǝi gum tthǝ <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />langkwoi dǝnni gei nung a ɓko tthǝ tha; dǝnni tthǝng Fuh, lǝbǝiu, ya lǝi loi, langkwoi ya lo angǝ a; dǝnni nhǝm nunglǝi kpaatthǝ yangbǝ i to mullub; dǝnni tthǝm yakwɔ siǝ ɓǝ; <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />I yangǝu i bǝ nhǝm ba a langǝ iu; i yangǝu i bǝ dǝ ganglangǝu, langkwoi i yangǝu i nyi tǝmmiu ko bǝ ɓyǝa nung zuii yakun. <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />I ibǝi angǝ zuu gi Fuh gei angǝ yayuu akwɔ dǝna to manungkwɔ ni i thǝi. Yirrǝ, ǝn bǝ li lotthǝ bǝ to i nungɓǝ kwɔ ɓuolǝu kwoi dǝnni gwab nwa lǝ yakun bǝ tou.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s">Kwan Gi Fuh</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />Mǝ, ǝnthǝm, dǝma to kwan ganglang yakun lǝ? A yangǝu i bko, ko mǝ ǝn yiǝ ǝndǝi. Nǝ a gei kwan lǝ yakun tthǝ yang langkwoi dǝma to nungkwɔ dǝnni to ɓǝ, a muo lo mǝng. <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />Ɓi ibǝi Fuh to nung a langǝ i kwɔ u to kwan lǝ yayuu kwɔ dǝna tonung manungkwɔ ni ɓǝ. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />Kwoi mǝ, ǝnthǝm, dǝma to i nungɓǝ kullo dǝma to kwan lǝ yakun tthǝ! Ɗǝma ɓyǝa ma ing i dang kwan gi Fuh la? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />Ko dǝma tthǝm bǝ to nung to gu a langǝ i, i bǝ gwab bǝ to nung, i bǝ tthǝb nyitthǝ. Ən ba a langǝ i Fuh ǝn ya nyitǝmmi, bakwɔ dǝnnu yiɗi bǝ mǝrrǝm ma bǝ yitthǝ nung a ɓko mǝ ɓǝ. <verse eid="ROM 2:4" /><verse number="5" style="v" sid="ROM 2:5" />Kwoi lo nyi mǝ ɗarɗing langkwoi a lǝbǝiu, langkwoi nungkwɔ dǝma dǝ zuii lǝ lomǝ ɓuontthǝ vii kwɔ nyi gi Fuh i bǝ to kwan ba gi Fuh a langǝ i a wɔ ɓǝ. <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />Bakwɔ Fuh wa dǝ nwathan koyiǝ ǝndǝi natha i nungkwɔ u toɓǝ <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />Yakun ǝnwa bǝ to matthǝ, langkwoi dǝna ɗu ghaali, bǝdǝ angǝ a, langkwoi nwongǝi a ɗing; Fuh a ji nwongǝi a ɗing. <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />Yakun dǝna yiɗi loi dǝnni la nung a langǝ i, yangbǝ i muo sua nung a ɓko; Fuh a al nyi gu i bǝ ɗab luai. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />Bǝ to zuii ibǝ lǝ tthǝzii dǝi lo yakwɔ dǝna to nung a ɓko ɓǝ, bai piu lo ya Yahudawa nungsi yangbǝ yakwɔ ǝn ya Yahudawa lǝu ɓǝ. <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />Kwoi Fuh adǝ ghaali, bǝ dǝ ghaali i bǝ ǝǝ a langǝ i lǝ yakwɔ ǝndǝi kwɔ dǝna to nung a langǝ i ɓǝ, baipiu i ya Yahudawa langkwoi nwuni bǝ yakwɔ ǝnya Yahudawa lǝu ɓǝ. <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />Bakwɔ Fuh a tokwan lǝ yayuu ǝndǝi tthǝ natha.<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />Yakwɔ ǝn ya Yahudawa lǝu kwɔ yangǝu i zuu gi Musko; i to nung a ɓko kwɔ i yangǝu i zuu gi Musa i la; Ya Yahudawa tthǝ i zuu; i to nung a ɓko i toi kwan tthǝ i zuu gi Musa. <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />Bakwɔ ǝn bǝ lǝ zuu ɓǝ ɓuo nungkwɔ ato yayuu to nung a langǝ i tthasi Fuh lǝu, kwoi ǝn bǝ to nung to i nungkwɔ zuu ɓǝ gei ɓǝ. <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />Yakwɔ ǝn ya Yahudawa lǝu kwɔ yangǝu i zuu; kwoi nǝ tthǝi geitthǝ i to nungkwɔ zuu dǝna yiɗi kwɔ, i ǝn zuu gi, ko kwɔ i yangǝu i zuu ɓǝ. <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />Nung to gi dǝna tanatthǝ angǝ nung kwɔ zuu gei kwɔ i vullǝ dang nyiɛ. Bǝ nhǝm ba gi langkwoi geitthǝ angǝ ǝn ba a langǝ i, manungkwɔ bǝ nhǝm ba vii yakun dǝna gei nung aɓau gi tthǝ langkwoi dǝna karnwuai. <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />Langkwoi nungkwɔ, manungkwɔ ba a langǝ i Fuh gei kwɔ dǝm gei kwɔ, a ǝǝ manungkwɔ ni Villǝ kullo kwɔ Fuh wa to kwan nung a pyǝa ǝndǝi nwa Yeso Kristi.<verse eid="ROM 2:16" /></para>
  <para style="s">Ya Yahudawa I Zuu</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />Bǝ mǝ amǝ? Dǝma lu lomǝ mangǝ mǝ ǝnya Yahudawa; a dǝ kiggǝ mǝ tthǝ zuu gi Musa dǝmma ǝrr dǝmma fog i ɗuǝn Fuh; <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />a ibǝ nungkwɔ Fuh dǝna yiɗi angǝ ato ɓǝng, langkwoi a natthǝ zuu Musa yangbǝ a mko nungkwɔ lǝ a langǝ i ɓǝ; <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />nǝ a ibǝi mǝma munna kab lǝ ya nung ɓuommi, ǝn mǝlǝ lua gabbǝi lǝ yakwɔ dang bǝthǝl ɓǝ, <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />mǝ ǝn ya nanatthǝnung lǝ ya sullǝ, mǝ lǝ ya nanatthǝnung lǝ ya kwɔ ibǝnung lǝu ɓǝ. La langǝ i a ibǝ zuu gi Musa ɓǝng lang a ibǝ to nung a langǝ ing. <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />Dǝma nanatthǝ nung lǝ yakun- ǝn ba ɓǝbǝ a nanatthǝ lǝ lomǝ lǝu? A gei mangǝ,&lt;&lt;Bǝɓa i nung thǝ&gt;&gt; kwoi mǝ i namǝ dǝmma inung a? <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />Dǝmma gei mangǝ,&lt;&lt;Bǝɓa ɓa siyuu thǝ&gt;&gt; kwoi dǝmma ɓa si yuu a? Dǝmma la nung a wab wab kwoi dǝmma i nungkwɔ dang kǝm nyǝknung ɓa? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />Dǝmma fog mangǝ a mua zuu gi Fuhn-kwoi dǝmma dǝ tthǝkku lǝ Fuh ibǝ ɓanglǝ zuu gu?<verse eid="ROM 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 2:24" />Ba gi Fuh gei angǝ,&lt;&lt;Lǝ baɓǝ ya Yahudawa, yakwɔ ǝn ya Yahudawa lǝu kwɔ gei ba a ɓko tthǝ Fuh.&gt;&gt;<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />Nǝ dǝɓa to nung to i zuu gi Musa, yangbǝ ɓǝr nwa ɗuǝ ɓǝ ǝn nung a langǝ i; kwoi nǝɓa to nung to i zuu lǝu, yang kaso krǝ bǝɓa ɓǝr nwa ɗuǝ ɓǝ thǝ. <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />Nǝ yuu akwɔ ǝn ya Yahudawa lǝu kwɔ, kwɔ i ɓǝr nwa ɗuǝ kwɔ, dǝna to nung to i zuu, yang Fuh lǝi mangǝ i ɓǝrnwa ɗuǝng wa? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />Langkwoi nungkwɔ yakwɔ ǝn ya Yahudawa lǝu kwɔ a ɓangɓǝ lǝ bakwɔ ɓa labǝ to nung to i zuu ɓǝ, ko kwɔ i vullǝ ɓa dǝsua lankwoi ɓa ɓǝr nwa ɗuǝng; kwoi yakwɔ ǝnya Yahudawa lǝu kwɔ dǝi to nung to i zuu, ko kwɔ nung wam bǝi lǝ i ɓǝrnwa ɗuǝ lǝu. <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />Tthasua nung ǝndǝi, ǝn yilǝ ya Yahudawa a la langǝ i, ya ɓǝrnwa ɗuǝi la langǝ i? Ən yiɓǝi kwɔ lǝ ya Yahudawa gwam nǝkwam ɓǝlǝu, kwɔ bǝ ɓǝrnwa ɗuǝ ǝn nung a gwam nǝkwam ɓǝ. <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />Nilǝu, ya Yahudawa a langǝ i nungɓǝlǝ yuu akwɔ lǝ ya Yahudawa ttha dang lǝ ɓǝ, nungɓǝlǝ, yuu akwɔ mab dang nyiu ɓǝ, langkwoi nungkwɔ ǝn nungto Ɓyang Fuh, ǝn a bǝ zuu kwɔ i vullǝ ɓǝlǝu. Yuu ɓǝkwɔ tǝi bǝ kha bǝi na Fuh lǝ, na thayuu a ɓilǝng lǝu.<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />Ya Yahudawa pǝll yakwɔ ǝnya Yahudawa lǝu ɓa? ko ǝn ɓǝttǝn lǝ nung a langǝ i ɗing dang bǝ ɓǝr nwa ɗuǝ? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />La langǝ i kpaaɗing, nunglǝi kwɔ ǝndǝi! La nwasiu, Fuh dǝ bagu lǝn ya Yahudawa. <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />Kwoi tonǝnǝ nǝ yakun gi yangǝu i bǝ dǝnyitthǝ? Yang lakwɔ bǝ dǝnyitthǝ gi kwɔ yangǝu kwɔ ɓanglǝ a bǝ Fuh? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />Manungɓǝni lǝu! Fuh ǝn ya ba a langǝ i, yayuu ǝndǝi ǝn ya pǝllǝ. Manungkwɔ bagi Fuh gei ɓǝ,</para>
  <para style="q1" vid="ROM 3:4">&lt;&lt; Kwɔ nǝ a gei ba yang yayuu a ibǝi ǝn ba a langǝ i;</para>
  <para style="q2" vid="ROM 3:4">ma ilo nǝ i to kwan ɓǝ.&gt;&gt;<verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />Kwoi nǝ bǝ to nung a ɓko ɓi tanatthǝ nung a langǝ i gi Fuh kai nǝkwam ɓa? Ɓi ɓuan ɓi gei ɓingǝ Fuh dǝna to nung a ɓko kwɔ nǝ u ɗablua ɓi ɓa? (Nungkwɔ nungɓǝ lǝ bakwɔ ɓi ɓibɓǝ.) <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />Manungɓǝni lǝu! Nǝ Fuh ǝn ya langǝ i lǝu, u tonǝnǝ u to kwan lǝ longwam tthǝ?<verse eid="ROM 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7" />Kwoi to nǝnǝ nǝ pǝllǝm dǝ ghaali lǝ Fuh ibǝ ilǝ ba a langǝ i gu gwam nungpangbǝi a? Kwoi ǝnba ɓǝbǝ i ɓangǝm lǝ lǝba nung a ɓko? <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />Ən ba ɓǝ ɓi geiu, yang,&lt;&lt;Dǝisua ɓi to mullub yangbǝ nung a langǝ i wuo&gt;&gt;? Yakun, la langǝ i, dalǝm i bǝ mum i bǝ gei u nungɓǝkwɔ! I ɓangǝ i lǝ, manung akwɔ kaso i toi lǝ ɓǝ.<verse eid="ROM 3:8" /></para>
  <para style="s">Yuu Akun Yangǝu Lǝ Yato Nung A Langǝ iu</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />Lakwɔ yang, ɓi ya Yahudawa ɓi pǝl yakwɔ ǝn ya Yahudawa lǝu ɓa? Ko tuab nilǝu! Ən osi ǝn taɓǝ natthǝng geigǝ ya Yahudawa i yakwɔ ǝn ya Yahudawa lǝu kwɔ ǝndǝi nung a ɓko dǝna lo yigwoi loi lǝ. <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />Manungkwɔ bagi Fuh gei ɓǝ angǝ:</para>
  <para style="q1" vid="ROM 3:10">&lt;&lt;Yuu akun yangǝu lǝ ya nung a langǝ iu,<verse eid="ROM 3:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="ROM 3:11" />yuu akun yangǝu lǝ ya yigǝiu</para>
  <para style="q2" vid="ROM 3:11">ko dǝna wab Fuh.<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />Yayuu ǝndǝi mǝrrǝm kwoi sua Fuh;</para>
  <para style="q2" vid="ROM 3:12">i ǝndǝi dǝnni to nung a ɓko;</para>
  <para style="q2" vid="ROM 3:12">yuu akun yangǝu dǝna to nung a langǝ iu ko kun.<verse eid="ROM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />Ba gi yitthǝ ibǝ ɗambǝi ɓua;</para>
  <para style="q2" vid="ROM 3:13">pǝllǝ thǝbbǝi dǝna kyal lyǝnni,</para>
  <para style="q2" vid="ROM 3:13">langkwoi ya dǝ nwa bǝi ɓkotthǝ, sual nwai mangǝn yǝng biǝk;<verse eid="ROM 3:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ROM 3:14" />bǝ gei bagi yitthǝ i ɗyǝm aɓau.<verse eid="ROM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />Dǝnni thǝm tthǝi bǝ nkoni bǝi i bǝ thǝb bǝi;<verse eid="ROM 3:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16" />dǝnni yitthǝ bǝ drǝnung i bǝ ɓanglǝ nung bǝi kwɔ i tǝ ǝndǝi.<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />I ibǝ nunglǝi bǝ ǝǝ a langǝ i lǝu,<verse eid="ROM 3:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18" />langkwoi bǝ dǝ angǝ a lǝ Fuh yangǝu dang wai lǝu.<verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />Lakwɔ ɓi ibǝi nung ǝndǝi dang zuu thǝn lo yakwɔ dang zuu lǝɓǝ, kwɔ i lam bǝ gei ba gi yayuu langkwoi i wullǝ yayuu longwam ǝndǝi dang si bǝ gei kwan gi Fuh. <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />Bakwɔ yuu akun yangǝu dang longwam kwɔ lǝ yuu a langǝ i dang si Fuh kwɔ dǝna to nungkwɔ zuu ɓǝ dǝna yiɗi ɓǝu; nungkwɔ zuu ɓǝ dǝna gei kwɔ nungkwɔ dǝna gei lǝ yayuu tthǝ i to nung a ɓko.<verse eid="ROM 3:20" /></para>
  <para style="s">Nunglǝi Kwɔ I Dǝɓi Matthǝ I Fuhlǝ Ɓǝ</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />Kwoi lakwɔ nunglǝi kwɔ Fuh tanatthǝ ba gu a langǝ i lǝ yayuu i nkolǝ kwɔ ing. Ba zuu yangǝu dang ǝu, ko i bakwɔ zuu gi Musa i ya nwatummi gei ba a tthasi dǝ shaida gi tthǝng. <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />Fuh dǝna dǝ yayuu nung a langǝ i ba bǝ dǝnyi gitthǝ dang Yeso kristi. Fuh dǝna tonungkwɔ lǝ yakwɔ ǝndǝi dǝba a langǝ i tthǝ Kristi, bakwɔ nung yangǝu ganglangǝu ko tuab: <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />Yayuu ǝndǝi to nung a ɓko langkwoi tutha i ghaali gi Fuh. <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />Kwoi i nungdǝ gi Fuh a langǝ i i mab yayuu ǝndǝi i dǝ i ulǝ tthǝ Yeso Kristi, kwɔ iilǝ dang nung a ɓko ɓǝ. <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />Fuh dǝ Kristi lǝ nung nyǝknung ba nung a ɓko, yangbǝ ba ziiu mǝrrǝm nung lǝi kwɔ i al dang bǝ dǝnyitthǝ tthǝu lǝ. Fuh to nungkwɔ yangbǝ gei angǝ i ǝn ya nung a langǝ i. Nungsi u tthǝb nyitthǝ langkwoi u fali nung a ɓko yayuu lǝu; kwoi lakwɔ dǝu to kwan lo nung a ɓko gi, yangbǝ u tainatthǝ nung a langǝ i gu. <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />Nunglǝi kwɔ ni lakwɔ Fuh dǝna tanatthǝ i nailǝ ǝn ya nung a langǝ i langkwoi i dǝ yayuu ǝndǝi dǝ ba a langǝ i tthǝ Yeso ɓǝ.<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />Ən ɓǝtǝn, yang, ɓi fog lǝ bko? Nung yangǝu! Langkwoi lǝba ɓǝttǝn? Ən ba angǝ ɓi to nung to i zuu? Nilǝu, kwoi angǝ ǝn bakwɔ ɓi dǝ ba a langǝ itthǝ Yeso ɓǝ. <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />Bakwɔ ɓi osi ɓi alo ɓi gei ɓingǝ i mǝrrǝm yuu la langǝ i i Fuh lǝ tthǝ bǝ dǝnyitthǝ Fuh ɓuo, langkwoi ǝn bǝ to nungkwɔ zuu gei ɓǝlǝu. <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />Ko Fuh ǝn Fuh ya Yahudawa ɓuo? Fuh ǝn Fuh yakwɔ ǝn ya Yahudawa lǝu langɓa? Manungɓǝnni u ǝn Fuh gi. <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />Fuh kunɗǝng, langkwoi u wulǝ ya Yahudawa lǝ tthǝu bǝ dǝnyitthǝ Fuh gi, langkwoi u dǝ yakwɔ ǝn ya Yahudawa lǝu kwɔ tthǝ bǝ dǝnyitthǝ gi.<verse eid="ROM 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 3:31" />Lakwɔ yang dǝna gei angǝ bǝ dǝnyitthǝ ɓi al zuu lǝta? Nilǝu, ko tuab; niyang, ɓi to nung to i zuu ɓǝ.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s">Bǝ Nanung Tthǝ Ibrahim</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />Ən ɓǝttǝn ɓi gei, yang, i Ibrahim, Daa bǝpi ɓi? Ən ɓǝttǝn u ibǝi dang bakwɔ? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />Nǝ i dǝ ibrahim matthǝ i Fuh i nungkwɔ u toɓǝ, yang utthǝ i nungkwɔ u fog lǝ bko ɓǝ- kwoi tthǝn ɗǝgsi Fuh lǝu. <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />Ba gi Fuh gei angǝ, &lt;&lt;Ibrahim dǝba a langǝ i tthǝ Fuh, lǝ ba a langǝ i gu Fuh gwabbu lǝ ya tonung a langǝ i.&gt;&gt; <verse eid="ROM 4:3" /><verse number="4" style="v" sid="ROM 4:4" />Yuu akwɔ to nung to i kwai nung busoni gu, kwoi i lǝi nung busoni ɓǝ angǝ ǝn nungdǝu; ǝn nung busoni kwɔ i to nung to lǝ bko ɓǝ. <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />Kwoi yakwɔ dǝi lo bǝ dǝnyitthǝ Fuh, lo nung to lǝu, langkwoi kwɔ dǝba a langǝ i tthǝ Fuh kwɔ gei yakwɔ kwan mui angǝ i ibǝ nunglǝu, ǝn u bǝ dǝnyitthǝ kwɔ Fuh a lǝi yangbǝ u ji matthǝ tthǝulǝ. <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />Nungkwɔ nungɓǝ lǝ nungkwɔ Dawuda gei kwɔ u gei ba lo bǝ khana lo yuu akwɔ Fuh gwabbu angǝ ǝn yato nung a langǝi ɓǝ, ttha sua nung to kwɔ u toɓǝ.<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />&lt;&lt;Bǝ khana lo ǝn yakwɔ i al mullub gi lǝtǝ ɓǝ,</para>
  <para style="q2" vid="ROM 4:7">yakwɔ i al nung a ɓko gilǝtǝ ɓǝ!<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />Bǝ khana lo ǝn yuu akwɔ Dangbang gǝm nung a ɓko gu lǝuɓǝ!&gt;&gt;<verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />Ba bǝ khana lo kwɔ Dawuda gei bko kwɔ ǝn a bǝ ya ɓǝr nwa ɗuǝ ɓuo? Nilǝu la langǝ i! Ən a bǝ yakwɔ i ɓǝr nwa ɗuǝi lǝu langɓǝ ɓǝ. Bakwɔ ɓi ɓǝr nung thanni ba Fuh gei angǝ,&lt;&lt;Ibrahim dǝ ba a langǝ i tthǝ Fuh, langkwoi ba bǝ dǝnyiutthǝ Fuh gwabbu lǝ ya nung a langǝ i tthasi Fuh.&gt;&gt; <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />Nungkwɔ to nung nǝɓǝ? Nwuni bǝ i ɓǝrnwa ɗuǝ Ibrahim ko tthasua kwɔ i ɓǝrnwa ɗuǝu ɓa? Nwuni bǝ i ɓǝrnwa ɗuǝu, tthasua bǝ ɓǝr nwa ɗuǝ lǝu. <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />I ɓǝr nwa ɗuǝu nǝsua, langkwoi bǝ ɓǝr nwa ɗuǝu ǝn nungkwɔ a tanatthǝ angǝ ba bǝ dǝ nyiu tthǝ Fuh gwabbu lǝ yato nung a langǝ i nwuni bǝ i ɓǝr nwa ɗuǝu. Langkwoi nungkwɔ Ibrahim lǝ daa a ɓyang yakwɔ ǝndǝi dǝ ba a langǝ i tthǝ Fuh langkwoi i gwabbǝi lǝya to nung a langǝ i tthǝu lǝ, ko kwɔ i ɓǝr nwa ɗuǝi lǝu ɓǝ. <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />U langkwoi lǝ Daa yakwɔ i ɓǝr nwa ɗuǝi ɓǝ, nungɓǝlǝ, a bǝ yakwɔ, ǝn nwa ɗuǝ ɓǝ ɓuo i ɓǝr ɓǝlǝu, langkwoi i ǝǝ dang nwongǝi i bǝ dǝnyitthǝ kwɔ Daa ɓi Ibrahim ǝǝ dang ǝu bǝ nwuni i ɓǝr nwa ɗuǝ ɓǝ.<verse eid="ROM 4:12" /></para>
  <para style="s">I Muo Bǝ Gwabnwa Gi Fuh Tthǝbǝ Dǝnyitthǝ.</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />Kwɔ Fuh dǝ ganglang gu i Ibrahim i ya bǝpi gu angǝ longwam ǝn abo, u to ni, ǝn bakwɔ Ibrahim dǝba a langǝ i tthǝ zuu ɓǝlǝu, kwoi bakwɔ u dǝ ba a langǝ i tthǝ langkwoi Fuh gwabbu lǝ ya tonung a langǝ i ɓǝ. <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />Bakwɔ nǝ nungkwɔ Fuh gwab nwa lǝ bko kwɔ nǝ u dǝlǝ ǝn yakwɔ dǝna to nung to i zuu ɓuo, yangbǝ dǝnyitthǝ ǝǝlǝ nung akun lǝu langkwoi bǝ gwab nwa gi Fuh ǝn nung a nǝkwam. <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />Zuu dǝna wulǝ nyi gi Fuh; kwoi bǝi kwɔ zuu yangǝu, bǝ labǝ to nung to i zuu yangǝu.<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />Langkwoi nungkwɔ niyang bǝ gwab nwa ɓǝ dǝi lo bǝ dǝnyitthǝ, yangbǝ bǝ gwab nwa ǝǝ manungkwɔ Fuh dǝ lǝ ya bǝpi Ibrahim nǝkwam ǝndǝi kwɔ-ǝn ba yakwɔ to nung to i zuu ɓǝ ɓuo lǝu, kwoi langkwoi i yakwɔ dǝ ba a langǝ itthǝ manungkwɔ Ibrahim toɓǝ. Bakwɔ Ibrahim ǝn Daa ɓi yakwɔ dǝna muo sua Fuh ɓǝ; <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />manungkwɔ nungvullǝ bagi Fuh gei angǝ, &lt;&lt; Ən mǝrǝm ma lǝ Daa ya losua kpaatthǝ.&gt;&gt;Yang bǝ gwab nwa ɓǝ maɗing tthasi Fuh lǝ, dang ǝu lakwɔ Ibrahim dǝ ba a langǝi tthǝ ɓǝ- Fuh kwɔ dǝna illǝ yayuu bǝ ɓui ɓua ji nwongǝi langkwoi ba gu wulǝ nwongǝi lǝ nungkwɔ tthǝ yangǝu ɓǝ. <verse eid="ROM 4:17" /><verse number="18" style="v" sid="ROM 4:18" />Ibrahim dǝ ba a langǝ i langkwoi dǝnyitthǝ, ko kwɔ u yangǝu i nungkwɔ u dǝnyitthǝ ɓǝu, langkwoi nungkwɔ u mǝrǝmlǝ &lt;Daa ya losua ǝndǝi.&gt;&gt;Manungkwɔ nungvullǝ ba gi Fuh gei ɓǝ, &lt;&lt;Ya bǝpi mǝ a kpaa mangǝ ǝn vin.&gt;&gt; <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />Viilǝ kulo tthko gɓag thǝmnu; kwoi bǝ dǝ nyiutthǝ gu muan lǝu kwɔ nǝ u nhǝm tthǝu kwɔ mangǝ ɓuing ɓǝ, kwɔ owhsi ɓui nung wam bǝiɓǝ, ko kwɔ lǝ ba a langǝ i kwɔ Saratu ɓuan si yathangǝu bakwɔ u ǝndǝgǝm ɓǝ. <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />Bǝ dǝnyiutthǝ Fuh yiu lǝu, langkwoi u to shaka i ganglang Fuh i ulǝ lǝu; bǝ dǝnyiutthǝ yi tthǝu i ttha, langkwoi u kha Fuh. <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />U gwabbǝng la langǝ i angǝ Fuh a ɓuan a to nungkwɔ u gwab nwa ɓǝ.<verse eid="ROM 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 4:22" />Ən baɓǝ kwɔ Ibrahim, babǝ dǝnyitthǝ, &lt;&lt;Fuh gwabbu lǝ yato nung a langǝ i.&gt;&gt; <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />Bakwɔ i gei angǝ&lt;&lt; i gwabbu lǝya to nung a langǝ i tthasi Fuh kwɔ&gt;&gt; i vullǝ lǝn utthǝ ɓuo lǝu.<verse eid="ROM 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 4:24" />I vullǝ langɓǝ lǝn baɓi yakwɔ i gwab ɓi lǝya to nung a langǝ i, yakwɔ dǝ ba a langǝ i tthǝ yuu akwɔ ǝrr lǝ Yeso Dangbang ɓi bǝ ɓui ɓua lǝɓǝ. <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />Ən ba nung a ɓko ɓi i du yangbǝ i thǝu, langkwoi i ǝrrǝu lǝ i nwongǝi yangbǝ u dǝ ɓi matthǝ i Fuh lǝ.<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s">Matthǝ I Fuh</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />Lakwɔ i dǝɓi matthǝ i Fuh babǝ dǝnyitthǝ, ɓitthǝ i bǝ ǝǝ i tthǝla i Fuh tthǝ Dangbang Yeso Kristi. <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />Fuh wu ɓilǝ tthǝ bǝ dǝnyitthǝ ɓi ibǝ ibǝi nung a langǝ i gi Fuh, dang ǝu lakwɔ nungkwɔ dǝbɓi nwong. Langkwoi nungkwɔ dǝɓi fog lǝba bǝ dǝ nyitthǝ bǝ tǝi dang ghaali gi Fuh! <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />Dǝɓi fog lǝba zuii ɓi langɓǝ, bakwɔ ɓi ibǝing zuii dǝna wulǝ bǝ nyimnyi, <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />bǝ nyimnyi a wulǝ bǝ gwabnwa gi Fuh, langkwoi bǝ gwabnwa gu a mab bǝ dǝ nyitthǝ.<verse eid="ROM 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 5:5" />Bǝ dǝnyitthǝ ɓǝkwɔ dǝɓi tthǝkku lǝu, bakwɔ Fuh al bǝ yiɗi bǝi gu dang nyi ɓi tthǝ Ɓyang a Langǝ i, kwɔ lǝ nungdǝ gi Fuh kwɔ dǝɓi ɓǝ.<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />Bakwɔ yirrǝ ya valli ɓi yangǝu ɓǝ, Kristi ɓuilǝ ba ya nyiɓko lona akwɔ Fuh mkoɓǝ. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />Ziɗing Kwɔ yuu akun a ɓui lǝba ya nungto a langǝ iɓǝ. Lǝba yuu a langǝ i yuu kun a ɓuan a ɓumɓui. <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />Kwoi Fuh taɓi natthǝ bǝ yiɗi bǝi kwɔ dǝu yiɗi ɓilǝ ɓǝ- kwɔ yirrǝ ɓilǝ ya nung a ɓko ɓǝ nungkwɔ Kristi ɓui lǝba ɓi! <verse eid="ROM 5:8" /><verse number="9" style="v" sid="ROM 5:9" />I zii Yeso lakwɔ i dǝɓi matthǝ i Fuh lǝ; tonǝnǝ tǝn, lakwɔ, i nwong ɓi dang nyi gi Fuh! <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />Ɓi ǝn ya ɓui gi Fuh, kwoi u mǝrrǝm ɓilǝ ya ǝnthǝu tthǝ bǝ ɓui gi yuiu. Lakwɔ ɓi ǝn ya ǝnthǝ gi Fuh, tonǝnǝ kwɔ i nwong ɓi lǝ ba nwongǝi gi Kristi! <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />Kwoi al lo ǝndǝi lǝu; dǝ ɓi lǝ tthǝ la ba nungkwɔ Fuh to tthǝ Dangbang Yeso Kristi, yuu akwɔ mǝrrǝm ɓi lǝ ya ǝnthǝ Fuh ɓǝ.<verse eid="ROM 5:11" /></para>
  <para style="s">Adamu I Kristi</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />Nung a ɓko wuo longwam tthǝn tthǝ yuu kun, langkwoi nung a ɓko gu wuɓilǝ ɓua tthǝ. Lǝ baɓǝ kwɔ, ɓua thko mǝrrǝm lo tthayuu longwam ǝndǝi bakwɔ yayuu ǝndǝi to nung a ɓko ɓǝ. <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />Nung a ɓko tthǝ longwam nwuni bǝ i dǝ zuu, kwoi bǝi kwɔ zuu yangǝu yang, i than nung i dǝlǝ ba nung a ɓko. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />Kwoi baipiu lona gi Adamu tǝlǝ lona gi Musa, ɓua dǝna lo yigwoi lo yayuu ǝndǝi, i yakwɔ to nung a ɓko manungkwɔ Adamu to ɓǝlǝu kwɔ u labǝ to nung to i bagi Fuh ɓǝ.</para>
  <para style="p" vid="ROM 5:14">Adamu lǝ killǝng Kristi kwɔ dǝna wuɓǝ. <verse eid="ROM 5:14" /><verse number="15" style="v" sid="ROM 5:15" />Kwoi i kwɔ rab kwɔ natha lǝu, bakwɔ nungdǝ gi Fuh nǝkwam kwɔ natha i nung a ɓko gi Adamu lǝu. Ən ba a langǝ i yayuu kpaatthǝ ɓui lǝ ba nung a ɓko yuu kun ɓǝ kullo. Kwoi nung a langǝ i gi Fuh ghaaɗing, langkwoi nungkwɔ nungdǝ gu lǝ yayuu kpaatthǝ tthǝ nung a langǝ i yuu kun, Yeso Kristi. <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />Langkwoi bǝ tatha mual tthǝ ganglang nungdǝ gi Fuh i bǝ to nung a ɓko gi yuu kun, Tthasua nung a ɓko yuu kun kwɔ, yang kwan&lt;&lt;Kwan muu&gt;&gt;; kwoi tthasua nung a ɓko kpaatthǝ, nungkwɔ ɓi to nung to lǝu kwɔ wulǝ nungdǝ a &lt;&lt;Kwan muo lǝu!&gt;&gt; <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />Ən ba a langǝ i tthǝ nung a ɓko gi yuu kun ɓua baipi bǝ lo yigwoi ba yuu kun ɓǝ kullo. Kwoi ghaa nǝnǝ nungkwɔ yuu kun toɓǝ, Yeso Kristi! Yakwɔ ǝndǝi muo nungdǝ kpaatthǝ gi Fuh nung a langǝ i gu langkwoi i mabbǝi matthǝ i yuu akwɔ a loyigwoi dang nwongǝi tthǝ Kristi ɓǝ.<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />Nungkwɔ yang, manungkwɔ nung a ɓko gi yuu kun ɓanglǝ yayuu ǝndǝi, manung ɓǝnni bǝ to nung a langǝ i gi yuu kun a ilǝ yayuu a ji nwongǝi. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />Langkwoi manungkwɔ i mǝrrǝm yayuu lǝ ya to nung a ɓko ba bǝ la bǝ to nung to i ba gi Fuh gi yuu kun, manung ɓǝnni langkwoi ba bǝ to nung a langǝ i gi yuu kun Fuh a mǝrrǝmmǝi lǝ ya langǝ i ba bǝ to nung to i ba gi Fuh gi yuu kun.<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />I wulǝ zuu yangbǝ bǝ to nung a ɓko ǝǝlǝ nung a ɓko, kwoi bǝi kwɔ nung a ɓko nǝ lilo, yang nung a langǝ i gi Fuh langɓǝ lilo kpaatthǝ. <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />Nungkwɔ yang, manungkwɔ nung a ɓko dǝi lo yigwoi tthǝ ɓui ɓua, nungkwɔ langɓǝ nung a langǝ i gi Fuh dǝna lo yigwoi tthǝn tthǝ nung to a langǝ i dǝna tǝɓi lǝ nwongǝi a ɗing tthǝ Yeso Kristi Dangbang ɓi.<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s">Nwongǝi Afu Dang Kristi</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />Ən ɓǝttǝn ɓi gei, lakwɔ? Ɓi ǝǝnwa bǝ to nung a ɓko yangbǝ nung a langǝ i gi Fuh lilo? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />La langǝ i nilǝu! Ɓi ɓuing tthǝ nung a ɓko-to nǝnǝ yang ɓi ǝǝ nwa bǝ to nung a ɓko? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />Ba a langǝ i ɓa ibǝi lakwɔ kwɔ i woll ɓi mung ɗiggǝ nung a ɓko ibǝ kǝbtha lo i Kristi Yeso, i woll ɓi mung dang bǝ kǝbtha dang bǝ ɓui ɓua gu <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />I bǝ wollmung ɗiggǝ nung a ɓko ɓi, yang, Fuh suu ɓi i ulǝ, langkwoi ɓi gab bǝ ɓui ɓua gu lǝtha i ulǝ, yangbǝ, manung kwɔ Fuh ǝrrǝu lǝ dang bǝ ɓui ɓua Kristi i ghaali i ttha gi Daa gu, nungkwɔ langɓǝ ɓi ǝǝ dang nwongǝi afu.<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />Nǝ bakwɔ ɓi ǝǝ kun i u dang bǝ ɓui ɓua, manungɓǝnni langkwoi ɓi ǝǝ kun i u bǝ ǝrrǝu i nwongǝi manung abo. <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />Langkwoi ɓi ibǝing nwongǝi ɓi a kuu ɓuing i Kristi lo kab gangǝ i gu, yangbǝ Fuh ɓanglǝ ttha nung a ɓko ɓi, yangbǝ bǝ ɓi ǝǝlǝ thǝb gi nung a ɓko thǝ. <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />Bakwɔ nǝɓi ɓui, yang Fuh iɓilǝ dang ttha nung a ɓko.<verse eid="ROM 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 6:8" />Kwɔ ɓi ibǝi ɓi ɓui i Kristi, ɓi dǝ ba a langǝ i tthǝng ɓi ǝǝ i ulǝ.<verse eid="ROM 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 6:9" />Bakwɔ ɓi ibǝing Fuh ǝrr lǝ Kristi bǝ ɓui ɓua langkwoi u ɓui akunu ɓua lo yigwoi lo akunu. <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />Langkwoi nungkwɔ, bakwɔ u ɓui ɓǝ, nung a ɓko yangǝu i ttha lo lǝu; langkwoi lakwɔ u ǝǝ i nwongǝi gu i tthǝ la i Fuh lǝ. <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />Manung ɓǝnni yang ɓa nhǝm loɓǝ ɓangǝ ɓa ɓui ǝn ɓui, lǝ ba nung a ɓko, kwoi ɓa ǝǝ dang tthǝ la i Fuh tthǝ Kristi Yeso.<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />Nung a ɓko bǝ lo yigwoi tthǝ ɓǝ kwɔ a ɓumɓui ɓǝthǝ, yangbǝ bǝ ɓa to nung to i nungkwɔ sual tthǝ ɓǝ dǝna yiɗi ɓǝthǝ. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />Bǝ ɓa dǝ gabbǝi tthǝ ɓǝ lǝ nung a ɓko yangbǝ i tolǝ nung to nyi ɓko thǝ. Manungkwɔni yang, ɓa dǝ tthǝ ɓǝ lǝ Fuh, manung yakwɔ i idang bǝ ɓui ɓua wɔ dang nwongǝi ɓǝ, langkwoi ɓa yitthǝ tthǝ ɓǝ ǝndǝi, bǝ tolǝ nung to a langǝ i. <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />Bǝ nung a ɓko ǝǝlǝ togwoi ɓǝthǝ; bakwɔ zuu loɓǝ lǝ lǝuɓǝ kwoi nung a langǝ i Fuh loɓǝ.<verse eid="ROM 6:14" /></para>
  <para style="s">Ɓǝ Əǝ Dang Nung to A Langǝ i</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />Ən ɓǝttǝn, langkwoi? Ɓi to nung a ɓko, bakwɔ zuu yangǝu i kwan lo ɓiu nung a langǝ i gi Fuh loɓi ɓa? Yangǝu ko tuab! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />Ɓa ibǝing la langǝ i angǝ kwɔ yuu akwɔ ɓa dǝ loɓǝ lǝ thǝb gu bǝ to nung to i ba yuu akun, ɓǝ ǝn thǝb gi yuu gwoi ɓǝkwɔ dǝ ɓa to nung to i bagu ɓǝ- ko nung a ɓko, kwɔ a tǝlǝ bǝ ɓui ɓua ɓǝ, ko bǝ to nung to i ba gu, kwɔ a tǝlǝ bǝ ǝǝ matthǝ tthasi Fuh ɓǝ. <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />Kwoi sakko ǝn a Fuh! Bakwɔ vii a kun kwɔ pa kwɔ ɓǝ ǝn thǝb gi nung a ɓko, dǝ ɓa to nung to i ba a langǝ i i nyi kun dang bǝ nanung kwɔ ɓa muo ɓǝ. <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />Fuh iɓǝlǝ dang nung a ɓko ɓa mǝrrǝm lǝ thǝb gi nung a langǝ i. <verse eid="ROM 6:18" /><verse number="19" style="v" sid="ROM 6:19" />(Dǝm to nung to i nwa a vii ǝndǝi ba tthǝ muani sual tthǝ ɓǝ,) Lona kun ɓa dǝ loɓǝ ǝndǝi lǝ thǝb tthǝ nung a ɓko i nung dang mullub lǝ ɓa to nung to mullub. Manungɓǝ ɓa dǝ loɓǝ lǝ thǝb nung a langǝ i lǝ ba nung a langǝ i.<verse eid="ROM 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20" />Kwɔ ɓǝlǝ thǝb gi nung a ɓko, ɓa tǝi loɓǝ dang nung to a langǝ i lǝu.<verse eid="ROM 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 6:21" />Ən ɓǝttǝn ɓa tǝi dang bǝ to nungkwɔ lakwɔ dǝɓa lǝ tthǝkku tthǝɓǝ? I nungkwɔ a al lo ǝndǝi dang bǝ ɓuiɓua! <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />Kwoi lakwɔ Fuh iɓǝlǝ dang nung a ɓko langkwoi ɓǝ ǝn thǝb gi Fuh. Nungkwɔ ɓa tǝi nung ɓǝ lǝ nwongǝi ɓa du ǝndǝi, langkwoi bǝ al lo ǝn nwongǝi a ɗing. <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />Bakwɔ nung a ɓko dǝna kwai nung busoni gu- bǝ ɓuiɓua; kwoi nungdǝ gi Fuh ǝn nwongǝi a ɗing dang tha i Kristi Yeso Dangbang ɓi.<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s">Bǝ Nanatthǝ Nung Babǝ Dǝb Yisi</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />La langǝ i ɓa ibǝi nungkwɔ dǝm tǝ bǝ geiu ɓǝ, ya ǝnthǝm, bakwɔ ɓǝ ǝndǝi ɓa ibǝ nung lo zuun. Zuu dǝna to nung to lo yayuu kwɔ yirrǝ i inwongǝi ɓǝ.<verse eid="ROM 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 7:2" />Yisi kwɔ dǝbgwoi, manung kwɔni, i tthǝbbu i zuu tthǝ ɓǝiu nǝ yirrǝ u i nwongǝi ɓǝ; kwoi nǝ u ɓui, yang u i dang zuu kwɔ ganglang gu i ɓǝiu ɓǝng. <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />Nungkwɔ yang, nǝ u dǝb yiɓǝi akun yirrǝ ɓǝiu longwam yang, i gei angǝ u ǝn ya to nung a nǝkwam; kwoi nǝ ɓǝiu ɓui, yang zuu gwabbu tthǝ u tǝi long nǝ u dǝb yiɓǝi akun yang dǝnnu to nung a nǝkwam lǝu. <verse eid="ROM 7:3" /><verse number="4" style="v" sid="ROM 7:4" />Manung ɓǝnni i ɓǝlǝ, ya ǝnthǝm. Manungkwɔ zuu gei ɓǝ, ɓǝ lang ɓaɓui bakwɔ ɓǝ ǝn tthǝ Kristi ɓǝ; langkwoi ɓǝ ǝn a bǝ yuu akwɔ ǝrr bǝ ɓui ɓua lǝ yangbǝ ɓi mǝrǝm lǝ nung a langǝ i dang nungto gi Fuh.<verse eid="ROM 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 7:5" />Bakwɔ nǝɓi ǝǝ manungkwɔ sual tthǝ yuu dǝna yiɗi, bǝ to nung a ɓko ǝǝr lǝ zuu kwɔ dǝi to nung to dang tthǝ ɓi, langkwoi nung ǝndǝi kwɔ ɓi to kwɔ al lo dang bǝ ɓui ɓua.<verse eid="ROM 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 7:6" />Lakwɔ, niyang, ɓi i dang zuu lǝng, bakwɔ ɓi ɓuing tthǝ nung kullo viikwɔ muo ɓi lǝ ya pursǝna ɓǝ. Lakwɔ ɓi ǝǝ dang zuu aku kwɔ i vullǝ ɓǝu, lakwɔ ɓi tthǝn dang Ɓyang a langǝ i afu.<verse eid="ROM 7:6" /></para>
  <para style="s">Zuu I Nung aɓau</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />Ɓi gei ɓi angǝ, yang, zuu i nko lǝ ǝn nung a ɓko? Manung ɓǝlǝu! Kwoi ǝn zuu ɓǝ tom nungkwɔ ǝn ibǝ nung a ɓko. Nǝ zuu gei angǝ,&lt;&lt;Bǝ a dǝ nyitthǝ nungkwɔ ǝn a bǝ yuu akun ɓǝthǝ,&gt;&gt;Yang krǝ ǝn ibǝi bǝ yiɗi i nungɓǝ kwɔ lǝu. <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />Kwoi tthǝ nung zuu ɓǝ kullo nung a ɓko tǝi nunglǝi bǝ wuu bǝ ǝǝr lǝ nunglǝi bǝ yiɗi lo tthǝm lǝ. Bakwɔ nǝ zuu yangǝu yang, nung a ɓko ǝn nungkwɔ ɓuing. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />Ɓang i namlǝ viikwɔ i nwongǝi ǝn ba zuu lǝu; kwoi kwɔ nungzuu wua, nung a ɓko dǝi nǝbo tthǝmlǝ, <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />yang ǝn ɓui. Langkwoi ba zuu kwɔ a wulǝ nwongǝi kwɔ, lǝ ba abǝm wulǝ ɓua. <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />Nung a ɓko to nung to i ttha zuu ɗammǝm lǝ, langkwoi to nung to i zuu thǝbbǝm lǝ.<verse eid="ROM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12" />Nungkwɔ yang, zuu inko lǝ ǝn nung a langǝ i, lang zuu ǝn nung a langǝ i, langkwoi maɗing. <verse eid="ROM 7:12" /><verse number="13" style="v" sid="ROM 7:13" />Kwoi yang nungkwɔ ǝn nung a langǝ i kwɔ wumlǝ ɓuatthǝ? Manung ɓǝlǝu! Ən nung a ɓko to nungkwɔ; tthǝ bǝ to nung i nungkwɔ ǝn a langǝ i, nung a ɓko wumlǝ ɓuatthǝ, manung kwɔ lǝ ba a langǝ i kwɔ i ilǝpi nung aɓau lǝ gwam. Langkwoi nungkwɔ ni yang, tthǝn tthǝ ba a nungzuu i ilǝ nung aɓau dǝi ɓkotthǝ.<verse eid="ROM 7:13" /></para>
  <para style="s">Vǝm Dangtthǝ Ɓi</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />Ɓi ibǝi zuu ǝn nung Ɓyang; kwoi ɓang ǝn thayuu kwɔ a ɓumɓui ɓǝ, i ɗyǝabǝm lǝ thǝb lǝ nung a ɓko tthǝ.<verse eid="ROM 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 7:15" />Ən ibǝ nungkwɔ dǝm to ɓǝlǝu; bakwɔ ǝn to nungkwɔ dǝm yiɗi bǝ tou ɓǝu, kwoi langkwoi dǝm to nungkwɔ ǝn yiɗi bǝ tou lǝu ɓǝ. <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />Langkwoi nǝ dǝm to nungkwɔ ǝn yiɗi bǝ tou lǝu, yang nungkwɔ to mangǝ ǝn gwabǝng geigǝ zuu ǝn nung a langǝ i. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />Manung kwɔni yang ǝn ɓang ǝn to i nungkwɔ lǝu; kwoi ǝn nung a ɓko kwɔ dang tthǝm ɓǝ. <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />Ən ibǝing nung a langǝ i ǝǝ dang tthǝm lǝu- nungɓǝ lǝ, dang sualtthǝ nung a ɓko. Bakwɔ dǝm yiɗi bǝ to nung a langǝ i, kwoi yang ǝn ɓuan ǝn tou. <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />Ən to nung a langǝ i kwɔ dǝm yiɗi bǝ tou ɓǝu; manung kwɔni, dǝm to nung a ɓko kwɔ ǝn yiɗi bǝ tou lǝu ɓǝ. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />Nǝ ǝn to nungkwɔ ǝn yiɗi bǝ tou ɓǝlǝu, manung kwɔni yang ǝn ɓanglǝ yuu akwɔ dǝna to ɓǝlǝu; yang, ǝn nung a ɓko kwɔ ǝǝ dang tthǝm kwɔ dǝna to yang dǝm to nung a ɓko.<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />Nungkwɔ ǝn tǝi zuu kwɔ dǝna to nung to: kwɔ nǝ dǝmǝn yiɗi bǝ to nungkwɔ lǝ a langǝ i, yang nungkwɔ lǝ nung a ɓko kwɔ nungɓǝkwɔ ǝn mko.<verse eid="ROM 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 7:22" />Dangwam dǝna lǝ tthǝla zuu gi Fuh.<verse eid="ROM 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 7:23" />Kwoi ǝn ɓyǝa zuu akun nǝkwam dǝna to nung to dang tthǝm- zuu kwɔ dǝna ɓuob vǝm i zuu kwɔ dang wam dǝna yiɗi ɓǝ. Zuu afu kwɔ dǝna mǝrrǝm mǝm lǝ ya pursǝna tthǝ zuu nung a ɓko kwɔ dǝna to nung to dang tthǝm ɓǝ. <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />Ɓang ǝn yuu a nwuni kwɔ lǝ tthǝ la lǝu ɓǝ! Ən yittǝn a imlǝ dang nungkwɔ a tǝm lǝ bǝ ɓui ɓua ɓa? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />Dǝmǝn kha Fuh, kwɔ tom nungkwɔ tthǝ tthasi Dangbang ɓi Yeso Kristi ɓǝ!</para>
  <para style="p" vid="ROM 7:25">Nungkwɔ, yang, lǝ nunglǝim: ɓang i namlǝ mǝng muo sua Fuh i lo nyim ǝndǝi, yang sual tthǝm a to nung to gi zuu nung a ɓko.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s">Nwongǝi Dang Ɓyang</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />Bǝ ɓanglǝ bǝi yangǝu lakwɔ ba yakwɔ dang tha i Kristi Yeso ɓǝ. <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />Bakwɔ zuu gi Ɓyang a langǝ i, kwɔ wuɓi lǝ nwongǝi dang bǝ kǝb ɓi lǝtha i Kristi Yeso, kwɔ imlǝ dang zuu nung a ɓko langkwoi i ɓua lǝ. <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />Nungkwɔ zuu ɓuan touɓǝ, bakwɔ sualtthǝ yuu muanɗing ɓǝ, Fuh to. U ɓanglǝ nung a ɓko dang sualtthǝ yuu ibǝ tumbǝi i yuiu, yuu akwɔ wuo i sualtthǝ yuu mangǝn tthǝ nung a ɓko ɓi, yangbǝ u nan nung a ɓko. <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />Fuh to nungkwɔ yangbǝ nung a langǝ i kwɔ zuu dǝna yidɗi kwɔ ǝǝ matthǝ dang ɓi langkwoi a ǝǝ mangǝn Ɓyang, langkwoi mangǝn sualtthǝ thayuu lǝu. <verse eid="ROM 8:4" /><verse number="5" style="v" sid="ROM 8:5" />Yakwɔ ǝǝ dang kiggǝ yuu manung kwɔ sualtthǝ yuu dǝna yidɗi angǝ i toɓǝ. Yakwɔ ǝǝ manungkwɔ Ɓyang gei angǝ i to kwɔ, dǝnni to nungkwɔ Ɓyang dǝna yiɗi angǝ i toɓǝ. <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />Nyi yiɓǝi ya nung a ɓko ǝn bǝ ɓui ɓua; kwoi nyi yuu akwɔ Ɓyang dǝna olǝ si ǝn nwongǝi i tthǝla. <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />Langkwoi nungkwɔ yayuu mǝrrǝm lǝ ya ɓui gi Fuh kwɔ sualtthǝ dǝna to nung to i ilǝ; bakwɔ i to nung to i zuu gi Fuh lǝu, langkwoi la langǝ i i ɓuan i tolǝ nungtou. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />Yakwɔ dǝna to nung to i sual tthǝ yuu kwɔ kha Fuh u.<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />Kwoi bǝ ɓa ǝǝ manungkwɔ sualtthǝ ɓǝ gei ɓǝtthǝ thǝ; niyang, ɓa ǝǝ manungkwɔ Ɓyang geiɓǝ angǝ ɓa to bǝ nǝ, la langǝ i, Ɓyang gi Fuh ǝǝ dang tthǝɓǝ. Yuu kwɔ nǝ yangǝu i Ɓyang gi Kristi lǝu yang u ǝn abo lǝu. <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />Kwoi nǝ Kristi ǝǝ dang tthǝ ɓǝ, Ɓyang ǝn nwongǝi baɓǝ bakwɔ i mǝrrǝm ɓǝ matthǝ i Fuh ɓǝ, ko tthǝ ɓǝ wa ɓuilǝ ba nung a ɓko. <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />Nǝ Ɓyang gi Fuh, kwɔ ǝrr lǝ Yeso bǝ ɓui ɓua, ǝǝ tthǝ ɓǝ, yang Fuh kwɔ ǝrr lǝ Kristi bǝ ɓui ɓua kwɔ a dǝ nwongǝi lǝ tthǝ ɓǝ tthǝ ɓui ɓua i Ɓyang kwɔ tthǝ ɓǝ ɓǝ langɓǝ.<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />Nungkwɔ yang, ya ǝnthǝm, ɓitthǝ i nung to, kwoi ɓi ǝǝ manungkwɔ sualtthǝ ɓi yiɗi angǝ ɓito ɓǝlǝu. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />Bakwɔ nǝ ɓa ǝǝ dang kiggǝ thayuu, yang ɓa ɓumɓui; kwoi nǝ dang Ɓyang ɓa thǝb nung to sualtthǝ a ɓko, ɓa tǝi nwongǝi. <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />Yakwɔ Ɓyang Fuh oilǝ si ǝn yathang Fuh. <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />Bakwɔ Ɓyang kwɔ Fuh dǝ ɓǝkwɔ mǝrrǝm ɓǝ lǝ thǝbbu langkwoi wubǝ lǝ vulli tthǝu; manung kwɔni yang, Ɓyang ɓǝ a mǝrrǝm ɓǝlǝ yathang Fuh, langkwoi i ttha Ɓyang ɓi tasui tthǝ Fuh,&lt;&lt;Daa! Daam!&gt;&gt; <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />Ɓyang Fuh kǝb tthǝu lǝtha i ɓyang ɓi angǝ ɓi ǝn yathang Fuh. <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />Kwɔ nǝɓi ǝn yathang, yang ɓi muo bǝ khana lo kwɔ u dǝlǝ ba yayuu guɓǝ, langkwoi ɓi i Kristi ɓi muo nungkwɔ Fuh du tthasua ɓǝ; bakwɔ nǝ ɓi gab zui gi Kristi lǝtha, langkwoi ɓi gab ghaali gu lǝtha.<verse eid="ROM 8:17" /></para>
  <para style="s">Ghaali A Tthasi</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />Ən lǝi geigǝ zuii kwɔ dǝɓi to lona a nǝnǝng kwɔ i kǝbbǝi lǝtha i ghaali kwɔ ǝndǝi kwɔ wui taɓi natthǝ tthasi ɓǝu. <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />Nung mabbǝi gi Fuh ǝndǝi dǝna ki nungkwɔ Fuh wa tanatthǝ lǝ yathang gu ɓǝ. <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />Bakwɔ i ɓanglǝ nung mabbi yangbǝ nungkwɔ i mabbi lǝ bko kwɔ la, ǝn bǝ yiɗi gi lǝu, kwoi ǝn Fuh yiɗi manungɓǝ. Yirrǝ bǝ dǝnyitthǝ <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />angǝ nung mabbi i nailǝ vii a kun a i dang bǝ to thǝb tǝlǝ bǝ zuu langkwoi i gab ghaali yathang gi Fuh. <verse eid="ROM 8:21" /><verse number="22" style="v" sid="ROM 8:22" />Lakwɔ ɓi ibǝing wulǝ lona kwɔ nung mabbǝi dǝna groang i tthǝ zii, mangǝn bǝ ta nungzii yui. <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />Kwoi ǝn nung mabbi ɓuo dǝna groang lǝu; ɓi yakwɔ tthǝ i Ɓyang mangǝn nungdǝ gi Fuh a nwasiu langɓǝ dǝɓi groang dang tthǝ ɓi kwɔ dǝɓi ki Fuh mǝrrǝm ɓi lǝ yathang gu langkwoi ilǝ tthayuu nǝkwam. <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />Bakwɔ ǝn tthǝ bǝ dǝnyitthǝ nung kwɔ i nwong ɓi; kwoi nǝɓi ɓyǝa nung kwɔ ɓi dǝ nyitthǝ lǝ bko kwɔ, yang ǝn ba a langǝ i ǝn bǝ dǝnyitthǝ lǝu. Ən yiǝ dang ɓi a dǝnyitthǝ nung kwɔ ɓi ɓyǝa ɓa? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />Kwoi nǝ ɓi dǝnyitthǝ nung kwɔ ɓi ɓyǝa lǝu kwɔ, yang ɓi ǝǝ ɓi kiǝ i bǝ tthǝb nyitthǝ.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />Manung ɓǝni Ɓyang langɓǝ wuo bǝ nwong ɓi, ya tthǝ muani manung ɓi. Bakwɔ ɓi ibǝ nunglǝi kwɔ ɓi yam Fuh ɓǝlǝu ɓǝ; Ɓyang i nkolǝ dǝna yam Fuh lǝ ba ɓi i dang bǝ groangǝ i kwɔ ɓi ɓuan ɓi geiu ɓǝ. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />Langkwoi Fuh, kwɔ dǝna ɓyǝa dang nyi yayuu kwɔ, ibǝ bǝ nhǝm ba gi Ɓyang; bakwɔ Ɓyang dǝna yam Fuh lǝ ba yayuu gu langkwoi ibǝ yiɗi gu.<verse eid="ROM 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />Ɓi ibǝi dang nung ǝndǝi Fuh dǝna to nung to a langǝ i lǝ yakwɔ tthǝ dǝna yiɗiu ɓǝ, yakwɔ u lubǝi lǝ ba gu ɓǝ. <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />Yakwɔ Fuh osi mko langkwoi u ji gwukun yangbǝ i mǝrrǝm mangǝn yathang gu, yangbǝ yui ɓǝ mǝrrǝm a nwasiu dang yakwɔ dǝ ba a langǝ i ɓǝ. <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />Langkwoi nungkwɔ yakwɔ Fuh ji gwukun kwɔ, u lubǝi; langkwoi yakwɔ u lubǝi kwɔ, u ji matthǝ tthǝu lǝ, langkwoi u ji ghaali gutthǝ.<verse eid="ROM 8:30" /></para>
  <para style="s">Bǝ Yiɗi Bǝi Gi Fuh Dang Kristi Yeso</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />Dang ba kwɔ ǝndǝi, ǝn ɓǝttǝn ɓi gei? Nǝ Fuh i ɓi, ǝn yittǝn a laɓi? <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />Ba a langǝ i ǝn Fuh lǝu, kwɔ lamlo yuiu lǝu ɓǝ, kwoi u du lǝ ba yayuu ǝndǝi! U dǝɓi yuiu- yang u dǝɓi nung ǝndǝi nǝkwam wa? <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />Ən yiǝ a gei ba a ɓko lo yakwɔ Fuh mko ɓa? Ən Fuh i nko lǝ gei angǝ i ǝn ya nung a ɓko lǝu! <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />Ən yiǝ, lakwɔ, a ɓangǝ i lǝ? Ən Kristi Yeso lǝu, kwɔ ɓui, ko yang, kwɔ i ǝrrǝu lǝ i du nwongǝi langkwoi u ǝǝ lona a nali gi Fuh, dǝnnu yammu lǝ baɓi! <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />Ən yiǝ, yang, a ɓuan a gab ɓilǝ tha dang bǝ yiɗi bǝi gi Kristi? Bǝ toba a ɓuan a tun to, ko ǝn zuii ko bǝ dǝ zuii ko gwom ko yiɓko ko bǝ ɓko lua ko bǝ ɓuiɓua? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />Manungkwɔ nungvullǝ ba gi Fuh gei kwɔ angǝ,</para>
  <para style="q1" vid="ROM 8:36">&lt;&lt;Lǝ bamǝ ɓi dang bǝ ɓuiɓua lǝ lona ǝndǝi;</para>
  <para style="q2" vid="ROM 8:36">dǝnni toɓi mangǝ ɓi ǝn ɓangam kwɔ dǝnni tǝlǝ bǝ vuu dulu ɓǝ.&gt;&gt;<verse eid="ROM 8:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37" />Nilǝu, dang nungkwɔ ǝndǝi ɓi alo bǝ tǝi lo ɓing tthǝ yuu akwɔ dǝna yiɗi ɓiɓǝ! <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />Ən ibǝing la langǝ i lakwɔ nung akun yangǝu a gab ɓi lǝtha i bǝ yiɗi bǝi gi Fuh: ko ǝn ɓua ko ǝn nwongǝi, ko ǝn ya nwatumi gi Fuh ko ǝn ttha ya lo yigwoi wayi ko ttha, nǝnǝng kwɔ ko tthasi,<verse eid="ROM 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ROM 8:39" />ko ǝn longwam a wayi ko longwam a pisua- nung yangǝu dang nung maɓi i kwɔ a ɓuan a gab ɓilǝ tha i bǝ yiɗi bǝi gi Fuh kwɔ ǝn aɓi tthǝ Kristi Yeso kwɔ lǝ Dangbang ɓǝ.<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s">Fuh I Yayuu Gu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />Dǝm gei ba a langǝ i; Ɓang ǝn a bǝ Kristi langkwoi ǝn kǝb plǝu. Ɓyang a langǝ i dǝna loyigwoi lo nyim, langɓǝ dǝna geimtthǝ angǝ dǝm kǝbplǝ lǝu <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />Kwɔ nǝ ǝn geigǝ ɓangtthǝ i gong zuii i tthǝ zii kwɔ thǝmmu kwɔ dang nyim. <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />Ba yayuum, sual tthǝm i ziim! Lǝba gi mǝn yiɗi ɓang i nam dǝm yiɗi i gabǝm lǝtha i Kristi. <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />I ǝn yayuu Fuh; u mǝrrǝmǝi lǝ yathang gu langkwoi u yǝbǝi ghaali gu tthǝ; u dǝ ganglang gu i ilǝ u ji zuu; i tǝi bǝ wabbǝi a langǝ i; i muo bǝ gwab nwa gi Fuh; <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />i ǝn ya bǝpi ya Ibraniyawa a nungsi; langkwoi i Kristi, lǝ tha yuu, ya nwai. Kaso Fuh, kwɔ dǝna lo yigwoi lo yayuu ǝndǝi kwɔ, i khko laɗing! Dǝitthǝ manungɓǝ.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />Dǝm geigǝ bǝ gwab nwa gi Fuh ong lǝu; bakwɔ ya Israila ǝndǝi ǝn yayuu gi Fuh lǝu. <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />Langkwoi ya bie Ibrahim ǝndǝi ǝn yathang Fuh lǝu. Fuh gei Ibrahim angǝ, &lt;&lt;Tthǝn tthǝ Ishaku nungkwɔ ma tǝi bie kwɔ ǝn gwaba nwa ɓǝ.&gt;&gt; <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />Nungɓǝ lǝ yathang kwɔ i si nunglǝi azǝ kwɔ ǝn yathang Fuh lǝu; kwoi, yathang kwɔ i si lǝ bǝ gwab nwa gi Fuh kwɔ lǝ ya bie gi Ibrahim a langǝ i. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />Bakwɔ bǝ gwab nwa gi Fuh i to dang ba manungkwɔ ni: &lt;&lt;Lona a langǝ i Mǝn kwoi suam, langkwoi Saratu a si yui lǝ yiɓǝi.&gt;&gt; <verse eid="ROM 9:9" /><verse number="10" style="v" sid="ROM 9:10" />Akwɔ ɓuo lǝu, kwoi yathang gi Rifkatu kwɔ rab kwɔ daa gi kun, bǝba ɓi Ishaku. <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />Kwoi yangbǝ bǝ mko yui kun ǝǝlǝ nungkwɔ Fuh dǝna yiɗi ɓǝ, Fuh gei Rifkatu angǝ&lt;&lt;Yuu a yikku a dǝ angǝ a lǝ yuu a thang.&gt;&gt; <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />U gei nungkwɔ nwuni bǝ i si yathang ɓǝ, nwuni bǝ i to nung akun lǝ a langǝ i ko a ɓko; nungkwɔ bǝ mko bǝi gi Fuh tthǝn lo bǝ lubǝi gu, langkwoi lo nung a kun kwɔ i toɓǝ lǝu. <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />Manungkwɔ nungvullǝ ba Fuh gei ɓǝ: &lt;&lt;Dǝm yiɗi Yakubu, kwoi dǝm la Isuwa.&gt;&gt;<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />Ən ɓǝ yang lakwɔ ɓi gei? Fuh to nung a langǝ i lǝu? Ko atuab! <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />Bakwɔ u gei Musa angǝ, &lt;&lt;Mǝn ɓyǝa nung zuii yuu akwɔ dǝm yiɗi bǝ ɓyǝa nung zuii guɓǝ; langkwoi mǝn tǝm lo nyi lo yuu akwɔ ǝn tǝmmu lo nyi tthǝɓǝ. <verse eid="ROM 9:15" /><verse number="16" style="v" sid="ROM 9:16" />Nungkwɔ yang, nung ǝndǝi a dǝi lo, nungkwɔ thayuu dǝna yiɗi ko to ɓǝlǝu, kwoi ǝn bǝ ɓyǝa nungzuii Fuh ɓuo. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />Bakwɔ nungvullǝ ba Fuh gei Yigwoi Masar angǝ, &lt;&lt;Ən da yigwoi yangbǝ ǝn to nung to i mǝ ǝn tanatthǝ ttham langkwoi ǝn yǝb ɗuǝnnǝm longwam ǝndǝi.&gt;&gt; <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />Nungkwɔ yang, Fuh dǝna ɓyǝa nungzuii yuu akwɔ dǝu yiɗi bǝ ɓyǝa nungzuii guɓǝ, langkwoi u dǝ lo a nyimmi lǝ yuu akwɔ dǝu yiɗi bǝ ɗuɓǝ.<verse eid="ROM 9:18" /></para>
  <para style="s">Nyi Gi Fuh I Nungzuii Gu</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />Kwoi yuu akun dang ɓǝ a geim angǝ: &lt;&lt;Nǝ nungkwɔ ni yang, ǝn baɓǝ Fuh dǝna ɓyǝa nung aɓau yuu akun? Ənyi a la nungkwɔ Fuh dǝna yidɗi ɓǝ?&gt;&gt; <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />Kwoi mǝ ǝnya, ǝnthǝm, ma vullǝ ba nwa Fuh? Tthǝm suab ɓib yuu akwɔ maiu kwɔ angǝ, &lt;&lt;Ən baɓǝ bǝ a maim ni?&gt;&gt; <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />Ya mai tthǝm kwɔ tthǝ i ttha kwɔ a tonungto i suab manungkwɔ u yidɗi ɓǝ, langkwoi u mab tthǝm ni rab i suab lǝ, akun ba nungto a langǝ i akun ba nungto a nǝkwam. <verse eid="ROM 9:21" /><verse number="22" style="v" sid="ROM 9:22" />Langkwoi baɓǝ ǝn ba a langǝ i kwɔ Fuh toɓǝ. Dǝu yidɗi bǝ tanatthǝ nyi gu langkwoi yangbǝ i ibǝ ttha gu. Kwoi lo nyiu tǝmɗing lo yakwɔ dǝna ki nyi gu ɓǝ, yakwɔ dǝna ki babǝ ɓuiɓua ɓǝ. <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />Langkwoi dǝu yidɗi bǝ yǝb ghaali gu kwɔ kpaatthǝ kwɔ, kwɔ i al loɓi ya nungzuii gu, yakun ɓi kwɔ u mab yangbǝ muo ghaali gu ɓǝ. <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />Bakwɔ ɓi lǝ yayuu kwɔ u lubǝi ɓǝ, tthǝn dang ya Yahudawa ɓuo lǝu kwoi langɓǝ dang yakwɔ ǝn ya Yahudawa lǝu ɓǝ. <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />Manungkwɔ u gei dang nung vullǝ gi Yushko ɓǝ angǝ:</para>
  <para style="q1" vid="ROM 9:25">&lt;&lt;Yayuu kwɔ ǝn abǝm lǝu kwɔ</para>
  <para style="q2" vid="ROM 9:25">Mǝn lubǝi lǝ &lt;Yayuum.&gt;</para>
  <para style="q1" vid="ROM 9:25">Ya losua kwɔ ǝn yiɗi lǝu kwɔ</para>
  <para style="q2" vid="ROM 9:25">Mǝn lubǝi lǝ &lt;Yayuum kwɔ dǝm yiɗi ɓǝ.&gt;<verse eid="ROM 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ROM 9:26" />Langkwoi bǝikwɔ kwɔ i geitthǝ angǝ, &lt;Ɓǝ ǝn yayuum lǝu kwɔ,&gt;</para>
  <para style="q2" vid="ROM 9:26">bǝilǝ kwɔ i lubǝi angǝ yathang gi Fuh ya nwongǝi.&gt;&gt;<verse eid="ROM 9:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ROM 9:27" />Langkwoi Ishaya dǝna buogbǝi lǝ ba ya Israila angǝ: &lt;&lt;Ya Israila ko kpaa mangǝn suazuii nwam, yirrǝ ǝn yayuu tuab ɓuo a sob lo <verse eid="ROM 9:27" /><verse number="28" style="v" sid="ROM 9:28" />Bakwɔ Fuh ato nungkwɔ u ɓǝr bǝ tou lo ya longwam thǝmtthǝ u alo.&gt;&gt; <verse eid="ROM 9:28" /><verse number="29" style="v" sid="ROM 9:29" />Mangǝn sadoma manungkwɔ Ishaya gei lakuu ɓǝ:</para>
  <para style="q1" vid="ROM 9:29">Nǝ Dangbang ya angǝ a ǝndǝi</para>
  <para style="q2" vid="ROM 9:29">dǝɓi ya bie</para>
  <para style="q1" vid="ROM 9:29">ɓi mǝrrǝm mangǝn Gwamrata.&gt;&gt;<verse eid="ROM 9:29" /></para>
  <para style="s">Ya Israila I Nwaba A Langǝ i</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />Nungkwɔ yang ɓi gei ɓiǝngǝ yakwɔ ǝn ya Yahudawa lǝu kwɔ, yakwɔ yiɗi bǝ mab loi matthǝ i Fuh lǝu kwɔ, i ji matthǝ i Fuh dang bǝ dǝnyitthǝ; <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />yang yayuu gi Fuh, kwɔ dǝna ɗuu zuu gi Musa kwɔ a ji matthǝ i Fuh kwɔ, i tǝi lǝu. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />Langkwoi ǝn baɓǝ lǝu kaso? Bakwɔ dǝi lo bǝ dǝnyitthǝ lǝu kwoi lo nungkwɔ i toɓǝ. Langkwoi nungkwɔ i ɓuob boi tthǝ &lt;&lt;tal ɓuob bo bǝi&gt;&gt; <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />Manungkwɔ i vullǝ kwɔ:</para>
  <para style="q1" vid="ROM 9:33">&lt;&lt;Ɓyǝa, Ən li tal Sihiyona tal kwɔ a ɓuob bo yayuu ɓǝ</para>
  <para style="q2" vid="ROM 9:33">langkwoi ɓǝm tal kwɔ a to i ohw ɓǝ,</para>
  <para style="q1" vid="ROM 9:33">langkwoi yuu akwɔ dǝ ba a langǝ i tthǝu yang lǝ tthǝkku.&gt;&gt;<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />Ya ǝnthǝm, dǝm yiɗi nǝnǝ ni dang wam lǝ kaso yayuum sob lo! Dǝm pinwa nǝnǝ tthǝ Fuh lǝ bagi! <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />Dǝm gei ɓǝ ba a langǝ i tthǝ i muo ba Fuh la langǝ i yang: kwoi bǝ dǝ tthǝi tthǝ nung to ǝn babǝ ibǝ nung lǝu. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />I ibǝ nunglǝi a kwɔ Fuh dǝna mab yayuu matthǝ dǝna dǝ tthǝu ɓǝlǝu, langkwoi manungkwɔni, dǝi yiɗi bǝ mab nunglǝi abǝi; langkwoi nungkwɔ i dǝ tthǝi nunglǝi gi Fuh bǝ dǝ yayuu matthǝ lǝu. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />Bakwɔ Kristi wulǝ nung zuu bǝ sok nwuo yang, yangbǝ yuu akwɔ ǝndǝi nǝ dǝ ba a langǝ i tthǝ i du matthǝ nunglǝi a langǝ i gi Fuh.<verse eid="ROM 10:4" /></para>
  <para style="s">Bǝ Nwong lo Tthǝn Lo Yayuu Əndǝi</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />Musa vullǝ nungkwɔ lǝba bǝ to nung a langǝ i tthasi Fuh ibǝ to nung to i nung zuu: &lt;&lt;Yuu akwɔ ǝndǝi to nung to i nungkwɔ zuu gei yang a tǝi nwongǝi.&gt;&gt; <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />Kwoi nungkwɔ nungvullǝ gei lǝ babǝ ǝǝ matthǝ i Fuh i bǝ dǝnyitthǝ kwɔ nungɓǝ lǝ &lt;&lt;Ba ɓib lomǝ mangǝ, Ən yittǝn a tǝ wayi?&gt;&gt; (Nungɓǝ lǝ, bǝ wulǝ Kristi lǝ sua.) <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />&lt;&lt;Kwoi bǝ a ɓib mangǝ, Ən yittǝn a tǝ dang longwam pisua?&gt;&gt;(Nungɓǝlǝ, bǝ ǝrrlǝ Kristi dang bǝ ɓuiɓua). <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />Nungkwɔ nungvullǝ ɓǝ dǝna gei kwɔ nungɓǝlǝ: &lt;&lt;Ba Fuh gbaga, nwa mǝlǝ langkwoi lonyimǝ&gt;&gt;-nungɓǝ lǝ, ba a langǝ i ba dǝnyitthǝ kwɔ dǝ ɓi gei ɓǝ. <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />Nǝ a gei i nwamǝ mangǝ Yeso ǝn Dangbang langkwoi a dǝ ba langǝ itthǝu mangǝ Fuh ǝrrǝu lǝ dang bǝ ɓui ɓua, ma tǝi nwongǝi. <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />Bakwɔ ǝn ba bǝ dǝnyitthǝ kwɔ i dǝ ɓi matthǝ i Fuh; ǝn ba bǝ gei nung a ɓko ɓi i nwaɓi nungkwɔ ɓi tǝi nwongǝi. <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />Nungvullǝ ba Fuh gei angǝ,&lt;&lt;Yuu akwɔ ǝndǝi dǝ ba a langǝ i tthǝu lǝ yang u ɓyǝa nung to tthǝku.&gt;&gt; <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />Nungkwɔ gǝm yayuu ǝndǝi, bakwɔ bǝ gab ganglang dang ya Yahudawa i yakwɔ ǝn ya Yahudawa lǝu ɓǝ; Fuh kun Dangbang a bǝ yayuu ǝndǝi langkwoi dǝu khana lo yayuu ghaatthǝ ǝndǝi kwɔ lubǝiu ɓǝ. <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />Manungkwɔ nungvullǝ bagu gei ɓǝ angǝ,&lt;&lt;Yuu akwɔ ǝndǝi lu ɗuǝn Dangbang lǝ ba bǝ nwongbǝi yang i nwongǝu.&gt;&gt;<verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />Kwoi i tonǝnǝ i lubǝi lolǝ ba nwongbǝi nǝ i dǝba a langǝ i tthǝu lǝu ɓa? Langkwoi i to nǝnǝ i dǝba a langǝ i tthǝ nǝ i lǝ ba a langǝ i lǝu ɓa? Langkwoi i lǝ baɓǝ nǝnǝ nǝ i gei ɓǝtthǝ lǝu ɓa? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />Langkwoi i to nǝnǝ nǝ i gei baɓǝ tthǝ nǝ i tum ya nwatummi suai lǝu ɓa? Manungkwɔ nungvullǝ geiɓǝ angǝ,&lt;&lt;Ma nǝnǝ ni lǝba ya nwatummi kwɔ wulǝ ba a langǝ i ɓǝ!&gt;&gt; <verse eid="ROM 10:15" /><verse number="16" style="v" sid="ROM 10:16" />Kwoi ǝn yayuu ǝndǝi gwab nwaba a langǝ i ɓǝlǝu. Ishaya i nkolǝ gei angǝ,&lt;&lt;Dangbang, ǝnyi dǝba a langǝ i tthǝ ba a langǝ i ɓi?&gt;&gt; <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />Nungkwɔ yang, bǝ dǝnyitthǝ dǝna wɔ tthǝn bǝ lǝba a langǝ i, langkwoi ba a langǝ i dǝna wɔ tthǝn tthǝ bǝ gei ba Kristi.<verse eid="ROM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 10:18" />Kwoi ǝn ɓyib ba ǝn geigǝ: Ən ba a langǝ i ilǝ nwaba a langǝ i ɓǝlǝu? La langǝ i i lǝng- manungkwɔ nungvullǝ gei ɓǝ angǝ:</para>
  <para style="q1" vid="ROM 10:18">&lt;&lt;Yolli lǝi longwam ǝndǝi;</para>
  <para style="q2" vid="ROM 10:18">bagi kǝn longwam ǝndǝi.&gt;&gt;<verse eid="ROM 10:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />Langkwoi ǝn ɓib geigǝ: Ya Israila ibǝilǝu? Musa i nkolǝ owhsi gwabnwa angǝ:</para>
  <para style="q1" vid="ROM 10:19">&lt;&lt;Mǝn tonungto i yakwɔ ǝn losua lǝu kwɔ</para>
  <para style="q2" vid="ROM 10:19">i to yayuum ato dasi;</para>
  <para style="q1" vid="ROM 10:19">langkwoi i ya losua ya sullǝ</para>
  <para style="q2" vid="ROM 10:19">Mǝn to yayuum a nyinyi.&gt;&gt;<verse eid="ROM 10:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />Ishaya langkwoi to nyi nyimmi ɗing kwɔ u gei angǝ,</para>
  <para style="q1" vid="ROM 10:20">&lt;&lt;Yayuu kwɔ tǝim kwɔ ǝnya kwɔ dǝna ɗubǝim ɓǝlǝu;</para>
  <para style="q2" vid="ROM 10:20">Ən fugtthǝ yakwɔ dǝna ɓib pim ɓǝlǝu.&gt;&gt;<verse eid="ROM 10:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21" />Kwoi lǝba ya Israila u gei angǝ,&lt;&lt;Dang fuh ǝndǝi ǝn dǝ nam yangbǝ ǝn kǝb lǝ lo ya kiggǝ aɓau ya yurrǝ.&gt;&gt;<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s">Fuh Ɓyǝa Nungzui Ya Israila</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />Ən ɓib, geigǝ: Fuh la yayuu gu ǝn a? U lai lǝu ɓang ǝn ya Israila, Bǝba gi Ibrahim, yayuu gi ya nwa gi Biliyaminu. <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />Fuh la yayuu gu lǝu, kwɔ u mkoi la nungsi ɓǝ. Ɓa ibǝi nungkwɔ nungvullǝ gei kwɔ Iliya yam Fuh lǝ ba ya Israila angǝ: <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />&lt;&lt;Dangbang, i thǝb ya gei ba a tthasi mǝ langkwoi i dǝr bǝ nyǝknung mǝ: Ɓang ɓuo kun ǝn i, langkwoi dǝi ɗulǝi bǝ thǝb bǝm.&gt;&gt; <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />Ən ɓǝttǝn Fuh geiu lǝ? &lt;&lt;Ɓang tthǝ i yayuu thǝm sob ɓua thǝmkun pǝmna sob kwɔ i wab fuh pǝllǝ Baal lǝu ɓǝ.&gt;&gt; <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />U nunglǝi ɓǝkwɔ kun lakwɔ: sua yayuu thǝ tuab kwɔ Fuh mko lǝ ba bǝ ɓyǝa nungzuii gi ɓǝ. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />Bǝ mko yayuu gu tthǝn tthǝ bǝ tonung a langǝ i gu, ǝn ba nungto gi lǝu. Nǝ bǝ mko yayuu gi Fuh tthǝn tthǝ nungto gi yang bǝ tonung a langǝ i gu ǝn a langǝ i lǝu.<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />Ən ɓǝttǝn yang? Ya Israila tǝi nungkwɔ dǝi ɗubǝi ɓǝlǝu. Yayuu kwɔ Fuh mko tuab ɓǝ tǝi: suai kwɔ ǝndǝi ɓuasui lam i lǝbǝ lubǝi gi Fuh u. <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />Manungkwɔ nungvullǝ gei angǝ,&lt;&lt;Fuh lam dang nyii i dang wa ɓyangi: wulǝ vii a ɗiggǝ i ɓyǝa bǝiu i ɓuan i lǝ bǝiu,&gt;&gt; <verse eid="ROM 11:8" /><verse number="9" style="v" sid="ROM 11:9" />Langkwoi Dawuda gei angǝ,</para>
  <para style="q1" vid="ROM 11:9">&lt;&lt;Kaso tarko gi mui bǝ to ɓang gi;</para>
  <para style="q2" vid="ROM 11:9">kaso i o, kaso i ɗab luai!<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />Kaso nungǝi ɓuom yangbǝ i ɓyǝa bǝithǝ;</para>
  <para style="q2" vid="ROM 11:10">langkwoi toi bǝ i tǝmsua tthǝ zui gi vii ǝndǝi.&gt;&gt;<verse eid="ROM 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />Ən ɓib, yang: Kwɔ ya Yahudawa ɓuob boi tthǝ nung, i o i ɓuan i ǝrr lǝu? Nilǝu ko tuab! Bakwɔ i to nung a ɓkong, bǝ nwong lo wuo sua ya kwɔ ǝn ya Yahudawa lǝu ɓǝ, yangbǝ ya Yahudawa tthǝngǝi. <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />Nung a ɓko ya Yahudawa wulǝ nung a langǝ i kpaatthǝ lǝ longwam, i nungtǝi kwɔ i tǝsua yakwɔ lǝ ya Yahudawa lǝu ɓǝ, ɓǝ khana lo ɓǝ nǝnǝ nǝ kpaali ya Yahudawa kwɔ dang ǝu ǝndǝi!<verse eid="ROM 11:12" /></para>
  <para style="s">Bǝ Nwongbei Yakwɔ ǝnya Yahudawa Lǝuɓǝ</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />Dǝm gei ɓǝ batthǝ lakwɔ ɓǝ yakwɔ ǝn ya Yahudawa lǝu ɓǝ: Nǝ ɓang ǝn ya nwatummi gi Fuh sua yakwɔ ǝn ya Yahudawa lǝu kwɔ, mǝn lǝi lom lǝ ba nungtom. <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />Lko mǝn ɓuan mǝn mab yayuum ya nwam to dasi, langkwoi yangbǝ ǝn ɓuan ǝn nwongǝi. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />Bakwɔ nǝ i lai, sua ya longwam ǝndǝi i mǝrrǝmmǝi lǝya ɓui gi Fuh lǝya ǝnthǝu. Ən ɓǝttǝn, yang, kwɔ nǝ i mui ɓǝ? Ən nwongǝi lǝ ba ya ɓui ɓua!<verse eid="ROM 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 11:16" />Nǝ kwǝnwa burodi a nwasiu i dǝllǝ Fuh, yang suo ɓǝ ǝndǝi ǝn abo langɓǝ: langkwoi nǝ i dǝ yǝng kab i dǝlǝ Fuh, sua sina kab ɓǝ ǝn abo langɓǝ. <verse eid="ROM 11:16" /><verse number="17" style="v" sid="ROM 11:17" />Nǝ yakun dang sina kab zug Zaitun kwɔ nǝ ab al lǝtǝ, langkwoi i kǝm sinna kab dang gug i ulǝ. Ɓǝ yakwɔ ǝn ya Yahudawa lǝu kwɔ ɓǝ mangǝn kab zaitun dang gug kwɔ, langkwoi lakwɔ dǝ ɓa gab nwongǝi ɓyang ya Yahudawa. <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />Nungkwɔ yang, bǝɓa la yakwɔ i abǝi i al lǝtǝ mangǝn sina kab thǝ. Ɓa to nǝnǝ ɓa lǝi loɓǝ? Ɓǝ ǝn sina kab ɓuo; ɓa dǝ tthǝ nyimmi lǝ yǝng kabbu- ǝn yǝng kab dǝna dǝɓǝ tthǝ nyimmi. <verse eid="ROM 11:18" /><verse number="19" style="v" sid="ROM 11:19" />Kwoi ɓa gei ɓangǝ,&lt;&lt;Ni, kwoi i ɓǝr sina kab yangbǝ i mabbǝm bǝitthǝ.&gt;&gt; <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />Ən ba a langǝ i. I ɓǝrri bakwɔ i dǝ ba a langǝ i tthǝ Fuh lǝu ɓǝ, kwɔ yirrǝ ɓǝ dang ǝu kwɔ ǝn bakwɔ ɓa dǝba a langǝ i tthǝ ɓǝ. Kwoi bǝɓa lǝilo ɓǝtthǝ thǝ; manungkwɔ niyang, ɓa survulli.<verse eid="ROM 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 11:21" />Fuh kang ya Yahudawa pa nǝkwam lǝu, yakwɔ mangǝ sina kab a langǝ i ɓǝ, dǝɓa nhǝm ɓangǝ u kang ɓǝ ǝn kang a?<verse eid="ROM 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 11:22" />Bǝikwɔ ɓi ɓyǝa nyitǝmmi gi Fuh i bǝ ɗablua bǝi gu. Dǝu ɗablua yakwɔ dǝna owh ɓǝ, kwoi dǝu toɓǝ nyi tǝmmi-nǝ ɓa lilotthǝ dang nyitǝmmi guɓǝ. Kwoi nǝ ɓato nilǝu, ɓǝ langɓǝ i ab ɓǝ i al lǝtǝ. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />Langkwoi nǝ ya Yahudawa tamual tthǝ bǝ labǝ dǝnyitthǝ, Fuh a kwoi lǝ a wulǝ tthǝu; bakwɔ Fuh a ɓuan ato niɓǝ. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />Ɓǝ ya Yahudawa ɓǝ mangǝn si na kab zaitun dang gug kwɔ i ab i al lǝtǝ langkwoi, natha i a nungsi lǝu, i kǝb lǝtha i kab akwɔ i lǝb pangǝu ɓǝ. Ya Yahudawa manung kab a kwɔ i lǝb pangǝu ɓǝ; langkwoi ziu ko tuab tthǝ Fuh kwɔ tthǝb sina kab kwɔ tthǝ kablǝ langkwoi.<verse eid="ROM 11:24" /></para>
  <para style="s">Bǝ Ɓyǝa Nungzuii Gi Fuh Lo Yayuu Əndǝi</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />Ba a langǝ i pyǝalǝ pyǝa, ya ǝnthǝm, kwɔ dǝm yiɗi ɓa ibǝi ɓǝ, bakwɔ a nan ɓǝ tthǝ bǝ nhem ba yiggǝi ɓǝ. Angǝ bǝ nyim lo ya Israilawa a ɗing lǝu, kwoi nǝ yakwɔ ǝn ya Yahudawa lǝu kwɔ ǝndǝi nǝ wuo sua Fuh ɗǝ. <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />Langkwoi ya Israila a tǝi bǝ sob lo manungkwɔ ni. Manungkwɔ nungvullǝ bagi Fuh gei ɓǝ.</para>
  <para style="q1" vid="ROM 11:26">&lt;&lt;Ya nwong lo a ǝrr Sihiyona</para>
  <para style="q2" vid="ROM 11:26">langkwoi u ilǝ kiggǝ a ɓko dang ya bie Yakubu.<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />Mǝn gwab bǝi nwa nungkwɔ</para>
  <para style="q2" vid="ROM 11:27">kwɔ nǝ ǝn lǝi nung a ɓko gi ɓǝ.&gt;&gt;<verse eid="ROM 11:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="ROM 11:28" />Bakwɔ i la ba a langǝ i ɓǝ, ya Yahudawa ǝn ya ɓui gi Fuh lǝ baɓǝ yakwɔ ǝn ya Yahudawa lǝu ɓǝ. Kwoi lǝ ba bǝ mko bǝi Fuh, i ǝn ya ǝnthǝu ba ya bǝba gi. <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />Bakwɔ Fuh mǝrrǝm dang nyiu lo yuu akwɔ u mko langkwoi u khana lou ɓǝu. <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />Lǝ ba aɓǝ yakwɔ ǝn ya Yahudawa lǝu kwɔ, ɓa labǝ to nung to i bagi Fuh lakuu: kwoi lakwɔ ɓa tǝi bǝ ɓyǝa nungzuii gi Fuh lǝ bakwɔ ya Yahudawa to kiggǝ aɓau ɓǝ. <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />Manung ɓǝnni, lǝ ba nungzuii gi Fuh kwɔ ɓa tǝi kwɔ, ya Yahudawa lakwɔ labǝ tonungto i bagi Fuh, yangbǝ i langɓǝ lakwɔ i tǝi bǝ ɓyǝa nungzuii gi Fuh. <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />Bakwɔ Fuh mab yayuu ǝndǝi lǝya pursǝna bǝ labǝ tonungto i bagu, yangbǝ u ɓyǝa nungzuii gi ǝndǝi.<verse eid="ROM 11:32" /></para>
  <para style="s">Kha Fuh</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />Nungtǝi gi Fuh ghaa nǝnǝ! Yiggǝi gu ibǝ ibǝi nung gu tu nǝnǝ! Ənyi a ɓuan a gei bǝ to kwan gu? Ənyi a ibǝi nungkwɔ Fuh dǝna yiɗi bǝ tou ɓa? <verse eid="ROM 11:33" /><verse number="34" style="v" sid="ROM 11:34" />Manungkwɔ nungvullǝ ba Fuh gei ɓǝ angǝ,</para>
  <para style="q1" vid="ROM 11:34">&lt;&lt;ǝnyi ibǝ dang wa Fuh?</para>
  <para style="q2" vid="ROM 11:34">Ənyi a ɓuan a geiu nungkwɔ u to ɓǝ?<verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />Ən yittǝn du nung bokun</para>
  <para style="q2" vid="ROM 11:35">yangbǝ u kwoilǝ wu kwai?<verse eid="ROM 11:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ROM 11:36" />Bakwɔ nung ǝndǝi ǝn u mab, langkwoi nung ǝndǝi wuo tthǝn tthǝu langkwoi abo. Bǝ kha bǝi ǝn a Fuh laɗing! Dǝitthǝ manungɓǝ.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s">Nwongǝi Afu Dang Kristi</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />Nungkwɔ yang, ya ǝnthǝm, lǝ ba bǝ ɓyǝa nungzuii gi Fuh ghaatthǝ tthǝɓi lǝ: Ɓa dǝ tthǝɓǝ lǝ Fuh nung nyǝknung a nwongǝi, matthǝ langkwoi latthǝ lǝ babǝ to nung to gu. Nungkwɔ lǝ wab Fuh a langǝ i kwɔ ɓa toɓǝ. <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />Bǝ ɓa dǝ tthǝ ɓǝ tthǝ nunglǝi ya longwam kwɔ thǝ, kwoi ɓa yitthǝ Fuh mǝrrǝm ɓǝ ttha dang i bǝ mǝrrǝm dang wa ɓǝ ǝndǝi. Yang ɓa ibǝ nungkwɔ Fuh dǝna yiɗi ɓǝ- nungkwɔ matthǝ langkwoi latthǝ tthǝu langkwoi lozuiiu ɓǝ.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />Langkwoi ba nung a langǝ i nungdǝ gi Fuh kwɔ dǝm kwɔ Ən gei ɓǝ tthǝ ɓǝ ǝndǝi: Bǝ ɓa nhǝm ba loɓǝ ghaa pǝl tthaa thǝ. Niyang, ɓa nhǝm tuabtuab, langkwoi ɓa to kwan lǝ loɓǝ tthǝ natha i bǝ dǝnyitthǝ kwɔ Fuh dǝɓǝ ɓǝ. <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />Zuggǝ ɓi kpaaɗing dang tthǝ kun. Langkwoi i zuggǝ kwɔ ǝndǝi nungto gi nǝ kunkun.<verse eid="ROM 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 12:5" />Manungkwɔ ni ǝndǝi, ko kwɔ ɓi kpaatthǝ, ɓi dang tthǝ kun dang bǝ kǝptha i Kristi, langkwoi kǝb ɓi lǝtha ǝndǝi mangǝn zuggǝ tthǝ kun. <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />Yang ɓi tonungto i nung dǝnung a langǝ i kwɔ Fuh dǝɓi ɓǝ. Nǝ nungdǝ ɓi ǝn bǝ gei ba Fuh, yang ɓi to manung bǝ dǝnyitthǝ kwɔ ɓi tthǝ ɓi ɓǝ; <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />Nǝ ǝn babǝ to nung to, yang ɓi to, nǝ ǝn bǝ nanatthǝnung yang ɓi nanatthǝ, <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />Nǝ ǝn ba bǝ dǝ tthǝnyimmi lǝ tha, yang ɓi to manungɓǝ. Yuu kwɔ nǝ gab nunglǝ tha i yakun yang u to manungɓǝ la langǝ i: yuu akwɔ nǝ ya tanatthǝ nunglǝi lǝ yayuu yang u to matthǝ.<verse eid="ROM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />Ɓa yiɗi bǝi dang wa kun. Ɓa la nungkwɔ lǝ nung to gi mungkullum ɓǝ, ɓa munatthǝ nungkwɔ ǝn a langǝ i ɓǝ. <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />Ɓa Yiɗi tha matthǝ mangǝn ya Krista, langkwoi ɓa dǝ ghaali lǝ tha. <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />Ɓa to nung to la langǝ i bǝ ɓa to ɓko thǝ. Ɓa to nung to gi Fuh la langǝ i i dang wa ɓǝ ǝndǝi. <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />Bǝ dǝnyitthǝ ɓǝ dǝɓǝ tthǝla, ɓa tthǝb nyitthǝ zuii ɓǝ, langkwoi ɓa pinwa vii ǝndǝi. <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />Ɓa gab nungtǝi ɓǝlǝ tha i ya young ɓǝ ya Krista kwɔ nung yangǝu nai ɓǝ, langkwoi ɓa ɓko nwalǝ gwoi ɓǝ lǝ yayol tthǝ.<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />Ɓa ɗyǝab Fuh khanalo yakwɔ dǝna dǝɓǝ zuii ɓǝ-ni, ɓa yammu u khana loi, bǝ ɓanglǝ bǝi lǝu.<verse eid="ROM 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 12:15" />Ɓa lǝ tthǝla i yakwɔ dǝna lǝ tthǝ laɓǝ, ɓa tasui i yakwɔ dǝna tasui ɓǝ.<verse eid="ROM 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 12:16" />Ɓa ǝǝ latthǝ i yayuu ǝndǝi. Bǝɓa lǝi loɓǝ thǝ, kwoi bǝɓa zun nungto thǝ. Bǝ ɓa lǝi loɓǝ mangǝ ǝnya yiggǝi thǝ.<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />Nǝ yuu akun toa i nung aɓau, bǝ a voh i nung aɓau thǝ. Ɓa to nungkwɔ yayuu ǝndǝi dǝna ɓyǝa angǝ maɗing ɓǝ. <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />Ɓato nungkwɔ ǝndǝi ɓa to yangbǝ ɓa ǝǝ latthǝ i yayuu ǝndǝi. <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />Ɓa voh nungthǝ, ya ǝnthǝm, manungkwɔ ni yang ɓa yitthǝ nyi Fuh to ɓǝtthǝ. Bakwɔ nungvullǝ gei angǝ, &lt;&lt;Bǝ voh nung ǝn abǝm, mǝn voh ɓǝtthǝ Dangbang gei manung ɓǝ ni.&gt;&gt; <verse eid="ROM 12:19" /><verse number="20" style="v" sid="ROM 12:20" />Niyang, manungkwɔ nungvullǝ gei angǝ:&lt;&lt;Nǝ gwom tǝi ya ɓui ɓǝ yang, ɓa ji nungtang; nǝ ɗimung tǝi, ɓa ji mungki nwa; nǝ ɓa toni yang ɓa ji nung to tthǝku<verse eid="ROM 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 12:21" />Bǝɓa gwab nung a ɓko pǝl ttha ɓǝ thǝ: niyang, ɓa pǝl ttha nung a ɓko i nung a langǝ i.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s">Bǝ Tonungto I Ba Ya Dǝkab Nwanung</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />Yayuu ǝndǝi a to nung to i ya dǝ kab nwanung, bakwɔ ya dǝ kab nwanung yangǝu kwɔ Fuh dǝlǝu ɓǝ, langkwoi ya dǝ kab nwanung yangǝu kwɔ ǝn Fuh ji bǝilǝ ɓǝlǝu.<verse eid="ROM 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 13:2" />Yuu akwɔ nǝ labǝ to nung to i ba ya dǝ kab nwanung yang dǝna la ǝn nungkwɔ Fuh gei angǝ i toɓǝ; langkwoi yuu akwɔ toni yang dǝna wulǝ kwan lǝlo tthǝ.<verse eid="ROM 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 13:3" />Bakwɔ ya to nung to a langǝ i surr ya dǝ kab nwanungǝu, kwoi ǝn ya to nung to mullub. A yiɗi bǝ sur yakwɔ dǝna dǝ kab nwa nung ɓa? Yang ato nungkwɔ ǝn a langǝ i ɓǝ, yang i khaa. <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />Bakwɔ i ǝn thǝb gi Fuh yangbǝ i toa nung to a langǝ i tthǝ. Kwoi nǝ ato nung to mullub, yang a surri, bakwɔ ttha bǝ ɗab lua bǝi tthǝ la langǝ i. I ǝn thǝb gi Fuh langkwoi dǝi to nung to ibǝ ɗab lua bǝi gi Fuh lo ya kwɔ dǝna to mullub ɓǝ. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />Lǝba ɓǝkwɔ yang ato nungto i ya dǝkab nwa nung- ǝn bakwɔ bǝ ɗablua bǝi gi ɓǝlǝu, kwoi langɓǝ nungkwɔ lonyimǝ dǝna geitthǝ ɓǝ.<verse eid="ROM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6" />Nungkwɔ langɓǝ lǝ bakwɔ ma kwai nungǝmmi ɓǝ, bakwɔ ya dǝ kab nwanung dǝna to nung to lǝ Fuh tthǝ kwɔ nǝ i to nung to gi ɓǝ. <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />Kwai, than gi lomǝ: kwai nungǝmmi lomǝ langkwoi i nung gǝmmi nung namǝ, yang ji ghaali i angǝ a i ǝndǝi.<verse eid="ROM 13:7" /></para>
  <para style="s">Ɓa Yiɗi Tha</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />Bǝ a gwab than yuu akun dǝilo mǝ thǝ- nung kun kwɔ a dǝilo mǝ kwɔ nungɓǝ lǝ bǝ yiɗi tha. Yuu akwɔ nǝ dǝna toni yang dǝu to nung to i zuu gi Musa. <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />Zuu kwɔ gei angǝ,&lt;&lt;Ba lo i si yuu akun thǝ: bǝ a thǝb yuu thǝ: bǝ a i nung thǝ: bǝ a yiɗi nungkwɔ ǝn a bǝ yuu akun thǝ&gt;&gt; nungkwɔ ǝndǝi, langkwoi i yakun gwukun, i gǝmmǝi dang zuu kun kwɔ angǝ, &lt;&lt;A yiɗi ya nwakong mǝ manungkwɔ dǝma yiɗi lomǝ ɓǝ,&gt;&gt; <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />Nǝ dǝma yiɗi yakun, yang a toi i nung a ɓko; bǝ yiɗi bǝi, yang, ǝn bǝ to nung to i zuu gi Musa ǝndǝi.<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />Langkwoi ato nungkwɔ, bakwɔ a ibǝi lona wung kwɔ ma ǝrr nung nunglo ɓǝ. Bakwɔ lona kwɔ i nwong ɓi kwɔ gɓagǝng lakwɔ lo akwɔ la nwasiu ɓi dǝba a langǝ i tthǝ ɓǝ. <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />Nungvii gbag bǝ thǝmmu yang, bǝi gbag bǝ kannung. Ɓi yitthǝ bǝ tonung kwɔ ǝn a dang bǝthǝl ɓǝ, langkwoi ɓi ee nung taɓui babǝ ɓuob vǝm bǝi a kaikai mangǝn dang fuh. <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />Ɓi to kiggǝ ɓi matthǝ, manung yakwɔ ǝǝ dang fuh ɓǝ-dang bǝ yiɗi nung i bǝ nwamin lǝu, bǝ to nung a ɓko lo i yisi yangǝu nung a ɓko, bǝ ɓuob vǝm ko tthǝng bǝi.<verse eid="ROM 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 13:14" />Kwoi ɓa ǝǝ nung taɓui gi Dangbang Yeso Kristi, yang ɓa yitthǝ bǝ dǝ kiggǝ ɓǝ tthǝ nung aɓau kwɔ sual tthǝɓǝ dǝna yidɗi i bǝ du nungkwɔ dǝu yidɗi ɓǝthǝ.<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s">Bǝ A Tokwan Lǝ Yakun Thǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />Ɓa muo yakwɔ bǝ dǝnyitthǝ gi muani ɓǝ. Kwoi bǝ ɓa nyimtha nwa i ilǝ ba bǝ nhǝm ba gi thǝ. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />Bǝ dǝ nyitthǝ a bǝ yakun gwabǝi tthǝ i tang nungkwɔ ǝndǝi, kwoi yuu a kwɔ muani dang bǝ dǝnyitthǝ dǝna tang wog ɓuo.<verse eid="ROM 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 14:3" />Yuu akwɔ a tang nungkwɔ ǝndǝi kwɔ bǝ tthǝm yuu akwɔ tangǝu ɓǝthǝ: langɓǝ yuu akwɔ dǝna tang ǝn wog ɓuo kwɔ bǝ to kwan lo yuu akwɔ a tang nungkwɔ ǝndǝi ɓǝthǝ: bakwɔ Fuh gwab yuu ɓǝ kullong. <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />Mǝ ǝn yittǝn kwɔ ma to kwan lo thǝb yuu akun ɓa? Ən togwoi gi a gwab u ilo ko u owh. Langkwoi i ilo, bakwɔ Dangbang a ɓuan gwabǝi tthǝ i ilo.<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />Yakun dǝna nhǝm angǝ vii akun pǝl sua vii kwɔ. Langkwoi yakun dǝna nhǝm angǝ vii kwɔ ǝndǝi natha. Ko ǝn ya ǝǝ dang nungkwɔ dang wko geiu tthǝ ɓǝ. <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />Yakwɔ dǝna nhǝm ba ghaatthǝ lǝ ba vii akun kwɔ i toni i bǝ dǝ ghaali lǝ Dangbang; yakwɔ dǝna tang nungkwɔ ǝndǝi kwɔ i toni i bǝ dǝ ghaali lǝ Dangbang, bakwɔ dǝi to sakko lǝ Fuh lo nungtang lǝ. Yakwɔ la bǝ tang nung akun toni i bǝ dǝ ghaali lǝ Dangbang, langkwoi dǝi to sakko lǝ Fuh. <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />Ɓi ǝǝ longwam kwɔ lǝ ǝnba loɓi ɓuo lǝu, langkwoi ɓi ɓui lǝba lo ɓiu. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />Nǝ ɓi ǝǝ longwam kwɔ, ǝn ba Dangbang nungkwɔ ɓi ǝǝ, langkwoi nǝ ɓi ɓui, ǝn ba Dangbang ɓi ɓui. Nungkwɔ ko ɓi ǝǝ ko ɓi ɓui, ɓi ǝn a bǝ Dangbang. <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />Bakwɔ Kristi ɓui langkwoi ǝrr i nwongǝi gu yangbǝ u ǝlǝ Dangbang yakwɔ i nwongǝi ɓǝ langkwoi yakwɔ ɓuiɓua. <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" />Mǝ yang, kwɔ dǝma tang wog ɓuo kwɔ-ǝnba ɓǝ bǝ dǝma to kwan lo yakun? Langkwoi mǝ kwɔ dǝma tang nungkwɔ ǝndǝi kwɔ- baɓǝ bǝ dǝma tthǝm sua ya dǝ ba a langǝ i tthǝ Fuh? Ɓi ǝndǝi ɓi dǝi tthasi Fuh u toɓi kwan tthǝ.<verse eid="ROM 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 14:11" />Bakwɔ nungvullǝ ba Fuh gei angǝ,</para>
  <para style="q1" vid="ROM 14:11">&lt;&lt;Manung a langǝ i kwɔ ɓang lǝ Fuh ya nwongǝi kwɔ, Dangbang gei ni,</para>
  <para style="q2" vid="ROM 14:11">yayuu ǝndǝi a bainwa longǝi sua tthasim,</para>
  <para style="q2" vid="ROM 14:11">langkwoi yayuu ǝndǝi a gei i nwai lǝ angǝ ɓang ǝn Fuh.&gt;&gt;<verse eid="ROM 14:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />Ɓi kwɔ ǝndǝi, yang, ɓi gei i nwa ɓi lonung kwɔ ɓi to lǝ Fuh.<verse eid="ROM 14:12" /></para>
  <para style="s">Bǝ Ato Yakun Owh Thǝ</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />Nungkwɔ yang, ɓi yitthǝ bǝ to kwan lǝ tha, Manung kwɔ niyang, a mǝrrǝm lo nyi mǝ bǝ a to nungkwɔ a lag bo yakun a o ko dang nung a ɓko thǝ. <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />Bǝ ǝǝm dang tha i Dangbang Kristi ǝn gwabbǝng geigǝ nungtang akun yangǝu kwɔ i nkolǝ kwɔ mko tthasi Fuh ɓǝ; kwoi nǝɓa dǝ ba a langǝ i tthǝ ɓangǝ i nungtang akun tthǝ mko, yang mko tthǝn tthǝ ɓǝ. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />Nǝ dǝɓa dǝ ba zii bǝi lǝ yakun ba nungkwɔ dǝɓa tangkwɔ, yang lakwɔ a to nung to dang bǝ yiɗi bǝi lǝu. Bǝ a yitthǝ nungtang kwɔ dǝma tang kwɔ ɓanglǝ yuu akwɔ Fuh ɓui lǝ bagu ɓǝthǝ! <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />Bǝ a yitthǝ nungkwɔ dǝma lǝi lǝ nung a langǝ i kwɔ tǝi ɗuǝn a ɓko thǝ. <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />Bakwɔ bǝ lo yigwoi gi Fuh ǝn ba bǝ tang nungtang i bǝ nwamung lǝu, kwoi ǝn ba ya to nung a langǝ i, i ya ǝǝ i tǝmmi, i tthǝlla, kwɔ Ɓyang a Langǝ i dǝna dǝɓǝ. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />Langkwoi kwɔ nǝɓa to nung to lǝ Kristi tthǝ nung lǝi kwɔ, yang ɓa dǝ tthǝ la lǝ Fuh langkwoi yayuu a gwab tha i ɓǝ.<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />Nungkwɔ yang, ɓi dǝ nungɓi tthǝ nungkwɔ a wulǝ bǝ ǝǝ tǝmmi langkwoi kwɔ a wulǝ bǝ dǝ tthǝ nyimmi lǝ tha. <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />Bǝ a, ɓanglǝ nung to gi Fuh, ba nungtang thǝ, nungtang ǝndǝi i ɓuan i tang ǝn tang, kwoi mko kwɔ ma tang nungkwɔ a to yuu akun a o dang nung a ɓko ɓǝ. <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />Nung a langǝ i kwɔ ɓato kwɔ ɓa yitthǝ bǝ tang nyam, bǝ nwa min, ko bǝ to nung akun kwɔ ato ya dǝ ba a langǝ i yakun a o ɓǝ. <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />A muo natthǝ nungkwɔ a dǝ ba langǝ itthǝ lǝ ba bakwɔ ɓǝ, yang, ganglang mǝ i Fuh. Bǝ khana lo ǝn a bǝ yakwɔ ɓyǝa i yangǝu i nung a ɓko nǝ i to nung kwɔ i ɓyǝa ǝn lo zuiiu ɓǝ! <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />Kwoi nǝ ito shaka lo nungkwɔ i tang yang, Fuh a ɓangǝ ilǝ nǝ i tang nungɓǝ kwɔ ɓǝ, bakwɔ nungto gi tthǝn lobǝ dǝnyitthǝ lǝu. Langkwoi nungkwɔ ǝndǝi nǝ tthǝn lo bǝ dǝnyitthǝ lǝu yang ǝn nung a ɓko.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="s">To Nung A Langǝ i Lǝ Yakuntthǝ, Ən Lomǝ Lǝu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />Ɓi kwɔ ɓi nyimtthǝ dang bǝ dǝnyitthǝ kwɔ ǝnɓi ɓi wonatthǝ lǝ yakwɔ ɓuan bǝ lǝi nunglǝi giu ɓǝ. Bǝ ɓi yidɗi lo ɓi thǝ.<verse eid="ROM 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 15:2" />Niyang, ɓi tǝmnyi lǝ ya dǝba a langǝ i lǝba nung a langǝ i gi, yangbǝ i ghaa dang bǝ dǝ nyitthǝ. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />Bakwɔ Kristi tǝmnyi lǝ lotthǝ lǝu. Niyang, manungkwɔ nungvullǝ ba gi Fuh gei angǝ,&lt;&lt;Ɗyǝam yakwɔ dal ɓǝlǝ kwɔ al lomlǝ.&gt;&gt;<verse eid="ROM 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 15:4" />Nungkwɔ ǝndǝi i vullǝ dang nungvullǝ kwɔ i vullǝ lǝba bǝ naɓi natthǝ nung, yangbǝ ɓi tǝi bǝ dǝnyitthǝ tthǝ bǝ tthǝb nyitthǝ i tthǝnyimmi kwɔ nungvullǝ dǝna dǝɓi ɓǝ.<verse eid="ROM 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 15:5" />Langkwoi kaso Fuh, ya dǝ bǝ tthǝb nyitthǝ i tthǝnyimmi, dǝ ɓǝ ɓyang kǝb lo lǝtha ibǝ muo sua Kristi Yeso, <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />Nungkwɔ yangbǝ ɓǝ ǝndǝi ɓa kha Fuh i yol kun i Daa Dangbang Yeso Kristi ɓi.<verse eid="ROM 15:6" /></para>
  <para style="s">Ba A Langǝ i Sua Yakwɔ Ən ya Yahudawa Lǝu ɓǝ</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />Ɓa gwab tha, yang, lǝ ba ghaali Fuh, manungkwɔ Kristi gwabɓǝ ɓǝ. <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />Bakwɔ ǝn gei ɓǝtthǝ bǝ to nung to gi Kristi ǝn ba ya Yahudawa, yangbǝ i tanatthǝ angǝ Fuh ǝn ya dǝnyitthǝ, u dǝ ganglang gu iya bǝba gi wu ǝǝ lǝ ba a langǝ i.<verse eid="ROM 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 15:9" />Yangbǝ yakwɔ ǝn ya Yahudawa lǝu kwɔ kha Fuh lǝba bǝ ɓyǝa nungzuii gu. Manungkwɔ nungvullǝ ba Fuh gei angǝ,</para>
  <para style="q1" vid="ROM 15:9">&lt;&lt;Langkwoi nungkwɔ mǝn kha dang yakwɔ ǝn ya Yahudawa lǝu ɓǝ;</para>
  <para style="q2" vid="ROM 15:9">mǝn lub ɓin mǝn kha lǝ.&gt;&gt;<verse eid="ROM 15:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10" />Langkwoi nungvullǝ ɓǝ gei angǝ,</para>
  <para style="q1" vid="ROM 15:10">&lt;&lt;Ɓa lǝ tthǝla, ɓǝ yakwɔ ǝn ya Yahudawa lǝu ɓǝ i yayuu gi Fuh!&gt;&gt;<verse eid="ROM 15:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11" />Langkwoi angǝ,</para>
  <para style="q1" vid="ROM 15:11">&lt;&lt;ɓa kha Fuh ɓǝ ǝndǝi yakwɔ ǝn ya Yahudawa lǝu ɓǝ;</para>
  <para style="q2" vid="ROM 15:11">ɓa khko, yayuu ǝndǝi!&gt;&gt;<verse eid="ROM 15:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />Langkwoi angǝ, Ishaya gei angǝ,</para>
  <para style="q1" vid="ROM 15:12">&lt;&lt;Bǝba gi Yesse i fug;</para>
  <para style="q2" vid="ROM 15:12">u wuo wu lo yigwoi lo yakwɔ ǝn ya Yahudawa lǝu ɓǝ,</para>
  <para style="q2" vid="ROM 15:12">yang i dǝnyitthǝu.&gt;&gt;<verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />Kaso Fuh, kwɔ bǝ dǝnyitthǝ ǝrr tthǝu kwɔ, dǝ ɓǝ tthǝla i bǝ ǝǝ a langǝ i tthǝ bǝ dǝnyitthǝ ɓǝ tthǝulǝ, yangbǝ bǝ dǝnyitthǝ ɓǝ lilo tthǝ na ghaa i ttha Ɓyang a Langǝ i.<verse eid="ROM 15:13" /></para>
  <para style="s">Nungkwɔ To Bulus Vullǝnung I Tthǝnyimmi Ɓǝ</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />Ya ǝnthǝm: ǝnlǝ dang tthǝmlǝ geigǝ nung a langǝ i yitthǝ ɓǝ, kwɔ ɓǝ tthǝ i bǝ ibǝ nung ǝndǝi, langkwoi ɓuan ɓa nanatthǝ nunglǝ tha. <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />Kwoi dang nungvullǝ kwɔ ǝn to dang tthǝnyimmi ɗing lo nung akun kwɔ ǝn o ɓǝ nyitthǝ ɓǝ. Ɓang i tthǝnyimmi ba nunglǝi kwɔ Fuh dǝm <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />lǝ thǝb gi Kristi Yeso yangbǝ ǝn to nung to lǝ yakwɔ ǝn ya Yahudawa lǝu ɓǝ. Dǝm to nung to mangǝn ya nyǝknung dang bǝ gei nwaba a langǝ i bǝgǝ Fuh, yangbǝ yakwɔ ǝn ya Yahudawa lǝu ǝǝlǝ nungdǝ kwɔ Fuh a muo ɓǝ, Ɓyang a langǝ i mablǝ Fuh tthǝ. <verse eid="ROM 15:16" /><verse number="17" style="v" sid="ROM 15:17" />Dang tthǝ tha i Kristi Yeso, yang, mǝn lǝi lom dang nung to gi Fuh. <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />Mǝn to tthǝ nyimmi langkwoi mǝn gei ba lo nungkwɔ Kristi to i ɓanglǝ kwɔ ǝn osi lǝ yakwɔ ǝn ya Yahudawa lǝu kwɔ i to nung to i ba Fuh. U to nungkwɔ i ba i nung to, <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />I ttha nung fǝmlo i nungtthǝ vulli, langkwoi i ttha Ɓyang gi Fuh. Langkwoi nungkwɔ, dang tthko kwɔ baipiu Urshalima tǝlǝ Ilirikum, Ən gei nwaba a langǝ i lǝba Kristi.<verse eid="ROM 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 15:20" />Nungkwɔ dang wam nungɓǝ lǝ bǝ gei ba a langǝ i i bǝi kwɔ ǝndǝi kwɔ i lǝ ba Kristi lǝu ɓǝ, yangbǝ ǝǝ mangǝ dǝm mai nung lo pi kǝm kwɔ yuu akun liɓǝ lǝu.<verse eid="ROM 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 15:21" />Manungkwɔ nungvullǝ ba Fuh gei angǝ,</para>
  <para style="q1" vid="ROM 15:21">&lt;&lt;Yakwɔ i gei bagu tthǝ lǝu kwɔ i ɓyǝa,</para>
  <para style="q2" vid="ROM 15:21">yakwɔ lǝ bagu lǝu kwɔ i ibǝi.&gt;&gt;<verse eid="ROM 15:21" /></para>
  <para style="s">Bulus Mablǝi Bǝ Tǝ Roma</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />Langkwoi nungkwɔ ǝn tǝi lǝi lǝu vii ǝndǝi bǝ wua sua ɓǝ.<verse eid="ROM 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 15:23" />Kwoi lakwɔ kwɔ ǝn alo nungtom bǝikwɔ ǝndǝi langkwoi kwɔ dǝm ki ttha kpaatthǝ dǝm yidɗi bǝtǝ sua ɓǝ, <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />Dǝm dǝnyitthǝ bǝ tou lakwɔ. Dǝm yidɗi bǝ ɓyǝa ɓǝ nǝ ǝn ǝrr dǝm tǝ Asbaniya ɓǝ, yang ɓa nwongǝm bǝ ǝn tǝ bǝiɓǝ. Tthasua kwɔ nǝ ǝnlǝ tthǝla bǝ ɓyǝa ɓǝ natthǝ tuab ɓǝ. <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />Lakwɔ niko, ǝndǝi manungkwɔni, dǝm tǝ Urshalima dang bǝ to nung to gi yayuu Fuh bǝi lǝ. <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />Bakwɔ yayyu Fuh Makidoniya i Akaya i gwab angǝ i gǝm nungkwɔ i nwonglǝ ya yiɓko yayuu gi Fuh kwɔ dang Urshalima ɓǝ.<verse eid="ROM 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 15:27" />Bǝ nhǝm bakwɔ ǝn abǝi; kwoi, lǝba a langǝ i, i tthǝ i nung to bǝ nwongǝi. Bakwɔ ya Yahudawa dǝna gab bǝ khana lo ɓyang gi i yakwɔ ǝn ya Yahudawa lǝu ɓǝ, yakwɔ ǝn ya Yahudawa lǝu kwɔ kaso to nung to i nungnai i nwonglǝ ya Yahudawa. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />Kwɔ nǝ ǝn alo nung to kwɔ langkwoi ǝn kwoi lǝ nungkurɓǝ kwɔ ǝndǝi kwɔ i gǝm lǝba gi kwɔ, Mǝn tǝ Asbaniya yang mǝn mǝrrǝm thang ɓǝ nǝ dǝm tǝ ɓǝ <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />Kwɔ nǝ ǝn tǝ sua ɓǝ, ǝn ibǝi dǝm wuo i bǝ khana lo gi Kristi kpaatthǝ.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />Dǝm dǝɓǝ tthǝ nyimmi, ya ǝnthǝm, i ba Dangbang Yeso langkwoi i bǝ yiɗi bǝi kwɔ ya Ɓyang dǝna dǝkwɔ: ɓa wɔm natthǝ bǝ pinwa tthǝ Fuh lǝ bam.<verse eid="ROM 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 15:31" />Ɓa pinwa yangbǝ imlǝ latthǝ na yakwɔ muo ba Fuh lǝu dang Yahudiya ɓǝ, langkwoi yangbǝ yayuu Fuh kwɔ Urshalima kwɔ gwab bam bǝi lǝ. <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />Langkwoi nungkwɔ mǝn tǝsua ɓǝ i tthǝ la, nǝ ǝn bǝ yiɗi gi Fuh ɓǝ, i tthǝ la, bǝ kǝb tha kwɔ ɓi lǝ tthǝla ɓǝ. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />Kaso Fuh ya wɔ lǝ tǝmmi, ǝǝ iɓǝ ǝndǝi. Dǝitthǝ manungɓǝ.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s">Bulus Gumbǝi Ya Ənthǝu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />Dǝm yiɗi bǝ gei ɓǝtthǝ ba young ɓi Fibi, kwɔ u to nung to lǝ ya kǝm pinwa tthǝ Kankiriya ɓǝ. <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />Ɓa muo dang ɗuǝn Dangbang, manungkwɔ yayuu gi Fuh dǝna toɓǝ. Ɓa nwongǝu dang nungkwɔ ǝndǝi dǝu yiɗi naɓǝ ɓǝ; bakwɔ u inko lǝ u ǝn ǝnthǝ a langǝ i gi yayuu kpaaɗing langkwoi i ɓang ǝndǝi.<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />Ɓa gumbǝ Bilkisu i Akila, yakwɔ dǝm to nung to gi Kristi Yeso i ilǝ ɓǝ;<verse eid="ROM 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 16:4" />I ɗyǝab nwongǝi gi lǝ bam. Dǝm khai- ǝn ɓang i nungtthǝm lǝu, kwoi i ya kǝm pinwa yakwɔ ǝn ya Yahudawa lǝu ɓǝ lang ɓǝ. <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />Ɓa gumbǝi ya kǝm pinwa kwɔ dǝna gǝmtha gwoi gilǝ ɓǝ.</para>
  <para style="p" vid="ROM 16:5">Dǝm gum ǝnthǝm Abainitas, kwɔ ulǝ yuu akwɔ osi bǝ dǝba a langǝ i tthǝ Kristi Asiya ɓǝ.<verse eid="ROM 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 16:6" />Ɓa gumbǝ Maryamu, kwɔ u tonungto nikwɔ lǝ bamǝ ɓǝ. <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />Ɓa gumbǝ Andaranikas i Yuniyas, ya young ɓi ya Yahudawa kwɔ ɓang pursǝna i ilǝ ɓǝ; ǝn i la langǝ ing dang ya nwatummi gi Yeso, langkwoi i mǝrrǝm lǝ ya Krista nwuni bǝ ɓang.<verse eid="ROM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8" />Ɓa gumbǝ Amfiliyas, ǝnthǝm dang nung to gi Dangbang. <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />Ɓa gumbǝ Urbanas langɓǝ, ya nung to gi Kristi i ɓilǝ, langkwoi i Istakis, ǝnthǝm dǝm yiɗi niɓǝ.<verse eid="ROM 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 16:10" />Ɓa gumbǝ Abalis, kwɔ i nko i gwabbu dang kristi ɓǝ. Ɓa gumbǝ yakwɔ lǝ ya dang gwoi gi Aristobulus. <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />Ɓa gumbǝ youngǝm Hirudiyan. Youngǝm ya Yahudawa, langkwoi ya Krista dang yayuu gi Narkisas.<verse eid="ROM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12" />Bǝ gum bǝim sua Tarafina Tarafusa, yakwɔ to nung to gi Dangbang, i ǝnthǝm Tarsisa, yuu akwɔ to nung to gi Dangbang niɓǝ. <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" />Dǝm tumbǝi i bǝ gumbǝi sua Rufas, yuu akwɔ to nung to gi Dangbang niɓǝ, langkwoi sua Naa gu, kwɔ dǝu tom nungtthǝ mangǝ ɓang ǝn yuiu ɓǝ. <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />Ɓa gumbǝ Asinkiritas, i Filaguna, i Hamisa i Baturobas, i Hamasa i sua ya Krista kwɔ i ilǝ ɓǝ.<verse eid="ROM 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 16:15" />Ɓa gumbǝ Filulugusa i Yuliya, i Niriyas i youngǝu a yisi, i Ulumfas i sua yayuu Fuh kwɔ i ilǝ ɓǝ.<verse eid="ROM 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 16:16" />Ɓa gumtha i bǝ kumtha tthǝla. Yayuu Fuh ǝndǝi dǝna tumbǝi i bǝ gumbǝi gi.<verse eid="ROM 16:16" /></para>
  <para style="s">Sua Bǝ Lak Bǝi Əndǝi</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />Dǝm lak ɓǝ ya ǝnthǝm: ɓa dǝ kiggǝ ɓǝ tthǝ yakwɔ dǝna gab dang yayuu yang i wulǝ nung ǝrrlǝ bǝ dǝnyitthǝ langkwoi ǝrr tthǝ bǝ nanatthǝnung kwɔ ɓa muo ɓǝ. Bǝ ɓa kǝblo lǝtha i ilǝ thǝ.<verse eid="ROM 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 16:18" />Bakwɔ yakwɔ dǝna to nungkwɔ ǝn yakwɔ dǝna to nung to gi Kristi Dangbang ɓi lǝu, kwoi ǝn ɗǝlak gi. I bǝ ina bagi i bǝ fog bǝi dǝi ɗam yayuu kwɔ ibǝ nunglǝu ɓǝ.<verse eid="ROM 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 16:19" />Yayuu ǝndǝi lǝ bǝ ɓuob lo sua mǝ lǝ ba bǝ to nung to nwaba ba a langǝ i mǝ, langkwoi lǝba bakwɔ dǝm lǝ tthǝla lǝ ba mǝ. Dǝm yiɗi ato yiggǝi lo nung a langǝ i. Kwoi yang a sulǝ lo nung a ɓko. <verse eid="ROM 16:19" /><verse number="20" style="v" sid="ROM 16:20" />Langkwoi Fuh, kwɔ lǝ bǝ ǝǝ ɓi a langǝ i i tthǝla ɓi kwɔ, gbag bǝ tam Mungkullum i bo.</para>
  <para style="p" vid="ROM 16:20">Nung a langǝ i gi Dangbang ɓi Yeso ǝǝ i mǝ.<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />Timitawos, ya to nung to i ɓanglǝ kwɔ, dǝna gumbǝi ɓǝ; langkwoi nungkwɔ i Lukiyas, i Yason i Susibataras, ya youngǝm ya Yahudawa dǝna gumbǝi ɓǝ.<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />Ɓang, Tartiyas, ya vullǝ nungthani kwɔ, dǝm tumbǝi i bǝ gumbǝi sua ɓǝ ya Krista.<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />Gayus kwɔ ɓanglǝ yayol gwoi gu kwɔ, kwɔ ya kǝm pinwa dǝna kǝbtha gwoi gu kwɔ, dǝna tumbǝi i bǝ gumbǝi; Arastas, ya ɓyǝa nungkurɓǝ gwoi angǝ a, langkwoi i young ɓi Kawartas dǝi tumbǝi ibǝ gumbǝi gi. <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />Kaso nung a langǝ i gi Yeso Kristi Dangbang ɓi ǝǝ i ɓǝlǝ ǝndǝi, Dǝitthǝ Manungɓǝ.<verse eid="ROM 16:24" /></para>
  <para style="s">Bǝ Pinwa Khabǝi</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />Ɓi dǝ angǝ a lǝ Fuh! U ɓuan u toɓǝ ɓa dǝi nyimtthǝ dang bǝ dǝ nyitthǝ, manungkwɔ nwaba a langǝ i kwɔ dǝm gei lǝ ba Yeso Kristi langkwoi manung gabnung ba a langǝ i kwɔ pyǝa lǝ pyǝa dang wam tutthǝ kwɔ paɓǝ. <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />Kwoi lakwɔ, i yǝb ba a langǝ i ɓǝ i ilǝ nung pangbǝi dang nungvullǝ ya gei ba a tthasi; langkwoi i bǝ dǝ ba gi Fuh kwɔ ɓui ɓuko kwɔ i gei lǝ ya losua longwam tthǝ ǝndǝi, yangbǝ yayuu ǝndǝi dǝ ba a langǝ i tthǝ tolǝ nung to.<verse eid="ROM 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 16:27" />Ɓi dǝlǝ Fuh ɓuo, kwɔ u i nungtthǝu lǝya yiggǝi ǝndǝi, bǝ dǝ angǝ a tthǝ Yeso laɗing! Dǝitthǝ Manungɓǝ.<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>