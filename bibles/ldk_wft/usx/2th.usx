<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">2TH MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">2Tassalonikawa</para>
  <para style="toc1">Nungvullǝ Gi Bulus A Rab Sua Ya TASSALONIKAWA</para>
  <para style="toc2">2 Tassalonikawa</para>
  <para style="toc3">2 Tass</para>
  <para style="mt2">Nungvullǝ Gi Bulus A Rab Sua Ya</para>
  <para style="mt1">TASSALONIKAWA</para>
  <para style="imt1">Bǝ Gabnung</para>
  <para style="ip">Nung bai thǝl lo bǝ ki bǝ kwoi gi kristi lilo tthǝ bǝ wulǝ yurrǝ dang kǝm pinwa dang Tassalonika. <char style="bk" closed="false">Nungvullǝ gi Bulus a nung rabbu sua ya Tassalonika gei ba lo bǝ dǝ ba a langǝ i vii wuo gi Dangbang wuoang. Bulus mab zuii ba, nung gwambǝi nung vii kwɔ kristi a wɔ tthǝ, mungkulum i bǝ to mulub a ɗab yi tthǝ bǝ lo yikku kwɔ dǝna lubǝiu angǝ ''ya dang wa aɓau,'' yuu kwɔ u la ba kristi ɓǝ</char></para>
  <para style="ip">Ya nwa tummi gi yeso lilo tthǝ bǝ gǝi angǝ dǝi yiɗi ya than nungvullǝ gi i dǝi lo bǝdǝ nyitthǝ dang bǝ to yurrǝ i bǝ to zuii, bǝ to nungto a nwongǝi kwɔ Bulus to i ya to nungto i ulǝ, langkwoi i bǝ lilo tthǝ bǝ to nung a langǝ i.</para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />Ɓang Bulus dǝmǝn vullǝ ɓǝ nungvullǝ kwɔ tthǝ, Sila, i Timitawos suatha i ɓang lǝ. Dǝɓi tumbǝi i nungvullǝ kwɔ Sua ya kǝm pinwa gwoi angǝ a Tasalonika, yayuu gi Fuh Daa ɓi i Dangbang Yeso Kristi.<verse eid="2TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2" />Kaso Fuh Daa ɓi i Dangbang Yeso Kristi dǝɓǝ bǝ tonung a langǝ i i bǝ ǝǝ tthǝla.<verse eid="2TH 1:2" /></para>
  <para style="s">Bǝ To Kwan Vii Bǝ Wuo Gi Kristi</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />Ya ǝnthǝ ɓi, lona kwɔ ǝndǝi dǝ ɓi kha Fuh lǝ ba ɓǝ. Maɗing kwɔ ɓi to manungɓǝ ɓǝ, ba kwɔ bǝ dǝ ba a langǝ i ɓǝ dǝna ghaani ɓǝ langkwoi bǝ yiɗi bǝikwɔ tthǝ ko ǝn ya dǝna to tthǝ ya kun kwɔ dǝna ghaaɗing. <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />Ən ba ɓǝkwɔ nungkwɔ dǝɓi to lo angǝ a lǝ ba ɓǝ dang kǝm pinwa gi Fuh ɓǝ. Dǝɓi to lo angǝ a lǝ bakwɔ dǝɓa li si bǝ dǝba a langǝ i i dang zui i bǝ tozui kwɔ ǝndǝi dǝɓa tǝiɓǝ.<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />Nungkwɔ ǝndǝi dǝna naɓi natthǝ angǝ kwan gi Fuh ǝn lozuiu langkwoi manungkwɔni yang ɓa tǝi bǝ lo yigwoi gi Fuh ǝntǝi, kwɔ dǝ ɓa to zuii lǝ bko ɓǝ. <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />Fuh a to nungkwɔ matthǝ ɓǝ: U dǝzuii lǝ ya kwɔ dǝna dǝɓǝ zuii ɓǝ, <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />langkwoi u dǝ tthǝ tǝmmi lǝ ya kwɔ dǝna to zuii ɓǝ langkwoi i ɓilǝ. U to nungkwɔ nǝ Dangbang Yeso pin wayi lǝ i ya nwatummi gi Fuh ɓǝ, <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />i bǝb lua, u ɗablua yakwɔ la Fuh langkwoi la bǝ dǝ ba a langǝ i tthǝ ba a langǝ i gi Dangbang Yeso ɓǝ. <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />I to zuii bǝ ɗablua bǝi a ɗing, i nanni ɗǝgsi Dangbang langkwoi ttha ghaali gu, <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />kwɔ nǝ u wuo villǝ kwɔ wuu muo ghaali na yayuu gu ǝndǝi langkwoi ghaali na yakwɔ dǝ ba a langǝ i tthǝ ɓǝ. Ɓǝ ma langɓǝ ɓǝ dang ǝu, bakwɔ ɓa dǝ ba a langǝ i tthǝ bakwɔ ɓi gei ɓǝtthǝ ɓǝ. <verse eid="2TH 1:10" /><verse number="11" style="v" sid="2TH 1:11" />Ən baɓǝ kwɔ nungkwɔ dǝ ɓi pinwa lǝ ba ɓǝ vii ǝndǝi. Dǝ ɓi yam Fuh mǝrrǝm ɓǝ lǝya langǝ i yangbǝ ɓa tǝi nwongǝi kwɔ u lubǝi ɓǝ lǝ bko wuo ɓa ǝǝ tthǝ ɓǝ. Kaso u dǝitthǝ yang u al lo i tthko tthǝ nungkwɔ ǝndǝi dǝɓa ɗubǝi lǝ a langǝ i yang u alo nungto a langǝ i kwɔ ɓato i lo nyi a langǝ i ɓǝ. <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />Kaso ɗuǝn Dangbang Yeso ɓi tǝi angǝ a naɓǝ lǝ, langkwoi ɓa tǝi nkolǝ, tthǝ bǝ dǝ nung a langǝ i gi Fuh ɓi langkwoi i a bǝ Dangbang Yeso Kristi.<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">Ya To Kiggǝ aɓau</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />Lakwɔ ya ǝnthǝm, lǝ ba bǝ wuo gi Dangbang Yeso Kristi langkwoi lǝ ba bǝ kǝbtha ɓi bǝ yikun ɓi ǝǝ i u: Dǝmǝn yamɓǝ, <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />bǝ ɓa lǝ tthǝ vulli ghaani bǝ nhǝm ba ɓǝ langkwoi kiggǝ ɓǝ ǝrrthǝ kwɔ ɓǝ bakwɔ angǝ bǝ ǝrri gi longwam wung ɓǝthǝ. Manungkwɔni dǝɓi nhǝm langkwoi ɓi gei vii kwɔ dǝɓi gei nwa ba a tthasi i bǝ gei ba gi Fuh, ko kwɔ ɓi vullǝ dang nungvullǝ ɓǝ. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />Bǝ ɓa gwab yuu akun ɗamɓǝ thǝ. Lko vii ɓǝ wuou nǝ tthasua ǝndǝi nǝ yuu kiggǝ a ɓko kwɔ nǝ wuo langkwoi vii ya to nung a ɓko wuo longwam, yang i liu lua ɓǝ. <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />U la i nungkwɔ dǝi lub angǝ ǝn fuh ko nungkwɔ dǝi wab langkwoi u dǝlo loilǝ ǝndǝi. U tǝ dang kǝm nyǝknung gi Fuh u ǝǝsua angǝ i ǝn Fuh. <verse eid="2TH 2:4" /><verse number="5" style="v" sid="2TH 2:5" />Ɓa nhǝm lǝu? Ən geiɓǝ nungkwɔ tthǝ ǝndǝi vii kwɔ ɓang iɓǝ lǝ ɓǝ. <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />Lakwɔ nung tthǝ dǝna nan nungkwɔ bǝ tonung, lakwɔ ɓa ibǝ nung ɓǝng. Lona a langǝ i, langkwoi, ya mulub akun a wɔ. <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />Ya ttha ya mulub osi baipi nungtou, kwoi nungkwɔ a to nung kwɔ to nungǝu nǝ yuu kwɔ muo kwɔ nǝ i nannu ɗǝ.<verse eid="2TH 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TH 2:8" />Langkwoi i ilǝ nwa yiɓko yuu akwɔ lǝ ya mullub ɓǝ, kwoi kwɔ nǝ Dangbang Yeso wuo, yang a thǝbbu i bǝ nwongǝi nwuo lǝ yang a ɓangǝu lǝ dang bǝ wuo gu. <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" />Ya mullub akun a wɔ i ttha mungkullum wa to nung fǝmlo a ɓko i nungdǝ tthǝvulli, <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />yang u to nung lo ya kiggǝ a ɓko lo ya kwɔ a thǝm nǝkwam ɓǝ. I thǝm nǝkwam bakwɔ i igwam langkwoi i yiɗi ba a langǝ i lǝu kwɔ yangbǝ i tǝi nwongǝi ɓǝ. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />Yang langkwoi Fuh a toggǝi gong pǝllǝ tthǝ wa to nung to i ilǝ yangbǝ i dǝ ba a langǝ i tthǝ pǝlǝ. <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />Ba a langǝ i nungkwɔ yakwɔ nǝ dǝ ba a langǝ i tthǝu lǝ lǝu, yang dǝloi tthǝ bǝ to nung a ɓko, yang i ɓangǝ i lǝ.<verse eid="2TH 2:12" /></para>
  <para style="s">I Mkoɓǝ Lǝba Bǝ Soblo</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />Ya ǝnthǝ ɓi, ɓi kha Fuh lona ǝndǝi lǝ ba ɓǝ, ɓǝ ya kwɔ Dangbang dǝna yiɗi ɓǝ. Lakwɔ Fuh mko ɓǝ nungsi a nwong ɓǝ tthǝ ttha Ɓyang a langǝ i yang mǝrrǝm ɓǝlǝ yayuu a Langǝ i tthǝ bǝ dǝnyitthǝ nung a langǝ i kwɔ ɓa dǝ tthǝu lǝ ɓǝ. <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />Fuh lubǝi ɓǝ tthǝ ba afu kwɔ i gei ɓǝtthǝ ɓǝ; u lubǝi ɓǝ yangbǝ wuo ɓa muo ghaali gi Dangbang Yeso Kristi ɓi. <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />Ya ǝnthǝ ɓi, yang lakwɔ, ɓa dǝi nyimtthǝ ɓa muo ba a langǝ i kwɔ ɓi gei ɓǝtthǝ ɓǝ, dang bǝ gei ba ɓi i dang bǝ vullǝ nungɓi. <verse eid="2TH 2:15" /><verse number="16" style="v" sid="2TH 2:16" />Dangbang Yeso Kristi i Fuh Daa ɓi, kwɔ yiɗi ɓi kwoi dang nyitǝmmi gu dǝɓi tthǝnyimmi ɓi dǝi nyimtthǝ dang bǝ dǝnyitthǝ ɓi a ɗing, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />u dǝɓǝ tthǝnyimmi langkwoi nyimtthǝ ɓǝ vii ǝndǝi ɓato langkwoi ɓa gei nungkwɔ matthǝ ɓǝ.<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s">Ɓa Pi Ɓi Nwa Tthǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />Ya youngǝm, bǝ alo ǝndǝi, ɓa pi ɓi nwatthǝ yangbǝ ba gi Dangbang li si yǝbtha nǝ nyimmi lǝibǝi ǝndǝi yangbǝ i muo i bǝ dǝ angǝ a tthǝ, manungkwɔ ganglangɓǝ ɓǝ. <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />Ɓa pi ɓi nwatthǝ langkwoi yangbǝ Fuh iɓilǝ dang kiggǝ a ɓko gi yato mungkullum; bakwɔ ǝn yayuu ǝndǝi dǝ ba a langǝ i tthǝ nwaba a langǝ i lǝu ɓǝ.<verse eid="2TH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3" />Langkwoi Dangbang ǝn ya nyitǝmmi, u dǝ ɓǝ ttha u nwong ɓǝ naya Mulub kwɔ. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />Langkwoi Dangbang a dǝ ɓi tthǝnyimmi tthǝɓǝ, langkwoi ɓi ibǝing dǝɓa to langkwoi ɓa lilo bǝ to nung kwɔ ɓi gei ɓǝtthǝ ɓǝ.<verse eid="2TH 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 3:5" />Kaso Dangbang tǝɓǝlǝ bǝ ibǝ nung angǝ a i bǝ yiɗi bǝi gi Fuh i bǝ lǝi i lo nyi bǝ dǝi nyimtthǝ dang Kristi.<verse eid="2TH 3:5" /></para>
  <para style="s">Ko Ən ya Əndǝi Tǝi Nung to Kwɔ Ato Ɓǝ</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />Ya youngɓi, dǝɓi gub ɗuogsui ɓǝ dang ɗuǝn Dangbang Yeso Kristi ɓa kwoi ɓa yiǝ ya dǝ ba a langǝ i kwɔ ɓkoni langkwoi kwɔ i muo bǝ lak bǝi kwɔ ɓi ji lǝu ɓǝ. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />Ɓǝ i naɓǝ ɓa ibǝi matthǝ kwɔ angǝ ɓato manungkwɔ ɓito ɓǝ. Ɓi ya muantthǝ lǝu viikwɔ ɓi iɓǝlǝ ɓǝ. <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />Ɓi muo bǝ nwongbǝi gi yuu akun kwɔ ɓi kwaiu lǝuɓǝ. Manungkwɔni yang, dǝɓi tonungto i busoni vii ǝndǝi; dǝɓi tonungto dang fuh i nungvii yangbǝ bǝɓi ɗu nungkurɓǝ na yuu akun dang ɓǝthǝ. <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />Dǝɓi to nungkwɔ, angǝ ɓi yangǝu i ttha kwɔ ɓi ɓuan ɓi ɗu nung akun naɓǝ lǝu ɓǝ; ɓi to yangbǝ ɓi taɓǝ natthǝ nunglǝi kwɔ ɓa muo tthǝ ɓǝ. <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />Kwɔ ɓi iɓǝlǝ kwɔ, dǝɓi geiɓǝ ɓiingǝ, &lt;&lt;Yuu akwɔ nǝ labǝ to nung to yangbǝ i du nungtang u tang thǝ.&gt;&gt;<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />Ɓi gei nungkwɔ bakwɔ ɓilǝ angǝ yakun dang ɓǝ dǝna ǝǝ bǝ ǝǝ ya ɓko langkwoi i to nung akunu dǝnni tǝ dang nung a bǝ yakun nǝkwam. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />Dang ɗuǝn Dangbang Yeso Kristi ɓi gei ba lǝ yayuu kwɔ langkwoi ɓi gub ɗuogsui ɓi gei ɓiingǝ i ǝǝ langkwoi i to nung to kwɔ i muo nungbusɔni gi i ɗu lǝ nungtang ɓǝ .<verse eid="2TH 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13" />Ya youngǝm, kwoi ɓaɓǝ, bǝ thǝm ɓǝ babǝ tonung a langǝ i thǝ. <verse eid="2TH 3:13" /><verse number="14" style="v" sid="2TH 3:14" />Lko yakun tthǝ bǝilǝ a la ba gi Fuh kwɔ ɓi vullǝ ɓi tog ɓǝ tthǝ ɓǝ. Nǝ manungɓǝni yang ɓa ɓyǝaing lalangǝ i yang bǝɓa tonung akun i ilǝ thǝ, yangbǝ i lǝ tthǝkku. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />Bǝɓa toi mangǝ i ǝn ya ɓui ɓǝ thǝ; manungkwɔni yang, ɓa gub ɗuog sui mangǝttǝn i ǝn ya dǝ ba a langǝ i tthǝ Fuh.<verse eid="2TH 3:15" /></para>
  <para style="s">Bǝ Alo Ba</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />Kaso Dangbang i nkolǝ, kwɔlǝ yuu wulǝ nyitǝmmi, dǝɓǝ nyitǝmmi lona ǝndǝi i bǝi ǝndǝi. Dangbang ǝǝ iɓǝ ǝndǝi.<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />Ən vullǝ nungkwɔ i namlǝ: Bulus dǝna gumbǝi. Manungkwɔni dǝmǝn dǝ nam dang nungvullǝm ǝndǝi; manung kwɔni ǝn vullǝ.<verse eid="2TH 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18" />Kaso bǝ tǝmnyi gi Dangbang Yeso Kristi ɓi ǝǝ i ɓǝ ǝndǝi.<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>