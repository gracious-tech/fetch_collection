<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">1 Tassalonikawa</para>
  <para style="toc3">1 Tass</para>
  <para style="toc2">1 Tassalonikawa</para>
  <para style="mt">1 Tassalonikawa</para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />Ɓang Bulus, Sila, i Timitawos</para>
  <para style="p" vid="1TH 1:1">Dǝɓi tumbǝi i nungvullǝ kwɔ sua ya dǝba a langǝ i sua ya kǝm pinwa gwoi angǝ a Tasalonika, yakwɔ ǝn a bǝ Fuh Daa langkwoi Dangbang Yeso Kristi:</para>
  <para style="p" vid="1TH 1:1">Kaso nung a langǝ i gi Fuh ǝǝ i ɓǝlǝ.<verse eid="1TH 1:1" /></para>
  <para style="s">Nwongǝi Ibǝ Dǝnyitthǝ Ya Tasalonika</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />Vii ǝndǝi dǝɓi dǝ angǝ a lǝ Fuh lǝ ba ɓǝ langkwoi lona ǝndǝi u pinwa lǝ ba ɓǝ. <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />Bakwɔ dǝɓi nhǝm Fuh Daa ɓi nungsi langkwoi kwɔ dǝɓa to nung to i bǝ dǝnyitthǝ ɓǝ, kwɔ bǝ yiɗi bǝiɓǝ to ɓǝ dǝɓa to nung to niɓǝ, langkwoi kwɔ dǝɓa dǝnyitthǝ Dangbang Yeso Kristi nyimtthǝ. <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />Ya young ɓi, ɓi ibǝing Fuh dǝna yiɗi ɓǝ nungkwɔ u mko ɓǝ lǝ abo. <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />Bakwɔ ɓi wuo ɓǝlǝ nwaba a langǝ itthǝ ɓǝ, ǝn ba a nwa ɓuolǝu, kwoi i ttha i Ɓyang a Langǝ i, langkwoi ɓa muo ba a langǝ i nungkun. Ɓa ibǝi bǝ ǝǝ ɓi kwɔ ɓi iɓǝlǝ ɓǝ; lǝ ǝn baɓǝ. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />Ɓa nalǝ nwaɓi i Dangbang; ko kwɔ ɓa tozuii niɓǝ, ɓa muo nwaba a langǝ iɓǝ i tthǝla kwɔ dǝna wɔ bǝgǝ Ɓyang a Langǝ i ɓǝ. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />Yang ɓa mǝrrǝm lǝ nungkwɔ ya dǝ ba a langǝ i a na nungtthǝ ɓǝ Makidoniya i Akaya ɓǝ. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />Ɓa ilǝ nwaba a langǝ i lǝ ba Dangbang dang Makidoniya i Akaya, kwoi nwaba lǝ babǝ dǝnyitthǝ ɓǝ tthǝ Fuh tǝ bǝikwɔ ǝndǝi. Manungkwɔni yang, lakwɔ nung yangǝu kwɔ. Ɓi gei ɓǝu. <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />Yayuu kwɔ ǝndǝi gei kwɔ ɓa muo ɓi kwɔ ɓi tǝ sua ɓǝ ɓǝ, langkwoi kwɔ ɓa mǝrrǝm ɓa yitthǝ bǝ wab nung a wab wab ɓa tǝ sua Fuh ɓǝ, yangbǝ ɓa wab Fuh a langǝ i ya nwongǝi <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />langkwoi yangbǝ ɓa ki Yuiu kwoi wayi wuo- Yuiu Yeso, kwɔ u ǝrrǝu lǝ bǝ ɓuiɓua kwɔ u nwong ɓi tthǝ nyi gi Fuh kwɔ dǝna wɔ ɓǝ.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">Nungto Gi Bulus Tasalonika</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />Ya ǝnthǝ ɓi, ɓǝ i naɓǝ ɓa ibǝing bǝ tǝsua ɓǝkwɔ ɓitǝ kwɔ o nǝkwam lǝu. <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />Ɓa ibǝi zuii kwɔ i ɗǝ ɓi langkwoi i dal ɓi Filibi nwuni bǝ ɓi tǝsua ɓǝ Tasalonika ɓǝ. Langkwoi ko kwɔ ya la baɓi kpaaɗing, Fuh ɓi dǝɓi tthǝ nyimmi bǝ geiɓǝ nwaba a langǝ itthǝ kwɔ ǝrr bǝgǝ guɓǝ. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />Bǝ gei baɓi ǝn bǝ galnung langkwoi nung a ɓko lǝu, langkwoi dǝ ɓi yiɗi bǝ ɗam yuu akun lǝu. <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />Manungkwɔni yang, dǝ ɓi gei ba manungkwɔ Fuh dǝna yiɗi ɓi gei ɓǝ, bakwɔ Fuh naɓi u tǝiɓi ɓi natthǝng kwɔ u dǝɓi nwaba a langǝ i naɓi ɓǝ. Dǝɓi yiɗi ǝn bǝ la lon yi yayuu lǝu, kwoi dǝɓi yiɗi ǝn bǝ la lo nyi Fuh, kwɔ dǝna na lo nyi ɓi ɓǝ. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />Ɓa i ɓing la langǝ i ɓi wuo sua ɓǝ i nwa la lǝu, ɓi to nung to i ba ɓi lamlǝ bǝ yiɗi nung lǝu- Fuh lǝ ya shǝdǝ ɓi! <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />Ɓi ɗu bǝ khabǝi nwa yuu akun lǝu, ko nwa ɓǝ ko nwa yakun, <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />ɓi kwɔ lǝ ya nwatummi gi Kristi kwɔ ɓi ɗu nung ǝn ɗu naɓǝ. Kwoi ɓi tǝmɗing kwɔ ɓi iɓǝlǝ ɓǝ, mangǝn naa kwɔ dǝna ttha yathang guɓǝ. <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />Lǝ babǝ yiɗi ɓǝkwɔ dǝɓi yiɗi kwɔ ɓi ǝǝlo bǝ geiɓǝ nwaba a langǝ i tthǝ bǝgǝ Fuh i nwongǝi ɓi ǝndǝi. Dǝɓi yiɗi ɓǝ ɗing! <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />Ya young ɓi, la langǝ i ɓa nhǝm, kwɔ ɓi to nung to ni ɓi tangzuii kwɔ! Ɓi to nung to dang fuh i nungvii yangbǝ bǝɓi ǝǝlǝ nung a ɓuonni loɓǝthǝ kwɔ dǝɓi gei ɓǝ nwaba a langǝ i gi Fuh tthǝɓǝ.<verse eid="1TH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10" />Ɓǝ ǝn ya shǝdǝ ɓi, langkwoi i Fuh lǝ, angǝ kiggǝ ɓi tthǝɓǝ kwɔ ɓa dǝba a langǝ itthǝ kwɔ maɗing, la langǝ i, langkwoi nung a ɓko yangǝu tthǝu. <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />Ɓa ibǝi ɓi to koya dang ɓǝ mangǝ ǝn ya daa i ya naa a tolǝ yathang gi tthǝɓǝ. <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />Ɓi dǝɓǝ tthǝnyimmi, ɓi tǝm lo nyi ɓǝ, ɓi ǝnwa bǝ gei ɓǝ ɓa to i kiggǝ kwɔ Fuh dǝna lǝ tthǝ lko ɓǝ, kwɔ lubǝi ɓǝ ɓa tǝi nwathan ɓǝ bǝikwɔ ulǝ yigwoi langkwoi i ghaali gu.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />Nung akuntthǝ langkwoi kwɔ to kwɔ vii ǝndǝi dǝɓi to sakko lǝ Fuh ɓǝ. Kwɔ nǝɓi wuo ɓǝlǝ nwaba gi Fuh tthǝɓǝ, ɓalǝ langkwoi ɓa muo, mangǝn nwaba thayuu lǝu kwoi mangǝn nwaba gi Fuh, kwɔ lalangǝ i manungɓǝ ɓǝ. Fuh dǝna tonungto tthǝɓǝ kwɔ ɓa dǝba a langǝ i tthǝɓǝ. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />Ya ǝnthǝ ɓi, nung kwɔ tǝiɓǝ kwɔ ǝn u nungɓǝ kwɔ langɓǝ tǝi ya kǝm pinwa gi Fuh Yahudiya, yayuu kwɔ bǝilǝ kwɔ ǝn a bǝ Kristi Yeso. Ɓa tangzuii natha na yayuu ɓǝ manung akwɔ i tang na ya Yahudawa ɓǝ, <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />ya Yahudawa kwɔ thǝb Dangbang Yeso i ya gei ba a tthasi, langkwoi i dǝɓi zuii. I dǝ ba zibǝi lǝ Fuh! Kiggǝi ɓkoɗing tthǝ yayuu ǝndǝi! <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />I ɗuong nungǝi kaso yangbǝ i nan ɓi bǝ gei ba a langǝ i lǝ yakwɔ ǝn ya Yahudawa lǝu nwaba kwɔ a ji nwongǝi ɓǝ. Manungkwɔ ni i al lo nung a ɓko ǝndǝi kwɔ vii ǝndǝi dǝi to ɓǝ. Nǝsua ǝndǝi nyi gi Fuh o loing!<verse eid="1TH 2:16" /></para>
  <para style="s">Bulus Yiɗi Bǝ Tǝsua Ya Tasalonika Akun</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />Ya young ɓi, ɓi aɓi abo, kwɔ i gab ɓi lǝtha i ɓǝlǝ natthǝ tuab-dang bǝ nhǝm ba ɓilǝu, kwoi tthǝn tthǝ ɓuo-ɓi tuutha i ɓǝ langkwoi dǝɓi yidɗi bǝ ɓyǝa ɓǝ ɗing! <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />Dǝ ɓi yiɗi bǝ kwoiu ɓi tǝsua ɓǝ. Ɓang Bulus i nam pǝl bo rabbǝng kwɔ dǝm yiɗi bǝ kwoiu mǝn tǝ suaɓǝ ɓǝ, kwoi Mungkullum yiɓi lǝu. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />Ən ɓǝlǝ bǝ dǝnyitthǝ ɓi, ǝnɓǝ-ɓuo, ǝn yakun lǝu!-Kwɔlǝ ɓǝ dǝnyitthǝ ɓiɓǝ, bǝ lǝ tthǝla ɓi, lǝ nungkwɔ to ɓi lǝilo ɓi babǝ tang lo ɓi ɗǝgsi Dangbang Yeso kwɔ nǝ dǝu wuotthǝ ɓǝ. <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />La langǝ i, dǝɓi lǝi lo ɓi lǝba ɓǝ langkwoi ɓǝlǝ tthǝla ɓi!<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />Bǝ alo ǝndǝi, ɓi ɓuan ɓi lilotthǝ bǝ tthǝb nyitthǝ lǝu. Nungkwɔ mǝrǝm lonyiɓi ɓi pa ɓi tǝ Atina <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />kwoi ɓi tum Timitawos, young ɓi kwɔ dǝna to nung to i ɓilǝ ba Fuh dang bǝ gei nwaba ba Kristi. Ɓi tummu tǝu dǝɓǝ tthǝnyimmi langkwoi u nwong ɓǝ dang bǝ dǝnyitthǝ, <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />yangbǝ bǝ yuu akun dang ɓǝ kwoi nǝ tthasua ba zuiim thǝ. Ɓǝ i naɓǝ ɓa ibǝing zuii kwɔ dang nungkwɔ Fuh dǝna yiɗi angǝ ɓi tangɓǝ. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />Kwɔ yirrǝ ɓi iɓǝlǝ kwɔ, ɓi osi ɓi gei ɓǝtthǝng ɓingǝ ɓi tang zuii; langkwoi manungkwɔ ɓa ibǝing lalangǝ i kwɔ, ǝn u nungɓǝkwɔ tonung ɓǝ. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />Nungkwɔ to ǝn tumm Timitawos ɓǝ. Ən ɓuan ǝn lilotthǝ ɓǝ tthǝb nyi tthǝu, nungkwɔ ǝn tummu geigǝ tǝu ɓib u lǝ babǝ dǝnyitthǝ ɓǝ. La langǝ i ǝnba angǝ Mungkullum na ɓǝ lǝu langkwoi nung to ɓi ǝndǝi mǝrrǝm lǝ nung a nǝkwam!<verse eid="1TH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />Lakwɔ Timitawos kwoi wung, langkwoi u wuɓi lǝ nwaba a langǝ i tthǝ loɓǝ lǝ babǝ dǝnyitthǝ ɓǝ i bǝ yiɗi bǝi ɓǝ. U gei ɓitthǝ angǝ vii ǝndǝi dǝɓa nhǝm ba matthǝ loɓi langkwoi dǝɓa yiɗi bǝ ɓyǝa ɓi manungkwɔ langɓǝ dǝɓi yiɗi bǝ ɓyǝaɓǝ ɓǝ. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />Ya young ɓi, dang zuii i tthǝzii ɓi ǝndǝi tthǝɓi da nyim lǝ baɓǝ, ǝn bǝ dǝnyitthǝ ɓǝ nungkwɔ nyim tthǝɓi, <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />bakwɔ lakwɔ ɓi ǝǝ nǝɓa dǝi nyimtthǝ i nwongǝi ɓǝ dang tha i Dangbang ɓǝ. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />Lakwɔ ɓi dǝ angǝ a lǝ Fuh ɓi. Ɓi du angǝ a lǝba tthǝla ɓi ɗǝg siu lǝ baɓǝ. <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />Dangfuh i nungvii dǝɓi yammu i dang nyi ɓi ǝndǝi yangbǝ u yiɓi ɓi ɓyǝa ɓǝ i nung ɓilǝ yangbǝ ɓi dǝɓǝ nungkwɔ dǝɓa yidɗi tthǝ bǝ dǝnyitthǝ ɓǝ.<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />Kaso Fuh i Daa i nkolǝ i Dangbang Yeso mab ɓi nunglǝi tthǝ ɓi tǝ sua ɓǝ! <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />Kaso Dangbang to bǝ yiɗi bǝiɓǝ kwɔ ɓa yiɗi lǝtha langkwoi i yayuu ǝndǝi ghaa ǝǝnwa bǝ ghako mǝrrǝm ghaa mangǝn bǝ yiɗi bǝi kwɔ dǝɓi yiɗi ɓǝlǝ ɓǝ. <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />Nunglǝi kwɔ ni yang u dǝ ɓǝ tthǝnyimmi, yang ɓa ǝǝ matthǝ langkwoi la langǝ i ɗǝgsi Fuh ɓi langkwoi Daa ɓi kwɔ nǝ Dangbang ɓi Yeso a wɔ i yakwɔ ǝndǝi ǝn abo ɓǝ.<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">Nwongǝi Kwɔ Fuh Dǝnna Lǝ Tthǝlko Ɓǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />Bǝ alo ǝndǝi, Ya youngǝm, ɓi naɓǝ natthǝ bǝ ǝǝ kwɔ yangbǝ Fuh lǝ tthǝla ɓǝ. Nungkwɔlǝ, la langǝ i, nunglǝi kwɔ ɓa ǝǝ viikwɔ ɓǝ. Langkwoi lakwɔ dǝɓi yam dǝɓi yiɗi dang ɗuǝn Dangbang Yeso ɓa lilo bǝ tou. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />Ɓa ibǝi nungkwɔ ɓi gei ɓǝtthǝ ɓi geigǝ ɓa to ɓǝng i ttha gi Dangbang Yeso. <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />Fuh dǝna yiɗi ɓa ǝǝ matthǝ ɓa ilǝ loɓǝ ɓa sur bǝ to nung a ɓko bǝ lo i tha thǝ. <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />Ɓǝ yaɓǝi ǝndǝi ɓa ibǝi nunglǝi kwɔ ɓa ǝǝ i yasi ɓǝ nunglǝi a langǝ i matthǝ, <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />i ɗǝlak yiɗi bǝi, mangǝn ya wabnung kwɔ i Fuh lǝu ɓǝ. <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />Dang bakwɔ, yang, bǝ yuu akun to nung a ɓko lǝ ya Kristǝ ko ɗammǝi thǝ. Ɓi gei ɓǝ nungkwɔ tthǝng viikwɔ, langkwoi dǝ ɓi gub ɗuogsui ɓǝ nyimtthǝ lakwɔ ɓingǝ Dangbang a ɗablua yakwɔ to nung kwɔɓǝ. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />Fuh lubǝi ɓi yangbǝ ɓi ǝǝ dang nung a ɓko lǝu, kwoi dang nung a langǝ i. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />Nungkwɔ yang, yuu akwɔ nǝ la bǝ nanatthǝ nungkwɔ dǝna la ǝn thayuu ɓuo lǝu, kwoi dǝu la ǝn Fuh, kwɔ dǝɓǝ Ɓyang a Langǝ i gu ɓǝ. <verse eid="1TH 4:8" /><verse number="9" style="v" sid="1TH 4:9" />Bǝ vullǝ nung lǝ babǝ yiɗi tha yangǝu. Ɓǝ i naɓǝ Fuh naɓǝnatthǝ bǝ yiɗi thang. <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />Langkwoi la langǝ i, ba a langǝ i, ɓa to manungkwɔni tthǝ ya dǝba a langǝ i dang Makidoniya ǝndǝi. Ya young ɓi nungkwɔ ɓi yamɓǝ, ɓa lilo bǝ tou. <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />Bǝ ǝǝ a langǝ i nungɓǝlǝ nungkwɔ ɓa dǝ tthasi ɓǝ, ko ǝn ya dǝnung tthǝ nung to gu, langkwoi tanglǝ lo, manungkwɔ ɓi gei ɓǝtthǝ viikwɔ ɓǝ. <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />Nunglǝi kwɔ ni yang ɓa tǝi ghaali na yakwɔ ǝn ya dǝba a langǝ i lǝu ɓǝ, yang ɓa dǝ tthǝɓǝ tthǝ yuu kun lǝ ba nungkwɔ dǝɓa yiɗi ɓǝu.<verse eid="1TH 4:12" /></para>
  <para style="s">Bǝ Wuo Gi Dangbang</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />Ya young ɓi, dǝɓi yiɗi ɓa ibǝi ba a langǝ i ba yakwɔ ɓuiɓǝ, yangbǝ bǝ dang waɓǝ ɓanglǝ thǝ, manung a bǝ yakwɔ bǝ dǝnyitthǝ gi yangǝu ɓǝ. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />Ɓi dǝba a langǝ itthǝ ɓingǝ Yeso ɓui langkwoi ǝrr bǝ ɓuiɓua, langkwoi nungkwɔ ɓi dǝba a langǝ i ɓingǝ Fuh a ee Yeso i yakwɔ dǝba a langǝ i tthǝu a kwoilǝ a tǝlǝ tthǝu.<verse eid="1TH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15" />Nungkwɔ dǝɓi naɓǝnatthǝ lakwɔ kwɔ ǝn bǝ nanatthǝ nung gi Dangbang: ɓi kwɔ i nwongǝi kwɔ viikwɔ Dangbang a wɔtthǝ kwɔ ɓi owhsi lǝ yakwɔ ɓui ɓǝu. <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />Villǝ kullo Dangbang i nkolǝ a pin wayi ibǝ gei nwa ba i yol yikuu ya nwatummi gi Fuh, langkwoi i yol ɓii gi Fuh, langkwoi yakwɔ ɓui dang Kristi kwɔ a ǝrr Viilǝ kullo i nwongǝi nungsi; <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />yang ɓi kwɔ ɓi i nwongǝi viilǝ ɓi kǝbtha i ilǝ dang tǝi ɓi kǝbtha i Dangbang dang yilǝ. Langkwoi manungɓǝ vii ǝndǝi ɓi ǝǝ i Dangbang lǝ laɗing. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />Nungkwɔ yang, ɓa nyim tthǝtha i bakwɔ.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s">Ɓa Mab Zuii Bǝ Wuo Gi Dangbang</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />Ya young ɓi, ɓi yidɗi bǝ vullǝ ɓǝ nung akuntthǝ lǝu lǝ ba lona i vii kwɔ i nungkwɔ a tonungɓǝ. <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />Bakwɔ ɓǝ i naɓǝ ɓa ibǝing lalangǝ i Viikwɔ Dangbang a wɔtthǝ kwɔ u wuo mangǝn ya nung i nungvii lǝ. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />Kwɔ yayuu dǝna gei angǝ, &lt;&lt;Nung ǝndǝi tǝm nǝkwam langkwoi kang ɗing,&gt;&gt; yang dang tthǝ ɓua a tǝi! A wuo loi thǝmtthǝ mangǝn tthǝzii kwɔ yisi ya si yui dǝna lǝ ɓǝ, yang yayuu sobbu. <verse eid="1TH 5:3" /><verse number="4" style="v" sid="1TH 5:4" />Kwoi ɓǝ, ya young ɓi, ɓǝ dang bǝthǝl lǝu, langkwoi bǝ Vii ɓǝ tǝi ɓǝ dang bǝthǝl mangǝn ya nung i lǝu. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />Ɓǝ ǝndǝi ǝn yayuu kwɔ ǝn a bǝ bǝi a kaikai, yakwɔ ǝn a dang fuh ɓǝ. Ɓi ǝn a bǝ nungvii ko bǝthǝl lǝu. <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />Nungkwɔ yang, bǝ nǝɓi lonunglo mangǝn sua yakwɔ thǝ; ɓi ǝǝ nǝki dǝɓi muo loɓi. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />Ən nungvii kwɔ yayuu dǝna lonunglo tthǝ; ǝn nungvii nungkwɔ dǝi nwamin i fǝr. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />Kwoi ɓi ǝn a dang fuh, langkwoi yang ɓi muo lo ɓi. Ɓi li bǝ dǝnyitthǝ bǝ yiɗi bǝi tthǝɓi lǝ gyǝn, langkwoi bǝ dǝnyitthǝ i bǝ sob lo mangǝn nung bailo ɓui. <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />Fuh mko ɓi yangbǝ ɓi tangzuii tthǝ nyi gu lǝu, kwoi yangbǝ ɓi tǝi bǝ sob lo tthǝ Dangbang ɓi Yeso Kristi, <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />kwɔ u ɓui lǝ baɓi yangbǝ ɓi ǝǝ i ulǝ, ko ɓi i nwongǝi ko ɓi ɓumɓui kwɔ nǝ u wuo ɓǝ. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />Yang langkwoi nungkwɔ yang ɓa dǝ tthǝ nyimmi lǝtha ɓa nwong tha, manungkwɔ lakwɔ dǝɓa toɓǝ.<verse eid="1TH 5:11" /></para>
  <para style="s">Bǝ Nanatthǝnung Asua I Bǝ Gumbǝi</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />Ya young ɓi, dǝɓi yamɓǝ, ɓa dǝ angǝ a la langǝ i lǝ yakwɔ dǝna to nung to dang ɓǝ ɓǝ, yakku ɓǝ yakwɔ dǝna oɓǝlǝ si langkwoi dǝna naɓǝ natthǝ nunglǝi ya Kristǝ ɓǝ. <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />Ɓa ji angǝ a i bǝ yiɗi bǝi lǝ ba nung to kwɔ dǝi toɓǝ. Ɓa ǝǝ dang tthǝla ɓua ɓǝ.<verse eid="1TH 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14" />Ya young ɓi, dǝɓi yamɓǝ, ɓa gub ɗuogsui yakwɔ dǝna ǝǝ nǝkwam ɓǝ, ɓa dǝ tthǝnyimmi lǝ yakwɔ dang nyiǝ yangǝu ɓǝ, ɓa nwong yakwɔ tthǝi muanni ɓǝ, ɓa tthǝb nyitthǝ yayuu ǝndǝi. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />Ɓa dǝ kiggǝ ɓǝ bǝ yuu akun kwai nwathan nung a ɓko i nung a ɓkothǝ, kwoi lona ǝndǝi ɓa dǝ dang wa ɓǝ ɓa to nung a langǝ i lǝ thatthǝ langkwoi i yayuu ǝndǝi.<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />Ɓa ǝǝ dang bǝ lǝtthǝla vii ǝndǝi, <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />Ɓa pinwa vii ǝndǝi, <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />ɓa dǝ angǝ a dang nungkwɔ tonung ǝndǝi ɓǝ. U nungɓǝ kwɔ Fuh dǝna yidɗi tthǝ ɓǝlǝ dang nwongǝi ɓǝ dang tha i Kristi Yeso.<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />Bǝ ɓa nan Ɓyang a Langǝ i gi Fuh thǝ; <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />bǝ ɓa la bǝ gei ba a tthasi kwɔ wuo thang Fuh ɓǝ thǝ. <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />Ɓa na nung ǝndǝi: ɓa munatthǝ nungkwɔ lǝ a langǝ i ɓǝ <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />Ɓa kang nunglǝi Mullub kwɔ ǝndǝi.<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />Kaso Fuh kwɔ dǝɓi bǝ ǝǝ a langǝ i kwɔ mab ɓǝ nungkwɔ ǝndǝi u dǝɓǝ matthǝ ɓyang ɓǝ, killǝng ɓǝ i tthǝ ɓǝ-tthǝ nung a ɓko bǝ wuo gi Dangbang Yeso Kristi. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />Yuu kwɔ lubǝi ɓǝ kwɔ u to ɓǝtthǝ, bakwɔ u ǝn ya dǝnyitthǝ ɓǝ. <verse eid="1TH 5:24" /><verse number="25" style="v" sid="1TH 5:25" />Ya young ɓi, langɓǝ ɓa pinwa lǝ baɓi.<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />Ɓa gum ya dǝ ba a langǝ i tthǝ i bǝ kumbǝi a langǝ i.<verse eid="1TH 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27" />Dǝmmǝn gei ɓǝ i ttha gi Fuh ɓa than nungvullǝ kwɔ lǝ ya dǝ ba a langǝ i tthǝ ǝndǝi.<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />Nung a langǝ i gi Dangbang Yeso Kristi ɓi ǝǝ i ɓǝlǝ.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>