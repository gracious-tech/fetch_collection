<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- MUNGA BIBLE TRANSLATION PROJEC</book>
  <para style="h">2 Timitawos</para>
  <para style="toc1">Nungvullǝ Gi Bulus A Nung Rabbu Sua Timitawos</para>
  <para style="toc2">2 Timitawos</para>
  <para style="toc3">2 Ti</para>
  <para style="mt2">Nungvullǝ Gi Bulus A Nung Rabbu Sua</para>
  <para style="mt1">TIMITAWOS</para>
  <para style="imt">Bǝ Gabnung</para>
  <para style="ip">
    <char style="bk" closed="false" />
  </para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />Ɓang Bulus, ya nwatummi gi Kristi Yeso i bǝ yiɗi gi Fuh, i tummu yangbǝ wuu gei ba nwongǝi kwɔ ɓi tǝi tthǝ bǝ kǝbtha lo ɓi i Kristi Yeso ɓǝ-<verse eid="2TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TI 1:2" />Yuim, Timitawos,</para>
  <para style="p" vid="2TI 1:2">Fuh Daa ɓi i Kristi Yeso Dangbang ɓi da nung a langǝ i, nungzuii, i bǝ ǝǝ tthǝla.<verse eid="2TI 1:2" /></para>
  <para style="s">Bǝ Kha Fuh I Bǝ Nyimtthǝ Bǝi</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />Dǝmǝn kha Fuh, kwɔ dǝmǝn muo suo dang wam kaitthǝ ɓǝ, manungkwɔ ya bǝba to ɓǝ. Dǝmǝn khko vii ǝndǝi nungvii i dang fuh kwɔ dǝmǝn nhǝma dang bǝ pinwa ɓǝ. <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />Dǝmǝn nhǝm ba mungnung mǝ, langkwoi dǝmǝn yiɗi bǝ ɓyǝa i nunglǝ, yangbǝ ǝn lǝ tthǝla. <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />Dǝmǝn nhǝm ba lo bǝ dǝ ba a langǝ itthǝ mǝ tthǝ Fuh kwɔ, bǝ dǝ ba a langǝ i manungkwɔ ka mǝ Loyis i naa mǝ Yunis langkwoi ɓǝ. Manungɓǝ langɓǝ tthǝmǝ. <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />Manungkwɔni yang dǝmǝn o nyitthǝ bǝ dǝ nungdǝ gi Fuh kwɔ matthǝ kwɔ vii kwɔ ǝn dǝ na lomǝ ɓǝ. <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />Bakwɔ Fuh dǝ ɓi Ɓyang lǝtthǝ vulli lǝu; manungkwɔni yang, Ɓyang gu dǝ ɓi ttha, i bǝ yiɗi bǝi, i bǝ muo lo.<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />Bǝ ɓa lǝ tthǝku thǝ, langkwoi, tthǝ bǝ dǝ shǝdǝ gi Dangbang ɓi; langkwoi bǝɓa lǝ tthǝkkum thǝ, ɓang ya pursǝna lǝ ba gi Kristi. Manungkwɔni yang, a lǝi bǝ dǝi mǝ bǝ to zuii lǝ ba bǝ gei nwaba a langǝ i, manungkwɔ Fuh da ttha angǝ a to ɓǝ. <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />Fuh nwong ɓi langkwoi u lubǝi ɓi yangbǝ ɓi mǝrrǝmlǝ ya yuu gu, ǝnba nungkwɔ ɓi to ɓǝlǝu, kwoi ǝn nungkwɔ dǝu yiɗi ɓǝ i nung a langǝ i gu. U dǝ ɓi nung a langǝ i gu tthǝ Kristi Yeso nwunibǝ bǝ baipi lona, <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />kwoi lakwɔ Fuh iɓilǝ ba ɓǝtthǝ nungpangbǝi lǝ babǝ wuo gi ya sob lo, Kristi Yeso. U tthǝmlǝ ttha ɓua langkwoi tthǝ bǝ gei nwaba a langǝ i langkwoi u ilǝ nwongǝi nungpangbǝi.<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />Fuh imlǝ lǝ ya nwatummi gu i ya nanatthǝnung yangbǝ wung gei ba afu gu, <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />lakwɔ ǝn ba ɓǝkwɔ nungkwɔ dǝmǝn to zuii lǝ bko. Lakwɔ tthǝ dang nyim nyimtthǝ, ba kwɔ ǝn ibǝi yuu kwɔ ǝn gwab ba gu ɓǝng, lakwɔ ǝn ibǝi u dǝi nyimtthǝ tǝlǝ vii nungkwɔ u dǝm dang nam ɓǝ. <verse eid="2TI 1:12" /><verse number="13" style="v" sid="2TI 1:13" />Ɓa muo ba a langǝ i kwɔ ǝn na ɓǝ natthǝ kwɔ nyimtthǝ, lǝ bǝ gei nwa ba ɓa munatthǝ, langkwoi ɓa dǝilo ba a langǝ i i bǝ yiɗi bǝi kwɔ ǝn aɓi kwɔ bǝ kǝbtha bǝ yikun i Kristi Yeso. <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />Dang ttha gi ya Ɓyang a Langǝ i, kwɔ ǝǝ dang ɓi kwɔ, ɓa to nung a langǝ i kwɔ i gei ɓǝ tthǝ kwɔ ɓǝ.<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />Ɓa ibǝi yayuu ǝndǝi losua Asiya, i Fijalas i Harmajanas, i tutha i ɓang lǝng.<verse eid="2TI 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 1:16" />Dangbang tthǝ yang ɓyǝa nungzuii ya gwoi gi Onisifaras, ba kwɔ dǝnnu ɓim lona kwɔ ǝndǝi. U lǝ tthǝkku bǝ tthǝbbǝm pursǝna i sarka lǝu, <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />kwɔ lakwɔ vii ǝndǝi kwɔ nǝ u wuo Roma yang, dǝnnu ɗu bǝim nǝ u tǝim ɗǝ. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />Dangbang tthǝ yang ɓyǝa nungzuii gu viilǝ kullo! Langkwoi ɓa ibǝ nungkwɔ u tom tthǝ vii kwɔ ɓang dang Afisa ɓǝng.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">Soja Ya Kiggǝ A Langǝ i Gi Kristi Yeso</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />Yuim, lǝ bamǝ, a dǝi nyimtthǝ lo bǝ to nung a langǝ i kwɔ lǝ aɓi tthǝ bǝ kǝbtha ɓi i Kristi Yeso ɓǝ. <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />A lǝi bǝ nanatthǝnung kwɔ ǝn nanatthǝ tthasi yayuu kpaatthǝ kwɔ, ta gei lǝ yayuu a langǝ i tthǝ, yangbǝ i lǝi tǝi nanatthǝ lǝ yakun langkwoi.<verse eid="2TI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3" />A lǝi nunglǝi bǝ to zuii amǝ, mangǝ ǝn soja a langǝ i gi Kristi Yeso. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />Ya soja a kwɔ lo nung to dǝna to nung to yang bǝ dǝ tthǝla lǝ yakku gu kwɔ lǝiu dang nung to ɓǝ u lǝi nung to gu u nalǝ tha i nung to yakwɔ ǝn ya soja lǝu ɓǝu. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />Ya nyim nung surdum muo nung busoni guu nǝ u muo lo lǝi bǝ surdum gu matthǝ ɗǝ <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />Ya nunglǝbi kwɔ dǝna lǝbnung i tthǝ nyimmi gu yang u ɓǝr min gu nungsi. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />A nhǝm ba lo nungkwɔ dǝmǝn geiɓǝ, bakwɔ Dangbang a da bǝ ibǝ nung lo ǝndǝi. <verse eid="2TI 2:7" /><verse number="8" style="v" sid="2TI 2:8" />A nhǝm Yeso Kristi, kwɔ i ǝrrǝu lǝ bǝ ɓui ɓua kwɔ, kwɔ u ǝn bǝba gi Dawuda ɓǝ, kwɔ ǝn naɓǝnatthǝ dang ba gi Fuh ɓǝ. <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />Bakwɔ dǝmǝn gei ba gi Fuh, Dǝmǝn to zuii langkwoi i tthǝbǝm i sarka mangǝttǝn ɓang ǝn ya nung a ɓko. Kwoi i tthǝb ba gi Fuh lǝu, <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />Langkwoi lakwɔ dǝmǝn nyimnyi lo nung ǝndǝi lǝ ba yayuu gi Fuh kwɔ mko ɓǝ, yangbǝ i tǝi bǝ sob lo kwɔ a wɔ tthǝ Kristi Yeso kwɔ a wullǝ ghaali a ɗing ɓǝ. <verse eid="2TI 2:10" /><verse number="11" style="v" sid="2TI 2:11" />Nungkwɔ ǝn ba a langǝ i:</para>
  <para style="q1" vid="2TI 2:11">&lt;&lt;Nǝ ɓi ɓui suatha i ulǝ,</para>
  <para style="q2" vid="2TI 2:11">langkwoi ɓi ǝǝ i ulǝ.<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />Nǝ ɓi ǝǝ lo bǝ nyimnyi,</para>
  <para style="q2" vid="2TI 2:12">Yang ɓi lo yigwoi i u.</para>
  <para style="q1" vid="2TI 2:12">Nǝ ɓi yǝrnwa tthǝu,</para>
  <para style="q2" vid="2TI 2:12">yang langkwoi u yǝrnwa tthǝ ɓi.<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />Nǝ ɓi yangǝu i bǝ dǝnyitthǝu lǝ,</para>
  <para style="q2" vid="2TI 2:13">U ǝn yuu kwɔ ɓi dǝ nyitthǝu lǝ ɓǝ,</para>
  <para style="q2" vid="2TI 2:13">bakwɔ u nyimnwa tthǝu i nkolǝu.&gt;&gt;<verse eid="2TI 2:13" /></para>
  <para style="s">Ya Nung To A Langǝ i Kwɔ Fuh Mui Ɓǝ</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />A o nyi le yayuu mǝ tthǝ, langkwoi a gub ɗuogsui dang ɗuǝn Fuh bǝ i ɓuob vǝm dang ba thǝ. To nung a langǝ iu, dǝna ɓanglǝ yakwɔ dǝna lǝ baɓǝ ɓǝ. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />A dǝ lomǝ a to nung a langǝ i ɗǝgsi Fuh, mangǝn ya nung to kwɔ lǝ tthǝkuu ɓǝ, yuu kwɔ dǝna nanatthǝ ba a langǝ i gi Fuh ɓǝ. <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />A tutha i bǝ gei ba a nǝkwam i ba sullǝ, kwɔ a tog yayuu a tǝ tutthǝ tthǝ Fuh ɓǝ. <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />Bǝ nanatthǝnung kullo mangǝn gong nung lua kwɔ dǝna tang nyamtthǝ ɓǝ. Yaɓǝi rab kwɔ nanatthǝnung manungkwɔni kwɔ ǝn Himinayas i Filitas. <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />I la nunglǝi a langǝ i dǝnni ɓanglǝ bǝ dǝnyitthǝ gi ya dǝ ba a langǝ i tthǝ Fuh dǝnni gei angǝ, i osi i ǝrr lǝ yayuu bǝ ɓui ɓuang.<verse eid="2TI 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 2:19" />Lakwɔ ba gi Fuh kwɔ mangǝ ǝn bǝ li pi kǝm kwɔ Fuh li matthǝ kwɔ thǝuriu; langkwoi lolǝ i vullǝ bakwɔ angǝ:&lt;&lt;Fuh ibǝ yakwɔ lǝ abo ɓǝng&gt;&gt; langkwoi&lt;&lt;yakwɔ gei angǝ i ǝn a bǝ Dangbang kwɔ i mǝrrǝm i yitthǝ nung a ɓko gi.&gt;&gt; <verse eid="2TI 2:19" /><verse number="20" style="v" sid="2TI 2:20" />Dang gwoi angǝ a lǝ taso tthǝ i daro nǝkun kun: yakun i mabbǝi i ɓui a yummi i ɓui a vǝrrǝm, yakun i kong kab yakun i suab; yakun dǝnni to lǝ ɓang angǝ a, yakun i to lǝ ɓang a tuab. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />Yuu kwɔ ɗiggǝ tthǝu kaitthǝ yitthǝ bǝ to mullub, yang i tou lǝ nung a langǝ i, bakwɔ i dǝ loi lǝ yikku gi dǝnni tou nung a langǝ i tthǝ ɓǝ, ɓa dǝi matthǝ ɓa to nung a langǝ i.<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />Ɓa yitthǝ bǝ to kiggǝ munthang, yang ɓa to nung a langǝ i, bǝ dǝ ba a langǝ i, bǝ yiɗi bǝi, i bǝ ǝǝ latthǝ, lotha i yakwɔ i dang wa a langǝ i Dangbang lubǝi wuo nwongǝi ɓǝ.<verse eid="2TI 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2TI 2:23" />Langkwoi ɓa yitthǝ sullǝ i bǝ nyimnwa a ɓko; ɓa ibǝi dǝna wullǝ bǝ kwanwa.<verse eid="2TI 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2TI 2:24" />Kwɔ ɓǝlǝ ya thǝb gi Dangbang, bǝ ɓa kwanwa thǝ. Ɓa to nung a langǝ i tthǝ nung ǝndǝi, nung a langǝ i i ya nanatthǝnung a nyitǝmmi,<verse eid="2TI 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2TI 2:25" />yuu akwɔ i kiggǝ a langǝ i langkwoi a mab yuu akwɔ lko ɓǝ, lko yakun Fuh a mǝrrǝm mu wuu dǝ ba a langǝ i langkwoi wuu ibǝ ba a langǝ i.<verse eid="2TI 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2TI 2:26" />Yang langkwoi i kwoi i wuu dang kiggǝi yang i idang tarko gi Mungkullum, kwɔ mui langkwoi mǝrrǝmǝi dǝnni lǝ ba gu ɓǝ.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">Vii A Tthasua</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />A nhǝm bǝ to zuii tthǝ lona a tthasua. <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />Yayuu a yiɗi loi, i ya ɗǝlak, ya lo angǝ a, ya ɓuasui; ya dal ɗyǝam, i to nung to i ba yayuu giu, i to sakkou, i la nunglǝi Fuh;<verse eid="2TI 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 3:3" />i yiɗi yayuu, i ɓyǝa nung zuiiu, ya ɓanglǝ ɗuǝn, ya ǝrr lǝ ba, bǝthǝl, i la nung a langǝ i;<verse eid="2TI 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2TI 3:4" />ya tang gǝkkam, yakwɔ kiggǝi yangǝu ɓǝ, ya lǝi lo angǝ a; dǝnni yiɗi bǝ lǝ tthǝla pǝl Fuh; <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />dǝi lǝi loi nungwambǝi mangǝn yayuu Fuh, kwoi i dǝi yǝrnwa tthǝ bagi ttha bagi Fuh yangbǝ mǝrǝmǝi. Bǝ ɓa kǝbtha lo i ilǝ thǝ.<verse eid="2TI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6" />Yakun dang ǝi dǝna ɓuu dǝna tǝ dang gwoi yayuu dǝnni muo kiggǝ yasi akwɔ sulǝ tthǝ kwɔ nung a ɓko mui kwɔ langkwoi i ǝn ya ɗǝlak ɓǝ. <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />Yasi akwɔ vii ǝndǝi dǝnni yiɗi bǝ nanung kwoi i ɓuan i ibǝ ba a langǝ i ɓǝu.<verse eid="2TI 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 3:8" />Manungkwɔ Yannes i Yambirisu ǝrrlǝ kiggǝ Musa, manungkwɔni yayuu akwɔ la ba a langǝ i ɓǝ-yayuu akwɔ nhǝm ba a a ɓko langkwoi i o dang bǝ dǝnyitthǝ ɓǝ.<verse eid="2TI 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 3:9" />Kwoi i tǝ tuu tthǝu, bakwɔ yayuu a ɓyǝa kiggǝ a ɓko gi ɓǝ. Manungɓǝni to nung to i Yannes i Yambirisu.<verse eid="2TI 3:9" /></para>
  <para style="s">Bǝ Alo Ba</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />Kwoi ɓa muo sua bǝ nanatthǝ nungǝm mǝng, i kiggǝm, i nungkwɔ dang nwongǝim ɓǝ; a dǝ kiggǝ tthǝ bǝ dǝnyitthǝ nungǝm mǝng, i nyi a langǝ im, i bǝ yiɗi bǝi, i bǝ nyim nyiim, <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />i bǝ dǝ zuii, i bǝ to zuii. Ɓa ibǝ nungkwɔ tom dang Antakiya, i Ikoniya, i Listira, bǝ dǝ zuii a nyimmi ǝn nyimnyi tthǝ! Kwoi Fuh nwongǝm nai lǝ ǝndǝi.<verse eid="2TI 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2TI 3:12" />Manungɓǝni yuu akwɔ ǝndǝi dǝna yiɗi bǝ ǝǝ dang nwongǝi gi bagi Fuh i bǝ kǝbtha lo i Kristi Yeso yang i duu zuii ǝn dǝ; <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />langkwoi ya mulub i ya ɗambǝi vii ǝndǝi a ǝǝ dang nung a ɓko a tuab tǝlǝ angǝ a, dǝnni ɗam yayuu dǝnni ɗam loi.<verse eid="2TI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 3:14" />Kwoi mǝ amǝ Timitawos, a dǝi lo ba a langǝ i ɓǝkwɔ i nanatthǝ ɓǝ a muo nyimtthǝ. A ibǝ ya nanatthǝ nungǝng, <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />yang a nhǝm vii kwɔ mǝ ǝn munthang a tuab, a ibǝ ba gi Fuh a langǝ i, kwɔ a dǝɓǝ yiggǝi kwɔ a tǝɓǝ lǝ bǝ sob lo tthǝ ba a langǝ i dang Kristi Yeso ɓǝ.<verse eid="2TI 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 3:16" />Dang ba gi Fuh ǝndǝi ǝn nwongǝi langkwoi maɗing lǝ bǝ nanatthǝ ba a langǝ i, dǝna nan bǝ galnung, dǝna mab bǝ to nung a ɓko, langkwoi dǝna lak yuu yang to nung a langǝ i bǝ ǝǝ gu, <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />manungkwɔ ni yangbǝ mab yuu akwɔ to nung to gi Fuh ina nung to ɓǝ langkwoi tǝ dang bǝ to nung to ɓǝ nyimtthǝ yangbǝ to nung to ɓǝ la langǝ i.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />Ɗǝgsi Fuh i Kristi Yeso, kwɔ ato kwan lǝ ya nwongǝi i ya ɓuiɓua kwɔ, langkwoi bakwɔ dǝu wuo bǝ lo yigwoi, nungkwɔ dǝm gei ɓǝ geigǝ <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />ɓa gei nwaba a langǝ i, ɓa ɗuong nungɓǝ bǝ geiu (ko lona to ko to lǝu), ɓa mǝrrǝm lo nyi, ɓa lag, kwɔ dǝ ɓa nanatthǝ ibǝ tthǝb nyitthǝ. <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />Bakwɔ lo na dǝna wɔ kwɔ yayuu lǝ bǝ nanatthǝ nung a langǝ iu ɓǝ, kwoi i muo u nungkwɔ dǝi yiɗi ɓǝ langkwoi i tǝi ya nanatthǝ nung kwɔ a gei nungkwɔ tthǝ dǝnni yiɗi bǝ lǝu ɓǝ. <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />I mǝrrǝm i yitthǝ bǝ lǝ ba a langǝ i i dǝ kiggǝi tthǝ mumuani. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />Kwoi ɓaɓǝ ɓa muo lo ɓǝ dang nung ǝndǝi, ɓa to nung to ya gei nwaba a langǝ i, langkwoi ato nung to mǝ mangǝn thǝb gi Fuh.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />Ɓang abo, lona wɔm tthǝng kwɔ i nyǝkgǝm lǝ nungɓǝ; lona wɔm tthǝng kwɔ mǝn yitthǝ longwam ɓǝ. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />Ən to nung a langǝ i dang bǝ to nyim nungǝm, Ən alo bǝ surdumǝm la langǝ i, langkwoi Ən dǝilo bǝ dǝnyitthǝ nungǝm. <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />Langkwoi lakwɔ nungbusɔni bǝ ilo bǝ dǝiu matthǝ i Fuh lǝ, kwɔ Dangbang, yato kwan a langǝ i, a dǝm villǝ kullo ɓǝ- langkwoi ǝn ɓang ɓuolǝu, kwoi yakwɔ ǝndǝi kiu ibǝ yiɗi bǝi u fuk ɓǝ.<verse eid="2TI 4:8" /></para>
  <para style="s">Ba Nwuo</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />A ɗuong nungmǝ a wɔ suam thǝmtthǝ. <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />Dimas dǝna yiɗi nung longwam kwɔ u lam, u pa u tǝ Tasalonika. Karaska abo tǝ Galatiya, langkwoi Titus tǝ Dalmatiya. <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />Luka ɓuo i ɓanglǝ. A tǝi Markus a wɔ suatha i ulǝ, bakwɔ u ɓuan u nwongǝm dang nung to. <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />Ən tum Tikikus tǝ Afisa. <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />Kwɔ nǝ dǝmma wɔ, a wɔlǝ nunglitthǝm a gwam na kwɔ ǝn yitthǝ Taruwasa i Karbus ɓǝ; a wulǝ nungvullǝ zuǝ langɓǝ, akwɔ dǝi kuluam ɓǝ.<verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />Iskandari ya to nung to ɓui tom nung ɓua; Fuh a vou tthǝ manung nungkwɔ u to ɓǝ. <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />Ɓǝ i na ɓǝ ɓa dǝ kiggǝ tthǝu, bakwɔ dǝu la ba ɓi nyimɗing.<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />Yuu akun yangǝu dǝi tthangǝm kwɔ ǝn gei nwam la nwasiu ɓǝ; yayuu lam ǝndǝi. Kaso bǝ Fuh mǝrrǝm mual tai lǝ thǝ! <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />Langkwoi Dangbang ǝǝ i ɓanglǝ langkwoi u dǝm tthǝnyimmi, yangbǝ ǝn ɓuan ǝn gei nwaba a langǝ i ǝndǝi lǝ yakwɔ ǝn ya Yahudawa lǝu ɓǝ; langkwoi i nwongǝm nwa zua. <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />Langkwoi Fuh a imlǝ na ya mullub a lǝim latthǝ tǝlǝ bǝ lo yigwoi Wayi. Ghaali ǝn abo laɗing langkwoi laɗing! Dǝitthǝ manungɓǝ.<verse eid="2TI 4:18" /></para>
  <para style="s">Bǝ Alo Bǝ Gumbǝi</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />Dǝm gum Bilkisu i Akila i ya dang woi Onisifaras. <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />Arastas ǝǝ Koranti, langkwoi ǝn yiǝ Tarofimas dang Militas, bakwɔ tthǝu lko ɓǝ. <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />A ɗuong nungmǝ a wɔ nwuni bǝ wakong.</para>
  <para style="p" vid="2TI 4:21">Aubulus dǝna gumbǝi mǝ, i Budis, i Linas i Kalkodiya, langkwoi i sua ya Krista ǝndǝi. <verse eid="2TI 4:21" /><verse number="22" style="v" sid="2TI 4:22" />Dangbang ǝǝ i ɓyang ɓǝ.</para>
  <para style="p" vid="2TI 4:22">Nung a langǝ i gi Fuh ǝǝ i ɓǝ ǝndǝi.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>