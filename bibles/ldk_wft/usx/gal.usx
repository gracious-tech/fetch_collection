<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">Ya Galantiyawa</para>
  <para style="toc1">Nungvullǝ Gi Bulus Sua Ya GALANTIYAWA</para>
  <para style="toc2">Galantiyawa</para>
  <para style="toc3">Ga</para>
  <para style="mt2">Nungvullǝ Gi Bulus Sua ya</para>
  <para style="mt1">GALANTIYAWA</para>
  <para style="imt">Bǝ Gabnung</para>
  <para style="ip">Kwɔ i baipi bǝ gei nwa ba a langǝ i lo Yeso langkwoi dang yakwɔ ǝnya Yahudawa lǝu kwɔ, bǝ ɓib ba ǝrr angǝ yuu a tonungto i zuu gi Musa yangbǝ ǝlǝ ya muo sua Fuh a langǝ i. Bulus nyim nwa angǝ maliu yangǝu- angǝ la langǝ i, nunglǝi a langǝ i dang Kristi nungɓǝlǝ bǝ dǝnyitthǝ, kwɔ i mablǝ yayuu ǝndǝi i dǝ matthǝ lǝ Fuh. Kwoi dang yayuu ya dǝba a langǝ i Galatiya, losua Romawa dang Asiya atuab, yakun tthǝ la ba Bulus dǝnni lǝi angǝ yuu langɓǝ a tonungto i zuu gi Musa yangbǝ ǝǝlǝ yuu gi Fuh a langǝ i.</para>
  <para style="ip">Bulus vullǝ nungvullǝ sua ya Galantiyawa yangbǝ kwoilǝ bǝ dǝnyi a langǝ i i bǝ tonungto lǝ yayuu kwɔ ki i bǝ nanatthǝ nung pǝllǝ kwɔ ɓǝ. Bulus bai piu i bǝ geiu angǝ i ǝnya nwatummi gi Yeso Kristi. U lilo tthǝ angǝ bǝ lubǝi gi i ǝǝlǝ ya nwatummi gi Yeso wuo bǝgǝ Fuh, tthǝn tthǝ ttha gi yuu lǝu, langkwoi nwatummi tthǝn sua yakwɔ ǝnya Yahudawa lǝu ɓǝ. Yang u gei ba lo nyimnwa kwɔ angǝ tthǝn tthǝ bǝ dǝnyi ɓuo i mab yayuu lalangǝ i tthǝ Fuh. Dang bǝ al lo Bulus gei angǝ ya kiggǝ ya muo sua Fuh a wɔ nǝkwam tthǝ bǝ yidɗi bǝi kwɔ ǝrr tthǝ bǝ dǝnyitthǝ dang Kristi ɓǝ.</para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />Nungvullǝ kwɔ ǝn ɓang Bulus vullǝ, kwɔ bǝ lubǝim lǝ ya nwatummi gi Yeso wuo na thayuu ko nunglǝi gi yuu lǝuɓǝ, kwoi bǝgǝ Yeso Kristi langkwoi i Fuh kwɔlǝ Daa, kwɔ ǝrrǝu lǝ bǝ ɓuiɓua ɓǝ. <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />Ya dǝ ba a langǝ i kwɔ i ɓanglǝ kǝbtha lo i ɓanglǝ dǝna gumbǝi ya kǝm Fuh Galatiya:<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />Kaso Fuh Daa ɓi langkwoi i Dangbang Yeso Kristi dǝɓǝ nung a langǝ i bǝ ǝǝ a langǝ i.<verse eid="GAL 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4" />Yangbǝ iɓi lǝ dang wam nung to Mungkullum kwɔ, Kristi dǝ lolǝ ba nung a ɓko ɓi, dang bǝ to nung to i nungkwɔ Fuh Daa ɓi dǝna yiɗi ɓǝ. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />Ghaali ǝn a bǝ Fuh laɗing langkwoi laɗing! Dǝitthǝ Manungɓǝ.<verse eid="GAL 1:5" /></para>
  <para style="s">Nwaba A Langǝ i Kun</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />Lom dǝna fǝm tthǝ ɓǝlǝ! Sua tulǝu dang tthǝ dǝɓa la yuu akwɔ lubǝi ɓǝ i nung a langǝ i gi Kristi ɓǝ, langkwoi dǝɓa muo nwa ba a kun. <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />Lalangǝ i, &lt;&lt;nwaba a langǝ i akun yangǝu,&gt;&gt;kwoi ǝn gei nungkwɔ bakwɔ yaku tthǝ kwɔ dǝna ǝǝrlǝ kiggǝ ɓǝ dǝna yidɗi bǝ prǝm nwa ba a langǝ i gi Kristi ɓǝ. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />Kwoi ko ɓi ko ya nwatummi ǝrr wayi lǝ a gei ɓǝ nwaba a kuntthǝ i nung tthǝu lǝ pǝl akwɔ ɓi gei ɓǝ tthǝ kwɔ, kaso Fuh thǝu dang kong ɓua lua! <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />Manungkwɔ ɓi gei la nwasiu ɓǝ, langkwoi lakwɔ dǝm gei akun: nǝ yuu akun gei ɓǝ nwaba a kuntthǝ i nungtthǝu lǝ pǝl akwɔ ɓa muo kwɔ, kaso Fuh thǝu dang kong ɓua lua!<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />Nungkwɔ lakwɔ mangǝttǝn dǝm yiɗi yayuu gwab ba mǝ? La langǝ i nilǝu! Nungkwɔ dǝm yiɗi kwɔ nungɓǝ lǝ bǝ gwabbǝi gi Fuh! Dǝm yiɗi bǝ dǝ tthǝla lǝ yayuu o? Nǝ dǝm yiɗi bǝ to manungɓǝ, yang krǝ ǝn ǝlǝ thǝb gi Kristi lǝu.<verse eid="GAL 1:10" /></para>
  <para style="s">Bǝ Mǝrrǝm Gi Bulus Lǝ ya Nwatummi</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />Ɓa dǝisua ǝn gei ɓǝtthǝ, ya ǝnthǝm, geigǝ nwaba a langǝ i kwɔ dǝm gei kwɔ ǝn nung mabbǝi gi yuu lǝu. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />Ən muo na thayuu a kunlǝu, ko langkwoi ǝn yuu akun nam natthǝ. Ən Yeso Kristi i nkolǝ tam natthǝ.<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />I gei ɓǝ nunglǝi kwɔ dǝm to vii kwɔ ɓǝng kwɔ ǝn dǝ nyimtthǝ nunglǝi nung wabbǝi ya Yahudawa ɓǝ, nunglǝi kwɔ ǝn dǝ zuii lǝ ya kǝm pinwa ǝn ɓyǝa nungzuii gu ɓǝ langkwoi ǝn ɗuong nungǝm yangbǝ ǝn ɓanglǝ ɓǝ. <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />Ən osi yakun kpaatthǝ dang ya Yahudawa ya kallǝm dang bǝ to nung to nung wabbǝi ya Yahudawa, langkwoi ǝn dǝ tthǝm tthǝ nunglǝi ya bǝba ɓi.<verse eid="GAL 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15" />Kwoi Fuh dang nung a langǝ i gu mkom nwuni bǝ i sim, langkwoi u lubǝim yangbǝ ǝn tou nungto tthǝ. Langkwoi u yidɗi <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />yangbǝ u tamnatthǝ yuiu, yangbǝ ǝn gei nwaba a langǝ i bagu lǝ yakwɔ ǝn ya Yahudawa lǝu ɓǝ, ǝn ɓib yuu akun lǝu, <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />ko ǝn tǝ Urshalima yangbǝ tǝn ɓyǝa yakwɔ lǝ ya nwatummi bǝ ɓang ɓǝlǝu. Niyang, Ən pa nung kun ǝn tǝ Larabawa, langkwoi ǝn kwoi ǝntǝ Dimaska. <verse eid="GAL 1:17" /><verse number="18" style="v" sid="GAL 1:18" />Yang tthasua ttha tai, ǝn tǝ Urshalima yangbǝ tǝn lǝ ba nwa kefas langkwoi ǝn ǝǝ i ulǝ bo li. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />Ən ɓyǝa ya nwatummi a kun lǝu ǝn Yakubu ɓuo, young gi Dangbang.<verse eid="GAL 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20" />Nungkwɔ ǝn vullǝ kwɔ ǝn ba a langǝ i. Fuh ibǝing dǝm kǝbpǝllǝ lǝu!<verse eid="GAL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21" />Tthasua nungkwɔ ǝn tǝ bǝi yakun dang Suriya i Kilikiya. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />Lona lǝ kullo ya kǝm pinwa gi kristi kwɔ dang Yahudiya kwɔ im la langǝ i lǝu. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />I iǝn bǝ nungkwɔ ya kun dǝna gei ɓǝ ɓuo: &lt;&lt;Yiɓǝi kwɔ zǝǝ dǝna dǝɓi zuii kwɔ lakwɔ dǝna gei ba bǝ dǝnyitthǝ kwɔ viikwɔ dǝu yidɗi bǝ ɓangǝu lǝ ɓǝ!&gt;&gt; <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />Langkwoi nungkwɔ dǝi kha Fuh lǝ bam.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">Bulus I Sua Ya Nwatummi</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />Tthasua ttha sob iu nai kwɔ pa kwɔ ǝn kwoi suam ǝntǝ Urshalima i Barnabas, Ɓitǝ suatha i Titus langɓǝ. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />Əntǝ bakwɔ Fuh tamnatthǝ dang muani angǝ ǝn tǝ. Ən ǝǝ i ya dǝ kab nwa nunglǝ bǝ pyǝa ǝn gei nwaba a langǝ i tthǝ kwɔ dǝm gei lǝ yakwɔ ǝn ya Yahudawa lǝu ɓǝ. Ən yiɗi nung tom kwɔ pa kwɔ ko akwɔ lakwɔ ɓanglǝ lǝu. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />Titus ya to nung to i ɓanglǝ kwɔ, ko kwɔ u ǝn ya Helinawa, i toulǝ ttha ba bǝ ɓǝrnwa ɗuǝ lǝu, <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />ko kwɔ yakun dǝna yiɗi angǝ i to manungɓǝ. Dǝnni lǝi loi mangǝ i ǝn ya dǝ ba a langǝ i, yayuu kwɔ brǝm tǝ dang ɓi mangǝ ya ɓuu bǝi, yangbǝ i ibǝi bǝ tǝi lo ɓi dang tha i Yeso Kristi ɓǝ. <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />Kwoi ɓi gwabbǝi tthǝ lǝu ko tuab, yangbǝ ɓi dǝba a langǝ i lo nwaba a langǝ i matthǝ lǝ ba ɓǝ.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />Kwoi yakwɔ dǝna ɓyǝa angǝ ǝn ya dǝkab nwa nung kwɔ-ǝn gei nung kwɔ bakwɔ gab lo tthǝm lǝ ko i ǝn ɓǝttǝn a; Fuh to kwan i nung a gwammu- ya dǝkab nwa nungkwɔ, Ən geigǝ, i lilo nung a kun tthǝ bam lǝu. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />Manungɓǝni lǝu, i ɓyǝa Fuh dǝm nung to gei nwaba a langǝ i lǝ yakwɔ ǝn ya Yahudawa lǝu kwɔ, manungkwɔ u dǝ nung to lǝ Bitrus bǝ gei nwaba a langǝ i lǝ yakwɔ ǝn ya Yahudawa lǝu ɓǝ. <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />Bakwɔ i ttha Fuh ǝn mǝrrǝm lǝ ya nwatummi sua yakwɔ ǝn ya Yahudawa lǝu ɓǝ, manungkwɔ Bitrus mǝrrǝm lǝ ya nwatummi sua ya Yahudawa ɓǝ. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />Yakubu, kefas i Yohanna, kwɔ ǝǝ mangǝ ǝn yakku, ibǝi angǝ Fuh dǝm nung to kwɔ; nungkwɔ i gum natha i Barnabas i ɓanglǝ, ǝǝ mangǝ ɓi ǝndǝi kun. Ɓi gwab geigǝ Barnabas i ɓang a to nung to dang yakwɔ ǝn ya Yahudawa lǝu ɓǝ langkwoi i abǝi dang ya Yahudawa. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />Nungkwɔ ǝndǝi dǝnni yiɗi kwɔ angǝ ɓi nhǝm yakwɔ ǝn ya yiɓko dang ǝi lǝ ɓǝ, kwɔ lǝ nungkwɔ dǝm yiɗi bǝ tou ɓǝ.<verse eid="GAL 2:10" /></para>
  <para style="s">Bulus Laba Bitrus Antakiya</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />Kwoi kwɔ kefas wuo Antakiya, i laba gu dang nung yayuu, bakwɔ bagu lko ɓǝ. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />Nwuni bǝ yayuu kwɔ Yakubu tummǝi kwɔ kǝn bǝi ɓǝ, Bitrus dǝna tangnung tang lotha i yakwɔ dǝ ba a langǝ i tthǝ Fuh ǝn ya Yahudawa lǝu ɓǝ. Kwoi tthasua kwɔ yaɓǝi kwɔ kǝn bǝi, u kwoi nǝsua u yiɗi bǝ tangnung tang lotha i yakwɔ ǝn ya Yahudawa lǝu ɓǝ, bakwɔ dǝu lǝtthǝ vulli yakwɔ dǝna yiɗi angǝ ya yuu ɓǝrnwa ɗuǝ ɓǝ. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />Yakun dang ya dǝ ba a langǝ i ya Yahudawa dǝna to mangǝ ǝn ya survulli i Bitrus; langkwoi i Barnabas ǝndǝi muo sua vulli gi. <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />Kwɔ ǝn ibǝi geigǝ i thko nunglǝi juantthǝ manungkwɔ ba a langǝ i nwaba a langǝ i lǝu, Ən gei kefas dang nungǝilǝ ǝndǝi geigǝ, &lt;&lt;Mǝ ǝnya Yahudawa, yirrǝ dǝma ǝǝ mangǝ mǝ ǝn ya kwɔ ǝnya Yahudawa lǝu ɓǝ, mangǝn ya Yahudawa lǝu. Nǝnǝ, yang, ma to ttha lǝ yakwɔ ǝnya Yahudawa lǝu kwɔ i ǝǝ mangǝ ǝnya Yahudawa?&gt;&gt;<verse eid="GAL 2:14" /></para>
  <para style="s">I Nwong Ya Yahudawa I Yakwɔ Ənya Yahudawa Lǝu Kwɔ I Bǝ Dǝnyitthǝ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />La langǝ i, ɓi ǝn ya Yahudawa kwɔ i siɓi lǝ siɓǝ langkwoi ǝn yakwɔ &lt;&lt;Ən ya Yahudawa lǝu kwɔ ya nung a ɓko,&gt;&gt; manungkwɔ dǝnni lubǝi ɓǝ. <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />Yirrǝ kwoi ɓi ibǝi i mab yuu matthǝ i Fuh lǝ tthǝ bǝ dǝnyitthǝ dang Yeso Kristi, ǝn bǝ to nungkwɔ zuu dǝna yiɗi ɓǝlǝu. Ɓi, langɓǝ, ɓi dǝ ba a langǝ itthǝ Kristi Yeso yangbǝ i dǝɓi matthǝ i Fuh tthǝ bǝ dǝnyitthǝ ɓi dang Kristi, langkwoi ǝn nungkwɔ zuu dǝna yiɗi ɓǝlǝu. Bakwɔ yuu akun yangǝu kwɔ i du matthǝ i Fuh i bǝ tonungkwɔ zuu dǝna yidɗi ɓǝu. <verse eid="GAL 2:16" /><verse number="17" style="v" sid="GAL 2:17" />Nǝ, kwɔ dǝɓi yiɗi i dǝɓi matthǝ i Fuh i bǝ kǝbtha ɓi i Kristi, i tǝi ɓi ǝn ya nung a ɓko, manung a bǝ yakwɔ ǝn ya Yahudawa lǝu ɓǝ-nung kwɔ ǝǝ mangǝ Kristi gwab nung a ɓkong a? Ko tuab nilǝu! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />Nǝ ǝn baipi bǝ mab zuu kwɔ ǝn ɓanglǝ kwɔ, yang ǝǝ mangǝ ǝnto ǝn nung a ɓko la nwasiu. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />Bakwɔ tthǝ zuu ǝn ɓui lǝ ba zuu yangbǝ ǝn ǝǝ i nwongǝi lǝ ba Fuh, <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />yangbǝ ǝn ɓang lakwɔ i nwongǝi lǝu, kwoi ǝn Kristi dang tthǝm ɓǝ. Nwongǝi kwɔ dǝm nwong lakwɔ kwɔ, dǝm ǝǝ dang bǝ dǝnyitthǝ yui Fuh, kwɔ yiɗim langkwoi dǝ nwongǝi gu lǝbam ɓǝ. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />Ən gwab ǝn la nung a langǝ i Fuh lǝu. Kwoi nǝ yuu a to nung to a langǝ i gi Fuh dang zuu yang, yang ǝǝ mangǝ Kristi ɓui lǝ ba nung a kunlǝu!<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">Zuu Ko Bǝ Dǝnyitthǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />Ya Galantiyawa ɓǝ ǝn ya sulǝ! Ənyi naɓǝ natthǝ ɓui? Nungɓǝ lǝ kaitthǝ i geiɓǝ bǝ ɓuiɓua gi Yeso Kristi tthǝ lo kab gangǝ i! <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />Ɓa geim nungtthǝ kun: ɓa muo Ɓyang gi Fuh ibǝ to nungkwɔ zuu dǝna yiɗi ɓa ko ǝn bǝ lǝ nwaba a langǝ i langkwoi bǝ dǝnyitthǝ? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />Ɓa sulǝ nǝnǝ! Ɓa baipiu i Ɓyang Fuh; lakwɔ dǝɓa yiɗi bǝ alo i ɓyang a ɓa? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />Bǝto zuii ɓǝ ǝndǝi ǝǝlǝ nung a kunnu! <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />Fuh dǝɓǝ Ɓyang gu langkwoi to nung fǝmlo dang ɓǝ bakwɔ ɓato nungkwɔ zuu dǝna yiɗi ɓa ko bakwɔ ɓa lǝ nwaba a langǝ i ɓa dǝ ba a langǝ itthǝ a?<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />Ɓa ɓyǝa nungkwɔ tǝi Ibrahim; manungkwɔ nungvullǝ bagi Fuh gei ɓǝ, &lt;&lt;U dǝ ba a langǝ i tthǝ Fuh, langkwoi babǝ dǝnyitthǝ gu Fuh gwabbu lǝ yato nung to a langǝ i.&gt;&gt; <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />Ɓa ibǝi, angǝ ya bǝpi gi Ibrahim a langǝ i ǝn yayuu kwɔ tthǝ i bǝ dǝnyitthǝ. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />Nungvullǝ ɓyǝa tthasi angǝ Fuh a dǝ yakwɔ ǝn ya Yahudawa lǝu kwɔ matthǝ tthǝu lǝ tthǝ bǝ dǝnyitthǝ. Langkwoi nungkwɔ nungvullǝ gei nwaba a langǝ i lǝ Ibrahim tthǝ: &lt;&lt;Tthǝmǝ lǝ Fuh a khana lo yayuu ǝndǝi.&gt;&gt; <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />Ibrahim dǝ ba a langǝ itthǝ langkwoi Fuh khana lo; nungkwɔ yakwɔ dǝ ba a langǝ i tthǝu lǝ ǝndǝi Fuh khana loi.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />Yakwɔ dǝi lom bǝto nungto i zuu gi Musa lǝu yang i sinǝ ging. Bakwɔ nungvullǝ gei angǝ, &lt;&lt;Yuu kwɔ ǝndǝi vii ǝndǝi to nungto i nungkwɔ ǝndǝi nungvullǝ Zuu gei ɓǝlǝu yang Fuh sinǝ gu! <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />Lakwɔ, kai nǝkwam angǝ yuu akun yangǝu kwɔ zuu dǝ matthǝ i Fuh lǝɓǝ, bakwɔ nungvullǝ gei angǝ, &lt;&lt;Yuu kwɔ i du matthǝ i Fuh tthǝ bǝ dǝnyitthǝ ɓuo a tǝi nwongǝi.&gt;&gt; <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />Kwoi nung yangǝu kǝb zuu lǝtha i bǝ dǝnyitthǝu. Niyang, manungkwɔ nungvullǝ kwɔ angǝ, &lt;&lt;Yuu dǝna to nungkwɔ ǝndǝi zuu dǝna yidɗi kwɔ a tǝi nwongǝi.&gt;&gt;<verse eid="GAL 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13" />Kwoi ibǝ mǝrrǝm lǝ yuu kwɔ i sinǝ kwɔ Kristi ɗyǝab ɓi tthǝ sinǝ bǝi kwɔ zuu wulǝ ɓǝ; bakwɔ nungvullǝ gei angǝ, &lt;&lt;Yuu kwɔ nǝ i pi lo kab gangǝ i yang Fuh sinǝ gung.&gt;&gt; <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />Kristi to nungkwɔ yangbǝ bǝ khana lo kwɔ Fuh gwab nwuo lǝ Ibrahim kwɔ yangbǝ i dǝlǝ yakwɔ ǝn ya Yahudawa lǝu ɓǝ tthǝ Kristi Yeso, yangbǝ tthǝ bǝ dǝnyitthǝ ɓi ɓi muo Ɓyang kwɔ Fuh gwab nwuo ɓǝ.<verse eid="GAL 3:14" /></para>
  <para style="s">Zuu I Bǝ Gwab nwa</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />Ya ǝnthǝm, mǝn to nung to i nungkwɔ dǝna to nung vii ǝndǝi ɓǝ: kwɔ nǝ yayuu rab gwab lǝ thatthǝ lo nung, yuu akun yangǝu a dǝr ko linung akun lou. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />Lakwɔ, Fuh gwab nwa lǝ Ibrahim i ya bǝpi gu. Nungvullǝ gei angǝ&lt;&lt;ya bǝpi kpaatthǝ lǝu,&gt;&gt;nungɓǝ lǝ yayuu kpaatthǝ lǝu, &lt;&lt;bǝpi,&gt;&gt;nungɓǝ lǝ yuu akun ɓuo, ɗuǝnnu ǝn, Kristi. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />Nungkwɔ dǝm gei kwɔ nungɓǝ lǝ Fuh dǝ ganglang gu i Ibrahim langkwoi u gwabbu nwa angǝ i tunt o. Zuu, kwɔ i dǝ nǝsua ttha thǝmsob ɓua rab ilo thǝmkun pǝmna sob, ɓuan ab bǝ gwab nwa ɓǝu langkwoi ɓanglǝ bǝ gwab nwa gi Fuh. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />Bakwɔ nǝ nungdǝ gi Fuh dǝi tthǝn lo Zuu, yang lakwɔ dǝi lobǝ gwab nwa gu lǝu. Kwoi, ǝn babǝ gwab nwa gu nungkwɔ Fuh dǝ nungdǝ gulǝ Ibrahim.<verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />Ən ɓǝttǝn, yang, nungkwɔ to i dǝ Zuu ɓǝ? I wulǝ yangbǝ i tanatthǝ nungkwɔ lǝ nung a ɓko ɓǝ, langkwoi yangbǝ ǝǝ sua tutthǝ wulǝ bǝ wuo gi ya bǝpi Ibrahim, kwɔ i gwabbǝi nwa ɓǝ. I pinlǝ Zuu ɓǝ wui dǝlǝ ya nwatummi gi Fuh, i Musa kwɔ dǝna to mangǝn ya dǝi ganglang ɓǝ. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />Kwoi i yiɗi ya dǝi ganglangǝu nǝ ǝn yuu kunɗǝng ɓuoɓǝ; langkwoi Fuh kun.<verse eid="GAL 3:20" /></para>
  <para style="s">Nungkwɔ I Wulǝ Zuu Lǝ Bko Ɓǝ</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />Nungkwɔ ǝǝ mangǝ zuu dǝna tthǝng bǝ gwab nwa gi Fuh? Nilǝu, ko atuab! Bakwɔ <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />Kwoi nungvullǝ angǝ ttha nung a ɓko dǝna lo yigwoi lo longwam; langkwoi nungkwɔ nungdǝ kwɔ Fuh gwab nwuo lo bǝ dǝnyitthǝ dang Yeso Kristi kwɔ i dǝlǝ yakwɔ dǝ ba a langǝ i tthǝɓǝ.<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />Kwoi nwuni bǝ lona kwɔ yayuu dǝnyitthǝ wuo, zuu tthǝb ɓi dǝ mangǝn ya pursǝna. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />Langkwoi nungkwɔ zuu dǝna o ɓilǝ si nwuni bǝ Kristi wuo, yangbǝ i dǝɓi matthǝ i Fuh bakwɔ dǝnyitthǝ ɓǝ. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />Lakwɔ nikwɔ lona bǝ dǝnyitthǝ wung kwɔ, zuu lakwɔ to nungto i ɓiu.<verse eid="GAL 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />Tthǝn tthǝ bǝ dǝnyitthǝ nungkwɔ ɓǝ ǝndǝi ǝn yathang Fuh dang bǝ kǝbtha i Kristi Yeso. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />I wollɓǝ mung dang tha i Kristi, langkwoi lakwɔ ɓa lǝi kiggǝ Kristi, manungkwɔ dǝi geiɓǝ, i nwongǝi gi Kristi i nkolǝ. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />Nungkwɔ bǝ gab ganglang ya Yahudawa i yakwɔ ǝnya Yahudawa lǝu kwɔ yangǝu, ganglang ya thǝb langkwoi ya tǝi lo, ganglang yaɓǝi i yasi; ɓǝ ǝndǝi kun dang tha i Kristi Yeso. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />Nǝɓǝ ǝn a bǝ Kristi, yangɓǝ ǝnya bie Ibrahim langkwoi ɓa muo nungkwɔ Fuh gwab nwuo ɓǝ.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />Kwoi lakwɔ bǝ ǝn lilotthǝ ǝn gei gǝ- yui akwɔ a muo nungtǝi gi daa gu kwɔ i tou mangǝn thǝb kwɔ ulǝ munthang ɓǝ, kwoi kwɔ ulǝ yuu nungɓǝ ǝndǝi ɓǝ. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />Kwɔ ulǝ munthang, yaɓǝi tthǝ kwɔ dǝna kangǝu langkwoi dǝna tou nung to tthǝ tǝlǝ lona kwɔ daagu dǝɓǝ. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />Manungɓǝni, ɓi langɓǝ ǝn thǝb gi ɓyang kwɔ dǝna lo yigwoi longwam nwuni bǝ ɓi kǝn bǝ ghaali dang ɓyang ɓǝ. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />Kwoi nǝ lona nǝ wuo, Fuh a tum Yuiu. U wuo mangǝn yui kwɔ naa thayuu si ɓǝ langkwoi ǝǝ dang zuu ya Yahudawa, <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />yangbǝ u ilǝ yakwɔ zuu dǝna to nung to i ilǝ ɓǝ, yangbǝ i mǝrrǝm lǝ yathang Fuh.<verse eid="GAL 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6" />Yangbǝ tanatthǝ angǝ ɓǝ ǝn yathang gu, Fuh tumbǝi i Ɓyang Yuiu dang nyi ɓi, Ɓyang kwɔ dǝna lubǝi angǝ, &lt;&lt;Daa, Daam ɓǝ .&gt;&gt; <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />Nungwkɔ yang, mǝ ǝn thǝb a kun lǝu langkwoi kwoi ǝn yuiu. Langkwoi kwɔ mǝ ǝn yuiu, Fuh a da nung ǝndǝi kwɔ u dǝlǝ ba yathang gu ɓǝ.<verse eid="GAL 4:7" /></para>
  <para style="s">Bulus To Bǝlo Ya Galantiyawa</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />Lakku viikwɔ ɓa i Fuh lǝu, langkwoi nungkwɔ ɓǝ ǝn thǝb yakwɔ ǝn fuh lǝu ɓǝ. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />Kwoi lakwɔ ɓa i Fuh-ko, Mǝn gei gǝ, lakwɔ Fuh i ɓǝng kwɔ-ǝn baɓǝ bǝ dǝɓa yiɗi bǝ kwoi sua ɓǝ ɓa tǝbǝ to nung to i zuu longwam kwɔ muani langkwoi nung yangǝu tthǝi ɓa? Ən baɓǝ bǝ dǝɓa yiɗi bǝ ǝlǝ thǝb gi langkwoi? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />Dǝɓa dǝ kiggǝ la langǝ i lo vii ya kun, fih, lona langkwoi i ttha. <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />Tthǝm da survulli lǝ baɓǝ! A ɓuan a ǝǝ mangǝ nungtom ǝndǝi lǝ baɓǝ lǝ ǝn nung a nǝkwam ma?<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />Dǝm yamɓǝ, ya ǝnthǝm, ɓato manungkwɔ dǝm toɓǝ. Tthasua nung ǝndǝi, Ɓang mangǝn ɓǝ. Ɓa tom i nung a ɓko lǝu. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />Ɓa nhǝm nungkwɔ to ǝn geiɓǝ nwaba a langǝ i tthǝ la nwasiu ɓǝ; ǝn bakwɔ tthǝm lkoɓǝ. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />Kwoi kwɔ tthǝm kwɔ lko kwɔ ǝn bǝ nabǝi tthǝɓǝ, ɓa wam lǝtǝ lǝu ko ɓa lam. Niyang, ɓa kǝblom manungkwɔ ɓa kǝb lo ya nwatummi gi Fuh wayilǝ ɓǝ; ɓa kǝblom manungkwɔ ɓa kǝblo yeso Kristi ɓǝ. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />Tthǝ ɓǝ la ǝndǝi! Ən ɓǝ to nung? Ɓang i nam lǝ mǝn ɓuan mǝn geigǝ kaso ɓuan ɓa kko nungɓǝ, nǝɓa ɓumɓuan ɓǝ, yang ɓa dǝm. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />Lakwɔ ǝn mǝrrǝm lǝ ya ɓui ɓǝ bakwɔ dǝm gei ɓǝ ba a langǝ i tthǝ ɓa?<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />Yayuu a kun ɓǝkwɔ dǝna to nung to ɗing yangbǝ ǝǝ ɓǝ, kwoi dang wai mko. Nungkwɔ dǝi yiɗi ǝndǝi kwɔ nungɓǝ lǝ yangbǝ i gab ɓǝlǝ tha i ɓang, yangbǝ ɓa yiɗi gi manungkwɔ dǝi yiɗi ɓǝ ɓǝ. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />Lakwɔ, maɗing bǝ tǝi bǝ yiɗi bǝ to nung to ɗing, nǝ nungkwɔ to ma to nungɓǝkwɔ maɗing ɓǝ-nung kwɔ ǝn ba a langǝ i vii ǝndǝi, langkwoi ǝn bakwɔ nǝ ɓang i ɓǝlǝ ɓuo lǝu. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />Yathangǝm kwɔ dǝm yidɗi nikwɔ! Langkwoi, mangǝn naa kwɔ dang bǝ si yui kwɔ, dǝmlǝ u tthǝzii ɓǝkwɔ lǝ baɓǝ nǝ kiggǝ Kristi tǝ tthǝɓǝ ɗǝ. <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />Dǝm yidɗi kaso ɓang i ɓǝlǝ, yangbǝ ǝn lǝi kiggǝ a kun ǝn gei ɓǝ lǝ ba. Kiggǝm dǝna ǝrlǝ baɓǝ!<verse eid="GAL 4:20" /></para>
  <para style="s">Bǝ Nanung I Haga I Saratu</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />Ɓa dǝisua ǝn ɓib yakun ɓǝkwɔ dǝna yidɗi bǝ tonungto i Zuu gi Musa ɓǝ: ɓalǝ nungkwɔ Zuu gi Musa gei ɓǝlǝu? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />Zuu gei angǝ Ibrahim si yathang rab, a kun ǝn thǝb yisi si, yuu a kun yisi kwɔ ǝn thǝb lǝu kwɔ si. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />Yuiu kwɔ thǝb yisi kwɔ i siu nunglǝi a zee, kwoi yuiu a kwɔ yisi kwɔ ǝn thǝb lǝu sikwɔ i siu lǝ babǝ gwab nwa gi Fuh. <verse eid="GAL 4:23" /><verse number="24" style="v" sid="GAL 4:24" />I lǝi i nungkwɔ mangǝn killǝng: yasi kwɔ rab kwɔ lǝ nwathan ganglang rab. Yuu akwɔ i si yathang gu dang bǝ to thǝb kwɔ nungɓǝ lǝ Haga, langkwoi ulǝ nwathan ganglang kwɔ i to lotal Sinai ɓǝ. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />Haga, mangǝn Tal Sinai i nwa larabawa kwɔ, ǝǝ mangǝn gwoi angǝ a Urshalima a lakwɔ, gwoi angǝ a ɓǝ ǝn gwoi ya thǝb i yayuu gu ǝndǝi. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />Kwoi Urshalima kwɔ wayi kwɔ ǝn thǝb lǝu, langkwoi nungɓǝ lǝ naa ɓi. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />Nungvullǝ ba Fuh gei angǝ,</para>
  <para style="q1" vid="GAL 4:27">&lt;&lt;A lǝtthǝla, yisi kwɔ ǝǝ dǝgǝm ɓǝ!</para>
  <para style="q2" vid="GAL 4:27">Buogbǝi langkwoi a tasui i tthǝla, mǝ kwɔ a lǝtthǝ zii bǝ si yui lǝu bo kun ɓǝ!</para>
  <para style="q1" vid="GAL 4:27">Bakwɔ yisi kwɔ i lko kwɔ a si yathang kpaatthǝ</para>
  <para style="q2" vid="GAL 4:27">pǝl a bǝ yisi kwɔ ɓǝiu yiu lǝu bokun ɓǝ.&gt;&gt;<verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />Lakwɔ, ɓǝ, ya ǝnthǝm, ɓǝ mangǝn yathang Fuh manung a bǝ Ishaku, babǝ gwab nwa gu. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />Lona lǝ kullo yui kwɔ i siu nunglǝi a zee dǝ zuii lǝ yui a kwɔ i si ba Ɓyang Fuh ɓǝ; langkwoi natha lakwɔ. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />Kwoi ǝn ɓǝttǝn nungvullǝ gei? Nungvullǝ gei angǝ, &lt;&lt;Ɓa nan thǝb yisi i yuiu pa; bakwɔ yui yisi kwɔ lǝ thǝb kwɔ gab nungtǝi daa i yui yisi tǝi lou.&gt;&gt; <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />Nungkwɔ yang, ya ǝnthǝm, ɓi ǝn yathang thǝb yisi lǝu kwoi yisi akwɔ tǝi lo ɓǝ.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">Ɓa Kang Bǝ Tǝi Loɓǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />Bǝ tǝi lo ǝn nungkwɔ ɓi tǝi ɓǝ- Kristi dǝɓi bǝ tǝi lo! Ɓa dǝi, yang, mangǝn yayuu kwɔ tǝi loi ɓǝ, langkwoi bǝ ɓa gwab ɓa mǝrǝmlǝ thǝb langkwoi thǝ.<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />Ɓa lǝ! Ɓang, Bulus, dǝm geiɓǝ geigǝ nǝɓa gwab ɓa ɓǝrnwa ɗuǝ ɓǝ, yang Kristi ǝn nung akun lǝu tthǝɓǝ ko tuab. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />Langkwoi dǝm gub ɗuogsui yiɓǝi akwɔ kǝr i ɓǝrnwa ɗuǝu yang u dǝnyitthǝ bǝ to nung to i zuu ǝndǝi. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />Ɓǝ yakwɔ dǝna yiɗi bǝ ǝǝ matthǝ i Fuh i bǝ to nung to i zuu kwɔ ɓa kwoilǝ tthǝɓǝ tthǝ Kristi. Ɓa ing dang nung a langǝ i gu. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />Aɓi abo, bǝ dǝnyitthǝ ɓi tthǝ nungɓǝlǝ Fuh a dǝɓi matthǝ tthǝulǝ; langkwoi nungkwɔ nungɓǝlǝ u nungkwɔ dǝɓi ki ɓǝ i ttha Ɓyang gi Fuh kwɔ dǝna to nung to tthǝ bǝ dǝnyi ɓitthǝ. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />Bakwɔ nǝ ɓi dang tha i Kristi Yeso, yakwɔ i ɓǝr nwa ɗuǝ i yakwɔ i ɓǝr nwa ɗuǝi lǝu bǝ gab ganglangǝ i yangǝu ko tuab; nung kun ɓuo kwɔ nungɓǝ lǝ bǝ dǝnyitthǝ kwɔ dǝna to nung to tthǝ bǝ yiɗi bǝi ɓǝ. <verse eid="GAL 5:6" /><verse number="7" style="v" sid="GAL 5:7" />Dǝɓa to nung to maɗing! Ən yi nanɓǝ bǝ to nung to i ba a langǝ i? U to nǝnǝ u ɗam ɓǝ lǝ? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />Bǝ yambǝi kwɔ dǝi yam ɓǝ lǝ kwɔ ǝn Fuh kwɔ lubǝi ɓǝkwɔ, tolǝu. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />Manungkwɔ i gei ɓǝ angǝ,&lt;&lt;Yisti ni tuabni ɓuo dǝna to mual kpaatthǝ dǝna fǝm,&gt;&gt; <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />Kwoi yirrǝ dǝm nhǝm ba loɓǝ. Nwongǝi ɓi dang tha i Dangbang tom dǝm dǝnyitthǝ geigǝ ɓa lǝi nunglǝi a kunnu langkwoi yuu kwɔ dǝna ǝrr lǝ kiggǝ ɓǝ Fuh a ɗabluo.<verse eid="GAL 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11" />Ya ǝnthǝm, ɓang abǝm, nǝ ǝn ǝnwa bǝ geigǝ bǝ ɓǝr nwa ɗuǝ ǝn nung a langǝ i, ǝn baɓǝ bǝ yirrǝ yayuu dǝna dǝm zuii, nǝ nungɓǝkwɔ ǝn ba a langǝ i, yangbǝ gei ba a langǝ i lǝ ba kab gangǝ i gi Kristi ǝtr lǝ yurrǝu. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />Dǝm yidɗi kaso yayuu kwɔ dǝna ǝrlǝ kiggǝ ɓǝkwɔ a lilotthǝ; i lilotthǝ i mea loi!<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />Baɓǝ abo, ya ǝnthǝm, i lubǝi ɓǝ ɓa ǝlǝ ya tǝi lo ɓǝ. Kwoi bǝ ɓa yitthǝ bǝ tǝi lo ɓǝ kwɔ ɓa tolǝ nungkwɔ sual tthǝ ɓǝ dǝna yiɗi bǝ thǝ. Manungɓǝ ni yang, ɓa to nung to lǝtha tthǝ i bǝ yiɗi tha. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />Bakwɔ zuu ǝndǝi kǝbtha dang bǝ dǝba kun: &lt;&lt;A yiɗi ya nwakong mǝ manunkwɔ dǝma yiɗi lomǝ ɓǝ.&gt;&gt; <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />Kwoi nǝ dǝɓa to nung mangǝn nyam dang gug, dǝɓa nkoni tha langkwoi dǝɓa thǝb tha, yang ɓa kang, ko ɓa thǝb tha ǝndǝi.</para>
  <para style="p" vid="GAL 5:15">Ɓyang I Sual Tthǝ Yuu<verse eid="GAL 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />Nungkwɔ dǝm gei kwɔ nungɓǝ lǝ: ɓa yitthǝ Ɓyang o nwongǝi ɓǝlǝ si, yang ɓa dǝ tthǝla lǝ nungkwɔ sualtthǝ thayuu dǝna yiɗi ɓǝu. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />Bakwɔ nungkwɔ sual tthǝ thayuu dǝna yiɗi kwɔ nungɓǝ lǝ nungkwɔ Ɓyang dǝna yiɗi ɓǝlǝu, langkwoi nungkwɔ Ɓyang a langǝ i dǝna yiɗi kwɔ nungkwɔ sual tthǝ thayuu dǝna yiɗi ɓǝlǝu. I kwɔ rab kwɔ ǝn ɓui tthǝtha, langkwoi nungkwɔ ǝǝ mangǝ ɓato nungkwɔ dǝ ɓa yiɗi bǝ tou ɓǝu. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />Nǝ Ɓyang dǝna oɓǝlǝ si, yang zuu lo yigwoi lo ɓǝu.<verse eid="GAL 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19" />Nungkwɔ sualtthǝ thayuu dǝna yiɗi kwɔ kai nǝkwam. Dǝnna ilǝ lo nunglǝi a ɓko, ɓillǝng, langkwoi kwɔ ǝn a langǝ i lǝu ɓǝ; <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />Bǝ wab nungkwɔ na yuu kai ɓǝ i bǝ tthaɓui. Yayuu mǝrrǝm lǝ ɓuitha dǝnni ɓuob vǝm; dǝito dasi, nyi, langkwoi bǝ yiɗi lo. Dǝi gab loi kǝm lǝ kǝm langkwoi ɓuai; <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />langkwoi dǝi tthǝngtha, nwamung i fǝr, bǝ yiɗi bǝlo i tha, langkwoi dǝi to i nung a kun manungkwɔ: Dǝm gub ɗuogsui ɓǝ lakwɔ manungkwɔ ǝn to vii kwɔ ɓǝ: Yakwɔ dǝna to i nungkwɔ tǝ bǝi kwɔ Fuh lǝ yigwoi ɓǝu.<verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />Kwoi Ɓyang dǝna wulǝ bǝ yiɗi bǝi, tthǝla, bǝ ǝǝ latthǝ, bǝ thǝb nyitthǝ, nung a langǝ i, bǝ dǝnyitthǝ, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />Bǝ ɓuob lo sua, i bǝ muo lo. Zuu yangǝu lo i nung manungkwɔ niu. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />Langkwoi yakwɔ ǝn a bǝ Yeso Kristi thǝb sual tthǝi i nungkwɔ dǝu yiɗi ǝndǝi ɓǝ. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />Ɓyang dǝɓi nwongǝi; u oɓilǝ si langɓǝ. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />Bǝɓi lǝi lo ɓi ko ɓi ɓanglǝ dang wa tha ko ɓito dasi i tha thǝ.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">Ɓi Nwong Tha</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />Ya ǝnthǝm, nǝ i muo yuu akun dang nung a ɓko, ɓǝ yakwɔ tthǝ i ɓyang a langǝ i gi Fuh kwɔ ɓa kwoiulǝ tǝmtǝm, kwoi ɓǝ langɓǝ ɓato kiggǝ. Yangbǝ ɓǝ langɓǝ ɓa o dang bǝ nabǝithǝ. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />Ɓa nwong tha, langkwoi manungkwɔ niyang ɓa to nung to i zuu gi Kristi. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />Nǝ yuu kun dǝna nhǝm angǝ i ǝn nung akun kwɔ u ǝn nung akunlǝu, dǝu ɗam ǝn lo. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />Ko ya ǝndǝi na nung to gu. Nǝ maɗing, yang ma ɓuan ma lǝi lo mǝ lo nungkwɔ mǝ i namǝ a toɓǝ, yangbǝ bǝ u na nung to gu lǝtha i nung to yuu akun thǝ. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />Bakwɔ ko ya ǝndǝi dang ɓǝ a lǝi nunglǝi guɓǝ.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />Yuu akwɔ nǝ i nkonatthǝ nung ba Fuh, u gab nung a langǝ i ǝndǝi i ya nkonatthǝ nung.<verse eid="GAL 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7" />Bǝ i ɗam ɓǝ thǝ; yuu akun yangǝu a tthak Fuh. Yuu a ɓǝr nungkwɔ u bie ɓǝ. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />Yuu akwɔ nǝ bie nung manungkwɔ longwam dǝna yiɗi kwɔ nungkwɔ u kwɔ u tǝi kwɔ nungɓǝ lǝ ɓua, kwoi yuu akwɔ nǝ a bie nung yangbǝ Ɓyang lǝ tthǝla, u tǝi nwongǝi a ɗing. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />Bǝ thǝm ɓi bǝto nung a langǝ i thǝ; bakwɔ nǝɓi yitthǝ lǝu yang, lona dǝna wɔ kwɔ ɓi ɓǝr nung a langǝ iɓǝ ɓǝ. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />Nungkwɔ yang, lona kwɔ ǝndǝi nǝɓi tǝi lǝi yang, ɓi to nung a langǝ i lǝ yayuu tthǝ ǝndǝi, langkwoi yakwɔ ɓi dang woi bǝ dǝnyitthǝ kun ɓǝ.<verse eid="GAL 6:10" /></para>
  <para style="s">Bǝ Gub Ɗuog Sui A Nǝsua</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />Ɓa ɓyǝa gong nungvullǝ kwɔ manungkwɔ ǝn vullǝ ɓǝtthǝ i nam ɓǝ! <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />Yayuu akwɔ dǝna yiɗi bǝ toɓǝ lǝ tha yangbǝ ɓa ɓǝrnwa ɗuǝ kwɔ ǝnya kwɔ dǝna yiɗi bǝ lǝiloi ba nung akwɔ nung yayuu a ɓyǝa ɓǝ. Dǝnni to, ɓuo yangbǝ bǝ i ji zuii ba kab gangǝ i gi Kristi thǝ. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />Ko ya losua kwɔ dǝna ɓǝrnwa ɗuǝi kwɔ i to nung to i zuu; dǝnni yiɗi angǝ ɓa ɓǝrnwa ɗuǝ yangbǝ i lǝi loi angǝ ɓa gwab nung to a gwammǝng. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />Ɓang abǝm, mǝn lǝi lom lǝ ba kab gangǝ i gi Dangbang Yeso Kristi; ba kab gangǝ i gu longwam ɓuing tthǝm lǝ, langkwoi ǝn ɓuing tthǝ longwam. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />Bǝ ɓǝr nwa ɗuǝ i yakwɔ ɓǝrnwa ɗuǝ lǝu kwɔ ǝn nung a kunlǝu; nungkwɔ lǝ nung a kun kwɔ nungɓǝ lǝ Fuh mǝrrǝm yayuu lǝ nung afu. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />Lǝ ba a bǝ yakwɔ dǝna muo nunglǝi kwɔ, kaso bǝ ǝǝ a langǝ i langkwoi bǝ ɓyǝa nungzuii Fuh ǝǝ i ilǝ- i ilǝ ǝndǝi langkwoi i ya israila ǝndǝi!<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />Bǝ alo: bǝ yuu a kun wum lǝ zuii a kunthǝ, bakwɔ gilǝng nunglua kwɔ tthǝm kwɔ ǝǝ mangǝ ɓang ǝn thǝb gi Yeso.<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />Ya ǝnthǝm kaso nung a langǝ i gi Dangbang Yeso Kristi ǝǝ i ɓǝ ǝndǝi. Dǝitthǝ Manungɓǝ.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>