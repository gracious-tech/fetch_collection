<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">Yohanna</para>
  <para style="toc1">Nwaba a langǝ i nwa YOHANNA</para>
  <para style="toc2">Yohanna</para>
  <para style="toc3">Yoh</para>
  <para style="mt1">Yohanna</para>
  <para style="imt">Bǝ Gabnung Ba</para>
  <para style="ip">Nungvullǝ dang Yohanna illǝ ba gi Yeso nyimtthǝ laɗing lǝ ba gi Fuh, kwɔ &lt;&lt; mǝrrǝm lǝ tthayuu langkwoi i nwongǝi lǝ ganglang ɓi ɓǝ.&gt;&gt;Manung kwɔ nung vullǝ ɓǝ gei i nko angǝ, ba gi Fuh kwɔ i vullǝu yang bǝ yakwɔ a than kwɔ a dǝ ba a langǝ i tthǝ angǝ Yeso ǝn Yuui kwɔ gei ba gu angǝ u ǝn ya soplo, Yui gi Fuh ɓǝ, langkwoi dang bǝ dǝ nyi gi tthǝu yang i tǝi nwongǝi. ( 20:31).</para>
  <para style="ip">Tthasua nung ba kwɔ tanna tthǝ Ba a ɗing gi Fuh i Yeso kwɔ, ba gi Fuh a nungsi tanna tthǝ nung fuǝmlo kpaaɗing kwɔ tanna tthǝ Yeso lǝ ya soblo kwɔ i gwab nwao ɓǝ, u ǝn Yui gi Fuh. Nungkwɔ lǝ nungkwɔ illǝ bǝ gei nwa ba nungfuǝmlo lǝ gwam kaitthǝ ɓǝ. Tthǝn tthǝ nungvullǝ kwɔ yayuu da angǝ a tthǝ Yeso kwoi mǝrrǝm lǝ ya musuo ɓǝ, ya lko langkwoi la bǝ da ba a langǝ i tthǝu. Yohanna 13-17 gei ba gong tthǝ lo bǝ gbagttha bǝ to ba Fuh gi Yeso i ya na nungto gi Yeso lonna kwɔ i mu ɓǝ, langkwoi tthǝ bǝ mab nunglǝi ba gu i bǝ nyimtthǝi lo ɓilli bǝ piu lo kab gangǝ i.</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">Ba Nwongǝi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />La nwasiu ba ɓǝtthǝ; baɓǝ i Fuh lǝ, baɓǝ ǝn Fuh. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />Baipiu la nwasiu baɓǝ i Fuh lǝ. <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />I ba kwɔ Fuh mab nung ǝndǝi; nung akun yangǝu dang nung mabbi kwɔ Fuh mab i ulǝ lǝu ɓǝ. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />Ba ɓǝlǝ nunglǝi nwongǝi, nwongǝi ɓǝkwɔ wulǝ nung gabbǝi lǝ tha yuu tthǝ. <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />Nung gabbǝi ɓǝ gabbǝi dang bǝthǝl, kwoi tthǝl ɓǝ mual lǝu.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />Fuh tum ya nwatummi gu, yiɓǝi akun tthǝ ɗuǝnu ǝn Yohanna, <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />Yohanna wɔ bǝ gei ba lǝ yayuu tthǝ ba nung gabbǝi, yangbǝ yayuu ǝndǝi lǝ baɓǝ yang dǝ ba a langǝ i tthǝ lua lǝ kullo. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />Yohanna i nkolǝ ǝn nung gabbǝi ɓǝ kullo lǝu; u wuo bǝ gei ba nung gabbǝi ɓǝ. <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />Nungkwɔ nung ɓǝlǝ nung gabbǝi a langǝ i nung gabbǝi kwɔ wuo dang longwam wuu gabbǝi tthǝ yayuu ǝndǝi.<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />Baɓǝ dang longwam lǝ, langkwoi Fuh mab nung ǝndǝi tthǝulǝ, kwoi i nung lǝ kwɔ ǝndǝi ya longwam iu lǝu. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />U wuo lǝ ba yayuu gu, kwoi yayuu gu dǝba a langǝ i tthǝu lǝu. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />Yakun, dǝba a langǝ i tthǝu; u ji tthǝnyimmi i mǝrrǝm lǝ yathang gi Fuh.<verse eid="JHN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 1:13" />I mǝrrǝm lǝ yathang gi Fuh manungkwɔ yisi a siǝ ɓǝlǝu, yuu si iǝn yathang yayuu lǝ Daa gi; Fuh i nko lǝ lǝ Daa gi.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />Baɓǝ mǝrrǝm lǝ yuu ǝǝ dang ɓi, baɓǝ yitthǝ i nung a langǝ i i bǝ ɓyǝa nungzui i ba a langǝ i, dang ɓi lǝ. Ɓi ɓyǝa nung angǝ a gu, nung angǝ a gu kwɔ u muo na Fuh Daa gu ɓǝ.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />U lǝ yuu a kwɔ Yohanna gei bagu ɓǝ. Yohanna dǝna gei i yol angǝ a angǝ,&lt;&lt;U lǝ yuu akwɔ ǝn gei bagu ǝn geigǝ,&lt;U wuo tthasuam, kwoi ghaali gu pǝll abǝm, bakwɔ u wuu longwam kwɔ nwuni bǝ i sim ɓǝ&gt;&gt;&gt;<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />Dang bǝ ɓyǝa nungzui gu ghaatthǝ, u dǝɓi bǝ khanalo ǝndǝi, dǝu dǝɓi nung a langǝ i kpaatthǝ. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Fuh dǝɓi nung zuu gu dang na Musa, kwoi nung a langǝ i i ba a langǝ i wuo dang na Yeso ya nwonglo. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />Yuu akun yangǝu ɓyǝa Fuh Daa. Kwoi Yuiu kwɔ kun ɓuo ɓǝ, kwɔ mangǝ u ǝn Fuh ǝǝ nwangwu Daa gu, u toɓi ɓi i Fuh Daa.<verse eid="JHN 1:18" /></para>
  <para style="s">Bagi Yohanna Ya Wolmung</para>
  <para style="r">(<ref loc="MAT 3:1-12">Matthew 3:1-12</ref>; <ref loc="MRK 1:1-8">Markus 1:1-8</ref>; <ref loc="LUK 3:1-18">Luka 3:1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />U nungkwɔ yaku ya Yahudawa dang Urshalima ɓyǝa kwɔ i tum yakun dang ya nyǝknung i ya Lawiyawa sua Yohanna tǝi ɓibbu angǝ,&lt;&lt;Mǝn yittǝna?&gt;&gt;<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />Yohanna labǝ gwab nwa lǝu, u gei ba nung yayuu kaitthǝ, u gei angǝ,&lt;&lt;Ən ɓanglǝ Kristi lǝu.&gt;&gt;<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />I ɓib angǝ, &lt;&lt;Yang mǝn yittǝna?, &lt;&lt;Mǝn Iliya?&gt;&gt; Yohanna gwab nwa angǝ, &lt;&lt;Ən ɓang lǝu, i ɓib langkwoi angǝ,&lt;&lt;Mǝlǝ ya ɓyǝa tthasi?, U gwab nwa angǝ,&lt;&lt;Ən ɓang lǝu&gt;&gt;<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />i gei angǝ,&lt;&lt; Yang a gei ɓi tthǝ mǝn yittǝn.&lt;&lt; Yang bǝ ɓi kwoi lǝ nungkwɔ a gei kwɔ tǝɓi gei lǝ yakwɔ tum ɓiɓǝ. Ənɓǝ ma gei lǝ ba lomǝ?&gt;&gt;<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />Yohanna gwabǝi nwa i nungkwɔ ya gei ba a tthasi Ishaya gei ɓǝ angǝ:</para>
  <para style="q1" vid="JHN 1:23">Ɓang lǝ yol yuu kun kwɔ dǝna lubǝi dang losua akwi kwɔ gei angǝ:</para>
  <para style="q2" vid="JHN 1:23">ɓa mab nunglǝi lǝ Fuh juan tthǝ yang bǝ u thko tthǝ!&gt;&gt;&gt;<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Ya nwatummi, kwɔ ya Farisiyawa tum ɓǝ, <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />I ɓib Yohanna angǝ, nǝ mǝn Kristi lǝu ǝn Iliya lǝu ya ɓyǝa tthasi lǝu, ǝn baɓǝ bǝ dǝma wolmung ɗiggǝ nung aɓau lǝ yayuu?&gt;&gt;<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />Yohanna gwab nwa angǝ,&lt;&lt;Dǝm wolmung i mungki, kwoi dang ɓǝ kwɔ ɓa dǝi u yuu kwɔ ɓa i bǝi lǝu ɓǝ. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />Dǝu wuo tthasuam, kwoi ǝn kǝn kwɔ mǝn bi ɓǝl ǝko gu ɓǝ lǝu.&gt;&gt;<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />Nungkwɔ ǝndǝi tonung dang Betanya nunglǝi gwɔpi dual Urdun bǝi kwɔ Yohanna dǝna wolmung ɗiggǝ nung a ɓko tthǝɓǝ.<verse eid="JHN 1:28" /></para>
  <para style="s">Yui Ɓangam Gi Fuh</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Ibǝikan Yohanna ɓyǝa Yeso dǝna wuu suo, u gei angǝ,&lt;&lt;Yui ɓangam gi Fuh kwɔ, kwɔ lǝi nung a ɓko longwam ɓǝ!<verse eid="JHN 1:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 1:30" />U ɓǝ kwɔ ǝn gei bagu ɓǝ kwɔ ǝn geigǝ,&lt;Yiɓǝi akun tthǝ dǝna wɔ tthasuam lǝ, ghaali gu pǝllǝm, bakwɔ u longwam kwɔ bǝ i sim ɓǝ.&gt; <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Ɓang i nam lǝ ǝn iu lǝu, kwoi ǝn wuo dǝmǝn wolmung ɗiggǝ nung a ɓko i mungki yang bǝ ya Israilawa iu.&gt;&gt;<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />Yohanna gei ba a langǝ i lolǝ angǝ: ǝn ɓyǝa Ɓyang a Langǝ i dǝna pin mangǝn Gko wayi wuo tthǝu lǝ. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Yirrǝ ɓang i namlǝ ǝn i bǝi kwɔ ǝn u ɓǝlǝu, langkwoi Fuh kwɔ, tummǝm angǝ wuong wolmung i mungki kwɔ, u gǝmtthǝ angǝ,&lt;Ma ɓyǝa Ɓyang gi Fuh a pin wayi wa ǝǝ lo yiɓǝi lǝ; u kwɔ u wolmung i Ɓyang a Langǝ i ɓǝ.&gt; <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Yohanna gei angǝ,&lt;&lt;Ən ɓyǝkong, ǝn gei ɓǝ tthǝ u lǝ Yui Fuh.&gt;&gt;<verse eid="JHN 1:34" /></para>
  <para style="s">Ya Nanungto Gi Yeso A Nungsi</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Ibǝikan Yohanna dǝi bǝi lǝ langkwoi i ya nanungto gu rab, <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />kwɔ u ɓyǝa Yeso dǝna thko. U gei angǝ,&lt;&lt;Ɓyǝa! Yui ɓangam gi Fuh kwɔ&gt;&gt;.<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />Kwɔ ya nanung to gi Yohanna lǝ nungkwɔ dǝu gei ɓǝ nungkwɔ i pa sua tha i Yeso. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />Yeso mǝrrǝm, ɓyǝai dǝi muo suo, u ɓibǝi angǝ,&lt;&lt;Ənɓǝ dǝɓa ɗubǝi?&gt;&gt;</para>
  <para style="p" vid="JHN 1:38">I gwab nwa angǝ, &lt;&lt;Dǝma ǝǝ ɓǝla Rabbi? Ya nanatthǝ nung nungkwɔ lǝ Rabbi<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />&lt;&lt;Yeso gwabnwa angǝ wuɓa ɓyǝa,&gt;&gt;Yang mangǝn lona kwɔ fuh dǝna owh. I tǝsua tha i u lǝ tǝi ɓyǝa bǝikwɔ u ǝǝ tthǝ ɓǝ, i ǝǝ bǝilǝ dang fuh lǝ ǝndǝi.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Yuu akun dang ǝi lǝ kwɔ lǝ ba yohanna ǝn Andarawas young gi saminu Bitrus. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />Dang tthǝ u tǝi youngǝu Siman u geiu angǝ, &lt;&lt;Ɓi tǝi ya nwonglo.&gt;&gt;(Nung ɓǝ lǝ Kristi.)<verse eid="JHN 1:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 1:42" />Nungkwɔ u lǝi Siman u tǝlǝ sua Yeso. Yeso ɓyǝko nungkwɔ gei angǝ&lt;&lt;Ɗuǝn mǝn Saminu yui gi Yohanna, kwoi i lu ɗuǝn mǝlǝ Kefas. Bitrus nung ɓǝ lǝ ɓǝmtal.&gt;&gt;<verse eid="JHN 1:42" /></para>
  <para style="s">Yeso Lubǝ Filibus I Nataala</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Bǝikan Yeso dǝna yiɗi bǝ tǝ Galili. U tǝi Filibus u geiu angǝ,&lt;&lt;A wuo suattha i ɓang!&gt;&gt;<verse eid="JHN 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 1:44" />Filibus ǝnya Betsaida, gwoi kwɔ Andarawas i Bitrus tthǝ ɓǝ. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />Filibus tǝi Nata'ala u geiu angǝ,&lt;&lt;Ɓi tǝi yuu akwɔ Musa vullǝ nung bagu dang nungvullǝ nung zuu kwɔ langkwoi ya gei ba a tthasi vullǝ langɓǝ ɓǝ. U ǝn Yeso yui gi Yusufu ya Nazarat.&gt;&gt;<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />Nata'ala ɓib angǝ,&lt;&lt;Lakwɔ nung a langǝ i a ing i Nazarat la?&gt;&gt;</para>
  <para style="p" vid="JHN 1:46">Filibus gwab nwa angǝ,&lt;&lt;A wuo wa ɓyǝa.&gt;&gt;<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />Kwɔ Yeso ɓyǝa Nata'ala dǝna wɔ suo u gei angǝ,&lt;&lt;Ya Israilawa a langǝ i kwɔ; kwɔ bǝ ɗambǝi yangǝu i u lǝ ɓǝ!&gt;&gt;<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />Nata'ala ɓibbu angǝ,&lt;&lt;A to nǝnǝ bǝ a imlǝ?&gt;&gt;</para>
  <para style="p" vid="JHN 1:48">Yeso gei angǝ,&lt;&lt;Ən ɓyǝa kwɔ a ǝǝ pi kab gol nwuni bǝ Filibus lubǝi mǝ ɓǝ.&gt;&gt;<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />Nata'ala gei angǝ Ya nanatthǝ nung &lt;&lt;mǝn Yui Fuh! Mǝlǝ yigwoi ya Israila!&gt;&gt;<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />Yeso gei angǝ,&lt;&lt;A dǝba a langǝ i tthǝ bakwɔ ǝn geitthǝ geigǝ ǝn ɓyǝa ɓuapi kab gol ɓa? Ma ɓyǝa nung angǝ a kwɔ pǝl akwɔ ɓǝ!&gt;&gt;<verse eid="JHN 1:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 1:51" />Langkwoi u gei angǝ,&lt;&lt;Dǝm gei ɓǝ ba a langǝ i tthǝ; ɓa ɓyǝa wayi a ɓko ya nwatummi gi Fuh dǝna ɗab yi dǝna pin sua lo Yui Yuu.&gt;&gt;<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">Bǝ Dǝb Yisi Kan'ana</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />Lotthǝ bo rab bǝ dǝb yisi tthǝ gwoi angǝ a losua Kan'ana dang Galili. Naa gi Yeso bǝilǝ, <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />I lubǝ Yeso i ya nanung to gu bǝ dǝb yisi lǝ. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />Kwɔ min thǝm, Naa gi Yeso Maryamu geiu angǝ,&lt;&lt;Min thǝmǝng.&gt;&gt;<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />&lt;&lt;Ba geim nungkwɔ mǝn toɓǝ tthǝ thǝ,&gt;&gt;Yeso gei angǝ.&lt;&lt;Lonam yirrǝ wuo lǝu.&gt;&gt;<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />Naa gi Yeso gei lǝ ya thǝb ɓǝtthǝ angǝ,&lt;&lt;Ɓa to nungkwɔ ǝndǝi u gei ɓǝtthǝ ɓǝ angǝ ɓa toɓǝ.&gt;&gt;<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Ya Yahudawa tthǝ i nung zuu ɗiggǝ nung lǝ ba nung ɓǝkwɔ Bǝilǝ kwɔ bko suab tthǝ ni Nanakun, bko ɓǝtthǝ kwɔ dǝna lǝi nung dang kuluk tthǝmnu. <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />Yeso gei ya thǝb ɓǝ angǝ,&lt;&lt;Ɓa al mungki yi bko ɓǝ ǝndǝi.&gt;&gt;I al mungki yitthǝ kǝn dulu, <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />Yeso gei angǝ,&lt;&lt;Lakwɔ ɓa ɓaa mungki ɓǝ tǝɓa dǝlǝ yikku ɓangɓǝ,&gt;&gt;I tǝlǝlǝ mungki ɓǝ tǝi du, <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />yiku ɓangɓǝ bang mungki ɓǝ kwɔ mǝrǝm lǝ min ɓǝ. U ibǝ bǝi kwɔ min ɓǝ itthǝ ɓǝlǝu, kwoi langkwoi, ya thǝb kwɔ ɓaa mungki ɓǝkwɔ ibǝi yang; u lubǝ yuu ɗǝb yisi ɓǝ<verse eid="JHN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 2:10" />u gei angǝ,&lt;&lt;Ko ǝn yittǝn a gab min a langǝ i nungsi, yayuu nwa lǝtthǝi, yang i gab sua min a nǝkwam ɓǝ. Yang ɓa yitthǝ min a langǝ i nwuni nǝnǝng kwɔ!&gt;&gt;<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Yeso to nungfǝmlo a nwasiu tthǝn Kan'ana dang Galili; U bǝi lǝ kwɔ u to nungfǝmlo gu nungkwɔ ya nanung to gu dǝ ba langǝ itthǝu.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />Tthasua nungkwɔ,Yeso i Naa gu, i ya youngǝu i ya nanung to gu tǝ Kafarnahum tǝu ǝǝ bǝi lǝ tuab.<verse eid="JHN 2:12" /></para>
  <para style="s">Yeso Tǝ Dang Kǝm Nyǝknung</para>
  <para style="r">(Matthew 21:12, 13; <ref loc="MRK 11:15-17">Markus 11:15-17</ref>; Luka 19:45, 46)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />Gbag bǝ to ɓang nyang lo ya Yahudawa, nungkwɔ Yeso tǝ Urshalima. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />U tǝi yayuu dang kǝm Nyǝknung dǝna ɗyǝab nyak ɓangam i ɓa i gko, i ya pǝrǝm nungkurɓǝ i ǝǝ lo tebur. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />Nungkwɔ u ɗuu ɓǝl u mab lǝ thab u ilǝ i nungbyang ɓǝlǝ gwam dang kǝm nyǝknung lǝ, i ɓangam i nyak; u lǝi tebur ɓǝ i nungkurɓǝ u alǝtǝ;<verse eid="JHN 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 2:16" />Langkwoi u gei yakwɔ dǝna mǝal gko ɓǝ angǝ,&lt;&lt;i ilǝ bǝi lǝ! Ɓa yitthǝ bǝ mǝrrǝm dang gwoi Daam lǝ lomu!&gt;&gt; <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />Ya nanung to gu nhǝm nung vullǝ gi Fuh kwɔ gei angǝ,&lt;&lt;Bǝ yiɗi bǝim lǝ ba kǝm Fuhm, dǝna lim mangǝn lua.&gt;&gt;<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Yakku ya Yahudawa gwab nwa i bǝ ɓibbu ba angǝ,&lt;&lt;Ən nungfǝmlo ɓǝ ma to kwɔ yangbǝ ɓi ibǝi ma ɓuan ma to nungkwɔ ɓa?&gt;&gt;<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />Yeso gwabnwa angǝ,&lt;&lt;Ɓa dǝrr kǝm kwɔ ɓa wulǝ sua, langkwoi dang bo tai mǝn mai.&gt;&gt;<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />I ɓib Yeso angǝ,&lt;&lt;Ma mai langkwoi dang bo tai la? ya yahudawa lǝi ttha thǝmrab iu Nanakun kwɔ i mai lǝ kǝm pinwa kwɔ!&gt;&gt;<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />Kǝm nyǝknung kwɔ Yeso dǝna gei bko kwɔ ǝn tthǝu. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Viikwɔ Fuh ǝrlǝ Yeso i nwongǝi gu, ya nanung to gu nhǝm angǝ u gei nungkwɔ tthǝng, nungkwɔ i dǝ ba a langǝ i tthǝ nungvullǝ i nungkwɔ Yeso geitthǝ ɓǝ.<verse eid="JHN 2:22" /></para>
  <para style="s">Yeso I Dang Wa Yayuu Əndǝi</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />Kwɔ Yeso dang Urshalima dang ɓang nyang lo, yayuu kpaatthǝ dǝ ba a langǝ i tthǝu kwɔ i ɓyǝa nung fǝmlo kwɔ u toɓǝ.<verse eid="JHN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 2:24" />Kwoi Yeso gwab tha i ilǝ lǝu, bakwɔ u ibǝ nung ǝndǝing ɓǝ. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />Ba yangǝu kwɔ yuu akun a geiu tthǝ lǝ ba loi ɓǝ bakwɔ u i dang wai ǝndǝing ɓǝ.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">Yeso I Nikodimu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Yikku ya Farisiyawa akun tthǝ ɗuǝnu ǝn Nikodimu, u dang ya yahudawa. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Nungvii akun tthǝ u tǝ sua Yeso tǝu geiu angǝ,&lt;&lt;Ya nanatthǝnung, ɓi ibǝi yang mǝn ya nanatthǝ nungkwɔ Fuh tumma ɓǝ. Yuu akun yangǝu a to nungfǝmlo kwɔ dǝma to ɓǝu nǝ Fuh i ulǝ ɗǝ.&gt;&gt;<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />Yeso gwab nwa angǝ,&lt;&lt;Dǝm gei ba a langǝ i tthǝ: yuu yangǝu a ɓyǝa bǝ lo yigwoi Fuh nǝ i siu akun ɗǝ.&gt;&gt;<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />Nikodimu ɓib Yeso angǝ yuu akwɔ ghaang kwɔ i tonǝnǝ i siu akuna?&gt;&gt;U ɓuan u tǝ dang wa naa gu yangbǝ i siu akuna!&gt;&gt;<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />Yeso gei angǝ, &lt;&lt;Dǝm gei ɓǝ ba a langǝ i tthǝ, yuu akun yangǝu kwɔ atǝ bǝ lo yigwoi Fuh kwɔ i siu i mungki i Ɓyang lǝu ɓǝ <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Sualtthǝ a si sualtthǝ, kwoi Ɓyang a si Ɓyang. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />Bǝ fǝmlo mǝ thǝ bakwɔ ǝn gei gǝngǝ nǝ i si akun ɗǝ thǝ. <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />Wa dǝna ɓuob bǝikwɔ yiɗi ɓǝ ǝndǝi; malǝ vǝmmu kwɔ dǝna ɓuob ɓǝ, a ibǝi bǝi kwɔ ǝrr tthǝ ɓǝlǝu langkwoi bǝikwɔ dǝnnu tǝtthǝ ɓǝlǝu. Manung kwɔ ni i yuu akwɔ ǝndǝi i siu dang ɓyang a langǝ i ɓǝ.&gt;&gt;<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />Nikodimu ɓib angǝ,&lt;&lt;Nungkwɔ a totthǝ nǝnǝ?&gt;&gt;<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />Yeso gwab nwa angǝ, &lt;&lt;Mǝlǝ ya nanatthǝ nung angǝ a dang Israila, yang a ibǝi lǝu?<verse eid="JHN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 3:11" />Dǝm gei ba a langǝ i tthǝ: ɓi gei ba lo nungkwɔ ɓi ibǝi ɓǝ langkwoi ɓi gei nungkwɔ ɓi ɓyǝa ɓǝ, yirrǝ yuu akun yangǝu dang ɓǝ gwab ba ɓi. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Ɓa dǝba a langǝ i tthǝ bam lǝu kwɔ ǝn gei ɓǝ ba lo nung longwam kwɔ tthǝɓǝ; Ɓa tonǝnǝ ɓa dǝba a langǝ i tthǝm, kwɔ nǝ ǝn geiɓǝ ba nung a wayi tthǝ?<verse eid="JHN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 3:13" />Yuu akun yangǝu tǝ wayiu ǝn Yui Yuu ɓuo, kwɔ wua wayi ɓǝ.&gt;&gt;<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />Manungkwɔ Musa lǝi biǝk ɓui wayi nwa kab losua a kwi, manungɓǝ Fuh a lǝi Yui Yuu yi, <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />yangbǝ yuu akwɔ dǝ ba a langǝ i tthǝu a tǝi nwongǝi a ɗing.<verse eid="JHN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16" />Bakwɔ Fuh yiɗi longwam ɗing nungkwɔ u dǝ yuiu, yangbǝ yuu akwɔ dǝ ba a langǝ i tthǝu yang ɓuiu u tǝi nwongǝi a ɗing. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />Bakwɔ Fuh tum yuiu longwam yangbǝ u mǝrrǝm lǝ ya to kwan lǝ longwam tthǝ lǝu, kwoi yangbǝ u mǝrrǝm ya nwong loi.<verse eid="JHN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18" />Yakwɔ dǝba a langǝ i tthǝ Yuilǝ i toi kwan tthǝu; kwoi yakwɔ dǝba a langǝ i tthǝu lǝu i toi kwan tthǝ yang, bakwɔ i dǝ ba a langǝ i tthǝ Yui Fuh kwɔ kun ɓǝlǝu. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />Kwan ɓǝ manungkwɔni; nung gabbǝi wua longwam, kwoi yayuu yiɗi bǝ baithǝl pǝl nungabbǝi, bakwɔ nung to gi ǝn mullub.<verse eid="JHN 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 3:20" />Yakwɔ dǝna to nung a ɓko gwab luko langkwoi i wuo bǝi a kai kaiu, bakwɔ i yiɗi nung a ɓko gi igwam lǝu.<verse eid="JHN 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 3:21" />Kwoi yakwɔ dǝna to a langǝ i i wuo bǝi a kaikai yangbǝ bǝi kaikai ɓǝ tanatthǝ nungkwɔ dǝi to lǝ surr Fuh.<verse eid="JHN 3:21" /></para>
  <para style="s">Yeso I Yohanna Ya Wolmung</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Tthasua nungkwɔ, Yeso i ya nanung to gu tǝ losua Yahudiya, bǝi lǝ u ǝǝ i ilǝ tuab dǝu wollmung lǝ yayuu. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />Yohanna dǝna wollimung Ainon gbag Salima, bakwɔ mungki kpaaɗing bǝi lǝ ɓǝ. Yayuu dǝna tǝ suo, dǝu wollimung. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />Nungkwɔ to nung nwuni bǝ i kubli Yohanna.<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />Yakun dang ya nanung to gi Yohanna tǝbǝ muo nwatha i ya Yahudawa akun lo bǝ ɗiggǝ yuu itthǝ. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />I tǝ sua Yohanna tǝi geiu angǝ, &lt;&lt;Ya nanatthǝnung, a nhǝm yiɓǝi kwɔ suatha i mǝ thaa gwɔpi nwa dual Urdun, yuu akwɔ a gei bagu ɓǝ? La langǝ i. Dǝu wollmung lǝ yayuu lakwɔ, yayuu dǝna tǝ suo!&gt;&gt;<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />Yohanna gei angǝ, &lt;&lt;Yuu yangǝu kwɔ a tǝi nung akun nǝ ǝn Fuh duu ɗǝ. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Ɓǝ i naɓǝ lǝ ya shǝdǝm kwɔ ǝn gei gǝngǝ,&lt;Ɓanglǝ Kristi lǝu, kwoi i tummǝm ǝn owhsi ǝn wuo yangbǝ u wuo tthasuam.&gt; <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Yuu dǝb yisi ǝn u kwɔ munthang ayisi lǝ abo; ya ǝnthǝ gi yuu dǝb yisi kwɔ dǝi nwangwu u dǝ ɓuasui nalǝ, dǝilǝ tthǝla nǝ i lǝ yol yuu dǝb yisi ɓǝ. Nungɓǝlǝ nunglǝi kwɔ tthǝllam tthǝ ǝndǝi ɓǝ. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />U mǝrǝm lǝ ya ghaali; Mǝn mǝrǝmlǝ a tuab.&gt;&gt;<verse eid="JHN 3:30" /></para>
  <para style="s">Yuu Akwɔ Wuo Wayi Ɓǝ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />Yuu akwɔ wuo wayi kwɔ u pǝl yayuu ǝndǝi. Yuu akwɔ nǝ u tthǝn pangsua u ǝn ya pangsua u gei ba lo nung pangsua, kwoi yuu akwɔ wuo wayi kwɔ pǝl suanung ǝndǝi. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />Dǝu gei nungkwɔ u ɓyǝa langkwoi u lǝ ɓǝ, yirrǝ yuu akun yangǝu gwab ba gu.<verse eid="JHN 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 3:33" />Kwoi yuu akwɔ nǝ muo ba gu yang gwabǝng angǝ Fuh ǝn a langǝ i. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Yuu akwɔ Fuh tumm dǝna gei ba gi Fuh, bakwɔ Fuh duu Ɓyang gu ghaatthǝ. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />Daa dǝna yiɗi Yuiu nungkwɔ u duu nung ǝndǝi dang nko. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Yuu akwɔ dǝ ba a langǝ i tthǝ Yui fuh tthǝ i nwongǝi a ɗing; yuu akwɔ la ba gi Yui ɓǝ a tang zuii.<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">Yeso I Yisi Ya Samariya</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Kwo Yeso ibǝi ya lǝ Farisiyawa lǝ angǝ dǝi tǝi ya nanung to langkwoi dǝnni wollimung pǝl a bǝ Yohanna.<verse eid="JHN 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 4:2" />La langǝ i, Yeso wollmung lǝ yuu akun lǝu; ǝn ya nanung to gu to. <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Kwɔ Yeso lǝ nungkwɔ dǝnni gei kwɔ, u yitthǝ Yahudiya u tǝ Galili; <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />U lolǝi dǝu tǝ u muo ttha Samariya.<verse eid="JHN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5" />Dang Samariya u wuo gwoi angǝ a akuntthǝ ɗuǝn bǝiɓǝ angǝ Saikar, tutha i pangsua kwɔ Yakubu dǝlǝ yuiu Yusufu ɓǝu. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Ɓua mung gi Yakubu bǝilǝ, thǝm Yeso ba tthko kwɔ u tthko ɓǝ, u ǝǝ bǝilǝ nwaɓua munglǝ. Fuh gɓag nyilo.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />Yisi ya Samariya akun wuo bǝ ɓa mungki, nungkwɔ Yeso geiu angǝ,&lt;&lt;A dǝm mungki tthǝ ǝn nwa.&gt;&gt; <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />Ya nanung to gu tǝ dang ganglang gwoi tǝbǝ ɗyǝab nung tang.<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />Yisi ɓǝ gwab nwa angǝ,&lt;&lt;Mǝ ǝnya Yahudawa, ɓang ya Samariya baɓǝ bǝ ma geim mangǝ ǝn da mumgki a nwanwa?&gt;&gt;Ya Yahudawa nwa mung dang ɗǝithang kun i ya Samariyko&gt;&gt;<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />Yeso gwab nwa angǝ,&lt;&lt;Nǝ krǝ a ibǝ nungkwɔ Fuh dǝna dǝ langkwoi yuu kwɔ dǝna ɓibba mungki a nwanwa kwɔ, ma ɓibbu, u da mungki dǝ nwongǝi.&gt;&gt;<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />Yisi ɓǝ gei angǝ yuu gwoi, &lt;&lt;A yangǝu i nung ɓamungǝu, ɓua mung ɓǝ tuɗing. Ma tǝi mungki nwongǝi ɓǝla? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />Ən Bǝba ɓi Yakubu dǝɓi ɓuamung ɓǝ; u i yathang gu i nungbyang gu ǝndǝi nwa mungki bǝi lǝ. Dǝmma yiɗi bǝ gei mangǝ a pǝl Yakubu, niǝ?&gt;&gt;<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />Yeso gwab nwa angǝ,&lt;&lt;Yakwɔ nwa mungki kwɔ ɗimung a tǝi ǝn tǝi langkwoi, <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />Kwoi yakwɔ a nwa mungki kwɔ mǝn ji kwɔ ɗimung tǝi akunu. Mungki kwɔ mǝn ji kwɔ a mǝrrǝm lǝ bǝ nyinyak kwɔ a du mungki nwongǝi a ɗing a du nwongǝi a ɗing ɓǝ.&gt;&gt;<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />Yisi ɓǝ geiu angǝ,&lt;&lt;Yikku, a dǝm mungki ɓǝ! Yangbǝ bǝ ɗimung tǝim akun thǝ, yangbǝ langkwoi bǝ ǝn wuo bǝi kwɔ dǝmǝn wuo bǝ ɓa mungki thǝ.&gt;&gt;<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />Yeso gei angǝ,&lt;&lt;A tǝ ta lubǝ ɓǝimǝ,&gt;&gt;Yangbǝ a kwoi.&gt;&gt;<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />U gei Yeso angǝ,&lt;&lt;ɓǝim yangǝu,&gt;&gt;</para>
  <para style="p" vid="JHN 4:17">Yeso gei angǝ,&lt;&lt;Ən pǝllǝ mǝ lǝu nǝ a gei mangǝ ɓǝimǝ yangǝu ɓǝ. <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />A dǝb yaɓǝi nu, langkwoi yiɓǝi kwɔ a ǝǝ i ulǝ lakwɔ ǝn ɓǝimǝ lǝu. A geim ba a langǝ i tthǝng.&gt;&gt;<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />Yisi ɓǝ gei angǝ, yikku&lt;&lt;Dǝm ɓyǝa mǝn ya gei ba a tthasi,&gt;&gt; <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />&lt;&lt;Ya bǝbam wab Fuh lotal kwɔ, kwoi yang ɓǝ ya Yahudawa ɓa gei ɓangǝ Urshalima lǝ bǝikwɔ ɓi wab Fuh tthǝɓǝ.&gt;&gt;<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />Yeso geiu angǝ,&lt;&lt;Adǝ ba a langǝ i tthǝm, yisi, lona dǝna wɔ kwɔ yayuu wab Daa lotal kwɔu ko Urshalima. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Ɓǝ ya Samariyawa ɓa ibǝ yuu akwɔ lalangǝ i dǝɓa wabɓǝ lǝu; kwoi ɓi ya Yahudawa ɓi i yuu akwɔ dǝɓi wab ɓǝng, bakwɔ tthǝn tthǝ ya Yahudawa bǝ nwongbǝi wuo. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Kwoi lona dǝna wɔ lona ɓǝkwɔ, u tthǝ bǝi kwɔ, kwɔ i tthǝ nyimmi Ɓyang gi Fuh yayuu a dǝ angǝ a lǝ Daa angǝ ǝn uɓǝ, i du angǝ a la langǝ i kwɔ u yiɗi ɓǝ. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />Fuh ǝn Ɓyang, yakwɔ a wabbu kwɔ a wabbu i Ɓyang langkwoi i ba a langǝ i.&gt;&gt;<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />Yisi ɓǝ geiu angǝ,&lt;&lt;Ən ibǝing Kristi dǝna wɔ, nǝ u wuo yang u gei ɓi nungkwɔ tthǝ ǝndǝi.&gt;&gt;<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />Yeso gwab nwa angǝ,&lt;&lt;Ən ɓang kwɔ dǝm gei ba i mǝlǝ ɓǝ.&gt;&gt;<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />Dang ba gulǝ kwɔ yang ya nwatummi gu kwoi, loi dǝna fǝm bakwɔ wui tǝiu dǝnnu gei ba i Yisi kwɔ ɓǝ. Kwoi yuu akun yangǝu dang ǝi lǝ geiu ba angǝ,&lt;&lt;Ənɓǝ dǝma yiɗi?&gt;&gt;Ko ɓibbu angǝ, &lt;&lt;Baɓǝ bǝ dǝmma gei ba i ulǝ?&gt;&gt;<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Nungkwɔ yisi ɓǝ yitthǝ bko ɓamung gu, u kwoi u tǝ dang ganglang gwoi, tǝu gei lǝ yayuu kwɔ bǝilǝ kwɔtthǝ angǝ, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />&lt;&lt;Ɓa wɔ wu ɓa ɓyǝa yiɓǝi kwɔ geim nungkwɔ tthǝ ǝndǝi ǝn to ɓǝ. U lǝ ya nwong lo ɓaa?&gt;&gt; <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />I yitthǝ gwoi angǝ a i tǝ sua Yeso.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />Manungkwɔ ni yang ya nanung to gu dǝna ɗyǝab bu angǝ, &lt;&lt;Ya nanatthǝnung, a muo nungtang a tang!&gt;&gt;<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />U gei angǝ,&lt;&lt;Ɓang tthǝ i nungtang kwɔ mǝn tangkwɔ ɓa ibǝ nung lolǝ lǝu ɓǝ.&gt;&gt;<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />Ya nanung to gu tǝbǝ ɓib tha angǝ,&lt;&lt; Lko yuu akun wuoulǝ nungtang tthǝng tthai wai?&gt;&gt;<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />Yeso gei angǝ,&lt;&lt;Yeso gei angǝ, &lt;&lt;Nungtangǝm nungɓǝlǝ, ǝn to nungto i bagi yuu kwɔ tumǝm kwɔ ǝnto ǝn alo.<verse eid="JHN 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 4:35" />Ɓǝtthǝ i bǝ yinwa ba ɓangǝ,&lt;Sua fyi nai yang i ɓǝr min.&gt;Kwoi ǝn gei ɓǝtthǝ, ɓa ɓyǝa dang zuk; min ɗong nabǝ ɓǝrrǝung!<verse eid="JHN 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 4:36" />Yuu akwɔ dǝna ɓǝr min kwɔ a tǝi nung busoni gu, langkwoi dǝu gǝm min ɓǝ lǝ ba nwongǝi a ɗing; yuu akwɔ bie i yuu akwɔ ɓǝrr i lǝ tthǝla ǝndǝi.<verse eid="JHN 4:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 4:37" />Bǝ yinwa bakwɔ ǝn ba a langǝ i &lt;Yuu akun bie, yuu akun ɓǝrr.&gt;<verse eid="JHN 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 4:38" />Ən tumɓǝ gǝ tǝɓa ɓǝrr min bǝikwɔ ɓa tonungto tthǝlǝu ɓǝ; yakun tonungto bǝilǝ, yang ɓa tang nung busoni gi.&gt;&gt; <verse eid="JHN 4:38" /><verse number="39" style="v" sid="JHN 4:39" />Ya Samariya kpaatthǝ kwɔ dang gwoi angǝ a lǝ kullo dǝba a langǝ i tthǝ Yeso bakwɔ yisi kwɔ gei angǝ,&lt;&lt;U geim nungkwɔ tthǝ ǝn to ǝndǝi ɓǝ.&gt;&gt; <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />Nungkwɔ ya Samariya wɔ suo, i ɗyǝab bu angǝ u ǝǝ i ilǝ, Yeso ǝǝ bǝilǝ bo rab.<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />Yayuu kpaatthǝ dǝ ba a langǝ i tthǝ lǝ bagu, <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />I gei yisi ɓǝ angǝ,&lt;&lt;Ɓi dǝ ba a langǝ i tthǝng lakwɔ, lǝ ba bakwɔ a gei ɓǝlǝu, kwoi bakwɔ ɓi i naɓi ɓi lǝiung kwɔ, langkwoi ɓi ibǝi u ǝn ya nwong longwam kwɔ.&gt;&gt;<verse eid="JHN 4:42" /></para>
  <para style="s">Yeso Ilǝ Nungzi Tthǝ Yui Yikku Akun</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Tthasua kwɔ Yeso to bo rab bǝilǝ, u pa u tǝ Galili.<verse eid="JHN 4:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 4:44" />Bakwɔ yeso i nko lǝ u gei angǝ,&lt;&lt;Ya gei ba a tthasi tǝi angǝ a losua gu.&gt;&gt; <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Kwɔ u wuo Galili, ya Galili kǝb lo, bakwɔ i tǝ ɓang nyang lo dang Urshalima i ɓyǝa nungkwɔ ǝndǝi u to dang ɓanglǝ ɓǝng.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />Yeso kwoitǝ kan'ana losua Galili, bǝikwɔ u mǝrrǝm mungki lǝ min ɓǝ. Ya to nung to gwamnati bǝilǝ kwɔ tthǝ yuiu lko Kafarnahum ɓǝ. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Kwɔ u lǝ angǝ Yeso ǝrr Yahudiya wɔ Galili yang, u tǝ suo tǝu ɗyǝab bu angǝ u tǝ Kafarnahum tǝu ilǝ nungzii tthǝ yui, kwɔ dǝna tǝ bǝ ɓuiu ɓǝ. <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />Yeso geiu angǝ,&lt;&lt;Yuu akun yangǝu dang ɓǝ a dǝba a langǝ i tthǝmmu nǝ ɓa ɓyǝa nung fǝmlo ɗǝ.&gt;&gt;<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />Yikku ɓǝ gei angǝ, yuu gwoi, &lt;&lt;Nǝ a wɔ suatha i ɓanglǝ lǝu yang yuim a ɓumɓui.&gt;&gt;<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />Yeso geiu angǝ,&lt;&lt;A tǝ, yui mǝ a sunsob!&gt;&gt;Yiɓǝi ɓǝ dǝ ba a langǝ i tthǝ ba gi Yeso ǝrr pa. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />U lolǝi dǝu tǝgwoi thǝb gu kǝbbu lolǝi i nwa balǝ angǝ,&lt;&lt;Yui mǝ a yiɓǝi a sunsob!&gt;&gt;<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />U ɓib angǝ lona nǝnǝ kwɔ yui ɓǝ tǝi tthǝ la ɓa, i gwab nwa angǝ,&lt;&lt;Dangfuh lona kun lali kwɔ tthǝsonni ɓǝ yiu naɓǝ.&gt;&gt; <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />Nwuni Daa ɓǝ ibǝi u lona ɓǝkwɔ Yeso geiu angǝ.&lt;&lt;Yuimǝ a sunsob ɓǝ.&gt;&gt; Nungkwɔ u i ya dang gwoi gu dǝ ba a langǝ i tthǝ.<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />Nungfǝmlo a nung rabbu kwɔ Yeso to nwuni bǝ u yitthǝ Yahudiya u tǝ Galili ɓǝ.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">Bǝ Dǝ Tthǝla Ɓuasuab</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Tthasua nungkwɔ, Yeso tǝ Urshalima bǝ to ɓang ya Yahudawa.<verse eid="JHN 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 5:2" />Gbag nwa kǝm ɓangam Urshalima lǝ ɓuasuab tthǝ dǝi lu angǝ Batsaida i nwa ya Yahudawa nwalǝgwoi nu; <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Ya nungzii kpaatthǝ dǝna lo bǝilǝ ya nungɓuommi, ya kuglǝ i ya ɓui bo i na ɓǝ i lo gɓag nwa mungɓǝ dǝi ki. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />Bakwɔ ya nwatummi gi Fuh dǝna pin vii lǝ vii dang ɓua suab ɓǝ, langkwoi lang mung ɓǝ, tthasua bǝ lang mung ɓǝ yuu akwɔ nǝ owhsi tǝ dang mung ɓǝ u tǝi tthǝla ǝndǝi. <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />Yiɓǝi akun tthǝ bǝilǝ kwɔ tthǝu lko tthaa thǝmkun pǝmna sob iu ngunai <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />Yeso ɓyǝko lo bǝilǝ, Yeso ibǝi yiɓǝi ɓǝ tthǝu lko laku; u ɓibbu angǝ,&lt;&lt;Dǝma yidɗi bǝ tǝi tthǝllama?&gt;&gt;<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />Yiɓǝi ya nungzii ɓǝ gwab angǝ,&lt;&lt;Yikku, Ən yangǝu i yuu akwɔ a tǝmlǝ dang ɓuasuab ɓǝ nǝ i lang mungɓǝ ɓǝu; nǝ dǝm yiɗi bǝ tǝ dang mungɓǝ yang, yuu akun omsi lang tǝtthǝ.&gt;&gt;<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />Yeso gei ya nungzii ɓǝ angǝ,&lt;&lt;A ǝrr a dǝi nǝbo, lǝi gei mǝ a thko.&gt;&gt;<verse eid="JHN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 5:9" />Ba a nwaɓi kwɔ yiɓǝi ɓǝ tǝi tthǝla gu; u lǝi gei gu u tǝbǝ thko.</para>
  <para style="p" vid="JHN 5:9">Viikwɔ nungkwɔ tonung tthǝ kwɔ ǝn vii nwongǝi ya Yahudawa, <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />Nungkwɔ yakku ya Yahudawa gei yuu akwɔ i ilǝ nung zii tthǝu kwɔ angǝ,&lt;&lt;Ɗiggǝ ǝn Vii nwongǝi, nung zuu ɓi gwab kwɔ ma lǝi gei mǝ ɓǝlǝu.&gt;&gt;<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />Kwoi u gwab nwa angǝ,&lt;&lt;Yiɓǝi kwɔ dǝm tthǝ la kwɔ u geim angǝ ǝn lǝi geim ǝn thko.&gt;&gt;<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />Nungkwɔ i ɓibbu angǝ,&lt;&lt;Yiɓǝi ɓǝng yittǝn kwɔ gei angǝ a to nungkwɔ ɓa?&gt;&gt;<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />Kwoi yiɓǝi kwɔ i du tthǝla kwɔ ibǝi Yeso ǝnya lǝu, bakwɔ yayuu kpaani bǝilǝ ɓǝ, Yeso brǝm paǝng bǝilǝ.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />Natthǝ, Yeso tǝiu dang kǝm Nyǝknung tthǝ Fuh langkwoi geiu angǝ,&lt;&lt;A lǝ, a tǝi tthǝlang lakwɔ; a yitthǝ bǝ to nung a ɓko nilǝu yang nung akun ɓkotthǝ a tǝi.&gt;&gt;<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />Nungkwɔ yiɓǝi ɓǝ patǝ gei lǝ yakku ya Yahudawa tthǝ angǝ ǝn Yeso ji tthǝ la. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />Nungkwɔ ya Yahudawa ǝrr dǝna ɗu yurrǝ tthǝ Yeso, bakwɔ u ilǝ nung zii tthǝ yiɓǝi kwɔ Vii nwongǝi ɓǝ. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />Yeso gwabbǝi nwa angǝ,&lt;&lt;Daam dǝna tonungto vii ǝndǝi, ɓang ma langɓǝ mǝn to nungto.&gt;&gt;<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />Bakwɔ ǝrrlǝ kiggǝ yakku ya Yahudawa dǝnni ɗu bǝ thǝbbu; u ɓanglǝ ǝn nungzuu Vii nwongǝi ɓuo lǝu, kwoi bakwɔ u gei angǝ Fuh lǝ Daa gi ɓǝ manungkwɔni yang dǝu nalo lǝtha i Fuh.<verse eid="JHN 5:18" /></para>
  <para style="s">Tthǝ Nyimmi Gi Yui</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Nungkwɔ Yeso gwabǝi nwa angǝ,&lt;&lt;Ən gei ɓǝ ba a langǝ i tthǝ: Yui ɓuan to nung akun i nkolǝu; u to nungkwɔ u ɓyǝa Daa gu dǝna to ɓǝ. Nungkwɔ Daa dǝna to, nungɓǝ lang, Yui dǝna to. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Bakwɔ Daa dǝna yiɗi Yui ɓǝ nungkwɔ u tkonatthǝ nungkwɔ ǝndǝi dǝu toɓǝ. U tkonatthǝ nung akwɔ ghaa pǝl akwɔ, yangbǝ ɓǝ ǝndǝi loɓǝ fǝmtthǝ. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Manungkwɔ Daa ǝrr lǝ ya ɓui ɓua u ji nwongǝi, manungɓǝ Yui dǝ nwongǝi lǝ yakwɔ u yiɗi ɓǝ. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />Daa to kwan lǝ yuu akun tthǝu. U dǝ tthaa bǝ to kwan lǝ Yuiu, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />Yangbǝ yayuu ǝndǝi dǝ angǝ a lǝ Yui manungkwɔ i dǝlǝ Daa ɓǝ. Yuu akwɔ nǝ dǝ angǝ a lǝ Yui lǝu yang dǝ angǝ a lǝ Daa kwɔ tummu ɓǝ lǝu.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />&lt;&lt;Dǝm gei ɓǝ ba a langǝ i tthǝ: yakwɔ lǝ bam yang dǝ ba a langǝ i tthǝ yuu akwɔ tumǝm kwɔ tǝi nwongǝi a ɗing. I toi kwan tthǝu, kwoi i osi i pa bǝ ɓui ɓua itǝ bǝ nwongǝing. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />Dǝm gei ɓǝ ba a langǝ itthǝ: lona dǝna wɔ lona ɓǝ osi wung kwɔ kwamɓui yuu a lǝ yol Yui Fuh, langkwoi yakwɔ lǝ kwɔ i tǝi nwongǝi. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Manungkwɔ Daa ɓǝ i nko lǝ lǝ nunglǝi nwongǝi a ɗing, manungɓǝ u mab yuiu lǝ nunglǝi nwongǝi. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />Langkwoi u dǝ Yui ɓǝ nunglǝi bǝ to kwan, bakwɔ u ǝn Yui Yuu ɓǝ. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />Bǝ loɓǝ fǝmtthǝ nungkwɔ thǝ; vii dǝna wɔ kwɔ kwamɓui yayuu a lǝ yollǝu dang juǝn gi <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />Yang i idang juǝn gi: yakwɔ to matthǝ i ǝrr i nwongǝi, yakwɔ to mko i ǝrr yang i ɓui ɓua a ɗing.<verse eid="JHN 5:29" /></para>
  <para style="s">Shaida Gi Yeso</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />&lt;&lt;Nung akun yangǝu mǝn to i tthǝ nyimmim mu; Dǝm to kwan manungkwɔ Fuh geimtthǝ angǝ ǝn toɓǝ, kwanǝm lozuiiu, bakwɔ dǝm to nungkwɔ dǝm yiɗi ɓǝlǝu, kwoi nungkwɔ yuu akwɔ tummǝm kwɔ dǝna yiɗi ɓǝ.<verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />&lt;&lt;Nǝ ǝn gei ba lom i namlǝ, nungkwɔ ǝn gei kwɔ yayuu gwabbu angǝ ǝn ba a langǝ i lǝu. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Kwoi yuu akuntthǝ kwɔ a gei nwam, langkwoi ǝn ibǝi yang nungkwɔ u gei kwɔ ǝn ba a langǝ i<verse eid="JHN 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 5:33" />Ɓa tum ya nwatummi ɓǝ sua Yohanna, u gei ba nwa ba a langǝ i. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Ən geigǝ ǝn gwab nwa ba tha yuu lǝu; ǝn gei nungkwɔ ɓuo yangbǝ ɓa tǝi nwongǝi. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />Yohanna mangǝn nung gablua, dǝu li dǝu gabbǝi, langkwoi ɓa yidɗi bǝ lǝ tthǝla lua gu tuab ɓuo. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />Kwoi ɓang tthǝ i ya gei nwam kwɔ u ghaa u pǝll shaida kwɔ Yohanna dǝɓǝ: nungkwɔ ǝnto, nungɓǝlǝ, nungto kwɔ Daam dǝm angǝ ǝnto ɓǝ, i nungɓǝ kwɔ dǝna gei nwam langkwoi dǝna tanatthǝ lǝ yayuu ǝn Daa tummǝm. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />Langkwoi Daa, kwɔ tummǝm kwɔ, langɓǝ dǝna gei nwam. Ɓa lǝ yollǝu lǝu ko ɓa ɓyǝa dang nungǝu lǝu bo kun, <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />langkwoi ɓa dǝ bagu dang nyi ɓǝlǝu, ɓa dǝ ba a langǝ i tthǝ yuu akwɔ tummǝm ɓǝlǝu.<verse eid="JHN 5:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 5:39" />Dǝɓa than nungvullǝ, bakwɔ dǝ ɓa nhǝm ɓa tǝi nwongǝi a ɗing dang ǝulǝ. Nungvullǝ kwɔ dǝna gei ba lomlǝ! <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />Yirrǝ ɓa yiɗi bǝ wuo suam yangbǝ ɓa tǝi nwongǝi lǝu.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />Dǝm ɗu bǝ khabǝi na yayuu lǝu.<verse eid="JHN 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 5:42" />Kwoi ǝn i ɓǝng ɓa yangǝu i bǝ yiɗi Fuh dang nyi ɓǝlǝu. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Ən wuo i tthǝnyimmi gi Daam, kwoi ɓa muom lǝu, kwoi nǝ yuu akun wuo i tthǝnyimmi gu, ɓa muo ǝn muo.<verse eid="JHN 5:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 5:44" />Dǝɓa yiɗi bǝ muo bǝ khabǝi natha, kwoi ɓa ɓatǝi bǝ khabǝi na yuu kwɔ kun lǝ Fuh ɓǝlǝu; nǝnǝtǝn, yang, ɓa gwab bam? <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />Bǝ ɓa nhem, ɓangǝ ǝn ɓang mǝn ɓuob nwa lo ɓǝ lǝ Daam tthǝthǝ. Musa, kwɔ ɓa dǝnyitthǝu lǝ kwɔ, ulǝ yuu akwɔ a ɓuob nwa loɓǝ ɓǝ. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Nǝ ɓa dǝ ba a langǝ i tthǝ Musa, yang krǝ ɓa dǝ ba a langǝ i tthǝmlǝng, bakwɔ u vullǝ nung lǝ bam. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Kwoi kwɔ ɓa dǝ ba a langǝ i tthǝ nungkwɔ u vullǝ ɓǝlǝu, ɓa to nǝnǝ ɓa dǝ ba a langǝ i tthǝ nungkwɔ ǝn gei ɓa?&gt;&gt;<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">Bǝ Tanglǝ Yayuu Thǝmsob Ɓua Thǝm Kun Iu Nu</para>
  <para style="r">(<ref loc="MAT 14:13-21">Matthew 14:13-21</ref>; <ref loc="MRK 6:30-44">Markus 6:30-44</ref>; <ref loc="LUK 9:10-17">Luka 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Tthasua nungkwɔ, Yeso nyang mung Galili (ko, Mung Tibariya, manungkwɔ dǝi luɓǝ). <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />Gong kon muo suo, bakwɔ i ɓyǝa nungfǝmlo bǝ dǝ tthǝla lǝ ya nungzii ɓǝ. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />Yeso ɗab ɓǝmɓǝmtal tǝ ǝǝ tthǝ iya nanung to gu.<verse eid="JHN 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 6:4" />Lona ɓang nyang lo ya yahudawa gbag yang. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />Yeso ɓyǝa bǝi mǝrrǝm kǝb u ɓyǝa kon yayuu dǝna wuu suo, nungkwɔ u ɓib Filibus angǝ,&lt;&lt;Ɓi ɗyǝab nungtang pǝlǝ kpaatthǝ yangbǝ ɓi tanglǝ yayuu kwɔ ǝndǝi?&gt;&gt; <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />Yeso gei bakwɔ yangbǝ u nalǝ Filibus; la langǝ i u owhsi u ibǝ nungkwɔ u to ɓǝng.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />Filibus gwabnwa angǝ,&lt;&lt;A lǝi nungkurɓǝ azurfa pa tthǝmsob kwɔ i ɗyǝab lǝ nungtang, nwuni bǝ koya ǝndǝi tǝi tuab.&gt;&gt;<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />Andarawas young saminu Bitrus Yuu akun dang ya nanung to gu, geiu angǝ, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />&lt;&lt; Yui akun tthǝ bǝi kwɔ i burodi nu i tthǝng rab. Kwoi nungkwɔ natthǝ yayuu ǝndǝiu.&gt;&gt;<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />Yeso gei angǝ,&lt;&lt; Ɓa gei yayuu ɓǝ ǝǝsua,&gt;&gt;(Gug kpaaɗing bǝi lǝ.) Nungkwɔ yayuu ɓǝ ǝndǝi ǝǝsua; yaɓǝi tthǝm sob ɓua thǝmkun iu nu. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />Yeso lǝi burodi ɓǝ, dǝ angǝ a lǝ Fuh, u dǝ lǝ yayuu kwɔ ǝǝ bǝi lǝ ɓǝ. U to manungɓǝ i tthǝng lǝ, i kwɔ ǝndǝi i tǝi kpaatthǝ manungkwɔ dǝi yiɗi ɓǝ. <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />Kwɔ i ǝndǝi i fǝr, u gei ya nanung to gu angǝ,&lt;&lt;Ɓa gǝm sua kwǝ nwuo kwɔ i yitthǝ ɓǝ; bǝ ɓi ɓanglǝ ko tuab thǝ. <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />I gǝm suo ǝndǝi yi kaɗuog sob iu rab i sua kwɔ nwuo kwɔ i ɓǝ dang burodi kwɔ nu kwɔ yayuu tangɓǝ.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />I bǝ ɓyǝa nungfǝmlo kwɔ Yeso to kwɔ, yayuu kwɔ bǝi lǝ kwɔ gei angǝ,&lt;&lt;Ba a langǝ i yuu akwɔ ǝn ya gei ba a tthasi kwɔ a wɔ longwam ɓǝ!&gt;&gt; <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />Yeso ibǝi yang dǝi wuo bǝ muu yangbǝ tǝi liu yigwoi tthǝ lǝ ttha; nungkwɔ u pa langkwoi u tǝ lo ɓǝmɓǝmtal i nungtthǝu lǝ.<verse eid="JHN 6:15" /></para>
  <para style="s">Yeso Thau Lo Mung</para>
  <para style="r">(<ref loc="MAT 14:22-33">Matthew 14:22-33</ref>; <ref loc="MRK 6:45-52">Markus 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Kwɔ fuh o, ya nanung to gi Yeso patǝ nwa mung, <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />i tǝ dang kwai, i kwoi i tǝ ttha Kafarnahum. Lakwɔ bǝi baithǝl lǝng, yirrǝ Yeso tǝ suai lǝu. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />Wa ǝrr dǝna ɓuob nyimtthǝ dǝna ǝrrlǝ mung. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Ya nanung to gu ɓǝ kog kwai ɓǝtǝ tuung goni tuli gi ɓǝ kǝn nu i Nanakun yang i ɓyǝa Yeso dǝna thko lo mung, dǝu wuo gbag kwai ɓǝ, tthǝi dǝna ɓuobtthǝm. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />Yeso gei angǝ,&lt;&lt;Bǝɓa survulli thǝ, ǝn ɓang!&gt;&gt; <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />Nungkwɔ i gwab i muu na i tǝlǝ dang kwai ɓǝ, dang tthǝ i kǝn nwangwam kwɔ dǝnni tǝɓǝ.<verse eid="JHN 6:21" /></para>
  <para style="s">Yayuu Ɗubǝ Yeso</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Ibǝi kan kon yayuu kwɔ ǝǝ nwangwam akulo ibǝi angǝ kwai ɓǝ kun ɓuo bǝilǝ. I ibǝi Yeso tǝ dang kwai ɓǝ i ya nanung to gu lǝu, i pa i yiu.<verse eid="JHN 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 6:23" />I kwai akun, kwɔ ǝrr Tibariya, I wuo bǝ dǝi gi kwai kwɔ gbag bǝi kwɔ Dangbang kha Fuh kwɔ kon yayuu tang nung tang tthǝ ɓǝ. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Kwɔ kon yayuu ɓyǝa Yeso yangǝu bǝilǝu, ya nanung to gu langɓǝ yangǝu bǝi lǝu, i ǝrr i tǝ dang kwai i tǝ Kafarnahum, dǝi ɗu bǝiu.<verse eid="JHN 6:24" /></para>
  <para style="s">Yeso Lǝ Nungtang Nwongǝi</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />Kwɔ yayuu ɓǝ tǝi Yeso nwa nwam akulo, i geiu angǝ,&lt;&lt;Ya nanatthǝnung, a wɔ bǝi kwɔ nǝɓa?&gt;&gt;<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />Yeso gwabnwa angǝ,&lt;&lt;Dǝm gei ɓǝ ba a langǝ i tthǝ: dǝ ɓa ɗu bǝim bakwɔ ɓa tang burodi langkwoi ɓa tǝi nungkwɔ dǝɓa yidɗi ǝndǝi ɓǝ, ǝn bakwɔ ɓa ibǝ nung fǝmlo kwɔ ǝn to ɓǝlǝu. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Bǝ ɓa to nung to lǝ ba nungtang kwɔ a ɓanglǝ ɓǝ thǝ; kaso, ɓa to nung to lǝ ba nungtang kwɔ a ǝǝ laɗing ɓǝ. Nungtang kwɔ Yui Yuu a dǝɓǝ, bakwɔ Fuh, Daa, dǝ bǝ gwab nwa lo lǝ.&gt;&gt;<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Nungkwɔ i ɓibbu angǝ,&lt;&lt; Ən ɓǝɓi to yangbǝ ɓi to nungkwɔ Fuh dǝna yidɗi angǝ ɓi to ɓa?&gt;&gt;<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />Yeso gwabnwa angǝ,&lt;&lt;Nungkwɔ Fuh dǝna yidɗi kwɔ ɓa dǝ ba a langǝ i tthǝ yuu akwɔ u tum ɓǝ.&gt;&gt;<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />I gei angǝ,&lt;&lt;Nung fǝmlo ɓǝtǝn kwɔ ma to kwɔ ɓi ɓyǝa yangbǝ ɓi dǝba a langǝ i tthǝmǝ ɓa? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Ya Bǝba ɓi tangnung tang kwɔ angǝ manna kwɔ dang gug, manungkwɔ nungvullǝ gi Fuh gei ɓǝ,&lt;U ji burodi wayilǝ i tang.&gt;&gt;&gt;<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />Yeso gei angǝ,&lt;&lt;Dǝm geiɓǝ ba a langǝ i tthǝ, Nungkwɔ Musa dǝɓǝ kwɔ ǝn burodi wayi lǝu; ǝn Daam a dǝɓǝ burodi a langǝ i wayilǝ. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Bakwɔ burodi kwɔ Fuh adǝ kwɔ ǝn yuu akwɔ wuo langkwoi dǝ nwongǝi lǝ longwam ɓǝ.&gt;&gt;<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />I ɓib angǝ,&lt;&lt;Yikku, a dǝɓi burodi kwo vii ǝndǝi.&gt;&gt;<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />Yeso gei angǝ,&lt;&lt;Ɓanglǝ burodi nwongǝi,&gt;&gt;&lt;&lt;Yakwɔ wuo suam gwom tǝiu; yakwɔ dǝ ba a langǝ i tthǝm ɗimung tǝiu.<verse eid="JHN 6:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 6:36" />Lakwɔ, ǝn gei ɓǝ gǝngǝ ɓa ɓyǝamǝng kwoi ɓa dǝba a langǝ i tthǝ lǝu.<verse eid="JHN 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 6:37" />Yuu akwɔ ǝndǝi kwɔ Daam dǝm u wuo suam. Ən nan yuu akwɔ wuo suamɓǝu, <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />Bakwɔ ǝn wuo wayi lǝba bǝ tonung tom lǝu ǝn ba nungto yuu akwɔ tummǝm ɓǝ.<verse eid="JHN 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 6:39" />Langkwoi yuu akwɔ tummǝm kwɔ yidɗi kwɔ yuu akun la dang yakwɔ u dǝm ɓǝlǝu, kwoi yang ǝn ǝrrilǝ i nwongǝi vii ǝrri longwam.<verse eid="JHN 6:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 6:40" />Bakwɔ nungkwɔ Daam da yiɗi kwɔ yakwɔ ɓyǝa Yui langkwoi dǝ ba a langǝ i tthǝu yang tǝi nwongǝi a ɗing. Langkwoi i ǝrrei lǝ vii ǝrri longwam,&gt;&gt;<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />Ya yahudawa ɓǝ tǝbǝ kwanwa lǝba kwɔ u gei ɓǝ, bakwɔ u gei angǝ, &lt;&lt;Ilǝ burodi kwɔ wuo wayi ɓǝ.&gt;&gt;<verse eid="JHN 6:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 6:42" />Nungkwɔ i gei angǝ,&lt;&lt;Yiɓǝi kwɔ ǝn Yeso yui Yusufu, ǝn u lǝu? Ɓi i Daa gu i Naa guǝn. Tonǝnǝ, yang, langkwoi u gei lakwɔ angǝ i wuo wayi?&gt;&gt;<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />Yeso gwab nwa angǝ,&lt;&lt;Ɓa yitthǝ bǝ kwanwa ɓuaɓǝ.<verse eid="JHN 6:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 6:44" />Yuu akun yangǝu a wɔ suammu ǝn yuu akwɔ Daa wuulǝ suam ɓǝ; langkwoi mǝn ǝrrǝulǝ i nwongǝi vii kwɔ longwam a ǝrrtthǝ ɓǝ.<verse eid="JHN 6:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 6:45" />Ya gei ba a tthasi vullǝ angǝ,&lt;Fuh a nanatthǝ nung lǝ yayuu ǝndǝi.&gt; Yuu akwɔ lǝ Daa langkwoi nanung nko u wuo suam.<verse eid="JHN 6:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 6:46" />Nungkwɔ ǝǝ mangǝ yuu a kun tthǝ ɓyǝa Daang; yuu akwɔ wuo tthang Fuh uɓǝ ɓuo u ɓyǝa Daa ɓǝ. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />Dǝm gei ɓǝ ba a langǝ i tthǝ: yuu akwɔ dǝ ba a langǝ i u tthǝ i nwongǝi a ɗing <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Ɓanglǝ burodi nwongǝi. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Ya bǝba ɓǝ tangnung tang kwɔ angǝ manna dang gug, kwoi i ɓui. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Kwoi burodi wuo wayi kwɔ ǝn akwɔ yuu kwɔ nǝ tang yang ɓuiu ɓǝ. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Ɓang lǝ burodi nwongǝi kwɔ wuo wayi ɓǝ. Nǝ yuu akun tang burodi ɓǝkwɔ, u ǝǝ laɗing. Burodi ɓǝkwɔ mǝn du kwɔ ǝn nyam tthǝm, kwɔ Ən dǝ yangbǝ longwam tǝi nwongǝi ɓǝ.&gt;&gt;<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />Nungkwɔ wulǝ bǝ nyimtha nwa ɓkotthǝ dang ya yahudawa lǝ.&lt;&lt;Yiɓǝi kwɔ a tonǝnǝ adǝ ɓi nyam tthǝu ɓi tang?&gt;&gt;<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />Yeso gei angǝ,&lt;&lt;Dǝm gei ɓǝ ba a langǝ i tthǝ: nǝ ɓa tang nyam tthǝ Yui Yuu langkwoi nwa ziiu lǝu, ɓa tǝi nwongǝi dang tthǝ ɓǝu.<verse eid="JHN 6:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 6:54" />Yakwɔ tang nyam tthǝm langkwoi nwa ziim i tthǝ i nwongǝi a ɗing, langkwoi mǝn ǝrri lǝ vii kwɔ longwam a ǝrtthǝ ɓǝ. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Bakwɔ nyamǝm lǝ nungtang a langǝ i; ziim lǝ nung a nwa a langǝ i. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Yakwɔ tang nyamǝm nwa ziim ǝǝ dang tthǝm, langkwoi ɓang dang ǝi. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />Daa a ɗing tummǝm, langkwoi lǝ bagu ɓang tthǝ i nwongǝi langɓǝ. Manungɓǝni yuu akwɔ tang nyammǝm a ǝǝ lǝ bam. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Nungkwɔ, yang, ǝn burodi kwɔ wuo wayi ɓǝ; natha i burodi kwɔ ya bǝba ɓǝ tang ɓǝlǝu, Natthǝ i ɓui. Kwoi yakwɔ tang burodi kwɔ a ǝǝ laɗing.&gt;&gt;<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />Yeso gei bakwɔ kwɔ dǝu nanatthǝ nung dang kǝm kǝbtha ya Yahudawa Kafarnahum ɓǝ.<verse eid="JHN 6:59" /></para>
  <para style="s">Ba Nwongǝi</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Ya muo suko kpaatthǝ lǝ bakwɔ nungkwɔ i gei angǝ,&lt;&lt;Nungna kwɔ ziɗing. Ən ya kab ɓua suaiu alǝ?&gt;&gt;<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />Kwɔ i geiu tthǝ lǝu ɓǝ, Yeso ibǝi yang ya nanung to gu dǝna nyinyi lǝ ba nungkwɔ, nungkwɔ u gei angǝ, &lt;&lt;Nungkwɔ toɓǝ dǝ ɓa yiɗi bǝ ɓanglǝ dang waa?<verse eid="JHN 6:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="JHN 6:62" />Kaso, yang, ɓa ɓyǝa Yui Yuu kwoi tǝ wayi bǝikwɔ utthǝ lanwasiu ɓǝ? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />Nungkwɔ dǝna dǝ nwongǝi kwɔ ǝn Byang gi Fuh; tthǝ nyimmi gi yuu ǝn nung akun lǝu. Bakwɔ ǝn gei ɓǝtthǝ kwɔ dǝna wulǝ nwongǝi Ɓyang gi Fuh. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Yirrǝ yakun dang ɓǝ dǝ ba a langǝ i tthǝ lǝu.&gt;&gt;Yeso ibǝi nungsi yakwɔ dǝ ba a langǝ i tthǝlǝu langkwoi yakwɔ a ɗyǝabbu. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />Langkwoi lilo, &lt;&lt;U nungkwɔ ǝn gei ɓǝtthǝ geigǝ yuu akun yangǝu a wɔ suammu nǝ ǝn Daa to manungɓǝni lǝu ɓǝ.&gt;&gt;<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />Lǝba bakwɔ, ya muo sua Yeso kpaatthǝ kwoi suo i muo suo akun lǝu. <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />Nungkwɔ Yeso ɓib ya nanung to gu sob iu rab angǝ,&lt;&lt;Bǝ ɓaɓǝ ɓǝma ɓa yiɗi bǝ pko?&gt;&gt;<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />Saminu Bitrus gwabbu nwa angǝ, &lt;&lt;Dangbang, ɓi tǝn sua ya? Mǝtthǝ i bakwɔ dǝna dǝ nwongǝi a ɗing ɓǝ. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Lakwɔ ɓi dǝ ba a langǝ i tthǝ langkwoi ɓi ibǝi mǝn ya langǝ i kwɔ wuo bǝgǝ Fuh ɓǝ.&gt;&gt;<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />Yeso gei angǝ,&lt;&lt;Ən mko ɓǝ sob iu rab, ǝn toni lǝu? Yuu akun dang ɓǝ ǝn mungkullum!&gt;&gt;<verse eid="JHN 6:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="JHN 6:71" />Dǝu gei ǝn ba Yahuza, yui Saminu Iskariyoti. Bakwɔ Yahuza, u dang ya nanungto gu sob iu rab, u ɓangǝu lǝ.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">Yeso I Ya Youngǝu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Tthasua nungkwɔ, Yeso thko dang Galili; u yidɗi bǝ tǝ dang Yahudiya lǝu, bakwɔ yakku ya Yahudawa dǝna yidɗi bǝ thǝu. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />Lona ɓang tǝbbǝ ya Yahudawa gbag yang, <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />Nungkwɔ ya young gi Yeso geiu angǝ,&lt;&lt;A yitthǝ bǝi kwɔ a tǝ losua Yahudiya, yangbǝ ya muo suamǝ a ɓyǝa nungkwɔ dǝma to ɓǝ. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Yuu yangǝu a pya nungkwɔ dǝna to ɓǝu nǝ dǝnnu yiɗi yayuu iu ɓǝ. Lakwɔ dǝma to i nungkwɔ, a yiǝ ya longwam ǝndǝi ibǝ ba mǝ!&gt;&gt; <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />I ya youngǝu ǝndǝi dǝba a langǝ i tthǝu lǝu.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />Yeso gei angǝ&lt;&lt;Lona a langǝ im yirrǝ to lǝu. Lona a nwaa ǝndǝi ǝn a langǝ i tthǝɓǝ lǝ. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />Longwam ɓuan laɓǝu, kwoi longwam lam, bakwɔ ǝn ǝnwa bǝ gei gǝngǝ nungto gi mkoɓǝ. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Ɓa tǝ ɓangɓǝ. Ən tǝ ɓangɓǝu, bakwɔ lona a langǝ i yirrǝ wuomtthǝ lǝu.&gt;&gt; <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />U gei nungkwɔ, langkwoi yang u ǝsua Galili.<verse eid="JHN 7:9" /></para>
  <para style="s">Yeso Tǝ Ɓang Urshalima</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Ttha sua kwɔ ya youngǝu patǝ ɓang ɓǝ, Yeso langɓǝ patǝ; u i nung gwambǝi lǝu, kwoi lǝbǝ pya. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />Yakku ya Yahudawa dǝna ɗu bǝiu dang ɓanglǝ. I ɓib angǝ,&lt;&lt;U pǝlla?&gt;&gt;<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />Bǝ gei yaya kpaaɗing dang kon yayuu ɓang lǝ ba gu. Yakun dǝna gei angǝ, &lt;&lt;U ǝn ya langǝ i,&gt;&gt;yakun dǝna gei angǝ,&lt;&lt;Nilǝu&gt;&gt; dǝu ɓanglǝ yayuu.&gt;&gt; <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Kwoi yuu akun yangǝu gei ba gu nung gwambǝiu, bakwɔ dǝi sur yakku ya Yahudawa.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />Ɓang ɓǝ gbag bǝ tthǝmmu kwɔ Yeso tǝ dang kǝm nyǝknung baipi bǝ nanatthǝnung. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />Yakku ya Yahudawa loi na fǝm i gei angǝ,&lt;&lt;Yiɓǝi kwɔ to nǝnǝ ibǝ nung ni kwɔ u tthan nunglǝu ɓa?&gt;&gt;<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />Yeso gwab nwa angǝ,&lt;&lt;Nungkwɔ dǝm nanatthǝ kwɔ ǝn bǝ nanatthǝ nungǝm lǝu, wuo tthǝn bǝgǝ Fuh kwɔ tummǝm ɓǝ. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Yuu akwɔ dǝna yidɗi bǝ to nungkwɔ Fuh dǝna yidɗi a ibǝi lko nungkwɔ dǝm nanatthǝ wuo bǝgǝ Fuh ko dǝm gei i tthǝ nyimmim. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />Yuu akwɔ dǝna gei ba i tthǝnyimmi gu dǝu yiɗi bǝ ɗu ghaali lǝ lotthǝ. Kwoi yuu akwɔ yiɗi ghaali lǝ ba yuu akwɔ tummu u ǝn ya langǝ i, langkwoi nung yangǝu lǝ pǝllǝ nwuo lǝu. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />Musa dǝɓǝ nung zuu, u dǝ lǝu? Kwoi yuu akun yangǝu dang ɓǝ to nung to i nung zuu lǝ. Ən baɓǝ bǝ dǝ ɓa yiɗi bǝ thǝm?&gt;&gt;<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />Kon ɓǝ gwab nwa angǝ, &lt;&lt;Mǝ tthǝ i wa tthǝmǝ! Ən yi dǝna yidɗi bǝ thǝbba?&gt;&gt;<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />Yeso gwab nwa angǝ,&lt;&lt;Ən to nungfǝmlo kun, ɓǝ ǝndǝi loɓǝ dǝna fǝm. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />Musa gei ɓǝ angǝ ɓa ɓǝr nwa ɗuǝ yathang ɓǝ (la nwasiu ǝn Musa gei lǝu ǝn ya Bǝba ɓǝ i owhsi bǝ tou), langkwoi nungkwɔ dǝɓa ɓǝrnwa ɗuǝ yathang vii nwongǝi. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />Nǝ i ɓǝr nwa ɗuǝ yui a yiɓǝi vii nwongǝi yang nung zuu gi Musa ɓanglǝ lǝu, ǝn ba ɓǝbǝ dǝɓa nyinyi i ɓanglǝ bakwɔ ǝn dǝ tthǝla lǝ yiɓǝi akun vii nwongǝi ɓa? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Ɓa yitthǝ bǝ to kwan i nung longwam, ɓa to kwan lozuiiu.&gt;&gt;<verse eid="JHN 7:24" /></para>
  <para style="s">U ɓǝlǝ Kristiǝ?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Yakun dang ya Urshalima gei angǝ, &lt;&lt;Yiɓǝi kwɔ ǝn yuu akwɔ yakku dǝna yiɗi bǝ thǝu ɓǝ lǝu? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Ɓa ɓyǝa! Dǝu gei ba dang yayuu, langkwoi yakku ɓǝ gei nung akun tthǝu lǝu! Lko i ibǝing u ɓǝlǝ Kristi la langǝ iǝ? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Kwoi nǝ Kristi wuo yang, yuu a kun yangǝu a ibǝi bǝi kwɔ u ǝrr tthǝ ɓǝu. Langkwoi ɓi ǝndǝi ibǝi bǝikwɔ yiɓǝi kwɔ wuo tthǝ ɓǝng.&gt;&gt;<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />Kwɔ Yeso dǝna nanatthǝnung dang kǝm nyǝknung, u gei i yol lǝ angǝ,&lt;&lt; Ba a langǝ i ɓa immǝng langkwoi ɓa ibǝi bǝikwɔ ǝn ǝrr tthǝ ɓǝngha? Ən wuo i tthǝ nyimmim lǝu. Yuu akwɔ tummǝm kwɔ, u ǝn ya ba a langǝ i. Ɓa iulǝu, <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />Kwoi ǝn iu yang, bakwɔ ǝn ǝrr tthangǝu ɓǝ langkwoi u tummǝm.&gt;&gt;<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />Yang dǝi yidɗi bǝ muu, kwoi yuu a kun yangǝu kǝn natthǝu, bakwɔ yirrǝ lona gu tolǝu ɓǝ. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />Kwoi yayuu kpaatthǝ dang konlǝ dǝba a langǝ i tthǝulǝ i gei angǝ, &lt;&lt;Kwɔ Kristi wuo, u to nung fǝmlo pǝl akwɔ yiɓǝi kwɔ to ɓa?&gt;&gt;<verse eid="JHN 7:31" /></para>
  <para style="s">I Tum Ya Kinung Tǝbǝ Mua Yeso</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />Ya Farisiyawa lǝ kon yayuu dǝna gei yaya nungkwɔ lo Yeso, nungkwɔ i iya nyǝknung i tum ya kinung angǝ tǝi muu.<verse eid="JHN 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 7:33" />Yeso gei angǝ,&lt;&lt;Ɓang i ɓǝlǝ natthǝ tuab, langkwoi yang Mǝn pa mǝn tǝ sua yuu akwɔ tummǝm ɓǝ. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Ɓa ɗu bǝim, kwoi yang ɓa tǝimmu, bakwɔ ɓa ɓuan ɓatǝ bǝikwɔ mǝn tǝ ɓǝu.&gt;&gt;<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />Yakku ya Yahudawa geilǝ tha tthǝ angǝ,&lt;&lt;Dǝu tǝ bǝ tǝn pǝttǝn kwɔ u gei angǝ ɓi tǝiu ɓa? U tǝ losua angǝ a ya wabnung sua ya Yahudawa kwɔ yǝbtha ǝtthǝ, yang u nanatthǝ nung lǝ ya wabnungha? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />U gei angǝ ɓi ɗubǝi ɓi tǝiu, langkwoi ɓi tǝ bǝikwɔ i tǝ ɓǝu. Ən ɓǝttǝn dǝu gei?&gt;&gt;<verse eid="JHN 7:36" /></para>
  <para style="s">Ɗual Mungki Kwɔ Dǝnna Dǝ Nwongǝi Ɓǝ</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />Vii kwɔ ɓang a thǝm tthǝ langkwoi vii a sua ɓang a langǝ i ya Yahudawa Yeso dǝinǝbo gei ba i yoll angǝ,&lt;&lt;Yuu akwɔ ɗimung dǝna tǝiu u wuo suam, langkwoi <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />Yuu akwɔ dǝ ba a langǝ i tthǝm yang u nwa mumgki. Manungkwɔ nungvullǝ gei kwɔ angǝ, &lt;Dual mungki nwongǝi kwɔ dǝna kyal tthǝu lǝ ɓǝ.&gt;&gt;&gt; <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />Yeso gei bakwɔ lǝ ba Ɓyang Fuh, kwɔ yakwɔ dǝba a langǝ i tthǝu i tǝi ɓǝ. Lona lǝkwɔ yirǝ i dǝ Ɓyang Fuh ɓǝlǝu, bakwɔ yirǝ i ǝrlǝ Yeso i du ghaali lǝu.<verse eid="JHN 7:39" /></para>
  <para style="s">Bǝ Gabtha Yayuu</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Yakun dang kon yayuu lǝ lǝu dǝu gei nungkwɔ langkwoi nungkwɔ i gei angǝ,&lt;&lt;Yiɓǝi kwɔ ǝnya gei ba a tthasi la langǝ i!&gt;&gt;<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />Yakun gei angǝ, Ulǝ Kristi ɓǝ!&gt;&gt;</para>
  <para style="p" vid="JHN 7:41">Kwoi yakun gei angǝ,&lt;&lt;Kristi a wuu tthǝn Galili lǝu! <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Nungvullǝ gei angǝ Kristi a wɔ dang ya Bǝba gi Yigwoi Dawuda langkwoi i siu Baitalami, gwoi angǝ a kwɔ Dawuda ǝtthǝ ɓǝ.&gt;&gt; <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />Nungkwɔ yayuu gabtha lǝ ba Yeso. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Yakun dǝna yiɗi bǝ muu, kwoi yuu akun yangǝu kǝn natthǝu.<verse eid="JHN 7:44" /></para>
  <para style="s">Yakku Ya Yahudawa Dǝba Alangǝ i Tthǝ Yeso Lǝu.</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Kwɔ ya kinung kwoi suai, ya nyǝknung i ya Farisiyawa ɓibbǝi angǝ,&lt;&lt;Ən ɓǝbǝ ɓa wuulǝ lǝu?&gt;&gt;<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />Ya kinung ɓǝ gwab nwa angǝ,&lt;&lt;Yuu a kun yangǝu gei ba mangǝn yiɓǝi kwɔ lǝu bo kun!&gt;&gt;<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />Ya Farisiyawa ɓibbǝi angǝ,&lt;&lt; U ɗamɓǝng langɓa?&gt;&gt; <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />&lt;&lt; Ɓa ibǝ yuu a kun dang yakku ya Farisiyawa kwɔ dǝba a langǝ i tthǝulǝ ɓǝngha? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Kon yayuu kwɔ ibǝ nung zuu gi Musa lǝu, Fuh ɓangǝ ilǝng!&gt;&gt;<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />Ya Farisiyawa akun kwɔ bǝilǝ kwɔ ǝn Nikodimu, yiɓǝi kwɔ tǝ sua Yeso nungvii ɓǝ. U gei lǝ sua yakwɔ tthǝ angǝ,<verse eid="JHN 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 7:51" />&lt;&lt;Nung zuu ɓi gei angǝ ɓi thǝb yuu nwuni bǝ ɓi lǝu langkwoi ɓi nuongpi nungkwɔ u to ɓǝlǝu.&gt;&gt;<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />&lt;&lt;I gwabbu nwa angǝ, &lt;&lt;mǝ langɓǝ ǝn ya Galili? A tthan nungvullǝ yang ma ibǝi ya gei ba a tthasi akun yangǝu ǝrr Galiliu.&gt;&gt; <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />Yang ko ǝn ya ǝndǝi pa lǝi gwoi gu.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">I Muo Yisi Akun Lotha I Yiɓǝi Kwɔ Ən Ɓǝiulǝu Ɓǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />Yang yayuu kwoi tǝ gwoi ǝndǝi, kwoi Yeso ɗab lotal Zaitun. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />Ibǝikan nungwoi ɗǝng u kwoi u tǝ dang kǝm Nyǝknung. Yayuu ǝndǝi gǝm tthangǝulǝ, u ǝǝsua dǝu nainatthǝnung. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Ya nanatthǝnung zuu gi Musa i ya Farisiyawa wulǝ yisi akun kwɔ i muu dǝu lo i yiɓǝi akun kwɔ ǝn ɓǝiu lǝu ɓǝ, wui dǝiulǝ dang si yayuu lǝ ǝndǝi. <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />I gei Yeso angǝ,&lt;&lt;Ya nanatthǝnung, ɓi muo yisi kwɔ lotha i yiɓǝi akun lǝ. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />Dang nung zuu ɓi lǝ Musa gei angǝ yisi manung akwɔ ni i wko i tal i thǝb. Lakwɔ, ǝnɓǝ a geiǝ?&gt;&gt; <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />I gei nugkwɔ yangbǝ i muo lǝ Yeso, yangbǝ i gei ba tthǝu. Kwoi u tǝm sua u vullǝ nung i nwanzǝnko pangsua lǝ.<verse eid="JHN 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 8:7" />I dǝi bǝilǝ dǝi ɓibbu ba, u ǝrr u gei angǝ,&lt;&lt;Yakwɔ dang ɓǝ to nung aɓau lǝu yang u osi wa tal a nungsi tthǝ yisi lǝ.&gt;&gt; <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />Langkwoi u mǝrǝm u vullǝnung pangsua.<verse eid="JHN 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 8:9" />Kwɔ i lǝ nungkwɔ ni, i pa ǝndǝi, kun, kun bai piu i yakku suo ǝn Yeso i nungtthǝu, i yisi ɓǝ dǝi bǝilǝ.<verse eid="JHN 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 8:10" />Yeso lǝi lo yi geiu angǝ,&lt;&lt;I ɓǝlǝ? Yuu akun yangǝu a thǝbba?&gt;&gt;<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />Yisi ɓǝ gwab nwa angǝ,&lt;&lt;Yuu a kun yangǝu, Ya nanatthǝnung&gt;&gt;niǝ, Yeso gei angǝ,&lt;&lt;Langɓǝ ǝn mua i nung a ɓko lǝu. Atǝ, yang ba to nung a ɓko akun thǝ.&gt;&gt;<verse eid="JHN 8:11" /></para>
  <para style="s">Yeso Lǝ Lua Gabbǝi Longwam</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />Yeso gei ba lǝ ya Farisiyawa langkwoi angǝ.&lt;&lt;Ɓanglǝ lua gabbǝi longwam,&gt;&gt; &lt;&lt;Yuu akwɔ ǝndǝi muo suam u tǝi lua nwongǝi yang u thko dang bǝthǝl lǝu.&gt;&gt;<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />Ya Farisiyawa geiu angǝ,&lt;&lt;Lakwɔ dǝma karnwa mǝ, nungkwɔ dǝma gei kwɔ nung akun lǝu.&gt;&gt;<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />Yeso gei angǝ&lt;&lt;Nilǝu,&lt;&lt;Nǝ dǝm gei ba lom i namlǝ, nungkwɔ dǝm gei kwɔ ǝn ba a langǝ i, bakwɔ ǝn ibǝ bǝikwɔ ǝn ǝrtthǝ ɓǝng langkwoi bǝikwɔ dǝm tǝɓǝ. Ɓa ibǝ bǝikwɔ ǝn ǝrtthǝ ɓǝlǝu ko bǝikwɔ dǝm tǝɓǝ. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Dǝɓa to kwan nunglǝi yayuu; Ən to kwan lo yuu a kunlǝu. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />Kwoi nǝ mǝn to manungkwɔ ni, yang kwanǝm ǝn lozuiiu, bakwɔ ɓang i nungtthǝm lǝu dang nungkwɔ; Daa kwɔ tummǝm kwɔ i ɓanglǝ. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />I vullǝ dang nung zuu ɓǝ angǝ nǝ shǝdǝ rab gwablǝ tha tthǝ, nungkwɔ i gei kwɔ ǝn ba a langǝ i. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Ən gei ba lom i namlǝ, langkwoi Daa kwɔ tummǝm kwɔ langɓǝ karnwam mǝng.&gt;&gt;<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />I ɓib Yeso angǝ,&lt;&lt;Daa mǝ pǝlla?&gt;&gt;</para>
  <para style="p" vid="JHN 8:19">Ɓa imlǝu ko ǝn Daam, nǝ ɓa im, yang ɓa i Daam mǝng langɓǝ.&gt;&gt;<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />Yeso gei nungkwɔ ǝndǝi kwɔ dǝu nanatthǝnung dang kǝm nyǝknung, gbag bǝi kwɔ i dǝ nung muo nungdǝ tthǝ ɓǝ. Yuu a kun yangǝu muu, bakwɔ lona gu to lǝu ɓǝ.<verse eid="JHN 8:20" /></para>
  <para style="s">Ɓa ɓuan Ɓatǝ Bǝi kwɔ Dǝmǝn Tǝɓǝu</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />Langkwoi Yeso gei angǝ,&lt;&lt;Mǝn pa ǝmpa bǝi kwɔ; ɓa ɗubǝim, kwoi yang ɓa ɓui dang nung a ɓko ɓǝ. Ɓa ɓuan ɓatǝ bǝi kwɔ mǝntǝ ɓǝu.&gt;&gt;<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />Nungkwɔ yakku ya Yahudawa gei angǝ,&lt;&lt;U gei angǝ ɓi ɓuan ɓitǝ bǝi kwɔ dǝi tǝ ɓǝu. Yang dǝu yiɗi bǝ thǝb loa?&gt;&gt;<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />Yeso gwab nwa angǝ,&lt;&lt;Ɓǝ ǝn ya longwam kwɔ, kwoi ǝn wuo yi. Ɓǝ tthǝn longwam kwɔ, kwoi ɓang ǝn ya longwam kwɔ lǝu. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />U baɓǝ kwɔ ǝn geigǝ ɓa ɓui dang nung a ɓko ɓǝ nǝɓa dǝ ba a langǝ i tthǝ ɓangǝ Ɓang ǝn yuu kwɔ dǝm geigǝ ǝn Ɓang ɓǝ.&gt;&gt;&gt;<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />I ɓibbu angǝ, &lt;&lt;Mǝn yittǝn?&gt;&gt; Yeso gwab nwa angǝ,&lt;&lt;Nungkwɔ ǝn gei ɓǝtthǝ la nungsi kwɔ. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />Ɓang tthǝ i nung kpaaɗing loɓǝ, nung kpaaɗing kwɔ mǝn toɓǝ lǝ kwan ɓǝ. Yuu akwɔ tumǝm kwɔ, ǝn ya ba a langǝ i, langkwoi ǝn gei lǝ longwam tthǝ nungkwɔ ǝn lǝ nwuo lǝ ɓuo ɓǝ.&gt;&gt;<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />I ibǝi kwɔ Yeso dǝna gei ba lǝba Daa ɓǝlǝu. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />Nungkwɔ Yeso gei angǝ,&lt;&lt;Kwɔ ɓa lǝi Yui Yuu yi, yang ɓa ibǝi ɓangǝ &lt;Ɓang Ən yuu akwɔ dǝm geigǝ Ən Ɓang ɓǝ.&gt;Yang ɓa ibǝi dǝm to nung i tthǝ nyimmim lǝu, kwoi dǝm gei nungkwɔ Daam geim angǝ ǝn gei ɓǝ. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />Langkwoi yuu akwɔ tummǝm kwɔ u i ɓang lǝ; u yim i nungtthǝm lǝu, bakwɔ vii ǝndǝi dǝm to nungkwɔ dǝu lǝ tthǝlko ɓǝ.&gt;&gt;<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />Yayuu kpaatthǝ kwɔ lǝ Yeso dǝna gei bakwɔ dǝba a langǝ i tthǝu lǝ.<verse eid="JHN 8:30" /></para>
  <para style="s">Ba Alangǝ i A Ilǝ Dang Kwan</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Yeso gei ya yahudawa kwɔ dǝ ba a langǝ i tthǝu lǝ kwɔ angǝ,&lt;&lt;Nǝ ɓa dǝ ba a langǝ i tthǝ bǝ nanatthǝ nungǝm, yang ɓǝlǝ ya nanungtom a langǝ i;<verse eid="JHN 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 8:32" />Ma ibǝ ba a langǝ i, langkwoi ba a langǝ i a ilǝ dang kwan.&gt;&gt;<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />I gwabbu nwa angǝ,&lt;&lt;Ɓi ǝn ya bǝpi gi Ibrahim, langkwoi ɓi ǝǝlǝ thǝb gi yuu akun lǝu bokun. Ənɓǝ, dǝɓa nhǝm, kwɔ dǝɓa gei ɓangǝ, &lt;kwan yangǝu loɓi wa&gt;?&gt;&gt;<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />Yeso gei angǝ,&lt;&lt;Dǝm gei ɓǝ ba a langǝ i tthǝ: yuu akwɔ nǝ dǝna to nung a ɓko yang u ǝn thǝb gi nung a ɓko. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />Ya thǝb mǝrrǝm lǝ ya dang gwoi laɗingǝu, kwoi yui dang gwoi ǝn ya dang woi ɓǝ laɗing. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Nǝ yui ɓǝ iilǝ dang kwan, yang a i dang ǝung la langǝi. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Ən ibǝi ɓǝ ǝn ya Bǝba gi Ibrahim. Kwoi dǝ ɓa yiɗi bǝ thǝm, bakwɔ ɓa yiɗi bǝ muo bǝ nanatthǝ nungǝm lǝu ɓǝ. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Ən gei ba nungkwɔ Daam tamnatthǝ ɓǝ, kwoi dǝɓa to nungkwɔ Daaɓǝ geiɓǝ tthǝɓǝ.&gt;&gt;<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />I gwabu nwa angǝ, &lt;&lt;Daa ɓi ǝn Ibrahim.&gt;&gt;</para>
  <para style="p" vid="JHN 8:39">Yeso gei angǝ,&lt;&lt;Nǝ lalangǝ i ɓǝ ǝn yathang Ibrahim yang, ɓa to nungkwɔ u to ɓǝ. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />Nungkwɔ ǝndǝi kwɔ ǝn to kwɔ yangbǝ ǝn gei ɓǝ ba a langǝ i kwɔ ǝn lǝ nwa Fuh lǝ, kwoi dǝɓa yiɗi bǝ thǝm. Ibrahim to nung akun nilǝu! <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />Dǝɓa to nungkwɔ Daa ɓǝ toɓǝ.&gt;&gt;</para>
  <para style="p" vid="JHN 8:41">I gwab nwa angǝ,&lt;&lt; Daa ɓi kun ɓuo lǝ Fuh,&gt;&gt; langkwoi ɓi lǝ yathang gu a langǝ i i si ɓi nunglǝi a ɓko lǝu.&gt;&gt;<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />Yeso gei angǝ,&lt;&lt;Nǝ Fuh la langǝ i ǝn Daa ɓǝ, yang ɓa yiɗim, bakwɔ ǝn wuo tthang Fuh langkwoi lakwɔ ɓang bǝikwɔ. Ən wuo i tthǝ nyimmim lǝu, kwoi ǝn u tummǝm. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />Ən baɓǝ bǝ ɓa ibǝ nungkwɔ ǝn gei kwɔ ɓǝlǝu? Bakwɔ ɓa ɓuan ɓa nyimnyi ɓalǝ bam lǝu. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />Ɓǝ ǝn yathang gi Daa ɓǝ, Mungkullum, yang dǝɓa yiɗi bǝ muo sua nungkwɔ Daa ɓǝ dǝna yiɗi ɓǝ. Baipiu la nungsi u ǝn ya thǝb bǝi u yangǝu lona a langǝ iu, bakwɔ ba a langǝ i yangǝu i u lǝu. Kwɔ nǝ u kǝb pǝllǝ, yang dǝu to nungkwɔ ǝn nung tthǝu ɓǝ, bakwɔ u ǝnya pǝllǝ langkwoi Daa ya pǝllǝ ǝndǝi. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Kwoi ǝn gei ba a langǝ i, langkwoi nungkwɔ to ɓa dǝba a langǝ i tthǝmlǝu. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Ən ya dang ɓǝ a gei angǝ ɓang tthǝ i nung a ɓko? Nǝ ǝn gei ɓa a langǝ i, yang ǝn ba ɓǝ bǝ ɓa dǝ ba a langǝ i tthǝm lǝu? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />Yuu akwɔ wuo bǝgǝ Fuh dǝna lǝ bagi Fuh. Ɓǝ, langkwoi, ɓa wɔ tthang Fuh lǝu, langkwoi u nungkwɔ to ɓalǝ bko.&gt;&gt;<verse eid="JHN 8:47" /></para>
  <para style="s">Yeso I Ibrahim</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />Ya Yahudawa ɓib Yeso angǝ,&lt;&lt;Ən lozuiiu lǝu nǝɓi gei ɓi angǝ mǝn ya Samariya langkwoi wa tthǝm ma?&gt;&gt;<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />Yeso gei angǝ,&lt;&lt;Wa yangǝu tthǝmmu, Dǝm dǝ angǝ a lǝ Daam, kwoi ɓa dǝm angǝ ko. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Dǝm ɗu bǝ dǝ angǝ a lǝ lom tthǝlǝu. Kwoi yuu a kun tthǝ dǝna ɗu langkwoi dǝu to kwan u dǝm ba a langǝ i. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Dǝm gei ɓǝ ba a langǝ i tthǝ: yuu akwɔ to nung to i bǝ nanatthǝnungǝm yang ɓuiu.&gt;&gt;<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />Ya yahudawa geiu angǝ,&lt;&lt;Lakwɔ ɓi ibǝi yang wa tthǝmǝ! Ibrahim ɓui, ya gei ba a tthasi ɓui, kwoi dǝma gei mangǝ yuu akwɔ nǝ to nung to i bǝ nanatthǝnung mǝ yang ɓuiu. <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />Daa ɓi Ibrahim ɓui; dǝmma lǝi a ghaa a pǝll Ibrahim ma, niǝ? Langkwoi ya gei ba a tthasi langɓǝ ɓui. Dǝmma lǝi lomǝ mangǝ ǝnya?&gt;&gt;<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />Yeso gwab nwa angǝ,&lt;&lt;Nǝ krǝ mǝn dǝ angǝ a lǝ lom, bǝ dǝ angǝ a ɓǝ ǝǝlǝ nung a kunnu. Fuh kwɔ dǝna dǝm angǝ a kwɔ ǝn Daam yuu akwɔ dǝ ɓa gei ɓangǝ ǝn Daaɓǝ ɓǝ. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />Ɓa iu lǝu bo kun, kwoi ǝn iu yang. Nǝ krǝ nǝ ǝn geigǝ ǝn iulǝu, Yang ɓang ǝnya pǝllǝ manungɓǝ. Kwoi ǝn iu yang, langkwoi dǝm to nung to i bagu. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />Daa ɓǝ Ibrahim lǝtthǝ la angǝ i ɓyǝa bǝ wuum; i ɓyǝang langkwoi tthǝu la ǝndǝi.&gt;&gt;<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />Ya yahudawa geiu angǝ,&lt;&lt; Mangǝ a ɓyǝa Ibrahim mǝng kwɔ yirrǝ a kǝn ttha thǝmrab pǝmna sob lǝu ɓa?<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />Yeso gei angǝ,&lt;&lt; Dǝm gei ɓǝ ba a langǝ i tthǝ, i sim mǝn nwuni bǝ Ibrahim&gt;.&gt;&gt;<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />Yang i kǝm tal yangbǝ i wau lǝ, kwoi Yeso brǝm dang ǝi lǝ pa dang kǝm Nyǝknung lǝ.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">Bǝdǝ Tthǝla Lǝ Yiɓǝi Kwɔ I Siu I Nung Ɓuommi Ɓǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Kwɔ Yeso dǝna thko dǝna tǝ, u ɓyǝa yiɓǝi a kun kwɔ i siu i nung ɓuommi. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />Ya nanung to gu ɓibbu angǝ,&lt;&lt;Ya nanatthǝnung, ǝn yittǝn to nung a ɓko nungkwɔ u tǝi lǝ nungɓuommi kwa? Tthǝn tthǝu ko tthǝn tthǝ yayuu gu?<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />Yeso gwab nwa angǝ,&lt;&lt;Nung yangǝu kǝb nungɓuommi gu lǝ tha i nung a ɓko gu ko a bǝ Daa gu i Naa gu. U i nungɓuommi kwɔ yangbǝ i ɓyǝa ttha gi Fuh bǝ to nung to tthǝu lǝ. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />Yirrǝ kwɔ ǝn dang fuh kwɔ, ɓi ǝǝ nwa bǝ tonungto gi yuu akwɔ tummǝm ɓǝ; nungvii dǝna wɔ kwɔ yuu a kun yangǝu kwɔ a ɓuan a tonungto ɓǝ.<verse eid="JHN 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 9:5" />Yirrǝ kwɔ ɓang dang longwam, Ɓang lǝ nungabbǝi dang longwam.&gt;&gt;<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Tthasua kwɔ u gei nungkwɔ, Yeso twi twitwi pangsua langkwoi u ɓuilǝ suab i twitwi lǝ; nungkwɔ u faa suab ɓǝ nung yiɓǝi ɓǝlǝ <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />nungkwɔ u geiu angǝ, &lt;&lt;Atǝ ta ɓual dang nungmǝ i mungki ɓuasuab Siluwam.&gt;&gt;Ɗuǝn kwɔ nungɓǝ lǝ &lt;&lt;Turarǝ.&gt;&gt; Nungkwɔ yiɓǝi ɓǝ pa, tǝ ɓual nungǝu, nungkwɔ u kwoi suo dǝnnu ɓyǝa bǝi.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />Ya nwakaplua gu, langkwoi, i yakwɔ lakuu ɓiu dǝnnu yamnung kwɔ, ɓib angǝ, &lt;&lt;Yuu kwɔ ǝn yiɓǝi kwɔ vii ǝndǝi ǝǝ dǝna yamnung ɓǝlǝu?&gt;&gt;<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />Yakun dǝna gei angǝ,&lt;&lt;Ən uɓǝ,&gt;&gt;kwoi yakun dǝna gei angǝ,&lt;&lt;Ən u lǝu; u i tha i ulǝ.&gt;&gt;</para>
  <para style="p" vid="JHN 9:9">Nungkwɔ yiɓǝi ɓǝ i nkolǝ gei angǝ,&lt;&lt;Ən ɓang.&gt;&gt;<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />I ɓibbu angǝ,&lt;&lt;A tonǝnǝ dǝmma ɓilǝ bǝi?&gt;&gt;<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />U gwab nwa angǝ,&lt;&lt;Yiɓǝi kwɔ ɗunu ǝn Yeso kwɔ ɓui suab, u faa nungǝm, langkwoi u geim angǝ tǝn ɓual nungǝm Siluwam yang tǝn ɓual. Nungkwɔ Əntǝ, langkwoi kwɔ dang tthǝ Ən ɓual nungǝm ni, ǝrr Ən baipi bǝ ɓyǝa bǝi.&gt;&gt;<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />&lt;&lt;Yang i ɓibbu angǝ u ɓǝla?</para>
  <para style="p" vid="JHN 9:12">U gwab nwa angǝ&lt;&lt;Ən ibǝi lǝu.&gt;&gt;<verse eid="JHN 9:12" /></para>
  <para style="s">Ya Farisiyawa Nuongpi Bǝ Tǝi Tthǝla Gu</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Yang i lǝi yiɓǝi kwɔ viikwɔ ǝnya nungɓuommi kwɔ i tǝlǝ sua ya Farisiyawa. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />Dangfuh kwɔ Yeso ɓui suab dulǝ tthǝla tthǝ nungɓuommi gu kwɔ ǝn vii nwongǝi gi ya Yahudawa. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Nungkwɔ ya Farisiyawa ɓib yiɓǝi ɓǝ, langkwoi angǝ, u tonǝnǝ u tǝilǝ ɓǝ ɓyǝa bǝi. U gei angǝ,&lt;&lt;U faa suab nungǝm; Nungkwɔ ǝn ɓual nungǝm, nungkwɔ lakwɔ dǝmǝn ɓyǝa bǝi.&gt;&gt;<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />Yakun dang ya Farisiyawa gei angǝ,&lt;&lt;Yiɓǝi kwɔ to nungkwɔ ǝrr bǝgǝ Fuh lǝu, bakwɔ u to nung to i zuu vii nwongǝi lǝu.&gt;&gt;</para>
  <para style="p" vid="JHN 9:16">Yakun, langkwoi, gei angǝ,&lt;&lt;Yiɓǝi kwɔ ǝn ya nung a ɓko kwɔ to nǝnǝ ato nung fǝmlo manungkwɔni?&gt;&gt;Lakwɔ Yang dang ǝi ǝrr gabtha.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />Nungkwɔ ya Farisiyawa ɓib yiɓǝi ɓǝ langkwoi angǝ, &lt;&lt;A gei mangǝ u da tthǝ la tthǝ nungɓuommi- to, ǝnɓǝ ma gei lolǝ?&gt;&gt;</para>
  <para style="p" vid="JHN 9:17">Yiɓǝi ɓǝ gwab nwa angǝ,&lt;&lt; U ǝn ya gei ba a tthasi.&gt;&gt;<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Yakku ya Yahudawa, yiɗi bǝ dǝ ba a langǝ itthǝ kwɔ angǝ u ǝn ya nungɓuommi langkwoi lakwɔ dǝnnu ɓyǝa bǝi ɓǝ lǝu, nwuni i lubǝ daa gu i naa gu <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />wui ɓibbǝi angǝ,&lt;&lt;Yuu kwɔ ǝn yui ɓa? Ɓa gei ɓangǝ i siu i nungɓuommi; nǝnǝ yang, lakwɔ dǝnnu ɓyǝa bǝi?&gt;&gt;<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />Yayuu gu gwab nwa angǝ,&lt;&lt;Ɓi ibǝi u ǝn yui ɓi, langkwoi ɓi ibǝi ɓi siu i nungɓuommi. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />Kwoi ɓi ibǝi nungkwɔ tonung lakwɔ dǝnnu ɓyǝa bǝi ɓǝlǝu, ko langkwoi ɓi ibǝ yuu kwɔ du tthǝla tthǝ nungɓuommi gu ɓǝlǝu . Ɓa ɓibbu; u ghaang, u gwab ɓǝtthǝ i nwuo lǝ!&gt;&gt; <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />Yayuu gu gei nungkwɔ bakwɔ dǝnni sur yakku ya Yahudawa, kwɔ i osi i gwab lǝ thatthǝ angǝ yuu akwɔ nǝ gei angǝ Yeso ǝn Kristi yang i nannu dang kǝm bǝ kǝbtha gi. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Nungkwɔ yayuu gu gei angǝ,&lt;&lt;U ghaang; ɓa ɓibbu!&gt;&gt;<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />I lubǝ yiɓǝi ɓǝkwɔ i siu i nungɓuommi kwɔ a nung rab tthǝu, langkwoi i geiu angǝ, &lt;&lt;A gwab ɓi nwa tthasi Fuh mangǝ ma gei ba a langǝ i! Ɓi ibǝing yiɓǝi kwɔ da tthǝ la kwɔ ǝn ya nung a ɓko.&gt;&gt;<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />Yiɓǝi ɓǝ gwab nwa angǝ,&lt;&lt;Ən ibǝi kwɔ u ǝn ya nung a ɓko ɓǝlǝu ko nilǝu, Nung kun kwɔ ǝn ibǝi kwɔ: Ɓang ǝn ya nungɓuommi, lakwɔ dǝm ɓibbǝi.&gt;&gt;<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />I ɓib angǝ,&lt;&lt;Ən ɓǝttǝn u tolǝ? U tonǝnǝ u da tthǝla tthǝ nungɓuommi mǝ?&gt;&gt;<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />U gei angǝ,&lt;&lt;Ən osi ǝn gei ɓǝtthǝng, langkwoi ɓa lǝu. Ənba ɓǝbǝ dǝɓa yiɗi bǝ lǝu akun langkwoi? Dǝɓa yiɗi bǝ mǝrǝm lǝ ya nanung to gu langɓa?&gt;&gt;<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Yang ǝrr i dalǝu i gei angǝ,&lt;&lt;Mǝlǝ ya nanung to gi yiɓǝi kullo; kwoi ɓi ǝnya nanung to gi Musa. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Ɓi ibǝing Fuh gei balǝ Musa, labǝ yiɓǝi kullo, ɓi ibǝ bǝikwɔ u ǝrr tthǝ ɓǝlǝu!&gt;&gt;<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />Yiɓǝi ɓǝ gwab nwa angǝ,&lt;&lt;Nungɓǝ fǝmlo ɗing! Ɓa ibǝ bǝikwɔ u ǝrr tthǝ ɓǝlǝu, kwoi ǝn u dǝm tthǝla tthǝ nungɓuommim! <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Ɓi ibǝing Fuh lǝ ya nung a ɓko; dǝu dǝsui tthǝ yakwɔ dǝna du angǝ a langkwoi dǝnni to nungkwɔ dǝnnu yiɗi i to ɓǝ. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Yuu a kun yangǝu dǝ bǝ ɓyǝa bǝi lǝ yiɓǝi kwɔ i siu i nungɓuommi manung abǝm kwɔ totthǝ lǝu bokun baipiu vii kwɔ i mab longwam ɓǝ.<verse eid="JHN 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 9:33" />Nǝ Yeso kwɔ ǝrr bǝgǝ Fuh lǝu yang, u ɓuan u to nung akun manungkwɔ niiu.&gt;&gt;<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />I gwab nwa angǝ,&lt;&lt;I sii a ghaa dang nung a ɓko dǝma yiɗi bǝ naɓi natthǝ nungha?&gt;&gt;Ərr i nannu dang kǝm kǝbtha gi.<verse eid="JHN 9:34" /></para>
  <para style="s">Nungɓuomi A Ɓyang Gi Fuh</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />Kwɔ Yeso lǝ nungkwɔ to nungɓǝ, wuu tǝi yiɓǝi ɓǝ u ɓibbu angǝ,&lt;&lt;A dǝ ba a langǝ i tthǝ Yui gi Yuung a?&gt;&gt;<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />Yiɓǝi ɓǝ gwab nwa lǝ Yeso angǝ, &lt;&lt;A geim tthǝ u ǝnya, yikku, yangbǝ ǝn dǝba a langǝ i tthǝu!&gt;&gt;<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />Yeso ǝrr geiu angǝ,&lt;&lt;A owhsi a ɓyǝko, langkwoi ǝn u ɓǝ lakwɔ dǝnnu gei ba i mǝlǝ lakwɔ ɓǝ.&gt;&gt;<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />Yang yiɓǝi ɓǝ gei angǝ,&lt;&lt;Ən dǝ ba a langǝ i tthǝng Dangbang!&gt;&gt; U bai nwalongǝu sua dang si Yeso.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />Yeso gei angǝ,&lt;&lt;Ən wuu longwam kwɔ bǝ to kwan, yangbǝ ya nungɓuommi ɓyǝa bǝi yangbǝ yakwɔ nungǝi dǝna ɓyǝa bǝi yang nungǝi ɓuom.&gt;&gt;<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />Yakun dang ya Farisiyawa kwɔ bǝi lǝ kwɔ i lǝu u gei bakwɔ nungkwɔ i ɓibbu angǝ, &lt;&lt;Ən ba langǝ i dǝma gei mangǝ ɓi ǝn ya nungɓuommi, langɓa?&gt;&gt;<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />Yeso gwab nwa angǝ,&lt;&lt;Nǝ ɓǝ ǝn ya nungɓuommi, yang ba muo ɓǝlǝu; kwoi kwɔ lakwɔ dǝ ɓa lǝi ɓangǝ dǝ ɓa ɓuan bǝ ɓyǝa bǝi; manungkwɔ ni yang ba muo ɓǝng.&gt;&gt;<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">Bǝ Liba Loya Gagci Nungbyang</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />Yeso gei angǝ,&lt;&lt;Dǝm gei ɓǝ ba a langǝ i tthǝ: yiɓǝi kwɔ nǝ tǝ dang kǝm ɓangam ttha nwakǝm lǝu, kwoi ɗab ttha bǝi a kunlǝ yang, u ǝnya nung i langkwoi ya muo nunglǝ ttha. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />Yiɓǝi kwɔ tǝ dang kǝm ɓǝ ttha nwa kǝm yang u ǝn ya gagci ɓangam ɓǝ. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />Ya ki nwalǝgwoi ɓǝ a ɓko nwa kǝm tthǝ; i ɓangam ɓǝ a lǝ yollu kwɔ dǝnnu lubbǝi ɓangam gu i ɗuǝnni lǝɓǝ, yang u illǝ gwam. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Kwɔ nǝ u illǝ gwam; yang u owhsi, ɓangam ɓǝ a muo suo, bakwɔ i iyollu ɓǝ. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />I muo sua yuu a kunnu; langkwoi, i sur yuu ɓǝ, bakwɔ i iyollǝu lǝu ɓǝ.&gt;&gt;<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />Yeso gei bǝ li bakwɔ tthǝ, kwoi i ibǝ nungkwɔ dǝnnu gei ɓǝlǝu.<verse eid="JHN 10:6" /></para>
  <para style="s">Yeso Lǝya Gagci Nungbyang Alangǝ i</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />Nungkwɔ Yeso gei langkwoi angǝ,&lt;&lt;Dǝmǝng gei ɓǝ ba a langǝ i tthǝ: Ɓanglǝ nwalǝgwoi gi ɓangam. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Yakwɔ osim wuo kwɔ ǝnya nung i iya muo nunglǝ ttha, kwoi ɓangam ɓǝ lǝilǝu. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Ɓanglǝ nwalǝgwoi. Yakwɔ ǝndǝi muo ttha nwalǝgwoi wuo dang woi yang a sunsob; i wuo dang woi langkwoi i igwam i tǝi nungtang. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />Yanung i dǝna wɔ ǝn babǝ i nung, thǝbbǝi, i bǝ ɓanglǝ nung. Ən wuo yangbǝ ɓa tǝi nwongǝi- nwongǝi lo nunglǝi ǝndǝi.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />&lt;&lt;Ɓanglǝ ya gagci nungbyang a langǝ i, kwɔ dǝmǝng yiɗi bǝ dǝ nwongǝim lǝ ba ɓangam mǝm ɓǝ. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />Kwɔ yuu akwɔ i lǝiu lǝ ba bǝ gagci nung, u ǝn ya gagci nungbyang lǝu langkwoi ɓangam ɓǝng abo lǝu, nǝ u ɓyǝa ɗua gug dǝna wɔ, yang u yitthǝ ɓangam ɓǝ u pa dum; yang ɗua gug ɓǝ a muo ɓangam ɓǝ a yǝbbǝi lǝtha. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Ya gagci nungbyang kwɔ i lǝi kwɔ a padum bakwɔ i lǝiu ǝn lǝi ɓǝ u nhǝm ba ɓangam ɓǝu. <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" />Ɓang ǝnya gagci nungbyang a langǝ i ǝn i ɓangam mǝm mǝng lang ɓangam mǝn immǝng, <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />Manung akwɔ Daa immǝng ǝn i Daang, Langkwoi dǝmmǝn yiɗi bǝ dǝ nwongǝim lǝ ba ɓangam mǝm. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />I ɓangam akun tthǝ kwɔ ǝn abǝm kwɔ i yangǝu dang kǝm ɓangam kwɔu. Mǝng wuilǝ, langɓǝ; i lǝ yollǝm, wui gǝmtha bǝ yikun ya gagcii kun.<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />&lt;&lt;Daa dǝna yiɗim bakwɔ dǝmǝng yiɗi bǝ dǝ nwongǝim ɓǝ, langkwoi tthasua yang mǝng muo langkwoi. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Yuu yangǝu a lǝi nwongǝim tthǝmmu. Ən dǝ nwongǝim i bǝ yiɗim. Mǝng ɓuan mǝng dǝ nwongǝim, langkwoi mǝng ɓuan mǝng kwoilǝ. U nungɓǝkwɔ Daam gei angǝ ǝn to ɓǝ.&gt;&gt;<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Langkwoi ganglang ya yahudawa ǝrr gabtha tthǝ bakwɔ Yeso geiɓǝ. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />I kpaatthǝ dǝnni gei angǝ,&lt;&lt;U tthǝ i wa a ɓko! U ǝn ya nunglo! Ən ba ɓǝ bǝ dǝ ɓa lǝu?&gt;&gt;<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />Kwoi ya kun dǝna gei angǝ,&lt;&lt;Yiɓǝi kwɔ i wa a ɓko gei ba niu! Ɓyang a ɓko a to nǝnǝ adǝ bǝ ɓyǝa bǝi lǝ ya nungɓuommi?&gt;&gt;<verse eid="JHN 10:21" /></para>
  <para style="s">I La Yeso</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Ən lona kukam, vii bǝ to Ɓang Nyǝk kǝm Nyǝknung dang Urshalima. <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />Yeso dǝna thko dang tǝbǝ gi Sulemanu dang kǝm Nyǝknung, <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />Kwɔ yayuu gǝmtha tthangǝu nungkwɔ i ɓibbu angǝ, &lt;&lt;Bo nǝnǝ ma yi ɓi dang bǝthǝl dǝɓi ki? A gei ɓi ba a langǝ i tthǝ: mǝng Kristi?&gt;&gt;<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />Yeso gwab nwa angǝ,&lt;&lt;Ən owhsi ǝn gei ɓǝtthǝng, langkwoi ɓa dǝba a langǝ i tthǝ lǝu. Nungto kwɔ dǝm to i tthǝ nyimmi gi Daam kwɔ nungɓǝ dǝna gei nwam; <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />kwoi ɓa dǝba a langǝ i tthǝ lǝu, bakwɔ ɓǝng ɓangam mǝm lǝu ɓǝ. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Ɓangam mǝm dǝna lǝ yollǝm; ǝn ing, langkwoi dǝnni muo suam. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Ən ji nwongǝi a ɗing, langkwoi i ɓuiu. Yuu akun yangǝu a fyǝi nam a lǝiu.<verse eid="JHN 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 10:29" />Nungkwɔ Daam dǝm kwɔ ghaa pǝl nung ǝndǝi, langkwoi yuu yangǝu a fyǝi dang na Daa lǝu.<verse eid="JHN 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 10:30" />Daa i ɓang ɓi kun.&gt;&gt; <verse eid="JHN 10:30" /><verse number="31" style="v" sid="JHN 10:31" />Langkwoi yayuu ǝrr ee tal dǝna tǝbǝ wkolǝ. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />Yeso gei angǝ,&lt;&lt;Ən to nung a langǝ i kpaatthǝ dang nungɓǝlǝ kwɔ Daam dǝm dǝmǝng toɓǝ; lakwɔ ǝn ba anwɔ kwɔ dǝɓa yidɗi bǝ wam i tal ɓa?&gt;&gt; <verse eid="JHN 10:32" /><verse number="33" style="v" sid="JHN 10:33" />Ərr i gwab nwa angǝ,&lt;&lt;Dǝɓi yiɗi bǝ wa i tal lǝ ba nung to a langǝ i lǝu, ǝn bakwɔ a gei nung a ɓko tthǝ Fuh ɓǝ! Mǝng yuu a nǝkwam dǝmma yiɗi bǝ mǝrrǝm lǝ Fuh!&gt;&gt;<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />Yeso gwab nwa angǝ,&lt;&lt;I vullǝ dang zuu ɓǝ zuu gi Musa angǝ Fuh gei angǝ,&lt;Ɓǝ ǝn i fuh a tuab.&gt; <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Ɓi ibǝi nungkwɔ i vullǝ dang ba Fuh kwɔ ǝn ba langǝ i laɗing; Langkwoi Fuh luu yayuu ɓǝ angǝ i ǝn fuh, yayuu kwɔ Fuh ji bagu ɓǝ. <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />Ɓang abǝm, Daam mkom nungkwɔ tummǝm longwam. Nǝnna, yang, ɓangǝ ǝn gei ba a ɓko tthǝ Fuh bakwɔ ǝn geigǝ ɓang Yui gi Fuh ɓaa? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Bǝɓa dǝ ba a langǝ i tthǝ baam thǝ, yang, nǝ ǝn to nungkwɔ Daam tumǝm angǝ wuong to lǝuɓǝ. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />Kwoi nǝ dǝm to i nungɓǝkwɔ Daam geim angǝ ǝnto, nǝ ko ɓa dǝ ba a langǝ itthǝm lǝu, yang kaso ko ɓko mangǝ ǝnɓa ɓa dǝba langǝ itthǝ nungtom, yangbǝ ɓa ibǝi i naɓǝ ǝndǝi ɓangǝ Daa dang tthǝm langkwoi ɓang dang tthǝ Daa.&gt;&gt;<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />Langkwoi dǝnni yidɗi bǝ muo Yeso, kwoi u brǝm dang nai.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />Yang Yeso kwoi suko langkwoi nyang dual Urdun tǝ bǝikwɔ Yohanna wollmung lǝ yayuu tthǝ ɓǝ, tǝu ǝǝ bǝi lǝ. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />Yayuu kpaatthǝ wua suo. I gei angǝ,&lt;&lt;Yohanna to nungfǝmlo lǝu, kwoi nungkwɔ ǝndǝi u gei lǝ ba yiɓǝi kwɔ ǝn ba a langǝ i.&gt;&gt; <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />Langkwoi yayuu kpaatthǝ bǝi lǝ dǝ ba a langǝ i tthǝu.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">Ɓua Gi Liyazaru</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Yiɓǝi akun tthǝ ɗuǝnnu ǝn Liyazaru, kwɔ u lo dang Betanya ɓǝ, tthǝu lako. Betanya ǝn gwoi atuab kwɔ Maryamu i youngǝu atuab Matta lotthǝ ɓǝ. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />(Maryamu kwɔ ǝn yisi kwɔ al nui kummu laatthǝ lobo Dangbang ɓǝ langkwoi u faa boɓǝ i byang lo; yongǝu Liyazaru kwɔ tthǝu lako ɓǝ u ǝn youngtha i Maryamu.) <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />Ya youngǝu ɓǝ tum nwatummi sua Yeso angǝ:&lt;&lt;Dangbang, ǝnthǝmǝ Liyazaru kwɔ dǝmma yiɗi nikwɔ tthǝu lko.&gt;&gt;<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />Kwɔ Yeso lǝ ba ɓǝ ni, ǝrr gei angǝ,&lt;&lt;Nungzii kwɔ ǝǝlǝ ɓua Liyazaru; nungkwɔ to nung yangbǝ dǝ ɗuǝn angǝ a lǝ Fuh, langkwoi a ǝrr lǝ nungkwɔ ɗuǝn Yui gi Fuh a ghaa ɓǝ.&gt;&gt;<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />Yeso dǝna yiɗi Matta i youngǝu i Liyazaru youngǝu ɗing, <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />kwoi kwɔ u lǝ angǝ tthǝ Liyazaru lko, u ǝǝ natthǝ bo rab bǝi kwɔ u tthǝ ɓǝ. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />Nungkwɔ u gei ya nanung to gu angǝ,&lt;&lt;Ɓi kwoi ɓi tǝ Yahudiya.&gt;&gt;<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />I gwab nwa angǝ, Kwoi ya nanatthǝnung,&lt;&lt;Lona tuabni kwɔ pa ɓǝ yayuu dǝna yiɗi bǝ waa i tal; langkwoi dǝma yiɗi bǝ kwoi suamǝ ma tǝ bǝiɓa?&gt;&gt;<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />Yeso gei angǝ,&lt;&lt;Dangfuh ǝndǝi lona sob iu rab, nilǝu? Lakwɔ yakwɔ dǝna thkothko dang fuh lǝ yang ɓuob boi tthǝ nungǝu, bakwɔ dǝnni ɓyǝa bǝi kaitthǝ longwam ɓǝ. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Kwoi kwɔ nǝ dǝu thkothko nungvii yang u ɓuob bo tthǝ nung, bakwɔ lua yangǝu gabǝiu ɓǝ.&gt;&gt; <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />Yeso gei bakwɔ, langkwoi lilo tthǝ gei akun angǝ,&lt;&lt;ǝnthǝ ɓi Liyazaru lo ǝn nung lo, kwoi mǝn tǝ tǝmǝng ǝrrǝu lǝ.&gt;&gt;<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />Ya nanung to gwab nwa angǝ,&lt;&lt;Nǝ dǝu lo nung lo Dangbang, yang, u tǝi tthǝla ǝntǝi.&gt;&gt;<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />Yeso dǝna gei ǝn bǝ ɓuiɓua, kwoi ya nanung to gu dǝna nhǝm angǝ ǝn nung lo a nǝkwam.<verse eid="JHN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 11:14" />Nungkwɔ Yeso ǝrr geitthǝ dang nung angǝ,&lt;&lt;Liyazaru ɓuing, <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />kwoi lakwɔ lǝ baɓǝ dǝmǝn lǝ tthǝla kwɔ ǝn yangǝu tthang Liyazaru ɓǝ, yangbǝ ɓa dǝ ba a langǝ itthǝ. Kwoi ɓi tǝ suko.&gt;&gt;<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />Yang Toma (kwɔ dǝnni lu ɗuǝnnu angǝ ǝn yui thǝn ɓǝ) gei sua ya nanung to gu angǝ, &lt;&lt;Ɓi ǝndǝi ɓi tǝ suatha i ya nanatthǝnung, yangbǝ tǝɓi ɓui i U!&gt;&gt;<verse eid="JHN 11:16" /></para>
  <para style="s">Yeso Lǝbǝ Ərr Dang Ɓua I Nwongǝi</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Nungkwɔ Yeso wuo bǝi ɓǝ, wuu tǝi i suu Liyazaru kǝn bo naing dang ɓua. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />Ərr Betanya a tǝlǝ Urshalima kǝn mel tai lǝu, <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />Ya Yahudiya Dǝnna Wuu kpaatthǝ waa dǝ nyitǝmmi lǝ Matta i Maryamu ba youngǝi kwɔ ɓuiɓǝ.<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />Kwɔ Matta lǝ angǝ Yeso dǝna wɔ, ǝrr u i gwam wuu kǝbbu, kwoi Maryamu ǝǝ abo dang woi. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />Matta gei Yeso angǝ,&lt;&lt;Krǝ nǝ mǝ tthǝ bǝi kwɔ, Dangbang, yang youngǝm ɓuiu! <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Kwoi ǝn ibǝi Fuh a da nung ǝndǝi kwɔ dǝmma yam nko ɓǝ ko lakwɔ.&gt;&gt;<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />Yeso geiu angǝ, &lt;&lt;Youngmǝ a ǝrr i nwongǝi langkwoi.&gt;&gt;<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />&lt;&lt;Matta gwab nwa angǝ, &lt;&lt;Ən ibǝi u ǝrr i nwongǝi vii asua.&gt;&gt;<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />Yeso geiu angǝ,&lt;&lt;Ɓang lǝ ya ǝrr lǝ yayuu ɓua i bǝ dǝ nwongǝi. Yakwɔ dǝ ba a langǝ i tthǝm i ɓuiu, ko nǝ i ɓui ɓǝ; <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />lakwɔ yakwɔ ǝǝ dǝna dǝ ba a langǝ i tthǝm bakwɔ ɓang i nwongǝi yang i ɓuiu. Ɓa gwabǝng nha?&gt;&gt;<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />&lt;&lt;Marta gwab nwa angǝ manungɓǝ, Dangbang, &lt;&lt;Ən gwabǝng mǝn Kristi, Yui gi Fuh, Yuu akwɔ i gei angǝ a wɔ longwam kwɔɓǝ.&gt;&gt;<verse eid="JHN 11:27" /></para>
  <para style="s">Yeso Al Mungnung</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />Tthasua kwɔ Marta gei bakwɔ, u kwoi suko tǝu lubbǝ youngǝu Maryamu gwu kun u geiu angǝ.&lt;&lt;Ya nanatthǝnung bǝikwɔ, langkwoi dǝnnu ɓib pimǝ.&gt;&gt; <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />Kwɔ Maryamu lǝ ba ɓǝ, u ǝrr thǝmtthǝ u i gwam tǝu kǝbbu. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />(Yirrǝ Yeso wuo gwoi a tuab ɓǝlǝu, kwoi yirrǝ u bǝikwɔ Matta kǝbbu tthǝ ɓǝ.) <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />Yakwɔ dang gwoi i Maryamu dǝna du nyitǝmmi kwɔ ǝrr i muo suko kwɔ i ɓiu u igwam thǝmtthǝ ɓǝ. Dǝnni nhǝm angǝ lko dǝnni tǝ lo ɓua tǝi tasui tthǝ.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />Maryamu ǝrr tǝ bǝikwɔ Yeso tthǝɓǝ, dang tthǝ kwɔ u ɓyǝko ni, ǝrr u bai nwalongǝu sua angǝ,&lt;&lt;Dangbang,&gt;&gt;krǝ nǝ mǝtthǝ bǝi kwɔ, yang youngǝm ɓuiu!&gt;&gt;<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Kwɔ Yeso ɓyǝa Marta dǝna tasui, langkwoi u ɓyǝa yakwɔ tthangǝu kwɔ dǝna tasui langkwoi; kiggǝu ǝrr, dang wko i ɓyangǝu ǝrr ghaatthǝ. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />Yeso ɓibǝi angǝ&lt;&lt;Ɓa suu ɓǝlǝ?&gt;&gt;I gwab nwa angǝ, &lt;&lt;Dangbang a wɔ wa ɓyǝa,&gt;&gt;<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />Yeso tasui. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />Yayuu dǝna gei angǝ,&lt;&lt;Ɓa ɓyǝa bǝ yiɗi bǝi kwɔ u yiɗiu lǝ ɓǝ!&gt;&gt;<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />Kwoi yakun dang ǝi gei angǝ,&lt;&lt;U dǝbǝ ɓyǝa bǝi lǝ ya nungɓuommi, nilǝu? U ɓuan u ilǝ Liyazaru bǝ ɓuiɓua wa?&gt;&gt;<verse eid="JHN 11:37" /></para>
  <para style="s">Yeso Dǝ Nwongǝi Lǝ Liyazaru</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />Ɓyang Yeso ǝrr ghaatthǝ i langkwoi, ǝrr u pa u tǝ nwa ɓua juǝn ɓǝ, kwɔ ǝn ɓua tal i lam nwa ɓua ɓǝ i tal ɓǝ. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />Yeso gei yasi ɓǝ angǝ,&lt;&lt; Ɓa lǝi tal ɓǝ nwa ɓua lǝ!&gt;&gt; &lt;&lt;Yang, Matta, young gi yuu akwɔ ɓui kwɔ gwab nwa angǝ, Kummu a yǝl ɓko ɗing, Dangbang. I suu kǝn bo nai lakwɔ!&gt;&gt;<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />Yeso geiu angǝ,&lt;&lt;Ən gei tthǝlǝu geigǝ ma ɓyǝa ghaali gi Fuh nǝ a dǝ ba a langǝ i tthǝ ɓǝlǝu?&gt;&gt; <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />Ərr i lǝi tal ɓǝ nwaɓua juǝn lǝ. Yeso lǝilo yi gei angǝ,&lt;&lt;Daa, ǝn to sakkon kwɔ a lǝm ɓǝ. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Ən ibǝi vii ǝndǝi dǝmma lǝm, langkwoi dǝmǝn ǝǝ ǝn ba yakwɔ bǝikwɔ ɓǝ, yangbǝ i ibǝi angǝ ǝn mǝ a tumǝm.&gt;&gt;<verse eid="JHN 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 11:43" />Kwɔ u gei bakwɔ, ǝrr u lubǝi yollǝu tǝyi tthǝ angǝ,&lt;&lt;Liyazaru! A igwam!&gt;&gt; <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />Ərr Liyazaru igwam, i tthǝb nko ibo i landa suu yuu, i tthǝb nungǝu langkwoi i landa suu yuu. Yeso gei ba angǝ, &lt;&lt;Ɓa biu, yang u pa.&gt;&gt;<verse eid="JHN 11:44" /></para>
  <para style="s">Dǝnni Ɗu Nunglǝi Gi Yeso</para>
  <para style="r">(<ref loc="MAT 26:1-5">Matthew 26:1-5</ref>; <ref loc="MRK 14:1">Markus 14:1</ref>,<ref loc="MRK 14:2">2</ref>; <ref loc="LUK 22:1-2">Luka 22:1-2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Yayuu kpaatthǝ kwɔ wuo bǝ gum na ɓua lǝ Maryamu kwɔ ɓyǝa nungkwɔ to nung kwɔ Yeso to kwɔ, ǝrr i dǝba a langǝ i tthǝu. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Kwoi yakun dang ǝi kwoi tǝ gei nungkwɔ Yeso toɓǝ lǝ ya Farisiyawa tthǝ. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />Nungkwɔ ya Farisiyawa i yakku ya nyǝknung i yakku ɓib tha angǝ,</para>
  <para style="p" vid="JHN 11:47">&lt;&lt;Ɓǝttǝn ɓito? Ɓa ɓyǝa nung fǝmlo kwɔ yiɓǝi kwɔ dǝna toɓǝ! <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Nǝɓi yiu dǝnnu to manungkwɔni dǝnnu tǝlǝ, yayuu ǝndǝi a dǝ ba a langǝ i tthǝu, yang ya dǝkab nwa nung ya Romawa a lǝi ba loɓi a dǝr kǝm Nyǝknung ɓi i losua ɓi!&gt;&gt;<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />Yuu akun tthǝ dang ǝi, ɗuǝnu ǝn Kayafa, kwɔ u ǝn Yikku ya Nyǝknung tthaa lǝ kwɔ, u gei angǝ,&lt;&lt;Ɓǝng ya sullǝ! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Ɓa ibǝi lǝu kwɔ maɗing kwɔ ɓa tǝi yuu akun kwɔ aɓui ba yayuu ǝndǝi ɓǝlǝu, lo akwɔ wui ɓanglǝ losua ɓǝ ǝndǝi ɓǝlǝu?&gt;&gt; <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />Ən ba langǝ i Kayafa, u gei i bǝ yidɗi gu lǝu; bakwɔ, u ǝn Yikku ya Nyǝknung tthaa lǝ ɓǝ, dǝnnu gei nwa ba a tthasi angǝ Yeso waa ɓui ba ya losua Yahudawa, <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />langkwoi ǝn ba gi ɓuolǝu, kwoi ǝn ba bǝ gǝm yayuu gi Fuh bǝikun kwɔ yǝbtha ǝndǝi ɓǝ.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />Baipiu viilǝ kullo ya dǝkab nwa nung ya Yahudawa dǝna ɗuu nunglǝi bǝ thǝb Yeso. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />Nungkwɔ baipiu vii lǝ kullo Yeso li tthǝu gwam bǝ thkothko ganglang ya Yahudiya lǝu, nungkwɔ ǝrr u pa u tǝ gbag losua a kwi, gwoi akun tthǝ dǝnni lu angǝ Ifraimu, bǝilǝ tǝu ǝǝ tthǝ i ya nanung to gu.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />Lona ɓang bǝ nyang lo gbag, yayuu kpaatthǝ ǝrr gwoi angǝ a tǝ Urshalima tǝi nyǝknung yangbǝ vii ɓang ɓǝ to.<verse eid="JHN 11:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="JHN 11:56" />Dǝnni ɗubǝ Yeso, kwɔ i gǝmtha kǝm Nyǝknung, dǝnni ɓib tha angǝ,&lt;&lt;Ɓǝttǝn dǝɓa nhǝm Ən ba a langǝ i u wuo ɓang kwɔu, u wung wa?&gt;&gt; <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />Yikku ya nyǝknung i ya Farisiyawa gei ba lǝ yayuu angǝ nǝ yuu kwɔ nǝ ibǝi bǝikwɔ Yeso tthǝɓǝ, yang u gei ba, yangbǝ tǝi muu.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">I Al Nui Lo Yeso Betanya</para>
  <para style="r">(<ref loc="MAT 26:6-13">Matthew 26:6-13</ref>; <ref loc="MRK 14:3-9">Markus 14:3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Sua bo vii ɓang nyang lo nanakun, Yeso ǝrr tǝ Betanya, gwoi gi Liyazaru, yiɓǝi kwɔ u ǝrrlǝ ɓuaɓǝ.<verse eid="JHN 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 12:2" />I yoou nungtang a nungluii tthǝ bǝi lǝ, kwɔ Matta dǝna gab ɓǝ; Liyazaru dang ya kwɔ ǝǝ bǝi lǝ lo nung ǝǝ i Yeso ɓǝ. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Nungkwɔ Maryamu lǝi nui kwɔ kummu dǝna yǝl latthǝ kwɔ i mabbu i nar nungkurɓǝu kpaatthǝ ɓǝ langkwoi, wuu al lobo Yeso, langkwoi u faa i byang lo. Kum nui ɓǝ dǝna yǝl latthǝ lǝi lǝ dang gwoi ɓǝ ǝndǝi. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />Yuu akun dang ya nanung to gi Yeso, Yahuza Iskariyoti yuu akwɔ wa ɗyǝabbu ɓǝ- gei angǝ, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />&lt;&lt;Ən baɓǝ bǝ i laa bǝ lǝi nui kwɔ i ɗyǝab lo nungkurɓǝ thǝmsob ɓua kun ǝrr ilo thǝmnu i dǝ nungkurɓǝ ɓǝ lǝ ya yiɓko lǝu?&gt;&gt; <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />U gei bakwɔ, ǝn bakwɔ yangbǝ i dǝlǝ ya yiɓko lǝu, kwoi bakwɔ u ǝn ya nung i ɓǝ. Dǝnnu lǝi tthko nungkurɓǝ ɓǝ yangbǝ wuu nwonglǝ lo.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Nungkwɔ Yeso gei angǝ,&lt;&lt;Ɓa yiu manungkwɔni! Ɓa yiu to nungkwɔ u mab lǝ ba vii bǝ suum ɓǝ. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Vii ǝndǝi ɓǝ i ya yiɓko ganglang ɓǝ, kwoi vii ǝndǝi ɓang i ɓǝlǝ lǝu.&gt;&gt;<verse eid="JHN 12:8" /></para>
  <para style="s">I Mab Ba aɓau Lo Liyazaru</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />Yayuu kpaatthǝ lǝ angǝ Yeso Betanya, nungkwɔ i tǝ bǝiɓǝ, i tǝ ǝnba Yeso ɓuolǝu langkwoi ǝn babǝ ɓyǝa Liyazaru, kwɔ Yeso ǝrrǝu lǝ dang ɓua ɓǝ. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Langkwoi yakuu ya nyǝknung mablǝi yangbǝ i thǝb Liyazaru langɓǝ, <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />langkwoi lǝ bagu ya Yahudawa dǝna lai dǝnni yiɗi Yeso.<verse eid="JHN 12:11" /></para>
  <para style="s">Tthǝla Kwɔ Yeso Tǝlǝ Urshalima Ɓǝ</para>
  <para style="r">(<ref loc="MAT 21:1-11">Matthew 21:1-11</ref>; <ref loc="MRK 11:1-11">Markus 11:1-11</ref>; <ref loc="LUK 19:28-40">Luka 19:28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Ibǝikan gong kon yayuu kwɔ wuo bǝ to ɓang nyanglo kwɔ lǝ angǝ Yeso dǝna wɔ Urshalima.<verse eid="JHN 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 12:13" />Nungkwɔ ǝrr i ee sinna kab dabino itǝ tǝi kǝbbu, dǝnni buogbǝi angǝ,&lt;&lt;Hosanna! Ɓi dǝ Fuh khana lo yuu akwɔ dǝna wɔ dang ɗuǝn Dangbang ɓǝ! Fuh khana lo yigwoi ya Israila!&gt;&gt;<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />Yeso tǝi yui ɗǝrr tthǝb nwa ɓǝl, manungkwɔ i vullǝ dang ba gi Fuh lǝɓǝ,<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />&lt;&lt; Bǝ a sur vulli thǝ, ya Sihiyona! Yigwoi ɓǝkwɔ dǝna wɔ ɓǝ, u ɗablo yui ɗǝrr.&gt;&gt;<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />La nwasiu ya nanung to gu ibǝ ba ɓǝ lǝu, kwɔ lakwɔ i ǝrrlǝ Yeso i nwongǝi, ǝrr i nhǝm angǝ nung vullǝ ba Fuh lolǝ kwɔ lakwɔ i to nungkwɔ lǝn utthǝ.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />Yakwɔ tthang Yeso vii kwɔ u lubǝ Liyazaru ɓua juǝn kwɔ langkwoi u ǝrrǝu lǝ ɓua kwɔ i gei nungkwɔ u toɓǝ. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Lǝba ɓǝkwɔ nungkwɔ kon ǝrr kǝbbu bakwɔ i lǝ angǝ u to nung fǝmlo ɓǝ. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />Ya Farisiyawa gei ba lǝ tha angǝ,&lt;&lt;Ɓa ɓyǝa, nung yangǝu ɓi to lakwɔu! Ɓa ɓyǝa, longwam ǝndǝi dǝna muo suko!&gt;&gt;<verse eid="JHN 12:19" /></para>
  <para style="s">Yakun Dang Ya Helenawa Dǝna Ɗubǝ Yeso</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />Ya yahudawa akun dang yakwɔ tǝ Urshalima tǝ wab Fuh vii ɓang ɓǝlǝ ɓǝ. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />I tǝ sua Filibus, u ǝn ya Betsaida dang Galili, tǝi gei angǝ,&lt;&lt;Yikku,&gt;&gt; dǝ ɓi yiɗi bǝ ɓyǝa Yeso.&gt;&gt;<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />Nungkwɔ Filibus patǝ geilǝ Andarawas tthǝ, nungkwɔ i nǝ rab gi i tǝ tǝi gei lǝ Yeso tthǝ.<verse eid="JHN 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23" />Yeso gwabǝi nwa angǝ,&lt;&lt;Lona wɔ lǝ Yui Yuu tthǝng kwɔ a muo ghaali angǝ a na Fuh ɓǝ. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Dǝmǝng gei ɓǝ ba a langǝ i tthǝ: nǝ nungbyǝa o pangsua ɓui dǝ, yang nungǝu a dǝi kunɗǝng ɓuo. Kwoi nǝ bie nung ɓui, yang a dǝ nung kpaatthǝ. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />Yuu akwɔ dǝna yiɗi nwongǝi gu yang tǝi nwongǝi ɓǝu; yuu akwɔ nǝ laa nwongǝi gu lǝ bam longwam kwɔ yang a tǝi nwongǝi a ɗing. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />Yuu akwɔ dǝna yiɗi bǝ wabbǝm yang u muo suam, yang bǝi kwɔ ɓang tthǝ thǝbbǝm a ǝǝ bǝi kwɔ ɓang tthǝ ɓǝ. Yang Daam a dǝ angǝ a lǝ yuu akwɔ dǝna wabbǝm ɓǝ.<verse eid="JHN 12:26" /></para>
  <para style="s">Yeso Ghai Nwaɓua Gu</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />Yeso gei angǝ, &lt;&lt;Lakwɔ nyim dang zuii, lakwɔ mǝn gei ǝn ɓǝ,&lt;Daa, ba yitthǝ lona kwɔ wuo lom thǝ&gt;? Langkwoi ǝn baɓǝ kwɔ ǝn wuo- yangbǝ ǝn ɓui lona zuii kwɔ. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />Daa, a dǝ angǝ a lǝ ɗuǝn mǝ!&gt;&gt;</para>
  <para style="p" vid="JHN 12:28">Nungkwɔ i lǝ yol akun wayi gei angǝ,&lt;&lt;Ən dǝ angǝ a tthǝng, langkwoi mǝn dǝ angǝ a lǝ ɗuǝn ɓǝ akun.&gt;&gt;<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />Kon kwɔ dǝi bǝilǝ kwɔ lǝ yol kwɔ, yakun gei angǝ ǝn gamvǝr, langkwoi yakun gei angǝ,&lt;&lt;Ənya nwatummi gu dǝna geiu ba!&gt;&gt;<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />Nungkwɔ Yeso gei angǝ,&lt;&lt;Ən bam i gei bakwɔ lǝu, ǝn baɓǝ. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Lakwɔ ǝn lona kwɔ i gei kwan lǝ longwam tthǝɓǝ; lakwɔ i illǝ yuu akwɔ dǝna lo yigwoi longwam kwɔ ɓǝ. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />Lakwɔ nǝ i lǝim longwam i tǝlǝ yi yang, Mǝn gub yayuu mǝn tǝlǝ tthangǝm.&gt;&gt; <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />Kwɔ dǝnnu gei bakwɔ nungkwɔ u gei ba lo bǝ ɓui ɓua kwɔ u ɓui ɓǝ.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />Kon ǝrr gei Yeso angǝ,&lt;&lt;Zuu ɓi gei ɓi tthǝ angǝ Kristi a ǝǝ laɗing. Nǝnǝ, lakwɔ, a gei mangǝ i lǝi Yui Yuu i tǝlǝ wayi? Ən yittǝn lǝ Yui Yuu ɓa?&gt;&gt;<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />Yeso gwabǝi tthǝ angǝ,&lt;&lt;Luam a dǝi dang ɓǝ lǝ lonna tuab ɓuo tthasi. Ɓa thkothko a langǝ i yirrǝ lua ɓǝtthǝ, bǝ yirrǝ thǝl bai loɓǝ thǝ; yuu nǝ dǝna thko dang bǝthǝl yang ibǝ bǝikwɔ dǝna tǝ ɓǝlǝu.<verse eid="JHN 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 12:36" />Ɓa dǝba a langǝ i tthǝ lua gabbǝi ɓǝlǝ lakwɔ ɓa tǝntǝi ɓǝ, yangbǝ ɓa mǝrrǝm lǝ yayuu na lua gabbǝi ɓǝ.&gt;&gt; Kwɔ Yeso al lo bǝ gei nungkwɔ, u pa tǝu pyǝa lo tthǝi.<verse eid="JHN 12:36" /></para>
  <para style="s">Ya Yahudawa Dǝba A Langǝ i Tthǝ Yeso Lǝu</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />I nung fǝmlo kwɔ Yeso dǝna to dang nungǝi kwɔ ǝndǝi kwɔ, i dǝba a langǝ i tthǝu lǝu, <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />Nungkwɔ yangbǝ ǝlǝ bǝ yi nwa ba kwɔ ya gei ba a tthasi Ishaya gei kwɔ mǝrrǝm lǝ ba a langǝ i:</para>
  <para style="q1" vid="JHN 12:38">&lt;&lt;Dangbang, ǝn yittǝn gwab ba kwɔ ɓi gei ɓǝ?</para>
  <para style="q2" vid="JHN 12:38">Ən yittǝn Dangbang du tthǝnyimmi kwɔ?&gt;&gt;<verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />Ən baɓǝ kwɔ i ɓuan i dǝba a langǝ i tthǝ lǝu, bakwɔ Ishaya gei langkwoi angǝ:<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />&lt;&lt;Fuh ɓuom nungǝi</para>
  <para style="q2" vid="JHN 12:40">langkwoi lam dang nyii,</para>
  <para style="q1" vid="JHN 12:40">yangbǝ nungǝi ɓyǝa bǝiu</para>
  <para style="q2" vid="JHN 12:40">lang lonyii ibǝ nungǝu,</para>
  <para style="q2" vid="JHN 12:40">langkwoi i kwoi i wuo suam muu, wui gei angǝ Fuh, a nwong ɓi.&gt;&gt;<verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />Ishaya gei nungkwɔ bakwɔ u ɓyǝa ghaali gi Yeso nungkwɔ dǝnnu gei bagu.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />Kwɔ ǝndǝi lakwɔ, ya ttha ya Israila muo sua Yeso; kwɔ lakwɔ ǝn ba ya Farisiyawa nungkwɔ dǝnni gei ba gu lǝ bǝ pya, dǝnni sur so i iilǝ dang bǝ kǝbtha gi.<verse eid="JHN 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 12:43" />Dǝnni yiɗi yuu pǝl bǝdǝ angǝ a lǝ Fuh.<verse eid="JHN 12:43" /></para>
  <para style="s">I Ghai Kwan I Ba Nwa Yeso</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Yeso gei ba i yol tǝyi tthǝ angǝ,&lt;&lt; Nǝ yuu akwɔ muo suam yang muo suam ɓuolǝu u muo ǝnsua Yuu akwɔ tummǝm ɓǝ. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />Yuu akwɔ nǝ ɓyǝam yang ɓyǝa Yuu akwɔ tummǝm ɓǝng. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Ən wua longwam i lua gabbǝi, yang yuu akwɔ nǝ dǝba a langǝ i tthǝ bam yang ǝǝ dang thǝllǝu. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />Yuu akwɔ nǝ lǝ bam dǝ ba a langǝ i tthǝm lǝu, yang ǝn toi kwan tthǝu. Ən wuo, yangbǝ wun to kwan lǝ longwam tthǝ lǝu, ǝn wuo ǝn bǝ nwong longwam. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Yakwɔ nǝ muo suam lǝu langkwoi i la bam i tthǝ i yakwɔ wa toi kwan tthǝ vii a sua ɓǝ! <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Nungkwɔ ǝn ba a langǝ i, bakwɔ dǝmǝng gei ba i tthǝnyimim lǝu, langkwoi ǝn Daa kwɔ tummǝm gei angǝ wuong gei. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />Langkwoi ǝn ibǝi bagu dǝna dǝ nwongǝi a ɗing. Nungkwɔ ǝn gei, lakwɔ, nungkwɔ Daam geimtthǝ angǝ ǝn gei ɓǝ.&gt;&gt;<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">Yeso Ɗiggǝ Bo Ya Nanungto Gu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Lakwɔ ǝn vii kwɔ gbag vii ɓang nyang lo gwoi. Yeso ibǝing lonna toǝng kwɔ u yitthǝ longwam u tǝ gwoi Daa gu ɓǝ. Vii ǝndǝi dǝnnu yiɗi yayuu akwɔ lǝ abo ɓǝ, dǝnnu yiɗi laɗing.<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />Yeso i ya nanung to gu dǝnni tangnung a nungluii. Mungkullum osi liba a ɓko dang wa Yahuda Iskariyoti, yui gi Saminu Iskaryoti, bǝ nhǝm ba lobǝ dǝ Yeso lǝ ya nung a ɓko. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />Yeso ibǝing Daa gu du tthaa ǝndǝi; u ibǝing u wuo gwoi Fuh u kwoi u tǝ gwoi Fuh.<verse eid="JHN 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 13:4" />Nungkwɔ u ǝrr bǝi kwɔ dǝnni tang nung tthǝ kwɔ, ǝrr u illǝ nunglitthǝ gu a gwam, nungkwɔ u tthǝb landǝ lo luiu lǝ. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />Nungkwɔ u al mungki dang daro ǝrr u baipi bǝ ɗiggǝ bo ya nanung to gu langkwoi dǝnnu faai tthǝ i landǝ kwɔ u tthǝb lo luiu lǝɓǝ. <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />Ərr u wuo lo Saminu Bitrus, kwɔ geiu angǝ,&lt;&lt;Dangbang dǝmma yiɗi bǝ ɗigǝ bom ma?&gt;&gt;<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />Yeso geiu angǝ,&lt;&lt;A ibǝ nungkwɔ dǝmǝng to lakwɔ ɓǝu, kwoi ma ibǝi tthasi.&gt;&gt;<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />Bitrus gei Yeso angǝ,&lt;&lt;A ɗiggǝ bom mu!&gt;&gt;</para>
  <para style="p" vid="JHN 13:8">Yeso gei angǝ,&lt;&lt;Nǝ ǝn ɗiggǝ bomǝ lǝu, yang mǝng ya na nungtom lǝu.&gt;&gt;<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />Saminu Bitrus gei angǝ,&lt;&lt;Dangbang, ma ɗiggǝ bom ɓuo lǝu, langkwoi! A ɗiggǝ nam i lom, ǝndǝi!&gt;&gt;<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />Yeso gei angǝ,&lt;&lt;Yakwɔ wolmung yang i ɗiggǝ tthǝing langkwoi i wolmung akunu, u ɗiggǝ ǝn boi ɓuo. Ɓǝ ǝn ya langǝ i- yuu akun ɓuo.&gt;&gt; <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />(Yeso osi ibǝ yuu akwɔ wa ɓangǝu lǝ ɓǝng; nungkwɔ u gei angǝ,&lt;&lt; Ɓǝ ǝndǝi, ǝn ya langǝ i lǝu.&gt;&gt;)<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />Kwɔ Yeso ɗiggǝ boi ǝndǝi, nungkwɔ u kwailǝ nunglitthǝ gu a gwam bǝ u li nungkwɔ u kwoi u tǝ bǝi kwɔ dǝu tangnung tthǝ ɓǝ. Yeso ɓibǝi angǝ,&lt;&lt;Ɓa ibǝ nungkwɔ ǝn toɓǝ tthǝ ɓǝngha?&gt;&gt; <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />Lo zuiu dǝ ɓa lubǝim ɓangǝ ya nanatthǝnung i Dangbang, bakwɔ ǝn ɗuǝnǝm ɓǝ. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Ɓang, Dangbang i ya nanatthǝnung ɓǝ, ǝn ɗiggǝ boɓǝ, ɓǝ lakwɔ, ɓa ɗiggǝ bo tha. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Ən taɓǝ natthǝ ǝn nung, yangbǝ ɓa to nungkwɔ ǝn naɓǝ natthǝ ɓǝ. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />Dǝmǝng gei ɓǝ ba a langǝ i tthǝ: thǝb yangǝu kwɔ a pǝl yikku gwoi gu ɓǝ, langkwoi ya nwatummi yangǝu kwɔ a pǝl yuu akwɔ dǝna tummu ɓǝu. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Kwɔ lakwɔ ɓa ibǝ ba a langǝ i kwɔ, tthǝla nǝnǝ ɓa lǝ nǝɓa tolǝ nungto ɓǝ!<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />&lt;&lt;Dǝmǝng gei ba lǝng ɓǝ ǝndǝi lǝu; Ən ibǝ yakwɔ ǝn mko ɓǝng. Ba gi Fuh ǝn ba a langǝ i kwɔ gei angǝ,&lt;&lt;Yuu akwɔ dǝna tangnung i ɓanglǝ kwɔ ǝrr lom lǝ.&gt; <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />Dǝmǝng gei ɓǝ bakwɔ tthǝ lakwɔ yirrǝ nungɓǝ wuo lǝu, yang nǝ wuo tonung, yang ɓa ibǝi&lt; Ən ɓang kwɔ laɗing ɓǝ.&gt;<verse eid="JHN 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 13:20" />Dǝmǝn gei ɓǝ ba a langǝ i tthǝ: yuu akwɔ nǝ muo sua yuu akwɔ ǝn tum kwɔ yang u muo ǝn ɓang langɓǝ; lang nǝ yuu akwɔ nǝ mum yang muu ǝn Yuu akwɔ tumǝm ɓǝ.&gt;&gt;<verse eid="JHN 13:20" /></para>
  <para style="s">Yeso Gei Angǝ I Ɓangǝ ilǝ</para>
  <para style="r">(<ref loc="MAT 26:20-25">Matthew 26:20-25</ref>; <ref loc="MRK 14:17-21">Markus 14:17-21</ref>; <ref loc="LUK 22:21-23">Luka 22:21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Tthasua kwɔ Yeso gei nungkwɔ, ɓyangǝu dǝna lǝ tthǝzii ghaatthǝ u gei angǝ,&lt;&lt;Dǝmǝng gei ɓǝ ba a langǝ i tthǝ: Yuu a kun dang ɓǝ a ɓangǝmlǝ.&gt;&gt;<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />Ya nanung to gu ǝrr ɓyǝa tha, loi tthǝb bakwɔ i ibǝ yuu akwɔ dǝnnu gei ɓǝlǝu. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Yuu a kun dang ya nanung to gu, yuu akwɔ Yeso dǝna yiɗi niɓǝ, u ǝǝ gɓag Yeso. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />Saminu Bitrus gei ba angǝ,&lt;&lt;A gei ɓitthǝ ǝn yittǝn dǝma gei ba lo.&gt;&gt;<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />Nungkwɔ ya nanung to ɓǝ li tthǝu tthǝ Yeso ɓibbu angǝ,&lt;&lt;Dangbang, ǝn yittǝn dǝma gei?&gt;&gt;<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />Yeso gwab nwa angǝ,&lt;&lt;Yuu akwɔ mǝn kwǝ burodi kwɔ mǝn du ɓǝ; u lǝ yuu ɓǝ.&gt;&gt;Nungkwɔ ǝrr u lǝi burodi tuab, u kwǝ, u dǝlǝ Yahuda Iskariyoti, yui gi Saminu. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />Dangtthǝ Yahuda muo burodi kwɔ, Mungkullum tǝ tthǝu. Yeso geiu angǝ,&lt;&lt;A wuo thǝmtthǝ wa to nungkwɔ a yiɗi ɓǝ!&gt;&gt; <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />Kwoi yuu akun yangǝu dang bǝ tangnung lǝ kwɔ ibǝ bakwɔ Yeso dǝna gei Yahuda manungɓǝ lǝu.<verse eid="JHN 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 13:29" />Kwɔ Yahuda lǝ yuu akwɔ dǝna muo tthko nungkurɓǝ nalǝ, sua ya nanung to gi Yeso dǝna nhǝm angǝ lko Yeso ɗǝnna gei angǝ tǝu ɗyǝab nungtang lǝ ba vii ɓang, ko tǝu dǝ nung akun lǝ ya yiɓko.<verse eid="JHN 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30" />Dangtthǝ Yahuda muo burodi ɓǝni ǝrr igwam. Ən nungvii.<verse eid="JHN 13:30" /></para>
  <para style="s">Zuu A Fuu</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Tthasua kwɔ Yahuda ǝrr i gwam, Yeso gei angǝ,&lt;&lt;Lakwɔ ghaali gi Yui Yuu i gwammǝng; Lakwɔ i dǝ angǝ a lǝ Fuh ba gu.<verse eid="JHN 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 13:32" />Langkwoi nǝ ghaali Fuh igwam lǝ ba gu, yang Fuh a illǝ ghaali gi Yui i nkolǝ, langkwoi u to nungkun. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />Yathangǝm, sua vii tuabni Mǝn ǝǝ iɓǝ. Ɓa ɗubǝim; kwoi ǝn gei ɓǝtthǝ nǝnǝngkwɔ nung kwɔ ǝn geilǝ yakku ya Yahudawa tthǝɓǝ,&lt;Ɓa ɓuan ɓatǝ bǝikwɔ mǝn tǝ ɓǝu.&gt; <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />Kwoi lakwɔ dǝmǝn dǝɓǝ zuu afu: ɓa yiɗi tha. Manungkwɔ ǝn yiɗi ɓǝɓǝ, lakwɔ ɓa yiɗi tha manungɓǝ. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Nǝ ɓǝtthǝ ibǝ yiɗi tha, yang yayuu ǝndǝi a ibǝi ɓǝ ǝnya nanungtom.&gt;&gt;<verse eid="JHN 13:35" /></para>
  <para style="s">Yeso Ghai Bǝ Yǝrnwa Gi Bitrus</para>
  <para style="r">(<ref loc="MAT 26:31-35">Matthew 26:31-35</ref>; <ref loc="MRK 14:27-31">Markus 14:27-31</ref>; <ref loc="LUK 22:31-34">Luka 22:31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />Saminu Bitrus ɓib angǝ,&lt;&lt;Dǝma tǝm pǝttǝn na, Dangbang?&gt;&gt;</para>
  <para style="p" vid="JHN 13:36">&lt;&lt;Yeso gei angǝ, &lt;&lt;Ɓa ɓuan ɓa muo suam nǝnǝngkwɔ bǝi kwɔ dǝmǝn tǝ ɓǝu kwoi natthǝ ɓa muo suam,&gt;&gt;<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />Bitrus ɓib angǝ&lt;&lt;Dangbang, ǝn baɓǝ bǝ ǝn ɓuan ǝn muo sua mǝ nǝnǝngkwɔ wa? Ən ǝǝ lozuii bǝ ɓuiu ba mǝ!&gt;&gt;<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />Nungkwɔ Yeso gwab nwa angǝ,&lt;&lt;Ən ba a langǝ i a mab ma ɓui ba ɓangǝ? Dǝmǝng gei ɓǝ ba a langǝ i tthǝ: nungbǝi akwɔ gog a ta yang ma yǝrnwa botai mangǝ a imlǝu.<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">Yeso Lǝ Nunglǝi Tǝ Gwoi Daa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />Yeso gei angǝ,&lt;&lt;Bǝ ɓa ǝrr lǝ kiggǝ ɓǝthǝ, Ɓa dǝ ba a langǝ i tthǝ Fuh ɓa dǝ ba a langǝ i tthǝm. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Gwoi Daam Kǝm paknǝkwam; nǝ nilǝu, Yang mǝn gei ɓǝtthǝ. Langkwoi tǝmǝng mab ɓǝ bǝitthǝ. Nǝ nilǝu krǝ yang ǝn gei ɓǝ tthǝu. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />Langkwoi nǝ tǝn mab bǝi lǝ ba ɓǝ, yang mǝng kwoi wuomǝng tǝɓǝ lǝ, yangbǝ ɓa ǝǝ bǝikwɔ ɓang tthǝ ɓǝ. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />Ɓa ibǝ nunglǝi bǝi kwɔ tǝlǝ bǝi kwɔ dǝmmǝn tǝɓǝng.&gt;&gt;<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />Toma ǝrr ɓibbu angǝ,&lt;&lt;Dangbang, ɓi ibǝ bǝikwɔ dǝma tǝɓǝ lǝu; lakwɔ ɓi tonǝnǝ ɓi ibǝ nunglǝi kwɔ ɓi tǝlǝ bǝi ɓǝɓa?&gt;&gt;<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />Yeso geiu angǝ,&lt;&lt;Ən ɓanglǝ nunglǝi, i ba a langǝ i, i nwongǝi; yuu yangǝu kwɔ a tǝtthǝ Dako kwɔ muo tthǝm lǝuɓǝ. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />U gei angǝ, Kwɔ lakwɔ ɓa immǝng kwɔ, ɓa i Daam ǝn i langɓǝ, lakwɔ ɓa iiung langkwoi ɓa ɓyǝkong.&gt;&gt;<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />Filibus geiu angǝ,&lt;&lt;Dangbang, a taɓi natthǝ Daa ɓǝlǝ; nungkwɔ ɓuo dǝɓi yiɗi.&gt;&gt;<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />Yeso gwab nwa angǝ,&lt;&lt;Sua tuung ɓang suatha iɓǝlǝ ǝndǝi; kwoi yirrǝ a imlǝu, Filibus? Yuu akwɔ nǝ immǝng yang i Daam mǝng. Ən baɓǝ, lakwɔ, dǝɓa gei ɓangǝ,&lt;A taɓi natthǝ Daa ɓǝla&gt;? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />A dǝ ba a langǝ i tthǝ lǝu, Filibus, kwɔ ǝn geigǝ ɓang tthǝ Daa langkwoi Daa tthǝmlǝ? Bakwɔ ǝn gei ɓǝtthǝ ɓǝ,&gt;&gt;Yeso gei ya nanung to gu angǝ,&lt;&lt;Ən abǝm lǝu. A bǝ Daa, kwɔ dang tthǝm lǝɓǝ, dǝna to nung to gu. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Ɓa dǝba a langǝ i tthǝm bakwɔ ǝn geigǝ Ɓang dang tthǝ Daa langkwoi Daa dang tthǝm ɓǝ. Nǝni lǝu, ɓa dǝba a langǝ i tthǝ nungfǝmlo kwɔ dǝmǝn toɓǝ.<verse eid="JHN 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 14:12" />Dǝmǝn gei ɓǝ ba a langǝ i tthǝ: yakwɔ dǝba a langǝ i tthǝm yang i tonungkwɔ dǝmǝng toɓǝ, ǝah i to nung a kwɔ ghaa pǝl abǝm ɓǝ, bakwɔ dǝmǝn tǝn sua Daa ɓǝ. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />Yang mǝn toɓǝ nung ǝndǝi kwɔ ɓa yam dang ɗuǝnǝm ɓǝ, yangbǝ i ɓyǝa ghaali gi Daa tthǝ Yui lǝ. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Nǝ ɓa yam nung ǝndǝi dang ɗuǝnǝm, yang Mǝn toɓǝ tthǝ.<verse eid="JHN 14:14" /></para>
  <para style="s">Bǝ Gwabnwa Ɓyang A Langǝ i</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />&lt;&lt; Nǝ dǝ ɓa yiɗim, yang ɓa dǝ angǝ a tthǝ zuum. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />Mǝn yam Daa, yang u dǝɓǝ yuu akun, kwɔ a ǝǝ i ɓǝlǝ laɗing ɓǝ <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />U lǝ Ɓyang a Langǝ i kwɔ a naɓǝ natthǝ ba a langǝ i lǝ ba Fuh ɓǝ. Longwam labǝ muu, bakwɔ i ɓyǝko lǝu ko i iu. Kwoi ɓa iung, bakwɔ u ǝǝ i ɓǝ langkwoi u tthǝɓǝ.<verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />&lt;&lt; Kwɔ nǝ ǝnpa, ǝn yiɓǝ ɓǝ i nungtthǝ ɓǝu; Mǝn kwoi mǝn wuo sua ɓǝ. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Natthǝ tuab yang longwam ɓyǝam akunu, kwoi yang ɓa ɓyǝam ǝn ɓyǝa; langkwoi bakwɔ ɓang tthǝ i nwongǝi. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Kwɔ nǝ vii ɓǝ kullo wuo, yang ɓa ibǝi ɓang tthǝ Daa langkwoi ɓǝma ɓǝ tthǝm, manungkwɔ ɓang tthǝɓǝ ɓǝ.<verse eid="JHN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21" />&lt;&lt;Yakwɔ muo zuum langkwoi dǝna tolǝ nung to yang ilǝ yakwɔ dǝna yiɗim ɓǝ. Daam a yiɗi yakwɔ dǝna yiɗim ɓǝ; Ɓang ma langɓǝ mǝn yiɗi gi mǝn ilǝ lom tthǝi yang i im la langǝ i.&gt;&gt;<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />Yang Yahuda (Yahuda Iskariyoti lǝu) gei angǝ,&lt;&lt;Kwoi, Dangbang, ǝn baɓǝ bǝ dǝmma yiɗi bǝ taɓi natthǝ mǝ yang a ta natthǝ mǝ lǝ ya longwam lǝu?&gt;&gt;<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />Yeso gwab nwa angǝ,&lt;&lt;Yuu akwɔ dǝna yiɗim yang a to nung to ibǝ nanatthǝ nungǝm. Daam a yiɗi gu, langkwoi yang Daam i ɓang ɓi wuu suai ɓi ǝǝ i ilǝ. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Yuu akwɔ nǝ yiɗim lǝu yang to nung to ibǝ nanatthǝ nungǝmmu. Langkwoi bǝ nanatthǝ nungkwɔ ɓa lǝ kwɔ ǝn a bǝm lǝu, kwoi wuu bǝgǝ Daa kwɔ tummǝm ɓǝ.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />&lt;&lt;Ən gei ɓǝ nungkwɔ tthǝ kwɔ yirrǝ ɓang i ɓǝlǝ ɓǝ. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />Kwoi ya nwongbǝi, Ɓyang a langǝ i, kwɔ Daa a tummu dang ɗunǝm lǝɓǝ, wuu naɓǝnatthǝ nung ǝndǝi langkwoi u owhɓǝ nyitthǝ nungkwɔ ǝndǝi ǝn gei ɓǝtthǝ ɓǝ.<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />&lt;&lt;Bǝ ǝǝ latthǝ ǝn nungkwɔ ǝn yiɓǝ tthǝ ɓǝ; bǝ ǝǝ latthǝm nungkwɔ ǝn dǝɓǝ. Dǝm dǝ manung akwɔ ya longwam kwɔ dǝna dǝɓǝ lǝu. Bǝ kiggǝ ɓǝ ǝrthǝ; langkwoi bǝɓa sur vulli thǝ.<verse eid="JHN 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 14:28" />Ɓa lǝm ǝn geigǝ,&lt;Dǝmǝn pa, kwoi mǝn kwoi suam ǝn kwoi mǝn wuo sua ɓǝ.&gt;Nǝ dǝɓa yiɗim, ɓa lǝ tthǝla kwɔ dǝmǝn tǝ gwoi gi Daa ɓǝ; bakwɔ u ghaa u pǝllǝm ɓǝ. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />Ən gei ɓǝ nungkwɔ tthǝng lakwɔ nwuni bǝ totthǝ, yangbǝ nǝ totthǝ, yang ɓa dǝba a langǝ i tthǝ. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />Ən ɓuan ǝn gei ba akun i ɓǝlǝ kpaa tthǝu, bakwɔ ya lo yigwoi longwam dǝna wɔ. U yangǝu i ttha lom lǝu, <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />Kwoi longwam a ibǝi angǝ dǝmǝn yiɗi Daa; nungkwɔ dǝm to nungkwɔ ǝndǝi u gei angǝ ǝn toɓǝ.</para>
  <para style="p" vid="JHN 14:31">&lt;&lt;Ɓa wɔ, wuɓi pa bǝikwɔ.<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">Yeso Lǝ Kab Inabi Alangǝ i</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />&lt;&lt;Ɓang lǝ kab inabi a langǝ i, langkwoi Daam lǝ ya nung lǝbbi ɓǝ. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />U ɓǝr sinna kab akwɔ tthǝmlǝ kwɔ siu ɓǝ, langkwoi u mab sinna kab akwɔ dǝna si ɓǝ, yangbǝ tǝi bǝi langkwoi lilo bǝ siu. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />I osi i mab ɓǝ i tthǝng lǝ babǝ nanatthǝnung kwɔ ǝn dǝɓǝ ɓǝ. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Ɓa kǝbtha lo i ɓanglǝ, langkwoi yang langɓǝ mǝn kǝbtha lo iɓǝ. Sinna kab yangǝu a si siu i nkolǝu; u ɓuan u toni ɓuo nǝ u tthǝ kab inabi lǝ ɗǝ. Manung ɓǝni ɓa si sii kabbu nǝ ɓa ǝǝ i ɓang ɗǝ.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />&lt;&lt;Ən ɓang lǝ kab inabi, langkwoi ɓǝlǝ i sinna kab ɓǝ. Yakwɔ nǝ kǝbtha lo i ɓang, langkwoi ɓang i ilǝ, i si kpaatthǝ; bakwɔ ɓa ɓuan ɓa to nung akunu nǝ ǝn yangǝu i ɓǝu ɓǝ. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />Yuu akwɔ nǝ kǝbtha lo i ɓang lǝu yang i wkolǝtǝ mangǝn sinna kab yang kwi; i gǝm i sinakab ɓǝkwɔ i ali dang lua, bǝilǝ kwɔ i li. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />Nǝɓa kǝbtha lo i ɓang langkwoi dǝɓa to nungkwɔ bam gei ɓǝ, yang ɓa yam nung ǝndǝi kwɔ dǝɓa yidɗi kwɔ, ɓa tǝntǝi. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Kwɔ nǝ dǝɓa si sikab kpaatthǝ dǝm gei ɓǝtthǝ Daam a tǝi ghaali; manung kwɔni yang, ɓa mǝrrǝm lǝ ya nanungtom. <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />Dǝmǝn yiɗi ɓǝ manung akwɔ Daam dǝna yiɗim ɓǝ. Ɓa ǝǝ dang bǝ yiɗi bǝim. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />Nǝ ɓa to nung to i nungkwɔ ǝn geigǝ, ɓa ǝǝ dang bǝ yiɗi bǝim, manug akwɔ ǝn to nung to i a bǝ Daa gei angǝ ǝn toɓǝ langkwoi ǝn ǝǝ dang bǝ yiɗi bǝi gu.<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />&lt;&lt;Ən gei ɓǝ nungkwɔ tthǝ yangbǝ ɓa lǝ tthǝla langkwoi yangbǝ tthǝla ɓǝ a ǝǝ laɗing, <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Zuum manungkwɔni: ɓa yiɗi tha, manungkwɔ ǝn yidɗi ɓǝɓǝ.<verse eid="JHN 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 15:13" />Bǝ yiɗi bǝi angǝ a kwɔ yuu a yiɗi lǝya ǝnthǝu kwɔ nungɓǝlǝ bǝ dǝ nwongǝi gu lǝ ba gi.<verse eid="JHN 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 15:14" />Langkwoi ɓǝ ǝnya ǝnthǝm nǝɓa tonungkwɔ ǝn gei ɓǝ gǝngǝ ɓa toɓǝ. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Ən luu ɓǝ lǝ ya thǝb a kunnu, bakwɔ ya thǝb ibǝ nungkwɔ yayuu gwoi gi dǝna toɓǝ lǝu. Manungkwɔ ni, Ən luu ɓǝlǝ ya ǝnthǝ, bakwɔ ǝn gei ɓǝ nungtthǝ ǝndǝing kwɔ ǝn lǝ nwa Daa ɓǝ. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Ənɓǝ ɓa mkom lǝu, ɓang ǝn mko ɓǝ langkwoi ǝn gei ɓǝ tǝɓa si sikab kpaatthǝ, sikab kwɔ ǝǝ sua tuutthǝ ɓǝ. Yang Daa a dǝɓǝ nungkwɔ ǝndǝi ɓa yam nung dang ɗuǝnǝm ɓǝ. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Nung zuum gei manungkwɔni: Ɓa yiɗi tha.<verse eid="JHN 15:17" /></para>
  <para style="s">Bǝ Tthǝngbǝi Ya Longwam</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />&lt;&lt;Nǝ ya longwam laɓǝ, yang ɓa nhǝm ɓangǝ ya longwam osi lamǝng nungsi. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Nǝ ɓǝng a longwam, yang ya longwam a yiɗi ɓǝ. Kwoi ǝn mko ɓǝ dang ya longwam, lakwɔ ɓǝng a longwam lǝu; Ən baɓǝkwɔ longwam dǝna laɓǝ ɓǝ. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />Ɓa nhǝm nungkwɔ ǝn gei ɓǝtthǝ ɓǝ: &lt;Thǝb yangǝu kwɔ a ghaa a pǝl togwoi gu ɓǝ.&gt;Nǝ i dǝm zuii, i dǝɓǝ zuii langɓǝ; nǝ i gwab bǝ nanatthǝ nungǝm, yang i gwab bǝ nanatthǝnung ɓǝ langɓǝ. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />Kwoi i toɓǝ i nungkwɔ ǝndǝi bakwɔ ɓǝng abǝm ɓǝ; bakwɔ i ibǝ Yuu akwɔ tumǝm ɓǝ lǝu. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />Nǝ krǝ ǝn wuo wuong gei ba lǝu yang kwan nung aɓau muiu; nung a ɓko gi lǝu, Lakwɔ nikwɔ i yangǝu i nungkwɔ i gei lǝ ba nung a ɓko giu. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />Yuu akwɔ nǝ tthǝngǝm yang tthǝng ǝn Daam langɓǝ. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Nǝ ǝn to nungkwɔ yuu akun yangǝu to bokun dang ǝi ɓǝlǝu yang kwan nung a ɓko muǝng; lakwɔ nikwɔ, i ɓyǝa nungkwɔ ǝn to ɓǝng, langkwoi i tthǝngǝm i Daam ǝndǝi. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Kwoi nungkwɔ yangbǝ ǝǝlǝ bǝ yinwa ba nungkwɔ i vullǝ dang zuu kwɔ a ǝǝlǝ ba a langǝ i: &lt;I tthǝngǝm nǝkwam.&gt; <verse eid="JHN 15:25" /><verse number="26" style="v" sid="JHN 15:26" />&lt;&lt;Ya nwongbǝi dǝna wɔ Ɓyang gi Fuh, kwɔ a gei ɓǝ ba a langǝ itthǝ lǝ ba Fuh langkwoi yuu akwɔ wuo bǝgǝ Daa ɓǝ. Mǝn tummu bǝgǝ Daa lǝ suaɓǝ, langkwoi wuu geiɓǝ bam tthǝ. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />Langkwoi ɓǝ, langɓǝ, ɓa gei bam, bakwɔ ɓǝ i ɓanglǝ la nwasiu ɓǝ.<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />Ən gei ɓǝ nungkwɔtthǝ, yangbǝ bǝɓa yitthǝ bǝ dǝ nyi ɓǝtthǝ. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />I nanɓǝ dang kǝm kǝbtha, langkwoi lona dǝna wɔ kwɔ nǝ yuu akun thǝb ɓǝ yang a nhǝm angǝ dǝni to nung to gi Fuh. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />Yayuu ato ɓǝ i nungɓǝkwɔ bakwɔ i i Daa lǝu ko ǝn ɓang. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Kwoi ǝn gei ɓǝ nungkwɔ tthǝ, yangbǝ kwɔ nǝ lona wɔitthǝ kwɔ i to i nungkwɔ, yang ɓa nhǝm ɓangǝ ǝn gei ɓǝtthǝng.</para>
  <para style="s" vid="JHN 16:4">Nung to Ɓyang A Langǝ i</para>
  <para style="p" vid="JHN 16:4">Ən gei ɓǝ i nungkwɔtthǝ la nwasiu lǝu, bakwɔ ɓang i ɓǝlǝ ɓǝ.<verse eid="JHN 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />Kwoi lakwɔ dǝmǝn tǝ sua yuu akwɔ tummǝm ɓǝ, kwoi yuu akun yangǝu dang ɓǝ ɓibbǝm bǝikwɔ Dǝm tǝɓǝ lǝu. <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Langkwoi lakwɔ ǝn geiɓǝ tthǝng, ɓǝ ǝndǝi dang wa ɓǝ ɓanglǝ ghaatthǝ. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Kwoi dǝmǝn gei ɓǝ ba a langǝ itthǝ: a maɓǝtthǝ ɗing kwɔ dǝm paɓǝ, Bakwɔ nǝ ǝn pallǝu yang, Ya nwongbǝi wuo suaɓǝu. Kwoi nǝ ǝnpa, yang mǝn tummu sua ɓǝ. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />Langkwoi kwɔ nǝ u wuo, wuu gei lǝ ya longwam tthǝ ba a langǝ i lo nung a ɓko langkwoi i Fuh i kwan. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />Wuu gei yayuu angǝ gong nung a ɓko gi nungɓǝ lǝ i dǝ ba a langǝ i tthǝm lǝu. <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />I la nung a langǝ i gi Fuh, bakwɔ Dǝm kwoi dǝm tǝ sua Daa, bǝi kwɔ ɓa ɓyǝam a kunnu ɓǝ; <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />langkwoi bǝ ibǝ kwan gi ǝn a langǝ i lǝu, bakwɔ ya lo yigwoi longwam kwɔ i osi i tou kwanǝng.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />Nung kpaaɗing kwɔ dǝm yidɗi bǝ gei ɓǝtthǝ ɓǝ, kwoi a kpaa ɓǝtthǝ ɗing kwɔ ɓa muo ɓǝ. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Kwoi kwɔ, Ɓyang a Langǝ i wuo, wuu gei ɓǝ ba a langǝ itthǝ lǝ ba Fuh, u owhɓǝlǝ si dang ba a langǝ i ǝndǝi. U gei ba i tthǝnyimmi gu lǝu; kwoi wuu gei nungkwɔ u lǝɓǝ, langkwoi wuu gei bǝ nungkwɔ tthǝ a wɔ ɓǝ. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />U wumlǝ ghaali tthǝ, bakwɔ wuo lǝi nungkwɔ ǝn gei kwɔ u gei ɓǝtthǝ. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />Nung gi Daam ǝndǝi ǝn abǝm; Nungkwɔ ǝn geigǝ Ɓyang Fuh a lǝi nungkwɔ ǝn duu kwɔ u gei ɓǝtthǝ.<verse eid="JHN 16:15" /></para>
  <para style="s">Dangwa A Ɓuonni A Mǝrǝmlǝ Tthǝla</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />&lt;&lt;Nathǝ tuab yang ɓa ɓyǝam a kunnu, langkwoi natthǝ tuab yang ɓa ɓyǝam langkwoi.&gt;&gt;<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />Yakun dang ya nanung to ɓib tha angǝ, &lt;&lt;Ənɓǝ dǝnnu nhǝm kwɔ dǝnnu gei angǝ, &lt;&lt;Natthǝ tuab yang ɓa ɓyǝam a kunnu ɓa, langkwoi yang natthǝ tuab ɓa ɓyǝam wa,&gt; langkwoi &lt;Bakwɔ dǝnni tǝ sua Daa&gt;?&gt;&gt; <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />I ǝǝnwa bǝ ɓib ba angǝ, &lt;&lt;Ənɓǝ dǝnnu nufi kwɔ angǝ&lt; natthǝ tuab ɓa&gt;? Ɓi ibǝi nungkwɔ dǝnnu gei ɓǝlǝu.&gt;&gt;<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />Yeso ibǝi dǝnni yiɗi bǝ ɓibbu, nungkwɔ u gei angǝ, &lt;&lt;Dǝɓa ɓib ttha lǝ ba nungkwɔ ǝn geigǝ, &lt;Natthǝ tuab yang ɓa ɓyǝam a kunnu, langkwoi yang natthǝ tuab yang ɓa ɓyǝam ɓa&gt;? <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />Ən gei ɓǝ ba a langǝ i tthǝ, ɓa tasui ɓa ǝǝnwa kǝm ɓua yang longwam a lǝtthǝla, kwoi dang wa a ɓuonni ɓǝ a mǝrǝmlǝ tthǝla. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Yisi kwɔ dǝna tǝbǝ si yui kwɔ tthǝ i tthǝzii bakwɔ lona gu wung ɓǝ; kwoi kwɔ nǝ u si yui ɓǝ yang u danyitthǝ tthǝzii ba tthǝla kwɔ u si yuiu dang longwam ɓǝ. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Manungɓǝ i ɓǝlǝ: Lakwɔ lǝ lona tthǝzii ɓǝ, kwoi mǝn ɓyǝa ɓǝ langkwoi ɓa lǝtthǝla dang nyiɓǝ, yuu yangǝu a lǝi tthǝla ɓǝu. <verse eid="JHN 16:22" /><verse number="23" style="v" sid="JHN 16:23" />Kwɔ viiɓǝ kwɔ a wɔ, ɓa ɓibbǝm nung a kunnu. Ən gei ɓǝ ba a langǝ i tthǝ: Daa a dǝɓǝ nung ǝndǝi kwɔ ɓa yam dang ɗuǝnǝm ɓǝ. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Baipiu lakuu wulǝ lakwɔ ɓa yam nung akun dang ɗuǝnǝm lǝu. Ɓa ɓib yang ɓa muo, yang ɓa lǝ tthǝla ghaatthǝ.<verse eid="JHN 16:24" /></para>
  <para style="s">Ən sob lo Lo Longwam</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />Dǝm to nung to i ba dang ba dǝm gei ɓǝ i nungkwɔ tthǝ, Kwoi lona dǝna wɔ kwɔ ǝn gei ba dang ba a kunnu, kwoi mǝn gei ɓǝtthǝ kaitthǝ lǝ ba Daa. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Kwɔ vii ɓǝ nǝ wuo, ɓa yammu dang ɗuǝnnǝm, Dǝm geigǝ mǝn yam Daa nwathan ɓǝlǝu, <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />Bakwɔ Daa i nkolǝ dǝna yiɗi ɓǝ. Dǝu yiɗi ɓǝ bakwɔ dǝ ɓa yiɗim ɓǝ langkwoi ɓa dǝ ba a langǝ i tthǝ ɓangǝ ǝn ǝrr bǝgǝ Fuh. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Ən wuo bǝgǝ Daa ǝn wuo dang longwam; langkwoi lakwɔ dǝmmǝn yitthǝ longwam dǝmmǝn tǝ sua Daa.&gt;&gt;<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />Yang ya nanung to gu gei angǝ, &lt;&lt;Lakwɔ dǝmma gei ba kaitthǝ i ba dang ba lǝu. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Lakwɔ ɓi ibǝing a ibǝ nung ǝndǝing langkwoi a gwab kwɔ yuu akun a ɓiba ba ɓǝlǝu. Nungkwɔ to ɓi dǝ ba a langǝ i tthǝ ɓingǝ a wɔ bǝgǝ Fuh.&gt;&gt;<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />Yeso gwabbǝi nwa angǝ, &lt;&lt;Ɓa dǝ ba a langǝ itthǝng lakwa!&gt;&gt; <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Kwoi lona dǝna wɔ lona ɓǝ wung, kwɔ ɓa yǝbtha ɓǝ, ko ǝnya a tǝ gwoi gu. Yirrǝ ɓang i nungtthǝm lǝu, bakwɔ Daam i ɓanglǝ ɓǝ.<verse eid="JHN 16:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 16:33" />&lt;&lt; Ən gei ɓǝ i nungkwɔ tthǝ, yangbǝ dang tthǝm lǝ ɓa tǝi nyitǝmmi. Dang longwam kwɔ ɓa tǝi bǝ nyua bǝi. Kwoi ɓa lǝi i nyi! Ən sob lo lo longwamǝng.&gt;&gt;<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">Yeso pinwa Lǝ Ya Nanungto Gu Tthǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Tthasua kwɔ Yeso alo bǝ gei nungkwɔ, u lǝi lo yi angǝ, &lt;&lt;Daa, lona wung. A dǝ ttha i ghaali lǝ Yuimǝ, yangbǝ Yuimǝ da angǝ a. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />Bakwɔ a duu tthǝnyimmi lo thayuu ǝndǝi, yangbǝ u dǝ nwongǝi a ɗing lǝ yakwɔ ǝndǝi a du ɓǝ. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />Langkwoi nwongǝi a ɗing nungɓǝ lǝ bǝ ie, kwɔ lǝ Fuh a langǝ i kun, langkwoi bǝ ibǝ Yeso Kristi, kwɔ a tummu ɓǝ. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Ən tanatthǝ ghaali mǝ longwam; Ən alo nung to kwɔ a dǝm mangǝ ǝn to ɓǝng. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />Daa! A dǝm ghaali dang nung mǝ lakwɔ, ghaali kwɔ lanwasiu ɓang i mǝlǝ nwuni bǝ i mab longwam ɓǝ.<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />&lt;&lt;Ən tanatthǝmǝ lǝ yakwɔ a mkoǝmtthǝ longwam ɓǝ. I ǝn amǝ, nungkwɔ a dǝmmǝi. I kang ba mǝng, <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />langkwɔi lakwɔ i ibǝi nungkwɔ ǝndǝi kwɔ a dǝm kwɔ ǝn amǝ. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />Ən gei bakwɔ a geimtthǝ kwɔ ɓǝng, langkwoi i mung; i ibǝing la langǝ i angǝ ǝn ǝrr bǝgǝ mǝ, langkwoi i dǝ ba a langǝ itthǝ angǝ ǝn mǝ a tummǝm.<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />&lt;&lt;Ən pinwa lǝ bagi. Ən pinwa lǝ longwam kwoi lǝn ba yakwɔ a dǝmɓǝ, bakwɔ i ǝn amǝ ɓǝ. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />Nungǝm ǝndǝi ǝn amǝ, langkwoi nungmǝ ǝndǝi ǝn abǝm; langkwoi ghaali tthǝn tthǝ i nungɓǝ kwɔ. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Langkwoi lakwɔ dǝmmǝn tǝ suamǝ; Ən yangǝu longwammu, kwoi i dang longwam. Daa a Langǝ i! A kangǝ i matthǝ i dang ttha ɗuǝnmǝ, ɗuǝn kwɔ a dǝm ɓǝ, yangbǝ i mǝrǝm kun manungkwɔ mǝ i Ɓang kun ɓǝ. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Kwoi kwɔ Ɓang i ilǝ kwɔ, Ən kangǝ i matthǝ dang ttha ɗuǝn mǝ, ɗuǝn kwɔ a dǝmɓǝ, Ən kangǝ i lǝ, yuu akun yangǝu dang ǝi ttha, yuu kunɗǝng ɓuo kwɔ la nwasiu u lǝnla ɓǝ- yangbǝ ǝlǝ bǝ yinwa nung vullǝ ǝn ba a langǝ i. <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />Langkwoi lakwɔ dǝm tǝsua mǝ, langkwoi dǝm gei i nungkwɔ dang longwam yangbǝ i tǝi tthǝllam dang wailǝ ǝndǝi. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Ən ji ba a langǝ i mǝ, ya longwam tthǝngǝi, bakwɔ i ǝn a longwam lǝu ɓǝ, manung akwɔ ɓang ǝn a longwam lǝu ɓǝ. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Ən pinwa geigǝ a lǝi dang longwam lǝu, kwoi Ən yamma yangbǝ a kangǝ i na Mungkullum. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />Manung a kwɔ ɓang Ən a longwam lǝu ɓǝ, i ǝn a longwam lǝu. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Ən mabbǝi lǝ amǝ lo ba a langǝ i; ba mǝ ǝn ba a langǝ i. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Ən tummǝi dang longwam manung a kwɔ a tummǝm dang longwam ɓǝ. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Langkwoi lǝ ba gi ǝn dǝ lom ba bǝ to nungkwɔ dǝmma yiɗi ɓǝ, yangbǝ, i langɓǝ dǝ loi la langǝ i lǝba mǝ.<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />&lt;&lt;Dǝmǝn pinwa lǝ bagi ɓuo lǝu, kwoi langɓǝ lǝba yakwɔ dǝba a langǝ i tthǝm lǝba ba a langǝ i gi ɓǝ. <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />Dǝmǝn pinwa yangbǝ i ǝndǝi nwuai wuu kun. Daa! Kaso i ǝǝ kun i ɓi, manungkwɔ mǝ dang tthǝm langkwoi Ɓang dang tthǝmmǝ ɓǝ. Kaso i ǝǝ kun, yangbǝ longwam dǝba a langǝ i tthǝ angǝ ǝn mǝ a tummǝm. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Ən ji ghaali manung akwɔ a dǝmɓǝ, yangbǝ nwuai wuu kun, manung akwɔ mǝ i Ɓang kun ɓǝ: <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />Ɓang dang tthǝi langkwoi mǝ dang tthǝm, yangbǝ i ǝndǝi nwuai wuu kun, yangbǝ longwam ibǝi angǝ ǝn mǝ a tummǝm langkwoi dǝmmǝn yidɗi gi manung akwɔ dǝma yiɗim ɓǝ. <verse eid="JHN 17:23" /><verse number="24" style="v" sid="JHN 17:24" />&lt;&lt;Daa! Ən mǝ a dǝmmǝi, langkwoi Dǝm yiɗi i ǝǝ i Ɓang bǝikwɔ ɓangtthǝ ɓǝ, yangbǝ i ɓyǝa ghaalim, ghaali kwɔ a dǝm ɓǝ; bakwɔ a yiɗim la nungsi nwunni bǝ i mab longwam ɓǝ. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />Daa a langǝ i! Ya longwam iǝ lǝu, kwoi Ən iǝng, ya nanungtom ibǝing angǝ ǝn mǝ a tummǝm. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Ən to a iǝng, langkwoi mǝn lilotthǝ bǝ geitthǝ, yangbǝ bǝ yiɗi bǝikwɔ dǝmma yiɗim lǝ kwɔ a ǝǝ dang tthǝi, langkwoi yangbǝ Ɓang langɓǝ Mǝn ǝǝ tthǝi.&gt;&gt;<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">Bǝ Muo Yeso</para>
  <para style="r">(<ref loc="MAT 26:47-56">Matthew 26:47-56</ref>; <ref loc="MRK 14:43-50">Markus 14:43-50</ref>; <ref loc="LUK 22:47-53">Luka 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Tthasua kwɔ Yeso alo bǝ pinwa kwɔ, u pa i ya nanung to gu i nyang gwam yui dual a kuntthǝ kwɔ dǝnni luu angǝ Kidron ɓǝ. Bǝilǝ kullo nungku kab tthǝ Yeso i ya nanung to gu tǝ ǝǝtthǝ. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />Yahuda, ya ɓanglǝ bǝi, ibǝ bǝiɓǝng, bakwɔ vii ǝndǝi Yeso i ya nanung to gu dǝna kǝbtha bǝilǝ ɓǝ. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />Nungkwɔ Yahuda patǝ nungku ɓǝ, suatha i ya taɓui ya Romawa, i yakun dang ya ki kǝm Fuh kwɔ yikku ya nyǝknung tummǝi i ya Farisiyawa; i wuo i nung taɓui i lua gabǝi toci. <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />Yeso ibǝi nungkwɔ a tǝiu ǝndǝi ɓǝng, nungkwɔ u wuo si wuu ɓib angǝ, &lt;&lt;Ənyiǝ dǝɓa ɗubǝi?&gt;&gt; <verse eid="JHN 18:4" /><verse number="5" style="v" sid="JHN 18:5" />I gwab nwa angǝ. &lt;&lt;Yeso ya Nazarat,&gt;&gt; Yeso gei angǝ.&lt;&lt;Ən Ɓang ɓǝkwɔ.&gt;&gt;</para>
  <para style="p" vid="JHN 18:5">Yahuda, ya ɓanglǝ bǝi, dǝi bǝilǝ i ilǝ. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />Kwɔ Yeso gei angǝ, &lt;&lt;Ən Ɓang ɓǝkwɔ,&gt;&gt; i kwoi tǝi al nǝ mual pangsua. <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />Langkwoi Yeso ɓibǝi akun angǝ, &lt;&lt;Ənyiǝ dǝɓa ɗubǝi?&gt;&gt;</para>
  <para style="q1" vid="JHN 18:7">I gei angǝ.&lt;&lt;Yeso ya Nazarat,&gt;&gt;<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />Yeso gei angǝ. &lt;&lt;Ən osi ǝn gei ɓǝtthǝ geigǝ ǝn Ɓang lǝ Yeso ɓǝ. &lt;&lt;Nǝ dǝ ɓa ɗuubǝi ǝn ɓang, yang ɓa yi sua yakwɔ itǝ abǝi.&gt;&gt; <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />(Yeso gei nungkwɔ yangbǝ nungkwɔ u gei kwɔ ǝǝlǝ ba a langǝ i: &lt;&lt;Daa, yuu a kun lalǝu dang yakwɔ a Dǝm ɓǝ.&gt;&gt;) <verse eid="JHN 18:9" /><verse number="10" style="v" sid="JHN 18:10" />Khafǝi tthǝ, na Saminu Bitrus, u ilǝ u gablǝ ɗuogsui thǝb gi Yikku ya nyǝknung, u ɓǝrr ɗuogsuiu a nali u walǝtǝ. Ɗuǝn thǝb ɓǝ ǝn Malkus. <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />Yeso gei Bitrus angǝ, &lt;&lt; A bai khafǝi mǝ dang thko! Dǝmma nhǝm mangǝ bǝ ǝn tang zuii nunglǝi kwɔ Daam dǝna yiɗi angǝ ǝn tangɓǝ tha?<verse eid="JHN 18:11" /></para>
  <para style="s">Yeso Tthasi Annas</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Yang Yikku taɓui ya Romawa i yikku ya ki kǝm Fuh kwɔ ya Yahudawa muo Yeso, i tthǝbbu, <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />la nwasiu i tǝu lǝ sua Annas. U ǝn gong gi Kayafa a yiɓǝi, kwɔ lǝ Gong ya nyǝknung ttha lǝ kullo ɓǝ. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />Ən Kayafa dǝ ba nwa ya tthǝnyimmi ya Yahudawa angǝ maɗing kwɔ yiɓǝi kun ɓui lǝ ba yayuu ǝndǝi ɓǝ.<verse eid="JHN 18:14" /></para>
  <para style="s">Bitrus Yǝrnwa Tthǝ Yeso</para>
  <para style="r">(Matthew 26:69, 70; <ref loc="MRK 14:66-68">Markus 14:66-68</ref>; <ref loc="LUK 22:55-57">Luka 22:55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Saminu Bitrus i ya nanung to a kun muo sua Yeso. Gong ya nyǝknung ɓǝ i ya nanung to ɓǝng, nungkwɔ u tǝ dang gwoi Gong ya nyǝknung ɓǝ suatha i Yeso, <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />Bitrus abo dǝi gwam ttha nwalǝgwoi. Yang ya nanung to akun ɓǝ igwam, gei ba lǝ munthang a yisi nwa lǝ gwoi lǝ, gei Bitrus wuo ttha dang . <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />Munthang a yisi kwɔ nwalǝgwoi kwɔ gei Bitrus angǝ, &lt;&lt; Gǝlko mǝ dang ya nanung to gi yiɓǝi kullo wai?&gt;&gt;</para>
  <para style="p" vid="JHN 18:17">Bitrus gwab nwa angǝ&lt;&lt;Nilǝu, Ən ɓanglǝu,&gt;&gt;<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />Tǝmmi ɗing, nungkwɔ ya thǝb ɓǝ i ya kinung mab lua i kilua dǝnni ɓuol, Nungkwɔ Bitrus tǝ dǝi bǝilǝ i ilǝ, dǝna ɓuol lua ɓǝ.<verse eid="JHN 18:18" /></para>
  <para style="s">Yikku Ya Nyǝknung Ɓib Balǝ Yeso</para>
  <para style="r">(<ref loc="MAT 26:59-66">Matthew 26:59-66</ref>; <ref loc="MRK 14:55-64">Markus 14:55-64</ref>; <ref loc="LUK 22:66-71">Luka 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />Yikku ya nyǝknung ɓib Yeso ba ya nanungto gu i ba bǝ nanatthǝnung gu. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />Yeso gwab nwa angǝ, &lt;&lt;Vii ǝndǝi Dǝmǝn gei ba nung ya longwam ǝndǝi; dǝmǝn nanatthǝnung kǝm nyǝknung ya Yahudawa i kǝm Fuh, bǝi kwɔ yayuu ǝndǝi dǝna kǝbtha tthǝ ɓǝ. Ən gei nung a kun dang bǝthǝl lǝu bokun. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Yang ǝnɓǝ, bǝ dǝmma ɓibbǝm? A ɓib yakwɔ lǝ nungkwɔ ǝn gei ɓǝ. A ɓibbǝi nungkwɔ ǝn geitthǝ ɓǝ- i ibǝ nungkwɔ ǝn gei ɓǝng.&gt;&gt; <verse eid="JHN 18:21" /><verse number="22" style="v" sid="JHN 18:22" />Kwɔ Yeso gei nungkwɔ, yuu akun dang ya kinung ɓuob ɓua suaiu i na ǝrr gei angǝ, &lt;&lt;Ən ba ɓǝ bǝ ma gei ba ni lǝ gong ya nyǝknung!&gt;&gt; <verse eid="JHN 18:22" /><verse number="23" style="v" sid="JHN 18:23" />Yeso gwabu nwa angǝ, &lt;&lt;Nǝ ǝn gei nung a kun ɓkoɗing yang, ɓa gei nungɓǝlǝ yakwɔ tthǝ bǝikwɔ ǝndǝi ɓǝ. Kwoi nǝ nungkwɔ ǝn gei kwɔ lozuiiu, yang ǝn baɓǝ bǝ a ɓuom?&gt;&gt; <verse eid="JHN 18:23" /><verse number="24" style="v" sid="JHN 18:24" />Yang Annas togǝu, yirrǝ i tthǝbu lǝ tthǝb, sua Kayafa gong ya nyǝknung.<verse eid="JHN 18:24" /></para>
  <para style="s">Bitrus Yǝrnwa Tthǝ Yeso Langkwoi</para>
  <para style="r">(<ref loc="MAT 26:71-75">Matthew 26:71-75</ref>; <ref loc="MRK 14:69-72">Markus 14:69-72</ref>; <ref loc="LUK 22:58-62">Luka 22:58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Saminu Bitrus yirrǝ dǝi bǝilǝ dǝna ɓuol lua. Nungkwɔ yakun geiu angǝ, &lt;&lt;Gǝlko mǝ dang ya nanung to gi yiɓǝi kullo wai?&gt;&gt;</para>
  <para style="p" vid="JHN 18:25">Kwoi Bitrus yǝrnwa tthǝ.&lt;&lt;Nilǝu, Ən ɓanglǝu,&gt;&gt; <verse eid="JHN 18:25" /><verse number="26" style="v" sid="JHN 18:26" />Yuu akun dang ya thǝb gi gong ya nyǝknung, ya gwoi gi yiɓǝi kwɔ Bitrus ɓǝr ɗogsuiu ɓǝ, gei ba angǝ. &lt;&lt;Gǝlko ǝn ɓyǝa i ulǝ dang zuk kablǝ wai?&gt;&gt; <verse eid="JHN 18:26" /><verse number="27" style="v" sid="JHN 18:27" />Langkwoi Bitrus gei angǝ&lt;&lt;Nilǝu&gt;&gt; dang tthǝ niyang gog ta.<verse eid="JHN 18:27" /></para>
  <para style="s">Yeso Tthasi Bilatus</para>
  <para style="r">(Matthew 27:1, 2, 11-14; <ref loc="MRK 15:1-5">Markus 15:1-5</ref>; <ref loc="LUK 23:1-5">Luka 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Nungwoi ɗǝng i palǝ Yeso gwoi Kayafa i tǝlǝ gwoi yikku losua. Ya tthǝnyimmi ya Yahudawa tǝ dang woi ɓǝlǝu, bakwɔ dǝnni yiɗi bǝ to ɓillǝng nai lǝu, yangbǝ i ɓuan i tang nungtang nyang lo. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Nungkwɔ Bilatus igwam tǝ ɓibǝi angǝ, &lt;&lt;Ən ɓǝlǝ nung a ɓko kwɔ yiɓǝi kwɔ to ɓa?&gt;&gt;<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />I gwab nwa angǝ, &lt;&lt;Krǝ yang ɓi wulǝ sua mǝu nǝ u to nung a ɓko lǝu ɓǝ.&gt;&gt; <verse eid="JHN 18:30" /><verse number="31" style="v" sid="JHN 18:31" />Nungkwɔ Bilatus gei angǝ, &lt;&lt;Yang ɓǝ i naɓǝ ɓa tou kwan kwɔ natha i nung zuu ɓǝɓa.&gt;&gt;</para>
  <para style="p" vid="JHN 18:31">Nungzuu gwabɓitthǝ angǝ, &lt;&lt;Ɓi yangǝu i ttha kwɔ ɓi thǝb yuu ɓǝlǝu.&gt;&gt; <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />(Nungkwɔ tonung manungɓǝ yangbǝ ba Yeso ǝǝlǝ ba a langǝ i, bakwɔ u gei kwɔ dǝnnu gei ɓua kwɔ u ɓui ɓǝ.) <verse eid="JHN 18:32" /><verse number="33" style="v" sid="JHN 18:33" />Bilatus kwoi suo tǝ dang gwoi tǝ lubǝ Yeso ɓibbu angǝ. &lt;&lt;Mǝn yigwoi ya Yahudawa?&gt;&gt; <verse eid="JHN 18:33" /><verse number="34" style="v" sid="JHN 18:34" />Yeso gwab nwa angǝ, &lt;&lt;Bakwɔ dǝmma ɓib kwɔ ǝn bǝ nhǝm ba mǝ naa ko yakun geitthǝ lom?&gt;&gt; <verse eid="JHN 18:34" /><verse number="35" style="v" sid="JHN 18:35" />Bilatus gwab nwa angǝ, &lt;&lt;Dǝmma ɓyǝa mangǝ ɓang ǝn ya Yahudawa? Ən yayuu mǝ i yikku ya nyǝknung walǝ wuu dǝm. Ənɓǝ a to?&gt;&gt;<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />Yeso gei angǝ, &lt;&lt;Bǝ lo yigwoim ǝn a longwam kwɔ lǝu; Nǝ bǝ lo yigwoim ǝn a ya longwam kwɔ yang, ya muo suam a ɓuob vǝm a nan ɓǝlǝ bǝ dǝm dang na ya tthǝ nyimmi ya Yahudawa. Nilǝu bǝ lo yigwoim ǝn a bǝ longwam kwɔ lǝu!&gt;&gt;<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />Nungkwɔ Bilatus ɓib Yeso angǝ, &lt;&lt;Yang mǝn yigwoi a?&gt;&gt;</para>
  <para style="p" vid="JHN 18:37">Yeso gwab nwa angǝ, &lt;&lt;A gei mangǝ ɓang ǝn yigwoi. I sim langkwoi ǝn wuo longwam kwɔ lǝ ba ɓǝkwɔ kun, yangbǝ wung gei ba a langǝ i. Yuu akwɔ nǝ ǝnya ba a langǝ i yang lǝm.&gt;&gt; <verse eid="JHN 18:37" /><verse number="38" style="v" sid="JHN 18:38" />Bilatus ɓib angǝ,&lt;&lt;Langkwoi ǝn ɓǝlǝ ba a langǝ i?&gt;&gt;</para>
  <para style="s" vid="JHN 18:38">I To Kwan Ɓualǝ Yeso Tthǝ</para>
  <para style="r" vid="JHN 18:38">(<ref loc="MAT 27:15-31">Matthew 27:15-31</ref>; <ref loc="MRK 15:6-20">Markus 15:6-20</ref>; <ref loc="LUK 23:13-25">Luka 23:13-25</ref>)</para>
  <para style="p" vid="JHN 18:38">Nungkwɔ Bilatus kwoi suo tǝ gwam tǝ gei yayuu angǝ, &lt;&lt;Ən tǝi nung a kun ɓkotthǝ lo yiɓǝi kwɔ mǝn geigǝ u ɓui ɓǝlǝu.<verse eid="JHN 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 18:39" />Kwoi manung kwɔ lǝ nungto ɓǝ, Vii ǝndǝi dǝm yina lǝ ya pursǝnǝ kun lona bǝ nyang lo. Dǝɓa yiɗi ǝn yinatthǝ yigwoi ya Yahudawa?&gt;&gt;<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />I gwab nwa i buogbǝi angǝ, &lt;&lt;Nilǝu, u lǝu! (Barabbas ya nung i.)<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Yang Bilatus gei angǝ i ɓuob Yeso i thab. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />Ya taɓui mab nung muo lo kob i baiutthǝ lo; ǝrr i liu nunglitthǝ a thǝnni tthǝ <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />langkwoi i wuo tthangǝu dǝnni gei angǝ, &lt;&lt;Dǝɓi gum Yigwoi ya Yahudawa!&gt;&gt; Langkwoi yang tǝi ɓuob ɓuasuiu i na. <verse eid="JHN 19:3" /><verse number="4" style="v" sid="JHN 19:4" />Bilatus igwam langkwoi wuu gei kon ɓǝ angǝ, &lt;&lt;Ɓa ɓyǝa, mǝn wuulǝ gwam bǝikwɔ yangbǝ ɓa ibǝi nunglǝi yangǝu kwɔ mǝn muu i bakwɔ mǝn gei kwɔ geigǝ u ɓui ɓǝu.&gt;&gt; <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />Nungkwɔ Yeso i gwam, i nung muo lo kob i nunglitthǝ kwɔ i liutthǝ ɓǝ. Bilatus gei angǝ, &lt;&lt;Ɓa ɓyǝa! Yiɓǝi ɓǝ kwɔ!&gt;&gt;<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />Kwɔ yikku ya nyǝknung i ya ki kǝm Fuh ɓyǝko! I buogbǝi angǝ i piu! I piu!&gt;&gt;</para>
  <para style="p" vid="JHN 19:6">Bilatus gei angǝ, &lt;&lt;Ɓa lǝiu, yang, langkwoi tǝɓa piu. Ən tǝiu i nung aɓau kwɔ mǝn thǝu ɓǝlǝu.&gt;&gt;<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />Kon yayuu ɓǝ gwabu nwa angǝ, &lt;&lt;Ɓitthǝ i nung zuu lo bǝ dal Fuh ɓǝ, bakwɔ dǝnnu lǝi angǝ i ǝn Yui Fuh ɓǝ.&gt;&gt;<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />Kwɔ Bilatus lǝ bakwɔ, tthǝu surr vulli ghaatthǝ. <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />U kwoi u tǝ dang gwoi tǝu ɓib Yeso angǝ, &lt;&lt;Mǝn ya losua a nwaa?&gt;&gt;</para>
  <para style="p" vid="JHN 19:9">Kwoi Yeso gwab nwa lǝu. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />Bilatus geiu angǝ, &lt;&lt;A geim ba waa? A nhǝm, ɓangtthǝ i ttha kwɔ mǝn yana langkwoi mǝn gei i piǝ ɓǝ.&gt;&gt;<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />Yeso gwab nwa angǝ, &lt;&lt;Mǝtthǝ i ttha lom lǝ bakwɔ ǝn Fuh da ɓǝ. Yuu akwɔ dǝm dang namǝ kwɔ nung a ɓko gu ɓkoɗing.&gt;&gt;<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />Kwɔ Bilatus lǝ nungkwɔni, dǝnnu ɗulǝi yangbǝ u yina lǝ Yeso. Kwoi kon ɓǝ ǝǝnwa bǝ buogbǝi, &lt;&lt;Nǝ a yiuna yang, mǝn ǝnthǝ yigwoi Kaisar lǝu! Yuu akwɔ nǝ gei angǝ i ǝn yigwoi i ttha gu yang dǝnnu tthǝng yigwoi Kaisar!&gt;&gt;<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />Kwɔ Bilatus lǝ nungkwɔni, u tǝlǝ Yeso lǝ gwam tǝu ǝǝ sua lo nung ǝǝ to kwan gu bǝi kwɔ dǝnni lu angǝ&gt;&gt;. (Nwa ya Yahudawa ɗuǝn ɓǝng &lt;&lt;Gabbata&gt;&gt;.) <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />Lona lǝ kwɔ fuh gbag nyilong vii kwɔ ibǝi kan yang ǝn ɓang bǝ nyang lo ɓǝ. Bilatus gei yayuu angǝ, &lt;&lt;Yigwoi ɓǝkwɔ!&gt;&gt;<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />I buogbǝi angǝ, &lt;&lt;Thǝu! Thǝu! Piu lo kab gangǝ i!&gt;&gt;</para>
  <para style="p" vid="JHN 19:15">Bilatus ɓibǝi angǝ, &lt;&lt;Dǝɓa yiɗi ɓangǝ ǝn pi yigwoi ɓa?&gt;&gt;</para>
  <para style="p" vid="JHN 19:15">Yikku ya nyǝknung gwab nwa angǝ, &lt;&lt;Yigwoi ɓi kun ɓuo lǝ Kaisar!&gt;&gt;<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />Yang Bilatus ǝrr kwoilǝ Yeso ji yangbǝ i piu.</para>
  <para style="s" vid="JHN 19:16">I pi Yeso</para>
  <para style="r" vid="JHN 19:16">(<ref loc="MAT 27:32-44">Matthew 27:32-44</ref>; <ref loc="MRK 15:21-32">Markus 15:21-32</ref>; <ref loc="LUK 23:26-43">Luka 23:26-43</ref>)</para>
  <para style="p" vid="JHN 19:16">Nungkwɔ ya taɓui lǝi Yeso palǝ.<verse eid="JHN 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />U igwam u lǝi kab gangǝ i gu u tǝlǝ bǝikwɔ dǝnni lu angǝ&lt;&lt;Bǝi gungonglo&gt;&gt;, manungkwɔ dǝnni lu . (I nwa Yahudawa angǝ Golgota ɓǝ&gt;&gt;.) <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />Bǝilǝ kullo nungkwɔ i piutthǝ; langwoi yaɓǝi tthǝ rab i piǝ, Yeso nungdang ǝ i. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />Bilatus vullǝ nung i pi lo kab gangǝ i gu angǝ. &lt;&lt;Yeso ya Nazarat, Yigwoi ya Yahudawa&gt;&gt;. <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />Yayuu kpaatthǝ kwɔ than ɓǝ, bǝi kwɔ i pi Yeso tthǝ kwɔ tutha i gwoi angǝ ko. I vullǝ i nwa ya Yahudawa, Romawa i Helinawa. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />Yakku ya nyǝknung gei Bilatus angǝ, &lt;&lt;Bǝ a vullǝ mangǝ &lt;Yigwoi ya Yahudawa thǝ&gt;, kwoi manungkwɔni, &lt;Yiɓǝi kwɔ gei angǝ, Ɓanglǝ Yigwoi ya Yahudawa ɓǝ.&gt; &gt;&gt;<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />Bilatus gwab nwa angǝ, &lt;&lt;Nungkwɔ ǝn vullǝ kwɔ dǝing manungɓǝ.&gt;&gt;<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />Tthasua kwɔ ya taɓui pi Yeso, i lǝi nunglitthǝ gu i gab dang ǝu nai, i gab lǝtha. Langkwoi i lǝi nunglitthǝ gu a gwam, aɓǝ kwɔ i finfyǝ lǝu i ttha nungkun. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />Ya taɓui ɓǝ gei lǝ thatthǝ angǝ, &lt;&lt;Bǝɓi trǝthǝ; ɓi bai ǝnchǝl yangbǝ ɓi ɓyǝa yuu akwɔ a tǝi ɓǝ.&gt;&gt; Nungkwɔ totthǝ yangbǝ ǝǝlǝ bǝ yinwa ba kwɔ angǝ:</para>
  <para style="q1" vid="JHN 19:24">&lt;&lt;I gab nunglitthǝm ganglangǝ i</para>
  <para style="q2" vid="JHN 19:24">langkwoi i bai ǝnchǝl lo nunglitthǝ a gwammǝm.&gt;&gt;</para>
  <para style="q2" vid="JHN 19:24">Langkwoi ǝn u nungɓǝ kwɔ ya taɓui kwɔ toɓǝ.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />Yakwɔ dǝi gbag bǝi kwɔ kab gangǝ i kwɔ i pi Yeso tthǝ kwɔ ǝn naa gu, young gi naa gu a yisi, Maryamu si Kilofas, i Maryamu Magadaliya. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />Yeso ɓyǝa naa gu i ya nanung to kwɔ dǝnnu yiɗi ɓǝ i dǝi bǝilǝ; nungkwɔ u gei naa gu angǝ, &lt;&lt; U ǝn yui mǝ.&gt;&gt;<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />Ərr Yeso gei lǝ ya nanung to ɓǝ angǝ, &lt;&lt;U ǝn naamǝ.&gt;&gt; Baipiu lona lǝ kullo ya nanung to ɓǝ lǝiu tǝu ǝǝ gwoi gu.<verse eid="JHN 19:27" /></para>
  <para style="s">Ɓua Gi Yeso</para>
  <para style="r">(<ref loc="MAT 27:45-56">Matthew 27:45-56</ref>; <ref loc="MRK 15:33-41">Markus 15:33-41</ref>; <ref loc="LUK 23:44-49">Luka 23:44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Yeso ibǝing lakwɔ nikwɔ nung ǝndǝi al loǝng; yangbǝ nungkwɔ i vullǝ kwɔ natthǝ, u gei angǝ, &lt;&lt;Ɗimung dǝna tǝim.&gt;&gt;<verse eid="JHN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29" />Bko mung a ǝmmi tthǝ bǝilǝ, mung a ǝmmi yitthǝ; nungkwɔ i bai soso dang ǝu, i bai nwa kab izob, i baiutthǝ nwuo. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />Yeso bang mung a ǝmmi ɓǝ ǝrr gei angǝ,</para>
  <para style="p" vid="JHN 19:30">&lt;&lt;Tthǝmmǝng!&gt;&gt;. Ərr u bailo sua u yinatthǝ ɓyangǝu.<verse eid="JHN 19:30" /></para>
  <para style="s">Bǝ Bai Nwangwu Yeso</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Yang ya tthǝnyimmi ya Yahudawa wuu ɓib Bilatus yangbǝ u gwabǝitthǝ i ab kabo yakwɔ i pi ɓǝ, langkwoi yangbǝ i pinlǝ kwamɓui lo kab gangǝ ilǝ lǝ pangsua. I ɓib nungkwɔ bakwɔ vii ɓǝ ǝn vii mapzuii nung, langkwoi i yidɗi bǝ yitthǝ kwamɓui yayuu ɓǝ dǝilo kab gangǝ i lǝ vii nwongǝi lǝu ɓǝ. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Nungkwɔ ya ta ɓuiɓǝ tǝ ab kabo yiɓǝi a nungsi ɓǝ langkwoi yang a bǝ yuu akun ɓǝ kwɔ i pii i Yeso ɓǝ. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Kwoi kwɔ i wuo sua Yeso, wui tǝiu u ɓuing, nungkwɔ i ab kabo lǝu. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />Yuu akun dang ya taɓui ɓǝ, bai nwagwu Yeso i kaɓui, nwakun zii i mungki al lǝtǝ. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />(Yuu akwɔ ɓyǝa nungkwɔ tonungkwɔ gei ba nungɓǝng, yangbǝ ɓǝ langɓǝ ɓa dǝ ba a langǝ itthǝ. Nungkwɔ u gei kwɔ ǝn ba a langǝ i, langkwoi u ibǝi u gei ǝn ba a langǝ i.) <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Nungkwɔ totthǝ yangbǝ ǝǝlǝ bǝ yinwa ba nungkwɔ i vullǝ ɓǝ: &lt;&lt;Kubbu yangǝu kun a abu.&gt;&gt; <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />Langkwoi nung vullǝ gi Fuh akuntthǝ gei angǝ, &lt;&lt;Yayuu a ɓyǝko kwɔ i baiu i kaɓui ɓǝ.&gt;&gt;<verse eid="JHN 19:37" /></para>
  <para style="s">Bǝ Suu Yeso</para>
  <para style="r">(<ref loc="MAT 27:57-61">Matthew 27:57-61</ref>; <ref loc="MRK 15:42-47">Markus 15:42-47</ref>; <ref loc="LUK 23:50-56">Luka 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Tthasua nungkwɔ, Yusufu, kwɔ u ǝn ya gwoi angǝ a kwɔ angǝ Arimatiya kwɔ, u ɗyǝab Bilatus angǝ i ɓuan i lǝi kwamɓui Yeso ǝnlǝi. (Yusufu ǝn ya muo sua Yeso, kwoi lǝn bǝ pyǝa, bakwɔ dǝnnu sur ya tthǝnyimmi ya Yahudawa) Bilatus geiu angǝ tǝu lǝi, nungkwɔ Yusufu tǝ lǝi kwamɓui Yeso palǝ. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />Nikodimu, yuu akwɔ la nwasiu kwɔ tǝ bǝ ɓyǝa Yeso nungvii kwɔ, tǝ suatha i Yusufu, i lǝi turare Mur i al'ul kwɔ i langlǝ tha ɓuoniu kǝn tthǝm tai pǝmna sob iu nu. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Yayuu ɓǝkwɔ rab kwɔ i lǝi kwamɓui Yeso i kuluam dang nung suu yuu i turare manungkwɔ ya Yahudawa dǝna mablǝ kwamɓui yuu yangbǝ i suu ɓǝ. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />Zuk tthǝ bǝikwɔ i thǝb Yeso tthǝɓǝ, langkwoi dang ǝulǝ ɓua juǝn akuntthǝ kwɔ i suu yuu tthǝlǝu bokun ɓǝ. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Bakwɔ vii kwɔ i piu tthǝkwɔ ibǝikan yang ǝn vii nwongǝi langkwoi juǝn ɓǝ gbag gwoi ɓǝ, i suu kwamɓui Yeso bǝilǝ.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">Ɓua Juǝn Lo Nǝkwam</para>
  <para style="r">(<ref loc="MAT 28:1-8">Matthew 28:1-8</ref>; <ref loc="MRK 16:1-8">Markus 16:1-8</ref>; <ref loc="LUK 24:1-12">Luka 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Nungwoi ɗǝng vii a nwasiu a mako, kwɔ yirrǝ bǝi baithǝl tthǝ, Maryamu Magadaliya tǝ lo juǝn tǝ tǝi i klǝng tal ɓǝ nwaɓua lǝ i kwoilǝng. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />Nungkwɔ u kwoi suo i dum wuu tǝi Saminu Bitrus i sua ya nanung to gu kwɔ Yeso dǝna yiɗi ɓǝ angǝ, &lt;&lt;I lǝi Dangbang ɓua juǝn lǝng, ɓi ibǝi bǝi kwɔ i tǝulǝ tthǝ ɓǝ lǝu!&gt;&gt;<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />Nungkwɔ Bitrus i yuu akun dang ya nanung to gu olǝi nwa ɓua juǝn ɓǝ. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />I ǝndǝi dǝnni surdum, kwoi yuu akun dang ya nanung to gu ɓǝ surdum pa yiǝ Bitrus tǝ nwa ɓua ɓǝ nungsi. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />U tǝmsua u ɓuu u ɓyǝa landǝ linin lo dang ɓualǝ kwoi u tǝtthǝ lǝu. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Yang Saminu Bitrus, kwɔ wuu nǝsuko kwɔ, wuu tǝ dang ɓua ɓǝ. U ɓyǝa landǝ linin ɓǝ lo bǝi lǝ, <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />i landa suu bǝi kwɔ i kuluam lo Yeso ɓǝ. Landǝ kuluam lo gwu kun, yangǝu tthǝ linin lǝu. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Nǝsua nwuni ya nanung to a kun ɓǝ, yuu akwɔ osi tǝ nwa ɓua juǝn ɓǝ, langɓǝ tǝ dang juǝn ɓǝ. U ɓyǝa u dǝ ba a langǝ itthǝ. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />(I nunglǝ kwɔ ǝndǝi yirrǝ i ibǝi nungkwɔ dang nungvullǝ ba gi Fuh kwɔ angǝ Yeso a ǝrr i nwongǝi ɓǝlǝu.)<verse eid="JHN 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 20:10" />Yang ya nanung to ɓǝ kwoi suai tǝgwoi.<verse eid="JHN 20:10" /></para>
  <para style="s">Yeso Fugtthǝ Maryamu Magadaliya</para>
  <para style="r">(<ref loc="MAT 28:9">Matthew 28:9</ref>,<ref loc="MAT 28:10">10</ref>; <ref loc="MRK 16:9-11">Markus 16:9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />Kwoi Maryamu dǝi lo juǝn lǝ dǝna tasui. Kwɔ yirrǝ dǝnnu tasui, u tǝmsua yangbǝ u ɓyǝa dang ɓua juǝn ɓǝ <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />u ɓyǝa ya nwatummi gi Fuh rab i li nunglitthǝ la vǝrǝm, ǝǝ bǝikwɔ i dǝ kwamɓui Yeso tthǝɓǝ, yuu a kun ttha bǝikwɔ lo tthǝɓǝ yuu akun ttha bǝikwɔ bo tthǝɓǝ.<verse eid="JHN 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 20:13" />I ɓibbu angǝ, &lt;&lt;Yisi, ǝn baɓǝ bǝ dǝmma tasui?&gt;&gt;</para>
  <para style="p" vid="JHN 20:13">Yisi ɓǝ gei angǝ, &lt;&lt;I lǝi Dangbangǝm i pallǝng, langkwoi ǝn ibǝi bǝikwɔ i dutthǝ ɓǝlǝu!&gt;&gt; <verse eid="JHN 20:13" /><verse number="14" style="v" sid="JHN 20:14" />Yang u mǝrǝm ni yang u ɓyǝa Yeso dǝi bǝilǝ.<verse eid="JHN 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 20:15" />Kwoi Yeso ɓibbu angǝ, &lt;&lt;Yisi, ǝn yiǝ dǝmma ɗubǝi? &gt;&gt;</para>
  <para style="p" vid="JHN 20:15">Dǝnnu ɓyǝa angǝ lko ǝnya tonungto dang zuk lambu, u gei angǝ, &lt;&lt;Yikku, nǝ a lǝiu a pallǝng yang, a geim bǝikwɔ a duu tthǝɓǝ, yangbǝ tǝn lǝiu.&gt;&gt;<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />Yeso geiu angǝ, &lt;&lt;Maryamu!&gt;&gt;</para>
  <para style="p" vid="JHN 20:16">U mǝrǝm nungǝu ttha tthangǝu u gei i nwa ya Yahudawa angǝ, &lt;&lt;Rabboni!&gt;&gt; (Nungɓǝlǝ &lt;&lt;Ya nanatthǝ nung&gt;&gt;.) <verse eid="JHN 20:16" /><verse number="17" style="v" sid="JHN 20:17" />Yeso gei angǝ, &lt;&lt;Bǝ a kǝn natthǝm thǝ, bakwɔ yirrǝ ǝn tǝsua Daa lǝu. Kwoi a tǝ sua ya youngǝm a gei tthǝ mangǝ dǝm kwoi suam mǝn tǝ sua yuu akwɔ lǝ Daam langkwoi Daa gi, Fuhm langkwoi Fuh gi ɓǝ.&gt;&gt;<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />Maryamu Magadaliya tǝ tǝgeilǝ ya nanung to tthǝ angǝ i ɓyǝa Dangbang nungkwɔ u gei nungkwɔ Yeso ghko tthǝɓǝ.<verse eid="JHN 20:18" /></para>
  <para style="s">Yeso Fugtthǝ Ya Nanung to Gu</para>
  <para style="r">(<ref loc="MAT 28:16-20">Matthew 28:16-20</ref>; <ref loc="MRK 16:14-18">Markus 16:14-18</ref>; <ref loc="LUK 24:36-49">Luka 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Nungluii vii a nwasiu dang mako, ya nanung to gǝmtha bǝi kun i lam nwa kǝm lǝ lam, bakwɔ dǝnni sur yakku ya Yahudawa ɓǝ. Yang Yeso wuo wuu dǝi ganglangǝ i angǝ, &lt;&lt;Tthǝ tǝmmi i ɓǝlǝ.&gt;&gt; <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />Tthasua kwɔ u gei nungkwɔ, u tainatthǝ nko i nwangwu. Tthǝ ya nanung to ɓǝ la ǝndǝi ba bǝ ɓyǝa Dangbang. <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />Yeso gei langkwoi angǝ, &lt;&lt;Tthǝ tǝmmi i ɓǝlǝ. Manungkwɔ Daa tummǝm, langɓǝ dǝm tumɓǝ.&gt;&gt; <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />Nungkwɔ u pyǝb nwongǝi tthǝilǝ angǝ, &lt;&lt;Ɓa muo Ɓyang a Langǝ i. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />Nǝ ɓa al nung a ɓko yayuu lǝtǝ, yang Fuh al nung a ɓko ɓǝ gi lǝtǝng; Nǝ ɓa al nung a ɓko gilǝtǝ lǝu, yang Fuh al nung a ɓko gilǝtǝ lǝu.&gt;&gt;<verse eid="JHN 20:23" /></para>
  <para style="s">Yeso I Toma</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />Yuu akun dang ya nanung to sob iu rab kwɔ, Toma (kwɔ dǝnni lu angǝ Yui thǝn kwɔ), yangǝu i ilǝu kwɔ Yeso wuo ɓǝ. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />Nungkwɔ sua ya nanung to ɓǝ geiu tthǝ angǝ, &lt;&lt;Ɓi ɓyǝa Dangbang!&gt;&gt;</para>
  <para style="p" vid="JHN 20:25">Toma gei angǝ, Nǝ ǝn ɓyǝa gilǝng nunglua kusǝ nko lǝ yang ǝn bai nwanzǝnam tthǝ langkwoi nwangwu lǝu, Ən dǝ ba a langǝ i tthǝu.&gt;&gt;<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />Tthasua mako kun ya nanung to gǝmtha langkwoi nwa kǝm lamlǝ lam, Toma i ilǝ. Nwakǝm kubli lǝ kubli, kwoi Yeso wuo wuu dǝi dang ǝi gei angǝ, &lt;&lt;Tthǝ tǝmmi i ɓǝlǝ.&gt;&gt; <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />Yang u gei toma angǝ, &lt;&lt;Abai nwanzǝna mǝ bǝi kwɔ, langkwoi a ɓyǝa nam; yang a juan namǝ a bai nwangwum. A yitthǝ lo nyi rab kwɔ dǝmma toɓǝ, a dǝ ba a langǝ itthǝ!&gt;&gt;<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />Toma gwab nwa angǝ, &lt;&lt;Dangbangǝm i Fuhm!&gt;&gt;<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />Yeso geiu angǝ, &lt;&lt;A dǝ ba a langǝ i tthǝng bakwɔ a ɓyǝam ɓa? Bǝ khana lo yakwɔ ɓyǝam lǝu dǝ ba a langǝ i tthǝɓǝ!&gt;&gt;<verse eid="JHN 20:29" /></para>
  <para style="s">Nungkwɔ Nungvullǝ Lǝ Bkoɓǝ</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Dang nung ya nanung to gu Yeso to i nungfǝmlo a kun kpaatthǝ kwɔ i vullǝ dang nung vullǝ kwɔ ɓǝ lǝu. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Kwoi i vullǝ yakwɔ yangbǝ ɓa dǝ ba a langǝ i tthǝ ɓangǝ Yeso lǝ Kristi, Yui Fuh, langkwoi tthǝ bǝ dǝ nyiɓǝ tthǝulǝ ɓa tǝi nwongǝi a ɗing.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">Yeso Fugtthǝ Ya Nanungto Gu Nanaira</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Tthasua nungkwɔ, Yeso langkwoi fugtthǝ ya nanung to gu nwa mung Tibariya. To nung manungkwɔ ni. <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Saminu Bitrus, Toma (kwɔ dǝnni luu angǝ yui thǝn ɓǝ), i nata'ala ya losua kan'ana galili, yathang Zabadi, i yakun rab dang ya nanung to gi Yeso i suatha ǝndǝi. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />Saminu Bitrus gei sua yakwɔ angǝ, &lt;&lt;Mǝn tǝbǝ muo tthǝng.&gt;&gt;</para>
  <para style="p" vid="JHN 21:3">I geiu angǝ, &lt;&lt;Ɓitǝ i mǝ,&gt;&gt;Nungkwɔ i pa dang kwai lǝ, nungvii lǝ kullo i muo nung akun lǝu. <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />Kwɔ fuh dǝna ɗab, Yeso dǝi nwa mung, kwoi ya nanung to gu ibǝi ǝn u ɓǝlǝu. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />Yang Yeso ɓibbǝi angǝ, &lt;&lt;Ya baittha, ɓa muo tthǝng lǝu?.</para>
  <para style="p" vid="JHN 21:5">I gwab nwa angǝ, &lt;&lt;Yangǝu ɓi muo nunglǝu,&gt;&gt;<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />Yeso gei angǝ, &lt;&lt;Ɓa al kalli ɓǝ lo nali kwai, yang ɓa muo tthǝng.&gt;&gt;Nungkwɔ i al kalli ɓǝ i ɓuan i gub i tǝlǝ dang kwai lǝu, bakwɔ i muo tthǝng kpaani ɓǝ. <verse eid="JHN 21:6" /><verse number="7" style="v" sid="JHN 21:7" />Ya nanung to kwɔ Yeso yiɗi ni kwɔ gei Saminu Bitrus angǝ, &lt;&lt; Ən Dangbang! Kwɔ Saminu Bitrus lǝ ni angǝ ǝn Dangbang, u kuluam nunglitthǝ gu a gwam tthǝulǝ (bakwɔ u ilǝ nunglitthǝ a gwammǝng ɓǝ) u zuǝ dang mung. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />Sua ya nanung to wuo nwangwam dang kwai lǝ, dǝnni gub tthǝng kwɔ yi kalli kwɔɓǝ. I tutha i nwangwamu, bo nu ɓuo. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />Kwɔ i pin nwangwam lǝ, i ɓyǝa kilua i tthǝng lǝ lo i burodi. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />Yang Yeso gei angǝ, &lt;&lt;Ɓa wulǝ tthǝng dang akwɔ ɓa muo kwɔ ɓǝ.&gt;&gt; <verse eid="JHN 21:10" /><verse number="11" style="v" sid="JHN 21:11" />Saminu Bitrus tǝ dang kwai tǝ gub kalli ɓǝ ɗab lǝ gwam gong tthǝng yitthǝ, tthǝng 153 ǝndǝi; i tthǝng lǝ kwɔ kpaatthǝ kwɔ, kali ɓǝ tǝrrǝ lǝu. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />Yeso gei angǝ, &lt;&lt;Wuɓa tang.&gt;&gt;Yuu akun yangǝu dang ya nanung to ɓǝ nyimnyi ɓibbu angǝ, &lt;&lt;Mǝn ya lǝu?&gt;&gt;Bakwɔ i ibǝi ǝn Dangbang ɓǝ. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />Nungkwɔ Yeso patǝ, lǝi burodi ɓǝ, u ji; u to manungɓǝ i tthǝng lǝ langɓǝ.<verse eid="JHN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14" />Nungkwɔ, yang, lǝ a nungtai tthǝu kwɔ Yeso fuklǝ ya nanung to tthǝ tthasua kwɔ i ǝrrǝulǝ i nwongǝi ɓǝ.<verse eid="JHN 21:14" /></para>
  <para style="s">Yeso I Bitrus</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Tthasua kwɔ i tangnung ǝndǝi, Yeso gei Saminu Bitrus angǝ, &lt;&lt;Saminu yui Yohanna, dǝmma yiɗim pǝl a bǝ yakwa?</para>
  <para style="p" vid="JHN 21:15">Bitrus gei angǝ,&lt;&lt;Ni, Dangbang, a ibǝing dǝmmǝn yiɗiǝ.&gt;&gt;</para>
  <para style="p" vid="JHN 21:15">Yeso geiu angǝ, &lt;&lt;A gagci i yathang ɓangamǝm.&gt;&gt; <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />A nung rab tthǝu Yeso geiu angǝ, &lt;&lt;Saminu yui Yohanna, dǝmma yiɗim ma?&gt;&gt;</para>
  <para style="p" vid="JHN 21:16">U gwab nwa angǝ,&lt;&lt;Ni Dangbang, a ibǝing dǝm yidɗiǝ.&gt;&gt;</para>
  <para style="p" vid="JHN 21:16">Yeso geiu angǝ, &lt;&lt;A dǝ nungtthǝ i ɓangamǝm.&gt;&gt; <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />A nungtai tthǝu Yeso gei angǝ, &lt;&lt;Saminu yui Yohanna, dǝma yiɗim ma?&gt;&gt;</para>
  <para style="p" vid="JHN 21:17">Bitrus ɓanglǝ dang wa ghaatthǝ bakwɔ Yeso ɓibbu a nungtai ɓǝ angǝ, &lt;&lt;Dǝma yiɗim ma?&gt;&gt; Nungkwɔ u geiu angǝ, &lt;&lt;Dangbang a ibǝ nung ǝndǝing; a ibǝing dǝm yiɗiǝ!&gt;&gt;Yeso geiu angǝ, &lt;&lt;A gagci i ɓangamǝm. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Dǝm geiɓǝ ba a langǝ itthǝ: kwɔ mǝlǝ baittha, dǝmma li nunglitthǝ yang a olǝi bǝikwɔ dǝmma yiɗi bǝ tǝu ǝndǝi ɓǝ; kwoi na kuu, ma juan namǝ yang yuu akun a mua a tǝllǝ bǝikwɔ a yidɗi bǝ tǝu lǝu ɓǝ.&gt;&gt; <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />(Dang bǝ gei nungkwɔ, Yeso dǝna gei iri ɓua kwɔ Bitrus a ɓui kwɔ a wulǝ ghaali lǝ ɗuǝn Fuh tthǝ ɓǝ.) Yang Yeso geiu angǝ, &lt;&lt;A muo suam!&gt;&gt;<verse eid="JHN 21:19" /></para>
  <para style="s">Yeso I Ya Nanungto Kwɔ Dǝu Yidɗi Ni Ɓǝ</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />Bitrus mǝrrǝm suko yang ɓyǝa ya nanung to, kwɔ Yeso dǝna yiɗi ni ɓǝ- yuu akwɔ ɓuob lo tthǝ Yeso ɓib angǝ, &lt;&lt;Dangbang, ǝn yiǝ a ɓangǝla?&gt;&gt; <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />Kwɔ Bitrus ɓyǝko ni, u ɓib Yeso angǝ, &lt;&lt;Dangbang, nǝnǝ ba yiɓǝi kwɔ?&gt;&gt;<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />Yeso gwabbu nwa angǝ, &lt;&lt;Nǝ ǝn yiɗi geigǝ u ǝǝ i nwongǝi nǝ ǝn wuo ɗǝ, yang ǝn ɓǝttǝn tthǝɓa? Mua suam!&gt;&gt;<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />Nungkwɔ nwa ba lǝi lǝ bǝi dang ya muo sua Yeso angǝ ya nanung to kwɔ ɓuiu. Kwoi Yeso gei angǝ u ɓuiu kwɔ u gei lǝu; u gei angǝ, &lt;&lt;Nǝ dǝm yiɗi geigǝ u ǝǝ i nwongǝi nǝ ǝn wuo ɗǝ, yang ǝn ɓǝttǝn tthǝɓa?&gt;&gt;<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />U lǝ ya nanung to kwɔ gei ba nungkwɔ ɓǝ, uɓǝ kwɔ langkwoi i vullǝ nungkwɔ; langkwoi ɓi ibǝi nungkwɔ u vullǝ kwɔ ǝn ba a langǝ i.<verse eid="JHN 21:24" /></para>
  <para style="s">Bǝ alo</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Lakwɔ, nung a kun kpaaɗing kwɔ Yeso toɓǝ. Nǝ i vullǝ ǝndǝi kunkun, dǝm ɓyǝa longwam ǝndǝi lǝi nung vullǝ ɓǝ kwɔ i vullǝ ɓǝu.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>