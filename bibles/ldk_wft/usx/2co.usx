<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CO" style="id">KOR 2- MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">2 Korantiyawa</para>
  <para style="toc1">Nungvullǝ Gi Bulus A Rabbu Sua Ya KORANTIYAWA</para>
  <para style="toc2">2 Korantiyawa</para>
  <para style="toc3">Ko 2</para>
  <para style="mt2">Nungvullǝ Gi Bulus A Rabbu Sua Ya</para>
  <para style="mt1">KORANTIYAWA</para>
  <para style="imt">Bǝ Gabnung</para>
  <para style="ip">
    <char style="bk">Nungvullǝ Gi Bulus A Nung rabbu Sua Ya Korantiyawa</char> I vullǝ lona lǝ kullo i dang bǝ to zuii lǝ i bǝ to bǝpi ganglang gu i ya kǝm pinwa dang Koranti lǝ. Ya kun dang ya kǝm pinwa ɓǝlǝ gei ba nyimtthǝ lo Bulus angǝ i muu, nungkwɔ u ilǝ ba lo inko lǝ nyimtthǝ angǝ u mab ganglang gi i ilǝ nyimtthǝ i tthǝla lǝ nung ɓǝ wullǝ nungkwɔ ǝndǝi.</para>
  <para style="ip">Dang nungvullǝ gi Bulus a nungsi u gei ba lo ganglang gu i ilǝ i ya pinwa kǝm Fuh dang Koranti,u gei nungkwɔ to u gei ba nyimtthǝ i ɗyǝam i bǝ gab lo kǝm pinwa langkwoi dǝnnu gei tthǝla gu angǝ nyi kwɔ wulǝ bǝ ǝǝnwa ɓko ba i bǝ mab ganglangǝ i. Yang u gei ya kǝm pinwa angǝ i dǝ nung dang wa kun yangbǝ i nwong lǝ ya Krista kwɔ nung yangǝu nai ɓǝ.</para>
  <chapter number="1" style="c" sid="2CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1" />Bulus, ya nwatummi gi Kristi Yeso i bǝ yiɗi gi Fuh, langkwoi tthǝ ǝnthǝ ɓi Timitawos</para>
  <para style="p" vid="2CO 1:1">Sua ya kǝm pinwa gi Fuh ya Koranti, langkwoi sua yayuu gi Fuh ǝndǝi kwɔ dang Akaya ɓǝ.<verse eid="2CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 1:2" />Kaso Fuh Daa ɓi i Dangbang Yeso Kristi dǝɓǝ nung a langǝ i i nyi tǝmmi gi Fuh.<verse eid="2CO 1:2" /></para>
  <para style="s">Bulus Kha Fuh</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3" />Dǝisua ɓi kha Fuh langkwoi Daa gi Dangbang Yeso Kristi ɓi, Daa ya ɓyǝa nungzuii, Fuh ya nwongbǝi! <verse eid="2CO 1:3" /><verse number="4" style="v" sid="2CO 1:4" />Dǝu nwong ɓi dang zuii ɓi ǝndǝi, yangbǝ ɓi ɓuan ɓi nwong yakun dang zuii kwɔ ǝndǝi, ɓi to nung to iri bǝ nwongbǝi kwɔ ɓi i naɓi ɓi muo na Fuh ɓǝ,<verse eid="2CO 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 1:5" />Manungkwɔ ɓi tǝi nwathan ɓi dang Kristi kwɔ kpaatthǝ ɓǝ, manungɓǝ langɓǝ tthǝ Kristi ɓi tǝi nwathan ɓi dang bǝ nwong bǝi gi Fuh kwɔ ghaatthǝ ɓǝ.<verse eid="2CO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 1:6" />Nǝɓi to zuii, ǝn ba bǝ nwongbǝi ɓǝ i bǝ soblo ɓǝ bǝ tonung aɓau, nǝ i nwong ɓi, yang ɓǝ langɓǝ i nwong ɓǝ langkwoi ttha bǝ tthǝb nyitthǝ zuii kwɔ langɓǝ ɓi lǝi i lonyi ɓǝ. <verse eid="2CO 1:6" /><verse number="7" style="v" sid="2CO 1:7" />Manungkwɔ ni yang bǝ dǝnyitthǝ ɓi tthǝ ɓǝ lǝ thǝuri lǝu; ɓi ibǝing ɓingǝ manungkwɔ ɓa tǝi nwathan ɓǝ dang zuii ɓi, ɓǝ langɓǝ ɓa tǝi nwathan ɓǝ dang bǝ nwongbǝi kwɔ ɓi muo ɓǝ.<verse eid="2CO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8" />Ya young ɓi ya dǝ ba a langǝ i tthǝ Kristi, dǝɓi yiɗi bǝ oɓǝ nyitthǝ, i zuii kwɔ ɓi tang losua Asiya lǝ ɓǝ. Nunglǝi kwɔ dǝi loɓi kwɔ ghaatthǝ langkwoi ɓuonɗing kwɔ langkwoi ɓi yǝrnwa bǝ dǝnyitthǝ ɓingǝ ɓi ǝǝ i nwongǝiu.<verse eid="2CO 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CO 1:9" />Dǝɓi lǝ mangǝ ɓi ɓui ɓua. Kwoi nungkwɔ to nung yangbǝ bǝɓi dǝi loɓi i na ɓi thǝ, ǝn loɓi ina ɓi lǝu, kwoi tthǝn lo Fuh ɓuo, yuu kwɔ dǝna ǝrr lǝ kwamɓui yuu ɓǝ. <verse eid="2CO 1:9" /><verse number="10" style="v" sid="2CO 1:10" />U iɓilǝ dang bǝ ɓui ɓua ghaatthǝ u nwong ɓi, langkwoi u nwong ɓi; langkwoi ɓi dǝ nyi ɓi tthǝu ɓingǝ ǝn u uɓi, <verse eid="2CO 1:10" /><verse number="11" style="v" sid="2CO 1:11" />kwɔ ɓa nwong ɓi i bǝ pi ɓi nwa tthǝ kwɔ ɓǝ. Nungkwɔ a ǝǝlǝ bǝ pinwa kpaatthǝ lǝ baɓi Fuh a gun gwab, langkwoi Fuh a khana lo ɓi; langkwoi yayuu kpaatthǝ a ǝrrlǝ yollǝi a dǝ angǝ a lǝ Fuh.<verse eid="2CO 1:11" /></para>
  <para style="s">Bulus Mǝrǝm Nungkwɔ U Mab Zuii Bǝ Touɓǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12" />Dǝɓi lǝi loɓi ɓingǝ lo nyi ɓi gei ɓitthǝ angǝ ǝn nwongǝi ɓi longwam kwɔ, langkwoi i ba bǝ kǝbtha loɓi i ɓǝ, ǝn bǝ gwab nwa ba gi Fuh la langǝi, i ttha gi Fuh nung a langǝi gu langkwoi ǝn yiggǝi yuu lǝu. <verse eid="2CO 1:12" /><verse number="13" style="v" sid="2CO 1:13" />Ɓi vullǝ ɓǝ nungkwɔ ɓa than ɓa ibǝi ɓǝ ɓuo. Kwoi ko kwɔ ɓa ibǝi ɓi tuab ɓuo. Langkwoi dǝm dǝnyitthǝ gei gǝ, <verse eid="2CO 1:13" /><verse number="14" style="v" sid="2CO 1:14" />manungkwɔ ɓa ibǝi ɓi tuab ɓuo, wuɓa ibǝi ǝndǝi, yangbǝ Vii kwɔ Dangbang Yeso wuo tthǝ ɓa lǝilo ɓǝ i ɓi manungkwɔ ɓi lǝi loɓi iɓǝlǝ ɓǝ.<verse eid="2CO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15" />Ən ibǝing la langǝ i i nungkwɔ ǝndǝi ǝn mab zuii lanwasiu mǝn tǝ suaɓǝ, yangbǝ ɓa tǝi bǝ khana lo bo rab. <verse eid="2CO 1:15" /><verse number="16" style="v" sid="2CO 1:16" />Bakwɔ ǝn mab zuii bǝ tǝ sua ɓǝkwɔ kwɔ nǝ dǝmǝntǝ Makidoniya langkwoi nǝmǝn kwoi suam ɓǝ, yangbǝ ǝn tǝi nung dǝsua naɓǝ nǝmǝn tǝ Yahudiya ɓǝ. <verse eid="2CO 1:16" /><verse number="17" style="v" sid="2CO 1:17" />Kwɔ dǝmǝn mab zuii nungkwɔ, ǝn to i bǝ yiɗi lomma? Kwɔ dǝm mab zuii nungǝm, ǝn mab yiram i bǝ yiɗi lomma, ǝǝlo bǝ gei angǝ&lt;&lt;Ni, ni&gt;&gt; langkwoi &lt;&lt;Nilǝu, nilǝu&gt;&gt;lona kun ǝndǝi? <verse eid="2CO 1:17" /><verse number="18" style="v" sid="2CO 1:18" />Kwoi lalangǝ i manungkwɔ Fuh dǝna gei ba a langǝ i, bǝ gwabnwam tthǝɓǝ lǝ ǝn &lt;&lt;Ni&gt;&gt;langkwoi i &lt;&lt;Nilǝu.&gt;&gt; <verse eid="2CO 1:18" /><verse number="19" style="v" sid="2CO 1:19" />Bakwɔ Yeso Kristi, Yui gi Fuh, kwɔ Sila gei ɓǝ bagu tthǝɓǝ, Timitawos, i ɓanglǝ, ǝn yuu akwɔ lǝ &lt;&lt;Ni&gt;&gt;langkwoi &lt;&lt;Nilǝu&gt;&gt;kwoi manungɓǝ lǝu, u lǝ &lt;&lt;Ni&gt;&gt;gi Fuh; <verse eid="2CO 1:19" /><verse number="20" style="v" sid="2CO 1:20" />bakwɔ ǝn u ɓǝlǝ &lt;&lt;Ni&gt;&gt;lǝ bǝ gwab nwa gi Fuh. Ən u nungkwɔ Yeso Kristi lǝ &lt;&lt;Dǝitthǝ manungɓǝ&gt;&gt;i gei lǝn ba ghaali gi Fuh.<verse eid="2CO 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2CO 1:21" />Ən Fuh i nko lǝ mab ɓi, iɓǝlǝ, bǝ dǝi nwongǝi ɓi la langǝ i dang tha i nwongǝi ɓi i Kristi; ǝn Fuh i nkolǝ kwoi ɓilǝ gwu kun, <verse eid="2CO 1:21" /><verse number="22" style="v" sid="2CO 1:22" />u ɓii nungɓii gu tthǝɓi lǝ abo, langkwoi ǝn u dǝɓi Ɓyang a Langǝ i gi Fuh dang nyi ɓi dǝɓi dǝ nyitthǝ tthǝ nungkwɔ ǝndǝi dǝna wɔ ɓǝ.<verse eid="2CO 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23" />Ən lubǝ Fuh lǝ shǝdǝm u i lo nyim mǝng! Nungkwɔ to ǝntǝ Koranti lǝu kwɔ lǝn babǝ nwong ɓǝ. <verse eid="2CO 1:23" /><verse number="24" style="v" sid="2CO 1:24" />Dǝɓi to nung lǝi yangbǝ ɓi taɓǝ natthǝ nungkwɔ ɓa dǝ ba a langǝ i tthǝ ɓǝ lǝu; ɓi ibǝing ɓa dǝi nyimɗing dang bǝ dǝnyitthǝ Fuh. Manung kwɔni yang, dǝ ɓi to nung to i ɓǝlǝ ba tthǝla ɓǝ.<verse eid="2CO 1:24" /></para>
  <chapter eid="2CO 1" />
  <chapter number="2" style="c" sid="2CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1" />Nungkwɔ ǝn mǝrrǝm lo nyim ǝn geigǝ ǝn tǝ sua ɓǝ akunu so tǝn ɓanglǝ dang wa ɓǝng. <verse eid="2CO 2:1" /><verse number="2" style="v" sid="2CO 2:2" />Bakwɔ nǝ tǝn ɓanglǝ dang waɓǝ, yang ǝn yittǝn a i kwɔ a tǝm dang wam ɓa? Ən yuu akwɔ ɓuo ǝn ɓanglǝ dang wko ɓǝ. <verse eid="2CO 2:2" /><verse number="3" style="v" sid="2CO 2:3" />Ən ba ɓǝkwɔ nungkwɔ ǝn vullǝ ɓǝ nung vullǝ kullo tthǝ-ǝn yiɗi bǝ tǝ suaɓǝ yang yakwɔ kaso a tǝm dang wam kwɔ ɓanglǝ dang wam ɓǝlǝu. Ən ibǝing nǝ dǝmǝng lǝ tthǝla, yang ɓǝ ǝndǝi dǝɓa lǝ tthǝla langɓǝ.<verse eid="2CO 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 2:4" />Dǝmǝn vullǝ ɓǝ nungkwɔ tthǝ ɓang dang zuii i bǝ ɓanglǝ dang wa i mungnung nungǝm; ǝn toni yangbǝ ɓa ibǝi bǝ yiɗi bǝi kwɔ dǝm yiɗi ɓǝ lǝɓǝ.<verse eid="2CO 2:4" /></para>
  <para style="s">Bǝ Al Nung A Ɓko Lǝtǝ</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5" />Lakwɔ, nǝ yuu akun ɓanglǝ dang wa yuu a kun, u to lǝng ɓanglǝu kwoi u to lǝn ɓǝ ǝndǝi-ɓi lǝi ghaatthǝ thǝ, yang. (Dǝmǝng gei nungkwɔ yangbǝ dǝmǝng yiɗi ǝn lǝi ghaatthǝ lolǝ lǝu.) <verse eid="2CO 2:5" /><verse number="6" style="v" sid="2CO 2:6" />Lǝ ba yuu ɓǝ kullo bǝ ɗablua bǝi kwɔ kpaali ɓǝ duu kwɔ natthǝng. <verse eid="2CO 2:6" /><verse number="7" style="v" sid="2CO 2:7" />Lakwɔ, manungkwɔni, ɓa al nung a ɓko ba gu lǝtǝ ɓa duu tthǝnyimmi, yangbǝ bǝɓa ɓanglǝ dang wko ghaani thǝ so u kwai u tǝ longwam laɗing. <verse eid="2CO 2:7" /><verse number="8" style="v" sid="2CO 2:8" />Yang lakwɔ dǝmǝn yamɓǝ ɓa tou u ibǝi dǝ ɓa yiɗiu la langǝ i. <verse eid="2CO 2:8" /><verse number="9" style="v" sid="2CO 2:9" />Ən vullǝ ɓǝ nungkwɔ tthǝ yangbǝ ǝn ibǝi ko ɓa dǝi maɗing lǝ ba bǝ nabǝi ko vii ǝndǝi ɓa dǝilo bǝ lǝ bam. <verse eid="2CO 2:9" /><verse number="10" style="v" sid="2CO 2:10" />Kwɔ nǝɓa al nung a ɓko yayuu lǝtǝ lǝ ba nungkwɔ i to kwɔ, yang ǝn al lǝtǝng langɓǝ. Bakwɔ nǝ ǝn al lǝtǝ-nǝ, la langǝ i, nǝ ǝn yiɗi bǝ al nung a kun lǝtǝ-dǝmǝng al lǝtǝ ǝn ba Kristi lǝ ba ɓǝ. <verse eid="2CO 2:10" /><verse number="11" style="v" sid="2CO 2:11" />Yangbǝ bǝ mungkullum tǝi ttha loɓi langkwoi thǝ; ɓi ibǝ nunglǝi kwɔ dǝnnu mab ɓǝng.<verse eid="2CO 2:11" /></para>
  <para style="s">Tthǝ Vulli Gi Bulus Dang Taruwasa</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12" />Kwɔ ǝn tǝ Taruwasa bǝ gei nwaba a langǝ i gi Kristi, tǝntǝi Dangbang owhsi ɓko nunglǝi nungto ɓǝ bǝi lǝng. <verse eid="2CO 2:12" /><verse number="13" style="v" sid="2CO 2:13" />Kwoi dang nyim losua lǝu, bakwɔ ǝntǝ tǝntǝi young ɓi Titus lǝuɓǝ. Nungkwɔ ǝn yǝrnwa lǝ yayuu kwɔ bǝilǝ kwɔ ǝn palǝi Makidoniya.<verse eid="2CO 2:13" /></para>
  <para style="s">Ttha Bǝ Tang Lo Tthǝ Kristi</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14" />Kwoi bǝ khabǝi ǝn a bǝ Fuh! Bakwɔ dang tha i Kristi vii ǝndǝi Fuh dǝna owh ɓilǝ si mangǝ ya pursǝna dang thko bǝ tǝi lo. Fuh dǝna tonungto iɓi dang bǝ ibǝnung lǝba Kristi kwɔ yǝbbǝi ǝndǝi mangǝ ǝn kum turare a lala.<verse eid="2CO 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 2:15" />Bakwɔ ɓi mangǝ ǝn kum turare kwɔ Kristi nyǝklǝ nung tthǝ Fuh ɓǝ, kwɔ yǝbtha dang yakwɔ i nwongǝi i yakwɔ langkwoi la ɓǝ. <verse eid="2CO 2:15" /><verse number="16" style="v" sid="2CO 2:16" />Bakwɔ yakwɔ lǝnla kwɔ, ǝn kum nungkwɔ ɓkoni a thǝbbǝi ɓǝ; kwoi ba a bǝ ya kwɔ Kristi nwongǝi kwɔ, mangǝ ǝn turare kwɔ dǝna wullǝ nwongǝi ɓǝ. Ənyiǝ, yang, a natthǝ bǝ tonungto kwɔ? <verse eid="2CO 2:16" /><verse number="17" style="v" sid="2CO 2:17" />Ɓi manung gi yakwɔ kpaatthǝ ɓǝlǝu, kwɔ dǝi lǝi bagi Fuh lǝ nung a nǝkwam ɓǝ; kwoi bakwɔ ǝn Fuh tum ɓi ɓǝ, ɓi gei ba a langǝ i ɗǝg siu, Manung ya thǝb gi Kristi.<verse eid="2CO 2:17" /></para>
  <chapter eid="2CO 2" />
  <chapter number="3" style="c" sid="2CO 3" />
  <para style="s">Ya Thǝb Gwab Nwaba Afu</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1" />Nungkwɔ to mangǝ dǝɓi lǝi loɓi akuna? Manungɓǝni, manung gi yakun, dǝɓi yidɗi nungvullǝ kwɔ a gei nung a langǝ i loɓi tthǝɓa?<verse eid="2CO 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 3:2" />Ɓǝ i naɓǝ ǝn nungvullǝ kwɔ ɓi tǝi ɓǝ, Kristi vullǝ lo nyi ɓi lǝ yayuu tthǝ ǝndǝi a ibǝi a than ɓǝ. <verse eid="2CO 3:2" /><verse number="3" style="v" sid="2CO 3:3" />Kai nǝkwam, ɓǝ ǝn nungvullǝ gi Kristi, na ɓi lǝ, i vullǝ i mung yǝng nungvullǝ nung lǝu, kwoi ǝn a ɓyang gi fuh ya nwongǝi, langkwoi tthǝn lotal vullǝ nung lǝu kwoi tthǝn dang wa thayuu.<verse eid="2CO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4" />Ɓi gei bakwɔ langkwoi bakwɔ ɓi tthǝ i dang wa a nyimi dang ɗuǝn Fuh tthǝ Kristi ɓǝ.<verse eid="2CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 3:5" />Nung yangǝu tthǝɓi kwɔ a dǝɓi nunglǝi ɓi lǝi loɓi ɓi gei ɓingǝ nyimɗing ɓi tonungto kwɔ. Tthǝ nyimmi kwɔ ɓi tǝi kwɔ wuo tthǝ Fuh; <verse eid="2CO 3:5" /><verse number="6" style="v" sid="2CO 3:6" />Ən uɓǝ u naɓi natthǝ bǝ lǝi ba afu, kwɔ ǝn bǝ vullǝ zuu lǝu kwoi ǝn ba Ɓyang a langǝ i. Bǝ vullǝ zuu dǝna wullǝ ɓua, kwoi Ɓyang wullǝ nwongǝi.<verse eid="2CO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7" />Ghaali gi Fuh fug, kwɔ dǝnni vullǝ zuu gi Musa lotal ɓǝ. Kwɔ lua kwɔ dang nung Musa kwɔ gabbǝi nyimtthǝ, gabbǝi ghaatthǝ kwɔ ya Israila ɓuan dǝ nungǝi tthǝ lǝu. Nǝ zuu ɓǝ, kwɔ kaso wullǝ ɓua kwɔ nǝ wuo i tthǝ nyimmi, yang wuo suatha i ghaali ɓǝlǝ, <verse eid="2CO 3:7" /><verse number="8" style="v" sid="2CO 3:8" />ghaali kwɔ ghaa nǝnǝ kwɔ a wɔ suatha i nung to gi Ɓyang alangǝ i! <verse eid="2CO 3:8" /><verse number="9" style="v" sid="2CO 3:9" />Nunglǝi kwɔ wullǝ bǝ ɓanglǝ nung kwɔ ghaaɗing, ghaaliu kwɔ nǝnǝ kwɔ wullǝ nung to kwɔ wullǝ bǝ nwong bǝi ɓa!<verse eid="2CO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 3:10" />Ən ba a langǝ i nungkwɔ tthǝ i ghaali viikwɔ yangǝu i ghaali lakwɔ. Nalǝ tha i nung to angǝ a kwɔ dang bǝ gwab nwa afu kwɔ yangǝu lakwɔ. <verse eid="2CO 3:10" /><verse number="11" style="v" sid="2CO 3:11" />Nǝ nungkwɔ dǝi sua tuu tthǝu kwɔ a tǝi ghaali, yang ghaali nung akwɔ a dǝi laɗing kwɔ ghaali ɓǝ nǝnǝ!<verse eid="2CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12" />Bakwɔ ɓi tthǝ i bǝ dǝnyitthǝ, ɓitthǝ i tthǝ nyimmi. <verse eid="2CO 3:12" /><verse number="13" style="v" sid="2CO 3:13" />Ɓito manungkwɔ Musa toɓǝ lǝu, kwɔ u ka dang nungǝu i nungmuo lo yangbǝ bǝ ya Israila ɓyǝa lua kwɔ gabbǝi dang nungǝu ɓǝu wuu palǝ laɗing. <verse eid="2CO 3:13" /><verse number="14" style="v" sid="2CO 3:14" />Lo nyii, ba a langǝ i, lǝn lam; wullǝ vii kwɔ lo nyii lǝn lam i nungmuo lo ɓǝlǝ kwɔ dǝnni than ba aku ɓǝ. Nǝ i ilǝ nung ka nung ɓǝ yang yuu ɓǝ a kǝbtha i Kristi. <verse eid="2CO 3:14" /><verse number="15" style="v" sid="2CO 3:15" />Ko ɗiggǝ kwɔ, ko nǝ ɓǝla i than zuu gi Musa, nungmuo lo ɓǝ yirrǝ ka lo nyiǝ. <verse eid="2CO 3:15" /><verse number="16" style="v" sid="2CO 3:16" />Kwoi i ilǝng i, kwɔ ba gi Fuh gei lǝ ba Musa ɓǝ: &lt;&lt;I ilǝ nungmuo lo kwɔ ka nungǝu kwɔ u kwoi u wuo sua Dangbang ɓǝ.&gt;&gt; <verse eid="2CO 3:16" /><verse number="17" style="v" sid="2CO 3:17" />Lakwɔ,&lt;&lt;Dangbang dang ba gi Fuh kwɔ Ɓyang alangǝ i; yang lakwɔ bǝi kwɔ Ɓyang alangǝ i gi Dangbang tthǝ, bǝ tǝi lo tthǝ bǝilǝ. <verse eid="2CO 3:17" /><verse number="18" style="v" sid="2CO 3:18" />Ɓi ǝndǝi, yang, ɓi yǝb ghaali gi Dangbang i dang nung ɓi ɓkolǝ ɓko; langkwoi ghaali ɓǝ kullo, dǝna wɔ tthǝ Dangbang, kwɔ ǝn Ɓyang a langǝ i ɓǝ, mǝrǝm ɓi yang bǝ ɓi mǝrǝm mangǝ ǝn Kristi.<verse eid="2CO 3:18" /></para>
  <chapter eid="2CO 3" />
  <chapter number="4" style="c" sid="2CO 4" />
  <para style="s">Nung Alangǝ i Gi Ɓyang A Langǝ i Dang Tthǝm Suab</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1" />Fuh dang nung a langǝ i gu u dǝɓi nung to kwɔ ɓito ɓǝ, langkwoi lakwɔ tthǝɓi muan lǝu. <verse eid="2CO 4:1" /><verse number="2" style="v" sid="2CO 4:2" />Ɓi dǝ nung akwɔ pyǝa lǝ pyǝa ǝndǝi gwukun i nung to tthǝkku; ɓi to nung to i bǝ ɗam nwa bǝiu, kwoi langkwoi ɓi kǝb pǝllǝ i ba gi Fuh lǝu. Dang ba a langǝ i kwɔ i ǝǝ dang si Fuh langkwoi dǝɓi ɗuong nung ɓi ɓi tana tthǝ ɓi lǝ yayuu ɓyǝa nung a langǝ i tthǝ ɓi lǝ. <verse eid="2CO 4:2" /><verse number="3" style="v" sid="2CO 4:3" />Bakwɔ nǝ ba gi Fuh kwɔ dǝɓi to kwɔ nǝ pimpyǝa, yang pyǝa thǝn tthǝ yakwɔ lǝnla ɓǝ. <verse eid="2CO 4:3" /><verse number="4" style="v" sid="2CO 4:4" />I dǝ ba a langǝ i tthǝ lǝu, bakwɔ lo nyiǝ tthǝn dang thǝl na mungkullum fuh ya longwam kwɔ ɓǝ. U nanni bǝ ɓyǝa lua kwɔ dǝna gabbǝi loi lǝ ɓǝ, lua kwɔ wuo lǝ ba ghaali gi Kristi ɓǝ, nungkwɔ gɓagtha i Fuh la langǝ i.<verse eid="2CO 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 4:5" />Bakwɔ dǝɓi gei ǝn ba ɓi lǝu; dǝɓi gei ǝn ba gi Yeso Kristi ǝn u lǝ Dangbang ɓi, ɓi i naɓi ǝn thǝb ɓǝ lǝ bagi Yeso. <verse eid="2CO 4:5" /><verse number="6" style="v" sid="2CO 4:6" />Fuh kwɔ gei angǝ,&lt;&lt;Dang bǝthǝl lua a gabbǝi tthǝ!&gt;&gt; U Fuh ɓǝ kwɔ wullǝ lua gu wuo gabbǝi lo nyi ɓilǝ, yangbǝ wullǝ bǝ ibǝ nung ghaali gi Fuh gabbǝi kaitthǝ dang nung yeso Kristi.<verse eid="2CO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7" />Kwoi ɓi kwɔ ɓi tthǝ i nungtǝi ɓyang kwɔ ɓi natha i tthǝm suab, yangbǝ ɓi tanatthǝ angǝ ttha angǝ a ǝndǝi ǝn a bǝ Fuh, ǝn aɓi lǝu. <verse eid="2CO 4:7" /><verse number="8" style="v" sid="2CO 4:8" />Vii ǝndǝi dǝnni dǝɓi zuii, kwoi i thǝb ɓi lǝu, vii yakun ɓi dang bǝ ǝrrlǝ kiggǝ, kwoi ɓi sur vulli bǝ tonungto lǝu; <verse eid="2CO 4:8" /><verse number="9" style="v" sid="2CO 4:9" />ya ɓui ɓi kpaaɗing, kwoi ya ǝnthǝ laɓi lǝu bo kun; langkwoi lona akun i nkoni ɓi ɓkotthǝ; i thǝb ɓi lǝu. <verse eid="2CO 4:9" /><verse number="10" style="v" sid="2CO 4:10" />Lona kwɔ ǝndǝi dǝɓi lǝi dang tthǝ ɓi ɓua gi Yeso, yangbǝ i ɓyǝa nwongǝi gu langɓǝ tthǝ ɓi lǝ. <verse eid="2CO 4:10" /><verse number="11" style="v" sid="2CO 4:11" />I bǝ ǝǝ ɓi longwam vii ǝndǝi dang ɓua lǝba Yeso, yangbǝ i ɓyǝa nwongǝi gu dang tthǝ ɓilǝ. <verse eid="2CO 4:11" /><verse number="12" style="v" sid="2CO 4:12" />Nungkwɔ dǝna gei ɓitthǝ angǝ ɓua dǝna to nung to dang ɓilǝ, kwoi nwongǝi dǝna to nung to tthǝ ɓǝ lǝ.<verse eid="2CO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13" />Ba gi Fuh gei angǝ,&lt;&lt;Dǝmǝng gei ba bakwɔ ǝn dǝ ba a langǝ i tthǝng ɓǝ.&gt;&gt;Tthǝ ba ɓyang bǝ dǝnyi a kun ɓǝ dǝɓi gei lǝ ba langɓǝ bakwɔ ɓi dǝ ba alangǝ i tthǝng ɓǝ. <verse eid="2CO 4:13" /><verse number="14" style="v" sid="2CO 4:14" />Ɓi ibǝing Fuh, kwɔ ǝrrlǝ Dangbang Yeso i nwongǝi lǝ kwɔ, u ǝrr ɓilǝ langɓǝ i Yeso langkwoi a lǝi ɓi, i ɓǝlǝ, a tǝlǝ ɗǝg siu.<verse eid="2CO 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 4:15" />Nungkwɔ ǝndǝi ǝn baɓǝ; langkwoi manungkwɔ nung a langǝ i gi Fuh dǝna lilo bǝ kǝn sua yayuu, i pinwa kha Fuh ba ghaali gu.<verse eid="2CO 4:15" /></para>
  <para style="s">Bǝ Əǝ Dang Bǝ Dǝnyitthǝ</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16" />Lǝba kwɔ yang bǝ tthǝɓi muan thǝ. Manung kwɔ tthǝɓi a thayuu tǝmtǝm dǝna zuu, ǝndǝi Ɓyang ɓi a langǝ i dǝna mǝrǝm lafuu vii ǝndǝi. <verse eid="2CO 4:16" /><verse number="17" style="v" sid="2CO 4:17" />Langkwoi zuii kwɔ tuab kwɔ dǝɓi tangkwɔ a wuɓi lǝ ghaali tthǝ kpaatthǝ a ɗing, a ghaa a pǝl zuii ɓǝ.<verse eid="2CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 4:18" />Bakwɔ ɓi dǝ kiggǝ ɓi, tthǝn tthǝ nung a kwɔ i ɓyǝa ɓǝlǝu, kwoi tthǝn tthǝ nung kwɔ i ɓyǝko ɓǝ. Nungkwɔ yayuu dǝna ɓyǝa kwɔ a thǝm lona tuab ɓuo, kwoi nung kwɔ ɓi ɓyǝko kwɔ a ǝǝ laɗing.<verse eid="2CO 4:18" /></para>
  <chapter eid="2CO 4" />
  <chapter number="5" style="c" sid="2CO 5" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1" />Bakwɔ ɓi ibǝi kwɔ tǝbǝ kwɔ ɓi ǝǝ dang ǝu kwɔ-dang tthǝ ɓi longwam kwɔ-nǝ i dǝr i alǝtǝ yang, Fuh a dǝɓi gwoi wayi ɓi ǝǝ dang ǝu, gwoi kwɔ u mab i nko lǝ ɓǝ, kwɔ i mai i na yuu lǝu ɓǝ, kwɔ a ǝǝ laɗing ɓǝ. <verse eid="2CO 5:1" /><verse number="2" style="v" sid="2CO 5:2" />Langkwoi lakwɔ dǝɓi ta fyǝu, bǝ yiɗi bǝ tǝ gwoi ɓi kwɔ wayi kwɔ ghaaɗing kaso i dǝ ɓi; <verse eid="2CO 5:2" /><verse number="3" style="v" sid="2CO 5:3" />bakwɔ nǝ Fuh li ɓi nunglitthǝ a wayi tthǝ yang ɓi ǝǝ i tthǝɓi nǝkwammu. <verse eid="2CO 5:3" /><verse number="4" style="v" sid="2CO 5:4" />Kwɔ lakwɔ dǝɓi ǝǝ i tthǝ ɓi a longwam kwɔ, dǝɓi groang i tthǝzii; ɓi yiɗi bǝ gabtha i tthǝ ɓi a longwam lǝu, kwoi ɓingǝ i li ɓi tthǝ wayi, yangbǝ nungkwɔ a ɓumɓui kwɔ i mǝrrǝm lǝ nwongǝi. <verse eid="2CO 5:4" /><verse number="5" style="v" sid="2CO 5:5" />Fuh i nko lǝ mab ɓi bǝ prǝm nungkwɔ tthǝ, langkwoi u dǝɓi Ɓyang gu lǝ bǝ gwab nwa nung ǝndǝi kwɔ dǝna wɔ ɓǝ.<verse eid="2CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6" />Nungkwɔ vii ǝndǝi ɓitthǝ i bǝ nyimtthǝ ɓi. Ɓi ibǝing nǝɓi gwoi dang tthǝ yang ɓi tutha i gwoi gi Fuh lǝng. <verse eid="2CO 5:6" /><verse number="7" style="v" sid="2CO 5:7" />Bakwɔ Nwongǝi ɓi tthǝn tthǝ bǝ dǝnyitthǝ, ǝn tthǝ nungkwɔ dǝɓi ɓyǝa i nung ɓǝlǝu. <verse eid="2CO 5:7" /><verse number="8" style="v" sid="2CO 5:8" />Ɓi tthǝ i bǝ dǝ nyi nyimmi tthǝ dǝɓi nhǝm bǝ yitthǝ gwoi kwɔ ɓi tthǝɓǝ ɓi tǝ gwoi gi Dangbang. <verse eid="2CO 5:8" /><verse number="9" style="v" sid="2CO 5:9" />Manungkwɔni yang i nung akun yang, ko ɓi i ulǝ, dǝɓi yidɗi bǝ du tthǝla, dang woi ɓi bǝikwɔ ko kullo. <verse eid="2CO 5:9" /><verse number="10" style="v" sid="2CO 5:10" />Ɓi ǝndǝi ɓi ǝǝ tthasi Kristi, u toɓi kwan tthǝ lo nung ǝǝ kwan gu. Ɓi muo nungkwɔ ɓi to ɓǝ, natha i nungkwɔ ɓi to ǝndǝi ɓǝ, maɗing ko ɓkoɗing, dang tthǝɓi i nwongǝi ɓi.<verse eid="2CO 5:10" /></para>
  <para style="s">Bǝ To Ənthǝ I Fuh Tthǝ Kristi</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11" />Bakwɔ ɓi ibǝi kwɔ ɓi sur Dangbang ɓǝng, nungkwɔ dǝɓi ɗubǝ tha ɓǝ. Fuh ibǝi ɓi ǝndǝi, langkwoi dǝmǝng dǝ dang nyim ɓa im ɗing dang nyi ɓǝ. <verse eid="2CO 5:11" /><verse number="12" style="v" sid="2CO 5:12" />Dǝɓi ɗuog nung ɓi yang bǝ ɓi taɓǝ natthǝɓi lǝu; manungkwɔ, dǝɓi gei ɓǝ ba tthǝ yang bǝ ɓa tai ttha ɓa nyim tthǝ ɓǝ bǝ to nung lǝ ba ɓi, yang bǝ ɓa tǝi nwa ɓa gei lǝ ba lǝ ya kwɔ dǝna to nung i ɗuǝn yakun i kiggǝi lǝ lǝu ɓǝ. <verse eid="2CO 5:12" /><verse number="13" style="v" sid="2CO 5:13" />Ɓi dang kiggǝ ɓi lǝu? Ən ba Fuh. Ko ɓǝ dang kiggǝ ɓa? Yang ǝn ba ɓǝ i naɓǝ.<verse eid="2CO 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 5:14" />Bǝ yiɗi bǝi gi Kristi dǝna to nung to i ɓi, kwɔ lakwɔ ɓi ibǝi yuu akun ɓui lǝ ba ɓi, lakwɔ manungkwɔ yang i gab bǝ ɓui ɓua gu i ulǝ. <verse eid="2CO 5:14" /><verse number="15" style="v" sid="2CO 5:15" />U ɓui lǝ ba yayuu ǝndǝi, yangbǝ yakwɔ i nwongǝi kwɔ i ǝǝ loi inailǝ lǝu, kwoi ǝn ba gu kwɔ u ɓui u ǝrr i nwongǝi gu lǝ ba gi ɓǝ.<verse eid="2CO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16" />Lakwɔ, langkwoi, ɓi to kwan lǝ yuu akuntthǝ mangǝng nung to ya longwam. Ɓi to kwan lona akun lǝ Kristi tthǝ manung a bǝ tha yuung, ɓi to akun manung ɓǝu. <verse eid="2CO 5:16" /><verse number="17" style="v" sid="2CO 5:17" />Manungkwɔ ni yang yuu akwɔ dang tha i Kristi yang u ǝn yuu afu; nung aku paang, afu wung. <verse eid="2CO 5:17" /><verse number="18" style="v" sid="2CO 5:18" />Nungkwɔ ǝndǝi ǝn Fuh to, kwɔ tthǝ Kristi u mǝrrǝm ɓi u kwoi ɓi lǝ tthǝ ya ɓui ɓi u tǝlǝ tthǝ ya ǝnthǝu langkwoi u dǝɓi nung to kwɔ ɓi kwai lǝ yakun ɓi wuilǝ tthǝu langɓǝ. <verse eid="2CO 5:18" /><verse number="19" style="v" sid="2CO 5:19" />Bakwɔ Fuh mǝrrǝm ya longwam ǝndǝi lǝ ya ǝnthǝ gi Kristi. Fuh than nung a ɓko gilǝu, langkwoi u dǝɓi bakwɔ u gei ɓitthǝ angǝ u mǝrrǝmmǝi lǝ ya ǝnthǝu.<verse eid="2CO 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 5:20" />Ən ɓi kwɔ, langkwoi, dǝɓi gei ba lǝ ba Kristi, Fuh dǝna gei ba gu tthǝɓi lǝ. Dǝɓi yam dang ɗuǝn Kristi lǝ: dǝisua Fuh mǝrrǝm ma bǝ tthǝngbǝi wa tǝ dang ya ǝnthǝu! <verse eid="2CO 5:20" /><verse number="21" style="v" sid="2CO 5:21" />Kristi to nung a ɓko lǝu, kwoi lǝ ba ɓi Fuh mǝrrǝmu lǝ ba nung a ɓko ɓi yangbǝ u kǝbtha iɓi ɓi to nung a langǝ i i u dang ɗuǝn Fuh.<verse eid="2CO 5:21" /></para>
  <chapter eid="2CO 5" />
  <chapter number="6" style="c" sid="2CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1" />Bǝ to nung to ɓi suatha i Fuh, yang, dǝɓi yamɓǝ ɓǝ yakwɔ ɓa muo ba gi Fuh kwɔ bǝ ɓa yitthǝ ɓanglǝ thǝ.<verse eid="2CO 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 6:2" />Ɓa lǝ ba kwɔ Fuh gei ɓǝ:</para>
  <para style="p" vid="2CO 6:2">&lt;&lt;Kwɔ lona bǝ wuum tthǝ kwɔ mǝn ɓyǝa nung zuii ɓǝ kwɔ,</para>
  <para style="q1" vid="2CO 6:2">Ən lǝ ɓǝng; kwɔ vii ɓǝ wuom tthǝ kwɔ mǝng nwong ɓǝ kwɔ,</para>
  <para style="q2" vid="2CO 6:2">mǝng nwong ɓǝ.&gt;&gt;</para>
  <para style="m" vid="2CO 6:2">Ɓalǝ! Ən lona ɓǝkwɔ lakwɔ ɓa tǝi nyitǝmmi Fuh ɓǝ; ɗiggǝ ǝn vii kwɔ i nwongɓǝ ɓǝ!<verse eid="2CO 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3" />Ɓi yiɗi kwɔ yuu akun tǝi nung a ɓko dang nung to ɓi ɓǝlǝu, nungkwɔ ɓi yiɗi bǝ dǝ nung kwɔ a wullǝ nung a ɓko nunglǝi yuu akun ɓǝlǝu.<verse eid="2CO 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 6:4" />Manungkwɔni yang, dang nung kwɔ ǝndǝi dǝɓi to kwɔ dǝna tanatthǝ angǝ ɓi ǝn ya thǝb gi Fuh i bǝ tthǝb nyitthǝ yurrǝ, zuii i nung a zizi.<verse eid="2CO 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 6:5" />I ɓuob ɓi, i tthǝb ɓi pursǝna, langkwoi i ǝrr lǝ kiggǝ ɓi; i dǝɓi nung to pǝl ttha ɓi, ɓi lo nung lou ko nungtang. <verse eid="2CO 6:5" /><verse number="6" style="v" sid="2CO 6:6" />I bǝ to nung a langǝ i ɓi, i bǝ ibǝnung, ibǝ tthǝb nyitthǝ, i nyitǝmmi ɓi dǝ loɓi lǝ ya thǝb gi Fuh-lǝ ba Ɓyang a Langǝ i, ba bǝ yiɗi bǝi ɓi a langǝ i, <verse eid="2CO 6:6" /><verse number="7" style="v" sid="2CO 6:7" />i nwaba ɓi a langǝ i, langkwoi i ttha gi Fuh. Ɓitthǝ i nung to a langǝ i lǝ nung taɓui ɓi, ɓi talǝ ɓui langkwoi ɓi nwonglǝ loɓi.<verse eid="2CO 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 6:8" />I dǝɓi angǝ a langkwoi i dǝɓi tthǝkku; i dal ɓi langkwoi i khaɓi. I lǝi ɓi mangǝn ɓi ǝn ya pǝllǝ, kwoi dǝɓi gei ǝn ba a langǝ i; <verse eid="2CO 6:8" /><verse number="9" style="v" sid="2CO 6:9" />mangǝ i iɓi lǝu, kwoi i iɓi ǝndǝi; mangǝttǝn ɓi ɓumɓui, kwoi, manungkwɔ ɓa ɓyǝa kwɔ, ɓi ǝǝ tthǝ. Dǝnni ɗablua ɓi, i thǝb ɓi lǝu; <verse eid="2CO 6:9" /><verse number="10" style="v" sid="2CO 6:10" />mangǝ dang waɓi ɓanglǝ lǝ ɓang, vii ǝndǝi dǝɓi lǝtthǝla; mangǝ ɓi ǝnya yiɓko, kwoi ɓi mǝrǝm yayuu kpaatthǝ lǝ ya nungtǝi; mangǝttǝn nung yangǝu na ɓiu, ba a langǝ i ɓi tthǝ i nung ǝndǝi.<verse eid="2CO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11" />Ya ǝnthǝ ɓi dang Koranti! Ɓi gei ɓǝ ba a langǝ i tthǝ; ɓi ɓkoɓǝ lo nyi ɓitthǝ ai tthǝ.<verse eid="2CO 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 6:12" />Ənɓi ɓi ilǝ lo nyi ɓi tthǝ ɓǝ lǝu; ǝnɓǝ ɓa ilǝ lo nyi ɓǝ tthǝɓi. <verse eid="2CO 6:12" /><verse number="13" style="v" sid="2CO 6:13" />Lakwɔ dǝmǝng geiɓǝ ba mangǝttǝn ɓǝ ǝn yathangǝm: ɓa dǝɓi lo nyi ɓǝ manungkwɔ ɓi dǝɓǝ aɓi ɓǝ. Ɓa ɓko lo nyi ɓǝ ai tthǝ!<verse eid="2CO 6:13" /></para>
  <para style="s">Bǝ Ɓa Kǝb Loɓǝ Lǝtha I Yakwɔ I Fuh Lǝuɓǝ Thǝ</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14" />Bǝ ɓa kǝbtha lo ɓa to nung to i yakwɔ i Fuh lǝu ɓǝthǝ, to tthǝu. Nung a langǝ i i nung a ɓko a to nǝnǝ a kǝblǝtha? A to nǝnǝ lua a ǝǝ tthangtha i bǝ baithǝl?<verse eid="2CO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 6:15" />Kristi i Mungkullum a to nǝnǝ a gwabtha? Ənɓǝ a kǝb ya dǝ ba a langǝ i tthǝ Fuh i yakwɔ dǝ ba a langǝ i tthǝ Fuh lǝu ɓa? <verse eid="2CO 6:15" /><verse number="16" style="v" sid="2CO 6:16" />Ən ɓǝtǝn kǝb kǝm nyǝknung gi Fuh i fuh yakwɔ i Fuh lǝu kwɔ nwongǝi yangǝu ɓa? Ɓi ǝn kǝm nyǝknung gi Fuh ya dǝ nwongǝi! Manungkwɔ Fuh i nkolǝ gei ɓǝ angǝ,</para>
  <para style="q1" vid="2CO 6:16">&lt;&lt;Mǝn mab gwoim i yayuum lǝ</para>
  <para style="q2" vid="2CO 6:16">yang ǝn lo dang ǝi lǝ;</para>
  <para style="q1" vid="2CO 6:16">Ɓanglǝ Fuh gi,</para>
  <para style="q2" vid="2CO 6:16">i langkwoi ǝn yayuum.&gt;&gt;<verse eid="2CO 6:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="2CO 6:17" />Langkwoi nungkwɔ Dangbang gei angǝ,</para>
  <para style="q1" vid="2CO 6:17">&lt;&lt;Ɓa yiǝ</para>
  <para style="q2" vid="2CO 6:17">langkwoi ɓa gabtha i ilǝ.</para>
  <para style="q1" vid="2CO 6:17">Bǝ ɓa to nung to i nungkwɔ ǝn nung ɓillǝng ɓǝthǝ,</para>
  <para style="q2" vid="2CO 6:17">yang mǝn muo ɓǝ ǝn muo.<verse eid="2CO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2CO 6:18" />Mǝn ǝǝ lǝ Daa ɓǝ,</para>
  <para style="q2" vid="2CO 6:18">langkwoi yang ɓa mǝrrǝm lǝ yathangǝm a yaɓǝi i yathangǝm yasi,</para>
  <para style="q2" vid="2CO 6:18">ǝn Dangbang Ya angǝ a gei.&gt;&gt;<verse eid="2CO 6:18" /></para>
  <chapter eid="2CO 6" />
  <chapter number="7" style="c" sid="2CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1" />Ya ǝnthǝm, bǝ gwab nwa kwɔ ǝndǝi i gwab lǝn ɓitthǝ. Nungkwɔ yang, ɓi mab tthǝ ɓi bǝɓi to nung a ɓko i tthǝ ɓi i killǝng ɓi thǝ, yang ɓi to nung a langǝ i bǝ ǝǝ ɓi i Fuh lǝ.<verse eid="2CO 7:1" /></para>
  <para style="s">Tthǝla Gi Bulus</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2" />Ɓa mab ɓi bǝitthǝ dang nyiɓǝ. Ɓi tonung aɓau lǝ yuu akun lǝu; ɓi ɓanglǝ yuu akun lǝu, ɓi tam yuu akun lǝu. <verse eid="2CO 7:2" /><verse number="3" style="v" sid="2CO 7:3" />Ən gei nungkwɔ yangbǝ ǝn ɓangɓǝ lǝ lǝu; bakwɔ, manungkwɔ ǝn gei nungsi kwɔ, ɓǝ dang nyi ɓi nungkwɔ vii ǝndǝi ɓi i ɓǝlǝ, ko ɓi ǝǝ ko ɓi ɓui.<verse eid="2CO 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 7:4" />Ən gwabtha i ɓǝng; Dǝmǝn nyimtthǝm tthǝɓǝ! Dang zuii kwɔ dǝɓi to kwɔ ǝndǝi tthǝm nyimɗing; tthǝ lam kpaaɗing.<verse eid="2CO 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5" />Kwɔ ɓi tǝ dang Makidoniya kwɔ, ɓi nwong tthǝ ɓi lǝu. Bǝ ǝrr lǝ kiggǝ lǝi bǝi kwɔ ǝndǝi, bǝ kwatha i yakun, vulli dang nyi ɓi.<verse eid="2CO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 7:6" />Kwoi Fuh, kwɔ dǝna dǝ tthǝ nyimmi lǝ yakwɔ i lai kwɔ, dǝɓi tthǝ nyimmi i bǝ wuo gi Titus. <verse eid="2CO 7:6" /><verse number="7" style="v" sid="2CO 7:7" />Ən babǝ wuo gu ɓuo dǝɓi tǝmmi lǝu, kwoi langkwoi ǝn bagu kwɔ u gei ɓitthǝ angǝ ɓa du tthǝnyimmi ɓǝ. U gei ɓitthǝ kwɔ dǝɓa yiɗi bǝ ɓyǝam niɓǝ, lo nyi ɓǝ ɓuontthǝ, ɓa ǝǝlo bǝ nwongǝm lǝɓǝ; langkwoi nungkwɔ tthǝm la ǝndǝi.<verse eid="2CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8" />Bakwɔ nǝ nung vullǝm kwɔ ɓanglǝ dang wa ɓǝng, ǝn ee nwa ɓko babǝ vullǝu lǝu. Vii kwɔ nungsi ǝn ɓanglǝ dang wang bakwɔ dǝmǝn ɓyǝa nungvullǝm ɓang lǝ dang wa ɓǝng dang lona tuab.<verse eid="2CO 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CO 7:9" />Lakwɔ tthǝm la ǝndǝi-ǝn bakwɔ ǝn ɓanglǝ dang wa ɓǝ ɓǝlǝu, langkwoi ǝn bakwɔ dang wa ɓǝ kwɔ ɓanglǝ kwɔ langkwoi ɓa mǝrrǝm nung lǝi ɓǝ. Dangwa a ɓko ɓǝkwɔ ǝn Fuh tolǝ nung to, langkwoi nungkwɔ ɓi nkoni ɓǝ lǝu. <verse eid="2CO 7:9" /><verse number="10" style="v" sid="2CO 7:10" />Bakwɔ bǝ ɓanglǝ dang wa kwɔ Fuh tolǝ nung to kwɔ dǝna mǝrrǝm lo nyi dǝna tǝlǝ ya longwam lǝ bǝ nwong bǝi bǝ ɓanglǝ dang wa yangǝu! Kwoi bǝ ɓanglǝ dang wa kwɔ ǝn a bǝ yuu dǝna wullǝ ɓua.<verse eid="2CO 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 7:11" />Ɓa ɓyǝa nungkwɔ Fuh to i bǝ ɓanglǝ dang wa ɓǝkwɔ ɓǝ: mab ɓǝ maɗing, dǝɓa yiɗi bǝ ilǝ loɓǝ! Ən dang wa anwɔ a tanatthǝ angǝ ɓa yangǝu dang ǝu! I bǝ mab nunglǝi ɓǝ, i bǝ buogbǝi lo nungkwɔ ɓa ɓyǝa ɓǝ, nungkwɔ ɓa lǝ dang tthǝɓǝ, i bǝ dǝlo ɓǝ, kwoi ɓa dǝlo tthǝ ɓa dǝ zuii lǝ nung a ɓko ɓǝ! Ɓa ilǝ loɓǝ ɓangǝ ɓa to nung a ɓko lǝu dang ba ɓǝllǝ.<verse eid="2CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 7:12" />Nungkwɔ, ko kwɔ ǝn vullǝ nungvullǝ kwɔ, ǝn ba yuu akwɔ to nung a ɓko ko ǝn ba yuu akwɔ i tou i nung a ɓko ɓǝlǝu. Manungkwɔni yang, Ən vullǝ yangbǝ ǝn gei ɓǝtthǝ kaitthǝ, tthasi Fuh, ba bǝ dǝ lo kwɔ ɓa dǝllǝ ba ɓiɓǝ. <verse eid="2CO 7:12" /><verse number="13" style="v" sid="2CO 7:13" />Ən ba ɓǝkwɔ nungkwɔ i dǝɓi tthǝnyimmi;</para>
  <para style="p" vid="2CO 7:13">Ən bǝ nyim tthǝɓi ɓuolǝu; Titus dǝɓi tthǝla i tthǝla gu nunglǝi kwɔ ɓǝ ǝndǝi ɓa nwongǝu ɓǝ!<verse eid="2CO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 7:14" />Dǝmǝn lǝi lom lǝ baɓǝ tthǝu lǝu, langkwoi ɓa dǝm tthǝkku lǝu. Vii ǝndǝi dǝɓi gei ɓǝ ba a langǝ i tthǝ, langkwoi ǝndǝi bǝ lǝi loɓi kwɔ ɓi gei lǝ Titus tthǝkwɔ ǝn ba a langǝ i. <verse eid="2CO 7:14" /><verse number="15" style="v" sid="2CO 7:15" />Langkwoi nungkwɔ bǝ yiɗi bǝi gu lǝba ɓǝ ghaa nyimɗing, manungkwɔ u nhǝm ɓǝ ǝndǝi dǝ ɓa yiɗi bǝ to nung to i bagu kwɔ, kwɔ ɓa kǝb lo i vulli tthǝ ɓǝ dǝna ɓuobtthǝm ɓǝ. <verse eid="2CO 7:15" /><verse number="16" style="v" sid="2CO 7:16" />Tthǝm la ǝndǝing mǝn ɓuan mǝn dǝ nyi tthǝ ɓǝ ǝndǝi!<verse eid="2CO 7:16" /></para>
  <chapter eid="2CO 7" />
  <chapter number="8" style="c" sid="2CO 8" />
  <para style="s">Bǝ Dǝnung Ya Kristǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1" />Ya ǝnthǝ ɓi, dǝɓi yiɗi ɓa ibǝi nungkwɔ nung a langǝ i gi Fuh to alo ya kǝm pinwa Makidoniya ɓǝ.<verse eid="2CO 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 8:2" />I nai ghaaɗing i zuii kwɔ i tangɓǝ; kwoi tthǝla gi ghaaɗing kwɔ i dǝi nyimtthǝ dang bǝ dǝ nung gi ɓǝ, ko i ǝn ya yiɓko ɓǝ. <verse eid="2CO 8:2" /><verse number="3" style="v" sid="2CO 8:3" />Dǝmǝn gei ɓǝ tthǝ i dǝ nung dang wa kun, langkwoi pǝl ttha nungkwɔ nailǝ ɓǝ. I bǝ yiɗi gi <verse eid="2CO 8:3" /><verse number="4" style="v" sid="2CO 8:4" />i ɗyǝab langkwoi i yam ɓi yangbǝ i tǝi lǝi dang bǝ nwong yayuu gi Fuh dang Yahudiya. <verse eid="2CO 8:4" /><verse number="5" style="v" sid="2CO 8:5" />Pǝl bǝi kwɔ dǝɓi dǝnyitthǝ ɓǝng! La nwasiu i dǝ loi lǝ Dangbang; langkwoi yang, i bǝ yiɗi gi Fuh i dǝɓi loi langɓǝ.<verse eid="2CO 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 8:6" />Nungkwɔ ɓi yam Titus, yuu akwɔ baipi nung to kwɔ ɓǝ, u to nung to ɓǝ yang u nwong ɓǝ ɓa alo nung to kwɔ la langǝ i kwɔ dang bǝ yiɗi bǝi. <verse eid="2CO 8:6" /><verse number="7" style="v" sid="2CO 8:7" />Mǝ ǝn ya nungtǝi dang nungkwɔ namǝ ɓǝ: dang bǝ dǝnyitthǝ, bǝ gei ba, i bǝ ibǝ nung, i bǝ yiɗi bǝ nwongbǝi i bǝ yiɗi bǝi kwɔ dǝma yiɗi ɓi ɓǝ. Langkwoi nungkwɔ dǝɓi yiɗi a ɓko namǝ dang nung to yiɗi bǝi kwɔ.<verse eid="2CO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8" />Dǝmǝn dǝ zuu akun lǝu. Kwoi dǝmǝn tanatthǝ bǝ yiɗi valli bǝi yakun, dǝmǝn yiɗi bǝ ibǝi bǝ yiɗi bǝi mǝ ǝn a langǝ i.<verse eid="2CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CO 8:9" />Ɓa ibǝ nung a langǝ i gi Dangbang Yeso Kristi; yuu nungtǝi manung gu, u mǝrǝm lolǝ ya yiɓko lǝ ba ɓǝ, yangbǝ u mǝrǝm ɓǝ lǝ ya nungtǝi lǝ ba yiɓko gu.<verse eid="2CO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10" />Nǝ ǝn ba abǝm yang maɗing ɓa alo nungto kwɔ ɓa baipiu ttha kwɔ paɓǝ. Ən ɓǝlǝ ya nwasiu, lǝ ba bǝ tonungto ɓuolǝu, kwoi langɓǝ i bǝ yidɗi bǝ tonungto ɓǝ.<verse eid="2CO 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 8:11" />Lo nungto ɓǝlǝ, yang, ɓa alo nungto ɓǝ! Ɓa yidɗi bǝ alo manung kwɔ ɓa yidɗi bǝ ɓyǝko ɓǝ, langkwoi ɓa to i nungkwɔ naɓǝ lakwɔ ɓǝ. <verse eid="2CO 8:11" /><verse number="12" style="v" sid="2CO 8:12" />Nǝ dǝɓa yidɗi bǝ dǝnung lǝ yayuu, Fuh a gwab bǝ dǝnung ɓǝ lo nungkwɔ ɓa dǝ ɓǝ, tthǝn lo nungkwɔ yangǝu naɓǝ lǝu ɓǝ.<verse eid="2CO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 8:13" />Dǝmǝn yidɗi bǝ nwong yakun yangbǝ ǝn dǝɓǝ nunglǝi a ɓuonni lǝu; kwoi yangbǝ ɓǝ ǝndǝi ɓa natha. <verse eid="2CO 8:13" /><verse number="14" style="v" sid="2CO 8:14" />Lona ɓǝlǝ kullo yang nung ǝndǝi i gab ɓǝ tthǝ natha manung kwɔ ɓa yidɗi ɓǝ, yang langkwoi nung kwɔ dǝnni yidɗi kwɔ i dǝɓǝ manung kwɔ dǝɓa yidɗi ɓǝ. Yang nung ɓǝ natha ǝndǝi, <verse eid="2CO 8:14" /><verse number="15" style="v" sid="2CO 8:15" />Manungkwɔ ba gi Fuh gei kwɔ angǝ,&lt;&lt;Nǝ yuu akwɔ nǝ gǝm kpaatthǝ nung kwɔ atǝi kpaatthǝ lǝu, langkwoi yuu kwɔ nǝ gǝm tuab nungkwɔ a tǝi tuabni lǝu.&gt;&gt;<verse eid="2CO 8:15" /></para>
  <para style="s">Titus I Ya Tonungto I Ulǝ</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16" />Dǝɓi lǝ tthǝla gi Fuh bakwɔ u tǝ dang wa Titus manung kwɔ dǝɓi nwongɓǝ ɓǝ! <verse eid="2CO 8:16" /><verse number="17" style="v" sid="2CO 8:17" />Titus lǝ ǝn tthǝla bǝ yamnung ɓi ɓuo lǝu; dǝnnu lǝ tthǝla bǝ nwong bǝi kwɔ dǝnnu to i bǝ yiɗi gu kwɔ yangbǝ u tǝlǝ suaɓǝ.<verse eid="2CO 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 8:18" />I ulǝ dǝɓi tum ǝnthǝ ɓi kwɔ dǝnni du angǝ a nyimtthǝ dang kǝm pinwa lǝ ba bǝ gei ba gi Fuh ɓǝ. <verse eid="2CO 8:18" /><verse number="19" style="v" sid="2CO 8:19" />Yang manung kwɔni ǝndǝi, i mko i du nung to dang kǝm pinwa angǝ u tǝ i ɓi lǝ tǝu to nung to gu i bǝ yiɗi bǝi lǝ ba ghaali gi Dangbang langkwoi yang bǝ ta na tthǝ dǝɓi yiɗi bǝ nwongbǝi.<verse eid="2CO 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 8:20" />Dǝɓi ɓyǝa la langǝ i yangbǝ bǝ yakun gei ba lo nungkwɔ dǝɓi to ǝndǝi lo nung dǝ gi Fuh ɓǝthǝ. <verse eid="2CO 8:20" /><verse number="21" style="v" sid="2CO 8:21" />Lo nyi ɓi dǝɓi yiɗi bǝto nungkwɔ matthǝ ɓǝ, lǝng ba Dangbang ɓuo lǝu, kwoi lǝ ba yayuu ǝndǝi.<verse eid="2CO 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22" />Manungkwɔni yang dǝɓi tum young ɓi kwɔ i ilǝ; ɓi bangǝu lona kpaatthǝ ɓi tǝiu dǝnnu yiɗi bǝ nwongbǝi. Kwɔ ɓi ɓyǝa lakwɔ u dǝ lo nyiu tthǝ mǝ ɗing, yang u tthǝ i ba bǝ nwongbǝi ghaaɗing. <verse eid="2CO 8:22" /><verse number="23" style="v" sid="2CO 8:23" />Lǝ ba Titus abo, u ǝn ya nung to ɓi, ɓi to nung to i ulǝ yangbǝ ɓi nwong ɓǝlǝ; lǝ ba ya ǝnthǝ ɓi akwɔ dǝna tǝ i ulǝ kwɔ, i prǝm ǝn nwa ya kǝm pinwa yangbǝ i wullǝ ɗuǝn angǝ a lǝ Kristi tthǝ. <verse eid="2CO 8:23" /><verse number="24" style="v" sid="2CO 8:24" />Ɓa tainatthǝ bǝ yiɗi bǝi ɓǝ, yangbǝ sua ya kǝm pinwa kwɔ ǝndǝi ibǝi angǝ dǝɓi to nung a langǝ i i lo angǝ a lǝ ba ɓǝ.<verse eid="2CO 8:24" /></para>
  <chapter eid="2CO 8" />
  <chapter number="9" style="c" sid="2CO 9" />
  <para style="s">Ɓa Nwong Yayuu Fuh Kwɔ Nung Yangǝu Nai Ɓǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1" />Ba akun yangǝu kwɔ mǝn vullǝ ɓǝtthǝ lǝ ba bǝ nwongbǝi kwɔ i tog lǝ yayuu gi Fuh tthǝ dang Yahudiya ɓǝu. <verse eid="2CO 9:1" /><verse number="2" style="v" sid="2CO 9:2" />Ən ibǝi dǝɓa yiɗi bǝ nwong bǝi, yang langkwoi dǝmǝn nyimtthǝm dǝmǝn gei lǝ ya Makidoniya tthǝ.&lt;&lt;Ya dǝ ba a langǝ i dang Akaya,&gt;&gt;Ən geigǝ,&lt;&lt;dǝmǝn yiɗi bǝ nwong bǝi ttha kwɔ paɓǝ.&gt;&gt;Nung to ɓǝ nan suai ǝndǝi.<verse eid="2CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 9:3" />Lakwɔ dǝmǝn tum ya dǝ ba a langǝ i, yangbǝ dǝ tthǝ nyimmi ɓi lǝ ba ɓǝ kwɔ mǝrrǝm lǝ ba a nǝkwammu. Lankwoi, manungkwɔ ǝn gei kwɔ, ɓa dǝi matthǝ i bǝ nwongbǝi ɓǝ.<verse eid="2CO 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 9:4" />Manungkwɔni kwɔ, nǝ yayuu dang Makidoniya a wɔ suatha i ɓang wa tǝi angǝ ɓa yiɗi bǝ to nung akun lǝu, tthǝkku ɓi a dǝi nǝnǝ-ɓi gei ba tthǝkku ɓǝ lǝu-bǝ lǝ nungkwɔ lǝ ba a langǝ i ɓǝ ɓǝ!<verse eid="2CO 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 9:5" />Yang lakwɔ dǝmǝn nhǝm maɗing kwɔ ɓi gei ya dǝ ba a langǝ i tthǝ Fuh a osi a tǝ tthǝ ɓǝ yang bǝ i tǝ tǝi mab nunglǝi a tthasi kwɔ Fuh gei angǝ i mab ɓǝ. Yang a dǝi manung ɓǝ nǝ ǝn wuo ɗǝ, yang ɓa gei ɓi tthǝ ɓangǝ yang ɓa dǝ ǝn bakwɔ dǝɓa yiɗi bǝ dǝu ɓǝ, ǝn ba kwɔ tthǝ naɓǝ ɓǝ lǝu.<verse eid="2CO 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6" />Ɓa nhǝm yuu akwɔ nǝ bie nung tuab yang a ɓǝr nung tuab; langkwoi yuu akwɔ nǝ bie nung kpaatthǝ yang a ɓǝr nung kpaatthǝ. <verse eid="2CO 9:6" /><verse number="7" style="v" sid="2CO 9:7" />Ɓǝ nǝ kunkun bǝ dǝ nung, langkwoi, manungkwɔ ɓa nhǝm ɓǝ, i bǝ nhǝm tthasua lǝu langkwoi i bǝ tonungto lǝu; Fuh dǝna yiɗi yuu akwɔ dǝna dǝnung i tthǝla ɓǝ. <verse eid="2CO 9:7" /><verse number="8" style="v" sid="2CO 9:8" />Fuh a dǝɓǝ nung pǝl akwɔ dǝɓa yiɗi ɓǝ, yangbǝ vii ǝndǝi ɓa tǝi lǝ loɓǝ tthǝ langkwoi pǝl nungkwɔ dǝɓa yiɗi ɓǝ ǝndǝi. <verse eid="2CO 9:8" /><verse number="9" style="v" sid="2CO 9:9" />Manungkwɔ ba gi Fuh gei kwɔ,</para>
  <para style="q1" vid="2CO 9:9">&lt;&lt;U dǝlǝ yakwɔ ǝndǝi dǝna yiɗi ɓǝ;</para>
  <para style="q2" vid="2CO 9:9">bǝ yiɗi bǝi gu dǝi laɗing.&gt;&gt;<verse eid="2CO 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 9:10" />Yang Fuh, kwɔ dǝ bie nung lǝ ya nunglǝbi langkwoi dǝ burodi lǝ yakwɔ a tang kwɔ, a dǝɓǝ nungbie i nung bie langkwoi nungbie ɓǝ a ghaa a ilǝ nungtǝi ghaatthǝ. <verse eid="2CO 9:10" /><verse number="11" style="v" sid="2CO 9:11" />Vii ǝndǝi u mǝrrǝm ɓǝ lǝ ya nungtǝi lona ǝndǝi, yangbǝ yayuu kpaatthǝ dǝ angǝ a lǝ Fuh lǝ ba nungdǝ gi kwɔ i muu naɓi ɓǝ. <verse eid="2CO 9:11" /><verse number="12" style="v" sid="2CO 9:12" />Nung to kwɔ ɓa to kwɔ lǝng ba yayuu kwɔ dǝna to ba gi Fuh ɓuo ɓǝ lǝu, langkwoi a ilǝ ba gi Fuh lǝ yayuu tthǝ kpaatthǝ.<verse eid="2CO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 9:13" />Yang lakwɔ lǝ ba nung to kwɔ ɓa to kwɔ langkwoi wullǝ kwɔ, yayuu kpaatthǝ a dǝ angǝ a lǝ Fuh lǝ ba bǝ to nung a langǝ i ɓǝ lǝ Kristi, yang i nung kwɔ dǝɓa to ǝndǝi kwɔ dǝɓa to suatha i yakun ǝndǝi. <verse eid="2CO 9:13" /><verse number="14" style="v" sid="2CO 9:14" />Yang lakwɔ I pi ɓǝ nwa tthǝ lǝ ba nung a langǝ i kwɔ Fuh to ɓǝtthǝ ghaatthǝ ɓǝ. <verse eid="2CO 9:14" /><verse number="15" style="v" sid="2CO 9:15" />Ɓi kha Fuh lǝ ba nungkwɔ u dǝɓi ghaatthǝ kwɔ nwa ɓuan geiu ɓǝ!<verse eid="2CO 9:15" /></para>
  <chapter eid="2CO 9" />
  <chapter number="10" style="c" sid="2CO 10" />
  <para style="s">Bulus Ghai Ba Lo Nungto Gu</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1" />Ɓang, Bulus, dǝmǝn yam ɓǝ- Ɓang kwɔ i gei angǝ ǝn ya nyitǝmmim langkwoi muantthǝ kwɔ ɓang i ɓǝllǝ kwɔ. Kwoi nyitthǝ nǝ ǝn tutha i ɓǝllǝ. I kiggǝ a langǝ i i nung a langǝ i gi Kristi. <verse eid="2CO 10:1" /><verse number="2" style="v" sid="2CO 10:2" />Dǝmǝn yamɓǝ bǝ nǝ ǝn wuo bǝ ɓa tom ǝn ɓanglǝ dang wa thǝ; bakwɔ la langǝ i mǝn ɗablua yakwɔ gei angǝ dǝɓi to nung to i kiggǝ ya longwam ɓǝ.<verse eid="2CO 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 10:3" />Ən ba a langǝ i ɓi ǝǝ dang longwam, kwoi dǝɓi taɓui mangǝn ya longwam kwɔ lǝu. <verse eid="2CO 10:3" /><verse number="4" style="v" sid="2CO 10:4" />Nung taɓui kwɔ dǝɓi ɓuob lǝ vǝm kwɔ ǝn nung ɓuob vǝm ya longwam lǝu, kwoi ǝn nung taɓui Fuh a nyimmi, kwɔ dǝɓi tolǝ nung to bǝ drǝ bǝi a nyimmi. Dǝɓi dǝr ya nyimnwa pǝllǝ lǝ tha. <verse eid="2CO 10:4" /><verse number="5" style="v" sid="2CO 10:5" />Dǝɓi dǝr ya lǝi lo lag bo bǝikwɔ dǝna lǝi loi pǝll bǝ ibǝ nung gi Fuh ɓǝ; dǝɓi muo bǝ nhǝm ba gi lǝ thǝb ɓi mǝrrǝmǝi i muo ba gi Kristi.<verse eid="2CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 10:6" />Yang nǝ ɓa mab loɓǝ dǝɓa to nung a langǝ i, yang ɓi dǝ zui lǝ yakwɔ dǝna la ba nung a langǝ i ɓǝ.<verse eid="2CO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7" />Dǝɓa ɓyǝa nung a gwam ɓuo. Yakun tthǝ gwab angǝ i ǝn a bǝ Kristi? Yang i nhǝm ba loi i nailǝ, bakwɔ ɓi ǝn a bǝ Kristi manung gi ɓǝ. <verse eid="2CO 10:7" /><verse number="8" style="v" sid="2CO 10:8" />Ən lǝ tthǝkku, kwɔ mǝn lǝi lom ghaatthǝ lǝ ba tthǝnyimmi kwɔ Dangbang dǝɓi ɓǝ- tthǝnyimmi ba bǝ mai ɓǝ, akwɔ ɓi drǝ ɓǝ ɓǝlǝu. <verse eid="2CO 10:8" /><verse number="9" style="v" sid="2CO 10:9" />Bǝɓa survulli lǝ ba nungvullǝ kwɔ dǝmǝn vullǝ ɓǝtthǝ ɓǝthǝ.<verse eid="2CO 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 10:10" />Yuu akun a gei angǝ,&lt;&lt;Nungvullǝ gi Bulus zii ɗing langkwoi nyimɗing, langkwoi yang nǝ u i yayuu lǝ, yang tthǝu muan lǝ muan, yang langkwoi bagu ǝn nung akunlǝu!&gt;&gt; <verse eid="2CO 10:10" /><verse number="11" style="v" sid="2CO 10:11" />Yang yuu ɓǝkwɔ a ibǝi angǝ nung akun yangǝu lǝ ganglang nungkwɔ ɓi to dang nungvullǝ kwɔ nǝɓi yangǝu tthang ɓǝu i nungkwɔ ɓi to nǝ ɓi tthangɓǝ ɓǝ.<verse eid="2CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12" />Ɓi nhǝm bǝ nalo ɓi ko ɓi dǝlo ɓi natha i ya kwɔ dǝna lǝi loi ghaatthǝ ɓǝu. I ǝnya sullǝ! Dǝnni pǝl tha, langkwoi dǝnni to kwanlǝ loi tthǝ natha!<verse eid="2CO 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 10:13" />Manung aɓi, ɓi nyimtthǝ ɓi tthǝ nungkwɔ bǝ nyimtthǝ ɓi tǝ manung kwɔ niu; a dǝi tthǝ nungto kwɔ Fuh mab ɓi nunglǝi bǝ tou tthǝ ɓǝ, langkwoi gǝm i nungto ɓi kwɔ ganglang ɓǝlǝ ɓǝ. <verse eid="2CO 10:13" /><verse number="14" style="v" sid="2CO 10:14" />Lakwɔ ɓǝ dang nungto ɓǝlǝ, dǝɓi tǝ bǝ pǝl lo nungto kwɔ ɓi wuo sua ɓǝ lǝ bko ɓǝ lǝu, ɓi wullǝ ǝn ba a langǝ i gi Kristi.<verse eid="2CO 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 10:15" />Nung kwɔ ɓi nyimtthǝ ɓi lǝ ba nung to kwɔ yakun to pǝl nungkwɔ Fuh gei angǝ i to ɓǝlǝu. Manungkwɔni yang, dǝɓi dǝ nyitthǝ bǝ dǝ ba a langǝ i ɓǝ lko a ghaa yang ɓi to nung to ghaatthǝ dang ɓǝ, dǝilo nungkwɔ Fuh gei angǝ i toɓǝ.<verse eid="2CO 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 10:16" />Yang ɓi gei ba gi Fuh losua akun tthǝ tthasi ɓǝ langkwoi i lǝi loi ghaatthǝ lǝ ba nung to kwɔ i lǝ yakun tthǝ losua gi ɓǝu.<verse eid="2CO 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 10:17" />Kwoi manungkwɔ ba gi Fuh gei kwɔ,&lt;&lt;yuu kwɔ nǝ dǝna yidɗi bǝ lǝilo yang lǝilo lǝ ba nungkwɔ Dangbang toɓǝ.&gt;&gt;<verse eid="2CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 10:18" />Bakwɔ nǝ ǝn Dangbang nhǝm ba matthǝ lǝ baɓi yang ǝn ba a langǝ i Fuh gwab ɓi tthǝng, langkwoi ǝn bakwɔ ɓi nhǝm ba matthǝ lǝ loɓi tthǝ ɓǝlǝu.<verse eid="2CO 10:18" /></para>
  <chapter eid="2CO 10" />
  <chapter number="11" style="c" sid="2CO 11" />
  <para style="s">Bulus I Ya Nwatummi Pǝllǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1" />Dǝmǝn nhǝm ɓa gwabǝm tthǝng, ko kwɔ dǝmǝn ɓyǝa ǝn to sullǝng tuab, dǝmǝn yam ɓa to! <verse eid="2CO 11:1" /><verse number="2" style="v" sid="2CO 11:2" />Dǝmǝn tobǝ loɓǝ, Manungkwɔ Fuh i nko lǝ dǝna to ɓǝ; ɓa natha i yamsi a langǝ i kwɔ ǝn geigǝ mǝn duu lǝ yiɓǝi akun a dǝb ɓǝ, ǝn Kristi i nko lǝ. <verse eid="2CO 11:2" /><verse number="3" style="v" sid="2CO 11:3" />Dǝmǝn survulli kwɔ dang nyiɓǝ lko a lǝi bǝ tang ǝn gǝgam langkwoi ɓa al bǝto ba gi Kristi a langǝ i lǝtǝ manungkwɔ biǝk kwɔ ɗam Hawwa'u i yiggǝi lǝɓǝ.<verse eid="2CO 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 11:4" />Lakwɔ dǝɓa gwab yakun kwɔ dǝna wɔ sua ɓǝ dǝnni gei ɓǝ ba gi Yeso akun tthǝ, kwɔ ǝn a kwɔ ɓi gei ɓǝ tthǝ ɓǝlǝu i tthǝla; langkwoi ɓa muo ɓyang i bakwɔ i gei kwɔ ǝndǝi nungkun kwɔ ǝn ba Ɓyang i ba a langǝ i kwɔ ɓa muo naɓi ɓǝlǝu!<verse eid="2CO 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 11:5" />Ən nhǝm kwɔ ǝn geigǝ ɓang lǝ atuab dang yakwɔ dǝɓa gei ɓangǝ i ǝn&lt;&lt; ya nwatummi&gt;&gt;ɓǝ ɓǝlǝu! <verse eid="2CO 11:5" /><verse number="6" style="v" sid="2CO 11:6" />Lko yakun ǝn nyim dang bǝ geiba lǝu, kwoi manungɓǝ dang bǝ ibǝ nung; ɓi gei ɓǝ nungkwɔ tthǝ lona kwɔ ǝndǝi i dang nung ǝndǝi.<verse eid="2CO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7" />Ən muo ɓǝ ɓa kwai nung akun lǝu lǝ bakwɔ dǝmǝn gei ɓǝ ba gi Fuh a langǝ i tthǝɓǝ; Ən li lom sua yangbǝ ɓa mǝrrǝm lǝ ya angǝ a. Ən nung a ɓko ǝn toh?<verse eid="2CO 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 11:8" />Kwɔ dǝmǝn to nung to dang ɓǝ kwɔ, ya kǝm pinwa yakun dǝna kwaim. Dǝmǝn muo nungdǝ nailǝ, yangbǝ ǝn nwong ɓǝlǝ.<verse eid="2CO 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2CO 11:9" />Langkwoi vii kwɔ i lona kwɔ ɓang i ɓǝkwɔ ǝn gib nung ɓǝ lǝba ɓa nwongǝm nǝ dǝmǝn yidɗi nungkurɓǝ lǝu; ya dǝba a langǝ i kwɔ wuo Makidoniya kwɔ wumlǝ nung tthǝ ǝndǝi kwɔ dǝmǝn yidɗi ɓǝ. Manung vii a tthasua, i a tthasi: ǝn mǝrǝm lǝ gong nung a ɓuoni tthǝ ɓǝu!<verse eid="2CO 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 11:10" />Lǝ ba gi Kristi a langǝ i kwɔ tthǝm kwɔ, ǝn gwab nwang bǝ lǝilom kwɔ i ɓuan i lam nwammu dang Akaya ǝndǝi.<verse eid="2CO 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 11:11" />Dǝɓa gei bakwɔ dǝɓa ɓyǝa ǝn yiɗi ɓǝ lǝu? Fuh ibǝing dǝmǝn yiɗi ɓǝ! <verse eid="2CO 11:11" /><verse number="12" style="v" sid="2CO 11:12" />Mǝn dǝinwa bǝ to nung to kwɔ dǝmǝn to lakwɔ ɓǝ, yang bǝ&lt;&lt;ya nwatummi kwɔ&gt;&gt; tǝi ba akwɔ a nyimtthǝi tthǝ langkwoi a gei angǝ dǝnni to nung to manung a ɓi kwɔ dǝɓi to ɓǝlǝu.<verse eid="2CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 11:13" />Yaɓǝi kwɔ ǝn ya nwatummi a langǝ i lǝu-i ǝn ya nwatummi ya pǝllǝ, dǝnni kǝbpǝllǝ i nung to gi langkwoi i lǝi loi yangbǝ i ɓyǝa angǝ i ǝn ya nwatummi gi Kristi a langǝ i. <verse eid="2CO 11:13" /><verse number="14" style="v" sid="2CO 11:14" />To, nung fǝmlo yangǝu dang ǝu! Mungkullum i nko a lǝi lo yang i ɓyǝko angǝ i ǝn ya nwatummi gi Fuh!<verse eid="2CO 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 11:15" />Yang ǝn nung angǝ a lǝu nǝ thǝb gi mungkullum lǝi loi yangbǝ i ɓyǝa angǝ i ǝn thǝb a langǝ i. Tthasua ǝndǝi yang i tǝi nungkwɔ nungto gi a ji ɓǝ.<verse eid="2CO 11:15" /></para>
  <para style="s">Zuii Gi Bulus Tthǝ Bǝ To Nwatummi</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16" />Mǝn gei ba akun: yuu yangǝu a gei angǝ ɓang ǝn ya sullǝ. Kwoi nǝ dǝɓa gei yang, ɓa lǝim lǝ ya sullǝ, manungkwɔni yang mǝn tǝi nung tuab kwɔ mǝn to lǝ tthǝnyimmi ɓǝ.<verse eid="2CO 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 11:17" />Ən ba a langǝ i nungkwɔ dǝmǝn gei lakwɔ kwɔ ǝn nungkwɔ Dangbang a gei angǝ ǝn gei ɓǝ lǝu; lǝ ba bǝ tonung i tthǝnyimmi kwɔ dǝmǝn gei ba mangǝ ǝn ɓang ya sullǝ. <verse eid="2CO 11:17" /><verse number="18" style="v" sid="2CO 11:18" />Kwoi kwɔ lakwɔ yayuu kpaatthǝ dǝna tonung nyimtthǝ i tthǝ nyimmi gi thayuu, yang mǝn to manung ɓǝ.<verse eid="2CO 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 11:19" />Ɓǝ i naɓǝ ɓǝ ǝnya yiggǝi, yang nǝni yang i tthǝla ɓa yiǝ ya sullǝ. <verse eid="2CO 11:19" /><verse number="20" style="v" sid="2CO 11:20" />Ɓa gwab lǝ yuu akwɔ tthǝ mǝrrǝm ɓǝlǝ thǝb yang ɓa kǝrru tthǝ nǝ u muo nung naɓǝ i ttha ko u lǝi lo angǝ i pǝl ɓǝng ko u ɓuob dang nung ɓǝ ina. <verse eid="2CO 11:20" /><verse number="21" style="v" sid="2CO 11:21" />Dǝmǝn lǝ tthǝkku langkwoi ǝn gwab ǝn muanɗing kwɔ mǝn tonung kwɔ ɓǝ!</para>
  <para style="p" vid="2CO 11:21">Kwoi nǝ yuu akun dǝna yidɗi bǝ tonung kwɔ i tthǝnyimmi-dǝmǝn gei ba mangǝ ɓang ǝnya sullǝ-mǝn ǝǝ manung kwɔni. <verse eid="2CO 11:21" /><verse number="22" style="v" sid="2CO 11:22" />I ǝn ya yahudawa? Ɓang langɓǝ manung ɓǝ. I ǝn ya Israila? Ɓang langɓǝ manung ɓǝ. I ǝn ya bǝba Ibrahim ma? Ɓang langɓǝ manung ɓǝ. <verse eid="2CO 11:22" /><verse number="23" style="v" sid="2CO 11:23" />I ǝn ya thǝb gi Kristi? Ən ǝǝ mangǝ ɓang ya nung lo-kwoi ǝn ɓang lǝ ya thǝb kwɔ ǝn pǝlli ɓǝ! Dǝmǝn to nung to ghaaɗing, i muom pursǝna lona kpaaɗing, i ɓuom ɗing, vii ǝndǝi ǝn gbag bǝ ɓui ɓua.<verse eid="2CO 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2CO 11:24" />Lona ni nu ya yahudawa dǝna ɓuom i thab lǝ na thǝmkun oli iu nai;<verse eid="2CO 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2CO 11:25" />lona tai ya Romawa dǝna ɓuom i thab; vii akun i wam i tal. Bo tai kwai dǝna d̃amlǝ, vii akun ǝn to lona thǝmkun iu nai lo mung. <verse eid="2CO 11:25" /><verse number="26" style="v" sid="2CO 11:26" />Dang bǝ thko bom kpaatthǝ ǝn to zuii lo mungɓuommi i ya muo nunglǝ ttha na yayuu, ǝn to zuii na yayuum i na yakwɔ ǝn ya Yahudawa lǝu ɓǝ; nung ɓua kpaaɗing gwoi angǝ a, zuii dang gug, zuii lo mung nwam angǝ a, langkwoi zuii na ya ǝnthǝm ya pǝllǝ.<verse eid="2CO 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2CO 11:27" />Ən to nung to i tthǝ zii i zuii lǝ; vii yakun ǝn lo nung lou; ǝn lǝ gwom i ɗimung; vii yakun ǝntǝi nungtang la langǝ iu, i nungku, i nunglitthǝ. <verse eid="2CO 11:27" /><verse number="28" style="v" sid="2CO 11:28" />Yangbǝ ǝn gei sua ba ɓǝ thǝ, vii ǝndǝi ɓang dang bǝ nhǝm ba lo ba kǝm pinwa ǝndǝi. <verse eid="2CO 11:28" /><verse number="29" style="v" sid="2CO 11:29" />Kwɔ nǝ tthǝ yuu akun muan, yang langkwoi to tthǝm dǝna muan langɓǝ; langkwoi nǝ yuu akun tǝ dang nung a ɓko, yang dǝmǝn lǝ ba zii bǝi.<verse eid="2CO 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30" />Nǝmǝn lǝilom, yang mǝn lǝilom tthǝ nungkwɔ dǝna tanatthǝ tthǝ muanim ɓǝ. <verse eid="2CO 11:30" /><verse number="31" style="v" sid="2CO 11:31" />Fuh langkwoi Daa gi Dangbang Yeso khana lo ɗuǝnnu laɗing! Ibǝing angǝ dǝmǝn kǝb ǝn pǝllǝ lǝu.<verse eid="2CO 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2CO 11:32" />Kwɔ ɓang dang Dimaska kwɔ, gwamna kwɔ dǝna to nung to yigwoi Aretis kwɔ dǝ ya ki nwalǝgwoi gwoi angǝ a angǝ tǝi mum.<verse eid="2CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2CO 11:33" />Nungkwɔ i lim dang kaɗuog i imlǝ nwaɓua gwu kǝm lǝ ǝn surr ǝnpa nko lǝ.<verse eid="2CO 11:33" /></para>
  <chapter eid="2CO 11" />
  <chapter number="12" style="c" sid="2CO 12" />
  <para style="s">Muanni Gi Bulus</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1" />Mǝn lǝilom, ko to nung akun matthǝ lǝu. Kwoi lakwɔ mǝn gei ba lo muani i nungkwɔ Dangbang geimtthǝ angǝ dǝna wɔ ɓǝ. <verse eid="2CO 12:1" /><verse number="2" style="v" sid="2CO 12:2" />Ən ibǝi yiɓǝi ya Krista a kuntthǝ kwɔ ttha sob iu nai kwɔ pa kwɔ i lǝiu i tǝlǝ wayi kullo (Ən ibǝi ko ǝn ba langǝ i i lǝiu i tǝlǝ waying i ttha kristi, ko ǝn muonni-ǝn Fuh ɓuo ibǝi). <verse eid="2CO 12:2" /><verse number="3" style="v" sid="2CO 12:3" />Mǝn gei akun, ǝn ibǝi yiɓǝi kwɔ i lǝiu i tǝlǝ ɗǝgsi Fuh (langkwoi, ǝn ibǝi ko ǝn ba a langǝ i to manungɓǝ ko ǝn muani-ǝn Fuh ɓuo ibǝi), <verse eid="2CO 12:3" /><verse number="4" style="v" sid="2CO 12:4" />yang ǝn bǝi ɓǝkwɔ u lǝ nungkwɔ i gei i ba nwuo, ǝn nungkwɔ sual nwa yuu lko gei ɓǝ.<verse eid="2CO 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 12:5" />Yang mǝn lǝi lom lǝ ba yiɓǝi kwɔ-kwoi ǝn lǝi lom lǝ ba lom i nammu, tthǝn tthǝ nungkwɔ a tanatthǝ tthǝ muanim ɓǝ. <verse eid="2CO 12:5" /><verse number="6" style="v" sid="2CO 12:6" />Nǝ dǝmǝn yiɗi bǝ lǝi lom, yang ɓang ǝn ya sullǝ lǝu, bakwɔ dǝmǝn gei ǝn ba a langǝ i ɓǝ. Kwoi ǝn lǝi lommu, bakwɔ ǝn yiɗi yuu akun dang ɓǝ lǝi dang wko lǝ ghaatthǝ lǝ bam manungkwɔ ɓa lǝi lo nungkwɔ ɓa ɓim ǝn to i akwɔ ɓa ɓyǝa i akwɔ ɓa lǝm ǝn gei ɓǝ.<verse eid="2CO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 12:7" />Kwoi yangbǝ bǝ ǝn fuk i bǝ lǝilom lǝba nungfǝmlo kpaatthǝ kwɔ ǝn ɓyǝa ɓǝthǝ, kwɔ dǝm nungzii akun tthǝ kwɔ mǝrǝmlǝ nung akun tthǝ tthǝm lǝɓǝ, kwɔ mǝrǝm mangǝn ya nwatummi gi mungkullum ɓuom yangbǝ bǝ ǝn lǝilom thǝ. <verse eid="2CO 12:7" /><verse number="8" style="v" sid="2CO 12:8" />Lona tai dǝmǝn pinwa tthǝ Dangbang lǝ ba nungkwɔ langkwoi ǝn yammu yangbǝ u lǝi nungkwɔ u palǝ. <verse eid="2CO 12:8" /><verse number="9" style="v" sid="2CO 12:9" />Kwoi bǝ gwab nwa gu angǝ,&lt;&lt;Ba nung a langǝ im ǝn nungɓǝ dǝma yiɗi, bakwɔ ttham lǝ angǝ a kwɔ nǝ tthǝmmǝ muan ɓǝ,&gt;&gt;Ɓanglǝ ya lǝ tthǝla, yang, kwɔ mǝn lǝilom lǝ ba tthǝ muanim ɓǝ, yangbǝ ǝnlǝ ttha bǝ nwongbǝi gi Kristi lom lǝ. <verse eid="2CO 12:9" /><verse number="10" style="v" sid="2CO 12:10" />Loggǝm i tthǝ muanni, bǝ dal bǝi, zuii, i nyoabǝi, tthǝzii lǝ ba Kristi. Kwɔ nǝ tthǝm muan, yang tthǝm nyimtthǝ.<verse eid="2CO 12:10" /></para>
  <para style="s">Bǝ Tobǝ Lo Gi Bulus Lo Ya Korantiyawa</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11" />Dǝmǝn tonung mangǝ ɓang ǝnya sullǝ-kwoi ǝnɓǝ ɓa tom ǝnto ni. Ən ɓǝlǝ yakwɔ kaso ɓa gei nung a langǝ im ɓǝ. Konǝ ɓang ǝn nung akunlǝu, &lt;&lt;ya nwatummi ɓǝ kwɔ&gt;&gt; pǝllǝm lǝu<verse eid="2CO 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 12:12" />I nung fǝmlo i nungdǝ tthǝvulli kwɔ ǝn to kpaatthǝ kwɔ gei ɓǝtthǝ angǝ ɓang ǝn ya nwatummi gi Kristi kwɔ to nung to ganglang ɓǝ i bǝ tthǝbnyitthǝ.<verse eid="2CO 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 12:13" />Ən nunglǝi a nwuo ɓa kwoi tthasua ɓa pǝll sua ya kǝm pinwa, bakwɔ ǝn gibnung ɓǝlǝ ba nungkurɓǝ lǝu ɓa? Dǝmǝn yamɓǝ ɓa al nung a ɓkom lǝtǝ.<verse eid="2CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14" />Lakwɔ ǝn lona a tai kwɔ dǝmǝn yiɗi bǝ tǝ suaɓǝ-langkwoi ǝn ɗu nung akun naɓǝu. Ənɓǝ dǝmǝn yiɗi, ǝn nungkurɓǝ ɓǝ lǝu. Kwoi ǝn yathang a ɗuu nung lǝ ya Daa tthǝ lǝu, kwoi ǝn ya Daa a dǝ nung lǝ yathang gi tthǝ. <verse eid="2CO 12:14" /><verse number="15" style="v" sid="2CO 12:15" />Dǝmǝn lǝ tthǝ la kwɔ mǝn thǝb nungkwɔ nam lǝ ǝndǝi, i ɓuitthǝm lǝ langɓǝ, yangbǝ ǝn nwong ɓǝ lǝ. Ɓa yiɗim tuab lǝ bakwɔ dǝmǝn yiɗi ɓǝ ghaatthǝ ɓa?<verse eid="2CO 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 12:16" />Ɓa gungwab, yang, ɓangǝ ɓang ǝn ya dǝɓǝ zui lǝu. Kwoi yuu akun a gei angǝ ɓang ǝn ya ɗambǝi, kwoi dǝmǝn muoɓǝ i pǝllǝ.<verse eid="2CO 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 12:17" />Nǝnǝtǝn? Ən lǝi nung akun naɓǝ tthǝ ya nwatummi kwɔ dǝm tumɓa?<verse eid="2CO 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 12:18" />Ən yam Titus tǝ suaɓǝ, kwoi ǝn tog ya dǝ ba a langǝ i akun sua tha i ulǝ. Ko dǝɓa gei ɓangǝ Titus toɓǝ nung to tthǝ lǝu? U i ɓanglǝ ɓi tǝ suaɓǝ i nung akun ɓi to nung to nathǝ lǝu?<verse eid="2CO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19" />Lkolakwɔ dǝɓa nhǝm ɓangǝ dǝɓi tonungkwɔ yangbǝ ɓi nwonglǝ loɓi ɗǝgsi ɓa. Nilǝu! Dǝɓi gei manungkwɔ Kristi dǝna yidɗi ɓi gei ba gu ɗǝgsi Fuh ɓǝ, langkwoi nungkwɔ ǝndǝi ɓi to kwɔ, ya ǝnthǝ ɓi, dǝɓi to yangbǝ ɓi nwong ɓǝ. <verse eid="2CO 12:19" /><verse number="20" style="v" sid="2CO 12:20" />Dǝmǝn survulli lakwɔ nǝn tǝ tthang ɓǝ yang tǝmǝn tǝiɓǝ ɓa natha i nungkwɔ kaso ɓa ǝǝ ɓǝlǝu langkwoi ɓa tǝim natha i nungkwɔ dǝɓa yiɗi kaso mǝn ǝǝ ɓǝlǝu. Dǝmǝn survulli tǝmǝn tǝi bǝ kwatha i bǝ tthǝngtha, i dang wa a ɓko i bǝ yiɗi lo, dǝɓa daltha i bǝ gum tthǝ tha, lo angǝ a i bǝ ɓanglǝ nung. <verse eid="2CO 12:20" /><verse number="21" style="v" sid="2CO 12:21" />Dǝmǝn survulli nǝ mǝn tǝ akun Fuh wa dǝm tthǝkku dang nung ɓǝ, yang mǝn tasui lǝ ba yayuu kpaatthǝ kwɔ to nung a ɓko tthasua yang langkwoi i mǝrrǝm i yitthǝ nung a ɓko kwɔ i to lǝu ɓǝ-bǝ to ilak nung i bǝ lo i yasi yayuu lǝ.<verse eid="2CO 12:21" /></para>
  <chapter eid="2CO 12" />
  <chapter number="13" style="c" sid="2CO 13" />
  <para style="s">Bǝ Gubɗogsui I Bǝ Gumbǝi A Nǝsua</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1" />Lakwɔ ǝn lona a tai kwɔ dǝmǝn wuo suaɓǝ ɓǝ,&lt;&lt;Nǝ nung akun tthǝ yang ɓi lǝ nwa ya shǝdǝ rab ko pǝl&gt;&gt; manungkwɔ ba gi Fuh geiɓǝ. <verse eid="2CO 13:1" /><verse number="2" style="v" sid="2CO 13:2" />Dǝmǝn yiɗi bǝ gei lǝ yakun ɓǝtthǝ kwɔ to nung a ɓko tthasua kwɔ, i sua yakwɔ ǝndǝi; Ən geing vii kwɔ ǝn wuo suaɓǝ a nung rabbu ɓǝ, kwoi mǝn gei ɓǝtthǝ langkwoi lakwɔ Ən yangǝu tthang ɓǝu ɓǝ: nǝ lona akun nǝ ǝn kwoi ǝn wuo yang yuu akun yangǝu a i dang bǝ ɗablua bǝiu.<verse eid="2CO 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 13:3" />Ɓalǝ nungkwɔ ǝndǝi kwɔ Kristi gei ba nwamlǝ ɓǝ. Kwɔ nǝ u ɗablua ɓǝ, u muan lǝu; manungkwɔni yang, u taɓǝ natthǝ ttha gu ganglang ɓǝ. <verse eid="2CO 13:3" /><verse number="4" style="v" sid="2CO 13:4" />Bakwɔ manungkwɔni kwɔ tthǝn tthǝ ɓuob lo sua nungkwɔ i tǝulǝ lo kab gangǝ i tǝu ɓui ɓua, ǝn ttha gi Fuh nungkwɔ u tǝi nwongǝi. Dangtha i ulǝ ɓi langɓǝ nungkwɔ ɓi ɓuob lo ɓi sua; kwoi tthǝ bǝpi ɓi i ɓǝ ɓi gab tha gi Fuh i nwongǝi gu.<verse eid="2CO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5" />A na lomǝ langkwoi ato kwan lǝ lomǝ tthǝ, ko a ǝǝ dang bǝ dǝ nyitthǝ nung. Ba langǝ i a ibǝi Kristi Yeso tthǝmǝlǝ?A ong laɗing. <verse eid="2CO 13:5" /><verse number="6" style="v" sid="2CO 13:6" />ǝn dǝ ba a langǝ i ɓa ibǝi ɓi ǝn ya kwɔ o bǝ nabǝi ɓǝ.<verse eid="2CO 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 13:7" />Dǝɓi pinwa tthǝ Fuh yangbǝ bǝɓa to nung a ɓko thǝ-ǝn bakwɔ yangbǝ i tanatthǝ angǝ ɓi tang long lǝu, kwoi yangbǝ ɓa to nungkwɔ lǝ nung a langǝ i ɓǝ, ko lko i ɓyǝa angǝ ɓi ǝn ya o bǝ nabǝi ɓǝ.<verse eid="2CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 13:8" />Lakwɔ ɓi la ba a langǝ iu, kwoi vii ǝndǝi muo sua ba a langǝ i. <verse eid="2CO 13:8" /><verse number="9" style="v" sid="2CO 13:9" />Dǝɓi lǝ tthǝla kwɔ tthǝ ɓi muantthǝ yang tthǝmǝ nyimtthǝ ɓǝ. Yang langkwoi dǝɓi pinwa yangbǝ ɓa mǝrǝm matthǝ.<verse eid="2CO 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 13:10" />Ən ba ɓǝkwɔ nungkwɔ ǝn vullǝ ɓǝ nung tthǝ kwɔ ǝn yangǝu tthang ɓǝu ɓǝ; manungɓǝni yang kwɔ nǝ ǝn wuo yang ǝn to iɓǝlǝ dang nyi dang bǝ to nung to i ttha kwɔ Dangbang dǝm ɓǝ-ttha kwɔ mǝn mab ɓǝɓǝ, ǝn akwɔ mǝn trǝ ɓǝ ɓǝlǝu.<verse eid="2CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11" />Yang lakwɔ, ya ǝnthǝm, ɓi- gabtha! Ɓa ɗu bǝ to nung a langǝ i; ɓa dǝ kiggǝ ɓǝ babǝ yam bǝim; ɓa ǝǝ dang bǝ lǝ tthǝla. Yang Fuh ya yiɗi bǝi i bǝ dǝ tthǝla a ǝǝ iɓǝ.<verse eid="2CO 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 13:12" />Ɓa gumtha i bǝ gumtha a langǝ i.</para>
  <para style="p" vid="2CO 13:12">Yayuu gi Fuh ǝndǝi dǝna gum ɓǝ. <verse eid="2CO 13:12" /><verse number="13-14" style="v" sid="2CO 13:13-14" />Nung a langǝ i gi Dangbang Yeso Kristi, i bǝ yiɗi bǝi gi Fuh, i bǝ kǝbtha lo gi Ɓyang a Langǝ i ǝǝ iɓǝlǝ ǝndǝi.<verse eid="2CO 13:13-14" /></para>
  <chapter eid="2CO 13" />
</usx>