<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">3 Yohanna</para>
  <para style="toc1">Nungvullǝ Gi YOHANNA A Tai</para>
  <para style="toc2">3 Yohanna</para>
  <para style="toc3">3 Yo</para>
  <para style="mt2">Nungvullǝ A Tai Gi</para>
  <para style="mt1">YOHANNA</para>
  <para style="imt">Bǝ Gabnung</para>
  <para style="ip">
    <char style="bk">Nungvullǝ A Tai Gi Yohanna </char> ǝn &lt;&lt;yikku&gt;&gt;kǝm pinwa kwɔ dǝnni lu angǝ Gayus kwɔ vullǝ. Ya vullǝ nung ɓǝ kha Gayus babǝ nwong ya Kristǝ, langkwoi u gub ɗuogsui yayuu ba yiɓǝi kwɔ dǝnni lu angǝ Diyotarifis ɓǝ.</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1. </char>
      <char style="xt" closed="false">Ac 19.29; Ro 16.23; 1 Co 1.14</char>
    </note>Bǝgǝ yakku</para>
  <para style="p" vid="3JN 1:1">Sua Gayus kwɔ dǝm yiɗi niɓǝ, yuu akwɔ dǝmǝn yiɗi la langǝ i ɓǝ.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />Ənthǝm kwɔ dǝm yiɗi niɓǝ, dǝmǝn pinwa geigǝ nung ǝndǝi ǝǝtthǝ matthǝ langkwoi kaso a ǝǝ i tthǝla- manung kwɔ ǝn ibǝi mǝ dang ɓyang ɓǝ. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Tthǝm la ǝndǝi kwɔ yakun dang ya young ɓi Kristǝ wuo langkwoi i geim bǝdǝ nyitthǝ mǝ tthǝ ba a langǝ i- manungkwɔ vii ǝndǝi dǝma ǝǝ dang ba a langǝ i ɓǝ. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Nung akun yangǝu dǝna dǝm tthǝla pǝll kwɔ mǝn lǝ angǝ yathangǝm dǝna ǝǝ dang ba a langǝ i ɓǝ.<verse eid="3JN 1:4" /></para>
  <para style="s">I Kha Gayus</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Ya youngǝm kwɔ dǝm yiɗi niɓǝ, dǝɓa to nung to lǝ ba ya Kristǝ akun i bǝ dǝnyitthǝ, ko kwɔ i ǝn yayol ɓǝ. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />I gei ba lǝ ya kǝm pinwa bǝi kwɔ lǝba bǝ yiɗi bǝi ɓǝ. Dǝmǝn yamɓǝ ɓa nwongǝi i lilotthǝ thko gi nunglǝi kwɔ Fuh a lǝtthǝ laɓǝ. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Bakwɔ i palǝi thko kwɔ dang nung to gi Kristi i muo nung akun lǝu na yakwɔ dǝba a langǝ i tthǝ Fuh lǝu ɓǝ. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Ɓi ya Kristǝ, yang, ɓi nwong yayuu kwɔ, yangbǝ ɓi to nung to i ilǝ lǝba ba a langǝ i.<verse eid="3JN 1:8" /></para>
  <para style="s">Diyotarifis I Dǝmitris</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Ən vullǝ nungvullǝ tuab sua ya kǝm pinwa; kwoi Diyotarifis, yuu akwɔ dǝna yidɗi bǝ ǝǝlǝ yikku gi kwɔ, u kab ɓuasui tthǝ nungkwɔ dǝmǝn gei ɓǝu. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Nǝ ǝn wuo, yang, mǝn wuolǝ nung ǝndǝi kwɔ u toɓǝ: nung aɓau kwɔ u gei loɓi langkwoi i pǝllǝ kwɔ u kǝb ɓǝ, Kwoi loggǝu lǝu; u kǝblo ya young ɓi kwɔ nǝ i tǝgwoi gu ɓǝ, langkwoi u dǝu nan yakwɔ dǝna yidɗi bǝ kǝbloi langkwoi dǝu yiɗi bǝ nanni kǝm pinwa lǝ!<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Ənthǝm kwɔ dǝm yiɗi niɓǝ, bǝ a na nung aɓau thǝ, kwoi a na nungkwɔ ǝn a langǝ i ɓǝ. Yuu akwɔ nǝ to nung a langǝ i ǝn a bǝ Fuh; yuu akwɔ nǝ to nung aɓau yang ɓyǝa Fuh ǝu.<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />Yayuu ǝndǝi gei ba a langǝ i lo Dimitiriyas; ba a langǝ i i nkolǝ gei ba maɗing lolǝ. Langkwoi dǝɓi lilo i ba ɓi, langkwoi ɓa ibǝing nungkwɔ dǝɓi gei kwɔ ǝn ba a langǝ i.<verse eid="3JN 1:12" /></para>
  <para style="s">Bǝ Alo Bǝ Gumbǝi</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Ɓangtthǝ i nung kpaaɗing kwɔ dǝmǝn yiɗi bǝ gei tthǝɓǝ, kwoi ǝn yiɗi bǝ vullǝu i mung yǝng nungvullǝ nung lǝu. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />Dǝmǝn dǝnyitthǝ bǝ ɓyǝa ɓǝ nǝnǝng kwɔ, langkwoi yang ɓi gei ba nwa i nwalǝ.<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />Bǝ ǝǝ a langǝ i i mǝ.</para>
  <para style="p" vid="3JN 1:15">Ya ǝnthǝmǝ ǝndǝi dǝna gumbǝi. A gum ya ǝnthǝ ɓi bǝilǝ ǝndǝi.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>