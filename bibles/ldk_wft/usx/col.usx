<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">KOL - MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">Kolosiyawa</para>
  <para style="toc1">Nungvullǝ Gi Bulus Sua Ya KOLOSIYAWA</para>
  <para style="toc2">Kolosiyawa</para>
  <para style="toc3">Kol</para>
  <para style="mt2">Nungvullǝ Gi Bulus Sua Ya</para>
  <para style="mt1">KOLOSIYAWA</para>
  <para style="imt">Bǝ Gabnung Ba</para>
  <para style="ip">
    <char style="bk">Nungvullǝ Gi Bulus Sua Ya Kolosiya </char> i vullǝ sua ya kǝm pinwa Kolosiya, gwoi angǝ dang Asiya Atuab gwɔpi i Afisu. Ya kǝm pinwa kwɔ ǝn Bulus bkoi lǝu, kwoi tthǝn bǝikwɔ Bulus dǝna ɓyǝa i tonungto tthǝ ɓǝ, kwɔ u tum ya nungto ǝrr Afisu, gwoi angǝ a losua Roma dang Asiya. Bulus lǝ angǝ ya nanatthǝ nung pǝllǝ dang kǝm pinwa Kolosiya kwɔ dǝnni nyari angǝ nǝma i Fuh a tǝi bǝ nwonglo ǝndǝi yang yuu a wab &lt;&lt;ya dǝ kab nwa nung ɓyang a kuntthǝ.&gt;&gt;Langkwoi, ya nanatthǝ nung kwɔ gei angǝ, ma to i nungto a kun a langǝ i mangǝn i bǝ ɓǝrnwa ɗuǝ langkwoi ma tonungto i zuu a kuntthǝ nyimtthǝ ba nungtang i sua ba akun.</para>
  <para style="ip">Bulus vullǝ nungkwɔ yangbǝ yǝrnwa bǝ nanatthǝ nungkwɔ yangbǝ u nanatthǝ ya Krista a langǝ i. Bǝ gwabnwa gu nungɓǝlǝ Yeso Kristi a ɓuan a dǝ bǝ nwonglo ǝndǝi langkwoi sua bǝ dǝnyitthǝ kwɔ i sua nungto kwɔ lalangǝ i dǝna kwoilǝ yayuu lǝ tthǝ Fuh. Tthǝ Kristi, Fuh mab longwam langkwoi tthǝulǝ dǝu kwoilǝ longwam dǝu wulǝ tthǝu. Dang bǝ kǝptha i Kristi ɓuo bǝ nyi nwonglo lo longwam. Nungkwɔ Bulus gei ba lo gong bǝ nanatthǝ nungkwɔ ba nwongǝi ya dǝba a langǝ itthǝ.</para>
  <para style="ip">Ən nung ibǝi kwɔ Takikus, kwɔ lǝi nungvullǝ gi Bulus kwɔ tǝllǝ sua ya Kolosiya kwɔ, Onisimos du sua, thǝb kwɔ vullǝ nung lǝ nwathan Bulus ɓǝ<char style="bk">Filiman </char>.</para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />Ɓang Bulus, ibǝ yiɗi gi Fuh lǝ ya nwatummi Kristi Yeso, langkwoi bǝgǝ young ɓi Timitawos<verse eid="COL 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 1:2" />Dǝɓi tumbǝi i nungvullǝ kwɔ suaɓǝ yayuu gi Fuh gwoi angǝ a Kolosi, kwɔ lǝya ǝnthǝ ɓi a langǝ i dang bǝ kǝbtha lo i Kristi ɓǝ:</para>
  <para style="p" vid="COL 1:2">Kaso Fuh Daa ɓi dǝɓǝ nung a langǝ i i bǝ ǝǝ tǝmmi.<verse eid="COL 1:2" /></para>
  <para style="s">Bǝ Pinwa Ba Bǝ Kha Fuh</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />Vii ǝndǝi dǝɓi kha Fuh, Daa gi Dangbang ɓi Yeso Kristi, kwɔ nǝ dǝɓi pi ɓǝ nwatthǝ ɓǝ. <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />Bakwɔ ɓi lǝ bǝ dǝnyitthǝ ɓǝ tthǝ Kristi Yeso langkwoi bǝ yiɗi bǝi ɓǝ lǝba yayuu gi Fuh ǝndǝi ɓǝ. <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />Kwɔ nǝ ba a langǝ i, nwaba a langǝ i, kwɔ la nwasiu wuo suaɓǝ, ɓalǝ bǝ dǝ nyitthǝ kwɔ dǝna dǝɓǝ. Nungkwɔ bǝ dǝnyitthǝ ɓǝ ibǝ yiɗi bǝi ɓǝ tthǝn lo nungkwɔ ɓa dǝnyitthǝ ɓǝ, kwɔ i dǝɓǝ tthǝ matthǝ wayi lǝ. <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />U nwaba a langǝ i wuo suaɓǝ kwɔ dǝna wɔlǝ bǝ khana lo langkwoi dǝna yǝb longwam ǝndǝi, manungkwɔ dang ɓǝ lakuu vii kwɔ ɓalǝ ba nung a langǝ i gi Fuh langkwoi wuoɓa ibǝi i naɓǝlǝ ɓǝ. <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />Ɓalǝ ba nung a langǝ i Fuh nwa Abafaras, thǝb young ɓi a langǝ i, yuu akwɔ dǝna to nung to Kristi nyi kun nwathan ɓiɓǝ. <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />U gei ɓitthǝ babǝ yiɗi bǝiɓǝ kwɔ dǝɓa yiɗi lǝ tha kwɔ Ɓyang dǝɓǝ ɓǝ.<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />Lǝba ɓǝkwɔ vii ǝndǝi dǝɓi pinwa lǝba ɓǝ, baipiu viikwɔ ɓilǝ baɓǝ ɓǝ. Ɓi yam Fuh dǝɓǝ bǝ ibǝ nung lo nungkwɔ dǝu yiɗi ɓǝ, i yiggǝi ǝndǝi langkwoi bǝ ibǝ nungkwɔ Ɓyang gu dǝna dǝɓǝ. <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />Yang ɓa ɓuan ɓa ǝǝ manungkwɔ Dangbang dǝna yidɗi ɓǝ langkwoi ɓa to nungkwɔ dǝu yidɗi ɓǝ. Nwongǝi ɓǝ a to i nung a langǝ i ǝndǝi, yangbǝ bǝ ibǝ Fuh ɓǝ ghaa. <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />Kaso ɓa nyim i ttha kwɔ ǝndǝi dǝna wɔ bǝgǝ ghaali ttha gu ɓǝ, yangbǝ ɓa ɓuan ɓa tthǝbnyitthǝ nung ǝndǝi i tthǝla. <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />Langkwoi i tthǝla ɓato sakko lǝ Daa, kwɔ dǝɓǝ lǝi ɓa tǝi dang nungkwɔ Fuh dǝlǝ yayuu gu tthǝ sua dang bǝ lo yigwoi gu ɓǝ. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />U iɓilǝ dang bǝ lo yigwoi bǝthǝl langkwoi u wuo ɓilǝ latthǝ lǝ dang bǝ lo yigwoi Yuiu kwɔ dǝu yiɗi ɓǝ, <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />tthǝulǝ ɓi tǝi lo ɓi, nungɓǝlǝ, i al nung a ɓko ɓilǝtǝ.<verse eid="COL 1:14" /></para>
  <para style="s">Kristi I Nung to Gu</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />Kristi kwɔ dǝ ɓi ɓyǝa i nung kwɔ uɓǝ lǝ killǝng Fuh kwɔ ɓi ɓyǝa i nungǝu ɓǝ. Ulǝ nwasi yui a Yiɓǝi gi Fuh, utthǝ nwuni bǝ i mab nung ǝndǝi ulǝ ya ttha lo nung mabǝi ǝndǝi. <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />Bakwɔ tthǝulǝ Fuh mab nung ǝndǝi wayi i pangsua, nung akwɔ dǝi ɓyǝa i akwɔ i ɓiuɓǝ, i ttha ɓyang, dang bang, ya dǝ kabnwa nung langkwoi i ttha. Fuh mab longwam ǝndǝi tthǝulǝ langkwoi ba gu. <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />Kristi tthǝ nwuni bǝ nung ǝndǝi, langkwoi dang bǝ kǝbthalo i ulǝ nung ǝndǝi dǝi bǝdǝi gi matthǝ. <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />Ulǝ lo dang zuggǝ tthǝ, ya kǝm pinwa; ulǝ bǝ baipi nwongǝi tthǝ. Ulǝ nwasi Yui a yiɓǝi gi Fuh, kwɔ i ǝrrǝu lǝ dang ya ɓuiɓua, yangbǝ ǝǝlǝ angǝ u ɓuolǝ nwasiu dang nung ǝndǝi. <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />Bakwɔ Fuh yidɗi nungkwɔ Yuiu ɓǝ i nkolǝ natha i Fuhlǝ nunglǝi ǝndǝi. <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />Bǝgǝ Yui, yang, Fuh gwab kwoilǝ nung longwam ǝndǝi wulǝ tthǝu. Fuh wulǝ bǝ ǝǝ a tǝmmi tthǝ zii Yuiu lo kab gangǝ i langkwoi nungkwɔ u kwoilǝ nung ǝndǝi u wulǝ tthǝu, i longwam ǝndǝi i wayi.<verse eid="COL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21" />Lona a kunlǝ ɓa tutha i Fuh ɗing langkwoi ɓǝ ǝn ɓui gu ba nung a mulub kwɔ ɓa to langkwoi ɓa nhǝm ɓǝ. <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />Kwoi lakwɔ, babǝ ɓuiɓua a nungwambǝi gi Yuiu, Fuh mǝrrǝm ɓǝlǝ ya ǝnthǝu, yangbǝ u mab ɓǝ, la langǝ i, i tthǝ, langkwoi nung a ɓko yangǝu, tthasiu lǝ. <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />Ɓǝ la langǝ i, lilotthǝ bǝ dǝnyitthǝ li pi kǝm a nyimmi kwɔ lǝ a langǝ i ɓǝ, langkwoi ɓa kǝr ɓa thǝuri babǝ dǝnyitthǝ kwɔ ɓa tǝi kwɔ ɓa lǝ nwaba a langǝ i ɓǝthǝ. Ən nwaba a langǝ i ɓǝ kwɔ Ɓang, Bulus ǝn mǝrrǝmlǝ thǝb u nwaba a langǝ i kwɔ i gei lǝ yayuu tthǝ ǝndǝi longwam ɓǝ.<verse eid="COL 1:23" /></para>
  <para style="s">Bulus To nung to Mangǝn Thǝb Ya Kǝm Pinwa</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />Langkwoi lakwɔ Dǝm lǝ tthǝla ba zuim lǝ ba ɓǝ, bakwɔ lǝ ba zuim dǝm wonatthǝ bǝ al lo nungkwɔ Kristi al lo lǝu ɓǝ babǝ to zui gu ba tthǝu, ya kǝm pinwa. <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />Langkwoi Fuh mǝrrǝm mǝm lǝ thǝb ya kǝm pinwa, yuu akwɔ dǝm nung to ǝn to lǝ ba nung to a langǝ i ɓǝ. Ən nung to bǝ gei ba gu ǝndǝi, <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />nungɓǝlǝ nungkwɔ u pyǝa dang wam kwɔ pa ǝndǝi ɓǝ bǝgǝ thayuu ǝndǝi kwoi lakwɔ Fuh yǝb lǝ yayuu gu tthǝ. <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />Nungkwɔ Fuh nhǝm bǝ tou kwoi dǝna yiɗi kwɔ nungɓǝlǝ u tanatthǝ nungkwɔ dang nyiu kwɔ lǝ yayuu gu tthǝ, nungtǝi kwɔ i nung a pyǝa kwɔ lǝ ba yayuu ǝndǝi. Nung a pyǝa lǝ yakwɔ ǝn ya yahudawa lǝu ɓǝ nungɓǝlǝ Kristi dang tthǝɓǝ, nungɓǝlǝ nungkwɔ ɓa tǝi dang ghaali Fuh. <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />Nungkwɔ dǝɓi gei ba Kristi lǝ yayuu tthǝ ǝndǝi. I yiggǝi ǝndǝi dǝɓi gub ɗuogsui langkwoi dǝɓi nainatthǝ nung yangbǝ ɓi wulǝ ko ya gi lǝ tthasi Fuh mangǝn yuu kwɔ ghaang dang bǝ kǝb lo lǝtha i Kristi. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />Yangbǝ nungkwɔ tǝi totthǝ Ən tonungto i tthalǝ, ǝn tonungto i ttha angǝ a kwɔ Kristi dǝm langkwoi dǝna tonungto tthǝmlǝ ɓǝ.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />Ɓa dǝisua ǝn geiɓǝ nung to kwɔ tthǝ ǝn to nikwɔ i zuii kwɔ ǝn tanglǝ baɓǝ i yakwɔ Lawudikiya ɓǝ langkwoi i yakwɔ ǝndǝi im lǝuɓǝ. <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />Ən to nung to kwɔ yangbǝ i tǝi tthǝnyimmi langkwoi i yiɗi tha, langkwoi yangbǝ i tǝi nungtǝi bǝ dǝnyitthǝ kwɔ ibǝ ibǝnung a langǝ i dǝna wulǝ ɓǝ. Manungkwɔ ni yang i ibǝ nungkwɔ dang wa Fuh, kwɔ lǝ Kristi i nkolǝ ɓǝ. <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />Kristi lǝ nungɓau nwakǝm kwɔ dǝna ɓko gwoi dugǝi yigǝi langkwoi bǝ ibǝnung gi Fuh kwɔ pyǝalǝ pyǝa ɓǝ.<verse eid="COL 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="COL 2:4" />Ən gei ɓǝtthǝ, bǝ ɓa yiǝ yuu akun ɗamɓǝ ibǝ nyimnwa pǝllǝ thǝ, ko i ma nǝna. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />Bakwɔ ko ǝn yangǝu bǝilǝ i ɓǝlǝu, yirrǝ ɓang i ɓǝllǝ dang ɓyang lǝ, langkwoi dǝm lǝ tthǝla kwɔ ɓa dǝilo nung nyimtthǝ kwɔ ɓa dǝilo suatha dang bǝ dǝnyitthǝ dang Kristi ɓǝ.<verse eid="COL 2:5" /></para>
  <para style="s">Nwongǝi Əndǝi Dang Kristi</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />Baipiu vii kwɔ ɓa muo Kristi Yeso lǝ Dangbang, ɓa ǝǝ dang bǝ kǝbtha lo i ulǝ. <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />Ɓa dǝ yǝng ɓǝ tǝ tutthǝ tthǝulǝ, ɓa mai nwongǝi ɓǝ lolǝ, langkwoi ɓa mǝrǝm nyimtthǝ dang bǝ dǝnyitthǝ ɓǝ, manung akwɔ i naɓǝnatthǝ ɓǝ. Langkwoi ɓa ǝǝ nwa bǝ to sakko.<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />Bǝ ɓa gwab, yang, yuu a kun to ɓǝlǝ thǝb nunglǝi bǝ ɗambǝi yiggǝi yayuu nǝkwam thǝ, kwɔ dǝna wɔ bǝgǝ nanatthǝnung kwɔ thayuu wulǝ langkwoi bǝgǝ ɓyang lo yigwoi longwam kwɔ, langkwoi bǝgǝ Kristi lǝu. <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />Bakwɔ nungkwɔ ǝndǝi lǝ Fuh kwɔ tthǝn dang Kristi kwɔ u dang sual tthǝ thayuu ɓǝ. <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />Langkwoi Fuh dǝɓǝ nwongǝi ǝndǝi dang bǝ kǝbtha lo i Kristi. Ulǝ yikuu lo i ɓyang ya lo yigwoi i ttha.<verse eid="COL 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="COL 2:11" />Dangbǝ kǝbtha lo i Kristi i ɓǝr nwa ɗuǝ ɓǝ, bǝ ɓǝr nwa ɗuǝ kwɔ thayuu dǝna toɓǝ lǝu, kwoi bǝ ɓǝr nwa ɗuǝ kwɔ Kristi dǝna toɓǝ, nungkwɔ lǝ bǝ tǝi lo dang ttha nung a ɓko. <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />Kwɔ i wollɓǝmung, i suu ɓǝ i Kristi, langkwoi dang bǝ wollmung Fuh ǝrr ɓǝlǝ i Kristi langɓǝ tthǝ bǝ dǝnyitthǝ ɓǝ dang nung to ttha Fuh, kwɔ ǝrǝu lǝ bǝ ɓui ɓua ɓǝ. <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" />Kwɔ lona akun ɓa ɓui ɓua ɓyang dang nung a ɓkoɓǝ langkwoi ɓa ɓǝrnwa ɗuǝ tthǝ nung a ɓko ɓǝ, Fuh to ɓa tǝi nwongǝi i Kristi. U al nung a ɓko ɓi ǝndǝi lǝtǝ; <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />Fuh thǝb than nungvullǝ nung a ɓko ǝndǝi kwɔ i vullǝ loɓi ɓǝ i bǝ yidɗi bǝi zuu gi Musa kwɔ tthǝb ɓi langkwoi u al lǝtǝ ǝndǝi i bǝ piu lo kab gangǝ i. <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />Langkwoi lo kab gangǝ i kullo u tang lo tthǝ ya ɓyang lo yigwoi i ttha; u ji tthǝkku nung yayuu lǝ, u olǝsi mang ya thǝb dang thko bǝ tang lo gu loi lǝ.<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />Manungkwɔ ni yang bǝ yuu akun mab zuu lǝ ba nungkwɔ ɓa tang ko nwa ko ba vii gi Fuh ko bǝ to ɓang Fi a Fuu ko vii nwongǝi thǝ. <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />I nungkwɔ ǝndǝi ǝn killǝng nungkwɔ dǝna wɔ tthasi ɓǝ; nung a langǝ i ǝn Kristi. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />Bǝ a yi yuu akun kwɔ dǝna lǝi angǝ ilǝ yikku ɓangnhaa lǝ ba mum muani langkwoi yuu akwɔ dǝna kǝb pǝllǝ ɓuoblo sua langkwoi dǝna wab Ya nwatummi gi Fuh. Lǝba nung akun lǝu ko tuab, yayuu manungkwɔ ni dǝna lǝi loi nunglǝi bǝ nhǝm ba thayuu <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />langkwoi yitthǝ bǝ muo sua Kristi, kwɔ ulǝ lo tthǝ. Kristi muo dǝ tthǝtha ɓui tthǝ dǝna tǝi nungtang langkwoi muo tthǝtha i gullu i ɗigg, langkwoi dǝna ghaa manungkwɔ Fuh dǝna yiɗi angǝ ghaa ɓǝ.<verse eid="COL 2:19" /></para>
  <para style="s">Nwongǝi Afu Dang Kristi</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />Ɓa ɓui i Kristi langkwoi i sob loɓǝ tthǝ ɓyang longwam kwɔ. Ən baɓǝ, yang, dǝɓa ǝǝ mangǝttǝn ɓǝ ǝn a longwam kwɔa? Ən baɓǝ bǝ dǝɓa to nung to i bakwɔ mangǝ <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />&lt;&lt;Bǝ a muo natthǝ nungkwɔ thǝ,&gt;&gt; &lt;&lt;Bǝ a bang nung kullo thǝ,&gt;&gt; &lt;&lt;Bǝ a kǝn natthǝ nung a kunthǝ&gt;&gt;? <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />Nungkwɔ ǝndǝi natha i nungkwɔ a mǝrrǝmlǝ nung a nǝkwam kwɔ nǝ i tolǝ nung to ɓǝ; ǝn zuu gi thayuu ɓuo ibǝ nanatthǝ nung gu. <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />La langǝ i iri nunglǝi kwɔ mangǝn yiggǝi dang bǝ wab ya nwatummi gi Fuh lǝ ttha, langkwoi bǝ ɓuob lo sua pǝllǝ langkwoi bǝ dǝ zuii lǝ tthǝ; kwoi i yangǝu i nung to a langǝ i kwɔ a nan nungkwɔ ɓui tthǝ dǝna yiɗi ɓǝu.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />Kwɔ i ǝrr ɓǝlǝ i nwongǝi afu i Kristi, ɓa dǝ nyiɓǝ lo nung akwɔ wayi lǝɓǝ, bǝikwɔ Kristi ǝǝ lo nung ǝǝ loyigwoi gu lona a nali gi Fuh ɓǝ. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />Ɓa dǝnyi ɓǝ lo nung akwɔ yilǝ ɓǝ, lo nung akwɔ bǝikwɔ longwam ɓǝlǝu. <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />Bakwɔ ɓa ɓuiɓua, langkwoi Fuh pyǝa nwongǝi ɓǝ i Kristi tthǝu lǝ. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />Nwongǝi ɓǝ a langǝ i ǝn Kristi. Langkwoi nǝ u fug, yang ɓǝ langɓǝ ɓa fug i ulǝ ɓa tǝi ghaali gu!<verse eid="COL 3:4" /></para>
  <para style="s">Nwongǝi Aku I Afu</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />Manungkwɔ ni yang ɓa thǝb ɗǝlak longwam kwɔ tthǝ ɓǝ ɓǝ, manung gi bǝ lo i yisi i yiɓǝi, nung a ɓko, ɗǝlak, yiɗi nung a ɓko, ibǝ yiɗi nung (bakwɔ bǝ yiɗi nung ǝn bǝ wab nung akwɔ nwongǝi gu yangǝu ɓǝ). <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />Lǝba i nungkwɔ nyi gi Fuh a wɔ lo yakwɔ to nung to i bagu lǝuɓǝ. <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />Viikwɔ ɓǝ i naɓǝ dǝɓa ǝǝ lo bǝ yiɗi i nungɓǝkwɔ, Kwɔ i nung a ɓko kwɔ lǝ nwongǝi ɓǝ ɓǝ.<verse eid="COL 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 3:8" />Kwoi lakwɔ ɓa al i nungɓǝkwɔ lǝtǝ manungi: nyi, yiɗi nung, ibǝ yidɗi bǝ tthǝngbǝi. Bǝ dal ɗyǝam yangǝu ko ba a ɓko i nwa ɓǝthǝ. <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />Bǝɓa kǝbpǝllǝ lǝtha tthǝ, bakwɔ ɓa ilǝ tthǝ aku i kiggǝu lǝng <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />langkwoi ɓa li tthǝ a fuung. Nungkwɔ lǝ tthǝ afu kwɔ Fuh, lǝ ya mabbu ɓǝ, vii ǝndǝi dǝna mǝrǝmlǝ afu dang killǝngǝu, yangbǝ wuo ɓǝlǝ bǝ ibǝ nung lolǝ. <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />Manungkwɔ ni yang, bǝ gab ganglang ya kwɔ ǝn ya Yahudawa lǝu kwɔ i ya Yahudawa, ya ɓǝr nwa ɗuǝ i yakwɔ ɓǝr nwa ɗuǝu, yayol, ya kiggǝ a ɓko, i ya thǝb i yakwɔ ǝn ya thǝb lǝu ɓǝ, kwoi Kristi lǝ ǝndǝi, Kristi dang nungǝi lǝ ǝndǝi.<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />Ɓǝ ǝn ya yuu gi Fuh; u yiɗi ɓǝ langkwoi u mko ɓǝ lǝ abo. Nungkwɔ yang, ɓa lǝi kiggǝ bǝ ɓyǝa nung zuii, nyitǝmmi, ɓuob lo sua, lo a tǝmmi, i bǝ tthǝbnyitthǝ. <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />Ɓa gwabtha langkwoi ɓa al nung a ɓko tha lǝtǝ viikwɔ ǝndǝi nǝ yuu akun ɓuobnwa lo yuu akun ɓǝ. Ɓa al nung a ɓko tha lǝtǝ manungkwɔ Dangbang al aɓǝ lǝtǝ ɓǝ. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />Langkwoi lo nung a langǝ i kwɔ ǝndǝi ɓa lilo i bǝ yiɗi bǝi, kwɔ tthǝb yayuu lǝtha ǝndǝi langkwoi wuolǝ nung tthǝtha ǝndǝi matthǝ. <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />Tǝmmi kwɔ Kristi dǝɓǝ kwɔ yangbǝ oɓǝlǝ si lo nunglǝi kwɔ ɓa lǝiɓǝ; bakwɔ ǝnba tǝmmi ɓǝkwɔ Fuh lubǝi ɓǝ kǝblǝtha dang tthǝ kun. Langkwoi ɓa ǝǝlǝ ya khabǝi. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />Nwaba a langǝ i gi Kristi ǝǝ dang nyiɓǝ ghaatthǝ. Ɓa nanatthǝ langkwoi ɓa gei lǝtha tthǝ dang yiggǝi ǝndǝi. Ɓa lub ɓin Zabura, ɓin, i ɓin ɓyang; ɓa lub lǝ Fuh tthǝ ibǝ to sakko dang nyiɓǝ. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />Manungkwɔni yang dang nungkwɔ ǝndǝi ato ko a gei, yang, ato dang ɗuǝn Dangbang Yeso, manungkwɔ ato sakko tthǝulǝ lǝ Fuh Daa.<verse eid="COL 3:17" /></para>
  <para style="s">Bǝ Əǝ Tthangtha Dang Nwongǝi Afu</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />Yasi, ɓadǝ loɓǝ lǝ yaɓǝi ɓǝ, bakwɔ ǝn nungɓǝ ɓato kwɔ maɗing tthǝ Dangbang ɓǝ.<verse eid="COL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19" />Yaɓǝi, ɓa yiɗi yasi ɓǝ bǝɓa to nyi loi thǝ.<verse eid="COL 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20" />Yathang, ǝn nungto ya Kristǝ ɓa tonungto i ba ya daaɓǝ vii ǝndǝi. Ən nungɓǝ Fuh dǝna lǝtthǝla tthǝu.<verse eid="COL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21" />Ya daa bǝɓa ɓanglǝ dang wa yathang ɓǝthǝ, ko tthǝi a muan.<verse eid="COL 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22" />Ya thǝb, ɓa to nung to i ba ya togwoi ɓǝ a longwam dang nung ǝndǝi, ǝnba kwɔ dǝi ɓyǝa ɓǝ ɓuoɓǝ lǝu bakwɔ dǝɓa yiɗi i toɓǝ nung a langǝ itthǝ lǝu; kwoi ɓato i lonyi kun bakwɔ dǝɓa dǝ angǝ a lǝ Dangbang ɓǝ. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />Nung ǝndǝi kwɔ dǝmma to kwɔ, ato i dang nyimǝ ǝndǝi, mangǝttǝn dǝmma to lǝn Dangbang tthǝ langkwoi dǝmma to lǝn yayuu tthǝlǝu. <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />Ɓa nhǝm ɓangǝ Dangbang a dǝɓǝ nwathan ɓǝ nungkwɔ u dǝsua lǝ yayuu gu tthǝɓǝ. Bakwɔ Kristi lǝ togwoi a langǝ i kwɔ dǝɓa tou nung to tthǝɓǝ. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />Langkwoi ya to nung a ɓko i kwai nwathan gi i nung a ɓko kwɔ dǝi toɓǝ, Bakwɔ Fuh dǝna to kwanlǝ yayuu tthǝ natha.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />Ya togwoi, ɓa dǝ ya thǝb ɓǝ nungkwɔ ǝn a langǝ i langkwoi matthǝ ɓǝ, bakwɔ ɓa ibǝi ɓangǝ ɓǝtthǝ i Togwoi wayi langɓǝ ɓǝ.<verse eid="COL 4:1" /></para>
  <para style="s">Bǝ Lagbǝi</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />Ɓa dǝ tthǝɓǝ bǝ pinwa, dǝɓa dǝ kiggǝ kwɔ dǝɓa pinwa ɓǝ, dǝɓa to sakko lǝ Fuh. <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />Langkwoi ɓa pi ɓi nwatthǝ, yangbǝ Fuh ɓko ɓi nwa kǝm tthǝ ɓi gei ba gu lǝ ba nungkwɔ pyǝa dang nyi Kristi ɓǝ. Ən ba nungɓǝ kwɔ lakwɔ ɓang pursǝna ɓǝ. <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />Ɓa pinwa, yangbǝ ǝn gei ba, manungkwɔ kaso ɓǝ, Ən gei kaitthǝ.<verse eid="COL 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 4:5" />Ɓa to yiggǝi bǝ to nung to tthǝ yakwɔ ǝn ya dǝba a langǝ i lǝu ɓǝ. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />Bǝ gei ba ɓǝ vii ǝndǝi yitthǝ i nung a langǝ i, langkwoi ɓa tǝi nung kwɔ ɓa gwab ba nwa yayuu ǝndǝi ɓǝ.<verse eid="COL 4:6" /></para>
  <para style="s">Bǝ Alo Bǝ Gumbǝi</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />Ənthǝ ɓi Tikikus, yuu kwɔ ǝn ya nung to a langǝ i kwɔ langkwoi thǝb manung a ɓi dang nung to gi Dangbang kwɔ, u gei ɓǝ nwaba tthǝ ǝndǝi lǝ bam. <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />Nungkwɔ dǝm tummu sua ɓǝ, yangbǝ nyim tthǝɓǝ ibǝ gei ɓǝ nungkwɔ ɓi dang ǝu ɓǝ. <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />Unisimas suatha i ulǝ, ǝnthǝ ɓi ya langǝ i, kwɔ u dang ɓuaɓǝ ɓǝ. I gei ɓǝ nungtthǝ ǝndǝi kwɔ dǝna to nungɓǝ.<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />Aristarkus kwɔ pursǝna i ɓanglǝ kwɔ, dǝna tumbǝi i bǝ gumbǝi, langkwoi i Markus, young gi Barnabas. (I osi i dǝɓǝ ba angǝ ɓa kǝblo Markus nǝ u wuo ɓǝ.) <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />Yeso kwɔ dǝi lu angǝ Yustus kwɔ, dǝna gumbǝi langɓǝ. Yakwɔ tai kwɔ ǝn ya Yahudawa kwɔ dǝ ba a langǝ i dǝna to nung to i ɓang babǝ lo yigwoi gi Fuh ɓǝ, langkwoi dǝnni nwongǝm ghaaɗing.<verse eid="COL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 4:12" />Abafaras dǝna gumbǝi, yuu akun dang ɓua ɓǝ langkwoi thǝb gi Kristi Yeso. Vii ǝndǝi dǝu pinwa nyimtthǝ lǝ baɓǝ, dǝu yam Fuh angǝ ɓa dǝi nyimtthǝ, mangǝn ya muo sua Fuh kwɔ nyim mǝng langkwoi Kristǝ kwɔ gwab nung ǝndǝi, dang bǝ to nung to i nungkwɔ Fuh dǝna yiɗi ɓǝ. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />Ɓang i namlǝ mǝn gei nwa nung to gu kwɔ dǝu to niɓǝ lǝ ba ɓǝ langkwoi lǝ ba yayuu dang Lawudikiya i Hirafolis. <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />Luka, ya dǝ yǝng young ɓi, i Dimas dǝna gumbǝi.<verse eid="COL 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 4:15" />Ɓa gum ya dǝ ba a langǝ i Lawudikiya i Nimfa langkwoi i ya kǝm pinwa kwɔ dǝna kǝbtha gwoi gu ɓǝ. <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />Tthasua kwɔ na than nungvullǝ kwɔ, ɓa than langɓǝ dang kǝm pinwa Lawudikiya lǝ. Manungɓǝni langkwoi, ma than nungvullǝ kwɔ ya dǝba langǝ itthǝ ya Lawudikiya a tumma lǝ bǝi tthǝɓǝ. <verse eid="COL 4:16" /><verse number="17" style="v" sid="COL 4:17" />Langkwoi a gei Arkibus, &lt;&lt;A al lo nung to kwɔ i da dang nung to gi Dangbang ɓǝ.&gt;&gt;<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />Ən vullǝ nungkwɔ i namlǝ: <char style="sig">Bǝ gumbǝi nwa Bulus</char>. Bǝ ɓa danyitthǝ sarkam thǝ!</para>
  <para style="p" vid="COL 4:18">Kaso nung a langǝ i Fuh ǝǝ i ɓǝlǝ.<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>