<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">Yahuza</para>
  <para style="toc1">Nungvullǝ Bǝgǝ YAHUZA</para>
  <para style="toc2">Yahuza</para>
  <para style="toc3">Yahuza</para>
  <para style="mt2">Nungvullǝ Bǝgǝ</para>
  <para style="mt1">YAHUZA</para>
  <para style="imt1">Bǝ Gabnung</para>
  <para style="ip">
    <char style="bk">Nungvullǝ Bǝgǝ Yahuza </char> i vullǝ yangbǝ i gub ɗuogsui yayuu tthǝ ya nanatthǝ nung pǝllǝ yakwɔ dǝna gei angǝ i ǝn ya dǝba a langǝ itthǝ ɓǝ. Dang nungvullǝ kwɔ tuab kwɔ, natha i <char style="bk">2 Bitrus </char> ya vullǝu nyimtthǝ ya thannu angǝ&lt;&lt;i lilotthǝ lǝ ba bǝ dǝnyitthǝ kwɔ bokun langkwoi lǝ ba yayuu ǝndǝi Fuh dǝlǝ yayuu gu ɓǝ.&gt;&gt;</para>
  <chapter number="1" style="c" sid="JUD 1" />
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1" />Ɓang Yahuza, thǝb gi Yeso Kristi langkwoi young gi Yakubu</para>
  <para style="p" vid="JUD 1:1">Sua yakwɔ Fuh lubǝi ɓǝ, yakwɔ dǝna ǝǝ dang bǝ yiɗi bǝi gi Fuh Daa langkwoi ya khalo Yeso Kristi:<verse eid="JUD 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2" />Kaso nungzuii, bǝ ǝǝ a langǝ i, i bǝ yiɗi bǝi ǝn aɓǝ kpaatthǝ.<verse eid="JUD 1:2" /></para>
  <para style="s">Ya Nanatthǝnung Pǝllǝ</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3" />Ya youngǝm kwɔ dǝm yiɗi niɓǝ, ǝn ɗuong nungǝm yangbǝ ǝn vullǝ ɓǝ nungtthǝ ba bǝ sob lo kwɔ ǝn aɓi ǝndǝi ɓǝ, kwɔ dǝm ɓyǝa kaso ǝn vullǝ yangbǝ ǝn dǝɓǝ tthǝnyimmi bǝ lilotthǝ bǝ taɓui la langǝ i lǝ ba bǝ dǝnyitthǝ kwɔ bokun langkwoi laɗing Fuh dǝlǝ yayuu guɓǝ. <verse eid="JUD 1:3" /><verse number="4" style="v" sid="JUD 1:4" />Bakwɔ yakwɔ i Fuh lǝu kwɔ brǝm tǝ dang ɓǝ ɓa ibǝi lǝu, yakwɔ dǝna ɓanglǝ nwaba a langǝ i lǝba nung a langǝ i gi Fuh ɓi yangbǝ i tǝi lǝi bǝto nung a ɓko gi, langkwoi yakwɔ la Yeso Kristi ɓǝ, Togwoi ɓi kunɗǝng ɓuo i Dangbang ɓi. Viikwɔ nungvullǝ gei nwaba a tthasi lo bǝ ɓanglǝ bǝikwɔ i tǝi ɓǝ.<verse eid="JUD 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5" />Ko kwɔ ɓa ibǝ nungkwɔ ǝndǝi kwɔ, dǝm yiɗi bǝ oɓǝ nyitthǝ nunglǝi kwɔ Fuh nwong ya Israila na ya losua Masar ɓǝ, kwoi tthasukolǝ thǝb yakwɔ dǝ ba a langǝ i tthǝ Yeso lǝu ɓǝ. <verse eid="JUD 1:5" /><verse number="6" style="v" sid="JUD 1:6" />Ɓa nhǝm ya nwatummi gi Fuh kwɔ dǝilo nung to gi la langǝ i lǝu ɓǝ, kwoi i labǝ ǝǝ gi: i tthǝb bǝi i sarka a ɗing dang kongɓua a ɗing dang bǝthǝl dang sua, Fuh ji bǝilǝ tǝlǝ gong Vii kwɔ i thǝitthǝ ɓǝ. <verse eid="JUD 1:6" /><verse number="7" style="v" sid="JUD 1:7" />Ɓa nhǝm Sadoma i Gwamrata, i gwoi angǝ a kwɔ gɓagǝi ɓǝ, i to manungkwɔ ya nwatummi kwɔ toɓǝ i o dang bǝ lo itha i nung a ɓko ɓǝ: i tang zuii i bǝ ɗablua bǝi i lua a ɗing lǝbǝ gub ɗuogsui lǝ yayuu tthǝ ǝndǝi.<verse eid="JUD 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8" />Manungɓǝni langɓǝ, yayuu kwɔ tthǝ i muani kwɔ toi i to nung a ɓko lǝ loi inailǝ; i la ttha gi Fuh langkwoi i dal ghaali yuu akwɔ wayi ɓǝ. <verse eid="JUD 1:8" /><verse number="9" style="v" sid="JUD 1:9" />Ko ǝn yikku ya nwatummi gi Fuh Mikailu to nungkwɔ. Dangbǝ kwatha gu i Mungkullum, kwɔ i nyimtha nwa angǝ ǝn yittǝn a lǝi kwamɓui Musa, Mikailu than nyi lo Mungkullum i ɗyǝam lǝu kwoi u gei angǝ, &lt;&lt;Dangbang lam nwamǝ!&gt;&gt; <verse eid="JUD 1:9" /><verse number="10" style="v" sid="JUD 1:10" />Kwoi yayuu akwɔ nungkwɔ i ibǝi lǝu dǝnni gei ba i ɗyǝam; langkwoi i nungkwɔ i ibǝi kwɔ i dang tthǝi, mangǝn nyam dang ug, u i nungɓǝkwɔ dǝna thǝi ɓǝ. <verse eid="JUD 1:10" /><verse number="11" style="v" sid="JUD 1:11" />Ɓkoitthǝ nǝnǝ ni! I lǝi ǝn nunglǝi kwɔ Kayinu muo tthǝ ɓǝ. Lǝba nungkurɓǝ i dǝloi lǝ nunglǝi a ɓko kwɔ Bal'amu toɓǝ. I ǝǝrlǝ kongǝi manung akwɔ Kora toɓǝ, i ɓui manung abo. <verse eid="JUD 1:11" /><verse number="12" style="v" sid="JUD 1:12" />I nungto tthǝkku, i ǝn ɓilǝng dang nungtang bǝ kǝbtha loɓǝ. Dǝi kang ǝn loi ɓuo. I mangǝn tǝi kwɔ wa dǝna ee dǝna thkolǝ ɓǝ, kwoi wuolǝ mungǝu. I mangǝn kab kwɔ siu ɓǝ, i thalǝu ǝndǝi, kab kwɔ i lub i yǝngǝu langkwoi ɓuing ɓǝ. <verse eid="JUD 1:12" /><verse number="13" style="v" sid="JUD 1:13" />I mangǝn wa aɓau lo nwam, i nung to tthǝkku gi dǝnni fog. I mangǝn vin kwɔ dǝna thko nǝkwam ɓǝ, yakwɔ Fuh ji bǝitthǝ laɗing dang ɓua akwɔ baithǝl tthǝɓǝ.<verse eid="JUD 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14" />Ən Anuhu, ya bǝpi gi Adamu a nanaira, kwɔ lakuu gei ba a tthasi loilǝ ɓǝ: &lt;&lt; Dangbang a wɔ suatha i ya nwatummi gu a langǝ i thǝmsob ɓua paknǝkwam <verse eid="JUD 1:14" /><verse number="15" style="v" sid="JUD 1:15" />a wɔlǝ kwan lo ya nwongǝi ǝndǝi, wuo mui i kwan i ǝndǝi lǝba nungto kwɔ ǝn a bǝ Fuh lǝu kwɔ i toɓǝ langkwoi i ba a ɓko yakwɔ toba Fuh lǝu i ya nung a ɓko gei lolǝ ɓǝ!&gt;&gt;<verse eid="JUD 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JUD 1:16" />Yayuu akwɔ vii ǝndǝi dǝi nyinyi langkwoi dǝi ɓyǝa nung aɓau yakun; dǝi tonungto i nung aɓau kwɔ dǝi yidɗi ɓǝ; dǝi lǝi loi dǝnni ɗam yakun yangbǝ i tǝi nungkwɔ dǝi yiɗi ɓǝ.<verse eid="JUD 1:16" /></para>
  <para style="s">Bǝ Gub Ɗuogsui I Bǝ Nanatthǝ Nung</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17" />Ya youngǝm kwɔ dǝm yiɗi niɓǝ, kwoi ɓa nhǝm, nungkwɔ i gei ɓǝtthǝ lakuu nwa ya nwatummi gi Dangbang Yeso Kristi ɓǝ. <verse eid="JUD 1:17" /><verse number="18" style="v" sid="JUD 1:18" />I geiɓǝ tthǝ angǝ, &lt;&lt; Kwɔ nǝ vii a nǝsua nǝ wuo, yayuu a fug kwɔ i mamɓǝ ɓǝ, yayuu akwɔ muosua nunglǝi kwɔ dǝi yidɗi ǝn a Fuh lǝu ɓǝ.&gt;&gt; <verse eid="JUD 1:18" /><verse number="19" style="v" sid="JUD 1:19" />I yayuu ɓǝkwɔ wuo lǝ bǝ gab loɓǝ, yayuu akwɔ nunglǝi thayuu lǝi kiggǝi ɓǝ, kwɔ i yangǝu i Ɓyangǝu ɓǝ. <verse eid="JUD 1:19" /><verse number="20" style="v" sid="JUD 1:20" />Ya youngǝm kwɔ dǝm yiɗi niɓǝ, kwoi ɓaɓǝ, ɓa ǝǝnwa bǝ mab loɓǝ lobǝ dǝnyitthǝ a langǝ i. Ɓa pinwa dang ttha Ɓyang a Langǝ i, <verse eid="JUD 1:20" /><verse number="21" style="v" sid="JUD 1:21" />langkwoi ɓa dǝi dang bǝ yiɗi bǝi gi Fuh, kwɔ dǝ ɓa kilo Dangbang Yeso Kristi ɓi dang nyitǝmmi yangbǝ u dǝ ɓǝ nwongǝi a ɗing.<verse eid="JUD 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22" />Ɓa ɓyǝa nungzuii yakwɔ dǝna nhǝm ba dang wai rab ɓǝ; <verse eid="JUD 1:22" /><verse number="23" style="v" sid="JUD 1:23" />ɓa nwong yakun ibǝ dkoi dang lua; langkwoi a bǝ yakun ɓa ɓyǝa nungzuii kǝbtha i vulli, kwoi ɓa la nunglitthǝ gi, kwɔ ɗǝlak yisi gi duab tthǝ ɓǝ.<verse eid="JUD 1:23" /></para>
  <para style="s">Bǝ Pinwa Khabǝi</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24" />A bǝ yuu akwɔ a ɓuan a muo ɓǝ ɓa ou langkwoi a wɔ ɓǝlǝ tthasi ghaali nung a ɓko yangǝu langkwoi i gong tthǝla- <verse eid="JUD 1:24" /><verse number="25" style="v" sid="JUD 1:25" />a bǝ Fuh kun ya nwong lo ɓi, tthǝ Yeso Kristi Dangbang ɓi, ghaali, lo yigwoi, tthǝnyimmi, langkwoi ttha, baipiu dang wam kwɔ pa kwɔ ǝndǝi, i lakwɔ langkwoi laɗing! Dǝitthǝ manungɓǝ.<verse eid="JUD 1:25" /></para>
  <chapter eid="JUD 1" />
</usx>