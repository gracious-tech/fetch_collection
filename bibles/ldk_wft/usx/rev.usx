<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id">- MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">Muanni</para>
  <para style="toc1">MUANNI Sua Yohanna</para>
  <para style="toc2">Muanni</para>
  <para style="toc3">Mua</para>
  <para style="mt1">MUANNI</para>
  <para style="mt3">Sua Yohanna</para>
  <para style="imt">Bǝ Gabnung</para>
  <para style="ip">
    <char style="bk">Muanni kwɔ tanatthǝ lǝ Yohanna ɓǝ</char> i vullǝ lona kwɔ dǝi dǝ zuii lǝ ya Krista ɓǝ babǝ dǝnyitthǝ gi tthǝ Yeso Kristi kwɔ lǝ Dangbang ɓǝ. Nungkwɔ dang wa ya vullǝ nungkwɔ sua ya than nungkwɔ yangbǝ u ji bǝ dǝnyitthǝ i tthǝnyimmi, langkwoi u gei i ǝǝ dang bǝ dǝnyitthǝ lona zuii ibǝ to bǝi lǝ zuii.</para>
  <para style="ip">Dang nungvullǝ lǝ ǝndǝi nungvullǝ ɓǝ ǝnba muanni kwɔ i tanatthǝ lǝ nwa killǝng nung kwɔ ya Krista a lona ɓǝ kullo kaso ibǝi ɓǝ, kwoi kaso ǝǝlǝ nung a pyǝa sua yakun ǝndǝi.</para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />Nungvullǝ kwɔ ǝn nungkwɔ i vullǝ lo nungkwɔ to nung kwɔ Yeso Kristi tanatthǝ ɓǝ. Fuh tkonatthǝ nungkwɔ yangbǝ u tanatthǝ lǝ thǝb gu nungkwɔ sua tulǝu a to nungɓǝ. Kristi tanatthǝ i nungkwɔ lǝ thǝb gu Yohanna ibǝ tumbǝi i ya nwatummi gu sukolǝ, <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />langkwoi Yohanna gei i nungkwɔ ǝndǝi ɓyǝa ɓǝ. Nungkwɔ lǝ bagu lo nwaba gu bǝgǝ Fuh i ba a langǝ i kwɔ Yeso Kristi tanatthǝ ɓǝ. <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />Ya khana lo ǝn yuu akwɔ dǝna than nungvullǝ bǝ gei ba a tthasi kwɔ ɓǝ, langkwoi ya khana lo ǝnya kwɔ dǝna lǝ bǝ than nwaba bǝ gei ba a tthasi bakwɔ langkwoi to nungto i nungkwɔ i vullǝ dang nungvullǝ kwɔ ɓǝ! Bakwɔ lona gɓagǝng kwɔ i nungkwɔ ǝndǝi ato nungɓǝ.<verse eid="REV 1:3" /></para>
  <para style="s">Bǝ Gumbǝi Sua Ya Kǝm Pinwa Nanaira</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4" />Ɓang Yohanna dǝm vullǝ nungkwɔ sua ya kǝm pinwa losua nanaira Asiya:</para>
  <para style="p" vid="REV 1:4">Nung a langǝ i i tǝmmi ǝn aɓǝ ǝndǝi bǝgǝ Fuh lǝ. Bǝgǝ Fuh yuu akwɔ lakwɔ, yuu akwɔ viikwɔ, langkwoi dǝna wɔ tthasi ɓǝ, langkwoi bǝgǝ i ɓyang nanaira tthasi bǝ lo yigwoi gu, <verse eid="REV 1:4" /><verse number="5" style="v" sid="REV 1:5" />langkwoi bǝgǝ Yeso Kristi, ya gei nwaba a langǝ i, ya nwasiu kwɔ i ǝǝr lǝ bǝ ɓuiɓua ɓǝ langkwoi yuu akwɔ lǝ ya lo yigwoi lo ya yigwoi longwam ɓǝ.</para>
  <para style="p" vid="REV 1:5">Dǝu yiɗi ɓi, langkwoi i bǝ ɓuiɓua gu kwɔlǝ bǝ nyǝknung kwɔ u dǝɓi bǝ sob lo lo i zii gu <verse eid="REV 1:5" /><verse number="6" style="v" sid="REV 1:6" />langkwoi u mǝrǝm ɓilǝ lǝ ya nyǝknung gu u mǝrǝmɓi lǝ ya to nung to lǝ Fuh gutthǝ i Daa gu. Sua Yeso Kristi ǝn ghaali i ttha laɗing langkwoi laɗing! Dǝitthǝ manungɓǝ.<verse eid="REV 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7" />A ɓyǝa! Yesu dǝna wɔ dang tǝi! Ya nwa ǝndǝi a ɓyǝko, i yakwɔ baiu i kaɓui nwangwu ɓǝ. Yayuu ǝndǝi longwam a ǝǝ nwakǝm ɓua lolǝ. A ǝǝ manungɓǝ!<verse eid="REV 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8" />&lt;&lt; Ɓanglǝ nwasiu langkwoi lǝ bǝ alo,&gt;&gt;Dangbang Fuh ya angǝ a gei manungɓǝ, uɓǝ lakwɔ, uɓǝ viikwɔ, langkwoi uɓǝ dǝu wuo.<verse eid="REV 1:8" /></para>
  <para style="s">Kristi Tanatthǝu Lǝ Yohanna</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />Ɓang Yohanna, young ɓǝ, ɓang kwɔ lǝ ya muo sua Yeso ya to nung to iɓǝ dang bǝ tthǝbnyitthǝ tthǝ zuii kwɔ da wɔ sua ya lo yigwoi i ulǝ ɓǝ. I dǝm lo gum dang mung Batamusa bakwɔ ǝn gei ba Fuh langkwoi ba a langǝ i kwɔ Yeso tanatthǝ ɓǝ. <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />Vii bǝ wab Dangbang Ɓyang gi Fuh tǝ tthǝm, langkwoi ǝnlǝ yol ghaatthǝ, kwɔ gwab mangǝn ɓii, dǝna gei ba tthasuam lǝ. <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />Yol ɓǝ gei angǝ, &lt;&lt; A vullǝ nungkwɔ a ɓyǝa ɓǝ, langkwoi a tumbǝi i nungvullǝ ɓǝ sua ya kǝm pinwa kwɔ gwoi angǝ a kwɔ nanaira ɓǝ: Afisa, Simirna, Birgamas, Tayatira, Sardisu, Filadalfiya, langkwoi, Lawudikiya.&gt;&gt;<verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />Ən mǝrǝm yangbǝ ǝn ɓyǝa yuu akwɔ dǝna geim ba, langkwoi ǝn ɓyǝa nungdǝ fitilǝ zinariya nanaira, <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />langkwoi dang fitilǝ lǝ nung akuntthǝ mangǝn yui yuu, li nunglitthǝ kwɔ kǝn lo bo, langkwoi nung tthǝb lui zinariya nyigwu lǝ. <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />Byanglo kwɔ lo kwɔ la vǝrǝm mangǝn fulung kwam, ko mangǝn tǝi, nungǝu dǝna ɗab mangǝn lua; <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />bo dǝna yuim mangǝn ɓuna kwɔ i ɗiggǝ ɓǝ, langkwoi yollu dǝna gwab mangǝn yol mung kwɔ dǝna kyal ɓǝ. <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />U muo vin ni nanaira nko a nali, langkwoi khafǝi kwɔ nwuo nǝ rabbu lǝmbtthǝ i nwuolǝ. Nungǝu kai mangǝn fuh nyilo. <verse eid="REV 1:16" /><verse number="17" style="v" sid="REV 1:17" />Kwɔ ǝn ɓyǝko, ǝn bǝr tthasiu mangǝn kwamɓui yuu. U dǝ nko a nali lomlǝ u gei angǝ, &lt;&lt; Bǝ a sur vulli thǝ! Ɓanglǝ nwasiu langkwoi lǝbǝ alo. <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" />Ɓanglǝ ya nwongǝi! Ən ɓuing, kwoi lakwɔ Ɓang i nwongǝi laɗing langkwoi laɗing. Ɓangtthǝ i nung ɓko nwakǝm lo ɓua langkwoi longwam ya ɓui ɓua. <verse eid="REV 1:18" /><verse number="19" style="v" sid="REV 1:19" />Manungkwɔ ni yang, a vullǝ, nungkwɔ a ɓyǝa ɓǝ, i nungkwɔ lakwɔ i nungkwɔ dǝna wɔ tthasi ɓǝ. <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" />Nung a pyǝa lo vin kwɔ ni nanaira kwɔ a ɓyǝa nam a nali kwɔ nungɓǝlǝ, langkwoi i kab dǝ fitilǝ kwɔ nanaira kwɔ ɓǝ: vin kwɔ nanaira kwɔ nungɓǝlǝ ya nwatummi Fuh kǝm pinwa nanaira, langkwoi kab dǝ lua fitilǝ kwɔ nanaira kwɔ lǝ kǝm pinwa.<verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s">Nwatummi Sua Ya Afisa</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />&lt;&lt;A vullǝnung sua ya nwatummi kǝm pinwa dang gwoi angǝ a Afisa:</para>
  <para style="p" vid="REV 2:1">&lt;&lt; Nungkwɔ lǝ nwaba bǝgǝ yuu akwɔ muo vin nanaira nko a nali langkwoi kwɔ dǝna thko ganglang kab dǝlua zinariya gabbǝi ɓǝ. <verse eid="REV 2:1" /><verse number="2" style="v" sid="REV 2:2" />Ən ibǝi nungkwɔ ato ɓǝng; Ən ibǝi nungto kwɔ a toni kwɔ ibǝ tthǝbnyitthǝ mǝ kwɔ zhǝ ɓǝ. Ən ibǝi a gwab ya mullubu ganglang ɓǝu langkwoi a na yakwɔ dǝna gei angǝ i ǝnya nwatummi Yeso kwoi i ǝnya nwatummi lǝu ɓǝ, langkwoi a ibǝing i ǝnya pǝllǝ. <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" />A tthǝb nyi tthǝng, ato zuiing lǝbam ɗuǝnnǝm, langkwoi a kwoi nǝsua lǝu. <verse eid="REV 2:3" /><verse number="4" style="v" sid="REV 2:4" />Kwoi nungkwɔ dǝmǝn mualǝ kwɔ manungkwɔni: a yitthǝ bǝ yiɗi bǝi mǝ mangǝ ǝn akwɔ a yiɗim la nwasiu ɓǝlǝu. <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" />A nhǝm tuli bǝikwɔ a o tthǝɓǝ! A mǝrrǝm a yitthǝ nung a ɓko mǝ langkwoi ato nungkwɔ ato la nwasiu ɓǝ. Nǝ a mǝrǝm bǝ yitthǝ nung a ɓko mǝlǝu, mǝn wuo tthangmǝ langkwoi mǝn lǝi kab dǝlua nungabbǝi mǝ bǝ dǝi gu. <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" />Kwoi bǝikwɔ abo ato nung a langǝ i: a la nung to ya Nikolatawa, manungkwɔ dǝm lai ɓǝ.<verse eid="REV 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7" />&lt;&lt;Nǝ mǝtthǝ i ɓuasui, yang, alǝ nungkwɔ Ɓyang dǝna gei lǝ ya kǝm pinwa tthǝɓǝ!</para>
  <para style="p" vid="REV 2:7">&lt;&lt; Yakwɔ tang lo mǝn ji lona i tang si kab nwongǝi kwɔ dǝna ghaa dang Zuk gi Fuh ɓǝ.<verse eid="REV 2:7" /></para>
  <para style="s">Nwaba Sua Ya Simirna</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8" />&lt;&lt; A vullǝnung sua ya nwatummi gi Fuh kǝm pinwa Simirna:</para>
  <para style="p" vid="REV 2:8">&lt;&lt; Nwaba kwɔ bǝgǝ yuu akwɔ lǝbǝ osi i bǝ kisua ɓǝ, yuu kwɔ ɓui langkwoi i nwongǝi langkwoi ɓǝ. <verse eid="REV 2:8" /><verse number="9" style="v" sid="REV 2:9" />Ən ibǝ nungkwɔ dǝna dǝɓǝ zuii mǝng; Ən ibǝing mǝ ǝn ya yiɓko- kwoi la langǝ i mǝ ǝn ya nungtǝi! Ən ibǝi bakwɔ i gei tthǝmǝ nwa yakwɔ dǝna gei angǝ i ǝn ya Yahudawa langkwoi ǝn ya Yahudawa lǝu ɓǝ; i ǝn ya kǝbtha lo gi Shǝtan! <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" />Bǝ ɓa lǝtthǝ vulli nung a kun kwɔ sua tulǝu yang a tǝiɓǝ ɓǝthǝ. Ɓalǝ! Mungkullum a naɓǝ ibǝ tǝllǝ yakun ɓǝlǝ pursǝna, langkwoi zuii ɓǝ a kǝn bo sob. Ɓa dǝnyitthǝm, ko nǝ ǝn ɓua ɓa ɓuiɓǝ, langkwoi mǝn dǝɓǝ nwongǝi a ɗing lǝ nungbusɔni ɓǝ babǝ tang lo.<verse eid="REV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11" />&lt;&lt; Nǝ ɓǝtthǝ i ɓuasui, yang, ɓalǝ nungkwɔ Ɓyang dǝna gei lǝ ya kǝm pinwa tthǝ ɓǝ!</para>
  <para style="p" vid="REV 2:11">&lt;&lt;Yakwɔ tang lo yang lǝ tthǝ zii bǝ ɓui ɓua a nung rabbu.<verse eid="REV 2:11" /></para>
  <para style="s">Nwaba Sua Ya Kǝm Pinwa Birgamas</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />&lt;&lt;A vullǝnung sua ya nwatummi gi Fuh ya kǝm pinwa Birgamas:</para>
  <para style="p" vid="REV 2:12">Nwaba kwɔ bǝgǝ yuu akwɔ nwa khafǝi gu ǝndǝi nǝ rabbu lǝmbni ɓǝ. <verse eid="REV 2:12" /><verse number="13" style="v" sid="REV 2:13" />Ən ibǝi bǝikwɔ a ǝǝtthǝ ɓǝng, bǝiɓǝ lǝ bǝ lo yigwoi Shǝtan. Mǝn ǝn ya langǝ i tthǝmlǝ, langkwoi a la bǝ dǝnyitthǝ mǝ tthǝmlǝ i lona kwɔ i thǝb Antibas ɓǝ, ya gei nwam bǝikwɔ Shǝtan ǝǝtthǝ ɓǝ. <verse eid="REV 2:13" /><verse number="14" style="v" sid="REV 2:14" />Kwoi nungtthǝ tuab kwɔ lǝ nung a ɓko mǝɓǝ: yakun tthǝ dang ɓǝ kwɔ dǝna muo sua bǝ nanatthǝ nung gi Bal'amu ɓǝ, yuu akwɔ nanatthǝ lǝ Balak bǝ osi lǝ ya Israila tǝlǝ dang nung a ɓko ibǝ toilǝ ttha i tang nungtang kwɔ i nyǝklǝ nung tthǝ nung a wabwab langkwoi i na bǝto nung a ɓko bǝ lo ithaɓǝ. <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" />Manungɓǝni ɓǝtthǝ i yayuu dang ɓǝ kwɔ dǝna muo sua bǝ nanatthǝ nung ya Nikolatawa ɓǝ. <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" />Ɓa mǝrrǝm ɓa yitthǝ nung a ɓko ɓǝ lakwɔ! Nǝɓa to nilǝu, mǝn tǝsua ɓǝ thǝmtthǝ langkwoi mǝn ɓuob vǝm i yayuu kwɔ i khafǝi kwɔ dǝna i nwamlǝ ɓǝ.<verse eid="REV 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17" />&lt;&lt; Nǝ ɓǝtthǝ i ɓuasui, yang, ɓalǝ nungkwɔ Ɓyang dǝna gei lǝ ya kǝm pinwa tthǝ ɓǝ!</para>
  <para style="p" vid="REV 2:17">Yakwɔ tang lo Mǝn ji dang mana kwɔ pyǝalǝ pyǝa ɓǝ. Langkwoi mǝn dǝlǝ ko ǝnya ǝndǝi tal a vǝrǝm kwɔ i vullǝ ɗuǝn afu lolǝ kwɔ yuu akun yangǝu ibǝiu ǝn yuu kwɔ i duu ɓuo ɓǝ.<verse eid="REV 2:17" /></para>
  <para style="s">Nwaba Sua Ya Kǝm Pinwa Tayatira</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />&lt;&lt;A vullǝnung sua ya nwatummi gi Fuh kǝm pinwa Tayatira:</para>
  <para style="p" vid="REV 2:18">&lt;&lt; Nwaba kwɔ bǝgǝ Yui Fuh lǝ, kwɔ nungǝu dǝna ɗab mangǝ ǝn luaɓǝ, kwɔ bo dǝna yuim mangǝn ɓui kwɔ i ɗiggǝ ɓǝ. <verse eid="REV 2:18" /><verse number="19" style="v" sid="REV 2:19" />Ən ibǝi nung to kwɔ dǝmma to ɓǝng. Ən ibǝi bǝ yiɗi bǝi mǝng, bǝ dǝnyitthǝ mǝ, nung to mǝ, i bǝ tthǝb nyitthǝ mǝ. Ən ibǝing dǝmma to ɗing lakwɔ pǝl akwɔ ato la nwasiu ɓǝ. <verse eid="REV 2:19" /><verse number="20" style="v" sid="REV 2:20" />Kwoi nung a ɓko mǝ kwɔ: a lǝi yisi kwɔ lǝ Yezebel, kwɔ dǝna lǝi lo angǝ i ǝn ya gei nwaba gi Fuh a yisi ɓǝ. U lǝ ya thǝbǝm ibǝ nanatthǝ nung gu u tǝilǝ bǝ to nung to i bǝ lo itha i bǝ tang nungtang kwɔ i nyǝklǝ nung tthǝ nung a wabwab kwɔ ǝn Fuh lǝu ɓǝ. <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" />Ən duu lona yangbǝ u yitthǝ nung a ɓko gu, kwoi u yiɗi bǝ mǝrrǝm mu bǝ to ɓillǝng gu lǝu. <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" />Langkwoi Mǝn wkolǝ tǝ lo dko kwɔ u i yakwɔ lo i ulǝ nunglǝi a ɓko kwɔ i tangzuii ghaatthǝ. Mǝn to nungkwɔ lakwɔ nǝ i al nung a ɓko kwɔ i to i ulǝ ɗǝ. <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" />Mǝn thǝb ya muo suko langɓǝ, langkwoi yang ya kǝm pinwa ǝndǝi a ibǝi angǝ ǝn ɓanglǝ yuu akwɔ ibǝi bǝ nhǝm ba yayuu ǝndǝi i nungkwɔ dǝi yiɗi ɓǝ. Mǝn kwai nungbusɔni koya ǝndǝi natha i nungkwɔ ɓa toɓǝ.<verse eid="REV 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24" />&lt;&lt;Kwoi suaɓǝ ǝndǝi kwɔ Tayatira kwɔ ɓa muo sua bǝ nanatthǝ nung aɓau kwɔ lǝu kwɔ; ɓa na nungkwɔ yakun dǝna lu angǝ&lt;tuli nung a pyǝa gi Shǝtan ɓǝlǝu.&gt; Ən gei ɓǝtthǝ geigǝ Ən dǝɓǝ nunglǝi akun tthǝ lo ɓǝu. <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" />Kwoi nǝ ǝn wuo ɗǝ, a muo natthǝ nungkwɔ namǝ kwɔ matthǝ. <verse eid="REV 2:25" /><verse number="26" style="v" sid="REV 2:26" />Yuu akwɔ nǝ tang lo langkwoi to nungkwɔ dǝm yiɗi kwɔ tǝlǝ bǝ alo, mǝn ji ttha lo ya losua <verse eid="REV 2:26" /><verse number="27" style="v" sid="REV 2:27" />&lt; U lo yigwoi i kab ɓui; u ɓuom mǝi dang tha mangǝn tthǝm suab&gt; manung akwɔ ǝn muo ttha na Daa ɓǝ. <verse eid="REV 2:27" /><verse number="28" style="v" sid="REV 2:28" />Mǝn ji u ttha kwɔ ǝn muo na Daam ɓǝ langkwoi mǝn ji vin a nungwoi langɓǝ. <verse eid="REV 2:28" /><verse number="29" style="v" sid="REV 2:29" />&lt;&lt;Nǝ ɓǝtthǝ i ɓuasui, yang, ɓalǝ nungkwɔ Ɓyang dǝna gei lǝ ya kǝm pinwa tthǝ ɓǝ!<verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s">Nwatummi Sua Yakuu Kǝm Pinwa Sardisu</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />A vullǝnung sua ya nwatummi gi Fuh ya kǝm pinwa Sardisu:</para>
  <para style="p" vid="REV 3:1">&lt;&lt;Nungkwɔ lǝ nwaba bǝgǝ yuu akwɔ tthǝ i ɓyang gi Fuh nanaira i vin nanaira ɓǝ. Ən ibǝi nungkwɔ dǝmma to ɓǝng; yayuu ibǝing angǝ mǝtthǝ i nwongǝi bǝ dǝnyitthǝ, kwoi a ɓui ǝn ɓui! <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" />A ǝrr, langkwoi a nyim tthǝ sua nungkwɔ namǝ kwɔ nwuni bǝ ɓui ǝndǝi. Bakwɔ ǝn ibǝing nungkwɔ ato kwɔ malǝu yirrǝ tthasi Fuh. <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" />A nhǝm, nungkwɔ i nanatthǝ i nungkwɔ a lǝɓǝ; a tolǝ nung to yang a mǝrrǝm lonyimǝ a yitthǝ i nung a ɓko mǝ. Nǝ a ǝrr lǝu, mǝn wuo suamǝ mangǝn ya nung i, langkwoi a ibǝi lona kwɔ mǝn wuo ɓǝlǝu. <verse eid="REV 3:3" /><verse number="4" style="v" sid="REV 3:4" />Kwoi yakun tthǝ tuab dang ɓǝ Sardisu lǝ yakwɔ ɓanglǝ nunglitthǝ gilǝu ɓǝ. Ɓa thko i ɓanglǝ, ɓa li nunglitthǝ la vǝrǝm, bakwɔ ɓa natthǝng kwɔ ɓa to manungɓǝ ɓǝ. <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" />Yakwɔ tang lo kwɔ i liǝ nunglitthǝ tthǝ manungkwɔ ni i nunglitthǝ a vǝrǝm, langkwoi ǝn ilǝ ɗuǝnni dang nungvullǝ nwongǝi lǝu. Dang nung Daam langkwoi i ya nwatummi gu mǝn gei nung yayuu lǝ geigǝ i ǝn abǝm.<verse eid="REV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 3:6" />&lt;&lt;Nǝ ɓǝtthǝ i ɗuogsui, yang, ɓalǝ nungkwɔ Ɓyang dǝna gei lǝ ya kǝm pinwa tthǝ ɓǝ!<verse eid="REV 3:6" /></para>
  <para style="s">Nwaba Sua Ya Kǝm pinwa Ya Filadalfiya</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />&lt;&lt;A vullǝ nung sua ya nwatummi gi Fuh kǝm pinwa Filadalfiya mangǝ:</para>
  <para style="p" vid="REV 3:7">&lt;&lt; Nungkwɔ lǝ nwaba bǝgǝ yuu akwɔ lǝ ya langǝ i langkwoi ya ba a langǝ i. Nung ɓko nwakǝm Dawuda nko lǝ, langkwoi nǝ u ɓko nwakǝm, yuu akun yangǝu a lammu, langkwoi kwɔ nǝ u ɓko, yuu akun yangǝu a ɓko. <verse eid="REV 3:7" /><verse number="8" style="v" sid="REV 3:8" />Ən ibǝi nung to mǝng; ǝn ibǝi geigǝ ttha mǝ tuab ɓuo; ɓa muo bǝ nanatthǝ nungǝm mǝng langkwoi dǝɓa dǝnyitthǝm. Ən ɓko nwa kǝm tthasi ɓǝ, kwɔ yuu akun ɓuan lammu ɓǝ. <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" />Ɓalǝ! A bǝ yakwɔ ǝn a bǝ Shǝtan kwɔ, ya pǝllǝ kwɔ dǝna lǝi angǝ i ǝn ya Yahudawa kwoi i ǝn ya Yahudawa lǝu kwɔ, mǝn toi wui bai nwalongǝi tthasi ɓǝ. I ǝndǝi i ibǝi angǝ dǝmǝn yiɗi ɓǝ. <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" />Bakwɔ ɓa to nung to i baam ɓa nyimnyi, Mǝn kangɓǝ mǝn dǝ matthǝ langɓǝ lona bǝ nabǝi kwɔ dǝna wɔ longwam bǝ na yayuu ya pangsua ǝndǝi ɓǝ. <verse eid="REV 3:10" /><verse number="11" style="v" sid="REV 3:11" />Sua tuu yang dǝmǝn wuo. Ɓa kang nungkwɔ naɓǝ la langǝ i, yangbǝ yuu akun muo nungbusɔni tang lo ɓǝ thǝ. <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" />Mǝn mab yakwɔ tang lo kwɔ lǝ kab ta kǝm dang kǝm nyǝknung gi Fuh langkwoi i ɓuan i yitthǝu. Mǝn vullǝ ɗuǝn Fuhm tthǝilǝ langkwoi i ɗuǝn gwoi angǝ a gi Fuhm, Urshalima afu, kwɔ a i wayi a pin bǝgǝ Fuhm ɓǝ. Langkwoi mǝn vullǝ ɗuǝnnǝm afu tthǝilǝ.<verse eid="REV 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 3:13" />&lt;&lt;Nǝ ɓǝtthǝ i ɗuogsui, yang, ɓalǝ nungkwɔ Ɓyang dǝna gei lǝ i ya kǝm pinwa tthǝɓǝ!<verse eid="REV 3:13" /></para>
  <para style="s">Nwatummi Sua Yakuu Kǝm Pinwa Ya Lawudikiya</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />&lt;&lt; A vullǝ nungvullǝ sua yakuu ya kǝm pinwa ya Lawudikiya mangǝ:</para>
  <para style="p" vid="REV 3:14">&lt;&lt; Nwatummi kwɔ bǝgǝ Dǝitthǝ manungɓǝ ɓǝ, ya gei nwa ya dǝnyitthǝ langkwoi ya langǝ i, yuu akwɔ lǝ pi nungkwɔ ǝndǝi kwɔ Fuh mab ɓǝ. <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" />Ən ibǝi nungkwɔ ato ɓǝng; ǝn ibǝing a tǝmmu langkwoi a sɔnu. Dǝmǝn yidɗi kaso mǝ kun dang nungkwɔ rab kwɔ lko akwɔ ko a kullo! <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" />Kwoi bakwɔ mǝ nung dang lǝ, a sɔnu langkwoi a tǝmmu, mǝn tui lǝtǝ nwamlǝ! <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" />Ɓa gei ɓangǝ, &lt;Ɓang ǝn ya nungtǝi langkwoi matthǝ; ɓangtthǝ i nungkwɔ ǝndǝi dǝmǝn yiɗi ɓǝ,&gt; Kwoi ɓa ibǝi kwɔ nung yangǝu naɓǝu! Nung ɓǝ yangǝu, ɓa li piɓǝ nǝkwam, langkwoi ɓǝ ǝn ya nungɓuommi. <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" />Dǝmǝn lagɓǝ, yang, ɓa ɗyǝab zinariya namlǝ, zinariya a langǝ i, yangbǝ ɓa tǝi nungtǝi. Ɓa ɗyǝab nunglitthǝ a vǝrǝm ɓa li langkwoi ɓa lamlǝ ɓuapi ɓǝ. Langkwoi ɓa ɗyǝab nui fa nung langɓǝ yangbǝ ɓa fa nungɓǝ, yangbǝ ɓa ɓyǝabǝi. <verse eid="REV 3:18" /><verse number="19" style="v" sid="REV 3:19" />Dǝmǝn kwanwa langkwoi dǝmǝn ɗablua yakwɔ ǝndǝi dǝmǝn yiɗi ɓǝ. Ɓa ǝǝ dang ba a langǝ i, yang, ɓa mǝrrǝm ɓa yitthǝ nung a ɓko ɓǝ. <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" />Ɓalǝ! Ən dǝi nwa kǝm langkwoi dǝmǝn gab nwa kǝm; nǝ yuu akun lǝ yollǝm langkwoi ɓko nwakǝm ɓǝ, mǝntǝ dang woi gi mǝn tang nungtang i ilǝ, langkwoi i tang i ɓanglǝ. <verse eid="REV 3:20" /><verse number="21" style="v" sid="REV 3:21" />Mǝn dǝ lǝilǝ yakwɔ tang lo kwɔ i ǝǝ nwangwum bǝ lo yigwoim, manungkwɔ ǝn tang lo langkwoi lakwɔ ǝn ǝǝ gɓag Daam lo nung ǝǝ loyigwoi guɓǝ.<verse eid="REV 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 3:22" />&lt;&lt; Nǝ ɓǝtthǝ i ɗuogsui, yang, ɓalǝ nungkwɔ Ɓyang dǝna gei lǝ ya kǝm pinwa tthǝɓǝ!&gt;&gt;<verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s">Bǝ Wab Fuh Wayi</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />Tthasua nungkwɔ ǝn muan muani akun langkwoi ǝn ɓyǝa nwa kǝm ɓko wayi lǝ.</para>
  <para style="p" vid="REV 4:1">Langkwoi yol kwɔ gwab mangǝn ɓii, kwɔ ǝnlǝ dǝna geim ba vii kwɔ, gei angǝ, &lt;&lt;A ɗab a wɔ bǝikwɔ, langkwoi mǝn tanatthǝ nungkwɔ ato nung tthasua nungkwɔ ɓǝ.&gt;&gt; <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />Dangtthǝ niyang Ɓyang tǝ tthǝm. Bǝilǝ wayi ǝn bǝ ǝǝ yigwoi yuu akun ǝǝ lolǝ. <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />Dang nungǝu dǝna yuim mangǝ ǝn tal yasfa i kanaliya, langkwoi bǝ ǝǝ yigwoi ɓǝ mǝrǝm kǝb munyǝng nyam emiral tthǝ. <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />Kwar bǝ ǝǝ yigwoi ɓǝ mǝrǝmlǝ bǝ ǝǝ yigwoi akun tthǝ thǝm kun iu nai, kwɔ yakku thǝm kun iu nai ǝǝlo i li nunglitthǝ la vǝrǝm bai nung muo lo zinariya. <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" />Lua dǝna nyang lo bǝ ǝǝ yigwoi lǝ, bǝ thǝuri gi nung i yol gamvǝr. Tthasi bǝ ǝǝ gi yigwoi lǝ fitilǝ tthǝ dǝna tang, nungɓǝlǝ Ɓyang gi Fuh kwɔ ni nanaira ɓǝ. <verse eid="REV 4:5" /><verse number="6" style="v" sid="REV 4:6" />Langkwoi tthasi bǝ ǝǝ yigwoi lǝ nung akun tthǝ mangǝn nwam gilas, kai mangǝn tal kwɔ dǝnni lu angǝ kristal ɓǝ.</para>
  <para style="p" vid="REV 4:6">Kwar bǝ ǝǝ yigwoi ɓǝ lona a nwua ǝndǝi, nung nwongǝi tthǝ ni nai nung lǝilǝ tthǝi ǝndǝi tthasi i tthasua <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />Nung nwongǝi a nwasiu ɓǝ mangǝ ǝn zua; a rabbu mangǝn yui nyak; dang nung a tai mangǝn dang nung thayuu; a nai ɓǝ mangǝ ǝn tha kwɔ dǝna yaɓǝ. <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />I nung nwongǝi kwɔ nai kwɔ nwakanni nanakun i kwɔ ǝndǝi langkwoi nung lǝilǝ tthǝi ǝndǝi, ttha dang i ttha gwam ǝndǝi. Nungvii i dang fuh i kǝr bǝ luu ɓin lǝu angǝ:</para>
  <para style="q1" vid="REV 4:8">Ya langǝ i, ya langǝ i, ǝn Dangbang Fuh Ya angǝ a,</para>
  <para style="q2" vid="REV 4:8">yuu akwɔ viikwɔ, yuu kwɔ lakwɔ langkwoi yuu akwɔ dǝna wɔ ɓǝ.&gt;&gt;<verse eid="REV 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9" />Ya nwongǝi nai kwɔ dǝna luu ɓin ghaali i bǝ dǝ angǝ a ibǝ to sakko lǝ yuu akwɔ dǝna ǝǝ lo bǝ ǝǝ yigwoi lǝɓǝ, yuu akwɔ a ǝǝ laɗing langkwoi laɗing. Kwɔ nǝ dǝi to ni ɓǝ, <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />Yakku kwɔ thǝm kun iu nai kwɔ bai nwa longǝi sua tthasi yuu akwɔ ǝǝ lo bǝ ǝǝ yigwoi kwɔ, langkwoi i wab yuu kwɔ a ǝǝ i nwongǝi laɗing langkwoi laɗing ɓǝ. Dǝnni wa nung muo lo gi lǝtǝ tthasi bǝ ǝǝ yigwoi lǝ dǝi gei angǝ,<verse eid="REV 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11" />&lt;&lt;Dangbang ɓi i Fuh ɓi! A natthǝng</para>
  <para style="q2" vid="REV 4:11">kwɔ ma muo ghaali, ibǝ dǝ ghaali, i ttha ɓǝ.</para>
  <para style="q1" vid="REV 4:11">Bakwɔ a mab nung ǝndǝi,</para>
  <para style="q2" vid="REV 4:11">langkwoi ibǝ yiɗi mǝ i mabǝi langkwoi i nwongǝi.&gt;&gt;<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s">Yui Ɓangam Ɓko Nung Vullǝnung Kwɔ I Kulluam Ɓǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />Ən ɓyǝa nungvullǝ nung kwɔ dǝnni kulluam ɓǝ na a nali gi yuu akwɔ ǝǝ bǝ ǝǝ yigwoi ɓǝ; i vullǝ nung nwangwu lǝ ǝndǝi langkwoi i gol nwuo i nung gol nwanung nanaira. <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />Langkwoi ǝn ɓyǝa gong ya nwatummi, kwɔ gei ba i yol angǝ a angǝ, &lt;&lt;Ən yi natthǝng kwɔ a ɓko nung gol nwa nungvullǝ langkwoi a ɓko nungvullǝ nung ɓa?&gt;&gt; <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />Kwoi yuu akun yangǝu wayi ko i pangsua kwɔ a ɓuan a ɓko nungvullǝ nungɓǝ langkwoi ɓyǝa dang ǝu lǝu. <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />Ən tasui ghaatthǝ bakwɔ i ɓuan i tǝi yuu akun kwɔ natthǝ kwɔ aɓau nungvullǝ nungɓǝ ko a ɓyǝa dang ǝu ɓǝlǝu. <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />Yang yuu akun dang yakku lǝ geim angǝ, &lt;&lt;Bǝ a tasui thǝ. A ɓyǝa! Zua kab gwoi ya Yahuza, gong bǝba Dawuda, tang long, langkwoi u ɓuan u ɓko nung gol nungvullǝ nungkwɔ nanaira kwɔ langkwoi a ɓko nungvullǝ nungɓǝ.&gt;&gt; <verse eid="REV 5:5" /><verse number="6" style="v" sid="REV 5:6" />Yang ǝn ɓyǝa Yui ɓangam dǝi nung ganglang bǝ lo yigwoi lǝ, kwɔ i nung nwongǝi kwɔ nai kwɔ kwar dǝi lǝ i yaku kwɔ ɓǝ. Yui ɓangam ɓǝ fuk mangǝttǝn i vuu dulu ǝn vuu. Ɓiu nanaira langkwoi nungǝu nanaira, kwɔ lǝ ɓyang gi Fuh nanaira kwɔ tum lǝ bǝi dang longwam ǝndǝi ɓǝ. <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />Yui ɓangam ɓǝ pa tǝ lǝi nung vullǝ nungɓǝ lona a nali gi yuu akwɔ ǝǝ lo nung ǝǝ yigwoi ɓǝ. <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />Langkwoi kwɔ u lǝi nungvullǝ nung kwɔ, i nung nwongǝi kwɔ nai kwɔ i yaku kwɔ thǝm kun iu nai kwɔ bai nwa longǝi sua tthasi Yui ɓangam lǝ. Ko ǝnya dang ǝi lǝ muo garaya i taso zinariya turare kwɔ dǝnni li i lua kwɔ yitthǝ, kwɔ lǝ bǝ pinwa yayuu gi Fuh ya langǝ i. <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />I luu ɓin afu angǝ:</para>
  <para style="q1" vid="REV 5:9">&lt;&lt; A natthǝng kwɔ ma lǝi nungvullǝ nungɓǝ</para>
  <para style="q2" vid="REV 5:9">langkwoi aɓau nung gol nwuo.</para>
  <para style="q1" vid="REV 5:9">Bakwɔ i thǝb ba, langkwoi ɓua mǝ kwɔ lǝ nung nyǝkgǝi kwɔ a sob lo yayuu i zii mǝ tthǝ Fuh lǝ</para>
  <para style="q2" vid="REV 5:9">yayuu kab gwoi kwɔ ǝndǝi, nwa, losua i thayuu.<verse eid="REV 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10" />A mabbǝi losua yigwoi tthǝ langkwoi ya Nyǝknung yangbǝ i to nungto lǝ Fuh tthǝ bǝ loyigwoi gu,</para>
  <para style="q2" vid="REV 5:10">langkwoi i loyigwoi lo longwam.&gt;&gt;<verse eid="REV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />Langkwoi ǝn ɓyǝa, ǝnlǝ ya nwatummi, i thǝmsob ɓua nu i dugǝi kpaatthǝ! I kwar bǝ ǝǝ yigwoi ɓǝ i dǝilǝ, ya nwongǝi kwɔ nai kwɔ, i yakku, <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />langkwoi i luu ɓin i yol angǝ a angǝ:</para>
  <para style="q1" vid="REV 5:12">&lt;&lt;Yui ɓangam kwɔ i thǝu kwɔ u natthǝng</para>
  <para style="q2" vid="REV 5:12">kwɔ u muo ttha, nungtǝi, yiggǝi, i nyimmi,</para>
  <para style="q2" vid="REV 5:12">bǝ dǝ ghaali, angǝ a, i bǝ kha bǝi!&gt;&gt;<verse eid="REV 5:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="REV 5:13" />Langkwoi ǝn lǝ i nung nwongǝi ǝndǝi wayi, pangsua, longwam pisua, langkwoi dang nwam-nung a nwongǝi ǝndǝi longwam i wayi- langkwoi dǝnni luu ɓin angǝ:</para>
  <para style="q1" vid="REV 5:13">Sua yuu akwɔ ǝǝ lo nung ǝǝ yigwoi langkwoi sua Yui ɓangam,</para>
  <para style="q2" vid="REV 5:13">bǝ kha bǝi i ghaali, angǝ a i ttha,</para>
  <para style="q2" vid="REV 5:13">laɗing langkwoi laɗing!&gt;&gt;<verse eid="REV 5:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="REV 5:14" />I nung nwongǝi kwɔ nai kwɔ gwabnwa angǝ, &lt;&lt;Dǝitthǝ manungɓǝ!&gt;&gt; Langkwoi yakku ɓǝ bǝrsua tthasiu i wabbu.<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s">I Nung Gol Nwa Nungvullǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />Yang ǝn ɓyǝa Yui ɓangam ɓǝ thang nungkwɔ ɓko akun dang nung gol nwa nungvullǝ nung kwɔ nanaira kwɔ, langkwoi ǝn lǝ yuu akun dang nung nwongǝi kwɔ nai kwɔ gei i yol kwɔ mangǝn gamvǝr kwɔ angǝ, &lt;&lt;A wuo!&gt;&gt; <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />Langkwoi ǝn ɓyǝa, prǝ a vǝrǝm tthǝ bǝilǝ. Ya kogǝu muo kantko nkolǝ, langkwoi i mu nung muo lo tthǝ. U kog mangǝn ya tang lo dǝna tǝbǝ tang lo.<verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />Yang Yui ɓangam ɓǝ tthang u ɓko nung gol nwa nung vullǝ ɓǝ a nung rab bu; langkwoi ǝn lǝ nung nwongǝi a nung rab bu gei angǝ, &lt;&lt;A wuo!&gt;&gt; <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />Prǝ akun fukgwam, a thǝnni. I dǝ ttha lǝ ya kogǝu u lǝi bǝ ǝǝ a langǝ i longwam, Yangbǝ yayuu thǝb tha. I du gong khafǝi.<verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />Yang Yui ɓangam ɓǝ tthang langkwoi ɓko nung gol nwa nungvullǝ a tai tthǝu; langkwoi ǝn lǝ nung nwongǝi a nung taiu gei angǝ, &lt;&lt;A wuo!&gt;&gt; Ən ɓyǝa, langkwoi prǝ a ɓilǝng bǝilǝ. Ya kogǝu muo nung na nung rab nkolǝ. <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />Ən lǝ nung akun gwab mangǝn yol dǝna wɔ dang i nung nwongǝi kwɔ nai kwɔ, kwɔ gei angǝ, &lt;&lt;Alkama na kun i ɗyǝab lo nungkurɓǝ thǝm nu, langkwoi shai'r na tai i ɗyǝab nungkurɓǝ thǝm nu. Kwoi bǝɓa ɓanglǝ nui zaitun i nuiu thǝ!&gt;&gt;<verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />Yang Yui ɓangam ɓǝ tthang langkwoi ɓko nung gol nwa nungvullǝ a nai ɓǝ; langkwoi ǝn lǝ nung nwongǝi a nai ɓǝ gei angǝ, &lt;&lt;A wuo!&gt;&gt; <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />Ən ɓyǝa, langkwoi prǝ akwɔ mungyǝng tthǝu kaiu ɓǝ. Ɗuǝn ya kogǝu ǝn Ɓua, langkwoi Hades dǝna muo suo. I ji ttha lo yayuu gabǝi nai ya longwam, i thǝi i nunglǝi bǝ taɓui, gwom, nungzii i nyam dang ug.<verse eid="REV 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />Yang Yui ɓangam ɓǝ tthang langkwoi ɓko nung gol nwa nungvullǝ ɓǝ a nu tthǝu. Ən ɓyǝa pi sua tuu killǝng yakwɔ i thǝi bakwɔ i gei ba Fuh langkwoi i dǝnyitthǝ nung to gi. <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />I buogbǝi i yol ghaatthǝ angǝ, &lt;&lt;Dangbang Ya angǝ a, ya langǝ i langkwoi ba a langǝ i! A tuu nǝnǝ yangbǝ a to kwan lǝ ya longwam tthǝ langkwoi a ɗabluai ba zii ɓi?&gt;&gt; <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />Ko ǝn ya dang ǝi lǝ i du nunglitthǝ a vǝrǝm, langkwoi i gei angǝ i nwong natthǝ tuab, nǝ ya youngǝi i alo bǝ thǝb bǝi ɗǝ, manungkwɔ i ǝǝ ɓǝ.<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />Langkwoi ǝn ɓyǝa Yui ɓangam ɓǝ tthang langkwoi i ɓau nung gol nwa nungvullǝ nungɓǝ a nanakun. Pangsua thǝuri ghaatthǝ, langkwoi fuh mǝrǝm la ɓilǝng mangǝn nunglitthǝ a ɓilǝng zǝlǝm, langkwoi fih mǝrǝm la thǝnni ǝndǝi mangǝ ǝn zii. <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />I vin pin wayi wuu al pangsua, mangǝ ǝn gol kwɔ ɗuong lǝu kwɔ nǝ wa a nyimmi nǝ thǝuri ɓǝ. <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" />Wayi la nǝkwam mangǝn nungvullǝ nungkwɔ i kuluam ɓǝ, langkwoi i tal a nwua i gum i tǝni bǝikwɔ i dǝitthǝ ɓǝ. <verse eid="REV 6:14" /><verse number="15" style="v" sid="REV 6:15" />Yang ya yigwoi longwam, ya dǝkab nwa nung i yakku ya taɓui, ya nungtǝi i ya ttha, i sua yayuu ǝndǝi, ya thǝb i yakwɔ ǝnya thǝb lǝu kwɔ, i pyǝa dang ɓua langkwoi ɓǝmtal lo tal lǝ. <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" />I gei tal i ɓǝmtal angǝ, &lt;&lt; A o loɓi a khaɓi nung yuu akwɔ ǝǝ lo nung ǝǝ yigwoi langkwoi tthǝ nyi gi Yui ɓangam! <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />Vii nyi gi angǝ a wɔng, langkwoi ǝn yittǝn a ɓuan a nyimnyi?&gt;&gt;<verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s">Ya Israila 144,000</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />Tthasua nungkwɔ ǝn ɓyǝa ya nwatummi gi Fuh nai dǝi lona longwam nai, i muo natthǝ nwakan nai yangbǝ bǝ wa ɓuob lo longwam ko lo nwam ko ɓuob tthǝ kab akun. <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />Langkwoi ǝn ɓyǝa ya nwatummi akun ǝrr gwɔpi lǝ dǝna wɔ i nung gol nwa nung gi Fuh ya nwongǝi. U lubǝi ya nwatummi gi Fuh kwɔ nai kwɔ i yol angǝ a kwɔ Fuh ji ttha i ɓanglǝ pangsua i nwam. <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />Ya nwatummi ɓǝ gei angǝ, &lt;&lt;Bǝɓa nkoni pangsua, nwam, ko i kab thǝ nǝ ɓi ɓyǝa nungɓi tthǝ ya thǝb gi Fuh i nung gol nwa nung gu nwaɗasi ɗǝ.&gt;&gt; <verse eid="REV 7:3" /><verse number="4" style="v" sid="REV 7:4" />Langkwoi i geim angǝ lo yayuu yakwɔ i ɓii nungɓii i nungɓii gi Fuh nwaɗasi kwɔ i 144,000. I ǝnya kabgwoi ya Israila sob iu rab, <verse eid="REV 7:4" /><verse number="5" style="v" sid="REV 7:5" />I gol ya kabgwoi ya Yahuza yayuu 12,000, kabgwoi Ra'ubainu 12,000, ya kabgwoi Gad 12,000, <verse eid="REV 7:5" /><verse number="6" style="v" sid="REV 7:6" />ya kabgwoi Ashiru 12,000, ya kabgwoi Naftali 12,000, ya kabgwoi Manassa 12,000, <verse eid="REV 7:6" /><verse number="7" style="v" sid="REV 7:7" />ya kabgwoi Saminu 12,000, ya kabgwoi Lawi 12,000, kabgwoi Isaka 12,000, <verse eid="REV 7:7" /><verse number="8" style="v" sid="REV 7:8" />i gol ya kabgwoi Zabaluna 12,000, i gol kabgwoi Yusufu 12,000, i gol ya kabgwoi Biliyaminu 12,000.<verse eid="REV 7:8" /></para>
  <para style="s">Gong Kon Losua Longwam Əndǝi</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />Tthasua nungkwɔ, langkwoi tthasim lǝ ǝn ɓyǝa gong kon yayuu- yuu yangǝu a than yayuu ɓǝ ǝndǝiu! I ǝn ya losua a nwa ǝndǝi, ya nwa, losua i nwagwoi, langkwoi i dǝi tthasi bǝ ǝǝ gi yigwoi lǝ langkwoi i Yui ɓangam lǝ, i li nunglitthǝ la vǝrǝm langkwoi i muo yangkab manja nailǝ. <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />I lubǝi i yol angǝ a angǝ, &lt;&lt;Bǝ nwongbǝi wuo bǝgǝ Fuh ɓi, yuu akwɔ ǝǝ lo nung ǝǝ yigwoi ɓǝ, langkwoi bǝgǝ Yui ɓangam!&gt;&gt; <verse eid="REV 7:10" /><verse number="11" style="v" sid="REV 7:11" />Ya nwatummi gi Fuh kwar bǝ ǝǝ yigwoi ɓǝ dǝilǝ, yakku i nung nwongǝi kwɔ nai kwɔ. Yang i lo pangsua i kiblǝ kib i dang nung tthasi bǝ ǝǝ yigwoi lǝ langkwoi i wab Fuh, <verse eid="REV 7:11" /><verse number="12" style="v" sid="REV 7:12" />dǝi gei angǝ, &lt;&lt;Dǝitthǝ manungɓǝ! Kha bǝi, ghaali, yiggǝi, bǝ to sakko, bǝ dǝ ghaali, ttha, nyimmi ǝn a bǝ Fuh ɓi laɗing langkwoi laɗing! Dǝitthǝ manungɓǝ!&gt;&gt;<verse eid="REV 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />Yuu akun dang yakku ɓǝ ɓibbǝm angǝ, &lt;&lt;Yakwɔ li nunglitthǝ la vǝrǝm kwɔ ǝnya ɓǝttǝn, langkwoi i ǝrr ɓǝla?&gt;&gt;<verse eid="REV 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14" />&lt;&lt;Ən ibǝi lǝu, yikku.&gt;&gt; Ən gwabnwa geigǝ a ibǝing.</para>
  <para style="p" vid="REV 7:14">U geim angǝ, &lt;&lt;Yayuu akwɔ ǝn yakwɔ i dang bǝ to bǝi lǝ zuii latthǝ ɓǝ. I ɗiggǝ nunglitthǝ gi i mab matthǝ i zii Yui ɓangam. <verse eid="REV 7:14" /><verse number="15" style="v" sid="REV 7:15" />Nungkwɔ to i dǝi tthasi bǝ ǝǝ yigwoi gi Fuh dǝi tou nung to tthǝ dang fuh i nungvii dang kǝm nyǝknung gu. Yuu akwɔ ǝǝ lo nung ǝǝ yigwoi kwɔ a kangǝ i. <verse eid="REV 7:15" /><verse number="16" style="v" sid="REV 7:16" />I lǝ gwom akunu ko ɗimung; ko fuh ko sɔnni tang bǝi a tangǝ i, <verse eid="REV 7:16" /><verse number="17" style="v" sid="REV 7:17" />bakwɔ Yui ɓangam, kwɔ ǝǝ nung ganglang bǝ ǝǝ yigwoi kwɔ, ulǝ ya gagciǝ, langkwoi u osi u tǝlǝ bǝ nyinyak kwɔ dǝna dǝ nwongǝi ɓǝ. Langkwoi Fuh a fa mungnung kwɔ ǝndǝi nungǝilǝ.&gt;&gt;<verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s">Nung Gol Nwanung A Nanaira</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />Kwɔ yui Ɓangam ɓǝ tthang langkwoi ɓko nwa nung gol nwa nung a nanaira kwɔ, bǝi gan nǝkwam wayi gɓag bǝ gab dang lona kun. <verse eid="REV 8:1" /><verse number="2" style="v" sid="REV 8:2" />Yang ǝn ɓyǝa ya nwatummi gi Fuh kwɔ nanaira kwɔ dǝi tthasi Fuh, langkwoi i ji ɓii ni nanaira.<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />Ya nwatummi gi Fuh akun, kwɔ muo nung dǝ turare Zinariya kwɔ dǝi li i lua kwɔ ɓǝ, wuu dǝi tthasi tuu. I duu turare kpaatthǝ yangbǝ u lilǝ lo bǝ pinwa lǝ yayuu ya langǝ i tthǝ ǝndǝi yang u dǝ lo tuu zinariya bǝ lo yigwoi. <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />Duu turare kwɔ i li kwɔ tǝ wayi i bǝ pinwa yayuu ya langǝ i gi Fuh na ya nwatummi gi Fuh kwɔ dǝi tthasi Fuh ɓǝ. <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" />Yang ya nwatummi gi Fuh lǝi nung al turare ɓǝ, u al lua kwɔ nwa tuu lǝ ɓǝ, langkwoi wa wuu o longwam lǝ. Nungkwɔ bǝ thǝuri nung gwab i gamvǝr, i lua gabbǝi, i bǝ thǝuri gi pangsua.<verse eid="REV 8:5" /></para>
  <para style="s">I Ɓii Nanaira</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />Yang ya nwatummi gi Fuh kwɔ nanaira kwɔ mabzuii bǝ ɓi ɓii kwɔ nanaira ɓǝ.<verse eid="REV 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />Ya nwatummi a nwasiu ɓi ɓii gu. Nungkwɔ mung a tǝmmi i lua, langtha i zii, pin dǝna al longwam. Lua li longwam a tai, i kab, i gug aɓoi ǝndǝi.<verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />Yang ya nwatummi gi Fuh a rab ɓi ɓii gu. Nung akun ghaatthǝ mangǝ ǝn tal kwɔ lua dǝna li kwɔ i wa dang nwam. Nwam a tai mǝrrǝm lǝ zii,<verse eid="REV 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 8:9" />nung nwongǝi a nung tai dang nwam kwɔ ɓui, langkwoi i ɓanglǝ i kwai a nung taiu.<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />Yang ya nwatummi gi Fuh a taiu ɓi ɓii gu. Gong vin, dǝna li mangǝ ǝn nung tam lua, pin wayi wuu o langkwoi o lo i dual a nung taiu langkwoi lo mung bǝ nyinyak. <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />(Ɗuǝn vin ɓǝ ǝn&lt;&lt;Nung a nyinyi.&gt;&gt;) Mung a nungtai ɓǝ mǝrrǝm lǝ a nyinyi, langkwoi yayuu ɓui kpaatthǝ lǝ ba bǝ nwa mungki ɓǝ, bakwɔ mǝrrǝm lǝ a nyinyi ɓǝ.<verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />Yang ya nwatummi a nung nai ɓi ɓii gu. Ərr i ɓuob fuh a dang tai, i fih a kun dang tai, vin a kun dang tai, yangbǝ bǝ yummi gi a nung taiu la nǝkwam; lua gabbǝi yangǝu dang fuh a kun dang tai a nungvii langɓǝ.<verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />Yang Ən ɓyǝa, langkwoi ǝn lǝ Juhurma dǝna ya tuutthǝ lo wayi dǝna gei yollu ta tthǝ angǝ, &lt;&lt;Əi nung dǝ vulli! Nung dǝ vulli! Ɓa tozuii nǝnǝ ɓǝ yakwɔ ɓa ǝǝ longwam kwɔ nǝ yol ɓii nǝ wuo kwɔ sua ya nwatummi gi Fuh nǝ ɓi ɓii ɓǝ!&gt;&gt;<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />Yang ya nwatummi gi Fuh a nu ɓi ɓii gu. Ən ɓyǝa vin kwɔ wuo wayi wuu o pangsua kwɔ ɓǝ, langkwoi i du nung ɓko nwakǝm kong ɓua kwɔ tuni ɓǝ. <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />Vin ɓǝ ɓko nwa kong ɓua kwɔ tuni ɓǝ, langkwoi duu dǝna i dang ǝu, mangǝ ǝn duu dang lua angǝ a; luafuh i waa baithǝl lǝ ba duu kwɔ dǝna i dang ɓua ɓǝlǝ ɓǝ. <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />I thǝl i dang duu lǝ pin dang longwam, langkwoi i ji ttha manung a bǝ nyang. <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />I gei angǝ bǝ i nkoni gug longwam ko kab ko nung bie akun thǝ; i to nung lǝ yayuu akwɔ yangǝu i nungɓii gol nung gi Fuh nwaɗǝgsii lǝu ɓǝ.<verse eid="REV 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 9:5" />I gwab lǝ i thǝl ɓǝtthǝ i thǝb thayuu lǝu, kwoi i ji zuii fi nu ɓuo. Ziili gi zuii kwɔ dǝnni dǝkwɔ natha i bǝ tabǝi gi nyang.<verse eid="REV 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 9:6" />Dang fi nu kwɔ i ɗuu bǝ ɓuiɓua, kwoi i tǝiu; i yiɗi bǝ ɓuiu, langkwoi ɓua a padum a yiǝ.<verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />I thǝl ɓǝ mangǝttǝn ǝn prǝ kwɔ i mabǝi dǝnni tǝbǝ taɓui ɓǝ; i kuluam nung akun loilǝ mangǝn nung muo lo zinariya, langkwoi dang nungǝi mangǝn dang nung thayuu. <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />Byangloi mangǝttǝn ǝn byanglo yasi, lǝi mangǝ ǝn lǝi zua. <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />I lam nyingwui i nung akun mangǝ ǝn nung kha nyingwu ɓui, langkwoi vǝm nwakanni mangǝ yol prǝ kpaatthǝ- dǝna gub keke taɓui dǝna thǝm tthǝi bǝ tǝbǝ taɓui. <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />I tthǝ i thǝng langkwoi dǝi tabǝi mangǝ nyang, langkwoi i thǝngǝi ɓǝlǝ i tǝilǝ ttha kwɔ i nkoni lǝ thayuu fi nu ɓǝ.<verse eid="REV 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 9:11" />I tthǝ i yigwoi kwɔ dǝna lo yigwoi loi ɓǝ, u lǝ ya nwatummi kong ɓua kwɔ tuni ɓǝ. Ɗuǝnu i nwa yahudawa ǝn Abadan, i nwa Helǝnanci ǝn Afoliyon (nung ɓǝlǝ &lt;&lt;Nung ɓanglǝ nung&gt;&gt;)<verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />Zuii a nwasiu paǝng; tthasua akwɔ akun tthǝ rab lasua dǝna wɔ.<verse eid="REV 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />Yang ya nwatummi gi Fuh a nanakun ɓi ɓii gu. Ən lǝ yol dǝna wɔ bǝi nai kwɔ ni nai lo tuu ɓui a yummi kwɔ dǝi ɗǝgsi Fuh ɓǝ. <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />Yol ɓǝ gei lǝ ya nwatummi gi Fuh a nanakun tthǝ kwɔ ɓii nko kwɔ angǝ, &lt;&lt;A yina lǝ ya nwatummi gi Fuh kwɔ ni nai kwɔ i tthǝbǝi dang dual angǝ a Yufiretis ɓǝ!&gt;&gt;<verse eid="REV 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 9:15" />Ya nwatummi gi Fuh kwɔ nai kwɔ i yiǝ na; dang lona ɓǝlǝ kwɔ i vii ɓǝllǝ kwɔ i fih ɓǝllǝ kwɔ i ttha ɓǝlǝ kwɔ i mabtha i ǝǝ yang bǝ i thǝb ya kabgwoi tai gi thayuu. <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />I geim kpaali gi ya soja ya ɗab prǝ tthǝng: loi dugǝi thǝmsob ɓua thǝmkun. <verse eid="REV 9:16" /><verse number="17" style="v" sid="REV 9:17" />Dang muanim Ən ɓyǝa i prǝ i yakwɔ ɗab bǝi ɓǝ: i tthǝ i nung kanyingwu ɓui mangǝ ǝn lua la thǝni, mungyǝng zargina mangǝ ǝn rawaya, langkwoi mangǝ ǝn mung bung yibǝ. Lo prǝ ɓǝ mangǝ ǝn lo zua, langkwoi lua dǝna i nwai lǝ, duu, i lua a vǝrrǝm. <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />Thayuu a tai kwɔ i thǝi i nung lǝi kiggǝ, lua, i duu, i lua a yǝlyǝl dǝna i nwa gi prǝ ɓǝlǝ.<verse eid="REV 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 9:19" />Bakwɔ ttha prǝ ɓǝ tthǝng nwai i thǝngǝi. Thǝngǝi mangǝ ǝn biǝk i loi lǝ, langkwoi nung ɓǝ dǝnni dǝ zuii lǝ yayuu. <verse eid="REV 9:19" /><verse number="20" style="v" sid="REV 9:20" />Sua thayuu, yakwɔ ǝndǝi i thǝi i thǝbǝi kwɔ lǝu, i mǝrrǝm i yitthǝ bǝ wab nungkwɔ i mab i nai ɓǝlǝu. I yitthǝ bǝ wab nungmuo lǝu, i yitthǝ bǝ wab fuh kwɔ nwongǝi gi yangǝu ɓǝ kwɔ i mab i zinariya ɓǝlǝu, i azurfa, ko tagulla, ko tal, langkwoi i kab, kwɔ ɓyǝa bǝiu, lǝɓǝiu, ko thkothko <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />Ko i mǝrrǝm i yitthǝ bǝ thǝbbǝi, ko bǝ tǝsua ya boka, ko bǝ lo i yasi yayuu, i bǝ inung gi.<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s">Ya Nwatummi Gi Fuh I Nungvullǝ A Tuab Kwɔ Dǝnni Kuluam Ɓǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />Yang ǝn ɓyǝa gong ya nwatummi gi Fuh akun pin wayi dǝna wɔ pangsua. I kko dang tǝi langkwoi lamban mǝrrǝm lolǝ kǝb; dang nungǝu mangǝttǝn ǝn fuh a duu, langkwoi kabbo mangǝttǝn ǝn vurri lua. <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />Nungvullǝ nung a tuab ɓkolǝ ɓko nkolǝ. U dǝbo a nali lo nwam langkwoi bo a namai longwam lǝ, <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />langkwoi ǝrr u buogbǝi i gong yol mangǝttǝn ǝn yol i zua. Tthasua kwɔ u lubǝi kwɔ, gamvǝr kwɔ nanaira kwɔ gwabnwa. <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />Dangtthǝ kwɔ i gei ba ni, Dǝmǝn yiɗi bǝ vullǝ nung. Kwoi ǝrr ǝn lǝ yol gei ba wayi lǝ angǝ,&lt;&lt;A pyǝa lo nungkwɔ gamvǝr kwɔ nanaira kwɔ gei ɓǝ; bǝ a vullǝ thǝ!&gt;&gt;<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />Yang ya nwatummi gi Fuh kwɔ Ən ɓyǝa dǝi lo nwam langkwoi i longwam kwɔ lǝi nko a nali wayi <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />langkwoi lǝi zuu nung dang ɗuǝn Fuh, kwɔ ǝǝ i nwongǝi laɗing kwoi la ɗing ɓǝ, yuu akwɔ mab wayi, i pangsua, langkwoi i nwam, i nung ǝndǝi kwɔ dang ǝi lǝ ɓǝ. Ya nwatummi gi Fuh ɓǝ gei angǝ, &lt;&lt;Bǝ ki nung akun yangǝu! <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />Kwoi kwɔ nǝ ya nwatummi gi Fuh a nanaira ɓi ɓii gu, yang Fuh a ilǝ nungkwɔ u pya dǝu yiɗi bǝ tou ɓǝ, manungkwɔ u gei nwaba a langǝ i lǝ ya thǝb gu tthǝ ɓǝ, ya gei ba a tthasi.&gt;&gt;<verse eid="REV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8" />Yang yol kwɔ Ən lǝ dǝna gei ba wayi kwɔ geim ba langkwoi angǝ,&lt;&lt;Atǝ ta muo nungvullǝ kwɔ ɓkolǝ ɓko na ya nwatummi gi Fuh kwɔ dǝi lo nwam i pangsua kwɔ ɓǝ.&gt;&gt;<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />Ən tǝ sua ya nwatummi gi Fuh ɓǝ langkwoi ǝn ɓibbu geigǝ u dǝm nungvullǝ nung a tuab ɓǝ. U geim angǝ, &lt;&lt;Ən muo langkwoi ǝn tang; a mǝrrǝm lǝ nung a ǝmmi dang wamǝ, kwoi dang nwamǝ a la mangǝttǝn ǝn song.&gt;&gt;<verse eid="REV 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10" />Ən muo nungvullǝ nung a tuab ɓǝ na ya nwatummi gi fuh langkwoi ǝn tang, kwoi ǝn bang latthǝ mangǝttǝn ǝn song dang nwamlǝ. Kwoi kwɔ ǝn mikwɔ, mǝrrǝmlǝ nung a ǝmmi dang wam lǝ.<verse eid="REV 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 10:11" />Yang langkwoi i geim angǝ,&lt;&lt;Ma gei ba a tthasi ba gi Fuh losua kpaatthǝ, iri yayuu, ya nwa, i ya yigwoi kpaatthǝ.&gt;&gt;<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s">Ya Shǝdǝ Rab</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />Nungkwɔ yang i Dǝm kab kwɔ itha i ɓui na nung ɓǝ, langkwoi i geim angǝ, &lt;&lt; Atǝ ta na kǝm nyǝknung tthǝ Fuh langkwoi i tuu, yang a than ya kwɔ dǝna wab Fuh kǝm nyǝknung lǝɓǝ. <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" />Kwoi bǝ a na i kǝm atuab gwamkǝm nyǝknung ɓǝthǝ, bakwɔ i dǝlǝ yakwɔ ǝn ya Yahudawa lǝu ɓǝ, yakwɔ a tam lo Gwoi Angã a Langǝ i fih thǝmrab iu rab. <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />Mǝn tum ya shǝdǝm kwɔ rab kwɔ li nunglitthǝ tǝr nung ɓǝ, langkwoi i gei ba a tthasi ba gi Fuh villǝ kullo bo thǝmsob ɓua nanakun ilo thǝmtai.&gt;&gt;<verse eid="REV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4" />Ya shǝdǝ kwɔ rab kwɔ ǝn kab zaitun langkwoi ǝn fitilǝ rab kwɔ dǝi tthasi Dangbang ya longwam ɓǝ. <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />Nǝ Yuu akun dǝna yiɗi bǝ thǝbbǝi yang, lua a i dang nwai langkwoi a thǝb ya ɓui gi; langkwoi nunglǝi kwɔ yuu akwɔ nǝ dǝna yiɗi bǝ thǝbbǝi yang i thǝi. <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />I tthǝ i ttha kwɔ i lam wayi yangbǝ bǝ mung nathǝ lona kwɔ dǝnni gei ba gi Fuh ɓǝ. I tthǝ i ttha langkwoi lo bǝ nyinyak, i mǝrǝmmǝi lǝ zii; i tthǝ i ttha langkwoi i ɓuob longwam i nung dǝ zuii kwɔ ǝndǝi lona kwɔ dǝi yiɗi ɓǝ.<verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />Kwɔ nǝ i alo bǝ gei ba gi Fuh yang, nungbyang kwɔ i dang kong ɓua kwɔ tuni ɓǝ a ɓuob vǝm i ilǝ. A tang lo loi langkwoi u thǝbbǝi,<verse eid="REV 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 11:8" />langkwoi kwamɓui alo lo nunglǝi ganglang gwoi angǝ a, bǝikwɔ i pi Dangbang gi tthǝ lo kab gangǝ i ɓǝ. Killǝng ɗuǝn gwoi angǝ a ɓǝ kullo angǝ ǝn Sadoma, ko Masar dang ɓyang lǝ.<verse eid="REV 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 11:9" />Yayuu ya losua ǝndǝi, ya kabgwoi, i ya nwa, langkwoi thayuu a ɓyǝa kwamɓui bo tai i gabbǝi langkwoi i gwab i suiu dang juǝn nu.<verse eid="REV 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 11:10" />Ya longwam a lǝ tthǝla lǝ ba i kwɔ rab kwɔ i ɓui ɓǝ. I to ɓang langkwoi i dǝnung lǝtha, bakwɔ i ya gei ba a tthasi kwɔ rab kwɔ wuolǝ zuii lǝ yayuu ɗing longwam.<verse eid="REV 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 11:11" />Tthasua bo tai i gabbǝiu nwongǝi bǝ gǝ Fuh wuo tǝ tthǝi, yang i dǝinǝbo; yang yakwɔ ǝndǝi ɓyǝai kwɔ tthǝi survulli ghaatthǝ. <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />Yang ya gei ba a tthasi kwɔ rab kwɔ a lǝ yol ghaatthǝ wayi gei angǝ,&lt;&lt;Ɓa ɗab ɓa wɔ bǝikwɔ!&gt;&gt;Kwɔ ya ɓui gi dǝi dǝna ɓyǝai, i ɗab itǝ wayi dang tǝi.<verse eid="REV 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 11:13" />Dang lona ɓǝlǝ kullo pangsua a thǝuri ghaatthǝ; gwoi angǝ a kun dang gwoi angǝ a kwɔ sob kwɔ ɓanglǝ, langkwoi i thǝb yayuu thǝmsob ɓua thǝmkun oli. Sua yayuu a survulli ghaatthǝ langkwoi i kha ghaali gi Fuh ya wayi. <verse eid="REV 11:13" /><verse number="14" style="v" sid="REV 11:14" />Zuii a rabbu paang, kwoi zuii a taiu dǝna wɔ nǝnǝng kwɔ!<verse eid="REV 11:14" /></para>
  <para style="s">Ɓii A Nanaira</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />Yang ya nwatummi gi Fuh a nanaira a ɓi ɓii gu, langkwoi yang yol a ǝrr nyimtthǝ wayi, dǝna gei angǝ,&lt;&lt;Ttha bǝ lo yigwoi lo longwam lakwɔ ǝn a bǝ Dangbang ɓi langkwoi i Kristi gu, langkwoi u lo yigwoi laɗing langkwoi aɗing!&gt;&gt; <verse eid="REV 11:15" /><verse number="16" style="v" sid="REV 11:16" />Yang yakku thǝmkun iu nai kwɔ ǝǝ lonung ǝǝ bǝ lo yigwoi gi kwɔ dang si Fuh kwɔ ǝrr bǝrsua tthasi Fuh langkwoi i wab Fuh, <verse eid="REV 11:16" /><verse number="17" style="v" sid="REV 11:17" />dǝnni gei angǝ:</para>
  <para style="q1" vid="REV 11:17">&lt;&lt;Dangbang Fuh Ya angǝ a, yuu kwɔ lakwɔ langkwoi a vii kwɔ!</para>
  <para style="q1" vid="REV 11:17">Dǝɓi toa sakko angǝ a lǝi ttha angǝ a</para>
  <para style="q2" vid="REV 11:17">langkwoi a baipi bǝ lo yigwoi mǝ ɓǝ!<verse eid="REV 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18" />Dangwa yakwɔ i Fuh lǝu kwɔ ɓanglǝ,</para>
  <para style="q2" vid="REV 11:18">bakwɔ lona nyimǝ wuong ɓǝ,</para>
  <para style="q2" vid="REV 11:18">lona bǝto kwan lǝya ɓuiɓua tthǝ.</para>
  <para style="q1" vid="REV 11:18">Lona wɔng kwɔ i kwai than ya thǝb mǝ ya langǝ i, ya gei ba a tthasi,</para>
  <para style="q2" vid="REV 11:18">langkwoi i yayuu mǝ ǝndǝi, yakwɔ ǝndǝi dǝna da angǝ a ɓǝ,</para>
  <para style="q2" vid="REV 11:18">angǝ a i a tuab natha.</para>
  <para style="q1" vid="REV 11:18">Lona wɔng kwɔ i ɓanglǝ yakwɔ ɓanglǝ longwam ɓǝ!&gt;&gt;<verse eid="REV 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />I ɓko kǝm nyǝknung gi Fuh wayi lǝ, langkwoi i ɓyǝa tthko dǝ ganglang. Yang i ɓyǝa bǝ gabbǝi gi lua, nung dǝna gwabnwa, kwoi yol gamvǝr, pangsua thǝuri i bǝ al gi mung nungzirital.<verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s">Yisi I Gong Biǝk</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />Yang gong nung dǝ vulli langkwoi fug wayi lǝ. Yisi akun tthǝ, kwɔ nunglitthǝ gu ǝn fuh adu langkwoi u dǝ bo lo fih langkwoi i mai lo i vin sob iu rab. <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />Sua tulǝu u si yui, langkwoi nungzi i zuii bǝ si yui ɓǝ tou dǝu tasui.<verse eid="REV 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3" />Kwoi gong nung dǝ vulli akun i fug yi lǝ. Gong biǝk akun la thǝnni lo nanaira ɓiu sob langkwoi i mai lo ɓǝkwɔ ǝndǝi ni nanaira kwɔ ɓǝ. <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />Gong biǝk ɓǝ gub vin a tai ɓǝ tthangǝu yi lǝ u wai lǝtǝ pangsua. U dǝi dang si yisi ɓǝlǝ, yangbǝ u tang yuiu thǝmtthǝ nǝ u si ɓǝ. <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />Yang u si yui lǝ yiɓǝi, kwɔ a loyigwoi lo ya losua lǝ ǝndǝi i kab ɓui. Kwoi i dko yui ɓǝ nkolǝ i lǝi i tǝlǝ sua Fuh lo nung ǝǝ yigwoi gu. <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />Yisi ɓǝ sur tǝ losua kwi, bǝi kwɔ Fuh mabbu tthǝ ɓǝ, bǝilǝ kwɔ i tthko bo thǝmsob ɓua nanakun ilo thǝmtai.<verse eid="REV 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7" />Yang ɓui ǝrr wayi. Mikailu i ya nwatummi gu ǝrrlǝ ɓui lo gong biǝk kwɔ, kwɔ ɓuob vǝm i ya nwatummi gi gong biǝk ɓǝ; <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />kwoi i tanglo lo biǝk lǝ, langkwoi u i ya nwatummi gu i gwabbǝi tthǝ i ǝǝ wayi akun lǝu. <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" />I wa gong biǝk ɓǝlǝtǝ-byǝak a nungsi kwɔ, ɗuǝnnu ǝn Mungkulum ɓǝ, ko Shǝtan, kwɔ ɗam ya longwam ǝndǝi ɓǝ. I wko lǝtǝ longwam, langkwoi i ya nwatummi gu ǝndǝi.<verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />Yang ǝn lǝ yol ghaatthǝ wayi dǝna gei angǝ, &lt;&lt;Lakwɔ bǝ Sob lo gi Fuh wung! Lakwɔ Fuh to nung to i ttha Yigwoi guǝng! Lakwɔ Kristi gu to nung to i ttha guǝng! Bakwɔ yuu akwɔ dǝi ɗǝgsi Fuh vii ǝndǝi dǝna ɓuobnwa lo ya young ɓi tthǝ Fuh kwɔ i nanu wayi lǝng. <verse eid="REV 12:10" /><verse number="11" style="v" sid="REV 12:11" />I tang ɓui lo lǝng i zii Yui ɓangam langkwoi i ba a langǝ i gi kwɔ dǝnni gei ɓǝ; langkwoi dǝnni yiɗi bǝ dǝ nwongǝi gi yang i ɓui.<verse eid="REV 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 12:12" />Langkwoi ɓa lǝ tthǝla, ya wayi, i yakwɔ ǝǝ bǝilǝ kullo ɓǝ! Kwoi a ɓko lǝ ya longwam tthǝ nǝnǝ i nwam! Bakwɔ Mungkullum pin wuo tthang ɓǝng ɓǝ, langkwoi nyi yi dang wko, bakwɔ u ibǝing sua lona gu tuabni ɓuo.&gt;&gt; <verse eid="REV 12:12" /><verse number="13" style="v" sid="REV 12:13" />Kwɔ gong biǝk kwɔ ibǝi angǝ i wai lǝtǝ longwam mǝng kwɔ, ǝrr u baipi bǝ nan bǝgǝ yisi kwɔ si yui lǝ yiɓǝi ɓǝ. <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />I dǝ nwakan rab ghaatthǝ lǝ yisi ɓǝ manung a bǝ zurum yangbǝ u ǝrr nwakan u tǝlǝ bǝikwɔ i mabbu tthǝ losua a kwi ɓǝ, bǝikwɔ i tthko tthǝ ttha tai i fih nanakun, yangbǝ i nwongǝu tthǝ biǝk kwɔ a kǝn tthangǝu. <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />Langkwoi yang gong biǝk ɓǝ al mung ɓuommi sua yisi ɓǝlǝ mangǝn dual, yangbǝ lǝiu pa lǝ. <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />Kwoi pangsua nwong yisi ɓǝ; ɓko nwko nwa lǝ mungki ɓǝ kwɔ dǝna i dang nwa gong biǝk lǝɓǝ. <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />Gong biǝk ɓǝ ɓanglǝ dang wa tthǝ yisi ɓǝlǝ langkwoi u ǝrr angǝ tǝi ɓuob vǝm i ya bǝpi gi yisi ɓǝlǝ ǝndǝi, yakwɔ ǝndǝi dǝna to nung to i zuu gi Fuh langkwoi dǝna dǝnyitthǝ ba a langǝ i manungkwɔ Yeso geiɓǝ. <verse eid="REV 12:17" /><verse number="18" style="v" sid="REV 12:18" />Langkwoi gong biǝk ɓǝ dǝilo suazuii nwam.<verse eid="REV 12:18" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s">Nyam Dangug Rab</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />Yang ǝn ɓyǝa nyam dang gug akun dǝna i nung nwam ɓǝlǝ. Ɓiu ni sob langkwoi lo nanaira; ɓiu kwɔ ǝndǝi nung muo lo tthǝ, langkwoi lo lǝ ǝndǝi ɗuǝn tthǝ kwɔ i dal lǝ Fuh ɓǝ. <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />Nyam dang gug ɓǝ itha i nyamsɔ, langkwoi nwaǝnzinko i nwuo mangǝ ǝn a bǝ beyar langkwoi nwko mangǝ ǝn nwa zua. Nung wabǝi ɓǝ dǝ nyam dang ug ɓǝ ttha, lo nung ǝǝ yigwoi gu, langkwoi i ttha tthǝ nyimmi gu. <verse eid="REV 13:2" /><verse number="3" style="v" sid="REV 13:3" />Lo nyam dang gug ɓǝ akun mangǝ tǝn i nkoniu ghaaɗing, langkwoi u tǝi tthǝlang. Lo ya longwam ǝndǝi dǝna fǝm lǝ ba nyam dang gug langkwoi dǝnni muo suo. <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />Yayuu ǝndǝi dǝna wab gong biǝk bakwɔ u dǝ ttha gu lǝ nyam dang gug ɓǝɓǝ. Dǝnni wab nyam dang gug ɓǝ langɓǝ, dǝnni gei angǝ,&lt;&lt;Ən yiǝ mangǝ ǝn nyam dang gug ɓa? Ən yiǝ a ɓuob vǝm i ulǝ?&gt;&gt;<verse eid="REV 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5" />I dǝ ttha lǝ nyam dang ug ɓǝ dǝna to lo angǝ a dǝna dal Fuh, langkwoi u tǝi nunglǝi i tthǝ nyimi fih tthǝmrab iu rab. <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />U baipi bǝ dal Fuh, ɗuǝnu, tǝbǝ kwɔ u ǝǝ tthǝ ɓǝ, i yakwɔ ǝǝ wayi ǝndǝi ɓǝ. <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />I duu nunglǝi u ɓuob vǝm i yayuu gi Fuh ya langǝ i langkwoi u tangǝ i, langkwoi i duu ttha lo ya bǝpi ǝndǝi, losua, nwa, i yayuu ǝndǝi.<verse eid="REV 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 13:8" />Yayuu ǝndǝi longwam a wabbu, yakwɔ wabbu kwɔ ǝn yakwɔ i vullǝ ɗuǝnni dang nungvullǝ nwongǝi nwuni bǝ i mab longwam kwɔ i ǝn a bǝ yui Ɓangam kwɔ i thǝb ɓǝ.<verse eid="REV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9" />&lt;&lt;Ɓa lǝ, lakwɔ, nǝ ɓǝ tthǝ i ɓuasui lǝ ba yang ɓa lǝ! <verse eid="REV 13:9" /><verse number="10" style="v" sid="REV 13:10" />Yuu akwɔ nǝ angǝ i muu yang i muu ǝn muo; yuu akwɔ nǝ angǝ i thǝu i khafǝi yang i thǝu i khafǝi. Bakwɔ dǝna gei ɓi tthǝ angǝ ɓi nyimnyi langkwoi ɓi dǝnyitthǝ yayuu gi Fuh ya langǝ i.&gt;&gt;<verse eid="REV 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />Langkwoi ǝn ɓyǝa nyam dang gug ɓǝ akun, dǝna i dang longwam. Ɓiu rab manung a bǝ ɓi ɓangam, kwoi dǝu gei ba mangǝ ǝn nung wabbi. <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />Dǝu to nung to i ttha nungwabbi a nungsi ǝndǝi kwɔ u lǝi nwuo ɓǝ, langkwoi u mǝrrǝm longwam i nungkwɔ dang ǝu kwɔ ǝndǝi dǝna wab nyam dang gug a nungsi ɓǝ, kwɔ i nkoniu ghaatthǝ langkwoi u tǝi tthǝla ɓǝ. <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />Nyam dang gug a nung rabbu to nungfǝmlo ghaaɗing, u to lua pin wayi wuo longwam wuu al dang nung yayuu ǝndǝi. <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />Langkwoi u ɗam yayuu ǝndǝi kwɔ ǝǝ longwam tthǝ bǝ to nungfǝmlo kwɔ i gwam uto dang nung nyam dang gug a nungsi ɓǝ. Nyam dang gug ɓǝ gei angǝ i mai killǝng bǝ dǝ angǝ a lǝ nyam dang gug kwɔ i nkoniu i khafǝi langkwoi nwongǝi gu tthǝ ɓǝ. <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />I gwab lǝ nyam dang gug a nung rabbu tthǝ angǝ u dǝ nwongǝi lǝ killǝng nyam dang gug a nungsi, yangbǝ u gei ba langkwoi u dal yakwɔ la bǝ wabbu kwɔ langkwoi u thǝbbǝi.<verse eid="REV 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 13:16" />Nyam dang ug ɓǝ to yayuu lǝ ttha, ya tuab i ya angǝ a, ya nungtǝi i ya yiɓko, ya thǝb i yakwɔ ǝn thǝb lǝu ɓǝ, yang gubbǝi nung tthǝ lo nai a nali ko nwaɗǝsiǝ.<verse eid="REV 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 13:17" />Yuu yangǝu a ɗyǝab ko ta mǝl nungǝu nǝ nungɓi yangǝu ɓǝ, nungkwɔ lǝ, ɗuǝn nyam dang gug ɓǝ ko nungvullǝ kwɔ ǝǝ lǝ ɗuǝnɓǝ ɓǝ.<verse eid="REV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18" />Nungkwɔ dǝna lubǝiɓi ɓi to yiggǝi. Nǝ yuu akwɔ tthǝ i bǝ ibǝ nung, yang u ilǝ nung ɓii gi nyam dang gug ɓǝ, bakwɔ nungvullǝ ɓǝ ǝǝ mangǝ ǝn ɗuǝn yuu akun ɓǝ. Nungvulllǝ ɓǝ ǝn thǝmsob ɓua tai ilo thǝmtai oli iu kun (666).<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s">Yui Ɓangam I Yayuu Gu</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />Yang ǝn ɓyǝa bǝi, langkwoi ttha sim ǝn Yui Ɓangam dǝi lo tal Sihiyona; langkwoi yayuu i ulǝ 144,000 (Thǝmsob ɓua thǝmnu ilo thǝmsob ɓua thǝmtai) yayuu kwɔ i vullǝ ɗuǝni langkwoi i ɗuǝn Daa gi nwaɗǝsiǝ ɓǝ. <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />Langkwoi ǝn lǝ vǝm nung akun wayi mangǝ ǝn vǝm mung nwa vǝvǝr dǝna al, langkwoi mangǝ ǝn vǝm gamvǝr dǝna ɓuom nung. Vǝm nungkwɔ ǝn lǝ kwɔ mangǝ ǝn vǝm ya ɓuob molo dǝna ɓuob dang gi. <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />Yayuu kwɔ 144,000 (Thǝmsob ɓua thǝmnu ilo thǝmsob ɓua thǝmtai kwɔ) dǝi tthang nung ǝǝ gi yigwoi ɓǝ, i nung nwongǝi kwɔ ni nai kwɔ, i yakku; dǝnni lub ɓin afu, kwɔ ǝn i ɓuo i naɓǝ. Dang ya thayuu ǝndǝi ǝn i ɓuo kwɔ i sob loi longwam ɓǝ. <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />Yakwɔ ǝn yaɓǝi kwɔ dǝloi matthǝ lo i yasi yayuu lǝu ɓǝ; i ǝn yakwɔ loi kaitthǝ ɓǝ. Dǝnni muo sua Yui Ɓangam ɓǝ bǝikwɔ dǝnnu tǝtthǝ ǝndǝi ɓǝ. Yakwɔ i sob loi sua thayuu ǝndǝi langkwoi i osi i ji lǝ Fuh i Ɓangam ɓǝng ɓǝ. <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />I lǝ pǝllǝ nwai lǝu bokun; i yangǝu i a ɓko.<verse eid="REV 14:5" /></para>
  <para style="s">Ya Nwatummi Gi Fuh Tai</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />Langkwoi ǝn ɓyǝa ya nwatummi gi Fuh akun dǝna ya yi lǝ tǝyi tthǝ, dǝna gei nwaba a langǝ i gi Fuh a ɗing tǝu gei lǝ yayuu tthǝ ǝndǝi longwam, sua thayuu ǝndǝi, ya bǝpi, ya nwa, i ya losua. <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />U gei i yol ta tthǝ angǝ,&lt;&lt;Ɓa sur Fuh ɓa duu ghaali gu! Bakwɔ lona wung kwɔ wuu to kwan lǝ yayuu tthǝ ǝndǝi ɓǝ. Ɓa wabbu bakwɔ u mab wayi, pangsua, i nwam i bǝ nyinyak.&gt;&gt;<verse eid="REV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8" />Ya nwatummi gi Fuh a rab muo sua a nungsi ɓǝ, gei angǝ, &lt;&lt;U owhng! Babila angǝ a owhng! U to yayuu ǝndǝi nwa min gu-min a nyimmi kwɔ toi i lo i yasi yayuu ɓǝ!&gt;&gt;<verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />Ya nwatummi gi Fuh a nungtaiu muo sua yakwɔ rab pa ɓǝ, dǝna gei ba i yol ta tthǝ angǝ,&lt;&lt;Yakwɔ dǝna wab nyam dang gug langkwoi i killǝng gu kwoi muo nung ɓii nwaɗǝsing ko nailǝ kwɔ <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />i inailǝ i nwamin gi Fuh, min nyi gu, kwɔ u al i tthko dang ɗǝithang nyi gu! Yuu akwɔ ǝndǝi to nung kwɔ yang i duu zuii dang lua i lua i kiu tthasi ya nwatummi gi Fuh a langǝ i langkwoi tthasi Yui Ɓangam ɓǝlǝ. <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />Duu lua kwɔ dǝna ji zuii kwɔ a tǝ wayi laɗing langkwoi laɗing. Bǝ nwong bǝi yangǝu dang fuh ko nungvii lo yakwɔ dǝna wab nyam dang gug langkwoi i killǝng gu, yuu akwɔ nǝ tǝi nung ɓii kwɔ i ɗuǝnnu ɓǝ.&gt;&gt;<verse eid="REV 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12" />Bǝ lubǝi kwɔ tthǝn sua yakwɔ nyim nyi nunglǝi gi Fuh ɓǝ, yakwɔ dǝ ba a langǝ i tthǝ zuu gi Fuh langkwoi dǝilo bǝ dǝnyitthǝ nung a langǝ i gi Yeso ɓǝ.<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />Yang ǝn lǝ yol wayi dǝna gei angǝ, &lt;&lt;A vullǝ nungkwɔ: Yakwɔ i khana loi yakwɔ a ɓui dang bǝ to nung to gi Fuh Dangbang ɓǝ!&gt;&gt;</para>
  <para style="p" vid="REV 14:13">&lt;&lt; Ni la langǝ i!&gt;&gt; Ɓyang ɓǝ gwabnwa.&lt;&lt;I lǝ tthǝla bǝ nwongǝi gi tthǝ bǝ to nung to gi kwɔ i to ɓǝ, bakwɔ nung to gi a langǝ i a muo suai ɓǝ.&gt;&gt;<verse eid="REV 14:13" /></para>
  <para style="s">Bǝ To Kwan A Tthasua Gi Fuh Longwam</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />Nungkwɔ ǝn ɓyǝa bǝi, langkwoi ǝn ɓyǝa tǝi a vǝrrǝm, langkwoi ǝn ɓyǝa nung akun tthǝ ǝǝ lo tǝi ɓǝlǝ i tha i yui yuu, i maiu lo tthǝ i zinariya langkwoi zuam nkolǝ nwko lǝmtthǝ.<verse eid="REV 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 14:15" />Yang Ya nwatummi gi Fuh akun i dang kǝm nyǝknung tthǝ Fuh lubǝi i yol ta tthǝ lǝ yuu akun kwɔ ǝǝ lo tǝi ɓǝ angǝ,&lt;&lt;A tonungto i zuam mǝ a ɓǝr lǝ nung longwam, bakwɔ lona ɓǝ wung ɓǝ; longwam ɗuongǝng kwɔ i ɓǝr ɓǝ!&gt;&gt;<verse eid="REV 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 14:16" />Yang yuu akwɔ ǝǝ lo tǝi kwɔ wab zuam gu ɓǝ longwam, langkwoi i ɓǝr nung ɓǝrri kwɔ longwam ɓǝ.<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />Yang ǝn ɓyǝa ya nwatummi gi Fuh akun i dang kǝm nyǝknung gi Fuh wayi, langkwoi zuam gu lǝmtthǝ. <verse eid="REV 14:17" /><verse number="18" style="v" sid="REV 14:18" />Yang ya nwatummi gi Fuh akun, yuu akwɔ dǝna ɓyǝa lo lua kwɔ, ǝrr u i lo tuu. U buogbǝi ta tthǝ lo ya nwatummi gi Fuh akwɔ tthǝ i zuam nwko lǝmtthǝ ɓǝ angǝ,&lt;&lt;A to nung to i zuam mǝ ɓǝlǝ, langkwoi a ɓǝr lǝ inabi ɓǝkwɔ dang zuk longwam ɓǝ, bakwɔ inabi ɓǝ ɗuongǝng ɓǝ!&gt;&gt; <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />Nungkwɔ ya nwatummi gi Fuh ɓǝ wab zuam gu longwam, ɓǝr inabi ɓǝ tthǝ kab ɓǝlǝ, langkwoi u alǝi bǝikwɔ dǝnni kam min nyi gi Fuh tthǝɓǝ. <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" />Nungkwɔ i kam inabi ɓǝ dang min bǝikwɔ dǝnni kamtthǝ gwam gwoi angǝ a ɓǝ, langkwoi zii itthǝ min kwɔ i kamɓǝ mangǝ ǝn mungɓuommi goniu kǝn aminjǝ nwa prǝng kǝn mil thǝmsob ɓua kunnǝng.<verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s">Ya Nwatummi Gi Fuh Kwɔ A Wuolǝ Zuii A Nǝsua Ɓǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />Yang ǝn ɓyǝa nung fǝmlo akun wayi lǝ, ghaatthǝ lǝ nung dǝtthǝ vulli. Ya nwatummi gi Fuh nanaira i nung dǝzuii nanaira, nungkwɔ lǝ a bǝ alo ǝndǝi, bakwɔ ǝn iɓǝ i gei nung asua lo nyi gi Fuh.<verse eid="REV 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2" />Yang ǝn ɓyǝa nung akun mangǝ ǝn gilas nwam langtha i lua. Langkwoi ǝn ɓyǝa yakwɔ tanglo lo nungbyang i killǝngǝu langkwoi lo yakwɔ ɗuǝnni prǝm nwa nungvullǝ ɓǝ. I dǝi nwa nwam gilas, i mua molo nai kwɔ Fuh ji ɓǝ <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />langkwoi dǝnni lub ɓin gi Musa, thǝb gi Fuh, langkwoi ɓin gi Yui Ɓangam angǝ:</para>
  <para style="q1" vid="REV 15:3">Dangbang Fuh ya Angã,</para>
  <para style="q2" vid="REV 15:3">ghaali nung to langkwoi nungfǝmlo mǝ nǝnǝ!</para>
  <para style="q1" vid="REV 15:3">Yigwoi ya losua ǝndǝi,</para>
  <para style="q2" vid="REV 15:3">nunglǝi mǝ ǝn a langǝ i langkwoi ǝn ba a langǝ i!<verse eid="REV 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4" />Ən yittǝn surra wa, Dangbang?</para>
  <para style="q2" vid="REV 15:4">Ən yittǝn a la bǝ gei ghaali ma?</para>
  <para style="q2" vid="REV 15:4">Ən mǝ ɓuo lǝ ya langǝ i.</para>
  <para style="q1" vid="REV 15:4">Ya losua ǝndǝi a wɔ</para>
  <para style="q2" vid="REV 15:4">langkwoi a wab ba,</para>
  <para style="q2" vid="REV 15:4">bakwɔ yayuu ɓyǝa nung to mǝ a langǝ i ǝndǝing ɓǝ.&gt;&gt;<verse eid="REV 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />Tthasua nungkwɔ ǝn ɓyǝa nwakǝm nyǝknung wayi ɓko, i Tǝbǝ a langǝ i dang ǝulǝ.<verse eid="REV 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 15:6" />Ya nwatummi gi Fuh kwɔ nanaira kwɔ i nung dǝvulli nanaira kwɔ i dang kǝm nyǝknung ɓǝlǝ, i li nunglitthǝ kaitthǝ kwoi yuim tthǝ langkwoi i tthǝb nyingwui i zinariya.<verse eid="REV 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 15:7" />Yang yuu akun dang nung nwongǝi kwɔ nai kwɔ dǝ taso zinariya lǝ ya nwatummi gi Fuh kwɔ nanaira kwɔ nyi gi Fuh yitthǝ ɓǝ, kwɔ a ǝǝ laɗing langkwoi laɗingɓǝ. <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />Langkwoi duu yi kǝm nyǝknung ɓǝ i ghaali i ttha gi Fuh, langkwoi yuu akun yangǝu a ɓuan atǝ dang kǝm nyǝknung ɓǝu nǝ nung dǝ zuii kwɔ nanaira kwɔ ya nwatummi gi Fuh wullǝ nanaira kwɔ alo ǝndǝi ɗǝ.<verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s">Ɗǝi Nyi Gi Fuh Nanaira</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />Yang ǝnlǝ yol ta tthǝ dǝna gei ba dang kǝm nyǝknung lǝ ya nwatummi gi Fuh kwɔ nanaira ɓǝ angǝ:&lt;&lt;Ɓatǝ tǝɓa al nungkwɔ dang taso nyi gi Fuh kwɔ nanaira kwɔ longwam!&gt;&gt;<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />Ya nwatummi gi Fuh a nwasiu ɓǝ tǝ al nungkwɔ dang taso nyi gi Fuh kwɔ longwam ɓǝlǝ. Nunglua aɓau i azizi ǝrr lo yakwɔ i vullǝ nungɓii gi nungbyang ɓǝ langkwoi i yakwɔ dǝna wab killǝng gu ɓǝ.<verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />Yang ya nwatummi gi Fuh a nung rabbu al nungkwɔ dang taso gu kwɔ nung nwam. Mungki ɓǝ mǝrrǝm mangǝttǝn ǝn zii kwamɓui yuu, langkwoi nungkwɔ i nwongǝi nungmung nwam ɓǝlǝ ǝndǝi kwɔ ɓui.<verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />Yang ya nwatummi gi Fuh a taiu al nungkwɔ dang taso gu kwɔ dang dual i bǝnyinyak, langkwoi ǝrr i mǝrrǝm lǝ zii. <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />Ənlǝ ya nwatummi gi Fuh kwɔ lǝ yikku mung kwɔ gei angǝ,&lt;&lt;Kwan kwɔ a to kwɔ maɗing, Mǝ Ya Langǝ i, mǝkwɔ lǝ nǝnǝngkwɔ langkwoi mǝ viikwɔ! <verse eid="REV 16:5" /><verse number="6" style="v" sid="REV 16:6" />I al zii yayuu gi Fuh ya langǝ i i ya gei ba a tthasi, langkwoi nungkwɔ a ji zii i nwa. Dǝnni muo ǝn nung busoni gi!&gt;&gt; <verse eid="REV 16:6" /><verse number="7" style="v" sid="REV 16:7" />Yang ǝnlǝ yol lo tuu dǝna gei angǝ,&lt;&lt;Dangbang Fuh Ya Angã! Ya langǝ i langkwoi a langǝ i kwɔ lǝ kwɔ kwan mǝ!&gt;&gt;<verse eid="REV 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />Yang ya nwatummi gi Fuh a nung nai ɓǝ al nungkwɔ dang taso gu kwɔ lo fuh adu, langkwoi i gwabutthǝ u li yayuu i lua a zizi gu. <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />I liǝi i lua azizi ɓǝlǝ, langkwoi i dal ɗuǝn Fuh, kwɔ tthǝ i ttha lo nung dǝ zuii kwɔ ɓǝ. Kwoi i yitthǝ bǝ to nung a ɓko gi langkwoi i khaa Fuh i ghaali gu lǝu.<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />Yang ya nwatummi gi Fuh a nu al nungkwɔ dang taso gu lo nung ǝǝ gi yigwoi nungbyang ɓǝ. Tthǝl bai lo bǝ loyigwoi nungbyang dang ug ɓǝlǝ, nungkwɔ yayuu dǝna tang lyǝnni lǝ ba tthǝzii gi, <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />langkwoi i dal Fuh ya wayi lǝ ba tthǝzii gi i nunglua gi. Kwoi i yitthǝ nunglǝi bǝ to mullub gi lǝu.<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />Yang ya nwatummi gi Fuh a nung nanakun al nungkwɔ dang taso gu kwɔ dang gong Yufiretis. Dual ɓǝ kwi, Yangbǝ dǝ nunglǝi lǝ ya Yigwoi kwɔ ǝrr Gwɔpi ɓǝ.<verse eid="REV 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 16:13" />Yang ǝn ɓyǝa ɓyang aɓau ni tai kwɔ i tha i ɓuong ɓǝ. Dǝnni i nwa nung wabbi ɓǝlǝ, langkwoi nungbyang dang ug ɓǝlǝ, langkwoi nwa ya gei ba a tthasi ya pǝllǝ. <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />I ǝn ɓyang wa kwɔ dǝnni to nung fǝmlo ɓǝ. Ɓyang kwɔ tai kwɔ i itǝsua ya Yigwoi longwam ǝndǝi, ta gǝmmǝi lǝtha yang bǝ i ta ɓui Vii angǝ a gi Fuh ya Angã.<verse eid="REV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15" />&lt;&lt;Ɓalǝ! Dǝmǝn wuo mangǝ ɓang ya nung i! Fuh khana lo yuu akwɔ nǝ ǝǝ dǝna ki nunglitthǝ gu yang u ǝnya tthǝla, yang u thkothko ɓuapi nǝkwammu kwɔ u lǝ tthǝkku dang yayuu ɓǝ!&gt;&gt;<verse eid="REV 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16" />Yang i ɓyang ɓǝ nanaira a gǝm ya Yigwoi ɓǝ bǝ yikun bǝikwɔ dang i nwa yahudawa kwɔ dǝnni luu angǝ Armageddon ɓǝ.<verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />Yang ya nwatummi gi Fuh a nung nanaira ɓǝ al nungkwɔ dang taso gu dang walǝ. Yol ǝrr ghaatthǝ lo nung ǝǝ yigwoi dang kǝm nyǝknung, gei angǝ,&lt;&lt;Natthǝng!&gt;&gt; <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" />Yang lua dǝna nyang, yoll nung, i vǝm gamvǝr, langkwoi pangsua thǝuri ghaatthǝ. Bǝ thǝuri gi pangsua kwɔ i to song gǝu lǝu bokun baipiu vii kwɔ i mablǝ thayuu tthǝ ɓǝ; nungɓǝ lǝ bǝ thǝuri gi pangsua aɓau pǝll sua kwɔ ǝndǝi ɓǝ! <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />Gong gwoi angǝ a ǝrr gabtha tai, langkwoi gwoi angǝ a ya losua ǝndǝi dǝr. Fuh ǝrr nhǝm gong Babila langkwoi u duu min u nwa dang ɗǝithang nwamung gu- min nyi gu aɓau. <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" />Gum ganglang mung ǝndǝi surr pa, i tal ǝndǝi thǝm nǝkwam. <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" />Mung nungzirǝtal ghaatthǝ, kwɔ kǝn kilo pam thǝmnu ɓǝng, pin wayi wua olo yayuu, kwɔ dal Fuh lǝ ba nung dǝ zuii mung nungzirǝtal ɓǝ, bakwɔ nung dǝ zuii ɓǝ ɓuon ɗing.<verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s">Gong Ya Tthko Nǝkwam</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />Yang yuu akun dang ya nwatummi kwɔ nanaira kwɔ taso nanaira nai kwɔ wuo tthangǝm wuo gei angǝ, &lt;&lt; A wuo, langkwoi mǝn tanatthǝ kwan kwɔ i dǝlǝ ya tthko Nǝkwam kwɔ ɓǝ, gong gwoi angǝ a kwɔ i mai gɓagtha i nwa dual lǝ kpaatthǝ ɓǝ. <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />Ya yigwoi longwam dǝna lo i ulǝ, langkwoi ya longwam fǝr i min gu bǝ nwa min lo i ulǝ.&gt;&gt;<verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />Ɓyang a Langǝ i lǝim, langkwoi ya nwatummi gi Fuh tǝmlǝ losua a kwi. Bǝilǝ kwɔ ǝn ɓyǝa yisi ǝǝlo nung byang a thǝnni kwɔ ɗuǝnnu kwɔ i vullǝ tthǝulǝ ǝndǝi dǝna dal Fuh ɓǝ; lo nungbyang ɓǝ nanaira langkwoi ɓiu sob. <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />Yisi ɓǝ li nunglitthǝ a kwɔ itha i athǝni langkwoi i a thǝnni, langkwoi u ka tthǝu i zinariya dǝna yuim, i tthǝiu. U muo ɗǝithang zinariya nung a ɓko gu yitthǝ, lǝba bǝ lo i yaɓǝi. <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />I vullǝ ɗuǝn nwaɗasiu kwɔ yuu akun yangǝu ibǝi ǝnɓa ɓǝlǝu: &lt;&lt;Gong Babila, naa ya tthko Nǝkwam ǝndǝi langkwoi yato nung a ɓko dang longwam.&gt;&gt; <verse eid="REV 17:5" /><verse number="6" style="v" sid="REV 17:6" />Langkwoi ǝn ɓyǝa yisi ɓǝkwɔ fǝr i zii yayuu gi Fuh ya langǝ i langkwoi i zii yakwɔ i thǝi bakwɔ dǝnni to nung to i bagi Yeso ɓǝ.</para>
  <para style="p" vid="REV 17:6">Kwɔ ǝn ɓiu ni, lom fǝm ghaatthǝ. <verse eid="REV 17:6" /><verse number="7" style="v" sid="REV 17:7" />Ya nwatummi gi Fuh ɓib bǝm angǝ. &lt;&lt;Ən baɓǝ bǝ lomǝ fǝm?&gt;&gt; Mǝn gei nung a pya gi yisi kwɔ i nungbyang kwɔ lǝiu ɓǝ, nungbyang kwɔ lo nanaira langkwoi ɓiu sob ɓǝ. <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" />Nungbyang kwɔ viikwɔ i nwongǝi, kwoi lakwɔ u yangǝu i nwongǝiu; u gbag bǝ ɗab bu kong ɓua kwɔ tuni ɓǝ thǝbbǝi langkwoi i thǝu. Yayuu akwɔ ǝǝ longwam yakwɔ i vullǝ ɗuǝnni lǝu nwuni bǝ i mab longwam tthǝ dang nungvullǝ ya nwongǝi ɓǝ, i ǝndǝi loi a fǝm kwɔ nǝ i ɓyǝa nungbyangɓǝ ɓǝ; lakwɔ u yangǝu i nwongǝiu, kwoi u fug.<verse eid="REV 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9" />&lt;&lt;Bǝ lubbǝi kwɔ ǝnba yigǝi langkwoi ibǝ ibǝnung. Lo kwɔ nanaira kwɔ ǝn ɓǝmtal kwɔ nanaira kwɔɓǝ, lotal ɓǝkwɔ yisi ɓǝ ǝǝtthǝ ɓǝ. I ɓǝlǝ ya yigwoi kwɔ nanaira ɓǝ: <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />Yakun nu dang ǝi lǝ owhng, kun dang ǝi dǝna lo yigwoi yirrǝ, langkwoi yuu akun dang ǝi yirrǝ wuo lǝu, kwɔ nǝ u wuo yang, u lo yigwoi vii tuab ɓuo. <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />Langkwoi nungbyang kwɔ viikwɔ i nwongǝi kwɔ, kwoi lakwɔ yangǝu i nwongǝi kwɔ, u ɓǝlǝ ya yigwoi a ǝngunnai dang ya nanaira kwɔ langkwoi u pa tǝi thǝu ɓǝ.<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />&lt;&lt;Ɓi sob kwɔ a ɓyǝa kwɔ ǝn ya yigwoi sob kwɔ yirrǝ baipi bǝ lo yigwoi lǝu ɓǝ, kwoi i kwɔ i ji ttha i lo yigwoi lona kun i nungbyang ɓǝlǝ. <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />I kwɔ sob kwɔ nung kun dǝi yidɗi bǝ tou, langkwoi i dǝ ttha i tthǝnyimmi bǝ lo yigwoi gi lǝ nungbyang ɓǝ. <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />I ta ɓui i Yui ɓangam ɓǝ; kwoi Yui ɓangam, i yakwɔ u lubbǝi, yakwɔ u mko kwɔ, langkwoi yakwɔ dǝnyitthǝ bǝ muo sua Fuh, a tang lo tthǝi, bakwɔ ulǝ Dangbang ya dang bang langkwoi Yigwoi ya yigwoi.&gt;&gt;<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />Ya nwatummi gi Fuh langkwoi geim angǝ, &lt;&lt;Mungki kwɔ a ɓyǝa kwɔ, kwɔ ya tthko Nǝkwam kwɔ ǝǝlo kwɔ, ǝnya losua, yayuu, ya kabgwoi, langkwoi ya nwa. <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />Ɓii kwɔ sob kwɔ langkwoi i nungbyang kwɔ i tthǝng ya tthko nǝkwam kwɔ, i ee nung nko ǝndǝi langkwoi i yiu tthǝ nǝkwam; i tang nyam tthǝu langkwoi i liu i lua lǝ. <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />Bakwɔ Fuh dǝ dang nyiǝ yangbǝ i alo nungto gu i tonungto suatha langkwoi i dǝ tthai lǝ nungbyang ɓǝ lolǝ yigwoi nǝ ba gi Fuh wuo to a langǝ i.<verse eid="REV 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 17:18" />Yisi kwɔ a ɓyǝa kwɔ ǝn gwoi angǝ a kwɔ lo yigwoi lo ya yigwoi ya longwam ɓǝ.<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s">Bǝ O Gi Babila</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />Tthasua nung kwɔ ǝn ɓyǝa ya nwatummi gi Fuh akun dǝna pin wayi dǝna wɔ pangsua. Utthǝ i gong ttha, langkwoi ghaali gu gab longwam ǝndǝi. <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" />U buogbǝi i yol angǝ a angǝ: &lt;&lt;Babila ong! Gong Gwoi angǝ a ong! Lakwɔ bǝnnǝng i wa a ɓko dǝna nannu; nurug a ɓko kwɔ ǝndǝi kwɔ yayuu la kwɔ ǝǝ dang tthǝu lǝ. <verse eid="REV 18:2" /><verse number="3" style="v" sid="REV 18:3" />Ya longwam ǝndǝi nwa min gu min a nyimi gu bǝ yiɗi bǝto nung a ɓko. Ya yigwoi longwam lo i ulǝ, langkwoi ya gong lomu longwam mǝrǝm lǝya nungkurɓǝ i ɗǝlak gu kwɔ ɓuan u muo louɓǝ.&gt;&gt;<verse eid="REV 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />Yang ǝnlǝ yol akun wayi, dǝna gei angǝ,</para>
  <para style="q1" vid="REV 18:4">&lt;&lt; Ɓa i ya yuum! Ɓa i dang tthǝu!</para>
  <para style="q2" vid="REV 18:4">Bǝɓa to nung a ɓko guthǝ;</para>
  <para style="q2" vid="REV 18:4">bǝ ɓa tǝi nwathan bǝ ɗablua bǝi gu thǝ!<verse eid="REV 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5" />Nung a ɓko gu gǝm ɗab tǝyi mangǝn wayi,</para>
  <para style="q2" vid="REV 18:5">langkwoi Fuh nhǝm kiggǝ a ɓko gu.<verse eid="REV 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6" />Ɓa tou nung manungkwɔ uto ɓǝlǝ ɓǝ;</para>
  <para style="q2" vid="REV 18:6">ɓa kwai nwanathan gu bo rab lo nungkwɔ uto ǝndǝi ɓǝ.</para>
  <para style="q1" vid="REV 18:6">Al nung nwa mungki gu yitthǝ bo rab nyimtthǝ</para>
  <para style="q2" vid="REV 18:6">mannung nung a nwanwa kwɔ u mabɓǝtthǝ ɓǝ.<verse eid="REV 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7" />Ɓa du zui ghaatthǝ i ba zibǝi</para>
  <para style="q2" vid="REV 18:7">mangǝn ghaali i tthǝla kwɔ u dǝlǝ loɓǝ.</para>
  <para style="q1" vid="REV 18:7">Bakwɔ u ǝǝnwa bǝ gei lǝ lotthǝ angǝ:</para>
  <para style="q1" vid="REV 18:7">&lt;Ən ǝǝ bǝikwɔ, lǝ yigwoi a yisi!</para>
  <para style="q2" vid="REV 18:7">Ɓang ǝn ya siɓui lǝu,</para>
  <para style="q2" vid="REV 18:7">Ən bang ba zii bǝiu ko bo kun!&gt;<verse eid="REV 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8" />Ba nungkwɔ, dang bokun nung ǝǝrlǝ kiggǝ a tǝiu-</para>
  <para style="q2" vid="REV 18:8">nungzi, ba zibǝi, langkwoi i gwom.</para>
  <para style="q1" vid="REV 18:8">Langkwoi i liu i lua,</para>
  <para style="q2" vid="REV 18:8">bakwɔ Dangbang Fuh, kwɔ a ɓibbu kwan kwɔ, ǝnya angǝ a.&gt;&gt;<verse eid="REV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />Ya yigwoi longwam kwɔ to nung a ɓko i ulǝ langkwoi to ɗǝlak a tasui i ǝǝnwa kǝm ɓua lo gwoi angǝ a lǝ kwɔ nǝ i ɓyǝa du lua kwɔ dǝna liu ɓǝ. <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />I dǝi tutthǝ, bakwɔ dǝnni lǝtthǝ vulli bǝ to zuii i ulǝ. I gei angǝ, &lt;&lt; Ɓua! Ɓua! Gwoi angǝ a Babila lona kun i da zuii.<verse eid="REV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />Gong ya lomu longwam langɓǝ tasui ǝǝ nwakǝm ɓua i ulǝ, bakwɔ yuu akun yangǝu lakwɔ dǝna ɗyǝab nung lomu ɓǝ, <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />Yuu akun yangǝu dǝna ɗyǝab zinariya gi, azurfa, tal kwɔ nungkurɓǝu kpaani ɓǝ, i nung litthǝ a luu luu, i nung litthǝ a thǝnni, lilin, i siliki, i nung a ɓuoni, i kab kwɔ i mab i lǝi zock ɓǝ langkwoi kab ɓui, i tal a yumi. <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />I kirfa, i nung ɓǝɓi, i turare lua, i mur, i lubban, i min, i nui zaitun, i mual, i Alkama, i nungbyang lǝi nung i nyak, i ɓangam, prǝ, kǝkǝ prǝ, ya thǝb, i nwongǝi yayuu. <verse eid="REV 18:13" /><verse number="14" style="v" sid="REV 18:14" />Ya gong ya lomu ɓǝ gei angǝ, &lt;&lt;Nung a langǝ i kwɔ ǝndǝi dǝmma dǝ nyi tthǝ kwɔ a tǝiu kwɔ la ǝndǝing, langkwoi nung lǝ tthǝla mǝ ǝndǝi i mali mǝ paǝng, langkwoi a ɓuan a tǝi akunu. <verse eid="REV 18:14" /><verse number="15" style="v" sid="REV 18:15" />Gong Ya lomu kwɔ tǝi nungtǝi bǝto lomu gi gwoi angǝ a kullo kwɔ, a dǝi tutthǝ, bakwɔ dǝi sur bǝ tang zuii i ulǝ. I tasui i ǝǝ nwakǝm ɓua, <verse eid="REV 18:15" /><verse number="16" style="v" sid="REV 18:16" />langkwoi i gei angǝ, &lt;&lt;Ɓua! Ɓua lo gwoi angǝ a! Viikwɔ dǝu li nunglitthǝ lilin, a thǝnni, i nunglitthǝ a ɓuoni, dǝu mab tthǝu i nunglidull zinariya, tal kwɔ nungkurɓǝu kpaani ɓǝ, i lu'u lu'u! <verse eid="REV 18:16" /><verse number="17" style="v" sid="REV 18:17" />Langkwoi lona kun i nungtǝi ɓǝkwɔ thǝm ǝndǝi!&gt;&gt;</para>
  <para style="p" vid="REV 18:17">Yakuu ya kogkwai mung i yayuu dang kwai, i ya kogkwai langkwoi i sua yayuu ǝndǝi kwɔ dǝna ɗuu nung lo nwam ɓǝ, dǝi tutthǝ, <verse eid="REV 18:17" /><verse number="18" style="v" sid="REV 18:18" />langkwoi i buogbǝi bakwɔ i ɓyǝa duu lua kwɔ dǝna liu ɓǝ: &lt;&lt;Gwoi angǝ a akun yangǝu mangǝn gwoi angǝ a kwɔ!&gt;&gt; <verse eid="REV 18:18" /><verse number="19" style="v" sid="REV 18:19" />I al kunɗur loilǝ, i tasui langkwoi i ǝǝ nwakǝm ɓua, dǝnni gei angǝ, &lt;&lt;Ɓua! Ɓua lo gwoi angǝ a! Ulǝ gwoi angǝ a kwɔ yakwɔ tthǝ i kwai dǝna kog lo munglǝ i mǝrǝm lǝya nungtǝi i nung nkoɓǝ! Langkwoi lona kun nung ǝndǝi thǝm.<verse eid="REV 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 18:20" />Ɓa lǝtthǝla, wayi, bakwɔ Fuh dǝna tou kwan ɓǝ! Ɓa lǝtthǝla yayuu gi Fuh ya langǝ i langkwoi ya nwatummi gi Yeso i ya gei ba a tthasi! Ba Fuh ɓangǝu lǝng lǝba nungkwɔ u to ɓǝlǝ ɓǝ.<verse eid="REV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />Yang gong ya nwatummi gi Fuh lǝi gong tal ghaa mangǝn tal nam nung wa dang nwam, gei angǝ, &lt;&lt;I wa gwoi angǝ a Babila lǝtǝ manungkwɔni langkwoi i ɓyǝko akunu. <verse eid="REV 18:21" /><verse number="22" style="v" sid="REV 18:22" />Ɓin molo langkwoi i yol yayuu, ya ɓiɓii naduri, i lǝ tthǝmǝ lǝ akunu! Ya to nung to lomu akun i tǝi tthǝmǝ akunu; i lǝ yol tal nam nung akunu! <verse eid="REV 18:22" /><verse number="23" style="v" sid="REV 18:23" />I ɓyǝa lua gabbǝi akun gab dang tthǝmǝu; I lǝ yol yaɓǝi langkwoi i yasi afu gwab dang ɓǝu. Gong ya lomu mǝ lǝya ttha dang longwam ǝndǝi, langkwoi pǝllǝ ɓyǝa ɓǝimǝ a ɗam ya longwam ǝndǝi!&gt;&gt;<verse eid="REV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 18:24" />I ɗablua Babila ba zii ya gei ba tthasi langkwoi i yayuu gi Fuh ya langǝ i kwɔ i tǝi gwoi angǝ a lǝ; ni, zii yakwɔ ǝndǝi i thǝi dang longwam ɓǝ.<verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />Tthasua nungkwɔ Ənlǝ yol nung akun gwab mangǝn gong kon yayuu wayi, dǝnni gei angǝ, ɓa &lt;&lt;Kha Fuh! Sob lo, ghaali, langkwoi, ttha ǝn a bǝ Fuh ɓi! <verse eid="REV 19:1" /><verse number="2" style="v" sid="REV 19:2" />Ba kwan a langǝ i langkwoi i ba a langǝ i ǝn abo! U ɓanglǝ ya tang nǝkwam yuu akwɔ dǝna ɓanglǝ longwam ibǝ to nung a ɓko guɓǝ. Fuh ɗabluo ba zii ya thǝb gu.&gt;&gt; <verse eid="REV 19:2" /><verse number="3" style="v" sid="REV 19:3" />Langkwoi i buogbǝi akun angǝ, &lt;&lt;Kha Fuh! Du lua kwɔ li gong gwoi angǝ a kwɔ tǝ yi laɗing langkwoi laɗing!&gt;&gt; <verse eid="REV 19:3" /><verse number="4" style="v" sid="REV 19:4" />Yakku kwɔ thǝmkun iu nai langkwoi i nung nwongǝi kwɔ nai kwɔ i bai nwalongǝi sua i wab Fuh, kwɔ ǝǝlo nung ǝǝ lo yigwoi gu. I gei angǝ, dǝitthǝ manungɓǝ! Kha Fuh!&gt;&gt;<verse eid="REV 19:4" /></para>
  <para style="s">Bǝto Ɓang Dǝbtha Gi Yui Ɓangam</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />Nunkwɔ yol a kun wuo lo bǝ lo yigwoi gu, yol buogbǝi, da gei angǝ, ɓi kha Fuh, ya thǝb ǝndǝi langkwoi i yayuu, ya angǝ a i ya tuab, kwɔ da du angǝ a ɓǝ. <verse eid="REV 19:5" /><verse number="6" style="v" sid="REV 19:6" />Ər ǝnlǝ yol nung a kun gwab mangǝn yol thayuu, mangǝn yol mung nwam surdum, mangǝn yol gamvǝr da gwab, dǝmlǝi dǝnni gei ǝngha, ɓi kha Fuh, Dangbang ɓi Fuh ya angǝ a ɓi, u ǝn yigwoi! <verse eid="REV 19:6" /><verse number="7" style="v" sid="REV 19:7" />Ɓi lǝ tthǝla, ɓi kha ghaali gu! Bakwɔ lona wung lona bǝ dǝbtha gi Yui ɓangam, langkwoi siu mab tthǝulǝ ba ɓǝng. <verse eid="REV 19:7" /><verse number="8" style="v" sid="REV 19:8" />I du linin a yumi kaitthǝ angǝ u li.&gt;&gt; (Lilin ɓǝ ǝn nung to a langǝ i yayuu gi Fuh.)<verse eid="REV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />Yang ya nwatummi gi Fuh ɓǝ geim angǝ, &lt;&lt;A vullǝ nungkwɔ: Tthǝla ǝn a bǝ yakwɔ i gwabǝi nwa bǝtǝ min ɓang dǝbtha gi Yui Ɓangam ɓǝ.&gt;&gt; Langkwoi ya nwatummi gi Fuh ɓǝ lilo gei angǝ, &lt;&lt;Nungkwɔ ǝn ba a langǝ i gi Fuh.&gt;&gt;<verse eid="REV 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10" />Ən bai nwalong dang siu yangbǝ ǝn wabbu, kwoi u geim angǝ, &lt;&lt;Bǝ ato thǝ! Ɓang ǝn thǝb i mǝ langkwoi i sua ya dǝba a langǝ i, ya young mǝ kwɔ muo natthǝ ba a langǝ i kwɔ Yeso gei ɓǝ. Wab Fuh!&gt;&gt;</para>
  <para style="p" vid="REV 19:10">Bakwɔ ǝn ba a langǝ i kwɔ Yeso lǝ ɓyang dǝ ttha lǝ ya gei ba a tthasi.<verse eid="REV 19:10" /></para>
  <para style="s">Prǝ A Frǝm I Yuu Kwɔ Dǝna Ɗab Ɓǝ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />Yang ǝn ɓyǝa wayi ɓko, langkwoi yang ǝn ɓyǝa prǝ la vǝrǝm. Dǝnni luu ya ɗab bu angǝ Dǝnyitthǝ i ba a langǝ i; dǝu to kwan i ba a langǝ i langkwoi dǝu taɓui gu. <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />Nungǝu mangǝttǝn ǝn lua kwɔ dǝna ɗab ɓǝ, langkwoi u mai lo i nungmuo lo kpaatthǝ. I vullǝ ɗuǝnnu tthǝu lǝ, kwoi yuu akun yangǝu ibǝiu ǝn u ɓuo ibǝ ɗuǝn ɓǝ. <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />Zii lǝilǝ tthǝ Nunglitthǝ kwɔ tthǝu ɓǝ, ɗuǝnnu ǝn &lt;&lt;Ba gi Fuh.&gt;&gt; <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />Ya taɓui wayi muo suo, dǝnni kog prǝ a vǝrǝm langkwoi i li lilin kaitthǝ la vǝrǝm. <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" />Khafǝi lǝmbtthǝ i nwuo, i nungɓǝkwɔ u taɓui i ya losua. U lo yigwoi loi i kab ɓui, langkwoi u tam min u ilǝ bǝ kam min i nyi angǝ a gi Fuh. <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />I vullǝ ɗuǝn tthǝ nunglitthǝ gu i gwo: Yigwoi ya yigwoi langkwoi Dangbang ya dang bang.&gt;&gt;<verse eid="REV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />Yang ǝn ɓyǝa ya nwatummi gi Fuh dǝi dang fuh. U buogbǝi i yol angǝ a lǝ i nurug ǝndǝi kwɔ dǝna ya yilǝ ɓǝ U gei angǝ: &lt;&lt;Ɓa wɔ wuɓa gǝmtha bǝi kun ba ɓang gi Fuh! <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />Ɓa wɔ langkwoi wuɓa tang nyam ya yigwoi, gong ya taɓui i ya taɓui, nyam prǝ i ya koggǝi, nyam yayuu ǝndǝi, ya thǝb i yakwɔ ǝn ya thǝb lǝu ɓǝ, ya angǝ a i ya tuab!&gt;&gt;<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />Yang ǝn ɓyǝa nungbyang i ya yigwoi ya longwam i ya taɓui gi i gǝmtha yangbǝ i taɓui i yuu akwɔ dǝna kog prǝ langkwoi i ya taɓui gu. <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" />I muo nungbyang ɓǝlǝ ya pursǝna, u i ya gei ba a tthasi ya pǝllǝ kwɔ to nungfǝmlo tthasiu lǝɓǝ. (Ən i nungfǝmlo ɓǝ kwɔ u ɗam yakwɔ tthǝ i nungɓi gi nungbyang langkwoi i yakwɔ wab killǝng nungbyang kwɔɓǝ.) Nungbyang ɓǝ i ya gei ba a tthasi ya pǝllǝ i ǝndǝi i ali i nwongǝi gi dang lua kwɔ dǝna li thǝmmu ɓǝ. <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />I thǝb ya taɓui gi i khafǝi kwɔ dǝna i dang nwa yuu kwɔ dǝna kog prǝ ɓǝ; langkwoi i nurug tang nyami kwɔ i ɓuan i tangɓǝ.<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s">Ttha Thǝmsob Ɓua Nu</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />Yang ǝn ɓyǝa ya nwatummi gi Fuh pin wayi lǝ dǝna wɔ pangsua, u muo nung ɓko nwakǝm kong ɓua kwɔ tuni ɓǝ kwɔ i sarka a ɓuoni nkolǝ. <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />Ya nwatummi gi Fuh ɓak nungbyang ɓǝ muo, biǝk a vii vǝrǝ kwɔ- nungɓǝlǝ, Mungkullum ko Shǝtan langkwoi u tthǝbu ttha thǝm sob ɓua nu. <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />Ya nwatummi gi Fuh ɓǝ wkolǝtǝ dang kong ɓua kwɔ tuni ɓǝ, u lam nwa ɓua ɓǝ, yangbǝ u ɓuan u ɗam ya longwam akun thǝ nǝ ttha thǝm sob ɓua nu ɓǝ alo ɗǝ. Tthasua nungkwɔ yang i yiuna lona tuab.<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />Yang ǝn ɓyǝa bǝ ǝǝ ya yigwoi, langkwoi i yakwɔ, ǝǝ lolǝ kwɔ i ji ttha bǝ ɓib kwan. Ən ɓyǝa killǝng yakwɔ i thǝi lǝ ba bǝ gei ba a langǝ i kwɔ Yeso ji i ba gi Fuh. I wab nungbyang ɓǝlǝu ko ǝn killǝgǝu, i gwab i ɓii nungɓii gi nungbyang nwaɗasiǝ ko nailǝ lǝu. I wuo dang nwongǝi langkwoi i lo yigwoi i Kristi ttha thǝm sob ɓua nu. <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />(Sua yakwɔ ɓuiɓua kwɔ i ǝrr i nwongǝi lǝu nǝ ttha thǝm sob ɓua nu to ɗǝ.) Nungkwɔ lǝ bǝ ǝrr ya ɓuiɓua a nwasiu. <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />Tthǝla langkwoi i khana lo angǝ a ǝn a bǝ yakwɔ i ǝrr dang yakwɔ a ǝrr la nwasiu dang yakwɔ ɓuiɓua ɓǝ i ǝn ya langǝ i. Ɓua a nung rabbu yangǝu i ttha loilǝu; i mǝrrǝm lǝ ya nyǝknung gi Fuh langkwoi i Kristi, langkwoi i lo yigwoi i u ttha thǝm sob ɓua nu.<verse eid="REV 20:6" /></para>
  <para style="s">Bǝ Pǝl Shǝtan</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />Tthasua kwɔ ttha thǝm sob ɓua nu kwɔ pa, i yinalǝ Mungkullum pursǝna gu, <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />langkwoi utǝ sua ya losua kwɔ yǝbtha dang longwam tǝu ɗammǝi, nungɓǝlǝ, Gog i Magog. Shǝtan a gǝmmǝi ǝndǝi tthangtha babǝ taɓui, kpaali gi mangǝttǝn ǝn suazui nwa nwamlǝ. <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />I yǝbtha i lǝilǝ longwam langkwoi i kwar bǝ ǝǝ yayuu gi Fuh ya langǝ i langkwoi gwoi angǝ a kwɔ dǝu yiɗi ɓǝ. Kwoi lua a pin wayi lǝ wuo thǝi ǝndǝi. <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />Yang Mungkullum, kwɔ ɗammǝi kwɔ, i wkolǝtǝ dang kong ɓua lua langkwoi i kiu, bǝikwɔ nungbyang langkwoi i ya gei ba a tthasi ya pǝllǝ i osi i ali bǝilǝ ɓǝ; langkwoi i ji zuii dang fuh i nungvii laɗing langkwoi laɗing.<verse eid="REV 20:10" /></para>
  <para style="s">Bǝ Alo Bǝ Ɓib Kwan</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />Yang ǝn ɓyǝa gong bǝ ǝǝ yigwoi la vǝrrǝm langkwoi yuu akwɔ ǝǝ loɓǝ. Pangsua i wayi sur padum ɗǝg siu lǝ i ɓyǝai nwakan ttha siu langkwoi i ɓyǝko akun lǝu. <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />Langkwoi ǝn ɓyǝa yakwɔ ɓuiɓua kwɔ, ya angǝ a i ya tuab natha, i dǝi tthasi bǝ ǝǝ yigwoi lǝ. I ɓko nungvullǝ, langkwoi yang i ɓko nungvullǝ akun, nungvullǝ ya nwongǝi. I to kwan lǝ ya ɓuiɓua tthǝ natha i nungkwɔ i toɓǝ, manungkwɔ i vullǝ dang nungvullǝ ɓǝ. <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />Yang nwam a dǝ ya kwɔ u thǝb ɓǝ. Ɓua i longwam ya ɓuiɓua langɓǝ a dǝ ya ɓuiɓua kwɔ i muo ɓǝ. Langkwoi i to kwan lǝ yayuu ǝndǝi natha i nungkwɔ i toɓǝ. <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />Yang i wa ɓua i longwam ya ɓuiɓua dang dual lua. (Dual lua kwɔ nungɓǝlǝ ɓua a nung rabbu.) <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />Yakwɔ i vullǝ ɗuǝnni dang nungvullǝ nwongǝi lǝu kwɔ i ali lǝtǝ dang dual lua.<verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s">Wayi Afu I Longwam Afu</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />Yang ǝn ɓyǝa wayi afu i pangsua afu. Wayi a nwasiu i pangsua a nwasiu yǝbtha, langkwoi nwam la nǝkwam. <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" />Langkwoi Ən ɓyǝa Gwoi angǝ a a langǝ i, Urshalima afu, pin wayi lǝ dǝna wɔ bǝgǝ Fuh, i mab dǝna ki, mangǝttǝn ǝn yisi afu kwɔ i mab dǝna ki ɓǝiu ɓǝ. <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />Ənlǝ yol ghaatthǝ dǝna gei ba bǝ ǝǝ yigwoi angǝ: &lt;&lt;Lakwɔ gwoi Fuh i yayuu lǝ! U ǝǝ i ilǝ, langkwoi i mǝrǝmlǝ yayuu gu. Fuh i nkolǝ a ǝǝ tǝbǝ i ilǝ, langkwoi u mǝrǝmlǝ Fuh gi. <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />U fa mung nung dang nungǝi lǝ ǝndǝi. Bǝ ɓuiɓua akun yangǝu, bǝ ɓanglǝ dang wa akun yangǝu, ko bǝ tasui, ko tthǝzi. Nung aku la ǝndǝing.&gt;&gt;<verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />Yang yuu akwɔ ǝǝ lo nung ǝǝ ya yigwoi kwɔ gei angǝ, &lt;&lt;Langkwoi lakwɔ ǝn mab nung ǝndǝi lafu!&gt;&gt; Langkwoi u geim angǝ, &lt;&lt;A vullǝ nungkwɔ, bakwɔ ǝn ba a langǝ i langkwoi i dǝ ba a langǝ i tthǝ.&gt;&gt; <verse eid="REV 21:5" /><verse number="6" style="v" sid="REV 21:6" />Langkwoi u gei angǝ, thǝmǝng! Ɓang lǝ a nungsi langkwoi a nǝsua, bǝ baipiu langkwoi i bǝ alo. Yuu akwɔ ǝndǝi dǝna lǝ ɗimung mǝn gwabbu tthǝ u nwa mung dang ɓuamung nwongǝi u kwai nung akunu. <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />Yakwɔ tang lo yang i muo nungkwɔ namlǝ: mǝn mǝrǝmlǝ Fuh gi, langkwoi i mǝrǝmlǝ yathangǝm. <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />Kwoi ya vulli, yakwɔ kang nungǝu kwɔ, yato nung a ɓko, ya thǝbbǝi, ya lo itha, ya ɓui, yakwɔ dǝna wab fuh kwɔ thayuu kai ɓǝ, i ya pǝllǝ ǝndǝi-yakuu langkwoi i ya pǝllǝ bǝ ǝǝ gi nungkwɔ lǝ dang lua langkwoi i kiulǝ, nungɓǝlǝ ɓua a nung rabbu.&gt;&gt;<verse eid="REV 21:8" /></para>
  <para style="s">Urshalima Afu</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />Yuu akun dang ya nwatummi gi Fuh kwɔ nanaira kwɔ tthǝ i taso zuii a nǝsua kwɔ nanaira kwɔ yitthǝ, u wuo suam wuu gei angǝ, &lt;&lt; A wuo, langkwoi mǝn tanatthǝ yisi afu ɓǝ, si Yui ɓangam ɓǝ.&gt;&gt; <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />Langkwoi u lǝim dang Ɓyang a Langǝ i lǝ, langkwoi ya nwatummi gi Fuh ɓǝ lǝim tǝlǝ lo tal akwɔ tǝyitthǝ ɓǝ. U tamnatthǝ Urshalima, Gwoi angǝ a a Langǝ i, pin dang wayi dǝna wɔ bǝgǝ Fuh lǝ. <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />Langkwoi dǝna yuim i ghaali gi Fuh. Gwoi angǝ a ɓǝ dǝna yuim mangǝttǝn ǝn tal a yummi, mangǝttǝn ǝn yasfa, kai mangǝn karko. <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />U tthǝ i kong gei tǝyitthǝ, i kab nwalǝgwoi sob iu rab langkwoi i ya nwatummi gi Fuh sob iu rab dǝna ki nwalǝgwoi ɓǝ. I vullǝ ɗuǝn ya kabgwoi ya Israila sob iu rab. <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />Nwalǝgwoi tai lona anwa ǝndǝi: tai lona gwɔpi, tai ttha lasua, tai gwɔ tal langkwoi tai lǝdah. <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />I mai kong gei gwoi angǝ a ɓǝ lo tal sob iu rab, i vullǝ ɗuǝn ya nwatummi gi Yui Ɓangam ɓǝ lolǝ. <verse eid="REV 21:14" /><verse number="15" style="v" sid="REV 21:15" />Ya nwatummi gi Fuh kwɔ geim bakwɔ u tthǝ i kab na nung a zinariya kwɔ u nalǝ gwoi angǝ aɓǝ ɓǝ, i nwalǝgwoi, i gwu kǝm. <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />Gwoi angǝ a ɓǝ i mai i kwarlǝ kwar, ailiu mangǝn gonliu. Ya nwatummi gi Fuh ɓǝ na gwoi angǝ a ɓǝ i kab na nung ɓǝ: gonliu mǝl thǝmsob ɓua nanaira ilo thǝm nu (1, 500) langkwoi tǝyi mangǝn gonliu. <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />Ya nwatummi gi Fuh langkwoi na gwu kǝm ɓǝ, tǝ yiu bo thǝm sob ɓua kun ilo li iu kun (216), manung nung nanung thayuu kwɔ ya nwatummi ɓǝ dǝna tolǝ nung to ɓǝ. <verse eid="REV 21:17" /><verse number="18" style="v" sid="REV 21:18" />I nung mai gwu kǝm ɓǝ i yasfa, gwoi angǝ a ɓǝ i nkolǝ i mai i zinariya a langǝ i, kai mangǝn gilas. <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />I li pi kǝm gwu kǝm gwoi angǝ a ɓǝ i mabbu i tal a yumi kpaatthǝ. I baipi bǝ mai nungɓǝ i yasfa, a nungtthǝ rabbu ǝn saffir, a taiu agat, a naiu zumurrudu, <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />A nu tthǝu ǝn onis, a nanakun Yakutu, a nanaira kirisolat, ǝngunnai beril, a songsob tofaz, a sob kirisofaras, a sob iu kun Yakinta, a sob iu rab ametis. <verse eid="REV 21:20" /><verse number="21" style="v" sid="REV 21:21" />Nwalǝgwoi sob iu rab kwɔ nungɓǝlǝ nung a langǝ i sob iu rab. Nunglǝi ganglang gwoi angǝ a ɓǝ i mai i zinariya a langǝ i, kai mangǝttǝn ǝn gilas.<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />Ən ɓyǝa kǝm nyǝknung tthǝ Fuh gwoi angǝ a lǝlǝu, bakwɔ kǝm nyǝknung tthǝ Fuh gi ǝn Dangbang Fuh ya angǝ a langkwoi Yui Ɓangam. <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />Gwoi angǝ a ɓǝ gwab fuh ko fih kwɔ a gabbǝi dang ǝulǝ ɓǝu, bakwɔ ghaali gi Fuh dǝna gabbǝi dang ǝulǝ, langkwoi Yui Ɓangam lǝ fitilǝ gi. <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />Ya longwam ǝndǝi a thko nwa lua gu, langkwoi ya yigwoi ya longwam a wulǝ nungtǝi dang ǝulǝ. <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />Nwalǝgwoi gwoi angǝ a ɓǝ a ɓau lǝ ɓau vii ǝndǝi, i lam nwalǝgwoi ɓǝu, bakwɔ nungvii yangǝu bǝilǝu ɓǝ. <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />I wulǝ ghaali langkwoi i nungtǝi ya losua ǝndǝi lǝ gwoi angǝ a ɓǝ. <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />Kwoi nung a kun yangǝu mko kwɔ atǝ gwoi angǝ a ɓǝ, ko yuu akwɔ dǝna to nung to tthǝkku ko dǝna kǝb pǝllǝ ɓǝ. Yakwɔ i vullǝ ɗuǝnni dang nungvullǝ nwongǝi gi Yui Ɓangam ɓuo a tǝ gwoi angǝ a ɓǝ.<verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />Ya nwatummi gi Fuh langkwoi tamnatthǝ dual mung nwongǝi, kai mangǝttǝn ǝn ɓui a yumi, langkwoi dǝna kyal bǝ lo yigwoi gi Fuh langkwoi gi Yui Ɓangam. <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />Langkwoi dǝna kyal nunglǝi ganglang gwoi angǝ a. Nwangwu dual lǝ ǝndǝi kab nwongǝi tthǝ, kab nwongǝi ɓǝ dǝna si lona sob iu rab, bokun dang fih; langkwoi yangǝu ǝn yǝng dǝ tthǝla lǝ ya losua ǝndǝi. <verse eid="REV 22:2" /><verse number="3" style="v" sid="REV 22:3" />Nung akun yangǝu kwɔ Fuh ɓanglǝ i tǝi dang gwoi angǝ a lǝu.</para>
  <para style="p" vid="REV 22:3">Bǝ ǝǝ yigwoi Fuh langkwoi a bǝ Yui ɓangam dang gwoi angǝ a lǝ. Langkwoi ya thǝb gu a wabbu. <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />I ɓyǝa dang nungǝu, langkwoi i vullǝ ɗuǝnnu nwaɗasiǝ lǝ. <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />Bǝi gub akunu, langkwoi i yiɗi fitilǝu ko fuh adu, bakwɔ Dangbang Fuh a mǝrǝmlǝ lua gi, langkwoi i lo yigwoi la ɗing langkwoi laɗing.<verse eid="REV 22:5" /></para>
  <para style="s">Bǝ Wuo Gi Yeso</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />Yang ya nwatummi gi Fuh ɓǝ geim angǝ, &lt;&lt;Bakwɔ ǝn ba a langǝ i langkwoi i dǝba a langǝ i tthǝ. Langkwoi Dangbang Fuh, kwɔ dǝna dǝ Ɓyang gulǝ ya gei ba a tthasi kwɔ, u tum ya nwatummi gu u tanatthǝ nungkwɔ a to nung nǝnǝng kwɔ lǝ ya thǝb gu.&gt;&gt;<verse eid="REV 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7" />Yeso gei angǝ, &lt;&lt;Alǝ! Dǝmǝn wuo nǝnǝng kwɔ, tthǝla ǝn a bǝ yakwɔ dǝna to nung to i nwaba a tthasi dang nungvullǝ kwɔ ɓǝ!&gt;&gt;<verse eid="REV 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8" />Ɓang, Yohanna, ǝnlǝ langkwoi ǝn ɓyǝa i nungkwɔ ǝndǝi. Langkwoi kwɔ ǝn alo bǝ lǝu langkwoi i bǝ ɓyǝa i nungkwɔ, Ən bai nwalongǝm pangsua tthasi ya nwatummi gi Fuh kwɔ tamnatthǝ i nungkwɔ ɓǝ, langkwoi dǝmǝn tǝbǝ wabbu. <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />Kwoi u geim angǝ, &lt;&lt;Bǝ a ato ni thǝ! Ɓang ǝn thǝb i mǝlǝ langkwoi i ya youngmǝ ya gei ba a tthasi langkwoi i yakwɔ ǝndǝi dǝna to nung to i ba dang nungvullǝ kwɔ ɓǝ. A wab Fuh!&gt;&gt; <verse eid="REV 22:9" /><verse number="10" style="v" sid="REV 22:10" />Langkwoi u geim angǝ, &lt;&lt;Bǝ pyǝa nwaba bǝ gei ba a tthasi kwɔ dang nungvullǝ kwɔ nung a pyǝa thǝ. Bakwɔ lona gbagǝng kwɔ i nungkwɔ ato nung tthǝ ɓǝ. <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />Yuu akwɔ dǝna to nung a ɓko u lilotthǝ u to nung a ɓko, yuu akwɔ dǝna to ɓilǝng u lilotthǝ uto ɓilǝng; yuu akwɔ dǝna to nung to a langǝ i u lilotthǝ uto nung to a langǝ i, langkwoi yuu akwɔ ǝn ya langǝ i lilotthǝ bǝ to nung a langǝ i.<verse eid="REV 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />Yeso gei angǝ, &lt;&lt;Alǝ! Dǝmǝn wuo nǝnǝngǝkwɔ! Mǝn wulǝ nwathanǝm nalǝ, mǝn dǝlǝ ko ǝnya ǝndǝi natha i nungkwɔ uto ɓǝ. <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" />Ɓanglǝ a nungsi langkwoi a nǝsua, bǝ baipiu langkwoi i bǝ alo.&gt;&gt;<verse eid="REV 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14" />Bǝ khana lo ǝn a bǝ yakwɔ ɗiggǝ nunglitthǝ itthǝ langkwoi i ɓǝ i tǝi nunglǝi kwɔ i tang sikab kab nwongǝi langkwoi i ɓǝ kwɔ i tǝ gwoi angǝ ttha nwalǝgwoi lǝ. <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />Kwoi ttha mual gwoi angǝ a lǝ ǝn i ɗua langkwoi i ya kǝbpǝllǝ nungpi, i ǝn ya to nung a ɓko langkwoi i ǝn ya thǝbbǝi, i ǝn ya wab nung a wabwab langkwoi i ǝn ya kǝbpǝllǝ lo nungkwɔ dǝi gei i bǝ to nung to.<verse eid="REV 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />Ɓang, Yeso, ǝn tum ya nwatummim sua ya kǝm pinwa gei i nungkwɔ tthǝ ya muo sua Fuh. Ɓang ǝn yǝng dang woi gi Dawuda; Ɓanglǝ vin a yuimi nungwoi.&gt;&gt;<verse eid="REV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />Ɓyang a langǝ i i Yisi afu gei angǝ, &lt;&lt;A wuo!&gt;&gt;</para>
  <para style="p" vid="REV 22:17">Yuu akwɔ ǝndǝi nǝ lǝ nungkwɔ yang langɓǝ a gei angǝ, &lt;&lt;A wuo!&gt;&gt;</para>
  <para style="p" vid="REV 22:17">A wuo, yuu akwɔ ǝndǝi dǝna lǝ ɗimung ɓǝ; yang u muo mungki nwongǝi mangǝn nungdǝ, yuu akwɔ ǝndǝi dǝna yiɗi ɓǝ.<verse eid="REV 22:17" /></para>
  <para style="s">Bǝ Alo</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />Ɓang, Yohanna, dǝmǝn gub ɗuogsui yuu akwɔ lǝ nwaba a tthasi kwɔ dang nungvullǝ kwɔ: nǝ yuu akun lilo nung akun lolǝ yang, Fuh a lilo bǝ ɗablua bǝi gu zui kwɔ i gei dang nungvullǝ kwɔ ɓǝ. <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />Langkwoi nǝ yuu akun lǝi nung akun dang nwaba a tthasi kwɔ dang nungvullǝ kwɔ, Fuh a lǝi nwathan abǝi dang sikab kab nwongǝi langkwoi i a gwoi angǝ a a langǝ i, kwɔ i gei dang nungvullǝ kwɔ ɓǝ.<verse eid="REV 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />Yuu akwɔ gei nungkwɔ ǝndǝi kwɔ gei angǝ, &lt;&lt;Manungɓǝni lalangǝ i! Dǝmǝn wuo nǝnǝngǝ kwɔ!&gt;&gt;</para>
  <para style="p" vid="REV 22:20">Dǝitthǝ manungɓǝ. A wuo, Dangbang Yeso!<verse eid="REV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21" />Kaso nung a langǝ i gi Dangbang Yeso ǝǝ i yayuu ǝndǝi.<verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>