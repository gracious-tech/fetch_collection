<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">1 Yohanna</para>
  <para style="toc1">Nungvullǝ Gi YOHANNA A Nwasiu</para>
  <para style="toc2">1 Yohanna</para>
  <para style="toc3">1 Yo</para>
  <para style="mt2">Nungvullǝ A Nwasiu Gi</para>
  <para style="mt1">YOHANNA</para>
  <para style="imt">Bǝ Gabnung</para>
  <para style="ip">
    <char style="bk">Nungvullǝ A Nwasiu Gi Yohanna</char> dǝna gei nung ni rab: bǝ nyimtthǝ ya thannu yangbǝ i kǝbthalo i Fuh langkwoi i yuiu, Yeso Kristi, langkwoi yangbǝ gub ɗuogsui bǝ i muo sua bǝ nanatthǝ nung pǝllǝ kwɔ a ɓanglǝ kǝbthalo kwɔ ɓǝ. Bǝ nanatthǝ nung kwɔ tthǝn lo bǝ dǝba a langǝ i tthǝ bǝ nanatthǝ nung mungkulum a kǝbtha i nung longwam, langkwoi nungkwɔ Yeso, Yui Fuh, lalangǝ i kaso ǝn thayuu lǝu. Ya nanatthǝ nung ɓǝkwɔ kwɔ yuu a sob a tǝi lo tthǝ nwongǝi longwam kwɔ; langkwoi dǝi nanatthǝ angǝ nung yangǝu kǝb bǝ soblo lǝtha i bǝ to nung a langǝ i ko bǝ yiɗi ya kunu.</para>
  <para style="ip">Dang bǝ la i bǝ nanatthǝ nungkwɔ ya vullǝ nungkwɔ gei kai nǝkwam angǝ Yeso Kristi ǝn thayuu lalangǝ i, langkwoi u gei u kwab angǝ yakwɔ ǝndǝi dǝba a langǝ i tthǝ Yeso langkwoi dǝna yiɗi Fuh i yiɗi tha.</para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">Ba Nwongǝi</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />Ɓi vullǝ ɓǝ nungtthǝ Lǝba ba nwongǝi, kwɔ lakuu tthǝ bǝ baipiu ɓǝ, Ɓi lǝ ba ɓǝng, langkwoi ɓi ɓyǝang i nungɓi lǝ; ni, ɓi lǝng, langkwoi naɓi kǝn tthǝng. <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />Kwɔ nwongǝi kwɔ i nungwambǝi, ɓi ɓyǝang; nungkwɔ ɓi gei baɓǝ langkwoi ɓi gei ɓǝ ba nwongǝi a ɗing kwɔ i Daa langkwoi i taɓi natthǝ. <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />Nungkwɔ ɓi ɓyǝa langkwoi ɓi lǝ ɓi gei ɓǝ tthǝ langɓǝ, yangbǝ ɓa kǝbtha lo iɓi kwɔ ganglang ɓi i Daa langkwoi i Yuiu Yeso Kristi. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />Ɓi vullǝ nungkwɔ yangbǝ tthǝla ɓi alo.<verse eid="1JN 1:4" /></para>
  <para style="s">Fuh Ən Nungabbǝi</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />Lakwɔ nwaba kwɔ ɓilǝ nwa Yuiu langkwoi ɓi gei kwɔ ǝn nungkwɔ: Fuh ǝn nungabbǝi, langkwoi thǝl yangǝu ko atuab tthǝulǝ. <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />Nǝ, yang, ɓi gei ɓingǝ ɓi tthǝ i bǝ kǝbtha lo i ulǝ, langkwoi dǝɓi ǝǝ dang bǝthǝl, dǝɓi kǝb pǝllǝ ba a langǝ i yangǝu dang baɓi i nungto ɓiu ǝndǝi. <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />Kwoi nǝ dǝɓi ǝǝ dang nungabbǝi-manungkwɔ u dang nungabbǝi-yang ɓitthǝ i bǝ kǝbtha lo i tha lǝ, langkwoi zii Yeso, Yuiu, ɗiggǝ ɓi dang nung a ɓko ǝndǝi. <verse eid="1JN 1:7" /><verse number="8" style="v" sid="1JN 1:8" />Nǝ ɓi gei angǝ ɓingǝ ɓi yangǝu i nung a ɓko, yang dǝɓi ɗam loɓi, langkwoi ba a langǝ i yangǝu dang wa ɓiu. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />Kwoi nǝ ɓi gei nwa ɓko baɓi tthǝ Fuh, u dǝilo bǝ gwab nwaba gu langkwoi u to nung kwɔ ǝn nung a langǝ i ɓǝ: u al nung a ɓko ɓilǝtǝ langkwoi u ɗiggǝ ɓitthǝ nung a ɓko ɓi ǝndǝi. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />Nǝɓi gei ɓingǝ ɓi yangǝu i nung a ɓko, yang ɓi gei ɓingǝ Fuh ǝnya pǝllǝ, yang bagu yangǝu dang wa ɓiu.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">Kristi Ya Woɓi Natthǝ Nung</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />Yathangǝm, dǝmǝn vullǝ ɓǝ nungvullǝ kwɔ tthǝ, yangbǝ bǝɓa to nung a ɓkothǝ, kwoi nǝ yuu akun to nung a ɓko yang, ɓitthǝ i yuu a kwɔ a yam Daa lǝ nwathan ɓi ɓǝ- Yeso Kristi, yato nung a langǝ i. <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />Langkwoi Kristi i nkolǝ lǝ nunglǝi kwɔ i al nung a ɓko ɓi lǝtǝ ɓǝ, langkwoi ǝn nung a ɓko ɓi ɓuolǝu, kwoi nung a ɓko ya longwam ǝndǝi.<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />Nǝ ɓito nung to i ba gi Fuh, yang ɓi ibǝi ɓi iung. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />Nǝ ɓi gei ɓingǝ ɓi iung, kwoi ɓito nung to i ba gu lǝu, ɓi ǝnya pǝllǝ ba a langǝ i yangǝu dang wa ɓiu. <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />Kwoi nǝ dǝɓi to nung to i ba gu, ɓilǝ yakwɔ bǝ yiɗi Fuh ɓi al long ɓǝ. Nungkwɔ nungɓǝlǝ nunglǝi kwɔ ɓi ibǝi ɓi dang tha i Fuh ɓǝ: <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />Nǝɓi gei ɓingǝ ɓi ǝǝ dang tha i Fuh, ɓi ǝǝ manung kwɔ Yeso Kristi toɓǝ.<verse eid="1JN 2:6" /></para>
  <para style="s">Zuu Afu</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />Ya youngǝm kwɔ dǝm yiɗi niɓǝ, zuu kwɔ dǝmǝn vullǝ sua ɓǝkwɔ ǝn afu lǝu; ǝn zuu aku, ǝn akwɔ la nwasiu ɓǝ. Zuu aku kwɔ ǝn nwaba kwɔ ɓa owhsi ɓa lǝɓǝ.<verse eid="1JN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 2:8" />Yirrǝ, zuu kwɔ ǝn vullǝ sua ɓǝkwɔ ǝn afu, bakwɔ ba a langǝ iu iɓi tthǝn tthǝ Kristi langkwoi tthǝ ɓǝlǝ. Bakwɔ thǝl dǝna pa ǝn pa, langkwoi nungabbǝi a langǝ i dǝna gabbǝi. <verse eid="1JN 2:8" /><verse number="9" style="v" sid="1JN 2:9" />Nǝ ɓi gei ɓingǝ ɓi dang nungabbǝi, langkwoi dǝɓi tthǝng ya young ɓi, yang ɓi dang bǝthǝl wuolǝ lona kwɔ. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />Nǝ dǝɓi yiɗi ya young ɓi, yang ɓi ǝǝ dang nungabbǝi, langkwoi nung akun yangǝu dang ɓi kwɔ ato yuu akun a to nung a ɓko ɓǝu. <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />Kwoi nǝ dǝɓi tthǝng ya young ɓi, ɓi dang bǝthǝl; dǝɓi thko dang ǝulǝ ɓi ibǝi bǝikwɔ dǝɓi tǝ ɓǝlǝu, bakwɔ tthǝl ɓǝ mǝrrǝm ɓi lǝ ya nungɓuomi.<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />Yathangǝm, ǝn vullǝ ɓǝ nungkwɔ tthǝ, bakwɔ i al nung a ɓko ɓǝ lǝ tǝng lǝba Kristi ɓǝ. <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />Ya daa, dǝmǝn vullǝ ɓǝ nungkwɔ tthǝ, bakwɔ ɓa iung yuu kwɔ bǝ baipiu utthǝ ɓǝ. Ya baittha, dǝmǝn vullǝ ɓǝ nungkwɔ tthǝ, bakwɔ ɓa pǝl ttha Mungkullum mǝng ɓǝ.<verse eid="1JN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14" />Yathangǝm, dǝmǝn vullǝ nungvullǝ suaɓǝ bakwɔ ɓa i Daang ɓǝ. Dǝmǝn vullǝ nung suaɓǝ, ya Daa, bakwɔ ɓa i yuu akwɔ tthǝ bǝ baipiu ɓǝ. Dǝmǝn vullǝ nung suaɓǝ, ya baittha, bakwɔ ɓa nyimɗing; bagi Fuh dang tthǝɓǝ, ɓa pǝl ttha yato nungto Mungkullum mǝng.<verse eid="1JN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />Bǝɓa yiɗi longwam thǝ ko nungkwɔ ǝn a bǝ longwam ɓǝ. Nǝ dǝɓa yiɗi longwam yang, ɓa yiɗi Daa lǝu. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />I Nungtǝi kwɔ ǝndǝi ǝn a bǝ longwam kwɔ- nungkwɔ ya nung a ɓko dǝna yiɗi, nungkwɔ yayuu dǝna ɓyǝa dǝna yiɗi, langkwoi nung ǝndǝi dang longwam kwɔ yayuu dǝna lǝi loi lǝ bko kwɔ- i nungtǝi kwɔ ǝndǝi akun yangǝu wuo bǝgǝ Daa lǝu; i kwɔ ǝndǝi wuo longwam. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />Longwam ǝndǝi i nungkwɔ dang ǝu kwɔ yayuu dǝna yiɗi kwɔ dǝna thǝnthǝm; kwoi yakwɔ dǝna to nungkwɔ Fuh dǝna yiɗi kwɔ a ǝǝ laɗing.<verse eid="1JN 2:17" /></para>
  <para style="s">Ya Ɓuitha I Kristi</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />Yathangǝm, bǝ alo wung! I gei ɓǝtthǝ angǝ ya ɓui gi Kristi a wɔ, langkwoi nikwɔ ya ɓui gi Kristi owhsi wung, langkwoi niyang ɓi ibǝi bǝ alo gɓagǝng. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />Yayuu kwɔ lalangǝ i ǝnya kǝblo lǝtha i ɓilǝ lǝu, langkwoi nungkwɔ i pa i yiɓi; nǝ i ǝnya kǝbthalo iɓi yang, krǝ i ǝǝ iɓilǝ. Kwoi i pa yangbǝ ɓi ibǝi kai nǝkwam yuu akun yangǝu dang ǝi ǝn a ɓiu.<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />Kwoi Kristi pinlǝ Ɓyang a Langǝ i loɓǝ, langkwoi nungkwɔ ɓǝ ǝndǝi ɓa ibǝ ba a langǝ i. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />Ən vullǝnung vullǝ suaɓǝ, ǝnba kwɔ ɓa ibǝ ba a langǝ i lǝu ɓǝ, manungkwɔ ni yang, ǝnba kwɔ ɓa ibǝing ɓǝ, langkwoi ɓa ibǝi pǝllǝ yangǝu wuo dang ba a langǝ iu.<verse eid="1JN 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22" />Ən yittǝn, yang, lǝ ya pǝlla? Ən yakwɔ gei angǝ Yeso ǝn Kristi lǝu ɓǝ. Yayuu manungkwɔ ni ǝnya ɓui gi Kristi dǝi la Daa i Yui. <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />Yakwɔ la Yui yang dǝna la ǝn Daa langɓǝ; yakwɔ muo Yui yang itthǝ i Daa langɓǝ.<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />Ɓa dǝitthǝ, yang, nungkwɔ ɓalǝ la nwasiu kwɔ ɓa dǝ dang nyiɓǝ. Nǝɓa dǝ nwaba ɓǝ kullo dang nyiɓǝ, yang vii ǝndǝi ɓa ǝǝ dang bǝ kǝbthalo i Yui langkwoi i Daa. <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />Langkwoi nungkwɔ nungɓǝlǝ nungkwɔ Kristi gwab ɓi nwa ɓǝ nwongǝi a ɗing.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />Dǝmǝn vullǝ ɓǝ nungvullǝ kwɔ tthǝ lǝba yakwɔ dǝna yiɗi bǝ ɗamɓǝ ɓǝ. <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />Kwoi ɓaɓǝ abo, Kristi al Ɓyang a Langǝ i gu lo ɓǝng, Manungkwɔ Ɓyang gu ǝǝ i ɓǝlǝ, yuu akun yangǝu kwɔ a naɓǝ natthǝ nungǝu. Bakwɔ Ɓyang gu dǝna naɓǝ natthǝ nung ǝndǝi, langkwoi nungkwɔ u nanatthǝ kwɔ ǝn ba a langǝ i, ǝn pǝllǝ lǝu, Ɓato nungto ibǝ nanatthǝ nung gi Ɓyang, yang, langkwoi ɓa ǝǝ dang tha i Kristi.<verse eid="1JN 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />Manungɓǝni, yathangǝm, ɓa ǝǝ dang tha i ulǝ, yangbǝ kwɔ nǝ u wuo yang ɓi tǝi tthǝ nyimi langkwoi ɓi pyǝa dang tthǝkku lǝu Vii kwɔ u wuotthǝ ɓǝ. <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />Ɓa ibǝi Kristi ǝnya nung a langǝ i; ɓa ibǝi, yang, angǝ yuu akwɔ ǝndǝi nǝ to nungkwɔ ǝn a langǝ i yang u ǝn yui Fuh.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">Yathang Fuh</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />Ɓa ɓyǝa bǝ yiɗi bǝi kwɔ Daa yiɗi ɓi lǝɓǝ! Bǝ yiɗi bǝi gu ghaaɗing kwɔ to dǝnni luu ɓi angǝ ɓi ǝn yathang gi Fuh- langkwoi nungkwɔ, ǝnba a langǝ i, ɓi manung ɓǝnni. Ən u nungkwɔ u to longwam i ɓilǝu ɓǝ: longwam i Fuh lǝu. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />Ya ǝnthǝm kwɔ dǝm yiɗi niɓǝ, lakwɔ ni ɓi ǝn yathang Fuh, kwoi yirrǝ nungkwɔ ɓi mǝrǝm kwɔ kai la langǝ i lǝu. Kwoi ɓi ibǝing kwɔ nǝ Kristi fug, ɓi mǝrǝm manung gu, bakwɔ ɓi ɓiu manung kwɔ u wuotthǝ ɓǝ. <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />Yuu kwɔ ǝndǝi tthǝ ibǝ dǝnyitthǝ kwɔ tthǝ Kristi muo lo matthǝ, manungkwɔ Kristi matthǝ ɓǝ. <verse eid="1JN 3:3" /><verse number="4" style="v" sid="1JN 3:4" />Yuu akwɔ nǝ to nung a ɓko yang dǝna ɓanglǝ ǝn zuu gi Fuh, bakwɔ nung a ɓko ǝn bǝ ɓanglǝ zuu. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />Ɓa ibǝi Kristi wuo yangbǝ wuo al nung a ɓko ɓilǝtǝ, langkwoi u yangǝu i nung a ɓko. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />Niyang yuu akwɔ ǝndǝi dang tha i Kristi yang u ǝǝnwa bǝto nung a ɓko; kwoi yuu akwɔ ǝǝnwa bǝto nung a ɓko u ɓiu lǝu ko bokun.<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />Yathangǝm! Bǝ yuu akun ɗamɓǝ thǝ, Yuu akwɔ nǝ dǝna to nung a langǝ i yang u ǝnya langǝ i, manung kwɔ Kristi ǝnya langǝ i ɓǝ. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />Yuu akwɔ nǝ ǝǝnwa bǝto nung a ɓko yang u ǝn a bǝ Mungkulum, bakwɔ Mungkullum to nung a ɓko la nwasiu ɓǝ. Yui Fuh fug lǝba baɓǝ kwɔ, yangbǝ u dǝr nungkwɔ Mungkulum toɓǝ.<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />Ya kwɔ lǝ yathang Fuh ǝǝnwa bǝto nung a ɓko, ba kwɔ Fuh dang tha i ilǝ ɓǝ; langkwoi bakwɔ Fuh lǝ Daa ɓǝ, i ǝǝnwa bǝto nung a ɓko. <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />Manung kwɔni ɓi ibǝi yaɓǝ lǝ yathang Fuh i yathang Mungkullum ɓǝ: yakwɔ to nungkwɔ ǝn a langǝ iu ɓǝ ko i yiɗi ya youngǝiu ǝn yathang Fuh lǝu.<verse eid="1JN 3:10" /></para>
  <para style="s">Ɓa Yiɗi Tha</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />Nwaba kwɔ ɓalǝ la nwasiu kwɔ ǝn nungɓǝlǝ: ɓi yiɗi tha. <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />Bǝɓi ǝǝ mangǝn Kayinu thǝ; u ǝn a bǝ Mungkullum kwɔ u thǝb youngǝu Habila. Ən baɓǝ bǝ Kayinu thǝb buo? Bakwɔ nungkwɔ u i nkolǝ to kwɔ lozuiiu lǝu, langkwoi nungkwɔ youngǝu to kwɔ ǝn a langǝ i.<verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />Ya youngǝm, bǝ nyiɓǝ lub thǝ, nǝ ya longwam tthǝngɓǝ ɓǝ. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />Ɓi ibǝi ɓi pa nwa ɓua langkwoi ɓitthǝ i nwongǝi; ɓi ibǝi ba kwɔ dǝɓi yiɗi ya young ɓi. Ya kwɔ yiɗi thko kwɔ ɓua dǝna loyigwoi loilǝ. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />Ya kwɔ dǝna tthǝngtha i ǝnya thǝbbǝi, langkwoi ɓa ibǝing ya thǝbbǝi yangǝu i nwongǝi a ɗing ǝu. <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />Nungkwɔ nungɓǝlǝ nunglǝi kwɔ ɓi ibǝi ǝn ɓǝttǝn lǝ bǝ yiɗi bǝi ɓǝ: Kristi dǝ nwongǝi gu lǝ baɓi, ɓi langɓǝ, yang, kaso ɓi dǝ nwongǝi ɓilǝ ba ya young ɓi! <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />Nǝ yuu a kun tthǝ i nungtǝi ya longwam langkwoi ɓyǝa youngǝu nung yangǝu nko, yang lam dang nyiu tthǝu lǝ, u to nǝnǝ u gei angǝ bǝ yiɗi Fuh tthǝ dang wai? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />Yathangǝm, bǝ yiɗi bǝi ɓi bǝ ǝǝlǝ ba a nwa ibǝ gei ba ɓuo thǝ; ǝn bǝ yiɗi bǝi ba a langǝ i, kwɔ dǝna tanatthǝu i bǝ to nungto ɓǝ.<verse eid="1JN 3:18" /></para>
  <para style="s">Tthǝnyimmi Tthasi Fuh.</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />Nungkwɔ, yang, lǝ nunglǝi kwɔ ɓi ibǝi ɓi ǝnya ba a langǝ i ɓǝ; nungkwɔ lǝ nunglǝi kwɔ nǝ langkwoi ɓi nyim tthǝɓi tthasi Fuh ɓǝ. <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />Nǝ dang nyi ɓi laɓi, yang ɓi ibǝi Fuh ghaa pǝl lo nyi ɓi langkwoi u ibǝi nung ǝndǝing. <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />Langkwoi nungkwɔ, ya ǝnthǝm kwɔ dǝm yiɗi niɓǝ, nǝ dang nyi ɓi nǝ laɓi lǝu, ɓi tthǝ i tthǝ nyimmi tthasi Fuh. <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />Ɓi tǝi nungkwɔ ǝndǝi kwɔ ɓi yam na Fuh ɓǝ, bakwɔ ɓi to nung to i zuu gu langkwoi i nungkwɔ tthǝu dǝna lǝtthǝ lkoɓǝ. <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />Nungkwɔ u gei kwɔ nungɓǝlǝ ɓi dǝ ba a langǝ i tthǝ Yuiu Yeso Kristi langkwoi ɓi yiɗi tha, manungkwɔ Kristi naɓi natthǝ ɓǝ. <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />Yakwɔ dǝna to nung to i zuu gi Fuh yang ǝǝ dang tha i Fuh langkwoi Fuh ǝǝ dang tha i ilǝ. Langkwoi lǝ ba Ɓyang kwɔ Fuh ɗǝɓi ɓi ibǝi Fuh ǝǝ dang tha i ɓi.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">Ɓyang Alangǝ i I Ɓyang Pǝllǝ.</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />Ya youngǝm kwɔ dǝm yiɗi niɓǝ, bǝɓa dǝ ba a langǝ i tthǝ yakwɔ dǝna lǝi angǝ i tthǝ i Ɓyang ɓǝthǝ, kwoi ɓa nai yangbǝ ɓa ibǝi ɓyang kwɔ wuo bǝgǝ Fuh lǝ. Bakwɔ ya gei ba a tthasi ya pǝllǝ lǝilǝ bǝi ǝndǝi longwam. <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />Nungkwɔ ǝn nungɓǝlǝ nunglǝi kwɔ ɓa ibǝi lko ǝn Ɓyang Fuh ɓǝ: yuu akwɔ ǝndǝi nǝ gwab angǝ Yeso Kristi wuo mangǝ ǝn thayuu tthǝ i Ɓyang kwɔ wuo bǝgǝ Fuh ɓǝ. <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />Kwoi yuu akwɔ nǝ yǝrnwa tthǝ nungkwɔ lǝ ba Yeso yang yangǝu i Ɓyang kwɔ ǝrr bǝgǝ Fuh ɓǝu. Ɓyang kwɔ tthǝu kwɔ ǝn a bǝ ya ɓui gi Kristi; ɓalǝ angǝ dǝu wuo, langkwoi lakwɔ u owhsi u wuo dang longwam mǝng lakwɔ.<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />Kwoi ɓǝ ǝn a bǝ Fuh, yathangǝm, langkwoi ɓa pǝll ttha ya gei ba a tthasi ya pǝllǝng, bakwɔ ɓyang kwɔ tthǝɓǝ kwɔ u nyim u pǝll ɓyang akwɔ tthǝ ya longwam kwɔɓǝ. <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />Ya gei ba a tthasi pǝllǝ kwɔ dǝi gei ba nung a longwam kwɔ, langkwoi ya longwam dǝna lǝ bagi bakwɔ i ǝnya longwam ɓǝ. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />Kwoi ɓi ǝn a bǝ Fuh. Yuu akwɔ ǝndǝi ibǝing yang Fuh dǝna lǝ ɓi; yuu akwɔ ǝndǝi ǝn a bǝ Fuh lǝu yang lǝ ɓiu, Nungkwɔ, yang, ɓi gablǝ ganglang Ɓyang ba a langǝ i i ɓyang pǝllǝ.<verse eid="1JN 4:6" /></para>
  <para style="s">Bǝ Yidɗibǝi Gi Fuh</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />Ya youngǝm kwɔ dǝm yiɗi niɓǝ, ɓi yiɗi tha, bakwɔ bǝ yiɗi bǝi wuo tthǝn bǝgǝ Fuh ɓǝ. Yuu akwɔ ǝndǝi dǝna yiɗi bǝi yang u ǝn yui Fuh langkwoi u i Fuhng. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />Yuu akwɔ yiɗi bǝi lǝu yang u i Fuh lǝu, Fuh lǝ bǝ yiɗi bǝi. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />Langkwoi Fuh taɓi natthǝ bǝ yiɗi bǝi gu ibǝ tumbǝi i Yuiu dang longwam, yangbǝ ɓi tǝi nwongǝi tthǝulǝ. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />Nungkwɔ ǝn nungɓǝlǝ bǝ yiɗi bǝi: ǝnɓi ɓi yiɗi Fuh lǝu, kwoi angǝ u yiɗi ɓi langkwoi u tum Yuiu ǝǝlǝ nunglǝi kwɔ i al nung a ɓko ɓilǝtǝ ɓǝ. <verse eid="1JN 4:10" /><verse number="11" style="v" sid="1JN 4:11" />Ya youngǝm kwɔ dǝm yiɗi niɓǝ, nǝ manung kwɔni Fuh yiɗi ɓi, yang ɓi yiɗi tha. <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />Yuu akun yangǝu kwɔ ɓyǝa Fuh bokun ɓǝ, kwoi nǝ dǝɓi yiɗi tha, Fuh ǝǝ dang tha i ɓilǝ, langkwoi bǝ yiɗi bǝi gu al long tthǝɓi.<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />Ɓi ibǝi ɓingǝ ɓi ǝǝ dang tha i Fuh langkwoi u dang tha iɓi, bakwɔ u ɗǝ ɓi Ɓyang guɓǝ. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />Langkwoi ɓi ɓyǝang langkwoi ɓi gei lǝ yakun tthǝ ɓingǝ Daa tum Yuiu mǝrǝm lǝ ya nwong lo longwam. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />Nǝɓi gei ɓingǝ Yeso ǝn Yui Fuh, ɓi ǝǝ dang tha i Fuh langkwoi Fuh dang tha i ɓilǝ.<verse eid="1JN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 4:16" />Langkwoi ɓi i naɓi lǝ ɓi ibǝing langkwoi ɓi dǝ ba a langǝ itthǝ bǝ yiɗi bǝi kwɔ Fuh dǝna yiɗi ɓilǝ ɓǝ.</para>
  <para style="p" vid="1JN 4:16">Fuh ǝn bǝ yiɗi bǝi, langkwoi yakwɔ ǝǝ dang bǝ yiɗi bǝi dǝna ǝǝ dang tha i Fuh langkwoi Fuh ǝǝ dang tha i ilǝ. <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />Bǝ yiɗi bǝi alo tthǝɓi lǝ yangbǝ ɓi tǝi tthǝ nyimmi Vii to Kwan; langkwoi ɓi tǝi bakwɔ nwongǝi ɓi longwam kwɔ natha i a Kristi. <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />Bǝ survulli yangǝu dang bǝ yiɗi bǝiu; bǝ yiɗi bǝi a langǝ i dǝna nan vulli. Bǝ yiɗi bǝi alo tthǝ yuu akwɔ dǝna survulli ɓǝu, bakwɔ vulli natha i bǝ ɗablua bǝi.<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />Dǝɓi yiɗi bǝi bakwɔ Fuh osi yiɗi ɓiɓǝ. <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />Nǝɓi gei ɓingǝ dǝɓi yiɗi Fuh, kwoi dǝɓi tthǝng ya young ɓi, ɓi ǝnya pǝllǝ. Bakwɔ ɓi ɓuan ɓi yiɗi Fuh, kwɔ ɓi ɓiu lǝuɓǝ, nǝ ɓi yiɗi yakun lǝu, yakwɔ dǝɓi ɓyǝa ɓǝ. <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />Zuu kwɔ Kristi ɗǝ ɓi kwɔ nungɓǝlǝ: yuu akwɔ nǝ dǝna yiɗi Fuh yang u yiɗi youngǝu langɓǝ.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">Bǝ Tang Loɓi Lo Longwam</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />Yuu akwɔ ǝndǝi nǝ dǝ ba a langǝ i tthǝ angǝ Yeso lǝ Kristi ǝn yui Fuh; langkwoi yuu kwɔ nǝ dǝna yidɗi Daa yang yiɗi yuiu langɓǝ. <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />Nungkwɔ ǝn nungɓǝlǝ nunglǝi kwɔ ɓi ibǝi dǝɓi yiɗi yathang Fuh ɓǝ: tthǝntthǝ bǝ yiɗi Fuh i bǝto nungto i zuu gu. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />Bakwɔ bǝ yiɗi bǝi ɓitthǝ Fuh nungɓǝlǝ bǝto nungto i zuu gu. Langkwoi zuu gu ɓuon ɓi tthǝu, <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />bakwɔ ko ǝn yui Fuh anwa a ɓuan a pǝll ttha longwam. Langkwoi ɓi tanglo lo longwam ibǝ dǝnyitthǝ ɓi. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />Ən yiǝ pǝll ttha longwam? Ən yuu akwɔ dǝ ba a langǝ i tthǝ angǝ Yeso ǝn Yui gi Fuh ɓǝ.<verse eid="1JN 5:5" /></para>
  <para style="s">Shǝdǝ Lǝba Yeso Kristi</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />Yeso Kristi lǝ yuu akwɔ wuo i mungki wolmung gu langkwoi i zii bǝ ɓui ɓua guɓǝ. U wuo i mungki ɓuo lǝu, kwoi i mungki i zii ǝndǝi, Langkwoi Ɓyang i nkolǝ gwab angǝ ǝn ba a langǝ i, bakwɔ ɓyang ǝn ba a langǝ i ɓǝ. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />Ya gei nwa yuu ni tai. <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />Ɓyang, i mungki, langkwoi i zii; langkwoi i kwɔ tai kwɔ dǝnni gwab ba natha. <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />Dǝɓi dǝ ba a langǝ i tthǝ ba gi thayuu; kwoi ba gi Fuh nyimɗing, langkwoi u gei baɓǝ kwɔ lǝba Yuiu. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />Yuu akwɔ ǝndǝi dǝ ba a langǝ i tthǝ Yui gi Fuh i tthǝ i bakwɔ dang nyiǝ lǝ; kwoi yakwɔ dǝ ba a langǝ i tthǝ Fuh lǝu, i gei angǝ Fuh ǝnya pǝllǝ, bakwɔ i dǝ ba a langǝ i tthǝ nungkwɔ Fuh gei lǝba Yuiu ɓǝlǝu. <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />Nwaba ɓǝ manungkwɔ ni: Fuh dǝɓi nwongǝi a ɗing, langkwoi nwongǝi kwɔ wuo tthǝn tthǝ Yuiu. <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />Yuu akwɔ ǝndǝi nǝ tthǝ i Yui yang u tthǝ i nwongǝi kwɔ, yuu akwɔ langkwoi nǝ yangǝu i Yui gi Fuh yang u yangǝu i nwongǝiu.<verse eid="1JN 5:12" /></para>
  <para style="s">Nwongǝi Aɗing</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />Dǝmǝn vullǝ nungvullǝ suaɓǝ yangbǝ ɓa ibǝi ɓǝtthǝ i nwongǝi a ɗing ɓǝkwɔ ɓa dǝ ba a langǝ i tthǝ Yui gi Fuh ɓǝ. <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />Ɓitthǝ i tthǝ nyimmi tthasi Fuh, bakwɔ ɓi ibǝing dǝu lǝ ɓi nǝɓi yammu lo nungkwɔ dǝu yiɗi ɓǝ. <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />Dǝu lǝ ɓi lona kwɔ ǝndǝi nǝɓi yammu ɓǝ; langkwoi kwɔ ɓi ibǝi nungkwɔ ǝn ba a langǝ i, ɓi ibǝing langkwoi dǝu dǝɓi nungkwɔ dǝɓi yam nkolǝ ɓǝ.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />Nǝɓa ɓyǝa ya young ɓǝ ya dǝba a langǝ i to nung a ɓko kwɔ tǝulǝ bǝ ɓuiɓua lǝu, yang ɓa yam Fuh, yuu akwɔ a dǝ nwongǝi lǝ yuu ɓǝ kullo ɓǝ. Dǝmǝn gei ǝnya kwɔ nung a ɓko gi tǝilǝ bǝ ɓuiɓua lǝu ɓǝ. Kwoi nung a ɓko akuntthǝ kwɔ a tǝlǝ bǝi lǝbǝ ɓuiɓua ɓǝ, langkwoi dǝmǝn geigǝ ɓa pinwa tthǝ Fuh lǝ ba ɓǝ kullo lǝu. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />Bǝ galnung ǝndǝi ǝn nung a ɓko, kwoi nung a ɓko akun tthǝ kwɔ tǝlǝ bǝi lǝ bǝ ɓuiɓuko ɓǝ.<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />Ɓi ibǝing yathang Fuh yangǝu kwɔ a ǝǝnwa bǝto nung a ɓko ɓǝ, bakwɔ Yui gi Fuh dǝna kangǝ i matthǝ, langkwoi Mungkullum ɗab luaiu.<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />Ɓi ibǝi ɓingǝ ɓi ǝn yathang Fuh ko kwɔ Mungkullum dǝna loyigwoi lo longwam ǝndǝi ɓǝ.<verse eid="1JN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20" />Ɓi ibǝi ɓingǝ Yui gi Fuh wuong langkwoi u dǝɓi bǝ ibǝi nung, yangbǝ ɓi ibǝi Fuh a langǝ i. Ɓi ǝǝ dang tha i Fuh a langǝ i- dang tha i Yuiu Yeso Kristi. Nungkwɔ lǝ Fuh a langǝ i, nungkwɔ lǝ nwongǝi a ɗing.<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />Yathangǝm, ɓa kang loɓǝ matthǝ bǝɓa muo sua fuh kwɔ na yuu mab ɓǝthǝ!<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>