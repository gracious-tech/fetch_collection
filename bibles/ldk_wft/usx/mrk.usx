<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- MUNGA BIBLE</book>
  <para style="h">Markus</para>
  <para style="toc1">Markus</para>
  <para style="toc2">Markus</para>
  <para style="toc3">MK</para>
  <para style="mt2">Nwaba a Langǝ i Nwa Markus</para>
  <para style="mt1">Markus</para>
  <para style="imt">Bǝ Gabnung Ba</para>
  <para style="ip">
    <char style="bk">Nwaba a langǝ i nwa Markus </char> bai piu i ba kwɔ angǝ &lt;&lt;Nwaba a Langǝ i lo Yeso Kristi, Yui Fuh,&gt;&gt;I tanatthǝ Yeso mangǝn yiɓǝi ya to nung to i ttha. I ɓyǝa Ttha gu dang bǝ nanatthǝnung gu, dang ttha gu lo i bǝnǝng, langkwoi dang bǝ al nung a ɓau yayuu lǝtǝ. Yeso gei ba lo i nko lǝ mangǝ ǝn yui yuu, kwɔ wuo bǝ dǝ nwongǝi gu yangbǝ u illǝ yayuu dang nung a ɓau.</para>
  <para style="ip">
    <char style="bk">Markus</char> gei nwa muani gi Yeso juantthǝ, i nunglǝi a nyimmi, i bǝ onyitthǝ lo nungkwɔ Yeso to ɓǝ, pell ba abo i nko lǝ langkwoi i bǝ nanatthǝnung gu. Tthasua bǝ gabnung tuab lo Yohanna ya wollmung langkwoi i bǝ wollmung i bǝ na Yeso, ya nungvullǝ ɓu dang tthǝ gei nung to dǝ tthǝla langkwoi bǝ nanatthǝnung gi Yeso. Kwɔ lona lilotthǝ, ya nanung to gi Yeso wuo iu la langǝ i, kwoi dang wa ya ɓui gi Yeso mǝrrǝm ɓkotthǝ. Bǝ alo nungvullǝ ɓǝ gei ba lo nwongǝi gi Yeso a mako a sua, manung gi bǝ piu lo kab gangǝ i i bǝ ǝrru i nwongǝi dang bǝ ɓui ɓua.</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">Bǝ Nanatthǝnung Yohanna Ya Wollmung</para>
  <para style="r">(<ref loc="MAT 3:1-12">Matthew 3:1-12</ref>; <ref loc="LUK 3:1-18">Luka 3:1-18</ref>; <ref loc="JHN 1:19-28">Yohanna 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Nungkwɔlǝ bǝ baipi nwa ba a langǝ i lo Yeso kristi, Yui Fuh.<verse eid="MRK 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 1:2" />Manungkwɔ Ishaya ya gei ba a tthasi vullǝ dang nungvullǝ gu kwɔ angǝ:</para>
  <para style="q1" vid="MRK 1:2">&lt;&lt; Fuh gei angǝ, &lt;mǝn tum ya nwatumim a osimǝ,</para>
  <para style="q2" vid="MRK 1:2">ta mab nunglǝi a dǝ lǝ ba mǝ.&gt;<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />&lt;&lt; Yuu akun dǝna gei i yoll losua a kwi (bǝikwɔ kap a tuabtuab tthǝɓuo nung yangǝu dǝna pitthǝuɓǝ angǝ,)</para>
  <para style="q2" vid="MRK 1:3">&lt;Mab lǝi lǝ Dangbang tthǝ, ɓa mab nung lǝi juantthǝ lǝ ba gu.&gt; &gt;&gt;<verse eid="MRK 1:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MRK 1:4" />Nungkwɔ Yohanna ya wollmung fug losua a kwi bǝikwɔ kab a tuabtuab tthǝɓuo nung yangǝu dǝna pitthǝuɓǝ, dǝnnu gei ba a langǝ itthǝ dǝnnu wollimung ba. &lt;&lt;Ɓa yitthǝ nung a ɓko ɓǝlǝtǝ yangbǝ i wollɓǝ mung, &lt;&lt;Yang Fuh a al nung a ɓko ɓǝlǝtǝ.&gt;&gt; <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Yayuu kpaatthǝ losua Yahudiya i dang gong gwoi Urshalima i tǝ suo tǝi lǝ ba gu. Dǝi gei nwa ɓko ba gi, Yohanna wollimung dang ɗual Urdun. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />Yohanna li nunglitthǝ zuǝ Jurobǝ i nung tthǝbtthǝ a zuǝ lo luǝu lǝ, nungtang gu ǝn thǝl i song dang gug. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Ba gi Yohanna manungkwɔni: &lt;&lt;Tthasuam yuu a kun tthǝ kwɔ ghaa pǝllǝm, ǝn natthǝ kwɔ mǝn bi ɓǝl ǝko gu ɓǝlǝu. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Dǝm wollɓǝ mung i mungki, kwoi u wollɓǝ mung i Ɓyang a Langǝ i gi Fuh.&gt;&gt;<verse eid="MRK 1:8" /></para>
  <para style="s">Bǝ Wolmung I Bǝ Naa Yeso</para>
  <para style="r">(<ref loc="MAT 3:13">Matthew 3:13</ref>; <ref loc="MAT 4:11">4:11</ref>; Luka 3:21, 22; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Lona lǝ kullo Yeso kwoi Nazarat dang Galili nungkwɔ Yohanna wollǝu mung dang ɗual Urdun.<verse eid="MRK 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 1:10" />Dangtthǝ kwɔni Yeso dǝna i dang mung lǝ, u ɓyea wayi ɓko Ɓyang gi Fuh dǝna pin wayi lǝ mǝngǝn Gko. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Yol Fuh wuo wayi angǝ: &lt;&lt;Mǝn Yuim, kwɔ dǝmǝn yiɗi ɓǝ; tthǝm dǝna lǝ tthǝla i mǝ.&gt;&gt;<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Ba a nwaɓi kwɔ Ɓyang gi Fuh oulǝsi tǝlǝ losua a kwi bǝikwɔ kab tuabtuab tthǝ ɓuo nung yangǝu dǝna pi tthǝuɓǝ, <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Yeso losua a kwi lǝ bo thǝmrab, Shǝtan dǝna nko. U bǝilǝ i nyam dang gug, ya nwatummi gi Fuh wuu duu nungkwɔ dǝnnu yiɗi ɓǝ.<verse eid="MRK 1:13" /></para>
  <para style="s">Yeso Lubǝ Ya Muo Tthǝng Nai</para>
  <para style="r">(<ref loc="MAT 4:12-22">Matthew 4:12-22</ref>; <ref loc="LUK 4:14-15">Luka 4:14-15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Tthasua kwɔ i thǝb Yohanna pursǝna, Yeso tǝ Galili, dǝu gei ba a langǝ i gi Fuh. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />U gei angǝ,&lt;&lt;Lona a langǝ i ɓǝ wuung, Lona gi Fuh gbagǝng kwɔ a nwong yayuu gu ɓǝ. Ɓa mǝrrǝm lo nyi ɓǝ ɓa al nung a ɓkoɓǝ lǝtǝ ɓa dǝba a langǝ i tthǝ ba gi Fuh!&gt;&gt;<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Yeso dǝna thko nwa mung Galili, u ɓyǝa ya muo tthǝng rab Saminu i youngǝu Andarawas dǝi al kali dang mung, dǝnni muo tthǝng. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Yeso gei angǝ, &lt;&lt;Ɓa muo suam, yang mǝn naɓǝnatthǝ bǝ mua yayuu ɓa wɔlǝ sua Fuh.&gt;&gt; <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Ba a nwaɓi kwɔ i yithǝ kalli gi i muo suo.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Yeso pa tǝsi tuab, u ɓyea Yakubu yui Zabadi i youngǝu Yohanna dang kwai dǝi mab kalli gi. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Yeso ɓuontthǝ lǝu u lubǝi, i yitthǝ Daa gi, Zabadi dang kwai lǝ i yakwɔ i lǝi lǝ ba bǝ muo tthǝng ɓǝ i mua suo.<verse eid="MRK 1:20" /></para>
  <para style="s">Yesu Ilǝ Ɓyang Aɓau Tthǝ Yiɓǝi Akun</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luka 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Yeso i ya nanung to gu wuo gwoi angǝ a Kafarnahum, Vii nwongǝi ya Yahudawa Yeso tǝ dang kǝm kǝptha ya Yahudawa dǝu nanatthǝ nung. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Yayuu kwɔ lǝ Yeso dǝna nanatthǝ nung kwɔ loi fǝm tthǝ bǝ nanatthǝnung gu, ba kwɔ dǝu nanatthǝnung mǝngǝn yuu kwɔ tthǝ i tthǝnyimmi, manung ya nanatthǝnung gi Musa Lǝu. <verse eid="MRK 1:22" /><verse number="23" style="v" sid="MRK 1:23" />Bǝilǝ kullo yiɓǝi akuntthǝ i ɓyang a ɓko wuo dang kǝm bǝ kǝptha ya Yahudawa buogbǝi i yol angǝ, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />&lt;&lt;Ənɓǝtǝn dǝma yiɗi i ɓi, Yeso ya Nazarat? A wuo bǝ thǝb ɓiǝ? Ən iǝang; mǝn ya nwatummi a langǝ i kwɔ wuo bǝgǝ Fuh ɓǝ!&gt;&gt;<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />Yeso gei ɓyang a ɓko ɓǝ angǝ,&lt;&lt;A kǝr nwa nǝkwam, a i tthǝu!&gt;&gt; <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />Ɓyang a ɓko ɓǝ thǝuri yiɓǝi ɓǝ nyimtthǝ, nwuni bǝ u i tthǝu lǝ.<verse eid="MRK 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27" />Yayuu kwɔ bǝilǝ kwɔ loi dǝna fǝm dǝi ɓib tha angǝ,&lt;&lt;Ənɓǝtǝn kwɔ? Bǝ nanatthǝnung afu? Yiɓǝi kwɔ tthǝ i tthǝnyimmi! Kwɔ u dǝ kab nwa ɓyang a ɓko tthǝ u duu angǝ a!&gt;&gt;<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />Dangtthǝ nwa ba gi Yeso lǝi bǝikwɔ ǝndǝi losua Galili.<verse eid="MRK 1:28" /></para>
  <para style="s">Yeso Dǝtthǝla Lǝ Yayuu Kpaatthǝ</para>
  <para style="r">(<ref loc="MAT 8:14-17">Matthew 8:14-17</ref>; <ref loc="LUK 4:38-41">Luka 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Yeso i ya nanung to gu, gǝmtthǝ Yakubu i Yohanna, i yitthǝ kǝm kǝbtha ya Yahudawa i tǝ gwoi gi Saminu i Andarawas.<verse eid="MRK 1:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 1:30" />Gong gi Saminu a yisi tthǝu lko u lolǝ lo dang tthǝ kwɔ Yeso wuoni yang i geiu tthǝ. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Yeso tǝsuo, tǝ muo nko u ǝrrǝu lǝ. Tthǝsɔnni ɓǝ yiu ǝrr u ji nungtang.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Nunglui lǝkwɔ fuh dǝna o yayuu wuo lǝ ya nungzii i ya kwɔ wa tthǝi kwɔ lǝ sua Yeso. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Yayuu gwoi angǝ a lǝ ǝndǝi gǝmtha nwalǝgwoi lǝ, <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Yeso ilǝ nung zii tthǝ yayuu kpaatthǝ. U ilǝ wa a ɓko tthǝ yayuu, u yittha wa ɓǝ gei ba lǝu, wa ɓǝ i Yeso yang.<verse eid="MRK 1:34" /></para>
  <para style="s">Yeso Nanatthǝnung Galili</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luka 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Ibǝikan nung gwoi ɗǝng, yirrǝ bǝi baithǝl tthǝ Yeso ǝrr yitthǝ dang gwoi ɓǝ, Yeso tǝ bǝikwɔ yayuu yangǝu tthǝɓǝ tǝu pinwa. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Saminu i yakwɔ dǝi gǝng suatha kwɔ i ǝrr dǝi ɗuubǝiu, <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />Langkwoi kwɔ i tǝiu, i geiu angǝ,&lt;&lt;Yayuu ǝndǝi dǝna ɗuubǝimǝ.&gt;&gt;<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Kwoi Yeso gei angǝ,&lt;&lt;Ɓitǝ gwoi atuab kwɔ gɓag bǝikwɔ ɓǝ. Yangbǝ tǝn nanathǝnung langɓǝ, Ən wuo lǝn ba ɓǝkwɔ.&gt;&gt;<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />Nungkwɔ Yeso thko dang Galili ǝndǝi, dǝu gei ba Fuh dang kǝm kǝbtha ya Yahudawa dǝu ilǝ ɓyang a ɓko.<verse eid="MRK 1:39" /></para>
  <para style="s">Yeso Dǝtthǝla Lǝ Yiɓǝi Akun Ya Əmbǝlai</para>
  <para style="r">(<ref loc="MAT 8:1-4">Matthew 8:1-4</ref>; <ref loc="LUK 5:12-16">Luka 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Yiɓǝi akun tthǝ i nungzii ǝmbǝlai wuo sua Yeso wuu bainwa longǝu sua u ɗyǝab bu, angǝ,&lt;&lt;Nǝ a gwabǝng, yang a dǝm tthǝla.&gt;&gt;<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Yeso ɓyǝa nung zuii gu, u juan nko tǝu kǝn natthǝu u geiu angǝ.&lt;&lt;Ən gwabǝng, A tǝi tthǝla!&gt;&gt; <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Dangtthǝ ǝnbǝlai ɓǝ i tthǝ yiɓǝi lǝ, u tǝi tthǝla.<verse eid="MRK 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 1:43" />Ərr Yeso gub ɗogsuiu geiu angǝ u pa, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />Yeso geiu angǝ, &lt;&lt;Bǝ a gei lǝ yuu akun tthǝthǝ. Kwoi atǝ, ta tanatthǝmǝ lǝ ya nyǝknung ɓyǝa; yangbǝ yayuu ibǝi angǝ a tǝi tthǝ lang a dǝ nungkwɔ Musa geilǝ ba bǝtǝi tthǝla mǝ, lǝ nwa bamǝ tthǝulǝ.&gt;&gt;<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />Yang kwoi u i gwam dǝnnu gei nwaba nǝkwam, dǝu gei nwa ba nungkwɔ tǝiu ɓǝ. Lǝ ba nungkwɔ, Yeso ɓuan tǝ dang gwoi angǝ a akun dang nung yayuu lǝlǝu. Dǝu ǝǝ i nungtthǝu. Yirrǝ yayuu bǝikwɔ ǝndǝi dǝna wua suo.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Yeso Dǝ Tthǝla Lǝ Ya Kuglǝ</para>
  <para style="r">(<ref loc="MAT 9:1-8">Matthew 9:1-8</ref>; <ref loc="LUK 5:17-26">Luka 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Lotthǝ sua tulǝu Yeso kwoi suo tǝ Kafarnahum, nwa bagu lǝilǝ bǝi angǝ u wua gwoi yang. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Nungkwɔ yayuu gǝmtha kpaatthǝ bǝ tambo yangǝu i nwa kǝm a gwam ǝndǝi, u gei ba a langǝ i tthǝ i gwam ǝndǝi. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Yaɓǝi akun nai lǝi yiɓǝi yakuglǝ wuo lǝ sua Yeso. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Kwoi lǝ ba kon yayuu i ɓuan i tǝllǝ yiɓǝi ɓǝ lǝ sua Yeso lǝu, i fǝll lo kǝm ɓǝ bǝikwɔ Yeso tthǝɓǝ, I pin lǝ yiɓǝi ɓǝ bǝikwɔ i fǝll ɓǝ i kab tabǝi kwɔ u lo tthǝɓǝ. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Yeso ɓyǝa ghaali bǝdǝ ba a langǝ i gi, Yeso geilǝ ya kuglǝ ɓǝtthǝ angǝ,&lt;&lt;Yuim, ǝn al nung a ɓau mǝ lǝtǝng.&gt;&gt;<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Yakun dang ya nanatthǝnung Musa ǝǝ bǝilǝ, dǝna gei ba ɓuailǝ angǝ, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />&lt;&lt;Ənba ɓǝ bǝ yuukwɔ dǝna gei ba ni? Dǝu na lo lǝtha i Fuh! Ən Fuh ɓuo lǝ ya al nung a ɓko gi yuu lǝtǝ!&gt;&gt;<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Dangtthǝ Yeso ibǝi nungkwɔ dǝi nhǝm dang wai kwɔ, u ɓibbǝi angǝ&lt;&lt;Ən baɓǝ bǝ dǝɓa nhǝm ba niǝ? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Dang nungkwɔ rab kwɔ ǝn anwɔ ziu kwɔ i gei ɓa, &lt;Ya kuglǝ, ǝn al nung a ɓko mǝ lǝtǝng,&gt;ko kwɔ mǝn gei gǝngǝ, &lt;Ərr a dǝinǝbo, lǝi gei mǝ, a thko!&gt; <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Yangbǝ ɓa ibǝi Ɓang Yui Yuu tthǝ i ttha longwam kwɔ bǝ al nung a ɓko lǝtǝ.&gt;&gt; Nungkwɔ Yeso geilǝ yiɓǝi ɓǝ angǝ, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />&lt;&lt;Ən geitthǝ, ǝrr a dǝinǝbo, lǝi gei mǝ, atǝ gwoi!&gt;&gt;<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />Kwɔ yirrǝ dǝnni ɓyǝa, yiɓǝi ɓǝ ǝrr dǝi nǝbo, yiɓǝi ɓǝ lǝi gei gu pa dang nung yayuu ǝndǝi. Nungkwɔ fǝmlo yayuu i tǝ bǝ kha Fuh, dǝi gei angǝ, &lt;&lt;Ɓi ɓyǝa nung manungkwɔ ni lǝu bo kun!&gt;&gt;<verse eid="MRK 2:12" /></para>
  <para style="s">Yeso Lubǝ Lawi</para>
  <para style="r">(<ref loc="MAT 9:9-13">Matthew 9:9-13</ref>; <ref loc="LUK 5:27-32">Luka 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Langkwoi Yeso thko tǝ nwa Mung Galili. Kon yayuu kpaatthǝ muo suo, u tǝbǝ nainatthǝ nung. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Kwɔ u lilotthǝ dǝu thko, u ɓyǝa Lawi yui Halfa u ǝǝ bǝ to nung to gu dǝnnu muo nungǝmmi tthǝɓǝ. Yeso geiu angǝ&lt;&lt;A muo suam.&gt;&gt; Nungkwɔ Lawi ǝrr muo suo.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Natthǝ Yeso da tangnung a nunglui dang gwoi gi Lawi, ya muo nungǝmmi kpaatthǝ i ya nung a ɓko dǝna tangnung i ulǝ i ya nanung to gu, yayuu kpaatthǝ mua suo. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Yakun dang ya nanatthǝnung gi Musa kwɔ ǝn ya Farisiyawa kwɔ ɓyǝko dǝnnu tangnung lotha i ya muo nungǝmmi i ya nung aɓau, i ɓib ya nanung to gu angǝ, &lt;&lt;Ən baɓǝ bǝ dǝu tangnung lotha i ya nung a ɓko?&gt;&gt;<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Yeso lǝ nungkwɔni, u gei angǝ,&lt;&lt; Ən ya tthǝla dǝna yiɗi bǝ ɓyea yadǝ yǝnglǝu, yakwɔ tthǝilko ɓǝ. Ən wuo bǝ lubǝ ya langǝ i lǝu, kwoi ǝn wuo ba ya nung a ɓko.&gt;&gt;<verse eid="MRK 2:17" /></para>
  <para style="s">Bǝ Ɓib Ba Lo Bǝ Zuu Fuh</para>
  <para style="r">(<ref loc="MAT 9:14-17">Matthew 9:14-17</ref>; <ref loc="LUK 5:33-39">Luka 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Vii akun ya nanung to gi Yohanna i ya Farisiyawa dǝi zuu fuh. Yakun wuo ɓib Yeso angǝ,&lt;&lt;Ən ba ɓǝ bǝ ya nanung to gi Yohanna dǝna zuu fuh i ya nanung to ya Farisiyawa, kwoi yayuu mǝ zuu wa?&gt;&gt;<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Yeso gwabǝi nwa angǝ,&lt;&lt;Dǝɓa yiɗi yayol kwɔ tǝ pang ɓang bǝ dǝb yisi tǝgwoi i gwomma? Yangǝu! Kwɔ yirrǝ yiɓǝi ɓǝ i ilǝ ɓǝ. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Kwoi Lona dǝna wɔ kwɔ i lǝi yiɓǝi dǝb yisi ɓǝ tthangǝ i, villǝ kwɔ yang i zuu fuh tthǝ.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />&lt;&lt;Yuu akun yangǝu a fyǝh nunglitthǝ afu i trǝnung aku, Nǝ u to manungɓǝ, trǝnung afu ɓǝ a ɓko tthǝ aku lǝ, bǝiɓǝ a trǝɓkotthǝ. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Langkwoi yuu akun yangǝu a al min afu dang kulluk aku kwɔ i mab i zuǝ ɓǝ, Nǝ u to manungɓǝ yang min ɓǝ a ɓuom kulluk ɓǝ, yang min ɓǝ a alǝtǝ. Nilǝu, u al min afu dang kulluk afu kwɔ i mab zuǝ ɓǝ.&gt;&gt;<verse eid="MRK 2:22" /></para>
  <para style="s">Bǝ Ɓib Ba Lo Vii Nwongǝi Ya Yahudawa</para>
  <para style="r">(<ref loc="MAT 12:1-8">Matthew 12:1-8</ref>; <ref loc="LUK 6:1-5">Luka 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Vii nwongǝi akunlǝ, Yeso dǝna thko dang zuk min, langkwoi kwɔ ya nanung to gu dǝna tthko i ulǝ, dǝnni har lo min. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Ərr ya Farisiyawa geiu angǝ,&lt;&lt;A ɓyǝa, i zun ǝn zuu nungkwɔ ya nanung to mǝ dǝna to vii nwongǝi ɓǝ!&gt;&gt;<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />Yeso gei angǝ,&lt;&lt; Ɓa than nungkwɔ Dawuda to lona kwɔ gwom tǝu u i ya gǝng suatha i ulǝ dǝnni yiɗi nungtang ɓǝlǝu? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Dang gwam Abiyata yikku ya nyǝknung, u tǝ dang kǝm Fuh u tang nungkwɔ ǝn ya nyǝknung ɓuo a tang ɓǝlǝu. Langɓǝ u tang u dǝ suo lǝ ya gǝng suatha i ulǝ ɓǝ.&gt;&gt;<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Ərr Yeso alo angǝ,&lt;&lt;I mab vii nwongǝi ǝn ba thayuu; thayuu lǝ ba vii nwongǝi lǝu. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Bakwɔ ɓang Yui Yuu lǝ Dangbang i vii nwongǝi ǝndǝi.&gt;&gt;<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">Yiɓǝi Kwɔ Nko Ɓuiɓui Ɓǝ</para>
  <para style="r">(<ref loc="MAT 12:9-14">Matthew 12:9-14</ref>; <ref loc="LUK 6:6-11">Luka 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Langkwoi vii akun lǝ Yeso kwoi suo tǝ dang kǝm gǝmtha ya Yahudawa, yiɓǝi akun kwɔ nko ɓuilǝɓui kwɔ bǝilǝ. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Yakun dang ya Farisiyawa dǝna ɗuu nunglǝi yangbǝ i muo Yeso, dǝnni dǝ nung tthǝu angǝ ttha yakun u ilǝ nung zii vii nwongǝi. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Yeso geilǝ yiɓǝi ɓǝkwɔ nko ɓuiɓui kwɔ angǝ,&lt;&lt;A wuo tthasi yayuu kwɔ ǝndǝi.&gt;&gt;<verse eid="MRK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 3:4" />Nungkwɔ Yeso mǝrrǝm ɓib yayuu angǝ,&lt;&lt;Ən ɓǝtǝn nung zuu ɓi gwabɓitthǝ ɓito vii nwongǝi: ɓito a langǝ i na ko ɓi to nung a ɓko, angǝ ɓi dǝ angǝ a lǝ yayuu na ko ɓi nkoni gi? Angǝ ɓi nwong yuu na ko ɓi thǝi?&gt;&gt;Kwoi i kǝr ǝndǝi.<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />Dangwa Yeso ɓanglǝ lǝ ɓang kwɔ dǝnnu ɓyǝai ɓǝ, kwoi langkwoi dǝnnu ɓyea nungzuii gi, ba ɓuasui gi i nung a ɓko. &lt;&lt;A Juan namǝ.&gt;&gt;Yiɓǝi ɓǝ juan nko, dang tthǝ nko kwoi natha. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Ərr ya Farisiyawa i dang kǝm gǝmtha ya Yahudawa wui tǝitha i yayuu gi Hiridus dǝnni ɗulǝi dang bǝthǝl yangbǝ i thǝb Yeso.<verse eid="MRK 3:6" /></para>
  <para style="s">Kon Yayuu Nwa Mung</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Yeso i ya nanung to gu kwoi tǝ nwa mung Galili, langkwoi gong kon yayuu muo suo. Yakun ǝrr Galili, Yahudiya, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />yakun ǝrr Urshalima, i losua Edom, i losua kwɔ gwam mung Urdun gbag Taya i Sidon ɓǝ. Yayuu kwɔ ǝndǝi wuo sua Yeso ba nungkwɔ i lǝ dǝnnu to ɓǝ. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Yeso gei ya nanung to gu angǝ i ji kwai a tuab tthǝ dǝnaki, yangbǝ bǝ yayuu tammǝi thǝ. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Yeso dǝ tthǝla lǝ ya nungzii kpaaɗing, yakwɔ i nungzii dǝna toktha yangbǝ i kǝnna tthǝu.<verse eid="MRK 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 3:11" />Vii kwɔ ǝndǝi nǝ yakwɔ wa tthǝi nǝ ɓyǝa Yeso, yang wa ɓǝ dǝna wailǝtǝ pangsua tthasiu dǝnni buogbǝi angǝ,&lt;&lt;Mǝn Yui Fuh!&gt;&gt;<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />Kwoi Yeso laggei angǝ bǝ i gei ba gi lǝ yakun tthǝ angǝ i ǝn yittǝn thǝ.<verse eid="MRK 3:12" /></para>
  <para style="s">Yeso Mko Ya Nwatummi Gu Sob Iu Rab</para>
  <para style="r">(<ref loc="MAT 10:1-4">Matthew 10:1-4</ref>; <ref loc="LUK 6:12-16">Luka 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Yeso ɗap tal tǝ ǝǝ yilǝ nungkwɔ u lubǝ yakwɔ dǝnnu yiɗi ɓǝ, i wua suo, <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Yeso mko yayuu sob iu rab, yakwɔ u ji ɗuǝn lǝ ya nwatummi gu ɓǝ. &lt;&lt;Ən mko ɓǝ yangbǝ ɓa ǝǝ i ɓang,&gt;&gt;langkwoi mǝn tumm ɓǝ yangbǝ tǝɓa gei ba Fuh langɓǝ <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />Yangbǝ i tǝi tthǝnyimmi i ilǝ wa a ɓko.&gt;&gt;<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />Ya nwatummi gu kwɔ u mko sob iu rab kwɔ i manungkwɔ ni: Saminu (kwɔ Yeso duu ɗuǝn lǝ Bitrus ɓǝ); <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Yakubu i youngǝu Yohanna yathang Zabadi, (Yeso ji ɗuǝn lǝ Buwanarjis nungkwɔ lǝ yathang gamvǝr&gt;&gt;); <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />I Andarawas, i Filibus, i Bartalamawas, i matta, i Toma, i Yakubu yui Halfa, i Yahuza, i Saminu ya kan'ana kwɔ yiɗi losua gu niɓǝ, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />I Yahuda Iskariyoti yuu kwɔ ɗyǝab Yeso ɓǝ.<verse eid="MRK 3:19" /></para>
  <para style="s">Yeso I Yigwoi Ba'alzabul</para>
  <para style="r">(<ref loc="MAT 12:22-32">Matthew 12:22-32</ref>; <ref loc="LUK 11:14-23">Luka 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Ərr Yeso kwoi tǝ gwoi akun, Langkwoi kon yayuu gǝmtha, kwɔ u i ya nanung to gu i ɓuan i tang nunglǝu. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Kwɔ Yayuu gu lǝ ba ɓǝ, itǝ tǝi muu bakwɔ yayuu dǝna gei angǝ&lt;&lt;Kiggǝu yangǝu!&gt;&gt;<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Yakun dang ya nanatthǝnung gi Musa yakwɔ ǝrr Urshalima wɔ kwɔ gei angǝ, &lt;&lt;Wa Ba'alzabul tthǝu! I tthǝnyimmi gi wa dǝnnu ilǝ wa.&gt;&gt;<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Yeso lubǝi gei ba dang bǝ liba angǝ: &lt;&lt;Mungkullum a to nǝnǝ a nan Mungkullum? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Nǝ losua gab dang tha rab yang, losua ɓǝ kwɔ dǝiu. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Nǝ gwoi gabtha rab dǝna ɓuob vǝm ɓuoi yang, gwoi ɓǝkwɔ dǝiu. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Nǝ Mungkullum dǝna la ba gu i nko lǝ langkwoi gablolǝtha, yang u ɓuan u dǝiu; abo thǝm yang u yǝbtha. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />Ba a langǝ i, yuu akun yangǝu kwɔ a tǝ dang gwoi ya tthaa tǝ lǝi nung nko ɓǝ la nwasiu nǝ u tthǝb ya tthaa ɓǝɗe. Yangbǝ u i nung dang gwoi gu.<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />&lt;&lt;Ən gei ɓǝ ba a langǝ i tthǝ, nung a ɓko i bǝ dal Fuh kwɔ yayuu dǝna to kwɔ i alǝtǝn al. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Kwoi yuu kwɔ dal Ɓyang a langǝ i gi Fuh, Fuh al nung a ɓko gu lǝtǝu, bakwɔ u to nung a ɓko kwɔ a ɗing bǝgǝ Fuh.&gt;&gt;<verse eid="MRK 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 3:30" />Yeso gei nungkwɔ lǝ bakwɔ dǝi gei angǝ,&lt;&lt;U tthǝ i wa a ɓko ɓǝ.&gt;&gt;<verse eid="MRK 3:30" /></para>
  <para style="s">Naa Gi Yeso I Yayoungǝu</para>
  <para style="r">(<ref loc="MAT 12:46-50">Matthew 12:46-50</ref>; <ref loc="LUK 8:19-21">Luka 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Ərr naa gi Yeso i ya youngǝu wuo. I dǝi gwam, i tumm yuu akun tǝ lubǝiu. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Kon yayuu ǝǝ tthangǝu, i geiu angǝ,&lt;&lt;I naamǝ i ya youngmǝ yaɓǝi gwam dǝnni ɗuubǝimǝ.&gt;&gt;<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Yeso gei angǝ&lt;&lt;Ən yaɓǝ lǝ i naam i ya youngǝm ma?&gt;&gt;<verse eid="MRK 3:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 3:34" />Ərr u ɓyea yakwɔ ǝǝ kwarǝu kwɔ u gei angǝ,&lt;&lt; Ɓa ɓyǝa! Yakwɔ lǝ ya naam i ya youngǝm <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Yuu kwɔ to nungkwɔ Fuh dǝna yiɗi i ɓǝlǝ ya youngǝm yaɓǝi i yasi i naam.&gt;&gt;<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Bǝ Liba Lo Nungbyǝa</para>
  <para style="r">(<ref loc="MAT 13:1-9">Matthew 13:1-9</ref>; <ref loc="LUK 8:4-8">Luka 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Langkwoi Yeso baipi bǝ nanatthǝnung nwa Mung Galili. Gong kon yayuu kwɔ gǝmtha tthangǝu kwɔ kpaaɗing nungkwɔ u tǝ dang kwai tǝu ǝǝtthǝ nwa Mung lǝ, kon yayuu ɓǝ dǝi nwangwam lǝ. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Yeso nainatthǝnung kpaatthǝ dang bǝ liba, dang bǝ nanatthǝnung gu u gei angǝ:<verse eid="MRK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3" />&lt;&lt;Ɓalǝ! Ya nunglǝbi akun tǝbǝ bie nung. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Kwɔ dǝu wurǝ nungbie ɓǝ zuk lǝ, yakun al lo nung lǝi, i nurug wu kǝm mi. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Nungbie ɓǝ yakun al lo nungzǝrri tal, bǝikwɔ sua kpako tthǝɓǝ. I pi thǝmtthǝ, bakwɔ sua kpako ɓǝ. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Kwoi kwɔ fuh ɗab, fuh tangǝ i, nungbie ɓǝ yulǝ bakwɔ yǝngǝu tǝsua lǝu ɓǝ. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Nungbie ɓǝ yakun al dang kob, i ghaa yang kob ɓǝ tthakklǝi, i to nung matthǝ lǝu. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Langkwoi nungbie ɓǝ yakun al losua a langǝ i. I pi, i ghaa i to nungmatthǝ; yakun to nung bo thǝmkun pǝmna sob, yakun thǝmtai, yakun thǝm nu.&gt;&gt;<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Ərr Yeso gei angǝ,&lt;&lt;Yuu akwɔ tthǝ i ɓuasui lǝbǝi! U lǝ&gt;&gt;<verse eid="MRK 4:9" /></para>
  <para style="s">Bǝ Alo Bǝ Liba</para>
  <para style="r">(<ref loc="MAT 13:10-17">Matthew 13:10-17</ref>; Luka 8:9, 10)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Kwɔ Yeso i nungtthǝu lǝ, ya nanung to gu sob iu rab kwɔ i yakun tthangǝu lǝ ɓibbu ba lo bǝ liba. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Yeso gei tthǝ angǝ, &lt;&lt;I gei ɓǝ ba tthǝ lo nung kwɔ ɓa ibǝilǝu lona kwɔ Fuh wa lo yigwoi ɓǝ. Kwoi lǝ ba yakwɔ gwam i geitthǝ dang bǝ liba <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />yangbǝ,</para>
  <para style="q1" vid="MRK 4:12">&lt;&lt;&lt;Vii ǝndǝi dǝnni ɓyea kwoi i ɓuan i ɓyeko;</para>
  <para style="q2" vid="MRK 4:12">langkwoi i lǝ, kwoi i ibǝiu.</para>
  <para style="q1" vid="MRK 4:12">Nilǝu yang ǝrr i ee nwa nung a ɓko gi yang u al nung a ɓko gi lǝtǝ!&gt;&gt;&gt;<verse eid="MRK 4:12" /></para>
  <para style="s">Yeso Gab Nungǝi Lobǝ Liba Lo Nungbyǝa</para>
  <para style="r">(<ref loc="MAT 13:18-23">Matthew 13:18-23</ref>; <ref loc="LUK 8:11-15">Luka 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Ərr Yeso ɓibbǝi angǝ, &lt;&lt;Ɓa ibǝ bǝ liba kwɔ lǝu? Nǝnǝ, yang ɓa ibǝ bǝ liba a kun? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Yanung lǝbbi ɓǝ bie ba Fuh. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Yayuu yakun itha i nungbyea kwɔ dang nunglǝi, kwɔ i bie ba Fuh tthǝɓǝ. Dangtthǝ kwɔ i lǝ bakwɔ, Mungkullum wuu lǝi nai palǝ. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Yakun itha i nungbyea akwɔ al lo nungzǝrri tal ɓǝ, ilǝ ba ɓǝ dang tthǝ i muo i tthǝla. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Kwoi ba kwɔ yǝngǝi tǝsua lalangǝ i lǝuɓǝ, suai tulǝu. Kwɔ nung gip nungǝi lǝ ba Fuh, dang tthǝ i o. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Yirrǝ yakun, itha i nungbyea akwɔ i bie dang kob lǝɓǝ. I lǝ ba Fuh, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />Yang lǝ ba nung longwam, i nungtǝi i bǝ yiɗi nung longwam wuu ɓanglǝ ba gi Fuh, i to nung a langǝ i lǝu. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Yakun, itha i nungbyǝa kwɔ i bie losua a langǝ i ɓǝ. I lǝ ba Fuh, langkwoi i muo ba ɓǝ i to nung thǝmrab pǝmna sob, yakun thǝmtai yakun pǝl thǝmnu.&gt;&gt;<verse eid="MRK 4:20" /></para>
  <para style="s">Fitilǝ Lo Nungdǝu</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luka 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Yeso lilotthǝ gei angǝ,&lt;&lt; Dǝnni dǝ lua tthǝ fitilǝ yang i kalo tasǝu ko ɓua nung lo? Gǝlko i dǝ lo nungdǝu? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Nungkwɔ i pya lǝ pya i ilǝ nung pangbǝi, langkwoi nungkwɔ i khalo i ɓko lo i li nǝkwam. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Nǝ yuukwɔ tthǝ i ɗuogsui lǝbǝi, yang u lǝ!&gt;&gt;<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />&lt;&lt;U gei langkwoi angǝ, Ɓa dǝ kiggǝ ɓǝ tthǝ nungkwɔ ɓalǝ ɓǝ! Nunglǝi kwɔ dǝɓa to kwan lǝ yakun tthǝ kwɔ nungkwɔ Fuh a toɓǝ lǝ kwantthǝ-kwoi i tthǝzii ghaatthǝ. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Yakwɔ nungtthǝ nai i liǝ lo, yakwɔ nung yangǝu naiu kwɔ i akwɔ nailǝ kwɔ i muo nailǝ i lǝi.&gt;&gt;<verse eid="MRK 4:25" /></para>
  <para style="s">Bǝ Liba Lo Nungbyǝa Kwɔ Dǝnna Ghaa Ɓǝ</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Yeso lilotthǝ gei angǝ,&lt;&lt;Bǝ lo yigwoi gi Fuh manungkwɔni. Yiɓǝi akun wurrǝ nungbyǝa zug gulǝ. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Nungvii i dang fuh, u lo nung lo ko u ǝǝ dǝnnu ki, nungbyǝa ɓǝ pi yang ghaa, u ibǝi nungkwɔ to nung ɓǝlǝu. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Pangsua ɓǝ i nkolǝ to nungbyǝa ɓǝ pi ghaa ǝrr si; la nwasiu kko fug, yang lo, langkwoi nǝsua ǝndǝi nungǝu yilou. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Kwɔ nungbyǝa ɓǝ ɗuong, yiɓǝi baipi bǝ kaiu zuam, bakwɔ lona bǝ ɓǝrrǝu tong ɓǝ.&gt;&gt;<verse eid="MRK 4:29" /></para>
  <para style="s">Bǝ Liba Lo Nungbyǝa Musta</para>
  <para style="r">(Matthew 13:31, 32, 34; Luka 13:18, 19)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Langkwoi Yeso ɓib angǝ,&lt;&lt;Ɓi gei angǝ bǝ lo yigwoi Fuh nǝnǝa? &lt;&lt;Bǝ liba anwɔtǝn ɓi nalǝa?&gt;&gt; <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Manungkwɔni.Itha Yiɓǝi akun lǝi nungbyǝa musta, kwɔ nungǝu lǝ nungbyǝa atuab ǝndǝi dang longwam, langkwoi u bie pangsua. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Natthǝ tuab u ghaa u pǝl sua nungbyǝa kwɔ ǝndǝi, Tthǝlak nko gab ghaatthǝ kwɔ i nurug yi wuo wa mai kǝm gitthǝ.&gt;&gt;<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Yeso gei balǝ yayuu tthǝ i bǝ liba, dǝu gei batthǝ ibǝ liba kpaatthǝ manungkwɔni; U geitthǝ kpaatthǝ kwɔ i ɓuan i ibǝi ɓǝ. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Bakwɔ dǝnnu gei tthǝ kwɔ dang bǝ liba. Kwoi nǝ u i ya nanung to gu, yang dǝnnu gei batthǝ ǝndǝi.<verse eid="MRK 4:34" /></para>
  <para style="s">Yeso Dǝilǝ Wa Mung</para>
  <para style="r">(<ref loc="MAT 8:23-27">Matthew 8:23-27</ref>; <ref loc="LUK 8:22-25">Luka 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Viilǝ kwɔ nunglui lǝ, Yeso geilǝ ya nanung to gu angǝ&lt;&lt;Ɓi nyang nwam ɓi tǝ nwangwam akulo.&gt;&gt; <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Nungkwɔ i pa i yitthǝ kon yayuu ɓǝ; ya nanung to gu tǝ dang kwai kwɔ Yeso osi ǝǝtthǝ ɓǝ, langkwoi i pa i ulǝ. I kwai yakun tthǝ bǝilǝ langɓǝ.<verse eid="MRK 4:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 4:37" />Dangtthǝ Waa a nyimmi lub dǝna ɓuob, langkwoi bǝ tǝnglǝ gi kwai ɓǝ dǝna al mung dang kwai lǝ, nungkwɔ mung dǝna tǝbǝ yi kwai ɓǝ. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Yeso tthasua dang kwai lǝ, dǝna lo nunglo lo nung dǝ lo. Ya nanung to ɓǝ ǝrrǝu lǝ gei angǝ,&lt;&lt;Ya nanatthǝnung, a nhǝm lǝu kwɔ dǝɓi tǝbǝ ɓuiu ɓa?&gt;&gt;<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Yeso ǝrr dǝi nǝbo thanyi lo Wa angǝ a bǝ tǝnglǝ mungɓǝ, &lt;&lt;Kǝr! A dǝi!&gt;&gt; Wa ɓǝ ǝrr dǝi. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Yeso gei ya nanung to gu angǝ, &lt;&lt;Ba ɓǝbǝ ɓa survulli? Yirrǝ ɓa yangǝu i bǝ dǝnyittha?&gt;&gt;<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Kwoi tthǝvulli mui ǝrr i baipi bǝ ɓibtha angǝ, &lt;&lt;Ən yikwɔ? I waa ibǝ tǝnglǝ mung ǝndǝi dǝna to nung to i bagu!&gt;&gt;<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">Yeso Ilǝ Wa A Ɓko Tthǝ Yiɓǝi Akun</para>
  <para style="r">(<ref loc="MAT 8:28-34">Matthew 8:28-34</ref>; <ref loc="LUK 8:26-39">Luka 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Yeso i ya nanung to gu nyang tǝ nwangwam nwam Galili, losua Garasinawa. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Kwɔ Yeso pin dang kwai ni, u kǝbtha i yiɓǝi akun kwɔ wa a ɓko tthǝulǝ ɓǝ dǝnnu ǝǝ ɓua juǝn. Yiɓǝi kwɔ waa a ɓko tthǝu. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Yiɓǝi kwɔ dǝna ǝǝ ɓua juǝn. Yuu akun yangǝu kwɔ a ɓuan a tthǝbu ko ǝn i sarka. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Vii ǝndǝi dǝi tthǝb bo i nko, kwoi lona ǝndǝi dǝu ɓǝr sarka ɓǝ dǝu ɓuob bo i ɓui. Yuu akun yangǝu i ttha kwɔ a muu ɓǝ. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Dangfuh i nungvii dǝu thko dang ɓua juǝn i dang ɓǝmtal, dǝnnu tasui lang dǝnnu thang tthǝu i tal lǝ.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Kwɔ u ɓyea Yeso tuutthǝ; nungkwɔ u surr dum tǝu bai nwalongǝu sua dang siu. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />U buogbǝi i yol angǝ, &lt;&lt;Ənɓǝ dǝmma yiɗi i ɓanglǝ? Yeso, Yui Fuh ya wayi! A zuu nung dang ɗuǝn Fuh mangǝ a dǝm zuiu! <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Bakwɔ Yeso geiu angǝ,&lt;&lt;A i tthǝ yiɓǝi kwɔ, mǝ Wa a ɓko!&gt;&gt;<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Nungkwɔ Yeso ɓibbu angǝ,&lt;&lt;Ɗuǝn mǝ ǝn yittǝn?&gt;&gt;</para>
  <para style="p" vid="MRK 5:9">Yiɓǝi ɓǝ gwabnwa angǝ, &lt;&lt;Ɗuǝnǝm ǝn &lt;tuli&gt;-ɓi kpaaɗing!&gt;&gt;<verse eid="MRK 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 5:10" />Langkwoi u ǝǝnwa bǝ yam Yeso bǝ u nanni ɓǝilǝ thǝ.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Kon thag tthǝ dǝna tangnung gɓag tal ɓǝ.<verse eid="MRK 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 5:12" />Nungwkɔ wa ɓko ɓǝ yam Yeso angǝ,&lt;&lt;A tog ɓi tthǝ i thag kwɔ, yang ɓi tǝ tthǝi.&gt;&gt; <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Yeso gwabbǝi tthǝ, nungkwɔ i wa ɓǝ i tǝtthǝ i thag ɓǝ. Kon thag ɓǝ, thǝmsob ɓua kun surdum tǝi al dang nung nwam i ɓui.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Ya gagci thag ɓǝ padum tǝ dang ganglangwoi angǝ a i atuab yayuu dǝrtha dum wua bǝ ɓyea nungkwɔ to nung ɓǝ. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Kwɔ yayuu ɓǝ wuo sua Yeso, wui tǝi yiɓǝi ɓǝ kwɔ wa tthǝu kwɔ ɗuǝnnu ǝn tuli kwɔ, ǝǝ bǝilǝ, u li nung tthǝu dang kiggǝu; vulli ǝrr mui. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Yakwɔ ɓyea nungɓǝ kwɔ geilǝ yayuu tthǝ nungkwɔ to nung tthǝ yuukwɔ i wa a ɓko tthǝu lǝ i ba thag ɓǝ langɓǝ.<verse eid="MRK 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17" />Nungkwɔ Yayuu bǝi ɓǝ gei Yeso angǝ u yittha losua gi.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Kwɔ Yeso dǝna tǝ dang kwai, yuu kwɔ Yeso ilǝ wa tthǝu kwɔ yam Yeso angǝ i pa suatha i ulǝ. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Kwoi Yeso gwabbu tthǝ lǝu, kwoi u geiu angǝ,&lt;&lt;Atǝ gwoi sua yayuu mǝ ta gei nungkwɔ tthǝ Dangbang toa tthǝɓǝ, langkwoi kwɔ u ɓyǝa nungzuii mǝɓa.&gt;&gt; <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Nungkwɔ yiɓǝi ɓǝ patǝ gwoi angǝ a sob, dǝna gei nungkwɔ tthǝ Yeso toutthǝ ɓǝ. Yayuu kwɔ bǝilǝ kwɔ loi fǝm tthǝ nungkwɔ u gei ɓǝ.<verse eid="MRK 5:20" /></para>
  <para style="s">Yui Yayirus A Yisi I Yisi Kwɔ Kǝnnatthǝ Nunglitthǝ Gi Yeso Ɓǝ</para>
  <para style="r">(<ref loc="MAT 9:18-26">Matthew 9:18-26</ref>; <ref loc="LUK 8:40-56">Luka 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Kwɔ Yeso langkwoi nyang tǝ gwam nwam akulo dang kwai, kon yayuu gǝmtha tthangǝu nwa nwam lǝ. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Yang yikku dang kǝm kǝbtha ya Yahudawa ɗuǝnnu ǝn Yayirus, wuo, suko bǝilǝ. Kwɔ u ɓyea Yeso, u bai nwalongǝu tthasiu.<verse eid="MRK 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 5:23" />U yam Yeso dang wa kun,&lt;&lt;Munthang ayisim dǝna ɓui. Dǝm yam a wɔ wa kǝn natthǝu yangbǝ u tǝi tthǝla i nwongǝi.&gt;&gt; <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />Nungkwɔ Yeso pa i ulǝ. Kon yayuu muo suo dǝna togtha sukolǝ. <verse eid="MRK 5:24" /><verse number="25" style="v" sid="MRK 5:25" />Yisi akun bǝilǝ kwɔ zii dǝna al tthǝu ttha sob iu rab,<verse eid="MRK 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 5:26" />Yisi ɓǝ to zui naya dǝ yǝng kpaatthǝ u thǝb nungkurɓǝ kwɔ nko ɓǝ ǝndǝi, kaso u tǝi tthǝla yangkwoi nungzii ɓǝ na lilo. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Kwɔ u lǝba Yeso, u wuo tthasuo dang konlǝ wuu kǝnnatthǝ nunglitthǝ gu, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />u nhǝm dang wko angǝ, &lt;&lt;Nǝ mǝn kǝnnatthǝ nunglitthǝ gi Yeso ɓuo, yang mǝntǝi tthǝla.&gt;&gt;<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />Dangtthǝ Yisi ɓǝ kǝnnatthǝ nunglitthǝ gi Yeso nwa zii ɓǝ dǝi lona lǝ kullo; u lǝ dang tthǝu lǝ u tǝi tthǝla u i dang zuii guǝn.<verse eid="MRK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30" />Dangtthǝ Yeso ibǝi ttha i tthǝu yang. Yeso mǝrrǝm tthǝu dang kon yayuu ɓib angǝ,&lt;&lt; Ən yittǝn kǝnnatthǝ nunglitthǝm?&gt;&gt;<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Ya nanung to gu gei angǝ, &lt;&lt;A ɓyea kon yayuu kwɔ dǝna gǝmtha tthangmǝ; &lt;&lt;langkwoi dǝma ɓib mangǝ, &lt;&lt;Yi kǝnna tthǝma?&gt;&gt;<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Kwoi Yeso dǝinwa bǝ ɓyea ganglang yayuu yangbǝ u ɓyea yuukwɔ kǝnnatthǝu ɓǝ.<verse eid="MRK 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 5:33" />Yang yisi ɓǝkwɔ, wuo dang vulli ibǝi nungkwɔ to nung tthǝu ɓǝ, wuo wuu bai nwalongǝu tthasiu, thǝu dǝna survulli, u geiu ba a langǝ itthǝ lo nungkwɔ tǝiu ɓǝ, <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Yeso geiu angǝ,&lt;&lt;Yuim ayisi, ba a langǝ i mǝ da tthǝlaa. A tǝ dang tthǝla langkwoi a i dang zuii mǝng.&gt;&gt;<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Lona kwɔ Yeso dǝna gei bakwɔ, ya dang woi Yayirus a kun wuo, yikku kǝm kǝbtha ya Yahudawa gei angǝ.&lt;&lt;Munthang a yisi mǝ ɓuing. Ba gibnung Ya nanatthǝnung kwɔ akun thǝ?&gt;&gt;<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Yeso dǝ kiggǝu tthǝi tthǝnungkwɔ dǝi gei ɓǝ lǝu, Yeso gei yikku kǝm kǝbtha ya Yahudawa ɓǝ angǝ,&lt;&lt;Bǝ a survulli thǝ; a dǝ ba a langǝ i tthǝ ɓuo.&gt;&gt;<verse eid="MRK 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37" />Yeso gwab yuu akun muo suo lǝu Bitrus ɓuo, Yakubu i Yohanna young Yakubu. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Kwɔ i wuo gwoi Yayirus yikku ya kǝm kǝbtha ya Yahudawa ɓǝ, Yeso lǝ yayuu dǝna tasui langkwoi dǝna buogbǝi tǝyi tthǝ. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Yeso tǝ dang gwoi ɓǝ tǝu gei angǝ,&lt;&lt;Ba ɓǝ dǝɓa buogbǝi langkwoi dǝɓa tasui? Yui ɓǝ ɓuilǝu, dǝnnu lo nung lo!&gt;&gt;<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />Kwoi dǝnni mammu. Tthasua kwɔ u iǝlǝ ǝndǝi dang gwoilǝ, u lubǝ Daa yui ɓǝ i Naa gu i ya nanung to gu kwɔ i ulǝ ɓǝ, itǝ bǝikwɔ yui ɓǝ tthǝɓǝ. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Yeso lǝi yui ɓǝ inko geiu angǝ,&lt;&lt;Talita, koum!&gt;&gt; (Nungɓǝ lǝ, Munthang ayisi, ǝn geitthǝ, a ǝrr!&gt;&gt;).<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />Dangtthǝ munthang a yisi ɓǝ ǝrr dǝna thko (thaa yuiɓǝ sob iu rab). Lona kwɔ nikwɔ i ǝndǝi loi fǝm. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Yeso gei angǝ bǝ i gei nungkwɔlǝ yuu akun tthǝthǝ, langkwoi u gei angǝ, &lt;&lt;I duu nungtang u tang.&gt;&gt;<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">I La Yeso Nazarat</para>
  <para style="r">(<ref loc="MAT 13:53-58">Matthew 13:53-58</ref>; <ref loc="LUK 4:16-30">Luka 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Yeso yitthǝ bǝiɓǝ kullo i ya nanung to gu tǝ losua kwɔ i siu tthǝɓǝ. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Vii nwongǝi, Yeso baipi bǝ nanatthǝnung dang kǝm kǝbtha gi, dǝi i lǝu loi fǝm. I ɓib tha angǝ,&lt;&lt;Kǝk Yiɓǝi kwɔ tǝi nungkwɔ ɓǝla?, U tǝi bǝ ibǝ nungkwɔ i tthǝnyimmi bǝ to nungfǝm lo kwɔ ɓǝla? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Gǝllko u ǝn ya pinung,? U ǝn yui Maryamu young Yakubu, Yusufu, Yahuda i Saminu wai? Gǝllko ya youngǝu yasi bǝikwɔ i ɓi wai?&gt;&gt;Langkwoi nungkwɔ i lko.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />Yeso gei angǝ, &lt;&lt;Ya gei ba a tthasi yangǝu i ghaali gwoi gu, ǝnya gwoi sigu ɓuo i ya dang tthǝu i ya bǝpi gu ɓuo du ghalliu.&gt;&gt;<verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />Yeso ɓuan to nung fǝmlo bǝilǝ lǝu, u dǝna lo yayuu tuab ɓuo kwɔ tthǝi lko ɓǝ u ji tthǝla. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Lo Yeso fǝm ghaaɗing bakwɔ i yangǝu i bǝ dǝnyitthǝu ɓǝ.<verse eid="MRK 6:6" /></para>
  <para style="s">Yeso Tum Ya Nanung To Gu Sob Iu Rab</para>
  <para style="r">(<ref loc="MAT 10:5-15">Matthew 10:5-15</ref>; <ref loc="LUK 9:1-6">Luka 9:1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />Yeso lubǝ ya nanung to gu sob iu rab u tummi rabrab. U ji ttha lo ɓyang a ɓko <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />Nungkwɔ u geitthǝ kwɔ angǝ, &lt;&lt;Bǝɓa lǝi nung a kun ba thko ɓǝthǝ kab ɓuo ɓa lǝi bǝ ɓa lǝi nungtang na thǝ, bǝ ɓa lǝi tthko yamnung thǝ, ko nungkurɓǝ dang jibǝ ɓǝ. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Ɓa bai ǝko, bǝ ɓa lǝi nunglitthǝ a kun nathǝ.&gt;&gt; <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Yeso gei langkwoi angǝ, konǝ ɓǝla ɓatǝ dang woi, nǝ gwoi ɓǝ kǝb loɓǝ ɓa ee bǝilǝ tǝlǝ vii kwɔ ɓa yitthǝ bǝiɓǝ ɓǝ. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Langkwoi bǝi akwɔ nǝ i gwab ɓǝlǝu, langkwoi lǝɓǝ lǝu, ɓa fa kunɗur boɓǝ nǝ dǝɓa paɓǝ, lǝ bǝ gub ɗuogsui tthǝilǝ.&gt;&gt; <verse eid="MRK 6:11" /><verse number="12" style="v" sid="MRK 6:12" />Nungkwɔ i idǝi gei ba Fuh lǝ yayuu tthǝ angǝ i yitthǝ bǝ to nung a ɓko. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />I nan i wa a ɓko, langkwoi i al nui zeitun lo ya nungzii i ji tthǝla.<verse eid="MRK 6:13" /></para>
  <para style="s">Bǝ Ɓuiɓua Gi Yohanna Ya Wollmung</para>
  <para style="r">(<ref loc="MAT 14:1-12">Matthew 14:1-12</ref>; <ref loc="LUK 9:7-9">Luka 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Yigwoi Hiridus lǝba lo nungkwɔ ǝndǝi, bakwɔ nwaba lo Yeso lǝi bǝikwɔ ǝndei, yakun dǝna gei angǝ&lt;&lt;Ən Yohanna ya wollmung kwoi wuo longwam i nwongǝi! Nungkwɔ to utthǝ i ttha bǝ to i nung fǝmlo kwɔ.&gt;&gt;<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Yakun dǝna gei angǝ, &lt;&lt;U ǝn Iliya.&gt;&gt;</para>
  <para style="p" vid="MRK 6:15">Langkwoi yakun dǝna lǝi angǝ, &lt;&lt;U ǝn ya gei ba a tthasi, mangǝn yuu akun dang ya gei ba a tthasi a viivrǝ.&gt;&gt;<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />Kwɔ Hiridus lǝ nungkwɔ ni, u gei angǝ, &lt;&lt;Yohanna, yiɓǝi kwɔ ǝn ɓǝrlo kwɔ, uɓǝ i ǝrrǝu lǝ dang bǝ ɓuiɓua!&gt;&gt; <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />Hiridus gei angǝ i muo Yohanna, langkwoi u gei angǝ i tthǝbbu langkwoi i liu pursǝna. Hiridus to nungkwɔ lǝba Herodiya, kwɔ u dǝb ɓǝ, u ǝn si youngǝu Filibus. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Bakwɔ Yohanna ǝǝnwa bǝ gei lǝ Hiridus tthǝ angǝ, &lt;&lt;Mko kwɔ ma dǝb si youngmǝ ɓǝ!&gt;&gt; <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />Nungkwɔ Herodiya mua Yohanna ya wollmung li dang wa dǝna yiɗi bǝ thǝb Yohanna, kwoi u ɓuan lǝu lǝba Hiridus. <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />Hiridus dǝna sur Yohanna ǝn sur bakwɔ u ibǝing u ǝn ya langǝ i ɓǝ, langkwoi nungkwɔ dǝu kangǝu matthǝ. Dǝu yiɗi bǝ lǝu vii ǝndǝi, kiggǝu dǝna ǝrr ghaatthǝ lona kwɔ ǝndǝi nǝ u lǝ Yohanna dǝna gei baɓǝ.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Nǝsua ǝndǝi lona wɔ lǝ Herodiya tthǝ. Lona bǝ si gi Hiridus, U to ɓang ba ya thǝl bo, i yakku ya taɓui, i yakku ya Galili. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Kwɔ yui Herodiya yisi wuo wu nab dang , u dǝ tthela lǝ Hiridus i yayol gu. Nungkwɔ Yigwoi gei yui ɓǝ angǝ, &lt;&lt;Ənɓǝ dǝmma yiɗi nam lǝ? Mǝn da nungkwɔ ǝndǝi dǝmma yiɗi ɓǝ.&gt;&gt; <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Hiridus gwabnwa lǝ yui ɓǝtthǝ i bǝ zuu nung angǝ, &lt;&lt;nungkwɔ ǝndǝi a yiɗi mǝn da ǝndǝ, ko mǝn gab losuam rab!&gt;&gt;<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />Yui ɓǝ igwam tǝtǝi naa gu, &lt;&lt;Ən ɓǝttǝn mǝn ɗyǝaba?&gt;&gt; Herodiya geiu angǝ,</para>
  <para style="p" vid="MRK 6:24">&lt;&lt;Lo Yohanna ya wollmung!&gt;&gt;<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Munthang a yisi ɓǝ kwoi suo thǝmtthǝ tǝ gei yigwoi Hiridus angǝ, &lt;&lt;A dǝm lo Yohanna ya wollmung bǝikwɔ lakwɔ nikwɔ dang kong kyang!&gt;&gt;<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />Nungɓǝ ǝrr lǝ kiggǝ Yigwoi ghaatthǝ ba bǝ gwab nwa gu. Kwoi u yiɗi bǝ pǝrǝm nwa lo nungkwɔ u gwab la nungsi nung yayol gu ɓǝlǝu. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Dangtthǝ yigwoi tum ya ɓǝrlo i ba tǝu wullǝ lo Yohanna. Yiɓǝi ɓǝ patǝ, tǝ ɓǝrlo Yohanna pursǝna wɔ lǝ, <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />u wullǝ lo dang kong kyang. U dǝlǝ munthang a yisi ɓǝ, u kwoilǝ u dǝlǝ naa gu.<verse eid="MRK 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 6:29" />Kwɔ ya muo sua Yohanna lǝ nungkwɔ, i wuo wui lǝi kwamɓuiu tǝi suu ɓua juǝn lǝ.<verse eid="MRK 6:29" /></para>
  <para style="s">Yeso Tanglǝ Yayuu Themsob Ɓua Thǝmkun Iu Nu</para>
  <para style="r">(<ref loc="MAT 14:13-21">Matthew 14:13-21</ref>; <ref loc="LUK 9:10-17">Luka 9:10-17</ref>; <ref loc="JHN 6:1-14">Yohanna 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Ya muo sua Yeso kwoi wuo suo, i geiu nungkwɔ i toɓǝ ǝndei i nungkwɔ i nanatthǝ ɓǝ. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Bakwɔ Yayuu kpaatthǝ dǝna wɔ sua Yeso dǝna kwoi u tǝi na kwɔ tanglǝ nung ɓǝlǝu, nungkwɔ u geitthǝ angǝ, &lt;&lt;Ɓa wɔ wuɓi ɗuu bǝikwɔ yangǝu tthǝɓǝ yangbǝ ɓi nwong.&gt;&gt;<verse eid="MRK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 6:32" />Nungkwɔ itǝ dang kwai i ulǝ i tǝ bǝikwɔ yayuu yangǝu tthǝɓǝ.<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />Yayuu kpaatthǝ gwoi angǝ a kwɔ ɓyǝai kwɔ surdum i bo osi tǝbǝi ɓǝ nwuni bǝ Yeso i ya nanung to gu kǝn bǝiɓǝ. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Kwɔ Yeso pin dang kwailǝ, u ɓyea gong kon yayuu kwɔ, u ɓyǝa nung zuii gi, bakwɔ i natha i ɓangam kwɔ ya gagciǝ yangǝu ɓǝ. Ərr u baipi bǝ nai natthǝnung kpaatthǝ.<verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />Nungluii lǝ ya nanung to gu wuo sua Yeso gei angǝ, &lt;&lt;Bǝikwɔ mǝngǝn dang gug, fuh bailo ɓuang. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />A gei Kon yayuu ɓǝ i tǝ tǝi ɗu nungtang, gwoi a tuab kwɔ gɓag bǝikwɔ yangbǝ tǝi ɗyǝab nungkwɔ i tangɓǝ.&gt;&gt;<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Yeso gei angǝ, &lt;&lt;Ɓa ji nungkwɔ i tang ɓǝ.&gt;&gt;</para>
  <para style="p" vid="MRK 6:37">I geiu angǝ, &lt;&lt;Dǝmma yiɗi tǝɓi thǝb nungkurɓǝ kwɔ i mab i ɓui thǝmrab lo nungtang yangbǝ ɓi tangǝ i la?&gt;&gt;<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />&lt;&lt;Ərr Yeso ɓibǝi angǝ burodi nǝnǝ naɓǝ? &lt;&lt;Tǝ ɓa ɓyea.&gt;&gt;</para>
  <para style="p" vid="MRK 6:38">Kwɔ tǝi ɓyea, i gei angǝ, &lt;&lt;Burodi nu- i tthǝng rab.&gt;&gt;<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />Yeso gei ya nanung to gu angǝ i gei yayuu ǝsua lo gug kabu lǝ kabu. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Nungkwɔ yayuu ǝsua nungtha kabu lǝ kabu. Ya kun thǝm nu langkwoi yakun thǝm rab pǝmna sob. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Yeso lǝi burodi ni nu kwɔ i tthǝng kwɔ ni rab kwɔ u lǝi lo yi, u dǝ angǝ a lǝ Fuh. U kwǝy burodi ɓǝ langkwoi u dǝlǝ ya nanung to gu yangbǝ i dǝlǝ yayuu. Yeso gabǝi ttheng ɓǝtthǝ kwɔ rab kwɔ i ǝndǝi.<verse eid="MRK 6:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 6:42" />I ǝndǝi i tang i fǝr, <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />ya nanung to gu kǝm sua burodi i tthǝng sua nungkwɔ i kwɔ kaɗuog sob iu rab. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Lo yayuu thǝm sob ɓua thǝmkun iu nu kwɔ i tangǝ i lǝ ɓǝ.<verse eid="MRK 6:44" /></para>
  <para style="s">Yeso Thko Lo Mung</para>
  <para style="r">(<ref loc="MAT 14:22-33">Matthew 14:22-33</ref>; <ref loc="JHN 6:15-21">Yohanna 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Dangtthǝ Yeso gei ya nanung to gu tǝ dang kwai angǝ i osi i tǝ Betsaida, u kisua u yǝrnwa lǝ yayuu. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Kwɔ u yerri nwa, u tǝ lotal bǝ pinwa.<verse eid="MRK 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47" />Kwɔ fuh o u bǝilǝ, kwai ɓǝ lo mung, u i nungttheu nwangwam a kullo. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Yeso ɓyǝa ya nanungto gu dǝna to zuii i waa, bakwɔ waa ɓǝ dǝna gibnungǝi; nǝ sibǝi lona tai i nanakun a nungwoi, dǝu tǝ suai, dǝu thko lo mung. Yeso dǝna yiɗi bǝ pa tthǝi lǝ, <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />kwoi kwɔ i ɓiu dǝnnu thko lo mung. Dǝnni ɓyǝa angǝ&lt;&lt;Ən ɓyang a ɓko!&gt;&gt; I buogbǝi. <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />I ǝndǝi lǝtthǝ vulli ghaatthǝ kwɔ i ɓiu ɓǝ.</para>
  <para style="p" vid="MRK 6:50">Dangtthǝ Yeso gei ba angǝ, &lt;&lt;Ɓa nyimnyi! Ən ɓang. Bǝ ɓa sur vulli thǝ!&gt;&gt; <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Yang u tǝ dang kwai ɓǝ i ilǝ, langkwoi wa ɓǝ tǝm. Lo ya nanung to ɓǝ fǝm ghaatthǝ, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />Bakwɔ i ibǝi babǝ tang lǝ yayuu i burodi kwɔ lǝu; lo nyi ɗarɗing.<verse eid="MRK 6:52" /></para>
  <para style="s">Yeso Dǝ Tthǝla Lǝya Nungzi Janisarata</para>
  <para style="r">(<ref loc="MRK 14:34-36">14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Kwɔ i nyang gwam mung a kullo, i pin Janisarata, i tthǝb kwai gi bǝilǝ. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Kwɔ i pin dang kwai lǝ, yayuu ɓyǝa Yeso i. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Nungkwɔ yayuu thǝmlǝ losua ɓǝ ǝndǝi i ya nungzii dǝna ɗubǝiu bǝi kwɔ nǝ i lǝ angǝ utthǝ, dǝi wullǝ ya nungzii gilǝ suo lǝ lo gei. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Bǝikwɔ Yeso tǝtthǝ ǝndei, gwoi a tuab, gwoi angǝ a ko zug, yayuu dǝna tǝlǝ ya nungzii gi lǝ nwa lomu yang i ɗyǝab bu u gwablǝ ya nungzii tthǝ kǝnnatthǝ nwa nunglitthǝ gu. Langkwoi yakwɔ kǝnnatthǝ ǝndǝi tǝi tthǝla.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Yeso Ghai Nungkwɔ Tthǝ A Ɓanglǝ Yuu Ɓǝ.</para>
  <para style="r">(<ref loc="MAT 15:1-9">Matthew 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Ya Farisiyawa i yakun dang ya nanatthǝnung zuu gi Musa kpaatthǝ kwɔ ǝrr Urshalima gǝmtha tthang Yeso. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />I ɓyǝa ya nanung to gu dǝna tang nungtang i na ɓillǝng nungɓǝlǝ nakwɔ i ɗiggǝ lǝu ɓǝ manungkwɔ ya Farisiyawa dǝna yiɗi angǝ yayuu to ɓǝ.<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />Bakwɔ ya Farisiyawa, langɓǝ i sua ya Yahudawa, dǝna muo natthǝ bǝ nanatthǝnung kwɔ i muo na ya bǝba gi ɓǝ: i tangnungǝu nǝ i ɗiggǝ nai matthǝ ɗǝ; <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Nǝ i kwoi lomu i tang nungǝu nǝ i ɗiggǝ nai ɗǝ. Langkwoi dǝnni to nung kpaatthǝ kwɔ ya bǝba toɓǝ, manung a bǝ ɗiggǝ ɗǝi nwamung, kyang i daro.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Nungkwɔ ya Farisiyawa i ya nanatthǝnung zuu gi Musa, ǝrr ɓib Yeso angǝ, &lt;&lt;Ba ɓǝ bǝ yananung to mǝ to nung to i nungkwɔ ya bǝba ɓi naɓi natthǝ ɓǝllǝu? Ba ɓǝ bǝ dǝnni tang nung i na ɓillǝngha?&gt;&gt;<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Yeso gwabǝi nwa angǝ, &lt;&lt;Ishaya gei ǝn ba a langǝ i kwɔ u gei angǝ ɓǝya nung a ɓko; manung a kwɔ i vullǝ dang nung vullǝ:</para>
  <para style="q1" vid="MRK 7:6">&lt; Yayuu kwɔ, Fuh gei, dǝna dǝm angǝ a i sualnwa,</para>
  <para style="q2" vid="MRK 7:6">kwoi lo nyiǝ tuutha i ɓang ɗing.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Dǝnni wabǝm nǝkwam;</para>
  <para style="q2" vid="MRK 7:7">bakwɔ dǝnni nanatthǝ nungzuu yayuu</para>
  <para style="q2" vid="MRK 7:7">mangǝttǝn ǝn zuum!&gt;<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />&lt;&lt;Ɓa yitthǝ nung lǝi gi Fuh gwu kun langkwoi dǝɓa to nung to i bǝ nanatthǝnung thayuu.&gt;&gt;<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Langkwoi Yeso lilotthǝ gei angǝ, &lt;&lt;Ɓǝtthǝ i yiggǝi bǝ la zuu gi Fuh yangbǝ ɓa to nung to i zuu ɓǝ! <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Musa gei angǝ, &lt;A dǝ angǝ a lǝ daa mǝ i naa mǝ,&gt; langkwoi, &lt;Yuu akwɔ nǝ dal daa gu i naa gu i theu.&gt; <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Kwoi dǝɓa nanatthǝ ɓangǝ nǝ yayuu tthǝ i nungkwɔ i ɓuan i tolǝ nungkwɔ i nwonglǝ daa gi i naa gi, kwoi gei angǝ,&lt;Nungkwɔ ǝn Koban&gt; (nungɓǝ lǝ, ǝn a bǝ Fuh), <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />yang ɓa yiǝ i to nung a kun lǝ daa gi tthǝ i naa giu. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Manungkwɔ ni bǝ nanatthǝ nungkwɔ dǝɓa nanatthǝ lǝ yakun kwɔ dǝna ɓanglǝ ba gi Fuh. Langkwoi dǝ ɓa to i nung akun tthǝ kpaatthǝ manung ɓǝ ni.&gt;&gt;<verse eid="MRK 7:13" /></para>
  <para style="s">I Nungkwɔ Dǝnna Ɓanglǝ Yuu Ɓǝ</para>
  <para style="r">(<ref loc="MAT 15:10-20">Matthew 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Langkwoi Yeso lubǝ kon ɓǝ u gei angǝ, &lt;&lt;Ɓǝ ǝndei ɓa lǝm, langkwoi ɓa ibǝi nungkwɔ. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Nungkwɔ tǝtthǝ yuu ttha nwuo nungkwɔ a ɓangǝu lǝ lǝu. <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />Ən nungkwɔ i dang nwuo nungkwɔ a ɓangǝulǝ.&gt;&gt;<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Tthasua kwɔ u pa u yiǝ kon ɓǝ u tǝ dang woi, ya nanung to gu ɓibbu ba lobǝ liba kwɔ. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Yeso gei angǝ loɓǝ lam ɗinghaa? &lt;&lt;Ɓa ibǝi kwɔ nung yangǝu tǝtthǝ yuu gwam lǝ kwɔ a &lt;ɓangǝu lǝ ɓǝlǝu, <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Ba kwɔ tǝ dang nyiu lǝu kwoi ǝn dang wko, langkwoi yang i tthǝu.&gt;&gt; (I bǝ gei nungkwɔ Yeso gei angǝ nungtang ǝndei &lt;&lt;maɗing.&gt;&gt;)<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Yeso lilotthǝ gei angǝ: &lt;&lt;Nungkwɔ dǝna i nwa yuu nungɓǝ dǝna &lt;ɓangǝu lǝ.&gt; <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Bakwɔ tthǝn dang wa, dang nyi yayuu, bǝ nhǝm ba a ɓko, bǝ lo i si yuu, nung i, thǝbǝi, bǝ lo i si yuu ko bǝ ɓatha i ɓǝi yuu, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />ɗǝllak, i dang wa a ɓko, bǝ ɗambǝi, nung a ɓko, bǝ lǝi yuu lo wa, ɗyǝam, lo angǝ a, langkwoi i sullǝ. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />I nung a ɓko kwɔ ǝndei dǝna i tthǝn dang nyi langkwoi nungɓǝ dǝna ɓanglǝ yuu.&gt;&gt;<verse eid="MRK 7:23" /></para>
  <para style="s">Bǝ Dǝnyitthǝ A Langǝ i Gi Yisi</para>
  <para style="r">(<ref loc="MAT 15:21-28">Matthew 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Yeso yitthǝ bǝi ɓǝ kullo tǝ losua Taya. U tǝ dang gwoi a kuntthǝ u yiɗi kwɔ yuu akun a ibǝi ɓǝlǝu; u ɓuan u pyǝa lolǝu. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Dangtthǝ yisi kwɔ wa a ɓko tthǝ yuiu kwɔ, lǝ bǝikwɔ Yeso tthǝ ɓǝ ni, wuu bai nwa loŋǝu tthasiu. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Yisi ɓǝ ǝn yayol dang ya Yahudawa, i siu Suriya Basurofinika. U yam Yeso angǝ ilǝ wa tthǝ munthang a yisim lǝ.<verse eid="MRK 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27" />Yeso geiu angǝ, &lt;&lt;Mko kwɔ i lǝi nuntang yathang i al lǝ ɗua tthǝ nǝ i fǝr ɗǝ bǝ i al suo lǝ ɗua tthǝ.&gt;&gt;<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />&lt;&lt;Yikku,&gt;&gt; yisi ɓǝ gei angǝ ǝn ba a langǝ i, &lt;&lt;kwoi ko ǝn ɗua dǝna tang sua kongkwi kwɔ dǝna al na yathang lǝɓǝ.&gt;&gt;<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Yeso geiu angǝ, &lt;&lt;Ba bǝ gwabnwa mǝkwɔ, a kwoi atǝ gwoi, tǝma tǝi wa ɓǝ yina lǝ yuimǝng!&gt;&gt; <verse eid="MRK 7:29" /><verse number="30" style="v" sid="MRK 7:30" />Yisi ɓǝtǝ gwoi tǝtǝi yuiu lolo dko, langkwoi wa ɓǝ ing tthǝu lǝ.<verse eid="MRK 7:30" /></para>
  <para style="s">Yeso Dǝ Tthǝlla Lǝ Yuu Akwɔ lǝbǝiu langkwoi gei Bko Ɓǝ</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Yang Yeso yitthǝ losua Taya langkwoi wuu pa dang Sidon wu tǝlǝ nwa mung Galili langkwoi dang losua ni sob.<verse eid="MRK 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 7:32" />Ərr yakun wuo lǝ yiɓǝi akun tthǝ kwɔ ɓuasuiu lǝbǝiu lankwoi u ɓuan u gei bko ɓǝ, langkwoi i yam Yeso angǝ u kǝn natthǝu ɓuo.<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />Yeso ilǝ yiɓǝi ɓǝ, dang yayuu tǝlǝ gwu kun, u bai nwanzǝnko ɓuasui yiɓǝi lǝ. Ərr u chui chuichui nwazǝnko u kǝnnlǝ natthǝ lyǝn yiɓǝi ɓǝ. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Yeso lǝilo ɓilǝ wayi, u linyi u gei angǝ, &lt;&lt;Iffata!&gt;&gt; (Nungɓǝ lǝ, Ɓko!&gt;&gt;). <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />Ba a nwaɓi kwɔ yiɓǝi ɓǝ dang tthǝ dǝna lǝ bǝi, langkwoi dǝnnu gei ba matthǝ.<verse eid="MRK 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36" />Yeso gei angǝ bǝ i geilǝ yuu akun tthǝthǝ. Kwoi kwɔ nǝ u to manungkwɔ ni, yang i ǝǝ nwa bǝ geilǝ yayuu tthǝ. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Langkwoi yakwɔ ǝndǝi lǝ nungkwɔ loi fǝm dǝnni gei angǝ, &lt;&lt;U to nung ǝndǝi maɗing!&gt;&gt; Dǝnni manni. &lt;&lt; U dǝbǝ lǝbǝi lǝ ya ɓuomsui bǝ gei ba lǝ yakwɔ gei bko kwɔ gei ba!&gt;&gt;<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Yeso Tanglǝ Yayuu Thǝmsob Ɓua Thǝmkun</para>
  <para style="r">(<ref loc="MAT 15:32-39">Matthew 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Sua tulǝu kon yayuu akun gǝmtha tthang Yeso. Nungtang kwɔ i tangkwɔ yangǝu. Yeso lubǝ ya nanung to gu gei angǝ, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />&lt;&lt;Dǝm ɓyǝa nung zuii yayuu kwɔ, i suatha i ɓang bo tai lakwɔ i yangǝu i nungkwɔ i tangɓǝu. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Nǝ ǝn yǝrri nwa geigǝ i tǝ gwoi i gwom lǝ wai nǝ i tangnung lǝu, Yakun a ongkwoi nung lǝi, bakwɔ yakun ǝrr tuu ɗing.&gt;&gt;<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Ya nanung to gu ɓibbu angǝ, &lt;&lt;Bǝikwɔ ǝn dang kah ǝn pǝttǝn yuu a ɓuan a tǝi nungkwɔ a tangǝ i yayuu kwɔ ɓa?&gt;&gt;<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Yeso ɓibbǝi angǝ&lt;&lt;Burodi nǝnǝ naɓǝ?&gt;&gt; I gei angǝ&lt;nanaira,&gt;<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Yeso gei kon yayuu ɓǝ angǝ i ǝǝ sua pangsua. Yang u lǝi burodi ɓǝkwɔ nanaira kwɔ u dǝ angǝ a lǝ Fuh, u kwɔ dang ǝu, langkwoi u dǝlǝ ya nanung to gu angǝ i dǝlǝ kon yayuu ɓǝ; Lankwoi ya nanung to ɓǝ to manungɓǝ. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Langkwoi tthǝng tthǝ tuab nai lǝ langɓǝ. Yeso dǝ angǝ a lo tthǝng lǝ langɓǝ u gei ya nanung to gu gabǝitthǝ. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Yayuu ɓǝ ǝndǝi tang fǝr. Tthasuko lǝ ya nanung to gu kǝm sua finnǝu kaɗuog nanaira. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Yayuu thǝm sob ɓua thǝmkun bǝilǝ kwɔ tang nungtangɓǝ ɓǝ. Yang ya nanung to ee sua kaɗuog nanaira kwɔ i ɓǝ. Yeso yǝrinwa <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />dang tthǝ kwɔ Yeso alo ni u tǝ dang kwai i ya nanung to gu i tǝ losua Dalmanuta.<verse eid="MRK 8:10" /></para>
  <para style="s">Ya Farisiyawa Ɗyǝab Yeso Angǝ U To Nungfǝmlo</para>
  <para style="r">(<ref loc="MAT 16:1-4">Matthew 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Yakun dang Ya Farisiyawa wɔ sua Yeso dǝna nyimthanwa i ulǝ. Dǝnni yiɗi bǝ muu i ba, dǝnni yiɗi angǝ nung fǝmlo yangbǝ i ibǝi angǝ Fuh gwabtha i ung. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Kwoi Yeso li nyi ghaatthǝ ǝrr gei angǝ, &lt;&lt;Ba ɓǝ bǝ yayuu dang wam kwɔ dǝna yiɗi nung fǝmlo? Nilǝu, ǝn gei ɓǝ ba a langǝ i tthǝ! Nung fǝmlo akun yangǝu i tainatthǝu!&gt;&gt; <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />Yeso ǝrr pa yiǝ, tǝ dang kwai, nyang u tǝ gwam mung a kulo.<verse eid="MRK 8:13" /></para>
  <para style="s">Yisti Ya Farisiyawa i A Bǝ Hiridus</para>
  <para style="r">(<ref loc="MAT 16:5-12">Matthew 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Ya nanung to gu danyitthǝ bǝ wulǝ burodi kpaatthǝ langkwoi burodi ni kun ɓuo dang kwai lǝ. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />&lt;&lt;Ɓa dǝ kiggǝ ɓǝ,&gt;&gt; Yeso gub ɗuogsui ya nanung to gu. &lt;&lt;Langkwoi ɓa dǝ kiggǝ ɓǝ tthǝ bǝ lǝilo ya Farisiyawa i a bǝ Hiridus.&gt;&gt; <verse eid="MRK 8:15" /><verse number="16" style="v" sid="MRK 8:16" />Ya nanung to gu ǝǝnwa bǝ nyim nwatha ɓuailǝ i gei angǝ: &lt;&lt;Dǝu gei nungkwɔ bakwɔ ɓi lǝi nungtang nalǝu ɓǝ.&gt;&gt;<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />Yeso ibǝ nungkwɔ dǝnni gei kwɔ, nungkwɔ u ɓibǝi angǝ: &lt;&lt;Ba ɓǝ bǝ dǝɓa gei ba ɓangǝ burodi yangǝu? Yirrǝ ɓa ɓyǝa lǝu ko ɓa ibǝi lǝu? Lo nyi ɓǝ ɗǝnɗarra? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Ɓǝtthǝ i nung- yang ɓibǝi wa? Ɓǝtthǝ i ɗuogsui yang lǝ bǝiwa? Ɓa nhǝm ba wa <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Kwɔ ǝn kwǝ burodi nu lǝ ba yayuu tthǝm sob ɓua thǝm rab, sua kaɗuog nǝnǝ kwɔ ɓa kǝm ɓa?&gt;&gt;</para>
  <para style="p" vid="MRK 8:19">I gwab nwa angǝ&lt;&lt;Sob iu rab.&gt;&gt;<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />&lt;&lt;Langkwoi kwɔ ǝn kwǝ burodi nanaira ba yayuu thǝm sob ɓua thǝmkun, suko kaɗuog nǝnǝ ɓa ee?&gt;&gt;</para>
  <para style="p" vid="MRK 8:20">I gwap nwa angǝ, &lt;&lt;Nanaira.&gt;&gt;<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Yeso ɓibbǝi angǝ,&lt;&lt;Langkwoi yirra ɓa ibǝi lǝu?&gt;&gt;<verse eid="MRK 8:21" /></para>
  <para style="s">Yeso Dǝ Tthǝla Lǝ Ya Nungɓuomi Betsaida Lǝ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Yeso i ya nanung to gu wuo Betsaida, bǝilǝ kullo yakuntthǝ wulǝ ya nungɓuomi a kuntthǝ wui yam Yeso angǝ u kǝn natthǝu u du tthǝlla. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Yeso muna lǝ ya nungɓuomi ɓǝ iulǝ gwam dang ganglang gwoi ɓǝ. Kwɔ u chui chuichui nung yiɓǝi lǝ langkwoi u dǝ nko lo yiɓǝi lǝ, Yeso ɓibbu angǝ,&lt;&lt;Dǝma ɓyǝa bǝia?&gt;&gt;<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />Yiɓǝi ɓǝ ɓyǝa wayi gei angǝ, &lt;&lt;Dǝm ɓyǝa yayuu; dǝnni thko mangǝn kab.&gt;&gt;<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Yeso dǝ nko nung yiɓǝi lǝ langkwoi. Lona akwɔ nikwɔ dǝu ɓyǝa bǝi kaitthǝ, bǝ ɓyǝabǝi gu kwoi wuo, langkwoi u ɓyǝa nung kaitthǝ. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Yang Yeso geiu angǝ u tǝ gwoi, angǝ, &lt;&lt;Bǝ atǝ gwoi a tuab kullo thǝ.&gt;&gt;<verse eid="MRK 8:26" /></para>
  <para style="s">Bitrus Gei Angǝ Yeso Ən Kristi</para>
  <para style="r">(<ref loc="MAT 16:13-20">Matthew 16:13-20</ref>; <ref loc="LUK 9:18-21">Luka 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Yang Yeso i ya nanung to gu yitthǝ Betsaida tǝ gwoi a tuab gɓag Kaisariya Filibi. Lo nung lǝi lǝ u ɓibǝi angǝ, &lt;&lt;Yayuu dǝna gei angǝ ɓang ǝn yittǝnna?&gt;&gt;<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />I gwab nwa angǝ, &lt;&lt;Yakun gei angǝ mǝn Yohanna ya wollmung; yakun angǝ Iliya; langkwoi yirrǝ yakun angǝ, yuu akun dang ya gei ba a tthasi gi Fuh lakuu.<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />U ɓibǝi angǝ,&lt;&lt;Kwoi bǝ ɓǝ aɓǝ, Dǝɓa gei ɓangǝ ɓang ǝn ya?&gt;&gt;</para>
  <para style="p" vid="MRK 8:29">Bitrus gwab nwa angǝ, &lt;&lt;Mǝn kristi.&gt;&gt;<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />Yeso gub ɗuogsui angǝ bǝ i gei lǝ yuu akun tthǝthǝ.<verse eid="MRK 8:30" /></para>
  <para style="s">Yeso Gei Ba Bǝto Zuii Gu I Bǝ Ɓuiɓua Gu</para>
  <para style="r">(<ref loc="MAT 16:21-28">Matthew 16:21-28</ref>; <ref loc="LUK 9:22-27">Luka 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Yeso baipi bǝ nainatthǝ nung angǝ: &lt;&lt;Yui Yuu a lǝ tthǝzii nung kpaatthǝ langkwoi yakku a lko, yakku ya nyǝknung i ya nanatthǝ nungzuu gi Musa. Langkwoi i thǝu tthasua bo tai yang u ǝrr i nwongǝi.&gt;&gt; <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Yeso gei bakwɔ tthǝ kaitthǝ, langkwoi Bitrus tǝulǝ gwu kun dǝna than nyi lo lǝ.<verse eid="MRK 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33" />Kwoi Yeso mǝrrǝm ɓyǝa ya nanung to gu, u ǝrrlǝ Bitrus. U geiu angǝ&lt;&lt;A pa a yimbǝi, Shǝtan, Bǝ nhǝm bamǝ wuo bǝgǝ Fuh lǝu, bǝ nhǝm ba thayuu!&gt;&gt;<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Yang Yeso lubǝ kon yayuu ɓǝ i ya nanung to gu angǝ i wuo. Yeso gei angǝ: &lt;&lt;Yuu akwɔ nǝ dǝna yiɗi bǝ muo suam yang, &lt;&lt;ma la lomǝ, a lǝi kab gangǝ i ɓua mǝ, yang a muo suam. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Yuu akwɔ dǝna yiɗi bǝ sob nwongǝimǝ, yang a lǝn la; kwoi nǝ nwongǝimǝ lalǝ bam i ba nwaba a langǝ i, yang ma tǝi nwongǝi lona kwɔ Fuh wa nwong yayuu gu ɓǝ. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Ən ɓǝttǝn yuu a tǝi nǝ u tǝi longwam kwɔ yang u tǝi nwongǝi lǝu ɓa, nung yangǝu u tǝiu nǝ u tǝi nwongǝi kwɔ Fuh a dǝlǝ yayuu gu lona kwɔ wuu nwong yayuu gu lǝu ɓa? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Ko ǝn ɓǝttǝn yuu adǝ lǝbǝ pǝrǝm nwa nwongǝi guo? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Nǝ yuu akun dǝna lǝ tthǝkku bǝ muo suam i bam dang wam ya nung a ɓko kwɔ, yang Yui Yuu a lǝ tthǝkku gu lona kwɔ daa gu wa nwong yayuu gu i ya nwatummi gi Fuh ya langǝ i ɓǝ.&gt;&gt;<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Langkwoi Yeso lilotthǝ gei angǝ, &lt;&lt;Ən gei ɓǝ ba a langǝ i tthǝ, yakun tthǝ dǝi bǝikwɔ i bang ɓua yangbǝ i ɓyǝa lona kwɔ Fuh wa nwong yayuu gu ɓǝu.&gt;&gt;<verse eid="MRK 9:1" /></para>
  <para style="s">Bǝ Prǝmtthǝ Gi Yeso</para>
  <para style="r">(<ref loc="MAT 17:1-13">Matthew 17:1-13</ref>; <ref loc="LUK 9:28-36">Luka 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Tthasua bo nanakun Yeso lǝi Bitrus, Yakubu i Yohanna tǝilǝ lo tal kwɔ tǝyitthǝ kwɔ, i ɓuai lǝ. Bǝilǝ kullo tthǝ Yeso prǝm. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />Langkwoi nunglitthǝ gu mǝrrǝm vǝrǝm tthǝ dǝna lǝi nung, vǝrǝm tthǝ kwɔ yuu akun yangǝu longwam kwɔ a ɓuan a ɗigǝ nung vǝrǝm manungɓǝ ɓǝu. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Langkwoi bǝilǝ kwɔ ya nanung to gi yeso kwɔ tai kwɔ ɓyǝa Iliya i Musa fuk bǝi lǝ dǝna gei ba i ulǝ.<verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />Bitrus gei Yeso angǝ, &lt;&lt;Ya nanatthǝnung, maɗing kwɔ ɓi bǝikwɔ ɓǝ. Dǝisua ɓi mab tǝbǝ bǝikwɔ ni tai akun lǝ amǝ, akun lǝ a bǝ Musa langkwoi a kun a bǝ Iliya.&gt;&gt; <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />(Bitrus i sua yakwɔ ibǝ nungkwɔ u gei ɓǝlǝu, tthǝ vulli mui.)<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Yang tǝi fuk wuu kai ǝndei, nungkwɔ i lǝ yol dang tǝi lǝ gei angǝ: &lt;&lt;Yuu akwɔ ǝn Yuim, yuu kwɔ dǝmǝn yiɗi ɓǝ, Ɓa lǝu!&gt;&gt;<verse eid="MRK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8" />Bǝi lǝ, kwɔ i ɓyǝa bǝi ǝndǝi, i ɓyǝa yuu akun tthangǝ i lǝ lǝu ǝn Yeso ɓuo dǝi bǝilǝ i ilǝ.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Kwɔ dǝnni pin lo tallǝ, Yeso gub ɗuogsui angǝ bǝ i gei nungkwɔ i ɓyǝa kwɔ lǝ yuu akun tthǝthǝ nǝ i ǝrr lǝ Kristi Yui Yuu dang ɓua ɗǝ. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />I pyea bakwɔ dang nyii, dǝnni gei ba ɓǝ ɓuai lǝ angǝ, &lt;Ənɓǝ lǝ &lt;bǝ ǝrr dang ɓua&gt; dǝna gei?&gt;&gt;<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />Langkwoi ǝrr i ɓib Yeso angǝ, &lt;&lt;Baɓǝ bǝ ya nanatthǝnung Musa gei angǝ ǝn Iliya a osi a wua?&gt;&gt;<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Yeso gwabǝi nwa angǝ, &lt;&lt;Yangbǝ ɓa dǝba a langǝ i tthǝ, Iliya osi wuung, langkwoi wuu mab nung lozuiu. Ən ba ɓǝ bǝ i vullǝ angǝ kristi Yui Yuu a tang zuii ghaatthǝ yayuu a lko? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Kwoi ǝn gei ɓǝtthǝ, Iliya wuung, i tou i nungkwɔ i yiɗi ɓǝ, manung akwɔ i vullǝ dang nung vullǝ gi Fuh lǝ ba gu ɓǝ.&gt;&gt;<verse eid="MRK 9:13" /></para>
  <para style="s">Yeso Dǝ Tthǝla Lǝ Munthang A Yiɓǝi kwɔ I Wa aɓauɓǝ</para>
  <para style="r">(<ref loc="MAT 17:14-21">Matthew 17:14-21</ref>; <ref loc="LUK 9:37-43a">Luka 9:37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Kwɔ i kwoi i wuo sua ya nanung to gu, i ɓyea gong kon yayuu gǝmtha tthangǝ i i ya nanatthǝnung Musa dǝna nyimtha nwa i sua ya nanung to gu. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Dangtthǝ kwɔ yayuu ɓyǝa Yeso ni yang, tthǝi la ǝndǝi i nungfǝm lo i ǝrr i dum wui gummu.<verse eid="MRK 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16" />Yeso ɓib ya nanung to gu angǝ&lt;&lt;Ən ɓǝ dǝɓa nyimtha nwa lo i ila?&gt;&gt;<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Yiɓǝi a kun dang kon lǝ gwabnwa angǝ, &lt;&lt;Ya nanatthǝnung, ǝn wullǝ yuim, kwɔ wa a ɓko tthǝu kwɔ nannu bǝ gei ba. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Vii ǝndǝi nǝ wa ɓǝ ǝrr yang, wko lǝtǝ pangsua. Fuk ta yinwuo, dǝnnu tanglǝiu tthǝtha nyimtthǝ yang lang u kwi. Ən ɗyǝab ya nanung to mǝ wuu ilǝ wa ɓǝ, kwoi i ɓuan lǝu.&gt;&gt;<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Yeso gei angǝ, &lt;&lt;Əi dang wam kwɔ dǝ ba a langǝ iu ɓǝ,&gt;&gt; bo nǝnǝ mǝn ǝǝ i ɓa? Bo nǝnǝ mǝn tthǝb nyi i ɓa? Wulǝ yui ɓǝlǝ tthangǝm.&gt;&gt;<verse eid="MRK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20" />Ərr i wuulǝ yui ɓǝ. Kwɔ wa ɓǝ ɓyǝa Yeso ni, dang tthǝ u wa yui ɓǝlǝtǝ pangsua tthǝu dǝna ɓuobtthǝm. U o pangsua dǝnnu klǝng, fok ta yinwuo.<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />Yeso ɓib daa gi yui ɓǝ angǝ, &lt;&lt;Nungkwɔ baipi bǝ tou nǝɓa?&gt;&gt;</para>
  <para style="p" vid="MRK 9:21">U gei angǝ, baipiu &lt;&lt;dang munthang gu,&gt;&gt; <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />&lt;&lt;Vii ǝndǝi ɗǝnna wko lǝtǝ dang lua ko mungki yangbǝ thǝu. Kwoi nǝma ɓuan ma to nung akun ǝn to yang, a ɓyǝa nung zuii ɓi yang a nwong ɓi.&gt;&gt;<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Yeso gei angǝ.&lt;&lt;Ən gwabǝn, Nǝ mǝ i namǝ ma ɓumɓuan! &lt;&lt;Nung ǝndǝi a to tthǝn to tthǝ yuu kwɔ tthǝ i bǝ dǝnyitthǝ ɓǝ.&gt;&gt;<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Dangtthǝ daa yui ɓǝ ǝrr lǝ yol angǝ, &lt;&lt;Ɓangtthǝ i bǝ dǝnyitthǝ, kwoi ghako. A nwongǝm yangbǝ ǝn lilo bǝ dǝnyitthǝ!&gt;&gt;<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Kwɔ Yeso ɓyǝa kon yayuu surdum dǝna wuu bǝiɓǝ, u than nyi lo walǝ. Yeso gei angǝ,&lt;&lt;Mǝ wa ɓuomsui, &lt;&lt;Ən gei lǝ, a i tthǝu ba tǝtthǝu a kun thǝ!&gt;&gt;<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Wa ɓǝ lǝiu wallǝtǝ yang ǝrr itthǝu yui ɓǝ itha i kwamɓui yuu, yayuu kpaatthǝ gei angǝ u ɓuing&gt;&gt; <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Kwoi Yeso muona lǝ yuiɓǝ dǝiu lǝ nǝbo, ǝrr u dǝi nǝbo.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Tthasua kwɔ Yeso kwoi tǝ ttha dang woi, ya nanung to gu wuu ɓibu i nungtthǝu angǝ, &lt;&lt; Baɓǝ bǝ ɓi ɓuan ɓi ilǝ wa ɓǝlǝu?&gt;&gt;<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />Yeso gwabǝi nwa angǝ, &lt;&lt;Nung akwɔ nikwɔ nǝ ǝn bǝ pinwa lǝu nung akun yangǝu a ɓuan a iulǝu; &lt;&lt;nung akun yangǝu a ɓuan a ilǝ.&gt;&gt;<verse eid="MRK 9:29" /></para>
  <para style="s">Yeso Gei Ba Ɓua Gu Akun</para>
  <para style="r">(Matthew 17:22, 23; <ref loc="LUK 9:43b-45">Luka 9:43b-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Yeso i ya nanung to gu yitthǝ bǝiɓǝ kullo i muo dang Galili. Yeso yiɗi kwɔ yuu akun a ibǝi bǝikwɔ i tthǝ ɓǝlǝu, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />bakwɔ dǝnnu nanatthǝ nung lǝ ya nanung to gu ɓǝ: Yeso gei angǝ, I ab ba lo Kristi Yui Yuu i dǝllǝ yayuu. I thǝu, langkwoi bo tai yang u ǝrr i nwongǝi.&gt;&gt; <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Kwoi i ibǝi nungkwɔ dǝu nainatthǝ ɓǝlǝu dǝnni sur bǝ ɓibbu ba ɓǝ kwɔ.<verse eid="MRK 9:32" /></para>
  <para style="s">Ən Yilǝ Yuu Angã?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Matthew 18:1-5</ref>; <ref loc="LUK 9:46-48">Luka 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />I wuo Kafarnahum. Kwɔ i tǝttha dang gwoi, Yeso ɓib ya nanung to gu angǝ, &lt;&lt;Ən ɓǝ dǝɓa nyimtha nwa lo lǝ nunglǝi?&gt;&gt;<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />Kwoi i ɓuan i gwabbu nwa lǝu, bakwɔ dǝnni nyimtha nwa nunglǝi lǝ angǝ ǝn yilǝ yuu angǝ a. <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />Yeso ǝǝ sua, U lubǝ ya nanug to gu sob iu rab u gei angǝ, &lt;&lt;Yuu kwɔ ǝndǝi dǝna yiɗi bǝ ǝǝlǝ a nungsi yang u ǝǝlǝ kisua yayuu ǝndǝi langkwoi mǝrǝm lǝ thǝb yayuu ǝndǝi.&gt;&gt;<verse eid="MRK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36" />Yang Yeso lǝi munthang dǝ ganglangǝ i. U lina lodul yui lǝ u gei angǝ, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />Yuu kwɔ nǝ muo yuu akun dang yathang atuab kwɔ dang ɗuǝnnǝm lǝ u muo ǝn ɓang; langkwoi yuu kwɔ muam u muo ǝn ɓanglǝu u muon yuu kwɔ tummǝm ɓǝ.&gt;&gt;<verse eid="MRK 9:37" /></para>
  <para style="s">Yuu Akwɔ Nǝ Ən Ɓuiɓi Lǝu Yang U Ən Aɓi</para>
  <para style="r">(Luka 9:49, 50)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Yohanna geiu angǝ, &lt;&lt;Ya nanatthǝ nung, Ɓi ɓyǝa yuu akun dǝna ilǝ wa i ɗuǝn mǝ ǝrr ɓi nanutthǝ, bakwɔ u yangǝu kab ɓiu ɓǝ.&gt;&gt;<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Yeso gei angǝ,&lt;&lt;Bǝ ɓa nanuthǝ, &lt;&lt; Yuu akun yangǝu kwɔ a to nung fǝmlo i ɗuǝnnǝm yang dang tthǝ mǝrrǝm gei nung a kun ɓkotthǝ lom lǝ ɓǝ, <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Yuu akwɔ ǝndǝi nǝ laba ɓilǝu yang u i ɓi. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Ən gei ɓǝ ba a langǝ i tthǝ, yuu akwɔ nǝ dǝɓǝ ɗǝithang mungki dang ɗuǝnnǝm bakwɔ ɓǝlǝ abǝ Kristi u tǝi nung busoni tthǝu ǝntǝi.<verse eid="MRK 9:41" /></para>
  <para style="s">Bǝ Nabǝi Yangbǝ Yuu To Nungaɓko</para>
  <para style="r">(<ref loc="MAT 18:6-9">Matthew 18:6-9</ref>; Luka 17:1, 2)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />&lt;&lt;Nǝ yuu akwɔ lag bo yathang a tuab kwɔ labǝ dǝnyitthǝm, yang maɗing kwɔ i tthǝb gong nyi dulu i wko lǝtǝ nung nwam lǝ. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Nǝ namǝ dǝna yiɗi bǝ toa yangbǝ ba dǝnyitthǝ Fuh thǝ, a ɓǝrr a walǝtǝ! Maɗing kwɔ mǝ tǝ ɓǝikwɔ Fuh lǝ yigwoi kwɔ namǝ yangǝu kwɔ ma ǝǝ dang lua a ɗing i namǝ nǝ rabbu ɓǝ, <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />bǝikwɔ sonnthǝ lua bǝi ɓǝ muallǝu ɓǝ. <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Langkwoi nǝ bomǝ dǝna yiɗi bǝ toa yangbǝ ba dǝ nyi tthǝ Fuh thǝ, a ɓǝrr a walǝtǝ! a matthǝ ɗing kwɔ ma tǝ bǝi kwɔ fuh lǝ yigwoi ɓǝ kwɔ i walǝtǝ dang lua a ɗing. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />Maɗing kwɔ matǝ bǝikwɔ Fuh lǝ yigwoi kwɔ bomǝ yangǝu kwɔ ma ǝǝ i bomǝ ǝndei yang ta tǝ lua a ɗing. <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Langkwoi nǝ nungmǝ dǝna toa yangbǝ bǝ ba dǝnyitthǝ Fuh thǝ yang a kko a walǝtǝ! Maɗing kwɔ ma tǝ bǝikwɔ Fuh lǝ yigwoi kwɔ i nung kun kwɔ ma ǝǝ i nungmǝ ǝndǝi langkwoi i walǝtǝ dang lua a ɗing ɓǝ. <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />Bǝikwɔ &lt;song kwɔ da tangǝ i kwɔ ɓuiu, langkwoi lua kwɔ dǝna liǝ kwɔ muallǝu.&gt;<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />&lt;&lt; Ko ǝn ya ǝndǝi lua a ɗiggǝi manungkwɔ dǝi mabnung i dǝi lǝ ɓǝ.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />Dǝi maɗing; kwoi nǝ dǝi ɓanglǝng, yang i to nǝnǝ i koilǝ laliu i wuolǝ langkwoi?</para>
  <para style="p" vid="MRK 9:50">&lt;&lt;Ɓa ǝǝlǝ dǝi ǝnthǝ ɓuaɓǝ lǝ, ɓa ǝǝ latthǝ i tha.&gt;&gt;<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Yeso Nanatthǝ Nung Lo Bǝ Yinna Lǝ Yisi</para>
  <para style="r">(<ref loc="MAT 19:1-12">Matthew 19:1-12</ref>; <ref loc="LUK 16:18">Luka 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Yang Yeso ǝrr yitthǝ bǝi kullo tǝ losua Yahudiya ǝrr U nyang Urdun. Langkwoi kon yayuu ǝrr wua suko, manung kwɔ lǝ nung to gu kwɔ, ǝrr u nainatthǝ nung.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Yakun dang ya Farisiyawa wɔ bǝ nko i ɓibu angǝ,&lt;&lt;A gei ɓitthǝ maɗing kwɔ yuu a yinna lǝ siu ɓa?&gt;&gt;<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Yeso gwabǝi nwa i bǝ ɓib ba angǝ, &lt;&lt;Ən ɓǝttǝn Musa gei ɓǝttha?&gt;&gt;<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />Ərr i gei angǝ,&lt;&lt;Musa gei angǝ yiɓǝi a vullǝ nungvullǝ a yernwa lǝ siu yang u nannu u pa.&gt;&gt;<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Yeso gwabǝi nwa angǝ.&lt;&lt;Bakwɔ dang wa ɓǝ ɗarɗing kwɔ nungkwɔ Musa vullǝ ɓǝ nungkwɔtthǝ,&gt;&gt; <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Kwoi la nwasiu kwɔ Fuh mab nung mabbǝi gu kwɔ,&lt;Fuh mabbǝi yiɓǝi i yisi,&gt;manungkwɔ nungvullǝ ba Fuh gei ɓǝ. <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />&lt;Langkwoi lǝba ɓǝkwɔ Yiɓǝi a yitthǝ Daa gu i Naa gu u kǝbtha i siu lǝ, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />i kwɔ rab kwɔ wui mǝrrǝm kun.&gt;Yang lakwɔ i rab lǝu, kwoi tthǝ kun. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Manungkwɔni yang nungkwɔ Fuh ttheb kwɔ, bǝ thayuu bi thǝ.&gt;&gt;<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Kwɔ i kwoi itǝ ttha dang gwoi langkwoi, ya nanung to gu ɓib Yeso langkwoi lo bakwɔ. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Yeso gei angǝ, yiɓǝi kwɔ nǝ yina lǝ siu langkwoi dǝb yisi a kun yang dǝna to nung a ɓko thǝ siu lǝ. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Langkwoi nǝ yisi yina lǝ ɓǝiu langkwoi u dǝb yiɓǝi akun yang, dǝnnu to nung a ɓko thǝ yiɓǝi lǝ.&gt;&gt;<verse eid="MRK 10:12" /></para>
  <para style="s">Yeso Khana Lo Yathang Atuab</para>
  <para style="r">(<ref loc="MAT 19:13-15">Matthew 19:13-15</ref>; <ref loc="LUK 18:15-17">Luka 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Yayuu dǝna wulǝ yathang lǝsua Yeso yangbǝ wuu dǝna loi, kwoi ya nanung to gu dǝna nanni. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Kwɔ Yeso ǝrr ɓyǝa nungkwɔ, dang wko ǝrr ɓanglǝ. Yeso ǝrr gei angǝ,&lt;&lt;Ɓa yi yathang a tuab wuu tthangǝm, bǝ ɓa nanithǝ, bǝikwɔ Fuh lǝ yigwoi kwɔ ǝn abǝ yayuu manung gi. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Dǝmǝng gei ɓǝ ba a langǝ i tthǝ, yuukwɔ nǝ muo bǝ to nung to gi Fuh mangǝn munthang a tuab lǝu yang u tǝthǝu.&gt;&gt; <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Yeso ee yathang ɓǝ lo zollǝu, u dǝnko loi lǝ langkwoi u khana loilǝ.<verse eid="MRK 10:16" /></para>
  <para style="s">Ya Nungtǝi</para>
  <para style="r">(<ref loc="MAT 19:16-30">Matthew 19:16-30</ref>; <ref loc="LUK 18:18-30">Luka 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Kwɔ Yeso ǝrr baipi thko gu, yiɓǝi a kun ǝrr surdum wuu bai nwalongǝu sua dang siu. Wuu ɓib angǝ,&lt;&lt;Ya nanatthǝnung a langǝ i, ɓǝ mǝn to bǝ ǝn tǝi lǝ nwongǝi a ɗing?&gt;&gt;<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />Yeso geiu angǝ,&lt;&lt;ba ɓǝ bǝ dǝmma lubǝim mangǝ ya langǝ i?&gt;&gt; Yuu akun yangǝu lǝ ya langǝ iu ǝn Fuh kun ɓuo lǝ ya langǝ i. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />A ibǝ nung zuu: &lt;Bǝ a thǝb yuu thǝ; bǝ a ɓa siyuu thǝ; Bǝ a inung thǝ; bǝ a gwab ba pǝllǝ thǝ; Bǝ a tam yuu akun thǝ; a dǝ angǝ a lǝ daa mǝ i naa mǝ.&gt;&gt;&gt;<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Yiɓǝi ɓǝ gei angǝ,&lt;&lt;Ya nanatthǝnung,&gt;&gt; &lt;&lt;Nungkwɔ ǝndǝi ǝn to ɓanglǝ baittha.&gt;&gt;<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Yeso ɓiu ǝrr yiɗiu. Yeso geiu angǝ,&lt;&lt;Nung kun a to lǝu, Atǝ ta ɗyeab nungtǝi mǝ ǝndǝi a dǝ nungkurɓǝ ɓǝ lǝ ya yiɓko, yang ma dǝ nungtǝi wayi. Yang a wɔ, wa muo suam.&gt;&gt;<verse eid="MRK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 10:22" />Kwɔ yiɓǝi ɓǝ lǝba Kwɔ dang wko ɓanglǝ. U pa dang wko ɓanglǝ lǝ ɓang, bakwɔ u ǝn ya nungtǝi ɓǝ.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Yeso mǝrrǝm ɓyǝa bǝi ǝrr gei ya nanung to gu angǝ,&lt;&lt;Ziiɗing tthǝ yakwɔ tthǝ i nungtǝi kwɔ dǝloi lǝ bǝ lo yigwoi gi Fuh!&gt;&gt;<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Lo ya nanung to gu fǝm tthǝ bakwɔ u gei ɓǝ. Kwoi Yeso li lotthǝ gei langkwoi angǝ, &lt;&lt;Yathangǝm, zii ɗing kwɔ ya nungtǝi a tǝi tthǝ la kwɔ Fuh wa dǝllǝ yayuu gu ɓa! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Ziiu kwɔ jurobǝ a i ɓua batal kwɔ ya nungtǝi a tǝ bǝikwɔ Fuh lǝ yigwoi ɓǝ!&gt;&gt;<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Lo ya nanung to gu fǝm natthǝ, ǝrr i gei lǝtha tthǝ angǝ, &lt;&lt; Yang ǝn yittǝn a tǝi nwongǝi?&gt;&gt;<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Yeso ɓyǝai ǝrr gei angǝ,&lt;&lt;Tthǝ thayuu lǝ yang nungkwɔ ziiɗing, Kwoi manungɓǝni i Fuh lǝ lǝu; nung ǝndǝi tthǝ Fuh ziiu.&gt;&gt;<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Bitrus ǝrr gei Yeso angǝ,&lt;&lt; A ibǝi ɓi yitthǝ nung ǝndǝi wuɓi mua suamǝ!&gt;&gt;<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Yeso gei angǝ,&lt;&lt;Dǝmǝng gei ɓǝ ba a langǝ i tthǝ, yuu yangǝu kwɔ yitthǝ gwoi gu ya youngǝu yaɓǝi i yathang a yisi i Naa gu i Daa gu i yathang gu i zuk gu ba ɓang i ba nwaba a langǝ i <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />u tǝi nung busoni gu bo thǝmnu longwam kwɔ lǝu ɓǝ. I tǝi gwoi ya young a yiɓǝi, ya young a yisi, Naa, yathang i zuk- langkwoi i bǝ lǝ tthǝzii; langkwoi i ttha kwɔ dǝna wɔ ɓǝ, i tǝi nwongǝi a ɗing. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Kwoi yayuu kpaatthǝ kwɔ lakwɔ osi a kisua, langkwoi ya tthasua wa osi.&gt;&gt;<verse eid="MRK 10:31" /></para>
  <para style="s">Yeso Gei Nwaɓua Gu A Nungtai</para>
  <para style="r">(<ref loc="MAT 20:17-19">Matthew 20:17-19</ref>; <ref loc="LUK 18:31-34">Luka 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Yeso i ya nanung to gu dǝnni tǝ Urshalima. Yeso osi lǝ ya nanung to gu, lo ya nanung to gu dǝna fǝm, yakwɔ dǝna mua sua Yeso kwɔ dǝna survulli. Langkwoi Yeso kwoi lǝ ya nanung to gu sob iu rab kwɔ gwu kun u gei nungkwɔ tthǝ a tǝiuɓǝ. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />Yeso gei angǝ&lt;&lt;Ɓalǝ, ɓitǝ Urshalima bǝilǝ kwɔ i ɓanglǝ Yui Yuu i tanatthǝu lǝ yikku ya nyǝknung i ya nanatthǝ zuu gi Musa. I tǝu lǝ tǝi thǝu langkwoi i duu dang na yayol, <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />yakwɔ a tthakgu tui i tuitwui, i ɓuo i thǝu dang bo tai u ǝrr i nwongǝi.&gt;&gt;<verse eid="MRK 10:34" /></para>
  <para style="s">Ɓǝ Yambǝi Gi Yakub I Yohanna</para>
  <para style="r">(<ref loc="MAT 20:20-28">Matthew 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Yang Yakubu i Yohanna, yathang gi Zabadi, wuu suo angǝ.&lt;&lt; Ya nanatthǝnung,&gt;&gt; nungtthǝ dǝɓi yiɗi a to ɓitthǝ.&gt;&gt;<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />&lt;&lt;Yeso ǝrr ɓibbǝi angǝ ɓǝtǝn dǝɓa yiɗi ǝn toɓǝ ttha?&gt;&gt;<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />Ərr i gwabnwa angǝ,&lt;&lt; A gwab yuu a kun dang ɓi ǝǝ lonamǝ a nali yang yuu akun ǝǝ lona a namai kwɔ ma wɔ dang ghaali mǝɓǝ.&gt;&gt;<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />Yeso gei angǝ, &lt;&lt; Ɓa ibǝ nungkwɔ dǝɓa yam ɓǝlǝu. Ɓa ɓuan ɓa nwa dang ɗǝithang kwɔ ǝn nwa ɓǝng nwa? Langkwoi manung akwɔ i wollǝm mung ɓǝng wolla?&gt;&gt;<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />I gei angǝ,&lt;&lt; Ɓi ɓumɓuan&gt;&gt;</para>
  <para style="p" vid="MRK 10:39">Yeso gei angǝ, &lt;&lt; Ɓa nwa i dǝithang kwɔ ǝn nwa ɓǝng nwa langɓǝ ɓa wollmung kwɔ ǝn woll ɓǝng wol.<verse eid="MRK 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 10:40" />Kwoi bǝ ǝǝ lona a naliim i lona a namaim ǝn ɓang mǝng dǝ lǝu. Bǝi aɓǝ kwɔ ǝn aɓǝ ya kwɔ i mab lǝ ba gi ɓǝ.&gt;&gt;<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Kwɔ sua ya nanung to kwɔ sob kwɔ lǝ ba kwɔ, dang wai ǝrr ɓanglǝ tthǝ gi Yakubu i Yohanna.<verse eid="MRK 10:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 10:42" />Yeso lubǝi ǝndǝi gǝm u gei angǝ,&lt;&lt;Ɓa ibǝi ya kwɔ lǝ yayol yakwɔ dǝna lǝi loi angǝ i ǝn ya yigwoi dǝna to yayuu lǝ thǝb. Langkwoi gong yakku gi tthǝ i ttha lo yayuu kwɔ dǝni lo yigwoi loi ɓǝ. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Manung ɓǝ tolǝu. Nǝni yang, yuu kwɔ dǝna yiɗi ɓǝ to angǝ a loɓǝ yang u mǝrrǝm lǝ thǝb ɓǝ, <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />langkwoi yuu kwɔ dǝna yiɗi bǝ osi yang u mǝrrǝm lǝ thǝb. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Yeso gei angǝ Yui Yuu wuo yangbǝ wuu to yayuu lǝ thǝb lǝu, kwoi u ǝǝlǝ thǝb yayuu, yang wuu dǝ nwongǝi gu lǝ ba yayuu kpaatthǝ.&gt;&gt;<verse eid="MRK 10:45" /></para>
  <para style="s">Batimawos Ya Nungɓuommi Tǝi Bǝ Ɓyǝabǝi</para>
  <para style="r">(<ref loc="MAT 20:29-34">Matthew 20:29-34</ref>; <ref loc="LUK 18:35-43">Luka 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Yeso i ya nanung to gu te Yariko. Langkwoi kwɔ dǝnni pa, kon yayuu kpaatthǝ, dǝna i dang gwoi angǝ a lǝ, yiɓǝi ya nungɓuommi, Bartimawas (nungɓǝ lǝ yui Timawas), u ǝǝ nwa lǝi dǝnnu yam nung.<verse eid="MRK 10:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 10:47" />Kwɔ u lǝ angǝ ǝn Yeso ya Nazarat, ǝrr u baipi Bǝ buogbǝi,&lt;&lt;Yeso! Yui Dawuda! A ɓyǝa nungzuiim!&gt;&gt;<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Yayuu kpaatthǝ dǝna ǝrrǝu lǝ dǝnni geiu angǝ u kǝr, kwoi u lilo yollu, &lt;&lt; Yui Dawuda, a ɓyǝa nungzuiim!&gt;&gt;<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Yeso dǝisua ǝrr gei angǝ,&lt;&lt;Ɓa luɓǝiu.&gt;&gt;</para>
  <para style="p" vid="MRK 10:49">Ərr i luɓǝ yiɓǝi ya nungɓuommi ɓǝ, &lt;&lt; Bǝ a surr vulli thǝ! Ərr a dǝinǝbo! Dǝnnu lubǝimǝ.&gt;&gt;<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />Ərr u waa nunglitthǝ gu lǝtǝ, ǝrr u dǝinǝbo u tǝ sua Yeso.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />Yeso ɓibbu angǝ,&lt;&lt;Ɓǝttǝn dǝma yiɗi ǝn totthǝ?&gt;&gt;</para>
  <para style="p" vid="MRK 10:51">Ya nungɓuommi ɓǝ gei angǝ,&lt;&lt;Ya nanatthǝnung, Dǝmǝng yiɗi bǝ ɓyǝa bǝi.&gt;&gt;<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />&lt;&lt;Atǝ,&gt;&gt; Yeso geiu lǝ, &lt;&lt;Ba a langǝ i mǝ da tthǝlang.&gt;&gt; Dangtthǝ dǝnnu ɓyǝa bǝi ǝrr u muo sua Yeso nunglǝi lǝ.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Yeso Tǝ Urshalima Mangǝn Yigwoi</para>
  <para style="r">(<ref loc="MAT 21:1-11">Matthew 21:1-11</ref>; <ref loc="LUK 19:28-40">Luka 19:28-40</ref>; <ref loc="JHN 12:12-19">Yohanna 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Kwɔ Yeso i yananung to gu gɓag Urshalima i Betafaji i Betanya gbag tal Zaitun, Yeso tuum ya nanung to gu rab, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />U gei angǝ,&lt;&lt;Ɓa tǝ gwoi a tuab kwɔ tthasi ɓǝkwɔ. Nǝ ɓatǝ gwoi ɓǝ yang tǝɓa tǝi yui ɗǝrr tthǝb gwoi ɓǝlǝ, kwɔ yuu a kun ɗablǝu bo kun ɓǝ, yang ɓa biu ɓa wulǝ bǝikwɔ. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Nǝ yuu a kun ɓibɓǝ angǝ, &lt;Ba ɓǝ bǝ dǝɓa to nungkwa?&gt; Yang ɓa geiu ɓangǝ, &lt;Yikku dǝna yiɗi U kwoi lǝng kwoi nǝnǝng kwɔ.&gt;&gt;&gt;<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />Ya nanung to gu tǝ tǝi yui ɗǝrr gwam nunglǝi ganglang gwoi, tthǝb nwalǝgwoi kwɔ gbag nunglǝi. Kwɔ dǝnni biu, <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />Yakun tthǝ dǝi bǝilǝ ǝrr ɓib ba angǝ,&lt;&lt;Ɓǝtǝn dǝɓa tobǝi lǝ, dǝɓa bi yui ɗǝrr ɓa?&gt;&gt; <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />Ərr i gwap manung kwɔ Yeso gei tthǝɓǝ, nungkwɔ yayuu ɓa yii i pa. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Kwɔ i wulǝ yui ɗǝrr ɓǝ lǝsua Yeso nungkwɔ ǝrr i pǝm nunglitthǝ gi i dǝlo ɗǝrr ɓǝlǝ Yeso ǝrr ɗab ǝǝlo. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Yayuu kpaatthǝ nyan nunglitthǝ gilo nunglǝi lǝ, yakun nyan yan kab kwɔ i ɓǝr dang gug i nyan dang nunglǝi. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Yakwɔ tthasi i yakwɔ tthasua kwɔ dǝna buogbǝi angǝ, &lt;&lt; Hosanna! Fuh khana lo yuu akwɔ wuo dang ɗuǝn Fuh ɓǝ!&gt;&gt; <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />&lt;&lt;Fuh khana lo bǝ lo yigwoi kwɔ dǝna wɔ ɓǝ abǝ daa ɓi Dawuda, Daa ɓi! Hosanna abǝ Fuh!&gt;&gt;<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />&lt;&lt;Yeso tǝ dang Urshalima, tǝ dang kǝm nyǝknung, langkwoi u ɓyǝa nungkwɔ bǝilǝ ǝndǝi ɓǝ. Kwoi kwɔ fuh osi ong kwɔ, u palǝi Betanya suatha i ya nkong to gu sob iu rab.<verse eid="MRK 11:11" /></para>
  <para style="s">Yeso Thǝb Kab Gol</para>
  <para style="r">(<ref loc="MAT 21:18">Matthew 21:18</ref>,<ref loc="MAT 21:19">19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Ibǝi kan, kwɔ dǝnni yitthǝ Betanya, gwom dǝna tǝi Yeso. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />U ɓyǝa kab gol tutthǝ yangǝu kpaatthǝ tthǝu lǝi, u tǝ tǝu ɓyǝa lkou siu tthǝ, Kwɔ tǝu tǝi nung a kun yangǝu ǝn yangkab ɓuo, bakwɔ ǝn lona bǝ si gi gol lǝu ɓǝ. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Yeso gei kab gol ɓǝ angǝ,&lt;&lt;Yuu a kun yangǝu a tang simǝ a kunnu!&gt;&gt;</para>
  <para style="p" vid="MRK 11:14">Langkwoi ya nanung to gu lǝ nungkwɔ u gei ɓǝng.<verse eid="MRK 11:14" /></para>
  <para style="s">Yeso Tǝ Dangkǝm Nyǝknung</para>
  <para style="r">(<ref loc="MAT 21:12-17">Matthew 21:12-17</ref>; <ref loc="LUK 19:45-48">Luka 19:45-48</ref>; <ref loc="JHN 2:13-22">Yohanna 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Kwɔ Yeso i ya nanung to gu tǝ dang Urshalima, Yeso tǝ dang kǝm nyǝknung baipi bǝ nan yakwɔ dǝna ɗyǝab langkwoi dǝnni mǝl nung bǝilǝ ɓǝ. U mǝrrǝm tǝbur ya prǝm nungkurɓǝ i nung ǝǝ yakwɔ dǝna mǝl gko kwɔ u kib, <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />langkwoi Yeso yitthǝ yuu akun a lǝi nung ɗyǝaɓi a tǝ lǝ dang kǝm nyǝknung atuab lǝu. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Nungkwɔ u natthǝnung lǝ yayuu angǝ: &lt;&lt;I vullǝ dang nungvullǝ ba Fuh angǝ Fuh gei angǝ, &lt;I lu kǝm nyǝknungǝm angǝ ǝn gwoi pinwa ya longwam ǝndǝi&gt; Kwoi ɓa mǝrrǝm lǝ bǝ pyǝa ya nung i!&gt;&gt;<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Yakku ya nyǝknung i ya nanatthǝnung zuu gi Musa i lǝ bakwɔ, nungkwɔ i baipi bǝ ɗuu lǝi yangɓǝ i thǝb Yeso. Dǝnni surru ǝn surr, bakwɔ kon yayuu ɓǝ loi dǝna fǝm tthǝ bǝ nanatthǝ nung gu ɓǝ.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />Kwɔ nungluii to, Yeso i ya nanung to gu ǝrr i dang ganglang gwoi angǝ a ɓǝlǝ.<verse eid="MRK 11:19" /></para>
  <para style="s">Kab Gol Yullǝ</para>
  <para style="r">(<ref loc="MAT 21:20-22">Matthew 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Ibǝi kan nungwoi ɗǝng, kwɔ dǝnni thko lo lǝi lǝ, i ɓyǝa kab gol ɓǝ. Ɓui ǝndǝi wuo muo lǝ yǝngǝu. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Bitrus nhǝm bakwɔ Yeso gei lo kab gol kwɔɓǝ ǝrr u gei Yeso angǝ,&lt;&lt;Ya nanatthǝnung, a ɓyǝa! Kab gol kwɔ a gei ba lo kwɔ ɓuiǝng!&gt;&gt;<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />Yeso gwabǝi nwa angǝ,&lt;&lt;Ba dǝnyitthǝ tthǝ Fuh. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />&lt;&lt;Dǝmǝng gei ɓǝ ba a langǝ i tthǝ, nǝ yuu a kun gei ba lǝ tal kwɔ angǝ,&gt;&gt;A pa, tǝ o nung nwam kullo,&gt; nǝ u nhǝm ba a kun dang wko lǝu kwoi u dǝ ba a langǝ itthǝ angǝ nungkwɔ i gei kwɔ a tun to, yang a toutthǝ ǝn to. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Lǝba nungkwɔ, dǝmǝng gei ɓǝtthǝ: Kwǝ nǝ dǝɓa pinwa langkwoi dǝɓa yam nung akun, ɓa dǝba a langǝ itthǝ ɓangǝ ɓa muomuo, yang i dǝɓǝ nungkwɔ ǝndǝi ɓa yam ɓǝ. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Langkwoi kwɔ nǝɓa dǝi nǝbo dǝɓa pinwa, nǝ ɓǝtthǝ i nung a kun ganglang ɓǝ i yuu a kun, yang ɓa al baɓǝ lǝtǝ, yangbǝ Daa ɓǝ wayi al nung a ɓko ɓǝlǝtǝ.&gt;&gt; <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />&lt;&lt;Kwoi nǝɓa al nung a ɓko yayuu lǝtǝu, yang langɓǝ daa ɓǝ wayi al nung a ɓko ɓǝ lǝtǝu.&gt;&gt;<verse eid="MRK 11:26" /></para>
  <para style="s">Bǝ Ɓib Ba Ttha Gi Yeso</para>
  <para style="r">(<ref loc="MAT 21:23-27">Matthew 21:23-27</ref>; <ref loc="LUK 20:1-8">Luka 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Yeso i ya nanung to gu langkwoi tǝ Urshalima. Kwɔ Yeso dǝna thko dang kǝm Nyǝknung, yikku ya nyǝknung, ya nanatthǝnung zuu Musa i yakku wuo suo <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />langkwoi ɓibbu angǝ&lt;&lt;A tǝi ttha ɓǝllǝ dǝmma to i nungkwa? Ən yittǝn da lǝia?&gt;&gt;<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />Yeso gwabbǝi nwa angǝ,&lt;&lt;Mǝn ɓibɓǝ ba kun ɓuo. Langkwoi nǝɓa gwabbǝm nwa, Mǝn geiɓǝ ttha kwɔ ǝntǝi dǝm to i nungkwɔ ɓǝ.<verse eid="MRK 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 11:30" />Ɓa geimtthǝ, bǝ wollmung gi Yohanna wɔ ɓǝlla: wayi na bǝgǝ Fuh la ko bǝgǝ thayuu?&gt;&gt;<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />I ɓib tha ɓuai i gei angǝ:&lt;&lt;Ən ɓǝ ɓi gei? Nǝ ɓi gwabnwa, &lt;Bǝgǝ Fuh,&gt; u gei angǝ, &lt;Ənɓǝ, yang, ɓa dǝba a langǝ i tthǝ Yohanna lǝu?&gt; <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Kwoi nǝ ɓi gei ɓingǝ, Tthǝn bǝgǝ thayuu. . . &gt;&gt;&gt; (Dǝnni sur yayuu, bakwɔ yayuu ǝndǝi gwab angǝ Yohanna ǝn ya gei ba a tthasi.) <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Nungkwɔ gwabnwa lǝ Yeso angǝ,&lt;&lt;Ɓi ibǝi lǝu.&gt;&gt;</para>
  <para style="p" vid="MRK 11:33">Yeso gei angǝ,&lt;&lt;Ɓang ma ǝn gei ɓǝ bǝikwɔ ǝn tǝi ttha thǝ dǝmǝn tolǝ nungkwɔ ɓǝu.&gt;&gt;<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Bǝ Liba Lo Yakwɔ Muo Zuk Inabi Ɓǝ</para>
  <para style="r">(<ref loc="MAT 21:33-46">Matthew 21:33-46</ref>; <ref loc="LUK 20:9-19">Luka 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Yeso baipi bǝ gei ba lǝ ya nanung to gu dang bǝ liba angǝ:&lt;&lt; Yiɓǝi a kun bie inabi zug gulǝ, u kwar nwa zug ɓǝ, u thaa ɓua kwɔ u kam lǝ mung inabiɓǝ ɓǝ, langkwoi u mai kǝm tǝyi tthǝ yangbǝ dǝni ɓyǝa lǝ zug ɓǝ. Yang u lǝi zug ɓǝ u dǝlǝ yakun dǝna to nung to dang ǝu ǝrr u pa nunglǝi yol. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Kwɔ lona bǝ ɓǝrr nung ɓǝ to, u tum ya thǝb gu sua ya nung to dang zug ɓǝlǝ angǝ tǝu muo sikab dang zug ɓǝ i wulǝ. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Kwoi ya nung to ɓǝ muu, i ɓo i nannu u pa na nǝkwam. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Yang yuu zug ɓǝ tum ya thǝb gu akun langkwoi suai; i ɓuob yiɓǝi kwɔ lolǝ i duu tthǝkku. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Yuu zuk ɓǝ tum thǝb gu akun, langkwoi i thǝu; langkwoi i to yakun kpaatthǝ manungɓǝ, i ɓuob yakun, langkwoi i thǝb yakun.<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />&lt;&lt; Sua yuu akun kwɔ i u tum kwɔ ǝn yui yiɓǝi ɓǝ kwɔ dǝu yiɗi ni ɓǝ. A nǝsua ǝndǝi, u tum yuiu sua yakwɔ lǝi zukɓǝ ɓǝ. U gei angǝ,&lt; I ibǝing i dǝ angǝ a lǝ yuim.&gt;<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />&lt;&lt; Kwoi ya to nung to dang zuk ɓǝlǝ kwɔ gei lǝ tha tthǝ angǝ,&lt;Yuu kwɔ a lǝi nwa Daa ɓǝ dǝna wɔ. Ɓa wɔ, ɓi thǝu, yang nungtǝi ɓǝ mǝrrǝm lǝ aɓi.&gt; <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Nungkwɔ ǝrr i muu i thǝu, i wko lǝtǝ mual zug ɓǝlǝ.<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />Yeso ɓib angǝ,&lt;&lt; Ən ɓǝtǝn, yang yuu zug kwɔ ato? U wuo wuu thǝb yakwɔ dang zug lǝɓǝ yang u dǝ zug ɓǝlǝ yakun. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />La langǝ i ɓa than nungvullǝ kwɔ ba gi Fuh kwɔ lǝu?</para>
  <para style="q1" vid="MRK 12:10">&lt; Tal kwɔ ya mainung la angǝ mko kwɔ</para>
  <para style="q2" vid="MRK 12:10">nungɓǝ mǝrrǝm lǝ tal a langǝ i lo sua tal kwɔ ǝndǝi.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />Dangbang to nungkwɔ;</para>
  <para style="q2" vid="MRK 12:11">langkwoi ǝn nungfǝmlo nung ɓilǝ!&gt;&gt;&gt;<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Yakuu ya Yahudawa dǝna yiɗi bǝ muo Yeso, bakwɔ i ibǝing bǝ liba tthǝn loi. Kwoi dǝnni surr kon yayuu; nungkwɔ i yiu i pa nung gi.<verse eid="MRK 12:12" /></para>
  <para style="s">Ɓǝ Ɓib Ba Lobǝ Kwai Nungǝmmi</para>
  <para style="r">(<ref loc="MAT 22:15-22">Matthew 22:15-22</ref>; <ref loc="LUK 20:20-26">Luka 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Natthǝ i tum yakun dang ya Farisiyawa i yayuu gi Hiridus angǝ tǝi muo Yeso i ba nwuo. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />I wuo suko wui gei angǝ, &lt;&lt; Ya nanatthǝnung, ɓi ibǝing mǝng yuu a langǝ i. A mko yuu akunu, dǝmma lǝi yayuu ǝndǝi natha; kwoi dǝmma nanatthǝ ba Fuh manung a kwɔ dǝnnu yiɗi ɓǝ. Maɗing kwɔ i kwai nungǝmmi lǝ Kaisar tthǝɓa ko mko?&gt;&gt; <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />Ɓi kwai nungǝmmi ɓǝna ko ɓi kwaitha?&gt;&gt;</para>
  <para style="p" vid="MRK 12:15">Kwoi Yeso ibǝ pǝllǝ giǝng u ɓibǝi angǝ.&lt;&lt;Ən ba ɓǝ bǝ dǝbɓa yiɗi bǝ naam? Ɓa wulǝ nungkurɓǝ, wuum ɓyǝa.&gt;&gt;<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />Ərr i wuo lǝ nungkurɓǝ a yummi kun, Yeso ɓibbǝi angǝ,&lt;&lt; Ən kilǝng yikwa Langkwoi ǝn ɗuǝn yikwa?&gt;&gt;</para>
  <para style="p" vid="MRK 12:16">I gwabnwa lǝ Yeso angǝ&lt;&lt; Ən kilǝng Kaisar.&gt;&gt;<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Yeso gei angǝ,&lt;&lt; Ɓadǝ Kaisar nungkwɔ ǝn aɓǝ Kaisar ɓǝ langkwoi ɓa ɗǝlǝ Fuh nungkwɔ ǝn abǝ Fuh ɓǝ.&gt;&gt;</para>
  <para style="p" vid="MRK 12:17">Ərr loi fǝm ghaatthǝ lǝ ba nungkwɔ u gei ɓǝ.<verse eid="MRK 12:17" /></para>
  <para style="s">Ɓǝ Ɓibba Lo Bǝ Ərrǝu I Nwongǝi</para>
  <para style="r">(<ref loc="MAT 22:23-33">Matthew 22:23-33</ref>; <ref loc="LUK 20:27-40">Luka 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Yang ya Sadukiyawa yakku ya kǝm pinwa kwɔ dǝba a langǝ i tthǝ bǝ ǝrrǝu i nwongǝi lǝu kwɔ, gei angǝ bǝ ǝrr gi longwam yangǝu kwɔ, wuo sua Yeso i bǝ ɓib ba. <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />Angǝ,&lt;&lt;Ya nanatthǝnung,&gt;&gt; &lt;&lt; Musa vullǝ ɓitthǝ angǝ nǝ young gi yuu nǝ ɓui yitthǝ yisi kwoi yathang yangǝu, yang youngǝu dǝb siɓui ɓǝ yang si yui lǝ youngǝu tthǝ. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Lakwɔ ya young thatthǝ loi nanaira. Yuu a nungsi dǝb yisi ǝrr ɓui si yui lǝu. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Yuu a nung rabbu dǝb siɓui ɓǝ, kwoi langɓǝ u ɓui, u si yui lǝu. Manung ɓǝnni a nung taiu. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />I ǝndǝi nanaira kwɔ yuu a kun yangǝu dang ǝi si yui i yisi ɓǝlǝu. Tthasuko ǝndǝi, yisi ɓǝ ɓui langɓǝ. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Vii bǝ ǝrr gi longwam yisi ɓǝng abǝ yitǝn dang ǝi lǝ, kwɔ i ǝndǝi nanaira kwɔ i dǝb yisi ɓǝng ɓa?&gt;&gt;<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Yeso gwabǝi nwa angǝ,&lt;&lt; Ɓa lǝn la bakwɔ ɓa ibǝ nungkwɔ i vullǝ dang nungvullǝ ba Fuh ko ttha gi Fuh ɓǝlǝu. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Bakwɔ nǝ Fuh ǝrr lǝ kwamɓui yuu i nwongǝi, i dǝb thko langkwoi bǝ dǝ bǝ dǝbgwoi yangǝu i mǝrrǝm mangǝng ya nwatummi gi Fuh wayi. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Lakwɔ, lǝ ba yakwɔ ɓui ɓua i ǝrri lǝ kwɔ: ɓa than dang nungvullǝ gi Musa lǝ ba lua kwɔ dǝna li dang gug ɓǝlǝu? I vullǝ bǝi lǝ angǝ Fuh gei Musa angǝ, &lt;Ɓanglǝ Fuh kwɔ Ibrahim, dǝna wab Fuh kwɔ Ishaku dǝna wab, langkwoi kwɔ Yakubu wabɓǝ.&gt; <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Ulǝ Fuh ya nwongǝi, ǝn Fuh ya ɓuiɓua lǝu, Ɓa la ghaaɗing!&gt;&gt;<verse eid="MRK 12:27" /></para>
  <para style="s">Zuu Angã</para>
  <para style="r">(<ref loc="MAT 22:34-40">Matthew 22:34-40</ref>; <ref loc="LUK 10:25-28">Luka 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Yuu akun dang ya nanatthǝnung zuu gi Musa wɔ tǝi dǝnni than ba ɓǝ. U ibǝi kwɔ Yeso gei ba a langǝ i lǝ ya Sadukiyawa tthǝng, nungkwɔ u ɓib Yeso angǝ:&lt;&lt; Dang nung zuu ǝndǝi ǝn zuu anwɔ pǝl sua zuu kwɔ ǝndǝi?&gt;&gt;<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Yeso gwabǝitthǝ angǝ,&lt;&lt;Zuu angǝ a ǝndǝi nungɓǝ lǝ: &lt;Ɓalǝ, Ya Israila! Dangbang Fuh ɓi uɓǝ lǝ Dangbang kun. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />A yiɗi Dangbang Fuh mǝ i lo nyimǝ ǝndǝi, langkwoi i killǝng mǝ, i lonyimǝ, langkwoi i tthamǝ ǝndǝi.&gt; <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Zuu a nung rabbu manung akwɔ ni: &lt;A yiɗi ya nwalǝgwoi mǝ mangǝn lomǝ.&gt; Zuu akun yangǝu ghaa pǝl zuu kwɔ rab kwɔ ɓǝu.&gt;&gt;<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />&lt;&lt;A nanatthǝ zuu gi Musa ɓǝ gei Yeso angǝ, &lt;&lt;A gei maɗing, Ya nanatthǝ nung! A gei ǝn ba a langǝ i, manungkwɔ a gei mangǝ, Fuh kun langkwoi Fuh a kun yangǝu ǝn u ɓuo. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Langkwoi ma yiɗi Fuh i dang nyi mǝ ǝndǝi, i bǝ ibǝ nungmǝ ǝndǝi langkwoi i tthamǝ ǝndǝi; langkwoi ma yiɗi ya nwalǝgwoi mǝ manungkwɔ dǝma yiɗi lomǝ ɓǝ. Bǝ to nung to i zuu kwɔ ghaa pǝl bǝ nyǝknung tthǝ Fuh i nungbyang i sua nungnyǝgǝi.&gt;&gt;<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />Kwɔ Yeso ɓyǝa yiɓǝi ɓǝ gwabnwa baɓǝ i yiggǝi lǝ, nungkwɔ Yeso geiu angǝ,&lt;&lt;A tuttha i bǝikwɔ Fuh lǝ yigwoi ɓǝ lǝu.&gt;&gt;</para>
  <para style="p" vid="MRK 12:34">Langkwoi bǝilǝ kullo yuu akun yangǝu ɓibbu ba akun lǝu.<verse eid="MRK 12:34" /></para>
  <para style="s">Bǝ Ɓib Ba Lo Kristi</para>
  <para style="r">(<ref loc="MAT 22:41-46">Matthew 22:41-46</ref>; <ref loc="LUK 20:41-44">Luka 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Kwɔ Yeso dǝna nanatthǝnung dang kǝm nyǝknung, ǝrr u ɓib ba angǝ,&lt;&lt; Ən baɓǝ bǝ ya nanatthǝ zuu gi Musa gei angǝ Kristi ǝn ya bie gi Dawuda? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Ɓyang a Langǝ i dǝba nwa Dawuda gei angǝ:</para>
  <para style="q1" vid="MRK 12:36">&lt;&lt;&lt;Dangbang gei lǝ Dangbangǝm tthǝ angǝ:</para>
  <para style="q2" vid="MRK 12:36">&lt;&lt; A ǝǝ lona a nalim</para>
  <para style="q1" vid="MRK 12:36">tǝlǝ vi kwɔ mǝn wulǝ ya ɓui mǝ lǝ dang si mǝ ɗǝ.&gt;<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />Dawuda i nau lǝ lubǝiu lǝ &lt; Dangbang.&gt; Nǝnǝ tǝn kwoi u ǝǝlǝ lǝ ya bie Dawuda?&gt;&gt;</para>
  <para style="s" vid="MRK 12:37">Yeso Gub Ɗogsui Yayuu Tthǝ Ya Nanatthǝ Zuu Gi Musa</para>
  <para style="r" vid="MRK 12:37">(<ref loc="MAT 23:1-36">Matthew 23:1-36</ref>; <ref loc="LUK 20:45-47">Luka 20:45-47</ref>)</para>
  <para style="p" vid="MRK 12:37">Kon yayuu kpaatthǝ lǝ ba gi Yeso i tthǝla. <verse eid="MRK 12:37" /><verse number="38" style="v" sid="MRK 12:38" />Dang bǝ nanatthǝnung gu, Yeso gei angǝ,&lt;&lt; Ɓato kiggǝ i ya nanatthǝ nungzuu gi Musa. Dǝnni thko bo i nunglitthǝ angǝ a langkwoi dǝnni yiɗi yayuu gummǝi dang lomu, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />langkwoi dǝnni yiɗi bǝ ǝǝ lo nungǝǝ a langǝ i dang kǝm kǝbtha ya Yahudawa langkwoi i bǝ ǝǝ angǝ a pang ɓang. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Kwoi dǝnni tang nung na ya siɓui gwoi gi langkwoi yangbǝ i ibǝi dǝnni pinwa sua tutthǝ. Yayuu manung akuni i ji zuii ɓkoɗing!&gt;&gt;<verse eid="MRK 12:40" /></para>
  <para style="s">Bǝ Dǝnung Ya Siɓui</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luka 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Yeso ǝǝ gbag bǝikwɔ gwoi dugǝi kǝm nyǝknung, dǝnnu ɓyǝa kon kwɔ dǝna al nungkurɓǝ gi. Ya nungtǝi kpaatthǝ dǝna al nungkurɓǝ kpaatthǝ; <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Kwoi ya siɓui ya yiɓko akun wuo wuu al nungkurɓǝ ɓui a tuab rab, kwɔ natha i nungkurɓǝ angǝ a kun ɓǝ.<verse eid="MRK 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 12:43" />Yeso lubǝ ya nanung to gu langkwoi gei angǝ,&lt;&lt;Dǝmǝn gei ɓǝ ba a langǝ i tthǝ, yisi siɓui ya yiɓko kwɔ al nung dang nung al nungkurɓǝ kwɔ pǝl sua yayuu ǝndǝi. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />I ǝndǝi i dǝ dang nungtǝi gi; kwoi yisi kwɔ, dang yiɓko gu, u al nung nko ǝndǝi nungkwɔ dang nko kwɔ u dǝ nyiu tthǝɓǝ.&gt;&gt;<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Yeso Gei Ba Lo Bǝ Dǝrr Kǝm Nyǝknung</para>
  <para style="r">(Matthew 24:1, 2; Luka 21:5, 6)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Kwɔ Yeso i dang kǝm nyǝknung lǝ dǝna pa, Yuu akun dang ya nanung to gu geiu angǝ, &lt;&lt; Ya nanatthǝnung, A ɓyǝa! Tal ɓǝnni na mani kwɔ i nungmai ɓǝnni!&gt;&gt;<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />&lt;&lt;Yeso gwab nwa angǝ, &lt;&lt;A ɓyǝa gong nungmai kwɔ ǝngha? Tal a kun yangǝu i yitthǝ lo akunu; i tal kwɔ ǝndǝi i ali lǝntǝ.&gt;&gt;<verse eid="MRK 13:2" /></para>
  <para style="s">Zui Ibǝ Dǝ Tthǝzii</para>
  <para style="r">(<ref loc="MAT 24:3-14">Matthew 24:3-14</ref>; <ref loc="LUK 21:7-19">Luka 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Kwɔ Yeso ǝǝ lotal Zaitun, kwɔ baitha nwa i kǝm nyǝknung lǝɓǝ, Bitrus, Yakubu, Yohanna i Andarawas lubǝiu gwu kun i ɓibbu angǝ, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />&lt;&lt; A gei ɓitthǝ, nǝɓǝtǝn nungkwɔ a to nungtthǝ? &lt;&lt;Langkwoi ǝn ɓǝtǝn ɓi ɓyǝa kwɔ a taɓi natthǝ angǝ lona wung kwɔ i nungkwɔ a to nungtthǝ&gt;&gt;<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Yeso gei angǝ,&lt;&lt; Ɓato kiggǝ, langkwoi bǝɓa yi yuu akun ɗam ɓǝthǝ<verse eid="MRK 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 13:6" />Yayuu kpaatthǝ a wɔ i ɗuǝnnǝm, wui gei angǝ,&lt;Ɓang ǝn Yeso!&gt; Langkwoi i ɗam yayuu kpaatthǝ. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Nǝ ɓalǝ ba ɓui i nwaba lo ɓui, yang bǝ kiggǝ ɓǝ ǝrrthǝ. I nung ɓǝkwɔ a to tthǝn to, Kwoi yirrǝ bǝ alo wuo lǝu. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Losua angǝ a a ǝrr lo losua angǝ a, ya losua yigwoi a kun a taɓui i ya losua yigwoi a kullo. Longwam a tthǝuri a dǝrr bǝilǝ kpaatthǝ, langkwoi i gwom angǝ a. Kwoi nungkwɔ ǝndǝi mǝngǝn bǝ si yui afu yasi.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />&lt;&lt; Ɓǝ i naɓǝ lǝ ɓa dǝ kiggǝ ɓǝ. I tǝɓǝ lǝ tthasi ya gei kwan yang tǝi ɓuob ɓǝ dang kǝm kǝbtha ya Yahudawa; Lǝ bam ɓa dǝi tthasi yakku ya losua i ya yigwoi gi lǝba Nwaba a Langǝ i. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Kwoi i osi i gei nwaba a langǝ i lǝ ya losua ǝndǝi, nwuni bǝ nwa fwangwam wuo. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Langkwoi kwɔ nǝ i mua ɓǝ i tǝlǝ kǝm gei kwan, yang bǝɓa survulli ba nungkwɔ ɓa gei ɓǝthǝ; kwɔ nǝ lona wɔ, ɓa gei nungkwɔ i gei ɓǝtthǝ ɓǝ. Bakwɔ ɓa gei kwɔ ǝn a ɓǝ lǝu; Baɓǝ a i nwa Ɓyang a Langǝ i.<verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />&lt;&lt;Yayuu a dǝ ɓua ya youngǝi, langkwoi ya Daa a to manungɓǝni lǝ yathang gi. Yathang a ǝrr tthǝ ya daa gi yang i dǝ ɓua gi. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Yayuu ǝndǝi a laɓǝ lǝ bam. Kwoi yuu kwɔ nǝ dǝi nyimtthǝ tǝlǝ bǝ alo yang u tǝi nwongǝi.<verse eid="MRK 13:13" /></para>
  <para style="s">Tthǝzii Angã</para>
  <para style="r">(<ref loc="MAT 24:15-28">Matthew 24:15-28</ref>; <ref loc="LUK 21:20-24">Luka 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />&lt;&lt;Kwɔ nǝɓa ɓyǝa&lt; nung a ɓko&gt; bǝikwɔ kaso thǝɓǝ lǝu yang-ya tthan nung ibǝi-yang yakwɔ Yahudiya kwɔ sur tǝ dang tal. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Bǝ yuu akun lo kǝm ɓanglǝ lona pin pangsua tǝ dang kǝm yangbǝ tǝ lǝi nung akun nalǝ thǝ. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Bǝ yuu a kun dang zuk kwoi tǝ gwoi yangbǝ tǝ lǝi nunglitthǝ gu thǝ.<verse eid="MRK 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 13:17" />Vii ɓǝkwɔ a ɓko lǝ ya waa tthǝ ɗing i ya naa kwɔ si yui la ɓuoi ɓǝ! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Ɓa pinwa tthǝ Fuh bǝ nung a ɓko kwɔ to tthǝ nǝ wakɔng thǝ! <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Bakwɔ zuii kwɔ viilǝ kwɔ a ɓko pǝll sua zuii kwɔ i tang iriu lǝu bokun baipiu vii kwɔ Fuh mab longwam tthǝɓǝ wuo lǝ lona akwɔ. Langkwoi nung akun yangǝu a ɓko manungɓǝu har longwam a ǝrr lǝ. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Kwoi Dangbang ɓǝr vii ɓǝkwɔ kwoi lǝ; nǝ nilǝu yang, yuu akun yangǝu a sobbu. Kwoi lǝ ba yakwɔ u mko kwɔ, u kwoi lǝ natthǝ lona ɓǝ gǝb ni.<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />Lona lǝ kullo nǝ yuu akun gei angǝ, &lt; A ɓyǝa, Kristi kwɔ!&gt;Ko,&lt;A ɓyǝa u kullo!&gt; Bǝ a dǝba a langǝ i tthǝthǝ. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Bakwɔ ya kǝb pǝllǝ i ɗuǝn Kristi i ya gei ba a tthasi a fuk. Ito nung fǝmlo yangbǝ i ɗam ya yayuu kwɔ Fuh mko ɓǝ, nǝ a to tthǝn to ɓǝ. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Manungkwɔ ni yang ɓa kang loɓǝ; ǝn geiɓǝ nungkwɔtthǝ nwuni bǝ lona ɓǝ wua.<verse eid="MRK 13:23" /></para>
  <para style="s">Bǝ Wuo Gi Yui Yuu</para>
  <para style="r">(<ref loc="MAT 24:29-31">Matthew 24:29-31</ref>; <ref loc="LUK 21:25-28">Luka 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />&lt;&lt;Kwoi viilǝ kwɔ, tthasua zuii a ɓko kwɔ, fuh a baithǝl, langkwoi fiǝ gab luko; <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />i vin a pin wayi wa al, langkwoi Fuh a thǝuri i ttha kwɔ wayi kwɔ ǝndǝi.<verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />&lt;&lt;Yang Yui Yuu a fuk, dǝna wɔ dang tǝi i gong ttha i ghaali. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Langkwoi u tum ya nwatummi gu tǝi gǝm yakwɔ u mko ǝndǝi ɓǝ, gwɔpi lǝddah gwɔ tal i lǝsua longwam lǝ.<verse eid="MRK 13:27" /></para>
  <para style="s">Ɓa Nanung Lo Kabgol</para>
  <para style="r">(<ref loc="MAT 24:32-35">Matthew 24:32-35</ref>; <ref loc="LUK 21:29-33">Luka 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />&lt;&lt;Lakwɔ ɓa nanung lo kab gol: Nungbǝikwɔ yangǝu nǝ alǝtǝ nǝ ǝrr na bai yang, ɓa ibǝi thalǝu gbagǝng.<verse eid="MRK 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 13:29" />Manung kwɔni, nǝɓa ɓyǝa nung manung kwɔni na to nung yang, ɓa ibǝi lona gbagǝng, gǝbni i ɓǝlǝ. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Dǝmǝn gei ɓǝ ba a langǝ i tthǝ, dang wam kwɔ ɓuiu nǝ i ɓyǝa i nungkwɔ to tthǝ ɗǝ. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Wayi i pangsua thǝnthǝm, kwoi bam thǝmmu.<verse eid="MRK 13:31" /></para>
  <para style="s">Yuu Akun Yangǝu Ibǝ Vii Ko Lonko</para>
  <para style="r">(<ref loc="MAT 24:36-44">Matthew 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />&lt;&lt;Yuu akun yangǝu ibǝ viiɓǝ i lona ɓǝ, ko ya nwatummi gi Fuh wayi, Yui Yuu i nko lǝ ibǝi lǝu, Daa ɓuo i nungtthǝu ibǝi. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Ɓa ǝǝ i kiggǝ, ɓa ǝǝ nǝɓa ɓyǝa lǝi, bakwɔ ɓa ibǝ lona ɓǝ wuo tthǝ ɓǝlǝu. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />A wuo mangǝn yiɓǝi kwɔ dǝna tǝ yol langkwoi yitthǝ gwoi gu u dǝ thǝb gu lo nung gu, i ǝndǝi uji nungkwɔ i toɓǝ langkwoi u gei yuu kwɔ nwalǝgwoi kwɔ dǝnnu ɓyǝa lǝi.<verse eid="MRK 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35" />&lt;&lt;Manung kwɔni nǝɓa ɓyǝa lǝi bakwɔ ɓa ibǝ vii kwɔ yuu gwoi ɓǝ a wɔ ɓǝlǝu ko u wuo nungluii, u wuo nǝkasua, u kwoi gog dǝna ta, ko nǝ sibǝi. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Nǝ u wuo dang ɓǝthǝl, yangbǝ ɓa gwab wuo tǝiɓǝ dǝɓa lo nung lo thǝ.<verse eid="MRK 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 13:37" />Nungkwɔ ǝn gei ɓǝtthǝ kwɔ, dǝmǝn gei lǝ yayuu tthǝ ǝndǝi: ɓa ǝǝ nǝɓa dǝ kiggǝ ɓǝ!&gt;&gt;<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Yayuu Ɗulǝi Bǝ Thǝb Yeso</para>
  <para style="r">(<ref loc="MAT 26:1-5">Matthew 26:1-5</ref>; Luka 22:1, 2; <ref loc="JHN 11:45-53">Yohanna 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Sua bo rab yangbǝ ɓangbǝ nyang lo i nungtang kwɔ yisti yangǝu tthǝɓǝ, yakku ya nyǝknung i ya nanatthǝnung zuu gi Musa dǝna ɗuu bǝ nunglǝi kwɔ a mua lǝ Yeso ɓǝ yangbǝ i thǝu. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />&lt;&lt;Dǝni gei angǝ bǝɓi to Vii ɓanglǝ thǝ,&gt;&gt; yang yayuu a ǝrr lǝ yurrǝ.&gt;&gt;<verse eid="MRK 14:2" /></para>
  <para style="s">I Al Nui Lo Yeso Betanya</para>
  <para style="r">(<ref loc="MAT 26:6-13">Matthew 26:6-13</ref>; <ref loc="JHN 12:1-8">Yohanna 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Kwɔ yirrǝ Yeso dang Betanya, dǝu tang nungtang dang gwoi Saminu kwɔ to zuii i nungzii ǝmbǝlai ɓǝ, yisi a kun wu ɓko gǝu nui kwɔ kummu latthǝ langkwoi, nungkurɓǝu kpaatthǝ ɓǝ, u ɓko nui ɓǝ u al lo Yeso.<verse eid="MRK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 14:4" />Yakun kwɔ bǝilǝ kwɔ dang wai ɓanglǝ, dǝnni gei lǝ thatthǝ angǝ,&lt;&lt;Ba ɓǝ bǝ i lǝi nui kwɔ i ɓangla? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Krǝ lko i ɗyǝab nui kwɔ lo nungkurɓǝ a yuimmi kpaatthǝ yang i dǝlǝ ya yiɓko.&gt;&gt; Langkwoi i than nyi lo i nyi ɓko.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />Kwoi Yeso gei angǝ.&lt;&lt;Ɓa yiu! Ən baɓǝ bǝ dǝɓa ɓarr yisi kwa? U tom ǝn nung a langǝ i tthǝ.<verse eid="MRK 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 14:7" />Vii kwɔ ǝndǝi ɓǝ i ya yiɓko, langkwoi ɓa valli gi lona kwɔ dǝɓa yiɗi ɓǝ, Kwoi ǝn vii ǝndǝi ɓa ǝǝ i ɓanglǝ lǝu. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />U to ǝn nungkwɔ u ɓuan bǝ tou ɓǝ, U al nui a lala tthǝm lǝ yangbǝ u mabǝm ba bǝ suu bǝi. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Ən gei ɓǝ ba a langǝ i tthǝ, bǝikwɔ ǝndǝi i gei ba a langǝ i tthǝ longwam, nungkwɔ u to kwɔ i gei dang ǝu ǝn gei, lǝ ba bǝ nhǝmmu.&gt;&gt;<verse eid="MRK 14:9" /></para>
  <para style="s">Yahuda Gwabnwa Bǝ Ɗyǝab Yeso</para>
  <para style="r">(<ref loc="MAT 26:14-16">Matthew 26:14-16</ref>; <ref loc="LUK 22:3-6">Luka 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Ərr Yahuda Iskariyoti, yuu kun dang ya nanung to gu sob iu rab kwɔ, patǝ sua yakku ya nyǝknung yangbǝ u ɓangǝu lǝ u ji. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Tthǝi la ǝndǝi kwɔ i lǝnung kwɔ ɓǝ langkwoi i gwab nwa i du nungkurɓǝ. Ərr dǝnnu ɗuu bǝ nunglǝi kwɔ u ji Yeso ɓǝ.<verse eid="MRK 14:11" /></para>
  <para style="s">Yeso I Ya Nanung To Gu Tang Nungtang Nyang Lo Gwoi</para>
  <para style="r">(<ref loc="MAT 26:17-25">Matthew 26:17-25</ref>; Luka 22:7-14, 21-23; <ref loc="JHN 13:21-30">Yohanna 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Vii a nwasiu vii bǝ to ɓang bǝ tang nungtang nyang lo a kwɔ yisti yangǝu tthǝu ɓǝ, Kwɔ ǝn nung to ɓang ɓǝ kwɔ dǝnni vuu ɓangam, ya nanung to gi Yeso ɓibu angǝ,&lt;&lt;Pǝtǝn dǝmma yiɗi tǝɓi mabatthǝ kwɔ tǝmma tang nungtang ɓǝtthǝ ɓa?&gt;&gt;<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Nungkwɔ Yeso tum ya nanung to gu rab i bǝ gub ɗogsui, u gei angǝ, &lt;&lt;Ɓa tǝ gwoi angǝ a, yiɓǝi a kun lǝi gib mungki wa tǝiɓǝ. Yang ɓa muo suko. <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />Ɓa gei lǝ yuu gwoi ɓǝtthǝ ɓangǝ,&lt;Yananatthǝnung dǝna ɓib angǝ: gwoi kwɔ Yeso a ǝǝ tthǝ kwɔ pǝla, bǝikwɔ Yeso a tang nungtang nyag lo gwoi i ya nanung to gu tthǝɓǝ?&gt;<verse eid="MRK 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 14:15" />U taɓǝ natthǝ kǝm angǝ a kwɔ yilǝ, kwɔ i mab matthǝ dǝna ki. Yang ɓa mabɓi bǝ tang nungtang ɓǝtthǝ bǝilǝ.&gt;&gt;<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Yananung to gu ɓǝ ǝrr pa, i tǝ dang ganglang gwoi angǝ a i tǝi nung ǝndǝi manung kwɔ Yeso gǝitthǝɓǝ. Nungkwɔ i yo nungtang ba ɓang nyang lo gwoi ɓǝ nung kwɔ i kwoi tǝi geilǝ Yeso tthǝ i sua ya nanung to gu.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Nungluii lǝ to, Yeso wuo i yananung to gu sob iu rab. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Kwɔ dǝnni tang nungtang lotha bǝ yikkun, Yeso gei angǝ,&lt;&lt;Dǝmǝn geiɓǝ ba a langǝ i tthǝ, yuu akun dang ɓǝ a ɓangǝm lǝ yuu kwɔ dǝna tang nungtang lotha i ɓanglǝ ɓǝ.&gt;&gt;<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />I ǝndǝi dang wai ǝrr ɓanglǝ, dǝnni ɓibbu nǝkun kun dǝnni gei Yeso angǝ,&lt;&lt;Dǝma gei ǝn ɓang lǝu?&gt;&gt;<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />Yeso gei angǝ,&lt;&lt;Yuu akun dang ɓǝ sob iu rap kwɔ, Yuu kwɔ dǝna bainko dang ɗǝi lotha i ɓangɓǝ.<verse eid="MRK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 14:21" />Yui Yuu a ɓui manung kwɔ i vullǝ dang nungvullǝ gi Fuh ba guɓǝ. Kwoi ɓkoɗing lǝ yuu ɓǝkwɔ a ɓanglǝ Yui Yuu ɓǝ! A mkotthǝ ɗing krǝ bǝ i siu thǝ.&gt;&gt;<verse eid="MRK 14:21" /></para>
  <para style="s">Nungtang A Nungluii Gi Dangbang</para>
  <para style="r">(<ref loc="MAT 26:26-30">Matthew 26:26-30</ref>; <ref loc="LUK 22:14-20">Luka 22:14-20</ref>; <ref loc="1CO 11:23-25">Korontiyawa 1 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Kwɔ yirrǝ dǝnni tang nungtang, Yeso lǝi burodi, dǝ angǝ a lǝ Fuh nungkwɔ u gab dang ǝu, langkwoi u dǝlǝ ya nanung to gu u gei angǝ,&lt;&lt;Ɓa muo; nungkwɔ ǝn nyam tthǝm.&gt;&gt;<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />U lǝi ɗǝithang nwamung, u dǝ angǝ a lǝ Fuh u kwoi lǝ u dǝlǝ ya nanung to gu, i ǝndǝi i nwa mung dang ɗǝithang ɓǝlǝ.<verse eid="MRK 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 14:24" />Yeso gei ya nanung to gu angǝ,&lt;&lt;Nungkwɔ ǝn ziim kwɔ ǝn lǝi zuu tthǝu ɓǝ, kwɔ i alǝtǝ ba yayuu kpaatthǝ ɓǝ, ziim kwɔ kǝb nwa bǝ gwab nwa gi Fuh ɓǝ. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Yeso angǝ ǝn gei ɓǝ ba a langǝ i tthǝ, Ən nwa mung inabi a kunnu tǝlǝ vii kwɔ mǝn nwa afu kwɔ bǝikwɔ Fuh lǝ yigwoi ɓǝ.&gt;&gt;<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Yang i lub ɓin langkwoi i ɗab tal kwɔ kap Zaitun tthǝɓǝ.<verse eid="MRK 14:26" /></para>
  <para style="s">Yeso Gei Angǝ Bitrus A Yǝrnwa Tthǝi</para>
  <para style="r">(<ref loc="MAT 26:31-35">Matthew 26:31-35</ref>; <ref loc="LUK 22:31-34">Luka 22:31-34</ref>; <ref loc="JHN 13:36-38">Yohanna 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Yeso gei ya nanung to gu angǝ,&lt;&lt; Ɓǝ kwɔ ǝndǝi ɓa padum ɓa yim, bakwɔ i vullǝ dang nungvullǝ gi Fuh angǝ, &lt;Fuh a thǝb ya gagci ɓangam, ɓangam ɓǝ a yǝbtha.&gt; <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />Kwoi tthasua kwɔ nǝ Fuh ǝrrǝm lǝ i nwongǝi, Mǝn oɓǝsi mǝn tǝ Galili.&gt;&gt;<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />Bitrus gwabnwa angǝ,&lt;&lt; Nǝ sua yakwɔ ǝndǝi a yǝrnwa tthǝmmǝ, Ɓang abǝm ǝn yǝrnwa tthǝmmǝu!&gt;&gt;<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Yeso gei Bitrus angǝ,&lt;&lt;Ən gei ba a langǝ i tthǝ nungvii a ɗiggǝ kwɔ ma yǝrnwa tthǝm bo tai, mangǝ a imlǝu nwuni bǝ gog ta bo tai.&gt;&gt;<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />Kwoi Bitrus la lǝi dǝna nyimnwa dǝna kwab ba ɓǝ angǝ,&lt;&lt;Ən gei niu, ko mǝn ɓui i mǝ!&gt;&gt;</para>
  <para style="p" vid="MRK 14:31">Langkwoi sua ya nanung to ɓǝ gei manungɓǝ.<verse eid="MRK 14:31" /></para>
  <para style="s">Yeso Pinwa Getsemani</para>
  <para style="r">(<ref loc="MAT 26:36-46">Matthew 26:36-46</ref>; <ref loc="LUK 22:39-46">Luka 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />I ǝndǝi i tǝ bǝikwɔ dǝi luu angǝ Getsemani ɓǝ, Yeso gei ya nanung to gu angǝ,&lt;&lt;Ɓa ǝǝ ɓǝikwɔ tǝmǝn pinwa.&gt;&gt; <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Yeso lubǝi Bitrus, Yakubu i Yohanna. U baipi bǝ lǝtthǝ zii dang tthǝu lǝ ɓuontthǝ, <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />langkwoi Yeso gei angǝ, &lt;&lt;Ba zibǝi kwɔ dang nyim kwɔ ghaaɗing dǝna yiɗi bǝ thǝm. Ɓa dǝi bǝikwɔ nǝɓa kiǝ.&gt;&gt;<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Yeso tǝsi tuab, tǝu bainwa longǝu sua, u pinwa angǝ, nǝ a to tthǝn to, yang lona bǝ tangzuii kwɔ tǝi thǝ. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Yeso dǝna pinwa angǝ,&lt;&lt;Daa, Daam!&gt;&gt; Nung ǝndǝi a to tthǝn to tthǝmmǝ. A lǝi kwab tthǝzii kwɔ lom lǝ. Yirrǝ ǝn nungkwɔ dǝmǝn yiɗi ɓǝlǝu, kwoi ǝn nung kwɔ dǝmma yiɗi ɓǝ.&gt;&gt;<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Yang Yeso kwoi suko wuu tǝi ya nanung to gu kwɔ tai kwɔ dǝna lo nung lo. U gei Bitrus angǝ, &lt;&lt;Saminu, dǝma lo nung loa? Ɓa ɓuan ɓa kiǝ lona kun wa?&gt;&gt; <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Langkwoi Yeso gei angǝ ɓa kiǝ langkwoi ɓa pinwa yangbǝ bǝ a tǝ dang bǝ nabǝi thǝ. Ɓyang a langǝ i dǝna yiɗi, kwoi nyamtthǝ muanɗing.&gt;&gt;<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Yeso kwoi suko langkwoi tǝ pinwa, manung a nwasiu. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Yang u kwoi suko, wuu tǝi ya nanung to gu dǝna lo nung lo; i ɓuan i ǝǝ nǝki lǝu nung lo mui ɓuonɗing. I ibǝ nungkwɔ i geiu tthǝ ɓǝlǝu.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />Kwɔ Yeso kwoi suko a nung taitthǝu, u gei angǝ,&lt;&lt;Yirrǝ dǝɓa lo nung lo dǝɓa nwongha? Natthǝng! Lona wung! Ɓa ɓyǝa, i dǝ Yui Yuu dang na ya nung a ɓko.<verse eid="MRK 14:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 14:42" />Ɓa ǝrr, ɓi tǝ. Ɓa ɓyǝa, yiɓǝi kwɔ a ɓangǝm lǝ kwɔ dǝna wɔ ɓǝ!&gt;&gt;<verse eid="MRK 14:42" /></para>
  <para style="s">I Muo Yeso</para>
  <para style="r">(<ref loc="MAT 26:47-56">Matthew 26:47-56</ref>; <ref loc="LUK 22:47-53">Luka 22:47-53</ref>; <ref loc="JHN 18:3-12">Yohanna 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Yirrǝ kwɔ Yeso dǝna gei ba, Yahuda, yuu a kun dang ya nanung to gu sob iu rab kwɔ, fuk. U wua suatha i kon yayuu kpaatthǝ i muo khafǝi nai i gong kab, yakku ya nyǝknung, ya nanatthǝnung zuu gi Musa, i yaku.<verse eid="MRK 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 14:44" />Yahuza yuu kwɔ ɓangǝu lǝ kwɔ osi gei angǝ: &lt;&lt;Yuu kwɔ mǝn gummu i bǝ kumbǝi ǝn u yiɓǝi ɓǝ kwɔ dǝɓa ɗubǝi ɓǝ. Ɓa muu ɓa pko lǝ tǝɓa dǝ lǝ ya taɓui.&gt;&gt;<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />Dangtthǝ kwɔ Yahuza wɔni, u tǝ sua Yeso angǝ, &lt;&lt;Ya nanatthǝnung!&gt;&gt; Ərr u gummu ibǝ kumbǝi. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Nungkwɔ Yayuu ɓǝ muo Yeso i tthǝbbu i palǝ. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Kwoi yuu a kun dang ya nanung to gi Yeso kwɔ dǝi gbag bǝi ɓǝ illǝ khafǝi gablǝ ɗuogsui thǝb gi gong yikku ya nyǝknung, u ɓǝrr lǝ ɗuogsuiu. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />&lt;&lt;Yang Yeso gei kon ɓǝ angǝ, ɓa wɔ suam i khafǝi i gong kab yangbǝ wuu ɓa moum mangǝ ɓang ǝn ya nung i? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Viikwɔ ǝndǝi ɓang i ɓǝ, dǝmǝn naɓǝ natthǝnung kǝm nyǝknung, ɓa muom lǝu. Nungkwɔ ǝndǝi dǝna to nung yangbǝ ǝǝlǝ bǝ yinwa ba nungkwɔ i vullǝ dang nungvullǝ gi Fuh ɓǝ.&gt;&gt; <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />Yang ya nanung to gu surr yǝbtha yiu bǝi.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Baittha a kuntthǝ, li nunglitthǝ linin tthǝu lǝ ɓuo, dǝna muo sua Yeso. Kwɔ i muo ɓǝ, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />kwoi u padum ɓuapi nǝkwam, u yitthǝ nunglitthǝ gu.<verse eid="MRK 14:52" /></para>
  <para style="s">Yeso Tthasi Yakku</para>
  <para style="r">(<ref loc="MAT 26:57-68">Matthew 26:57-68</ref>; Luka 22:54, 55, 63-71; Yohanna 18:13, 14, 19-24)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Yakwɔ muo Yeso kwɔ i tǝu lǝ gwoi gong ya nyǝknung, yakku i ya nanatthǝnung gi Musa, wui kǝbtha bǝyikun.<verse eid="MRK 14:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MRK 14:54" />Bitrus dǝna muo suai tuutthǝ u tǝlǝ dang gwoi gi yikku ya nyǝknung ɓǝ. Bǝikwɔ dǝnni tou kwan tthǝɓǝ. Tǝu ǝǝ tthangtha i ya ki gwoi ɓǝ dǝnnu ɓuol lua.<verse eid="MRK 14:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55" />Gong ya nyǝknung i yakku dǝna ɗuubǝ ba i gei ɓkotthǝ lo Yeso yangɓǝ i tǝitthǝ i muu tǝi thǝbbu, kwoi i tǝiu i nung a kun lolǝ lǝu. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Yayuu kpaatthǝ kǝb pǝlǝ lo, kwoi nwai wuo kun lǝu.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Yang yaɓǝi yakun ǝrr dǝinǝbo kǝb pǝlǝ kwɔ lolǝ angǝ:<verse eid="MRK 14:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MRK 14:58" />&lt;&lt; Ɓi lǝu dǝnnu gei angǝ, &lt;Mǝn dǝrr kǝm pinwa kwɔ yuu mai kwɔ langkwoi dang bo tai yang mǝn mai a kun, kwɔ ǝn yuu mai lǝu ɓǝ.&gt; &gt;&gt; <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Yirrǝ pǝlǝ gi ɓǝ ǝndǝi kwɔ nwai natha lǝu.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Yang Gong ya nyǝknung ǝrr dǝinǝbo tthasi ǝndǝi ɓib Yeso angǝ,&lt;&lt; A gwab ba waa? Ən baɓǝ kwɔ yaɓǝi kwɔ dǝna kǝb lomǝ ɓa?&gt;&gt;<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />Kwoi Yeso kǝrr nung gu gei ba lǝu. Langkwoi Gong ya nyǝknung ɓǝ ɓibbu ba angǝ,&lt;&lt;Ən mǝlǝ Kristi, Yui gi Fuh kwɔ yayuu dǝna wab ɓa?&gt;&gt;<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />Yeso gwab nwa angǝ,&lt;&lt;Ən ɓang,&gt;&gt; &lt;&lt;Langkwoi ɓa ɓyǝa Yui Yuu a ǝǝ lona a nalli gi ya angǝ a dǝna wɔ dang tǝi wayi lǝ.&gt;&gt;<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Gong ya nyǝknung angǝ a ɓǝ trǝ nunglitthǝ gu gei angǝ. &lt;&lt;Ɓi yiɗi ya shǝdǝ a kun lǝu!&gt;&gt;<verse eid="MRK 14:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MRK 14:64" />&lt;&lt;Ɓa lǝ bǝ dal Fuh. Ɓǝ ɓa nhǝm?&gt;&gt;</para>
  <para style="p" vid="MRK 14:64">I ǝndǝi i gei angǝ nungkwɔ u gei kwɔ ǝn bǝ dal Fuh: kwan muung i thǝu.<verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />Nungkwɔ ya kun baipi ɓǝ twi Yeso i twitwi, langkwoi i tthǝb nungǝu i tǝrnung i ɓuo. &lt;&lt;A gei ɓitthǝ ǝn yittǝn ɓua!&gt;&gt; Ya ki gwoi lǝiu tǝi ɓuo.<verse eid="MRK 14:65" /></para>
  <para style="s">Bitrus Yǝrnwa Tthǝ Yeso</para>
  <para style="r">(<ref loc="MAT 26:69-75">Matthew 26:69-75</ref>; <ref loc="LUK 22:56-62">Luka 22:56-62</ref>; Yohanna 18:15-18, 25-27)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Bitrus ǝǝ dang gwoi bǝ to kwan bǝikwɔ i tǝlǝ Yeso tthǝɓǝ, thǝb munthang a yisi gi Gong ya nyǝknung ǝrr wuo bǝiɓǝ. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Kwɔ u ɓyǝa Bitrus dǝna ɓuol lua, ǝrr u ɓyǝko matthǝ. Munthang a yisi ɓǝ gei angǝ,&lt;&lt;Mǝ langɓǝ suatha i Yeso ya Nazarat kwɔ,&gt;&gt;<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Kwoi Bitrus nyim nwa angǝ. &lt;&lt;Ən ibǝi lǝu Ən ibǝi nungkwɔ dǝma gei ɓǝ lǝu,&gt;&gt; Ərr u i gwam u tǝttha nwalǝgwoi. Dangtthǝ ni yang gog ta.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />Kwɔ thǝb munthang a yisi kwɔ ɓiu bǝilǝ ni langkwoi u gei lǝ yakwɔ dǝi bǝi lǝkwɔ angǝ, &lt;&lt;Yuu kwɔ suatha i ilǝ!&gt;&gt;<verse eid="MRK 14:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MRK 14:70" />Kwoi Bitrus yǝrnwa langkwoi.</para>
  <para style="p" vid="MRK 14:70">Natthǝ tuab yang yakwɔ dǝi gɓag bǝiɓǝ kwɔ gei Bitrus angǝ,&lt;&lt;Ba a langǝ i mǝ i ilǝ, bakwɔ mǝn ya Galili ɓǝ.&gt;&gt;<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Yang Bitrus baipi bǝ zuunung, langkwoi u zuu nung angǝ,&lt;&lt;Fuh lǝi nwongǝim! Ən i yiɓǝi kwɔ dǝɓa gei ba gu ɓǝ lǝu.&gt;&gt;<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Dangtthǝ ni yang gog ǝrr taa a nung rabbu, yang Bitrus nhǝm bakwɔ Yeso geiu lǝ angǝ, &lt;&lt;Nungbǝi akwɔ gog a taa bo rab yang ma yǝrrnwa baam bo tai.&gt;&gt; Bitrus ǝrr absui dǝna taa.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Yeso Tthasi Bilatus</para>
  <para style="r">(<ref loc="MAT 27:1">Matthew 27:1</ref>,<ref loc="MAT 27:2">2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luka 23:1-5</ref>; <ref loc="JHN 18:28-38">Yohanna 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Nungwoi ɗǝng, yikku ya nyǝknung, i yakku, i ya nanatthǝnung Musa, i mab ba. I thǝb Yeso, i pko lǝ tǝi dǝlǝ Bilatus.<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />Bilatus ɓib Yeso angǝ,&lt;&lt; Mǝlǝ yigwoi ya Yahudawa?&gt;&gt;</para>
  <para style="p" vid="MRK 15:2">Yeso gwabnwa angǝ,&lt;&lt;Ən mǝ a gei ba kwɔ,&gt;&gt;<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Yikku ya nyǝknung muu i nung a ɓko kpaatthǝ. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Langkwoi Bilatus ǝrr ɓibbu angǝ,&lt;&lt;A gwab ba waa? A ɓyǝa bakwɔ kpaatthǝ dǝnni mua lǝ ɓǝ.&gt;&gt;<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Kwoi Yeso gei ba a kun lǝu, lo Bilatus dǝna fǝm.<verse eid="MRK 15:5" /></para>
  <para style="s">I To Kwan Ɓua Lǝ Yeso</para>
  <para style="r">(<ref loc="MAT 27:15-26">Matthew 27:15-26</ref>; <ref loc="LUK 23:13-25">Luka 23:13-25</ref>; <ref loc="JHN 18:39">Yohanna 18:39</ref>; <ref loc="JHN 19:16">19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Vii ɓang nyang lo yang Bilatus dǝna yina lǝ ya pursǝna kun kwɔ yayuu dǝna yiɗi ɓǝ. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Yiɓǝi a kuntthǝ dǝnni lu ɗuǝnu angǝ Barabbas u dang pursǝna ɓǝlǝ i ya kiggǝ a ɓko a kun kwɔ to kiggǝ a ɓko i thǝb yuu vii bǝ ǝrr lǝ yurrǝ ɓǝ. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Kwɔ kon ɓǝ wuo wuu gei Bilatus angǝ u yinna lǝ yuu kun manung kwɔ dǝnnu toɓǝ.<verse eid="MRK 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9" />&lt;&lt;Bilatus ɓibbǝi angǝ, dǝɓa yiɗi ǝn yiɓǝ natthǝ Yigwoi ya Yahudawa?&gt;&gt;<verse eid="MRK 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 15:10" />Bilatus ibǝi ǝn ba bǝ tthǝngbǝi nungkwɔ yikku ya nyǝknung duu Yeso. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />Kwoi yikku ya nyǝknung fog kon yayuu ɓǝ angǝ i gei lǝ Bilatus tthǝ angǝ u yinatthǝ Barabbas.<verse eid="MRK 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 15:12" />Bilatus ɓibǝi langkwoi angǝ,&lt;&lt;Ən ɓǝttǝn yang, yiɗi dǝɓa yiɗi mǝn to i yuu kwɔ dǝɓa luu ɓangǝ ǝn yigwoi ya Yahudawa ɓa?<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />&lt;&lt;I gwabnwa i buogbǝi angǝ, &lt;&lt;Piu lokab gangǝ i!&gt;&gt;<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Bilatus ɓibbǝi angǝ, &lt;&lt;Kwoi ǝn Nung a ɓko a nwuo u toa?&gt;&gt;</para>
  <para style="p" vid="MRK 15:14">Kwoi i buogbǝi i yoll angǝ,&lt;&lt;I piu!&gt;&gt;<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Bilatus dǝna yiɗi bǝ tǝm lo nyi kon yayuu ɓǝ, nungkwɔ Bilatus yinna tthǝ Barabbas. Yang u gei angǝ i ɓuob Yeso thab nungkwɔ tǝi piu lo kab gangǝ i.<verse eid="MRK 15:15" /></para>
  <para style="s">Ya Soja Tthak Yeso</para>
  <para style="r">(<ref loc="MAT 27:27-31">Matthew 27:27-31</ref>; <ref loc="JHN 19:2">Yohanna 19:2</ref>,<ref loc="JHN 19:3">3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Ya taɓui lǝi Yeso palǝ tǝlǝ bǝ to kwan gwoi yigwoi, u lubǝ sua ya taɓui ǝndǝi u kǝblǝtha ɓǝ yikkun.<verse eid="MRK 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 15:17" />I liu nunglitthǝ lilin tthǝ, ǝrr i kuluam nung muo lo kob i baiutthǝ lolǝ. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Ərr i baipi bǝ gummu angǝ: &lt;&lt; Dǝɓi da angǝ a yigwoi ya Yahudawa!&gt;&gt; <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Ya taɓui dǝi nwa ɓǝ ɓuo i kab lǝ lolǝ, dǝi twiu i twitwi, I bai nwalongǝi sua, dǝnni duu angǝ a. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Langkwoi Kwɔ i tthakgu i alo, i ilǝ nunglitthǝ lilin ɓǝtthǝu langkwoi i liu nunglitthǝ gutthǝ. Yang i iulǝ gwam yangbǝ tǝi piu.<verse eid="MRK 15:20" /></para>
  <para style="s">Ya Taɓui Pi Yeso Lo Kab</para>
  <para style="r">(<ref loc="MAT 27:32-44">Matthew 27:32-44</ref>; <ref loc="LUK 23:26-43">Luka 23:26-43</ref>; <ref loc="JHN 19:17-27">Yohanna 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Kwɔ Yeso lǝi kab gangǝ i gu tǝlǝsi tuap yiɓǝi a kun ǝrr wuo waa pa u ǝn ya Kurane, ɗuǝnun ǝn Saminu, u ǝn Daa gi Iskandari i Rufas, u wuo dǝnnu pa dang gwoi angǝ a ɓǝlǝ, ǝrr i muu lǝ ttha u lǝi kabgangǝ i gi Yeso. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />I tǝlǝ Yeso lǝ bǝikwɔ dǝnni luu angǝ Golgota ɓǝ, nungɓǝ lǝ bǝi kongɗǝi lo.<verse eid="MRK 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 15:23" />Bǝilo kwɔ i lang min i yǝng a kuntthǝ kwɔ angǝ mur ɓǝ, kwoi Yeso laɓǝ nwko. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Nungkwɔ i pi Yeso langkwoi gab nunglithǝ gu lǝtha, ǝrr i bai ǝnchiǝl lo nunglitthǝ gulǝ yangbǝ i ɓyǝa nungkwɔ ko ǝn ya a tǝiɓǝ.<verse eid="MRK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25" />I pi Yeso lona songsob a nung gwoi. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Nungkwɔ ǝrr i vullǝ nung a ɓko gu lolǝ angǝ: Yuu kwɔ lǝ &lt;&lt;Yigwoi ya Yahudawa.&gt;&gt; <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Ya taɓui ɓǝ pi Yeso lo kabgangǝ i i ya nung ii rab, yuu a kun lonko a nali yuu a kun lonko a namai.<verse eid="MRK 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 15:28" />Nungkwɔ ǝǝlǝ bǝ yi nwa ba dang nungvullǝ bagi Fuh angǝ,&lt;&lt;u tozuii i ya to nung a ɓko.&gt;&gt; <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />Yayuu kwɔ dǝna pa lolǝi kwɔ dǝna gei nwa wong tthǝ Yeso, dǝnni gabloi dǝnni gei angǝ, &lt;&lt;Nungkwɔ! Yuu kwɔ a dǝrr kǝm Nyǝknung a mai dang bo tai ɓǝ! <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />A pin lo kab gangǝ i lǝ a nwong lomǝ!&gt;&gt;<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Manungɓǝni yakku ya nyǝknung i ya nanatthǝnung Musa dǝna gei ba a ɓko tthǝ Yeso lǝ, dǝnni gei lǝ thatthǝ angǝ, &lt;&lt;U nwong ya kun, kwoi u ɓuan u nwong lo lǝu! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Ɓi ɓyǝa Kristi kwɔ, yigwoi ya Israila kwɔ, pin lo kab gangǝ i kwɔ lakwɔ, yang ɓi dǝba a langǝ i tthǝu!&gt;&gt;</para>
  <para style="p" vid="MRK 15:32">Yakwɔ i pii lo kab langɓǝ i Yeso kwɔ dalu.<verse eid="MRK 15:32" /></para>
  <para style="s">Ɓǝ Ɓuiɓua Gi Yeso</para>
  <para style="r">(<ref loc="MAT 27:45-56">Matthew 27:45-56</ref>; <ref loc="LUK 23:44-49">Luka 23:44-49</ref>; <ref loc="JHN 19:28-30">Yohanna 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Viilǝ kwɔ dang fuh nyilaknyilak bǝi baithǝl losua lǝ ǝndǝi, tǝlǝ lona tai a nungluii. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Langkwɔ lona a songsob Yeso tasui i yol ghaatthǝ angǝ,&lt;&lt;Eloi, Eloi, lama Sabaktani?&gt;&gt;Nungɓǝ lǝ, &lt;&lt;Fuhm, Fuhm, ǝn ba ɓǝ bǝ a laam ma?&gt;&gt;<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Yakun kwɔ dǝi gɓag bǝiɓǝ kwɔ lǝ ba gi Yeso yang i gei angǝ, &lt;&lt;Ɓalǝ, dǝnnu luɓǝ Iliya!&gt;&gt;<verse eid="MRK 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36" />Yiɓǝi a kun dang ǝi surdum i soso, tǝ bai nung min, u bai nwa kab. Yang u lǝi yilǝ wuu bai nwa Yeso lǝ angǝ nwa langkwoi gei angǝ,&lt;&lt;Dǝisua! Ɓi ɓyǝa lko Iliya dǝna wɔ wa pinnu lǝ lo kab gangǝ i lǝ!&gt;&gt;<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Yeso gei ba i yol lǝ, nungkwɔ u ɓui.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Laɓulǝ kwɔ dang kǝm Nyǝknung kwɔ trǝ dang ǝu rab, baipiu yilǝ wuo lǝ piusua. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Yikku ya taɓui kwɔ dǝi bǝilǝ tthasi kab gangǝ i kwɔ ɓyǝa Yeso kwɔ ɓui kwɔ. Gei angǝ yiɓǝi kwɔ ǝn Yui Fuh la langǝ i!&gt;&gt;<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Yasi a kun tthǝ bǝilǝ, i dǝi tuutthǝ dǝnni ɓyǝa. Maryamu Magadaliya dang ǝi lǝ, i Maryamu Naa gi Yakubu a tuap i Yusufu i Salome. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />I muo sua Yeso kwɔ u Galili langkwoi dǝi tou nung to tthǝ. Yasi yakuntthǝ langɓǝ kpaatthǝ kwɔ i wuo Urshalima suatha i Yeso kwɔ itthǝ bǝilǝ langɓǝ.<verse eid="MRK 15:41" /></para>
  <para style="s">Bǝ Suu Yeso</para>
  <para style="r">(<ref loc="MAT 27:57-61">Matthew 27:57-61</ref>; <ref loc="LUK 23:50-56">Luka 23:50-56</ref>; <ref loc="JHN 19:38-42">Yohanna 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Viilǝ kwɔ ǝn vii bǝ mabzuii nung, (nungkwɔ lǝ vii kwɔ nǝ bǝi kan yang ǝn vii nwongǝi ɓǝ). <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Yusufu ya Arimatiya, u ǝn gong yuu dang ya yakku, dǝnnu ki lona bǝ baipi bǝ lo yigwoi Fuh ɓǝ, ǝrr u wua sua Bilatus wuu ɗuu lǝi yangbǝ tǝu suu kwamɓui Yeso.<verse eid="MRK 15:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 15:44" />Lo Bilatus fǝm kwɔ u lǝ angǝ Yeso ɓuiǝng ɓǝ. Bilatus ǝrr luɓǝ yikku ya taɓui kwɔ ɓǝilǝ kwɔ ɓǝ, u ɓibbu angǝ Yeso osi ɓuinga. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Kwɔ u lǝ nwa yikku ya taɓui kwɔ angǝ Yeso ɓuing ni, u dǝ kwamɓui Yeso ɓǝlǝ Yusufu. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Nungkwɔ Yusufu ǝrr tǝ ɗyǝab malti kuluam kwamɓui yuu, u lǝi kwamɓui Yeso ɓǝ, u lam tthǝu i landǝ ɓǝlǝ, tǝu duu dang juǝn kwɔ i thaa dang tal lǝɓǝ. Nungkwɔ u tok gong tal wuu lam lǝ nwa juǝn ɓǝ.<verse eid="MRK 15:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 15:47" />Maryamu Magadaliya i Maryamu Naa gi Yusufu i dǝi bǝilǝ yangbǝ i ɓyǝa bǝikwɔ tǝi suu Yeso tthǝ ɓǝ.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Bǝ Ərr Gi Yeso I Nwongǝi</para>
  <para style="r">(<ref loc="MAT 28:1-8">Matthew 28:1-8</ref>; <ref loc="LUK 24:1-12">Luka 24:1-12</ref>; <ref loc="JHN 20:1-10">Yohanna 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Vii nwongǝi gi ya Yahudawa pa, Maryamu Magadaliya, Maryamu Naa gi Yakubu, i Salome tǝi ɗyǝab nui a kwɔ kummu latthǝ kwɔ yangbǝ wuui faalǝ Yeso tthǝ tthǝu lǝ.&gt;<verse eid="MRK 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 16:2" />Ərr nung gwoi ɗǝng vii a nwasiu dang bo nanaira ɓǝlǝ, lona kwɔ Fuh dǝna ɗab kwɔ i lo lǝi dǝnni tǝ nwa ɓua juǝn ɓǝ <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Lo lǝi lǝ dǝnni ɓibtha angǝ,&lt;&lt;Ən yitǝn a ɓko ɓi tal tthǝ nwa ɓua juǝn ɓǝla?&gt;&gt;<verse eid="MRK 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4" />Langkwoi kwɔ i wuo bǝiɓǝ ǝrr i lǝi loi yi yang, ǝrr i ɓyǝa tal kwɔ, ghaatthǝ kwɔ, i tok i kwailǝ nwa ɓua ɓǝlǝng. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Kwɔ ǝrr dǝnni tǝbǝ tǝ dang ɓua ɓǝ, ǝrr i ɓyǝa baittha a kun li nunglitthǝ la vǝrrǝm ǝǝ lona a nali lo tal lǝ, ǝrr tthǝvulli mui.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />&lt;&lt; Bǝ ɓa sur vulli thǝ,&gt;&gt; baittha ɓǝ gei ba,&lt;&lt;Ən ibǝing dǝɓa ɗubǝ Yeso ya Nazarat, kwɔ i piu ɓǝ. U ǝrrǝng! U yangǝu bǝikwɔu. Ɓa ɓyǝa bǝikwɔ i liutthǝ ɓǝ. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Ɓa tǝ, tǝɓa gei lǝ ya nanung to gu tthǝ i Bitrus,&lt; U tthasi ɓǝ dǝu tǝ Galili. Tǝɓa tǝiu bǝilǝ, manungkwɔ U gei ɓǝ tthǝɓǝ&gt; &gt;&gt;<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Yasi ɓǝ ǝrr i gwam, i dum dang juǝn gi yeso ɓǝlǝ. I gei ba lǝ yuu a kun lǝu, dǝnni sur vulli.<verse eid="MRK 16:8" /></para>
  <para style="s">Yeso Fuktthǝ Maryamu Magadaliya</para>
  <para style="r">(<ref loc="MAT 28:9">Matthew 28:9</ref>,<ref loc="MAT 28:10">10</ref>; <ref loc="JHN 20:11-18">Yohanna 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />Lakwɔ Yeso ǝrr nung gwoi vii a nwasiu dang bo nanira ɓǝlǝ, U kǝbtha i Maryamu Magadaliya nungsi, yuu kwɔ u illǝ ɓyang a ɓko tthǝu lǝ ɓǝ. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Nungkwɔ u ǝrr tǝu geilǝ yakwɔ suatha i ulǝ i yakwɔ dǝna ɓang lǝ dang wa dǝnni taasui ɓǝ. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Kwɔ i lǝ angǝ Yeso tthǝ i nwongǝi langkwoi i ɓyǝko, i gwab lǝu.<verse eid="MRK 16:11" /></para>
  <para style="s">Yeso Fuktthǝ Ya Nanung To Gu Rab</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luka 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Yeso fuk tthǝ ya nanung to gu rab nunglǝi nǝkun kun kwɔ dǝnni thko dang gwoi angǝ a ɓǝ. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Ya nanung to gu kwɔ rab kwɔ kwoi tǝi gei lǝ suaitthǝ; Langkwoi i gwab lǝu.<verse eid="MRK 16:13" /></para>
  <para style="s">Yeso Fuk Tthǝ Ya Nanung To Gu Sob Iu Kun</para>
  <para style="r">(<ref loc="MAT 28:16-20">Matthew 28:16-20</ref>; <ref loc="LUK 24:36-40">Luka 24:36-40</ref>; <ref loc="JHN 20:19-23">Yohanna 20:19-23</ref>; Acts 1:6-8)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Tthasua Yeso wuo wuu tǝi sua ya nanung to kwɔ sob iu kun kwɔ bǝ tangnung; nungkwɔ ǝrr u gei angǝ bakwɔ i yangǝu i bagi Fuh dang wai lǝu ɓǝ i kiggǝ a ɓko langkwoi i la bǝ gwab bagi yakwɔ ɓyǝa kwɔ U ǝrrǝng ɓǝ<verse eid="MRK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15" />U gei angǝ,&lt;&lt;Ɓatǝ dang longwam ǝndǝi tǝɓa gei ba gi Fuh lǝ ya longwam tthǝ<verse eid="MRK 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 16:16" />Lakwɔ yuu kwɔ nǝ gwab ba a langǝ i kwɔ i wollǝu mung yang u tǝi nwongǝi, lang yuu kwɔ nǝ gwab lǝu yang u ɓui. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Nungkwɔ ǝndǝi i ɓyǝa ǝndǝi tthǝn tthǝ yakwɔ dǝ ba a langǝ itthǝm: Dang ɗuǝnnǝm yang i illǝ ya ɓyang a ɓko; i gei ba i nwa kwɔ i gei lǝu bo kun ɓǝ;<verse eid="MRK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 16:18" />i lǝi biǝk i na, i nwa yeng a ɓko, yeng a ɓko yang nkoniu; i dǝnai lo ya nungzii, yang i tǝi tthǝla.&gt;&gt;<verse eid="MRK 16:18" /></para>
  <para style="s">Yeso Tǝ Wayi</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luka 24:50-53</ref>; Acts 1:9-11)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Tthasua kwɔ Dangbang Yeso gei ba kwɔ i ilǝ, ǝrr i lǝiu i tǝlǝ wayi tǝu ǝǝ lona ghaali gi Fuh. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Nungkwɔ ya nanung to gu thko bǝikwɔ ǝndǝi dǝna gei ba a langǝ i, langkwoi Dangbang dǝna thko suatha i illǝ langkwoi dǝna to nung to i ilǝ dǝnnu ji ttha tthǝ nungkwɔ dǝnni to ɓǝ.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>