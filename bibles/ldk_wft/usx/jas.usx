<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">Yakubu</para>
  <para style="toc1">Nungvullǝ Bǝgǝ YAKUBU</para>
  <para style="toc2">Yakubu</para>
  <para style="toc3">Yak</para>
  <para style="mt2">Nungvullǝ Bǝgǝ</para>
  <para style="mt1">YAKUBU</para>
  <para style="imt">Bǝ Gabnung</para>
  <para style="ip">
    <char style="bk">Nungvullǝ Bǝgǝ Yakubu </char> ǝn bǝ nanung kpaatthǝ, kwɔ i vullǝ sua ya &lt;&lt;yayuu gi Fuh ǝndǝi kwɔ yǝbtha longwam ǝndǝi ɓǝ.&gt;&gt; Ya vullǝ nung ɓǝ to nungto i bǝ gei ba dang ba yangbǝ u gei lǝ ba gu lo bǝ to yiggǝi langkwoi nunglǝi mab kiggǝi. Nunglǝi ya Kristǝ lǝ u gei ba lo nung kpaaɗing manung gi nungtǝi i yiɓko, bǝ nabǝi, kiggǝ a langǝ i, bǝ nhǝm ba kwɔ ǝn ba a langǝ i lǝu ɓǝ, bǝ dǝnyitthǝ, i nungto, bǝ to nungto i lyǝn, yiggǝi, bǝ kwatha, lo angǝ a ibǝ ɓuob lo sua, bǝ to kwan lǝ yakun, bǝ lǝilo, bǝ tthǝb nyitthǝ, i bǝ pinwa.</para>
  <para style="ip">Nungvullǝ ɓǝ oinyi tthǝ mali gi nungto tthǝ i bǝ dǝnyitthǝ, dang bǝ to nungto i nunglǝi ya Krista.</para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />Ɓang Yakubu, thǝb gi Fuh langkwoi gi Dangbang Yeso Kristi:</para>
  <para style="p" vid="JAS 1:1">Dǝmǝn tumbǝi ibǝ gumbǝi sua ya kabgwoi gi Fuh kwɔ sob iu rab kwɔ yǝbtha longwam ǝndǝi ɓǝ.<verse eid="JAS 1:1" /></para>
  <para style="s">Bǝ Dǝnyitthǝ I Yiggǝi</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />Ya youngǝm yaɓǝi i yasi, ɓa lǝ tthǝla kwɔ nǝ bǝ nabǝi kpaatthǝ tǝiɓǝ ɓǝ, <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />bakwɔ ɓa ibǝi kwɔ nǝ bǝ dǝnyitthǝ ɓǝ pǝll bǝ nabǝi kwɔ, yang ɓǝtthǝ i ttha kwɔ ɓa nyimnyi ɓǝ. <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />Bǝ tthǝb nyitthǝ mǝ olǝ si yangbǝ a nyim, a ghaa a nyim, yangbǝ a tǝi nung ǝndǝi. <verse eid="JAS 1:4" /><verse number="5" style="v" sid="JAS 1:5" />Kwoi nǝ yuu akun ɓǝ dǝna yiɗi yiggǝi yang, ɓa pinwa tthǝ Fuh, kwɔ a dǝɓǝ ɓǝ; bakwɔ Fuh dǝna dǝ nung kpaatthǝ dang wa kun lǝ yayuu ǝndǝi bǝ mko bǝi yangǝu. <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />Kwoi kwɔ nǝ dǝɓa pinwa, ɓa dǝnyitthǝ langkwoi bǝɓa to shaka thǝ ko tuab. Yuu akwɔ nǝ to shaka yang u natha i bǝ tǝngǝlǝ mung lo nwam kwɔ wa dǝna ɓuob ɓǝ. <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />Nǝ mǝ manungkwɔ ni, a ɓuan a dǝ nyimǝ lo nung kunnu dang nungkwɔ dǝmma to ǝndǝi, bǝ a nhǝm ma tǝi nung ǝntǝi na Dangbang thǝ. <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />U ǝnya lonyi rab, yayuu ɓuan dǝ nyi tthǝu lǝu.<verse eid="JAS 1:8" /></para>
  <para style="s">Yiɓko I Nungtǝi</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />Ya young ya Krista kwɔ lǝ ya yiɓko kwɔ i lǝtthǝla kwɔ nǝ Fuh ji nungtǝi dang nyii ɓǝ, <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />langkwoi Krista ya nungtǝi lǝ tthǝla kwɔ nǝ Fuh thǝmlǝ nungtǝi gi ɓǝ. Bakwɔ ya nungtǝi a thǝm nǝkwam mangǝn vin kab dang gug ɓǝ. <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />Nǝ fuh dǝna ɗab i sɔniu langkwoi dǝna tang gug ɓǝ; vin kab ɓǝ dǝna al, langkwoi maliu dǝna ɓanglǝ. Manungɓǝni ya nungtǝi a ɓanglǝ kwɔ dǝna thko dǝi to nung ɗyǝaɓi gi ɓǝ.<verse eid="JAS 1:11" /></para>
  <para style="s">Bǝ Nabǝi I Ɗambǝi</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />Ya lǝ tthǝla ǝn yakwɔ i dǝi dang bǝ dǝnyitthǝ gi kwɔ nǝ bǝ nabǝi tǝi ɓǝ, bakwɔ nǝ i ilo dang bǝ nabǝi kwɔ, i muo nungbusɔni gi nwongǝi kwɔ Fuh gwab nwuo lǝ yakwɔ dǝna yiɗi gu ɓǝ. <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />Nǝ i lag bo ɓi i bǝ nabǝi manungkwɔ ni, bǝɓi gei ɓingǝ, &lt;&lt;Fuh dǝna lag bom thǝ.&gt;&gt; Bakwɔ Fuh ɓuan nabǝi i Mungkulum mu, langkwoi u i nko na yuu akun lǝu. <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />Kwoi i na ɓing kwɔ nǝ i ɗam ɓi i palǝ langkwoi i muo ɓi i nungkwɔ dǝɓi yiɗi ɓǝ. <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />Yangbǝ yiɗi nung mungkulum lǝi wa si nung a ɓko; langkwoi nung a ɓko, nǝ ghaa nyim yang, si ɓua.<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />Ya youngǝm kwɔ dǝɓi yiɗi niɓǝ, bǝ i ɗamɓǝ thǝ! <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />Nungdǝ a langǝ i ǝndǝi langkwoi nungdǝ akwɔ matthǝ kwɔ wuo tthǝn wayi; dǝna pin tthǝn wayi bǝgǝ Daa, ya mab nung gabbǝi wayi, yuu akwɔ mǝrǝm ɓǝ ko mǝrǝm kiggǝu mangǝn nungkwɔ da tǝn ɓǝu. <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />I bǝ yidɗi gu u si ɓi i ba a langǝ i, yangbǝ ɓi tǝi bǝ dǝi a nungsi dang nung mabbǝi gu ǝndǝi.<verse eid="JAS 1:18" /></para>
  <para style="s">Bǝ Lǝba Ibǝ Tolǝ Nungto</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />Ya youngǝm kwɔ dǝɓi yiɗi niɓǝ, ɓa owh nyitthǝ nungkwɔ! Ko ǝnya ǝndǝi thǝm bǝ lǝba, kwoi bǝ a thǝm bǝ geiu thǝ langkwoi bǝ a thǝm bǝ nyinyi thǝ. <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />Yuu kwɔ tthǝ i nyi dang wko ɓuan to nung a langǝ i kwɔ Fuh dǝna yiɗi ɓǝu. <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />Manungkwɔ ni yang ɓa la kiggǝ a ɓko kwɔ ǝndǝi i kiggǝ thǝbǝi. Ɓa dǝ loɓǝ lǝ Fuh yang ɓa muo ba Fuh kwɔ u bie dang nyi ɓǝ ɓǝ, kwɔ ɓa ɓuan ɓa sob lo ɓǝ ɓǝ.<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />Bǝ ɓa ɗam loɓǝ i bǝ lǝba gu ɓuo thǝ; Manungkwɔ niyang, ɓa tolǝ nungto. <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />Yuu akwɔ ǝndǝi nǝ lǝ bagu, kwoi tolǝ nung to lǝu yang u mangǝn yakwɔ ɓyǝa loi i gǝlas ɓǝ. <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />U ɓyǝa lo matthǝ langkwoi u pa yang dang tthǝ i danyitthǝ nungkwɔ i ɓyǝa ɓǝ. <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />Kwoi yuu akwɔ ǝndǝi dǝna ɓyǝa zuu kwɔ matthǝ kwɔ dǝna ilǝ yayuu bǝ tǝi loi kwɔ, langkwoi a ǝǝnwa bǝ tolǝ nungto langkwoi dǝna lǝnlǝ ɓuo langkwoi yang danyitthǝ lǝu, kwoi a tolǝ nung to- Fuh a khana lo dang nungkwɔ ǝndǝi dǝu toɓǝ.<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />Yuu akun tthǝ dang ɓǝ dǝna nhǝm angǝ dǝnni wab Fuh mattha? Nǝ u muo nwuo lǝu, bǝ wab Fuh gu ǝn nung a nǝkwam langkwoi dǝnnu ɗam lo. <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />Nungkwɔ Fuh Daa dǝna yiɗi kwɔ nungɓǝ lǝ bǝ wab Fuh a langǝ i langkwoi akwɔ matthǝ nung a ɓko yangǝu tthǝ kwɔ nungɓǝ lǝ: bǝ ttha ya yui kai i ya siɓui dang zuii gi langkwoi yang la nung a ɓko longwam kwɔ.<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s">Bǝ Gub Ɗuogsui Labǝ Yidɗi Yakun</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />Ya youngǝm, manungkwɔ ɓǝlǝ ya dǝba a langǝ i tthǝ Dangbang Yeso Kristi ɓi, Dangbang ya angǝ a, bǝ ɓa ɓyǝa yayuu ɗǝ nwuni ɓa toi nung tthǝ nǝ kunkun thǝ. <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />Kaso nǝ yuu akun wuo bǝ kǝbtha ya Yahudawa i ɓǝ li zinariya i nunglitthǝ matthǝ, langkwoi yiɓǝi akun ya yiɓko wuo langɓǝ li tǝrnung. <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />Nǝ ɓadǝ ghaali ghaatthǝ lǝ yiɓǝi kwɔ li nung matthǝ kwɔ ɓa geiu ɓangǝ, &lt;&lt; A ǝǝ lo nung ǝǝ a langǝ i kwɔ,&gt;&gt;kwoi ɓa gei ya yiɓko kwɔ, &lt;&lt; A dǝi kullo ko a ǝǝ pangsua kwɔ gɓag bom kwɔ,&gt;&gt; <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />nǝ ɓa to ni yang kwan muo ɓǝng bakwɔ ɓa gab ganglang ɓǝ langkwoi bǝ to kwan ibǝ nhǝm ba Mungkullum.<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />Ɓalǝ, ya youngǝm kwɔ dǝɓi yiɗi niɓǝ! Fuh mko ya yiɓko longwam kwɔ yangbǝ ǝǝlǝ ya nungtǝi dǝnyitthǝ langkwoi i tǝi bǝ lo yigwoi kwɔ u gwab nwa lǝ yakwɔ dǝna yiɗi gu ɓǝ. <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />Kwoi ɓa tthǝm ya yiɓko! Ya ɓǝlǝ yakwɔ dǝna muo nung naɓǝ lǝ ttha langkwoi dǝnni gub ɓǝ dǝnni tǝlǝ tthasi ya to kwan na? Ya nungtǝi! <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />Ən iɓǝlǝ yakwɔ dǝnni gei nung a ɓko tthǝ ɗuǝn a langǝ i kwɔ i dǝɓǝ ɓǝ.<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />Dǝɓa to ǝn nung a langǝ i nǝ dǝɓa to nung to i zuu bǝ lo yigwoi gi Fuh, kwɔ dang nungvullǝ bagi Fuh angǝ, &lt;&lt;A yiɗi ya nwakong mǝ manung akwɔ dǝmma yiɗi lomǝ ɓǝ.&gt;&gt; <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />Kwoi nǝ dǝ ɓa la yakun yang dǝ ɓa yiɗi yakun ba nungkwɔ i li tthǝi kwɔ yang, kwan nung a ɓko muo ɓǝng, langkwoi zuu ɓangɓǝlǝ lǝya la bǝ to nung to i zuu. <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />Yuu akwɔ nǝ la bǝ tonungto i zuu kun yang u la bǝ tonungto i suo ǝndǝing. <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />Bakwɔ u yuu ɓǝkwɔ gei angǝ, &lt;&lt;Bǝ ɓa lo i si ko ɓǝi yuu akun thǝ,&gt;&gt;langkwoi gei angǝ, &lt;&lt;Bǝ a thǝb yuu thǝ.&gt;&gt;Ko nǝ a lo i si ko ɓǝi yuu akun lǝu mǝn ya la bǝ to nung to i zuu nǝ a thǝb yuu ɓǝ. <verse eid="JAS 2:11" /><verse number="12" style="v" sid="JAS 2:12" />A gei ba langkwoi a to nung to mangǝ ǝn yayuu kwɔ i toi kwan tthǝ i zuu kwɔ ɓi tǝi lǝ loɓi ɓǝ. <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />Bakwɔ Fuh ɓyǝa nung zuiiu kwɔ nǝ dǝu to kwan lǝ yuu akwɔ tthǝ ɓyǝa nung zuiiu ɓǝ; kwoi nungzuii dǝna tang lo tthǝ kwan.<verse eid="JAS 2:13" /></para>
  <para style="s">Bǝ Dǝnyitthǝ I Nung to</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />Ya youngǝm ǝn ɓǝtǝn lǝ nung a langǝ i nǝ yuu akun dang ɓǝ gei angǝ i tthǝ ibǝ dǝnyitthǝ yang nungto gu tanatthǝ angǝ i tthǝ i bǝ dǝnyitthǝ lǝu? Bǝ dǝnyitthǝ kwɔ a sobɓǝ ǝn sob ba? <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />Kaso ya young tha tthǝ yaɓǝi ko yasi kwɔ dǝna yidɗi nunglitthǝ langkwoi i yangǝu i nungkwɔ i tangɓǝu. <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />Ən ɓǝttǝn lǝ nung a langǝ i kwɔ ma gei mangǝ, &lt;&lt; Fuh khana loɓǝ! A ǝǝ sɔn tthǝ langkwoi a tang nung matthǝ!&gt;&gt;-Nǝ a ji nungkwɔ tthǝ dǝnni yiɗi lǝu ɓa? <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />Manungɓǝ ni ibǝ dǝnyitthǝ: nǝ u kun ɗǝng langkwoi nungto yangǝu, yang ɓui ǝnɓui.<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />Kwoi yuu akun a gei angǝ, &lt;&lt; Yuu akun tthǝ ibǝ dǝnyitthǝ, yuu akun tthǝ i nungto.&gt;&gt; Bǝ gwab nwam nungɓǝlǝ &lt;&lt; A tamnatthǝ yuu kwɔ tthǝ ibǝ dǝnyitthǝ yang yangǝu i nungto ɓǝ. Mǝn tanatthǝ bǝ dǝnyitthǝm tthǝ nungtom.&gt;&gt; <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />Ba dǝ ba a langǝ i tthǝ ɓangǝ Fuh kun ɗǝng ɓuo? Maɗing! I bǝnnǝng langɓǝ dǝ ba a langǝ i tthǝng- tthǝi ɓuobtthǝm i vulli. <verse eid="JAS 2:19" /><verse number="20" style="v" sid="JAS 2:20" />Ɓǝ ya sullǝ! Dǝɓa yiɗi i taɓǝ natthǝ angǝ bǝ dǝnyitthǝ kwɔ nung to yangǝutthǝ kwɔ ǝn nung a nǝkwam ma? <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />I dǝ bǝba ɓi Ibrahim nǝnǝ la langǝ i i Fuh la? Tthǝn tthǝ bǝ to nung to gu, kwɔ u nyǝk yuiu Ishaku lo tuu nyǝknung ɓǝ. <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />Ɓa ɓuan ɓa ɓyǝa wa? Bǝ dǝnyitthǝ gu i nung to gu to nung to tthǝtha; bǝ dǝnyitthǝ gu alo tthǝ nung to gu. <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />Langkwoi nungvullǝ bagi Fuh wuo ǝǝ la langǝ i kwɔ gei angǝ, &lt;&lt;Ibrahim dǝ ba a langǝ i tthǝ Fuh lǝ, langkwoi lǝba bǝ dǝnyitthǝ gu Fuh gwabbu lǝya langǝ i.&gt;&gt;Langkwoi nungkwɔ i luu Ibrahim angǝ ǝnthǝ gi Fuh. <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />Ɓa ɓyǝang lǝ, yang, angǝ tthǝn tthǝ nung to ɓi i dǝɓi matthǝ i Fuh lǝ, langkwoi tthǝn tthǝ bǝ dǝnyitthǝ ɓi ɓuo lǝu.<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />Manungɓǝni i Rahab ya tang nǝkwam kwɔ. I du matthǝ i Fuh lǝ tthǝ nung to gu, ibǝ kǝblo ya ɓuubǝi ya Israila langkwoi u nwongǝi i tǝitthǝ i pa nunglǝi akun.<verse eid="JAS 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26" />Nungkwɔ yang, manungkwɔ tthǝ ɓyang yangǝu tthǝ yang ɓui ǝn ɓui, langɓǝ bǝ dǝnyitthǝ nungto yangǝu yang ɓui ǝnɓui.<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s">Lyǝn</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />Ya youngǝm, bǝ yakun kpaatthǝ dang ɓǝ mǝrǝmlǝ ya nanatthǝnung thǝ. Manungkwɔ ɓa ibǝi kwɔ, ɓi ya nanatthǝnung Fuh a toɓi kwan tthǝ zii pǝll a bǝ sua yakwɔ. <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />Ɓi ǝndǝi dǝɓi gal vii ǝndǝi. Kwoi nǝ yuu gal lǝu tthǝ nungkwɔ dǝu gei kwɔ, u ǝn ya langǝ i langkwoi u ɓuan u muo tthǝu ǝndǝi. <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />Dǝɓi al aminjǝ nwa prǝ yangbǝ u to nung to i nungkwɔ dǝɓi yiɗi ɓǝ, langkwoi ɓi ɓuan ɓi to sua tthǝu a tǝ bǝikwɔ dǝɓi yiɗi u tǝɓǝ. <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />Ko ɓa nhǝm gong kwai: i ghaaliu kwɔ ǝndǝi langkwoi wa angǝ a dǝna tuog dǝna palǝ, nung tuabni dǝi kog lǝ, langkwoi dǝna tǝ bǝikwɔ ya kogǝu dǝna yiɗi u tǝ ɓǝ. <verse eid="JAS 3:4" /><verse number="5" style="v" sid="JAS 3:5" />Manungɓǝ ni i lyǝn: i suinliu kwɔ, a lǝilo lǝ ba nung angǝ a kpaatthǝ.</para>
  <para style="p" vid="JAS 3:5">Ɓutthǝu a nhǝm ghaali kǝm kab kwɔ lua tuabni a li ɓǝ! <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />Langkwoi lyǝn mangǝ ǝn lua. Ən longwam nung a ɓko, dǝu lǝi bǝdǝi gu tthǝɓi lǝ langkwoi dǝu yǝb mullub dang nwongǝi ɓi ǝndǝi. Dǝu bailua tthǝ nwongǝi ɓi i lua kwɔ ǝǝ kongɓua lua ɓǝ. <verse eid="JAS 3:6" /><verse number="7" style="v" sid="JAS 3:7" />Ɓi thayuu ɓi ɓuan ɓi muo sua nung mabbǝi kwɔ ǝndǝi, nyam dang gug i nurug, ya krom i biwa i yakwɔ dang mung ɓǝ. <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />Kwoi yuu akun yangǝu ɓuan muo lyǝnu. Ən mungkullum langkwoi i ɓuan i muou, yǝng thǝb bǝi yi dang ǝu. <verse eid="JAS 3:8" /><verse number="9" style="v" sid="JAS 3:9" />Dǝɓi to nung to i lyǝn ɓi dǝɓi to sakko lǝ Dangbang ɓi langkwoi Daa langkwoi langɓǝ dǝɓi dal yakun, yakwɔ Fuh mabbǝi itha i ulǝ ɓǝ. <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />Nwa kun ɗǝng ɓa kha bǝi ibǝ dal bǝi dǝna al itthǝ. Ya youngǝm, bǝ nungkwɔ to nung thǝ! <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />Bǝ nyinyak yangǝu a ilǝ mungki a lala i a nyinyi nwaɓua kunnu. <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />Ya youngǝm, kab gol, ɓuan si zaitun nu; kab inabi ɓuan si kab gol lǝu, mungki dǝi ɓuan wuolǝ mungki a langǝ iu.<verse eid="JAS 3:12" /></para>
  <para style="s">Yiggǝi Wayilǝ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />Yuu akun tthǝ dang ɓǝ i yiggǝi langkwoi tthǝ ibǝ ibǝnung a? U tanatthǝ i nwongǝi gu a langǝ i, i nung to ɓǝ a langǝ i i bǝ ɓuob lo sua i yiggǝi. <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />Kwoi nǝ dang wa mǝ dǝmma tthǝng bǝi, nyi, langkwoi dǝmma yiɗi lomǝ, bǝ a to nung a ɓko tthǝ ba a langǝ i ibǝ lǝi lomǝ tthǝ yiggǝi mǝthǝ. <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />Yiggǝi manungkwɔni wuo wayi lǝ lǝu, ǝn nunglǝi thayuu, ɓyang yangǝu dang ǝu lǝu langkwoi ǝn nungna Shǝtan. <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />Bǝi kwɔ bǝ tthǝng bǝi tthǝ bǝ yiɗi lo, bǝi lǝ kwɔ langɓǝ bǝ ɓanglǝ nung to langkwoi i sua nung mullub kwɔ ǝndǝi tthǝ. <verse eid="JAS 3:16" /><verse number="17" style="v" sid="JAS 3:17" />Kwoi yiggǝi kwɔ wuo wayi kwɔ la nwasiu ǝn a langǝ i; bǝ ǝǝ a langǝ i langkwoi, tǝm tthǝ, langkwoi dǝna to ǝnthǝ; dǝna ɓyǝa nungzuii ɗing langkwoi dǝna wɔlǝ nungɓǝri nung to a langǝ i; yangǝu dang yiɗi yakun a la yakun i pǝllǝu. <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />Kwɔ yayuu kwɔ vii ǝndǝi dǝna yiɗi bǝ ǝǝ la langǝ i a ɓyǝa bǝ ǝǝ latthǝ i kai lǝ nungkwɔ i bie ɓǝ.<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s">Bǝto Ənthǝ I Longwam</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />Vǝm i bǝ kwatha kwɔ ǝrr ɓǝlǝ dang ɓa? I ǝr bǝgǝ yiɗi tthǝ la, kwɔ vii ǝndǝi dǝna ɓuob vǝm dang tthǝ ɓǝ. <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />Dǝɓa yiɗi nung, kwoi ɓa ɓuan ɓa tǝiu, dǝɓa yiɗi bǝ thǝb bǝi; dǝɓa yiɗi nung ɗing, kwoi ɓa ɓuan ɓa tǝiu, niyang dǝ ɓa kwatha langkwoi dǝ ɓa ɓuob vǝm. Ɓa tǝi nungkwɔ dǝ ɓa yiɗi ɓǝu bakwɔ ɓa yam na Fuh lǝu ɓǝ. <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />Langkwoi kwɔ ɓa yam, ɓa muou, bakwɔ lo nyi ɓǝ ɓko ɗing; dǝ ɓa yam i nungkwɔ ɓa tolǝ nung to babǝ lǝ tthǝla ɓǝ. <verse eid="JAS 4:3" /><verse number="4" style="v" sid="JAS 4:4" />Yayuu kwɔ bǝ dǝnyitthǝ gi yangǝu ɓǝ! Ɓa ibǝi kwɔ bǝ to ǝnthǝ i longwam ǝn bǝ ǝǝlǝ ɓui gi Fuh lǝu? Nǝ dǝmma yiɗi bǝ ǝǝlǝ ǝnthǝ longwam kwɔ, dǝmma mǝrrǝm lǝ ya ɓui gi Fuh. <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />Bǝ ɓa nhǝm ɓangǝ ba a langǝ i yangǝu dang nungvullǝ bagi Fuh kwɔ gei angǝ, &lt;&lt;ɓyang kwɔ Fuh dǝ tthǝɓi kwɔ dǝna yiɗi bǝ tthǝngbǝi ɗing.&gt;&gt; <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />Kwoi nung a langǝ i kwɔ Fuh dǝna dǝkwɔ nyim ɗing. Manungkwɔ nungvullǝ bagi Fuh gei kwɔ angǝ, &lt;&lt;Fuh dǝna la ya lo angǝ a, kwoi dǝna dǝ nung a langǝ i lǝ ya ɓuob lo sua.&gt;&gt;<verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />Nungkwɔ yang, ɓa dǝ loɓǝ lǝ Fuh. Ɓa la Mungkullum, u padum u yiɓǝ. <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />Ɓa wɔ ɓa gɓag Fuh, langkwoi u wuo u gbag ɓǝ. Ɓa ɗiggǝ naɓǝ, ɓǝ ya nung a ɓko! Ɓa ɗiggǝ lo nyi ɓǝ, ɓǝya pǝllǝ! <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />Ɓa ɓanglǝ dang wa, ɓa tasui, ɓa ɓuobnwa; ɓa mǝrǝm mam ɓǝ lǝ sui, tthǝla ɓǝ lǝ ɓanglǝ dang wa! <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />A ɓuob lomǝ sua tthasi Dangbang, langkwoi u lǝia wayi.<verse eid="JAS 4:10" /></para>
  <para style="s">Bǝ Gub Ɗuogsui Lobǝ To Kwanlǝ Tha</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />Ya youngǝm, bǝɓa geiba lotha thǝ. Nǝ a geiba ko ato kwan lǝ Krista akun, yang a geiba langkwoi ato kwan lo zuu. Nǝ ato kwanlǝ zuu, yang mǝ ǝnya to nungto i zuu lǝu, kwoi ǝn yuu akwɔ dǝna to kwanlǝ zuu ɓǝ. <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />Fuh ɓuo kun lǝ ya dǝ zuu langkwoi yato kwan. U ɓuo u ɓuan u nwong langkwoi u ɓanglǝ. Dǝmma nhǝm mangǝ mǝ ǝn yittǝnna, kwɔ ma to kwan lǝ yuu akun ɓa?<verse eid="JAS 4:12" /></para>
  <para style="s">Bǝ Gug Ɗuogsui Lobǝ Lǝilo</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />Lakwɔ ɓa lǝm, mǝkwɔ dǝmma gei mangǝ, &lt;&lt;Ɗiggǝ ko bung ɓi tǝ yol gwoi angǝ a akun, ɓi ǝǝ bǝilǝ ttha kun yang ɓi to nung lomu langkwoi ɓi gǝm nungkurɓǝ kpaatthǝ.&gt;&gt; <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />A ibǝi kwɔ nwongǝi mǝ bung a ǝǝ nǝ na kwɔ a ibǝi lǝu! Mǝ mangǝ ǝn du, kwɔ fuk natthǝ tuab yang la nǝkwam ɓǝ. <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />Nungkwɔ ma gei kwɔ nungɓǝlǝ: &lt;&lt;Nǝ Dangbang gwab bǝng yang, ɓi ǝǝ i nwongǝi langkwoi ɓi to nung manungkwɔ ni ko nung kullo.&gt;&gt; <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />Kwoi lakwɔ dǝmma lǝi lomǝ, langkwoi dǝmma fog; bǝ foggǝi kwɔ ǝn bǝ gal nung.<verse eid="JAS 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17" />Nungkwɔ yang, nǝ ɓi to nung a langǝ i kwɔ ɓi ibǝi kaso ɓi toɓǝ lǝu, nung a ɓko muo ɓing.<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s">Bǝ Gub Ɗuogsui Loya Nungtǝi</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />Langkwoi lakwɔ, ɓǝ ya nungtǝi ɓalǝm! Ɓa tasui ɓa ɓuob nwa lo nung zii bǝi kwɔ dǝna wɔ loɓǝ ɓǝ! <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />Nungtǝi ɓǝ zuu ǝndǝing, langkwoi zǝɓyang tang nunglitthǝ ɓǝ. <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />Zinariya ɓǝ i azurfa ɓǝ o gwom ǝndǝi, langkwoi bǝ o gwom kwɔ nungɓǝ lǝ shǝdǝ loɓǝ lǝ langkwoi a tang sual tthǝ ɓǝ mangǝ ǝn lua. Ɓa gǝm nungtǝi vii a nǝsua kwɔ. <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />Ɓa kwai nung busoni yakwɔ toɓǝ nung to tthǝ zukɓǝ ɓǝlǝu. Ɓalǝ dǝi tasui loɓǝ! Sui yakwɔ ɓǝr min zukɓǝ kwɔ tǝ ɓuasui Fuhng, Dangbang Ya angǝ a. <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />Ɓa ǝǝ longwam kwɔ dang tthǝla ibǝ ɓanglǝ nungtǝi. Ɓa ttha nyiɓǝ ghaatthǝ ba vii vuubǝi. <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />Ɓa ɓanglǝ langkwoi ɓa thǝb ya langǝ i, langkwoi i laɓǝ lǝu.<verse eid="JAS 5:6" /></para>
  <para style="s">Bǝ Tthǝb Nyitthǝ I Bǝ Pinwa</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />Ya youngǝm, ɓa tthǝb nyitthǝ, nǝ Dangbang wuo ɗǝ. Ɓa ɓyǝa bǝ tthǝb nyitthǝ ya nung lǝbbi kwɔ i ki pangsua gi wuolǝ nungbyǝa matthǝ. Dǝi ki mungki thalǝu dang ɗuong ibǝ tthǝb nyitthǝ. <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />Ɓǝ langɓǝ ɓa tthǝb nyitthǝ. Ɓa dǝi nyimtthǝ, bakwɔ viikwɔ Dangbang dǝna wɔtthǝ kwɔ gbagǝng.<verse eid="JAS 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9" />Ya youngǝm, bǝɓa gei ba lotha thǝ, yangbǝ bǝ Fuh toɓǝ kwan tthǝ thǝ. Yato kwan gbagǝng, u dǝi nwa kǝm. <verse eid="JAS 5:9" /><verse number="10" style="v" sid="JAS 5:10" />Ya youngǝm, ɓa nhǝm ya gei ba a tthasi kwɔ gei ba dang ɗuǝn Dangbang ɓǝ. Ɓa lǝi lǝ nungkwɔ ɓa na lobǝ tthǝb nyitthǝ nyimnyi dang zuii. <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />Dǝɓi lubǝi lǝ ya lǝ tthǝla bakwɔ i nyimnyi ɓǝ. Ɓalǝ bǝ tthǝb nyitthǝ gi Ayuba, langkwoi ɓa ibǝi kwɔ Dangbang du nung nǝsua ǝndǝi ɓǝ. Ba kwɔ Dangbang ǝnya ɓyǝa nungzuii i ya lǝi i tthǝlǝ.<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />Ya youngǝm, lo nung ǝndǝi, bǝ a zuu nung thǝ kwɔ nǝ dǝmma gwabnwa nung ɓǝ. Bǝ a zuu nung wayi thǝ ko i pangsua ko i nung akun nǝkwam. A gei mangǝ &lt;&lt;Ni&gt;&gt; ɓuo kwɔ nǝ dǝmma gei mangǝ niɓǝ, langkwoi nilǝu, langkwoi yang kwan gi Fuh muko.<verse eid="JAS 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />Yakun dang ɓǝ dang zuii? I pinwa. Yakun dang ɓǝ dǝna lǝ tthǝla? I lub ɓin khabǝi. <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />Yakun tthǝ dang ɓǝ tthǝi lawa? I tumbǝi sua yakku kǝm pinwa, yakwɔ a pinwa tthǝ langwkoi i al nui zaitun tthǝ loi dang ɗuǝn Dangbang. <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />Bǝ pinwa kwɔ i pi dang bǝ dǝnyitthǝ kwɔ a dǝ tthǝla lǝya nungzii; Dangbang a kwoilǝ tthǝla gi a ji, langkwoi fuh a al nung a ɓko kwɔ i to kwɔ lǝtǝ. <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />Nungkwɔ yang, i gei nwa nung a ɓko gilǝ thatthǝ, yangbǝ i tǝi tthǝla. Bǝ pinwa ya langǝ i to nung to nyimɗing. <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />Iliya ǝn yuu manung aɓi. U pinwa dang wa kun angǝ bǝ mung nathǝ, langkwoi mung nalǝu pangsua ttha tǝi i fih nanakun. <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />U pinwa akun, langkwoi wayi na mung langkwoi pangsua wɔlǝ nungbyǝa.<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />Ya youngǝm, nǝ yuu akun dang ɓǝ la ba a langǝ i langkwoi yuu akun kwoilǝ wuolǝ langkwoi, <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" />ɓa nhǝm nungkwɔ: yuu kwɔ kwoilǝ ya nung a ɓko lo nunglǝi a ɓko gu u nwong kilǝng yato nung a ɓko kwɔ bǝ ɓui ɓua langkwoi wuolǝ bǝ al nung a ɓko kpaatthǝ.<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>