<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="toc1">Ba A Langǝ i Nwa Luka</para>
  <para style="toc2">Luka</para>
  <para style="toc3">Lk</para>
  <para style="mt2">Ba A Langǝ i Nwa Luka</para>
  <para style="mt1">Luka</para>
  <para style="imt">Bǝ Gabnung Ba</para>
  <para style="ip">Ba gi Fuh nwa Luka ghai ba lo Yeso i bǝ gwab nwa ba bǝ soblo gu lǝ ya Israila tthǝ langkwoi lǝ ya soblo yayuu ǝndǝi. Luka vullǝ angǝ ya nwatummi lubǝ Yeso lǝ Dangbang yang &lt;&lt;bǝ wullǝ ba a fuu lǝ sua yakwɔ ǝn ya yiɓau ɓǝ,&gt;&gt;langkwoi ba gi Fuh dǝi nyimtthǝ lǝ ba yayuu tthǝ ǝndǝi kwɔ dǝna yiɗi ɓǝ. Nungvullǝ babǝ lǝ tthǝla langkwoi nyimtthǝ dang Luka, dǝilo ǝndǝi tthǝ bǝ ɓko ba kwɔ i ghai nwko lǝ ba bǝ wuu gi Yeso, langkwoi dang bǝ alo ǝndǝi, kwɔ Yeso ǝrrlǝ tǝllǝ wayi ɓǝ. Tthǝ ba ghaali aku langkwoi i ba bǝ kpaali gi ya dǝ ba a langǝ i ya Kristǝ tthasua bǝ ǝrri gi Yeso i ghai nwko dang nungvullǝ gi Nung to ya Nwatumi. Dang nung 2 langkwoi i a 6 ( aɓya dang nung a pangsua) i tǝi ba ɓǝ kpaaɗing dang nungvullǝ ba gi Fuh, manung gi nwa ba kwɔ i gei dang ɓiin ya nwatummi i ya gagci nyak kwɔ i wuo bǝ gumbǝi vii kwɔ i si Yeso tthǝ ɓǝ, vikwɔ Yeso lǝ yui a ɓoi dang kǝm pinwa lǝ ɓǝ, langkwoi i bǝ gei ba a pyapya a langǝhi lo ya Samariya i Yui a kwɔ lala ɓǝ. Dang ba gi Fuh ǝndǝi ba angǝ a ǝndǝi tthǝ lo ba bǝ pinwa, Ya Yɓyang, nungto yasi dang nungto gi Yeso, langkwoi i bǝ alnung aɓau kwɔ gi yayuu kwɔ Fuh a alǝtǝ ɓǝ.</para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="s">Bǝ Baipiu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />Ənthǝm Tkofilis:</para>
  <para style="p" vid="LUK 1:1">Yayuu kpaatthǝ ɗuong nungǝing ba bǝ vullǝ nung lǝba nungkwɔ to nung dang ɓiɓǝ. <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />I vullǝ nungkwɔ i gei ɓitthǝ nwa yakwɔ ɓyǝa nungɓǝkwɔ la nwasiu i ya thǝb nwaba Fuh kwɔ gei ba ɓǝkwɔ ɓe. <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />Ən baɓǝkwɔ, lakwɔ Yikku Tiyofalas ǝn ɓib balo tǝmtǝm matthǝ la nwasiu, maɗing tthǝm lǝ ǝn vullǝnung lolǝ lǝ bamǝ, <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />yangbǝ a ibǝi ba a langǝ i lo nungkwɔ i nanatthǝ ɓǝ.<verse eid="LUK 1:4" /></para>
  <para style="s">Nwaba Bǝ Si Yohanna Ya wollmung</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />Lona kwɔ Hiridus lǝ yigwoi ya lo sua Yahudiya, ya nyǝknung akun tthǝ ɗuǝnu lǝ Zakariya, u dang ya nyǝknung Abaija; siu Alisabatu langɓǝ ya bǝpi gi Haruna. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />I ǝndǝi dǝnni muo sua Fuh dang wa kun, dǝnni dǝ kiggǝi la langǝ i tthǝ nung zuu Dangbang dǝnni to nung a langǝ i i yangǝu i nung a ɓko tthasi Fuh lǝu. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />I si yathang lǝu, bakwɔ Alisabatu ǝn dǝgǝm; langkwoi yisi ɓǝ i ɓǝiu i ǝndǝi kuu ɗing.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />Vii a kun lǝ yayuu gi Zakariya lo nung to nyǝknung langkwoi Zakariya dǝna to nung to dang kǝm pinwa tthasi Fuh. <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />Ənchǝl mko Zakariya, dang yayuu manungkwɔ lǝ nung to ya nyǝknung ɓǝ, Nungkwɔ u tǝ dang kǝm nyǝnung tthǝ Dangbang u li turare kwɔ kummu la tthǝɓǝ. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />Lona bǝ li turare kwɔ kummu latthǝ kwɔ wuo, kon ya wab Fuh gǝmtha dǝna pinwa gwam.<verse eid="LUK 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11" />Ya nwatummi gi Dangbang fuk tthǝu, dǝi lona nali bǝi kwɔ dǝnni nyǝknung tthǝɓǝ. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />Kwɔ Zakariya ɓyǝko ni, kiggǝu ǝrr tthǝu tǝbǝ survulli. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />Kwoi ya nwatummi geiu angǝ: &lt;&lt;Zakariya! Ba survulli thǝ, Fuh lǝbǝ pinwa mǝng. Alisabatu simǝ a siǝ yuitthǝ lǝ yiɓǝi yang ma duu ɗuǝn lǝ Yohanna. <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />U da tthǝlla ghaatthǝ, langkwoi yayuu kpaatthǝ a lǝ tthǝla bǝ si gu! <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />Yohanna a mǝrrǝm lǝ ya angǝ a tthasi Dangbang. Bǝ u nwa min i nung a nwanwa a nyimmi thǝ. Langkwoi Ɓyang a Langǝ i a ǝǝ i ulǝ vii kwɔ i siu tthǝɓǝ. <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />Langkwoi u kwoi lǝ ya Israila kpaatthǝ u wulǝ sua Dangbang Fuh gi. <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />Langkwoi u osi lǝ Dangbang, nyimtthǝ lang ghaatthǝ mangǝn ya gei ba a tthasi Iliya, tǝu mab ganglang ya Daa i yathang gi; langkwoi yakwɔ dǝ ba a langǝ i tthǝ Fuh lǝu kwɔ a baipi bǝ nhǝm babǝ to nung a langǝ i tthasi Fuh; u mab yayuu gi Dangbang matthǝ u dǝ.&gt;&gt;<verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />Zakariya gei ya nwatummi gi Fuh angǝ,&lt;&lt;Mǝn to nǝnǝ mǝn ilǝbǝi nungkwɔ manungɓǝ? Ɓang ǝn baba, langkwoi sim kuǝng langɓǝ ɓa.&gt;&gt;<verse eid="LUK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19" />Ya nwatummi ɓǝ gwab nwa angǝ,&lt;&lt;Ɓang ǝn Jibra'ilu. Dǝmǝn dǝi tthasi Fuh, kwɔ tummǝm tthǝmǝ angǝ ǝn gei nwaba a langǝ i kwɔ tthǝ. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />Kwoi a dǝba a langǝ i tthǝ nwabam lǝu, kwɔ wa ǝǝlǝ ba a langǝ i lona a langǝ i. Bakwɔ a dǝba a langǝ i tthǝ lǝu, a ɓuan a gei bko; ma kǝrna nǝkwam a tǝllǝ vii kwɔ nungkwɔ a ǝǝlǝ ba a langǝ i ɓǝ.&gt;&gt;<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />Lona lǝ kullo yayuu dǝna ki Zakariya langkwoi dǝi gei angǝ ǝn baɓǝ bǝ tǝu lasua tuuni dang kǝm nyǝknung la. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />Kwɔ u igwam, u ɓuan u gei ba lǝu, i ibǝi angǝ u ɓyǝa nung dang kǝm nyǝknung lǝng. Dǝnnu gei ba i na u ɓuan u gei bko.<verse eid="LUK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23" />Kwɔ lona nung to gu kǝm Nyǝknung alo, Zakariya kwoi suo tǝ gwoi. <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />Tthasua nungkwɔ siu Alisabatu lǝi wa fyi nu u igwammu dǝnnu pya. <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />Alisabatu gei angǝ, &lt;&lt;Lakwɔ nǝsua ǝndǝi Dangbang tom nungkwɔ tthǝ, Dangɓǝ lǝ kwɔ Dangbang tom nyitǝmmi langkwoi u ilǝ tthǝkkum dang yayuu.&gt;&gt;<verse eid="LUK 1:25" /></para>
  <para style="s">I Gei Nwaba Bǝ Si Yeso</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />Wa gi Alisabatu fyi a nanakun, Fuh tum ya nwatummi gu Jibra'ilu tǝ Nazarat, gwoi angǝ a kwɔ dang Galili ɓǝ, <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />u tǝlǝ nwatummi lǝ sua munthang a yisi kwɔ i yiɓǝi lǝu kwɔ ɗuǝnnu ǝn Maryamu dǝnnu tǝbǝ dǝb yiɓǝi akun tthǝ ɗuǝnnu ǝn Yusufu, ya bǝpi gi Dawuda. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />Ya nwatummi gi Fuh tǝ suo tǝ geiu angǝ,&lt;&lt;Dǝm gumbǝi, mǝkwɔ Dangbang khana lo mǝ ɓǝ! Fuh i mǝ.&gt;&gt;<verse eid="LUK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29" />Kiggǝ Maryamu ǝrr ghatthǝ lo bagu langkwoi dǝna nhǝm bǝ gumbǝi a ɓǝnni. <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />Kwoi ya nwatummi gi Fuh geiu angǝ,&lt;&lt;Ba survulli thǝ, Maryamu, Fuh lǝ tthǝla mǝng. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />Ma lǝi wa ma si yui lǝ yiɓǝi, yang ma du ɗuǝn lǝ Yeso. <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />U ǝlǝ ya angǝ a i luu ɗuǝnnu lǝ Yui Fuh Ya angǝ a. Dangbang Fuh a du bǝ lo yigwoi manung a bǝ bǝba gu Dawuda, <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />U lo yigwoi lo ya Bǝba gi Yakubu laɗing, bǝ lo yigwoi gu thǝmmu.&gt;&gt;<verse eid="LUK 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34" />Maryamu ɓib ya nwatummi ɓǝ angǝ,&lt;&lt;Nungkwɔ a to tthǝ nǝnǝ lakwɔ? Lakwɔ ǝn i yiɓǝi lǝu ɓa?&gt;&gt;<verse eid="LUK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35" />Ya nwatummi ɓǝ gwab nwa angǝ,&lt;&lt;Ɓyang a Langǝ i a wɔutthǝ, langkwoi ttha Fuh ya angǝ a a wɔ lomǝ. Yang yuu kwɔ nung a ɓko gu yangǝu kwɔ siu kwɔ i lu ɗuǝnnu angǝ Yui Fuh. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />Alisabatu ya bǝpi mǝ a si yui dang kuuli gu, yayuu dǝna gei angǝ u ǝǝn dǝgǝm kwɔ kwoi lakwɔ u i wa fyi nanakun. <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />Nung akun yangǝu kwɔ Fuh ɓuan tou ɓǝ.&gt;&gt;<verse eid="LUK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38" />Maryamu gei angǝ, &lt;&lt;Ɓang thǝb gi Dangbang, kaso to manungkwɔ a gei ɓǝ.&gt;&gt;Nungkwɔ ya nwatummi gi Fuh pa yiu.<verse eid="LUK 1:38" /></para>
  <para style="s">Maryamu Tǝsua Alisabatu</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />Lona lǝ kullo Maryamu ǝrr thǝmtthǝ thko pa lǝi losua angǝ a gwu ɓǝmtal Yahudiya. <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />Bǝilǝ kwɔ u tǝ gwoi gi Zakariya tǝu gum Alisabatu. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />Kwɔ Alisabatu lǝ bǝ gumbǝi gi Maryamu ni, yui kwɔ dang wko kwɔ mǝrrǝm natthǝu, Ɓyang a Langǝ i khanalo Alisabatu. <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />Alisabatu gei ba i yoll angǝ: &lt;&lt;Ya khana lo ǝn mǝ dang yasi lǝ, langkwoi bǝ khana lo yui a langǝ i kwɔ ma siɓǝ! <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />Kwoi ǝn Baɓǝ bǝ i yiɗim ni, kwɔ naa gi Dangbangǝm a wɔ suam? <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />Dangtthǝ kwɔ ǝn lǝ yoll gumbǝi mǝ ɓua suim, yui kwɔ dang wam kwɔ mǝrrǝm natthǝu i tthǝla. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />Bǝ khana lo yisi kwɔ dǝba a langǝ i tthǝ nungkwɔ Dangbang gei lo kwɔ a mǝrrǝm lǝ a langǝ i!&gt;&gt;<verse eid="LUK 1:45" /></para>
  <para style="s">Ɓin Khabǝi Gi Maryamu</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />Maryamu gei angǝ:</para>
  <para style="q1" vid="LUK 1:46">&lt;&lt;Nyim dǝna dǝ angǝ a lǝ Dangbang;<verse eid="LUK 1:46" /></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47" />nyim dǝna lǝ tthǝla ba Fuh ya nwongǝm,<verse eid="LUK 1:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48" />bakwɔ dǝnnu dǝ kiggǝ</para>
  <para style="q2" vid="LUK 1:48">ya thǝb gu a tuab ɓǝ!</para>
  <para style="q1" vid="LUK 1:48">Baipiu lakwɔ nikwɔ yayuu ǝndǝi a lubǝim lǝ yuu kwɔ i khana lo ɓǝ,<verse eid="LUK 1:48" /></para>
  <para style="q2">
    <verse number="49" style="v" sid="LUK 1:49" />Bakwɔ Fuh ya angǝ a tom nung angǝ a tthǝng.</para>
  <para style="q1" vid="LUK 1:49">Ɗuǝnnu ǝn a langǝ i.<verse eid="LUK 1:49" /></para>
  <para style="q2">
    <verse number="50" style="v" sid="LUK 1:50" />Bǝ ɓyǝa nungzuii gu tǝ i yakwɔ dǝna surru ɓǝ,</para>
  <para style="q2" vid="LUK 1:50">baipiu dang wam akwɔ mullǝ dang wam akulo.<verse eid="LUK 1:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51" />U to nung angǝ a i nko lǝ;</para>
  <para style="q2" vid="LUK 1:51">u yǝb ya lo angǝ a i bǝ nhǝm ba dang nyiǝ ɓǝ.<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />U pinlǝ ya yigwoi lo nung ǝǝ gi,</para>
  <para style="q2" vid="LUK 1:52">u dǝ ya nyitǝmmi bǝ lo yigwoi.<verse eid="LUK 1:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53" />U dǝ wa fǝrri lǝ ya gwom i nung a langǝ i,</para>
  <para style="q2" vid="LUK 1:53">kwoi u nan ya nungtǝi na nǝkwam.<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54" />U nwong thǝb gu Israila,</para>
  <para style="q2" vid="LUK 1:54">dǝnnu nhǝm ya nyitǝmmi lǝ,<verse eid="LUK 1:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55" />manungkwɔ Fuh gwabnwa lǝ Ibrahim i ya bǝpi gu laɗing,</para>
  <para style="q2" vid="LUK 1:55">manungkwɔ u gei lǝ ya bǝba ɓitthǝɓǝ,&gt;&gt;<verse eid="LUK 1:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />Maryamu ǝǝ i Alisabatu fyi tai nwuni bǝ u kwoi u tǝ gwoi.<verse eid="LUK 1:56" /></para>
  <para style="s">Bǝ Si Yohanna Ya Wollmung</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />Kwɔ lona wɔ kwɔ Alisabatu a si kwɔ, u si lǝ yiɓǝi. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />Ya nwalǝgwoi gu i yayuu gu lǝ angǝ Dangbang tǝm lo nyi tthǝu, i ǝndǝi lǝ tthǝla i ulǝ.<verse eid="LUK 1:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59" />Yui ɓǝ lo bo Ngunai, i wuo bǝ ɓǝrnwa ɗuǝu, dǝnni tǝbǝ duu ɗuǝn Daa gu Zakariya, <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />Kwoi na gu Alisabatu gei angǝ,&lt;&lt;Nilǝu! I lu ɗuǝnnu angǝ Yohanna.&gt;&gt;<verse eid="LUK 1:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61" />I geiu angǝ, &lt;&lt;Ɗuǝn kwɔ yangǝu dang ya bie ɓǝu!&gt;&gt;<verse eid="LUK 1:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 1:62" />Nungkwɔ i gei ba lǝ daa gu i na, yangbǝ i ɓibbu ɗuǝn yui ɓǝ. <verse eid="LUK 1:62" /><verse number="63" style="v" sid="LUK 1:63" />Zakariya ɓib pi nungvullǝ nung, lo yayuu kwɔ bǝilǝ kwɔ fǝmtthǝ nungkwɔ u to ɓǝ lǝ bǝ vullǝ ɗuǝn yui ɓǝ angǝ,&lt;&lt;Ɗuǝnnu ǝn Yohanna.&gt;&gt; <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />Lona lǝkullo Zakariya tǝbǝ gei ba langkwoi, dǝu kha Fuh. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />Tthǝ vulli muo ya nwakong gi, langkwoi nwa baɓǝ lǝilǝ losua Yahudiya kwɔ dang tal kwɔ ǝndǝi. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />Yuu kwɔ ǝndǝi nǝ lǝ baɓǝ yang nhǝm ba lo, dǝna ɓib angǝ,&lt;&lt;Yui kwɔ wa mǝrrǝm lǝng ɓa?&gt;&gt;Kai nǝkwam na Dangbang tthǝu lǝ.<verse eid="LUK 1:66" /></para>
  <para style="s">Bǝ Gei Ba A Tthasi Gi Zakariya</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />Ɓyang a Langǝ i tthǝ daa gu Zakariya ɗing, nungkwɔ u gei ba a langǝ i Fuh angǝ:<verse eid="LUK 1:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />&lt;&lt;Bǝ khabǝi ǝn a bǝ Dangbang, Fuh ya Israila!</para>
  <para style="q2" vid="LUK 1:68">Bakwɔ u wuo wu nwong yayuu gu ɓǝ.<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />U wuɓilǝ ya nwongbǝi tthǝ ghaatthǝ,</para>
  <para style="q2" vid="LUK 1:69">ya bǝpi gi thǝb gu Dawuda,<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />(manungkwɔ u gei nwa ya gei ba a tthasi gu ya langǝ i lakuu),<verse eid="LUK 1:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71" />angǝ i nwong ɓi na yakwɔ ɓui ɓiɓǝ,</para>
  <para style="q2" vid="LUK 1:71">langkwoi na yakwɔ dǝna la ba ɓiɓǝ.<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />Lǝ bǝ ɓyǝa nungzuii ya Daa ɓi</para>
  <para style="q2" vid="LUK 1:72">langkwoi bǝ u nhǝm gang lang gu i ya bǝba ɓi a langǝ i,<verse eid="LUK 1:72" /></para>
  <para style="q2">
    <verse number="73" style="v" sid="LUK 1:73" />nung zuu kwɔ u zuu i Daa ɓi Ibrahim:<verse eid="LUK 1:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74" />lǝ bǝ iɓilǝ dang na ya ɓui ɓiɓǝ,</para>
  <para style="q2" vid="LUK 1:74">yangbǝ ɓi wabbu tthǝvulli yangǝu,<verse eid="LUK 1:74" /></para>
  <para style="q2">
    <verse number="75" style="v" sid="LUK 1:75" />yangbǝ ɓi ǝǝ dang wa a langǝ i i nung a langǝ i tthasiu vii ɓi ǝndǝi.<verse eid="LUK 1:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />&lt;&lt;Langkwoi mǝ, yuim, i lubǝi mǝ lǝ ya gei ba a tthasi gi ya wayi;</para>
  <para style="q2" vid="LUK 1:76">bakwɔ ma osi Dangbang yangbǝ a mabbu nunglǝi tthǝ,<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />lǝ ba bǝ geilǝ yayuu gu tthǝ angǝ i nwongǝi</para>
  <para style="q2" vid="LUK 1:77">nunglǝi bǝ al nung a ɓko gilǝtǝ,<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />Fuh ɓi da ɓyǝa nungzuii.</para>
  <para style="q2" vid="LUK 1:78">U gab bǝi tthǝɓi mangǝn fuh kwɔ da ɗab wayi ɓǝ<verse eid="LUK 1:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79" />lǝ bǝ gabǝi lo yakwɔ ǝǝ dang bǝthǝl</para>
  <para style="q2" vid="LUK 1:79">langkwoi dang killǝng ɓua,</para>
  <para style="q1" vid="LUK 1:79">yangbǝ u oɓi lǝ si nunglǝi a langǝ i&gt;&gt;<verse eid="LUK 1:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />Yui ɓǝ a ghaa langkwoi u nyim i Ɓyang a Langǝ i; u ǝǝ losua a kwi bǝikwɔ kab tuabtuab ɓuo nung yangǝu dǝna ghaa tthǝɓǝu tǝllǝ vii kwɔ u fuk gwam dang ya Israila ɓǝ.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s">Bǝ Sigi Yeso</para>
  <para style="r">(<ref loc="MAT 1:18-25">Matthew 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />Lona lǝ kullo yigwoi angǝ a Kaisar Agustus dǝba angǝ i than yayuu losua Roma ǝndǝi. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />Nungkwɔ lǝ bǝ than yayuu a nwasiu kwɔ i than vii gi Kirniyas lǝ yikku losua Suriya. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />Yaɓa ǝndǝi kwoi tǝ gwoi gi yangbǝ tǝi thanni.<verse eid="LUK 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4" />Nungkwɔ Yusufu ǝrr dang losua angǝ a ya Nazarat dang losua Galili tǝ Baitalami dang Yahudiya, bǝikwɔ i si yigwoi Dawuda tthǝɓǝ. Yusufu tǝ bǝiɓǝ bakwɔ u ǝn bie Dawuda ɓǝ. <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />Yusufu tǝbǝ than lo i Maryamu, yamsigu kwɔ a dǝbbu ɓǝ. Maryamu i wa lǝ, <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />Langkwoi kwɔ yirrǝ i Baitalami lǝ, lona wɔ kwɔ u si yui ɓǝ. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />Maryamu si yui a nwasiu lǝ yiɓǝi. U katthǝu i landa u dǝ yui ɓǝ dang kwai nwamung nungbyang- i tǝi kǝm lolo lǝu gwoi yayol.<verse eid="LUK 2:7" /></para>
  <para style="s">Ya Gagci Nungbyang I Ya Nwatumi Gi Fuh</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />Yakun dang ya gagci nungbyang tthǝ lo gbag losua ɓǝ nung pangbǝi, dǝnni ki nungbyang gi. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />Ya nwatummi gi Dangbang fug tthǝilǝ, ghaali gi Dangbang gabtthǝilǝ, tthǝvulli mui ghaatthǝ, <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />Kwoi Ya nwatummi ɓǝ gei angǝ,&lt;&lt;Bǝɓa survulli thǝ! Ən wuo bǝ geiɓǝ nwaba a langǝ i tthǝ, kwɔ a wɔ lǝ tthǝla lǝ yayuu tthǝ ǝndǝi ɓǝ. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />Ɗiggǝ kwɔ gwoi angǝ a Dawuda i si ɓǝ yuitthǝ lǝ ya nwong lo; ulǝ Yeso kristi Dangbang! <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />Nungkwɔ lǝ nungkwɔ ɓa ilǝbǝi ɓǝ: &lt;&lt;Ɓa tǝi yui a ɓuoi i katthǝu i tǝrnung dang kǝm nungbyang.&gt;&gt;<verse eid="LUK 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13" />Dangtthǝ ni sua tuu lǝu yang kon ya taɓui wayi i ya nwatummi gi Dangbang wuo fug dǝi kha Fuh dǝi gei angǝ,<verse eid="LUK 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14" />&lt;&lt;Ghaali gi Fuh wayi,</para>
  <para style="q2" vid="LUK 2:14">langkwoi i pangsua tǝm lonyi yayuu kwɔ dǝu ɓyǝa nungzuii gi ɓǝ.&gt;&gt;<verse eid="LUK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />Kwɔ ya nwatummi ɓǝ kwoi suai tǝ wayi, ya gagci nungbyang ɓǝ gei lǝ thatthǝ angǝ,&lt;&lt; Ɓi tǝ Baitalami tǝɓi ɓyǝa nungkwɔ to nung ɓǝ, kwɔ Dangbang gei ɓi bko tthǝɓǝ.&gt;&gt;<verse eid="LUK 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16" />Nungkwɔ i thko thǝmtthǝ tǝitǝi Maryamu i Yusufu, i yui a ɓuoi lǝ, kwɔ i duu dang kǝm nungbyang ɓǝ. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />Kwɔ i ɓyǝa Yeso ni i gei nwa baɓǝ logbǝi ǝndǝi lǝ ba nungkwɔ i lǝɓǝ lǝ ba yui ɓǝɓǝ, <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />Ya kwɔ ǝndǝi lǝ bakwɔ yang lo na fǝm lǝ bakwɔ ya gagci nungbyang kwɔ gei tthǝɓǝ. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />Maryamu dǝ nungkwɔ i gei ɓǝ ǝndǝi dang wko lǝ. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />Ya gagci nungbyang ɓǝ kwoi suai, dǝi dǝ angǝ a lǝ Fuh dǝi khko lǝ ba nungkwɔ i lǝ ɓǝ lang i ɓyǝa ɓǝ, manungkwɔ i gei tthǝɓe.<verse eid="LUK 2:20" /></para>
  <para style="s">Bǝdǝ Ɗuǝn Yeso</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />Lobo ǝngunnai, lona tobǝ ɓǝrnwa ɗuǝu, i duu Ɗuǝn lǝ Yeso, Ɗuǝn kwɔ Ya nwatummi duu nwunni bǝ i lǝi wa gu ɓǝ.<verse eid="LUK 2:21" /></para>
  <para style="s">I Tǝlǝ Yeso Lǝ Kǝm Nyǝknung</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22" />Viikwɔ lonǝ bǝ ɗiggǝ nung a ɓko gi to manungkwɔ nung zuu gi Musa nanatthǝ ɓǝ, Yusufu i Maryamu i lǝi yui ɓǝ i tǝlǝ Urshalima i duu lǝ Dangbang <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />Manungkwɔ i vullǝ dang nung vullǝ gi Dangbang angǝ,&lt;&lt;Nwasi yui a yiɓǝi i dulǝ Dangbang u ǝn a langǝ i.&gt;&gt; <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" />Langkwoi i tǝbǝ nyǝknung gko rab ko yathang gko gwoi, manungkwɔ nung zuu gi Dangbang gei ɓǝ.<verse eid="LUK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25" />Lona lǝ kullo yiɓǝi akun tthǝ Urshalima ɗuǝnnu ǝn Saminu, yuu a langǝ i ya surr Fuh. Dǝu ki Fuh kwɔ a tǝm lo nyi ya Israilawa ɓǝ. Ɓyang a Langǝ i i ulǝ. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />Ɓyang a Langǝ i gǝu angǝ u ɓuiu nǝ u ɓyea Dangbang yui Fuh Kristi ɗǝ. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />Ɓyang a Langǝ i oulǝsi, Saminu tǝ dang kǝm Nyǝknung. Kwɔ daa gi Yeso i naa gu wulǝ lǝ Yeso munthang ɓǝ dang kǝm pinwa manung kwɔ nung zuu gi gei ɓǝ, <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />Saminu lǝi yui ɓǝ dang na kha Fuh, dǝu gei angǝ:<verse eid="LUK 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29" />&lt;&lt;Dangbang ya nung ǝndǝi, manungkwɔ a gwab nwa,</para>
  <para style="q2" vid="LUK 2:29">lakwɔ a yǝrnwa lǝ thǝb mǝ dang nyitǝmmi.<verse eid="LUK 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30" />Lakwɔ nungǝm ɓyǝa nungkwo a to lǝ ba bǝ nwong yayuu mǝ ɓǝng,<verse eid="LUK 2:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31" />kwɔ a mab dang nung yayuu ǝndǝi ɓǝ,<verse eid="LUK 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32" />Nung gabbǝi yangbǝ tanatthǝ nungkwɔ dǝmma yiɗi lǝ yakwɔ ǝn ya Yahudawa lǝu ɓǝ</para>
  <para style="q2" vid="LUK 2:32">yangbǝ wulǝ ghaali mǝ lǝ ya Israila tthǝ.&gt;&gt;<verse eid="LUK 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />Daa gi yuiɓǝ i naa gi yui ɓǝ loi fǝmlǝ bakwɔ i gei loɓǝ. <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />Yang Saminu khana loi u gei Maryamu, naa gu angǝ:&lt;&lt;Yui mǝ kwɔ a to yakun a lagǝi yakun i bǝ sob lo gi yayuu kpaatthǝ dang ya Israila. U ǝrr lǝ killǝng bǝgǝ Fuh kwɔ yayuu kpaatthǝ a gei ba tthǝɓǝ. <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />Yangbǝ ba dang wa yayuu kpaatthǝ fug gwam. Langkwoi ba a ɓko a fǝl nyimǝ langɓǝ mangǝn khafǝi.&gt;&gt;<verse eid="LUK 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36" />Langkwoi ya gei ba a tthasi a yisi tthǝ kwɔ u kuǝng ɗuǝnnu ǝn hanatu, yui gi fanuyila, ya kabgwoi gi Ashiru. U dǝbgwoi ttha nanaira ɓuo i ɓǝiu <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />langkwoi u ǝn siɓui tthko 84. U yitthǝ kǝm nyǝknung lǝu; dang fuh i nungvii dǝu kha Fuh, dǝnnu zuu fuh dǝu pinwa. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />Lonalǝ kullo u wuo wuu dǝ angǝ a lǝ Fuh langkwoi u gei ba gi yui ɓǝlǝ yakwɔ dǝna ki Fuh kwɔ a ilǝ Urshalima dang zuii ɓǝ.<verse eid="LUK 2:38" /></para>
  <para style="s">Bǝ Kwoiu I Tǝ Nazarat</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39" />Kwɔ Yusufu i Maryamu alo nungkwɔ nung zuu gi Dangbang gwabǝi tthǝ kwɔ, i kwoi suai i tǝ gwoi gi Nazarat dang Galili. <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />Yui ɓǝ ghaa nyim; u tthǝ i yiggǝi, bǝ khana lo gi Fuh lo lǝ.<verse eid="LUK 2:40" /></para>
  <para style="s">Yeso Dang Kǝm Nyǝknung</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />Ttha ǝndǝi daa gi Yeso i naa gu dǝna tǝ Urshalima lǝ ba ɓang nyang lo. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />Kwɔ ttha Yeso sob iu rab, i tǝ ɓangɓǝ manung akwɔ dǝito ttha ǝndǝi ɓǝ. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />Kwɔ ɓangɓǝ thǝm, daa gu i naa gu i olǝi gwoi, kwoi yui ɓǝ kwɔ lǝ kwɔ Yeso ǝǝ Urshalima. I ibǝi lǝu; <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />Dǝi ɓyea angǝ lko Yeso dang kon yayuu lǝ, i thko fuh o dǝnni ɗubǝiu dang ya bǝpi gi i ya ǝnthǝi. <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />I tǝiu lǝu, i kwoi i tǝ Urshalima dǝnni ɗubǝiu. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />Tthasua bo tai i tǝiu u ǝǝ dang kǝm Nyǝknung, u ǝǝ i ya nanatthǝnung dǝu lǝi dǝu ɓibǝi ba. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />Yayuu kwɔ ǝndǝi lǝu yang loi dǝna fǝm lobǝ gwabnwa bagu i bǝ inanung gu. <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />Daa gu i Naa gu loi fǝm kwɔ i ɓyǝko ɓǝ, Naa gu geiu angǝ,&lt;&lt;Yui, ǝnɓǝ bǝ a toɓi ni? Daa mǝ i ɓang dǝɓi ɗuu bǝimǝ.&gt;&gt; <verse eid="LUK 2:48" /><verse number="49" style="v" sid="LUK 2:49" />Yeso gei angǝ,&lt;&lt;Ənɓǝ bǝ ɗǝɓa ɗuu bǝim? Ɓa ibǝi kwɔ mǝn to nung to Daam ɓǝlǝu?&gt;&gt; <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />Kwoi i ibǝi nungkwɔ Yeso dǝna gei ɓǝlǝu. <verse eid="LUK 2:50" /><verse number="51" style="v" sid="LUK 2:51" />Nungkwɔ Yeso kwoi suatha i ilǝ itǝ Nazarat, bǝilǝ kwɔ dǝnnu lǝ bagi. Naa gu muo bakwɔ ǝndǝi dang wko. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />Yeso ghaa nyimtthǝ langkwoi ibǝ nung. Fuh dǝna yiɗiu nungkwɔ dǝna tǝi bǝ yiɗi bǝi tthǝ Fuh i yayuu.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s">Yohanna Ya Wollmung Mablǝi</para>
  <para style="r">(<ref loc="MAT 3:1-12">Matthew 3:1-12</ref>; <ref loc="MRK 1:1-8">Markus 1:1–8</ref>; <ref loc="JHN 1:19-28">Yohanna 1:19–28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />Dang ttha lii bǝ lo yigwoi angǝ a kaisar Tibariyas ttha lǝkwɔ yang Buntus Bilatus lo yigwoi losua Yahudiya, Hiridus lǝ yigwoi losua Galili i youngǝu Filibus yigwoi losua Itoriya i Tarakunitas; Lisaniya dǝna lo yigwoi losua Abiliya, <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />Ttha lǝ kwɔ yang i Hanana i Kayafa ilǝ yakku ya nyǝknung. Ba gi Fuh wuo sua Yohanna yui gi Zakariya losua a kwi bǝi kwɔ kab a tuabtuab nung yangǝu da pitthǝuɓǝ. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />Nungkwɔ Yohanna tǝ losua kwɔ ǝndǝi kwɔ gbag dual Urdun, dǝnnu gei ba a langǝ i Fuh, &lt;&lt;Ɓa al nung a ɓko ɓǝ lǝtǝ yang i wollɓǝ mung yang Fuh al nung a ɓko ɓǝlǝtǝ.&gt;&gt; <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />Manungkwɔ i vullǝ dang nungvullǝ lo ba gi Ishaya ya gei ba a tthasi:</para>
  <para style="q1" vid="LUK 3:4">&lt;&lt;Yoll yuu akun dǝna buogbǝi dang gug angǝ:</para>
  <para style="q1" vid="LUK 3:4">&lt; Mab nunglǝi lǝ Dangbang tthǝ.</para>
  <para style="q2" vid="LUK 3:4">Mab lǝi ɓǝ juantthǝ yangbǝ u thkotthǝ!<verse eid="LUK 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5" />Kong ɓua ǝndǝi i lǝn lam,</para>
  <para style="q2" vid="LUK 3:5">i ɓǝmɓǝm tal i tal angǝ a ǝndǝi tǝlǝ pangsua.</para>
  <para style="q1" vid="LUK 3:5">Nunglǝi a kwalkwal i mab juantthǝ,</para>
  <para style="q2" vid="LUK 3:5">langkwoi lǝi a gudugudug i mab brǝmtthǝ,<verse eid="LUK 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6" />langkwoi ttha yuu a ɓillǝng ǝndǝi a ɓyǝa bǝ nwongbǝi gi Fuh!&gt;&gt;&gt;<verse eid="LUK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />Kon yayuu wuo yangbǝ Yohanna wuu wollimung. Yohanna gei angǝ, &lt;&lt;Ɓǝ yatthang nagilǝ!&gt;&gt; U gei angǝ&lt;&lt;Yiǝ gei ɓǝtthǝ angǝ ɓa surr ɓua kwɔ Fuh dǝna wullǝ loɓǝ ɓǝ? <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />Ɓa to i nungkwɔ a ǝǝlǝ bǝ yitthǝ nung a ɓkoɓǝ ɓǝ. Bǝ ɓa tǝbǝ geiu dang ɓǝlǝ ɓangǝ Ibrahim lǝ Daa ɓithǝ. Ən gei ɓǝtthǝ dang tal kwɔ Fuh a mǝrrǝm ya bǝpi lǝ Ibrahim tthǝ. <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />Ko ǝn lakwɔ nikwɔ zom tthǝnthǝ yǝng kab; kab akwɔ nǝ si a langǝ iu i ɓǝrǝu i li nung lua.&gt;&gt;<verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />Kon ɓǝ ɓibbu angǝ,&lt;&lt;Yang ǝn ɓǝɓi to?&gt;&gt; <verse eid="LUK 3:10" /><verse number="11" style="v" sid="LUK 3:11" />Yohanna gei angǝ,&lt;&lt;yuukwɔ nǝtthǝ i nunglitthǝ rab yang u dǝ kun lǝ yuu akun kwɔ abo yangǝu ɓǝ, yuukwɔ nǝtthǝ i kongkwi ɓa gab lǝtha.&gt;&gt; <verse eid="LUK 3:11" /><verse number="12" style="v" sid="LUK 3:12" />Ya kun dang ya muo nungǝmmi langɓǝ wuo yangbǝ wuǝi wollimung i ɓib angǝ.&lt;&lt;Ya nanatthǝ nung, ǝnɓǝ ɓito?&gt;&gt; <verse eid="LUK 3:12" /><verse number="13" style="v" sid="LUK 3:13" />Yohanna gei angǝ,&lt;&lt;Bǝɓa muo pǝl nungkwɔ i gei ɓǝtthǝ thǝ,&gt;&gt; <verse eid="LUK 3:13" /><verse number="14" style="v" sid="LUK 3:14" />Yakun dang ya taɓui ɓibbu angǝ,&lt;&lt;Ənɓǝ ɓito?&gt;&gt; U gei angǝ,&lt;&lt; Bǝɓa muo nungkurɓǝ na yayuu lǝthaa thǝ langkwoi bǝɓa ɓanglǝ ɗuǝn yuu nǝkwam thǝ. Nung busoni ɓǝ naɓǝtthǝ.&gt;&gt;<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />Yayuu dǝna ki dǝna ɓyǝa lǝi langkwoi dǝnni nhǝm angǝ lko Yohanna lǝ Kristi ɓǝ. <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />Nungkwɔ Yohanna gwabǝi nwa angǝ,&lt;&lt;Dǝm wollɓǝ mung i mungki, kwoi yuu akun dǝna wɔ kwɔ pǝllǝm ɓǝ. Ən kǝn kwɔ mǝn bi ɓǝl ǝũ gu ɓǝlǝu. Wuu wollɓǝ mung i ya Ɓyang a Langǝ i i lua lǝ. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />U tthǝ i nung yǝlnung gu naulǝ, kwɔ u kai lǝ bǝ pǝmnung gu yang u al min gu dang bi, kwoi u li yakwɔ u li wong i lua akwɔ muallǝu ɓǝ.&gt;&gt;<verse eid="LUK 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18" />Nunglǝi pack nǝkwam Yohanna gei ba a langǝ i gi Fuh tthǝ angǝ i mǝrrǝm nung lǝi gi. <verse eid="LUK 3:18" /><verse number="19" style="v" sid="LUK 3:19" />Kwoi kwɔ Yohanna than nyi lo yigwoi Hiridus, yikku losua, bakwɔ u dǝb Herodiya, si youngǝu, langkwoi u to nung a ɓko kpaaɗing. <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />Hiridus ǝrr to nung a ɓko kwɔ lilǝ lo nung a ɓko gu: U thǝb Yohanna pursǝna.<verse eid="LUK 3:20" /></para>
  <para style="s">Bǝ Wollmung Gi Yeso</para>
  <para style="r">(<ref loc="MAT 3:13-17">Matthew 3:13-17</ref>; <ref loc="MRK 1:9-11">Markus 1:9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />Kwɔ i wollmung lǝ yayuu ǝndǝi, i wollmung lǝ Yeso langɓǝ. Kwɔ Yeso dǝna pinwa wayi ɓko, <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />Ɓyang a Langǝ i pin mangǝn gko wuo kko. Yoll wuo wayi angǝ,&lt;&lt;Mǝlǝ yuim, kwɔ dǝm yiɗi ɓǝ.&gt;&gt;<verse eid="LUK 3:22" /></para>
  <para style="s">Ya Bǝpi Gi Yeso</para>
  <para style="r">(<ref loc="MAT 1:1-17">Matthew 1:1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />Kwɔ Yeso baipi nung to gu kwɔ, thko thǝmkun pǝmna sob. U ǝn yui, manungkwɔ yayuu da nhǝm, lo Yusufu ɓǝ, Yui Heli, <verse eid="LUK 3:23" /><verse number="24" style="v" sid="LUK 3:24" />Yui Matat, Yui Lawi, Yui Malki, Yui Yanna, Yui Yusufu, <verse eid="LUK 3:24" /><verse number="25" style="v" sid="LUK 3:25" />Yui gi Matatiya, Yui Amos, Amos Yui Nahum, Yui Azaliya, Yui Najaya, <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />Yui Ma'ata, Yui Matatiya, Yui, Shemiya, Yui Yusufu, Yui Yahuza, <verse eid="LUK 3:26" /><verse number="27" style="v" sid="LUK 3:27" />Yui Yowana, Yui gi Refaya, Yui, Zarubabel, Yui gi Sheyaltiyel, Yui Niri, <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />Niri Yui Malki, Yui Addi, Yui kosama, Yui Almadama Yui Eri <verse eid="LUK 3:28" /><verse number="29" style="v" sid="LUK 3:29" />Yui Yosi, Yui Eliyezer, Yui Yorima, Yui Matat, Yui Lawi, <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />Lawi Yui Saminu, Yui Yahuza, Yui Yusufu, Yusufu Yui Yonana, Yui Eliyakim <verse eid="LUK 3:30" /><verse number="31" style="v" sid="LUK 3:31" />Yui Malaya, Yui gi Mainana, Yui Matata, Yui gi Natan, Yui Dawuda <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />Yui Yesse, Yui Obida, Yui Bo'aza, Yui gi Salmon, Yui Nashon, <verse eid="LUK 3:32" /><verse number="33" style="v" sid="LUK 3:33" />Yui gi Amminadab, Yui gi Aram, Yui gi Hesruna, Yui gi Feresa, Yui gi Yahuza, <verse eid="LUK 3:33" /><verse number="34" style="v" sid="LUK 3:34" />Yui Yakubu, Yui Ishaku, Yui Ibrahim Yui Tera, Yui Nahor, <verse eid="LUK 3:34" /><verse number="35" style="v" sid="LUK 3:35" />Yui Serug, Yui gi Reyu, Yui Feleg, yui Eber, Yui gi Shela, <verse eid="LUK 3:35" /><verse number="36" style="v" sid="LUK 3:36" />Yui Kenan Arfakshad, Yui Shem, Yui Nuhu, Nuhu Yui gi Lamek, <verse eid="LUK 3:36" /><verse number="37" style="v" sid="LUK 3:37" />Yui Metusela, yui Anuhu, Yui Yared, Yui Mahalel, Yui Kenan <verse eid="LUK 3:37" /><verse number="38" style="v" sid="LUK 3:38" />Yui Enosh, Yui Shitu, Yui Adamu, Yui Fuh.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s">Bǝ Na Yeso</para>
  <para style="r">(<ref loc="MAT 4:1-11">Matthew 4:1-11</ref>; <ref loc="MRK 1:12-13">Markus 1:12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />Yeso kwoi nwa dual Urdun i tthǝnyimmi Ɓyang a Langǝ i tthǝu lǝ langkwoi Ɓyang tǝu lǝ losua a kwi bǝikwɔ kab tuabtuab ɓuo nung yangǝu dǝna pi tthǝu ɓǝ, <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />U bǝilǝ kwɔ bo thǝmrab Mungkullum dǝna nko. Lona lǝ kullo gwom tǝiu, bakwɔ u tang nung lǝu ɓǝ. <verse eid="LUK 4:2" /><verse number="3" style="v" sid="LUK 4:3" />Mungkullum geiu angǝ,&lt;&lt;Nǝmǝn Yui Fuh, a gei tal kwɔ mǝrrǝm lǝ burodi.&gt;&gt; <verse eid="LUK 4:3" /><verse number="4" style="v" sid="LUK 4:4" />Yeso gei angǝ,&lt;&lt;I vullǝ dang nungvullǝ gi Fuh angǝ&lt;Yuu a sob i burodi ɓuo lǝu.&gt;&gt;&gt;<verse eid="LUK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5" />Mungkullum lǝiu tkonatthǝ gwoi angǝ a longwam kwɔ ǝndǝi. <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />&lt;&lt;Mungkullum geiu angǝ, mǝn da i nungtǝi dang ǝu ǝndǝi, i dǝlǝn ɓang, yang mǝn dǝlǝ yuu kwɔ ǝn yiɗi ɓǝ. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />Nungkwɔ ǝndǝi mǝn da na wabǝm ɓǝ.&gt;&gt;<verse eid="LUK 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8" />Yeso gei angǝ,&lt;&lt;Nungvullǝ gi Fuh gei angǝ,&lt; A wab Fuh mǝ ɓuo ma tou nung to tthǝ!&gt;&gt;&gt;<verse eid="LUK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9" />Langkwoi Mungkullum lǝiu tǝllǝ Urshalima tǝu lǝ lo kǝm Nyǝknung tǝyitthǝ, u geiu angǝ,&lt;&lt; Nǝ mǝn Yui Fuh a yina tthǝmmǝ wa o pangsua, <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />Bakwɔ nungvullǝ gi Fuh gei angǝ, &lt;Fuh a gei ya nwatummi gu a kangǝ.&gt; <verse eid="LUK 4:10" /><verse number="11" style="v" sid="LUK 4:11" />Ba Fuh gei langkwoi angǝ, &lt;I lǝi dang nai yangbǝ bǝ bomǝ ɓuob tthǝ tal thǝ.&gt;&gt;&gt;<verse eid="LUK 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12" />Kwoi Yeso gwabnwa angǝ, &lt;&lt;Nungvullǝ gi Fuh gei angǝ, &lt;Ba ɗam Dangbang Fuh mǝthǝ.&gt;&gt;&gt;<verse eid="LUK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13" />Kwɔ Mungkullum alo bǝ na Yeso nung lǝi kwɔ ǝndǝi, u yiu natthǝ tuab.<verse eid="LUK 4:13" /></para>
  <para style="s">Yeso Baipi Nung To Gu Galili</para>
  <para style="r">(<ref loc="MAT 4:12-17">Matthew 4:12-17</ref>; <ref loc="MRK 1:14-15">Markus 1:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />Yeso kwoi tǝ Galili dang tthǝnyimmi Ɓyang a Langǝ i. Nwa ba gu logbǝi losua lǝ ǝndǝi. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />Yeso nanatthǝ nung bǝ kǝbtha ya Yahudawa yayuu manniu.<verse eid="LUK 4:15" /></para>
  <para style="s">I Yǝrnwa Tthǝ Yeso Nazarat</para>
  <para style="r">(<ref loc="MAT 13:53-58">Matthew 13:53-58</ref>; <ref loc="MRK 6:1-6">Markus 6:1-6</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />Yang Yeso kwoi suo tǝ Nazarat, bǝikwɔ u ghaatthǝ ɓǝ, vii nwongǝi ya Yahudawa, u tǝ bǝ kǝbtha gi manung a zee. Udǝi nǝbo yangbǝ u than nung dang nungvullǝ gi Fuh. <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />I duu nung thanni dang nungkwɔ dǝnni kuluam ɓǝ nung thanni gi Ishaya ya gei ba a tthasi. U bi bǝikwɔ i vullǝ angǝ,<verse eid="LUK 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18" />&lt;&lt; Ɓyang gi Dangbang i ɓanglǝ,</para>
  <para style="q2" vid="LUK 4:18">bakwɔ u mkom yangbǝ ǝn wullǝ ba a langǝ i lǝ ya yiɓko tthǝ.</para>
  <para style="q1" vid="LUK 4:18">Dangbang tummǝm angǝ ǝn gei ba bǝ yina lǝ yakwɔ i tthǝbǝi ɓǝ</para>
  <para style="q2" vid="LUK 4:18">i yakwɔ nungǝi ɓyǝa bǝiu ɓǝ yangbǝ i ɓyǝabǝi,</para>
  <para style="q1" vid="LUK 4:18">yakwɔ lǝ ya thǝb i yiina.<verse eid="LUK 4:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="LUK 4:19" />Langkwoi ǝn gei lǝ yayuu tthǝ lona wɔ yang</para>
  <para style="q2" vid="LUK 4:19">kwɔ Dangbang a nwong yayuu gu ɓǝ.&gt;&gt;<verse eid="LUK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />Yeso kuluam nungkwɔ i vullǝnung lo lǝ kwɔ u kwoi lǝ nung vullǝ ɓǝ u dǝlle yuu kwɔ dǝna to nung to bǝi lǝ ɓǝ nungkwɔ u ǝǝsua. Yakwɔ dang kǝm kǝbtha ya Yahudawa ɓǝlǝ kwɔ dǝnung tthǝu, <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />kwɔ u gei bakwɔ angǝ,&lt;&lt;Ɗigǝ kwɔ bakwɔ natthǝng, manungkwɔ ɓa lǝ ǝn than dang nung vullǝ kwɔ ɓǝ.&gt;&gt;<verse eid="LUK 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22" />Yayuu ǝndǝi lǝ tthǝla dǝnni gei ba gu lo ba a langǝ i kwɔ i nwo lǝɓǝ. I gei lǝ thatthǝ angǝ, i ɓib tha angǝ.&lt;&lt;U ǝn yui Yusufu lǝu?&gt;&gt;<verse eid="LUK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23" />Yeso gei angǝ,&lt;&lt;Ən ibǝing ɓa gǝm bǝ liba kutthǝ ǝn gei,&lt;Ya dǝ yeng, a dǝ tthǝla lǝ lomǝ,&gt; Langkwoi ɓa nhǝm ɓangǝ ǝn to i nungkwɔ ǝn to kwɔ ɓa lǝ ǝn to Kafarnahum kwɔ ǝn to gwoiǝm. <verse eid="LUK 4:23" /><verse number="24" style="v" sid="LUK 4:24" />Yeso gei langkwoi angǝ,&lt;&lt;Ya gei ba a tthasi yangǝu i ghaali gwoigu lǝu. <verse eid="LUK 4:24" /><verse number="25" style="v" sid="LUK 4:25" />Ɓalǝm: ǝn ba a langǝ i ya siɓui kpaaɗing dang Israila dang wam gi Iliya kwɔ wayi lam mung nalǝu ttha tai i gabbu langkwoi gwom ghaatthǝ o losua lǝ ǝndǝi. <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />I tum Iliya sua yuu a kun dang Israila lǝu, thǝn sua siɓui kwɔ ǝǝ Zarifat loɓyǝn losua Sidon ɓǝ. <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" />Yayuu kpaatthǝ i nungzii ǝmbǝlai kwɔ ǝǝ dang Israila lona kwɔ Elisha lǝ ya gei ba tthasi ɓǝ; yuu a kun yangǝu tǝi tthǝllko, kwoi ǝn Naaman ya Suriya ɓuo. <verse eid="LUK 4:27" /><verse number="28" style="v" sid="LUK 4:28" />Kwɔ yayuu kwɔ dang kǝm kǝbtha lǝ nungkwɔ, dang wai ɓanglǝ ghaatthǝ. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />I ǝrr i dǝi nǝbo, i ilǝ Yeso dang gwoi angǝ a lǝ, i tǝu lǝ lo tal yilǝ bǝikwɔ i mai gwoi gitthǝ ɓǝ. Dǝi yiɗi bǝ wko lǝtǝ pangsua, <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />kwoi u bǝrǝm ganglang kon lǝ wuu pa nung gu.<verse eid="LUK 4:30" /></para>
  <para style="s">Yiɓǝi Ya Wa A Ɓko</para>
  <para style="r">(<ref loc="MRK 1:21-28">Markus 1:21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />Yeso tǝ Kafarnahum, gong gwoi dang Galili lǝ, bǝilǝ kwɔ u nanatthǝnung vii nwongǝi ya Yahudawa. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />Bǝ nanatthǝnung gu fǝmlo yayuu, bakwɔ dǝu gei ba i tthǝnyimmi.<verse eid="LUK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33" />Bǝ kǝbtha gilǝ yiɓǝi akun tthǝ wa a ɓko tthǝu; u ɓuobnwa i yoll, <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />&lt;&lt;U gei angǝ, Əi! Yeso ya Nazarat, ǝn ɓǝ dǝmma yiɗi i ɓilǝ? Ən ibǝi mǝn yittǝnnǝng: mǝn ya nwatummi a langǝ i gi Fuh!&gt;&gt;<verse eid="LUK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35" />Yeso dǝ kab nwa wa a ɓko ɓǝ, &lt;&lt; A kǝrnwa nǝkwam a i dang tthǝ yiɓǝi kwɔ!&gt;&gt;<verse eid="LUK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36" />Yayuu ɓǝ ǝndǝi loi dǝna fǝm, i gei lǝ tha tthǝ angǝ,&lt;&lt;Ba a ɓǝnni? Dǝnnu gei ba ttha i tthǝnyimmi yiɓǝi kwɔ dǝna dǝ kabnwa wa a ɓko, yang lang i itthǝ yuu.&gt;&gt; <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />Nwaba gi Yeso lǝi lǝ bǝikwɔ ǝndǝi losua lǝ kullo.<verse eid="LUK 4:37" /></para>
  <para style="s">Yeso Dǝ Tthǝla Lǝ Yayuu Kpaatthǝ</para>
  <para style="r">(<ref loc="MAT 8:14-17">Matthew 8:14-17</ref>; <ref loc="MRK 1:29-34">Markus 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />Yeso yitthǝ bǝ kǝbtha ya Yahudawa tǝ gwoi gi Saminu. Tthǝ gong gi Saminu a yisi lko i tthǝsoni, nungkwɔ i gei lǝ Yeso tthǝ lǝ ba gu. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />Nungkwɔ Yeso tǝtǝ dǝi gbag yisi ɓǝ u gei lǝ tthǝsoni ɓǝ i tthǝu. Tthǝsoni ɓǝ yiu, u toi nung to tthǝ.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />Kwɔ fuh dǝna o i wulǝ ya nungzii lǝ sua Yeso; u dǝ na loi i tǝi tthǝla ǝndǝi. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />Wa a ɓko langɓǝ itthǝ yayuu kpaatthǝ, dǝi ɓuobnwa,&lt;&lt;Mǝn Yui Fuh!&gt;&gt;</para>
  <para style="p" vid="LUK 4:41">Yeso dǝ kabnwa wa ɓǝ lǝ u yii i gei ba lǝu, bakwɔ i ibǝing u lǝ Kristi ɓǝ.<verse eid="LUK 4:41" /></para>
  <para style="s">Yeso Gei Ba Fuh Bǝ Kǝbtha ya Yahudawa</para>
  <para style="r">(<ref loc="MRK 1:35-39">Markus 1:35-39</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />Bǝi dǝna kan ni yang Yeso yitthǝ gwoi angǝ a ɓǝ tǝ bǝikwɔ yuu yangǝu tthǝɓǝ tǝu ǝǝ i nungtthǝu. Yayuu tǝ bǝ ɗuu bǝiu, kwɔ i tǝiu i geiu angǝ, i yiɗi kwɔ u pa ɓǝlǝu. <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />Kwoi u gei angǝ,&lt;&lt;Mǝn gei ba a langǝ i gi Fuh kwɔ wa lo yigwoi ɓǝ lǝ sua gwoi angǝ a langɓǝ, lǝ u baɓǝ kwɔ Fuh tumǝm wun to ɓǝ.&gt;&gt; <verse eid="LUK 4:43" /><verse number="44" style="v" sid="LUK 4:44" />Nungkwɔ u thko dǝnnu gei ba Fuh losua galili lǝ ǝndǝi bǝ kǝbtha gi.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s1">Yeso Lubǝ Ya Nanung To A Nwasiu</para>
  <para style="r">(<ref loc="MAT 4:18-22">Matthew 4:18-22</ref>; <ref loc="MRK 1:16-20">Markus 1:16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />Vii akun Yeso dǝi nwa mung Janisarata, kon yayuu dǝna togtha tthangǝu dǝnni yiɗi bǝlǝ ba Fuh. <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />Yeso ɓyǝa kwai ni rab dǝi nwa mung lǝ; ya muo tthǝng ɓǝ yitthǝ kwai ɓǝ tǝbǝ ɗigǝ kalli gi. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />Yeso tǝ dang kwai a kunɓǝ- ǝn a bǝ Samainu- u gei Saminu angǝ u tog kwai gu mung lǝ tuab nwangwam. Yeso ǝǝ dang kwai lǝ dǝna nanatthǝnung lǝ yayuu. <verse eid="LUK 5:3" /><verse number="4" style="v" sid="LUK 5:4" />Kwɔ Yeso alo bǝ nanatthǝnung, u gei Saminu angǝ,&lt;&lt;A tog kwai ɓǝ dang mung a kilickilic, yang mǝ i ya nung to mǝ al kalli dang mung lǝ yangbǝ ɓa mua tthǝng.&gt;&gt;<verse eid="LUK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5" />Saminu gwabnwa angǝ,&lt;&lt;Yuu gwoi, ɓi to nung to ɗing nungvii kwɔ ɓi muo nung lǝu. Nǝ langkwoi na gei niyang, mǝn al kalli ɓǝ dang mung lǝ ba kwɔ a gei ɓǝ.&gt;&gt; <verse eid="LUK 5:5" /><verse number="6" style="v" sid="LUK 5:6" />I al kalli ɓǝ dang mung lǝ i muo tthǝng lǝ kpaliu. Tthǝng kpaatthǝ kalli ɓǝ tǝbǝ tǝrrǝu. <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />I gei ba lǝ ya youngǝi dang kwai a kun lǝ i wuo wui woinatthǝ. I wuo wui al tthǝng yi kwai ɓǝ kwai ɓǝ dǝna dã. <verse eid="LUK 5:7" /><verse number="8" style="v" sid="LUK 5:8" />Saminu ɓyǝa nungkwɔ to nung ɓǝ, u bainwa longǝu pangsua tthasi Yeso u gei angǝ,&lt;&lt;A pa a yimbǝi, Dangbang! Ɓang ya nung a ɓko!&gt;&gt; <verse eid="LUK 5:8" /><verse number="9" style="v" sid="LUK 5:9" />U i yakwɔ suatha i ulǝ ɓǝ loi fǝm tthǝ kpaali tthǝng kwɔ i muo ɓǝ. <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />Manung ɓǝni i Yakubu i Yohanna, yui gi Zabadi ya ǝnthǝ gi Bitrus. Yeso gei Saminu angǝ,&lt;&lt; Bǝ a survulli thǝ; lakwɔ ni ma muo ǝn yayuu.&gt;&gt;<verse eid="LUK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 5:11" />I gub i kwai ɓǝ i wulǝ nwangwam, i yitthǝ nung ǝndǝi i mua sua Yeso.<verse eid="LUK 5:11" /></para>
  <para style="s">Yeso Dǝ Tthǝla Lǝ Ya Əmbǝlai</para>
  <para style="r">(<ref loc="MAT 4:18-22">Matthew 4:18-22</ref>; <ref loc="MRK 1:16-20">Markus 1:16-20</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />Kwɔ Yeso gwoi angǝ a akun, yiɓǝi akun tthǝ ǝnbǝlai lǝilǝ thǝu ǝndǝi. Kwɔ u ɓyea Yeso, u bai nwalongǝu sua dang siu u ɗyǝabu, dǝu gei angǝ,&lt;&lt;Yikku, nǝ a gwabǝng, yang ma ɓuan ma dǝm tthǝla!&gt;&gt;<verse eid="LUK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13" />Yeso juan nko kǝnnǝu lǝ angǝ. &lt;&lt;Dǝm yiɗi,&gt;&gt; u gwabu nwa. &lt;&lt;A tǝi tthǝla!&gt;&gt; Ba a nwaɓi kwɔ dang tthǝ ǝnbǝlai ɓǝ itthǝ yiɓǝi lǝ. <verse eid="LUK 5:13" /><verse number="14" style="v" sid="LUK 5:14" />Yeso geiu angǝ&lt;&lt; Bǝ a gei lǝ yukuntthǝ thǝ, kwoi a tǝ ta tana tthǝmǝ lǝ ya nyǝknung, u ɓyǝa; yangbǝ yayuu ǝndǝi ibǝi angǝ a tǝi tthǝ lang, a nyǝknung manunkwɔ nung zuu gi Musa gei ɓǝ.&gt;&gt; <verse eid="LUK 5:14" /><verse number="15" style="v" sid="LUK 5:15" />Kwoi nwa ba gi Yeso logbǝi kwɔ ǝndǝi, langkwoi kon yayuu wuo bǝ lǝu langkwoi bǝ i tǝi tthǝla tthǝ nungzii gi. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />Kwoi Yeso pa tǝ ǝǝ i nungtthǝu bǝikwɔ yayuu yangǝu ɓǝ, bǝi lǝ kwɔ u pinwa tthǝ.<verse eid="LUK 5:16" /></para>
  <para style="s">Yeso Dǝ Tthǝla Lǝya Kuglǝ</para>
  <para style="r">(<ref loc="MAT 9:1-8">Matthew 9:1-8</ref>; <ref loc="MRK 2:1-12">Markus 2:1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />Vii akun Yeso dǝna nanatthǝnung, yakun dang ya Farisiyawa i ya nanatthǝnung Musa ǝǝ bǝi lǝ yakwɔ ǝrr gwoi angǝ a Galili i Yahudiya i Urshalima ɓǝ. Tthǝnyimmi gi Dangbang tthǝ bǝi lǝ yangbǝ Yeso dǝ tthǝla lǝ ya nungzii. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />Yaɓǝi akun ta yiɓǝi a kun lo kab dǝnni yiɗi bǝ tǝu lǝ dang woi yang i duu tthasi Yeso, <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />ba kon yayuu, i tǝi nunglǝi kwɔ i wulǝ dang gwoi ɓǝlǝu. Nungkwɔ i lǝiu i muo lǝ ttha lo kǝm yi kwɔ i mai i suab ɓǝ, i fǝl lokǝm ɓǝ, i pin lǝ yiɓǝi ɓǝ lo kab kwɔ i tko lǝ ɓǝ nung ganglang yayuu tthasi Yeso. <verse eid="LUK 5:19" /><verse number="20" style="v" sid="LUK 5:20" />Kwɔ Yeso ɓyǝa ghaali bǝ dǝnyitthǝ gi, u gei yiɓǝi ɓǝ angǝ, &lt;&lt;Ənthǝm, i al nung a ɓko mǝlǝ tǝng.&gt;&gt; <verse eid="LUK 5:20" /><verse number="21" style="v" sid="LUK 5:21" />Ya nanatthǝnung Musa i ya Farisiyawa dǝi gei lǝ thatthǝ angǝ,&lt;&lt;Yiɓǝi kwɔ ǝn yittǝn bǝ dǝna dal Fuh ɓa! Fuh kun lǝ ya al nung a ɓko lǝtǝ!&gt;&gt;<verse eid="LUK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22" />Yeso ibǝ nungkwɔ dǝi nhǝm ɓǝng u gei angǝ,&lt;&lt;Ən baɓǝ bǝ dǝɓa nhǝm nung manungkwɔ ni? <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />Ən a nwuo ziu kwɔ mǝn gei gǝngǝ, &lt;I al nung a ɓko mǝlǝ tǝng,&gt; ko kwɔ mǝn gei gǝngǝ, &lt;Ərr a thko&gt;? <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />Mǝn taɓǝ natthǝ, yangbǝ ɓa ibǝi, Yui Yuu tthǝ i ttha bǝ al nung a ɓko lǝtǝ longwam.&gt;&gt;Nungkwɔ u gei yiɓǝi kwɔ bo i nko ɓuiɓui ɓǝ angǝ,&lt;&lt;Ən geitthǝ, ǝrr a dǝi nǝbo, lǝi nung lomǝ, atǝ gwoi!&gt;&gt;<verse eid="LUK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 5:25" />Ba a nwaɓi kwɔ ni yiɓǝi ɓǝ ǝrr dǝi nǝbo tthasi lǝ ǝndǝi, lǝi kab kwɔ i tko lǝ kwɔ, u pa lǝi gwoi, dǝu kha Fuh. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />I ǝndǝi loi fǝm! Dǝi survulli, dǝi kha Fuh, angǝ,&lt;&lt;Nung fǝmlo ɓǝ ɓi ɓyea ɗiggǝ kwɔni!&gt;&gt;<verse eid="LUK 5:26" /></para>
  <para style="s">Yeso Lubǝ Lawi</para>
  <para style="r">(<ref loc="MAT 9:9-13">Matthew 9:9-13</ref>; <ref loc="MRK 2:13-17">Markus 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />Tthasua nungkwɔ, Yeso i gwam tǝ tǝi ya muo nungǝmmi ɗuǝnnu ǝn Lawi, u ǝǝ nwa nung to gu. Yeso geiu angǝ,&lt;&lt;A muo suam.&gt;&gt;<verse eid="LUK 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 5:28" />Lawi ǝrr dǝi nǝbo, yitthǝ nung ǝndǝi, muo suo.<verse eid="LUK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29" />Nungkwɔ Lawi to gong ɓang gwoi gu lǝ ba Yeso, ya muo nungǝmmi kpaaɗing dang yakwɔ wuu ɓang ɓǝkwɔ ɓǝ i sua yayuu ya nǝkwam.<verse eid="LUK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 5:30" />Yakun dang ya Farisiyawa i ya nanatthǝnung Musa i ɓib ya nanung to gi Yeso angǝ. &lt;&lt;Ən baɓǝ bǝ ma tang dǝmma nwa lotha i ya muo nungǝmmi i ya nung a ɓko?&gt;&gt;<verse eid="LUK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31" />Yeso gwabǝinwa angǝ,&lt;&lt;Yakwɔ tthǝi lathǝ kwɔ yiɗi ya dǝ yeng lǝu, kwoi yakwɔ tthǝi lko ɓǝ. <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />Ən wuo bǝ lubǝ ya langǝ i lǝu, ǝn wuo ba ya nung a ɓko i yitthǝ nung a ɓko gi.&gt;&gt;<verse eid="LUK 5:32" /></para>
  <para style="s">Bǝ Ɓibba Lobǝ Zuufuh</para>
  <para style="r">(<ref loc="MAT 9:14-17">Matthew 9:14-17</ref>; <ref loc="MRK 2:18-22">Markus 2:18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />Yakun gei Yeso angǝ,&lt;&lt; Ya nanung to gi Yohanna dǝi zuu Fuh vii ǝndǝi dǝi pinwa, langkwoi ya nanung to ya Farisiyawa dǝna to manungɓǝni; kwoi ya nanung to mǝ dǝi tang dǝi nwa.&gt;&gt; <verse eid="LUK 5:33" /><verse number="34" style="v" sid="LUK 5:34" />Yeso gwabǝi nwa angǝ,&lt;&lt;Dǝɓa ɓyea ɓangǝ yayol gi yiɓǝi kwɔ da dǝb yisi kwɔ a lo i gwom kwɔ u i ilǝ ɓa? Yangǝu! <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />Kwoi vii dǝna wɔ kwɔ i lǝi yuu dǝb yisi tthangǝ i lǝ, yang i zuu fuh.&gt;&gt; <verse eid="LUK 5:35" /><verse number="36" style="v" sid="LUK 5:36" />Yeso langkwoi gei bǝ liba kwɔtthǝ angǝ: &lt;&lt;Yuu akun yangǝu kwɔ tǝra nunglitthǝ afu yang fyǝh lǝ aku. Nǝ u to yang, a ɓanglǝ nung litthǝ afu ɓǝng, nung afu ɓǝ natha i aku. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />Yuu akun al min kwɔ nwa ɗigǝ dang zuǝ al min aku, bakwɔ min afu ɓǝ a trǝ zuǝ ɓǝ, min ɓǝ a alǝtǝ, yang zuǝ ɓǝ a ɓanglǝ. <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />Min afu i alǝu dang zuǝ afu! <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />Langkwoi yuu a kun yangǝu kwɔ nǝ nwa min aku yang a yiɗi afu ɓǝu, u gei angǝ,&lt;Aku lapǝl afu.&gt;&gt;<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s">Bǝ Ɓiba Lo Vii Nwongǝi Ya Yahudawa</para>
  <para style="r">(<ref loc="MAT 12:1-28">Matthew 12:1-28</ref>; <ref loc="MRK 2:23-28">Markus 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />Vii nwongǝi a kun lǝ Yeso dǝna thko dang zug lǝ, ya nanung to gu dǝna har lo nungbyǝa, i nurgi dang nai yang dǝnni tang nungǝu. <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />Yakun dang ya Farisiyawa ɓib angǝ,&lt;&lt;Baɓǝ bǝ dǝɓa to nungkwɔ ǝn nung zuu vii nwongǝi ɓa?&gt;&gt;<verse eid="LUK 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3" />Yeso gwabǝinwa angǝ,&lt;&lt; Ɓa than nungkwɔ Dawuda to kwɔ u i ya ǝnthǝu gwom tǝi ɓǝlǝu? <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />U tǝ dang gwoi Fuh, u lǝi nungtang nyǝknung, u tang, Langkwoi u dǝlǝ ya ǝnthǝu kwɔ suatha i u ɓǝ. &gt;&gt;<verse eid="LUK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 6:5" />Nungkwɔ Yeso gei angǝ,&lt;&lt;Yui Yuu ǝn Dangbang lo vii nwongǝi,&gt;&gt;<verse eid="LUK 6:5" /></para>
  <para style="s">Yeso Dǝtthǝla Lǝ Yiɓǝi Kwɔ Nko Ɓuiɓui Ɓǝ</para>
  <para style="r">(<ref loc="MAT 12:9-14">Matthew 12:9-14</ref>; <ref loc="MRK 3:1-6">Markus 3:1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />Vii nwongǝi a kun u tǝ dang kǝm kǝbtha ya Yahudawa dǝu nanatthǝnung, Yiɓǝi akun tthǝ bǝi lǝ kwɔ nko a nali ɓuiɓui. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />Ya nanatthǝnung gi Musa i ya Farisiyawa dǝi ɗuu nunglǝi bǝ gei ba tthǝ Yeso lǝ ba bǝ to nung a ɓko, nungkwɔ dǝnni dǝ nung tthǝu angǝ lko u dǝ tthǝla lǝ yiɓǝi ɓǝ vii nwongǝi. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />Yeso ibǝ nungkwɔ dang wai ɓǝng nungkwɔ u gei yiɓǝi ɓǝ angǝ,&lt;&lt;Ərr wa dǝi tthasi yakwɔ ǝndǝi.&gt;&gt; Nungkwɔ yiɓǝi ɓǝ ǝrr dǝi nǝbo bǝilǝ.<verse eid="LUK 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 6:9" />Yeso gei angǝ, &lt;&lt;Ən ɓibɓǝ, anwɔ lǝ nung a langǝ i vii nwongǝi: bǝ to nung a langǝ i na ko nung a ɓko, bǝ nwong thaa yuu na ko bǝ thǝb yuu?&gt;&gt;<verse eid="LUK 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 6:10" />Yeso ɓyeai ǝndǝi mǝrrǝm lǝ, yang ǝrr u gei yiɓǝi ɓǝ angǝ, &lt;&lt;A juan namǝ.&gt;&gt; U to manungɓǝ, nko kwoi wuu natha matthǝ. <verse eid="LUK 6:10" /><verse number="11" style="v" sid="LUK 6:11" />Kwoi dang wai ɓanglǝ ghaatthǝ dǝi gei ba i ɓuoi nungkwɔ i tolǝ Yeso ɓǝ.<verse eid="LUK 6:11" /></para>
  <para style="s">Yeso Mko Ya Nwatummi Gu Sob Iu Rab</para>
  <para style="r">(<ref loc="MAT 10:1-4">Matthew 10:1-4</ref>; <ref loc="MRK 3:13-19">Markus 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />Vii a kun lǝ Yeso i tǝ lotal tǝbǝ pinwa tthǝ Fuh, nungvii lǝ u pinwa bǝi khanu lǝ. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />Kwɔ bǝi kan, u lubǝ ya nanung to gu u mko sob iu rab dang ǝi, iɓǝ kwɔ u mko lǝ ya nwatummi gu: <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />Saminu kwɔ dǝu lu lǝ Bitrus, i yongǝu Andarawas, i Yakubu i Yohanna i Filibus i Bartalamawas, <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />Matta i Toma i Yakubu yui Halfa i Saminu kwɔ dǝi lu angǝ Zaloti, yuukwɔ dǝna yiɗi losua gu ɓǝ, <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />Yahuda yui Yakubu i Yahuza Iskariyoti yuukwɔ ɓanglǝ Yeso ɓǝ.<verse eid="LUK 6:16" /></para>
  <para style="s">Yeso Nanatthǝnung Langkwoi Dǝtthǝla Lǝ Ya Nungzii</para>
  <para style="r">(<ref loc="MAT 4:23-25">Matthew 4:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />Yeso pin lotal lǝ suatha i ilǝ wuu dǝi nungpangbǝi. Kon ya nanung to gu bǝi lǝ i yayuu kpaatthǝ bǝikwɔ ǝndǝi dang Yahudiya, i Urshalima i gwoi angǝ a Taya i Sidon gɓag mung ɓǝ, <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />i wua bǝ lǝu langkwoi yangbǝ u ilǝ nung zii tthǝi. Yakwɔ wa tthǝi ma wui tǝi tthǝlla, <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />Yayuu ǝndǝi dǝna yiɗi bǝ kǝn na tthǝu, bakwɔ ttha dǝna i thǝu dǝna ilǝ nung zii tthǝi lǝ ǝnndǝi ɓǝ.<verse eid="LUK 6:19" /></para>
  <para style="s">Tthǝla I Zuii</para>
  <para style="r">(<ref loc="MAT 5:1-12">Matthew 5:1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />U ɓyea ya nanung to gu, u gei angǝ:</para>
  <para style="q1" vid="LUK 6:20">&lt;&lt;Bǝ khana loɓǝ ɓǝ ya yiɓko,</para>
  <para style="q2" vid="LUK 6:20">ɓa lo yigwoi i Fuh lǝ lona kwɔ wuu nwong yayuu gu ɓǝ.<verse eid="LUK 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21" />&lt;&lt;Bǝ khana lo ɓǝ kwɔ gwom dǝna tǝi ɓǝ lakwɔ,</para>
  <para style="q2" vid="LUK 6:21">ɓa fǝnfǝrr.</para>
  <para style="q1" vid="LUK 6:21">Bǝ khana lo ɓǝ yakwɔ dǝna tasui lakwɔ,</para>
  <para style="q2" vid="LUK 6:21">ɓa mamam. <verse eid="LUK 6:21" /><verse number="22" style="v" sid="LUK 6:22" />Bǝ khana lo ɓǝ yakwɔ yayuu dǝna tthǝng ɓǝ,</para>
  <para style="q2" vid="LUK 6:22">i laɓǝ i dal ɓǝ</para>
  <para style="q2" vid="LUK 6:22">i la ɗuǝn ɓǝ angǝ ɓa mko,</para>
  <para style="q3" vid="LUK 6:22">Lǝba ɓang Yui Yuu!<verse eid="LUK 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 6:23" />&lt;&lt;Ɓa lǝ tthǝla villǝ ɓa zuǝ i tthǝlla, bakwɔ nung busoni ɓǝ ghaaɗing wayi. Manung ɓǝni ya daa gi tolǝ ya gei ba a tthasi.<verse eid="LUK 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24" />&lt;&lt;Kwoi kwan dǝna wua lo ya nungtǝi,</para>
  <para style="q2" vid="LUK 6:24">bakwɔ ɓa osi ɓa tǝi tthǝllaǝn.<verse eid="LUK 6:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="LUK 6:25" />&lt;&lt; A ɓkoɓǝtthǝ nǝnǝ ɓǝ yakwɔ dǝɓa tang dǝɓa fǝr lakwɔɓǝ.</para>
  <para style="q2" vid="LUK 6:25">Gwom atǝi ɓǝ.</para>
  <para style="q1" vid="LUK 6:25">A ɓko nǝnǝ lǝ yakwɔ dǝna mammam lakwɔ. Ɓa ǝǝ nwakǝm ɓua ɓa tasui.<verse eid="LUK 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LUK 6:26" />&lt;&lt;A ɓko nǝnǝ kwɔ yayuu dǝna gei ba a langǝ i loɓǝ,</para>
  <para style="q2" vid="LUK 6:26">manungɓǝni ya Daa gi tolǝ ya gei ba a tthasi ya pǝllǝ.<verse eid="LUK 6:26" /></para>
  <para style="s">Yiɗi Ya Ɓuimǝ</para>
  <para style="r">(<ref loc="MAT 5:38-48">Matthew 5:38-48</ref>; <ref loc="MAT 7:12a">7:12a</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />&lt;&lt;Kwoi ǝn gei ɓǝtthǝ yakwɔ dǝna lǝm kwɔ: ɓa yiɗi yakwɔ dǝna tthǝng ɓǝ, ɓa to nung a langǝ i lǝ yakwɔ dǝna la baɓǝ ɓǝ, <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />ɓa khana lo yakwɔ dǝna dalɓǝ ɓǝ, ɓa pinwa lǝ yakwɔ toɓǝ nung a ɓko ɓǝ. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />Nǝ yuu kun ɓuob ɓua suimǝ akun yang a mǝrrǝmmu suo ɓǝtthǝ. Nǝ yuu akun lǝi nung ɓuobtthǝ mǝ, ba nannu tthǝ nunglitthǝ mǝ thǝ. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />A dǝlǝ yuu kwɔ ǝndǝi kwɔ ɗyǝap nung namǝ ɓǝ, langkwoi nǝ yuu akun lǝinung kwɔ ǝn amǝ ɓǝ, ba geiu u kwoi lǝ thǝ. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" />A tollǝ yayuu tthǝ manungkwɔ dǝmma yiɗi i to tthǝ ɓǝ.<verse eid="LUK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32" />&lt;&lt;Nǝ dǝmma yiɗi yakwɔ dǝna yiɗi mǝ ɓuo yang, ǝn ɓǝ a tǝi bǝi lǝ ɗing? I&lt;ya nung a ɓko&gt; dǝna yiɗi yakwɔ dǝna yiɗi gi ɓǝ. <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />Langkwoi Nǝ dǝmma to nung a langǝ i lǝ yakwɔ dǝna to i nung a langǝ i tthǝ ɓuo, ǝnɓǝ ma tǝi lǝ nung a langǝ i ɗing? I ya nung a ɓko ǝndǝi dǝna to ni! <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />Nǝ dǝma dǝ than lǝ yakwɔ a ibǝi i kwai than mǝ ǝn kwai ɓuo, ǝn ɓǝ ma tǝi ɗingtthǝ? I &lt;ya nung a ɓko&gt; langɓǝ dǝna dǝ than lǝ ya &lt;nung a ɓko&gt;dǝnni dǝnyitthǝ i kwai than gi ǝndǝi. <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" />Kwoi a yiɗi ya ɓui mǝ, a toi nung a langǝi tthǝ, a ji than ba nhǝm bǝ kwai bǝithǝ. Yang nungbusɔni mǝ ghaaɗing, yang mǝn yui ya angǝ a wayi, bakwɔ dǝu to nung a langǝ i lǝ yakwɔ to sakko kigǝi ɓkoni ɓǝ. <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />A ɓyea nungzuii, manung kwɔ Daa mǝ wayi dǝna ɓyǝa nungzuii yayuu ɓǝ.<verse eid="LUK 6:36" /></para>
  <para style="s">Bǝ To Kwan Lǝ Yakuntthǝ</para>
  <para style="r">(<ref loc="MAT 7:1-5">Matthew 7:1-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />&lt;&lt; Bǝ a to kwan lǝ yuu akun thǝ, yang Fuh to kwannu langɓǝ; ba laba yayuu thǝ, yang Fuh langɓǝ labamǝu. A al nung a ɓko yayuu lǝtǝ, yang Fuh a al amǝlǝtǝ. <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />Adǝ, yang i da ǝndǝ langɓǝ. Nungna a langǝ i, tam i dǝtthǝ, kusungǝ dǝna alǝtǝ, i alatthǝ logwamǝ. Bakwɔ i nung nakwɔ a nakwɔ, i natthǝ manungɓǝ ni.&gt;&gt;<verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />Yeso gei bǝ liba kwɔ tthǝ angǝ:&lt;&lt; Ya nung ɓuommi a ɓuan a muo na kab lǝ ya nung ɓuommi? I ǝndǝi i o dang ɓua wa? <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" />Yuu kwɔ dǝna nanung pǝl ya nanatthǝ nungǝu, kwoi yuu kwɔ nǝ na nung matthǝ yang a natha i ya nkonatthǝnung gu.<verse eid="LUK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41" />&lt;&lt;Baɓǝ bǝ dǝma ɓyǝa yui kong kab nung youngmǝ, yang a ɓyǝa gong kong kab kwɔ nungmǝ ɓǝwa? <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />Baɓǝ ma gei youngmǝ mangǝ, &lt;Youngǝm, dǝi sua ǝn lǝi yui kong kab nungmǝ,&gt; yangbǝ a ɓyǝa la langǝ i a ilǝ gong kong kab kwɔ nung youngmǝ ɓǝ? Mǝ ǝn ya pǝllǝ, a osi a lǝi nung nungmǝ, yangbǝ a ɓyǝa bǝi kaitthǝ a lǝi a nung youngmǝ.<verse eid="LUK 6:42" /></para>
  <para style="s">Kab I Siu</para>
  <para style="r">(<ref loc="MAT 7:16-20">Matthew 7:16-20</ref>; <ref loc="MAT 12:33-35">12:33-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />&lt;&lt; Kab a langǝ i si si kab a ɓko, langkwoi kab a ɓko si sikab a langǝ iu. <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" />I ɓyǝa kab tthǝn tthǝ siu. Yayuu ɓuan har gol tthǝ kab kobbu, ko i har inabi tthǝ kobbu. <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" />Yuu a langǝ i ilǝ nung a langǝ i kwɔ u gǝm dang wuo lǝɓǝ, Yuu a ɓko ilǝ nung a ɓko kwɔ u gǝm dang wuo lǝɓǝ. Bakwɔ nwa dǝna ɓyǝam nungkwɔ dang wa gǝmɓǝ.<verse eid="LUK 6:45" /></para>
  <para style="s">Ya Maikǝm Ya Yigǝi I Ya Sullǝ</para>
  <para style="r">(<ref loc="MAT 7:24-27">Matthew 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />&lt;&lt;Ən baɓǝ bǝ dǝɓa lubǝim lǝ,&lt;Dangbang, Dangbang,&gt; yang ɓa to nungkwɔ ǝn gei ɓǝu? <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />Yuu kwɔ ǝndǝi wuo suam wuu lǝ bam yang tolǝ nung to lǝu yang mǝn gei ɓǝtthǝ u ǝn yittǝn. <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />U itha i yiɓǝi kwɔ dǝna mai kǝmɓǝ, u tha pi kǝm tuutthǝ u li pikǝm lotal. Kwɔ dual kyal wuo pikǝm ɓǝ, kwoi kǝm ɓǝ thǝuri lǝu, bakwɔ u mai kǝm ɓǝ maɗing ɓǝ. <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />Kwoi yuu kwɔ nǝlǝ bam yang tolǝ nung to lǝu u natha i yuu kwɔ mai gwoi gu lo sua zuii ɓǝ. Nungbǝi akwɔ dual kyal pigwoi lǝ, yang gwoi ɓǝ a dǝrr ǝndǝi.&gt;&gt;<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">Yeso Dǝtthǝla Lǝ Thǝb Gi Ya Taɓui Ya Romawa</para>
  <para style="r">(<ref loc="MAT 8:5-13">Matthew 8:5-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />Kwɔ Yeso alo bǝ gei bakwɔ ɓuasui yayuu ǝndǝi, u tǝ Kafarnahum. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />Thǝb yikku ya taɓui ya Romawa akun tthǝ, kwɔ togwoi gu yiɗiu ni ɓǝ, tthǝu lko bo al nwa ɓua. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />Kwɔ yikku taɓui ya Romawa lǝ nwaba Yeso u tum yakun dang yakku ya Yahudawa suko lǝ, dǝnni yiɗi angǝ u wuo wuu dǝ tthǝla lǝ thǝb ɓǝ. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />Kwɔ i wua sua Yeso, wui ɗyǝab bu dang wa kun, &lt;&lt;Yiɓǝi kwɔ natthǝng kwɔ ma nwongǝu ɓǝ, <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />bakwɔ dǝnnu yiɗi losua ɓi langkwoi u maiɓi kǝm kǝbtha tthǝ,&gt;&gt; <verse eid="LUK 7:5" /><verse number="6" style="v" sid="LUK 7:6" />Nungkwɔ Yeso pa suatha i ilǝ.</para>
  <para style="p" vid="LUK 7:6">U tutha i gwoi lǝ lǝu yang yikku ɓǝ tum ya ǝnthǝu tǝi gei Yeso angǝ,&lt;&lt;Yikku, ba to lomǝ lǝzuii thǝ, ǝn kǝn kwɔ ma wɔ gwoim ɓǝlǝu. <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />Nungkwɔ ǝn lǝi lom kǝn kwɔ mǝn wuo suamǝ ɓǝlǝu. Kwoi a gei ba, yang thǝbbǝm a tǝi tthǝla. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />Bakwɔ ɓang i nam ǝn yuu i ttha ɓǝ, i ya taɓui suam lǝ. Ən gei yuukwɔ,&lt;Atǝ,&gt;yang u pa; langkwoi yuu kullo, &lt;A wuo,&gt;yang u wuo. Ən gei thǝbǝm, &lt;A to nung kwɔ,&gt;yang u to.&gt;&gt;<verse eid="LUK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9" />Kwɔ Yeso lǝ nungkwɔ, lo fǝm tthǝ ba gu, u mǝrrǝm u gei lǝ kon yayuu kwɔ dǝna muo suo kwɔ angǝ,&lt;&lt;Ən gei ɓǝtthǝ, Ən tǝi bǝ dǝnyitthǝ ghaa manungkwɔ ni lǝu ko dang Israila ǝndǝi.&gt;&gt; <verse eid="LUK 7:9" /><verse number="10" style="v" sid="LUK 7:10" />Ərr Ya nwatummi ɓǝ kwoi tǝ gwoi tǝtǝi thǝb ɓǝ tǝi tthǝllang.<verse eid="LUK 7:10" /></para>
  <para style="s">Yeso Ərrlǝ Yui Ayiɓǝi Ya Siɓui</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />Sua tulǝu, Yeso tǝ gwoi angǝ a akun angǝ Nayin, ya nanung to gu i kon yayuu kpaatthǝ tǝsuatha i ulǝ. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />Kwɔ u gɓag nwalǝgwoi ɓǝ, i lǝi kwamɓui yuu dǝnni ilǝ u kun lǝ yui nagu, yisi ɓǝn siɓui. Kon yayuu kpaatthǝ dang gwoi angǝ a lǝ i ulǝ. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />Kwɔ Dangbang ɓyǝko ni, u ɓyǝa nung zuii gu dang wko lǝ, u geiu angǝ,&lt;&lt;Ba tasui thǝ,&gt;&gt;<verse eid="LUK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 7:14" />Nungkwɔ u thko tǝu kǝn natthǝ kab kwɔ i talǝ kwamɓui yuuɓǝ ɓǝ, yakwɔ lǝi kwamɓui yuu ɓǝ dǝi. Yeso gei angǝ,&lt;&lt;Baittha! Ən gei lǝ a ǝrr!&gt;&gt; <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />Kwamɓui yuu ɓǝ ǝrr ǝǝ nǝpi baipi bǝ gei ba, Yeso kwoiu lǝ dǝlǝ Na gu.<verse eid="LUK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16" />Tthǝ vulli mui ǝrr i kha Fuh, i gei angǝ,&lt;&lt;Gong ya gei ba a tthasi fuk dang ɓi lǝng, Fuh wuo bǝ nwong yayuu gu.&gt;&gt; <verse eid="LUK 7:16" /><verse number="17" style="v" sid="LUK 7:17" />Nwa bakwɔ lo Yeso kwɔ lǝi losua Yahudiya i losua akwɔ gɓag gi ǝndǝi ɓǝ.<verse eid="LUK 7:17" /></para>
  <para style="s">Ya Nwatummi Gi Yohanna Ya Wollmung</para>
  <para style="r">(<ref loc="MAT 11:2-19">Matthew 11:2-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />Kwɔ ya nanung to gi Yohanna geiu bakwɔ tthǝ, u lubǝi yayuu rab dang ya nanung to gu, <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />u tummi sua Dangbang tǝi ɓibbu,&lt;&lt;Ən mǝlǝ yuukwɔ dǝna wɔ ɓa, ko ɓi ki yuu a kun?&gt;&gt;<verse eid="LUK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20" />Kwɔ yayuu ɓǝ wuo sua Yeso, i gei angǝ,&lt;&lt;Yohanna ya wollmung tum ɓi sua mǝ lǝ angǝ ɓi ɓibba, &lt;Ən mǝ kwɔ ma wɔ ɓa, ko ɓi ɓilo yuu a kun na?&gt;&gt;&gt;<verse eid="LUK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21" />Lona lǝ kullɔ Yeso dǝ tthǝla lǝ yanungzii yayuu kpaaɗing, nungzii i wa a ɓko, u ɓko nung yayuu kpaatthǝ kwɔ ɓyǝa bǝiu ɓǝ. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />Nungkwɔ u gei lǝ ya nwatummi gi Yohanna ɓǝtthǝ angǝ, &lt;&lt;Ɓa kwoi ɓatǝ sua Yohanna tǝɓa geiu nungkwɔ ɓa ɓyǝa ɓǝ langkwoi ɓalǝ ɓǝ: Ya nungɓuommi dǝna ɓyǝa bǝi, Ya kuglǝ dǝna thko, yakwɔ nungzii ǝmbǝlai kwɔ i tǝi tthǝla, ya ɓuomsui dǝna lǝbǝi, kwamɓui yuu ǝrr, ya yiɓko lǝ ba a langǝ i. <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />Bǝ khana lo yuu kwɔ olǝ bam lǝu ɓǝ.&gt;&gt;<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />Tthasua kwɔ ya nwatummi gi Yohanna pa, Yeso tǝbǝ gei ba gi Yohanna lǝ kon yayuu tthǝ angǝ: &lt;&lt;Kwɔ ɓa tǝ sua Yohanna losua kwi ɓǝtǝn dǝɓa yiɗi bǝ ɓyǝko? Gug a goni kwɔ wa dǝna ɓuob dǝna tǝmsua ɓa? <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />Nǝ nilǝu Ɓǝ, ɓa tǝnbǝ ɓyǝa ɓǝ? Yuu akun li nunglitthǝ mattha? Nilǝu, yakwɔ linung manungkwɔ nikwɔ tthǝng gwoi yigwoi. <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />Kwoi ǝn ɓǝtǝn ɓa tǝbǝ ɓyǝko? Ya gei ba a tthasi? Ni, ǝn gei ɓǝtthǝ, pǝll ya gei ba a tthasing. <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" />Yuu kwɔ lǝ yuukwɔ i vullǝ nunglǝ ba gu ɓǝ:</para>
  <para style="q1" vid="LUK 7:27">&lt;&lt;&lt;Mǝn tum ya nwatumim a osi mǝ,</para>
  <para style="q2" vid="LUK 7:27">yuu kwɔ a mabba nunglǝi tthǝɓǝ.&gt; <verse eid="LUK 7:27" /><verse number="28" style="v" sid="LUK 7:28" />Ən gei ɓǝtthǝ, dang yakwɔ yasi sikwɔ yuu akun yangǝu kǝn Yohannǝu; &lt;&lt;Kwoi yuu kwɔ lǝ a tuab dang bǝ lo yigwoi Fuh pǝll Yohanna ko krǝ u ǝn nung akun lǝu ɓǝ.&gt;&gt;<verse eid="LUK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29" />Yayuu ǝndǝi, i ya muo nungǝmmi ǝndǝi kwɔ lǝ bakwɔ, i gwab angǝ nung lǝi Fuh lǝ a langǝ i, bakwɔ Yohanna wollimung ɓǝ. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />Kwoi ya Farisiyawa i yakwɔ ibǝ nung zuu gi Musa la nungkwɔ Fuh dǝna yiɗi ɓǝ, bakwɔ ǝn Yohanna wollimung lǝu ɓǝ.<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />&lt;&lt;Mǝn na, ya dang wam kwɔ lǝnɓǝ? I itha i ɓǝ? <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />I manung Yathang kwɔ ǝǝ dang lomu dǝi lubǝ tha angǝ:</para>
  <para style="q1" vid="LUK 7:32">&lt;&lt;&lt; Ɓi ɓǝ ɓitthǝ,</para>
  <para style="q2" vid="LUK 7:32">ɓa nabdang lǝu;</para>
  <para style="q1" vid="LUK 7:32">ɓi lubɓin ɓua,</para>
  <para style="q2" vid="LUK 7:32">ɓa tasui lǝu.&gt;<verse eid="LUK 7:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="LUK 7:33" />Yohanna ya wollmung wuo, tang nungǝu nwa mungǝu, yang ɓa gei ɓangǝ, &lt;Wa tthǝu.&gt; <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />Yui Yuu wuo dǝna tang dǝna nwa, yang ɓa gei ɓangǝ,&lt;Ya nungtang kwɔ i ya nwamun, ǝnthǝ ya muo nungǝmmi i ya &lt;&lt;nung a ɓko.&gt;&gt;&gt; <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />Kwoi yiggǝi gi Fuh ǝǝlǝ nung a langǝ i tthǝ yakwɔ muo ɓǝ.&gt;&gt;<verse eid="LUK 7:35" /></para>
  <para style="s">Yeso Dangwoi Gi Saminu Ya Farisiyawa</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />Yuu akun dang ya Farisiyawa lubǝ Yeso angǝ tǝu tang nung a nungluii i ilǝ, nunkwɔ u tǝ gwoi ya Farisiyawa ɓǝ u ǝǝsua bǝ tangnung. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />Kwɔ yisi akun gwoi angǝ a kwɔ dǝna to nung a ɓko lǝ angǝ Yeso dǝna tang nung dang gwoi ya Farisiyawa, u wuo bǝi ɓǝ i gǝu turare,<verse eid="LUK 7:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 7:38" />u dǝi tthasua Yeso lǝ dǝnnu tasui, dǝu al mungnung lobo. Yang dǝnnu faa i byang lo, dǝnnu sumbacǝ bo yang dǝnnu al nui ɓǝtthǝ kwɔ kummu lani ɓǝ. <verse eid="LUK 7:38" /><verse number="39" style="v" sid="LUK 7:39" />Kwɔ ya Farisiyawa kwɔ lubǝiu kwɔ ɓyea nungkwɔni u nhǝm dang wko angǝ, &lt;&lt; Nǝ yiɓǝi kwɔ ǝn ya gei ba a tthasi yang, u ibǝi yuu kwɔ dǝna kǝn na tthǝu iri yisi anwɔ dǝna kǝn na tthǝu ɓǝ- u ǝn ya nung a ɓko.&gt;&gt;<verse eid="LUK 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40" />Yeso gwabbu nwa angǝ, &lt;&lt;Saminu, ɓangtthǝ i nungkwɔ mǝn gei tthǝɓǝ.&gt;&gt;</para>
  <para style="p" vid="LUK 7:40">U gei angǝ, &lt;&lt;A geim tthǝ ya nanatthǝnung,&gt;&gt;<verse eid="LUK 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41" />&lt;&lt;Yayuu rab muo than na ya dǝ than. Yuu akun muo nungkurɓǝ a yummi thǝmsob ɓua rab ǝrr ilo thǝmnu yuu akun muo nungkurɓǝ thǝmrab pǝmna sob. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />Yuu akun yangǝu tǝi nungkurɓǝ kwɔ a kwai lǝ ɓǝu, nungkwɔ u yafǝ gi than ɓǝtthǝ ǝndǝi nǝ rab gi. Lakwɔ ǝn yi dang ǝi kwɔ a yiɗiu a pǝll akun?&gt;&gt;<verse eid="LUK 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43" />Saminu gwab nwa angǝ,&lt;&lt;Lko yuu akwɔ than gu kpaatthǝ ɓǝ kwɔ i yiutthǝ ɓǝ.&gt;&gt;</para>
  <para style="p" vid="LUK 7:43">Yeso gei angǝ,&lt;&lt;A gei kwan ɓǝ lozuiiu.&gt;&gt;<verse eid="LUK 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44" />U kwoi tthǝ yisi lǝ u gei Saminu angǝ,&lt;&lt;A ɓyǝa yisi kwɔgnhaa? Ən wuo gwoi mǝ a dǝm mungki yangbǝ ǝn ɗigǝ lǝ bom lǝu, kwoi u ɗigǝ bom i mung nungǝu u faa i byang lo. <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />A kǝp lom i sumba lǝu, yisi kwɔ, lona kwɔ ǝn tǝ gwoi mǝ, u yitthǝ bǝ sumbace bom lǝu. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />A al nui lom lǝu, kwoi u al turare lo bom. <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />Lakwɔ, ǝn geitthǝ nung a ɓko gu kwɔ kpaatthǝ kwɔ i al lǝtǝng bǝ yiɗi bǝi gu ɗing.&gt;&gt; Kwoi yuu kwɔ i al nung a ɓko gu lǝtǝ tuab ɓuo bǝ yiɗi bǝi gu tuab ɓuo.&gt;&gt;<verse eid="LUK 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48" />Nungkwɔ Yeso gei yisi ɓǝ angǝ,&lt;&lt; I al nung a ɓko mǝ lǝtǝng&gt;&gt;<verse eid="LUK 7:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49" />Sua yayol kwɔ bǝi lǝ kwɔ tǝbǝ gei ba ɓuai,&lt;&lt;Yuu kwɔ ǝn yittǝn bǝ dǝnnu al nung a ɓko yayuu lǝta?&gt;&gt;<verse eid="LUK 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50" />Yeso gei lǝ yisi ɓǝ angǝ,&lt;&lt; Bǝ dǝba a langǝ i mǝ nwonghang; a tǝ dang tthǝla.&gt;&gt;<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s">Yasi Kwɔ Muo Sua Yeso Ɓǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />Tthasua nungkwɔ, Yeso thko dǝna tǝ gwoi angǝ a i a tuab, dǝna gei ba a langǝ i gi Fuh. Ya nanung to gu sob iu rab suo lǝ, <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />i yasi kwɔ Yeso ilǝ nung zii wa i nung zii tthǝi lǝ ɓǝ: Maryamu kwɔ dǝi (lu angǝ Magadaliya) kwɔ i ilǝ wa nanaira tthǝu ɓǝ; <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />Suzanatu si gi Kuza, yiku dang gwoi gi Hiridus; Suzanatu, i yasi akun kpaatthǝ kwɔ i to nung to i nung nai lǝ ba Yeso i ya nanung to gu ɓǝ.<verse eid="LUK 8:3" /></para>
  <para style="s">Bǝ Liba Loya Nungbyǝa</para>
  <para style="r">(<ref loc="MAT 13:1-9">Matthew 13:1-9</ref>; <ref loc="MRK 4:1-9">Markus 4:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />Kon yayuu dǝna wɔ sua Yeso gwoi angǝ a kwɔ i gwoi angǝ a a kullo; kwɔ kon yayuu gǝmtha, Yeso gei bǝ liba kwɔ tthǝ angǝ: <verse eid="LUK 8:4" /><verse number="5" style="v" sid="LUK 8:5" />&lt;&lt;Ya nung lǝbbi akun tǝ bǝ bie nung. Dǝu wurǝ nungbyǝa gu, nungbyǝa ɓǝ yakun al lo nunglǝi; yayuu dǝna thko lo, Nurug wuo yi wu kǝm ee. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />Yakun al lo tal pangsua, kwɔ i pi, i yuilǝ bakwɔ tǝmmi yangǝu bǝilǝu ɓǝ. <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />Nungbyǝa ɓǝ yakun al dang kob, i ghaa suattha kob ɓǝ mui dǝ sua. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />Nungbyǝa ɓǝ yakun al lo sua a langǝ i. I ghaa i ilo matthǝ, nungǝi to thǝm nu pǝl nungkwɔ i bie ɓǝ.&gt;&gt;Yeso alo angǝ, &lt;&lt;Ɓalǝ, yang, nǝ ɓǝtthǝ i ɗuogsui ɓǝ.&gt;&gt;<verse eid="LUK 8:8" /></para>
  <para style="s">Nungkwɔ I Gei Bǝ Liba Lǝ Bko Ɓǝ</para>
  <para style="r">(<ref loc="MAT 13:10-17">Matthew 13:10-17</ref>; <ref loc="MRK 4:10-12">Markus 4:10-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />Ya nanung to ɓib Yeso angǝ ǝn ɓǝlǝ bǝ liba kwɔ a gei ɓa. <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />U gwab nwa angǝ,&lt;&lt; Bǝ ibǝ nung a pyǝa bǝ lo yigwoi Fuh i dǝ ɓǝng, kwoi sua yayuu a wuitthǝ nunglǝi bǝ liba, yangbǝ i ɓuan i ɓyǝa yang i ɓyǝko, i lǝ yang i ibǝiu.<verse eid="LUK 8:10" /></para>
  <para style="s">Yeso Gei Maana Bǝ Liba Loya Nungbyǝa</para>
  <para style="r">(<ref loc="MAT 13:18-23">Matthew 13:18-23</ref>; <ref loc="MRK 4:13-20">Markus 4:13-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />&lt;&lt;Nungkwɔ nungɓǝ lǝ bǝ liba ɓǝ: Nungbyǝa ɓǝ nungɓǝ lǝ ba gi Fuh. <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />Nungbyǝa akwɔ al lo nunglǝi nungɓǝ lǝ lǝ yakwɔ lǝ ba, kwoi mungkullum wuo lǝi ba ɓǝ dang nyii yangbǝ u nanni bǝ dǝ ba a langǝ i tthǝ langkwoi bǝ i tǝi nwongǝi thǝ. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />Nungbyǝa akwɔ al lo ɓǝmɓǝm tal i manungi yakwɔ lǝba i muo i tthǝla. Kwoi yǝngǝi tǝ tulǝu dang tthǝi; i dǝ ba a langǝ i tuab ɓuo kwoi nǝ lona bǝ nabǝi nǝ wuo, yang i o. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />Nungbyǝa akwɔ al dang kob kwɔ i manung yakwɔ lǝ ba; kwoi bǝ ǝrr lǝ kiggǝ, i nungtǝi i tthǝla longwam kwɔ kwarri langkwoi tthaklǝi, siei ɗuonglǝu. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />Nungbyǝa akwɔ al losua a langǝ i kwɔ i ɓǝlǝ yakwɔ lǝ ba gi Fuh i muo i dǝ dang wai i tolǝ nung to, i dǝ lotthǝ wui ilǝ lo.<verse eid="LUK 8:15" /></para>
  <para style="s">Fitilǝ Kwɔ I Bǝrnung Lo Ɓǝ</para>
  <para style="r">(<ref loc="MRK 4:21-25">Markus 4:21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />Yayuu dǝ lua tthǝ fitilǝ yang ka i kongnungǝu ko i dǝ pi nung lo lǝu. I dǝ fitilǝ ɓǝ lo nung dǝu, yangbǝ yayuu ɓyǝa lua nungbǝi akwɔ dǝnni wuo dang gwoi ɓǝ. <verse eid="LUK 8:16" /><verse number="17" style="v" sid="LUK 8:17" />Nungkwɔ i pyǝa kwɔ i ilǝ nung gwambǝi, nungkwɔ ǝndǝi langkwoi i kalo i tǝi i wulǝ nwa lua. <verse eid="LUK 8:17" /><verse number="18" style="v" sid="LUK 8:18" />&lt;&lt; Ɓa to kiggǝ, yang, kwɔ ɓa lǝ bǝi ɓǝ; bakwɔ yakwɔ tthǝ i nung i liǝ lo, kwoi yakwɔ nung yangǝu nkokwɔ i akwɔ dǝnnu nhǝm naiukwɔ i mua nkolǝ i lǝi.&gt;&gt;<verse eid="LUK 8:18" /></para>
  <para style="s">Nagi Yeso I Ya Youngǝu</para>
  <para style="r">(<ref loc="MAT 12:46-50">Matthew 12:46-50</ref>; <ref loc="MRK 3:31-35">Markus 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />Nagi Yeso i ya youngǝu wuo suo, i ɓuan i kǝn tthangǝu lǝu lǝ ba kon yayuu. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />Yuu akun gei Yeso angǝ,&lt;&lt;Na mǝ i ya youngmǝ dǝi gwam kwɔ dǝi yiɗi bǝ ɓyǝa.&gt;&gt;<verse eid="LUK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21" />Kwoi Yeso geitthǝ ǝndǝi angǝ,&lt;&lt;Nam i ya youngǝm ǝn yakwɔ dǝna lǝ bagi Fuh dǝnni dǝ ba a langǝ i tthǝɓǝ.&gt;&gt;<verse eid="LUK 8:21" /></para>
  <para style="s">Yeso Dǝilǝ Wamung</para>
  <para style="r">(<ref loc="MAT 8:23-27">Matthew 8:23-27</ref>; <ref loc="MRK 4:35-41">Markus 4:35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />Vii akun Yeso tǝ dang kwai i ya nanung to gu u gei angǝ, &lt;&lt;Ɓi nyang ɓitǝ nwangwam akulo,&gt;&gt; Nungkwɔ i tǝ dang kwai i pa. <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />Kwɔ dǝi bai kwai ɓǝ dǝnni tǝ, Yeso tǝbǝ lo nung lo. Dangtthǝ wa dǝna ɓuob nyimtthǝ lo mung lǝ, yang mung tǝbǝ yi kwaiɓǝ, i ǝndǝi dang ɓua. <verse eid="LUK 8:23" /><verse number="24" style="v" sid="LUK 8:24" />Ya nanung to gu tǝ sua Yeso tǝ ǝrrǝu lǝ, angǝ,&lt;&lt;Yuu gwoi, Yuu gwoi! Dǝɓi tǝbǝ ɓui!&gt;&gt;</para>
  <para style="p" vid="LUK 8:24">Yeso ǝrr dǝi nǝbo dǝ kab nwa wa ɓǝ i nung lo kwɔ mung dǝna toɓǝ; wa kwoi tǝ sua, bǝ tǝngǝlǝ mung tǝmnǝkwam.<verse eid="LUK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 8:25" />Yang u gei ya nanung to gu angǝ,&lt;&lt;Bǝ dǝba a langǝ i ɓǝ ɓǝla?&gt;&gt;</para>
  <para style="p" vid="LUK 8:25">Kwoi loi fǝm tthǝi tǝbǝ survulli, dǝi gei lǝ thatthǝ, &lt;&lt;Yiɓǝi kwɔ ǝn yittǝn ni? Dǝu dǝ kabnwa waa i bǝ tǝngǝlǝ mung, dǝnni lǝu!&gt;&gt;<verse eid="LUK 8:25" /></para>
  <para style="s">Yeso Dǝ Tthǝla Lǝ Yiɓǝi Ya Wa A Ɓko</para>
  <para style="r">(<ref loc="MAT 8:28-34">Matthew 8:28-34</ref>; <ref loc="MRK 5:1-20">Markus 5:1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />Yeso i ya nanung to gu nyang tǝ losua Garasinawa, kwɔ gwam nwam na ǝrr Galili ɓǝ.<verse eid="LUK 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 8:27" />Kwɔ Yeso pin nwangwam mung lǝ, yiɓǝi akun kwɔ wa tthǝu gwoi angǝ a lǝ. Sua tuung yiɓǝi kwɔ dǝna thko pi nǝkwam u li nunglitthǝu langkwoi u ǝǝ gwoiu, kwoi dǝu ǝǝ bǝ suu yuu. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />Kwɔ u ɓyea Yeso, u tasui i yoll tǝyitthǝ, u bai nwalongǝu tthasiu, langkwoi ɓuob nwa,&lt;&lt;Yeso, Yui Fuh Ya Wayi! Ənɓǝ dǝma yiɗi i ɓanglǝ? Dǝm ɗyǝaba, ba dǝm zui thǝ!&gt;&gt; <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />Bakwɔ Yeso osi ilǝ wa a ɓko tthǝulǝng ɓǝ. Bo pak nǝkwam wa ɓǝ dǝna lǝiu, dǝi tthǝbbu, langkwoi wa ɓǝ mǝrrǝmu lǝ ya pursǝna, i tthǝb nko i bo i sarka, kwoi yang lang u ɓǝr sarka ɓǝ yang wa ɓǝ tǝu lǝ losua a kwi.<verse eid="LUK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30" />Yeso ɓibbu angǝ,&lt;&lt;Ɗuǝn mǝ ǝn ya?&gt;&gt;U gwabnwa angǝ.&lt;&lt;Ɗuǝn nǝm ǝn tuli,&gt;&gt;bakwɔ wa kpaaɗing tthǝu lǝɓǝ. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />Wa ɓǝ ɗyǝab Yeso bǝ u nanni u tǝlǝ dang kong ɓua lua kwɔ tuni ɓǝ.<verse eid="LUK 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32" />Thag tthǝ kpaatthǝ bǝi lǝ gɓag pital dǝi tang nung. Nungkwɔ wa ɓǝ ɗyǝab Yeso angǝ u yii itǝ tthǝ Thag ɓǝ, nungkwɔ u gwabǝitthǝ. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />I wa ɓǝ itthǝ yiɓǝi lǝ itǝ tthǝ Thag ɓǝ. Kon Thag ɓǝ pa i dum tǝ al nung mung i ɓui ǝndǝi.<verse eid="LUK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34" />Yaɓǝi kwɔ dǝna gagci Thag ɓǝ ɓyea nungkwɔ to nung kwɔ, I padum tǝi gei baɓǝ gwoi angǝ a dang ya nunglǝbi. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />Yayuu i tǝbǝ ɓyǝa nungkwɔ to nung ɓǝ, i wuo sua Yeso, wui tǝi yiɓǝi ɓǝkwɔ wa ɓǝ i tthǝu kwɔ ǝǝ tthang Yeso, i nunglitthǝ gu i kiggǝu tthǝu.<verse eid="LUK 8:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 8:36" />Yayuu kwɔ ɓyǝa nungkwɔ to nungkwo gei lǝ yayuu manungkwɔ wa ɓǝ itthǝu ɓǝ. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />Nungkwɔ yayuu losua Garasinawa ǝndǝi gei Yeso angǝ pa, bakwɔ tthǝi survulli ghaani ɓǝ. Nunkwɔ Yeso tǝ dang kwai pa nung gu. <verse eid="LUK 8:37" /><verse number="38" style="v" sid="LUK 8:38" />Yiɓǝi ɓǝkwɔ wa ɓǝ itthǝu kwɔ ɗyǝab Yeso angǝ,&lt;&lt;Mǝn pa sua tha i mǝ.&gt;&gt;</para>
  <para style="p" vid="LUK 8:38">Kwoi Yeso duu sua, angǝ, <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />&lt;&lt;A tǝ gwoi ta gei nungkwɔ Fuh toǝ tthǝɓǝ.&gt;&gt;Yiɓǝi ɓǝ thko dang gwoi angǝ a lǝ, dǝna gei nungkwɔ Yeso tou tthǝ ɓǝ.<verse eid="LUK 8:39" /></para>
  <para style="s">Yui Yayirus I Yisi Kwɔ Kǝn Natthǝ Nungɓuobtthǝ Gi Yeso Ɓǝ</para>
  <para style="r">(<ref loc="MAT 9:18-26">Matthew 9:18-26</ref>; <ref loc="MRK 5:21-43">Markus 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />Kwɔ Yeso kwoi nyang gwam nwam a kullo, Yayuu kǝb lo, bakwɔ lakuu dǝnni kiu ɓǝ. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />Yang yiɓǝi akun ɗuǝnu ǝn Yayirus wuo; u ǝn yikku kǝm kǝbtha ya Yahudawa. U bai nwalongǝu sua dang si Yeso, u ɗyǝab bu angǝ u tǝ gwoi gi, <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />bakwɔ yuiu a yisi kun kwɔ, thko sob iu rab, dǝna tǝbǝ ɓui ɓǝ.</para>
  <para style="p" vid="LUK 8:42">Kwɔ Yeso dǝna tǝ, kon yayuu dǝna kyǝa bǝ tammu. <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />Dang kon lǝ yisi akun tthǝ kwɔ dǝna to zuii tha sob iu rab zii dǝna al tthǝu; kwoi yuu yangǝu ɓuan duu tthǝlko. <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />U wuo tthasua Yeso wuu kǝn natthǝ nwa nunglitthǝ gu, ba a nwaɓi kwɔ dang tthǝ nwa zii ɓǝ dǝi.<verse eid="LUK 8:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45" />Yeso ɓib angǝ,&lt;&lt;Ənyiǝ kǝnna tthǝm?&gt;&gt;I ǝndǝi yernwa, Bitrus gei angǝ,&lt;&lt;Yuu gwoi, yayuu yibǝi dǝnni tog tha lǝ bamǝ.&gt;&gt;<verse eid="LUK 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46" />Kwoi Yeso gei angǝ,&lt;&lt;yuu a kun kǝn natthǝm; ǝn ibǝi kwɔ ttha i tthǝm ɓǝng.&gt;&gt; <verse eid="LUK 8:46" /><verse number="47" style="v" sid="LUK 8:47" />Kwɔ Yisi ɓǝ ibǝing ɓuan pyǝa lou, u wuo tthǝu dǝna ɓuobtthǝm u bai nwalongǝu sua tthasi Yeso. Bǝi lǝ nung yayuu ǝndǝi, u gei nungkwɔ to kwɔ u kǝn natthǝu langkwoi kwɔ u tǝi tthǝla nwa kun ɓǝ. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />Yeso geiu angǝ, &lt;&lt;Yui a yisi, bǝ dǝba a langǝ i mǝ da tthǝlang. Atǝ dang tthǝla.&gt;&gt;<verse eid="LUK 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />Kwɔ yirrǝ Yeso dǝna gei bakwɔ, ya nwatummi wuo gwoi yikku Yayirus angǝ. &lt;&lt;Yui mǝ a yisi ɓǝ ɓuing; bǝ ɓa ɓar ya nanatthǝnung kwɔ a kunthǝ.&gt;&gt;<verse eid="LUK 8:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50" />Kwoi Yeso lǝ nungkwɔ ni u gei Yayirus angǝ, &lt;&lt;Ba survulli thǝ; a dǝ ba langǝ itthǝ ɓuo, yang u tǝi tthǝla.&gt;&gt;<verse eid="LUK 8:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51" />Kwɔ Yeso tǝ dang gwoi gi Yayirus ɓǝ, u yiɗi kwɔ yuu a kun a tǝ suatha i ulǝ lǝu ǝn Bitrus ɓuo, Yohanna i Yakubu Daagi yuiɓǝ i Na gu.<verse eid="LUK 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 8:52" />Yakwɔ bǝi lǝ kwɔ dǝna tasui dǝi bai nazuii lǝ ba yui ɓǝ. Yeso gei angǝ,&lt;&lt;Bǝɓa tasui thǝ; yui ɓǝ ɓui lǝu dǝu lo nung lo!&gt;&gt;<verse eid="LUK 8:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53" />I ǝndǝi i mammu, bakwɔ i ibǝi u ɓuing ɓǝ. <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />Kwoi Yeso muo na yuiɓǝ lubǝi angǝ, &lt;&lt; Yuim a ǝrr!&gt;&gt; <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />Killǝngǝu kwoi wuo tthǝu, dang tthǝ u ǝrr u dǝi nǝbo nwa kun, nungkwɔ Yeso gei angǝ i duu nung a kun u tang.<verse eid="LUK 8:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 8:56" />Lo da gu i na gu fǝm, kwoi Yeso gei angǝ bǝ i gei lǝ yuu a kun tthǝ nungkwɔ to nung ɓǝtthǝ.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s">Yeso Tum Ya Nanung To Gu Sob iu Rab</para>
  <para style="r">(<ref loc="MAT 10:5-15">Matthew 10:5-15</ref>; <ref loc="MRK 6:7-13">Markus 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />Yeso lubǝ ya nanung to gu sob iu rab wuu gǝm u ji ttha i tthǝnyimmi yangbǝ i ilǝ wa a ɓko i bǝ dǝ tthǝla lǝ ya nung zii. <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />Langkwoi u tummi angǝ tǝi gei ba a langǝ i lona kwɔ Fuh wa nwong yayuu gu ɓǝ langkwoi yang i dǝ tthǝlla lǝ ya nung zii. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />Yeso gei angǝ,&lt;&lt;Bǝ ɓa lǝi nung akun lǝ ba tthko ɓǝthǝ- kab baina, tthko, nungtang, nungkurɓǝ, nunglitthǝ akun thǝ. <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />Gwoi kwɔ ǝndǝi nǝ i muo ɓǝ na rab, ɓa ǝǝ dang gwoi lǝ tǝlǝ vii kwɔ ɓa yitthǝ gwoi angǝ aɓǝ ɓǝ. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" />Nǝ yayuu muo ɓǝ lǝu, yang ɓa kusungǝ kunɗur boɓǝ nǝ dǝɓa yitthǝ gwoi angǝ aɓǝ ɓǝ ɓa toni yangbǝ ǝlǝ bǝ gub ɗuogsui a lagbǝi bakwɔ i la ba a langǝ i ɓǝ.&gt;&gt; <verse eid="LUK 9:5" /><verse number="6" style="v" sid="LUK 9:6" />Nungkwɔ ya nanung to ɓǝ i pa tǝ gwoi atuab i gwoi atuab, dǝi gei ba a langǝ i langkwoi dǝnni dǝ tthǝla lǝ ya nung zii dǝnni tǝi tǝmmi.<verse eid="LUK 9:6" /></para>
  <para style="s">Kiggǝ Hiridus Ərr Lǝ Ba Yeso</para>
  <para style="r">(<ref loc="MAT 14:1-12">Matthew 14:1-12</ref>; <ref loc="MRK 6:14-29">Markus 6:14-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />Yigwoi Hiridus lǝ nungkwɔ Yeso i ya nanung to gu dǝna to kwɔ. Ərr tthǝ vulli muu, Bakwɔ yakun dǝna gei angǝ i ǝrr lǝ Yohanna dang ɓua, <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />yakun angǝ Iliya fugǝng, langkwoi yirrǝ yakun dǝna gei angǝ yuu a kun dang ya gei ba a tthasi lakuu ǝrr i nwongǝi. <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />Kwoi Hiridus gei angǝ,&lt;&lt;Ən ɓǝrr lo Yohanna yang. Ən yittǝn, yang, kwɔ dǝmǝn lǝ i nungkwɔ bagu ɓa?&gt;&gt;Hiridus dǝna yiɗi bǝ ɓyǝa Yeso.<verse eid="LUK 9:9" /></para>
  <para style="s">Yeso Tanglǝ Yayuu Thǝmsob Ɓua Thǝmkun Iu Nu</para>
  <para style="r">(<ref loc="MAT 14:13-21">Matthew 14:13-21</ref>; <ref loc="MRK 6:30-44">Markus 6:30-44</ref>; <ref loc="JHN 6:1-14">Yohanna 6:1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />Kwɔ ya nanung to ɓǝ kwoi suai, wui gei nungkwɔ i to kwɔ lǝ Yeso tthǝ. Ərr u eei i tǝ gwoi angǝ a kwɔ dǝnni luu angǝ Betsaida ɓǝ ɓuai lǝ, <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />Kwoi kon yayuu ɓǝ lǝ angǝ u bǝi lǝ i pa suo bǝi lǝ. U kǝb loi u gei ba lona kwo Fuh wa nwong yayuu gu ɓǝ, langkwoi u dǝ tthǝlla lǝ yakwɔ dǝna yiɗi bǝ tǝi tthǝlla tthǝ nungzii ɓǝ.<verse eid="LUK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12" />Natthǝ dang fuh ya nanung to gu Sob iu rab wuo suo wui gei angǝ,&lt;&lt; A gei kon yayuu kwɔ tǝ gwoi atuab akwɔ gbag bǝikwɔ yangbǝ tǝi ɗuu nungtang i bǝi kwɔ i lotthǝ ɓǝ, bakwɔ bǝi kwɔ ɓitthǝ kwɔ mangǝn dang gug.&gt;&gt;<verse eid="LUK 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13" />Yeso gei angǝ, &lt;&lt;Ɓa ji nung akun i tang.&gt;&gt;</para>
  <para style="p" vid="LUK 9:13">Kwoi i gwabnwa angǝ,&lt;&lt;Burodi ni nu ɓuo naɓi i tthǝng ni rab nǝ lkoɓi tǝ tǝɓi ɗyeab nungtang lǝ kon kutthǝ ǝndǝi.&gt;&gt;<verse eid="LUK 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 9:14" />(Yaɓǝi thǝmsob ɓua thǝmkun iu Nuu bǝi lǝ.)</para>
  <para style="p" vid="LUK 9:14">Kwoi Yeso gei lǝ ya nanung to gu angǝ, &lt;&lt; Ɓa gei i ǝǝ sua loi thǝm rab pǝmna sobsob.&gt;&gt;<verse eid="LUK 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15" />Ya nanung to ɓǝ to manungɓǝ, kon ɓǝ ǝndǝi ǝǝ sua. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />Yeso lǝi burodi ɓǝ kwɔ nu i Tthǝng kwɔ rab kwɔ, u lei loyi, u dǝ angǝ a lǝ Fuh u kwǝh. Ərr u dǝlǝ ya nanung to gu yangbǝ i dǝlǝ yayuu. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />I ǝndǝi i tang i fǝrr, langkwoi ya nanungto gu gǝm kwǝh nwuo kwɔ i kwɔ kaɗuog sob iu rab.<verse eid="LUK 9:17" /></para>
  <para style="s">Bitrus Gei Ən Yillǝ Yeso</para>
  <para style="r">(<ref loc="MAT 16:13-19">Matthew 16:13-19</ref>; <ref loc="MRK 8:27-29">Markus 8:27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />Kwɔ Yeso i nungtthǝu dǝna pinwa i ya nanung to gu, u ɓibbǝi angǝ,&lt;&lt;Kon yayuu dǝna gei angǝ ɓang ǝn yittǝn na?&gt;&gt;<verse eid="LUK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19" />I gwabnwa angǝ, &lt;&lt;Yakun dǝna gei angǝ mǝn Yohanna ya wollmung; yakun angǝ mǝn Iliya; langkwoi yirrǝ yakun, angǝ mǝn ya gei ba a tthasi kwɔ lakuu kwɔ ɓui u lub ɓua,&gt;&gt;<verse eid="LUK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20" />&lt;&lt;Kwoi bǝ ɓaɓaa?&gt;&gt;U ɓibǝi.&lt;&lt;Dǝɓa gei ɓangǝ ɓang ǝn yittǝn?&gt;&gt;</para>
  <para style="p" vid="LUK 9:20">Bitrus gei angǝ&lt;&lt;Mǝn Kristi kwɔ Fuh tum ɓǝ.&gt;&gt;<verse eid="LUK 9:20" /></para>
  <para style="s">Yeso Gei Ba Zuii Gu I Ɓua Gu</para>
  <para style="r">(<ref loc="MAT 16:20-28">Matthew 16:20-28</ref>; <ref loc="MRK 8:30">Markus 8:30</ref>; <ref loc="MRK 9:1">9:1</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />Yeso gei ba tthǝ nyimtthǝ bǝ i gei lǝ yuu akun tthǝthǝ. <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />U gei angǝ,&lt;&lt;Ɓang Yui Yuu ato zuii lo nung kpaatthǝ yakku a lko, ya nyǝknung i ya nanatthǝnung zuu, a thǝu yang u lo bo tai yang i ǝrrǝu lǝ i nwongǝi gu.&gt;&gt;<verse eid="LUK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23" />Langkwoi u geitthǝ i ǝndǝi angǝ,&lt;&lt;Yuu kwɔ dǝna yiɗi bǝ muo suam u yǝr lo u lǝi kab gangǝ i gu vii ǝndǝi yang u mulǝ suam. <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" />Yuu kwɔ dǝna yiɗi bǝ kang nwongǝi gu yang a lǝn la, kwoi yuu kwɔ nwongǝi gu la lǝbam yang a tǝntǝi. <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />Yayuu a tǝi nung ǝn tǝi nǝ i tǝi longwam kwoi i inai lǝ i laɓa? To tthǝu! <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />Nǝ yayuu dǝna lǝ tthǝkum i bǝ nanatthǝnungǝm, yang ɓang Yui Yuu alǝ tthǝku gi kwɔ mǝn wuo dang ghaalim i ghaali gi Daam i ya nwatummi gi Fuh ɓǝ. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />Ən gei ɓǝ ba a langǝ i tthǝ yakun tthǝ dǝi bǝikwɔ i bang ɓuko har i tǝlǝ bǝikwɔ Fuh lǝ yigwoi.&gt;&gt;<verse eid="LUK 9:27" /></para>
  <para style="s">Bǝ Mǝrrǝmtthǝ Gi Yeso</para>
  <para style="r">(<ref loc="MAT 17:1-8">Matthew 17:1-8</ref>; <ref loc="MRK 9:2-8">Markus 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />Gbag bo ǝngunnai ttha suko lǝ kwɔ Yeso gei nungkwɔ, u lubǝi Bitrus, i Yohanna, i Yakubu i ɗab tal yangbǝ tǝi pinwa. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />Kwɔ dǝnnu pinwa, dang nungǝu ǝrr mǝrrǝm, nunglitthǝ gu ǝrr kaitthǝ la vǝrǝm dǝna lǝi nung.<verse eid="LUK 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 9:30" />Dangtthǝ yaɓǝi rab dǝna gei ba i ulǝ. I Musa i Iliya dǝi gei ba i ulǝ. <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />I fug dang ghaali wayi dǝi gei ba i Yeso lǝ bakwɔ u to nungkwɔ i tummu gbag bǝ ɓuiu Urshalima lǝ. <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />Bitrus i ya ǝnthǝu dǝnni lo nung lo a ɓuoni, kwoi kwɔ i ǝrr i ɓyǝa ghaali gi Yeso i yaɓǝi kwɔ dǝi i ulǝ ɓǝ. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />Kwɔ yaɓǝi ɓǝ dǝna pa tthang Yeso, Bitrus gei Yeso angǝ&lt;&lt;Yuu gwoi, maɗing kwɔ ɓi bǝikwɔ ɓǝ! Ɓi mab tǝbǝ ni tai bǝi kwɔ, kun amǝ, kun a bǝ Musa akun a bǝ Iliya.&gt;&gt; (U ibǝ nungkwɔ dǝu gei ɓǝlǝu.)<verse eid="LUK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34" />Kwɔ yirrǝ u dang bǝ gei ba, tǝi fug wuu khai; tthǝ ya nanungto ɓǝ tǝbǝ survulli kwɔ tǝi ɓǝ wuo khai ɓǝ. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" />Yol gwab dang tǝi lǝ angǝ, &lt;&lt;Yuu kwɔ ǝn Yuim, kwɔ ǝn mko ɓǝ- ɓa lǝu.&gt;&gt;<verse eid="LUK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 9:36" />Kwɔ yol ɓǝ gei ba ɓǝ i ɓyǝa Yeso i nungtthǝu. Ya nanungto ɓǝ kǝr nungi, gei lǝ ba lǝu lona lǝ kullo lo nung kwɔ i ɓyǝa ɓǝ.<verse eid="LUK 9:36" /></para>
  <para style="s">Yeso Dǝ Tthǝlalǝ Munthang Ayiɓǝi Kwɔ I Waɓǝ</para>
  <para style="r">(<ref loc="MAT 17:14-18">Matthew 17:14-18</ref>; <ref loc="MRK 9:14-27">Markus 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />Ibǝi kan Yeso i ya nanungto kwɔ tai kwɔ pin lo tal lǝ, kon yayuu kǝb Yeso. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />Yiɓǝi akun dang kon yayuu buogbǝi angǝ,&lt;&lt;Ya nanatthǝnung! Dǝm ɗyǝaba, a ɓyǝa yuim a yiɓǝi, uɓǝ ɓuo lǝ yuim. <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />Wa tǝ tthǝu yang dǝu buogbǝi; yang lǝiu lǝi li, yang dǝu chɛ̃ fog ta yi nwuo; dǝi nwabǝ tou lang nkoniu ghaatthǝ yang yiuna thǝmtthǝu! <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />Ən ɗyǝab ya nanung to mǝ yangbǝ i ilǝ, kwoi i ɓuan lǝu.&gt;&gt;<verse eid="LUK 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41" />Yeso gwab nwa angǝ, &lt;&lt;Ɓǝnni ya dang wam nung a ɓko kwɔ ɓa dǝ ba a langǝ iu, &lt;&lt;Mǝn ǝǝ i ɓǝlǝ bo nǝnǝ mǝn lǝi munyal i ɓǝlǝ? Nungkwɔ u gei yiɓǝi ɓǝ angǝ, &lt;&lt;Wulǝ yuimǝ a yiɓǝi lǝ kanni.&gt;&gt;<verse eid="LUK 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42" />Kwɔ yuiɓǝ dǝna wɔ, wa ɓǝ wko lǝtǝ pangsua fog ta yi nwuo. Yeso dǝ kab nwa wa a ɓko ɓǝ, u dǝ tthǝla lǝ yuiɓǝ, u kwoiu lǝ u dǝlǝ Da gu. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />Yayuu ǝndǝi loi fǝm tthǝ ghaali ttha gi Fuh.</para>
  <para style="s" vid="LUK 9:43">Yeso Geiba Lobǝ Ɓuiɓua Gu A Nung Rabbu</para>
  <para style="r" vid="LUK 9:43">(Matthew 17:22, 23; <ref loc="MRK 9:30-32">Markus 9:30-32</ref>)</para>
  <para style="p" vid="LUK 9:43">Lo yayuu yirrǝ dǝna fǝm lonungkwɔ ǝndǝi Yeso dǝna toɓǝ, kwɔ u gei ya nanung to gu angǝ, <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" />&lt;&lt;Ɓa kabɓua suiɓǝ ɓa lǝ nungkwɔ dǝm tǝbǝ gei ɓǝtthǝ ɓǝ: I ɓanglǝ Yui Yuu dang na ya yuu a ɓilǝng.&gt;&gt; <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />Kwoi i ya nanung to ibǝi nungkwɔ dǝu gei ɓǝlǝu. Pimpya tthǝi lǝ yangbǝ bǝ i ibǝi thǝ, langkwoi dǝi sur bǝ ɓibbu baɓǝ.<verse eid="LUK 9:45" /></para>
  <para style="s">Ənyilǝ Yikku?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Matthew 18:1-5</ref>; <ref loc="MRK 9:33-37">Markus 9:33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />Bǝ nyimtha nwa ǝrr ganglang ya nanungto yang ǝn yiǝ dang ǝi lǝ yikku. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />Yeso ibǝ nungkwɔ dǝi nhǝm ɓǝng, nungkwɔ u lǝi muntthang a tuab u dǝ nwangwu, <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />Yeso gei angǝ,&lt;&lt; Yuu kwɔ ǝndǝi kǝb lo yuikwɔ dang ɗuǝnǝm, u kǝb ǝn ɓang; Yuu kwɔ kǝb lom, langɓǝ kǝb ǝn lo yuu kwɔ tummǝm ɓǝ. Bakwɔ yuu kwɔ lǝ atuab dang ɓǝ ǝndǝi lǝ yuu angǝ,&gt;&gt;<verse eid="LUK 9:48" /></para>
  <para style="s">Yuu Akwɔ Əndǝi Nǝ Ən Ɓuiɓǝ Lǝu Yang Ən Aɓǝ</para>
  <para style="r">(<ref loc="MRK 9:38-40">Markus 9:38-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />&lt;&lt;Yohanna gei ba angǝ, &lt;&lt;Yuu gwoi, ɓi ɓyea yiɓǝi akun dǝna ilǝ wa dang ɗuǝnmǝ, ɓi geiu ɓingǝ u yitthǝ, bakwɔ u yangǝu dang ɓiuɓǝ.&gt;&gt;<verse eid="LUK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50" />&lt;&lt;Bǝɓa nannu thǝ,&gt;&gt;Yeso geiu i sua ya nanungto angǝ,&lt;&lt;bakwɔ yuu kwɔ nǝ tthǝng ɓi lǝu yang u i ɓilǝ.&gt;&gt;<verse eid="LUK 9:50" /></para>
  <para style="s">Ya Samariyawa Labǝ Kǝb Lo Yeso</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />Kwɔ lona gbag kwɔ i lǝi Yeso i tǝlǝ wayi, ibǝ yiɗi gu u olǝi Urshalima.<verse eid="LUK 9:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 9:52" />U tum ya nwatummi osi, i tǝ gwoi ya Samariya tǝi mabzuii nung i dǝsua yangbǝ u wuo, <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />kwoi ya bǝiɓǝ kǝb lo lǝu, bakwɔ u lolǝi dǝu tǝn Urshalima ɓǝ. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />Kwɔ ya nanung to gu Yakubu i Yohanna ɓyǝa nungkwɔni, i gei angǝ,&lt;&lt;Dangbang, a gwabǝng ɓi lubǝ lua wayi wuo liǝ?&gt;&gt; <verse eid="LUK 9:54" /><verse number="55" style="v" sid="LUK 9:55" />Yeso mǝrrǝm ǝrri lǝ. <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />Yang Yeso i ya nanug to gu tǝ gwoi atuab akun.<verse eid="LUK 9:56" /></para>
  <para style="s">Zuii Bǝ Muo Sua Yeso</para>
  <para style="r">(<ref loc="MAT 8:19-22">Matthew 8:19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />Kwɔ Yeso i ya nanungto gu lilotthǝ thko gi, yiɓǝi akun gei Yeso angǝ, &lt;&lt;Mǝn muo suamǝ bǝikwɔ ma tǝtthǝ ǝndǝi.&gt;&gt;<verse eid="LUK 9:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58" />Yeso geiu angǝ,&lt;&lt;I kwintang tthǝ i ɓua gilǝ, langkwoi Nurug wayi tthǝ i kǝm gi, kwoi Yui Yuu yangǝu i bǝikwɔ a dǝ lo tthǝ ɓǝ.&gt;&gt;<verse eid="LUK 9:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59" />Yeso gei lǝ yiɓǝi akun tthǝ angǝ,&lt;&lt; A muo suam,&gt;&gt;</para>
  <para style="p" vid="LUK 9:59">Kwoi Yiɓǝi ɓǝ gei angǝ,&lt;&lt;Dangbang, dǝisua ǝn tǝ tǝn suu Daam ɗǝ.&gt;&gt;<verse eid="LUK 9:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60" />Yeso gwabnwa angǝ,&lt;&lt;A yiya ɓuiɓua suu kwamɓui yuu gi. Atǝ ta gei bǝ lo yigwoim gi Fuh.&gt;&gt;<verse eid="LUK 9:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61" />Yuu akun langkwoi yirrǝ gei angǝ,&lt;&lt;Mǝn muo sua mǝ, Dangbang; kwoi la nwasiu dǝisua ǝn tǝ tǝn yǝrnwa lǝ ya dang woi ɓiɗǝ.&gt;&gt;<verse eid="LUK 9:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62" />Yeso geiu angǝ,&lt;&lt;Yuu akun yangǝu kwɔ dǝna ɓuob nyak yang dǝna ɓyǝa suko yang u ɓuan bǝ to nung to bǝikwɔ Fuh lǝ yigwoi tthǝ ɓǝ.&gt;&gt;<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s">Yeso Tum Ya Nanungto Gu Thǝmtai Pǝmna Sob Iu Rab</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />Tthasua nungkwɔ Yeso mko ya nanungto gu thǝmtai pǝmna sob iu rab u tummi loi rabrab, i osi i tǝ gwoi angǝ a ǝndǝi i bǝi kwɔ dǝnnu yiɗi bǝ tǝu ɓǝ. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />Yeso gei angǝ,&lt;&lt;Nungɓǝri kpaaɗing, ya nung to ɓǝ kpako. Ɓa ɗyǝab Dangbang lǝ ba bǝ ɓǝr nung ɓǝ, lakwɔni, u tuog yayuu tǝbǝ ɓǝr zug ɓǝng. <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" />Ɓatǝ! Dǝm tum ɓǝ lǝ nwa i yathang ɓangam dang i ɗua gug. <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />Bǝɓa lǝi tthko nungkurɓǝ ko tthko ya yamnung thǝ ko ǝko thǝ, bǝɓa dǝi ɓa gum yuu akun nunglǝi thǝ.<verse eid="LUK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 10:5" />&lt;&lt;Nǝ ɓatǝ dang woi, ɓa osi ɓa gei ɓangǝ, &lt;ǝndǝ gwoi kwɔ&gt; <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />Nǝ yuu akun tthǝ i tthǝtǝmmi gi Dangbang dang gwoi lǝ, yang tthǝtǝmmi ɓǝ a ǝǝlo; kwoi nǝ yangǝu, a kwoi a wuu sua ɓǝ. <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" />Ɓa ǝǝ dang woi lǝ, ɓa tang ɓa nwa nungkwɔ ǝndǝi i dǝɓǝ ɓǝ, bakwɔ i dǝ nung busoni ya nung to. Bǝ ɓa thko ɓa gilǝng gwoi thǝ.<verse eid="LUK 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 10:8" />&lt;&lt;Nǝ ɓatǝ dang gwoi akwɔ nǝ i kǝb lo ɓǝ yang, ɓa tang nungkwɔ i dǝɓǝ ɓǝ. <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />Ɓa ilǝ nung zii tthǝ yakwɔ bǝi lǝ ɓǝ yang ɓa geitthǝ,&lt;Bǝ lo yigwoi Fuh gbag ɓǝng.&gt;<verse eid="LUK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 10:10" />Kwoi nǝ vii a kwɔ ǝndǝi ɓatǝ gwoi angǝ a nǝ i kǝb lo ɓǝ lǝu, ɓatǝ dang nunglǝi yang ɓa gei ɓangǝ, <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" />&lt;I kunɗur gwoi ɓǝ kwɔ muo kabo ɓi kwɔ ɓi kaɗi ɓi al lǝtǝ tthǝɓǝng. Kwoi ɓa nhǝm ɓangǝ bǝ lo yigwoi gi Fuh gbagǝng!&gt; <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" />Ən gei ɓǝ tthǝ Vii to Kwan Fuh a ɓyǝa nungzuii ya Sadoma lo ya gwoi angǝ a ɓǝ kullo!<verse eid="LUK 10:12" /></para>
  <para style="s">Bǝ Lagbǝi Lo Gwoi Angã Kwɔ Tubilǝu Ɓǝ</para>
  <para style="r">(<ref loc="MAT 11:20-24">Matthew 11:20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />A ɓko ɓǝtthǝ nǝnǝ, ya Korasinu! A ɓko ɓǝtthǝ langɓǝ, Betsaida! Nǝ nung fǝmlo kwɔ i to dang ɓǝlǝ kwɔ i to Taya i Sidon, yang i yayuu bǝi ɓǝ lakuu i ǝǝ sua, li tǝr nung tthǝi, i al Song tthǝi. Yangbǝ ǝǝ lǝ bǝ al nung a ɓko gilǝtǝ! <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />Fuh a ɓyǝa nungzuii ya Taya i sidon vii to kwan loɓǝ lǝ. <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />Langkwoi ɓǝ aɓǝ, Kafarnahum! Dǝɓa yiɗi bǝ ǝrr lǝ loɓǝ ɓa tǝlǝ yiǝ? I waɓǝ lǝtǝ dang lua!&gt;&gt;<verse eid="LUK 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16" />Yeso gei ya nanung to gu angǝ, &lt;&lt;Yuu kwɔ lǝɓǝ yang u lǝ ǝn ɓang; yuu kwɔ nǝ laɓǝ yang u la ǝn ɓang; yuu kwɔ lam yang la ǝn yuu kwɔ tummǝm ɓǝ.&gt;&gt;<verse eid="LUK 10:16" /></para>
  <para style="s">Ya Nanungto Thǝmtai Pǝmna Sob Iu Rab Kwoi Suai</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />Ya nanungto kwɔ thǝmtai pǝmna sob iu rab kwɔ kwoi tǝ gwoi i tthǝla, I gei angǝ, &lt;&lt;Dangbang,&gt;&gt; i wa a ɓko ǝndǝi dǝna dǝɓi lo dang ɗuǝnmǝ nǝɓi dǝkabnwai ɓǝ!&gt;&gt;<verse eid="LUK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18" />Yeso gwabǝi nwa angǝ,&lt;&lt;Ən ɓyǝa Mungkullum dǝna o wayi mangǝn lua. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />Ɓalǝ! Ən dǝɓǝ tthǝnyimmi, yangbǝ ɓa thko lo biǝk i nyang ɓa pǝl ttha ya ɓui ɓǝ; nung yangǝu a to ɓǝu. <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />Kwoi, bǝɓa lǝ tthǝla lǝ bakwɔ ɓyang a ɓko dǝna dǝɓǝ lo thǝ, ɓa lǝ tthǝla bakwɔ i vullǝ ɗuǝn ɓǝ wayi ɓǝ.&gt;&gt;<verse eid="LUK 10:20" /></para>
  <para style="s">Yeso Lǝ Tthǝla</para>
  <para style="r">(<ref loc="MAT 11:25-27">Matthew 11:25-27</ref>; 13:16, 17)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />Lona lǝ kullo Yeso lǝ tthǝla tthǝ ɓyang a langǝ i u gei angǝ, &lt;&lt;Daa, Dangbang wayi i pangsua! Ən khang bakwɔ a tanatthǝ nungkwɔ lǝ ya yiggǝi i ya ibǝ nung lǝu, langkwoi a tanatthǝ lǝ yathang a tuab. Əah, Da, manungɓǝ dǝmma yiɗi to nung.<verse eid="LUK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22" />&lt;&lt;Daam dǝm nung ǝndǝing. Yuu akun yangǝu ibǝi ǝnyi lǝ Yui ɓǝlǝu ǝn Daa ɓuo ibǝi, Langkwoi yuu akun yangǝu ibǝi ǝnyi lǝ Daa ɓǝu ǝn I kwɔ lǝ Yui ɓuo i yakwɔ Yui ɓǝ mko tainatthǝ ɓǝ.&gt;&gt;<verse eid="LUK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23" />Ərr Yeso mǝrrǝm tthǝ ya nanung to gu u geitthǝ lǝbǝ pya angǝ,&lt;&lt;Ɓa to saa ɗing kwɔ dǝɓa ɓyǝa nungkwɔ dǝɓa ɓyǝa ɓǝ! <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />Ən gei ɓǝtthǝ ya gei ba a tthasi kpaaɗing i ya yigwoi dǝna yiɗi bǝ ɓyǝa nungkwɔ ɓa ɓyǝa kwɔ, kwoi i ɓyǝa lǝu, yang lang i lǝ nungkwɔ ɓalǝ kwɔ, kwoi i lǝ lǝu.&gt;&gt;<verse eid="LUK 10:24" /></para>
  <para style="s">Bǝ Liba Lo Ya Samariya A Langǝ i</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />Vii akun ya nanatthǝ nung zuu wuo dǝna yiɗi bǝ na Yeso u gei angǝ,&lt;&lt;Ya nanatthǝnung,&lt;&lt;ǝnɓǝ mǝn to yangbǝ ǝn tǝi nwongǝi a ɗing?&gt;&gt;<verse eid="LUK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26" />Yeso gwabnwa angǝ, Ən ɓǝtǝn i vullǝ dang nung zuu? Dǝma than nungvullǝ ɓǝ nǝnǝ?&gt;&gt;<verse eid="LUK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27" />Yiɓǝi ɓǝ gwabnwa angǝ,&lt;&lt;&lt;A yiɗi Dangbang Fuh mǝ i dang wamǝ, i killǝng mǝ, i ttha mǝ, i dang nyimǝ&gt;; yang &lt; A yiɗi ya nwakong mǝ manungkwɔ dǝmmǝ yiɗi lomǝ ɓǝ.&gt;&gt;&gt;<verse eid="LUK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28" />Yeso gei angǝ,&lt;&lt;Bamǝ ǝn lozuiiu; A to nungkwɔ yang ma tǝi nwongǝi.&gt;&gt;<verse eid="LUK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29" />Kwoi ya nanatthǝnung zuu ɓǝ dǝna yiɗi bǝ ilǝ lo, nungkwɔ u ɓib Yeso angǝ,&lt;&lt;Yang ǝn yi lǝ ya nwakongǝmma?&gt;&gt;<verse eid="LUK 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30" />Yeso gwabnwa angǝ,&lt;&lt;Yiɓǝi akun ǝrr Urshalima dǝna tǝ Yariko, kwɔ yanung i ɓǝrrǝu, i ilǝ nunglitthǝ gu, i ɓuo, i panungi, i yiu sua ɓua gu la tuab. <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />Viilǝ kwɔ yang ya nyǝknung o lǝiɓǝ; kwoi kwɔ wuu ɓyǝa yiɓǝi ɓǝ, u muo gwukun u pa.<verse eid="LUK 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 10:32" />Manungɓǝni yiɓǝi akun ya Balawiye muo lǝi ɓǝ, wuu ɓyǝa yiɓǝi ɓǝ, u muo gwukun u pa. <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" />Kwoi ya Samariya akun dǝna tǝ yol muo lǝi ɓǝ wuo bǝikwɔ yiɓǝi ɓǝ lotthǝ ɓǝ, kwɔ u ɓyǝko, u ɓyǝa nung zuii gu. <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />U tǝ suo tǝu lǝiu, u ɗigǝ nunglua gu i nui ɗigǝ nunglua u tthǝb i nung tthǝb nunglua; nungkwɔ u lǝi yiɓǝi ɓǝ u duu lo ɗǝrr gu, u tǝu lǝ gwoi yayol, bǝi lǝ kwɔ u dǝnung tthǝu. <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />Ibǝi kan u ilǝ nungkurɓǝ ɓui a yummi rab u dǝlǝ ya to nung to kwɔ gwoi yayol lǝɓǝ. U geiu angǝ,&lt;A dǝ nungtthǝu lǝ matthǝ,&gt; nǝ ǝn kwoi ǝn muo ttha bǝikwɔ, yang mǝn kwai nung kwɔ ǝndǝi a thǝb lolǝ ɓǝ.&gt;&gt;&gt;<verse eid="LUK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36" />&lt;&lt;Yeso alo angǝ, Nǝ ǝnmǝ amǝ yang, dang yakwɔ tai kwɔ ǝn yittǝn to mangǝn ya nwakong gi yiɓǝi kwɔ o dang na ya nung i ɓa?&gt;&gt;<verse eid="LUK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37" />Ya nanatthǝ nungzuu ɓǝ gwabnwa angǝ,&lt;&lt;Yuu kwɔ ɓyǝa nungzuii gu ɓǝ.&gt;&gt;</para>
  <para style="p" vid="LUK 10:37">Yeso gwabunwa angǝ, atǝ, yang, ta to manung ɓǝ.&gt;&gt;<verse eid="LUK 10:37" /></para>
  <para style="s">Yeso Tǝ Gwoi Gi Marta I Maryamu</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />Kwɔ Yeso i ya nanung to gu lilo tthǝ thko gi, u wuo gwoi atuab akun tthǝ kwɔ yisi akun ɗuǝnnu ǝn Matta u kǝb lo gwoi gu lǝ. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />Youngǝu tthǝ ɗuǝnnu ǝn Maryamu, kwɔ Matta ǝǝ bo Dangbang dǝu lǝ bǝ nanatthǝnung gu. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />Kwoi kiggǝ Matta ǝrr lǝ ba nung to kwɔ dǝu to ɓǝ, u wuo wuu gei angǝ, &lt;&lt;Dangbang, a ɓyǝa kwɔ youngǝm yim dǝmǝn to nung to i nungtthǝm ɓǝ lǝu? A geiu wuu womnatthǝ!&gt;&gt;<verse eid="LUK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41" />&lt;&lt;Dangbang gwabnwa angǝ, Matta, Matta! Kiggǝ mǝ dǝna ǝrr lo nung kpaaɗing, <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />Kwoi nung kun dǝi yiɗi. Maryamu mko nung a langǝ ing, yuu kun yangǝu a muo nko.&gt;&gt;<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s1">Yeso Nanatthǝnung Lo Bǝ Pinwa</para>
  <para style="r">(<ref loc="MAT 6:9-13">Matthew 6:9-13</ref>; <ref loc="MAT 7:7-11">7:7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />Vii akun Yeso dǝna pinwa bǝi akun. Kwɔ u alo bǝ pinwa ɓǝ, yuu akun dang ya nanung to gu geiu angǝ,&lt;&lt;Dangbang, a naɓinatthǝ bǝ pinwa, manungkwɔ Yohanna nanatthǝ lǝ ya nanung to gu ɓǝ,&gt;&gt;<verse eid="LUK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2" />Yeso gei ya nanung to guɓǝ angǝ, &lt;&lt;Nǝɓa pinwa yang, ɓa gei manung kwɔni:</para>
  <para style="q1" vid="LUK 11:2">&lt;&lt; &lt;Daa, ɓi pinwa yangbǝ yayuu dǝ angǝ a lǝ ɗuǝn mǝ;</para>
  <para style="q1" vid="LUK 11:2">vii bǝ lo yigwoi mǝ wuo.<verse eid="LUK 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3" />A dǝɓi nungtang kwɔ vii ǝndǝi dǝɓi yiɗi ɓǝ.<verse eid="LUK 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4" />A al nung a ɓko ɓilǝtǝ,</para>
  <para style="q2" vid="LUK 11:4">manungkwɔ dǝɓi al abǝ yakwɔ toɓi nung a ɓko ɓǝ,</para>
  <para style="q1" vid="LUK 11:4">bǝ a naɓi ghaatthǝ thǝ.&gt;&gt;&gt;<verse eid="LUK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5" />Nungkwɔ Yeso gei ya nanung to gu angǝ, &lt;&lt;Kaso yuu akun tthǝ i ǝnthǝ, yang tǝ suo nǝkasua tǝ geiu angǝ, &lt;Ənthǝm, a dǝm Burodi tthǝ tai, <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />bakwɔ ǝnthǝm a kun tthǝ ǝrr yol tutthǝ wuo gwoim, nungtang yangǝu mǝn du u tangǝu.&gt; <verse eid="LUK 11:6" /><verse number="7" style="v" sid="LUK 11:7" />&lt;&lt;Yang ǝnthǝmǝ kwɔ dang kǝm ǝrr gwabnwa angǝ, &lt;Ba ɓarǝmthǝ. Ən lam nwakǝm mǝng lakwɔ, yathangǝm lo nungloǝng. Ən ɓuan ǝn ǝrr ǝn da nungkwɔ dǝmma yiɗi ɓǝu.&gt; <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />Ən gei ɓǝtthǝ, ko u ǝrr u du Burodi ɓǝlǝu bakwɔ u ǝn ǝnthǝu kwɔ, kwoi lǝ bakwɔ dǝnnu ɓarru kwɔ u lǝ tthǝkku u ǝrr u da nungkwɔ ǝndǝi dǝmma yiɗi ɓǝ. <verse eid="LUK 11:8" /><verse number="9" style="v" sid="LUK 11:9" />&lt;&lt;Nungkwɔ ǝn gei ɓǝtthǝ: A yam i da ǝndǝ; a ɗu yang ma tǝntǝi; a gab nwakǝm yang i ɓkotthǝn ɓko. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />Bakwɔ yuu kwɔ ǝndǝi ɓib u muon muo; yuu kwɔ ɗu a tǝntǝi; lang yuu kwɔ gab nwakǝm i ɓkotthǝn ɓko.<verse eid="LUK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11" />Ən Daa anwɔ kwɔ, nǝ yuimǝ ɓib pi tthǝng, yang a du biǝk ɓa? <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />Kwɔ nǝ u ɓib pi bung yibǝ yang a du nyang ɓa? <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />Nǝɓǝ kwɔ lǝ ya nung a ɓko kwɔ ɓa ibǝi bǝ dǝ nung a langǝ i lǝ yathang ɓǝ, yang to nǝnǝ tha i Daa ɓǝ wayi a dǝ Ɓyang a Langǝ i lǝ yakwɔ ɗyǝabbu ɓǝ!&gt;&gt;<verse eid="LUK 11:13" /></para>
  <para style="s">Yeso I Ba'alzabul</para>
  <para style="r">(<ref loc="MAT 12:22-30">Matthew 12:22-30</ref>; <ref loc="MRK 3:20-27">Markus 3:20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />Yeso dǝna ilǝ wa kwɔ ɓuan gei bko ɓǝ; kwɔ wa ɓǝ i, yiɓǝi ɓǝkwɔ gei bko kwɔ tǝbǝ gei ba, lo kon yayuu kwɔ bǝi lǝ dǝna fǝm. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />Kwoi yakun gei angǝ,&lt;&lt;Ba'alzabul yigwoi wa du ttha dǝu ilǝ wa a ɓko.&gt;&gt;<verse eid="LUK 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 11:16" />Yakun na Yeso angǝ u to nung fǝmlo yangbǝ i gwab angǝ Fuh i ulǝ. <verse eid="LUK 11:16" /><verse number="17" style="v" sid="LUK 11:17" />Yeso ibǝ nungkwɔ dǝi nhǝmɓǝng, nungkwɔ u gei angǝ,&lt;&lt;Losua kwɔ gab dang tha rab kwɔ losua ɓǝ dǝiu, langkwoi gwoi kwɔ gab dang tha rab kwɔ gwoi ɓǝkwɔ a ung o. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />Nǝ losua yigwoi mungkullum gab dang tha yang dǝna ɓuob vǝm, yang gwoi gu ɓǝ a to nǝnǝ a dǝi la? Ɓa gei ɓangǝ ǝn Ba'alzabul dǝm ttha dǝm to lǝ nung to. <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />Nǝ manungkwɔ ni dǝm ilǝ wa i ttha gi Ba'alzabul yang nǝnǝ ya muo sua ɓǝ ǝn ttha yittǝn dǝnni ilǝ a bǝi? Ni yang ya muo sua ɓǝ toɓǝ kwantthǝng. <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />Kwoi nǝ i ttha Fuh dǝnni ilǝ wa a ɓko, Yang ɓa ibǝi angǝ Fuh baipi bǝ lo yigwoi dang ɓǝng.<verse eid="LUK 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21" />Yeso lilotthǝ angǝ, &lt;&lt;Nǝ yattha I nung taɓui gu, dǝu kilǝ gwoi gu, nung gu ǝndǝi nung kǝnnatthǝu <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />Kwoi lona kwɔ yuu kwɔ tthko pǝll abo a wɔ u pǝll sǝmɓǝi yuu gwoi ɓǝ yang ee nung taɓui kwɔ dǝu ki lǝ gwoigu yang mko nungkwɔ dǝu yiɗi ɓǝ yang u pa nung gu.<verse eid="LUK 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23" />Yeso lilotthǝ angǝ,&lt;&lt;Yuu kwɔ nǝ yangǝu i ɓangǝu u ǝn ya ɓuim; Yuu kwɔ nǝ gǝm nung i ɓanglǝu yang dǝna yinyǝb.<verse eid="LUK 11:23" /></para>
  <para style="s">Bǝ Kwoi Gi Wa A Ɓko</para>
  <para style="r">(<ref loc="MAT 12:43-45">Matthew 12:43-45</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />&lt;&lt;Kwɔ wa a ɓko itthǝ Yuu, patǝ losua a kwi dǝna ɗu bǝikwɔ u nwong tthǝ kwɔ. Nǝ u tǝi lǝu, yang u gei angǝ&lt;Mǝn kwoi suam mǝntǝ gwoim a kuu.&gt; <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />Kwɔ nǝ wa a ɓkoɓǝ kwoi tǝ tǝi yiɓǝi ɓǝ mangǝn gwoi kwɔ i kai itthǝ matthǝ. <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />Yang u kwoi tǝu wulǝ wa a akun Nanaira kwɔ kiggǝi ɓkotthǝ pǝl abo ɓǝ, i tǝtthǝ yiɓǝi ɓǝ i ǝǝ bai lǝ. Yang nung to gi yuu kwɔ wa ɓǝ itthǝu kwɔ a ɓko pǝl a nwasiu.&gt;&gt;<verse eid="LUK 11:26" /></para>
  <para style="s">Bǝ Lǝ Tthǝla A Langǝ i</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />Kwɔ Yeso gei bakwɔ, Yisi akun dang kon lǝ gei angǝ,&lt;&lt;Fuh khana la langǝ i lo yisi kwɔ siǝ langkwoi tthaa ɓǝ.&gt;&gt;<verse eid="LUK 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28" />Kwoi Yeso gei angǝ,&lt;&lt;Yuu a bǝ khana lo a langǝ i ǝn yuu kwɔ lǝ ba Fuh yang to lǝ nung to ɓǝ.&gt;&gt;<verse eid="LUK 11:28" /></para>
  <para style="s">Yayuu Yam Nungfǝmlo</para>
  <para style="r">(<ref loc="MAT 12:38-45">Matthew 12:38-45</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />Kwɔ yayuu dǝna kpaa tthang Yeso, u gei angǝ,&lt;&lt;Ɓǝ yayuu dang wam kwɔ ǝn ya nung a ɓko! Dǝnni ɓib nung fǝmlo, kwoi nung a kun yangǝu ǝn a bǝ Yunana ɓuo. <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />Manungkwɔ Yunana ya gei ba a tthasi ɓuo lǝ killǝng ya Neneva, nungkwɔ ni Yui Yuu a ǝǝ lǝ tthǝ yayuu dang wam kwɔ. <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" />Vii kwan bǝgǝ Fuh Yigwoi lǝ yisi tthaa lǝsua a ǝrr tthǝ yayuu dang wam kwɔ bakwɔ u ǝrr nwa fongwam u wuo bǝ lǝ yigǝi gi Sulǝmanu, Lakwɔ nung tthǝ bǝikwɔ ghaa pǝll Sulemanu. <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" />Ya Neneva a ǝrr a gei ya dang wam kwɔ a ɓangǝ i lǝ vii to kwan; bakwɔ i lǝ ba gi Yunana i tubi ɓǝ, lakwɔ nung akun tthǝ bǝi kwɔ pǝll Yunusa!<verse eid="LUK 11:32" /></para>
  <para style="s">Fitilǝ Tthǝ</para>
  <para style="r">(<ref loc="MAT 5:15">Matthew 5:15</ref>; 6:22, 23)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />&lt;&lt;Manung a kwɔ yayuu dǝ lua tthǝ fitilǝ yang pyǝa ko lam i kong nungǝu kwɔ. Kaso i dǝ bǝdǝiu yang dǝ lua lǝ yayuu ǝndǝi dang woi. <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />Nungmǝ mangǝn lua gabbǝi tthǝmǝ. Nǝ nungmǝ maɗing, tthǝmmǝ kwɔ ǝndǝi ǝn lua. Kwoi nǝ nungmǝ mko, yang tthǝmǝ ǝndǝi ǝn bǝthǝl. <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />Adǝ kiggǝ mǝ, yang, lua kwɔ tthǝmǝ kwɔ ǝn bǝ baithǝl lǝu. <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />Lakwɔ, nǝ tthǝmmǝ kwɔ ǝndǝi ǝn lua, bǝi akun yangǝu dang bǝthǝl lǝu, yang a kai bǝi kwɔ ǝndǝi, mangǝtǝn lua akai kai tthang mǝ.&gt;&gt;<verse eid="LUK 11:36" /></para>
  <para style="s">Yeso Gei Nung A Ɓko Ya Farisiyawa I Ya Nanatthǝnung Musa</para>
  <para style="r">(<ref loc="MAT 23:1-36">Matthew 23:1-36</ref>; <ref loc="MRK 12:38-40">Markus 12:38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />Kwɔ Yeso alo bǝ gei bakwɔ, yiɓǝi ya farisiyawa akun luɓǝiu angǝ tǝu tangnung gwoi gi; Yeso tǝ ǝǝ sua bǝ tangnung ɓǝ. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />Kwoi Lo ya farisiyawa ɓǝ fǝm bakwɔ Yeso baipi bǝ tangnung ɗiggǝ nko lǝu ɓǝ. <verse eid="LUK 11:38" /><verse number="39" style="v" sid="LUK 11:39" />Kwoi Dangbang geiu angǝ,&lt;&lt;lakwɔ, ɓǝ ya Farisiyawa dǝɓa ɗiggǝ sua mual nung nwa mungki i nung tangung, kwoi yang dang wa ɓǝ ǝn nung a ɓko. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />Ɓǝ ya sulǝ! Gǝlko ǝn yuu kwɔ mab gwam uɓǝ langkwoi mab ttha dang langɓǝ? <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />Kwoi ɓa dǝ nungkwɔ dang wa ɓǝlǝ ya yiɓko, yang sua nung ǝndǝi kwɔ nǝɓa to yang Fuh a lǝ tthǝla ɓǝ.<verse eid="LUK 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42" />&lt;&lt; A ɓko ɓǝtthǝ ɗing ya Farisiyawa! Bakwɔ dǝɓa dǝ nungtǝi nungɓuoli nung mangǝ i yǝngthǝnni i chita ɓuob nwa tasǝu, kwoi yang ɓa la nung a langǝ i i bǝ yiɗi Fuh. Ɓato i nungkwɔ ǝndǝi bǝ ɓa yitthǝ akun thǝ.<verse eid="LUK 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43" />A ɓko ɓǝtthǝ ɗing ɓǝ ya Farisiyawa, bakwɔ ɓa yiɗi bǝ ǝǝ a langǝ i ɗing dang kǝm kǝbtha ya Yahudawa langkwoi dǝɓa yiɗi bǝ gumbǝi lomu angǝ ǝn gummang yikku.<verse eid="LUK 11:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 11:44" />&lt;&lt; A ɓko ɓǝtthǝ ɗing! Bakwɔ ɓa ittha i juǝn, kwɔ yayuu dǝna thko lo i bǝ ibǝi gi lǝu ɓǝ.&gt;&gt;<verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />Yuu akun dang ya nanatthǝnung gi Musa gei Yeso angǝ,&lt;&lt;Ya nanatthǝnung, nungkwɔ a gei lǝ ya Farisiyawa tthǝkwɔ a dal ɓi ǝn dal langɓǝ.&gt;&gt;<verse eid="LUK 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46" />Yeso geiu angǝ,&lt;&lt;Ɓǝ ya nanatthǝnung Musa ɓǝ dang ɓua! Dǝɓa dǝ nunglǝi lǝ yayuu ɓuontthǝ kwɔ i ɓuan i lǝiu ɓǝ, yang ɓa ɓuan ɓa dǝ nwanzǝna kun ɓa nwongǝi lǝu. <verse eid="LUK 11:46" /><verse number="47" style="v" sid="LUK 11:47" />&lt;&lt; A ɓkoɓǝtthǝ ɗing, bakwɔ ɓa mab ɓua juǝn lǝ ya gei ba a tthasi tthǝ, kwɔ ya bǝba ɓǝ thǝb ɓǝ.<verse eid="LUK 11:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 11:48" />Ɓǝ i naɓǝ lǝ ɓa gwab ɓangǝ nungkwɔ ya Bǝba ɓǝ to kwɔ maɗing; i thǝb ya gei ba a tthasi yang dǝɓa mai juǝn gi.<verse eid="LUK 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 11:49" />Bakwɔ Fuh dang yiggǝi gu gei angǝ,&lt;Mǝn tum ya gei ba a tthasi i ya nwatummim; yang i thǝb yakun gi i ji zuii.&gt; <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />Yangbǝ yayuu a dang wam kwɔ a lǝ tthǝzii babǝ thǝb ya gei ba a tthasi ǝndǝi baipiu vii kwɔ Fuh mab longwam ɓǝ, <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />baipiu tthǝbǝ thǝb Habila wuu muo lǝ Zakariya, kwɔ i thǝu nung ganglang bǝ nyǝknung i kǝm pinwa ɓǝ. Ni, ɓa ɓyǝa, yayuu ya dang wam kwɔ a to zui lǝ ba gi.<verse eid="LUK 11:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52" />&lt;&lt; A ɓko ɓǝtthǝ ɗing ya nanatthǝnung Musa, bakwɔ ɓa pyǝa nung ɓko nwakǝm ibǝ nung. Ɓǝ i naɓǝ ɓa tǝtthǝ lǝu, ɓa nan yakwɔ dǝna yiɗi bǝ tǝtthǝ ɓǝ!&gt;&gt;<verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />Kwɔ Yeso yitthǝ bǝiɓǝ, ya nanatthǝnung Musa i ya Farisiyawa dǝna la ba gu dǝi ɓibbu ba kpaatthǝ, <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />Dǝi ki yangbǝ i muu tthǝ nungkwɔ u gei ɓkotthǝ ɓǝ.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s">Bǝ Gub Ɗuogsui Ba Ya Kǝb Pǝllǝ</para>
  <para style="r">(Matthew 10:26, 27)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />Kwɔ kon yayuu kpaatthǝ thǝmsob dǝna gǝmtha tthang Yeso, kwɔ to dǝnni tamtha, nwasiu Yeso baipi bǝ gei ba lǝ ya nanung to gu, angǝ: &lt;&lt;Ɓa to kiggǝ matthǝ ba yǝng kwɔ dǝna fǝm nung ya Farisiyawa ɓǝ nungɓǝ lǝ pǝllǝ gi. <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" />Nung ǝndǝi kwɔ pyǝa lǝ pyǝa kwɔ i ɓkong ɓko, ko nung a kun yangǝu kwɔ pyǝa kwɔ i ibǝiu ɓǝ. <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />Manungkwɔni ǝn, gei gǝngǝ nungkwɔ i gei dang bǝthǝl i lǝn lǝ dang fuh, langkwoi nung kwɔ ɓa gei lǝtha tthǝ lǝ yaya dang kǝm yayuu ǝndǝi i gei i yol ghaatthǝ.<verse eid="LUK 12:3" /></para>
  <para style="s">Yuu Akwɔ Ɓa Surɓǝ</para>
  <para style="r">(<ref loc="MAT 10:28-31">Matthew 10:28-31</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />&lt;&lt;Ən gei ɓǝtthǝ, ya ǝnthǝm, bǝ ɓa surr ya kwɔ dǝna thko dǝna theb tthǝ ɓuo thǝ langkwoi ɓuan i to nung a kunnu ɓǝ. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />Mǝn taɓǝ natthǝ yuu kwɔ ɓa surr ɓǝ: Ɓa surr Fuh, yuu kwɔ, nǝ theb tthǝ, thǝ i ttha kwɔ a walǝtǝ dang lua a ɗing ɓǝ. Əah, Ən gei ɓǝtthǝ, ɓa surr Fuh! <verse eid="LUK 12:5" /><verse number="6" style="v" sid="LUK 12:6" />Gǝlko dǝnni ɗyǝab sui muam nu lo anini rab wai? Fuh danyitthǝ kun dang ǝi lǝ lǝu. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />I byang kwɔ loɓǝ kwɔ ǝndǝi Fuh thǝnthan. Bǝ ɓa surr vulli thǝ; ɓa pǝl sui muam kpaatthǝng.<verse eid="LUK 12:7" /></para>
  <para style="s">Bǝ Tubi I Bǝ La Kristi</para>
  <para style="r">(Matthew 10:32, 33; <ref loc="MAT 12:32">12:32</ref>; <ref loc="MAT 10:19">10:19</ref>,<ref loc="MAT 10:20">20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />&lt;&lt; Ən gei ɓǝtthǝ, yayuu kwɔ gei nungpangbǝi tthasi yayuu angǝ i ǝn abǝm, ɓang Yui Yuu langɓǝ a toi tthǝ manungɓǝni tthasi ya nwatummi gi Fuh angǝ i ǝn abǝm. <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />Kwoi yuu kwɔ nǝ lam tthasi yayuu, ɓang Yui Yuu langɓǝ a lko tthasi ya nwatummi gi Fuh.<verse eid="LUK 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 12:10" />Langkwoi yuu kwɔ nǝ gei ba tthǝ ɓang Yui Yuu Fuh al nung a ɓko gu lǝtǝ, yuukwɔ nǝ gei ba a ɓko tthǝ Ɓyang a Langǝ i Fuh al nung a ɓko gu lǝtǝu.<verse eid="LUK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11" />&lt;&lt;Kwɔ i wuu ɓǝlǝ kǝm kǝptha ya Yahudawa, ya yigwoi i ya iko, bǝ kiggǝ ɓǝ ǝrr ba bǝ ilǝ lo ɓǝ i nung kwɔ ɓa gei ɓǝthǝ, <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />Bakwɔ Ɓyang a Langǝ i a naɓǝnatthǝ nungkwɔ ɓa gei lona ǝndǝi.&gt;&gt;<verse eid="LUK 12:12" /></para>
  <para style="s">Bǝ Liba Lo Ya Nungtǝi Ya sullǝ</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />Yuu a kun dang kon gei Yeso angǝ, &lt;&lt;Ya nanatthǝnung, a gei youngǝm mangǝ u gab nungtǝi kwɔ da ɓi yiɓitthǝ i ɓanglǝ.&gt;&gt;<verse eid="LUK 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14" />Yeso gwabu nwa angǝ, &lt;&lt;Yiɓǝi, ǝn yittǝn dǝm lǝ ya to kwan ko ǝn ya gab nungtǝi ganglang ɓa?&gt;&gt; <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />Yeso lilotthǝ gei angǝ, &lt;&lt;Ɓadǝ kigǝ tthǝba ɗǝlak ǝndǝi! Ɓa ǝǝ matthǝ ɓa la bǝ yiɗi lo; nwongǝi a langǝ i yuu kǝbtha tthǝntthǝ kpaali nungtǝi gu lǝu.&gt;&gt;<verse eid="LUK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16" />Langkwoi u gei bǝ liba kwɔ tthǝ: &lt;&lt;Pangsua gi ya nungtǝi a kuntthǝ wuo lǝ nungtǝi matthǝ. <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />U ǝǝ sua u nhǝm dang wuo angǝ, &lt; Bǝi yangǝu mǝn dǝ nungtǝim ttheu ɓǝ mǝn to?&gt;<verse eid="LUK 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 12:18" />&lt;&lt;Yang u gei angǝ, &lt;Nungkwɔ mǝn to kwɔ ǝn nungkwɔ. Mǝn dǝrr i bim mǝn mai ya kun ghaatthǝ, yang mǝn dǝ nung nam bǝi lǝ i nungtǝim ǝndei. <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />Yang mǝn gei lǝ lom tthǝ, &lt;&lt;Mǝtthǝ i nung a langǝ i kpaaɗing kwɔ a dǝsua a lǝi tthaa kpaaɗing, a lǝi nwongǝi i kigǝ; tang, nwa langkwoi a lǝ tthǝlla.&gt;&gt; &gt;<verse eid="LUK 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20" />&lt;&lt;Kwoi Fuh geiu angǝ, &lt;Ya sullǝ! Nungvii kwɔ i lǝi nwongǝi mǝ namǝ. Yang yittǝn a tǝi nungkwɔ a mab lǝ lomǝ tthǝɓa?&gt;&gt;&gt;<verse eid="LUK 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21" />&lt;&lt;Yeso alo angǝ, &lt;&lt;Ato manung ɓǝni i yuu kwɔ dǝna gǝm nungtǝi lǝ lotthǝ kwoi yang u ǝn ya yiɓko tthǝ Fuh ɓǝ.&gt;&gt;<verse eid="LUK 12:21" /></para>
  <para style="s">Ɓa Dǝnyi Tthǝ Fuh</para>
  <para style="r">(<ref loc="MAT 6:25-34">Matthew 6:25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />Ərr Yeso gei ya nanung to gu angǝ, &lt;&lt;Manungkwɔ ni ǝn gei ɓǝtthǝ, bǝ kigǝ ɓǝ ǝrr lǝ ba nwongǝi thǝ, nungkwɔ ɓa tang yangbǝ ɓa sob; ko lǝ ba nungkwɔ tthǝɓǝ dǝna yiɗi ɓǝ, nungkwɔ ɓa liǝ. <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />Nwongǝi pǝl nungtang, tthǝ pǝl nung litthǝng. <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />Ɓa ɓyǝa ǝnthrag: i bie nungǝu ko bǝ ɓǝrreu; i yangǝu i kǝm dǝ nungǝu ko ǝn biu; kwoi Fuh dǝna tangǝ i lǝ! Ɓa pǝl nurugǝng! <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />Yuu akun dang ɓǝ babǝ ǝrr lǝ kigǝ a ɓuan a lilo na kun lo nwongǝi guo? <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />Nǝɓa ɓuan ɓa to nung tuab manungkwɔ niu yang, ba ɓǝbǝ dǝɓa ǝrr lǝ kiggǝ lo sua nungkwɔ?<verse eid="LUK 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27" />&lt;&lt; Ɓa ɓyǝa manungkwɔ vin dang gug dǝna ghaa ɓǝ. I to nung tou ko i mab nunglitthǝ lǝ tthǝitthǝu. Kwoi ǝn gei ɓǝtthǝ, ko ǝn Sulemanu i nungtǝi gu yangǝu i nunglitthǝ manung yuu akun dang vin kab kwɔ lǝu. <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />Nǝ manung kwɔ ni Fuh dǝna li nunglitthǝ lǝ gug dang gug tthǝ, kwɔ bǝi kwɔ ɗiggǝ, langkwoi bung yang i al lǝtǝ dang lua, u liɓǝ nunglitthe tthǝwa, Bǝ dǝ ba a langǝ i ɓǝtthǝ Fuh tuab ɓuo! <verse eid="LUK 12:28" /><verse number="29" style="v" sid="LUK 12:29" />Langkwoi bǝ ɓa dǝ nyiɓǝ lo nungkwɔ ɓa tang ɓa nwa thǝ; bǝ ɓa ǝrr lǝ kiggǝ lǝ ba i nungkwɔ thǝ. <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />Bakwɔ yayuu kwɔ i Fuh lǝu longwam kwɔ dǝna surdum sua i nung ɓǝkwɔ langkwoi daa ɓǝ ibǝing dǝbɓa yiɗi i nung ɓǝkwɔ. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />Kwoi ɓa ɗuu bǝ lo yigwoi Fuh nungsi, langkwoi i dǝɓǝ sua i nungkwɔ ǝndǝi.<verse eid="LUK 12:31" /></para>
  <para style="s">Nungtǝi Wayi</para>
  <para style="r">(<ref loc="MAT 6:19-21">Matthew 6:19-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32" />&lt;&lt;Bǝɓa surr vullithǝ, kǝm nyak a tuab, bakwɔ daa ɓǝ dǝna lǝ tthǝla u dǝɓǝ lǝi ɓa ǝǝ dang bǝ lo yigwoi gu. <verse eid="LUK 12:32" /><verse number="33" style="v" sid="LUK 12:33" />Ɓa ɗyǝap nungnaɓǝ yang ɓa dǝ nungkurɓǝ ɓǝlǝ ya yiɓko. Ɓa ɗuu tthko kwɔ ɓanglǝu ɓǝ, nungtǝi wayi kwɔ thǝmmu ɓǝ, bǝi kwɔ ya nung i yangǝu a ɓajiu ko ǝn zǝɓyang a ɓanglǝ ɓǝ. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />Bǝikwɔ nungtǝi mǝtthǝ nyimǝ vii ǝndǝi bǝi lǝ.<verse eid="LUK 12:34" /></para>
  <para style="s">Thǝb Ya Dǝ Kiggǝ</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />&lt;&lt;Ɓa mabtthǝɓǝ nǝɓa ki nung to, ɓa tthǝb luiɓǝ ɓa mabtthǝɓǝ ba nung to fitilǝ ɓǝ dǝna tang nǝɓa ki, <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" />mangǝn ya thǝb kwɔ dǝna ki bǝ wua gi togwoi gi ɓang dǝb yisi ɓǝ, yang bǝ nǝ u kwoi nǝ u gab nwakǝm yang dang tthǝ i ɓkotthǝ. <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />Ya thǝb ɓǝkwɔ a lǝ tthǝla kwɔ togwoi gi kwoi wa tǝi i ee naki ɓǝ. Ən gei ɓǝ ba a langǝ i tthǝ, u mab ttheu yangbǝ u to nung to, u gei i esua u wuo wuu toi nung to tthǝ. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />A malǝ ya ttheb kwɔ togwoi gi wa tǝi dǝnni ki ɓǝ, ko wuu tǝi nungvii nǝ kasua ko nǝ sibǝi. <verse eid="LUK 12:38" /><verse number="39" style="v" sid="LUK 12:39" />Kwoi ɓa nhǝm nungkwɔ! Nǝ yuu gwoi ibǝ lona kwɔ yanung i dǝna wuttheng, yang u yitthǝ gwoi gu ya nung i wuu ab nwakǝm tǝ dang gwoi ɓǝu. <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />Ɓǝ langɓǝ ɓa ee nǝɓa ki, bakwɔ ɓang Yui Yuu mǝn wuo lona kwɔ ɓa dǝnyitthǝ lǝu ɓǝ.&gt;&gt;<verse eid="LUK 12:40" /></para>
  <para style="s">Thǝb A Langǝ i I A Ɓko</para>
  <para style="r">(<ref loc="MAT 24:45-51">Matthew 24:45-51</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />Bitrus ɓib angǝ, &lt;&lt;Dangbang, dǝmma gei bǝ liba kwɔ lǝng ɓittha, ko lǝn yayuu tthe ǝndei?&gt;&gt;<verse eid="LUK 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42" />Dangbang gwab nwa angǝ, &lt;&lt;Yang yittǝn lǝ ya ɓilo nung a yiggǝi i kiggǝ, yuu kwɔ togwoi gu duu lo ya thǝb gu yangbǝ u ji nungtang gi lona a langǝ i? <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />A malǝ thǝb kulo tthǝ kwɔ togwoi gi kwoi wuu tǝiu dǝnnu to ni ɓǝ. <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />Ən gei ɓǝ ba a langǝ i tthǝ, u duu lo nungtǝi gu ǝndei. <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />Kwoi kaso theb ɓǝ gei lǝ lotthǝ angǝ, &lt;Togwoim ǝǝ sua tuɗing bǝ kwoiu,&gt; yang ǝrr u baipi bǝ ɓuob ya thǝb yaɓǝi i thǝb yasi langkwoi u tang u nwa u fǝr. <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />Togwoi gi thǝb kulo a wɔ vii kwɔ u dǝ nyitthǝ lǝu ɓǝ langkwoi lona kwɔ u ibǝi lǝu ɓǝ. U tthangǝu dang tha u tou kwan i yakwɔ dǝba a langǝ i lǝu ɓǝ.<verse eid="LUK 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47" />&lt;&lt;Thǝb a kwɔ ibǝi nungkwɔ togwoi gu dǝna yiɗi angǝ u to kwɔ, yang u mab tthǝu u tolǝu ko u to nungkwɔ togwoi gu dǝna yiɗi lǝu i ɓuo kpaatthǝ. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />Kwoi thǝb kwɔ ibǝi lǝu langkwoi to nungkwɔ i laggǝu i ɓuo tuap. Yuu kwɔ i duu kpaatthǝ, dǝnni yiɗi kpaatthǝ nko; langkwoi yuu kwɔ i duu kpaatthǝ, a kpaali i ɓib nko.<verse eid="LUK 12:48" /></para>
  <para style="s">Yeso Wulǝ Bǝ Gab lo</para>
  <para style="r">(<ref loc="MAT 10:34-36">Matthew 10:34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />&lt;&lt;Ən wua bǝ bai lua longwam, dǝmǝn yiɗi kaso nikwɔ yang lua ɓǝ ɗabǝng! <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" />Kwoi ɓang tthǝ i bǝ wollmung kwɔ i tom tthǝɓǝ, zuii ɓǝ ɓuonǝm tthǝ ɗing nǝ al loɗǝ! <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />Dǝɓa ɓyea ɓangǝn wullǝ bǝ ǝǝ a langǝ i longwama? Nilǝu, Ən gei ɓǝtthǝ, kwoi bǝ gab ganglang. <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />Baipiu la ɗiggǝ yayuu nu dang gwoi kun a gabtha, yayuu tai tthǝ yayuu rab langkwoi yayuu rab tthǝ yayuu tai. <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />I gab tha, daa gabtha i yui langkwoi yui i daa, naa i yui a yisi langkwoi yui a yisi i naa, naa yiɓǝi tthǝ gongnwu a yisi langkwoi gong a yisi tthǝ naa gi ɓǝiu.&gt;&gt;<verse eid="LUK 12:53" /></para>
  <para style="s">Bǝ Ibǝi Lona</para>
  <para style="r">(Matthew 16:2, 3)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />Yeso gei lǝ kon ɓǝtthǝ angǝ: &lt;&lt;Kwɔ ɓa ɓyǝa tǝimung la ɓilǝng ǝrr lǝdah, dang tthǝ yang ɓa gei ɓangǝ, &lt;Mung a nǝnnah,&gt; yang ǝrr na. <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />Langkwoi nǝ wuo lassua nǝ ɓuob, yang ɓa gei ɓangǝ, &lt;Bǝi a suǝnsɔn,&gt;lang manungɓǝ. <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />Ɓǝ ya pǝllǝ! Ɓa ina bǝ gei ba lo nung longwam i wayi ɗing. Kwoi ɓa ɓuan ɓa gei balo killǝng dang wam kwɔ lǝu?<verse eid="LUK 12:56" /></para>
  <para style="s">A Mab Ganglang Mǝ I Ya Ɓuimǝ</para>
  <para style="r">(<ref loc="MAT 5:25">Matthew 5:25</ref>,<ref loc="MAT 5:26">26</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />&lt;&lt;Baɓǝ bǝ ɓa to kwan i naɓǝ lo nungkwɔ lǝ a langǝ iu ɓa? <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />Nǝ yuu akun ɓuobnwa lomǝ u talǝ bǝ tokwan, a ɗuong nungmǝ kwɔ yirrǝ ɓǝ lo lǝi i yuu kwɔ ɓuobnwa lomǝ sua ya lagbǝi, a ɗyeabbu u al ba ɓǝlǝtǝ, ko u guba u tǝlǝ sua ya to kwan, yang ya to kwan ɓǝ a dalǝ dogari, langkwoi dogari talǝ pursǝna. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />Ən gei ɓǝtthǝ, ma ǝǝ bǝi lǝ a iu na kwai nungkurɓǝ kwɔ i mua lǝ ǝndei ɗǝ.&gt;&gt;<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s">Ɓa Mǝrǝm Ɓa Yitthǝ Nung aɓau ko Ɓa Ɓui</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />Lakwɔ yakuntthǝ bǝi lǝ kwɔ gei ba bǝ thǝb ya Galili kwɔ Bilatus al zii lǝtǝ kwɔ dǝnni nyǝknung ɓǝ. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />Yeso gwabnwa angǝ,&lt;&lt;Dǝɓa nhǝm ɓangǝ ya Galili kwɔ nung a ɓko gi pǝl sua ya Galili kwɔ ǝndǝi bakwɔ i to zuii manung kwɔni ɓa? <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />Dǝmǝng gei ɓǝtthǝ, nilǝu! Nǝɓa mab nunglǝi ɓǝ lǝu ɓǝma ɓa ɓui manung abǝi. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />Ko dǝɓa ɓyǝa ɓangǝ yayuu kwɔ li iu nai kwɔ gwoi kwɔ tǝyi tthǝ Siluwam o loi kwɔ dǝɓa nhǝm ɓangǝ nung a ɓko gi pǝl a bǝ yakwɔ dang Urshalima ɓa? <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />Ən gei ɓǝtthǝ, nilǝu! Nǝɓa mab nunglǝi ɓǝ lǝu, kwoi nǝɓa tubi lǝu langɓǝ ɓa ɓui manung abǝi.&gt;&gt;<verse eid="LUK 13:5" /></para>
  <para style="s">Bǝ Liba Lo Kabgol Kwɔ Siu Ɓǝ</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />Ərr Yeso gei bǝ li ba kwɔtthǝ angǝ: &lt;&lt;Yiɓǝi a kun tthǝ i kab gol, u aa dang zuk inabi gu, u tǝbǝ ɗuu siu, kwoi u tǝ tǝu tǝi nung a kun lǝu. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />Nungkwɔ u gei lǝ yiɓǝi kwɔ dǝna ɓyǝa zukɓǝ kwɔ angǝ,&lt;Ttha tai lakwɔ dǝmǝn wuo bǝ ɓyǝa sikab tthǝ kab gol kwɔ ǝn tǝi siu bo kun lǝu. A ɓǝrǝu a walǝtǝ! Baɓǝ bǝ dǝnnu ɓanglǝ sua ɓǝ nǝkwama?&gt;<verse eid="LUK 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 13:8" />&lt;&lt;&lt;Yikku,&gt; yuu kwɔ dǝna ɓyǝa zukɓǝ kwɔ angǝ, &lt;A yithǝ to ttha akun ɓi ɓyǝa; Men tha ɓuapiu mǝn al ɓung nyak tthǝ. <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />Nǝ kab ɓǝ si ttha a kun, yang maɗing! Nǝ u si lǝu, yang ɓi ɓǝrrǝu ɓi walǝtǝ.&gt;&gt;&gt;<verse eid="LUK 13:9" /></para>
  <para style="s">Yeso Dǝ Tthǝla Lǝ Yisi Ya Kuglǝ Vii Nwongǝi</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />Vii nwongǝi akun lǝ kwɔ Yeso dǝna nanatthǝnung dang kǝm kǝbtha ya Yahudawa. <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />Yisi a kun tthǝ bǝi lǝ kwɔ wa mǝrǝmmu lǝ kuglǝ ttha li iu tai; u tǝmlǝ tǝm u ɓuan u dǝi nǝbo juantthǝu. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />Kwɔ Yeso ɓiu ni, u lubǝiu,&lt;&lt;Yisi, a i dang zuii mǝng.&gt;&gt; <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />Nungkwɔ Yeso dǝ na tthǝu lǝ, ba a nwaɓi kwɔ u juan dǝnnu kha Fuh.<verse eid="LUK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14" />Dang wa yikku kǝm kǝbtha ɓǝ ɓanglǝ bakwɔ Yeso de tthǝla vii nwongǝi ya Yahudawa ɓǝ, nungkwɔ ǝrr u gei lǝ yayuu tthǝ angǝ,&lt;&lt;Vii ni nanakun i tolǝ nung to; A wuo viilǝ kwɔ yang wui da tthǝla, kwoi ǝn vii nwongǝi lǝu!&gt;&gt;<verse eid="LUK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15" />Dangbang gwabu nwa angǝ,&lt;&lt;Ya pǝllǝ a nǝkwam! Ko ǝnyitǝn dang ɓǝ kwɔ a yinna lǝ nyak ko ɗǝr bǝ tthǝbbu yang tǝulǝ tǝ duu mungki vii nwongǝi. <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />Lakwɔ yisi kwɔ ǝn bie Ibrahim kwɔ Mungkullum tthǝbu ttha li iu tai; bǝ i yiuna vii nwongǝi tha?&gt;&gt;<verse eid="LUK 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 13:17" />Bǝ gwab nwa gu dǝ tthǝkku lǝ ya ɓui gu, kwoi yayuu kwɔ bǝi lǝ ǝndǝi lǝ tthǝla lo nungfǝmlo kwɔ u toɓǝ.<verse eid="LUK 13:17" /></para>
  <para style="s">Bǝ Liba Lo Nungbyǝa Musta</para>
  <para style="r">(Matthew 13:31, 32; <ref loc="MRK 4:30-32">Markus 4:30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />Ərr Yeso ɓib ba angǝ,&lt;&lt;Bǝ lo yigwoi Fuh nǝnǝtǝna? Mǝn nalǝn ɓǝtǝn? <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />Manungkwɔ ni. Yiɓǝi a kun lǝi nungbie musta bie zug gu. Nungbie ɓǝ mǝrrǝm lǝ kab, i nurug wayi mab kǝm gi sinko lǝ.&gt;&gt;<verse eid="LUK 13:19" /></para>
  <para style="s">Bǝ Liba Lo Nungkwɔ Dǝnna Fǝm Mual Flawa Ɓǝ</para>
  <para style="r">(<ref loc="MAT 13:33">Matthew 13:33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />Langkwoi Yeso ɓib angǝ,&lt;&lt;Mǝn na bǝ lo yigwoi gi Fuh lǝn ɓǝtǝna? <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />Mangǝn yisti kwɔ Yisi nǝ lǝi langlǝ mual kpaatthǝ yang a to flawa ɓǝ fǝm yi nungɓǝ.&gt;&gt;<verse eid="LUK 13:21" /></para>
  <para style="s">Nwakǝm A Tuab</para>
  <para style="r">(Matthew 7:13,14, 21-23)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />Yeso tǝ gwoi angǝ a i gwoi tuab, dǝu nainatthǝnung lo nunglǝi kwɔ dǝnnu tǝ Urshalima ɓǝ. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />Yuu akun ɓibu angǝ,&lt;&lt;Yikku, yayuu tuab ɓuo a sobba?&gt;&gt;</para>
  <para style="p" vid="LUK 13:23">Yeso gei angǝ, <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />&lt;&lt;A ɗuong nungmǝ a thko nunglǝi a tuab, bakwɔ yayuu kpaatthǝ yiɗi bǝ muo nunglǝi lǝ kwoi yang i ɓuanu. <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" />Yuu gwoi ɓǝ a ǝrr a lam nwa kǝm ɓǝ, yang ɓa dǝi gwam nǝɓa gab nwa kǝm dǝɓa yam ɓangǝ,&lt;A ɓkoɓi nwa kǝm ɓǝtthǝ, yikku!&gt; U gwab ɓǝ nwa angǝ, &lt;Ən ibǝ bǝi kwɔ ɓa ǝrr tthǝ ɓǝlǝu!&gt;<verse eid="LUK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 13:26" />&lt;&lt;Yang ɓa gei ɓangǝ,&lt;Ɓi tang ɓi nwa i mǝ; a nanatthǝnung gwoi angǝ a ɓi!&gt;<verse eid="LUK 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 13:27" />&lt;&lt;Kwoi langkwoi ǝrr u gei angǝ,&lt;Ən ibǝ bǝi kwɔ ɓa ǝrr tthǝ ɓǝlǝu. Ɓa pa ɓa yimbǝi, ɓǝ ya to mullub!&gt;<verse eid="LUK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 13:28" />Ba tasui ɓa tangna ɓa wurrǝ bǝi lǝ kwɔ ɓa ɓyǝa Ibrahim, Ishaku i Yakubu, i ya gei ba a tthasi ǝndǝi bǝ lo yigwoi gi Fuh, yang ɓaɓǝ i nan ɓǝ i dǝgwam! <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />Yayuu a wɔ gwɔpi i gwɔ lǝdah, i gwɔtal i gwɔlasua, wui ǝǝ bǝ to ɓang bǝ lo yigwoi Fuh. <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" />Yang yakwɔ lakwɔ lǝ ya kisua kwɔ a osi, langkwoi yakwɔ lakwɔ lǝ yakwɔ osi kwɔ a kisua.&gt;&gt;<verse eid="LUK 13:30" /></para>
  <para style="s">Bǝ Yiɗibǝi Gi Yeso Lo Urshalima</para>
  <para style="r">(<ref loc="MAT 23:37-39">Matthew 23:37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />Lona lǝ kullo yakun dang ya Farisiyawa wɔ sua Yeso wui geiu angǝ,&lt;&lt;A yitthǝ bǝi kwɔ a tǝ bǝi akun. Hiridus dǝna yiɗi bǝ thǝb ba.&gt;&gt;<verse eid="LUK 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32" />Yeso gwabǝi nwa angǝ, &lt;Ɓatǝ tǝɓa gǝi lǝ kwintang kulo tthǝ: &lt;&lt;Dǝm ilǝ wa a ɓko dǝm dǝ tthǝla ɗiggǝ i bung, langkwoi dang bo tai yang mǝn alo nung tom.&gt; <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />Kwoi mǝn lilotthǝ thkom ɗigǝ kwɔ, bung i ibǝikan; makwɔ i thǝb ya gei ba tthasi bǝi akunu tthǝn Urshalima ɓuo!<verse eid="LUK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34" />&lt;&lt;Əi Urshalima, Urshalima! Mǝkwɔ a thǝb ya gei ba a tthasi, a wa ya nwatummi kwɔ Fuh tum tthǝmǝ i tal! Bo nǝnǝ ǝn to yangbǝ ǝn gǝm yathang mǝ, manungkwɔ yibǝ dǝna gǝm yathang gu pikannu, kwoi a yiɗi lǝu! <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />Aɓya, gwoi ɓǝ a lonǝkwam. Ən gei ɓǝtthǝ ɓa ɓim a kunnu nǝ lona wɔ kwɔ ɓa gei ɓangǝ, &lt;Ɓǝ khana lo yuu kwɔ wuo dang ɗuǝn Dangbang ɓǝ.&gt;&gt;&gt;<verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s">Yeso Dǝ Tthǝla Vii Nwongǝi</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />Vii nwongǝi a kun lǝ, kwɔ Yeso tǝbǝ tang nungtang dang gwoi yikku ya Farisiyawa akun, yayuu kwɔ bǝilǝ kwɔ dǝna dǝ kiggǝ tthǝu. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />Dangtthǝ ni yang yiɓǝi a kun kwɔ nko ibo mai kwɔ wuu dǝi dang siu. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />Yeso ɓib ya Farisiyawa i ya nanatthǝnung Musa angǝ, &lt;&lt;Nung zuu ɓi angǝ i dǝ tthǝla vii nwongǝi na ko yangǝu?&gt;&gt; <verse eid="LUK 14:3" /><verse number="4" style="v" sid="LUK 14:4" />Kwoi i kǝrr. Nungkwɔ Yeso muo nalǝ yiɓǝi ɓǝ, u duu tthǝla u yǝrru nwa angǝ u tǝgwoi.<verse eid="LUK 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 14:5" />Ərr Yeso ɓibǝi angǝ,&lt;&lt;Nǝ yui yuu a kun dang ɓǝ ko nyak gu o dang ɓua mung a nwanwa vii nwongǝi, yang ɓa tǝ thǝmtthǝ tǝɓa iulǝ wa?&gt;&gt; <verse eid="LUK 14:5" /><verse number="6" style="v" sid="LUK 14:6" />I ɓuan i gei nung a kun lǝu.<verse eid="LUK 14:6" /></para>
  <para style="s">Bǝ Ɓuoblo Sua I Bǝ Tǝmnyi Lǝ Yayuu</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />Kwɔ Yeso ɓyǝa ya yayol dǝna ɗuu bǝ ǝǝ a langǝ i pangɓang, ǝrr u gei bǝ liba kwɔtthǝ angǝ: <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" />&lt;&lt;Nǝ yuu akun ɗuu ɓǝmǝ bǝ to ɓang ɓǝ dǝb yisi ko bǝ dǝb gwoi, bǝ a ǝǝ lo nungǝǝ angǝ a thǝ, lko yuu akun tthǝ pǝlla kwɔ i ɗuubǝiun langɓǝ ɓǝ. <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />Nǝ manungkwɔ ni yang, yuu kwɔ ɗuubǝ ɓǝkwɔ wa gei angǝ,&lt;A dǝ bǝ ǝǝ mǝlǝ yiɓǝi kwɔ.&gt;Yang, i da tthǝkku, yang tǝma ǝǝ bǝ ǝǝ a tuab. <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />Kwoi nǝ i lubǝ mǝ bǝ to ɓang bǝ dǝb yisi ko bǝ dǝb gwoi yang, ta ǝǝ bǝ ǝǝ a tuab, yangbǝ nǝ yuu kwɔ ɗuubǝ mǝ kwɔ nǝ wua yang, wuu gei angǝ,&lt;ǝnthǝm, A ǝrr a ǝǝ bǝi a langǝ i.&gt;Yang i da angǝ a dang nung yakwɔ i ɗuubǝimǝ i ilǝ ɓǝ. <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" />Yuu kwɔ nǝ dǝna lǝi lo yang Fuh a duu tthǝkku, kwoi yuu kwɔ nǝ tǝlǝ lo lǝ sua yang u tǝi angǝ a.&gt;&gt;<verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />Yang Yeso gei lǝ yuu kwɔ dǝna tangnung gwoi gu kwɔ angǝ,&lt;&lt;Nǝ dǝmǝ lubǝ yayuu bǝ tangnung a dang fuh ko a nungluii, ba lubǝ ya ǝnthǝ mǝ thǝ, ko ya youngmǝ ko yayuu mǝ, ko ya nwakong mǝ ko ya nuntǝi thǝ; nǝ a toni, i ɗubǝ mǝ langɓǝ yang wui kwai nwathannu. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />Kwoi nǝ dǝma to ɓang, yang a ɗuubǝ ya yiɓko, ya kugglǝ, ya o thko, ya nungɓuommi; <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />yang Fuh a khana lo mǝ. Bakwɔ i ɓuan i kwai nwathanu ɓǝ, Fuh a kwai vii kwɔ ya langǝ i a ǝrr i nwongǝi ɓǝ.&gt;&gt;<verse eid="LUK 14:14" /></para>
  <para style="s">Bǝ Liba Lobǝ To Ɓang Angã</para>
  <para style="r">(<ref loc="MAT 22:1-10">Matthew 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />Kwɔ yuu a kun dang yakwɔ dǝna tang nung i ulǝ kwɔ lǝba kwɔ, u gei Yeso angǝ,&lt;&lt;Fuh a khana lo yuu kwɔ ǝndǝi kwɔ a tangnung bǝ Lo yigwoi gi Fuh ɓǝ.&gt;&gt;<verse eid="LUK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16" />Yeso geiu angǝ: &lt;&lt;Yiɓǝi a kuntthǝ dǝna mab bǝ to ɓang angǝ a u ɗuubǝ yayuu kpaatthǝ a wuu ɓangɓǝ. <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />Lona bǝ to ɓangɓǝ dǝ u tum ya thǝb gu yangbǝ tǝi geilǝ yakwɔ u gei baɓǝ,&lt;Ɓa wɔ, ǝn mab nung ǝndǝing!&gt;<verse eid="LUK 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 14:18" />&lt;&lt;Kwoi i ǝndǝi baipi bǝ ɗuu nunglǝi bǝ lko. Yuu a nungsi gei thǝb ɓǝ angǝ,&lt;Ən ɗiɛb pangsua nǝfuu, mǝntǝ tǝmǝng ɓyǝa. Dǝmǝn ɗiɛb a dǝm nunglǝi.&gt;<verse eid="LUK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 14:19" />&lt;&lt;Yuu a kun gei thǝb ɓǝ angǝ,&lt;Ən ɗyǝab kab nyak nunglǝbi ni nu, mǝntǝ tǝm nai, dǝmǝn ɗyǝap a dǝm nunglǝi.&gt;<verse eid="LUK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 14:20" />&lt;&lt;Yuu a kun langkwoi angǝ,&lt;Ən ɗǝb yisi nǝnǝng kwɔ, manung kwɔ ni yang ǝn ɓuan ǝn tǝu.&gt;<verse eid="LUK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21" />&lt;&lt;Thǝb ɓǝ kwoi wuu gei lǝ togwoi gu ba ɓǝtthǝ. Langkwoi dang wa togwoi ɓǝ ǝrr ɓanglǝ ghaatthǝ u gei thǝb gu ɓǝ angǝ,&lt;Atǝ thǝmtthǝ ganglang gwoi angǝ a ta wulǝ ya yiɓko, ya kugglǝ, ya nungɓuommi i ya o thko.&gt;<verse eid="LUK 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 14:22" />Thǝb ɓǝ gei angǝ,&lt;&lt;&lt;Yikku, nungkwɔ a gei kwɔ to tthǝng, kwoi yirrǝ bǝi dǝi ina.&gt; <verse eid="LUK 14:22" /><verse number="23" style="v" sid="LUK 14:23" />&lt;&lt;Yang togwoi ɓǝ gei ya thǝb guɓǝ angǝ,&lt;Ɓatǝ lo lǝi angǝ a ɓa gei i wuo dang gwoi ɓǝ, yangbǝ dang gwoim yitthǝ.&gt;&gt;&gt; <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />Ən gei ɓǝtthǝ, yuu a kun yangǝu dang yakwɔ ǝn lubǝi ba ɓang kwɔ i labǝ wuu kwɔ bang nungtang kwɔ mǝn to ba ɓang bǝ dǝb yisi gwoim ɓǝ!&gt;&gt;&gt;<verse eid="LUK 14:24" /></para>
  <para style="s">Zuii Ya Nanung To Gi Yeso</para>
  <para style="r">(Matthew 10:37, 38)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />Kon yayuu kpaatthǝ dǝna muo sua Yeso, u mǝrrǝm u gei angǝ: <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" />&lt;&lt;Yuu kwɔ nǝ muo suam nǝ yiɗim pǝll Daa gu i Naa gu lǝu, siu i yathang gu, ya youngǝu a yiɓǝi i ya youngǝu a yisi, ko nwongǝi gu lǝu u ɓuan u mǝrrǝm lǝ ya nanung tommu. <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" />Langkwoi yuu kwɔ nǝ ɓuan lǝi kab gangǝ i gu lǝ tthǝzii lǝ ba bǝ muo suam lǝu yang u ɓuan u mǝrrǝm lǝ ya nanung tommu.<verse eid="LUK 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28" />&lt;&lt;Nǝ yuu tthǝ dang ɓǝ dǝna yiɗi bǝ mai kǝm tǝyi tthǝ. Gǝlko u ǝǝ sua u mab zuii nungkwɔ u thǝb yangbǝ u ɓyǝa nungkurɓǝ gu ko a natthǝna kwɔ u al lǝlo nung mai guɓǝwa? <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />Ba kwɔ nǝ u li pi kǝm yang u ɓuan u alo lǝu, yuu kwɔ nǝ ɓyǝa ǝndǝi yang i tthaggu, <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />i gei angǝ, &lt;Yuu kwɔ baipi bǝ mai kǝm tǝyitthǝ yang kwoi u ɓuan u alo lǝu.&gt;<verse eid="LUK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31" />&lt;&lt;Ko yigwoi a kun dǝna tǝbǝ taɓui i yigwoi a kun. Gǝlko lanungsi u ǝǝ sua u ɓyǝa ya taɓui gu thǝmsob ɓua thǝm nu a taɓui tthǝ yigwoi kwɔ yayuu gu thǝmsob ɓua themsob wa. <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />Nǝ u ɓuanu, u tog yakun a osi a tǝsua yigwoi a kullo kwɔ yirrǝ lona wulǝu tǝi mab ganglangǝ i. <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />Manungɓǝni,&gt;&gt; Yeso alo angǝ, &lt;&lt;Yuu akun dang ɓǝ nǝ yitthǝ nung ǝndǝi lǝu yang ɓuan mǝrrǝm lǝ ya nanung tommu.<verse eid="LUK 14:33" /></para>
  <para style="s">Dǝi A Ɓko</para>
  <para style="r">(<ref loc="MAT 5:13">Matthew 5:13</ref>; <ref loc="MRK 9:50">Markus 9:50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />&lt;&lt;Dǝi maɗing, kwoi nǝ dǝi ɓanglǝ, i to nǝnǝ i mǝrrǝmu lǝ dǝi langkwoi. <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />Malǝ pangsuko langkwoi lǝ vurri takiu; i al lǝntǝ.</para>
  <para style="p" vid="LUK 14:35">&lt;&lt; Yuu kwɔ tthǝ i ɓuasui lǝbǝi, yang ulǝ.&gt;&gt;<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s">Bǝ Liba Lo Ɓangam Kwɔ Laɓǝ</para>
  <para style="r">(<ref loc="MAT 18:12-24">Matthew 18:12-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />Lona a kuntthǝ ya muo nungǝmmi i ya nung a ɓko gǝmtha yangbǝ i le Yeso. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />Kwoi ya Farisiyawa i ya nanatthǝnung Musa dǝna groang nyi, &lt;&lt;Yiɓǝi kwɔ dǝna yiɗi ya nung a ɓko langkwoi dǝnnu tangnung i illǝ.&gt;&gt;<verse eid="LUK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3" />Ərr Yeso gei bǝ liba kwɔ tthǝ angǝ: <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" />&lt;&lt;Nǝ yuu a kun dang bǝ tthǝ i ɓangam thǝm nu nungkwɔ kun dang ǝu la- ǝnɓǝ uto? Yang u ɓuan u yitthǝ thǝmnai oli iu nai nung pangbǝi dǝna tangnung tǝu ɗuubǝ a kwɔ laɓǝ wa? <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />Langkwoi nǝ tǝu tǝi, yang u lǝiu suadullu i tthǝlla, <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />u tǝulǝ gwoi. Yang u lubǝ ya ǝnthǝu i ya nwakongu u gei angǝ,&lt;Tthǝm la ǝndǝi kwɔ ǝntǝi ɓangamǝm kwɔ laɓe. Ɓa wɔ wuɓi lǝ tthǝla.&gt; <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />Ən gei ɓǝtthǝ manungɓǝnni wayi a lǝ tthǝla ghaatthǝ wayi lo ya nung a ɓko kun kwɔ yitthǝ nung a ɓko gu lo yanung langǝ i kwɔ thǝmnai oli iu nai ya nung a langǝ i kwɔ tubiu ɓǝ.<verse eid="LUK 15:7" /></para>
  <para style="s">Bǝ Liba lo Nungkurɓǝ Aɓui Kwɔ Laɓǝ</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />&lt;&lt; Ko kaso yisi a kun tthǝ i nungkurɓǝ ɓui a yummi ni sob yang kun dang ǝu la. U ɓuan u dǝlua tthǝ fitilǝ, u kai dang gwoi i kiggǝ nǝ u tǝi ɗǝwa? <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />Langkwoi kwɔ nǝ u tǝi nungkurɓǝ ɓǝ, u lubǝ ya ǝnthǝu i yanwakong gu wuu gǝm yang u gei angǝ, &lt;Tthǝm laɗing ǝntei nungkurɓǝm kwɔ laɓeng. Wuɓa lǝ tthǝla i ɓanglǝ!&gt; <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />Ən gei ɓǝtthǝ manungkwɔni, bǝ lǝ tthǝla tthǝ tthasi ya nwatummi gi Fuh lo ya nung a ɓko kun kwɔ yitthǝ nung a ɓko gu ɓǝ.&gt;&gt;<verse eid="LUK 15:10" /></para>
  <para style="s">Bǝ Liba Lo Yui A Yiɓǝi Kwɔ Laɓǝ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />Yeso lilo tthǝ gei angǝ: &lt;&lt;Yiɓǝi a kuntthǝ yathang gu rab lǝ yaɓǝi. <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />Yuu a thang ɓǝ geiu angǝ,&lt;Daam, a dǝm nwathanǝm dang nungtǝi mǝ lakwɔ.&gt;Nungkwɔ yiɓǝi ɓǝ gabbǝi nungtǝi gutthǝ i kwɔ rab kwɔ.<verse eid="LUK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 15:13" />&lt;&lt;Sua tulǝu, yuu a thang ɓǝ gǝm nungkwɔ u tei ǝndǝi ɓǝ u ɗyǝab dang ǝu, u pa nunglǝi losua a kun tutthǝ tǝu ɓangle nungtǝi gu nunglǝi a ɓko. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />U ɓanglǝ nung nko ǝndǝi. Yang gwom ǝrr o losua lǝ ǝndǝi ghaatthǝ, ǝrr dǝnnu yiɗi nung. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />Nungkwɔ ǝrr tǝu ɗuu nung to na yiɓǝi a kun losua lǝ, yiɓǝi ɓǝ duu nung to bǝ tanglǝ thag. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />Dǝnnu yiɗi kaso i tang kong nung aa kwɔ thag ɓǝ da tang ɓǝ, kwoi yuu kun yangǝu duu nung a kunnu.<verse eid="LUK 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 15:17" />&lt;&lt;Kwɔ u wua dang kiggǝu u gei angǝ,&lt;Yayuu nǝnǝ dang ya thǝb gi Daam dǝna tang nungtang dǝna dǝ suo, kwoi gwom tǝim bǝikwɔ dǝna kyǝ bǝ thǝm! <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />Mǝn kwoi suam mǝntǝ gwoi Daam tǝmǝn geiu gǝngǝ: Daa, ǝn to nung a ɓko tthǝ Fuh i mǝng. <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />Ən kǝn kwa i gei angǝ ɓang yuimǝ ɓǝlǝu; a lǝim dang ya thǝb mǝ.&gt; <verse eid="LUK 15:19" /><verse number="20" style="v" sid="LUK 15:20" />Nungkwɔ u ǝrr u palǝi gwoi daa gu.</para>
  <para style="p" vid="LUK 15:20">&lt;&lt;Kwoi kwɔ yirrǝ dǝnnu wuo nunglǝi tutthǝ, Daa gu ɓyǝa nung zuii gu; u surdum tǝu kumu; u lina lo dulu.<verse eid="LUK 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 15:21" />&lt;&lt;Yui bǝ gei daa ɓǝ angǝ,&lt;Daam, ǝn to nung a ɓko tthǝ Fuh i tthǝmǝ lǝ. Ən natthǝ kwɔ i gei angǝ ɓang yui mǝ ɓǝlǝu.&gt;<verse eid="LUK 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22" />&lt;&lt;Kwoi daa gu gei lǝ ya thǝb gutthǝ angǝ,&lt;Nǝbo! Ɓa wulǝ nunglitthǝ a langǝ i ɓa liutthǝ. Ɓa baiu nungbainatthǝ nwazǝnko ɓa baiu ǝko tthǝ bo. <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />Ɓa wulǝ yui nyak a kwɔ ghaa matthǝ ɓǝ wuɓa thǝb. Wuɓi to ɓang ɓi lǝ tthǝla. <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />Bakwɔ yuim kwɔ ɓui langkwoi u ǝrr; u la langkwoi ɓi tǝiung.&gt;Nungkwɔ i ǝrr dǝnni lǝ tthǝla.<verse eid="LUK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />&lt;&lt;Dangnung kwɔ dǝna to nungkwɔ, yuiu a yikku zuglǝ. Kwɔ u gbag gwoi, u lǝ yol ɓin i dang . <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />Nungkwɔ u lubǝ ya thǝb a kun u ɓyǝabu angǝ ǝnɓǝ dǝna to nung. <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />U geiu angǝ,&lt;Youngmǝ wung,&lt;Daa mǝ thǝb yui nyak kwɔ ghaa matthǝ bakwɔ u wua gwoi latthǝ ɓǝ.&gt;<verse eid="LUK 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28" />&lt;&lt;Dangwa youngǝu a yikku ɓanglǝ labǝ tǝ dang gwoi ɓǝ. Nungkwɔ daa gu i gwam tǝ yammu angǝ u tǝ dang woi. <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />Kwoi u gei daa gu angǝ, &lt; A ɓyǝa! Dang ttha kwɔ ǝndǝi dǝmǝn to nung to mangǝ ǝn thǝb langkwoi ǝn la bamǝ lǝu bo kun. A ɗǝm ko ǝn yui ɓa lǝu bo kun yangbǝ ǝn lǝ tthǝla i ya ǝnthǝm. <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />Kwoi kwɔ yui mǝkwɔ pallǝ nungtǝi mǝ tǝ ɓanglǝ i ya tang nǝkwam kwoi wuo gwoi, a thǝb yui nyak a kwɔ ghaatthǝ lǝ bagu!&gt;<verse eid="LUK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31" />Daagu gei angǝ,&lt;&lt; &lt;Yuim,&lt;vii ǝndǝi mǝ i ɓanglǝ, Nungtǝim ǝndǝi ǝn amǝ. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />Kwoi maɗing kwɔ ɓi to ɓang ɓi lǝ tthǝla, ba youngmǝ kwɔ u ɓumɓui u i nwongǝi langkwoi; u la langkwoi ɓi tǝiung.&gt;&gt;&gt;<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s">Bǝ Liba Lo Ya Ɓilonung Ya Kiggǝ aɓau</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />Yeso gei ya nanung to gu angǝ: &lt;&lt;Yiɓei ya nungtǝi a kuntthǝ kwɔ i ɓanlǝ ɗuǝn ya ɓilo nung gu i gei ya nungtǝi ɓǝ angǝ ya ɓilo nungtǝi gu dǝna ɓangle nungtǝi gu. <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />Ya nungtǝi ɓǝ ǝrr lubǝiu ɓibbu angǝ,&lt;Ənɓǝtten kwɔ dǝmǝn lǝ lomǝ ɓa? A geim nungkwɔ a to dang nung to mǝ lo nungtǝim ɓǝ, Lakwɔ a to nung to i ɓang akunu.<verse eid="LUK 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3" />&lt;&lt;Ya ɓilo nung ɓǝ gei le lotthǝ angǝ,&lt;Togwoim dǝna yiɗi bǝ nannǝm lo nungtom. Ənɓǝ mǝnto? Ən yangǝu i ttha kwɔ mǝnto walkǝ ɓǝu. Dǝm lǝ tthǝkku bǝ yam nung. <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />Lakwɔ ǝn ibǝ nungkwɔ mǝn to ɓeng, nǝ i nannǝm dang nung to yang yayuu a kǝblom dang woi gi.&gt;<verse eid="LUK 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5" />&lt;&lt;Nungkwɔ ǝrr u lubǝ yakwɔ than togwoi gu loi kwɔ kunkun. U ɓib yuu a nungsi angǝ,&lt;Than togwoim nǝnnǝ lomǝ?&gt;<verse eid="LUK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6" />U gwabnwa angǝ,&lt;Bko angǝ a nui zǝitun thǝm nu ɓua nai. &lt;Than mǝkwɔ,&gt;ya ɓilo nung geiu angǝ; &lt;a ǝǝ sua a vullǝ thǝm nu ɓua rab.&gt;<verse eid="LUK 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7" />&lt;&lt;Langkwoi ǝrr u ɓib yuu a nung rabbu angǝ,&lt;mamǝ than nǝnǝ lomǝ?&gt; &lt;U geiu angǝ nungkyang bu thǝm rab iu ǝngunai,&gt;u geiu tthǝni.&lt;&lt;U geiu angǝ,&lt;A lǝi nung vullǝnung a vullǝ thǝmrab iu ǝngunai ɓua nai.&gt;<verse eid="LUK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8" />&lt;&lt;Togwoi ya ɓilo nung ɓǝ manniu ba pǝllǝ gu; bakwɔ ya longwam kwɔ i kǝb pǝllǝ ɗing bǝ to nung lǝ yayuu lo yakwɔ dǝna muo sua Fuh ɓǝ.&gt;&gt; <verse eid="LUK 16:8" /><verse number="9" style="v" sid="LUK 16:9" />Yeso lilo tthǝ gei angǝ, &lt;&lt;Ən gei ɓǝtthǝ, ɓa to nung to i nungtǝi longwam ɓa muo lǝ ǝnthǝ, yangbǝ nǝ thǝm yang, ɓa tǝi gwoi a ɗing.<verse eid="LUK 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 16:10" />&lt;&lt;Yuu kwɔ nǝ to kiggǝ a langǝ i lo ba tuab yang u to kiggǝ lo angǝ a; yuu kwɔ nǝ to kiggǝ lo ba a tuab lǝu yang u to kiggǝ lo angǝ ko. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />Nǝ, lakwɔ, nǝ a to kiggǝ bǝ muo nungtǝi longwam lǝu, ǝn yi a gwaɓǝtthǝ ba bǝ muo nungtǝi a langǝ i? <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />Nǝ a to kiggǝ a langǝ i lo nung gi yuu kun lǝu, ǝn yi a da nung amǝ i namǝ?<verse eid="LUK 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13" />&lt;&lt;Thǝb yangǝu a to nung to lǝ ya togwoi tthǝ rabbu. U la yuu a kun yang u yiɗi yuu a kun, u gwab lǝ yuu a kun tthǝ yang u la yuu a kun. Adǝ angǝ a lǝ Fuh i nungkurɓǝu.&gt;&gt;<verse eid="LUK 16:13" /></para>
  <para style="s">Bǝ Lilo Bǝ Nanatthǝnung Gi Yeso</para>
  <para style="r">(Matthew 11:12, 13; 5:31, 32; Markus 10:11, 12)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />Kwɔ ya Farisiyawa lǝ nungkwɔ ǝndǝi, ǝrr i tthag lǝ Yeso, bakwɔ i ǝn ya yiɗi nungkurɓǝ ɓǝ.<verse eid="LUK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 16:15" />Yeso gei angǝ,&lt;&lt;Ənɓǝ dǝɓa ɓyǝa loɓǝ ɓangǝ ɓǝn ya langǝ i nung yayuu, kwoi Fuh i dang nyi ɓǝng. Bakwɔ nungkwɔ yayuu dǝna ɓyǝa angǝ nung a langǝ i ǝn nung akunlǝu tthǝ Fuh. <verse eid="LUK 16:15" /><verse number="16" style="v" sid="LUK 16:16" />&lt;&lt;Nung zuu gi Musa i nungvullǝ ya gei ba a tthasi dǝna to nung to wuu muo lǝ lona Yohanna ya wollnung; baipiu viilǝkwɔ dǝnni gei nwaba a langǝ i bǝ lo yigwoi Fuh, ko yǝ dǝna bai lotthǝ lǝ ttha. <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" />Kwoi ziu kwɔ wayi i pangsua a thǝm nǝkwam nung vullǝ a tuab dang ba gi Fuh o pangsua ɓǝ.<verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />&lt;&lt;Yuu kwɔ nǝ nan siu dǝb yisi a kun yang dǝnnu to nung a ɓko i yisi ɓǝlǝ; langkwoi yiɓǝi a kwɔ dǝb yisi a kwɔ ɓǝu yiuna yang dǝnnu to nung a ɓko i yisi lǝ.<verse eid="LUK 16:18" /></para>
  <para style="s">Yiɓǝi Ya Nungtǝi I Liyazarus</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />&lt;&lt;Yiɓǝi ya nungtǝi a kuntthǝ dǝna li nunglitthǝ alharini la thǝni kwɔ nungkurɓǝ ghaatthǝ dǝnnu ǝǝ dang tthǝla vii ǝndǝi dǝnnu tang nungtang a langǝ i. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />Kwoi ya yiɓko a kuntthǝ ɗuǝnnu ǝn Li'azaru, tthǝu lǝ nunglua ǝndǝi, kwɔ vii ǝndǝi dǝnni wulǝ nwalǝgwoi ya nungtǝikwɔ dǝnni duu bǝilǝ, <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />dǝnnu ki yangbǝ u tang kroam kongkwi kwɔ dǝna al pangsua kwɔ ɓǝ. I ɗua ǝndǝi dǝna wɔ dǝna lǝng nunglua gu.<verse eid="LUK 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22" />&lt;&lt;Lakwɔ lona wɔ kwɔ yiɓǝi ya yiɓko kwɔ ɓui ya nwatummi gi Fuh lǝiu tǝlǝ tthang Ibrahim. Yiɓǝi ya nungtǝi ɓǝ langɓǝ ɓui i suu. <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />Dang lua, bǝikwɔ dǝu to zuii kwɔ, ǝrr u lǝi lo yi u ɓyǝa Ibrahim, tutthǝ kullo, Li'azaru tthangǝu lǝ. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />Nungkwɔ u lubǝi angǝ,&lt;&lt;Daa Ibrahim! A ɓyǝa nungzuiim, a tum Li'azaru tǝ bai nwanzǝnko nung mungki yangbǝ u tǝmlǝ lo lyǝnǝm, bakwɔ ɓang dang gong zuii lua kwɔ.&gt; <verse eid="LUK 16:24" /><verse number="25" style="v" sid="LUK 16:25" />&lt;&lt;Kwoi Ibrahim geiu angǝ,&lt;Yuim, a nhǝm vii kwɔ mǝ i nwongǝi mǝ i nung a langǝ i, yang Li'azaru dǝna muo a ɓko, lakwɔ dǝnnu tǝi a langǝ i bǝikwɔ mǝ dang zui. <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />Aɓǝ lǝu ma, gong ɓua tthǝ ganglangɓi i ɓǝ, yangbǝ yakwɔ dǝna yiɗi bǝ nyangǝu bǝikwɔ a tǝ tthang ɓǝ ɓuan tǝu, yuu yangǝu a nyang tthang ɓi a wua tthang ɓǝu.&gt;<verse eid="LUK 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27" />&lt;&lt;Ya nungtǝi ɓǝ gei angǝ, &lt;&lt;Yang dǝm ɗyǝab ba, Daa Ibrahim, a tum Liyazarus gwoi daam, <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />bǝi lǝ kwɔ ya youngǝm tthǝ ni nu. Liyazarus tǝ suai tǝ gub ɗuogsui yangbǝ, ko ɓko mangǝn ɓa, bǝ i wua bǝi zuii kwɔ thǝ.&gt;<verse eid="LUK 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29" />&lt;&lt;Ibrahim geiu angǝ,&lt;Ya youngmǝ tthǝ i Musa i ya gei ba tthasi kwɔ a gub ɗuogsui; ya youngmǝ lǝ nungkwɔ i gei ɓǝ.&gt;<verse eid="LUK 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30" />Ya nungtǝi gwabnwa angǝ,&lt;Nikwɔ natthǝlǝu, daa Ibrahim! Kwoi nǝ yuu lub ɓua tǝ suai, yang i al nung a ɓko gilǝtǝ.&gt;<verse eid="LUK 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31" />Kwoi Ibrahim gei angǝ, &lt;Nǝ ilǝ ba gi Musa i ya gei ba a tthasi lǝu, i lǝu ko yuu kun lub ɓua ɓǝ.&gt;&gt;&gt;<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s">Bǝ To Nung aɓau Tthǝ Fuh</para>
  <para style="r">(Matthew 18:6, 7, 21, 22; <ref loc="MRK 9:42">Markus 9:42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />Yeso gei ya nanung to gu angǝ: &lt;&lt;Nungkwɔ dǝna wulǝ nung a ɓko lǝ yayuu tthǝ kwɔ a wung wuo vii ǝndǝi, kwoi a ɓkoɗing lǝ yuu kwɔ tthǝ a wulǝ ɓǝ! <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />A mkotthǝ ɗing nǝ i tthǝbu gongtal nyi tthǝ dulu yang i wko lǝtǝ nung nwam kwɔ u to yuu akun dang yathang a tuab kwɔ a to nung a ɓko ɓǝ. <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" />Ɓadǝ kiggǝ ɓǝ tthǝ nungkwɔ dǝɓa toɓǝ.</para>
  <para style="p" vid="LUK 17:3">&lt;&lt;Ne youngmǝ to nung aɓau yang, a than nyi lo, ne u tubi yang, a al ba ɓǝlǝtǝ. <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />Nǝ u to nung aɓau tthǝmǝ lǝ bo nanaira dang fuh kun, dang bo nanaira ɓǝ u wuo wu gei angǝ,&lt;Dǝm yam ǝn ee nwa ɓau ba,&gt;yang a al ba ɓǝlǝtǝ.&gt;&gt;<verse eid="LUK 17:4" /></para>
  <para style="s">Bǝ Dǝnyi</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />Ya nwatummi gei Dangbang angǝ, &lt;&lt;A lilo bǝ dǝnyi ɓi ghaatthǝ!&gt;&gt;<verse eid="LUK 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6" />Dangbang gwabǝi nwa angǝ, &lt;&lt;Nǝ ɓǝthǝ i bǝ dǝnyitthǝ suǝn mangǝn nungbyǝa musta, ɓa ɓuan ɓa gei gong kab kwɔ da si mulberry kwɔ, &lt;A lub lomǝ i yǝngmǝ ta aa dang nwam!&gt; Yang u gwab ba ɓǝng gwab.<verse eid="LUK 17:6" /></para>
  <para style="s">Nung To Ya Thǝb</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />&lt;&lt;Kaso yuu a kun dang ɓǝ tthǝ i thǝb kwɔ dǝna ɓuob nyak ko dǝnnu gagci ɓangam. Kwɔ nǝ u kwoi zug. Ma geiu mangǝ u to thǝmtthǝ u tang nungtang guo? <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />Nilǝu! Ma geiu mangǝ,&lt; A mab zuii nungtangǝm, yang a linung litthǝ to nung to mǝ a dǝi a kim ǝn tang ǝn nwa; tthasuko yangbǝ a tang amǝ.&gt; <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />U kha ya thǝb ɓǝng kha bakwɔ u to nung to i nungkwɔ togwoi gu geiu tthǝ angǝ u toɓa, u toulǝn to? <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />Manungɓǝ ni i ɓǝlǝ; kwɔ nǝɓa to nung to i nungkwɔ i gei ɓǝtthǝ angǝ ɓato, ɓa gei ɓangǝ, &lt;Ɓi ǝn ya thǝb ɓuo; ɓi to ǝn nung to ɓi.&gt;&gt;&gt;<verse eid="LUK 17:10" /></para>
  <para style="s">Yeso Ɗigǝ Ya Əmbǝlai Sob</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />Kwɔ Yeso olǝi Urshalima, u muo lo ɓyǝn ya Samariya i ya Galili. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />Dǝnnu tǝ gwoi a tuab a kun nungkwɔ u kǝbtha i ya nungzii ǝmbǝlai sob. I dǝi tutthǝ tthasiu <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />i buogbǝi angǝ,&lt;&lt;Yeso! Yuu gwoi! A ɓyǝa nungzuii ɓi!&gt;&gt;<verse eid="LUK 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14" />Kwɔ Yeso ɓyǝai ni, u gei angǝ, &lt;&lt;Ɓatǝ yangbǝ ya nyǝknung tǝ ɓiɓǝ nǝ ɓa tǝi tthǝlang ɓǝ.&gt;&gt;</para>
  <para style="p" vid="LUK 17:14">Kwɔ i olǝi dǝnni tǝ ǝrr i ɗiggǝi.<verse eid="LUK 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15" />Yuu a kun dang ǝi ɓyǝa u tǝi tthǝlang, u kwoisuo, dǝnnu kha Fuh i yol angǝ a. <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />Wuu bai nwalongǝu tthasi Yeso dǝnnu khako. Yiɓǝi ɓǝ ǝn ya Samariya.<verse eid="LUK 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17" />Yeso ɓib angǝ,&lt;&lt;Gǝlko ǝn yayuu sob i ɗiggǝi wai; Sua ya songsob ɓǝ pǝla? <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />Ən baɓǝ bǝ ǝn ya losua akun kwɔ ɓuo kwoi wuo dǝna kha Fuh, sua ya songsob kwɔ kha Fuh wa?&gt;&gt; <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />Nungkwɔ Yeso gei yiɓǝi ɓǝ angǝ,&lt;&lt;A ǝrr a pa; bǝ dǝnyitthǝ mǝ da tthǝlang.&gt;&gt;<verse eid="LUK 17:19" /></para>
  <para style="s">Bǝ Wuo Bǝ Lo Yigwoi Gi Fuh</para>
  <para style="r">(Matthew 24:23-28, 37-41)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />Yakun dang ya farisiyawa ɓib Yeso angǝ lona bǝ lo yigwoi Fuh a wɔ nǝɓa. Yeso gei angǝ,&lt;&lt;Bǝ lo yigwoi gi Fuh a wɔ mangǝn nungkwɔ yayuu a ɓyǝa ɓǝlǝu. <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />Yuu akun yangǝu a gei angǝ,&lt;Ɓyǝa, nungkwɔ!; Ko nung kulo bakwɔ bǝ lo yigwoi gi Fuh tthǝn dang tthǝ ɓǝ.&gt;&gt;<verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />Ərr Yeso gei ya nanung to gu angǝ,&lt;&lt;Lona tthǝ dǝna wɔ kwɔ ɓa yiɗi bǝ ɓyǝa vii gi Yui Yuu, kwoi ɓa ɓyǝko. <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />Ya kun wa gei ɓǝ angǝ,&lt;Ɓyǝa, u kullo!&gt;Ko,&lt;Ɓyǝa u kwɔ!&gt;Kwoi bǝ ɓa i gwam ɓatǝ bǝ ɓyǝai thǝ. <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />Manung akwɔ lua dǝna nyang wayi gab lua gwɔ kwɔ wu tǝlǝ gwɔ kullo, manungɓǝ ɓang Yui Yuu a to dang fuh gu. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />Kwoi la nwasiu u to zuii ɗing langkwoi ya dang wam kwɔ a lko.<verse eid="LUK 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26" />&lt;&lt;Manung a kwɔ vii gi Nuhu langɓǝ ni viim Yui Yuu a wɔtthǝ. <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />Yayuu dǝna tang dǝna nwa, langkwoi yaɓǝi i yasi dǝna dǝbtha, tǝlǝ vii kwɔ Nuhu tǝlǝ dang kwai tthǝ nungkwɔ mung ɓuommi wuu thǝi ǝndǝi.<verse eid="LUK 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 17:28" />&lt;&lt;Manungɓǝnni dang wam gi Lutu. Yayuu dǝna tang dǝna nwa, dǝnni ɗyǝap dǝnni mǝal, dǝni bie nung dǝni mai gwoi. <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />Dangfuh kwɔ Lutu yitthǝ dang Sadoma, i na mung lua i tal lua wayi wuu li yayuu ǝndǝi.<verse eid="LUK 17:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 17:30" />&lt;&lt;A to manung ɓǝni dang fuh kwɔ ɓang Yui Yuu a fuktthǝ ɓǝ. <verse eid="LUK 17:30" /><verse number="31" style="v" sid="LUK 17:31" />Dangfuh lǝ kwɔ yuu akwɔ lo kǝm gu, bǝ pin tǝ dang woi bǝ lǝi nung a kunthǝ; manungɓǝ yuu akwɔ i gwam tǝ zug bǝ kwoi tǝ gwoi thǝ. <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />Ɓa nhǝm nungkwɔ tǝi si Lutu ɓǝ! <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" />Yuu akwɔ nǝ dǝna yiɗi bǝ kang nwongǝi gu yang a lǝn la, yuu akwɔ la bǝ kang nwongǝi gu yang Fuh a kangǝu tthǝ. <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />Ən gǝi ɓǝtthǝ, nunvii lǝ kwɔ yayuu rab a lo nung lo lo nung lo kun: i lǝi yuu akun i yitthǝ yuu a kun. <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />Yasi rab dǝna namnung lotha; <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />i lǝi yuu a kun kwɔ i yitthǝ yuu a kun.&gt;&gt;<verse eid="LUK 17:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37" />&lt;&lt;Ya nanung to gu ɓib Yeso angǝ, &lt;&lt;Dangbang nungkwɔ a to nung ɓǝlla?&gt;&gt;Yeso gwabǝi nwa angǝ,&lt;&lt;Bǝikwɔ kwamɓui yuu tthǝ, ǝn bǝi ɓǝ kwɔ tha a gǝmtha tthǝ.&gt;&gt;<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s">Ɓǝ Liba Lo Yisi Siɓui I Yato Kwan</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />Ərr Yeso gei bǝ liba lǝ ya nanung to gu tthǝ yangbǝ u nainatthǝnung angǝ i pinwa vii ǝndǝi bǝ tthǝi muanthǝ. <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />Yeso gei angǝ: &lt;&lt;Gwoi angǝ a a kun lǝ ya gei kwan a kuntthǝ bǝi lǝ bǝ sur Fuh yangǝu dang wko langkwoi u dǝ angǝ a lǝ yayuu. <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />Ya siɓui akun tthǝ langkwoi gwoi angǝ a lǝ dǝna wɔ suko vii ǝndǝi dǝna yammu angǝ,&lt;A to kwan ganglangǝm i ya ɓuim a tom kwantthǝ matthǝ.&gt;<verse eid="LUK 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 18:4" />&lt;&lt;Bakwɔ la nwasiu tuung dǝnnu wuo kwɔ ya to kwan ɓǝ dǝna labǝ to nung a kun, kwoi nǝsua ǝndǝi u gei lǝ lotthǝ angǝ, &lt;Ko kwɔ ǝn surr Fuh langkwoi ǝn dǝ angǝ a lǝ yuu, <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />ba bǝ ɓarbǝi yisi ya siɓui kwɔ dǝna ɓarǝm kwɔ, Mǝn ɗuu nunglǝi nung gutthǝ. Nǝ nilǝu yang u ǝǝ nwa bǝ wuu vii ǝndǝi u thǝm lǝ ttham!&gt;&gt;&gt;<verse eid="LUK 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6" />Nungkwɔ Dangbang lilo tthǝ angǝ,&lt;&lt;Ɓa lǝ nungkwɔ ya gei kwan a ɓko kwɔ gei ɓǝ. <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />Lakwɔ, Fuh ɓuan to kwan nwong yayuu gu kwɔ dǝna tasui tthǝu babǝ nwongbǝi dang fuh i nungvii wa? U to thǝmtthǝ u nwongǝi wa?&gt;&gt; <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />Dǝmǝng gei ɓǝtthǝ, u toi kwan tthǝ thǝmtthǝ. Manungkwɔni nǝ ɓang Yui Yuu kwoi yang, mǝn tǝi ya dǝnyitthǝ ǝntǝi longwam ma?&gt;&gt;<verse eid="LUK 18:8" /></para>
  <para style="s">Bǝ Liba Lo Ya Farisiyawa I Ya Muo Nungǝmmi</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />Yeso langkwoi gei bǝ liba tthǝ angǝ yakun dǝna lǝi loi angǝ i ǝn ya nung a langǝ i dǝnni tthǝm sua yayuu.<verse eid="LUK 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 18:10" />U gei angǝ,&lt;&lt;Yaɓǝi akun tthǝ rab tǝ dang kǝm nyǝknung tthǝ Fuh bǝ pinwa, yuu a kun ǝn ya Farisiyawa yuu a kun ɓǝ ǝn ya muo nungǝmmi. <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" />Ya Farisiyawa ǝrr dǝi nǝbo dǝna pinwa angǝ, &lt;Dǝmǝng kha Fuh bakwɔ ǝn natha i ya yiɗi loi lǝu ɓǝ ya nung i, ya to nung a ɓko, ya ɓasi yayuu, ko yakwɔ dǝna muo nungǝmmi lǝu. <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />Dǝmǝn zuu fuh bo rab dang mako langkwoi dǝmǝn dǝ nungkun dang nungtǝim lǝ Fuh.&gt;<verse eid="LUK 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13" />&lt;&lt;Kwoi ya muo nungǝmmi kwɔ dǝi tutthǝ u ɓuan u lǝi lo yi lǝu dǝu ɓuob na nyingwu kwɔ ǝǝ lǝ bǝ tubi dǝnnu gei angǝ,&lt;Fuh, a ɓyǝa nungzuiim, ɓang ya nung a ɓko!&gt;<verse eid="LUK 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 18:14" />Yeso gei angǝ dǝmǝn gei ɓǝtthǝ,&gt;&gt; &lt;&lt;ya muo nungǝmmi kwɔ, ǝn ya Farisiyawa kwɔ lǝu kwɔ, u tǝ gwoi bǝ dǝi gu matthǝ i Fuh lǝ. Yakwɔ nǝ lǝi loi yang i tthǝmmǝi, yakwɔ ǝndǝi lǝi loi yi lǝu yang i ji angǝ a.&gt;&gt;<verse eid="LUK 18:14" /></para>
  <para style="s">Yeso Khana Lo Yathang Atuab</para>
  <para style="r">(<ref loc="MAT 19:13-15">Matthew 19:13-15</ref>; <ref loc="MRK 10:13-16">Markus 10:13-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />Yakun wu lǝ yathang a tuab lǝ sua Yeso yangbǝ wuu dǝna loi. Ya nanung to ɓyǝa nungkwɔ, ǝrr dǝi nanni bǝ to manungɓǝni, <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />kwoi Yeso lubǝ yathang a tuab ɓǝ wulǝ tthangǝu u gei angǝ,&lt;Ɓa yitthǝ yathang a tuab wuo suam, bǝ ɓa nanni thǝ, bakwɔ bǝ lo yigwoi gi Fuh ǝn a bǝ yayuu manung gi. <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />Ɓa nhǝm nungkwɔ! Yuu akwɔ nǝ muo bǝ lo yigwoi Fuh mangǝn munthang a tuab lǝu yang u tǝ tthǝu.&gt;&gt;<verse eid="LUK 18:17" /></para>
  <para style="s">Ya Nungtǝi</para>
  <para style="r">(<ref loc="MAT 19:16-30">Matthew 19:16-30</ref>; <ref loc="MRK 10:17-31">Markus 10:17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />Yikku ya Yahudawa akuntthǝ ɓib Yeso angǝ, &lt;&lt;Ya nanatthǝnung a langǝ i, mǝn to nǝnnǝ bǝ ǝn tǝi nwongǝi a ɗing?&gt;&gt;<verse eid="LUK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19" />Yeso ɓibbu angǝ, &lt;&lt;Ənbaɓǝ bǝ dǝma lubǝim mangǝ ya nanatthǝnung a langǝ i? &lt;&lt;Yuu akun yangǝu lǝ ya langǝ iu ǝn Fuh kun lǝ ya langǝ i. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />A ibǝ zuung: &lt;Ba ɓa si yuu thǝ, ba thǝb yuu thǝ, ba i nung thǝ, bǝ a gei ba a ɓko lo yuu thǝ, a dǝ angǝ a lǝ daa mǝ i naa mǝ.&gt;&gt;&gt;<verse eid="LUK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21" />&lt;&lt;Yiɓǝi ɓǝ gwabnwa angǝ, &lt;&lt;Ən munatthǝ nungzuu kwɔ ǝndǝi yirrǝ ɓanglǝ munthang,&gt;&gt;<verse eid="LUK 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22" />Kwɔ Yeso lǝ bakwɔ ni, u geiu angǝ,&lt;&lt;Yirrǝ sua nung kun la kwɔ ma toɓǝ. A ɗyǝab nung namǝ ǝndei a dǝ nungkurɓǝ lǝ ya yiɓko, yang tǝma tǝi nungtǝi wayi. Yang a kwoi, wa muo suam.&gt;&gt;<verse eid="LUK 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 18:23" />Kwoi kwɔ ǝrr u lǝ bakwɔ, dang wuko ǝrr ɓanglǝ ghaatthǝ, bakwɔ nungtǝi gu kpaaɗing ɓǝ. <verse eid="LUK 18:23" /><verse number="24" style="v" sid="LUK 18:24" />Yeso ɓyǝko bakwɔ dang wɔ ɓanglǝ lǝ ɓang ǝrr geiu angǝ,&lt;&lt;Zii nǝnnǝ lǝ ya nungtǝi tthǝ a tǝ bǝikwɔ Fuh lǝ yigwoi ɓǝ! <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />Ba a langǝ i, ziiu kwɔ jurobǝ a pa ɓua batal kwɔ ya nungtǝi a tǝ bǝikwɔ Fuh lǝ yigwoi ɓǝ.&gt;&gt;<verse eid="LUK 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26" />Yakwɔ lǝu kwɔ ɓib angǝ,&lt;&lt;Lakwɔ ǝn yitten a sob lo?&gt;&gt;<verse eid="LUK 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27" />Yeso gwabnwa angǝ, nungkwɔ ne ziiɗing tthǝ yuu yang ziiu tthǝ Fuh.&gt;&gt;<verse eid="LUK 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28" />Bitrus geiu angǝ,&lt;&lt;Ɓi yitthǝ nung ɓi ǝndei ɓi wuo dǝɓi muo sua me!&gt;&gt;<verse eid="LUK 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29" />Yeso gei angǝ,&lt;&lt;Dǝmǝng gei ɓe ba a langǝ i tthǝ yuu akun yangǝu kwɔ yitthǝ gwoi gu i siu i ya youngǝu i daa gu i yathang gu dǝ lolǝ ba bǝ lo yigwoi Fuh, <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />kwɔ yuu ɓǝ kwɔ a tǝi i nungkwɔ u yitthǝ ghaatthǝ pǝl akwɔ longwam kwɔ ɓǝ i nwongǝi a ɗing longwam akwɔ da wuu ɓǝ.&gt;&gt;<verse eid="LUK 18:30" /></para>
  <para style="s">Yeso Gei Nwaɓua Gu A Nungtai Tthǝu</para>
  <para style="r">(<ref loc="MAT 20:17-19">Matthew 20:17-19</ref>; <ref loc="MRK 10:32-34">Markus 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />Yeso kwoi lǝ ya nanung to gu gwu kun u gei angǝ, &lt;&lt;Ɓalǝ! Ɓitǝ Urshalima bǝi lǝ nungkwɔ ya gei ba a tthasi vullǝ dang nungvullǝ gi Fuh ba ɓang Yui Yuu kwɔ a natthǝnna. <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />I duu lǝ yayol kwɔ ǝn ya Yahudawa lǝu ɓǝ. I tthagu, i dalu, i twiu i twitwi dang nungǝu, i ɓuo i thǝu. <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />I ɓuo yang i thǝu, kwoi dang bo tai yang dǝu ǝrr i nwongǝi.&gt;&gt;<verse eid="LUK 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34" />Ya nanung to gu ibǝ ba gu lǝu kokun; i pyǝai i manǝ balǝ, i ibǝ nungkwɔ Yeso da gei ɓǝlǝu.<verse eid="LUK 18:34" /></para>
  <para style="s">Yeso Dǝ Tthǝla Lǝ Ya Yamnung Ya Nungɓuommi</para>
  <para style="r">(<ref loc="MAT 20:29-34">Matthew 20:29-34</ref>; <ref loc="MRK 10:46-52">Markus 10:46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />Kwɔ Yeso gbag Yariko, ya nungɓuommi a kuntthǝ ǝǝ nwa lǝi dǝna yam nung. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />Kwɔ u lǝ kon yayuu dǝna pa tthangǝu, u ɓib angǝ&lt;&lt;Ən ɓǝttǝn dǝna to nungha?&gt;&gt; <verse eid="LUK 18:36" /><verse number="37" style="v" sid="LUK 18:37" />I geiu angǝ, &lt;&lt;Ən Yeso ya Nazarat dǝna pa&gt;&gt;<verse eid="LUK 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38" />Ya nungɓuommi ɓǝ lubǝi angǝ, &lt;&lt;Yeso Yui Dawuda, a ɓyǝa nungzuiim!&gt;&gt;<verse eid="LUK 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39" />Yakwɔ osi kwɔ ǝrrǝu lǝ i geiu angǝ u kǝr, kwoi yang ǝrr u lina lo yollu, &lt;&lt;Yui Dawuda, a ɓyǝa nungzuiim!&gt;&gt;<verse eid="LUK 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40" />Yeso dǝi nungkwɔ u gei angǝ i wullǝ yiɓǝi ɓǝ. Kwɔ u gbag tthangǝu ni, Yeso ɓibbu angǝ, <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />&lt;&lt;Ən ɓǝttǝn dǝma yiɗi mangǝ ǝn toa ttha&gt;&gt;</para>
  <para style="p" vid="LUK 18:41">U gei angǝ,&lt;&lt;Dangbang, Dǝm yiɗi bǝ ɓyǝa bǝi.&gt;&gt;<verse eid="LUK 18:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42" />Yeso geiu angǝ, &lt;&lt;A tǝi bǝ ɓyǝa bǝi! Bǝ dǝnyitthǝ mǝ da tthǝlang.&gt;&gt; <verse eid="LUK 18:42" /><verse number="43" style="v" sid="LUK 18:43" />Dangtthǝ nungǝu dǝna ɓyǝa bǝi ǝrr u muo sua Yeso, dǝnnu wab Fuh. Kwɔ kon yayuu ɓyǝa nungkwɔ ni, langɓǝ i wab Fuh.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s">Yeso I Zakka</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />Yeso lilotthǝ tǝ Yariko dǝna pa dang ǝulǝ. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />Yiɓǝi a kuntthǝ bǝi lǝ duǝnu ǝn Zakka; u ǝn yikku ya muo nungǝmi u tthǝ i nungtǝi. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />Dǝnnu yiɗi bǝ ɓyǝa ǝn yi lǝ Yeso, kwoi bakwɔ u gonnu u ɓuan u ɓyǝa Yeso lǝu ba kon yayuu. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />Ərr u surdum u tǝ tthasi tǝu ɗab kab gol yangbǝ u ɓiu, ba kwɔ Yeso a muo tthaa bǝilǝ ɓǝ.<verse eid="LUK 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5" />Kwɔ Yeso kǝn bǝi ɓǝ, u lǝi lo yi u geiu angǝ, &lt;&lt;Zakka, a pin nǝnǝnghǝ kwɔ. Mǝn lo gwoi mǝ ɗiggǝ kwɔ.&gt;&gt; <verse eid="LUK 19:5" /><verse number="6" style="v" sid="LUK 19:6" />Nungkwɔ u pin thǝmtthǝ u tou sakko i bǝ wuou latthǝ.<verse eid="LUK 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 19:7" />Yayuu ǝndǝi ɓyǝa nungkwɔ i baipi bǝ groang nyi angǝ, &lt;&lt;Dǝnnu tǝbǝ ǝǝ lǝ yayol ya &lt;nung a ɓko!&gt;&gt;<verse eid="LUK 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8" />Kwoi Zakka ǝrr dǝi nǝbo gei Dangbang angǝ, &lt;&lt;Alǝ, Dangbang! Lakwɔ mǝn gab dang nungtǝim rab akun mǝn dǝlǝ ya yiɓko, nǝ ǝn muo nung lǝ ttha na yuu a kun dang nung a kun, mǝn kwai bo nai i nungkwɔ ǝn muo ɓǝ.<verse eid="LUK 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9" />Yeso geiu angǝ, ɗigǝ nwongbǝi wua gwoikung, bakwɔ yiɓǝi kwɔ lang ɓǝ ǝn bie Ibrahim. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" />Bakwɔ Yui Yuu wuo bǝ ɗuu langkwoi u nwong yakwɔ laɓǝ.&gt;&gt;<verse eid="LUK 19:10" /></para>
  <para style="s">Bǝ Liba Loya Thǝb Sob</para>
  <para style="r">(<ref loc="MAT 25:14-30">Matthew 25:14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />Yirrǝ yayuu dǝna lǝ nungkwɔ Yeso dǝna gei kwɔ, u lilotthǝ dǝnnu gei bǝ liba tthǝ. U gbag Urshalima, bakwɔ yayuu dǝna ɓyǝa angǝ bǝ lo yigwoi gi Fuh a tǝbǝ fuggǝu nwa kun. <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />Nungkwɔ Yeso gei angǝ, &lt;&lt;Yiɓǝi a kun tthǝ u ǝn gong yikku i siu dang tthǝla u tǝ yol tutthǝ losua a kun yangbǝ tǝu lo yigwoi yangbǝ u kwoi. <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />Nungkwɔ u lubǝ ya thǝb gu sob u ji nungkurɓǝ ɓui i ǝndǝi nwunibǝ u pa. U gei angǝ,&lt;Ɓa tolǝ nung to ɓa tǝi a kun lo nwunibǝ ǝn kwoi.&gt;<verse eid="LUK 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14" />Kwoi yayuu gwabtha i ulǝ lǝu, nungkwɔ i tum ya nwatummi suko tǝi gei angǝ, &lt;Ɓi yiɗi yiɓǝi kwɔ lǝ yigwoi ɓi lǝu.&gt;<verse eid="LUK 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15" />&lt;&lt;Yiɓǝi ɓǝkwɔ i siu dang tthǝla kwɔ i liu yigwoi ɓǝtthǝ nungkwɔ u kwoi u wuo gwoi. Dangtthǝ u tumbǝi lo ya thǝb gu yakwɔ u ji nungkurɓǝ ɓui kwɔ, yangbǝ i gei nungkwɔ i tǝi lolǝ ɓǝ.<verse eid="LUK 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16" />Yuu a nungsi wuu gei angǝ, &lt;Yikku, ǝn wulǝ nungkurɓǝ mǝ kun kwɔ i akun ni so lo lǝ.&gt;<verse eid="LUK 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 19:17" />Togwoi gu gei angǝ,&lt;A to maɗing, mǝn thǝb a langǝ i!&gt; Togwoi gu gwabnwa angǝ. Bakwɔ a to kiggǝ lo nung a tuab ɓǝ, ma lo yigwoi lo gwoi angǝ a sob.&gt;<verse eid="LUK 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18" />Yuu a rab wuo wuu gei angǝ, &lt;Yikku, ǝn tǝi nungkurɓǝ nu lo a kun kwɔ a dǝm ɓǝ.&gt;<verse eid="LUK 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 19:19" />Togwoi gu gwabnwa angǝ, &lt;Ma lo yigwoi lo gwoi angǝ a nu.&gt;<verse eid="LUK 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20" />&lt;&lt;Yang yuu akun ǝrr wuo wuu gei angǝ, &lt;Yikku, nungkurɓǝ mǝkwɔ; ǝn kuluam ǝn pyǝa dang tǝrnung. <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />Dǝm surra, bakwɔ a nyim ɗing ɓǝ. Dǝma lǝi nungkwɔ ǝn amǝ lǝu ɓǝ langkwoi dǝma ɓǝr nung kwɔ a bie lǝu ɓǝ.&gt;<verse eid="LUK 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22" />Togwoi gu gwabnwa angǝ, &lt;Mǝ ǝn thǝb a ɓau! Bamǝ mǝn tolǝ kwan tthǝ! A ibǝin ǝn zii ɗing, dǝm lǝi nungkwɔ ǝn abǝm lǝu, langkwoi dǝm ɓǝrr nungbǝi kwɔ ǝn bie lǝu? <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />Bǝ ǝn baɓǝ bǝ a dǝ nungkurɓǝm bǝ dǝu lǝu? Krǝ yang mǝn muo nungkurɓǝm i mumg lo nǝ ǝn kwoi ɓǝ.&gt;<verse eid="LUK 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24" />&lt;&lt;Nungkwɔ u gei yakwɔ dǝi bǝi lǝ kwɔ angǝ, &lt;Ɓa muo nungkurɓǝ a nko kwɔ ɓa dǝlǝ yuu akwɔ abo sob ɓǝ.&gt; <verse eid="LUK 19:24" /><verse number="25" style="v" sid="LUK 19:25" />Kwoi i geiu angǝ&lt;&lt;Yikku, &lt;sob tthǝ nko! <verse eid="LUK 19:25" /><verse number="26" style="v" sid="LUK 19:26" />&lt;&lt; U gwabnwa angǝ, &lt;Ən gei ɓǝtthǝ yuu akwɔ nungtthe nko, i liu lo, yuu akwɔ nung yangǝu nko, a kwɔ nko lǝ kwɔ i mummuo. <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" />Lakwɔ, ba a bǝ ya ɓuim kwɔ yakwɔ gwab bǝ lo yigwoim lǝu kwɔ, wui lǝ kanni ɓa thǝi tthasim!&gt;&gt;&gt;<verse eid="LUK 19:27" /></para>
  <para style="s">Yeso Tǝ Dang Urshalima Mangǝn Yigwoi</para>
  <para style="r">(<ref loc="MAT 21:1-11">Matthew 21:1-11</ref>; <ref loc="MRK 11:1-11">Markus 11:1-11</ref>; <ref loc="JHN 12:12-19">Yohanna 12:12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />Tthasua kwɔ Yeso gei nungkwɔ, u oisi u tǝ Urshalima. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />Kwɔ u gbag Betafaji i Betanya lo ɓǝmtal kwɔ dǝnni lu angǝ tal Zaitun kwɔ, u tum ya nanung to rab osi u gei angǝ, <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />&lt;&lt;Ɓatǝ gwoi a tuab kwɔ, kwɔ nǝɓa tǝ dang ǝu, ɓa tǝi yui ɗǝrr tthǝb bǝilǝ, kwɔ yuu akun ɗab lǝu bo kun ɓǝ. Ɓa biu ɓa wullǝ bǝikwɔ. <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />Nǝ yuu a kun ɓibɓǝ angǝ, &lt;Baɓǝ bǝ dǝɓa biǝ? Ɓa geiu ɓangǝ, &lt;Dangbang dǝna yiɗi gu.&gt; &gt;&gt;<verse eid="LUK 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32" />Yakwɔ i tummǝi i osi tǝitǝi manung kwɔ u gei tthǝ ɓǝ. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />Kwɔ dǝni bi yui ɗǝrr ɓǝ, yuu tthǝu ɓibbǝi angǝ, &lt;&lt; Ba ɓǝ bǝ dǝɓa bi yui ɗǝrr kwa?&gt;&gt;<verse eid="LUK 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34" />I gwabnwa angǝ, &lt;&lt;Dangbang dǝna yiɗiu.&gt;&gt;<verse eid="LUK 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 19:35" />I wullǝ wui dǝlǝ Yeso, i al nung ɓuobtthǝ gi lo yui ɗǝrr lǝ i dǝ Yeso lo yui ɗǝrr lǝ. <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />Kwɔ u thko i ilǝ, yayuu nyan nung ɓuobtthǝ gi lo nung lǝi.<verse eid="LUK 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37" />Kwɔ u gbag Urshalima, bǝi kwɔ lǝi tǝ tal Zaitun tthǝɓǝ, kon ya nanung to gu ǝndǝi baipi bǝ kha Fuh i yol ba nung fǝmlo kwɔ i ɓyǝa ɓǝ:<verse eid="LUK 19:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 19:38" />&lt;&lt;Fuh khana lo yigwoi kwɔ wuo dang ɗuǝn Dangbang ɓǝ!&gt;&gt;</para>
  <para style="q1" vid="LUK 19:38">&lt;&lt; Bǝ ǝǝ a langǝ i i ghaali ya wayi!&gt;&gt;<verse eid="LUK 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39" />Ya kun dang ya Farisiyawa dang kon lǝ gei Yeso angǝ, &lt;&lt;Ya nanatthǝnung, a gub ɗuogsui ya nanung to mǝ i kǝrr!&gt;&gt;<verse eid="LUK 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40" />Yeso gwabnwa angǝ,&lt;&lt; Ən gei ɓǝtthǝ, &lt;&lt; nǝ i kǝrr, tal a baipi bǝ buogbǝi.&gt;&gt;<verse eid="LUK 19:40" /></para>
  <para style="s">Yeso Tasui Ba Urshalima</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />Kwɔ u gbag Urshalima u ɓyǝa gwoi angǝ a ɓǝ, u tasui lolǝ <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />u gei angǝ, &lt;&lt;Nǝ krǝ ɓa ibǝi nungkwɔ dǝnni yiɗi ɗigǝ babǝ ǝǝ a langǝi! Kwoi ɓa ɓuan ɓa ɓiu! <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />Lona dǝna wɔ kwɔ ya ɓui ɓǝ wa gǝm sua tǝyitthǝ i kwarɓǝ lǝ ǝndǝi a lam nunglǝi bǝi ǝndei. <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />I thǝb ɓǝ, i thǝb yakwɔ dang nyiɓǝ ɓǝ; i yitthǝ tal akun lo a kunnu, bakwɔ ɓa ibǝ vii kwɔ Fuh a wuu tthǝɓǝ lǝu.<verse eid="LUK 19:44" /></para>
  <para style="s">Yeso Tǝ Dangkǝm Nyǝknung</para>
  <para style="r">(<ref loc="MAT 21:12-17">Matthew 21:12-17</ref>; <ref loc="MRK 11:15-19">Markus 11:15-19</ref>; <ref loc="JHN 2:13-22">Yohanna 2:13-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />Ərr Yeso tǝ dang kǝm nyǝknung dǝnnu nan ya lomu. <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />U gei angǝ,&lt;&lt;I vullǝ angǝ, &lt;&lt;&lt;Gwoim a ǝǝlǝ gwoi pinwa&gt;; kwoi ɓa mǝrrǝm lǝ &lt;ɓua ya nung i.&gt; &gt;&gt;<verse eid="LUK 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47" />Vii kwɔ ǝndei Yeso dǝna nanatthǝnung dang kǝm nyǝknung. Kwoi yikku ya nyǝknung, ya nanatthǝ nungzuu i ya dǝ kabnwa nung dang yayuu dǝna yiɗi bǝ thǝu. <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />Yirrǝ i tǝi nung lǝi kwɔ i to ɓǝlǝu, bakwɔ yayuu ǝndei kab ɓuasui dǝi lǝ bagu.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s">Bǝ Ɓib Ba Lo Tthǝnyimmi Gi Yeso</para>
  <para style="r">(<ref loc="MAT 21:23-27">Matthew 21:23-27</ref>; <ref loc="MRK 11:27-33">Markus 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />Vii a kuntthǝ kwɔ dǝnnu nanatthǝnung lǝ yayuu dang kǝm nyǝknung dǝu gei ba a langǝ i tthǝ, yikku ya nyǝknung i ya nanatthǝ nungzuu gi Musa, i yakku, wuo suo angǝ, <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />&lt;&lt;a gei ɓitthǝ i tthǝnyimmi gi yittǝn dǝmma to nungkwa? &lt;&lt; Yi da tthǝnyimmi kwɔ?&gt;&gt;<verse eid="LUK 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3" />Yeso gwabǝi nwa angǝ, &lt;&lt; Langɓǝ mǝn ɓibɓǝ ba. Ɓa gǝim tthǝ, <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />yi dǝ tthǝnyimmi lǝ Yohanna ya wollmung tthǝn wayiǝ ko tthǝn tthǝ yayuu?&gt;&gt;<verse eid="LUK 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5" />I mab lǝ thatthǝ ganglangǝ i i gei angǝ, &lt;&lt; Nǝ ɓi gei ɓi angǝ, &lt;Tthǝn wayi,&gt; u ɓib ɓi angǝ, &lt;Ba ɓǝ bǝ ɓa gwab ba gu lǝu? <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />Kwoi nǝ ɓi gei ɓi angǝ, &lt;Tthǝn tthǝ yayuu,&gt; yayuu a waɓi i tal, bakwɔ i nhǝm angǝ Yohanna ǝn ya gei ba a tthasi ɓǝ.&gt;&gt;<verse eid="LUK 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 20:7" />Nungkwɔ i gwabnwa angǝ, &lt;&lt;Ɓi ibǝi bǝi kwɔ ǝrr tthǝ ɓǝlǝu.&gt;&gt;<verse eid="LUK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8" />Yeso gei angǝ, &lt;&lt; Langɓǝ ǝn ɓuan ǝn gei ɓǝ tthǝnyimmi yiǝ dǝm tolǝ nungkwɔu.&gt;&gt;<verse eid="LUK 20:8" /></para>
  <para style="s">Bǝ Liba Loya Haya</para>
  <para style="r">(<ref loc="MAT 21:33-46">Matthew 21:33-46</ref>; <ref loc="MRK 12:1-12">Markus 12:1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />Ərr Yeso lilotthǝ gei bǝ liba kwɔ lǝ yayuu tthǝ angǝ: &lt;&lt;Yiɓǝi a kun lǝb zug inabi, u dǝ haya lǝ ya nung lǝbbi u pa nung gu u tǝ yol sua tutthǝ. <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />Lona ɓǝr nung u tum thǝb gu tthǝ ya haya lǝ yangbǝ i duu si inabi ɓǝ. Kwoi ya haya ɓǝ ɓuo nannu na nǝkwam. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />Nungkwɔ u tum thǝb gu a kun, yuu akulo langɓǝ i ɓuo i du tthǝkku i nannu na nǝkwam. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />Ərr u tum a nung taiu langkwoi, i nkoniu i wko lǝtǝ gwam.<verse eid="LUK 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13" />&lt;&lt; Ərr yuu zug inabi ɓǝ gei angǝ, &lt;Ɓǝ mǝnto? Mǝn tum yuim kwɔ dǝm yiɗi niɓǝ; lko i duu angǝ a.&gt;<verse eid="LUK 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14" />Kwoi kwɔ ya haya ɓǝ ɓyǝko ni, i gei lǝ thatthǝ angǝ. &lt; Ya dǝi lo nungtǝi ɓǝkwɔ. &lt;&lt;Ɓi thǝu, yang ɓi dǝi lo nungtǝi gu.&gt; <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />Nungkwɔ i wko lǝtǝ gwam i thǝu.</para>
  <para style="p" vid="LUK 20:15">&lt;&lt; Ɓǝttǝn yuu zug inabi kwɔ a toi lǝ? <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />Wuu thǝb ya haya kwɔ u dǝ zug inabi ɓǝlǝ yakun.&gt;&gt;</para>
  <para style="p" vid="LUK 20:16">Kwɔ yayuu lǝ nugkwɔ i gei angǝ, &lt;&lt;Kaso bǝ nungkwɔ to tthǝni thǝ!&gt;&gt;<verse eid="LUK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17" />Yeso ɓyǝai dang nungǝi u ɓibbǝi angǝ, &lt;&lt;Lakwɔ ǝn ɓǝ nungvullǝ kwɔ dǝna gei:</para>
  <para style="q1" vid="LUK 20:17">&lt;&lt; &lt; Tal kwɔ ya mainung la kwɔ</para>
  <para style="q2" vid="LUK 20:17">nungɓǝ mǝrrǝm lǝ tal a langǝ i ǝndǝi&gt;?<verse eid="LUK 20:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18" />Yuu akwɔ nǝ o lo tal kullo a ɓuom dang tha; kwoi yuu akwɔ tal ɓǝ o lo a namu lǝ mual.&gt;&gt;<verse eid="LUK 20:18" /></para>
  <para style="s">Bǝ Ɓiba Lobǝ Kwai Nungǝmmi</para>
  <para style="r">(<ref loc="MAT 22:15-22">Matthew 22:15-22</ref>; <ref loc="MRK 12:13-17">Markus 12:13-17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />Ya nanatthǝnung zuu i yakku nyǝknung ɗuu lǝi yangbǝ i muo Yeso bǝi lǝ, bakwɔ i ibǝi kwɔ u gei bǝ liba kwɔ loi lǝ. Kwoi dǝnni surr bǝ muu ba kon yayuu.<verse eid="LUK 20:19" /></para>
  <para style="s">Bǝ Kwai Nungǝmmi Lǝ Kaisar</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20" />Nungkwɔ dǝnni ɗuu nunglǝi yangbǝ i muu, i dǝ nungkurɓǝ lǝ yaɓǝi yakun yangbǝ i to mangǝn ya langǝ i, i tummǝi yangbǝ wui lag bo Yeso i bǝ ɓib ba, yangbǝ i duu lǝ yikku losua. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />Ya ɓuubǝi ɓǝ ɓibbu angǝ: &lt;&lt;Ya nanatthǝnung, ɓi ibǝi dǝmma gei ba langkwoi dǝmma nanatthǝ nungkwɔ ǝn lozuiiu ɓǝ, langkwoi a la yuu akunu dǝmma nanatthǝ nunglǝi Fuh lo ba a langǝ i. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />A gei ɓitthǝ, maɗing kwɔ ɓi kwai nungǝmmi lǝ Kaisar ɓa?<verse eid="LUK 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23" />Kwoi Yeso ɓyǝa nungkwɔ dang wai kwɔ u gei angǝ, <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />Ɓa tamnatthǝ dinari. Hoto yittǝn lolǝ langkwoi bǝ dǝna yittǝn lola?&gt;&gt; i gei angǝ kaisar<verse eid="LUK 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25" />I gwabnwa angǝ,&lt;&lt;Kaisar,&gt;&gt;</para>
  <para style="p" vid="LUK 20:25">Yeso gei angǝ, &lt;&lt;Yang ɓa dǝ nungkwɔ lǝ a bǝ Kaisar kwɔ lǝ Kaisar nungkwɔ ǝn a bǝ Fuh ɓa dǝllǝ Fuh.&gt;&gt;<verse eid="LUK 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26" />I ɓuan i muu dang nungkwɔ u gei bǝi lǝ dang nung yayuu ɓǝlǝu. Loi fǝm tthǝ bǝ gwabnwa gu, nwai gan.<verse eid="LUK 20:26" /></para>
  <para style="s">Bǝ Ɓib Ba Lobǝ Ərrǝu I Nwongǝi</para>
  <para style="r">(<ref loc="MAT 22:23-33">Matthew 22:23-33</ref>; <ref loc="MRK 12:18-27">Markus 12:18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />Yakun dang ya Sadukiyawa kwɔ gei angǝ bǝ ǝrru i nwongǝi yangǝu kwɔ, wuu sua Yeso i bǝ ɓibba angǝ. <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />&lt;&lt;Ya nanatthǝnung, &lt;&lt;Musa vullǝ ɓi tthǝ angǝ nǝ young yuu ɓui yitthǝ yisi yuiu yangǝu, youngǝu ɓǝ a muo siɓui yisi ɓǝ yangbǝ si yui lǝ youngǝu tthǝ. <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />Ya youngtha tthǝ nanaira. Yuu a nwasiu dǝb yisi ɓui yuiu yangǝu. <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />Yuu a rab dǝb yisi ɓǝ. <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />Langkwoi a tai dǝbbu. Lang manung ɓǝ i kwɔ nanaira kwɔ i ɓui, i si yui lǝu. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />Nǝsua ǝndei, yisi ɓǝ ɓui langɓǝ. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />Lakwɔ, vii kwɔ kwamɓui yayuu a ǝrr i nwongǝi, u ǝn si yittǝn? I ǝndǝi nanaira kwɔ i dǝbbuǝnɓǝ?&gt;&gt;<verse eid="LUK 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34" />Yeso gwabǝi nwa angǝ, &lt;&lt;Bǝ dǝb yisi ǝn a bǝ yaɓǝi i yasi longwam kwɔ. <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />Kwoi yaɓǝi i yasi kwɔ i ǝǝlǝ ya langǝ i kwɔ a ǝrr i nwongǝi a ǝǝ dang wam kwɔ da wɔ kwɔ dǝbthko. <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />Langkwoi i ɓuiu; bakwɔ i natha i ya nwatummi gi Fuh. I ǝn yathang Fuh, bakwɔ i ǝn yathang ǝrr dang ɓua. <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" />Kwoi ko Musa i nko lǝ gei kaitthǝ angǝ i ǝǝr lǝ kwamɓui yayuu i nwongǝi. Ba lua kwɔ da li dang gug kwɔ u gei ba Dangbang angǝ&lt;Fuh kwɔ Ibrahim dǝna wab, Ishaku dǝna wab, i Fuh kwɔ Yakubu dǝna wab ɓǝ.&gt; <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />U ǝn Fuh ya komɓui yayuu lǝu, kwoi ya nwongǝi, tthǝu lǝ yayuu ǝndǝi i nwongǝi.&gt;&gt;<verse eid="LUK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39" />Yakun dang ya nanatthǝ nungzuu gwabnwa angǝ, &lt;&lt;A gei maɗing ya nanatthǝnung!&gt;&gt; <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />Langkwoi yuu akun yangǝu toki gu i bǝ ɓib ba a kunnu.<verse eid="LUK 20:40" /></para>
  <para style="s">Bǝ Ɓib Ba Lo Kristi</para>
  <para style="r">(<ref loc="MAT 22:41-46">Matthew 22:41-46</ref>; <ref loc="MRK 12:35-37">Markus 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />Ərr Yeso gei angǝ, &lt;&lt;To nǝnǝ bǝ i ɓib angǝ Kristi ǝn ya gwoi gi Dawuda? <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" />Bakwɔ Dawuda i nko lǝ gei dang Zabura angǝ:</para>
  <para style="q1" vid="LUK 20:42">&lt;&lt; &lt;Dangbang gei lǝ Dangbangǝm tthǝ angǝ:</para>
  <para style="q2" vid="LUK 20:42">&lt;&lt; A ǝǝ lonam a nali<verse eid="LUK 20:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="LUK 20:43" />nǝ ǝn to ya ɓui mǝ mǝrrǝm lǝ thko dǝbo mǝ ɗǝ.&gt;<verse eid="LUK 20:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44" />Nǝ Dawuda lubǝiu angǝ&lt;Dangbang.&gt; To nǝnǝ langkwoi Kristi lǝ yuiu?&gt;&gt;<verse eid="LUK 20:44" /></para>
  <para style="s">Yeso Gub Ɗuogsui Yayuu Ba Ya Nanatthǝ Nungzuu Gi Musa</para>
  <para style="r">(<ref loc="MAT 23:1-36">Matthew 23:1-36</ref>; <ref loc="MRK 12:38-40">Markus 12:38-40</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />Kwɔ yirra yayuu dǝna lǝba kwɔ, Yeso gei ya nanung to gu angǝ, <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />&lt;&lt;Ɓa kang ya nanatthǝnung zuu. I yiɗi bǝ gǝngǝu i gong nunglitthǝ a goni langkwoi i yiɗi kaso yayuu nǝ gummǝi dang lomu lang kwoi i ǝǝ bǝ ǝǝ a langǝ i kǝm kǝbtha ya Yahudawa lang kwoi bǝ ǝǝ yaku pang ɓang. <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />Dǝnni tam ya siɓui gwoi gi langkwoi dǝnni pinwa sua tutthǝ. Yayuu manungkwɔni i ji zuii pǝl a bǝ yayuu ǝndǝi!&gt;&gt;<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s">Nungdǝ Ya Siɓui</para>
  <para style="r">(<ref loc="MRK 12:41-44">Markus 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />Yeso ɓyǝa ya nungtǝi dǝna dǝ nung dang bǝ dǝ nung kǝm nyǝknung. <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />Langɓǝ u ɓyǝa siɓui a kun ya yiɓko wuu dǝ nungkurɓǝ anini rab. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />Yeso gei angǝ,&lt;&lt;Ən geiɓǝ ba a langǝ i tthǝ, &lt;&lt; yisi ya yiɓko kwɔ dǝ kpaa pǝll a bǝ sua yakwɔ ǝndei. <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />Yakwɔ ǝndei i dǝ nungkwɔ dang nungtǝi gi; kwoi yisi kwɔ dang yiɓko gu u dǝ nungkwɔ nwongǝi gu lolǝɓǝ.&gt;&gt;<verse eid="LUK 21:4" /></para>
  <para style="s">Yeso Geiba Lo Bǝ Dǝr Kǝm Nyǝknung</para>
  <para style="r">(<ref loc="MAT 24:1">Matthew 24:1</ref>,<ref loc="MAT 24:2">2</ref>; Markus 13:1, 2)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />Yakun dang ya nanung to gu dǝna gei ba lo mali gi kǝm Nyǝknung kwɔ i mab i tal a langǝ i i nungkwɔ dǝnni dǝlǝ Fuh ɓǝ. Ərr Yeso gei angǝ, <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />&lt;&lt;Lǝba nungkwɔ ɓa ɓyǝa bǝi kwɔ, lona da wɔ kwɔ tal a kun yangǝu i yitthǝ lo a kun ɓǝ; tal ɓǝ ǝndǝi i al lǝtǝ pangsua.<verse eid="LUK 21:6" /></para>
  <para style="s">Yurrǝ I Bǝ To Zuii</para>
  <para style="r">(<ref loc="MAT 24:3-14">Matthew 24:3-14</ref>; <ref loc="MRK 13:3-13">Markus 13:3-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7" />Ya nanung to gu ɓib angǝ,&lt;&lt;Ya nanatthǝnung, &lt;&lt;nǝɓǝ nungkwɔ a to nung? Langkwoi ǝnɓǝ lǝ killǝng angǝ i gbagǝn?&gt;&gt;<verse eid="LUK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8" />Yeso gwabnwa angǝ: &lt;&lt;Ɓa dǝ kiggǝ ɓǝ bǝ yuu akun ɗam ɓǝ thǝ. Yayuu kpaatthǝ a wɔ dang ɗuǝnǝm, dǝna lǝi angǝ, &lt;&lt;Ɓang ǝn u,&gt; langkwoi, &lt; Lona gbagǝn.&gt;Bǝɓa muo suai thǝ. <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />Nǝɓa lǝ ba ɓui ibǝ ǝrr lǝ kiggǝ, bǝɓa lǝ tthǝvulli thǝ. I nungkwɔ a to ǝnto la nwasiu, kwoi nwa fungwam thǝm viilǝu.&gt;&gt;<verse eid="LUK 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10" />Yang ǝrr u gei angǝ: &lt;&lt;Gong losua ǝrr lo gong losua, langkwoi losua yigwoi lo losua yigwoi. <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />Pangsua a thǝuri ghaatthǝ, gwom i nungzii a ɓko lǝi bǝi ǝndǝi, nung ǝrr lǝ kiggǝ angǝ a a wɔ wayi.<verse eid="LUK 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 21:12" />&lt;&lt;Kwoi bǝ i nungkwɔ to nung, i dǝɓǝ zuii. I dǝɓǝ na ya kǝm kǝbtha i pursǝna, i wuu ɓǝ lǝ tthasi ya yigwoi i yikku losua angǝ a, lǝ ba ɗuǝnnǝm. <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />Nungkwɔ lǝ lona kwɔ ɓa gei nwa ba langǝ i ɓǝ. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" />Kwoi ɓa mab nungkwɔ ɓa dǝ dang waɓǝ lǝ bǝ ɓa ǝrr lǝ kiggǝ ɓangǝ ɓa to nǝnǝ ɓa ilǝ loɓa, <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />Bakwɔ ɓang mǝn dǝɓǝ ba i yiggǝi kwɔ ya dǝɓǝ zuii ɓuan laɓǝu ko i nyim nwaɓǝ lo nungkwɔ ɓa geiu ɓǝ. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />Ya daa ɓǝ a ɓangɓǝ lǝ, ya young, yayuu ɓǝ i ya ǝnthǝ, i thǝb yakun dang ɓǝ. <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />Yayuu ǝndei a laɓǝ lǝ bam. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />Kwoi byang loɓǝ kun lko. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />Bǝ dǝi nyimtthǝ, ɓa tǝi nwongǝi a ɗing.<verse eid="LUK 21:19" /></para>
  <para style="s">Yeso Gei Ba Bǝ Dǝrr Urshalima</para>
  <para style="r">(<ref loc="MAT 24:15-21">Matthew 24:15-21</ref>; <ref loc="MRK 13:14-19">Markus 13:14-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />&lt;&lt; Kwɔ nǝɓa ɓyǝa ya taɓui kwar Urshalima ǝndǝi, yang ɓa ibǝi bǝ ɓangǝu lǝ wung. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />Yang yakwɔ Yahudiya sur tǝ tal, yakwɔ dang losua angǝ a kwɔ pa, yang yakwɔ zug bǝ tǝ gong gwoi ɓǝthǝ. <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" />Bakwɔ lona ɓǝkwɔ a ǝǝlǝ vii tang zuii&gt;, yangbǝ nungkwɔ nungvullǝ gi Fuh gei ǝǝ lǝ ba langǝ i. <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />Vii ɓǝ kwɔ a ɓko lǝ ya wa tthǝ ɗing i ya yui! Gong zuii tthǝ losua lǝ i nyi gi Fuh lo yayuu. <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />I ɓui i nwa kafǝi i eei lǝ ya thǝb ɓui i tǝlǝ losua a kun. Ya wabnung a tam Urshalima i bo wuu tǝlǝ viikwɔ lona ya wabnung wa natthǝ ɓǝ.<verse eid="LUK 21:24" /></para>
  <para style="s">Bǝ Wuo Gi Yui Yuu</para>
  <para style="r">(<ref loc="MAT 24:29-31">Matthew 24:29-31</ref>; <ref loc="MRK 13:24-27">Markus 13:24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />&lt;&lt;Nung a i dang fuh, fyh i vin. Longwam, losua a ǝǝ dang zuii i lǝ tthǝvulli bǝ ǝrr gi mung. <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />Yayuu a o ǝnkwoi ba nung a ɓko, dǝnni ɓib nungkwɔ a tǝi longwam ɓǝ, nung dang wayi a thǝuri. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" />Yang lona lǝ kullo ɓang Yui Yuu a wɔ dang tǝi i ttha i gong bǝ dǝ angǝ a. <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />Kwɔ i nungkwɔ baipi bǝ to nung, ɓadǝi nǝbo yang ɓa lǝi loɓǝ yi, bakwɔ ya nwong ɓǝ gbagǝn ɓǝ.&gt;&gt;<verse eid="LUK 21:28" /></para>
  <para style="s">Ɓa Nanung Tthǝ Kab Gol</para>
  <para style="r">(<ref loc="MAT 24:32-35">Matthew 24:32-35</ref>; <ref loc="MRK 13:28-31">Markus 13:28-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />Yeso gei bǝ li bakwɔ tthǝ angǝ: &lt;&lt;Ɓa nhǝm kab gol i sua kab ǝndei. <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />Nǝɓa ɓyǝa yangǝu dǝna bai, ɓa ibǝi i naɓǝ ɓangǝ thalǝu gbagǝn. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />Nǝ lang manung ɓǝnni, nǝɓa ɓyǝa i nungkwɔ, yang ɓa ibǝi bǝ lo yigwoi Fuh gbagǝng.<verse eid="LUK 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32" />&lt;&lt;Ən gei ɓǝ ba a langǝ i tthǝ, dang wam kwɔ la langǝ i thǝmmu nungkwɔ wuu pa ɗǝ. <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />Wayi i pangsua a thǝnthǝm, bam a ǝǝ laɗing.<verse eid="LUK 21:33" /></para>
  <para style="s">Nungkwɔ To Ɓadǝ Kiggǝɓǝ Ɓǝ</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />&lt;&lt;Ɓa dǝ kiggǝ ɓǝ! Bǝɓa dǝ kiggǝ ɓǝ bǝ to ɓang i bǝ nwamung i bǝ ǝrr lǝ kiggǝ ba nwongǝi kwɔ thǝ, ko vii ɓǝ wuu muo ɓǝ ɓa ibǝi lǝu. <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />Bakwɔ a wɔ lo yakwɔ ǝndei ǝǝ longwam mangǝ ǝn tarko. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />Vii ǝndei nǝɓa dǝ kiggǝ ɓǝ, langkwoi ɓa pinwa yangbǝ bǝɓa o dang nungkwɔ dǝna wɔ ɓǝthǝ, langkwoi yangbǝ ɓa ɓuan ɓa dǝi tthasi Yui Yuu.&gt;&gt;<verse eid="LUK 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />Vii kwɔ ǝndei Yeso dǝna nanatthǝnung dang kǝm Nyǝknung, langkwoi nungluii ǝndǝi u i u tǝ lotal Zaitun tǝu lobǝi lǝ, <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />langkwoi yayuu ǝndǝi wuo nungwoi ɗǝng bǝ lǝu dang kǝm Nyǝknung.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s">I Mab Zuii Bǝ Thǝb Yeso</para>
  <para style="r">(<ref loc="MAT 26:1-5">Matthew 26:1-5</ref>; <ref loc="MRK 14:1">Markus 14:1</ref>,<ref loc="MRK 14:2">2</ref>; <ref loc="JHN 11:45-53">Yohanna 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />Lona ɓang burodi kwɔ i al nungkwɔ dǝna fǝm mualtthǝ gbagǝng kwɔ dǝnni lu angǝ, bǝ nyang lo kwɔ. <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />Yakku ya nyǝknung i ya nanatthǝnung Musa dǝna ɗubǝ nunglǝi yangbǝ i thǝb Yeso dang bǝthǝl, bakwɔ dǝnni surr yayuu .<verse eid="LUK 22:2" /></para>
  <para style="s">Yahuda Gwabnwa Bǝ Ɓanglǝ Yeso</para>
  <para style="r">(<ref loc="MAT 26:14-16">Matthew 26:14-16</ref>; Markus 14:10, 11)</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3" />Ərr Mungkullum tǝ dang wa Yahuda, kwɔ dǝnni lu angǝ Iskariyoti ɓǝ, yuu akun dang ya nananung to sob iu rab. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />Yahuda ǝrr tǝ sua yikku ya nyǝknung i yakku kinwa kǝm Nyǝknung u gei i ilǝ nunglǝi kwɔ u ɓanglǝ Yeso ɓǝ. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />Tthǝi la ǝndǝi langkwoi i gwabnwa i duu nungkurɓǝ. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />U gwab, u ɗuu nunglǝi yangbǝ u ji Yeso bǝi kwɔ kon yangǝu tthǝ ɓǝ.<verse eid="LUK 22:6" /></para>
  <para style="s">Yeso Mabzuii Bǝ Tang Nungtang Nyang Lo</para>
  <para style="r">(<ref loc="MAT 26:17-25">Matthew 26:17-25</ref>; <ref loc="MRK 14:12-21">Markus 14:12-21</ref>; <ref loc="JHN 13:21-30">Yohanna 13:21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />Ərr vii ɓang burodi kwɔ mual fǝm nungtang yangǝu kwɔ wuo kwɔ i vuu ɓangam i nyǝklǝ ɓǝ. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />Yeso tum Bitrus i Yohanna, angǝ, &lt;&lt; Ɓatǝ tǝɓa mab zuii nung yangbǝ tǝ ɓi tang nungtang nyang lo ɓǝ.&gt;&gt;<verse eid="LUK 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9" />I ɓib angǝ,&lt;&lt;Dǝma yiɗi tǝɓi mab zuiiu ɓǝla?<verse eid="LUK 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10" />U gwapnwa angǝ, &lt;&lt;Nung bǝi kwɔ ɓatǝ gwoi angǝ a, ɓa tǝi yiɓǝi a kun lǝi gib mungki a tǝi ɓǝ. Ɓa muo suo ɓatǝ gwoi kwɔ u tǝtthǝ ɓǝ, <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />ɓa gei yuu gwoi ɓǝ ɓangǝ, &lt;Ya nanatthǝnung dǝna ɓib: Kǝm yayol ɓǝla, bǝi kwɔ mǝn tang nungtang nyang lo tthǝ i ya nanung tom ɓǝ? <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />U taɓǝ natthǝ gong kǝm tthǝ yilǝ, matthǝ. Ɓa mabzuii nung bǝi lǝ.&gt;&gt;<verse eid="LUK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13" />I pa tǝitǝi nungkwɔ manung akwɔ Yeso geitthǝ ɓǝ. I mab zuii nungtang nyanglo ɓǝ bǝi lǝ.<verse eid="LUK 22:13" /></para>
  <para style="s">Nungtang A Nungluii Gi Dangbang</para>
  <para style="r">(<ref loc="MAT 26:26-30">Matthew 26:26-30</ref>; <ref loc="MRK 14:22-26">Markus 14:22-26</ref>; <ref loc="1CO 11:23-25">Korontiyawa 1 11:23-25</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />Kwɔ lona ɓǝ wuo, Yeso i ya nwatummi gu ǝǝ sua bǝ tangnung tang. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />Ərr u gei angǝ, &lt;&lt;Ən yiɗi bǝ tang nungtang kwɔ i ɓǝ lǝ ɗing yang bǝ ǝn to zuii. <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />Ən gei ɓǝtthǝ, Ən tang akunu nǝ i dǝ maanǝ bǝ lo yigwoi Fuh ɗǝ.&gt;&gt;<verse eid="LUK 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17" />Nungkwɔ Yeso lǝi kwab, u kha Fuh angǝ, &lt;&lt; Ɓa muo nungkwɔ ɓa gablǝtha ganglang ɓǝ. <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />Ən gei ɓǝtthǝ baipiu lakwɔ ǝn nwa mung inabi a kunnu tǝlǝ vii bǝ lo yigwoi Fuh nǝ wuo ɗǝ.&gt;&gt;<verse eid="LUK 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19" />Langkwoi u lǝi burodi, u kha Fuh u kwǝ, u ji, angǝ,&lt;&lt;Nungkwɔ ǝn tthǝm i dǝlǝ baɓǝ; ɓato nungkwɔ lǝ babǝ nhǝmǝm.&gt;&gt;<verse eid="LUK 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 22:20" />Manung a nwasiu, tthasua nung tang u lǝi kwab, angǝ, &lt;&lt;kwab kwɔ gang langǝm a fuu dang ziim lǝ, kwɔ i alǝtǝ lǝ baɓǝ. <verse eid="LUK 22:20" /><verse number="21" style="v" sid="LUK 22:21" />Kwoi yuu akwɔ nko a ɓangǝm lǝ kwɔ lo tǝbur i ɓanglǝ. <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />Ɓang Yui Yuu a pa manung akwɔ i gei ɓǝ, kwoi zuii tǝi yuu akwɔ a ɓangǝu lǝ ɓǝ.&gt;&gt; <verse eid="LUK 22:22" /><verse number="23" style="v" sid="LUK 22:23" />I ǝǝ nwa bǝ ɓibtha angǝ ǝn yittǝn a to nungkwa.<verse eid="LUK 22:23" /></para>
  <para style="s">Bǝ Nyimtha Nwa Angǝ Yilǝ Yuu Angã</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />Langkwoi bǝ nyimtha nwa ǝrr ganglangǝ i angǝ yi lǝ yuu angǝ a dang ǝi. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />Yeso gei angǝ, &lt;&lt;Ya yigwoi losua yayol tthǝ i ttha lo yayuu gi; langkwoi yakwɔ dǝna to iko i ilǝ lubǝ loi angǝ i ǝn &lt;Ya ǝnthǝ yayuu&gt;. <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />Kwoi bǝɓa ǝǝ manung ɓǝthǝ, yuu angǝ a dang ɓǝ a ǝǝ mangǝn munthang, yuu akwɔ lǝ yikku dang ɓǝ a ǝǝ lǝ thǝb. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />Yuu kwɔ lǝ angǝ a, yuu akwɔ ǝǝ bǝ tangnung ko ǝn uɓǝkwɔ ǝǝ ɓǝ lǝu? Kwoi u ǝǝ ganglang ɓǝ mangǝn thǝb ɓǝ. <verse eid="LUK 22:27" /><verse number="28" style="v" sid="LUK 22:28" />Ɓa dǝi suam dang bǝ nabǝim ǝndǝi. <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />Langkwoi ǝn dǝɓǝ bǝ lo yigwoi, manungɓǝ lang daam dǝm bǝ lo yigwoi ɓǝ, <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" />Yangbǝ ɓa tang ɓa nwa i ɓanglǝ bǝ lo yigwoim, ɓa ǝǝ lo nung ǝǝ yigwoi ɓa to kwan lǝ kab gwoi Israila tthǝ sob iu rab.<verse eid="LUK 22:30" /></para>
  <para style="s">Yeso Gei Ba Lobǝ Yǝrnwa Gi Bitrus</para>
  <para style="r">(<ref loc="MAT 26:31-35">Matthew 26:31-35</ref>; <ref loc="MRK 14:27-31">Markus 14:27-31</ref>; <ref loc="JHN 13:36-38">Yohanna 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />&lt;&lt;Saminu, Saminu! Mungkullum ɗyǝab angǝ i yǝbɓǝ lǝ nwa bǝ yǝlnung. <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />Kwoi ǝn piɓǝ nwatthǝng, Saminu, yangbǝ bǝ dǝnyitthǝ ɓǝ othǝ. Langkwoi nǝ akwoi suamǝ, a nyimtthǝ ya young mǝ yaɓǝi.&gt;&gt;<verse eid="LUK 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33" />Bitrus gwabnwa angǝ, &lt;&lt;Dangbang, mǝntǝ pursǝna i mǝ langkwoi i ɓua.&gt;&gt;<verse eid="LUK 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34" />Yeso gwabnwa angǝ, &lt;&lt;Bitrus ǝn gei tthǝ, ma yǝrnwa tthǝm bo tai ɗiggǝ kwɔ nwuni bǝ gog ta.&gt;&gt;<verse eid="LUK 22:34" /></para>
  <para style="s">Tthko Nungkurɓǝ, Tthko, I Kafǝi</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />Ərr Yeso ɓibǝi angǝ, &lt;&lt;Kwɔ ǝn tumɓǝ tthko yangǝu na ɓǝu, ko ǝn ǝko, nungtthǝ ɓa tǝi lǝu?&gt;&gt;</para>
  <para style="p" vid="LUK 22:35">I gwabnwa angǝ,&lt;&lt;Nung yangǝu,&gt;&gt;<verse eid="LUK 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36" />U gei angǝ, &lt;&lt;Kwoi lakwɔ nǝ tthko nungkurɓǝ tthǝ, ɓa lǝi, langkwoi i tthko angǝ a; langkwoi nǝɓa yangǝu i kafǝiu, ɓa ɗyǝap nung ɓuobtthǝ ɓǝ ɓa ɗyǝab lǝ. <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />I vullǝ angǝ: &lt;Langkwoi i thannu i ya to nung a ɓko&gt;; ǝn gei ɓǝtthǝ nungkwɔ a to ǝnto tthǝm lǝ. Əah, nungkwɔ i vullǝ lom lǝ kwɔ gbag bǝ wuouǝn.&gt;&gt;<verse eid="LUK 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38" />Ya nanung to gu gei angǝ, &lt;&lt; A ɓyǝa, Dangbang, kafǝi kwɔ rab ɓǝ.&gt;&gt;</para>
  <para style="q" vid="LUK 22:38">&lt;&lt;Nattheng,&gt;&gt;u gwabnwa lǝ ya nanung to gu.<verse eid="LUK 22:38" /></para>
  <para style="s">Yeso Pinwa Lo Tal Zeitun</para>
  <para style="r">(<ref loc="MAT 26:36-46">Matthew 26:36-46</ref>; <ref loc="MRK 14:32-42">Markus 14:32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />Yeso igwam manung azǝ tǝ lotal Zaitun, ya nanung to gu muo suo. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />Ni kǝn bǝiɓǝni, u gei angǝ, &lt;&lt;Ɓa pinwa yangbǝ bǝɓa o dang bǝ nabǝi thǝ.&gt;&gt; <verse eid="LUK 22:40" /><verse number="41" style="v" sid="LUK 22:41" />U kwoi sua tthangǝ i tuliu natha ibǝ wa tal, u bai nwalongǝu sua u pinwa, <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />&lt;&lt;Daa, na gwabǝng, a lǝi kuab kwɔ nam lǝ.&gt;&gt;Yirrǝ ǝn bǝ yiɗim lǝu, nungkwɔ dǝmma yiɗi ɓǝ.&gt;&gt; <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />Ya nwatummi wuo wayi fug tthǝu u duu tthǝ nyimmi. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />Langkwoi kwɔ u dang zuii, u pinwa a kun dang wa kun, busoni gu mangǝn zii dǝna o pangsua.<verse eid="LUK 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45" />Kwɔ u ǝrr bǝ pinwa u kwoi suo wuu tǝi ya nanung to gu, wuu tǝi dǝnni lo nung lo, thǝmmǝi baɓǝ ɓanglǝ dang wa. <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />U gei angǝ,&lt;&lt;Baɓǝ bǝ dǝɓa lo nung lo? Ɓa ǝrr ɓa pinwa yangbǝ bǝɓa o dang bǝ nabǝi thǝ.&gt;&gt;<verse eid="LUK 22:46" /></para>
  <para style="s">Bǝ Muo Yeso</para>
  <para style="r">(<ref loc="MAT 26:47-56">Matthew 26:47-56</ref>; <ref loc="MRK 14:43-50">Markus 14:43-50</ref>; <ref loc="JHN 18:3-11">Yohanna 18:3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />Kwɔ yirrǝ Yeso dǝna gei ba kon yayuu wuo, ǝrr yiɓǝi kwɔ dǝnni lu angǝ Yahuza kwɔ, yuu akun dang ya nwatummi gi Yeso sob iu rab kwɔ dǝnni lu angǝ Yahuda, u oilǝ si. U gbag Yeso yangbǝ u sumbace gu. <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />Yeso ǝrr ɓibbu angǝ, &lt;&lt;Yahuda, dǝmma ɓanglǝ ɓang Yui Yuu i sumba?&gt;&gt;<verse eid="LUK 22:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49" />Kwɔ ya muo sua Yeso ɓinung kwɔ ni, i gei angǝ, &lt;&lt;Dangbang, ɓi gabbǝi i kafǝi ɓiǝ?&gt;&gt; <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />Langkwoi yuu akun dang ǝi gab thǝb gi yikku ya wabnung, ɓǝrr ɗogsuiu a nali.<verse eid="LUK 22:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51" />Kwoi Yeso gwabnwa angǝ, &lt;&lt;Bǝ to ni yangǝu!&gt;&gt; Ərr u kǝn natthǝ ɗogsui yiɓǝi ɓǝ u duu tthǝla.<verse eid="LUK 22:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52" />Ərr Yeso gei lǝ yikku ya nyǝknung, yakku ya kinwa kǝm Nyǝknung, i yakku, yakwɔ wuo bǝ muu kwɔ, &lt;&lt;Dǝmǝn osi lǝ ya ǝrr lǝ kiggǝ? Kwɔ ɓa wɔ i kafǝi i kabba? <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />Vii kwɔ ǝndei ɓang i ɓǝllǝ dang kǝm Nyǝknung, ɓa muom lǝu. Kwoi ǝn lona ɓǝkwɔ- kwɔ tthǝl a to nung to ɓa.&gt;&gt;<verse eid="LUK 22:53" /></para>
  <para style="s">Bitrus Yǝrnwa Tthǝ Yeso</para>
  <para style="r">(Matthew 26:57, 58, 69-75; Markus 14:53, 54, 66-72; Yohanna 18:12-18, 25-27)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />Yang ǝrr i muo Yeso i palǝ i tǝlǝ dang gwoi yikku ya Nyǝknung. Bitrus dǝna muo suoi tutthǝ. <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />Ərr i mab lua dang gwoi lǝ i ǝǝ nungtha, Bitrus ǝǝ i ilǝ. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />Thǝb munthang a yisi a kun ɓiu u ǝǝ bǝi lǝ nwakab lua lǝ. U ɓiu dang nungǝu ǝrr u gei angǝ, &lt;&lt;Yiɓǝi kwɔ i ulǝ.&gt;&gt;<verse eid="LUK 22:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57" />Ərr u yǝrrnwa u gei angǝ, &lt;&lt;Yisi, ǝn iu lǝu,&gt;&gt;<verse eid="LUK 22:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58" />Natthǝ tuab yuu akun ɓiu ǝrr gei angǝ, &lt;&lt;Mǝ dang ǝi lǝ.&gt;&gt;</para>
  <para style="p" vid="LUK 22:58">Bitrus yǝrnwa angǝ, &lt;&lt;Yiɓǝi, ǝn ɓang lǝu!&gt;&gt;<verse eid="LUK 22:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59" />Natthǝ lona gbag lona kun yuu akun gei angǝ, &lt;&lt;Ba a langǝ i yuu kwɔ i ulǝ, bakwɔ u ǝn ya Galili ɓǝ.&gt;&gt;<verse eid="LUK 22:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60" />Bitrus gwabnwa angǝ, &lt;&lt;Yiɓǝi, ǝn ibǝ nungkwɔ dǝmma gei ɓǝlǝu!&gt;&gt;</para>
  <para style="p" vid="LUK 22:60">Bǝi lǝ kwɔ yirre dǝnnu gei ba niyang, gog ta. <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />Dangbang mǝrrǝm ɓyǝa Bitrus. Yang Bitrus nhǝm bakwɔ Dangbang geiu lǝ ɓǝ: &lt;&lt;Nungbǝi akwɔ gog a ta ɗiggǝ kwɔ, ma gei bo tai mangǝ i imlǝu.&gt;&gt; <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />Ərr u i gwam tǝu tasui lko.<verse eid="LUK 22:62" /></para>
  <para style="s">I Tthak Yeso Langkwoi I Ɓuo</para>
  <para style="r">(Matthew 26:67, 68; <ref loc="MRK 14:65">Markus 14:65</ref>)</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />Yaɓǝi kwɔ dǝna ki Yeso kwɔ baipi bǝ tthakgu dǝnni ɓuo. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />I tthǝb nungǝu yang i ɓibbu angǝ ǝnyi siǝ? A gei!&gt;&gt; <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />Langkwoi i gei nung ɗyǝm kpaatthǝ tthǝulǝ.<verse eid="LUK 22:65" /></para>
  <para style="s">Yeso Tthasi Yakku</para>
  <para style="r">(<ref loc="MAT 26:59-66">Matthew 26:59-66</ref>; <ref loc="MRK 14:55-64">Markus 14:55-64</ref>; <ref loc="JHN 18:19-24">Yohanna 18:19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />Kwɔ bǝi da kan yakku yayuu, i yikku nyǝknung ya nanatthǝnung zuu, kǝbtha, i wulǝ Yeso lǝ tthasiǝ. <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />I gei angǝ,&lt;&lt;Nǝ mǝn kristi,&lt;&lt;A gei ɓitthǝ.&gt;&gt;</para>
  <para style="p" vid="LUK 22:67">Yeso gwabnwa, &lt;&lt;Nǝ ǝn gei ɓǝtthǝ, ɓa gwabbu, <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />langkwoi nǝ ǝn ɓib ɓǝ, ɓa ɓuan ɓa gwabnwko. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />Baipiu ɗiggǝ kwɔ, ɓang Yui Yuu a ǝǝ lo nali gi Fuh ya angǝ a.&gt;&gt;<verse eid="LUK 22:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70" />I ǝndǝi i ɓib angǝ, &lt;&lt;Yang mǝn Yui Fuh?&gt;&gt;</para>
  <para style="p" vid="LUK 22:70">U gwabnwa angǝ, &lt;&lt;Ɓa gei lo zuiu ɓangǝ ɓang Yuiu.&gt;&gt;<verse eid="LUK 22:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71" />Ərr i gei angǝ, &lt;&lt;Baɓǝ bǝ ɓi yiɗi ba nwa yuu akun? Ɓi lǝ i nwuo lǝng.&gt;&gt;<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s">Yeso Tthasi Bilatus</para>
  <para style="r">(Matthew 27:1, 2, 11-14; <ref loc="MRK 15:1-5">Markus 15:1-5</ref>; <ref loc="JHN 18:28-38">Yohanna 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />Yang yayuu ɓǝkwɔ ǝndei ǝrr tǝu lǝ tthasi Bilatus. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />Langkwoi i baipi bǝ muu i ba angǝ, &lt;&lt;Ɓi tǝi yiɓǝi kwɔ dǝna laba losua ɓi. Dǝnnu gei yayuu bǝ kwai nungǝmmi gi Kaisar thǝ langkwoi dǝnnu gei angǝ i ǝn Kristi, yigwoi.&gt;&gt;<verse eid="LUK 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3" />Nungkwɔ Bilatus ɓib Yeso angǝ, &lt;&lt;Mǝlǝ yigwoi ya Yahudawa?&gt;&gt;</para>
  <para style="p" vid="LUK 23:3">Yeso gwabnwa angǝ,&lt;&lt;Manung akwɔ a gei ɓǝ.&gt;&gt;<verse eid="LUK 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4" />Yang Bilatus gei yakku ya nyǝknung i kon ɓǝ angǝ, &lt;&lt;Əntǝi nungkwɔ mǝn muo lǝ yiɓǝi kwɔ ɓǝllǝu.&gt;&gt;<verse eid="LUK 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5" />Kwoi i nyari, &lt;&lt;U fog yayuu Yahudiya i nung kwɔ dǝu nanatthǝ ɓǝ. U baipiu Galili langkwoi u wuo lǝ bǝi kwɔ.<verse eid="LUK 23:5" /></para>
  <para style="s">Yeso Tthasi Hiridus</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />I bǝ lǝ nungkwɔni, Bilatus ɓib angǝ yiɓǝi kwɔ ǝn ya Galili. <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />Kwo u lǝ angǝ Yeso tthǝn losua Hiridus, u toggu sua Hiridus, lona lǝ kullo u dang Urshalima.<verse eid="LUK 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8" />Kwɔ Hiridus ɓyǝa Yeso, tthǝu la ǝndǝi, bakwɔ sua tuung dǝnnu yiɗi bǝ ɓiu. Tthǝ nungkwɔ u lǝ loɓǝ, u yiɗi bǝ ɓiu yangbǝ u to nung fǝmlo. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />U ɓibbu ba kpaatthǝ, Kwoi Yeso gwabnwa lǝu. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />Yikku ya nyǝknung i ya nanatthǝnung zuu dǝi bǝi lǝ, dǝnni ɓiu i muu i ba lǝ nyimtthǝ. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />Ərr Hiridus i ya taɓui gu dǝnni tou lǝ nung mam langkwoi i tthakgu. I liu nunglitthǝ matthǝ tthǝlǝ, i kwoiu lǝ i tǝlǝ sua Bilatus. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />Vii lǝ kwɔ Hiridus i Bilatus mǝrrǝm lǝ ya ǝnthǝ vii kwɔ i ǝn ɓuitha.<verse eid="LUK 23:12" /></para>
  <para style="s">I Tokwan Ɓua Lǝ Yeso Tthǝ</para>
  <para style="r">(<ref loc="MAT 27:15-26">Matthew 27:15-26</ref>; <ref loc="MRK 15:6-15">Markus 15:6-15</ref>; <ref loc="JHN 18:39">Yohanna 18:39</ref>; <ref loc="JHN 19:16">19:16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />Bilatus lubǝ yakku ya nyǝknung, yakku losua i yayuu, <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />u gei angǝ, &lt;&lt;Ɓa wulǝ yiɓǝi kwɔ ɓangǝ ǝn yuu akwɔ dǝna ɗam yayuu dǝna ǝrr lǝ kiggǝ. Ən ɓibbu nungɓǝ ǝn tǝi nung a kun lǝ bakwɔ ɓa wulǝ lo ɓǝlǝu. <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />Hiridus lang manungɓǝ, u kwoiu lǝ u wulǝ tthǝɓi; manung a kwɔ dǝɓa ɓyǝa kuɓǝ, u to nung a kun kwɔ u ɓuiɓua ɓǝlǝu. <verse eid="LUK 23:15" /><verse number="16-17" style="v" sid="LUK 23:16-17" />Manung kwɔ nikwɔ, mǝn ɓuo i thab yang mǝn yiu na.&gt;&gt;<verse eid="LUK 23:16-17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18" />I buogbǝi i yol kun angǝ, &lt;&lt;Palǝ yiɓǝi kwɔ! Yiɓi natthǝ Barabbas!&gt;&gt; <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />(I tthǝb Barabbas pursǝna ba bǝ ǝrr lǝ kiggǝ yayuu gwoi angǝ a lǝ, i bǝ thǝb yuu.)<verse eid="LUK 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20" />Bilatus gei ba langkwoi bakwɔ dǝnnu yiɗi bǝ yina lǝ Yeso ɓǝ. <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />I ǝǝ nwa bǝ buogbǝi, &lt;&lt;I piu! I piu!&gt;&gt;<verse eid="LUK 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22" />U gei ba a nung tai tthǝu: &lt;&lt;Baɓǝ? Ənɓǝ yiɓǝi kwɔ to lǝ nung a ɓau? Ən tǝi nung a ɓau lolǝ kwɔ u ɓui ɓua ɓǝlǝu. Lakwɔ nikwɔ mǝn ɓuo i thab yang mǝn yiu na.&gt;&gt;<verse eid="LUK 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23" />Kwoi i buogbǝi i yol dǝnni yiɗi angǝ i piu lo kab gangǝ i, bǝ buogbǝi gi tǝi lǝi. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />Ərr Bilatus gwabbǝi nwa nungkwɔ dǝnni yiɗi ɓǝ. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />U yinna lǝ yiɓǝi kwɔ i tthǝbu pursǝna ba bǝ ǝrr lǝ kiggǝ i bǝ thǝb yuu ɓǝ, yuu kwɔ dǝnni yiɗi ɓǝ, u ji Yeso manungkwɔ i yiɗi ɓǝ.<verse eid="LUK 23:25" /></para>
  <para style="s">I Pi Yeso Lokab Gangǝ i</para>
  <para style="r">(<ref loc="MAT 27:32-44">Matthew 27:32-44</ref>; <ref loc="MRK 15:21-32">Markus 15:21-32</ref>; <ref loc="JHN 19:17-27">Yohanna 19:17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />Kwɔ i muu i palǝ, i ɓag Saminu ya kurane, kwɔ u lo nunglǝi gu losua a kun dǝnnu wuo, i duu kab gangǝ i ɓǝ u lǝi u muo lǝ sua Yeso. <verse eid="LUK 23:26" /><verse number="27" style="v" sid="LUK 23:27" />Yayuu kpaatthǝ muo suo, i yasi kwɔ dǝna tasui dǝnni gim lǝ ba gu ɓǝ. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />Yeso mǝrrǝm gei angǝ, &lt;&lt;Yathang a si Urshalima, bǝ ɓa tasui lǝ bamthǝ, ɓa tasui lǝ loɓǝtthǝ i yathang ɓǝ. <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />Bakwɔ lona dǝna wɔ kwɔ ɓa gei ɓangǝ, &lt;Bǝ khana lo ya dǝggǝm, wa kwɔ si yui lǝu bo kun langkwoi dǝmii i bǝ lǝiu lǝu ɓǝ!&gt; <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" />Yang ǝn lona ɓǝ i gei lǝ tal tthǝ angǝ, &lt;A o loɓi!&gt; Langkwoi ɓǝmtal tthǝ angǝ, &lt;A kaɓi!&gt; <verse eid="LUK 23:30" /><verse number="31" style="v" sid="LUK 23:31" />Nǝ yayuu ato i nungkwɔ lǝ kab kwɔ matthǝ kwɔ, ǝn ɓǝ a to nung nǝ kwi ɓa?<verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />Yaɓǝi a kuntthǝ rab, i ǝn ya nung i, i mui i ulǝ yangbǝ tǝi thǝi. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />Kwɔ i wuo bǝi kwɔ dǝnni lu angǝ gung gong lo, bǝi lǝ kwɔ tǝi piu, i ya nung ilǝ-yuu akun lo na a nali, yuu a kun ɓǝ lo namai. <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />Yeso gei angǝ, &lt;&lt;Daa, a al nung a ɓko gi lǝtǝ, i ibǝ nungkwɔ dǝnni to ɓǝlǝu.&gt;&gt; Langkwoi i gab nunglitthǝ gu lǝtha i bǝ bai ǝnchǝl.<verse eid="LUK 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 23:35" />Yayuu dǝi dǝna ɓyǝa, langkwoi yakku dǝna tthagu. Dǝnni gei angǝ, &lt;&lt; U nwong yakun; u nwong lo nǝ u ǝn Kristi gi Fuh, Yuu akwɔ I Mko Ɓǝ.&gt;&gt;<verse eid="LUK 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36" />Ya taɓui langɓǝ wuu tthagu. I duu mung a ǝmmi, <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />i gei angǝ, &lt;&lt; Nǝ mǝn yigwoi ya Yahudawa yang, a nwong lo mǝ.&gt;&gt;<verse eid="LUK 23:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38" />Nungtthǝ i vulǝ i dǝ lo wayi, manungkwɔ ni: Yuu kwɔ Ən Yigwoi Ya Yahudawa.<verse eid="LUK 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39" />Yuu akun dang ya nung i ɓǝ dalu i ɗyǝam angǝ: &lt;&lt;Gǝlko mǝn Kristi? A nwong lo mǝ i ɓilǝ!&gt;&gt;<verse eid="LUK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40" />Kwoi yuu akun ɓǝ ǝrrǝu lǝ angǝ. &lt;&lt;A sur Fuh wa, bakwɔ bǝ lagbǝi mǝ natha i u ɓa? <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />Bǝ lagbǝi ɓi ǝn lozuiu, dǝɓi tǝi ǝn nungkwɔ ɓi to ɓǝ. Kwoi yiɓǝi kwɔ to nung akun lǝ nung a ɓko lǝu.&gt;&gt;<verse eid="LUK 23:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 23:42" />Ərr u gei angǝ, &lt;&lt;Yeso, a nhǝmǝm na wɔ bǝ lo yigwoi mǝ ɓǝ.&gt;&gt;<verse eid="LUK 23:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43" />Yeso geiu angǝ, &lt;&lt;Ən gei ba a langǝ i tthǝ, ɗigǝ kwɔ ma ǝǝ i ɓanglǝ bǝi tthǝla.&gt;&gt;<verse eid="LUK 23:43" /></para>
  <para style="s">Bǝ Ɓuiɓua Gi Yeso</para>
  <para style="r">(<ref loc="MAT 27:45-56">Matthew 27:45-56</ref>; <ref loc="MRK 15:33-41">Markus 15:33-41</ref>; <ref loc="JHN 19:28-30">Yohanna 19:28-30</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />Lakwɔ fuh gbag nyi lo, ǝrr tthǝl bai losua lǝ ǝndei gbag lona a tai dang fuh, <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />bakwɔ fuh labǝ duu. Langkwoi laɓulǝ dang kǝm nyǝknung trǝ dang tha rab. <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />Yeso gei ba i yol angǝ, &lt;&lt;Daa, ǝndǝ ɓyangǝm dang namǝ.&gt;&gt; Tthasua kwɔ u gei nungkwɔ, u gub nwongǝi a nǝsua u ɓui.<verse eid="LUK 23:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47" />Yikku ya taɓui tthǝ, ɓyǝa nungkwɔ to nungkwɔ, u kha Fuh angǝ, &lt;&lt;Ba a langǝ i yiɓǝi kwɔ ǝn ya nung a langǝ i.&gt;&gt; <verse eid="LUK 23:47" /><verse number="48" style="v" sid="LUK 23:48" />Kwɔ yayuu kwɔ ǝndei gǝmtha bǝ ɓyǝa nungkwɔ, i ɓuobna nyingwui i pa lǝi gwoi i dang wai ɓuontthǝ i ba zii bǝi. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />Yakwɔ iu ǝndǝi, i yasi yakwɔ ǝrr Galili muo suo kwɔ, i dǝi tutthǝ dǝnni ɓyǝa nungkwɔ.<verse eid="LUK 23:49" /></para>
  <para style="s">Bǝ Suu Yeso</para>
  <para style="r">(<ref loc="MAT 27:57-61">Matthew 27:57-61</ref>; <ref loc="MRK 15:42-47">Markus 15:42-47</ref>; <ref loc="JHN 19:38-42">Yohanna 19:38-42</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50" />Lakwɔ yiɓǝi a kun tthǝ ɗuǝnnu ǝn Yusufu, u kun dang yakku, yuu a langǝ i, <verse eid="LUK 23:50" /><verse number="51" style="v" sid="LUK 23:51" />Kwɔ u gwab ba gi i nungkwɔ i to ɓǝlǝu. U ǝrr gwoi Arimatiya gwoi angǝ a dang Yahudiya dǝnnu ki bǝ lo yigwoi Fuh kwɔ a wɔ ɓǝ. <verse eid="LUK 23:51" /><verse number="52" style="v" sid="LUK 23:52" />U tǝ sua Bilatus, u ɗyǝap kwamɓui Yeso. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />U pin lǝ lo kab lǝ, kuluam dang landǝ linin kwɔ brǝmtthǝ ɓǝ u dǝ dang ɓua juǝn kwɔ i tha lo ɓǝmtal ɓǝ, kwɔ i dǝ yuutthǝ lǝu bo kun ɓǝ. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />Viiɓǝ kwɔ ǝn vii mab zuiinung, vii nwongǝi gbagǝn.<verse eid="LUK 23:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55" />Yasi kwɔ wuo suatha i Yeso Galili kwɔ muo sua Yusufu tǝi ɓyǝa juǝn ɓǝ lang manung kwɔ i duu dang ǝu ɓǝ. <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />Ərr i tǝ gwoi tǝi mab i nui kwɔ kummu latthǝ kwɔ i turare. Kwoi i nwong manungkwɔ nung zuu gi Musa gei ɓǝ.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s">Bǝ Ərr Gi Yeso</para>
  <para style="r">(<ref loc="MAT 28:1-10">Matthew 28:1-10</ref>; <ref loc="MRK 16:18">Markus 16:18</ref>; <ref loc="JHN 20:1-10">Yohanna 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />Vii a nwasiu dang mako, nungwoi ɗǝng yasi lǝi turare kwɔ i mab kummu latthǝ kwɔ i tǝ lo juǝn ɓǝ, <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />Tǝitei i klǝng tal ɓǝ i koi lǝ nwa juǝn lǝng, <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />Kwoi kwɔ i tǝ dang ɓua juǝn ɓǝ, i tǝi kwamɓui Dangbang Yeso lǝu. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />Kwɔ yirrǝ dǝnni nhǝm ba lo nungkwɔ, dang tthǝ yaɓǝi a kun rab kwɔ nunglitthǝ dǝna yum mangǝn lua gabbǝi dǝi gbag gi. <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />Yasi ɓǝ dǝna surr vulli i bai loi sua dang nungǝi pangsua, yaɓǝi ɓǝ gei angǝ, &lt;&lt;Bǝ nǝɓa ɗubǝ ya nwongǝi bǝi kwɔ dǝnni suu kwamɓui yayuu tthǝɓǝ thǝ? <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />U yangǝu kanniu; u ǝrrǝng! Ɓa nhǝm nungkwɔ u gei ɓǝtthǝ, kwɔ yirrǝ u i ɓǝlǝ Galili ɓǝ: <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />&lt;I dǝ ɓang Yui Yuu dang na ya nung a ɓko, i piu bo tai u ǝrr i nwongǝi.&gt;&gt;&gt; <verse eid="LUK 24:7" /><verse number="8" style="v" sid="LUK 24:8" />Yang yasi ɓǝ ǝrr nhǝm bagu.<verse eid="LUK 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 24:9" />Kwɔ i kwoi nwa ɓua lǝ, i gei nungkwɔ lǝ sua ya sob iu kun ɓǝtthǝ i sua yayuu ǝndei. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />I Maryamu Magadaliya, i suzanatu, i Maryamu na Yakubu, i yasi akun kwɔ i ilǝ yakwɔ gei nungkwɔ lǝ ya nwatummi gi Yeso tthǝ. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />Kwoi ya nwatummi gi Yeso dǝ ba a langǝ i tthǝ yasi kwɔ lǝu, bakwɔ ba gi ǝǝ mangǝn nung a nǝkwam. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />Bitrus, niyang, ǝrr surrdum tǝ nwa juǝn ɓǝ. Tǝmsua, ɓyǝa landǝ linin al bǝi lǝ, ǝrr u pa, dǝnnu nhǝm dang nyiu ǝn ɓǝ to nung manungkwɔni.<verse eid="LUK 24:12" /></para>
  <para style="s">Lo Nunglǝi Tǝ Imuwasu</para>
  <para style="r">(Markus 16:12, 13)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />Lakwɔ vii lǝ yayuu rab dang ǝi dǝnni tǝ gwoi a tuab a kuntthǝ ɗuǝnnu ǝn Imuwasu, mǝl nanaira ǝrr Urshalima. <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />Dǝnni gei ba lǝ tha ba nungkwɔ to nungɓǝ. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />Kwɔ dǝnni gei balǝ tha, Yeso i nko lǝ wuo dǝna thko i ilǝ; <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />kwoi Fuh lam nungǝi bǝ iu.<verse eid="LUK 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17" />Yeso ɓibbǝi angǝ, &lt;&lt; Ɓǝ dǝɓa gei ɓuaɓǝ kwɔ dǝbɓa thko lǝ ɓa?&gt;&gt;</para>
  <para style="p" vid="LUK 24:17">I gaa i dǝi, dang nungǝi tthǝb lǝ tthǝb. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />Yuu akun dang ǝi, ɗuǝnnu ǝn Kiliyobas, ɓibbu angǝ, &lt;&lt;Mǝn yayol Urshalima langkwoi a ibǝ nungkwɔ to nung dang bo rab kwɔ ɓǝlǝu?&gt;&gt;<verse eid="LUK 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19" />Yeso ɓibbǝi angǝ,&lt;&lt;I ɓǝ to nung?&gt;&gt;</para>
  <para style="p" vid="LUK 24:19">I gwabnwa angǝ,&lt;&lt; Ba Yeso ya Nazarat,&gt;&gt; &lt;&lt;Yiɓǝi kwɔ ǝn ya gei ba a tthasi, u nyim ɗing dang ba i nung to tthasi Fuh i yayuu ǝndei. <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />Yikku ya nyǝknung i yakku ɓi tou kwan ɓuatthǝ, langkwoi i piu lo kab gangǝ i; <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />kwoi ɓi dǝnyitthǝ u ǝn yuu akwɔ a wulǝ tthǝla lǝ Israila ɓǝ. Langkwoi ǝnɓǝ a kun, bo tai la ɗiggǝ kwɔ nungkwɔ to nungɓǝ. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />Langkwoi, yasi ɓi yakun dǝɓi tthǝvuli. I tǝ lo juǝn nung gwoi ɗǝng ɗigǝ kwɔ <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />kwoi tǝitei komɓuiu lǝu. I wuo wui gei ɓitthǝ angǝ i ɓyǝa ya nwatummi gi Fuh, i gei angǝ u i nwongǝi. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />Ərr yakun ɓi tǝ lo juǝn ɓǝ tǝitei manungkwɔ yasi ɓǝ gei ɓǝ, i ɓiu lǝu.&gt;&gt;<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />Yeso gei tthǝ angǝ, &lt;&lt;Sulǝ ɓǝ ɓa sulǝ ni? Langkwoi nyiɓǝ tǝmɗing tthǝ bǝ dǝba a langǝ i tthǝ bakwɔ ya gei ba a tthasi gei ɓǝ! <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />Kristi a tang zuii lo nungkwɔ yangbǝ u tǝ dang ghaali gu? <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />Langkwoi bai piu i Musa i ya gei ba a tthasi ǝndǝi, u gei tthǝ nungkwɔ i gei dang nungvullǝ lǝ ba gu ɓǝ.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />Kwɔ i gbag gwoi a tuab kwɔ dǝnni tǝ kwɔ, Yeso to mangǝttǝn dǝna tǝ tthasi. <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />Yayuu kwɔ u sua tha i ulǝ kwɔ ɗyǝabbu angǝ, &lt;&lt; A ǝǝ i ɓi, fuh ong nunglui toǝng; fuh ong.&gt;&gt; Ərr u tǝ tǝu ǝǝi ilǝ.<verse eid="LUK 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 24:30" />Kwɔ dǝnnu tang nung i ilǝ, u lǝi burodi, dǝ angǝ a, kwǝ dǝnnu ji. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />Ərr nungǝi ɓko ǝrr i iu, ǝrr u la bǝi lǝ. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />I ɓib tha, &lt;&lt;Nyi ɓi dǝna lǝi dang tthǝɓi kwɔ dǝnnu gei ba i ɓilǝ lo nunglǝi u ɓko ɓi nungvullǝ ɓǝlǝu?&gt;&gt;<verse eid="LUK 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33" />I ǝrr i kwoi thǝmtthǝ i tǝ Urshalima. Bǝi lǝ tǝitei sua ya sob iu kun i yakwɔ i ilǝ kwɔ, gǝmtha bǝikun <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />Dǝnni gei angǝ, &lt;&lt; Ba langǝ i! Dangbang ǝrrǝng u fug lǝ Saminu tthǝng.&gt;&gt;<verse eid="LUK 24:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35" />Yakwɔ rab kwɔ ǝrr gei nungkwɔ tǝi lo nunglǝi ɓǝ, langkwoi manung a kwɔ i i Yeso kwɔ u kwǝ burodi ɓǝ.<verse eid="LUK 24:35" /></para>
  <para style="s">Yeso Fuktthǝ Ya Nanung To Gu</para>
  <para style="r">(<ref loc="MAT 28:16-20">Matthew 28:16-20</ref>; <ref loc="MRK 16:14-18">Markus 16:14-18</ref>; <ref loc="JHN 20:19-23">Yohanna 20:19-23</ref>; Acts 1:6-8)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />Kwɔ yirrǝ dǝnni gei ba lǝ ba nungkwɔ, Dangbang i nko lǝ dǝi dang ǝi lǝ u gei angǝ, &lt;&lt;ǝndǝ.&gt;&gt;<verse eid="LUK 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37" />I ǝǝ dǝnni lǝtthǝ vulli, dǝnni nhǝm angǝ lko i ɓyǝa ɓyang yuu. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />U gei angǝ, &lt;&lt;Baɓǝ bǝ dǝbɓa lǝtthǝ vulli, baɓǝ bǝ ɓa to shaka dang nyi ɓǝ? <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />Ba ɓyǝa nam i bom. Ən ɓang! Ɓa kǝn natthem ɓa ɓyǝa; ɓyang yangǝu i sual tthǝ i kukub, kwɔ dǝɓa ɓyǝa ɓang tthǝ i ulǝ ɓǝ.&gt;&gt;<verse eid="LUK 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40" />Kwɔ u gei nungkwɔ, u tainatthǝ nko i bo. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />Langkwoi kwɔ yirrǝ i gwab lǝu ba tthǝla i nung fǝmlo, u ɓibǝi angǝ, &lt;&lt;Ɓǝtthǝ i nung tang bǝi kwa?&gt;&gt; <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />I duu tthǝng tthǝ tuabni, <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />U muo u tang nungǝi.<verse eid="LUK 24:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44" />U gei angǝ, &lt;&lt; U nungkwɔ ǝn gei ɓǝtthǝ kwɔ yirrǝ ɓang i ɓǝlǝ ɓǝ: Nungkwɔ ǝndǝi wa pǝmpa kwɔ i vullǝ lǝ bam dang nung zuu gi Musa ɓǝ, ya gei ba a tthasi i Zabura.&gt;&gt; <verse eid="LUK 24:44" /><verse number="45" style="v" sid="LUK 24:45" />Ərr u ɓko lo nyi nwuni i ibǝ nungvullǝ ɓǝ. <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />U gei tthǝ angǝ, &lt;&lt;Nungvullǝ ɓǝ angǝ: Kristi a tang zuii langkwoi u ǝrr dang ɓua vii a tai, <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />langkwoi bǝ al nung a ɓko lǝtǝ i bǝ ee nwa ɓko ba nung a ɓko i gei dang ɗuǝnnu lǝ longwam, bǝ i piu Urshalima. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />Ɓǝn ya shǝdǝ i nungkwɔ. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" />Dǝmǝn tǝbǝ tumbǝi i nungkwɔ Daam gwab ɓǝ nwa ɓǝ; ɓa ǝǝ gwoi angǝ a nǝ i dǝɓǝ ttha wayi ɗǝ.&gt;&gt;<verse eid="LUK 24:49" /></para>
  <para style="s">Bǝ Tǝ Wayi</para>
  <para style="r">(Markus 16:19, 20; Acts 1:9-11)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />Kwɔ u iǝlǝ gwam dang gwoi Betanya, u lǝi nko yi u dǝna loi. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />Kwɔ yirrǝ dǝnnu dǝna loi, i lǝiu itǝlǝ wayi . <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />Ərr i khko i kwoi i tǝ Urshalima i tthǝla ghaatthǝ. <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />Langkwoi mab dǝnni ǝǝ dang kǝm Nyǝknung, dǝnni kha Fuh.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>