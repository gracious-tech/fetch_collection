<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">PHM</para>
  <para style="toc3">PHM</para>
  <para style="mt">PHM</para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />Ɓang Bulus, ya pursǝna lǝ ba Kristi Yeso, langkwoi bǝgǝ Timitawos young ɓi-</para>
  <para style="p" vid="PHM 1:1">Sua Filiman ǝnthǝ ya to nung to suatha iɓilǝ, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />langkwoi i ya kǝm pinwa kwɔ dǝna kǝbtha gwoi mǝ ɓǝ, langkwoi young ɓi a yisi Aufiya, ya soja young ɓi Arkibus:<verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />Kaso Fuh Daa ɓi i Dangbang Yeso Kristi dǝɓǝ nung a langǝ i i bǝ ǝǝ a langǝ i.<verse eid="PHM 1:3" /></para>
  <para style="s">Bǝ Yidɗibǝi I Bǝ Dǝnyitthǝ Gi Filiman</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />Youngǝm Filiman, lona kwɔ ǝndǝi dǝmǝn pinwa, dǝm lu ɗuǝnmǝ langkwoi dǝm dǝ angǝ a lǝ Fuh. <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />Bakwɔ ǝn lǝ bǝ yiɗi bǝi mǝlǝ ba yayuu Fuh ǝndǝi i bǝ dǝnyitthǝ mǝ tthǝ Dangbang Yeso. <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />Bǝ pinwam nungɓǝ lǝ bǝ kǝb tha lo ɓi lǝ ya dǝ ba a langǝ i i mǝ a wɔlǝ bǝ ibǝ nung a langǝ i ghaatthǝ yang bǝ ɓi tǝi bǝ khana lo kwɔ ɓi tǝi dang nwongǝi ɓi dang bǝ kǝbtha ɓi i Kristi. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />Youngǝm, bǝ yiɗi bǝi mǝ, wuom lǝ tthǝla tthǝ ghaatthǝ i tthǝnyimmi! Akai lo nyi yayuu gi Fuh ǝndǝi.<verse eid="PHM 1:7" /></para>
  <para style="s">Bulus Yam Unisimas Naya Kǝm Pinwa</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />Lǝba bakwɔ mǝn ɓuan mǝnto dang wa, manung youngmǝ dang Kristi, mǝn gei ato nungkwɔ kaso ma to ɓǝ. <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />Kwoi bakwɔ dǝm yiɗiǝ, dǝm yam nung nwathannu. Ən to nungkwɔ ko kwɔ ɓang ǝn Bulus, ya nwatummi gi Kristi Yeso, langkwoi lakwɔ nikwɔ ǝnya pursǝna lǝ ba Kristi. <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />Nungkwɔ ǝn yam nung namǝ lǝ nwathan Unisimas, kwɔ lǝ yuim dang Kristi; kwɔ ɓang pursǝna kwɔ ɓanglǝ daa gu dang ɓyang lǝ ɓǝ. <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />Vii kwɔ kiggǝu yangǝu, kwoi lakwɔ u to yuu a langǝ i tthǝɓǝ lǝ i ɓang ǝndǝi.<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />Dǝmǝn toggǝu u kwoi u tǝsua ɓǝ lakwɔ, nyim dǝna tǝsuatha i ulǝ. <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />Dǝmǝn yiɗi bǝ yiu bǝikwɔ i ɓanglǝ, kwɔ ɓang dang pursǝna lǝ ba nwaba a langǝ i, yangbǝ u nwongǝm lǝ nwathan ɓǝ. <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />Kwoi ǝn yiɗi bǝ to ɓǝlǝ ttha bǝ ɓa nwongǝm lǝu; Dǝmǝn yiɗi ato ibǝ yiɗi mǝ. Yang ǝn ɓuan ǝn to nung akunu nǝɓa gwab ɗǝ.<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />Lko bakwɔ Unisimas yangǝu tthangmǝ lona tuab kwɔ yangbǝ u kwoi u tǝ suamǝ sua tutthǝ. <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />Langkwoi lakwɔ u ǝn thǝb ɓuolǝu, kwoi pǝl thǝb bǝng: u ǝn young dang Kristi lǝ. Ən yiɗiu ɗing! Ma yiɗiu a pǝl abǝm, mangǝn thǝb langkwoi lǝ young dang Dangbang!<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />Nungkwɔ, nǝ dǝmma nhǝm mǝm mangǝ ɓang ǝn ya to nung to i mǝ, a kǝb lo manungkwɔ ma kǝb lom ɓǝ. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />Nǝ u to i nung a ɓko a kunnǝng ko than nungmǝ akun lolǝ, a ɓuobnwa lo tthǝm lǝ. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />Bǝikwɔ, mǝn vullǝ nung i namlǝ: Ɓang, Bulus, mǝn kwai nungbusɔni mǝ. (Ən yiɗi bǝ o nyitthǝ lǝu, la langǝ i, geigǝ mǝ i namǝ ǝn than nung to tthǝmlǝ.) <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />Youngǝm, a tom nyitǝmmi lǝ ba Dangbang; mangǝn young dang Kristi, a tǝm lo nyim!<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />Ən ibǝing lalangǝ i, manungkwɔ dǝm vullǝ nungkwɔ, geigǝ ɓa to nungkwɔ ǝn yamɓǝ-lalangǝ i ǝn ibǝing ɓa to a pǝl akwɔ ǝn yamɓǝ. <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />Lona lǝ ǝndǝi, ɓa mabǝm kǝm tthǝ ɓa dǝ, bakwɔ dǝm dǝnyitthǝ Fuh a lǝ bǝ pinwa ɓǝ ǝndǝi a kwoim lǝ a tǝlǝ naɓǝ.<verse eid="PHM 1:22" /></para>
  <para style="s">Bǝ Alo Bǝ Gumbǝi</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />Abafaras, kwɔ pursǝna i ɓanglǝ lǝ ba Kristi Yeso kwɔ, dǝna tumbǝi i bǝ gumbǝi gu, <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />langkwoi manungɓǝ ya to nung to i ɓanglǝ, Markus i Aristarkus, i Dimas i Luka.<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />Kaso nung a langǝ i gi Dangbang Yeso Kristi ǝǝ i ɓǝ ǝndǝi.<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>