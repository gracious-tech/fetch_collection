<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id">2 BITRUS- MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">2 Bitrus</para>
  <para style="toc1">Nungvullǝ A Nung Rabbu Bǝgǝ BITRUS</para>
  <para style="toc2">2 Bitrus</para>
  <para style="toc3">2 B</para>
  <para style="mt2">Nungvullǝ A Nung Rabbu Bǝgǝ</para>
  <para style="mt1">BITRUS</para>
  <para style="imt">Bǝ Gabnung</para>
  <para style="ip">
    <char style="bk">Nungvullǝ Nung Rabbu Bǝgǝ Bitrus</char> i vullǝ lǝn ya Kristǝ a vii kwɔ tthǝ. Lo baɓǝ ǝn bǝ taɓui i nungto ya nanatthǝ nung pǝllǝ i nungto aɓau kwɔ lǝbǝ nanatthǝ dǝna wɔlǝ ɓǝ. I tǝi bǝ gwabnwa ba kwɔ tthǝn dang bǝ dǝiu dang bǝ ibǝ nung a langǝ i gi Fuh langkwoi i a bǝ Dangbang Yeso Kristi, bǝ ibǝ nung ɓǝ kwɔ yayuu kwɔ ɓyǝa Yeso i nailǝ langkwoi lǝu u nainatthǝ nung ɓǝ. Ya vullǝ nung ɓǝ dǝ kiggǝu la langǝ i lo bǝ nanatthǝ nung yakwɔ gei angǝ Kristi kwoisuo akunu ɓǝ. U gei angǝ nung ɓǝkwɔ to bǝ kwoi gi Yeso la nikwɔ ǝn bakwɔ Fuh &lt;&lt;Yiɗi kwɔ yuu akun a ɓanglǝ ɓǝlǝu, kwoi dǝu yiɗi ko ǝnya ǝndǝi kwoi yitthǝ nung a ɓko gu.&gt;&gt;</para>
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />Ɓang Saminu Bitrus,ɓang ǝn vullǝ nungvullǝ kwɔ thǝb i ya nwatummi gi Yeso Kristi-</para>
  <para style="p" vid="2PE 1:1">Sua yakwɔ tthǝ bǝ to nung a langǝ i gi Fuh ɓi i ya sob lo Yeso Kristi kwɔ i ji bǝ dǝnyitthǝ lǝ nung a langǝ i manung aɓi ɓǝ:<verse eid="2PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2" />Kaso nung a langǝ i i tǝmmi ǝǝlǝ aɓǝ kpaatthǝ tthǝ bǝ ibǝ nung Fuh langkwoi i a bǝ Yeso Dangbang ɓi.<verse eid="2PE 1:2" /></para>
  <para style="s">Bǝ Lubǝi Gi Fuh Ibǝ Mko Bǝi Gu</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />Fuh i ttha gu dǝɓi nung ǝndǝi kwɔ ɓi yiɗi ɓi ǝǝ i bǝ wabnung a langǝ i bǝ nwongǝi tthǝ bǝ ibǝnung gi yuu akwɔ lubǝi ɓi tǝɓi gab ghaali gu i nung a langǝ i gu. <verse eid="2PE 1:3" /><verse number="4" style="v" sid="2PE 1:4" />Lo nunglǝi ɓǝlǝ u dǝɓi nung ghaatthǝ langkwoi matthǝ nungdǝ kwɔ u gwab ɓi nwuo ɓǝ, yangbǝ tthǝ nungdǝ kwɔ yangbǝ kaso a i dang nung a ɓko kwɔ dang longwam kwɔɓǝ, yang kaso wa gab nung a langǝ i a wayi. <verse eid="2PE 1:4" /><verse number="5" style="v" sid="2PE 1:5" />Lǝ ba baɓǝ kwɔ ɓa to nung a langǝ i tǝɓa kǝb lǝ nung a langǝ i i bǝ dǝba a langǝ i ɓǝ; tthǝ nung a langǝ i ɓa lilo i bǝ ibǝ nung; <verse eid="2PE 1:5" /><verse number="6" style="v" sid="2PE 1:6" />tthǝ bǝ ibǝ nung ɓa lilo ibǝ muolo; tthǝ bǝ muolo ɓǝ ɓa lilo ibǝ nyimnyi; tthǝ bǝ nyimnyi ɓa lilo i kiggǝ manung a bǝ Fuh; <verse eid="2PE 1:6" /><verse number="7" style="v" sid="2PE 1:7" />langkwoi tthǝ ba gi Fuh ɓa lilo i ba ɓǝ ǝn ya Kristǝ; langkwoi lǝ ɓǝ ǝn ya Kristǝ ɓa lilo i bǝ yiɗi tha. <verse eid="2PE 1:7" /><verse number="8" style="v" sid="2PE 1:8" />Ən i nungkwɔ dǝɓa yiɗi ɓǝ, langkwoi nǝɓa tǝi kpaatthǝng yang, i mǝrrǝm ɓǝ nyimtthǝ langkwoi kaitthǝ dang bǝ ibǝnung gi Dangbang Yeso Kristi ɓi. <verse eid="2PE 1:8" /><verse number="9" style="v" sid="2PE 1:9" />Kwoi nǝɓa tǝi lǝu yang, ɓǝ ǝnya nungɓuommi kwoi ɓa ɓyǝa ɓǝiu langkwoi nyi ɓǝ da tthǝ kwɔ i ɗiggǝ ɓǝ dang nung a ɓko ɓǝng ɓǝ.<verse eid="2PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10" />Ya youngǝm, yang lakwɔ, ɓa ɗuong nungɓǝ ɓa mǝrrǝm bǝ lubǝi gi Fuh i bǝ mko bǝi gu lǝ nung a nyimmi dang bǝ ibǝnung ɓǝ; nǝ ɓa to manungɓǝni, yang ɓa la bǝ dǝ ba a langǝ i ɓǝ tthǝ lǝu. <verse eid="2PE 1:10" /><verse number="11" style="v" sid="2PE 1:11" />Yang lakwɔ i dǝɓǝ nunglǝi la langǝ i kwɔ ɓa tǝ dang bǝ lo yigwoi gi Fuh a ɗing tthǝ Dangbang ɓi i ya nwong lo Yeso Kristi.<verse eid="2PE 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />Langkwoi lakwɔ vii ǝndǝi Mǝn dǝi nwa bǝ geiɓǝ bakwɔ tthǝ, Ko kwɔ ɓa osi ɓa ibǝi langkwoi ɓa nyim ɗing dang ba a langǝ i kwɔ ɓa muo ɓǝ. <verse eid="2PE 1:12" /><verse number="13" style="v" sid="2PE 1:13" />Dǝmǝn nhǝm maɗing kwɔ mǝn dǝilo bǝ gei ɓǝ batthǝ na tǝ dang lo ɓǝ nunglǝi a langǝ i bakwɔ nǝ yirrǝ ɓang tthǝ i nwongǝi ɓǝ. <verse eid="2PE 1:13" /><verse number="14" style="v" sid="2PE 1:14" />Ən ibǝi gbag bǝi kwɔ mǝn ilǝ sualtthǝ a ɓuiɓua kwɔ ɓǝ, manungkwɔ Dangbang ɓi Yeso Kristi geim tthǝ nung pangbǝi ɓǝ. <verse eid="2PE 1:14" /><verse number="15" style="v" sid="2PE 1:15" />Mǝnto nung i tthǝ nyimim, lakwɔ, mǝn ɗuu ɓǝ nunglǝi tthǝ yangbǝ ɓa nhǝm ba lona ǝndǝi nǝn ɓui ɓǝ.<verse eid="2PE 1:15" /></para>
  <para style="s">Yakwɔ Ɓyǝa Ghaali Gi Kristi I Nungɓǝ</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />Ɓi dǝilo mummoani kwɔ ɓa ab nǝkwam ɓi gei ɓǝtthǝ lǝ babǝ wuo gi Dangbang Yeso Kristi ɓi angǝ a ɓǝlǝu. Ɓi ɓyǝa ghaali gu i nungɓiing. <verse eid="2PE 1:16" /><verse number="17" style="v" sid="2PE 1:17" />Ɓi bǝilǝ kwɔ i duu angǝ a langkwoi i ghaali gi Fuh Daa, viikwɔ yol wuu ttha sua Ghaatthǝ na Fuh, dǝna gei angǝ, &lt;&lt;Yuu akwɔ ǝn Yuim, kwɔ dǝm yiɗi niɓǝ!&gt;&gt; <verse eid="2PE 1:17" /><verse number="18" style="v" sid="2PE 1:18" />Ɓi i naɓi ɓi lǝ yol kwɔ dǝna wɔ wayi ɓǝng, kwɔ ɓi i ulǝ lotal a langǝ i ɓǝ.<verse eid="2PE 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19" />Yang ɓi tthǝ i dǝnyi nyimtthǝ tthǝ bǝ gei nwaba bakwɔ ya gei ba a tthasi gei ɓǝ. Ɓa dǝi nyimtthǝ ɓa dǝ kiggǝ ɓǝtthǝ, bakwɔ mangǝttǝn ǝn fitilǝ dǝna gabbǝi dang bǝ baithǝl nǝ bǝikan langkwoi bǝi kai nungwoi vin kaitthǝ dang nyimǝ. <verse eid="2PE 1:19" /><verse number="20" style="v" sid="2PE 1:20" />Lo nunglǝ ǝndǝi, dang ǝulǝ, ɓa nhǝm yuu yangǝu dang ɓi a gei nwa ba a tthasi dang nungvullǝ bǝ gei bagi Fuh. <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" />Bakwɔ bǝ gei nwa ba a tthasi akun yangǝu kwɔ wuo manungkwɔni na thayuu, kwoi thayuu tthǝn dang na pangsua i Ɓyang a Langǝ i kwɔ dǝi gei nwa bakwɔ wuo bǝgǝ Fuh ɓǝ.<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s">Ya Nanatthǝnung pǝllǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />Ya pǝllǝ bǝ gei nwa ba a tthasi tthǝ viikwɔ tthasua ganglang yayuu, langkwoi manungɓǝni ya pǝllǝ bǝ nanatthǝ nung a ilǝ loi ganglang ɓǝ. I wuo wui ɓanglǝ nung, bǝ nanatthǝnung a ɓko, langkwoi i yǝrnwa tthǝ togwoi kwɔ sob loi ɓǝ, langkwoi yang i wullǝ nungkwɔ a ɓanglǝ loi ɓǝ. <verse eid="2PE 2:1" /><verse number="2" style="v" sid="2PE 2:2" />Manungkwɔni yang, yayuu kpaatthǝ ato kiggǝ lolǝi a ɓko; langkwoi lǝ ba nung kwɔ i to kwɔ, yakun a gei ba mullub lolǝi ba a langǝ i.<verse eid="2PE 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 2:3" />Dang bǝto ɗǝlak gi ya nanatthǝnung pǝllǝ a tǝi nung lǝ ba bǝ gei ba nwa- mummoani a nǝkwam. Lona kpaatthǝ lakwɔ ya gei kwan gi dǝna ki, langkwoi ya Ɓangǝ i lǝ ǝǝ nǝki dǝna kii!<verse eid="2PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4" />Fuh kang ya nwatummi kwɔ to nung a ɓko ɓǝlǝu, kwoi u toggǝi dang lua, bǝi kwɔ i tthǝbǝi i sarka bǝ baithǝl, dǝnni ki Vii bǝ to kwan.<verse eid="2PE 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2PE 2:5" />Fuh kang longwam a viikwɔ lǝu, kwoi u wuilǝ mungɓuommi lo longwam yakwɔ i Fuh lǝu ɓǝ; yakwɔ u nwongǝi kwɔ nungkwɔ lǝ Nuhu, yuu akwɔ gei ba a langǝ i ɓǝ, i yakun ni nanaira . <verse eid="2PE 2:5" /><verse number="6" style="v" sid="2PE 2:6" />Fuh ɓanglǝ gwoi angǝ a Sadoma i Gwamrata, u liǝ i lua, langkwoi u mǝrrǝm mǝi lǝ yakwɔ yangǝu i kiggǝ bǝ muosua Fuh ɓǝ. <verse eid="2PE 2:6" /><verse number="7" style="v" sid="2PE 2:7" />U sob Lutu, ba kwɔ u ǝn yuu a langǝ i ɓǝ, yuu akwɔ yidɗi kiggǝ nungto i bǝ la bǝ muo zuu gi Musa ɓǝ. <verse eid="2PE 2:7" /><verse number="8" style="v" sid="2PE 2:8" />Lutu ǝn yuu a langǝ i kwɔ lo ganglangǝ i ɓǝ, langkwoi vii ǝndǝi dǝnnu lǝ ba zii bǝi nǝ u ɓyǝa langkwoi u lǝ bǝ to nung to mullub gi ɓǝ. <verse eid="2PE 2:8" /><verse number="9" style="v" sid="2PE 2:9" />Langkwoi yang Dangbang ibǝ nunglǝi kwɔ a nwonglǝ yayuu gi Fuh dang bǝ nabǝi langkwoi nungkwɔ u tolǝ ya kiggǝ a ɓko bǝ gub ɗuogsui Vii bǝ gei kwan ɓǝng.<verse eid="2PE 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 2:10" />Manung gi ya kwɔ dǝna to nung a ɓko i tthǝilǝ langkwoi i tthǝm ttha gi Fuh ɓǝ.</para>
  <para style="p" vid="2PE 2:10">Ya pǝllǝ bǝ nanatthǝnung kwɔ dǝi lǝi lo angǝ a langkwoi i lǝ tthǝku, langkwoi i dǝ angǝ a lǝ yuu angǝ a kwɔ wayi ɓǝu; manungkwɔni yang, dǝi dalǝi. <verse eid="2PE 2:10" /><verse number="11" style="v" sid="2PE 2:11" />Ko ǝn ya nwatummi gi Fuh, ya kwɔ nyimtthǝ langkwoi ghaatthǝ pǝl ya pǝllǝ bǝ nanatthǝ nungkwɔ, i gei ba akun loi babǝ dal ɗyǝam lǝu ɗǝgsi Dangbang. <verse eid="2PE 2:11" /><verse number="12" style="v" sid="2PE 2:12" />Langkwoi yayuu kwɔ dǝna gei balo nungkwɔ i ibǝi lǝu ɓǝ, mangǝn nyam dang ug kwɔ i siu i muo i thǝb ɓǝ; i muo nung ǝndǝi kwɔ i ibǝi lǝu kwɔ i ɓanglǝ. I ɓangǝ i lǝ langɓǝ mangǝ ǝn nyam dang ug, <verse eid="2PE 2:12" /><verse number="13" style="v" sid="2PE 2:13" />langkwoi i kwai zuii i zuii kwɔ i wullǝ ɓǝ. Bǝ lǝ tthǝla gi nungkwɔ i tonungkwɔ dang fuh ghaatthǝ ɓǝ yangbǝ nungkwɔ tthǝi dǝna yiɗi ɓǝ; i ǝn nung to tthǝkku langkwoi i lǝ tthǝlko nǝ i tǝ dang ɓǝ bǝ tangnung ɓǝ, vii ǝndǝi dǝnni lǝ tthǝla bǝ ɗambǝi! <verse eid="2PE 2:13" /><verse number="14" style="v" sid="2PE 2:14" />Dǝnni ɗuu ǝn bǝ ɓyǝa nung akun lǝu kwoi ǝn nunglǝi bǝ lo i yasi yayuu; bǝto nung a ɓko logǝiu. Dǝi mǝrrǝm yakwɔ muantthǝ i li dang tarkǝu. Dangwai nainatthǝ bǝ to ɗǝlak. I dang bǝ to zuii gi Fuh! <verse eid="2PE 2:14" /><verse number="15" style="v" sid="2PE 2:15" />I la bǝ muo nunglǝi a kwɔ juantthǝ kwɔ yang kwoi i la lo lǝi gi lǝ; i muo lolǝi kwɔ Bal'amu yui Beyor muo tthǝɓǝ, yuu akwɔ yiɗi bǝ tǝi nungkurɓǝ yang to nung a ɓko ɓǝ, <verse eid="2PE 2:15" /><verse number="16" style="v" sid="2PE 2:16" />langkwoi i laggǝu lǝ ba nung a ɓko gu. Ɗǝrr gu gei ba i yol yuu langkwoi nan ya gei nwaba a tthasi bǝ to nung to.<verse eid="2PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17" />Yayuu kwɔ mangǝ ǝn bǝ nyinyak- kwɔ kwiɓǝ, mangǝttǝn ǝn tǝi kwɔ wa ɓuob lona bǝ namung ɓǝ; Fuh yiǝ tthǝ bǝi dang bǝthǝl a nyimmi. <verse eid="2PE 2:17" /><verse number="18" style="v" sid="2PE 2:18" />I lǝi lo angǝ a langkwoi i bǝ gei ba sullǝ, langkwoi i to nung to i tthǝi lǝ i bǝ lǝ tthǝ la longwam yangbǝ i muo yakwɔ baipi bǝ i dang yayuu kwɔ ǝǝ dang nung to a ɓko ɓǝ. <verse eid="2PE 2:18" /><verse number="19" style="v" sid="2PE 2:19" />I gwab bǝi nwa bǝ tǝi lo yang kwoi i nailǝ dang kiggǝ ɓanglǝ nung- bakwɔ ɓi ǝn thǝb gi nungkwɔ tang lo loɓi ɓǝ. <verse eid="2PE 2:19" /><verse number="20" style="v" sid="2PE 2:20" />Nǝ yayuu i dang bǝ tang ǝn gǝgam ya longwam tthǝ bǝ ibǝnung gi tthǝ Dangbang ɓi langkwoi ya sob lo Yeso Kristi, langkwoi yang i mui langkwoi bǝ muo bǝi kwɔ i mui lǝ ɓǝ, yayuu ɓǝ kwɔ a ǝǝ dang bǝ ǝǝ bǝ alo pǝl a bǝ baipiu.<verse eid="2PE 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2PE 2:21" />Kǝkrǝ lko maɗing tthǝi i ibǝ ba a langǝ i lǝu kwɔ i ibǝi yang i mǝrrǝm i yitthǝ ba a nyimmi kwɔ i ji ɓǝ. <verse eid="2PE 2:21" /><verse number="22" style="v" sid="2PE 2:22" />Nungkwɔ tǝi wolu mung kwɔ gei angǝ bǝ mǝrrǝm ba ǝn ba a langǝ i: &lt;&lt;Ɗua a kwoisuo ta lǝng nungkwɔ ɓyǝam ɓǝ&gt;&gt; langkwoi&lt;&lt;Thag a yisi kwɔ i mung kwɔ kwoi tǝ dang duɓuok.&gt;&gt;<verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s">Bǝ Gwabnwa Babǝ Wuo Gi Dangbang</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />Ya youngǝm kwɔ dǝm yiɗi niɓǝ, nungkwɔ lakwɔ lǝ nungvullǝm a nung rabbu kwɔ dǝm vullǝ ɓǝ tthǝɓǝ. Dang nungvullǝ lǝ ǝndǝi nǝ rabbu ǝn ɗuong nungǝm yangbǝ ǝn oɓǝ nyitthǝ ba a langǝ i lo i nungkwɔ. <verse eid="2PE 3:1" /><verse number="2" style="v" sid="2PE 3:2" />Dǝmǝn yiɗi ɓa nhǝm bakwɔ ya gei ba a tthasi a langǝ i gei lakuu ɓǝ, langkwoi i zuu kwɔ Dangbang langkwoi ya sob lo kwɔ ya nwatummi gi Yeso dǝɓǝ ɓǝ. <verse eid="2PE 3:2" /><verse number="3" style="v" sid="2PE 3:3" />La nwasiu ǝndǝi, ɓa ibǝi vii asua yakun a fug kwɔ nwongǝi gi ǝn bǝ lǝ tthǝla longwam ɓǝ. I ɗamɓǝ <verse eid="2PE 3:3" /><verse number="4" style="v" sid="2PE 3:4" />langkwoi i ɓibɓǝ angǝ, &lt;&lt;U gwab nwa angǝ dǝnni wuo, manungɓǝ lǝu? U pǝlla? Ya bǝba ɓi osi ɓui, kwoi nung ǝndǝi yirrǝ dǝi mangǝ ǝn akwɔ lanungsi kwɔ i mablǝ longwam ɓǝ!&gt;&gt; <verse eid="2PE 3:4" /><verse number="5" style="v" sid="2PE 3:5" />I la ba a langǝ i kwɔ tuung Fuh dǝ ba a nyimmi lolǝ ɓǝ, langkwoi u mab wayi i pangsua. I mab longwam dang mungki langkwoi i mungki, <verse eid="2PE 3:5" /><verse number="6" style="v" sid="2PE 3:6" />langkwoi i mung, mung ɓuommi, lonalǝ kullo i ɓanglǝ longwam aku. <verse eid="2PE 3:6" /><verse number="7" style="v" sid="2PE 3:7" />Kwoi wayi i pangsua akwɔ lakwɔ kwɔ i yiu lǝ ǝn ba bǝ dǝ bakwɔ Fuh dǝɓǝ, yangbǝ lua wɔ li. I yiǝ lǝ ǝn ba vii kwɔ wui gei kwan lǝ yayuu gi Fuh tthǝ yangbǝ Tǝilǝ dang luaɓǝ. <verse eid="2PE 3:7" /><verse number="8" style="v" sid="2PE 3:8" />Kwoi ya ǝnthǝm kwɔ dǝm yiɗi niɓǝ, bǝ nyiɓǝ da tthǝ nung kun thǝ, Nung akun yangǝu tthǝ Dangbang kwɔ ǝn a nǝkwam nung dang bokun i ttha thǝmsob ɓua nu; tthǝu lǝ nǝ rabbu ǝndǝi kun. <verse eid="2PE 3:8" /><verse number="9" style="v" sid="2PE 3:9" />Dangbang muan tthǝu bǝ to nung to kwɔ u gwab nwuo ɓǝlǝu, manungkwɔ yakun dǝna nhǝm ɓǝ. Manungɓǝni yang, dǝnnu tthǝbnyi tthǝɓǝ, bakwɔ u yiɗi bǝ ɓanglǝ yuu akun lǝu, langkwoi dǝnnu yiɗi ɓǝ ǝndǝi ɓa yitthǝ nung a ɓko.<verse eid="2PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10" />Langkwoi vii bǝ wuo gi Dangbang a ǝǝ mangǝ ǝn ya nung i. Viilǝ kullo wayi a la nǝkwam i buogbǝi ghaatthǝ, i li lowayi i ɓangǝu lǝ, langkwoi pangsua i nungkwɔ dang ǝu ǝndǝi a thǝm nǝkwam. <verse eid="2PE 3:10" /><verse number="11" style="v" sid="2PE 3:11" />Manungɓǝni nǝ nungkwɔ ǝndǝi i alǝi lǝtǝ, yang ɓǝ aɓǝ ɓǝ ǝn yayuu a nwutǝn? Nwongǝi ɓǝ a ǝǝ la langǝ i langkwoi ɓa dǝ loɓǝ lǝ Fuh, <verse eid="2PE 3:11" /><verse number="12" style="v" sid="2PE 3:12" />manungkwɔ dǝɓa ki vii gi Fuh langkwoi ɓato matthǝ vii ɓǝ wuo thǝm tthǝ- vii kwɔ wui li wayi langkwoi i ɓangǝu lǝ, langkwoi i nung dang wayi a nya dang lua. <verse eid="2PE 3:12" /><verse number="13" style="v" sid="2PE 3:13" />Kwoi ɓi ki nungkwɔ Fuh gwab ɓi nwuo ɓǝ: wayi afu i pangsua afu, bǝikwɔ nung a langǝ i wa ǝǝtthǝ ɓǝ. <verse eid="2PE 3:13" /><verse number="14" style="v" sid="2PE 3:14" />Ya ǝnthǝm kwɔ dǝm yiɗi niɓǝ, langkwoi yang, nǝ dǝɓa ki Vii ɓǝ kullo, ɓato nung a langǝ i ɓa to lonyi a langǝ i langkwoi bǝɓa to nung a ɓko ɗǝgsi Fuh thǝ langkwoi ɓa ǝǝ matthǝ i ulǝ. <verse eid="2PE 3:14" /><verse number="15" style="v" sid="2PE 3:15" />Ɓa dǝ dang nyiɓǝ bǝ tthǝb nyitthǝ gi Dangbang ɓi ǝn bǝ sob lo ɓǝ, manungkwɔ young ɓi Bulus kwɔ dǝɓi yiɗi niɓǝ vullǝ ɓǝ tthǝ ɓǝ, u to nung to i yiggǝi kwɔ Fuh duu ɓǝ. <verse eid="2PE 3:15" /><verse number="16" style="v" sid="2PE 3:16" />Ən nungkwɔlǝ nungkwɔ u gei dang nungvullǝ bagu kwɔ u vullǝ kwɔ u vullǝ lo ba gu ɓǝ. Nung a zizi tthǝ dang nungvullǝ bagi fuh kwɔ ya kwɔ ibǝnung lǝu langkwoi yakun kwɔ ibǝ bǝ dǝba a langǝ i lǝu dǝna mǝrrǝm ba ɓǝ lo pǝllǝ, manungkwɔ i to i nungvullǝ yakun dang ba gi Fuh ɓǝ. Manungɓǝni i wullǝ bǝ ɓanglǝ nung gi. <verse eid="2PE 3:16" /><verse number="17" style="v" sid="2PE 3:17" />Ya ǝnthǝm kwɔ dǝm yiɗi niɓǝ, kwoi ɓǝ, ɓa osi ɓa ibǝing. Ɓa ǝǝ nǝ ɓa ki loɓǝ, yangbǝ bǝ ya to nung a ɓko i yakwɔ i zuu lǝu lǝi kiggǝ ɓǝ yang ɓa o lolǝi kwɔ ɓa nwong tthǝ ɓǝ. <verse eid="2PE 3:17" /><verse number="18" style="v" sid="2PE 3:18" />Langkwoi ɓa dǝi lo bǝ ghako dang bǝ to nung a langǝ i i bǝ ibǝ nung gi Dangbang ɓi langkwoi ya Sob lo Yeso Kristi. Bǝ tǝi Ghaali ǝǝ i u lǝ, lakwɔ i laɗing langkwoi laɗing! Dǝitthǝ manungɓǝ.<verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>