<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">1BITRUS- MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">1 Bitrus</para>
  <para style="toc1">Nungvullǝ A Kun Bǝgǝ BITRUS</para>
  <para style="toc2">1 Bitrus</para>
  <para style="toc3">1 B</para>
  <para style="mt2">Nungvullǝ A Kun Bǝgǝ</para>
  <para style="mt1">BITRUS</para>
  <para style="imt">Bǝ Gabnung</para>
  <para style="ip">
    <char style="bk">Nungvullǝ A Kun Bǝgǝ Bitrus</char> i vullǝ lǝ ǝn ba ya Kristǝ, bǝikwɔ dǝnni lu angǝ&lt;&lt;Yayuu Fuh kwɔ i mko ɓǝ,&gt;&gt; kwɔ i yǝbtha lǝilǝ gwɔtal Asiya atuab. Nungvullǝ kwɔ ǝn ba yangbǝ dǝtthǝ nyimmi lǝ ya thannu, yakwɔ dǝnni ɗab luai langkwoi i zuii lǝba bǝ dǝnyitthǝ Fuh gi. Ya vullǝ nung ɓǝ to nungkwɔ ibǝ o nyitthǝ lǝ ya than nung gu lǝ ba Nwaba A Langǝ i lǝba Yeso Kristi, kwɔ ɓua gu, ibǝ ǝrrǝu, langkwoi bǝ gwabnwa bǝ kwoi gu ji bǝ dǝnyitthǝ. Dang nungkwɔ lǝkwɔ i gwab i lǝi i tthǝlǝ zuii gi, ibǝ gwabbu angǝ ǝn bǝ nabǝ bǝ dǝnyitthǝ lalangǝ i langkwoi angǝ i tǝi nung busoni gi &lt;&lt;viikwɔ Yeso Kristi a fuktthǝ ɓǝ.&gt;&gt;</para>
  <para style="ip">Ibǝ dǝtthǝ nyimmi gu dang lona zuii, ya vullǝ nungɓǝ gei ya than nung gu angǝ i ǝǝ mangǝn yayuu kwɔ ǝn a bǝ Kristi ɓǝ.</para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />Ɓang Bitrus, ya nwatummi gi Yeso Kristi</para>
  <para style="p" vid="1PE 1:1">Vullǝ nungvullǝ kwɔ sua yayuu gi Fuh kwɔ u mko ɓǝ, yayol dang longwam, yakwɔ ɓui yǝbǝi lǝtha itǝ losua Fantas, i Galatiya, i Kafadokiya, i Asiya, i Bitiniya ɓǝ. <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />Fuh Daa ɓi mko ɓǝ i bǝ yiɗi gu langkwoi u mab ɓǝlǝ yayuu gu matthǝ la langǝ i Ɓyang gu, ɓa to nungto i bagi Yeso Kristi yang ɗiggǝ ɓǝ i zii gu lǝ.</para>
  <para style="p" vid="1PE 1:2">Kaso nung a langǝ i i bǝ ǝǝ a langǝ i ǝǝ i ɓǝlǝ ghaatthǝ.<verse eid="1PE 1:2" /></para>
  <para style="s">Bǝ Dǝnyitthǝ Angã</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />Ɓito sakko lǝ Fuh gi langkwoi Daa gi Dangbang Yeso Kristi ɓi! Lǝ ba gong bǝ ɓyǝa nungzuii gu kwɔ u dǝɓi nwongǝi afu bǝ ǝrrlǝ Yeso bǝ ɓui ɓua ɓǝ. Ən bǝi ɓǝ ɓi dǝnyitthǝ angǝ a, <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />nungkwɔ yang dǝɓi dǝnung tthasi ɓi muo nungtǝi khana lo kwɔ Fuh dǝ lǝ yayuu gu tthǝ ɓǝ. U dǝ ɓǝ tthǝ wayi, bǝi kwɔ nung zu tthǝu kwoi ɓanglǝu kwoi varrǝu. <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />I bǝ khana lo ɓǝkwɔ ǝn aɓǝ, kwɔ dang bǝ dǝ ba a langǝ i tthǝ Fuh mabbǝi dǝ matthǝ dang tthko gu lǝ ba bǝ sob lo kwɔ i mab dǝ dǝna ki yang i gei ɓǝ bko tthǝ nungwambǝi lona a tthasua.<verse eid="1PE 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6" />Ɓa lǝtthǝla lǝ ba nungkwɔ, lko yakun lakwɔ a ǝǝ ɓǝtthǝ manungɓǝ lko ɓa ɓanglǝ dang wa lǝ zuii bǝ nabǝi kwɔ ɓa tǝi kpaatthǝ ɓǝ. <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />Bagi yangbǝ i ibǝi bǝ dǝnyitthǝ ɓǝ ǝn a langǝ i. Ko ǝn zinariya kwɔ a ɓanglǝ kwɔ, i nko i lua; langkwoi yang manungɓǝ i bǝ dǝnyitthǝ nung, kwɔ mapǝl zinariya ɓǝ, langɓǝ i nko ǝn na, yangbǝ u nyimnyi u dǝi. Nungkwɔ yang ɓa muo bǝ khabǝi i bǝ dǝ angǝ a vii kwɔ i ilǝ Yeso kristi nung pangbǝi ɓǝ. <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />Dǝɓa yiɗi gu ko kwɔ ɓa ɓyǝko lǝuɓǝ, ɓa dǝ ba a langǝ i tthǝu ko lakwɔ ɓa ɓyǝko lǝuɓǝ. Yang ɓa lǝtthǝla i gong bǝ dǝ angǝ a tthǝla kwɔ i gei bko ɓǝ,<verse eid="1PE 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 1:9" />Bakwɔ ɓa muo sob lo lǝ ba killǝng ɓǝ, nungkwɔ lǝ ba bǝ dǝnyitthǝ a langǝ i tthǝu lǝ.<verse eid="1PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />Ən babǝ sob lo nungkwɔ ya gei ba a tthasi dǝ kiggǝi bǝ ɓyǝa i bǝ ɗuu nunglǝi, langkwoi i gei ba a tthasi lǝ ba bǝ dǝnung kwɔ Fuh a dǝ ɓǝ. <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />I to nunglǝi kwɔ yangbǝ i ɗuu bǝ lona kwɔ ato langkwoi kwɔ a wɔ ɓǝ. Ən nungkwɔ lǝ lona kwɔ Ɓyang Kristi tthǝilǝ dǝna tanatthǝ ɓǝ, kwɔ i gei ba lo zui kwɔ Kristi wa lǝi i dang nyi langkwoi ghaali kwɔ a muo suo ɓǝ.<verse eid="1PE 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 1:12" />Fuh ilǝ ya gei ba a tthasi nungpang bǝi angǝ nung to gi ǝn nung lǝ tthǝ la gilǝu, kwoi ǝn aɓǝ, kwɔ i gei ba ba nung akwɔ kwɔ ya nwatummi kwɔ gei ba lo nungkwɔ lakwɔ ɓa lǝ na ya nwatummi ɓǝ yuu akwɔ gei nwaba afu i ttha Ɓyang a Langǝ i kwɔ i tog wayi ɓǝ. Nungkwɔlǝ nungkwɔ nung to kwɔ ya nwatummi gi Fuh dǝna yiɗi bǝ ibǝi ɓǝ.<verse eid="1PE 1:12" /></para>
  <para style="s">Bǝ Lubǝi Lǝba Bǝ Əǝ A Langǝ i</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />Yang kwɔ lakwɔ, dang wa ɓǝ dǝna yiɗi bǝ to nung to. Ɓa ǝǝ matthǝ ɓa dǝnyitthǝ ɓǝ ǝndǝi tthǝ bǝ khana lo kwɔ a dǝ ɓǝ kwɔ i ilǝ ba gi Yeso Kristi nungpangbǝi. <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />Ɓadǝ loɓǝ lǝ Fuh, yang bǝ ɓa gwab nwongǝi ɓǝlǝ tthǝku thǝ yakwɔ dǝna yiɗi ɓǝ viikwɔ ɓa ibǝ nung akun lǝu ɓǝ.<verse eid="1PE 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1PE 1:15" />Manungkwɔni yang, ɓa ǝǝlǝ a langǝ i lo nungkwɔ dǝɓa toɓǝ, manungkwɔ Fuh kwɔ lubǝi ɓǝ kwɔ u ǝn ya langǝ i. <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />Bagi Fuh gei angǝ, &lt;&lt;Ɓa ǝǝ la langǝ i bakwɔ ɓang ǝn ya langǝ i ɓǝ.<verse eid="1PE 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17" />Dǝɓa lubǝiu ɓangǝ Daa, nǝ dǝ ɓa pinwa tthǝ Fuh, kwɔ dǝna to kwan lǝ yayuu tthǝ ǝndǝi nunglǝi lǝ ǝndǝi, manungkwɔ ko ǝn ya ǝndǝi to; yang lakwɔ, ɓa dǝsua nwongǝi ɓǝ ǝndǝi longwam lǝba gu. <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />Ɓa ibǝ nungkwɔ i kwai nwuni bǝ i iɓǝlǝ dang nwongǝi nung a ɓko gi ya bǝba ɓǝkwɔ yiɓǝ tthǝ ɓǝng. Ən nugkwɔ a ɓanglǝ, mangǝ ǝn azurfa i zinariya lǝu;<verse eid="1PE 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 1:19" />ǝn bǝ nyǝknung a ɓuonni kwɔ ito i Kristi ɓǝ, yuu akwɔ mangǝttǝn ǝn yui ɓangam a langǝ i kwɔ gillǝng nunglua ko nung zii yangǝu tthǝu lǝ ɓǝ. <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />Ən Fuh mko nwuni bǝ i mab longwam langkwoi nwuni tanatthǝu lona a tthasua kwɔ lǝ baɓǝ.<verse eid="1PE 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1PE 1:21" />Tthǝn tthǝu ɓa dǝ ba dǝnyitthǝ Fuh, yuu akwɔ ǝrrǝu lǝ bǝ ɓui ɓua langkwoi du angǝ a ɓǝ; langkwoi yang bǝ dǝba a langǝ i ɓǝ i bǝ dǝba a langǝ i ɓǝ dǝilo Fuh<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />Kwɔ lakwɔ ɓǝ ǝn ya gwab ba a langǝ i ɓa ɗiggǝ lo nyi ɓǝng langkwoi ɓa wɔ yangbǝ to ba yakwɔ dǝ ba a langǝ i tthǝ ɓǝ, ɓa yiɗi bǝ yiɗi tha a langǝ i lo nyi kun. <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />Tthǝn bǝ ǝǝ i nwongǝi langkwoi i ba gi Fuh a ɗing nungkwɔ i siɓǝ langkwoi akun lǝ yathang gi ya bǝ pi kwɔ ǝn ya to nung a ɓko lǝu, ǝn yakwɔ dǝna to nung a langǝ i ɓǝ. <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />Manungkwɔ nungvullǝ bagi Fuh gei kwɔ angǝ,</para>
  <para style="q1" vid="1PE 1:24">&lt;&lt;Thayuu ǝndǝi natha i gug,</para>
  <para style="q2" vid="1PE 1:24">Langkwoi ghaali gi ǝndǝi mangǝ ǝn vin gug dang ka.</para>
  <para style="q1" vid="1PE 1:24">Gug ɓǝ a kwi, langkwoi vin ɓǝ alǝtǝ,<verse eid="1PE 1:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="1PE 1:25" />kwoi ba gi Dangbang dǝing laɗing.&gt;&gt;</para>
  <para style="m" vid="1PE 1:25">Bakwɔ ǝn nwaba a langǝ i kwɔ i geiɓǝ tthǝ ɓǝ.<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s">Tal Nwongǝi I Yayuu Fuh</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />Manungkwɔ ni yang, ɓa to kiggǝ ɓǝ, tthǝ bǝto mungkullum; bǝ kǝb pǝllǝ yangǝu ko bǝto lo angǝ a i bǝto dasi ko bǝ dal tha. <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />Ɓa mǝrrǝm mangǝn yathang a ɓuoi, vii ǝndǝi dǝɓa lǝ ɗimung mungmi a langǝ i kwɔ ɓanglǝ lǝu ɓǝ, yangbǝ nǝ dǝɓa ɔng yang ɓa ghaa langkwoi ɓa sob lo. <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />Manungkwɔ nungvullǝ bagi Fuh gei kwɔ,&lt;&lt;Lakwɔ ɓa ibǝi mali gi Dangbang ǝng.&gt;&gt;<verse eid="1PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4" />Ɓa wɔ sua Dangbang, kwɔ mangǝn tal nwongǝi kwɔ yayuu la angǝ mko kwɔ kwoi Fuh mko lǝ tal a langǝ i. <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />Ɓa wɔ mangǝttǝn ɓǝ ǝn tal nwongǝi, langkwoi ɓa yitthǝ i mai ɓǝlǝ ɓyang kǝm nyǝknung, tal a langǝ i kwɔ i mai lǝ kǝm nyǝknung tthǝ Fuh, bǝi kwɔ ɓa nwong mangǝn ya nyǝknung a langǝ i kwɔ Fuh muo tthǝ Yeso Kristi. <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />Nungvullǝ bagi Fuh gei angǝ,</para>
  <para style="q1" vid="1PE 2:6">&lt;&lt;Ən mko tal a langǝ i,</para>
  <para style="q2" vid="1PE 2:6">kwɔ Dǝmǝn dǝ mangǝ ǝn tal tthǝlak kǝm dang Sihiyona;</para>
  <para style="q2" vid="1PE 2:6">Langkwoi yuu akwɔ ǝndǝi dǝ ba a langǝ i tthǝu yang lǝ tthǝ kuu<verse eid="1PE 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="1PE 2:7" />Tal kwɔ nungkurɓǝu ghaa ɗing tthǝ ɓǝ yakwɔ ɓa dǝ ba a langǝ i tthǝ ɓǝ; kwoi lǝ ba a bǝ yakwɔ dǝ ba a langǝ itthǝ lǝu kwɔ:</para>
  <para style="q1" vid="1PE 2:7">&lt;&lt;Tal kwɔ ya mainung la angǝ ǝn nung a nǝkwam kwɔ</para>
  <para style="q2" vid="1PE 2:7">mǝrrǝm lǝ tal a langǝ i ǝndǝi dang tal lǝ.&gt;&gt;<verse eid="1PE 2:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8" />Langkwoi ba gi Fuh akun gei angǝ,</para>
  <para style="q1" vid="1PE 2:8">&lt;&lt;Ən tal ɓǝkwɔ a to yayuu a ɓuob boi tthǝ,</para>
  <para style="q2" vid="1PE 2:8">ɓǝmtal kwɔ a toi i owh ɓǝ.&gt;&gt;</para>
  <para style="m" vid="1PE 2:8">I ɓuob boi tthǝ bakwɔ i dǝ ba a langǝ i tthǝ balǝ lǝu; nungkwɔ ǝn nung kwɔ Fuh gwabǝitthǝ i toɓǝ.<verse eid="1PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />Kwoi ɓǝ ǝn yayuu kwɔ Fuh mko ɓǝ, ya nyǝknung gwoi Fuh kwɔlǝ yigwoi ɓǝ, gwoi angǝ a a langǝ i, yayuu gi Fuh, i mko ɓǝ yangbǝ tǝɓa to nung to a nyimmi gi Fuh, yuu akwɔ iɓǝlǝ dang thǝl wullǝ dang lua gabbǝi angǝ a ɓǝ. <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />Viikwɔ ɓǝ ǝn yayuu gi Fuh lǝu, kwoi lakwɔ ɓǝ ǝn yayuu gu; lona a kullo ɓa tǝi bǝ ɓyǝa nungzuii gi Fuh lǝu, kwoi lakwɔ ɓa tǝi bǝ ɓyǝa nungzuii gu.<verse eid="1PE 2:10" /></para>
  <para style="s">Ya Thǝb Gi Fuh</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />Ya ǝnthǝm kwɔ dǝm yiɗi niɓǝ, dǝmǝn gei ɓǝ bakwɔ tthǝ, mangǝ ɓǝ ǝn yayol i ya sur ɓui dang longwam kwɔ! Bǝ ɓa ǝǝ dang bǝ yiɗi nungkwɔ tthǝ dǝna yiɗi ɓǝthǝ, kwɔ vii ǝndǝi dǝna taɓui i killǝng ɓi ɓǝthǝ. <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />Ɓa to kiggǝ matthǝ dang yayuu kwɔ i Fuh lǝu ɓǝ yangbǝ kwɔ nǝ i muoɓǝ i nung aɓau ɓǝ, yang i ibǝ nungto ɓǝ a langǝ i yang lakwɔ i dǝ angǝ a lǝ Fuh Vii bǝ wuo gu.<verse eid="1PE 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />Lǝba Dangbang ɓa dǝ lo ɓǝlǝ yakku yayuu: Gong Yigwoi, kwɔ lǝya loyigwoi angǝ a ɓǝ,<verse eid="1PE 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1PE 2:14" />langkwoi lǝ ya gwamna, yuu akwɔ i du nung to ɗablua ya to nung to mungkullum langkwoi u kha yakwɔ to nung a langǝ i ɓǝ. <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />Bakwɔ Fuh dǝna yiɗi ɓa lam nwa yakwɔ ibǝ nunglǝu kwɔ kǝr nwa nǝkwam lǝba to nung a langǝ i kwɔ dǝɓa toɓǝ. <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />Ɓa ǝǝ mangǝn yakwɔ tǝi loi ɓǝ; bǝɓa to nung to bǝ tǝi lo ɓǝ ɓa lamlǝ mullub ɓǝthǝ, kwoi ɓa ǝǝ mangǝn ya thǝb gi Fuh. <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />Ɓa dǝ angǝ a lǝ yayuu ǝndǝi, ɓa yiɗi ya young ɓi ya dǝba a langǝ i, ɓa sur Fuh, ɓa dǝ angǝ a lǝ ya Gong Yigwoi.<verse eid="1PE 2:17" /></para>
  <para style="s">Bǝ Tozuii Gi Kristi</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />Ɓǝ ya thǝb ɓa dǝlo ɓǝ lǝ ya togwoi ɓǝ langkwoi ɓa ji angǝ a, tthǝ yakwɔ dǝna to kiggǝ a langǝ i ɓuoɓǝ lǝu, kwoi langɓǝ i yakwɔ dǝna toɓǝ kiggǝ aɓau ɓǝ. <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />Fuh a khana loɓǝ lǝ ba nungkwɔ, nǝɓa lǝi i nyi ɓa tozuii kwɔ ǝn aɓǝ lǝu bakwɔ dǝɓa yiɗi bagu ɓǝ. <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />Ən ɓǝttǝn lǝ nungbusɔni ɓǝ nǝɓa nyimnyi bǝ ɓuob bǝi bakwɔ ɓato nung a ɓko ɓa? I ɓuob ɓǝ lonungkwɔ ǝn ɓǝ ɓa tolǝu? Kwoi nǝɓa nyimnyi lo zuii ko kwɔ nǝɓa to nung a langǝ i, Fuh a khana loɓǝ lǝ bko. <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />Lǝ ǝn u baɓǝ kwɔ nungkwɔ Fuh lubǝi ɓǝ, bakwɔ Kristi lo i nkolǝ tozuii lǝ baɓǝ nungkwɔ u yiɓǝ nung natthǝ, yangbǝ ɓa muo finnu. <verse eid="1PE 2:21" /><verse number="22" style="v" sid="1PE 2:22" />U to nung a ɓko lǝu, langkwoi yuu akun yangǝu lǝ pǝllǝ nwuo lǝu. <verse eid="1PE 2:22" /><verse number="23" style="v" sid="1PE 2:23" />Kwɔ i dalu, u vullǝi tthǝ i ɗyǝam lǝu; kwɔ u tozuii, u ǝrlǝ kiggǝ lǝu, kwoi u dǝ nyiutthǝ Fuh, ya to kwan a langǝ i.<verse eid="1PE 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1PE 2:24" />Kristi i nko lǝ lǝi nung a ɓko ɓi tthǝu lǝ tǝlǝ lo kab gangǝ i, yangbǝ ɓi la nung a ɓko langkwoi ɓi ǝǝ i nwongǝi tthǝ nung a langǝ i. Ən ba lua kwɔ i du kwɔ nungkwɔ ɓi tǝi tthǝ la. <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />Ɓǝ vii kwɔ mangǝn ɓangam kwɔ laɓǝ, kwoi lakwɔ i kwoi ɓǝlǝ yangbǝ ɓa muo sua ya gagci nungbyang langkwoi ya kang killǝng ɓǝ.<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">Yasi I Yaɓǝi</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />Manungɓǝ ni ɓǝ yasi dǝbgwoi ɓa dǝ loɓǝ lǝ yaɓǝi ɓǝ, yang nǝ yakun tthǝ dang ǝi lǝ nǝ dǝ ba a langǝ i tthǝ Fuh lǝu yang, kiggǝ ɓǝ a wuilǝ wui dǝba a langǝ itthǝ ba Fuh. Ko nǝɓa gei ba lǝu ɓǝ, <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />bakwɔ nǝ i ɓyǝa mali kiggǝ ɓǝ i nung to ɓǝ a langǝ i ɓǝ. <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" />Bǝ nung ɓǝ a langǝ i ttha gwam ɓuo thǝ, manungkwɔ ɓa mab byang loɓǝ ɓǝ, ko i nung li dul zinariya kwɔ ɓa liɓǝ ko nunglitthǝ. <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />Manungkwɔni yang, mali ɓǝ a ǝǝlǝ ba langǝ i dang wa ɓǝ, mali kwɔ varrǝu langkwoi latthǝ lang tǝm tthǝ dang ɓyang a langǝ iu, nungɓǝlǝ nungkwɔ ghaatthǝ ɗǝgsi Fuh lǝ. <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />Bakwɔ yasi a langǝ i yakwɔ osi pa kwɔ dǝ dǝnyitthǝ Fuh gi i to loi matthǝ langkwoi i dǝloi lǝ yaɓǝi gi. <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />Manungɓǝni i Saratu; dǝnnu lǝ ba gi Ibrahim langkwoi dǝnnu luu ɗuǝnu angǝ Dangbangǝm. Lakwɔ ɓǝ ǝn yathang gu a yisi nǝ dǝɓa to nung a langǝ i langkwoi ɓa sur vulli lǝu ɓǝ.<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />Manungɓǝni langɓǝ ɓǝ yaɓǝi ɓa ǝǝ i yasi ɓǝ lo nunglǝi a langǝ i ɓa ibǝi i nyim mangǝn yaɓǝi lǝu. Ɓa toi nungtthǝ i bǝ ji ghaali, bakwɔ i langɓǝ i muo nungdǝ nwongǝi, gi Fuh i ɓǝlǝ. Ba to nungkwɔ yangbǝ bǝ nung akun ka bǝ pinwa ɓǝthǝ.<verse eid="1PE 3:7" /></para>
  <para style="s">Bǝ To Zuii Lǝba Tonung A Langǝ i</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />Bǝ alo: ɓǝ ǝndǝi ɓa ǝǝ i kiggǝ kun; ɓa yiɗi tha, langkwoi ɓa tǝmnyi ibǝ ɓuob lo sua lǝtha. <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />Bǝ ɓa kwai mullub i mullub thǝ ko ɗyǝam i ɗyǝam; manung kwɔni yang, ɓa kwai i bǝ khana lo, bakwɔ i bǝ khana lo Fuh gwabnwa angǝ i dǝɓǝ nǝ i lu bǝi ɓi ɓǝ.<verse eid="1PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 3:10" />Manungkwɔ ba gi Fuh gei angǝ,</para>
  <para style="q1" vid="1PE 3:10">&lt;&lt;Nǝ dǝɓa yiɗi bǝ lǝ tthǝla nwongǝi</para>
  <para style="q2" vid="1PE 3:10">langkwoi dǝɓa yiɗi bǝ lǝ tthǝla,</para>
  <para style="q2" vid="1PE 3:10">ɓa yitthǝ bǝ kǝbpǝllǝ.<verse eid="1PE 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11" />A yitthǝ bǝ to mullub ɓa to nung a langǝ i;</para>
  <para style="p" vid="1PE 3:11">a ɗuong nungmǝ bǝ ǝǝ latthǝ i dang wa mǝ ǝndǝi.<verse eid="1PE 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12" />Bakwɔ nung Dangbang dǝna ɓyǝa ya to nung a langǝ i</para>
  <para style="q2" vid="1PE 3:12">langkwoi dǝna lǝ bǝ pinwa gi;</para>
  <para style="q2" vid="1PE 3:12">langkwoi dǝnnu la yakwɔ dǝna to mullub ɓǝ.&gt;&gt;<verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />Ən yittǝn a da lua nǝ dǝmma dǝ tthǝmǝ bǝ to nungkwɔ ǝn a langǝ i ɓa? <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />Kwoi nǝ ma tozuii lo ba nung to a langǝ i, a lǝ tthǝla! Bǝ a lǝ tthǝ vulli yuu akun thǝ, langkwoi bǝ a nhǝm ba thǝ. <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />Kwoi ɓa sur Kristi lo nyiɓǝ, ɓa dǝ ghaali lǝ Dangbang. Lona ǝndǝi a ǝǝnwa bǝ gwabnwa lǝ yuu akwɔ ǝndǝi ɓibɓǝ angǝ ɓa gei nungkwɔ ɓa dǝnyitthǝ ɓǝ, <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />kwoi ɓa to i kiggǝ ibǝ ji angǝ a. A dǝ lonyimǝ kaitthǝ, yangbǝ nǝ i ɓanglǝ ɗuǝnmǝ, yakwɔ dǝna gei ba a ɓko lo kiggǝ mǝ a langǝ i lǝ kiggǝ ya muo sua Kristi kwɔ ilǝ tthǝkku nungkwɔ i geiɓǝ. <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />Maɗing kwɔ ma tozuii lǝ babǝ to nung a langǝ i ɓǝ, nǝ nungkwɔ ǝn nungɓǝkwɔ Fuh dǝna yiɗi ɓǝ, kwɔ ma to mullub ɓǝ. <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />Bakwɔ Kristi ɓui lǝ ba nung a ɓko ɓi bokun ɓuo, yuu a langǝ i lo ya to nung a ɓko, yangbǝ u tǝɓǝlǝ sua Fuh. I thǝbbu, kwoi Fuh ǝrrǝu lǝ i nwongǝi i Ɓyang gu, <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />kwɔ u dang ɓyang kwɔ u tǝ tǝu gei ba gi Fuh lǝ i ɓyang kwɔ dang pursǝna ɓǝ.<verse eid="1PE 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1PE 3:20" />I ɓyang kwɔ ǝn ɓyang yakwɔ dǝba a langǝ i tthǝ Fuh lǝu kwɔ u kiǝ i bǝ tthǝb nyitthǝ viikwɔ Nuhu dǝna mab kwai ɓǝ. Yayuu tuab dang kwai- ǝngunai ǝndǝi- i nwongǝi tthǝ munglǝ, <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />mung ɓǝ kwɔ ǝǝ mangǝ ǝn bǝ wollmung ɗiggǝ nung a ɓko, nungkwɔ lakwɔ nwongɓǝ ɓǝ. Ən ba bǝ ɗiggǝ ɓiling a tthǝ lǝu, kwoi ǝn ba bǝ gwab nwa kwɔ ɓi gwab lǝ Fuh i lowa a langǝ i ɓǝ. A nwong ɓǝ tthǝ bǝ ǝrr gi Yeso Kristi i bǝ ɓui ɓua i nwongǝi, <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />yuu akwɔ tǝ wayi u ǝǝ lona a nali gi Fuh, dǝu lo yigwoi lo ya nwatummi gi Fuh i ya ttha ya wayi i ttha gi.<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s">Nwongǝi Afu</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />Kwɔ nǝ Kristi tozuii i tthǝu lǝ, ɓǝma ɓa lǝi langɓǝ ɓa tozuii manung gu; bakwɔ nǝ yuukwɔ nǝ tozuii i tthǝulǝ yang u yangǝu dang ya nung a ɓko.<verse eid="1PE 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1PE 4:2" />Baipiu lakwɔ, nungkwɔ, sua nwongǝi ɓǝ longwam ǝn Fuh a o ɓǝlǝ si bǝ yiɗi gu ǝn nungkwɔ thayuu dǝna yiɗi ɓǝ lǝu. <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />Ɓa ɓanglǝ lona ɓǝ kpaaɗing tthasua dǝɓa to nung kwɔ yakwɔ i Fuh lǝu dǝna yiɗi bǝ tou ɓǝ. Ɓa ɓanglǝ nwongǝi ɓǝ dang nung a ɓko, bǝ yiɗi nung a nǝkwam, i wa fǝri, i bǝ to nung a ɓko, i bǝ tǝ ɓang bǝ nwa nung a nǝkwam, i bǝ wabnung a longwam.<verse eid="1PE 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 4:4" />Langkwoi lakwɔ yakwɔ i Fuh lǝu kwɔ dǝna nhǝm ba loɓǝ kwɔ lakwɔ ɓa tǝ suai bǝ to nung a ɓko kwɔ viikwɔ dǝɓa ǝǝ dang ǝu lǝu ɓǝ, langkwoi nungkwɔ lakwɔ dǝnni dalɓǝ. <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />Kwoi i gei nungkwɔ i to i nailǝ kwɔ lǝ Fuh tthǝ, kwɔ ato kwan lǝ ya nwongǝi tthǝ i ya ɓuiɓua.<verse eid="1PE 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 4:6" />Ən nungɓǝ kwɔ to dǝnni gei nwaba a langǝ i lǝ ya ɓuiɓua tthǝ langɓǝ ɓǝ, i yakwɔ i toi kwan tthǝ kwɔɓǝ manung kwɔ i to kwan lǝ koya tthǝ ǝndǝi ɓǝ; i gei ba gi Fuh ɓǝtthǝ yangbǝ dang ɓyang gi i ǝǝ i nwongǝi manung kwɔ Fuh ɓǝ .<verse eid="1PE 4:6" /></para>
  <para style="s">Ya To nung to Matthǝ I Nungdǝ Gi Fuh</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />Bǝ thǝm gi nung ǝndǝi gɓag bǝing. Ɓa muo- loɓǝ langkwoi ɓa ǝǝ i kiggǝ, yangbǝ ɓa tǝi ɓa pinwa.<verse eid="1PE 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 4:8" />Lonung lǝ ǝndǝi, ɓa yiɗi tha lonyi kun, bakwɔ bǝ yiɗi bǝi lamlo nung a ɓko kpaaɗing.<verse eid="1PE 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 4:9" />Ɓa ɓko gwoi ɓǝlǝ thatthǝ bǝɓa gei ba thǝ. <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />Ko ǝn ya, to nung to i nungdǝ kwɔ muo na Fuh ɓǝ, u tolǝ nung to lǝ yakun tthǝ, to nung to i nung a langǝ i gi Fuh kwɔ nunglǝi kwɔ Fuh da ɓǝ. <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />Yakwɔ dǝna gei ba Fuh yang gei nwaba gi Fuh ɓǝ; yakwɔ dǝna to nung to yang to nung to i ttha kwɔ Fuh ji ɓǝ, yangbǝ dang nung ǝndǝi a kha Fuh tthǝ Yeso Kristi, tthǝulǝ ghaali ttha dǝi laɗing i laɗing. Dǝitthǝ manungɓǝ.<verse eid="1PE 4:11" /></para>
  <para style="s">Bǝ Tozuii Lǝba Bǝ Əǝ Lǝ Kristǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />Ya ǝnthǝm kwɔ dǝm yiɗi niɓǝ, bǝɓa nhǝm ba lo zuii azizi kwɔ dǝnni naɓǝ i zuii ɓǝthǝ, mangǝ ǝn nung akun kwɔ tolǝu bokun dǝna tonung tthǝɓǝ.<verse eid="1PE 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 4:13" />Manungkwɔni yang ɓa lǝ tthǝla kwɔ ɓa tǝi nwathan zuii gi Kristi lǝtha ɓǝ, yangbǝ tthǝla a yi dang wa ɓǝkwɔ nǝ i ilǝ ghaali gi Fuh lǝ gwam ɓǝ.<verse eid="1PE 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1PE 4:14" />Ɓa lǝ tthǝla nǝ i ɓang ɓǝlǝ bakwɔ dǝɓa muo sua Kristi ɓǝ, dǝna gei angǝ ghaali gi Ɓyang, Ɓyang gi Fuh, dǝna nwong loɓǝ. <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />Nǝɓa tozuii, ǝn ba ko ɓǝ ǝn ya thǝb bǝi lǝu ko ya nung i ko ya to nung a ɓko ko ya tǝ dang ba yakun.<verse eid="1PE 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1PE 4:16" />Manungkwɔni yang, nǝ dǝma tozuii bakwɔ mǝ ǝn Kristǝ, bǝ a lǝ tthǝkku lǝ bko thǝ, kwoi a to kha Fuh bakwɔ ɗuǝn mǝ ǝn ya Kristǝ ɓǝ. <verse eid="1PE 4:16" /><verse number="17" style="v" sid="1PE 4:17" />Lona wung kwɔ i baipi bǝ to kwan ɓǝ, yang i baipi bǝ tokwan lǝ yayuu gi Fuh tthǝ nungsi. Nǝ i baipiu i ɓilǝ, a tonǝnǝ i yakwɔ dǝba a langǝ i tthǝ nwaba a langǝ i gi Fuh ɓǝ? <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />Manungkwɔ ba gi Fuh angǝ,</para>
  <para style="q1" vid="1PE 4:18">&lt;&lt;Nǝ ziiɗing kwɔ ya langǝ i a tǝi nwongǝi ɓǝ;</para>
  <para style="q2" vid="1PE 4:18">ǝn ɓǝttǝn, lakwɔ, atǝi yayuu kwɔ ǝn yayuu gi fuh lǝu ya nung a ɓko ɓǝ?&gt;&gt;<verse eid="1PE 4:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="1PE 4:19" />Nungkwɔ yang, yakwɔ dǝna to zuii lǝ ba bǝ yiɗi gi Fuh kwɔ, lǝ ba bǝ to nung to gi a langǝ i gǝm lǝ loi tthǝ ǝndǝi tthǝ yuu akwɔ Mabbǝi ɓǝ, kwɔ vii ǝndǝi dǝna dǝ lo bǝ gwab nwa gu ɓǝ.<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">Kab Nungbyang Gi Fuh</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />Ɓang, kwɔ ǝn yikku i namlǝ, ǝn gei balǝ yakku kǝm pinwa kwɔ dang ɓǝ kwɔ. Ɓanglǝ ya gei nwa ba zuii gi Kristi, yang mǝn gab ghaali kwɔ wa igwam nungpangbǝi ɓǝ. Dǝmǝng yam ɓǝ <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />ɓa ǝǝlǝ ya gagci nungbyang gi Fuh kwɔ dǝɓǝ angǝ ɓa dǝ nung tthǝɓǝ, manungkwɔ Fuh dǝna gei angǝ ɓato ɓǝ, langkwoi i ttha lǝu. Ɓa to nung to ɓǝ, lǝba nung busoni lǝu, kwoi bǝ yiɗi bǝ to nung to. <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />Bǝɓa lo yigwoi lo nungbyang kwɔ i dǝɓǝ thǝ, kwoi ɓa ǝǝlǝ nungkwɔ i naɓǝ. <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />Langkwoi Yeso yikku ya gagci nungbyang ɓǝ nǝ fug, ɓa muo nung muo lo angǝ a kwɔ kailiu thǝmmu ɓǝ.<verse eid="1PE 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />Manungɓǝni ɓǝ ya baittha ɓa dǝ loɓǝ lǝ yakku ɓǝ. Langkwoi ɓǝ ǝndǝi ɓa li nunglitthǝ ɓuob lo sua, yangbǝ ɓa to nung to lǝtha tthǝ; bakwɔ ba Fuh gei angǝ, &lt;&lt;Fuh dǝna la ya lo angǝ a, kwoi dǝna to nung a langǝ i lǝ ya ɓuob lo sua tthǝ.&gt;&gt; <verse eid="1PE 5:5" /><verse number="6" style="v" sid="1PE 5:6" />Ɓa ɓuob loɓǝ sua, tthǝ na angǝ a gi Fuh, yangbǝ u lǝi ɓǝ yi lona a langǝ i gu. <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />Ɓa yiutthǝ vulli ɓǝ ǝndǝi, bakwɔ dǝu yidɗi ɓǝɓǝ.<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />Ɓa muo loɓǝ, nǝɓa ɓyǝa lǝi! Ya ɓuiɓǝ, Shǝtan, nyi nung dǝna mǝrǝmlǝ mangǝn zua, dǝnnu ɗu yuu akwɔ u thǝb ɓǝ. <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />Ɓa dǝi nyimtthǝ dang bǝ dǝnyitthǝ ɓǝ langkwoi ɓa lko, bakwɔ ɓa ibǝing ya young ɓǝ ya dǝba a langǝ i dang longwam ǝndǝi dǝna tang iri zuii ɓǝkwɔ. <verse eid="1PE 5:9" /><verse number="10" style="v" sid="1PE 5:10" />Kwoi ɓa to zuii lona tuab ɓuo, Fuh ya nung to a langǝ i ǝndǝi, yuu akwɔ lubǝi ɓǝ angǝ ɓa tǝi nwathan ɓǝ dang ghaali gu a ɗing dang tha i Kristi, u i nkolǝ kwoi ɓǝlǝ u to ɓa dǝi nyimtthǝ, i pi kǝm a nyimmi. <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />Ttha ǝn abo laɗing! Dǝitthǝ manungɓǝ.<verse eid="1PE 5:11" /></para>
  <para style="s">Bǝ Alo Bǝ Gumbǝi</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />Ən Sila na tthǝ nungkwɔ ǝn vullǝ ɓǝ nungvullǝ kwɔtthǝ tuab kwɔ ɓǝ, yuu akwɔ dǝm lǝi geigǝ ǝn ya young ya Krista ya dǝnyitthǝ. Dǝm yiɗi bǝ nyimtthǝ ɓǝ langkwoi ǝn gei nwam geigǝ nungkwɔ lǝ nung a langǝ i gi Fuh. Ɓa dǝi dang ǝu nyimtthǝ.<verse eid="1PE 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13" />Kǝm pinwa ɓǝ kwɔ Babila kwɔ, kwɔ langɓǝ ǝn Fuh mko kwɔ, dǝna gumbǝi ɓǝ, langkwoi i yuim Markus. <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />Ɓa gum tha ibǝ gumbǝi yiɗi tha ya Kristǝ.</para>
  <para style="p" vid="1PE 5:14">Kaso tǝmmi ǝǝ i ɓǝlǝ ǝndǝi kwɔ lǝ a bǝ Kristi ɓǝ.<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>