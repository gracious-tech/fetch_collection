<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">2 Yohanna</para>
  <para style="toc1">Nungvullǝ A Rab Gi YOHANNA</para>
  <para style="toc2">2 Yohanna</para>
  <para style="toc3">2 Yo</para>
  <para style="mt2">Nungvullǝ A Nung Rabbu Gi</para>
  <para style="mt1">YOHANNA</para>
  <para style="imt">Bǝ Gabnung</para>
  <para style="ip">
    <char style="bk">Nungvullǝ Gi Yohanna A Rabbu</char> ǝn &lt;&lt;Yikku&gt;&gt;vullǝ sua &lt;&lt;Yisi i yathang gu,&gt;&gt;lko ǝn kǝm pinwa i yayuu. Nungvullǝ ɓǝ kwɔ tuab kwɔ ǝn bǝ gei yayuu angǝ i yidɗi tha langkwoi bǝ gub ɗuogsui ba ya nanatthǝ nung pǝllǝ ibǝ nanatthǝ nung gi.</para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />Bǝgǝ yakku</para>
  <para style="p" vid="2JN 1:1">Sua yisi kwɔ mko ɓǝ i yathang gu, kwɔ dǝmǝn yiɗi niɓǝ. Langkwoi ɓang i nungtthǝm lǝu, kwoi yakwɔ ibǝi ba a langǝ i ǝndǝi dǝna yiɗi mǝ, <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />Ɓakwɔ ǝn ba a langǝ i ǝǝ dang tthǝɓi langkwoi a ǝǝ i ɓilǝ laɗing.<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />Kaso Fuh Daa i Yeso Kristi, Daa gi Yui, dǝɓi nung a langǝ i, langkwoi ɓyǝa nungzuii ɓi, i tǝmmi; kaso i ǝǝlǝ aɓi dang ba a langǝ i i bǝ yiɗi bǝi.<verse eid="2JN 1:3" /></para>
  <para style="s">Ba a Langǝ i Ibǝ Yiɗi bǝi</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />Ənlǝ tthǝla ɗing kwɔ ǝnlǝ angǝ yathang mǝ yakun dǝna thko dang ba a langǝ i ɓǝ, manungkwɔ Daa gei ɓi tthǝɓǝ. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />Langkwoi nungkwɔ dǝm ɓib ba, Yisi: ɓi ǝndǝi ɓi yiɗi tha. Nungkwɔ ǝn zuu afu dǝmǝn vulla tthǝlǝu; ǝn zuu kwɔ ɓi ibǝi la nwasiu ɓǝ. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />Bǝ yiɗi bǝi kwɔ dǝmǝn gei kwɔ nungɓǝlǝ ɓi ǝǝ dang bǝ tonungto i zuu gi Fuh. Zuu ɓǝkwɔ, manungkwɔ ɓalǝ la nwasiu kwɔ, nungɓǝlǝ ɓǝ ǝndǝi ɓa ǝǝ dang bǝ yiɗi bǝi.<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />Ya ɗambǝi kpaaɗing tǝ dang longwam, yayuu akwɔ gwab angǝ Yeso Kristi wuo mangǝn thayuu lǝuɓǝ. Yuu manungkwɔ ni ǝnya ɗambǝi langkwoi ǝn ya ɓui gi Kristi. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />Ɓa dǝ kiggǝ ɓǝ, yangbǝ bǝ nungkwɔ ɓi tonungto lǝ bko kwɔ lathǝ, kwoi ɓa muo nungbusɔni ɓǝlǝ kpaaliu.<verse eid="2JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9" />Yuu akwɔ ǝndǝi nǝ dǝilo bǝ nanatthǝ nung gi Kristi lǝu, kwoi patthǝ, u yangǝu i Fuh. Yuu akwɔ nǝ dǝilo bǝ nanatthǝ nung gu utthǝ i Daa langkwoi i Yuiu. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />Nungkwɔ yang, nǝ yuu akun nǝ wuo suaɓǝ wuo lǝ bǝ nanatthǝ nungkwɔ lǝu, bǝɓa kǝb loi gwoi ɓǝthǝ; bǝ ɓa gei ɓangǝ, &lt;&lt;Bǝ ǝǝ a langǝ i i ɓǝlǝ thǝ.&gt;&gt; <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />Bakwɔ nǝ yuu akwɔ nǝ gei angǝ bǝ ǝǝ a langǝ i iɓǝ yang u mǝrǝm lǝ ya to nung to mungkullum i ilǝ.<verse eid="2JN 1:11" /></para>
  <para style="s">Bǝ Alo Ba</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />Ɓangtthǝ i nung kpaaɗing kwɔ mǝn gei ɓǝtthǝ ɓǝ, kwoi ǝn yiɗi bǝ nungvullǝ nung takardǝ i mung yǝng nung vullǝ nung lǝu; manungkwɔni yang, dǝm dǝnyitthǝ bǝ tǝsua ɓǝ langkwoi ǝn gei ba i ɓǝlǝ i namlǝ, yangbǝ ɓi ǝndǝi ɓi lǝ tthǝla.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />Yathang youngmǝ yasi kwɔ i mko ɓǝ dǝna gumbǝi.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>