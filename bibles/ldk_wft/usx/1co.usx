<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">KOR 1 - MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">Korantiyawa 1</para>
  <para style="toc1">Nungvullǝ Gi Bulus A Nwasiu Sua Ya Korantiyawa</para>
  <para style="toc2">Korantiyawa 1</para>
  <para style="toc3">Kor 1</para>
  <para style="mt2">Nungvullǝ Gi Bulus A Nwasiu Sua Ya</para>
  <para style="mt1">Korantiyawa</para>
  <para style="imt1">Bǝ Gabnung</para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />Bǝgǝ Bulus, Fuh lubǝiu ibǝ yiɗi gu yangbǝ u ǝǝlǝ ya nwatummi gi Yeso kristi, langkwoi i young ɓi Sastanisu<verse eid="1CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 1:2" />Sua ya kǝm pinwa kwɔ dang Koranti ɓǝ, sua yakwɔ ǝndǝi i lubǝi yangbǝ i ǝǝlǝ yayuu gi Fuh a langǝ i ɓǝ, yakwɔ ǝn abo dang tha Kristi Yeso ɓǝ, suatha i yayuu ǝndǝi ko pǝllǝ ǝndǝi kwɔ dǝna wab Dangbang Yeso Kristi ɓi, Dangbang gi i aɓi:<verse eid="1CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />Kaso Fuh Daa ɓi langkwoi Dangbang Yeso Kristi dǝɓǝ nung a langǝ i i bǝ ǝǝ a langǝ i.<verse eid="1CO 1:3" /></para>
  <para style="s">Bǝ Khana lo Dang Kristi</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />Vii ǝndǝi dǝm kha Fuhm lǝ ba ɓǝ lǝba nung a langǝ i kwɔ u dǝɓa tthǝ Yeso Kristi. <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />Bakwɔ ɓǝ dang tha i Kristi ɓa mǝrrǝmlǝ ya nungtǝi dang nung ǝndǝi, i bǝ gei ba langkwoi i bǝ ibǝ nung ǝndǝi. <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />Bakwɔ nwaba ɓi lǝba Yeso kristi ǝǝ nyimɗing dang ɓǝ <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />Manung kwɔni dǝɓa muo nungdǝ gi ɓyang kwɔ dǝɓa dǝnung dǝɓa ki lo Dangbang Yeso kristi ɓi kwɔ a kwoiɓǝ. <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />U muna tthǝɓǝ lǝ nyimtthǝ a tǝlǝ bǝ alo, yangbǝ i muo ɓǝ i kwannu Vii kwɔ Dangbang Yeso Kristi ato kwan lǝ longwam tthǝɓǝ. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />Ən Fuh i dǝba a langǝ itthǝ, Fuh kwɔ lubǝ ɓǝ angǝ wuɓa kǝbtha lo i Yuiu Yeso Kristi, Dangbang ɓi.<verse eid="1CO 1:9" /></para>
  <para style="s">Bǝ Gabtha Lo Dang Yakǝm Pinwa</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />I ttha gi Dangbang Yeso Kristi ɓi dǝm gei ɓǝtthǝ ǝndǝi, ya ǝnthǝm, nungkwɔ nǝɓa gei ɓa gwablǝ tha tthǝ, yangbǝ bǝ gabtha ǝrr dang ɓǝ thǝ. Ɓa kǝblo ɓǝ lǝtha kun, i bǝ nhǝm bakun. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />Ya ǝnthǝm yakun dang woi Kuluwi geimthǝ angǝ dǝɓa kwatha ɓuaɓǝ. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />Nungkwɔ dǝm gei kwɔ nungɓǝ lǝ: ko ǝn ya ɓǝ dǝna gei nung a kun nǝkun kun. Yuu akun gei angǝ&lt;Dǝm muo sua Bulus&gt;&gt;; yuu a kun angǝ, &lt;&lt;Dǝm muo sua Apolos&gt;&gt;; yuu a kun angǝ, &lt;&lt;Dǝm muo sua kefas&gt;&gt;; langkwoi yuu a kun angǝ&lt;&lt;Dǝm muo sua Kristi.&gt;&gt; <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />I gab kristi ǝn gab dang tha kun kunna! Əm Bulus ɓui lo kab gangǝ i lǝ ba ɓaa? I wollɓǝ mung lǝ ya nanung to gi Bulus a? <verse eid="1CO 1:13" /><verse number="14" style="v" sid="1CO 1:14" />Ən kha Fuh kwɔ ǝn wollmung lǝ yuu a kun dang ɓǝ lǝu, ǝn Kirisbus i Gayus ɓuo. <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />Yuu akun yangǝu dang ɓǝ a gei angǝ, i wollimung lǝ ya nanung tom mu. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />(Ni, ǝn ɓang wollmung lǝ Istifanus i ya gwoi gu langɓǝ; kwoi ǝn ɓuan ǝn nhǝm ko ǝn wollmung lǝ yuu kun nǝng langkwoi lǝu.) <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />Kristi tummǝm angǝ wung wollmung lǝ yuu akun lǝu. U tummǝm angǝ wung gei nwaba a langǝ i, langkwoi ǝn gei nwaba yiggǝi thayuu lǝu, yangbǝ ttha bǝ ɓui gi Kristi lo kab gangǝ i bǝ la nǝkwam thǝ.<verse eid="1CO 1:17" /></para>
  <para style="s">Kristi Lǝ Ttha I Yiggǝi Gi Fuh</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />Bakwɔ nwaba bǝ ɓuiɓua Kristi lo kab gangǝ i ǝn nung sulǝ tthǝ yakwɔ lǝnla ɓǝ; kwoi ɓi aɓi kwɔ i nwong ɓi kwɔ ǝn ttha Fuh. <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />Nungvullǝ ba Fuh gei angǝ,</para>
  <para style="q1" vid="1CO 1:19">&lt;&lt; Mǝn ɓanglǝ yiggǝi ya yiggǝi;</para>
  <para style="q2" vid="1CO 1:19">langkwoi mǝn lǝi bǝ ina nung ya ibǝ nanung mǝn dǝ gwukun.&gt;&gt;<verse eid="1CO 1:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="1CO 1:20" />Nungkwɔ yang, ya yiggǝi ɓǝlǝ? Ya ibǝ nung ɓǝlǝ? Ko ya ina bǝ nyimnwa lo nung longwam kwɔ ɓǝ? Fuh mǝrrǝm yiggǝi ya longwam kwɔ lǝ sulǝ!<verse eid="1CO 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21" />Bakwɔ dang yiggǝi gi Fuh u lam nung ya longwam i iu dang yiggǝi gi lǝu. To nungkwɔ yuu a iulǝ i yiggǝi gi. Manungkwɔni yang, i ba &lt;&lt;sulǝ&gt;&gt; kwɔ dǝɓi gei kwɔ, Fuh gwab nwong yakwɔ dǝ ba a langǝ i tthǝ ɓǝ. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />Ya Yahudawa dǝna yiɗi nung fǝmlo yangbǝ ǝǝlǝ nungkwɔ i ɓyǝa ɓǝ, langkwoi ya Helenawa dǝna ɗuu abǝi yiggǝi. <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />Kwoi aɓi abo, dǝɓi gei ǝn ba Kristi kwɔ i pi ɓǝ, tal lag bo bǝi tthǝ ya Yahudawa langkwoi ǝn sulǝ yakwɔ ǝn ya Yahudawa lǝu ɓǝ; <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />Kwoi ba a bǝ yakwɔ Fuh lubǝi kwɔ, ya Yahudawa iya kwɔ ǝn ya Yahudawa lǝu kwɔ, nwaba kwɔ ǝn Kristi, kwɔ ttha gi Fuh langkwoi ǝn yiggǝi gi Fuh. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />Bakwɔ nungkwɔ ǝǝ mangǝn sulǝ gi Fuh kwɔ yigg pǝl yiggǝi yuu, langkwoi nungkwɔ ǝǝ mangǝn tthǝ muanni nyim pǝl ttha thayuu. <verse eid="1CO 1:25" /><verse number="26" style="v" sid="1CO 1:26" />Ya ǝnthǝm, ɓa nhǝm bǝikwɔ ɓǝtthǝ viikwɔ ɓǝ. Kwɔ bǝ Fuh lubǝi ɓǝ. Nung thayuu lǝ yayuu kpako dang ɓǝ lǝ ya yiggǝi i ya ttha ko yakwɔ i siǝ gwoi ya nungtǝi ɓǝ. <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />Kwoi Fuh mko nung a sulǝ a longwam kwɔ yangbǝ dǝ tthǝku lǝ ya yiggǝi, langkwoi u mko nungkwɔ longwam kwɔ dǝna lǝi angǝ muanni ɓǝ yangbǝ u dǝ tthǝku lǝ ya ttha. <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />Fuh mko nungkwɔ ya longwam dǝna tthǝm langkwoi la kwɔ dǝi nhǝm angǝ ǝn nung akun lǝu kwɔ, yangbǝ u ɓanglǝ nungkwɔ ya longwam dǝna nhǝm angǝ ǝn nung a langǝ i ɓǝ. <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />Yangbǝ bǝ yuu akun lǝi lo tthasi Fuh thǝ. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />Kwoi Fuh wuɓi lǝ dang tha i Kristi Yeso, langkwoi Fuh mǝrrǝm Kristi lǝ yiggǝi ɓi. Tthǝu lǝ i mabɓi i Fuh lǝ; ɓi mǝrrǝm lǝ yayuu Fuh a langǝ i langkwoi ɓi tǝi loɓi. <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />Manungkwɔ yang, manungkwɔ nungvullǝ gei kwɔ angǝ,&lt;&lt;Yuu kwɔ dǝna yiɗi bǝ lǝi lo yang lǝi lo lǝ ba nungkwɔ Dangbang toɓǝ.&gt;&gt;<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s">Nwaba A Langǝ i Lǝba Kristi Kwɔ I Piu Lo Kabgangǝ i Ɓǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />Ya ǝnthǝm, kwɔ ǝn wuo suaɓǝ, bǝ gei ɓǝ ba langǝ i gi Fuh, ǝn wuo bǝ gei ɓa dang yiggǝi lǝu, i gei ba a ɓuoni ibǝ ina nunglǝu. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />Bakwɔ vii kwɔ ɓang suatha iɓǝ kwɔ, ǝn mǝrrǝm lo nyim bǝ yitthǝ nung ǝndǝi Yeso Kristi ɓuo langkwoi ba ɓua gu lo kab gangǝ i.<verse eid="1CO 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 2:3" />Kwɔ ǝn wuo sua ɓǝ kwɔ, tthǝm muan ɗing langkwoi tthǝm ǝndǝi dǝna sur vulli, <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />langkwoi bǝ nanatthǝ nungǝm i nwabam ǝn gei mangǝn ba yiggǝi thayuu lǝu, kwoi i dǝ lotthǝ i ttha Ɓyang gi Fuh. <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />Yangbǝ bǝ dǝnyitthǝ ɓǝ ǝǝ lo yiggǝi gi yuu thǝ kwoi ttha Fuh.<verse eid="1CO 2:5" /></para>
  <para style="s">Yiggǝi Gi Fuh</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />Yirrǝ dǝm gei ba yiggǝi lǝ yakwɔ tthǝ ɓyang gi ghaang ɓǝ. Kwoi ǝn yiggǝi ya longwam kwɔ lǝu ko a bǝ ttha kwɔ dǝna lo yigwoi kwɔ ɓǝlǝu-kwɔ dǝna mǝrrǝm lǝ nung a nǝkwam ɓǝlǝu. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />Yiggǝi kwɔ dǝm gei kwɔ ǝn yiggǝi gi Fuh kwɔ pyǝa lǝ pyǝa ɓǝ, kwɔ i pyǝa lǝ thayuu ɓǝ, kwɔ u osi u mko lǝba ghaali ɓi nwuni bǝ i mab longwam ɓǝ.<verse eid="1CO 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 2:8" />Ya lo yigwoi akun yangǝu longwam kwɔ ibǝi yiggǝi ɓǝ kwɔu. Nǝ i ibǝi ǝn i yang, i pi Dangbang ya angǝ a lo kab gangǝ iu.<verse eid="1CO 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 2:9" />Manungkwɔ ni, kwɔ nung vullǝ gei angǝ,</para>
  <para style="q1" vid="1CO 2:9">&lt;&lt;Nungkwɔ yuu a kun ɓyǝa ko lǝlǝu bokun,</para>
  <para style="q2" vid="1CO 2:9">nungkwɔ yuu a kun nhǝm angǝ a to nung lǝu,</para>
  <para style="q2" vid="1CO 2:9">ǝn u nungɓǝkwɔ Fuh mab lǝ yayuu kwɔ dǝna yiɗi gu ɓǝ.&gt;&gt;<verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />Kwoi Fuh tanatthǝ nungkwɔ u pyǝa dang nyiu lǝ ǝn ɓitthǝ tthǝ Ɓyang gu. Ɓyang ɓǝ dǝna ɗuu nung ǝndǝi, ko nungkwɔ Fuh pyǝa tutthǝ ɓǝ. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />Ən ɓyang ɓi ɓuo dang tthǝɓi kwɔ ibǝ nung ǝndǝi lo ɓilǝ; manung ɓǝni, ǝn Ɓyang gi Fuh ɓuo ibǝ nung lo Fuh lǝ. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />Ɓi muo Ɓyang ya longwam kwɔ lǝu, kwoi ǝn ɓi muo Ɓyang kwɔ Fuh tummu ɓǝ, yangbǝ ɓi ibǝi nung ǝndǝi kwɔ Fuh dǝɓi ɓǝ.<verse eid="1CO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13" />Nungkwɔ Yang, dǝɓi gei ba kwɔ yuu naɓi natthǝ yiggǝi ɓǝlǝu, kwoi ǝn ba kwɔ Ɓyang naɓi natthǝ ɓǝ, manungkwɔ ɓi nanatthǝnung ba a langǝ i gi ɓyang lǝ yakwɔ tthǝ i Ɓyang lǝ ɓǝ. <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />Yuu kwɔ yangǝu i Ɓyang Fuh lǝu yang ɓuan muo nungdǝ kwɔ wuo bǝgǝ Ɓyang gi Fuh ɓǝu. Yuu ɓǝkwɔ la langǝ i ibǝiu, langkwoi ǝǝ mangǝn nung a nǝkwam tthǝu lǝ, bakwɔ i ɓyǝa mali gi tthǝn tthǝ ɓyang. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />Yuu akwɔ tthǝ i Ɓyang gi Fuh, u ɓuan u to kwan lo mali gi nung ǝndǝi, kwoi yuu a kun yangǝu a ɓuan a tou kwannu. <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />Manungkwɔ nungvullǝ gei kwɔ angǝ,</para>
  <para style="q1" vid="1CO 2:16">&lt;&lt;Ən yittǝn i dang wa Dangbang?</para>
  <para style="q2" vid="1CO 2:16">Ən yittǝn a ɓuan a duu shawarǝ?&gt;&gt; Ɓi,nǝnǝ,</para>
  <para style="m" vid="1CO 2:16">Ɓi tthǝ i lonyi Kristi.<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">Ya Thǝb Gi Fuh</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />Ya ǝnthǝm, lǝba a langǝ i abo, Ən ɓuan ǝn gei ɓǝ ba manung a bǝ yakwɔ tthǝ i Ɓyang ɓǝu; Mǝn gei ɓǝ ba mangǝtǝn ɓǝ ǝn ya longwam kwɔ, mangǝn yathang Fuh kwɔ dǝ ba a langǝ i tthǝ kristi ɓǝ. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />Mǝn ttha ɓǝ i mung mi, ǝn nungtang a nyimmi lǝu, bakwɔ yirrǝ ɓa natthǝ bǝ tang nung lǝuɓǝ, Langkwoi yirrǝ lakwɔ ɓa natthǝ bǝ tangǝu lǝu, <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />bakwɔ yirrǝ dǝ ɓa ǝǝ manung a bǝ ya longwam kwɔ. Nǝ bǝ tthǝngbǝi tthǝ dang ɓǝ ibǝ kwatha, yang nungkwɔ ǝǝ mangǝ ɓǝ ǝn ya longwam kwɔ, dǝ ɓa to nung mangǝn yayuu a nǝkwam lǝu? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />Kwɔ nǝ yuu akun dang ɓǝ gei angǝ,&lt;&lt;Dǝm muo sua Bulus,&gt;&gt; yuu a kun angǝ, &lt;&lt; Dǝm muo sua Apolos&gt;&gt;ɓǝ ǝn yayuu nǝkwam lǝu?<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />Dang nungkwɔ ǝndǝi, yittǝn lǝ Apolos? Langkwoi yittǝn lǝ Bulus? Ɓi ǝndǝi ǝn thǝb gi Fuh ɓuo, kwɔ thǝb ɓi lǝ ba dǝ ba langǝ i tthǝ ɓǝ. Ko ǝn yittǝn dang ɓi dǝna to ǝn nung to kwɔ Dangbang duu angǝ u toɓǝ; <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />Ən bie nungbie, Apolos al mungki tthǝ, kwoi ǝn Fuh to nungbie ɓǝ ghaa. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />Yuu kwɔ bie nung i yuu kwɔ al mungki tthǝ ǝn nung akun lǝu. Ən Fuh lǝ nung, bakwɔ ǝn u ghaa lǝ nungbie ɓǝ. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />Bǝ gab ganglang Yuukwɔ bie nung i yuu akwɔ al mungki tthǝ ɓǝu; Fuh a kwai nungbusoni ko ya ǝndǝi natha i nungkwɔ koya toɓǝ.<verse eid="1CO 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 3:9" />Ɓi ǝndǝi ya young to nung to lotha lǝ Fuh tthǝ.</para>
  <para style="p" vid="1CO 3:9">Ɓǝ langɓǝ ǝn nungmai gi Fuh. <verse eid="1CO 3:9" /><verse number="10" style="v" sid="1CO 3:10" />Dǝmǝn to nung to i nungdǝ kwɔ Fuh dǝm ɓǝ, dǝm to nung to ya ina bǝ mainung kwɔ li pi kǝm ɓǝ, langkwoi yuu a kun dǝna mai nung lolǝ. Kwoi ko ǝn ya ɓa to kiggǝ bǝ mai nung lolǝ ɓǝ. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />Bakwɔ Fuh osi dǝ Yeso Kristi lǝ yuu kun ɓuo lǝ pi kǝm, langkwoi pi kǝm a kun yangǝu i liu.<verse eid="1CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 3:12" />Yakun a to nung to i ɓui azurfa ko ɓui a yummi ko tal kwɔ nungkurɓǝu ɓuonni kwɔ bǝ mai nung lo pi kǝm lǝ; yakun a to nung to kab ko gug ko ǝn wog. <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />Langkwoi mali nung to gi yayuu ǝndǝi i ɓyǝa Viikwɔ Kristi ilǝ nung gwambǝi ɓǝ. Bakwɔ Viilǝ kwɔ lua a ilǝ nung to gi yayuu ǝndǝi lǝ gwam; lua a na nung to ɓǝ yangbǝ i ibǝ maliu. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />Nǝ nungkwɔ i mai lo pi kǝm lǝ sob tthǝ lualǝ yang, ya mainung ɓǝ a tǝi nungbusɔni gu. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />Nǝ lua nǝ li nung to mǝ, yang ma tang zuii; yang mǝ amǝ ma sob lo, mangǝtǝn a sob lo dang lua na a nǝkwam.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />Lalangǝ i ɓa ibǝi ǝn ɓǝlǝ kǝm Nyǝknung gi Fuh kwɔ Ɓyang gi Fuh dang tthǝɓǝ! <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />Fuh a ɓanglǝ yuukwɔ a ɓanglǝ kǝm Nyǝknung guɓǝ. Bakwɔ Kǝm Nyǝknung Fuh ǝn bǝi a langǝ i, langkwoi ɓǝ i naɓǝ ɓǝlǝ kǝm Nyǝknung Fuh.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />Bǝɓa ɗam loɓǝthǝ. Nǝ yuu akun dang ɓǝ dǝna nhǝm angǝ i yigg ɗing i ba gei ya longwam kwɔ, ɓa mǝrǝmlǝ ya sullǝ, yangbǝ ɓa mǝrǝmlǝ ya yiggǝi lalangǝ i. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />Bakwɔ nungkwɔ longwam dǝna lǝi angǝ ǝn yiggǝi kwɔ ǝn sullǝ ɗǝgsi Fuh&lt;&lt; Manungkwɔ nungvullǝ gei kwɔ angǝ, &lt;&lt;Fuh dǝna muo ya yiggǝi dang yiggǝi gi&gt;&gt;; <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />langkwoi nungvullǝ akun gei angǝ,&lt;&lt;Dangbang ibǝi angǝ bǝ nhǝm ba ya yiggǝi ǝn nung lǝu a nǝkwam.&gt;&gt; <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />Yuu a kun yangǝu, yang, kwɔ a lǝilo lo nungkwɔ thayuu ato ɓǝ. Ba a langǝ i nung ǝndǝi ǝn aɓǝ; <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />Bulus, Apolos, i kefas; longwam Kwɔ, nwongǝi i ɓua, lakwɔ langkwoi i tthasi-nungkwɔ ǝndǝi ǝn aɓǝ, <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />langkwoi ɓǝ ǝn a bǝ Kristi, langkwoi Kristi ǝn a bǝ Fuh.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">Nungto Gi Ya Nwatummi Gi Kristi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />Ɓa ɓyǝa ɓi mangǝ ɓi ǝn thǝb gi Kristi, yakwɔ Fuh ji loba ba bǝ pyǝa ba a langǝ i gu ɓǝ. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />Ko ǝn togwoi anwɔ dǝna yiɗi thǝb ɓǝ a to nung to dang wa kun dang nung to kwɔ i duu ɓǝ. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />Lakwɔ, ziim mu kwɔ ɓa tom kwan tthǝɓǝ ko bǝ to kwan thayuu; langkwoi ǝn to kwan lǝ lom tthǝu.<verse eid="1CO 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 4:4" />Dang nyim kai nǝkwam, kwoi ǝǝ mangǝ ǝn ibǝ nung lǝu. Dangbang lǝ yuu kwɔ a tom kwan tthǝ ɓǝ. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />Nungkwɔ yang bǝɓa to kwan lǝ yuu kun tthǝ nwuni bǝ lona a langǝ i wuo thǝ. Kwan a nǝsua dǝisua nǝ Dangbang wuo ɗǝ; wuo gablua tthǝ nungkwɔ pyǝa lǝ pyǝa dang bǝthǝl ɓǝ langkwoi u yǝb nung a pyǝalǝ pyǝa dang nyi yayuu. Langkwoi yang yayuu ǝndǝi a tǝi bǝ khabǝi na Fuh. <verse eid="1CO 4:5" /><verse number="6" style="v" sid="1CO 4:6" />Ya ǝnthǝm, lǝba ɓǝ, ǝn to nungkwɔ ǝndǝi tthǝ Apolos i ɓanglǝ, yangbǝ ɓa naɓi lǝ nungkwɔ dǝi gei angǝ, &lt;&lt;Ɓa tonungto kwɔ zuu geiɓǝ.&gt;&gt; Yuu a kun yangǝu a lǝilo i yuu akun yang la yuu kun nǝu. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />Ən yi da angǝ a lo yakun? Fuh da nung ǝndǝi kwɔ dǝmma yiɗi ɓǝlǝu? Ən ba ɓǝ bǝ dǝmma lǝi lomǝ, mangǝtǝn nungkwɔ a muo kwɔ ǝn nungdǝ bǝgǝ Fuh lǝu?<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />A osi a tǝi nung ǝndǝi kwɔ dǝmma yiɗi ɓǝngha? A osi a tǝi nungtǝi ngha? A mǝrrǝm lǝ ya yigwoi ngha, kwɔ ɓi i ɓǝlǝ lǝu ɓǝ? Dǝm yiɗi kaso ɓǝ ǝn ya yigwoi, yangbǝ ɓi lo yigwoi i mǝ. <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />Bakwɔ tom tthǝ mangǝ Fuh dǝɓi bǝi a sua ǝndǝi ɓi ya nwatummi, mangǝn yayuu kwɔ a ɓui nung pangbǝi lǝ nungto tthǝkku ba ya longwam ya nwatummi Fuh langkwoi i thayuu. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />Lǝ ba Kristi ɓi mǝrrǝm lǝ ya sulǝ; kwoi ɓǝlǝ ya yiggǝi dang tha i Kristi! Tthǝ ɓi muan ɗing, kwoi tthǝ ɓǝ nyimɗing! I laɓi kwoi i dǝ ɓǝ ghaali! <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />Wulǝ lakwɔ gwom tǝi ɓi i ɗimung; dǝɓi li tǝrnung; dǝi ɓuob ɓi; ɓi thko ɓui kwɔ ǝndǝi dǝɓi mǝrrǝm lǝ ɓi yangǝu i bǝi kwɔ ɓi ǝǝtthǝ ɓǝu; <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />Ɓi to nung to ɓuontthǝ thǝm ɓi. Kwɔ nǝ i tthǝm ɓiɓǝ, ɓi khana lo; kwɔ nǝ i toɓi lǝ zuii, ɓi nyimnyi; <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />Kwɔ nǝ i dal ɓi, yang ɓi gwab i ba a langǝ i. Ɓi pǝl ɓillǝng longwam kwɔ lǝu; ɓi ǝn vurri longwam wulǝ lakwɔ!<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />Ən vullǝ nungkwɔ suaɓǝ, ǝn babǝ dǝɓǝ tthǝkku lǝu, kwoi yangbǝ ǝn naɓǝ natthǝ nung mangǝ ǝn yathangǝm kwɔ dǝm yiɗi ɓǝ. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />Bakwɔ ko ɓǝtthǝ i yakwɔ dǝna naɓǝ natthǝ nung thǝm sob ɓua tthǝm rab pǝmna sob dang bǝto nung to ya Krista, daa ɓǝ kun ɓuo. Bakwɔ dang nwongǝi ɓǝ dang tha i Kristi Yeso ǝn mǝrrǝm lǝ daa ɓǝ tthǝ bǝ wulǝ ba a langǝ i lǝ sua ɓǝ. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />Dǝm yam ɓǝ, yang, ɓa nalǝ nwam. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />Lǝ ba nungkwɔ dǝm tum Timitawos, yuu kwɔ lǝ yuim kwɔ dǝm yiɗi ni dang nung to ya Kristǝ ɓǝ. U o ɓǝ nyitthǝ nunglǝi afu kwɔ ǝn muo tthǝ dang tha i Kristi Yeso langkwoi kwɔ dǝm nanatthǝ lǝ ya kǝm pinwa bǝi ǝndǝi ɓǝ.<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />Yakun ɓǝ mǝrrǝm lǝ ya lo angǝ a bakwɔ dǝɓa nhǝm ɓangǝ ǝn wuo sua ɓǝu. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />Nǝ Dangbang gwab, sua tuu lǝu yang dǝm wuo sua ɓǝ, langkwoi yang mǝn ibǝi ttha lo angǝ a yayuu kwɔ, langkwoi ǝn nungkwɔ dǝi gei ɓuo lǝu. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />Bakwɔ bǝ lo yigwoi Fuh ǝn ba a nwa lǝu kwoi ǝn ba ttha. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />Ən anwɔ ɓa yiɗi? Ən wuo suaɓǝ i kab ba? Ko i ɓyang yiɗi bǝi i bǝ ɓuob lo sua?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">Bǝ To Ɓilǝng Dang Ya Kǝm Pinwa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />Lakwɔ, lalangǝ i i wulǝ ba angǝ bǝ lo i yisi i dang ɓǝ ɓko pǝl a bǝ yakwɔ i Fuh lǝu ɓǝ. I geim tthǝ angǝ yuu dǝna lo i si daa gu! <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />Tonǝnǝ, yang, ɓa lǝi loɓǝ? Nilǝu, kaso ɓa ɓanglǝ dang wa, langkwoi yuu kwɔ to nungkwɔ ɓa nannu dang ɓǝ. <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />Ko kwɔ ǝn tuutha i ɓǝlǝ ɗing dang tthǝ, yirrǝ ɓang bǝi lǝ i ɓǝ dang ɓyang lǝ, langkwoi ǝn osi ǝn to kwan lǝ yuu kwɔ tthǝ to nung aɓau kwɔ ɓǝng, kwɔ dǝɓa kǝptha, langkwoi mangǝtǝn ɓang bǝi lǝ dang ɓyang. <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />Kwɔ nǝɓa kǝbtha dang ɗuǝn Dangbang Yeso ǝn osi ǝn to kwan lo yiɓǝi kwɔ to nung a ɓko kwɔ ɓǝng. Nǝ ɓa kǝb ttha bǝ yikun, langkwoi nǝ ǝn kǝbtha i ɓǝ dang ɓyangǝm, dang ttha Dangbang Yeso i ɓilǝ. <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />Ɓa dǝ yiɓǝi ɓǝkwɔ lǝ Mungkullum yangbǝ sual tthǝ a ɓko kwɔ ɓui, yangbǝ ɓyangǝu sob Vii gi Dangbang.<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />Mko kwɔ ɓa lǝilo ɓǝɓǝ! Ɓa ibǝ ba ɓǝng,&lt;&lt; mual yisti kwɔ tuab kwɔ a fǝm nung.&gt;&gt; <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />Ɓa la yisti aku nung a ɓko yangbǝ ɓa ǝǝ kaitthǝ. Yang ɓa ǝǝ mangǝn mual a fuu kwɔ i nung kwɔ yisti a kun yangǝu tthǝɓǝ, manungkwɔ la langǝ i ǝn ibǝi ɓǝ manungɓǝ ɓǝ. Bakwɔ ɓang nyang lo gwoi ɓi gbagǝng, lakwɔ Kristi, ɓangam to ɓang nyang lo ɓi, i nyǝklǝ nungǝng. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />Ɓi to ɓang nyǝknung ɓi, yang, i burodi kwɔ yisti a aku nung a ɓko i tolǝ ɓǝlǝu, kwoi i burodi kwɔ yisti yangǝu tthǝɓǝ, burodi nung a langǝ i i ba a langǝ i.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />Dang nung vullǝ kwɔ ǝn vullǝ kwɔ ǝn gei ɓǝtthǝ bǝɓa kǝptha lo i ya to nung a ɓko thǝ. <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />Lakwɔ dǝm gei gǝngǝ ya wab nung lǝu kwɔ dǝna to nung a ɓko lǝu ko dǝna yiɗi loi ko ǝn ya nung i, yakwɔ dǝna wab nung ɓǝlǝu. Nǝ dǝɓa yiɗi bǝ kangǝ i yang ɓa yitthǝ nung to ya longwam ǝndǝi. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />Kwoi lakwɔ dǝm vullǝ nung sua ɓǝ yangbǝ bǝɓa kǝb tha lo i yuu akwɔ dǝna lu loi angǝ young kwoi dǝna lo nǝkwam i tha ko bǝ to ɗǝlak, ya wab nung, ya gei ba tthǝ yakun, ya nwa min ko ya nung i ko ya lag bo bǝi. Bǝ ɓa tangnung i yuu manungkwɔ ni thǝ.<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />Ən ɓǝ kǝbǝm lǝ tha i yakwɔ yangǝu dang ya kǝm pinwko ɓa? Gǝlko ɓa to kwan lǝ yakwɔ dang ɓǝ ɓǝ wai? <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />Fuh a to kwan lǝ yakwɔ tthǝ gwam ɓǝ. &lt;&lt;Ɓa nan yiɓǝi ya nyiɓko ɓǝ dang ɓǝ.&gt;&gt;<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">Bǝ A Ɓuobnwa Lo Youngmǝ thǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />Nǝ ɓǝtthǝ i nyimnwa ganglang ɓǝ ya Kristǝ, ǝn ba ɓǝttǝn ɓa tǝsua yato kwan kwɔ i Fuh lǝu ko kwɔ ɓa tǝsua yayuu Fuh gab ganglang ɓa? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />Ɓa ibǝi kwɔ yayuu Fuh a to kwan lǝ longwam tthǝ ɓǝlǝu? Nǝ ǝn ɓǝ ɓato kwan lǝ longwam tthǝ, yang ɓa ɓuan ɓato kwan lo ba atuab wa? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />Ɓa ibǝi kwɔ ɓi to kwan lǝ ya nwatummi gi Fuh ɓǝlǝu? To nǝnǝ tha i nung longwam kwa! <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />Nǝ ba manungkwɔni nǝ wuo, ɓa lǝi ɓa tǝlǝ sua yakwɔ ǝn ya kǝm pinwa lǝu ɓa? <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />Tthǝkku to ɓǝng! La langǝ i yuu tthǝ kun ya yiggǝi kwɔ a mab ganglang ɓǝ dang yakwɔ dǝɓa kǝptha i ilǝ young ɓǝ ya Kristǝ. <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />Manungkwɔ niyang, ya Krista a kun ɓuobnwa lo youngǝu yang ya to kwan kwɔ dǝba a langǝ i tthǝ Fuh lǝu kwɔ yang to kwan ɓǝ!<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />Bakwɔ dǝɓa ɓuob nwa lotha kwɔ ɓa ǝǝ mangǝ ɓa o ǝndǝing. Mko kwɔ kaso youngmǝ a toa nung a ɓko ɓa? Mko kwɔ kaso i muo nung namǝ lǝ ttha ɓa? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />Manungkwɔ niyang, dǝɓa to nung a ɓko tthǝ tha langkwoi dǝɓa muo nunglǝ ttha natha, i na ya young ɓǝ ya dǝ ba a langǝ i tthǝ Fuh ǝndǝi! <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />La langǝ i ya nyi a ɓko tǝ bǝi kwɔ Fuh lǝ yigwoi ɓǝu. Bǝ ɓa ɗam loɓǝ thǝ; yakwɔ da lo i tha kwɔ ko yakwɔ dǝna wab nung ko ya ɓa yisi ko yiɓǝi yakun ko yaɓǝi ko yasi kwɔ dǝna lo itha kwɔ <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />ko ya nung i ko ya ɗǝlak, ko ǝn ya nwa min a fǝr, ko yakwɔ dǝna kǝb pǝllǝ lo yakun ko ya nung i-yuu akun yangǝu a tǝ bǝi kwɔ Fuh lǝ yigwoi ɓǝu. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />Yakun ɓǝ manungɓǝ viikwɔ. Kwoi i ɗiggǝ nung a ɓko ɓǝng; i mko ɓǝ lǝ Fuh tthǝ; i iɓǝlǝ dang nung a ɓko i dǝɓǝ matthǝ i Fuh dang ɗuǝn Dangbang Yeso Kristi langkwoi i Ɓyang gi Fuh ɓi.<verse eid="1CO 6:11" /></para>
  <para style="s">Ɓa To nung to I Tthǝɓǝ Ɓa Dǝ Angã Lǝ Fuh</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />Yuu akun a gei angǝ, &lt;&lt;I gwabbǝm tthǝng ǝn to nung ǝndǝi.&gt;&gt; Manungɓǝ; kwoi nung ǝndǝi makwɔ ma toɓǝlǝu. Mǝn ɓuan mǝn gei gǝngǝ i gwabbǝm tthǝ ǝn to nung ǝndǝi, kwoi ǝn gwab nung akun mǝrrǝm mǝm lǝ thǝb gu. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />Yuu akun a gei angǝ, &lt;&lt;Nungtang ǝn ba wa, langkwoi wa ǝn ba nungtang.&gt;&gt; Manungɓǝ; kwoi Fuh a ɓangǝ i lǝ ǝndǝi. Tthǝ ǝn babǝ lo i yisi ko yiɓǝi lǝu, kwoi ǝn babǝ to nung to Dangbang, langkwoi Fuh a dǝ nungkwɔ tthǝ dǝna yidɗi ɓǝ. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />Fuh ǝrr lǝ Dangbang bǝ ɓui ɓua, langkwoi u ǝrr ɓilǝ i ttha gu langɓǝ.<verse eid="1CO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15" />Ɓa ibǝi kwɔ tthǝɓǝ ǝn zuggǝ tthǝ Kristi. Mǝn lǝi zuggǝ tthǝ Kristi mǝn mǝrrǝm lǝ tthǝ ya tang nǝ kwamma? Totthǝu! <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />Ko ɓa ibǝi kwɔ yuu kwɔ lo i ya tang nǝkwam yang u kun i ulǝ dang tthǝ ɓǝlǝu? Nungvullǝ ba Fuh gei kaitthǝ nǝkwam angǝ, &lt;&lt;I kwɔ rab kwɔ i mǝrǝm tthǝ kun nǝng.&gt;&gt; <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />Kwoi yuukwɔ kǝb tthǝulǝ tha i Dangbang yang u kun i ulǝ dang ɓyang lǝ.<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />Ɓa kang bǝ lo itha. Sua nung a ɓko kwɔ yuu to u to i tthǝlǝu; kwoi yuu kwɔ lo i yisi ko yiɓǝi to nung a ɓko i tthǝulǝ. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />Ɓa ibǝi kwɔ tthǝɓǝ ǝn kǝm nyǝknung gi Ɓyang a Langǝ i ɓǝlǝu, kwɔ u dang tthǝɓǝ langkwoi ǝn Fuh dǝɓǝ ɓǝlǝu? Ɓǝ ǝn aɓǝ lǝu kwoi ɓǝ ǝn a Fuh. <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />U ɗyǝab ɓǝ i nunglǝ ghaaɗing. Manungkwɔ ni yang, ɓato nung to i tthǝɓǝ ba ghaali Fuh.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">Bǝ Ɓyǝab Ba Lobǝ Dǝbtha</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />Lakwɔ, yangbǝ ǝn gwabnwa loba kwɔ ɓa vullǝ kwɔ.</para>
  <para style="p" vid="1CO 7:1">Yiɓǝi to maɗing nǝ dǝb yisi lǝu ɓǝ. <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />Kwoi bakwɔ bǝ lo itha kpaaɗing kwɔ, yaɓǝi ǝndǝi dǝb yisi, langkwoi yasi ǝndǝi dǝb yiɓǝi. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />Yiɓǝi to nung to gu lǝ siu tthǝ, langkwoi yisi to nung to gu lǝ ɓǝiu tthǝ, langkwoi i ǝndǝi to nung a langǝ i tthǝtha. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />Tthǝ yisi ǝn abo lǝu, kwoi ǝn a bǝ ɓǝiu; manungɓǝni tthǝ yiɓǝi ǝn abo lǝu, kwoi ǝn a bǝ siu. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />Bǝ ɓa ɗyǝa tthǝ ɓǝ lǝ thatthǝ, ɓa osi ɓa gwab lǝ thatthǝ lona tuab yangbǝ ɓa tǝi lona ɓa pinwa; kwoi yang ɓa kwoi lo nunglǝi bǝ dǝb tha manung a zǝǝ. Manungkwɔ ni yang ɓa la ɓǝ ɗambǝi gi Mungkullum babǝ la bǝ muo loɓǝ. <verse eid="1CO 7:5" /><verse number="6" style="v" sid="1CO 7:6" />Ən gei ɓǝ bakwɔ tthǝ yang ɓa mǝrǝm lǝ nung a thalǝu, kwɔi dǝmǝn dǝɓǝ ǝnlǝi. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />Ba a langǝ i dǝm yidɗi ɓǝ ǝndǝi ɓa ǝǝ manung abǝm; kwoi ko ǝnya ǝndǝi tthǝ i nungdǝ kwɔ Fuh duu ɓǝ, yuu a kun i duu nungdǝ akwɔ, yuu a kun a kullo.<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />Lakwɔ, ɓǝ yakwɔ ɓa dǝb yisi lǝu ɓa dǝb yiɓǝi lǝu i ya siɓui kwɔ ǝn gei gǝngǝ a ma ɓǝ tthǝ ɗing nǝɓa ɗǝb gwoi lǝu manung abǝm ɓǝ. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />Kwoi nǝ i ɓuan i muo loiu, yang ɓa dǝb tha- maɗing kwɔ ɓa dǝb tha kwɔ ɓa ǝǝnwa bǝ yidɗi bǝ lo i tha ɓǝ.<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />Ɓǝ ya dǝb tha ɓangtthǝ i bǝ zuu kwɔ ǝn abǝm lǝu ɓǝ kwoi ǝn a bǝ Dangbang ɓǝ: bǝ yisi gabtha i ɓǝiu thǝ; <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />Kwoi nǝ u yiung, u ǝǝ i nungtthǝu ko i mab ganglang gu i ɓǝiu; langkwoi yiɓǝi bǝ yina lǝ siu thǝ.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />Sua ɓǝkwɔ ǝndǝi ǝn gei gǝngǝ (Ɓang, i namlǝ, ǝn Dangbang lǝu): Nǝ yiɓǝi ya Kristǝ tthǝ i yisi kwɔ ǝnya dǝba a langǝ i tthǝ Fuh lǝu langkwoi u gwab u ǝǝ i ulǝ, bǝ u yiu na thǝ. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />Langkwoi nǝ yisi kwɔ ǝn ya Kristǝ dǝb yiɓǝi kwɔ ǝn ya dǝ ba a langǝ i tthǝ Fuh lǝu langkwoi u gwab u ǝǝ i ulǝ, bǝ yisi ɓǝ yiuna thǝ. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />Bakwɔ yiɓǝi kwɔ dǝ ba a langǝ i tthǝ Fuh lǝu kwɔ i tou Fuh a muu tthǝ bǝ kǝbtha i siu, langkwoi yisi kwɔ dǝ ba a langǝ i tthǝ Fuh lǝu kwɔ i tou Fuh a muu dang bǝ kǝbtha i ɓǝiu ya Kristǝ kwɔ. Nǝ nungkwɔ nilǝu, yathang gi ǝǝ mangǝn yathang yakwɔ i Fuh lǝu ɓǝ; kwoi lakwɔ manungkwɔ nikwɔ, Fuh gwabbǝing. <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />Kwoi nǝ yuu kwɔ dǝ ba a langǝ i tthǝ Fuh lǝu kwɔ pa, ɓa yiu tǝ. Yiɓǝi ko yisi kwɔ dǝ ba a langǝ i tthǝ Fuh kwɔ u ǝn thǝb dang nung manungkwɔ ni lǝu. Fuh lubǝiɓi ɓi ǝǝ latthǝ. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />Mǝ yisi kwɔ lǝ Kristǝ kwɔ, ato nǝnǝ a ibǝi lalangǝ i, mangǝ a ɓuan a nwong ɓǝimǝu? Ko yiɓǝi kwɔ lǝ Kristǝ kwɔ a tonǝnǝ a ilǝ bǝi lalangǝ i, mangǝ a ɓuan a nwong si mǝu?<verse eid="1CO 7:16" /></para>
  <para style="s">Ɓa Əǝ Manungkwɔ Fuh Lubǝi Ɓǝɓǝ</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />Ɓǝ ǝndǝi ɓa lilotthǝ bǝ ǝǝ gu manungkwɔ Dangbang dǝɓǝ nungdǝ guɓǝ, langkwoi manungkwɔ viikwɔ nwuni bǝ Fuh lubǝi ɓǝɓǝ. Nungkwɔ lǝ nunglǝi kwɔ ǝn nanatthǝ kǝm pinwa ǝndǝi ɓǝ. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />Nǝ yiɓǝi ya ɓǝrnwa ɗuǝ gwab bǝ lubǝi gi Fuh, bǝ u mǝrǝmlǝ yakwɔ ɓǝrnwa ɗuǝ lǝu ɓǝthǝ; nǝ yiɓǝi kwɔ ɓǝrnwa ɗuǝ lǝu kwɔ gwab bǝ lubǝi Fuh, bǝ u ɓǝrnwa ɗuǝu thǝ. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />Bakwɔ yiɓǝi ɓǝr nwa ɗuǝ ko ɓǝr nwa ɗuǝ lǝu ǝn nung a kun lǝu; bǝ to nungto i zuu gi Fuh nungɓǝ lǝ nung a langǝ i. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />Ko ǝnya ǝndǝi ǝǝ manungkwɔ viikwɔ nwuni bǝ Fuh lubǝi ɓǝ. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />Mǝ ǝn thǝb nwuni bǝ Fuh lubǝi ma? Bǝ a zi thǝ mǝ thǝ; kwoi nǝ mǝtthǝ i lǝi kwɔ ma tǝi lomǝ yang, a tolǝ nungto. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />Bakwɔ yuu kwɔ ǝn thǝb kwɔ Dangbang lubǝiu u ǝn yuu kwɔ tǝi lo ɓǝ; manungɓǝni, yiɓǝi kwɔ tǝi long kwɔ i lubǝiu u ǝn thǝb Kristi. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />Fuh ɗyǝab ɓǝ ǝn ɗyǝab; bǝ ɓa mǝrrǝm lǝ thǝb yayuu thǝ. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />Ya ǝnthǝm, ko ǝn ya ǝndǝi ǝǝ dang bǝ to nung to i Fuh lǝ nunglǝi kwɔ ɓǝ dang ǝulǝ nwuni bǝ i lubǝiɓǝ ɓǝ.<verse eid="1CO 7:24" /></para>
  <para style="s">Bǝ Ɓyǝab Ba Lo Yakwɔ Dǝbgwoi Lǝu I Ya Siɓui</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />Lakwɔ, lǝba nungkwɔ a vullǝ lǝba yakwɔ dǝb gwoi lǝu kwɔ: Ən yangǝu i zuu bǝgǝ Dangbang lǝu, kwoi ǝn dǝ ba a bǝm mangǝn yuu kwɔ Dangbang tǝmmu nyitthǝ kwɔ yayuu a gwab bagu ǝn gwab ɓǝ.<verse eid="1CO 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 7:26" />Ba ɓui kwɔ da ta lakwɔ, dǝm nhǝm gǝngǝ maɗing kwɔ yiɓǝi a ǝǝ niɓǝ. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />A dǝb yising a? Yangbǝ a ɗulǝi bǝ nannu thǝ. A dǝb yisi lǝu? Yangbǝ a ɗuu yisi thǝ. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />Kwoi nǝɓa dǝb tha yang, ɓa to nung a ɓko lǝu; langkwoi nǝ munthang a yisi dǝb gwoi, u to nung a ɓko lǝu. Kwoi yakwɔ dǝb gwoi kwɔ a tǝi lo ɓuommi kpaaɗing, langkwoi nungkwɔ dǝm yiɗi bǝ kangɓǝ tthǝ i nungɓǝ kwɔ.<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />Ya ǝnthǝm, nungkwɔ dǝm gei kwɔ, nungɓǝ lǝ: sua lona yangǝu, langkwoi baipiu lakwɔ yakwɔ dǝb yisi i to mangǝ i yangǝu i yisiu. <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />A kwɔ dǝna tasui, mangǝtǝn dang wai ɓanglǝ lǝu; yakwɔ dǝna mammam, mangǝtǝn tthǝi lalǝu; yakwɔ dǝna ɗyǝab nung, mangǝtǝn i yangǝu i nungkwɔ dǝi ɗyǝab ɓǝu; <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />yakwɔ to nungto i nung longwam, mangǝtǝn nungɓǝ lǝi dǝilǝ lǝu. Bakwɔ longwam kwɔ, lakwɔ nikwɔ, ǝǝ sua tuu tthǝu.<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />Dǝm yidɗi ɓa ilǝ loɓǝ dang bǝ nhǝm ba. Yiɓǝi kwɔ dǝb yisi lǝu dǝna dǝlo tthǝ nungto gi Dangbang, bakwɔ dǝu yidɗi bǝ tǝm dang nyi Dangbang ɓǝ. <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />Kwoi yiɓǝi kǝm dǝna dǝ kiggǝu tthǝ nung longwam, bakwɔ dǝu yiɗi bǝ tǝm lo nyi siu ɓǝ. <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />Langkwoi nungkwɔ kiggǝu gab rab. Yisi kwɔ dǝbgwoi lǝu ko munthang a yisi dǝ tthǝu lǝ nung to gi Dangbang, bakwɔ dǝu yiɗi bǝ dǝ tthǝu tthǝ langkwoi i ɓyang gu ǝndǝi; kwoi yisi dǝb gwoi dǝna dǝ tthǝu tthǝ nung longwam, bakwɔ dǝu yiɗi bǝ tǝm dang wa ɓǝiu.<verse eid="1CO 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35" />Dǝm gei nungkwɔ yangbǝ ǝn nwong ɓǝ. Dǝm yiɗi bǝ dǝ kab nwaɓǝ lǝu. Manungkwɔ niyang, dǝm yidɗi ɓa to nungkwɔ lǝ nung a langǝ i langkwoi matthǝ, langkwoi ɓa dǝ loɓǝ ǝndǝi tthǝ nungto gi Dangbang.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />Lǝba a bǝ yakwɔ gwablǝ tha tthǝ a dǝb tha kwɔ: nǝ yiɓǝi ɓǝ dǝna ɓyǝa i to matthǝu tthǝ munthang a yisi ɓǝ langkwoi nǝ ɗǝlak gu nyimɗing langkwoi dǝu ɓyǝa kaso i dǝbtha, yang i dǝbtha, manungkwɔ dǝu yidɗi ɓǝ. Nung a ɓko yangǝu dang ǝu lǝu. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />Kwoi nǝ i to yiɓǝi, i ttha to manung ɓǝlǝu, u mǝrrǝm lo nyiu nyimtthǝ angǝ i dǝb yisiu, langkwoi u ɓuan u muo lo langkwoi u mǝrrǝm lo nyiu nungkwɔ u to ɓǝ- yang u to maɗing kwɔ u la bǝ dǝb munthang a yisi ɓǝ ɓǝ. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />Nungkwɔ yang yiɓǝi kwɔ dǝb munthang a yisi ɓǝ kwɔ to maɗing, kwoi yuu kwɔ dǝb lǝu kwɔ to mapǝl.<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />Yisi dǝbgwoi tǝi lo lǝu nǝ bǝiu i nwongǝi ɓǝ; kwoi nǝ ɓǝiu ɓui, yang u tǝi long u dǝb yiɓǝi a kwɔ dǝu yidɗi ɓǝ, kwoi nǝ yiɓǝi ɓǝ ǝn Kristǝ ɓuo ɓǝ. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />U lǝtthǝla ɗing, nǝ u ǝǝ i nungtthǝu ɓǝ. Nungkwɔ lǝ ba abǝm, langkwoi nhǝm ɓang langɓǝ tthǝ i Ɓyang gi Fuh.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">Nungtang Kwɔ I Nyǝk lǝnung Tthǝ Nung Wabbǝi Ɓǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />Lakwɔ, lǝba nungkwɔ ɓa vullǝ lǝba nungtang kwɔ i nyǝklǝ nung tthǝ nung wabbǝi kwɔ.</para>
  <para style="p" vid="1CO 8:1">Ən ba a langǝ i, manungkwɔ i gei angǝ&lt;&lt;ɓi ǝndǝi tthǝ i bǝ ibǝ nung,&gt;&gt; bǝ ibǝ nungɓǝ kwɔ, dǝna fok yuu i bǝ lǝi lo; kwoi bǝ yiɗi bǝi dǝna nyimtthǝ ɓi. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />Yakwɔ dǝna nhǝm angǝ i ibǝ nungkwɔ la langǝ i i ibǝ nungɓǝ manung akwɔ kaso i ibǝi ɓǝlǝu. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />Kwoi yuu kwɔ dǝna yiɗi Fuh yang Fuh iung.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />Nungkwɔ yang, lǝ ba bǝ tang nungtang kwɔ i nyǝklǝ nung tthǝ nung wabbǝi kwɔ: ɓi ibǝi nung wabbǝi ǝn nung akun lǝu longwam; ɓi ibǝi ɓingǝ Fuh kunɗǝng ɓuo. <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />Nǝ i &lt;&lt;fuh,&gt;&gt; ɓǝtthǝ kwɔ dǝi lu kwɔ ko dang wayi ko longwam, langkwoi ko krǝ i &lt;&lt;fuh&gt;&gt; ɓǝkwɔ kpaaɗing i ya &lt;&lt;lo yigwoi,&gt;&gt; <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />yirrǝ tthǝɓi Fuh kunɗǝng ɓuo, Daa, yuu kwɔ lǝ ya mab nung ǝndǝi kwɔ dǝɓi nwong lǝ bagu ɓǝ; langkwoi Dangbang kunɗǝng ɓuo, Yeso Kristi, tthǝulǝ i mab nung ǝndǝi langkwoi tthǝulǝ dǝɓi nwong.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />Kwoi ǝn yayuu ǝndǝi i ba a langǝ i kwɔ lǝu. Yakun yirrǝ dǝna muo nung lǝi nung wabbǝi nǝ i tang i nungtang ɓǝkwɔ dǝi nhǝm ǝn nungtang gi nung wabbǝi; lo nyiǝ muanɗing, langkwoi dǝi lǝ angǝ nungtang ɓǝ ɓangǝ i lǝng. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />Kwoi nungtang gbag ɓi lǝtha i Fuh lǝu; nung yangǝu ɓanglǝ na ɓiu nǝɓi tang nungtang lǝu ɓǝ.<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />Ɓa gagci loɓǝ, bǝɓa to nung to i bǝ tǝi loɓǝ to yakwɔ tthǝi muani dang bǝ dǝnyitthǝ Fuh kwɔ o dang nung a ɓko thǝ. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />Kaso yuu kwɔ lo nyiu muanni kwɔ lo ba kwɔ nǝ ɓya, yuu kwɔ tthǝ i &lt;&lt;bǝ ibǝ nungkwɔ&gt;&gt;dǝna tang nungtang dang kǝm nyǝknung nung wabbǝi; nungkwɔ duu tthǝ nyimmi u tang nungtang kwɔ i nyǝk lǝnung tthǝ nung wabbǝi ɓǝ wa? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />Langkwoi nungkwɔ yuu kwɔ tthǝu muanni kwɔ, youngmǝ kwɔ Kristi ɓui lǝba gu kwɔ, a ɓui ba &lt;&lt;bǝ ibǝ nungmǝ&gt;&gt;! <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />Langkwoi manungkwɔ ni yang dǝmma to nung aɓau tthǝ Kristi nǝ dǝmma to nung aɓau tthǝ ya young ɓǝ ya Kristǝ ɓǝ langkwoi dǝɓa nkoni dang nyiǝ a muani. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />Nungkwɔ yang, nǝ nung tang a to ya dǝ ba a langǝ i a to nung a ɓko, ǝn tang nyam a kunnu, yangbǝ bǝ ǝn to ya dǝ ba a langǝ i tthǝ Fuh to nung a ɓko thǝ.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">Nungto Kwɔ Ya Nwatummi A To Ɓǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />Ɓang ǝn yiɓǝi ya tǝi lo lǝu? Ɓang ǝnya nwatummi lǝu? Ən ɓyǝa Yeso Dangbang ɓilǝu? Langkwoi ɓǝ ǝn nwathan nungtom lǝ Dangbang tthǝ lǝu? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />Ko kwɔ yakun gwab angǝ ɓang ǝn ya nwatummi gi Yeso lǝu, ɓaɓǝ ɓa gwabbǝng la langǝ i! Ba nwongǝi ɓǝ dang tha i Dangbang ɓǝ i naɓǝ ɓa gwab ɓangǝ ɓang ǝn ya nwatummi gi Yeso. <verse eid="1CO 9:2" /><verse number="3" style="v" sid="1CO 9:3" />Kwɔ nǝ yayuu gei ba tthǝm, dǝm gei nwam manungkwɔ ni: <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />Ən yangǝu i lǝi kwɔ i dǝm nungtang i mungki ba nungtom ma? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />Ən yangǝu i lǝi kwɔ mǝn to nungkwɔ ya nwatummi yaku to i ya young gi Dangbang i kefas, bǝ dǝb yisi kwɔ Kristǝ ǝn tǝlǝ yol wa? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />ko ǝn Barnabas i ɓanglǝ yakwɔ a to nung to nwongǝi ɓi? <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />Ən soja a nwuo a tonungto yang a kwai nungkwɔ dǝu yidɗi i nungkurɓǝ guɓa? Ya nunglǝbbi a nwuo kwɔ tang si kab zug inabi giu ɓa? Ənya gagci nungbyang a nwuo kwɔ nwa mung mi nungbyang ɓǝu ɓa?<verse eid="1CO 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8" />Ən gei nungkwɔ nǝkwam manung a bǝ thayuu lǝu, bakwɔ zuu gei manungɓǝ. <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />Ɓi than dang zuu gi Musa angǝ, &lt;&lt;Bǝ a lam nwa nyak kwɔ dǝu pǝm nung min ɓǝthǝ.&gt;&gt; Lakwɔ, Fuh dǝna to bǝlo nyak ga? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />La langǝ i dǝu gei nungkwɔ lǝn baɓi kwɔ u gei ni ɓǝlǝu? Nǝ i vullǝ ni lǝn baɓi. Yuu kwɔ ɓuob nyak langkwoi yuu kwɔ ɓǝr i to nung to gi i bǝ dǝnyitthǝ bǝ tǝi nwa abǝi dang nungmin lǝ. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />Nǝ ɓi bie nungbie ɓyang dang ɓǝ lǝ, kpaaɗing nǝɓi muo nungtǝi longwam naɓǝ lǝ ɓa? <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />Nǝ yakun tthǝ i lǝi bǝ yiɗi nungkwɔ naɓǝ, yang aɓi pǝl abǝi lǝu?</para>
  <para style="p" vid="1CO 9:12">Kwoi ɓi to nung to i lǝi ɓǝkwɔ lǝu. Manungkwɔ ni yang, ɓi tthǝb nyitthǝ nung ǝndǝi yangbǝ bǝɓi ɓanglǝ nwaba a langǝ i ba Kristi thǝ. <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />La langǝ i ɓa ibǝi yaɓǝi kwɔ dǝna to nung to dang kǝm Nyǝknung kwɔ dǝna tǝi nungtang gi dang kǝm Nyǝknung langkwoi angǝ yakwɔ dǝna nyǝknung lo tuu kwɔ dǝna tǝi nwathan nung nyǝkgǝi ɓǝ. <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />Manung ɓǝni, Dangbang gei angǝ yakwɔ dǝna gei nwaba a langǝ i kwɔ a tǝi nungtang bǝi lǝ.<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />Kwoi ǝn to nung to lǝi lǝ kwɔ lǝu, dǝm vullǝ nungkwɔ lakwɔ yangbǝ ǝn to nung to i lǝi lǝ kwɔ lǝu. Ən gwab nwa bǝ ɓuiu la nwasiu! Yuu kun yangǝu a mǝrrǝm nunglǝi kwɔ dang ba a nǝkwam! <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />Ən yangǝu i lǝi kwɔ mǝn lǝi lom bakwɔ dǝm gei nwa ba a langǝ i ɓǝ. Tthasua nung ǝndǝi, i tom lǝ ttha dǝm to nung to kwɔ. Langkwoi ɓkom tthǝ ɗing nǝ ǝn gei nwaba a langǝ i lǝu ɓǝ! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />Nǝ ǝn gei nwaba a langǝ i i bǝ yiɗim, yang dǝm yiɗi nung busoni; kwoi dǝm to ǝn nung tom, bakwɔ Fuh dǝm nung to kwɔ. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />Ən ɓǝlǝ nung busonim, tǝn? Ən tǝi lǝi mǝn gei ba gi Fuh kwɔ bǝ ɓib bǝ kwai bǝi yangǝu ɓǝ, i bǝ ɗubǝ lom dang nungtom bǝ to nung to ba gi Fuh.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />Ɓang ǝn ya tǝi lom, ǝn thǝb gi yuu a kun lǝu; kwoi ǝn mǝrrǝm lom lǝ thǝb yayuu ǝndǝi yangbǝ ǝn mǝrǝm yayuu kpaatthǝ. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />Kwɔ dǝm to nung to i ya Yahudawa, ǝn mǝrrǝm mangǝtǝn ɓang ǝnya Yahudawa yangbǝ ǝn mǝrrǝmmǝi; langkwoi ɓang i namlǝ ǝn to nung to i zuu gi Musa lǝu, ǝn mǝrǝm mangǝtǝn dǝm tolǝ nungnto kwɔ dǝm to nung to i yakwɔ dǝna tolǝ nungto ɓǝ, yangbǝ ǝn mǝrrǝmmǝi. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />Manungkwɔ ni, kwɔ dǝm to nung to i yakwɔ ǝn ya Yahudawa lǝu kwɔ, ǝn mǝrrǝm manung abǝi, ǝn yitthǝ zuu ya Yahudawa, yangbǝ ǝn mǝrrǝm yakwɔ ǝn ya Yahudawa lǝu ɓǝ. Nungkwɔ ǝǝ mangǝtǝn ǝn to nung to i zuu gi kristi lǝu; la langǝ i dǝm to nung to i zuu gi Fuh. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />Dang ya tthǝ a muanni dang bǝ dǝnyitthǝ ǝn mǝrrǝm manung abǝi. Nungkwɔ ǝn mǝrrǝmmǝi, Nungkwɔ ǝn mǝrrǝm lǝ nung ǝndǝi lǝ yayuu tthǝ, yangbǝ ǝn nwong yakun gi nunglǝi kwɔ ǝndǝi a totthǝ ǝnto ɓǝ.<verse eid="1CO 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 9:23" />Nungkwɔ ǝndǝi dǝm to lǝ ba nwaba a langǝ i, yangbǝ ǝn tǝi nwathabbu tthǝ. <verse eid="1CO 9:23" /><verse number="24" style="v" sid="1CO 9:24" />La langǝ i ɓa ibǝi kwɔ yayuu kpaatthǝ dǝna surdum pǝl tha bǝi nyimnung, kwoi ǝn yuu kun dǝna tǝi nung busoni. Ɓa sur, yang lǝ ba kwɔ ɓa tǝi nungbusɔni ɓǝ. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />Ya pǝl tha dum dǝna gwab bǝ nanung la langǝ i, dǝi to ba nungbusɔni kwɔ tǝsua tuu tthǝu ɓǝ; kwoi dǝɓi to aɓi lo nung a kwɔ laɗing ɓǝ. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />Nungkwɔ dǝm surdum juantthǝ mangǝn yuu a kwɔ dǝna yiɗi bǝ tǝi nungbusɔni ɓǝ; dǝm ɓuob vǝm mangǝn yuu a kwɔ dǝna ɓuob wa ɓǝlǝu. <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />Ən dǝ zuii lǝ tthǝm ǝn mǝrrǝmmu lǝ thǝbbǝm, yangbǝ bǝ i nannǝm tthasua kwɔ nǝ ǝn lubǝ yakun ba nung busoni yang i wamlǝtǝ.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />Ya ǝnthǝm, dǝm yidɗi ɓa nhǝm, nungkwɔ tǝi ya bǝba ɓi kwɔ muo sua Musa ɓǝ. I ǝndǝi dang bǝ nwongbǝi gi tǝi. Langkwoi i ǝndǝi pa latthǝ dang Nwam Maliya. <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />Dang tǝi langkwoi i dang nwam i ǝndǝi i wollimung i mǝrǝm lǝ ya muo sua Musa. <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />I ǝndǝi i tang nungtang ɓyang kun <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />langkwoi i nwa mungki ɓyang kun. I nwa dang ɓǝmtal ɓyang kwɔ tǝ i ilǝ ɓǝ; langkwoi ɓǝmtal ɓǝ kwɔ ǝn Kristi inko lǝ.<verse eid="1CO 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 10:5" />Kwoi kwɔ villǝ Fuh lǝ tthǝla i kpaali yakun dang ǝi lǝu, langkwoi nungkwɔ kwamɓui yǝbtha lǝi lǝ losua a kwi ǝndǝi.<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />Lakwɔ, nungkwɔ ǝndǝi ǝn nungkwɔ ɓi naɓǝ, yangbǝ ǝǝlǝ gub ɗogsui ɓi bǝɓi yidɗi nungto mungkullum thǝ, manungkwɔ i to ɓǝ,<verse eid="1CO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 10:7" />bǝ ɓi wab nung thǝ, manungkwɔ yakun dang ǝi toɓǝ. Manungkwɔ ba gi Fuh gei kwɔ angǝ,&lt;&lt;Yayuu ɓǝ ǝǝ sua bǝ to ɓang kwɔ i tang i nwa ǝrr mǝrǝm lǝ ɗǝlak min i bǝ lo itha,&gt;&gt; <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />Bǝɓi dǝ lo ɓi bǝ to nung aɓau bǝ lo itha thǝ, manungkwɔ yakun dang ǝi to ɓǝ- langkwoi vii nasi yayuu dang ǝi tthǝmsob ɓua tthǝmnu pǝmna sob ilo tthǝmnu i o i ɓui. <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />Bǝ ɓi na Dangbang thǝ, manungkwɔ yakun dang ǝi to ɓǝ-langkwoi biǝk tangǝ i i ɓui.<verse eid="1CO 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 10:10" />Bǝ ɓi ɓib ba thǝ, manung gǝ yakwɔ to-kwoi ya nwatummi ɓua ɓangǝ i lǝ bǝ.<verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />Nungkwɔ ǝndǝi tǝi yangbǝ tanatthǝ nung lǝ yakun, langkwoi i vullǝ yangbǝ ǝǝlǝ bǝ gub ɗuog sui ɓi. Bakwɔ ɓi ǝǝ dang wam kwɔ gbag bǝ thǝmung ɓǝ.<verse eid="1CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12" />Nǝ dǝma nhǝm mangǝ a dǝi nyimɗing yang a dǝ kiggǝ mǝ bǝ a owh thǝ.<verse eid="1CO 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 10:13" />Bǝ nabǝi kwɔ ǝndǝi dǝɓa tǝi kwɔ manungɓǝ vii ǝndǝi dǝna tǝi yayuu. Kwoi Fuh dǝi lo bǝ gwab nwa bagu, langkwoi Fuh gwab i naɓǝ pǝl ttha ɓǝu yangbǝ ɓa dǝi nyimtthǝ; lona kwɔ nǝ i naɓǝ, Fuh a dǝɓǝ ttha kwɔ ɓa nyim lǝ nyiɓǝ, yang langkwoi Fuh a tanatthǝ nunglǝi kwɔ ɓa ilǝ dang ǝu ɓǝ.<verse eid="1CO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />Ya ǝnthǝm, nungkwɔ yang, ɓa yitthǝ bǝ wab nung a nǝkwam.<verse eid="1CO 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 10:15" />Dǝmǝn gei ɓǝ ba mangǝn ya kiggǝ; nungkwɔ ǝn gei kwɔ ɓa to kwan lǝ loɓǝ tthǝ. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />Ɗǝithang kwɔ ɓi tolǝ nung to jibi langkwoi kwɔ ɓi kha lǝ Fuh kwɔ: ɓi nwa nung dang ǝulǝ, ǝn zii Kristi dǝɓi gab lǝ tha. Langkwoi burodi kwɔ ɓi gab dang ǝu kwɔ: kwɔ ɓi tang kwɔ, ǝn tthǝ Kristi dǝɓi gablǝtha. <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />Bakwɔ burodi ni kun, ko kwɔ ɓi kpaatthǝ, tthǝ ɓi kun, kwoi ɓi kpaaɗing. Bakwɔ ɓi ǝndǝi ɓi gab burodi kwɔ kun ɓǝ.<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />Ɓa ɓyǝa ya Israila; yakwɔ tang nungkwɔ i nyǝklǝ nung lo tuu ɓǝ i tǝi nwathan abǝi dang nung to kwɔ i tolǝ Fuh tthǝ ɓǝ. <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />Dǝm gei gǝngǝ, yang, nung wabbǝi ko nungtang kwɔ i nyǝklǝ nung kwɔ ǝn nung akuna? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />Manungɓǝni lǝu! Nungkwɔ dǝm gei kwɔ nungɓǝ lǝ nungkwɔ yakwɔ i Fuh lǝu kwɔ nyǝklǝ nung lo tuu gi i dǝlǝng wa, i dǝlǝng Fuh lǝu. Langkwoi ǝn yiɗi kwɔ bǝ ɓa tangnung lotha i wa lǝu. <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />Ɓa nwa mungki dang ɗǝithang Dangbang langkwoi ɓa nwa dang ɗǝithang wa thǝ; bǝ ɓa tangnung lo tǝbur gi Dangbang langkwoi ɓa tang lo tǝbur wa thǝ. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />Ko dǝɓi yiɗi ɓi to Dangbang a to dasi? Dǝɓi nhǝm ɓingǝ ɓi nyim ɓi pǝl Dangbang a?<verse eid="1CO 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />I gei manungkwɔni angǝ&lt;&lt;I gwab ɓi tthǝ angǝ ɓi to nung ǝndǝi,&gt;&gt; Ən ba a langǝ i, kwoi nung ǝndǝi lǝ nung a langǝ i lǝu. &lt;&lt;I gwab ɓitthǝ ɓi to nung ǝndǝi&gt;&gt;-kwoi nung ǝndǝi dǝna nwong bǝi lǝu. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />Bǝ yuu akun dang ɓǝ ɗuu lǝi bǝ to nung a langǝ i lǝ lotthǝ thǝ, kwoi lǝ ba yakun.<verse eid="1CO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25" />Ɓa tang nyam ǝndǝi kwɔ dǝi ɗyǝab lomu ɓǝ, bǝ ɓa ɓib ba lolǝ lǝba lo nyi ɓǝthǝ.<verse eid="1CO 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 10:26" />Bakwɔ, manungkwɔ nungvullǝ gei kwɔ angǝ,&lt;&lt; Longwam i nung kwɔ dang ǝu ǝndǝi kwɔ ǝn a bǝ Dangbang.&gt;&gt;<verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />Nǝ yuu kwɔ dǝba a langǝ i tthǝ Fuh lǝu kwɔ gei ɓǝ angǝ tǝɓa tang nung tang gwoi gu langkwoi a gwab ma tǝntǝ yang, a tang nungkwɔ u da angǝ a tang ɓǝ, bǝ a ɓib ba a kunthǝ ba lonyimǝ.<verse eid="1CO 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CO 10:28" />Kwoi nǝ yuu akun gei angǝ,&lt;&lt; Nungtang kwɔ i wab lǝng nung wabbi,&gt;&gt;yang bǝ a tang nungtang ɓǝ kullo thǝ, lǝ ba yuu kwɔ gei tthǝ ɓǝ langkwoi lǝ ba lo nyimǝ <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />dǝm gei gǝngǝ, ǝn ba lo nyimǝ, kwoi ǝn lo nyi yuu a kun.</para>
  <para style="p" vid="1CO 10:29">&lt;&lt;Kwoi, yang,&gt;&gt;yuu akun a ɓib angǝ,&lt;&lt;ǝn baɓǝ bǝ nhǝm bagi yuu akun a nannǝm bǝ to nung kwɔ dǝmǝn yiɗi ɓǝ? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />Nǝ ǝn kha Fuh lǝ ba nungtang ɓǝ, ǝn ba ɓǝ bǝ yuu akun a gei ba lomlǝ lǝ ba nungtang kwɔ ǝn kha Fuh lǝ bko ɓǝ?&gt;&gt;<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />Lakwɔ, nungkwɔ ǝndǝi ma to, ko a tang a nwa, a to ǝndǝi lǝ ba ghaali gi Fuh.<verse eid="1CO 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 10:32" />Bǝ a to yuu a kun o thǝ, ko ya Yahudawa i yakwɔ ǝn ya Yahudawa lǝu ko ya kǝm pinwa gi Fuh. <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />Ɓa to manungkwɔ ǝn to ɓǝ; Dǝmǝn yidɗi bǝ dǝ tthǝla lǝ yayuu dang nungkwɔ ǝndǝi dǝm toɓǝ, ǝn nhǝm ba lo nung a langǝ im mǝu, kwoi lǝ ba nung a langǝ i yayuu ǝndǝi, yang bǝ i tǝi nwongǝi.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />Ɓa na nwam, yang, manungkwɔ dǝm na nwa Kristi ɓǝ.<verse eid="1CO 11:1" /></para>
  <para style="s">Bǝ Lamlo Dangbǝ Wab Fuh</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />Dǝmǝn kha ɓǝ bakwɔ vii ǝndǝi dǝɓa nhǝmǝm langkwoi dǝɓa muo bǝ nanatthǝ nungǝm kwɔ ǝn dǝɓǝ ɓǝ. <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />Kwoi dǝmǝn yidɗi ɓa ibǝi Kristi lǝ yuu angǝ a lo yaɓǝi ǝndǝi, yiɓǝi lǝ yuu angǝ a lo siu, langkwoi ǝn Fuh lǝ yuu angǝ a lo Kristi. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />Nungkwɔ yiɓǝi kwɔ nǝ dǝna pinwa ko dǝna gei ba a tthasi dang yayuu i nung bailo lǝlo yang u dǝ tthǝkku lǝ Kristi.<verse eid="1CO 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 11:5" />Langkwoi yisi kwɔ ǝndǝi nǝ dǝna pinwa ko dǝna gei ba a tthasi dang yayuu bǝ wab Fuh nung mullo yangǝu lolǝu yang u dǝ tthǝkku lǝ ɓǝiung; yang nung akun yangǝu gab ganglang gu i yisi akwɔ i kwa lo ɓǝ.<verse eid="1CO 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 11:6" />Nǝ yisi ɓǝ mullo lǝu, yang u tǝb lo ǝn tǝb langɓǝ. Langkwoi kwɔ ǝn nung to tthǝkku kwɔ yisi a tǝb lo ko a kwa byanglo, yang u mullo.<verse eid="1CO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 11:7" />Bǝ yiɓǝi lam lo thǝ, bakwɔ u lǝ killǝng Fuh ɓǝ langkwoi i ghaali gu. Kwoi yisi lǝ ghaali gi yiɓǝi;<verse eid="1CO 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 11:8" />bakwɔ Fuh mab yiɓǝi tthǝntthǝ yisi lǝu, kwoi u mab yisi tthǝntthǝ yiɓǝi. <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />Fuh mab yiɓǝi lǝ ba yisi lǝu kwoi i mab yisi lǝn ba yiɓǝi. <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />Lǝ ba ya nwatummi gi Fuh, yang, yisi a muo lo yangbǝ tanatthǝu angǝ ɓǝiu lǝlo. <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />Nǝ ǝn a bǝ Dangbang abo, yisi ɓuan ǝǝ yiɓǝi yangǝu, langɓǝ yiɓǝi ɓuan ǝǝ yisi yangǝu. <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />Bakwɔ manungkwɔ i mab yisi tthǝn tthǝ yiɓǝi, manungɓǝ langɓǝ ǝn yisi si yiɓǝi. Kwoi nung ǝndǝi wuo bǝgǝ Fuh.<verse eid="1CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13" />Ɓa to kwan lǝ loɓǝ tthǝ ko: maɗing kwɔ yisi a pinwa tthǝ Fuh dang yayuu u lilo nǝkwam. <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />Ən baɓǝ, ba gi Fuh nanatthǝ angǝ byang kpaatthǝ lo yiɓǝi yang ǝn nung to tthǝkku, <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />kwoi lo yisi yang ǝn nung mali. Fuh duu byang lo a gonni kwɔ kpaatthǝ kwɔ ǝn nung bǝ kalo.<verse eid="1CO 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 11:16" />Kwoi nǝ yuu akun dǝna yiɗi bǝ nyimnwa bko yang, nungkwɔ mǝn gei kwɔ ko ǝn ɓi ko ǝn ya kǝm pinwa gi Fuh tthǝ i nunglǝi bǝ wab Fuh.<verse eid="1CO 11:16" /></para>
  <para style="s">Bǝ Tang Jibi Gi Dangbang (matta 26:26-29; Markus 14:22-25; Luka 22:14-20)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />Dang bǝ lak bǝi kwɔ, kwɔ lakwɔ, ǝn kha ɓǝ lǝu, bakwɔ bǝ kǝb tha ɓǝ bǝ wab nung dǝna ɓanglǝ nung pǝl bǝ mab nungɓǝ. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />La nwasiu, i geim tthǝ angǝ ya nyim nwatha tthǝ dang ɓǝ kwɔ nǝɓa kǝb tha ɓǝ; langkwoi nungkwɔ ǝn gwab ǝndǝi lǝu. <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />(Bǝ yǝrnwa yangǝu bǝ nyim nwa tha tthǝ ganglang ɓǝ yangbǝ yakwɔ dǝna to nung a langǝ i yangbǝ i ɓyǝai kaitthǝ.)<verse eid="1CO 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 11:20" />Kwɔ nǝɓa gǝmtha bǝ yikun, ǝn jibi gi Dangbang a nǝsua dǝɓa tang lǝu. <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />Bakwɔ nǝ dǝɓa tangnung tang, ko ǝn ya a lilotthǝ tang nungtang gu, bǝ i ki yuu akun thǝ yakun gwom dǝna tǝi yakun fǝr mung. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />Ɓa yangǝu i gwoi kwɔ ɓa tang ɓa nwa tthǝ ɓa? Ko dǝɓa yidɗi bǝ la ya kǝm pinwa gi Fuh ɓa dǝ tthǝkku lǝ yakwɔ nung yangǝu nai ɓa? Ən ɓǝtǝn dǝɓa yidɗi mǝn gei ɓǝtthǝ lo bakwɔ? Ən kha ɓǝ? Ən ɓuan ǝn tou! <verse eid="1CO 11:22" /><verse number="23" style="v" sid="1CO 11:23" />Bakwɔ ǝn mua bǝ nanatthǝ nungkwɔ na Dangbang kwɔ ǝn dǝɓǝ ɓǝ: angǝ Dangbang Yeso, nungvii kwɔ i ɓangǝulǝ kwɔ, u lǝi kwǝnwa burodi, <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />u kha Fuh, u gab dang ǝu, u gei angǝ,&lt;&lt; Nungkwɔ ǝn nyam tthǝm, kwɔ lǝ aɓǝ ɓǝ. Ɓa to nungkwɔ lǝ ba bǝ nhǝmǝm.&gt;&gt; <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />Manungɓǝni, tthasua nungtang u lǝi ɗǝithang ɓǝ u gei angǝ,&lt;&lt;Ɗǝithang kwɔ ǝn bǝ gwab nwa gi Fuh afu, i tthǝb i ziim. Vii kwɔ ǝndǝi dǝɓa nwamung dang ǝu, ɓato manungɓǝni yangbǝ ɓa nhǝm lǝ bam.&gt;&gt;<verse eid="1CO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26" />Nungkwɔ dǝna gei ɓǝtthǝ angǝ lona kwɔ ǝndǝi dǝɓa tang burodi kwɔ langkwoi dǝɓa nwamung dang ɗǝithang kwɔ nǝɓa nhǝm lǝ babǝ ɓuiɓua gi Dangbang nǝ u wuu ɗǝ. <verse eid="1CO 11:26" /><verse number="27" style="v" sid="1CO 11:27" />Nǝ yuu a kun tang burodi gi Dangbang ko nwa dang ɗǝithang gu nunglǝi kwɔ dǝ angǝ a lǝ Fuh lǝu yang, kwan muoɓǝ bǝ tonung aɓau tthǝ Dangbang i ziiu.<verse eid="1CO 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CO 11:28" />Nunkwɔ yang, ko ǝn ya ɓib lo nungsi, yangbǝ lakwɔ u tang burodi lang u nwa dang ɗǝithang ɓǝlǝ.<verse eid="1CO 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 11:29" />Bakwɔ nǝ ɓa ibǝ ba tthǝ Dangbang lǝu kwɔ nǝ u tang burodi langkwoi u nwa mung dang ɗǝithang lǝ, dǝna wulǝ kwan lǝ lo tthǝ kwɔ dǝu tang langkwoi dǝu nwaɓǝ. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />Nungɓǝkwɔ to yakun kpaatthǝ dang ɓǝ dǝna lo nungzii langkwoi tthǝi muan tthǝ, lakwoi yakun kpaatthǝ ɓui. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />Nǝ ɓi ɓib lo ɓi nungsi, yang kwan Fuh muo ɓiu. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />Kwoi Dangbang dǝna toɓi kwan langkwoi lak ɓi, yangbǝ bǝ i thǝb ɓi suatha i ya longwam thǝ.<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />Ya ǝnthǝm, nungkwɔ yang, kwɔ nǝɓa gǝmtha bǝ yikun bǝ tang jibi Dangbang yang, ɓa ki tha. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />Langkwoi nǝ yuu akun tthǝ gwom dǝna tǝiu, yang ɓa tangnungtang gwoi, yangbǝ bǝ kwan gi Fuh muo kwɔ dǝɓa kǝb tha bǝ yikun ɓǝ thǝ. Manung sua ba kwɔ, wumǝng mab nǝ ǝn wuu ɓǝ.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">Nungdǝ Gi Ɓyang A Langǝ i</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />Ya ǝnthǝm, lakwɔ, lǝ ba nungkwɔ ɓa vullǝ lǝ ba nungdǝ gi Ɓyang a Langǝ i kwɔ.</para>
  <para style="p" vid="1CO 12:1">Dǝmǝn yiɗi ɓa ibǝ ba a langǝ i loilǝ. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />Vii kwɔ yirrǝ ɓǝ lǝ ya wab nung kwɔ, i ɗamɓǝ nunglǝi lǝ kpaatthǝ ɓa la dǝɓa wab nung a nǝkwam kwɔ nwongǝi gi yangǝu ɓǝ. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />Dǝmǝn yiɗi ɓa ibǝi yuu yangǝu kwɔ Ɓyang gi Fuh owh lǝ si a gei angǝ&lt;&lt;A dal Yeso!&gt;&gt;Yuu yangǝu langkwoi a gei angǝ&lt;&lt;Yeso ǝn Dangbang&gt;&gt; nǝ ǝn Ɓyang a langǝ i owh lǝ si lǝu ɓǝ.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />Nungdǝ gi Ɓyang a Langǝ i nǝkun kun, kwoi Ɓyang kun dǝna dǝ.<verse eid="1CO 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 12:5" />Nunglǝi bǝ wab nung nǝkun kun, kwoi ǝn Dangbang kun ɓi ǝndǝi dǝɓi tou nung to tthǝ. <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />Nunglǝi bǝ tonungto kpaaɗing, kwoi ǝn Fuh kun ji ttha babǝ to nung to gi. <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />Ɓyang a Langǝ i tthǝ ganglang ɓi nunglǝi yakun tthǝ yuu akun yangbǝ ɓi to nung to a langǝ i lǝ ba yakun.<verse eid="1CO 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 12:8" />Ɓyang a Langǝ i dǝna dǝ yuu a kun bǝ gei ba gi Fuh i yiggǝi kpaatthǝ dang ǝulǝ, langkwoi a bǝ yuu a kun Ɓyang akun ɓǝ ǝndǝi duu bǝ gei ba ɓǝ bǝ ibǝ nung yi dang ǝu. <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />Ɓyang ɓǝ kwɔ kun kwɔ dǝna dǝ bǝ dǝnyitthǝ lǝ yuu a kun, langkwoi a bǝ yuu a kun u duu ttha bǝ dǝ tthǝla. <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />Ɓyang a Langǝ i dǝna dǝ ttha lǝ yuu a kun dǝna tolǝ nung fǝmlo; a bǝ yakun abo dǝu duu nungdǝ gei ba a tthasi; langkwoi lǝ yakun, bǝ ibǝ gab ganglang nungdǝ wuo bǝgǝ Ɓyang a Langǝ i i a kwɔ bǝgǝ ɓyang a Langǝ i lǝu ɓǝ. A bǝ yuu a kun ttha bǝ gei nwa yayol, langkwoi a bǝ yuu kun ttha bǝ gei nungkwɔ gei i nwa yayol ɓǝ. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />Kwoi Ɓyang kun langkwoi ǝn Ɓyang kwɔ dǝna to i nungkwɔ ǝndǝi; manungkwɔ dǝu yiɗi ɓǝ; dǝu dǝ nungdǝ nǝkun kun lǝ yayuu ǝndǝi.<verse eid="1CO 12:11" /></para>
  <para style="s">Tthǝ Kun I Zuggǝ Kpaatthǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />Kristi lǝ tthǝ kun, kwɔ zuggǝu kpaatthǝ ɓǝ; ǝn tthǝ kun, ko kwɔ zuggǝ ɓǝ nǝkun kun.<verse eid="1CO 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 12:13" />Nunglǝi lǝ kwɔ ǝndǝi, ɓi ǝndǝi, ko ǝnya Yahudawa ko yakwɔ ǝn ya Yahudawa lǝu kwɔ, ko ya thǝb ko ǝn ya thǝb lǝu, i wollimung dang tthǝ kun i Ɓyang kun ǝndǝi, langkwoi ɓi ǝndǝi i dǝɓi Ɓyang kun ɓi nwa. <verse eid="1CO 12:13" /><verse number="14" style="v" sid="1CO 12:14" />Bakwɔ tthǝ ɓǝ i mabbu u kun ɓuo lǝu, kwoi zuggǝu kpaaɗing. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />Nǝ bo gei angǝ,&lt;&lt; Bakwɔ ɓang ǝn na lǝu, ǝn yangǝu dang tthǝu,&gt;&gt;nungkwɔ nannu bǝ ǝǝ lǝ zuggǝ gi ɓui tthǝ lǝu. <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />Langkwoi nǝ ɗogsui a gei angǝ, &lt;&lt;Bakwɔ ɓang ǝn nung lǝu, ǝn yangǝu dang tha i ɓui tthǝu,&gt;&gt; nungkwɔ nannu bǝ ǝǝ lǝ zuggǝ gi ɓui tthǝ lǝu. <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />Nǝ ɓui tthǝ ǝndǝi ǝn nung, u tonǝnǝ u lǝ lǝbǝi? Langkwoi nǝ tthǝ ǝndǝi ǝn ɓuasui, u tonǝnǝ u gong lǝ nung? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />Manungkwɔni kwɔ, kwɔ lakwɔ, Fuh gab zuggǝ nǝkun kun tthǝ ɓui tthǝ lǝ manungkwɔ u yidɗi ɓǝ.<verse eid="1CO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 12:19" />Yang ɓui tthǝ yangǝu nǝ zuggǝ ɓǝ kun ɓuo ɓǝ! <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />Manungkwɔni kwɔ, zuggǝ ɓǝ kpaaɗing kwoi ɓui tthǝ ɓǝ kun. <verse eid="1CO 12:20" /><verse number="21" style="v" sid="1CO 12:21" />Nungkwɔ yang, nung gei lǝ natthǝ angǝ,&lt;&lt; Ən yidɗiǝ lǝu!&gt;&gt;Ko lo a gei lǝ bo tthǝ angǝ,&lt;&lt;Nikwɔ, Ən yidɗiǝ lǝu!&gt;&gt; <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />Manungɓǝni lǝu, ɓi ɓuan ɓi tonung akunu i zuggǝ tthǝ ɓi a kwɔ ǝǝ mangǝtǝn muanni ɓǝ; <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />langkwoi zuggǝ ɓi akwɔ dǝɓi nhǝm mangǝtǝn mko ǝn iɓǝ kwɔ ɓi dǝ kiggǝ tthǝ, langkwoi zuggǝ ɓi akwɔ dǝɓi ɓyǝa mko kwɔ ǝn iɓǝ kwɔ dǝɓi dǝ kiggǝ tthǝ lalangǝ i, <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />kwɔ zuggǝ akwɔ matthǝ kwɔ yidɗi lǝu ɓǝ. Fuh i nkolǝ kǝb zuggǝ tthǝ ɓǝ bǝ yikun nunglǝi kwɔ a dǝ angǝ a lǝ i zuggǝ kwɔ dǝna yidɗi ɓǝ. <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />Langkwoi nungkwɔ yang bǝ gab tha yangǝu dang tthǝ lǝu, kwoi zuggǝ kwɔ ǝndǝi dǝna ɓyǝa nungzui tha. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />Nǝ zuggǝ kun dang tthǝ dǝna to zui, sua zuggǝ ɓǝ ǝndǝi dǝna to zui i ulǝ; nǝ dǝnni kha zuggǝ akun, yang sua zuggǝ ɓǝ ǝndǝi dǝna lǝ tthǝla.<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />Ɓǝ ǝndǝi ǝn tthǝ Kristi, langkwoi ko ǝn ya ǝndǝi ǝn zuggǝ ɓǝ. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />Dang kǝm pinwa Fuh dǝ nung ǝndǝi bǝ dǝi gu: la nwasiu ya nwatummi gi Yeso, a nung rabbu ya gei ba a tthasi, a nung taiu ya nanatthǝnung; yang yakwɔ dǝna to nung fǝmlo ɓǝ, yakwɔ musuai kwɔ yakwɔ i ji ttha i dǝ tthǝla ko i nwong yakun ko i gei ba i nwa yayol.<verse eid="1CO 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 12:29" />I ǝndǝi ǝn ya nwatummi gi Yeso lǝu ko ya gei ba a tthasi ko ya nanatthǝnung. Ən yayuu ǝndǝi i ttha a to nung fǝmlo lǝu <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />ko i dǝ tthǝla lǝ ya nungzii ko i gei nwa yayol ko i mǝrrǝm nungkwɔ i gei ɓǝlǝu. <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />Ɓa dǝ lo nyi ɓǝ, langkwoi, lo nungdǝ a kwɔ ma pǝl sua yakwɔ ɓǝ.</para>
  <para style="p" vid="1CO 12:31">A langǝ i ǝndǝi, manungkwɔni, mǝn taɓǝ nunglǝi a langǝ i ǝndǝi.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">Bǝ Yidɗi Bǝi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />Nǝ mǝn ɓuan mǝn gei ba i nwa tthayuu ko i nwa ya nwatummi gi Fuh, kwoi nǝ ǝn yangǝu ibǝ yiɗi bǝiu, yang bǝ gei bam nattha i bongulong dǝnni ɓuob ko ɓui kwɔ dǝnni wab ɓǝ. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />Nǝ ɓangtthǝ i bǝ gei nwa ba a tthasi; Ɓang tthǝ i bǝ ina nung a pyǝa ǝndǝi; Ɓang tthǝ i bǝ dǝnyitthǝ kwɔ a ǝrr lǝ tal bǝ dǝi gu-kwoi nǝ ǝn yangǝu ibǝ yiɗi bǝiu yang, Ɓang ǝn nung akun lǝu. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />Nǝ mǝn dǝ nung nam ǝndǝi lǝ ya yuu, langkwoi ǝn dǝ ɓui tthǝm i lii i lua-kwoi nǝ ǝn yangǝu i bǝ yiɗi bǝiu, tom nung a langǝ i tthǝu.<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />Bǝ yiɗi bǝi ǝn bǝ tthǝb nyitthǝ langkwoi ǝn bǝ tǝm lo nyi; bǝ yiɗi bǝi to dasiu ko fog yuu langkwoi ko lǝi lo ko to lo angǝ ko;<verse eid="1CO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 13:5" />bǝ yiɗi bǝi to nung a ɓko-kiggǝ a ɓko lǝu ko bǝ yidɗi lo ko bǝ ɗuyurrǝ; bǝ yidɗi bǝi li yuu dang wako;<verse eid="1CO 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 13:6" />bǝ yiɗi bǝi lǝ tthǝla nung to mungkullum mu, kwoi dǝna lǝ tthǝla ba a langǝ i. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />Bǝ yiɗi bǝi o nǝkwam mu; langkwoi ǝn bǝ dǝnyitthǝ, ǝn bǝ tthǝb nyitthǝ, langkwoi bǝ tthǝb nyitthǝ nyim nyi.<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />Bǝ yiɗi bǝi ǝn a ɗing. Ən bǝi kwɔ bǝ gei nwa ba a tthasi tthǝɓǝ, kwoi i tthǝn tthǝm; nungdǝ bǝ gei nwa ya yol, kwoi wa thǝn thǝm; bǝ ibǝ nung tthǝ kwoi wa pǝmpa. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />Bakwɔ nungdǝ bǝ ibǝ nungɓi langkwoi bǝ gei nwa ba a tthasi tuab ɓuo;<verse eid="1CO 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 13:10" />kwoi kwɔ nungkwɔ lǝ a langǝ i wua, yang nungkwɔ lǝ a tuab kwɔ a la.<verse eid="1CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11" />Kwɔ ɓang lǝ munthang, bǝ gei bam, bǝ lǝ nung dang tthǝm, i bǝ nhǝm bam mangǝ ǝn a bǝ munthang; kwɔ lakwɔ ɓang yikku, nungkwɔ ǝn yitthǝ nunglǝi yathang.<verse eid="1CO 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 13:12" />Nungkwɔ dǝɓi ɓyǝa lakwɔ mangǝ thǝn dang nungɓyǝa dang nung kailǝ kaiu; yang wuɓi ɓyǝa i nung ɓi lǝ. Nungkwɔ ǝn ibǝi lakwɔ kailǝ kaiu; yang mǝn ibǝi kaitthǝ-kaitthǝ manungkwɔ Fuh im ǝndǝi ɓǝ.<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />Dangǝulǝ ǝndǝi nungkwɔ tai kwɔ ǝǝtthǝ: bǝ dǝ ba a langǝ i tthǝ, i bǝ dǝ nyi tthǝ nung, i bǝ yiɗi bǝi; langkwoi dang ǝulǝ ǝndǝi bǝ yiɗi bǝi lǝ angǝ a.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">Nungdǝ Gi Ɓyang A Langǝ i</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />Ən bǝ yiɗi bǝi, yang, ɓa dǝ tthǝ ɓǝ tthǝ ɓa ɗuu. Ɓa dǝ nyi ɓǝ tthǝ nungdǝ gi ɓyang, nyimiu ǝndǝi nung dǝ bǝ gei ba a tthasi.<verse eid="1CO 14:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 14:2" />Yakwɔ dǝna gei ba i nwa yayol kwɔ dǝnni gei lǝn yakun tthǝ lǝu kwoi lǝn Fuh tthǝ, bakwɔ yuu akun yangǝu dǝna ibǝi nungkwɔ dǝi gei ɓǝu. Dǝnni gei ba a langǝ i a bǝ pyǝa i ttha Ɓyang. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />Kwoi yakwɔ dǝna gei ba a tthasi kwɔ dǝnni gei ba lǝn yayuu tthǝ yangkwoi i nwongǝi lǝ, ji tthǝnyimmi, langkwoi i tǝm tthǝi. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />Yakwɔ dǝna gei ba a tthasi i nwa yayol dǝna nwong ǝn loi inailǝ, kwoi yakwɔ dǝna gei ba gi Fuh kwɔ dǝnni nwong ǝn ya kǝm pinwa ǝndǝi. <verse eid="1CO 14:4" /><verse number="5" style="v" sid="1CO 14:5" />Dǝmǝn yiɗi ɓǝ ǝndǝi ɓa gei ba i nwa yayol, kwoi dǝm yiɗi kaso ɓǝtthǝ i nungdǝ bǝ gei ba Fuh. Bakwɔ yuu kwɔ dǝna gei ba Fuh nwa ba a tthasi yang nung to gu ghaa pǝl yuu kwɔ dǝna gei nwa ya yol ɓǝ-nǝ yuu akun tthǝ dǝna gei nwa ba dǝna mǝrrǝm nwa ya yol lǝ ɓǝ, yangbǝ ba gu nwong ya kǝm pinwa ɓǝ<verse eid="1CO 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6" />Ya ǝnthǝm, lakwɔ yang, nǝ ǝn wua tthang ɓǝ, ǝn ɓǝ lǝ nung a langǝ i nǝ dǝmǝn gei ɓǝ ba i nwa yayol? Ko tuab mko, nǝ ǝn taɓǝ natthǝnung bǝgǝ Fuh ko bǝ ibǝ nung ko bǝ gei ba gi Fuh la nyimmi ko bǝ nanatthǝnung.<verse eid="1CO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 14:7" />Ɓa lǝi nung lub ɓyǝan kwɔ nwongǝi gi yangǝu kwɔ mangǝ i nung i ɓii i molo yuu a tonǝnǝ a ibǝ yollu kwɔ dǝnni ɓuob lǝɓǝ nǝ i ɓuob nǝkun kun ɗa? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />Langkwoi nǝ yuu kwɔ dǝna ɓi naduri nǝ u ɓi kaitthǝ lǝu, ǝnya a mabzuii ɓui? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />Manungɓǝ ni, yuu ato nǝnǝ a ibǝ nungkwɔ dǝɓa gei nǝ baɓǝ dǝɓa gei i nwa yayol kwɔ kailǝ kai lǝu ɓa? Ba ɓǝ a pa dang waa!<verse eid="1CO 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 14:10" />Nwa kpaaɗing longwam, akun yangǝu dang ǝu kwɔ i ibǝiu ɓǝ.<verse eid="1CO 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 14:11" />Kwoi nǝ ǝn ibǝ nwa kwɔ dǝnni gei ɓǝlǝu, yakwɔ dǝna gei kwɔ yang i ǝn yayol tthǝmlǝ langkwoi ɓang ǝn yayol tthǝilǝ.<verse eid="1CO 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 14:12" />Kwɔ dǝ ɓa yiɗi nungdǝ gi Ɓyang, ɓa ɗuong nungɓǝ lo nung ǝndǝi ɓa to nung to i yakwɔ dǝna nwong ɓǝ ɓa mai lǝ kǝm pinwa ɓǝ.<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />Nǝ yuu kwɔ dǝna gei ba i nwa yayol, yang, u pinwa lo ba nungkwɔ nǝ u mǝrǝm nung kwɔ i gei ɓǝ.<verse eid="1CO 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 14:14" />Bakwɔ nǝ dǝm pinwa i nwa yayol kwɔ, ɓyangǝm dǝna pinwa la langǝ i, kwoi lo nyim yangǝu dang ǝu.<verse eid="1CO 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 14:15" />Ən ɓǝttǝn mǝn to, lakwɔ? Mǝn pinwa i ɓyangǝm lǝ, kwoi mǝn pinwa i lonyim lǝ; Mǝn lub ɓin i ɓyangǝm lǝ, kwoi langkwoi mǝn lub ɓin i lonyim lǝ. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />Kwɔ nǝ dǝma kha Fuh dang ɓyang ɓuo, yayuu a nǝkwam dang ɓǝ kwɔ a gwab nwa angǝ&lt;&lt; Dǝitthǝ manungɓǝ&gt;&gt;tthǝ bǝ pinwa kha Fuh? I yangǝu i nunglǝi kwɔ i ibǝ nungkwɔ dǝɓa gei ɓǝu.<verse eid="1CO 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 14:17" />Ko nǝ bǝ pinwa bǝ kha Fuh mǝ tthǝ Fuh ǝn a langǝ i, a nwong yakun lǝu.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />Dǝmǝn kha Fuh kwɔ dǝmǝn gei ba i nwa yayol kwɔ ǝn pǝl ɓǝ ǝndǝi ɓǝ. <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />Kwoi dang bǝ wab Fuh mǝn gei ba ni nu kwɔ yayuu a ibǝi ɓǝ, kwɔ yangbǝ ǝn nanatthǝ nung lǝ yayuu, lo akwɔ mǝn gei ba tthǝmsob ɓua tthǝmrab pǝmna sop i nwa yayol ɓǝ.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />Ya ǝnthǝm, bǝ ɓa ǝǝ lǝ nwa yathang dang bǝ nhǝm ba thǝ; lǝ ba mungkullum yang ɓa ǝǝ lǝ yathang a ɓoi, kwoi bǝ nhǝm baɓǝ ǝǝ yakku. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />Dang ba gi Fuh i vullǝ angǝ,</para>
  <para style="q1" vid="1CO 14:21">&lt;&lt;Lǝ ba yayuu kwɔ dǝna gei nwa yayol</para>
  <para style="q2" vid="1CO 14:21">Dangbang gei angǝ, mǝn gei ba lǝ yayuum.</para>
  <para style="q1" vid="1CO 14:21">Mǝn gei ba i nwa yayol,</para>
  <para style="q2" vid="1CO 14:21">kwoi aɓǝ kullo yayuum lǝmmu&gt;&gt;<verse eid="1CO 14:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="1CO 14:22" />Nungkwɔ yang, nungdǝ bǝ gei ba i nwa yayol ǝn nungkwɔ yakwɔ dǝ ba a langǝ i tthǝ Fuh lǝu a ɓyǝa ɓǝ, kwoi nungdǝ bǝ gei ba gi Fuh i nungkwɔ yakwɔ dǝba a langǝ i tthǝ Fuh ɓǝ a ɓyǝa ɓǝ, ǝn a bǝ yakwɔ dǝ ba a langǝ i tthǝ Fuh ɓǝ lǝu.<verse eid="1CO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23" />Nǝ, ya kǝm pinwa ǝndǝi wuu kǝptha ko ǝn yiǝ ǝndǝi baipi bǝ gei nwa yayol-yang ko yuu akun nǝkwam ko yakwɔ ǝnya dǝ ba a langǝ i tthǝ Fuh lǝu tǝ dang kǝm ɓǝ, yang i gei angǝ ɓǝ ǝn ya nunglo wa?<verse eid="1CO 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 14:24" />Kwoi nǝ yayuu ǝndǝi dǝna gei ba a tthasi nǝ yakwɔ ǝn ya dǝ ba a langǝ i tthǝ Fuh lǝu ko ya nǝkwam tǝ dang kǝm ɓǝ, yang kiggǝi a mǝrrǝm i yitthǝ nung a ɓko gi lǝ bakwɔ i lǝ ɓǝ. Nungkwɔ ǝndǝi ilǝ kwɔ a toi kwan tthǝ, <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />bǝ nhǝm ba gi kwɔ a pyǝa kwɔ a igwam, yang langkwoi i bainwa longǝi sua i wab Fuh, i gei nung a ɓko gi,&lt;&lt;Angǝ ǝn ba a langǝ i Fuh tthǝ dang ɓǝ!&gt;&gt;<verse eid="1CO 14:25" /></para>
  <para style="s">Ɓato Nung Əndǝi Lo Zuiiu Kǝm Pinwa</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />Ya ǝnthǝm, ǝn ɓǝtǝn ɓi gei, Nǝ ɓa kǝptha bǝ wab Fuh, yuu kun tthǝ i ɓin, yuu akun dǝna nanatthǝ nung, yuu akun dǝna gei ba gi Fuh, yuu akun dǝna gei ba i nwa yayol, yang langkwoi yuu akun dǝna mǝrǝm ba ɓǝ dǝnni gei ɓǝ. Nung kwɔ ǝndǝi a nwong ya kǝm pinwa. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />Nǝ yuu akun a tǝbǝ gei ba i nwa yayol, yayuu rab ko tai ɓuo kwɔ a gei ɓǝ, i gei nǝkun kun, yang yuu akun a mǝrǝm nungkwɔ dǝnni gei ɓǝ.<verse eid="1CO 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CO 14:28" />Kwoi nǝ yuu akun yangǝu bǝi lǝu a mǝrrǝm ba ɓǝu yang, lakwɔ yuu kwɔ dǝna gei nwa yayol ɓǝ kǝrnwa nǝkwam yang u gei balǝ lotthǝ i Fuh lǝ. <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />Ya gei ba a tthasi kwɔ rab ko tai kwɔ i ji ba gi Fuh kwɔ yang gei ba, yang sua yakwɔ a to kwan lo nung kwɔ i gei ɓǝ.<verse eid="1CO 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1CO 14:30" />Kwoi nǝ yuu akun kwɔ ǝǝ bǝ gǝmtha ɓǝlǝ kwɔ muo ba bǝgǝ Fuh yang, yuukwɔ dǝna gei bakwɔ kǝr. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />Ɓǝ kwɔ ǝndǝi lko ɓa ɓuan ɓa gei ba a tthasi, nǝkun kun, yangbǝ yuu akun a na yang langkwoi a duu tthǝnyimmi.<verse eid="1CO 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 14:32" />Nungdǝ bǝ gei ba gi Fuh tthǝn tthasua yuu kwɔ dǝna gei ba a tthasi ɓǝ, <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />bakwɔ Fuh yiɗi ɓi yǝbtha nǝkwam lǝu kwoi dǝu yiɗi ɓi ǝǝ dang bǝ kǝptha lo i tthǝla.</para>
  <para style="p" vid="1CO 14:33">Manungkwɔ kǝm pinwa yayuu gi Fuh ɓǝ, <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />yasi a kǝr nwa nǝkwam dang kǝm kǝbtha ɓǝlǝ. I gwabbǝi tthǝ i gei ba lǝu; manungkwɔ zuu ya Yahudawa gei ɓǝ, i to yikku lo yayuu. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />Nǝ dǝnni yiɗi bǝ ɓib ba lo nung akun yang, i ɓib yaɓǝi gi gwoi. Ən nung to tthǝkku kwɔ yisi a gei ba dang kǝm pinwa bǝ kǝb tha ɓǝ.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />Ko bagi Fuh baipiu tthǝn loɓa? Ko wung sua ɓǝ ɓuo i nung tthǝɓǝ?<verse eid="1CO 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1CO 14:37" />Nǝ yuu akun dǝna nhǝm angǝ i ǝn ya gei ba a tthasi ko i ji nungdǝ gi ɓyang, yang u ibǝi nungkwɔ dǝmǝn vullǝ kwɔ ǝn ba gi Dangbang.<verse eid="1CO 14:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CO 14:38" />Kwoi nǝ u la bakwɔ, yang Fuh a lko langɓǝ.<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />Ya ǝnthǝm, nungkwɔ yang, ɓa dǝ nyi ɓǝ tthǝ bǝ gei ba a tthasi, kwoi bǝɓa la bǝ gei ba i nwa yayol thǝ.<verse eid="1CO 14:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 14:40" />Ɓa to nung ǝndǝi nunglǝi lozuiiu.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">Bǝ Ərr Gi Kristi Bǝ Ɓuiɓua</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />Ya ǝnthǝm, lakwɔ dǝmǝn yidɗi bǝ owh ɓǝ nyitthǝ, lo nwaba a langǝ i gi Fuh kwɔ dǝm gei ɓǝtthǝ ɓǝ, kwɔ ɓa mua ɓǝ, kwɔ langkwoi bǝ dǝnyi tthǝ ɓǝ dǝi loɓǝ.<verse eid="1CO 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 15:2" />Nungɓǝlǝ nwaba a langǝ i, bakwɔ ǝn gei ɓǝ tthǝ ɓǝ. Ɓa tǝi nwongǝi lǝ ba baɓǝ kwɔ nǝɓa mua nyimtthǝ ɓǝ-nǝ ɓa dǝba a langǝ i tthǝ baɓǝ lǝ ǝn ba nung akun lǝu ɓǝ.<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />Ən dǝ ɓǝ nungkwɔ ǝn muo ɓǝ, ǝn ba angǝ a kwɔ ǝn gei ɓǝ tthǝ ɓǝ: angǝ Kristi ɓui lǝ ba nung a ɓko ɓi, kwɔ i vullǝ dang nungvullǝ ba gi Fuh; <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />angǝ i suu langkwoi Fuh ǝrrǝu lǝ i nwongǝi gu dang bo tai, manungkwɔ i vullǝ dang nungvullǝ ba gi Fuh ɓǝ; <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />angǝ u fug tthǝ kefas langkwoi yang i sua ya nwatummi gu sob iu rab.<verse eid="1CO 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 15:6" />Yang u fugtthǝ ya muo suko pa tthǝmsob ɓua rab ilo tthǝmnu dang lona kun, yayuu dang ǝi kpaatthǝ tthǝ i nwongǝi, yakun osi ɓuing.<verse eid="1CO 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 15:7" />Yang u fuktthǝ Yakubu, yang langkwoi tthasua nungkwɔ kǝb tha i sua ya nwatummi gu.<verse eid="1CO 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8" />Tthasua ǝndǝi u fuk tthǝm lǝ- ɓang kwɔ bǝ sim nunglǝi a langǝ i lǝu ɓǝ. <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" />Bakwɔ ɓang ǝn a tuab dang ya nwatummi gu ǝndǝi ɓǝ- Ɓang kwɔ ǝn natthǝ kwɔ i lub bǝim lǝ ya nwatummi gu lǝu ɓǝ, bakwɔ ǝn dǝ zui lǝ ya kǝm pinwa lǝ ba Fuh ǝn ji tthasi. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />Kwoi i nung to a langǝ i gi Fuh, langkwoi i nung a langǝ i kwɔ u dǝm kwɔ ǝn nung a nǝkwam lǝu. Nilǝu, ǝn to nung to ɗing pǝl sua ya nwatummi kwɔ ǝndǝi, ǝn ɓang lǝu, kwoi nung a langǝ i Fuh dǝna to nung to i ɓanglǝ, tthǝn tthǝ tthǝnyimmi gi Fuh nungkwɔ ɓang lakwɔ ǝn ǝǝ ni ɓǝ. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />Nungkwɔ yang, ko wuo tthǝn tthǝm ko tthǝi, ǝn nungɓǝ ǝndǝi dǝɓi gei, langkwoi ǝn nungɓǝ kwɔ ɓa dǝ ba a langǝ i tthǝ ɓǝ.<verse eid="1CO 15:11" /></para>
  <para style="s">Bǝ Ərr Ɓi Bǝ Ɓuiɓua</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />Lakwɔ, bǝ nwaba ɓi angǝ Fuh ǝrrlǝ Kristi bǝ ɓuiɓua lǝ, ǝn ba ɓǝ bǝ yakun dang ɓǝ gei angǝ i ǝrrlǝ yayuu bǝ ɓuiɓua i nwongǝi gi wa?<verse eid="1CO 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 15:13" />Nǝ ǝn ba langǝ i, yang lang Fuh ǝrr lǝ Yeso kristi i nwongǝi lǝu;<verse eid="1CO 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 15:14" />langkwoi nǝ Fuh ǝrr lǝ yeso Kristi bǝ ɓui ɓua lǝu, yang ɓi yangǝu i bakwɔ ɓi gei ɓǝu yang ɓa yangǝu i nung kwɔ ɓa dǝ ba a langǝ i tthǝ ɓǝu.<verse eid="1CO 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 15:15" />Pǝl nung kullong, yang dǝɓi kǝb pǝllǝ i ba gi Fuh, bakwɔ ɓi gei ɓiingǝ Fuh ǝrr lǝ yeso Kristi bǝ ɓuiɓua ɓǝ- kwoi nǝ ǝn ba a langǝ i i ǝrlǝ ya ɓuiɓua i nwongǝi gi lǝu, yang Fuh ǝrrlǝ Kristi lǝu. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />Nǝ yakwɔ ɓuiɓua kwɔ nǝ ǝrrǝu, yang Kristi ma ǝrr lǝu lang ɓǝ. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />Yang nǝ Kristi ǝrr lǝu bǝ ɓui ɓua, yang bǝ dǝ ba a langǝ i ɓǝ ǝn nung a nǝkwam yang yirrǝ ɓa lǝnla dang nung a ɓko ɓǝ. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />Yang ǝǝ mangǝ yakwɔ dǝba a langǝ i tthǝ Kristi kwoi i ɓuiɓua kwɔ i laang. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />Nǝ bǝ dǝ nyi ɓitthǝ Kristi ǝn ba nwongǝi kwɔ ɓuo, yang ɓi ǝn ya zuii pǝl sua yayuu ǝndǝi longwam.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />Kwoi ba a langǝ i nungɓǝ lǝ Fuh ǝrr lǝ Kristi dang ɓua lǝng, kwɔ lǝ ba a langǝ i i gei angǝ yakwɔ ɓui kwɔ lang ɓǝ Fuh a ǝrrǝi lǝ ɓua.<verse eid="1CO 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 15:21" />Kwoi nǝ bǝ ɓui ɓua wuu tthǝn tthǝ thayuu, langkwoi bǝ ǝrr ɓua a wua tthǝn tthǝ yuu.<verse eid="1CO 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 15:22" />Kwoi manungkwɔ yayuu ɓui ɓua ǝn ba bǝ kǝptha i Adamu, manungɓǝni yayuu ǝndǝi a ǝrr i nwongǝi gi lǝ ba bǝ kǝptha gi i Kristi. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />Kwoi ko ǝnya ǝrrǝulǝ lo lǝi a langǝ i: Kristi, nwasiu ǝndǝi; yang, lona bǝ wua gu, yang yakwɔ ǝn abo ɓǝ a ǝrr.<verse eid="1CO 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 15:24" />Yang bǝ thǝm gi longwam a wua; Kristi a dǝi lǝ yikku lo yakku ya ɓyang, tthǝ nyimmi, i ttha, yang u kwoi lǝ bǝ lo yigwoi ɓǝ u dǝlǝ Fuh kwɔ lǝ Daa ɓǝ. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />Bakwɔ Kristi a lo yigwoi tǝlǝ vii kwɔ Fuh wa yǝb ya ɓui gi Kristi nǝ ɓyǝa suai ɗǝ.<verse eid="1CO 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 15:26" />Ya ɓui ɓi a nǝsua kwɔ Kristi a thǝu kwɔ nungɓǝ lǝ ɓua. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />Bakwɔ nungvullǝ ba Fuh gei angǝ,&lt;&lt;Fuh dǝ nung ǝndǝi dǝi ɗǝg siu.&gt;&gt; Kaiɗing, manungɓǝni, bakwɔ angǝ&lt;&lt;nung ǝndǝi&gt;&gt;ba tǝllǝ Fuh dang ǝu naulǝ thǝ, Kristi lo nung ǝndǝi. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />Kwoi kwɔ nung ǝndǝi i dǝ dang na bǝ lo yigwoi gi Kristi, kwoi u i naulǝ, kwɔ lǝ Yui kwɔ, a dǝ lo tthasi Fuh, kwɔ dǝ nung ǝndǝi tthasiu ɓǝ; yang Fuh a lo yigwoi loi lǝ ǝndǝi.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />Lakwɔ, nǝ bǝ ǝrrǝu bǝ ɓui ɓua yang u to nǝnǝ ba a bǝ yakwɔ i wollimung ɓua ɓa? Ən ɓǝttǝn i dǝnyitthǝ bǝ tǝiu? Nǝ ǝn ba a langǝ i, manungkwɔ yakun dang ɓǝ dǝna lǝi kwɔ, angǝ i ǝrrl ǝ ya ɓui ɓua i ji nwongǝi lǝu, ǝn baɓǝ bǝ i wollmung lǝ yayuu ba ya ɓui ɓua? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />Langkwoi lǝ ba aɓi ǝn baɓǝ bǝ dǝɓi ɗuu ɓua lǝ loɓi tthǝ lona lǝ ǝndǝi?<verse eid="1CO 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 15:31" />Ya ǝnthǝm, dǝmǝn ɓyǝa ɓua vii ǝndǝi! Dǝm tǝi ghaali tthǝɓǝ lǝ, dang tthǝɓi dang tha i Kristi Yeso Dangbang ɓi, tom ǝn gei nungkwɔ. <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />Nǝ manungkwɔ, ǝnto, &lt;&lt;ǝn ɓuob vǝm i nyam dang gug&gt;&gt; bǝi kwɔ dang Afisa lǝ ba gi yuu, ǝn ɓǝtǝn ǝn tǝi? Kwoi nǝ i ǝrr lǝ ya ɓui ɓua dang ɓua i tǝi nwongǝi lǝu, yang, manungkwɔ i gei kwɔ, &lt;&lt;Ɓi tang ɓi nwa, bakwɔ bung ɓi ɓui ǝn ɓui ɓǝ.&gt;&gt;<verse eid="1CO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />Bǝ i ɗamɓǝ thǝ, &lt;&lt;Yayuu a ɓko dǝna ɓanglǝ yuu a langǝ i,&gt;&gt;<verse eid="1CO 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CO 15:34" />Ɓa kwoi ɓa wuu dang kiggǝ ɓǝ ɓa yitthǝ nung lǝi a ɓko. Ən gei bakwɔ yangbǝ ɓalǝ tthǝkku yakun dang ɓǝ i Fuh lǝu.<verse eid="1CO 15:34" /></para>
  <para style="s">Tthǝ Kwɔ Ɓi Wulǝ Nǝɓi Ərr Bǝ Ɓuiɓua Ɓǝ</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />Yuu akun a ɓib angǝ,&lt;&lt;Nǝnǝ yuu kwɔ ɓuiɓua a ǝrr a tǝi nwongǝi&gt;&gt;? Ən tthǝ a nwuo i wulǝ?&gt;&gt; <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />Ɓǝ ya sullǝ! Nǝ ɓa bie nung pangsua, nǝ ɓui ɗǝ yangbǝ ǝrr i nwongǝi.<verse eid="1CO 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1CO 15:37" />Langkwoi nungbie kwɔ ɓa bie kwɔ ǝn bie tthǝ nung a nǝkwam, lko ǝn nungkyang ko ǝn nungnung akun, ǝn bie nungkwɔ ɓa bie ǝn nungɓǝ a ghaa lǝu.<verse eid="1CO 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CO 15:38" />Fuh a dǝ tthǝ kwɔ u yiɗi lǝ nungbie ɓǝ; Fuh a dǝtthǝ lǝ nungbie anwɔ dǝi kwɔ la langǝ i ɓǝ.<verse eid="1CO 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39" />Langkwoi nyamtthǝ nungkwɔ dǝna nwong kwɔ ǝndǝi natha lǝu; nyam tthǝ tthayuu i nungtthǝu, nyam nungbyang natha, a nurug nattha, kwoi a bǝ tthǝng natha.<verse eid="1CO 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40" />Langkwoi tthǝ ya wayi tthǝ langkwoi ya pangsua tthǝ; mali kwɔtthǝ tthǝ a wayi kwɔ natha i mali a akwɔ ǝn a pangsua ɓǝlǝu.<verse eid="1CO 15:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CO 15:41" />Fuh adu tthǝ i mali gu, fiǝ tthǝ i mali gu, langwoi vin i mali gu; lang dang gi vin mali gi tthǝ nǝkun kun.<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />Manungɓǝni a ǝǝ nǝ i ǝrrlǝ yakwɔ ɓuiɓua i wuilǝ bǝ nwongǝi ɓǝ. Nǝ i suu kwamɓui yuu, ǝn tthǝ kwɔ a ɓumɓui ɓǝ; nǝ ǝrr yang, zuu a kunnu.<verse eid="1CO 15:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CO 15:43" />Nǝ i suu, yang ɓkotthǝ langkwoi muan tthǝ, nǝ ǝrr yang, matthǝ langkwoi nyimtthǝ. <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />Kwɔ nǝ i suu, yang ǝn tthǝ a kwɔ yuu a ɓyǝa ɓǝ; langkwoi nǝ ǝrr, yang ǝn tthǝ ɓyang. Nǝ Tthǝ a kwɔ yuu a ɓyǝa kwɔ nǝtthǝ, yang tthǝ ɓyang tthǝ langɓǝ.<verse eid="1CO 15:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="1CO 15:45" />Ba gi Fuh gei angǝ,&lt;&lt;Yiɓǝi a nungsi, Adamu, Fuh mabbu i nwongǝi&gt;&gt;; kwoi Adamu a nǝsua ǝn Ɓyang kwɔ dǝna dǝ nwongǝi ɓǝ. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />Ən ɓyang wuo nungsi lǝu, kwoi a yuu osi, nwuni bǝ a ɓyang. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />Adamu a nungsi, i mabbu i sua, u i tthǝn pangsua; Adamu a rab kwɔ lǝ Yeso kwɔ wua wayi. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />Yakwɔ ǝn a pangsua natha i ya kwɔ i mabbǝi i sua ɓǝ; yakwɔ ǝnya wayi kwɔ i mangǝ ǝn yakwɔ wua wayi ɓǝ.<verse eid="1CO 15:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="1CO 15:49" />Manungkwɔ ɓi lǝitthǝ yiɓǝi kwɔ i mab i sua kwɔ, lang manungɓǝni ɓi lǝi tthǝ Yiɓǝi kwɔ wuo wayi ɓǝ.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />Ya ǝnthǝm, nungkwɔ dǝmǝn gei kwɔ nungɓǝ lǝ, gǝngǝ nungkwɔ i mab i nyam i zii tǝi bǝi kwɔ Fuh lǝ Yigwoi ɓǝu, langkwoi tthǝ kwɔ a ɓui ǝn ɓui kwɔ ɓuan tǝi tthǝ akwɔ ɓuiu ɓǝ.<verse eid="1CO 15:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51" />Ɓa lǝ ba langǝ i kwɔ pimpyǝa ɓǝ: ɓi ǝndǝi ɓi ɓuiu, Kwoi nǝ i ɓiɓi a nǝsua, yang dang tthǝ i mǝrǝm ɓi- <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />thǝmtthǝ, mangǝ bǝ kam nung. Kwɔ nǝ i ɓii ɓii, i ǝrr lǝ ya ɓui ɓua kwɔ, i ɓui a kunnu, yang i mǝrrǝm ɓi ǝndǝi. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />Bakwɔ nungkwɔ a ɓui ǝn ɓui kwɔ i mǝrǝmu lǝ nung akwɔ ɓuiu ɓǝ; nunkwɔ ɓuiu kwɔ i mǝrǝmu lǝ nungkwɔ ɓuiu ɓǝ. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />Kwɔ nǝ nungkwɔ a to nungtthǝ, nǝ nungkwɔ a ɓui ǝn ɓui kwɔ i mǝrǝmu lǝ nungkwɔ ɓui kwɔ, yang ba gi Fuh a ǝǝlǝ ba a langǝ i:&lt;&lt;Fuh a thǝb ɓua; dang bǝ tang lo al long!&gt;&gt;<verse eid="1CO 15:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55" />&lt;&lt;Bǝ tang lo mǝ, pǝlla ɓua?</para>
  <para style="q1" vid="1CO 15:55">Ttha bǝto, nungzi bǝimǝ pǝlla ɓua?&gt;&gt;<verse eid="1CO 15:55" /></para>
  <para style="m">
    <verse number="56" style="v" sid="1CO 15:56" />Ɓua tǝi ttha kwɔ a to nungzii bǝi lǝ yuu kwɔ tthǝn tthǝ nung a ɓko, langkwoi nung a ɓko tǝi ttha tthǝ zuu.<verse eid="1CO 15:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="1CO 15:57" />Kwoi bǝ khabǝi ǝn a bǝ Fuh kwɔ dǝɓi bǝ tang lo tthǝ Dangbang ɓi Yeso Kristi ɓǝ!<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />Ya ǝnthǝm nungkwɔ yang, ɓa dǝi nyimtthǝ. Ɓa to nung to vii ǝndǝi lǝ ba Dangbang, ɓa ibǝi nung yangǝu kwɔ ɓa to dang nung to gi Dangbang kwɔ a thǝm nǝkwam ɓǝ.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">Bǝ Gǝmnung Ba Ya Muo Sua Fuh</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />Lakwɔ, ba nungvullǝ kwɔ ɓa vullǝ ba nungkurɓǝ kwɔ ɓa gǝm yang bǝ ɓa nwong lǝ yayuu gi Fuh dang Yahudiya. Ɓa to manung kwɔ ǝn gei ɓǝtthǝ ya kǝm pinwa Galatiya gǝngǝ i to ɓǝ. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />Vii wab Fuh ya Kristǝ ǝndǝi ko ǝn ya dang ɓǝ baipi bǝ gǝm nungkurɓǝ, natha i nungkwɔ dǝma tǝi ɓǝ, yang pyǝa, yang babǝ gǝm nungkurɓǝ yangǝu nǝ ǝn wua ɓǝ.<verse eid="1CO 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 16:3" />Tthasua kwɔ nǝ ǝn wuo, yang mǝn dǝ nungvullǝ lo yakwɔ ɓa gwabtha i ilǝng ɓǝ, yang ɓi tummǝi i tǝlǝ nungkwɔ ɓa gǝm kwɔ lǝ Urshalima. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />Nǝ maɗing kwɔ mǝn tǝɓǝ, yang i ɓuan i tǝ suatha i ɓang.<verse eid="1CO 16:4" /></para>
  <para style="s">Bǝ Mab Zuii Bǝtǝ Yol Gi Bulus</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />Mǝn tǝ suaɓǝ tthasua kwɔ nǝn mǝrǝm Makidoniya ɓǝ-bakwɔ mǝn mǝrrǝm tthǝn Makidoniya ɓǝ. <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />Lko yakun mǝn ǝǝ i ɓǝlǝ sua tutthǝ, ko ǝn i kong i ɓǝ, yang ɓa nwongǝm dang bǝ thko thkom, ba bǝi kwɔ mǝn tǝ tthasi ɓǝ. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />Ən yiɗi kwɔ mǝn dǝi nǝbo ǝn ɓyǝa ɓǝ ǝn pa lǝu; Dǝmǝn yiɗi bǝ ǝǝ i ɓǝ sua tuu tthǝ, nǝ Dangbang gwabǝm tthǝɓǝ.<verse eid="1CO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8" />Mǝn ǝǝ i ɓǝlǝ dang Afisa tǝllǝ vii ɓang ya Yahudawa.<verse eid="1CO 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 16:9" />Nunglǝi bǝ to nung to a langǝ i ɓkom tthǝng, ko kwɔ yayuu kpaaɗing dǝna lam ɓǝ.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />Nǝ Timitawos wuo tthang ɓǝ, yang ɓa muu na rab, bakwɔ dǝnnu to nung to lǝn Dangbang tthǝ, manungkwɔ dǝmǝn to ɓǝ. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />Bǝ Yuu akun tthǝmmu thǝ, langkwoi ɓa nwongǝu dang bǝ tthkotthko gu i tthǝla, yangbǝ u kwoi u wuo suam; kwoi dǝmǝn yiɗi bǝ ɓyǝko i ya dǝ ba a langǝ i tthǝ Fuh.<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />Lakwɔ, lǝ ba youngǝm Apolos. Vii ǝndǝi dǝmǝn yammu gǝngǝ tǝu gum ya dǝ ba a langǝ i tthǝ Fuh, kwoi ǝn mua kiggǝu ǝndǝi lǝu angǝ i tǝ lonna kwɔ i yiɗi ɓǝ. Nǝ u tǝi lonna ɓǝɓǝ, yang u tǝ.<verse eid="1CO 16:12" /></para>
  <para style="s">Bǝ Alo Ba</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />Ɓa ǝǝ dang kiggǝ ɓǝ, ɓa dǝi nyimtthǝ dang bǝ dǝnyitthǝ nung ɓǝ, ɓa survulli thǝ, ɓa dǝi nyimtthǝ. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />Ɓa to nung ǝndǝi dang bǝ yiɗi tha.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />Ɓa ibǝi ba Istifanus i ya dang gwoi gu; ilǝ yakwɔ osi dǝ ba a langǝ i tthǝ Fuh dang Akaya ɓǝ langkwoi i dǝ loi lǝ ba bǝ to nung to lǝ ya yuu gi Fuh tthǝ. Ya ǝnthǝm, dǝmǝn yam ɓǝ, <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />ɓa muo sua yakku manungkwɔni, langkwoi i yuu akun nǝkwam kwɔ dǝna to nung to langkwoi dǝna to nung to i ilǝ ɓǝ.<verse eid="1CO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17" />Dǝmǝn lǝ tthǝla babǝ wuo gi Istifanus, i Fartinatas, i Akaikas; ǝn i iwulǝ i nungkwɔ namǝu ɓǝ <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />langkwoi ǝn i idǝm tthǝnyimmi, manungkwɔ i dǝɓǝ tthǝnyimmi. Ɓa kha yayuu manungkwɔni.<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />Ya kǝm pinwa losua Asiya dǝna gum ɓǝ; Akila i Bilkisu i ya kǝm pinwa kwɔ dǝna kǝbtha dang woi gi kwɔ tumbǝi i bǝ gumbǝi ya Kristǝ tthǝ. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />Ya dǝ ba a langǝ i kwɔ bǝikwɔ ǝndǝi dǝna gumbǝi.</para>
  <para style="p" vid="1CO 16:20">Ɓa gumtha i bǝ gumtha a langǝ i.<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />Ən vullǝ nungvullǝ i namlǝ kwɔ: Bulus dǝna gumbǝi<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />Yuu kwɔ ǝndǝi nǝ yiɗi Dangbang lǝu yang- to nung a langǝ iu!</para>
  <para style="p" vid="1CO 16:22">Maranata- Dangbang ɓi, wua! <verse eid="1CO 16:22" /><verse number="23" style="v" sid="1CO 16:23" />Nung a langǝ i gi Dangbang Yeso ǝǝ i ɓǝ.<verse eid="1CO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />Bǝ yiɗi bǝim dǝi loɓǝ ǝndǝi dang ɗuǝn Kristi Yeso.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>