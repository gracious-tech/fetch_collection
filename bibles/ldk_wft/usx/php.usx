<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">Filibiyawa</para>
  <para style="toc1">Nungvullǝ Gi Bulus Sua Ya FILIBIYAWA</para>
  <para style="toc2">Filibiyawa</para>
  <para style="toc3">Fili</para>
  <para style="mt2">Nungvullǝ Gi Bulus Sua Ya</para>
  <para style="mt1">FILIBIYAWA</para>
  <para style="imt">Bǝ Gabnung Ba</para>
  <para style="ip">
    <char style="bk">Nungvullǝ Gi Bulus Sua Ya Filibiyawa </char> i vullǝ la nungsi sua ya kǝm pinwa kwɔ Bulus baipiu ɓǝ losua ya lo munglǝ, dang losua Roma Makidoniya lǝ. I vullǝ lona lǝ kullo ya nwatummi gi Yeso pursɨnǝ, langkwoi lona lǝ kullɔ dǝu tǝi bǝ tthǝngbǝi ya to nungto ya Kristǝ yakun langkwoi ba dǝna ziu ba bǝ nanatthǝ nung pǝllǝ kǝm pinwa Filibi lǝ. Nungvullǝ kwɔ wuolǝ tthǝla i bǝ dǝnyitthǝ a ɓuoni kwɔ ǝn Bulus ɓuo a geiɓǝ babǝ dǝnyitthǝ gu tthǝ Kristi.</para>
  <para style="ip">Nung kwɔ to u vullǝnung kwɔ ǝn babǝ to sakko lǝ ya Krista Filibiyawa ba nung dǝ kwɔ i duɓǝ yang bǝ nwongǝu lona kwɔ dǝu yiɗi nung ɓǝ. U to nungto i lona kwɔ yang bǝ i nyim tthǝi, yang bǝ i tǝi tthǝ nyimmi i zuii gu i a bǝi lang ɓǝ. U yammǝi angǝ i lǝi kiggǝ Yeso, bǝ yiɗi lo i lo angǝ bǝ lo yigwoi loi thǝ.</para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="s">Shawulu Vullǝ Nung Lǝ Ya Filibiyawa Tthǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />Bǝgǝ Bulus i Timitawos, ya thǝb gi Kristi Yeso-</para>
  <para style="p" vid="PHP 1:1">Sua yayuu gi Fuh ǝndǝi dang Filibi ya kwɔ dang tha i Kristi Yeso ɓǝ, i yakku kǝm pinwa i ya wouna tthǝ nung to:<verse eid="PHP 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2" />Kaso Fuh Daa ɓi i Dangbang Yeso Kristi dǝɓǝ nung a langǝ i i bǝ ǝǝ a langǝ i.<verse eid="PHP 1:2" /></para>
  <para style="s">Bulus Pinwa Lǝ Ya Filibi Tthǝ</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />Dǝmǝn khaa Fuhm lǝ ba ɓǝ lona ǝndǝi nǝ ǝn nhǝm baɓǝ ɓǝ; <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />langkwoi lona ǝndǝi nǝ dǝm pinwa lǝ baɓǝ ǝndǝi, dǝm pinwa i tthǝla <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />lǝ bakwɔ ɓa nwongǝm dang bǝ to nung to nwaba a langǝ i la nwasiu wullǝ lakwɔ ɓǝ. <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />Langkwoi lakwɔ ǝn ibǝing geigǝ Fuh, kwɔ baipi nung to a langǝ i dang ɓǝ kwɔ, u lilotthǝ nǝ u alo Vii gi Kristi Yeso ɗǝ. <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />Vii ǝndǝi ɓǝ dang nyim lǝ! Langkwoi nung kwɔ mamtthǝɗing mǝn lǝ tthǝla manung kwɔ ǝnlǝ lǝ baɓǝ ɓǝ. Ba kwɔ ɓǝ ǝndǝi ɓa tǝi nwathan ɓǝ i ɓang lǝ dang nung a langǝ i kwɔ Fuh dǝm ɓǝ, i lakwɔ ɓang dang pursǝna langkwoi i akwɔ ɓang tthǝ i lo na kwɔ mǝn kang nwaba a langǝ i langkwoi ǝn yǝbbu dǝi nyimtthǝ ɓǝ. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />Fuh lǝ ya gei nwam angǝ ǝn gei ǝn ba a langǝ i kwɔ ǝn gei gǝ ghaali bǝ yiɗi ɓǝ wuo tthǝn bǝgǝ Kristi Yeso i nko lǝ. <verse eid="PHP 1:8" /><verse number="9" style="v" sid="PHP 1:9" />Dǝm pinwa geigǝ bǝ yiɗi bǝi ɓǝ lilotthǝ bǝ ghako nyimtthǝ vii ǝndǝi, i bǝ ghako dang bǝ ibǝi nung a langǝ i i bǝ to kwan a langǝ i, <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />yangbǝ ɓa ɓuan ɓa mko nungkwɔ lǝ akwɔ mapǝl sua nungɓǝ ɓǝ. Yangbǝ ɓa ilǝ loɓǝ tthǝ nung to ɓillǝng i bǝ muo ɓǝ i nung a ɓko Vii kwɔ Kristi a wɔtthǝ ɓǝ. <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />Nwongǝi ɓǝ a yitthǝ i kiggǝ a langǝ i kwɔ ǝn yeso Kristi ɓuo a wullǝ ɓǝ, yang bǝ yayuu ɓyǝa ghaali gi Fuh yang i khako langkwoi.<verse eid="PHP 1:11" /></para>
  <para style="s">Bǝ Əǝ I Nwongǝi Ən A Kristi</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />Ya ǝnthǝm dang kristi, dǝmǝn yiɗi ɓa ibǝi, angǝ nung kwɔ to nung tthǝm kwɔ la langǝ i nwong bǝ li lo tthǝ nwaba a langǝ ing. <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />Lǝ ba nung ɓǝ kwɔ, ya ki gwoi yigwoi ǝndǝi i ya kwɔ bǝi kwɔ ǝndǝi i bǝi angǝ i dǝm ǝn tang pursǝna ba kwɔ ɓang ǝn thǝb gi Kristi ɓǝ. <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />Langkwoi bǝ tang pursǝnam dǝ tthǝnyimmi lǝ sua ya dǝ ba a langǝ i tthǝ kristi, nung kwɔ i lilo bǝto dang wa lona ǝndǝi bǝ gei nwaba a langǝ i bǝ sur vulli yangǝu.<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />La langǝ i yakun gi dǝna gei ba Kristi bakwɔ dǝi to dasi langkwoi dǝi tthǝng tha langkwoi i kwanwa, kwoi yakun dǝna gei ba Kristi lo nunglǝi a langǝ i. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />Yakwɔ dǝna to ǝn ba bǝ yiɗi bǝi, ba kwɔ i ibǝi angǝ Fuh dǝm nung to kang nwaba a langǝ i angǝ ǝn ba a langǝ i. <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />Yakun dǝna gei ba kristi dang wa kun lǝu, kwoi dǝi yiɗi bǝ tǝi nung a kun dang ǝu; dǝi ɓyǝa angǝ i lim lo zuii kwɔ ɓang pursǝna ɓǝ.<verse eid="PHP 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 1:18" />Ɓang lǝ lǝu! Dǝm lǝ tthǝla lǝ bko- manungkwɔni dǝi gei ba Kristi nung lǝi lǝ ǝndǝi, ko lo pǝllǝ ko nung lǝi a langǝ i. Langkwoi mǝn ǝǝ nwa bǝ lǝ tthǝla, <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />bakwɔ ǝn ibǝi tthǝ bǝ pinwa ɓǝ i bǝ nwongbǝi kwɔ dǝna wɔ bǝgǝ Ɓyang Yeso Kristi kwɔ mǝn tǝi lom ǝntǝi. <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />Nung kwɔ dǝm yiɗi bǝ touni kwɔ i nung kwɔ ǝn dǝnyitthǝ kwɔ nung ɓǝ lǝ nung tom ɓuan ɓang lǝu, kwoi gei gǝ lona ǝndǝi, manung a la kwɔ, mǝn li lo dang wa, yang bǝ i nung kwɔ dang tthǝm ǝndǝi kwɔ mǝn wullǝ ghaali lǝ Kristi tthǝ, ko Ən ǝǝ ko ǝn ɓui. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />Abǝm abo kwɔ mǝn ǝǝ i nwongǝi ǝn ǝǝ lǝba Kristi, langkwoi nǝ ǝn ɓui yang ǝn nungtǝi tthǝmlǝ. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />Kwoi nǝ mǝn ǝǝ i nwongǝi dang tthǝ kwɔ Mǝn tǝi lǝi bǝ to nungto a langǝ i kpaaɗing, yang ǝn i bǝi a kwɔ mǝn lǝi ɓǝ lǝu ko ǝn nwongǝi ko ǝn ɓua. <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />I gabbǝm dang tha rab. Dǝm yidɗi bǝ yitthǝ longwam kwɔ tǝn ǝǝ i Kristi, kwɔ lǝ nung a langǝ i ɓǝ; <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />kwoi lǝ baɓǝ maɗing kwɔ mǝn ǝǝ i nwongǝi ɓǝ. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />Ən ibǝing lalangǝ i, langkwoi ǝn ibǝing mǝn ǝǝ. Mǝn ǝǝ i ɓǝlǝ ǝndǝi, mǝnto ɓa ghaa i tthǝla dang bǝ dǝnyitthǝ, <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />yangbǝ kwɔ nǝ ɓang i ɓǝlǝ akun, ɓa tǝi nungkwɔ ɓa lǝi loɓǝ lǝ bam ɓǝ dang nwongǝi dang tha i Kristi Yeso.<verse eid="PHP 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />Lakwɔ, nung a langǝ i nung ɓǝ lǝ nung to ɓǝ ǝǝlǝ nungkwɔ nwaba a langǝ i kwɔ Kristi dǝna yiɗi ɓǝ, yang bǝ, ko nǝ ǝn ɓuan tǝn ɓyǝa ɓǝ lǝu, Mǝn lǝ angǝ ɓa dǝi nyimɗing i nung kun lo nyiɓǝ langkwoi angǝ bǝ yiɗi bǝ to nung kun dǝ ɓa ɓuob vǝm suatha lǝ ba bǝ dǝnyitthǝ nwaba a langǝ i. <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />Bǝ ɓa sur ya ɓui ɓǝ thǝ; vii ǝndǝi ɓa nyim nyi, langkwoi nung kwɔ a tai na tthǝ angǝ i o langkwoi angǝ ɓa tang ɓui ɓǝ, ba kwɔ ǝn Fuh dǝ ɓǝ bǝ tang lo. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />Bakwɔ i dǝɓǝ nunglǝi bǝ to nung to lǝ Kristi tthǝ, ǝn bǝ dǝ ba a langǝ i tthǝu ɓuo lǝu, kwoi langkwoi i bǝ to zuii lǝ ba gu. <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />Lakwɔ ɓa taɓui suatha i ɓanglǝ. Ən u ɓuiɓǝ kwɔ ɓa ɓyǝa dǝm ta viikwɔ ɓǝ, langkwoi, manungkwɔ ɓa lǝkwɔ, ǝn ɓuiɓǝ kwɔ dǝm ta yirrǝ ɓǝ.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">Bǝ Ɓuoblo Sua Gi Kristi I Ghaali Gu</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />Nwongǝi ɓǝ dang tha i Kristi dǝna to ɓǝ ɓa nyim, langkwoi bǝ yiɗi bǝi gu dǝna tǝm lo nyi ɓǝ. Dǝ ɓa kǝbtha lo i Ɓyang, langkwoi dǝ ɓa tǝm lo nyi i bǝ ɓyǝa nungzuii tha. <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />Dǝmǝn yiɗi ɓǝ, yang, ɓa dǝm tthǝla i bǝ nhǝm ba kun i ɓanglǝ, bǝ yiɗi tha kun, ɓi ǝǝ i killǝng i lo nyi kun. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />Bǝ ɓa to nung ba bǝ yiɗi lo ɓǝ ko bǝ lǝi lo ɓǝ thǝ, kwoi ɓa ɓuob lo ɓǝ sua tthǝ tha lǝ, vii ǝndǝi ɓa lǝi ya young ɓǝ pǝl lo ɓǝ. <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />Langkwoi ɓato nungkwɔ yakun a tǝiɓǝ, ǝn aɓǝ ɓuo lǝu. <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />Kiggǝ kwɔ ɓato kwɔ ǝn kiggǝ kwɔ ǝn a bǝ Kristi Yeso ɓǝ:<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />Vii ǝndǝi dǝu lǝi tthǝ Fuh,</para>
  <para style="q2" vid="PHP 2:6">kwoi u nhǝm angǝ i natha i Fuh lǝu<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />Manungkwɔni yang, i bǝ yiɗi gu u yitthǝ nungkwɔ nkolǝ ǝndǝi kwɔ,</para>
  <para style="q2" vid="PHP 2:7">u lǝi tthǝ ya thǝb.</para>
  <para style="q2" vid="PHP 2:7">U mǝrǝm mangǝ ǝn thayuu</para>
  <para style="q2" vid="PHP 2:7">langkwoi u fug u itha i thayuu.<verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />U ɓuob lo sua u thko lo lǝi u gwab nwa ɓua-</para>
  <para style="q2" vid="PHP 2:8">ɓua gu lo kab gangǝ i.<verse eid="PHP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />Lǝba baɓǝ kwɔ Fuh lǝiu tǝllǝ bǝi a ghaali wayi</para>
  <para style="q2" vid="PHP 2:9">langkwoi u du ɗuǝn kwɔ ghaa pǝl ɗuǝn ǝndǝi ɓǝ.<verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />Langkwoi nungkwɔ, dang bǝ dǝ ghaali lǝ ɗuǝn Yeso</para>
  <para style="q2" vid="PHP 2:10">nung a nwongǝi ǝndǝi wayi, langkwoi i longwam pangsua</para>
  <para style="q2" vid="PHP 2:10">a bainwa longǝi sua tthasi Yeso,<verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />langkwoi i ǝndǝi i ɓko nwai i gei angǝ yeso Kristi ǝn Dangbang, tthǝ ghaali gi Fuh Daa ɓi.<verse eid="PHP 2:11" /></para>
  <para style="s">Bǝ Yuimmu Mangǝn Luagabǝi Dang Longwam</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />Ya ǝnthǝm kwɔ dǝmǝn yiɗi kwɔ, nungkwɔ yang, manungkwɔ dǝɓa to nung to i bam kwɔ ɓang i ɓǝlǝ kwɔ, lakwɔ akwɔ nungɓǝlǝ nung a langǝ i ɓa to nung to i bam kwɔ ǝn yangǝu i ɓǝlǝ ɓǝ. Ɓa ǝǝ nwabǝ to nung to i tthǝvulli tthǝɓǝ na ɓuobtthǝm ɓa alo bǝ sob lo ɓǝ, <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />bakwɔ Fuh dǝna to nung to vii ǝndǝi tthǝɓǝ lǝ yangbǝ toɓǝ ɓa ɓuan ɓa to nung to i bagu i nungkwɔ dǝu yiɗi ɓǝ.<verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />Ɓa tonung ǝndǝi bǝ ɓa la tha ko ɓa nyim nwa thǝ, <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />yangbǝ bǝ i tǝi ɓǝ i nung a ɓko thǝ langkwoi yathang Fuh a langǝ i, yakwɔ ǝǝ dang longwam ya tang gǝgham i ya nung aɓau ɓǝ. Ɓa gab lua dang ǝi lǝ mangǝn vin kwɔ dǝna gab lua yi lǝ ɓǝ, <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />manungkwɔ dǝ ɓa ji nwaba nwongǝi ɓǝ. Nǝ ɓa toni, ɓang tthǝ i nung kwɔ a tom mǝn lǝ tthǝ la Vii kwɔ Kristi a wɔ tthǝ ɓǝ, ba kwɔ a tana tthǝ angǝ ttham i nung to ǝǝ lǝ nung a nǝkwam lǝu.<verse eid="PHP 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 2:17" />Lko i al ziim lǝtǝ mangǝn bǝ nyǝknung bǝ dǝnyitthǝ i dǝlǝ Fuh. Nǝ manungɓǝ, dǝm lǝ tthǝla dǝm geiɓǝ tthǝlam tthǝ ǝndǝi. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />Manungɓǝ ni, ɓǝ langɓǝ ɓa lǝ tthǝla ɓa geim tthǝla ɓǝtthǝ i ɓang.<verse eid="PHP 2:18" /></para>
  <para style="s">Timitawos I Ibafaroditas</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />Nǝ ǝn bǝ yiɗi gi Dangbang yeso, dǝm dǝnyitthǝ sua tu lǝu mǝn ɓuan mǝn tum Timitawos sua ɓǝ, yang bǝ tthǝm nyim nǝ ǝnlǝ nwaba loɓǝ ɓǝ. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />Ən uɓǝ ɓuolǝ yuu akwɔ dǝna ibǝ zuiim langkwoi dǝu tobǝ loɓǝ. <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />Koya ǝndǝi dǝna dǝ nungtthǝ nungkwɔ dǝu yidɗi ɓǝ, ǝn nungkwɔ Yeso Kristi dǝna yiɗi ɓǝlǝu. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />Langkwoi ɓǝ i na ɓǝ ɓa i bǝi Timitawos i lǝ long, manungkwɔ u i ɓang, mangǝn yui i daa, to nung to sua tha lǝ ba nwaba a langǝ i. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />Manungkwɔni yang dǝm dǝnyitthǝ sua tulǝu yang mǝn tummu suaɓǝ kwɔ nǝ ǝn ibǝi nungkwɔ wa tonung tthǝm ɓǝ. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />Langkwoi ǝn dǝ ba a langǝ itthǝ Dangbang geigǝ sua tulǝu yang ɓang i namlǝ mǝn tǝsua ɓǝ.<verse eid="PHP 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />Ən nhǝm geigǝ maɗing kwɔ mǝn tum young ɓi Abafaroditas ɓǝ, yuu a kwɔ to nung to langkwoi ta ɓui i ɓang lǝ langkwoi u to nung to lǝ ya nwatummi dǝu nwongǝm. <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />Dǝu yiɗi bǝ ɓyǝa ɓǝ ǝndǝi langkwoi kiggǝu ǝrr ɗing ba kwɔ ɓa lǝ angǝ tthǝu lko ɓǝ. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />La langǝ i tthǝu lko langkwoi u kyǝa bǝ ɓuiu. Kwoi Fuh ɓyǝa nung zuii gu, kwoi lo ɓuo lǝu kwoi i ɓang, lang ɓǝ, langkwoi u kangǝm lo bǝ zi bǝi angǝ a. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />Dǝm yiɗi ɗing, bǝ tummu suaɓǝ, yangbǝ tthǝɓǝ la langkwoi kwɔ nǝɓa ɓyǝko ɓǝ, langkwoi bǝ zibǝi kwɔ dang wam kwɔ a tǝm. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />Ɓa kǝb lo, i tthǝla, mangǝn ya dǝba a langǝ i Dangbang. Ɓa dǝ angǝ a lǝ yayuu manung abo, <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />bakwɔ tuab lǝu u ɓuing lǝ ba nung to gi Kristi, yangbǝ bǝ nwong bǝi gu ǝǝ lǝ nwathang bǝ nwong bǝi kwɔ ɓa nwongǝm lǝu ɓǝ.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">Nungto Alangǝ i</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />Ya youngǝm, bǝ alo ǝndǝi, ɓa lǝ tthǝla dang tha ɓǝ i Dangbang. Zimmu nǝmǝn vullǝ nung kwɔ ǝn vullǝ viikwɔ ɓǝ, yang a nwong ɓǝ nǝ ǝn toni ɓǝ <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />Ɓa dǝ kiggǝ tthǝ ya kwɔ dǝna to nungto mullub ɓǝ, yakwɔ dǝna tonung mangǝ i ǝn ɗua gug kwɔ dǝna ɓǝr tthǝ ɓǝ. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />Ən ɓi, ǝn i lǝu, kwɔ muo bǝ ɓǝr nwa ɗuǝ a langǝ i ɓǝ, bakwɔ dǝ ɓi wab Fuh dang Ɓyang langkwoi dǝ ɓi lǝ tthǝla dang nwongǝi ɓi dang tha i Kristi Yeso. Ɓi dǝ ba a langǝ itthǝ ɓang a nungwambǝi lǝu. <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />Mǝn ɓuan, la langǝ i, ǝn dǝ ba a langǝ i tthǝ i nung ɓǝ kwɔ. Nǝ yuu akun ɓǝ nhǝm angǝ ɓa ɓuan ɓa dǝ ba a langǝ i tthǝ ɓang a nungwambǝi ɓǝ, Ɓang tthǝ i nung kwɔ ato mǝn lǝ manungɓǝ ɓǝ. <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />I ɓǝr nwa ɗuǝm dang bo ǝngunnai kwɔ i sim tthǝ ɓǝ. Ɓang ǝn ya kab gwoi ya Israila, ya nwa Biliyaminu, zii ya Yahudawa a langǝ i. Ba bǝ to nung to i zuu a bo, ɓang ǝn ya Farisiyawa, <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />langkwoi ǝn to nung to dang wa kun ǝn dǝ zuii lǝ ya kǝm pinwa. Nǝ yuu a to nung a langǝ i ibǝ to nung to i nungkwɔ zuu dǝna yiɗi kwɔ yang, ǝn yangǝu i nung a ɓko. <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />Kwoi i nungkwɔ ǝndǝi mǝn ɓuan mǝn than mangǝn nungtǝi tthǝm kwɔ lakwɔ dǝm lǝi mangǝn ǝn owhng lǝ ba Kristi. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />Ən i nungɓǝkwɔ ɓuo lǝu; dǝm lǝi nung ǝndǝi mangǝttǝn ǝn o ǝndǝing lǝba nungkwɔ ghaani ɓǝ, bǝ ibǝ nung gi Kristi Yeso Dangbangǝm. Lǝba gu ǝn al nung ǝndǝi lǝtǝ; Dǝm ɓyǝa nung ǝndǝi mangǝn nung a nǝkwam, yangbǝ ǝn tǝi Kristi <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />langkwoi ǝn kǝbthalo i ulǝ. Nung a langǝ im i nam mab yangǝu, akwɔ ma tǝi bǝ tonungto i zuu gi Musa ɓǝ. Lakwɔ ǝntǝi nung a langǝ i kwɔ dǝnni dǝ tthǝ bǝ dǝnyitthǝ dang Kristi ɓǝ, nung a langǝ i kwɔ dǝna wɔ bǝgǝ Fuh langkwoi tthǝn bǝ dǝnyitthǝ. <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />Nung kwɔ dǝm yiɗi ǝndǝi kwɔ nung ɓǝ lǝ ǝn i Kristi ǝn bang ttha bǝ ǝrr gu i nwongǝi, ǝn tǝi nwathanǝm dang zuii gu langkwoi ǝn to zuii langkwoi ǝn ɓui ɓua gu manung ɓua gu, <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />dang bǝ dǝnyitthǝ ǝn gei gǝ Ɓang i nam i ǝrrǝm lǝ bǝ ɓui ɓua lǝ i nwongǝi.<verse eid="PHP 3:11" /></para>
  <para style="s">Bǝ Surdum Kwɔ I Tǝilǝ Nungɓǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />Dǝm lǝi geigǝ nung ǝndǝi ǝn tǝing lǝu ko ǝn i long lǝu. Ən ǝǝ nwa bǝ tthang bǝi yang bǝ ǝn tǝi nung busoni kwɔ Kristi Yeso muom lǝ tǝ lǝ tthǝu ɓǝ. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />Ya youngǝm dang kristi, ǝn nhǝm gei gǝ ǝn osi ǝn tang long lǝu; nung kun kwɔ dǝm tokwɔ, dǝm danyitthǝ nungkwɔ tthasuam kwɔ langkwoi ǝn ɗuong nungǝm bǝ tǝi nungkwɔ tthasi ɓǝ. <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />Niyang Dǝm surdum ǝn dǝ nungǝm tthasi yangbǝ ǝn tang nungbusɔni, kwɔ lǝ bǝ lubǝi gi Fuh tthǝ Kristi Yeso tǝlǝ tthǝ nwongǝi yilǝ.<verse eid="PHP 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15" />Ɓi kwɔ ǝndǝi ɓi nyim dang ɓyang kwɔ ɓi lǝi kiggǝ kwɔ. Kwoi nǝ yakun dang ɓǝ kiggǝi i nung tthǝi, Fuh a ta ɓǝ natthǝ nungkwɔ kaitthǝ. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />Ko a ǝǝ nǝna, ɓi tǝ tthasi manung nung lǝi kwɔ ɓi osi ɓi muo wuo lǝ ɗiggǝ ɓǝ.<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />Ya youngǝm dang kristi, ɓa ǝǝ nwa bǝ na nwam, ɓa dǝ kiggǝ ɓǝ tthǝ ya kwɔ dǝna ǝǝ manung a nung lǝi kwɔ ɓi taɓǝ natthǝ ɓǝ. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />Ən gei ɓǝ nungkwɔ tthǝng lona kpaaɗing vii kwɔ, langkwoi la kwɔ dǝm gei a kun i mung nung lǝ: ya kun tthǝ kpaatthǝ kwɔ nwongǝi gi dǝna mǝrrǝmǝi lǝ ɓuitha i bǝ ɓui ɓua Kristi lo kab gangǝ i ɓǝ. <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />Gwoi gi a ɗing dang lua lǝ, bakwɔ fuh gi nungɓǝ lǝ nungkwɔ tthǝi dǝna yiɗi ɓǝ. Dǝi lǝi tthǝ nungkwɔ kaso i lǝ tthǝkku ɓǝ, langkwoi dǝi nhǝm nungkwɔ ǝn a bǝ longwam kwɔ ɓuo ɓǝ. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />Kwoi ɓa ibǝi, ɓi ǝn ya wayi, langkwoi dǝɓi kilo ya sob lo ɓi, Dangbang Yeso Kristi, bǝ wuou wayi lǝ. <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />I ttha kwɔ du lǝi u lo yigwoi lo nung ǝndǝi kwɔ u prǝm tthǝ ɓi tthǝ akwɔ a ɓumɓui kwɔ u mabbu mangǝn tthǝu tthǝ angǝ a.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s">Bǝ Gub Ɗuogsui Kwɔ Bulus Dǝlǝ Ya Dǝba A Langǝ itthǝ Filibi Ɓǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />Ya youngǝm, manungkwɔ niyang, ɓǝ kwɔ dǝm yiɗi ɓǝ ni kwɔ langkwoi dǝmǝn yiɗi bǝ ɓyǝa ɓǝ ɗing! Dǝ ɓa dǝm tthǝla, langkwoi dǝm lǝi lom lǝ ba ɓǝ! Ya young, nungkwɔ lǝ nungkwɔ ɓa dǝi nyimtthǝ dang nwongǝi ɓǝ i Dangbang ɓǝ.<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />Afodiya i Sintiki, dǝm yam ɓǝ, ɓa ǝǝ latthǝ mangǝn ya young dang ɗuǝn Dangbang. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />Langkwoi ɓǝ langɓǝ, ya to nung to i ɓang a langǝ i, dǝm yiɗi ɓa nwong yasi kwɔ; bakwɔ i to nung to ɗing i ɓanglǝ babǝ gei nwaba a langǝ i, i Kilemas i sua ya to nung to i ɓang lǝ, kwɔ ɗuǝnni dang nungvullǝ nwongǝi gi Fuh. <verse eid="PHP 4:3" /><verse number="4" style="v" sid="PHP 4:4" />Kaso a lǝ tthǝla dang bǝ kǝbtha mǝ i Dangbang. Ən gei akun: lǝ tthǝla! <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />A to kiggǝ a langǝ i lǝ yayuu tthǝ ǝndǝi. Dangbang gɓag bǝ wuong. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />Bǝ a nhǝm ba nung akun zii thǝ, kwoi dang bǝ pinwa mǝ ǝndǝi a yam Fuh lo nung kwɔ dǝmma yiɗi ɓǝ, vii ǝndǝi a yammu i bǝ to sakko. <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />Langkwoi tǝmmi Fuh, kwɔ pǝll bǝ ibǝ nung gi thayuu kwɔ, a kang lonyimǝ i dang wa mǝ matthǝ dang tha i Kristi Yeso. <verse eid="PHP 4:7" /><verse number="8" style="v" sid="PHP 4:8" />Bǝ alo, ya youngǝm dang kristi, ɓa yi lonyi ɓǝ i nung a langǝ i langkwoi kwɔ i kha ɓǝ: nungkwɔ lǝ ba a langǝ i, matthǝ, la langǝ i, kaitthǝ, yiɗi, langkwoi nung a khabǝi ɓa nhǝm ba i nung ɓǝ kwɔ. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />Nungkwɔ ɓa na nam langkwoi ɓa muo nam kwɔ ɓa to lǝ nungto, tthǝ bam i nung tom ǝndǝi. Langkwoi Fuh kwɔ dǝna dǝ ɓi tǝmmi a ǝǝ i ɓǝlǝ.<verse eid="PHP 4:9" /></para>
  <para style="s">Kha Fuh Ba Nungdǝ</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />Dang nwongǝi dang tha i Dangbang ǝn tthǝla angǝ a tthǝm lǝ tthasua lona kpaatthǝ a tǝi lona a kun a tam natthǝ mangǝ dǝmma yiɗim. Ən gei gǝ a yim lǝu-a tǝi na lǝu. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />Langkwoi dǝm gei nungkwɔ bakwɔ dǝm ɓyǝa ɓang i nungtthǝm lǝu, bakwɔ ǝn nabǝ lǝtthǝla i nungkwɔ nam lǝ ɓǝ. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />Nǝ nung yangǝu nammu ǝn ibǝ zuiiu langkwoi ǝn ibǝ lali nung nǝ tthǝ nam lǝ kpaatthǝ ɓǝ. Ən na nung kwɔǝng, yang bǝ nǝ ɓǝlla ǝndǝi, lona a nwuo ǝndǝi, namtthǝng, ko ǝn fǝngfǝr ko gwom dǝna a tǝim, ko kpaatthǝ ko tuab ɓuo. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />Ɓang tthǝ i ttha kwɔ mǝn to tha i nungkwɔ a wɔ ǝndǝi ɓǝ i ttha kwɔ Kristi dǝmɓǝ. <verse eid="PHP 4:13" /><verse number="14" style="v" sid="PHP 4:14" />Kwoi maɗing kwɔ a nwongǝm dang zuiim ɓǝ. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />Ɓǝ ya Filibiyawa ɓa ibǝing la langǝ i kwɔ ǝn palǝi Makidoniya vii kwɔ ǝn baipi bǝ gei nwaba a langǝ i lafuu kwɔ, ǝnɓǝ lǝ kǝm pinwa kwɔ dǝ ɓa nwongǝm ɓǝ; ǝn ɓǝ ɓuo lǝ yakwɔ dǝ ɓa gab nungkwɔ ǝntǝi i nungkwɔ ǝntǝi lǝu i ɓang lǝ ɓǝ. <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />Pǝll bo kunnǝng kwɔ dǝ ɓa tumbǝi i nungdǝ dǝ ɓa dǝm dang Tasalonika ɓǝ. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />Dǝmǝn yiɗi nung dǝ lǝu; kwoi, dǝm yiɗi ɓa muo bǝ khana lo kpaatthǝ bǝgǝ Fuh lǝ. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />Manungkwɔ ni lakwɔ ǝn muo i nung kwɔ ɓa dǝm kwɔ langkwoi kpaaɗing! Lakwɔ ɓang tthǝ i nung kwɔ dǝm yiɗi ɓǝ kwɔ Abafaroditas wuo lǝ nung dǝ ɓǝ ǝndǝi wuo dǝm. I mangǝn nung nyǝknung tthǝ Fuh kwɔ kummu latthǝ ɓǝ, nung nyǝknung kwɔ ǝn a langǝ i langkwoi maɗing tthǝu lǝ ɓǝ. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />Langkwoi Fuhm a dǝɓǝ nungkwɔ dǝɓa yiɗi ɓǝ dang nungtǝi gu kwɔ kpaatthǝ kwɔ tthǝ Kristi Yeso. <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />Bǝ dǝ angǝ a ǝn a Fuh ɓi i Daa ɓi laɗing langkwoi laɗing! Dǝitthǝ manungɓǝ.<verse eid="PHP 4:20" /></para>
  <para style="s">Bǝ Alo Bǝ Gumbǝi</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />Dǝmǝn gum yayuu gi Fuh ǝndǝi kwɔ ǝn a bǝ Kristi Yeso ɓǝ. Ya dǝ ba a langǝ i bǝi kwɔ i ɓanglǝ dǝna gumbǝi. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />Yayuu gi Fuh bǝi kwɔ ǝndǝi dǝna gumbǝi, yakwɔ lǝ ya dang gwoi gi Kaisar ɓǝ.<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />Kaso nung a langǝ i gi Dangbang Yeso Kristi ǝǝ i ɓǝlǝ ǝndǝi dang nyi ɓǝ.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>