<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- Munga Bible Translation Project</book>
  <para style="h">Titus</para>
  <para style="toc1">Nungvullǝ Gi Bulus Sua TITUS</para>
  <para style="toc2">Titus</para>
  <para style="toc3">Titus</para>
  <para style="mt2">Nungvullǝ Gi Bulus Sua</para>
  <para style="mt1">TITUS</para>
  <para style="imt">Bǝ Gabnung</para>
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1" />Ɓang Bulus, thǝb gi Fuh i ya nwatummi gi Yeso Kristi.</para>
  <para style="p" vid="TIT 1:1">Fuh mkom u tummǝm yangbǝ ǝn nwong bǝ dǝnyitthǝ gi yayuu gu kwɔ i mko kwɔ yang ǝn oi lǝ si ba a langǝ i kwɔ i tolǝ nung a langǝ i ɓǝ, <verse eid="TIT 1:1" /><verse number="2" style="v" sid="TIT 1:2" />Tthǝn lo bǝ dǝnyitthǝ nwongǝi a ɗing. Fuh, kwɔ kǝb pǝllǝu kwɔ, gwab ɓi nwa nungkwɔ nwuni bǝ baipiu longwam, <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" />langkwoi lona a langǝ i u wulǝ lǝ dang nwaba gu. I dǝ nungkwɔ dang nam, langkwoi ǝn gei manungkwɔ Fuh i ya sob lo ɓi dǝna yiɗi ɓǝ.<verse eid="TIT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4" />Ən vullǝ nung sua Titus yuim a langǝ i dang bǝ dǝnyitthǝ kun.</para>
  <para style="p" vid="TIT 1:4">Kaso Fuh Daa i Kristi Yeso ya sob lo ɓi dǝɓǝ nung a langǝ i i bǝ ǝǝ a langǝ i.<verse eid="TIT 1:4" /></para>
  <para style="s">Nungto Gi Titus Karita</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />Ən yiɓǝ Karita, yangbǝ ɓa mabnung akwɔ alo lǝu kwɔ ɓadǝ matthǝ langkwoi ɓa mko yakku gwoi angǝ a kwɔ ǝndǝi. Ɓa nhǝm nungkwɔ ǝn gei ɓǝtthǝ ɓǝ: <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" />yikku ǝn yuu akwɔ yangǝu i nung a ɓko ɓǝ; siu kun ɓuo, langkwoi yathang gu ǝn ya dǝ ba a langǝ itthǝ i yangǝu i kiggǝ a ɓko ko bǝ la bǝ to nung to. <verse eid="TIT 1:6" /><verse number="7" style="v" sid="TIT 1:7" />Bakwɔ yikku kǝm pinwa ǝnlo nung to gi Fuh, u yangǝu i nung a ɓko. Ya tthǝbǝi lǝu ko nyinyi thǝmtthǝ, ko ya nwamin a fǝr ko nyiɓko ko bǝ yiɗi nungkurɓǝ. <verse eid="TIT 1:7" /><verse number="8" style="v" sid="TIT 1:8" />Ya muo yayol langkwoi dǝu yiɗi nungkwɔ ǝn a langǝ i ɓǝ. U ǝn ya muo lo, geiba kun, ya langǝ i, langkwoi ya gagci lo. <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />U muo nwaba a langǝ i nyimtthǝ kwɔ i gungwab langkwoi natha i nunglǝi lǝ. Manungkwɔ niyang u ɓuan u dǝ tthǝnyimmi lǝ yakun i bǝ nanatthǝnung langkwoi yangbǝ tanatthǝ nung a ɓko yakwɔ dǝna la baɓǝ ɓǝ.<verse eid="TIT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />Bakwɔ yayuu kpaaɗing, yakwɔ i mǝrrǝm nunglǝi Yahudanci, yakwɔ dǝna ǝǝrlǝ kiggǝ langkwoi dǝi ɗam yakun dǝna to nung a nǝkwam ɓǝ. <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" />I nanni bǝ gei ba, bakwɔ dǝi ɓanglǝ ya dang woi ibǝ nanatthǝ nungkwɔ kaso bǝ i nanatthǝ ɓǝ thǝ, langkwoi lǝ ǝnba nunglǝi tthǝkku bǝ ɗu nungkurɓǝ. <verse eid="TIT 1:11" /><verse number="12" style="v" sid="TIT 1:12" />Ya gei ba a tthasi gi a kun gei angǝ, &lt;&lt;Ya Karita ǝn ya pǝllǝ, i mangǝn nungbyang dang gug, ya ɓko ya nungtang.&gt;&gt; <verse eid="TIT 1:12" /><verse number="13" style="v" sid="TIT 1:13" />Bakwɔ ǝn ba a langǝ i. Manungkwɔ ni yang, ɓa than nyi loi lǝ thǝmtthǝ, yangbǝ bǝ dǝnyitthǝ gi ǝǝlǝ a langǝ i. <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />Langkwoi dǝ kiggǝ tthǝ mum muani ya Yahudawa ko to nung to i ba yakwɔ la ba a langǝ i ɓǝ. <verse eid="TIT 1:14" /><verse number="15" style="v" sid="TIT 1:15" />Nung ǝndǝi kai ɗing tthǝ yakwɔ i inai lǝ kaitthǝ ɓǝ; kwoi nung yangǝu kaitthǝ tthǝ yakwɔ ɓanglǝ langkwoi i dǝ ba a langǝ itthǝ lǝu ɓǝ, bakwɔ dang nyiǝ i bǝ nhǝm ba gi ɓanglǝng. <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" />Dǝi lǝi angǝ i ibǝ Fuhng, kwoi nungto gi yǝrnwa tthǝ. Ya tthǝng bǝi langkwoi ya labǝ tonungto, i natthǝ lǝu kwɔ i to nung akun matthǝ ɓǝ.<verse eid="TIT 1:16" /></para>
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="s">Nunglǝi A Langǝ i</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />Kwoi mǝ, Titus, a nanatthǝ nung kwɔ a gwab lǝ bǝ nanatthǝ nung gi Fuh a langǝ i. <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />A nanatthǝ nunglǝ yaɓǝi yakku na nhǝm ba lo kiggǝi, dǝ angǝ a lǝ loi, langkwoi i muo loi; yangbǝ bǝ dǝnyitthǝ gi nyim, bǝ yiɗi bǝi, i bǝ lǝi i tthǝ. <verse eid="TIT 2:2" /><verse number="3" style="v" sid="TIT 2:3" />Manungɓǝ langɓǝ a nanatthǝ nung lǝ yasi yakku i to kiggǝ manungkwɔ kaso yasi ato ɓǝ kwɔ i ǝǝ matthǝ. Bǝ i mǝrrǝm lǝ ya gum tthǝ bǝi thǝ ko thǝb gi min. I nanatthǝ nungkwɔ lǝ nung a langǝ i ɓǝ, <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />yangbǝ i nanatthǝ lǝ yasi a thang i yiɗi yaɓǝi gi i yathang gi, <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />yangbǝ i muo loi langkwoi matthǝ, i ǝǝlǝ yasi kǝm a langǝ i kwɔ a dǝ loi lǝ yaɓǝi gi ɓǝ, yangbǝ bǝ yuu akun gei ba a ɓko lo nwaba a langǝ i kwɔ wuo bǝgǝ Fuh ɓǝthǝ.<verse eid="TIT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6" />Manungɓǝ langɓǝ a gei yathang a ɓǝi i muo loi. <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" />Dang nungkwɔ ǝndǝi mǝ i namǝ a ǝǝlǝ ya to i kiggǝ a langǝ i kwɔ. A to ba a langǝ i i bǝ ɗuong nungmǝ dang bǝ nanatthǝ nungmǝ. <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" />A gei ba matthǝ kwɔ yayuu ɓuan lko ɓǝ, yangbǝ ya ɓuiɓǝ lǝ tthǝkku bakwɔ i yangǝu i nung a ɓko kwɔ i gei loɓi ɓǝu.<verse eid="TIT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9" />Ya thǝb a to nungto i ba ya togwoi gi langkwoi i ji tthǝla dang nung ǝndǝi. Bǝ i vullǝ ba nwai thǝ <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />ko i inung ya togwoi gi thǝ. Manungkwɔ yang, i tanatthǝ angǝ vii ǝndǝi i maɗing langkwoi dǝi dǝnyitthǝ, yangbǝ yayuu yiɗi ba Fuh ya sob lo ɓi matthǝ dang nungkwɔ dǝi to ǝndǝi ɓǝ.<verse eid="TIT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11" />Nung a langǝ i gi Fuh kwɔ dǝna wɔlǝ bǝ sob lo kwɔ i tanatthǝ lǝ yayuu ǝndǝi. <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />Nung a langǝ i ɓǝkwɔ naɓi natthǝ ɓi la bǝ yiɗi nung longwam, langkwoi ɓi ǝǝ i bǝ muo lo ɓi, ǝǝ matthǝ, langkwoi i nunglǝi Fuh longwam kwɔ, <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" />kwɔ dǝ ɓi ki Vii khana lo kwɔ dǝɓi dǝnyitthǝ ɓǝ, kwɔ ghaali gi Fuh ya angǝ a i ya Sob lo Yeso Kristi a fugtthǝ ɓǝ. <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" />Yeso dǝ lo lǝ ba ɓi, yangbǝ u iɓilǝ dang nyi ɓko kwɔ ǝndǝi langkwoi u mab ɓi matthǝ kwɔ lǝ abo i nungtthǝu langkwoi dǝ ɓi yiɗi bǝ to nung a langǝ i.<verse eid="TIT 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15" />A nanatthǝ i nungkwɔ langkwoi a tonungto i tthamǝ kwɔ dǝmma ji tthǝnyimmi langkwoi a than nyi lo yakwɔ dǝna la ɓǝ. Bǝ a gwab yuu akun dang ǝi tthǝm ma thǝ.<verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="s">Nungto Yakwɔ Dǝnna Muo Sua Kristi Ɓǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />A onyi lǝ yayuu mǝtthǝ i dǝ loi lǝ ya dǝ kab nwanung, i to nung to i bagi, langkwoi i to nung a langǝ i nunglǝi kwɔ ǝndǝi. <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" />A gei bǝ i gei ba a ɓko lo yuu a kunthǝ, kwoi i ǝǝ latthǝ langkwoi i to ǝnthǝ, vii ǝndǝi i ɓuob loi sua tthǝ yayuu ǝndǝi. <verse eid="TIT 3:2" /><verse number="3" style="v" sid="TIT 3:3" />Bakwɔ vii kwɔ ɓi i naɓi ǝn ya sullǝ, labǝ to nung to a langǝ i, langkwoi ɓi la nung a langǝ i. Ɓi ǝn thǝb bǝ yiɗi nung i tthǝla kwɔ ǝndǝi. Dǝɓi ɓanglǝ nwongǝi ɓi gei ba nwa thko i tthǝng tha; yakun dǝna la ɓi langkwoi dǝɓi lai. <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />Kwoi kwɔ nǝ nyitǝmmi i bǝ yiɗi bǝi Fuh ya sob lo ɓi fug, <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" />u nwong ɓi. Ən ba nung to a langǝ i kwɔ ɓi i naɓi ɓito ɓǝlǝu, kwoi ǝn ba nung a langǝ i gu nungkwɔ u nwong ɓi, tthǝ Ɓyang a Langǝ i u mǝrrǝmɓi mangǝ i siɓi lafuu i nwongǝi afu. <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />Fuh al Ɓyang a Langǝ i kpaatthǝ lo ɓi lǝ tthǝ Yeso Kristi ya sob lo ɓi, <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" />yangbǝ tthǝ nung a langǝ i gu i dǝ ɓi matthǝ i Fuh lǝ yangbǝ ɓi tǝi nwongǝi a ɗing kwɔ dǝɓi dǝnyitthǝ ɓǝ. <verse eid="TIT 3:7" /><verse number="8" style="v" sid="TIT 3:8" />Nungkwɔ ǝn ba a langǝ i.</para>
  <para style="p" vid="TIT 3:8">Dǝmǝn yidɗi ɓa gei ba lo bakwɔ lalangǝ i, yangbǝ yakwɔ dǝba a langǝ i tthǝ Fuh kwɔ dǝ kiggǝi ibǝ dǝ lona gi bǝ tonungto a langǝ i, kwɔ matthǝ langkwoi a tonungto lǝ ko ya ǝndǝi ɓǝ. <verse eid="TIT 3:8" /><verse number="9" style="v" sid="TIT 3:9" />Kwoi ɓa la bǝ nyimtha nwa sullǝ, ɗuǝn ya bǝba, bǝ kwanwa, i bǝ ɓuob vǝm lǝba zuu gi Musa. Bakwɔ nung yangǝu dang ǝu lǝu langkwoi mko. <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" />A gub ɗuogsui yuu akwɔ dǝna wɔlǝ bǝ gab lo yayuu kwɔ bo rab, langkwoi yangbǝ ato nung akun i ilǝ thǝ. <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" />A ibǝi yayuu manung kwɔ ni ɓanglǝng dang nung a ɓko, langkwoi nung a ɓko gi geing angǝ nung to gi mko.<verse eid="TIT 3:11" /></para>
  <para style="s">Bǝ Alo Bǝ Gub Ɗuogsui</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />Kwɔ ǝn tum Artimas ko Tikikus sua ɓǝ, a ɗuong nungmǝ ɓa wɔ suam Nikafolis, bakwɔ dǝm yiɗi bǝ i kong bǝilǝ. <verse eid="TIT 3:12" /><verse number="13" style="v" sid="TIT 3:13" />A ɗuong nungmǝ a nwong Zinas ya to kwan i Apolos i baipi thko gi, a nung ǝndǝi yangbǝ i tǝi nungkwɔ dǝi yiɗi ǝndǝi ɓǝ, <verse eid="TIT 3:13" /><verse number="14" style="v" sid="TIT 3:14" />Yayuu ɓi a na bǝ dǝ tthǝi tthǝ bǝ to nung a langǝ i, yangbǝ i wuolǝ nungkwɔ dǝi yiɗi vii ǝndǝi ɓǝ; bǝ i ǝǝ nǝkwam thǝ.<verse eid="TIT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15" />Yakwɔ ǝndǝi i ɓanglǝ kwɔ dǝna gumbǝi. Ɓa gum ya ǝnthǝ ɓi dang bǝ dǝnyitthǝ.</para>
  <para style="p" vid="TIT 3:15">Nung a langǝ i gi Fuh ǝǝ i ɓǝlǝ ǝndǝi.<verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>