<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">-MUNGA BIBLE MUNGA PROJECT MUNGA</book>
  <para style="h">Afisawa</para>
  <para style="toc1">Nungvullǝ Gi Bulus Sua Ya AFISAWA</para>
  <para style="toc2">Afisawa</para>
  <para style="toc3">Afi</para>
  <para style="mt2">Nungvullǝ Gi Bulus Sua Ya</para>
  <para style="mt1">AFISAWA</para>
  <para style="imt">Bǝ Gabnung</para>
  <para style="ip">Bulus vullǝ nungvullǝ tog lǝ bǝi sua ya Afisawa la nungsi lǝng ba&lt;&lt;nung mabbǝi gi Fuh. Yangǝu wullǝ nung mabbǝi gu wuko gǝm lǝ thǝ bǝ yikkun, nung ǝndǝi wayi i a pangsua, yang Kristi lǝ loi&gt;&gt; Langkwoi ǝndǝi dǝnnǝu gei ba lǝ yayuu gi Fuh angǝ i ǝǝ tthasua nung bǝ i bǝi angǝ a i nung mab nung lǝi gi Fuh i bǝ kǝb tha lo gi yayuu kwɔ losua lǝ ǝndǝi i ǝǝ dang ttha kun i Yeso Kristi.</para>
  <para style="ip">Dang nung a nwasiu Afisawa ya vullǝnung ɓǝ dǝ lo ba bǝ kpaatthǝ lo bǝ gei ba lo ba kwɔ Fuh gei angǝ Daa mko yayuu gu, manung kwɔ u al nung aɓau ba gi lǝ tǝ tthǝ Yeso Kristi kwɔ lǝ yui Fuh ɓǝ, langkwoi Fuh gwabbǝi ba tthǝ lǝ angǝ a nyimtthǝ lǝ Ya Yiɓyang a Langǝ i. A nung rabbu u gei ba lǝ ya thang nung nunglǝi kwɔ i ǝǝ kun dang Kristi kwɔ yang i ǝǝ langǝ i dang bǝ nwongǝi gi thang ttha.</para>
  <para style="ip">I gei ba pagnǝkwam kwɔ tana tthǝ bǝ kǝm ttha gi yayuu gi Fuh bǝ yikun i bǝ gǝm ttha gi i Kristi: ya kǝm pinwa mangǝ i yuu kun, Kristi lǝ loi; ko mangǝ ǝn nung mai, langkwoi ǝn Kristi lǝ tal bǝi kwɔ mǝrǝm mǝm ɓǝ; ko mangǝ ǝn yisi, ǝn Kristi lǝ lo. Nungvullǝ kwɔ ǝrr tǝ bǝi ghaa tthǝ bǝi a yi kwɔ i gei lǝ ba nungvullǝ kwɔ i to lǝ ba bǝ nhǝm ba gi Fuh tthǝ nyitǝmmi gi Kristi. I ɓyǝa nung ǝndǝi tthǝ fitilǝ bǝ yiɗi bǝi gi Kristi, bǝ dǝ lo, bǝ al ba lǝtǝ, nyitǝmmi, i bǝ ɗiggǝ lo to nung a langǝ i .</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Ɓang Bulus, ya nwatummi gi Kristi Yeso i bǝ yiɗi gi Fuh-</para>
  <para style="p" vid="EPH 1:1">Tthǝ ya dǝ ba a langǝ i tthǝ Fuh dang Afisa, yakwɔ dǝ ba a langǝ i tthǝ Fuh i nwongǝi dang tha i Kristi Yeso: <verse eid="EPH 1:1" /><verse number="2" style="v" sid="EPH 1:2" />Kaso Daa ɓi Fuh i Dangbang Yeso Kristi dǝɓǝ nung a langǝ i i tthǝla.<verse eid="EPH 1:2" /></para>
  <para style="s">Bǝ Khanalo Ɓyang a Langǝ i Dang Kristi</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />Ɓi dǝ angǝ a lǝ Fuh kwɔ lǝ Daa ɓi Dangbang Yeso Kristi! Bakwɔ dang tha i Kristi u khana lo ɓi langkwoi u dǝɓi ɓyang khana lo a langǝ i longwam langkwoi i wayi.<verse eid="EPH 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 1:4" />Fuh mko ɓi nungsi nwuni bǝ u mab longwam, u mkoɓi ɓi mǝrrǝm lǝ abo dang tha i Kristi, yang bǝ ɓi mǝrrǝm lǝ ya langǝ i nung a ɓko yangǝu tthǝ ɓiu.</para>
  <para style="p" vid="EPH 1:4">Lǝba bǝ yiɗi bǝi gu.<verse eid="EPH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 1:5" />Fuh osi mab nunglǝi angǝ tthǝ Yeso Kristi yang i mǝrrǝm ɓi lǝ yathang gu- ǝn nungkwɔ lǝ nungkwɔ dǝu yiɗi ɓǝ. <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />Ɓi kha Fuh ba ghaali nung a langǝ i gu, ba nungdǝ gu kwɔ nǝkwam kwɔ u dǝɓi na Yuiu kwɔ dǝu yiɗi ɓǝ. <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />Tthǝn tthǝ zii Kristi nung kwɔ ɓi tǝi lo ɓi, nungɓǝlǝ, i al nung a ɓko ɓilǝtǝ. Nung a langǝ i Fuh ghaa nǝnǝ ni, nungkwɔ lǝ, u i ɓi lǝ dang nung a ɓko ɓi. <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />Kwɔ u dǝɓi ghaatthǝ ɓǝ!</para>
  <para style="p" vid="EPH 1:8">Dang yiggǝi gu ǝndǝi i bǝ ɓyǝa tthasi gu.<verse eid="EPH 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 1:9" />Fuh to nung kwɔ dǝna yiɗi bǝ tou ɓǝ, langkwoi taɓinatthǝ nung a pyǝa kwɔ u osi u mab zuiu laku u alo tthǝ Kristi ɓǝ.<verse eid="EPH 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 1:10" />Nungkwɔ u mab zuiu kwɔ, Fuh wa alo nǝ lona ɓǝ nǝ wuu natthǝng ɓǝ, u wullǝ nung mabbǝi gu ǝndǝi bǝyikun, nung ǝndǝi wayi i pangsua, yang Kristi lǝ loi.<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />I to nung ǝndǝi manungkwɔ mab zuiu i nungkwɔ dǝu yiɗi ɓǝ; Langkwoi Fuh mko ɓi lǝ yayuu gu dang tha i Kristi ba bǝ yiɗi gu, dǝi lo nung kwɔ u yiɗi bǝ tou la nungsi ɓǝ.<verse eid="EPH 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EPH 1:12" />Ɓi, yakwɔ osi dǝnyitthǝ Kristi kwɔ, kha ghaali gi Fuh.<verse eid="EPH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13" />Yang ɓǝ lang bǝ ɓa mǝrrǝm lǝ yayuu gi Fuh kwɔ nǝɓa lǝ nwaba a langǝ i gi Fuh ɓǝ, ba a langǝ i gi Fuh kwɔ i ɓǝlǝ nung a ɓko ɓǝ. Ɓadǝ ba a langǝ i tthǝ Kristi, nungkwɔ Fuh dǝna lo ɓǝ ɓǝlǝ yayuu gu i bǝ dǝɓǝ Ɓyang a Langǝ i kwɔ u gwab ɓǝ nwuo ɓǝ.<verse eid="EPH 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 1:14" />Ɓyang a Langǝ i kwɔ taɓi natthǝ angǝ Fuh a dǝ ɓi bǝ sob lo ǝndǝi, yang nungkwɔ gei ɓi tthǝ angǝ Fuh a dǝ nung bǝ tǝi lo lǝ ya kwɔ lǝ yayuu gu ɓǝ. Ɓi kha ghaali gu!<verse eid="EPH 1:14" /></para>
  <para style="s">Bǝ Pinwa Gi Bulus</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Lǝ ba bakwɔ, laku ǝnlǝ bǝ dǝnyitthǝ ɓǝ tthǝ Dangbang Yeso i bǝ yiɗi bǝi kwɔ dǝɓa yiɗi lǝ yayuu gi Fuh ɓǝ.<verse eid="EPH 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EPH 1:16" />Ən ǝǝsua bǝ dǝ angǝ a lǝ Fuh lǝ baɓǝ lǝu. Dǝmǝn nhǝm ɓǝ dang bǝ pinwam<verse eid="EPH 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 1:17" />langkwoi dǝmǝn gei Fuh gi Dangbang ɓi Yeso Kristi, Daa angǝ a, dǝɓǝ Ɓyang, kwɔ a dǝɓǝ yiggǝi a kai nungɓǝ tthǝ Fuh, yangbǝ ɓa iu. <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />Dǝmǝn yam yangbǝ Fuh ɓko dang wa ɓǝɓa ɓyǝa lua gu, yangbǝ ɓa ɓyǝa bǝ dǝnyitthǝ kwɔ u lubǝi ɓǝlǝ bko ɓǝ, nung tǝi ɓǝ nǝnǝ fǝm lo khana lo kwɔ u gwab nwuo lǝ yayuu gu ɓǝ, <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />langkwoi ghaali ttha gu nǝnǝ kwɔ dǝna to nung to dang tthǝɓi yakwɔ dǝba a langǝ i tthǝ ɓǝ. Ttha kwɔ dǝna to nung to tthǝ ɓi kwɔ natha i ttha angǝ a gi Fuh.<verse eid="EPH 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 1:20" />Kwɔ u tolǝ nung to viikwɔ u ǝrr lǝ Kristi bǝ ɓui ɓua kwoi u duu lona a nali wayi ɓǝ.<verse eid="EPH 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 1:21" />Kristi lo yigwoi bǝi lǝ lo ya lo yigwoi wayi ǝndǝi, ttha, ya togwoi; utthǝ i ɗuǝn kwɔ ghaa pǝl ttha longwam a kwɔ i akwɔ dǝna wɔ tthasi ɓǝ. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />Fuh dǝ Kristi lǝ yigwoi lo nung ǝndǝi langkwoi u dulǝ yikku lo ya kǝm pinwa lǝ yikku angǝ a Dangbang lo nung ǝndǝi.<verse eid="EPH 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 1:23" />Ya kǝm pinwa ǝn tthǝ Kristi, ǝn u lǝ lo nung i nko lǝ ǝndǝi bǝi ǝndǝi.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">Nwongǝi Afu</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />Vii kwɔ ɓǝ mangǝn yayuu kwɔ ɓumɓui ɓǝ lǝba bǝ laba gi Fuh i nung a ɓko ɓǝ. <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />Lona lǝ kulo dǝ ɓa muo nunglǝi ya longwam; dǝ ɓa to nung to i ɓyang a ɓko ya lo yigwoi dang wa, ɓyang kwɔ dǝna lo yigwoi lo yayuu kwɔ dǝna labǝ to nung to i bagi Fuh ɓǝ.<verse eid="EPH 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 2:3" />Ən ba a langǝ i ɓi ǝndǝi ɓi manung abǝi ɓi ǝǝ dang nungkwɔ dǝɓi yiɗi ɓǝ, dǝ ɓi to nung kwɔ tthǝ ɓi i dang wa ɓi yiɗi ɓǝ. Dang bǝ ǝǝ ɓi, manung gi yayuu ǝndǝi, kwɔ nyi gi Fuh a oloi ɓǝ.<verse eid="EPH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4" />Kwoi bǝ ɓyǝa nungzuii gi Fuh kpaaɗing, langkwoi bǝ yiɗi bǝi gu tthǝ ɓilǝ ghaaɗing, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />kwɔ ɓi mangǝn yayuu kwɔ ɓumɓui kwɔ dang bǝ laba Fuh u wuo ɓi lǝ nwongǝi tthǝ i Kristi. Ən nung a langǝ i gi Fuh nungkwɔ ɓa tǝi nwongǝi.<verse eid="EPH 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 2:6" />Dangtha i Kristi Yeso u ǝrr ɓi lǝ sua tha i u lǝ yang bǝ ɓi lo yigwoi i u lǝ wayi. <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />Fuh to nungkwɔ yangbǝ tanatthǝ lona ǝndǝi ghaali nung to a langǝ i gu dang bǝ yiɗi bǝi gu kwɔ u taɓinatthǝ dang kristi Yeso ɓǝ. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />Ən ba nung a langǝ i gi Fuh nungkwɔ i nwong ɓǝ tthǝ bǝ dǝnyitthǝ. Ən ba bǝ ɗuong nung ɓǝ lǝu, kwoi ǝn nungdǝ gi Fuh, <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />yangbǝ bǝ yuu akun lǝilo thǝ.<verse eid="EPH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 2:10" />Nung lǝi kwɔ Fuh mab lǝ ba ɓi kwɔ, dang tha i Kristi Yeso kwɔ u mabɓi babǝ to nung to a langǝ i, kwɔ u osi u mab ɓitthǝ ɓi toɓǝ.<verse eid="EPH 2:10" /></para>
  <para style="s">Ɓi Kun Dang Kristi</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Ɓǝkwɔ i siɓǝ lǝ ya Yahudawa lǝu kwɔ- kwɔ ya Yahudawa dǝna lu angǝ&lt;&lt;yakwɔ ɓǝr nwa ɗuǝ lǝu kwɔ&gt;&gt; dǝnni lu loi angǝ ya ɓǝr nwa ɗuǝ (nung ɓǝ lǝ nungkwɔ yaɓǝi dǝna to lǝ tthǝi ɓǝ) ɓa nhǝm vii kwɔ tthasua ɓǝ ǝn ya ɓǝ. <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />Lona lǝ kullo ɓǝ ǝn yayuu gi Kristi lǝu. Ɓǝ ǝn ya yol tthǝ ya israila langkwoi ɓa yangǝu dang yayuu kwɔ Fuh mko lǝ yayuu gu ɓǝu. Ɓa yangǝu dang yakwɔ Fuh gwab bǝi nwa ɓǝu, ɓa yangǝu i bǝ dǝnyitthǝ langkwoi i bǝ ǝǝ i Fuh longwam.<verse eid="EPH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 2:13" />Kwoi lakwɔ, dang tha ɓǝ i Kristi Yeso, kwɔ viikwɔ tutha i ɓǝ nikwɔ, zii Kristi wuɓǝ lǝ wuɓa gbagtha i Fuh. <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />Kristi i nkolǝ wuɓi lǝ tthǝla tthǝ u kǝb ya Yahudawa i yakwɔ ǝn ya Yahudawa lǝu kwɔ lǝ tha. I tthǝu lǝ u dǝr nung mai kwɔ gab ganglang kwɔ i ǝǝ lǝ ya ɓui tha ɓǝ. <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />U al zuu ya Yahudawa i nung zuu gi i nunglǝi ya daagi, yangbǝ dang ya kabgwoi kwɔ rab kwɔ i ǝǝlǝ yayuu kun, dang tha i tthǝulǝ, nunglǝi kwɔ u wullǝ bǝ ǝǝ tthǝla.<verse eid="EPH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EPH 2:16" />I bǝ ɓui ɓua gu lo kab gangǝ i Kristi thǝb ɓui kwɔ ganglangǝ i ɓǝ; tthǝ kab gangǝ i u kǝb ya kabgwoi kwɔ dang tthǝ kun u wui lǝ sua Fuh.<verse eid="EPH 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 2:17" />Nungkwɔ Kristi wuo wuu gei nwaba a langǝ i bǝ ǝǝ tthǝla lǝ yayuu tthǝ ǝndǝi-sua ɓǝ yakwɔ ǝn ya Yahudawa lǝu ɓǝ, kwɔ tuu tha i Fuh niɓǝ, langkwoi sua ya Yahudawa, yakwɔ gbag tha i u niɓǝ. <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />Tthǝn tthǝ Kristi nungkwɔ ɓi ǝndǝi, ya Yahudawa i ya kwɔ ǝnya Yahudawa lǝu kwɔ, tǝi bǝ kǝbtha lo dang Ɓyang kun ɗǝgsi Daa.<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />Nungkwɔ yang, ɓǝ yakwɔ ǝn ya Yahudawa lǝu kwɔ ɓǝ ǝn ya losua a kun lǝu ko ǝn yayol lǝu langkwoi; ɓǝ ǝn ya losua kun i yayuu gi Fuh langkwoi ya dang woi gi Fuh.<verse eid="EPH 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 2:20" />Ɓǝ, lang ɓǝ, i mai ɓǝ lo pi kǝm kwɔ ya nwatummi gi Yeso i ya gei ba a tthasi li ɓǝ, tal a langǝ i ɓǝ ǝn Kristi Yeso i nko lǝ.<verse eid="EPH 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 2:21" />Yeso lǝ yuu a kwɔ muo nungmai ɓǝ ǝndǝi dǝ tthǝ tha langkwoi u mǝrrǝm lǝ kǝm nyǝknung kwɔ i dǝlǝ Dangbang tthǝ ɓǝ. <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />Dang tha i u lǝ ɓǝ lang ɓǝ i mai ɓǝ sua tha i yakwɔ dang bǝi kwɔ Fuh ǝǝtthǝ tthǝ Ɓyang gu ɓǝ.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">Bulus Ghaiba Fuh Lǝ Yakwɔ Ənya Yahudawa Lǝuɓǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Lǝba bakwɔ ɓang, Bulus, ya pursǝna gi Kristi Yeso lǝ baɓǝ yakwɔ ǝn ya Yahudawa lǝu kwɔ, dǝmǝn pinwa tthǝ Fuh. <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />Ən ba a langǝ i ɓa lǝ angǝ Fuh dang nung a langǝ i gu dǝm nung to kwɔ yang bǝ ǝn to lǝ ba ɓǝ.<verse eid="EPH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 3:3" />Fuh ɓko ba gu lim tthǝ nungwambǝi langkwoi u yim ǝn i bǝi. (Ən vullǝ nung tuab bǝng lo nung kwɔ, <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />langkwoi nǝɓa than nungkwɔ ǝn vullǝ kwɔ, yang ɓa ibǝi bǝ ibǝ nungǝm i ba gi Kristi kwɔ ilǝ nungwambǝi ɓǝ.<verse eid="EPH 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 3:5" />Lona kwɔ viikwɔ i gei nungkwɔ lǝ thayuu tthǝlǝu, kwoi Fuh tamnatthǝ lakwɔ tthǝ Ɓyang lǝ ya nwatummi gi Yeso i ya gei ba a tthasi. <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />Ba bǝ pyǝa ɓǝ nungɓǝ lǝ tthǝ nwaba a langǝ i yakwɔ ǝn ya Yahudawa lǝu kwɔ tthǝ i bǝdǝi i ya Yahudawa dang bǝ khana lo gi Fuh; i ǝn ya dang woi tthǝ kun langkwoi i gab bǝ gwab nwa gi Fuh kwɔ gwab tthǝ Kristi Yeso.<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />I mǝrrǝm lǝ thǝb gi nwaba a langǝ i i nung dǝ gi Fuh a langǝ i, kwɔ u dǝm tthǝ bǝ to nung ttha gu ɓǝ. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />Ən ɓanglǝ a tuab dang yayuu gi Fuh ǝndǝi; Fuh lalǝi dǝm nung a langǝ i bǝ gei nwaba a langǝ i dang yakwɔ ǝn ya Yahudawa lǝu ɓǝ lǝba nungtǝi gi Kristi kwɔ thǝmmu ɓǝ, <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />Yang langkwoi to yayuu ǝndǝi ɓyǝa nungkwɔ Fuh tolǝ bǝ pyǝa tthanlǝ ttha i tolǝ nung to. Fuh, kwɔ lǝ ya mab nung ǝndǝi kwɔ, pyǝa ba dang wuo dang wam kpaatthǝ kwɔ pa ɓǝ, <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />yangbǝ lona kwɔ ɓi dang ǝu kwɔ, ba ya kǝm pinwa, ya nwatummi lo yigwoi i ttha i dang wayi a na yiggǝi gi Fuh nunglǝi ǝndǝi.<verse eid="EPH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 3:11" />Fuh to nungkwɔ tthǝ ba nung a ɗing gu, kwɔ u totthǝ Kristi Yeso Dangbang ɓi. <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />Dangtha ɓi i Kristi i bǝ dǝnyitthǝ ɓi tthǝulǝ ɓitthǝ i ttha ɓi tǝ ɗǝgsi Fuh i tthǝnyimmi. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Dǝmǝn yamɓǝ, yang, bǝ tthǝ ɓǝ muanthǝ bakwɔ dǝmǝn to zui baɓǝ ɓǝ; ǝndǝi ǝn babǝ tǝi ghaali nungɓǝ.<verse eid="EPH 3:13" /></para>
  <para style="s">Bǝ Yidɗibǝi Gi Kristi</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Lǝ ba ɓǝ kwɔ ǝn bai nwa longǝm sua tthasi Daa, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />tthǝu lǝ kwɔ ya bǝpi gu wayi i pangsua tǝi ɗuǝnni tthǝɓǝ. <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />Dǝmǝn yam Fuh dang ghaali nungtǝi gu u dǝ ɓǝ ttha tthǝ Ɓyang gu yang bǝ ɓa dǝi nyim thǝ dang nyi ɓǝ,<verse eid="EPH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 3:17" />langkwoi dǝmǝn pinwa gei gǝ Kristi li pi kǝm gwoi gu dang nyi ɓǝ tthǝ bǝ dǝnyitthǝ. Dǝmǝn pinwa yangbǝ yǝng ɓǝ tǝ pangsua nyimtthǝ dang bǝ yiɗi bǝi,<verse eid="EPH 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 3:18" />yang bǝ ɓǝ, sua tha i yayuu gi Fuh ǝndǝi, a tǝi ttha kwɔ a i bǝ aili i gonni, tǝyi i tuli, gi bǝ yiɗi bǝi gi Kristi<verse eid="EPH 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 3:19" />Ni, kaso ɓa wɔ bǝ ibǝ bǝ yiɗi bǝi gi kristi bǝ ko kwɔ i ɓuan i ɓyǝa ǝndǝiu-yang ɓǝ kiggǝ Fuh ǝǝ tthǝ ɓǝ lǝ ghaatthǝ.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />Tthǝ yuu akwɔ tthǝ i ttha gu kwɔ dǝna to nung to dang tthǝ ɓi kwɔ a ɓuan a to nungkwɔ ɓi ɓib piu lǝuɓǝ, ko kwɔ ɓi nhǝm lǝu ɓǝ: <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />Ghaali ǝn a bǝ Fuh dang kǝm pinwa i Kristi Yeso lona ǝndǝi, laɗing langkwoi laɗing! Dǝitthǝ manungɓǝ.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">Ya Dǝba A Langǝ i Kǝbtha Lo Dang Kristi</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Dǝmǝn yiɗi ɓǝ, yang-ɓang kwɔ lǝ ya pursǝna ba kwɔ dǝmǝn wab Dangbang ɓǝ: ɓa ǝǝ bǝ ǝǝ kwɔ natha i nungkwɔ Fuh yiɗi kwɔ u lubǝiɓǝ ɓǝ. <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />Vii ǝndǝi ɓa ǝǝ lǝ ya ɓuob lo ɓǝ sua, ɓa to lo angǝ a thǝ, langkwoi ya tthǝb nyitthǝ. Ɓa tana tthǝ bǝ yiɗi bǝi ɓǝ ibǝ lǝi nyi a langǝ i i tha. <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />Ɓa ɗuong nung ɓǝ ɓa kang bǝ kǝb tha lo kwɔ Ɓyang a Langǝ i dǝ lǝ ba bǝ ǝǝ a langǝ i kwɔ tthǝb ɓǝ tthǝ tha ɓǝ.<verse eid="EPH 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 4:4" />Tthǝ kunɗǝng langkwoi Ɓyang kunɗǝng, manungkwɔ bǝ dǝnyitthǝ kunɗǝng kwɔ Fuh lubǝiɓǝ ɓǝ.<verse eid="EPH 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 4:5" />Dangbang kunɗǝng, bǝ dǝnyitthǝ kunɗǝng, bǝ wollmung kun; <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />Fuh kun langkwoi Daa yayuu ǝndǝi, kwɔ lǝ Dangbang yayuu ǝndǝi, dǝna to nung to tthǝ yayuu ǝndǝi, langkwoi dang yayuu ǝndǝi.<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />Ɓǝ ǝndǝi i dǝ ɓǝ nung manungkwɔ Kristi dǝ lǝ ko ǝn yia ǝndǝi ɓǝ.<verse eid="EPH 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 4:8" />Manung kwɔ nungvullǝ gei kwɔ angǝ,</para>
  <para style="q1" vid="EPH 4:8">&lt;&lt;kwɔ u tǝ bǝi a tǝyi tthǝ kwɔ,</para>
  <para style="q2" vid="EPH 4:8">u ee yakwɔ i mui kwɔ nkolǝ kpaatthǝ;</para>
  <para style="q2" vid="EPH 4:8">u dǝ nungdǝ lǝ yayuu.&gt;&gt;<verse eid="EPH 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />Lakwɔ, ǝn ɓǝ &lt;&lt;u tǝ wayi&gt;&gt;dǝna gei? Dǝna gei angǝ la nwasiu u wuo dang longwam. <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Nungkwɔ yuu akwɔ pin pangsua kwɔ ǝn u ɓǝkwɔ u kwoi u tǝyi, wayi langkwoi patǝ wayi, yangbǝ tǝ lam longwam ǝndǝi.<verse eid="EPH 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 4:11" />Ən u udǝ &lt;&lt;nungdǝ lǝ yakun&gt;&gt;; u dǝ yakun lǝ ya nwatummi, yakun lǝ ya gei nwaba a tthasi, yakun lǝ ya gei nwaba a langǝ i, langkwoi yakun lǝ pasto i ya nanatthǝnung.<verse eid="EPH 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EPH 4:12" />U to nung kwɔ yangbǝ u mab nung lǝi lǝ yayuu gi Fuh tthǝ to nung to ya kǝm pinwa, yangbǝ i mai tthǝ Kristi. <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />Langkwoi nungkwɔ ɓi ǝndǝi ɓi gǝm tha bǝ yikun i bǝ dǝnyitthǝ i bǝ i bǝ Yui Fuh; ɓi mǝrǝm lǝ yaku, yang ɓi kǝn tuli bǝi kwɔ Kristi dǝna yiɗi ɓi kǝn ɓǝ.<verse eid="EPH 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 4:14" />Yang lakwɔ ɓi ǝn yathang lǝu, i tuog i tǝllǝ sua i tthasi mangǝn bǝ tǝnglǝ nungkwɔ waa mǝrǝmǝi lǝilǝ bǝi ǝndǝi nanatthǝnung ɗam yayuu, kwɔ dǝna owh yakun lǝ si dǝna to nung aɓau.<verse eid="EPH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 4:15" />Manungkwɔni yang, tthǝ bǝ gei ba a langǝ i dang ɓyang bǝ yiɗi bǝi, ɓi ghaa nunglǝi kwɔ ǝndǝi tthǝ Kristi, kwɔlǝ loɓǝ.<verse eid="EPH 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EPH 4:16" />Tthǝn tthǝu tthǝ ɓi ǝndǝi, kǝb tha ǝǝ tthǝ tha bǝ yikkun, langkwoi ɓui tthǝ muo tthǝ tha i ɗig kwɔ u dǝ ɓǝ. Kwɔ nǝ zuggǝ tthǝ dǝna to nung to matthǝ, yang ɓui tthǝ ɓǝ ghaa langkwoi mai tthǝu dang bǝ yiɗi bǝi.<verse eid="EPH 4:16" /></para>
  <para style="s">Nwongǝi Afu Dang Kristi</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Dang ɗuǝn Dangbang, yang, Ən gub ɗuogsui ɓǝ: bǝɓa lilotthǝ ǝǝ mangǝn ya nungwabǝi thǝ, kwɔ bǝ nhǝm bagi ǝn nung a nǝkwam ɓǝ <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />langkwoi kwɔ lonyiǝ dang thǝl ɓǝ. I yangǝu ibǝi dang nwongǝi kwɔ Fuh dǝɓǝ, bakwɔ i ibǝ nung akun lǝu langkwoi i ǝnya ɓuasui. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />I yangǝu i bǝ lǝ tthǝkku; i dǝ loi bǝ to nung a ɓko langkwoi dǝnni to i nung a ɓko kwɔ ǝndǝi i yiɗi bǝ yitthǝ lǝu.<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />Ən nungkwɔ ɓa natthǝ Kristi ɓǝ lǝu!<verse eid="EPH 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 4:21" />La langǝ i ɓa lǝ ba gung, langkwoi manungkwɔ ɓǝ lǝ ya muo suko kwɔ i naɓǝ natthǝ ba a langǝ i gi yeso Kristi. <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />Ɓa wa kiggǝ ɓǝ akun lǝtǝ, kwɔ dǝna to ɓǝ vii ǝndǝi dǝ ɓa ǝǝ dang ǝu ɓǝ-tthǝ aku kwɔ i thǝb ɗambǝi ɓǝ. <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />Ɓa mǝrrǝm dang nyi ɓǝ i bǝ nhǝm ba ɓǝ lǝ a fuu ǝndǝi,<verse eid="EPH 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EPH 4:24" />langkwoi ɓa litthǝ afu, kwɔ Fuh mab dang yiɗi gu langkwoi tanatthǝ dang nwongǝi a langǝ i.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />Bǝ kǝbplǝ akun yangǝu, yang! Ɓǝ ǝndǝi ɓa gei ba a langǝ i lǝ sua ya dǝba a langǝ itthǝ Fuh, bakwɔ ɓi ǝndǝi ya dang woi kun dang tthǝ Kristi. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />Nǝ a nyinyi, bǝ a gwab nyimǝ talǝ bǝ to nung a ɓko thǝ, bǝ a ǝǝ dang nyi ɓǝ lǝ fuh o thǝ.<verse eid="EPH 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EPH 4:27" />Bǝ a dǝ lǝi lǝ Mungkullum thǝ.<verse eid="EPH 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EPH 4:28" />Nǝ dǝma muo nunglǝ ttha, yang a yitthǝ bǝ muo nunglǝ ttha a baipi bǝ to nung a langǝ i i namǝ, yangbǝ a tǝi nungbusɔni kwɔ ma nwonglǝ lomǝ i ya yiɓko ɓǝ.<verse eid="EPH 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EPH 4:29" />Bǝ a gei ba a ɓko thǝ, kwoi ǝn ba a langǝ i, ba akwɔ a nwong yayuu langkwoi yang a wullǝ nung akwɔ ya yuu dǝna yiɗi ɓǝ, yangbǝ nungkwɔ a gei kwɔ a wullǝ nung a langǝ i lǝya kwɔ dǝna lǝ ba mǝ ɓǝ.<verse eid="EPH 4:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EPH 4:30" />Langkwoi bǝ a to nung kwɔ Ɓyang a Langǝ i gi Fuh kwɔ i iɓǝ lǝ thǝ; Ɓyang gi Fuh ǝn nung ɓi gi Fuh lomǝ lǝ la nyim, la langǝ i Vii dǝna wɔ kwɔ Fuh waa i lǝ dang nung a ɓko.<verse eid="EPH 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EPH 4:31" />Ɓa yitthǝ bǝto nyi, bǝ yiɗi bǝto nung, bǝ to dang wa. Bǝ buogbǝi akun yangǝu ko bǝ dal ɗyǝam, bǝ tthǝngbǝi.<verse eid="EPH 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EPH 4:32" />Manungkwɔni yang, ɓa to nung a langǝ i langkwoi i nyitǝmmi tthǝ tha, ɓa al nung aɓau tha lǝtǝ, manungkwɔ Fuh al nung a ɓko ɓe le tǝ tthǝ Kristi ɓǝ.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s">Ɓa Əǝ Dang Bǝi A Kaikai</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />Kwɔ lakwɔ ɓǝ ǝn yathang gi Fuh kwɔ dǝna yiɗi, ɓa mǝrrǝm mangǝ ɓǝ ǝn a bǝ Fuh. <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />Ɓa ǝǝ i lonyi bǝ yiɗi tha, manung kwɔ Kristi yiɗi ɓi langkwoi dǝ nwongǝi gu lǝ ba ɓi mangǝ ǝn kum nung kwɔ dǝna yǝl latthǝ kwɔ Fuh dǝna dǝ tthǝ la lǝ Fuh ɓǝ.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />Lakwɔ ɓǝ ǝn yayuu gi Fuh kwɔ, mko kwɔ ɓa lo i si yuu i bǝ to nung a ɓko i ilag nung dang ɓǝ thǝ. <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />Ko ɓa geiba lǝ nwa yathang kwɔ dǝnni mǝrǝm ɓǝ, bǝɓa geiba aɓau, i ba a nǝkwam thǝ. Manung kwɔni yang ɓa kha Fuh.<verse eid="EPH 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 5:5" />Ma gungwab mangǝ yuu yangǝu kwɔ dǝna ɓa si yuu, dǝna to nung a ɓko, ya ɗǝlag (kwɔ u ǝn ya wab nung a kun) kwɔ a tǝi bǝi bǝ lo yigwoi gi Kristi lang i a bǝ Fuh.<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />Bǝ a gwab yuu akun ɗamma i ba sullǝ thǝ; tthǝn tthǝ i bakwɔ nyi gi Fuh a wɔ lo yakwɔ gwab ba gu lǝuɓǝ. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Manungkwɔni yangbǝ ɓato nung akun i yayuu akwɔ manungkwɔni ɓǝ thǝ. <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />Vii kwɔ nungsi ɓǝ dang bǝthǝl, lakwɔ ɓǝ dang lua gabbǝi gi Dangbang. Ɓa ǝǝ mangǝ ǝn yathang gi lua gabbǝi, <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />lakwɔ ǝn lua gabbǝi nungkwɔ wullǝ nung a langǝ i ǝndǝi, bǝ dǝ ba a langǝ i, i bǝto nung a langǝ i. <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />Ɓa to nung kwɔ ɓa dǝ tthǝla lǝ Dangbang ɓǝ. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Bǝ ɓato nung akwɔ mko kwɔ yayuu dǝna to ɓǝ thǝ, nungkwɔ dang thǝl ɓǝ. Manungkwɔni yang, ɓa wulǝ dang lua gabbǝi <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />(To tthǝkku ɗing kwɔ i gei ba nungkwɔ dǝnni to dang bǝthǝl ɓǝ.) <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />Yang lakwɔ nungkwɔ ǝndǝi i ilǝ nungpangbǝi yang yayuu a ɓyǝa; <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />nung kwɔ ǝndǝi i ilǝ nungpangbǝi kaitthǝ yang mǝrǝm lua gabbǝing. Ən ba ɓǝ bǝ nungkwɔ i gei angǝ,</para>
  <para style="q1" vid="EPH 5:14">&lt;&lt;Ɓa ǝrr, ya lo nung lo,</para>
  <para style="q2" vid="EPH 5:14">kwoi ɓa ǝrr bǝ ɓuiɓua,</para>
  <para style="q1" vid="EPH 5:14">Kristi a gab lua loɓǝ.&gt;&gt;<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Niyang ɓa ǝǝ dang kiggǝ ɓǝ. Bǝɓa ǝǝ mangǝ ǝn yakwɔ ibǝ nung lǝu ɓǝ thǝ, ɓa ǝǝ mangǝ ɓǝ ǝnya yiggǝi.<verse eid="EPH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EPH 5:16" />Ɓa tonungto i lonna kwɔ ɓa tǝi ɓǝ, bakwɔ ɓi tthǝn longwam mungkullum ɓǝ.<verse eid="EPH 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 5:17" />Bǝ ɓa mǝrǝmlǝ ya sullǝ thǝ, langkwoi, langkwoi ɓa ibǝ nungkwɔ Dangbang dǝna yidɗi ɓato ɓǝ.<verse eid="EPH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18" />Bǝ ɓa fǝr i min thǝ, kwɔ a tǝbǝ liɓǝ dang nung aɓau ɓǝ; manungkwɔni yang, ɓa ɓko dang wa ɓǝlǝ Ɓyang gi Fuh tthǝ. <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />Ɓa gei balǝ thatthǝ i ba dang Zabura, ɓin, i ɓin a langǝ i; ɓa lub ɓin i Zabura lǝ Dangbang tthǝ ibǝ khko dang nyiɓǝ. <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />Dang ɗuǝn Dangbang Yeso Kristi ɓi, vii ǝndǝi ɓi kha Fuh Daa ɓi.<verse eid="EPH 5:20" /></para>
  <para style="s">Yasi I Yaɓǝi</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />Ɓa kǝblo ɓǝlǝ tha ba ghaali gi Kristi.<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />Yasi, ɓa dǝ lo ɓǝ lǝ yaɓǝi ɓǝ manungkwɔ ɓa dǝ lǝ Dangbang ɓǝ. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Manungkwɔ yiɓǝi tthǝ i ttha lo siu manung kwɔ Kristi tthǝ i ttha lo kǝm pinwa ɓǝ; langkwoi Kristi i nkolǝ lǝya nwong lo ya kǝm pinwa, kwɔlǝ tthǝu ɓǝ.<verse eid="EPH 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EPH 5:24" />Manungkwɔni yang yasi a dǝloi lǝ yaɓǝi gi manungkwɔ ya kǝm pinwa dǝ loi lǝ Kristi ɓǝ.<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />Yaɓǝi, ɓa yiɗi yasi manungkwɔ Kristi yiɗi ya kǝm pinwa dǝ nwongǝi gu lǝ ba gi ɓǝ. <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />U to nung kwɔ yang bǝ u dǝ kǝm pinwa lǝ Fuh lǝ ba gu, manungkwɔ u ɗiggǝu itthǝ dang mungki ɓǝ,<verse eid="EPH 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EPH 5:27" />Yangbǝ u wullǝ kǝm pinwa lǝ tthǝu i mali gu matthǝ i nung a ɓko yangǝu tthǝu, nung lua yangǝu i nung manungkwani nungkwɔ a ǝǝ matthǝ nung a ɓko yangǝu tthǝu ɓǝ.<verse eid="EPH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EPH 5:28" />Manungkwɔ yang ɓǝ Yaɓǝi ɓa yiɗi yasi ɓǝ manung kwɔ ɓa yiɗi loɓǝ ɓǝ. (Yiɓǝi kwɔ nǝ dǝna yiɗi siu yang dǝna yiɗi lo.<verse eid="EPH 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EPH 5:29" />Yuu yangǝu a la tthǝu i nkolǝu. Manungkwɔ ni yang, ɓi tangǝ i lǝ, ɓi mabbǝi, manungkwɔ Kristi tolǝ ya kǝm pinwa ɓǝ.) <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />Ɓi ǝnya dang tthǝu.) <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />Manungkwɔ ba gi Fuh gei kwɔ,&lt;&lt;Lǝ ba kwɔ yiɓǝi a yitthǝ Daa gu i Naa gu a kǝbtha i siu, i rab kwɔ i mǝrrǝm tthǝ kun, <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />Nung tu ɗing dang ba gi Fuh kwɔ, kwɔ ǝn ibǝi lǝ ba gi Kristi i kǝm pinwa ɓǝ.<verse eid="EPH 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EPH 5:33" />Kwoi manungɓǝni i mǝ: yaɓǝi ǝndǝi a yiɗi yasi gi manung a kwɔ i yiɗi tthǝi ɓǝ, langkwoi yisi a dǝ angǝ a lǝ ɓǝiu.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">Yathang I Yayuu Gi</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />Yathang, ǝn nung to ya kristǝ ɓa dǝ angǝ a lǝ yakwɔ siɓǝ ɓǝ, nungkwɔ ǝn nungɓǝlǝ nung a langǝ i kwɔ ɓa toɓǝ. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />&lt;&lt;Ɓa dǝ angǝ a lǝ Daa ɓǝ i Naa ɓǝ&gt;&gt; ǝn zuu a nungsi kwɔ Fuh gwab nwuo ɓǝ: <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />manungkwɔni yang a tǝ latthǝ i ɓǝ lǝ, yang ɓa ǝǝ lona kpaatthǝ longwam.&gt;&gt;<verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />Ya Daa, bǝ ɓa to yathang nunglǝi kwɔ a ɓanglǝ dang wai ɓǝ thǝ. Manungkwɔni yang, ɓa ǝrrǝi lǝ nunglǝi bǝ toba gi Fuh langkwoi ɓa nainatthǝ nung a langǝ i.<verse eid="EPH 6:4" /></para>
  <para style="s">Ya Thǝb I Ya Togwoi Gi</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />Thǝb, ɓa gwab ba ya togwoi ɓǝ ya longwam ɓa surri i bǝ ji angǝ a nyimtthǝ; yang ɓa toi tthǝ lonyi kun, manung kwɔ dǝɓa wab Kristi ɓǝ. <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />Ɓa toi nung kwɔ tthǝ ǝn ba kwɔ dǝnni ɓyǝa ɓǝ ɓǝlǝu, ǝn ba kwɔ ɓa tǝi bǝ yiɗi bǝi gi ɓǝ; langkwoi i dang wa ɓǝ ǝndǝi ɓa to nung kwɔ Fuh dǝna yiɗi ɓǝ, manung thǝb gi Kristi.<verse eid="EPH 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 6:7" />Ɓa to nung to ɓǝ mangǝ ɓǝ ǝn thǝb lonyi kun, mangǝ dǝɓa wab ǝn Dangbang, mangǝ ǝn thayuu a nǝkwam lǝu.<verse eid="EPH 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 6:8" />Ɓi nhǝm Dangbang wa kwai ɓi, ko mǝ ǝn thǝb ko ǝn thǝb lǝu, ǝn ba nung to a langǝ i kwɔ ɓi to ɓǝ.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />Ya togwoi, ɓa to manungɓǝ lǝ ya thǝb ɓǝtthǝ bǝ ɓa ǝrr lǝ kiggǝi thǝ. Ɓa nhǝm ɓǝ i ya thǝb ǝndǝi togwoi ɓǝ kun wayi, kwɔ a to ɓǝ kwan tthǝ ɓǝ ǝndǝi nattha ɓǝ.<verse eid="EPH 6:9" /></para>
  <para style="s">Nung Litthǝ Taɓui Gi Fuh</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />Tthasua ǝndǝi, ɓa kǝb tha ɓa lǝ thǝ i Dangbang i tthǝ nyi gu angǝ a.<verse eid="EPH 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 6:11" />Ɓa li nung taɓui ǝndǝi kwɔ Fuh dǝɓǝ ɓǝ, yangbǝ ɓa ɓuan ɓa dǝi nyimtthǝ ɓa taɓui i Mungkullum i bǝ ɗambǝi gu. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Dǝɓi ɓuob vǝm i thayuu lǝ lǝu kwoi dǝ ɓi ɓuob vǝm i ɓyang a ɓko kwɔ longwam kwɔ ɓǝ, ya lo yigwoi wayi lǝ, ya ttha, i ya kwɔ dang thǝl longwam kwɔ ɓǝ. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />Manungkwɔni yang ɓa linung taɓui gi Fuh nǝnǝng kwɔ! Yang kwɔ nǝ vii a ɓko nǝ Wuo, ɓa kǝbtha i ya ɓuiɓǝ lǝ ǝn kǝb; yang langkwoi ɓa dǝi nyimtthǝ.<verse eid="EPH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14" />Ɓa dǝi nyimtthǝ, i ba a langǝ i i nung tthǝb luiɓǝ, i ba a langǝ i lǝ nung ka nyingwu ɓǝ,<verse eid="EPH 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 6:15" />i aũ bo ɓǝ ɓa dǝi lo bǝ gei nwaba a Langǝ i i bǝ ǝǝ tthǝla. <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />Lona ǝndǝi ɓa lǝi bǝ dǝnyitthǝ lǝ gyǝn; i gyǝn ɓǝlǝ ɓa mual ɓuci lua Mungkullum dǝna ta ɓǝlǝ ɓǝ. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />Ɓa mua bǝ nwong lo mangǝ ǝn nung bailo ɓui, langkwoi ɓa mua ba gi Fuh mangǝ ǝn khafai kwɔ Ɓyang dǝɓǝ ɓǝ.<verse eid="EPH 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 6:18" />Ɓa to nungkwɔ ǝndǝi dang bǝ pinwa, ɓa yam bǝ nwongbǝi gi Fuh. Ɓa pinwa vii ǝndǝi, manungkwɔ Ɓyang owh ɓǝlǝ si ɓǝ. Manungkwɔni yang ɓa ǝǝ dǝ ɓa ki langkwoi bǝ thǝm ɓǝ thǝ; ɓa pinwa vii ǝndǝi lǝ yayuu gi Fuh tthǝ.<verse eid="EPH 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 6:19" />Langkwoi ɓa pim nwa tthǝ, yangbǝ Fuh dǝm bagu tthǝ nwam kwɔ nǝ dǝmǝn yiɗi bǝ geiba, yang mǝn gei nwaba gu vulli yangǝu yang ǝn illǝ ba a langǝ i nungpangbǝi bǝ pyǝko yangǝu. <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />Lǝba ba a langǝ i kwɔ ɓang ǝn ya nwatummi, ko kwɔ lakwɔ tthǝbǝm dang pursǝna i sarka. Ɓa pim nwa tthǝ yangbǝ ǝn gei ba a langǝ i bǝ survulli yangǝu manungkwɔ kaso mǝn gei ɓǝ.<verse eid="EPH 6:20" /></para>
  <para style="s">Bǝ Gumbǝi A Tthasua Əndǝi</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />Tikikus, young ɓi kwɔ dǝɓi yiɗi kwɔ thǝb ya dǝnyitthǝ dang nung to gi Dangbang, a gei ɓǝ ba tthǝ ǝndǝi lǝ bam, yang bǝ ɓa ibǝ nung kwɔ dǝmǝn to ɓǝ. <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />Nungkwɔ to dǝmǝn tummu sua ɓǝ-yang bǝ tǝu gei ɓǝ nung kwɔ dǝ ɓi to ɓi ǝndǝi langkwoi u dǝ ɓǝ tthǝnyimmi.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />Kaso Fuh Daa ɓi i Dangbang Yeso Kristi dǝ yayuu Fuh bǝ ǝǝ a langǝ i i bǝ yiɗi tha i bǝ dǝnyitthǝ Fuh.<verse eid="EPH 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EPH 6:24" />Kaso nung a langǝ i Fuh ǝǝ i yakwɔ ǝndǝi dǝna yiɗi Dangbang ɓi Yeso Kristi kwɔ bǝ yiɗi bǝigu ɓuiu ɓǝ.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>