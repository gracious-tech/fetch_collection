<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">HEB- MUNGA BIBLE TRANSLATION PROJECT</book>
  <para style="h">HEB</para>
  <para style="toc3">HEB</para>
  <para style="mt">HEB</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">Ba Gi Fuh Nwa Yuiu</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Tthasua kullo Fuh gei ba lǝ ya bǝba ɓi lona kpaatthǝ langkwoi nunglǝi kpaatthǝ tthǝ ya gei ba a tthasi, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />kwoi dang vii a tthasua kwɔ u gei ba nwa Yuiu. Tthǝn tthǝu Fuh mab longwam i wayi, yuu akwɔ Fuh mko yangbǝ u dǝilo nung ǝndǝi vii asua ɓǝ.<verse eid="HEB 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 1:3" />Yui Fuh ɓǝ gablua tthǝ ghaali gi ba Fuh ǝn nungɓǝlǝ nungkwɔ itha i Fuh lǝ ɓǝ, u muo lowayi i ttha ba gu. Tthasua kwɔ u muo nung a langǝ i tthǝ bǝ yǝrnwa tthǝ nung a ɓko gi thayuu ǝndǝi, ǝrr u ǝǝsua lona a nali gi Fuh, bǝ ǝǝ angǝ a.<verse eid="HEB 1:3" /></para>
  <para style="s">Ghaali Gi Yui Fuh</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />Yui ɓǝ ghaa pǝl ya nwatummi gi Fuh, manung ɗuǝn kwɔ Fuh du kwɔ ghaa pǝl abǝi. <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />Fuh gei ya nwatummi lǝu bokun angǝ,</para>
  <para style="q1" vid="HEB 1:5">&lt;&lt;Mǝ ǝn Yuim;</para>
  <para style="q2" vid="HEB 1:5">Ɗiggǝ kwɔ ǝn mǝrrǝm lǝ Daa mǝng lǝu.&gt;&gt;</para>
  <para style="b" vid="HEB 1:5" />
  <para style="m" vid="HEB 1:5">Ko Fuh gei ba lo ya nwatummi guung,</para>
  <para style="q1" vid="HEB 1:5">&lt;&lt;Mǝng mǝrrǝm lǝ Daa gu,</para>
  <para style="q2" vid="HEB 1:5">langkwoi u mǝrrǝm lǝ yuim.&gt;&gt;<verse eid="HEB 1:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />Langkwoi kwɔ Fuh dǝna tum nwasi Yuiu longwam, u gei angǝ,</para>
  <para style="q1" vid="HEB 1:6">&lt;&lt;Ya nwatummi gi Fuh ǝndǝi a wabbu.&gt;&gt;<verse eid="HEB 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 1:7" />Langkwoi lǝ ba ya nwatummi Fuh gei angǝ,</para>
  <para style="q1" vid="HEB 1:7">&lt;&lt;Fuh mab wa lǝ ya nwatummi gu tthǝ,</para>
  <para style="q2" vid="HEB 1:7">kwoi ya thǝb gu u ji bǝb lua.&gt;&gt;<verse eid="HEB 1:7" /></para>
  <para style="b" />
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Lǝ ba Yui ɓǝ, manungkwɔ ni yang:</para>
  <para style="q1" vid="HEB 1:8">&lt;&lt;Bǝ lo yigwoi mǝ, mǝ Fuh, a ǝǝ laɗing langkwoi laɗing!</para>
  <para style="q2" vid="HEB 1:8">A dǝ kab nwa yayuu mǝ la langǝ i.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />A yiɗi nung to a langǝ i yang a la nung a ɓko.</para>
  <para style="q1" vid="HEB 1:9">Lǝ ba ɓǝkwɔ Fuh, kwɔ lǝ Fuh mǝ, mko ɓǝ</para>
  <para style="q2" vid="HEB 1:9">langkwoi u da tthǝla i ghaali ghaatthǝ langkwoi tutthǝ ɓǝ</para>
  <para style="q2" vid="HEB 1:9">pǝl akwɔ u dǝlǝ yakwɔ dǝma kǝbtha lo i ilǝ ɓǝ.&gt;&gt;<verse eid="HEB 1:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />Langkwoi u gei angǝ,</para>
  <para style="q1" vid="HEB 1:10">&lt;&lt;Mǝ, Dangbang, la nwasiu a mab pangsua,</para>
  <para style="q2" vid="HEB 1:10">langkwoi i namǝ a mab wayi.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />I nungkwɔ ǝndǝi pǝmpa, kwoi mǝ amǝ ma ǝǝ laɗing;</para>
  <para style="q2" vid="HEB 1:11">i ǝndǝi i kuu mangǝ ǝn nunglitthǝ.<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />Ma kuluam mǝi mangǝ ǝn nung ɓuobtthǝ,</para>
  <para style="q2" vid="HEB 1:12">langkwoi i prǝmmǝi mangǝ ǝn nunglitthǝ.</para>
  <para style="q1" vid="HEB 1:12">Kwoi mǝ amǝ ma dǝi manungɓǝni vii ǝndǝi,</para>
  <para style="q2" vid="HEB 1:12">langkwoi nwongǝi mǝ thǝmmu.&gt;&gt;<verse eid="HEB 1:12" /></para>
  <para style="b" />
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Fuh gei lǝ ya nwatummi gu bo kun lǝu angǝ:</para>
  <para style="q1" vid="HEB 1:13">&lt;&lt;A ǝǝ bǝikwɔ lonam a nali</para>
  <para style="q2" vid="HEB 1:13">tǝlǝ vii kwɔ mǝn dǝ ya ɓui mǝ</para>
  <para style="q2" vid="HEB 1:13">lǝ thko nung dǝbo mǝ.&gt;&gt;<verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />Ən ɓǝttǝn lǝ ya nwatummi gi Fuh, lakwɔ? I ǝn Ɓyang kwɔ dǝna to nung to lǝ Fuh tthǝ langkwoi Fuh tummǝi yangbǝ tǝi nwong yakwɔ a muo bǝ sob lo gu ɓǝ.<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">Bǝ Sob Lo Angã</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Yangbǝ ɓi muo kiggǝ ɓi nyimtthǝ so ɓi yitthǝ ba a langǝ i kwɔ ɓi lǝɓǝ, yang so i kwoi ɓilǝ nunglǝi a langǝ i lǝng. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Ba gi Fuh kwɔ ya nwatummi gi Fuh gei lǝ ya bǝba ɓitthǝ mǝrrǝmlǝ ba a langǝ i, yakwɔ muo suo lǝu langkwoi dǝ ba a langǝ i tthǝ lǝu i muo bǝ gub ɗuogsui kwɔ natha i ilǝ ɓǝ. <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />Nǝnǝ, langkwoi, ɓi i dang ǝu nǝ ɓi dǝ kiggǝ ɓitthǝ bǝ tǝi bǝ sob lo lǝu? Dangbang i nkolǝ la nungsi gei ba bǝ sob lo ɓǝ, langkwoi ya kwɔ lǝu kwɔ gei ɓitthǝ angǝ ǝn ba a langǝ i. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Dang lona lǝ ǝndǝi Fuh dǝ shǝdǝ gu lo abǝi tthǝ bǝ to nung fǝmlo i nung to angǝ a i bǝ dǝ Ɓyang a Langǝ i lǝ yuu kwɔtthǝ ǝndǝi u yiɗi ɓǝ.<verse eid="HEB 2:4" /></para>
  <para style="s">Yuu Akwɔ Tǝ Ɓilǝ Bǝ Sob Lo Ɓǝ</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Fuh dǝ ya Nwatummi gu lǝ ya dǝ kabnwa ɓǝ tthǝ longwam afu kwɔ a wɔ ɓǝlǝu. U ǝn longwam kwɔ dǝɓi gei bko ɓǝ. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Manungkwɔni yang, kwɔ i gei bǝi akun dang nungvullǝ ba gi Fuh angǝ:</para>
  <para style="q1" vid="HEB 2:6">&lt;&lt; Ən ɓǝttǝn lǝ yuu, Ən ɓǝniǝ Fuh, kwɔ ɓa nhǝm ba gi ɓǝ;</para>
  <para style="q2" vid="HEB 2:6">yui yuu a nǝkwam, kwɔ ɓa dǝnyi ɓǝ tthǝi?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />A mabbǝi tuab tthasua ya nwatummi mǝ;</para>
  <para style="q2" vid="HEB 2:7">a muo loi i ghaali i bǝ ji angǝ a,<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />a mabbǝi yang i dǝkab nwa nung ǝndǝi.&gt;&gt;</para>
  <para style="m" vid="HEB 2:8">Nungvullǝ kwɔ gei angǝ ǝn Fuh mabbǝi &lt;&lt; lǝ bǝ dǝkab nwa nung ǝndǝi&gt;&gt;; nungkwɔ dǝi nungwambǝi i nung ǝndǝi. Ɓi ibǝi lǝu, nǝnǝ, ɓa ɓyǝa thayuu lǝ ya dǝ kabnwa nung ǝndǝi lakwɔ.<verse eid="HEB 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 2:9" />Lakwɔ dǝɓi ɓyǝa Yeso, kwɔ dang lona tuab kwɔ i mǝrrǝmmu tthasua ya Nwatummi gi Fuh, yangbǝ tthǝ nyitǝmmi gi Fuh u ɓui lǝ ba yayuu ǝndǝi. Ɓi ɓyǝko lakwɔ i muo lo i ghaali i bǝtǝi ghaali lǝ ba bǝ tozuii gu bǝ ɓuiɓua. <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />Ən ba a langǝ i Fuh; kwɔ mab nung langkwoi kang nung ǝndǝi kwɔ, a mǝrrǝm Yeso matthǝ tthǝ bǝ tozuii, yangbǝ u wullǝ yathang kpaatthǝ wuo gab ghaali gu. Yeso inko lǝ wuilǝ bǝ sob lo.<verse eid="HEB 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11" />Bakwɔ u ya mab yayuu tǝi nung a langǝ i u ɗiggǝ nung a ɓko gi yayuu, langkwoi ǝn u i yakwɔ u ɗiggǝi kwɔ i tǝi Daa kun. Ən ba ɓǝ kwɔ nungkwɔ Yeso lǝ tthǝkku bǝ lubbǝi lǝ ya bǝpi gu lǝu ɓǝ. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />U gei Fuh angǝ,</para>
  <para style="q1" vid="HEB 2:12">&lt;&lt;Mǝn gei lǝ yayuum tthǝ ba nungkwɔ ato ɓǝ;</para>
  <para style="q2" vid="HEB 2:12">Mǝn kha dang bǝ gǝmtha gi.&gt;&gt;<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />U gei angǝ, &lt;&lt;Mǝn dǝ nyimtthǝ Fuh.&gt;&gt;Langkwoi u gei angǝ,&lt;&lt; Ɓang kwɔ i yathang kwɔ Fuh dǝm ɓǝ.&gt;&gt;<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Yathang, kwɔ u lubǝi, ǝn yayuu kwɔ tthǝ i nyamtthǝ i zii, Yeso i nkolǝ mǝrrǝm lǝ thayuu manung gi. U to manungɓǝni yangbǝ tthǝ bǝ ɓuiɓua gu yang bǝ u thǝb ibilis, kwɔ i ttha lo ɓua lǝ ɓǝ,<verse eid="HEB 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 2:15" />langkwoi manungɓǝni u ilǝ yakwɔ ǝn ya thǝb nwongǝi dang vulli bǝ sur ɓua.<verse eid="HEB 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 2:16" />Kai nǝkwam ǝn ya nwatummi gi Fuh dǝnnu nwong lǝu, manunkwɔni yang dǝnnu nwong ǝn ya bǝba gi Ibrahim. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />Nungkwɔ dǝna gei ɓi angǝ u mǝrrǝm mangǝ ǝn ya young gu nunglǝi ǝndǝi, yangbǝ u mǝrrǝm dǝnyitthǝ Fuh i bǝ to nyi a langǝ i gi Yikku ya nyǝknung dang bǝ to nung to lǝ Fuh tthǝ, yang bǝ u ee nwa nung a ɓko gi yayuu.<verse eid="HEB 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 2:18" />Lakwɔ u nwong yakwɔ i ɗammi ɓǝ, bakwɔ u i nkolǝ i ɗammu u to zuii ɓǝ.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">Yeso Ghaa Pǝl Musa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Ya youngǝm, yakwɔ langkwoi Fuh lubǝi kwɔ! Ɓa nhǝm Yeso, ya nwatummi kwɔ Fuh tumm yangbǝ wuo mǝrrǝm lǝ Yikku ya Nyǝknung ya dǝ ba a langǝ i tthǝ Fuh kwɔ ɓi dǝ ba a langǝ i tthǝ ɓǝ.<verse eid="HEB 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HEB 3:2" />Dǝnnu dǝnyitthǝ tthǝ Fuh, kwɔ mko angǝ wuu to nung to kwɔ ɓǝ, manungkwɔ Musa dǝnyitthǝ tthǝ bǝ to nung to dang woi Fuh ɓǝ. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Yiɓǝi kwɔ mai gwoi a tǝi bǝ dǝ ghaali pǝl gwoi ɓǝ i nkolǝ. Manungɓǝni langkwoi Yeso tǝi ghaali pǝl Musa.<verse eid="HEB 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 3:4" />Kǝm ǝndǝi, langkwoi, ǝn yuu akun mai- kwoi ǝn Fuh mai nung ǝndǝi.<verse eid="HEB 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 3:5" />Musa ǝn thǝb a langǝ i kwɔ dǝna dǝnyitthǝ dang woi Fuh ɓǝ, langkwoi dǝnnu gei nungkwɔ Fuh a gei tthasi ɓǝ. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Langkwoi Kristi dǝnyitthǝ lǝ Yui kwɔ dǝna ɓyǝa gwoi gi Fuh ɓǝ. Ɓilǝ gwoi gu nǝ ɓi dǝilo bǝ nyimtthǝ ɓi i bǝ nyim ttha ɓi tthǝ bǝ dǝnyitthǝ ɓi.<verse eid="HEB 3:6" /></para>
  <para style="s">Nwongǝi Yayuu Gi Fuh</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Langkwoi lakwɔ, manungkwɔ Ɓyang a langǝ i gei angǝ,</para>
  <para style="q1" vid="HEB 3:7">&lt;&lt;Na lǝ yol Fuh ɗiggǝ kwɔ,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />bǝɓa ɗar lo nyi ɓǝ thǝ, manungkwɔ ya bǝba ɓǝ to i to kiggǝ a ɓko lǝ Fuh,</para>
  <para style="q2" vid="HEB 3:8">manungkwɔ viilǝ kullo i losua a qui kwoi i na Fuh ɓǝ.<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />Fuh gei angǝ bǝikwɔ ya bǝba ɓǝ nam tthǝ langkwoi ɓa nam bǝilǝ,</para>
  <para style="q2" vid="HEB 3:9">dang bo thǝmrab i ɓyǝa nungkwɔ ǝn to ɓǝng.<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />Langkwoi manungkwɔni ǝn ɓanglǝ dang wa i yayuu kwɔ gei angǝ,</para>
  <para style="q2" vid="HEB 3:10">&lt;kiggǝi vii ǝndǝi dǝi bǝ lo yigwoim lǝu</para>
  <para style="q2" vid="HEB 3:10">i la bǝ lǝbǝ gub ɗuogsuim.&gt;<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Nungkwɔ ǝn ɓanglǝ dang wa ǝn zuu nung ǝn geigǝ:</para>
  <para style="q2" vid="HEB 3:11">&lt;I wuo bǝ lǝ tthǝla nwongǝi i ɓanglǝu!&gt;&gt;&gt;<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Ya youngǝm, ɓa dǝ kiggǝ ɓǝ bǝ yuu akun dang ɓǝ ǝǝ i dang wa mungkullum i bǝ la ba gi Fuh kwɔ ɓa mǝrrǝm ɓa yitthǝ ba Fuh a nwongǝi thǝ.<verse eid="HEB 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 3:13" />Manungkwɔni, langkwoi bǝ nung a ɓko ɗam yuu akun dang ɓǝ mǝrrǝm lǝ ya ɓuasui thǝ, ɓa mǝrrǝm lǝ ya nwong tha vii ǝndǝi, manungkwɔ dǝnni gei ba angǝ&lt;&lt; Ɗiggǝ&gt;&gt; kwɔ nungvullǝ ba gi Fuh gei ɓi tthǝ ɓǝ. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Ɓi ǝn ya kǝbtha lo i Kristi nǝ ɓi muo tthǝnyimmi ɓi tǝlǝ bǝ alo manung bǝ dǝnyi kwɔ ɓi dǝ nungsi ɓǝ.<verse eid="HEB 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15" />Manungkwɔ ba gi Fuh gei angǝ:</para>
  <para style="q1" vid="HEB 3:15">&lt;&lt;Na ɓa lǝ yol Fuh ɗiggǝ kwɔ,</para>
  <para style="q2" vid="HEB 3:15">bǝ ɓa ɗar lo nyiɓǝ thǝ, manungkwɔ ya bǝba ɓǝ to ɓǝ</para>
  <para style="q2" vid="HEB 3:15">lona kwɔ i pi ɓuasui lǝ Fuh ɓǝ.&gt;&gt;<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Ən ya ɓǝttǝn lǝ yol Fuh ǝrr lǝ kiggǝ aɓau lǝ Fuh tthǝ? Ən yakwɔ Musa iing lǝ dang Masar ɓǝ. <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />I ya ɓǝ kwɔ Fuh ɓanglǝ dang wa i ilǝ tthaa tthǝmrab ɓa? I yakwɔ to nung a ɓko ɓǝ, kwoi langkwoi owh ɓui losua a kwi ɓǝ.<verse eid="HEB 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 3:18" />Kwɔ Fuh gwabnwa angǝ,&lt;&lt;I tǝ losua kwɔ ǝn gwabbǝi nwa tǝi nwong tthǝ ɓǝu&gt;&gt;-Fuh dǝna gei ba lǝng ya ɓa?Llǝ yakwɔ lǝ ba guu ɓǝ.<verse eid="HEB 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 3:19" />Langkwoi, ɓi ɓyǝa, kwoi i ɓuan itǝ losua ɓǝlǝu, bakwɔ i dǝ ba a langǝ itthǝ Fuh lǝu ɓǝ.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="s">Nwongǝi Vii Nwongǝi Ya Yahudawa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Lakwɔ, Fuh gwab ɓi nwa angǝ ɓi tǝbǝ nwongǝi kwɔ u geiɓǝ. Ɓi to kiggǝ ɓi, lakwɔ, yang yuu yangǝu kwɔ atǝi bǝ muo ba bǝ nwongǝi kwɔu ɓǝ. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Bakwɔ i gei ɓi nwaba a langǝ i gi Fuh tthǝng, manungkwɔ ilǝ ɓǝ. I lǝ baɓǝ, kwoi toi nung a langǝ i tthǝ lǝu, bakwɔ kwɔ i lǝ kwɔ, i muo i lonyi a langǝ i lǝu.<verse eid="HEB 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 4:3" />Manungkwɔni yang ɓi yakwɔ ɓi muo kwɔ, langkwoi, ǝnɓi ɓi muo bǝ nwongǝi gi Fuh ɓǝ. Manungkwɔ u gei angǝ,</para>
  <para style="q1" vid="HEB 4:3">&lt;&lt;Dangwam ɓanglǝ nungkwɔ ǝn zuu nung geigǝ:</para>
  <para style="q2" vid="HEB 4:3">&lt; I tǝ losua kwɔ ǝn ji lǝ ba bǝ nwong gi ɓǝu!&gt;&gt;&gt;</para>
  <para style="m" vid="HEB 4:3">Fuh gei ba kwɔ lona kwɔ u mab longwam ǝndǝi ɓǝ. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Ən ba a langǝ i bǝi akun tthǝ dang nungvullǝ ba gi Fuh geiba lo vii a nanairǝ angǝ:&lt;&lt;Fuh nwong dang bo a nanairǝ tthǝ bǝ tonungto gu ǝndǝi.&gt;&gt;<verse eid="HEB 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 4:5" />Langkwoi u gei bakwɔ akun angǝ:&lt;&lt; Itǝ losua kullo kwɔ ǝn geigǝ mǝn ji tǝi nwong tthǝ ɓǝu.&gt;&gt;<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />Yakwɔ i osi i gei bakwɔ tthǝ kwɔ i muo nwongǝi ɓǝlǝu, bakwɔ i dǝba a langǝ i tthǝ lǝu ɓǝ. Yakun tthǝ, langkwoi, yakwɔ i gwabbǝi tthǝ kwɔ i gei nwaba a langǝ i ɓǝ ɓǝ i nwong i Fuh.<verse eid="HEB 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 4:7" />Ən ba a langǝ i Fuh gei vii akun angǝ, kwɔ i gei angǝ&lt;&lt;Ɗiggǝ.&gt;&gt;Dang ttha kpaatthǝ i gei ba lǝ Dawuda tthǝ dang ba nungvullǝ gi Fuh angǝ, &lt;&lt;Nalǝ yol Fuh ɗiggǝ kwɔ bǝ a ɗar lo nyimǝ thǝ;</para>
  <para style="q2" vid="HEB 4:7">bǝ a to kiggǝ a ɓko thǝ.&gt;&gt;<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />Nǝ ǝn ba a langǝ i Joshuwa dǝ nwongǝi lǝ yayuu kwɔ Fuh gwabbǝi nwa kwɔng yang, Fuh gei ba akun lo ba ɓǝlǝ vii akun niu. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Manungkwɔni, Fuh gwab ɓi nwa vii nwongǝi langkwoi ɓi nwongǝi, kwoi kwɔ yirrǝ wuu lǝu Fuh nwong dang bo nanairǝ.<verse eid="HEB 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 4:10" />Yakwɔ nǝ nwongǝi i Fuh i nwong bǝ tonungto gi, manungkwɔ Fuh nwong nwabǝ tonungto guɓǝ.<verse eid="HEB 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 4:11" />Ɓa dǝisua, langkwoi, ɓi tonung a langǝ i kwɔ ɓi muo nwongǝi kwɔ ɓǝ, yangbǝ yuu yangǝu a owh manung gi yakwɔ i yangǝu bǝ tǝi nwongǝi gwoi Fuh ɓǝ.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />Nwongǝi tthǝ dang ba gi Fuh kwoi nyimɗing, lǝmb pǝll nwa kafyǝi rab. Dǝnna ɓǝr nung ǝndǝi, dǝna tǝ bǝikwɔ nwongǝi i ɓyang kǝbtha tthǝ ɓǝ, dǝna tǝ bǝikwɔ kukub kǝbtha tthǝ i mung dang kub ɓǝ. Dǝnna to kwan lǝ bǝ nhǝm ba dang nyi yuu. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Nung yangǝu kwɔ i pyǝa lǝ Fuh ɓǝ; Nungkwɔ Fuh mab ǝndǝi i ilǝ nung pangbǝi a logwam dang nungǝu. Tthǝn tthasiu ɓi gei nwaɓi.<verse eid="HEB 4:13" /></para>
  <para style="s">Yeso Lǝ Gong Yikku Ya Nyǝknung</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Ɓa dǝisua, langkwoi, ɓi muo bǝ dǝnyitthǝ kwɔ ɓi muo kwɔ nyimtthǝ. Ba kwɔ ɓitthǝ i gong Yikku ya nyǝknung kwɔ patǝ wayi ɗǝgsi Fuh ɓǝ- Yeso, Yui Fuh. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Yikku ya nyǝknung kwɔ ǝn yuu akwɔ a lǝ tthǝku bǝ ɓyǝa nungzuii tthǝ muani ɓiɓǝ lǝu. Nunglǝi lǝ ǝndǝi, ɓitthǝ i yikku ya nyǝknung kwɔ i ɗammu nunglǝi kwɔ ǝndǝi ɓi tthǝ kwɔ, kwoi u to nung a ɓko lǝu.<verse eid="HEB 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 4:16" />Dǝisua ɓi nyim tthǝɓi, langkwoi, yang ɓitǝ bǝ lo yigwoi gi Fuh, bǝikwɔ bǝ lǝ tthǝla tthǝ ɓǝ. Ən bǝiɓǝ tǝɓi tǝi bǝ ɓyǝa nungzuii tthǝ vii kwɔ dǝɓi yiɗi bǝ nwong bǝi ɓǝ.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Yakku ya nyǝknung kwɔ ǝndǝi ǝn yayuu mkoi yangbǝ i toi nung to gi Fuh tthǝ, yangbǝ i dǝ nungdǝ i bǝ nyǝknung lǝ ba nung a ɓko gi.<verse eid="HEB 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HEB 5:2" />Kwɔ ya nyǝknung ɓǝ muanɗing nunglǝi kwɔ ǝndǝi, u dǝi matthǝ u mab ya kwɔ ibǝ nung lǝu i yakwɔ dǝna ɓanglǝ nunglǝi gi ɓǝ.<verse eid="HEB 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 5:3" />Bakwɔ u ma u muanɗing kwɔ, u nyǝknung ǝn ba nung a ɓko gi yayuu ɓuolǝu kwoi lǝ ba nung a ɓko gu.<verse eid="HEB 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 5:4" />Yuu yangǝu mko lo kwoi dǝ angǝ a lǝlo yangbǝ mǝrrǝmlǝ yikku ya nyǝk nungǝu. Ən Fuh lubǝi yang yuu mǝrrǝm lǝ ya nyǝk nung- manungkwɔ Haruna toɓǝ.<verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />Manungɓǝni langkwoi, Kristi tǝlǝ lo tǝ mǝrrǝm lǝ yikku ya nyǝknung lǝu. Manungkwɔni yang, Fuh geiu angǝ,</para>
  <para style="q1" vid="HEB 5:5">&lt;&lt;Mǝ ǝn Yuim;</para>
  <para style="q2" vid="HEB 5:5">ɗiggǝ kwɔ ǝn mǝrrǝm lǝ Daa mǝng.&gt;&gt;<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />Langkwoi U gei bǝi akun angǝ,</para>
  <para style="q1" vid="HEB 5:6">&lt;&lt;Ma mǝrrǝm lǝ ya nyǝknung laɗing,</para>
  <para style="q2" vid="HEB 5:6">manungkwɔ Malkisadaki gei ɓǝ.&gt;&gt;<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />Vii kwɔ Yeso i nwongǝi gu longwam u pinwa langkwoi u tasui i mungnung u yam Fuh i yol, kwɔ a nwongǝu bǝ ɓuiɓua ɓǝ. Bakwɔ u dǝ angǝ a langkwoi dǝi nyimtthǝ, nungkwɔ Fuh lǝ bǝ pinwa gu. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Kwoi kwɔ Yesu ǝn Yui gi Fuh, u nanung tthǝ bǝ to zuii gu U ɓuob lo sua lǝ Fuh tthǝ. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />Kwoi kwɔ Fuh mǝrrǝmmu lǝ yuu angǝ a, u mǝrrǝm lǝ nunglǝi bǝ sob lo a ɗing lǝ yakwɔ tthǝ ǝndǝi gwab ba guɓǝ,<verse eid="HEB 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 5:10" />ǝn ba ɓǝ kwɔ Fuh mǝrǝmmu lǝ yikku ya nyǝknung, manung gi ya gwoi gi Malkisadaki.<verse eid="HEB 5:10" /></para>
  <para style="s">Bǝ Gub Ɗuogsui Lǝ Babǝ Yitthǝ Nunglǝi A Langǝ i</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Ɓi tthǝ i ba kpaatthǝ ɓi gei lo nungkwɔ, kwoi ziiɗing kwɔ ɓi gei ɓǝ, ba kwɔ ɓa muanɗing kwɔ ɓa ibǝi ɓǝ.<verse eid="HEB 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 5:12" />Lona kpaaɗing tthǝɓǝ kwɔ ɓa mǝrrǝm lǝ ya nanatthǝnung ɓǝ- kwoi ɗǝɓa yiɗi yuu akun bǝ naɓǝnatthǝ ɓǝ kwɔlǝ ya nungsi bǝ ibǝ ba Fuh ɓǝ. Manungkwɔ ɓa tang nungtang a nyimmi yang, dǝɓa nwa mungmi.<verse eid="HEB 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 5:13" />Yuu akwɔ nǝ dǝna nwa mungmi yirrǝ yang u ǝn munthang, u ibǝ nunglo bǝ ibǝ nung a langǝ i i nung a ɓko lǝu. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Nungtang a muanni, lona a kunlǝ, ǝn a yakku, kwɔ tthǝ bǝ nanung lǝ yang a ibǝ gab dang nung a mullub i nung a langǝ i.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Ɓa dǝisua ɓitǝ tthasi, lakwɔ, tthǝ bǝ nanatthǝnung angǝ a gi kristi yang ɓi yitthǝ pi kǝm a nungsi tthasua i ba ya Kristǝ. Ɓi yitthǝ bǝ baipi nungkwɔ ɓi kwoi bǝ to nung to a nǝkwam yangbǝ ɓi dǝ ba a langǝ i tthǝ Fuh ɓǝu;<verse eid="HEB 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HEB 6:2" />i bǝ nanatthǝnung lo bǝ wollmung i bǝ dǝna lo; i bǝ ǝrrǝu i nwongǝi i bǝ to kwan a ɗing. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Ɓa dǝisua ɓitǝ tthasi! Yang ǝn nungkwɔ ɓito, nǝ Fuh yiɓi ɓǝ.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Nǝnǝtǝn lakwɔ yakwɔ la ba a langǝ i ɓi kwoi lǝ yangbǝ i yitthǝ nung a ɓko gi? Vii akun kullo i dang bǝ gablua gi Fuh, i bang tthǝla nungdǝ a waying i nwathan Ɓyang a Langǝ i;<verse eid="HEB 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 6:5" />i ibǝing ba gi Fuh maɗing, langkwoi i bang ttha bǝ wuo gi dang wam a tthasiing. <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />Langkwoi yang i la bǝ dǝnyitthǝ gi! A zii ɗing i kwoilǝ wui al nwa ɓko ba gi lǝ tǝ langkwoi, bakwɔ langkwoi dǝnni pi Yui Fuh dǝnni du tthǝkku nung gwambǝi.<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />Fuh khana lo sua kwɔ dǝna nwamung kwɔ dǝna naa lo langkwoi pangsua wullǝ bie nung lǝ ya nung lǝbɓi tthǝ. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Kwoi nǝ kob i gug ghaatthǝ, yang ǝn nung a nǝkwam; thǝn dang zuii kwɔ Fuh dal langkwoi i ɓǝr i li i lua.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Ya ǝnthǝm kwɔ dǝɓi yiɗi niɓǝ, ko nǝ ɓi gei ba manungkwɔni, ɓi ibǝing ɓǝ ǝn ya langǝ i. Ɓi ibǝing ɓǝtthǝ i bǝ khana lo a langǝ i kwɔ wuo tthǝ bǝ sob lo ɓǝ. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Fuh ǝn ya dang wa a ɓko lǝu. Nyiu da tthǝ nung to a langǝ i kwɔ ɓa to ɓǝu ko bǝ yiɗi bǝi kwɔ ɓa yiɗiu lǝ ɓǝu i bǝ nwongbǝi kwɔ ɓa nwong langkwoi dǝɓa nwonglǝ ya Kristǝ yakun ɓǝ.<verse eid="HEB 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 6:11" />Nungkwɔ dǝɓi yiɗi ko ǝn yiǝ ǝndǝi dǝilo bǝ to nung to gu matthǝ tǝllǝ bǝ alo, yangbǝ nungkwɔ u dǝnyitthǝ kwɔ wa ǝǝ lalangǝ i. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />Ɓi yiɗi ko ǝn yiǝ to ɓko lǝu, langkwoi ɓa to manung yakwɔ dǝ ba a langǝ i i ǝn ya nyimnyi, langkwoi yang i muo nungkwɔ Fuh gwabbǝi nwuo ɓǝ.<verse eid="HEB 6:12" /></para>
  <para style="s">Bǝ Gwabnwa Gi Fuh A Langǝ i</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Kwɔ Fuh gwab nwa lǝ Ibrahim, U zuu nung lo nungkwɔ u gwab nwuo ɓǝ. Bakwɔ yuu akun yangǝu ghaa pǝllu ɓǝ, u to nung to i ɗuǝnu kwɔ u zuu lǝ nung. <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />Fuh gei angǝ,&lt;&lt;Ən gwaba nwa mǝn khana lo mǝ langkwoi mǝn da ya bǝpi kpaatthǝ.<verse eid="HEB 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 6:15" />Ibrahim ǝnya tthǝbnyitthǝ, nungkwɔ langkwoi u tǝi nungkwɔ Fuh gwabbu nwa ɓǝ.<verse eid="HEB 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16" />Nǝ ɓi zuu nung, yang ɓi to nung to i ɗuǝn yuu akwɔ ghaa pǝl ɓi ɓǝ, yang bǝ zuu nung dǝna mabnung bǝ nyimnwa ǝndǝi. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />Fuh dǝna yiɗi bǝ mab nung ba gu kaitthǝ yangbǝ ya kwɔ a tǝi bǝ gwabnwa gu kwɔ, angǝ i mǝrrǝm ba giu; nungkwɔ u lilo bǝ gwabnwa gu i nung zuu. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />Yang nungtthǝ ni rab, kwɔ ɓuan mǝrrǝm mu ɓǝ, Fuh kǝb pǝllǝu. Langkwoi ɓi ya kwɔ ɓi tǝi nwongǝi tthǝ Fuh kwɔ bǝ gwabnwa gu dǝna dǝɓi tthǝnyimmi ghaatthǝ ɓi muo bǝ dǝnyitthǝ kwɔ tthasi ɓi kwɔ nyimtthǝ.<verse eid="HEB 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 6:19" />Ɓi tthǝ i bǝ dǝnyitthǝ mangǝ ǝn nung yag nung kwɔ muo nwongǝi ɓiɓǝ. Dǝi nyimtthǝ langkwoi ǝn ba a langǝ i, langkwoi dǝna tǝ dang laɓulǝ dang kǝm gi Fuh a wayi dang a nung dang .<verse eid="HEB 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 6:20" />Lǝ nwathan ɓi Yeso owhsi tǝ kullo tǝ ǝǝ lǝ Yikku ya nyǝknung laɗing, u ǝnya nyǝknung manung a bǝ Malkisadaki.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">Yeso Le Yikku Ya Nyǝknung Ɓi</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Malkisadaki ǝn yigwoi ya Salem langkwoi u ǝn ya nyǝknung gi Fuh ɓi ya angǝ a tthǝ ɓǝ. Kwɔ Ibrahim dǝna kwoi nwa ɓui kwɔ tǝu tang ɓui loya yigwoi nai kwɔ, Malkisadaki kǝbbu khana lo, <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />langkwoi Ibrahim du nung kun dang nung sob kwɔ u tǝi ɓǝ. (Dang ɗuǝn a nungsi gi Malkisadaki nungkwɔ lǝ &lt;&lt;Yigwoi ya to nung a langǝ i&gt;&gt;; langkwoi kwɔ u ǝn yigwoi Salem, ɗuǝnnu langkwoi ǝn&lt;&lt; Yigwoi ya tǝm lo nyi.&gt;&gt;) <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />Nungvullǝ yangǝu lo Malkisadaki lǝ ba Daa gu ko Naa gu ko ya bǝba guu; nungvullǝ lo ba bǝ siu ko bǝ ɓuiɓua guu. U ǝǝ mangǝ u ǝn Yui Fuh; u ǝǝ u ǝn ya nyǝknung i nwongǝi laɗing.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Ɓa ɓyǝa, lakwɔ, ghaali gu, Ibrahim bǝba ɓi i ghaali gu, duu nung kun dang sob dang nungkwɔ u tǝi kwɔ ǝndǝi viikwɔ u kwoi bǝ taɓui ɓǝ. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Yakwɔ lǝ ya bǝpi lawi kwɔ lǝ ya nyǝknung zuu gei angǝ i muo nung kun dang sob na ya Israila, nungkwɔ lǝ, na yayuu gi, ko kwɔ i ǝnya bǝpi Ibrahim.<verse eid="HEB 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 7:6" />Malkisadaki ǝnya bǝpi Lawi lǝu, kwoi u muo nung kun dang sob na Ibrahim kwoi khana lo, yiɓǝi kwɔ muo bǝ dǝnung gi Fuh ɓǝ. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Ɓǝ nyimnwa yangǝu yuu akwɔ khana lo kwɔ ghaa pǝl yuu kwɔ muo bǝ khana lo ɓǝng. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Lǝ ba a bǝ ya nyǝknung bǝ muo nung dang nung sob ǝn a bǝ yaɓǝi kwɔ ɓui ɓǝ; kwoi a bǝ Malkisadaki bǝ muo nung kun dang nung sob ǝn yuu akwɔ tthǝ i nwongǝi ɓǝ, manungkwɔ nungvullǝ gi Fuh gei ɓǝ.<verse eid="HEB 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 7:9" />Manungkwɔni, nǝ i gei ba yang, nǝ Ibrahim kwai kuung dang sob yang, Lawi (ya bǝpi gu kwɔ dǝna muo nung kun dang sob kwɔ) a kungkwai langɓǝ. <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />Ba kwɔ viikwɔ Malkisadaki kǝbtha i Ibrahim kwɔ, yirrǝ Lawi tthǝn tthǝ bǝba gu.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Ən ba ya Lawi nungkwɔ i wullǝ ya nyǝknung nungkwɔ langkwoi i wullǝ zuu Musa lǝ ya Israila tthǝ. Lakwɔ, nǝ i tǝi nungto a langǝ i tthǝ nungto ya nyǝknung ya Lawi yang, babǝ wullǝ ya nyǝknung akun nǝkwam wuou, ya nyǝknung akun tthǝ lǝ Malkisadaki, ǝn Haruna lǝu. <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Nǝ lakwɔ i prǝm ya nyǝknung yang, bǝ prǝm zuu gi Musa tthǝ. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Lakwɔ Dangbang ɓi, kwɔ i gei bagu kwɔ, U ǝn nwa ya kun, yuu akun yangǝu dang yayuu gu nyǝknung lo tuu bo kun. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />I ibǝi angǝ i siu tthǝn losua Yahuza; Musa gei balo nwa ya gwoi gu lǝu kwɔ dǝnnu gei ba lo ba bǝ nyǝknung ɓǝ.<verse eid="HEB 7:14" /></para>
  <para style="s">Ya Nyǝknung Akun, Mangǝ Ən Malkisadaki</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />Ba ɓǝ igwam kaitthǝ; ya nyǝknung akun illǝ lo lǝ gwam, mangǝ u ǝn Malkisadaki. <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />Yeso mǝrrǝm lǝ ya nyǝknung, ǝnba bǝ lo yigwoi i ba zuu lǝu, kwoi ǝn bǝdǝ ttha nwongǝi kwɔ thǝmu ɓǝ. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Nungvullǝ gei angǝ,&lt;&lt;ma ǝǝlǝ ya nyǝknung laɗing, tthǝ bǝ ba ya nyǝknung Malkisadaki.&gt;&gt; <verse eid="HEB 7:17" /><verse number="18" style="v" sid="HEB 7:18" />Lakwɔ bǝ dǝ kabnwa nung, i dǝ nwangwu, ba kwɔ muanɗing langkwoi ǝn a langǝ i lǝu.<verse eid="HEB 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 7:19" />Lakwɔ zuu gi Musa to nung a langǝ i lǝu. Lakwɔ i dǝɓi bǝ dǝnyitthǝ a langǝ in kwɔ ɓi gɓagtha i Fuh ɓǝ.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />Bǝ lilo, langkwoi nungzuu gi Fuh tthǝ. Lanungsi nungzuu ɓǝ yangǝu kwɔ i mko yakun lǝ ya nyǝknung ɓǝ. <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />Langkwoi Yeso ǝǝlǝ ya nyǝknung ǝn ba nungzuu gi Fuh kwɔ geiu angǝ,</para>
  <para style="q1" vid="HEB 7:21">&lt;&lt;Dangbang gwabnwa ba angǝ</para>
  <para style="q2" vid="HEB 7:21">ǝn mǝrrǝm dang wammu:</para>
  <para style="q1" vid="HEB 7:21">&lt;Ma ǝǝlǝ ya nyǝknung laɗing.&gt;&gt;&gt;<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />Bǝ gab lo kwɔ, lakwɔ, langkwoi mǝrrǝm Yeso lǝ ya dǝ bǝ dǝ ganglang ba a langǝ i.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />Bǝ gab lo akun langkwoi: ya nyǝknung akun tthǝ kpaatthǝ, ba kwɔ i ɓui langkwoi i ɓuan i tonungto giu.<verse eid="HEB 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 7:24" />Langkwoi Yeso ǝǝ laɗing, langkwoi nungto gu bǝ nyǝknung i dǝlǝ yuu akun lǝu.<verse eid="HEB 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 7:25" />Yang lakwɔ u ɓuan, lakwɔ i vii ǝndǝi, u nwong yakwɔ wuo sua Fuh ttha tthǝu lǝ ɓǝ, bakwɔ u ǝǝ i nwongǝi laɗing dǝnnu yam Fuh lǝ ba gi.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />Lakwɔ, Yeso, lǝ yikku ya nyǝknung kwɔ a tǝm lonyi ɓi ɓǝ. U tthǝ i ɓyang; i iulǝ dang ya nung a ɓko langkwoi Fuh du bǝi angǝ a wayi lǝ. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />Yeso natha i sua ya nyǝknung lǝu; u yiɗi bǝ nyǝknung vii ǝndǝi lǝ ba nung a ɓko gu nungsi langkwoi lǝ ba nung a ɓko gi sua yayuu lǝu. U nyǝknung kun, bo kun ɓuo, kwɔ u dǝlo i nkolǝ ɓǝ. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Zuu gi Musa mko yakwɔ ǝn ya langǝ i lǝ ya nyǝknung lǝu; kwoi bǝ gwabnwa ba gi Fuh i nungzuu, kwɔ wuo tthasua zuu, dǝ Yui ɓǝ, kwɔ mǝrrǝm mu lǝ a langǝ i laɗing.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">Yeso Lǝ Yikku Ya Nyǝknung</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Nungkwɔ lo bakwɔ dǝ ɓi gei kwɔ ɓitthǝ i ya nyǝknung angǝ a kwɔ, yuu kwɔ ǝǝ lona a nali bǝ lo yigwoi ya nwongbǝi wayi.<verse eid="HEB 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HEB 8:2" />U lǝ ya to nung to bǝ nyǝknung Bǝi Angã, nungɓǝlǝ, dang tǝbǝ kwɔ Dangbang i nkolǝ mab ɓǝ, ǝn yuu mab lǝu.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />Ya nyǝknung ǝndǝi i ji i dǝ nungdǝ i bǝ nyǝknung i nungbyang lǝ Fuh tthǝ, langkwoi manungɓǝnni Gong ya nyǝknung ɓi langɓǝ tthǝ i nungkwɔ a dǝ ɓǝ.<verse eid="HEB 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 8:4" />Nǝ u longwam, yang u tonungto bǝ nyǝk nungǝu, ba ya nyǝknung ya kuntthǝ kwɔ a dǝ nungdǝ kwɔ zuu gi Musa dǝna yiɗi ɓǝ. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />Nung to kwɔ dǝnni tolǝ ba bǝ nyǝknung kwɔ ǝnba a langǝ i i na langkwoi ǝn killǝng nungkwɔ dǝnni to wayi ɓǝ. Manungɓǝni i Musa. Nǝ dǝnnu tǝ bǝ mab Tǝbǝ a langǝ i, Fuh geiu angǝ, &lt;&lt;A ɓyǝa la langǝ i nungkwɔ a ɓyǝa nungkwɔ i mab i tanatthǝ lotal ɓǝ. <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Kwoi lakwɔ, i dǝ bǝ nyǝknung lǝ Yeso kwɔ ma pǝl abǝi ɓǝ, manung bakwɔ u mab zuiu ganglang gu i Fuh langkwoi i yayuu gu ǝn a langǝ i, bakwɔ i geiu lo bǝ gwabnwa ba a langǝ i ɓǝ<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />Krǝ nǝ zuu a nungsi nǝ ɓanglǝ lǝu, yang ba bǝ to ba zuu a nung rabbu yangǝu. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Kwoi Fuh tǝi nung a ɓko tthǝ yayuu gu nungkwɔ u gei angǝ,</para>
  <para style="q1" vid="HEB 8:8">&lt;&lt;Dangbang gei angǝ vii dǝna wɔ,</para>
  <para style="q2" vid="HEB 8:8">kwɔ yang wuo mǝn illǝ zuu afu i ya Israila i ya Yahuza.<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />A ǝǝ mangǝ bǝ gwab nwa bakwɔ ǝn mab i ya bǝba gi ɓǝlǝu</para>
  <para style="q2" vid="HEB 8:9">vii kwɔ ǝn mui i nalǝ ǝn ii lǝ dang losua Masar ɓǝ.</para>
  <para style="q1" vid="HEB 8:9">I yangǝu i bǝ dǝba a langǝ i tthǝ bǝ gwabnwa bakwɔ ǝnto i ilǝ ɓǝ,</para>
  <para style="q2" vid="HEB 8:9">nungkwɔ langkwoi dang bang gei angǝ ǝn mǝrrǝm mual ǝn tai lǝ.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Lakwɔ, ǝn bǝ gwab nwa bakwɔ mǝn to lǝ ya Israila ɓǝ</para>
  <para style="q2" vid="HEB 8:10">Dangbang gei angǝ, tthasua yang:</para>
  <para style="q2" vid="HEB 8:10">Mǝn dǝ zuum dang wai</para>
  <para style="q2" vid="HEB 8:10">mǝn vullǝ lo nyiǝ</para>
  <para style="q1" vid="HEB 8:10">mǝn mǝrrǝm lǝ Fuh gi,</para>
  <para style="p" vid="HEB 8:10">langkwoi i mǝrrǝm lǝ ya yum.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Yuu akun yangǝu dang ǝi a nanatthǝnung lǝ ǝnthǝi u,</para>
  <para style="q2" vid="HEB 8:11">ko gei ya nwakong gu angǝ,</para>
  <para style="q2" vid="HEB 8:11">&lt;Ɓa ii Dangbang.&gt;</para>
  <para style="q1" vid="HEB 8:11">Ba kwɔ i ǝndǝi i im ǝn iɓǝ,</para>
  <para style="q2" vid="HEB 8:11">baipiu tthǝ ya tuab tǝllǝ tthǝ ya angǝ a.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />Mǝn al nung aɓau gi lǝtǝ</para>
  <para style="q2" vid="HEB 8:12">langkwoi ǝn nhǝm nung aɓau gi akunu.&gt;&gt;<verse eid="HEB 8:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 8:13" />Ba bǝ gei ba lo zuu afu, Fuh mǝrrǝm a nungsi lǝ a kuung; langkwoi nungkwɔ nǝ kuung langkwoi ɓanglǝng yang nǝnǝng kwɔ a la nǝkwam.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">Bǝ Wab Fuh Longwam I Wayi</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Nunglǝi wab Fuh a nungsi tthǝ langkwoi bǝikwɔ ǝn bǝ nyǝknung tthǝ Fuh langɓǝ.<verse eid="HEB 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HEB 9:2" />I mab tǝbǝ, gwamlǝ, i dǝ ɗuǝn bǝiɓǝ angǝ Bǝi a Langǝi. lǝ i dǝ fitilǝ tthǝ i tǝbur i burodi kwɔ i nyǝklǝ nung tthǝ Fuh ɓǝ. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />Tthasua laɓulǝ a nung rabbu kwɔ i ka lǝ kǝm kwɔ tǝbǝ tthǝ kwɔ dǝnni lu ɗuǝnnu angǝ Bǝi A langǝ i Angã.<verse eid="HEB 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 9:4" />Dangǝu lǝ tutthǝ kwɔ dǝnni lii nungkwɔ kummu dǝna yǝl latthǝ ɓǝ i tthko gwab nwa bakwɔ i mab dang ǝu i zinariya kwoi gib turare dang ǝu i manna, kab gi Haruna kwɔ bai yangkab lolǝ kpaatthǝ ɓǝ, langkwoi tal vullǝnung kwɔ i mab babǝ gwab nwa ba lolǝ ɓǝ.<verse eid="HEB 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 9:5" />Lo tthko lǝ i nung nwongǝi a ghaali i ǝǝlǝ nwathan Fuh, i yǝb nwakanni kalo bǝikwɔ i al nung a ɓko yayuu lǝtǝ ɓǝ. Kwoi lakwɔ ǝn lona kwɔ i gei nung gwambǝi ɓǝ lǝu.<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />Manungkwɔni i mab i nungkwɔ ǝndǝi. Ya nyǝknung dǝna tǝ dang tǝbǝ a gwam vii ǝndǝi ta to nung to gi, <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />kwoi ǝn gong ya nyǝknung ɓuo a tǝttha dang tǝbǝ ɓǝ. U to manung ɓǝ dang ttha kun ɓuo. U lǝi zii kwɔ u dǝlǝ Fuh lǝ ba gu i nkolǝ langkwoi lǝ ba nung a ɓko kwɔ yayuu to kwɔ i ibǝi dǝnni to nung a ɓko lǝu ɓǝ. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Ɓyang a langǝ i dǝna nanatthǝnung kaitthǝ nunglǝi kwɔ i mab kwɔ ǝndǝi angǝ dang bǝi a langǝ i kwɔ yirrǝ i ɓko lǝu bakwɔ yirrǝ i lam tǝbǝ a gwam lǝu ɓǝ.<verse eid="HEB 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 9:9" />Lakwɔ ǝn nunglǝi kwɔ i tanatthǝ lona akwɔ lakwɔ ɓǝ. Dǝnna gei ɓi tthǝ angǝ nungdǝ kwɔ i nungbyang kwɔ i nyǝklǝ nung lǝ Fuh tthǝ kwɔ yirrǝ mǝrrǝm dang wa ya wab Fuh ɓǝ la langǝ i lǝu, <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />bakwɔ lakwɔ dǝnni to ǝn ba nungtang, bǝ nwamung, i bǝ mab sua ɓang mab loi. Nungkwɔ ǝndǝi ǝn dǝ kab nwanung a gwam, kwɔ dǝnni tolǝ nung to tǝlǝ lona kwɔ Fuh a wullǝ bǝ gub ɗuogsui afu ɓǝ.<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Kwoi kwɔ Kristi osi wuo ǝǝlǝ ya Nyǝknung a langǝ i lo nungkwɔ osi tthǝ ɓǝ. Tǝbǝ kwɔ dǝnnu to nung to tthǝ kwɔ ghaa ɗing langkwoi maɗing; ǝn tǝbǝ kwɔ ǝn na yuu mab ɓǝlǝu, ǝn nungkwɔlǝ, ǝn nungkwɔ i mab dang longwam kwɔ ɓǝlǝu.<verse eid="HEB 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 9:12" />Langwoi kwɔ Kristi tǝ dang tǝbǝ kwɔ bokun dang bǝ wuo gu bǝi a langǝ i, u lǝi zii lung i yui nyak u dǝ lǝ ba bǝ nyǝknung lǝu; langkwoi, u lǝi ǝn ziiu i nkolǝ u dǝɓi bǝ sob lo a ɗing.<verse eid="HEB 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 9:13" />Zii lung i nyak i song yui nyak kwɔ i suon i alo yayuu kwɔ nung a ɓko tthǝi ɓǝ, dǝi tǝi nung a langǝ i i mabbǝi kwoi a lǝi nung a ɓko gi.<verse eid="HEB 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 9:14" />Lakwɔ ba kwɔ ǝn ba a langǝ i, i alo nǝnǝ lǝ ba zii Kristi kwɔ nung a ɓko gu yangǝu! Lǝ ba a ɗing gi Ɓyang u dǝlo lǝ babǝ nyǝknung ba Fuh. Zii gu a mab lo nyi ɓitthǝ ba nung a nǝkwam, yangbǝ ɓi yam Fuh kwɔ nwongǝi gu tthǝ ɓǝ.<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />Lǝ baɓǝ kwɔ Kristi lǝ yuu kwɔ wullǝ bǝ gwab nwa ba afu ɓǝ, yangbǝ yakwɔ Fuh lubǝi kwɔ yangbǝ muo bǝ khana lo a ɗing kwɔ Fuh gwabbǝi nwaɓǝ. Nungkwɔ a to nung to ǝnba kwɔ bǝ ɓui ɓua kwɔ wullǝ yayuu lǝ bǝ nwongǝi tthǝ nung a ɓko gi kwɔ i to kwɔ bǝ zuu a nungsi dǝna to nung to ɓǝ.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />Tthǝ bǝ gwab nwa ǝn ba a langǝ i yuu akwɔ gwab nwa kwɔ ɓui, <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />I to nung i zuu nǝ yuu akwɔ nǝ mab ba ɓǝ nǝ tthǝ i nwongǝi ɓǝ; a to nung to nǝ yuu ɓǝ nǝ ɓui ɗǝ.<verse eid="HEB 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 9:18" />Nungkwɔ bǝ to nung kwɔ zuu a nungsi to nung to ǝn ba zii ɓuo.<verse eid="HEB 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 9:19" />La nwasiu, Musa gei balǝ yayuu tthǝ ǝndǝi lo ba a nyimmi lo ba kwɔ i mab lo zuu ɓǝ. Yang u lǝi zii yui nyak i zii lung, u al mungki tthǝ, nungkwɔ u wurrǝ lo nungvullǝ zuu langkwoi lo yayuu ǝndǝi, u to nung to i si yankab izob i garanji a thǝnni. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />U gei angǝ, &lt;&lt;Nungkwɔ ǝn zii kwɔ lam nwa bǝ gwab nwa ba kwɔ Fuh gei angǝ ɓi dǝ ba a langǝ i tthǝ ɓǝ.&gt;&gt; <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Manungɓǝni langkwoi Musa wurrǝ zii ɓǝ lo Tǝbǝ a langǝ i langkwoi lo nungkwɔ ǝndǝi kwɔ dǝnni wab lǝ Fuh ɓǝ.<verse eid="HEB 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 9:22" />Ən ba a langǝ i, lǝ ba zuu ɓǝ nung ǝndǝi i mab nungǝu i zii lǝ, langkwoi i al nung a ɓko lǝtǝ nǝ i al zii lǝtǝ ɗǝ.<verse eid="HEB 9:22" /></para>
  <para style="s">Bǝ Nyǝk Yeso Lǝ Nung Al Nung A Ɓko Lǝtǝ</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />I nungkwɔ ǝndǝi, i killǝng nung a langǝ i kwɔ wayi ɓǝ, i mǝrrǝmǝi matthǝ nunglǝi ɓǝ kullo. Kwoi nung a wayi i nai lǝ dǝna yiɗi nung nyǝknung a langǝ i. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />Bakwɔ Yeso kristi tǝ Bǝi a Langǝ i kwɔ i mab i na yuu ɓǝu, kwɔlǝ killǝng nung a langǝ i ɓǝ. U tǝ wayi i nkolǝ, bǝikwɔ lakwɔ u fug ɗǝgsi Fuh lǝ nwathan ɓiɓǝ.<verse eid="HEB 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 9:25" />Gong yikku ya nyǝknung ya Yahudawa dǝna tǝ Bǝi a Langǝ i ttha ǝndǝi i zii nungbyang. Kwoi Kristi tǝ wayi bǝ dǝ tthǝu lǝ bǝ nyǝknung bo kpaatthǝ lǝu, <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />nǝ manungɓǝni yang krǝ u tozuii lona kpaatthǝ baipiu vii kwɔ i mab longwam tthǝɓǝ. Manungkwɔni yang, lakwɔ nǝ lona dǝna gɓag bǝ tthǝmmu, u ilǝlo lǝ yayuu tthǝ bokun ɓuo, u nyǝknung i ɓui tthǝulǝ yangbǝ u illǝ nung a ɓko. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Ko ǝn yiǝ ǝndǝi a ɓui bo kun, tthasuko lǝ yang Fuh a tou kwan. <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />Langkwoi nunglǝi lǝ kwɔ i nyǝk Kristi lǝ nung bokun yangbǝ u lǝi nung a ɓko gi yayuu kpaatthǝ. U wuo lona a rabbu, wuu ɗablua nung a ɓko lǝu, kwoi wuu nwong yakwɔ dǝna kiu ɓǝ.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Zuu ya Yahudawa ǝn killǝng nung a langǝ i kwɔ a wɔ ɓǝ; ǝn bǝ tanatthǝ nung a langǝ i kwɔ a wɔ ɓǝ. Bǝ nyǝknung a kun ɓǝ ito laɗing, ttha lǝ ttha. Zuu gi Musa a tonǝnǝ, yang, a mab yayuu matthǝ kwɔ a wɔ sua Fuh ɓǝ? <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Nǝ yayuu kwɔ dǝna wab Fuh kwɔ la langǝ i i ɗiggǝi tthǝ nung a ɓko gi, nung a ɓko mui akunu, yang bǝ nyǝknung a dǝn dǝi. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Manungkwɔni, yang, bǝ nyǝknung kwɔ dǝnni to ttha lǝ ttha kwɔ yang yayuu a nhǝm nung a ɓko gi kwɔ dǝnni toɓǝ. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Bakwɔ zii nyak i lung ɓuan lǝi nung a ɓko gi yayuu.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />Lǝ ba bakwɔ, viikwɔ Kristi dǝna tǝbǝ wuo longwam tthǝ kwɔ, u gei lǝ Fuh tthǝ angǝ:</para>
  <para style="q1" vid="HEB 10:5">&lt;&lt; A yidɗi bǝ nyǝknung i nungdǝ lǝu,</para>
  <para style="q2" vid="HEB 10:5">kwoi a mabbǝm tthǝmǝ tthǝng.<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />A lǝ tthǝla i nungbyang kwɔ i li ǝndǝi lo tu ɓǝlǝu</para>
  <para style="q2" vid="HEB 10:6">i bǝ nyǝknung yangbǝ lǝi nung a ɓko lǝu.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />Yang Yeso gei angǝ, &lt; Ɓang kwɔ,</para>
  <para style="q2" vid="HEB 10:7">mǝn to nungkwɔ dǝmma yiɗi ɓǝ, Əi Fuh,</para>
  <para style="q2" vid="HEB 10:7">manung kwɔ i vullǝ lom bǝi a kun dang zuu gi Musa kwɔ.&gt;&gt;&gt;<verse eid="HEB 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />U baipiu u gei angǝ,&lt;&lt;A gwab ko a lǝ tthǝla i bǝ nyǝknung i nungdǝ ko nungbyang kwɔ dǝnni li lo tuu i bǝ nyǝknung yangbǝ lǝi nung a ɓko.&gt;&gt; U gei nungkwɔ ko kwɔ i nung nyǝkgǝi kwɔ dǝnni to lo nunglǝi zuu gi Musa. <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />Nungkwɔ Yeso gei angǝ,&lt;&lt;Ɓang kwɔ, Əi Fuh, yangbǝ ǝnto nungkwɔ dǝmma yiɗi ɓǝ.&gt;&gt; Nungkwɔ Fuh kwoilǝ nung nyǝkgǝi nunglǝi aku langkwoi u dǝ nung nyǝkgǝi gi Kristi prǝm lǝ. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Bakwɔ Yeso Kristi to nungkwɔ Fuh dǝna yiɗi u to ɓǝ, i mabɓi matthǝ dang nung a ɓko ɓi i bǝdǝ tthǝu bokun langkwoi ba nung a langǝ i ǝndǝi.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />Vii ǝndǝi ya nyǝknung ya Yahudawa dǝna to nung to bǝ nyǝknung kwɔ natha lona kun kwɔ; langkwoi bǝ nyǝknung gi kwɔ lǝi nung a ɓko.<verse eid="HEB 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 10:12" />Kristi, langkwoi, nyǝknung bokun lǝ ba nung a ɓko, bǝ nyǝknung kwɔ lǝ a langǝ i laɗing, nungkwɔ tǝu ǝǝ lona a nali gi Fuh.<verse eid="HEB 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 10:13" />Lakwɔ u bǝilǝ dǝnnu kiǝ Fuh a wullǝ ya ɓui gu lǝ thko bǝ dǝbo gu ɗǝ. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Lǝ ba bǝ nyǝknung gu bokun, lakwɔ, u mǝrrǝm yakwɔ lǝ ya nung a ɓko kwɔ lǝ ya nung a langǝ i laɗing.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />Langkwoi Ɓyang a Langǝ i langɓǝ dǝ shǝdǝ loɓi loba Kristi. Nwasiu u gei angǝ,<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />Nungkwɔ lǝ bǝ gwab nwa ba kwɔ mǝn dǝ i ilǝ ɓǝ</para>
  <para style="q2" vid="HEB 10:16">Dangbang gei angǝ, vii dǝna wɔ:</para>
  <para style="q1" vid="HEB 10:16">mǝn dǝ zuum Dang nyiǝ</para>
  <para style="q2" vid="HEB 10:16">langkwoi Mǝn vullǝ dang bǝ nhǝm bagi.&gt;&gt;<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />Langkwoi u gei angǝ,&lt;&lt; Ən nhǝm ba lo nung a ɓko giu langkwoi i mullub gi kwɔ i to ɓǝ.&gt;&gt; <verse eid="HEB 10:17" /><verse number="18" style="v" sid="HEB 10:18" />Nungkwɔni yang kwɔ nǝ i al i nungkwɔ lǝtǝ, bǝ dǝ nungdǝ ba bǝ al nung a ɓko yangǝu.<verse eid="HEB 10:18" /></para>
  <para style="s">Ɓi Gɓagtha I Fuh</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Ya youngǝm, ɓitthǝ i bǝ tǝi loɓi kwɔ ɓitǝ Bǝi a langǝ i i bǝ ba zii gi Yeso Kristi. <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />U ɓkoɓi nunglǝi afu tthǝ, lǝi nwongǝi, tthǝ laɓulǝ nung ɓǝlǝ, tthǝu i nkolǝ. <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />Ɓi tthǝ i ya nyǝknung angǝ a kwɔ dǝna ɓilo gwoi Fuh ɓǝ. <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />Nungkwɔ yang ɓi wuo wuɓi gɓag Fuh i lo nyi ɓi a langǝ i i bǝ dǝnyitthǝ a langǝ i, i lonyi kwɔ i mab la langǝ i tthǝ nung a ɓko i tthǝ kwɔ i ɗiggǝ i mungki ba Fuh. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Ɓi muo bǝ dǝnyitthǝ naɓi kwɔ nyimtthǝ, bakwɔ ɓi dǝ ba a langǝ i tthǝ Fuh dǝilo bǝ gwab nwa ba gu. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Ɓi tobǝ lotha, yang bǝɓi nwong tha ɓi yiɗi tha langkwoi ɓito nung a langǝ i. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />Bǝɓi yitthǝ bǝ kǝbtha thǝ, manungkwɔ yakun dǝna to ɓǝthǝ. Manungkwɔni yang, ɓi lilo bǝ nyimtthǝ tha, bakwɔ ɓi ibǝi Vii wuo gi Dangbang dǝna gbag bǝi.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Bakwɔ babǝ nyǝknung akun yangǝu kwɔ a wullǝ bǝ al nung a ɓko lǝtǝu kwɔ ɓi tonung a ɓko lǝ wong kwɔ tthasua ǝndǝi kwɔ i osi i gei ɓi ba a langǝ i tthǝng ɓǝ <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />Manungkwɔ ni yang, sua nung ǝndǝi kwɔ a to ɓi lǝ tthǝ vulli kwɔ ǝn nungkwɔ: bǝ wuo gi kwan langkwoi i lua kwɔ zii ni kwɔ wa lii yakwɔ la ba gi Fuh ɓǝ! <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Yuu akwɔ nǝ la zuu gi Musa i thǝu i ɓyǝa nungzuii guu nǝ i tou kwan i ya shǝdǝ rab ko pa rab ɓǝ.<verse eid="HEB 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 10:29" />Ən ɓǝtǝn, yang, kwɔ yakwɔ dǝna la Yui gi Fuh ɓa? Yakwɔ gei ba tthǝ bǝ dǝ ganglang ba zii kwɔ ilǝ dang nung a ɓko ɓa? Yakwɔ ɓanglǝ Ɓyang bǝ to nung a langǝ i? Ɓa nhǝm bǝ ɗabluabǝi a zi zii kwɔ atǝi ɓǝ! <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />&lt;&lt;Bakwɔ ɓi ibǝ yuu akwɔ gei angǝ,&lt;&lt;Mǝn vuo ɓǝng, Mǝng kwai ɓǝng&gt;&gt;; langkwoi yuu kwɔ gei angǝ,&lt;&lt;Dangbang a to kwan lǝ yayuu gu tthǝ ɓǝng.&gt;&gt; <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />Ən nung sur vulli kwɔ yuu a o dang na Fuh ya nwongǝi ɓǝ!<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Ɓa nhǝm nungkwɔ toɓǝ tthasua ɓǝ. Viilǝ kullo, kwɔ lua gi Fuh gabbǝi loɓǝ kwɔ, ɓa tozuii lo nung kpaaɗing, i tǝi nung akun tthǝɓǝ lǝu lo nungkwɔ dǝnni ɗu lǝ ba ɓǝɓǝ. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />Lona yakun i ɓangɓǝ lǝ langkwoi i dǝ ɓǝ zuii, lona akun dǝ ɓa yiɗi bǝ bai tha nwa i yakwɔ dǝna ji zuiiɓǝ ɓǝ. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Bakwɔ ɓa ɓyǝa nungzuii tha i yakwɔ dang pursǝna ɓǝ, langkwoi nǝ i ee nung naɓǝ ǝndǝi, ɓa lǝ tthǝla i nungkwɔ i toɓǝ lǝɓǝ, bakwɔ ɓa ibǝing ɓa tǝi nung akun lalangǝ i, kwɔ a dǝi laɗing ɓǝ. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />Bǝɓa muan tthǝɓǝ thǝ, langkwoi, bakwɔ i dǝɓǝ nungbusɔni ghaatthǝ ɓǝ. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Ɓa ǝǝ i bǝ dǝ nyitthǝ a langǝ i, yangbǝ ɓa tonungto gi Fuh yangbǝ ɓa muo nungkwɔ u gwab ɓǝ nwuo ɓǝ. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />Manungkwɔ, ba gi Fuh gei angǝ,</para>
  <para style="q1" vid="HEB 10:37">&lt;&lt; Sua tuu lǝu yang,</para>
  <para style="q2" vid="HEB 10:37">yuu akwɔ a wɔ kwɔ a wɔ;</para>
  <para style="q2" vid="HEB 10:37">sua tuu.<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />Yayuum ya to nung a langǝ i, langkwoi, dǝba a langǝ i yang i ǝǝ i nwongǝi laɗing;</para>
  <para style="q1" vid="HEB 10:38">kwoi nǝ yuu akun nǝ kwoi tthasua yang,</para>
  <para style="q2" vid="HEB 10:38">Ən lǝ tthǝla i ilǝu.&gt;&gt;<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Ɓi ǝn yayuu kwɔ mǝrrǝm tthasua yang la ɓǝlǝu. Manungkwɔni yang, ɓitthǝ i bǝ dǝnyitthǝ langkwoi ɓi sob lo.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">Bǝ Dǝnyitthǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Bǝ dǝnyitthǝ nungɓǝlǝ nungkwɔ ɓi dǝnyitthǝ ɓǝ, bǝ gwab nungkwɔ ɓi ɓyǝa lǝuɓǝ. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Ən bǝ dǝnyitthǝ nungkwɔ Fuh gwabtha i yakku ɓi.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />Tthǝntthǝ bǝ dǝnyitthǝ nungkwɔ ɓi ibǝi angǝ Fuh mab longwam i ba nwuo, nungkwɔ yang nungkwɔ dǝɓi ɓyǝa kwɔ i mab i nungkwɔ i ɓyǝko ɓǝ.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />Ən bǝ dǝnyitthǝ nungkwɔ to Habila dǝ nung nyǝknung lǝ Fuh ma pǝl a bǝ Kayinu. Tthǝntthǝ bǝ dǝnyitthǝ gu nungkwɔ Fuh gwabbu lǝ yuu a langǝ i, bakwɔ Fuh i nkolǝ gwab nungdǝ gu. Ən babǝ dǝnyitthǝ gu Habila yirrǝ dǝna gei ba, ko kwɔ u ɓuing ɓǝ.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />Ən babǝ dǝnyitthǝ nungkwɔ Anuhu ɓuilǝu. I lǝiu i tǝlǝ sua Fuh, langkwoi yuu yangǝu a ɓiu, bakwɔ Fuh lǝiu tǝlǝ wayi ɓǝ. Ba gi Fuh gei angǝ nwuni bǝ i lǝi Anuhu i tǝlǝ wayi kwɔ, u dǝtthǝla lǝ Fuh. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Yuu yangǝu a dǝtthǝla lǝ Fuh nǝ bǝ dǝnyitthǝ nung alangǝ i yangǝu ɓǝ, nǝ yuu akwɔ nǝ wuo sua Fuh yang u tthǝ i bǝ dǝnyitthǝ nungto gi Fuh a langǝ i angǝ Fuh tthǝ langkwoi dǝnnu dǝnung lǝ yakwɔ dǝna ɗuu bǝiu ɓǝ.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />Tthǝn tthǝ bǝ dǝnyitthǝ nung gi Fuh la langǝ i nungkwɔ Nuhu lǝ bǝ gub ɗuogsui gi Fuh lo nung a tthasi kwɔ u ɓyǝko ɓǝ. U dǝ ba a langǝ i tthǝ Fuh nungkwɔ u mab kwai kwɔ u i yayuu gu i tǝi nwongǝi ɓǝ. Lo nungkwɔ, longwam ɓanglǝ, langkwoi Nuhu muo ba a langǝ i na Fuh tthǝ bǝ tonung a langǝ i. <verse eid="HEB 11:7" /><verse number="8" style="v" sid="HEB 11:8" />Tthǝn tthǝ bǝ dǝnyitthǝ Fuh kwɔ Ibrahim lǝ bǝ lubǝi kwɔ Fuh lubǝi angǝ u tǝ losua kwɔ Fuh gei angǝ i duu ɓǝ. U yitthǝ losua gu u ibǝ losua kwɔ dǝnnu tǝɓǝ lǝu.<verse eid="HEB 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 11:9" />Tthǝn tthǝ bǝ dǝnyitthǝ Fuh u ǝǝ mangǝ u ǝn ya losua akun kwɔ Fuh gwabbu nwa ɓǝ. U ǝǝ dang tǝbǝ, manung gi Ishaku i Yakubu, kwɔ muo bǝ gwabnwa nung gi Fuh ɓǝ.<verse eid="HEB 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 11:10" />Ibrahim dǝna kiǝ gwoi angǝ a kwɔ Fuh mab langkwoi mai ɓǝ, gwoi angǝ a kwɔ pi kǝm ɓǝ laɗing ɓǝ.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />Ən bǝ dǝ nyitthǝ nungkwɔ Ibrahim mǝrrǝm lǝ Daa, ko kwɔ u kuu kwɔ langkwoi Saratu langkwoi pa ttha bǝ si yuing. U dǝnyitthǝ Fuh a dǝilo bǝ gwab nwa gu. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Manung Ibrahim mangǝttǝn ɓumɓui, tthǝ yiɓǝi kun kwɔ ya bǝpi kpaatthǝ i tthǝu mangǝ ǝn vin lo wayi, i kpaa i ɓuan i thannu mangǝ ǝn sua zuii nwam.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />Tthǝn tthǝ bǝ dǝnyitthǝ nung yayuu kwɔ ǝndǝi ɓui. I muo nungkwɔ Fuh gwab nwuo ɓǝlǝu, kwoi bǝi tutthǝ i ɓyǝai i lǝtthǝla gi, langkwoi i mui nungpangbǝi angǝ i ǝn yayol langkwoi ya sur ɓui longwam lǝ. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Yakwɔ gei nungkwɔ i gei kaitthǝ angǝ dǝnni ɗubǝ losua gi i nailǝ. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />I ǝǝ nwa bǝ nhǝm ba losua kwɔ i yitthǝ ɓǝlǝu; krǝ nǝ dǝnni nhǝm, yang i tǝi nunglǝi i kwoi.<verse eid="HEB 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 11:16" />Manungkwɔni yang, ǝn losua a langǝ i dǝnni yidɗi, losua a langǝ i kwɔ wayi ɓǝ. Langkwoi yang Fuh lǝ tthǝkku kwɔ dǝnni lubǝiu angǝ u ǝn Fuh gi ɓǝlǝu, bakwɔ u mab gwoi angǝ a lǝ ba gi ɓǝng.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />Ən bǝ dǝnyitthǝ nungkwɔ Ibrahim dǝ yuiu Ishaku lǝ ba nung nyǝkgǝi kwɔ Fuh na Ibrahim ɓǝ. Ibrahim ǝn yuu akwɔ Fuh gwabbu nwa ɓǝ, yirrǝ u ǝǝlo bǝ dǝ yuiu lǝ ba nung nyǝkgǝi. <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />Fuh geiu angǝ,&lt;&lt;Tthǝn tthǝ Ishaku ma tǝi bǝpi kwɔ ǝn gwaba nwa ɓǝ.&gt;&gt; <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />Ibrahim dǝna nhǝm angǝ Fuh a ǝrr lǝ Ishaku bǝ ɓui ɓua- langkwoi, nǝ i gei ba, Ibrahim muo Ishaku bǝ ɓui ɓua.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />Tthǝn tthǝ bǝ dǝnyitthǝ nungkwɔ Ishaku gwabnwa bǝ khana lo a tthasi lǝ Yakubu i Isuwa.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />Tthǝn tthǝ bǝ dǝ nyitthǝ nungkwɔ Yakubu khana lo yathang gi Yusufu nwuni bǝ u ɓui. U nyim tthǝu tthǝ kab baina gu u wab Fuh.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />Tthǝn tthǝ bǝ dǝnyitthǝ nungkwɔ mab Yusufu, kwɔ u gɓag bǝ ɓuiɓua, u gei ba bǝ i gi ya Israila dang Masar, u yitthǝ ba lo nungkwɔ a to nung tthǝ kub tthǝu nǝ u ɓuiɓǝ.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />Tthǝn tthǝ bǝ dǝnyitthǝ nungkwɔ ya yayuu gi Musa pyǝko fih tai kwɔ i siu ɓǝ. I ɓyǝa yui ɓǝ maɗing, langkwoi i sur bǝ gub ɗuogsui gi yigwoi lǝu.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />Tthǝn tthǝ bǝ dǝnyitthǝ nungkwɔ Musa, kwɔ u na Firkona kwɔ, u la kwɔ u lubǝiu lǝ baba gi yigwoi lǝu.<verse eid="HEB 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 11:25" />U mko bǝ to zuii i yayuu gi Fuh kwɔ u lǝ tthǝla bǝ to nung a ɓko lona tuab ɓǝ. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />U gwabnwa bǝ to zuii tthǝ bǝ lam bǝi lǝ ba kristi ya sob lo pǝl nungtǝi kwɔ u tǝi ǝndǝi dang Masar ɓǝ, bakwɔ i nungǝu dǝnnu ɓyǝa lǝ nung busoni a tthasi.<verse eid="HEB 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27" />Tthǝn tthǝ ba bǝ dǝnyitthǝ nung a tthasi nungkwɔ Musa yitthǝ Masar u sur nyi gi Yigwoi lǝu. Mangǝ tǝn u ɓyǝa Fuh kwɔ i ɓyǝko i nungǝu ɓǝ, u la bǝ ɓyǝa tthasuko. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Tthǝn tthǝ bǝ dǝnyitthǝ nung nungkwɔ u mab ba ɓang bǝ nyang lo gwoi yayuu faa zii nwakǝm, yang bǝ nǝ ya nwatummi ɓua thǝb ya nwasi- yui ya Israila lǝu. <verse eid="HEB 11:28" /><verse number="29" style="v" sid="HEB 11:29" />Tthǝn tthǝ bǝ dǝnyitthǝ nungkwɔ ya Israila nyang nwam mangǝ ǝn pangsua a kwi; kwɔ ya Masar dǝna yidɗi bǝ to manungɓǝ, mung ɓuom loi. <verse eid="HEB 11:29" /><verse number="30" style="v" sid="HEB 11:30" />Tthǝn tthǝ bǝ dǝnyitthǝ nungkwɔ kong gei Yariko o, tthasua kwɔ ya Israila mǝrrǝm kǝb gwoi ɓǝ bo nanaira ɓǝ. <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />Tthǝn tthǝ bǝ dǝnyitthǝ nungkwɔ i yiǝ Rahab ya tang nǝkwam i thǝbbu suatha i yakwɔ laba Fuh ɓǝlǝu, bakwɔ u muo ya Israila kwɔ wuo bǝ ɓuu gwoi kwɔ lo nyi kun.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />Ən lilo ba ɓa? Lona yangǝu kwɔ mǝn gei ba lo gi Gidiyon, Barak, Samson, Yefta, Dawuda, i Sama'ila i sua ya gei ba a tthasiu, <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />Tthǝn tthǝ bǝ dǝnyitthǝ i ta ɓui i ya losua yigwoi kpaatthǝ i tangǝ i i ɓui. I to nungkwɔ la langǝ i kwɔ nungkwɔ i muo nungkwɔ Fuh gwabbǝi nwuo ɓǝ. I lam nwa i zua,<verse eid="HEB 11:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="HEB 11:34" />I mual ttha lua, i nyanglo bǝ thǝbǝi i kafyǝi. Tthǝi muan, kwoi ǝrr i tǝi ttha; i nyim tthǝi dang bǝ taɓui kwoi i tang ya taɓui ya losua akun i ɓuilǝ. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Tthǝn tthǝ bǝ dǝnyitthǝ nungkwɔ yasi kǝblo kwamɓui yayuu gi kwɔ tǝi nwongǝi ɓǝ.</para>
  <para style="p" vid="HEB 11:35">Yakun, labǝ muo bǝ tǝi lo, i ɓui dang bǝ tozuii yangbǝ i ǝrr tǝitǝi nwongǝi a langǝ i. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />I tthak yakun gi langkwoi i ɓuoi i thab, langkwoi i tthǝb yakun i sarka i tǝilǝ pursǝna. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />I wai i tal, i fyǝi dang tha rab, i thǝb bǝi i kafyǝi. I li zuǝ ɓangam ko zuǝ ɓa- dǝnni gǝng bo i zuǝ ɓangam ko zuǝ ɓa- i ji yiɓko, i ji zui i ɗab luai. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />Longwam lai lǝu! Dǝnni thko nǝkwam mangǝn ya sur ɓui losua a kwi i dang tal, i ɓua dang pangsua lǝ.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />Nungkwɔ ǝndǝi tǝitthǝ i bǝ dǝnyitthǝ gi! Yirrǝ i muo nungkwɔ Fuh gwabǝi nwa ɓǝlǝu, <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />bakwɔ Fuh mab nung a langǝ i lǝ ba ɓi. Bǝ nhǝm ba gu nungkwɔ suatha i ɓi lǝ ɓuo yangbǝ u mab nung ǝndǝi lozuiu matthǝ.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">Fuh Daa Ɓi</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Manungkwɔ lǝ ba ɓi, ɓitthǝ i ya shǝdǝ kpaatthǝ kwɔ mǝrrǝm ɓi kǝb. Yang langkwoi, dǝisua ɓi ilǝ nungkwɔ ǝndǝi kwɔ a dǝi nunglǝi ɓi ɓǝ, i nung a ɓko kwɔ muo ɓi nyimtthǝ ɓǝ, yang ɓi surdum kwɔ tthasi ɓi kwɔ i tthǝ nyimmi ɓi. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />Dǝisua ɓi dǝ nung ɓitthǝ Yeso, yuu akwɔ bǝ dǝnyitthǝ ɓi baipiu tthǝu lǝ tǝlǝ bǝ alo ɓǝ. U sur bǝ pi bǝi lo kab gangǝ i lǝu! Dangǝulǝ ǝndǝi, lǝ ba tthǝla kwɔ dǝna kiu kwɔ, u nhǝm nung akun lǝ bǝ dǝ tthǝkku bǝ ɓuiɓua lo kab gangǝ i lǝu, lakwɔ u ǝǝ lona a nali bǝ lo Yigwoi gi Fuh. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />Ɓa nhǝm zui kwɔ u toɓǝ; i bǝ la bǝi kwɔ u tǝi na ya nung a ɓko ɓǝ! Yang bǝɓa muan tthǝ ɓǝthǝ bǝ ɓa yitthǝ bǝ dǝnyitthǝ thǝ. <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />Tthǝ bǝ ɗuong nungɓǝ lo nung a ɓko yirrǝ kǝn bǝikwɔ i thǝb ɓǝ ɓǝlǝu.<verse eid="HEB 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 12:5" />Nyiɓǝ da tthǝ bǝ nyimtthǝ kwɔ Fuh gei ɓǝtthǝ ɓǝ yathang gu ɓǝng a?</para>
  <para style="q1" vid="HEB 12:5">Yuim, adǝ nyi mǝtthǝ kwɔ nǝ Dangbang lagga ɓǝ,</para>
  <para style="q2" vid="HEB 12:5">langkwoi bǝ tthǝmǝ muan kwɔ nǝ u tthan nyi lomǝ ɓǝ tthǝ.<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Bakwɔ Dangbang dǝna lag yuu akwɔ ǝndǝi dǝna yiɗi ɓǝ,</para>
  <para style="q2" vid="HEB 12:6">langkwoi dǝnnu ɗablua yuu akwɔ dǝu gwabbu lǝ yui ɓǝ.&gt;&gt;<verse eid="HEB 12:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 12:7" />Ɓa nyimnyi tthǝ bǝ tozuii lǝ bǝ ɗablua bǝi gi Daa; bǝ tozuii mǝ dǝna tanatthǝ angǝ Fuh dǝna toɓǝ mangǝ ɓǝ ǝn yathang gu. Yui akuntthǝ kwɔ Daa gu ɗab luko ɓa? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Nǝ i ɗablua mǝ lǝu, mangǝttǝn ǝn yathang gu lǝu, yang ǝǝ mangǝ ɓǝ ǝn yathang a langǝ i lǝu, kwoi yathang wa.<verse eid="HEB 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 12:9" />Lǝba ya Daa ɓi a longwam, dǝnni ɗablua ɓi yang dǝɓi ji angǝ a. Tonǝnǝ, langkwoi kwɔ, ɓi dǝ loɓi lǝ Daa ɓyang a langǝ i yang ɓi tǝi nwongǝi! <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Ya daa ɓi a longwam dǝna ɗablua ɓi lona tuab, manung kwɔ i yidɗi ɓǝ; kwoi Fuh dǝna to ǝnba bǝ nwong ɓi, yangbǝ ɓi tǝi nwathan nung a langǝ i gu.<verse eid="HEB 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 12:11" />Kwɔ nǝ i ɗablua ɓi, dǝɓi ɓyǝa lona lǝ ǝn nungkwɔ a ɓanglǝ dang wa ɓiɓǝ, ǝn bǝ lǝ tthǝla lǝu. Natthǝ, langkwoi natthǝ yang, yakwɔ i ɓuoi i bǝ ɗablua bǝikwɔ a tǝi nungbusɔni tthǝla nwongǝi a langǝ i.<verse eid="HEB 12:11" /></para>
  <para style="s">Bǝ Alo Ba I Bǝ Gub Ɗuogsui</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Ɓa juan na a muanni ɓǝ yilǝ, yang, langkwoi ɓa juan long a muanni ɓǝ!<verse eid="HEB 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 12:13" />Ɓa lilotthǝ thko lǝi akwɔ juantthǝ kwɔ, yangbǝ bǝ bo ya kuglǝ ɓanglǝ thǝ, kwoi manungkwɔni yang i tǝi tthǝla.<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Ɓa na bǝ ǝǝ bǝ lǝ tthǝla i yayuu ǝndǝi, langkwoi ɓa ǝǝ bǝ ǝǝ la langǝ i, bakwɔ yuu yangǝu a ɓyǝa Dangbang gǝu nǝ nungkwɔ yangǝu ɓǝ.<verse eid="HEB 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 12:15" />Ɓa dǝ kiggǝ ɓǝ ba bǝ kwoi tthasua tthǝ nung a langǝ i gi Fuh thǝ. Bǝ yuu akun mǝrrǝm mangǝ ǝn yǝng nungbyǝa a nyinyi kwɔ ghaa yang wullǝ nung a ɓko kpaatthǝ kwoi ɓanglǝ. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />Ɓa to kiggǝ bǝ yuu akun to nung a ɓko ko dal Fuh manung gi Isuwa kwɔ ɓyang a langǝ i yangǝu tthǝu lǝ ɓǝ, lǝ ba nungtang bokun u lǝi ghaali nwasi yui gu u ɗyǝab ɓǝ thǝ. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Tthasua, kwɔ ɓa ibǝi, dǝnnu yiɗi bǝ muo bǝ khana lo na Daa gu; langkwoi i mǝrrǝm mual i tkolǝ, bakwɔ u tǝi nunglǝi kwɔ u mǝrrǝm lǝ nungkwɔ u to ɓǝu, ko kwɔ ǝndǝi dǝnnu ɗuu i mungnung. <verse eid="HEB 12:17" /><verse number="18" style="v" sid="HEB 12:18" />Ɓa wɔ, manungkwɔ ya Israila wɔ ɓǝlǝu, tthǝ nungkwɔ ɓa kǝn natthǝ ɓǝlǝu, tthǝ tal Sinai kwɔ lua dǝna li bǝilǝ nyimtthǝ ɓǝ; dang bǝthǝl, i wamung,<verse eid="HEB 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 12:19" />ko bǝ ɓi ɓii, i yol ba. Kwoi nǝ yayuu lǝ yol ɓǝ, yang dǝi yam angǝ bǝ ilǝ ba akun thǝ,<verse eid="HEB 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 12:20" />bakwɔ i ɓuan i lǝ bǝ dǝkab nwanung kwɔ gei angǝ,&lt;&lt;Nǝ ko ǝn nungbyang kǝn tthǝ tal ɓǝlǝu, yang i wko i tal i thǝb.&gt;&gt; <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Nungkwɔ i ɓyǝa kwɔ ji tthǝ vulli ghaaɗing nungkwɔ Musa gei angǝ,&lt;&lt;Tthǝm dǝna ɓuobtthǝm langkwoi dǝm sur vulli!&gt;&gt;<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />Manungkwɔni yang, ɓa wɔ tal Sihiyona, langkwoi gwoi angǝ a bǝ nwongǝi gi Fuh, Urshalima a wayi ɓǝ, kwɔ ya nwatummi gi Fuh bǝilǝ tthǝm sob ɓua pak nǝkwam ɓǝ. <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />Ɓa wɔ bǝ gǝmtha lǝ tthǝla gi nwasi yui- Fuh, kwɔ i vullǝ ɗuǝnni wayi ɓǝ. Ɓa wɔ sua Fuh, kwɔ lǝ ya to kwan lǝ yayuu tthǝ ɓǝ, langkwoi i ɓyang yayuu kwɔ i mǝrrǝm mǝi lǝ ya langǝ i ɓǝ. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />Ɓa wɔ sua Yeso, yuu akwɔ mab nunglǝi bǝ lǝi zuu, langkwoi i ba zii kwɔ i wurrǝ angǝ bǝ gwabnwa kwɔ i gwab kwɔ mǝrrǝm lǝ nung a langǝ i pǝl zii Habila.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />Ɓa dǝ kiggǝ ɓǝ, nungkwɔ, langkwoi bǝ ɓa la bǝ lǝ yuu akwɔ dǝna gei ba gi yuu akwɔ dǝna gei ba a langǝ i gi Fuh longwam kwɔ i dang ǝu lǝu, nungkwɔ, nǝ ɓi mǝrrǝm ɓi ta mual lǝ yuu kwɔ dǝna gei ba wayi ɓǝ! <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />Yollu thǝuri losua lona ɓǝlǝ kullo, kwoi lakwɔ u gwab nwa angǝ,&lt;&lt;Langkwoi mǝn thǝuri longwam akun ɓuo lǝu i wayi ǝndǝi.&gt;&gt; <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Babǝ&lt;&lt;akun langkwoi&gt;&gt;nungpangbǝi tanatthǝ angǝ nungkwɔ i mab a thǝuri langkwoi i lub i lǝi, yangbǝ nungkwɔ thǝuriu kwɔ a ǝǝ. <verse eid="HEB 12:27" /><verse number="28" style="v" sid="HEB 12:28" />Ɓi to sakko lǝ Fuh, bakwɔ u dǝɓi bǝ lo yigwoi kwɔ thǝuriu ɓǝ. Ɓi kha Fuh yang ɓi wabbu nunglǝi kwɔ u lǝ tthǝla ɓǝ, i surru i bǝ duu angǝ a, <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />bakwɔ ǝn ba a langǝ i Fuh ɓi mangǝn lua kwɔ dǝna li nung ɓǝ.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">Nungkwɔ Ma To Fuh Alǝ Tthǝla Mǝ Ɓǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Ɓǝya Krista ɓa dǝilo bǝ yiɗi tha mangǝ ɓǝ ǝn yakwɔ dǝ ba a langǝ i tthǝ Kristi ɓǝ.<verse eid="HEB 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HEB 13:2" />Ɓa dǝinwa bǝ muo yayol gwoi ɓǝ lǝ. Yakun tthǝ toni i muolǝ ya nwatummi gi Fuh i ibǝi lǝu.<verse eid="HEB 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 13:3" />Ɓa nhǝm ba lo yakwɔ dang pursǝna ɓǝ, mangǝttǝn mǝ dang pursǝna suatha i ilǝ. Ɓa nhǝm ba yakwɔ dǝna to zuii ɓǝ, mangǝttǝn dǝma tozuii manung gi.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />Ɓadǝ angǝ a lǝ bǝ dǝb tha ɓǝ, langkwoi yaɓǝi i yasi ɓa dǝnyitthǝ tha la langǝ i. Fuh a ɗablua yakwɔ dǝna to nung a ɓko ɓǝ, i yakwɔ dǝna lo i yasi yayuu ɓǝ.<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />Bǝ kiggǝ ɓǝ ǝǝ lǝ kiggǝ ya yiɗi nungkurɓǝ thǝ, langkwoi ɓa ǝǝ i nungkwɔ naɓǝ matthǝ. Fuh gei angǝ,&lt;&lt;Ən yi ɓǝu; Ən waɓǝ lǝtǝu.&gt;&gt; <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />Ɓi nyimtthǝ ɓi, lakwɔ, ɓi gei ɓi angǝ,</para>
  <para style="q1" vid="HEB 13:6">&lt;&lt;Dangbang ǝnya nwongǝm,</para>
  <para style="q2" vid="HEB 13:6">Ən sur vulli u.</para>
  <para style="q1" vid="HEB 13:6">Ən ɓǝttǝn yuu a tom laa?&gt;&gt;<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Ɓa nhǝm balo yakku ɓǝ a nungsi, yakwɔ gei ɓǝ ba gi Fuh tthǝɓǝ. Ɓa nhǝm ba tthasua lo nungkwɔ i to bǝ i ɓuiɓǝ, yang ɓa na nwai. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Yeso Kristi natha i a lali, ɗiggǝ, i a laɗing.<verse eid="HEB 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 13:9" />Bǝɓa muo bǝ nanatthǝnung afu thǝ. Maɗing kwɔ ɓi muo ttha a dang wa tthǝ bǝ yiɗi bǝi gi Fuh ɓǝ, langkwoi ǝn ba bǝ dǝ angǝ a tthǝ bǝ lo yigwoi wayi lǝ ba nungtang lǝu; ya gwab ba bǝ lo yigwoi wayi kwɔ i tǝi bǝ nwong bǝi lǝu.<verse eid="HEB 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10" />Ya nyǝknung kwɔ dǝna to nung to dang tǝbǝ kwɔ ya Yahudawa dǝna wab Fuh tthǝ kwɔ i yangǝu i ttha kwɔ i tang nungkwɔ dǝnni nyǝklǝ nung lo tuu ɓǝu. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Yikku ya Yahudawa a wulǝ zii nungbyang lǝ bǝi a langǝ i a nyimmi wa dǝlǝ ba bǝ nyǝknung lǝ ba nung a ɓko, langkwoi yang nyam ɓǝ i suon ttha gwam bǝ nyǝknung ɓǝlǝ. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Lǝ ba ɓǝ langkwoi Yeso ɓui ttha gwam gwoi angǝ a, ba yangbǝ i mab yayuu lǝ ya nung a langǝ i i zii gu. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Ɓi dǝisua, langkwoi, ɓitǝ tthangǝu ttha gwam yangbǝ tǝɓi gab tthǝku lǝtha i u lǝ.<verse eid="HEB 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 13:14" />Bakwɔ ɓi yangǝu i gong gwoi kwɔ lǝ aɓi longwam kwɔ ɓǝu; dǝɓi ɓyǝa nunglǝi gong gwoi kwɔ a wua ɓǝ.<verse eid="HEB 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15" />Ɓi dǝisua, langkwoi, vii ǝndǝi nǝɓi kha Fuh lǝ ba bǝ nyǝknung ɓi tthǝ Yeso, ǝn bǝ dǝnung kwɔ ɓi dǝ i lyǝn ɓi lǝ ba ee nwa ba nung a ɓko ɓi tthǝ Dangbang.<verse eid="HEB 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 13:16" />Bǝɓa danyitthǝ bǝ to nung a langǝ i i bǝ nwong tha thǝ, bakwɔ ǝn bǝ nyǝknung ɓǝ kwɔ dǝna la nyi Fuh ɓǝ.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Ɓa dǝ angǝ a lǝ ya dǝ kabnwa nung langkwoi ɓalǝ bagi. Dǝnni ɓyǝa lo ɓǝ bǝ nwongǝi gi yangǝu, bakwɔ i gei nwa ba nung to gi lǝ Fuh tthǝ ɓǝ. Nǝɓa lǝ ba gi, yang i to nung to gi i tthǝla; nǝni lǝu, yang i to i dang wa a ɓanglǝ, yang nwong ɓǝu. <verse eid="HEB 13:17" /><verse number="18" style="v" sid="HEB 13:18" />Ɓa pi ɓi nwatthǝ vii ǝndǝi. Ɓi tthǝ i dang wa a kaikai, bakwɔ dǝɓi yiɗi bǝ to nung to a langǝ i lona lǝ ǝndǝi. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Langkwoi dǝmǝn yam ɓǝ dang wa kun ɓa pinwa yangbǝ Fuh kwoim lǝ wullǝ sua ɓǝ nǝnǝng kwɔ.<verse eid="HEB 13:19" /></para>
  <para style="s">Bǝ Pinwa</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Lakwɔ Fuh ya nung a langǝ i kwɔ ǝrr lǝ Dangbang Yeso ɓi bǝ ɓuiɓua, yuu akwɔ lǝ gong ya gagci ɓangam tthǝ bǝ dǝ zii gu, kwɔ lam lǝ nwa bǝ dǝ ganglang a ɗing. <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />Fuh kwɔ dǝɓǝ nyi tǝmmi dǝɓǝ nung la langǝ i kwɔ ɓa yiɗi yangbǝ ɓa tolǝ nung to gu, langkwoi tthǝ Yeso Kristi, to nung to i ɓilǝ manung kwɔ u lǝ tthǝlko ɓǝ. Langkwoi tthǝ Yeso i nung angǝ a gu vii ǝndǝi langkwoi la ɗing! Dǝitthǝ manungɓǝ.<verse eid="HEB 13:21" /></para>
  <para style="s">Bǝ Alo Ba Ən Dǝi</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Ya youngǝm, dǝmǝn yam ɓǝ, ɓa lǝm i lonyi a tǝmmi tthǝ ba nyimtthǝ bǝi gi Fuh kwɔ; lǝ ba nungvullǝ kwɔ ǝn vullǝ ɓǝ tthǝ kwɔ Ən ba ɓǝ tulǝu. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />Dǝmǝn yidɗi bǝ gei ɓǝ geigǝ i yinalǝ young ɓi Timitawos pursǝnǝng. Nǝ u wuo thǝmtthǝ yang, Mǝn wuo suatha i ulǝ wuɓi ɓyǝa ɓǝ.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Ɓa gumbǝ yakku ɓǝ ǝndǝi i yayuu gi Fuh ǝndǝi. Yadǝ ba a langǝ i tthǝ Fuh dang Italiya dǝna gum ɓǝ.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />Nung a langǝ i gi Fuh ǝǝ i ɓǝlǝ ǝndǝi laɗing.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>