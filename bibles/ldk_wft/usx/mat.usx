<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- MUNGA LANGUAGE PROJECT</book>
  <para style="h">Matta</para>
  <para style="toc1">Nwaba A Langǝ i Na MATTA</para>
  <para style="toc2">Matta</para>
  <para style="toc3">Mat</para>
  <para style="mt2">Nwaba A Langǝ i Na</para>
  <para style="mt1">MATTA</para>
  <para style="imt">Bǝ Gabnung</para>
  <para style="ip">
    <char style="bk">Nwaba A Langǝ i Na Matta </char>gei ǝn nwaba a langǝ i angǝ Yeso lǝ ya soblo kwɔ i gwab nwuo ɓǝ, yuu kwɔ Fuh a to nungkwɔ u gwab nwuo lǝ yayuu gu ɓǝ dang ba gi Fuh a fuu ɓǝ. Dang ba a langǝ i kwɔ ǝn ba ya Yahudawa ɓuo lǝu, dang yakwɔ i si Yeso tthǝ i nwongǝi ɓǝ, kwoi lǝ ba longwam ǝndǝi.</para>
  <para style="ip">
    <char style="bk">Matta</char> i mabbu i dǝ matthǝ. I baipiu i bǝ si Yeso, i gei ba bǝ wollmung gu langkwoi i bǝ ɗambǝi kwɔ i ɗammu lǝ ɓǝ, nungkwɔ langkwoi U ǝrr lǝ bǝ gei ba Fuh gu, i bǝ nanatthǝnung, langkwoi i bǝ dǝ tthǝla lǝ yayuu dang Galili. Tthasuo lǝ nungkwɔ i Vullǝ nung to gi Yeso i bǝ thko thko gu tǝlǝ Urshalima langkwoi nung to gi Yeso vii kwɔ pa i gei dang vii kwɔ i piu lǝ lo kab gangǝ i langkwoi i bǝ ǝrri gu dang ɓua. Ba gi Fuh kwɔ illǝ ba gi Yeso lǝ gong ya Nanatthǝnung, kwɔ tthǝ i ttha a mǝrrǝm zuu gi Fuh ɓǝ, kwɔ a nanatthǝnung lǝ ba bǝ lo yigwoi gi Fuh. Bǝ nanatthǝnung a kpaaliu ǝndǝi gǝmlo bǝi nu: (1) bǝ Gei ba Lotal, kwɔ gei ba lo bǝ ibǝ nung ɓǝ, nung to, bǝ tǝi lo, langkwoi i bǝ tǝi gwoi i losua i bǝ lo Yigwoi wayi (nungvullǝ angǝ a 5-7), (2) bǝ gub ɗuogsui ya nanung to gi Yeso sob iu rab, lǝ ba bǝ to nung to gi (Nungvullǝ angǝ a 10); (3) ba dang ba lo bǝ lo Yigwoi wayi (nungvullǝ angǝ a 13); (4) bǝ nanatthǝnung lo ya to nung to gi Fuh (nungvullǝ angǝ a li iu tai); langkwoi (5) bǝ nanatthǝnung lo ba bǝ thǝmi gi nung i ba a nǝnǝng kwɔ i ba bǝ wuo bǝ lo Yigwoi gi Fuh ( nungvullǝ angǝ a 24-25).</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Ya Bie Yeso Kristi</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luka 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Nungvullǝ lo ya bǝba gi Yeso Kristi bie Dawuda, kwɔ lǝ bie Ibrahim ɓǝ:<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />I than ya bǝba kwɔ baipiu tthǝ Ibrahim tǝ muo lǝ Yigwoi Dawuda: Ibrahim lǝ Daa gi Ishaku, Ishaku lǝ Daa gi Yakubu, Yakubu lǝ Daa gi Yahuza i ya youngǝu, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Yahuza lǝ Daa gi Feresa i Zera, kwɔ naa gi lǝ Tamar ɓǝ, Feresa lǝ Daa gi Hesruna, Hesruna lǝ Daa gi Aram, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />Aram lǝ Daa gi Amminadab, Amminadab lǝ Daa gi Nashon, Nashon lǝ Daa gi Salmon, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Salmon lǝ Daa gi Bo'aza, kwɔ naa gu lǝ Rahab ɓǝ, Bo'aza lǝ Daa gi Obida, kwɔ naa gu lǝ Rut ɓǝ, Obida lǝ Daa gi Yesse,<verse eid="MAT 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 1:6" />Langkwoi Yesse lǝ Daa gi Yigwoi Dawuda. Dawuda lǝ Daa gi Sulemanu, kwɔ naa gu lǝ si Uriya ɓǝ, <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />Sulemanu lǝ Daa gi Rehobowam, Rehobowam lǝ Daa gi Abiya, Abiya lǝ Daa gi Asa, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />Asa lǝ Daa gi Yehoshafat, Yehoshafat lǝ Daa gi Yoram, Yoram lǝ Daa gi Azariya, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Azariya lǝ Daa gi Yotam, Yotam lǝ Daa gi Ahaz, Ahaz lǝ Daa gi Hezekiya, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Hezekiya lǝ Daa gi Manassa, Manassa lǝ Daa gi Amon, Amon lǝ Daa gi Yosiya, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />langkwoi Yosiya lǝ Daa gi Yekoniya i ya youngǝu a yiɓǝi vii lǝ kwɔ i ee ya Israila ǝndǝi i tǝlǝ Babila ɓǝ.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Tthasua kwɔ i tǝlǝ ya Israila lǝ Babila kwɔ: Yekoniya lǝ Daa gi Sheyaltiyel, Sheyaltiyel lǝ Daa gi Zarubabel, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Zarubabel lǝ Daa gi Abihudu, Abihudu lǝ Daa gi Eliyakim, Eliyakim lǝ Daa gi Azuro, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />Azuro lǝ Daa gi Saduku, Saduku lǝ Daa gi Akimu, Akimu lǝ Daa gi Aliyudu, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Aliyudu lǝ Daa gi Ele'azara, Ele'azara lǝ Daa gi Matana, Matana lǝ Daa gi Yakubu, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />langkwoi Yakubu lǝ Daa gi Yusufu, ɓǝi Maryamu, yuu kwɔ si Yeso, Yuu kwɔ dǝnni luu angǝ Kristi ɓǝ.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Bǝpi sob iu nai ǝndǝi tthǝ Ibrahim wuu muo lǝ Dawuda, sob iu nai tthǝ Dawuda kwɔ ya Israila sur tǝ Babila ɓǝ, langkwoi bǝpi sob iu nai wuu muo lǝ kristi.<verse eid="MAT 1:17" /></para>
  <para style="s">Bǝ Si Yeso Kristi</para>
  <para style="r">(<ref loc="LUK 2:1-7">Luka 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Bǝ si Yeso kristi wuo manungkwɔni: Yusufu gwab nwa dǝna tǝbǝ dǝb naa gi Yeso Maryamu, yirrǝ i dǝbtha lǝu, i tǝiu i walǝ tthǝ Ɓyang a Langǝ i. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yusufu ɓǝiu ǝn ya langǝ i u yiɗi bǝ duu tthǝkku dang yayuu lǝu. Ərr dǝnnu ɗulǝi bǝ labǝ dǝbbu lǝ bǝ pyǝa. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Kwoi kwɔ dǝnnu nhǝm nungkwɔ, ya nwatummi gi Dangbang fug tthǝu dang muani geiu angǝ, &lt;&lt;Yusufu bǝpi Dawuda, bǝ a sur vulli ba bǝ dǝb Maryamu thǝ, nungkwɔ dang wko kwɔ ǝn a bǝ Ɓyang a Langǝ i. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />U si yui lǝ yiɓǝi ma dǝ ɗuǝnnu lǝ Yeso, bakwɔ u ilǝ yayuu ǝndǝi dang nung a ɓko gi ɓǝ,&gt;&gt;<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Nungkwɔ ǝndǝi to nungkwɔ yangbǝ nungkwɔ Dangbang gei nwa ya gei ba a tthasi kwɔ ǝǝlǝ ba a langǝ i angǝ, <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />&lt;&lt;Munthang a yisi kwɔ i yiɓǝi lǝu kwɔ a lǝi wa u si yui lǝ yiɓǝi, i luu ɗuǝnnu angǝ Immaniyǝl&gt;&gt; (nungɓǝlǝ, Fuh i ɓilǝ&gt;&gt;).<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Kwɔ Yusufu ǝrr nung nung lo, u to nungkwɔ ya nwatummi gi Dangbang geiu tthǝɓǝ u dǝb Maryamu u tǝlǝlǝ gwoi lǝ siu. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Kwoi u lo i ulǝ lǝu wuu si yui lǝ yiɓǝi. Yusufu dǝ ɗuǝnnu lǝ Yeso.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Bǝ Wuo Ya Ibǝnung Lo Vin Gwɔpi Lǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Kwɔ i si Yeso Baitalami dang Yahudiya lona lǝkwɔ Hiridus lǝ yigwoi, ya ibǝnung lo vin ǝrr gwɔpi wuo Urshalima <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />wui ɓib angǝ, &lt;&lt; Yui kwɔ i siu angǝ u ǝǝ lǝ yigwoi ya Yahudawa kwɔ ɓǝla? Ɓi ɓyǝa vin gu pilǝ ɓi wuo bǝ wab bu.&gt;&gt;<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Kwɔ yigwoi Hiridus lǝ nungkwɔni kiggǝu ǝrr, i ya Urshalima ǝndǝi. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />U lubǝ yayuu ǝndǝi yakku ya nyǝknung i ya nanatthǝnung Musa, u ɓibǝi angǝ i si Kristi tthǝn pǝttǝnna?&gt;&gt; <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />I gwab nwa angǝ&lt;&lt; Baitalami dang Yahudiya lǝ, Bakwɔ ǝn nungkwɔ ya gei ba a tthasi vullǝ ɓǝ:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />&lt;&lt; &lt;Kwoi mǝ, Baitalami, losua Yahudiya, mǝ lǝ a tuab dang losua Yahudiya lǝu; dang ɓǝ ɓa tǝi yigwoi kwɔ a gagci yayuum Israila ɓǝ.&gt; &gt;&gt; <verse eid="MAT 2:6" /><verse number="7" style="v" sid="MAT 2:7" />Nungkwɔ Hiridus lubǝ ya ibǝnung lo vin lǝ lǝbǝ pya u ɓibǝi lona kwɔ vin ɓǝ i tthǝɓǝ. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />U tummi Baitalami u gei angǝ,&lt;&lt;Ɓatǝ tǝɓa ɗubǝ yui ɓǝ i kiggǝ. Nǝ ɓa tǝiu, ɓa geimthǝ, yangbǝ ǝntǝ tǝn wabbu langɓǝ.&gt;&gt;<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />I lǝ nungkwɔ yigwoi ɓǝ geiɓǝ, i pa nung gi, vin ɓǝkwɔ i ɓyǝa pilǝ na tǝ loilǝ tǝ dǝi bǝikwɔ yui ɓǝ tthǝɓǝ. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Kwɔ i ɓyǝa vin ɓǝ, tthǝi la ǝndǝi! <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Kwɔ i wuo dang gwoi ɓǝ, i ɓyǝa yui ɓǝ i Naa gu Maryamu, i bai nwalongǝi sua i wabu. I ɓau Bithal gi i gummu nungkurɓǝ a yummi i zinariya, i luban i mur. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Natthǝ Fuh gub ɗogsui dang muani angǝ bǝ i kwoi i tǝ sua Hiridus thǝ, i kwoi i tǝ losua gi nunglǝi akun.<verse eid="MAT 2:12" /></para>
  <para style="s">Bo Dum Tǝlǝ Masar</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Kwɔ ya ibǝnung lo vin ɓǝ pa ǝndǝi, ya nwatummi gi Dangbang fug tthǝ Yusufu dang muani geiu angǝ.&lt;&lt;Hiridus a ɗubǝ yuiɓǝ yangbǝ thǝu. Manungkwɔni yang a ǝrr, a lǝi yui ɓǝ i naa gu ɓasur ɓatǝ Masar, a ǝǝ bǝilǝ nǝ ǝn gei a yitthǝ bǝiɓǝ ɗǝ.&gt;&gt;<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Yusufu ǝrr, lǝi yui ɓǝ i naa gu, nungvii lǝ i pa nunglǝi Masar <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />u ǝǝ bǝilǝ tǝlǝ vii kwɔ Hiridus ɓuilǝ tthǝɓǝ. I to nungkwɔ ni yangbǝ nungkwɔ Dangbang gei nwa ya gei ba a tthasi kwɔ ǝǝlǝ ba a langǝ i, &lt;&lt;Ən lubǝ Yuim ǝn ilǝ dang Masar.&gt;&gt;<verse eid="MAT 2:15" /></para>
  <para style="s">Bǝ Thǝb Yathang</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Kwɔ Hiridus ibǝi angǝ ya yol kwɔ ǝrr gwɔpi kwɔ ɗam nwuǝing, u ɓanglǝ dang wa ghaatthǝ, U dǝba angǝ i thǝb yathang a yiɓǝi dang Baitalami ǝndǝi i yakwɔ tthangtha i ilǝ ɓǝ yakwɔ tthai rab kwoilǝ sua ɓǝ, natha i lona kwɔ u lǝ nwa ya ibǝnung lo vin ɓǝ.<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />Manungkwɔni nungkwɔ ya gei ba tthasi Irmiya gei kwɔ ǝǝlǝ ba a langǝ ing:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />&lt;&lt;I lǝ yol sui yuu akun Ramah,</para>
  <para style="q2" vid="MAT 2:18">yol sui tthǝzii,</para>
  <para style="q1" vid="MAT 2:18">Rahila dǝna tasui lǝ ba yathang gu;</para>
  <para style="q2" vid="MAT 2:18">dǝnnu labǝ yambǝi,</para>
  <para style="q2" vid="MAT 2:18">i ɓumɓui ǝndǝi.&gt;&gt;<verse eid="MAT 2:18" /></para>
  <para style="s">Bǝ kwoi Gi Masar Itǝ Nazarat</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Tthasua bǝ ɓuiɓua gi Hiridus, ya nwatummi gi Dangbang fug tthǝ Yusufu dang muani kwɔ yirrǝ u Masar ɓǝ. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />U geiu angǝ,&lt;&lt;A ǝrr, a lǝi yui ɓǝ i naa gu ɓatǝ losua Israila, bakwɔ yakwɔ dǝna yiɗi bǝ thǝb yui ɓǝkwɔ i ɓui ǝndǝing.&gt;&gt; <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Nungkwɔ Yusufu ǝrr, lǝi yui ɓǝ i naa gu, i kwoi itǝ losua Israila.<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />Kwoi kwɔ Yusufu lǝ angǝ Arkilayus lǝ yigwoi u lǝi bǝ dǝi gi daa gu Hiridus losua Yahudiya, tthǝu sur vulli bǝtǝ bǝ ǝǝ bǝilǝ. Langkwoi ya nwatummi gi Fuh gub ɗuogsuiu dang muani, u kwoi tǝu ǝǝ Galili. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Yusufu tǝ ǝǝ dang gwoi angǝ a Nazarat lǝ, langkwoi nungkwɔ ya gei ba a tthasi gei kwɔ ǝǝlǝ ba a langǝ i: &lt;&lt;I luu ɗuǝnu angǝ ya Nazarat.&gt;&gt;<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Bǝ Nanatthǝnung Gi Yohanna Ya Wollmung</para>
  <para style="r">(<ref loc="MRK 1:1-8">Markus 1:1-8</ref>; <ref loc="LUK 3:1-18">Luka 3:1-18</ref>; <ref loc="JHN 1:19-28">Yohanna 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Lona lǝ kullo Yohanna ya wollmung wuo dǝna gei ba yui Fuh losua a kwi Yahudiya. <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />Dǝnnu gei angǝ, &lt;&lt;Ɓa mǝrrǝm ɓa yitthǝ nung a ɓko ɓǝ,&gt;&gt;bakwɔ lona gbagǝng kwɔ Fuh wa nwong yayuu gu ɓǝ!&gt;&gt; <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Yohanna lǝ yuu akwɔ Ishaya ya gei ba a tthasi dǝna gei bagu ɓǝ kwɔ u gei angǝ,</para>
  <para style="q1" vid="MAT 3:3">&lt;&lt;Yol yuu akun dǝna buogbǝi dang gug angǝ,</para>
  <para style="q2" vid="MAT 3:3">&lt;Mablǝi lǝ Dangbang tthǝ;</para>
  <para style="q2" vid="MAT 3:3">mabbu lǝitthǝ juantthǝ yangbǝ u thkotthǝ!&gt;&gt;&gt;<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />I mab nunglitthǝ gi Yohanna i zuǝ Jurobǝ; u tthǝ i nung tthǝbtthǝ a zuǝ luiu, langkwoi nungtang gu ǝn mangkari i sɔng dang gug. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Yayuu ǝrr Urshalima, i losua Yahudiya, i sua losua kwɔ gbag dual Urdun ɓǝ tǝsuo. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Dǝi gei nwa nung a ɓko gi, langkwoi u wollimung ɗiggǝ nung a ɓko dang dual Urdun.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Kwɔ Yohanna ɓyǝa ya Farisiyawa i ya Sadukiyawa kpaatthǝ dǝna wɔ suo yangbǝ wuu wollimung, u gei angǝ, &lt;&lt;Ɓǝ ya ɗambǝi i Nagilǝ Yi gub ɗuogsui ɓǝ angǝ ɓa sur ɓua kwɔ dǝna wɔ ɓa? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Ɓato i nung to kwɔ a mǝrrǝm dang wa a ɓkoɓǝ ɓǝ. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Langkwoi bǝ ɓa nghǝm ɓangǝ ɓa i dang bǝ ɗablua bǝi dǝɓa gei ɓangǝ, Ibrahim lǝ daa ɓithǝ. Ən gei ɓǝtthǝ dang tal kwɔ Fuh a ǝrr lǝ yathang lǝ Ibrahim tthǝ. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Zom gi Fuh osi tǝtthǝ yǝng kabbǝng, kab kwɔ ǝndǝi si sikab a langǝ i lǝu yang i ɓǝrr i walǝtǝ dang lua a ɗing. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />&lt;&lt;Ən wollɓǝ mung i mungki yangbǝ mǝrrǝm lǝ bǝ yitthǝ nung a ɓkoɓǝ. Kwoi tthasuam yuu akun dǝna wɔ u nyim u pǝllǝm, kwɔ ǝko gu ǝn ɓuan ǝn lǝiu. U wollɓǝ mung i Ɓyang a Langǝ i i lua. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Nung yǝlnung gu nko lǝ, u kai bǝ pǝmnung gu, u gǝm min dang bi langkwoi u li wong i lua a ɗing.&gt;&gt;<verse eid="MAT 3:12" /></para>
  <para style="s">Yohanna Wollmung Lǝ Yeso</para>
  <para style="r">(<ref loc="MRK 1:9-11">Markus 1:9-11</ref>; <ref loc="LUK 3:21">Luka 3:21</ref>,<ref loc="LUK 3:22">22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Lona lǝ kullo Yeso yitthǝ Galili wuo Urdun yangbǝ Yohanna wollǝu mung <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Kwoi Yohanna dǝna yiɗi bǝ lko angǝ,&lt;&lt;Mǝma wollǝm mung, baɓǝ bǝ dǝmma wɔ suamma?&gt;&gt;<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Yeso geiu angǝ,&lt;&lt;Lakwɔ nikwɔ a gwab ɓi to nung a langǝ i kwɔ Fuh dǝna yiɗi ɓi to ɓǝ.&gt;&gt; Nungkwɔ Yohanna gwabbu tthǝ.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Dangtthǝ kwɔ Yohanna wollmung lǝ Yeso ni, u i dang munglǝ. Bǝilǝ kulo wayi ǝrr ɓko, u ɓyǝa Ɓyang gi Fuh dǝna pin mǝngǝn Gko i lua tthǝu lǝ. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Langkwoi yol wayi dǝna gei angǝ,&lt;&lt;Yuu kwɔ ǝn Yuim kwɔ dǝm yiɗi ɓǝ, dǝm lǝ tthǝla gu.&gt;&gt;<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Bǝ Na Yeso</para>
  <para style="r">(<ref loc="MRK 1:12">Markus 1:12</ref>,<ref loc="MRK 1:13">13</ref>; <ref loc="LUK 4:1-13">Luka 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Yang Ɓyang a Langǝ i tǝlǝ Yeso lǝ dang gug yangbǝ Mungkullum tǝ nko. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Tthasua kwɔ Yeso zuu fuh vii thǝmrab nungvii thǝmrab ɓǝ, gwom tǝiu. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Mungkullum ya nabǝi wuo sua Yeso wuu gei angǝ,&lt;&lt;Nǝ mǝn Yui Fuh yang, a gei tal kwɔ mǝrrǝm lǝ nungtang,&gt;&gt;<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Kwoi Yeso gwab nwa angǝ,&lt;&lt;Ba gi Fuh gei angǝ, &lt;Thayuu a tang ǝn nungtang ɓuo lǝu, yangbǝ yuu tǝi nwongǝi dǝnnu yiɗi ba Fuh pǝl nungtang.&gt;&gt;&gt;<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Yang Mungkullum lǝi Yeso tǝlǝ Urshalima, Gwoi Angã a Langǝ i, tǝu lǝ lo kǝm Nyǝknung kwɔ tǝyitthǝ niɓǝ, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />&lt;&lt;langkwoi u geiu angǝ, nǝ mǝn Yui Fuh yang,&gt;&gt; a yina tthǝmǝ a zuǝ pangsua lǝ, i vullǝ angǝ,</para>
  <para style="q1" vid="MAT 4:6">&lt;Fuh a gei ya nwatummi gu lǝ bamǝ;</para>
  <para style="q2" vid="MAT 4:6">i lǝi dang nai,</para>
  <para style="q2" vid="MAT 4:6">yangbǝ bǝ a ɓuob bomǝ tthǝ tal thǝ.&gt;&gt;&gt;<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yeso gwabbu nwa angǝ,&lt;&lt;Kwoi nungvullǝ ba Fuh langɓǝ gei angǝ, &lt;bǝ a na Fuh mǝthǝ.&gt;&gt;&gt;<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Yang Mungkullum lǝi Yeso tǝlǝ lǝ lo tal kwɔ tǝyitthǝ ni kwɔ u tǝu tkonatthǝ gwoi angǝ a longwam i ghaaliu ǝndǝi. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Mungkullum gei angǝ, &lt;&lt;I nungkwɔ ǝndǝi mǝn da, nǝ ma bai nwalongmǝ sua ma wabbǝm ɓǝ.&gt;&gt;<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Yang Yeso gwab nwa angǝ,&lt;&lt;A pa a yimbǝi, Shǝtan! Ba gi Fuh gei angǝ, &lt;A wab Dangbang Fuh mǝ u ɓuo ma tou nung to tthǝ!&gt;&gt;&gt;<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Yang Mungkullum pa yi Yeso, langkwoi ya nwatummi gi Fuh wuu duu nungkwɔ dǝnnu yiɗi ɓǝ.<verse eid="MAT 4:11" /></para>
  <para style="s">Yeso Baipi Nung To Gu Galili</para>
  <para style="r">(<ref loc="MRK 1:14">Markus 1:14</ref>,<ref loc="MRK 1:15">15</ref>; <ref loc="LUK 4:14">Luka 4:14</ref>,<ref loc="LUK 4:15">15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Kwɔ Yeso lǝ angǝ Hiridus tthǝb Yohanna pursǝna, u kwoi suo u tǝ Galili. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />U ǝǝ Nazarat lǝu, kwoi u tǝ Kafarnahum, gwoi angǝ a kwɔ baithanwa i mung Galili, losua Zabaluna i Naftali ɓǝ. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Nungkwɔ to nung manungkwɔni yangbǝ nungkwɔ Ishaya ya gei ba a tthasi gei kwɔ ǝǝlǝ ba a langǝ i,<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />&lt;&lt; Losua Zabaluna i losua Naftali,</para>
  <para style="q2" vid="MAT 4:15">lo nunglǝi tǝ nwa mung, gwam dual Urdun a kullo,</para>
  <para style="q2" vid="MAT 4:15">Galili, losua yayol!<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Yayuu kwɔ ǝǝ dang bǝthǝl kwɔ</para>
  <para style="q2" vid="MAT 4:16">i ɓyǝa bǝi a kaikai angǝ a.</para>
  <para style="q1" vid="MAT 4:16">Yakwɔ ǝǝ losua killǝng ɓua</para>
  <para style="q2" vid="MAT 4:16">bǝ gabǝi wui tthǝng.&gt;&gt;<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Baipiu lona lǝ kullo Yeso baipi bǝ gei bakwɔ Fuh tumu ɓǝ &lt;&lt;Ɓa mǝrrǝm ɓa yitthǝ nung a ɓko ɓǝ, bakwɔ lona kwɔ Fuh wa nwong yayuu gu kwɔ gbagǝng!&gt;&gt;<verse eid="MAT 4:17" /></para>
  <para style="s">Yeso Lubǝ Ya Muo Tthǝng</para>
  <para style="r">(<ref loc="MRK 1:16-20">Markus 1:16-20</ref>; <ref loc="LUK 5:1-11">Luka 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Kwɔ Yeso dǝna thko lo sua zuii nwa mung Galili, u ɓyǝa ya muo tthǝng rab ya youngtha, Saminu (kwɔ dǝi luu angǝ Bitrus ɓǝ) i youngǝu Andarawas, Dǝnni al kalli dang mung lǝ. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yeso gei angǝ,&lt;&lt; Ɓa muo suam, yang mǝn naɓǝ natthǝ bǝ muo yayuu.&gt;&gt; <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Ba a nwaɓi kwɔ i yitthǝ kalli gi i muo suo.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Yeso lilotthǝ thau langkwoi u ɓyǝa ya youngtha a kun rab, Yakubu i Yohanna, yathang Zabadi. I dang kwai i daa gi Zabadi, dǝi mab kalli gi. Yeso lubǝi, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Langkwoi thǝmtthǝ i yitthǝ kwai gi i daa gi i muo suo.<verse eid="MAT 4:22" /></para>
  <para style="s">Yeso Dǝ Tthǝla Lǝya Nung zii</para>
  <para style="r">(<ref loc="LUK 6:17-19">Luka 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yeso gǝng dang Galili, dǝna gei ba Fuh dang kǝm kǝbtha gi, dǝnnu nanatthǝ ba Fuh Nwaba a Langǝ i lǝba bǝ lo yigwoi Fuh, langkwoi dǝnnu ilǝ nung zii kpaatthǝ tthǝ yayuu. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Nwaba gu yǝb lǝibǝi ǝndǝi losua Suriya, nungkwɔ yayuu wulǝ yakwɔ ǝndǝi tthǝi lko ɓǝ, yakwɔ dǝna to zuii i nung zii kpaatthǝ: yakwɔ tthǝ i wa, i farfaɗiya yakwɔ bǝigi akun ɓuilǝ ɓui-langkwoi Yeso ji tthǝla ǝndǝi. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Kon yayuu ǝrr Galili muo suo langkwoi ya gwoi angǝ a sob, Urshalima, yahudiya, i losua kwɔ gwam Urdun kwɔ muo suo.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Yeso Nanatthǝnung Lotal</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Yeso ɓyǝa kon yayuu nungkwɔ, u ɗab tal tǝu ǝǝtthǝ. Ya nanung to gu gǝmtha tthangǝu, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Yeso baipi bǝ nainatthǝnung dǝu gei angǝ:<verse eid="MAT 5:2" /></para>
  <para style="s">Bǝ Lǝtthǝla A Langǝ i</para>
  <para style="r">(<ref loc="LUK 6:20-23">Luka 6:20-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />&lt;&lt;Fuh khana lo yayuu akwɔ ibǝi i ǝn ya nung a ɓko ɓǝ.</para>
  <para style="q2" vid="MAT 5:3">I lǝ tthǝla kwɔ Fuh dǝna dǝlǝ yayuu gu ɓǝ.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />&lt;&lt;Fuh khana lo yayuu kwɔ ǝǝ nwa kǝm ɓuaɓǝ,</para>
  <para style="q2" vid="MAT 5:4">Fuh a ji tǝmmi!<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />&lt;&lt;Fuh khana lo yakwɔ yangǝu i lo angǝ ko ɓǝ;</para>
  <para style="q2" vid="MAT 5:5">Fuh a ji pangsua kwɔ u gwabbǝi nwa ɓǝ.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />&lt;&lt;Fuh khana lo yakwɔ dǝna yiɗi bǝ to nung to i ba gu pǝl nungtang i ɗimung ɓǝ;</para>
  <para style="q2" vid="MAT 5:6">Fuh a ji nungkwɔ dǝnni yiɗi ɓǝ.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />&lt;&lt;Fuh khana lo yakwɔ dǝna ɓyǝa nungzuii yakunɓǝ;</para>
  <para style="q2" vid="MAT 5:7">Fuh a ɓyǝa nungzuii gi langɓǝ!<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />&lt;&lt;Fuh khana lo ya dang wa a langǝ i;</para>
  <para style="q2" vid="MAT 5:8">Fuh a lubǝi lǝ yathang gu!<verse eid="MAT 5:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="MAT 5:9" />Fuh khana lo yakwɔ dǝna to nung to kwɔ a wulǝ bǝ ǝǝ a langǝ i ɓǝ;</para>
  <para style="q2" vid="MAT 5:9">Fuh a lubǝi lǝ yathang gu!<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />&lt;&lt;Fuh khana lo yakwɔ yakun dǝna ji zuii bakwɔ dǝnni to nungkwɔ Fuh dǝna yiɗi ɓǝ;</para>
  <para style="q2" vid="MAT 5:10">I tǝ bǝikwɔ Fuh dǝna lo yigwoi tthǝɓǝ!<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />&lt;&lt; Fuh a khana lo ɓǝ nǝ yayuu dal ɓǝ, to ɓǝ nung aɓau, kǝbpǝlǝ loɓǝ lǝ bam. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Ɓa lǝ tthǝla ghaatthǝ ɓa tǝi tthǝla ghaatthǝ wayi, manung ɓǝni i tolǝ ya gei ba a tthasi yakwɔ osiɓǝ ɓǝ.<verse eid="MAT 5:12" /></para>
  <para style="s">Dǝi I Nung Gabbǝi</para>
  <para style="r">(<ref loc="MRK 9:50">Markus 9:50</ref>; <ref loc="LUK 14:34">Luka 14:34</ref>,<ref loc="LUK 14:35">35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />&lt;&lt;Ɓǝ mangǝ ǝn dǝi lǝ thayuu tthǝ ǝndǝi longwam, Kwoi nǝ dǝi ɓanglǝng yang, i to nǝnǝ i mǝrrǝmu lǝ dǝi langkwoi? Malǝ nung akun langkwoiu, i alǝtǝ yang yayuu a tam i bo.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />&lt;&lt;Ɓǝ mangǝn nung gabbǝi kwɔ yayuu ǝndǝi longwam dǝna yiɗi ɓǝ. Nung to ɓǝ mangǝn gwoi angǝ a lo tal kwɔ ɓuan pyko ɓǝ. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Manung akwɔ yayuu dǝ nung gabbǝi yang lǝi dǝ ɓuapi tthǝmmu ɓǝ; kaso i dǝ bǝdǝi gu, yang dǝ lua lǝ yayuu ǝndǝi dang gwoi. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Manungɓǝni ɓa yitthǝ nung gabbǝi ɓǝ gabbǝi tthasi yayuu, yangbǝ i ɓyǝa nung to a langǝ i ɓǝ yang i kha Daa ɓǝ wayi lǝ.<verse eid="MAT 5:16" /></para>
  <para style="s">Bǝ Nanatthǝnung Lo Zuu</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />&lt;&lt; Bǝ ɓa nhǝm ɓangǝ ǝn wuo bǝ ɓanglǝ zuu gi Musa i bǝ nanatthǝnung ya gei ba a tthasi thǝ. Ən wuo bǝ ɓanglǝ zuu lǝu, kwoi ǝn wuo bǝ alo nung to gi. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Ən gei ɓǝ ba a langǝ i tthǝ, wayi i pangsua a laa, nung yangǝu dang bam kwɔ i touɓǝ, kwɔ lǝ ba dang nung zuu ǝndǝi ato tthǝn to. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Yuu akwɔ ǝndǝi nǝ to nung to i zuu a tuab dang i zuu kwɔ lǝu langkwoi nanatthǝ lǝ yakun to manungɓǝ, ulǝ a tuab bǝikwɔ Fuh lǝ Yigwoi ɓǝ. Langkwoi yuu akwɔ to nung to i zuu lǝ langkwoi nanatthǝ lǝ yakun to manungɓǝ, u ǝǝlǝ angǝ a bǝikwɔ Fuh lǝ Yigwoi ɓǝ. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Ən gei ɓǝtthǝ, nǝ bǝ dǝnyitthǝ ɓǝ pǝl a bǝ ya nanatthǝ zuu i ya Farisiyawa bǝ to nungkwɔ Fuh dǝna yiɗi ɓǝ lǝu ɓatǝ bǝikwɔ Fuh lǝ yigwoi ɓǝu.<verse eid="MAT 5:20" /></para>
  <para style="s">Bǝ Nanatthǝnung Lo Nyi</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />&lt;&lt; Ɓa lǝ angǝ i gei lǝ yayuu tthǝ nungsi angǝ, &lt;&lt;Bǝ ɓa thǝb yuu thǝ; yuu akwɔ nǝ thǝb yuu yang i tou kwan.&gt; <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Kwoi lakwɔ ǝn gei ɓǝtthǝ: nǝ a nyinyi i youngmǝ i toa kwan, nǝ a gei youngmǝ mangǝ &lt;Wawa!&gt; I walǝ tthasi Majalisa, langkwoi nǝ a gei youngmǝ mangǝ mǝ ǝn nung a nǝkwam ma tǝ dang lua a ɗing. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />&lt;&lt;Manungkwɔ ni yang, nǝ dǝma tǝbǝ dǝ nungdǝ dang kǝm pinwa na nhǝm youngmǝ tthǝ i nung dang wolǝ i mǝ, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />a yitthǝ nungdǝ mǝ tthasi tuu, a tǝ thǝmtthǝ ta mab ganglangmǝ i youngmǝ, yang a kwoi suamǝ wa dǝ nungdǝ kwɔ dǝma tǝbǝ dǝu ɓǝ. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />&lt;&lt;Nǝ yuu akun ɓuobnwa lomǝ koto, a mab ganglang mǝ i ulǝ nunglǝi thǝmtthǝ yirrǝ lona tthǝ, nwuni bǝ atǝ koto. Nǝ a kǝn bǝiɓǝng, i talǝ tthasi ya to kwan, i dalǝ ya tthǝbthǝl, yang i tthǝbba pursǝna. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Ən gei ɓǝ ba a langǝ i tthǝ, a iu na kwai sua nungkurɓǝ kwɔ i ɓǝrratthǝ ɓǝ ɗǝ.<verse eid="MAT 5:26" /></para>
  <para style="s">Bǝ Nanatthǝnung Lobǝ Lo i Si Yuu Akun Ko Ɓǝi Yuu Akun</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />&lt;&lt; Ɓalǝ i gei angǝ, &lt;Bǝ ɓa lo i siyuu ko ɓǝi yuu thǝ.&gt; <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Kwoi ǝn gei ɓǝtthǝ: yuu akwɔ ɓyǝa yisi nhǝm bǝ lo i u dang wuo u lo i ulǝn dang nyiu. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Manungkwɔ ni yang nǝ nungmǝ a nali dǝna yiɗi bǝ walǝ nung a ɓko tthǝ, yang a kko a walǝtǝ! Maɗing kwɔ bǝi akun tthǝmǝ yangǝu kwɔ ma ǝǝ i tthǝmǝ ǝndǝi yang atǝ lua a ɗing ɓǝ. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Nǝ namǝ a nali a walǝ nung a ɓko tthǝ, yang a ɓǝrr a walǝtǝ! Maɗing kwɔ bǝi a kun tthǝmǝ yangǝu kwɔ ma ǝǝ i sua tthǝmǝ ǝndǝi yang ta tǝlǝ lua a ɗing ɓǝ.<verse eid="MAT 5:30" /></para>
  <para style="s">Bǝ Nanatthǝnung Lo Bǝ Yinalǝ Yisi</para>
  <para style="r">(<ref loc="MAT 19:9">Matthew 19:9</ref>; <ref loc="MRK 10:11">Markus 10:11</ref>,<ref loc="MRK 10:12">12</ref>; <ref loc="LUK 16:18">Luka 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />&lt;&lt; Ɓa lǝ i gei angǝ, &lt;Yuu akwɔ nǝ yina lǝ siu yang a du ɗǝi gǝu gu.&gt; <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Kwoi lakwɔ ǝn gei ɓǝtthǝ: nǝ yiɓǝi akwɔ nǝ yina lǝ siu, nǝ ba nung a ɓko ghaatthǝ lǝu, yang u du dang bǝ to nung a ɓkong, nǝ u dǝbgwoi akun; yiɓǝi kwɔ nǝ dǝbbu kwɔ dǝna to nung a ɓko i ulǝ langɓǝ.<verse eid="MAT 5:32" /></para>
  <para style="s">Bǝ Nanatthǝnung Lo Bǝ Zuu Nung</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />&lt;&lt;Ɓalǝ langkwoi i geilǝ yayuu tthǝ nungsi angǝ, &lt;Bǝ a mǝrrǝm nwamǝ lo nung zuu kwɔ a lǝi ɓǝthǝ, kwoi a dǝi lo nung zuu kwɔ a lǝi ganglang mǝ i Dangbang ɓǝ.&gt; <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Kwoi lakwɔ ǝn gei ɓǝtthǝ: bǝɓa zuu nung nǝ dǝɓa gwab nwa thǝ. Bǝ a zuu nung i wayi thǝ, ǝn bǝ lo yigwoi gi Fuh; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />ko longwam, ǝn bǝ dǝbo gu; ko Urshalima, ǝn gong gwoi angǝ a gi Yigwoi. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Bǝ ɓa zuu nung i lo ɓǝthǝ, ɓa ɓuan ɓa mab byang lo kun la vǝrǝm ko la ɓilingǝu. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />A gei mangǝ &lt;Əhn&gt;ko &lt;Yangǝu&gt;-nung akun kwɔ pǝl nungkwɔ wuo bǝgǝ Mungkullum.<verse eid="MAT 5:37" /></para>
  <para style="s">Bǝ Nanatthǝnung Lobǝ Vohnung</para>
  <para style="r">(<ref loc="LUK 6:29">Luka 6:29</ref>,<ref loc="LUK 6:30">30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />&lt;&lt; Ɓa lǝ i gei angǝ, &lt;Nǝ yuu ɓuom nungmǝ yang a ɓuom nungǝu, langkwɔi nǝ yuu akun lub lǝimǝ yang i lub abo langɓǝ.&gt; <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Kwoi lakwɔ ǝn gei ɓǝtthǝ bǝɓa voh nung a ɓko kwɔ yuu akun to ɓǝlǝ ɓǝthǝ. Nǝ yuu akun ɓuob ɓuasuiimǝ yang a mǝrrǝm mu ɓosui akun ɓǝtthǝ. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Nǝ yuu akun dǝna yiɗi bǝ ɓuobnwa lomǝ lǝ ba nunglitthǝ mǝ, a yiutthǝ nung ɓuobtthǝmǝ ǝndǝi. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Langkwoi nǝ yuu akun toa lǝttha angǝ a thkothko tuliu mǝl kun yang a tǝ i ulǝ mǝl rab. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Nǝ yuu akun yam nung namǝ, adu; nǝ yuu akun dǝna yiɗi bǝ muo than nung akun namǝ, adu than ɓǝ.<verse eid="MAT 5:42" /></para>
  <para style="s">Ɓa Yiɗi Ya Ɓuiɓǝ</para>
  <para style="r">(Luka 6:27,28, 32-36)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />&lt;&lt;Ɓa lǝ i gei angǝ, &lt;Ɓa yiɗi ya ǝnthǝ ɓǝ, ɓa la ya ɓui ɓǝ.&gt; <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Kwoi lakwɔ ǝn gei ɓǝtthǝ: ɓa yiɗi ya ɓui ɓǝ ɓa pinwa lǝ yakwɔ dǝna dǝɓǝ zuii ɓǝ, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />yangbǝ ɓa mǝrrǝm lǝ yathang Daa ɓǝ wayi. Bakwɔ dǝu du fuh gu lo ya ɓko i ya langǝ i natha, langkwoi dǝu namung lǝ yakwɔ dǝna to nung a langǝ i i yakwɔ dǝna to nung a ɓko ɓǝ. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Ən baɓǝ bǝ Fuh a da nungbusɔni nǝ dǝma yiɗi yakwɔ dǝna yiɗiǝ ɓuoɓa? I ya muo nungǝmmi ǝndǝi dǝna to nungɓǝ kullo! <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Langkwoi nǝ dǝɓa gei ba i ya ǝnthǝ ɓǝ ɓuo yang, ǝnɓǝ ato pǝl a bǝ yakunna? I yakwɔ i Fuh lǝu kwɔ dǝna to manungɓǝ! <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Ɓa to nung matthǝ-manung a bǝ Daa ɓǝ wayi kwɔ dǝna to matthǝ ɓǝ.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Yeso Nanatthǝnung Lobǝ Nwong Ya Yiɓko</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />&lt;&lt; Ɓa to kiggǝ ɓǝ bǝ ɓato nung a langǝ i tthasi yayuu, yangbǝ i ɓyǝa thǝ. Nǝ ɓato yang, ɓa tǝi nungbusɔni ɓǝ na Daa ɓǝ wayiu.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />&lt;&lt;Nǝɓa dǝ nung akun lǝ yuu kwɔ nung yangǝu nko, bǝ ɓa gei i nung gei ba thǝ, manung akwɔ ya kǝb pǝllǝ dǝna to dang kǝm wab Fuh i lonung lǝi, yangbǝ yayuu ji angǝ a. Ən gei ɓǝ ba a langǝ i tthǝ, i muo nungbusɔni gi ǝndǝing. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Kwoi nǝɓa dǝ nung lǝ ya yiɓko, bǝɓa gwab naɓǝ a namai ibǝ nungkwɔ nali dǝna to ɓǝthǝ, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />yangbǝ nungkwɔ ɓa dǝ kwɔ ǝǝlǝ lǝ bǝ pyǝa. Yang Daa ɓǝ, kwɔ bǝ pyǝa kwɔ, a dǝɓǝ nungbusɔni ɓǝ dang bǝthǝl.<verse eid="MAT 6:4" /></para>
  <para style="s">Bǝ Nanatthǝnung Lobǝ Pinwa</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luka 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />&lt;&lt;Langkwoi nǝ ma pinwa, bǝ a pinwa mangǝn ya pǝllǝ thǝ, bakwɔ i yiɗi bǝ dǝi nǝbo dang kǝm wab Fuh i tthǝllak lǝi, yangbǝ yayuu na ɓyǝai. Ən gei ɓǝ ba a langǝ i tthǝ, i muo nungbusɔni gi ǝndǝing. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Nǝ ma pinwa, atǝ dang kǝm mǝ a ttha dang , lam nwa kǝm mǝ yang a pinwa mǝ tthǝ Daa mǝ, yuu kwɔ da ɓyǝa nungkwɔ dǝmma to dang bǝthǝl kwɔ, u da nungbusɔni mǝ. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Kwɔ nǝma pinwa, ba dǝi nwabǝ kwab ba mangǝ ǝnya kwɔ i Fuh lǝu ɓǝthǝ, dǝnni nhǝm angǝ fuh gi a lǝi ǝnlǝ ba kpaali bǝ pinwa gi. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Bǝ a to manung abǝi thǝ, Daa mǝ ibǝi nungkwɔ dǝma yiɗi ɓǝng nwuni bǝ a ɗyǝabu. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />&lt;&lt;Ɓa pinwa manungkwɔ ni:</para>
  <para style="q1" vid="MAT 6:9">&lt;Daa ɓi wayi lǝ:</para>
  <para style="q2" vid="MAT 6:9">Kaso i dǝ angǝ a lǝ ɗuǝn mǝ;<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Kaso bǝ lo yigwoi mǝ wuo;</para>
  <para style="q2" vid="MAT 6:10">kaso i to nungkwɔ dǝmma yiɗi i to longwam manung akwɔ wayi ɓǝ.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Dǝɓi nungtang a ɗiggǝ kwɔ dǝɓi yiɗi ɓǝ.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />A al nung a ɓko ɓilǝtǝ,</para>
  <para style="q2" vid="MAT 6:12">manung akwɔ ɓi al nung a ɓko yakwɔ toɓi nung a ɓko lǝtǝ ɓǝ.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Bǝ a naɓi pǝll ttha ɓithǝ,</para>
  <para style="q2" vid="MAT 6:13">kwoi a iɓilǝ na Mungkullum.&gt;<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />&lt;&lt;Na al nung a ɓko yakwɔ toa i nung a ɓko lǝtǝ yang, Daa mǝ ya wayi a al nung a ɓko mǝlǝtǝ langɓǝ. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Kwoi na al nung a ɓko yakun lǝtǝ lǝu, yang Daa mǝ wayi al nung a ɓko mǝ lǝtǝu.<verse eid="MAT 6:15" /></para>
  <para style="s">Bǝ Nanatthǝnung Lobǝ Zuu Fuh</para>
  <para style="pi">
    <verse number="16" style="v" sid="MAT 6:16" />&lt;&lt;Langkwoi nǝ ma zuu Fuh, bǝ a nuong nungmǝ thǝ manung akwɔ ya pǝllǝ dǝna to ɓǝthǝ. Dǝnni nuong nungǝi yangbǝ yayuu ibǝi angǝ dǝnni zuu Fuh. Ən gei ba a langǝ i tthǝ, i muo nungbusɔni gi ǝndǝing. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Kwɔ nǝma zuu Fuh yang, a fa nui lo mǝ a ɓual nungmǝ a ee lomǝ, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />yangbǝ bǝ yakun ibǝi angǝ dǝmma zuu Fuh thǝ- ǝn Daa mǝ ɓuo a ibǝi, yuu akwɔ i ɓyǝko ɓǝ, a ibǝi. Langkwoi Daa mǝ kwɔ, dǝna ɓyǝa nungkwɔ dǝmma to dang bǝthǝl kwɔ, a da nungbusɔni mǝ.<verse eid="MAT 6:18" /></para>
  <para style="s">Nungtǝi Wayi</para>
  <para style="r">(<ref loc="LUK 12:33">Luka 12:33</ref>,<ref loc="LUK 12:34">34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />&lt;&lt;Bǝɓa dǝ nungtǝi lǝ loɓǝ tthǝ longwam thǝ, bǝikwɔ i zǝɓyang ibǝ ogwom a ɓanglǝ ɓǝ, langkwoi bǝikwɔ ya nung i a abnwakǝm a i ɓǝ. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Manung akwɔ ni yang, a dǝ nungtǝi mǝ wayi, bǝikwɔ i zǝɓyang ibǝ ogwom ɓuan ɓanglǝu ɓǝ, langkwoi bǝikwɔ ya nung i ɓuan abnwakǝm ɓǝ iu ɓǝ. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Bakwɔ bǝikwɔ a dǝ nungtǝi mǝtthǝ, nyimǝ vii ǝndǝi bǝilǝ.<verse eid="MAT 6:21" /></para>
  <para style="s">Nungabbǝi Tthǝ</para>
  <para style="r">(<ref loc="LUK 11:34-36">Luka 11:34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />&lt;&lt;Nung lǝ lua gabbǝi tthǝ. Nǝ nungmǝ maɗing, sua tthǝmmǝ ǝndǝi ǝn lua; <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />kwoi nǝ nungmǝ mko, sua tthǝmmǝ kwɔ ǝndǝi dang bǝthǝl. Nǝ lua kwɔ tthǝmmǝ kwɔ ǝn thǝl, yangbǝ baithǝl ɓǝ nǝnǝ!<verse eid="MAT 6:23" /></para>
  <para style="s">Fuh I Nungtǝi</para>
  <para style="r">(<ref loc="LUK 16:13">Luka 16:13</ref>; <ref loc="LUK 12:22-31">12:22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />&lt;&lt;A ɓuan a ǝǝlǝ thǝb ya togwoi rabbu; ma la yuu akun yang ma yiɗi yuu akun; ma to nung to i ba yuu akun langkwoi ma la yuu akun. A ɓuan a dǝ angǝ a lǝ Fuh i nungkurɓǝu.<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />&lt;&lt;Manungkwɔ ni yang ǝn gei ɓǝtthǝ: bǝ kiggǝ ɓǝ ǝrr lǝ ba nwongǝi thǝ, nungkwɔ ɓa tang i nungkwɔ ɓa nwa thǝ; langkwoi lǝ ba tthǝmmǝ, nungkwɔ ma li ɓǝthǝ. Nwongǝi pǝl nung tang lǝu? Langkwoi tthǝ pǝl nunglitthǝ lǝu? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Ɓa ɓyǝa i nurug wayi; i byǝko i ɓǝrrǝu langkwɔi i al biu, yirrǝ Daa ɓǝ wayi da ji nungtang. Ɓa pǝlli lǝu? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Ənyiǝ dang ɓǝ bǝ ǝrr lǝ kiggǝu kwɔ a lilo nwongǝi lona kun lǝlo ttha? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />&lt;&lt; Ən ba ɓǝ bǝ kiggǝ ɓǝ dǝna ǝrr lǝ ba nunglittha? Ɓa ɓyǝa i vin dang gug kwɔ dǝna ghaa ɓǝ. I to nung akun a vǝrǝm ko a ɓilǝngǝu <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Yirrǝ ǝn gei ɓǝtthǝ ko ǝn Sulemanu i nungtǝi gu u li nunglitthǝ pǝl yuu akun dang yakwɔ lǝu. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Nǝ manungkwɔ ni Fuh li nunglitthǝ lǝ gug dang gug, kwɔ bǝi kwɔ ɗiggǝ kwɔ bung yang o dang lua, u dǝ ɓǝ nunglitthǝ pǝll a bǝi wa, ɓǝkwɔ bǝ dǝnyitthǝ ɓǝ tuab ɓuo ɓǝ. <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />&lt;&lt;Bǝ ɓa ǝrr lǝ kiggǝ dǝɓa gei ɓangǝ: &lt;Ənɓǝ ɓi tang?&gt; Ko ǝnɓǝ ɓi nwa? Ənɓǝ ɓi liǝ? <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />(I nungkwɔ ǝn nungɓǝkwɔ yakwɔ i Fuh lǝu kwɔ dǝna dǝnyitthǝ.) Daa ɓǝ wayi ibǝing dǝɓa yiɗi i nungɓǝkwɔ. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Manungkwɔ ni yang, ɓa ɗuu bǝ lo yigwoi Fuh langkwoi i nungkwɔ dǝu yiɗi ɓǝ, u dǝɓǝ sua i nungkwɔ ǝndǝi. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Manungkwɔ ni yang bǝ ɓa ǝrr lǝ kiggǝ ɓǝ lǝ ba bung thǝ; bǝ a lilo bǝ ǝrr lǝ kiggǝ kwɔ bung a wɔ lǝ ɓǝthǝ.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Bǝto Kwan Lǝ Yakun</para>
  <para style="r">(Luka 6:37,38, 41,42)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />&lt;&lt; Bǝ ɓa to kwan lǝ yakun thǝ, yang Fuh to ɓǝ kwanu langɓǝ. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Bakwɔ Fuh a toa kwan manung akwɔ dǝma to kwan lǝ yakun ɓǝ, langkwoi u naa nungtthǝ manungkwɔ dǝmma nalǝ yakun tthǝ ɓǝ.<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />&lt;&lt; Ən baɓǝ yang, dǝɓa ɓyǝa yui kong kab kwɔ nung youngmǝ yang a la bǝ ɓyǝa gong kong kab kwɔ nungmǝ ɓǝwa? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Ən baɓǝ bǝ ma gei youngmǝ mangǝ, &lt;Dǝi sua, ǝn ilǝ yui kong kab kwɔ nungmǝ ɓǝ,&gt;kwɔ gong kong kab nung amǝlǝ ɓa? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Ɓǝ ya pǝllǝ! A osi a ilǝ gong kong kab kwɔ nungmǝ ɗǝ, yangbǝ a ɓyǝa kaitthǝ bǝ a ilǝ yui kong kab kwɔ nung youngmǝ ɓǝ.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />&lt;&lt;Bǝ ɓa dǝ nung a langǝ i lǝ ɗua thǝ; bǝ ɓa al nung a yummi lǝ thag tthǝ thǝ- i tam i bo i ɓanglǝ.<verse eid="MAT 7:6" /></para>
  <para style="s">Yam, Ɗuu, Gabnwakǝm</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luka 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />&lt;&lt;A yam yang i da ǝndǝ; ɗuu yang ma tǝntǝi; a gabnwakǝm yang i ɓkotthǝ ǝn ɓko. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Yuu akwɔ ǝndǝi yam nung i du ǝndǝ, langkwoi yuu akwɔ ɗuu a tǝntǝi; yuu akwɔ gabnwakǝm i ɓkotthǝn ɓko.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />&lt;&lt;Ənyiǝ dang ɓǝ kwɔlǝ daa adǝ tal lǝ yuiu nǝ u yam nungtang nko ɓa? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Ko ma du biǝk nǝ u ɓib pi tthǝng ɓa? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Ɓko kwɔ ɓa ɓko kwɔ, ɓa ibǝ bǝ dǝ nung a langǝ i lǝ yathang ɓǝng. Tonǝnǝ tha i Daa ɓǝ wayi kwɔ a dǝ nung a langǝ i lǝ yakwɔ yam nko ɓa! <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />A to nung lǝ ya kuntthǝ manung akwɔ dǝma yiɗi i to tthǝɓǝ: nungkwɔ nungɓǝ lǝ nungkwɔ zuu gi Musa gei langkwoi i bǝ nanatthǝnung ya gei ba a tthasi.<verse eid="MAT 7:12" /></para>
  <para style="s">Nwalǝgwoi A Tuab</para>
  <para style="r">(<ref loc="LUK 13:24">Luka 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />&lt;&lt;A muo ttha dang nwalǝgwoi a tuab, bakwɔ nwalǝgwoi kwɔ a tǝlǝ lua a ɗing kwɔ aiɗing langkwoi lǝiɓǝ kwɔ a tǝlǝ kwɔ ziiu, langkwoi yayuu kpaatthǝ dǝna thkotthǝ. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Kwoi nwalǝgwoi kwɔ a tǝlǝ nwongǝi kwɔ tabtthǝ langkwoi lǝi kwɔ a tǝlǝ tthǝ kwɔ ziiɗing, langkwoi yayuu kpako kwɔ dǝna tǝiɓǝ.<verse eid="MAT 7:14" /></para>
  <para style="s">Kab I Siu</para>
  <para style="r">(<ref loc="LUK 6:43">Luka 6:43</ref>,<ref loc="LUK 6:44">44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />&lt;&lt;Ɓa dǝ kiggǝ ɓǝ ba ya gei ba a tthasi ya pǝllǝ; i wuu tthǝɓǝ mangǝn ɓangam ttha gwam, kwoi ttha dang lǝ i mangǝn ɗua gug. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Ɓa iǝ tthǝ nung to gi. Kob si inabiu, lankwoi gug kob si gol lǝu. <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Kab a langǝ i dǝna si sikab a langǝ i, kwoi kab a ɓko dǝna si sikab a ɓko. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Kab a langǝ i ɓuan si sikab a ɓko, langkwoi kab a ɓko ɓuan si sikab a langǝ iu. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Langkwoi Kab akwɔ ǝndǝi kwɔ si sikab a langǝ i lǝu i ɓǝrǝu i walǝtǝ dang lua lǝ. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Manung akwɔ ni yang, ɓa i ya gei ba a tthasi ya pǝllǝ i nungkwɔ dǝnni toɓǝ.<verse eid="MAT 7:20" /></para>
  <para style="s">Ən Iɓǝ Lǝu</para>
  <para style="r">(<ref loc="LUK 13:25-27">Luka 13:25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />&lt;&lt;Ən yayuu ǝndǝi kwɔ dǝna geim angǝ, &lt;Dangbang, Dangbang,&gt; a tǝ bǝikwɔ Fuh lǝ yigwoi ɓǝlǝu, kwoi yakwɔ dǝna to nungkwɔ Daam wayi da yiɗi angǝ i toɓǝ. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Kwɔ nǝ vii to kwan nǝ wuo, yayuu kpaatthǝ a geim angǝ, &lt;Dangbang, Dangbang! Dang ɗuǝn mǝ ɓi gei nwaba a langǝ i gi Fuh, i ɗuǝn mǝ ɓi nan wa kpaatthǝ langkwoi ɓi to nung fǝmlo kpaatthǝ!&gt; <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Yang mǝn geigǝ, ǝn i ɓǝlǝu. Ɓa pa ɓa yimbǝi ya to nung a ɓko!&gt;<verse eid="MAT 7:23" /></para>
  <para style="s">Ya Maikǝm Rab</para>
  <para style="r">(<ref loc="LUK 6:47-49">Luka 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />&lt;&lt;Lakwɔ yang, yuu akwɔ nǝ lǝ bam kwɔ tolǝ nung to yang u natha i ya yiggǝi kwɔ mai kǝm gu lo ɓǝmtal ɓǝ. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Mung na, dual wuo, langkwoi wa ɓuob lo gwoi lǝ. Kwoi gwoi ɓǝ o lǝu, bakwɔ i li pi kǝm ɓǝ lo ɓǝmtal ɓǝ.<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />Kwoi yuu akwɔ nǝ lǝ bam kwɔ yang la bǝ tolǝ nung to u natha i ya sullǝ kwɔ mai gwoi gu lo suazuii ɓǝ. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Mung na, dual kyal wa ɓuob lo gwoi lǝ gwoi ɓǝ dǝr o ɓko tthǝ!&gt;&gt;<verse eid="MAT 7:27" /></para>
  <para style="s">Ttha Gi Yeso</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Kwɔ Yeso alo bǝ gei i nungkwɔ, lo kon yayuu ɓǝ fǝmtthǝ bǝ nanatthǝnung gu. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />U mangǝn ya nanatthǝnung Musa lǝu; manung akwɔ ni yang, dǝu nanatthǝnung i tthǝnyimmi.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Yeso Dǝ Tthǝla Lǝ Ya Əmbǝlai</para>
  <para style="r">(<ref loc="MRK 1:40-45">Markus 1:40-45</ref>; <ref loc="LUK 5:12-16">Luka 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Kwɔ Yeso pin lo tal lǝ, gong kon yayuu muo suo. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Yang yiɓǝi a kun i nung zii ǝmbǝlai wuo suo, bai nwalongǝu sua tthasiu, gei angǝ,&lt;&lt;Yikku, nǝ a gwabǝng, yang a dǝm tthǝla.&gt;&gt;<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Yeso juan nko kǝn lǝ yiɓǝi ɓǝ angǝ,&lt;&lt;Ən gwabǝng,&gt;&gt;u gei angǝ. &lt;&lt;A tǝi tǝmmi!&gt;&gt;Dang tthǝ u tǝi tthǝla tthǝ ǝnbǝlai gu. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Yang Yeso geiu angǝ,&lt;&lt; Alǝ! Bǝ a gei lǝ yuu akun tthǝ thǝ. Kwoi atǝ ta tana tthǝmǝ lǝ ya nyǝknung tǝ ɓyǝa; yangbǝ yayuu ibǝi angǝ a tǝi tthǝlang, a dǝ nungkwɔ Musa gei tthǝɓǝ lǝ bǝ gei nwa nung a langǝ i gi Fuh.&gt;&gt;<verse eid="MAT 8:4" /></para>
  <para style="s">Bǝ Dǝba A Langǝ i Gi Yikku Ya Taɓui</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luka 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Kwɔ Yeso tǝ dang Kafarnahum, yikku ya taɓui wuo suo, dǝu ɗyǝab bǝ nwongbǝi. <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />&lt;&lt;Yikku, tthǝ thǝbbǝm lko u lo gwoi, bo i nko ɓumɓui dǝu to zuii ghaaɗing.&gt;&gt;<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Yeso geiu angǝ,&lt;&lt;Mǝn tǝ tǝmmǝn duu tthǝla,&gt;&gt;<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Yikku ya taɓui ɓǝ mǝrrǝm gwab nwa angǝ,&lt;&lt;Dangbang, ǝn kǝn kwɔ ma wɔ suam gwoi ɓǝlǝu. A gei ba, yangbǝ thǝbbǝm tǝi tthǝla. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Ɓang kwɔ i nam lǝ ɓang ǝn ya dǝ lona, i ya sojǝ suam. Ən gei a kwɔ, &lt;a tǝ,&gt; yang u pa; Ən gei yuu akulo &lt;a wɔ,&gt; yang u wuo. Ən gei ya thǝbbǝm, &lt;a to akwɔ,&gt; yang u to.&gt;&gt;<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Kwɔ Yeso lǝ nungkwɔ, lo fǝm u gei lǝ yakwɔ da muo suo kwɔ angǝ,&lt;&lt;Ən gei ɓǝ ba a langǝ i tthǝ, Ən tǝi yuu akun dang Israila kwɔ tthǝ i bǝ muo nung lo zuu manung a kwɔ ɓǝlǝu. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Ən gei ɓǝtthǝ geigǝ yayuu kpaatthǝ a wɔ ttha gwɔpi i lǝdah, i lǝi bǝ ǝǝ gi bǝ to ɓang i Ibrahim, Ishaku i Yakubu bǝikwɔ Fuh lǝ yigwoi ɓǝ. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Kwoi yakwɔ a ǝǝ bǝikwɔ Fuh lǝ yigwoi kwɔ i ali gwam dang bǝthǝl, bǝilǝ kwɔ i tasui i tang nai i wurrǝ.&gt;&gt;<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Yang Yeso gei lǝ yikku ya taɓui ɓǝ angǝ,&lt;&lt;Atǝ gwoi, langkwoi nungkwɔ a dǝ ba a langǝ i tthǝkwɔ i toa tthǝn to.&gt;&gt;</para>
  <para style="p" vid="MAT 8:13">Langkwoi thǝb gi yikku ya taɓui bǝ tǝi tthǝla lona lǝ kullo.<verse eid="MAT 8:13" /></para>
  <para style="s">Yeso Dǝ Tthǝla Lǝ Yayuu Kpaatthǝ</para>
  <para style="r">(<ref loc="MRK 1:29-34">Markus 1:29-34</ref>; <ref loc="LUK 4:38-41">Luka 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Yeso tǝ dang gwoi Bitrus, langkwoi bǝilǝ kwɔ u ɓyǝa gong Bitrus a yisi lolo nung lo i tthǝ sɔnni. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />U kǝnnatthǝ nko; tthǝ sɔnni ɓǝ yiu na, ǝrr u baipi bǝ yoou nungtang tthǝ.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Kwɔ nunglui to, yayuu kpaatthǝ kwɔ wa tthǝi ɓǝ i wuilǝ, u ilǝ wa ɓǝ i ba nwa kun u ji tthǝla yakwɔ tthǝi lko ɓǝ <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Nungkwɔ yangbǝ yinwa ba kwɔ Ishaya ya gei ba tthasi gei ɓǝ: &lt;&lt;U lǝi zuii ɓi langkwoi u lǝi nungzii ɓi.<verse eid="MAT 8:17" /></para>
  <para style="s">Zuii Bǝ Muo Sua Yeso</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luka 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Kwɔ Yeso ɓyǝa kon yayuu suo, u gei angǝ i nyang i tǝ nwangwam a kulo. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Yang ya nanatthǝnung gi Musa wɔ suo u gei angǝ, &lt;&lt;Ya nanatthǝnung, Mǝn muo sua mǝ bǝikwɔ ma tǝtthǝ ǝndǝi. &gt;&gt;<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Yeso gwab nwa angǝ, &lt;&lt;I kwintang tthǝ i ɓua langkwoi nurug wayi tthǝ i kǝm, Yui yuu yangǝu i bǝi kwɔ a lotthǝ a nwongɓǝu.&gt;&gt;<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Ya nanung to a kun geiu angǝ,&lt;&lt;Dangbang, nwa siu a dǝi sua tǝn suu Daam ɗǝ.&gt;&gt;<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Yeso geiu angǝ, &lt;&lt;Muo suam, yang ya ɓui ɓua su kwamɓui yuu gi.&gt;&gt;<verse eid="MAT 8:22" /></para>
  <para style="s">Yeso Dǝi lǝ Wamung</para>
  <para style="r">(<ref loc="MRK 4:35-41">Markus 4:35-41</ref>; <ref loc="LUK 8:22-25">Luka 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Yang ǝrr u tǝ dang kwai ya nanung to muo suo. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Wa ɓǝ wuo ibǝ ibǝi gi lǝu gong wa ǝrr lo nwam ghaatthǝ, ee mung ɓǝ pǝl lo kwai ɓǝ. Yeso dǝna lo nung lo. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Ya nanung to tǝ ǝrrǝu lǝ, gei angǝ, &lt;&lt;Dangbang, a nwong ɓi! Dǝɓi tǝ bǝ dhko dang mung lǝ!&gt;&gt;<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Yeso gei angǝ,&lt;&lt;Ɓǝ yakwɔ bǝ dǝnyitthǝ ɓǝ tuab nikwɔ, ba ɓǝ dǝɓa sur vulli?&gt;&gt; Yeso ǝrr dǝi lǝ wa ɓǝ i mung kwɔ dǝna ǝrr ɓǝ, wa ɓǝ dǝi.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Nung ɓǝ fǝmlo yayuu ɓǝ dǝna ɓib angǝ,&lt;&lt;Yiɓǝi a ɓǝnni bǝ wa i tǝnglǝ gi mung dǝna lǝu!&gt;&gt;<verse eid="MAT 8:27" /></para>
  <para style="s">Yeso Dǝ Tthǝla Lǝ Yaɓǝi Rab Kwɔ Wa Tthǝi Ɓǝ</para>
  <para style="r">(<ref loc="MRK 5:1-20">Markus 5:1-20</ref>; <ref loc="LUK 8:26-39">Luka 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Kwɔ u wuo nwan gwam a kullo losua Garasinawa, ya wa rab i bǝ suu kwamɓui yuu wui kǝbbu. Kiggǝi ɓko ɗing kwɔ yuu akun yangǝu dǝna pa bǝi lǝu ɓǝ. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />&lt;&lt;Dangtthǝ i buogbǝi angǝ, &lt;&lt;Ənɓǝ dǝma yiɗi i ɓila, mǝ Yui Fuh? A wuo bǝ ɗablua ɓi yangbǝ lona dǝ?&gt;&gt;<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Thag tthǝ kpaatthǝ tutha i ilǝu dǝna tang nung. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Nungkwɔ i wa ɓǝ yam Yeso angǝ, &lt;&lt;Nǝ ma i ɓilǝ, yang a tuog ɓi tthǝ thag lǝ.&gt;&gt;<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Yeso gei angǝ,&lt;&lt;Ɓatǝ!&gt;&gt; Nungkwɔ i itǝ tthǝ thag ɓǝ, i thag ɓǝ sur tǝ nwa gungwǝ mung tǝi al dang mung i ɓui dang mung lǝ. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Yakwɔ dǝna gagci thag ɓǝ padum, i tǝ dang ganglang gwoi tǝi gei nungkwɔ, i nungkwɔ tǝi yaɓǝi kwɔ rab kwɔ wa tthǝi ɓǝ. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Ərr yayuu losua ɓǝ ǝndǝi ǝrr i tǝ kǝb Yeso. Langkwoi kwɔ i ɓyǝko, i yammu angǝ u pa losua gi.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Yeso Dǝ Tthǝla Lǝ Ya Ɓuibo</para>
  <para style="r">(<ref loc="MRK 2:1-12">Markus 2:1-12</ref>; <ref loc="LUK 5:17-26">Luka 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Yeso tǝ dang kwai, nyang wuo tǝ gwoi kwɔ i siu tthǝ ɓǝ. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Ya kun wulǝ lǝ ya ɓuibo lolǝ lo lo gei. Kwɔ Yeso ɓyǝa bǝ dǝ ba a langǝ i gi, u gei lǝ ya ɓuibo ɓǝ angǝ,&lt;&lt;A Lǝi i nyi yuim! I al nung a ɓko mǝlǝ tǝng,&gt;&gt;<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Yang yakun dang ya nanatthǝnung gi Musa gei lǝ thatthǝ angǝ, &lt;&lt;Yiɓǝi kwɔ dǝna dal Fuh!&gt;&gt;<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Yeso ibǝ nungkwɔ dǝi nhǝm ɓǝng, langwkoi nungkwɔ u gei angǝ,&lt;&lt;Ən baɓǝ bǝ dǝ ɓa nhǝm ba mullub manungkwɔ ni? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />A nwuo ziiu: kwɔ i gei angǝ, &lt; I al nung a ɓko mǝ lǝtǝng,&gt;ko i gei angǝ, &lt;A ǝrr a thko&gt;? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Yangbǝ ɓa ibǝi Yui Yuu tthǝ i ttha longwam kwɔ u al nung a ɓko lǝ tǝ ɓǝ.&gt;&gt; Langkwoi u gei lǝ ya ɓuibo ɓǝ angǝ, &lt;A ǝrr a dǝi nǝbo, a lǝi gei mǝ atǝ gwoi.&gt;&gt; <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Nungkwɔ yiɓǝi ɓǝ ǝrr dǝi nǝ bo pa lǝigwoi <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Kwɔ kon yayuu ɓyǝa nungkwɔ, tthǝ vulli mui, i dǝ angǝ a lǝ Fuh, kwɔ dǝ nunglǝi kwɔ lǝ yayuu ɓǝ.<verse eid="MAT 9:8" /></para>
  <para style="s">Bǝ Lubǝ Matta</para>
  <para style="r">(<ref loc="MRK 2:13-17">Markus 2:13-17</ref>; <ref loc="LUK 5:27-32">Luka 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Yeso ǝrr pa bǝilǝ, u ɓyǝa yuu akun tthǝ ɗuǝnu ǝn Matta u ǝǝ kǝm muo nungǝmmi dǝnnu muo nungǝmmi. Yeso geiu angǝ,&lt;&lt;A muo suam,&gt;&gt;</para>
  <para style="p" vid="MAT 9:9">Nungkwɔ Matta ǝrr muo suo.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Kwɔ Yeso dǝna tang nungtang a nungluii gwoi Matta, ya muo nungǝmmi kpaatthǝ i ya nung a ɓko bǝilǝ lang wuo wu tang nungtang i ulǝ i ya nanung to gu. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Kwɔ ya Farisiyawa ɓyǝa nungkwɔ, i ɓib ya nanung to gu angǝ,&lt;&lt;Ən baɓǝ bǝ ya nanatthanung ɓǝ dǝna tang nungtang i ya muo nungǝmmi i ya nung a ɓko?&gt;&gt;<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />I bǝ lǝ nungkwɔ ni, Yeso gei angǝ,&lt;&lt;Ən ya tthǝla dǝna ɓyǝa ya dǝ yǝng lǝu, ǝn ya nungzii. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Ɓa tǝ tǝɓa na ɓa lǝ nung kwa: &lt;Dǝm yiɗi bǝ ɓyǝa nungzuii, bǝ nyǝknung lǝu.&gt; Ən wuo bǝ lubǝ ya langǝ i lǝu, ya nung a ɓko.&gt;&gt;<verse eid="MAT 9:13" /></para>
  <para style="s">I Ɓib Yeso Babǝ Zuu Fuh</para>
  <para style="r">(<ref loc="MRK 2:18-22">Markus 2:18-22</ref>; <ref loc="LUK 5:33-39">Luka 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Langkwoi ya muo sua Yohanna wu ɓibbu angǝ,&lt;&lt;Baɓǝ bǝ ɓi i ya Farisiyawa dǝna zuu fuh, bǝ ya nanung to mǝ zuu wa?<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Yeso gwab nwa angǝ,&lt;&lt;Baɓǝ bǝ yayol gi yuu gwoi a ɓanglǝ dang wa nǝ u tthǝɓa? Lona da wɔ kwɔ i lǝi yuu gwoi nai i palǝ; yang i zuu fuh.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />&lt;&lt;Yuu akun yangǝu kwɔ a fyǝh nung litthǝ afu i nunglitthǝ aku tthǝtha ɓǝu, nung fyǝh ɓǝ a tǝrra tthǝ nung litthǝlla, nunglitthǝ ɓǝ a tǝrr ɓkotthǝ pǝll a nwasiu. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Yayuu al min afu dang kulluk aku. Nǝ i to ni, kulluk ɓǝ a ɓumɓuom, min ɓǝ a alǝtǝ yang kullug ɓǝ a ɓanglǝ. Nilǝu, i al min afu dang kulluk afu, yang ǝndei a ǝn ǝǝ.&gt;&gt;<verse eid="MAT 9:17" /></para>
  <para style="s">Kwamɓui Munthang A Yisi I Yisi Kwɔ Tthǝu Lkoɓǝ</para>
  <para style="r">(<ref loc="MRK 5:21-43">Markus 5:21-43</ref>; <ref loc="LUK 8:40-56">Luka 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Kwɔ dǝnnu gei bakwɔ, ya dǝ kabnwa nung wuo bai nwalongǝu sua u gei angǝ,&lt;&lt;Yuim a yisi ɓui nǝnǝngǝkwɔ. A wuo wa dǝna lolǝ, yangbǝ u ǝrr i nwongǝi.&gt;&gt; <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Yeso ǝrr pa suatha i ulǝ, i ya nanung to gu. <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />Yisi akun kwɔ zii dǝna al tthǝu ttha sob iu rab kwɔ wuo tthasuko lǝ wu kǝn natthǝ nwa nunglitthǝ gu. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />U gei dang nyiu lǝ angǝ,&lt;&lt;Nǝ ǝn kǝn natthǝ nunglitthǝ, gu mǝn tǝi tthǝla.&gt;&gt;<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Yeso mǝrrǝm ɓyǝko gei angǝ,&lt;&lt;A lǝi i nyi, yuim a yisi! Bǝ dǝ ba a langǝ i mǝ da tthǝlang.&gt;&gt;Ba a nwaɓi kwɔ yisi ɓǝ tǝi tthǝ la.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Yang Yeso tǝ dang gwoi ya dǝ kabnwa nung u tǝi ya ɓiɓii i kon yayuu dǝna buogbǝi, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />u gei angǝ,&lt;&lt;Ɓa pa ɓa yibǝi. Munthang a yisi ɓǝ ɓuilǝu dǝnnu lo ǝn nung lo!&gt;&gt; I tǝ bǝ mammu. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Kwoi dang tthǝ kwɔ i nan kon yayuu i gwam, u tǝ dang kǝm tǝu lǝi munthang a yisi ɓǝ nko, munthang a yisi ɓǝ ǝrr dǝi nǝbo. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Baɓǝ lǝi losua ɓǝ ǝndei.<verse eid="MAT 9:26" /></para>
  <para style="s">Yeso Dǝ Tthǝla Lǝya Nungɓuommi Rab</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Kwɔ Yeso lilo tthǝ, ya nung ɓuommi rab muo suko, dǝnni lubǝi angǝ,&lt;&lt;A ɓyǝa nungzui ɓi Yui gi Dawuda&gt;&gt;<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />kwɔ yeso tǝ ttha dang , ya nung ɓuommi ɓǝ wuo suko, u ɓibbǝi angǝ,&lt;&lt;Ɓa dǝba a langǝ i tthǝ ɓangǝ mǝn to nungkwɔ ǝn toa?&gt;&gt;</para>
  <para style="p" vid="MAT 9:28">&lt;&lt;I gwab nwa angǝ&lt;&lt;Əah Yikku!&gt;&gt;<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Yang Yeso kǝnnatthǝ nungǝi u gei angǝ,&lt;&lt;Manung akwɔ ɓa dǝ ba a langǝ i i to ɓǝtthǝ manungɓǝ!&gt;&gt; <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Ərr nungǝi tǝbǝ ɓyǝabǝi. Yeso gub ɗuogsui nyimtthǝ angǝ,&lt;&lt;Bǝ yuu akun ibǝ nungkwɔ thǝ!&gt;&gt;<verse eid="MAT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31" />Kwoi i igwam tǝi gei ba lǝi bǝikwɔ ǝndǝi losua lǝ.<verse eid="MAT 9:31" /></para>
  <para style="s">Yeso Dǝ Tthǝla Lǝ Yiɓǝi Kwɔ Ɓuan Ghaibko Ɓǝ</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Kwɔ yaɓǝi ɓǝ dǝna igwam, yuu akun kwɔ wa a ɓko tthǝu u gei bko kwɔ i wulǝ sua Yeso. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Kwɔ i ilǝ wa a ɓko ɓǝ tthǝu, yiɓǝi ɓǝ kwɔ wa a ɓko tthǝu kwɔ tǝ bǝ gei ba. Kon yayuu kwɔ loi fǝm i gei angǝ,&lt;&lt;Nung yangǝu manung akwɔ ni to nung dang Israila lǝu.&gt;&gt;<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Kwoi ya Farisiyawa gei angǝ,&lt;&lt;U ilǝ wa a ɓko kwɔ i ttha Yui gi yigwoi wa. &gt;&gt;<verse eid="MAT 9:34" /></para>
  <para style="s">Yeso Ɓyǝa Nungzuii Yayuu</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yeso thko dang woi angǝ a i gwoi a tuab kwɔ ǝndǝi. Dǝnnu nainatthǝnung dang kǝm kǝbtha gi, dǝnnu gei ba a langǝ i tthǝ ba wayi langkwoi dǝnnu ilǝ nung zii. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Kwɔ u ɓyǝa kon yayuu, u ɓyǝa nung zuii gi, bakwɔ dǝnni to zui, manung gi ɓangam kwɔ ya gagciu yangǝu ɓǝ. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Nungkwɔ u gei lǝ ya nanung to gu tthǝ angǝ,&lt;&lt;Nungɓǝrri kpaaɗing ya nung to ɓǝ kpako <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Ɓa pinwa tthǝ yuu nungɓǝrri ɓǝ yangbǝ u tumbǝi iya nung to bǝ ɓǝrr nung zug gu.&gt;&gt;<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Yeso Tum Ya Nanungto Gu Sob Iu Rab</para>
  <para style="r">(<ref loc="MRK 3:13-19">Markus 3:13-19</ref>; <ref loc="LUK 6:12-16">Luka 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />U lubǝ ya nanung to gu sob iu rab u ji ttha yangbǝ i ilǝ wa a ɓko tthǝ yayuu i dǝ tthǝla lǝ yakwɔ nungzii tthǝi i yakwɔ tthǝi lko ɓǝ.<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:2 </char>
      <char style="xt" closed="false" />
    </note>Ɗuǝn ya nanung to gi Yeso kwɔ sob iu rab ɓǝ: A kun, Saminu (kwɔ dǝi lu angǝ Bitrus ɓǝ) i youngǝu Andarawas; Yakubu yui Zabadi, i youngǝu Yohanna; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filibus i Bartalamawas; i Toma i Matta ya muo nungǝmmi; Yakubu yui Halfa, i Yahuza; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Saminu ya Bakan'ane i Yahuda Iskariyoti, kwɔ ɗyǝab Yeso ɓǝ.<verse eid="MAT 10:4" /></para>
  <para style="s">Nwatummi Ya Nanung To Sob Iu Rab</para>
  <para style="r">(<ref loc="MRK 6:7-13">Markus 6:7-13</ref>; <ref loc="LUK 9:1-6">Luka 9:1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Yayuu kwɔ sob iu rab kwɔ Yeso tummǝi i ba a nyimmi angǝ: &lt;&lt;Bǝ ɓa tǝ dang ya wabnung thǝ ko ɓa tǝ gwoi ya Samariya thǝ. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Ɓa tǝ sua ɓangam ya Israilawa kwɔ la ɓǝ. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Nǝ dǝɓa tǝ, ɓa gei ba kwɔ lǝ yayuu tthǝ: &lt;Bǝ lo yigwoi Fuh gbagǝn!&gt; <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Ɓa dǝ tthǝla lǝ ya nungzii ǝrr lǝ kwamɓui yuu ɗiggǝ yakwɔ tthǝ i ǝmbǝlai ɓǝ, Ilǝ wa a ɓko. Nǝkwam ɓa muo nung nǝkwam ɓa dǝ. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Bǝ ɓa lǝi nungkurɓǝ a yummi zinariya i azurfa ko tagulla naɓǝ thǝ; <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Bǝ ɓa lǝi tthau na ɓǝ ɓǝthǝ, ko nung bailo, ko ǝn aũ ko ǝn kab baina thǝ; i dǝ nungkwɔ ya nung to dǝna yiɗi ɓǝ.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />&lt;&lt; Kwɔ nǝɓa tǝ gwoi angǝ a i a tuab, ɓa ɗuu ya langǝ i bǝilǝ yang ɓa ee gwoi gu tǝlǝ viikwɔ ɓa patthǝ ɓǝ. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Nǝ ɓa tǝ gwoi ɓǝ, ɓa gumbǝi. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Nǝ gwoi ɓa ǝn a langǝ i, yang salama ɓa ee lolǝ, Nǝ yangǝu, yang salama ɓǝ kwoi wuo tthǝɓǝ. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Nǝ yuu akun kǝb loɓǝ lǝu ko dǝ sui tthǝɓǝ lǝu, ɓa kusungha kunɗur bo ɓǝ nǝ ɓa pa gwoi angǝ a ko gwoi a tuab. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Ən gei ɓǝ ba a langǝ i tthǝ, a malǝ losua Sadoma i Gwamrata tthǝ ɗing vii to kwan lo gwoi ɓǝ kulo.<verse eid="MAT 10:15" /></para>
  <para style="s">Bǝ Tangzuii A Wuo</para>
  <para style="r">(<ref loc="MRK 13:9-13">Markus 13:9-13</ref>; <ref loc="LUK 21:12-17">Luka 21:12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Dǝmǝn tumm ɓǝ lǝ nwa ɓangam dang kwintang. Ɓa yigtthǝ lǝ nwa biǝk ɓa to kiggǝ lǝ nwa gko.<verse eid="MAT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17" />&lt;&lt;Ɓa dǝ i kiggǝ ɓǝ tthǝ kiggǝ thayuu; i dǝɓǝ lǝ ya dǝ kab nwa nung i ɓuob ɓǝ dang kǝm kǝbtha gi. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Lǝ bam i wuo ɓǝlǝ tthasi ya dǝ kabnwa ba i ya yigwoi lǝ shǝdǝ gi i yayol. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Nǝ i muo ɓǝ, bǝ kiggǝ ɓǝ ǝrr thǝ nungkwɔ ɓa gei ko nunglǝi kwɔ ɓa geilǝ ɓǝthǝ. Lona lǝ kullo i gei nungkwɔ ma gei ɓǝ. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Ɓǝɓa gei ba lǝu, Ɓyang a langǝ i gi Daa ɓǝ a gei nwa ɓǝ.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />&lt;&lt;Young a ɓanglǝ young a dǝ ɓua gu, langkwoi Daa i yui; Yathang a la ba ya daa gi i wuilǝ ɓua tthǝ. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Yayuu ǝndǝi a la ɓǝ lǝ ba ɗuǝnnǝm, yuu akwɔ dǝi nyimtthǝ tǝlǝ bǝ alo u sob lo. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Nǝ i toɓǝ lǝ zuii gwoi angǝ a a kun, ɓa sur ɓatǝ bǝi a kun. Ən gei ɓǝ ba a langǝ i tthǝ, ɓa alo bǝ thkothko dang woi angǝ a Israilawa yangbǝ Yui Yuu wuo.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />&lt;&lt;Yakwɔ dǝna nanung pǝl lo ya nainatthǝ nungǝu, ko ya thǝb ghaa pǝl togwoi gu. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Natthǝng kwɔ ya nanung a itha i ya nkonatthǝ nung ɓǝ, langkwoi thǝb mangǝn togwoi gu. Nǝ ni luu yuu gwoi angǝ Ba'alzabul, yang ya dang woi gu ɗuǝnni a ɓko ɗing!<verse eid="MAT 10:25" /></para>
  <para style="s">Yuu Akwɔ I Surɓǝ</para>
  <para style="r">(<ref loc="LUK 12:2-7">Luka 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />&lt;&lt;Bǝɓa sur vulli ba yayuu thǝ. Nung a kun yangǝu kwɔ pyǝa kwɔ igwammu ɓǝ, nungkwɔ i pyǝa kwɔ i ibǝi ǝn i. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Nungkwɔ ǝn gei ɓǝtthǝ lǝ bǝ pyǝa kwɔ, i gei dang fuh lǝ; nungkwɔ i gei lǝ yaya ɓuasui ɓǝ, i gei i yol angǝ a. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Bǝɓa sur yakwɔ a thǝb thayuu ɓuo ɓuan thǝb killǝngǝu ɓǝ. Kwoi ɓa sur Fuh yuu akwɔ a ɓuan a thǝb yuu i killǝngǝu dang lua a ɗing ɓǝ. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Gǝlko dǝnni ɗyǝab sui muam i nungkurɓǝ a tuab rab wai? Nǝ Fuh Daa ɓǝ gwab yangbǝ sui muam kun o pangsua. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Ɓaɓǝ abo, i byang lo kwɔ loɓǝ kwɔ Fuh thanthan. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Manungkwɔ ni yang bǝɓa sur vulli thǝ; ɓa pǝll sui muam kpaatthǝng!<verse eid="MAT 10:31" /></para>
  <para style="s">Bǝ Gwab Yeso I Bǝ La Yeso</para>
  <para style="r">(<ref loc="LUK 12:8">Luka 12:8</ref>,<ref loc="LUK 12:9">9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />&lt;&lt;Yakwɔ dǝna gei nung yayuu angǝ i ǝn abǝm, mǝn toitthǝ manungɓǝ tthasi Daam wayi. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Kwoi yuu akwɔ nǝ labǝ muo suam yang, mǝn gei gǝnge ǝn iulǝu tthasi Daam wayi.<verse eid="MAT 10:33" /></para>
  <para style="s">Ən Wuolǝ Bǝ A Langǝ i Lǝu, Ən Wuolǝ Ən Ɓui</para>
  <para style="r">(<ref loc="LUK 12:51-53">Luka 12:51-53</ref>; 14:26, 27)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />&lt;&lt;Bǝɓa nhǝm ɓangǝ ǝn wuo lǝ bǝ ǝǝ a langǝ i longwam thǝ. Nilǝu, ǝn wuolǝ bǝ ǝǝ a langǝ i lǝu, ǝn wuo lǝ ǝnɓui. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Ən wuo bǝ dǝ ɓui ganglang yathang i ya Daa gi, yathang asi tthǝ ya Naa gi, yasi tthǝ ya gɔngǝi; <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />ya ɓui mǝ a ɓko ǝn ya dang woi mǝ.&gt;<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />&lt;&lt;Yakwɔ dǝna yiɗi Daa gi ko Naa gi pǝllǝm yang i natthǝ kwɔ i ǝǝlǝ ya nanungtom ɓǝlǝu; yakwɔ nǝ yiɗi yuiu a yiɓǝi ko a yisi pǝllǝm yang i natthǝ kwɔ i ǝǝlǝ ya nanungtom ɓǝlǝu. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Yakwɔ nǝ lǝi kab gangǝ i gi i muo suam lǝu kǝn kwɔ ǝǝlǝ yananungtom lǝu. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Yakwɔ dǝna yiɗi bǝ kang nwongǝi gi yang i tǝiu, kwoi yakwɔ nǝ la nwongǝi gi lǝ bam i tǝntǝi.<verse eid="MAT 10:39" /></para>
  <para style="s">Nungbusɔni</para>
  <para style="r">(<ref loc="MRK 9:41">Markus 9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />&lt;&lt;Yuu akwɔ nǝ kǝb loɓǝ muo ǝn ɓang; langkwoi yuu akwɔ kǝb lom kǝb ǝn lo yuu akwɔ tummǝm ɓǝ. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Yuu akwɔ nǝ kǝb lo ya nwatummi gi Fuh, u tǝi nwathan gu dang nungbusɔni ya nwatummi lǝ. Langkwoi nǝ yuu akun kǝb lo yuu a langǝ i bakwɔ u ǝn ya langǝ i, ma tǝi nwathan mǝ dang nungbusɔni gu. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Yuu akwɔ nǝ dǝ mungki a tǝmmi lǝ ya nanungtom bakwɔ ilǝ ya nanungtom, ǝn gei ɓǝ ba a langǝ i tthǝ, u tǝi nungbusɔni gu ǝn tǝi.&gt;&gt;<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Ya Nwatummi Gi Yohanna ya wolmung</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luka 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Kwɔ Yeso alo bǝ dǝ nwatummi lǝ ya nanung to gu sob iu rab kwɔ, u pa u lilotthǝ tǝu nanatthǝ ba a langǝ i gwoi ya Galili.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Kwɔ Yohanna ya wollmung lǝ dang pursǝna u lǝ nungkwɔ Kristi da to kwɔ, u tum ya nanung to gu <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />tǝi ɓib Yeso angǝ, &lt;&lt;Mǝn Kristi kwɔ dǝna wɔ ɓa, ko ɓi ki yuu akuna? &gt;&gt;<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Yeso gei angǝ, &lt;&lt;Ɓa kwoi ɓatǝ tǝɓɓa geilǝ Yohanna ya wollmung tthǝ nungkwɔ ɓalǝ i nungkwɔ ɓa ɓyǝa ɓǝ: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Ya nungɓuommi dǝna ɓyǝabǝi, ya kuglǝ da thko, yakwɔ tthǝ i ǝmbǝlai tǝi tthǝla, ya ɓuomsui dǝna lǝ bǝi, yakwɔ ɓui kwɔ ǝrr i nwongǝi, langkwoi ya yiɓko lǝ ba a langǝ i. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Fuh khana lo yukwɔ o lǝu lǝ bam ɓǝ!&gt;&gt;<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Lona kwɔ ya nanung to gi Yohanna dǝna pa, Yeso tǝ bǝ gei ba lǝ kon yayuu ba Yohanna angǝ: &lt;&lt; Kwɔ ɓa tǝbbǝ ɓyǝa Yohanna dang gug kwɔ ɓǝɓa tǝbǝ ɓyǝko? Dǝɓa tǝbǝ ɓyǝa vǝlla? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Nǝ nilǝu yang, ɓǝ ɓa tǝbbǝ ɓyǝko? Yiɓǝi kwɔ li nunglitthǝ a ɓungɓui ɓa? Nilǝu, yakwɔ da li nung ɓungɓui kwɔ tthǝn gwoi yigwoi. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Bǝ ǝn ɓǝɓa tǝbbǝ ɓyǝko? Ya gei ba a tthasi? Əah, Ən gei ɓǝtthǝ, u pǝl ya gei ba a tthasiǝn. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />U ɓǝlǝ yuu akwɔ i vullǝ nung lǝ ba gu ɓǝ.</para>
  <para style="q1" vid="MAT 11:10">&lt;&lt; &lt;Mǝn tum ya nwatummim si ɓǝ,</para>
  <para style="q2" vid="MAT 11:10">yuu akwɔ a mabba nunglǝi tthǝ yangbǝ a wɔ ɓǝ.&gt;<verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />Ən gei ɓǝ ba a langǝ i tthǝ: Yohanna ya wollmung lǝ ya angǝ a dang yayuu ǝndǝi; kwoi yuu a tuap longwam a fuh kwɔ pǝll Yohannǝn. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Baipiu dang wam Yohanna ya wollmung wuolǝ ɗigǝ kwɔ, ya nung a ɓko dǝna taɓui i bǝ lo yigwoi gi Fuh, dǝnni tottha dǝnni yiɗi bǝ muou. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Ya nanatthǝnung zuu gi Musa i ya gei ba a tthasi i kwɔ ǝn i dǝba nwuni bǝ Yohanna. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Langkwoi nǝɓa gwabnwa ba gi, u lǝ Iliya kwɔ da wɔ ɓǝ. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Yuu akwɔ tthǝ i sui lǝbǝi, yang u lǝ yang u ibǝi.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />&lt;&lt;Ɓǝ mǝn nalǝ ya dang wam kwa? I mangǝn yathang ǝǝ lomu dǝna lubǝ tha:<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />&lt;&lt; &lt;Ɓi ɓiɓǝ ɓii tthǝ,</para>
  <para style="q2" vid="MAT 11:17">ɓa nab dang lǝu;</para>
  <para style="q1" vid="MAT 11:17">Ɓi lub ɓin ɓua</para>
  <para style="q2" vid="MAT 11:17">ɓa ɓanglǝ dang wa lǝu.&gt;<verse eid="MAT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 11:18" />Yohanna wɔ bǝ gei ba a langǝ i gi Fuh dǝnnu zuu fuh, i gei angǝ, &lt;U tthǝ i wa a ɓko.&gt; <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Yui Yuu wuo da tang dǝna nwa, ɓangǝ, &lt;Ya nungtang i ya nwamung kwɔ, ǝnthǝ ya muo nungǝmmi i &lt;&lt;ya nung a ɓko.&gt;&gt;&gt;Kwoi yiggǝi gi Fuh duu ba a langǝ i ba nungkwɔ u to ɓǝ.&gt;&gt;<verse eid="MAT 11:19" /></para>
  <para style="s">Ɓua Lo Gwoi Angã Kwɔ Yitthǝ Nung a Ɓkolǝu Ɓǝ</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luka 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Ərr Yeso baipi bǝ la gwoi angǝ a kwɔ u to nung fǝmlo bǝilǝ, bakwɔ i labǝ yitthǝ nung a ɓko gilǝu ɓǝ. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />&lt;&lt; Yeso gei angǝ ɓato zuii ya, Korasinu! Ɓato zuii, ya Betsaida! Nǝ nung fǝmlo kwɔ i to ɓǝtthe kwɔ nǝ i to tthǝn Taya i Sidon, yang i yitthǝ nung a ɓko gi tuung nung tǝr nung i sɔng. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Ən gei ɓǝ ba a langǝ itthǝ, vii to kwan Fuh a ɓyǝa nungzuii ya Taya i Sidon. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Langkwoi ya, Kafarnahum, i lǝi ɓǝn lǝi i tǝlǝ wayiǝ? Yangǝu, Fuh a talǝ lua a ɗing. Nǝ nung to fǝmlo kwɔ ǝn to tthǝɓǝ kwɔ nǝ ǝn to tthǝn Sadoma, yang nikwɔ yirrǝ tthǝ. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Ən gei ɓǝtthǝ, vii to kwan, Fuh a ɓyǝa nungzuii ya losua Sadoma lo ɓǝlǝ.&gt;&gt;<verse eid="MAT 11:24" /></para>
  <para style="s">Nwongǝi Ba Ya Zuii</para>
  <para style="r">(<ref loc="LUK 10:21">Luka 10:21</ref>,<ref loc="LUK 10:22">22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Lonalǝ kulo Yeso gei angǝ, &lt;&lt;Ən da angǝ a, Daa, Dangbang ya wayi i pangsua, bakwɔ a tanatthǝ nungkwɔ lǝ yakwɔ ibǝ nunglǝu ɓǝ, langkwoi a lamnung ya yiggǝi i ya ibǝ nung. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Əh, Daa, nungkwɔ lǝ nungkwɔ a yiɗi bǝ touɓǝ.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />&lt;&lt;Nung ǝndei Daam dǝ dang nam. Yuu akun yangǝu ibǝi Yuiu ǝn Daa ɓuo, langkwoi yuu akun yangǝu i Daa ǝn Yui ɓuo iu langkwoi yakwɔ Yui mko u tai natthǝu.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />&lt;&lt;Ɓa wɔ suam, ɓǝ yakwɔ dǝna to zuii i nungkwɔ ya nanatthǝnung gi Musa naɓǝ natthǝ kwɔ, mǝn dǝɓǝ nwongǝi. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Ɓa to nungkwɔ ǝn gei ɓǝtthǝ geigǝ ɓato ɓǝ, ɓang ǝn ya tǝmnyi ǝn ya lo angǝ a lǝu, ɓa tǝi nwongǝi tthǝ killǝng ɓǝ. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Kab sua dulǝm ziiu, langkwoi nunglǝi kwɔ geigǝ ɓa lǝi kwɔ yǝb ɗing.&gt;&gt;<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Vii Nwongǝi Ya Yahudawa</para>
  <para style="r">(<ref loc="MRK 2:23-28">Markus 2:23-28</ref>; <ref loc="LUK 6:1-5">Luka 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Vii nwongǝi ya Yahudawa Yeso tǝ dang zug i ya nanung to gu. Gwom tǝi Ya nanung to gu i har lo min dǝnni tang. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Kwɔ ya Farisiyawa ɓyǝa ni yang, i geiu angǝ, &lt;&lt;A ɓyǝa! Ya nanung to mǝ dǝna to nungkwɔ ǝn nung zuu tthǝɓi ya Yahudawa ɓǝ.&gt;&gt;<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Yeso gwabǝi nwa angǝ, &lt;&lt; Ɓa than lǝu dang bǝ nanatthǝnung gi Musa nungkwɔ Dawuda to i ya ǝnthǝu kwɔ gwom tǝi ɓǝlǝu? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />U tǝ kǝm pinwa gi Fuh, u i ya ǝnthǝu i tang nungtang nyǝknung kwɔ ǝn nung a langǝ i kwɔ i to ɓǝlǝu, kwɔ ǝn yayuu Fuh a to. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Ko ɓa than lǝu dang zuu gi musa angǝ vii nwongǝi ya nyǝknung gi Fuh dang kǝm nyǝknung ɓanglǝ dang fuh ɓǝ kwɔ i ibǝ nung akun lǝu ɓa. <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Ən gei ɓǝtthǝ nung akuntthǝ bǝikwɔ ghaa pǝl kǝm Nyǝknung. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Nung vullǝ ba Fuh gei angǝ&lt;Dǝmǝn yiɗi ǝn nyitǝmmi, ǝn bǝ nyǝknung i nungbyang lǝu.&gt;Nǝ la langǝ i ɓa ibǝ nungkwɔng ɓǝ, yang krǝ ɓa gei nung a ɓko lo yakwɔ ibǝ nunglǝu ɓǝ; <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Bakwɔ Yui Yuu lǝ Dangbang vii nwongǝi.&gt;&gt;<verse eid="MAT 12:8" /></para>
  <para style="s">Yiɓǝi Kwɔ Nko Ɓuiɓui Ɓǝ</para>
  <para style="r">(<ref loc="MRK 3:1-6">Markus 3:1-6</ref>; <ref loc="LUK 6:6-11">Luka 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Yeso yitthǝ bǝiɓǝ kullo tǝ dang kǝm kǝbtha ya Yahudawa, <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />bǝilǝ kullo yiɓǝi akuntthǝ kwɔ nko ɓuiɓui kwɔ bǝilǝ. Dǝnni ɗu nunglǝi kwɔ i muo Yeso i ba angǝ u to nung a ɓkong, nungkwɔ i ɓibbu angǝ, &lt;&lt;Bǝ nanatthǝnung gi Musa gwabǝng angǝ nǝ i dǝ tthǝla lǝ yuu a kun vii nwongǝi yang nung a ɓko?&gt;&gt;<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Yeso gwabǝi nwa angǝ, &lt;&lt;Nǝ yuu akun dang ɓǝ i ɓangam kwɔ o dang ɓua vii nwongǝi? U muo u ɗab lǝ wa? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Langkwoi ɓa i bǝikwɔ thayuu pǝl ɓangam ɓǝlǝu! Nǝ niyang zuu gi Musa gwab ɓitthǝng ɓi to nung a langǝ i vii nwongǝi.&gt;&gt;<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Yang u gei yiɓǝi ya ɓui naɓǝ angǝ, &lt;&lt;A Juan namǝ.&gt;&gt;</para>
  <para style="p" vid="MAT 12:13">U juan nko, nko kwoi wuo matthǝ langkwoi, manung a kun ɓǝ. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Yang ya Farisiyawa ɓǝ i gwam yangbǝ tǝto nunglǝi kwɔ i thǝb Yeso ɓǝ.<verse eid="MAT 12:14" /></para>
  <para style="s">Ya Thǝb Gi Fuh Kwɔ i Mko Ɓǝ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Kwɔ Yeso lǝ nungkwɔ ya Farisiyawa dǝna yiɗi bǝ tou lǝ kwɔ, u i bǝilǝ u pa nungu; langkwoi gong kon yayuu kpaatthǝ muo suo. U dǝ tthǝla lǝ ya nungzii ǝndei, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />u gei angǝ bǝ i gei lǝ ba akun loi lǝ yakun tthǝthǝ. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />U to nungkwɔ yangbǝ nungkwɔ ǝlǝ ba a langǝ i bakwɔ Ishaya ya gei ba a tthasi gei ɓǝ angǝ:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />&lt;&lt;Thǝbbǝm kwɔ, yuu akwɔ ǝn mko ɓǝ,</para>
  <para style="q2" vid="MAT 12:18">yuu akwɔ dǝm yiɗi ɓǝ, langkwoi yuu akwɔ dǝm lǝ tthǝ la gu ɓǝ.</para>
  <para style="q1" vid="MAT 12:18">Mǝn dǝ Ɓyang a langǝ im tthǝu lǝ,</para>
  <para style="q2" vid="MAT 12:18">u gei kwanǝm gwoi angǝ a ya longwam ǝndǝi.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />U nyimtha nwa i yuu akunu ko u buogbǝiu;</para>
  <para style="q2" vid="MAT 12:19">ko yuu akun yangǝu a lǝ yollu nunglǝi ganglang gwoi angǝ ko.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />U ab kab nwakǝm kwɔ kwal ɓǝu,</para>
  <para style="q2" vid="MAT 12:20">u mual lua gabǝi kwɔ da mual ɓǝu,</para>
  <para style="q1" vid="MAT 12:20">U tǝllǝ ba a langǝ i lǝ bǝ ilo.<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />Langkwoi dang ɗuǝnnu gwoi angǝ a ya longwam a dǝnyitthǝu.&gt;&gt;<verse eid="MAT 12:21" /></para>
  <para style="s">Yeso i Ba'alzabul</para>
  <para style="r">(<ref loc="MRK 3:20-30">Markus 3:20-30</ref>; <ref loc="LUK 11:14-23">Luka 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Yang yakun wulǝ yiɓǝi akun lǝ sua Yeso kwɔ wa a ɓko tthǝu ɓǝ u ǝn ya nung ɓuommi langkwoi u lǝbǝiu, Yeso du tthǝla, kwɔ u gei ba langkwoi u ɓyǝa bǝi ǝndǝi. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Tthe vulli muo yakwɔ bǝilǝ ǝndei ɓǝ i gei angǝ, &lt;&lt; Yuu kwɔ ǝn Yui Dawuda tthaiwai?&gt;&gt;<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Kwɔ ya Farisiyawa lǝ nungkwɔ, i gei angǝ,&lt;&lt;Nungkwɔ ǝnba Ba'alzabul, yigwoi wa a ɓko kwɔ yuu kwɔ dǝna ilǝ wa.&gt;&gt;<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Yeso ibǝi nungkwɔ dǝnni nhǝm kwɔ ǝrr u gei angǝ, &lt;&lt;Losua yigwoi kwɔ gabtha ganglangǝu yang dǝiu, gong gwoi ko dang woi kwɔ gabtha ganglangǝ i yang i dǝiu. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Nǝ Mungkullum na nan Mungkullum, yang u gabtha lo i nko lǝ. Losua gu a to nǝnǝ a dǝilǝ? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Nilǝu nǝ dǝm nan wa a ɓko i Ba'alzabul yang, ǝnɓǝ yayuu dǝɓa nani la? Lakwɔ nikwɔ, i ǝlǝ ya to kwan ɓǝ. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Kwoi nǝ ǝn nan wa a ɓko i Ɓyang a langǝ i Fuh, yang bǝ lo yigwoi Fuh baipiu dang ɓǝ bǝikun.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />&lt;&lt;Ko langkwoi yuu akun a ɓuan a tǝ dang gwoi ya ttha a to nungkwɔ yiɗi ɓa? Nwasiu u tthǝb yiɓǝi ya ttha ɓǝ yangbǝ u i nung gu.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />&lt;&lt; Yuu akwɔ yangǝu i ɓanglǝu yang dǝnnu bai tthangǝ i ɓang, langkwoi yuu akwɔ gǝm i ɓanglǝu yang dǝna yinyǝb. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Langkwoi ǝn gei ɓǝtthǝ, nung a ɓko ǝndǝi i ya ɓanglǝ ɗuǝn, Fuh a al ba gilǝtǝ nǝ a gei nung a ɓko tthǝ Ɓyang a langǝ i i al tǝu. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Yuu akwɔ nǝ gei ba tthǝ Yui Yuu i al nung a ɓko gu lǝtǝ, yuu akwɔ nǝ gei ba tthe Ɓyang a langǝ i i al bagu lǝtǝu, ko dang wam kwɔ ko dang wam akwɔ da wɔ ɓǝ.<verse eid="MAT 12:32" /></para>
  <para style="s">Kab I Siu</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luka 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />&lt;&lt;Na mab kab matthǝ siu a maɗing, ko a mab kab mko siu langɓǝ mko, yayuu a i kab tthǝn tthǝ siu. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Ɓǝ yathang nagilǝ, baɓǝ bǝ ɓǝkwɔ lǝ ya nung a ɓko ɓa gei nung akun matthǝ? Nungkwɔ yi dang nyi kwɔ nungɓǝ nwa dǝna gei. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Yuu a langǝ i dǝna wulǝ nung a langǝ i kwɔ u dǝ dang wuo ɓǝ, langɓǝ yuu akwɔ ǝn ya mullub dǝna wulǝ nung a ɓko dang nung a ɓko kwɔ u dǝ dang wuo ɓǝ. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Ən gei ɓǝtthǝ yayuu a than nungkwɔ i gei lǝ nung a ɓko lona kwan bǝgǝ Fuh <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />I ba nwamǝ nungkwɔ ma nwong, langkwoi ba mǝ nungkwɔ ma tǝ lua.&gt;&gt;<verse eid="MAT 12:37" /></para>
  <para style="s">Bǝ Yiɗi Nungfǝmlo</para>
  <para style="r">(Markus 8:11, 12; <ref loc="LUK 11:29-32">Luka 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Yang ya Farisiyawa yakun i ya nanatthǝnung gi Musa geiu angǝ,&lt;&lt;Ya nanatthǝnung, dǝɓi yiɗi bǝ ɓyǝa nung fǝmlo yangbǝ ɓi ibǝi ǝn Fuh tumma.&gt;&gt;<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Yeso gwab nwa angǝ, &lt;&lt;Dangwam nung a ɓko dǝna yiɗi nung fǝmlo! Nung fǝmlo kwɔ mǝn to ɓǝtthǝ kwɔ patthǝ akwɔ i tolǝ ya gei ba a tthasi yunana tthǝ ɓǝu. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />yunana to bo tai nungvii tai dang wa gong tthǝng, langɓǝ Kristi yui yuu a to dang fuh tai nungvii tai dang sua. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Ya Neneva a dǝi nǝ bo vii kwan i dang wam kwɔ i lai; bakwɔ i yitthǝ nung a ɓko gi bakwɔ yunana gei ba Fuh tthǝ ɓǝ, lakwɔ yuu akuntthǝ bǝi kwɔ ghaa pǝl yunana. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Vii kwan gi Fuh Yigwoi a Yisi a lasua a dǝi nǝbo a la dang wam kwɔ; bakwɔ u ǝrr tutthǝ wuu lǝ ba yigǝi gi Sulemanu ɓǝ, lakwɔ yuu akwɔ pǝl Sulemanu kwɔ tthǝ bǝikwɔ.<verse eid="MAT 12:42" /></para>
  <para style="s">Bǝ Kwoi Gi Wa A Ɓko</para>
  <para style="r">(<ref loc="LUK 11:24-26">Luka 11:24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />&lt;&lt; Nǝ killǝng ɓyang a ɓko itthǝ yuu, u tǝ bǝikwɔ mung yangǝu ɓǝ bǝ ɗu bǝ nwongǝi nǝ u tǝilǝu. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Yang u gei angǝ, &lt;&lt;Mǝn kwoi mǝn tǝ gwoi kwɔ ǝn yitthǝ ɓǝ.&gt;&gt;Nǝ u kwoi, wu tǝi gwoi ɓǝ lo nǝkwam, u kai itthǝ u dǝ matthǝ. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Yang u kwoi u ee wa yakun nanaira yakwɔ kiggǝi ɓko pǝll abo ɓǝ, yang i tǝtthǝ i ǝǝtthǝ. Yang tthǝ yiɓǝi ɓǝ a nyari a pǝl a nwasiu. Nungkwɔ a tǝi dang wam a ɓko kwɔ ɓǝ.&gt;&gt;<verse eid="MAT 12:45" /></para>
  <para style="s">Naa Gi Yeso I Ya Youngǝu</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Yirrǝ kwɔ Yeso da gei ba lǝ kon, naa gu i ya youngǝu yaɓǝi dǝi gwam, dǝnni yiɗi bǝ geiu ba. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Yuu akun geiu tthǝ angǝ, &lt;&lt; Naa mǝ i ya youngmǝ dǝi gwam, dǝnni yiɗi bǝ gei ba.&gt;&gt;<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Yeso gwabu nwa angǝ&lt;&lt; Yilǝ naam, langkwoi yaɓǝ lǝ ya youngǝma?&gt;&gt; <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Dǝnnu ta natthǝ ya nanung to gu, u gei angǝ, &lt;&lt; Yakwɔ lǝ ya naam i ya youngǝm. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Yuu akwɔ da to nungkwɔ daam ya wayi da yiɗi kwɔ ulǝ youngǝm yaɓǝi yasi i naam.&gt;&gt;<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Bǝ Liba Loya Nungbyǝa</para>
  <para style="r">(<ref loc="MRK 4:1-9">Markus 4:1-9</ref>; <ref loc="LUK 8:4-8">Luka 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Vii lǝ kwɔ Yeso i dang gwoi tǝ ǝǝ nwa nwam. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Gong kon kǝbtha tthangǝu lǝ u tǝ dang kwai u ǝǝtthǝ, yayuu dǝi nwan gwam. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Ərr Yeso gei ba a langǝ i dang bǝ liba u nainatthǝnung, angǝ: &lt;&lt;Ya nung lǝbbi tǝ zuk bǝ bie nung. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Kwɔ dǝnnu wurǝ nungbyǝa gu, yakun al lo nunglǝi, nurug wu kǝm. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Yakun al lo ɓǝmtal, bǝikwɔ sua kpako ɓǝ. Ərr nungbyǝa ɓǝ pi thǝmtthǝ, bakwɔ sua ɓǝ kpakoɓǝ. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Kwoi kwɔ fuh ɗab, fuh tangǝ i, i yuilǝ bakwɔ yǝng nungbyǝa ɓǝ yangǝu ɓǝ. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Yakun al dang kob, kwɔ i ghaa i tthaklǝ nungbyǝa ɓǝ. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Yirrǝ yakun al losua a langǝ i, i pi i dǝ bie thǝm nu, thǝm tai ko bo thǝmkun pǝmna sob nungkwɔ i bie ɓǝ.&gt;&gt; <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Yeso alo angǝ yuu akwɔ tthǝ i sui lǝbǝi yang, ulǝ.&gt;&gt;<verse eid="MAT 13:9" /></para>
  <para style="s">Ningkwɔ I Ghai Bǝ Liba Lǝbko Ɓǝ</para>
  <para style="r">(<ref loc="MRK 4:10-12">Markus 4:10-12</ref>; <ref loc="LUK 8:9">Luka 8:9</ref>,<ref loc="LUK 8:10">10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Ya nanung to gi Yeso wuo suo wu ɓib angǝ, &lt;&lt;Ba ɓǝbǝ dǝmma gei ba lǝ yayuu dang bǝ liba?&gt;&gt;<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Yeso gwabǝi nwa angǝ, &lt;&lt; Fuh yiɓǝ yang bǝɓa ibǝ nungkwɔ dang wuɔ lǝ ba longwamɓǝ, i dǝlǝ ǝn ilǝu. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Yuu akwɔ nung tthǝ nko i liulo u tǝi kpaatthǝ, Yuu akwɔ kpako nkolǝu, i muo nungkwɔ nko lǝ ɓǝ. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Nungkwɔ to dǝm gei ba dang bǝ liba kwɔ.<verse eid="MAT 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 13:14" />Bǝ gei ba a tthasi kwɔ Ishaya gei kwɔ to manung ɓǝng loi lǝ:</para>
  <para style="q1" vid="MAT 13:14">&lt;&lt; &lt;Yayuu kwɔ i lǝnlǝ yang i ibǝiu;</para>
  <para style="q2" vid="MAT 13:14">i ɓyǝa i ɓyǝa i ɓuan i ɓyǝko,<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Bakwɔ dang wai ɗarɗing,</para>
  <para style="q2" vid="MAT 13:15">i ɓuan i lǝ bǝi i ɗuogsuiu,</para>
  <para style="q2" vid="MAT 13:15">Langkwoi i lam nungǝi.</para>
  <para style="q1" vid="MAT 13:15">Nilǝu yang, nungǝi a ɓuan i ɓyǝabǝi ǝn ɓyǝa,</para>
  <para style="q2" vid="MAT 13:15">ɗuogsui a lǝ bǝi ǝnlǝ,</para>
  <para style="q2" vid="MAT 13:15">lonyii a ibǝi ǝn i,</para>
  <para style="q1" vid="MAT 13:15">yang i kwoi i wuo suam, Fuh gei manungɓǝ langkoi mǝn ji tthǝla.&gt;<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />Kwoi bǝ khana lo nungɓǝ bakwɔ dǝi ɓibǝi ɓǝ, langkwoi i ɗuogsui ɓǝ bakwɔ dǝi lǝ bǝi ɓǝ. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Ən gei ɓǝ ba a langǝ i tthǝ ya gei ba a tthasi i ya langǝ i yiɗi bǝ ɓyǝa nungkwɔ ɓa ɓyǝa kwɔ i ɓyǝa lǝu, langkwoi bǝ lǝ nungkwɔ ɓa lǝ kwɔ i lǝlǝu.<verse eid="MAT 13:17" /></para>
  <para style="s">Yeso Gei Ba Lobǝ Liba Lo Nungbyǝa Tthǝ</para>
  <para style="r">(<ref loc="MRK 4:13-20">Markus 4:13-20</ref>; <ref loc="LUK 8:11-15">Luka 8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />&lt;&lt;Lakwɔ ɓalǝ nung kwɔ bǝ liba ya nungbyea dǝna gei ɓǝ. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Yakwɔ nǝ lǝ nwaba lobǝ lo yigwoi gi Fuh nǝ i ibǝilǝu i natha i nungbyǝa kwɔ al lo nunglǝi ɓǝ. Mungkullum wuo wu dko nungkwɔ i lǝ dang nyiu ɓǝ. Nunkwɔ lǝ nungbyǝa kwɔ al lo nunglǝi ɓǝ. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Nungbyǝa kwɔ al lo ɓǝmtal kwɔ nungɓǝ lǝ yakwɔ lǝ ba Fuh dang tthǝ i muo i tthǝla ɓǝ. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Bakwɔ yǝng nungbyǝa ɓǝ yangǝu ɓǝ, suai tulǝu. Nǝ lo ɓuommi ko bǝ nyuabǝi wuo lǝba ba a langǝ i ɓǝ, dang tthǝ yang u o. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Nungbyǝa kwɔ al dang kob kwɔ itha i yuu kwɔ lǝ nwaba a langǝ i; kwoi nung longwam bǝ yiɗi nungtǝi tthaklǝu baɓǝ, to nung malǝu. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Nungbyǝa a kwɔ i bie losua a langǝ i nungɓǝ lǝ yuu akwɔ lǝ nwaba a langǝ i langkwoi u ibǝ nungkwɔ u lǝ ɓǝng ɓǝ. Nungbyǝa ɓǝ ɗuong matthǝ, u dǝ nung yakun thǝmnu, thǝmtai ko bo thǝm kun pǝmna sob nungkwɔ i bie ɓǝ.<verse eid="MAT 13:23" /></para>
  <para style="s">Bǝ Liba Lo Gug A Ɓko</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yeso gei bǝ liba akun tthǝ angǝ: &lt;&lt;Bǝ lo yigwoi Fuh natha i yiɓǝi kwɔ bie nungbie a langǝ i zuk gu ɓǝ. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Nungvii akunlǝ kwɔ yayuu ǝndei dǝna lo nung lo, ya tthǝng ba gu wu wurrǝ nung gug a ɓko dang zug lǝ, u pa nungu. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Kwɔ nungbyǝa ɓǝ pi ǝrr to yang, gug a ɓko ɓa lang ǝrr fuk gwam.<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />Ya thǝb gi yuu zug ɓǝ wu tǝiu angǝ, &lt;Yikku, a bie nungbie a langǝ i zuk mǝ; Gug a ɓǝ kwɔ ǝrr ɓǝlla?&gt;<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />U gwabnwa angǝ, &lt;Ya tthǝng bǝi to nung kwɔ.&gt;</para>
  <para style="p" vid="MAT 13:28">&lt;Ya thǝb gu ɓibbu angǝ, &lt;A gwabǝng tǝɓi lub ɓi alǝ taa?&gt; <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />&lt;To gwoi gi gei angǝ ɓa yitthǝ, &lt;nǝ dǝɓa lub gug ɓǝ, yang ɓa lub gug a ɓko ɓǝ i nungbyǝa lǝ ndei ǝn lub. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Ɓa yitthǝ nungbyǝa ɓǝ ghaa suatha tǝlǝ vii kwɔ i kaitthǝ ɓǝ. Vii lǝ kwɔ mǝn gei ya kainung geigǝ: La nwasiu ɓa kai gug ɓǝ ɓa tthǝb dang ǝulǝ dang ǝu yangbǝ ɓi li lua; yang nwuni ɓa gǝm nungbyǝa a langǝ i ɓǝ ɓa tǝlǝ dang bim.&gt;&gt;&gt;<verse eid="MAT 13:30" /></para>
  <para style="s">Bǝ Liba Lo Nungbyǝa Atuab I Yisti</para>
  <para style="r">(<ref loc="MRK 4:30-32">Markus 4:30-32</ref>; <ref loc="LUK 13:18">Luka 13:18</ref>,<ref loc="LUK 13:19">19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Yeso gei bǝ liba akun tthǝ angǝ:</para>
  <para style="m" vid="MAT 13:31">&lt;&lt;Bǝ lo yigwoi Fuh manungkwɔ ni. Yiɓǝi akun lǝi nungbyǝa musta kwɔ lǝ nungbyǝa a tuab ǝndei dang nungbyǝa kwɔ bie zug gu. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Nungɓǝ lǝ nungbyǝa a tuab ǝndǝi dang nungbyǝa, kwoi nǝ ghaa, yang a ǝlǝ gong kab, yangbǝ nurug wayi wuo dǝna mai kǝm gi lo nko.&gt;&gt;<verse eid="MAT 13:32" /></para>
  <para style="s">Bǝ Liba Lo Yisti</para>
  <para style="r">(Luka 13:20, 21)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Yeso gei bǝ liba akun tthǝ langkwoi angǝ; &lt;&lt;Bǝ lo yigwoi Fuh natha i yisti kwɔ yisi a langlǝ mual kpaatthǝ yang fǝm yi nung.&gt;&gt;<verse eid="MAT 13:33" /></para>
  <para style="s">Bǝ Tonungto I Bǝ Liba Gi Yeso</para>
  <para style="r">(Markus 4:33, 34)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yeso gei nungkwɔ ǝndei lǝ kon tthǝ dang bǝ liba; nung akun yangǝu kwɔ u geitthǝ kwɔ ǝn bǝ liba lǝu ɓǝ. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Yangbǝ ǝǝlǝ ba a langǝ i kwɔ Fuh gei nwa ya gei ba a tthasi ɓǝ angǝ,</para>
  <para style="q1" vid="MAT 13:35">&lt;&lt; Mǝn gei batthǝ i bǝ liba;</para>
  <para style="q2" vid="MAT 13:35">Mǝn gei nungkwɔ tthǝ i ibǝlǝu baipiu vii kwɔ i mab longwam tthǝ ɓǝ.&gt;&gt;<verse eid="MAT 13:35" /></para>
  <para style="s">Yeso Gab Nungǝi Lobǝ Liba Lo Gug A Ɓko</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Kwɔ Yeso pa tthang kon yayuu lǝ tǝ dang gwoi, Ya nanung to gu wu suo wu gei angǝ, &lt;&lt;A gab nungɓi lobǝ liba loya nungbyǝa dang zug.&gt;&gt;<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />&lt;&lt; Yeso gwabnwa angǝ, yiɓǝi kwɔ bie nungbie a langǝ i kwɔ ǝn Yui Yuu; <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Zuk ɓǝ nungɓǝlǝ longwam; nungbyǝa a langǝ i ɓǝ nungɓǝ lǝ yakwɔ a lo yigwoi i Fuh ɓǝ; gug ɓǝ lǝ yayuu na Mungkullum; <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />langkwoi ya tthǝng bǝi kwɔ bie gug a ɓǝ kwɔ nungɓǝ lǝ Mungkullum. Bǝ kai nung nungkwɔ lǝ vii kwɔ longwam a ǝrr tthǝ ɓǝ, ya kai nungɓǝ lǝ nwatummi gi Fuh. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />&lt;&lt; Manung akwɔ i gǝm gug i liǝ i lua kwɔ, a to manung ɓǝ vii kwɔ longwam a ǝrr tthǝ ɓǝ. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Yui Yuu a tum ya nwatummi gu, wui gǝm yakwɔ dǝna to yakun dǝna to nung a ɓko kwɔ langkwoi i yakwɔ ǝndǝi dǝna to nung a ɓko dǝnni ɓanglǝ bǝ lo yigwoi gi Fuh ɓǝ. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />I alilǝtǝ dang lua a ɗing, viilǝ i tasui i tang nai i wurrǝ. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Yang yayuu gi Fuh a ya langǝ i a kai mangǝn fuh a duu bǝ lo yigwoi gi daagi. Ɓalǝ, yuu akwɔ tthǝ i sui lǝbǝi, yang u lǝ!<verse eid="MAT 13:43" /></para>
  <para style="s">Bǝ Liba Lo Nungtǝi Kwɔ I Pyǝa Ɓǝ</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />&lt;&lt; Bǝ lo yigwoi gi Fuh manungkwɔni. Yiɓǝi akun tǝi nuntǝi kwɔ i pya dang zug akun lǝ. U mabnatthǝ u pya, yang dang tthǝla u tǝ tu ɗyǝab nung nko ǝndei tǝu ɗyǝab zug ɓǝ kullo.<verse eid="MAT 13:44" /></para>
  <para style="s">Bǝ Liba Lo Ɓui A Yummi</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />&lt;&lt; Langkwoi, bǝ lo yigwoi gi Fuh manungkwɔni. Yiɓǝi akun dǝna ɗu ɓui a yummi kwɔ matthǝ ɓǝ, <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Kwɔ nǝ u tǝi akwɔ matthǝ kwɔ, u pa tǝu ɗiɛb nungnko ǝndei yang tǝu ɗiɛb lǝ.<verse eid="MAT 13:46" /></para>
  <para style="s">Bǝ Liba Lo Kali</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />&lt;&lt;Langkwoi, bǝ lo yigwoi gi Fuh manungkwɔni. Ya muo tthǝng akun al kali gi dang mung i muo tthǝng kpaatthǝ. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Kwɔ nǝ kali ɓǝ yitthǝ yang, ya muo tthǝng gub ilǝ nwangwam langkwoi yang i ǝsua i mko ttheng ɓǝ: a langǝ i i al dang kulluk, yang a ɓko ɓǝ i al lǝtǝ. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />A totthǝ manungkwɔ ni vii kwɔ longwam a ǝrr tthǝ ɓǝ: ya nwatummi gi Fuh a tǝ ta gǝm ya to mulub a ilǝ dang ya langǝ i lǝ <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />yang u al ya nung a ɓko lǝtǝ dang lua a ɗing, bǝilǝ kwɔ i tasui i tangnǝi i wurrǝ.<verse eid="MAT 13:50" /></para>
  <para style="s">Ba A Langǝ i Afu I Aku</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />&lt;&lt;Yeso ɓib ya nanung to gu angǝ ɓa ibǝ nungkwɔ lǝu?&gt;&gt;</para>
  <para style="p" vid="MAT 13:51">I gwabnwa angǝ&lt;&lt;Əh,&gt;&gt;.<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Yeso gei angǝ, &lt;&lt;Nikwɔ ya nanatthǝnung gi Musa yuu akwɔ mǝrrǝm lǝ ya nanung to kwɔ Fuh wa lo yigwoi ɓǝ mangǝn yuu akwɔ wulǝ nung na ɓungɓui afu i aku dang kǝm dǝ nung ɓǝ.&gt;&gt;<verse eid="MAT 13:52" /></para>
  <para style="s">Ya Ghaiba A Tthasi Kwɔ I Du Ghaali Lǝuɓǝ</para>
  <para style="r">(<ref loc="MRK 6:1-6">Markus 6:1-6</ref>; <ref loc="LUK 4:16-30">Luka 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Kwɔ Yeso al lo bǝ gei bǝ liba kwɔtthǝ, ǝrr u pa bǝilǝ. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Langkwoi u kwoi suo u tǝ losua kwɔ i siu tthǝɓǝ, U baipi bǝ nainatthǝ nung dang kǝm kǝbtha gi, yakwɔ lǝu kwɔ loi fǝm tthǝ bǝ nanatthǝ nunglǝ. &lt;&lt; I ɓib angǝ yiɓǝi kwɔ tǝi bǝ ibǝ nung i ttha bǝ to nung fǝmlo kwɔ ɓǝlla? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />&lt;&lt; Gǝlko u ǝn yui ya pi nung wai? Gǝlko Maryamu ǝn naa gu wai, langkwoi gǝlko youngǝu ǝn Yakubu, Yusufu, Saminu i Yahuda wai? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Gǝlko ya youngǝu yasi bǝi kwo i ɓi wai? Bǝ yiɓǝi kwɔ tǝi nung kwɔ ɓǝlaa?&gt;&gt; <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Langkwoi dang wai ɓanglǝ tthǝu.</para>
  <para style="p" vid="MAT 13:57">Kwoi Yeso gei angǝ, &lt;&lt; Tthǝng losua gu langkwoi yayuu gu nungkwɔ i dǝ angǝ a lǝ ya gei ba a tthasiu.<verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Langkwoi u to nung fǝmlo kpaatthǝ bǝilǝ lǝu bakwɔ i yangǝu i bǝ dǝnyitthǝu.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Bǝ Ɓuiɓua Gi Yohanna Ya wolmung</para>
  <para style="r">(<ref loc="MRK 6:14-29">Markus 6:14-29</ref>; <ref loc="LUK 9:7-9">Luka 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Lona lǝ kulo Hiridus, yigwoi Galili, lǝ nwaba lo Yeso. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />U gei ya thǝl bo tthǝ angǝ, &lt;&lt; Yuu akwɔ ǝn Yohanna ya wollmung, kwɔ lub ɓua, nungkwɔ dǝnnu to nung fǝmlo.&gt;&gt;<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Lakwɔ Hiridus osi muo Yohanna, tthǝbu tǝu lǝ pursǝna. U to nungkwɔ lǝ ba Herodiya, si youngǝu Filibus. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Bakwɔ vikwɔ Yohanna geiu angǝ: &lt;&lt;Makwɔ ma dǝb Herodiya si youngmǝ Filibus ɓǝlǝu.&gt;&gt; <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Hiridus dǝna yiɗi bǝ thǝb Yohanna, kwoi dǝnnu lǝ tthǝ vulli ya Yahudawa, bakwɔ dǝnni lǝi Yohanna angǝ u ǝn ya gei ba a tthasi.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Ttha bǝ si gi Hirudus wuo yui Herodiya a yisi nabǝi dang tthǝ Hiridus lǝ tthǝla ghaatthǝ. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />U gwabu nwa i nung zuu angǝ i du nungkwɔ ǝndǝi u ɗyǝab ɓǝ. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Naa gu geiu nungkwɔ u toɓǝ, u gei angǝ, &lt;&lt; A dǝm lo Yohanna ya wollmung dang kong kyang.&gt;&gt; <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Dang waa yigwoi ɓanglǝ, kwoi bakwɔ u osi u zuu nung tthasi yayol gu, u gei ya soja gu angǝ i duu nungkwɔ u yiɗi ɓǝ <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />i tǝ dang pursǝna tǝi ɓǝr lo Yohanna. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />I wulǝ lo Yohanna dang kong kyang wui dǝlǝ yui ɓǝ, u lǝi tǝu dǝlǝ naa gu. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Ya nanung to gi Yohanna wu lǝi sua tthǝu tǝ suu. Ərr i pa tǝi gei lǝ Yeso tthǝ.<verse eid="MAT 14:12" /></para>
  <para style="s">Yeso Tanglǝ Yayuu Thǝm Sob Ɓua Thǝmkun Iu Nu</para>
  <para style="r">(<ref loc="MRK 6:30-44">Markus 6:30-44</ref>; <ref loc="LUK 9:10-17">Luka 9:10-17</ref>; <ref loc="JHN 6:1-14">Yohanna 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Kwɔ Yeso lǝ nwaba lo Yohanna, u tǝ dang kwai u nyang nwam Galili u tǝ bǝi kwɔ yuu yangǝutthǝ tǝu ǝǝ i nungthǝu. Kon yayuu lǝ nungkwɔ ni yayuu ǝrr gwoi angǝ a lǝ wuo suo. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Kwɔ Yeso pin dang kwai lǝ u ɓyǝa gong kon yayuu kwɔ, u ɓyǝa nung zuii gi u dǝ tthǝla lǝ ya nungzii gi.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Nungluii lǝ, ya nanung to gu wuu suo angǝ, &lt;&lt;Bǝikwɔ ǝn dang gug, bǝi da gub. A nan kon yayuu kwɔ pa, yang bǝ i tǝ gwoi a tuap tǝi ɗyǝap nung tang.&gt;&gt;<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Yeso gwab nwa angǝ, &lt;&lt; Bǝ i pa thǝ. Ɓa ji nungtang i tang ɗǝ!&gt;&gt;<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />I gwab nwa lǝ Yeso angǝ,&lt;&lt; Burodi ni nu ɓuo bǝi kwɔ i tthǝng ni rab,&gt;&gt;<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Yeso gei angǝ,&lt;&lt; Wullǝ wuɓa dǝm,&gt;&gt; <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Langkwoi u gei yayuu ǝsua lo gug. U lǝi burodi kwɔ ni nu kwɔ i tthǝng lǝ u lǝi lo wayi, u dǝ angǝ a u gab dang burodi ɓǝ. Ərr u dǝlǝ ya nanung to gu, ya nanun to gu langɓǝ dǝlǝ yayuu. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Yayuu kwɔ ǝndei i tang i fǝrr. Ya nanung to gi Yeso kǝm suo kaɗuog sob iu rap. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Yakwɔ tang kwɔ yaɓǝi kǝn thǝmsob ɓua thǝmkun iu nu yasi i yathang yangǝu dang ǝiu.<verse eid="MAT 14:21" /></para>
  <para style="s">Yeso Thko Lo Munglǝ</para>
  <para style="r">(<ref loc="MRK 6:45-52">Markus 6:45-52</ref>; <ref loc="JHN 6:15-21">Yohanna 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Dangtthǝ Yeso gei ya nanung to gu tǝ dang kwai i osi i nyang i tǝ gwam a kullo, u kisua yangbǝ u yǝrnwa lǝ kon yayuu. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Tthasua kwɔ u yǝrri nwa, u tǝ lotal i nugtthǝu yangbǝ tǝu pinwa. Kwɔ nungluii to, u bǝilǝ i nung tthǝu <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Lona lǝ kullo Kwai ɓǝ tutha i u ɗing nwangwam, dǝna tǝ lona wa kwai ɓǝ dǝna tǝnglǝ bakwɔ wa da ɓuob lo na a kun ɓǝ.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Nǝ sibǝi Yeso pa suai, dǝnnu thko lo nwam. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Kwɔ ya nanung to gu ɓyǝa Yeso ni i gei angǝ nung kwɔ ǝn wa, tthǝ vulli mui. &lt;&lt; Ən ya ɓyang a ɓko,&gt;&gt; i gei, i ɓuobnwa dang vulli.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Dangtthǝ Yeso gei angǝ: &lt;&lt; Ɓa nyimnyi! Ən ɓang. Bǝɓa lǝtthe vulli thǝ.&gt;&gt;<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />&lt;&lt;Bitrus gei angǝ Dangbang, nǝ ǝn mǝ yang, gwabǝm tthǝ ǝn wuo tthangmǝ, &lt;&lt; A geim ǝn wuo tthangmǝ lo mung.&gt;&gt;<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Yeso gwabnwa angǝ,&lt;&lt; A wuo.&gt;&gt; Ərr Bitrus pin dang kwai lǝ, thko ki nungǝu tthang Yeso. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Kwoi Kwɔ u ɓyǝa wa kwɔ dǝna ɓuob nyimtthǝ kwɔ, u surr vulli, ǝrr mung bai pi bǝ ɓuom lo, &lt;&lt;Dangbang, a nwongǝm!&gt;&gt;<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Dangtthǝ Yeso juan nko muu lǝ. &lt;&lt; Bǝ dǝnyitthǝ ɓǝ tuab ɓuo,&gt;&gt; u gei angǝ, &lt;&lt;Baɓǝ bǝ a surr vullie?&gt;&gt;<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Langkwoi kwɔ i ǝndǝi ɗab dang kwai, wa ɓǝ tǝm. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Ərr yakwɔ dang kwai kwɔ dǝ angǝ a lǝ Yeso, &lt;&lt;Ba a langǝ i mǝn Yui Fuh.&gt;&gt;<verse eid="MAT 14:33" /></para>
  <para style="s">Yeso Dǝ Tthǝla Jenisarata</para>
  <para style="r">(<ref loc="MRK 6:53-56">Markus 6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Kwɔ i nyang, i pin losua Janisarata. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Lankwoi kwɔ yayuu bǝiɓǝ ibǝi ǝn Yeso, i tumbǝi lǝ ya losua kwɔ gɓagǝi ɓǝ. Yayuu wullǝ ya nungzii gi lǝ sua Yeso. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />I ɗyǝab bu angǝ u yitthǝ ya nungzii kǝn natthǝ nwa nunglitthǝ gu, yakwɔ kǝnnatthǝu ǝndei tǝi tthǝla.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Bǝ Nanatthǝnung Ya Bǝba</para>
  <para style="r">(<ref loc="MRK 7:1-13">Markus 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Yang yakun dang ya Farisiyawa i ya nanatthǝnung gi Musa ǝrr Urshalima wui ɓib Yeso angǝ, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />&lt;&lt; Baɓǝ bǝ ya nanung to mǝ to nung to i zuu ya bǝba ɓi wa? I ɗiggǝ nai yangbǝ i tang nungǝu!&gt;&gt;<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Yeso gwabǝinwa angǝ, &lt;&lt;Ən baɓǝ bǝ ɓa to nung to i nung zuu gi Fuh yang dǝɓa to nung to i a bǝ yakku? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Bakwɔ Fuh gei angǝ, &lt; A dǝ angǝ a lǝ daa mǝ i naa mǝ&gt; langkwoi nǝ &lt;yuu akwɔ dal daa gu ko naa gu i thǝu.&gt; <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Kwoi ɓaɓǝ dǝɓa nanatthǝ ɓangǝ nǝ yayuu tthǝ i nung akun kwɔ i nwong lǝ daagi ko naa gi, kwoi gei angǝ, &lt;Nungkwɔ ǝn a bǝ Fuh.&gt; <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Bǝ u dǝ angǝ a lǝ daa gu thǝ. Manungkwɔni dǝɓa labǝ dǝ angǝ a lǝ zuu gi Fuh, yangbǝ ɓa to nung to i bǝ nanatthǝnung ɓǝ. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Ɓǝ ya pǝllǝ! Ishaya gei ba a tthasi gei ǝn ba langǝ in kwɔ gei angǝ!<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />&lt; Fuh gei angǝ yayuu kwɔ dǝna dǝm angǝ a i sual nwa ɓuo,</para>
  <para style="q2" vid="MAT 15:8">kwoi lo nyii tutha i ɓang ɗing.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Dǝnni wabǝm nǝkwam;</para>
  <para style="q2" vid="MAT 15:9">bakwɔ dǝi nanatthǝ nungzuu thayuu mangǝttǝn ǝn zuum!&gt;&gt;&gt;<verse eid="MAT 15:9" /></para>
  <para style="s">Nungkwɔ Dǝnna Wuolǝ Ɓilǝng Lǝ Yuu Tthǝɓǝ</para>
  <para style="r">(<ref loc="MRK 7:14-23">Markus 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Yang Yeso lubǝ kon yayuu ɓǝ kulo wuo lǝ tthangǝu u gei angǝ, &lt;&lt;Ɓalǝ yang bǝ ɓa ibǝi! <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Nuntang kwɔ ɓa tang kwɔ ɓangɓǝ lǝu; kwoi nungkwɔ a i nwa yuu kwɔ nungɓǝ a ɓangǝu lǝ.&gt;&gt;<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Yang ya nanung to Yeso wuo suo wu ɓibu angǝ, &lt;&lt;Bakwɔ a gei kwɔ ɓanglǝ dang wa ya Farisiyawa kwɔ a ibǝing a?&gt;&gt;<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Yeso gwab nwa angǝ, &lt;&lt;Nung kab kwɔ daam lo wayi bie lǝu i lunlub,&gt;&gt; <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Bǝɓa fali gi thǝ! I ǝnya o silǝ ya nungɓuommi; langkwoi nǝ ya nungɓuommi osi lǝ ya nungɓuommi i ǝndǝi i o dang ɓua.&gt;&gt;<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Bitrus gei angǝ, &lt;&lt; A yǝbɓi dang bǝ liba kwɔtthǝ.&gt;&gt;<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Yeso gei angǝ, &lt;&lt;Yirrǝ bǝ ibǝnung ɓǝ pǝll a bǝ sua yakwɔ lǝu. <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />&lt;&lt; Ɓa ibǝi lǝu? Nungtang kwɔ ɓa tang kwɔ a tǝ dang wa ɓǝ langkwoi a i tthǝ ɓǝ lǝu. <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Kwoi nungkwɔ a i nwa yuu kwɔ a i tthǝn dang nyiu, langkwoi nungɓǝkwɔ lǝ nungkwɔ a wɔɓǝ lǝ ɓilǝng tthǝ ɓǝ. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Bakwɔ tthǝn dang nyi yuu nungkwɔ bǝ nhǝm ba a ɓko da wɔtthǝ kwɔ dǝna tǝɓǝ lǝ bǝ thǝbǝi, bǝ ɓa si yuu ko bǝ ɓa ɓǝi yuu, bǝ lo i yisi kwɔ ǝn abo lǝu ɓǝ, nung ii, pǝllǝ bǝ ɓǝrlo bǝi. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />I nungɓǝ kwɔ lǝ nungkwɔ a wɔlǝ ɓilǝng lǝ yuu tthǝ ɓǝ. Kwoi bǝ tangnung i na ɓilǝng wuolǝ ɓilǝng lǝ yuu tthǝu.&gt;&gt;<verse eid="MAT 15:20" /></para>
  <para style="s">Bǝ Dǝnyitthǝ Gi Yisi</para>
  <para style="r">(<ref loc="MRK 7:24-30">Markus 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yeso yitthǝ bǝiɓǝ kullo kwoi suo tǝ losua kwɔ gɓag Taya i Sidon ɓǝ. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Yisi ya Ka'ana a kun gbag bǝiɓǝ wuo suo, dǝna ta sui dǝna gei angǝ, &lt;&lt;Yui Dawuda!&gt;&gt; A tom nyi tǝmmi tthǝ! Yuim a yisi dǝna to zuii na wa a ɓko.&gt;&gt;<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Kwoi Yeso kǝr gei ba lǝu. Ərr ya nanung to gu wu geiu angǝ, &lt;&lt;A nannu u pa, u ǝnwa bǝ ɓarɓi!&gt;&gt;<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Yeso gwabnwa angǝ, &lt;&lt;Fuh tumǝm lǝ ba ya Israila bakwɔ i ǝn ɓangam kwɔ laɓǝ.&gt;&gt;<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Yisi ɓǝ wu bai nwalongǝu sua tthasiu. U gei angǝ,&lt;&lt;Yikku, a nwongǝm!&gt;&gt;<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Yeso gwab nwa angǝ, &lt;&lt; Makwɔ i dǝ nungtang yathang lǝ ɗua ɓǝu.&gt;&gt;<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Yisi ɓǝ gei angǝ,&lt;&lt;Ən ba a langǝ iu yikku, kwoi ko ǝn ɗua dǝna tang kurom kongkwi kwɔ dǝna al na to gwoi gu ɓǝ.&gt;&gt;<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Nungkwɔ Yeso gwab nwa lǝ yisi ɓǝ angǝ, &lt;&lt;Bǝ dǝnyitthǝ mǝ ghaaɗing! Nungkwɔ dǝma yiɗi kwɔ i toa tthǝn to.&gt;&gt; Langkwoi lǝ kullo munthang a yisi ɓǝ tǝi tthǝla.<verse eid="MAT 15:28" /></para>
  <para style="s">Yeso Dǝ Tthǝla Lǝ Yayuu Kpaatthǝ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yeso yitthǝ bǝiɓǝ kullo u tǝ nwa nwam Galili. U ɗab u tǝ lotal tǝu ǝtthǝ. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Gong kon wuo suo, dǝnni wuo lǝ ya kuglǝ, ya nungɓuommi, ya kwɔ zol i nai ɓui, ɓuom sui yayuu kpaatthǝ, wui ji tthasi Yeso; u ji tthǝla. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Kiggǝ yayuu ǝrr ghaatthǝ kwɔ i ɓyǝa ya ɓuom sui gei ba ɓǝ, ya ɓui na tǝi tthǝla, ya kugglǝ thko ya nungɓuommi ɓyǝa bǝi. Ərr i kha Fuh ya Israila kwɔ dǝnni dǝ angǝ a tthǝɓǝ.<verse eid="MAT 15:31" /></para>
  <para style="s">Yeso Tanglǝ Yayuu Thǝm Əngunai</para>
  <para style="r">(<ref loc="MRK 8:1-10">Markus 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Yeso lubǝ ya nanung to gu wuo tthangǝu u gei angǝ, &lt;&lt;Dǝm ɓyǝa nung zuii yayuu kwɔ, bakwɔ i bǝikwɔ i ɓanglǝ bo tai i tang nung h akun lǝu. Ən yiɗi bǝ yǝrrinwa i gwom lǝu, so i ongkwoi nung lǝi.&gt;&gt;<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Ya nanung to gu ɓibu angǝ, &lt;&lt; Ɓi tǝi burodi pǝlǝ kpaatthǝ bǝikwɔ yangbǝ ɓi tanglǝ kon kwɔ dang gug kwa?&gt;&gt;<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Yeso ɓibǝi angǝ, &lt;&lt; Burodi nǝnǝ naɓa?&gt;&gt; I gwab nwa angǝ,</para>
  <para style="p" vid="MAT 15:34">&lt;&lt; Nanaira, i tthǝng kpako.&gt;&gt;<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Nungkwɔ Yeso geilǝ kon yayuu tthǝ angǝ i ǝsua pangsua. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Yang u lǝi burodi nanaira i tthǝng, kwɔ u dǝ angǝ a, u kwǝ u dǝlǝ ya nanung to gu; langkwoi nunkwɔ i dǝlǝ yayuu. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />I ǝndei tang i fǝr. Yang ya nanung to gu kǝm suo kaɗuog nanaira. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Yayuu kwɔ u tangǝ i lǝ kwɔ yayuu thǝm ǝngunai, i than yasi i yathang lǝu. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Yang Yeso yǝrnwa lǝ yayuu ɓǝ pa, u tǝ dang kwai u pa u tǝ losua Magadan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Yayuu Gei Yeso Angǝ U Toi Nungfǝmlo Tthǝ</para>
  <para style="r">(<ref loc="MRK 8:11-13">Markus 8:11-13</ref>; <ref loc="LUK 12:54-56">Luka 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Yakun dang Ya farisiyawa i ya Sadukiyawa wɔ sua Yeso wui nko i bǝ ɓib ba angǝ u toi nung fǝmlo tthǝ yangbǝ i ibǝi Fuh tummu. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Kwoi Yeso gwabbǝi nwa angǝ, &lt;&lt;Nǝ fuh dǝna o, ɓa gei ɓangǝ, &lt;Bǝi atǝm laɗing, tǝi wayi la tthǝni, bakwɔ lo wayi la thǝnni ɓǝ.&gt; <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Langkwoi nung gwoi ɗǝng ɓangǝ, &lt;&lt;Ɗiggǝ wa a tunto, bakwɔ tǝi la thǝnni baithǝl tthǝ.&gt; Ɓa ibǝi bǝ gei nung kwɔ lo wayi, ɓa ibǝ killǝng bǝ thǝm gi longwam lǝu! <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Dangwam a ɓko dǝna yiɗi nung fǝmlo, i dǝɓǝ nung fǝmlou ǝn a bǝ yunana ɓuo.&gt;&gt;</para>
  <para style="p" vid="MAT 16:4">Nungkwɔ Yeso ǝrr pa bǝilǝ.<verse eid="MAT 16:4" /></para>
  <para style="s">Yisti Ya Farisiyawa I Ya Sadukiyawa</para>
  <para style="r">(<ref loc="MRK 8:14-21">Markus 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Kwɔ i nyang nwam, ya nanung to gi Yeso danyitthǝ bǝ lǝi burodi nalǝ. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yeso gei angǝ, &lt;&lt;Ɓa to kiggǝ; ɓa mabtthǝɓǝ nǝɓa ki tthǝ yisti ya Farisiyawa i Sadukiyawa.&gt;&gt;<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />I baipi bǝ gei nungkwɔ ganglangǝ i lǝ, &lt;&lt; U gei nungkwɔ bakwɔ ɓi wuo lǝ burodi nalǝu ɓǝ.&gt;&gt;<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Yeso ibǝ nungkwɔ dǝnni gei ɓǝng, nungkwɔ Yeso ɓibbǝi angǝ, &lt;&lt;Ən baɓǝ bǝ dǝɓa gei ba ɓuaɓǝ bakwɔ burodi yangǝu ɓa? Bǝ dǝnyitthǝ ɓǝ tuab ni ɓuo! <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Yirrǝ ɓa ibǝi lǝu? Ɓa nhǝm burodi nu kwɔ ǝn tang lǝ yayuu thǝmsob ɓua thǝmkun iu nu ɓǝlǝu? Sua kaɗuog nǝnǝ ɓa ee? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Langkwoi burodi nanaira ba yayuu thǝm ngunai, sua kaɗuog nǝnǝ ɓa gǝm? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Ən baɓǝ bǝ ɓa ibǝi kwɔ dǝm gei ɓǝ ba burodi tthǝ lǝu? Ɓa dǝ kiggǝ ɓǝ ba yisti ya Farisiyawa i ya Sadukiyawa!&gt;&gt;<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Yang i ibǝi dǝnnu gei ba yisti kwɔ i tolǝ burodi ɓǝ lǝu dǝnnu gei ba bǝ nanatthǝnung ya Farisiyawa i ya Sadukiyawa.<verse eid="MAT 16:12" /></para>
  <para style="s">Bitrus Ghaiba Lo Yeso</para>
  <para style="r">(<ref loc="MRK 8:18-21">Markus 8:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Kwɔ Yeso wuo losua Kaisariya Filipi, bǝilǝ kwɔ u ɓib ya nanung to gu angǝ, &lt;&lt;Yayuu dǝna gei angǝ ǝn yilǝ Yui Yuu a?&gt;&gt;<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />I gwabnwa angǝ, &lt;&lt; Yakun dǝna gei angǝ Yohanna ya wollmung; ya kun angǝ Iliya; langkwoi yakun angǝ, Irmiya ko yakun angǝ ya gei ba a tthasi.&gt;&gt;<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />U ɓib angǝ,&lt;&lt;Bǝ ɓaɓǝ dǝɓa gei ɓangǝ ɓang ǝn yittǝnna? Dǝɓa gei ɓangǝ ɓang ǝn yittǝna?&gt;&gt;<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Saminu gwab nwa angǝ, &lt;&lt; Mǝn Kristi, Yui Fuh ya nwongǝi.&gt;&gt;<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Yeso gwab nwa angǝ, &lt;&lt; Fuh khana lomǝ, Saminu yui Yunusa! Ba a langǝ i kwɔ ǝn yuu gei tthǝ lǝu, ǝn daam wayi lǝ. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Langkwoi ǝn gei tthǝ, Bitrus: mǝn ɓǝmtal, mǝn mai kǝm pinwam lotal kwɔ, nwa lǝ gwoi longwam ya ɓui ɓua pǝllǝu. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Mǝn da nung ɓko nwa bǝ lo yigwoi Fuh; nungkwɔ a la longwam i lǝnla wayi lǝ, langkwoi nungkwɔ a gwab longwam kwɔ wayi lǝ langɓǝ i gungwab.&gt;&gt;<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Yang Yeso gub ɗuogsui ya nanung to gu angǝ bǝ i gei lǝ yuu akuntthǝ angǝ ilǝ Kristi thǝ.<verse eid="MAT 16:20" /></para>
  <para style="s">Yeso Ghaiba Lo Zuii Gu I Ɓua Gu</para>
  <para style="r">(<ref loc="MRK 8:31">Markus 8:31</ref>; <ref loc="MRK 9:1">9:1</ref>; <ref loc="LUK 9:22-27">Luka 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Bǝilǝ kulo Yeso baipi bǝ gei lǝ ya nanung to gu tthǝ kaitthǝ angǝ, Mǝntǝ Urshalima mǝn lǝtthǝzii nung kpaaɗing na yakku, yikku ya nyǝknung i ya nanatthǝnung gi Musa, angǝ i thǝm bo tai yang mǝn ǝrr i nwongǝi.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Bitrus kwoiu lǝ tǝlǝ gwu kun dǝna laggǝu. &lt;&lt;Angǝ nilǝu, Dangbang! Nungkwɔ ɓuan tǝiu!&gt;&gt;<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Yeso mǝrrǝm gei Bitrus angǝ, &lt;&lt;A kwoi tthasuam, Mungkullum! Mǝn tal lag bo tthǝmlǝ; bakwɔ bǝ nhǝm bamǝ kwɔ tthǝn bǝgǝ Fuh lǝu, kwoi bǝgǝ thayuu.&gt;&gt;<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Yang Yeso gei ya nanung to gu angǝ, &lt;&lt;Nǝ yuu akun dang ɓǝ dǝna yiɗi bǝ muo suam, mala lomǝ, a lǝi kab gangǝ i mǝ, yang u muo suam. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Bakwɔ nǝ yuu akwɔ dǝna yiɗi bǝ kang nwongǝi gu, yang a lǝnla, yuu akwɔ la nwongǝi gu lǝ bam, u tǝntǝi. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Ən ɓǝtǝn yuu a tǝi lǝ nwathang nwongǝi gu longwam, u yitthǝ nwongǝi gu ɓa? Ko ǝnɓǝ yuu a pǝrǝm lǝ nwongǝi guo? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Bakwɔ Kristi Yui Yuu da tǝbǝ wuo dang mali gi daa gu i ya nwatummi gu, yang u dǝ nung busoni lǝ yayuu natha i nungkwɔ i to ǝndei. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Ən gei ɓǝ ba a langǝ i tthǝ, yakun kwɔ dǝi bǝikwɔ ɓuiɓua yangbǝ i ɓyǝa Yeso Yui Yuu dǝna wɔ mangǝn Yigwoi.<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Bǝ Pǝrǝmtthǝ Gi Yeso</para>
  <para style="r">(<ref loc="MRK 9:2-13">Markus 9:2-13</ref>; <ref loc="LUK 9:28-36">Luka 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Tthasua bo nanakun Yeso lǝi Bitrus, Yakubu i Yohanna ya young gi Yakubu, u tǝilǝ lo tal akwɔ tǝyitthǝ ɓǝ i nungtthǝilǝ. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Bǝilǝ u pǝrǝm tthǝu nungǝi. Dang nungǝu kai mangǝn fuh a duu, nunglitthǝ gu kai mangǝn lua. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Bǝilǝ kwɔ ǝrr Musa i Iliya fuk, dǝnni gei ba i Yeso.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Nungkwɔ Bitrus gei ba lǝ Yeso angǝ, &lt;&lt;Dangbang, maɗing kwɔ ɓi bǝi kwɔ ɓǝ. Na gwabǝng yang, mǝn mab tǝbǝ tai bǝi kwɔ akun amǝ, akun a bǝ Musa akun a bǝ Iliya.&gt;&gt;<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Kwɔ yirrǝ dǝnnu gei ba, tǝi kaitthǝ wu khai, ǝrr yol dang tǝi lǝ gei angǝ, &lt;&lt; Yuu akwɔ ǝn Yuim, kwɔ dǝm yiɗi niɓǝ; dǝm lǝ tthǝla gu. Ɓa lǝu!&gt;&gt;<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Kwɔ ya nanung to gu lǝ nungkwɔ, i o i bǝr lǝ bǝr pangsua, tthǝ vulli mui. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Yeso pin sua wu kǝnnatthǝi. U gei angǝ,&lt;&lt; Ɓa ǝrr, Bǝɓa sur vulli thǝ.&gt;&gt; <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Kwɔ i ǝrr i ɓyǝa wayi, i ɓyǝa yuu lǝu Yeso ɓuo i ɓyǝa.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Kwɔ dǝnni pin lo tal lǝ, Yeso gei angǝ, &lt;&lt; Bǝ ɓa geilǝ yuu akun tthǝthǝ nungkwɔ ɓa ɓyǝa kwɔ ɓǝ, nǝ viikwɔ Kristi Yui yuu ǝrr dang ɓua ɗǝ.&gt;&gt;<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Yang Ya nanung to ɓib Yeso angǝ, &lt;&lt;Baɓǝ bǝ ya nanatthǝnung gi Musa gei angǝ ǝn Iliya a wɔ nungsiiǝ?&gt;&gt;<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Yeso gwabnwa angǝ, &lt;&lt;Yangbǝ ɓa ibǝi la langǝ i, Iliya wɔ yangbǝ mabnung dǝ lo zuiu. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Ən gei ɓǝtthǝ, Iliya osi wung, i iu lǝu, i tou i nung kwɔ i yiɗi ɓǝ. Lang ɓǝ Kristi Yui Yuu a lǝ tthǝ zii nailǝ.&gt;&gt; <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Yang ya nanung to ibǝi dǝnnu gei ǝn ba Yohanna ya wollmung.<verse eid="MAT 17:13" /></para>
  <para style="s">Yeso Dǝ Tthǝla Lǝ Yui A Yiɓǝi Kwɔ i Wa A Ɓko Ɓǝ</para>
  <para style="r">(<ref loc="MRK 9:14-29">Markus 9:14-29</ref>; <ref loc="LUK 9:37-43a">Luka 9:37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Kwɔ i kwoi i wuo sua kon yayuu ɓǝ, yibǝi akun wuo sua Yeso, u bai nwa longǝu sua tthasiu, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />u gei angǝ,&lt;&lt;Dangbang, a ɓyǝa nungzuii yuim! U tthǝbbu langkwoi dǝnnu to zuii ɗing, vii ǝndei dǝnnu o dang lua i mung. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Ən wulǝ sua ya nanung to mǝ, i ɓuan i du tthǝla lǝu.&gt;&gt;<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Yeso gwabnwa angǝ,&lt;&lt;Əi dang wam kwɔ dǝ ba a langǝ iu i nung a ɓko,&gt;&gt; Yeso gwabnwa angǝ, &lt;&lt; nǝɓ; mǝn ee i ɓa? Nǝɓǝ mǝn to i ɓa? Ɓa wumlǝ yui ɓǝtthǝ lǝ kanni.&gt;&gt; <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yeso kwa nwa lo wa a ɓko lǝ, u itthǝ munthang lǝ, u tǝi tthǝla bǝilǝ kulo.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Yang ya nanung to gu wu sua Yeso i nungtthǝu i ɓib angǝ, &lt;&lt;Baɓǝ bǝ ɓi ɓuan ɓi iulǝ lǝu?<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Yeso gwab nwa angǝ, &lt;&lt; Bakwɔ bǝ dǝ nyitthǝ ɓǝ ni tuabni ɓǝ. Ən gei ɓǝ ba a langǝ i tthǝ, nǝɓǝ tthǝ i bǝ dǝ nyitthǝ suin mangǝn nungbyǝa musta, Ɓa ɓuan ɓa gei tal kwɔ, <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />&lt;Tǝn bǝi kwɔ a tǝ kullo&gt; yang a tǝntǝn. Nung yangǝu a pǝl ɓǝu.&gt;&gt;<verse eid="MAT 17:21" /></para>
  <para style="s">Yeso Geiba Langkwoi Ba Ɓua Gu</para>
  <para style="r">(<ref loc="MRK 9:30-32">Markus 9:30-32</ref>; <ref loc="LUK 9:43b-45">Luka 9:43b-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Kwɔ i gǝmtha Galili, yeso gei angǝ, &lt;&lt; I ɓanglǝ Kristi Yui Yuu na yayuu. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />I thǝu, bo tai yang u ǝrr i nwongǝi.&gt;&gt; Ərr vulli muo ya nanung to gu.<verse eid="MAT 17:23" /></para>
  <para style="s">Bǝ Kwai Nungǝmmi Kǝm Nyǝknung</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Tthasua kwɔ Yeso i ya nanung to wuo kafarnahum, ya muo nungǝmmi wuo sua Bitrus wu ɓibbu angǝ, &lt;&lt;Ya naɓǝnatthǝ nung kwai nungǝmmi kǝm Nyǝknung wa?<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Bitrus gwab nwa angǝ, &lt;&lt;Ənh, dǝnnu kwai nungǝmmi.&gt;&gt;</para>
  <para style="p" vid="MAT 17:25">Kwɔ Bitrus wu dang gwoi ɓǝ, Yeso gei ba nungsi angǝ, &lt;&lt; Ɓǝ a nhǝma, Saminu? Ya yigwoi longwam dǝna muo nungǝmmi na yaɓaa- na yathang gi ko tthǝn na ya kunna?&gt;&gt;<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Bitrus gwab nwa angǝ&lt;&lt; Tthang yakun,</para>
  <para style="p" vid="MAT 17:26">&lt;&lt; Yeso gei angǝ maɗing, &lt;&lt;yang ǝǝ mangǝ ya losua ɓǝ kwaiu. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Kwoi yangbǝ bǝɓi ɓanglǝ dang wai thǝ, ɓatǝ nwam tǝɓa li galim. Ɓa muo tthǝng a nwasiu kwɔ ɓa muo kwɔ; ɓa ɓko nwuo ɓa tǝi nungkurɓǝ. Ɓa kwai lǝ nung gǝmmim kǝm nyǝknungǝm i a ɓǝ.&gt;&gt;<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Ən Yilǝ Ya Angã</para>
  <para style="r">(<ref loc="MAT 9:33-37">9:33-37</ref>; <ref loc="LUK 9:46-48">Luka 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Lona lǝ kullo ya nanung to wu sua Yeso, wui ɓib angǝ, &lt;&lt;Ən yillǝ yuu angǝ a dang bǝ lo yigwoi Fuh?&gt;&gt;<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Nungkwɔ Yeso lubǝ munthang wu dǝi nung ganglang gi. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Ərr u gei angǝ, &lt;&lt; Dǝm gei ɓǝ ba a langǝ i tthǝ, nǝ ɓa mǝrrǝm mangǝn munthang atuab lǝu, kwɔ Fuh wa lo yigwoi kwɔ ɓa yangǝu dang yakwɔ Fuh a lo yigwoi i ilǝ ɓǝu. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Niyang yuu kwɔ tǝlǝ lo lǝ sua mangǝn yui kwɔ ulǝ yangǝ a kwɔ Fuh wa lo yigwoi i ulǝ ɓǝ. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />&lt;&lt;Langkwoi yuu akwɔ muo munthang a tuab manung akwɔ dang ɗuǝnnǝm yang u muo ǝn ɓang.<verse eid="MAT 18:5" /></para>
  <para style="s">Bǝ Na Yuu Ato Nung A Ɓko</para>
  <para style="r">(<ref loc="MRK 9:42-48">Markus 9:42-48</ref>; Luka 17:1, 2)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />&lt;&lt;Nǝ yuu akun a to yathang a tuab kwɔ to nung a ɓko yang, pǝllǝu tthǝ i tthǝbu i gong nyi tthǝ dulu yang i wuolǝtǝ dang nwam. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />&lt;&lt;Ɓua lo longwam ba nungkwɔ to yayuu bǝ to nung a ɓko ɓǝ! Ɓua lo yuu akwɔ to i nugɓǝ kwɔ u dang ba!<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />Nǝ namǝ ko bomǝ dǝna walǝ nung a ɓko tthǝ, a ɓǝr a walǝtǝ! Maɗing kwɔ mǝ tǝ wayi lǝ tullu ko lǝ kuglǝ kwɔ ma ǝǝ i na ko i bo yang i walǝtǝ dang lua a ɗing ɓǝ. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Langkwoi nǝ nungmǝ dǝna walǝ nung a ɓko tthǝ, a kko a ilǝ a walǝtǝ. Maɗing kwɔ matǝ wayi i nung kun kwɔ ma ǝǝ i nung rab yang ma tǝ lua a ɗing ɓǝ.<verse eid="MAT 18:9" /></para>
  <para style="s">Bǝ Liba Lo Ɓangam Kwɔ Laɓǝ</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luka 15:3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />&lt;&lt; Bǝɓa tthǝm yuu akun dang yathang a tuab kwɔ thǝ. Dǝmǝn gei ɓǝtthǝ ya nwatummi gi vii ǝndǝi dǝi tǝ tthasi daam wayi lǝ. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Ən gei ɓǝtthǝ ya nwatummi gi Fuh gi vii ǝndei dǝna ɓyǝa dang nung Daam wayi lǝ.<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />&lt;&lt; Ən ɓǝɓa nhǝm nǝ yuu akun tthǝ i ɓangam thǝm nu, yang kun dang ǝi la ɓa? U yitthǝ sua ya thǝm nai oli iu nai lo tal tǝu ɗu yuu akwɔ la ɓǝwa? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Nǝ u tǝi, ǝn gei ɓǝ ba a langǝ i tthǝ, u lǝ tthǝla ba ɓangam kwɔ kun kwɔ lo yakwɔ la lǝu ɓǝ. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Manung ɓǝ Daa ɓǝ wayi yiɗi kwɔ yuu akun dang yathang a tuab kwɔ a la ɓǝlǝu.<verse eid="MAT 18:14" /></para>
  <para style="s">Youngmǝ Yuu Akwɔ To Nung aɓau Tthǝmmǝ Ɓǝ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />&lt;&lt;Nǝ youngmǝ to nung a ɓko tthǝmmǝ, ta geiu nung a ɓko gutthǝ, loɓǝ rab. Nǝ u lǝ, yang a kwoiulǝ a wulǝ nunglǝi a langǝ ing. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Nǝ u la, atǝ i yuu akun ko yayuu rab, yangbǝ &lt;i dǝ ba a langǝ i lo ba yayuu rab ko ǝn tai.&gt; <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Nǝ u la bǝ lǝ bagi, a geilǝ ya kǝm pinwa tthǝ; nǝ u la bǝ lǝ ya kǝm pinwa, a nkolǝ ya yuu akwɔ i Fuh lǝu ɓǝ ko manung a kwɔ ma tolǝ ya muo nungǝmmi ɓǝ.<verse eid="MAT 18:17" /></para>
  <para style="s">Bǝ Dǝkab Nwa Nung I Bǝ Dǝlǝi Nung</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />&lt;&lt;Langkwoi ǝn gei ɓǝ ba a langǝ i tthǝ, nungkwɔ nǝɓa tthǝb longwan wayi lǝ langɓǝ tthǝntthǝb, langkwoi nungkwɔ nǝɓa bi longwam wayi lǝ binbi.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />&lt;&lt; Langkwoi, ǝn gei ɓǝ tthǝ nǝ yayuu rab a gwab nwa lo nung longwam i ɗyǝab, Daam ya wayi a toi tthǝn to. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Bǝikwɔ yayuu rab ko tai kǝbtha tthǝ dang ɗuǝnnǝm, ɓang bǝilǝ i ilǝ.&gt;&gt;<verse eid="MAT 18:20" /></para>
  <para style="s">Bǝ Liba Lo Ya Thǝb Ya Kiggǝ A Ɓko</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Yang Bitrus wuo sua Yeso wu ɓib ba angǝ, &lt;&lt;Dangbang, bo nǝnǝ mǝn altǝ nung a ɓko gi youngǝm nǝ u tom nung a ɓko tthǝm lǝ ɓa? Bo nanaira?&gt;&gt;<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yeso gwabnwa angǝ, &lt;&lt; ǝn gei ɓǝtthǝ, bo nanaira lǝu, thǝm tai pǝmna sob bo nanira,<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />&lt;&lt;bakwɔ bǝ lo yigwoi Fuh manungkwɔni. Yigwoi akuntthǝ dǝna yiɗi bǝ ɓyǝa bithal nung to gu i ya thǝb gu. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Kwɔ u baipiu, i wulǝ yuu akwɔ than gu lolǝ talenti dubu sob. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Bakwɔ u ɓuan u kwai lǝu, togwoi gu gei angǝ u i siu i yathang gu i eei i ɗyǝab yangbǝ i kwailǝ than ɓǝ.<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />&lt;&lt;Thǝb gu ɓǝ bai nwalongǝu sua tthasiu. U ɗyǝab angǝ,&lt;A lǝi munyal i ɓanglǝ, langkwoi mǝn kungkwai ǝndǝi!&gt; <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Togwoi gi thǝb ɓǝ ɓyǝa nung zuii gu, u al lǝtǝ angǝ u tǝ abo.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />&lt;&lt;Kwoi kwɔ thǝb ɓǝ igwam, tǝu tǝi youngǝu yuu akwɔ than gu lo dinari thǝm nu. U ɓagǝu u muo. &lt;A kwai than nǝm!,<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />&lt;&lt;Youngǝu thǝb ɓǝ bai nwalongǝu sua ɗyǝab bu angǝ, &lt; A lǝi munyal i ɓanglǝ, yang mǝn kwai than ɓǝ.&gt;<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />&lt;&lt;Kwoi thǝb ɓǝ la. U pa tǝu tǝlǝ yiɓǝi ɓǝ tǝu tthǝbu pursǝna u kwai than ɓǝ ǝndǝi. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Kwɔ sua ya thǝb ɓǝ ɓyǝa nungkwɔ to nung kwɔ, kiggǝi ǝr ghaatthǝ i pa tǝi gei nungkwɔ to nungkwɔ ǝndǝi lǝ togwoi gi tthǝ.<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />&lt;&lt; Yang togwoi ɓǝ lubǝ ya thǝb gu. &lt;Mǝ ya thǝb a ɓko!&gt; Ən al lǝtǝ than mǝ kwɔ ǝndǝing bakwɔ a ɗyǝabǝm ɓǝ. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Kaso a al nyimǝlǝtǝ lo youngmǝ manung akwɔ ǝn al abǝm lǝtǝ lomǝ ɓǝlǝu.&gt; <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Dangwa yigwoi ɓanglǝ, langkwoi u tǝlǝ thǝb ɓǝlǝ pursǝna yangbǝ i ɗabluo nǝ u kwai than kwɔ lo ǝndei ɗǝ.<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Langkwoi Yeso alo angǝ,&lt;&lt; Manungkwɔ ni Daam ya wayi a toɓǝ lǝ nǝɓa al nungkwɔ dang wa ɓǝ thǝ yayoung ɓǝɗǝ&gt;&gt;.<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Yeso Nanatthǝnung Lobǝ Yinatthǝ Yisi</para>
  <para style="r">(<ref loc="MRK 10:1-12">Markus 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Kwɔ Yeso al lo bǝ gei nungkwɔ, u yitthǝ Galili u tǝ losua Yahudiya gwam Urdun a kulo. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Gong kon muo suo, u ji tthǝla bǝilǝ.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Ya Farisiyawa wɔ suo. I ɓibu angǝ, &lt;&lt;Maɗing kwɔ yiɓǝi a yina lǝ siu lǝ ba nung a kunna?&gt;&gt;<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Yeso gwabnwa angǝ,&lt;&lt;Ɓa than nungkwɔ i vullǝ dang nungvullǝ kwɔ gei angǝ la nwasiu ya mabnung mab yayuu yiɓǝi i yisi? <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Langkwoi Fuh gei angǝ, &lt;Lǝ u baɓǝ kwɔ yiɓǝi a yitthǝ daa gu i naa gu a kǝbtha i siu, i kwɔ rab kwɔ i ee mangǝ nyam kun.&gt;? <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Manungkwɔ ni yang i lakwɔ i rab lǝu, kwoi kun. Thayuu gabǝi lǝthko, yang nungkwɔ Fuh kǝblǝtha ɓǝ.&gt;&gt;<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Ya Farisiyawa ɓǝ ɓibu, &lt;&lt;Ən baɓǝ, yang, Musa gei angǝ yiɓǝi a dǝ nung vullǝ lǝ siu yang yiu naa?&gt;&gt;<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Yeso gwabnwa angǝ, &lt;&lt;Musa gwab angǝ ɓa yina lǝ yasi ɓǝ bakwɔ lo nyi ɓǝ ɗarɗing. La nwasiu nilǝu. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Yeso gei angǝ ǝn gei ɓǝtthǝ yuu akwɔ yina lǝ siu, yang lǝ ǝnba nungkwɔ mko ɓǝ, yang u dǝb yisi akun dǝnnu to nung a ɓko i u lǝ.&gt;&gt;<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Ya nanung to gu geiu angǝ, &lt;&lt;Nǝ nungkwɔ ni ganglang yiɓǝi i yisi, yang maɗing bǝ yuu dǝb yisi thǝ.&gt;&gt;<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Yeso gwabnwa angǝ, &lt;&lt;Bǝ nanatthǝnung kwɔ yuu akun yangǝu a gwab nungkwɔu, yakwɔ i ji nung ɓǝ ɓuo ɓǝ. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Bakwɔ yakun ǝn eunuchs bakwɔ i siiy manungɓǝ; yayuu mab yakun manungɓǝ; ya kun la bǝ dǝb yisi ba wayi. Yuu akwɔ a gwap nungkwɔ ǝn gwab yang u gwab.&gt;&gt;<verse eid="MAT 19:12" /></para>
  <para style="s">Yeso Khanalo Yathang Atuab</para>
  <para style="r">(<ref loc="MRK 10:13-16">Markus 10:13-16</ref>; <ref loc="LUK 18:15-17">Luka 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Yakun wulǝ yathang a tuab lǝ Yeso tthǝ yangbǝ u khana loi u pinwa loi. Ya nanung to gu nan yakwɔ wuilǝ ɓǝ. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Yeso gei angǝ, &lt;&lt;Ɓa yiǝ yathang a tuab wutthangǝm, bǝ ɓa nanni thǝ, bakwɔ bǝ lo yigwoi Fuh ǝn a bǝ yayuu manungkwɔ ni.&gt;&gt; <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Kwɔ u khana loilǝ nungkwɔ u liǝ si.<verse eid="MAT 19:15" /></para>
  <para style="s">Baittha Ya Nungtǝi</para>
  <para style="r">(<ref loc="MRK 10:17-31">Markus 10:17-31</ref>; <ref loc="LUK 18:18-30">Luka 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Lakwɔ yiɓǝi akun wuo sua Yeso wu ɓib angǝ, &lt;&lt;Ya nanatthǝnung, ǝnɓǝtǝn mǝn to la langǝ i yangbǝ ǝn tǝi nwongǝi a ɗing a?&gt;&gt;<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Yeso gwabnwa angǝ,&lt;&lt; Baɓǝ bǝ ɓa ɓibbǝm ɓangǝ nungkwɔ ǝn a langǝ i ɓa? Yuu kun ɓuo lǝ ya langǝ i. Nǝ dǝmma yiɗi bǝ tǝi nwongǝi a ɗing yang, a to nung to nung zuu.&gt;&gt;<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Yiɓǝi ɓǝ ɓib angǝ.&lt;&lt;A nwua?&gt;&gt;</para>
  <para style="p" vid="MAT 19:18">Yeso gwabnwa angǝ, &lt;&lt; &lt;Bǝ a thǝb yuu thǝ, ba ɓa siyuu thǝ, ba i nung thǝ, ba gwab ba pǝlǝ thǝ, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />a dǝ angǝ a lǝ daa mǝ i naa mǝ; langkwoi a yiɗi ya nwakon mǝ mangǝn lomǝ.&gt;&gt;<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Baittha ɓǝ gei angǝ,&lt;&lt;Ən to nung to i zuu kwɔ ǝndǝing, ǝn ɓǝtǝn ǝn to lǝu?&gt;&gt;<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yeso geiu angǝ, &lt;&lt; Nǝ dǝma yiɗi bǝ to a langǝ i yang, a tǝ ta ɗyǝab nungtǝi mǝ a dǝ nungkurɓǝ ɓǝlǝ ya yiɓko, yang ma tǝi nungtǝi wayi; Yang a wɔ, wa muo suam.&gt;&gt;<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Kwɔ baittha kwɔ lǝ nungkwɔ ni, u pa dang wuo ɓanlǝ lǝɓang, bakwɔ nung nko kpaaɗing ɓǝ.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Yeso gei ya nanung to gu angǝ, &lt;&lt;Ən gei ɓǝ ba a langǝ i tthǝ: zii ɗing kwɔ ya nungtǝi a tǝ bǝ lo yigwoi Fuh ɓǝ. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Ən gei ɓǝtthǝ langkwoi, zii lǝ jurobǝ tthǝ ɗing kwɔ a i ɓua batal kwɔ ya nungtǝi a tǝ bǝ lo yigwoi Fuh ɓǝ.&gt;&gt;<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Kwɔ ya nanung to lǝ nungkwɔ ni, kiggǝi ǝrr ghaatthǝ i ɓib angǝ, &lt;&lt;Yang ǝn yitǝn a sob lo?&gt;&gt;<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yeso ɓyǝai ǝrr gei angǝ, &lt;&lt;Nǝ ǝn yuu yang to tthǝu, kwoi nǝ ǝn Fuh yang nung ǝndǝi a to tthǝn to.&gt;&gt;<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Yang Bitrus gei angǝ, &lt;&lt;Ɓi yitthǝ nung ǝndei yangbǝ ɓi muo suamǝ! Ən ɓǝtǝn ɓi tǝi?&gt;&gt;<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Yeso gei angǝ, &lt;&lt;Ən gei ɓǝ ba a langǝ i tthǝ, vii kwɔ i mab natthǝ nung la fuu langkwoi, kwɔ Kristi Yui Yuu a ǝǝ lo nung ǝǝ yigwoi gu a langǝ i, ɓǝ yakwɔ ɓa muo suam ɓa ǝǝ lo nung ǝǝ sob iu rab, ɓa to kwan lǝ ya kab gwoi sob ya Israila. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Langkwoi yuu akwɔ yitthǝ gwoi ko yayoung a yiɓǝi yasi ko daa ko naa ko yathang ko zug lǝ bam a muo thǝm nu kpaatthǝ langkwoi a tǝi nwongǝi a ɗing. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Kwoi yayuu kpaatthǝ kwolǝ nwasiu a ǝǝlǝ a sua, langkwoi ya sua a ǝǝlǝ ya nwasiu.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Bǝ Liba Loya Tonungto Dang Zug</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />&lt;&lt;Bǝ lo yigwoi Fuh wayi natha i yuu zug inabi kwɔ ǝrr nungwoi tǝu ee yayuu yangbǝ tǝ lǝbnung zug gu ɓǝ. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />U gwabǝi nwa angǝ i i kwai dinari viilǝ i pa i tǝ zug gu.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />&lt;&lt;A kǝn lona songsob kwɔ fuh lǝ tthǝlǝu yirrǝ lǝu ɓǝ u i gwam tǝu tǝi yakun nwa lomu i dǝi bǝilǝ nǝkwam. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />U gei angǝ, &lt;Ɓatǝ tǝɓa to nung to zug inabim, yang mǝn kwai ɓǝ matthǝ.&gt; <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Nungkwɔ i pa i tǝ. U igwam langkwoi fuh kǝn nyi lo lona tai u to manung ɓǝ. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />A kǝn lona nu u igwam langkwoi tǝu tǝi yakun dǝi nǝkwam. U ɓibǝi angǝ, &lt;Ɓa bǝ ɓa dǝi bǝikwɔ kǝryǝ nǝkwam?&gt;<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />I gwabnwa angǝ,&lt;Bakwɔ yuu akun yangǝu lǝiɓiu ɓǝ.&gt; U gei angǝ, &lt;Ɓatǝ langɓǝ tǝɓa to nung to dang zugǝm.&gt;<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />Kwɔ nungluii to, yuu zug gei ya ɓyǝa nung to gu angǝ, &lt; A lubǝ ya nung to kwɔ a kwai nungkurɓǝ nung to gi, baipiu i yakwɔ wuo nǝsua ɓǝ.&gt;<verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />&lt;&lt; Yakwɔ wuo lona nu kwɔ wu muo dinari kun. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Nungkwɔ yakwɔ wuo nungsi kwɔ, dǝnni ɓyǝa angǝ lko i tǝi kpaatthǝ. I kwɔ ǝndǝi i ji dinari natha. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Kwɔ yakwɔ wuo la nwasiu muo nungkurɓǝ gi, i baipi bǝ to nyi i yuu zuglǝ angǝ. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />I gei angǝ&lt;Yaɓǝi kwɔ wu nǝsua i to nung to lona kun ɓuo, yang akwai natha i ɓi kwɔ to nung to angǝ a fuh thǝm loɓiɓa!&gt;<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />&lt;&lt;U gei lǝ yuu kun gi tthǝ angǝ, &lt;Ənthǝm, ǝn to nung a ɓko lǝu. A gwab bǝ to nung to lo dinari lǝu? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />A muo nungkurɓǝ mǝ a pa. Dǝm yiɗi bǝ dǝ yiɓǝi kwɔ ǝn wulǝ nǝsua natha i akwɔ ǝn da ɓǝ. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Ən yangǝu i lǝi kwɔ mǝn to nung a langǝ i kwɔ ǝn yiɗi i nungkurɓǝm wa?&gt;&gt;&gt;<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />Langkwoi Yeso alo angǝ,&lt;&lt;A nǝsua a mǝrrǝm lǝ a nungsi, langkwoi a nungsi a ǝlǝ a sua.&gt;&gt;<verse eid="MAT 20:16" /></para>
  <para style="s">Yeso Gei Ba Ɓua Gu A Nungtai Tthǝu</para>
  <para style="r">(<ref loc="MRK 10:32-34">Markus 10:32-34</ref>; <ref loc="LUK 18:31-34">Luka 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Kwɔ Yeso dǝna tǝ Urshalima, u lǝi ya nanung to gu sob iu rab gwu kun u gei angǝ, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />&lt;&lt; Dǝɓi tǝ Urshalima, i ɓanglǝ Yui Yuu i dǝlǝ yakku ya fristoci i ya nanatthǝnung zuu. I ɓangǝulǝ i thǝu <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />yang i dulǝ ya nung yayol i tthǝmmu i ɓuo i piu tthǝ kab gangǝ i. Vii a tai i ǝrru lǝ i nwongǝi.<verse eid="MAT 20:19" /></para>
  <para style="s">Bǝ Yamnung Gi Naa</para>
  <para style="r">(<ref loc="MRK 10:35-45">Markus 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Yang si Zabadi wuo sua Yeso i yathang gu, u bai nwalongǝi sua, u yam Yeso angǝ u nwongǝi. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />U ɓib angǝ,&lt;&lt;Ən ɓǝ dǝmma yiɗi?&gt;&gt;</para>
  <para style="p" vid="MAT 20:21">Yisi ɓǝ gei angǝ, &lt;&lt;A gwab yang dang yathang a ɓǝim kwɔ rab kwɔ yuu akun ee lo namǝ a nali yuu akun lo namǝ a na mai wayi.<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />&lt;&lt;Yeso geiu angǝ a ibǝ nungkwɔ dǝma ɗyǝab ɓǝlǝu,&gt;&gt; Yeso gei yathang ɓǝ angǝ. &lt;&lt;Ɓa ɓuan ɓa nwa mung dang ɗǝi kwɔ mǝn nwa ɓǝng nwa?&gt;&gt;</para>
  <para style="p" vid="MAT 20:22">I gwab angǝ,&lt;&lt; Ɓi ɓumɓuan,&gt;&gt;<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Yeso gei angǝ, &lt;&lt; la langǝ i ɓa ɓuan ɓa tangzuii kwɔ mǝn tangɓǝ, kwoi bǝ ee lo nali ko namai ǝn abǝm mǝn dǝ lǝu. Bǝikwɔ ǝn a bǝ yakwɔ daam mablǝ bagi ɓǝ.&gt;&gt;<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Kwɔ sua ya nanung to kwɔ sob kwɔ lǝ nungkwɔ, dang wai ɓanglǝ lǝ ba yakwɔ rab kwɔ ɓǝ i ǝn ya youngtha. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Nungkwɔ Yeso lubǝi ǝndǝi gǝm nungtha u gei angǝ, &lt;&lt;Ɓa ibǝ yakku ya wabnung wabǝi ji ttha loi, langkwoi gong yakku toilǝ thǝb. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Manung ɓǝ i ɓǝlǝu. Yuu akwɔ dǝna yiɗi bǝ ee lǝ angǝ a dang ɓǝ a ee lǝ thǝb ɓǝ. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Langkwoi yuu akun dang ɓǝ dǝna yiɗi bǝ ǝǝlǝ nwasiu a ǝǝ lǝ thǝb <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Manung akwɔ Kristi Yui Yuu wuo yangbǝ wui du angǝ a lǝu, yangbǝ to nung to, langkwoi dǝ nwongǝi gu nwathan yayuu kpaatthǝ.&gt;&gt;<verse eid="MAT 20:28" /></para>
  <para style="s">Yeso Dǝtthǝla Lǝ Ya Nungɓuommi Rab</para>
  <para style="r">(<ref loc="MRK 10:46-52">Markus 10:46-52</ref>; <ref loc="LUK 18:35-43">Luka 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Kwɔ Yeso i ya nanung to gu yitthǝ Yariko, gong kon muo sua Yeso. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Ya nungɓuommi rab ǝǝ nwalǝi, kwɔ i lǝ angǝ Yeso dǝna pa bǝilǝ, i buogbǝi, &lt;&lt;Dangbang, yui Dawuda, a ɓyǝa nungzuii ɓi.&gt;&gt;<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Kon ǝrri lǝ i gei angǝ ɓa kǝr, i ǝrrlǝ yoli ghaatthǝ, &lt;&lt;Dangbang, Yui Dawuda, a ɓyǝa nungzuii ɓi!&gt;&gt;<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Yeso dǝi ǝrr lubǝi. U ɓibǝi angǝ,&lt;&lt; Ɓǝ dǝɓa yiɗi ɓangǝ ǝn to ɓǝttha?&gt;&gt;<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />I gwabnwa angǝ,&lt;&lt;Dangbang, dǝɓi yiɗi bǝ ɓyǝabǝi langkwoi!&gt;&gt;<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Yeso ɓyǝa nung zuii gi u kǝn natthǝ nungǝi. Dangtthǝ nungǝi ɓko i ɓyǝabǝi i musuo.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Yesu Tǝ Dang Urshalima Mangǝn Yigwoi</para>
  <para style="r">(<ref loc="MRK 11:1-11">Markus 11:1-11</ref>; <ref loc="LUK 19:28-40">Luka 19:28-40</ref>; <ref loc="JHN 12:12-19">Yohanna 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Kwɔ Yeso i ya nanung to gu gbag Urshalima, i kǝn Betafaji lotal Zaitun. Yeso tum ya nanung to gu rab osi <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />i nwatummi kwɔ angǝ,&lt;&lt;Ɓatǝ gwoi a tuab kwɔ siɓǝ kwɔ, ɓa tǝi yui ɗǝrr tthǝb bǝilǝ, i yuiu lǝ gɓagǝu. Ɓa biu ɓa wuilǝ suam. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Nǝ yuu akun gei nung akun yang, ɓa gei tthǝ ɓangǝ Dangbang dǝna yiɗi gi.&gt;&gt;<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Nungkwɔ to nung yangbǝ nungkwɔ ya gei ba a tthasi gei kwɔ ǝǝlǝ ba a langǝ i kwɔ gei angǝ:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />&lt;&lt;A gei ya gwoi angǝ a Sihiyona mangǝ,</para>
  <para style="q2" vid="MAT 21:5">&lt;&lt;Ɓa ɓyǝa, Yigwoi ɓǝ dǝna wɔ sua ɓǝ!</para>
  <para style="q1" vid="MAT 21:5">U ǝn ya ɓuob lo sua langkwoi lo ɗǝrr</para>
  <para style="q2" vid="MAT 21:5">langkwoi lo yui ɗǝrr.&gt;&gt;<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Nungkwɔ ya nanung to gu tǝto manung akwɔ Yeso gei angǝ i toɓǝ: <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />I wulǝ ɗǝr ɓǝ i yui ɗǝrr ɓǝ, i nyan nunglitthǝ gi lo ɗǝrr lǝ, nung kwɔ Yeso ɗab ǝǝtthǝ. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Kon yayuu kpaatthǝ al nunglitthǝ gi lolǝi, yakun ab sina kab nyan lolǝi lǝ. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Kon yayuu a kwɔ osi i yakwɔ muo suko kwɔ dǝna buogbǝi angǝ,&lt;&lt;Hosanna tthǝ Yui gi Dawuda! Fuh Khana lo yuu akwɔ dǝna wɔ dang ɗuǝn Dangbang ɓǝ! Bǝ khabǝi ǝn abǝ Fuh!&gt;&gt;<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Kwɔ Yeso tǝ Urshalima, Gwoi angǝ a ɓǝ ǝrrlǝ kiggǝ. Dǝnni ɓib angǝ,&lt;&lt;Ən yitǝn kwa?&gt;&gt;<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Kon Yayuu ǝrr gwabnwa angǝ,&lt;&lt;Yuu kwɔ ǝn Yeso, ya gei ba tthasi ya Nazarat kwɔ dang Galili ɓǝ.&gt;&gt;<verse eid="MAT 21:11" /></para>
  <para style="s">Yeso Tǝ Dangkǝm Nyǝknung</para>
  <para style="r">(<ref loc="MRK 11:15-19">Markus 11:15-19</ref>; <ref loc="LUK 19:45-48">Luka 19:45-48</ref>; <ref loc="JHN 2:13-22">Yohanna 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Yeso tǝ dang kǝm Nyǝknung tǝ nan ya mǝlnung i ya ɗyǝabnung ǝndei. Yeso mǝrrǝm tǝbur prǝm nungkurɓǝ i nung ǝǝ yakwɔ dǝna mǝl gko gwoi ɓǝ. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Langkwoi u gei angǝ,&lt;&lt;I vullǝ dang nungvullǝ kwɔ Fuh gei angǝ, &lt;Kǝm nyǝknungǝm i lu angǝ kǝm pinwa.&gt; Kwoi ɓa mǝrrǝm bǝiɓǝ le kong ɓua ya nung i!&gt;&gt;<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Ya nungɓuommi i ya kugglǝ wuo suko dang kǝm Nyǝknung, wu ji tthǝla. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Kwoi kwɔ yikuu ya nyǝknung i ya nanatthǝnung gi Musa ɓyǝa nung fǝmlo kwɔ u to kwɔ yathang buogbǝi dang kǝm Nyǝknung angǝ,&lt;&lt;Hosanna lo Yui Dawuda!&gt;&gt; <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Nungkwɔ i ɓib Yeso angǝ, &lt;&lt;Alǝ nungkwɔ yathang kwɔ dǝna gei ɓǝnga?&gt;&gt;</para>
  <para style="p" vid="MAT 21:16">&lt;&lt;Lalangǝ i ǝnlǝng, Ɓa than nungvullǝ bagi Fuh kwɔ lǝu bo kunna? &lt;Ɓa nanatthǝnung lǝ yathang ɓǝ i yathang aɓoi yangbǝ i khabǝi la langǝ i.&gt;&gt;&gt;<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Ərr Yeso patǝ gwoi angǝ a lǝ tǝ Betanya, bǝilǝ kwɔ u lotthǝ.<verse eid="MAT 21:17" /></para>
  <para style="s">Kab Gol Kwi</para>
  <para style="r">(Markus 11:12-14, 20-24)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Nungwoi ɗǝng u olǝi dǝnnu tǝ gwoi angǝ a, gwom tǝiu. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Yeso ɓyǝa kab gol kwɔ dǝi nwalǝi, u tǝ tthang kab ɓǝ tǝu tǝi nung akun lǝu ǝn yang kab ɓuo. Ərr u gei kab ɓǝ angǝ&lt;&lt;A si a kunnu!&gt;&gt;Dangtthǝ kab ɓǝ ɓui. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />Kwɔ ya nanung to ɓyǝa nungkwɔ, ǝrr tthǝ vulli mui. I ɓib angǝ&lt;&lt;Ɓǝnni bǝ kab gol kwɔ ɓui thǝmnii?&gt;&gt; <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Yeso geitthǝ angǝ,&lt;&lt;Ən gei ɓǝ ba langǝ i tthǝ, nǝ ɓǝtthǝ i bǝ dǝ ba a langǝ i ɓa to shaka lǝu, ɓa ɓuan ɓa to nung pǝl nungkwɔ i tolǝ kab gol kwɔ ǝn to. Kwoi langkwoi ɓa ɓuan ɓa gei tal kwɔ,&lt;A pa, ta o nung nwam,&gt; yang a tun to. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Nǝɓa dǝ ba a langǝ i tthǝ, ɓa muo nungkwɔ ɓa ɗyǝab dang bǝ pinwa ɓǝ.&gt;&gt;<verse eid="MAT 21:22" /></para>
  <para style="s">Bǝ Ɓibba Lo Ttha Yeso</para>
  <para style="r">(<ref loc="MRK 11:27-33">Markus 11:27-33</ref>; <ref loc="LUK 20:1-8">Luka 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Yeso kwoi suo tǝ dang kǝm Nyǝknung; langkwoi kwɔ dǝu nanatthǝnung, yikku ya nyǝknung i yakku yayuu wu suo i ɓibu angǝ,&lt;&lt;Dǝma to nungkwɔ i iko ya? Yitǝn da ttha kwɔ dǝma to nungkwɔ?&gt;&gt;<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yeso gwabǝi nwa angǝ,&lt;&lt;Ɓang langɓǝ mǝm ɓib ɓǝ ba kun. Nǝ ɓa gwabǝm tthǝ, yang mǝn geiɓǝ tthǝ i ttha yitǝn dǝm tolǝ nungkwɔ ɓa. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Bǝ wollmung Yohanna wu pǝla? Wuo wayi, ko wu tthǝ yayuu?&gt;&gt;</para>
  <para style="p" vid="MAT 21:25">Ərr i ɓib tha ɓuai lǝ i gei angǝ,&lt;&lt;Nǝɓi gei angǝ,&lt;wayi lǝ,&gt; u ɓib angǝ, &lt;Yang ǝn ba ɓǝ bǝ ɓa dǝ ba a langǝ i tthǝ lǝu?&gt; <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Kwoi nǝ ɓi gei ɓi angǝ, Tthǝn tthǝ yayuu dǝɓi sur yayuu, i ǝndei dǝnni lǝi angǝ Yohanna ǝn ya gei ba a tthasi.&gt;&gt;<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Ərr i gei le Yeso tthǝ angǝ,&lt;&lt;Ɓi ibǝi leu.&gt;&gt;</para>
  <para style="p" vid="MAT 21:27">Ərr u gei angǝ, &lt;&lt;Langɓǝ ǝn gei bǝ ttha yuukwɔ dǝmǝn tolǝ nung to kwɔ ɓǝu.<verse eid="MAT 21:27" /></para>
  <para style="s">Bǝ Liba Lo Yathangɓǝi Rab</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />&lt;&lt;Ɓǝ ɓa nhǝm lakwɔ? Yiɓei akun i yathang gu rab. U tǝ sua yuu a yikku ɓǝ u geiu angǝ,&lt;Yuim, ɗiggǝ ta tom nung to tthǝ dang zug.&gt; <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />&lt;U gei angǝ ǝn ɓuanǝu, kwoi natthǝ u mǝrrǝm dang wko u pa u tǝ.<verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />Yang daa gi ɓǝ patǝ sua yuiu a thang ɓǝ tǝu geiu bakwɔ u gei lǝ yuu a nungsi tthǝ ɓǝ. Ərr u gwabu nwa angǝ, &lt;Mǝn tǝnta, yangkwoi u tǝ lǝu.<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />Dang yathang kwɔ rab kwɔ yi to nungkwɔ daa gi gei angǝ i to ɓa?&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">I gwab nwa lǝ Yeso angǝ&lt;&lt;Yuu a nungsi kwɔ,&gt;&gt;err</para>
  <para style="p" vid="MAT 21:31">Nungkwɔ Yeso gei angǝ,&lt;&lt;Ən gei ɓǝ ba a langǝ i tthǝ, ya muo nungǝmmi i ya tang nǝkwam a oɓǝsi bǝ tǝ bǝ lo yigwoi Fuh. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Yohanna wɔ sua ɓǝ bǝ taɓǝ natthǝ nunglǝi a langǝ i, ɓa dǝ ba a langǝ i tthǝu lǝu, ya muo nungǝmmi i ya tang nǝkwam dǝ ba a langǝ i tthǝu. Langkwoi tthasua kwɔ ɓa ɓyǝa nungkwɔ, ɓa al nung a ɓko ɓǝlǝta ɓa dǝ ba a langǝ i tthǝlǝu.<verse eid="MAT 21:32" /></para>
  <para style="s">Bǝ Liba Loya Ɓyǝa Lǝi Haya Zuk</para>
  <para style="r">(<ref loc="MRK 12:1-12">Markus 12:1-12</ref>; <ref loc="LUK 20:9-19">Luka 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />&lt;&lt;Yeso gei angǝ ɓa lǝ bǝ liba akun kwɔ, Yuu pangsua akun bie zug gu. U mai nung u kwar lǝ, u tha ɓua kam mung inabi i kǝm ɓilo zug ɓǝ. Ərr u dǝlǝ ya nung lǝbbi u pa lǝi yol. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Kwɔ bǝ mabnung innabi ɓǝ gbag, u tum ya thǝb gu sua ya nung to lǝ tǝ muo si kab ɓǝ.<verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />Ya nung to ɓǝ muo ya thǝb gu ɓǝ; i ɓuo yuu akun, i thǝb yuu akun i wa a nungtaiu i tal. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Langkwoi u tum ya thǝb gu ɓǝ akun suai, pǝl ya nungsi, langkwoi ya nung to ɓǝ toi manung akwɔ i tolǝ ya nungsi ɓǝ. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Tthasua ǝndǝi, u tum yuiu suai. U gei angǝ, &lt;I dǝ angǝ a lǝ yuim.&gt;<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />&lt;&lt;Kwoi kwɔ ya nung to ɓǝ ɓyǝa yui yuu zuk ɓǝ, i gei lǝ thatthǝ angǝ, &lt;Yuu kwɔ a prǝm nwa yuu zuk ɓǝ kwɔ. Ɓa wɔ, wuɓi thǝu yang ɓi dǝilo nung gu ɓǝ.&gt; <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Nungkwɔ i lǝiu i wkolǝtǝ mual zug lǝ i thǝu.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />&lt;&lt;Manung akwɔ, kwɔ nǝ yuu zug ɓǝ nǝ wuo, ɓǝ wu tolǝ ya nung to ɓa?&gt;&gt;<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />I gwabnwa angǝ,&lt;&lt; U thǝb ya kiggǝ a ɓko kwɔ, u lǝi zug ɓǝ u dǝlǝ ya nung to akun, kwɔ a duu nung gu vii bǝ ɓǝrnung kwɔ u lǝb ɓǝ.&gt;&gt;<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yeso gei angǝ,&lt;&lt;Ɓa than bokun lǝu dang nungvullǝ gi Fuh?</para>
  <para style="q1" vid="MAT 21:42">Tal kwɔ ya mainung la angǝ mko kwɔ</para>
  <para style="q2" vid="MAT 21:42">nungɓǝ mǝrrǝm lǝ tal a langǝ i ǝndǝi.</para>
  <para style="q1" vid="MAT 21:42">Nungkwɔ ǝn Dangbang to;</para>
  <para style="q2" vid="MAT 21:42">maɗing nung ɓilǝ!&gt;<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />&lt;&lt;Langkwoi nungkwɔ ǝn gei ɓǝtthǝ, Yeso lilo gei angǝ lakwɔ, i lǝi bǝ lo yigwoi gi Fuh naɓǝ i dǝle yayuu kwɔ a si sikab a langǝ i ɓǝ.&gt;&gt;<verse eid="MAT 21:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 21:44" />Yuu akwɔ o lo tal kwɔ yang a ɓuom dang tha, yuu akwɔ tal kwɔ o lo yang u mǝrrǝm lǝ mual.&gt;&gt;<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Kwɔ yakuu ya nyǝknung i ya Farisiyawa lǝ babǝ liba Yeso, i ibǝi dǝnnu gei ǝn ba gi. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Dǝnni ɗubǝ nunglǝi kwɔ i mulǝ ɓǝ, dǝnni sur yayuu kpaatthǝ bakwɔ dǝnni gei angǝ u ǝn ya gei ba a tthasi ɓǝ.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Bǝ Liba Lo Ɓang Dǝb Yisi</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luka 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yeso gei ba langkwoi dang bǝ liba, angǝ. <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />Bǝ lo yigwoi gi Fuh wayi natha i yigwoi kwɔ mab ɓang bǝ dǝb yisi lǝ yuiu tthǝ ɓǝ. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />U tum ya thǝb gu sua yakwɔ u gei angǝ i wuo bǝ dǝb yisiɓǝ ɓǝ, i la bǝ wuou.<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />&lt;&lt; Nungkwɔ u tum ya thǝb gu akun u gei angǝ: &lt;Ɓa gei lǝ yakwɔ tthǝ ǝn gei babǝ dǝb yisi ɓǝ ɓangǝn ǝn yoo nungtang ǝndǝing; Nyagǝm gong nyak i ǝn thǝb nung ǝndǝi tthǝ. Ɓa wɔ pang bǝ dǝb yisi ɓǝ.<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />&lt;&lt;I dǝ kiggǝi tthǝ lǝu i pa nung gi yuu akun tǝ zuk gu, yuu akun tǝ nwa bǝ ɗu nungkurɓǝ gu. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Yakun muo ya thǝb gu, u ji zuii thǝbǝi, <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Dangwa yigwoi ɓanglǝ ghaatthǝ; U tum ya soja tǝ thǝb yakwɔ thǝb ya thǝb gu ɓǝ langkwoi li gwoi angǝ a gi.<verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />&lt;&lt;Yang u gei lǝ ya thǝb gu tthǝ angǝ, &lt;Bǝ dǝb yisi ɓǝ toǝn, yakwɔ ǝn gei bakwɔ i wuo lǝu. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Ɓa tǝ nunglǝi dang ganglang gwoi ɓa gei lǝ yakwɔ ɓa tǝi ǝndǝi i wuo.&gt; <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Nungkwɔ ya thǝb gu ǝrr tǝ lo lǝi tǝi gǝm yakwɔ i tǝi ɓǝ, ya langǝ i i ya ɓko, yayuu yi kǝm ɓang ɓǝ.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />&lt;&lt;Yigwoi tǝ bǝi kwɔ dǝnni to ɓang dǝb yisi ɓǝtthǝ ɓǝ, tǝu tǝi yiɓǝi a kun kwɔ nunglitthǝ dǝb yisi ɓǝ ykogǝu tthǝu ɓǝ. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />U ɓibu angǝ,&lt;Ənthǝm, a to nǝnǝ a wulǝ bǝikwɔ nunglitthǝ yangǝu tthǝma? Yiɓǝi ɓa dǝi ɓuan gei ba lǝu.<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />&lt;&lt;Nungkwɔ Yigwoi ǝrr gei balǝ ya thǝb gu angǝ, &lt;Ɓa tthǝbu nko i bo, ɓa wkolǝtǝ gwam, dang bǝthǝl, bǝikwɔ u tasui u tang lǝiu tthǝ tha ɓǝ.<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />Langkwoi Yeso alo angǝ,&lt;&lt;I ɗubǝ yayuu kpaaɗing, yayuu tuab ɓuo i mko dang ǝi.&gt;&gt;<verse eid="MAT 22:14" /></para>
  <para style="s">Bǝ Kwai Nungǝmi Na Kaisar</para>
  <para style="r">(<ref loc="MRK 12:13-17">Markus 12:13-17</ref>; <ref loc="LUK 20:20-26">Luka 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Ya Farisiyawa i gwam wui mab nunglǝi kwɔ i muo lǝ lǝ Yeso i bǝ ɓib ba. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />I tum ya nanung to gi suatha i yayuu Hiridus. I gei angǝ,&lt;&lt;Ya nanatthǝnung, ɓi ibǝi mǝ ǝn yiɓǝi ya to nung a langǝ i dǝma nanatthǝ ba Fuh sua tha i ba langǝ i, yayuu mǝrrǝm ma nǝkwammu, a dǝ kiggǝ mǝ lo yayuu lǝu. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />A gei ɓitthǝ, ɓǝlǝ bamǝ lo nung zuu ɓi? Maɗing kwɔ ɓi kwai nungǝmmi na Kaisar ɓa?&gt;&gt;<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Yeso, ibǝ nung a ɓko kwɔ dǝnni mab ɓǝng, u gei angǝ,&lt;&lt;Ɓǝya to nung dang bǝthǝl, ba ɓǝ bǝ dǝɓa ɗu nunglǝim? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Ɓa tamnatthǝ nungkurɓǝ kwɔ dǝɓa kwailǝ nungǝmmi ɓǝ.&gt;&gt;Nungkwɔ wui du dinari, <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Nungkwɔ ǝrr u ɓibǝi angǝ, Ɗuǝn yikwa?&gt;&gt;<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />I gwabnwa angǝ, &lt;&lt;Kaisar,&gt;&gt;</para>
  <para style="p" vid="MAT 22:21">Nungkwɔ Yeso gei angǝ,&lt;&lt;Ɓa dǝ Kaisar nungkwɔ ǝn a bǝ Kaisar ɓǝ, langkwoi ɓa dǝlǝ Fuh nungkwɔ ǝn a bǝ Fuh ɓǝ.&gt;&gt;<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Kwɔ i lǝ nungkwɔ ni, ǝrr loi fǝm; nungkwɔ i pa nung gi i yiu.<verse eid="MAT 22:22" /></para>
  <para style="s">Bǝ Ɓibba Lo Vii Ərr Gi Longwam</para>
  <para style="r">(<ref loc="MRK 12:18-27">Markus 12:18-27</ref>; <ref loc="LUK 20:27-40">Luka 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Vii lǝ kwɔ ya Sadukiyawa, yakwɔ gei angǝ yakwɔ ɓui kwɔ ǝrrǝu ɓǝ, i wuo suko i ɓibu ba. <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />I gei angǝ, &lt;&lt;Ya nanatthǝnung, Musa gei ɓi angǝ nǝ yuu ɓui nǝ si yathang lǝu, ya youngǝu a dǝb siɓui ɓǝ yangbǝ siu yui tthǝ. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Lakwɔ ya youngtha tthǝ nanaira dang ɓi. Yuu a nungsi dǝb yisi ǝrr ɓui, bakwɔ u yangǝu i yathangǝu, u yitthǝ yisi ɓǝ lǝ youngǝu. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Nung a yikun ɓǝ to nung tthǝ a nung rab i a nung taiu, muo suai i nanaira ɓǝ ǝndǝi ɓui. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Tthasua ǝndǝi, yisi ɓǝ ɓui. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Lakwɔ, vii kwɔ longwam a ǝrr tthǝ, u ǝn si yitǝn dang ǝi kwɔ loi nanaira kwɔ, kwɔ i ǝndǝi i dǝbuǝn ɓa?&gt;&gt;<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yeso gwabǝi tthǝ angǝ,&lt;&lt;Ɓa lǝnla! Bakwɔ ɓa i nungvullǝ ko ttha Fuh lǝu. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Vii bǝ ǝrr gi longwam yayuu dǝb tthko langkwoi i dǝ yisi bǝ dǝb gwoiu; i mǝrrǝm mangǝn ya nwatummi wayi. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Lakwɔ, Babǝ bǝ ǝrr gi ya ɓui ɓua i nwongǝi: ɓa than nungkwɔ Fuh gei ɓǝtthǝ ɓǝ lǝu? U gei angǝ <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />&lt;Ɓang Fuh kwɔ Ibrahim, Ishaku, Yakubu dǝ angǝ a tthǝ ɓǝ.&gt; U ǝn Fuh ya nwongǝi, Fuh ya ɓuiɓua lǝu.&gt;&gt;<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Kwɔ kon ɓǝ lǝ bakwɔ, loi ǝrr dǝna fǝm tthǝ ba bǝ nanatthǝnung gu.<verse eid="MAT 22:33" /></para>
  <para style="s">Zuu Angã</para>
  <para style="r">(<ref loc="MRK 12:28-34">Markus 12:28-34</ref>; <ref loc="LUK 10:25-28">Luka 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Kwɔ ya Farisiyawa lǝ angǝ Yeso lam nwa ya Sadukiyawa, ǝrr i gǝmtha, <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />langkwoi yuu akun dang ǝi, ya nanatthǝ zuu gi Musa, dǝna yiɗi bǝ mu i bǝ ɓib ba. <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />&lt;&lt;Ya nanatthǝnung, anwɔ lǝ nung zuu angǝ a?&gt;&gt;<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Yeso gwabnwa angǝ, &lt;&lt; &lt;A yiɗi Dangbang Fuh mǝ i dang nyimǝ, i killǝng mǝ i lo nyi mǝ.&gt; <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Nungkwɔ lǝ zuu angǝ a langkwoi lǝ a langǝ i. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Arab lang manungɓǝ: &lt;A yiɗi ya nwakaplua mǝ mangǝn lomǝ.&gt; <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Nung zuu gi Musa kwɔ ǝndǝi i ya gei ba a tthasi ǝndǝi dǝilo nungzuu kwɔ rab kwɔɓǝ.&gt;&gt;<verse eid="MAT 22:40" /></para>
  <para style="s">Bǝ Ɓibba Lo Kristi</para>
  <para style="r">(<ref loc="MRK 12:35-37">Markus 12:35-37</ref>; <ref loc="LUK 20:41-44">Luka 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Kwɔ ya Farisiyawa yakun wu gǝmtha bǝ yikun, Yeso ɓibǝi angǝ, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />&lt;&lt;Ɓǝ dǝɓa nhǝm lǝ ba Kristi? U ǝn ya bie ya?&gt;&gt;</para>
  <para style="p" vid="MAT 22:42">I gei angǝ, &lt;&lt;U ǝn ya bie Dawuda.&gt;&gt;<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Yeso ɓib angǝ,&lt;&lt;Ən baɓǝ, yang, Ɓyang gei ba nwa Dawuda, lubǝiu angǝ&lt;Dangbang&gt;? Dawuda gei angǝ,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />&lt;Kristi kwɔ lǝ Dangbang kwɔ gei lǝ Dangbang ǝm tthǝ angǝ:</para>
  <para style="q2" vid="MAT 22:44">&lt;&lt;A ǝǝ bǝi kwɔ lo nam a nali</para>
  <para style="q2" vid="MAT 22:44">nǝ ǝn wulǝ ya ɓui mǝ lǝ dang simǝ ɗǝ.&gt;&gt;<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Nǝ, yang, Dawuda lubǝiu lǝ &lt;Dangbang,&gt; yang to nǝnǝ Kristi a mǝrrǝm lǝ ya bie Dawuda?&gt;&gt; <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Yuu akun yangǝu ɓuan gwab nwa lǝ Yeso, langkwoi baipiu villǝ kullo yuu akun yangǝu kwɔ ɓibbu ba akunu.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Zuii Nanaira</para>
  <para style="r">(<ref loc="MRK 12:38-39">Markus 12:38-39</ref>; <ref loc="LUK 11:43-46">Luka 11:43-46</ref>; <ref loc="LUK 20:45-46">20:45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Yang Yeso gei lǝ kon i nanung to gu angǝ. <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />&lt;&lt;Ya nanatthǝ zuu i ya Farisiyawa ǝǝ bǝ ǝǝ gi Musa. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Lakwɔ ɓa to nung to i nungkwɔ i gei ɓǝtthǝ ɓǝ. Kwoi bǝ ɓa to nung to i nungkwɔ dǝnni to ɓǝthǝ. Bakwɔ i to nung to i nungkwɔ dǝnni gei ɓǝu. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />I tthǝb nung a ɓuonni i dǝ lodul yayuu, I inai lǝ i yiɗi bǝ lǝi nwanzǝnai i tǝn lǝ nungɓǝ lǝu. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />&lt;&lt;Nung kwɔ dǝnni to kwɔ ǝndǝi dǝnni to yangbǝ yayuu ɓyǝa: I mab laya gi kpaatthǝ tthǝ nunglitthǝ gwon wu nwalongǝi yang bǝ yayuu ibǝi angǝ dǝi yiɗi Fuh gi: <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Dǝnni yiɗi bǝ ǝǝ angǝ a pang bǝ to ɓang i bǝ ǝǝ angǝ a dang kǝm kǝbtha ya Yahudawa; <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Langkwoi kwɔ I dang lomu, dǝnni yiɗi yayuu na gummǝi mangǝ i ǝn gong ya nanatthǝnung langkwoi yayuu na lubǝi angǝ&lt;&lt;Ya nanatthǝnung.&gt;<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />Bǝ i luɓǝ angǝ&lt;Ya nanatthǝnung thǝ,&gt; bakwɔ ɓǝ ǝndǝi ɓa natha langkwoi ya nanatthǝnung kun ɓuo. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Langkwoi bǝ ɓa lubǝ yuu akun longwam kwɔ lǝ &lt;daa thǝ,&gt; bakwɔ ɓǝtthǝ i Daa nikun ɓuo wayi lǝ. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Yuu akun yangǝu dang ɓǝ i lu angǝ&lt;ya tanatthǝ nunglǝiu,&gt; Kristi ɓuo kun lǝ ya tanatthǝ nunglǝi. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Ya angǝ a dang ɓǝ a ǝǝlǝ thǝb ɓǝ. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Yuu akwɔ nǝ lǝi lo yang i tǝulǝ sua, langkwoi yuu akwɔ nǝ tǝlǝ lo lǝ sua yang i mǝrrǝmlǝ yuu angǝ a.<verse eid="MAT 23:12" /></para>
  <para style="s">Yeso La Pǝllǝ Gi</para>
  <para style="r">(<ref loc="MRK 12:40">Markus 12:40</ref>; Luka 11:39-42, 44, 52; <ref loc="LUK 20:47">20:47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />&lt;&lt;Zuii tǝibǝng, ya nanatthǝnung zuu i ya Farisiyawa, ya to nung a ɓko! Ɓa lam nung yayuu gwoi gi Fuh wayi, ɓǝ i naɓǝ ɓa tǝtthǝ lǝu, kwoi ɓa yitthǝ yakwɔ dǝna to nunglǝi tǝu kwɔ tǝtthǝ lǝu.<verse eid="MAT 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14" />Ɓǝ i naɓǝ ɓa tǝtthǝ lǝu, ɓa yitthǝ yakun kwɔ tǝtthǝ lǝu.<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />&lt;&lt;Zuii tǝiɓǝng, ya nanatthǝnung gi Musa i ya Farisiyawa, ya to nung a ɓko! Ɓa thkothko pangsua i lo nwam yangbǝ ɓa tǝi yuu akun kwɔ tubi ɓǝ, langkwoi nǝ ɓa tǝi yuu akun, yang ɓa mǝrrǝmu bo rab ya lua manung aɓǝ.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />&lt;&lt;Zuii tǝiɓǝng, ya osi lǝ bǝi kwɔ ɓibǝiu ɓǝ! Ɓa gei ɓangǝ, &lt;Nǝ yuu zuu nung i kǝm Nyǝknung, ɓa gei ɓangǝ nung yangǝu; nǝ yuu zuu nung i nung a yummi kǝm pinwa, i thǝbbu i nung zuu gu.&gt; <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Ɓǝ ya nungɓuommi ya sullǝ! A nwo lǝ nung angǝ a: nung a yummi, ko kǝm Nyǝknung kwɔ mab nung a yummi lǝ nung a langǝ i? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Langkwoi dǝɓa gei ɓangǝ,&lt;Nǝ yuu akun zuu nung i tuu gi Fuh, yang nung yangǝu bǝilǝu; langkwoi nǝ yuu zuu nung i nungkwɔ i dǝlo lǝ ɓǝ, yang nung zuu thǝbbuǝn.&gt; <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Ɓǝ ya nung ɓuommi! Anwɔ lǝ angã: nungkwɔ i dǝɓǝ, ko tuu ɓǝ mǝrrǝm nung dǝ ba lǝ nung a langǝ i? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Nungkwɔ lakwɔ, yuu akwɔ zuu nung i ɗuǝn tu zuu nung ba nung kwɔ lo tuu ɓǝ lǝ ǝndǝi. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Langkwoi yuu akwɔ zuu nung i kǝm Nyǝknung u zuu i kǝm Nyǝknung lǝ i ɗuǝn Fuh, kwɔ ǝǝ bǝilǝ ɓǝ. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Langkwoi yuu akwɔ zuu nung i wayi yang u zuu nung i bǝ ǝǝ gi Fuh langkwoi i yuu akwɔ ǝǝ bǝilǝ ɓǝ.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />&lt;&lt; Zuii tǝiɓǝng, ya nanatthǝnung zuu i ɓǝ ya Farisiyawa, ɓǝ ya dang wa a ɓko! Dǝɓa illǝ nung kun dang sob i yǝngthǝnni, i anise i lafsur. Yang ɓa labǝ to nung a langǝ i. Nung bǝ ba naa nung a neneng kwɔ, ɓa la bǝ yitthǝ a nungsi. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Ɓǝ ya nanatthǝnung gi Musa ya nung ɓuommi! Dǝɓa sur ɓya nung a tuap yang ɓa ɓuan ɓa mii jurobǝ.<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />&lt;&lt;Zuii tǝiɓǝng, ya nanatthǝ ba nung zuu gi musa i ya Farisiyawa, ɓǝ ya dang wa a ɓko! Ɓa ɗiggǝ dang ɗǝi i taso, yang dang ǝu dǝilǝ nung aɓau. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Ya Farisiyawa ya nung ɓuommi! Nwasiu ɓa baipi bǝ ɗiggǝ dang ɗǝi i taso, yang ttha mualǝu lang ɓǝ a ing i.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />&lt;&lt;Zuii tǝiɓǝng, ya nanatthǝnung zuu gi Musa i ya farisiyawa, i ya to nung a ɓko! Ɓa na tthǝ i nung akwɔ i mabbu matthǝ ɓǝ, kwɔ dǝi ɓiu matthǝ ttha gwam ttha dang yang lǝ kukup thayuu ɓua juǝn i nung akwɔ mko ɓǝ. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Manung akwɔ ni langkwoi, ttha gwam yang dǝɓa lǝi loɓǝ mangǝtǝn ɓǝ ǝn ya langǝ i ttha dang yang ɓǝ ǝn ya to nung a ɓko i dang wa a ɓko.<verse eid="MAT 23:28" /></para>
  <para style="s">Yeso Gei Ba A Tthasi Lobǝ Ɗablua Bǝi Gi</para>
  <para style="r">(<ref loc="LUK 11:47-51">Luka 11:47-51</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />&lt;&lt;Zuii tǝiɓǝng, ya nanatthǝnung zuu gi Musa i ya Farisiyawa, ɓǝ ya dang wa a ɓko! Dǝɓa mai juǝn gi ya gei ba a tthasi yang ɓa mab juǝn gi yato nung a langǝ i gi yayuu. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Langkwoi dǝ ɓa lǝi ɓangǝ,&lt;Nǝ ɓi ǝǝ dang wam ya bǝba ɓi yang, ɓi al zii ya gei ba a tthasi i ilǝu.&gt; <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Lakwɔ dǝ ɓa gei lǝ lo ɓǝ tthǝ ɓangǝ ɓǝ ǝn ya bǝpi gi yakwɔ thǝb ya gei ba a tthasi ɓǝ. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Ɓa ǝǝ nwa bǝ to nung aɓau ya bǝba!<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />&lt;&lt;Ɓǝ i biǝk! Ɓǝ i nagillǝ! Ɓa to nǝnǝ kwɔ ɓa tǝ lua ɓǝu? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Lakwɔ dǝmǝn tum ɓǝ ya gei ba a tthasi i ya yiggǝi i ya nanatthǝnung Musa. Yakun dang ǝi ɓa thǝbǝi yang ɓa pi nai; ɓa ɓuob yakun i thab dang kǝm kǝbtha ya Yahudawa ɓa ɗubǝi ɓa ji zuii gwoi angǝ a tǝllǝ gwoi angǝ a. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Lakwɔ zii ya nung a langǝ i kwɔ i alǝtǝ kwɔ a kwoi dang lo ɓǝ longwam, baipiu lo yuu a langǝ i Habila tǝlla lo zii Zakariya yui Berikiya, kwɔ ɓa thǝu ganglang kǝm Nyǝknung gbag bǝ nyǝknung ɓǝ. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Dǝ mǝn gei ɓǝ ba a langǝ i tthǝ, nungkwɔ ǝndǝi a wɔ lo ya dang wam kwɔ.<verse eid="MAT 23:36" /></para>
  <para style="s">Bǝ Yiɗi Bǝi Gi Yeso Kwɔ Yiɗi Lǝ Urshalima Ɓǝ</para>
  <para style="r">(<ref loc="LUK 13:34-35">Luka 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />&lt;&lt; Urshalima, Urshalima, mǝkwɔ a thǝb yakwɔ dǝna gei ba a tthasi ɓa wa yakwɔ i tum suaɓǝ i tallǝ ɓǝ, bo nǝnnǝ mǝn gǝm yathang mǝ bǝ yikun, manung akwɔ yibǝ dǝna gǝm yathang gu dang kannu ɓǝ, ɓa yiɗi lǝu. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Ɓa ɓyǝa, gwoi ɓǝ yǝbthaang. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Ɓa ɓim a kunnu nǝɓa gei ɓangǝ, &lt;Bǝ khana lo yuu akwɔ wuo dang ɗuǝn Dangbang ɓǝɗǝ.&gt; &gt;&gt;<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Yeso Gei Ba Lobǝ I Dǝr Kǝm Nyǝknung</para>
  <para style="r">(<ref loc="MRK 13:1">Markus 13:1</ref>,<ref loc="MRK 13:2">2</ref>; Luka 21:5, 6)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Yeso yitthǝ kǝm Nyǝknung dǝna pa yang ya nanung to gu wu suo wui geiu ba lǝ ba kǝm ɓǝ. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />U gei angǝ, &lt;&lt;ǝah,&gt;&gt; ɓa ɓyǝa i nungkwɔ ǝndǝi kwɔ. Dǝmǝn gei ɓǝ ba a langǝ i tthǝ, tal akun yangǝu kwɔ i yitthǝ lo akun bǝikwɔu; ǝndei i al lǝntǝ.&gt;&gt;<verse eid="MAT 24:2" /></para>
  <para style="s">Zuii I Bǝ Ɗabluabǝi</para>
  <para style="r">(<ref loc="MRK 13:3-13">Markus 13:3-13</ref>; <ref loc="LUK 21:7-19">Luka 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Kwɔ Yeso ǝǝ lotal Zaitun, ya nanung to gu wuo suo lǝ bǝ pyǝa angǝ&lt;&lt;A gei ɓi tthǝ, nǝɓatǝn i nungkwɔ a to nung, ǝn ɓǝtǝn a taɓi natthǝ bǝ wuo ma i vii kwɔ longwam a ǝrr ɓa?&gt;&gt;<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yeso gwabǝi nwa angǝ, &lt;&lt; Ɓa dǝ kiggǝ ɓǝ, bǝ ɓa gwab yuu akun ɗamɓǝ thǝ. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Yayuu kpaatthǝ a wɔ dang ɗuǝnnǝm, i lǝi angǝ,&lt;Ɓanglǝ Kristi,&gt;langkwoi wui ɗam yayuu kpaatthǝ. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Ɓa lǝ nwaba bǝ taɓui i ba gǝbgǝb i ɓǝlǝ langkwoi tutha i ɓǝlǝ; kwoi bǝ kiggǝ ɓǝ ǝrr thǝ. I nungkwɔ a to tthǝn to, kwoi nungɓǝ lǝ bǝ alo lǝu. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Losua a ɓuob vǝm i tha; langkwoi losua yigwoi a ǝrr tthǝ tha. Gwom a tǝi langkwoi bǝ thǝuri gi pansua a lǝilǝ bǝi ǝndǝi. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />I nungkwɔ ǝndei ǝn bǝ baipi tthǝ zii bǝ si yui.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />&lt;&lt;Yang i muo ɓǝ i dǝɓǝ zuii i thǝb ɓǝ, langkwoi i la ɓǝ longwam ǝndǝi lǝ bam. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Lona lǝ kullo yayuu kpaatthǝ a mǝrrǝm a yitthǝ bǝ dǝnyitthǝ gi; i ɓanglǝ tha i la tha. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Yang ya kǝb pǝllǝ bǝ gei ba a tthasi i wuo wui ɗam yayuu kpaatthǝ. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Bakwɔ nung a ɓko a yǝb a lǝilǝ bǝi bǝ yiɗi bǝi yayuu kpaatthǝ a tǝm. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Kwoi yuu akwɔ ǝndǝi dǝi nyimtthǝ tǝllǝ bǝ alo u sunsob. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Langkwoi nwaba a langǝ i lǝba bǝ lo Yigwoi gi Fuh kwɔ nǝ i gei lǝ yayuu tthǝ lǝ shǝdǝ lǝ yayuu tthǝ; yang nwuni bǝ alo wuo.<verse eid="MAT 24:14" /></para>
  <para style="s">Zuii aɓau</para>
  <para style="r">(<ref loc="MRK 13:14-23">Markus 13:14-23</ref>; <ref loc="LUK 21:20-24">Luka 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />&lt;&lt;Ɓa ɓyǝa, Nung A ɓko&gt;kwɔ ya gei ba a tthasi Daniyel gei ɓǝ. A dǝi bǝi a langǝ i. (Ya nungthani kwɔ: ibǝ nungkwɔ!) <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />&lt;&lt;Yang yakwɔ dang Yahudiya kwɔ sur tǝ tal. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Yuu akwɔ lo kǝm bǝ pin pangsua bǝ lǝi nung akun dang kǝm gu thǝ. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Yuu akwɔ zuk kwɔ bǝ kwoi tǝ gwoi babǝ lǝi nunglitthǝ gu thǝ. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Vii ɓǝ kullo a ɓko nǝnǝ lǝ yakwɔ i wa i yakwɔ si yui nǝfuu ɓǝ! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Ɓa pinwa tthǝ Fuh bǝɓa surdum ɓa pa nǝ wakong ko Vii nwongǝi thǝ! <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Vii lǝ kwɔ i to gong zuii kwɔ ɓko pǝll akwɔ i tolǝu bo kun ɓǝ, baipiu viikwɔ i mab longwam tthǝ wulǝ vii a ɗiggǝ. Langkwoi i to manung ɓǝ akunu. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Kwoi Fuh osi rǝgǝ vii ɓǝng; nǝ krǝ u toni lǝu, yuu akun yangǝu sobbu. Lǝ ba yayuu gu kwɔ u mko ɓǝ, Fuh a rǝgǝ vii ɓǝng.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />Yang, nǝ yuu akun gei ɓǝ angǝ,&lt;A ɓyǝa, Kristi kwɔ!&gt;Ko,&lt;U kulo!&gt;Bǝ ɓa gwab thǝ. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Bakwɔ ya Kristi a pǝllǝ i ya gei ba a tthasi a fug; wui to gong nung fǝmlo i nung ǝrr lǝ kiggǝ yangbǝ i ɗam yayuu i yakwɔ Fuh mko ɓǝ, nǝ a totthǝn to ɓǝ. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Ɓalǝ! Ən osi ǝn gei ɓǝ nungkwɔ tthǝng.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />&lt;&lt;Ko, nǝ yayuu a gei ɓǝ angǝ,&lt;Ɓa ɓyǝa, u kullo dang gug ɓǝ!&gt;Bǝ ɓa tǝ thǝ; ko, nǝ i gei angǝ,&lt;Ɓa ɓyǝa, u kwɔ pyǝa bǝi kwɔ ɓǝ!&gt; Bǝ ɓa dǝba a langǝ i tthǝ thǝ. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Bakwɔ Yui Yuu a wɔ mangǝn lua gabǝi kwɔ dǝna nyang lo wayi lǝ baipiu gwopi wu tǝ lǝdah ɓǝ. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Bǝikwɔ kwamɓui nungtthǝ bǝilǝ, ǝn bǝiɓǝ tha a gǝm thatthǝ.<verse eid="MAT 24:28" /></para>
  <para style="s">Bǝ Wuo Gi Yui Yuu</para>
  <para style="r">(<ref loc="MRK 13:24-27">Markus 13:24-27</ref>; <ref loc="LUK 21:25-28">Luka 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />&lt;&lt;Sua tulǝu tthasua vii zuii kwɔ, fuh a baithǝl, fi dǝ luko; vin wa al, langkwoi ya ttha wayi a thǝuri.&gt; <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Yang killǝng Yui Yuu a fug dang tǝi, viilǝ kwɔ ya longwam ǝndǝi a bai na zuii kwɔ i ɓyǝa bǝ wu gi Kristi Yui Yuu dǝna wɔ lo wayi dang tǝi i ttha i ghaali ghaatthǝ. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />I ɓi gong ɓii, u tum ya nwatummi gu i gǝm yayuu kwɔ u mko ɓǝ lona nai kwɔ ǝndǝi longwam.<verse eid="MAT 24:31" /></para>
  <para style="s">Bǝ Nanung Lo Kab Gol</para>
  <para style="r">(<ref loc="MRK 13:28-31">Markus 13:28-31</ref>; <ref loc="LUK 21:29-33">Luka 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />&lt;&lt; Ɓa nanung tthǝ kab gol. Kwɔ nǝ tthǝlak kab ɓǝ mǝrrǝm ɓǝgɓǝg yang tulǝu yangǝu dǝna i gwam, yang ɓa ibǝi dang ɗuong gbagǝn.<verse eid="MAT 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 24:33" />Manungɓǝ ni, nǝɓa ɓyǝa i nungkwɔ ǝndǝi, ɓa ibǝi lona gbagǝn, dang nwa kǝm ɓǝ. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Dǝm gei ɓǝ ba a langǝ i tthǝ, yayuu kwɔ dang wam kwɔ lko nǝ nungkwɔ nǝ to nung nungǝi lǝɗǝ. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Wayi i pangsua a la, kwoi bam lko.<verse eid="MAT 24:35" /></para>
  <para style="s">Yuu Akun Yangǝu Ibǝ Vii I Lonko</para>
  <para style="r">(<ref loc="MRK 13:32-37">Markus 13:32-37</ref>; <ref loc="LUK 17:26-30">Luka 17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />&lt;&lt;Yuu akun yangǝu ibǝ, vii i lona a wɔ ɓǝlǝu- ko ya nwatummi wayi ko Yui; Daa ɓuo ibǝi i nungtthǝu. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Bǝ wuo gi Yui Yuu ǝǝ manungǝn nungkwɔ to nung dang wam Nuhu ɓǝ. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Vii kwɔ yirrǝ mung ɓuommi wuo lǝu kwɔ yayuu dǝna tang dǝna nwa, yaɓǝi i yasi dǝna dǝbtha, tǝllǝ vii kwɔ Nuhu tǝlǝ dang kwai ɓǝ; <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />yirrǝ i ibǝ nungkwɔ dǝna to nungɓǝ lǝu tǝlle vii kwɔ mung ɓuommi wuo wu pailǝ ǝndǝi. A to manung ɓǝni vii bǝ wuo gi Kristi Yui Yuu. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Lona lǝ kullo Yaɓǝi rab dǝna lǝbnung dang zuk: i lǝi yuu akun i palǝ, i yitthǝ yuu akun. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Yasi rab dǝna nam nung lo nyi: i lǝi yuu akun dang ǝi i palǝ, i yitthǝ yuu akun. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />&lt;&lt;Ɓa dǝ kiggǝ ɓǝ, bakwɔ ɓa ibǝ vii kwɔ Dangbang a wɔ ɓǝlǝu. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Nǝ yuu gwoi ibǝ lona kwɔ ya nung i a wɔ dang gwoi gu, u ǝǝ nǝki u gwab u yitthǝ ya nung i ab gwoi guu. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Manunkwɔ ni yang, ɓǝ langɓǝ ɓa ǝǝ nǝɓa ki, bakwɔ Kristi Yui Yuu a wɔ vii kwɔ ɓa nhǝm lǝu ɓǝ.<verse eid="MAT 24:44" /></para>
  <para style="s">Thǝb Kwɔ To Nung To I Bagi Togwoi Gu Ko Yuu Akwɔ Labǝ To Nung To Ɓǝ</para>
  <para style="r">(<ref loc="LUK 12:41-48">Luka 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />&lt;&lt; Ən yitǝn kwɔ lǝ thǝb ya kiggǝ i yiggǝi ɓǝ? Ən yuu akwɔ togwoi gu du lo ya thǝb dang woi gu u ji nungtang lona a langǝ i ɓǝ? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />A dǝi maɗing tthǝ thǝb kwɔ togwoi gu nǝ kwoi wu tǝiu dǝnnu to nung matthǝ. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Dǝ mǝn gei ɓǝ ba a langǝ i tthǝ, u du lo nung gu ǝndei. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Lko yakun kiggǝ thǝb ɓǝ mko u gei lǝ lo tthǝ angǝ, togwoim ǝǝ gwam sua tutthǝ, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />ǝrr u baipi bǝ ɓuob ya youngǝu ya thǝb dǝnnu tang dǝnnu nwa i ya nwa min. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Togwoi gi thǝb ɓǝ ǝrr a wɔ vii kwɔ u nhǝm lǝu ɓǝ lona kwɔ u ibǝi lǝu ɓǝ. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Togwoi gu a ɓǝrru tuabtuab manung akwɔ i tolǝ ya pǝllǝ, bǝikwɔ u ta sui u tang nko u wurǝ.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Bǝ Liba lo Yathang A Yisi sob</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />&lt;&lt;Lona lǝ kullo bǝ wuo bǝ lo yigwoi Fuh manungkwɔ ni. Yathang a yisi tthǝ sob kwɔ lǝi nung gablua gi yangbǝ tǝi kǝb tha i yamɓǝi kwɔ dǝna tǝbǝ dǝb yisi ɓǝ. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Ya nu dang ǝi ǝn ya sullǝ lang nu dang ǝi ǝn ya yiggǝi. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Ya sullǝ kwɔ dang ǝi kwɔ lǝi nung gablua gii i lǝi nui a kun nallǝ lǝu. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Ya yiggǝi kwɔ dang ǝi kwɔ i lǝi nui dang kulug i nung gablua gi nai. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Yiɓǝi ya dǝb yisiɓǝ wuo thǝm lǝu, nungkwɔ i ǝndǝi dǝnni lǝ nung lo nungkwɔ nung lo lǝi.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />&lt;&lt;I lǝbǝ lubǝi nǝ kasua, angǝ&lt;Yiɓǝi ɓǝ kwɔ! Ɓa ǝrr wuɓi kǝbbu!&gt;<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />Yathang a yisi ɓǝ ǝndǝi ǝrr ɓko nung gablua gi. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Yang ya sullǝ kwɔ ǝrr gei lǝ ya yiggǝi kwɔ tthǝ angǝ,&lt;Ɓa dǝɓi nui ɓǝ tthǝ, lua ɓi dǝna mual.&gt;<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />&lt;Yangǝu,&gt;ya yiggǝi ɓǝ gei tthǝ angǝ,&lt;natthǝɓi i ɓǝlǝu. Manung kwɔ ni yang ɓa tǝ sua ya kwɔ dǝna ɗyǝab nuiɓǝ ɓǝ tǝɓa ɗyǝab nui nai.&gt;<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />Nungkwɔ i ǝrr dǝnni tǝbǝ ɗyǝab nui ɓǝ, yiɓǝi ɓǝ ǝrr wuo. Yathang asi kwɔ wuo i nui gi kwɔ ǝrr i tǝ dang kǝm ɓǝ i yiɓǝi lǝ. Ərr i muo nwa kǝm ɓǝ i lam. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />&lt;&lt; Natthǝ yathang a yisi kwɔ ɓǝ ǝrr wuo angǝ.&lt;Yikku, Yikku! A ɓkoɓi nwa kǝm ɓǝ tthǝ!&gt;<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />Yiɓǝi ɓǝ gwabnwa angǝ, &lt;Yangǝu! Dǝmǝn gei ɓǝ ba a langǝ i tthǝ, Ən i ɓǝ lǝu.&gt;&gt;<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Lakwoi Yeso alo angǝ, &lt;&lt;Ɓa dǝ kiggǝ ɓǝ, yang, bakwɔ ɓa ibǝ vii i dang fuh ko lona lǝu.<verse eid="MAT 25:13" /></para>
  <para style="s">Bǝ Liba Lo Ya Thǝb Tai</para>
  <para style="r">(<ref loc="LUK 19:11-27">Luka 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />&lt;&lt;Viillǝ kullo bǝ lo yigwoi Fuh a wɔ manungkwɔ ni. Yiɓǝi a kuntthǝ dǝna tǝbǝ palǝi yol; u lubǝi ya thǝb gu wu ji nung to lo nungtǝi gu. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />U dǝlǝ ko ǝn ya natha i tthko: yuu akun u du talenti nungkurɓǝ ni nu, yuu akun u du rab, langkwoi sua yuu akun ɓǝ u du kun. Nungkwɔ u pa nunglǝi yol gu. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Yuu akwɔ u du talenti nu kwɔ ǝrr u ɗu nunglǝi i nungkurɓǝ lǝ u tǝi akun ni nu. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Langkwoi, yuu akwɔ i du rab kwɔ u ɗu nunglǝi u tǝi akun rab. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Yuu akwɔ muo talenti kun kwɔ u pa, tǝu thaɓua pangsua lǝ u pyǝa nungkurɓǝ gi togwoi gu ɓǝ tthǝ.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />&lt;&lt;Yiɓǝi ɓǝ ǝǝ suko tutthǝ yol u kwoi wu lubǝ ya thǝb gu u ɓibbǝi ba talenti kwɔ u ji ɓǝ. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Yuu akwɔ muo talenti nu kwɔ wullǝ akun nu angǝ.&lt;Yikku, a dǝm talenti ni nu. A ɓyǝa, ǝn tei akun ni nu lolǝ.&gt;<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />Yikku ɓǝ gei angǝ,&lt;Maɗing, mǝn thǝb a langǝ i!&gt; A to nung a langǝ i lo nung a tuab, Mǝn da lo nung a kpaali. A wuo wa lǝ tthǝla i Yikku mǝ lǝ!<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />Yang thǝb yuu akwɔ i du talenti rab kwɔ ǝrr wuo angǝ.&lt;A dǝm talenti rab, yikku. A ɓyǝa! Ən tǝi a kun rab.&gt;<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />&lt;Ato maɗing, mǝn thǝb a langǝ i! Ato nung a langǝ i lo nung a tuab, Mǝn da lo nung kpaatthǝ. A wuo wa lǝ tthǝla i Yikku mǝ!&gt;<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />Yang thǝb kwɔ muo talenti ni kun kwɔ wuo wu gei angǝ.&lt;Yikku, Ən ibǝing mǝn yuu akwɔ kiggǝ mǝ zii ni ɓǝ; dǝmma ilǝ nung bǝikwɔ a bie nung tthǝ lǝu ɓǝ dǝmma gǝm nung bǝikwɔ a wurrǝ nung tthǝ lǝu ɓǝ. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Dǝmǝn surr vulli nungkwɔ tǝn tha ɓua pangsua ǝn pyǝa talenti mǝ tthǝ. A ɓyǝa, nungmǝ kwɔ.&gt;<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />&lt;&lt; Yikku ɓǝ gei angǝ,&lt;Ya dang wa a ɓko, thǝb a ɓko! A ibǝi dǝmǝn ilǝ nung bǝikwɔ ǝn bie lǝu ɓǝ langkwoi dǝmǝn gǝm nung bǝikwɔ ǝn wurrǝ lǝu ɓa? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Krǝ lko, a alǝm nungkurɓǝm tthǝ dang bǝ pyǝa nungkurɓǝ, lko nǝ ǝn kwoi yang wuo mǝn tǝi nung akun lolǝ. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Lakwɔ togwoi ɓǝ gei angǝ ɓa muo talenti kwɔ nko ɓǝ yang ɓa dǝllǝ yuu akwɔ talenti sob nkolǝ ɓǝ. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Yuu akwɔ nungtthǝ nko yang i liulo, Yuu akwɔ lang nǝ yangǝu nko, nungkwɔ nko kwɔ yang i muo nko lǝ. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />A bǝ thǝb a ɓko kwɔ kullo- ɓa wkolǝtǝ gwam dang bǝthǝl; bǝikwɔ u tasui u tang lǝiu tthǝ tha.&gt;<verse eid="MAT 25:30" /></para>
  <para style="s">Kwan A Nǝsua Əndǝi</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />&lt;&lt;Kwɔ nǝ Kristi Yui Yuu a wɔ mangǝn Yigwoi langkwoi ya nwatummi ǝndǝi i ulǝ, u ǝǝ lo nung ǝǝ gu angǝ a dang gwoi gi Fuh. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Langkwoi yayuu ya losua ǝndǝi longwam ǝndǝi a gǝm tthasiu. Yang u gab dang ǝi rab, manung akwɔ ya gagci nung byang dǝna gab ganglang ɓangam dang gi i ɓa. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />U dǝ i ɓangam lona a nali yang u dǝ ɓa lona a namai. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />&lt;&lt;Yang yigwoi a geilǝ yakwɔ lona a nali kwɔ angǝ,&lt;Ɓa wɔ, yakwɔ Daam wu dǝɓǝ nungkwɔ u mab lǝ baɓǝ la nwasiu kwɔ i mab longwam ɓǝ. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Gwom dǝna tǝim ɓa dǝm nungtang ǝn tang, Ɗimung tǝim ɓa dǝm mungki ǝn nwa, Ən wulǝ yayol ɓa dǝm bǝlo ǝn lotthǝ, <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />pim lonǝkwam dǝmǝn yiɗi nunglithǝ ɓa dǝm nunglithǝ, tthǝm lko wuɓa gumǝm, I tthǝbǝm pursǝna tǝɓa gumǝm.&gt;<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />Yang ya langǝ i a geiu angǝ,&lt;Dangbang, vii a nwuo ɓi ɓyǝa i gwom dǝna tǝi ɓi da nungtang, langkwoi ɗimung dǝna tǝi ɓi da mungki a nwa? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Nǝɓǝ ɓi ɓyǝa lǝ yayol ɓi da bǝlo, langkwoi dǝma yiɗi nunglithǝ ɓi da nunglittha? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Langkwoi nǝɓǝ ɓi ɓyǝa tthǝma lko langkwoi i tthǝba dang pursǝna, wuɓi gumma?&gt;<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />&lt;&lt; Yigwoi a gwabnwa angǝ,&lt;Dǝmǝn gei ɓǝ ba a langǝ i tthǝ, nungkwɔ ɓa to lǝ ya youngǝm a tuab kwɔ tthǝ, ɓa to lǝ ǝn ɓangtthǝ!&gt;<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />Yang u gei lǝ ya kwɔ lo nko a namai kwɔ angǝ,&lt;Ɓa pa tthangǝm, ɓǝ yakwɔ i laɓǝng ɓǝ, ɓatǝ dang lua a ɗing kwɔ i mab ba gi Mungkullum i ya nwatummi gu ɓǝ. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Gwom dǝna tǝim ɓa dǝm nungtang lǝu, ɗimung dǝna tǝm ɓa dǝm mungki ǝn nwa lǝu, <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Ən wulǝ yayol ɓa dǝm bǝlo lǝu, dǝmǝn yiɗi nunglitthǝ ɓa dǝm nunglitthǝ lǝu, tthǝm lko kwoi i tthǝbǝm pursǝna tǝɓa ɓyǝam lǝu.&gt; <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />&lt;&lt;Yang i gwab nwa angǝ,&lt;Dangbang, ɓi ɓyǝa nǝɓǝ i gwom i ɗimung a wulǝ yayol dǝma yiɗi nunglitthǝ tthǝma lko langkwoi i tthǝba, bǝ ɓi nwong a lǝu?&gt;<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />&lt;&lt;Yigwoi ɓǝ a gwab nwa angǝ,&lt;Ən gei ɓǝ ba a langǝ i tthǝ, nǝɓa labǝ nwong ya tuabtuab kwɔ tthǝ lǝu ɓa tom lǝ ǝn ɓangtthǝ lǝu.&gt;<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />&lt;&lt; Yangkwɔ, yang, Fuh a nani i tǝ dang lua a ɗing bǝikwɔ i tangzuii laɗing, yakwɔ to nung a langǝ i kwɔ a ǝǝ i Fuh lona kwɔ wu lo yigwoi gu ɓǝ.&gt;&gt;<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Babǝ Thǝb Yeso</para>
  <para style="r">(Markus 14:1, 2; Luka 22:1, 2; <ref loc="JHN 11:45-53">Yohanna 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />kwɔ Yeso alo ɓǝ nanatthǝnung i nungkwɔ, u gei ya nanung to gu angǝ, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />&lt;&lt;Manung akwɔ ɓa ibǝi kwɔ, bǝ to ɓang nyang lo gwoi suo bo rab, Yang i dǝ Yui Yuu i piu lo kab gangǝ i.&gt;&gt;<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Yang yakku ya nyǝknung kǝbtha gwoi gong Yikku ya nyǝknung angǝ Kayafa ɓǝ, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />langkwoi i mab zui bǝ muo Yeso dang bǝ pyǝa yangbǝ i thǝu. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />I gei angǝ, &lt;&lt;Bǝ ɓito vii ɓang nyang lo gwoi thǝ, so yayuu a ǝrr lǝ kiggǝ.&gt;&gt;<verse eid="MAT 26:5" /></para>
  <para style="s">I Al Nui Lo Yeso Betanya</para>
  <para style="r">(<ref loc="MRK 14:3-9">Markus 14:3-9</ref>; <ref loc="JHN 12:1-8">Yohanna 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Yeso Betanya dang gwoi yiɓǝi akun tthǝ ɗuǝnu ǝn Saminu, ya ǝmbǝlai. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Kwɔ Yeso dǝna tang nungtang, yisi akun tthǝ wuo suko i gǝu nui kwɔ nungkurɓǝu kpaani ɓǝ, u al nui ɓǝkwɔ lolǝ.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Ya nanung to gu ɓyǝa nungkwɔ ni dang wai ɓanglǝ. I ɓib angǝ,&lt;&lt;Baɓǝ bǝ dǝnni ɓanglǝ nung?&gt;&gt;. <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />&lt;&lt;Turare kwɔ kaso i ɗyǝab lo nungkurɓǝ kpaatthǝ yang i dǝ nungkurɓǝ ɓǝlǝ ya yiɓko!&gt;&gt;<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Yeso ibǝ nungkwɔ dǝnni gei kwɔ, nungkwɔ u gei angǝ,&lt;&lt;Ən baɓǝ bǝ dǝɓa ɓar yisi kwa? U tom ǝn nung a langǝ i tthǝ. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Ya yiɓko kwɔ vii ǝndǝi i iɓǝlǝ, kwoi vii ǝndǝi ɓang i ɓǝlǝ lǝu. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Nungwɔ yisi kwɔ to kwɔ lǝ bǝ al turare tthǝm kwɔ, u to yangbǝ u mabtthǝm babǝ suum. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Lakwɔ, ǝn gei ɓǝ ba a langǝ i tthǝ, bǝikwɔ ǝndǝi i gei nwaba ba a langǝ i kwɔ tthǝ longwam, nungkwɔ u tokwɔ i gei lǝ babǝ nhǝmu.&gt;&gt;<verse eid="MAT 26:13" /></para>
  <para style="s">Yahuda Gwabnwa Bǝ Ɗyǝab Yeso</para>
  <para style="r">(Markus 14:10, 11; <ref loc="LUK 22:3-6">Luka 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Yang yuu akun dang ya nanung to gi Yeso kwɔ sob iu rab kwɔ- yuu kwɔ ɗuǝnu angǝ Yahuda Iskariyoti kwɔ- patǝ sua yikku ya nyǝknung <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />u ɓib angǝ, &lt;&lt;Ənɓǝ ɓa dǝm nǝ ǝn dǝɓǝ Yeso ɓa?&gt;&gt;Nungkwɔ i than nungkurɓǝ a yummi ni thǝmkun pǝmna sob i du. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Baipiu viilǝ kwɔ Yahuda dǝna ɗu nunglǝi kwɔ a tai natthǝ Yeso ɓǝ.<verse eid="MAT 26:16" /></para>
  <para style="s">Yeso Tang Nungtang Nyang Lo Gwoi I Ya Nanung To Gu</para>
  <para style="r">(<ref loc="MRK 14:12-21">Markus 14:12-21</ref>; Luka 22:7-13, 21-23; <ref loc="JHN 13:21-30">Yohanna 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Vii a nwasiu bǝ to ɓang Nungtang akwɔ yisti yangǝu tthǝ kwɔ wuo ya nanung to gi Yeso wu ɓibu angǝ,&lt;&lt;Ən pǝtǝn dǝmma yiɗi tǝɓi mabba zuii bǝ tang nungtang nyang lo gwoi ttha?&gt;&gt;<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />U gei angǝ,&lt;&lt;ɓatǝ sua yiɓǝi akun tthǝ gwoi angǝ a, ɓa geiu ɓangǝ: &lt;Ya nanatthǝnung gei angǝ, Lo nam wuong; ya nanungtom i ɓanglǝ wuɓi to ɓang nyang lo gwoi dang gwoi mǝ lǝ.&gt;&gt;&gt;<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />Ya nanung to gi Yeso to manung akwɔ u geitthǝ angǝ i toɓǝ tǝi mab zuii nungtang ɓǝ.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Kwɔ nunglui to, Yeso i ya nkong to gu sob iu rab ǝsua yangbǝ i tang nungtang. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Kwɔ dǝnni tang nungtang ɓǝ Yeso gei angǝ, &lt;&lt;Dǝmǝn gei ɓǝ ba a langǝ i tthǝ, yuu akun dang ɓǝ a tana tthǝm lǝ ya ɓuim.&gt;&gt;<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Dang ya nanung to ɓǝ ɓanglǝ i baipi bǝ ɓibu, nǝkun kun angǝ, &lt;&lt;La langǝ i, Dangbang, dǝmma gei ǝn ɓanglǝu?&gt;&gt;<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Yeso gwabnwa angǝ, &lt;&lt;Yuu kwɔ dǝna bai nko dang ɗǝi i ɓanglǝ kwɔ ǝn uɓǝ u dǝm lǝ ya ɓuim ɓǝ. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Yui Yuu a ɓui manung akwɔ nungvullǝ ba Fuh gei angǝ u ɓuiɓǝ, kwoi a ɓko nǝnǝ lǝ yuu akwɔ tthǝ dǝ Yui Yuu lǝ ya ɓui guɓǝ! Manung akwɔ ni ma lko krǝ i siu lǝu!&gt;&gt;<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Yahuda, yuu akwɔ a du lǝ ya ɓuigu kwɔ, gei angǝ. &lt;&lt;La langǝ i, ya nanatthǝnung dǝmma gei ǝn ɓanglǝu?&gt;&gt;</para>
  <para style="p" vid="MAT 26:25">Yeso gwabnwa angǝ, &lt;&lt;A gei manungɓǝ.&gt;&gt;<verse eid="MAT 26:25" /></para>
  <para style="s">Nungtang A Nunglui Gi Dangbang</para>
  <para style="r">(<ref loc="MRK 14:22-26">Markus 14:22-26</ref>; <ref loc="LUK 22:14-20">Luka 22:14-20</ref>; <ref loc="1CO 11:23-25">Korontiyawa 1 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Kwɔ dǝnni tang nungtang ɓǝ,Yeso lǝi burodi, u pinwa sakko lǝ Fuh, u gab dang ǝu, u dǝlǝ ya nanung to gu. U gei angǝ,&lt;&lt;Ɓa muo ɓa tang, nungkwɔ ǝn nyam tthǝm.&gt;&gt;<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Yang u lǝi ɗǝithang, U to sakko lǝ Fuh, langkwoi u ji. Angǝ,&lt;&lt;Ɓa nwa, ɓǝ ǝndǝi,&gt;&gt; <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />&lt;&lt;Nungkwɔ ǝn ziim, kwɔ ǝn gwab nwa i Fuh ɓǝ, i al lǝba bǝ al nung a ɓko yayuu kpaatthǝ lǝtǝ. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Dǝmǝn gei ɓǝtthǝ, ǝn nwa mung sikab inabi kwɔ akunu tǝllǝ vii kwɔ mǝn nwa afu i ɓǝlǝ bǝ lo yigwoi gi Daam.&gt;&gt;<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Yang i lub ɓin nungkwɔ i tǝ lotal Zaitun.<verse eid="MAT 26:30" /></para>
  <para style="s">Yeso Gei Ba A Tthasi Lobǝ Yǝrwa Gi Bitrus</para>
  <para style="r">(<ref loc="MRK 14:27-31">Markus 14:27-31</ref>; <ref loc="LUK 22:31-34">Luka 22:31-34</ref>; <ref loc="JHN 13:36-38">Yohanna 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Yang Yeso gei angǝ,&lt;&lt;Nungvii kwɔ ɓǝ ǝndǝi ɓa sur ɓapa ɓa yim, bakwɔ nungvullǝ ba Fuh gei angǝ, &lt;Fuh a thǝb ya gagci ɓangam, yang i ɓangam ɓǝ a yǝbtha.&gt; <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />Kwoi tthasua kwɔ nǝ vii kwɔ i ǝrrǝm lǝ tthǝ i nwongǝi, Mǝn oɓǝ si mǝn tǝ Galili.&gt;&gt;<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Bitrus gei angǝ,&lt;&lt;Ən ɓuan ǝn yko, ko nǝ sua yakwɔ ǝndǝi nǝ sur pa ya ɓǝ!&gt;&gt;<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Yeso gei Bitrus angǝ,&lt;&lt;Dǝmǝn gei ba a langǝ i tthǝ nungbǝi akwɔ gog a ta nungvii kwɔ, ma gei bo tai mangǝ a im lǝu.&gt;&gt;<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Bitrus gei angǝ,&lt;&lt;Ən ɓuan ǝn gei niu, ko nǝ krǝ mǝn ɓuilǝ i mǝɓǝ!&gt;&gt;</para>
  <para style="p" vid="MAT 26:35">Langkwoi sua ya nanung to mǝ gei manungɓǝ.<verse eid="MAT 26:35" /></para>
  <para style="s">Yeso Pinwa Dang Getsemani</para>
  <para style="r">(<ref loc="MRK 14:32-42">Markus 14:32-42</ref>; <ref loc="LUK 22:39-46">Luka 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Yang Yeso pa i ya nanung to gu tǝ bǝi akun kwɔ dǝnni lu angǝ Getsemani ɓǝ, langkwoi u gei angǝ, &lt;&lt;Ɓa ǝǝ sua bǝikwɔ dǝisua mǝn ɗab mǝntǝ kullo tǝmǝn pinwa.&gt;&gt; <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />U pa suatha i Bitrus i yathang gi Zabadi rab. Dangwuo ɓanglǝ langkwoi u dang bǝ nhǝm ba ɓuontthǝ, <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />yang u gei angǝ,&lt;&lt;Bǝ nhǝm ba kwɔ lo nyim kwɔ ɓuonɗing kwɔ dǝna yiɗi bǝ thǝm. Ɓa dǝi bǝikwǝ nǝɓa ki i ɓanglǝ.&gt;&gt;<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />U tǝ tthasi tuab, u lo u bǝrlǝ bǝr pangsua lǝ, nungkwɔ u pinwa angǝ, &lt;&lt;Daam, nǝ a totthǝn to yang, a lǝi ɗǝi thang zuii kwɔ lom lǝ! Lakwɔ ǝn nungkwɔ dǝm yiɗi ɓǝlǝu, kwoi ǝn nungkwɔ dǝmma yiɗi ɓǝ.&gt;&gt;<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Yang u kwoi wu tǝi sua ya nanung to kwɔ tai dǝnni lo nung lo; u gei Bitrus angǝ, &lt;&lt;Ən baɓǝ bǝ ɓǝkwɔ tai kwɔ ɓa ɓuan ɓa ǝǝ nǝki i ɓanglǝ ko lona kun wa? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />&lt;&lt;Ɓa ǝǝ nǝɓa ki nǝɓa pinwa yangbǝ bǝɓa o dang bǝ nabǝi thǝ. Ɓyang dǝna yiɗi, kwoi yam tthǝ muanɗing.&gt;&gt;<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Yeso kwoi suo langkwoi tǝ pinwa, &lt;&lt;Daam, nǝ a ɓuan a lǝi ɗǝi thang zuii lom lǝu nǝ ǝn nwa ɗǝ, nungkwɔ dǝmma yiɗi kwɔ to tthǝ.&gt;&gt; <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />U kwoi suo langkwoi wu tǝi ya nanung to ɓǝ dǝna lo nung lo; i ɓuan i ǝǝ nǝki lǝu. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Yeso kwoi suo langkwoi yi ya nkong to ɓǝ, langkwoi u pinwa a nungtai tthǝu, dǝnnu gei ǝn nung akun ɓǝ. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Yang u kwoi suo wu tǝi sua ya nanung to langkwoi u gei angǝ, &lt;&lt;Yirrǝ dǝɓa lo nung lo dǝɓa nwong a? Ɓa ɓyǝa! Lona wɔng kwɔ i dǝ Yui Yuu dang na ya to nung a ɓko ɓǝ. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Ɓa ǝrr, ɓitǝ. Ɓa ɓyǝa, yuu akwɔ a dǝm lǝ ya nung a ɓko kwɔ ǝn u kwɔ dǝnnu wuo ɓǝ!&gt;&gt;<verse eid="MAT 26:46" /></para>
  <para style="s">I Muo Yeso</para>
  <para style="r">(<ref loc="MRK 14:43-50">Markus 14:43-50</ref>; <ref loc="LUK 22:47-53">Luka 22:47-53</ref>; <ref loc="JHN 18:3-12">Yohanna 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Yeso yirrǝ dǝna gei ba kwɔ Yahuda, yuu akun dang ya nanung to kwɔ sob iu rab kwɔ, wuo. I wuo i kon yayuu kpaatthǝ i khafǝi i kab ɗablua bǝi ya soja kwɔ yikku ya nyǝknung i yakku tumǝi ɓǝ. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Ya ɓanglǝ bǝiɓǝ gei angǝ: &lt;&lt;Yuu akwɔ mǝn kummu kwɔ ǝn uɓǝ kwɔ dǝɓa ɗubǝi ɓǝ. Ɓa mu!&gt;&gt;<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />Yahuda nalǝ Yeso gei angǝ, &lt;&lt;Dǝmǝn gumbǝi, Ya nanatthǝnung,&gt;&gt; langkwoi u kummu.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Yeso gwabnwa angǝ, &lt;&lt;Ato thǝm tthǝ, ǝnthǝm!</para>
  <para style="p" vid="MAT 26:50">Yang yaɓǝi ɓǝ tǝn wuo angǝ, i muo Yeso, i mu matthǝ. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Yuu akun dang yakwɔ suatha i Yeso kwɔ ilǝ khafǝi gu, gab lǝ ɗuogsui thǝb Gong yikku ya nyǝknung u ɓǝr.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Yeso gei angǝ, &lt;&lt;A bai khafǝi mǝ dang thko, yakwɔ lub khafǝi ǝn khafǝi a thǝi. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Ɓa ibǝi kwɔ mǝn ɓuan mǝn lubǝi lo Daam babǝ nwongbǝi, langkwoi thǝmtthǝ u tumbǝi i ya nwatummi gu pǝll ɓua sob iu rab lǝu? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Kwoi nǝ manung akwɔ ni, to nǝnǝ nung vullǝ ba Fuh a ǝǝlǝ ba a langǝ i kwɔ angǝ nungkwɔ a to tthǝn to ɓa?&gt;&gt;<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Yang Yeso gei kon ɓǝtthǝ angǝ,&lt;&lt;Ɓa wɔ i khafǝi i kab yangbǝ wuɓa muom la? Vii ǝndǝi dǝmǝn ǝǝ dang kǝm Nyǝknung langkwoi dǝm nanatthǝnung, ɓa muom lǝu. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Kwoi nungkwɔ to nung ǝndǝi yangbǝ nungvullǝ kwɔ ya gei ba a tthasi gei kwɔ ǝǝlǝ ba a langǝ i.&gt;&gt;</para>
  <para style="p" vid="MAT 26:56">Yang ya nanung to gu ǝndǝi sur pa yiu.<verse eid="MAT 26:56" /></para>
  <para style="s">Yeso Tthasi Yakku Ya Əǝ Lo Kab</para>
  <para style="r">(<ref loc="MRK 14:53-65">Markus 14:53-65</ref>; Luka 22:54, 63-71; Yohanna 18:13, 14,19-24)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Yakwɔ muo Yeso kwɔ tǝu lǝ gwoi Kayafa, Yikku ya Nyǝknung, bǝilǝ kwɔ ya nanatthǝ zuu gi Musa i yakku kǝbtha tthǝ. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Bitrus lǝi lǝ suai tutthǝ kullo, u tǝlǝ bǝ to kwan dang woi Yikku ya Nyǝknung. U tǝ bǝ to kwan ɓǝ tǝu ǝǝ tthang ya kigwoi ɓǝ yangɓǝ u ɓyǝa nungkwɔ a to nungɓǝ.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Yakku ya nyǝknung i ya to kwan dǝna ɗulǝi kwɔ i kǝb pǝllǝ lo Yeso ɓǝ yangbǝ i tǝilǝ lǝi kwɔ i thǝu ɓǝ; <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Kwoi i ɓuan i tǝilǝu, ko kwɔ yayuu kpaaɗing kwɔ kǝb pǝllǝ lolǝ. Nǝsua ǝndǝi yaɓǝi rab wuo, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />wui gei angǝ,&lt;&lt;Yiɓǝi kwɔ gei angǝ,&lt;Mǝn dǝr kǝm Nyǝknung gi Fuh kwɔ langkwoi i mai dang bo tai.&gt; &gt;&gt;<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Gong yikku ya Nyǝknung ǝrr dǝi nǝbo gei Yeso angǝ,&lt;&lt;A gei nwamǝ loba kwɔ wa?&gt;&gt; <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Kwoi Yeso kǝr nungu. Gong yikku ya Nyǝknung geiu angǝ,&lt;&lt;Dang ɗuǝn Fuh ya nwongǝi dǝmǝn da nung zuu: a gei ɓitthǝ mǝn Kristi,Yui gi Fuh.&gt;&gt;<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Yeso gwabu nwa angǝ, &lt;&lt;Manung akwɔ a gei ɓǝ. Kwoi ǝn gei ɓǝtthǝ ɓǝ ǝndǝi: baipiu lona kwɔ tǝlǝ tthasi ɓa ɓyǝa Yui Yuu a ǝǝ lona a nali gi Ya Angã langkwoi dǝna wɔ dang tǝi wayi!&gt;&gt;<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Tthǝ bakwɔ Gong Yikku ya nyǝknung trǝ nunglitthǝ gu gei angǝ,&lt;&lt;U gei ba a ɓko tthǝ Fuh! Ɓi yiɗi ba akun nwa yuu akun lǝu! Ɓalǝ ɗyǝam kwɔ u dal lǝ Fuh ɓǝng! <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Ən ɓǝɓa nhǝm?&gt;&gt;</para>
  <para style="p" vid="MAT 26:66">&lt;&lt;I gwabnwa angǝ, kwan muung i thǝu.&gt;&gt;<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Yang i twiu i twitwi dang nungǝu langkwoi i ɓuo; langkwoi yakwɔ ɓuo kwɔ <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />gei angǝ,&lt;&lt;A gei ɓi ba a tthasi tthǝ, Kristi! Ən yitǝn ɓua!&gt;&gt;<verse eid="MAT 26:68" /></para>
  <para style="s">Bitrus Yǝrnwa Tthǝ Yeso</para>
  <para style="r">(<ref loc="MRK 14:66-72">Markus 14:66-72</ref>; <ref loc="LUK 22:56-62">Luka 22:56-62</ref>; Yohanna 18:15-18, 25-27)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Bitrus ǝǝ gwam bǝ to kwan kwɔ yisi akun dang ya thǝb gi Gong Yikku ya Nyǝknung wuo suo wu gei angǝ, &lt;&lt;Mǝ, langɓǝ, suatha i Yeso ya Galili.&gt;&gt;<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Kwoi yǝrnwa tthasiǝ lǝ ǝndǝi.&lt;&lt;Ən ibǝi nungkwɔ dǝmma gei ɓǝlǝu,&gt;&gt;<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />langkwoi u lilotthǝ u i u tǝttha nwalǝgwoi bǝ to kwan ɓǝ. Thǝb munthang a yisi akun ɓyǝko langkwoi gei lǝ yaɓǝi kwɔ bǝilǝ kwɔ angǝ,&lt;&lt;U suatha i Yeso ya Nazarat.&gt;&gt;<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Langkwoi Bitrus nyimnwa i nung zuu gwab nwa angǝ, &lt;&lt;Ən ibǝ yiɓǝi kullo lǝu!&gt;&gt;<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Tthasua tuab yaɓǝi kwɔ dǝi bǝilǝ kwɔ wuo sua Bitrus wu gei angǝ,&lt;&lt;La langǝ i mǝ dang ǝi lǝ, bamǝ ilǝ pimǝng!&gt;&gt;<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Yang Bitrus gei angǝ, &lt;&lt; Dǝm zuu nung dǝm gei ǝn ba a langǝ i, Fuh ɗab luam nǝ dǝm gei ǝn ba a langǝ i lǝu ɓǝ! Ən i yiɓǝi kullo lǝu!&gt;&gt;</para>
  <para style="p" vid="MAT 26:74">Dangtthǝ ni yang gog ta, <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />langkwoi Bitrus nhǝm nungkwɔ Yeso geiu lǝ ɓǝ: &lt;&lt;Nungbǝi akwɔ gog a ta, ma gei bo tai mangǝ a im lǝu.&gt;&gt; U i gwam tǝu tasui ghaatthǝ.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">I Tǝlǝ Yeso Lǝ Sua Bilatus</para>
  <para style="r">(<ref loc="MRK 15:1">Markus 15:1</ref>; Luka 23:1, 2; <ref loc="JHN 18:28-32">Yohanna 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Nungwoi ɗǝng yakku ya nyǝknung ǝndei i yakku gwab lǝ thatthǝ angǝ i thǝb Yeso. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />I tthǝbu i sarka, i pkolǝ, tǝi du lǝ Bilatus, yikku losua Romawa.<verse eid="MAT 27:2" /></para>
  <para style="s">Ɓua Gi Yahuda</para>
  <para style="r">(Acts 1:18, 19)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Kwɔ Yahuda, ya ɓanglǝ bǝi, lǝ angǝ i to kwan ɓua lǝ Yeso tthǝ tǝi thǝbu, u tubi u kwoi lǝ nungkurɓǝ thǝmkun pǝmna sob tǝu dǝllǝ yikku ya nyǝknung i yakku. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />&lt;&lt;Ən to nung aɓau, Ən ɓanglǝ yuu kwɔ yangǝu i nung aɓau ɓǝ a ɓuiɓua!&gt;&gt;</para>
  <para style="p" vid="MAT 27:4">I geiu angǝ,&lt;&lt;Ən ɓǝɓi latthǝ? Ən zuii mǝ!&gt;&gt;<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Nungkwɔ Yahuda al nungkurɓǝ ɓǝlǝtǝ dang kǝm Nyǝknung pa nung gu; yang u pa tǝu yag lo kablǝ u ɓui.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Yikku ya nyǝknung ee nungkurɓǝ ɓǝ gei angǝ,&lt;&lt;Nungkwɔ ǝn nungkurɓǝ zii, zuu gwab ɓitthǝ ɓi dǝ dang bithal kǝm Nyǝknung lǝu.&gt;&gt; <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Tthasua kwɔ i gwab lǝtha tthǝ i lǝi nungkurɓǝ tǝi ɗyǝab lǝ pangsua ya mai tthǝm tthǝ yangbǝ nǝi suu yayol tthǝ. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Nungkwɔ to lakwɔ dǝi lu ɗuǝn pangsua angǝ&lt;&lt;Pangsua zii&gt;&gt; wullǝ vii a ɗiggǝ kwɔ. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Yang nungkwɔ ya gei ba a tthasi Irmiya gei kwɔ ǝǝlǝ ba a langǝ i: &lt;&lt;I lǝi nungkurɓǝ ɓǝkwɔ thǝmkun pǝmna sob kwɔ, nungkurɓǝ kwɔ ya Israila gwab dǝna yiɗi bǝ kwko lǝ ba gu ɓǝ, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />i lǝi nungkurɓǝ ɓǝ i ɗyǝab lǝ pangsua ya mai tthǝm, manung akwɔ Dangbang gei tthǝ ɓǝ.&gt;&gt;<verse eid="MAT 27:10" /></para>
  <para style="s">Bilatus Ɓibba Lǝ Yeso</para>
  <para style="r">(<ref loc="MRK 15:2-5">Markus 15:2-5</ref>; <ref loc="LUK 23:3-5">Luka 23:3-5</ref>; <ref loc="JHN 18:33-38">Yohanna 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Yeso dǝi tthasi yikku losua ya Romawa, nungkwɔ yikku losua ɓǝ ɓibu ba angǝ,&lt;&lt;Ən mǝ lǝ yigwoi ya Yahudawa?&gt;&gt;</para>
  <para style="p" vid="MAT 27:11">Yeso gwabnwa angǝ,&lt;&lt; A gei manungɓǝ,&gt;&gt;<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Kwoi u gei ba akun lǝu lo ba kwɔ yakku ya nyǝknung i yakuu gei lo ɓǝlǝu.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />Nungkwɔ Bilatus geiu angǝ,&lt;&lt;Alǝ i bakwɔ ǝndǝi dǝnni mua lǝ ɓǝlǝu?&gt;&gt;<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />Kwoi Yeso labǝ gei ba akun, lǝba nungɓǝ kwɔ kiggǝ yikku losua ɓǝ ǝrr ghaatthǝ.<verse eid="MAT 27:14" /></para>
  <para style="s">I To Kwan Ɓua Lǝ Yeso Tthǝ</para>
  <para style="r">(<ref loc="MRK 15:6-15">Markus 15:6-15</ref>; <ref loc="LUK 23:13-25">Luka 23:13-25</ref>; <ref loc="JHN 18:39">Yohanna 18:39</ref>; <ref loc="JHN 19:16">19:16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Ttha kwɔ ǝndei nǝ Vii ɓang nyang lo gwoi wuo yang yikku losua ya Romawa dǝna yina lǝ ya pursǝna kun kwɔ yayuu dǝna yiɗi i yinatthǝ ɓǝ. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Lona lǝ kullo ya pursǝna akun tthǝ kwɔ yayuu iu nikwɔ ɗuǝnu ǝn Barabbas. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Kwɔ kon gǝmtha, Bilatus ɓibbǝi angǝ,&lt;&lt;Ən yittǝn dǝɓa yiɗi ǝn yiɓǝ nattha? Yeso Barabbas ko, ǝn Yeso kwɔ dǝnni lu angǝ Ya Kristi ɓa?&gt;&gt; <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />U ibǝing la langǝ i ya dǝkab nwanung ya Yahudawa tǝ lǝ Yeso lǝ suo bakwɔ nwuo dǝna ziiy.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Kwɔ Bilatus ǝǝ lo nung ǝǝ to kwan, siu tumbǝi suo i nwatummi angǝ i: &lt;&lt;Bǝ ato nung akun lǝ yiɓǝi kwɔ to nung a kunlǝu ɓathǝ, bakwɔ nungvii ǝn to zuii dang muani ɗing lǝ ba gu.&gt;&gt;<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Yakku ya nyǝknung i sua yakku fuog kon yayuu kwɔ angǝ i gei Bilatus yina lǝ Barabbas langkwoi yang i thǝb Yeso.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Kwoi Bilatus ɓib angǝ, &lt;&lt;Dang yakwɔ rab kwɔ ǝn yitǝn dǝɓa yiɗi ǝn yiɓǝ nattha?&gt;&gt;</para>
  <para style="p" vid="MAT 27:21">I gwabnwa angǝ, &lt;&lt;Barabbas!&gt;&gt;<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Bilatus ɓibǝi angǝ,&lt;&lt;Ən ɓǝtǝn, yang, mǝn to, i Yeso kwɔ ɗuǝnu lǝ Kristi ɓa?&gt;&gt;</para>
  <para style="p" vid="MAT 27:22">I ǝndei i gwapnwa angǝ,&lt;&lt; piu!&gt;&gt;<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Kwoi Bilatus ɓib angǝ,&lt;&lt;Ənɓǝ lǝ nung a ɓko kwɔ u toɓa?&gt;&gt;</para>
  <para style="p" vid="MAT 27:23">Yang i baipi bǝ buogbǝi angǝ,&lt;&lt;piu!&gt;&gt;<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Kwɔ Bilatus ɓyǝa u ɓuan u to nung akunu, kwoi yayuu dǝna buogbǝi dǝnni yiɗi bǝ ǝrr lǝ kigǝ, u lǝi mungki, u ɗiggǝ lǝ nau dang si kon yayuu, langkwoi u gei angǝ,&lt;&lt;Zi yiɓǝi kwɔ yangǝu lom lǝu! Dǝi lo ɓǝ!&gt;&gt;<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Kon yayuu ǝndei gwabnwa angǝ,&lt;&lt;Ziu Dǝi loɓi i yathang ɓi!&gt;&gt;<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Yang Bilatus u yinathǝ Barabbas; langkwoi tthasua kwɔ u gei i ɓuob Yeso i thab, u ji Yeso yangbǝ tǝi piu.<verse eid="MAT 27:26" /></para>
  <para style="s">Ya soja Tthak Yeso</para>
  <para style="r">(<ref loc="MRK 15:16-20">Markus 15:16-20</ref>; Yohanna 19:2, 3)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Yang ya soja gi Bilatus lǝi Yeso tǝ lǝ gwoi yikku losua, sua ya soja ɓǝ ǝndǝi tǝ gǝmtha tthangǝu. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />I illǝ nunglitthǝ gu langkwoi i liu nunglitthǝ a thǝnni tthǝ. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Yang i kuluam nung muo lo kob i baiutthǝ lo, langkwoi i du kab bainatthǝ na nali; yang i bai nwa longǝi sua dang siu dǝnni tthakgǝu.&lt;&lt;Ɓi gummang, Yigwoi ya Yahudawa!&gt;&gt; <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />I twiu i twitwi dang nungǝu, i lǝi i kab ɓǝ i ɓuob lǝ lo. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Kwɔ i alo bǝ tthakgǝu, i ilǝ nunglitthǝ kwɔ i liutthǝ kwɔ i liu nunglitthǝ gutthǝ. Yang i iulǝ gwam yangbǝ tǝi piu.<verse eid="MAT 27:31" /></para>
  <para style="s">Bǝ Pi Yeso</para>
  <para style="r">(<ref loc="MRK 15:21-32">Markus 15:21-32</ref>; <ref loc="LUK 23:26-43">Luka 23:26-43</ref>; <ref loc="JHN 19:17-27">Yohanna 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Kwɔ dǝnni igwam, i kǝbtha i ya Kurane a kun tthǝ, ɗuǝnnu ǝn Saminu, i tou lǝ ttha u lǝi kab gangǝ i kwɔ tǝi pi Yeso tthǝ ɓǝ. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />I wuo bǝikwɔ dǝnni lu angǝ Golgota kwɔ, nungɓǝ lǝ, &lt;&lt;Bǝi kongdǝi lo.&gt;&gt; <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Bǝilǝ kwɔ tǝi dǝ min lǝ Yeso angǝ u nwa i lang min ɓǝ i kyal nung; kwoi kwɔ u bang, u labǝ nwau.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />I piu langkwoi i bai ǝnchǝl lo nunglitthǝ gu i gab lǝtha. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Tthasua nungkwɔ i ǝǝ bǝilǝ dǝnni ɓyǝko. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />I vullǝ nung i pi lo kab gangǝ i kwɔ i piutthǝ kwɔ angǝ: Yuu kwɔ ǝn Yeso, Yigwoi Ya Yahudawa.&gt;&gt; <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Yang i pi ya nung i rab i Yeso, yuu akun lo nko a nali yuu akun lo nko a namai. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Ya kwɔ dǝna pa nunglǝi kwɔ dǝna wab loi langkwoi dǝnni dal Yeso: <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />&lt;&lt;Ma dǝrr kǝm Nyǝknung langkwoi ma mai dang bo tai! A nwong lo mǝ nǝ mǝn Yui Fuh ɓǝ! A pin lo kab gangǝ i lǝ!&gt;&gt;<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Manung ɓǝni yakku ya nyǝknung i ya nanatthǝnung zuu gi Musa i yaku dǝna tthagǝu: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />&lt;&lt;U nwong yakun, kwoi u ɓuan u nwong lo lǝu! U ǝn yigwoi ya Israila lǝu? Nǝ u ɓumɓuan u pin lo kab gangǝ i lǝ lakwɔ, yang ɓi dǝ ba a langǝ itthǝu! <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />U dǝnyiutthǝ Fuh yang dǝu lǝi angǝ i ǝn Yui Fuh. Dǝisua, ɓi ɓyǝa lko Fuh dǝna yiɗi bǝ nwongǝu lakwɔ!&gt;&gt; <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />I ya nung i kwɔ i pii i ulǝ kwɔ dǝna dalǝu manungɓǝ.<verse eid="MAT 27:44" /></para>
  <para style="s">Bǝ Ɓuiɓua Gi Yeso</para>
  <para style="r">(<ref loc="MRK 15:33-41">Markus 15:33-41</ref>; <ref loc="LUK 23:44-49">Luka 23:44-49</ref>; <ref loc="JHN 19:28-30">Yohanna 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Dangfuh bǝi baithǝl losua lǝ ǝndǝi, kǝn lona tai. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Gɓag lona tai Yeso tasui i yol ghaatthǝ angǝ, &lt;&lt;Eli, Eli, lama sabachthani?&gt;&gt; Nungɓǝ lǝ, &lt;&lt;Fuhm, Fuhm, ǝn ba ɓǝ bǝ a imlǝ a li nwatǝi?&gt;&gt;<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Yakun kwɔ dǝi bǝilǝ kwɔ lǝ bakwɔ dǝu gei kwɔ i gei angǝ,&lt;&lt;Dǝnnu lubǝ Iliya!&gt;&gt; <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Yuu akun dang ǝi lǝ surdum dang tthǝ, u lǝi soso, u bai dang mung a ǝmmi, u bai nwa kab, langkwoi u dǝllǝ Yeso angǝ u nwa.<verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />Kwoi yakun gei angǝ, &lt;&lt;Ɓa dǝi, ɓi ɓyǝa lko Iliya wa nwongǝu!&gt;&gt;<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Yeso langkwoi ǝrr tasui i yol angǝ a u sui fǝl nǝsua.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Yang laɓulǝ dang kǝm Nyǝknung trǝ gab dang ǝu rab wayi pin wulǝ pangsua. Pangsua thǝuri, ɓǝmɓǝm tal gab rab, <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />ɓua juǝn ya langǝ i a ɓko, langkwoi yayuu Fuh kpaatthǝ kwɔ ɓui kwɔ i ǝrr i nwongǝi. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />I yitthǝ tǝ ɓua juǝn ɓǝ, langkwoi kwɔ i ǝrrǝu lǝ bǝ ɓuiɓua, itǝ gwoi a langǝ i angǝ a, bǝi lǝ kullo yayuu kpaatthǝ ɓiy.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Kwɔ yikku ya soja i ya soja kwɔ i u kwɔ dǝnni ki Yeso i ɓyǝa pangsua kwɔ thǝuri kwɔ i nungkwɔ ǝndǝi to nung kwɔ, i ǝndǝi i sur vulli, i gei angǝ,&lt;&lt;La langǝ i u ǝn Yui gi Fuh!&gt;&gt;<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Yasi tthǝ kpaatthǝ bǝilǝ, i dǝi tutthǝ dǝnni ɓyǝa bǝi, yakwɔ baipi bǝ muo sua Yeso Galili langkwoi dǝnni nwongǝu ɓǝ. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Dangǝi lǝ ǝn Maryamu Magadaliya, Maryamu naa gi Yakubu i Yusufu, langkwoi i si Zabadi.<verse eid="MAT 27:56" /></para>
  <para style="s">Bǝ Suu Yeso</para>
  <para style="r">(<ref loc="MRK 15:42-47">Markus 15:42-47</ref>; <ref loc="LUK 23:50-56">Luka 23:50-56</ref>; <ref loc="JHN 19:38-42">Yohanna 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Kwɔ nungluii to, yiɓǝi ya nungtǝi akun ya Arimatiya wɔ, ɗuǝnnu ǝn Yusufu, langkwoi u ǝn ya nanung to gi Yeso. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />U tǝ sua Bilatus, tǝu yam angǝ i ji kwamɓui Yeso tǝi suu. Nungkwɔ Bilatus gei angǝ i dǝ kwamɓui yuu ɓǝlǝ Yusufu. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Nungkwɔ Yusufu lǝi kwamɓui Yeso ɓa, u kuluam i landǝ linin, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />tǝu suu Yeso dang juǝn gu, kwɔ u tha nǝfuu dang tal ɓǝ. Yang u kǝlǝng gong tal gbag nunglǝi nwa ɓua ɓǝ u lamlǝ nwaɓua ɓǝ nungkwɔ u pa nung gu. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Maryamu Magadaliya i Maryamu akun i ǝǝ bǝilǝ, nungǝi nwaɓua juǝn lǝ.<verse eid="MAT 27:61" /></para>
  <para style="s">Ya Ki Ɓua Juǝn</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Ibǝikan, kwɔ lǝ vii nwongǝi ya Yahudawa, yakku ya nyǝknung i ya Farisiyawa tǝ sua Bilatus. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Langkwoi i gei angǝ,&lt;&lt;Yikku, ɓi nhǝm ɓingǝ kwɔ yirrǝ ya pǝllǝ kullo i nwongǝi kwɔ u gei angǝ, &lt;I ǝrrǝm lǝ i nwongǝi dang bo tai.&gt; <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />A gei ba, yang, ya kinung ki juǝn ɓǝ matthǝ bo tai ɗǝ, yangbǝ bǝ ya nanung to gu ɓuan tǝ i kwamɓuiu, yang i gei lǝ ya yuu tthǝ angǝ u ǝrrǝu lǝ i nwongǝing. Pǝllǝ a nǝsua kwɔ a pǝll nwasiu.&gt;&gt;<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Bilatus gei angǝ,&lt;&lt;Ɓa lǝi ya kinung, ɓatǝ tǝɓa ki ɓua jun ɓǝ la langǝ i.&gt;&gt; <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Nungkwɔ i tǝ tǝi dǝ nung lamnung i lam lǝ tal kwɔ nwa ɓua juǝn ɓǝ la langǝ i i dǝ ya kinung dǝna ki nwa ɓua jun ɓǝ.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Bǝ Ərr Gi Yeso</para>
  <para style="r">(<ref loc="MRK 16:1-10">Markus 16:1-10</ref>; <ref loc="LUK 24:1-12">Luka 24:1-12</ref>; <ref loc="JHN 20:1-10">Yohanna 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Tthasua vii nwongǝi ya Yahudawa, kwɔ bǝi dǝna kan vii Lahadi, Maryamu Magadaliya i Maryamu akun itǝ bǝ ɓyǝa juǝn ɓǝ.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />Dangtthǝ ni yang pangsua thǝuri ghaatthǝ; ya nwatummi gi Dangbang pin wayi wuo pangsua, kǝlǝng tal ɓǝ u kwoilǝ, langkwoi ǝǝ lolǝ. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Bǝ i gu mangǝng lua gap bǝi, nunglitthǝ gu vǝrrǝm mang mual landa. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Vulli muo ya ki jun ɓǝ tthǝi dǝna ɓuobtthǝm i mǝrrǝm mangǝn kwamɓui yayuu.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Ya nwatummi gi Fuh gei ba lǝ yasi ɓǝ angǝ,&lt;&lt;Bǝɓa sur vulli thǝ, ǝn ibǝi dǝɓa ɗubǝi Yeso, kwɔ i piu lo kab gangǝ i ɓǝ. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />U yangǝu bǝikwɔu; i ǝrrǝu lǝng bǝ ɓuiɓua, manung akwɔ u gei ɓǝ. Ɓa wɔ wuɓa ɓyǝa bǝikwɔ i dutthǝ ɓǝ. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Ɓa tǝ thǝm tthǝ lakwɔ tǝɓa gei lǝ ya nanung to gu tthǝ, &lt;I ǝrrǝu lǝng bǝ ɓuiɓua, langkwoi lakwɔ u tthasi ɓǝ dǝu tǝ Galili; ɓa tǝiu bǝilǝ!&gt; Ɓa nhǝm nungkwɔ ǝn gei ɓǝ tthǝɓǝ.&gt;&gt;<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Nungkwɔ yasi ɓǝ pa thǝmtthǝ nwa juǝn lǝ, dǝi lǝ tthǝ vulli langkwoi dǝi lǝ tthǝla, i surdum yangbǝ tǝi geilǝ ya nanung to gu tthǝ.<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />Dangtthǝ ni Yeso fuk tthǝi gei angǝ,&lt;&lt;Dǝmǝn gum ɓǝ.&gt;&gt; Ərr i wuo tthangǝu, dǝi yiɗi bǝ muo kabo yangbǝ i wabbu. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Yang Yeso gei angǝ,&lt;&lt;Bǝ ɓa sur vulli thǝ, Tǝɓa gei lǝ ya youngǝm tthǝ i tǝ Galili, langkwoi bǝilǝ kwɔ tǝi ɓyǝam.&gt;&gt;<verse eid="MAT 28:10" /></para>
  <para style="s">Nwaba Ya Ki jun</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Kwɔ yasi ɓǝ lo nunglǝi gi, yakun dang ya soja ya ki jun ɓa ǝrr tǝ dang gwoi angǝ a tǝ gei baɓǝ lǝ yakku ya nyǝknung tthǝ nungkwɔ to nung ǝndǝi ɓǝ. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Yakku ya nyǝknung kǝbtha i yakku nungkwɔ i mab ba gi; i dǝ nungkurɓǝ kpaatthǝ lǝ ya soja <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />i gei angǝ,&lt;&lt;Ɓa gei ɓangǝ, Ya nanung to gu wuo nung vii wui iu i palǝ dǝɓi lonung lo. <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Nǝ nilǝu nǝ bakwɔ tǝ sui Yikku losua angǝ a, yang ɓi geiu ɓingǝ ɓa ibǝ nung akun lǝu, yang nung akun yangǝu a tǝi ɓǝu.&gt;&gt;<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Ya soja ɓǝ muo nungkurɓǝ ɓǝ nungkwɔ i to manung akwɔ i gei tthǝ ɓǝ. Nungkwɔ lǝ nwaba kwɔ lǝi dang ya Yahudawa ǝndǝi wullǝ vii a ɗiggǝ kwɔɓǝ.<verse eid="MAT 28:15" /></para>
  <para style="s">Yeso Fuk Tthǝ Ya NanunTo Gu</para>
  <para style="r">(<ref loc="MRK 16:14-18">Markus 16:14-18</ref>; <ref loc="LUK 24:36-49">Luka 24:36-49</ref>; <ref loc="JHN 20:19-23">Yohanna 20:19-23</ref>; Acts 1:6-8)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Yang ya nanung to kwɔ sob iu kun kwɔ patǝ lo ɓǝmtal Galili bǝikwɔ Yeso gei angǝ i tǝ ɓǝ. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Kwɔ i ɓyǝko, i wabbu, yakun dǝba a langǝ i tthǝ lǝu. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Yeso wuo suai wu gei angǝ,&lt;&lt;I dǝ ttha wayi i a longwam ǝndǝi dang nam. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Ɓatǝ, sua yayuu ǝndǝi losua kwɔ ǝndǝi tǝɓa mǝrrǝm mǝi lǝ ya nanungtom: ɓa wollimung dang ɗuǝn Daa, i Yui i Ɓyang a Langǝ i, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />langkwoi ɓa nǝinatthǝ i to nungto i nungkwɔ ǝndǝi ǝn gei ɓǝtthǝ ɓǝ. Langkwoi ɓang i ɓǝlǝ vii ǝndǝi, tǝlǝ nwa longwam.&gt;&gt;<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>