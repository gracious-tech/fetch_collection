  <chapter number="1" style="c" sid="ACT 1" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />Tiyofalas kwɔ ǝn yiɗi niɓǝ:</para>
  <para style="p" vid="ACT 1:1">Dang nung vullǝm a nwasiu ǝn vullǝ nung lo nung kwɔ Yeso to i nung kwɔ u nanatthǝ ǝndǝi ɓǝ baipiu lona kwɔ u baipi nungto gu ɓǝ <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />wullǝ vii kwɔ i lǝiu i tǝlǝ wayi ɓǝ. Tthasua kwɔ u dǝba nyimtthǝ i tthǝ nyimmi Ɓyang a langǝ i lǝ ya kwɔ u mko lǝ ya nwatummi gu ɓǝ. <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />Tthasua ɓua gu bo thǝm rab dǝnnu fuk tthǝi nunglǝi a kwɔ bǝ nyim nwa yangǝu tthǝ ɓǝ angǝ u i nwongǝi. I ɓyǝko, langkwoi u gei ba i ilǝ lǝ ba lona bǝ wuo bǝ lo yigwoi Fuh. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />Vii a kun kwɔ dǝu tang nung i ilǝ, yang u ji ba a nyimmi kwɔ angǝ: &lt;&lt;Bǝ ɓa pa dang Urshalima thǝ yirrǝ, kwoi ɓa ki nung dǝ kwɔ ǝn gwab ɓǝ nwa ɓǝ, nung kwɔ Daam gwab ɓǝ nwa ɓǝ kwɔ ɓa lǝm dǝm gei bko ɓǝ. <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />Yohanna wolmung ɗiggǝ nung a ɓko i mungki, kwoi natthǝ tuab yang i wol ɓǝ mung i Ɓyang a Langǝ i.&gt;&gt;<verse eid="ACT 1:5" /></para>
  <para style="s">Fuh Lǝi Yeso Tǝllǝ Wayi</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />Kwɔ ya nwatummi kǝbtha i Yeso, i ɓibbu angǝ, &lt;&lt;Dangbang, ǝn lona kwɔ ma dǝ bǝ lo yigwoi lǝ ya Israila?&gt;&gt;<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />Yeso gei angǝ, &lt;&lt;I dǝ ɓǝ nung lǝi kwɔ ɓa i bǝ lona i vii ɓǝ lǝu ǝn Daam dǝna dǝ i ttha gu. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />Kwoi kwɔ nǝ Ɓyang a Langǝ i wuo lo ɓǝ, ttha a yi tthǝ ɓǝ, langkwoi ɓǝ lǝ shǝdǝm Urshalima, i Yahudiya ǝndǝi i Samariya, langkwoi i nwa longwam ǝndǝi. <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" />Tthasua bǝ gei nung kwɔ, Fuh lǝiu tǝllǝ wayi i dǝi i dǝ nung tthǝu, langkwoi tǝi kko nungǝi lǝ.<verse eid="ACT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10" />Yirrǝ i dǝi i dǝ nungǝi yi kwɔ dǝnnu pa ɓǝ, dang tthǝ yayuu rab kwɔ li nung la vǝrrǝm dǝi tthangǝ i <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />yang i gei angǝ, &lt;&lt;Ya Galili, ǝn ba ɓǝ bǝ ɓa dǝi kullo dǝ ɓa ɓyǝa yi? U Yeso kwɔ, i lǝi na ɓǝ i tǝlǝ wayi kwɔ, u kwoi suo manung kwɔ ɓa ɓyǝa i lǝiu i tǝllǝ wayi ɓǝ.&gt;&gt;<verse eid="ACT 1:11" /></para>
  <para style="s">I Mko Matiyas Prǝm Nwa Yahuza</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />Yang ya nwatummi gi Yeso pin lotal Zaitun kwoi suai tǝ Urshalima, kwɔ kǝn mǝl kun lǝu i gwoi angǝ a ɓǝ. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />I tǝ gwoi angǝ a ɓǝ nung kwɔ i pa i tǝ kǝm a yi kwɔ dǝi ǝǝ tthǝ ɓǝ: Bitrus, Yahaya, Yakubu i Andarawas, Filibus i Toma, Bartalamawas i Matiyu, Yakubu yui Halfa, Siminu Zaloti, i Yahuza yui Yakubu. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />Dǝnni gǝmtha vii ǝndǝi dǝnni pinwa nwai kun, i i yasi langkwoi i Maryamu naa gi Yeso i ya youngǝu.<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />Sua tulǝu bǝ kǝbtha ya dǝba a langǝ i tthǝ, loi ǝndǝi thǝm nanakun pǝmna sob, nung kwɔ Bitrus dǝi nǝbo yang bǝ gei ba. <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />Langkwoi u gei angǝ,&lt;&lt;Ya ǝnthǝm, nungvullǝ gi Fuh a ǝǝ lǝ ba a langǝ i kwɔ Ɓyang a Langǝ i, gei ba nwa Dkoda ɓǝ, kwɔ gei nung lo Yahuza ɓǝ, yuu a kwɔ osi lǝ ya kwɔ muo Yeso ɓǝ. <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />Yahuza ǝn yuu a kun dang ɓi, i mko yang bǝ u tonungto dang ɓi.&gt;&gt;<verse eid="ACT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18" />(Yahuza ɗyǝab pangsua i nungkurɓǝ kwɔ u tǝi lǝ ba nung a ɓko gu ɓǝ, bǝi lǝ kwɔ u o tthǝ u ɓui; u ɓuom nung dang wko igwam. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />Yayuu kwɔ ǝǝ Urshalima ǝndǝi lǝ nung ɓǝ kwɔ, nung kwɔ i lu ɗuǝn bǝi ɓǝ i nwa gwoi gi angǝ Akeldama, nung ɓǝ lǝ pangsua zii.&gt;&gt;)<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />&lt;&lt;Ba kwɔ i vullǝ dang nung vullǝ zabura angǝ,</para>
  <para style="p" vid="ACT 1:20">&lt;Kaso gwoi gu lonǝkwam; kaso bǝ yuu kun ǝǝ tthǝ thǝ&gt; I vullǝ langkwoi angǝ,</para>
  <para style="p" vid="ACT 1:20">&lt;Kaso yuu a kun lǝi bǝ dǝi tonungto gu.&gt;<verse eid="ACT 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21" />&lt;&lt;Manungkwɔni yang, ɓi mko yuu a kun dang yaɓǝi kwɔ i ɓi lǝ kwɔ kwɔ ɓi suatha ibǝ bǝ ǝrr gi Yeso i nwongǝi kwɔ prǝm nwa Yahuza, <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />baipiu lona kwɔ Yohanna dǝna gei ba a langǝ i bǝ wolmung wullǝ vii kwɔ Fuh lǝi Yeso naɓi tǝlǝ wayi ɓǝ.&gt;&gt;<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />Nung kwɔ i dǝ ɗuǝn yayuu rab: Yusufu, kwɔ dǝnni lu angǝ Barsaba (kwɔ langkwoi dǝnni lu angǝ Yustus ɓǝ), i Matiyas. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />Yang i pinwa angǝ, &lt;&lt;Dangbang, a i bǝ nhǝm ba yayuu ǝndǝing, manungkwɔ ni yang a ta ɓi natthǝ yuu a kwɔ a mko dang ya kwɔ rab kwɔ ɓǝ <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />yang bǝ u tonungto lǝ nwathan Yahuza lǝ ya nwatummi mǝ, yuu a kwɔ patǝ bǝi kwɔ u ǝrr tthǝ ɓǝ.&gt;&gt; <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />Yang i bai ǝnchǝl yang bǝ i mko yuu a kun dang ǝi kwɔ rab kwɔ, yuu a kwɔ i mko kwɔ ǝn Matiyas nung kwɔ i lilǝ lo ya nwatummi sob iu kun kwɔ ɓǝ.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">Bǝ Wuo Gi Ɓyang a Langǝ i</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />Kwɔ vii Fentikos wuo, ya dǝ ba a langǝ i gǝmtha bǝikun. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />Dangtthǝ ni yang yol nung gwab wayi kwɔ gwab mangǝ waa dǝna ɓuob, wuu yi gwoi ɓǝ ǝndǝi bǝi kwɔ i ǝǝ tthǝ ɓǝ. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />Yang ǝrr i ɓyǝa nung a kun mangǝn lyǝn lua wuu pin loi ǝndǝi kwɔ bǝilǝ ɓǝ. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />I ǝndǝi Ɓyang a Langǝ i yitthǝi ǝrr i baipi bǝ gei ba i nwa yakun manungkwɔ Ɓyang a Langǝ i oi lǝ si ɓǝ.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />Lona lǝ kullo ya Yahudawa kwɔ dǝna sur Fuh nikwɔ ǝǝ Urshalima, ya Yahudawa kwɔ ǝrr losua angǝ a ǝndǝi longwam kwɔ ɓǝ. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />Kwɔ i lǝ vǝm nungkwɔ ni, kon yayuu gǝmtha, ba kwɔ i ǝndǝi dǝnni lǝ ya dǝba a langǝ i dǝna gei ba i nwa gwoi gi ɓǝ. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />Loi fǝm, i ɓib angǝ, &lt;&lt;Yayuu kwɔ dǝna gei ba nikwɔ ǝn ya Galili! <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />Tonǝnǝ, yang, ɓi ǝndǝi dǝɓi lǝi dǝnni gei ba i nwa gwoi ɓiǝ? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />Ɓi ǝnya Fartiyawa, Madayanawa, i Elamawa; ɓi ǝrr Bagadaza, Yahudiya, i ya Kafadokiya; i ya Fantas, i ya Asiya, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />i ǝrr Firijiya i Bamfiliya, Masar i ɓyǝn ya Libiya gɓag Kurane. Yakun ǝrr Roma, <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />i ya Karitawa ǝndǝi i yakwɔ ǝn ya Yahudawa lǝu kwɔ, kwɔ i mǝrrǝm Yahudanci, langkwoi yakun ǝrr karitawa i Larabawa yirrǝ ɓi ǝndǝi dǝɓi lǝi dǝnni gei ba i nwa gwoi ɓi lǝ ba gong nungkwɔ Fuh toɓǝ!&gt;&gt; <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />Loi fǝm dǝi ɓibtha angǝ, &lt;&lt;Nungkwɔ ǝǝ lǝn ɓǝttǝn?&gt;&gt;<verse eid="ACT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13" />Yakun dang kong ɓǝlǝ dǝna tthak ya dǝba a langǝ i ɓǝ angǝ, &lt;&lt;Yayuu kwɔ nwa mung fǝrrǝng!&gt;&gt;<verse eid="ACT 2:13" /></para>
  <para style="s">Bitrus Gei Ba Lǝ Kon Yayuu</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />Yang Bitrus ǝrr dǝi nǝbo i sua ya nwatummi gi Yeso sob iu kun kwɔ baipi bǝ gei ba lǝ kon yayuu i yol angǝ, &lt;&lt;Ya young ɓi ya Yahudawa i ɓǝ kwɔ ɓa ǝǝ Urshalima kwɔ, ɓa lǝm kwɔ mǝn gei ɓǝ nungkwɔ bakwɔ dǝna gǝi ɓǝ. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />Yayuu kwɔ nwa ǝn mung fǝr, manungkwɔ dǝɓa nhǝm ɓǝlǝu; ǝn lona songsob ɓuo a nungwoi lakwɔ. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />Nilǝu, Nungkwɔ lǝ nungkwɔ ya gei ba a tthasi Yowel gei ba loɓǝ:<verse eid="ACT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 2:17" />&lt;Fuh gei angǝ, nungkwɔ mǝn to vii a nǝsua kwɔ manungkwɔni:</para>
  <para style="p" vid="ACT 2:17">Mǝn al Ɓyangǝm lo yayuu ǝndǝi.</para>
  <para style="p" vid="ACT 2:17">Yathang ɓǝ yaɓǝi i yasi a gei ba a tthasi;</para>
  <para style="p" vid="ACT 2:17">Fuh a tanatthǝ kilǝng lǝ ya baittha ɓǝ,</para>
  <para style="p" vid="ACT 2:17">ya to yikuu ɓǝ a muan muani.<verse eid="ACT 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 2:18" />Ən, i ya thǝbǝm ǝndǝi, yaɓǝi i yasi,</para>
  <para style="p" vid="ACT 2:18">Mǝn al Ɓyangǝm dang wam lǝkwɔ,</para>
  <para style="p" vid="ACT 2:18">langkwoi i gei bam.<verse eid="ACT 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 2:19" />Mǝn to nung fǝmlo yilǝ</para>
  <para style="p" vid="ACT 2:19">langkwoi nung ǝrr lǝ kiggǝ longwam pangsua.</para>
  <para style="p" vid="ACT 2:19">Zii tthǝ, lua, i duu ɓuon tthǝ.<verse eid="ACT 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 2:20" />Fuh a baithǝl,</para>
  <para style="p" vid="ACT 2:20">langkwoi fi a mǝrrǝm la thǝnni mangǝn zii,</para>
  <para style="p" vid="ACT 2:20">nwuni gong vii i ghaali Vii Dangbang a wɔ.<verse eid="ACT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 2:21" />Langkwoi yang, yuu a kwɔ lubǝ Dangbang ba bǝ nwong bǝi i nwongǝu.&gt;<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />&lt;&lt;Ya youngǝm ya Israila, ɓa lǝ bakwɔ! Yeso ya Nazarat ǝn yuu kwɔ tthǝnyimmi gu kai nǝkwam tthǝ ɓǝlǝ i nung fǝmlo kwɔ Fuh to i u lǝ ɓǝ. Manung kwɔ ɓǝ i naɓǝ lǝ ɓa i bǝ nung kwɔǝng, ba kwɔ nung ɓǝ tonung ganglang ɓǝlǝ ɓǝ. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />Manung a kwɔ Fuh mab zuiu u gwab angǝ i dǝɓǝ Yeso; ɓa thǝu na ya nung a ɓko a piu lo kab gangǝ i. <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />Kwoi Fuh ǝrrǝu lǝ i nwongǝi dang ɓua, u iu lǝ nǝkwam na ttha ɓuiɓua, bakwɔ ɓua ɓuan muu mangǝn ya pursǝnǝ lǝu ɓǝ. <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />Bakwɔ Dkoda gei ba Yeso angǝ,</para>
  <para style="p" vid="ACT 2:25">&lt;Ən ɓyǝa Dangbang tthasim lona ǝndǝi; u gbagǝm, langkwoi kiggǝm ǝrrǝu.<verse eid="ACT 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 2:26" />Langkwoi nungkwɔni yang tthǝm la ǝndǝi, langkwoi bam ǝndǝi ǝn tthǝla.</para>
  <para style="p" vid="ACT 2:26">Langkwoi Ɓang, kwɔ lǝ ya ɓuiɓua kwɔ, mǝn ǝǝ dang bǝ dǝnyitthǝ Fuh,<verse eid="ACT 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 2:27" />bakwɔ a songlim longwam ya ɓuiɓuko;</para>
  <para style="q1" vid="ACT 2:27">a yi ya thǝbmǝ a langǝ i zuu dang juǝn nǝu.<verse eid="ACT 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 2:28" />A tamnatthǝ nunglǝi a kwɔ tǝmlǝ nwongǝi ɓǝng,</para>
  <para style="p" vid="ACT 2:28">ma toǝm mǝn lǝ tthǝla ɗǝgsi mǝ.&gt;<verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />&lt;&lt; Ya youngǝm ya Israila, Mǝn gei ɓǝ ba tthǝ kaitthǝ lǝba ya bǝpi ɓi a nwasiu Yigwoi Dkoda. U ɓui i suu, juǝn gu tthǝ bǝikwɔ i ɓilǝ wulǝ vii a ɗiggǝ kwɔ. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />U ǝn ya gei ba tthasi, langkwoi u i bǝ nungkwɔ Fuh gwabu nwa ɓǝng: Fuh zuu nung angǝ i to yuu a kun dang ya byǝko lǝ yigwoi, manung Dkoda. <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />Dkoda ɓyǝa nungkwɔ Fuh dǝna tǝbǝ tou tthasi ɓǝng, nungkwɔ gei ba bǝ ǝrr gi Kristi i nwongǝi kwɔ u gei angǝ,</para>
  <para style="q1" vid="ACT 2:31">&lt;I songliu longwam ya ɓuiɓua lǝu;</para>
  <para style="q1" vid="ACT 2:31">tthǝu zuu dang juǝn lǝu.&gt;<verse eid="ACT 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 2:32" />Fuh ǝrr lǝ Yeso ɓǝ kwɔ i nwongǝi, langkwoi ɓi kwɔ ǝndǝi ǝn ya shǝdǝ tthǝ nung ɓǝ kwɔ. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />I ǝrrǝu lǝ i dǝ lona nali gi Fuh, Daa gu, langkwoi u muo Ɓyang a Langǝ i kwɔ i gwabbu nwaɓǝ. Nungkwɔ dǝɓa ɓyǝa lakwɔ dǝɓa lǝkwɔ ǝn nung dǝ gu kwɔ u al loɓi ɓǝ. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />Bakwɔ ǝn Dkoda kwoi tǝ wayi lǝu; kwoi u gei angǝ,</para>
  <para style="q1" vid="ACT 2:34">&lt; Fuh Daa gei lǝ Dangbangǝm tthǝ angǝ:</para>
  <para style="q2" vid="ACT 2:34">A ǝǝ bǝikwɔ lona a nalim<verse eid="ACT 2:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 2:35" />nǝ ǝn dǝ ya ɓui mǝ lǝ thko dǝ bomǝ ɗǝ.&gt;<verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />&lt;&lt;Manungkwɔni yang ɓǝ ya Israila ǝndǝi, yang, ɓa i bǝi la langǝ i ɓang Yeso kwɔ, ɓa pi lokab gangǝ i kwɔ, lǝ yuu a kwɔ Fuh mab lǝ Dangbang i Kristi ɓǝ!&gt;&gt;<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />Kwɔ yayuu lǝ nungkwɔ, kiggǝi ǝrr ghaatthǝ i gei Bitrus i sua ya nwatummi ɓǝ angǝ, &lt;&lt;Yayoung ɓi, ǝn ɓǝ ɓi to?&gt;&gt;<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />Bitrus gei angǝ, &lt;&lt; Ko ǝn ya ǝndǝi mǝrrǝm yitthǝ nung a ɓko gu yang i wollu mung dang ɗuǝn Yeso Kristi, yang bǝ i al nung a ɓko ɓǝ lǝtǝ; yang ɓa muo nung dǝ gi Fuh, Ɓyang a Langǝ i. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />Bakwɔ Fuh dǝ ganglang gu i ɓǝlǝ i yathang ɓǝ, langkwoi i ya kwɔ tutthǝ ǝndǝi ɓǝ ya kwɔ ǝndǝi Dangbang Fuh ɓi a lubǝi tthǝu lǝ ɓǝ.&gt;&gt;<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />Bitrus yammǝi i balǝ kpaatthǝ u gei ba, angǝ, &lt;&lt;Ɓa nwong loɓǝ tthǝ bǝ ɗablua bǝi kwɔ da wɔ lo yayuu a ɓko kwɔ ɓǝ!&gt;&gt; <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />Ya kpaali dang ǝi dǝba a langǝ i tthǝ bagu nungkwɔ i wolli mung, langkwoi yayuu tthǝmsob ɓua li i lilǝ lo yayuu Fuh. <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />I lǝi lona dǝnni nanung na ya nwatummi, dǝnni wuo bǝ kǝbtha, dǝnni tang nung lotha i bǝ pinwa.<verse eid="ACT 2:42" /></para>
  <para style="s">Bǝ Əǝ Ya Dǝba A Langǝ i</para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />Ya nwatummi to nung fǝmlo i nung ǝrr lǝ kiggǝ kpaatthǝ, langkwoi tthǝ yayuu ǝndǝi sur Fuh i bǝ du ghaali. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />Ya dǝba a lilo tthǝ bǝ gǝmtha dǝnni gab nung nai lǝ tha. <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />I ɗyǝab nungnai i nungtǝi gi, yang i gab nungkurɓǝ ɓǝ ɓuai ǝndǝi, manung a kwɔ ko ǝn ya dǝna yiɗi ɓǝ. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />Vii ǝndǝi dǝnni kǝbtha kǝm nyǝknung, langkwoi dǝnni tang nungtang lotha gwoi gilǝ, dǝnni tangnung tang i tthǝla dang nyi a langǝ i, <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />dǝnni kha Fuh, langkwoi dǝnni to lonyi a langǝ i tthǝ tha. Langkwoi vii ǝndǝi Dangbang dǝna lilo thayuu kwɔ Fuh nwongǝi ɓǝ.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">Ya Othko Ya Yam Nung Tǝi Tthǝla</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />Vii a kun lǝ Bitrus i Yohanna dǝna tǝ kǝm nyǝknung lona tai a dang fuh, lona bǝ pinwa. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />Bǝilǝ nwalǝgwoi a kwɔ maɗing kwɔ, manungkwɔ dǝi luɓǝ, yiɓǝi a kuntthǝ i siu lǝ kuglǝ bǝilǝ. Vii ǝndǝi dǝi lǝu dǝnni tǝlǝ nwalǝgwoi ɓǝ yangbǝ u tǝ nǝu yam nungkurɓǝ na yayuu kwɔ dǝna tǝ kǝm nyǝknung ɓǝ. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />Kwɔ u ɓyǝa Bitrus i Yohanna dǝna tǝ dang kǝm nyǝknung ɓǝ, u yammi angǝ i ji nung akun. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />I dǝ nung tthǝu, nungkwɔ Bitrus gei angǝ, &lt;&lt;A ɓyǝa ɓi!&gt;&gt; <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />Nungkwɔ u ɓiǝ, dǝnnu ki lko i tǝi nung a kun nai. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />Kwoi Bitrus geiu angǝ,&lt;&lt;Nungkurɓǝ yangǝu nammu ko a tuab, kwoi mǝn da nung kwɔ nam ɓǝ: dang ɗuǝn Yeso ya Nazarat ǝn gei gǝ ǝrr a thko!&gt;&gt; <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />Yang u muo nko a nali u nwongǝu u dǝi nǝbo. Ba a nwaɓi kwɔ bo yiɓǝi ɓǝ i gulbo nyim; <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />u zuǝ u tǝyi u dǝi i bo lǝ, langkwoi u baipi bǝ thko dǝu gilǝng. Yang u tǝ dang kǝm nyǝknung i ilǝ, dǝnnu thko dǝnnu zuǝ dǝnnu kha Fuh. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />Kwɔ yayuu kwɔ ɓiu dǝnnu thko dǝnnu kha Fuh, <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />I ibǝi angǝ ulǝ ya yamnung kwɔ ǝǝ nwalǝgwoi nyǝknung kwɔ dǝnni lu angǝ maɗing kwɔ, i ǝndǝi loi fǝm tthǝ nungkwɔ tǝiu ɓǝ.<verse eid="ACT 3:10" /></para>
  <para style="s">Bagi Bitrus Dangkǝm Nyǝknung</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />Kwɔ yiɓǝi kwɔ gɓag sua Bitrus i Yohanna tǝlǝ bǝikwɔ dǝnni luu angǝ yui kǝm gi Sulǝmanu kwɔ, manungkwɔ dǝi lu kwɔ, lo yayuu fǝm nungkwɔ i pa suai bǝilǝ. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />Kwɔ Bitrus ɓyǝa yayuu, u gei angǝ, &lt;&lt;Ya youngǝm ya Israila, baɓǝ bǝ loɓǝ dǝna fǝm tthǝ nungkwɔ, langkwoi ǝn baɓǝ bǝ dǝɓa zun ɓi? Dǝɓa nhǝm mangǝttǝn ǝn ttha ɓi i bǝ wab fuh nungkwɔ ɓi to yiɓǝi kwɔ dǝna thkothko? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />Fuh gi Ibrahim, Ishaku i Yakubu, Fuh ya bǝba ɓi, dǝ ghaali lǝ thǝb gu Yeso. Kwoi ɓa dulǝ ya dǝkab nwanung yang bǝ tǝi thǝu, ɓa lko tthasi Bilatus, ko kwɔ Bilatus nhǝm bǝ yiuna nǝkwam mǝng ɓa. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />U yangǝu i nung a ɓko langkwoi u maɗing, kwoi ɓa lko, kwoi langkwoi ɓa gei Bilatus ɓangǝ u toɓǝ nyitǝmmi tthǝ u yinna lǝ ya thǝb bǝi. <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />Ɓa thǝb yuu a kwɔ dǝna dǝ nwongǝi ɓǝ, kwoi Fuh ǝrrǝulǝ i nwongǝi langkwoi ɓi ǝn ya shǝdǝ tthǝ nungkwɔ. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />Ən bǝ dǝba a langǝ i dang tthǝ ɗuǝnnu nungkwɔ dǝ ttha lǝ yiɓǝi ya kuglǝ kwɔ. Nungkwɔ ɓa ɓyǝa langkwoi ɓa ibǝi kwɔ to tthǝ i bǝ dǝba a langǝ i dang ɗuǝn Yeso; nungkwɔ du tthǝla ǝndǝi, manungkwɔ ɓǝ ǝndǝi dǝɓa ɓyǝa ɓǝ. <verse eid="ACT 3:16" /><verse number="17" style="v" sid="ACT 3:17" />&lt;&lt;Langwkoi la kwɔ, ya youngǝm, ǝn ibǝi nungkwɔ ɓǝ i yakku ɓǝ tolǝ Yeso kwɔ ɓa to ibǝ ibǝi ɓǝ lǝu. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />Fuh gei lakuu nwa ya gei ba a tthasi ǝndǝi angǝ Kristi gi a tangzuii; langkwoi u to nung ɓǝ wuu ǝǝ manung ɓǝ lalangǝ i nunglǝi kwɔ. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />Ɓa mǝrrǝm lo nyi ɓǝ ɓa al nung a ɓko ɓǝ lǝtǝ, yang, langkwoi ɓa mǝrrǝm sua Fuh, yang bǝ u al nung a ɓko ɓǝ lǝtǝ. Nǝɓa to, <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />lona ttha ɓyang a wɔ tthǝ Dangbang, langkwoi u tum Yeso, yuu a kwɔ lǝ Kristi kwɔ u osi u mko ɓǝ tthǝ ɓǝ. <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />U ǝǝ wayi nǝ lona wɔ kwɔ nung ǝndǝi i mab lafuu ɗǝ, manungkwɔ Fuh gei nwa ya gei ba a tthasi gu a langǝ i la kuu ɓǝ. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />Bakwɔ Musa gei angǝ, &lt;Dangbang Fuh ɓǝ a ǝrrlǝ ya gei ba a tthasi, manung akwɔ u tummǝm ɓǝ, dang yayuu ɓǝ. Ɓa tonungto i nungkwɔ ǝndǝi u gei angǝ ɓa toɓǝ. <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />Yuu a kwɔ nǝ tonungto i nungkwɔ ya gei ba a tthasi gei lǝu yang i gabbu lǝtha i yayuu gi Fuh lǝ i thǝu.&gt; <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />&lt;&lt;Lalangǝ i, ya gei ba a tthasi ǝndǝi baipiu i Samaila, i ya kwɔ wuo suo kwɔ, lang ɓǝ gei nwa ba nungkwɔ dǝna tonung dǝɓa lǝ kwɔ ɓǝ. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />Ganglang Fuh nwa ya gei ba a tthasi gu ǝn a ɓǝ, langkwoi yang ɓa tǝi nwa than ɓǝ nung zuu kwɔ Fuh lǝi i ya bǝba ɓǝɓa. Manung kwɔ u gei lǝ Ibrahim tthǝ ɓǝ, &lt;Tthǝ ya bǝpi ɓǝ mǝn khana lo yayuu ǝndǝi longwam.&gt; <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />Kwɔ Fuh ǝǝr lǝ thǝb gu, la nwasiu u tummu suaɓǝ yangbǝ u khana lo ɓǝ babǝ mǝrǝm nunglǝi a ɓkoɓǝ ɓǝ.&gt;&gt;<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">Bitrus I Yohanna Tthasi Yakuu Ya Yahudawa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />Bitrus i Yohanna yirrǝ dǝna gei balǝ yayuu kwɔ yakun dang ya nyǝknung, yikku ya ki kǝm nyǝknung, i yakun dang ya Sadukiyawa wɔ. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />Dang wai ɓanglǝ i ya nwatummi gi Yeso kwɔ rab kwɔ ba kwɔ dǝi nanatthǝ nung lǝ yayuu angǝ Yeso ǝrr i nwongǝi bǝ ɓuiɓua, kwɔ ǝǝ mangǝ kwamɓui yuu a ǝrr i nwongǝi. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />Nungkwɔ i mui tǝi tthǝb pursǝna har ibǝi kan, bakwɔ fuh owng ɓǝ. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />Kwoi yayuu kpatthǝ lǝ bagi dǝba a langǝ i tthǝ; lo yaɓǝi ɓǝ lilo tthǝmsob ɓua thǝmkun iu nu.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />I bǝi kan ya dǝ kab nwa nung ya Yahudawa, yakku, i ya nanatthǝ nung Musa gǝmtha Urshalima. <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />I kǝbtha i gong ya nyǝknung Annas i Kayafa, Yohanna, Iskandari, i yakun dang bǝpi gi Gong ya nyǝknung. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />I wulǝ ya nwatummi gi Yeso wuu dǝi tthasi i ɓibǝi angǝ, &lt;&lt;Ɓa to nungkwɔ nǝna? Ən ttha ɓǝɓa tǝi ko i ɗuǝn yittǝn ɓa tolǝ nungto kwa?&gt;&gt;<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />Nungkwɔ Bitrus kwɔ Ɓyang a Langǝ i tthǝu lǝ nikwɔ, gwabǝi nwa angǝ, &lt;&lt;Ya dǝkab nwanung i yakuu yayuu: <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />Nǝ dǝnni ɓib ɓi ɗiggǝ kwɔ lǝ ba nung a langǝ i kwɔ i tolǝ ya kuglǝ kwɔ tthǝ kwɔ tǝi tthǝ la kwɔ, <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />yang ɓǝ ǝndǝi ɓa ibǝi, langkwoi ya Israila ǝndǝi ibǝi, yiɓǝi kwɔ dǝi bǝikwɔ tthasi ɓǝ kwɔ tǝi tthǝla ǝndǝi kwɔ i ttha dang ɗuǝn Yeso ya Nazarat- kwɔ ɓa piu kwɔ langkwoi Fuh ǝrrǝulǝ i nwongǝi ɓǝ. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />Yeso lǝ yuu a kwɔ nungvullǝ bagi Fuh gei balo angǝ:</para>
  <para style="q1" vid="ACT 4:11">&lt;Tal kwɔ ɓǝ ya mainung la kwɔ</para>
  <para style="q1" vid="ACT 4:11">mǝrrǝm lǝ tal a langǝ i ǝndǝi dang tal ɓǝ.&gt; <verse eid="ACT 4:11" /><verse number="12" style="v" sid="ACT 4:12" />I tǝi bǝ soblo tthǝ nung a ɓko tthǝu lǝ ɓuo; ba kwɔ ɗuǝn a kun yangǝu longwam kwɔ i dǝlǝ yayuu ǝndǝi kwɔ ɓi tǝilǝ nwongǝi ɓǝu.&gt;&gt; <verse eid="ACT 4:12" /><verse number="13" style="v" sid="ACT 4:13" />Kwɔ yakku ɓǝ ɓyǝa tthǝ nyimmi gi Bitrus i Yohanna langkwoi i ibǝi i than nung lǝu, i ǝn yayuu a nǝkwam, loi fǝm langkwoi i gei angǝ yayuu kwɔ i suatha i Yeso. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />Kwoi kwɔ nung a kun yangǝu i ɓuan i geiu, ba kwɔ i ɓyǝa yiɓǝi kwɔ tǝi tthǝla kwɔ dǝi bǝilǝ i Bitrus i Yohanna. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />Nungkwɔ i gei Bitrus i Yohanna angǝ i pa dang kǝm yakku lǝ, langkwoi ǝrr i baipi bǝ gei ɓuai lǝ. <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />I ɓib angǝ,&lt;&lt;Ən ɓǝttǝn ɓito i yaɓǝi kwa?&gt;&gt; Yayuu ǝndǝi Urshalima ibǝi angǝ nung fǝmlo angǝ a kwɔ ǝn i i to, langkwoi ɓi ɓuan ɓi yǝrrǝu. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />Kwoi yang bǝ ɓi ta sua ɓi ka lǝ ba kwɔ bǝ yǝbbu dang yayuu thǝ, ɓi gub ɗuogsui yaɓǝi kwɔ bǝ i gei ba lǝ yuu a kun dang ɗuǝn Yeso thǝ.&gt;&gt;<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />Nungkwɔ i lubǝi i kwoi i tǝ dang kǝm ɓǝ i gei angǝ bǝ i gei ba ko i nanatthǝ nung dang ɗuǝn Yeso thǝ. <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />Kwoi Bitrus i Yohanna gwabǝi nwa angǝ, &lt;&lt;Ɓǝ i naɓǝ ɓa to kwan anwɔ lǝ nung a langǝ i nung Fuh lǝ ɓi to nungto i baɓǝ na ko a bǝ Fuh. <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />Ba kwɔ ɓi ɓuan ɓi yitthǝ bǝ gei ba lo nungkwɔ ɓi i naɓi ɓi ɓyǝa langkwoi ɓi lǝ ɓǝu.&gt;&gt; <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />Nungkwɔ yakku gub ɗuogsui natthǝ nyimtthǝ nung kwɔ yǝrri nwa. Yakku ɓǝ ɓyǝa tthang ɗing kwɔ i laggǝi ɓǝ, ba kwɔ yayuu ǝndǝi dǝna kha Fuh lǝ ba nung kwɔ tonung ɓǝ. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />Yiɓǝi kwɔ i to nung fǝmlo tthǝu lǝ kwɔ pa ttha thǝm rabbǝng.<verse eid="ACT 4:22" /></para>
  <para style="s">Ya Dǝba Alangǝ i Tthǝ Fuh Pinwa Ba Nyi Nyimmi</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />Dang tthǝ ni kwɔ i yǝrnwa lǝ Bitrus i Yohanna ni, i kwoi i tǝsua yayuu gi tǝi gei nung kwɔ gong ya nyǝknung i yakku gei tthǝ ɓǝ. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />Kwɔ ya dǝba a langǝ i tthǝ Fuh lǝ nung kwɔ, i kǝbtha i ǝrrlǝ yolli dang bǝ pinwa tthǝ Fuh angǝ: &lt;&lt;Yuu gwoi yuu a kwɔ mab wayi i pangsua, i nwam i nung kwɔ dang ǝu ǝndǝi ɓǝ! <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />A gei ba i Ɓyang a Langǝ i nwa thǝb mǝ, daa ɓi Dkoda angǝ:</para>
  <para style="q1" vid="ACT 4:25">&lt;&lt; Ən baɓǝ bǝ dang wa yakwɔ ǝnya Yahudawa lǝu kwɔ ɓanglǝ;</para>
  <para style="q1" vid="ACT 4:25">langkwoi yayuu to nung a nǝkwam?<verse eid="ACT 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 4:26" />Ya yigwoi longwam</para>
  <para style="q1" vid="ACT 4:26">lǝi bǝdǝi gi,</para>
  <para style="q1" vid="ACT 4:26">ya dǝ kab nwa nung gǝmtha</para>
  <para style="q1" vid="ACT 4:26">lo Dangbang i Kristi gu.&gt; <verse eid="ACT 4:26" /><verse number="27" style="v" sid="ACT 4:27" />Lalangǝ i Hiridus i Bilatus Babunte kǝbtha gwoi angǝ a kwɔ i ǝn ya ya Yahudawa lǝu kwɔ i ya Israila lo Yeso, ya Thǝb mǝ a langǝ i, yuu a kwɔ a mko lǝ Kristi ɓǝ. <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />I gǝmtha yang bǝ i to nung ǝndǝi kwɔ ttha mǝ i bǝ yiɗi mǝ yiɗi la nungsi angǝ a totthǝ ɓǝ. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />Langkwoi la kwɔ, Dangbang, a ɓyǝa yurrǝ gi, a yi ɓi, ya thǝb mǝ, ɓi gei bamǝ i tthǝnyimmi ǝndǝi. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />Juan namǝ yang bǝ a dǝ tthǝla, langkwoi dǝɓi nung ǝrr lǝ kiggǝ ɓi to nung fǝmlo dang ɗuǝn thǝb mǝ a langǝ i Yeso.&gt;&gt;<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />Kwɔ i alo bǝ pinwa, bǝi kwɔ i kǝbtha tthǝ kwɔ thǝuri. Ɓyang a Langǝ i gi Fuh wuo tǝ tthǝi nyimtthǝ i baipi bǝ gei ba Fuh i tthǝ nyimmi.<verse eid="ACT 4:31" /></para>
  <para style="s">Ya Dǝba A Langǝ i Tthǝ Fuh Gab Nungtǝi Gi Lǝtha</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />Ya dǝ ba a langǝ i tthǝ Fuh ǝndǝi bǝ nhǝm bagi kun dang nyiǝ kun. Yakun yangǝu dang ǝi angǝ nung a kwɔ ǝn a bǝi kwɔ yangǝu, kwoi dǝnni gab nung kwɔ i tǝi ǝndǝi lǝ tha. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />I gong ttha ya nwatummi gi Yeso gei lǝ yayuu tthǝ ba bǝ ǝrr gi Dangbang Yeso, langkwoi Fuh khana loi ghaatthǝ i ǝndǝi. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />Yuu a kun yangǝu dang ǝi lǝ kwɔ dǝna yiɗi nung tǝi lǝu ɓǝ. Ya kwɔ tthǝ i nungpangbǝi i gwoi i ɗyǝab, yang i wulǝ nungkurɓǝ kwɔ i tǝi tthǝ nungɗyǝabi ɓǝ. <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />Yang wulǝ wuu dǝlǝ ya nwatummi gi Yeso; langkwoi i gab nungkurɓǝ ɓǝlǝ yayuu tthǝ ko ǝn ya ǝndǝi manungkwɔ dǝna yiɗi ɓǝ. <verse eid="ACT 4:35" /><verse number="36" style="v" sid="ACT 4:36" />Yusufu, ya Lawiye kwɔ i siu Kubrus, kwɔ ya nwatummi gi Yeso dǝna lu angǝ Barnabas (nung ɓǝlǝ yui ya dǝ tthǝnyimmi), <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />ɗiɛb nungpangbǝi gu, nung kwɔ u wulǝ nungkurɓǝ ɓǝ, u dǝlǝ ya nwatummi gi Yeso.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s1">Hananiya I Safaratu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />Kwoi yiɓǝi a kun tthǝ ɗuǝnnu ǝn Hananiya, i bǝ ibǝi gi siu Safaratu i ɗyǝab nung pangbǝi gi. <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />Kwoi i kǝb loi lǝ tha i siu u pyǝa nung a kun dang nungkurɓǝ ɓǝ nung kwɔ u dǝ suo lǝ ya nwatummi gi Yeso. <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />Bitrus geiu angǝ, &lt;&lt;Hananiya, ǝn baɓǝ bǝ a yi Mungkulum tǝ dang nyimǝ a kǝb pǝlǝ lǝ Ɓyang a Langǝ i tthǝ kwɔ a pyǝa nung a kun dang nungkurɓǝ kwɔ a ɗyǝab lǝ pangsua mǝ ɓa? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />Bǝ nwuni a ɗyǝap pangsua mǝ, ǝn amǝ; langkwoi tthasua kwɔ a ɗyǝab kwɔ nungkurɓǝ ɓǝng amǝ. Baɓǝ, yang, a gwab a to nung manungkwɔ ni? A kǝb pǝlǝ lǝ ǝn yuu tthǝ lǝu- a kǝb pǝlǝ lǝng Fuh tthǝ!&gt;&gt;<verse eid="ACT 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 5:5" />Dangtthǝ Hananiya lǝ nung kwɔ ni, u owh pangsua u ɓui; langkwoi ya kwɔ lǝ nung kwɔ tthǝi survulli ghaatthǝ. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />Ya baittha wuo, kuluam kwamɓuiu, lǝiu i ilǝ,tǝi suu.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />Natthǝ gɓag lona tai natthǝ siu, ibǝi nung kwɔ tonung ɓǝ lǝu, wuo. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />Bitrus ɓibbu angǝ, &lt;&lt;A geimtthǝ, nungkurɓǝ kwɔ nung ɓǝlǝ nungkurɓǝ kwɔ mǝ i ɓǝi mǝ ɓa muo tthǝ pangsua ɓǝɓa?</para>
  <para style="p" vid="ACT 5:8">U gwab nwa angǝ, &lt;&lt;Əh, nung ɓǝ ǝndǝi&gt;&gt;<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />Nung kwɔ Bitrus geiu angǝ, &lt;&lt;Ən baɓǝ bǝ mǝ i ɓǝimǝ ɓa gwab dǝɓa kǝb pǝllǝ lo Ɓyang gi Dangbang? Yaɓǝi kwɔ suu ɓǝimǝ kwɔ lakwɔ nwakǝm, langkwoi i lǝi i ilǝ lang ɓǝ!&gt;&gt; <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />Ba a nwaɓi kwɔni yang u owh pangsua tthasiu u ɓui, ya baittha wuu ɓyǝa u ɓuing nung kwɔ i lǝiu i ilǝ gwam tǝi suu tthang ɓǝiu. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />Ya kǝm pinwa ɓǝ ǝndǝi i ya kwɔ lǝ nung kwɔ tthǝi survulli ghaatthǝ.<verse eid="ACT 5:11" /></para>
  <para style="s">Nungfǝmlo I Nungdǝ Vulli Kwɔ Tonungɓǝ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />Ya nwatummi gi Yeso to nung fǝmlo i nung dǝ vulli kpaatthǝ dang yayuu lǝ. Ya dǝ ba a langǝ i ǝndǝi kǝbtha dang yui kǝm gi Sulǝimanu. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />Yuu a kun yangǝu gwam lǝ kwɔ ɓuan kǝbtha lo i ilǝ ɓǝ, yayuu dǝna gei nung a langǝ i loilǝ kwoi i kǝbtha lo i ilǝ lǝu. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />Kwoi yayuu ǝǝ nwa bǝ li lo vii ǝn dǝi dang ya nwatummi lǝ- kon yaɓǝi i yasi kwɔ dǝba a langǝ i tthǝ Dangbang ɓǝ. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />Lǝba nung kwɔ ya nwatummi gi Yeso dǝna to kwɔ, dǝnni ee yayuu kwɔ tthǝi lko kwɔ dǝnni wulǝ nwa lǝi i ji lo nunglo i lo gǝi yang bǝ killǝng Bitrus wuo pa lo ya kun gi kwɔ dǝnnu paɓǝ. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />Langkwoi kon yayuu dǝna ǝrr gwoi angǝ a kwɔ kwar Urshalima kwɔ, dǝna wulǝ ya kwɔ tthǝi lko ko ɓyang a ɓko tthǝilǝ; langkwoi i tǝi tthǝla ǝndǝi.<verse eid="ACT 5:16" /></para>
  <para style="s">I Dǝzuii Lǝ Ya Nwatummi Gi Yeso</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />Ərr Gong ya Nyǝknung i ya ǝnthǝu, ya kwɔ lǝ ya Sadukiyawa kwɔ, dǝi to dasi ghaatthǝ i ya nwatummi gi Yeso; nung kwɔ i lǝi nung lǝi a kun la ɓko loi lǝ. <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />I muo ya nwatummi gi Yeso i tǝilǝ pursǝna kwɔ dǝi tthǝb yayuu tthǝ ɓǝ. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />Kwoi nungviilǝ kullo ya nwatummi gi Dangbang ɓko nwakǝm pursǝna ɓǝ, ilǝ ya nwatummi ɓǝ, nung kwɔ u gei angǝ, <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />&lt;&lt;Ɓatǝ tǝɓa dǝi dang kǝm nyǝknung, ɓa gei lǝ yayuu tthǝ ǝndǝi lǝba nwongǝi afu kwɔ.&gt;&gt; <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />Ya nwatummi ɓǝ gwab, nungwoi ɗǝng i tǝ kǝm nyǝknung i baipi bǝ nanatthǝnung. Gong ya nyǝknung i ya ǝntthǝu lubǝ yakku ya Yahudawa wui gǝmtha ba bǝ gei nwa gwoi angǝ a; ǝrr i tumbǝi pursǝna tǝi wulǝ ya nwatummi gi Yeso lǝ tthasiǝ. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />Kwoi kwɔ ya kinung wuo, i tǝi ya nwatummi dang pursǝna lǝu, nung kwɔ i kwoi i tǝsua yakku tǝi gei tthǝ, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />Kwɔ ɓi tǝ nwa kǝm pursǝna ɓǝ, ɓi tǝi lǝnlam nyimtthǝ langkwoi ya kinung kwɔ da ki kwɔ dǝna ki; kwoi kwɔ ɓi ɓko nwa kǝm ɓǝ, ɓi tǝi yuu a kun dang ǝu lǝu!&gt;&gt; <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />Kwɔ yikku ya nyǝknung i yikku ya ki kǝm nyǝknung lǝ nung kwɔ, tthǝi survulli dǝi nhǝm angǝ ǝnɓǝ to ya nwatummi gi Yesoɔ.<verse eid="ACT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 5:25" />Ərr yiɓǝi a kun wuu dang kǝm ɓǝ wuu gei angǝ, &lt;&lt;Ɓalǝ! Yaɓǝi kwɔ ɓa tthǝb pursǝna kwɔ dang kǝm nyǝknung dǝnni nanatthǝnung lǝ yayuu!&gt;&gt; <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />Nung kwɔ ya kinung ɓǝ pa i yayuu gu pa tǝi kwoi lǝ ya nwatummi ɓǝ. I toi lǝ ttha lǝu ba kwɔ dǝnni survulli angǝ lko yayuu a wai i tal.<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />I wulǝ ya nwatummi lǝ dang kǝm ɓǝ, i gei dǝi tthasi yakku, nung kwɔ Gong ya Nyǝknung ɓibǝi ba. <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />U gei angǝ; &lt;&lt;Ɓi gub ɗuogsui ɓǝ nyimtthǝ ɓingǝ bǝɓa nanatthǝnung dang ɗuǝn yiɓǝi kwɔ thǝ, kwoi ɓa ɓyǝa nung kwɔ ɓa toɓǝ! Ɓa yǝb bǝ nanatthǝ nung ɓǝ dang Urshalima ǝndǝi, langkwoi dǝɓa yiɗi bǝ yǝr ɓua gu ɓa dǝ loɓi!&gt;&gt;<verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />Bitrus i sua ya nwatummi gi Yeso gwab nwa angǝ, &lt;&lt;Ɓi tonungto i bagi Fuh, ǝn a bǝ yayuu lǝu. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />Fuh ya bǝba ɓi ǝrr lǝ Yeso i nwongǝi dang bǝ ɓuiɓua, tthasua kwɔ ɓa thǝu ibǝ piu lo kab gangǝ i ɓǝ. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />Fuh ǝrrǝu lǝ tǝlǝ lo nko a nali lǝ ya dǝkab nwa nung i ya Nwong lo, yang bǝ u dǝ bǝ mǝrrǝm lo nyi i bǝ al nung a ɓko ya Israila lǝtǝ. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />Ɓi ɓyǝa nung kwɔ ǝndǝi i nung ɓing ɓi i Ɓyang a Langǝ i, u kwɔ lǝ nung dǝ gi Fuh lǝ ya kwɔ dǝna tonungto i bagu ɓǝ.&gt;&gt;<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />Kwɔ yakku ɓǝlǝ nung kwɔ, dang wai ɓanglǝ ghaatthǝ dǝnni yiɗi bǝ thǝb ya nwatummi gi Yeso ɓǝ. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />Kwoi yuu a kun dang ǝi, ya Farisiyawa ɗuǝnnu ǝn Gamaniyal, u ǝn ya nanatthǝ nungzuu gi Musa langkwoi yayuu ǝndǝi dǝna du ghaali ɗing, u dǝi nǝbo tthasi yakku. U dǝba angǝ i ilǝ ya nwatummi lǝ gwam natthǝ tuab ɗǝ, <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />Ərr u gei balǝ yakku angǝ, &lt;&lt;Ya youngǝm ya Israila, ɓato kiggǝ lo nung kwɔ dǝɓa yiɗi bǝ tolǝ yaɓǝi kwɔ ɓǝ. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />Ɓa nhǝm Tudas fuk lona a kun ttha sua lǝ, dǝnnu lǝi lo angǝ i ǝn yuu a kun ghaatthǝ, langkwoi yaɓǝi kǝn tthǝmsob ɓua rab muo suo. Kwoi i thǝu, ya muo suo ǝndǝi yǝbtha, nung kwɔ dǝu yiɗi bǝ tou kwɔ tthǝm nǝkwam. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />Tthasua nung kwɔ, Yahuda ya Galili fuk lona bǝ than lo; u ee kon yayuu suko lǝ, kwoi i thǝu lang ɓǝ, langkwoi ya muo suo ǝndǝi yǝbtha. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />Manungkwɔni dang kwan kwɔ yang, Ən gei ɓǝ tthǝ, bǝɓa to nung a kun lǝ yaɓǝi kwɔ thǝ. Ɓayii nǝkwam! Nǝ nung kwɔ i mab zuiu kwɔ i to kwɔ nǝ ǝn a bǝ yuu, a lǝnla, <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />kwoi nǝ tthǝng bǝgǝ Fuh, yang ɓa ɓuan ɓa pǝl ttha i yaɓǝi kwɔu. Yang ɓa tǝi lo ɓǝ dǝɓa ɓuob vǝm i Fuh lǝ!&gt;&gt; Yakku gwab ba gi Gamaniyal. <verse eid="ACT 5:39" /><verse number="40" style="v" sid="ACT 5:40" />I lubǝ ya nwatummi i tǝlǝ dang kǝm, i ɓuoi i thab, i ji ba angǝ bǝ i gei ba dang ɗuǝn Yeso thǝ; langkwoi yang i yǝrri nwa. <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />Kwɔ ya nwatummi pa tthang yakku, tthǝi la ǝndǝi, ba kwɔ Fuh thani lǝ ya kwɔ natthǝng kwɔ i lǝ tthǝzi i tthǝkku lǝ ba Yeso ɓǝ. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />Langkwoi vii ǝndǝi dang kǝm nyǝknung i gwoi yayuu i ǝǝ nwa bǝ nanatthǝnung i bǝ gei nwa ba a langǝ i gi Yeso kwɔ lǝ Kristi ɓǝ.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">Bǝ Mko Ya Nwongbǝi Nannairǝ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />Lona lǝ kullo, kwɔ lo ya nanungto ǝǝ nwa bǝ lilo, buogbǝi ǝrr ganglang ya Yahudawa kwɔ dǝna gei nwa Helinawa i ya Yahudawa ya losua dǝna gei angǝ i nhǝm ya siɓui gilǝu. Ya Yahudawa kwɔ dǝna gei Helinawa kwɔ gei angǝ i nhǝm ya siɓui gi lǝu vii ǝndǝi babǝ gab nungtang. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />Nung kwɔ ya nwatummi gi Yeso kwɔ sob iu rab kwɔ lubǝ ya dǝba a langǝ i wuo gǝmtha nung kwɔ i gei angǝ, &lt;&lt;Ən lozuiiu kwɔ ɓi yi tthǝ ba Fuh yang bǝ ɓi to ba bǝ gab nungtang i nungkurɓǝ ɓǝ lǝu. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />Ya ǝnthǝ, ɓa mko yayuu nanairǝ dang ɓǝ kwɔ tthǝ i Ɓyang a Langǝ i i yiggǝi ni ɓǝ, yang ɓi ji lo ba kwɔ. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />Ɓi i naɓi ɓi dǝ kiggǝ ɓi tthǝ bǝ pinwa i bǝ gei ba Fuh.<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />Yayuu ǝndǝi lǝ tthǝla nung kwɔ ya nwatummi kwɔ wulǝ ɓǝ, nung kwɔ i mko Istifanus, yiɓǝi ya dǝba a langǝ i i Ɓyang a Langǝ i, i Filibus, Burokoras, Nikanar, Timan, Barminas, i Nikolas, yuu a kwɔ ǝn ya Yahudawa lǝu ɓǝ ǝrr Antakiya yuu a kwɔ la nwasiu mǝrrǝm dǝna wab nung ya Yahudawa ɓǝ. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />Yayuu ji lǝ ya nwatummi, kwɔ pinwa langkwoi dǝna loi lǝ.<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />Langkwoi nung kwɔ ba gi Fuh logbǝi kwɔ ǝndǝi. Lo ya nanungto dang Urshalima dǝna ghaa langkwoi ghaatthǝ, langkwoi ya nyǝknung kpaatthǝ muo bǝ dǝba a langǝ i.<verse eid="ACT 6:7" /></para>
  <para style="s">I Muo Istifanus</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />Istifanas, ǝn yiɓǝi kwɔ Fuh khana lolǝ langkwoi u i ttha ghaatthǝ, u to nung fǝmlo ghaatthǝ dang yayuu lǝ. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />Kwoi yaɓǝi a kun kwɔ lǝ ya kǝm Fuh yaɓǝi ya thǝb kwɔ i yii na kwɔ (manung a kwɔ dǝi lu ɓǝ), kwɔ ya Yahudawa ya kuraniyawa i Iskandayawa ɓǝ. I i ya Yahudawa a kun kwɔ losua Kilikiya i Asiya baipi bǝ nyim tha nwa i Istifanas. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />Kwoi ɓyang a langǝ i dǝ yiggǝi lǝ Istifanas kwɔ nǝ u gei ba, yang i ɓuan i yǝr nwko ɓǝ.<verse eid="ACT 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 6:11" />Nung kwɔ i dǝ nungkurɓǝ lǝ yaɓǝi a kun angǝ i gei angǝ, &lt;&lt;Ɓi lǝ Istifanas dǝna gei ba a ɓko tthǝ Musa i tthǝ Fuh.&gt;&gt; <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />Nung kwɔ manungkwɔni i fog yayuu, yakuu, i ya nanatthǝnung gi Musa. I muo Istifanas nung kwɔ i tǝu lǝ tthasi ya dǝkab nwanung. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />Yang i wulǝ yaɓǝi a kun yang bǝ wui kǝb pǝllǝ lolǝ. I gei angǝ,&lt;&lt;Yiɓǝi kwɔ, vii ǝndǝi dǝna gei ba tthǝ kǝm nyǝknung kwɔ i nungzuu gi Musa. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />Ɓi lǝiu u gei angǝ Yeso ya Nazarat kwɔ a dǝr kǝm nyǝknung langkwoi a prǝm nung lǝi kwɔ Musa dǝɓi ɓǝ!&gt;&gt;<verse eid="ACT 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 6:15" />Yakku kwɔ ǝǝ bǝi lǝ kwɔ dǝ nungǝi tthǝ Istifanas kwɔ i ɓyǝa dang nungǝu mangǝn dang nung ya nwatummi gi Fuh.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">Ba Gi Istifanu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />Yang Gong ya nyǝknung ɓib Istifanus angǝ, &lt;&lt;Ən ba a langǝ i?&gt;&gt;<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />Istifanus gwab nwa angǝ, &lt;&lt;Ya young i Ya daa, ɓa lǝm! Nwuni bǝ bǝba ɓi Ibrahim patǝ logwoi Haran, Fuh ya angǝ a fuk tthǝu Bagadaza <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />langkwoi gei angǝ, &lt;A yitthǝ yayuu mǝ i losua mǝ a tǝ pangsua kwɔ mǝn ta natthǝ ɓǝ.&gt; <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />Langkwoi nung kwɔ Ibrahim yi tthǝ losua gu patǝ logwoi Haran. Tthasua kwɔ daa gu ɓui, Fuh geiu angǝ u tǝn u wuo pangsua kwɔ ɓa ǝǝ tthǝ la kwɔ ɓǝ. <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />Vii lǝ kullo Fuh dǝ kwǝnwa pangsua ɓǝlǝ Ibrahim lǝ abo lǝu, ko bo kun pangsua lǝ, kwoi Fuh gwabbu nwa angǝ i du, langkwoi a ǝǝ lǝ abo i a bǝ ya bǝpi gu. Lona lǝ kullo Fuh gwab nwa lǝ Ibrahim kwɔ, u i yangǝu i yathangǝu. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />Nung kwɔ lǝ nung kwɔ Fuh geiu tthǝ ɓǝ: &lt;Ya bǝpi mǝ a ǝǝ losua yayol, bǝilǝ kwɔ i toi lǝ thǝb ttha thǝm sob ɓua rab. <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />Kwoi ɓang Fuh mǝn ɗablua losua kwɔ toi lǝ thǝb ɓǝ, tthasuko lǝ ya bǝpi mǝ a i losua lǝ kullo yang wui wabbǝm bǝi kwɔ.&gt; <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />Yang Fuh dǝ ganglang gu i Ibrahim babǝ ɓǝr nwa ɗuǝ. Nung kwɔ Ibrahim ɓǝrnwa ɗuǝ Ishaku dang bo ǝngunai kwɔ i siu ɓǝ; Ishaku ɓǝrnwa ɗuǝ yuiu Yakubu, langkwoi Yakubu ɓǝrnwa ɗuǝ yathang gu sob iu rab, ya daa ɓi ya Israila a nwasiu.<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />Yathang Yakubu dǝna tthǝng youngǝi Yusufu nung kwɔ i ɗyǝabbu lǝ thǝb na ya Masar. Kwoi Fuh i u lǝ <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />langkwoi kwoi u lǝ latthǝ dang zuii gu ǝndǝi. Kwɔ Yusufu fuk tthasi yigwoi ya Masar lǝ, Fuh ɓko nunglǝi tthǝ i yiggǝi Firkona yiɗiu, langkwoi yigwoi mǝrrǝmu lǝ Gwamnǝ losua i gwoi yigwoi. <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />Yang gwom o losua Masar i Kanana ǝndǝi, kwɔ wulǝ zuii ghaatthǝ. Ya bǝba ɓi ɓuan tǝi nungtang lǝu ko a tuab, <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />langkwoi kwɔ Yakubu lǝ angǝ nungmin tthǝ Masar, u tum yathang gu, ya bǝba ɓi, nung ɓǝlǝ nwasi bǝ tǝ gi Masar bǝ ɗyǝab nungtang. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />Bǝ wuo gi a nung rab tthǝu Yusufu pyǝa lo lǝ ya youngǝu lǝu, nung kwɔ yigwoi ya Masar i bǝi ya young gi Yusufu. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />Nung kwɔ Yusufu tumbǝi tthǝ daa gu Yakubu, u i ya dang woi gi ǝndǝi, yayuu thǝm tai oli ǝndǝi, angǝ i tǝ Masar. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />Yang Yakubu ǝrr tǝ Masar, bǝi lǝ kwɔ u i yathang gu ɓui tthǝ. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />I ee kwamɓui i tǝlǝ Shekem, bǝi lǝ kwɔ i suui tthǝ dang ɓua juǝn kwɔ Ibrahim ɗyǝab na ya nwakong gi Hamor i nungkurɓǝ ɓǝ. <verse eid="ACT 7:16" /><verse number="17" style="v" sid="ACT 7:17" />Kwɔ lona gbag kwɔ Fuh dǝ bǝ gwab nwa ganglang gu i Ibrahim, lo yayuu ɓi Masar lilo ghaatthǝ. <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />Nǝsua ǝndǝi yigwoi kwɔ i Yusufu lǝu kwɔ lo yigwoi Masar. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />U ɗam ya bǝba ɓi langkwoi u ɗab luai ɓko tthǝ, u toilǝ ttha i ilǝ yathang a ɓuoi gwoi gi i a lǝtǝ yang bǝ i ɓui. <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />Ən u lona ɓǝ kwɔ nung kwɔ i si Musa, u ǝn yui a nǝkwam lǝu, u dang gwoi daa gu fih tai dǝnni dǝ nung tthǝu, <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />kwɔ i iu lǝ gwam tǝi pyǝa nwa dual, yui yigwoi tǝiu nung kwɔ u lǝiu wuo tthko mangǝn yui dang wko. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />I nko natthǝ yiggǝi ya Masar ǝndǝi u mǝrrǝm lǝ gong yuu dang bǝ gei ba i nungto.<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />Kwɔ Musa kǝn ttha thǝm rab, u tǝ sua ya youngǝu yang bǝ u ibǝi zuii kwɔ ya youngǝu ya Israila da tang ɓǝ. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />U ɓyǝa yuu a kun dang ǝi dǝna tang zuii na ya Masar, nung kwɔ Musa tǝbǝ nwongǝu u voh lǝ youngǝu i bǝ thǝb ya Masar ɓǝ. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />(Musa nhǝm angǝ yayuu gi a ibǝi angǝ Fuh a to nung to i ilǝ a dǝ nwongǝi lǝ yayuu gi, kwoi i ibǝi lǝu.) <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />I bǝi kan u ɓyǝa ya Israila rab dǝna ɓuob vǝm, nung kwɔ dǝu yiɗi bǝ gab ganglangǝ i. U gei angǝ,&lt;Ɓalǝ, yaɓǝi, ɓǝ ǝn ya Israila ɓua ɓǝ; ǝn baɓǝ bǝ dǝɓa ɓuob vǝm ni?&gt;<verse eid="ACT 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 7:27" />Kwɔ yuu a kwɔ dǝna ɓuob yuu a kun ɓǝ ni kwɔ tuog Musa kwoilǝ gwukun. U ɓibbu angǝ,&lt;Ən yi da nungto dǝkab nwa nung i ya to kwan ganglang ɓi?&gt; <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />Dǝmma yiɗi bǝ thǝbem manung a kwɔ a thǝb yiɓǝi ya Masar kwɔ lali ɓa?&gt; <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />Kwɔ Musa lǝ nung kwɔ ni yang, u sur u yitthǝ Masar tǝu ǝǝ losua Madiyana. Bǝi lǝ kwɔ u si yathang a yiɓǝi rab.<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />&lt;&lt;Tthasua ttha thǝmrab pa, ya nwatummi gi Fuh fuk lǝ Musa tthǝ dang lyǝn lua kwɔ dǝna li dang gug dang losua a kwi gbag Tal Sinai ɓǝ. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />Musa ɓyǝa nung kwɔni tthǝu survulli tthǝ nung kwɔ dǝna tonung ɓǝ, u gbag yang bǝ u ɓyǝa nung kwɔ dǝna tonung ɓǝ. Kwoi u lǝ yol Dangbang gei angǝ: <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />&lt;Ɓang Fuh ya bǝba mǝ, Fuh gi Ibrahim, Ishaku i Yakubu. Tthǝ Musa dǝna ɓuob tthǝm i vulli lǝ u yiɗi bǝ lǝi loyi kwɔ u ɓyǝa bǝiɓǝ lǝu. <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />Dangbang geiu angǝ, &lt;A ilǝ ǝko mǝ, ba kwɔ bǝi kwɔ a dǝitthǝ kwɔ ǝn ɗǝgsi Fuh bǝi lǝ. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />Ən ɓyǝa zuii yayuu mǝng Masar. Ən lǝ bǝ groangǝ i giǝng, ǝn pin sua bǝ nwongǝi. A wuo la kwɔ mǝn tumma Masar.&gt;<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />I ɓib angǝ, &lt;&lt; Musa ɓǝ kwɔ ya Israila laɓǝ. &lt;Ənyi mabba lǝya dǝkab nwa nung i ya to kwan lo ɓi?&gt;&gt;U lǝ yuu a kwɔ Fuh tum lǝ yikku lo ya Israila langkwoi u nwongǝi i ya nwatummi gi Fuh kwɔ fukgǝu tthǝ dang gug kwɔ lua dǝna li ɓǝ. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />U osi lǝ ya Israila u ilǝ Masar, dǝu to nung fǝmlo i nung dǝ vulli dang Masar langkwoi nwa nwam a thǝnni langkwoi ttha thǝmrab dang losua a kwi. <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />Ən u Musa ɓǝ kwɔ gei ya Israila angǝ, &lt;Fuh a tum ɓǝ bǝi tthǝ i ya gei ba a tthasi, manung a kwɔ u tummǝm ɓǝ, langkwoi a ǝǝ lǝ ǝn yuu a kun dang ɓǝ.&gt; <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />U lǝ yuu a kwɔ dang ya Israila losua a kwi ɓǝ; u i ya bǝba ɓi langkwoi i ya nwatummi gi Fuh kwɔ geiu ba lo tal Sinai ɓǝ, langkwoi u muo ba gi Fuh kwɔ dǝna dǝ nwongǝi ɓǝ yang bǝ u dǝɓi.<verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />&lt;&lt;Kwoi ya bǝba ɓi la bǝ tonungto i bagu; i lko dang nyiǝ dǝnni yiɗi kaso i kwoi i tǝ Masar. <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />Nung kwɔ i gei Haruna angǝ, &lt;A mab ɓi fuh a tuab tuab tthǝ kwɔ a o ɓi lǝ siɓǝ. Ɓi ibǝi nung kwɔ tǝi yiɓǝi kwɔ angǝ Musa ɓǝ lǝu, yuu a kwɔ i ɓilǝ Masar ɓǝ.&gt; <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />Ən lona lǝ kullo nung kwɔ i mab fuh kwɔ nwongǝi gu yangǝu ɓǝ mangǝn nyak, i nyǝknung tthǝ, i to ɓang bǝ dǝ angǝ a lǝ nung kwɔ i inai lǝ i mab ɓǝ. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />Nung kwɔ Fuh mǝrrǝm mual tai lǝ ji lǝ bǝ wab i vin dang wayi, manung a kwɔ i vullǝ dang nungvullǝ ya gei ba tthasi ɓǝ:</para>
  <para style="q1" vid="ACT 7:42">&lt;Ya Israila! Ɓa dǝlǝ ǝn ɓang lǝu</para>
  <para style="q2" vid="ACT 7:42">kwɔ ɓa vuu langkwoi ɓa nyǝk nungbyang</para>
  <para style="q2" vid="ACT 7:42">ttha tthǝm rab losua a kwi ɓǝ lǝu.<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />Ɓa lǝi ǝn tǝbbǝ fuh a tuab Molǝk,</para>
  <para style="q2" vid="ACT 7:43">langkwoi i killǝng Ramfan, fuh vin ɓǝ;</para>
  <para style="q2" vid="ACT 7:43">i ǝn fuh kwɔ ɓa mab yang bǝ ɓa wab ɓǝ.</para>
  <para style="q1" vid="ACT 7:43">Langkwoi nung kwɔ mǝn tuog ɓǝ losua a kun tu pǝl Babila.&gt;<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />&lt;&lt;Ya bǝba ɓi tthǝ i tǝbbǝ ɗǝgsi Fuh i ilǝ losua a kwi. I mab manung kwɔ Fuh gei lǝ Musa tthǝ angǝ u mab ɓǝ, manung a kwɔ Fuh tana tthǝ lǝ Musa ɓǝ. <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />Natthǝ, ya bǝba ɓi kwɔ muo tǝbbǝ ɓǝ na ya daa gi kwɔ i lǝi na i palǝ i Joshuwa nung kwɔ wui lǝi losua kwɔ Fuh nan ya losua ɓǝ kwɔ dǝi gbag bǝiɓǝ ɓǝ. Langkwoi tǝbǝ ɓǝ ǝǝ bǝilǝ tǝlǝ lona gi Dkoda. <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />Fuh tou nung a langǝ i tthǝ nung kwɔ u ɗyǝabu angǝ i mab bǝ ǝǝ lǝ Fuh gi Yakubu tthǝ. <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />Kwoi ǝn Sulǝmanu nung kwɔ maiu gwoi tthǝ.<verse eid="ACT 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48" />Kwoi Fuh Ya Angã ya wayi logwoi dang gwoi a kwɔ i mai i na yayuu; manung kwɔ ya gei ba a tthasi gei ɓǝ:<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />Dangbang gei angǝ, &lt;Wayi lǝ bǝ loyigwoim,</para>
  <para style="q2" vid="ACT 7:49">langkwoi longwam bǝ dǝ bom.</para>
  <para style="q1" vid="ACT 7:49">Ən gwoi a ɓǝttǝn ɓa maim tthǝ?</para>
  <para style="q2" vid="ACT 7:49">Bǝi kwɔ mǝn ǝǝ tthǝ kwɔ pǝlla?<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />Ən ɓang ǝn mab i nung kwɔ ǝndǝi lǝu?<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />&lt;&lt; Lo a nyimmi ɓǝnni tthǝ ɓǝ lǝ tthǝ Fuh&gt;&gt;Istifanus lilo tthǝ gei angǝ. &lt;&lt;Lo nyi ɓǝ nyim nǝnǝ, ɓuasui ɓǝ lam nǝnǝ ni tthǝ ba Fuh! Ɓǝ mangǝn ya bǝba ɓǝ: ɓǝ lang ɓǝ vii ǝndǝi dǝɓa la Ɓyang a Langǝ i! <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />Ya gei ba a tthasi a kun tthǝ kwɔ ya bǝba ɓǝ du zuii lǝu ɓa? I thǝb ya nwatummi gi Fuh lang ɓǝ, kwɔ laku gei nwa bǝ wuo gi thǝb gu ya nung a langǝ i ɓǝ. Langkwoi la kwɔ ɓa ɓangǝu lǝ ɓa thǝu. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />Ən ɓǝ ɓa muo nung zuu gi Fuh, kwɔ ya nwatummi gu pin lǝ ɓǝ kwoi ɓa tolǝ nungto lǝu!&gt;&gt;<verse eid="ACT 7:53" /></para>
  <para style="s">Bǝ Wa Istifanu I Tal</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />Kwɔ yakku lǝ nung kwɔ, dang wai ɓanglǝ ghaatthǝ i tang nai i wurrǝ lǝ bagu. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />Kwoi Istifanus, kwɔ Ɓyang a Langǝ i tthǝu ni kwɔ, u lǝi lo yi u ɓyǝa lǝ wayi u ɓyǝa ghaali Fuh langkwoi Yeso dǝi lona a nali gi Fuh. <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />U gei angǝ,&lt;&lt;Ɓyǝa! Ən ɓyǝa wayi ɓko langkwoi Yui Yuu dǝ lona a nali gi Fuh!&gt;&gt;<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />Yakku ka ɓuasui i nalǝ i buogbǝi nyimtthǝ. Yang ǝrr i nuongǝu nwa kun, <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />I gubbu i ilǝ gwoi angǝ a lǝ, i wko i tal. Ya kwɔ wko kwɔ yitthǝ nunglitthǝ gi na baittha a kun ɗuǝnnu ǝn Shawulu. <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />I ǝǝ nwa bǝ wa Istifanu i tal u pinwa tthǝ Dangbang angǝ, &lt;&lt;Dangbang Yeso, a muo ɓyangǝm!&gt;&gt; <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />U bai nwalongǝu sua u tasui i yol ghaatthǝ angǝ, &lt;&lt;Dangbang! Ba nhǝm nung a ɓko kwɔ loi thǝ!&gt;&gt; Kwɔ u gei nung kwɔ ni yang u o sua u ɓui.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />Langkwoi Shawulu bǝilǝ gwab nwa angǝ i thǝb Istifanus.</para>
  <para style="s" vid="ACT 8:1">Shawulu Dǝ Zuii Lǝ Ya Kǝm Pinwa</para>
  <para style="p" vid="ACT 8:1">Villǝ kwɔ gong zuii owh lo ya kǝm pinwa kwɔ Urshalima ɓǝ, ya dǝba a langǝ i tthǝ Fuh ǝndǝi yǝbtha tǝ Yahudiya i Samariya ǝn ya nwatummi Yeso ɓuo ǝǝ. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />Ya wab Fuh lalangǝ i suu Istifanus i ǝǝ nwakǝm ɓua lǝ. <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />Kwoi Shawulu baipi bǝ dǝr kǝm pinwa. Dǝnnu tǝ gwoi gwoi, u gub yaɓǝi i yasi dǝnnu tthǝb pursǝnǝ.<verse eid="ACT 8:3" /></para>
  <para style="s">Filibus Gei Ba Alangǝ i Samariya</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />Ya dǝba a langǝ i kwɔ yǝbtha kwɔ gei ba a langǝ i bǝi kwɔ i tǝ tthǝ ǝndǝi. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />Filibus tǝ gwoi angǝ a a kun tthǝ dang Samariya tǝu gei ba Kristi lǝ yayuu kwɔ bǝilǝ ɓǝ. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />Kwɔ kon yayuu lǝ Filibus langkwoi ɓyǝa nung fǝmlo kwɔ dǝu to kwɔ, i kab ɓuasui tthǝ nung kwɔ dǝu gei ɓǝ. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />Waa a ɓilǝng i tthǝ yayuu kpaatthǝ i buogbǝi ghaatthǝ, ya kwɔ bǝi gi a kun ɓui lǝ ɓui i ya owh thko tǝi tthǝlla. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />Manungkwɔni yang tthǝlla tthǝ ghaatthǝ gwoi angǝ a ɓǝ lǝ.<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />Yiɓǝi a kun tthǝ ɗuǝnnu ǝn Siman ya ɓyǝa bǝi tuung kwɔ dǝu to nung pigwoi angǝ a lǝ langkwoi dǝu to nung fǝmlo lǝ ya Samariya tthǝ. Dǝu lǝi lo angǝ i ǝn yuu a kun ghaatthǝ, <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />langkwoi yayuu ǝndǝi gwoi angǝ a ɓǝ lǝ, ya angǝ a i ya tuab ǝndǝi, dǝna dǝ kiggǝ tthǝu langkwoi dǝnni gei angǝ,&lt;&lt;Yiɓǝi kwɔ tthǝ i ttha Fuh kwɔ dǝnni lu angǝ gong ttha ɓǝ.&gt;&gt; <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />Dǝi muo suo tuung ba kwɔ dǝu to nung fǝmlo i bǝ lam nungǝi i nungpi ɓǝ. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />Kwoi kwɔ i dǝba a langǝ i tthǝ ba gi Filibus ba kwɔ u gei ba a langǝ i bǝ loyigwoi gi Fuh tthǝ langkwoi i ɗuǝn Yeso Kristi, i wolli mung, yaɓǝi i yasi. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />Siman i nkolǝ dǝba a langǝ i tthǝ tthasua kwɔ i wolu mung. Langkwoi u muo sua Filibus bǝi kwɔ ǝndǝi, lo dǝna fǝm tthǝ gong nung fǝmlo kwɔ u ɓyǝa dǝu to ɓǝ.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />Kwɔ ya nwatummi dang Urshalima lǝ angǝ ya Samariya muo ba gi Fuhng, nung kwɔ i tum Bitrus i Yohanna suai. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />Kwɔ i wuo, i pinwa lǝ ya dǝba a langǝ i tthǝ yang bǝ i muo Ɓyang a Langǝ i, <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />Ba kwɔ Ɓyang a Langǝ i yirrǝ wuo lo yuu a kun dang ǝi lǝu ɓǝ; i wolli mung nǝkwam dang ɗuǝn Dangbang Yeso. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />Yang Bitrus i Yohanna dǝ nai loi lǝ, yang i muo Ɓyang a Langǝ i.<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />Kwɔ Siman ɓyǝa i dǝ Ɓyang a Langǝ i i bǝ dǝna lo ya nwatummi u dǝ nungkurɓǝ lǝ Bitrus i Yohanna <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />langkwoi u gei angǝ, &lt;&lt;Ɓa dǝm tthǝ lang ɓǝ yuu a kwɔ nǝ ǝn dǝna lo yang muo Ɓyang a Langǝ i.&gt;&gt; <verse eid="ACT 8:19" /><verse number="20" style="v" sid="ACT 8:20" />Bitrus gwab nwa angǝ: &lt;&lt;Kaso mǝ i nungkurɓǝ mǝ ɓa ɓui ɓatǝ kongɓua lua, ba kwɔ dǝmma nhǝm mangǝ lko ma ɗyǝab nung dǝ gi Fuh i nungkurɓǝ! <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />A yangǝu i nung ko nwathan dang nungto ɓiu, ba kwɔ dang nyimǝ mko tthasi Fuh. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />A mǝrrǝm a yi tthǝ nung a ɓko a pinwa tthǝ Dangbang. Lko u al nung a ɓko ba bǝ nhǝm ba ni dang wa mǝ. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />Ba kwɔ dǝm ɓyǝa dang wa mǝ yi tthǝ i bǝ yiɗi nung langkwoi mǝn ya pursǝnǝ gi nung a ɓko.&gt;&gt;<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />Yang Siman gwab nwa angǝ, &lt;&lt;Dǝm yam a pinwa tthǝ Dangbang lǝ bam yang bǝ nung yangǝu kwɔ a gei kwɔ tǝim thǝ.&gt;&gt;<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />Tthasua kwɔ i gei ba lǝ yayuu langkwoi ba gi Dangbang lǝ yayuu tthǝ, Bitrus i Yohanna kwoi suai tǝ Urshalima, dǝnni gei ba Fuh gwoi a tuab ya Samariya lǝ kpaatthǝ.<verse eid="ACT 8:25" /></para>
  <para style="s">Filibus I Ya Kwɔ I Mko Ɓǝ</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />La kwɔ ya nwatummi gi Dangbang wayi gei Filibus angǝ, &lt;&lt;A mab tthǝmǝ a tǝ ttha lasua i nung lǝi ɓǝ- nung lǝi losua a kwi- kwɔ ǝrr Urshalima tǝ Gaza ɓǝ.&gt;&gt; (Nung lǝi ɓǝ kwɔ mab i muo tthǝu) <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />Nung kwɔ Filibus baipi thko gu, lolǝi thko gu nung kwɔ u tǝi ya Itopiya kwɔ i mko ɓǝ, gong yikku kwɔ dǝna tonungto gwoi dugǝi yigwoi Kandakatu yisi ya Itopiya ɓǝ. Yiɓǝi kwɔ tǝbǝ wab Fuh Urshalima, <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />langkwoi lo lǝi kwɔ dǝu tǝ gwoi kwɔ u ǝǝ dang kǝkǝ prǝ gu dǝnnu than nung dang nungvullǝ Ishaya ya gei ba a tthasi. <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />Ɓyang a Langǝ i gei Filibus angǝ, &lt;&lt;A tǝ ta gbag tha i kǝkǝ prǝ kullo yang ta dǝi gbagǝu.&gt;&gt;<verse eid="ACT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 8:30" />Yang Filibus surdum tǝ tthang kǝkǝ prǝ langkwoi u lǝ yiɓǝi dǝna than nungvullǝ gi Ishaya. Filibus ɓibbu angǝ, &lt;&lt;A i bǝ nung kwɔ dǝmma than ɓǝng nhaa?&gt;&gt;<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />Daa ɓǝ gwab nwa angǝ,&lt;&lt;Mǝn tonǝnǝ mǝn i bǝi, &lt;&lt;nǝ yuu a kun than geim ba tthǝ loɗǝ?&gt;&gt; Nung kwɔ u lubǝ Filibus ɗab kǝkǝ prǝ ɓǝ wuu ǝǝ i u lǝ.<verse eid="ACT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 8:32" />Yiɓǝi ya Itopiya ɓǝ dǝna than nung kwɔ dang nung vullǝ manung kwɔ ni:</para>
  <para style="p" vid="ACT 8:32">&lt;&lt;I ou lǝ si mangǝn ɓangam,</para>
  <para style="q1" vid="ACT 8:32">kwɔ dǝi tǝbǝ vuu ɓǝ,</para>
  <para style="q2" vid="ACT 8:32">mangǝn yui ɓangam u tasui lǝu kwɔ dǝi kwa byangǝu ɓǝ,</para>
  <para style="q2" vid="ACT 8:32">manungɓǝni u ɓko nwuo lǝu.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />Dang zuii gu, i ɗyǝko i ba a langǝ i.</para>
  <para style="q2" vid="ACT 8:33">Ən ya gei ba ya bǝpi gu?</para>
  <para style="q2" vid="ACT 8:33">Ba kwɔ nwongǝi gu longwam wuu nwa ɓyǝnǝng.&gt;&gt;<verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />Yiɓǝi ya Itopiya ɓǝ ɓib Filibus angǝ, &lt;&lt;A geim tthǝ, dǝm yam, ya gei ba a tthasi kwɔ dǝna gei ǝn ba gi yittǝn, lo i nko lǝ ko ǝn yuu a kunna?&gt;&gt; <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />Yang Filibus baipiu i nung thanni dang nung vullǝ gi Fuh nung kwɔ u gei ba a langǝ i lǝ ba Yeso tthǝ. <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />Kwɔ dǝnni thko thko lo lǝi, i wuo bǝi kwɔ mungki tthǝ nung kwɔ yiɓǝi ya Itopiya ɓǝ gei angǝ, &lt;&lt;A ɓyǝa mungki kwɔ. Ən ɓǝ a tonung kwɔ yang a wollǝm mungǝu ɓa?&gt;&gt; <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />Filibus langkwoi geiu angǝ,&lt;&lt;Ma wol mung ǝn wol nǝ a dǝba a langǝ i tthǝ Yeso i lo wa mǝ ǝndǝi ɓǝ, Yiɓǝi ɓǝ gei angǝ ǝn dǝba a langǝ i tthǝ Yeso i lo wam ǝndǝi.&gt;&gt; <verse eid="ACT 8:37" /><verse number="38" style="v" sid="ACT 8:38" />Langkwoi u dǝba angǝ i dǝilǝ kǝkǝ prǝ ɓǝ. Yang Filibus i daa ɓǝ pin tǝ nungmung nung kwɔ Filibus wolu mung. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />Kwɔ i ɗab dang mung ɓǝ lǝ, Ɓyang gi Fuh dang tthǝ lǝi Filibus palǝ, daa ɓǝ ɓyǝko a kun lǝu, kwoi pa nung gu tthǝu la ǝndǝi. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />Filibus fug Azotus; u thko u tǝ Kaisariya, langkwoi lo lǝi lǝ, dǝna gei ba a langǝ i gi Fuh gwoi angǝ a lǝ ǝndǝi.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">Bǝ Mǝrǝm Gi Shawulu Muo Sua Yeso</para>
  <para style="r">(Acts 22:6-16; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />Lona lǝ kullo Shawulu ǝǝ nwa bǝ thǝb ya muo sua Dangbang. U tǝsua Gong ya Nyǝknung <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />langkwoi u ɗyǝab angǝ i ji nungvullǝ yang bǝ i tǝlǝ gwoi kǝm kǝbtha ya Yahudawa dang Dimashku, yang bǝ nǝ i tǝi ya muo nung lǝi Dangbang bǝi lǝ, yang bǝ u mui, yaɓǝi i yasi ǝndǝi, yang i wuilǝ Urshalima. <verse eid="ACT 9:2" /><verse number="3" style="v" sid="ACT 9:3" />Kwɔ Shawulu dǝna gbag Dimashku gwoi angǝ a, dang tthǝ lua wayi gab kwarǝu. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />Shawulu o pangsua langkwoi lǝ yol angǝ, &lt;&lt;Shawulu, Shawulu! Ən baɓǝ bǝ dǝmma dǝm zuii ni?&gt;&gt;<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />U ɓib angǝ,&lt;&lt;Mǝn yittǝnna Dangbang?&gt;&gt; Yol ɓǝ gei angǝ,&lt;&lt;Ɓang Yeso, kwɔ dǝmma dǝm zuii ɓǝ,&gt;&gt; <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />&lt;&lt;Kwoi a dǝi nǝbo a tǝ gwoi angǝ a ɓǝ, bǝi lǝ kwɔ i gei nung kwɔ tthǝ ma to ɓǝ.&gt;&gt;<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />Yaɓǝi kwɔ dǝna thko suatha i Shawulu kwɔ dǝi, i gei ba lǝu; i lǝ yol ɓǝ kwoi i ɓyǝa yuu a kun lǝu. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />Shawulu ǝrr pangsua lǝ dǝi nǝbo ɓko nungǝu, kwoi u ɓyǝa nung lǝu. Nung kwɔ i muu na i olǝsi i tǝlǝ Dimashku. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />Bo tai u ɓuan u ɓyǝa bǝi lǝu, langkwoi dang lona ɓǝ kullo u tangnung a kun lǝu ko u nwa nung a kun.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />Ya dǝba a langǝ i tthǝ Fuh Dimashku ɗuǝnnu ǝn Hananiya. Dangbang geiu ba dang muani angǝ, &lt;&lt;Hananiya&gt;&gt;u gwab nwa angǝ,</para>
  <para style="q1" vid="ACT 9:10">Ɓang kwɔ Dangbang,&gt;&gt;<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />Dangbang geiu angǝ, &lt;&lt;A mab tthǝmǝ a tǝ lǝi ganglang gwoi kwɔ Juan Nǝkwam kwɔ, ɗuǝnnu ǝn Yahuza a ɓib pi yiɓǝi ya Tarsus tthǝ ɗuǝnnu ǝn Shawulu. Dǝu pinwa, <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />langkwoi dang muani lǝ u ɓyǝa yiɓǝi a kun tthǝ ɗuǝnnu ǝn Hananiya wuu dǝna lo yang bǝ u ɓibǝi langkwoi.&gt;&gt;<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />Hananiya gwab nwa angǝ, &lt;&lt; Dangbang, yayuu kpaaɗing kwɔ geim ba tthǝ lo yiɓǝi kwɔ langkwoi lǝ ba nung a ɓko kwɔ ɓkoni kwɔ u tolǝ yayuu Urshalima ɓǝ. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />Langkwoi u wuu Dimashku i tthǝ nyimmi na yikku ya nyǝknung angǝ yang bǝ wuu muo ya kwɔ dǝna wabba ɓǝ.&gt;&gt;<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />Dangbang geiu angǝ, &lt;&lt;A tǝ, ba kwɔ ǝn mko ǝn mko u tom nungto tthǝ, u to ya kwɔ ǝn ya Yahudawa lǝu i ya yigwoi i ya Israila ibǝi ɗuǝnnǝm. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />Langkwoi ɓang i nam mǝn tko natthǝ zuii kwɔ u tang lǝ bam ɓǝ.&gt;&gt;<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />Nung kwɔ Hananiya pa, tǝ dang woi kwɔ Shawulu tthǝ ɓǝ, u dǝna lolǝ angǝ &lt;&lt;Young Shawulu, Dangbang tummǝm- Yeso i nko lǝ, yuu a kwɔ fug tthǝmmǝ lolǝi kwɔ dǝmma wulǝ bǝi kwɔ ɓǝ. U tummǝm yang bǝ a tǝi bǝ ɓyǝa bǝi langkwoi yang bǝ Ɓyang a Langǝ i yitthǝ mǝ.&gt;&gt; <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />Ba a nwaɓi kwɔ nung a kun mangǝn kong tthǝng i nung Shawulu lǝ wuu o, ǝrr u baipi bǝ ɓyǝabǝi langkwoi. U dǝi nǝbo i wolu mung; <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />langkwoi tthasua kwɔ u tangnung, tthko kwoi wuo.</para>
  <para style="s" vid="ACT 9:19">Shawulu Gei Ba A Langǝ i Dimashku</para>
  <para style="p" vid="ACT 9:19">Shawulu ǝǝ bǝilǝ natthǝ tuab i ya dǝba a langǝ i dang Dimaska. <verse eid="ACT 9:19" /><verse number="20" style="v" sid="ACT 9:20" />Dangtthǝ u baipi bǝ gei ba a langǝ i kǝm kǝbtha ya Yahudawa angǝ Yeso ǝn yui Fuh. <verse eid="ACT 9:20" /><verse number="21" style="v" sid="ACT 9:21" />Ya kwɔ lǝu ǝndǝi kwɔ loi fǝm ghaatthǝ dǝnni ɓib angǝ, &lt;&lt;Ən u lǝ yuu a kwɔ Urshalima kwɔ dǝu thǝb yayuu kwɔ dǝna wab yiɓǝi kwɔ angǝ ǝn Yeso ɓǝ lǝu? Langkwoi gǝllko u wuo bǝi kwɔ ǝn baɓǝ kwɔ yang bǝ wuu muo yayuu ɓǝi kwɔ yang bǝ u lǝi u tǝlǝ tǝu dǝlǝ yikku ya nyǝknung lǝu?&gt;&gt;<verse eid="ACT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22" />Kwoi bǝ gei ba gi Shawulu ǝrr nyim natthǝ, langkwoi ba kwɔ u gei angǝ Yeso lǝ Kristi kwɔ nyim ɗing kwɔ ya Yahudawa kwɔ logwoi dang Dimashku kwɔ ɓuan gwabbu nwa lǝu.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />Tthasua vii kpaatthǝ pa kwɔ, ya Yahudawa kǝbtha dǝna yiɗi bǝ thǝb Shawulu, <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />kwoi Shawulu i bǝi baɓǝ. Dangfuh i nungvi i ǝǝ nwa bǝ ki nwalǝgwoi gwoi angǝ yang bǝ i thǝu. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />Kwoi nungvii a kun lǝ ya muo sua Shawulu lǝiu pinǝu lǝ nwaɓua a kun gwu kǝm, dang kadɗuog.<verse eid="ACT 9:25" /></para>
  <para style="s">Shawulu Dang Urshalima</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />Shawulu patǝ Urshalima dǝu yiɗi bǝ kǝbtha lo i ya na nungto gi Yeso, kwoi i ǝndǝi dǝnni lǝ tthǝ vulli gu, i gwab angǝ u ǝn ya na nungto la langǝ i lǝu. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />Kwoi Barnabas lǝiu wulǝ sua ya nwatummi gi Yeso. U gei nung kwɔ tǝi Shawulu lolǝi gu kwɔ u ɓyǝa Dangbang langkwoi angǝ Dangbang geiu ba, langkwoi manungkwɔ dang Dimashku u gei ba Fuh tthǝ vulli yangǝu dang ɗuǝn Yeso. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />Nung kwɔ Shawulu ǝǝ i ilǝ dǝna thko dang Urshalima, dǝu gei ba i nyi nyimmi dang ɗuǝn Dangbang. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />U gei ba u nyimtha nwa i ya Yahudawa kwɔ dǝna gei nwa ya Helinawa ɓǝ, kwoi dǝi yiɗi bǝ thǝu. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />Kwɔ ya dǝba a langǝ i ibǝi nung kwɔ, i lǝi Shawulu i tǝlǝ Kaisariya langkwoi i toggǝu u tǝ Tarsus.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />Yang ya kǝm pinwa dang Yahudiya ǝndǝi, Galili i Samariya lǝ tthǝla lona bǝ ǝǝ a langǝ i. I bǝ nwongbǝi gi Ɓyang a Langǝ i i nyimtthǝ loi kpaa, dǝnni ǝǝ dang bǝ sur Fuh.<verse eid="ACT 9:31" /></para>
  <para style="s">Bitrus Dang Lidda I Yafa</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />Kwɔ Bitrus thko losua ǝndǝi, langkwoi vii a kun u tǝsua yayuu gi Fuh Lidda. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />Bǝi lǝ kullo u tǝi yiɓǝi a kun tthǝ ɗuǝnnu ǝn Iniyasu, yuu a kwɔ a nko i bo ɓui lǝ ɓui ɓǝ u ɓuan u ǝrr lo nunglo lǝu ttha ǝngunnai. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />Bitrus geiu angǝ, &lt;&lt;Iniyasu, Yeso da tthǝllang. Ərr a dǝi nǝbo a lǝi gei mǝ &gt;&gt;Dangtthǝ ni yang Iniyasu dǝi nǝbo. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />Ya kwɔ ǝǝ dang Lidda i Sarona ɓyǝko langkwoi i mǝrrǝm lǝ ya muo sua Dangbang.<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />Dang Yafa lǝ ya nanungto gi Yeso a kun tthǝ ɗuǝnnu ǝn Tabita (nung ɓǝlǝ, Dokas i Helinanci), dǝu to maɗing vii ǝndǝi dǝu nwong ya yiɓko. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />Lona lǝ kullo tthǝu lko nung kwɔ u ɓui, nung kwɔ i wollu mung i du kǝm a yi. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />Lidda gbag tha i Yafa; nungkwɔ kwɔ ya na nungto gi Yeso Joppa lǝ angǝ Bitrus Lidda, i tum yaɓǝi rab tǝi geiu angǝ, &lt;&lt;Lanyi mǝ a wɔ thǝmtthǝ!&gt;&gt;<verse eid="ACT 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 9:39" />Nung kwɔ Bitrus tǝ suatha i ilǝ, langkwoi kwɔ u kǝn bǝi i lǝiu i tǝlǝ kǝm a yi. Ya siɓui kwarǝu dǝilǝ, dǝnni tasui dǝnni tanatthǝ nunglitthǝ kwɔ Dokas mab kwɔ yirrǝ u i ilǝ ɓǝ.<verse eid="ACT 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 9:40" />Bitrus gei angǝ i ǝndǝi dang kǝm lǝ i tǝ gwam, nung kwɔ u bai nwa longǝu sua u pi nwa. U mǝrǝm ttha tthang kwamɓui yisi ɓǝ, u gei angǝ, &lt;&lt;Tabita, a ǝrr.&gt;&gt; U ɓko nungǝu, kwɔ dǝu ɓyǝa Bitrus ni u ǝǝ nǝ pi. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />Bitrus dǝna muu lǝ u dǝi nǝbo. Nung kwɔ u lubǝ ya dǝ ba a langǝ i ǝndǝi, i ya siɓui ǝndǝi, u ji yisi ɓǝ i nwongǝi gu. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />Nwa ba nung kwɔ lǝi dang Yafa ǝndǝi, langkwoi yayuu kpaatthǝ dǝba a langǝ i tthǝ Dangbang. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />Bitrus lo dang Joppa, lona sua tutthǝ i ya tonungto zuǝ a kun tthǝ ɗuǝnnu ǝn Saminu.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">Bitrus I Karniliyas</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />Yiɓǝi a kun tthǝ Kaisariya ɗuǝnu ǝn Karniliyas, u ǝn yikku ya soja Romawa thǝm nu dang ǝu kwɔ i ji ɗuǝn angǝ,&lt;&lt;Kon ya soja Italiya.&gt;&gt; <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />U ǝn ya wab Fuh; u i ya dang woi gu ǝndǝi dǝnni wab Fuh. Langkwoi dǝnnu nwong ya yiɓko ya Yahudawa langkwoi vii ǝndǝi dǝnnu pinwa tthǝ Fuh. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />Vii a kun gbag lona tai a dang fuh kwɔ u monmonni, kwɔ u ɓyǝa ya nwatummi gi Fuh kai tthǝ wua tthangǝu wu geiu angǝ,&lt;&lt;Karniliya!&gt;&gt;<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />Karniliya dǝ nung tthǝ ya nwatummi gi Fuh i tthǝ vulli ǝrr gei angǝ,&lt;&lt;Ən ɓǝtǝn na, yikku?&gt;&gt;</para>
  <para style="p" vid="ACT 10:4">Ya nwatummi gi Fuh gwab nwa angǝ,&lt;&lt;Fuh lǝ tthǝla bǝ pinwa mǝ i nungto mǝ i nung kwɔ dǝmma dǝlǝ ya yiɓko ɓǝ, langkwoi Fuh lolǝi u gwab bǝ pinwa mǝ. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />Langkwoi la kwɔ a tum yayuu Yafa sua yuu a kun tthǝ kwɔ dǝnni luu ɗuǝnnu angǝ Siman Bitrus ɓǝ. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />U ǝn yayol dang gwoi yuu kwɔ dǝna tonungto zuǝ ɓǝ ɗuǝnnu ǝn Saminu, kwɔ gwoi gu nwa nwam lǝ ɓǝ.&gt;&gt;<verse eid="ACT 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 10:7" />Yang ya nwatummi gi Fuh ɓǝ pa, langkwoi Karniliya lubǝ ya thǝb gwoi gu rab i ya soja, kwɔ dǝna muo suo vii ǝndǝi ɓǝ u ǝn ya muo sua Fuh. <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />U gei nung kwɔ tthǝ tonung ɓǝ nung kwɔ u tummi Yafa.<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />I bǝikan, kwɔ i lolǝi kwɔ i gbag Yafa, Bitrus ɗab tǝ lo kǝm kwɔ i dǝlǝng lǝ dǝlǝng kwɔ fuh gbag nyilo yangbǝ tǝu pinwa. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />Gwom tǝiu langkwoi dǝnnu yiɗi nung a kwɔ u tang ɓǝ; kwɔ dǝnni yoo nungtang ɓǝ, u muan muani. <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />U ɓyǝa wayi ɓko langkwoi nung a kun dǝna pin wayi mangǝn gong landǝ longwam. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />I nungbyang a nwa ǝndǝi lo landǝ lǝ, i nungbyang a kwɔ da krom pangsua kwɔ, langkwoi i nurug dang gug.<verse eid="ACT 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 10:13" />Yol ǝrr geiu angǝ,&lt;&lt;A ǝrr a dǝinǝbo, Bitrus. A thǝbǝi a tang!&gt;&gt;<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />Kwoi Bitrus gei angǝ,&lt;&lt;Lalangǝ i nilǝu, Dangbang! Ən tang nung a kwɔ nungzuu ɓi ya Yahudawa gei angǝ mko langkwoi dǝna ɓanglǝ bǝi kwɔ bo kun lǝu.&gt;&gt;<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />Yol ɓǝ geiu ba langkwoi angǝ, &lt;&lt; Bǝ a luu nung a kun kwɔ Fuh mab matthǝ kwɔ mangǝ mko thǝ. <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />Nung kwɔ tonung bo tai, langkwoi yang nung ɓǝ kwoi tǝ wayi.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />Kwɔ Bitrus dang bǝ nhǝm balo muani kwɔ, yaɓǝi kwɔ Karniliya tummi kwɔ tǝi bǝi kwɔ gwoi Saminu tthǝɓǝng, langkwoi i dǝi tthasi nwalǝgwoi lǝ. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />I lubǝi langkwoi i ɓib angǝ, &lt;&lt; Yayol tthǝ bǝi kwɔ ɗuǝnnu ǝn Siman Bitrus a?&gt;&gt;<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />Bitrus yirrǝ dǝna nhǝm ba lo muani kwɔ, kwɔ Ɓyang a Langǝ i geiu angǝ, &lt;&lt;A lǝ! Yaɓǝi tthǝ tai bǝi kwɔ dǝna ɗubǝi mǝ. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />La kwɔ a pin pangsua. Ba la bǝ pa suatha i ilǝ thǝ, ba kwɔ ǝn ɓang ǝn tummǝi ɓǝ.&gt;&gt;<verse eid="ACT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 10:21" />Nung kwɔ Bitrus pin pangsua wuu gei yaɓǝi ɓǝ angǝ, &lt;&lt;Ən ɓang lǝ yiɓǝi kwɔ dǝɓa ɗubǝi ɓǝ. Ən baɓǝ bǝɓa wua?&gt;&gt;<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />Yaɓǝi ɓǝ gei angǝ, &lt;&lt;Ən yikku ɓi ya soja Karniliya tum ɓi, U ǝn yuu a langǝ i langkwoi dǝu wab Fuh langkwoi kwɔ ya Yahudawa dǝna du ghaali ɗing. Ya nwatummi gi Fuh geiu angǝ u ɗubǝ mǝ a tǝ gwoi gu, yang bǝ wulǝ nung kwɔ ma gei ɓǝ.&gt;&gt; <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />Bitrus lubǝ yaɓǝi ɓǝ tǝ lo i ilǝ bǝilǝ.</para>
  <para style="p" vid="ACT 10:23">I bǝikan u mab tthǝu u pa i ilǝ; langkwoi ya dǝba a langǝ i Joppa pa suatha i ilǝ. <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />I bǝikan u kǝn Kaisariya, Bǝilǝ Karniliya dǝna kilo, nung kwɔ u lubǝ ya dang woi gu i ya ǝnthǝ kwɔ gbagǝu kwɔ lubǝi ǝndǝi. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />Kwɔ Bitrus dǝna tǝbǝ tǝ dang gwoi, Karniliyas ǝrr kǝbbu, u bai nwa longǝu dang siu, langkwoi u wabbu. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />Kwoi Bitrus geiu angǝ, &lt;&lt;A dǝinǝbo,&gt; u gei angǝ, &lt;&lt;Ɓang i namlǝ ɓang ǝn yuu ɓuo.&gt;&gt;<verse eid="ACT 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 10:27" />Bitrus dǝi nwa bǝ gei ba i Karniliyas lǝ, kwɔ u tǝ dang gwoi ɓǝ, bǝi lǝ tǝu tǝi yayuu kpaatthǝ gǝmtha. <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />U gei angǝ,&lt;&lt;Ɓǝ i naɓǝ ɓa i bǝi lalangǝ i angǝ ǝn nungzuu ya Yahudawa gwab lǝ ya Yahudawa tthǝ tonung lotha i ya kwɔ ǝnya Yahudawa lǝu ɓǝ langkwoi tǝ suaiu. Kwoi Fuh geim angǝ bǝ ǝn gei yuu a kun gǝngǝ ǝn ya nung a ɓko ko</para>
  <para style="b" vid="ACT 10:28">ko ǝn ya to ɓilǝng thǝ. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />Langkwoi nung kwɔ kwɔ a tumbǝi suam kwɔ, Ən la bǝ wuu lǝu. Ən ɓiba, yang, ǝn baɓǝ bǝ a tumbǝi suam?&gt;&gt;<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />Karniliyas gei angǝ,&lt;&lt;Gbag lona kwɔ dang bo tai kwɔ pa kwɔ Ɓang gwoim dǝm pinwa lona tai dang fuh. Dang tthǝni yiɓǝi a kun linunglitthǝ a yumi dǝi dang sim <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />langkwoi gei angǝ: &lt;Karniliya! Fuh lǝ bǝ pinwa mǝng langkwoi u nhǝm nung dǝ mǝ lǝ ya yi ɓkong. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />A tum yuu kun Yafa sua yiɓǝi kwɔ dǝnni luu angǝ Siman Bitrus ɓǝ. U ǝn yayol gwoi gi Saminu ya tonungto zuǝ, yuu kwɔ logwoi nwa nwam ɓǝ.&gt; <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />Nung kwɔ ǝn tumbǝi suamǝ thǝmtthǝ, langkwoi maɗing kwɔ a wɔ ɓǝ. La kwɔ ɓi ǝndǝi bǝi kwɔ ɗǝgsi Fuh, dǝbɓi ki bǝlǝ nung kwɔ ǝndǝi kwɔ Dangbang gei angǝ wa gei ɓi tthǝɓǝ.&gt;&gt;<verse eid="ACT 10:33" /></para>
  <para style="s">Bagi Bitrus</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />&lt;&lt; Bitrus baipi bǝ gei ba angǝ: &lt;&lt;La kwɔ ǝn ibǝi ǝn ba a langǝ i Fuh dǝna tonung lǝ yayuu tthǝ ǝndǝi natha. <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />Ya kwɔ dǝna surru langkwoi dǝna to nung kwɔ ǝn lozuiiu kwɔ dǝu gwabǝi, ko ǝn losua a nwuo i ǝrr tthǝ. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />Ɓa ibǝ ba kwɔ u tum lǝ bǝi sua ya Israila ɓǝng, dǝu gei ba a langǝ i lǝ ba Kristi, kwɔ lǝ Dangbang yayuu ǝndǝi ɓǝ.<verse eid="ACT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 10:37" />Ɓa ibǝ nung angǝ a kwɔ tonung losua Israila ǝndǝi ɓǝng, baipiu dang Galili tthasua kwɔ Yohanna gei ba a langǝ i wol mung gu ɓǝ. <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />Ɓa ibǝ balo Yeso Kristi ya Nazarat langkwoi manung kwɔ Fuh du Ɓyang a Langǝ i i ttha ɓǝ. U tǝ bǝi ǝndǝi, dǝu to nung a langǝ i dǝnnu dǝ tthǝla lǝ ya kwɔ dǝna to zuii na ttha Mungkulum, ba kwɔ Fuh i ulǝ ɓǝ.<verse eid="ACT 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 10:39" />&lt;&lt;Ɓi ǝn ya shǝdǝ lo i nung kwɔ ǝndǝi u to losua ya Israila langkwoi i Urshalima ɓǝ. Yang i thǝu i bǝ piu lo kab gangǝ i lǝ, <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />Kwoi Fuh ǝrrǝu lǝ dang ɓua dang bo tai langkwoi to i ɓiu. <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />Yayuu ǝndǝi ɓiu lǝu, kwoi ǝn ya shǝdǝ kwɔ Fuh mko la nwasiu ɓǝ- nung ɓǝlǝ ɓi kwɔ ɓi tang ɓi nwa i u lǝ ɓǝ tthasua kwɔ u ǝrr i nwongǝi ɓǝ. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />Langkwoi u dǝɓi ba angǝ ɓi gei a langǝ i lǝ yayuu tthǝ langkwoi yang bǝ ɓi dǝ shǝdǝ angǝ ilǝ yuu a kwɔ Fuh dulǝ ya to kwan lo ya nwongǝi i ya ɓuiɓua. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />Ya gei ba a tthasi ǝndǝi gei bagu, angǝ ya kwɔ ǝndǝi dǝba a langǝ i tthǝu yang i al nung a ɓko gi lǝtǝ dang ttha ɗuǝnnu.&gt;&gt;<verse eid="ACT 10:43" /></para>
  <para style="s1">Yakwɔ Ənya Yahudawa Lǝu Kwɔ Muo Ɓyang a Langǝ i</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />Kwɔ yirǝ Bitrus dǝna gei ba kwɔ, Ɓyang a Langǝ i pinlo ya kwɔ ǝndǝi kwɔ dǝna lǝ bagu ɓǝ. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />Ya Yahudawa ya dǝba a langǝ i kwɔ ǝrr Yafa suatha i Bitrus kwɔ loi fǝm kwɔ Fuh al nung dǝ gu Ɓyang a Langǝ i ilo ya kwɔ ǝn ya Yahudawa lǝu ɓǝ. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />Ba kwɔ i lǝi dǝnni geiba i nwa afu dǝnni kha ghaali Fuh. Bitrus gei angǝ: <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />&lt;&lt;Yayuu kwɔ muo Ɓyang a Langǝ ing, manungkwɔ ɓi lang ɓǝ ɓi muo ɓǝ. Yuu a kun tthǝ, yang, a nanni bǝ wolli mungki a?&gt;&gt; <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />Nung kwɔ u gei angǝ i wolli mung dang ɗuǝn Yeso Kristi. Yang i gei Bitrus angǝ ǝǝ i ilǝ natthǝ tuab.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">Bitrus Ghai Nwaba Dangkǝm Pinwa Urushalima</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />Ya nwatummi gi Yeso i ya kun kwɔ dǝ ba a langǝ i tthǝ Fuh kwɔ dang Yahudiya ǝndǝi kwɔ lǝ angǝ ya kwɔ ǝn ya Yahudawa lǝu kwɔ dǝba a langǝ i tthǝ Fuh. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />Kwɔ Bitrus tǝ Urshalima, ya kwɔ gwab i ɓǝr nwa ɗuǝ ya kwɔ ǝn ya Yahudawa lǝu kwɔ gei ba tthǝu, angǝ, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />&lt;&lt;A lo dang gwoi ya kwɔ ǝn ya Yahudawa lǝu ɓǝ, langkwoi a tangnung tang lo tha i ilǝ!&gt;&gt;<verse eid="ACT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4" />Nung kwɔ Bitrus gei nung kwɔ tonung ǝndǝi manung kwɔ tonung ɓǝ:<verse eid="ACT 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 11:5" />&lt;&lt;Kwɔ dǝmǝng pinwa gwoi angǝ a ya Yafa, Ən ɓyǝa dang monni. Ən ɓyǝa nung a kun dǝna pin wayi ghaatthǝ mangǝn landǝ dǝi yinatthǝ wayi lonko ǝndǝi nǝ naiu, wuu dǝi bǝi kwɔ ɓang tthǝ ɓǝ. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />Ən ɓyǝa matthǝ dang ǝulǝ ǝn ɓyǝa nungbyang gwoi i nungbyang dang ug, nungbyang a kwɔ dǝna krom i biwa i nurug dang gug. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />Yang ǝn lǝ yol dǝna geim angǝ,&lt;&lt;A ǝrr, Bitrus; a thǝb a tang!&gt; <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />Kwoi ǝn gwab nwa gǝngǝ, &lt;Lalangǝ i nilǝu, Dangbang! Ən tang nung a kun kwɔ nungzuu ya Yahudawa gei angǝ mko langkwoi dǝna ɓanglǝ bǝi bokun lǝu.&gt; <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />Yol ɓǝ gei ba a kun langkwoi wayi lǝ angǝ,&lt;Bǝ a luu nung a kun kwɔ Fuh mab matthǝ kwɔ mangǝ nung a ɓko thǝ.&gt; <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />Nung kwɔ tonung bo tai, tthasua ǝndǝi nung ɓǝ kwoi tǝ wayi. <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />Bǝilǝ dang tthǝ niyang yaɓǝi tai kwɔ i tumǝi tthǝm lǝ kwɔ i ǝrr Kaisariya wua dǝi nwalǝgwoi kwɔ ɓang tthǝ ɓǝ. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />Ɓyang a langǝ i geim tthǝ angǝ bǝ ǝn labǝ tǝ ilǝ thǝ. Ya dǝba a langǝ i tthǝ kwɔ nanakun kwɔ ǝrr Yafa kwɔ i dǝm sua ɓitǝ Kaisariya, ɓi tǝ dang gwoi Karniliya. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />U gei ɓi tthǝ manung kwɔ u ɓyǝa ya nwatummi gi Fuh fuk tthǝu dǝi dang woi langkwoi gei angǝ, &lt;A tum yuu a kun Yafa sua yuu kwɔ dǝnni luu angǝ Saminu Bitrus ɓǝ. <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />U gei ba tthǝ kwɔ mǝ i ya dang gwoi mǝ ǝndǝi a tǝi nwongǝi ɓǝ.&gt;<verse eid="ACT 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15" />Langkwoi kwɔ ǝn baipi bǝ gei ba, Ɓyang a Langǝ i pin loi manug kwɔ pin loɓi la nungsi ɓǝ. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />Yang ǝn nhǝm nung kwɔ Dangbang gei ɓǝ angǝ:&lt; Yohanna wol ɓǝ mung i mungki, kwoi i wol ɓǝ mung i Ɓyang a Langǝ i.&gt; <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />Kai nǝkwam Fuh dǝ nung dǝ nathǝ i a ɓi kwɔ ɓi dǝ ba a langǝ i tthǝ Dangbang Yeso Kristi; ɓang ǝn yittǝn, yang, kwɔ mǝn la nung kwɔ Fuh dǝna yiɗi bǝ tou ɓǝ!&gt;&gt;<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />Kwɔ i lǝ nung kwɔ, i ɓuan i yǝrnwa tthǝ lǝu langkwoi i kha Fuh, angǝ, &lt;&lt;Nung kwɔ yang, Fuh dǝlǝi lǝ ya kwɔ ǝn ya Yahudawa lǝu kwɔ lang ɓǝ mǝrrǝm lonyiǝ bǝ tǝi nwongǝi.&gt;&gt;<verse eid="ACT 11:18" /></para>
  <para style="s">Ya Kǝm Fuh Antakiya</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />Ya kun dang ya dǝba a langǝ i tthǝ Fuh kwɔ yǝb tha ba zuii kwɔ tǝi kwɔ i thǝb Istifanas kwɔ thko tǝ Finikiya, Kubrus i Antakiya dǝnni gei nwa ba ya Yahudawa ɓuo. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />Kwoi ya kun dang ya dǝba a langǝ i tthǝ Fuh, ya kwɔ ǝrr Kubrus i Kurane, tǝ Antakiya i gei ba gi Fuh lǝ ya Helinawa tthǝ lang ɓǝ, dǝnni gei ba a langǝ i tthǝ ba Dangbang Yeso. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />Ttha Dangbang i ilǝ, yayuu kpaatthǝ dǝba a langǝ i tthǝ mǝrrǝm dang wai muo sua Dangbang.<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />Nwa ba nung kwɔ kǝn ya kǝm pinwa dang Urshalima, nung kwɔ i tum Barnabas tǝ Antakiya. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />Kwɔ u tǝ tǝu tǝi kwɔ Fuh khana lo yayuu, u lǝ tthǝla u gei angǝ i dǝi nyimtthǝ nung lǝi Fuh i tonung a langǝ i lǝ Dangbang tthǝ i dang wai ǝndǝi. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />Barnabas ǝn yuu a langǝ i, kwɔ Ɓyang a Langǝ i tthǝu lǝ i bǝ dǝnyiu ɓǝ, u wulǝ yayuu kpaatthǝ lǝ sua Dangbang.<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />Yang Barnabas tǝ Tarsus bǝ ɗubǝ Shawulu. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />Kwɔ tǝu tǝiu, u lǝiu u tǝlǝ Antakiya, lǝ ǝndǝi Barnabas i Bulus kǝbtha i ya kǝm pinwa i nana tthǝ nung lǝ yayuu kpaatthǝ. Tthǝn Antakiya kwɔ i bai pi bǝ luu ya dǝ ba a langǝ i lǝ Krista. <verse eid="ACT 11:26" /><verse number="27" style="v" sid="ACT 11:27" />Lona lǝ kulo ya gei ba a tthasi ya kun ǝrr Urshalima lǝ tǝ Antakiya. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />Yuu a kun dang ǝi, ɗuǝnnu ǝn Agabas, ǝrr dǝinǝbo ttha Ɓyang ɓyǝa tthasi angǝ gong gwom gbag bǝ o longwam ǝndǝi. (Nung kwɔ tonung vii bǝ loyigwoi Kalkodiyas) <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />Ya nwatumi mab angǝ i ǝndǝi i ɗu nung lǝi kwɔ i gǝm nung yang bǝ i nwong ya dǝba a langǝ i tthǝ Fuh kwɔ lo dang Yahudiya ɓǝ. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />I to nung kwɔ, yang bǝ, i tumbǝi i nungkurɓǝ lǝ yakku ya kǝm pinwa tthǝ na Barnabas i Bulus.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s1">Zuii Lilo</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />Gbag lona kwɔ Yigwoi Hiridus baipi bǝ dǝzuii lǝ yakun dang ya kǝm pinwa. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />U thǝb Yakubu, young gi Yohanna, i khafǝi. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />Kwɔ u ɓyǝa nungkwɔ la ya Yahudawa ɗing, u lilotthǝ tǝu muo Bitrus. (Nungkwɔ to nung lona kwɔ dǝnni to ɓang nungtang kwɔ yisti yangǝu tthǝɓǝ.) <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />Tthasua Kwɔ u mua Bitrus i tthǝb pursǝna, kwɔ i togǝu tǝi dǝlǝ ya soja nainai bǝi nai yang bǝ na kiu. Hiridus dǝna mab lǝi bǝ tou kwan dang yayuu nǝ i alo bǝ to ɓang nyang lo gwoi ɓǝ. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />Nungkwɔ i yi Bitrus pursǝna, nungkwɔ ya kǝm pinwa dǝna pinwa dang wa kun tthǝ fuh lǝ bagu.<verse eid="ACT 12:5" /></para>
  <para style="s1">I Yǝrnwa Lǝ Bitrus pursǝna</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />Nungvii kwɔ Hiridus wa ilǝ Bitrus dang pursǝna a wulǝ sua yayuu kwɔ, Bitrus dǝna lo nung lo ganglang ya kinung rab. I tthǝbu i sarka rab, ya soja tthǝ lo nung to nwalǝgwoi pursǝna. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />Dangtthǝ ya nwatummi gi Dangbang fug bǝi lǝ, langkwoi lua gab dang bǝ tthǝb bǝi lǝ. Ya nwatummi ɓǝ thǝuri Bitrus lo paptarru, u ǝrrǝu lǝ, u gei angǝ, &lt;&lt;Thǝmtthǝ! A dǝi nǝbo!&gt;&gt;Ba a nwaɓi kwɔ sarka ɓǝ pin suk na Bitrus al pangsua. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />Yang ya nwatummi gi Fuh ɓǝ geiu angǝ,&lt;&lt;A tthǝb nung tthǝbtthǝmǝ langkwoi a bai ǝko mǝ.&gt;&gt;Bitrus to manungɓǝ, langkwoi ya nwatummi ɓǝ gei angǝ,&lt;&lt;A tthǝb nung ɓuob thǝ mǝ tthǝmǝ a muo suam.&gt;&gt; <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />Bitrus muo suko i dang pursǝna ɓǝlǝ, kwoi u ibǝ nungkwɔ ya nwatummi dǝna to kwɔ la langǝ i lǝu; dǝnnu ɓyǝa angǝ ǝn muani. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />I patthǝ ya ki nwalǝgwoi a nungsi langkwoi a nung rabbu, nungkwɔ i tǝ nwalǝgwoi a ɓui kwɔ a tǝ gwoi angǝ a ɓǝ. Nwalǝgwoi ɓǝ ǝrr ɓkotthǝ i nkolǝ, ǝrr i igwam. Kwɔ dǝnni thko lolǝi dang ganglang gwoi, dang tthǝ ya nwatummi ɓǝ pa yiǝ Bitrus.<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />Yang Bitrus wuo dang kiggǝu gei angǝ, &lt;&lt;Lakwɔ ǝn ibǝi ǝn ba a langǝ i! Dangbang tum ya nwatummi gu wua nwongǝm na ttha Hiridus i nungkwɔ ǝndǝi kwɔ ya Yahudawa dǝna yidɗi angǝ tǝim ɓǝ.<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />Kwɔ Bitrus ibǝ nungkwɔni, u tǝ gwoi gi Maryamu, naa gi Yohanna Markus, bǝi lǝ kwɔ yayuu gǝm tha kpaatthǝ dǝna pinwa ɓǝ. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />Bitrus gab nwalǝgwoi a gwam, nungkwɔ tthǝb munthang a yisi akuntthǝ ɗuǝnu ǝn Roda wua bǝ gwabu nwa. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />Kwɔ u ibǝi ǝn yol Bitrus u lǝ tthǝla u kwoi i dum u ɓko nwa kǝm ɓǝlǝu, tǝu gei angǝ Bitrus dǝi gwam. <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />I geiu angǝ,&lt;&lt;A yangǝu dang kiggǝ mǝu!&gt;&gt;Kwɔ u ǝnwa bǝ gei angǝ ǝn ba a langǝ i. Nungkwɔ ǝrr i gwabu tthǝ angǝ,&lt;&lt;Ənya nwatummi gu.&gt;&gt;<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />Kwoi Bitrus dǝinwa bǝ gap nwa kǝm ɓǝ. Nǝsua ǝndǝi ǝrr i ɓko nwa kǝm ɓǝ, kwɔ i byǝko, ilǝ tthǝvuli. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />Bitrus lǝi na angǝ i kǝr nwa nǝkwam, ǝrr u gei nungkwɔ tthǝ Dangbang to iu lǝ pursǝna ɓǝ. U gei angǝ, &lt;&lt;Ɓa gei lǝ Yakubu tthǝ i sua ya muo sua Fuh,&gt;&gt; nung kwɔ u pa u tǝ bǝi akun.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />Kwɔ bǝi kan, yurrǝ ǝrr ganglang ya soja ghaa tthǝ- nungkwɔ tonung tthǝ Bitrus lǝɓǝ? <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />Hiridus gei angǝ i ɗubǝiu matthǝ, kwɔ i tǝiu lǝu. U ɓib balǝ ya ki pursǝna ɓǝ langkwoi u gei angǝ i thǝi.</para>
  <para style="p" vid="ACT 12:19">Tthasua nungkwɔ, Hiridus yitthǝ Yahudiya langkwoi tǝ Kaisariya tǝ ǝǝ bǝilǝ tuab.<verse eid="ACT 12:19" /></para>
  <para style="s">Ɓua Gi Hiridus</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />Dangwa Hiridus ɓanglǝ tthǝ ya Taya i ya Sidon, i tǝ loi kpaatthǝ yangbǝ tǝi ɓiu. Nungsi tǝi yam lo nyi Bilastasa, yikku ya thǝl bo yigwoi, angǝ u nwongǝi. Nungkwɔ itǝ tthang Hiridus tǝi yammu, bakwɔ ya losua gi dǝna tǝi nungtang tthǝn losua gi yigwoi ɓǝlǝ ɓǝ.<verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />Vii kwɔ i mko angǝ i kǝbtha tthǝ kwɔ Hiridus li nunglitthǝ yigwoi gu, ǝǝ lo nung ǝǝ to kwan gu, nungkwɔ gei ba lǝ yayuu. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />I buogbǝi angǝ,&lt;&lt; Ən yuu dǝna gei ba lǝu, ǝn fuh!&gt;&gt; <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />Dang tthǝ ni, bakwɔ Hiridus dǝ ghaali lǝ Fuh lǝu, ya nwatummi gi Dangbang ɓuob Hiridus walǝtǝ, Nungkwɔ sisi tangǝu u ɓui.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />Kwoi ba gi Fuh ǝnwa bǝ lilo langkwoi lǝi bǝi ǝndǝi. <verse eid="ACT 12:24" /><verse number="25" style="v" sid="ACT 12:25" />Barnabas i Bulus alo nung to gi i kwoi suai Urshalima, i suattha i Yohanna Markus.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">I Mko Barnabas I Bulus I Tummǝi</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />Dang kǝm pinwa Antakiya lǝ ya gei ba a tthasi tthǝ i ya nanathǝnung: Barnabas, Saminu kwɔ (ɗuǝnnu lǝ A ɓilling ɓǝ), i Lukiyas (ya Kurane), i Manayan (kwɔ i lǝu suattha i yigwoi Hiridus ɓǝ), i Bulus. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />Kwɔ dǝnni tonungto lǝ Dangbang tthǝ dǝnni zuu Fuh, ya Ɓyang a Langǝ i gei angǝ,&lt;&lt;Ɓa mab Barnabas i Bulus, tǝi tom nungto kwɔ tthǝ ǝn lubǝi lǝ bko ɓǝ.&gt;&gt;<verse eid="ACT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3" />Nung kwɔ tthasua kwɔ i zuu Fuh langkwoi i pinwa, i dǝna loi, nung kwɔ i toggǝi i pa.<verse eid="ACT 13:3" /></para>
  <para style="s">Dang Kubrus</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />I kwɔ rab kwɔ, ya Ɓyang a Langǝ i tummǝi, i tǝ Salukiya i ɗab kwai i tǝ logum ganglang mung Kubrus.<verse eid="ACT 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 13:5" />Kwɔ i tǝ Salamis, i gei ba gi Fuh dang kǝm kǝbtha ya Yahudawa. I lǝi Yohanna Markus bǝi lǝ lǝ ya nwongǝi.<verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />I thko losua lǝ ǝndǝi i tǝlǝ Bafusa, bǝilǝ kullo i kǝbtha i ya nung pi ya Yahudawa langkwoi ya gei ba tthasi ya pǝllǝ ɗuǝnnu angǝ Bar Yashu'a, <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />U ǝn ǝnthǝ gi yikku losua gum ganglang mung ɓǝlǝ, Sarjiyas i Bulus, kwɔ u ǝn ya yigǝi ɓǝ. Yikku losua ɓǝ lubǝ Barnabas i Bulus wua gwoi gu dǝnnu yiɗi bǝ lǝ ba gi Fuh. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />Kwoi Alimas ya nungpi (nung ɓǝ lǝ ɗuǝnnu i nwa Helinawa), dǝna yiɗi bǝ mǝrrǝm yikku losua ɓǝ tthǝ bǝ dǝba a langǝ i. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />Yang Shawulu- kwɔ lang ɓǝ dǝnni luu angǝ Bulus ɓǝ- Ɓyang a Langǝ i tthǝu; dǝ nungǝu dang nung ya nungpi ɓǝlǝ<verse eid="ACT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 13:10" />gei angǝ,&lt;&lt;Mǝ yui Mungkulum! Mǝ ǝn ɓui tthǝ nung kwɔ ǝndǝi lǝ nung a langǝ i ɓǝ. Dangwa mǝ yitthǝ i mulub a ɓko ǝndǝi, langkwoi vii ǝndǝi a ǝǝ nwa bǝ mǝrrǝm ba a langǝ i gi Fuh lǝ pǝllǝ! <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />La kwɔ na Dangbang a pin lomǝ nǝnǝng kwɔ; nung mǝ a ɓuom a ɓyǝa bǝiu.&gt;&gt;</para>
  <para style="p" vid="ACT 13:11">Dangtthǝ kukkam tthǝl wuo lo Elimas, langkwoi dǝu duam bǝi, dǝnnu thau dǝnnu ɗubǝ yuu kwɔ a muna kab ɓǝ. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />Kwɔ yikku losua ɓǝ ɓyǝa nung kwɔ to nung kwɔ, tthǝu survuli ghaatthǝ lo bǝ nanatthǝ nung lo Dangbang.<verse eid="ACT 13:12" /></para>
  <para style="s">Dang Antakiya i Bisidiya</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />Bulus i ya ǝntthǝu ɗab kwai Bafusa i tǝ Bariyata, losua Bamfiliya, bǝi kwɔ Yohanna Markus pa yiǝ kwoi suko tǝ Urshalima ɓǝ. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />I ǝrr Bariyata lǝ nung kwɔ i tǝ Antakiya dang Bisidiya, langkwoi vii nwongǝi gi ya Yahudawa i pa i tǝ dang kǝm kǝptha ya Yahudawa tǝi ǝǝ tthǝ. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />Tthasua kwɔ i than nung dang zuu gi Musa i nungvullǝ ya gei ba a tthasi, yakku kǝm kǝbtha ɓǝ tum bǝi suai angǝ: &lt;&lt;Ya young, nǝɓǝ tthǝ ba kwɔ a nyimtthǝ yayuu yang, la lo nyi ɓǝ ɓa gei.&gt;&gt;<verse eid="ACT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16" />Bulus ǝrr dǝinǝbo, to nko wayi nung kwɔ u gei angǝ, ɓa kǝr nwa nǝkwam, nung kwɔ ǝrr baipi bǝ gei ba:</para>
  <para style="p" vid="ACT 13:16">Ya Israila i ya kwɔ ǝn ya Yahudawa lǝu kwɔ dǝbɓa wab Fuh kwɔ, ɓa lǝm! <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />Fuh ya Israila mko ya bǝba ɓi u to yayuu ɓi tǝi nung vii kwɔ i ǝǝ losua Masar ɓǝ, Fuh oi lǝ si i gong ttha u iilǝ losua lǝ, <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />langkwoi ttha thǝmrab u nyimnyi i ilǝ dang losua a kwi. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />U thǝb ya losua nanaira dang kanana u dǝ losua gi lǝ yayuu gu lǝ a bǝi. <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />Nung kwɔ ǝndǝi lǝi tthaa tthǝmsob ɓua rab (450).</para>
  <para style="p" vid="ACT 13:20">&lt;&lt;Tthasua nung kwɔ, Fuh ji ya tokwan tǝlǝ lona Samaila ya gei ba a tthasi. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />Yang kwɔ dǝnni yiɗi yigwoi, nung kwɔ Fuh ji Skol yui Kish dang ya nwa gwoi gi Biliyaminu, u lo yigwoi tthaa thǝmrab (40). <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />Kwɔ Fuh ilǝ Skol kwɔ, Fuh ji yigwoi Dkoda, Fuh gei ba lolǝ angǝ: &lt;Ən tǝi Dkoda yui Yesse yuu a kwɔ dǝm yiɗi ɓǝ, Yiɓǝi kwɔ a tonung kwɔ ǝndǝi dǝm yiɗi ɓǝ.&gt; <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />Ən Yeso, ya bǝpi gi Dkoda, yuu kwɔ Fuh dulǝ ya nwonglo ya Israila ɓǝ, manung kwɔ u gwabǝi nwa ɓǝ. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />Nwuni bǝ Yeso a baipi nungto gu, Yohanna gei ba gi Fuh lǝ ya Israila tthǝ angǝ i mǝrrǝm i yithǝ nung a ɓko gi yang i wollimung. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />Kwɔ Yohanna dǝna alo nungto gu, u gei yayuu angǝ,&lt;&lt;Dǝɓa nhǝm ɓangǝ ɓang ǝn yittǝn? Ɓang ǝn yuu kwɔ dǝɓa kiǝ ɓǝ lǝu. Kwoi ɓalǝ! Dǝu wua tthasuam lǝ, ǝn ɓuan kwɔ mǝn ilǝ ǝko bo ɓǝu.&gt;<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />&lt;&lt;Ya youngǝm ya Israila, ya bǝba gi Ibrahim, i ya kwɔ ǝn ya Yahudawa lǝu kwɔ dǝna wab Fuh kwɔ: i tumbǝi i ba bǝ nwongbǝi lǝn sua ɓi! <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />Ba kwɔ ya Urshalima i yakku gi ibǝi kwɔ Yeso lǝ ya nwonglo lǝu ɓǝ, bǝ tthǝu kwɔ ǝǝ lǝ bǝ yinwa ya gei ba a tthasi kwɔ dǝi tthan vii nwongǝi ɓǝ. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />Kwɔ i tǝu i nung a ɓko kwɔ i tou kwan ɓua tthǝ lǝu, i gei Bilatus angǝ i tthǝu. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />Kwɔ i tonung kwɔ nungvullǝ gei ǝndǝi lǝba gu, i pin i u lǝ lo kabgangǝ i lǝ tǝi du dang juǝn. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />Kwoi Fuh ǝrrǝulǝ dang bǝ ɓuiɓua,<verse eid="ACT 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 13:31" />langkwoi dang bo kpaatthǝ u fuk tthǝ ya kwɔ tthko suattha i ulǝ Galili tǝlǝ Urshalima ɓǝ. I lǝ ya gei nwuo lǝ ya Israila tthǝ. <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />Ɓi gei ɓǝ ba a langǝ i tthǝ: Nung kwɔ Fuh gwap nwa lǝ ya bǝba ɓi tthǝ angǝ i toi tthǝ ɓǝ, <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />la kwɔ u toɓi thǝng, ɓi ya bǝba gu, ɓi ya bǝpi gi, kwɔ u ǝrr lǝ Yeso i nwongǝi ɓǝ. Kwɔ i vulǝ dang Zabura arab angǝ,</para>
  <para style="p" vid="ACT 13:33">&lt; Mǝn yuim;</para>
  <para style="q1" vid="ACT 13:33">ɗigǝ kwɔ ǝn mǝrǝm lǝ Daamǝng.&gt; <verse eid="ACT 13:33" /><verse number="34" style="v" sid="ACT 13:34" />Nung kwɔ lǝ nung kwɔ Fuh gei lǝ ba bǝ ǝrrǝulǝ i nwongǝi bǝ ɓuiɓua ɓǝ, bǝ u zuu dang ɓua tthǝ:</para>
  <para style="p" vid="ACT 13:34">&lt;Mǝn dǝɓǝ nung a langǝ i i bǝ khanalo kwɔ ǝn gwab nwa lǝ Dkoda ɓǝ.&gt; <verse eid="ACT 13:34" /><verse number="35" style="v" sid="ACT 13:35" />La langǝ i kwɔ u gei dang nungvullǝ bǝi kun angǝ:</para>
  <para style="q1" vid="ACT 13:35">&lt;A gwab ya thǝb a langǝ i mǝ zuu dang juǝn lǝu.&gt; <verse eid="ACT 13:35" /><verse number="36" style="v" sid="ACT 13:36" />Dkoda tonungto kwɔ Fuh dǝna yiɗi lona bǝ loyigwoi gu, nung kwɔ langkwoi u ɓui, i suu i ya bǝba gu, nung kwɔ u zuu dang ɓua. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />Kwoi yuu kwɔ Fuh ǝrr lǝ dang bǝ ɓuiɓua kwɔ zuu lǝu.<verse eid="ACT 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38" />Dǝɓi yiɗi ɓa ibǝi, ya youngǝm ya Israila, tthǝn tthǝ Yeso nung kwɔ ba bǝ al nung a ɓko lǝtǝ i gei ɓǝ tthǝ; <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />langkwoi yuu kwɔ ǝndǝi dǝba a langǝ i tthǝu i iu lǝng nung a ɓko kwɔ zuu gi Musa ɓuan iɓǝ lǝu ɓǝ. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />Ɓato kiggǝ la langǝ i, yang bǝ bǝ ba kwɔ ya gei ba a tthasi tǝi ɓǝ tthǝ:<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />&lt;Ɓa ɓyǝa, ɓǝ ya tthǝm bǝi! Kiggǝ ɓǝ ǝrr lo ɓǝ fǝm ɓa ɓui!</para>
  <para style="q2" vid="ACT 13:41">Ba kwɔ nung kwɔ dǝm to ɗiggǝ kwɔ</para>
  <para style="q2" vid="ACT 13:41">ǝn nung kwɔ ɓa dǝba a langǝ i tthǝ ɓǝ lǝu,</para>
  <para style="q2" vid="ACT 13:41">ko yuu a kun mab ɓǝ nungǝu thǝ!&gt;&gt;&gt;<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />Kwɔ i Bulus i Barnabas dǝna yi tthǝ kǝm kǝbtha ya Yahudawa ɓǝ, yayuu ɓǝ gei angǝ ɓa kwoi sua ɓǝ vii nwongǝi a kwɔ da wɔ kwɔ ɓǝ wuu ɓa li ɓi lo ba kwɔ a kun. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />Kwɔ yayuu yǝbtha bǝ kǝbtha ya Yahudawa, ya Yahudawa i ya kwɔ ǝn ya Yahudawa lǝu kwɔ kpaatthǝ muosua Bulus i Barnabas i ya kwɔ kwoi tǝ Yahudanci ɓǝ. Ya nwatummi gi Yeso gei angǝ i ǝǝ dang nung a langǝ i gi Fuh lalangǝ i.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />Vii nwongǝi ya Yahudawa wɔ yayuu ǝndǝi gwoi angǝ a lǝ wuo bǝ lǝ ba gi Dangbang.<verse eid="ACT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="ACT 13:45" />Kwɔ ya Yahudawa ɓyǝa kon kwɔ, i to dasi ghaatthǝ; dǝi nyim nwa Bulus dǝnni dalǝu i ɗyǝm. <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />Kwoi Bulus i Barnabas lilo bǝ gei ba i tthǝ nyimmi angǝ&lt;&lt;Maɗing kwɔ ɓi osi ɓi gei ɓǝ ba Fuh tthǝ lanungsi. Kwoi nǝ ɓa la ɓa ɓyǝa loɓǝ ɓangǝ ɓa natthǝ kwɔ ɓa tǝi nwongǝi a ɗing lǝu, yidɗi gwoi Fuh lǝu, ɓi yiɓǝ ɓitǝ ɓi tǝ sua yakwɔ ǝn ya Yahudawa lǝu ɓǝ. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />Ba kwɔ ǝn zuu kwɔ Dangbang dǝɓi ɓǝ:</para>
  <para style="p" vid="ACT 13:47">&lt;Ən mǝrrǝm ɓǝ lǝ lua thǝ ya kwɔ ǝn ya Yahudawa lǝu,</para>
  <para style="q1" vid="ACT 13:47">yang bǝ wulǝ nwongǝi longwam ǝndǝi.&gt;&gt;&gt;<verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />Kwɔ ya kwɔ ǝn ya Yahudawa lǝu kwɔ lǝ nung kwɔ, i lǝ tthǝla dǝnni kha ba gi Dangbang; ya kwɔ mko lǝ ba nwongǝi a ɗing kwɔ dǝba a langǝ i tthǝ ba Fuh.<verse eid="ACT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49" />Ba gi Dangbang yǝb lǝi losua ɓǝ ǝndǝi. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />Kwoi ya Yahudawa ɗam yasi ya nung tǝi kwɔ dǝna wab Fuh i yaɓǝi ya dǝi si gwoi angǝ a ɓǝ. Ərr i baipi bǝ ǝrr lǝ kiggǝ Bulus i Barnabas, langkwoi i nanni losua gilǝ. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />Ya nwatummi gi Yeso kusungnhǝ kunɗur boi yang bǝ ǝǝ lǝ shǝdǝ loi i pa i tǝ Ikoniya. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />Ya dǝba a langǝ i tthǝ Fuh dang Antakiya tthǝi la ǝndǝi langkwoi i tthǝla ya Ɓyang a Langǝ i.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s1">Bulus I Barnabas Dang Ikoniya</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />Nung a kun ɓǝ langkwoi tonung dang Ikoniya: Bulus i Barnabas tǝ kǝm kǝptha ya Yahudawa gei ba lonung lǝi kwɔ ya Yahudawa i ya kwɔ ǝnya Yahudawa lǝu kpaatthǝ mǝrrǝm lǝ ya dǝba langǝ i tthǝ Fuh. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />Kwoi ya Yahudawa kwɔ dǝba a langǝ i tthǝ Fuh lǝu kwɔ ǝrr ɗam ya kwɔ ǝn ya Yahudawa lǝu kwɔ ǝrr tthǝ ya dǝba a langǝ i. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />Nung kwɔ Bulus i Barnabas ǝǝ bǝilǝ sua tutthǝ, dǝnni gei ba i tthǝ nyimmi ba gi Dangbang, kwɔ gwabǝi tthǝ angǝ ba gi lǝ ba nung a langǝ i nung kwɔ dǝna ji tthǝ nyimmi dǝi to nung fǝmlo i nung tthǝvuli. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />Lo ya gwoi angǝ a ɓǝ gab tha: ya kun sua ya Yahudawa ya kun sua ya nwatummi gi Yeso.<verse eid="ACT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5" />Yang ya kun dang ya kwɔ ǝn ya Yahudawa lǝu kwɔ i ya Yahudawa i ya dǝkab nwa nung i, to nung a ɓko lǝ ya nwatummi i wai i tal. <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />Kwɔ ya nwatummi lǝ nung kwɔ, ǝrr i sur itǝ gwoi angǝ a Likoniya kwɔ lǝ Listira ɓǝ i Darba, i gwoi a kwɔ kwari ɓǝ. <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />Bǝilǝ kwɔ i ǝǝ nwa bǝ gei ba a langǝ i gi Fuh tthǝ.<verse eid="ACT 14:7" /></para>
  <para style="s">Shawulu I Barnabas Dang Listira I Darba</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />Dang Listira yiɓǝi a kun tthǝ i siu u ɓuan u thko thko dǝu o tthko lǝ o u thko lǝu bo kun. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />U ǝǝ bǝilǝ dǝnnu lǝ ba kwɔ Bulus dǝna gei ɓǝ. Bulus ɓyǝko dang nungǝu lǝ, ɓyǝa utthǝ i bǝ dǝba a langǝ i kwɔ u tǝi tthǝla ǝntǝi ɓǝ <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />u gei i yol angǝ a angǝ,&lt;&lt;Ərr a dǝinǝbo i bomǝ!&gt;&gt;Yiɓǝi ɓǝ ǝrr dǝinǝbo baipi bǝ thko thko. <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />Kwɔ kon ɓǝ ɓyǝa nung kwɔ Bulus to kwɔ, ǝrr i baipi bǝ buogbǝi i nwagwoi ya Likoniya angǝ,&lt;&lt;fuh mǝrǝm mangǝn thayuu wuo sua ɓi!&gt;&gt; <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />I dǝ ɗuǝn lǝ Barnabas angǝ Zafsa, langkwoi Bulus angǝ Hamisa, ba kwɔ u lǝ yikku ya gei ba ɓǝ. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />Yikku nyǝknung fuh Zafsa, kwɔ bǝ nyǝknung gu mual gwoi angǝ a lǝ kwɔ, wulǝ nyak i vin kab lǝ nwalǝgwoi ɓǝ, ba kwɔ u i kon ɓǝ dǝnni yiɗi bǝ nyǝknung lǝ ba ya nwatummi gi Yeso ɓǝ.<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />Kwoi kwɔ Barnabas i Bulus lǝ nung kwɔ dǝnni yiɗi bǝ tou kwɔ, ǝrr i trǝ nunglitthǝ gi i surdum i tǝ ganglang yayuu ɓǝ, dǝnni buogbǝi angǝ, <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />&lt;&lt;Ən baɓǝ bǝ dǝɓa tonungkwɔ? Ɓi i naɓi ǝn yayuu manungɓǝ! Ɓi wuo bǝ gei ɓǝ nwa ba a langǝ i tthǝ, yang bǝ ɓa mǝrrǝm ɓa yi tthǝ nung a nǝkwam kwɔ ɓa wɔ sua Fuh ya nwongǝi, kwɔ mab wayi, pangsua, nwam, i nung kwɔ dang ǝi ǝndǝi ɓǝ. <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />Vii kwɔ nung si u yiǝ yayuu ǝndǝi dǝna to nung kwɔ i yiɗi ɓǝ.<verse eid="ACT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 14:17" />Kwoi Fuh vii ǝndǝi dǝna to nung a langǝ i kwɔ dǝu to ɓǝ: dǝu dǝɓǝ mung wayi lǝ i nungbyǝa lona a langǝ i; dǝu dǝɓǝ nungtang mung wayi i nungbyǝa lona a langǝ i; dǝu dǝɓǝ nungtang langkwoi yi lonyi ɓǝ i tthǝla.&gt;&gt; <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />I bagi kwɔ ǝndǝi, i ɓuan i nan kon yayuu ɓǝ bǝ nyǝknung tthǝi lǝ lǝu.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />Yang ya kun dang ya Yahudawa wɔ Antakiya dang Bisidiya i Ikoniya; i gub kon ɓǝ i tǝlǝ tthǝi, i wa Bulus i tal i gubbu i ilǝ gwoi angǝ a lǝ dǝnni ɓyǝa angǝ lko u ɓuing.<verse eid="ACT 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 14:20" />Kwoi kwɔ ya dǝba a langǝ i tthǝ Fuh kwɔ wua gǝm tha lo, u ǝrr u kwoi u tǝ gwoi angǝ a ɓǝ. I bǝikan u i Barnabas i kwoi i tǝ Darba.<verse eid="ACT 14:20" /></para>
  <para style="s">Bǝ Kwoi Gi Shawulu I Barnabas Itǝ Antakiya Dang Suriya</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />Bulus i Barnabas gei ba a langǝ i gi Fuh gwoi angǝ a lǝ kullo i tǝi yayuu kpaatthǝ lǝ ya nanungto. Yang i kwoi suai i tǝ Listra, Ikoniya i Antakiya dang Bisidiya, <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />I dǝ ttha lǝ ya dǝba a langǝ i langkwoi i ji tthǝ nyimmi angǝ i dǝi nyimtthǝ i dǝ nyiǝ tthǝ Fuh. I gei angǝ,&lt;&lt;Ɓi lǝ tthǝzi ɗing yang bǝ ɓi tǝ bǝi kwɔ Fuh lǝ yigwoi ɓǝ,&gt;&gt; <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />Bulus i Barnabas pinwa i mko ya kun dang ǝi lǝ yakku kǝm pinwa kwɔ ǝndǝi, i bǝ pinwa i bǝ zuu fuh, i ji dang na Dangbang, kwɔ i dǝ ba a langǝ i gi tthǝ ɓǝ.<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />Kwɔ i thko dang Bisidiya, i kwoi i tǝ Bamfiliya. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />Bǝilǝ kulo i gei ba gi Fuh dang Bariyata langkwoi i kwoi i tǝ Ataliya,<verse eid="ACT 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 14:26" />Langkwoi bǝilǝ kulo i ɗab kwai i tǝ Antakiya, bǝilǝ kwɔ i toi sakko tthǝ nung to gi Fuh ba nung to kwɔ i alo ɓǝ.<verse eid="ACT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27" />Kwɔ i tǝ dang Antakiya, i gǝm ya kǝm pinwa bǝ yikun i gei ba nung kwɔ Fuh to i ilǝ langkwoi kwɔ u ɓko lǝi lǝ ya kwɔ ǝn ya Yahudawa lǝu kwɔ dǝba a langǝ i tthǝ Fuh ɓǝ. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />Langkwoi i ǝǝ bǝilǝ sua tutthǝ kpaatthǝ i ya dǝ ba a langǝ i tthǝ Fuh.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">Bǝ Kǝb Tha Urshalima</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />Yaɓǝi a kun ǝrr Yahudiya tǝ Antakiya dǝna nanatthǝnung lǝ ya dǝ ba a langǝ i angǝ,&lt;&lt;Ɓa tǝi nwongǝiu nǝ ɓa ɓǝr nwa ɗuǝ ɓǝ ɗǝ manung kwɔ zuu gi Musa gei ɓǝ.&gt;&gt; <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />Bulus i Barnabas tǝbǝ nyimtha nwa i ilǝ lo ba ɓǝ lǝ, nung kwɔ i gei angǝ Bulus i Barnabas i ya kun dang Antakiya yang i ǝrr Antakiya i tǝ Urshalima tǝi ɓyǝa ya nwatummi gi Yeso i yakku lo ba ɓǝlǝ.<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />Ya kǝm pinwa ǝrr tummǝi i pa; i mua nunglǝi Finikiya i Samariya, dǝnni gei lǝ yayuu tthǝ ba kwɔ ya kwɔ ǝn ya Yahudawa lǝu kwɔ mǝrrǝm mua sua Fuh ɓǝ; ya kwɔ dǝba a langǝ i tthǝ Fuh kwɔ lǝ tthǝla ba bakwɔ i lǝ ɓǝ. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />Kwɔ i tǝ dang Urshalima, ya kǝm pinwa mui na rab, ya nwatummi gi Yeso, i yakku, gei nwaba nung kwɔ ǝndǝi kwɔ Fuh toitthǝ ɓǝ. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />Yang ya kun dang ya kwɔ dǝba a langǝ i tthǝ Fuh i ya Farisiyawa kwɔ ǝrr dǝinǝbo gei angǝ,&lt;&lt;Ya kwɔ ǝn ya Yahudawa lǝu i ɓǝr nwa ɗuǝi langkwoi yang i tonungto i zuu gi Musa.<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />Ya nwatummi gi Yeso i yakku kǝbtha bǝ yikun yang bǝ i ɓyǝa bǝ ɓib ba kwɔ. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />Tthasua kwɔ i nyimtha nwa sua tuutthǝ, Bitrus dǝinǝbo gei angǝ; &lt;&lt;Ya ǝnthǝm, ɓa ibǝi lona a tthasua kulo tutthǝ Fuh mko ǝn ɓang dang ɓǝlǝ angǝ ǝn gei ba a langǝ i lǝ ya kwɔ ǝn ya Yahudawa lǝu ɓǝ, yang bǝ i lǝ i dǝba a langǝ i tthǝ. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />Langkwoi Fuh, kwɔ ibǝ bǝ nhǝm bagi yayuu ǝndǝi, U gwab nwa bagi ya kwɔ ǝn ya Yahudawa lǝu kwɔ U ji ya Ɓyang a Langǝ i, manungkwɔ U to ɓitthǝ ɓǝ. <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />U wulǝ bǝ gab ganglang ɓi i ilǝ lǝu; U al nung a ɓko gi lǝtǝ bakwɔ i dǝba a langǝ i tthǝu ɓǝ. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />Nung kwɔ yang, ǝn baɓǝ bǝ la kwɔ dǝɓa na Fuh ibǝ dǝ nung a ɓuoni lo ya kwɔ dǝba a langǝ i kwɔ ya bǝba i ɓi kwɔ ɓi ɓuan ɓi lǝiu ɓa? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />Nilǝu! Ɓi dǝba a langǝ i tthǝ i nwong ɓi i nung a langǝ i gi Dangbang Yeso, manung a bǝi.&gt;&gt;<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />Yayuu ǝndǝi kǝrnwa nǝkwam dǝnni lǝ ba kwɔ i Barnabas i Bulus dǝna gei lo nung fǝmlo i nung dǝ tthǝvuli kwɔ Fuh ji i to ganglang ya kwɔ ǝn ya Yahudawa lǝu ɓǝ. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />Kwɔ i alo bǝ gei ba, Yakub gei ba angǝ: &lt;&lt;Ɓa lǝm, ya youngǝm yaɓǝi i yasi! <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />Siman la nwasiu gei angǝ Fuh nanatthǝ bǝ yiɗi bǝi gu dang ya kwɔ ǝn ya Yahudawa lǝu bakwɔ u lǝi ya kun dang ǝi mǝrrǝm lǝ yayuu gu ɓǝ. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />Ba ya gei ba a tthasi natha ǝndǝi i nung kwɔ. Manungkwɔ ba gi Fuh gei angǝ:<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />&lt;Tthasua nung kwɔ Mǝn kwoi mǝn wua,</para>
  <para style="q2" vid="ACT 15:16">wuo mǝn mai losua yigwoi Dauda.</para>
  <para style="q1" vid="ACT 15:16">Mǝn mai nung kwɔ drǝ kwɔ ɓǝ</para>
  <para style="q2" vid="ACT 15:16">langkwoi mǝn mai nyimtthǝ langkwoi.<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />Yang sua ya nwa akun ǝndǝi a wua suam,</para>
  <para style="q2" vid="ACT 15:17">i yakwɔ ǝn ya Yahudawa lǝu kwɔ ǝn lubǝi i mǝrrǝm lǝ abǝm.<verse eid="ACT 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18" />Manung ɓǝ Dangbang gei, U gei baɓǝ tuung.&gt;<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />&lt;&lt;A kwɔ ǝn bam,&gt;&gt;Yakubu lilotthǝ gei angǝ,&lt;&lt;bǝɓi dǝzuii lǝ ya kwɔ ǝn ya Yahudawa lǝu kwɔ mǝrrǝm dǝna muo sua Fuh. <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />&lt;&lt;Manungkwɔni yang, ɓi vullǝi nung tthǝ ɓi geitthǝ bǝ i tang nungtang akwɔ mko ɓǝthǝ bakwɔ ɓanglǝng i nung wab bǝi; i yitthǝ nung a ɓko bǝ lo i yisi i yiɓǝi; langkwoi bǝ i tang nyam akwɔ i prǝm ɗullu i thǝu ɓǝtthǝ, ko ǝn zii. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />Ba kwɔ i than zuu gi Musa lona tuu ɗing dang kǝm kǝbtha vii nwongǝi ya Yahudawa vii ǝndǝi.&gt;&gt;<verse eid="ACT 15:21" /></para>
  <para style="s">Nungvullǝ Kwɔ I Dǝlǝ Yadǝ Ba A Langǝ i Kwɔ Ənya Yahudawa Lǝuɓǝ</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />Nung kwɔ ya nwatummi gi Yeso i yakku, suattha i ya kǝm pinwa ǝndǝi, gwab i mko yayuu gi i tummǝi i tǝ Antakiya suattha i Bulus i Barnabas. I mko yayuu rab kwɔ yayuu dǝna ji angǝ a ya kwɔ dǝba a langǝ i tthǝ Fuh ɓǝ, Yahuza, kwɔ dǝnni luu ɗuǝnu angǝ Barsaba ɓǝ, i Sila, <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />nung kwɔ i tummǝi i nungvullǝ kwɔ angǝ:</para>
  <para style="pi" vid="ACT 15:23">&lt;&lt;Ɓi, ya nwatummi gi Yeso i yakku, ya young ɓǝ, dǝɓi tumbǝi i bǝ gumbǝi sua ya young ɓi ya kwɔ ǝn ya Yahudawa lǝu kwɔ i siǝ dang Antakiya ɓǝ, i Suriya, i Kilikiya. <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />Ɓilǝ angǝ ya kwɔ i dang ɓi kwɔ ǝnɓi ɓi gwabǝi tthǝ lǝu kwɔ i idang ɓi dǝnni ɓar ɓǝ, dǝnni nya nyi ɓǝ i nung kwɔ dǝnni gei ɓǝ, ǝnɓi ɓi tummǝi lǝu. <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />Nung kwɔ la kwɔ ɓi kǝb tha ɓi mko ya nwatummi ɓi tum suaɓǝ. I tǝ suattha i ya ǝnthǝ ɓi Barnabas i Bulus, <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />ya kwɔ dǝ nwongǝi gi dang nungto gi Dangbang Yeso. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />Manungkwɔ ni yang, ɓi tum, Yahuza i Sila, i inailǝ wui gei ɓǝ ba dang nung lo nung kwɔ ɓi vullǝ ɓǝ. <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />Ɓyang A Langǝ i i ɓilǝ ɓi gwab lǝ tha tthǝ angǝ bǝɓi dǝɓǝ nung a ɓoni lo nung kwɔ lǝ nung a langǝ i ɓǝthǝ ɓa to nung kwɔ ɓi gei la kwɔ ɓǝ: <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />bǝ ɓa tang nungtang a kwɔ i nyǝk lǝ nung tthǝ nungwabǝi ɓǝ thǝ, bǝɓa tang i ziiu thǝ, ɓa tang nyam nungbyang a kwɔ i prǝm ɗullu ɓǝthǝ, bǝ ɓa lo i yasi yayuu nǝkwam thǝ. Ɓa ǝǝ latthǝ nǝɓa yitthǝ bǝ tonung kwɔ ɓi gei ɓǝtthǝ ɓǝ. Ɓato maɗing nǝɓa yitthǝ bǝ tang i nung ɓǝ kwɔ ɓǝ. Əǝ latthǝ.<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />I tum ya nwatumi ɓǝtǝ Antakiya, tǝi gǝm ya kwɔ dǝba a langǝ i tthǝ Fuh lǝ kwɔ i ji nungvullǝ ɓǝ. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />Kwɔ yayuu ɓǝ than nungvullǝ ɓǝ, i lǝ tthǝla ghaatthǝ ba kwɔ nungvullǝ kwɔ ji tthǝnyimmi ɗing ɓǝ. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />Yahuza i Sila, i inailǝ i ǝn ya gei ba a tthasi, i gei ba lona sua tutthǝ i ilǝ, i gei ba i ji tthǝ nyimmi i ttha. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />Tthasua kwɔ i ǝǝ sua tutthǝ bǝilǝ kwɔ, ya dǝba a langǝ i tthǝ Fuh ɓǝ ǝrr yǝri nwa dang tthǝla i kwoi i tǝsua ya kwɔ tummǝi ɓǝ. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />Kwoi Sila abo ǝǝ bǝilǝ.<verse eid="ACT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 15:35" />Bulus i Barnabas ǝǝ natthǝ tuab dang Antakiya, bǝilǝ kwɔ i iya kun kpaatthǝ nanatthǝ nung lankwoi i gei bagi Dangbang tthǝ.<verse eid="ACT 15:35" /></para>
  <para style="s">Bulus I Barnabas Gabtha</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />Natthǝ tuab nung kwɔ Bulus gei Barnabas angǝ,&lt;&lt;Ɓi kwoi sua ɓi tǝɓi ɓyǝa ya kwɔ mǝrrǝm lonyi dǝna muosua Fuh losua kwɔ ǝndǝi ɓi gei bagi Dangbang tthǝ ɓǝ, yang ɓi ɓyǝa nung kwɔ dǝnni to ɓǝ.&gt;&gt; <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />Barnabas dǝna yiɗi bǝ lǝi Yohanna Markus i pa suatha, <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />Kwoi Bulus dǝna nhǝm angǝ ǝn lona a langǝ i kwɔ itǝ sua tha i u lǝ ɓǝlǝu, ba kwɔ u thko suatha i ilǝ lǝu dang bǝ toba gi Fuh lǝ ɓǝ, u kwoi suai Bamfiliya lǝ. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />Bǝ nyimnwa ǝrr ganglangǝ i ɓuontthǝ, ǝrr i gab tha: Barnabas ǝrr lǝi Markus i ɗab kwai i nyang i tǝ Kubrus. <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />Nung kwɔ Bulus ǝrr lǝi Sila i pa, nung kwɔ ya dǝba a langǝ i tthǝ Fuh yam Fuh bagi angǝ Dangbang muna tthǝi. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />U pa dang Suriya i Kilikiya, dǝnnu nyimtthǝ yayuu kǝm pinwa angǝ i dǝi nyimtthǝ.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">Timitawos Muo Suatha I Bulus I Sila</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />Bulus lilo tthǝ tǝ Darba i Listira, bǝi lǝ kwɔ ya nanungto a kun tthǝ ɗuǝnnu ǝn Timitawos. Naa gu, ǝn ya Yahudawa, u ǝn ya dǝba a langǝ i tthǝ Fuh, kwoi daa guu ǝn ya Helenawa. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />Ya dǝ ba a langǝ i tthǝ Fuh ǝndǝi kwɔ dang Listira i Ikoniya kwɔ dǝna gei ba a langǝ i lolǝ. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />Bulus dǝna yiɗi bǝ pa suatha i Timitawos, nungkwɔ u ɓǝr nwa ɗuǝu. U to manung ɓǝni lǝ ba kwɔ u ibǝi ya Yahudawa kwɔ bǝilǝ kwɔ ibǝi Daa gi Timitawos ǝn ya Helenawa ɓǝ. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />Kwɔ dǝnni thko dang gwoi angǝ a lǝ, i gei zuu kwɔ ya nwatummi yakku dang Urshalima gwab lǝ tha lǝ ya dǝ ba a langǝ i tthǝ, yang bǝ i tolǝ nungto. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />Nung kwɔ tthǝ ya kǝm pinwa ǝrr nyim dang bǝ dǝ nyi langkwoi loi dǝna kpaa vii ǝndǝi.<verse eid="ACT 16:5" /></para>
  <para style="s">Monni Gi Bulus Lo Yiɓǝi Ya Makidoniya</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />Bulus i ya ǝnthǝu i pa i tǝ Firijiya i Galatiya ba kwɔ Ɓyang a Langǝ i nanni bǝ gei ba gi Fuh dang Asiya ɓǝ. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />Kwɔ i tǝ lo ɓyǝn Misiya, dǝnni yiɗi bǝ tǝ losua Bitiniya, kwoi Ɓyang gi Yeso gwabǝi tthǝ lǝu. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />Nung kwɔ i mǝrrǝm Misiya i tǝ Taruwasa. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />Nung vii ɓǝlǝ kwɔ Bulus monmoni ɓyǝa yiɓǝi a kun ya Makidoniya dǝi dǝna yammu angǝ,&lt;&lt;A wuo Makidoniya wa nwong ɓi!&gt;&gt; <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />Dang tthǝ kwɔ Bulus monmoni kwɔ ni, ɓi ǝrr ɓi mab nung na ɓi yang bǝ ɓi pa lǝi Makidoniya, ɓi gei ɓingǝ ǝn Fuh lubǝ ɓi tǝɓi gei ba a langǝ i lǝ yayuu tthǝ bǝi lǝ.<verse eid="ACT 16:10" /></para>
  <para style="s">Bǝ Mǝrrǝm Gi Lidiya Ya Filibi</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />Ɓi ǝrr Taruwasa ɓi ɗab kwai ɓi tǝ Samutaraki, langkwoi i bǝikan nung kwɔ ɓi tǝ Niyabolis. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />Bǝilǝ kulo ɓi tǝ Filibi, gong gwoi a nungsi losua Makidoniya; lang ɓǝ ǝn losua kwɔ ya Romawa mua ɓǝ. Ɓi ǝǝ bo kpaaɗing bǝi lǝ. <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />Vii nwongǝi ya Yahudawa ɓi i dang woi angǝ a lǝ ɓi tǝ nwa mung, dǝɓi nhǝm lko ya kun ɓi tǝi bǝi kwɔ ya Yahudawa a gǝmtha tthǝ a pinwa ɓǝ. Ɓi ǝǝ bǝi lǝ ɓi gei ba lǝ yasi kwɔ gǝmtha bǝi lǝ ɓǝ. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />Yuu kun dang ya kwɔ lǝ ba ɓi kwɔ ǝn Lidiya u ǝn ya Tayatira, u ǝn ya mel nunglitthǝ ya nung tǝi kwɔ la thǝni ɓǝ. U ǝn yisi kwɔ dǝna wab Fuh ɓǝ, nung kwɔ Dangbang ɓko lo nyiu u dǝ kiggǝu tthǝ ba kwɔ Bulus dǝna gei ɓǝ. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />Kwɔ i wollu mung i ya dang gwoi gu, ǝrr u gei ɓi angǝ,&lt;&lt;Ɓa wɔ gwoim wuɓa ǝǝ tthǝ nǝɓa gwab ɓangǝ ɓang ǝn ya muosua Dangbang a langǝ i ɓǝ&gt;&gt;Nung kwɔ u ɓarɓi ɓi tǝ gwoi gu.<verse eid="ACT 16:15" /></para>
  <para style="s">Bǝ Tthǝb Bulus I Sila Pursǝna Dang Filibi</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />Vii a kun kwɔ dǝɓi tǝbǝ pinwa, wuɓi kǝbtha i tthǝb munthang a yisi akun wa a ɓko tthǝu kwɔ dǝna tou dǝnnu ɓyǝa bung ɓǝ. Dǝnnu tǝi nungkurɓǝ lǝ ya togwoi gu tthǝ babǝ gei nung a langǝ i kwɔ a tǝi yayuu ɓǝ. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />Munthang a yisi kwɔ muo sua Bulus i ɓilǝ, dǝna buogbǝi angǝ, &lt;&lt;Yaɓǝi kwɔ ǝn ya thǝb gi Fuh Ya Angã, kwɔ dǝna gei ɓǝ nung lǝi kwɔ ɓa tǝi nwongǝi ɓǝ.&gt;&gt; <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />U to nung kwɔ bo kpaaɗing, dang wa Bulus ǝrr ɓanglǝ ǝrr mǝrrǝm tthasuko u gei ɓyang a ɓko ɓǝ angǝ, &lt;&lt;Dang ɗuǝn Yeso Kristi dǝmǝn dǝkab nwamǝ a i dang tthǝu!&gt;&gt; Dang tthǝ ɓyang a ɓko ɓǝ ǝrr i tthǝu lǝ. <verse eid="ACT 16:18" /><verse number="19" style="v" sid="ACT 16:19" />Kwɔ ya togwoi gu ɓyǝa nung lǝi bǝ tǝi nungkurɓǝ gi lamǝng, ǝrr i mua i Bulus i Sila i gubbǝi i tǝi lǝ nwa lomu tthasi ya gei kwan. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />I wuilǝ tthasi ya thǝlbo ya Romawa i gei angǝ,&lt;&lt;Yaɓǝi kwɔ ǝn ya Yahudawa, dǝnni wulǝ nung a ɓko lǝ losua gwoi angǝ a ɓi. <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />Dǝnni nanatthǝ nung lǝi kwɔ zuu ɓi gwab lǝu ɓǝ; ɓi ǝn ya Romawa, langkwoi ɓi mua nung lǝi kwɔu ko ɓi tolǝ nungtou. <verse eid="ACT 16:21" /><verse number="22" style="v" sid="ACT 16:22" />Langkwoi kon ǝndǝi al dang bǝ mua Bulus i Sila.</para>
  <para style="p" vid="ACT 16:22">Nung kwɔ yakku ɓǝ ǝrr mua nunglitthǝ gi Bulus i Sila trǝ i gei yayuu angǝ ɓuoi i thab.<verse eid="ACT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 16:23" />Tthasua a kwɔ i ɓuoi lǝ tthǝ kwɔ, i lǝi tǝi tthǝb, i gei ya tthǝb bǝi ɓǝ kiǝ matthǝ. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />I ba a nyimi kwɔ i geiu lǝ kwɔ, ya tthǝb bǝi tǝi lǝ bǝ tthǝb bǝi a ttha dang u tthǝb boi ganglang bǝlǝk a ɓuonni i tthǝ kab.<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />Nung vii nǝ kasua i Bulus i Sila dǝna pinwa i bǝ lu ɓiin tthǝ Fuh, sua ya pursǝna dǝsui tthǝi dǝna lǝi.<verse eid="ACT 16:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 16:26" />Dang tthǝ pangsua thǝuri nyimtthǝ, kwɔ thǝuri kǝm pursǝna ɓǝ wayi pin lǝ pikǝm ɓǝ, dang tthǝ nwakǝm pursǝna ɓko, langkwoi sarka kwɔ na ya pursǝna lǝ kwɔ bi. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />Ya tthǝb bǝi ɓǝ ǝrr nung nunglo, kwɔ u ɓyǝa nwakǝm pursǝna ɓko lǝ ɓko, dǝnnu nhǝm angǝ ya pursǝna ɓǝ sur paang, nung kwɔ u i lǝ khafǝi gu dǝu tǝbǝ thǝb lǝlo. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />Kwoi Bulus buogbǝi nyimtthǝ angǝ,&lt;&lt;Bǝ a thǝb tthǝmǝ thǝ! Ɓi tthǝ ǝndǝi!&gt;&gt;<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />Ya tthǝb bǝi lubǝi angǝ i wulǝ lua, u tǝ dang kǝm i dum dang tthǝ, tǝu o dang si Bulus i Sila. <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />Nung kwɔ u oi lǝ si i tǝ gwam tǝu ɓibbǝi angǝ,&lt;&lt; Yikku, ǝn ɓǝtǝn mǝn to bǝ ǝn tǝi nwongǝi?&gt;&gt;<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />I gwab nwa angǝ,&lt;&lt;A dǝ ba a langǝ i tthǝ Dangbang Yeso, yang ma tǝi nwongǝi- mǝ i ya dang woi mǝ.&gt;&gt; <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />Nung kwɔ i geiu ba Dangbang tthǝ i sua ya kwɔ dang woi lǝ ɓǝ. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />Dang lo nalǝ kulo nung vii ya tthǝb bǝi ɓǝ tǝ ɗiggǝ nunglua gi; nung kwɔ u i ya dang woi gu ǝndǝi i wolli mung nung kun. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />Nung kwɔ ya tthǝb bǝi ɓǝ lǝi Bulus i Sila tǝlǝ gwoi gu tǝ ji nungtang i tang. U i ya dang woi gu tthǝi la ǝndǝi, ba kwɔ i dǝba a langǝ i tthǝ Fuh ɓǝ.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />I bǝikan nungwoi ya dǝkab nwa nung ya Romawa tum yakku ya tthǝb thǝl i ba a nyimi angǝ,&lt;&lt;Ɓa yina lǝ yaɓǝi kwɔ pa.&gt;&gt;<verse eid="ACT 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 16:36" />Nung kwɔ ya tthǝb bǝi ɓǝ gei Bulus angǝ,&lt;&lt;Ya yakku tumbǝi i ba a nyimi sua mǝ i Sila angǝ ǝn yiɓǝ na. La kwɔ, ɓatǝ dang tthǝ la.&gt;&gt;<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />Kwoi Bulus gei yakku ya tthǝb thǝl ɓǝ angǝ,&lt;&lt; I tǝi ɓi i nung a ɓko lǝu, i la lǝi i ɓuob ɓi dang yayuu- Ɓi ǝn ya losua Romawa! Langkwoi tǝi tthǝb ɓi pursǝna. Langkwoi la kwɔ dǝnni yiɓi na dang bǝ pyǝa. Manung ɓǝ nilǝu! Yakku ya Romawa a wɔ bǝi kwɔ i nailǝ wui i ɓi lǝ.&gt;&gt;<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />Yikku ya tthǝb thǝl ɓǝ tǝlǝ baɓǝ lǝ sua yakku ya Romawa; langkwoi kwɔ i lǝ angǝ Bulus i Sila ǝn ya losua Romawa, tthǝvulli mui.&gt;&gt; <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />Nung kwɔ i tǝ tǝi ee nwa ɓko bagi tthǝi lǝ; nung kwɔ i iilǝ pursǝna ɓǝlǝ i gei angǝ i yitthǝ gwoi angǝ a ɓǝ lǝ. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />Bulus i Sila i pursǝna ɓǝlǝ i pa i tǝ gwoi gi Lidiya. Bǝi lǝ tǝi tǝi ya dǝba a langǝ i tthǝ Fuh, i ji tthǝ nyimi, nung kwɔ i ǝrr i pa.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">Bǝ ǝrrlǝ Kiggǝ Dang Tasalonika</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />Bulus i Sila thko dang Amfibolis i Aboloniya i tǝ Tasalonika, bǝi kwɔ kǝm kǝbtha ya Yahudawa tthǝ ɓǝ. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />Bulus patǝ kǝm kǝptha ya Yahudawa manung kwɔ dǝu to zǝǝ ɓǝ. Vii bǝ nwongǝi ya Yahudawa tai dǝu kǝptha dǝu gei ba i yayuu, dǝu ɓǝr nung thani <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />langkwoi dǝnnu gei nwa ba nungvullǝ ba Fuh tthǝ angǝ, Kristi a to zuii langkwoi a ǝrr bǝ ɓuiɓua.&lt;&lt;Yeso kwɔ dǝmǝng gei ɓǝ bagu tthǝ kwɔ ɓǝ, Bulus gei angǝ,&lt;&lt;u lǝ Kristi.&gt;&gt; <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />Ya kun dang ǝi gwab ǝrr muosua Bulus i Sila; i yasi yakku kpaatthǝ i ya Helenawa wɔ dǝna wab Fuh.<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />Kwoi ba zii ya Yahudawa nung kwɔ i gǝm ya ɓanglǝ gwoi nwalomu i gei i ǝrr lǝ yurrǝ. I ǝrr lǝ kiggǝ yayuu gwoi angǝ a lǝ i tǝ gwoi yuu a kun ɗuǝnnu ǝn Yason, dǝnni ɗubǝ Bulus i Sila yang bǝ i wuilǝ sua yayuu. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />Kwoi Kwɔ i tǝi lǝu yang, i gub Yason i ya kun dang ya dǝba a langǝ i i tǝlǝ sua ya dǝkab nwa nung dǝnni buogbǝi angǝ,&lt;&lt;Yaɓǝi kwɔ dǝna wulǝ yurrǝ lǝ losua ǝndǝi! La kwɔ i wuo gwoi angǝ a ɓing, <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />nung kwɔ Yason mui dǝ dang woi gu. Dǝnnu ɓanglǝ zuu Gong yigwoi losua, dǝnni gei angǝ yigwoi a kun tthǝ, ɗuǝnnu ǝn Yeso.&gt;&gt; <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />I ba kwɔ i li kon yayuu i ya dǝkab nwanung dang yurrǝ. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />Ya dǝkab nwa nung muo Yason i ya kun kwai nungkurɓǝ, nung kwɔ nwuni i yiǝ na, nung kwɔ i pa.<verse eid="ACT 17:9" /></para>
  <para style="s">Bulus I Sila Dang Biriya</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />Dangtthǝ bǝi gub ni, ya dǝba a langǝ i tuog Bulus i Sila tǝ Biriya. Kwɔ i tǝ dang Biriya, i pa i tǝ kǝm kǝbtha ya Yahudawa. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />Yayuu kwɔ bǝilǝ kwɔ lonyi kai pǝl a bǝ ya Tasalonika. I dǝsui tthǝ ba gi Fuh dang wa kun, langkwoi vii ǝndǝi dǝnni nanung vullǝ ba gi Fuh yang bǝ i ɓyǝa ko ǝn ba a langǝ i Bulus dǝna gei. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />I kpaatthǝ i dǝba a langǝ i tthǝ Fuh; langkwoi yasi ya Helenawa kwɔ lǝ ya angǝ a i yaɓǝi kpaatthǝ lang ɓǝ dǝba a langǝ i tthǝ Fuh. <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />Kwoi kwɔ ya Yahudawa kwɔ Tasalonika lǝ angǝ Bulus gei ba Fuh lǝ ya Biriya tthǝ lang ɓǝ, ǝrr i tǝ bǝi ɓǝ tǝi baipi bǝ ɗam kon yayuu angǝ i ǝrr lǝ kiggǝi. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />Dangtthǝ ya dǝ ba a langǝ i tuog Bulus angǝ u tǝ nwamung; kwoi Sila i Timitawos ǝǝ dang Biriya. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />Yaɓǝi kwɔ dǝsua lǝ Bulus kwɔ tǝu lǝ tutthǝ tǝi kǝn Atina nung kwɔ i kwoi suai i tǝ Biriya Bulus ji ba angǝ tǝi gei Sila i Timitawos tǝ tǝi thǝmtthǝ.<verse eid="ACT 17:15" /></para>
  <para style="s">Bulus Ghai Ba Fuh Dang Atina</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />Kwɔ Bulus dǝna ki Sila i Timitawos dang Atina, dang wko ɓanglǝ ba kwɔ u ɓyǝa nung a wab bǝi kpaatthǝ dang gwoi angǝ a lǝ ɓǝ. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />Nung kwɔ u ǝǝi ilǝ dǝi gei ba dang kǝm kǝbtha ya Yahudawa i ya kwɔ ǝn ya Yahudawa lǝu kwɔ dǝi wab Fuh ɓǝ, lang ɓǝ dang lomu i yayuu vii ǝndǝi ya kwɔ dǝna pa bǝilǝ ɓǝ. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />Ya nanatthǝnung ya Abikuriyawa i ya Sitokiyawa tǝbǝ nyimtha nwa i u lǝ. Ya kun gi dǝna ɓib angǝ,&lt;&lt;Ən ɓǝtǝn ya yuu kwɔ ibǝ nung lǝu ya lǝilo kwɔ dǝna yiɗi bǝ geiu?&gt;&gt;</para>
  <para style="p" vid="ACT 17:18">Yakun gwapnwa angǝ,&lt;&lt;Dǝɓi ɓyǝa mangǝ dǝnnu gei ba fuh a losua akun.&gt;&gt;I gei manungkwɔni bakwɔ Bulus dǝna gei ba Yeso i ba bǝ ǝrr gu i nwongǝi. <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />Nung kwɔ i muo Bulus i tǝu lǝ sua ya yakku, ya Tudun Arasa, tǝi gei angǝ,&lt;&lt; Dǝɓi yiɗi bǝ ibǝi bǝ nanatthǝnung a fuu kwɔ dǝma gei bko ɓǝ.<verse eid="ACT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 17:20" />Dǝma wulǝ nung a fuu lǝ ɓuasui ɓi, langkwoi dǝɓi yiɗi bǝ ibǝ nung kwɔ dǝma gei ɓǝ.&gt;&gt; <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />(Ba kwɔ ya losua Atina i ya kwɔ lǝ yayol kwɔ ǝǝ bǝilǝ kwɔ yiɗi bǝ tthǝb lona dǝna gei ba langkwoi dǝna lǝ ba a fuu.)<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />Bulus ǝrr dǝi nǝbo dang si yakku gei angǝ,&lt;&lt;Dǝmǝng ɓyǝa nunglǝi kwɔ ǝndǝi ɓǝ ya Atina ɓǝng ya to ba gi Fuh. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />Ba kwɔ dǝmǝng thko ganglang gwoi angǝ a bǝ kwɔ ǝn ɓyǝa bǝi kwɔ dǝɓa wab nung tthǝ kwɔ, ǝn tǝi bǝ nyǝknung a kun kwɔ i vulǝ nunglo angǝ,&lt;Fuh a kwɔ ɓi ibǝi lǝu ɓǝ.&gt;Kwɔ dǝɓa wab ɓǝ, langkwoi, kwɔ ɓa iu lǝu ɓǝ, u nung ɓǝ kwɔ dǝmǝng gei ɓǝ tthǝ ɓǝ. <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />Fuh, kwɔ mab longwam i nung ǝndǝi kwɔ dang ǝu ɓǝ, ǝn Dangbang ya wayi i pangsua langkwoi u ǝǝ kǝm pinwa kwɔ thayuu mai i na ɓǝu. <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />Langkwoi u yiɗi nung a kun kwɔ ɓi wulǝ kwɔ wa toulǝ nungto tthǝ ɓǝu, ba kwɔ ǝn u i nkolǝ u dǝɓi nwongǝi dǝɓi nwonglǝ i nung kwɔ u dǝɓi ǝndǝi ɓǝ. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />Bai piu tthǝ tha yuu a kun u mab ya nwagwoi ǝndǝi langkwoi u mabǝi i ǝǝ losua longwam ǝndǝi. U i nko lǝ u ibǝi lona langkwoi bǝi kwɔ yayuu a ǝǝ tthǝ ɓǝ. <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />U to manung ɓǝni yang bǝ i ɗubǝiu, yang bǝ i tǝiu i ǝǝ i u. Yangkwoi Fuh lalangǝ i tutha yuu kun dang ɓi lǝu. <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />Manungkwɔ yuu a kun gei ɓǝ angǝ,</para>
  <para style="q1" vid="ACT 17:28">&lt;Tthǝn tthǝu dǝɓi ǝǝ dǝɓi thko nwong dang longwam lǝ.&gt;</para>
  <para style="m" vid="ACT 17:28">Manungkwɔ ya vullǝ nung ɓǝ gei ɓǝ,</para>
  <para style="q1" vid="ACT 17:28">&lt; Ɓi lang ɓǝ ɓi ǝn yathang gu.&gt;<verse eid="ACT 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29" />Kwɔ nǝɓi ǝn yathang Fuh, bǝ ɓi lǝi ɓi angǝ kilǝngǝu mangǝn zinariya i azurfa ko i tal thǝ, kwɔ i kai i na yuu i bǝ ina nung thǝ. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />Vii kwɔ nungsi Fuh ɓyǝa yayuu lona kwɔ i iu lǝu ɓǝ, kwoi la kwɔ u gei yayuu ǝndǝi losua lǝ angǝ i mǝrrǝm lonyi i yi tthǝ nung a ɓko gi. <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />Ba kwɔ u dǝ vii kwɔ wuu gei kwan lo longwam ǝndǝi ɓǝ kwan a langǝ i ba gi Yuu kwɔ u mko ɓǝ. U tanatthǝ nung kwɔ lǝ yayuu ǝndǝi tthǝ bǝ ǝrr lǝ yiɓǝi kulo dang ɓua ɓǝ!&gt;&gt;<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />Kwɔ i lǝ Bulus gei ba bǝ ǝrr dang ɓua, ya kun dǝna tthagǝu, kwoi ya kun gei angǝ,&lt;&lt;Dǝɓi yiɗi a gei ba kwɔ a kun.&gt;&gt; <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />Nung kwɔ Bulus yi tthǝ bǝ kǝbtha ɓǝ. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />Yaɓǝi a kun muo suo dǝba a langǝ i tthǝ bagu, dang ǝi lǝ ǝn Diyonisiyas, u dang yakku ya Tudun Arasa; i yisi a kun tthǝ ɗuǝnnu ǝn Damarisa, i ya kun lǝ.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s1">Bulus Tǝ Koranti</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />Tthasua nung kwɔ, Bulus yi tthǝ Atina patǝ Koranti. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />Bǝilǝ tǝu tǝi ya Yahudawa a kun tthǝ ɗuǝnnu ǝn Akila, i siu Fantas, u ǝrr Italiya i siu Bilkisu, ba kwɔ Kalkodiyas nan ya Yahudawa angǝ i yi tthǝ Roma. Nung kwɔ Bulus tǝbǝ ɓyǝai, <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />yang bǝ tǝu ǝǝ u tonungto i ilǝ, ba kwɔ dǝnnu tonungto bǝ mab tǝbǝ dǝu tang lǝ lo, suatha i ilǝ manungkwɔ dǝi to ɓǝ. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />Dǝu ǝǝ dǝnnu gei ba dang kǝm kǝbtha ya Yahudawa vii nwongǝi, dǝnnu yiɗi bǝ mǝrrǝm ya Yahudawa i ya Helenawa.<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />Kwɔ Sila i Timitawos ǝrr Makidoniya wɔ, Bulus lǝi lona gu ǝndǝi bǝ gei ba gi Fuh lǝ yayuu tthǝ, dǝnnu gei lǝ ya Yahudawa angǝ Yeso ǝn Kristi. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />Kwɔ i nyim nwuo dǝnni gei nung a ɓko tthǝu lǝ, u kusungha kunɗur tthǝ nunglitthǝ gu dǝu gei angǝ,&lt;&lt;Nǝɓa la, kwan ǝǝ loɓǝ i naɓǝ lǝ! Bam yangǝu dang ǝu lǝu. Bai piu la kwɔ Mǝn tǝsua ya kwɔ ǝn ya Yahudawa lǝu ɓǝ.&gt;&gt; <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />Nung kwɔ u pa u tǝ tǝu lo gwoi yuu kwɔ ǝn ya Yahudawa lǝu ɓǝ ɗuǝnnu ǝn Titus Yistus, yuu kwɔ dǝna wab Fuh ɓǝ; gwoi gu gbag bǝ kǝbtha ya Yahudawa. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />Kirisbus, kwɔ ǝn yikku kǝm kǝbtha ya Yahudawa kwɔ, dǝba a langǝ i tthǝ Dangbang, i ya dang woi gu ǝndǝi; langkwoi i yayuu kpaatthǝ dang Koranti kwɔ lǝu kwɔ, i dǝ ba a langǝ i tthǝ, i wolli mung.<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />Nung vii a kun Bulus monmoni Dangbang geiu angǝ,&lt;&lt;Ba survuli thǝ, kwoi a dǝi nwa bǝ geiu baɓǝ bǝ a kwoi nǝsua thǝ, <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />ba kwɔ ɓang suatha i mǝlǝ ɓǝ. Yuu yangǝu a to i nung a kunnu, ba kwɔ yayuu paknǝkwam dang gwoi angǝ kwɔ ǝn yayuum ɓǝ.&gt;&gt; <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />Nungn kwɔ Bulus ǝǝ bǝilǝ ttha kun i fi nanakun, dǝnnu nanatthǝ bagi Fuh lǝ yayuu.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />Kwɔ i dǝ Galiyo lǝ gwamna Akaya losua Roma, Ya Yahudawa kwɔ bǝilǝ kwɔ kǝbtha nwa, tǝi mua Bulus, i tǝu lǝ bǝ to kwan. <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />I gei angǝ,&lt;&lt;Yiɓǝi kwɔ, dǝna ɗam yayuu angǝ i wab Fuh lonunglǝi kwɔ zuu gi Musa gwab lǝu ɓǝ!&gt;&gt;<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />Bulus dǝna tǝbǝ gei ba kwɔ Galiyo gei ya Yahudawa angǝ,&lt;&lt;Nǝ nung kwɔ ǝn nungto mungkulum ko nung a kwɔ ǝn lozuiiu lǝu kwɔ i to, yang maɗing kwɔ mǝn tǝm lonyim i ɓǝlǝ ɓǝ ya Yahudawa. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />Kwoi kwɔ ǝn ba nyim nwa lo ba i ɗuǝn i ba zuu ɓǝ, ɓǝ i naɓǝ ɓa mab ba ɓǝ. Ən mǝrrǝm lǝ ya gei kwan lo i nung ɓǝ kwɔu!&gt;&gt; <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />Nung kwɔ u nanni kǝm gei kwan ɓǝlǝ. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />I ǝndǝi i mua Sastanisu, yikku kǝm kǝbtha ya Yahudawa ɓǝlǝ, i ɓo tthasi kǝm gei kwan ɓǝlǝ. Kwoi Galiyo nhǝm nung ɓǝ kullo lǝu ko ǝn a tuab.<verse eid="ACT 18:17" /></para>
  <para style="s">Bulus Kwoisuo Tǝ Antakiya</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />Bulus ǝǝ Koranti sua tutthǝ i ya dǝba a langǝ i tthǝ Fuh, nung kwɔ u ɗab kwai suatha i Bilkisu i Akila i tǝ Suriya. Vii kwɔ u ɗab kwai u tǝ Kankiriya u kwalo ba nung zuu kwɔ u zuu ɓǝ. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />I tǝ Afisa, bǝilǝ kwɔ Bulus gabtha i Bilkisu i Akila. Tǝu tǝ kǝm kǝbtha ya Yahudawa u gei ba i ya Yahudawa. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />Yayuu ɓǝ geiu angǝ u ǝǝ i ilǝ sua tuutthǝ, kwoi u gwab lǝu. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />Manungkwɔ ni yang, kwɔ dǝu tǝbǝ pko u gei angǝ,&lt;&lt;Nǝ Fuh gwabǝn yang, Mǝn wua sua ɓǝ a kun ǝn wuo,&gt;&gt;Langkwoi nung kwɔ u tǝ kwai mung u palǝi Afisa.<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />Kwɔ u wuu Kaisariya, u pa u tǝ Urshalima tǝu gumtha i ya kǝm pinwa, Nung kwɔ u pa u tǝ Antakiya. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />Kwɔ u ǝǝ bǝi lǝ tuab, u pa u tǝ losua Galatiya i Firijiya, dǝnnu dǝ tthǝ nyimmi lǝ ya dǝba a langǝ i tthǝ Fuh ǝndǝi.<verse eid="ACT 18:23" /></para>
  <para style="s">Apolos Gei Ba Fuh Dang Afisa</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />Lona lǝ kulo ya Yahudawa a kun tthǝ ɗuǝnnu ǝn Apolos, yuu kwɔ i siu Iskandariya ɓǝ, u wua Afisa. U than nung ɗing langkwoi u ibǝ nungvullǝ ba Fuh nyim ɗing. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />I nkonathǝ nung bagi Dangbang, i tthǝ nyimmi dǝu gei ba langkwoi dǝu nanatthǝ ba Yeso la langǝ i ma tthǝ, kwoi u i ǝn bǝ woll mung gi Yohanna ɓuo. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />U baipi bǝ gei ba gi Fuh i nyi nyimmi dang kǝm kǝbtha ya Yahudawa. Kwɔ Bilkisu i Akila lǝu, i lǝiu i tǝlǝ gwoi gi tǝi nkonatthǝ ba gi Fuh la langǝ i. <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />Apolos dǝna yiɗi bǝtǝ Akaya, Nung kwɔ ya kwɔ dǝba a langǝ i tthǝ Fuh dang Afisa kwɔ nwongǝu ibǝ vullǝ nung angǝ tǝu dǝlǝ ya kwɔ dǝba a langǝ i tthǝ Fuh dang Akaya ɓǝ, i geiu angǝ i muu narab. Kwɔ nǝ u tǝ bǝiɓǝ ɓǝ, u nwong ya kwɔ i bǝ tonung a langǝ i Fuh i mǝrrǝm lǝ ya dǝba a langǝ i ɓǝ. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />Ba kwɔ i bǝ nyim nwa gu nyimtthǝ u pǝll tthko ya Yahudawa i bǝ tainatthǝ dang nung yayuu u gei angǝ Yeso ǝn Kristi.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s1">Bulus Tǝ Afisa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />Lona kwɔ Apolos Koranti kwɔ, Bulus thkothko ganglang losua lǝ mǝrrǝm wuo Afisa. U tǝi ya nanung to yakun bǝilǝ <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />nungkwɔ u ɓibǝi angǝ,&lt;&lt;Kwɔ ɓa mǝrrǝm lǝ ya dǝ ba a langǝ i kwɔ ɓa mua Ɓyang a Langǝ i a?&gt;&gt;</para>
  <para style="p" vid="ACT 19:2">I gwabnwa angǝ,&lt;&lt;Ɓilǝ ba Ɓyang a Langǝ i lǝu bokun&gt;&gt;<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />&lt;&lt;Nungkwɔ Bulus ɓib angǝ, yang, ǝn bǝ wollmung anwɔ ɓa muo?&gt;&gt;</para>
  <para style="p" vid="ACT 19:3">I gwab nwa angǝ,&lt;&lt;Bǝ wollmung gi Yohanna,&gt;&gt;<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />Bulus gei angǝ,&lt;&lt;Bǝ wollmung gi Yohanna kwɔ wolɓǝ lǝ kwɔ ǝn a bǝ yakwɔ mǝrrǝm yitthǝ nung a ɓko gi ɓǝ; langkwoi u gei ya Israila angǝ i dǝ ba a langǝ i tthǝ yuu kwɔ dǝna wɔ ttha suai ɓǝ- nungɓǝlǝ Yeso.&gt;&gt;<verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />Kwɔ i lǝ bakwɔ, i wollimung dang ɗuǝn Dangbang Yeso. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />Bulus dǝ nko loi lǝ, nungkwɔ Ɓyang a Langǝ i pin loi lǝ; dǝnni gei nwa akun langkwoi langɓǝ dǝnni gei ba Fuh. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />Yaɓǝi ni sob iu rab ǝndǝi.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />Bulus tǝ dang kǝm kǝptha ya Yahudawa ǝǝ bǝi lǝ fi tai dǝna gei ba i tthǝ nyimmi lǝ yayuu, dǝnnu gei ba i ilǝ dǝnnu yiɗi mǝrrǝmǝi lo bǝlo yigwoi gi Fuh. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />Kwoi yakun dang ǝi ǝn ya ɓuasui i labǝ dǝ ba a langǝ i tthǝ, langkwoi tthasi yayuu ǝndǝi dǝnni gei ba a ɓko lo bagi Dangbang. Nungkwɔ Bulus pa yiǝ u pa suatha i ya dǝ ba a langǝ i, vii ǝndǝi dǝnnu gei ba i ilǝ dǝnnu gei ba i ilǝ dang kǝm nanatthǝnung gi Tiranas. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />Ttha rab dǝnni to nungkwɔ, yangbǝ yayuu ǝndǝi kwɔ losua Asiya, ya Yahudawa i yakwɔ ǝnya Yahudawa lǝu kwɔ, lǝ ba gi Dangbang.<verse eid="ACT 19:10" /></para>
  <para style="s">Yathang Abǝi Siba</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />Fuh dǝna to nung fǝmlo kwɔ zee i ɓyǝa lǝu kwɔ i Bulus lǝ. <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />I nung fa dang nung i nunglitthǝ gu kwɔ u tolǝ nung to kwɔ i lǝi i tǝlǝ sua ya nungzii, nungzii gi thǝm, langkwoi Ɓyang a ɓko a i dang tthǝi. <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />Ya Yahudawa yakun kwɔ thko mǝrrǝm lǝ kwɔ langkwoi i nan ɓyang mungkullum kwɔ langɓǝ dǝna yiɗi bǝ to nung to i ɗuǝn Dangbang Yeso. Dǝnni gei ɓyang a ɓko ɓǝ angǝ,&lt;&lt;Dǝmǝn gei ba dang ɗuǝn Yeso, kwɔ Bulus dǝna gei bagu ɓǝ.&gt;&gt; <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />Ya youngtha tthǝ nanaira, i ǝn yathang gi Gong ya nyǝknung ya Yahudawa akun ɗuǝnnu ǝn Siba, dǝnni tonungkwɔ.<verse eid="ACT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15" />Kwoi ɓyang a ɓko ɓǝ gei angǝ,&lt;Ən i Yeso ǝn, langkwoi ǝn lǝ ba Bulus lang ɓǝng; kwoi mǝ a mǝ- ɓaɓǝ ɓǝn yaɓa?&gt;&gt;<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />Yiɓǝi kwɔ ɓyang a ɓko ɓǝ tthǝu kwɔ ǝrr oitthǝ tthǝi u pǝl tthai ǝndǝi. I ǝndǝi i pa dum i yitthǝ dang woi gu, u nkoni gi langkwoi u trǝ nunglitthǝ gi ǝndǝi. <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />Ya Yahudawa i yakwɔ ǝnya Yahudawa lǝu dang Afisa kwɔ lǝ bakwɔ; i ǝndǝi tthǝ vulli mui, langkwoi i dǝ gong ghaali tthǝ ɗuǝn Dangbang Yeso. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />Ya dǝba a langǝ i kpaatthǝ wua, nung yayuu lǝ dǝnni gwab langkwoi dǝnni gei nwa nung aɓau kwɔ i toɓǝ. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />Yakwɔ dǝna to yǝng kwɔ kpaatthǝ i wulǝ nung vullǝ gi wui gǝm bǝ yikun wui suon dang yayuu. I gǝm nungkurɓǝ nungvullǝ ɓǝ, nungkurɓǝ azurfa thǝm sob ɓua thǝm sob pǝmna sob, nung ɓǝlǝ nungkurɓǝ nungvullǝ ɓǝ. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />Dang nunglǝi a nyimmi kwɔ bagi Dangbang lǝibǝi ǝndǝi dǝna ghaa nyimtthǝ.<verse eid="ACT 19:20" /></para>
  <para style="s">Yurrǝ Dang Afisa</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />Tthasua nungkwɔ to nung kwɔ, Bulus mǝrrǝm dang wko dang ɓyang a tthko dang Makidoniya i Akaya langkwoi itǝ Urshalima. U gei angǝ,&lt;&lt;Tthasua nǝ ǝntǝ bǝiɓǝ, Lankwoi mǝn ɓyǝa Roma.&gt;&gt; <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />Nungkwɔ u tum ya wounatthǝ nung to rab Timitawos i Arastas, tǝ Makidoniya, nungkwɔ u ǝǝ sua tutthǝ losua Akaya.<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />Lona lǝ kulo i to yurrǝ ghaatthǝ losua Afisa lǝ ba lǝi gi Dangbang. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />Ya ta nung azurfa akuntthǝ ɗuǝnnu ǝn Dimitiriyas kwɔ u ta kǝm pinwa gi fuh a yisi Artimas, bǝ to lomu gu dǝna wulǝ nungtǝi lǝ ya to nung to tthǝ kpaaɗing.<verse eid="ACT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 19:25" />Nungkwɔ u lubǝi u gǝm bǝ yikun i ǝndǝi i yakun kwɔ nung to gi manung abǝi ɓǝ nungkwɔ u gei angǝ,&lt;&lt;Yaɓǝi, ɓa ibǝi nungtǝi ɓi dǝna wɔ tthǝn tthǝ nung to kwɔ. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />Lakwɔ, ɓa ɓyǝa langkwoi ɓa lǝ i naɓǝ nungkwɔ Bulus dǝna toɓǝ. U gei angǝ fuh akwɔ i mab i nakwɔ ǝn fuh lǝu, langkwoi u muo lo yayuu kpaaɗing, kwɔ dang Afisa langkwoi gbag losua Asiya ǝndǝi. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />Ɓua tthǝ, lakwɔ, bǝ to lomu ɓi atǝi ɗuǝn a ɓko. Nung ɓǝ ɓuo lǝu, kwoi kǝm nyǝknung gi fuh ɓi a yisi Artimas wa mǝrrǝm lǝ nung a nǝkwam ghaali gu a ɓanglǝ- nungɓǝ lǝ fuh kwɔ dǝnni wab dang Asiya i longwam ǝndǝi ɓǝ!&gt;&gt;<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />Kwɔ yayuu lǝ bakwɔ, dang wai ɓanglǝ i baipi bǝ buogbǝi,&lt;&lt;Artimas ya Afisawa ǝn nung angǝ a!&gt;&gt; <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />Buogbǝi yǝb gwoi angǝ a lǝ. Kon yayuu ɓǝtǝ mua Gayus i Aristarkus, ya Makidoniya kwɔ rab kwɔ dǝna tthko suattha i Bulus ɓǝ, i pailǝ i tǝllǝ bǝi kwɔ dǝnni nyim nung tthǝ ɓǝ. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />Bulus i nkolǝ dǝna yiɗi bǝ tǝ tthasi kon ɓǝ, nungkwɔ ya dǝ ba a langǝ i tthǝ Fuh gwabbu tthǝ lǝu. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />Yakun tthǝ dang yakku losua ɓǝ, yakwɔ ǝnya ǝnthǝu Bulus kwɔ, tumbǝi suko lǝ dǝna yammu angǝ bǝ u tǝ kǝm nyim nung ɓǝ tthǝ. <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />Manung kwɔ ni bǝ kǝb tha ɓǝ ǝndǝi dang yurrǝ: yakun dǝna buogbǝi lo nung akun, ya kun dǝna buog lo nung akun langkwoi, bakwɔ yakun dang ǝi kpaatthǝ ibǝ nungkwɔ wuilǝ wuu kǝb lǝ tha ɓǝlǝu.<verse eid="ACT 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 19:33" />Yakun dang ya Yahudawa tuog Iskandari dǝ tthasi, langkwoi kon yakun dǝna buogbǝi dǝna geiu ba nyimtthǝ. U nanko angǝ i kǝr nwa nǝ kwam yangbǝ i gei nwai tthasi yayuu. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />Kwoi kwɔ i ibǝi angǝ u ǝn ya Yahudawa, i ǝndǝi i buogbǝi nwatha nungkun lona rab: &lt;&lt;Ya angǝ a lǝ Artimas ya Afisawa!&gt;&gt;<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />Tthasua ǝndǝi ya vullǝ nung gwoi angǝ a ɓǝ gei balǝ kon ɓǝ kǝr.&lt;&lt;Angǝ ya youngǝm ya Afisa!,&lt;&lt;Yayuu ǝndǝi ibǝi angǝ gwoi angǝ a ya Afisawa ǝn kǝm pinwa angǝ a gi Artimas langkwoi ǝn bǝi tal a langǝ i kwɔ o wayi ɓǝ.<verse eid="ACT 19:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 19:36" />Yuu akun yangǝu a nyimnwa lo nung kwɔu. Nungkwɔ yang, ɓa kǝr nwa nǝ kwam bǝ ɓa to nung akun ɓko thǝ tthǝ. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />Ɓǝɓa wulǝ yayuu kwɔ lǝ bǝi kwɔ lakwɔ i inung akun dang kǝm pinwa lǝu ko i gei ba a ɓko tthǝ fuh ɓi a yisi Artimas. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />Nǝ, Dimitiriyas i ya to nung to i ulǝ tthǝ i bǝ to kwan lo yuu akun, ɓitthǝ i ya dǝ kab nwa nung i vii to kwan; i ɓuan i ɓǝrri kwantthǝ bǝi lǝ. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />Kwoi nǝ nung akun tthǝ langkwoi dǝ ɓa yiɗi bǝ tou, ɓa to dang kwan gǝmtha lo ǝndǝi. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />Manungkwɔni, yang ɓi dang zuii bǝ ɓuob nwa ba nungkwɔ to nung vii a ɗiggǝ ɓǝ. Manungkwɔni yang ɓi ɓuan ɓi gei ba lo nungkwɔu, bakwɔ lo ba ɓǝ yangǝu ɓǝ.&gt;&gt; <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />Tthasua kwɔ u gei bakwɔ, u yǝrnwa lǝ kon ɓǝ.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s1">Bulus kwoi tǝ Makidoniya i Hellas</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />Tthasua buogbǝi kwɔ alo, Bulus lubǝ ya dǝ ba a langǝ i tthǝ Fuh gǝmmǝi u ji tthǝnyimmi u yǝri lǝ nwa. Nungkwɔ u pa nunglǝi Makidoniya. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />U tthko losua lǝ ǝndǝi dǝnnu dǝ tthǝ nyimmi lǝ yayuu i balǝ kpaatthǝ. Nungkwɔ u wulǝlǝ Hellas, <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />U ǝǝ bǝilǝ fi tai, ya Yahudawa dǝna mab nung lǝi bǝ tou i nung akun kwɔ dǝu yidɗi bǝ ǝrrǝu u ɗab kwai u tǝ Suriya, nung kwɔ u ǝrr u mua ttha nung lǝi Makidoniya. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />U tǝ suatha i Subataras Babiriye, yui Burus tǝ duu sua i Aristarkus i Sakundas, ya losua Tasalonika; Gayus, Badarbe; i Timitawos i Tikikus ǝndǝi i Tarofimas, ya Asiya. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />I osi tǝi kilo ɓi Taruwasa. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />Ɓi ǝrr Filibi dang kwai kwɔ ɓi alo ɓang nungtang akwɔ yisti yangǝu dang ǝu ɓǝ, langkwoi tthasua bo nu ɓi tǝi Taruwasa, ɓi ǝǝ bǝilǝ bo nannaira.<verse eid="ACT 20:6" /></para>
  <para style="s">Bǝ Tǝ Gi Bulus Taruwasa A Nǝsua</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />Vii nwongǝi nunglui lǝ ɓi gǝmtha bǝ tang nungtang, Bulus gei ba lǝ yayuu u ǝǝnwa bǝ gei ba har kasua ka, bakwɔ nǝ bǝi kan yang u paɓǝ. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />Fitilǝ tthǝ kpaatthǝ i lua lǝ dǝna tang dang kǝm a yi kǝm kwɔ ɓi kǝptha tthǝɓǝ. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />Muntthang a yiɓǝi akun tthǝ ɗuǝnnu ǝn Aftikos ǝǝ nwa kǝm a tuab wayi, langkwoi kwɔ Bulus dǝna gei ba ɓǝ, nung lo lǝiu ghatthǝ u pin wayi dang kǝm a rab wuu o pangsua. Kwɔ i lǝiu pang sua lǝ, u ɓuing. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />Kwoi Bulus pin sua wɔ lo lo munthang a yiɓǝi ɓǝ u kummu. U gei angǝ, &lt;&lt;Bǝ kiggǝ ɓǝ ǝrr thǝ&gt;&gt;yirǝ u i nwongǝi&gt;&gt; <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />Nungkwɔ u kwoi soɔ u tǝ kǝm a yi, u kwǝy burodi, nungkwɔ u tang. Tthasua kwɔ i gei ba i ilǝ sua tutthǝ, har bǝi kan, nungkwɔ Bulus pa. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />I lǝi munthang a yiɓǝi ɓǝ i tǝlǝ gwoi i nwongǝi thǝi laǝndǝi.<verse eid="ACT 20:12" /></para>
  <para style="s1">Bulus Yitthǝ Taruwasa Tǝ Militas</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />Ɓi lilotthǝ ɓi nalǝ kwai nungkwɔ osi ɓi tǝ Asus, Bǝi lǝ kwɔ tǝɓi lǝi Bulus. U gei ɓi angǝ ɓito nungkwɔ, bakwɔ dǝu tǝ bǝi ɓǝ i bo. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />Kwɔ tǝu tǝi ɓi Asus, ɓi lǝiu dang Kwai, ɓi lilotthǝ ɓi tǝ Mitilini. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />Ibǝi kan ɓi ɗab kwai ɓi tǝ Kiyos, Ibǝikan ɓi tǝ Samas, langkwoi ibǝi kan ɓi kǝn Militas.<verse eid="ACT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 20:16" />Bulus mǝrrǝm lo nyiu pa dang kwai tǝ Afisa, yangbǝ so u ɓanglǝ lona Asiya, U dang thǝmmi utǝ Urshalima vii pentikos, nǝ a totthǝ ǝnto ɓǝ.<verse eid="ACT 20:16" /></para>
  <para style="s">Bagi Bulus A Nǝsua Lǝ Yakku Ya Afisa.</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />Bulus tumbǝi i nwatummi Militas tǝlǝ Afisa, u gei yakku ya kǝm pinwa tǝ tǝi. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />Kwɔ i kǝnbǝi, u gei angǝ,&lt;&lt;Ɓa ibǝi kwɔ ǝn thǝb lona kwɔ ǝndǝi ɓang i ɓǝlǝ ɓǝ, vii kwɔ ǝndǝi baipiu vii a nwasiu kwɔ ǝn wuo losua Asiya ɓǝ. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />I bǝ ɓuoblo sua i mungnung kpaatthǝ dǝm to nungtom mangǝn thǝb gi Dangbang lona zuii kwɔ tǝim babǝ ɗu lǝim kwɔ ya Yahudawa yakun ɗuɓǝ. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />Ɓa ibǝing nung akun yangǝu kwɔ ǝn pya ɓǝlǝ kwɔ a valli ɓǝkwɔ yangǝu kwɔ dǝm geiba langkwoi dǝm nanatthǝ nung dang yayuu langkwoi i gwoiɓǝ ɓǝ. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />Ən gei lǝ ya Yahudawa tthǝ i yakwɔ ǝn ya Yahudawa lǝu kwɔ ǝn gub ɗogsui nyimtthǝ gǝngǝ i mǝrrǝm tthǝ nung a ɓko gi i wuo tthǝ Fuh langkwoi i dǝ ba a langǝ i tthǝ Dangbang Yeso. <verse eid="ACT 20:21" /><verse number="22" style="v" sid="ACT 20:22" />Langkwoi Lakwɔ, ibǝ to nung to i ba Ɓyang a Langǝ i mǝn tǝ Urshalima, ǝn ibǝ nungkwɔ a tǝim bǝi lǝ ɓǝlǝu. <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />Ən ibǝi dang gwoi angǝ a kwɔ ǝndǝi Ɓyang a Langǝ i gub ɗuog suim angǝ pursǝna i zuii dǝna kim. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />Kwoi ǝnlǝi nwongǝim ǝn nung akunlǝu tthǝm lǝ; Dǝm yiɗi bǝ alo nungkwɔ dǝm yiɗi tthasim i nungkwɔ Dangbang Yui Fuh dǝm angǝ ǝn toɓǝ, nungɓǝ lǝ ǝn gei nwa ba a langǝ i lǝ ba nung a langǝ i gi Fuh. <verse eid="ACT 20:24" /><verse number="25" style="v" sid="ACT 20:25" />&lt;&lt; Ən thko ǝn mǝrrǝm dang ɓǝ ǝndǝi, dǝm gei babǝ lo yigwoi gi Fuh. Langkwoi lakwɔ ǝn ibǝing gǝngǝ yuu a kun yangǝu dang ɓǝ a ɓyǝam akunu. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />Nungkwɔ ǝn gei ɓǝtthǝ la ɗiggǝ kwɔ: nǝ yuu a kun dang ɓǝ a la yang, bam yangǝu. <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />Bakwɔ ǝn pyǝa bǝ gei ɓǝ nunkwɔ tthǝ Fuh dǝna yiɗi ɓǝlǝu. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />Ɓa gagci loɓǝ matthǝ langkwoi nung gagci kwɔ Ɓyang a Langǝ i dǝ dang naɓǝ ɓǝ. Ɓa ǝǝlǝ ya gagci yayuu kǝm pinwa gi Fuh, kwɔ mǝrrǝm lǝ abo i zii yuiu ɓǝ. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />Ən ibǝi yang tthasua kwɔ nǝ ǝn pa, ɗua gug a wɔ dang ɓǝ, i yi nung gagci ɓǝu. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />Lona dǝna wɔ kwɔ yaɓǝi yakun dang ɓǝ a kǝb pǝllǝ yangbǝ palǝ ya dǝ ba a langǝ i suai lǝ. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />Ɓa dǝ kiggǝ, yang, langkwoi ɓa nhǝm i mungnung kpaatthǝ, dang fuh i nungvii, ǝn naɓǝ natthǝ nungɓǝkwɔ ǝndǝi ttha tai. <verse eid="ACT 20:31" /><verse number="32" style="v" sid="ACT 20:32" />&lt;&lt;Lakwɔ ǝn dǝɓǝ dang na Fuh langkwoi i ba bǝ to nung a langǝ i gu, kwɔ a ghaa ɓǝlǝ langkwoi a dǝɓǝ bǝ khana lo kwɔ Fuh a dǝlǝ yayuu gu ɓǝ. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />Ən yiɗi azurfa ko zinariya i nunglitthǝ na yuu a kun lǝu. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />Ɓǝ i naɓǝ ɓa ibǝing ǝn to nung to i nam kwɔ yangbǝ wulǝ nung ǝndǝi kwɔ ya ǝnthǝm i ɓang dǝɓi yiɗi ɓǝ. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />Dang nung kwɔ ǝndǝi dǝm to kwɔ, Ən taɓǝ natthǝ i bǝ tonungto i tthǝ nyimmi ɓi nwong yakwɔ tthai yangǝu ɓǝ, iɓǝ nhǝm nugkwɔ Yeso i nkolǝ geiɓǝ,&lt;Tthǝla tthǝ ghaaɗing tthǝ bǝ dǝnung pǝll bǝ muu.&gt;&gt;&gt; <verse eid="ACT 20:35" /><verse number="36" style="v" sid="ACT 20:36" />Kwɔ Bulus alo, u bai nwalongǝu sua i ilǝ i pinwa. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />I ǝndǝi dǝnni tasui, i kummu bulus i tou sumba nungkwɔ i yǝrrǝu nwa. <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />Nungkwɔ ɓanglǝ dang wai nikwɔ ǝn bakwɔ u gei angǝ i ɓyǝa nungǝi akunu ɓǝ. Yang i duu sua nwa kwai.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">Bulus Tǝ Urshalima</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />Ɓi yǝrtha nwa i ilǝ nungkwɔ ɓi pa. Tthasua kwɔ ɓi dang kwai ɓi nyang gwam a kullo, ɓi wuo Kos; ibǝi kan ɓitǝ Rodusa, langkwoi ǝrr bǝilǝ ɓi tǝ Batara. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />Ɓi tǝi kwai kwɔ a nyang atǝ losua Finikiya ɓǝ. Nungkwɔ ɓi ɗab ɓi pa.<verse eid="ACT 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 21:3" />Ɓi wuo bǝikwɔ ɓi ɓuan ɓi ɓyǝa kubrus ɓǝ, langkwoi yang ɓi ki nungɓi ttha lasua ɓitǝ Suriya. Ɓi pin gwam nwam Taya, ǝn bǝilǝ kwɔ kwai ɓǝ a pinlǝ nungkwɔ dang ǝu ɓǝ. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />Bǝi lǝ ɓi tǝi ya dǝ ba a langǝ i tthǝ Fuh langkwoi ɓi ǝǝ i ilǝ bo nannaira. I ttha Ɓyang a Langǝ i i gei Bulus angǝ bǝ u tǝ Urshalima thǝ. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />Kwoi kwɔ lona ɓi i ilǝ thǝm kwɔ, ɓi olǝi ɓi pa nungɓi. I ǝndǝi, suatha i yasi gi i yathang gi, tǝi dǝɓi sua mua munglǝ. Bǝilǝ kwɔ ɓi bai nwalong ɓi sua ɓi pinwa. <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />Yang ɓi yǝrnwa lǝ tha, langkwoi nungkwɔ ɓitǝ dang kwai ɓǝ kwɔ i kwoi itǝ gwoi.<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />Ɓi lilo tthǝ thko ɓi, dang kwai ǝrr Taya ɓitǝ Talamayas, bǝilǝ kwɔ ɓi gumtha i ya dǝ ba a langǝ i langkwoi ɓi lo tthangǝ i bokun. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />Ibǝi kan ɓi pa wuɓi kǝn Kaisariya. Bǝi lǝ kwɔ wuɓi tǝ gwoi gi Filibus ya gei ba Fuh, yuu akun dang yaɓǝi nannaira kwɔ i mko lǝya nwongbǝi dang Urshalima ɓǝ. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />U tthǝ i yathang a yisi nai kwɔ ɗǝb gwoi lǝu ɓǝ dǝi gei ba a tthasi. <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" />Ɓi ǝǝ bǝilǝ sua tutthǝ, kwɔ ya gei ba a tthasi wuo ɗuǝnnu ǝn Agabas, u ǝrr Yahudiya. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />U wuo sua ɓi, u lǝi nung tthǝb lui gi Bulus, u tthǝb lǝ bo i nko, nungkwɔ u gei angǝ,&lt;&lt;Nungkwɔ lǝ nungkwɔ Ɓyang a Langǝ i gei ɓǝ: Yuu nung tthǝb lui kwɔ ya Yahudawa Urshalima a tthǝbbu manungkwɔ ni i dulǝ yakwɔ ǝn ya Yahudawa lǝu ɓǝ.&gt;&gt;<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />Kwɔ ɓilǝ nungkwɔ, ɓi i yakwɔ bǝi lǝ kwɔ ɓi yam Bulus bǝ u tǝ Urshalima thǝ. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />Kwoi bulus gwab nwa angǝ, &lt;&lt;Ən ɓǝttǝn dǝmma tokwɔ, dǝ ɓa ta sui dǝ ɓa ɓanglǝ dang wam? Ən mab tthǝm yang lǝ ba ɓǝ thǝbbǝm ɓuo Urshalima lǝu kwoi i bǝ ɓuiu lǝba ɗuǝn Yeso.&gt;&gt; <verse eid="ACT 21:13" /><verse number="14" style="v" sid="ACT 21:14" />Ɓi ɓuan ɓi nannu lǝu, nungkwɔ ɓi kǝr, &lt;&lt;Kaso Dangbang to nung to gu.&gt;&gt;<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />Tthasua kwɔ ɓi ǝǝ bǝilǝ tuab, ɓi ee nung naɓi mab tthǝɓi ɓi pa nunglǝi Urshalima. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />Ya kun dang ya nanung to kwɔ Kaisariya kwɔ mua sua ɓi tǝ suatha i ɓi i lǝi ɓi i tǝlǝ gwoi Manason ya losua Kubrus, yuukwɔ sua tuung dang bǝ mua sua Fuh.<verse eid="ACT 21:16" /></para>
  <para style="s">Bulus Tǝsua Yakub</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />Kwɔ ɓi tǝ dang Urshalima, ya young ɓi kǝb loɓi na rabrab. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />Ibǝi kan Bulus tǝ sua Yakubu suatha i ɓilǝ: i yakku kǝm pinwa bǝi lǝ ǝndǝi. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />Bulus gummǝi ǝndǝi nungkwɔ u gei nungkwɔ Fuh to dang yakwɔ ǝn ya Yahudawa lǝu ɓǝ i nung to gu. <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />Kwɔ i lǝu, i kha Fuh. Nungkwɔ i gei angǝ,&lt;&lt;Young ɓi Bulus dǝmma ɓyǝa ya Yahudawa kwɔ thǝm sob ɓua nu ya dǝ ba a langǝ i, langkwoi kwɔ dǝnni to nung to i zuu ɓǝ.<verse eid="ACT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 21:21" />I gei angǝ dǝma nanatthǝnung lǝ ya Yahudawa kwɔ ǝǝ dang losua yakwɔ ǝn ya Yahudawa lǝu kwɔ mangǝ i al zuu gi Musa lǝtǝ, dǝmma nainatthǝ mangǝ bǝ i ɓǝr nwa ɗuǝ yathang gi thǝ ko i to nung to i zuu ya Yahudawa thǝ. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />I ibǝi ǝn i angǝ a wung, Ənɓǝ ɓi to, lakwɔ? <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />Nungkwɔ lǝ nungkwɔ dǝɓi yiɗi ɓingǝ ato ɓǝ. Yaɓǝi tthǝ bǝi kwɔ kwɔ lǝi nung zuu ɓǝ. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />Atǝ suatha ato ɓang ɗiggǝ nung aɓau yang a kwai nungkurɓǝ tthǝ; yang i ɓuan i kwa loi. Nunglǝi kwɔ niyang yayuu ǝndǝi a ibǝi ba a langǝ i yangǝu dang i nungkwɔ kwɔ i geitthǝ lomǝ ɓǝ, kwoi mǝ i namǝ dǝma to nungto i zuu gi Musa.<verse eid="ACT 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 21:25" />Kwoi ba a bǝ yakwɔ ǝn ya Yahudawa lǝu kwɔ mǝrrǝm lǝ ya dǝ ba a langǝ i kwɔ, ɓi tummbǝi i nungvullǝ kwɔ ɓi gei ɓingǝ bǝ i tangnungtang kwɔ i nyǝklǝ nung tthǝ nung a wab bǝi ɓǝthǝ, ko ǝn zii, ko nungbyang akwɔ i prǝm dulu ɓǝ, langkwoi i kang tthǝi bǝ lo i yisi ko yiɓǝi kwɔ ǝn abǝi lǝu ɓǝ.&gt;&gt;<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />Nungkwɔ Bulus ee yaɓǝi ɓǝ langkwoi ibǝi kan ito ɓang ɗigǝ nung a ɓko gi. Yang u tǝ dang kǝm Nyǝknung langkwoi tǝu gei ya nyǝknung ɓǝ vii kwɔ i alo ɓang ɗiggǝ nung aɓau ɓǝ tthǝ ɓǝ, kwɔ yangbǝ i nyǝknung lǝ koya tthǝ dang ǝi.<verse eid="ACT 21:26" /></para>
  <para style="s">I Mua Bulus Dang Kǝm Nyǝknung</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />Kwoi sua bo nannaira ɓǝ gɓag bǝ thǝmmu, yakun dang Yahudawa losua Asiya ɓyǝa Bulus dang kǝm nyǝknung. I ǝrrlǝ kiggǝ kon yayuu nungkwɔ i muo Bulus,<verse eid="ACT 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 21:28" />i buogbǝi angǝ,&lt;&lt; Ya Israila!&gt;&gt; Ɓa nwong ɓi! Yiɓǝi kwɔ dǝna thko bǝi ǝndǝi dǝna nanatthǝnung yǝb bǝi kwɔ ǝndǝi lo ya Israila, zuu gi Musa i kǝm nyǝknung kwɔ. Langkwoi lakwɔ u wulǝ yakwɔ ǝn ya Yahudawa lǝu kwɔ lǝ dang kǝm Nyǝknung kwɔ langkwoi i ɓanglǝ bǝi kwɔ ǝn ɗǝgsi Fuh ɓǝ!&gt;&gt; <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />(I gei nungkwɔ bakwɔ i ɓyǝa Bulus suatha i Tarofimas ya Afisawa gwoi angǝ a, langkwoi dǝnni nhǝm angǝ lko Bulus lǝiu tǝlǝ dang kǝm Nyǝknung.)<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />Buogbǝi yǝb gwoi angǝ a lǝ ǝndǝi, langkwoi yayuu ǝndǝi sur tǝ gǝmtha, i mua Bulus i gubbu i ilǝ dang kǝm Nyǝknung. Dangtthǝ ni yang i lam nwakǝm Nyǝknung ɓǝ. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />Kon ɓǝ dǝna yiɗi bǝ thǝb Bulus, kwɔ batǝ ɓua sui gong yikku ya soja Romawa angǝ ya Urshalima dǝna to yurrǝ. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />Dangtthǝ ni gong yikku ya soja ee yakku ya soja thǝmtthǝ surdum tǝlǝ sua kon ɓǝ. Kwɔ yayuu dǝna ɓuob Bulus kwɔ ɓyǝko iya soja, i yitthǝ bǝ ɓuob Bulus ɓǝ.<verse eid="ACT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 21:33" />Gong yikuu ya soja ɓǝ tǝ tthang Bulus, u muu, u dǝba angǝ i al sarka nko ǝndǝi nǝ rabbu. Yang u ɓyib angǝ, &lt;&lt;Yiɓǝi kwɔ ǝn yittǝn, langkwoi ǝn ɓǝttǝn u to?&gt;&gt; <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />Yakun dang kon lǝ dǝna gei nung akun, yakun lang dǝna nung akun. Buogbǝi lǝi lǝ bǝi kwɔ gong yikku ya soja ɓǝ ɓua lǝ la langǝ i nungkwɔ to nung ɓǝlǝu, nungkwɔ u gei angǝ i lǝi Bulus i tǝlǝ gwoi ya soja. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />Kwɔ Bulus wuo bǝ ɗab ɗabbi, buogbǝi ɓǝ nyari nungkwɔ ya soja lǝiu lǝ lǝi <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />Kon yayuu ɓǝ ǝndǝi dǝna wɔ suo dǝna buogbǝi angǝ, &lt;&lt;i thǝu!&gt;&gt;<verse eid="ACT 21:36" /></para>
  <para style="s">Bulus Gǝi Nwo</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />Kwɔ ya soja dǝna tǝbǝ lǝi Bulus a tǝlǝ gwoi gei balǝ gong yikku ɓǝ angǝ,&lt;&lt;Mǝn ɓuan mǝn geia ba a kunna? Gong yikku ɓǝ ɓib angǝ,</para>
  <para style="p" vid="ACT 21:37">&lt;&lt;Dǝmma gei nwa ya Helinawa?&gt;&gt; <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />&lt;&lt;Yang mǝ ǝn ya Masar kullo kwɔ lona akun kwɔ pa kwɔ baipi yurrǝ kwɔ u ee yayuu ya ɓko kiggǝ ya thǝbbǝi thǝm sob ɓua thǝmkun i nung taɓui u tǝlǝ losua akwi?&gt;&gt; <verse eid="ACT 21:38" /><verse number="39" style="v" sid="ACT 21:39" />Bulus gwab nwa angǝ,&lt;&lt;Ɓang ǝn ya Yahudawa, i sim Tarsus dang Kilikiya, ya gwoi angǝ a a langǝ i. La lo nyi mǝ dǝisua ǝn gei balǝ yayuu.&gt;&gt;<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />Nungkwɔ gong yikku ya soja ɓǝ gwabbu tthǝ, nungkwɔ Bulus ǝrr ɗab lonung dǝitthǝ gei ba lǝ yayuu i nalǝ angǝ i kǝr nwa nǝkwam. Nungkwɔ Shawulu gei ba i nwa ya Yahudawa:<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />&lt;&lt; Yayuum ya Yahudawa, ɓalǝm kwɔ mǝn gei nwam tthasiɓǝ ɓǝ!&gt;&gt;<verse eid="ACT 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 22:2" />Kwɔ dǝi lǝu dǝu gei ba i nwa ya Yahudawa kwɔ, bǝi gan loi; nugkwɔ Bulus lilotthǝ gei angǝ:<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />&lt;&lt;Ɓang ǝn ya Yahudawa, i sim Tarsus, dang kilikiya, kwoi ǝn ghaa bǝi kwɔ dang Urshalima ɓang ya nanung na Gamaliyal. Ən muo bǝ natthǝnung nyimtthǝ lo nung zuu ya bǝba langkwoi dǝmǝn mua sua Fuh dang wa kun. Manungkwɔ dǝ ɓa to ɗigǝ kwɔ ɓǝ. <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />Dǝm dǝ zuii lǝ yakwɔ dǝna mua nunglǝi kwɔ ɓǝ tǝlǝ ɓuiɓua. Dǝmǝn muu yaɓǝi i yasi dǝm tthǝb bǝi pursǝnǝ. <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />Gong ya nyǝknung i yakku ǝndǝi a ɓuan i gei angǝ dǝm gei ǝn ba langǝ i. Ən mua nungvullǝ nai lǝ ǝn tǝlǝ sua ya youngǝm ya Yahudawa dang Dimaska. Yangbǝ tǝn mua yayuu ǝn wulǝ Urshalima dang sarka yangbǝ wui ji zui.<verse eid="ACT 22:5" /></para>
  <para style="s">Bulus Ghai Bǝ Mǝrem Gu U Mua Sua Fuh</para>
  <para style="r">(Acts 9:1-19; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />&lt;&lt;Kwɔ dǝm thko langkwoi ǝn gɓag Dimaska, fuh gɓag nyilo, lua kaitthǝ wayi gab dang tthǝ tthǝmlǝ. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />Ən owh pangsua langkwoi ǝnlǝ yol dǝna geim angǝ,&lt;Shawulu, Shawulu! Ən baɓǝ bǝ dǝma dǝmzuii?&gt; <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />&lt;Ən ɓib gǝngǝ Mǝn yitten na Dangbang?&gt; U geim angǝ&lt;Ən ɓang Yeso ya Nazarat kwɔ dǝma dǝmzuii ɓǝ,&gt; <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />Yaɓǝi kwɔ suatha i ɓanglǝ kwɔ ɓyǝa lua ɓǝng, kwoi i lǝ yol yuukwɔ dǝna geim baɓǝ lǝu. <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />Nungkwɔ ǝn ɓib gǝngǝ, &lt;Ənɓǝ Mǝn toa, Dangbang?&gt; Nungkwɔ Dangbang geim angǝ, &lt;A ǝrr atǝ dang Dimaska, langkwoi ǝn bǝilǝ i gei nungkwɔ tthǝ ǝndǝi Fuh dǝna yiɗi angǝ ato ɓǝ.&gt; <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />Ən ɓyǝa bǝiu lǝ ba kaili gi lua ɓǝ, nungkwɔ yakwɔ suatha i ɓanglǝ kwɔ mum na ɓitǝ langkwoi i om lǝ si ɓitǝ dang Dimaska.<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />&lt;&lt;Dang gwoi angǝ a lǝ kulo yiɓǝi akun tthǝ ɗuǝnnu ǝn Hananiya, dǝnnu wab Fuh dang wa kun dǝnnu to nung to i nung zuu langkwoi ya Yahudawa dǝi duu ghaali ɗing bǝilǝ. <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />U wuo suam, u dǝi gbagǝm u gei angǝ, &lt;Youngǝm Shawulu, a ɓyǝa bǝi langkwoi!&gt;Lona lǝ kulo dang tthǝ ni yang dǝm ɓyǝa bǝi langkwoi ǝn ɓyǝko. <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />&lt;&lt; U gei angǝ, &lt;Fuh ya Bǝba ɓi mkoo angǝ yangbǝ a ibǝ nungkwɔ dǝu yiɗi ɓǝ, a ɓyǝa tthǝb gu a langǝ i, yang a lǝu u gei ba i yollu.<verse eid="ACT 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 22:15" />Bakwɔ ma mǝrǝm lǝ ya shǝdǝ yangbǝ u gei lǝ yayuu tthǝ ǝndǝi nungkwɔ a ɓyǝa i akwɔ a lǝɓǝ.<verse eid="ACT 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 22:16" />Langkwoi lakwɔ, ǝn ba ɓǝ bǝ dǝma ki sua tuuni? A ǝrr i wollamung yang i ɗigǝ nung aɓau mǝ i altǝ i bǝ pinwa tthǝu,&gt;<verse eid="ACT 22:16" /></para>
  <para style="s">Bǝ Lubǝi Gi Bulus Yangbǝ U Geiba A Langǝ ilǝ Yakwɔ Ən ya Yahudawa Lǝuɓǝ.</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />&lt;&lt;Ən kwoi suam ǝntǝ Urshalima, langkwoi kwɔ dǝm pinwa dang kǝm nyǝknung, Ən muamoni,<verse eid="ACT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 22:18" />dang ǝulǝ ǝn ɓyǝa Dangbang, kwɔ u geim angǝ, &lt;Thǝmtthǝ! A yitthǝ Urshalima nǝbo, bakwɔ yayuu kwɔ bǝikwɔ gwab shǝdǝ mǝ lǝ bamu.&gt; <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />Ən gwabnwa ǝn gei gǝ,&lt;Dangbang,&gt;i ibǝi la langǝ i angǝ dǝm tǝ dang kǝm kǝptha ya Yahudawa langkwoi dǝm muo langkwoi dǝm ɓuob yakwɔ dǝba a langǝ i tthǝmmǝ ɓǝ. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />Langkwoi Kwɔ i thǝb Istifanas ya shǝdǝ mǝ kwɔ, ɓang i namlǝ bǝilǝ, ǝn gwab gǝngǝ i thǝu langkwoi dǝm ki nung ɓuob tthǝ yakwɔ thǝu ɓǝ.&gt; <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />&lt;Atǝ,&gt;Dangbang geim lǝ, &lt;bakwɔ mǝn tumma tutthǝ sua yakwɔ ǝn ya Yahudawa lǝu ɓǝ.&gt;&gt;&gt;<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />Yayuu dǝsui tthǝ Bulus har u gei nungkwɔ; kwoi yang i baipi bǝ buogbǝi i yol angǝ,&lt;&lt;Ɓa pkolǝ! Thǝu! U natthǝ kwɔ u ǝǝ i nwongǝi longwam kwɔ ɓǝlǝu!&gt;&gt; <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />Dǝnni ɓuobnwa, dǝnni wab nunglitthǝ gi, langkwoi dǝnni wurrǝ kundur wayi. <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />Yikku ya soja ya Romawa dǝba lǝ yayuu gu angǝ i lǝi Bulus i tǝlǝ dang gwoi ya soja, tǝi ɓuo i thab yangbǝ i ibǝi nungkwɔ u to kwɔ ya Yahudawa dǝna ɓuobnwa manungkwɔ ni lǝ bagu ɓǝ. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />Kwoi kwɔ i tthǝbbu ɓǝl yangbǝ i ɓuo i thab, Bulus gei ba lǝ yikku ya soja kwɔ dǝi bǝi lǝ kwɔ angǝ, &lt;&lt;Ən zuu kwɔ ma ɓuob ya losua Roma yuu kwɔ i tou kwan lo nung a kun ɓǝlǝu?&gt;&gt;<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />Kwɔ yikku ɓǝ lǝ nungkwɔni, u tǝ sua yikku ya soja ɓǝ tǝu ɓibbu angǝ, &lt;&lt;Ən ɓǝ dǝmma to? Yiɓǝi kulo ǝn ya losua Romawa!&gt;&gt;<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />Nungkwɔ yikku ɓǝ tǝ sua Bulus tǝ ɓibbu angǝ,&lt;&lt;A geim tthǝ mǝ ǝnya losua Romawa?&gt;&gt;</para>
  <para style="p" vid="ACT 22:27">Bulus gwab nwa angǝ&lt;&lt;Manungɓǝ&gt;&gt;<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />Yikku ɓǝ gei angǝ,&lt;&lt;Ən mǝrǝmlǝ ya losua kwɔ i bǝ kwai nungkurɓǝ ghaatthǝ&gt;&gt;</para>
  <para style="p" vid="ACT 22:28">Bulus gei angǝ,&lt;&lt;Kwoi ɓang abǝm i sim losua kwɔ,&gt;&gt;<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />Ba a nwaɓi kwɔ yaɓǝi kwɔ dǝna tǝbǝ ɓib Bulus bakwɔ kwoi sua tthangǝu; langkwoi yikku ya soja ɓǝ lǝtthǝ vulli kwɔ u ibǝi angǝ Bulus ǝnya losua Roma langkwoi u tthǝbbu i sarkaɓǝ.<verse eid="ACT 22:29" /></para>
  <para style="s">Bulus Tthasi Yakku.</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />Yikku ya soja ɓǝ dǝna yiɗi bǝ ibǝi la langǝ i bakwɔ ya Yahudawa dǝna buogbǝi lo Bulus ɓǝ; nungkwɔ ibǝi kan u bi sarka kwɔ i tthǝb lǝ Bulus ɓǝ nungkwɔ u lubǝ yikku ya nyǝknung i yakku wui kǝptha. Yang u wulǝ Bulus wuu dǝi ttha siǝ lǝ.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />Bulus ɓyǝa yakku ɓǝ dang nung lǝ nungkwɔ gei angǝ,&lt;&lt;Ya youngǝm ya Israila! Lo nyim kai ɗing lo nunglǝi kwɔ dǝm to nung to Fuh wulǝ vii a ɗiggǝ.&gt;&gt; <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />Gong ya nyǝknung Hananiya gei yakwɔ dǝi gbag Bulus angǝ i ɓuob nwuo i na lǝ. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />Bulus geiu angǝ,&lt;&lt;Fuh a ɓua! Mǝ gwu kǝm kwɔ i fa log tthǝ la vǝrǝm ɓǝ! A ǝǝ kulo dǝma tom kwan manungkwɔ zuu gwab ɓǝ, mǝma dǝma to nung to i nungzuu lǝu dǝma gei mangǝ i ɓuom!&gt;&gt;<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />Yaɓǝi kwɔ dǝi gɓag Bulus kwɔ geiu angǝ,&lt;&lt;Dǝma dal Gong ya Nyǝknung gi Fuh?&gt;&gt;<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />Bulus gwab nwa angǝ, &lt;&lt;Ya youngǝm ya Israila, Ən ibǝi kwɔ u ǝn Gong ya Nyǝknung ɓǝlǝu. Nungvullǝ gei angǝ, &lt;Ba gei mullub lo ya dǝ kab nwa nung yayuu ɓǝthǝ.&gt;&gt;&gt;<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />Kwɔ Bulus ɓyǝa yakun dang yayuu lǝ ǝn ya Sadukiyawa langkwoi yakun ǝn ya Farisiyawa, u lubǝ yakku ɓǝ angǝ, &lt;&lt;Ya youngǝm ya Israila! Ɓang ǝn ya Farisiyawa. Ɓang dang kwan bǝi kwɔ babǝ dǝnyimtthǝ kwɔ ǝn gei gǝ ya ɓuiɓua a ǝrr i nwongǝi! Ɓǝ&gt;&gt;<verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />Dangtthǝ kwɔ u gei nugkwɔ ni yang, ya Farisiyawa i ya Sadukiyawa baipi bǝ kwatha, ǝrr loi gabtha. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />(Bakwɔ ya Sadukiyawa gei angǝ yayuu ǝrr bǝ ɓuiɓua langkwoi ya nwatummi gi Fuh yangǝu ko Ɓyang a Langǝ i; kwoi ya Farisiyawa dǝba a langǝ itthǝ ǝndǝi nǝ taiu.) <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />Buogbǝi ǝrr nyari, langkwoi yakun dang ya nanatthǝnung zuu gi Musa kwɔ lǝ ya Farisiyawa kwɔ dǝi nǝbo nyimnwa la langǝ i angǝ.&lt;&lt;Ɓi tǝi nung akun la ɓko i yiɓǝi kwɔ lǝu! Lko Ɓyang a Langǝ i ko ǝnya nwatummi gi Fuh geiu ba!&gt;&gt;<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />Bǝ nyimtha nwa ɓǝ nyari kwɔ yikku ya soja ɓyǝa mangǝ tǝn i tǝrrǝ Bulus lǝtha. Nungkwɔ u gei ya soja tǝ nungtha, tǝ lǝi Bulus nailǝ palǝ, langkwoi lǝiu tǝlǝ gwoi gi.<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />Nungvii lǝ Fuh dǝi gbag Bulus geiu angǝ,&lt;&lt;Ba surr vulli thǝ! A gei shǝdǝ mǝng lǝ bam bǝi kwɔ dang Urshalima, langkwoi ma to manungɓǝ Roma.&gt;&gt;<verse eid="ACT 23:11" /></para>
  <para style="s">Bǝ Mablǝi Yangbǝ I Thǝb Bulus</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />Ibǝi kan yakun dang ya Yahudawa gǝmtha langkwoi i mab lǝi. I zuu nung i tangnungǝu ko i nwa nung a kunnu nǝ i thǝb Bulus ɗǝ. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />Yayuu pa thǝm rabbǝng kwɔ mab nungkwɔ sua tha ɓǝ.<verse eid="ACT 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 23:14" />Yang itǝ sua yikku ya nyǝknung i yakku i gei angǝ, &lt;&lt;Ɓi zuunung ɓingǝ ɓi tangnungǝu nǝɓi thǝb Bulus ɗǝ. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />Lakwɔ yang, mǝ i yakku ɓa tumbǝi sua gong ya soja wulǝ Bulus lǝ tthasi mǝ, mangǝ dǝma yiɗi bǝ tǝi ba a kun lolǝ matthǝ. Kwoi ɓi mab tthǝɓi ɓi thǝu nwuni bǝ u kǝn bǝikwɔ.<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />Kwoi yui young gi Bulus a yisi lǝbǝ mab bagi kwɔ, nungkwɔ utǝ gwoi ya soja ɓǝ tǝu gei lǝ Bulus tthǝ.<verse eid="ACT 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 23:17" />Yang Bulus lubǝ yikku ya soja akun u geiu angǝ, &lt;&lt;A lǝi munthang a yiɓǝi kwɔ a tǝlǝ sua gong ya soja; u tthǝ i nungkwɔ u geiu tthǝɓǝ.&gt;&gt;<verse eid="ACT 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 23:18" />Yikku ya soja ɓǝ lǝiu, owh lǝ si tǝlǝ sua gong ya soja ɓǝ, nung kwɔ u gei angǝ&lt;&lt;Ya pursǝna Bulus, lubǝim u geim angǝ ǝn wulǝ munthang a yiɓǝi kwɔ lǝ suamǝ u tthǝ i nungkwɔ u geia tthǝɓǝ.&gt;&gt;<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />Gong ya soja ɓǝ muna yuiɓǝ, owhlǝ si nkolǝ, langkwoi u ɓibbu angǝ, &lt;&lt;Ən ɓǝtǝn dǝma yidɗi bǝ geim tthǝ?&gt;&gt;<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />U gei angǝ,&lt;&lt;Ya dǝ kab nwa nung ya Yahudawa gwablǝ thatthǝ angǝ bung a wulǝ Bulus tthasi yakku, to mangǝtǝn yakku dǝna yidɗi bǝ tha pi baɓǝ i ibǝi nung la langǝ i lolǝ. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />Kwoi ba gwabbǝi tthǝthǝ, bakwɔ yayuu pǝl thǝmrab kwɔ a pyǝa langkwoi dǝna kiu. I zuu nung angǝ i tang ko i nwko nǝ i thǝu ɗǝ. Lakwɔ nikwɔ i mab tthǝi yang, dǝnni ki nungkwɔ ma gei ɓǝ.&gt;&gt;<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />Gong ya soja ɓǝ gei angǝ, &lt;&lt; Ba gei lǝ yuu a kun tthǝ mangǝ a geim bakwɔ tthǝng thǝ.&gt;&gt;Nungkwɔ u gei baittha ɓǝ angǝ pa.<verse eid="ACT 23:22" /></para>
  <para style="s">I Tǝlǝ Bulus Lǝ Sua Gwamnǝ Filikus</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />Yang gong ya soja ɓǝ lubǝ yakku ya soja gu rab u gei angǝ,&lt;&lt;Ɓa mab ya soja thǝmnu itǝ Kaisariya, suatha i ya prǝ thǝmtai pǝmna sob i ya kaɓui thǝmnu, i ǝǝ lobǝ pko lona songsob a nungvii kwɔ. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />Ɓa dǝ i prǝ a kun lǝ Bulus kwɔ u ɗab yangbǝ u tǝsua gwamnǝ Filikus latthǝ.&gt;&gt;<verse eid="ACT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 23:25" />Yang gong ya soja ɓǝ vulǝ nung manungkwɔ ni:<verse eid="ACT 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 23:26" />Kalkodiyas Lisiyas Sua Yuu Angã, Gwamnǝ losua Filikus: dǝm gumbǝi.<verse eid="ACT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 23:27" />Ya Yahudawa muo yiɓǝi kwɔ langkwoi dǝnni tǝbǝ thǝu. Ənlǝ angǝ u ǝn ya losua Romawa, nungkwɔ ǝntǝ suatha i ya soja tǝn muu nailǝ.<verse eid="ACT 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 23:28" />Dǝm yidɗi bǝ ibǝ bakwɔ dǝi mulǝ ɓǝ, nungkwɔ ǝn wulǝ sua yakku gi. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />Ən tǝiu i nung a kun kwɔ u ɓui ɓua ko i tǝulǝ pursǝna ɓǝlǝu; bakwɔ i mulǝ kwɔ ǝn bǝ ɓib ba lo nung zuu gi.<verse eid="ACT 23:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 23:30" />Langkwoi kwɔ i geim tthǝ angǝ i kǝptha nwa lolǝ, dang tthǝ niyang ǝn tǝulǝ suamǝ. Ən gei yakwɔ ɓuob nwa lo kwɔ i wulǝ bakwɔ i muulǝ kwɔ tthasi mǝ.&gt;&gt;<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />Ya soja to nung to gi. I muo Bulus langkwoi i lǝiu nungviilǝ kulo i tǝlǝ Antibatiris. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />Ibǝi kan ya soja a bo kwoi suai tǝ gwoi i yitthǝ ya prǝ yangbǝ i pkolǝ. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />I tǝulǝ Kaisariya, i dǝ nungvullǝ ɓǝlǝ gwamnǝ, langkwoi i dǝ Bulus dang nko. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />Gwamnǝ ɓǝ than nungvullǝ ɓǝ u ɓyib Bulus angǝ u ǝnya gwɔ nwua. Kwɔ u lǝ angǝ u ǝnya Kilikiya, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />U gei angǝ,&lt;&lt;Mǝn la ǝn lǝ nǝ yakwɔ ɓuob nwa lomǝ nǝ wuo ɓǝ.&gt;&gt;Yang u dǝ ba nyimtthǝ angǝ i dǝ ya kinung ki Bulus gwoi hiridus lǝ.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">Ɓuobnwa Lo Bulus.</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />Lo bo nu Gong ya Nyǝknung Hananiya ǝrr tǝ Kaisariya i yakun dang yakku i lko ya akun tthǝ ɗuǝnnu ǝn Tartulus. I ɓuobnwa lo Bulus tthasi Gwamnǝ Filikus lǝ. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />Yang i lubǝ Bulus i wulǝ dang , nungkwɔ Tartulus baipi bǝ than ɓuobnwa gu, manungkwɔ ni:</para>
  <para style="p" vid="ACT 24:2">&lt;&lt;Ya angǝ a! Bǝ dǝ kab nwa nung mǝ i yiggǝi wuɓilǝ bǝ ǝǝ a langǝ i tthǝ sua tuɗing, langkwoi bǝ ɓyǝa bǝimǝ tuutthǝ wulǝ bǝ mǝrǝm nung kpaaɗing losua ɓi. <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />Dǝɓi kǝb lo nungkwɔ ko pǝlla ǝndǝi langkwoi lona ǝndǝi, langkwoi ɓi to sakkong filikus. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />Ən yiɗi bǝ lǝi lona mǝ kpaatthǝ lǝu, dǝm ɗyǝab ba a lǝ ba ɓi kwɔ tuab ɓǝ. <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />&lt;&lt;Ɓi tǝi yiɓǝi kwɔ ǝnya ɗuu yurrǝ, u baipi yurrǝ dang ya Yahudawa bǝikwɔ ǝndǝi longwam kwɔ langkwoi u lǝ yikku ya Nazarat. <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />Langkwoi u yidɗi bǝ ɓanglǝ Kǝm Nyǝknung, nungkwɔ ɓi muu. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />Nungkwɔ yikku ya Lisiyas wua muu naɓi i ttha. <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />Na ɓib yiɓǝi kwɔ, mǝ i namǝ ma ibǝi nwuo lǝ nungkwɔ ɓi ɓuob nwa lolǝ ɓǝ.&gt;&gt; <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />Ya Yahudawa kǝptha lo i ilǝ gwab bǝ ɓuob nwaɓǝ angǝ nungkwɔ ǝndǝi ǝnba a langǝ i.<verse eid="ACT 24:9" /></para>
  <para style="s1">Bulus Gei Nwuo Tthasi Filikus.</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />Gwamnǝ ɓǝ nanko angǝ Bulus gei ba, nungkwɔ Bulus gei angǝ,</para>
  <para style="p" vid="ACT 24:10">&lt;&lt;Ən ibǝi yang mǝn ya to kwan losua kwɔ ttha kpaaɗing, langkwoi nungkwɔ tthǝm la ǝndǝi kwɔ mǝn gei nwam tthasi mǝɓǝ.<verse eid="ACT 24:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 24:11" />Manungkwɔ ma ɓuan ma ibǝi i namǝ kwɔ, pa bo sop iu rab kwɔ paɓǝ lǝu ǝntǝ Urshalima bǝ wab Fuh. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />Ya Yahudawa tǝim dǝm nyimnwa i yuu a kun dang kǝm Nyǝknung lǝu, ko i tǝim dǝm ǝrlǝ kiggǝ yayuu lǝu, ko dang kǝm kǝptha lǝu ko bǝi a kun gwoi angǝ a lǝ. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />Ko i ɓuan i gei nungkwɔ lakwɔ i ɓuob nwa lom lǝɓǝ. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />Ən gwabba nungkwɔ tthǝng: Dǝm wab Fuh ya bǝba ɓi i bǝ muo nunglǝi kwɔ i gei angǝ ǝn pǝllǝ ɓǝ. Kwoi langkwoi ǝn dǝ ba a langǝ i tthǝ nungkwɔ ǝndǝi i vullǝ dang nung zuu gi Musa i nungvullǝ ya gei ba a tthasi ɓǝ. <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />Ɓang tthǝ i bǝ dǝnyi kun i ɓǝ tthǝ Fuh manungkwɔ yakwɔ dǝ ɓǝ, ɗuǝnni ni, yayuu ǝndǝi, i ya langǝ i i ya ɓko, i ǝrr bǝ ɓui ɓua. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />Langkwoi nungkwɔ vii ǝndǝi dǝmǝn ɗuong nungǝm yangbǝ lo nyim kai thasi Fuh i yayuu lǝ.<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />&lt;&lt;Tthasua kwɔ ǝn yitthǝ Urshalima ttha kpaatthǝ kwɔ, ǝntǝ bǝi ɓǝ yangbǝ ǝntǝ tǝn dǝ nungkurɓǝ lǝ yayuum, yangbǝ i nyǝklǝ nung. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />Kwɔ ɓang dang bǝto nungkwɔ i tǝim dang kǝm Nyǝknung tthasua kwɔ ǝn alo ɓang ɗiggǝ tthǝ. Kon yayuu yangǝu i ɓanglǝu langkwoi bǝ ǝrlǝ kiggǝ yangǝu. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />Kwoi yakun dang ya Yahudawa gwɔ losua Asiya kwɔ bǝilǝ; i inai lǝ kaso i wuo tthasi ɓǝ langkwoi i wulǝ ɓuob nwa gi nǝ i tthǝ i nung a kun lom ɓǝ. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />Ko yakwɔ bǝi kwɔ gei nungkwɔ i tǝim lǝ ɓǝ kwɔ ǝndǝi kwɔ ɓang tthasi yakku ɓǝ <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />ǝn lo nung kun ɓuo kwɔ ǝn lubǝi kwɔ ǝndǝi ttha siǝ ɓǝ: &lt;Dǝma tom kwan ɗigǝ babǝ dǝ ba a langǝ i kwɔ gǝngǝ ya ɓuiɓua a ǝrr i nwongǝi ɓǝ.&gt;&gt;&gt;<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />Yang Filikus, kwɔ ibǝi nung ni kwɔ, lam bǝ lǝ baɓǝ. &lt;&lt;Kwɔ Lisiyas gong ya soja wɔ,&gt;&gt; u gei angǝ, &lt;&lt;Mǝn to kwan mǝ.&gt;&gt; <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />U gei yikku ya soja kwɔ dǝna ɓyǝa Bulus kwɔ u dǝ ya ki bǝi kiu, kwoi i yi yakwɔ dǝna ɓyǝa kwɔ du nungkwɔ dǝu yiɗi ɓǝ.<verse eid="ACT 24:23" /></para>
  <para style="s">Bulus Tthasi Filikus I Durusila.</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />Tthasua bo kpaatthǝ Filikus wuo suatha i siu Durusila, kwɔ ǝn ya Yahudawa. U tumbǝi lo Bulus langkwoi u lǝu kwɔ u gei ba lobǝ dǝnyitthǝ dang Yeso kristi.<verse eid="ACT 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 24:25" />Kwoi kwɔ Bulus li lo tthǝ dǝna gei ba lo nung a langǝ i, bǝ mua lo, i bǝ wuo gi vii to kwan, Filikus dǝna survuli gei angǝ, &lt;&lt;Ma ɓuan ma pa lakwɔ. Mǝn lubǝi mǝ langkwoi nǝ ǝntǝi lona ɓǝ.&gt;&gt; <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />Lona lǝkwɔ dǝu ɓyǝa angǝ lko Bulus a ji nungkurɓǝ; langkwoi lǝ ba ɓǝkwɔ vii ǝndǝi dǝu tumbǝi lo langkwoi u gei ba i ulǝ. <verse eid="ACT 24:26" /><verse number="27" style="v" sid="ACT 24:27" />Tthasua ttha rab pa, nungkwɔ Borkiyas Festas wuo lǝi bǝ dǝi gi Filikus lǝ Gwamnǝ. Filikus dǝna yiɗi bǝ i tǝi bǝ ɓko lǝi i ya Yahudawa nungkwɔ u yi Bulus pursǝna.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">Bulus Tǝlǝ Ɓuobnwa Gu Lǝ Tthasi Gong Yigwoi Kaisar.</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />Tthasua bo tai Festas kǝn losua ɓǝ, u ǝrr Kaisariya u tǝ Urshalima, <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />ǝn bǝilǝ kwɔ yikku ya nyǝknung i yakku ya Yahudawa wulǝ bagi lo Bulus. I yam Festas<verse eid="ACT 25:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 25:3" />yangbǝ u ɓkoi nunglǝi tthǝ yangbǝ Bulus tǝ Urshalima, bakwɔ i mablǝi bǝ thǝu lolǝi lǝ.<verse eid="ACT 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 25:4" />Festas gwab nwa angǝ, &lt;&lt;I tthǝb Bulus lǝ ya pursǝna Kaisariya, langkwoi ɓang i namlǝ sua tuu yang mǝn kwoi mǝn tǝ bǝiɓǝ.<verse eid="ACT 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 25:5" />Ɓa yi ya dǝ kab nwa nungɓǝ tǝ Kaisariya i ɓanglǝ yang i gei nung a ɓko gi yiɓǝi ɓǝ nǝ u to nung akun la ɓkoɓǝ,&gt;&gt;<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />Festas to bo ǝngunai langkwoi ko bo sop i ilǝ yang u tǝ Kaisariya. Ibǝi kan u ǝǝ bǝ to kwan, u dǝba angǝ i wulǝ Bulus lǝ dang . <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />Kwɔ Bulus wua, ya Yahudawa kwɔ ǝrr Urshalima kwɔ kwarǝu dǝilǝ, dǝnni wulǝ ɓuobnwa kpaatthǝ a nyimmi lolǝ, kwɔ i ɓuan i gei angǝ manung ɓǝni ɓǝlǝu. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />Kwoi Bulus gei nwuo angǝ: &lt;&lt;Ən to nung a ɓko lo nung zuu ya Yahudawa lǝu ko langkwoi lo kǝm Nyǝknung ko lo kaisar Gong yigwoi Roma lǝu.&gt;&gt;<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />Kwoi Festas dǝna yiɗi tǝi bǝ ɓko lǝi iya Yahudawa, yang u ɓyib Bulus angǝ,&lt;&lt;Ma yiɗi bǝ tǝ Urshalima tǝi to kwan tthǝ bǝi lǝ lo nung kwɔ tthasim kwɔ bǝi la?&gt;&gt;<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />Bulus gei angǝ, &lt;&lt;Ən dǝi tthasi bǝ to kwan kaisar Gong yigwoi, bǝi kwɔ i tom kwan ɓǝ. Ən to nung a ɓko lǝ ya Yahudawa lǝu, manungkwɔ ɓǝ i naɓǝ ɓa ibǝi ɓǝ.<verse eid="ACT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 25:11" />Nǝ ǝn ɓanglǝ nung zuu langkwoi ǝn to nung akun kwɔ i tom kwan ɓuatthǝ, Ən yam gǝngǝ pa lom lǝu. Kwoi nǝ bakwɔ ya Yahudawa wulǝ suamǝ kwɔ nǝ ǝn ba langǝ i lǝu, yuu a kun yangǝu a dǝm dang naiu. Dǝm gei lǝ Kaisar tthǝ.&gt;&gt;<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />Tthasua kwɔ Festas, tthasua kwɔ gei ba i ya thǝl bo, gwab nwa angǝ,&lt;&lt; A ɗuu bǝ lǝi kwan mǝ ma tǝlǝ sua kaisar Gong yigwoi, yang ma tǝn sua Gong yigwoi.&gt;&gt;<verse eid="ACT 25:12" /></para>
  <para style="s">Bulus Tthasi Agaribas I Barniki.</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />Natthǝ tuab Yigwoi Agaribas i Barniki, wuo Kaisariya bǝ gum Festas.<verse eid="ACT 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 25:14" />Tthasua kwɔ i ǝǝ bǝi lǝ sua tutthǝ yang, Festas gei balo kwan gi Bulus lǝ yigwoi tthǝ angǝ: &lt;&lt;Yiɓǝi a kuntthǝ bǝi kwɔ Filikus tthǝbbu pursǝna;<verse eid="ACT 25:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 25:15" />langkwoi kwɔ ǝntǝ Urshalima, yikku ya nyǝknung ya Yahudawa i ya dǝ kab nwa nung wulǝ ɓuob nwa lolǝ langkwoi i geim angǝ ǝn tou kwan ɓuatthǝ.<verse eid="ACT 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 25:16" />&lt;&lt;Kwoi ǝn gei gǝngǝ ɓi ya Romawa ɓi dǝ yuu kwɔ i ɓuob nwa lo ba nung a ɓko nwuni bǝ u kǝptha i yakwɔ ɓuob nwa langkwoi tǝi na gei nwuo lo bǝ ɓuob nwa lǝ. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />Kwɔ i wuo bǝi kwɔ, yang, ǝn ɓanglǝ lona lǝu, kwoi ibǝi kan ǝn ǝǝ bǝ to kwan ǝn gei gǝngǝ i wulǝ yiɓǝi ɓǝ lǝ dang . <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />Yakwɔ ɓuob nwa lo kwɔ dǝi nǝbo, kwoi i ɓuan i gei nung mulub a ɓko kwɔ dǝm ɓyǝa gǝngǝ i gei ɓǝ. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />Nungkwɔ i gei ɓuo nungkwɔ bǝ muo nwatha i ulǝ lo nunglǝi wab Fuh gi langkwoi lo yiɓǝi a kun kwɔ dǝi lu angǝ Yeso ɓǝ, kwɔ ɓuing ɓǝ; kwoi Bulus gei angǝ u i nwongǝi.<verse eid="ACT 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 25:20" />Ən dǝi lo nungkun kwɔ mǝnto kwɔ mǝnlǝ lǝ ba lo balǝ lǝu, nungkwɔ ǝn ɓib Bulus ko u gwab u tǝ Urshalima tǝi gei kwan ɓǝ bǝi lǝ lo nung kwɔ dǝi muo lǝ ɓa.<verse eid="ACT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 25:21" />Kwoi Bulus wulǝ ɓuob nwa ɓǝ; u gei angǝ i dǝ ya kinung kiu langkwoi yang Gong yigwoi tou kwan. Nungkwɔ ǝn dǝ ba gǝngǝ ya kinung kiu nǝ ǝn togǝu sua Gong Yigwoi ɗǝ.&gt;&gt;<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />Agaribas gei Festas angǝ,&lt;&lt; Dǝm yiɗi bǝlǝ yiɓǝi kwɔ i nam lǝ.&gt;&gt;</para>
  <para style="p" vid="ACT 25:22">Festas gei angǝ, &lt;&lt;Malǝu ǝnlǝ bung.&gt;&gt;<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />Ibǝi kan Agaribas i Barniki wuo dang kiggǝ a langǝ i wui tǝ dang kǝm kwan ɓǝ i yakku ya taɓui i gong yayuu gwoi angǝ a lǝ, Festas gei ba nungkwɔ i wulǝ Bulus lǝ dang . <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />Festas gei angǝ,&lt;&lt;Yigwoi Agaribas i yakwɔ i ɓilǝ bǝikwɔ ɓǝ: Ɓa ɓyǝa yiɓǝi kwɔ ya Yahudawa ǝndǝi bǝikwɔ i Urshalima, ɓuobnwa lo tthǝmlǝ. I buogbǝi angǝ bǝ i yiu i nwongǝi guthǝ. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />Kwoi ǝn ɓuan ǝn tǝi nungkwɔ uto kwɔ i tou kwan ɓua ɓǝlǝu. Langkwoi kwɔ u i nkolǝ yiɗi angǝ Gong Yigwoi to kwan ɓǝ, ǝn togǝu Roma lǝ. <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />Kwoi ǝn yangǝu i nung a kun matthǝ kwɔ mǝn vullǝ lolǝ i tǝlǝ sua Gong Yigwoi lǝu. Nungkwɔ ǝn wulǝ bǝikwɔ suamǝ, Tthasi mǝ, Yigwoi Agaribas! Yangbǝ, tthasua kwɔ na alo bǝ nuong baɓǝ, Yang lko ɓangtthǝ i nungkwɔ mǝn vullǝ ɓǝ. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />Bakwɔ dǝm nhǝm gǝngǝ ǝn bǝ nhǝm ba a langǝ i lǝu nǝ ǝn tuog ya pursǝna yang ǝn gei nung aɓau gu lǝu ɓǝ.&gt;&gt;<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">Bulus Geinwuo Tthasi Agaribas.</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />Agaribas gei Bulus angǝ,&lt;&lt;Ən gwabba tthǝng a gei nwamǝ.&gt;&gt; Bulus juan nko yi langkwoi gei nwuo manungkwɔ ni: <verse eid="ACT 26:1" /><verse number="2" style="v" sid="ACT 26:2" />&lt;&lt;Yigwoi Agaribas! Ən lǝi lom ya sa ɗiggǝ mǝn dǝi tthasi mǝ mǝn gei nwam lo nung ǝndǝi kwɔ ya Yahudawa ɓuob nwa lom ɓǝ, <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />Manungkwɔ a ibǝi nungzuu ya Yahudawa lalangǝ i ibǝ nyimnwa gi kwɔ. Ən ɓibba, yang, a lǝm i munyal.<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />&lt;&lt;Ya Yahudawa ǝndǝi ibǝi bǝ ǝǝm kwɔ ǝn ǝǝ lakuu kwɔ ɓang dang muntthang ɓǝ. I ibǝi kwɔ ǝn ǝǝ losua ɓǝ, la nwasiu losuam langkwoi yang dang Urshalima. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />I ibǝi ǝndǝing, nǝ i gwab i gǝn gei ɓǝ, angǝ baipiu la nwasiu ǝn ǝǝ mangǝn ya wab Fuh ɓi nyimtthǝ ɓǝ, ya Farisiyawa. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />Langkwoi lakwɔ ǝn dǝi bǝikwɔ yangbǝ i tom kwan babǝ dǝnyimtthǝ kwɔ Fuh dǝ ganglang gu i ya bǝba ɓi ɓǝ- <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />U nungɓǝ kwɔ ya kab gwoi yayuu ɓi sob iu rab dǝnyitthǝ dǝna yiɗi bǝ muu ɓǝ, kwɔ dǝi wab Fuh dang fuh i nungvii ɓǝ. Langkwoi lǝ babǝ dǝnyi ɓǝkwɔ, Gong Yigwoi, nungkwɔ ya Yahudawa kwɔ ɓuob nwa lom! <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />Ən ba ɓǝ bǝ ɓǝkwɔ bǝi kwɔ ɓuon ɓǝtthǝ ɓa dǝ ba a langǝ i tthǝ angǝ Fuh dǝna ǝrr lǝ kwamɓui yuu?<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />&lt;&lt;Ɓang i nam lǝ ǝn nhǝm gǝngǝ mǝn to nung ǝn dǝi kwɔ mǝn ɓuan bǝ ǝn tthǝng lǝba Yeso ya Nazarat ɓǝ, <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />U nungkwɔ ǝn to Urshalima ɓǝ. Ən muo ttha na yakku ya nyǝknung ǝn tthǝb yayuu gi Fuh kpaatthǝ pursǝna; langkwoi kwɔ i toi kwan ɓua tthǝ, ɓang i nam gwabbǝi lǝu. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />Lona kpaatthǝ dǝm ji zuii dang kǝm kǝbtha ya Yahudawa langkwoi dǝm toi yangbǝ i yǝrnwa tthǝ bǝ dǝnyi gi. Dangwam ɓanglǝ tthǝi kwɔ ǝntǝ losua yayol tǝn ji zuii.<verse eid="ACT 26:11" /></para>
  <para style="s">Bulus Ghai Bǝ Mǝrrǝm Gu Lǝya Mua Sua Fuh</para>
  <para style="r">(Acts 9:1-19; <ref loc="ACT 22:6-16">22:6-16</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />&lt;&lt;Lo u baɓǝ kwɔ ǝntǝ Dimaska i ttha bǝ dǝba yakku ya nyǝknung. <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />Fuh nyilo lo lǝi lǝ, Gong yigwoi, kwɔ ǝn ɓyǝa lua a kai pǝl fuh adu, dǝna wɔ wayi lǝ wua gab tthǝm i yakwɔ dǝna tǝ suatha i ɓanglǝ ɓǝ. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />Ɓi ǝndǝi ɓi o pangsua, nungkwɔ Ənlǝ yol dǝna geim ba i nwa ya Yahudawa angǝ,&lt;Shawulu, Shawulu! Ən baɓǝ bǝ dǝma dǝm zui? Dǝmma dǝ lomǝ lǝ zuii i bǝ ta zong mangǝn nyak dǝna ta kab gi togwoi gu.&gt; <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />Ən ɓib gǝngǝ,&lt;Mǝn yittǝn, Dangbang?&gt; Langkwoi Dangbang gwab nwa angǝ,&lt;Ən ɓang Yeso, kwɔ dǝma dǝmzuii ɓǝ.<verse eid="ACT 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 26:16" />Kwoi a ǝrr a dǝinǝbo lo bomǝ. Ən fug tthǝmmǝ yangbǝ ǝn da nung to lǝ thǝbbǝm. Ma gei nungkwɔ a ɓyǝa ǝn tolǝ ɗiggǝ kwɔɓǝ langkwoi nungkwɔ mǝn tanatthǝ tthasi ɓǝ. <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />Mǝn nwong a naya Israila langkwoi na yakwɔ ǝn ya Yahudawa lǝu ɓǝ yakwɔ mǝn tumma suai ɓǝ. <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />Ma ɓko nungǝi langkwoi ma mǝrrǝmmǝi tthǝ thǝl ma tǝlǝ nwa lua langkwoi tthǝ ttha Mungkullum ma tǝlǝ sua Fuh, yangbǝ tthǝ bǝ dǝnyitthǝm i al nung a ɓko gilǝtǝ langkwoi i tǝi bǝ ǝǝ gi dang yakwɔ Fuh mko lǝ yayuu guɓǝ.&gt;<verse eid="ACT 26:18" /></para>
  <para style="s">Bulus Gei Nung To Gu</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />&lt;&lt;Langkwoi nungkwɔ, Yigwoi Agaribas, Ən nyimlo lo nung kwɔ ǝn ɓyǝa wɔ wayi ɓǝlǝu.<verse eid="ACT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 26:20" />La nwasiu ǝn gei dang Dimaska langkwoi dang Urshalima langkwoi dang Yahudiya langkwoi dang yakwɔ ǝn ya Yahudawa lǝu ɓǝ, Ən gei ba Fuh tthǝ ya gǝi gǝ i mǝrrǝm lo nyiǝ tthǝ nung a ɓko gi i kwoi i wuo sua Fuh yang i to nungkwɔ a ǝǝlǝ bǝ al nung a ɓko gilǝtǝ ɓǝ. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />Ən u ba ɓǝ kwɔ nungkwɔ ya Yahudawa kwɔ muam kwɔ ɓang dang kǝm nyǝknung ɓǝ, langkwoi dǝnni yiɗi bǝ thǝm. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />Kwoi wulǝ vii a ɗiggǝ kwɔ Fuh dǝna nwonglom, langkwoi nungkwɔ Ən dǝi bǝi kwɔ dǝm gei nwam tthasi yayuu ǝndǝi, lǝya tuab langkwoi ya angǝ a ǝndǝi. Nungkwɔ dǝm gei kwɔ ǝn nungɓǝkwɔ ya gei ba a tthasi Musa gei angǝ wa totthǝ ɓǝ:<verse eid="ACT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 26:23" />angǝ Kristi a to zuii langkwoi ulǝ yuu a nwasiu kwɔ ǝrr i nwongǝi bǝ ɓui ɓua ɓǝ, yangbǝ u gablua lǝ ya Yahudawa tthǝ i yakwɔ ǝn ya Yahudawa lǝu ɓǝ.&gt;&gt;<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />Manungkwɔ Bulus gei nwuo nunglǝi kwɔ, Festas buogbǝi lo angǝ, &lt;Nung lo lomǝ Bulus! Ghaali nung thanni mǝ dǝna wua lǝ nung lo tthǝ!&gt;&gt;<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />&lt;&lt;Bulus gwab nwa angǝ, &lt;&lt;Nung lo yangǝu lommu Festas, Yuu a Langhi! Dǝm gei ǝnba a langhi. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />Yigwoi Agaribas! Mǝn ɓuan mǝn gei ba tthǝ vulli yangǝu, Bakwɔ a ibǝ nunglo nungkwɔ ǝndǝing. Ən ibǝing a ɓyǝai i kwɔ ǝndǝing, bakwɔ nungkwɔ to nung lǝ bǝ pyǝa ɓua nunglǝu. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />Yigwoi Agaribas, a dǝ ba a langǝ itthǝ ya gei ba a tthasing a? Ən ibǝi a dǝng!&gt;&gt;<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />Agaribas gei Bulus angǝ,&lt;&lt;Dang lona tuab kwɔ dǝmma nhǝm mangǝ lko ma mǝrrǝm mǝm lǝ ya Krista?&gt;&gt;<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />Bulus gwab nwa angǝ,&lt;&lt;ko lona tuab ko lona tutthǝ, bǝ pinwam tthǝ Fuh nungɓǝ lǝ mǝ i sua ɓǝ ǝndǝi kwɔ dǝ ɓa lǝm ɗiggǝ kwɔ lko ɓa mǝrrǝm manung abǝm lko ǝn ba sarka kwɔ ɓuo!&gt;&gt;<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />Yang Yigwoi, i gwamnǝ, Barniki i sua yakwɔ ǝrr dǝinǝbo,<verse eid="ACT 26:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 26:31" />langkwoi tthasua kwɔ dǝnni pa i gei lǝ thatthǝ angǝ, &lt;&lt;Yiɓǝi kwɔ to nung akun kwɔ u ɓui ɓua ɓǝlǝu ko i tǝulǝ pursǝna ɓǝ.&gt;<verse eid="ACT 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 26:32" />Langkwoi Agaribas gei Festas angǝ, &lt;&lt;Yiɓǝi lko i yiuna nǝ krǝ u lǝi ɓuob nwa gu u tǝlǝ tthasi Kaisar lǝu ɓǝ.&gt;&gt;<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">Bulus Ɗab Kwai Tǝ Roma</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />Kwɔ i gwab i gei angǝ ɓi ɗab kwai ɓitǝ losua Italiya, i dǝ Bulus i yakun dang ya pursǝna lǝ Yuliyas, yikku dang ya soja Romawa kwɔ dǝnni lu angǝ&lt;&lt;Ya soja Gong yigwoi.&gt;&gt; <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />Ɓitǝ dang kwai Adaramitiya, kwɔ da tǝbǝ tǝ nwamung losua Asiya ɓǝ, nungkwɔ ɓi pa. Aristarkus ya Makidoniya, ǝrr Tasalonika, u suatha i ɓi. <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />Ibǝi kan ɓi pin Sidon. Yuliyas to kiggǝ maɗing le Bulus langkwoi u yiu u tǝsua ya ǝnthǝu, yangbǝ i duu nungkwɔ dǝu yidɗi ɓǝ. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />Ɓi ǝrr bǝilǝ, dang kwailǝ ɓi thko ttha nwangwam akwɔ nungku tthǝɓǝ ɓitǝ Kubrus bakwɔ wa dǝna ɓuob ɗing lo nwamlǝ ɓǝ. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />Ɓi nyang nwam lo nwam Kilikiya i a Bamfiliya langkwoi ɓi wua Mira dang Kilikiya. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />Bǝilǝ kwɔ yikku ya soja ɓǝ tǝi kwai kwɔ ǝrr Iskandariya kwɔ dǝna tǝ losua Italiya ɓǝ, nungkwɔ u dǝɓi dang ǝu. <verse eid="ACT 27:6" /><verse number="7" style="v" sid="ACT 27:7" />Ɓi thko tǝmtǝm ɓo kpaatthǝ i tthǝzi nwuni ɓi tǝ gwoi angǝ a Kinidas. Wa ɓǝ yiɓi ɓi thko natthǝ lonalǝ kullo lǝu, nungkwɔ ɓi thko ttha lona nungku gum Karita, ɓi pa gbagtha i Salmoni. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />Dǝɓi muo ttha nwa gui nwam i zuii lǝ ɓi wuo bǝi kwɔ dǝnni lu angǝ bǝi sob lo, tutha i gwoi angǝ a Lasiya.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />Ɓi ǝǝ bǝi lǝ sua tuutthǝ, thko lonwam lǝ ǝr ɓkoɗing, bakwɔ lakwɔ vii zuu fuh paǝng. Nungkwɔ Bulus gup ɗogsui manungkwɔ ni: <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />&lt;&lt;Yaɓǝi, ǝn ɓyǝa thko ɓi baipiu bǝikwɔ tǝlǝ si a ɓkoɗing; nung kpaaɗing dang kwai kwɔ a ɓanglǝ i kwai kwɔ ǝndǝi, langkwoi i nwongǝi ɓi langɓǝ.&gt;&gt; <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />Kwoi yikku ya soja ɓǝ gwab nungkwɔ ya kwog kwai i yuu kwai ɓǝ a gei ɓǝ, langkwoi ǝn nungkwɔ Bulus gei ɓǝlǝu. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />Bǝ sob lo ɓǝ mko bǝ ǝǝu nǝ wakong: nungkwɔ yayuu kpaatthǝ gwab angǝ i lilotthǝ i ɗong nungǝi itǝ Finikiya, nǝ a to tthǝnto ɓǝ, yangbǝ i ikong bǝilǝ. Finikiya ǝn bǝ pyǝa dang Karita lǝ ki nungǝu gwɔ lasua lǝdah langkwoi gwɔ tal lǝdah.<verse eid="ACT 27:12" /></para>
  <para style="s">Wamung Lo Nwam</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />Waa baipi bǝ ɓuobbu tǝmtǝm gwɔ lasua, yaɓǝi ɓǝ dǝna nhǝm angǝ lko i tǝi loi ǝntǝi, nungkwɔ i bi nung tthǝb kwai ɓǝ dǝnni kog kwai ɓǝ i mua ttha Karita. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />Kwoi sua tulǝu yang waa angǝ a nyimtthǝ ǝrr- akwɔ dǝi luu angǝ&lt;&lt; Yurokilidon&gt;&gt; dǝna ɓuob baipiu gum lǝ. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />Waa ɓǝ ɓuob kwai ɓǝ, langkwoi kwɔ ɓi ɓuan ɓi kog kwai ɓǝ kinungǝu gwɔ kwɔ waa ǝrtthǝ ɓǝu, mǝrǝm nungǝu, ɓi muan tthǝɓi yi waa ɓǝ lǝi ɓi na i tǝlǝ. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />Ɓi tǝi nungku kwɔ ɓi pa ɓitǝ ttha lasua i gum kwɔ dǝnni lu angǝ Kkoda ɓǝ. Bǝilǝ, i zuii, nungkwɔ ɓi palǝ kwai a tuab ɓǝ ɗab gwam, <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />I gub i ɗab lǝ dang Kwai angǝ a ɓǝ nungkwɔ i tthǝb Kwai ɓǝ i ɓǝl i mǝrrǝm i kǝb lǝ kwai angǝ a ɓǝ. Dǝnni survulli lko angǝ wui ɗab lo suazui sirtis nwa ǝn gwui Libiya lǝ, nung kwɔ i pin lǝ nung pi kwai ɓǝ yang bǝ wa lǝi kwai ɓǝ. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />Wamung a nyimmi lilotthǝ, nungkwɔ ibǝi kan ɓi ee nung dang Kwai lǝ ɓi alǝtǝ. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />Langkwoi ibǝi kan i ee nung to nung to dang kwai lǝ i alǝtǝ. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />Ɓi to bo kpaatthǝ ɓi ɓyǝa Fi i vin lǝu, langkwoi wa ǝnwa bǝ ɓuobbu nyimtthǝ. Bǝi lǝ kwɔ niyang ɓi ibǝi ɓingǝ nwongǝi ɓi sobbu.<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />Tthasua kwɔ yakwɔ dang kwai kwɔ sua tutthǝ i tang nunglǝu, Bulus dǝinǝbo tthasiǝ gei angǝ, &lt;&lt;Yaɓǝi, kre nǝɓa lǝm ǝn lǝ yang ɓa yitthǝ Karita lǝu; yang krǝ ɓi ɓanglǝ nung i nung naɓi lalǝu. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />Kwoi lakwɔ dǝm yamɓǝ, ɓa tthǝb dang wa ɓǝ! Yuu akun yangǝu dang ɓǝ nwongǝi gu a pko; ǝn Kwai ɓuo a la. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />Bakwɔ lali nungvii ya nwatummi gi Fuh kwɔ ɓang ǝn abo kwɔ langkwoi dǝm wab kwɔ wuu suam <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />wuu gei angǝ,&lt;Bǝ a survulli thǝ Bulus! Ma dǝn dǝi tthasi Gong Yigwoi. Langkwoi Fuh dang nung a langǝ i gu tthǝmǝ lǝ nwong yakwɔ dǝna thko dang kwoi i mǝlǝ ɓǝ.&gt; <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />Manung kwɔ niyang ɓa tthǝb nyitthǝ, Yaɓǝi! Əndǝ ba langǝ i tthǝ Fuh yang manung akwɔ u geim tthǝ angǝ ato nungɓǝ. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />Kwoi ɓi kog kwai ɓitǝ nwamung lo gum akun ǝntǝ.&gt;&gt;<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />Ən nungvii a sob iu nai, langkwoi waa dǝna tog ɓi dǝna thkolǝ lo nwam Adariya. Gbag nǝkasua ya kog kwai ibǝi angǝ dǝɓi gbag nwangwam. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />Nungkwɔ i li ɓǝl nung mung i ɓui lǝ tthǝu tuu li mung ɓǝ mitǝ thǝm rab; natthǝ tuab i to akun i tǝi thǝm nai pǝmna sob. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />Dǝi survulli angǝ kwai ɓǝ a si tthǝ tal, nungkwɔ i pinlǝ nung pi kwai ɓǝ ni nai tthasua langkwoi i pinwa angǝ bǝi kan. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />Yang ya kog Kwai ɓǝ dǝna yiɗi bǝ surru a pa dang kwai lǝ. I pin lǝ Kwai a tuab ɓǝ dang mung, mangǝttǝn dǝnni yiɗi bǝ pinlǝ nung pi kwai a tthasi. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />Kwoi Bulus gei yikku ya soja i ya soja ɓǝ angǝ,&lt;&lt;Nǝ ya kog Kwai kwɔ dǝi dang kwai lǝ lǝu, yang ɓuan ɓa sobbu.&gt;&gt;<verse eid="ACT 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 27:32" />Nungkwɔ ya soja ɓǝ ɓǝr ɓǝl ɓǝ kwɔ muo kwai ɓǝɓǝ nungkwɔ kwai ɓǝ pa.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />Nwuni bǝ bǝi kan, Bulus yammǝi i ǝndǝi angǝ i tang nung akun: &lt;&lt;Dǝɓa ki bo sob iu nai lakwɔ, langkwoi lona kwɔ ǝndǝi nung yangǝu ɓa tangǝu. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />Dǝm yamɓǝ, yang, ɓa tang nung akun. Dǝɓa yiɗi yangbǝ ɓa sob. Ko byang lo ɓǝ kun lko.&gt;&gt;<verse eid="ACT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 27:35" />Tthasua kwɔ u gei nungkwɔ, Bulus lǝi Burodi, u to sakko lǝ Fuh tthasiǝ ǝndǝi. U kwǝh, dǝu tang. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />I tthǝb nyitthǝ, langkwoi i ǝndǝi langɓǝ i tang nung akun. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />Loɓi thǝm nu ɓua rab iu thǝm sob ɓua kun ilo thǝm tai oli iu kun dang kwai lǝ. <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />Tthasua kwɔ yayuu ǝndǝi tangnung fǝr, nungkwɔ i al nungmin kwɔ dang kwai lǝ kwɔ nung nwam yangbǝ kwai ɓǝ yǝb.<verse eid="ACT 27:38" /></para>
  <para style="s">Bǝ D̃a Gi Kwai</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />Kwɔ bǝi kan, ya kog kwai ɓǝ i ɓyǝa nwangwam i ilǝu, kwoi i suazui nwam langkwoi i gwablǝ thatthǝ angǝ, i kog kwai ɓǝ i ɗablǝ lo suazui nǝ i ɓumɓuan ɓǝ. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />Nungkwɔ i ɓǝr ɓǝl pi kwai ɓǝ nungkwɔ i yinatthǝ tǝ pi mung, langkwoi lona lǝ kullo i bi ɓǝl kwɔ muo nung kog kwaiɓǝ ɓǝ. Yang i ǝrr lǝ nung muo wa tthasi kwɔ i ǝrr lǝ yang bǝ wa ɓuob tok kwai ɓǝ tǝlǝ si, nung kwɔ ɓitǝ nwangwam. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />Kwoi ɓǝ si gum sua yang tǝ losua; tthasi kwai tthak dǝi lǝ kwoi ɓuan tǝn nu, kwoi tthasua kwai ɓǝ ɓuom dang tha ba waa kwɔ dǝna ɓuob nyimni ɓǝ.<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />Ya soja ɓǝ gwab lǝ thatthǝ angǝ i thǝb ya pursǝna ɓǝ ǝndǝi, yangbǝ bǝ yuu kun dang ǝi ai mung sur pa thǝ. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />Kwoi yikku ya soja ɓǝ dǝna yiɗi bǝ nwong Bulus, nungkwɔ nanni bǝ to nungɓǝkwɔ. Niyang u gei yakwɔ a ɓuan a ai mung kwɔ osi zuǝ yang ai mung tǝ nwangwam; <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />Sua yayuu ɓǝ atǝ bǝi ɓǝ, lo kab ko yakun dang kong kab kwai ɓǝ. Manungkwɔ ni ɓi ǝndǝi ɓi ɗab gwam latthǝ nǝkwam.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">Bulus Lo Gum Malita</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />Kwɔ ɓi pin dang Kwai lǝ latthǝ i nwongǝi ɓi, nungkwɔ nwuni ɓi ibǝi yiram ɗuǝn lo gum ɓǝ ǝn Malita. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />Yaɓǝi ɓǝ toɓi kiggǝ a langǝ i tthǝ ɗing. Mung baipi bǝ nko langkwoi ɗyǝko dǝna tǝm, nungkwɔ i mabɓi lua tthǝ i kǝb lǝ lo ɓi. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />Bulus gǝm kab, dǝu al dang lua lǝ kwɔ biǝk ǝrr i bakwɔ u lǝ bǝb lua kwɔ u kuluam nko. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />Ya bǝi ɓǝ ɓyǝa biǝk yag lo na Bulus i gei lǝ thatthǝ angǝ,&lt;&lt;Yiɓǝi kwɔ ǝn ya thǝbbǝi, ko kwɔ u sob lo nwam, nung a langǝ i yiu u ǝǝ i nwongǝiu. <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />Kwoi Bulus wab biǝk ɓǝlǝtǝ dang lua biǝk ɓǝ tou i nung a kunlǝu. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />Dǝnni ki kwɔ u fǝm ko u owh sua dang tthǝ yang u ɓui. Kwoi i ki sua tutthǝ nung akun tou lǝu, i mǝrrǝm bǝ nhǝm ba gi i gei angǝ&lt;&lt;U ǝn fuh!&gt;&gt;<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />Pangsua a kuntthǝ gbag bǝiɓǝ kullo ǝn a bǝ Babiliyas, gong yikku ya lo gum ɓǝ. U kǝb loɓi matthǝ langkwoi bo tai ɓi gwoi gu. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />Tthǝ Daa gi Babiliyas lko, tthǝ sɔni i na. Nungkwɔ Bulus patǝ dang kǝm gu, pinwa, dǝna lolǝ, u du tthǝla.<verse eid="ACT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 28:9" />Kwɔ nungkwɔ to nung, sua yakwɔ tthǝi lko lo gum lǝ ǝndǝi wua langɓǝ i tǝi tthǝla. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />I dǝɓi nung kpaatthǝ, langkwoi kwɔ ɓi pa dang kwai, i dǝɓi nungkwɔ dǝɓi yidɗi lǝ ba thko ɓiɓǝ.<verse eid="ACT 28:10" /></para>
  <para style="s">Bulus Ərr Malita Tǝ Roma</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />Tthasua Fi tai ɓi ǝrr dang Kwai Iskandariya, kwɔ dǝnni lu angǝ&lt;&lt;Yui thǝn gi Fuh,&gt;&gt; to lona kukam bǝilǝ. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />Ɓi wua gwoi angǝ a Sirakusa ɓi lo bǝilǝ bo tai. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />Bǝilǝ kwɔ ɓi lilo tthǝ dang kwai ɓi wuo gwoi angǝ a Rigiyum. Ibǝi kan waa baipi bǝ ɓuob bu lasua, langkwoi dang bo rab ɓi wuo gwoi angǝ a Butiyoli. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />Ɓi tǝi ya dǝba a langǝ i bǝilǝ kwɔ i gei ɓi angǝ ɓi ǝǝ i ilǝ bo nanaira. Langkwoi nungkwɔ ɓi wua Roma. <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />Ya dǝba a langǝi Roma lǝ baɓi nungkwɔ ǝrr wui kǝb lo ɓi tuu mangǝn lomu Abiyus langkwoi gwoi yayol tai yangbǝ i kǝb ɓi. Kwɔ Bulus ɓiy, u kha Fuh langkwoi u tǝi tthǝnyimmi ghaatthǝ. <verse eid="ACT 28:15" /><verse number="16" style="v" sid="ACT 28:16" />Kwɔ ɓi wuo dang Roma, i gwab lǝ Bulus tthǝ angǝ u tǝ tǝu lo iya Soja yangbǝ i kiu.<verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />Tthasua ɓo tai Bulus lubǝ yakku ya Yahudawa bǝ i kǝptha. Kwɔ i gǝmtha, u gei angǝ, &lt;&lt;Ya youngǝm ya Israila, ǝn ibǝi Ən to nung aɓau lǝ ya yuu ɓi lǝu ko tthǝ nungzuu kwɔ ɓi mua na ya Bǝba ɓi ɓǝlǝu, i muam lǝ ya pursǝna dang Urshalima langkwoi i dǝm lǝ ya Romawa. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />Tthasua kwɔ i nuongǝm, ya Romawa dǝna yiɗi bǝ yim na, bakwɔ ǝn to nung a ɓko kwɔ mǝn ɓui ɓǝlǝu. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />Kwoi kwɔ ya Yahudawa la nungkwɔ, nungkwɔ ǝn lǝi baɓǝ ǝn tǝlǝ sua Gong Yigwoi, kwoi kwɔ ǝn yangǝu i nungkwɔ mǝn ɓuob nwa lo yayuum ɓǝlǝu. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />Nungkwɔ ǝn yam dǝm yiɗi bǝ ɓyǝa langkwoi ǝn gei ba i mǝ. Lǝ ba a langǝ i, I tthǝb bǝm i sarka manungkwɔ ni lǝba yuu kwɔ ya Israila dǝna dǝnyi tthǝɓǝ.&gt;&gt;<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />I geiu angǝ, &lt;&lt;Ɓi tǝi nungvullǝ a kun Yahudiya lǝu lǝ ba mǝ. Langkwoi yayuu ɓi akun yangǝu kwɔ ǝrr bǝilǝ wuolǝ nwa ba ko nung aɓau lǝ bamǝ. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />Kwoi dǝ ɓi yiɗi bǝlǝ a nwa mǝ, bakwɔ ɓi ibǝi ɓǝla ǝndǝi yayuu dǝna gei balo kǝm yayyu kwɔ mǝ dang ǝu ɓǝ.&gt;&gt;<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />Nungkwɔ i dǝ lona i Bulus lǝ, langkwoi i kpaatthǝ viilǝ i wuo bǝi kwɔ Bulus dǝna lotthǝ ɓǝ. Nungwoi lǝ har bǝi gub dǝu gei bagu tthǝ lǝ ba bǝ lo yigwoi Fuh, langkwoi u yiɗi bǝ mǝrrǝm lo nyiǝ i bǝ ɓǝr nung thanni dang nung zuu gi Musa langkwoi i nungvullǝ ya gei ba a tthasi. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />Yakun dang ǝi gwab bakwɔ u gei ɓǝng, kwoi yakun gwab lǝu.<verse eid="ACT 28:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 28:25" />Nungkwɔ i pa, dǝnni nyimtha nwa ɓuai, tthasua kwɔ Bulus gei nungkwɔ kun kwɔ: &lt;&lt;Ma nǝnǝ Ɓyang a Langǝ i gei ba a tthasi nwa Ishaya lǝya bǝba ɓǝ!<verse eid="ACT 28:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 28:26" />Bakwɔ u gei angǝ, &lt;Atǝ ta gei yayuu kwɔ mangǝ:</para>
  <para style="p" vid="ACT 28:26">&lt;&lt;Ɓa lǝnlǝ langkwoi ɓalǝ, kwoi ɓa ibǝiu;</para>
  <para style="q2" vid="ACT 28:26">Ɓa ɓyea langkwoi ɓa ɓyǝa, kwoi ɓa ɓyǝko.&gt;&gt;<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />Bakwɔ lonyi yayuu kwɔ lam ɗing,</para>
  <para style="q2" vid="ACT 28:27">langkwoi i lam ɓuasui</para>
  <para style="q2" vid="ACT 28:27">langkwoi i lam nungǝi.</para>
  <para style="q1" vid="ACT 28:27">Nǝ nilǝu, yang nungǝi a ɓyǝan ɓyǝa,</para>
  <para style="q2" vid="ACT 28:27">ɗogsui a lǝnlǝ,</para>
  <para style="q2" vid="ACT 28:27">lonyiǝ a ibǝi ǝn i,</para>
  <para style="q1" vid="ACT 28:27">langkwoi i mǝrǝm i wuo suam, Fuh gei,</para>
  <para style="q2" vid="ACT 28:27">langkwoi mǝn ji tthǝla.&gt;&gt;&gt;<verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />Langkwoi Bulus al lo angǝ: &lt;&lt;Ɓa ibǝi, yang, angǝ ba nwongǝi gi Fuh i dǝlǝ yakwɔ ǝn ya Yahudawa lǝu. I lǝnlǝ!&gt;&gt; <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />Kwɔ u gei ni yang ya Yahudawa dǝna kwatha.<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />Bulus ǝǝ gwoi kwɔ u lǝi lo nungkurɓǝ kwɔ har ttha rab, langkwoi bǝilǝ dǝu kǝb lo yakwɔ dǝna wɔ suo ɓǝ.<verse eid="ACT 28:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 28:31" />Dǝu gei ba bǝ lo yigwoi gi Fuh langkwoi dǝu nanatthǝnung lǝ ba Dangbang Yeso Kristi, dǝu gei ba i nyi nyimmi nung a kun yangǝu dǝi tou!<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>