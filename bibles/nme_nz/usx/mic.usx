<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Zeme(N) Bible Project</book>
  <para style="toc3">Mic.</para>
  <para style="toc2">Micah</para>
  <para style="toc1">Micah Laisiukwak</para>
  <para style="mt">Micah</para>
  <para style="mt">Micah Laisiukwak</para>
  <para style="is">Mraisam</para>
  <para style="ip">Laisiukwak aika Judah ga kelung caihakecibe Micah hegwangpeidung Jotham, Ahaz, Hezekiah penui tingdau raukegaidung la. Micah au Tinggwang tutiak hegwangram kena, Jerusalem nah Samaria namdidung de kemmau sam ranggai, kedanemene penui reu kedime, caihakecime nah cingkume maudung ziemne. Kegahmedung de teikeherei nah minadung au penui Tinggwang Kemcibe gu lie kecu liakegai teilung ga la tadi.</para>
  <para style="ip">Dede Micah au Zion teuncudaikelu nah Tinggwang de nlum kelame ziemne lungciep gwangram sampet beu. Pa hegwangram kelungta bammui kera ga teucu beu kera sampet kaibeu.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Samaria nah Jerusalem de kemmau (1:1-16)</para>
  <para style="io1">Mideteikeherei eh muiteume maukedi (2:1-3:12)</para>
  <para style="io1">Rabe ne teucudaikebeu (4:1-5:15)</para>
  <para style="io1">Tutiak nah ngaugia (6:1-7:20)</para>
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="s">Samaria penai Jerusalem de Kemmau</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />Aide Jotham, Ahaz, nah Hezekiah, Judah gwangpeidung tingdau, RAMPAUBE sam Morashtitme nam Micah da gwang, pa Samaria nah Jerusalem ziemne kengau de. <note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Jotham mmi 740-736 B.C., Ahaz mmi 734-716 B.C., nah Hezekiah mmi 716-687 B.C kenzwa ge hegwang tei gwang</char></note><verse eid="MIC 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 1:2" />Kingneilu, nnui heleuh pelane.</para>
  <para style="q" vid="MIC 1:2">Kingneilu, kideu, nah nda kebam leune.</para>
  <para style="q" vid="MIC 1:2">Peu RAMPAUBE Tinggwang de peu n zierang teilo,</para>
  <para style="q" vid="MIC 1:2">Rampaube pe kerecaki kemci gade.<verse eid="MIC 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 1:3" />Pielu, RAMPAUBE pebam gade gwang kela;</para>
  <para style="q" vid="MIC 1:3">pa nhung delwe tet gwang zie</para>
  <para style="q" vid="MIC 1:3">kideu tu kehudung ga.<verse eid="MIC 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 1:4" />Pe kang gade lamlwatudung sui dizie;</para>
  <para style="q" vid="MIC 1:4">langkam pang lamna dizie,</para>
  <para style="q" vid="MIC 1:4">maca mi dwa ga kebam nzwa,</para>
  <para style="q" vid="MIC 1:4">dui hangdeutudung gade lwamie kela nzwa hangdeulangkie ga lwa mie zie.<verse eid="MIC 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 1:5" />Aide pelane Jacob mau ziemne,</para>
  <para style="q" vid="MIC 1:5">nah Israel kilungme maudung ziemne.</para>
  <para style="q" vid="MIC 1:5">Jacob mau de dai no?</para>
  <para style="q" vid="MIC 1:5">Cide Samaria meni?</para>
  <para style="q" vid="MIC 1:5">Judah mamie kereca kehu bam dai no?</para>
  <para style="q" vid="MIC 1:5">Cide Jerusalem meni?<verse eid="MIC 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 1:6" />“Ih Samaria de luh ga ma heswa kelu ge tei ngkap dizie,</para>
  <para style="q" vid="MIC 1:6">kubebangdung ling kera heni ge,</para>
  <para style="q" vid="MIC 1:6">nah Ih pegu tangtsudung rui mie hangdeu langkam gage kai dizie</para>
  <para style="q" vid="MIC 1:6">nah Ih pe bangdwadung de keu gidi zie.<verse eid="MIC 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 1:7" />Pegu mamiedung pelane teipop kecai dizie,</para>
  <para style="q" vid="MIC 1:7">nah pa ngau kelu mapeudung pelane mi le ru dizie,</para>
  <para style="q" vid="MIC 1:7">nah Ih pegu mamiedung pelane tei msia dizie.</para>
  <para style="q" vid="MIC 1:7">Kedanemene pa helipuidung gu mahidung pwa hebau kelune,</para>
  <para style="q" vid="MIC 1:7">cidung de helipuidung gu mahi ge dai dizie”.<verse eid="MIC 1:7" /></para>
  <para style="s">Hei eh Kehap</para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 1:8" />Pecai Micah rangdi, aide ziemne Ih hap nah hei zie;</para>
  <para style="q" vid="MIC 1:8">Ih a picum pung mene nah paula eh tet zie;</para>
  <para style="q" vid="MIC 1:8">Ih maiserungdung nzwa mra zie</para>
  <para style="q" vid="MIC 1:8">nah biangkang ge nzwa hap zie.<verse eid="MIC 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 1:9" />Kedanemene Samaria zam lai gai lak di,</para>
  <para style="q" vid="MIC 1:9">Kedanemene aide Judah ga gwang cangdi.</para>
  <para style="q" vid="MIC 1:9">Cide a mina rieki ga gwang cang bam,</para>
  <para style="q" vid="MIC 1:9">Jerusalem kecang.<verse eid="MIC 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 1:10" />Gath namdi gade cipau ha de rang so,</para>
  <para style="q" vid="MIC 1:10">nnui kette hap so.</para>
  <para style="q" vid="MIC 1:10">Beth Leaphrah ga Ih akatei rebui ga mlak. <note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fq" closed="false">Ih akatei rebui ga mlak. </char><char style="ft" closed="false">nnui da makesia gwang kebam mede suisiet daikenzwa ge bam bi kecu keulia kerane</char></note><verse eid="MIC 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 1:11" />Tet kahdi, Shaphir ga kelunghmedung,</para>
  <para style="q" vid="MIC 1:11">paula nah ngngam eh.</para>
  <para style="q" vid="MIC 1:11">Zaanan nam ga kelunghme hegwale tet pet so.</para>
  <para style="q" vid="MIC 1:11">Beth Ezel nam hap,</para>
  <para style="q" vid="MIC 1:11">penuide kegumbe keuteu kedine.<verse eid="MIC 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 1:12" />Kedanemene Maroth ga kelunghmedung sam keyi de penui kwagai kelak tei bam dida,</para>
  <para style="q" vid="MIC 1:12">kedanemene kekap RAMPAUBE dade</para>
  <para style="q" vid="MIC 1:12">Jerusalem riekidung ga hung bam kedine.<verse eid="MIC 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 1:13" />Bagi de hekwendung maa gage kailu, Lachish ga kelunghmedung.</para>
  <para style="q" vid="MIC 1:13">Nnui, Lachish nam, Zion napui ziemne kemau pendeube,</para>
  <para style="q" vid="MIC 1:13">kedanemene Israel gikahkedi de nnui dade ngau kelune.<verse eid="MIC 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="MIC 1:14" />Cine nnui Moresheth Gath de kelamna mapeu peu zie;</para>
  <para style="q" vid="MIC 1:14">Akzib nam ne Israel gwangpeidung regui de tei nggah dizie.<verse eid="MIC 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MIC 1:15" />Ih nnuide ngkieng kelube ge teugwang dai beuzie,</para>
  <para style="q" vid="MIC 1:15">Mareshah nam ga kelunghmedung;</para>
  <para style="q" vid="MIC 1:15">Israel gu kebaa kedi de Adullam tsupop ga gwang di zie.<verse eid="MIC 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MIC 1:16" />Nnui peu tai di</para>
  <para style="q" vid="MIC 1:16">nah nnui tam biet di nnui hung kela namedung ziemne.</para>
  <para style="q" vid="MIC 1:16">Nnuikatei nnuide tei kwak pwa heliedung nzwa lu,</para>
  <para style="q" vid="MIC 1:16">kedanemene nnui namedung de nnui dade deudi kemdei gage langgai dizie delu.<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="s">Mina nah Tinggwang Ciemriem</para>
  <para style="q">
    <verse number="1" style="v" sid="MIC 2:1" />Kemau ciem rim kebam mede daikenzwa gede kengngi bam no,</para>
  <para style="q" vid="MIC 2:1">zeudung gade kemau tei kera rim kebam mede.</para>
  <para style="q" vid="MIC 2:1">Tingcang keba dau penui tei lu la</para>
  <para style="q" vid="MIC 2:1">kedanemene penui kengkieng kebamne.<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">Lei. 36:4 </char></note><verse eid="MIC 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 2:2" />Mina luhdung luu neu la nah swet lu la;</para>
  <para style="q" vid="MIC 2:2">penui kidung luu neu la nah keu teu dila.</para>
  <para style="q" vid="MIC 2:2">Penui mina de nah pe ki de teingkau,</para>
  <para style="q" vid="MIC 2:2">minabe nah pe mabam de.<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">Lev. 25:23-28; Pum. 27:1-11; 33:54, 36:1-12</char></note><verse eid="MIC 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 2:3" />Ciziemne RAMPAUBE aide rang,</para>
  <para style="q" vid="MIC 2:3">“Pielo, Ih kengkap aipau pautsa dage teu gwang gai kera riem bam dida,</para>
  <para style="q" vid="MIC 2:3">cika de nnui n ngwangdung cide mbai gailak.</para>
  <para style="q" vid="MIC 2:3">Nnui ngang eh tet lak ta,</para>
  <para style="q" vid="MIC 2:3">cidau kesia ting ge dizie kecune.<verse eid="MIC 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 2:4" />Cipau benai minadung nnui ziemne lei ge tei zie,</para>
  <para style="q" vid="MIC 2:4">hap nah sahbak eh kehap leidung tei zie. Penui lei tei eh, ‘Anui Israelme de ngkap dida;</para>
  <para style="q" vid="MIC 2:4">RAMPAUBE a mina deu keu kedet dida.</para>
  <para style="q" vid="MIC 2:4">Pa dainzwa a dade aide keu mpet zie no?</para>
  <para style="q" vid="MIC 2:4">Pa mide cwa kelamedung de anui luhdung mzi mpet beu dida!’”<verse eid="MIC 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 2:5" />Ciziemne, keheimedung nnui mabam mzi beu kera nnui leuhdung dacak tei kera gah dizie</para>
  <para style="q" vid="MIC 2:5">RAMPAUBE dwa gade.<verse eid="MIC 2:5" /></para>
  <para style="s">Kenret Caihakerangme</para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 2:6" />“Caihasam rang so,”</para>
  <para style="q" vid="MIC 2:6">de eh penui rang.</para>
  <para style="q" vid="MIC 2:6">“Penui aipau samdung de teu caihasam rang kerabe ma;</para>
  <para style="q" vid="MIC 2:6">hengam teu gwang kera be ma.”<verse eid="MIC 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 2:7" />Cide rang bi mai sia ni, Jacob leuhme,</para>
  <para style="q" vid="MIC 2:7">“RAMPAUBE rabe pe rata di deni?</para>
  <para style="q" vid="MIC 2:7">Aide RAMPAUBE tadung kesang ni?”</para>
  <para style="q" vid="MIC 2:7">Petaube ga tet kela keheibe dade a samdung yi la melui ni?<verse eid="MIC 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 2:8" />RAMPAUBE keligai, cudau a minadung ngauraume nzwa cuh dida.</para>
  <para style="q" vid="MIC 2:8">Nang mikangge magede mning msia mezing eh tetkah kelame dade pe pai, pe nia keuteudi,</para>
  <para style="q" vid="MIC 2:8">reugwamedung hereu gade cailigwang kilung ga kwak bam lu ra cet kela kenzwame dade.<verse eid="MIC 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 2:9" />Nnui a minadung mipuidung de penui ku kela penui kidung gade gwa mpetti;</para>
  <para style="q" vid="MIC 2:9">Nnui kelungta a samlam kebeu penui name dade keuteu dida.<verse eid="MIC 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 2:10" />Cuh lwe tet cu, aipau heni ga nnui bam kerabe ma,</para>
  <para style="q" vid="MIC 2:10">kedanemene cide mcikemakne;</para>
  <para style="q" vid="MIC 2:10">tei ngkap zing dida.<verse eid="MIC 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 2:11" />Magade mige kenret kela rabe nnui da gwang rang cai,</para>
  <para style="q" vid="MIC 2:11">“Kubetsi zau nah kengkieng zau ha Ih nnui da rang zie,”</para>
  <para style="q" vid="MIC 2:11">aipau me ziemne pecu le pwa caihakecime lie dizie.<verse eid="MIC 2:11" /></para>
  <para style="s">Lungkempet Sampet kebeu</para>
  <para style="p">
    <verse number="12" style="v" sid="MIC 2:12" />Ih nnui pelane de teu ncüt bi lu zie, Jacob leuhme.</para>
  <para style="q" vid="MIC 2:12">Ih bang kebam Israelme de teu hekwa bi luzie.</para>
  <para style="q" vid="MIC 2:12">Ih nnuide meurün penui maa ga gwang dai kelabe nzwa teugwang hekwa luzie,</para>
  <para style="q" vid="MIC 2:12">tseheideu ga meurün le pui kebam nzwa.</para>
  <para style="q" vid="MIC 2:12">Cika mina kiee kedine ma kwa cisüt kecu bam zie.<verse eid="MIC 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 2:13" />Mige penui lampui ngkei kebeube penui dwa tet gwang zie.</para>
  <para style="q" vid="MIC 2:13">Penui herieki tei pangpop lwe tet mpet zie;</para>
  <para style="q" vid="MIC 2:13">penui gwangpei RAMPAUBE penui dwa rai zie.</para>
  <para style="q" vid="MIC 2:13">RAMPAUBE ne penui peu ga bam zie.<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="s">Muiteume nah Caihakecime de Kehesiu</para>
  <para style="q">
    <verse number="1" style="v" sid="MIC 3:1" />Ih ranggai, “Cu kingneilu,</para>
  <para style="q" vid="MIC 3:1">nnui Jacob muiteumedung</para>
  <para style="q" vid="MIC 3:1">nah Israelme gwangdung:</para>
  <para style="q" vid="MIC 3:1">Nnui kemzuibe ci kera petau meni?<verse eid="MIC 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 3:2" />Nnui keyibe kengkaume</para>
  <para style="q" vid="MIC 3:2">nah kesiabe nnui sui la,</para>
  <para style="q" vid="MIC 3:2">nnui a mina de mring penui geu gau,</para>
  <para style="q" vid="MIC 3:2">penui radung gade penui teih gau,<verse eid="MIC 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 3:3" />nnui a mina teih de tyei kelame,</para>
  <para style="q" vid="MIC 3:3">nah penui geu gau mpetdi,</para>
  <para style="q" vid="MIC 3:3">penui radung tei cum</para>
  <para style="q" vid="MIC 3:3">nah dang kecaidi,</para>
  <para style="q" vid="MIC 3:3">li gage heteih kai kera ge nzwa,</para>
  <para style="q" vid="MIC 3:3">li kenggwa ge ga heteih lang kera ge nzwa,<verse eid="MIC 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 3:4" />Pecai nnui hegwangmedung hap eh RAMPAUBE dage kengha kie gai zie,</para>
  <para style="q" vid="MIC 3:4">dede pa nnui sam kelibeu lak.</para>
  <para style="q" vid="MIC 3:4">Pa cipau tingdau nnuide pie de lak,</para>
  <para style="q" vid="MIC 3:4">kedanemene nnui kemau tadung tei kedine.”<verse eid="MIC 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 3:5" />RAMPAUBE aide rang,</para>
  <para style="q" vid="MIC 3:5">“A mina lampui sau maukedi caihakecimedung ziemne,</para>
  <para style="q" vid="MIC 3:5">mige penuide matyei kera pwapeu liecai,</para>
  <para style="q" vid="MIC 3:5">penui ranggai la, ‘Kezuyi.’</para>
  <para style="q" vid="MIC 3:5">Dede magade pa penui muidung gage made kaibeu tadi cai,</para>
  <para style="q" vid="MIC 3:5">penui penuikatei penuide pecu renia kera mtei lula.<verse eid="MIC 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 3:6" />Ciziemne, nnui ziemne mui dizie nah ma ngau tadi zie;</para>
  <para style="q" vid="MIC 3:6">nnui ziemne mui dizie iciu eh peu ncu reka ta tei tadi zie.</para>
  <para style="q" vid="MIC 3:6">Caihakecimedung da tingnaimiak nghung dizie,</para>
  <para style="q" vid="MIC 3:6">nah penui tingba penui da mui dizie.<verse eid="MIC 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 3:7" />Ma ngau kelamedung de hengam tei dizie,</para>
  <para style="q" vid="MIC 3:7">nah rekame ma cetci tadi zie.</para>
  <para style="q" vid="MIC 3:7">Penui pelane penui muileudung gum dizie,</para>
  <para style="q" vid="MIC 3:7">a dade samli gede ngaulu kemakne.”<verse eid="MIC 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 3:8" />Dede a ziemne au, RAMPAUBE rabe kengkieng le acu pui,</para>
  <para style="q" vid="MIC 3:8">nah ada kemzui nah kengkieng le pui,</para>
  <para style="q" vid="MIC 3:8">Jacob leuhme dage pe mau ndugai beu kera,</para>
  <para style="q" vid="MIC 3:8">nah pe mau Israelme dage.<verse eid="MIC 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 3:9" />Cu aide kingneilu,</para>
  <para style="q" vid="MIC 3:9">nnui Jacob leuhme muiteumedung,</para>
  <para style="q" vid="MIC 3:9">nah Israel leuhme hegwangmedung,</para>
  <para style="q" vid="MIC 3:9">nnui kemzuibe ngkau kelabe,</para>
  <para style="q" vid="MIC 3:9">nah maleune petau kemak be petau lie kelame.<verse eid="MIC 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 3:10" />Nnui Zion hejai le</para>
  <para style="q" vid="MIC 3:10">nah Jerusalem petau kemak le teilu.<verse eid="MIC 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 3:11" />Cipau namdi muiteumedung tutiak hetau henim ziemne,</para>
  <para style="q" vid="MIC 3:11">n cingkumedung penui kangzi ziemne ledeu bamla,</para>
  <para style="q" vid="MIC 3:11">nah nnui caihakecimedung rangkang ziemne keulia kegaidung tei bamla.</para>
  <para style="q" vid="MIC 3:11">Ciude nnui RAMPAUBE da ngngei nah rang,</para>
  <para style="q" vid="MIC 3:11">“Rampaube anui de ngngwa la meni?</para>
  <para style="q" vid="MIC 3:11">Makesia gede anui da gwang lak.”<verse eid="MIC 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 3:12" />Ciziemne, nnui ziemne,</para>
  <para style="q" vid="MIC 3:12">Zion luh puu kedi ge dizie,</para>
  <para style="q" vid="MIC 3:12">Jerusalem tsura pangpop kedi tum ge nzwa dizie,</para>
  <para style="q" vid="MIC 3:12">nah hangdeutu kerecaki de hegung ge dizie.<verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="s">Rampaube Lamlwatu</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1" />Dede tingba kamtu benai</para>
  <para style="q" vid="MIC 4:1">RAMPAUBE ki gu lamlwatu</para>
  <para style="q" vid="MIC 4:1">keda lamlwatudung kakde hutube dizie.</para>
  <para style="q" vid="MIC 4:1">Hangdeutudung reu cide de teucehu dizie,</para>
  <para style="q" vid="MIC 4:1">nah minadung pelane cika ge tet gai zie.<verse eid="MIC 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 4:2" />Heleuhdung kekiee ge mie nah rang zie,</para>
  <para style="q" vid="MIC 4:2">“Gwang lu, anui RAMPAUBE lamlwatu ga hang go,</para>
  <para style="q" vid="MIC 4:2">Jacob Tinggwang ki ga.</para>
  <para style="q" vid="MIC 4:2">Pa anuide peu tei neu kelabe ledeu beuzie,</para>
  <para style="q" vid="MIC 4:2">nah anui pe lampuidung ga tet zie.”</para>
  <para style="q" vid="MIC 4:2">Zion gade hezai mpet zie,</para>
  <para style="q" vid="MIC 4:2">nah RAMPAUBE sam Jerusalem gade.<verse eid="MIC 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 4:3" />Minadung kekieege kakga pane hetutiak zie</para>
  <para style="q" vid="MIC 4:3">nah heleuhdung kekiee kemdei ga la kela leune de tiak zie.</para>
  <para style="q" vid="MIC 4:3">Penui penui kingtiedung pwa hepei rekilu zie</para>
  <para style="q" vid="MIC 4:3">nah penui ngeidung pwa hekiedung tei luzie.</para>
  <para style="q" vid="MIC 4:3">Heleuh ge heleuh keda gede ngaurau eh kiengtie pwa cu lak,</para>
  <para style="q" vid="MIC 4:3">Penui hereu tei kera cim de heteu dai lak ta.<verse eid="MIC 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 4:4" />Meliene, mina leune pegu kubebang kangga</para>
  <para style="q" vid="MIC 4:4">nah pegu nzütbang kangga bam zie.</para>
  <para style="q" vid="MIC 4:4">Migede penuide keheu lak,</para>
  <para style="q" vid="MIC 4:4">kedanemene reugwame reu RAMPAUBE mui gade rangdi delu.<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">1 Heg. 4:25, Zec. 3:10</char></note><verse eid="MIC 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 4:5" />Kedanemene mina leune,</para>
  <para style="q" vid="MIC 4:5">hangge ge kecu, penui rabe zi gade tet la.</para>
  <para style="q" vid="MIC 4:5">Dede anui au RAMPAUBE anui Tinggwang zi gade</para>
  <para style="q" vid="MIC 4:5">kelungta nah kelungta tet la zie.<verse eid="MIC 4:5" /></para>
  <para style="s">Rampaube Mariem</para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 4:6" />“Cipau benai”, aide RAMPAUBE ne ndugai,</para>
  <para style="q" vid="MIC 4:6">Ih swa kelame</para>
  <para style="q" vid="MIC 4:6">nah gi kedime de hekwa luzie,</para>
  <para style="q" vid="MIC 4:6">Ih ne tei keherei kedime de.<verse eid="MIC 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 4:7" />Ih swa kelame de bangpwa kebamme tei luzie,</para>
  <para style="q" vid="MIC 4:7">nah gwagi kedimedung de heleuh kengkieng ge tei luzie,</para>
  <para style="q" vid="MIC 4:7">nah Ih, RAMPAUBE, Zion Deutu gade penui reu ga hegwang tei zie,</para>
  <para style="q" vid="MIC 4:7">cu nah kelungta.<verse eid="MIC 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 4:8" />Nnui au, meurün nadung reketbam,</para>
  <para style="q" vid="MIC 4:8">Zion napui gu hangdeutu,</para>
  <para style="q" vid="MIC 4:8">Nnui da cide gwang zie, ndaa nnui gu hegwangram de tei dai luzie,</para>
  <para style="q" vid="MIC 4:8">Jerusalem napui gu hegwangram de.<verse eid="MIC 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 4:9" />Cu, nnui daitei mrung la no?</para>
  <para style="q" vid="MIC 4:9">Nnui kakga hegwangpei gede gah ni?<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">Jer. 8:19, Isa. 13:8</char></note></para>
  <para style="q" vid="MIC 4:9">Nnuide ledeu kebeu be tsaidi ni?</para>
  <para style="q" vid="MIC 4:9">Aide ziemne mipui henatet keteei de nzwa nang teei lani?<verse eid="MIC 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 4:10" />Teei eh bam di</para>
  <para style="q" vid="MIC 4:10">nah henatet teei lalu,</para>
  <para style="q" vid="MIC 4:10">Zion napui,</para>
  <para style="q" vid="MIC 4:10">mipui henatet keteei de nzwa.</para>
  <para style="q" vid="MIC 4:10">Cu au nnui namdi gade tet mpet dizie,</para>
  <para style="q" vid="MIC 4:10">luh ga lunghlu,</para>
  <para style="q" vid="MIC 4:10">nah Babylon deudi ga mielu.</para>
  <para style="q" vid="MIC 4:10">Cikade nnuide kelilu zie.</para>
  <para style="q" vid="MIC 4:10">Cika de RAMPAUBE nnuide</para>
  <para style="q" vid="MIC 4:10">nnui ngauraume dade keli beuzie.<verse eid="MIC 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 4:11" />Cu heleuhdung kekieege nnuide renia kera ngkwalu da;</para>
  <para style="q" vid="MIC 4:11">penui rang, ‘Pecu peu heradi;</para>
  <para style="q" vid="MIC 4:11">peu Zion kau kedi ngau luzie.’<verse eid="MIC 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 4:12" />Penui RAMPAUBE lungningdung cima,</para>
  <para style="q" vid="MIC 4:12">penui pe mariemdung de ci cang ma,</para>
  <para style="q" vid="MIC 4:12">pa penuide hecaipung neu kera meibangdung mtei kelu nzwa hekwa lu.<verse eid="MIC 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 4:13" />Cuhlu nah teicu, Zion napui,</para>
  <para style="q" vid="MIC 4:13">Ih n kii tei pwa hegeu kii tei beuzie,</para>
  <para style="q" vid="MIC 4:13">nah Ih n nginglwak hetageu ge teibeu zie.</para>
  <para style="q" vid="MIC 4:13">Nnui minadung kekiee de teipop dizie nah nnui penui mahei mci kemak de pwa RAMPAUBE de peuzie,</para>
  <para style="q" vid="MIC 4:13">penui mahei kideu pelane reu Rampaube de.”<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="s">Bethlehem gade Kegwang Sampetkebeu Gwangpei</para>
  <para style="q">
    <verse number="1" style="v" sid="MIC 5:1" />Hereu ga keceu gade kedi kecang rehi gade gwang ngkwalu,</para>
  <para style="q" vid="MIC 5:1">namdibe reugwamedung!<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="fq" closed="false">namdibe reugwamedung: </char><char style="ft" closed="false">Jerusalem namdi gu.</char></note></para>
  <para style="q" vid="MIC 5:1">Anuide gwa lüt kera mtei pwa bam dida!</para>
  <para style="q" vid="MIC 5:1">Ma tie ge le Israel gwangpei de</para>
  <para style="q" vid="MIC 5:1">pe bia gage dap.<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">Jhn. 18:22, Keh: 3:30</char></note><verse eid="MIC 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 5:2" />Dede nang, Bethlehem Ephrathah,</para>
  <para style="q" vid="MIC 5:2">nnui Judah leuhme kakgade ceutu lie de,</para>
  <para style="q" vid="MIC 5:2">nnui dade mige a da gwang zie</para>
  <para style="q" vid="MIC 5:2">Israel de teu kera,</para>
  <para style="q" vid="MIC 5:2">pe ndeube ndaa gade la dida,</para>
  <para style="q" vid="MIC 5:2">kelungta gade.<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">Mat. 2:6, Joh. 7:42</char></note><verse eid="MIC 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 5:3" />Ciziemne RAMPAUBE penui de püt dizie,</para>
  <para style="q" vid="MIC 5:3">henatet teei kela pui de henana ge de mna kemaktane,</para>
  <para style="q" vid="MIC 5:3">nah Israelmena langgi kedimedung cailigwang dai luzie.<verse eid="MIC 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 5:4" />Pa sap delwe</para>
  <para style="q" vid="MIC 5:4">RAMPAUBE kengkieng teu eh, pe meurün maa pie luzie,</para>
  <para style="q" vid="MIC 5:4">RAMPAUBE pe Tinggwang kengkieng zi gade.</para>
  <para style="q" vid="MIC 5:4">Penui lungh bam zie,</para>
  <para style="q" vid="MIC 5:4">Cika de pane di zie kideu penli kecang.<verse eid="MIC 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 5:5" />Cine aide le kezuyi dizie,</para>
  <para style="q" vid="MIC 5:5">Assyria reugwamaa anui deu ga kegwang dau,</para>
  <para style="q" vid="MIC 5:5">nah anui namdung gwa kelüt dau,</para>
  <para style="q" vid="MIC 5:5">cidau anui penuide kekwame hang hena</para>
  <para style="q" vid="MIC 5:5">nah mina muiteume hang heset de ngngwa eh penuide renia cuh zie.<verse eid="MIC 5:5" /></para>
  <para style="s">Lungkempet nah Kengkap</para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 5:6" />Kiengtie le penui Assyria deu gwa luzie,</para>
  <para style="q" vid="MIC 5:6">nah Nimrodme deu<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="fq" closed="false">Nimrodme deu: </char><char style="ft" closed="false">aipau deu de Assyria da, kedanemene, Ken. 10:8-12 rehi gade cai, namdi sumbe, Nineveh ndeu kegaibe da Nimrod.</char></note> penui rieki gade.</para>
  <para style="q" vid="MIC 5:6">Pa anuide Assyriamedung dade kelilu zie,</para>
  <para style="q" vid="MIC 5:6">penui anui deu ga kelüt dau</para>
  <para style="q" vid="MIC 5:6">anui raidung ga penui tet kelüt dau.<verse eid="MIC 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 5:7" />Jacob leuh bang kenzeu de minadung kekiee ge kakga bam zie,</para>
  <para style="q" vid="MIC 5:7">RAMPAUBE dade hezim nzwa,</para>
  <para style="q" vid="MIC 5:7">cehei reu ga tingruidung nzwa,</para>
  <para style="q" vid="MIC 5:7">cide mina de kwa la ma,</para>
  <para style="q" vid="MIC 5:7">nah penui mina nadung de kwa lama.<verse eid="MIC 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 5:8" />Jacob leuhme bang kenzeu heleuhdung kakga la zie</para>
  <para style="q" vid="MIC 5:8">minadung kekiee ge kakga,</para>
  <para style="q" vid="MIC 5:8">hingho ge hegung ga makaunedung kakga kebam nzwa,</para>
  <para style="q" vid="MIC 5:8">hingho ge meurün hau kakga kebam nzwa</para>
  <para style="q" vid="MIC 5:8">pa penui da kahgwang kecu dau,</para>
  <para style="q" vid="MIC 5:8">pa penui reu ga tet nah penuide teurak takcai di;</para>
  <para style="q" vid="MIC 5:8">nah cika migede penuide keli beu kera gah dizie.<verse eid="MIC 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 5:9" />Nnui ngauraumedung de renia eh nnui ba hwa cuh gai zie,</para>
  <para style="q" vid="MIC 5:9">nah cide ne penuide ngkap dizie.<verse eid="MIC 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 5:10" />“Cipau benai cide tei dizie”, aide RAMPAUBE ne ndugai,</para>
  <para style="q" vid="MIC 5:10">“Ih nnui kakgade nnui hekwendung ngkap dizie</para>
  <para style="q" vid="MIC 5:10">nah nnui hekwen bagidung tei msia dizie.<verse eid="MIC 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 5:11" />Ih nnui deu ga kebam namdidung de ngkap dizie</para>
  <para style="q" vid="MIC 5:11">nah nnui riekelu namdi pelane teingkau dizie.<verse eid="MIC 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 5:12" />Ih nnui ba kebam rekatadung de ngkap dizie,</para>
  <para style="q" vid="MIC 5:12">nah nnui rekamedung ge de bam si lak ta.<verse eid="MIC 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 5:13" />Ih nnui mamiedung ngkap dizie</para>
  <para style="q" vid="MIC 5:13">nah nnui kakgade nnui tsusumdung ngkap dizie.</para>
  <para style="q" vid="MIC 5:13">Nnui ba le tei kelu mamiedung de reca si lak ta.<verse eid="MIC 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="MIC 5:14" />Ih Asherah rabepui miedung de nnui kakgade pai mpet dizie,</para>
  <para style="q" vid="MIC 5:14">nah Ih nnui namdidung ngkap dizie.<verse eid="MIC 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MIC 5:15" />Rata nah lunghop de le Ih a sam kingnei kemak</para>
  <para style="q" vid="MIC 5:15">leuhdung da hekum peei zie.”<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="s">Rampaube Israel de Kemmau</para>
  <para style="q">
    <verse number="1" style="v" sid="MIC 6:1" />Cu kingnei lu RAMPAUBE kerang de,</para>
  <para style="q" vid="MIC 6:1">“Cuhlu delwe nnui sam kie de lamlwatudung dwa gade rang gailo;</para>
  <para style="q" vid="MIC 6:1">Peu hangdeutudung de n kwa siulu.<verse eid="MIC 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 6:2" />RAMPAUBE zaidung de kingneilu, nnui lamlwatudung</para>
  <para style="q" vid="MIC 6:2">nah nnui kideu lungbammui keladung.</para>
  <para style="q" vid="MIC 6:2">RAMPAUBE pe mina da hezai tei pwa kebamne,</para>
  <para style="q" vid="MIC 6:2">nah pa Israel de mmau eh tutiak bam gade regi zie.”<verse eid="MIC 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 6:3" />“A mina, Ih nnui da daitei di dino?</para>
  <para style="q" vid="MIC 6:3">Dainzwa Ih nnuide tei leu di no?</para>
  <para style="q" vid="MIC 6:3">A zierang teilo!<verse eid="MIC 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 6:4" />Ih nnuide Egyptme deu gade ngngwa mpetlu</para>
  <para style="q" vid="MIC 6:4">nah nnuide mibaang ketei ki gade kelilu.</para>
  <para style="q" vid="MIC 6:4">Ih Moses, Aaron nah Miriam de nnui puisau tei kera langgai.<verse eid="MIC 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 6:5" />A mina, Moab gwangpei Balak daipai riem gaibi kecu nsunglu,</para>
  <para style="q" vid="MIC 6:5">nah dainzwa Beor napei Balaam pe sam keligai bi kecu</para>
  <para style="q" vid="MIC 6:5">nnui Shittim gade tet eh Gilgal ga kegwang nzwa,</para>
  <para style="q" vid="MIC 6:5">ciu de nnui RAMPAUBE masang eh tei kegaidung de cilu zie.”<note caller="+" style="f"><char style="fr" closed="false">6:5 </char><char style="ft" closed="false">Pum. 22-24</char></note><verse eid="MIC 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 6:6" />Ih daipai RAMPAUBE de teugwang beu lai,</para>
  <para style="q" vid="MIC 6:6">Ih kengkieng Tinggwang da keumie kecu dau?</para>
  <para style="q" vid="MIC 6:6">Ih peda keru ratakdung teu gwang zie mi,</para>
  <para style="q" vid="MIC 6:6">hetumna mmi ge nage lai?<verse eid="MIC 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 6:7" />RAMPAUBE meurünseu pecang ge le,</para>
  <para style="q" vid="MIC 6:7">mede olive ca reukidung cang kerei le pesuilu zie ni?</para>
  <para style="q" vid="MIC 6:7">Ih a mau ziemne a neraibe de,</para>
  <para style="q" vid="MIC 6:7">a mau ziemne a pum gade petsi de peu zie ni?<verse eid="MIC 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 6:8" />Minadung, pa daipai be yibi</para>
  <para style="q" vid="MIC 6:8">nnuide rang lia da,</para>
  <para style="q" vid="MIC 6:8">nah RAMPAUBE nnui dade luu neu kela de au:</para>
  <para style="q" vid="MIC 6:8">Kemzeube tei kera,</para>
  <para style="q" vid="MIC 6:8">keku masang kecu,</para>
  <para style="q" vid="MIC 6:8">nah hena eh nnui Tinggwang de ngngwa tetlu.<verse eid="MIC 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 6:9" />RAMPAUBE Jerusalem namdi de ranglia bam,</para>
  <para style="q" vid="MIC 6:9">cu de maci n zi de herüt peu bam,</para>
  <para style="q" vid="MIC 6:9">“saulia tui de siulu,</para>
  <para style="q" vid="MIC 6:9">nah pebam gage kai kebeube de de.<verse eid="MIC 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 6:10" />Mina kesiame cide masang kemakme kidung ga mahei bam,</para>
  <para style="q" vid="MIC 6:10">Nah petau kemak kemdetdung cide au kemneudung.<verse eid="MIC 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 6:11" />Mige pa kecwa kemdet teu la liecai pecu petaulie lubui ni, kecwa kemdetkangdung dum le puipung?<verse eid="MIC 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 6:12" />Keheimedung au mide teikeherei kela le pui,</para>
  <para style="q" vid="MIC 6:12">cika kebammedung au kenretdung rang la,</para>
  <para style="q" vid="MIC 6:12">nah penui mleu penui mui ga kebam de au mide cwa la.<verse eid="MIC 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 6:13" />Ciziemne Ih nnuide sia süt kecu cui ge le tei nggah dizie,</para>
  <para style="q" vid="MIC 6:13">nah nnui maudung ziemne Ih nnuide tei ngkap dizie.<verse eid="MIC 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="MIC 6:14" />Nnui matyei zie dede nggei gailak;</para>
  <para style="q" vid="MIC 6:14">nnui mlung cang mene bam dizie.</para>
  <para style="q" vid="MIC 6:14">Nnui mania kainzeu zie dede kai nzeu gailak,</para>
  <para style="q" vid="MIC 6:14">nah nnui keli kelube Ih kiengtie de peu dizie.<verse eid="MIC 6:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MIC 6:15" />Nnui ling zie dede rum lak;</para>
  <para style="q" vid="MIC 6:15">nnui olivedung tui zie dede maca le</para>
  <para style="q" vid="MIC 6:15">nnuikatei nnuide keniak gailak;</para>
  <para style="q" vid="MIC 6:15">nnui kubetsidung tui zie dede aipau zau de sak lak.<note caller="+" style="f"><char style="fr" closed="false">6:15 </char><char style="ft" closed="false">Jhn. 4:37, Amo. 5:11, Hez. 28:38-40</char></note><verse eid="MIC 6:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MIC 6:16" />Hegwangpei Omri ne hezai tei keludung de kai nzeu,</para>
  <para style="q" vid="MIC 6:16">nah Hegwangpei Ahab leuhme tadung pelane.</para>
  <para style="q" vid="MIC 6:16">Nnui penui rang kegai ga tet.</para>
  <para style="q" vid="MIC 6:16">Cine Ih nnui, namdi, de tei msia kedi ge dizie,</para>
  <para style="q" vid="MIC 6:16">nah nnui cika lungh kebamme mina ngkau tei zie,</para>
  <para style="q" vid="MIC 6:16">nah nnui a minadung nnuide rang kemsia de lia zie.”<verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="s">Israel Lungrei</para>
  <para style="q">
    <verse number="1" style="v" sid="MIC 7:1" />Keherei ada gwang lada!</para>
  <para style="q" vid="MIC 7:1">Ih au hekwa kela hepwak tsidung nzwa dida,</para>
  <para style="q" vid="MIC 7:1">nah kubetsidung kehwa kelu cai bang kedibe nzwa;</para>
  <para style="q" vid="MIC 7:1">cika kubetsi tyei kera ge de gada,</para>
  <para style="q" vid="MIC 7:1">Ih tyei mnunglu kera nzüttsi meu kecube gede gah da.<verse eid="MIC 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 7:2" />Makesangme deudi gade gah dida;</para>
  <para style="q" vid="MIC 7:2">mina leuh pelane gade ma petau tei kelame gah da.</para>
  <para style="q" vid="MIC 7:2">Hejai teu lwa kera penui pelane zeu lwe kwa bam;</para>
  <para style="q" vid="MIC 7:2">hangge ge kecu pekatei pe sinabe de tei ngkap bam.<verse eid="MIC 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 7:3" />Penui badung au mide tei msia kecu yi süt:</para>
  <para style="q" vid="MIC 7:3">mina reu kedime rangkang kie la,</para>
  <para style="q" vid="MIC 7:3">tutiakme hetauhenim lu kera mtei pwa bamla,</para>
  <para style="q" vid="MIC 7:3">nah mina kengkiengme kedame da ge pa daipai ngau lu neu la bi rang la.</para>
  <para style="q" vid="MIC 7:3">Ciciu eh penui hecim rim ncüt la.<verse eid="MIC 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 7:4" />Penui yitume au hetubangdung nzwa,</para>
  <para style="q" vid="MIC 7:4">masangtume de hetubang pui swa de sia ki.</para>
  <para style="q" vid="MIC 7:4">Cide ngu kekwame mrai rang kebeu tingba de delie,</para>
  <para style="q" vid="MIC 7:4">Tinggwang nnuide saja peu kera ting gwang zeuda.</para>
  <para style="q" vid="MIC 7:4">Cu au penui ma cetci ta kera ting da.<verse eid="MIC 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 7:5" />N kida keheibe de nlum so;</para>
  <para style="q" vid="MIC 7:5">n zangme keheibe dage de n kenlum kai so.</para>
  <para style="q" vid="MIC 7:5">Nang daipai rang bi</para>
  <para style="q" vid="MIC 7:5">n nau n taiga kezeube pui dade de mriaklu.<verse eid="MIC 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 7:6" />Pe napei pe pei de hengam tei,</para>
  <para style="q" vid="MIC 7:6">pe napui pe pui de renia cuh,</para>
  <para style="q" vid="MIC 7:6">nah pe napei nau pe nahpei pui de renia.</para>
  <para style="q" vid="MIC 7:6">Mipei ge ngauraumedung au pekatei pe kilungme.<note caller="+" style="f"><char style="fr" closed="false">7:6 </char><char style="ft" closed="false">Mat. 10:21-35, Mrk. 13:12, Luk. 12:53</char></note><verse eid="MIC 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 7:7" />Dede a ziemne au, Ih RAMPAUBE de pie zie.</para>
  <para style="q" vid="MIC 7:7">Ih acu kelikelube Tinggwang de kwa bam zie;</para>
  <para style="q" vid="MIC 7:7">a Tinggwang a kekie kingneilu zie.<verse eid="MIC 7:7" /></para>
  <para style="s">Israel Cuhlu zie</para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 7:8" />A ngauraume, Nnui sui yi so,</para>
  <para style="q" vid="MIC 7:8">Ih kau kedi cai,</para>
  <para style="q" vid="MIC 7:8">Ih cuh dai zie.</para>
  <para style="q" vid="MIC 7:8">Ih kemui ga kebam dau,</para>
  <para style="q" vid="MIC 7:8">RAMPAUBE a ziemne kebaa ge zie.<verse eid="MIC 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 7:9" />Kedanemene Ih RAMPAUBE dage kemau tei gai kedine,</para>
  <para style="q" vid="MIC 7:9">Ih pe rata de lia zie</para>
  <para style="q" vid="MIC 7:9">a ziemne pe nggia kie gai kemaktane,</para>
  <para style="q" vid="MIC 7:9">nah a tutiak beu kemaktane.</para>
  <para style="q" vid="MIC 7:9">Pa acu kebaa ga ngngwa gwang beu zie,</para>
  <para style="q" vid="MIC 7:9">nah pa pe kemzui teu acu keli kebeu Ih ngau zie.<verse eid="MIC 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 7:10" />Ciude a ngauraume aide ngau zie,</para>
  <para style="q" vid="MIC 7:10">nah hengam le acu,</para>
  <para style="q" vid="MIC 7:10">“Dai ga RAMPAUBE n Tinggwang bam no?” de kerangme de gum dizie,</para>
  <para style="q" vid="MIC 7:10">A miak pecu pie zie;</para>
  <para style="q" vid="MIC 7:10">pa puidi kidung ga tangdei daucim kedibe nzwa dizie.<verse eid="MIC 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 7:11" />N riekidung tei dai kera ting gwang zie;</para>
  <para style="q" vid="MIC 7:11">cipau benai heraidung kemdei gega tei mdi dizie.<verse eid="MIC 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 7:12" />Cipau benai n mina n da gwang zie,</para>
  <para style="q" vid="MIC 7:12">Assyria gade nah Egypt namdidung gade,</para>
  <para style="q" vid="MIC 7:12">Egypt gade Euphrate reuki cuikui ga kecang,</para>
  <para style="q" vid="MIC 7:12">dui kedi gade dui kedi ga kecang,</para>
  <para style="q" vid="MIC 7:12">nah lamlwatu gade lamlwatu ga.<verse eid="MIC 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 7:13" />Dede kideube au hetaideu ge dizie</para>
  <para style="q" vid="MIC 7:13">kedanemene cika lungh kebam mina ziemne,</para>
  <para style="q" vid="MIC 7:13">kedanemene penui ta tei kegai ziemne.<verse eid="MIC 7:13" /></para>
  <para style="s">Kekie nah Ketwa</para>
  <para style="q">
    <verse number="14" style="v" sid="MIC 7:14" />N tui le n mina de kwalu,</para>
  <para style="q" vid="MIC 7:14">n mapwamedung de.</para>
  <para style="q" vid="MIC 7:14">Penui renaamkang ga pekatei lungh ladi,</para>
  <para style="q" vid="MIC 7:14">cehei kendiak deudung kakga.</para>
  <para style="q" vid="MIC 7:14">Penuide peu Bashan nah Gilead ga tsehei tyei lo</para>
  <para style="q" vid="MIC 7:14">ndaa tingdau nzwa.<verse eid="MIC 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MIC 7:15" />Nda nang Egyptme deu gade kempet dau nzwa,</para>
  <para style="q" vid="MIC 7:15">Ih penuide mimakecang batadung keulia zie.<verse eid="MIC 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MIC 7:16" />Heleuhdung penui kengkiengdung de ngau</para>
  <para style="q" vid="MIC 7:16">nah nggam dizie.</para>
  <para style="q" vid="MIC 7:16">Penui swagah le penui mui ngkui dizie;</para>
  <para style="q" vid="MIC 7:16">nah penui kwendung heba dizie.<verse eid="MIC 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="MIC 7:17" />Penui henei nzwa rebui nniak zie,</para>
  <para style="q" vid="MIC 7:17">kideu ga bwa kela leune nzwa.</para>
  <para style="q" vid="MIC 7:17">Penui penui mbaikidung gade ngngi eh mpet zie;</para>
  <para style="q" vid="MIC 7:17">penui nda ngngi eh gwang zie, RAMPAUBE anui Tinggwang da,</para>
  <para style="q" vid="MIC 7:17">nah penui n ziemne ngngi dizie.<verse eid="MIC 7:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="MIC 7:18" />Nang kenzwa cau Tinggwang bam no,</para>
  <para style="q" vid="MIC 7:18">kemau keugi beu kela</para>
  <para style="q" vid="MIC 7:18">bang kebam n mapwame hezai gikah kedime mau gibeu kela?</para>
  <para style="q" vid="MIC 7:18">Pa pe rata kelungta kainzeu la ma,</para>
  <para style="q" vid="MIC 7:18">kedanemene pa pe samkakkelu kesamsang pesui la.<verse eid="MIC 7:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="MIC 7:19" />Nang anuide ngau nggia dai beu zie;</para>
  <para style="q" vid="MIC 7:19">anui kesia tadung de nang n pi kang gage caicim dizie.</para>
  <para style="q" vid="MIC 7:19">Nang anui maudung kelien pwa jaaidi kecok gage kai dizie.<verse eid="MIC 7:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="MIC 7:20" />Nang kesangbe Jacob de peu zie</para>
  <para style="q" vid="MIC 7:20">nah samkakkelu kesamsang Abraham de,</para>
  <para style="q" vid="MIC 7:20">nang ndaa anui paume dage sampet kebeu nzwa.<note caller="+" style="f"><char style="fr" closed="false">7:20 </char><char style="ft" closed="false">Luk. 1:54-55, Rom. 15:8-9</char></note><verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>