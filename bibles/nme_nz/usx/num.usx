<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NUM" style="id">- Zeme(N) Bible Project</book>
  <para style="ide">UTF-8</para>
  <para style="h">Pumpei</para>
  <para style="toc1">Pumpei Laisiukwak</para>
  <para style="toc2">Pumpei</para>
  <para style="toc3">Pum.</para>
  <para style="mt">Numbers</para>
  <para style="mt">Pumpei Laisiukwak</para>
  <para style="is">Mraisam</para>
  <para style="ip">Pumpei aide pesam 1 nah 26 ga Israel pumpei kecu ha gade pezi ngaulu. Moses ne laisiukwak de raugai nah Israelme muiteube tei.</para>
  <para style="ip">Laisiukwak kerai lambie Israelme Sinai Deutu pi ga ramzeuki tei kelu dau ha. Laisiukwak pesam kena lambie Israelme Sinai Detu gade Ketsai Jaaidi kepetle mbeuh gwang kelu ha ranggai. Laisiukwak pe kecum sam ga Canaan ga lüt nah gwa kera ketelei ha raugai.</para>
  <para style="ip">Hetaideu ga huikela mmi camrei-heset tingdau Israelme mage ci mcigi lu, Tinggwang penui mapie lamui kecu. Pa miswakegah tei eh Israelme de Manna, dui nah rekui mmi riakdai hetaideu ga peu gwang. Tinggwang au pecu nah penui muiteume de mlai eh lalie de pe minadung de ku nah penui mau gibeu jüja gwang.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Ramzeuki nah tetkegwang dau ziemne keledeusam (1:1-10:10)</para>
  <para style="io1">Sinai gade Moab langkam (10:11-21:35)</para>
  <para style="io1">Balaam, Balak, nah Israel (22:1-25:18)</para>
  <para style="io1">Canaan deu gwa nah gumlu kerane keledeusam (26:1-36:13)</para>
  <chapter number="1" style="c" sid="NUM 1" />
  <para style="s">Hepum Kepei</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1" />RAMPAUBE Sinai hetaideu ga kebam paiki gade Moses de mpau, Egyptme deu gade penui mpet kelu cai mmi pekenabe, kei na bekei raitu benai, RAMPAUBE rang, <verse eid="NUM 1:1" /><verse number="2" style="v" sid="NUM 1:2" />“Israelme pelane de pautsa gege kecu hepum pei cu, penui peime kelakdung gade. Penui zi gade pei lu. Mipeina peciakne de pei lu, hangge ge kecu <verse eid="NUM 1:2" /><verse number="3" style="v" sid="NUM 1:3" />mmi ngkai di mede ciswa cing kedime. Cauge reugwame nzwa Israelme ziemne regi lubui bi pelane de peilu. Nang nah Aaron reugwa maa ga mipei pumpei raulu maisia. <verse eid="NUM 1:3" /><verse number="4" style="v" sid="NUM 1:4" />Heleuh ge gade mipei hangge, pautsa gu pepeube, pe leuhme muiteube nzwa ncu ngngwa kengha zie. Muiteume ketket kecu minadung de teuswa zie cau penui leuhme ziemne regi ziebi.” <verse eid="NUM 1:4" /><verse number="5" style="v" sid="NUM 1:5" />Hezi aidungde muiteumedung ncu ngngwa eh regi kerame da:</para>
  <para style="q1" vid="NUM 1:5">“Reuben leuh gade, Shedeur napei Elizur;<verse eid="NUM 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 1:6" />Simeon leuh gade, Zurishaddai napei Shelumiel;<verse eid="NUM 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 1:7" />Judah leuh gade, Amminadab napei Nahshon;<verse eid="NUM 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 1:8" />Issachar leuh gade, Zuar napei Nethanel;<verse eid="NUM 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 1:9" />Zebulun leuh gade, Helon napei Eliab;<verse eid="NUM 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 1:10" />Joseph napei Ephraim leuh gade, Ammihud napei Elishama;</para>
  <para style="q1" vid="NUM 1:10">Manasseh leuh gade, Pedahzur napei Gamaliel;<verse eid="NUM 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NUM 1:11" />Benjamin leuh gade, Gideoni napei Abidan;<verse eid="NUM 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NUM 1:12" />Dan leuh gade, Ammishaddai napei Ahiezer;<verse eid="NUM 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NUM 1:13" />Asher leuh gade, Okran napei Pagiel;<verse eid="NUM 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NUM 1:14" />Gad leuh gade, Deuel napei Eliasaph;<verse eid="NUM 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NUM 1:15" />nah Naphtali leuh gade, Enan napei Ahira.”<verse eid="NUM 1:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="NUM 1:16" />Mipei aidungde minadung kakga de kedetlu. Penui ne penui paupaime leuhdung muiteu tei. Penui au Israel ga pautsame muiteudung. <verse eid="NUM 1:16" /><verse number="17" style="v" sid="NUM 1:17" />Moses penai Aaron mina aidungde de ngngwa lu, penui zi rau nzeulu, <verse eid="NUM 1:17" /><verse number="18" style="v" sid="NUM 1:18" />nah mina aidungde de nzang lwe penai Israelme pelane de ngngwa ngkwa ncütlu pekenabe kei raitu benai. Pecai mige ge kecu mmi ngkai cing nah ciswa cing kedime pe paupai ria ci mcilu. Penui paume dade lungh kegwang pautsadung nah kelakdung zi raulu. <verse eid="NUM 1:18" /><verse number="19" style="v" sid="NUM 1:19" />Ge Moses Sinai hetaideu gade penui pumpei rau nzeulu, RAMPAUBE pecu tei lulo aja kaikebeu nzwa.<verse eid="NUM 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 1:20" />Reuben leuhme gade, Israelme neraibe, hangge ge kecu nah mipei leune mmi ngkai mede ciswa cing kedime reugwa ga mielu kebuime pelane zi peilu, penui paupai pautsadung nah kelakdung rau kenzeu gade. <verse eid="NUM 1:20" /><verse number="21" style="v" sid="NUM 1:21" />Reuben leuhme gade penui mina 46,500 pei lu.<verse eid="NUM 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 1:22" />Simeon leuhme gade hangge ge kecu nah mipei leune mmi ngkai mede ciswa cing kedime reugwa ga mielu kebuime pelane zi peilu, penui paupai pautsadung nah kelakdung rau kenzeu gade. <verse eid="NUM 1:22" /><verse number="23" style="v" sid="NUM 1:23" />Simeon leuhme gade penui mina 59,300 peilu.<verse eid="NUM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 1:24" />Gad leuhme gade hangge ge kecu nah mipei leune mmi ngkai mede ciswa cing kedime reugwa ga mielu kebuime pelane zi peilu, pautsadung nah kelakdung penui paume rau kenzeu gade. <verse eid="NUM 1:24" /><verse number="25" style="v" sid="NUM 1:25" />Gad leuhme gade penui mina 45,650 peilu.<verse eid="NUM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 1:26" />Judah leuhme gade hangge ge kecu nah mipei leune mmi ngkai mede ciswa cing kedime reugwa ga mielu kebuime pelane zi peilu, penui paupai pautsadung nah kelakdung rau kenzeu gade. <verse eid="NUM 1:26" /><verse number="27" style="v" sid="NUM 1:27" />Judah leuhme gade penui mina 74,600 peilu.<verse eid="NUM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 1:28" />Issachar leuhme gade hangge ge kecu nah mipei leune mmi ngkai mede ciswa cing kedime reugwa ga mielu kebuime pelane zi peilu, penui paupai pautsadung nah kelakdung rau kenzeu gade. <verse eid="NUM 1:28" /><verse number="29" style="v" sid="NUM 1:29" />Issachar leuhme gade penui mina 54,400 peilu.<verse eid="NUM 1:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 1:30" />Zebulun leuhme gade hangge ge kecu nah mipei leune mmi ngkai nah ciswa cing kedime reugwa ga mielu kebuime pelane zi peilu, penui paupai pautsadung nah kelakdung rau kenzeu gade. <verse eid="NUM 1:30" /><verse number="31" style="v" sid="NUM 1:31" />Zebulun leuhme gade penui mina 57,400 peilu.<verse eid="NUM 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 1:32" />Joseph napei Ephraim leuhme gade hangge ge kecu nah mipei leune mmi ngkai mede ciswa cing kedime reugwa ga mie lu kebuime pelane zi peilu, penui paupai pautsadung nah kelakdung rau kenzeu gade. <verse eid="NUM 1:32" /><verse number="33" style="v" sid="NUM 1:33" />Ephraim leuhme gade penui mina 40,500 peilu.<verse eid="NUM 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 1:34" />Joseph napei Manasseh leuhme gade hangge ge kecu nah mipei leune mmi ngkai mede ciswa cing kedime reugwa ga mie lu kebuime pelane zi peilu, penui paupai pautsadung nah kelakdung rau kenzeu gade. <verse eid="NUM 1:34" /><verse number="35" style="v" sid="NUM 1:35" />Manasseh leuhme gade penui mina 32,200 peilu.<verse eid="NUM 1:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 1:36" />Benjamin leuhme gade hangge ge kecu nah mipei leune mmi ngkai mede ciswa cing kedime reugwa ga mie lu kebuime pelane zi peilu, penui paupai pautsadung nah kelakdung rau kenzeu gade. <verse eid="NUM 1:36" /><verse number="37" style="v" sid="NUM 1:37" />Benjamin leuhme gade penui mina 35,400 peilu.<verse eid="NUM 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 1:38" />Dan leuhme gade hangge ge kecu nah mipei leune mmi ngkai mede ciswa cing kedime reugwa ga mie lu kebuime pelane zi peilu, penui paupai pautsadung nah kelakdung rau kenzeu gade. <verse eid="NUM 1:38" /><verse number="39" style="v" sid="NUM 1:39" />Dan leuhme gade penui mina 62,700 peilu.<verse eid="NUM 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 1:40" />Asher leuhme gade hangge ge kecu nah mipei leune mmi ngkai mede ciswa cing kedime reugwa ga mie lu kebuime pelane zi peilu, penui paupai pautsadung nah kelakdung rau kenzeu gade. <verse eid="NUM 1:40" /><verse number="41" style="v" sid="NUM 1:41" />Asher leuhme gade penui mina 41,500 peilu.<verse eid="NUM 1:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 1:42" />Naphtali leuhme gade hangge ge kecu nah mipei leune mmi ngkai mede ciswa cing kedime reugwa ga mie lu kebuime pelane zi peilu, penui paupai pautsadung nah kelakdung rau kenzeu gade. <verse eid="NUM 1:42" /><verse number="43" style="v" sid="NUM 1:43" />Naphtali leuhme gade penui mina 53,400 peilu.<verse eid="NUM 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 1:44" />Moses penai Aaron mina aidung pelane de peilu, Israel leuhme puisau tei kela mina kereiehkena de ngngwa ncüt eh. <verse eid="NUM 1:44" /><verse number="45" style="v" sid="NUM 1:45" />Cine Israelme pelane mmi ngkai nah ciswa cing kedime, hereu regi lu kebuime pelane, penui ki kelakdung gade ketket peilu. <verse eid="NUM 1:45" /><verse number="46" style="v" sid="NUM 1:46" />Penui mipei 603,550 peilu.<verse eid="NUM 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47" />Dede mina Levime leuh gade lungh kegwangme de pei ma, <verse eid="NUM 1:47" /><verse number="48" style="v" sid="NUM 1:48" />kedanemene RAMPAUBE Moses dage rangbeu, <verse eid="NUM 1:48" /><verse number="49" style="v" sid="NUM 1:49" />“Nang Levi leuhme de peilak mede Israelme pelane ga penuide de si lak. <verse eid="NUM 1:49" /><verse number="50" style="v" sid="NUM 1:50" />Ciumeliene, Levime de nlumbeulu paiki recabam samkakkelu hezaidung pie rengei kera, nah paiki recabam niadung leune nah cika kebam mania pelane pie rengei kera. Levime recabam de pwa zie, nah reca paiki netdung de pung zie. Penui reca paiki pie rengei teune zie nah penui ramzeuki cide tei twagwa zie.<note caller="-" style="x"><char style="xo" closed="false">1:50 </char><char style="xt" closed="false"><ref loc="ACT 7:44">Bat. 7:44</ref></char></note> <verse eid="NUM 1:50" /><verse number="51" style="v" sid="NUM 1:51" />Reca paiki heni keda gage tei kedi kecudau, Levime ne cide ra nghung zie. Reca paiki teicuh kera telei keludau, Levime ne tei ncuh zie. Sangme keheibe de reca paiki ga gwang nna cai teitset dizie. <verse eid="NUM 1:51" /><verse number="52" style="v" sid="NUM 1:52" />Israelme penui paikidung teincuh kecudau, mige ge de penui reugwa maame pailim kenna gage tei zie. <verse eid="NUM 1:52" /><verse number="53" style="v" sid="NUM 1:53" />Iciuliede, samkakkelu hezaidung reca paiki de Levime ne penui paikidung lim twagwa luzie ciciulude a rata Israelme reuga gwang di kelakne. Levime samkakkelu hezaidung reca paiki de pie rengei zie.” <verse eid="NUM 1:53" /><verse number="54" style="v" sid="NUM 1:54" />Israelme ma aidung pelane teilu. RAMPAUBE Moses dage aja kaikebeu pelane penui teilu.<verse eid="NUM 1:54" /></para>
  <chapter eid="NUM 1" />
  <chapter number="2" style="c" sid="NUM 2" />
  <para style="s">Heleuh Ramzeuki Ketelei</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1" />RAMPAUBE Moses penai Aaron de mpau dai. Pa rang eh, <verse eid="NUM 2:1" /><verse number="2" style="v" sid="NUM 2:2" />“Israelme ketket kecu pemaa kenzwame tai ramzeuki tei twagwa zie, penui peime kelak pailimdung ga zie. Kengkwa paiki petu pelane penui ramzeuki tei twagwa zie. <verse eid="NUM 2:2" /><verse number="3" style="v" sid="NUM 2:3" />Kengkwa paiki naimiak kepetle tu, tingnaimiak pet kecu lambi, cidungde ramzeuki teilwe bamzie, cide Judahme ramzeuki nah penui maa kenzwa kangga penui ramzeuki teibam. Amminadab napei Nahson ne Judah minadung gu muiteube da. <verse eid="NUM 2:3" /><verse number="4" style="v" sid="NUM 2:4" />Judahme pumpei mina 74,600. <verse eid="NUM 2:4" /><verse number="5" style="v" sid="NUM 2:5" />Issachar leuhme Judah cia gage ramzeuki zie. Zuar napei Nethanel ne Issachar reugwame muiteu tei maisia. <verse eid="NUM 2:5" /><verse number="6" style="v" sid="NUM 2:6" />Pecu mzi kebeu pumpei cai mina 54,400. <verse eid="NUM 2:6" /><verse number="7" style="v" sid="NUM 2:7" />Zebulun leuhme Issachar cia gage ramzeuki tei maisia. Helon napei Eliab ne Zebulun reugwa muiteu teizie. <verse eid="NUM 2:7" /><verse number="8" style="v" sid="NUM 2:8" />Pecu mzi kebeu pumpei cai 57,400. <verse eid="NUM 2:8" /><verse number="9" style="v" sid="NUM 2:9" />Judah ramzeuki pumpei pelane ge 186,400. Penuine tetpet rai zie.<verse eid="NUM 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 2:10" />Tingbangle tu Reuben maame ramzeuki zie penui maame kenzwa kangga. Shedeur napei Elizur ne Reuben ramzeuki muiteu tei zie. <verse eid="NUM 2:10" /><verse number="11" style="v" sid="NUM 2:11" />Pecu mzi kebeu pumpei cai 46,500. <verse eid="NUM 2:11" /><verse number="12" style="v" sid="NUM 2:12" />Reuben cia ga Simeon ramzeuki. Simeon leuhme muiteube cai Zurishaddai napei Shelumiel. <verse eid="NUM 2:12" /><verse number="13" style="v" sid="NUM 2:13" />Pecu mzi kebeu pumpei cai 59,300. <verse eid="NUM 2:13" /><verse number="14" style="v" sid="NUM 2:14" />Pecia ga Gad leuhme. Gad leuhme muiteube cai Deuel napei Eliasaph. <verse eid="NUM 2:14" /><verse number="15" style="v" sid="NUM 2:15" />Pecu mzi kebeu pumpei cai 45,650. <verse eid="NUM 2:15" /><verse number="16" style="v" sid="NUM 2:16" />Reuben ramzeuki ga kebam mina pelane pumpei, penuide mzi kebeu rehi gade cai 151,450. Penui tet mpet pekenabe zie.<verse eid="NUM 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 2:17" />Pecia, ramzeuki gade kengkwa paiki tetpet zie Levime de ngngwa eh ramzeukidung pelane kakgade. Penui ramzeuki ga kegwang rehi nzwa siakte penui ramzeuki gade tet mpet zie. Mileune pebam ga bam zie, pe pailim ga.<verse eid="NUM 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 2:18" />Ephraim ramzeuki mzidung penui maa kangga. Ephraim leuhme muiteube Ammihud napei Elishama. <verse eid="NUM 2:18" /><verse number="19" style="v" sid="NUM 2:19" />Pecu mzi kebeu pumpei cai 40,500. <verse eid="NUM 2:19" /><verse number="20" style="v" sid="NUM 2:20" />Penui cia ga Manasseh leuhme. Manasseh leuhme muiteube cai Pedahzur napei Gamaliel. <verse eid="NUM 2:20" /><verse number="21" style="v" sid="NUM 2:21" />Pecu mzi kebeu pumpei cai 32,200. <verse eid="NUM 2:21" /><verse number="22" style="v" sid="NUM 2:22" />Pecia ga cai Benjamin leuhme. Benjamin leuhme muiteube cai Gideoni napei Abidan. <verse eid="NUM 2:22" /><verse number="23" style="v" sid="NUM 2:23" />Pecu mzi kebeu pumpei cai 35,400. <verse eid="NUM 2:23" /><verse number="24" style="v" sid="NUM 2:24" />Ephraim ramzeuki ga pumpei pelane ge 108,100. Penui tet kempet pekecumbe zie.<verse eid="NUM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 2:25" />Tingpeule bie cai Dan ramzeuki gu pe mzidung. Dan leuhme muiteube cai Ammishaddai napei Ahiezer. <verse eid="NUM 2:25" /><verse number="26" style="v" sid="NUM 2:26" />Pecu mzi kebeu pumpei cai 62,700. <verse eid="NUM 2:26" /><verse number="27" style="v" sid="NUM 2:27" />Dan leuhme cia gage Asher leuhme ramzeuki tei lu. Asher leuhme muiteube cai Okran napei Pagiel. <verse eid="NUM 2:27" /><verse number="28" style="v" sid="NUM 2:28" />Pecu mzi kebeu pumpei cai 41,500. <verse eid="NUM 2:28" /><verse number="29" style="v" sid="NUM 2:29" />Pecia ga Naphtali leuhme. Naphtali leuhme muiteube Enan napei Ahira. <verse eid="NUM 2:29" /><verse number="30" style="v" sid="NUM 2:30" />Pecu mzi kebeu pumpei cai 53,400. <verse eid="NUM 2:30" /><verse number="31" style="v" sid="NUM 2:31" />Dan ramzeuki ga pumpei pelane ge 157,600. Penui ramzeuki gade tet kempet kamtube zie, penui maa kang gade.”<verse eid="NUM 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 2:32" />Aidungde Israelme da, penui kelakdung rehi gade pumpei kelu. Penui ramzeuki gade pumpei kelu pelane, penui mzidung gade, 603,550. <verse eid="NUM 2:32" /><verse number="33" style="v" sid="NUM 2:33" />Dede Moses penai Aaron Israelme kakgade Levime de pei si ma. Aide RAMPAUBE ne Moses dage aja kaikebeu de da. <verse eid="NUM 2:33" /><verse number="34" style="v" sid="NUM 2:34" />RAMPAUBE Moses dage aja kaikebeu pelane Israelme teilu. Penui gu pailim kangga de penui ramzeuki teilu. Penui ramzeuki gade pautsa ria gade tet mpet, penui paume kelakdung rehi gade.<verse eid="NUM 2:34" /></para>
  <chapter eid="NUM 2" />
  <chapter number="3" style="c" sid="NUM 3" />
  <para style="s">Levime</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1" />Cu aide Aaron penai Moses leuhme caiha RAMPAUBE Moses de ngngwa Sinai Deutu gade kempau kecudau. <verse eid="NUM 3:1" /><verse number="2" style="v" sid="NUM 3:2" />Aaron napeime zidung cai neraibe Nadab, nah Abihu, Eleazar, nah Ithamar. <verse eid="NUM 3:2" /><verse number="3" style="v" sid="NUM 3:3" />Aidungde Aaron napeimedung zi, keniak kelu cingkumedung nah kedet kelumedung cingku ta tei kerane. <verse eid="NUM 3:3" /><verse number="4" style="v" sid="NUM 3:4" />Dede Nadab penai Abihu Sinai hetaideu gade luugai kelak mi reca RAMPAUBE de kepeu dau penai pe dwaga de tsai kauzeu di. Nadab penai Abihu pename ga, cine Eleazar penai Ithamar rünne penai pei Aaron de ngngwa cingku ta tei.<verse eid="NUM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5" />RAMPAUBE Moses de mpau. Pa rang eh, <verse eid="NUM 3:5" /><verse number="6" style="v" sid="NUM 3:6" />“Levi leuhme de ngngwa gwanglu nah penuide Aaron cingkupei dage kailu penuide peu pecu ngha lu kera ziemne. <verse eid="NUM 3:6" /><verse number="7" style="v" sid="NUM 3:7" />Penui kengkwa paiki dwa gade Aaron nah tingbungme pelane keleu gade batadung teizie. Penui paiki recabam ga heta teizie. <verse eid="NUM 3:7" /><verse number="8" style="v" sid="NUM 3:8" />Penui kengkwa paiki ga mania leune pie rengei zie, nah penui Israel leuhme de kengha eh reca paiki ngkwa gwa teizie. <verse eid="NUM 3:8" /><verse number="9" style="v" sid="NUM 3:9" />Nang Levime de Aaron nah pe napeimedung de peudi maisia. Penuide kaiciak pwa pecu ngha eh Israelme de ngkwet kerane. <verse eid="NUM 3:9" /><verse number="10" style="v" sid="NUM 3:10" />Nang Aaron nah pe napeimedung de cingkume kedetlu maisia, dede sangme keheibe de gwang nna kecume de teitset dizie.”<verse eid="NUM 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11" />RAMPAUBE Moses de mpau. Pa rang eh, <verse eid="NUM 3:11" /><verse number="12" style="v" sid="NUM 3:12" />“Pielo, Ih Levime de Israelme kakga de keuteu dida. Ih aide tei kecu Israelme kakga de mna kelu mipeina neraibe ketket kecu keu kera mding gade. Levime agu dida. <verse eid="NUM 3:12" /><verse number="13" style="v" sid="NUM 3:13" />Neraibe pelane agu. Ih Egyptme deu gade neraibe pelane de ketang kecu benai, Israel ga neraibe leune a katei aziemne keu ntsamlu, minadung nah makaune de. Penui au agu. Ih au RAMPAUBE.”<verse eid="NUM 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14" />RAMPAUBE Sinai hetaideu gade Moses de mpau. Pa rang eh, <verse eid="NUM 3:14" /><verse number="15" style="v" sid="NUM 3:15" />“Levi leuhme kelak ketket kecu peilu, penui pautsadung gade. Mipeina leune kei ge cing nah ciswa cing kedime de peilu.” <verse eid="NUM 3:15" /><verse number="16" style="v" sid="NUM 3:16" />Moses penuide peilu, RAMPAUBE sam de mzui eh, pecu tei lulo aja kaikebeu siakte. <verse eid="NUM 3:16" /><verse number="17" style="v" sid="NUM 3:17" />Levime napeimedung zi cai Gershon, Kohath, nah Merari. <verse eid="NUM 3:17" /><verse number="18" style="v" sid="NUM 3:18" />Gershon napeime dade kegwang pautsadung cai Libni nah Shimei. <verse eid="NUM 3:18" /><verse number="19" style="v" sid="NUM 3:19" />Kohath napeime dade kegwang pautsadung cai Amram, Izhar, Hebron nah Uzziel. <verse eid="NUM 3:19" /><verse number="20" style="v" sid="NUM 3:20" />Merari napeime dade kegwang pautsadung cai Mahli nah Mushi. Aidungde Levime pautsadung, pautsa ge gade pautsa ge rau lu.<verse eid="NUM 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 3:21" />Gershon dade Libnitme nah Shimeitme pautsadung gwang. Aidungde Gershonme pautsadung. <verse eid="NUM 3:21" /><verse number="22" style="v" sid="NUM 3:22" />Mipeinadung kei ge cing nah ciswa cing kedime pelane de peilu, pelane ge 7,500. <verse eid="NUM 3:22" /><verse number="23" style="v" sid="NUM 3:23" />Gershonme pautsadung reca paiki naimiak kenlütle tule ge ramzeuki tei zie. <verse eid="NUM 3:23" /><verse number="24" style="v" sid="NUM 3:24" />Lael napei Eliasaph de peu Gershon leuhme pautsadung muiteu tei zie. <verse eid="NUM 3:24" /><verse number="25" style="v" sid="NUM 3:25" />Gershon kilungme de peu kengkwa paiki reca paiki de si eh pie rengei zie. Paiki cide kehezui nah kengkwa paiki kimui ga kehezu pai teu kecude penui pie rengei zie. <verse eid="NUM 3:25" /><verse number="26" style="v" sid="NUM 3:26" />Penui pie rengei zie kigu kehezudung, kigu kenlüt ga kehezu paidung, kemci ni nah recabam twagwa pung kebam kigu. Kengkwa paiki heriadung nah cika kebam leune penui pie rengei zie.<verse eid="NUM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 3:27" />Pautsa aidungde Kohath gade gwang: Amramme pautsa, Izharme pautsa, Hebronme pautsa, nah Uzzielme pautsa. Pautsa aidungde Kohath leuhme. <verse eid="NUM 3:27" /><verse number="28" style="v" sid="NUM 3:28" />Mipeina kei ge cing nah ciswa cing kedime 8,600 peilu kemci ni gu niadung pie rengei kerane. <verse eid="NUM 3:28" /><verse number="29" style="v" sid="NUM 3:29" />Kohath pautsadung reca paiki tingbangle tu ge ramzeuki teizie. <verse eid="NUM 3:29" /><verse number="30" style="v" sid="NUM 3:30" />Uzziel napei Elizaphan Kohathme pautsadung gu muiteu teizie. <verse eid="NUM 3:30" /><verse number="31" style="v" sid="NUM 3:31" />Penui samkakbung, taktyeibam, mitaubungbam, recabamdung, penui reca tingdau kemci niadung teu kelabe, kehezupai, nah bata leune cika twagwa kebamdung pie rengei zie. <verse eid="NUM 3:31" /><verse number="32" style="v" sid="NUM 3:32" />Aaron napei Eleazar cingkube Levime reu muiteu tei kelame reu muiteu teizie. Kemci ni pie rengei kelame de pa heta saulia zie.<verse eid="NUM 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 3:33" />Pautsa kena Merari dade gwang: Mahlime pautsa penai Mushitme pautsa. Pautsa aidungde Merari kilungme gade gwang. <verse eid="NUM 3:33" /><verse number="34" style="v" sid="NUM 3:34" />Mipeinadung pe teilung kei ge cing nah ciswa cing kedime 6,200 peilu. <verse eid="NUM 3:34" /><verse number="35" style="v" sid="NUM 3:35" />Merari pautsadung de Abihail napei Zuriel ne teuswa zie. Penui reca paiki tingpeule tuge ramzeuki teizie. <verse eid="NUM 3:35" /><verse number="36" style="v" sid="NUM 3:36" />Merari leuhme pie rengei maisia reca paiki radung, pehekangdung, petsiadung, pesingkamdung, mania leune nah penui teu maikesia leune, <verse eid="NUM 3:36" /><verse number="37" style="v" sid="NUM 3:37" />kigu hesumtsiadung de si eh nah hetsiadung reca paiki twagwa kebam, kemtokdung, pegwakdung nah heriadung de si.<verse eid="NUM 3:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 3:38" />Moses penai Aaron nah pe napeimedung naimiak kepetle bie tu ge ramzeuki teizie, kengkwa paiki dwa gage, naimiak kepetle ge. Kemci ni ga heta nlumkebeu nah Israelmena da nlumkebeu heta teicanglu kera au penui nsam. Sangme keheibe de kemci ni ga kegwangme de teitset dizie. <verse eid="NUM 3:38" /><verse number="39" style="v" sid="NUM 3:39" />Moses penai Aaron Levime pautsa mipeina kei ge cing nah ciswa cing kedime pelane peilu, RAMPAUBE aja kaikebeu siakte. Penui mipei cang ngkaiekena peilu.<verse eid="NUM 3:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40" />RAMPAUBE Moses dage rang, “Israelme mipeinadung neraibe penui teilung kei ge cing nah ciswa cing kedime de pei ciaklu. Penui zidung raulu. <verse eid="NUM 3:40" /><verse number="41" style="v" sid="NUM 3:41" />Nang Levime de a ziemne keulu maisia, Ih RAMPAUBE, Israelme neraibe pelane nding gade, nah Levime kauruine de Israel leuhme kauruine mciu kelu raitube mding gade.” <verse eid="NUM 3:41" /><verse number="42" style="v" sid="NUM 3:42" />Moses Israelme neraibe pelane de peilu RAMPAUBE pecu tei lulo aja kaikebeu nzwa eh. <verse eid="NUM 3:42" /><verse number="43" style="v" sid="NUM 3:43" />Pa mipeina neraibe pelane de pezi rehi gade peilu, pe teilung kei ge cing nah ciswa cing kedime. Pa mina 22,273 peilu.<verse eid="NUM 3:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44" />RAMPAUBE Moses de mpau dai, rang eh, <verse eid="NUM 3:44" /><verse number="45" style="v" sid="NUM 3:45" />“Israelme kakgade neraibe pelane mding gade Levime de keulu, nah minadung kauruine mding gade Levime kauruine keulu. Levime agu, Ih RAMPAUBE. <verse eid="NUM 3:45" /><verse number="46" style="v" sid="NUM 3:46" />Nang shekel mengei hekwalu maisia Israelmena neraibe 273 hangge ge kecu Levime swa pumpei twakedi me de rilu kera ziemne. <verse eid="NUM 3:46" /><verse number="47" style="v" sid="NUM 3:47" />Nnui kemci ni ga perüt keteu rehi gade shekel keu zie. Shekel ge gerah ngkai pe nsamkap. <verse eid="NUM 3:47" /><verse number="48" style="v" sid="NUM 3:48" />Nnui rilu kera mi pwa Aaron nah pe namedung de peu maisia.” <verse eid="NUM 3:48" /><verse number="49" style="v" sid="NUM 3:49" />Cine Moses rilu kera pemi kepeu de hekwalu Levime ne ri kelume pumpei twa kedime dade. <verse eid="NUM 3:49" /><verse number="50" style="v" sid="NUM 3:50" />Moses Isrealmena neraibe dade rangkang hekwalu. Pa 1,365 shekel hekwalu, kemci ni shekel le perüt mdetlu. <verse eid="NUM 3:50" /><verse number="51" style="v" sid="NUM 3:51" />Moses ri kelu rangkang pwa Aaron nah pe napeimedung de peudi. RAMPAUBE Moses de tei lulo aja kaikebeu leune pa teilu, RAMPAUBE pe dage aja kaikebeu nzwa.<verse eid="NUM 3:51" /></para>
  <chapter eid="NUM 3" />
  <chapter number="4" style="c" sid="NUM 4" />
  <para style="s">Kohath Leuhme</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1" />RAMPAUBE Moses penai Aaron de mpau. Pa rang eh, <verse eid="NUM 4:1" /><verse number="2" style="v" sid="NUM 4:2" />“Levime kakga de Kohath leuhme mipei pumpei gailo, penui pautsadung nah kilungmedung gade. <verse eid="NUM 4:2" /><verse number="3" style="v" sid="NUM 4:3" />Mipeidung pelane mmi camrei gade riakngei kecang peilu. Mipei aidungde kengkwa paiki ga heta tei kerane hemaa ga ncüt bi maisia. <verse eid="NUM 4:3" /><verse number="4" style="v" sid="NUM 4:4" />Kohath leuhme kengkwa paiki ga aziemne kaipwa kebam mcitube niadung de pie rengei lu maisia. <verse eid="NUM 4:4" /><verse number="5" style="v" sid="NUM 4:5" />Ramzeuki teuswa tet kera telei keludau, Aaron nah pe napeidung paiki ga gwanglu maisia, kehezupai mcitube ni de kemci ni gade teu ntsam kebam de keugi di nah zierang samkakbung de cide ne kezuilu. <verse eid="NUM 4:5" /><verse number="6" style="v" sid="NUM 4:6" />Penui samkakbung de teigeu keyi ge le kezui di maisia. Penui pai kepuge pereu gage kamgailu maisia. Penui cide pwa kerane matiedung heci nlütlu maisia. <verse eid="NUM 4:6" /><verse number="7" style="v" sid="NUM 4:7" />Penui tangku reca pwa kebam taktyeibam reu gage pai kepuge kamgai zie. Cika ge penui lidung, petiadung, hekwakdung, nah ruigai kera duilabung kaizie. Taktyeibam ga tangku bammui maisia. <verse eid="NUM 4:7" /><verse number="8" style="v" sid="NUM 4:8" />Penui cipau reu gage pai kegie kam zie nah cide makaune geu keyibe le hacim zie. Penui taktyeibam pungkera matiedung heci nlüt maisia. <verse eid="NUM 4:8" /><verse number="9" style="v" sid="NUM 4:9" />Penui hepai kepuge keulu nah kebaabungbam de hacim di maisia, kebaabungdung, misiepdung, makwakdung de si eh, nah macadui bungdung pelane kebaabungdung ziemne. <verse eid="NUM 4:9" /><verse number="10" style="v" sid="NUM 4:10" />Penui kebaabungbam de nah teumaikesia niadung pelane teigeu keyi le kezui pwa kebam gage kaibi lu maisia, nah penui cide pungkela rak gage kailu maisia. <verse eid="NUM 4:10" /><verse number="11" style="v" sid="NUM 4:11" />Penui kecak recabam de ga hepai kepuge kamgai lu maisia. Penui cide teigeu keyi ge le hacim lu maisia, nah ciu eh pungkera matiedung de heci nlütlu. <verse eid="NUM 4:11" /><verse number="12" style="v" sid="NUM 4:12" />Penui kemci ni ga mata tei kerane mania keu maikesia pelane keulu nah cide pai kepuge le kezui lu maisia. Cidungde makaune geu keyibe le hacim di maisia nah maniadung de pungkela perak gage kailu. <verse eid="NUM 4:12" /><verse number="13" style="v" sid="NUM 4:13" />Penui recabam gade mimüt de keugi di maisia nah recabam gage gieremang pai ge kamgailu. <verse eid="NUM 4:13" /><verse number="14" style="v" sid="NUM 4:14" />Penui pungkela perak gage recabam ga mata tei eh keukecu niadung pelane kaigai lu maisia. Mania aidungde cai mikwakdung, petiadung, hepeidung, hekwakdung, nah recabam ziemne kedabe niadung pelane. Penui ratakbam de makaune geu keyige le hacim maisia nah pecai pungkera matiedung heci nlütlu. <verse eid="NUM 4:14" /><verse number="15" style="v" sid="NUM 4:15" />Aaron nah pe napeidung kemci ni cide hacim cangsiak keludau nah pe niadung pelane, nah ramzeuki teu tetswa kecudau, Kohath leuhme kemci ni de pwa kera gwangbi maisia. Magade penui kemci niadungde tungdi cai, penui tsai bizie. Aide Kohath leuhme ta da, kengkwa paiki ga cipau niadung de pwa gwang kera. <verse eid="NUM 4:15" /><verse number="16" style="v" sid="NUM 4:16" />Cingkupei Aaron napei Eleazar ne kebaa ziemne macadui, perim kehengui, peubam kela meibui reca, nah maca keniak kelu aidungde pie rengei bam. Pa ne reca paiki pelane pie rengei nah cika kebam pelane, kemci ni nah pe niadung.”<verse eid="NUM 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17" />RAMPAUBE Moses penai Aaron de mpau. Pa rang eh, <verse eid="NUM 4:17" /><verse number="18" style="v" sid="NUM 4:18" />“Levime kakga de Kohath pautsa leuhme de teumpet diso. <verse eid="NUM 4:18" /><verse number="19" style="v" sid="NUM 4:19" />Penuide gumlu, iciude penui ringlu zie nah tsai dilak, aide tei kegaine. Penui mcitube taiga gwang nna keludau <verse eid="NUM 4:19" /><verse number="20" style="v" sid="NUM 4:20" />kaknage ziemne de penuide peu kemci ni de nlüt pie so, mecai penui tsai bizie. Aaron nah pe napeidung nlüt maisia, nah ciciu eh Aaron nah pe napeimedung Kohath leuhme hangge ge kecu de peta nlumbeu maisia, pe ziemne yitu kera tadung ga.”<verse eid="NUM 4:20" /></para>
  <para style="s">Gershon Leuhme</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21" />RAMPAUBE Moses de mpau dai. Pa rang eh, <verse eid="NUM 4:21" /><verse number="22" style="v" sid="NUM 4:22" />“Gershon leuhme pum de pei gailo, penui paume gade nah penui pautsadung gade. <verse eid="NUM 4:22" /><verse number="23" style="v" sid="NUM 4:23" />Mmi camrei gade mmi riakngei medung de peilu. Kengkwa paiki ga ncüt eh hemaa ga hetatei kerame pelane de peilu. <verse eid="NUM 4:23" /><verse number="24" style="v" sid="NUM 4:24" />Aide Gershonme pautsadung ta da, penui hetatei kecudau nah penui pungkela de. <verse eid="NUM 4:24" /><verse number="25" style="v" sid="NUM 4:25" />Penui reca paiki kehezupaidung de punglu maisia, kengkwa paiki, cide hacim kebamdung, cika makaune geu keyi hacim pwa kebam, nah kengkwa paiki ga tet kenlüt kehezupaidung. <verse eid="NUM 4:25" /><verse number="26" style="v" sid="NUM 4:26" />Penui kigu kehezupaidung de punglu maisia, kigu herieki ga kimuiki gu kehezupai de, reca paiki nah ratakbam taiga nna kebamde, pe riadung, nah penui tadung ziemne maniadung pelane. Aidungde teu eh daige tei maisia bambi, penui teibi maisia. <verse eid="NUM 4:26" /><verse number="27" style="v" sid="NUM 4:27" />Aaron nah pe napeimedung Gershon leuhme hetadung leune ranglia beu maisia, mapelane penui punggwang pungmie kebam ga, nah penui tadung leune ga. Penui pungkera pütdung leune nnui penuide nlumbeu maisia. <verse eid="NUM 4:27" /><verse number="28" style="v" sid="NUM 4:28" />Paiki de ziemne Gershon pautsa leuhme hetatei kera aipau deda. Cingkupei Aaron napei Ithamar de peu penui ta ga penuide teuswa lu maisia.<verse eid="NUM 4:28" /></para>
  <para style="s">Merari Leuhme</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29" />Nnui Merari leuhme de penui pautsadung gade peilu maisia, nah penui paume kelakdung gade, <verse eid="NUM 4:29" /><verse number="30" style="v" sid="NUM 4:30" />mmi camrei gade nah penreume mmi riakngei kecang. Hemaa ga ncüt eh kengkwa paiki ga heta tei kerame pelane de peilu. <verse eid="NUM 4:30" /><verse number="31" style="v" sid="NUM 4:31" />Aide penui pungkera püt da nah penui ta da kengkwa paiki de ziemne penui ta leune ga heta teikera. Penui reca paiki perak de pie teune lu maisia, pehekangdung, hetsiadung, nah kemtokdung, <verse eid="NUM 4:31" /><verse number="32" style="v" sid="NUM 4:32" />reca paiki twagwa kebam kigu hetsiadung de si eh, cide kemtokdung, pegwakdung, nah penui gu heriadung, penui gu mania leune. Hezi gade raulu penui pung maikesia dungde. <verse eid="NUM 4:32" /><verse number="33" style="v" sid="NUM 4:33" />Aide Merari pautsame leuhdung tei kera tadung da, kengkwa paiki ziemne penui daipai teimai sia bi kecu, cingkupei Aaron napei Ithamar saulia kebeu kangga de.”<verse eid="NUM 4:33" /></para>
  <para style="s">Levi Pautsa Pumkepei</para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 4:34" />Moses penai Aaron nah hemaabe gu muiteume Kohath leuhme de peilu penui paume kelakdung pautsa gade. <verse eid="NUM 4:34" /><verse number="35" style="v" sid="NUM 4:35" />Penui mmi camrei gade nah penreume mmi riakngei kecang de peilu. Penui mileune de peilu hemaa ga ncüt kerame de kengkwa paiki ga hetatei kerane. <verse eid="NUM 4:35" /><verse number="36" style="v" sid="NUM 4:36" />Penui mipeidung 2,750 penui pautsa gade peilu. <verse eid="NUM 4:36" /><verse number="37" style="v" sid="NUM 4:37" />Aide Kohathme kengkwa paiki ga heta tei kera hezirau kelu pelane da. RAMPAUBE Moses da aja kaikebeu ria gade Moses penai Aaron penuide peilu.<verse eid="NUM 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 4:38" />Gershon leuhme de penui pautsadung gade peilu, penui paume kelakdung gade, <verse eid="NUM 4:38" /><verse number="39" style="v" sid="NUM 4:39" />mmi camrei gade mmi riakngei kecang, keheibe de hemaabe ga ncüt eh kengkwa paiki ga hetatei keramedung. <verse eid="NUM 4:39" /><verse number="40" style="v" sid="NUM 4:40" />Mipei pelane, penui pautsa nah penui paume kelakdung gade peilu, pumpei 2,630. <verse eid="NUM 4:40" /><verse number="41" style="v" sid="NUM 4:41" />Moses penai Aaron Gershon leuhme pautsadung kengkwa paiki ga heta tei kerame de peilu. Aide tei kecudau, Moses da RAMPAUBE ne penuide tei lulo aja kaikebeu de mzailu.<verse eid="NUM 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 4:42" />Merari leuhme de penui pautsa ga penui paume kelakdung gade peilu, <verse eid="NUM 4:42" /><verse number="43" style="v" sid="NUM 4:43" />mmi camrei gade mmi riakngei kecang, keheibe de hemaabe ga ncüt eh kengkwa paiki ga heta tei keramedung. <verse eid="NUM 4:43" /><verse number="44" style="v" sid="NUM 4:44" />Mipei pelane, penui pautsa gade nah penui paume kelakdung gade peilu, pumpei 3,200. <verse eid="NUM 4:44" /><verse number="45" style="v" sid="NUM 4:45" />Moses penai Aaron mipei aidungde de peilu, Merari leuhmedung. Aide tei kegai, Moses da RAMPAUBE ne penuide tei lulo aja kaikebeu de mzailu.<verse eid="NUM 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 4:46" />Cine Moses, Aaron, nah Israel muiteumedung Levime pelane penui pautsa nah penui paume kelakdung gade peilu <verse eid="NUM 4:46" /><verse number="47" style="v" sid="NUM 4:47" />mmi camrei gade mmi riakngei kecang. Penui reca paiki ga heta tei kerame pelane de peilu, nah mapung beu kerame nah kengkwa paiki ga maniadung pierengei kerame. <verse eid="NUM 4:47" /><verse number="48" style="v" sid="NUM 4:48" />Penui mipei 8,580 peilu. <verse eid="NUM 4:48" /><verse number="49" style="v" sid="NUM 4:49" />RAMPAUBE aja kaikebeu gade, Moses mina ketket kecu peilu, pecu daipai ta ga nlum pwapeu bambi kecu rehi gade pei gwang. Penui pungpwa kera ta nsam gade pa ketket de peilu. Aide teikegai gade, Moses da RAMPAUBE ne penuide tei lulo aja kaikebeu de mzailu.<verse eid="NUM 4:49" /></para>
  <chapter eid="NUM 4" />
  <chapter number="5" style="c" sid="NUM 5" />
  <para style="s">Ramzeuki Kemci</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1" />RAMPAUBE Moses de mpau. Pa rang eh, <verse eid="NUM 5:1" /><verse number="2" style="v" sid="NUM 5:2" />“Ramzeuki ga kempame kebamme, nah pepum nia kelwame, nah ketsai pau tung eh mci ta kedime leune de cikade lang mpet dilo de Israel minadung dage aja kaibeu lu. <verse eid="NUM 5:2" /><verse number="3" style="v" sid="NUM 5:3" />Mipei liede mipui liede, nang penuide ramzeuki gade gwa mpet dilu. Penui ramzeuki de teihera di kerabe ma, kedanemene Ih cika lungh bamlu.” <verse eid="NUM 5:3" /><verse number="4" style="v" sid="NUM 5:4" />Israel minadung cide teilu. RAMPAUBE Moses dage aja kaikebeu de nzwa, penuide ramzeuki gade gwa mpetdi. Israel minadung RAMPAUBE sam mzailu.<verse eid="NUM 5:4" /></para>
  <para style="s">Teimau kedine Ruidaibeukecu</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5" />RAMPAUBE Moses de mpau dai. Pa rang eh, <verse eid="NUM 5:5" /><verse number="6" style="v" sid="NUM 5:6" />“Israel minadung dage ranggai lo. Mina hangge hangge dage kemau teikegai nzwa mipei ge mede mipui ge kemau tei dicai, nah a da masanglu mecai, cipaude mau dida. <verse eid="NUM 5:6" /><verse number="7" style="v" sid="NUM 5:7" />Ciucai pa teikedi pe mau petlu maisia. Pa pe mau mi de kap cangciak di maisia nah cika ge zi mengei gade zi ge peu si dai maisia. Aide pa cau dage kemau teigai bi cipaube de peu maisia. <verse eid="NUM 5:7" /><verse number="8" style="v" sid="NUM 5:8" />Dede cau dage kemau teigai bi cipaube pe kibaume pemi luulu kera gah cai, pa pe mau ziemne pemi de cingkupei ge dade RAMPAUBE peulu maisia, meurünseu ge de si eh pe mau gibeulu kerane. <verse eid="NUM 5:8" /><verse number="9" style="v" sid="NUM 5:9" />Israel minadung reca kebeu mapeudung leune, kai ntsam keludung nah Israel minadung ne cingkupei dage pwa gwang kegaidung de, pe gu zie. <verse eid="NUM 5:9" /><verse number="10" style="v" sid="NUM 5:10" />Mina leune gu recadung de cingkupei ziemne zie; migede makeheibe de cingkupei de peu kebeu de, cide pegu dizie.”<verse eid="NUM 5:10" /></para>
  <para style="s">Marangkemak Nau de Kencet</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11" />Pecaide, RAMPAUBE Moses de mpau. Pa rang eh, <verse eid="NUM 5:11" /><verse number="12" style="v" sid="NUM 5:12" />“Israel minadung da ranggai lo. Penui dage rangbeu lu, ‘Magade mipei ge nau nreu tetdi nah pe nahpei da kemau teigai dicai. <verse eid="NUM 5:12" /><verse number="13" style="v" sid="NUM 5:13" />Magade mipei kedage pecu ngngwa henauhepei zai teidi nah pe nahpei dade ngkiem mbai di, nah pekatei pecu teihera di liede pa hera kedi cilu tadi, nah pe mau zierang tei kera migede gah di, kedanemene pa henauhepei zai tei kebam migede ngau kemakne, <verse eid="NUM 5:13" /><verse number="14" style="v" sid="NUM 5:14" />iciuliede, mningkemsia rabe pe nau hera kedi pe nahpei de ranglia beu lubui. Deliede, mningkemsia rabe pe nau hera melie de mipei be da kenret rang gwang lubui. <verse eid="NUM 5:14" /><verse number="15" style="v" sid="NUM 5:15" />Ainzwa kecudau, mipeibe pe nau de cingkupei da ngngwa gwang beu maisia. Pe nau mding gade pe nahpei ne ratak teibeu maisia, barley tokkui ephah zi kerei gade zi ge. Pa cika maca rui gai kerabe ma nah marim kehengui gede kai kerabe ma, kedanemene cide mningkemsia mei reca ge lu, nsunglu kera mei reca, teimau kedi de nsungla lu kerane.<verse eid="NUM 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 5:16" />Cingkupei cipau puide de RAMPAUBE dwa gage ngngwa gwanglu maisia. <verse eid="NUM 5:16" /><verse number="17" style="v" sid="NUM 5:17" />Cingkupei kemci dui piak ge nah paiki hangdeu gade rebui keulu maisia. Pa rebui de dui gage kailu maisia. <verse eid="NUM 5:17" /><verse number="18" style="v" sid="NUM 5:18" />Cingkupei mipuibe de RAMPAUBE dwa gage ngngwa gai luzie nah mipuibe peutam hiak dizie. Pa mipuibe ba gage kensung mei reca de kai zie, cide mningkemsia gu mei reca. Cingkupei reset keu gwanglu kebui dui keka de pe ba ga pwabam zie. <verse eid="NUM 5:18" /><verse number="19" style="v" sid="NUM 5:19" />Cingkupei peu mipuibe de sampet kera mtei luzie nah pe dage rang zie, ‘Magade mipei kedame ge de ncu ngngwa henauhepei zai tei mecai, nah magade nang ramlia eh kemau teidi mecai, ciucai reset teugwanglu kebui dui keka aide gade nang made dilak. <verse eid="NUM 5:19" /><verse number="20" style="v" sid="NUM 5:20" />Dede nang n nahpei kangga kebamdau de ramlia dicai nah nkatei ncu teihera dicai, nah mipei kedame ge ncu ngngwa henauhepei zai tei dicai, <verse eid="NUM 5:20" /><verse number="21" style="v" sid="NUM 5:21" />iciucai, (cingkupei mipuibe de peu sampet zie cide peda reset teugwanglu kebui ge, nah ciciu eh pa mipuibe de resiu bam maisia) ‘RAMPAUBE ncu reset ge tei dizie n minadung dage keulia beulu kerane. RAMPAUBE n niepum tei mneu di nah n za tei mma dicai aide teigwang zie. <verse eid="NUM 5:21" /><verse number="22" style="v" sid="NUM 5:22" />Dui aide reset teugwang kela de n za ga nghung zie nah n za tei mma dizie nah n niepum tei mneu dizie.’ Mipuibe ainzwa eh keli maisia, ‘Yeo, Ih mau cai cide a dage teigai beulu.’<verse eid="NUM 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23" />Cingkupei reset aidungde laisiudum gage rau gailu maisia, nah pecai pa rau kelu resetdung de dui keka le hui gidi maisia. <verse eid="NUM 5:23" /><verse number="24" style="v" sid="NUM 5:24" />Cingkupei mipuibe de peu sak maisia reset teugwang beu kela dui keka de. Reset teugwang beu kela dui keka pelung ga nlüt dizie nah cide ka dizie. <verse eid="NUM 5:24" /><verse number="25" style="v" sid="NUM 5:25" />Cingkupei mningkemsia mei reca de mipuibe ba gade keulu maisia. Pa mei reca de RAMPAUBE dwaga hetwagai maisia nah recabam ga pwa gwang zie. <verse eid="NUM 5:25" /><verse number="26" style="v" sid="NUM 5:26" />Cingkupei mei reca bazum ge keulu zie kensung reca tei kera, nah cide recabam gage ru gaizie. Pecai pa mipuibe de dui keka de sak kera peu maisia. <verse eid="NUM 5:26" /><verse number="27" style="v" sid="NUM 5:27" />Pa pecu dui sak kera peu kecudau, magade pa pe nahpei dage kemau teigai eh heradi liecai, iciucai dui reset teugwang kela cide pe lungga nlüt zie nah ka dizie. Pe za mma dizie nah pe niepum mneu dizie. Mipuibe pe minadung kakga de reset pung dizie. <verse eid="NUM 5:27" /><verse number="28" style="v" sid="NUM 5:28" />Dede mipuibe hera meliecai nah pa mci bam liecai, iciucai pe da magede dilak. Pa pe na lung lubui.<verse eid="NUM 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 5:29" />Aide mide miriak kedi hezai. Aide mipui ge pe nahpei dade ramlia kedi nah hera kedi ziemne hezai ge. <verse eid="NUM 5:29" /><verse number="30" style="v" sid="NUM 5:30" />Aide mipei ge pe nau de periak kecudau pe da mide ngau periak kecu rabe bam kedi dau ziemne hezai ge. Pa mipuibe de RAMPAUBE dwaga ngngwa gwang maisia, nah cingkupei mide miriak kedi hezaibe ga dai teilo beubi cide mipuibe da teigai ciak maisia. <verse eid="NUM 5:30" /><verse number="31" style="v" sid="NUM 5:31" />Mipeibe pe nau de cingkupei da ngngwa kegwang de ziemne pe mau gah dizie. Mipuibe pe mau bam liecai pe püt cide pa ne pung kerabe da.”<verse eid="NUM 5:31" /></para>
  <chapter eid="NUM 5" />
  <chapter number="6" style="c" sid="NUM 6" />
  <para style="s">Nazirite</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1" />RAMPAUBE Moses de mpau. Pa rang eh, <verse eid="NUM 6:1" /><verse number="2" style="v" sid="NUM 6:2" />“Israel minadung da ranggai lo. Penui dage rangbeu lu, ‘Mipei ge mede mipui ge RAMPAUBE da pekatei pecu teu ntsam keludau Naziritme keyi sampet le, <verse eid="NUM 6:2" /><verse number="3" style="v" sid="NUM 6:3" />pa pekatei pecu zau nah kengkieng zau gade kezeulu maisia. Pa zau nah kengkieng zau le teikelu kehiadui sak lak. Pa kubetsi dui gede sak lak mede rai mnwa kelu kubetsi mede kubetsi kekibe de tyeilak.<note caller="-" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="LUK 1:15">Luk. 1:15</ref></char></note> <verse eid="NUM 6:3" /><verse number="4" style="v" sid="NUM 6:4" />Pa a da la kemak tingkak de, pa kubetsi le tyei kelube magede tyeilak, petsi radung mede pe geudung le tei kelube de tyeilak.<verse eid="NUM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5" />Pe sampet gade camla kelatane, RAMPAUBE dade teu ntsam mpetdi kebam tingde canglu kemaktane pe peutam tai lak. Pecu RAMPAUBE dage teu ntsam di maisia. Pa pe peutam pungtie lu maisia.<verse eid="NUM 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 6:6" />RAMPAUBE dage pekatei pecu teu ntsam kebam tingkak de, pa ketsai pau tai nna kerabe ma. <verse eid="NUM 6:6" /><verse number="7" style="v" sid="NUM 6:7" />Pa pe pei, pe pui, pe sinabe, mede pe tipui tsaidi lie de penui ziemne pecu tei heradi kerabe ma. Ainzwa tei kecu kedanemene pa Tinggwang dage pecu teu ntsam bamlu, cide mileune pe peutam ketie de ngau kegai gade cilu la. <verse eid="NUM 6:7" /><verse number="8" style="v" sid="NUM 6:8" />Pa pecu teu ntsam kelatane pa mci bam, RAMPAUBE dade mci bam.<verse eid="NUM 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9" />Magade mige pe taiga de cimezing eh tsaidi nah pe peu tei mci pwakebam de teihera dicai, iciucai pecu tei mci kecu benai pe peu taidi maisia, lang henane benai pa pe peu taidi maisia. <verse eid="NUM 6:9" /><verse number="10" style="v" sid="NUM 6:10" />Lang hesetne benai pa tamhau kena mede ruipuine kena kengkwa paiki kimui ga cingkupei dage pwagwang beu maisia. <verse eid="NUM 6:10" /><verse number="11" style="v" sid="NUM 6:11" />Cingkupei nruine ket pwa kemau reca teibeu zie nah kedabe pwa keru ratak teibeu zie. Aide le pecu tei mci luzie kedanemene pa ketsai pau tai nna kedi ziemne mau kedine. Cipaunai pa pe peu teimci dai zie. <verse eid="NUM 6:11" /><verse number="12" style="v" sid="NUM 6:12" />Pa pecu tei mci kecu tingkak de RAMPAUBE dage pekatei pecu tei ntsam pwa bamlu maisia. Pa meurünseuna mmi ge kedi ge kemau ratak ziemne pwa gwang beulu maisia. Pecu teihera kedi dwa tingbadung de pei lakta, kedanemene pecu tei mci kelu de heradi delu.<verse eid="NUM 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13" />Aide Naziritme gu hezai ge pa pecu teu ntsam kelu tingde cangkedi dau. Pecu kengkwa paiki kimuiki ga ngngwa gwanglu maisia. <verse eid="NUM 6:13" /><verse number="14" style="v" sid="NUM 6:14" />Pa RAMPAUBE dage pe reca teugwang beu maisia. Pa zamra kemak meurünseuna mmi ge nage keru ratak ziemne teu gwanglu maisia. Pa zamra kemak meurünpuina mmi ge nage kemau reca ziemne teu gwanglu maisia. Pa zamra kemak meurünseu ge kangbau reca ziemne teu gwanglu maisia. <verse eid="NUM 6:14" /><verse number="15" style="v" sid="NUM 6:15" />Pa tsehi kai kemak tangku rak ge de teu gwanglu maisia, tokkui keyi maca le haincwet lwe teikelu tangku kwak, tsehi kai kemak tangku maca le keniak kelube, mei reca nah zau reca de si eh. <verse eid="NUM 6:15" /><verse number="16" style="v" sid="NUM 6:16" />Cingkupei cide RAMPAUBE dwaga teugwang beu maisia. Pa pe kemau reca nah keru ratak tei beulu maisia. <verse eid="NUM 6:16" /><verse number="17" style="v" sid="NUM 6:17" />Tsehi kai kemak tangku rak de teu eh, pa meurünseu ge ratak teibeu maisia, kangbau reca RAMPAUBE dage peu kecudau. Cingkupei mei nah zau reca de tei beulu maisia. <verse eid="NUM 6:17" /><verse number="18" style="v" sid="NUM 6:18" />Naziritme pei Tinggwang dade pecu teu ntsam kedi zasi gade kengkwa paiki kimuiki taiga de pe peu taidi maisia. Pa pe peu gade pe tam keulwe kangbau reca ratak ru kebam mi gage cide kaidi maisia. <verse eid="NUM 6:18" /><verse number="19" style="v" sid="NUM 6:19" />Cingkupei meurünseu bakwak swa kelu de, tsehi kai kemak tangku kwak kesiu ge pe rak gade, nah tangku kerepei ge tsehi si kemak keukwalu zie. Pa cide Naziritme pei pe peu tai kedi cai pe ba gage kai zie pecu teu ntsam kedi zasi gade. <verse eid="NUM 6:19" /><verse number="20" style="v" sid="NUM 6:20" />Cingkupei aidungde RAMPAUBE dwaga reca tei eh hetwa gaizie, cingkube ziemne kemci qwa ge, hetwa kegai pe hekakrak de si eh nah pe pi cingkupei ziemne pwa kepeu de. Cipaucai, Naziritme zau saklu buida.<verse eid="NUM 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 6:21" />Aide Naziritme ziemne hezai ge RAMPAUBE dage pe reca sampet kegaime pecu teu ntsam kedi ziemne. Ma keheibe de pa ha si lubui, dede pa pe sampet kegai de teicang bilu maisia, Naziritme hezai gade ngau kelu sampet de teicang lu kerane.’”<verse eid="NUM 6:21" /></para>
  <para style="s">Cingkume Samlam</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22" />RAMPAUBE Moses de mpau dai. Pa rang eh, <verse eid="NUM 6:22" /><verse number="23" style="v" sid="NUM 6:23" />“Aaron nah pe napeidung dage ranglo. Ainzwa ranglu, ‘Nnui Israel minadung de ainzwa eh samlam beulu. Nnui penuide ainzwa eh ranglu,<verse eid="NUM 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 6:24" />“RAMPAUBE de peu nnui samlam beulu nah nnui ma pielu.<verse eid="NUM 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 6:25" />RAMPAUBE de peu nnui dade pe zaiyi nah nnuide ngaunggia beulu.<verse eid="NUM 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 6:26" />RAMPAUBE de peu pe suiyi eh nnui de pielu nah nnuide lungciep peulu.”’<verse eid="NUM 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27" />Ainzwa eh penui a zi peu Israel minadung dage ci gailu kerabe. Iciulude Ih penuide samlam beu zie.”<verse eid="NUM 6:27" /></para>
  <chapter eid="NUM 6" />
  <chapter number="7" style="c" sid="NUM 7" />
  <para style="s">Paiki Teikemci Recadung</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1" />Moses reca paiki teicang kelu benai, pa cide keniaklu nah RAMPAUBE dage tei ntsam gaibeu, pe netdung pelane de ncüt eh. Pa recabam ziemne de nah pe netdung pelane de cide nzwa teilu. Pa cidungde keniaklu nah RAMPAUBE dage tei ntsam gaibeu. <verse eid="NUM 7:1" /><verse number="2" style="v" sid="NUM 7:2" />Cipau benai, Israel muiteumedung, penui paume kelakdung gu peuteumedung, ratakdung pwapeu gai. Mina aidungde heleuhdung de teuswa bam. Penui ne minadung pumpei kecu pie rengei bam. <verse eid="NUM 7:2" /><verse number="3" style="v" sid="NUM 7:3" />Penui penui gu recadung RAMPAUBE dwaga keugwang. Penui gumkelu bagi herok nah hetumseu kereiehkena keugwang. Penui muiteume hangna ziemne bagi ket ramcau keugwang, nah muiteume hangge ne hetumseu ramcau keugwang. Penui cidungde reca paiki dwa gade peu gai. <verse eid="NUM 7:3" /><verse number="4" style="v" sid="NUM 7:4" />Pecai RAMPAUBE Moses de mpau. Pa rang eh, <verse eid="NUM 7:4" /><verse number="5" style="v" sid="NUM 7:5" />“Recadung penui dade luulu nah mapeudung de kengkwa paiki ga keu heta teilu. Levimedung dage mapeudung pwapeu lu, penui hangge ge kecu dage penui ta ga teumai kesia rehi gade peulu.” <verse eid="NUM 7:5" /><verse number="6" style="v" sid="NUM 7:6" />Moses bagidung nah hetumseudung keulu, nah pa Levime dage cidungde pwapeu gai. <verse eid="NUM 7:6" /><verse number="7" style="v" sid="NUM 7:7" />Pa bagi kena nah hetumseu mdai pwa Gershon leuhme de peu, kedanemene penui ta ga teu maisia kedine. <verse eid="NUM 7:7" /><verse number="8" style="v" sid="NUM 7:8" />Cingkube Aaron napei Ithamar de peu pie rengei lu kera, pa bagi mdai nah hetumseu heset pwa Merari leuhme de peu. Penui ta ga teumai kesia ziemne pa ainzwa teigai. <verse eid="NUM 7:8" /><verse number="9" style="v" sid="NUM 7:9" />Dede pa Kohath leuhmedung de cidungde kette peu ma, kedanemene penui au kemci niadung tadung de ziemne zie penui penui hekeutu gage pungkera. <verse eid="NUM 7:9" /><verse number="10" style="v" sid="NUM 7:10" />Moses recabam keniak kecu benai muiteumedung penui madung recabam tei kemci gage pwapeu. Muiteumedung penui ratakdung recabam dwa gage peugai. <verse eid="NUM 7:10" /><verse number="11" style="v" sid="NUM 7:11" />RAMPAUBE Moses dage rang, “Muiteume hangge ge kecu penuikatei penui tingba benai riep gage recabam tei mci kera ziemne penui ratak pwapeu lu maisia.”<verse eid="NUM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 7:12" />Tingbazie raitu benai, Amminadad napei Nahshon, Judah leuh gade, pe ratak pwapeu gai. <verse eid="NUM 7:12" /><verse number="13" style="v" sid="NUM 7:13" />Pe ratak becai rangkanggeu kwakkiem ket perüt shekel 130 nah rangkanggeu kwakgwa ket perüt shekel riakhena, cide kemcibam gu shekel rüt rehi gade. Mania aipau kena de ga maca le haikelu tokkui le puibam meitsi ratak teilu kerane. <verse eid="NUM 7:13" /><verse number="14" style="v" sid="NUM 7:14" />Pa kecak li ket peu perüt shekel kerei nah marim kehengui le puibam. <verse eid="NUM 7:14" /><verse number="15" style="v" sid="NUM 7:15" />Pa hetumseu keceu nage ket, meurünseu ket, nah mmige kedibe meurünna peseu ket teu eh keru ratak tei pwapeu. <verse eid="NUM 7:15" /><verse number="16" style="v" sid="NUM 7:16" />Pa hemeuseu ket teu eh kemau reca teibeu. <verse eid="NUM 7:16" /><verse number="17" style="v" sid="NUM 7:17" />Pa hetumseu kena, meurünseu mengei, hemeuseu mengei, nah meurünna mmige kedibe peseu mengei, kengkwa reca ziemne ratak tei pwapeu. Aide Amminadad napei Nashon gu ratak.<verse eid="NUM 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 7:18" />Tingbazie langnane benai, Zuar napei Nathanel, Issachar leuhme muiteube, pe ratak tei pwapeu gai. <verse eid="NUM 7:18" /><verse number="19" style="v" sid="NUM 7:19" />Pe ratak becai rangkanggeu kwakkiem ket perüt shekel 130 nah rangkanggeu kwakgwa ket perüt shekel riakhena, cide kemcibam gu shekel rüt rehi gade. Mania aipau kena de ga maca le haikelu tokkui le puibam meitsi ratak teilu kerane. <verse eid="NUM 7:19" /><verse number="20" style="v" sid="NUM 7:20" />Pa de kecak li ket peu perüt shekel kerei, marim kehengui le pui eh. <verse eid="NUM 7:20" /><verse number="21" style="v" sid="NUM 7:21" />Pa hetumseu keceuge ket, meurünseu ket, nah mmige kedibe meurünna peseu ket teu eh keru ratak tei pwapeu. <verse eid="NUM 7:21" /><verse number="22" style="v" sid="NUM 7:22" />Pa hemeuseu ket teu eh kemau reca tei pwapeu. <verse eid="NUM 7:22" /><verse number="23" style="v" sid="NUM 7:23" />Pa hetumseu kena, meurünseu mengei, hemeuseu mengei, nah meurünna mmige kedibe peseu mengei, kengkwa reca ziemne ratak tei pwapeu. Aide Zuar napei Nathanel gu ratak.<verse eid="NUM 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 7:24" />Tingbazie langcumne benai, Helon napei Eliab, Zebulun leuhme muiteube, pe ratak tei pwapeu. <verse eid="NUM 7:24" /><verse number="25" style="v" sid="NUM 7:25" />Pe ratak becai rangkanggeu kwakkiem ket perüt shekel 130 nah rangkanggeu kwakgwa ket perüt shekel riakhena, cide kemcibam gu shekel rüt rehi gade. Mania aipau kena de ga maca le haikelu tokkui le puibam meitsi ratak teilu kerane. <verse eid="NUM 7:25" /><verse number="26" style="v" sid="NUM 7:26" />Pa de kecak li ket peu perüt shekel kerei, marim kehengui le pui eh. <verse eid="NUM 7:26" /><verse number="27" style="v" sid="NUM 7:27" />Pa hetumseu keceuge ket, meurünseu ket, nah mmige kedibe meurünna peseu ket teu eh keru ratak tei pwapeu. <verse eid="NUM 7:27" /><verse number="28" style="v" sid="NUM 7:28" />Pa hemeuseu ket teu eh kemau reca tei pwapeu. <verse eid="NUM 7:28" /><verse number="29" style="v" sid="NUM 7:29" />Pa hetumseu kena, meurünseu mengei, hemeuseu mengei, nah meurünna mmige kedibe peseu mengei, kengkwa reca ziemne ratak tei pwapeu. Aide Helon napei Eliab gu ratak.<verse eid="NUM 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 7:30" />Tingbazie langmdaine benai, Shedeur napei Elizur, Reuben leuhme muiteube, pe ratak tei pwapeu. <verse eid="NUM 7:30" /><verse number="31" style="v" sid="NUM 7:31" />Pe ratak becai rangkanggeu kwakkiem ket perüt shekel 130 nah rangkanggeu kwakgwa ket perüt shekel riakhena, cide kemcibam gu shekel rüt rehi gade. Mania aipau kena de ga maca le haikelu tokkui le puibam meitsi ratak teilu kerane. <verse eid="NUM 7:31" /><verse number="32" style="v" sid="NUM 7:32" />Pa de kecak li ket peu perüt shekel kerei, marim kehengui le pui eh. <verse eid="NUM 7:32" /><verse number="33" style="v" sid="NUM 7:33" />Pa hetumseu keceuge ket, meurünseu ket, nah mmige kedibe meurünna peseu ket teu eh keru ratak tei pwapeu. <verse eid="NUM 7:33" /><verse number="34" style="v" sid="NUM 7:34" />Pa hemeuseu ket teu eh kemau reca tei pwapeu. <verse eid="NUM 7:34" /><verse number="35" style="v" sid="NUM 7:35" />Pa hetumseu kena, meurünseu mengei, hemeuseu mengei, nah meurünna mmige kedibe peseu mengei, kengkwa reca ziemne ratak tei pwapeu. Aide Shedeur napei Elizur gu ratak.<verse eid="NUM 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 7:36" />Tingbazie langmengeine benai, Zurishaddai napei Shelumiel, Simeon leuhme muiteube, pe ratak tei pwapeu. <verse eid="NUM 7:36" /><verse number="37" style="v" sid="NUM 7:37" />Pe ratak becai rangkanggeu kwakkiem ket perüt shekel 130 nah rangkanggeu kwakgwa ket perüt shekel riakhena, cide kemcibam gu shekel rüt rehi gade. Mania aipau kena de ga maca le haikelu tokkui le puibam meitsi ratak teilu kerane. <verse eid="NUM 7:37" /><verse number="38" style="v" sid="NUM 7:38" />Pa de kecak li ket peu perüt shekel kerei, marim kehengui le pui eh. <verse eid="NUM 7:38" /><verse number="39" style="v" sid="NUM 7:39" />Pa hetumseu keceuge ket, meurünseu ket, nah mmige kedibe meurünna peseu ket teu eh keru ratak tei pwapeu. <verse eid="NUM 7:39" /><verse number="40" style="v" sid="NUM 7:40" />Pa hemeuseu ket teu eh kemau reca tei pwapeu. <verse eid="NUM 7:40" /><verse number="41" style="v" sid="NUM 7:41" />Pa hetumseu kena, meurünseu mengei, hemeuseu mengei, nah meurünna mmige kedibe peseu mengei, kengkwa reca ziemne ratak tei pwapeu. Aide Zurishaddai napei Shelumiel gu ratak.<verse eid="NUM 7:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 7:42" />Tingbazie langherokne benai, Deuel napei Eliasaph, Gad leuhme muiteube, pe ratak tei pwapeu. <verse eid="NUM 7:42" /><verse number="43" style="v" sid="NUM 7:43" />Pe ratak becai rangkanggeu kwakkiem ket perüt shekel 130 nah rangkanggeu kwakgwa ket perüt shekel riakhena, cide kemcibam gu shekel rüt rehi gade. Mania aipau kena de ga maca le haikelu tokkui le puibam meitsi ratak teilu kerane. <verse eid="NUM 7:43" /><verse number="44" style="v" sid="NUM 7:44" />Pa de kecak li ket peu perüt shekel kerei, marim kehengui le pui eh. <verse eid="NUM 7:44" /><verse number="45" style="v" sid="NUM 7:45" />Pa hetumseu keceuge ket, meurünseu ket, nah mmige kedibe meurünna peseu ket teu eh keru ratak tei pwapeu. <verse eid="NUM 7:45" /><verse number="46" style="v" sid="NUM 7:46" />Pa hemeuseu ket teu eh kemau reca tei pwapeu. <verse eid="NUM 7:46" /><verse number="47" style="v" sid="NUM 7:47" />Pa hetumseu kena, meurünseu mengei, hemeuseu mengei, nah meurünna mmige kedibe peseu mengei, kengkwa reca ziemne ratak tei pwapeu. Aide Deuel napei Eliasaph gu ratak.<verse eid="NUM 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 7:48" />Tingbazie langhenane benai, Ammihud napei Elishama, Ephraim leuhme muiteube, pe ratak tei pwapeu. <verse eid="NUM 7:48" /><verse number="49" style="v" sid="NUM 7:49" />Pe ratak becai rangkanggeu kwakkiem ket perüt shekel 130 nah rangkanggeu kwakgwa ket perüt shekel riakhena, cide kemcibam gu shekel rüt rehi gade. Mania aipau kena de ga maca le haikelu tokkui le puibam meitsi ratak teilu kerane. <verse eid="NUM 7:49" /><verse number="50" style="v" sid="NUM 7:50" />Pa de kecak li ket peu perüt shekel kerei, marim kehengui le pui eh. <verse eid="NUM 7:50" /><verse number="51" style="v" sid="NUM 7:51" />Pa hetumseu keceuge ket, meurünseu ket, nah mmige kedibe meurünna peseu ket teu eh keru ratak tei pwapeu. <verse eid="NUM 7:51" /><verse number="52" style="v" sid="NUM 7:52" />Pa hemeuseu ket teu eh kemau reca tei pwapeu. <verse eid="NUM 7:52" /><verse number="53" style="v" sid="NUM 7:53" />Pa hetumseu kena, meurünseu mengei, hemeuseu mengei, nah meurünna mmige kedibe peseu mengei, kengkwa reca ziemne ratak tei pwapeu. Aide Ammihud napei Elishama gu ratak.<verse eid="NUM 7:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 7:54" />Tingbazie langhesetne benai, Pedahzur napei Gamaliel, Manasseh leuhme muiteu, pe ratak tei pwapeu. <verse eid="NUM 7:54" /><verse number="55" style="v" sid="NUM 7:55" />Pe ratak becai rangkanggeu kwakkiem ket perüt shekel 130 nah rangkanggeu kwakgwa ket perüt shekel riakhena, cide kemcibam gu shekel rüt rehi gade. Mania aipau kena de ga maca le haikelu tokkui le puibam meitsi ratak teilu kerane. <verse eid="NUM 7:55" /><verse number="56" style="v" sid="NUM 7:56" />Pa de kecak li ket peu perüt shekel kerei, marim kehengui le pui eh. <verse eid="NUM 7:56" /><verse number="57" style="v" sid="NUM 7:57" />Pa hetumseu keceuge ket, meurünseu ket, nah mmige kedibe meurünna peseu ket teu eh keru ratak tei pwapeu. <verse eid="NUM 7:57" /><verse number="58" style="v" sid="NUM 7:58" />Pa hemeuseu ket teu eh kemau reca tei pwapeu. <verse eid="NUM 7:58" /><verse number="59" style="v" sid="NUM 7:59" />Pa hetumseu kena, meurünseu mengei, hemeuseu mengei, nah meurünna mmige kedibe peseu mengei, kengkwa reca ziemne ratak tei pwapeu. Aide Pedahzur napei Gamaliel gu ratak.<verse eid="NUM 7:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="NUM 7:60" />Tingbazie langhekuine benai, Gideoni napei Abidan, Benjamin leuhme gu muiteube, pe ratak tei pwapeu. <verse eid="NUM 7:60" /><verse number="61" style="v" sid="NUM 7:61" />Pe ratak becai rangkanggeu kwakkiem ket perüt shekel 130 nah rangkanggeu kwakgwa ket perüt shekel riakhena, cide kemcibam gu shekel rüt rehi gade. Mania aipau kena de ga maca le haikelu tokkui le puibam meitsi ratak teilu kerane. <verse eid="NUM 7:61" /><verse number="62" style="v" sid="NUM 7:62" />Pa de kecak li ket peu perüt shekel kerei, marim kehengui le pui eh. <verse eid="NUM 7:62" /><verse number="63" style="v" sid="NUM 7:63" />Pa hetumseu keceuge ket, meurünseu ket, nah mmige kedibe meurünna peseu ket teu eh keru ratak tei pwapeu. <verse eid="NUM 7:63" /><verse number="64" style="v" sid="NUM 7:64" />Pa hemeuseu ket teu eh kemau reca tei pwapeu. <verse eid="NUM 7:64" /><verse number="65" style="v" sid="NUM 7:65" />Pa hetumseu kena, meurünseu mengei, hemeuseu mengei, nah meurünna mmige kedibe peseu mengei, kengkwa reca ziemne ratak tei pwapeu. Aide Gideoni napei Abidan gu ratak.<verse eid="NUM 7:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="NUM 7:66" />Tingbazie ziangrei benai, Ammishaddai napei Ahiezer, Dan leuhme gu muiteube, pe ratak tei pwapeu. <verse eid="NUM 7:66" /><verse number="67" style="v" sid="NUM 7:67" />Pe ratak becai rangkanggeu kwakkiem ket perüt shekel 130 nah rangkanggeu kwakgwa ket perüt shekel riakhena, cide kemcibam gu shekel rüt rehi gade. Mania aipau kena de ga maca le haikelu tokkui le puibam meitsi ratak teilu kerane. <verse eid="NUM 7:67" /><verse number="68" style="v" sid="NUM 7:68" />Pa de kecak li ket peu perüt shekel kerei, marim kehengui le pui eh. <verse eid="NUM 7:68" /><verse number="69" style="v" sid="NUM 7:69" />Pa hetumseu keceuge ket, meurünseu ket, nah mmige kedibe meurünna peseu ket teu eh keru ratak tei pwapeu. <verse eid="NUM 7:69" /><verse number="70" style="v" sid="NUM 7:70" />Pa hemeuseu ket teu eh kemau reca tei pwapeu. <verse eid="NUM 7:70" /><verse number="71" style="v" sid="NUM 7:71" />Pa hetumseu kena, meurünseu mengei, hemeuseu mengei, nah meurünna mmige kedibe peseu mengei, kengkwa reca ziemne ratak tei pwapeu. Aide Ammishaddai napei Ahiezer gu ratak.<verse eid="NUM 7:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="NUM 7:72" />Tingbazie ziangreiket benai, Okran napei Pagiel, Asher leuhme gu muiteube, pe ratak tei pwapeu. <verse eid="NUM 7:72" /><verse number="73" style="v" sid="NUM 7:73" />Pe ratak becai rangkanggeu kwakkiem ket perüt shekel 130 nah rangkanggeu kwakgwa ket perüt shekel riakhena, cide kemcibam gu shekel rüt rehi gade. Mania aipau kena de ga maca le haikelu tokkui le puibam meitsi ratak teilu kerane. <verse eid="NUM 7:73" /><verse number="74" style="v" sid="NUM 7:74" />Pa de kecak li ket peu perüt shekel kerei, marim kehengui le pui eh. <verse eid="NUM 7:74" /><verse number="75" style="v" sid="NUM 7:75" />Pa hetumseu keceuge ket, meurünseu ket, nah mmige kedibe meurünna peseu ket teu eh keru ratak tei pwapeu. <verse eid="NUM 7:75" /><verse number="76" style="v" sid="NUM 7:76" />Pa hemeuseu ket teu eh kemau reca tei pwapeu. <verse eid="NUM 7:76" /><verse number="77" style="v" sid="NUM 7:77" />Pa hetumseu kena, meurünseu mengei, hemeuseu mengei, nah meurünna mmige kedibe peseu mengei, kengkwa reca ziemne ratak tei pwapeu. Aide Okran napei Pagiel gu ratak.<verse eid="NUM 7:77" /></para>
  <para style="p">
    <verse number="78" style="v" sid="NUM 7:78" />Tingbazie ziangreikena benai, Enan napei Ahira, Naphtalime leuhme muiteube, pe ratak tei pwapeu. <verse eid="NUM 7:78" /><verse number="79" style="v" sid="NUM 7:79" />Pe ratak becai rangkanggeu kwakkiem ket perüt shekel 130 nah rangkanggeu kwakgwa ket perüt shekel riakhena, cide kemcibam gu shekel rüt rehi gade. Mania aipau kena de ga maca le haikelu tokkui le puibam meitsi ratak teilu kerane. <verse eid="NUM 7:79" /><verse number="80" style="v" sid="NUM 7:80" />Pa de kecak li ket peu perüt shekel kerei, marim kehengui le pui eh. <verse eid="NUM 7:80" /><verse number="81" style="v" sid="NUM 7:81" />Pa hetumseu keceuge ket, meurünseu ket, nah mmige kedibe meurünna peseu ket teu eh keru ratak tei pwapeu. <verse eid="NUM 7:81" /><verse number="82" style="v" sid="NUM 7:82" />Pa hemeuseu ket teu eh kemau reca tei pwapeu. <verse eid="NUM 7:82" /><verse number="83" style="v" sid="NUM 7:83" />Pa hetumseu kena, meurünseu mengei, hemeuseu mengei, nah meurünna mmige kedibe peseu mengei, kengkwa reca ziemne ratak tei pwapeu. Aide Enan napei Ahira gu ratak.<verse eid="NUM 7:83" /></para>
  <para style="p">
    <verse number="84" style="v" sid="NUM 7:84" />Moses recabam keniak kecu benai Israel muiteumedung aidungde pelane teu ntsam lu. Penui rangkanggeu kwakkiem kereiehkena, rangkanggeu kwakgwa kereiehkena, nah kecak lidung kereiehkena keu ntsam lu. <verse eid="NUM 7:84" /><verse number="85" style="v" sid="NUM 7:85" />Rangkanggeu kwakkiem ket le perüt shekel 130 nah kwakgwa ket le perüt shekel riakhena. Rangkanggeu kwak pelane le perüt shekel 2,400, cide kemcibam gu shekel rüt rehi gade. <verse eid="NUM 7:85" /><verse number="86" style="v" sid="NUM 7:86" />Kecak lidung kereiehkena gade ket, marim kehengui le pui kebam, perüt shekel kerei kemcibam gu shekel rüt rehi gade. Kecak lidung pelane le perüt shekel 120. <verse eid="NUM 7:86" /><verse number="87" style="v" sid="NUM 7:87" />Penui keru ratak ziemne makaune pelane keu ntsam lu, hetumseu kereiehkena, meurünseu kereiehkena, mmige kedibe meurünna peseu kereiehkena. Penui penui gu meitsi mapeu ratak pwapeu. Penui hemeuseu kereiehkena kemau reca ziemne pwapeu. <verse eid="NUM 7:87" /><verse number="88" style="v" sid="NUM 7:88" />Penui gu hetumseudung pelane gade, penui hetumseu ngkaiemdai, meurünseu riakherok, hemeuseu riakherok, nah mmige kedibe meurünna peseu riakherok pwa ngkwabe mapeu ziemne ratak teilu. Aide recabam keniak kelu cai tei mci kelu ta ziemne teilu. <verse eid="NUM 7:88" /><verse number="89" style="v" sid="NUM 7:89" />Moses kengkwa paiki ga Pecu mpau kera lüt kecudau, pa makwa ge siu pecu mpau eh kezuyi bam reu gade zierang ketei samkakbung kebam gade, cherubim kena kakgade, cine pa pecu mpau.<verse eid="NUM 7:89" /></para>
  <chapter eid="NUM 7" />
  <chapter number="8" style="c" sid="NUM 8" />
  <para style="s">Mitaubung Henadung Teikelu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1" />RAMPAUBE Moses de mpau. Pa rang eh, <verse eid="NUM 8:1" /><verse number="2" style="v" sid="NUM 8:2" />“Aaron de mpau lo. Pecu rang beulu, ‘Mitaubung bunghena mitaubungbam dwa gage kebaa peu maisia nang cidungde ntau kegaidau.’” <verse eid="NUM 8:2" /><verse number="3" style="v" sid="NUM 8:3" />Aaron aide teilu. Pa mitaubung ntau pwa mitaubungbam dwa gage kebaa peulu kera ntaugai, RAMPAUBE Moses dage aja kai kebeube nzwa. <verse eid="NUM 8:3" /><verse number="4" style="v" sid="NUM 8:4" />Mitaubungbam aipau rehi nzwa teilu nah RAMPAUBE Moses dage perehi keulia kebeu nzwa. Cide kecak le pesing gade pepeu kecang dap kerabe, hedeu kelu piak pepaa pa kecube nzwa de si eh.<verse eid="NUM 8:4" /></para>
  <para style="s">Levime de keutsam kelu</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5" />RAMPAUBE Moses de mpau dai. Pa rang eh, <verse eid="NUM 8:5" /><verse number="6" style="v" sid="NUM 8:6" />Israelmedung kakga de Levimedung de ngngwa lwe penuide teimci lu. <verse eid="NUM 8:6" /><verse number="7" style="v" sid="NUM 8:7" />Penuide tei mci kerane ainzwa tei lu: Teikemmci dui penui dage kezin gai. Penuide peu penui pum pelane taidi lo, penui paini hetaa di, nah ainzwa eh penuide teimci lu. <verse eid="NUM 8:7" /><verse number="8" style="v" sid="NUM 8:8" />Iciu eh peu penuide hetumseuna ge keulu nah meitsi reca tokkui keyibe maca gage hai ncüt kelube keulu. Peu penuide hetumseuna kedage keulu kemau reca tei kera ziemne. <verse eid="NUM 8:8" /><verse number="9" style="v" sid="NUM 8:9" />Nang Levimedung de kengkwa paiki dwaga ngngwa gwang luzie nah Israel leuhmedung pelane de teu ngkwalu. <verse eid="NUM 8:9" /><verse number="10" style="v" sid="NUM 8:10" />Nang Levimedung de RAMPAUBE dwaga ngngwa gwang keludau, Israelmedung penui ba hwapwa Levimedung reu gage kaigai lu maisia. <verse eid="NUM 8:10" /><verse number="11" style="v" sid="NUM 8:11" />Aaron ne Levimedung de pwa RAMPAUBE dage peulu maisia, Israelme dade mapeu ratak ge kenzwa ge zie iciu eh penui RAMPAUBE ta teilu kerane. <verse eid="NUM 8:11" /><verse number="12" style="v" sid="NUM 8:12" />Levimedung penui ba hwapwa hetumseu peudung gage kailu maisia. Nang hetumseu ket kemau reca tei kera ziemne pwapeu maisia nah keda tumseu be a dage keru ratak ziemne, Levime de teimci lu kerane. <verse eid="NUM 8:12" /><verse number="13" style="v" sid="NUM 8:13" />Levimedung de Aaron nah pe namedung dwaga ngngwa gwang gaibeu lu, nah penuide teucuh pwa a dage mapeu ratak tei eh peulu.<verse eid="NUM 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 8:14" />Ainzwa eh nang Israelmedung kakgade Levimedung de teu ntsamlu. Levimedung agu dizie. <verse eid="NUM 8:14" /><verse number="15" style="v" sid="NUM 8:15" />Cipaucai, Levimedung kengkwa paiki ga mata tei kerane gwang zie. Nang penuide teimci lu maisia. Nang penuide pwapeu maisia mapeu ratak nzwa. <verse eid="NUM 8:15" /><verse number="16" style="v" sid="NUM 8:16" />Aide teilu, kedanemene Israelme kakgade penui au agu rünne dida. Penui hena mipei mna raitu kelube leune bam leu luzie, Israel leuhme pelane mipei neraibe. Levimedung de akatei agu kera Ih luulu da. <verse eid="NUM 8:16" /><verse number="17" style="v" sid="NUM 8:17" />Israelme kakga de neraibe pelane agu, mina de nah makaune de. Ih Egypt gade neraibe pelane teilung keuteu kedi benai gade, Ih penuide akatei a ziemne keu ntsam luda. <verse eid="NUM 8:17" /><verse number="18" style="v" sid="NUM 8:18" />Ih neraibedung pelane keleu gade Levimedung de Israelmedung kakgade keulu da. <verse eid="NUM 8:18" /><verse number="19" style="v" sid="NUM 8:19" />Ih Levimedung de pwa Aaron nah pe napeidung de mapeu ge nzwa peu dida. Ih penuide Israelmedung kakga de ngngwa pwa kengkwa paiki ga Israelme ziemne makam tei kera luulu da. Ih penuide Israelmedung de teimci lu kera pwapeu dida, iciu eh penui kemci ni ga gwang kenna daude penuide mateei gene de tei rezamdi kelakne.”<verse eid="NUM 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 8:20" />Moses, Aaron nah Israel leuhme pelane de ainzwa eh Levime dage teigai. RAMPAUBE Moses dage Levime ziemne aja kaikebeu leune penui teilu. Israelmedung penui dage aide teigai lu. <verse eid="NUM 8:20" /><verse number="21" style="v" sid="NUM 8:21" />Levimedung penuide teimci lu nah penui paini hetaa lu, nah iciu eh Aaron penuide RAMPAUBE dage mapeu ratak tei eh pwapeu nah pa penuide tei mci lu kera ziemne kemci ta penui ziemne teilu. <verse eid="NUM 8:21" /><verse number="22" style="v" sid="NUM 8:22" />Cipau cai, Levimedung Aaron dwa gade nah pe napeimedung dwa gade kengkwa paiki ga penui ta tei kera gwanglu. Aide RAMPAUBE Moses dage Levime ziemne aja kaikebeu nzwa da. Penui Levimedung pelane de aipau rehi gade teilu.<verse eid="NUM 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23" />RAMPAUBE Moses de mpau dai. Pa rang eh, <verse eid="NUM 8:23" /><verse number="24" style="v" sid="NUM 8:24" />“Aidungde pekiene de Levimedung mmi ngkaiemengei nah penreule kedime ziemne lie. Penui kengkwa paiki maa ga heta tei kera ncütlu maisia. <verse eid="NUM 8:24" /><verse number="25" style="v" sid="NUM 8:25" />Ainzwa eh penui mmi riakngei dicai penui ta gade mtaklu maisia. Penui cipau heuge dicai penui makam teisi talu maisia. <verse eid="NUM 8:25" /><verse number="26" style="v" sid="NUM 8:26" />Penui penui sinamedung kengkwa paiki ga heta tei kebamme de kengha lubui, dede penui au heta teisi talu maisia. Nang aipau hadung de Levime dage saulia beu maisia.”<verse eid="NUM 8:26" /></para>
  <chapter eid="NUM 8" />
  <chapter number="9" style="c" sid="NUM 9" />
  <para style="s">Kahkegwang Ngyi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1" />RAMPAUBE tingkum pekenabe hekei raitube kei Egyptme deu gade Israelme mpet kelu cai Sinai hetaideu gade Moses de mpau. Pa rang eh, <verse eid="NUM 9:1" /><verse number="2" style="v" sid="NUM 9:2" />“Israelmedung de Kahkegwangngyi peu mneilu tingkum gade peting riet pwa kebam ga. <verse eid="NUM 9:2" /><verse number="3" style="v" sid="NUM 9:3" />Aipau kei ziangreiehmdai benai, tinghegi dau, nnui Kahkegwangngyi mneilu tingkum gade peting riet pwakebam ga. Nnui cide mneilu maisia, hengyi zai pelane mzui lu, nah cide de riangkeu kenzeu hezaidung pelane mzailu.” <verse eid="NUM 9:3" /><verse number="4" style="v" sid="NUM 9:4" />Cine, Moses Israelmedung dage rangbeu Kahkegwangngyi Hengyi aide mneilu maisia lie kecu. <verse eid="NUM 9:4" /><verse number="5" style="v" sid="NUM 9:5" />Cine penui Kahkegwangngyi hekei raitube kei mneilu, hekeizie ziangreiehmdai benai, tinghegi dau, Sinai hetaideu gade. Moses dage RAMPAUBE ne tei lulo aja kaikebeu pelane Israelme mzailu. <verse eid="NUM 9:5" /><verse number="6" style="v" sid="NUM 9:6" />Cika midungge ketsaipaudung ge ziemne mci kemak ge bamdi. Cipau benai penui Kahkegwangngyi de mnei gailak di. Cine penui cipau benai Moses penai Aaron da mie. <verse eid="NUM 9:6" /><verse number="7" style="v" sid="NUM 9:7" />Cipau peidung de Moses dage rang eh cu, “Mi ketsaipau ge ziemne anui mci meda. Dai ziemne anuide Israelme kakgade tingkum gade peting riet pwakebam ga RAMPAUBE dage ratak ketei reca gade kai ntsam dino?” <verse eid="NUM 9:7" /><verse number="8" style="v" sid="NUM 9:8" />Moses penui dage rang, “Acu kwalu, RAMPAUBE dade nnui daitei maisia bi peu acu kingnei lu kera ziemne.”<verse eid="NUM 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9" />RAMPAUBE Moses de mpau. Pa rang eh, <verse eid="NUM 9:9" /><verse number="10" style="v" sid="NUM 9:10" />“Israelmedung dage ranggai lo. Rangbeu lu, ‘Magade nnui migede mede nnui leuhmedung liede ketsaipau ge ziemne mci mene bam liecai, mede hebeu kemdei ge teila liede, pa RAMPAUBE dage Kahkegwangngyi mnei gai lubui bamreu.’ <verse eid="NUM 9:10" /><verse number="11" style="v" sid="NUM 9:11" />Kei na bekei ziangreiehmdai benai tinghegi, penui Kahkegwangngyi taktyei tyei zie. Penui Kahkegwangngyi meurünna tyei zie tsehi kai mene tangku tei kelube gage nah ginei keka gage. <verse eid="NUM 9:11" /><verse number="12" style="v" sid="NUM 9:12" />Penui tingcang di kemakta cide kette pütdi kerabe ma, mede pera kette tei tsumdi kerabe ma. Penui Kahkegwangngyi zai pelane mzailu maisia.<note caller="-" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="JHN 19:36">Jhn. 19:36</ref></char></note> <verse eid="NUM 9:12" /><verse number="13" style="v" sid="NUM 9:13" />Dede keheibe de caugame mci bam nah hebeu de tei mene bam, dede Kahkegwangngyi mnei lu medi bi, cipaume de au pe leuhmedung dade keu mpetdi maisia kedanemene pa RAMPAUBE teumai kesia ratak tingkum gade riet kelu tingsiak dau pwapeu lu kemakne. Mina aide pemau püt punglu maisia. <verse eid="NUM 9:13" /><verse number="14" style="v" sid="NUM 9:14" />Magade mi sangme ge nnui kakga lunghbam nah pa RAMPAUBE dage Kahkegwangngyi mnei bam cai, pa cide Kahkegwangngyi zaidung tei siakte lwe mnei maisia nah hezai sie rehi mzui lu maisia. Nnui sangme ziemne de nah hangdeu cikade mna kelume ziemne hezai ket lu maisia.”<verse eid="NUM 9:14" /></para>
  <para style="s">Paiki Reuga Hemwa</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15" />Reca paiki lim kelu tingba benai, hemwa ne reca paiki, hezai samkakkelu paiki, cide gumlu. Tinghegi dige hemwa reca paiki reu bamdi. Tingcang kemaktane cide mi nzwa eh ngau di. <verse eid="NUM 9:15" /><verse number="16" style="v" sid="NUM 9:16" />Cide cipau lui eh bam jüja di. Hemwa reca paiki gumlu nah tingmui mi nzwa eh cide ngaudi. <verse eid="NUM 9:16" /><verse number="17" style="v" sid="NUM 9:17" />Hemwa cide paiki reu gade keucuh dige, Israelme nadung penui beu tei tet lula. Hemwa daiga ge mtakdi labi cika minadung ramzeuki tei lula. <verse eid="NUM 9:17" /><verse number="18" style="v" sid="NUM 9:18" />RAMPAUBE aja kaikebeu rehi gade, Israelmedung penui beu teila, nah pe aja kangga de, penui ramzeuki tei lula. Reca paiki reu ga hemwa kebamtane, penui penui ramzeuki ga bam dila. <verse eid="NUM 9:18" /><verse number="19" style="v" sid="NUM 9:19" />Hemwa reca paiki ga tingbazie kekieege bamdi de, Israelmedung RAMPAUBE ne rang kebeu de mzai lula nah hebeu tei tadi la. <verse eid="NUM 9:19" /><verse number="20" style="v" sid="NUM 9:20" />Madauge hemwa reca paiki reu ga tingbazie kecamnage bam gailwe tadi la. Cikenzwa dau, penui RAMPAUBE aja de mzai lula, penui ramzeuki telei lula nah pecai hebeu teidai lula pe aja mzai eh. <verse eid="NUM 9:20" /><verse number="21" style="v" sid="NUM 9:21" />Madauge hemwa ramzeuki ga tinghegi gade tingcang kecang bamla. Tingcang hemwa nghang dige, penui hebeu teicuh dila. Magade cide langnai ge nah zeuziu ge ziemne bamsi di de, hemwa nghang kedi caine penui hebeu teicuh zie. <verse eid="NUM 9:21" /><verse number="22" style="v" sid="NUM 9:22" />Hemwa langnane, pekei, mede pemmi reca paiki ga bam dini, cide cika kebamtane, Israelmedung penui ramzeuki ga bamdi la nah hebeu tei tadi la. Dede hemwa nghang kedi dau, penui tetpet la penui beu ga. <verse eid="NUM 9:22" /><verse number="23" style="v" sid="NUM 9:23" />Penui RAMPAUBE aja gade ramzeuki teilwe bamla, nah penui pe aja gade hebeu teila. Penui RAMPAUBE ne Moses dage kaikebeu aja de mzai lu.<verse eid="NUM 9:23" /></para>
  <chapter eid="NUM 9" />
  <chapter number="10" style="c" sid="NUM 10" />
  <para style="s">Rangkanggeu Telui</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1" />RAMPAUBE Moses de mpau. Pa rang eh, <verse eid="NUM 10:1" /><verse number="2" style="v" sid="NUM 10:2" />“Rangkanggeu telui kena teilu. Cide tei kerane rangkanggeu de kedeugai. Nang cipau teluidung heleuhbe de qu hekwa kecudau teulu maisia nah penui gu paikidung deuli keradau heleuhbe de qulu kerane. <verse eid="NUM 10:2" /><verse number="3" style="v" sid="NUM 10:3" />Cingkumedung heleuhbe de qu hekwa pwa ngkwa kela paiki kimuiki ga n dwa gage peu ngkwalu kerane telui cide kwagai beu maisia. <verse eid="NUM 10:3" /><verse number="4" style="v" sid="NUM 10:4" />Magade cingkumedung telui ket rünne kwagai cai, muiteumedung, Israel gu pautsamedung gade peuketeume, n da gwang ngkwalu maisia. <verse eid="NUM 10:4" /><verse number="5" style="v" sid="NUM 10:5" />Nnui pekoa tsisüt kecu ge kwa kegaidau, naimiak kepetle ga kebam ramzeukidung penui beuhma ndeu lu maisia. <verse eid="NUM 10:5" /><verse number="6" style="v" sid="NUM 10:6" />Nnui pia pekenabe pekwa ketsi rehi tei eh kwagai kecudau, tingbangle kebam ramzeukidung penui beuhma ndeu lu maisia. Penui cide mütpwa pe kwa tsisüt liagai beu maisia penui beuhmadung ndeu lu kerane. <verse eid="NUM 10:6" /><verse number="7" style="v" sid="NUM 10:7" />Heleuhdung gwang ngkwa ncüt keludau, telui kwagai lu, dede pekwa tsi so. <verse eid="NUM 10:7" /><verse number="8" style="v" sid="NUM 10:8" />Aaron napeimedung, cingkube ne teluidung kwa maisia. Aide n ziemne n minadung gu ceheudung leune ga hezai ge lamui zie. <verse eid="NUM 10:8" /><verse number="9" style="v" sid="NUM 10:9" />Nnui deu ga ngauraume ne nnui de ketang kelame de hereu tei zielie pet kecudau, nnui telui teu eh nriaklu kera kwagai maisia. Ih, RAMPAUBE nnui Tinggwang, nnui de nsunglu eh nnuide nnui ngauraumedung dade kelilu zie. <verse eid="NUM 10:9" /><verse number="10" style="v" sid="NUM 10:10" />Nah nnui hengyidung hengyi kera tingdau, nnui hengyi mui kela ngyi gade nah pekei ndeu kecudau de, nnui gu keru reca reu gage nah ngkwa makai ratakdung reu gage teluidung kwagai maisia. Aide le pwane Ih nnui RAMPAUBE lie nsung heci kelu ge zie. Ih RAMPAUBE nnui Tinggwang.”<verse eid="NUM 10:10" /></para>
  <para style="s">Israelme Sinai Pütkedi</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11" />Tingkum pekenabe kum, kei na bekei, hekeizie ngkai benai, hezaidung samkak kelu paiki gade hemwa keucuh di. <verse eid="NUM 10:11" /><verse number="12" style="v" sid="NUM 10:12" />Israelmedung iciu eh Sinai hetaideu gade penui beuh tei tetdai. Hemwa cide Paran hetaideu ga mtakdi. <verse eid="NUM 10:12" /><verse number="13" style="v" sid="NUM 10:13" />Moses dage RAMPAUBE ne aja kaikebeu de nzui eh penui beuhma tei raitu lu. <verse eid="NUM 10:13" /><verse number="14" style="v" sid="NUM 10:14" />Judah leuhmedung pailim kangga kebam ramzeuki ne raitube tei eh tetpet, penuikatei penui nlibe gu reugwamaa ne tetcu. Nahshon, Amminadab napei ne Judah reugwame gu muiteube tei. <verse eid="NUM 10:14" /><verse number="15" style="v" sid="NUM 10:15" />Zuar napei Nethanel ne Issachar leuhmedung reugwamaa gu muiteube tei. <verse eid="NUM 10:15" /><verse number="16" style="v" sid="NUM 10:16" />Helon napei Eliab ne Zebulun leuhme reugwamaa gu muiteu tei. <verse eid="NUM 10:16" /><verse number="17" style="v" sid="NUM 10:17" />Paiki pie rengei bam kela Merari penai Gershon leuhmedung paiki ra nghung di delwe penui beuhma tei eh tetgai. <verse eid="NUM 10:17" /><verse number="18" style="v" sid="NUM 10:18" />Pecia, Reuben ramzeuki pailim kangga kebam reugwame penui beuhma tei eh tetgai. Elizur, Shedeur napei ne Reuben regwame gu muiteube tei. <verse eid="NUM 10:18" /><verse number="19" style="v" sid="NUM 10:19" />Zurishaddai napei Shelumiel ne Simeon leuhmedung gu reugwame muiteube tei. <verse eid="NUM 10:19" /><verse number="20" style="v" sid="NUM 10:20" />Deuel napei Eliasaph ne Gad leuhmedung gu reugwame muiteube tei. <verse eid="NUM 10:20" /><verse number="21" style="v" sid="NUM 10:21" />Kohathme tetcu gai. Penui kemci niadung punglwe tetpet. Kedamedung Kohathme ramzeuki peciabe ga gwang kemak dwa gage paiki pwacuh lula. <verse eid="NUM 10:21" /><verse number="22" style="v" sid="NUM 10:22" />Ephraim leuhme pailim kangga kebam reugwame pecai tetpet zie. Elishama, Ammihud napei ne Ephraimme gu reugwame muiteube tei. <verse eid="NUM 10:22" /><verse number="23" style="v" sid="NUM 10:23" />Pedahzur napei Gamaliel ne Manasseh leuhmedung gu reugwame muiteube tei. <verse eid="NUM 10:23" /><verse number="24" style="v" sid="NUM 10:24" />Gideoni napei Abidan ne Benjamin leuhmedung gu reugwame muiteube tei. <verse eid="NUM 10:24" /><verse number="25" style="v" sid="NUM 10:25" />Dan leuhmedung pailim kangga ramzeuki tei delwe kebam reugwamaame ne kamtube tei eh tetpet. Ammishaddai napei Ahiezer ne Dan leuhme gu reugwame muiteube tei. <verse eid="NUM 10:25" /><verse number="26" style="v" sid="NUM 10:26" />Okran napei Pagiel ne Asher leuhme gu regwame muiteube tei. <verse eid="NUM 10:26" /><verse number="27" style="v" sid="NUM 10:27" />Enan napei Ahira ne Naphtali leuhme gu reugwame muiteube tei. <verse eid="NUM 10:27" /><verse number="28" style="v" sid="NUM 10:28" />Ainzwa delwe Israelmedung gu reugwamedung penui beuhma tetpet. <verse eid="NUM 10:28" /><verse number="29" style="v" sid="NUM 10:29" />Moses Midiame Reuel napei Hobab de kempau. Reuel au Moses nau pei. Moses Hobab de kempau eh pe dade cu, “RAMPAUBE ne rangkebeu heni gage anui tetgai la. RAMPAUBE ranggai, ‘Ih nnui de cide peu zie.’ Anui caisui lwe gwang lulo nah anui ncu keyibe teibeu zie. RAMPAUBE Israelme de keyibe teibeu zielie sampet gai da.” <verse eid="NUM 10:29" /><verse number="30" style="v" sid="NUM 10:30" />Dede Hobab Moses dade cu, “Ih ncu ngngwa lwe tet lakta. Ih akatei a deu nah a leuhme da gwang dizie da.” <verse eid="NUM 10:30" /><verse number="31" style="v" sid="NUM 10:31" />Ge Moses pesam keli eh cu, “Ngaunggia eh anui de püt diso. Nang au dai nzwa eh hetaideu ga ramzeuki tei labi kecu nang ci. Nang anui maa pie la maisia. <verse eid="NUM 10:31" /><verse number="32" style="v" sid="NUM 10:32" />Magade nang anui de ngngwa tetlu liecai, RAMPAUBE anui dage keyi tei kebeu be siakte n dage anui de teibeu zie.” <verse eid="NUM 10:32" /><verse number="33" style="v" sid="NUM 10:33" />Penui RAMPAUBE lamlwatu ga langcumne beuhzie tei eh tet. RAMPAUBE samkakbung penui dwa langcumne tet nswa di penui mtaklu kera ni peei lu kerane. <verse eid="NUM 10:33" /><verse number="34" style="v" sid="NUM 10:34" />Tingba pet gaige penui mbeuh kela cika RAMPAUBE gu hemwa penui reu bamdi. <verse eid="NUM 10:34" /><verse number="35" style="v" sid="NUM 10:35" />Keheidaude samkakbung tetgai kecudau, Moses rangla, “Cuhlu, RAMPAUBO. N ngauraumedung de tei zangra di. Ncu ngaunghet kelame de n dade pakti kera teibeu lo.” <verse eid="NUM 10:35" /><verse number="36" style="v" sid="NUM 10:36" />Keheidaude liembe mtakdi kecudau, Moses rangla, “Cailigwanglo, RAMPAUBO, Israelme cangcang kekiee ge kebam ga.”<verse eid="NUM 10:36" /></para>
  <chapter eid="NUM 10" />
  <chapter number="11" style="c" sid="NUM 11" />
  <para style="s">RAMPAUBE dade Mi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1" />Cidau RAMPAUBE kingnei kebam dau minadung penui reidung rang eh ncam di. RAMPAUBE mina sam siu lwe pe rata di. RAMPAUBE dade mi gwang eh penui kakga heudi nah petule kebam ramzeuki kesa rudi. <verse eid="NUM 11:1" /><verse number="2" style="v" sid="NUM 11:2" />Ge minadung Moses de qu gai, cine Moses RAMPAUBE dage kekie tei, iciu eh miheu mtakdi. <verse eid="NUM 11:2" /><verse number="3" style="v" sid="NUM 11:3" />Heni cide Taberah de msiak lu, kedanemene RAMPAUBE gu mi penui kakgade heu kedine.<verse eid="NUM 11:3" /></para>
  <para style="s">RAMPAUBE dade Rekui</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 11:4" />Sangme mina kangge Israel leuhme de ngngwa ramzeuki ga ncüt cuhdi. Penui taktyei yiki kecube tyei neudi. Ge Israelmedung hap eh rang cuhdi, “Caune anuide heteihkang tyei kera peu lai? <verse eid="NUM 11:4" /><verse number="5" style="v" sid="NUM 11:5" />Anui Egypt gade heka tyei keneu leuh tyeibam kela, nah tanggaine, banggitsi, tangra, onion, nah simriadung tyei bam kela nsungbam. <verse eid="NUM 11:5" /><verse number="6" style="v" sid="NUM 11:6" />Cu au anui mui keyi de gah dida, kedanemene anui ngau kegai au manna rünne dida.” <verse eid="NUM 11:6" /><verse number="7" style="v" sid="NUM 11:7" />Manna au coriander tsira nzwa. Cide ngaukegai au resin nzwa. <verse eid="NUM 11:7" /><verse number="8" style="v" sid="NUM 11:8" />Minadung tet tegwa eh cide keu hekwa lula. Penui cide hepa gage tau la, tsukwa gage dapla, helidung gage swala, nah cide le tangku tei lula. Cide pengum olive ca keheci nzwa da. <verse eid="NUM 11:8" /><verse number="9" style="v" sid="NUM 11:9" />Tingmui ramzeuki ga hezin cakmie kecudau, manna de cakmie lala.<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="JHN 6:31">Jhn. 6:31</ref></char></note> <verse eid="NUM 11:9" /><verse number="10" style="v" sid="NUM 11:10" />Penui kilungmedung gade minadung hap kebam Moses siu, nah mipei leune de pe ramzeuki kimuiki ga bam. RAMPAUBE pe rata sütdi, nah Moses miakngau gade penui ncam kebamde petaulu tadi. <verse eid="NUM 11:10" /><verse number="11" style="v" sid="NUM 11:11" />Moses RAMPAUBE dage rang, “Daitei luge nang n kilabe dade mzai sia lano? Daitei luge nang acu nsuiyi lu mene bam no? Mina aidungde rei pungkera nang acu peu. <verse eid="NUM 11:11" /><verse number="12" style="v" sid="NUM 11:12" />Mina aidung pelane de Ih tetlak lu dini? Ih ne penuide mna gaibeu eh nang a dade ranglu kebui, ‘Mipei ge ngiena gede pwabam kela nzwa penuide n hekakrak gage pwa nna siak lu,’ de zie ni? Nang penui paume dage sampet tei kenzeu deu gage Ih penuide ngngwa gwang zieni? <verse eid="NUM 11:12" /><verse number="13" style="v" sid="NUM 11:13" />Ih dai gade mina aidung pelane de heteih peu kera ngau luzie no? Penui a dwa gade hap eh rangzeu, ‘Anui de heteih tyei kera peulo.’ <verse eid="NUM 11:13" /><verse number="14" style="v" sid="NUM 11:14" />Ih akatei ne mina aidung pelane pwet pung gailak. Penui au a ziemne kiee zu di. <verse eid="NUM 11:14" /><verse number="15" style="v" sid="NUM 11:15" />Nang a dade ainzwa mzai sia kelane, cu gage acu teitsetdi lo, magade n miakngau gade petau delie cai, peu acu keherei ngau di helo.” <verse eid="NUM 11:15" /><verse number="16" style="v" sid="NUM 11:16" />RAMPAUBE Moses dage rang eh cu, “Israel hangkiame riakhena a dage ngngwa gwang beulo. Penui hangkiame nah mina reu kedime bi maisia. Penuide ngkwa kela paiki ga ngngwa gwang ncu ngngwa sap lulo. <verse eid="NUM 11:16" /><verse number="17" style="v" sid="NUM 11:17" />Ih nghung eh cikade ncu mpau zie. N da kela Rabe kesa Ih keumpet lwe penui dage kai beuzie. Penui ncu ngngwa mina reidung pung ha beuzie. Nang nkatei rünne peu cide pung dilak. <verse eid="NUM 11:17" /><verse number="18" style="v" sid="NUM 11:18" />Minadung dage rang beulu, ‘Nnuikatei nnui de teimci lu, kedanemene ncünne nnui heteih tyei zie da, kedanemene nnui hap gaida nah RAMPAUBE cide siu luda. Nnui rangla, “Caune anui de heteih tyei kera peu zieno? Egypt ga be anui ziemne yiki.” Cine, RAMPAUBE nnui de heteih peu zie, nah nnui cide tyei zie. <verse eid="NUM 11:18" /><verse number="19" style="v" sid="NUM 11:19" />Nnui heteih langnaige, langnane, langmengeine, langkereine, mede langngkaine ziemne tyei lak, <verse eid="NUM 11:19" /><verse number="20" style="v" sid="NUM 11:20" />dede nnui pekei pelane heteih tyei zie nnui ngkiedung gade cide mpet kemaktane. Cide nnui tyei mneu dizie, kedanemene nnui nnui kakga kelabe RAMPAUBE de mlai kedine. Nnui pe dwa gade hap gai da. Nnui rang eh cu, “Daitei anui Egypt pütdi no?”’” <verse eid="NUM 11:20" /><verse number="21" style="v" sid="NUM 11:21" />Ge Moses rang eh cu, “Ih mina 600,000 de ngngwa la, nah nang ranggai, ‘Ih penui de kei ge ziemne heteihkang tyei kera peu zie.’ <verse eid="NUM 11:21" /><verse number="22" style="v" sid="NUM 11:22" />Anui kauruinedung nah kauhaudung de gi lwe penui mnung teibeu zie ni? Anui jaaidi ga kebam heka pelane tuih teugwang penui mnung teibeu zieni?” <verse eid="NUM 11:22" /><verse number="23" style="v" sid="NUM 11:23" />RAMPAUBE Moses dage rang eh, “A ba duizu dini? Cu nang ngaulu zie a sam kesang mi mebi kecu.”<verse eid="NUM 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24" />Moses tetpet lwe minadung dage RAMPAUBE samdung paulia beu. Pa minadung hangkiame riakhena de qu hekwalu nah penuide paiki gage kai tegwalu. <verse eid="NUM 11:24" /><verse number="25" style="v" sid="NUM 11:25" />RAMPAUBE hemwa gade nghung lwe Moses de resiu. Moses da kela Rabe kesa RAMPAUBE keulu nah cide hangkiame riakhena dage kaigai. Rabe penui da gwang kecudau, penui cairasam rangdi, dede cipau pia rünne nah penui rangdai ma.<verse eid="NUM 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 11:26" />Mipei hangna Eldad penai Medad lie kecu ramzeuki ga bam di. Penai dage de Rabe gwang. Penai zi de kerau ga lütlu. Dede penai paiki gade tet mpetdi ma. Cide rünne mene penai paiki gade cairasam rang di. <verse eid="NUM 11:26" /><verse number="27" style="v" sid="NUM 11:27" />Paiki ga kebam rehangme ge pak gwang Moses dage rangbeu, “Eldad penai Medad paiki gade cairasam rangzeu lie.” <verse eid="NUM 11:27" /><verse number="28" style="v" sid="NUM 11:28" />Nun napei Joshua, Moses de kenghabe, pane kedetkelu kakgade mina hangge, Moses dage rang eh cu, “Penai de kam dilo, a kedibo.” <verse eid="NUM 11:28" /><verse number="29" style="v" sid="NUM 11:29" />Moses pe dage rang eh cu, “Nang a ziemne penai de nriak lani? Ih dai kenzwa gede peu RAMPAUBE gu minadung pelane de caihakecibe lie neu no nah iciu eh peu RAMPAUBE penui pelane dage pe Rabe kai beulu kerane.” <verse eid="NUM 11:29" /><verse number="30" style="v" sid="NUM 11:30" />Iciu eh Moses nah Israelme hangkiamedung ramzeuki ga cailigwang di.<verse eid="NUM 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31" />Ge RAMPAUBE dade tingkai ge gwang nah jaaidi gade rekuidung pung gwang. Penui ramzeuki taiga kaumie di, penui lulegim gade kedagim kecang tingbazie ge beuhzie kenzwa dei ge gumlu. Rekuidung ramzeuki tegwalu hangdeu gade cubit kena kenzwa hu ge. <verse eid="NUM 11:31" /><verse number="32" style="v" sid="NUM 11:32" />Minadung tingbazie pelane nah tingmuiziu pelane, nah pecia benai pelane de rekuidung keu hekwa eh nnang bam di. Migede kilogram cangge swade cam eh hekwa ma. Penui rekui de ramzeuki leune gage mzi gaibeu. <verse eid="NUM 11:32" /><verse number="33" style="v" sid="NUM 11:33" />Penui heteih cide gi eh heteih penui gei kakga kebam dauge RAMPAUBE penui de ngau perata di. Ge RAMPAUBE minadung dage mateei hungsüt kecuge le tei keherei gai. <verse eid="NUM 11:33" /><verse number="34" style="v" sid="NUM 11:34" />Heni cide lepwane Kibroth Hattaavah lie pe zi msiaklu, kedanemene cikage penui heteih tyeineu kelamedung de kung kedine. <verse eid="NUM 11:34" /><verse number="35" style="v" sid="NUM 11:35" />Kibroth Hattavah gade minadung Hazeroth gage tet gai, penui cika bamlu.<verse eid="NUM 11:35" /></para>
  <chapter eid="NUM 11" />
  <chapter number="12" style="c" sid="NUM 12" />
  <para style="s">Miriam penai Aaron ne Moses de kemcwa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1" />Pecai Moses Cushme pui de pe nau kedine Miriam penai Aaron pecu mmau di. <verse eid="NUM 12:1" /><verse number="2" style="v" sid="NUM 12:2" />Penai rangdi, “RAMPAUBE Moses dage rünne marang lani? Pa anai dage de marang la meni?” RAMPAUBE penai kerang de siulu. <verse eid="NUM 12:2" /><verse number="3" style="v" sid="NUM 12:3" />Cu Moses mina aide pezai henasüt, kideu reu ga mina pelane swade henaki.<verse eid="NUM 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 12:4" />Zette eh RAMPAUBE Moses, Aaron nah Miriam dage rang eh cu: “Nnui hangcum ngkwa kela paiki ga mpetlu.” Cine penui hangcum mpetdi. <verse eid="NUM 12:4" /><verse number="5" style="v" sid="NUM 12:5" />Ge RAMPAUBE hemwa tsia gade hung. Pa paiki kimui ga saplwe Aaron penai Miriam de qu gai. Penai gwang mnalu. <verse eid="NUM 12:5" /><verse number="6" style="v" sid="NUM 12:6" />RAMPAUBE ranggai, “Cu au a samdung kingnei lu.</para>
  <para style="q" vid="NUM 12:6">Agu caihakecime ge nnuide ngngwa kebam dau,</para>
  <para style="q1" vid="NUM 12:6">Ih, RAMPAUBE, pe dage marengeidung gade acu liagai zie</para>
  <para style="q1" vid="NUM 12:6">nah pemang lede pecu mpau zie.<verse eid="NUM 12:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NUM 12:7" />A kilabe Moses au cinzwa ma.</para>
  <para style="q1" vid="NUM 12:7">Pa au a ki leune gade samsang.<verse eid="NUM 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NUM 12:8" />Ih Moses dage marengei mede samregwa gade marang lama, dede pecu ncwa le mpaula.</para>
  <para style="q1" vid="NUM 12:8">Pa RAMPAUBE rehi de ngaula.</para>
  <para style="q" vid="NUM 12:8">Cine daitei nnai hing mene</para>
  <para style="q1" vid="NUM 12:8">a kilabe Moses de rang msia lano?”<verse eid="NUM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 12:9" />RAMPAUBE rata heupwa penai de renia di, nah iciu eh pa penai de pütdi. <verse eid="NUM 12:9" /><verse number="10" style="v" sid="NUM 12:10" />Hemwa de paiki reu gade cuhdi, nah Miriam da zette eh kempa mateei gwangdi, pa buising ge nzwa harei di. Aaron Miriam lam nreu gwang ge pa mpa kedi ngau lu. <verse eid="NUM 12:10" /><verse number="11" style="v" sid="NUM 12:11" />Aaron Moses dade cu, “Oh, a mpaubo, ngaunggia kemau aide ne anai de renia di helo. Anai heramie tei eh rang dida, nah anai kemau tei dida. <verse eid="NUM 12:11" /><verse number="12" style="v" sid="NUM 12:12" />Ngaunggia eh pecu peu pepui za gade ngiena pumteih pempiege gah eh mna tset kedibe nzwa di helo.” <verse eid="NUM 12:12" /><verse number="13" style="v" sid="NUM 12:13" />Cine Moses RAMPAUBE de kugai. Pa cu, “Ngaunggia pecu teingkei beulo, Tinggwang, ngaunggia gailo” <verse eid="NUM 12:13" /><verse number="14" style="v" sid="NUM 12:14" />RAMPAUBE Moses dage rang, “Magade pe pei pe zu gage mcai msuigai cai, pa lang henane ngngam eh bam zie. Pecu peu ramzeuki hegwale lang henane bam dilu. Cipau caine pecu ngngwa nlüt dailu.” <verse eid="NUM 12:14" /><verse number="15" style="v" sid="NUM 12:15" />Cine Miriam de peu lang henane ramzeuki gwale bam di. Pa ramzeuki ga gwang dailu kemaktane minadung hebeuh teipet ma.<verse eid="NUM 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 12:16" />Cipaucai minadung Hazeroth gade hebeuh tei tetpwa Paran hetaideu ga ramzeuki teilu.<verse eid="NUM 12:16" /></para>
  <chapter eid="NUM 12" />
  <chapter number="13" style="c" sid="NUM 13" />
  <para style="s">Canaan Pierwakecu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1" />Cipaucai RAMPAUBE Moses de mpau. Pa rang eh, <verse eid="NUM 13:1" /><verse number="2" style="v" sid="NUM 13:2" />“Canaan deu pie kerane minadung de langgai lo, Ih ne Israel minadung de peu kedi de. Penui paume leuh gade hangge ge de langgai lo. Penui hangge ge kecude penui kakgade muiteume ge maisia.” <verse eid="NUM 13:2" /><verse number="3" style="v" sid="NUM 13:3" />Paran hetaideu gade Moses penuide langgai, iciu eh penui RAMPAUBE aja de mzailu kerane. Penui pelane de Israelme kakgade muiteumedung. <verse eid="NUM 13:3" /><verse number="4" style="v" sid="NUM 13:4" />Aidungde penui zidung: Reuben leuhme gade, Zaccur napei Shammua; <verse eid="NUM 13:4" /><verse number="5" style="v" sid="NUM 13:5" />Simeon leuhme gade, Hori napei Shaphat; <verse eid="NUM 13:5" /><verse number="6" style="v" sid="NUM 13:6" />Judah leuhme gade, Jephunneh napei Caleb; <verse eid="NUM 13:6" /><verse number="7" style="v" sid="NUM 13:7" />Issachar leuhme gade, Joseph napei Igal; <verse eid="NUM 13:7" /><verse number="8" style="v" sid="NUM 13:8" />Ephraim leuhme gade, Nun napei Hoshea; <verse eid="NUM 13:8" /><verse number="9" style="v" sid="NUM 13:9" />Benjamin leuhme gade, Raphu napei Palti; <verse eid="NUM 13:9" /><verse number="10" style="v" sid="NUM 13:10" />Zebulun leuhme gade, Sodi napei Gaddiel; <verse eid="NUM 13:10" /><verse number="11" style="v" sid="NUM 13:11" />Joseph leuhme gade (aide Manasseh leuhme ge lie ranglu kebui), Susi napei Gaddi; <verse eid="NUM 13:11" /><verse number="12" style="v" sid="NUM 13:12" />Dan leuhme gade, Gemalli napei Ammiel; <verse eid="NUM 13:12" /><verse number="13" style="v" sid="NUM 13:13" />Asher leuhme gade, Michael napei Sethur; <verse eid="NUM 13:13" /><verse number="14" style="v" sid="NUM 13:14" />Naphtali leuhme gade, Vophsi napei Nahbi; <verse eid="NUM 13:14" /><verse number="15" style="v" sid="NUM 13:15" />Gad leuhme gade, Maki napei Geuel. <verse eid="NUM 13:15" /><verse number="16" style="v" sid="NUM 13:16" />Aidungde Moses ne hangdeu pie kera ziemne langkegaime zidung. Moses, Nun napei Hoshea de Joshua lie pezi qulu.<verse eid="NUM 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 13:17" />Moses penuide Canaan deu pie kera langgai. Pa penui dage rang, “Negev lebie de tetpwa hangdeutu deudi le hanglu. <verse eid="NUM 13:17" /><verse number="18" style="v" sid="NUM 13:18" />Kideube cide dainzwa bi kecu pielo. Cika mina kelunghme de mcet lo, penui ngking mi mnei bi, nah penui cam mi kiee bi kecu. <verse eid="NUM 13:18" /><verse number="19" style="v" sid="NUM 13:19" />Penui lunghkebam kideube dainzwa bi pielo. Cide yimi siabi? Daipai namdidung cika bam bi? Cide ramzeukidung nzwa mi, mede riegwa kelu namdidung nzwa bi? <verse eid="NUM 13:19" /><verse number="20" style="v" sid="NUM 13:20" />Hangdeu cide dainzwa siakte bi pielu, cide ma lunghyi mi mebi, nah cika tsingbangdung bam mi mebi. Kuulu nah kideube gade lungh kelu perehidung teugwang lo.” Cipau tingde kubetsidung meu raitu kecuting.<verse eid="NUM 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 13:21" />Cine minadung hang eh Lebo Hamath taiga Zin hetaideu gade Rehob kecang kideube pielu. <verse eid="NUM 13:21" /><verse number="22" style="v" sid="NUM 13:22" />Penui Negev gade hang Hebron ga lütlu. Anak dade lungh kemie leuhdung Ahiman, Sheshai nah Talmai cika bam. Egypt ga Zoan namdi tum kemak dwa Hebron mmi hena ge tum nswalu. <verse eid="NUM 13:22" /><verse number="23" style="v" sid="NUM 13:23" />Penui Eshkol langkam ga gwang canglu ge, kubetsi peu kiakge penui bi lu. Penui hetuitie ge gage hemaa kena teilwe cide pwa. Penui kuraletsi nah tangzüttsi de pwa gwang. <verse eid="NUM 13:23" /><verse number="24" style="v" sid="NUM 13:24" />Cipau heni de lepwa pezi Eshkol langkam de msiaklu, kedanemene Israelme cikade kubetsi peu ge bi nghung kelune.<verse eid="NUM 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 13:25" />Penui kideu pie kela gade zie riakdai cai benai cailigwang di. <verse eid="NUM 13:25" /><verse number="26" style="v" sid="NUM 13:26" />Penui Moses, Aaron nah Israelmedung heleuh leune da Kadesh ga Paran hetaideu ga cailigwang. Penui Moses penui dage nah hemaabe dage sambe teu cailigwang beu, nah hangdeu gade ngaukelu pwa liagai. <verse eid="NUM 13:26" /><verse number="27" style="v" sid="NUM 13:27" />Penui Moses dage rang eh cu, “Nang anuide lang kegaibe deu ga miecang da. Cika tungdui nah heliadui lwa kesang bam. Aide cikade ngau kelube niadung da. <verse eid="NUM 13:27" /><verse number="28" style="v" sid="NUM 13:28" />Iciuliede, cika kelung minadung au ngking. Namdidung au di nah rie pwabam. Anui cika Anak leuhme de de ngauda. <verse eid="NUM 13:28" /><verse number="29" style="v" sid="NUM 13:29" />Amalekme Negev ga lunghbam. Hittitme, Jebusiteme, nah Amoritme penui ki lamlwatu deudi le bam. Canaanme duidi kungh nah Jordan reukung ga lungbam.”<verse eid="NUM 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 13:30" />Iciu eh Caleb Moses dwaga kebam minadung de kezeudi eh cu, “Anui hang go nah kideube luulu go, kedanemene anui cide gumbi lubui lu.” <verse eid="NUM 13:30" /><verse number="31" style="v" sid="NUM 13:31" />Dede mina kedame pecu mzang kemieme cu, “Anui minadung de gwaketang gailak, kedanemene penui anui swade ngking lu.” <verse eid="NUM 13:31" /><verse number="32" style="v" sid="NUM 13:32" />Cine penui pierwa kelu hangdeu de Israelmedung dage penui peha kesiabedung ranggai beu. Penui rang eh, “Anui hangdeu mie pie kegai de au cika lungh kebamme de tyeipwa dila. Anui kengau cika mina leune de penui ratie husüt. <verse eid="NUM 13:32" /><verse number="33" style="v" sid="NUM 13:33" />Cika mina ketie kedime, Anak leuhmedung, mina ketie-kedi leuh gade lungh gwang keludung de anui ngauda. Anui au anuikatei anui miakngau gade penuide keda kegaidau anui au tangriemdung nzwadi, nah anui au penui miakngau gade de cinzwa da.”<verse eid="NUM 13:33" /></para>
  <chapter eid="NUM 13" />
  <chapter number="14" style="c" sid="NUM 14" />
  <para style="s">Minadung Mlai cu kedi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1" />Cipau beziu heleuhdung pelane sahbak eh hapdi.<note caller="-" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="HEB 3:16-18">Heb. 3:16-18</ref></char></note> <verse eid="NUM 14:1" /><verse number="2" style="v" sid="NUM 14:2" />Israelme leune Moses penai Aaron de rangmsia di. Mina leune penai dade cu, “Anui Egyptme deu gade mede hetaideu aide gade tsaidi lie neu lie! <verse eid="NUM 14:2" /><verse number="3" style="v" sid="NUM 14:3" />Daitei RAMPAUBE anuide kideu aide gage kingtie gade peu tsaidi kera ngngwa gai no? Anui naudung nah anui namedung de ngkap kedime tei dizie. Anui ziemne Egypt ga cailigwang dai kedibe yiki lak ni?”<verse eid="NUM 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 14:4" />Penui hangge ge dade rang eh cu, “Anui muiteu kedage kedet go, nah anui Egypt ga cailigwang di go.”<note caller="-" style="x"><char style="xo" closed="false">14:4 </char><char style="xt" closed="false"><ref loc="ACT 7:39">Bat. 7:39</ref></char></note> <verse eid="NUM 14:4" /><verse number="5" style="v" sid="NUM 14:5" />Ge Moses penai Aaron Israelme pelane kangbau dwa gade penai zu keumie di. <verse eid="NUM 14:5" /><verse number="6" style="v" sid="NUM 14:6" />Kideube mie pielo langkegaime kakgade Nun napei Joshua, nah Jephunneh napei Caleb penai paini hiet di. <verse eid="NUM 14:6" /><verse number="7" style="v" sid="NUM 14:7" />Penai Israel leuhme mina pelane dage resiu gai. Penai rang eh, “Anui hangdeu cide tetkah gwang eh pie nah mcet siakte kegai deu de yisüt. <verse eid="NUM 14:7" /><verse number="8" style="v" sid="NUM 14:8" />Magade RAMPAUBE anuide pesui lu liecai, pa anuide kideu aide ga ngngwa gwang anuide cide peu zie. Tungdui nah heliadui lwa kebam deu de. <verse eid="NUM 14:8" /><verse number="9" style="v" sid="NUM 14:9" />Dede RAMPAUBE de renia so, nah hangdeu cide ga minadung de hingso, kedanemene penui au anui ziemne taktyei ge lu. Penuide kegumbe penui dade keuteu dizie, kedanemene RAMPAUBE anui de ngngwa la kecune ne. Penui de hing diso.” <verse eid="NUM 14:9" /><verse number="10" style="v" sid="NUM 14:10" />Iciu eh hemaabe pelane penai de tangtsudung le sam zielie di. Dede RAMPAUBE kendu de Israel minadung gu paiki gade ngau petdi.<verse eid="NUM 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 14:11" />RAMPAUBE Moses dage rang eh cu, “Mina aidungde acu daitiege mlai zie no? A kengkieng rengei penui kakgage teigai liede, daitiege penui acu nlumlu tadi zie no? <verse eid="NUM 14:11" /><verse number="12" style="v" sid="NUM 14:12" />Ih penuide mateei kai ketang zie, penuide püt dizie, nah n peiname dade penui swa heleuh kedige nah ngking ki kecu ge tei beuzie.”<verse eid="NUM 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 14:13" />Moses RAMPAUBE dade rang eh cu, “Magade nang aide tei liecai, ciciucai Egyptme cipau ha de siu teu dizie, kedanemene nang penui dade mina aidungde de n kengking le kelilu delu. <verse eid="NUM 14:13" /><verse number="14" style="v" sid="NUM 14:14" />Penui aipau deu ga lungh kebamme dage cide rangzie. Nang RAMPAUBE mina aidungde da lalie kecu penui siulu da, kedanemene, ncu kezumok eh ngau dida. Ngu hemwa anui minadung reu ga sap. Nang tingna penui dwaga hemwa tsia ge gade tet nah tingmui mi tsia ge gade. <verse eid="NUM 14:14" /><verse number="15" style="v" sid="NUM 14:15" />Cu nang mina aidungde de mina hangge nzwa teitset dicai, ciciucai heleuhdung n kendu ha siu kelumedung samrang dizie nah rang eh cu, <verse eid="NUM 14:15" /><verse number="16" style="v" sid="NUM 14:16" />‘Kedanemene RAMPAUBE pe sampet kaikebeu deu ga mina aidungde de ngngwa nlüt gailak kedine, pa penuide hetaideu gade teitset dida.’ <verse eid="NUM 14:16" /><verse number="17" style="v" sid="NUM 14:17" />Cu Ih n dade kiela, n kengking kedi de keulia lo. Kedanemene nang rang kecu, <verse eid="NUM 14:17" /><verse number="18" style="v" sid="NUM 14:18" />‘RAMPAUBE au pe rata zette di lama nah samkakkelu kesamsang pui nliem bam. Pa yicang kemakpe nah samzai teilu tadi kelabe mau gi beula. Pa paupaime maudung ziemne penui caname dage saja kai dicai ceheu kecum nah mdai dage kecang de penui mau gibeu tadi la.’ <verse eid="NUM 14:18" /><verse number="19" style="v" sid="NUM 14:19" />Ih n dade kiela, mina aidung mau gibeu lo, kedanemene n samkak kedi samsang de ziemne, nang mina aidungde mau Egypt ga kebam dau gade cu kecang de gibeu bammui kelade nzwa.”<verse eid="NUM 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20" />RAMPAUBE rang eh cu, “Nang kie kela ziemne Ih penui mau gibeu dida, <verse eid="NUM 14:20" /><verse number="21" style="v" sid="NUM 14:21" />dede kesangsiakpe, Ih ringkela nzwa, nah kideu pelane a kendu le puih lu kela nzwa,<note caller="-" style="x"><char style="xo" closed="false">14:21 </char><char style="xt" closed="false"><ref loc="HEB 3:11">Heb. 3:11</ref></char></note> <verse eid="NUM 14:21" /><verse number="22" style="v" sid="NUM 14:22" />mina leune de Ih Egypt gade nah hetaideu gade a kendu nah kengking rengeidung Ih tei kegai ngau kelume pelane de, cu kecang de acu pia kereige kedak lala nah penui a kwa kingnei meidi zeu.<note caller="-" style="x"><char style="xo" closed="false">14:22 </char><char style="xt" closed="false"><ref loc="HEB 3:18">Heb. 3:18</ref></char></note> <verse eid="NUM 14:22" /><verse number="23" style="v" sid="NUM 14:23" />Cine Ih rangla, penui paume dage samkakkelu deu de penuide peu ngau lak. Acu mlai kedime migede cide ngau lak, <verse eid="NUM 14:23" /><verse number="24" style="v" sid="NUM 14:24" />a kilabe Caleb rünne gwale, kedanemene pa rabe kedage pe da bam. Pa a caisui siakte luda; pa mie eh pie nah mcet kelu deu ga Ih pecu ngngwa nlüt zie. Pe leuhmedung cide gum luzie. <verse eid="NUM 14:24" /><verse number="25" style="v" sid="NUM 14:25" />(Cu Amalekme nah Canaanme langkie ga lunghbam.) Ncünne hetaideu ga nreucaili lwe Kegie Jaaidi lampui gade gwang cu.” <verse eid="NUM 14:25" /><verse number="26" style="v" sid="NUM 14:26" />RAMPAUBE Moses penai Aaron de mpau, rang eh <verse eid="NUM 14:26" /><verse number="27" style="v" sid="NUM 14:27" />“Acu rangmsia kebam hemaa kesia aidungde de Ih daitiege liabam zieno? Israelmedung ncam eh acu renia kebam Ih siu da. <verse eid="NUM 14:27" /><verse number="28" style="v" sid="NUM 14:28" />Penui dage rangbeu lo, ‘Ih ringkela nzwa,’ RAMPAUBE rang eh, ‘Ih siu kecu gade nnui rang kegai nzwa, Ih aide nnuide tei beuzie: <verse eid="NUM 14:28" /><verse number="29" style="v" sid="NUM 14:29" />Nnui ncam eh acu renia kela leune, pumpei ga pei ncüt kelu leune, mmi ngkai gade penreume pelane nnui tsai paau hetaideu aika ge kaugai dizie.<note caller="-" style="x"><char style="xo" closed="false">14:29 </char><char style="xt" closed="false"><ref loc="HEB 3:17">Heb. 3:17</ref></char></note> <verse eid="NUM 14:29" /><verse number="30" style="v" sid="NUM 14:30" />Ih nnuide peu nnui ki tei zielie samkak kelube deu de ga lüt lakzing, Jephunneh napei Caleb penai Nun napei Joshua rünne gwale. <verse eid="NUM 14:30" /><verse number="31" style="v" sid="NUM 14:31" />Dede nnui namedung de tuiteu dizie lie nnui rang kegaide, Ih penuide kideube ga ngngwang zie. Nnui gikedi deu de penui ngau zie! <verse eid="NUM 14:31" /><verse number="32" style="v" sid="NUM 14:32" />Nnui ziemne au nnui paaudung hetaideu aika ge kaugai dizie. <verse eid="NUM 14:32" /><verse number="33" style="v" sid="NUM 14:33" />Nnui namedung mmi riakdai ge hetaideu ga meurün kekwame teizie. Nnui acu kerenia mau de penui ne pung zie hetaideu ga nnui tsai paaudung gah di kemaktane.<note caller="-" style="x"><char style="xo" closed="false">14:33 </char><char style="xt" closed="false"><ref loc="ACT 7:36">Bat. 7:36</ref></char></note> <verse eid="NUM 14:33" /><verse number="34" style="v" sid="NUM 14:34" />Nnui tingbazie riakdai ge kideube pie kelu nzwa, cinzwa nnui mmi riakdai ge nnui maudung ziemne lia zie, tingnaige ziemne tingkum ge, nah Ih nnuide mcau kegai daikenzwa ge bi kecu nnui pekie cilu zie.<note caller="-" style="x"><char style="xo" closed="false">14:34 </char><char style="xt" closed="false"><ref loc="ACT 13:18">Bat. 13:18</ref></char></note> <verse eid="NUM 14:34" /><verse number="35" style="v" sid="NUM 14:35" />Ih, RAMPAUBE, rang dida. Gwang ngkwa ncüt lwe acu renia cuh kecume kesia aidung pelane dage Ih aide teibi zie. Penui aika de tsai dizie nah penui de gi zingde dizie.’”<note caller="-" style="x"><char style="xo" closed="false">14:35 </char><char style="xt" closed="false"><ref loc="HEB 3:16-18">Heb. 3:16-18</ref></char></note><verse eid="NUM 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 14:36" />Ciu eh Moses minadung de langpwa hangdeu de pie mcet kera langgai, penui cailigwang nah cipau hangdeu gu pekesia ha heleuhdung pelane dage pau eh rangrwa gai eh Moses de ncam eh renia cuhdi,<note caller="-" style="x"><char style="xo" closed="false">14:36 </char><char style="xt" closed="false"><ref loc="JUD 1:5">Jud. 1:5</ref></char></note> <verse eid="NUM 14:36" /><verse number="37" style="v" sid="NUM 14:37" />Minadung kideube ha kesia teugwang kecume de dapngkau di nah penui mateei gade RAMPAUBE dwa gade tsaidi. <verse eid="NUM 14:37" /><verse number="38" style="v" sid="NUM 14:38" />Kideube mie pie kecume kakgade Joshua, Nun napei penai Caleb, Jephunneh napei rünne ringlu. <verse eid="NUM 14:38" /><verse number="39" style="v" sid="NUM 14:39" />Moses sam aidungde Israelme pelane dage pau kegaidau, penui hapsüt di. <verse eid="NUM 14:39" /><verse number="40" style="v" sid="NUM 14:40" />Penui tingcang nuge cuhlu eh lamlwatu cehutu ga hanglwe rang eh, “Pielo, anui aika bam, anui RAMPAUBE ne sampet kebeu dwaga gwang zie, kedanemene anui mau dida,” dedi. <verse eid="NUM 14:40" /><verse number="41" style="v" sid="NUM 14:41" />Dede Moses rang eh cu, “Daitei nnui cu RAMPAUBE aja gileu lano? Nnui au ma teilu gailak. <verse eid="NUM 14:41" /><verse number="42" style="v" sid="NUM 14:42" />Tet so, kedanemene RAMPAUBE nnui ngauraume dade nnuide gumkwaklu kera nnuide nzang la lama. <verse eid="NUM 14:42" /><verse number="43" style="v" sid="NUM 14:43" />Amalekme nah Canaanme cika bam, nah nnui kingtie gade tsai zie kedanemene nnui RAMPAUBE caisui kela gade caili di delu. Cine pa nnui de ngngwa la lak.” <verse eid="NUM 14:43" /><verse number="44" style="v" sid="NUM 14:44" />Dede penui hangdeutu deudi ga hang kera mariem teudi; iciuliede, Moses liede nah RAMPAUBE samkakbung liede ramzeuki de pütti ma. <verse eid="NUM 14:44" /><verse number="45" style="v" sid="NUM 14:45" />Ge Amalekiteme nghung, nah Canaanme de cipau deutu ga lungh kebamme si eh. Penui Israelme de gwaketang nah Hormah kecang ga zui mie penuide ngamdi.<verse eid="NUM 14:45" /></para>
  <chapter eid="NUM 14" />
  <chapter number="15" style="c" sid="NUM 15" />
  <para style="s">Kaikesi Recadung</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1" />Pecai RAMPAUBE Moses de mpau, rang eh, <verse eid="NUM 15:1" /><verse number="2" style="v" sid="NUM 15:2" />“Israel minadung de resiu gailo nah penui dage aide rang beulu, nnui lungh kera deu ga nlütlu sangne, Ih nnuide peuzie lie kebam de, <verse eid="NUM 15:2" /><verse number="3" style="v" sid="NUM 15:3" />nnui mi le teikelu ratak RAMPAUBE dage teigai lu, keru ratak ge mede sampet de teicanglu kerane ratak ge mede suiyikai reca ge, mede nnui hengyidung kela gage reca ge, kauhaudung mede meuründung gade perim keyi de RAMPAUBE de peulu kerane. <verse eid="NUM 15:3" /><verse number="4" style="v" sid="NUM 15:4" />Nnui RAMPAUBE dage keru ratak nah mei reca ge tokkui ephah zi kerei gade zi ge maca hin zi mdai gade zi ge gage hai ncütlu eh peulu. <verse eid="NUM 15:4" /><verse number="5" style="v" sid="NUM 15:5" />Nnui keru reca gage si eh, mede ratak de ziemne, meurünna ketket kecu ziemne zau reca hin zi mdai gade zi ge peulu maisia. <verse eid="NUM 15:5" /><verse number="6" style="v" sid="NUM 15:6" />Magade nnui meurünseu ge reca teigai cai, nnui tokkui ephah zi kerei gade zi na ge maca hin zi kecum gade zi ge gage hai ncütlu eh mei reca tei beulu. <verse eid="NUM 15:6" /><verse number="7" style="v" sid="NUM 15:7" />Zau reca teibeu kera ga, nnui zau hin zi kecum gade zi ge peulu. Cide RAMPAUBE ziemne perim keyi ge tei zie. <verse eid="NUM 15:7" /><verse number="8" style="v" sid="NUM 15:8" />Nnui hetumseu ge keru reca ziemne mede ratak ge sampet de teicanglu kerane telei keludau, mede RAMPAUBE dage kekangbau reca tei kegaidau, <verse eid="NUM 15:8" /><verse number="9" style="v" sid="NUM 15:9" />iciucai nnui hetumseu gage si eh tokkui zi kerei gade zi kecum mei reca maca hin pempie ge hai ncütlu eh teibeu lu maisia. <verse eid="NUM 15:9" /><verse number="10" style="v" sid="NUM 15:10" />Nang zau hin pempie ge teu zau reca teilu maisia, mi le teikelu reca nzwa eh, RAMPAUBE ziemne perim keyi teibeu kerane.<verse eid="NUM 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 15:11" />“Hetumseu ketket ziemne ainzwa eh teilu maisia, meurünseu ketket ziemne, nah meuründung ketket ziemne mede hemeudung ziemne. <verse eid="NUM 15:11" /><verse number="12" style="v" sid="NUM 15:12" />Ratak keheibe de nnui mtei kegai nah reca gai kebeude aikage rang kelia de nzwa teilu maisia. <verse eid="NUM 15:12" /><verse number="13" style="v" sid="NUM 15:13" />Israelme deuketna leune aidungde ainzwa eh teilu maisia, mikeheibe de mi le teikelu ratak keugwang cai, RAMPAUBE suiyi teilu kela perim keyi de peulu kerane. <verse eid="NUM 15:13" /><verse number="14" style="v" sid="NUM 15:14" />Magade sangme ge ncu ngngwa lunghbam cai, mede mikeheibe de n mina ceheudung gade nnui kakga lunghbam lubui, pa mi le teikelu ratak mteilu maisia, RAMPAUBE ziemne perim keyi teibeu kerane. Nnui tei kela nzwa pa de tei maisia. <verse eid="NUM 15:14" /><verse number="15" style="v" sid="NUM 15:15" />Minadung nah nnuide nzang lungh kebam sangme ziemne de hezai zaige zie, n minadung ceheu ga bammui kera hezai ge. Nnui nzwa eh, nnui da kebam mbeu kelame de de nzwa zie. Nang RAMPAUBE dage matei kegai nzwa penuide cide siakte tei maisia. <verse eid="NUM 15:15" /><verse number="16" style="v" sid="NUM 15:16" />Nnui nah nnuide nzang kebam sangme ziemne de hezaidung de zaige zie.”<verse eid="NUM 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17" />RAMPAUBE Moses de mpau dai, rang eh, <verse eid="NUM 15:17" /><verse number="18" style="v" sid="NUM 15:18" />“Israel minadung de resiu gailo nah penui dage ranglo, ‘Ih nnuide ngngwa gwang beu lai eh kebam deu ga lüt keludau, <verse eid="NUM 15:18" /><verse number="19" style="v" sid="NUM 15:19" />cipau deu gade ngaukelu taktyei tyei kecudau, nnui reca teipwa RAMPAUBE de peulu maisia. <verse eid="NUM 15:19" /><verse number="20" style="v" sid="NUM 15:20" />Nnui tokkui henet kelu raitube gade tangku ge keucuh ciukeneu bam gade reca teicuh gailu. Nnui ainzwa eh ratak teicuh beulu. <verse eid="NUM 15:20" /><verse number="21" style="v" sid="NUM 15:21" />N mina ceheudung leune gade tokkui henet kelu raitube gade RAMPAUBE dage reca teicuh kecu peulu maisia.<verse eid="NUM 15:21" /></para>
  <para style="s">Zielie eh Teikemak Mau</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 15:22" />“Nnui madaunge tei zielie mene kemau tei dizie, RAMPAUBE Moses dage rang kebeu ajadung leune mzai canglu ta kedidau, <verse eid="NUM 15:22" /><verse number="23" style="v" sid="NUM 15:23" />RAMPAUBE maleune Moses dage nnui ziemne aja kaikebeu benai gade RAMPAUBE nnuide ajadung n mina ceheudung gade pwapeu kecu ndeu dida. <verse eid="NUM 15:23" /><verse number="24" style="v" sid="NUM 15:24" />Hemaabe cicang kemak gade zielie mene tei kedidau, cidau hemaabe hetumseuna ge keru ratak tei eh peu maisia, RAMPAUBE ziemne perim keyi ge teibeu kerane. Aide ga mei reca nah zau reca de si maisia, hezai gade aja kaikebeu nzwa eh, nah hemeuseu ge kemau reca tei zie. <verse eid="NUM 15:24" /><verse number="25" style="v" sid="NUM 15:25" />Cingkube Israel minadung ziemne teikemci renet teibeu maisia. Penui mau gibeu zie kedanemene kemau cide au zielie eh tei kemakne. Penui penui ratak, mi le teikelu reca RAMPAUBE dage teugwang beu. Penui zielie mene tei kedi de ziemne penui RAMPAUBE dage kemau reca teugwang beu. <verse eid="NUM 15:25" /><verse number="26" style="v" sid="NUM 15:26" />Cidau Israel minadung mau gibeu zie, nah penui kakga kebam sangme maudung de, kedanemene mina pelane de zielie eh mene matei mau kecune.<verse eid="NUM 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 15:27" />Magade mige zielie eh mene matei mau dicai, iciucai pa hemeupui nage mmi ge gu kemau reca teigai beulu maisia. <verse eid="NUM 15:27" /><verse number="28" style="v" sid="NUM 15:28" />Cingkube RAMPAUBE dage teikemci renet mina zielie eh mene matei mau kedime ziemne teibeu maisia. Teikemci renet teigai kebeudau cipaume mau gibeu zie. <verse eid="NUM 15:28" /><verse number="29" style="v" sid="NUM 15:29" />Mige cimene teimau kedibe ziemne hezaibe au nsamkap bamlu maisia, Israel ga mina deuketna cikade mna kelume nah penui kakga sangme lungh kebamme ziemne nnui hezaibe nsamkap lu maisia. <verse eid="NUM 15:29" /><verse number="30" style="v" sid="NUM 15:30" />Dede mige petaukemak gade renia cuh eh, pa deuketna ge mede sangme ge lubui, RAMPAUBE de rangmsia dicai. Pecu pe minadung kakgade keumpet dilu. <verse eid="NUM 15:30" /><verse number="31" style="v" sid="NUM 15:31" />Kedanemene pa RAMPAUBE sam mlai kedine nah pe ajadung mzai kemakne, cipaude de au ngkap zingdi kerabe. Pe mau de pekatei pezie da.’”<verse eid="NUM 15:31" /></para>
  <para style="s">Sabbath mneikemakme de Teitset kera</para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32" />Israelme hetaideu ga keladau, penui Sabbath benai mige tsing nsiemla eh ngaulu. <verse eid="NUM 15:32" /><verse number="33" style="v" sid="NUM 15:33" />Pecu ngau kelume ne pecu Moses, Aaron, nah hemaabe dage ngngwa gwang. <verse eid="NUM 15:33" /><verse number="34" style="v" sid="NUM 15:34" />Penui pecu baang di kedanemene pecu daitei zie bi mci kemakne. <verse eid="NUM 15:34" /><verse number="35" style="v" sid="NUM 15:35" />Pecai RAMPAUBE Moses dage ranggai, “Minabe de teitset di maisia. Ramzeuki gwale de hemaabe pelane pecu tangtsu le sam tsetdi lu.” <verse eid="NUM 15:35" /><verse number="36" style="v" sid="NUM 15:36" />Cine hemaabe pelane pecu ramzeuki gwale ge ngngwa mpet nah RAMPAUBE Moses dage aja kaikebeu nzwa pecu tangtsu le sam tsetdi.<verse eid="NUM 15:36" /></para>
  <para style="s">Paini ga Pairidung</para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37" />RAMPAUBE Moses de mpau dai, rang eh, <verse eid="NUM 15:37" /><verse number="38" style="v" sid="NUM 15:38" />“Israel leuhme dage ranglo nah peu penuikatei pai ri teilu eh penui pai tudung gage hezu gailu kerane penuide aja kaibeu, tiak kemzai ria ge le pai tu gage hezu lu kerane. Penui aide penui minadung ceheu ting leune ga teilu maisia. <verse eid="NUM 15:38" /><verse number="39" style="v" sid="NUM 15:39" />Aidungde nnuide peu nsung dailu kera ge zie, nnui cide pie kegaidau, RAMPAUBE gu ajadung pelane, cidungde tei mzailu kerane iciu eh nnuikatei nnui mlung nah nnui miakdung de pie di melu kerane nah penui de ngngwa kemha ta teidi melu kerane. <verse eid="NUM 15:39" /><verse number="40" style="v" sid="NUM 15:40" />Aide teilu iciu eh nnui nsunglu kerane nah agu ajadung pelane mzailu kerane, nah iciu eh nnui Tinggwang dade nnui mci bamlu kerane. <verse eid="NUM 15:40" /><verse number="41" style="v" sid="NUM 15:41" />Ih RAMPAUBE nnui Tinggwang, Egypt deu gade nnuide ngngwa mpet kebeube, nnui Tinggwang teilu kerane. Ih RAMPAUBE nnui Tinggwang.”<verse eid="NUM 15:41" /></para>
  <chapter eid="NUM 15" />
  <chapter number="16" style="c" sid="NUM 16" />
  <para style="ms">Korah, Dathan nah Abiram</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1" />Cu Izhar napei, Levi napei Kohath gu capei Korah, Dathan nah Abiram Eliab napei de ngngwa, nah Peleth napei On, Reuben leuhme, mina kangge de ngngwa hekwalu. <verse eid="NUM 16:1" /><verse number="2" style="v" sid="NUM 16:2" />Penui Moses de renia cuh, Israel minadung gade mipeidung kedame de si eh, heleuhdung gade kenlang peupeime heleuhdung muiteume hai na eh riakngei ge. <verse eid="NUM 16:2" /><verse number="3" style="v" sid="NUM 16:3" />Moses penai Aaron de renia kerane penui gwang ngkwa lu. Penui penai dage rang eh, “Nnui au tet dei ham dida! Tingbungme pelane de tei mci lu, hangge ge kecu leune, nah RAMPAUBE penui kakga bam. Daitei nang RAMPAUBE leuhme kakga de nkatei ncu teucuh lano?”<verse eid="NUM 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 16:4" />Moses cide siu keludau, pa pezu keumie di. <verse eid="NUM 16:4" /><verse number="5" style="v" sid="NUM 16:5" />Pa Korah de resiu nah pecu ngngwa kelame leune de, “RAMPAUBE tingcang dau cauge pe gu bi nah cauge peda teuntsam dibi ndulia zie. Pa cipaude de pe taiga ngngwa gwang zie. Pa kedet kelume de pe taiga ngngwa gwang nna zie. <verse eid="NUM 16:5" /><verse number="6" style="v" sid="NUM 16:6" />Aide teilu, Korah nah n maame pelane. Kehengui kerubung keulu <verse eid="NUM 16:6" /><verse number="7" style="v" sid="NUM 16:7" />ncünne nah mi kailu nah cikage marim kehengui kailu RAMPAUBE dwa gage. RAMPAUBE ne kedet kelume, cipaude de au RAMPAUBE dade teuntsam dizie. Nnui au tetdei ham dida, nnui Levi leuhme.” <verse eid="NUM 16:7" /><verse number="8" style="v" sid="NUM 16:8" />Pecaide, Moses Korah dage rang eh, “Cu kingneilu, nnui Levi leuhme: <verse eid="NUM 16:8" /><verse number="9" style="v" sid="NUM 16:9" />Israel Tinggwang ne ncu Israel leuhme gade teuntsam kedi cide n ziemne ma keceu ge ni, ncu pe taiga ngngwa gwang nna lu kera, RAMPAUBE paiki gade heta teilu kera, nah heleuhbe dwa sap eh penui tatei kera? <verse eid="NUM 16:9" /><verse number="10" style="v" sid="NUM 16:10" />Pa ncu ngngwa gwang nna beu da, nah n kibaume leune de, nah Levi leuhmedung, ncu si eh, ciuliede nang au cingkume de liede peei la! <verse eid="NUM 16:10" /><verse number="11" style="v" sid="NUM 16:11" />Cine nang nah n kangngwame pelane ncüt eh RAMPAUBE de renia. Nnui pecu rangmsia kebam Aaron de cau no?”<verse eid="NUM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 16:12" />Pecai Dathan penai Abiram de Moses qugai, Eliab napeidung, dede penai rang eh, “Anai gwang lak. <verse eid="NUM 16:12" /><verse number="13" style="v" sid="NUM 16:13" />Heliadui nah tungdui lwakebam deu gade anai de ngngwa mpet kedi cide ma keceu ge ni, hetaideu gade anai de teitsetti kera? Cu nang nkatei anai reu kedibe teineu ni! <verse eid="NUM 16:13" /><verse number="14" style="v" sid="NUM 16:14" />Rangsi eh, heliadui nah tungdui lwakebam gage nang anai de ngngwa gaibeu ma, mede luhdung nah kubeluhdung anai mapwa tei kera peu ma. Cu nang kemrwa sampet teu anai de tei miedi neu ni? Anai n da gwang lak.”<verse eid="NUM 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 16:15" />Moses pe rata sütti nah RAMPAUBE dage rang, “Penai reca pwa kepeu de herüt peuso. Ih penai dade gada ge de keu ma, nah Ih penui keheibede de tei rezam ma.” <verse eid="NUM 16:15" /><verse number="16" style="v" sid="NUM 16:16" />Pecai Moses Korah dage rang, “Ncünne nang nah n kangngwame pelane RAMPAUBE dwa ga mie maisia, nang nah penui, nah Aaron. <verse eid="NUM 16:16" /><verse number="17" style="v" sid="NUM 16:17" />Nnui hangge ge kecu pegu kehengui kerubung keu maisia nah marim kehengui cika kailu. Iciu eh mina ketket kecu pegu kehengui kerubung RAMPAUBE dwaga teugwang maisia, hai na eh riakngei kehengui kerubung. Nang nah Aaron liede, nnai gu kehengui kerubung teugwang maisia.” <verse eid="NUM 16:17" /><verse number="18" style="v" sid="NUM 16:18" />Cine mina pelane penui gu kehengui kerubung pwalu, cika mi kailu, marim kehengui cika kaigai lu, nah Moses penai Aaron de ngngwa paiki tet nlüt kecu ga saplu. <verse eid="NUM 16:18" /><verse number="19" style="v" sid="NUM 16:19" />Korah heleuh pelane de teu hekwa lwe Moses penai Aaron de paiki tet nlüt kecu gade renia di, nah RAMPAUBE kendu de heleuh pelane da keulia gai.<verse eid="NUM 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 16:20" />Pecai RAMPAUBE Moses penai Aaron de mpau, rang eh, <verse eid="NUM 16:20" /><verse number="21" style="v" sid="NUM 16:21" />“Aipau heleuh gade nkatei ncu teumdei dilu kedanemene Ih penui de zette mnwa di lubui.” <verse eid="NUM 16:21" /><verse number="22" style="v" sid="NUM 16:22" />Moses penai Aaron keumie nah rangdi, “Tinggwang, minadung pelane rabedung gu Tinggwang, magade mi hangge kemau teidi cai, nang heleuh pelane de n rata zie ni?”<note caller="-" style="x"><char style="xo" closed="false">16:22 </char><char style="xt" closed="false"><ref loc="HEB 12:9">Heb. 12:9</ref></char></note> <verse eid="NUM 16:22" /><verse number="23" style="v" sid="NUM 16:23" />RAMPAUBE Moses de keli gai, rang eh, <verse eid="NUM 16:23" /><verse number="24" style="v" sid="NUM 16:24" />“Heleuhbe de resiu lu. Ranglu, ‘Korah, Dathan, nah Abiram gu paikidung gade mdei tetdi lu.’”<verse eid="NUM 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 16:25" />Pecai Moses cuhlu nah Dathan penai Abiram da miedi; Israel ga kecingmedung pe caisui di. <verse eid="NUM 16:25" /><verse number="26" style="v" sid="NUM 16:26" />Pa hemaabe de resiu nah ranggai, “Aipau kesiame paikidung gade tetdi lu nah penui gu magede tungso, mecai nnuide penui maudung ne ngkap dizie.”<note caller="-" style="x"><char style="xo" closed="false">16:26 </char><char style="xt" closed="false"><ref loc="2TI 2:19">2 Tim. 2:19</ref></char></note> <verse eid="NUM 16:26" /><verse number="27" style="v" sid="NUM 16:27" />Cine Korah, Dathan, nah Abiram gu paikidung ga twagwa kebam hemaabe penuide gidi. Dathan nah Abiram penai nau, penai napeimedung, nah penai namedung de ngngwa eh penai paiki kimuiki ga mpet lwe saplu. <verse eid="NUM 16:27" /><verse number="28" style="v" sid="NUM 16:28" />Pecai Moses ranggai, “Aide gade nnui RAMPAUBE ne peu heta aidungde tei kerane acu langgai kecu cilu zie, kedanemene aidungde Ih akatei a sui lungning gade teigai ma. <verse eid="NUM 16:28" /><verse number="29" style="v" sid="NUM 16:29" />Magade mina aidungde tsai kerating di eh mina tsai kela nzwa tsai dicai, iciucai RAMPAUBE ne acu langgai meda. <verse eid="NUM 16:29" /><verse number="30" style="v" sid="NUM 16:30" />Dede magade RAMPAUBE makeheci ge teigai, nah kideube pe mui ngnga eh penuide mnwa teu dicai, penui mabam pelane de si eh, nah Sheol ga penui mring nghung dicai, iciucai penui RAMPAUBE de mlai di kecude nnui ci lulo.”<verse eid="NUM 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31" />Moses sam aidungde rang cangdi herizi, mipei cipaudung de kangga hangdeube ngkei di. <verse eid="NUM 16:31" /><verse number="32" style="v" sid="NUM 16:32" />Kideube pe mui ngnga nah penui de mnwa teu di, penui kibaumedung, nah Korah caisuime, nah penui mabamdung leune de si eh. <verse eid="NUM 16:32" /><verse number="33" style="v" sid="NUM 16:33" />Cine penui nah penui mabam leune Sheol ga mring nghung di. Kideube penui reu gade ngkui di, nah penui hemaabe kakgade gah di. <verse eid="NUM 16:33" /><verse number="34" style="v" sid="NUM 16:34" />Penuide twagwa kebam Israelme leune penui kehap kwa siulu eh pakdi. Penui ranggai, “Kideube anuide de mnwa teu dide cilak!” <verse eid="NUM 16:34" /><verse number="35" style="v" sid="NUM 16:35" />Ge RAMPAUBE dade mi heu petdi nah perim kehengui teugwang kebam mipei 250 de ngkapdi.<verse eid="NUM 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 16:36" />RAMPAUBE Moses de mpau dai, rang eh, <verse eid="NUM 16:36" /><verse number="37" style="v" sid="NUM 16:37" />“Cingkube Aaron napei Eleazar de resiu gailo nah peu pecu miheu gade mi kehengui kerubung keulu, kedanemene kehengui kerubung cidungde a ziemne kai ntsam pwakebam ne. Pecai peu pecu ru kebam miceudung de kemdei gage kai dilu. <verse eid="NUM 16:37" /><verse number="38" style="v" sid="NUM 16:38" />Mina penui mau ziemne penui teilung ngkap kedime kehengui kerubung keulu. Cidungde hedeu pwa kerecaki gumlu kerane makwak teilu. Cipaume RAMPAUBE dage cidung reca teigai, cine cidungde a ziemne kai ntsam pwabam. Cidungde Ih bamlie kecu Israelme ziemne marengei ge zie.”<note caller="-" style="x"><char style="xo" closed="false">16:38 </char><char style="xt" closed="false"><ref loc="HEB 12:3">Heb. 12:3</ref></char></note><verse eid="NUM 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 16:39" />Cingkube Eleazar hetageu kehengui kerubung mina ru kedime ne reca tei kegaidung de keulu, nah cidungde hedeu pwa kerecaki gumlu kerane makwak teilu, <verse eid="NUM 16:39" /><verse number="40" style="v" sid="NUM 16:40" />Israelme ziemne peu ma nsung bamlu kerane, iciu eh peu Aaron leuh kemak sangme migede RAMPAUBE dage gwang perim kehengui rugai kelakne, iciu eh penui Korah nah pe maame nzwa di melu kerane, RAMPAUBE Moses dage aja kai kegai nzwa.<verse eid="NUM 16:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 16:41" />Dede pecai benai Israel ga hemaabe pelane Moses nah Aaron dage ncam gai. Penui ranggai, “Nnai RAMPAUBE minadung de teitset dida.” <verse eid="NUM 16:41" /><verse number="42" style="v" sid="NUM 16:42" />Pecai, hemaabe Moses nah Aaron de mcau eh gwang ngkwa keludau, penui kengkwa paiki ga piegai nah, ainie, hemwa de ne cide gum pwabam. RAMPAUBE kendu de ngau gai, <verse eid="NUM 16:42" /><verse number="43" style="v" sid="NUM 16:43" />nah Moses nah Aaron kengkwa paiki dwaga gwanglu. <verse eid="NUM 16:43" /><verse number="44" style="v" sid="NUM 16:44" />Pecai RAMPAUBE Moses de mpau, rang eh, <verse eid="NUM 16:44" /><verse number="45" style="v" sid="NUM 16:45" />“Aipau hemaabe dade tetdi lu iciu eh Ih penuide ngkap zette dilu kerane.” Pecai Moses nah Aaron hangdeu ga penai zu keumie gai. <verse eid="NUM 16:45" /><verse number="46" style="v" sid="NUM 16:46" />Moses Aaron dage ranggai, “Kehengui kerubung de keulu, kerecaki gade mi keulu eh cikage kailu, cikage perim kehengui kailu, hemaabe dage cide pwa mie zette gai cu, nah penui ziemne tei kemci renet teigailu, kedanemene rata RAMPAUBE dade gwangla de kecune. Mateei de ndeu dida.” <verse eid="NUM 16:46" /><verse number="47" style="v" sid="NUM 16:47" />Cine Moses rang kegai nzwa Aaron cide teigai. Pa hemaabe kakga sum ga pak mie. Mateei cide minadung dage zangra gwang zette di, cine pa perim kehengui keulu eh minadung ziemne tei kemci renet teigai. <verse eid="NUM 16:47" /><verse number="48" style="v" sid="NUM 16:48" />Aaron ketsaime nah keringme kakga saplu; aizwa eh mateei de mtak di. <verse eid="NUM 16:48" /><verse number="49" style="v" sid="NUM 16:49" />Mateei gade tsai kedi peupei au 14,700, Korah ziemne tsai kedime de si mene. <verse eid="NUM 16:49" /><verse number="50" style="v" sid="NUM 16:50" />Aaron kengkwa paiki kimui ga Moses taiga cailigwang, nah mateei de mtakdi.<verse eid="NUM 16:50" /></para>
  <chapter eid="NUM 16" />
  <chapter number="17" style="c" sid="NUM 17" />
  <para style="s">Aaron Tui Bwakedi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 17:1" />RAMPAUBE Moses de mpau, rang eh, <verse eid="NUM 17:1" /><verse number="2" style="v" sid="NUM 17:2" />“Israelme de rang beulo nah hetuitiedung penui dade keulu, pautsa leuhme ziemne ketket ramcau, hetuitie kereiehkena. Petui ramcau gage mina zi be raulu. <verse eid="NUM 17:2" /><verse number="3" style="v" sid="NUM 17:3" />Nang Levime tui gage Aaron zi raulu maisia. Cika pe pautsa leuhme gade muiteume ziemne hetuitie ketket ramcau bam maisia. <verse eid="NUM 17:3" /><verse number="4" style="v" sid="NUM 17:4" />Nang hetui cidungde Ih ncu redau kela paiki ga, samkakkelu zai dwa gage kailu. <verse eid="NUM 17:4" /><verse number="5" style="v" sid="NUM 17:5" />Ih mina kedet kelube gu tuitie de peu bwapet kera teibeu zie. Ih tei mtak dizie Israelme ncam kebamdungde, penui nnuide rangmsia kebamdung de.” <verse eid="NUM 17:5" /><verse number="6" style="v" sid="NUM 17:6" />Cide ziemne Moses Israelme dage rang kecu tei. Heleuhdung muiteume leune Moses de tuitiedung peu, muiteu ge tuitie ketket, pautsa leuhdung gade kedetkelu tuitie ge, peciakne ge kereiehkena. Aaron gu tuitie de cipaumedung kakga bam. <verse eid="NUM 17:6" /><verse number="7" style="v" sid="NUM 17:7" />Pecai Moses hetuitiedung de RAMPAUBE dwaga samkak kelu bung paiki gage kaibeu di.<verse eid="NUM 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 17:8" />Pecia benai Moses samkakkelu bung paiki ga nlüt nah, ainie, Aaron gu petui Levi leuhme ziemne bwabam dida. Cide bwa luge pepa palu nah almond tsi meu eh bui lu! <verse eid="NUM 17:8" /><verse number="9" style="v" sid="NUM 17:9" />Moses RAMPAUBE dwa gade hetuitiedung pelane pwa mpetlu eh Israelme pelane petui riep peu pwalu. <verse eid="NUM 17:9" /><verse number="10" style="v" sid="NUM 17:10" />RAMPAUBE Moses dage rang, “Aaron tui de pwalu eh samkak bung dwa gage kai lulo. Renia kelame ziemne peu cet caililu kera marengei de cika ge kainzeu gailu ciu eh nnui acu ncam kecu bam tadi lu kerane, mecai penui tsai dizie.”<note caller="-" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="HEB 9:4">Heb. 9:4</ref></char></note> <verse eid="NUM 17:10" /><verse number="11" style="v" sid="NUM 17:11" />RAMPAUBE aja kaikebeu nzwa eh Moses teicanglu.<verse eid="NUM 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 17:12" />Israelmedung Moses de mpau, rang eh, “Anui aikade tsai gaizie da. Anui pelane ngkap dizie! <verse eid="NUM 17:12" /><verse number="13" style="v" sid="NUM 17:13" />Mikeheibe de RAMPAUBE gu paiki ga tet hang cai, tsai zie. Anui ngkap ciak maisia ni?”<verse eid="NUM 17:13" /></para>
  <chapter eid="NUM 17" />
  <chapter number="18" style="c" sid="NUM 18" />
  <para style="s">Cingkume nah Levime Tadung</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1" />RAMPAUBE Aaron dage rang, “Nang, n napeidung, nah n pautsamedung ne kerecaki gage kemaudung leune teikegai de nnui ndwazie zie. Dede nang nah n napeimedung cingkume kebamme keheibe kemau ketei pekiene ziemne nnui ndwazie zie. <verse eid="NUM 18:1" /><verse number="2" style="v" sid="NUM 18:2" />Ngu peupeime Levi leuhme ziemne, n pautsa leuhme, nang penui de nda ngngwa gwanglu maisia ciu eh penui n caisuilu kerane nah nang nah n napeidung samkak hezaidung gu paiki dwaga heta tei kecudau ncu ngha lu kerane. <verse eid="NUM 18:2" /><verse number="3" style="v" sid="NUM 18:3" />Penui ncu ngha lu maisia paiki pelane tadung ga. Ciciuliede, penuide peu kemci ni gadung mede recabam taigadung peu gwang nna so, ciciu mecai penui de nah nang de tsai zie. <verse eid="NUM 18:3" /><verse number="4" style="v" sid="NUM 18:4" />Penui ncu ngngwa lu eh nah paiki de pie rengei kecu, paiki ta ketei leune ga heta teizie. Sangme ge de peu n taiga nna so. <verse eid="NUM 18:4" /><verse number="5" style="v" sid="NUM 18:5" />Nang kemci ni na recabam dede pie rengei lu maisia a rata Israel meda gwang dai melu kerane. <verse eid="NUM 18:5" /><verse number="6" style="v" sid="NUM 18:6" />Pielulo, Ih ne Levime de Israelme leuhme kakga de kedet luda. Penui au n ziemne mapeu ge, paiki de riangkeu eh ngngwa heta teilu kera acu peu.<note caller="-" style="x"><char style="xo" closed="false">18:6 </char><char style="xt" closed="false"><ref loc="HEB 9:6">Heb. 9:6</ref></char></note> <verse eid="NUM 18:6" /><verse number="7" style="v" sid="NUM 18:7" />Dede Aaron nah n namedung rünne cingku ta keheibe recabam gu ni nah pai lungki ga kebam tadung nnui ne teizie. Nangne cipau tadungde pei rengei nah n zieh zie. Ih nnui de cingku tatei kerane mapeu peu gaila. Sangme keheibede cika gwang nna kecume de teitset di maisia.”<verse eid="NUM 18:7" /></para>
  <para style="s">Cingkume nah Levime ziemne Recadung</para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8" />Iciu eh RAMPAUBE Aaron de rang, “Pielo, a dage recadung teicuh kera tadung de Ih ncu pierengei kera peugai dida, nah kemci recadung leune Israel minadung acu pwapeu kecude. Ih ratak pekiene nlie kera ncu nah n name de peu dida. <verse eid="NUM 18:8" /><verse number="9" style="v" sid="NUM 18:9" />Aide ngu luzie kemci ratak mi gage rudi kemakdung de. Ratak leune Israel me dade ngau kelube, mei recadung, kemau reca, nah paurui ratak, cipaudung de n ziemne nah n napeimedung ziemne keu mcam pwapeu bamda. <verse eid="NUM 18:9" /><verse number="10" style="v" sid="NUM 18:10" />Aipau ratakdung de au mcitube; mipei leune de kecu tyei maisia, kedanemene n ziemne mci kecu ge. <verse eid="NUM 18:10" /><verse number="11" style="v" sid="NUM 18:11" />Reca aidungde ngu dizie, Israel minadung gu mapeu recadung de penui gu mapeudung gade keumpet ntsam dilu. Ih nnuide peu nnui lie kera habeu kecu tei dida, n napeimedung, nah n napuimedung kelungta ziemne. N kilungme renet gade kemcime keheibe de ratak aidungde tyei lubui. <verse eid="NUM 18:11" /><verse number="12" style="v" sid="NUM 18:12" />Maca yitube, zau na mei yitube, Israelme makai raitube RAMPAUBE da peu kecube dung aidung pekiene Ih nnuide peubeu dida. <verse eid="NUM 18:12" /><verse number="13" style="v" sid="NUM 18:13" />Maleune penui deu gade petsi bui eh meu kelu raitube Israelme RAMPAUBE da teugwang kelabe pekiene, cidungde ngu zie. N Kelak renet gade kemcime cidungde tyei lubui. <verse eid="NUM 18:13" /><verse number="14" style="v" sid="NUM 18:14" />Israelme acu teimci kebeu keheibe de ngu. <verse eid="NUM 18:14" /><verse number="15" style="v" sid="NUM 18:15" />Keheibe pe mnabam nkei kecube, Israelme RAMPAUBE de kepeu neraibe peciangne, mina de nah makaune de ngu zie. Ciciuliede, mina keheibede mipeina neraibe de lui caili dailu maisia, nah mci kemak makaune peseu neraibedung de de lui caili dailu maisia. <verse eid="NUM 18:15" /><verse number="16" style="v" sid="NUM 18:16" />Cipau lui caili kerabe dungde kei ge cangdi cai lui caili dilu maisia. Iciucai mina penuide lui caili dai lubui, pemi rangkanggeu mengei le, kerecaki rangkanggeu gu perüt de gade, cide gerahs ngkai nsamkap. <verse eid="NUM 18:16" /><verse number="17" style="v" sid="NUM 18:17" />Dede ketumpuina, mede meurünna mede hemeudung mciu kelu raitubedung, nang cidungde de lui heli dailak; aide a ziemne keutsam ceu kecubedung lugu. Nang penui jai de ratakbam gage kezin gailu nah mi le penui ca de ru gai eh keru reca pwapeu lu, RAMPAUBE pesui kela perim keyi de. <verse eid="NUM 18:17" /><verse number="18" style="v" sid="NUM 18:18" />Penui teih de ngu dizie. Cide petung nah pepi zetle nzwa, penui teih de ngu dizie. <verse eid="NUM 18:18" /><verse number="19" style="v" sid="NUM 18:19" />Kemci recadung pekiene Israelme RAMPAUBE de kepeudung de, Ih nnuide pwapeu dida, nah nna mipeinadung nah mipuinadung liede si eh, nlie bammui kerabe guda. Aide mcai le samkakkelu gu, ntiptube samkak kelungtane gu, RAMPAUBE dwa gade n ziemne nah n da kebamme n kibaumedung ziemne.” <verse eid="NUM 18:19" /><verse number="20" style="v" sid="NUM 18:20" />RAMPAUBE Aaron de rang eh, “Nang Israelme gu deu ga hema gumlu kebui kette ga, mede nang hemaa kwa gede Israelme kakga bamlak. Israelme kak gade acu le pwane n hema na nlie delie.<verse eid="NUM 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 18:21" />Pielo, Ih Levi leuhme de, Israel ga kereizige pekiene penui ziehi peu dida paiki ga bata tei eh bam kecu ziemne.<note caller="-" style="x"><char style="xo" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="HEB 7:5">Heb. 7:5</ref></char></note> <verse eid="NUM 18:21" /><verse number="22" style="v" sid="NUM 18:22" />Cu gade Israelmedung kengkwa paiki tai nna si lakta, meliecai penui zie eh da kemau aide ziemne nah tsai kecu teizie. <verse eid="NUM 18:22" /><verse number="23" style="v" sid="NUM 18:23" />Levime paiki ga heta ketei ga makam tei maisia. Cide ga kemau ketaheibe liede penui ne teupung zie. Aide teili daigai kelak hezai gezie n leuhme ceheu pelane ga. Israelme kakga penui hemaa kegum bamlak. <verse eid="NUM 18:23" /><verse number="24" style="v" sid="NUM 18:24" />Kedanemene Israelme gu kereizige, cipaude RAMPAUBE da pwapeu kelabe penui maha zi gade, aidungde Ih Levime de penui mabam kera peu dida. Cide ziemne Ih penuide rang dida, ‘Penui Israelme kakgade hema gumkera kette bam kerabe ma.’”<verse eid="NUM 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25" />RAMPAUBE Moses de mpau, rang eh, <verse eid="NUM 18:25" /><verse number="26" style="v" sid="NUM 18:26" />“Nang Levimedung de rangbeu lulo, ‘Nang Israelme dade kereizige Ih n mapwa tei kerane penui dade nnuide ha kebeude nang ngau keludau, nang cide gade RAMPAUBE de kereizige pwapeu zie. <verse eid="NUM 18:26" /><verse number="27" style="v" sid="NUM 18:27" />Nnui mapeu cide nang nsuiyi eh mei kereizige nzwa eh ciukeneu bam gade mede kubetsi dui tei mpet kelu gade peu maisia. <verse eid="NUM 18:27" /><verse number="28" style="v" sid="NUM 18:28" />Cine nang liede Israelmedung dade kereizige ngau keludung leune RAMPAUBE de peulu maisia. Cidungde gade nang cingkupei Aaron pe qwa peulu maisia. <verse eid="NUM 18:28" /><verse number="29" style="v" sid="NUM 18:29" />Nang ngaukelu cidung pekiene gade, n mapeu leune RAMPAUBE de peu maisia. Nang aidungde tei kecudau mania yitube na mcitube ncu pwapeu kecu gade tei maisia.’ <verse eid="NUM 18:29" /><verse number="30" style="v" sid="NUM 18:30" />Cide ziemne nang penuide rangbeu maisia, ‘Nang mapeu yitube pwapeu kecudau, cide Levime zi gade teigailu maisia hecaipung nah kubetsi dui tei mpet kecu gade. <verse eid="NUM 18:30" /><verse number="31" style="v" sid="NUM 18:31" />Nang n mapeu pekebangbe dungde tyei lubui heni kehei gade, nang nah n kelakdung, kedanemene aide nziehi pwa caili kebeu paiki ga n tatei kela ziemne delu. <verse eid="NUM 18:31" /><verse number="32" style="v" sid="NUM 18:32" />Nang RAMPAUBE de magade mapeu nang ngaukelu ma yitube pwapeu dicai, nang tyei bamde nah sak bamde maudi delie de kecube n da bamlak. Dede nang Israelme gu kemci reca de tei hera diso, mecai nang tsai zie.’”<verse eid="NUM 18:32" /></para>
  <chapter eid="NUM 18" />
  <chapter number="19" style="c" sid="NUM 19" />
  <para style="s">Teikemci Dui</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1" />RAMPAUBE Moses penai Aaron de mpau, rang eh, <verse eid="NUM 19:1" /><verse number="2" style="v" sid="NUM 19:2" />“Aide au hezai ge, hezai Ih nnuide aja kai kebeu ge: Israelme de rangbeu eh penuide peu hetumna kegie ge pe kemnei gah mede zamra di kemakpe teugwang maisia lie beulu, nah madaude ngwanggai pungkemak ge. <verse eid="NUM 19:2" /><verse number="3" style="v" sid="NUM 19:3" />Hetumpuina cide de cingkupei Eleazar de peulu. Pa cide paiki hegwale teupet lu eh mige de peu pe dwa gade gi maisia. <verse eid="NUM 19:3" /><verse number="4" style="v" sid="NUM 19:4" />Cingkube Eleazar cipau jai de pe zurang le keulu eh nah paiki dwa lebie ge pia hena kezin gai zie. <verse eid="NUM 19:4" /><verse number="5" style="v" sid="NUM 19:5" />Cingkube kedame ge hetumpuina Eleazar kebam gade ru dizie. Pa cide gu pegeu, peteih, nah pejai gage peteu de ncüt eh ru di maisia. <verse eid="NUM 19:5" /><verse number="6" style="v" sid="NUM 19:6" />Cingkube cedar tsing, hyssop, na heria kegie ge keulu eh hetumpuina de rubam kecu ga heling gai maisia.<note caller="-" style="x"><char style="xo" closed="false">19:6 </char><char style="xt" closed="false"><ref loc="HEB 9:19">Heb. 9:19</ref></char></note> <verse eid="NUM 19:6" /><verse number="7" style="v" sid="NUM 19:7" />Pecai pa pe paini heta di nah duipia di maisia. Iciu eh pa paiki ga nlüt luzie, cikade pa ting hegi kecang renet gade mci mene bam dizie. <verse eid="NUM 19:7" /><verse number="8" style="v" sid="NUM 19:8" />Hetumna de ru kedibe de pe painidung dui gade heta nah duipia di maisia. Pa tinghegi kecang renet gade mci mene bamzie. <verse eid="NUM 19:8" /><verse number="9" style="v" sid="NUM 19:9" />Mige renet gade mci bam cume ge hetumpuina gu mimüt de pwa hekwalu eh nah paiki hegwale mci kebam bam gage kaidi maisia. Aipau mimütdung de Israelme hemaabe ziemne kainzeu maisia. Penui mimüt cide dui gage kai ncüt lu eh kemau gade tei kemci zai tei kerane, mimüt cide kemau ratak gu kecu ziemne.<note caller="-" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="HEB 9:13">Heb. 9:13</ref></char></note> <verse eid="NUM 19:9" /><verse number="10" style="v" sid="NUM 19:10" />Mina be hetumpuina gu mimüt pwa hekwa kecube de pe paini heta di maisia. Pa renet gade ting hegi kecang mci lak. Aide Israelme ziemne hezai teili gaikelak zai ge zie nah sangme penuide ngngwa lungh kebamme de.<verse eid="NUM 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11" />Mina caucau ketsaipau de tung dibi cipaume lang henane ge renet gade mci lak. <verse eid="NUM 19:11" /><verse number="12" style="v" sid="NUM 19:12" />Cipaume lang pekecum benai nah lang henane benai pekatei pecu teimci di maisia. Cipaucai pa mci dizie. Dede magade pa lang pekecum benai pecu teimci mecai, iciucai lang henane benai pa mci gailak. <verse eid="NUM 19:12" /><verse number="13" style="v" sid="NUM 19:13" />Mikeheibe de ketsaipau de tungdi, mina pumteih tsai kedibe de, nah pekatei pecu teimci lu mecai, cipaube RAMPAUBE gu paiki de teihera dida. Cipau de Israelmena lie qu silak kedanemene tei kemci dui pereu gage kezin gai kemakne. Pa hera bam dizie; kehera de peda lamui dizie.<verse eid="NUM 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14" />Hezai aide paiki gade tsaidi kedime ziemne. Mi pekiene paiki ga kelüt me nah paiki ga kebamme lang henane ge mci mene bam dizie. <verse eid="NUM 19:14" /><verse number="15" style="v" sid="NUM 19:15" />Paiki ga mabung pegum kegabe leune de hera kecu tei dizie. <verse eid="NUM 19:15" /><verse number="16" style="v" sid="NUM 19:16" />Cide siakte keheibe de ketsaipau kingtie gade tsai kedime ge de tungcai, ketsaipau keheibe liede, mina rah, mede herau ge tungcai, cipaume ge lang henane ge hera dizie. <verse eid="NUM 19:16" /><verse number="17" style="v" sid="NUM 19:17" />Aide nang mci kemakme ge de tei beulu: Kemau reca mimüt ru kenzeu de keulu nah li ge gage kemci dui penai kerui ncüt lu. <verse eid="NUM 19:17" /><verse number="18" style="v" sid="NUM 19:18" />Mige mci kebamme ge iciu eh hyssop keulu maisia, dui gage mpung lu, nah paiki gage kezin gailu, cika mabung kebam pekiene ga, mina cika kebamme de, nah pera tung kedime ge de, teitset kedime ge de, tsai kedime ge de, mede herau tung kedi mede de. <verse eid="NUM 19:18" /><verse number="19" style="v" sid="NUM 19:19" />Lang cumne benai nah lang henane benai, mci kebamme gene mci kemakme ge de kezin gai zie. Lang henane benai mci kemakme ge pekatei pecu ratak tei kemci zai teizie. Pa pepai peni hui mci dizie nah dui pia dizie. Tinghegi dicai pa mci dizie.<note caller="-" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="HEB 9:13">Heb. 9:13</ref></char></note><verse eid="NUM 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 19:20" />Dede mige mcimene bam cai, pekatei pecu teimci laklie dicai, cipaume de heleuhbe gade langgi dizie, kedanemene cipaude ne RAMPAUBE gu paiki tei heradi de lugu. Mcikemak ziemne dui le pecu kezin gai kemak nzwa eh; pa mcimene bam dizie. <verse eid="NUM 19:20" /><verse number="21" style="v" sid="NUM 19:21" />Hezai aide teilu eh teidai dai kecube ge zie aikenzwa dau kecudau. Ratak dui kehera gage kezin gai kecu mege pe paini heta di maisia. Cauge mci mene dui cide tung dibi tinghegi kemaktane hera bam dizie. <verse eid="NUM 19:21" /><verse number="22" style="v" sid="NUM 19:22" />Hera kecumege keheibe tung cai hera dizie. Tung hera kedi reuga mige tung daicai cipaume ge hera bam dizie ting hegi gwang kemaktane.”<verse eid="NUM 19:22" /></para>
  <chapter eid="NUM 19" />
  <chapter number="20" style="c" sid="NUM 20" />
  <para style="s">Tsura gade Dui</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1" />Cine Israelme, tingbungme pelane, Zin hetaideu ga raitube kei gwanglu; penui Kadesh ga bam di. Cikade Miriam tsaidi nah pecu kungdi.<verse eid="NUM 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 20:2" />Israel tingbungme ziemne dui gah di, cine penui ngkwa lwe Moses penai Aaron de mmau di. <verse eid="NUM 20:2" /><verse number="3" style="v" sid="NUM 20:3" />Minadung Moses de ncam eh mmau di. Penui rang eh, “Anui kangme Israelme RAMPAUBE dwa gade tsai kecudau anui de tsai dicai yiki! <verse eid="NUM 20:3" /><verse number="4" style="v" sid="NUM 20:4" />Daitei eh nnai RAMPAUBE tingbungme de hetaideu aide gage ngngwa gwang gaino peu tsai kera, anui nah anui kaunedung de? <verse eid="NUM 20:4" /><verse number="5" style="v" sid="NUM 20:5" />Daitei nnai anui de Egypt gade ngngwa mpet lwe kehing ni gage ngngwa gwang gaino? Aika au ma leuh, tangzüttsi, kubetsi mede kuraletsi de gah, nah dui sak kera de gah.”<note caller="-" style="x"><char style="xo" closed="false">20:5 </char><char style="xt" closed="false"><ref loc="HEB 3:8">Heb. 3:8</ref></char></note> <verse eid="NUM 20:5" /><verse number="6" style="v" sid="NUM 20:6" />Cine Moses nah Aaron ngkwa kecu ni gade tet di. Penai paiki kimui ga mielu nah penai zu keumie lu. Cika de RAMPAUBE kebaa kendu penai de peu ngaugai. <verse eid="NUM 20:6" /><verse number="7" style="v" sid="NUM 20:7" />RAMPAUBE Moses de mpau, rang eh, <verse eid="NUM 20:7" /><verse number="8" style="v" sid="NUM 20:8" />“Hetui de keulu nah tingbungme de qu hekwalu, nang, nah n sinabe Aaron nnai. Tsurakang dage marang gailo penui dwa gade, nah cide gade dui lwapet lo ranggai lo. Nang tsurakang cide gade dui tei mpetlu zie penui ziemne nah nang tingbungme, nah penui kaunedung de peu sak kerane peu maisia.” <verse eid="NUM 20:8" /><verse number="9" style="v" sid="NUM 20:9" />Moses RAMPAUBE dwa gade hetui keulu, RAMPAUBE pecu tei lulo aja kaikebeu nzwa.<verse eid="NUM 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 20:10" />Ge Moses penai Aaron minadung de tsurakang dwa gage qu hekwalu. Moses penui dage rang eh, “Kingneilu, nnui zai kesiamedung. Anui nnui ziemne tsurakang aide gade dui keu mpet maisia ni?” <verse eid="NUM 20:10" /><verse number="11" style="v" sid="NUM 20:11" />Cine Moses pe ba hwacuh lu nah tsurakang de petui le piana dapgai nah dui lwa süt petlu. Israel tingbungme saklu, nah penui kaunedung de saklu. <verse eid="NUM 20:11" /><verse number="12" style="v" sid="NUM 20:12" />Ge RAMPAUBE Moses penai Aaron dage rang, “Kedanemene nnai Israelme miakngau gade Ih mci lie de eh acu nlum ma mede rüt kemakne nnai mina aidungde de Ih ne penuide hangdeu ha kebeu dega ngngwa gwang gailak.” <verse eid="NUM 20:12" /><verse number="13" style="v" sid="NUM 20:13" />Heni aide de Meribah dui de qu di kedanemene Israelme cikade RAMPAUBE de ngngwa kesamlim nah pa pe kemci penuide keulia kecune. <verse eid="NUM 20:13" /><verse number="14" style="v" sid="NUM 20:14" />Moses samgwamedung de Kadesh gade Edom ga hegwangpei dage langgai: N sinabe Israel aide rangla: “Nang ma kehung pelane anui dage tei kegai cibam. <verse eid="NUM 20:14" /><verse number="15" style="v" sid="NUM 20:15" />Anui paumedung Egypt ga mie nah peting ketie ge Egypt ga lungh kedi nnui cibam. Egyptmedung anuide tei keherei süt nah anui paumedung de liede. <verse eid="NUM 20:15" /><verse number="16" style="v" sid="NUM 20:16" />Anui RAMPAUBE de qu kegai dau, pa anui kwa siulu nah tinggimgwame ge de langgai nah anuide Egypt gade ngngwa mpet beu. Pielo, anui au renam ge n deurai ga kebam Kadesh ga bam. <verse eid="NUM 20:16" /><verse number="17" style="v" sid="NUM 20:17" />Ih n dade kiela peu anui de n deu kahgwang kerane. Anui luh mede kubetsi luh kahgwang lak, meliene n tekwadung gade dui de sak lak. Anui hegwangpei lampui puidi ga lazie. Anui zetle mede hile de nreu lak n rai de kahdi kemaktane.” <verse eid="NUM 20:17" /><verse number="18" style="v" sid="NUM 20:18" />Dede Edom ga hegwangpei pecu keli eh, “Nnui de peu aide gade kahgwang gailak. Nnui kahgwang cai, Ih kingtie pwalwe gwang nnuide ketang zie.” <verse eid="NUM 20:18" /><verse number="19" style="v" sid="NUM 20:19" />Israelme pe dage rang eh, “Anui puidi ga lazie. Magade anui mede anui kaunedung n dui sak cai, anui cide ziemne pemi peu zie. Peu anui de hepi le tet kahgwang lo, magede tei si mene.” <verse eid="NUM 20:19" /><verse number="20" style="v" sid="NUM 20:20" />Dede Edom ga hegwangpei keli eh, “Nnui tet kahgwang gailak.” Cine Edom ga hegwangpei Israel de mmau eh kengkieng reugwame kekiee ge ngngwa lwe gwang. <verse eid="NUM 20:20" /><verse number="21" style="v" sid="NUM 20:21" />Edom ga hegwangpei Israel de penui rai de kah laklie kamdi. Aide ziemne Israel Edom deu gade caili di.<verse eid="NUM 20:21" /></para>
  <para style="s">Aaron Tsit</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22" />Cine minadung Kadesh gade tet gai. Israelme, tingbungme pelane, Hor deutu ga gwanglu. <verse eid="NUM 20:22" /><verse number="23" style="v" sid="NUM 20:23" />RAMPAUBE Moses penai Aaron de Hor deutu, Edom deurai gade mpau, rang eh, <verse eid="NUM 20:23" /><verse number="24" style="v" sid="NUM 20:24" />“Aaron de pe minadung de ngngwa ncütlu maisia, kedanemene Ih hangdeu Israelme de kepeu ga pa nlüt gailak. Aide au kedanemene nnai hangna Meribah dui gade a sam mlai kedine.<note caller="-" style="x"><char style="xo" closed="false">20:24 </char><char style="xt" closed="false"><ref loc="DEU 32:50">Hez. 32:50</ref></char></note> <verse eid="NUM 20:24" /><verse number="25" style="v" sid="NUM 20:25" />Aaron penai pe napei Eleazar de ngngwa lu nah penai de Hor deutu ga ngngwa hanglu. <verse eid="NUM 20:25" /><verse number="26" style="v" sid="NUM 20:26" />Aaron cingku painidung ra mpet lwe pe napei Eleazar de kaibeu lu. Aaron tsai maisia nah peu pe mina da ncüt dilu.” <verse eid="NUM 20:26" /><verse number="27" style="v" sid="NUM 20:27" />Moses RAMPAUBE rang kebeu nzwa teilu. Penui Hor deutu ga hanglu tingbungme pelane miakngau gade. <verse eid="NUM 20:27" /><verse number="28" style="v" sid="NUM 20:28" />Moses Aaron cingku painidung ra mpetlu nah cidungde pe napei Eleazar de kaibeu di. Aaron lamlwatu reu cika de tsaidi. Ge Moses penai Eleazar nghung di. <verse eid="NUM 20:28" /><verse number="29" style="v" sid="NUM 20:29" />Tingbungme pelane Aaron tsai kedi ngaulu ge, heleuh pelane Aaron ziemne zie camrei ge hap bam di.<verse eid="NUM 20:29" /></para>
  <chapter eid="NUM 20" />
  <chapter number="21" style="c" sid="NUM 21" />
  <para style="s">Arab Ngkapkedi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1" />Canaanme gwangpei Arad, Negev ga lungh kebambe, Israel Atharim lampui ga nbeuh gwangla lie kecu siulu ge, pa Israel de ngngwa regi nah penui kangge de tuilu. <verse eid="NUM 21:1" /><verse number="2" style="v" sid="NUM 21:2" />Israel RAMPAUBE dage sampet gai nah rang eh, “Nang anuide mina aidung de reu kengking peu liecai, iciucai anui penui namdidung teimsia ciak dizie.” <verse eid="NUM 21:2" /><verse number="3" style="v" sid="NUM 21:3" />RAMPAUBE Israelme kwa kingneilu nah pa Canaanme reu ngkienglu kera peu. Penui minadung nah penui namdidung ngkap ciak dedi. Heni cide de Hormah qu di.<verse eid="NUM 21:3" /></para>
  <para style="s">Hegeu Nei</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4" />Penui Hor Lamlwa gade tetpwa jaaidi kegie ga kegwang lampui gage tetgai Edom deu de tet tegwa kerane. Minadung lampui gade penui sui siasüt di. <verse eid="NUM 21:4" /><verse number="5" style="v" sid="NUM 21:5" />Minadung Tinggwang penai Moses de mmau eh rang: “Daitei nang anuide Egypt gade ngngwa mpet no peu hetaideu gade tsai kera? Tangku gah, dui de gah, nah anui taktyei kemneu aide anui sui ma.” <verse eid="NUM 21:5" /><verse number="6" style="v" sid="NUM 21:6" />Pecai RAMPAUBE henei keradung minadung kakga ge langgai. Heneidung mina de nsau; mina kekiee ge tsaidi. <verse eid="NUM 21:6" /><verse number="7" style="v" sid="NUM 21:7" />Minadung Moses da gwang eh pe dage ranggai, “Anui kemau tei dida kedanemene anui ncu nah RAMPAUBE de mmau eh rang kedine. RAMPAUBE dage pe ziemne kekie tei gailo heneidung de anui dade keu daidi kerane.” Cine Moses minadung ziemne kekie teigai. <verse eid="NUM 21:7" /><verse number="8" style="v" sid="NUM 21:8" />RAMPAUBE Moses dage ranggai, “Henei ge teilu nah tsingtie ge gage kailu. Mina keheibe de henei ne nsau kedime ringlu zie, pa cide piegai liecai.” <verse eid="NUM 21:8" /><verse number="9" style="v" sid="NUM 21:9" />Cine Moses hetageu gu henei ge teilu delwe tsingtie ge gage cide kai. Henei mina keheibede de nsau kedi dau, magade pa hetageu gu henei de pie cai, pa ring lubui.<note caller="-" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="JHN 3:14">Jhn. 3:14</ref></char></note><verse eid="NUM 21:9" /></para>
  <para style="s">Moab ga Mbeuh kemie</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10" />Ge Israelme mbeu jüja gwang nah Oboth gage ramzeuki teilu. <verse eid="NUM 21:10" /><verse number="11" style="v" sid="NUM 21:11" />Penui Oboth gade tetkai nah hetaideu ga Iye Abarim naimiak kepetle Moab de kemcwa gage ramzeuki teilu. <verse eid="NUM 21:11" /><verse number="12" style="v" sid="NUM 21:12" />Cika de penui tetkai dai nah Zered Langkie gage ramzeuki teilu. <verse eid="NUM 21:12" /><verse number="13" style="v" sid="NUM 21:13" />Cika de penui tet jüja eh Arnon Reuki lule gimle ge ramzeuki teilu, cide Amoritme gu deurai gade hetaideu ga miecang kecu ga. Moab nah Amoritme kakga, Arnon Reuki ne herai. <verse eid="NUM 21:13" /><verse number="14" style="v" sid="NUM 21:14" />Cide ziemne RAMPAUBE Reutak laisiudum ga rangla,</para>
  <para style="q" vid="NUM 21:14">“Suphah ga Waheb, nah Arnon chabakdung,<verse eid="NUM 21:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="NUM 21:15" />chabakdung gu hetia de mie Ar namceu cang kebamde ga</para>
  <para style="q" vid="NUM 21:15">nah Moab deurai de cang kebamde ga.”<verse eid="NUM 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 21:16" />Cika de penui Beer ga gwanglu, tekwa cide gade RAMPAUBE Moses dage ranggai, “Minadung de hekwa ncüt lulo a ziemne penuide dui peu kerane.”<verse eid="NUM 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 21:17" />Pecai Israelme lei aide tei:</para>
  <para style="q" vid="NUM 21:17">“Duiring petlo, tekwa!</para>
  <para style="q" vid="NUM 21:17">Cipau ha de lei teilo,<verse eid="NUM 21:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="NUM 21:18" />anui muiteume ne tekwa kui kecu ha,</para>
  <para style="q" vid="NUM 21:18">hegwang namedung tekwa kekui,</para>
  <para style="q" vid="NUM 21:18">hegwangme tuitie nah penui tuitiedung dene.”</para>
  <para style="m" vid="NUM 21:18">Ge hetaideu gade penui Mattanah ga gwanglu. <verse eid="NUM 21:18" /><verse number="19" style="v" sid="NUM 21:19" />Mattanah gade penui Nahaliel ga gwanglu nah Nahaliel gade Bamoth ga gwanglu, <verse eid="NUM 21:19" /><verse number="20" style="v" sid="NUM 21:20" />nah Bamoth gade Moab deu chabak ga. Cipau Pisgah lamlwa twang gade hetaideu de pie nghung gai.<verse eid="NUM 21:20" /></para>
  <para style="s">Sihon penai Og Ngkapkedi</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21" />Pecai Amoritme gwangpei Sihon dage Israelme ne samgwame de langgai, rang eh, <verse eid="NUM 21:21" /><verse number="22" style="v" sid="NUM 21:22" />“Anui de peu n deu tetkah gwanglo. Anui nnui luhga mede kubetsi luh ga lüt lak. Anui n tekwadung gade dui de sak lak. Anui hegwangpei puidiki ga la zie n deurai de kahdi kemaktane.” <verse eid="NUM 21:22" /><verse number="23" style="v" sid="NUM 21:23" />Dede hegwangpei Sihon Israel de pe deurai kahgwang kera peu tadi. Cimeliene Sihon pe reugwame pelane de qu hekwa lwe Israel de hetaideu gade gwaketang di. Pa Jahaz ga gwanglu, cika de Israel de ngngwa hereu tei. <verse eid="NUM 21:23" /><verse number="24" style="v" sid="NUM 21:24" />Israel Sihon reugwame de kingtie keu eh regi nah pe deu Arnon gade Jabbok reuki kecang, Ammonme deu kemie kecang gumlu. Cu au Ammonme deurai de rie pwabam dida. <verse eid="NUM 21:24" /><verse number="25" style="v" sid="NUM 21:25" />Israelme Amoritme namdidung pelane keulu da nah cidung pelane ga lungh dida, Heshbon de si eh nah renamdung pelane. <verse eid="NUM 21:25" /><verse number="26" style="v" sid="NUM 21:26" />Heshbon au Amoritme hegwangpei Sihon namdi, Moab gwangpei kehegwabe de ngngwa regi kecube pei. Sihon pe deu pelane pe deurai lungga kebam Arnon reuki ga kecang. <verse eid="NUM 21:26" /><verse number="27" style="v" sid="NUM 21:27" />Cide ziemne macisam ga kerangmedung rangla,</para>
  <para style="q" vid="NUM 21:27">“Heshbon ga gwanglu.</para>
  <para style="q" vid="NUM 21:27">Sihon namdi de retak dai nah yidai kelube teilo.<verse eid="NUM 21:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="NUM 21:28" />Mi ge Heshbon gade heu pet,</para>
  <para style="q" vid="NUM 21:28">miheu ge Sihon namdi gade</para>
  <para style="q" vid="NUM 21:28">cide ne Moab ga Ar de teimsia di,</para>
  <para style="q" vid="NUM 21:28">nah Arnon ga heni kehudung mpaumedung.<verse eid="NUM 21:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="NUM 21:29" />Co nnui au tei lubui da, Moab!</para>
  <para style="q" vid="NUM 21:29">Nnui ngkap dida, Chemosh minadung.</para>
  <para style="q" vid="NUM 21:29">Pa pe napeidung de mbai kelame tei dida</para>
  <para style="q" vid="NUM 21:29">nah pe napuimedung de Amoritme gwangpei Sihon baang tei dida.<verse eid="NUM 21:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="NUM 21:30" />Dede cu au anui Sihon reu ngkieng luda. Heshbon au ngkap dida Dibon kecang.</para>
  <para style="q" vid="NUM 21:30">Anui penui reu ngkieng luda Nophah kecang,</para>
  <para style="q" vid="NUM 21:30">cide Medeba cang bam.”<verse eid="NUM 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31" />Cine Israel Amoritme deu ga lungh ndeulu. <verse eid="NUM 21:31" /><verse number="32" style="v" sid="NUM 21:32" />Pecai Moses minadung de Jazer pie kera langgai. Penui Amoritme cika kebamme de gwadi eh renamdung keulu.<verse eid="NUM 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 21:33" />Ge penui nreulu nah Bashan lampui le miedi. Og Bashan hegwangpei penuide mmau eh pa nah pe reugwame pelane Edrei gade penuide regi kera miedi. <verse eid="NUM 21:33" /><verse number="34" style="v" sid="NUM 21:34" />Ge RAMPAUBE Moses dage rang, “Pecu hingso, kedanemene Ih nnuide pe reu, pe reugwame pelane nah pe deu reu ngkienglu kera peu dida. Pe dage tei gailo nang Amoritme hegwangpei, Heshbon ga lungh kebam Sihon dage tei kegai nzwa.” <verse eid="NUM 21:34" /><verse number="35" style="v" sid="NUM 21:35" />Cine penui pecu teitsetdi, pe napeidung, nah pe reugwame pelane, pe minadung de teitset ciakdi kemaktane. Iciu eh penui pe deu gumlu.<verse eid="NUM 21:35" /></para>
  <chapter eid="NUM 21" />
  <chapter number="22" style="c" sid="NUM 22" />
  <para style="s">Balak ne Balaam de Qukegai</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1" />Israelme Moab deu langkie Jericho kenna namdi gade Jordan reuki mbie gage penui ramzeuki teilu kemakta tetla.<verse eid="NUM 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 22:2" />Balak Zippor napei Israel Amoritme dage tei kegai pelane ngaulu. <verse eid="NUM 22:2" /><verse number="3" style="v" sid="NUM 22:3" />Moab au minadung de hing sütdi kedanemene penui au kiee, nah Moab au Israelme de hing eh bam di. <verse eid="NUM 22:3" /><verse number="4" style="v" sid="NUM 22:4" />Moab ga hegwangpei Midian ga hangkiamedung dage ranggai, “Hemaa kedi aide ne anui de twagwa kebam pelane tyeilu zie da hetumseu ge luhga cehei tyei nggah kedi nzwa.” Cipau tingdau Balak Zippor napei ne Moab ga hegwang tei bam. <verse eid="NUM 22:4" /><verse number="5" style="v" sid="NUM 22:5" />Pa samgwamedung de Beor napei Balaam Pethor ga Euphrate reuki taiga kebam, pe leuhme deu nah pe minadung dage langgai. Pa pecu qulu nah ranggai, “Pielo, heleuh ge aika gwang bam Egypt gade. Penui kideu reu puibam dida nah cu penui a taiga nna gwangla dida. <verse eid="NUM 22:5" /><verse number="6" style="v" sid="NUM 22:6" />Cine keherei de cu gwang delwe aipau leuhme de a ziemne reset dilo, kedanemene penui au a ziemne ngkieng zu di kecune. Ciciu lucai Ih penuide gwaketang kera tei lubui, nah penuide hangdeube gade gwa mpet luzie. Nang samlam kegaime de samlam beu kela nah reset kegaime de reset beu kela Ih cibam.”<verse eid="NUM 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7" />Cine Moab hangkiamedung nah Midian hangkiamedung kereka ziemne pemi keulwe tetti. Penui Balaam da gwanglu nah pecu Balak samdung rangbeu. <verse eid="NUM 22:7" /><verse number="8" style="v" sid="NUM 22:8" />Balaam penui dage ranggai, “Heziu aika bamlu, Ih RAMPAUBE a dage daipai rangbeu ziebi nnui da keugwang beu zie.” Cine Moab muiteumedung Balaam de ngngwa cipau ziu bam di. <verse eid="NUM 22:8" /><verse number="9" style="v" sid="NUM 22:9" />Tinggwang Balaam da gwanglu nah ranggai, “N da gwang kebam mina aidungde caugame no?” <verse eid="NUM 22:9" /><verse number="10" style="v" sid="NUM 22:10" />Balaam Tinggwang de keli eh, “Moab hegwangpei Zippor napei Balak, ne penuide a dage langgai lie. Pa ranggai, <verse eid="NUM 22:10" /><verse number="11" style="v" sid="NUM 22:11" />‘Pielo, Egypt gade kegwang minadung ne a deu puipung la dida. Cu gwang eh penuide reset gailo a ziemne. Iciucai Ih penuide regi luzie nah gwa mpet luzie.’” <verse eid="NUM 22:11" /><verse number="12" style="v" sid="NUM 22:12" />Tinggwang Balaam de keli eh, “Nang mina cidungde de ngngwa tet kerabe ma. Nang Israel minadung de reset kerabe ma kedanemene penui au samlam punglu.” <verse eid="NUM 22:12" /><verse number="13" style="v" sid="NUM 22:13" />Balaam tingcang cuhlu delwe Balak muiteumedung de rangbeu, “Nnui deu ga gwang daicu kedanemene RAMPAUBE acu peu nnuide nzang gwang kera rau dida.” <verse eid="NUM 22:13" /><verse number="14" style="v" sid="NUM 22:14" />Cine Moab muiteume tetti nah Balak da gwang daidi. Penui ranggai, “Balaam anui de nzang gwang rau dida.”<verse eid="NUM 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15" />Balak muiteumedung kiee nakge eh keraibe maa swa mlangki kecume de langgai dai. <verse eid="NUM 22:15" /><verse number="16" style="v" sid="NUM 22:16" />Penui Balaam da gwanglu nah pe dage ranggai, “Balak Zippor napei ainzwa rang, ‘Peu ada gwang kerane mage nede ncu kam kedi tei helo, <verse eid="NUM 22:16" /><verse number="17" style="v" sid="NUM 22:17" />kedanemene Ih n ziehi tei hemisüt beuzie nah herüt kedi ge peu zie, nah nang keheibe de teilo de kerangbe Ih tei zie. Cine keherei de gwang eh mina aidungde de a ziemne reset gailo.’” <verse eid="NUM 22:17" /><verse number="18" style="v" sid="NUM 22:18" />Balaam keli eh Balak minadung dage ranggai, “Balak pe hegwangki rangkanggeu nah kecak le pui eh peu liede, Ih RAMPAUBE, a Tinggwang sam gi ka daulak, tei tsam de gailak nah tei kiee de gailak, pa ne acu rang kebeu de gwale. <verse eid="NUM 22:18" /><verse number="19" style="v" sid="NUM 22:19" />Cine cu, keherei de heziu de kwa dailu, iciu de RAMPAUBE a da kerang Ih ci si luzie.” <verse eid="NUM 22:19" /><verse number="20" style="v" sid="NUM 22:20" />Tinggwang tingmui Balaam da gwang nah pecu ranggai, “Mina aidungde ncu gwang qu kela nzwa, cuhlu delwe penuide nzang miecu. Dede Ih rang kebeu be rünne teilu.”<verse eid="NUM 22:20" /></para>
  <para style="s">Balaam gu Gada</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 22:21" />Balaam tingcang cuhlu, pe gada reu nghang lwe Moab muiteumedung de nzang gwang di. <verse eid="NUM 22:21" /><verse number="22" style="v" sid="NUM 22:22" />Dede pa mie kela ziemne, Tinggwang pe rata cuhdi. RAMPAUBE gwame ge lampuiki ga swateu pwadi Balaam de ngau ngkau kelame ge nzwa, gada reu gade hebeu tei kelabe. Balaam pe ngkwetme hangna de ngngwa la. <verse eid="NUM 22:22" /><verse number="23" style="v" sid="NUM 22:23" />Gada RAMPAUBE gwame ge kingtie pwalwe lampui ga sap kebam ngau di. Gada lampui gade nreu lwe luh lebie mie di. Balaam gada de dap eh lampui gage ngngwa cailigwang dailu. <verse eid="NUM 22:23" /><verse number="24" style="v" sid="NUM 22:24" />Ge RAMPAUBE gwame ge lampui nrum kecu sau kubetsi luhdung kakga saplu, kirie pegu zetle nah pegu hile kebam ga saplu. <verse eid="NUM 22:24" /><verse number="25" style="v" sid="NUM 22:25" />Gada RAMPAUBE gwame de ngau dai. Pa tangdeu gage tetgwa gai nah Balaam pi cide gage gimdi. Balaam gada pui de dap dai. <verse eid="NUM 22:25" /><verse number="26" style="v" sid="NUM 22:26" />RAMPAUBE gwame tetsi pet nah heni kenrum keda ga ketlam de nreu gai kelak ga sap. <verse eid="NUM 22:26" /><verse number="27" style="v" sid="NUM 22:27" />Gada RAMPAUBE gwame de ngau, nah pa Balaam kangga zeu di. Balaam pe rata cuhdi nah pa petuitie le gada de dap. <verse eid="NUM 22:27" /><verse number="28" style="v" sid="NUM 22:28" />Ge RAMPAUBE maranglu kera gada mui ngkei beu. Pa Balaam dage ranggai, “Ih n dage daipai teigai eh nang acu pia cum dapno?”<note caller="-" style="x"><char style="xo" closed="false">22:28 </char><char style="xt" closed="false"><ref loc="2PE 2:16">2 Pet. 2:16</ref></char></note> <verse eid="NUM 22:28" /><verse number="29" style="v" sid="NUM 22:29" />Balaam gada de keli eh, “Cide au kedanemene nang a dage heramie tatei kegaine lie. Ih kingtie ge aba ga bamneu da. Ma gade bam liecai ncu cu teitsetdi eh bam zie da.” <verse eid="NUM 22:29" /><verse number="30" style="v" sid="NUM 22:30" />Gada Balaam dade ranggai, “Ih ngu gada nang n teilung pelane a reuga tet eh henai kecang cang meni? Ih aipau dwa a zai aide bam eh cidungde madau gede n dage teigai ni?” Balaam rang, “Ma.”<verse eid="NUM 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 22:31" />Ge RAMPAUBE Balaam miak ngkei beu nah pa RAMPAUBE gwame lampui ga pe kingtie pwalwe sap kebam ngaudi. Balaam pe peu henamie nah pezu keumie di. <verse eid="NUM 22:31" /><verse number="32" style="v" sid="NUM 22:32" />RAMPAUBE gwame pe dage ranggai, “Nang daitie n gada de pia cum dapno? Pielo, Ih au mige ncu ngau keraume ge eh n da gwangla kedanemene n tadung a dwa gade sia kecune. <verse eid="NUM 22:32" /><verse number="33" style="v" sid="NUM 22:33" />Gada acu ngau nah piacum nreu tetdi. Magade pa a dade nreu tetdi mecai, Ih ncu teitsetdi bi zie da nah pe teilung kelibeu zie.” <verse eid="NUM 22:33" /><verse number="34" style="v" sid="NUM 22:34" />Balaam RAMPAUBE gwame dage ranggai, “Ih kemau tei dida. Nang lampui ga acu ngaurau eh sap kebam Ih cima. Cine cu, magade cide nsui melie cai, Ih caili dizie.” <verse eid="NUM 22:34" /><verse number="35" style="v" sid="NUM 22:35" />Dede RAMPAUBE gwame Balaam dage ranggai, “Minadung de ngngwa lwe gwang cu. Dede Ih samdung ncu rang kebeu de rünne nang rang maisia.” Cine Balaam Balak muiteumedung de nzang gwang di.<verse eid="NUM 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 22:36" />Balak Balaam gwangla lie kecu siulu ge, pa pecu redau kerane Moab ga namdi deurai ga kebam Arnon ga miedi. <verse eid="NUM 22:36" /><verse number="37" style="v" sid="NUM 22:37" />Balak Balaam dage ranggai, “Ih minadung de n dage langgai meni ncu qu kerane? Nang daitei a da gwang meno? Ih ncu hetwaherüt peulu tadi ni?” <verse eid="NUM 22:37" /><verse number="38" style="v" sid="NUM 22:38" />Ge Balaam Balak de keli eh, “Pielo, Ih n da gwang bam da. Ih cu ranglu kera magede kengking bam mi gah no? Ih au Tinggwang ne samdung a mui gage kai kebeube rünne rang lubui.” <verse eid="NUM 22:38" /><verse number="39" style="v" sid="NUM 22:39" />Balaam Balak de nzang tetdi nah penui Kiriath Huzoth ga gwanglu. <verse eid="NUM 22:39" /><verse number="40" style="v" sid="NUM 22:40" />Ge Balak hetumseu penai meurün le ratak teigai nah heteih kesa Balaam de nah muiteumedung pecu ngngwa kelame de peu.<verse eid="NUM 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 22:41" />Tingcang, Balak Balaam de Baal hangdeu kehu ga ngngwa hang. Cika de Balaam Israelmedung de penui ramzeuki ga tuge rünne ngau.<verse eid="NUM 22:41" /></para>
  <chapter eid="NUM 22" />
  <chapter number="23" style="c" sid="NUM 23" />
  <para style="s">Balaam gu Miswakegah Keraibe</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1" />Balaam ne Balak dage ranggai, “Aika ge recabam hena a ziemne teilu nah hetumseu hena nah meurünseu hena mteilu.” <verse eid="NUM 23:1" /><verse number="2" style="v" sid="NUM 23:2" />Cine Balak, Balaam kerang nzwa teilu. Iciu eh Balak penai Balaam hetumseu ge nah meurünseu ge recabam ramsang gage peugai. <verse eid="NUM 23:2" /><verse number="3" style="v" sid="NUM 23:3" />Ge Balaam ne Balak dage ranggai, “N keru ratak ga saplu nah Ih mie dizie. RAMPAUBE acu gwang redau de cilak lu. Ma keheibe de acu keu keliabe Ih ncu ranglia zie.” Cine pa hangdeutu reu tsingbangdung kegah ga mie di. <verse eid="NUM 23:3" /><verse number="4" style="v" sid="NUM 23:4" />Pa hangdeutu reu ga kebam dau, Tinggwang pecu redau nah Balaam pe dage ranggai, “Ih recabam hena teilu da nah Ih recabam ramsang gage hetumseu ge nah meurünseu ge peugai dida.” <verse eid="NUM 23:4" /><verse number="5" style="v" sid="NUM 23:5" />RAMPAUBE sam ge Balaam mui gage kai nah ranggai, “Balak da caili gwang daicu nah peda rangbeu.” <verse eid="NUM 23:5" /><verse number="6" style="v" sid="NUM 23:6" />Cine Balaam, Balak keru ratak ga sap kebambe nah Moab muiteume pelane pecu ngngwa kebambe da cailigwang di. <verse eid="NUM 23:6" /><verse number="7" style="v" sid="NUM 23:7" />Ge Balaam pe cairasam rang cudi nah pa rang eh,</para>
  <para style="q" vid="NUM 23:7">“Balak ne acu Aram gade ngngwa gwanglu,</para>
  <para style="q2" vid="NUM 23:7">naimiak kepetle lamlwadung gade Moab gwangpei.</para>
  <para style="q" vid="NUM 23:7">‘Gwanglu, Jacob de reset lo a ziemne,’ de pa ranggai.</para>
  <para style="q2" vid="NUM 23:7">‘Gwanglu, Israel de mlai dilu.’<verse eid="NUM 23:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NUM 23:8" />Ih dainzwa eh Tinggwang ne reset kemakmedung de reset lulai?</para>
  <para style="q2" vid="NUM 23:8">Ih dainzwa eh RAMPAUBE mlai kemakmedung de mlai lulai?<verse eid="NUM 23:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NUM 23:9" />Tsura peu gade Ih pecu kengau ziemne;</para>
  <para style="q2" vid="NUM 23:9">Ih hangdeutudung gade pecu pie.</para>
  <para style="q" vid="NUM 23:9">Pielo, minadung penuikatei lungh kela ge bam</para>
  <para style="q2" vid="NUM 23:9">nah penuikatei penuide heleuh kedabe nzwa lie lama.<verse eid="NUM 23:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NUM 23:10" />Caune Jacob leuhme de pei lulai</para>
  <para style="q2" vid="NUM 23:10">mede Israelme zi mdai tei eh ket rünne de pei lulai?</para>
  <para style="q" vid="NUM 23:10">Acu peu makesangme ge tsit tsai lo,</para>
  <para style="q2" vid="NUM 23:10">nah a teilung penli kecang de pa nzwa lo!”<verse eid="NUM 23:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="NUM 23:11" />Balak Balaam dade ranggai, “Nang a dage daipai tei zeu no. Ih ncu a ngauraumedung de reset beu kerane ngngwa gwang, dede pielo, nang penuide samlam beu dida.” <verse eid="NUM 23:11" /><verse number="12" style="v" sid="NUM 23:12" />Balaam keli eh ranggai, “RAMPAUBE ne acu daige ranglo kebeu rünne Ih sünne eh rang kerabe meni?”<verse eid="NUM 23:12" /></para>
  <para style="s">Balaam gu Miswakegah Kenabe</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 23:13" />Cine Balak pe dage ranggai, “Kehereide acu ngngwa heni keda ga nang penui de ngaulu kera ga gwang lo. Nang penui nnatume rünne de ngau zie, penui pelane de lak, cika de nang penuide a ziemne reset gailo.” <verse eid="NUM 23:13" /><verse number="14" style="v" sid="NUM 23:14" />Cine pa Balaam de Zophim luh Pisgah Deutu reuga ngngwa mielu nah recabam hena tei silu. Pa recabam ramsang gage hetumseu ge nah meurünseu ge peugai beu. <verse eid="NUM 23:14" /><verse number="15" style="v" sid="NUM 23:15" />Ge Balaam ne Balak dage ranggai, “Nang ngu keru ratak teu aika saplu, Ih luga RAMPAUBE de redau kera pet kecudau.” <verse eid="NUM 23:15" /><verse number="16" style="v" sid="NUM 23:16" />Cine RAMPAUBE Balaam de redaulu nah sam ge pe mui gage kaibeu. Pa ranggai, “Balak da cailigwang cu nah a sam de pecu peulo.” <verse eid="NUM 23:16" /><verse number="17" style="v" sid="NUM 23:17" />Balaam peda cailigwang di, nah pielo, pa au keru ratak taiga sapbam nah Moab muiteumedung peda bam. Ge Balak pe dage ranggai, “RAMPAUBE daipai rangno?” <verse eid="NUM 23:17" /><verse number="18" style="v" sid="NUM 23:18" />Balaam caiha sam rang cudi. Pa ranggai,</para>
  <para style="q" vid="NUM 23:18">“Cuhlu, O Balak, nah siulu.</para>
  <para style="q2" vid="NUM 23:18">A kwa kingneilu, nang Zippor napei.<verse eid="NUM 23:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="NUM 23:19" />Tinggwang au mina ma, cine pa nret lak,</para>
  <para style="q2" vid="NUM 23:19">Mede mina ge eh pe lung nreu lama.</para>
  <para style="q" vid="NUM 23:19">Pa ma keheibe de tei mene pe sampet gaini?</para>
  <para style="q2" vid="NUM 23:19">Pa cide teipet kai mene mage tei zie de rangni? <verse eid="NUM 23:19" /><verse number="20" style="v" sid="NUM 23:20" />Pielo, acu samlam beu kera rangbeu da.</para>
  <para style="q2" vid="NUM 23:20">Tinggwang ne samlam ge peu, nah Ih cide keu nreu gailak.<verse eid="NUM 23:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="NUM 23:21" />Pa Jacob da kehung ge de ngau ma</para>
  <para style="q2" vid="NUM 23:21">mede Israelme da keherei kecu gwangma.</para>
  <para style="q" vid="NUM 23:21">Penui RAMPAUBE Tinggwang penuide ngngwa la,</para>
  <para style="q2" vid="NUM 23:21">nah penui gu hegwangpei lie kecu penui kakgade sah di. <verse eid="NUM 23:21" /><verse number="22" style="v" sid="NUM 23:22" />Tinggwang ne penuide Egypt gade ngngwa mpetlu</para>
  <para style="q2" vid="NUM 23:22">hetumseu pezai kesiabe kengking nzwa.<verse eid="NUM 23:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="NUM 23:23" />Kereka ge de Jacob de kerenia tadung teikelu gah,</para>
  <para style="q2" vid="NUM 23:23">nah caiha kerang ne Israel de rezam ma.</para>
  <para style="q" vid="NUM 23:23">Ci meliene, Jacob penai Israel ha rangbi zie da,</para>
  <para style="q2" vid="NUM 23:23">‘Pielo Tinggwang daitei gai bi!’<verse eid="NUM 23:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="NUM 23:24" />Pielo, minadung hingho pui ge nzwa cuh zeu,</para>
  <para style="q2" vid="NUM 23:24">hingho ge pet nah ketang kela nzwa.</para>
  <para style="q" vid="NUM 23:24">Pa tuityei kera pie kelude tyeilu kemakta pa zeu lama</para>
  <para style="q2" vid="NUM 23:24">nah pa ne teitset kelu gu hejai sakla.”<verse eid="NUM 23:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="NUM 23:25" />Ge Balak Balaam dage ranggai, “Penuide reset so mede samlam de beu so.” <verse eid="NUM 23:25" /><verse number="26" style="v" sid="NUM 23:26" />Dede Balaam pe sam keli nah Balak dage ranggai, “Ih ncu rangbeu meni RAMPAUBE a da ranglo kecube pelane Ih rang mai kesia?”<verse eid="NUM 23:26" /></para>
  <para style="s">Balaam gu Miswakegah Kecumbe</para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 23:27" />Cine Balak Balaam de keli eh, “Cu gwanglu, Ih ncu heni keda ga ngngwa mie zie. Cide ne n ziemne Tinggwang pesuiyi de cilak cika penuide a ziemne reset beu kera.” <verse eid="NUM 23:27" /><verse number="28" style="v" sid="NUM 23:28" />Cine Balak Balaam de Peor Deutu reu hetaideu pie nghung kengau ga ngngwa hanglu. <verse eid="NUM 23:28" /><verse number="29" style="v" sid="NUM 23:29" />Balaam Balak dage ranggai, “Aikage a ziemne recabam pumhena teilu nah hetumseu hena nah meurünseudung hena mteilu.” <verse eid="NUM 23:29" /><verse number="30" style="v" sid="NUM 23:30" />Cine Balak Balaam kerang nzwa teilu; pa hetumseu ge nah meurünseu ge recabam ramsang gage peugai.<verse eid="NUM 23:30" /></para>
  <chapter eid="NUM 23" />
  <chapter number="24" style="c" sid="NUM 24" />
  <para style="nb">
    <verse number="1" style="v" sid="NUM 24:1" />RAMPAUBE Israel de samlam beu kera cide pesui yi kecu Balaam ngaulu ge, pa mie tadi, keda tingdaudung nzwa, reka keu kerane. Iciu meliene, pa hetaideu lebie piegai. <verse eid="NUM 24:1" /><verse number="2" style="v" sid="NUM 24:2" />Pa ngang cuh pie gai nah Israel ramzeuki teipwa kebam ngau, penuikatei penui leuh ga ketket nah Tinggwang Rabe peda gwanglu. <verse eid="NUM 24:2" /><verse number="3" style="v" sid="NUM 24:3" />Pa caiha aide ngaulu nah ranggai,</para>
  <para style="q" vid="NUM 24:3">“Balaam Beor napei marang lau da,</para>
  <para style="q2" vid="NUM 24:3">minabe pe miak nrak le pieling kebambe.<verse eid="NUM 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NUM 24:4" />Pa marang nah Tinggwang samdung siu.</para>
  <para style="q2" vid="NUM 24:4">Pa Kengkiengbe dade marengei ngau,</para>
  <para style="q" vid="NUM 24:4">Pe miak mrak eh pe dwaga keumie.<verse eid="NUM 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NUM 24:5" />N paikidung daihiage hezuyi no, Jacob,</para>
  <para style="q2" vid="NUM 24:5">nang lungh kebam ni ga, Israel!<verse eid="NUM 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NUM 24:6" />Chabakdung nzwa zangra pet,</para>
  <para style="q2" vid="NUM 24:6">hereuki taiga heguriedung nzwa,</para>
  <para style="q2" vid="NUM 24:6">RAMPAUBE ne ling kegai aloedung nzwa,</para>
  <para style="q2" vid="NUM 24:6">duidung kung ga cedardung nzwa.<note caller="-" style="x"><char style="xo" closed="false">24:6 </char><char style="xt" closed="false"><ref loc="HEB 8:2">Heb. 8:2</ref></char></note><verse eid="NUM 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NUM 24:7" />Penui duibungdung gade dui lwamie,</para>
  <para style="q2" vid="NUM 24:7">nah penui tsileu au dui hetau hemilu.</para>
  <para style="q" vid="NUM 24:7">Penui hegwangpei au Agag swade hu kizie,</para>
  <para style="q2" vid="NUM 24:7">nah penui hegwangram de herüt peu zie.<verse eid="NUM 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NUM 24:8" />Tinggwang pecu Egypt gade ngngwa mpetlu,</para>
  <para style="q" vid="NUM 24:8">hetumseu pezai kesiabe gu kengkingbe nzwa.</para>
  <para style="q2" vid="NUM 24:8">Pa heleuhdung de tyeilu zie pecu ncam eh regi kecumedung de.</para>
  <para style="q2" vid="NUM 24:8">Pa penui radung tei kecai dizie.</para>
  <para style="q2" vid="NUM 24:8">Pa penuide pe lakpitsidung le kapzie.<verse eid="NUM 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NUM 24:9" />Pa hingho ge nzwa kwakdung mielu,</para>
  <para style="q2" vid="NUM 24:9">hingho pui ge nzwa. Cauge pecu kebwak kera kekuu bamno?</para>
  <para style="q" vid="NUM 24:9">Peu keheibe de pecu samlam kebeube de samlam beu;</para>
  <para style="q2" vid="NUM 24:9">peu keheibe de pecu reset kebeube de reset beu.”<verse eid="NUM 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10" />Balak Balaam de perata cuhdi nah pa perata eh pe ba hezum ncütlu. Balak Balaam dage ranggai, “Ih a ngauraumedung de reset beu kerane ncu qu, dede pielo, nang penuide piacum samlam beu dida. <verse eid="NUM 24:10" /><verse number="11" style="v" sid="NUM 24:11" />Cine cu gage a taiga de tetdi eh n kiga gwang cu. Ih n ziehi tei hemisüt beu zielie rang, dede RAMPAUBE ne peu ncu ziehi ge de ngau kera kam dida.” <verse eid="NUM 24:11" /><verse number="12" style="v" sid="NUM 24:12" />Pecai Balaam Balak de keli gai, “Nang a dage langkegai samgwamedung de Ih rangbeu dida, <verse eid="NUM 24:12" /><verse number="13" style="v" sid="NUM 24:13" />‘Balak acu pe hegwangki rangkanggeu nah kecak puiting eh peu liede, Ih RAMPAUBE sam gika di daulak nah keheibe de siade mede yide, mede ma keheibe Ih tei keneube liede. Ih RAMPAUBE acu ranglo de kebeube rünne rang lubui.’ Ih aide penui dage rang meni? <verse eid="NUM 24:13" /><verse number="14" style="v" sid="NUM 24:14" />Cine cu, pielo, Ih a minadung da cailigwang dizie da. Dede nrai Ih ncu ranglia zie mina aidungde n minadung dage gwang dai kera le daipai teigai ziebi kecu.”<verse eid="NUM 24:14" /></para>
  <para style="s">Balaam gu Miswakegah Mdaibe</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 24:15" />Balaam caiha aide rangdi. Pa ranggai,</para>
  <para style="q" vid="NUM 24:15">“Balaam Beor napei rang,</para>
  <para style="q2" vid="NUM 24:15">Minabe pe miak nrak le pieling kebambe.<verse eid="NUM 24:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="NUM 24:16" />Aide au mige Tinggwang dade samdung siu lwe cairasam kerang ge,</para>
  <para style="q2" vid="NUM 24:16">Hutube dade pa maci bam,</para>
  <para style="q2" vid="NUM 24:16">Ngkiengtube dade pa marengei ngaubam,</para>
  <para style="q" vid="NUM 24:16">Pedwa ga pa pemiak nraklu eh keumie kegaibe.<verse eid="NUM 24:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="NUM 24:17" />Ih pecu ngau, dede pa au cu aika gah.</para>
  <para style="q" vid="NUM 24:17">Ih pecu piegai, dede pa au nna ma.</para>
  <para style="q" vid="NUM 24:17">Hegi ge Jacob dade pet zie,</para>
  <para style="q2" vid="NUM 24:17">nah hegwang tuitie ge Israel dade cu zie.</para>
  <para style="q" vid="NUM 24:17">Pa Moab muiteumedung de teipop dizie</para>
  <para style="q2" vid="NUM 24:17">nah Seth leuhme pelane de ngkap dizie.<note caller="-" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="MAT 2:2">Mat. 2:2</ref></char></note><verse eid="NUM 24:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="NUM 24:18" />Iciu eh Edom de Israel gu dizie,</para>
  <para style="q" vid="NUM 24:18">nah Seir de penui gu dizie,</para>
  <para style="q2" vid="NUM 24:18">Israel ngauraumedung,</para>
  <para style="q2" vid="NUM 24:18">penuide Israel ne kengkieng teu ngamlu zie.<verse eid="NUM 24:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="NUM 24:19" />Jacob dade kengkieng teu kera hegwang ge gwang zie,</para>
  <para style="q2" vid="NUM 24:19">nah penui gu namdi ga bangkelume de pa ngkap dizie.”<verse eid="NUM 24:19" /></para>
  <para style="s">Balaam gu Miswakegah Mengeibe</para>
  <para style="m">
    <verse number="20" style="v" sid="NUM 24:20" />Ge Balaam Amalek de piedi nah pe caiha rangdi. Pa ranggai,</para>
  <para style="q" vid="NUM 24:20">“Amalek nda tingdau heleuhdung gade ngkiengtube,</para>
  <para style="q2" vid="NUM 24:20">dede penli kamtube kekap zie.”<verse eid="NUM 24:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="NUM 24:21" />Ge Balaam Keniteme lambie piegai nah pe cairasam rangdi. Pa ranggai,</para>
  <para style="q" vid="NUM 24:21">“Heni nang lungh kebam de au ngkieng,</para>
  <para style="q2" vid="NUM 24:21">nah n ciet au tsura ga bam.<verse eid="NUM 24:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="NUM 24:22" />Iciuliede nnui Keniteme de mi ne ru dizie</para>
  <para style="q2" vid="NUM 24:22">Assyria ncu hebaangme teikera ngngwa tet kecu dau.”<verse eid="NUM 24:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="NUM 24:23" />Ge Balaam caiha kamtube ranggai,</para>
  <para style="q" vid="NUM 24:23">“Co tei lubui da! Tinggwang aide teikegai dau cauge ringlu lai?<verse eid="NUM 24:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="NUM 24:24" />Limdung Kittim kung gade gwang zie;</para>
  <para style="q2" vid="NUM 24:24">penui Assyria de ketang zie nah Eber reu ngkienglu zie,</para>
  <para style="q2" vid="NUM 24:24">dede penui liede kekap le penli tei zie.”<verse eid="NUM 24:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="NUM 24:25" />Ge Balaam cuhlu delwe tetdi. Pa pe kiga cailigwang di, nah Balak liedi tetdi.<verse eid="NUM 24:25" /></para>
  <chapter eid="NUM 24" />
  <chapter number="25" style="c" sid="NUM 25" />
  <para style="s">Moab ne Israel de Kehemeu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1" />Israelme Shittim ga bamdi, nah mipeidung Moabme puidung de ngngwa kemha ta tei ndeu di, <verse eid="NUM 25:1" /><verse number="2" style="v" sid="NUM 25:2" />kedanemene Moabme puidung minadung de penui rabedung ratak ketei gage qu gai. Cine minadung matyei nah Moabme rabedung dwa keumie.<note caller="-" style="x"><char style="xo" closed="false">25:2 </char><char style="xt" closed="false"><ref loc="REV 2:14">Keu. 2:14</ref></char></note> <verse eid="NUM 25:2" /><verse number="3" style="v" sid="NUM 25:3" />Israelme mipeidung Peor ga Baal de reca kecu ga ngngwa ncüt di, nah RAMPAUBE Israelme de perata süt di.<note caller="-" style="x"><char style="xo" closed="false">25:3 </char><char style="xt" closed="false"><ref loc="REV 2:20">Keu. 2:20</ref></char></note> <verse eid="NUM 25:3" /><verse number="4" style="v" sid="NUM 25:4" />RAMPAUBE Moses dage rang eh, “Minadung gu muiteume pelane de teitset dilu nah penuide RAMPAUBE dwa gage kanghezu lwe tingkebaa gage tei recie gailu, ciciu lude Israelme de RAMPAUBE perata süt kebam de nreutet dilu kerane.” <verse eid="NUM 25:4" /><verse number="5" style="v" sid="NUM 25:5" />Cine Moses Israelme gu muiteumedung dage rang, “Nnui hangge ge kecu nnui minadung Peor ga Baal de reca bam kedime de teitset dilu.”<verse eid="NUM 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 25:6" />Pecai Israelme pei hangge gwang nah pe kilungme peupei kakga de Midiame puige de ngngwa gwang. Aide Moses nah Israel leuhme mina pelane miakngau gade, penui redau kecu paiki tet nlüt kecu gade hap eh bam kecudau. <verse eid="NUM 25:6" /><verse number="7" style="v" sid="NUM 25:7" />Eleazar napei nah cingkupei Aaron capei Phinehas, cide ngau keludau, pa heleuhbe kakga de cuh lu nah pe ba ga hengei pwalu. <verse eid="NUM 25:7" /><verse number="8" style="v" sid="NUM 25:8" />Pa paiki ga Israelme pei caisui lüt nah hengei le penai hangnana de reuhdi, Israelme pei nah mipuibe hangna de. Ciciu eh Tinggwang Israelme da rapia langgai kedi de mtakdi. <verse eid="NUM 25:8" /><verse number="9" style="v" sid="NUM 25:9" />Pumpei cang ngkaiemdai ge rapia cide gade tsaidi.<verse eid="NUM 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10" />RAMPAUBE Moses de mpau, rang eh, <verse eid="NUM 25:10" /><verse number="11" style="v" sid="NUM 25:11" />“Eleazar napei nah cingkupei Aaron capei Phinehas, ne Israelme de a ratasüt eh kebam de keumzia dida kedanemene pa penui kakga de a lungning de pelung kaisüt eh teicang beu. Cine Ih Israelme de a rata eh ngkapdi meda. <verse eid="NUM 25:11" /><verse number="12" style="v" sid="NUM 25:12" />Cine ranggai, ‘RAMPAUBE rang eh, “Pielo, Ih Phinehas de samkakkelu lungciep de pwapeu dizie. <verse eid="NUM 25:12" /><verse number="13" style="v" sid="NUM 25:13" />Kedanemene pa nah pe leuhme pe caileu kerame ziemne, aipau samkak de kelungta cingku tei zie kedanemene pa pe Tinggwang, a ziemne pelung kaisüt. Pa ne Israel minadung ziemne kezuyibe teugwang beu.”’”<verse eid="NUM 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 25:14" />Cu Israelme pei Midiame pui de ngngwa tsai kedibe zi Zimri Salu napei, Simeonme kakga de pautsadung kelak gu muiteu ge. <verse eid="NUM 25:14" /><verse number="15" style="v" sid="NUM 25:15" />Teitset kedi Midiame pui zi cai Kozbi Zur napui, Midiame leuh nah kelak gade peuteume ge.<verse eid="NUM 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 25:16" />Cine RAMPAUBE Moses de mpau, rang eh, <verse eid="NUM 25:16" /><verse number="17" style="v" sid="NUM 25:17" />“Midiame de ngauraume nzwa cetlu nah penuide regi gai, <verse eid="NUM 25:17" /><verse number="18" style="v" sid="NUM 25:18" />kedanemene penui ncu ngauraume ge nzwa kenret le cwala. Penui ncu Peor gade kesia tei kegaine nah penui tipui Kozbi ziemne, Midian ga muiteube napui, cipau benai Peor ga rapia ne teitset kedime.”<verse eid="NUM 25:18" /></para>
  <chapter eid="NUM 25" />
  <chapter number="26" style="c" sid="NUM 26" />
  <para style="s">Pumpei Kenabe</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1" />Rapia de cang kedi cai RAMPAUBE Moses nah Cingkube Aaron napei Eleazar de resiu, rang eh, <verse eid="NUM 26:1" /><verse number="2" style="v" sid="NUM 26:2" />“Israel ga minadung hemaa pelane de pei gailo, mmi ngkai gade nah penreume, penui paume kelak gade, Israel ziemne hereu teikera mielu kebui pelane.” <verse eid="NUM 26:2" /><verse number="3" style="v" sid="NUM 26:3" />Cine Moses penai cingkupei Eleazar, Jericho ga Jordan reuki gade kah pet Moabme deu langkie gade penuide resiu nah rang eh, <verse eid="NUM 26:3" /><verse number="4" style="v" sid="NUM 26:4" />“Minadung de peilu, mmi ngkai gade nah penreume, RAMPAUBE ne Moses de nah Israelme de samkai beu, Egyptme deu gade gwang kebamme.”<verse eid="NUM 26:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 26:5" />Israel gade Reuben de mna raitu lu. Pe napei Hanok gade Hanok pautsa ndeu lu. Pallu gade Pallu pautsa mdeu lu. <verse eid="NUM 26:5" /><verse number="6" style="v" sid="NUM 26:6" />Hezron gade Hezron pautsa mdeu lu. Karmi gade Karmi pautsa mdeu lu. <verse eid="NUM 26:6" /><verse number="7" style="v" sid="NUM 26:7" />Aidungde Reuben pautsamedung, mipeidung pumpei 43,730. <verse eid="NUM 26:7" /><verse number="8" style="v" sid="NUM 26:8" />Eliab be cai Pallu napei. <verse eid="NUM 26:8" /><verse number="9" style="v" sid="NUM 26:9" />Eliab napeidung cai Nemuel, Danthan, nah Abiram. Danthan nah Abiram aipau kena deda, Korah caisuime tei delwe Moses nah Aaron de kesamlim nah RAMPAUBE de renia cu. <verse eid="NUM 26:9" /><verse number="10" style="v" sid="NUM 26:10" />Pe caisuime pelane tsai kedi dau, kideube pe mui ngkeilu nah penuide mnwa pwadi Korah de si eh. Cipau tingdau, mi ne mina 250 de ngkap di, cide mriaklu kera marengei gedi. <verse eid="NUM 26:10" /><verse number="11" style="v" sid="NUM 26:11" />Dede Korah napeimedung tsaidi ma.<verse eid="NUM 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 26:12" />Aidungde Simeon leuhdung gu pautsadung:</para>
  <para style="q1" vid="NUM 26:12">Nemuel gade, Nemuel tsame,</para>
  <para style="q1" vid="NUM 26:12">Jamin gade, Jamin tsame,</para>
  <para style="q1" vid="NUM 26:12">Jakin gade, Jakin tsame,<verse eid="NUM 26:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NUM 26:13" />Zerah gade, Zerah tsame,</para>
  <para style="q1" vid="NUM 26:13">Shaul gade, Shaul tsame. <verse eid="NUM 26:13" /><verse number="14" style="v" sid="NUM 26:14" />Aidungde Simeon leuhdung gu pautsadung, mipeidung pumpei 22,200.<verse eid="NUM 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 26:15" />Aidungde Gad leuhdung gu pautsadung:</para>
  <para style="q1" vid="NUM 26:15">Zephon gade, Zephon tsame,</para>
  <para style="q1" vid="NUM 26:15">Haggi gade, Haggi tsame,</para>
  <para style="q1" vid="NUM 26:15">Shuni gade, Shuni tsame,<verse eid="NUM 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 26:16" />Ozni gade, Oznitme tsame,</para>
  <para style="q1" vid="NUM 26:16">Eri gade, Eri tsame,<verse eid="NUM 26:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NUM 26:17" />Arod gade, Arod tsame,</para>
  <para style="q1" vid="NUM 26:17">Areli gade, Areli tsame. <verse eid="NUM 26:17" /><verse number="18" style="v" sid="NUM 26:18" />Aidungde Gad leuhdung gu pautsadung, mipeidung pumpei 40,500.<verse eid="NUM 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 26:19" />Judah napeidung cai Er nah Onan, dede penai Canaan deu gade tsaidi. <verse eid="NUM 26:19" /><verse number="20" style="v" sid="NUM 26:20" />Aidungde Judah leuhdung gu pautsadung keda ge:</para>
  <para style="q1" vid="NUM 26:20">Shelah gade, Shelah tsame,</para>
  <para style="q1" vid="NUM 26:20">Perez gade, Perez tsame, nah</para>
  <para style="q1" vid="NUM 26:20">Zerah gade, Zerah tsame. <verse eid="NUM 26:20" /><verse number="21" style="v" sid="NUM 26:21" />Aidungde Perez leuhdung:</para>
  <para style="q1" vid="NUM 26:21">Hezron gade, Hezron tsame,</para>
  <para style="q1" vid="NUM 26:21">Hamul gade, Hamul tsame. <verse eid="NUM 26:21" /><verse number="22" style="v" sid="NUM 26:22" />Aidungde Judah leuhdung gu pautsadung, mipeidung pumpei 76,500.<verse eid="NUM 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 26:23" />Aidungde Issachar leuhdung gu pautsadung:</para>
  <para style="q1" vid="NUM 26:23">Tola gade, Tola tsame,</para>
  <para style="q1" vid="NUM 26:23">Puah gade, Puah tsame, <verse eid="NUM 26:23" /><verse number="24" style="v" sid="NUM 26:24" />Jashub gade, Jashub tsame,</para>
  <para style="q1" vid="NUM 26:24">Shimron gade, Shimron tsame. <verse eid="NUM 26:24" /><verse number="25" style="v" sid="NUM 26:25" />Aidungde Issachar tsamedung, mipeidung pumpei 64,300.<verse eid="NUM 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 26:26" />Aidungde Zebulun leuhdung gu pautsadung:</para>
  <para style="q1" vid="NUM 26:26">Sered gade, Sered tsame,</para>
  <para style="q1" vid="NUM 26:26">Elon gade, Elon tsame,</para>
  <para style="q1" vid="NUM 26:26">Jahleel gade, Jahleel tsame. <verse eid="NUM 26:26" /><verse number="27" style="v" sid="NUM 26:27" />Aidungde Jebulun tsamedung, mipeidung pumpei 60,500.<verse eid="NUM 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 26:28" />Manasseh penai Ephraim cai Joseph leuhdung gu pautsadung. <verse eid="NUM 26:28" /><verse number="29" style="v" sid="NUM 26:29" />Aidungde Manasseh leuhmedung:</para>
  <para style="q1" vid="NUM 26:29">Makir gade, Makir tsame (Makir cai Gilead pei),</para>
  <para style="q1" vid="NUM 26:29">Gilead gade, Gilead tsame. <verse eid="NUM 26:29" /><verse number="30" style="v" sid="NUM 26:30" />Aidungde Gilead leuhmedung:</para>
  <para style="q1" vid="NUM 26:30">Lezer gade, Lezer tsame,</para>
  <para style="q1" vid="NUM 26:30">Helek gade, Helek tsame,<verse eid="NUM 26:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="NUM 26:31" />Asriel gade, Asriel tsame</para>
  <para style="q1" vid="NUM 26:31">Shechem gade, Shechem tsame,<verse eid="NUM 26:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="NUM 26:32" />Shemida gade, Shemida tsame,</para>
  <para style="q1" vid="NUM 26:32">Hepher gade, Hepher tsame. <verse eid="NUM 26:32" /><verse number="33" style="v" sid="NUM 26:33" />Hepher napei Zelophehad pe napeime ga, dede mipuinadung rünsangne. Pe napuime zi cai Mahlah, Noah, Hoglah, Milkah nah Tirzah. <verse eid="NUM 26:33" /><verse number="34" style="v" sid="NUM 26:34" />Aidungde Manasseh tsamedung, mipeidung pumpei 52,700.<verse eid="NUM 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 26:35" />Aidungde Ephraim leuhdung gu pautsadung:</para>
  <para style="q1" vid="NUM 26:35">Shuthelah gade, Shuthelah tsame,</para>
  <para style="q1" vid="NUM 26:35">Beker gade, Beker tsame,</para>
  <para style="q1" vid="NUM 26:35">Tahan gade, Tahan tsame. <verse eid="NUM 26:35" /><verse number="36" style="v" sid="NUM 26:36" />Shuthelah leuhmedung cai, Eran gade, Eran tsame. <verse eid="NUM 26:36" /><verse number="37" style="v" sid="NUM 26:37" />Aidungde Ephraim leuhdung gu pautsadung, mipeidung pumpei 32,500. Aidungde Joseph leuhmedung, penui tsame gade ketket pei kelu.<verse eid="NUM 26:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 26:38" />Aidungde Benjamin leuhdung gu pautsadung:</para>
  <para style="q1" vid="NUM 26:38">Bela gade, Bela tsame,</para>
  <para style="q1" vid="NUM 26:38">Ashbel gade, Ashbel tsame,</para>
  <para style="q1" vid="NUM 26:38">Ahiram gade, Ahiramit tsame,<verse eid="NUM 26:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="NUM 26:39" />Shephupham gade, Shephupham tsame,</para>
  <para style="q1" vid="NUM 26:39">Hupham gade, Hupham tsame.<verse eid="NUM 26:39" /></para>
  <para style="m">
    <verse number="40" style="v" sid="NUM 26:40" />Bela napeidung cai Ard nah Naaman. Ard gade Ard tsame gwang, nah Naaman gade Naaman tsame gwang. <verse eid="NUM 26:40" /><verse number="41" style="v" sid="NUM 26:41" />Aidungde Benjamin leuhdung gu pautsadung. Penui mipeidung pumpei 45,600.<verse eid="NUM 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 26:42" />Aidungde Dan leuhdung gu pautsadung, Shuham gade, Shuham tsame. Aidungde Dan leuhdung gu pautsadung. <verse eid="NUM 26:42" /><verse number="43" style="v" sid="NUM 26:43" />Shuham tsame pelane mipeidung pumpei 64,400.<verse eid="NUM 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 26:44" />Aidungde Asher leuhdung gu pautsadung:</para>
  <para style="q1" vid="NUM 26:44">Imnah gade, Imnah tsame,</para>
  <para style="q1" vid="NUM 26:44">Ishvi gade, Ishvi tsame,</para>
  <para style="q1" vid="NUM 26:44">Beriah gade, Beriah tsame.<verse eid="NUM 26:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="NUM 26:45" />Aidungde Beriah leuhmedung:</para>
  <para style="q1" vid="NUM 26:45">Heber gade, Heber tsame,</para>
  <para style="q1" vid="NUM 26:45">Malkiel gade, Malkiel tsame.<verse eid="NUM 26:45" /></para>
  <para style="m">
    <verse number="46" style="v" sid="NUM 26:46" />Asher napui zi cai Serah. <verse eid="NUM 26:46" /><verse number="47" style="v" sid="NUM 26:47" />Aidungde Asher leuhdung gu pautsadung, mipeidung pumpei 53,400.<verse eid="NUM 26:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 26:48" />Aidungde Naphtali leuhdung gu pautsadung:</para>
  <para style="q1" vid="NUM 26:48">Jahzeel gade, Jahzeel tsame,</para>
  <para style="q1" vid="NUM 26:48">Guni gade, Guni tsame,<verse eid="NUM 26:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="NUM 26:49" />Jezer gade, Jezer tsame,</para>
  <para style="q1" vid="NUM 26:49">Shillem gade, Shillem tsame.<verse eid="NUM 26:49" /></para>
  <para style="m">
    <verse number="50" style="v" sid="NUM 26:50" />Aidungde Naphtali leuhdung gu pautsadung, mipeidung pumpei 45,400.<verse eid="NUM 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 26:51" />Israel ga minadung kakga de mipeidung pei kap kelu: 601,730.<verse eid="NUM 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52" />RAMPAUBE Moses de mpau gai nah rang eh, <verse eid="NUM 26:52" /><verse number="53" style="v" sid="NUM 26:53" />“Penui zidung pumpei rehi gade hangdeu de penui qwa teilu kera mipei aidungde de mzi beulu maisia. <verse eid="NUM 26:53" /><verse number="54" style="v" sid="NUM 26:54" />Pautsadung kedibe de peqwa peu kieelu maisia, nah pautsadung keceube de peqwa peu camlu maisia. Kelak peciakne gade mipeidung pumpei peikelu rehi gade nang peqwa mzi beulu maisia. <verse eid="NUM 26:54" /><verse number="55" style="v" sid="NUM 26:55" />Iciude, hangdeu dacak eh mzi beulu maisia. Penui hangdeu de gum bilu maisia kedanemene cide penui pautsa leuhme kakgade mzi beu zielu. <verse eid="NUM 26:55" /><verse number="56" style="v" sid="NUM 26:56" />Penui qwadung de pautsadung kedi nah keceu kak gade mzi beulu maisia, peria tei eh penui de mzi kebeude.”<verse eid="NUM 26:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="NUM 26:57" />Levime pautsadung, ketket pei kelu, aidungde da:</para>
  <para style="q1" vid="NUM 26:57">Gershon gade, Gershon tsame,</para>
  <para style="q1" vid="NUM 26:57">Kohath gade, Kohath tsame,</para>
  <para style="q1" vid="NUM 26:57">Merari gade, Merari tsame.<verse eid="NUM 26:57" /></para>
  <para style="m">
    <verse number="58" style="v" sid="NUM 26:58" />Aidungde Levi tsamedung:</para>
  <para style="q1" vid="NUM 26:58">Libnit tsame,</para>
  <para style="q1" vid="NUM 26:58">Hebron tsame,</para>
  <para style="q1" vid="NUM 26:58">Mahlit tsame,</para>
  <para style="q1" vid="NUM 26:58">Mushit tsame,</para>
  <para style="q1" vid="NUM 26:58">nah Korah tsame.</para>
  <para style="m" vid="NUM 26:58">Kohath becai Amram pautsame. <verse eid="NUM 26:58" /><verse number="59" style="v" sid="NUM 26:59" />Amram nau zi becai Jochebed, Levi leuhme, pecu levime deu Egypt gade mna. Amram dade tetlak lwe penai hena mnalu, Aaron, Moses nah penai tipui Miriam. <verse eid="NUM 26:59" /><verse number="60" style="v" sid="NUM 26:60" />Aaron dade mna kelu Nadab nah Abihu, Eleazar nah Ithamar. <verse eid="NUM 26:60" /><verse number="61" style="v" sid="NUM 26:61" />Nadab nah Abihu mcikemak mi reca RAMPAUBE dage tei kegaine tsaidi. <verse eid="NUM 26:61" /><verse number="62" style="v" sid="NUM 26:62" />Mipeinadung kei ge nah penreume penui kakga pei kelu mipeinadung pumpei cang ngkaiekecum. Dede penuide Israel leuhme gage pei ncüt ma kedanemene Israel minadung kakga penui qwa gede peu kemakne.<verse eid="NUM 26:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63" />Aidungde Moses nah cingkube Eleazar ne pei kelu deda. Penai Jericho gade Jordan reuki kah pet lwe Moab deu langkie gade Israel minadung de peilu. <verse eid="NUM 26:63" /><verse number="64" style="v" sid="NUM 26:64" />Dede Israel leuhme Sinai hetaideu gade pei kelude Moses penai cingkupei Aaron ne pei kelu minadung cipaudung kakga bam tadi. <verse eid="NUM 26:64" /><verse number="65" style="v" sid="NUM 26:65" />Kedanemene mina cidung pelane hetaideu gade tsai bi dizie lie RAMPAUBE ranggai. Mina migede bam si tadi penui kakga, Jephunneh napei Caleb penai Nun napei Joshua rünsangne di.<verse eid="NUM 26:65" /></para>
  <chapter eid="NUM 26" />
  <chapter number="27" style="c" sid="NUM 27" />
  <para style="s">Zelophehad Napuidung</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1" />Pecai Moses da Zelophehad napuidung Hepher napei Gilead napei Machir napei Manasseh napei gwang, Joseph napei Manasseh pautsadung. Aidungde pe napuidung zi: Mahlah, Noah, Hoglah, Milkah, nah Tirzah. <verse eid="NUM 27:1" /><verse number="2" style="v" sid="NUM 27:2" />Penui Moses, cingkube Eleazar, muiteume, nah hemaa pelane dwa gade keredau cu paiki ga tet nlüt kecu ga gwang sap. Penui rang eh, <verse eid="NUM 27:2" /><verse number="3" style="v" sid="NUM 27:3" />“Anui pei hetaideu gade tsai dida. Pa au Korah caisuime ge tei eh RAMPAUBE de renia kecu ga si ma. Dede pa pekatei pe mau ziemne tsaidi, nah pa pena mipeina ga. <verse eid="NUM 27:3" /><verse number="4" style="v" sid="NUM 27:4" />Daitei anui pei pena mipeina ga cune pezi hepui peupei gade tei nggah di lai no? Anui pei kibaume dade anuide hangdeu peu lo.” <verse eid="NUM 27:4" /><verse number="5" style="v" sid="NUM 27:5" />Cine Moses RAMPAUBE da cipau reha teugwang.<verse eid="NUM 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 27:6" />RAMPAUBE Moses de mpau, rang eh, <verse eid="NUM 27:6" /><verse number="7" style="v" sid="NUM 27:7" />“Zelophehad napuidung petau siakpe rangbam da. Penui peime kibaume gu hangdeu gade penui qwa teilu kerane hangdeu peu bilu maisia, nah penui pei qwa de penui ngau bilu kerane nang tei bi beulu. <verse eid="NUM 27:7" /><verse number="8" style="v" sid="NUM 27:8" />Nang Israel minadung de resiu bilu nah rang beulu, ‘Magade mige tsaidi nah pena mipei gah, ciciucai nang pe qwa de pe napui ne gumlu kera teibeu maisia. <verse eid="NUM 27:8" /><verse number="9" style="v" sid="NUM 27:9" />Magade pa pena mipui ga cai, peqwa de pe sinamedung de pwapeu lu. <verse eid="NUM 27:9" /><verse number="10" style="v" sid="NUM 27:10" />Magade pa pe siname ga cai, peqwa de pe pei gu sinamedung de pwapeu lu. <verse eid="NUM 27:10" /><verse number="11" style="v" sid="NUM 27:11" />Magade pe pei sinamedung ga liecai, ciucai hepui ga kebam pe kibaume nnatume de pe qwa pwapeu lu, nah pa cide pekatei pegu nzwa keulu maisia. RAMPAUBE ne Moses dage aja kaikebeu nzwa, Israel minadung ziemne hezai ge teigai zie peu tei mzailu kerane.’”<verse eid="NUM 27:11" /></para>
  <para style="s">Joshua Moses Papwa kera</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12" />RAMPAUBE Moses de rang eh, “Abarim lamlwatu ga hang cuh nah Ih Israelmedung de hangdeu ha kebeu de pie gai. <verse eid="NUM 27:12" /><verse number="13" style="v" sid="NUM 27:13" />Nang ngau keludau, nangde, n minadung de ngngwa bam maisia, n sinabe Aaron nzwa. <verse eid="NUM 27:13" /><verse number="14" style="v" sid="NUM 27:14" />Aide teigwang zie kedanemene nnai Zin hetaideu gade a sam mlai kedine. Cika, tangtsu gade dui lwa kebamdau, hemaabe pelane dwa gade n rata ne acu kemcibe lie de hetwa peulu tadi.” Aidungde Kadesh ga Meribah dui Zin hetaideu gade.<verse eid="NUM 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 27:15" />Pecai Moses RAMPAUBE de mpau, rang eh, <verse eid="NUM 27:15" /><verse number="16" style="v" sid="NUM 27:16" />“Nang, RAMPAUBE, mina pelane rabedung Tinggwang, heleuhbe reuga mina hangge de relang gai beulo,<note caller="-" style="x"><char style="xo" closed="false">27:16 </char><char style="xt" closed="false"><ref loc="HEB 12:9">Heb. 12:9</ref></char></note> <verse eid="NUM 27:16" /><verse number="17" style="v" sid="NUM 27:17" />cauge tetpet eh penui dwa ga gwang nah penuide teuswa pet eh penuide teu hekwa lubui bi, ciciu lude RAMPAUBE leuhme meurünna de kekwabe ga cu nzwa di melu kerane.” <verse eid="NUM 27:17" /><verse number="18" style="v" sid="NUM 27:18" />RAMPAUBE Moses de rang eh, “Nun napei Joshua de ngngwa lu, mina cide da a Rabe bam kelabe, nah peda n ba ngngei lu. <verse eid="NUM 27:18" /><verse number="19" style="v" sid="NUM 27:19" />Cingkube Eleazar dwa ga ngngwa gwanglu nah hemaa pelane dwa ga, nah penui miakngau gade pane penuide teuswa kera samkai beu di. <verse eid="NUM 27:19" /><verse number="20" style="v" sid="NUM 27:20" />Nang n da kebam kengkieng kesa pecu peulu, ciciude Israelme hemaa pelane pesam mzai lu kerane. <verse eid="NUM 27:20" /><verse number="21" style="v" sid="NUM 27:21" />Pa cingkube Eleazar dwaga mie eh pe ziemne a lungning de Urimme tiak kebeu de cilu kerane. Cide pa samkai kebeu gade minadung tetmie zie nah gwang zie, pa nah Israel minadung pelane pecu ngngwa eh, heleuh pelane de.” <verse eid="NUM 27:21" /><verse number="22" style="v" sid="NUM 27:22" />Cine Moses RAMPAUBE samkai kebeu de nzwa teigai. Pa Joshua de ngngwa lu nah cingkube Eleazar dwa nah heleuh pelane dwaga ge kaibeu. <verse eid="NUM 27:22" /><verse number="23" style="v" sid="NUM 27:23" />Pa pereu gage pe ba ngngei gailu nah teuswa lulo samkai beu, RAMPAUBE ne pecu teikera samkai kebeu nzwa.<verse eid="NUM 27:23" /></para>
  <chapter eid="NUM 27" />
  <chapter number="28" style="c" sid="NUM 28" />
  <para style="s">Tingba ramsang Recadung</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1" />RAMPAUBE Moses de mpau eh rang, <verse eid="NUM 28:1" /><verse number="2" style="v" sid="NUM 28:2" />“Israelme de aja kaigai nah penui dage ranggai, ‘Nnui recadung de nlumkebeu ting gage acu pwapeu lu maisia, a ziemne mi le teikelu taktyei perim kehengui de bam lu kerane.’ <verse eid="NUM 28:2" /><verse number="3" style="v" sid="NUM 28:3" />Nang penuide aide de rangbeu maisia, ‘Mapeu aide mi le tei kelu RAMPAUBE de peu bi maisia, mmi ge di kecu meurünseudung rezamdi kemakpe, tingnai ramsangne kena, keru reca ge nzwa pwapeu bam muilu. <verse eid="NUM 28:3" /><verse number="4" style="v" sid="NUM 28:4" />Tingcang nang meurün ge peulu maisia, nah tinghegi nang meurün keda ge peulu maisia. <verse eid="NUM 28:4" /><verse number="5" style="v" sid="NUM 28:5" />Nang tokkui keyi ephah kereige meibui reca peulu maisia, macadui yitube hin zi mdai gade ket ncüt si lwe. <verse eid="NUM 28:5" /><verse number="6" style="v" sid="NUM 28:6" />Aide keru reca peubam kera Sinai lamlwa gade samkai beu perim kehengui de bamlu kerane, mi gade RAMPAUBE de reca peu kegai. <verse eid="NUM 28:6" /><verse number="7" style="v" sid="NUM 28:7" />Meuründung kakgade ket ziemne zau hin zi mdai gade ket maisia. Nang zau reca cide kemci ni gage rui gai eh RAMPAUBE de zau kengkiengbe pwapeu maisia. <verse eid="NUM 28:7" /><verse number="8" style="v" sid="NUM 28:8" />Meurün kedabe de nang tinghegi dau pwapeu lu maisia meibui reca kedabe de si eh tingcang pwapeu kecu nzwa. Nang cide pwapeu kecudau zau reca keda gede pwapeu si maisia, mi gade tei kegai reca, RAMPAUBE ziemne perim kehengui de bamlu kerane.<verse eid="NUM 28:8" /></para>
  <para style="s">Sabbath Recadung</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9" />Sabbath benai nang meurün seu kena pwapeu lu maisia, kenana de mmi ge di kecu rejamdi kemakpe, nah ephah zi kerei gade zi na tokkui keyi de meibui reca teilu, maca dui si eh, nah zau reca de si eh pwapeu lu. <verse eid="NUM 28:9" /><verse number="10" style="v" sid="NUM 28:10" />Sabbath ramsangne keru reca aide tei muilu, peu bammui kela keru reca gage si eh nah zau reca de si eh.<note caller="-" style="x"><char style="xo" closed="false">28:10 </char><char style="xt" closed="false"><ref loc="MAT 12:5">Mat. 12:5</ref></char></note><verse eid="NUM 28:10" /></para>
  <para style="s">Hekei ramsang Recadung</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11" />Kei ramsang keraidau, nnui RAMPAUBE de keru reca pwapeu lu maisia. Nang hetumseu kehenabe kena, meurünseu ge, nah meurünseu pumhena mmi ge di kecube rezamdi kemakpe peulu maisia. <verse eid="NUM 28:11" /><verse number="12" style="v" sid="NUM 28:12" />Nnui ephah zi kerei gade zi cum tokkui keyi de meibui reca teilu macadui si eh hetumseu ketket ziemne, nah zi kerei gade zi na tokkui keyi de meibui reca teilu macadui si eh meurünseu ge ziemne. <verse eid="NUM 28:12" /><verse number="13" style="v" sid="NUM 28:13" />Nnui tokkui keyi ephah kerei ge macadui si eh meurünna ketket ziemne reca teilu. Aide keru reca ge zie, perim kehengui de bamlu kerane, RAMPAUBE dage mi gade reca tei kegai. <verse eid="NUM 28:13" /><verse number="14" style="v" sid="NUM 28:14" />Minadung gu zau recadung de hetumseu ge ziemne zau hin pempie ge maisia, meurünseu ge ziemne hin zi cum, nah hin zi mdai gade zi ge meurün ziemne. Aide hekei ramsangne keru reca tei eh pemmi teicang zie. <verse eid="NUM 28:14" /><verse number="15" style="v" sid="NUM 28:15" />RAMPAUBE dage kemau reca tei eh hemeuseu ge reca pwapeu lu maisia. Aide keru reca tei bammui kelade ga si zie nah zau reca de si eh.<verse eid="NUM 28:15" /></para>
  <para style="s">Kahkegwang Ngyi</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16" />Hekeizie raitu dau, cipau bekei zie kereiehmdai benai, RAMPAUBE Kahkegwang ngyi gwang. <verse eid="NUM 28:16" /><verse number="17" style="v" sid="NUM 28:17" />Cipau bekei zie kereiehmengei benai taktyei keyi tyeila. Lang hena ne ziemne, tangku tsehi kai mene tyei maisia. <verse eid="NUM 28:17" /><verse number="18" style="v" sid="NUM 28:18" />Raitu benai, RAMPAUBE de hetwa kepeu kemci ngkwa bamlu maisia. Cipau benai nnui mata tei kerabe ma. <verse eid="NUM 28:18" /><verse number="19" style="v" sid="NUM 28:19" />Ciuliede, nnui mi gade teikelu ratak pwapeu lu maisia, cide RAMPAUBE de keru reca kepeu. Nang hetumseuna kena, meurünseu ge, nah mmi ge kecu meuründung peseu pumhena, rezamdi kemakpe. <verse eid="NUM 28:19" /><verse number="20" style="v" sid="NUM 28:20" />Hetumseu de si eh, nnui meibui reca ephah kerei gade zi cum tokkui keyi macadui de si eh pwapeu lu maisia, nah meurünseu de si eh, zi kerei gade zi na. <verse eid="NUM 28:20" /><verse number="21" style="v" sid="NUM 28:21" />Meurünnadung pum hena kecu de si, nnui ephah kereige tokkui keyi macadui ncüt si eh pwapeu lu, <verse eid="NUM 28:21" /><verse number="22" style="v" sid="NUM 28:22" />nah hemeu seu ge kemau reca tei beulu nnuikatei nnui mau de ruilu kera ziemne. <verse eid="NUM 28:22" /><verse number="23" style="v" sid="NUM 28:23" />Nnui keru reca aidungde tingcang ramsang teibam kela gage teigai si lu maisia. <verse eid="NUM 28:23" /><verse number="24" style="v" sid="NUM 28:24" />Aide ga rangpwa kebam nzwa eh, nang ratak aidungde tingnai ramsangne pwapeu maisia, Kahkegwang ngyi langhena ne ziemne, mi le teikelu taktyei reca de, RAMPAUBE ziemne perim kehengui ge. Cide reca teibam mui kecu gage teigai si lu keru reca nah zau reca de si lu. <verse eid="NUM 28:24" /><verse number="25" style="v" sid="NUM 28:25" />Lang henane benai nnui RAMPAUBE de hetwa kepeu kemci ngkwa bamlu maisia, nah nnui kedadau nzwa cipaunai mata tei kerabe ma.<verse eid="NUM 28:25" /></para>
  <para style="s">Mtakkakdung Ngyi</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26" />Mei tsidung luhlüt raitu benai liede, nnui gu Mtakdung Ngyi gade RAMPAUBE de meibui keheci reca pwapeu kecudau, nnui RAMPAUBE de hetwa kepeu kemci ngkwa bamlu maisia, nah nnui kedadau nzwa cipau benai mata tei kerabe ma. <verse eid="NUM 28:26" /><verse number="27" style="v" sid="NUM 28:27" />Nnui RAMPAUBE ziemne keru reca pwapeu maisia perim kehengui de petlu kerane. Nnui hetumseu kehenabe kena, meurünseu ge, nah meuründung peseu hena mmi ge kecu pwapeu lu maisia. <verse eid="NUM 28:27" /><verse number="28" style="v" sid="NUM 28:28" />Meibui reca liede pwapeu lu penuide ngngwa tet kerane: Tokkui keyi macadui ncüt eh ephah zi kerei gade zi cum tokkui keyi macadui si eh hetumseu ketket ziemne nah zi kerei gade zi na meurünseu ge ziemne. <verse eid="NUM 28:28" /><verse number="29" style="v" sid="NUM 28:29" />Tokkui keyi ephah kereige macadui si eh meurünnadung hena ziemne ketket kecu, <verse eid="NUM 28:29" /><verse number="30" style="v" sid="NUM 28:30" />nah hemeu seu ge nnuikatei nnui mau rilu kerane. <verse eid="NUM 28:30" /><verse number="31" style="v" sid="NUM 28:31" />Nnui cidung kaunedung rejamdi mene pwapeu kecudau, penui zau reca de si eh pwapeu kecudau, aide reca tei bammui kecu gage si eh keru reca nah meibui reca teibeu lu.’”<verse eid="NUM 28:31" /></para>
  <chapter eid="NUM 28" />
  <chapter number="29" style="c" sid="NUM 29" />
  <para style="s">Teluidung Ngyi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1" />“Kei hena bekei dau, hekei gade tingba raitu benai, nnui RAMPAUBE de herüt kepeu kemci kangbau ge bamlu maisia. Aipaunai nnui mata teibam keladung de tei kerabe ma. Aipaunai de nnui teluidung kwagai kera benai. <verse eid="NUM 29:1" /><verse number="2" style="v" sid="NUM 29:2" />Nnui RAMPAUBE ziemne keru reca perim kehengui de peulu maisia. Nnui hetumseuna ge, hemeuseu ge, nah mmi ge cing kedi meuründung hena, kette rezamdi kemakpe peu maisia. <verse eid="NUM 29:2" /><verse number="3" style="v" sid="NUM 29:3" />Nnui meibui reca mapeu pwa peu maisia, tokkui maca kai kelube, hetumseu ziemne ephah zi kerei gade zi cum, meurünseu ziemne zi kerei gade zi na, <verse eid="NUM 29:3" /><verse number="4" style="v" sid="NUM 29:4" />nah kerei zi ge meurünna hena ziemne ketket kecu. <verse eid="NUM 29:4" /><verse number="5" style="v" sid="NUM 29:5" />Hemeu peseu ge teu eh nnui mau ruilu kerane kemau reca tei beulu. <verse eid="NUM 29:5" /><verse number="6" style="v" sid="NUM 29:6" />Reca aidungde keihena bekei dau teilu recadung pelane nnui hekei raitu ramsangne ga tei kebamde de si eh: keru reca yitube nah meibui reca peu nsamlu kerane. Aidungde keru reca tei bammui kela gage tei si gai lu, meibui reca nah zau recadung gage. Nang reca aide peu kegai dau, nang perim kehengui pwapeu lu kerane hezai kaikebeu de mzailu zie, RAMPAUBE dage mi gade reca teikegai de.<verse eid="NUM 29:6" /></para>
  <para style="s">Ratak Tingba</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7" />Kei hena bekei lang kerei ne benai nnui RAMPAUBE de herüt kepeu kemci kangbau bamlu maisia. Nnuide tei hena lu maisia nah mata gede tei so. <verse eid="NUM 29:7" /><verse number="8" style="v" sid="NUM 29:8" />Nnui RAMPAUBE ziemne keru reca perim kehengui de pwa peulu maisia. Nnui hetumseu kehenabe ket, hemeuseu ge, nah meurünseu hena mmi ge cing kedibe pwa peu zie. Cidungde ketket kecu rezamdi kemakpe maisia. <verse eid="NUM 29:8" /><verse number="9" style="v" sid="NUM 29:9" />Nnui meibui mapeu aidung de si eh pwapeu lu, tokkui maca kai kelube, hetumseu ziemne ephah zi kerei gade zi cum, hemeuseu ziemne zi kerei gade zi na, <verse eid="NUM 29:9" /><verse number="10" style="v" sid="NUM 29:10" />nah meurünna pumhena ketket kecu ziemne ephah kerei ge zie. <verse eid="NUM 29:10" /><verse number="11" style="v" sid="NUM 29:11" />Nnui hemeuseu ge pwa kemau reca teigai maisia. Aide mmau rilu kera kemau reca gage teigai si zie, keru reca tei bammui kelade, meibui reca, nah zau recadung de si eh.<verse eid="NUM 29:11" /></para>
  <para style="s">Paikidung Ngyi</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12" />Kei hena bekei ziangreiemengei benai nnui RAMPAUBE de herüt kepeu kemci kangbau ge bamlu maisia. Nnui teibam kela matadung cipaunai teiso, nah langhenane hengyi cide RAMPAUBE ziemne mnei lu. <verse eid="NUM 29:12" /><verse number="13" style="v" sid="NUM 29:13" />Nnui keru reca pwapeu maisia, mi le teikelu ratak RAMPAUBE de perim kehengui pwapeu lu kerane. Nnui hetumseu kereiehkecum, hemeuseu kena, nah meurün seu mmi ge cing kedibe pwapeu lu. Ketket kecu rezamdi kemakpe maisia. <verse eid="NUM 29:13" /><verse number="14" style="v" sid="NUM 29:14" />Nnui ma aidungde si eh meibui reca pwapeu lu, tokkui maca kai kelube, hetumseu kereiehkecum gade ketket leune ziemne ephah zi kerei zi cum, hemeuseu kena gade ketket ziemne zi kerei gade zi na zie, <verse eid="NUM 29:14" /><verse number="15" style="v" sid="NUM 29:15" />nah meurünnadung kereiehmdai gade ketket ziemne ephah kerei ge zie. <verse eid="NUM 29:15" /><verse number="16" style="v" sid="NUM 29:16" />Tei bammui kela keru reca, meibui reca, nah zau reca gage si eh nnui hemeuseu ge kemau reca ziemne pwa peulu maisia. <verse eid="NUM 29:16" /><verse number="17" style="v" sid="NUM 29:17" />Kekangbau kecu pekena benai, nnui hetumseu kehenabe kereiehkena, hemeuseu kena, nah meurünnadung kereiehmdai mmi ge di kecube, ketket kecu rezamdi kemakpe. <verse eid="NUM 29:17" /><verse number="18" style="v" sid="NUM 29:18" />Cidungde de si eh nnui mei reca nah zau reca hetumseudung ziemne, hemeuseudung ziemne, nah meurünnadung ziemne teigai maisia, recadung tei lulo kebeu swa kiee eh reca teigai lu. <verse eid="NUM 29:18" /><verse number="19" style="v" sid="NUM 29:19" />Nnui keru reca, meibui reca, nah zau reca peu bammui kela gage si eh hemeuseu ge teu eh kemau reca teibeu maisia. <verse eid="NUM 29:19" /><verse number="20" style="v" sid="NUM 29:20" />Kangbau langcumne benai, hetumseu kereiehket, hemeuseu kena, nah meurünna peseudung kereiehmdai mmi ge cang kedibe, ketket kecu rezamdi kemakpe. <verse eid="NUM 29:20" /><verse number="21" style="v" sid="NUM 29:21" />Cidungde de si eh nnui mei reca nah zau reca hetumseudung ziemne, hemeuseudung ziemne, nah meurünnadung ziemne teigai maisia, recadung tei lulo kebeu swa kiee eh reca teigai lu. <verse eid="NUM 29:21" /><verse number="22" style="v" sid="NUM 29:22" />Nnui keru reca, meibui reca, nah zau reca peu bammui kela gage si eh hemeuseu ge teu eh kemau reca teibeu maisia. <verse eid="NUM 29:22" /><verse number="23" style="v" sid="NUM 29:23" />Kangbau lang pemdai benai, nnui hetumseu kerei, hemeuseu kena, nah meurün seu kereiehmdai mmi ge cang kedibe, ketket kecu rezamdi kemakpe pwapeu maisia. <verse eid="NUM 29:23" /><verse number="24" style="v" sid="NUM 29:24" />Cidungde de si eh nnui mei reca nah zau reca hetumseudung ziemne, hemeuseudung ziemne, nah meurünnadung ziemne teigai maisia, recadung tei lulo kebeu swa kiee eh reca teigai lu. <verse eid="NUM 29:24" /><verse number="25" style="v" sid="NUM 29:25" />Nnui keru reca, meibui reca, nah zau reca peu bammui kela gage si eh hemeuseu ge teu eh kemau reca teibeu maisia. <verse eid="NUM 29:25" /><verse number="26" style="v" sid="NUM 29:26" />Kangbau lang pemengei benai, nnui hetumseu hekui, hemeuseu kena, nah meurünna peseu mmi ge di kecube kereiehmdai, ketket kecu rezamdi kemakpe. <verse eid="NUM 29:26" /><verse number="27" style="v" sid="NUM 29:27" />Cidungde de si eh nnui mei reca nah zau reca hetumseudung ziemne, hemeuseudung ziemne, nah meurünnadung ziemne teigai maisia, recadung tei lulo kebeu swa kiee eh reca teigai lu. <verse eid="NUM 29:27" /><verse number="28" style="v" sid="NUM 29:28" />Nnui keru reca, meibui reca, nah zau reca peu bammui kela gage si eh hemeuseu ge teu eh kemau reca teibeu maisia. <verse eid="NUM 29:28" /><verse number="29" style="v" sid="NUM 29:29" />Kangbau kecu langherokne benai, nnui hetumseudung heset ge, hemeuseu kena, nah meurünna peseu kereiehmdai mmi ge di kecube, ketket kecu rezamdi kemakpe. <verse eid="NUM 29:29" /><verse number="30" style="v" sid="NUM 29:30" />Cidungde de si eh nnui mei reca nah zau reca hetumseudung ziemne, hemeuseudung ziemne, nah meurünnadung ziemne teigai maisia, recadung tei lulo kebeu swa kiee eh reca teigai lu. <verse eid="NUM 29:30" /><verse number="31" style="v" sid="NUM 29:31" />Nnui keru reca, meibui reca, nah zau reca peu bammui kela gage si eh hemeuseu ge teu eh kemau reca teibeu maisia. <verse eid="NUM 29:31" /><verse number="32" style="v" sid="NUM 29:32" />Kangbau kecu langhenane benai, nnui hetumseu hena, hemeuseu kena, nah meurünseu mmi ge di kecube kereiehmdai, ketket kecu rezamdi kemakpe pwapeu maisia. <verse eid="NUM 29:32" /><verse number="33" style="v" sid="NUM 29:33" />Cidungde de si eh nnui mei reca nah zau reca hetumseudung ziemne, hemeuseudung ziemne, nah meurünnadung ziemne teigai maisia, recadung tei lulo kebeu swa kiee eh reca teigai lu. <verse eid="NUM 29:33" /><verse number="34" style="v" sid="NUM 29:34" />Nnui keru reca, meibui reca, nah zau reca peu bammui kela gage si eh hemeuseu ge teu eh kemau reca teibeu maisia. <verse eid="NUM 29:34" /><verse number="35" style="v" sid="NUM 29:35" />Lang hesetne benai nnui riemsünne kelu kangbau keda ge bam lu maisia. Cipaunai nnui kedadau teibam kela mata tei kerabe ma. <verse eid="NUM 29:35" /><verse number="36" style="v" sid="NUM 29:36" />Nnui keru reca ge pwapeu lu maisia, RAMPAUBE ziemne mi le teikelu reca perim kehengui de teigai lu. Nnui hetumseu ge, hemeuseu ge, nah meurünseu hena mmi ge di kecube, rezamdi kemakpe pwapeu lu maisia. <verse eid="NUM 29:36" /><verse number="37" style="v" sid="NUM 29:37" />Cidungde de si eh nnui mei reca nah zau reca hetumseudung ziemne, hemeuseudung ziemne, nah meurünnadung ziemne teigai maisia, recadung tei lulo kebeu swa kiee eh reca teigai lu. <verse eid="NUM 29:37" /><verse number="38" style="v" sid="NUM 29:38" />Nnui keru reca, meibui reca, nah zau reca peu bammui kela gage si eh hemeuseu ge teu eh kemau reca teibeu maisia.<verse eid="NUM 29:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39" />Ma aidungde nnui riemkelu ngyidung gade RAMPAUBE de peulu maisia. Aidungde nnui sampet nah mta makaidung gage si kerabe. Nnui aide nnui gu keru recadung, meibui recadung, zau recadung, nah kangbau recadung ge eh peu lu.” <verse eid="NUM 29:39" /><verse number="40" style="v" sid="NUM 29:40" />Moses Israelme dage RAMPAUBE ne ranglo kebeu leune rangbeu.<verse eid="NUM 29:40" /></para>
  <chapter eid="NUM 29" />
  <chapter number="30" style="c" sid="NUM 30" />
  <para style="s">Sampetdung</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 30:1" />Moses Israel leuhme muiteumedung de mpau gai. Pa rang eh, “RAMPAUBE ainzwa aja kaigai. <verse eid="NUM 30:1" /><verse number="2" style="v" sid="NUM 30:2" />Mige RAMPAUBE dage pe sampet tei kegaidau, mede pecu kangnzeu lu kerane sampet teigai cai, pa pe sam peu kegai de teipangdi kerabe ma. Mige teizie lie eh pemui gade sampet kegai leune kainzeu lu maisia.<note caller="-" style="x"><char style="xo" closed="false">30:2 </char><char style="xt" closed="false"><ref loc="MAT 5:33">Mat. 5:33</ref></char></note> <verse eid="NUM 30:2" /><verse number="3" style="v" sid="NUM 30:3" />Releipui ge pepei kiga lungh kebamdau RAMPAUBE dage sampet teigai nah sampet dene pecu kang teula, pa pepei kiga lungh kebamtane, <verse eid="NUM 30:3" /><verse number="4" style="v" sid="NUM 30:4" />nah pe pei sampet tei kegai dene pecu kang pwakebam de siulu cai, nah pecu teu cailidai lu kerane pa mage de rang mecai, iciucai pe sampetdung de mzai bi kera ge dizie, nah samkak dene pecu kang pwa kela leune ga mzui zie. <verse eid="NUM 30:4" /><verse number="5" style="v" sid="NUM 30:5" />Dede pe pei cide ci keludau pecu kaamnam dicai, pe sampetdung mede samkak kelude ga sap gailak dizie; pe pei pecu kam kedine RAMPAUBE pecu lungmpet beuzie. <verse eid="NUM 30:5" /><verse number="6" style="v" sid="NUM 30:6" />Pa sampet teikelu cai mipei ge nau dicai mede kecwa sampet teu eh pekatei pecu kang pwabam cai, <verse eid="NUM 30:6" /><verse number="7" style="v" sid="NUM 30:7" />nah pe nahpei cide siulu eh pecu magede rang mecai, ciucai sampetdung de ga sap zie, nah pecu kang pwa kebam sam de mzui zie. <verse eid="NUM 30:7" /><verse number="8" style="v" sid="NUM 30:8" />Dede pe nahpei cipau ha de ci kelu benai gade pecu kaamnam cai, ciu eh mipuibe tei kegai sampet de pa keucaili di, kecwa sam dene pekatei pecu kang pwakebam de, nah RAMPAUBE pecu lungmpet beuzie. <verse eid="NUM 30:8" /><verse number="9" style="v" sid="NUM 30:9" />Dede hemipui mede laksipui ge pe sampet teikegai dega sap mtip bam maisia. <verse eid="NUM 30:9" /><verse number="10" style="v" sid="NUM 30:10" />Mipui ge pe nahpei ki gade lungpet samrang cai mede sampet teicang mai kesiadung bamcai, <verse eid="NUM 30:10" /><verse number="11" style="v" sid="NUM 30:11" />nah pe nahpei cide siulu liede pecu magede rangma nah kaamnam mecai, ciucai pe sampetdung leune bamlu zie, nah pa tei zielie kebam leune ga mzui luzie. <verse eid="NUM 30:11" /><verse number="12" style="v" sid="NUM 30:12" />Dede pe nahpei cidung siu kelu benai cidungde mlai dicai, ciucai pemui gade kepet samkak mede sampet leune mzui lu tadi zie. Pe nahpei ne cidung kamdi, nah RAMPAUBE pecu lungmpet beu zie. <verse eid="NUM 30:12" /><verse number="13" style="v" sid="NUM 30:13" />Sampet nah samkak keheibede pecu teikeherei kera bamcai, pe nahpei ne cide tei nggah di lubui. <verse eid="NUM 30:13" /><verse number="14" style="v" sid="NUM 30:14" />Dede pe nahpei tingnaige cai tingnaige pe nau sampetdung cibam de magede rang mecai, ciucai pa mipuibe sampet cidungde leune de ngngwa kesuisam bam, nah penei cika sap luzie, kedanemene pa mipuibe kerang de kesiu dau pesam keli kemakne. <verse eid="NUM 30:14" /><verse number="15" style="v" sid="NUM 30:15" />Magade pe nahpei pe nau sampet de siulu eh mlai di cai, ciucai pa pe nau maudung de pe pwet dizie.” <verse eid="NUM 30:15" /><verse number="16" style="v" sid="NUM 30:16" />Hezai aidung RAMPAUBE ne Moses dage ndulia gai beulo aja kai kebeube, hezai aide henau hepei nah pe pei penai pe napui relei eh pe pei kiga kebam dau ziemne.<verse eid="NUM 30:16" /></para>
  <chapter eid="NUM 30" />
  <chapter number="31" style="c" sid="NUM 31" />
  <para style="s">Medianme reu Hekumkepei</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1" />RAMPAUBE Moses de mpau eh rang, <verse eid="NUM 31:1" /><verse number="2" style="v" sid="NUM 31:2" />“Midiame Israelme dage teikegai de ziemne penuide saja peu lo. Cide teikelu cai, nang tsai dizie nah n leuhme kakga ngkwa zie.” <verse eid="NUM 31:2" /><verse number="3" style="v" sid="NUM 31:3" />Cine Moses minadung dage ranggai, “Midiame de ngngwa hereu tei kerane n minadung de peu reunet teulu nah RAMPAUBE ne kepeu saja penui de peulu. <verse eid="NUM 31:3" /><verse number="4" style="v" sid="NUM 31:4" />Nnui Israel leuhme leune gade heleuh ket gade cang gege kecu hereu teikera langgai beulu.” <verse eid="NUM 31:4" /><verse number="5" style="v" sid="NUM 31:5" />Cine Israel minadung pecang pecang kebam gade, heleuh ge gade mina cang gege kelang gai, mina cang kereiehkena ge reutak ga mie kera mteilu. <verse eid="NUM 31:5" /><verse number="6" style="v" sid="NUM 31:6" />Ciu eh Moses penuide hereu gage langgai di, heleuh ge gade mina cang gege, cingkupei Eleazar napei Phinehas de penui dage langgai, nah kemci ni gade mania kesadung nah teluidung penuide peu pekwa perehi cilu kerane langgai. <verse eid="NUM 31:6" /><verse number="7" style="v" sid="NUM 31:7" />Penui regi eh Midiame de ngngwa renia, RAMPAUBE ne Moses dage ranggai kebeu nzwa eh. Penui mina leune de teitset di. <verse eid="NUM 31:7" /><verse number="8" style="v" sid="NUM 31:8" />Penui Midiame gwangpei nah pecu ngngwa eh Midiame hegwang hangmengei de teitset di: Evi, Rekem, Zur, Hur nah Reba. Penui kingtie le Balaam Beor napei dede teitset di. <verse eid="NUM 31:8" /><verse number="9" style="v" sid="NUM 31:9" />Israel reugwamedung Midiame puidung, hename, penui kaune pelane, penui gu hemeudung pelane, nah penui niadung pelane tuiteu gwangdi. Penui aidungde sütteu pwadi. <verse eid="NUM 31:9" /><verse number="10" style="v" sid="NUM 31:10" />Penui mina lungh kebam namdidung nah ramzeukidung pelane ru ciak di. <verse eid="NUM 31:10" /><verse number="11" style="v" sid="NUM 31:11" />Penui süt kelu leune keulu nah hebaangme, mina nah makaune de. <verse eid="NUM 31:11" /><verse number="12" style="v" sid="NUM 31:12" />Hebaangme, süt kelube, nah tuikelu maniadung Moses, cingkupei Eleazar, nah Israel hemaabe da teugwang beu. Penui aidungde Moab langkie ga ramzeuki Jordan reuki tai Jericho kemna ga teugwang lu. <verse eid="NUM 31:12" /><verse number="13" style="v" sid="NUM 31:13" />Moses, cingkupei Eleazar, nah hemaa ga muiteumedung mie ramzeuki gwale de penuide redau. <verse eid="NUM 31:13" /><verse number="14" style="v" sid="NUM 31:14" />Dede Moses reugwa reu muiteume, cangreu teukeswabe nah haireu kedibe, hereu gade gwang kelame de perata di. <verse eid="NUM 31:14" /><verse number="15" style="v" sid="NUM 31:15" />Moses penui dage rang, “Nnui mipui leune de ringbam kera peu ni? <verse eid="NUM 31:15" /><verse number="16" style="v" sid="NUM 31:16" />Pielo, mipui aidungde Balaam sampung eh Peor gade Israelme de peu RAMPAUBE renia cuh eh kemau teidi, RAMPAUBE gu minadung dage rapia kai kegaidau. <verse eid="NUM 31:16" /><verse number="17" style="v" sid="NUM 31:17" />Cine cu, mipeina hename leune de teitset dilu, nah mipuina mipei gede ngngwa kemha tatei kedi leune de teitset dilu. <verse eid="NUM 31:17" /><verse number="18" style="v" sid="NUM 31:18" />Dede mipuinadung mipei de ngngwa kemha tatei kemakme leune ne nnui keulu. <verse eid="NUM 31:18" /><verse number="19" style="v" sid="NUM 31:19" />Nnui Israel ramzeuki gwale pebam keda ga lang henane bam maisia. Keheibede nnui mide teitset kedime mede ketsai pau de tung kedime, langcumne benai nnuide teikemci tah teilu nah langhenane benai, nnui nah nnui hebaangme. <verse eid="NUM 31:19" /><verse number="20" style="v" sid="NUM 31:20" />Paini leune nah makaune geu le teikelu leune nah hemeu mai le, nah tsing le teikelu leune nnui teimci lu maisia.”<verse eid="NUM 31:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 31:21" />Cingkupei Eleazar hereu ga mie reugwame dage ranggai, “Aide RAMPAUBE ne Moses dage mzai kera kai kebeu zai: <verse eid="NUM 31:21" /><verse number="22" style="v" sid="NUM 31:22" />Kecak, rangkanggeu, hetageu, hegeu, tin, nah lead, <verse eid="NUM 31:22" /><verse number="23" style="v" sid="NUM 31:23" />nah mi ne ru gai kelak niadung leune, nnui mi gage pwa gailu, nah cide mci dizie. Nnui dui kemci le cide hui mci dilu maisia. Mi gage ru gai kelakbedung nnui cide dui le hui mci di maisia. <verse eid="NUM 31:23" /><verse number="24" style="v" sid="NUM 31:24" />Lang henane benai nnui niadung teimci dilu, ciu lu de nnui mci luzie. Ciciu kelucai nnui Israelme gu ramzeuki ga gwang lubui.”<verse eid="NUM 31:24" /></para>
  <para style="s">Hemaa Tuikelu Kenzi</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25" />Pecai RAMPAUBE Moses de mpau, rang eh, <verse eid="NUM 31:25" /><verse number="26" style="v" sid="NUM 31:26" />“Tuikelu nia leune peilu, mina nah makaune de. Nang, cingkupei Eleazar, nah pautsa leuhme gu muiteume <verse eid="NUM 31:26" /><verse number="27" style="v" sid="NUM 31:27" />tuikelu niadung zina tei eh mzi lu. Reugwame hereu teikera mie kedime nah heleuh kebam pelane kakga de mzi beulu. <verse eid="NUM 31:27" /><verse number="28" style="v" sid="NUM 31:28" />Pecai reugwame hereu ga kemie me dade RAMPAUBE dage teu gwang kerane Heraha halu. Heraha aide haimengei gade ket ziemne, cidung mina, makaune, gada, meurün, nah hemeu keheibe de. <verse eid="NUM 31:28" /><verse number="29" style="v" sid="NUM 31:29" />Heraha gade pempie ge keulwe cingkupei Eleazar de peulu, ciu eh RAMPAUBE dage ratak teigai lu kerane. <verse eid="NUM 31:29" /><verse number="30" style="v" sid="NUM 31:30" />Nah Israel leuh pempie ge, minadung, makaune, gada, meurün, nah hemeudung, dade riakngei gade ket keulu maisia. Ma aidung Levime paiki pierengei kebamme de peulu.” <verse eid="NUM 31:30" /><verse number="31" style="v" sid="NUM 31:31" />Cine Moses nah cingkupei Eleazar RAMPAUBE Moses dage sam kaikebeu de teilu.<verse eid="NUM 31:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 31:32" />Reugwame ne mania tuilu eh bang keludung cai meurün 675,000, <verse eid="NUM 31:32" /><verse number="33" style="v" sid="NUM 31:33" />hetumseu cangriakhena eh kena, <verse eid="NUM 31:33" /><verse number="34" style="v" sid="NUM 31:34" />gada cangriakherok eh ket, <verse eid="NUM 31:34" /><verse number="35" style="v" sid="NUM 31:35" />nah mipei de ngngwa kemha tatei kemak mipui cang camreiekena. <verse eid="NUM 31:35" /><verse number="36" style="v" sid="NUM 31:36" />Reugwame ziemne pempie ge kaizeu pwa kebamdung cai meurün 337,500, <verse eid="NUM 31:36" /><verse number="37" style="v" sid="NUM 31:37" />cide gade meurün 675 RAMPAUBE ziemne. <verse eid="NUM 31:37" /><verse number="38" style="v" sid="NUM 31:38" />Hetumseu cang camreieherok gade RAMPAUBE ziemne kainzeu kelu riakhenaekena ge. <verse eid="NUM 31:38" /><verse number="39" style="v" sid="NUM 31:39" />Gadhadung 30,500 gade riakherok eh ket RAMPAUBE ziemne. <verse eid="NUM 31:39" /><verse number="40" style="v" sid="NUM 31:40" />Mipuidung cang kereieherok gade RAMPAUBE ziemne camrei eh kena. <verse eid="NUM 31:40" /><verse number="41" style="v" sid="NUM 31:41" />RAMPAUBE de reca pwapeu kera heraha de Moses keulu. Cidung pwa cingkupei Eleazar de peudi, Moses dage RAMPAUBE rang kegai nzwa.<verse eid="NUM 31:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 31:42" />Israelme gu hema pempie ge reugwame hereu ga mie kedime dade Moses keu keludung, <verse eid="NUM 31:42" /><verse number="43" style="v" sid="NUM 31:43" />hemaa pempie ge ziemne meurün 337,500, <verse eid="NUM 31:43" /><verse number="44" style="v" sid="NUM 31:44" />hetumseu cang camreieherok, <verse eid="NUM 31:44" /><verse number="45" style="v" sid="NUM 31:45" />gada 30,500, <verse eid="NUM 31:45" /><verse number="46" style="v" sid="NUM 31:46" />nah mipui cang kereieherok. <verse eid="NUM 31:46" /><verse number="47" style="v" sid="NUM 31:47" />Israel mena pempie ge gade, riakngei gade hangge Moses luulu, mina nah makaune. Pa Levime RAMPAUBE kereca paiki kwa kebam me de peu, RAMPAUBE pe dage tei lulo rang kegai nzwa eh.<verse eid="NUM 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48" />Cidau reugwame reu kedime, cangreu keteube, nah haireu muiteube, Moses da gwang. <verse eid="NUM 31:48" /><verse number="49" style="v" sid="NUM 31:49" />Penui Moses dage rang, “N kilabe anui kangga kebam reugwamedung riak pei, nah mige de ga dima. <verse eid="NUM 31:49" /><verse number="50" style="v" sid="NUM 31:50" />Anui RAMPAUBE gu reca teugwang, mina ne ngau kelube, kecak niadung, bakap, kiakang, ketau bakap, nli, nah ntei, anui kemau reca RAMPAUBE dage teigai lu kerane.” <verse eid="NUM 31:50" /><verse number="51" style="v" sid="NUM 31:51" />Moses penai cingkupei Eleazar penui dade kecak nah heciemta ketei niadung leune ngaulu. <verse eid="NUM 31:51" /><verse number="52" style="v" sid="NUM 31:52" />Reca gu kecak pelane penui RAMPAUBE de peu kegai, cang reu kedime nah haireu muiteume reca peu kegai hekwa kelu, perüt 16,750 shekel. <verse eid="NUM 31:52" /><verse number="53" style="v" sid="NUM 31:53" />Reugwa leune hema tuilu, penuikatei penui ziemne.<note caller="-" style="x"><char style="xo" closed="false">31:53 </char><char style="xt" closed="false"><ref loc="NUM 31:32">Pum. 31:32</ref>, <ref loc="DEU 20:14">Hez. 20:14</ref></char></note> <verse eid="NUM 31:53" /><verse number="54" style="v" sid="NUM 31:54" />Moses nah cingkupei Eleazar cangreu keteube nah haireu muiteube dade kecakdung hekwa lu. Israelme de peu RAMPAUBE de nsung bamlu kerane penai paiki ga cidungde teugwang.<note caller="-" style="x"><char style="xo" closed="false">31:54 </char><char style="xt" closed="false"><ref loc="EXO 30:16">Tet. 30:16</ref></char></note><verse eid="NUM 31:54" /></para>
  <chapter eid="NUM 31" />
  <chapter number="32" style="c" sid="NUM 32" />
  <para style="s">Jordan Kahkepet Leuhdung</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1" />Reuben penai Gad leuhmedung makaune kekiee ge lungh lu. Penui Jazer penai Gilead deu ngau kegai dau, hangdeu cide makaune kailu kera hangdeu keyi ge. <verse eid="NUM 32:1" /><verse number="2" style="v" sid="NUM 32:2" />Cine Gad penai Reuben leuhmedung gwang eh Moses, cingkupei Eleazar, nah heleuh muiteumedung de mpau eh rang, <verse eid="NUM 32:2" /><verse number="3" style="v" sid="NUM 32:3" />“Aide anui hangdeu pie kelu heni zidung: Ataroth, Dibon, Jazer, Nimrah, Heshbon, Elealeh, Sebam, Nebo, nah Beon. <verse eid="NUM 32:3" /><verse number="4" style="v" sid="NUM 32:4" />Hangdeu aidungde ga Israel leuhme dwa gade RAMPAUBE penui dage keherei kaigai, nah cidungde makaune gui kecu nidung yisüt. Anui, n kilamedung, makaune kekieege gui bam” <verse eid="NUM 32:4" /><verse number="5" style="v" sid="NUM 32:5" />Penui rang eh, “Nang n miak gade anuide ngaunggia liecai, n kilamedung de, anui mapwa tei kerane aipau hangdeu de peulo. Anuide peu Jordan kahpet diso.”<verse eid="NUM 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6" />Moses Gad penai Reuben leuhmedung dage rang keligai, “Nnui be aika lungh di eh nnui sinamedung de peu hereu ga mie zieni?<verse eid="NUM 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 32:7" />RAMPAUBE ne penuide kepeu deu ga gwang kera ziemne daitei Israelme lung tei keherei lai no? <verse eid="NUM 32:7" /><verse number="8" style="v" sid="NUM 32:8" />Ih nnui pei medung de Kadesh Barnea gade hangdeu mcet kera lang kegai dau penui aikenzwa kesiak ge teigai. <verse eid="NUM 32:8" /><verse number="9" style="v" sid="NUM 32:9" />Penui Eshkol langkie ga tet hangdi. Penui hangdeu de ngaulu eh Israelmena mlungdung tei msiadi ciu eh RAMPAUBE ne penui ha kebeude ga penui nlüt kera mlaidi kerane. <verse eid="NUM 32:9" /><verse number="10" style="v" sid="NUM 32:10" />Cipau nai RAMPAUBE perata di. Pa pe sampet gai nah rang, <verse eid="NUM 32:10" /><verse number="11" style="v" sid="NUM 32:11" />‘Egypt gade mpet kelu mmi ngkai nah penreume migede Ih Abraham, Isaac, nah Jacob, dage ranggai kebeu deu ga nlüt gailak, kedanemene penui Ih rang kegaidung mzai lu kemakne <verse eid="NUM 32:11" /><verse number="12" style="v" sid="NUM 32:12" />Jephunneh napei Caleb Kenizzitme, nah Joshua Nun napei ziemne gwale. Caleb penai Joshua rünne a samzai teicang siaklu.’ <verse eid="NUM 32:12" /><verse number="13" style="v" sid="NUM 32:13" />Cine RAMPAUBE rata Israelmena da bamdi. Pa penuide mmi riakdai ge peu hetaideu ga lungh ladi pe miakngau gade makesia ketei ceheu leune ngkap ciakdi kemaktane. <verse eid="NUM 32:13" /><verse number="14" style="v" sid="NUM 32:14" />Pielo, nnui cuh eh nnui peime bam leu luda, mina kemaume kekieege nzwa, Israelme dage RAMPAUBE rata teugwang gai kerane. <verse eid="NUM 32:14" /><verse number="15" style="v" sid="NUM 32:15" />Nnui pecaisui tei kela gade mbai dicai, pa Israel de hetaideu gage langgai dai dizie nah nnui mina aidung leune de ngkap dai dizie.”<verse eid="NUM 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16" />Cine penui Moses da gwang nah rang eh, “Kaunedung ziemne peu anuide heriedung rielo nah anui kelakdung ziemne peu namdidung tumlu. <verse eid="NUM 32:16" /><verse number="17" style="v" sid="NUM 32:17" />Ciuliede, penuide mzang pwa penui bamdung ga canglu kemaktane anui mtei pwa bam nah Israel reugwa medungde ngngwa tet kerane. Dede anui kelakdung au riekelu namdi ga bam zie kedanemene cika kedame cude lung bam reu kecune. <verse eid="NUM 32:17" /><verse number="18" style="v" sid="NUM 32:18" />Anui Israelmena gum keradung gum ciaklu kemaktane anui kiga cailigwang lak. <verse eid="NUM 32:18" /><verse number="19" style="v" sid="NUM 32:19" />Anui penuide ngngwa eh Jordan keda lambie deu de gum lak, kedanemene anui mapwa me Jordan tingnaimiak kepetle kebamne.”<verse eid="NUM 32:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20" />Cine Moses penui de keli eh, “Nnui kerang de tei lucai, nnui reunet kailu eh RAMPAUBE dwa tet eh hereu ga mie cai, <verse eid="NUM 32:20" /><verse number="21" style="v" sid="NUM 32:21" />ciucai hereunet kaikelu n minadung pelane RAMPAUBE dwa rai eh Jordan de kahlu maisia, pa ngauraume de pe dwa gade gwa mpetlu kemaktane <verse eid="NUM 32:21" /><verse number="22" style="v" sid="NUM 32:22" />nah hangdeu de RAMPAUBE ne gum luzie. Ciciu kelucai nnui cailigwang lubui. Nnui RAMPAUBE dade nah Israel me dade kemmau gahdi zie. RAMPAUBE dwa gade hangdeu de nnui mabam ge dizie. <verse eid="NUM 32:22" /><verse number="23" style="v" sid="NUM 32:23" />Dede nnui cinzwa tei lu mecai, cilu lo, nnui kemau tei eh RAMPAUBE kemei tei la. N mau de ncu pei mpet kera cisiak lulo. <verse eid="NUM 32:23" /><verse number="24" style="v" sid="NUM 32:24" />Nnui kelakdung ziemne namdi ge teilu nah nnui meurün ziemne herie rielu; cipaucai nang kerang de teilu” <verse eid="NUM 32:24" /><verse number="25" style="v" sid="NUM 32:25" />Gad penai Reuben leuhmedung Moses de mpau eh rang, “Anui mpaubo, n kilame nang aja kai kegai nzwa tei zie. <verse eid="NUM 32:25" /><verse number="26" style="v" sid="NUM 32:26" />Anui namedung, anui naudung, anui kau hau, nah anui kaune leune Gilead namdi ga bam zie. <verse eid="NUM 32:26" /><verse number="27" style="v" sid="NUM 32:27" />Ciciuliede, anui, n kilamedung, hereu tei kerane RAMPAUBE dwa mie, hereu tei kera hereunet kaikelu pelane, anui mpaube, nang kerang nzwa.” <verse eid="NUM 32:27" /><verse number="28" style="v" sid="NUM 32:28" />Cine Moses puisau pwa cingkupei Eleazar dage ranglia gai, Nun napei Joshua, nah Israelme leuh ga pautsame gu muiteume dage. <verse eid="NUM 32:28" /><verse number="29" style="v" sid="NUM 32:29" />Moses penui dage rang, “Magade Gad penai Reuben leuhme ncu ngngwa Jordan kah cai, mina leune RAMPAUBE dwa gade hereunet kai kelume, nah n dwa gade hangdeu de gumlu cai, ciucai nnui gumkelu Gilead deu de penuide pwapeu dilu. <verse eid="NUM 32:29" /><verse number="30" style="v" sid="NUM 32:30" />Dede penui hereunet teu eh ncu ngngwa kahpet meliecai, ciucai nnui kakga Canaan deu gade penui qwadung ngau luzie.” <verse eid="NUM 32:30" /><verse number="31" style="v" sid="NUM 32:31" />Cine Gad penai Reuben leuhmedung keli eh ranggai, “RAMPAUBE ne anui dage rangkegai nzwa eh, n kilamedung, ainzwa eh anui tei luzie. <verse eid="NUM 32:31" /><verse number="32" style="v" sid="NUM 32:32" />Anui reunet kai lu eh RAMPAUBE kerang mzai eh Canaanme deu de kah zie, dede anui mapwadung ailambie anui da bamzie Jordan kahpet kelu caide.”<verse eid="NUM 32:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 32:33" />Cine Gad penai Reuben leuhme dage, nah Manasseh Joseph napei heleuh pempie dage, Sihon gwangram, Amoritme hegwangpei, nah Og, Bashan gwangpei Moses ne peu di. Pa penuide hangdeu peu di, penuide twagwa kebam namdidung deu de nah namdi cidungde deuraidung si eh penuide mzi beu di. <verse eid="NUM 32:33" /><verse number="34" style="v" sid="NUM 32:34" />Gad leuhme renam aidungde retak dai lu, Dibon, Ataroth, Aroer, <verse eid="NUM 32:34" /><verse number="35" style="v" sid="NUM 32:35" />Atroth Shophan, Jazer, Jogbehah, <verse eid="NUM 32:35" /><verse number="36" style="v" sid="NUM 32:36" />Beth Nimrah, nah Beth Haran riekelu namdidung meurün riedungde rielu. <verse eid="NUM 32:36" /><verse number="37" style="v" sid="NUM 32:37" />Reuben leuhme renam aidung retak dailu, Heshbon, Elealeh, Kiriathaim, <verse eid="NUM 32:37" /><verse number="38" style="v" sid="NUM 32:38" />Nebo, Baal Meon, penai zi pecaine kedi di, nah Sibmah. Penui retak dai kelu namdidung de penui hezi keda msiaklu. <verse eid="NUM 32:38" /><verse number="39" style="v" sid="NUM 32:39" />Manasseh napei Machir leuhme Gilead ga mie nah Amoritme cika kebam gade sütteu di. <verse eid="NUM 32:39" /><verse number="40" style="v" sid="NUM 32:40" />Pecai Moses Manasseh napei Machir de Gilead de peudi, nah penui mina dung cika lungh di. <verse eid="NUM 32:40" /><verse number="41" style="v" sid="NUM 32:41" />Manasseh napei Jair mie eh namceudung de tuilu nah cide Havvoth Jair de eh qulu. <verse eid="NUM 32:41" /><verse number="42" style="v" sid="NUM 32:42" />Nobah miedi nah Kenath nah pe namdung tuilu, nah pa cide pezi teu eh Nobah de eh qulu.<verse eid="NUM 32:42" /></para>
  <chapter eid="NUM 32" />
  <chapter number="33" style="c" sid="NUM 33" />
  <para style="s">Israel kembeuh setdung</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1" />Aide Israelme reunet maadung Moses nah Aaron muiteu kangga de Egypt deu gidi eh tet kempet dau heni kedadung gage mlai gai kecu hadung. <verse eid="NUM 33:1" /><verse number="2" style="v" sid="NUM 33:2" />Moses penui tet kempet gade tet kegwang heni ramsang zi raulu, RAMPAUBE aja kaikebeu nzwa eh. Aide penui tet kegwangdung da, ket gade keda gage tetgai kecu. <verse eid="NUM 33:2" /><verse number="3" style="v" sid="NUM 33:3" />Kei raitu benai penui Rameses gade nbeuh pet, kei raitu ziangreiehmengei benai tet mpet. Kahkegwang cangkelu peciabe tingcang, Egyptme pelane kengau gade Israelme tetdi. <verse eid="NUM 33:3" /><verse number="4" style="v" sid="NUM 33:4" />RAMPAUBE ne Egyptme neraibedung de teitset kedimedung de penui kung kebamdau, pa penui tinggwangdung dage de saja peu.<verse eid="NUM 33:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 33:5" />Israelme Rameses gade tet mpet Succoth gage ramzeuki teilu. <verse eid="NUM 33:5" /><verse number="6" style="v" sid="NUM 33:6" />Penui Succoth gade tet mpet Etham, hetaideu kung gage ramzeuki teilu. <verse eid="NUM 33:6" /><verse number="7" style="v" sid="NUM 33:7" />Penui Etham gade tetgai nah Pi Hahiroth caili gwangdi, cide Baal Zephon de ketsapreu kebam ga, penui Migdol taiga ramzeuki teilu. <verse eid="NUM 33:7" /><verse number="8" style="v" sid="NUM 33:8" />Pecai penui Pi Hahiroth de ketsapreu eh tet mpet nah jaaidi sum gade hetaideu ga mie. Penui langcumne ge Etham hetaideu gade tet gwang nah Marah gage ramzeuki teilu. <verse eid="NUM 33:8" /><verse number="9" style="v" sid="NUM 33:9" />Penui Marah gade tet mpet nah Elim ga gwanglu. Elim ga duirwak kereiehkena nah riakhena palm bangdung bam. Cika ge penui ramzeuki teilu. <verse eid="NUM 33:9" /><verse number="10" style="v" sid="NUM 33:10" />Penui Elim gade tet mpet nah Jaaidi Kegie tai gage ramzeuki teilu. <verse eid="NUM 33:10" /><verse number="11" style="v" sid="NUM 33:11" />Jaaidi Kegie gade tet mpet nah Sin hetaideu gage ramzeuki teilu. <verse eid="NUM 33:11" /><verse number="12" style="v" sid="NUM 33:12" />Penui Sin hetaideu gade tetpet nah Dophkah gage ramzeuki teilu. <verse eid="NUM 33:12" /><verse number="13" style="v" sid="NUM 33:13" />Penui Dophkah gade tet mpet nah Alush gage ramzeuki teilu. <verse eid="NUM 33:13" /><verse number="14" style="v" sid="NUM 33:14" />Penui Alush gade tet mpet nah Rephidim gage ramzeuki teilu, cika minadung dui teu kera ngau luma. <verse eid="NUM 33:14" /><verse number="15" style="v" sid="NUM 33:15" />Penui Rephidim gade tet mpet nah Sinai hetaideu gage ramzeuki teilu. <verse eid="NUM 33:15" /><verse number="16" style="v" sid="NUM 33:16" />Penui Sinai hetaideu gade tet mpet nah Kibroth Hattaavah gage ramzeuki teilu. <verse eid="NUM 33:16" /><verse number="17" style="v" sid="NUM 33:17" />Penui Kibroth Hattaavah gade tet mpet nah Hazeroth gage ramzeuki teilu. <verse eid="NUM 33:17" /><verse number="18" style="v" sid="NUM 33:18" />Penui Hazeroth gade tet mpet nah Rithmah gage ramzeuki teilu. <verse eid="NUM 33:18" /><verse number="19" style="v" sid="NUM 33:19" />Penui Rithmah gade tet mpet nah Rimmon Perez gage ramzeuki teilu. <verse eid="NUM 33:19" /><verse number="20" style="v" sid="NUM 33:20" />Penui Rimmon Perez gade tet mpetlu nah Libnah gage ramzeuki teilu. <verse eid="NUM 33:20" /><verse number="21" style="v" sid="NUM 33:21" />Penui Libnah gade tet mpet nah Rissah gage ramzeuki teilu. <verse eid="NUM 33:21" /><verse number="22" style="v" sid="NUM 33:22" />Penui Rissah gade tet mpet nah Kehelathah gage ramzeuki teilu. <verse eid="NUM 33:22" /><verse number="23" style="v" sid="NUM 33:23" />Penui Kehelathah gade tet mpet nah Shepher Deutu gage ramzeuki teilu. <verse eid="NUM 33:23" /><verse number="24" style="v" sid="NUM 33:24" />Penui Shepher Deutu gade tet mpet nah Haradah gage ramzeuki teilu. <verse eid="NUM 33:24" /><verse number="25" style="v" sid="NUM 33:25" />Penui Haradah gade tet mpet nah Makheloth gage ramzeuki teilu. <verse eid="NUM 33:25" /><verse number="26" style="v" sid="NUM 33:26" />Penui Makheloth gade tet mpet nah Tahath gage ramzeuki teilu. <verse eid="NUM 33:26" /><verse number="27" style="v" sid="NUM 33:27" />Penui Tahath gade tet mpet nah Terah gage ramzeuki teilu. <verse eid="NUM 33:27" /><verse number="28" style="v" sid="NUM 33:28" />Penui Terah gade tet mpet nah Mithkah gage ramzeuki teilu. <verse eid="NUM 33:28" /><verse number="29" style="v" sid="NUM 33:29" />Penui Mithkah gade tet mpet nah Hashmonah gage ramzeuki teilu. <verse eid="NUM 33:29" /><verse number="30" style="v" sid="NUM 33:30" />Penui Hashmonah gade tet mpet nah Moseroth gage ramzeuki teilu. <verse eid="NUM 33:30" /><verse number="31" style="v" sid="NUM 33:31" />Penui Moseroth gade tet mpet nah Bene Jaakan gage ramzeuki teilu. <verse eid="NUM 33:31" /><verse number="32" style="v" sid="NUM 33:32" />Penui Bene Jaakan gade tet mpet nah Hor Haggidgad gage ramzeuki teilu. <verse eid="NUM 33:32" /><verse number="33" style="v" sid="NUM 33:33" />Penui Hor Haggidgad gade tet mpet nah Jotbathah gage ramzeuki teilu. <verse eid="NUM 33:33" /><verse number="34" style="v" sid="NUM 33:34" />Penui Jotbathah gade tet mpet nah Abronah gage ramzeuki teilu. <verse eid="NUM 33:34" /><verse number="35" style="v" sid="NUM 33:35" />Penui Abronah gade tet mpet nah Ezion Geber gage ramzeuki teilu. <verse eid="NUM 33:35" /><verse number="36" style="v" sid="NUM 33:36" />Penui Ezion Geber gade tet mpet nah Kadesh ga Zin hetaideu gage ramzeuki teilu. <verse eid="NUM 33:36" /><verse number="37" style="v" sid="NUM 33:37" />Penui Kadesh gade tet mpet nah Hor Deutu gage ramzeuki teilu, Edom deu kung ga.<verse eid="NUM 33:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 33:38" />Cingkupei Aaron Hor Deutu ga RAMPAUBE aja gade hang nah pa mmi riakdai bekum Israel minadung Egyptme deu gade mpet kelu cai, kei mengei bekei, cipau kei tingbazie raitu benai tsaidi. <verse eid="NUM 33:38" /><verse number="39" style="v" sid="NUM 33:39" />Aaron Hor Deutu gade tsai kecudau pa mmi 123.<verse eid="NUM 33:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 33:40" />Arad gwangpei, Canaanme ge, Canaan deu hetaideu tingbangle lungh kelame ge, Israel minadung gwangla delie kecu siulu.<verse eid="NUM 33:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 33:41" />Penui Hor Deutu gade tet mpet nah Zalmonah gage ramzeuki teilu. <verse eid="NUM 33:41" /><verse number="42" style="v" sid="NUM 33:42" />Penui Zalmonah gade tet mpet nah Punon gage ramzeuki teilu. <verse eid="NUM 33:42" /><verse number="43" style="v" sid="NUM 33:43" />Penui Punon gade tet mpet nah Oboth gage ramzeuki teilu. <verse eid="NUM 33:43" /><verse number="44" style="v" sid="NUM 33:44" />Penui Oboth gade tet mpet nah Iye Abarim ga ramzeuki teilu, Moab deu rai gage. <verse eid="NUM 33:44" /><verse number="45" style="v" sid="NUM 33:45" />Penui Iye Abarim gade tet mpet Dibon Gad gage ramzeuki teilu. <verse eid="NUM 33:45" /><verse number="46" style="v" sid="NUM 33:46" />Penui Dibon Gad gade tet mpet nah Almon Diblathaim gage ramzeuki teilu. <verse eid="NUM 33:46" /><verse number="47" style="v" sid="NUM 33:47" />Penui Almon Diblathaim gade tet mpet nah Abarim lamlwatudung gage ramzeuki teilu, Nebo de ncwa kebam ga. <verse eid="NUM 33:47" /><verse number="48" style="v" sid="NUM 33:48" />Penui Abarim lamlwatudung gade tet mpet nah Jericho ga Jordan tai Moab langkiedung ga ramzeuki teilu. <verse eid="NUM 33:48" /><verse number="49" style="v" sid="NUM 33:49" />Penui Jordan taiga ramzeuki teilu, Beth Jeshimoth gade Abel Shittim ga Moab langkiedung ga.<verse eid="NUM 33:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50" />RAMPAUBE Moses de Jericho ga Jordan tai Moab langkiedung gade resiu, rang eh, <verse eid="NUM 33:50" /><verse number="51" style="v" sid="NUM 33:51" />“Israel minadung de resiu gai nah penuide rang beu, ‘Nnui Jordan tet kahpet Canaan deu ga canglu de, <verse eid="NUM 33:51" /><verse number="52" style="v" sid="NUM 33:52" />nnui cika lungh kebamme pelane de gwa mpetdi maisia. Penui gu mamie tei pwa kebamdung de nnui teimsia di maisia. Penui gu mamie tei keludung nah penui gu kerecakidung pelane teimsia di maisia. <verse eid="NUM 33:52" /><verse number="53" style="v" sid="NUM 33:53" />Nnui hangdeu cide gumlu maisia nah cika lunghlu, kedanemene Ih hangdeu de nnui gu mapwa kera peu dida. <verse eid="NUM 33:53" /><verse number="54" style="v" sid="NUM 33:54" />Nnui dacak eh hangdeu de gumlu maisia, pautsa rehi gade. Pautsa kedibedung de hangdeu kwa kekieebe, nah pautsa keceunadung de hangdeu qwa keceube peulu maisia. Dacak eh pautsa leune da gwang kelube deu, hangdeu cide penui gu dizie. Nnui paume leuh rehi gade nnui hangdeu gum zie. <verse eid="NUM 33:54" /><verse number="55" style="v" sid="NUM 33:55" />Dede nnui cipau deu ga lungh kebamme de gwa mpetdi meliecai, nnui peu cika lungh kebamme nnui miak ga keheradung nah nnui mbie ga hetudung nzwa dizie. Nnui lungh kebam ga penui nnuide peu lungh keherei dizie. <verse eid="NUM 33:55" /><verse number="56" style="v" sid="NUM 33:56" />Ciciu eh Ih penui da teigai kera de, nnui dage de teigai zie.’”<verse eid="NUM 33:56" /></para>
  <chapter eid="NUM 33" />
  <chapter number="34" style="c" sid="NUM 34" />
  <para style="s">Canaan Deuraidung</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 34:1" />RAMPAUBE Moses de mpau eh rang, <verse eid="NUM 34:1" /><verse number="2" style="v" sid="NUM 34:2" />“Israel minadung de aja peugai nah penuide rangbeu, ‘Nnui Canaan deu ga kelüt dau, hangdeu nnui gu kerade, Canaan deu nah pe deuraidung, <verse eid="NUM 34:2" /><verse number="3" style="v" sid="NUM 34:3" />tingbangle n deurai de Zin hetaideu gade Edom deurai ga kecang zie. Tingbangle deurai gu naimiak kepetle bie Ketsai Jaaidi gu tingbangle deurai ncüt. <verse eid="NUM 34:3" /><verse number="4" style="v" sid="NUM 34:4" />Nnui rai Akrabbim hangdeutu gade tingbangle ge nreu gai zie nah Zin hetaideu gade kahpet zie. Cikade, Kadesh Barnea gade tingbangle lebie ge nreu gai zie nah cikade Hazar Addar nah Azmon ga kecang zie. <verse eid="NUM 34:4" /><verse number="5" style="v" sid="NUM 34:5" />Cikade, herai Azmon gade Egypt reuceuna lambie ge nreu gai zie nah cikade jaaidi ga kecang zie.<verse eid="NUM 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 34:6" />Naimiak kenlütle deurai becai Jaaidi Kedi kung ga deda. Aide nnui gu naimiak kenlütle deurai zie.<verse eid="NUM 34:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 34:7" />Nnui gu tingtünle deurai de Jaaidi Kedi gade Hor Deutu kakga nnui herai kai kegai ga kecang zie, <verse eid="NUM 34:7" /><verse number="8" style="v" sid="NUM 34:8" />pecai Hor Deutu gade Lebo Hamath, pecai Zedad ga kecang. <verse eid="NUM 34:8" /><verse number="9" style="v" sid="NUM 34:9" />Pecai herai de Ziphron ga kecang zie nah Hazar Enan gade penli dizie. Aide nnui gu tingtünle rai zie.<verse eid="NUM 34:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 34:10" />Ciu eh nnui gu naimiak kepetle deurai kailu maisia Hazar Enan tingbangle gade Shepham ga. <verse eid="NUM 34:10" /><verse number="11" style="v" sid="NUM 34:11" />Pecai naimiak kepetle rai Shepham gade Riblah ga kecang zie, Ain gu naimiak kepetle lebie. Herai Kinnereth Jaaidi naimiak kepetle lebie gade jüja mie zie. <verse eid="NUM 34:11" /><verse number="12" style="v" sid="NUM 34:12" />Pecai herai de tingbangle Jordan Reuki gade Ketsai Jaaidi ga kecang zie nah cikade Ketsai Jaaidi naimiak kepetle rai lebie nghung zie. Aide nnui deu zie, cika heraidung tegwa kebam pelane.’”<verse eid="NUM 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13" />Pecai Moses Israel minadung de aja kai nah ranggai, “Aipau deu de nnui dacak ketei gade ngaulu zie, RAMPAUBE heleuh hekui nah heleuh pempie de ha zielie aja kaikebeu de. <verse eid="NUM 34:13" /><verse number="14" style="v" sid="NUM 34:14" />Reuben pautsa leuhme, penuide peu kebeu penui paume mabam, nah Gad pautsa leuhme, penui de peu kebeu penui paume mabam, nah Manasseh pautsa leuhme pempie ge penui deu ngau ciaklu. <verse eid="NUM 34:14" /><verse number="15" style="v" sid="NUM 34:15" />Heleuh be kena nah heleuh pempie penui hangdeu qwa Jericho ga Jordan kahpet kecu naimiak kepetle lebie, tingnaimiak pet kecu tai lebie ngaulu.”<verse eid="NUM 34:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16" />RAMPAUBE Moses de mpau, rang eh, <verse eid="NUM 34:16" /><verse number="17" style="v" sid="NUM 34:17" />“Aidungde nnui mapwa ziemne hangdeu mzibeu kerame zidung da: Cingkupei Eleazar nah Nun napei Joshua. <verse eid="NUM 34:17" /><verse number="18" style="v" sid="NUM 34:18" />Nnui muiteu ge heleuh ramsang gade penui pautsadung dage hangdeu mzi beu kera kedetlu maisia. <verse eid="NUM 34:18" /><verse number="19" style="v" sid="NUM 34:19" />Aidungde mipeidung zi da:</para>
  <para style="q1" vid="NUM 34:19">Judah leuhme gade, Jephunneh napei Caleb.<verse eid="NUM 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 34:20" />Simeon leuhme gade, Ammihud napei Shemuel.<verse eid="NUM 34:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 34:21" />Benjamin leuhme gade, Kislon napei Elidad.<verse eid="NUM 34:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 34:22" />Dan muiteume ge leuhme gade, Jogli napei Bukki.<verse eid="NUM 34:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 34:23" />Joseph napei Manasseh muiteume ge leuhme gade, Ephod napei Hanniel.<verse eid="NUM 34:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 34:24" />Ephraim muiteume ge leuhme gade, Shiphtan napei Kemuel.<verse eid="NUM 34:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 34:25" />Zebulun muiteume ge leuhme gade, Parnak napei Elizaphan.<verse eid="NUM 34:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 34:26" />Issachar muiteume ge leuhme gade, Azzan napei Paltiel.<verse eid="NUM 34:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="NUM 34:27" />Asher muiteume ge leuhme gade, Shelomi napei Ahihud.<verse eid="NUM 34:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 34:28" />Naphtali muiteume ge leuhme gade, Ammihud napei Pedahel.”<verse eid="NUM 34:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="NUM 34:29" />RAMPAUBE mipei aidungde de Canaan deu mzi kerane aja kaigai nah Israel leuhme ketket kecude penui qwa peu beu kerane.<verse eid="NUM 34:29" /></para>
  <chapter eid="NUM 34" />
  <chapter number="35" style="c" sid="NUM 35" />
  <para style="s">Levime Namdung</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1" />Jericho ga Jordan taiga Moab langkie gade RAMPAUBE Moses de mpau, rang eh, <verse eid="NUM 35:1" /><verse number="2" style="v" sid="NUM 35:2" />“Israel minadung de peu penui hangdeu qwa gade Levime de peulo de aja kaibeu lu. Penui penuide peu lungh kerane namdidung peu maisia nah ceheideu cipau namdidung de twagwapung kebam deu de peu maisia. <verse eid="NUM 35:2" /><verse number="3" style="v" sid="NUM 35:3" />Namdi aidungde Levime lungh kera ngaulu zie. Ceheideu de penui kauruine, penui kauhau, nah penui makaune leune ziemne zie. <verse eid="NUM 35:3" /><verse number="4" style="v" sid="NUM 35:4" />Namdidung twagwapung kebam ceheideudung Levime de nnui pwa peu kebam de namdi be kiriedung gade petu leune lebie cubit cangge twampet maisia. <verse eid="NUM 35:4" /><verse number="5" style="v" sid="NUM 35:5" />Nnui naimiak kepetle ge namdi be gwale de cubit cang na ge mdetlu maisia, nah tingbangle ge cubit cangna, naimiak kenlütle ge cubit cangna, nah tingtünle ge cubit cangna. Aide penui namdidung ziemne ceheideu zie. Namdidung sum ga bamzie.<verse eid="NUM 35:5" /></para>
  <para style="s">Kensiu Namdidung</para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 35:6" />Nnui Levime de namdi herok peu kecude kensiu namdidung ge tei zie. Mige migede teitset kedi dau heni aidungde ga pak gailu kera ziemne nnui peulu maisia. Keda namdidung riakdaiehkena de peu silu. <verse eid="NUM 35:6" /><verse number="7" style="v" sid="NUM 35:7" />Nnui Levime de namdi ha kecu pelane le riakdaieheset. Nnui penuide ceheideu de si eh peulu. <verse eid="NUM 35:7" /><verse number="8" style="v" sid="NUM 35:8" />Israel minadung heleuh kedibedung, heleuhdung hangdeu kiee kebamme, namdidung peu kiee ki kerabe. Heleuh keceube namdidung peu cam zie. Heleuh ramsang Levime de penui qwa ngaukelu rehi gade peu zie.”<verse eid="NUM 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9" />Pecai RAMPAUBE Moses de mpau, rang eh, <verse eid="NUM 35:9" /><verse number="10" style="v" sid="NUM 35:10" />“Israel minadung de resiulu nah penuide rangbeu, ‘Nnui Jordan tet kahpet Canaan deu cang kelu dau, <verse eid="NUM 35:10" /><verse number="11" style="v" sid="NUM 35:11" />nnui ziemne namdidung kedetlu maisia kensiu namdidung ge teilu kerane, heni cika mige teimau di eh migede teitset kedi dau cika pak gailu kerane. <verse eid="NUM 35:11" /><verse number="12" style="v" sid="NUM 35:12" />Hekum peei kelame dade namdi aidungde nnui nsiulu kera ni ge maisia, ciu eh mmau kelabe pei de de hemaabe dwa gade peu tutiak mene teitsetdi melu kerane. <verse eid="NUM 35:12" /><verse number="13" style="v" sid="NUM 35:13" />Nnui namdidung herok ge kensiu bam tei kerane kedetlu maisia. <verse eid="NUM 35:13" /><verse number="14" style="v" sid="NUM 35:14" />Nnui Jordan kahpet eh namdi kecum ge peulu maisia nah kecum ge Canaan deu ga. Cidungde kensiu namdidung zie. <verse eid="NUM 35:14" /><verse number="15" style="v" sid="NUM 35:15" />Israel minadung ziemne, sangme ziemne, nnui kakga lungh kebam keheibe ziemne, namdi herok aidungde kensiu ni ge tei eh mige teimau di eh mige de teitset kedi dau cika ge pak gailu kerane.<verse eid="NUM 35:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 35:16" />Dede mmau kebambe pei de migede hegeu reunet ge le dapgai cai, nah pa tsaidi cai, iciu cai mmau kebambe pei de mide dap ketsetme kesang da. Pecu teitsetdi maisia. <verse eid="NUM 35:16" /><verse number="17" style="v" sid="NUM 35:17" />Magade mmau kebam pei dene migede tangtsu ge le pwa teigai, nah pa tsai dicai, ciucai mmau kebam pei de mide teitset kecume kesang da. Pecu teitsetdi maisia. <verse eid="NUM 35:17" /><verse number="18" style="v" sid="NUM 35:18" />Magade mmau kebam pei dene migede tsingtie ge le dap gai, nah pa tsaidi cai, ciucai mmau kebam pei de mide dap ketsetme kesang da. Pecu teitsetdi maisia. <verse eid="NUM 35:18" /><verse number="19" style="v" sid="NUM 35:19" />Hekum peei kelame dapketsetbe de teitsetdi maisia. Pa pecu redau keludau, hekum peei kelame pecu teitsetdi maisia. <verse eid="NUM 35:19" /><verse number="20" style="v" sid="NUM 35:20" />Mige kedame de ngkau eh dapgai mede pecu mage le pwa beu gai, pecu tei kerane mbai kebamdau, iciu eh pa tsaidi cai, <verse eid="NUM 35:20" /><verse number="21" style="v" sid="NUM 35:21" />mede pa pe ba le migede ngkau eh zumgai eh zum tsetti cai, iciu cai mmau kebambe pei de de teitsetdi maisia. Pa au dapketsetme ge. Hekum peei kelame dapketsetbe de redau keludau pa pecu teitsetdi lubui.<verse eid="NUM 35:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 35:22" />Dede mmau kebambe gene kedame ge de teizie mene teidi mede mage le sam eh lie mene sam di <verse eid="NUM 35:22" /><verse number="23" style="v" sid="NUM 35:23" />mede magade pa migede sam tsetdi lu kebui tangtsu le ngau mene sam dicai, ciucai mmau kebambe pei de tsai kedibe ngauraume ma; tsai kedibe de pa tei rezam kera teibam ma. Dede rezam kedibe tsaidi cai ma aide tei gwang maisia. <verse eid="NUM 35:23" /><verse number="24" style="v" sid="NUM 35:24" />Cikenzwa dau, hemaabe mmau kebambe pei nah hekum peei kelame kakga aipau zaidung de gade tiak zie. <verse eid="NUM 35:24" /><verse number="25" style="v" sid="NUM 35:25" />Hemaabe mmau kebambe pei de hekum peei kelame gu kengkieng gade kelibeu maisia. Hemaabe mmau kebambe pei de pa n da pak kegai kensiu namdi gage ngngwa gwang dai beu maisia. Pa cika cingku kedibe kemci ca le keniak kelube de tsaidi kemaktane lungh zie. <verse eid="NUM 35:25" /><verse number="26" style="v" sid="NUM 35:26" />Dede mmau kebambe pei de kehei tingdau de pa pakgai kecu kensiu namdi deurai gade tetkah mpet, <verse eid="NUM 35:26" /><verse number="27" style="v" sid="NUM 35:27" />nah hekum peei kelame kensiu namdi deurai gwale de pecu ngaulu, nah pa mmau kebambe pei de teitsetdi liede, hekum peei kelabe da dapketset mau de gwang dilak. <verse eid="NUM 35:27" /><verse number="28" style="v" sid="NUM 35:28" />Kedanemene aide mmau kebambe pei cingku kedibe tsaidi kemaktane kensiu namdibe ga bam kerabe lugu. Cingku kedibe tsai kedi caine, mmau kebambe pei pe mabam kebam pe deu ga cailigwang dai lubui.<verse eid="NUM 35:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 35:29" />Hezai aidungde n ziemne nah n mina ceheudung nnui lungh kela heni leune ga hezai mzui kera ge lu maisia. <verse eid="NUM 35:29" /><verse number="30" style="v" sid="NUM 35:30" />Keheibe de mikehei gede teitset dicai, dapketsetme de teitsetdi maisia, pe zierang teikegai samdung gade nzwa eh. Dede zierang hangge sam rünne le au migede teitsetdi lak. <verse eid="NUM 35:30" /><verse number="31" style="v" sid="NUM 35:31" />Nnui mide dapketsetme mau rilu kerane pe teilung kelilu kera rangkang keu kerabe ma. Pecu teitset bi di maisia. <verse eid="NUM 35:31" /><verse number="32" style="v" sid="NUM 35:32" />Nnui mige kensiu namdi ga pakgai kedibe ziemne rangkang luu kerabe ma. Ainzwa eh nang pecu cingku kedibe tsaidi kemaktane pecu pe deu ga peu lungh kerabe ma. <verse eid="NUM 35:32" /><verse number="33" style="v" sid="NUM 35:33" />Ainzwa eh nnui lungh kebam deu de teihera diso, kedanemene dapketsetbe dade hejai dene hangdeu teihera di kelane. Hangdeu ga hejai lwa kedi dau kemau gi kera magede tei gailak, daptset kegaibe jai rünne gwale.<note caller="-" style="x"><char style="xo" closed="false">35:33 </char><char style="xt" closed="false"><ref loc="DEU 21:7">Hez. 21:7</ref></char></note> <verse eid="NUM 35:33" /><verse number="34" style="v" sid="NUM 35:34" />Cine nnui lungh kebam heni de teihera diso kedanemene Ih cika lungh bamlu. Kedanemene Ih, RAMPAUBE, Israel minadung kakga lungh bam.’”<note caller="-" style="x"><char style="xo" closed="false">35:34 </char><char style="xt" closed="false"><ref loc="LEV 18:24">Lev. 18:24</ref></char></note><verse eid="NUM 35:34" /></para>
  <chapter eid="NUM 35" />
  <chapter number="36" style="c" sid="NUM 36" />
  <para style="s">Zelophehad Napuidung Magum</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1" />Pecai (Manasseh napei) Machir napei Gilead leuhme pautsa kelakdung gade muiteumedung, Joseph dade lungh kegwang leuhme, gwang eh Moses nah Israelme pautsa kelakdung ga muiteume de resiu. <verse eid="NUM 36:1" /><verse number="2" style="v" sid="NUM 36:2" />Penui ranggai, “RAMPAUBE ne ncu aja kaibeu, anui mpaube, dacak eh Israel minadung de hangdeu qwa peulo. RAMPAUBE nnuide peu anui sinabe Zelophehad qwa pe napuimedung de peulo de aja peugai. <verse eid="NUM 36:2" /><verse number="3" style="v" sid="NUM 36:3" />Dede magade pe napuimedung keda Israel minadung leuh de ngngwa lungh dicai, penui hangdeu qwa pautsa qwa gade keu mpetdi zie. Cide penui dai leuh de ngngwa lungh bi cipaume qwa ga ncüt dizie. Cikenzwa dau, anui gum kera qwa gade cide keumpet dizie. <verse eid="NUM 36:3" /><verse number="4" style="v" sid="NUM 36:4" />Cikenzwa dau, Israel minadung gu Jubilee mmi kegwang dau, penui qwa de penui ngngwa lungh kelu leuhme qwa ga ncüt dizie. Ainzwa eh, penui qwa de anui pautsame qwa gade keuteu dizie.”<verse eid="NUM 36:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5" />Cine RAMPAUBE sam gade Moses Israel minadung dage aja peugai. Pa ranggai, “Joseph dade lungh gwang kelu leuhme kerang de petau lei. <verse eid="NUM 36:5" /><verse number="6" style="v" sid="NUM 36:6" />Aide RAMPAUBE Zelophehad napuimedung dage aja kai kegai. Pa rang eh, ‘Penuide peu penui cetpwa kela yitu kecume dage meu gailu, dede penui pei leuhme kakga rünne gage meu gaizie.’ <verse eid="NUM 36:6" /><verse number="7" style="v" sid="NUM 36:7" />Israelme qwa de heleuh ge gade kedage gage kedi gailak. Israelme hangge ge kecu pe pautsa leuhme qwa gum jüja lalu maisia. <verse eid="NUM 36:7" /><verse number="8" style="v" sid="NUM 36:8" />Israelme mipui keheibe pe leuh qwa gum kebamme pe pei leuhme de ngngwa lunghlu maisia. Ciciulude Israelme pelane de pe pautsame gu mapwa de gumlu kerane. <verse eid="NUM 36:8" /><verse number="9" style="v" sid="NUM 36:9" />Heleuh ge gu qwa de keda gene gum gailak. Israel leuhme keheibe de pekatei pe mapwa gumlu maisia.<verse eid="NUM 36:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 36:10" />Cine Zelophehad napuimedung RAMPAUBE Moses dage aja kaikebeu nzwa teilu. <verse eid="NUM 36:10" /><verse number="11" style="v" sid="NUM 36:11" />Mahlah, Tirzah, Hoglah, Milkah, nah Noah, Zelophehad napuimedung, Manasseh leuhme nau lu. <verse eid="NUM 36:11" /><verse number="12" style="v" sid="NUM 36:12" />Penui Joseph napei Manasseh pautsa leuhme da meu gwanglu. Ainzwa eh, penui mapwa de penui peime kebam leuh de ga bamdi.<verse eid="NUM 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 36:13" />Aidungde RAMPAUBE Moses dade Jericho gade Jordan kahpet Moab deu langkie ga kebam Israel minadung de ha kebeu ajadung nah hezaidung.<verse eid="NUM 36:13" /></para>
  <chapter eid="NUM 36" />
</usx>