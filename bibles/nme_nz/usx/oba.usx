<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Zeme(N) Bible Project</book>
  <para style="toc3">Oba.</para>
  <para style="toc2">Obadiah</para>
  <para style="toc1">Obadiah Laisiukwak</para>
  <para style="mt">Obadiah</para>
  <para style="mt">Obadiah Laisiukwak</para>
  <para style="is">Mraisam</para>
  <para style="ip">Obadiah zi pekie, “Jehovah Kilabe.” Laisiukwak kedui ainade gade gwale caihakecibe ha magede cima.</para>
  <para style="ip">Obadiah laisiukwak aide Edom de kemmau caiha ge.</para>
  <para style="ip">Deudi aide ceutu gade Jerusalem de pia gwa nah ngkapdi, cine Obadiah penuide mmau Tinggwang tutiak reci gai nah penui gwangram ngkap dizie lie eh caiha rang gai.</para>
  <para style="ip">Jerusalem A.D. 70 bekum ngkap kedicai Edomme ha siu dai meda.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Edom kaudi kera (1-14)</para>
  <para style="io1">Rampaube tingba benai Edom (15-21)</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />Caihakecibe Obadiah marengei kengau: Edom namdi ziemne a RAMPAUBE Tinggwang ranggai.</para>
  <para style="q1" vid="OBA 1:1">Anui RAMPAUBE dade sam ge siu da, nah heleuhdung kakga ge samgwabe ge de langgai dida:</para>
  <para style="q2" vid="OBA 1:1">Cuh lu! Nah pecu regi kerane anui cuh lugo!<verse eid="OBA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />Ainie, Ih ncu heleuhdung kakga de tei nceudi zie da,</para>
  <para style="q2" vid="OBA 1:2">ncu au ngaungkau süt dida.<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />N mlung hegie dene ncu cwa dida: tsurakang mbai bam ga kebambe, pe bam gade hegie bam;</para>
  <para style="q2" vid="OBA 1:3">pa pe mlung gade rang eh, “Cauge acu kideu ga ngngwa hung lulai?”<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />Magade nang nkatei ncu helie nzwa teihu teu bamcai,</para>
  <para style="q1" vid="OBA 1:4">magade nciep hegidung kakga bam liede,</para>
  <para style="q2" vid="OBA 1:4">cika de Ih ncu ngngwa hung dizie: RAMPAUBE ne ndukegai ge.<verse eid="OBA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />Magade keregame n da gwang,</para>
  <para style="q1" vid="OBA 1:5">nah tingmui dau marega teudi (nang dainzwa ngkapdi bi!), penui penui ziemne kekieege rega lak ni?</para>
  <para style="q2" vid="OBA 1:5">Magade kubetsi-dangkecume n da gwang, penui cidungde rum teu ciak dilak ni?<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />Edomme, Esau leuhme gu dainzwa rega teu dibi,</para>
  <para style="q2" vid="OBA 1:6">pe mabamdung kebai pwakebam de peei mpetlu!<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />N samkak minadung pelane ncu kemdei hangdeurai dei ge gage lang bam dida.</para>
  <para style="q1" vid="OBA 1:7">Ngu kezuyi minadung ncu cwa bam nah ncu renia reureu bam dida.</para>
  <para style="q2" vid="OBA 1:7">Penui ncu ngngwa taktyei kecume n dage baih teugai zie. Pe da kecikecet bam ma.<verse eid="OBA 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />(RAMPAUBE ndukegai ge) Ih cipau benai</para>
  <para style="q2" vid="OBA 1:8">Edom ga kemriakme de ngkapdi,</para>
  <para style="q2" vid="OBA 1:8">nah penui kecikecet pelane Esau lamlwatu gade tei nggah di lakni?<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />Nah n kengkieng minadung ngngi dizie, O Teman,</para>
  <para style="q2" vid="OBA 1:9">ciu eh dapketsetme ne Esau lamlwa gade mipei ge de teitset dizie.<verse eid="OBA 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />N sinabe Jacob de renia eh regi kecu ziemne, hengam ne ncu sung dizie,</para>
  <para style="q2" vid="OBA 1:10">nah kelungta ziemne ncu teitset dizie.<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />Nnui ketsapreu eh sap kecu benai,</para>
  <para style="q1" vid="OBA 1:11">cipaunai sangmedung pe mahei tuiteu di,</para>
  <para style="q2" vid="OBA 1:11">nah sangmedung pe kiriedung ga nlüt nah Jerusalem ga mzi beudi,</para>
  <para style="q2" vid="OBA 1:11">nang de penui nzwa hangge da.<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />Dede cipaunai nang n siname rei de nuidi kerabe ma.</para>
  <para style="q1" vid="OBA 1:12">Nah Judah napeidung penui kap eh gah kebam benai nang n suiyi eh bam kerabe ma.</para>
  <para style="q2" vid="OBA 1:12">Nah nang penui rei de teu henui tei kerabe ma.<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />A minadung kap eh rei kebam tingba dau nnui penui gu namdi kiriedung ga nlüt kerabe ma.</para>
  <para style="q1" vid="OBA 1:13">Nang pie kerabe ma, yeo, nang! pa kap eh rei kecu benai pe kesiabe ga.</para>
  <para style="q2" vid="OBA 1:13">Nah nnui mipuidung pe mahei de rega teudi kerabe ma pa kap eh rei kebam dau.<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />Nah penui mbai lai eh kebamme de tui kerane nnui puihai ga sap kerabe ma.</para>
  <para style="q2" vid="OBA 1:14">Nah penui keherei kecu benai nang penuide ngauraume dage tui gaibeu kerabe ma.<verse eid="OBA 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />Kedanemene heleuhdung pelane da RAMPAUBE tutiak tingba nna gwang zeu.</para>
  <para style="q2" vid="OBA 1:15">Nnui teikegai nzüt gade, cide nnui dage teigai zie,</para>
  <para style="q2" vid="OBA 1:15">nnui ziehi nnuikatei nnuida cailigwang zie.<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />Kedanemene a kemci lamlwatu gade nnui sak kecu nzwa, heleuhdung pelane de sak jüja bamzie.</para>
  <para style="q2" vid="OBA 1:16">Nah penui sak zie, nah penui mnwa zie, nah penui madaude lunggwang kemak nzwa dizie.<verse eid="OBA 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />Dede Zion lamlwatu cide ga paklu kera ge bam zie,</para>
  <para style="q1" vid="OBA 1:17">nah cika kemcibe bam zie,</para>
  <para style="q2" vid="OBA 1:17">nah Jacob leuhme penuikatei penui gu mabamdung gumlu zie.<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />Nah Jacob leuhme mi nzwa dizie, nah Joseph leuhme miheu ge nzwa, nah Esau leuhme reigau nzwa. Nah penai leuhme ne Esau leuhme ru dizie, nah penuide mnwa dizie.</para>
  <para style="q2" vid="OBA 1:18">Nah cika Esau leuhme bangkelume migede gah dizie,</para>
  <para style="q2" vid="OBA 1:18">kedanemene RAMPAUBE rang dida.<verse eid="OBA 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />Nah Negev ne Esau lamlwa de gumlu zie,</para>
  <para style="q1" vid="OBA 1:19">nah Shephelahme, Philistinme.</para>
  <para style="q1" vid="OBA 1:19">Nah penui Ephraim luh nah Samaria luh gumlu zie,</para>
  <para style="q2" vid="OBA 1:19">nah Benjamin, Gilead.<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">Jordan reuki naimiak kepetle lebie kebam Gilead deurai.</char></note><verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />Israel napeidung langgi kedi reugwame penui deu ga cailigwang zie, cipaume Canaanme, Zarephath ga kecang,</para>
  <para style="q2" vid="OBA 1:20">nah Jerusalem gade langgi kedi, cipaume Sepharad ga kebamme:</para>
  <para style="q2" vid="OBA 1:20">penui Negev namdidung de tui luzie.<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />Nah kelikebeume Zion lamlwa ga Esau lamlwa de tiak kerane hang zie,</para>
  <para style="q2" vid="OBA 1:21">nah hegwangram de RAMPAUBE gu dizie.<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">Lei. 22:28, Zec. 14:9</char></note><verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>