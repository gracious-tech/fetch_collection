<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Zeme(N) Bible Project</book>
  <para style="ide">UTF-8</para>
  <para style="h">Romans</para>
  <para style="toc1">Paul ne Romme dage Raukegai Laisiu</para>
  <para style="toc2">Romme</para>
  <para style="toc3">Rom.</para>
  <para style="mt">Romans</para>
  <para style="mt">Paul ne Romme dage Raukegai Laisiu</para>
  <para style="is">Mraisam</para>
  <para style="ip">Laisiu aide Paul ne Romme ga ngqwa dage AD 56-57 tingdau pa pe zierang beuh pe kecumbe cangla kedidau raugai. Paul Jerusalem ga gwangrai kera reguila nah pecaine Rome nah Spain ga mie kera. Pa laisiu aide pa rwagwang kerane mtei eh raukegai nzwa. Laisiu aide gu samdi becai masangkelu. Paul laisiu aide ga aidungde ledeugai: 1. migede masang ma; 2. Jisu Khrista au masang cangsiak kecube; 3. anui Jisu da kenlum bamcai, anuide kemau kengkieng gade lungmpet lula, teilung keheci ge peu dida, nah Tinggwang de ngngwa keludung petausiak ga cailigwang luda, anui Khristian teilung “mci nah Tinggwang suiyi ketei” ga lungh la kerabe da.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Mraisam (1:1-17)</para>
  <para style="io1">Migede masang ma (1:18-3:20)</para>
  <para style="io1">Kenlum gade masangkelu (3:21-8:39)</para>
  <para style="io1">Tinggwang mariem ga Israel (9:1-11:36)</para>
  <para style="io1">Khristianme teilung nah kelungh zai (12:1-15:3)</para>
  <para style="io1">Kekambe nah kelumkegai (15:14-16:27)</para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="s">Mraisam</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />Paul,<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">Paul: </char><char style="ft" closed="false">Laisiu aide raukegaibe zi kesang gade au Saul de qula. Saul au Hebrew zi ge; nah Paul de qukela zi be Greek. </char></note> Khrista Jisu kila ge de, langkegaime ge tei kerane qulu nah Tinggwang samlia ziemne kedet ntsamlu, <verse eid="ROM 1:1" /><verse number="2" style="v" sid="ROM 1:2" />cide pa kemci kesanglaisiu<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="fq" closed="false">Kemci kesanglaisiu: </char><char style="ft" closed="false">rangkebam aide Samkak Kehegwabe de rangbam, Mat. 21:42; 22:29; 26:54, Jhn. 5:39; 2 Tim. 3:15. </char></note> gage caihakecimedung dade mrairang eh pe sampet kaibeu, <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />pe Na ziemne, pa au pumteih zaibe gade hegwangpei David leuhme ge. <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />Kemci Rabe kengkieng gade pa au Tinggwang Nabe lie de eh ketsai gade ringcuh daikelu gade ndulia da, pa au anui Rampaube Jisu Khrista. <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />Pe zi ziemne, pe dade anui ngaugia nah langkegai ta tei kera ngaulu, heleuh pelane de kenlum ga peu bamlu kerane. <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />Heleuh aidungde kakga, nnuide de Jisu Khrista gu tei zielie qulu. <verse eid="ROM 1:6" /><verse number="7" style="v" sid="ROM 1:7" />Aipau laisiu de Rome namdi ga kebam Tinggwang kumedung, mina kemcime<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="fq" closed="false">Mina kemcime: </char><char style="ft" closed="false">pekie Tinggwang de helung pekiene kaibeudi eh kemci kenlumme ge teilung lung kecu.</char></note> lie qu kelumedung pelane ziemne. Ngaugia depeu nnuida lalu, nah kezuyibe anui Pei Tinggwang nah Rampaube Jisu Khrista dade peu nnuida bam kelube tei lulo.<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="EPH 1:2">Eph. 1:2</ref></char></note><verse eid="ROM 1:7" /></para>
  <para style="s">Paul Rome ga rwagwang neu kebam</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />Keraibe, nnui pelane ziemne Ih Jisu Khrista gade a Tinggwang de twa, kedanemene nnui kenlum au kideu pelane ga rangla kedine. <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />Kedanemene Ih mtakmene a kekie gade nnuide nsungbam muila kecude au Tinggwang ne a zierang da, pecu Ih a rabe gade samliakeyi teu eh pe Na ha paukela gade pe ta teila la. <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />Ih a kekie gade kiebam muila, Ih kehei tei liede Tinggwang lungning gade nnuida gwangcang bilu kerane. <verse eid="ROM 1:10" /><verse number="11" style="v" sid="ROM 1:11" />Kedanemene Ih nnuide ngauneu bamla, iciu eh Ih nnuide rabe mapeu kesa peu kerane, nnui kenlum teingkieng lu kerane. <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />Cide cai, nnui kakgade acu de nah nnuide de kecunglu kera Ih regui bamlei, hangge ge kenlum, n kenlum nah a kenlum gade. <verse eid="ROM 1:12" /><verse number="13" style="v" sid="ROM 1:13" />Sinamedung cu Ih nnuide peu cimene bam kecu teineu ma, Ih nnuida gwang kera pia kekiee mtei, (dede acu cu kecangde kaamdi zeu), Ih Gentileme kakgage teikegai nzwa eh, nnui kakgade petsi keyi builu kerane. <verse eid="ROM 1:13" /><verse number="14" style="v" sid="ROM 1:14" />Ih au Greekme nah sangmedung, makecime nah cikemakme dage de penui pau kepungme ge dida. <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />Cine, a ziemne au, nnui Rome ga kebamme dage de samliakeyi de paulia kera Ih au mtei pwabam.<verse eid="ROM 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />Kedanemene Ih samliakeyi de ziemne ngngam lama, kedanemene cide Tinggwang kengkieng gade keheibe de nlum kelume de kelilu kerabe kecune, keraibe Jewme ziemne nah pecai Jewme kemakme ziemne de.<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="2TI 1:8">2 Tim. 1:8</ref></char></note> <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />Kedanemene cikade Tinggwang masangbe kenlum ge gade kenlum ge eh keulia kecune, Kesanglaisiu ga ainzwa rauteu kelanzwa, “Dede makesangme kenlum gade ring luzie.”<note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="HAB 2:4">Hab. 2:4</ref>, <ref loc="GAL 3:11">Gal. 3:11</ref></char></note><verse eid="ROM 1:17" /></para>
  <para style="s">Minadung da Tinggwang rata</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />Kedanemene mci kemak nah mina masang kemakme leude, penui masang kemak gade kesangbe de kaam kedi ziemne tinggim gade Tinggwang lunghop ndulia dida. <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />Aide au kedanemene Tinggwang ha ci kelade penui ngau mcigi kebamne. Tinggwang ne penuide cide teimci laigai delu. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />Pecu ngaugai kelakbe zairehidung, kelungta kengkieng nah rabe zairehi, kideu teikelu gade ngau mcigi luda, bata teikegai gade cilu eh. Cine penui penui nzeu ranglu kera gah da.<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="JOB 12:7-9">Job 12:7-9</ref>, <ref loc="PSA 19:1">Lei. 19:1</ref></char></note> <verse eid="ROM 1:20" /><verse number="21" style="v" sid="ROM 1:21" />Aide kedanemene, penui Tinggwang ha cibam liede, penui pecu le Tinggwang lie eh hetwa peu ma, mede penui pecu suiyisam de pwapeu ma. Meliene, penui kecetdung miedi, nah penui lungcet kegah mlungdung muidi. <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />Penui maci lie rangla, dede penui mie dida.<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="JER 10:14">Jer. 10:14</ref></char></note> <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />Penui rim dila kemak Tinggwang kendu de keu, rimdi kela mina mie kenzwadung, nah nruinedung, nah makaune pe pi mdaidung, nah bwakela kaunedung de rehiak di.<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="DEU 4:15-19">Hez. 4:15-19</ref>, <ref loc="PSA 106:20">Lei. 106:20</ref></char></note><verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />Ciziemne Tinggwang penui lung herakedi ziemne penuide peu penui mlung hengin dungde teu penui zaira tei kera gage kai dida, penui katei penui kakgade penui pum de kengkau ta tei kerane. <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />Penui ne kemretpe le teu Tinggwang sam kesangbe rehiak di, nah Damkegaibe de, mene damkegai batadung de reca nah cide gwatei la dida. Damkegaibe depeu kelungta hetwa pung kelube tei lulo. Amen.<note caller="-" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="JER 13:25">Jer. 13:25</ref>;<ref loc="JER 16:19">16:19</ref></char></note><verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />Aide ziemne, Tinggwang penuide peu penui kengkau lungning dungde teu penui zaira tei kera gage kaidi, penui mipuidung hezai petaube gidi eh petau kemakbe teila dida. <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />Cinzwa eh, mipeidung de mipuidung de kengngwa petaube gidi nah penui katei hangge gede ngngwa pumteih henginbe teila dida. Mipeidung aidungde mipei kerai ngngwa ngngam kemak ta teila nah penui mau ziemne penui keherei ziehi ngau lula.<note caller="-" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="LEV 18:22">Lev. 18:22</ref>;<ref loc="LEV 20:13">20:13</ref></char></note><verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />Kedanemene penui Tinggwang de penui lungcet gade mnei kemakne,<note caller="+" style="f"><char style="fr" closed="false">1:28 </char><char style="fq" closed="false">Lungcet gade mnei: </char><char style="ft" closed="false">Penui Tinggwang ne pe mpaube lie rang kera cetlu tadi, aide ziemne penui kemau teilu kera lampui ngaulu. </char></note> Tinggwang penuide penui lungcet kesia teu penui zaira peu teila dida, penuide depeu petau kemakdung tei kera ziemne. <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />Penui kesang kemak, hezai kesia, migu luu keneu, nah periak kesia, ma aidung le kepui teila. Penui au ma kehengin, dapketset, rata, kecwa, nah kesia lungcet le pui pung. Penui au mi ha kerang, <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />mide kekii, Tinggwang ngauraume, mide kemneume, pekatei pecu mning mdi, ngang kecu, kesia tei kera tei kempet; penui pui peidung samzai teila ma. <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />Penui au penui kecet gah, kenlum gah, lungning gah nah mide ngaunggia lama. <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />Penui Tinggwang kesang zaide ci bamla, cikenzwa ta tei kelame ketsai ngaulu buisiak lie kecu. Dede penui aidungde teikecu rünne ma, penui kedame cidungde teikecu petau delie beula.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s">Tinggwang kemmau kenzeu de</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />Ciziemne nang au kenzeu gah,<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">Nzeu gah: </char><char style="ft" closed="false">Tinggwang dwade kemautadung teikedi ziemne penui nzeu gahdi; mede penui kemau teikedi ziemne saja kangga ladi.</char></note> O minabo, keheibede mi tutiak kelame, kedanemene nang kedame tutiak kelane nkatei ncu mmau la. Kedanemene nang mi tutiak kelame de cikesiak ge teila delu. <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />Dede Tinggwang tutiak au cikenzwa tatei kelame tutiak kecudau kesangbe rehi gade teikela anui cibam. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />Dede aide cet gailo, nang cinkenzwa ta teila kelame tutiak la liede nang de cikesiak ge teila. Tinggwang tutiak gade nang paklu buini? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />Mede nang pe ngaugia kedide, nah pa keherei ziehi tei kemri de, nah pelung ketie de au made melie eh cetla ni? Nang Tinggwang ngaugia de au peu ncu helungnreulu kera gage ngngwa gailu kera kecu nang ci meni? <verse eid="ROM 2:4" /><verse number="5" style="v" sid="ROM 2:5" />Dede n mlung takham kecune nah helungnreu kerau dene nang au lunghop tingba benai, nah Tinggwang tutiak kenzuibe keulia kecudau n katei ziemne lunghop hekwabam dida. <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />Mi keheibe dede pe bata tei kegai rehi nzwa Tinggwang peucaili daizie:<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="PSA 62:12">Lei. 62:12</ref>, <ref loc="PRO 24:12">Mac. 24:12</ref></char></note> <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />helung tie eh, bata keyi rehi gade hetwa, nah herüt, nah kesamsang peeila kecume de, Tinggwang kelungta kering peuzie. <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />Dede keheibe de pekatei peziu peei kelame, nah kesangbe samzai teila kemakme dede kesang kemak samzai tei kelame da, Tinggwang lunghop nah zaisiet rata gwang zie. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />Kesia tei kela mina keringria leune dage Tinggwang keherei nah suisiet teugwang beuzie, keraibe Jewme, nah Gentileme dage de. <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />Dede ma keyibe teikela leune da hetwa, nah herüt, nah lungciepbe gwang zie, keraibe Jewme, nah Gentileme dage de. <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />Kedanemene Tinggwang heneuherüt teila melu.<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="DEU 10:17">Hez. 10:17</ref>, <ref loc="2CH 19:7">2 Hel. 19:7</ref> </char></note> <verse eid="ROM 2:11" /><verse number="12" style="v" sid="ROM 2:12" />Hezaibe si mene kemau tei kelame hezai si mene kap dizie, nah hezaibe kangga de kemau tei kelame hezaibe ne pe tutiak zie. <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />Kedanemene Tinggwang dwade masang kelame au hezai siu kelume au ma, dede cide au hezai teimzai kelame pecu tei masang luzie. <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />Gentileme, hezai kegahme, penui zai gade hezaibe tadung teila, cidungde au penui ziemne hezaibe da, penuida hezaibe gah liede. <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />Aide gade penui hezai gade teimai kesia tadung de penui mlung gage raupwa kenzeu keulia dida. Penui lungcet ne de kesang delie kecu penuide keulia la, nah penui kecet ne penuide madauge mmau mede madauge penui lam pwala. <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />Cide Tinggwang mina pelane kengkim lungcet tutiak kecu benai tei luzie, Khrista Jisu gade, Ih samliakeyi kerang rehi de gade.<verse eid="ROM 2:16" /></para>
  <para style="s">Jewme nah hezai</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />Dede magade nang nkatei ncu Jewme lie qu nah hezaibe reu ngngei eh nah Tinggwang ha teu hegie lacai, <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />nah pe lungning ci nah daipaude yitu bi kedetlu, kedanemene nnuide hezaibe gade sauliadi delu; <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />nah magade nang nkatei ncu miakcitme puisau keteime ge, kemui ga kelame ziemne kebaa gelie eh, <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />kemieme de keledeube, henamedung gu keledeube, nah hezaibe gade nang maci nah kesangbe bamlie eh ci mci lucai, <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />iciucai nang mide ledeu kelabe, nkatei ncu de ledeula meni? Nang rega so de ledeu kelabe, nang rega lani?<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="MAT 23:3">Mat. 23:3</ref></char></note> <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />Nang migede kemmha ta teiso de eh rangkelabe, nang kemmha ta tei lani? Nang mamie kereca ngkau kelabe, nang kerecaki gu rega lani? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />Nang hezaibe gade ngang kelabe, nang hezai gikah eh Tinggwang de rütkemak ta tei lani? <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />Kedanemene “Nnui ziemne Gentileme kakga Tinggwang zi rangmsia la,” cide Kesanglaisiu ga raunzeu kecu nzwa.<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="ISA 52:5">Isa. 52:5</ref>, <ref loc="EZK 36:20">Eze. 36:20</ref></char></note> <verse eid="ROM 2:24" /><verse number="25" style="v" sid="ROM 2:25" />Kedanemene hegeukerum<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="fq" closed="false">Hegeukerum: </char><char style="ft" closed="false">Abraham da samkak teikelu aipau zai de kemlang ta gelie mnei lala. </char></note> n ziemne pemi bam kesang magade nang hezaibe mzai lucai, dede magade nang hezai gikah lacai, nang hegeurum kelude au rumkemak nsam ge dizie.<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="JER 4:4">Jer. 4:4</ref></char></note> <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />Cine, magade, hegeurum kemakme hezaibe teimai kesaide mzai lacai, pa pe geurum meliede rumkelu nzwa dilak ni? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />Mige pelui hegeurum kemak ge pa hezaibe mzai lacai ncu mmau lakni? Aide au kedanemene nang hezai rauteu kelade nah hegeukerum de bam, dede nang hezai teipang kelane! <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />Kedanemene pa au Jewme hegwazube rünne gade ma; mede hegeukerum de pumteihbe hegwazube rünne gade ma. <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />Dede pa au helungbe gade Jewme ge, nah hegeukerum au mi mlung gade, Rabe gade, raukelu hezai gade ma. Mina cikenzwame gu ketwa au mina dade gwang ma dede Tinggwang dade.<note caller="-" style="x"><char style="xo" closed="false">2:29 </char><char style="xt" closed="false"><ref loc="PHP 3:3">Php. 3:3</ref></char></note><verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="s">Kesamsang Tinggwang</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />Iciucai Jewme da daipai kentwage bamno? Mede hegeukerum pe kemmi daino? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />Cide maleu lamde disüt. Kedanemene keraibe, Tinggwang keuliakegai pelane de penuide nlumbeu.<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="ROM 9:4">Rom. 9:4</ref></char></note> <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />Ciude magade Jewme kangge kenlum gahcai? Penui nlum kemakne Tinggwang masang de teinggah dizie ni? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />Peu madaude ciciu di helo. Meliene, peu Tinggwang de samsang kelube tei lulo, mina leune mretdi liede. Kesanglaisiu ga raupwa kelanzwa,</para>
  <para style="q" vid="ROM 3:4">“Nnui samdung gade nnui masang kela keulialu kerane,</para>
  <para style="q" vid="ROM 3:4">nah nnui tutiak ga kegwangdau nnui cikade ngkienglu kerane.”<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="PSA 51:4">Lei. 51:4</ref>;<ref loc="PSA 116:11">116:11</ref></char></note><verse eid="ROM 3:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="ROM 3:5" />Dede magade anui masang kemak dene Tinggwang masang keuliacai, anui dai ranglu laino? Tinggwang pe lunghop keu kegwang ziemne masang melie zieni? (Ih au mina kesamlim kecu zai gade rangbam.) <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />Peu madaude ciciu di helo! Kedanemene iciucai dainzwa Tinggwang kideube tutiak laino? <verse eid="ROM 3:6" /><verse number="7" style="v" sid="ROM 3:7" />Dede magade Tinggwang kesamsang a kemret gade ketwa pwalia gwa lula liecai, daitie cude acu kemaume ge nzwa mmaula reuno? <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />Daitei rang melai, “Anui kesia tei gaigo, iciu eh keyi gwanglu kerane?” Anui cide ranglie eh pau maugai kebeu nzwa, nah mikangge anui, cide rangla lie kecunzwa. Penuide mmau kecude au petau.<verse eid="ROM 3:8" /></para>
  <para style="s">Migede masang ma</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />Iciucai dainzwa eh no? Anuikatei anui nzeu rangla ni? Ci au mezing. Kedanemene anui Jewme de nah Greekme de, penui pelane, kemau kangga kelane mmau dida. <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />Aide nzwa Kesanglaisiu ga rauteula:</para>
  <para style="q" vid="ROM 3:10">“Migede masang kecu gah, hange de gah.<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="ECC 7:20">Kel. 7:20</ref></char></note><verse eid="ROM 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ROM 3:11" />Macet kecime migede gah.</para>
  <para style="q" vid="ROM 3:11">Tinggwang de peeikelame migede gah.<verse eid="ROM 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ROM 3:12" />Penui pelane nreutet dida. Penui pelane nzang eh kemta ge dida.</para>
  <para style="q" vid="ROM 3:12">Migede keyi keteime gah da, hange de gah.”<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="PSA 14:3">Lei. 14:3</ref>;<ref loc="PSA 53:1">53:1</ref></char></note><verse eid="ROM 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ROM 3:13" />“Penui rwak au herau ngkeipwa kebam ge.</para>
  <para style="q" vid="ROM 3:13">Penui mleu au mide cwa dida.</para>
  <para style="q" vid="ROM 3:13">Henei hering penui muileu kangga la.”<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="PSA 5:9">Lei. 5:9</ref>;<ref loc="PSA 140:3">140:3</ref></char></note><verse eid="ROM 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ROM 3:14" />“Penui mui au reset nah keka samle puila la.”<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="PSA 10:7">Lei. 10:7</ref></char></note><verse eid="ROM 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ROM 3:15" />“Penui pi hejai teilwa kera nzetsüt la.<verse eid="ROM 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ROM 3:16" />Kekap nah keherei penui lampuidung ga la.<verse eid="ROM 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ROM 3:17" />Penui kezuyi lampui gede cima.”<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="ISA 59:8">Isa. 59:8</ref></char></note><verse eid="ROM 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ROM 3:18" />“Penui miak dwaga Tinggwang mie kehing gede lama.”<note caller="-" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="PSA 36:1">Lei. 36:1</ref></char></note><verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />Cu hezaibe ne kerang keheibe de anui ci luda, cide hezaibe kangga kelame de rangla. Aide peu mi pelane mui ngkuidi kerane, nah kideu pelane de Tinggwang tutiak gage ngngwa gwang gailu kerane. <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />Aide au kedanemene pe dwagade pumteihbe migede hezaibe batadung<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="fq" closed="false">Hezaibe batadung: </char><char style="ft" closed="false">hezaibe ne mide kangpwa delwe tei maisia kecu tadung.</char></note> gade tei masang gailak. Kedanemene hezaibe gade kemau maci gwang lalu.<note caller="-" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="PSA 143:2">Lei. 143:2</ref></char></note><verse eid="ROM 3:20" /></para>
  <para style="s">Kenlum gade masangkelu</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />Dede cu au hezaibe si mene Tinggwang masang de peu ci luda. Hezaibe nah caihakecime ne cide zierang teigai da, <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />cide cai, Tinggwang masang gade Jisu Khrista de kenlumme leune de tei masang luda. Kedanemene cika migede ketsam gah. <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />Kedanemene mina pelane kemau tei dida nah Tinggwang kendube dwade dui dida, <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />nah pe ngaugia mta kepeu Khrista Jisu da kebam rikelu dene penuide tei masanglu. <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />Kedanemene Tinggwang Khrista Jisu de ratak ge tei eh langgai, pe jai lwakegai gade nlumkelume de rilu kerane. Pa Khrista de kaipwa pe masang keulia gai, pa ndaa kemau dungde nsungdai kemak ziemne <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />Tinggwang pelung ketiene. Aide pekiene teikegai au cu ting ga pe masang keulia gailu kerane, iciude pa masanglu kerane nah Jisu de nlum kelume de tei masang beulu kerane.<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />Iciucai ngang kecu daiga bamno? Cide ncüt meni. Daipai sap gade no? Bata gade ni? Melie, dede nlumkelu sap gade lie. <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />Cine anui kekambe cetkelu au, mige de hezaibe tadung gade mene kenlum gade tei masang lula. <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />Mede Tinggwang au Jewme gu Tinggwang rünne ni? Pa Gentileme Tinggwang de si meni? Yeo, Gentileme gu de si. <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />Magade, Tinggwang au ket lie kecu kesang liecai, pa hegeukerumme de kenlum gade, nah hegeurum kemakme de kenlum gade tei masang beuzie.<verse eid="ROM 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 3:31" />Ciucai anui kenlum gade hezaibe de gidi zieni? Peu madaude ciciu di helo! Meliene, anui kenlum bam kecude ne anui hezaibe teicang lula.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s">Kenlum gade Abraham de tei masangkelu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />Anui daibe rang zieno Abraham, anui paume pumteihbe zai rehi gade, ngaukelu? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />Kedanemene magade Abraham de pe batadung ziemne tei masang lucai, pa nganglu kera pekie bam lubui, dede Tinggwang dwade au ma.<note caller="-" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="GEN 15:6">Ken. 15:6</ref></char></note> <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />Kesanglaisiu daipai rangla no? “Dede Abraham Tinggwang de nlumlu, nah pecu masang lie eh luulu.”<note caller="-" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="GEN 15:6">Ken. 15:6</ref></char></note> <verse eid="ROM 4:3" /><verse number="4" style="v" sid="ROM 4:4" />Mata keteibe, pecu ziehi kepeude au mapeu lie eh pei gailak, cide au pa hikelu da. <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />Dede mige mata teila kemakbe pa nlumla kemakme de tei masang beu kelabe de nlum lucai, pe kenlum au masang lie eh luu lula. <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />Cine David liede batadung si mene Tinggwang ne masang lie eh luu kelube de samlam beu. <verse eid="ROM 4:6" /><verse number="7" style="v" sid="ROM 4:7" />Pa kesanglaisiu ga ranggai,</para>
  <para style="q" vid="ROM 4:7">“Hezaibe gikah eh bata kesia keteime penui mau gibeu kedimedung,</para>
  <para style="q" vid="ROM 4:7">nah penui maudung gumdi kecumedung au samlam pungtu.<verse eid="ROM 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ROM 4:8" />Rampaube minabe reu pe mau peidi kemakme au samlam pungtu.”<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="PSA 32:1-2">Lei. 32:1-2</ref></char></note><verse eid="ROM 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="ROM 4:9" />Iciucai samlam aide hegeukerumme da rünne ranggai bamni, mi hegeurum kemakme dungde sino? Kedanemene anui rangla, “Abraham de au kenlum dene tei masang luda.” <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />Ciciu cai dainzwa cide peilu dino? Abraham hegeurum keludau mi, hegeurum kemakne no? Cide au hegeurumkelu caine ma, dede hegeurum kemakne lie. <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />Pa pe kenlum dene pecu tei masang kelu kaugiak pa hegeurum kemakne de hegeukerumme rehi pa ngaulu, iciu eh pa nlumkelu pelane pei teilu kerane, penui hegeurum meliede, iciu eh penuide masang kecuga peincüt gailu kerane.<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="GEN 17:11">Ken. 17:11</ref></char></note> <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />Nah pa hegeurumkelu peibe teilu hegeurum kelume ziemne rünne ma dede anui pau Abraham pe geurum kemakne kenlum teu eh kelungh puisau de mzui kelame, ziemne de da.<verse eid="ROM 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />Kedanemene Abraham dage nah pe leuhme dage pa kideube mapwabe zielie kecu sampet kai kebeude hezaibe gade gwang ma dede kenlum masang gade. <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />Kedanemene magade hezaibe gade kelunghme de mapwame teizie liecai, kenlum au tei nrwa dida, nah sampet au kemta dida. <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />Kedanemene hezaibe au Tinggwang lunghop keugwangbeu kelane, dede hezai kegah ga au gikah kecude bamla ma. <verse eid="ROM 4:15" /><verse number="16" style="v" sid="ROM 4:16" />Aipau kiede ziemne kenlum gade sampet kaikebeu au ngaugia rehi gade nah Abraham leuhme pelane de peu kerane, hezaibe kangga kebamme rünne ma, dede Abraham kenlum mzi kelume ziemne de. Pa au anui pelane pei da, <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />Kesanglaisiu ga ainzwa raupwala, “Ih ncu peu heleuh kekieege pei teibeu dida,”<note caller="-" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="GEN 17:5">Ken. 17:5</ref></char></note> pa nlum kela Tinggwang dwa gade, tsaikedime de kering peu kelabe nah ma lunghla kemak dungde tei mlung kegaibe. <verse eid="ROM 4:17" /><verse number="18" style="v" sid="ROM 4:18" />Keregui bam kera pekie gah liede pa nlumlu, pa heleuhdung kekiee ge pei teilu kera nlum eh, pe dage rangkebeu nzwa, “N leuhmedung cinzwa kiee luzie.” <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />Kenlum ga mneidi mene, pa pekatei pe pum de au tsai kedi gage cet gaidi (kedanemene pa mmi haige kenzwa kedine), nah pa Sarah henabam tsaikedi kecuga cet gaidi.<note caller="-" style="x"><char style="xo" closed="false">4:19 </char><char style="xt" closed="false"><ref loc="HEB 11:11">Heb. 11:11</ref></char></note> <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />Dede Tinggwang sampet kaikebeu ziemne, Abraham pe kenlum suihau dima. Meliene, kenlum ne pecu teingkieng silu nah pa Tinggwang de ketwa peu. <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />Tinggwang pe sampet kai kebeude teicanglu kebui pa nlum cangsiak bam. <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />Ciziemne aide ne de pecu pei pwa masang lie di.<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="GEN 15:6">Ken. 15:6</ref></char></note> <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />Nah Tinggwang pecu masangkelame ge lie qu kelude au, Abraham ziuyi rünsangne ziemne pei luma, <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />dede anui ziemne desi, masang kelame gelie de pei silu kera au, anui ketsai gade Jisu anui Rampaube de kwakcuh kelube de nlum kelume. <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />Aide pa delie anui maudung ziemne pe pum kaikebeube nah anuide tei masanglu kerane kwakcuh kelube.<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="ISA 53:4-5">Isa. 53:4-5</ref></char></note><verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s">Lungciep nah suiyi</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />Anuide kenlum gade tei masang kelune, anui Rampaube Jisu Khrista gade Tinggwang de ngngwa kezuyi bam. <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />Pe dade anui liede kenlum gade ngaugia aide ga anui sap kebamde ga lütkelu bam, nah Tinggwang kendu regui kelaga anui suiyi bam dida. <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />Dede aide rünne ma, anui reidung ga anui suiyi bam, keherei kecu ga liakelu peukela ci kebamne. <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />Dede liakelu au mizai tei ntip beula, nah mizai kentip dene kelikelu keregui de peula, <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />nah keregui cide mide tei nghetdi lama kedanemene Tinggwang keku de anuide kepeube Kemci Rabe gade anui mlung gage ruigai beu dida. <verse eid="ROM 5:5" /><verse number="6" style="v" sid="ROM 5:6" />Kedanemene anui mnei eh kengking gah eh kebamdau, peting siakdau Khrista kemaume ziemne tsaibeu. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />Kedanemene mige makesangme ge ziemne au tsai beulak. Keyime ge ziemne mige tsai gaibeu lubui liede. <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />Dede Tinggwang pe keku anui dage keulia mci gaida, kedanemene anui kemaume lu liede, Khrista anui ziemne tsaibeu. <verse eid="ROM 5:8" /><verse number="9" style="v" sid="ROM 5:9" />Cipau reude, cu anuide Khrista jai ne tei masang kelune, Tinggwang lunghop gade anuide cide ne kelilu zie. <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />Kedanemene magade, anui pe ngauraume teibam keladau, pe Na tsaigai kebeu gade anui Tinggwang de ngngwa kezuyi lucai, daihia gede, kezuyi kelu caide, pe teilung le anuide kelilu zieno. <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />Dede aide rünne mene, anui Rampaube Jisu Khrista, anui cu kezuyi daikelu aide ngau kelube gada anui liede Tinggwang da anui suiyi bam.<verse eid="ROM 5:11" /></para>
  <para style="s">Adam dade ketsai, Khrista dade kering</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />Cine, mina hangge<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="fq" closed="false">Mina hangge: </char><char style="ft" closed="false">Adam de rangbam.</char></note> dade kideube ga kemau gwang kecunzwa, ainzwa eh kemau gade ketsai gwangdi. Cine ketsai mina pelane da zangra gwangdi, kedanemene pelane mau kedine.<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="1CO 15:21-22">1 Cor. 15:21-22</ref></char></note> <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />Kedanemene hezaibe dwa, kemau au kideube gala, dede hezaibe kegahdau kemau de maulie swama. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />Iciuliede, Adam gade gwang Moses kecang ketsai ne di ladi, kemau tei eh Tinggwang aja de mzai luta kedi anui Adam nzwalu meliede, Adam au mige gwanglai eh kelabe Khrista rehi ge da.<verse eid="ROM 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 5:15" />Dede Tinggwang mapeu au Adam kemau teikedi kenzwage ma. Kedanemene mige hezai gikah kegai ziemne kekieege tsaidi liecai, Tinggwang ngaugia de daihia gede kieeki ziebi mi hange, Jisu Khrista, ngaugia mapeu de, mi kekieege ziemne kepui teilu kera! <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />Kedanemene mtamapeu de au kemau tei kedibe caineu ge nzwa ma. Kedanemene kesang, mige hezai gikah kedine gade tutiak de gwang nah kemmau de teugwang lu, dede mta mapeu de anui hezai gikah kedi kekieege gage kemzuibe teugwang beu. <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />Kedanemene magade, mige hezai gikahkedi ziemne, ketsai pe dade ngkieng lucai, daihia gede ngaugia kedide nah makesang mapeude pe dade, Jisu Khrista gade luu kelume penui teilung reu ngkienglu ziebi. <verse eid="ROM 5:17" /><verse number="18" style="v" sid="ROM 5:18" />Cine, mige hezai gikahkedi gade mina pelane da kemau gwangdi, cinzwa eh mige makesang bata ziemne kesangbe gage teuswa lula nah mina pelane ziemne teilung keheci peula. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />Kedanemene mi hangge<note caller="+" style="f"><char style="fr" closed="false">5:19 </char><char style="fq" closed="false">Mi hangge: </char><char style="ft" closed="false">Adam de rangbam.</char></note> samzai teikemak gade mi kekiee ge kemau teidi, iciu liede mi hangge<note caller="+" style="f"><char style="fr" closed="false">5:19 </char><char style="fq" closed="false">Mi hangge: </char><char style="ft" closed="false">Khrista de rangbam.</char></note> samzai teikegai gade mina kekiee de tei masang luzie. <verse eid="ROM 5:19" /><verse number="20" style="v" sid="ROM 5:20" />Dede kemau teingkiee kera hezaibe<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="fq" closed="false">Hezaibe: </char><char style="ft" closed="false">Sam aide Samkakkelu Kehegwabe ga raupwala kebam zaidungde de rangbam kera nlum.</char></note> gwang. Dede kemau kekiee kebam ga Tinggwang ngaugia de kieeki. <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />Aide teikegai au, kemau ketsai reu di kedinzwa, anui Rampaube Jisu Khrista gade Tinggwang ngaugia de makesang gade peu kelungta teilung reu kengkieng teu lalu kerane.<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s">Kemau gage tsaigai, Khrista gade ringlu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />Iciucai anui dai ranglai? Anui kemau tei jüja bam zieni iciude ngaugia kieesi lu kerane? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />Peu madaude cinzwadi helo. Anui kemau gage tsai kedime,<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="fq" closed="false">Kemau gage tsai kedime: </char><char style="ft" closed="false">rang kebam samtie aide pekie coksüt bam, mage gage tasigaidi kera au pekie, cipaude baang teikela gade mpet kedine delu.</char></note> dainzwa cika anui lungh bamsi lulai? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />Mede nnui kekiee ge Khrista Jisu gade duipum tei kelume pe tsit gage duipum tei kelu nnui ci meni? <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />Cine, anuide au duipum teikelu gade pecu ngngwa pe tsit gage kung dida. Aide teikedi au Peibe Tinggwang kendu gade Khrista de ketsai gade kwakcuh kelunzwa, anuide peu teilung kehecibe ga lunghlu kerane. <verse eid="ROM 6:4" /><verse number="5" style="v" sid="ROM 6:5" />Kedanemene magade anui pecu ngngwancüt lucai pa ketsai nzwa tsai eh, pa ringcuh kecuga anuide ngngwancüt luzie. <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />Aide anui cibam, anui teilung kehegwabe de pecu ngngwa gwakdi kecu, iciu eh kemau pumteih de ngkapdi kerane. Aide teikedi au anuide peu kemau baang teisi tadi kerane. <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />Kedanemene tsai kedibe de au kemau gahda de eh ndulia dida.<note caller="-" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="ACT 13:38">Bat. 13:38</ref></char></note> <verse eid="ROM 6:7" /><verse number="8" style="v" sid="ROM 6:8" />Dede anui Khrista de ngngwa tsai dicai, anuide pecu ngngwa lunghdi kera anui nlum bam. <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />Anui cibam Khrista de ketsai gade kwakcuh kelune pa tsai dailak da; ketsai pereu kengkieng bamsi meda. <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />Kedanemene Khrista tsit de au, pa piage gage pelane ziemne kemau gage tsaigai. Ciuliede, pa lungh kela teilung de, pa Tinggwang ziemne lungh bam. <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />Cinzwa eh, nnui nnuide kemau ga tsai gaidi delie de, Khrista Jisu gade Tinggwang da ringla dida lie eh cetlu maisia.<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />Ciziemne kemau depeu nnui rimdi kela pum reu diso iciu eh nnui pumteih hengin dungde mzai melu kerane. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />Nnui pum mzidung de kemau gage kaiso, masang kemakbe netdung teidi kerane. Dede Tinggwang de nnui teilung peulu, ketsai gade kering gage ngngwagai kelumedung nzwa, nah nnui pum mzidung de Tinggwang de peulu kesamsang netdung teilu kerane. <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />Cine kemau depeu nnui reu diso. Kedanemene nnui hezaibe kangga bam ma, dede ngaugia kangga.<verse eid="ROM 6:14" /></para>
  <para style="s">Makesangbe kilamedung</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />Iciucai dainzwalai? Anui hezaibe kangga mene, ngaugia kangga la kedine kemau teizie ni? Peu madaude cinzwadi helo. <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />Nnui kilame ge tei eh mige samzai tei zielie eh nuikatei nnuide kekaibe, nnui pe sam mzai kelabe kilame lie kecu ci meni? Aide au kesang nnui ketsai gage kaidi kela kemau kilame mi, mi makesang gage kailu kela samzai kilame bi. <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />Dede Tinggwang de twa! Kedanemene nnui kemau baang teigwang, dede nnui lung gade nnuide peu kebeu keledeusam mzai luda. <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />Dede kemau gade nnuide teumpet luda, nah nnuide makesangbe kilame tei dida. <verse eid="ROM 6:18" /><verse number="19" style="v" sid="ROM 6:19" />Ih mina ria gade ma rangla kedanemene nnui pumteihbe kemnei dene. Kedanemene nnui pumbe keu nnui mci kemakdung kilabaang tei eh nah hezai teikemak gage kai kedi, cide nzwa cu, nnui pumbe de makesangbe da kilabaang tei eh pwa peulu tei mcilu kera ziemne. <verse eid="ROM 6:19" /><verse number="20" style="v" sid="ROM 6:20" />Kedanemene nnui kemau kilabaang tei keladau, makesangbe nnuida lama. <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />Cipau tingdau, nnui daipai kemmi ge ngaulu dino cu nnui ngngam bam keladung gade? Kedanemene cidungde caineu au ketsai. <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />Dede cu au nnuide kemau gade teumpet luda nah Tinggwang gu kilabaangme ge dida, nnuide tei mcilu kera nnui petsi bam dida. Cide gu caineu au kelungta kering. <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />Kedanemene kemau ziehidung au ketsai, dede Tinggwang mta mapeu au anui Rampaube Khrista Jisu gade kelungta kering.<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s">Laktak gade saukelia ge</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />Nnui ci meni, a sinamedung (Ih mina hezai ci kelame dage rangla), mige de au pa ring kebamtane hezaibe ne kangpwa bamla lie kecu? <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />Kedanemene meu kedibe pui pe nahpei lungh kebam tingkak hezai gade pe kangga bamla, dede pe nahpei tsai dicai, pecu au laktak zai kang gade lungmpet beula. <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />Cine, pe nahpei lungh kebamdau, magade pa mipei kedage de ngngwa lunghcai, pecu le kemmhapui gelie qu dizie. Dede pe nahpei tsai dicai, pa au hezai kangga bam meda, cine pa au mipei kedage de ngngwa lunghdi liede pecu kemmhapui gelie qu daulak. <verse eid="ROM 7:3" /><verse number="4" style="v" sid="ROM 7:4" />Ciziemne, a sinamedung, nnuide de Khrista pumteihbe gade hezaibe gage tsai dida. Aide au peu nnuide kedabe de ncütlu kerane, cide cai, pa ketsai gade ringcuhdai kelube da, iciu eh anui Tinggwang ziemne petsi builu kerane. <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />Kedanemene anui pumteihbe ga kebamdau, pumteih lungning kesiadung, hezaibe ne kecung gaibeu eh, ketsai ziemne petsi bui kera anui mzidung ga heta teila. <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />Dede cu au anuide hezaibe gade teumpet dida. Anuide kangpwa kelade gade anui tsai dida. Aide au peu anuide ndaa rauteukela zaibe gade mene Tinggwang Rabe teilung keheci gade hegwatei lu kerane.<verse eid="ROM 7:6" /></para>
  <para style="s">Kemau de kerenia</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />Iciucai anui dai ranglai? Hezaibe mau lani? Peu madaude cinzwadi helo. Iciuliede, hezaibe gade meliecai, Ih madaude kemau daibi cilak nage. Kedanemene Ih migu kehengin daibi cilak nage, hezaibe, “Nang migu hengin so,” degai meliecai.<note caller="-" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="ROM 3:20">Rom. 3:20</ref></char></note> <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />Dede kemau sam kaikebeu gade ziuyi keyi ngaulu eh a da kehengin leune teugwang beu. Kedanemene hezaibe gahcai, kemau au kengkieng gah. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />Dede piage hezaibe de si mene Ih lungh, dede sam kai kebeude gwang luge, kemaube ringcuh dailu, <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />nah Ih tsaidi. Ringlu kera sam kai kebeude a ziemne ketsai ge di.<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="LEV 18:5">Lev. 18:5</ref></char></note> <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />Kedanemene kemau sam kai kebeude gade zuiyi keyi ngaulu eh acu cwadi, nah sam kai kebeude gade acu teitset di.<note caller="-" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="ROM 7:8">Rom. 7:8</ref></char></note> <verse eid="ROM 7:11" /><verse number="12" style="v" sid="ROM 7:12" />Cine hezaibe au mci, nah samkai kebeude au mci, nah masang, nah yi.<verse eid="ROM 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 7:13" />Cine keyide a ziemne ketsai ge dini? Peu madaude cinzwadi helo. Dede kemau, keyibe gade cide kemau lie ngau hecili lu kerane a da ketsai teugwang beu. Aide au peu samkai kebeude gade kemau de mdet canggai kelak mau ge teilu kerane. <verse eid="ROM 7:13" /><verse number="14" style="v" sid="ROM 7:14" />Kedanemene anui hezaibe au rabe gu lie kecu ci, dede Ih au pumteihbe gu. Acu au kemau baang tei kera zwabeu dida. <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />Kedanemene Ih tei kelabe, Ih ci lama. Kedanemene Ih tei keneube, aide Ih tei lama. Dede Ih ngkau kelabe, aide Ih teila. <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />Dede Ih tei neu kemakbe de Ih teila cai, hezaibe petau lie kecu hezaibe de Ih kesuizwa da. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />Dede cu au aide teila kelabe au Ih meda, dede kemau a lungga lungh kelade ne dida. <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />Kedanemene a lungga, cide a pumteihbe ga, keyi ketde gah kecu Ih cibam. Kedanemene keyibe tei kera a lungning bam, dede keyi cide teilu kebui a da gah.<note caller="-" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="GEN 6:5">Ken. 6:5</ref></char></note> <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />Kedanemene Ih keyi tei keneube Ih tei lama, dede makesia Ih teineu kemakbe de, Ih teila la. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />Cu Ih teineu kemakbe tei liecai, cide Ih ne teibam meda, dede kemau a lungga lungh kelade ne dida. <verse eid="ROM 7:20" /><verse number="21" style="v" sid="ROM 7:21" />Cu, Ih keyi teineu kela, a da hezai kelade, Ih cilu, dede kesiade a da la muila <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />Kedanemene Ih a lung gade Tinggwang ne hezai kai kebeude ga asui lala. <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />Dede Ih a pumteih ga hezai kedage ngau. Cide hezai kehecibe de ngngwa a lungning gade renia la. A pumteih ga kebam kemau zaide ne acu pe baang teilu. <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />Ih mina kemneu ketei kauge da! Caune ketsai pumteih aide gade acu kelibeu zieno? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />Dede anui Rampaube Jisu Khrista gade Tinggwang de twa! Cine, Ih a lung gade Tinggwang hezai kai kebeude ta teila. Iciuliede, a pumteihbe le Ih kemau zaibe gwatei la.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s">Rabe gade kelungh</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />Cine cu Khrista Jisu da la kedime ziemne au mmaugai kera<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="fq" closed="false">Mmaugai kera: </char><char style="ft" closed="false">Samliakeyi de au hezaibe nzwa mide mmau lamah.</char></note> gahda. <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />Kedanemene Khrista Jisu ga kering Rabe zaide ne kemau zai nah ketsai gade ncu kelilu da. <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />Kedanemene Moses zaibe au pumteihbe gade mnei kedine teigai kelakbe Tinggwang tei luda. Pa pekatei pe Na Jisu de kemau ratak tei kera ziemne kemau pumteih nzwa eh langgai, nah pa pumteihbe gage kemau de mmau dida. <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />Pa aide teikegai au hezai makesiadung anui dade tei canglu kerane, anui pumteihbe zai ga mene Kemci Rabe zai ga lunghlu kelame. <verse eid="ROM 8:4" /><verse number="5" style="v" sid="ROM 8:5" />Kedanemene pumteihbe zai gade lungh kelame pumteihbe gudung gage pelung kai teula la, dede Kemci Rabe zai gade lungh kelame Kemci Rabe gudung gage pe lung kai teula la. <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />Kedanemene pumteihbe gage lungning kaiteu kela au ketsai, dede Kemci Rabe gage lungning kaiteu kela au kering nah lungciep. <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />Aide kedanemene pumteihbe gage lungning kaiteu kela au Tinggwang ngaurau lu, cide au Tinggwang zaibe kangga bamla kemak ziemne, nah cide bamde gailak. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />Dede pumteihbe ga kelame Tinggwang suiyi tei gailak. <verse eid="ROM 8:8" /><verse number="9" style="v" sid="ROM 8:9" />Ciciude, nnui au pumteihbe ga lama dede Rabe ga la, magade Tinggwang Rabe nnui lungga lunghla kesang liecai. Dede mige peda Khrista Rabe la mecai, pa Khrista da lama. <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />Dede Khrista nnui lungga lacai, pumbe au kemau ziemne tsai dida, dede kesamsang ziemne Rabe au ringla. <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />Jisu de ketsai gade kwakcuh kelube Rabe de n lungga lunghla kesang liecai, pa Khrista Jisu de ketsai gade kwakcuh kelube pe Rabe gade nnui lungga kelade gade nnui rimdi kera pumde de kering peuzie.<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />Cine, sinamedung, anui au hepau kepungme ge, dede pumteihbe zai gade lungh kerane pumteihbe pau pungbam ma. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />Kedanemene nnui pumteihbe lungning gade lunghcai, nnui au tsai zieda, dede Rabe gade pumteihbe bata dungde nnui teitset dicai, nnui ring luzie. <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />Kedanemene Tinggwang Rabe ne lampui saukela leune, cidungde au Tinggwang namedung delie. <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />Kedanemene nnui hebaang teidi kera rabe ngau luma, iciu eh nnui ngngi eh lungh daidi kera; dede nnui pe name teidi kera Rabe ngaulu, ciziemne anui, “Apei Tinggwang, Peibo!” de qula. <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />Rabe pekatei de anui rabe de ngngwa eh anui Tinggwang name delie kecu zierang teila. <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />Nah anui pe name liecai, anui pe ma pwaleu kerame, Tinggwang mapwame deda. Anui au Khrista de ngngwa mapwa kencütme, anui de pecu ngngwa keherei kesang liecai pecu ngngwa ndulu kerane.<verse eid="ROM 8:17" /></para>
  <para style="s">Paucai kendu</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />Kedanemene Ih cetkecu cudau ting reikecu dungde au anuide kendu keuliagai kerade de keu keda gailak. <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />Kedanemene damkeludung Tinggwang name de keuliagai kerade nlwa eh regui eh kwabam dida. <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />Kedanemene damkelu dungde peu kemta kangga la dida, pekatei pesui gade ma, dede keregui ge kebam gade cide tei kegaibe ziemne, <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />cide damkelude de rimdi kera baang teikela gade teumpetlu delwe Tinggwang name suirang ketei kendu gage teugwang luzie. <verse eid="ROM 8:21" /><verse number="22" style="v" sid="ROM 8:22" />Kedanemene cu kecangde damkelu pelane ket tei eh teei eh mra kebam anui cibam. <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />Cide rünne ma, dede anuikatei de, Rabe tsi raitube kebamme, anui anuikatei liede anui lung gade mrabam, anuide pe name teilu kera kwa eh, anui pumbe de rilu kerane. <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />Kedanemene keregui aide gade anuide kelilu da. Cu kengau kereguide au keregui ma. Kedanemene cau ngau kebam de regui eh bam lano? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />Dede anui ngaula kemak de regui eh bamcai, anui helungtie eh cide de kwa bamla.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />Dede cide kesiakge, Kemci Rabe de anui kemnei ga anuide ngha la. Kedanemene anui dainzwa kielu maisiabi kecu anui cila kemakne, dede Kemci Rabe pekatei anui ziemne kie bamla rangcang gai kelak kemra kwa gade. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />Dede mina mlung de peei kelabe Kemci Rabe lungningbe de cila, kedanemene pa kemcime ding tei eh Tinggwang lungning nzwa kiebam kelane.<verse eid="ROM 8:27" /></para>
  <para style="s">Reugwadidung swa ngkiengki</para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />Kedanemene Tinggwang de hung kelame ziemne au, Tinggwang pe mariem ziemne qu kelume ziemne, pa maleune de keyi ziemne teikela anui cibam.<note caller="+" style="f"><char style="fr" closed="false">8:28 </char><char style="ft" closed="false">Ma kesa ga </char><char style="fqa">Tinggwang de ku kelame de ngngwa ma pelane gade ma keyibe tei lala, </char> kesa kehegwa laisiukwak ga, <char style="fqa">ma pelane keyime ziemne tei petau lala</char>. </note> <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />Kedanemene pa mrai cikelame de, Tinggwang peu pe na nzwalu zielie eh mrai kedet teula dida, iciu eh peu pecu sinamedung kekiee kakgade neraibe teilu kerane. <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />Nah pa mrai kedet kelume dungde, cidungde de pa qu luda. Nah pa qu kelume dungde, penuide pa tei masang luda. Nah pa tei masang kelume dungde, pa penuide tei ndu beu dida.<verse eid="ROM 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />Iciucai ma aidungde ziemne anui dai ranglai? Tinggwang anui kilam lacai, caune anuide renia lulai?<note caller="-" style="x"><char style="xo" closed="false">8:31 </char><char style="xt" closed="false"><ref loc="PSA 118:6">Lei. 118:6</ref></char></note> <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />Pa pekatei pe na de de kaizeudi kemakbe de de anui pelane ding gade pecu kai kebeube, dainzwa eh pa ma pelane pecu desi eh anuide mta peu mene talai?<note caller="+" style="f"><char style="fr" closed="false">8:32 </char><char style="ft" closed="false">Ken. 22:16 ga, Abraham pe na de ratak teikegai ha de nzwa.</char></note> <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />Caune Tinggwang gu kedet kelume de mmau lulai? Tinggwang ne mide tei masang beu kelabe. <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />Mmau kelabe de cauno? Khrista Jisu au tsai kedibe, dede cipau reude, ringcuhdai kelube, Tinggwang ba zetle kebambe, nah anui ziemne kie kebambe. <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />Caune Khrista keku gade anuide teuntsam lulai? Keherei, mede hepüt kerüt, mede sah kegai, mede kemzeu, mede paini kegah, mede kengngi, mede kiengtie ne zieni? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />Kesanglaisiu ga rauteukela nzwa,</para>
  <para style="q" vid="ROM 8:36">“Nnui kemmi ziemne anuide petingnai teitset bam dida.</para>
  <para style="q" vid="ROM 8:36">Anuide au cetpwa meurünna daptset keradung gede nzwabam dida.”<note caller="-" style="x"><char style="xo" closed="false">8:36 </char><char style="xt" closed="false"><ref loc="PSA 44:22">Lei. 44:22</ref></char></note><verse eid="ROM 8:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37" />Dede ma aidung pelane ga anui au anuide kukelabe gade ngkiengkelu reu ngkieng kelume ge dida. <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />Kedanemene Ih cisiakte luda ketsai liede, mede kering, mede tinggimgwame, mede kengkiengdung, mede cu kebamdung, mede gwangdai kerabedung, mede kengkiengme, <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />mede kecehu, mede kecok, mede damkelu keheibe de, anui Rampaube Khrista Jisu gade Tinggwang keku de gade anuide teuntsam gailak.<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s">Tinggwang Israel de kedetkelu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />Khrista gade Ih kesangbe rangla. Ih mret lama, nah a lungning Kemci Rabe gade zierang teibam, <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />a ziemne a mlung ga suisiet kedi ge nah keteei penli kegah de bam. <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />Kedanemene Ih pumteih ria gade a leuhmedung, a sinamedung ziemne, acu peu reset pung nah Khrista dade teuntsam dineu kebamne.<note caller="-" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="EXO 32:32">Tet. 32:32</ref></char></note> <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />Penui au Israelme na. Penui au Tinggwang name tei luda, nah kendu, nah samkakdung, nah hezaibe mtamapeu, nah Tinggwang de kereca, nah sampet keludung la.<note caller="-" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="PSA 147:19">Lei. 147:19</ref></char></note> <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />Penuida kemlang paume dungde, penui dade Khrista de pumteih zai gade lunghgwang, pa maleune reu Tinggwang. Peu pecu kelungta hetwa pung kelube tei lulo. Amen.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />Dede cide au Tinggwang sampet kebeude teilu tadi lie kecube ma. Kedanemene Israel dade lungh kegwangme pelane au Israelme kesangme melu.<note caller="+" style="f"><char style="fr" closed="false">9:6 </char><char style="fq" closed="false">Israelme kesangme melu: </char><char style="ft" closed="false">Tinggwang ne kedet kelume melu </char></note> <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />Mede Abraham leuhme pelane pe name kesang ma. Dede, “Isaac dade n leuhme de qu luzie.”<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="GEN 2:12">Ken. 2:12</ref>, <ref loc="HEB 11:18">Heb. 11:18</ref></char></note> <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />Cide cai, pumteihbe namedung au Tinggwang namedung ma. Dede sampetkelu name dungde pwa pe leuhme lie dida. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />Kedanemene aide au sampetkelu sam: “Aipau tingdau Ih gwangzie, nah mipeina ge Sarah de peuzie.”<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="GEN 18:10-14">Ken. 18:10-14</ref>;<ref loc="GEN 21:2">21:2</ref></char></note> <verse eid="ROM 9:9" /><verse number="10" style="v" sid="ROM 9:10" />Aide rünne ma, dede cipaucai Rebekah liede, anui pau Isaac dade tetlak lu, <note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="GEN 25:21">Ken. 25:21</ref></char></note> <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />dede hename de mnalu kemakne nah magede keyi mede kesia ge de tei kemakne de, Tinggwang mariem pe suibe gade teilu kerane, <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />batadung ziemne ma, dede pecu qu kegaibe ziemne, pe dage ranggai, “Hecingbe henabe gwatei zie.”<note caller="-" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="GEN 25:23">Ken. 25:23</ref></char></note> <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />Cide au rauteu kelanzwa da: “Jacob de Ih ku, dede Esau de Ih ngkau.”<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="MAL 1:2-3">Mal. 1:2-3</ref></char></note><verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />Iciucai anui dai ranglai? Tinggwang da masangkemak bamni? Peu madaude cinzwadi helo. <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />Kedanemene pa Moses dage ranggai, “Ih ngaunggia kerame dage Ih ngaunggia zie, nah Ih ku kerame dage Ih keku teugai zie.”<note caller="-" style="x"><char style="xo" closed="false">9:15 </char><char style="xt" closed="false"><ref loc="EXO 33:19">Tet. 33:19</ref></char></note> <verse eid="ROM 9:15" /><verse number="16" style="v" sid="ROM 9:16" />Cine, cide mina lungning ziemne ma, mede mina teikela ziemne ma, dede Tinggwang ngaugia keulia kegai gade. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />Kedanemene kesanglaisiu ga Tinggwang Pharaoh dage ranggai,<note caller="+" style="f"><char style="fr" closed="false">9:17 </char><char style="fq" closed="false">Pharaoh dage ranggai: </char><char style="ft" closed="false">Egypt gwangpei Pharaoh pezai siasüt kecume ge de Rampaube kengkieng kangga kebam keuliagai.</char></note> “Aipau kiede ziemne Ih ncu teu ncuhlu, iciu eh Ih n dade a kengkieng keulialu kerane, nah iciu eh a zi kideu reu pelane ga rangrwalu kerane.”<note caller="-" style="x"><char style="xo" closed="false">9:17 </char><char style="xt" closed="false"><ref loc="EXO 9:16">Tet. 9:16</ref></char></note> <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />Cine, Tinggwang pa ngaunggia keneume de ngaunggia la, dede pa helung teitak keneume lung teitak dila.<verse eid="ROM 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />Cidau nang a dage rangzie, “Daitei eh pa mi mau peei zeu reuno? Kedanemene caube ne daidau pe lungning renialu dino?” <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />Ciciu meliene, minabo, Tinggwang sam keli kera nang cauno? Tei kelube tei kegaibe dage, “Daitei eh nang acu ainzwa teigai no?” de eh rang zieni. <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />Li keteibe lidei ket gade li ge kemlang ta ziemne teukera, nah li kedabe tingnai ramsang teukera ziemne teikera lidei reu pe nzeu bam meni?<note caller="-" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="ISA 64:8">Isa. 64:8</ref></char></note> <verse eid="ROM 9:21" /><verse number="22" style="v" sid="ROM 9:22" />Dede magade Tinggwang, pe lunghop liagai neu nah pe kengkieng peu ci neula eh, dede lunghop lidung ngkap kera tei keludung dade pelung tiesüt eh liagai cai?<note caller="-" style="x"><char style="xo" closed="false">9:22 </char><char style="xt" closed="false"><ref loc="PRO 16:4">Mac. 16:4</ref></char></note> <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />Pa aide tei kegaide pa pe kendu kedide ngaugia lidung, pe kendu ziemne mrai tei kegaidung dage peu cilu kerane liecai? <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />Nah pa aide anui ziemne teigai liecai, pa qusi kelume, Jewme kakgade rünne ma, dede Gentileme kakgade de?<note caller="-" style="x"><char style="xo" closed="false">9:24 </char><char style="xt" closed="false"><ref loc="ROM 3:29">Rom. 3:29</ref>, <ref loc="EPH 3:6">Eph. 3:6</ref></char></note> <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />Tinggwang Hosea cairasam ga de rangkegai nzwa:</para>
  <para style="q" vid="ROM 9:25">“Ih a mina kemakme dungde a mina lie quzie,</para>
  <para style="q" vid="ROM 9:25">nah pecu, a kube kemakbe de a kube lie zie.<note caller="-" style="x"><char style="xo" closed="false">9:25 </char><char style="xt" closed="false"><ref loc="HOS 2:23">Hos. 2:23</ref></char></note><verse eid="ROM 9:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ROM 9:26" />Nah, ‘Nnui a mina ma,’ de eh penuide rangkegai heni dega,</para>
  <para style="q" vid="ROM 9:26">cika penuide Ringkela Tinggwang name lie quzie.”<note caller="-" style="x"><char style="xo" closed="false">9:26 </char><char style="xt" closed="false"><ref loc="HOS 1:10">Hos. 1:10</ref></char></note><verse eid="ROM 9:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ROM 9:27" />Dede caihakecibe Isaiah Israel ziemne helungnei eh sahgai,</para>
  <para style="q" vid="ROM 9:27">“Israel namedung jaaidi ga heciang nzwa kiee liede,</para>
  <para style="q" vid="ROM 9:27">kelilu kera au ketsam nage zie,<note caller="-" style="x"><char style="xo" closed="false">9:27 </char><char style="xt" closed="false"><ref loc="EZK 6:8">Eze. 6:8</ref></char></note><verse eid="ROM 9:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ROM 9:28" />kedanemene Rampaube kideu ga pe sambe teigai zie,</para>
  <para style="q" vid="ROM 9:28">tei cangsiak zie nah ri dilak.” <note caller="-" style="x"><char style="xo" closed="false">9:28 </char><char style="xt" closed="false"><ref loc="ISA 10:22-23">Isa. 10:22-23</ref></char></note><verse eid="ROM 9:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="ROM 9:29" />Isaiah mrairang kegai nzwa eh,</para>
  <para style="q" vid="ROM 9:29">“Reugwame reu Rampaube anuide anui leuhme bangnzeu beu melie cai,</para>
  <para style="q" vid="ROM 9:29">anui au Sodom nzwa dizie,</para>
  <para style="q" vid="ROM 9:29">nah anui Gomorrah nzwa dizie dege.”<note caller="+" style="f"><char style="fr" closed="false">9:29 </char><char style="ft" closed="false">Sodom nah Gomorrah au RAMPAUBE ne mina pe samzai teita kedine ngkapkedi namdi. Ken. 18:20;19:24-25</char></note><verse eid="ROM 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />Iciucai anui dai ranglai? Gentileme makesangbe peei kemakme, makesangbe ngaulu, nah cide kenlum gade masang kelu. <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />Dede Israelme, hezai makesangbe mzuikela medung, hezai gade cide ngau luma. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />Daitie no? Kedanemene cide penui kenlum gade peei kemakne, dede batadung gade. Penui pi kensui tsu reuga nsui eh kau dida, <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />Kesanglaisiu ga raupwa kelanzwa,</para>
  <para style="q" vid="ROM 9:33">“Ainie, Ih au Zion gage kensui tsu ge nah kengkau tsura ge kai gaila.</para>
  <para style="q" vid="ROM 9:33">Cide de nlum kelubede peu ngngam dilak.”<note caller="-" style="x"><char style="xo" closed="false">9:33 </char><char style="xt" closed="false"><ref loc="ISA 28:16">Isa. 28:16</ref></char></note><verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />Sinamedung, a lungga keregui nah Tinggwang dade Ih penui ziemne kie kebamde au, penuide kelilu kerade delie. <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />Ih penui zierang tei gaila penui Tinggwang ziemne nribam liede, dede maci ria gade ma. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />Kedanemene penui Tinggwang masang de ci kemakne, nah penui katei penui masang tei kera peei kelane. Penui Tinggwang masang gage penuide mpütgai luma. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />Kedanemene Khrista au makesang de ziemne nlum kelume leune ziemne hezaibe teicang kebeube da. <verse eid="ROM 10:4" /><verse number="5" style="v" sid="ROM 10:5" />Kedanemene Moses makesangbe ha hezaibe gade kegwangde raugai: “Mige aidungde teimzai kelabe cide gade ring luzie.”<note caller="-" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="LEV 18:5">Lev. 18:5</ref></char></note> <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />Dede makesangbe kenlum gade kegwangbe aiciu rangla, “N mlung gade ainzwa rangso, ‘Caune tinggim ga nghang lai?’ (cide, Khrista de kideu ga ngngwa nghung kera); <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />nah ainzwa rangso, ‘Caune penli kegah kecok ga nghung lai?’” (cide cai, Khrista de ketsai gade teu cuhlu kera). <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />Cide dai rangla no?</para>
  <para style="q" vid="ROM 10:8">“Sambe n taiga bam, n mui ga nah n mlung ga.”<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="DEU 30:11-14">Hez. 30:11-14</ref></char></note></para>
  <para style="p" vid="ROM 10:8">Cide au kenlum sam, anui pau kelade. <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />Kedanemene magade nang n mui gade Jisu Rampaube lie rang lucai, nah n mlung gade Tinggwang ne pecu ketsai gade teucuh kebeude nlum lucai, ncu kelilu zie.<note caller="-" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="ACT 16:31">Bat. 16:31</ref></char></note> <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />Kedanemene mige pe mlung gade nlum kelube de tei masang lula, nah mige pemui gade ranglu eh kelilu la. <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />Kedanemene kesanglaisiu rangla, “Pecu nlumkelu leune de hengam tei dilak.”<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="ISA 28:16">Isa. 28:16</ref>, <ref loc="JER 17:7">Jer. 17:7</ref></char></note> <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />Kedanemene Jewme nah Greekme kakga kentsam magede gah. Rampaube pelane Rampaube kecune, nah pecu qukela leune de pa samlam kekiee peula. <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />Kedanemene mina keheibede Rampaube zi qu kelabe de kelilu zie.<note caller="-" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="JOL 2:32">Joe. 2:32</ref>, <ref loc="ACT 2:21">Bat. 2:21</ref></char></note> <verse eid="ROM 10:13" /><verse number="14" style="v" sid="ROM 10:14" />Cine dainzwa eh penui nlum kemakbe de penui qu lulai? Nah dainzwa eh penui siu kemakbe de penui nlum lulai? Nah dainzwa eh rang keliame gahcai penui siu lulai? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />Nah dainzwa eh, penuide langgai meliecai penui ledeu lai?, Kesanglaisiu ga rauteukela nzwa, “Samliakeyi paulia kelame pi au daikenzwa gede hezuyi no!”<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">Isa. 52:7</ref>, <ref loc="NAM 1:15">Nah. 1:15</ref></char></note><verse eid="ROM 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 10:16" />Dede Israelme pelane samliakeyi de mzai luma. Kedanemene Isaiah rangla, “Rampaubo, cau anui samde nlumlu dino?”<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="ISA 53:1">Isa. 53:1</ref></char></note> <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />Cine kenlum au siukelu gade gwangla, nah Khrista sam siu kelude gade. <verse eid="ROM 10:17" /><verse number="18" style="v" sid="ROM 10:18" />Dede Ih rang gaila, “Penui siu meni?” Yeo, siulu kesang da. Kesanglaisiu rang kelanzwa,</para>
  <para style="q" vid="ROM 10:18">“Penui kwa kideu pelane ga mpetla dida,</para>
  <para style="q" vid="ROM 10:18">nah penui samdung au kideu penli ga la dida.”<note caller="-" style="x"><char style="xo" closed="false">10:18 </char><char style="xt" closed="false"><ref loc="PSA 19:4">Lei. 19:4</ref></char></note><verse eid="ROM 10:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />Cipau reude, Ih rangla, “Israelme cilu meni?.” Moses mrai ranggai,</para>
  <para style="q" vid="ROM 10:19">“Ih heleuh kemakge de teipwa nnuide peu nnui riak dizie.</para>
  <para style="q" vid="ROM 10:19">Heleuh kemie leuh ge de teu eh, Ih nnui rata teigai zie.”<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="DEU 32:21">Hez. 32:21</ref></char></note><verse eid="ROM 10:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />Nah Isaiah pa kuusüt eh ranggai, Tinggwang ranggai,</para>
  <para style="q" vid="ROM 10:20">“Acu peeila kemakme ne acu ngaulu.</para>
  <para style="q" vid="ROM 10:20">Acu keteu kemakme dage Ih acu liagai.”<verse eid="ROM 10:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21" />Dede pa Israelme dage ranggai, “Tingbazie pelane samzai tei kemak nah pelung ketak leuh ge dage Ih a ba hwagai.”<note caller="-" style="x"><char style="xo" closed="false">10:21 </char><char style="xt" closed="false"><ref loc="ISA 65:1-2">Isa. 65:1-2</ref></char></note><verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s">Israelme bangkelube</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />Ciciu cai Ih rangla, Tinggwang pe mina dungde<note caller="+" style="f"><char style="fr" closed="false">11:1 </char><char style="fq" closed="false">Pe mina dungde: </char><char style="ft" closed="false">Israelmedung </char></note> pütdi deni? Peu madaude cinzwadi helo. Kedanemene Ih liede Israelme ge, Abraham leuhme ge, Benjamin leuh gade. <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />Tinggwang pe mina, pa mrai ci kebamme de püt dima. Mede kesanglaisiu ga Elijah ha dainzwa rang labi nnui ci meni, Israelme de mmau eh pa dainzwa Tinggwang dade pe nggia kiebi?<note caller="-" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="PSA 94:14">Lei. 94:14</ref></char></note> <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />“Rampaubo, penui ngu caihakecime dungde teitset dida, penui n recabamdung teimsia dida. Ih rünne bangnzeu, nah penui au acu zuila dida.”<note caller="-" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="1KI 19:10">1 Heg. 19:10</ref>,<ref loc="1KI 19:14">14</ref></char></note> <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />Dede Tinggwang samli de pecu dai rang lano? “Ih Baal da koktungmie kemakme mina cang hena ge a ziemne kainzeu pwabam.”<note caller="-" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="1KI 19:18">1 Heg. 19:18</ref></char></note> <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />Cinzwa eh, cudau de bang kelume kecam nage bam Tinggwang ngaugia ne kedetkelu ziemne. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />Dede cide ngaugia gade liecai, cide au batadung gade meda. Iciu meliecai Tinggwang ngaugia de au ngaugia tadi zie. <verse eid="ROM 11:6" /><verse number="7" style="v" sid="ROM 11:7" />Ciucai dainzwa eh no? Israelme peei kelade, cide ngau luma, dede kedetkelume cide ngaulu, nah kedame lung tei takdi. <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />Cide au kesanglaisiu ga raupwa kelanzwa: “Tinggwang penuide maci kepa rabe peu dida, penui miak ma ngau melu kerane, nah penui kwen ma siu melu kerane, henai kecangde.”<note caller="+" style="f"><char style="fr" closed="false">11:8 </char><char style="fq" closed="false">Henai kecangde: </char><char style="ft" closed="false">samtie aide pekie au Isaiah tingdau gade Jewme zaireli mneibam kelade Paul ting daude mneibam la kecu.</char></note><note caller="-" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="DEU 29:4">Hez. 29:4</ref>, <ref loc="ISA 6:9-10">Isa. 6:9-10</ref>;<ref loc="ISA 29:10">29:10</ref>, <ref loc="EZK 12:2">Eze. 12:2</ref></char></note> <verse eid="ROM 11:8" /><verse number="9" style="v" sid="ROM 11:9" />Nah David rangla,</para>
  <para style="q" vid="ROM 11:9">“Penui taktyeibam depeu hetak ge nah hebai ge nzwalu,</para>
  <para style="q" vid="ROM 11:9">nah puikam ge nah penui ziemne kemau ziehi ge lu.<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PSA 69:22-23">Lei. 69:22-23</ref>;<ref loc="PSA 35:8">35:8</ref></char></note><verse eid="ROM 11:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ROM 11:10" />Peu penui miak de mui dilu ciu eh penui mangau tadi kerane,</para>
  <para style="q" vid="ROM 11:10">nah penui kiadung bwak jüja dilu.”<note caller="-" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="PSA 69:23">Lei. 69:23</ref></char></note><verse eid="ROM 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />Ih cine ranggai, “Penui kaumie kerane penui<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="fq" closed="false">Penui: </char><char style="ft" closed="false">Jewme.</char></note> pi nsui ni?” Peu madaude cinzwadi helo. Meliene, penui gikah kegai gade, Gentileme da kelikelu gwanglu, penuide heriak kesia gage kai gailu kerane.<note caller="-" style="x"><char style="xo" closed="false">11:11 </char><char style="xt" closed="false"><ref loc="DEU 32:21">Hez. 32:21</ref></char></note> <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />Cu penui gikah kegaide kideube ziemne mahei ge liecai, nah penui kap kedide Gentileme ziemne mahei liecai, penui ncütciak lucai daikieege hemaa kieegwalu zieno? <verse eid="ROM 11:12" /><verse number="13" style="v" sid="ROM 11:13" />Dede cu Ih nnui Gentilemedung dage rangla, nah Ih Gentileme da langkegai ta teikela tane, Ih a ta ziemne hegie la. <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />Iciu eh Ih akatei a leuhme de heriak ketei gage teugai luzie ha nah Ih penui kangge de kelilu zie ha. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />Kedanemene penuide gi kedi pekie kideube de kezuyi dailu liecai, penuide luu kelude au dai zieno, cide au tsai kedime ziemne kering da? <verse eid="ROM 11:15" /><verse number="16" style="v" sid="ROM 11:16" />Dede petsi raitube reca tei kegaide mci liecai, tokkui henet kelube liede mci. Nah pe mah de mci liecai, pe kiakdung liede mci. <verse eid="ROM 11:16" /><verse number="17" style="v" sid="ROM 11:17" />Dede magade pe kiakdung kesa de riaudicai, nah magade nang, Olive kiak ge, penui kakgage kaincüt dicai, nah magade nang penuide Olive bang pe mah keyide gage mzi gaicai, <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />pe kiak dungde ziemne hegie diso. Dede nang hegie lacai, nang pe mah de ngha kelabe ma, dede pe mah dene ncu ngha la. <verse eid="ROM 11:18" /><verse number="19" style="v" sid="ROM 11:19" />Iciude nang rangzie, “Pe kiak dungde riaugi dida ciu eh acu cika kai ncütlu kerane.” <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />Cide au kesang. Penui nlum kemak ziemne penuide riaugi dida, dede n kenlum ziemne nang sap ntiplu. Nkatei de mning cehu ham diso, dede hinglu. <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />Kedanemene magade Tinggwang bangsang kiakdungde de mbai beu mecai, ncu de pa mbai beulak. <verse eid="ROM 11:21" /><verse number="22" style="v" sid="ROM 11:22" />Cine, piegai lo, Tinggwang keku tadung nah teikeherei kelade: kau kedime da keherei de gwangla, dede Tinggwang keku de nda gwangla, nang pe keku ga bam lucai. Iciu meliecai ncude de riaugi dizie. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />Nah penui liede, magade penui nlumkemak ga bam sita dicai, penuide teukau ncütdi luzie. Kedanemene Tinggwang au penuide teugwang kauncüt dailu builu. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />Kedanemene magade ncu renaam Olive bang bangsang gade riaudi eh bangsang kemak taktyei kela Olive bang keyi gage kauncüt gaicai, aidungde daihia gede kieesi luzie no, bangsang dungde, penuikatei penui olive bang gage kauncüt dailu de?<verse eid="ROM 11:24" /></para>
  <para style="s">Israel pelane de kelilu zie</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />Kedanemene Ih nnuide aipau macetkecok dungde cimene peu bamneu ma, sinamedung, iciu eh nnuikatei nnui kecet gade nnui makecime teidi melu kerane. Macetkecok aide cai Israelme da helung ketak ge bam dida, Gentileme pelane gwanglu kemaktane. <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />Cine kesanglaisiu ga rauteu kelanzwa eh, Israel pelane de kelilu zie:</para>
  <para style="q" vid="ROM 11:26">“Zion gade Kelikelube gwang zie.</para>
  <para style="q" vid="ROM 11:26">Pa Jacob dade rabe lam la kemakde keugi dizie,<note caller="-" style="x"><char style="xo" closed="false">11:26 </char><char style="xt" closed="false"><ref loc="ISA 59:20">Isa. 59:20</ref></char></note><verse eid="ROM 11:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ROM 11:27" />nah aide penuide ngngwa Ih samkak keluge zie,</para>
  <para style="q" vid="ROM 11:27">Ih penui maudung keugi di kecudau.”<note caller="-" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="ISA 43:25-26">Isa. 43:25-26</ref>;<ref loc="ISA 27:9">27:9</ref></char></note><verse eid="ROM 11:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="ROM 11:28" />Samliakeyi de lamde cet kegai au, penui au nnui ziemne ngauraume ge. Dede kedetkelu lamde au, penui au penui paume ziemne pe kumedung. <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />Kedanemene Tinggwang mta mapeudung nah qu kelude au lidai gailak. <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />Kedanemene ndaa nnui<note caller="+" style="f"><char style="fr" closed="false">11:30 </char><char style="fq" closed="false">Nnui: </char><char style="ft" closed="false">Jewme kemakme.</char></note> Tinggwang samzai tei kemak nzwa, dede cu penui samzai teikemak ziemne ngaugia ngau luda, <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />nah cinzwa eh, cu Jewme aidungde samzai teilu tadi. Cide nnui dage ngaugia keu kelia gade penuide de cu peu ngaugia ngaulu kerane. <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />Kedanemene Tinggwang pelane samzai tei kemak gage baangdi, ciu eh pa pelane dage ngaugia laigailu kerane.<verse eid="ROM 11:32" /></para>
  <para style="s">Ketwalei</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />Oh, Tinggwang macet nah maci mahei kecok de! Pe tutiak au peicang gailak, nah pe lampui de cicang gailak!<verse eid="ROM 11:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="ROM 11:34" />“Kedanemene cau Rampaube lungning cino</para>
  <para style="q" vid="ROM 11:34">mede cau pecu rangkeliabe tei lulai?<verse eid="ROM 11:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="ROM 11:35" />Mede cau Tinggwang de ma peu ham eh,</para>
  <para style="q" vid="ROM 11:35">Tinggwang pecu peucaili dai maisia dino?”<note caller="-" style="x"><char style="xo" closed="false">11:35 </char><char style="xt" closed="false"><ref loc="JOB 41:11">Job 41:11</ref></char></note><verse eid="ROM 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ROM 11:36" />Kedanemene pe dade nah pe ziemne nah peda maleune bam. Pecu peu kelungta ndu kelube tei lulo. Amen.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s">Kering ratakdung</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />Ih nnui dage rangsünne gaila, sinamedung, Tinggwang ngaugia gade, nnui pumdung pwa kering ratak, mci, nah Tinggwang luulu kebui ge tei lulo. Aide nnui tei siaktelu kebui ta ge. <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />Kideu aide zaidung mzui diso, dede nnui lung tei hecilu eh nnui zaireli teintsam lu. Aide tei kegai gade nnui daibe yibi, nah luulu kebuibe bi, nah Tinggwang lungning yicang kecu cilu zie.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />Kedanemene Ih rang gaila, Tinggwang ngaugia acu kepeude ziemne, keheibede nnui kakga kebamme penui mning kerabe nreu swade penui katei penuide mning mdi kerabe ma. Meliene, penui mteu eh cet siaktelu maisia, Tinggwang hangge ge dage kenlum kaikebeu kieege nzwa eh. <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />Kedanemene anui mipum ga pe mzi kekieege kebam nzwa, dede pe mzi kebam pelane peta nzwa ma, <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />cide nzwa eh, anui kekieege bam liede Khrista gade au pum ge, nah hangge ge kecu kedabe zi ge teikap. <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />Dede anui ngaugia gade anuide kepeu mapeudung ketsamtsam bam: Magade Tinggwang ne, pe kenlum kebam nsam gade peucai; <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />mata ketei gade, bata gade; keledeu liecai, pe keledeu gade; <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />kehecung gade cai, mide kehecung gade; kepeu gade cai, mbang eh peulu; teuswa kecu gade cai, sünne kecu gade; ngaugia liakela gade cai, suiyi liakela gade.<verse eid="ROM 12:8" /></para>
  <para style="s">Keku</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />Keku depeu hezai gade diso. Kesiabe de ngkaulu; keyibe kerakteu bamlu.<note caller="-" style="x"><char style="xo" closed="false">12:9 </char><char style="xt" closed="false"><ref loc="AMO 5:15">Amo. 5:15</ref></char></note> <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />Hangge gede caireiswacing keku teu kulu. Herüt kepeu ga, hangge gede herüt peulu. <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />Helungnei eh hegwa ketei ga, nghet diso. Rabe ziemne, nri bamlu. Rampaube ziemne, pe gwa teilu. <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />Kereguide ga nnui sui yilu, keherei kecu gade helung tielu, kekie gade samsanglu. <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />Kemcime teu maikesia gage hema mzi gailu. Mide hegia kera lampui kekiee peilu. <verse eid="ROM 12:13" /><verse number="14" style="v" sid="ROM 12:14" />Nnuide teikeherei kelame de samlam beulu; samlam beulu nah reset so. <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />Pesui yi kelame de ngngwa suiyi nsamlu; hap kelame de ngngwa haplu.<note caller="-" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="PSA 35:13">Lei. 35:13</ref></char></note> <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />Hangge gede ngngwa suige teilu. Ngang eh cetso, dede kehenahme kekangngwa luulu. Nkatei ncu mning mdi diso.<note caller="-" style="x"><char style="xo" closed="false">12:16 </char><char style="xt" closed="false"><ref loc="PRO 3:7">Mac. 3:7</ref>, <ref loc="ISA 5:21">Isa. 5:21</ref></char></note> <verse eid="ROM 12:16" /><verse number="17" style="v" sid="ROM 12:17" />Kesia teikegai ziemne mide kesiabe peu daiso. Mina pelane dwagade ma keyi teilu. <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />Magade tei lubui cai, n lambiede teilukebui tane, mina pelane de kezuyi eh lungh lu. <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />Akumedung, madaude hekum peei diso, cide Tinggwang masang lunghop dage nlum beudi. Kedanemene Kesanglaisiu ga ainzwa rauteu kelane, “‘Hekum kepeei au a gu; Ih ne penuide peu daizie,’ de Rampaube rangla.”<note caller="-" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="DEU 32:35">Hez. 32:35</ref></char></note><verse eid="ROM 12:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ROM 12:20" />Kesanglaisiu rang kelanzwa “Dede magade n ngauraube nzeu lacai, pepok teibeu lu.</para>
  <para style="q" vid="ROM 12:20">Magade pa hereu lacai; pecu sak kera peu lu.</para>
  <para style="q" vid="ROM 12:20">Kedanemene nang aide teikegai ga, nang pe peu gage kehengam miceu pwagai dida.”<note caller="-" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="PRO 25:21-22">Mac. 25:21-22</ref></char></note><verse eid="ROM 12:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 12:21" />Kesiabe depeu ncu ngam diso, dede keyibe teu kesiabe de ngamlu.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s">Kengkieng keteume sam kemzai</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />Peu keringria keheibede kengkieng keteume samzai tei lulo, kedanemene Tinggwang dade gwang mai kengkieng kedage de gah. Kengkieng teu kebamme de Tinggwang ne kedet pwapeu da.<note caller="-" style="x"><char style="xo" closed="false">13:1 </char><char style="xt" closed="false"><ref loc="TIT 3:1">Tit. 3:1</ref></char></note> <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />Ciziemne kengkieng cipaude de mlai kelabe Tinggwang aja de renia la; nah cide de renia kelame penui katei penuida tutiak teugwang zie. <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />Kedanemene kengkieng teu kelame au heta keyi tei kelame ziemne kehing ge ma, dede heta kesia dungde ziemne. Nang kengkieng teu kelame da kehing bam neu meni? Keyi ta teilu, iciude nang pe suiyi tei luzie. <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />Kedanemene pa au n ziuyi ziemne Tinggwang kilame ge. Dede nang kesia tadung teicai, ngngi lulo; kedanemene pa pekie kegah gade kiengtiebe pwa lama. Kedanemene pa au Tinggwang kilame ge, kesia teikelame dage pe lunghop teigai kelabe. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />Ciziemne nnui mzai bilu, lunghop de rünne ziemne ma, dede lungcet ria gade de. <verse eid="ROM 13:5" /><verse number="6" style="v" sid="ROM 13:6" />Kedanemene aide ziemnede nnui heraha kai beula. Kedanemene penui au Tinggwang kilamedung lu, penui mtakdi mene heta aide tei kelame. <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />Mileune de daige peu kera bambi peu dilu. Heraha peu maikesiame de heraha peu dilu, mabam maha peu maikesiame de maha peu dilu; hing maikesiame de hinglu, herüt peu maikesiame de herüt peulu.<verse eid="ROM 13:7" /></para>
  <para style="s">Kereku lu, tingba de nna bamdi delu</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />Mipau magede pung so, ketket de kereku kecu pau de gwale. Kedanemene pe kidabe de hung kelabe de hezaibe teicang luda. <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />Hezai kai kebeudung rangla: “Kemmha ta teiso, mide teitset so, rega so, migu hengin so,” nah hezai kedadung gede bamsi cai, cide hezai aide gage kaincüt pwabam: “Nkatei ncu keku nzwa n kida caina de kulu.”<note caller="-" style="x"><char style="xo" closed="false">13:9 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">Tet. 20:13-16</ref>, <ref loc="LEV 19:18">Lev. 19:18</ref>, <ref loc="DEU 5:17-19">Hez. 5:17-19</ref>,<ref loc="DEU 5:21">21</ref></char></note> <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />Keku au pe kida caina dage petau kemak teigai lama; cine, keku au hezai teicang kebeube da.<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />Aide teilu kedanemene anui peting cibam lu, anui zip kebam gade mraklu kerabe tingsiak dida. Kedanemene anui nlumkelu kerai tingdau swade anuide kelilu kera ting cu au nnaki bam dida. <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />Tingmui tingcang zeuda, nah ting kebaa nna zeuda. Ciziemne anui kemui tadung püt digo, delwe anui kebaa reunet kai lugo. <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />Anui kebaa ga kelanzwa tet sünne lugo, sak kenlwang ta mede sak kemie ta teidi mene; nah anui mipumteih hengin mede kemmha ta ketei gade mbai lugo, nah kesamlim mede miriak ketei gade. <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />Dede Rampaube Jisu Khrista de pwa ngu teilu, nah pumteihbe hengindung tei kera lampui magede peubeu so.<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s">Kemneime nah kengkiengme</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />Dede kenlum gade nnei kelame keheibe de ngngwalu, kesamlim kecuga rang reniadi mene. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />Mige pe kenlum gade keheibe tyei lubui, dede nnei kebam mi kedage au ginei rünne tyeila. <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />Peu maleune tyei kelabe de tyei la kemakbe de ngkau diso; nah peu ma keheibe tyei la kemakbe de maleune tyei kelabe de mmau diso. Kedanemene Tinggwang pecu ngngwalu delu. <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />Nang cauno, mi kedame ge kila ha tiak kera? Pa sap mede kaukecu pekatei pe mpaube dwa gade tiak zie. Dede pecu peu sap luzie, kedanemene Rampaube pecu teucuh saplu builu. <verse eid="ROM 14:4" /><verse number="5" style="v" sid="ROM 14:5" />Mige tingba ge au tingbazie keda ge swade mlangki lie la. Dede mi kedage au tingba ramsangne nzwakap lie la. Peu mi hangge gede pelung gade ci mci lulo.<note caller="-" style="x"><char style="xo" closed="false">14:5 </char><char style="xt" closed="false"><ref loc="GAL 4:10">Gal. 4:10</ref>, <ref loc="COL 2:16">Col. 2:16</ref></char></note> <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />Tingbazie de mnei kelabe, Rampaube ziemne cide mneila; nah mige tyei kelabe, Rampaube ziemne tyeila, kedanemene pa Tinggwang de hetwa pwapeu kelane. Matyei kemakbe, Rampaube ziemne ketyei ga kezeula, pa de Tinggwang de hetwa pwa peula. <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />Kedanemene anui migede pekatei pe ziemne lungh lama, nah migede pekatei pe ziemne tsai lamah. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />Kedanemene anui ring lacai, anui Rampaube dage lungh gaila, nah anui tsai dicai, anui Rampaube dage tsai gaila. Cine anui ring de mede tsai liede, anui au Rampaube gu. <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />Kedanemene aide ziemne Khrista tsailu nah ringcuh dailu, iciu eh pa tsai kedime nah ring kebamme Rampaube teilu kerane. <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" />Dede nang, daitei eh nang n sinabe tutiak lano? Nah nang, daitei nang n sinabe de mneu lano? Kedanemene anui mileune Tinggwang tutiakbam dwaga sap zielu. <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />Kedanemene Kesanglaisiu ga ainzwa raupwala,</para>
  <para style="q" vid="ROM 14:11">“Ih ring kelanzwa eh,” de eh Rampaube ranggai, “A da mina leune koktung miezie,</para>
  <para style="q" vid="ROM 14:11">nah mina leune Tinggwang de twazie.”<note caller="-" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="ISA 45:23">Isa. 45:23</ref>;<ref loc="ISA 49:18">49:18</ref></char></note><verse eid="ROM 14:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />Cine, anui hangge gede pekatei pe ha Tinggwang dage pwapeu zie.<verse eid="ROM 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />Ciziemne, anui hangge ge ha tiak tadi go, ciu meliene migede pe sinabe ziemne puikam ge mede hetak ge teigai melu kerane tiak lugo. <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />Ih cibam nah Rampaube Jisu gade, magede pekatei au hera dila kemak Ih cimci luda. Mige pekatei cetpwa ma keheibe de mci melie lacai, pe ziemne cide mci meda. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />Kedanemene taktyei ziemne n sinabe suisiet teicai, nang au keku gade tetla meda. N taktyei ziemne Khrista pe ziemne tsai kegaide teingkap diso. <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />Cine nang yilie kelade peu rangpwa kesiabe tei diso. <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />Kedanemene Tinggwang hegwang au ketyei kesak au ma, dede cide au makesangbe, nah lungciep, nah Kemci Rabe gade misui keyi. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />Kedanemene Khrista gwa ainzwa teikelabe de Tinggwang luu lula nah mina de pecu pesui lula. <verse eid="ROM 14:18" /><verse number="19" style="v" sid="ROM 14:19" />Cine, anui kezuyi peu kelabe nah hangge gede teimmi beukela dungde peei lugo. <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />Ketyeipok ziemne Tinggwang ta de teingkap diso. Ma pelane de mci kesang, dede mige pe taktyei ziemne pe lampui kaam lacai pe ziemne cide au kemau. <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />Heteih tyei kemak, mede zausak kemak, mede n sinabe<note caller="+" style="f"><char style="fr" closed="false">14:21 </char><char style="fq" closed="false">Sinabe: </char><char style="ft" closed="false">Kenlum siname</char></note> lampui kaamdi kela keheibe de, mede kemau gage ngngwa gaidi kela, mede mide tei nneidi kelade tyei kemak au yilie. <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />Kenlum nda kebamde, Tinggwang nnai kakga peu ntip bamlu. Mige pa tei kebamde pekatei pecu mmaula kemakbe au samlam pungtu. <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />Dede mige pa lunghau eh tyeicai pecu mmau zie, kedanemene cide au kenlum gade melu. Nah ma keheibede kenlum gade pet kemakpe au kemau.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />Cu anui kenlum gade ngkieng kelame au mneikelame gu kemneidung pungha maisia, nah anuikatei anui suiyibe teikerabe ma. <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />Peu anui hangge ge kecude pe kidabe ziuyi ziemne pe suiyi teilu, pecu teingkieng beulu kerane. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />Kedanemene Khrista liede pekatei pe suibe teima. Meliene, Kesanglaisiu ga rang kelanzwa, “Ncu kiikelame samdung de, O Tinggwang, ada gwang dida.”<note caller="-" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="PSA 69:9">Lei. 69:9</ref></char></note> <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />Kedanemene pedwa Kesanglaisiu ga raupwa kelade au anuide ledeulu kera ziemne raupwala, iciu eh Kesanglaisiu ga helungketie nah teikengkuu gade anui keregui ge bamlu kerane. <verse eid="ROM 15:4" /><verse number="5" style="v" sid="ROM 15:5" />Cu peu helungketie nah teikengkuu Tinggwang depeu Khrista Jisu gade hangge gede ngngwa kelungzwa kecu peu kelube tei lulo. <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />Aide pecu peu teilo iciu eh nnui lung ge nah kwa ge tei eh Tinggwang nah anui Rampaube Jisu Khrista Peibe de twalu kerane.<verse eid="ROM 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />Ciziemne hangge gede ngngwalu, Khrista liede, Tinggwang de ketwa gage nnuide ngngwagai kelunzwa. <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />Kedanemene Ih rangla Tinggwang masang gade Khrista de hegeukerum kanga kila ge teidi, iciu eh ndaa paumedung dage sampet kebeu dungde ci mcilu kerane,<note caller="-" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="MAT 15:24">Mat. 15:24</ref></char></note> <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />nah Gentileme dungde peu Tinggwang ngaugia ziemne pecu twalu kera ziemne. Kesanglaisiu ga raupwa kelanzwa,</para>
  <para style="q" vid="ROM 15:9">“Ciziemne Ih ncu hetwa peuzie Gentilemedung kakgade</para>
  <para style="q" vid="ROM 15:9">nah lei tei eh n zi twazie.”<note caller="-" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="2SA 22:50">2 Sam. 22:50</ref>, <ref loc="PSA 18:49">Lei. 18:49</ref></char></note><verse eid="ROM 15:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10" />Kesanglaisiu ranggai dai,</para>
  <para style="q" vid="ROM 15:10">“Nnui suiyilu, nnui Gentilemedung, pe minadungde ngngwalwe.”<note caller="-" style="x"><char style="xo" closed="false">15:10 </char><char style="xt" closed="false"><ref loc="DEU 32:43">Hez. 32:43</ref></char></note><verse eid="ROM 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 15:11" />Nah rangdai gai,</para>
  <para style="q" vid="ROM 15:11">“Rampaube de twalu, nnui Gentileme pelane;</para>
  <para style="q" vid="ROM 15:11">nah peu mina pelane de pecu twalo.”<note caller="-" style="x"><char style="xo" closed="false">15:11 </char><char style="xt" closed="false"><ref loc="PSA 117:1">Lei. 117:1</ref></char></note><verse eid="ROM 15:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />Ciu eh Isaiah ranggai dai,</para>
  <para style="q" vid="ROM 15:12">“Jesse leuhme lungh gwangzie, Gentileme reu dikera cuh kecube de liede; pe dade Gentilemedung keregui bam luzie.”<note caller="-" style="x"><char style="xo" closed="false">15:12 </char><char style="xt" closed="false"><ref loc="ISA 11:11">Isa. 11:11</ref></char></note><verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />Cu keregui kebam Tinggwang depeu nnui kenlum gade suiyi pelane nah lungciep le teipui kelube tei lulo, iciu eh Kemci Rabe kengkieng gade, keregui nnuida bamreu reulu kerane.<verse eid="ROM 15:13" /></para>
  <para style="s">Paul, Gentileme dage kenepaube</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />Dede Ih akatei de nnui ha de ci hemi bam, a sinamedung, hangge gede de kecung silu kebui nnui nnuikatei keyile kepui tei kebam, maci pelane le puipung kebam. <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />Dede Ih kuusüt eh nnui dage makiedung ge ha laisiu aika rausi gaila nnuide peu nsunglu kerane, kedanemene ngaugia Tinggwang ne acu kepeune. <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />Mtamapeu aide cai Ih Khrista Jisu kila Gentilemedung dage langkegaibe tei kera, cingkume ge nzwa Tinggwang samliakeyi de reca teibeulu kera. Ih aide tei maisia iciu eh Gentilemedung reca de Kemci Rabe gade tei mcilu eh peu luulu kera ge teilu kerane. <verse eid="ROM 15:16" /><verse number="17" style="v" sid="ROM 15:17" />Cine Ih Khrista Jisu gade a bata Tinggwang ziemne teikegai hegielu kebui pekie ge bam. <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />Kedanemene Ih magede kuu eh ranglu kera gah Khrista ne acu teu Gentileme de samzai ketei gage ngngwagai kelude gwale. Ma aidungde teikelu au sam nah heta gade, <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />marehi nah mima kecangh, nah Tinggwang Rabe kengkieng gade. Aide ainzwakelu au, Jerusalem gade nah twagwa kebam Illyricum deudi kecang, Ih Khrista samliakeyi de rangrwa cangsiaklu kerane. <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />Aide nzwa eh, Ih teineu kelade au samliakeyi rangrwa kerade da, dede Khrista zi ci kebam heni ga ma, iciu eh Ih mi kedame ne pe bangdwa dwa kebeu reu gage tei melu kerane. <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />Dede Kesanglaisiu ga raupwa kelanzwa:</para>
  <para style="q" vid="ROM 15:21">“Pe ha ranglia kemakme de pecu ngau zie,</para>
  <para style="q" vid="ROM 15:21">nah siu kemakmedung de cilu zie.”<note caller="-" style="x"><char style="xo" closed="false">15:21 </char><char style="xt" closed="false"><ref loc="ISA 52:15">Isa. 52:15</ref></char></note><verse eid="ROM 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />Ciziemne nnuida gwang kera acu liede pia kekiee ge kaam dida.<verse eid="ROM 15:22" /></para>
  <para style="s">Paul Rome ga rwamie kera mariem</para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 15:23" />Dede cu, Ih cuikui aidungde ga heta tei kera heni bam meda, nah Ih mmi kekiee ge nnuida gwang kera reguila dida. <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />Ih Spain deudi ga mie eh kahkegwangdau Ih nnuide ngau kera regui kesang bam dida, nah cika nnuide peu a beuh ga nghalu kerane, Ih kakge nnuide ngngwa bam eh kehega luda. <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />Dede Ih cu Jerusalem ga kenlummedung da kengha teumie zie. <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />Kedanemene Macedonia nah Achaia deuceu ga kebam kenlumme ne Jerusalem ga kebam kenlumme kakga kegahme ziemne makai ge peu kegaide penui suiyi eh peugai. <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />Aide penui suiyi eh tei kesang, kedanemene penui au penuide peu kerame delu. Kedanemene magade Gentilemedung penui rabe madung mzicai, penui cide kideube madungde peu kera penui nsam delu. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />Ciziemne, Ih aipau ta de teicang keludau nah penui hekwa kelude ngaukelu cimci lude, Ih Spain deudi gage tetgai zie nah nnuide lampui gade redau zie. <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />Dede Ih nnuida kegwangdau, Ih Khrista samlam le kepui tei eh nnuida gwang kera Ih cibam.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />Cu Ih nnui dade kiela, sinamedung, anui Rampaube Jisu Khrista gade nah Kemci Rabe keku gade, a ziemne Tinggwang dade nnui kekiedung gade acu ngngwa kie gailo. <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />Acu Judea deu ga nlumkemakme dade kelilu kerane nah a bata Jerusalem ziemne kemcimedung luulu kebui teilu kerane kielo. <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />Tinggwang lungning nzwa eh acu peu asui yi eh nnuida gwanglu kera nah Ih nnuide ngngwa ncüt eh kemtak ngaulu kerane kielo. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />Cu peu lungciep Tinggwang de nnui pelane da bam kelube tei lulo. Amen.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s">Mina dungde kelumkegai</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />Ih nnui dage anui tipui Phoebe, Cenchrea ga ngqwa ta tei kelabe de nlumgai beula, <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />iciu eh nnui Rampaube gade pecu ngngwalu kerane, kemcime dungde hetwa kepeuzai nzwa, nah pa nnui dade teumai kesia makehei gade pe mapie beulu kera. Kedanemene pa pekatei mina kekiee gede nah acu de ngha kebeupui ge tei kelune.<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />Aquila nah pe nau Priscilla, Khrista Jisu gade acu ngngwa mata tei kelabe kena de kelum gailo, <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />a teilung ziemne penai teilung kerehim gage kaibeu. Ih penaide hetwa peu gaila, nah Ih rünne ma, dede Gentileme ngqwadung pelane desi eh. <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />Penai kiga kebam ngqwa de kelum gailo. Akube Epaenetus de kelum gailo, pa au Asia gade Khrista de ci raitube. <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />Nnui ziuyi ziemne nri eh matei bamkela Mary de kelum gailo. <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />Andronicus nah Junias, a kibaume nah acu ngngwa hebaang keteibe kena de kelum gailo. Penai au langkegaime kakgade kemlangme ge, penai a swade rai eh Khrista da la kedime. <verse eid="ROM 16:7" /><verse number="8" style="v" sid="ROM 16:8" />Ampliatus, Rampaube gade akube de kelum gailo. <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />Urbanus de, Khrista gade anui ngngwa matei kelabe, nah Stachys, akube de Kelum gailo. <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />Khrista gade luu kelube, Apelles de kelum gailo. Aristobulus kilungme dungde kelum gailo. <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />A kibaume, Herodion de kelum gailo. Narcissus kilungga kebamme, Rampaube da kelamedung de kelum gailo. <verse eid="ROM 16:11" /><verse number="12" style="v" sid="ROM 16:12" />Rampaube gade mata teinri kela, Tryphaena penai Tryphosa<note caller="+" style="f"><char style="fr" closed="false">16:12 </char><char style="fq" closed="false">Tryphaena penai Tryphosa: </char><char style="ft" closed="false">kenlumme pui hangna ne cingkume ta tei eh bamla.</char></note> de kelum gailo. Hungkelabe Persis, Rampaube gade heta tei nrisüt kelabe de kelum gailo. <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" />Rampaube gade kedet kelube, Rufus nah, pe pui nah apui de kelum gailo. <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />Asyncritus, Phlegon, Hermes, Patrobas, Hermas nah penuide nzangkela siname dungde kelum gailo. <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />Philologus nah Julia, Nereus nah pe tipui, nah Olympas, nah penuide nzangkela kemcime pelane de kelum gailo. <verse eid="ROM 16:15" /><verse number="16" style="v" sid="ROM 16:16" />Hangge gede kemci hemam teu eh kelum lo. Khrista ngqwadung pelane nnuide kelum gaila.<verse eid="ROM 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />Cu Ih nnui dade kiela, sinamedung, nnui keledeu gade cikelu dungde renia eh teipang nah kebwak kelamedung ha cet gailo. Penui dade nreutet dilu. <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />Kedanemene mina cikenzwame au anui Rampaube Khrista gwatei lama, dede penui katei penuipok ziemne. Penui sam keyi nah kecwa sam le penui kemzeu medung lung cwa dila. <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />Kedanemene nnui samzai ketei mileune ci. Ciziemne, Ih a sui yibam, nnui ziemne, dede Ih nnuide peu keyibe ga mteulu neu, dede kesiabe ga peu nzeu luneu. <verse eid="ROM 16:19" /><verse number="20" style="v" sid="ROM 16:20" />Lungciep Tinggwang<note caller="-" style="x"><char style="xo" closed="false">16:20 </char><char style="xq" closed="false">Lungciep Tinggwang </char><char style="xt" closed="false"><ref loc="ROM 15:33">Rom. 15:33</ref></char></note> Satan de nnui pi kang gage tei kecai zette dizie.</para>
  <para style="p" vid="ROM 16:20">Peu anui Rampaube Jisu Khrista ngaugia de nnuide ngngwala kelube tei lulo.<note caller="-" style="x"><char style="xo" closed="false">16:20 </char><char style="xt" closed="false"><ref loc="GEN 3:15">Ken. 3:15</ref></char></note><verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />Timothy, acu ngngwa mata tei kelabe, nnuide nah Lucius, nah Jason, nah a kibaume, Sosipater de kelum gaila. <verse eid="ROM 16:21" /><verse number="22" style="v" sid="ROM 16:22" />Ih, Tertius, laisiu aide Paul ziemne raukegaibe, Rampaube gade nnuide kelum gaila. <verse eid="ROM 16:22" /><verse number="23" style="v" sid="ROM 16:23" />Gaius, a ziemne nah ngqwabe pelane ziemne hegiabe, nnuide kelum gaila. Erastus, namdi gu mabam keteube, sinabe Quartus desi eh, nnuide kelum gaila. <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />[Peu anui Rampaube Jisu Khrista ngaugia de nnui pelane de ngngwabam kelube tei lulo. Amen.]<verse eid="ROM 16:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="ROM 16:25" />Cu Tinggwang nnuide teingkienglu kebuibe a samliakeyi nah Jisu Khrista keledeu de nzwa,</para>
  <para style="q" vid="ROM 16:25">peting ketieege ziemne kebai pwakela macetkecok<note caller="+" style="f"><char style="fr" closed="false">16:25 </char><char style="fq" closed="false">Macetkecok: </char><char style="ft" closed="false">sam aide pekie ndaa keledeu sam ci mcilu mene la eh mina dade hebai teula kecude.</char></note> keulia kegaide nzwa,<verse eid="ROM 16:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ROM 16:26" />dede cu au kelungta kering Tinggwang aja gade, caihakecime raupwa keladung gade heleuh pelane de, keulia nah peu ci luda, kenlum samzai depeu bamlu kerane.<verse eid="ROM 16:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ROM 16:27" />Ket rünne kebambe maci Tinggwang dage, Jisu Khrista gade, kelungta ndu kelube tei lulo. Amen.<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>