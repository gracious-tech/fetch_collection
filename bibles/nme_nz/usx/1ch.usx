<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Zeme(N) Bible Project</book>
  <para style="ide">UTF-8</para>
  <para style="h">1 Heleuhha</para>
  <para style="toc1">Heleuhha Laisiukwak Keraibe</para>
  <para style="toc2">Heleuhha Keraibe</para>
  <para style="toc3">1 Hel.</para>
  <para style="mt">1 Chronicles</para>
  <para style="mt">Heleuhha Laisiukwak Keraibe</para>
  <para style="is">Mraisam</para>
  <para style="ip">Heleuhha laisiukwak kenade Samuel penai Hegwangme laisiukwak kenade nzwa bamde cide ciciu ma. Heleuhha dungde rau kelude Babylonme baang tei kela gade Israel ga cailigwang kelume ziemne raugai penui au hegwangpei David ria gade lungh kegwangme nah penui au Tinggwang ne kedetkelu minadung lie eh ranggai. Samdi liecai Tinggwang au pe samkak de samsang lamui lie kecude.</para>
  <para style="ip">Makie aidungde ziemne Heleuhha keraide Adam gade hegwangpei Saul tsit kecang rasam de raugai. Laisiukwak ga bang kecubedung au hegwangpei David hegwang ketei hadung. Laisiukwak ai kenade Jewme de mrai rangmriak kegai nah samkak de teu samsang lulo kecung kagai ge.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Ceheudung laisiu (1:1-9:44)</para>
  <para style="io1">David hegwang ketei (10:1-29:30)</para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s">Adam gade Abraham kecang rasam</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 1:1" />Adam, Seth, Enosh, <verse eid="1CH 1:1" /><verse number="2" style="v" sid="1CH 1:2" />Kenan, Mahalalel, Jared, <verse eid="1CH 1:2" /><verse number="3" style="v" sid="1CH 1:3" />Enoch, Methuselah, Lamech. <verse eid="1CH 1:3" /><verse number="4" style="v" sid="1CH 1:4" />Noah napeidung cai Shem, Ham, nah Japheth.<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="LUK 3:36-38">Luk. 3:36-38</ref></char></note> <verse eid="1CH 1:4" /><verse number="5" style="v" sid="1CH 1:5" />Japheth napeidung cai Gomer, Magog, Madai, Javan, Tubal, Meshek, nah Tiras. <verse eid="1CH 1:5" /><verse number="6" style="v" sid="1CH 1:6" />Gomer napeidung cai Ashkenaz, Riphath, nah Togarmah. <verse eid="1CH 1:6" /><verse number="7" style="v" sid="1CH 1:7" />Javan napeidung cai Elishah, Tarshish, Kittimmedung nah Rodanimmedung.<verse eid="1CH 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 1:8" />Ham napeidung cai Cush, Egypt, Put, nah Canaan. <verse eid="1CH 1:8" /><verse number="9" style="v" sid="1CH 1:9" />Cush napeidung cai Seba, Havilah, Sabta, Raamah, nah Sabteka. Raamah napeidung cai Sheba nah Dedan. <verse eid="1CH 1:9" /><verse number="10" style="v" sid="1CH 1:10" />Cush pena Nimrod lunglu, pa au kideu gade reugwame kedi raitube. <verse eid="1CH 1:10" /><verse number="11" style="v" sid="1CH 1:11" />Egypt leuhme cai Ludme, Anamme, Lehabme nah Naphtuhme, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />Pathrusme, Kasluhme (cipaume dade Philistinme lungh gwang), nah Caphtorme. <verse eid="1CH 1:12" /><verse number="13" style="v" sid="1CH 1:13" />Canaan pena Sidon, pe neraibe, nah Heth lunghlu. <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />Pa Jebusme, Amorme, Girgashme, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />Hivitme, Arkitme, Sinme, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />Arvadme, Zemarme, nah Hamathme pau deda.<verse eid="1CH 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 1:17" />Shem napeidung cai Elam, Ashur, Arphaxad, Lud, Aram, Uz, Hul, Gether, nah Meshek. <verse eid="1CH 1:17" /><verse number="18" style="v" sid="1CH 1:18" />Arphaxad pena Shelah lunglu, nah Shelah pena Eber lunglu. <verse eid="1CH 1:18" /><verse number="19" style="v" sid="1CH 1:19" />Eber pe napei hangna bam. Hangge zi cai Peleg, kedanemene petingdau kideu mzi kedine. Pe sinabe zi cai Joktan. <verse eid="1CH 1:19" /><verse number="20" style="v" sid="1CH 1:20" />Joktan leuhmedung cai Almodad, Sheleph, Hazarmaveth, Jerah, <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />Hadoram, Uzal, Diklah, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />Obal, Abimael, Sheba, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />Ophir, Havilah, nah Jobab; aidungde pelane Joktan leuhme.<verse eid="1CH 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 1:24" />Shem, Arphaxad, Shelah, <verse eid="1CH 1:24" /><verse number="25" style="v" sid="1CH 1:25" />Eber, Peleg, Reu, <verse eid="1CH 1:25" /><verse number="26" style="v" sid="1CH 1:26" />Serug, Nahor, Terah, <verse eid="1CH 1:26" /><verse number="27" style="v" sid="1CH 1:27" />Abram, Abraham lie kelabe.<verse eid="1CH 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 1:28" />Abraham napei kena cai Isaac penai Ishmael. <verse eid="1CH 1:28" /><verse number="29" style="v" sid="1CH 1:29" />Aidungde penai napeidung: Ishmael neraibe cai Nebaioth, pecai Kedar, Adbeel, Mibsam, <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />Mishma, Dumah, Massa, Hadad, Tema, <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />Jetur, Naphish, nah Kedemah. Aidungde Ishmael napeidung.<verse eid="1CH 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 1:32" />Abraham nauseupui Keturah napeidung cai, Zimran, Jokshan, Medan, Midian, Ishbak, nah Shuah. Jokshan napei kena cai Sheba penai Dedan. <verse eid="1CH 1:32" /><verse number="33" style="v" sid="1CH 1:33" />Midian napeidung cai, Ephah, Epher, Hanok, Abida, nah Eldaah. Aidungde pelane Keturah leuhme. <verse eid="1CH 1:33" /><verse number="34" style="v" sid="1CH 1:34" />Abraham pena Isaac lunglu. Isaac napei kena cai Esau penai Israel.<note caller="-" style="x"><char style="xo" closed="false">1:34 </char><char style="xt" closed="false"><ref loc="MAT 1:2">Mat. 1:2</ref></char></note><verse eid="1CH 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 1:35" />Esau napeidung cai Eliphaz, Reuel, Jeush, Jalam, nah Korah. <verse eid="1CH 1:35" /><verse number="36" style="v" sid="1CH 1:36" />Eliphaz napeidung cai Teman, Omar, Zepho, Gatam, Kenaz, Timna, nah Amalek. <verse eid="1CH 1:36" /><verse number="37" style="v" sid="1CH 1:37" />Reuel napeidung cai Nahath, Zerah, Shammah, nah Mizzah.<verse eid="1CH 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 1:38" />Seir napeidung cai Lotan, Shobal, Zibeon, Anah, Dishon, Ezer, nah Dishan. <verse eid="1CH 1:38" /><verse number="39" style="v" sid="1CH 1:39" />Lotan napei kena cai Hori penai Homam, nah Timna cai Lotan tipui. <verse eid="1CH 1:39" /><verse number="40" style="v" sid="1CH 1:40" />Shobal napeidung cai Alvan, Manahath, Ebal, Shepho, nah Onam. Zibeon napei kena cai Aiah penai Anah. <verse eid="1CH 1:40" /><verse number="41" style="v" sid="1CH 1:41" />Anah napei cai Dishon. Dishon napeidung cai Hemdan, Eshban, Ithran, nah Keran. <verse eid="1CH 1:41" /><verse number="42" style="v" sid="1CH 1:42" />Ezer napeidung cai Bilhan, Zaavan, nah Akan. Dishan napei kena cai Uz penai Aran.<verse eid="1CH 1:42" /></para>
  <para style="s">Edom reu kedimedung</para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 1:43" />Hegwangme aidungde Israelme reu hegwang ge de bam kemak dwa, Edom deu ga hegwang tei: Beor napei Bela, nah pe namdi zi cai Dinhabah. <verse eid="1CH 1:43" /><verse number="44" style="v" sid="1CH 1:44" />Bela tsai di ge, Bozrah gade kegwang Zerah napei Jobab pebam leu eh hegwang teilu. <verse eid="1CH 1:44" /><verse number="45" style="v" sid="1CH 1:45" />Jobab tsai dige, Husham deu ga Temanme hegwangpei pebam leu lu. <verse eid="1CH 1:45" /><verse number="46" style="v" sid="1CH 1:46" />Husham tsaidi ge, Bedad napei Hadad, Moab deu gade Midianme de ngam kelube de pebam leu eh hegwang teilu. Pe namdi zi cai Avith. <verse eid="1CH 1:46" /><verse number="47" style="v" sid="1CH 1:47" />Hadad tsaidi ge, Masrekah gade kegwang Samlah pe bam leu eh hegwang teilu. <verse eid="1CH 1:47" /><verse number="48" style="v" sid="1CH 1:48" />Samlah tsaidi ge, kereuki taiga kebam Rehoboth gade kegwang Shaul pebam leu eh hegwang teilu. <verse eid="1CH 1:48" /><verse number="49" style="v" sid="1CH 1:49" />Shaul tsaidi ge, Akbor napei Baal-Hanan pebam leu eh hegwang teilu. <verse eid="1CH 1:49" /><verse number="50" style="v" sid="1CH 1:50" />Baal-Hanan Akbor napei tsaidi ge, Hadad pebam leu eh hegwang teilu. Pe namdi zi cai Pau. Pe nau zi cai Mehetabel, Matred napui, Me-Zahab tsapui. <verse eid="1CH 1:50" /><verse number="51" style="v" sid="1CH 1:51" />Hadad tsaidi.</para>
  <para style="p" vid="1CH 1:51">Edom ga kedimedung cai ditube Timna, ditube Alvah, ditube Jetheth, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />Ditube Oholibamah, nah ditube Elah, ditube Pinon, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />Ditube Kenaz, ditube Teman, ditube Mibzar, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />Ditube Magdiel, nah ditube Iram. Aidungde Edom ga kedimedung.<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s">Israel napeidung</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 2:1" />Aidung de Israel napeidung: Reuben, Simeon, Levi, Judah, Issachar, Zebulun, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />Dan, Joseph, Benjamin, Naphtali, Gad, nah Asher.<verse eid="1CH 2:2" /></para>
  <para style="s">Judah: Hezron namedung</para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 2:3" />Judah napeidung cai Er, Onan, nah Shelah, Canaanme pui Shua napui ne pe na mna kebeube. Judah neraibe cai Er, RAMPAUBE dwa de mau kedine, RAMPAUBE pecu teitset di. <verse eid="1CH 2:3" /><verse number="4" style="v" sid="1CH 2:4" />Tamar, pe na nau, pecu Perez penai Zerah mnabeu. Judah napeidung hangmengei bam.<verse eid="1CH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 2:5" />Perez napei kena cai Hezron penai Hamul. <verse eid="1CH 2:5" /><verse number="6" style="v" sid="1CH 2:6" />Zerah napeidung cai Zimri, Ethan, Heman, Kalkol, nah Darda, pelane hangmengei. <verse eid="1CH 2:6" /><verse number="7" style="v" sid="1CH 2:7" />Karmi napei cai Achar, Tinggwang ziemne teimci pwa kebam de pa rega kecune Israel dage keherei teugwang kegaibe. <note caller="+" style="f"><char style="ft" closed="false">Kesa laisiudung ga</char><char style="fqa">Achan </char> mene <char style="fqa">Achar, bamla </char> </note> <verse eid="1CH 2:7" /><verse number="8" style="v" sid="1CH 2:8" />Ethan napei cai Azariah.<verse eid="1CH 2:8" /></para>
  <para style="s">Hezron napei Ram gade David kecang</para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 2:9" />Hezron napeidung cai Jerahmeel, Ram, nah Caleb.<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="MAT 1:3">Mat. 1:3</ref></char></note> <verse eid="1CH 2:9" /><verse number="10" style="v" sid="1CH 2:10" />Ram au Amminadab pei, nah Amminadab au Nahson pei, Judah leuhmedung kakga muiteume ge. <verse eid="1CH 2:10" /><verse number="11" style="v" sid="1CH 2:11" />Nashon au Salmon pei, nah Salmon au Boaz pei. <verse eid="1CH 2:11" /><verse number="12" style="v" sid="1CH 2:12" />Boaz au Obed pei, nah Obed au Jesse pei.<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="MAT 1:4-5">Mat. 1:4-5</ref></char></note> <verse eid="1CH 2:12" /><verse number="13" style="v" sid="1CH 2:13" />Jesse pe neraibe Eliab, pe kena be Abinadab, pe kecumbe Shimea, <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />pe mdaibe Nethanel, pe mengeibe Raddai, <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />pe herokbe Ozem, nah David pe henabe lunglu.<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="LUK 3:31-32">Luk. 3:31-32</ref></char></note> <verse eid="1CH 2:15" /><verse number="16" style="v" sid="1CH 2:16" />Penui tipui cai Zeruiah penai Abigail. Zeruiah napeidung cai Abishai, Joab, nah Asahel, penui hangcum. <verse eid="1CH 2:16" /><verse number="17" style="v" sid="1CH 2:17" />Abigail Amasa de mnalu, pe pei au Ishmael leuhme Jether.<verse eid="1CH 2:17" /></para>
  <para style="s">Hezron napei Caleb dade kegwang</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 2:18" />Hezron napei Caleb, pena lunglu, pe nau Azubah dade, nah Jerioth dade. Pe napeidung cai Jesher, Shobab, nah Ardon. <verse eid="1CH 2:18" /><verse number="19" style="v" sid="1CH 2:19" />Azubah tsaidi, nah pecai Caleb Ephrath de ngngwa lunglu, pa pecu Hur lungbeu. <verse eid="1CH 2:19" /><verse number="20" style="v" sid="1CH 2:20" />Hur au Uri pei, nah Uri au Bezalel pei.<verse eid="1CH 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 2:21" />Pecai Hezron (pa mmi riakherok dige) Makir napui, Gilead tipui de ngngwa lunglu. Pa pecu Segub lungbeu. <verse eid="1CH 2:21" /><verse number="22" style="v" sid="1CH 2:22" />Segub au jair pei, Gilead deu ga namdi ngkaiehkecum reu hegwang keteibe. <verse eid="1CH 2:22" /><verse number="23" style="v" sid="1CH 2:23" />Geshur penai Aram, Havvoth Jair nah Kenath nam gwalu nah twagwapung kebam namceudung riakherok de si eh. Aika kelunghme pelane Makir leuhme, Gilead pei leuhme. <verse eid="1CH 2:23" /><verse number="24" style="v" sid="1CH 2:24" />Hezron tsai kedicai, Caleb Ephrathah de ngngwa lungdi, pepei Hezron nau de. Penai Ashhur de mnalu, Tekoa nam tumbe. <note caller="+" style="f"><char style="ft" closed="false">Kesa laisiudung ga, </char><char style="fqa">Hezron tsai kedicai, Caleb pe pei nau Ephrathah de pe naulu. Pa pecu Ashhur mna beu, pa au Tekoa namtumbe.</char> </note><verse eid="1CH 2:24" /></para>
  <para style="s">Hezron napei Jerahmeel dage kegwang</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 2:25" />Hezron neraibe, Jerahmeel napeidung cai, neraibe Ram, Bunah, Oren, Ozem, nah Ahijah. <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />Jerahmeel pe nau keda ge tei, pezi cai Atarah. Pa cai Onam pui. <verse eid="1CH 2:26" /><verse number="27" style="v" sid="1CH 2:27" />Jerahmeel neraibe, Ram napeidung cai Maaz, Jamin, nah Eker. <verse eid="1CH 2:27" /><verse number="28" style="v" sid="1CH 2:28" />Onam napei cai Shammai penai Jada. Shammai napei cai Nadab penai Abishur. <verse eid="1CH 2:28" /><verse number="29" style="v" sid="1CH 2:29" />Abishur nau zi cai Abihail, nah pa pecu Ahban penai Molid lungbeu. <verse eid="1CH 2:29" /><verse number="30" style="v" sid="1CH 2:30" />Nadab napeidung cai Seled penai Appaim, dede Seled pe na tei mene tsaidi. <verse eid="1CH 2:30" /><verse number="31" style="v" sid="1CH 2:31" />Appaim napei cai Ishi. Ishi napei cai Sheshan. Sheshan napei cai Ahlai. <verse eid="1CH 2:31" /><verse number="32" style="v" sid="1CH 2:32" />Shammai sinabe, Jada napei cai Jether penai Jonathan. Jether pe na tei mene tsaidi. <verse eid="1CH 2:32" /><verse number="33" style="v" sid="1CH 2:33" />Jonathan napei cai Peleth penai Zaza. Aidung de Jerahmeel leuhme. <verse eid="1CH 2:33" /><verse number="34" style="v" sid="1CH 2:34" />Sheshan pe na mipeina gah, napuidung rünne. Sheshan kila Egyptme pei ge pezi cai Jarha bam la. <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />Sheshan pe kilabe Jarha de pe napui de peu pe naulu. Pa pecu Attai lungbeu. <verse eid="1CH 2:35" /><verse number="36" style="v" sid="1CH 2:36" />Attai au Nathan pei, nah Nathan au Zabad pei. <verse eid="1CH 2:36" /><verse number="37" style="v" sid="1CH 2:37" />Zabad au Ephlal pei, nah Ephlal au Obed pei. <verse eid="1CH 2:37" /><verse number="38" style="v" sid="1CH 2:38" />Obed au Jehu pei, nah Jehu au Azariah pei. <verse eid="1CH 2:38" /><verse number="39" style="v" sid="1CH 2:39" />Azariah au Helez pei, nah Helez au Eleasah pei. <verse eid="1CH 2:39" /><verse number="40" style="v" sid="1CH 2:40" />Eleasah au Sismai pei, nah Sismai au Shallum pei. <verse eid="1CH 2:40" /><verse number="41" style="v" sid="1CH 2:41" />Shallum au Jekamiah pei, nah Jekamiah au Elishama pei.<verse eid="1CH 2:41" /></para>
  <para style="s">Hezron napei Caleb dade kegwang</para>
  <para style="p">
    <verse number="42" style="v" sid="1CH 2:42" />Jerahmeel sinabe, Caleb napeidung cai, pe neraibe Mesha, pa au Ziph pei. Pe napei pe kena be, Mareshah cai Hebron pei. <verse eid="1CH 2:42" /><verse number="43" style="v" sid="1CH 2:43" />Hebron napeidung cai Korah, Tappuah, Rekem nah Shema. <verse eid="1CH 2:43" /><verse number="44" style="v" sid="1CH 2:44" />Shema au Raham pei, nah Jorkeam tum kegaibe. Rekem au Shammai pei. <verse eid="1CH 2:44" /><verse number="45" style="v" sid="1CH 2:45" />Shammai napei cai Maon, nah Maon Beth Zur tum kegaibe. <verse eid="1CH 2:45" /><verse number="46" style="v" sid="1CH 2:46" />Ephah, Caleb nauseupui, Haran, Moza nah Gazez lungbeu. Haran au Gazez pei. <verse eid="1CH 2:46" /><verse number="47" style="v" sid="1CH 2:47" />Jahdai napeidung cai Regem, Jotham, Geshan, Pelet, Ephah, nah Shaaph. <verse eid="1CH 2:47" /><verse number="48" style="v" sid="1CH 2:48" />Maakah, Caleb nauseupui, Sheber penai Tirhanah lungbeu. <verse eid="1CH 2:48" /><verse number="49" style="v" sid="1CH 2:49" />Pa Shaaph, Madmannah tum kegaibe, Sheva, Makbenah nah Gibea tum kegaibe de lung silu. Caleb napui cai Aksah. Aidungde Caleb leuhmedung.<verse eid="1CH 2:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CH 2:50" />Aidungde Hur napeidung, Ephrathah neraibe: Shobal, Kiriath Jearim tum kegaibe, <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />Salma, Bethlehem tum kegaibe, nah Hareph, Beth Gader tum kegaibe. <verse eid="1CH 2:51" /><verse number="52" style="v" sid="1CH 2:52" />Shobal, Kiriath Jearim tum kegaibe leuhmedung: Haroeh, Manahathme lung kebam pempiege, <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />nah Kiriath Jearim pautsamedung: Ithrme, Puthme, Shumathme, nah Mishrame. Zorathme nah Eshtaolme aidungde gade lungh gwang. <verse eid="1CH 2:53" /><verse number="54" style="v" sid="1CH 2:54" />Salma leuhmedung cai Bethlehem, Netophathme, Atroth Beth Joab, nah Manahathme pempiege, Zorame, <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />nah laisiu keci pautsa Jabez nam ga lungh kebamme: Tirathme, Shimeathme, nah Sucathme. Aidungde Kenitme Hammath, Rekabme leuhme peibe dade lungh gwang kecume.<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s">David napeidung</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1" />Cu aidungde David napeidung pecu Hebron gade lung kebeume: neraibe cai Ammon, Jezreelme Ahinoam ne mna kebeube; pe kenabe cai Daniel, Carmelme Abigail ne mna kebeube; <verse eid="1CH 3:1" /><verse number="2" style="v" sid="1CH 3:2" />pe kecumbe cai Absalom, pe pui cai Maakah, Talmai, Geshur hegwangpei napui. Pemdaibe cai Haggith napei Adonijah. <verse eid="1CH 3:2" /><verse number="3" style="v" sid="1CH 3:3" />Pe mengeibe cai Abital ne mna kebeu Shephatiah; peherokbe cai pe nau Eglah ne mna kebeu Ithream.<verse eid="1CH 3:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="1CH 3:4" />Aidung hang herok de David Hebron ga mmi hena nah kei herok hegwang tei kecu dau mnalu. Pecia pa Jerusalem ga mmi camrei-kecum hegwang teilu. <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />Pecu Bathsheba, Ammiel napui ne mipeina hangmdai aidungde de Jerusalem gade mnabeu: Shammua, Shobab, Nathan, nah Solomon. <note caller="+" style="f"><char style="ft" closed="false">Kesa laisiudung ga </char><char style="fqa">Bathsheba </char> mene<char style="fqa">Bathshua </char> mede <char style="fqa">Bathseba, de bamla</char>. </note> <verse eid="1CH 3:5" /><verse number="6" style="v" sid="1CH 3:6" />David napeidung kedame hanghekui cai: Ibhar, Elishua, Eliphelet, <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />Nogah, Nepheg, Japhia, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />Elishama, Eliada, nah Eliphelet. <verse eid="1CH 3:8" /><verse number="9" style="v" sid="1CH 3:9" />Aidungde David napeidung, pe nauseupuidung napeidung si mene. Penui tipui cai Tamar.<verse eid="1CH 3:9" /></para>
  <para style="s">Judah gwangpeidung</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 3:10" />Solomon napei cai Rehoboam. Rehoboam napei cai Abijah. Abijah napei cai Asa. Asa napei cai Jehoshaphat. <verse eid="1CH 3:10" /><verse number="11" style="v" sid="1CH 3:11" />Jehoshaphat napei cai Jehoram. Jehoram napei cai Ahaziah. Ahaziah napei cai Joash. <verse eid="1CH 3:11" /><verse number="12" style="v" sid="1CH 3:12" />Joash napei cai Amaziah. Amaziah napei cai Azariah. Azariah napei cai Jotham. <verse eid="1CH 3:12" /><verse number="13" style="v" sid="1CH 3:13" />Jotham napei cai Ahaz. Ahaz napei cai Hezekiah. Hezekiah napei cai Manasseh. <verse eid="1CH 3:13" /><verse number="14" style="v" sid="1CH 3:14" />Manasseh napei cai Amon. Amon napei cai Josiah.<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 1:7-10">Mat. 1:7-10</ref></char></note> <verse eid="1CH 3:14" /><verse number="15" style="v" sid="1CH 3:15" />Josiah napeidung cai, pe neraibe Johanan, pe napei pe kenabe Jehoiakim, pe napei pe kecumbe Zedekiah, nah pe napei pe mdaibe Shallum. <verse eid="1CH 3:15" /><verse number="16" style="v" sid="1CH 3:16" />Jehoiakim napei cai Jehoiachin penai Zedekiah.<note caller="-" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="MAT 1:11">Mat. 1:11</ref></char></note><verse eid="1CH 3:16" /></para>
  <para style="s">Jehoiachin napeidung</para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 3:17" />Jehoiachin, hebaang keteibe napeidung cai, Shealtiel, <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />Malkiram, Pedaiah, Shenazzar, Jekamiah, Hoshama, nah Nedabiah. <verse eid="1CH 3:18" /><verse number="19" style="v" sid="1CH 3:19" />Pedaiah napei cai Zerubbabel penai Shimei. Zerubbabel napei cai Meshullam penai Hananiah; Shelomith cai penai tipui. <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />Pe napeidung keda hangmengei cai Hashubah, Ohel, Berekiah, Hasadiah, nah Jushab-Hesed. <verse eid="1CH 3:20" /><verse number="21" style="v" sid="1CH 3:21" />Hananiah napei cai Pelatiah penai Jeshaiah. Pe napei cai Rephaiah, nah pe leuhme keda cai Arnan, Obadiah, nah Shekaniah. <verse eid="1CH 3:21" /><verse number="22" style="v" sid="1CH 3:22" />Shekaniah napei cai Shemaiah. Shemaiah napeidung cai Hattush, Igal, Bariah, Neariah, nah Shaphat. <verse eid="1CH 3:22" /><verse number="23" style="v" sid="1CH 3:23" />Neariah napeidung hangcum cai Elioenai, Hizkiah, nah Azrikam. <verse eid="1CH 3:23" /><verse number="24" style="v" sid="1CH 3:24" />Elioenai napei hang henadung cai Hodaviah, Eliashib, Pelaiah, Akkub, Johanan, Delaiah, nah Anani.<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s">Judah pautsa kedadung</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1" />Judah leuhmedung cai Perez, Hezron, Karmi, Hur, nah Shobal. <verse eid="1CH 4:1" /><verse number="2" style="v" sid="1CH 4:2" />Shobal cai Reaiah pei. Reaiah cai Jahath pei. Jahath cai Ahumai penai Lahad pei. Aidungde Zorath pautsame. <verse eid="1CH 4:2" /><verse number="3" style="v" sid="1CH 4:3" />Aidungde Etam namdi ga pautsame paudung: Jezreel, Ishma, nah Idbash. Penui tipui zi cai Hazzelelponi. <verse eid="1CH 4:3" /><verse number="4" style="v" sid="1CH 4:4" />Penuel au Gedor namdi ga pautsame pau. Ezer ne Hushah namdi de tumlu. Aidungde Hur leuhme, Ephrathah neraibe nah Bethlehem tum kelube. <verse eid="1CH 4:4" /><verse number="5" style="v" sid="1CH 4:5" />Ashhur Tekoa nam tum kelube pe nau hangna Helah penai Naarah bam. <verse eid="1CH 4:5" /><verse number="6" style="v" sid="1CH 4:6" />Naarah pecu Ahuzzam, Hepher, Temeni, nah Haahashtari de mnabeu. Aidungde Naarah napeidung. <verse eid="1CH 4:6" /><verse number="7" style="v" sid="1CH 4:7" />Helah napeidung cai Zereth, Zohar, Ethnan, <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />nah Koz, pa au Anub penai Hazzobebah pei nah Harum napei Aharhel dade lung kegwangme pautsame pau. <verse eid="1CH 4:8" /><verse number="9" style="v" sid="1CH 4:9" />Jabez de au pe sinamedung de swade rüt gwala. Pe pui pecu Jabez de eh qulu. Pa rangdi, “Kedanemene Ih pecu keherei eh mna kelune.” <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />Jabez Israel Tinggwang de qu eh ranggai, “Nang acu samlam kesang beu, a tingdeu tei ngkie beu nah acu ngngwala beu zielie cai. Nang aide teilu de, keherei gade nang acu keumzia beuzie, iciu eh Ih keherei kecu gade mbaidi lubui!” Cine Tinggwang pe kekie pecu teibeu. <verse eid="1CH 4:10" /><verse number="11" style="v" sid="1CH 4:11" />Kelub sinabe Shuhah au Mehir pei, Mehir au Eshton pei. <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />Eshton au Beth Rapha, Paseah, nah Ir Nahash pei Tehinnah pei. <note caller="+" style="f"><char style="ft" closed="false">Kesa laisiudung ga</char><char style="fqa">Nahash namdi ga kelunghme, de eh bam </char> </note> Mina aidungde Rekah ga kelunghme. <verse eid="1CH 4:12" /><verse number="13" style="v" sid="1CH 4:13" />Kenaz napei cai Othniel penai Seraiah. Othniel napei cai Hathath penai Meonothai. <note caller="+" style="f"><char style="ft" closed="false">Laisiudung kekiee ga </char><char style="fqa">Meonothai </char> de kecu de aipau rwak gage kai la, rau swa dai kecume ne tei mau kedi ha nlum eh. </note> <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />Meonothai au Ophrah pei, nah Seraiah au Joab pei, Ge-Harashim de tum kelube, pe minadung heciem ta tei kecime. <verse eid="1CH 4:14" /><verse number="15" style="v" sid="1CH 4:15" />Jephunneh napei Caleb napeidung cai Iru, Elah nah Naam. Elah napei cai Kenaz. <verse eid="1CH 4:15" /><verse number="16" style="v" sid="1CH 4:16" />Jehallelel napeidung cai Ziph, Ziphah, Tiria, nah Asarel. <verse eid="1CH 4:16" /><verse number="17" style="v" sid="1CH 4:17" />Ezrah napeidung cai Jether, Mered, Epher, nah Jalon. Mered nau Egyptme pui Miriam, Shammai, nah Ishbah, de mnabeu, Ishbah Eshtemoa nam tum kelube. Aidungde Pharaoh napui Bithiah, Mered nau kelube pui napeidung. <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />Mered nau Bitiah Judahme pui, Jared, Gedor nam tum kelube, Heber, Soko nam tum kelube nah Jekuthiel, Zanoah nam tum kelube de mnabeu. Nah aidungde Pharaoh napui Bitiah, Mered nau namedung. <verse eid="1CH 4:18" /><verse number="19" style="v" sid="1CH 4:19" />Naham tipui, Hodiah nau napeime hangna gade, hangge Garmme Keilah pau. Kedabe decai Maakathme Eshtemoame pau. <verse eid="1CH 4:19" /><verse number="20" style="v" sid="1CH 4:20" />Shimon napeidung cai Amnon, Rinnah, Ben-Hanan, nah Tilon. Ishi napei cai Zoheth penai Ben-Zoheth. <verse eid="1CH 4:20" /><verse number="21" style="v" sid="1CH 4:21" />Judah napei Shelah leuhme cai, Lekah nam tum kelube Er, Mareshah nam tum kelube Laadah nah Beth Ashbea ga langcimpai kedakme pautsame, <verse eid="1CH 4:21" /><verse number="22" style="v" sid="1CH 4:22" />Jokim, Kozeba ga kelunghme, nah Joash penai Saraph, Moab nah Jashubi Lehem ga kedi tei kebambe. (Aipau ha de au nda raupwa kenzeu gade ngaulu.) <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />Aidungde li keteime Netaim nah Gederah ga kelunghme nah hegwangpei ziemne heta teila.<verse eid="1CH 4:23" /></para>
  <para style="s">Simeon napeidung</para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 4:24" />Simeon leuhme cai Nemuel, Jamin, Jarib, Zerah, nah Shaul. <verse eid="1CH 4:24" /><verse number="25" style="v" sid="1CH 4:25" />Shallum cai Shaul napei, Mibsam cai Shallum napei, nah Mishma cai Mibsam napei. <verse eid="1CH 4:25" /><verse number="26" style="v" sid="1CH 4:26" />Mishma leuhme cai pe napei Hammuel, pe tsapei Zakkur, nah pe tsaswa Shimei. <verse eid="1CH 4:26" /><verse number="27" style="v" sid="1CH 4:27" />Shimei pe napeime kereieherok nah pe napuime hangherok bam. Pe sinamedung penui name cam, cine penui pautsame riak Judah leuhme nzwa kiee luma. <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />Penui Beersheba, Moladah ga, nah Hazar Shual ga lungh. <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />Penui de Bilhah, Ezem, Tolad, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />Bethuel, Hormah, Ziklag, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />Beth Markaboth, Hazar Susim, Beth Biri, nah Shaaraim ga lungh. David hegwang tei kemakne aipau namdidung de penui gu. <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />Penui nam mengeidung cai Etam, Ain, Rimmon, Token, nah Ashan, <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />twagwapung kebam renamdung de si eh Baalath ga kecangde. Aidungde penui kelungh nidung, nah penui pautsa ha rau nzeu pwala. <verse eid="1CH 4:33" /><verse number="34" style="v" sid="1CH 4:34" />Pautsa muiteume cai Meshobab, Jamlech, Amaziah napei Joshah, <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />Joel, Joshibiah napei Jehu, Seraiah napei nah Asiel napei, <verse eid="1CH 4:35" /><verse number="36" style="v" sid="1CH 4:36" />Elioenai, Jaakobah, Jeshohaiah, Asaiah, Adiel, Jesimiel, Benaiah, <verse eid="1CH 4:36" /><verse number="37" style="v" sid="1CH 4:37" />nah Ziza Shiphi napei, Allon napei, Jedaiah napei, Shimri napei Shemaiah napei. <verse eid="1CH 4:37" /><verse number="38" style="v" sid="1CH 4:38" />Hezi raupwa kebam aidungde penui pautsame ga muiteumedung nah penui pautsa kiee si sütlu. <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />Penui kauruine ziemne tsehei kemdiak peei kerane, penui Gedor taiga, langkam naimiak kepetle bie miedi. <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />Penui tsehei luh keyi nah kekiee kebam ngaulu. Cipau deu de au zing de, nciepniep nah mzaha. Ndaa Ham leuhme ne cika lungh la. <verse eid="1CH 4:40" /><verse number="41" style="v" sid="1CH 4:41" />Hezi nreule raupwa kebam aidungde Judah gwangpei Hezekiah tingdau gwang eh Ham leuhme nah Meunimme lungh kebam dungde gwaketang. Penui penuide teingkap cangsiak di nah penui cika lunghdi kedanemene penui kauruine ziemne tsehei luh ngau kelune. <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />Penui kakgade, Simeon leuhme gade mina hai mengei ge Seir Deutu ga miedi. Ishi napeime Pelatiah, Neariah, Rephaiah, nah Uzziel, ne penui muiteu tei eh ngngwa mie. <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />Penui Amalekme bang kebam kedame pelane de ngamlu delwe cika cu kecang lungh ladi.<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s">Reuben napeidung</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1" />Israel neraibe Reuben leuhmedung—cu Reuben au Israel neraibe, dede pe nerai qwa de Israel napei Joseph napeime de peudi, kedanemene Reuben pe pei nauseupui de ngngwa nauhepei zai tei kedine. Cine pecu pena cingtube lie eh raunzeu tadi. <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />Judah pe siname kak de ngkingtube, nah pe dade muiteu lunggwang zie. Dede nerai qwa au Joseph gu— <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />Israel neraibe Reuben napeidung cai Hanok, Pallu, Hezron, nah Karmi. <verse eid="1CH 5:3" /><verse number="4" style="v" sid="1CH 5:4" />Joel leuhme cai aidungde: Joel napei Shemaiah, Shemaiah napei cai Gog nah Gog napei cai Shimei. <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />Shimei napei cai Micah, Micah napei cai Reaiah nah Reaiah napei cai Baal. <verse eid="1CH 5:5" /><verse number="6" style="v" sid="1CH 5:6" />Baal napei cai Beerah, pecu Assyria gwangpei Tiglath-Pileser ne tuilwe ngngwa tetdi. Beerah au Reuben leuh kakga muiteume ge. <verse eid="1CH 5:6" /><verse number="7" style="v" sid="1CH 5:7" />Beerah kibaume penui pautsame ria gade, penui paupak raukenzeu rehi gade raupwa bam: Jeiel muiteube, Zechariah, nah <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />Azaz napei Bela, Shema capei nah Joel pautsa. Penui Aroer ga lung bam Nebo nah Baal Meon ga kecang, <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />nah naimiak kepetle bie, hetaideu pendeu gade Euphrates Reuki kecang lung miedi. Aide au kedanemene Gileadme deu ga penui gu kauruine kekiee kebamne. <verse eid="1CH 5:9" /><verse number="10" style="v" sid="1CH 5:10" />Saul hegwang ketei tingdau, Reuben leuhme Hagritme de gwaketang eh penui de ngamlu. Penui Gilead naimiak kepetle bie hangdeu pelane ga Hagritme paikidung ga lunghdi.<verse eid="1CH 5:10" /></para>
  <para style="s">Gad napeidung</para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 5:11" />Gad leuhme peupeime penui taiga, Bashan deu gade Salekah kecang ga lunghdi. <verse eid="1CH 5:11" /><verse number="12" style="v" sid="1CH 5:12" />Joel penui muiteube; pe kenabe cai Shapham nah Janai penai Shaphat cai Bashan ga. <verse eid="1CH 5:12" /><verse number="13" style="v" sid="1CH 5:13" />Penui kibaume, penui pautsa gade cai, Michael, Meshullam, Sheba, Jorai, Jakan, Zia, nah Eber, pelane ge pautsa hena. <verse eid="1CH 5:13" /><verse number="14" style="v" sid="1CH 5:14" />Mina aidungde zi rau teu kela de Abihail leuhme nah Abihail cai Huri napei nah Huri cai Jaroah napei. Jaroah cai Gilead napei nah Gilead cai Michael napei. Michael cai Jeshishai napei nah Jeshishai cai Jahdo napei. Jahdo Buz napei. <verse eid="1CH 5:14" /><verse number="15" style="v" sid="1CH 5:15" />Ahi, Abdiel napei nah Guni capei, cai penui pautsa peube. <verse eid="1CH 5:15" /><verse number="16" style="v" sid="1CH 5:16" />Penui Gilead ga, Bashan ga, namceudung ga, nah Sharon cehei deu pelane ga, Sharon deurai ga kecang lunghdi. <verse eid="1CH 5:16" /><verse number="17" style="v" sid="1CH 5:17" />Aidungde pelane paupak ria gade Judah gwangpei Jotham penai Israel gwangpei Jeroboam tingdau ge raulu.<verse eid="1CH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />Reuben leuhme, Gad leuhme nah Manasseh leuh pempie ge da 44,760 reugwame hereu tei kera ziemne mtei kelume bam. Hegeu nah kingtie kepwame nah lakpi kepwa ciem kecime. <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />Penui Hagar leuhme, Jetur, Naphish nah Nodab de gwaketang. <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />Penuide ngngwa regi kecu ga Tinggwang penui de ngha beu. Iciu eh Hagritme nah penuide ngngwa kela pelane de ngamlu. Aide kedanemene Israelme hereu tei kebam gade Tinggwang dade kengha kiegai nah pa penui kekie teibeu, kedanemene penui pecu nlum kelune. <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />Penui ngauraume gu hekaunedung tuilu, utdung cang riakngei, meurün 250,000, gadhadung cangna, nah mina 100,000 de si eh. <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />Penui ngauraume kekiee tsaidi, kedanemene hereu de Tinggwang lungning gade kecu ziemne. Nah penui ngauraume deu ga lungh bamdi, penuide lang gidi kemak tane.<verse eid="1CH 5:22" /></para>
  <para style="s">Manasseh leuh-mpei ge</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />Manasseh leuh pempie Bashan deu ga Baal Hermon nah Senir (cide Hermon Deutu) ga kecang lungh. <verse eid="1CH 5:23" /><verse number="24" style="v" sid="1CH 5:24" />Aidungde penui pautsame peuteume: Epher, Ishi, Eliel, Azriel, Jeremiah, Hodaviah, nah Jahdiel. Penui au reugwa keyime, mina kenglangme, nah penui pautsa peuteume.<verse eid="1CH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 5:25" />Dede penui penui paume Tinggwang dade masanglu tadi. Meliene, Tinggwang ne penui dwade ngkap kedi deumenadung rabedung de penui reca di. <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />Israel Tinggwang Assyria gwangpei Pul (Tiglath-Pileser de eh qula, Assyria gwangpei) lung tei gaibeu. Pa Reuben leuhme, Gad leuhme nah Manasseh leuh pempie de penui deu gade langgi di. Pa penuide Halah, Habor, Hara nah Gozan reu kungga ngngwa gwanglu, penui cika cu kecang lunghbam.<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s">Levi napeidung</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 6:1" />Levi napeidung cai Gershon, Kohath nah Merari. <verse eid="1CH 6:1" /><verse number="2" style="v" sid="1CH 6:2" />Kohath napeidung cai Amram, Izhar, Hebron, nah Uzziel. <verse eid="1CH 6:2" /><verse number="3" style="v" sid="1CH 6:3" />Amram namedung cai Aaron, Moses, nah Miriam. Aaron napeidung cai Nadab, Abihu, Eleazar, nah Ithamar. <verse eid="1CH 6:3" /><verse number="4" style="v" sid="1CH 6:4" />Eleazar au Phinehas pei, nah Phinehas au Abishua pei. <verse eid="1CH 6:4" /><verse number="5" style="v" sid="1CH 6:5" />Abishua au Bukki pei, nah Bukki au Uzzi pei. <verse eid="1CH 6:5" /><verse number="6" style="v" sid="1CH 6:6" />Uzzi au Zerahiah pei, nah Zerahiah au Meraioth pei. <verse eid="1CH 6:6" /><verse number="7" style="v" sid="1CH 6:7" />Meraioth au Amariah pei, nah Amariah au Ahitub pei. <verse eid="1CH 6:7" /><verse number="8" style="v" sid="1CH 6:8" />Ahitub au Zadok pei, nah Zadok au Ahimaaz pei. <verse eid="1CH 6:8" /><verse number="9" style="v" sid="1CH 6:9" />Ahimaaz au Azariah pei, nah Azariah au Johanan pei. <verse eid="1CH 6:9" /><verse number="10" style="v" sid="1CH 6:10" />Johanan au Azariah pei, pa Jerusalem ga hegwangpei Solomon ne kerecaki teikelu ga hegwa keteibe. <verse eid="1CH 6:10" /><verse number="11" style="v" sid="1CH 6:11" />Azariah au Amariah pei, nah Amariah au Ahitub pei. <verse eid="1CH 6:11" /><verse number="12" style="v" sid="1CH 6:12" />Ahitub au Zadok pei, nah Zadok au Shallum pei. <verse eid="1CH 6:12" /><verse number="13" style="v" sid="1CH 6:13" />Shallum au Hilkiah pei, nah Hilkiah au Azariah pei. <verse eid="1CH 6:13" /><verse number="14" style="v" sid="1CH 6:14" />Azariah au Seraiah pei, nah Seraiah au Jozadak pei. <verse eid="1CH 6:14" /><verse number="15" style="v" sid="1CH 6:15" />RAMPAUBE hegwangpei Nebuchadnezzar ba gade Judah nah Jerusalem ga minadung de penui deu gade langgi kedidau, Jozadak de de langgi di.<verse eid="1CH 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 6:16" />Levi napeidung cai Gershon, Kohath nah Merari. <verse eid="1CH 6:16" /><verse number="17" style="v" sid="1CH 6:17" />Gershon napei cai Libni penai Shimei. <verse eid="1CH 6:17" /><verse number="18" style="v" sid="1CH 6:18" />Kohath napeidung cai Amram, Izhar, Hebron nah Uzziel. <verse eid="1CH 6:18" /><verse number="19" style="v" sid="1CH 6:19" />Merari napei cai Mahli penai Mushi. Aidungde Levime pautsa penui pautsa rehi gade rau pwabam. <verse eid="1CH 6:19" /><verse number="20" style="v" sid="1CH 6:20" />Gershon leuhmedung: Pe napei cai Libni. Libni napei cai Jahath. Pe napei cai Zimmah. <verse eid="1CH 6:20" /><verse number="21" style="v" sid="1CH 6:21" />Pe napei cai Joah. Pe napei cai Iddo. Pe napei cai Zerah. Pe napei cai Jeatherai. <verse eid="1CH 6:21" /><verse number="22" style="v" sid="1CH 6:22" />Kohath leuhmedung: Pe napei cai Amminadad. Pe napei cai Korah. Pe napei cai Assir. <verse eid="1CH 6:22" /><verse number="23" style="v" sid="1CH 6:23" />Pe capei cai Elkanah. Pe napei cai Ebiasaph. Pe napei cai Assir, <verse eid="1CH 6:23" /><verse number="24" style="v" sid="1CH 6:24" />Pe napei cai Tahath. Pe napei cai Uriel. Pe napei cai Uzziah. Pe napei cai Shaul. <verse eid="1CH 6:24" /><verse number="25" style="v" sid="1CH 6:25" />Elkanah napei cai, Amasai, Ahimoth, <verse eid="1CH 6:25" /><verse number="26" style="v" sid="1CH 6:26" />nah pe napei zi Elkanah; pe napei Zophai, pe napei Nahath, <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" />pe napei Eliab, pe napei Jeroham, pe napei Elkanah. <verse eid="1CH 6:27" /><verse number="28" style="v" sid="1CH 6:28" />Samuel napeidung cai Joel, pe neraibe nah Abijah pe kenabe. <verse eid="1CH 6:28" /><verse number="29" style="v" sid="1CH 6:29" />Merari napei cai: Mahli, pe napei cai Libni. Pe napei cai Shimei. Pe napei cai Uzzah, <verse eid="1CH 6:29" /><verse number="30" style="v" sid="1CH 6:30" />Pe napei cai Shimea. Pe napei cai Haggiah. Pe napei cai Asaiah.<verse eid="1CH 6:30" /></para>
  <para style="s">Kerecaki leiketeime</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />Mina aidungde RAMPAUBE kerecaki gage samkakbung pwa gwanggai kelu cai, hegwangpei David lei kerengeime peu teikelume zidung da. <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />Hegwangpei Solomon Jerusalem ga RAMPAUBE kerecaki de teilu kemaktane, penui lei tei eh RAMPAUBE kebam kerecaki, paiki ga heta tei bamla. Penui de rangkebeu nzwa penui penui ta teicang lu.<verse eid="1CH 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 6:33" />Mina aidungde penui namedung de ngngwa heta keteime. Kohath pautsa gade lei keteibe Heman. Aidungde pe paumedung ria kekamle de keraile gwang cang: Heman cai Joel napei. Joel cai Samuel napei. <verse eid="1CH 6:33" /><verse number="34" style="v" sid="1CH 6:34" />Samuel cai Elkanah napei. Elkanah cai Jeroham napei. Jeroham cai Eliel napei. Eliel cai Toah napei. <verse eid="1CH 6:34" /><verse number="35" style="v" sid="1CH 6:35" />Toah cai Zuph napei. Zuph cai Elkanah napei. Elkanah cai Mahath napei. Mahath cai Amasai napei. Amasai cai Elkanah napei. <verse eid="1CH 6:35" /><verse number="36" style="v" sid="1CH 6:36" />Amasai cai Elkanah napei. Elkanah cai Joel napei. Joel cai Azariah napei. Azariah cai Zephaniah napei. <verse eid="1CH 6:36" /><verse number="37" style="v" sid="1CH 6:37" />Zephaniah cai Tahath napei. Tahath cai Assir napei. Assir cai Ebiasaph napei. Ebiasaph cai Korah napei. <verse eid="1CH 6:37" /><verse number="38" style="v" sid="1CH 6:38" />Korah cai Izhar napei. Izhar cai Kohath napei. Kohath cai Levi napei. Levi cai Israel napei.<verse eid="1CH 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 6:39" />Heman de ngngwa heta keteibe cai Asaph, pe ba zetle kesapbe. Asaph cai Berekiah napei. Berekiah cai Shimea napei. <verse eid="1CH 6:39" /><verse number="40" style="v" sid="1CH 6:40" />Shimea cai Michael napei. Michael cai Baaseiah napei. Baaseiah cai Malkijah napei. <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />Malkijah cai Ethni napei. Ethni cai Zerah napei. Zerah cai Adaiah napei. <verse eid="1CH 6:41" /><verse number="42" style="v" sid="1CH 6:42" />Adaiah cai Ethan napei. Ethan cai Zimmah napei. Zimmah cai Shimei napei. <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />Shimei cai Jahath napei. Jahath cai Gershon napei. Gershon cai Levi napei. <verse eid="1CH 6:43" /><verse number="44" style="v" sid="1CH 6:44" />Heman ba hile cai pecu ngngwa heta keteime Merari napeime. Cidungde ga kebamme cai Kishi napei Ethan. Kishi cai Abdi napei. Abdi cai Malluk napei. <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />Malluk cai Hashabiah napei. Hashabiah cai Amaziah napei. Amaziah cai Hilkiah napei. <verse eid="1CH 6:45" /><verse number="46" style="v" sid="1CH 6:46" />Hilkiah cai Amzi napei. Amzi cai Bani napei. Bani cai Shemer napei. <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />Shemer cai Mahli napei. Mahli cai Mushi napei. Mushi cai Merari napei. Merari cai Levi napei.<verse eid="1CH 6:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />Penui ngngwa heta keteime, Levime de cai Tinggwang kerecaki paiki ziemne heta pelane tei kera nlum beudi. <verse eid="1CH 6:48" /><verse number="49" style="v" sid="1CH 6:49" />Aaron nah pe leuhme keru recabam gage nah kehengui reca bam gage recadung teigai beula, heni mcitu ga heta pelane ziemne. Aipau recadung de Israel maudung ziemne gibeu kela recadung, Moses Tinggwang kilabe ne sam kai kebeu pelane nzwa eh teila. <verse eid="1CH 6:49" /><verse number="50" style="v" sid="1CH 6:50" />Aaron leuhme riadung cai ainzwa: Aaron napei cai Eleazar. Eleazar napei cai Phinehas. Phinehas napei cai Abishua. <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />Abishua napei cai Bukki. Bukki napei cai Uzzi. Uzzi napei cai Zerahiah. <verse eid="1CH 6:51" /><verse number="52" style="v" sid="1CH 6:52" />Zerahiah napei cai Meraioth. Meraioth napei cai Amariah. Amariah napei cai Ahitub. <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />Ahitub napei cai Zadok. Zadok napei cai Ahimaaz. <verse eid="1CH 6:53" /><verse number="54" style="v" sid="1CH 6:54" />Aipau nidung de Aaron leuhme de lungh kera kepeu dung, cide cai, Aaron leuhme Kohath pautsame gade kegwangme ziemne (dacak raitube penui gu). <verse eid="1CH 6:54" /><verse number="55" style="v" sid="1CH 6:55" />Penuide penui Judah deu ga Hebron nah twagwa kebam tsehei deudung de pwapeu. <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />Dede namdi luhdung nah renamdung de au penui Jephunneh napei Caleb de peudi.<verse eid="1CH 6:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="1CH 6:57" />Penui Aaron leuhme de aipau nam dungde peu: Hebron (kensiu namdi ge), Libnah nah pe tseheideu dungde, Jattir, Eshtemoa nah pe tseheideu dungde. <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />Hilen nah pe tseheideu dungde, nah Debir nah pe tseheideu dungde. <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />Penui Aaron leuhme de de aidung de peu: Ashan nah pe tseheideudung, Juttah,<note caller="+" style="f"><char style="ft" closed="false">Heni zi </char><char style="fqa">Juttah de </char> MT ga ngaulu ma dede Syriac laisiu ga bam; Joshua 21:16 gade ngau lubui. </note> nah Beth Shemesh nah pe tseheideu dungde; <verse eid="1CH 6:59" /><verse number="60" style="v" sid="1CH 6:60" />nah Benjamin leuhme gade, Geba nah pe tseheideu dungde, Alemeth nah pe tseheideu dungde nah Anathoth nah pe tseheideu dungde.</para>
  <para style="q" vid="1CH 6:60">Penui pautsa lungh kera penui namdidung pelane ge namdi kereiehkecum.<verse eid="1CH 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="1CH 6:61" />Kohath pautsa keda pelane de Manasseh leuh pempie deu gade dacak tei eh namdidung kerei peudi. <verse eid="1CH 6:61" /><verse number="62" style="v" sid="1CH 6:62" />Gershon leuhme, penui pautsa ketsam tsam de, Issachar, Asher, Naphtali leuhdung gade nah Bashan ga Manasseh leuh pempie namdidung kereiehkecum peu di. <verse eid="1CH 6:62" /><verse number="63" style="v" sid="1CH 6:63" />Merari leuhme de penui pautsa ge nah pautsa ge eh, Reuben, Gad nah Zebulun leuhmedung deu gade namdidung kereiehkena peudi. <verse eid="1CH 6:63" /><verse number="64" style="v" sid="1CH 6:64" />Cine Israelme aipau namdidung de penui twagwapung kebam tseheideu dung desi eh Levime de peudi. <verse eid="1CH 6:64" /><verse number="65" style="v" sid="1CH 6:65" />Penui dacak tei eh nreule raupwa kebam namdi dungde Judah, Simeon, nah Benjamin leuhme deu gade peudi. <verse eid="1CH 6:65" /><verse number="66" style="v" sid="1CH 6:66" />Kohathme pautsa kangge de Ephraim leuhme deu gade namdidung peudi. <verse eid="1CH 6:66" /><verse number="67" style="v" sid="1CH 6:67" />Penuide aidungde peudi: hangdeutu nam Ephraim gade Shechem (kensiu namdi ge) nah pe tseheideu dungde, Gezer nah pe tseheideu dungde, <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />Jokmeam nah pe tseheideu dungde, Beth Horon nah pe tseheideu dungde, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />Aijalon nah pe tseheideu dungde, nah Gath Rimmon nah pe tseheideu dungde. <verse eid="1CH 6:69" /><verse number="70" style="v" sid="1CH 6:70" />Manasseh leuh pempie Kohathme de Aner nah pe tseheideu dungde nah Bileam nah pe tseheideu dungde peudi. Aidungde Kohath pautsa keda pelane gudi. <verse eid="1CH 6:70" /><verse number="71" style="v" sid="1CH 6:71" />Gershon leuhme de Manasseh leuh pempie pautsa deu gade, penui Bashan ga Golan nah pe tseheideu dungde nah Ashtaroth nah pe tseheideu dungde peudi. <verse eid="1CH 6:71" /><verse number="72" style="v" sid="1CH 6:72" />Issachar leuhme Gershon leuhme de Kedesh nah pe tseheideu dungde, Daberath nah pe tseheideu dungde peudi, <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />Ramoth nah pe tseheideu dungde, nah Anem nah pe tseheideu dungde. <verse eid="1CH 6:73" /><verse number="74" style="v" sid="1CH 6:74" />Issachar leuhme Asher leuhme dade aidungde ngaulu: Mashal nah pe tseheideu dungde, Abdon nah pe tseheideu dungde, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />Hukok nah pe tseheideu dungde, nah Rehob nah pe tseheideu dungde. <verse eid="1CH 6:75" /><verse number="76" style="v" sid="1CH 6:76" />Penui Naphtali leuhme dade aidungde ngaulu: Galilee ga Kedesh nah pe tseheideu dungde, Hammon nah pe tseheideu dungde, nah Kiriathaim nah pe tseheideu dungde.<verse eid="1CH 6:76" /></para>
  <para style="p">
    <verse number="77" style="v" sid="1CH 6:77" />Merari leuhme keda pelane Zebulun leuhme dade renam aidungde ngaulu: Jokneam, Kartah,<note caller="+" style="f"><char style="ft" closed="false">Jokneam </char><char style="fqa">nah </char> Kartah <char style="fqa">de kecu zi de</char> MT ga gah dede LXX ga bam. Jos. 21:34 de pie keda lubui. </note> nah Rimmono nah pe tseheideu dungde nah Tabor nah pe tseheideu dungde; <verse eid="1CH 6:77" /><verse number="78" style="v" sid="1CH 6:78" />Reuben leuhme dade Jericho gwale Jordan reu naimiak kepetlebie gade, penui kideu ketsai ga Bezer, Jahzah ngaulu, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />Kedemoth nah pe tseheideu dungde, nah Mephaath nah pe tseheideu dungde. <verse eid="1CH 6:79" /><verse number="80" style="v" sid="1CH 6:80" />Levime Gad leuhme dade aipau deudung de ngaulu: Gilead ga Ramoth nah pe tseheideu dungde, Mahanaim nah pe tseheideu dungde, <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />Heshbon nah pe tseheideu dungde, nah Jazer nah pe tseheideu dungde.<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s">Issachar napeidung</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 7:1" />Issachar napei hangmdai cai Tola, Puah, Jashud, nah Shimron. <verse eid="1CH 7:1" /><verse number="2" style="v" sid="1CH 7:2" />Tola napeidung cai Uzzi, Rephaiah, Jeriel, Jahmai, Ibsam, nah Samuel. Penui au penui pautsa kelakdung peuteube da, Tola dade lungkelu leuh nah penuide penui ceheu gade reugwa kenlangme ge liede la. David tingdau penui mina 22,600 ge bam. <verse eid="1CH 7:2" /><verse number="3" style="v" sid="1CH 7:3" />Uzzi napei cai Izrahiah. Pe napeidung cai Michael, Obadiah, Joel, nah Ishijah, penui hangmengei pelane pautsa muiteume. <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />Cidungde de si eh penui hereu tei kerane mina cang camreiehherok bam, penui leuhme pautsa da kebam ria nzwa, kedanemene penui penui naudung nah hename kiee süt kecune. <verse eid="1CH 7:4" /><verse number="5" style="v" sid="1CH 7:5" />Issachar pautsa pelane gade penui kibaume au hereu teilu kebuime, nah penui pelane ge, cang riakheset-hena reugwame bam, penui pautsa ria ga kela.<verse eid="1CH 7:5" /></para>
  <para style="s">Benjamin napeidung</para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 7:6" />Benjamin napei hangcum cai Bela, Beker, nah Jediael. <verse eid="1CH 7:6" /><verse number="7" style="v" sid="1CH 7:7" />Bela napei hangmengei cai Ezbon, Uzzi, Uzziel, Jerimoth, nah Iri. Penui au reugwame nah pautsa kelak peume. Penui regi lu kebui mina 22,034 bam, penui leuhme pautsa da kebam ria gade. <verse eid="1CH 7:7" /><verse number="8" style="v" sid="1CH 7:8" />Beker name cai Zemirah, Joash, Eliezer, Elioenai, Omri, Jeremoth, Abijah, Anathoth, nah Alemeth. Aidungde peciakne de pe napeidung da. <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />Penui pautsame riak raupwa kebam pautsa kelak peume nah regi kerame mina 20,200 bam. <verse eid="1CH 7:9" /><verse number="10" style="v" sid="1CH 7:10" />Jediael napei Bilhan. Bilhan napeidung cai Jeush, Benjamin, Ehud, Kenaanah, Zethan, Tarshish, nah Ahishahar. <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />Aidungde peciakne de Jediael napeidung. Penui pautsa riak ga kelak peume nah regi kerame reugwa ta teilu kebuime raupwa kela cai 17,200. <verse eid="1CH 7:11" /><verse number="12" style="v" sid="1CH 7:12" />(Shuppimme nah Huppimme cai Ir name, nah Hushimme cai Aher name.)<verse eid="1CH 7:12" /></para>
  <para style="s">Naphtali napeidung</para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 7:13" />Naphtali napeidung cai Jahziel, Guni, Jezer, nah Shillem. Penui Bilhah camedung.<verse eid="1CH 7:13" /></para>
  <para style="s">Manasseh napeidung</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 7:14" />Manasseh pena mipeina ge pezi Asriel lie kecu bam, pe nauseupui Aramean mepui ne mna kebeube. Pa ne Gilead pei, Makir dede mna beu. <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />Makir Huppimme nah Shuppimme kakga de penau ge teilu. Sinabe pui zi cai Maakah. Manasseh leuh kedage cai Zelophehad, pa pena mipuinadung gwala gah. <verse eid="1CH 7:15" /><verse number="16" style="v" sid="1CH 7:16" />Maakah, Makir nau, mipeina ge mna lu nah pa pecu Peresh lie qulu. Pe sinabe zi cai Sheresh, nah pe napei kena cai Ulam penai Rakem. <verse eid="1CH 7:16" /><verse number="17" style="v" sid="1CH 7:17" />Ulam napei cai Bedan. Aidungde Makir napei Gilead, Manasseh napei leuhme. <verse eid="1CH 7:17" /><verse number="18" style="v" sid="1CH 7:18" />Gilead tipui Hammoleketh, Ishhod, Abiezer, nah Mahlah de mnalu. <verse eid="1CH 7:18" /><verse number="19" style="v" sid="1CH 7:19" />Shemida napeidung cai Ahian, Shechem, Likhi, nah Aniam.<verse eid="1CH 7:19" /></para>
  <para style="s">Ephraim napeidung</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 7:20" />Ephraim leuhme cai aidungde: Ephraim napei cai Shuthelah. Shuthelah napei cai Bered. Bered napei cai Tahath. Tahath napei cai Eleadah. Eleadah napei cai Tahath. <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />Tahath napei cai Zabad. Zabad napei cai Shuthelah. (Ezer nah Elead de Gath ga kelunghme deuketme ne penai cika penui kaune rega kera mie kecudau teitsetdi. <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />Penai pei Ephraim penai ziemne tingbazie kekiee ge hap bamdi, nah pe siname pelung taumla kerane gwang. <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />Pa penau de ngngwa nauhepeizai teidi. Penau tetlak lu nah mipeina ge mnalu. Ephraim pecu Beriah lie qulu, kedanemene lungrei pe kelak ga kegwang ziemne.) <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />Pe napui cai Sheerah, Beth Horon Nreube nam nah Nkangbe nam nah Uzzen Sheerah nam de tei kegaibe pui. <verse eid="1CH 7:24" /><verse number="25" style="v" sid="1CH 7:25" />Pe napei cai Rephah. Rephah napei cai Resheph. Resheph napei cai Telah. Telah napei cai Tahan. <verse eid="1CH 7:25" /><verse number="26" style="v" sid="1CH 7:26" />Tahan napei cai Ladan. Ladan napei cai Ammihud. Ammihud napei cai Elishama. <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />Elishama napei cai Nun. Nun napei cai Joshua.<verse eid="1CH 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 7:28" />Penui mabamdung nah kidung cai Bethel nah twagwapung kebam namdung de. Penui naimiak kepetle bie Naaran ga nah naimiak kenlütle Gezer ga nah twagwapung kebam namdung, nah Shechem ga nah cide twagwapung kebam namdung gade Ayyah ga nah cide twagwapung kebam namdung ga kecang lunghdi. <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />Manasseh de herai kebam dung cai Beth Shan nah twagwapung kebam namdung, Taanach nah twagwapung kebam namdung, Megiddo nah twagwapung kebam namdung, Dor nah twagwapung kebam namdung. Namdi aidungde ga Israel napei Joseph leuhme lungh.<verse eid="1CH 7:29" /></para>
  <para style="s">Asher napeidung</para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 7:30" />Asher napeidung cai Imnah, Ishvah, Ishvi, nah Beriah. Penui tipui cai Serah. <verse eid="1CH 7:30" /><verse number="31" style="v" sid="1CH 7:31" />Beriah napei cai Heber nah Malkiel, pa au Birzaith pei. <verse eid="1CH 7:31" /><verse number="32" style="v" sid="1CH 7:32" />Heber napeidung cai Japhlet, Shomer, nah Hotham. Shua cai penui tipui. <verse eid="1CH 7:32" /><verse number="33" style="v" sid="1CH 7:33" />Japhlet napeidung cai Pasak, Bimhal, nah Ashvath. Aidungde Japhlet name. <verse eid="1CH 7:33" /><verse number="34" style="v" sid="1CH 7:34" />Japhlet sinabe, Shomer name cai: Ahi, Rohgah, Hubbah, nah Aram. <verse eid="1CH 7:34" /><verse number="35" style="v" sid="1CH 7:35" />Shemer sinabe, Helem, pe na mipei hangmdai bam: Zophah, Imna, Shelesh, nah Amal. <verse eid="1CH 7:35" /><verse number="36" style="v" sid="1CH 7:36" />Zophah napeidung cai Suah, Harnepher, Shual, Beri, Imrah, <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />Bezer, Hod, Shamma, Shilshah, Ithran, nah Beera. <verse eid="1CH 7:37" /><verse number="38" style="v" sid="1CH 7:38" />Jether napeidung cai Jephunneh, Pispah, nah Ara. <verse eid="1CH 7:38" /><verse number="39" style="v" sid="1CH 7:39" />Ulla napeidung cai Arah, Hanniel, nah Rizia. <verse eid="1CH 7:39" /><verse number="40" style="v" sid="1CH 7:40" />Aidungde pelane Asher leuhme. Penui cai pautsa paumedung, penui au kelak peumedung, muiteu kendume, hereuketei keyime, nah muiteume reu kedibe. Reugwa ta teilu kebuime mina cang ngkaiehherok pei mpetlu, penui riak rau kenzeu rehi gade.<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s">Benjamin leuh Saul kiria</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 8:1" />Benjamin napeidung hangmengei cai, pe neraibe Bela, Ashbel, Aharah, <verse eid="1CH 8:1" /><verse number="2" style="v" sid="1CH 8:2" />Nohah, nah Rapha. <verse eid="1CH 8:2" /><verse number="3" style="v" sid="1CH 8:3" />Bela napeimedung cai Addar, Gera, Abihud, <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />Abishua, Naaman, Ahoah, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />Gera, Shephuphan, nah Huram. <verse eid="1CH 8:5" /><verse number="6" style="v" sid="1CH 8:6" />Aidungde Ehud leuhme pautsa peumedung Geba nam ga kelunghme, penuide kemei tei eh gwadi eh Manahath ga lunghdi: <verse eid="1CH 8:6" /><verse number="7" style="v" sid="1CH 8:7" />Naaman, Ahijah, nah Gera. Kamtube, Gera, penui ketet ga penuide ngngwa tet. Pa au Uzza penai Ahihud pei. <verse eid="1CH 8:7" /><verse number="8" style="v" sid="1CH 8:8" />Shaharaim Moab deu gade hename lunglu, Pa pe nau kena Hushim penai Baara de ta kedi cai. <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />Pe nau Hodesh ne, Shaharaim de aidungde lungbeu, Jobab, Zibia, Mesha, Malkam, <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />Jeuz, Sakia, nah Mirmah. Aidungde pe napeidung, pautsa kelak peumedung. <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />Pa Hushim dade pena Abitub penai Elpaal lunglu. <verse eid="1CH 8:11" /><verse number="12" style="v" sid="1CH 8:12" />Elpaal napeimedung cai Eber, Misham, nah Shemed (Shemed ne Ono nah Lod taiga renamdung twagwapung kebam de teigai). <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />Beriah penai Shema de bam. Penai Aijalon nam ga lungh kebamme, Gath ga kelunghme de gwa kedime pautsa kelak peume. <verse eid="1CH 8:13" /><verse number="14" style="v" sid="1CH 8:14" />Beriah pe napeidung aidungde bam: Ahio, Shashak, Jeremoth, <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />Zebadiah, Arad, Eder, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />Michael, Ishpah, nah Joha cai Beriah napeimedung. <verse eid="1CH 8:16" /><verse number="17" style="v" sid="1CH 8:17" />Zebadiah, Meshullam, Hizki, Heber, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />Ishmerai, Izliah, nah Jobab cai Elpaal napeimedung. <verse eid="1CH 8:18" /><verse number="19" style="v" sid="1CH 8:19" />Jakim, Zikri, Zabdi, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />Elienai, Zillethai, Eliel, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />Adaiah, Beraiah, nah Shimrath cai Shimei napeimedung. <verse eid="1CH 8:21" /><verse number="22" style="v" sid="1CH 8:22" />Ishpan, Eber, Eliel, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />Abdon, Zikri, Hanan, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />Hananiah, Elam, Anthothijah, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />Iphdeiah, nah Penuel cai Shashak napeimedung. <verse eid="1CH 8:25" /><verse number="26" style="v" sid="1CH 8:26" />Shamsherai, Shehariah, Athaliah, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />Jaareshiah, Elijah, nah Zikri cai Jeroham napeimedung. <verse eid="1CH 8:27" /><verse number="28" style="v" sid="1CH 8:28" />Aidungde pautsa kelak peumedung nah mina kemlangme Jerusalem ga kelunghmedung.<verse eid="1CH 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 8:29" />Gibeon pei, Jeiel, pe nau zi cai Maakah, Gibeon ga lungh bamla. <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />Pe neraibe cai Abdon, kedamedung cai Zur, Kish, Baal, Nadab, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />Gedor, Ahio, nah Zeker. <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />Jeiel napei kedabe cai Mikloth, pa au Shimeah pei. Penui de penui kibaume taiga Jerusalem ga lunghdi. <verse eid="1CH 8:32" /><verse number="33" style="v" sid="1CH 8:33" />Ner cai Kish pei. Kish cai Saul pei. Saul cai Jonathan pei, Malki-Shua, Abinadab, nah Esh-Baal. <verse eid="1CH 8:33" /><verse number="34" style="v" sid="1CH 8:34" />Jonathan napei cai Merib-Baal. Merib-Baal cai Micah pei. <verse eid="1CH 8:34" /><verse number="35" style="v" sid="1CH 8:35" />Micah napeidung cai Pithon, Melek, Tarea, nah Ahaz. <verse eid="1CH 8:35" /><verse number="36" style="v" sid="1CH 8:36" />Ahaz au Jehoaddah pei. Jehoaddah cai Alemeth, Azmaveth, nah Zimri pei. Zimri cai Moza pei. <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />Moza cai Binea pei. Binea cai Raphah pei. Raphah cai Eleasah pei. Eleasah cai Azel pei. <verse eid="1CH 8:37" /><verse number="38" style="v" sid="1CH 8:38" />Azel pe na mipeina hangherok bam: Azrikam, Bokeru, Ishmael, Sheariah, Obadiah, nah Hanan. Aidungde pelane Azel napeidung. <verse eid="1CH 8:38" /><verse number="39" style="v" sid="1CH 8:39" />Pe sinabe, Eshek napeimedung cai, pe neraibe Ulam, pe kenabe Jeush, nah pe kecumbe Eliphelet. <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />Ulam napeimedung au reugwa keyime nah lakpi kepwame. Penui napeidung nah pe tsapeidung kekieege bam, pelane ge 150. Aidungde pelane Benjamin leuhme.<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="s">Jerusalem ga minadung</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />Cine Israelme pelane paupak rehi gade penui zi raupwala. Aidungde Israel gwangpeidung laisiukwak gage raupwala. Judahme cai, penui maudung ziemne saja tei eh penui de Babylon gage lang gidi. <verse eid="1CH 9:1" /><verse number="2" style="v" sid="1CH 9:2" />Penui namdidung ga cailigwang raitume cai Israelme kangge, cingkume, Levime, nah kerecaki kilame. <verse eid="1CH 9:2" /><verse number="3" style="v" sid="1CH 9:3" />Judah, Benjamin, Ephraim, nah Manasseh leuhdung kangge Jerusalem ga lunghdi. <verse eid="1CH 9:3" /><verse number="4" style="v" sid="1CH 9:4" />Cika lungh kelame, Judah napei Perez leuhme ge Ammihud napei Uthai, Omri napei, Imri napei, Bani napei de si. <verse eid="1CH 9:4" /><verse number="5" style="v" sid="1CH 9:5" />Shelah leuhme kakgade cai neraibe Asaiah nah pe namedung. <verse eid="1CH 9:5" /><verse number="6" style="v" sid="1CH 9:6" />Zerah leuhme kakgade cai Jeuel. Penui leuhme 690 kieege. <verse eid="1CH 9:6" /><verse number="7" style="v" sid="1CH 9:7" />Benjamin leuhme kakgade cai Meshullam napei Sallu, Hodaviah napei, Hassenuah napei. <verse eid="1CH 9:7" /><verse number="8" style="v" sid="1CH 9:8" />Jeroham napei Ibneiah de la; Elah Uzzi napei Mikri napei; nah Shephatiah napei Meshullam, Reuel napei Ibnijah napei. <verse eid="1CH 9:8" /><verse number="9" style="v" sid="1CH 9:9" />Penui kibaumedung paupak ria ga raupwa keladung 956. Mina aidungde pelane de penui pautsa ziemne penui pautsa kelak peumedung.<verse eid="1CH 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 9:10" />Cingkupeidung cai Jedaiah, Jehoiarib, nah Jakin. <verse eid="1CH 9:10" /><verse number="11" style="v" sid="1CH 9:11" />Cika Tinggwang ki rengei kelame cai Hilkiah napei Azariah, Zadok napei Meshullam napei, Meraioth napei, Ahitub napei de si. <verse eid="1CH 9:11" /><verse number="12" style="v" sid="1CH 9:12" />Jeroham napei Adaiah, Pashhur tsapei Malkijah tsapei de bam. Adiel napei Maasai Jahzerah tsapei Meshullam tsapei Meshillemith tsapei Immer tsapei de bam. <verse eid="1CH 9:12" /><verse number="13" style="v" sid="1CH 9:13" />Penui kibaume, penui pautsa kelakdung muiteume 1,760 kieege. Penui au Tinggwang kerecaki ga bata tei cisüt kecume.<verse eid="1CH 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 9:14" />Levime kakga, Merari leuhme kakga de Hasshub napei Shemaiah Azrikam tsapei Hashabiah tsapei de bam. <verse eid="1CH 9:14" /><verse number="15" style="v" sid="1CH 9:15" />Bakbakkar, Heresh, Galal, nah Mattaniah Mika napei Zikri napei Asaph napei de si. <verse eid="1CH 9:15" /><verse number="16" style="v" sid="1CH 9:16" />Shemaiah napei Obadiah Galal napei Jeduthun napei de bam; nah Asa napei Berekiah Elkanah tsapei, pa Netophathme namdung ga lunghla.<verse eid="1CH 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 9:17" />Kimuiki kekwame cai Shallum, Akkub, Talmon, Ahiman, nah penui leuhme. Penui muiteume cai Shallum. <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />Pedwa dau penui hegwangpei rieki ga naimiak kepetle bie Levi leuhme ramzeuki ga sap kwabam la. <verse eid="1CH 9:18" /><verse number="19" style="v" sid="1CH 9:19" />Kore napei Shallum Ebiasaph tsapei, <note caller="+" style="f"><char style="ft" closed="false">Ebiasaph de 1 Heleuhbe 26:1 ga </char><char style="fqa">Asaph </char> de eh rang kebam de de rangbam. </note> Korah napei, nah pe pei kibaumedung, Korah pautsame, kimui kwa kecu de penui ndwazie. Penui paiki kimui de kwa bam la, penui paume RAMPAUBE ramzeuki kwa bam, nah penui kimui de kwabam kela nzwa. <verse eid="1CH 9:19" /><verse number="20" style="v" sid="1CH 9:20" />Eleazar napei Phinehas ndaa penui de pie rengei gwang, nah RAMPAUBE pecu ngngwa bam la. <verse eid="1CH 9:20" /><verse number="21" style="v" sid="1CH 9:21" />Meshelemiah napei Zechariah paiki kimui ga kekwame ge teigwang. <verse eid="1CH 9:21" /><verse number="22" style="v" sid="1CH 9:22" />Kimuidung nah heriekidung kekwame tei kera kedet kelume pelane ge 212. Penui lungh kebam namdung ria gade penui zi raulu. David nah caihakecibe Samuel ne penuide penui hepüt kepung kenlum ni aikadung gage kailu. <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />Cine penui nah penui leuhme RAMPAUBE ki kelüt riekidung kwalu, RAMPAUBE kebam paiki de. <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />Herieki kekwame lule ailam tu mdai ga kai pwabam, naimiak kepetle bie, naimiak kenlütle, tingpeule, nah tingbangle bie. <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />Penui kibaume, penui namdung ga lungh kebamme, penui mlia tei eh langhenane ziemne kekwa ta teigwang. <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />Dede Levime, kekwa muiteume hangmdai de cai, kibungdung nah Tinggwang ki ga maniadung kekai bungdung de kwa kera penui ziela. <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />Penui penui kekwa bam Tinggwang ki tu leune ga tingmuiziu nggwang la, kedanemene cide kwa kera penui zie kecune. Penui tingcang ramsang heriekidung ngkeila.<verse eid="1CH 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />Kangge kerecaki ga teu kela lidung de rengei la; penui li dungde keunlüt kecudau nah cidungde keu mpet cudau peila. <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />Penui kesame ne mania kemci kedadung, teu kela lidung, nah kai kenzeu keladung, tokkui, zau, maca, kehengui, nah mosaladung si eh pie rengei la. <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />Cingkume name kangge mosaladung ruiza kecu ta teila. <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />Levime ge, Mattithiah, pa Korah pautsame Shallum napei cingtube, recadung ziemne tangku telei kera pe ziela. <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />Penui siname kangge, Kohath leuhme, Sabbath ramsangme taktyei bam ga kemci tangku de rengei kera penui ziela.<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />Lei keteime nah Levime pautsa kelak peumedung kerecaki ga kibungdung ga lunghla penui heta gade mtak kebamdau, kedanemene penui tingmui tingba penuide nlum kebeu ta teimai kesiane. <verse eid="1CH 9:33" /><verse number="34" style="v" sid="1CH 9:34" />Aidungde Levime kakga de pautsa kelak muiteumedung, kedimedung, penui paupak ha ga rauteu kela nzwa. Penui Jerusalem ga lunghla.<verse eid="1CH 9:34" /></para>
  <para style="s">Saul kiria</para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 9:35" />Gibeon pei Jeiel, pe nau zi cai Maakah, pa Gibeon ga lunghla. <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />Pe neraibe cai Abdon, pecai pe napeidung cai Zur, Kish, Baal, Ner, Nadab, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />Gedor, Ahio, Zechariah, nah Mikloth. <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />Mikloth cai Shimeam pei. Penui de Jerusalem ga penui siname taiga lungh. <verse eid="1CH 9:38" /><verse number="39" style="v" sid="1CH 9:39" />Ner cai Kish pei. Kish cai Saul pei. Saul cai Jonathan, Malki-shua, Abinadab, nah Esh-Baal pei. <verse eid="1CH 9:39" /><verse number="40" style="v" sid="1CH 9:40" />Jonathan napei cai Merib-Baal. Merib-Baal cai Micah pei. <verse eid="1CH 9:40" /><verse number="41" style="v" sid="1CH 9:41" />Micah napeidung cai Pithon, Melek, Tahrea, nah Ahaz. <verse eid="1CH 9:41" /><verse number="42" style="v" sid="1CH 9:42" />Ahaz cai Jadah pei. Jadah cai Alemeth, Azmaveth, nah Zimri pei. Zimri cai Moza pei. <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />Moza cai Binea pei. Binea cai Rephaiah pei. Rephaiah cai Eleasah pei. Eleasah cai Azel pei. <verse eid="1CH 9:43" /><verse number="44" style="v" sid="1CH 9:44" />Azel napeidung hang herokdung cai, Azrikam, Bokeru, Ishmael, Sheariah, Obadiah, nah Hanan. Aidung de Azel napeidung.<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s">Saul pecu teitset kedi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />Philistinme Israelme de ngngwa regi di. Israelme pelane Philistinme dwa gade pakdi nah Gilboa Deutu gade kau mie tsaidi. <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />Philistinme Saul nah pe napei de gwaketang mna sütdi. Philistinme ne pe namedung Jonathan, Abinadad, nah Malki-Shua de teitset di. <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />Saul taiga hereu ngking sütdi, nah lakpi kepwame pereu ngamlu, nah penui pecu tei rezam di. <verse eid="1CH 10:3" /><verse number="4" style="v" sid="1CH 10:4" />Pecai Saul pe reunet pwa kelabe dage rangdi, “N kingtie züt lwe cide a reu gage kui gailo. Meliecai, hegeurum kemakmedung ne gwang lwe acu teikeherei zielu.” Dede pe reunet kepwabe de cide tei raudi, kedanemene pa au hing süt kedine. Cine Saul pe kingtie züt lwe cipau reu gage kau mie gaidi. <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />Cidau pe reunet kepwabe Saul tsai kedi ngaulu ge, cinzwa pade pe kingtie reu ga kau zeu eh tsaidi. <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />Cine Saul tsai di, nah pe napei hangcum, ciu eh pe kilungme peciakne ngngwa tsaidi.<verse eid="1CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7" />Israelme langkam kelungh leune penui pak kedi, nah Saul nah pe namedung tsaikap kedi ngau luge, penui penui namdidung pütdi delwe pakdi. Ge Philistinme gwang eh cidungde ga lunghdi. <verse eid="1CH 10:7" /><verse number="8" style="v" sid="1CH 10:8" />Cinzwa eh pecai benai, Philistinmedung ketsai pau kecung kera gwang kecu dau, Saul nah pe namedung Gilboa Deutu ga kau zeu kebam penui ngaulu. <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />Penui peniadung ralu delwe pe peu nah pe reunetdung keulu. Penui Philistia leune ga samlia keyi de penui gu mamiedung nah minadung dage pung zang kera samgwamedung de langgai. <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />Penui pe reunetdung penui rabe ki gage kailu, nah Dagon kerecaki gage pepeu kezulu. <verse eid="1CH 10:10" /><verse number="11" style="v" sid="1CH 10:11" />Jabesh Gilead ga mina pelane Philistinme Saul dage tei kedidung siu luge, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />reugwamedung pelane mie Saul paau nah pe namedung de pwa tetdi nah penui de Jabesh ga ngngwa gwanglu. Penui mhu bang kangga ge penui raadung kungdi, delwe lang henane mmwang bamdi.<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />Cine Saul pa RAMPAUBE dade samsanglu kemakne tsaidi. Pa RAMPAUBE rang kebeudung mzai ma, dede mige ketsaime de ngngwa mpau kelame dade puisau keteu. <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />Pa au RAMPAUBE dade puisau keteu ma, cine RAMPAUBE pecu teitset di, delwe hegwangbam Jesse napei David de peudi.<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s">David Israel gwangpei teikedi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />Cidau Israelme pelane Hebron ga David da gwang eh rangdi, “Pielo, anui au n teih nah n ra lie. <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />Ndaa pedwa, Saul anui reu hegwang tei kebam dau, nang ne Israel reugwame de teuswa beu. RAMPAUBE n Tinggwang n dage rangdi, ‘Nang a mina Israel meurün kekwabe tei zie, nah nang a mina Israelme reu hegwang tei zie.’” <verse eid="1CH 11:2" /><verse number="3" style="v" sid="1CH 11:3" />Cine Israel ga hangkiamedung pelane Hebron ga hegwangpei da gwang, nah David RAMPAUBE dwa gade penuide ngngwa samkaklu. Penui David de Israelme reu gwangpei kera keniaklu. Ainzwa eh, RAMPAUBE sam Samuel dage rang kebeu de tei gwang kesanglu.<verse eid="1CH 11:3" /></para>
  <para style="s">David Jerusalem gwakelu</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />David nah Israelme pelane Jerusalem (cide Jebus) ga miedi. Cu Jebusme, hangdeu cika lungh kebamme cika bam. <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />Jebus ga kelunghme David dade rangdi, “Nang madau de aika lüt gailak.” Dede David Zion kengkiengbam de tuilu, nah cide cai, David namdi. <verse eid="1CH 11:5" /><verse number="6" style="v" sid="1CH 11:6" />David rangdi, “Jebusme de regi raitu kelube de peu muibe nah kedibe tei zie.” Cine Joab napei Zeruiah ne gwaketang raitu lu, cine pecu peu reugwamaa reu kedibe teilu. <verse eid="1CH 11:6" /><verse number="7" style="v" sid="1CH 11:7" />Ge David kengkiengbam de ga lunghdi. Cine penui cide David namdi lie qudi. <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />Pa Millo gade twagwa kebam rieki pelane kecang de namdi tei tegwalu. Joab namdi keda pelane retak dailu. <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />David ngkieng reureu di kedanemene kengkieng RAMPAUBE pecu ngngwa kelane.<verse eid="1CH 11:9" /></para>
  <para style="s">David gu reugwame ngkiengtume</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />Aidungde David da kebam muiteumedung, Israelme ziemne, Israelme pelane de ngngwa, pe hegwangram ga ngha kegaime, pecu peu hegwang teilu kerane, RAMPAUBE sam mzai eh. <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />Aidungde David gu mina kengkiengmedung zi: Hachmon leuhme pei Jashobeam, cai kedimedung reu muiteube. Pa piage pe ngei le mina haicum ge de teitset di. <verse eid="1CH 11:11" /><verse number="12" style="v" sid="1CH 11:12" />Pecai Ahoah pautsame, Eleazar napei Dodo, pa de ngkiengtume hangcum kakga de hangge. <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />Pas Dammim ga pa David de ngngwala nah cikade Philistinme hereu tei kerane ngkwalu, barley luh kebam ga, nah reugwame Philistinmedung dade pakdi. <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />Penui luh sum ga saplu. Penui cide kwa kwaklu nah Philistinme de bi ngkaudi nah RAMPAUBE penuide ngkieng kelu kedige le kelibeu.<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />Cidau muiteumedung camrei gade hangcum tsura ga David taiga nghung, Adullam tsupop ga. Philistinme reugwamaa Rephaim langkam ga ramzeuki tei pwa bam. <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />Cipau ting dau David pe kengkiengbam, tsupop ge ga bam, Philistinmedung Bethlehem ga ge penui ramzeuki tei keludau. <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />David dui teu neu sütdi eh rangdi, “Magade mige acu Bethlehem ga kebam tekwa gade dui sak kera peu liecai, herieki taiga kebam tekwa de gade!” <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />Cine kengkieng mina hangcum aidungde Philistinme reugwame de nia ketang lütlu eh Bethlehem tekwa, herieki ga kebam tekwa gade dui twaklu. Penui dui twaklu delwe cide David da pung gwang beu, dede pa cide sak laklie di. Meliene, pa cide RAMPAUBE dage rui gai beudi. <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />Ciu eh pa rangdi, “Peu madaude acu aikenzwa tei diso! Mina aidungde penui teilung kengngi gage kai kebeume jai Ih sak zieni?” Kedanemene penui penui teilung kengngi ga kai kedine, David cide sak laklie di. Aidungde kengkieng mipei hangcum batadung.<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />Hangcum kakga Joab sinabe Abishai ne muiteu teila. Pa piage mina haicum de ngngwa regi nah penui de teitsetdi. Pa de Hangcum de de ngngwa kemlangme ge di. <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />Penui Hangcum kakgade, pecu herüt peu kiee gwa eh penui reu muiteu teilu, pa penui kakgade ncüt melie de.<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />Jehoiada napei Benaiah au Kabzeel ga reugwa kekuume ge, pa heta kedi teigai. Pa Moabme pei Ariel napei kena de teitsetdi. Pa buising kei kebam ting dau hekwaki ga de hung eh hingho de de teitset di. <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />Pa Egyptme peide de teitset di, mina cipau de cubits mengei hu ge. Egyptme peide pe ngei deikim kenzwa ge bamla, dede pa hetuitie ge rünne pwalwe pe da hung. Pa Egyptme pei ba gade hengei de sütlu, delwe pecu pekatei pe hengei le teitsetdi. <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />Cidung de Jehoiada napei Banaiah kekuu batadung nah pa de mina kengkieng hangcum bau kakga silu. <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />Reugwame camrei de swa de pecu au rüt gwala, dede pecu mina kengkieng hangcum de nzwa rüt canglu ma. Dede David pecu peu pe pumkwame rengei kerane kailu.<verse eid="1CH 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 11:26" />Mina kengkiengdung cai: Joab sinabe Asahel, Bethlehemme Dodo napei Elhanan. <verse eid="1CH 11:26" /><verse number="27" style="v" sid="1CH 11:27" />Harorme Shammoth, Pelonme Helez, <verse eid="1CH 11:27" /><verse number="28" style="v" sid="1CH 11:28" />Tekoame Ikkesh napei Ira, Anathothme Abiezer, <verse eid="1CH 11:28" /><verse number="29" style="v" sid="1CH 11:29" />Hushahme Sibbekai, Ahoahme llai, <verse eid="1CH 11:29" /><verse number="30" style="v" sid="1CH 11:30" />Netophathme Maharai, Netophathme Baanah napei Heled, <verse eid="1CH 11:30" /><verse number="31" style="v" sid="1CH 11:31" />Benjamin deu ga Gibeahme Ribai napei Ithai, Pirathonme Benaiah, <verse eid="1CH 11:31" /><verse number="32" style="v" sid="1CH 11:32" />Gaash langkamdung gade kegwangbe Hurai, Arbahme Abiel. <verse eid="1CH 11:32" /><verse number="33" style="v" sid="1CH 11:33" />Bahurumme Azmaveth, Shaalbonme Eliahba, <verse eid="1CH 11:33" /><verse number="34" style="v" sid="1CH 11:34" />Gizonme Hashem napeidung, Hararme Shagee napei Jonathan, <verse eid="1CH 11:34" /><verse number="35" style="v" sid="1CH 11:35" />Hararme Sakar napei Ahiam, Ur napei Eliphal, <verse eid="1CH 11:35" /><verse number="36" style="v" sid="1CH 11:36" />Mekerahme Hepher, Pelonme Ahijah, <verse eid="1CH 11:36" /><verse number="37" style="v" sid="1CH 11:37" />Carmelme Hezro, Ezbai napei Naarai, <verse eid="1CH 11:37" /><verse number="38" style="v" sid="1CH 11:38" />Nathan sinabe Joel, Hagri napei Mibhar, <verse eid="1CH 11:38" /><verse number="39" style="v" sid="1CH 11:39" />Ammonme Zelek, Beerothme Naharai (Zeruiah napei Joab reunet kepwabe), <verse eid="1CH 11:39" /><verse number="40" style="v" sid="1CH 11:40" />Ithrme Ira, Ithrme Gareb, <verse eid="1CH 11:40" /><verse number="41" style="v" sid="1CH 11:41" />Hittime Uriah, Ahlai napei Zabad, <verse eid="1CH 11:41" /><verse number="42" style="v" sid="1CH 11:42" />Reuben leuhme Adina napei Shiza (Reuben leuh de muiteube) nah pecu camrei nzangla, <verse eid="1CH 11:42" /><verse number="43" style="v" sid="1CH 11:43" />Maacah napei Hanan, nah Mithnme Joshaphat, <verse eid="1CH 11:43" /><verse number="44" style="v" sid="1CH 11:44" />Ashterahme Uzzia, Aroerme Hotham napei Shama penai Jeiel, <verse eid="1CH 11:44" /><verse number="45" style="v" sid="1CH 11:45" />Shimri napei Jediael, Joha (pe sinabe Tizme), <verse eid="1CH 11:45" /><verse number="46" style="v" sid="1CH 11:46" />Mahavahme Eliel, Elnaam napei Jeribai penai Joshaviah, Moabme Ithmah, <verse eid="1CH 11:46" /><verse number="47" style="v" sid="1CH 11:47" />Eliel, Obed, nah Mezobahme Jaasiel.<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s">Reugwame David da gwangkelu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />Mina aidungde Ziklag ga David da gwang kecume, pa Kish napei Saul dwade mbai la kecu dau. Penui au reugwamedung kakga de, hereu ga pecu kenghamedung. <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />Penui au lakpitsidung pwabam nah penui hile nah zetle ba gade lakpitsidung kap lula nah tangtsudungde sam lula. Penui au Benjamin leuhme, saul kibaumedung. <verse eid="1CH 12:2" /><verse number="3" style="v" sid="1CH 12:3" />Kedime cai Ahiezer, pecai Joash, Gibeahme Shemaah napei kena. Azmaveth napei, Jeziel penai Pelet de la. Anathothme Jehu, Berakah de sila, <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />Gibeahme Ishmaiah, hang camrei kakgade reugwame ge (nah camrei muiteube); Jeremiah, Jahaziel, Johanan, Gederahme Jozabad, <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />Eluzai, Jerimoth, Bealiah, Shemariah, Haruphme Shephatiah, <verse eid="1CH 12:5" /><verse number="6" style="v" sid="1CH 12:6" />Korahme Elkanah, Isshiah, Azarel, Joezer, Jashobeam, nah <verse eid="1CH 12:6" /><verse number="7" style="v" sid="1CH 12:7" />Joelah nah Zebadiah, Gedorme Jeroham napeidung.<verse eid="1CH 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />Gad leuhme kangge hetaideu ga kengkiengbam gade David de ncütlu. Penui au reugwa keyime ge, regi kera mtei kelume, hegeu nah hengei teu kecime; penui zudung au hinghodung zudung nzwa ngau hing. Penui au lamlwatu ga hetidung mzet kela nzwa mzet. <verse eid="1CH 12:8" /><verse number="9" style="v" sid="1CH 12:9" />Cika Ezer muiteube, Obadiah pe kenabe, Eliab pe kecumbe, <verse eid="1CH 12:9" /><verse number="10" style="v" sid="1CH 12:10" />Mishmannah pe mdaibe, Jeremiah pe mengeibe, <verse eid="1CH 12:10" /><verse number="11" style="v" sid="1CH 12:11" />Attai pe herokbe, Eliel pe henabe, <verse eid="1CH 12:11" /><verse number="12" style="v" sid="1CH 12:12" />Johanan pe hesetbe, Elzabad pe hekuibe, <verse eid="1CH 12:12" /><verse number="13" style="v" sid="1CH 12:13" />Jeremiah pe kereibe, Makbannai pe kereiehketbe la. <verse eid="1CH 12:13" /><verse number="14" style="v" sid="1CH 12:14" />Gad napei aidungde reugwame muiteumedung. Camtude mina haige de teuswa, nah ditube mina cang ge de teuswa. <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />Raitube kei dau penui Jordan kahlu, hereuki kung dui lwa pui kebam dau, nah chabak ga lungh kebamme pelane, naimiak kepetle bie de nah naimiak kenlütle de gwa gidi.<verse eid="1CH 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />Benjamin penai Judah leuhme kangge David kebam kengkiengbam ga gwanglu. <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />David penuide mie redau nah penui dage ranggai: “Nnui kezuyi gade acu ngha kera a da gwangla cai, nnui acu ncüt lubui. Dede nnui acu a ngauraume ba gage tuigai beu kera gwangla cai, peu anui paume Tinggwang de peu ngau eh nnui de kesiu lulo, kedanemene Ih magede tei mau melu.” <verse eid="1CH 12:17" /><verse number="18" style="v" sid="1CH 12:18" />Ge Amasai reu Rabe gwangdi, pa mina camrei reu kedibe. Amasai rangdi, “David, anui au ngu. Anui au n lam sap lie, Jesse napei. Kezuyi, peu ncu ngha kelame da kezuyi bam lulo. Peu ncu kenghamedung da kezuyi bam lo, kedanemene n Tinggwang ncu ngha bamlu.” Cidau David penuide luu kelu teilu nah penuide pe minadung reu muiteudung teilu.<verse eid="1CH 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />Manasseh leuh gade kangge David lambie gwang di, pa Saul de ngngwa regi kerane Philistinme de ngngwa pet kela dau. Dede penui Philistinme de ngha ma, kedanemene Philistinme kedimedung penui hangge ge de kesuizwa lwe David de langgi kedine. Penui rangdi, “Pa pe mpaube Saul lambie miedi eh anui teilung kerehim gage kai dizie.” <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />Pa Ziklag ga kemie dau, Manasseh leuh gade minadung pecu ncüt kelumedung cai Adnah, Jozabad, Jediael, Michael, Jozabad, Elihu, nah Zillethai, Manasseh leuh gade pecang reu kedimedung. <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />Penui David de ngha eh gwaketang kela maa de regi, kedanemene penui reugwamedung kecune. Pecai penui reugwame reu muiteume tei di. <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />Tingba ramsangne, mina David de ngha kera pe da gwang, reugwame kiee sütdi cu kecang, Tinggwang reugwame nzwa.<verse eid="1CH 12:22" /></para>
  <para style="s">Kedamedung Hebron ga David da gwangkelu</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23" />Aide hereu tei kerane reugwame mtei kelu rau kenzeu, Hebron ga David da gwang kelume, Saul gwangram tei keli pwa pe da kaidi kerane, RAMPAUBE pe sam pet kebeu nzwa. <verse eid="1CH 12:23" /><verse number="24" style="v" sid="1CH 12:24" />Judah leuh gade hereu ziemne mtei kelu, hegeu nah hengei kepwame cai 6,800. <verse eid="1CH 12:24" /><verse number="25" style="v" sid="1CH 12:25" />Simeon leuh gade cai mina 7,100 regi kerame bam. <verse eid="1CH 12:25" /><verse number="26" style="v" sid="1CH 12:26" />Levime gade cai mina 4,600 regi kerame bam. <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />Jehoiada au Aaron leuhmedung gu muiteube, nah pe da mina 3,700 bam. <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />Zadok rehang nage, ngkieng, nah kuusüt cu pei ge, pe da au pe pei kelak gade muiteumedung hang ngkaiehkena bam. <verse eid="1CH 12:28" /><verse number="29" style="v" sid="1CH 12:29" />Saul leuh, Benjamin gade cai cangcum. Cu kecang Penui kekiee ge Saul da masang eh lungh ladi. <verse eid="1CH 12:29" /><verse number="30" style="v" sid="1CH 12:30" />Ephraimme gade cai mina 20,800 regi kerame bam, penui au penui peimedung kelak gade kemlangme. <verse eid="1CH 12:30" /><verse number="31" style="v" sid="1CH 12:31" />Manasseh leuh pempie gade mina kemlangme cang kereieheset ge bam, David de hegwang teibeu kera gwang kecume. <verse eid="1CH 12:31" /><verse number="32" style="v" sid="1CH 12:32" />Issachar leuh gade, muiteume haina, Israel daipai tei maisia bi nah cide peting siakdau tei kera ci kebamme bam. Penui kibaume pelane penui kangga la. <verse eid="1CH 12:32" /><verse number="33" style="v" sid="1CH 12:33" />Zebulun leuh gade mina cang riakngei ge regi kerame, hereunet pelane teu hereu tei kera mtei kelume bam, nah penui kesamsang teipang teipop di kelak pwa peu kera mtei lu. <verse eid="1CH 12:33" /><verse number="34" style="v" sid="1CH 12:34" />Naphtali leuh gade kedime cang ge bam, nah penui da mina cang camreiehhena hegeudung nah hengeidung kepwame bam. <verse eid="1CH 12:34" /><verse number="35" style="v" sid="1CH 12:35" />Dan leuhme gade mina hereu tei kera mtei kelume 28,600 bam. <verse eid="1CH 12:35" /><verse number="36" style="v" sid="1CH 12:36" />Asher leuh gade mina hereu tei kera mtei kelume cang riakdai bam. <verse eid="1CH 12:36" /><verse number="37" style="v" sid="1CH 12:37" />Jordan kedale mbie gade, Reuben leuhme, Gad leuhme nah Manasseh leuh pempie ge gade, hereu nia ketsamtsam leune kai lwe hereu tei kera mtei kelume mina 120,000 bam.<verse eid="1CH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38" />Reugwame aidungde pelane, hereu tei kera mteilu eh David de peu Israel pelane reuga hegwang teibi kera mning eh Hebron ga gwang. Israel ga mina kebangme pelane David de hegwang tei kera ngngwa ket teilu. <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />Penui David de ngngwa cika tyei nah sak eh lang cumne bam, penui kibaume penuide ketyei kesak mteilwe langgai kebeu ziemne. <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />Cipau reude, penui de kenna ga kebamme, Issachar nah Zebulun nah Naphtali deige gade, tangku penui gadadung, utdung, gadanadung, nah hetumseu, nah tangzüttsi tangku, kubetsi kekibe dui, zau, maca, hetumseu, nah meurün punglwe gwang, kedanemene Israelme hengyi kebamne.<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s">Samkakbung keugwang daikelu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />David cang nah pehai reu reugwa muiteumedung, kedime leune de ngngwa kelunglia gai. <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />David Israel maadi pelane dage rangdi, “Magade nnui kesuizwa lie cai, nah magade aide RAMPAUBE anui Tinggwang dade gwang lie cai, anui sinamedung Israel cuikuidung leune ga lungh kebamme de nah cingkumedung nah Levimedung penui namdidung ga kebamme leune dage samgwamedung langgai golie. Peu penuide anuide ncütlu kera rangbeulu kerane.” <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />Anui anui Tinggwang samkakbung de anuida keu cailigwang lugo, kedanemene Saul hegwang ketei tingdau anui pe lungning peeilu melu. <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />Mbau kebam pelane aidung de tei kera kesuisamlu, kedanemene mina pelane dwa gade cidung de petau kedi ziemne. <verse eid="1CH 13:4" /><verse number="5" style="v" sid="1CH 13:5" />Cine David Israelme pelane de qu hekwalu; Egypt ga Shihor reuki gade gwang Lebo Hamath kecang, Kiriath Jearim gade Tinggwang samkakbung punggwang lu kerane. <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />David nah Israelme pelane Baalah ga mielu, cide Kiriath Jearim, Judahme deu ga bam, Tinggwang samkakbung cika de pung nghang lu kerane, cide RAMPAUBE zi gade qula, RAMPAUBE, cherubim reu ga kebambe. <verse eid="1CH 13:6" /><verse number="7" style="v" sid="1CH 13:7" />Cine Penui Tinggwang samkakbung de pwa bagi keheci gage kailu. Penui cide Abinadab ki gade pwa mpet lu. Uzzah penai Ahio ne bagi nzangla. <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />David nah Israelme pelane Tinggwang dwa de penui kengkieng pelane teu eh renga bam. Penui au leibung peria keteibe, nsum, ntwai nah teluidung pwa lwe lei tei bam.<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />Penui Kidon hecaipung ga gwang canglu ge, hetumseu kau mie kedine, Uzzah samkakbung herak kera peba hetwa petlu. <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />Iciuge RAMPAUBE Uzzah de perata süt di, nah RAMPAUBE pecu teitset di kedanemene Uzzah samkakbung de gage pe ba kai kedine. Cikade pa Tinggwang dwade tsaidi. <verse eid="1CH 13:10" /><verse number="11" style="v" sid="1CH 13:11" />RAMPAUBE Uzzah de teitset kedine David perata di. Cipau heni de henai kecang de Perez Uzzah lie qula. <verse eid="1CH 13:11" /><verse number="12" style="v" sid="1CH 13:12" />Cipau nai David Tinggwang de hingdi. Pa rangdi, “Dainzwa eh Ih Tinggwang samkakbung de ada kilung ga punggwang lu laino?” <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />Cine David samkakbung de David namdi ga punggwang ma, dede Gathme pei Obed Edom ki gage kai pwabam di. <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />Kei cum ge Tinggwang samkakbung de Obed Edom kelak ga pe kiga kai pwa bamdi. RAMPAUBE cine pe kelak nah pe mabam pelane de samlam beu.<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s">David kibaume nah kelak</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />Pecai Tyre ga hegwangpei Hiram samgwame, nah cedar tsingdung, tsing ta keteime nah tangtsu ta keteimedung de David dage lang gaibeu. Penui pe ziemne ki ge teibeu di. <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />David RAMPAUBE pecu Israelme reu hegwang teilu delie kecu nah pe hegwangram pe mina Israelme ziemne tei ngkieng beu delie kecu cibam.<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />Jerusalem gade, David pe nau tei dailu, delwe pa pe na mipeinadung nah mipuinadung lung si dailu. <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />Aidungde cai Jerusalem gade pe name mna kelume zidung: Shammua, Shobab, Nathan, Solomon, <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />Ibhar, Elishua, Elpelet, <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />Nogah, Nepheg, Japhia, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />Elishama, Beeliada nah Eliphelet.<verse eid="1CH 14:7" /></para>
  <para style="s">David Philistinme de ngamkedi</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />Philistinme David de peu Israel pelane reu hegwangpei tei kera keniaklu delie kecu siulu ge, penui pelane pecu pei miedi. Dede David aipau ha de siulu nah penuide regi kera tet petdi. <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />Philistinmedung gwang delwe Rephaim chabak ga mie hema tui ladi. <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />Pecai David Tinggwang dade kengha kiedi. Pa rangdi, “Ih Philistinme de gwaketang zie ni? Nang penui reu ngkieng kelu peu zie ni?” RAMPAUBE pe dage rangdi, “Gwaketang cu, kedanemene Ih penuide ncu peu bi zielu.” <verse eid="1CH 14:10" /><verse number="11" style="v" sid="1CH 14:11" />Cine penui Baal Perazim ga mielu, nah cikade David penuide ngamlu. Pa ranggai, “Tinggwang ne a ba gade a ngauraumedung kakga dui kedi pangpop mie kecu nzwa teipang pop luda.” Cine cipau heni zi de Baal Perazim de qudi. <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />Philistinme penui rabedung de cika ge gidi, nah David cidungde rudi lo eh aja kaigai.<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />Pecai Philistinme langkam de mie hema tui bam daidi. <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />David cine Tinggwang dade kengha kie daigai. Tinggwang pe dage rangdi, “Nang penui dwa lede gwaketang helo, dede penui caile twagwa gwang eh balsam tsingdung kak gade penuide gwa lüt lulo. <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />Nang Balsam bang tündung gade tingkai gui kebam ga tet kegwang kwa siu keludau, kengkieng teu gwaketang lulo. Aide tei lulo kedanemene Tinggwang au Philistinme reugwame de gwaketang kera n dwa tet rai gwang zielu.” <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />Cine David Tinggwang pecu rang kebeu nzwa teilu. Pa Philistinme reugwame de Gibeon gade gwang Gezer kecang ngamlu. <verse eid="1CH 14:16" /><verse number="17" style="v" sid="1CH 14:17" />Pecai David keyi ha kideu pelane ga ci gwang di, nah RAMPAUBE heleuh pelane de peu pecu hing di.<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s">Samkakbung Jerusalem ga pwagwang kelu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />David pekatei pe ziemne David namdi ga kidung teilu. Pa Tinggwang samkakbung ziemne heni ge mteilu nah paiki ge cide ziemne lim lu. <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />Pecai David rangdi, “Levime rünne Tinggwang samkakbung de pwa zie, kedanemene RAMPAUBE ne penuide RAMPAUBE samkakbung pwa kerane nah kelunghta pe gwa tei kerane kedet luda. <verse eid="1CH 15:2" /><verse number="3" style="v" sid="1CH 15:3" />Pecai David, Israelme pelane de Jerusalem gage qu hekwalu, pa heni mtei pwa kebam gage RAMPAUBE samkakbung de pwa gwang gailu kerane. <verse eid="1CH 15:3" /><verse number="4" style="v" sid="1CH 15:4" />David Aaron leuhmedung nah Levi leuhmedung de qu hekwa lu. <verse eid="1CH 15:4" /><verse number="5" style="v" sid="1CH 15:5" />Kohath leuhme gade, muiteube Uriel nah pe kibaume, mipei 120 ge gwang. <verse eid="1CH 15:5" /><verse number="6" style="v" sid="1CH 15:6" />Merari leuhme gade, muiteube Asaiah nah pe kibaume, mipei 220 gwang. <verse eid="1CH 15:6" /><verse number="7" style="v" sid="1CH 15:7" />Gershom leuhme gade, muiteube Joel nah pe kibaume, mipei 130 ge gwang. <verse eid="1CH 15:7" /><verse number="8" style="v" sid="1CH 15:8" />Elizaphan leuhme gade, muiteube Shemaiah nah pe kibaume, mipei 200 ge gwang. <verse eid="1CH 15:8" /><verse number="9" style="v" sid="1CH 15:9" />Hebron leuhme gade, muiteube Eliel nah pe kibaume, mipei riakheset ge gwang. <verse eid="1CH 15:9" /><verse number="10" style="v" sid="1CH 15:10" />Uzziel leuhme gade, muiteube Amminadab nah pe kibaume, mipei 112 ge gwang. <verse eid="1CH 15:10" /><verse number="11" style="v" sid="1CH 15:11" />David cingkupei kena Zadok penai Abiathar, nah Levime Uriel, Asaiah, Joel, Shemaiah, Eliel nah Amminadab penuide qu gai. <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />Pa penui dage rangdi, “Nnui au Levime leuhme muiteudung da. Nnuikatei nnuide nah nnui sinamedung de tei mci lu, iciu eh nnui RAMPAUBE, Israelme Tinggwang samkakbung de Ih cide ziemne mtei pwa kebam heni gage pung gwang gailu kerane. <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />Keraibe pia nnui cide pwa ma. Cide ziemne RAMPAUBE anui Tinggwang anuide mlaidi, kedanemene anui pecu peei nah pesam mzai kemakne.” <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />Cine cingkumedung nah Levimedung penuikatei penuide tei mci lu iciu eh RAMPAUBE Israelme Tinggwang samkakbung de pung gwanglu kerane. <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />Cine Levimedung Tinggwang samkakbung de pe pakdung penui hekeutudung reu gage kailwe pwalu, Moses samkai kebeu nzwa, RAMPAUBE sam gade hezai kai kebeudung de mzui eh.<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />David Levime muiteudung de Levimedung de leibung peria keteibe, leibungdung nah ntwaidung, kwa bak eh nah penui sui yi eh leibung kwa eh lei keteime tei kerane nlum gai. <verse eid="1CH 15:16" /><verse number="17" style="v" sid="1CH 15:17" />Cine Levime Joel napei Heman nah pe siname pei, Berechiah napei Asaph de kedetlu. Penui Merari leuhme gade pe kibaume de de si eh nah Kushaiah napei Ethan de kedetlu. <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />Penuide ngha kera ngngwa kelame penui kibaume cai Zechariah,<note caller="+" style="f"><char style="ft" closed="false">Kehegwa laisiudung kesa ga “ben,” de kaisi la, Zechariah pei zi kai canglu meni de eh. </char></note> Jaaziel, Shemiramoth, Jehiel, Unni, Eliab, Benaiah, Maaseiah, Mattithiah, Eliphelehu, Mikneiah, Obed Edom nah kirie kekwabe Jeiel. <verse eid="1CH 15:18" /><verse number="19" style="v" sid="1CH 15:19" />Leibung kekwame Heman, Asaph nah Ethan de peu hetageu ntwai kwabak eh kwa kerane kedetlu. <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />Zechariah, Aziel, Shemiramoth, Jehiel, Unni, Eliab, Maaseiah nah Benaiah de, Alamoth ria gade leibung peria keteibedung kwa. <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />Mattithiah, Eliphelehu, Mikneiah, Obed Edom, Jeiel nah Azaziah de, Sheminith ria gade leibungdung teu swa eh kwa kerane kedetlu. <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />Kenaniah, Levime muiteube, leiketeime de pie kerengeibe teigwang kedanemene pa au lei keledeube kecune. <verse eid="1CH 15:22" /><verse number="23" style="v" sid="1CH 15:23" />Berechiah penai Elkanah becai samkakbung kekwame. <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />Cingkume Shebaniah, Joshaphat, Nethanel, Amasai, Zechariah, Benaiah nah Eliezer becai Tinggwang samkakbung dwa ga teluidung kwa kerame. Obed Edom penai Jehiah cai samkakbung ziemne kekwame.<verse eid="1CH 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />Cine David, Israel hangkiamedung nah pecang reu reugwa muimedung RAMPAUBE samkakbung Obed Edom ki gade pwa mpet kerane penui sui yi eh miedi. <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />Tinggwang Levime RAMPAUBE samkakbung kepwame de ngha kebeune, penui hetumseu hena nah meurünseu hena ratak tei gai. <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />David au langcim pai yitube balu, Levime samkakbung kepwamedung, lei keteimedung, nah Kenaniah, lei ketei muiteube de cinzwa balu. David langcimpai cwatie ge teu eh la. <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />Iciu eh Israelme pelane penui suiyi sahbak eh nah hekiidung, nah teluidung, nah ntwaidung, nah leibung nah leibung peria keteibe kwa eh RAMPAUBE samkakbung pwa nghang lu.<verse eid="1CH 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29" />Dede RAMPAUBE samkakbung David namdi ga gwang luge, Saul napui Michal hebaki gade pie mpet gai. Pa hegwangpei David helim lim nah renga la kecu ngau. Ge pa pe mlung gade pecu ngkaudi.<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />Penui Tinggwang samkakbung pwa gwanglu delwe David ne cide ziemne tei pwa kebam paiki sum gage kailu. Pecai penui keru recadung nah kekangbau recadung Tinggwang dwa gage reca tei gaibeu. <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />David keru reca nah kekangbau reca ratak teicang luge, pa RAMPAUBE zi gade minadung de samlam beu. <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />Pa Israelme pelane, mipei nah mipuidung de tangku kwak ge, heteih kangge nah kubetsi kekibe tangku mzi beu.<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />David Levime kangge de peu RAMPAUBE samkakbung dwa RAMPAUBE, Israel Tinggwang de twa nah lei tei eh teuswa kerane kedetlu. <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />Aipau Levimedung de cai muiteube Asaph nah pekang ga Zechariah, Jaaziel, Shemiramoth, Jehiel, Mattithiah, Eliab, Benaiah, Obed Edom nah Jeiel. Aidungde cai peria keteibe leibung nah leibung kwa kerane. Asaph cai ntwai kediang eh kwa mtei sütgai kera. <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />Benaiah penai Jahaziel cingkupei kena cai Tinggwang samkakbung dwade teluidung kwa bam jüja kera kedetlu.<verse eid="1CH 16:6" /></para>
  <para style="s">David ketwa lei</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />Pecai cipaunai David Asaph nah pe siname de RAMPAUBE de aipau ketwa lei de tei kera raitube kedetlu.<verse eid="1CH 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="1CH 16:8" />RAMPAUBE de ketwa peulu, pe zi qu lo;</para>
  <para style="q" vid="1CH 16:8">Pe batadung heleuhdung dage peu cigai lo.<verse eid="1CH 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="1CH 16:9" />Pe dage lei tei gailo, lei tei pecu twa lulo;</para>
  <para style="q" vid="1CH 16:9">pa tei kegai mimakecang batadung leune ranglo.<verse eid="1CH 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="1CH 16:10" />Pe kemci zi teu hegie lo;</para>
  <para style="q" vid="1CH 16:10">RAMPAUBE de reca kelame de peu penui sui yi lulo.<verse eid="1CH 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="1CH 16:11" />RAMPAUBE de nah pe kengkieng de peei lu;</para>
  <para style="q" vid="1CH 16:11">nah pecu reca lamui lu.<verse eid="1CH 16:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="1CH 16:12" />Pa mimakecang batadung tei kegai nsung gailo,</para>
  <para style="q" vid="1CH 16:12">miswakegah batadung nah pa pemui gade samkai kebeudung,<verse eid="1CH 16:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="1CH 16:13" />nnui pe kilame Israel leuhmedung,</para>
  <para style="q" vid="1CH 16:13">nnui Jacob leuhme, pa ne kedet kelumedung.<verse eid="1CH 16:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="1CH 16:14" />Pa au RAMPAUBE, anui Tinggwang,</para>
  <para style="q" vid="1CH 16:14">pe ajadung au kideu pelane ga la.<verse eid="1CH 16:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="1CH 16:15" />Pe samkak n lung gage kelungta kainzeu lalu,</para>
  <para style="q" vid="1CH 16:15">ceheudung pecang ge ziemne pa aja kai kebeu sam de.<verse eid="1CH 16:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="1CH 16:16" />Abraham de ngngwa samkakkelu de pa nsunglu,</para>
  <para style="q" vid="1CH 16:16">nah Isaac dage pa sampet kebeu de.<verse eid="1CH 16:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="1CH 16:17" />Pa aide Jacob de ngngwa hezai ge eh tei ncilu,</para>
  <para style="q" vid="1CH 16:17">nah Israelme dage kelungta samkak tei kelu ge.<verse eid="1CH 16:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="1CH 16:18" />Pa rangdi, “Ih ncu Canaan deu de peu zie,</para>
  <para style="q" vid="1CH 16:18">n mapwa n gu tei kera.”<verse eid="1CH 16:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="1CH 16:19" />Penui peupei kecam nage kecu dau,</para>
  <para style="q" vid="1CH 16:19">camsüt, nah penui au cipau deu ga sangme ge tei kela dau,<verse eid="1CH 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="1CH 16:20" />penui heleuh ge gade heleuh ge ga</para>
  <para style="q" vid="1CH 16:20">hegwangram ge gade kedabe hegwangram ge ga lungh rwa pwala la.<verse eid="1CH 16:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="1CH 16:21" />Pa migede de penuide tei keherei kera peu ma,</para>
  <para style="q" vid="1CH 16:21">pa penui ziemne hegwangmedung de saja peu.<verse eid="1CH 16:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="1CH 16:22" />Pa rangdi “Ih keniak kelume de tung so,</para>
  <para style="q" vid="1CH 16:22">nah a caihakecimedung de tei keherei so.”<verse eid="1CH 16:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="1CH 16:23" />RAMPAUBE dage leitei gailo, kideu pelane;</para>
  <para style="q" vid="1CH 16:23">tingnai ramsangne pe kelikelu de sah lo.<verse eid="1CH 16:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="1CH 16:24" />Pe kendu heleuhdung kakga sah gailo,</para>
  <para style="q" vid="1CH 16:24">mimakecang pe batadung heleuhdung pelane dage.<verse eid="1CH 16:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="1CH 16:25" />Kedanemene RAMPAUBE au dizu nah pecu twasüt kerabe,</para>
  <para style="q" vid="1CH 16:25">nah pecu au hera kedadung swade hingki kerabe lie.<verse eid="1CH 16:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="1CH 16:26" />Kedanemene heleuhdung rabedung leune au mamiedung,</para>
  <para style="q" vid="1CH 16:26">dede tinggimdung tei kegaibe au RAMPAUBE lie.<verse eid="1CH 16:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="1CH 16:27" />Kendu nah herüt au pa kebam ga la.</para>
  <para style="q" vid="1CH 16:27">Kengkieng nah suiyi au pe kemci ni ga la.<verse eid="1CH 16:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="1CH 16:28" />RAMPAUBE de twalu, nnui heleuh menadung,</para>
  <para style="q" vid="1CH 16:28">RAMPAUBE kendu nah kengkieng de twalu.<verse eid="1CH 16:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="1CH 16:29" />RAMPAUBE kendu ngaulu kebui nsam de pwa pecu peulo.</para>
  <para style="q" vid="1CH 16:29">Reca ge teugwang lwe pe dwaga gwanglu.</para>
  <para style="q" vid="1CH 16:29">RAMPAUBE kemci be dwa ga keumie lu.<verse eid="1CH 16:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="1CH 16:30" />Pedwa gade mbeu lulo, kideu pelane.</para>
  <para style="q" vid="1CH 16:30">Kideube de teigai dida, cide deu mlai gailak.<verse eid="1CH 16:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="1CH 16:31" />Tinggimdung de peu pesui yilu, nah kideube de peu pesui yilu;</para>
  <para style="q" vid="1CH 16:31">peu penuide heleuhdung kakgade, “RAMPAUBE hegwang lie” de eh ranglo.<verse eid="1CH 16:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="1CH 16:32" />Peu duidi de mrung lu, nah cide ga pui kebam leune suiyi sah lo.</para>
  <para style="q" vid="1CH 16:32">Peu luhdung de nah penui da kebam leune de penui sui yilu.<verse eid="1CH 16:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="1CH 16:33" />Pecai hegung ga kebam tsingbangdung de peu RAMPAUBE dwa gade suiyi sahlu,</para>
  <para style="q" vid="1CH 16:33">kedanemene pa au kideube de tiak kera gwang zie da.<verse eid="1CH 16:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="1CH 16:34" />RAMPAUBE de hetwa peulo, kedanemene pa au yilu,</para>
  <para style="q" vid="1CH 16:34">pe samkakkelu samsang au kelungta bammui lalu.<verse eid="1CH 16:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="1CH 16:35" />Pecai ranglo, “Anuide kelibeu lo, anuide kelikelube Tinggwang.</para>
  <para style="q" vid="1CH 16:35">Anuide ngngwa hekwalu delwe heleuhdung kedame dade anuide kelibeu lo,</para>
  <para style="q" vid="1CH 16:35">iciu eh anui n zi kemci zi de ketwa peulu kerane</para>
  <para style="q" vid="1CH 16:35">nah anui sui yi eh ncu twalu kerane.”<note caller="-" style="x"><char style="xo" closed="false">16:35 </char><char style="xt" closed="false"><ref loc="PSA 106:47">Lei. 106:47</ref></char></note><verse eid="1CH 16:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="1CH 16:36" />Peu RAMPAUBE Israel Tinggwang, de kelungta gade kelungta kecang</para>
  <para style="q" vid="1CH 16:36">twa kelube tei lulo.</para>
  <para style="m" vid="1CH 16:36">Minadung pelane, “Amen” de ranggai nah RAMPAUBE de twagai.<note caller="-" style="x"><char style="xo" closed="false">16:36 </char><char style="xt" closed="false"><ref loc="PSA 106:48">Lei. 106:48</ref></char></note><verse eid="1CH 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />Cine David, Asaph nah pe siname de RAMPAUBE samkakbung dwa gage püt gaidi, peu samkakbung dwa ga langnaimsangne tei maikesiadung tei jüja eh bamlu kerane. <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />Obed Edom nah pe kibaume riakherokeheset de si. Jeduthun napei Obed Edom, nah Hosah cai kiriekekwame tei kera. <verse eid="1CH 16:38" /><verse number="39" style="v" sid="1CH 16:39" />Cingkupei Zadok nah pe kangzang cingkume cai RAMPAUBE kebam paiki Gibeon ga recabam kehu dwaga heta tei kera. <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />Penui cai RAMPAUBE de keru recadung recabam gage tingcang nah tinghegi keru recadung teibeu jüja bam kera, RAMPAUBE hezai ga raupwa kebam leune nzwa eh, pa cide Israelme de hezai kepeu de. <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />Heman penai Jeduthun penuide nzang bam, pezi kedet pwa kebammedung de si eh, RAMPAUBE de ketwa peu kerane, kedanemene pe samkakkelu samsang de kelungta bammui kelane. <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />Heman penai Jeduthun cai teluidung, ntwaidung nah leibung kedadung kemci lei ziemne kwa kecume reu kerengeibe. Jeduthun napeime ne kirieki kwala. <verse eid="1CH 16:42" /><verse number="43" style="v" sid="1CH 16:43" />Pecai mina pelane de penui kilungdung ga cailigwang di, nah David pe kilungme de samlam beu kerane cailigwang di.<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s">David dage Tinggwang sampet</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />Hegwangpei David pe hegwangki ga lungh kedi cai, pa caihakecibe Nathan dage ranggai, “Pielo, Ih au cedar tsing le teikelu kiga lungh bam, dede RAMPAUBE samkakbung au paiki kangga bam.” <verse eid="1CH 17:1" /><verse number="2" style="v" sid="1CH 17:2" />Nathan pecai David dage rangdi, “Nang cet kebam de tei lulo, kedanemene Tinggwang ncu ngngwala lu.” <verse eid="1CH 17:2" /><verse number="3" style="v" sid="1CH 17:3" />Dede cipau ziu Tinggwang sam Nathan da gwang eh ranggai, <verse eid="1CH 17:3" /><verse number="4" style="v" sid="1CH 17:4" />“Mie delwe a kilabe David dage rangbeu lo, ‘RAMPAUBE ainzwa rangzeu: Nang Ih lungh kera ki cide teilak. <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />Kedanemene Ih Israelme de kelilu benai gade henai kecang Ih ki ga lungh melu. Meliene, Ih paiki, kerecaki ga lungh, heni ketsamtsam leu ga. <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />Ih Israelme pelane de ngngwa heni leune ga mbeu mie kecu ga, Ih madaude Ih a minadung de pie rengei kerane kedet kelu Israel muiteudung keheibe dage, “Daitei nnui a ziemne cedar tsing le a ki teibeu meno?”’” de magede rang ni. <verse eid="1CH 17:6" /><verse number="7" style="v" sid="1CH 17:7" />“Cu iciucai, a kilabe David de rang beulo, ‘Tinggim reugwame reu RAMPAUBE aide rangzeu; Ih ncu tsehei luh ga, meurün kwakela gade ngngwalu, iciu eh nang a mina Israelme reu hegwang teilu kerane. <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />Nang kemie leuga Ih ncu nzangla nah n ngauraumedung de n dwa gade ngam ciau dida, nah Ih n zi kideu ga kendume zidung nzwa teibeu zie. <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />Ih a mina Israelmedung ziemne heni ge mtei beuzie delwe penuide peu cika lungh zie, iciu eh penui penuikatei penui deu ga lunghlu kerane nah kehebwak bam si melu kerane. Mina kesiame penuide teikeherei si lakta, ndaa penui tei kecu nzwa, <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />Ih tutiakme de peu a mina Israelme reu kedi tei zie lie aja kai kebeu tingdau gade penui tei kela de. Pecai Ih n ngauraume pelane de tei ngkap dizie. Cipaureude Ih n dage rangla Ih, RAMPAUBE, ncu ki ge, teibeu zie. <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />Cinzwa eh nang n teilung zie cangdi eh n paume taiga mie kera ting kedi dau, Ih n cai n leuhme de teu cuh beuzie, nah n name hangge ziemne, Ih pe hegwangram tei ngkieng beuzie. <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />Pa acu ki ge teibeu zie, nah Ih pe hegwangbam kelungta tei ngkieng beuzie. <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />Ih pe pei zie nah pa a napei zie. Ih a samkakkelu samsang de pe dade keuteu dilak, Ih Saul n dwa hegwang tei kecube dade keu caili kedi nzwa.<note caller="-" style="x"><char style="xo" closed="false">17:13 </char><char style="xt" closed="false"><ref loc="2SA 7:14">2 Sam. 7:14</ref></char></note> <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />Ih pecu a ki reu ga nah a hegwangram ga kelungta peu bam zie, nah pe hegwangbam kelungta bam zie.’”<note caller="-" style="x"><char style="xo" closed="false">17:14 </char><char style="xt" closed="false"><ref loc="2SA 7:16">2 Sam. 7:16</ref></char></note> <verse eid="1CH 17:14" /><verse number="15" style="v" sid="1CH 17:15" />Nathan David de mpau eh pecu sam aidungde pelane paulia beu, nah pa pecu keulia kegai leune ha ranglia beu.<verse eid="1CH 17:15" /></para>
  <para style="s">David kekie</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />Pecai David hegwangpei lütlu delwe RAMPAUBE dwaga ntumlu; pa ranggai “Ih cau no, RAMPAUBE Tinggwang, nah a kilungme dai keteidung ge no, nang acu aikenzwa kecang ga ngngwa gwang beu kera?” <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />Dede n dwa gade aide au makeceu nage, Tinggwang. Nang n kilabe kilungme pecai ketiege kedi teigwang kera rangbeu da, nah lunggwang kera ceheudung keulia beu da, RAMPAUBO Tinggwang. <verse eid="1CH 17:17" /><verse number="18" style="v" sid="1CH 17:18" />Ih, David n dade daige rang silu laino? Nang n kilabe de de kerüt peu da. Nang n kilabe de tei ndugai beuda. <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />RAMPAUBO, n kilabe ziemne, nah n lungning teicanglu kerane, n bata kedi leune keulia kerane nang kedi aide teigai da. <verse eid="1CH 17:19" /><verse number="20" style="v" sid="1CH 17:20" />RAMPAUBO, nang nzwa migede gah, nah nang gwale Tinggwang kedage de gah, anui siu bammui kela nzwa. <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />Kedanemene kideu ga n mina Israelme nzwa dai leuh ge bam no? Cidungde, Tinggwang nang ne Egypt gade n mina tei kerane kelikelume, makedi nah miswakegah batadung teigai eh n zi teilu kerane. Egypt gade nang keli teu mpet kelu n minadung dwade nang heleuhdung de gwa gidi. <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />Nang Israelme de kelungta n mina tei luda, nah RAMPAUBO nang penui Tinggwang tei dida. <verse eid="1CH 17:22" /><verse number="23" style="v" sid="1CH 17:23" />Cu cine, RAMPAUBO, nang n kilabe ziemne nah pe kilungme ziemne sampet kegai de peu kelungta la kelube teilo. Nang kerang de nzwa tei lulo. <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />Peu n zi kelungta di nah bammui kelube tei lulo, iciu lude minadung, “Tinggim reugwame reu RAMPAUBE au Israelme Tinggwang lie,” de eh rang zie, nah n kilabe, David, a kedi de ndwa gade sapla luzie. <verse eid="1CH 17:24" /><verse number="25" style="v" sid="1CH 17:25" />Kedanemene nang, a Tinggwang nang n kilabe dage keu liagai da nang pe ziemne ki ge teibeu zielie kecu. Ciziemne Ih, n kilabe, n dage kiegai kera kekuu ngaulu da. <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />Cu, RAMPAUBO, nang au Tinggwang nah sampet keyi aide n kilabe dage teigai beu da. <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />Cu au n kilabe leuhme de samlam beu kera nang n sui luda, iciu eh cide kelungta n dwaga bam jüja lalu kerane. Nang, RAMPAUBO, cide samlam beuda, nah samlam cide kelungta bam dizie da.<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s">David ngkieng keludung</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />Aipaucai David Philistinme de gwaketang delwe penuide ngamlu. Pa Gath nah cide twagwa kebam renamdung Philistinme kangga kebam de gumlu. <verse eid="1CH 18:1" /><verse number="2" style="v" sid="1CH 18:2" />Pecai pa Moabme de ngamlu, nah Moabme David kangga lunghdi nah heraha pe dage kaidi.<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />Pecai David Zobah hegwangpei Hadadezer de Hamath gade ngamlu, Hadadezer Euphrates Reuki de kejeulu zielie hebeu tei kela dau. <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />David pe dade bagidung cangge, hekwen keteume cang hena, nah hepi reugwamedung cang ngkai de tuilu. David bagi teu keladung hekwendung pi tei telwa ciakdi, dede bagi haige ziemne hekwendung kainzeulu.<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />Damascus ga Aramme Zobah hegwangpei Hadadezer de ngha kera kegwang dau, David Aramme cang ngkai-kena de teitsetti. <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />Pecai David Damascusme deu Aram ga reugwame ramzeukidung teilu, nah Aramme pe kangga lunghdi nah heraha pe dage teugwangbeu di. RAMPAUBE David de pa kemie leu ga ngkieng kelu peu. <verse eid="1CH 18:6" /><verse number="7" style="v" sid="1CH 18:7" />David Hadadezer kilame da kecak geudung kebam de keulu delwe cidungde Jerusalem ga teugwanglu. <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />Hadadezer namdidung, Tebah penai Kun gade David hetageu kekieege keulu. Pecai aipau hetageu de le pwa Solomon hetageu duibung “Jaaidi,” de qu kela de, hetsiadung, nah hetageu lidung teilu.<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />Hamath gwangpei Tou, David, Zobah gwangpei Hadadezer reugwame pelane de ngamlu de lie kecu siulu, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />nah cine Tou pe napei Hadoram de hegwangpei David de kelum kera nah pecu samlam beu kera langgai. Pa aide tei kegai au David Hadadezer de regi eh pecu ngam kelune, nah Tou ma kekieege Hadadezer de ngngwa hereu keteine. Tou David de ma ketsamtsam kecak, rangkanggeu, nah hetageu le tei keludung kekieege de langgai beu. <verse eid="1CH 18:10" /><verse number="11" style="v" sid="1CH 18:11" />Hegwangpei David ma aidung RAMPAUBE ziemne keu ntsam lu, rangkanggeu nah kecak: Edom, Moab, Ammonme, Philistinme nah Amalekme leuhme dade teugwang keludung de si eh.<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />Zeruiah napei Abishai Edomme cang kereieheset de Mcai Langkam gade teitsetdi. <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />Pa Edom ga reugwame ramzeuki teilu, nah Edomme pelane David kilame teidi. RAMPAUBE David de pa kemie leuga ngkieng kelu peu.<verse eid="1CH 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />David Israel pelane reu hegwang tei, nah pa pe minadung pelane de kesamsang nah kemzuibe teugwang beu. <verse eid="1CH 18:14" /><verse number="15" style="v" sid="1CH 18:15" />Zeruiah napei Joab cai reugwame muibe, nah Ahilud napei Jehoshaphat cai kerau kerengeibe. <verse eid="1CH 18:15" /><verse number="16" style="v" sid="1CH 18:16" />Ahitub napei Zadok nah Abiathar napei Ahimelech cai cingkupei kena, nah Shavsha cai keraube. <verse eid="1CH 18:16" /><verse number="17" style="v" sid="1CH 18:17" />Jehoiada napei Benaiah cai Kerethitme nah Pelethitme reu kedibe, nah David napeime cai hegwangpei ta ketei ga ditume.<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s">Ammonme de ngngwa hereuketei</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />Peting tiemene aipaucai Ammonme gwangpei, Nahash tsaidi, nah iciu eh pe napei pe bam leu eh hegwang teidi. <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />David ranggai, “Ih Nahash napei Hanun dage kehungta teigai zie, kedanemene pe pei a dage kehungta tei kegaine.” Cine David pe pei tsai kedine pe lung tau mla kera samgwame de langgai. David kilame Ammonme deu ga gwang canglu delwe Hanun da suisiet sam pau kera gwanglu. <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />Dede Ammonme muiteumedung Hanun dage rangdi, “David mina de n lung tau mlalu kera lang kegaine pa n pei de kerüt peu au lie nang cetla ni? Pe kilamedung hangdeu pie nah ncetlwe cide gwalu kerane n da gwangla meni?” <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" />Cine Hanun David kilame de tuilu, penui tangkeimaidung taidi, penui painidung penui kia ga kecang, penui ndang ga kecang dumtüt di, delwe penuide langgi di. <verse eid="1CH 19:4" /><verse number="5" style="v" sid="1CH 19:5" />Penui aide David dage pau kegai dau, pa penuide redau kerane mina de langgai, kedanemene penui ngngam ham kedine. Hegwangpei rangdi, “Nnui tangkeimai bwa cuh dailu kemaktane Jericho ga bam lulo nah ciciu lude cailigwang lu.”<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />Ammonmedung David ngaurau teikedi cilu ge, Hanun nah Ammonmedung Naharaim, Maacah nah Zobah gade Aramme bagidung nah hekwen keteume de liteu gwang kera rangkanggeu talent cangge langgai. <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />Penui likelu bagidung cang camreiehkena nah Maacah gwangpei nah pe reugwame, penui Medeba dwa ga gwang ramzeuki teilu. Ge Ammonme penui namdidung gade gwang ngkwalu delwe regi kera petlu. <verse eid="1CH 19:7" /><verse number="8" style="v" sid="1CH 19:8" />David cide siulu ge, pa Joab nah pe reugwame pelane de penuide dau kera langgai. <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />Ammonme hereu tei kerane namdi kirieki ga pet sap twagwalu, nah hegwangpeidung gwang kebamme penuikatei langkie ga penui bam mteilwe bamdi.<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10" />Joab ngauraume reugwa maadung pedwa pecai twagwa kebam ngaulu ge, pa Israelme reugwa yitume kangge de kedetlu delwe Aramme de mcwa eh penui bam mteilu. <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />Reugwa kedamedung pelane de, pa pe sinabe Abishai de peu kezeu kera kaidi, nah pa penuide Ammon reugwame de mcwa lwe penui bam mteilu. <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />Joab rangdi, “Magade Aramme a ziemne ngkieng süt dicai, iciu cai nang, Abishai, acu kelibeu maisia. Dede magade Ammon reugwame n ziemne ngkieng süt dicai, iciu cai Ih gwang delwe ncu kelilu zie. <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />Ngkieng saplu, nah anui minadung nah anui Tinggwang namdidung ziemne anui laikai tei eh kuu saplu go, kedanemene RAMPAUBE pe dwa gade petaube tei zielu.” <verse eid="1CH 19:13" /><verse number="14" style="v" sid="1CH 19:14" />Cine Joab nah pe reugwamaa reugwamedung Aramme de gwaketang lüt, ge penui Israel reugwame dwa gade pakdi. <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />Ammon reugwame Aramme pak kedi ngaulu ge, penuide Joab sinabe Abishai dade pakdi delwe namdi be gage cailigwang di. Cidau Joab Ammonme dade cailigwanglu, delwe Jerusalem ga cailigwang di.<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />Arammedung penuide Israelme ne ngamkedi ngau luge, penui Euphrates Reuki lulegim de kengha ngngwa gwanglu, Shophak ne Hadadezer reugwamaa muibe tei eh kebamme de. <verse eid="1CH 19:16" /><verse number="17" style="v" sid="1CH 19:17" />David de aide pau kebeu dau, pa Israelme pelane de ngngwa hekwalu, Jordan kahlu, delwe penuide gwang mcwalu. Pa Aramme de regi kera reugwame bam mteilu, nah penui pecu regi. <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />Aramme Israelme dade pakdi, nah David Aramme bagiketeume cang hena nah hepi reugwame cang riakdai de teitsetdi. Pa Shophak, reugwamaa muibe de de teitsetdi <verse eid="1CH 19:18" /><verse number="19" style="v" sid="1CH 19:19" />Hegwangpeidung Hadadezer kangga kebamme pelane penuide Israelme ne ngamkedi ngau luge, penui David de ngngwa kezuyi teilu delwe pe kangga lunghdi. Cine Aramme Ammonme de ngha dai neu tadi.<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s">Rabbah namdi de tuikelu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />Pecai heriakting dau, hegwangmedung hereu teipet kela tingdau, Joab reugwame de hereu ga nzang pet delwe Ammonme deu ngkapdi. Pa mie delwe Rabbah<note caller="+" style="f"><char style="fr" closed="false">20:1 </char><char style="fq" closed="false">Rabbah</char><char style="ft" closed="false">Aide Ammonme namdi sumbe</char></note> namdi de twagwalu. David au Jerusalem ga bamdi. Joab Rabbah namdi de gwaketang delwe cide ngamlu. <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />David penui gwangpei peurwa pe peu gade keu mpet lu, nah pa cide perüt kecak talent ge kebam, nah cika tangtsu pemi kehungdung kebam ngaulu. Peurwa cide David peu gage kailu, nah pa namdi gade hema tuih kelu kekiee ge pwa gwang. <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />Pa namdi ga mina kebamme de ngngwa mpet lu delwe penuide ketang eh peu tsingget, nah hegeu tsingkang, nah mreudung pwa lwe heta tei. David aipau ta de peu Ammon namdidung ga mina pelane de tei. Pecai David nah reugwame pelane Jerusalem ga cailigwang di.<verse eid="1CH 20:3" /></para>
  <para style="s">Philistinme de ngngwa hereuketei</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />Aipau cai, Gezer gade Philistinme de ngngwa hereu tei. Hushahme Sibbekai ne Rephaim leuhme Sippai de teitsetdi, nah Philistinme de ngamdi. <verse eid="1CH 20:4" /><verse number="5" style="v" sid="1CH 20:5" />Cinzwa eh Philistinme de Gob gade ngngwa hereu tei daige, Jair napei Elhanan Bethlehemme gene Gathme pei Goliath sinabe de teitsetdi, Lahmi ngeitang au paidakme deikim siuge. <verse eid="1CH 20:5" /><verse number="6" style="v" sid="1CH 20:6" />Cinzwa eh hereu keda ge Gath gade tei, cika mige pera tie süt kecuge peba kenana ga zurang herok nah pepi kenana ga zurang herok bam kecu ge bam. Pa de Rephaim leuh gade lunggwang. <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />Pa Israel reugwame de teilia gai ge, Jonathan David sinabe Shimea napei ne pecu teitsetdi. <verse eid="1CH 20:7" /><verse number="8" style="v" sid="1CH 20:8" />Mina aidungde Gath ga lungh kebam Rephaim leuh gade lunggwang, nah penuide David nah pe reugwamedung ne teitsetdi.<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s">David reugwame peumkepei</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />Ngauraume ge Israel de renia cuhdi, nah Israel riak pei kera David lung teigai beu. <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />David Joab dage nah reugwamaa muibedung dage rangdi, “Mie cu, Beersheba gade Dan kecang Israel mina riak pei lo delwe a dage pau dai beulo, iciu eh Ih penui riak cilu kerane.” <verse eid="1CH 21:2" /><verse number="3" style="v" sid="1CH 21:3" />Joab rangdi, “Peu RAMPAUBE de cu kebam swade pe reugwame haige kiege tei ngkie beulo. Dede hegwangpei a mpaubo, penui pelane a mpaube gwa tei la meni? Daitei a mpaube aide tei neu lano? Daitei Israel da kemau teugwang zeu no?” <verse eid="1CH 21:3" /><verse number="4" style="v" sid="1CH 21:4" />Dede hegwangpei sam Joab teime gailak di. Cine Joab tetdi nah Israel deu pelane ga mie. Pecai pa Jerusalem ga cailigwanglu. <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />Ge Joab reugwame riak pei kelu pelane David dage paubeu. Israel ga kingtie kepwame mina 1,100,000 ge bam. Judah ga rünne reugwame 470,000 ge bam. <verse eid="1CH 21:5" /><verse number="6" style="v" sid="1CH 21:6" />Dede Levi penai Benjamin de penui kakga pei ncüt ma, kedanemene hegwangpei aja de Joab pesui ta kedine. <verse eid="1CH 21:6" /><verse number="7" style="v" sid="1CH 21:7" />Tinggwang heta aide tei kedi pesui tadi, cine pa Israel de ketang. <verse eid="1CH 21:7" /><verse number="8" style="v" sid="1CH 21:8" />David Tinggwang dade rangdi, “Ih aide tei kedine kemau kedi tei dida. Cu n kilabe mau gibeu lo, Ih kemieta ge teidi delu.”<verse eid="1CH 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />RAMPAUBE Gad, David caihakecibe dage rangbeu, <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />“Mie David dage ranglo, RAMPAUBE ainzwa rangzeu: Ih ncu makie kecum ge kedet kera peula. Cidung de kakde ket kedetlu.’” <verse eid="1CH 21:10" /><verse number="11" style="v" sid="1CH 21:11" />Cine Gad David da mie delwe pe dage rangdi, “RAMPAUBE aide rangzeu, ‘Aidungde gade ket kedetlu: <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />mmi kecum herakum zie mi, kei cum n ngauraume ne gwaketang nah penui kingtiedung ne tu luzie mi, mede langcumne RAMPAUBE kingtie zie no, cide cai, hangdeu ga rapia ge, RAMPAUBE gwame de peu Israel deu pelane ngkap gwang kera.’ Ciucai cu, Ih acu lang kegaibe dage daipai samli teugwang beu ziebi cet lulo.” <verse eid="1CH 21:12" /><verse number="13" style="v" sid="1CH 21:13" />Ge David Gad dage rangdi, “Ih au lungrei pui dida! Peu acu mina ba gage swade RAMPAUBE ba gage kaugai lu, kedanemene pe ngaugia tadung au dizu lu.” <verse eid="1CH 21:13" /><verse number="14" style="v" sid="1CH 21:14" />Cine RAMPAUBE Israelme da rapia ge langgai, nah mina cang riakhena tsaidi. <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />Tinggwang tinggimgwame gede Jerusalem ngkapdi kera langgai. Pa cide ngkapdi zie lie kebam dau, RAMPAUBE piegai nah tei keherei zielie kela de gade pe lung nreulu. Ma tei ngkap kebam tinggimgwabe dage pa rangdi, “Mtakdi! Cu n ba keu caili dilu.” Cipau tingdau RAMPAUBE tinggimgwabe Jebusme pei Ornan hecaipung ga sap bam. <verse eid="1CH 21:15" /><verse number="16" style="v" sid="1CH 21:16" />David ngangcuh piegai nah RAMPAUBE tinggimgwabe kideu nah tinggim kakga sapbam eh ngau, pe ba ga kiengtie pwa cuh lwe Jerusalem ngkap kera mteilwe. Ge David nah hangkiamedung, rosopai bahlu eh, keumie penui zu hangdeu ga nkumpung bamdi. <verse eid="1CH 21:16" /><verse number="17" style="v" sid="1CH 21:17" />David Tinggwang dage rangdi, “Reugwame riak peilo de eh aja kai kebeude Ih ne meni? Ih ne kemauta aide tei dida. Dede meurün aidungde, penui dai tei dino? RAMPAUBO a Tinggwang! Peu n ba a da nah a kelak da kailo, dede n mina da peu rapia gwang diso.”<verse eid="1CH 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />Cine RAMPAUBE tinggimgwabe Gad dage aja kaigai, David de peu hang delwe RAMPAUBE ziemne racabam Jebusme pei Ornan hecaipung gage tei lulo de eh David de rangbeu kera. <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />Cine David Gad pecu rang kebeu nzwa hangdi, RAMPAUBE zi gade tei kerane. <verse eid="1CH 21:19" /><verse number="20" style="v" sid="1CH 21:20" />Ornan hecaipung ga wheat neu kebam dau, pa nreu gwang eh tinggimgwabe de ngau. Pa nah pecu ngngwa pe napei hang mdai penui mbaidi. <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />David Ornan da kegwang dau, Ornan piegai nah David de ngaulu. Pa hecaipung de pütdi delwe David da keumie pe zu hangdeu tung di. <verse eid="1CH 21:21" /><verse number="22" style="v" sid="1CH 21:22" />Ge David Ornan dage rangdi, “Hecaipung aide acu zwa beulo, ciciu lude Ih RAMPAUBE ziemne recabam ge teigai beulu kerane. Ih pemi pelane peu zie, ciciu eh rapia mina dade keukezia dilu kerane.” <verse eid="1CH 21:22" /><verse number="23" style="v" sid="1CH 21:23" />Ornan David dage rangdi, “Cide ngu nzwa keulu, a mpaubo hegwangpei. Cide keu n dwade petaube teilu. Ainie, Ih ncu ketumseu keru reca ziemne, tsiuneu pak mitei kerane, nah ciu reca tei kerane wheat peu zie; Ih cidung pelane ncu peu zie.” <verse eid="1CH 21:23" /><verse number="24" style="v" sid="1CH 21:24" />Hegwangpei David Ornan dage rangdi, “Lak, Ih pemi kai cangsiaklu eh cide lui luzie. Ih ngu keu delwe RAMPAUBE de cide le keru reca tei beulak, cide a dade pemi gede keu mecai.” <verse eid="1CH 21:24" /><verse number="25" style="v" sid="1CH 21:25" />Cine David kecak shekel hai herok ge<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="fq" closed="false">shekel hai herok ge: </char><char style="ft" closed="false">6.9 kilogram.</char></note> heni ziemne peudi. <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />David cika ge RAMPAUBE ziemne reca bam teilu delwe keru reca nah kekangbau reca teigai beu. Pa RAMPAUBE dage kiegai, ge pa tinggim gade keru recadung recabam gage mi langgai eh pe kekie teibeu. <verse eid="1CH 21:26" /><verse number="27" style="v" sid="1CH 21:27" />Iciu luge, RAMPAUBE tinggimgwabe de sam kaigai, nah tinggimgwabe pe kiengtie keu caili pebung gage kaidi.<verse eid="1CH 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 21:28" />David Jebusme pei Ornan caipung gade RAMPAUBE pe kekie tei kebeu ngau luge, cipau tingdau cikade pa ratak tei gaibeu. <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />Cu cipau tingdau, Moses renaamkang gade tei kelu RAMPAUBE kebam paiki, nah recadung keru recabam de, Gibeon reca ni ga bam. <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />Ciciu liede, David Tinggwang puisau kie kera cika mie luma, kedanemene pa RAMPAUBE tinggimgwabe kiengtie de hing kedine.<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />Pecai David rangdi, “Aika RAMPAUBE Tinggwang kerecaki zieda, Israel ziemne keru recadung teigai kera recabam zieda.”<verse eid="1CH 22:1" /></para>
  <para style="s">Kerecaki ziemne ketelei</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />Cine David pe kilamedung dage Israel deu ga sangme kelungme de ngngwa gwang ngkwa lulo eh aja kaigai. Pa penuide tangtsukang pang kera nlum beu, tangtsu pang takcai lu eh, Tinggwang kerecaki teilu kerane. <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />David gojaldung ziemne kiriedung ga kikamdung ziemne nah kensipdung tei kerane hegeu kekiee ge pwapeu. Pa hetageu mdet canggai kelak kieege pwapeu, <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />nah cedar tsingbangdung peikap gai kelak swa kekiee de si. (Sidonme nah Tyreme cedar tsinglwa peikap gai kelak kieege David da pung gwang beu.) <verse eid="1CH 22:4" /><verse number="5" style="v" sid="1CH 22:5" />David rangdi, “A napei Solomon hena zeu reu nah matei nnim mereu, nah RAMPAUBE ziemne kerecaki teigai kera de peu yisüt kecuge maisia, iciu eh cide kideu pelane ga ndu nah hezuyisüt kecuge teilu kerane. Cine Ih ki cide ziemne telei zie.” Cine David mania kekiee ge pa tsaidi kemak dwa mtei lu.<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />Pecai pa pe napei Solomon de qulu delwe pecu RAMPAUBE, Israel Tinggwang ziemne kerecaki ge tei lulo aja kaigai. <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />David Solomon dage rangdi, “A napei, RAMPAUBE a Tinggwang zi ziemne Ih kerecaki ge teigai kera a lungning la. <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />Dede RAMPAUBE ada gwang delwe rangdi, ‘Nang hejai kekiee ge teilwa dida nah hereudung kekiee ge regi dida. Nang a zi ziemne kerecaki tei lak, kedanemene nang a dwa gade kideu ga hejai kekiee ge teilwadi delu. <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />Iciuliede, nang mipeina ge de mna luzie pa lungciep kepui nage zie. Ih pecu pe ngauraume pelane kehei leune lamde kemtak peu zie. Kedanemene pe zi Solomon zie, nah Ih pe hegwang tingdau lungciep nah ziune kecu Israel de peu zie. <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />Pa a zi ziemne kerecaki ge tei zie. Pa a napei zie nah Ih pe pei zie. Ih pe kedi ria depeu Israel reu kelungta hegwang teizie.’ <verse eid="1CH 22:10" /><verse number="11" style="v" sid="1CH 22:11" />Cu, a napei, peu RAMPAUBE de ncu ngngwala lu nah peu ncu n ta teicang kelube tei lulo. Peu ncu RAMPAUBE n Tinggwang kerecaki tei kelube tei lulo, pa nang tei zielie kerang de nzwa. <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />Peu RAMPAUBE de rünne ncu maci nah macet peu kelube tei lulo, iciu eh nang RAMPAUBE n Tinggwang zai mzailu kerane, pa ncu Israel reu hegwang tei kera kepeu dau. <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />Nang magede RAMPAUBE Israelme ziemne Moses dage kai kebeu hezaidung de sünne eh mzai lucai, nang ngkieng luzie. Ngkienglu nah kuulu. Ngngi diso mede helung ceu diso. <verse eid="1CH 22:13" /><verse number="14" style="v" sid="1CH 22:14" />Cu, pielo, Ih helung kai süt eh RAMPAUBE kerecaki ziemne kecak talent 100,000, rangkanggeu talent million ge, nah hetageu nah hegeu kekiee ge mtei luda. Ih tsing penai tangtsu de si eh mtei luda. Nang ma aidungde pelane reu kaisi maisia reu. <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />Nang heta keteime n da kekiee ge bam: tangtsu kepangme, tangtsu ta keteime, tsingta keteime, nah heciem ta keteime ketsamtsam peigai kelakge bam, <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />kecak, rangkanggeu, hetageu, nah hegeu le heta teilu kebuime bam. Cuhlu eh bata tei mdeu cu, nah RAMPAUBE de peu ncu ngngwala kelube teilu.”<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />David Israel muiteume pelane de pe napei Solomon de ngha beulo aja kaigai eh ainzwa ranggai, <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />“RAMPAUBE n Tinggwang ncu ngngwa la nah kehei leune lamde ncu lungciep peuda. Pa cuikui aika lungh kebamme de a ba gage pwa peu dida. Cuikui de RAMPAUBE nah pe mina dwa kangga lungh dida.” <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />Cu au RAMPAUBE n Tinggwang de nlung pelane nah n keringria teu eh peei lu. Cuhlu eh RAMPAUBE Tinggwang kemci kerecaki tei cu. Iciu lude nang RAMPAUBE samkakbung nah Tinggwang gu niadung RAMPAUBE zi ziemne kerecaki tei kelu gage keugwang gailu bui.<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s">Levimedung</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />David cing di nah pe teilung kekam lebie nna gwang dige, pa pe napei Solomon depeu Israel reu hegwang teilu. <verse eid="1CH 23:1" /><verse number="2" style="v" sid="1CH 23:2" />Pa Israel muiteume pelane, cingkumedung nah Levime de si eh qu hekwalu. <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />Levimedung mmi camrei nah ciswa kecingme pum peilu. Penui pelane ge cang camreieheset. <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />“Aidungde gade, cang ngkaiehmdai cai RAMPAUBE kerecaki ga bata pie rengei kerame, nah cang herok cai kedimedung nah tutiakmedung. <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />Cang mdai cai kirie kekwamedung, nah cang mdai cai ketwa peu kera lei ketei netdung Ih ne tei kelu de pwa RAMPAUBE de ketwa peu kerame,” de eh David ranggai. <verse eid="1CH 23:5" /><verse number="6" style="v" sid="1CH 23:6" />David penuide mzi pwa maa cum teilu Levi pautsa rehi gade: Gershon, Kohath, nah Merari.<verse eid="1CH 23:6" /></para>
  <para style="s">Gershonmedung</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 23:7" />Pautsa Gershon pautsa gade cai, Ladan penai Shimei. <verse eid="1CH 23:7" /><verse number="8" style="v" sid="1CH 23:8" />Ladan napeime hangcum bam: muiteube Jehiel, Zetham, nah Joel. <verse eid="1CH 23:8" /><verse number="9" style="v" sid="1CH 23:9" />Shimei napeime hangcum bam: Shelomoth, Haziel, nah Haran. Aidungde Laban pautsa muiteumedung. <verse eid="1CH 23:9" /><verse number="10" style="v" sid="1CH 23:10" />Shimei napeime hang mdai bam: Jahath, Ziza, Jeush, nah Beriah. <verse eid="1CH 23:10" /><verse number="11" style="v" sid="1CH 23:11" />Jahath cai cingtube, nah pekenabe cai Ziza, dede Jeush penai Beriah penai napeidung kiee ma, cine penui tadung nzwa eh penuide pautsa ge peidi.<verse eid="1CH 23:11" /></para>
  <para style="s">Kohathmedung</para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 23:12" />Kohath napeime hang mdai bam: Amram, Izhar, Hebron, nah Uzziel. <verse eid="1CH 23:12" /><verse number="13" style="v" sid="1CH 23:13" />Aidungde Amram napeidung: Aaron penai Moses. Aaron de peu mcitube niadung keuntsam lu kerane kedetlu, pa nah pe leuhmedung RAMPAUBE dwa perim kehengui ru gai kera, pe gwatei kera nah pezi gade kelungta samlambeu kerane. <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />Dede Tinggwang minabe Moses name de Levime pautsa ga silu. <verse eid="1CH 23:14" /><verse number="15" style="v" sid="1CH 23:15" />Moses napei kena cai Gershom penai Eliezer. <verse eid="1CH 23:15" /><verse number="16" style="v" sid="1CH 23:16" />Gershom leuh cai cingtube Shubael. <verse eid="1CH 23:16" /><verse number="17" style="v" sid="1CH 23:17" />Eliezer leuh cai Rehabiah. Eliezer pe na keda gah, dede Rehabiah leuh mina kiee süt. <verse eid="1CH 23:17" /><verse number="18" style="v" sid="1CH 23:18" />Izhar napei cai Shelomith muiteube. <verse eid="1CH 23:18" /><verse number="19" style="v" sid="1CH 23:19" />Hebron leuhme cai cingtube Jeriah, pekenabe Amariah, pekecumbe Jahaziel, nah pemdaibe Jekameam. <verse eid="1CH 23:19" /><verse number="20" style="v" sid="1CH 23:20" />Uzziel napeime cai cingtube Micah, nah pekenabe Ishijah.<verse eid="1CH 23:20" /></para>
  <para style="s">Merarimedung</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 23:21" />Merari napei kena cai Mahli penai Mushi. Mahli napei kena cai Eleazar penai Kish. <verse eid="1CH 23:21" /><verse number="22" style="v" sid="1CH 23:22" />Eleazar pe napei kette gah eh tsaidi. Pa pe napui rünne bam. Kish napeidung penuide ngngwa lungh di. <verse eid="1CH 23:22" /><verse number="23" style="v" sid="1CH 23:23" />Mushi napei hangcum cai Mahli, Eder, nah Jerimoth. <verse eid="1CH 23:23" /><verse number="24" style="v" sid="1CH 23:24" />Aidungde Levi leuhme penui pautsa rehi gade. Penui au muiteumedung, penuide pei nah penui zi rau kelume, mmi ngkai gade nah penreu lebie gade, RAMPAUBE kerecaki reca ga bata ketei pautsame. <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />Kedanemene David rangdi, “RAMPAUBE, Israel Tinggwang, pe minadung de lungciep peu da. Pa kelungta Jerusalem de pe ki tei zie. <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />Levime RAMPAUBE kebam paiki de nah kereca ga teu kela pe netdung pelane teupwa si dai lakta.” <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />Kedanemene David sam ranglia kamtube gade Levime mmi ngkai nah pe nreu lebieme de peilu. <verse eid="1CH 23:27" /><verse number="28" style="v" sid="1CH 23:28" />Penui tadung cai, Aaron leuhme de RAMPAUBE kerecaki reca ga ngha kera. Penui cai kigudung, kibungdung rengei kera, RAMPAUBE gu kemci netdung pelane tei mci kera, nah Tinggwang kerecaki ga heta keda rengei kerane. <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />Penui reca kebeu tangku de, mei reca ziemne teu kela tokkui de, tsehi kai kemak tangkudung de, ru kelu recadung, maca le haikelu recadung de, nah reca kebeudung pelane rüt teu nah petie pedi leune mdet de de pie rengei la. <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />Penui RAMPAUBE de tingcang ramsangne twa nah tei ndu kera de sapla. Penui tinghegi de aide teila <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />nah Sabbath benai, keici ngyidung ga, nah hengyi tingdau RAMPAUBE de keru recadung keheidau ketei dau teila. Hezai gade nlum kebeu, riem kelu mina riak de RAMPAUBE dwa ga heta tei mui maisia. <verse eid="1CH 23:31" /><verse number="32" style="v" sid="1CH 23:32" />RAMPAUBE kebam paiki, kemci ni rengei kera nah RAMPAUBE kerecaki ga penui kibaume Aaron leuhme de heta ga ngha kera penui de nlum beudi.<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s">Cingkume nzidung</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />Heta ketei hemaadung Aaron leuhme gade cai aidungde: Nadab, Abihu, Eleazar nah Ithamar. <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />Nadab penai Abihu penai pei tsai kedi dwa tsaidi. Penai leuh lungh ma, cine Eleazar penai Ithamar cingkume teidi. <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />David, Eleazar leuhme pei Zadok, nah Ithamar leuhme pei Ahimelech, de ngngwa delwe penui ta cingku ketei tadung ziemne penuide hemaadung gage mzi gailu. <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />Ithamar leuhme kakga swa de Eleazar leuhme kakga mipei teuswa kecume kiee gwa eh la, cine penui Eleazar leuhme de hemaa kereieherok mzilu. Penui aide pautsa peume rehi gade nah Ithamar leuhme gade teilu. Penui pautsa kelak rehi gade, maa heset aidungde mzilu. <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />Penui penuide dacak tei eh ramsiaklu, kedanemene Eleazar leuhme nah Ithamar leuhme kak gade kemci kedimedung nah Tinggwang kedimedung kebamne. <verse eid="1CH 24:5" /><verse number="6" style="v" sid="1CH 24:6" />Eleazar leuhme gade pautsa ge dacak teilu, nah pecai Ithamar leuhme gade penui nlia tei. Levime ge, keraube Nethanel napei Shemaiah, hegwangpei, kedimedung, cingkupei Zadok, Abiathar napei Ahimelech, nah cingkume muiteume nah Levime kelakdung dwa gade penui zidung raulu.<verse eid="1CH 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 24:7" />Dacak keraibe Jehoiarib da gwang, pekenabe Jedaiah, <verse eid="1CH 24:7" /><verse number="8" style="v" sid="1CH 24:8" />pekecumbe Harim, pemdaibe Seorim, <verse eid="1CH 24:8" /><verse number="9" style="v" sid="1CH 24:9" />pemengeibe Malkijah, peherokbe Mijamin, <verse eid="1CH 24:9" /><verse number="10" style="v" sid="1CH 24:10" />pehenabe Hakkoz, pehesetbe Abijah, <verse eid="1CH 24:10" /><verse number="11" style="v" sid="1CH 24:11" />pehekuibe Jeshua, pekereibe Shecaniah, <verse eid="1CH 24:11" /><verse number="12" style="v" sid="1CH 24:12" />kereiehketbe Eliashib, kereiehkenabe Jakim, <verse eid="1CH 24:12" /><verse number="13" style="v" sid="1CH 24:13" />kereiehkecumbe Huppah, kereiehmdaibe Jeshebeab, <verse eid="1CH 24:13" /><verse number="14" style="v" sid="1CH 24:14" />kereiemengeibe Bilgah, kereieherokbe Immer, <verse eid="1CH 24:14" /><verse number="15" style="v" sid="1CH 24:15" />kereiehenabe Hezir, kereiehesetbe Happizzez, <verse eid="1CH 24:15" /><verse number="16" style="v" sid="1CH 24:16" />kereiehekuibe Pethahiah, ngkaibe Jehezkel, <verse eid="1CH 24:16" /><verse number="17" style="v" sid="1CH 24:17" />ngkaiehketbe Jakin, ngkaiehkenabe Gamul, <verse eid="1CH 24:17" /><verse number="18" style="v" sid="1CH 24:18" />ngkaiehkecumbe Delaiah, nah ngkaiehmdaibe Maaziah. <verse eid="1CH 24:18" /><verse number="19" style="v" sid="1CH 24:19" />Aide penui ta rehi gade, penui pau Aaron, RAMPAUBE, Israel Tinggwang pecu aja kai kebeu nzwa, penuide pwa kepeu de mzai eh penui RAMPAUBE kerecaki ga gwang keludau.<verse eid="1CH 24:19" /></para>
  <para style="s">Levime kedadung</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 24:20" />Aidungde Levi leuhme kedame pelane: Amram leuhme gade, Shubael; Shubael leuhme gade Jehdeiah. <verse eid="1CH 24:20" /><verse number="21" style="v" sid="1CH 24:21" />Rehabiah ziemne cai, Rehabiah leuhme: muiteube Ishijah. <verse eid="1CH 24:21" /><verse number="22" style="v" sid="1CH 24:22" />Izhar leuhme gade: Shelomoth; Shelomoth leuhme gade: Jahath. <verse eid="1CH 24:22" /><verse number="23" style="v" sid="1CH 24:23" />Hebron napeidung: muiteube Jeriah, pekenabe Amariah, pekecumbe Jahaziel, nah pemdaibe Jekameam. <verse eid="1CH 24:23" /><verse number="24" style="v" sid="1CH 24:24" />Uzziel leuh: Micah; Micah leuhme gade: Shamir. <verse eid="1CH 24:24" /><verse number="25" style="v" sid="1CH 24:25" />Micah sinabe: Ishijah. Ishijah leuhme gade: Zechariah. <verse eid="1CH 24:25" /><verse number="26" style="v" sid="1CH 24:26" />Merari leuhme gade: Mahli penai Mushi; Jaaziah leuhme gade: Beno. <verse eid="1CH 24:26" /><verse number="27" style="v" sid="1CH 24:27" />Merari leuhme Jaaziah gade: Beno, Shoham, Zaccur, nah Ibri. <verse eid="1CH 24:27" /><verse number="28" style="v" sid="1CH 24:28" />Mahli gade: Eleazar, pa pe napeidung lungh ma. <verse eid="1CH 24:28" /><verse number="29" style="v" sid="1CH 24:29" />Kish gade: Kish napei: Jerahmeel. <verse eid="1CH 24:29" /><verse number="30" style="v" sid="1CH 24:30" />Mushi napeime: Mahli, Eder, nah Jerimoth. Aidungde Levime, penui kelakdung ria gade rau keludung. <verse eid="1CH 24:30" /><verse number="31" style="v" sid="1CH 24:31" />Mina aidungde penui kelak ramsang nah penui caihereimedung ramsang peumedung, Hegwangpei David, nah Zadok nah Ahimelech, cingkume nah Levime kelak muiteumedung de si eh penui dwa gade dacak teilu. Aaron leuhme ketei nzwa penui dacak teilu.<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s">Lei keteimedung</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />David nah reugwamaa muiteume Asaph pautsa gade kangge de nah Heman nah Jeduthun de kedetlu, penui leibungdung le nah peria ketei leibung le nah ntwaidung pwa si eh zierang tei kerane. Aipau ta keteime zidung: <verse eid="1CH 25:1" /><verse number="2" style="v" sid="1CH 25:2" />Asaph napeimedung gade: Zaccur, Joseph, Nethaniah, nah Asharelah, <note caller="+" style="f"><char style="ft" closed="false">Aipau pei de 1 Heleuhha 25:14 ga Jesarelah de kecube de da.</char></note> Asaph napeidung, Asaph puisau kangga de, hegwangpei kangga de caihasam rang kecume. <verse eid="1CH 25:2" /><verse number="3" style="v" sid="1CH 25:3" />Jeduthun napeidung gade pelane ge hang herok: Gedaliah, Zeri, <note caller="+" style="f"><char style="ft" closed="false">Aide Zeri de kecu kedabe 1 Heleuhha 25:11 ga bam, nah aide hangge de rangbam. </char></note> Jeshaiah, Shimei, Hashabiah, nah Mattithiah, penui pei Jeduthun puisau kangga de, penui RAMPAUBE de twa eh ketwa lei ketei ziemne leibung kekwame. <verse eid="1CH 25:3" /><verse number="4" style="v" sid="1CH 25:4" />Heman napeidung gade: Bukkiah, Mattaniah, Uzziel, <note caller="+" style="f"><char style="ft" closed="false">Uzziel de 1 Heleuhha 25:18 ga Azarel de kecube de da. </char></note> Shubael, nah Jerimoth, Hananiah, Hanani, Eliathah, Giddalti, Romamti-Ezer, Joshbekashah, Mallothi, Hothir, nah Mahazioth. <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />Aidungde pelane hegwangpei caihakecibe Heman napeidung. Tinggwang Heman de pe napei kereiehmdai nah pe napui hangcum pwapeu, pecu tei ngkinglu kerane. <verse eid="1CH 25:5" /><verse number="6" style="v" sid="1CH 25:6" />Mina aidungde pelane penui peime puisau mzui. Penui au RAMPAUBE kerecaki ga leibungdung kekwamedung, ntwaidung kediang nah peria ketei leibung kwa eh penui Tinggwang kerecaki ga heta tei. Asaph, Jeduthun, nah Heman cai hegwangpei kangga de bata tei. <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />Penui nah penui zangmedung leiciem kecime nah RAMPAUBE dage lei teigai kera heteu kelume cai 288. <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />Penui nlum kebeu penui tadung tei kerane dacak teilu, pelane de, hename de nah kecingme de, keledeume de nah kepeime de. <verse eid="1CH 25:8" /><verse number="9" style="v" sid="1CH 25:9" />Cu Asaph napeidung gade: dacak raitube Joseph kelak da gwang lu; pekenabe Gedaliah kelak da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:9" /><verse number="10" style="v" sid="1CH 25:10" />pekecumbe Zaccur, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:10" /><verse number="11" style="v" sid="1CH 25:11" />pemdaibe Izri, <note caller="+" style="f"><char style="ft" closed="false">Aide Zeri de kecu kedabe 1 Heleuhha 25:3 ga bam, nah aide hangge de rangbam. </char></note> pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:11" /><verse number="12" style="v" sid="1CH 25:12" />pemengeibe Nethaniah, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:12" /><verse number="13" style="v" sid="1CH 25:13" />peherokbe Bukkiah, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:13" /><verse number="14" style="v" sid="1CH 25:14" />pehenabe Jesarelah, <note caller="+" style="f"><char style="ft" closed="false">Aide 1 Heleuhha 25:2 ga Asharelah de kecube de da. </char></note> pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:14" /><verse number="15" style="v" sid="1CH 25:15" />pehesetbe Jeshaiah, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:15" /><verse number="16" style="v" sid="1CH 25:16" />pehekuibe Mattaniah, pe namedung nah pe kibaumedung, pelane ge mina kereiehkena; <verse eid="1CH 25:16" /><verse number="17" style="v" sid="1CH 25:17" />kereibe Shimei, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:17" /><verse number="18" style="v" sid="1CH 25:18" />kereiehketbe Azarel, <note caller="+" style="f"><char style="ft" closed="false">Aide 1 Heleuhha 25:4 ga Uzziel de kecube de da. </char></note> pe namedung nah pe kibaumedung da gwanglu, mina pelane ge kereiehkena; <verse eid="1CH 25:18" /><verse number="19" style="v" sid="1CH 25:19" />kereiehkenabe Hashabiah, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:19" /><verse number="20" style="v" sid="1CH 25:20" />kereiehkecumbe Shubael, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:20" /><verse number="21" style="v" sid="1CH 25:21" />kereiehmdaibe Mattithiah, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:21" /><verse number="22" style="v" sid="1CH 25:22" />kereiehmengeibe Jerimoth, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:22" /><verse number="23" style="v" sid="1CH 25:23" />kereieherokbe Hananiah, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:23" /><verse number="24" style="v" sid="1CH 25:24" />kereiehenabe Joshbekashah, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:24" /><verse number="25" style="v" sid="1CH 25:25" />kereiehesetbe Hanani, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:25" /><verse number="26" style="v" sid="1CH 25:26" />kereiehekuibe Mallothi, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:26" /><verse number="27" style="v" sid="1CH 25:27" />kereiehngkaibe Eliathah, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:27" /><verse number="28" style="v" sid="1CH 25:28" />ngkaiehketbe Hothir, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:28" /><verse number="29" style="v" sid="1CH 25:29" />ngkaiehkenabe Giddalti, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:29" /><verse number="30" style="v" sid="1CH 25:30" />ngkaiehkecumbe Mahazioth, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena; <verse eid="1CH 25:30" /><verse number="31" style="v" sid="1CH 25:31" />ngkaiehmdaibe Romamti-Ezer, pe namedung nah pe kibaumedung da gwanglu, pelane ge mina kereiehkena.<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s">Herieki kekwamedung</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1" />Aidungde kirie kekwame mzidung: Korah pautsa gade, Kore napei Meshelemiah, Asaph leuhme ge. <note caller="+" style="f"><char style="ft" closed="false">Asaph aide </char><char style="fqa">Ebiasaph de eh </char> 1 Heleuhha 9:19 ga kebam de da. </note> <verse eid="1CH 26:1" /><verse number="2" style="v" sid="1CH 26:2" />Meshelemiah pe na <note caller="+" style="f"><char style="ft" closed="false">Meshelemiah aide </char><char style="fqa">Shelemiah </char> de eh 1 Heleuhha 26:14 ga kebam de da. </note> mipeinadung bam: neraibe Zechariah, pekenabe Jediael, pekecumbe Zebadiah, pemdaibe Jathniel, <verse eid="1CH 26:2" /><verse number="3" style="v" sid="1CH 26:3" />pemengeibe Elam, peherokbe Jehohanan, pehenabe Eliehoenai. <verse eid="1CH 26:3" /><verse number="4" style="v" sid="1CH 26:4" />Obed Edom pe na bam: Neraibe Shemaiah, pekenabe Jehozabad, pekecumbe Joah, nah pemdaibe Sakar, nah pemengeibe Nethanel, <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />peherokbe Ammiel, pehenabe Issachar, pehesetbe Peullethai, kedanemene Tinggwang Obed Edom de samlam kebeune. <verse eid="1CH 26:5" /><verse number="6" style="v" sid="1CH 26:6" />Pe napei Shemaiah pe napeidung lunghlu, penui kelakdung reu peu keteume; penui au ma ketsamtsam tei kecimedung. <verse eid="1CH 26:6" /><verse number="7" style="v" sid="1CH 26:7" />Shemaiah napeidung cai Othni, Rephael, Obed, nah Elzabad. Pe kibaume Elihu penai Semakiah de ma ketsamtsam tei kecime. <verse eid="1CH 26:7" /><verse number="8" style="v" sid="1CH 26:8" />Aidungde pelane Obed Edom leuhmedung. Penui nah penui napeidung nah kibaumedung au Tinggwang kebam paiki ga penui tadung teilu kebuimedung. Cika Obed Edom kibaume mina riakherokehkena bam. <verse eid="1CH 26:8" /><verse number="9" style="v" sid="1CH 26:9" />Meshelemiah pe napeidung nah pe kibaumedung, mina ma teilu kebuime pelane ge kereieheset bam. <verse eid="1CH 26:9" /><verse number="10" style="v" sid="1CH 26:10" />Hosah, Merari leuhme ge, pe napeidung bam: Shimri muiteube (pa neraibe meliede, pe pei pecu muiteube teilu),<verse eid="1CH 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 26:11" />pekenabe Hilkiah, pekecumbe Tebaliah, pemdaibe Zechariah. Hosah napeidung nah pe kibaume pelane ge mina kereiehkecum.<verse eid="1CH 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 26:12" />Aidungde kirie kekwame mzidung, penui muiteumedung ria gade, penui kibaumedung nzwa, RAMPAUBE kerecaki ga bata tei kera penui ndwa zie da. <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />Penui kelak rehi gade, hecing hena tei mene, kirieki leune ziemne penui dacak gai. <verse eid="1CH 26:13" /><verse number="14" style="v" sid="1CH 26:14" />Naimiak kepetle rieki ziemne dacak keteidau, Shelemiah da gwanglu. <note caller="+" style="f"><char style="ft" closed="false">Shelemiah aide </char><char style="fqa">Meshelemiah </char> de eh 1 Heleuhha 26:2 ga kebam de da. </note> Pecai penui pe napei Zechariah ziemne dacak tei, kemteu keledeube, nah pa tingtünle rieki de ngaulu. <verse eid="1CH 26:14" /><verse number="15" style="v" sid="1CH 26:15" />Obed Edom de tingbangle kirie de nlum beudi, nah pe napeidung de mania kibungdung nlum beudi. <verse eid="1CH 26:15" /><verse number="16" style="v" sid="1CH 26:16" />Shuppim penai Hosah de naimiak kenlütle rieki lampui nreule ga Shalleketh rieki de si eh nlum beudi. Kelak leune ziemne kekwa ta ramsiak beudi. <verse eid="1CH 26:16" /><verse number="17" style="v" sid="1CH 26:17" />Naimiak kepetle bie cai Levime hang herok, tingtünle tingba ramsangne hang mdai, tingbangle tingba ramsangme hang mdai bamla, nah mania kibungdung ga hang nana bamla. <verse eid="1CH 26:17" /><verse number="18" style="v" sid="1CH 26:18" />Naimiak kenlütle tsia taiga lampuiki kangga kekwame hang mdai nah hetsia ga hang na bamla. <note caller="+" style="f"><char style="ft" closed="false">“Hetsia” de kecu sam de kesa laisiudung ga “parbar,” de keula. Aipau sam de Samkakkelu Kehegwabe ga aika nah 2 Hegwangme 23:11 ga rünne gwale gah. Aipau sam de pekie mci lu ma. </char></note> <verse eid="1CH 26:18" /><verse number="19" style="v" sid="1CH 26:19" />Aidungde rieki kekwame mzidung. Cidung ga Korah nah Merari leuhme ne pui bam.<verse eid="1CH 26:19" /></para>
  <para style="s">Rangkang keteume nah heta keda keteime</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />Levime kakgade, Ahijah ne Tinggwang kerecaki mabam nah RAMPAUBE de tei mci gaibeu kedi niadung pie rengeila. <verse eid="1CH 26:20" /><verse number="21" style="v" sid="1CH 26:21" />Ladan leuhme, Ladan dade lungh gwang eh Gershonme tei kelu nah Gershonme pei Ladan kelakdung muiteu keteime cai Jehieli <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" />nah Jehieli napei kena: Zetham penai pe sinabe Joel. Penai RAMPAUBE kerecaki mabam mania kibungdung pie rengeila. <verse eid="1CH 26:22" /><verse number="23" style="v" sid="1CH 26:23" />Amram pautsa, Izhar pautsa, Hebron pautsa, nah Uzziel pautsadung gade: <verse eid="1CH 26:23" /><verse number="24" style="v" sid="1CH 26:24" />Shubael Gershom pautsa gade lungh kegwangbe Moses napei, ne kerecaki mabam kibungdung reu kerengei ditube tei. <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" />Pe kibaumedung Eliezer pautsa gade cai pe napei Rehabiah, Rehabiah napei Jeshaiah, Jeshaiah napei Joram, Joram napei Zichri, nah Zichri napei Shelomith. <verse eid="1CH 26:25" /><verse number="26" style="v" sid="1CH 26:26" />Shelomith nah pe kibaumedung RAMPAUBE de tei mci kebeu niadung kekai kibungdung pelane, Hegwangpei David, kelak muiteumedung, pehai pecang reu muibedung, nah reugwamaa muibedung ne teu tsam kedidung de pie rengeila. <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />Penui hereudung gade hema tui keludung de RAMPAUBE kerecaki teu rengei kerane keu tsamlu. <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />Penui caihakecibe Samuel, Kish napei Saul, Ner napei Abner, nah Zeruiah napei Joab ne ma pelane RAMPAUBE ziemne tei mci keludung de pie rengeila. Ma pelane RAMPAUBE ziemne teu tsam mpet kelube Shelomith nah pe kibaume ne pie rengei bamla.<verse eid="1CH 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 26:29" />Izhar leuhmedung kakgade, Kenaniah nah pe napeidung ne Israel hemaabe de pie kerengei de rengeila. Penui au kedime nah tutiakmedung. <verse eid="1CH 26:29" /><verse number="30" style="v" sid="1CH 26:30" />Hebron leuhmedung kakgade, Hashabiah nah pe sinamedung, 1,700 ma teilu kebuime, penui ne RAMPAUBE ta nah hegwangpei ta pie rengei la. Penui Jordan reuki naimiak kenlütle bam. <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />Hebron leuhmedung kakgade, paupak ria gade pei nghung eh, Jeriah ne pe leuhmedung muiteube tei. David hegwang tei kelu mmi riakdai bekum, penui rau kenzeudung de piegwang nah cidungde kakga teilu kebuime ge Gileadme Jazer ga ngaulu. <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />Jeriah pe kibaume mina 2,700 bam, penui au teilu kebuime kelak muiteudung. David penuide Tinggwang renet ta ketsamtsam leune nah hegwang ta ziemne Reuben nah Gad pautsadung, nah Manasseh pempie pautsa reu kepieme teilu.<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s">Reugwa nzidung</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1" />Hezi kerau aidungde Israelme kelak muiteumedung, pehai nah pecang reugwamaa muibedung, nah reugwamaa reu kedime hegwangpei kangga heta ketsamtsam keteime de si. Reugwamaa mzi ketsamtsam keige cai keige eh mmi ge heta tei gwang. Reugwamaa ramsang ga mina cang ngkaiehmdai bam. <verse eid="1CH 27:1" /><verse number="2" style="v" sid="1CH 27:2" />Kei raitube ga aja keteube cai Zabdiel napei Jashobeam. Pe mzi ga mina cang ngkaiehmdai bam. <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />Pa au Perez leuhme ge nah kei ge bekei ziemne regwame kedime pelane de pie rengei. <verse eid="1CH 27:3" /><verse number="4" style="v" sid="1CH 27:4" />Kei na bekei aja keteube cai Dodai, Ahoah pautsa dade lungh nghung kelu. Pe kangga cai Mikloth. Pe mzi ga mina cang ngkaiehmdai bam. <verse eid="1CH 27:4" /><verse number="5" style="v" sid="1CH 27:5" />Kei cum bekei regwamaa muibe cai Jehoiada napei Benaiah, cingkupei ge nah muiteube ge. Pe mzi ga mina cang ngkaiehmdai bam. <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />Aide Benaiah, pa cai camrei, nah camrei reu muiteube. Pe napei Ammizabad pe mzi ga bam. <verse eid="1CH 27:6" /><verse number="7" style="v" sid="1CH 27:7" />Kei mdai bekei ziemne reugwamaa muibe cai Asahel Joab sinabe. Asahel napei Zebadiah ne pecai reugwamuibe teilu. Pe mzi ga mina cang ngkaiehmdai bam. <verse eid="1CH 27:7" /><verse number="8" style="v" sid="1CH 27:8" />Kei mengei bekei reugwamuibe cai Shamhuth, Izrah leuhme ge. Pe mzi ga mina cang ngkaiehmdai bam. <verse eid="1CH 27:8" /><verse number="9" style="v" sid="1CH 27:9" />Kei herok bekei Tekoa gade reugwamuibe cai Ikkesh napei Ira. Pe mzi ga mina cang ngkaiehmdai bam. <verse eid="1CH 27:9" /><verse number="10" style="v" sid="1CH 27:10" />Kei hena bekei Ephraimme gade reugwamuibe cai Helez, Pelonme. Pe mzi ga mina cang ngkaiehmdai bam. <verse eid="1CH 27:10" /><verse number="11" style="v" sid="1CH 27:11" />Kei heset bekei reugwamuibe cai Sibbekai, Hushathme, Zerah pautsa gade lungh gwang kelu. Pe mzi ga mina cang ngkaiehmdai bam. <verse eid="1CH 27:11" /><verse number="12" style="v" sid="1CH 27:12" />Kei hekui bekei reugwamuibe cai Abiezer, Anathothme, Benjamin leuhme gade. Pe mzi ga mina cang ngkaiehmdai bam. <verse eid="1CH 27:12" /><verse number="13" style="v" sid="1CH 27:13" />Kei kerei bekei reugwamuibe cai Maharai, Netophah namdi gade. Zerah pautsa gade lungh gwang kelu. Pe mzi ga mina cang ngkaiehmdai bam. <verse eid="1CH 27:13" /><verse number="14" style="v" sid="1CH 27:14" />Kei kereiehket bekei reugwamuibe cai Benaiah, Pirathon namdi gade, Ephraim leuhme gade. Pe mzi ga mina cang ngkaiehmdai bam. <verse eid="1CH 27:14" /><verse number="15" style="v" sid="1CH 27:15" />Kei kereiehkena bekei reugwamuibe cai Heldai, Netophah namdi gade, Othniel pautsa gade lung gwang kelu. Pe mzi ga mina cang ngkaiehmdai bam.<verse eid="1CH 27:15" /></para>
  <para style="s">Heleuhdung reu kedime</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 27:16" />Aidungde Israel leuh muiteumedung: Reuben leuh gade, Zichri napei Eliezer ne muiteube. Simeon leuh gade, Maacah napei Shephatiah ne muiteube. <verse eid="1CH 27:16" /><verse number="17" style="v" sid="1CH 27:17" />Levi leuh gade, Kemuel napei Hashabiah ne muiteube, nah Zadok ne Aaron leuhme de teuswa beu. <verse eid="1CH 27:17" /><verse number="18" style="v" sid="1CH 27:18" />Judah leuh gade, Elihu David sinabe hangge, ne muiteube. Issachar leuh gade, Michael napei Omri ne muiteube. <verse eid="1CH 27:18" /><verse number="19" style="v" sid="1CH 27:19" />Zebulun leuh gade, Obadiah napei Ishmaiah ne muiteube. Naphtali leuh gade, Azriel napei Jerimoth ne muiteube. <verse eid="1CH 27:19" /><verse number="20" style="v" sid="1CH 27:20" />Ephraim leuh gade, Azaziah napei Hoshea ne muiteube. Manasseh leuh pempie gade, Pedaiah napei Joel ne muiteube. <verse eid="1CH 27:20" /><verse number="21" style="v" sid="1CH 27:21" />Gilead ga Manasseh leuh pempie gade, Zechariah napei Iddo ne muiteube. Benjamin leuh gade, Abner napei Jaasiel ne muiteube. <verse eid="1CH 27:21" /><verse number="22" style="v" sid="1CH 27:22" />Dan leuh gade, Jeroham napei Azarel ne muiteube. Aidungde Israelme leuhdung muiteumedung. <verse eid="1CH 27:22" /><verse number="23" style="v" sid="1CH 27:23" />David mina mmi ngkai mede ciswa kehename de pei mah, kedanemene RAMPAUBE Israelme de tinggim ga hegidung nzwa kieege teibeu zie lie pe sam pet kebeune. <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />Zeruiah napei Joab mina de pei cuh, dede cide teicang lumah. Aide ziemne Israelme da Tinggwang rata gwangdi. Hegwangpei David kerau laisiu gage dai kieege siak bi kecu raupwa lama.<verse eid="1CH 27:24" /></para>
  <para style="s">Hegwangpei kangga kedimedung</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 27:25" />Adiel napei Azmaveth Hegwang gu mabamdung pie rengei la. Uzziah napei Jonathan luhdung ga, namdidung ga nah renamdung ga, nah kudadung ga mabam kidung pie rengei la. <verse eid="1CH 27:25" /><verse number="26" style="v" sid="1CH 27:26" />Kelub napei Ezri hangdeu heta ketamedung reu pie kerengeibe. <verse eid="1CH 27:26" /><verse number="27" style="v" sid="1CH 27:27" />Shimei Ramahme, kubeluh dungde pie, nah Zabdi Shephamme, kubetsi nah zaukidung de pie. <verse eid="1CH 27:27" /><verse number="28" style="v" sid="1CH 27:28" />Olive bangdung nah caimun bangdung langkie ga kebamdung reu cai Gederme Baal-Hanan, nah maca kekwaki reu cai Joash. <verse eid="1CH 27:28" /><verse number="29" style="v" sid="1CH 27:29" />Sharon langkie reuga kebam ketumdung cai Sharon gade kegwang Shitrai, nah langkamdung reuga kebam ketumdung cai Adlai napei Shaphat. <verse eid="1CH 27:29" /><verse number="30" style="v" sid="1CH 27:30" />Utdung reu cai Obil Ishmaelme, nah gada puidung reu cai Meronoth gade Jehdeiah. Hemeudung reu cai Jaziz Hagritme. <verse eid="1CH 27:30" /><verse number="31" style="v" sid="1CH 27:31" />Jaziz Hagritme, hemeudung de pie rengei la. Kedime aipaudung pelane Hegwangpei David mabam pie rengei la.<verse eid="1CH 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 27:32" />Jonathan, David pei sinabe cai keledeube, pa au makecime nah laisiu kecime kecune. Hakmoni napei Jehiel hegwangpei napeidung de pie rengei. <verse eid="1CH 27:32" /><verse number="33" style="v" sid="1CH 27:33" />Ahithophel cai hegwangpei keledeube, nah Arkme pei Hushai cai hegwangpei gu kengkim keledeube. <verse eid="1CH 27:33" /><verse number="34" style="v" sid="1CH 27:34" />Ahithophel bam de Benaiah napei Jehoiada ne nah Abiathar ne leu pwadi. Joab ne hegwang reugwamaa muibe tei.<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s">Kerecaki ziemne David tariem</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />David Israel ga kedime pelane de Jerusalem gage ngngwa gwang ngkwa gailu: heleuhdung gade kedime, hegwangram ga penui gwangpei ta teikela kedime, nah pehai nah pecang reu reugwamaa muibedung, hegwangpei nah pe napeidung mabam nah mahei pelane reu pie keregeime, nah kedimedung nah reugwa kengkiengme, mata tei kecime de si eh. <verse eid="1CH 28:1" /><verse number="2" style="v" sid="1CH 28:2" />Pecai hegwangpei David cuh saplu eh ranggai, “A kwa kingneilu, a sinamedung nah a rammenadung. RAMPAUBE samkakbung ziemne kerecaki tei kerade a kecet; anui Tinggwang ziemne pidaubam ge, nah Ih cide tei kera mtei luda. <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />Dede Tinggwang a dage rangdi, ‘Nang a zi ziemne kerecaki tei lak, kedanemene nang reugwame ge nah hejai teilwe ham kedine.’ <verse eid="1CH 28:3" /><verse number="4" style="v" sid="1CH 28:4" />Iciude RAMPAUBE, Israel Tinggwang, acu a paume kelak pelane reu de Israel reu hegwang kelungta tei kera kedetlu. Pa Judah leuh de peu muiteu tei kera kedetlu. Judah leuh gade, nah a pei kelak gade, nah apei napeimedung pelane kakgade, pa acu Israel pelane reu hegwang tei kera kedetlu. <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />RAMPAUBE acu a na mipeina kekiee ge kepeu gade, pa a napei, Solomon de kedetlu, Israel reu hegwang tei eh RAMPAUBE hegwangram bam ga bam kerane. <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />Pa a dage ranggai, ‘N napei Solomon ne a ki nah a kigudung tei zie, kedanemene Ih pecu a na tei kera kedet luda, nah Ih pe pei tei zie. <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />Pa cu nang nzwa eh a zaidung nah a ajadung mzai jüja bam lucai Ih pe hegwangram kelungta bam lu kera tei beuzie.’ <verse eid="1CH 28:7" /><verse number="8" style="v" sid="1CH 28:8" />Cine cu, anui Tinggwang dwa gade nah RAMPAUBE ziemne ngkwa kebam aide, Israelme pelane miakngau gade, nnui pelane RAMPAUBE nnui Tinggwang ajadung kaikebeu de pelane mzai lu maisia. Aide tei lu iciu eh nnui hangdeu keyi aide gumlu kerane nah nnui cai nnui namedung dage cide peu kelungta mabam pwaleu lu kerane.<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />N ziemne, a napei Solomon, n pei Tinggwang samzai tei lulo nah n mlung pelane teu nah neungga eh pe gwatei lulo. Aide teilu kedanemene RAMPAUBE lungcet leune peeila nah mileune luuneu pelane cibam. Nang peda gwanglu cai, pa ncu luu luzie, dede nang pe dade nreu dicai, pa kelungta ncu gi dizie. <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />RAMPAUBE ncu kerecaki aide pe kemciki tei kerane kedet kelu ci lulo. Ntip lu nah cide teilu.”<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />Pecai David pe napei Solomon de kerecaki kigu, kerecaki kidung, mania kibungdung nah nreube kibungdung, helungbe kibungdung, nah kemau ratak ketei bam kebam kibung, mariem de pwabeu. <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />Pa RAMPAUBE ki kigudung nah twakengwa kibungdung pelane, nah Tinggwang ki ga mania kibungdung, nah RAMPAUBE dage tei mci gai kebeu mapeudung de kekai kibungdung, pa riempwa kebam de pecu pwabeu. <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />Pa cingkumedung nah Levimedung penui ta tei kera tadung, nah RAMPAUBE ki ta tei kera nlum kebeu tadung nah maniadung pelane RAMPAUBE ki ga teu heta tei kera zaidung pecu pwabeu. <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />Pa kecak lidung heta ketsamtsam ziemne perüt dai kieege maisiabi kecu, nah rangkanggeu lidung heta ketsamtsam ziemne perüt dai kieege maisiabi kecu ranglia, <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />mitaubung bam nah kecak mitaubung ziemne kecak rüt, kecak li pelane ziemne, kecak rüt mitaubung bam ketket ziemne, rangkanggeu rüt mitaubungbam ketket ziemne, kereca ga mitaubung bam teu heta ketei rehi gade. <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />Pa Tinggwang de reca kebeu tangku kekaibamdung ziemne kecak perüt dai kieege maisiabi ranglia beu, mabam leune ziemne, nah rangkanggeu bam ziemne rangkanggeu perüt daikiee maisiabi ranglia beu. <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />Pa kecak kemci be perüt dai kenzwage teu hegeutia, hekwak nah duibungdung tei ziebi kecu pwapeu. Pa kecak kwakdung ket ziemne perüt daikenzwa ge, nah rangkanggeu kwakdung ket ziemne perüt dai kenzwage ge teu maisiabi kecu ranglia beu. <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />Pa kehengui reca bam ziemne kecak kenci perüt dai kenzwa ge teu maisiabi, nah cherubim RAMPAUBE samkakbung de penai hesiu le gumpwa bam kelade kecak perehi dainzwa ziebi pwapeu. <verse eid="1CH 28:18" /><verse number="19" style="v" sid="1CH 28:19" />David rangdi, “Ih aidungde pelane kerau ga peu bam luda, RAMPAUBE ne acu tei lulo eh sam kaikebeu nzwa, nah perehi de peu cet ci kelu nzwa.”<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />David pe napei Solomon dage rangdi, “Ngkienglu nah kuulu. Bata be tei cuhlu. Ngngi diso mede nlung keherei diso, kedanemene RAMPAUBE Tinggwang, a Tinggwang, ncu ngngwa lalu. Pa ncu gidi lak mede pütdi lak, nang RAMPAUBE kerecaki bata leune teicanglu kemaktane. <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />Ainie, cingkume nah Levime mzidung Tinggwang kerecaki ga heta leune tei kera aika bamda. Penui ncu ngngwala zie, bata tei kecime nah ngha neu kebamme leune de si eh, heta ketei ga ncu ngha kera nah heta tei kerane. Kedimedung nah mina pelane n ajadung mzai kera mtei luda.”<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s">Kerecaki teikerane mapeudung</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />Hegwangpei David mina pelane ngkwa dage rangdi, “A napei Solomon, Tinggwang ne kedetkelube, hena au reu nah matei mnim mereu, nah heta tei kera de au di ham zeu. Kedanemene kerecaki de au mina ziemne ma dede RAMPAUBE Tinggwang ziemne. <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />Cine a Tinggwang kerecaki ziemne Ih teilu kebui kiee ge mania mteibeu dida. Ih kecak peugai, kecak le tei kerabedung ziemne, rangkanggeu le tei kerabedung ziemne rangkanggeu, hetageu le tei kerabedung ziemne hetageu, hegeu le tei kerabedung ziemne hegeu, nah tsing le tei kerabedung ziemne tsing. Ih tangtsu ketiak kemzaibe de peugai la, tangtsudung kam kerane, tangtsu pegiak ketsamtsam teu mata tei kerane, pemikehung tangtsu leune, nah hengam tsu kekieege. <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />Cu, kedanemene a Tinggwang ki de a sui kecune, Ih akatei a mabam gade kecak nah rangkanggeu cide ziemne peubam. Ih kemci kerecaki ziemne mteibeu kecu pelane peureu liede Ih aide teibam: <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />Ophir gade kecak talent cangcum ge, nah rangkanggeu yitube talent cang hena, kidung tangdeu pwa kamlu kerane. <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />Ih kecak peu dida kecak le tei kerabedung ziemne, nah rangkanggeu le tei kerabedung ziemne rangkanggeu, nah heciem keteime ne heta ketsamdung pelane tei kera ziemne pe netdung. Caudung henai RAMPAUBE de ma peugai neula reu no nah pe da gwangneu no?”<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />Pecai suiyi makai tei beu penui paume kilungme muiteume ne, Israelme leuh muiteumedung, reugwamaa muidung cang nah hai reu kedime, nah hegwangpei kangga kedime ne. <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />Tinggwang ki ta ziemne penui talent cang mengei peu nah kecak daric cang kerei, rangkanggeu talent cang kerei, hetageu talent cang kereieheset, nah hegeu talent 100,000. <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />Tangtsu pemi kehungbe kebamme cidungde RAMPAUBE ki mabamki gage pwa peu, Gershon pautsa gade lungh kegwang Jehiel ne rengei. <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />Minadung penui sui yidi suiyi makai aidungde ziemne, kedanemene penui neungga eh RAMPAUBE de pwa peu kecune. Hegwangpei David liede pe sui yisüt di.<verse eid="1CH 29:9" /></para>
  <para style="s">David kekie</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />Mina pelane ngkwa dwa gade David RAMPAUBE de samlam beu. Pa ranggai, “Peu ncu twa kelube teilo, RAMPAUBE, anui paume Israel Tinggwang, kelungta. <verse eid="1CH 29:10" /><verse number="11" style="v" sid="1CH 29:11" />RAMPAUBO, kedi, kengkieng, kendu, ngamkelu, nah hecili kecu au ngu lie. Kedanemene tinggim nah kideu ga mapelane ngu. Hegwangram au ngu, RAMPAUBO, nah mapelane reu nang ditube.<note caller="-" style="x"><char style="xo" closed="false">29:11 </char><char style="xt" closed="false"><ref loc="REV 5:12">Keu. 5:12</ref>,<ref loc="REV 5:13">13</ref></char></note> <verse eid="1CH 29:11" /><verse number="12" style="v" sid="1CH 29:12" />Mahei nah herüt kenana de n dade gwangla, nah nang mina pelane reu hegwang tei. N ba ga kengkieng nah pumci bam. Nang au mina de tei mdi lu kebui kengkieng nah pumci bam nah keheibe de de kengkieng pwapeu lubui. <verse eid="1CH 29:12" /><verse number="13" style="v" sid="1CH 29:13" />Cu cine, anui Tinggwang, anui ncu ketwa peula nah n zi kendu de twala. <verse eid="1CH 29:13" /><verse number="14" style="v" sid="1CH 29:14" />Dede Ih cau no, nah a mina cau no, ma aidungde anui neungga eh pwa peulu kera? Kesang, maleune n dade gwangla, nah anui dai ngu bi ncu pwapeu dai gaila. <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />Kedanemene anui au n dwa gade anui paume nzwa eh langgi kedime nah sangme ge. Anui tingbadung kideu ga au tingkaumie ge nzwa, nah kideu ga lungh bam kera keregui gede gah. <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />RAMPAUBO anui Tinggwang, anui mabam aide pelane hekwa kecu kerecaki ge tei kerane nah n kemci zi de herüt peu kera, cide n dade gwang nah pelane ngu. <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />Ih ci lie, a Tinggwang, nang mina mlung kedakpie kela nah masang kelame de nang n sui kela. A ziemne au, a mlung lungsang eh aidung pelane Ih neungga eh ncu peu ciau dida, nah cu Ih a sui yi eh n mina aika kebamme neungga eh mta mapeu ncu teugwang kebeu de piebam. <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />RAMPAUBE, Abraham, Isaac, nah Israel Tinggwang, anui paume, aide n minadung kecet mlung gage kelungta kai pwa bamlu. Penui mlung teipwa peu n da lalu. <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />A napei Solomon de n aja tei mzailu keneu mlung pwa peulo, n samkakkelu aja, nah ngu hezai rauteu kela, nah ki aide tei kera Ih mapelane riemteu kela de tei lu kera ziemne.”<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />David ngkwa pelane dage ranggai, “Cu RAMPAUBE nnui Tinggwang de samlam beu.” Ngkwa pelane RAMPAUBE, penui paume Tinggwang de samlam beu, penui keu henamie nah RAMPAUBE de reca nah hegwang dwa de penui henalu.<verse eid="1CH 29:20" /></para>
  <para style="s">Solomon de hegwangpei teidai kelu</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />Pecai benai, penui RAMPAUBE dage ratakdung teigai nah pecu keru recadung pwapeu. Penui ketumseu cangge, meurünseu cangge, nah meurünna cangge pwapeu, penui zau recadung de si eh nah ratakdung kekieege Israel pelane ziemne. <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />Cipau nai, penui RAMPAUBE dwa gade penui sui yisüt eh matyei nah sak.</para>
  <para style="p" vid="1CH 29:22">Penui pia pekenabe de Solomon, David napei de peu hegwangpei tei, nah RAMPAUBE kengkieng le pecu penui muiteu tei kerane keniaklu. Penui Zadok de de keniaklu cingkupei tei kerane. <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />Pecai Solomon RAMPAUBE hegwangbam ga ntumlu hegwangpei nzwa pe pei David bam leu eh. Pa keyibe teilu, nah Israelme pelane pe sam mzai. <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />Muiteumedung, nah reugwame pelane, nah Hegwangpei David napeidung, Hegwangpei Solomon dage masang kera sampet gaibeu. <verse eid="1CH 29:24" /><verse number="25" style="v" sid="1CH 29:25" />RAMPAUBE Solomon de Israelme pelane dwa de twasüt nah pecu Israel ga pe dwa pa madaude hegwang keda de peu kemak kengkieng kedi peugai.<verse eid="1CH 29:25" /></para>
  <para style="s">David tsit</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />Jesse napei David Israelme pelane reu hegwang tei. <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />David Israelme hegwang mmi riakdai ge tei. Pa Hebron ga mmi hena ge, nah Jerusalem ga mmi camreiehkecum ge hegwang teigwang. <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />Teilung ketie, mahei nah herüt teu eh lungh kehega kelucai, pa hecingsüt eh tsaidi. Pe napei Solomon pe bam leulu. <verse eid="1CH 29:28" /><verse number="29" style="v" sid="1CH 29:29" />Hegwangpei David heta tei keludung de caihakecibe Samuel laisiukwak ga, nah caihakecibe Nathan laisiukwak ga, nah caihakecibe Gad laisiukwak ga rau teula. <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />Cika rauteu kela cai pe hegwang ketei batadung, pa heta tei keludung nah pe dage, Israelme dage, nah kideu keda hegwangramdung pelane dage tei kegaidung.<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>