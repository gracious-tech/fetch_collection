<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Zeme(N) Bible Project</book>
  <para style="toc3">Lei.</para>
  <para style="toc2">Leidung</para>
  <para style="toc1">Leidung Laisiukwak</para>
  <para style="mt">Psalms</para>
  <para style="mt">Leidung Laisiukwak</para>
  <para style="is">Mraisam</para>
  <para style="ip">Leidung au leipwakdung mede ketwa, kereca, kenggai, helung kenreu leidung ge, nah cidung ket ket kecu cangsiak bam. Cidung de lungcet, lungdak, lungning nah luneudung keulia bam.</para>
  <para style="ip">Lei 150 gade, cidung 100 au mina aidung ne raugai lie kecu cetla: David-73; Asaph-12; Korah namedung-10; Moses-1; Ezra leuhme Heman-1; Ethan Ezra leuhbe-1; nah ket mede kena Solomon ne. Lei kedadung au rau kegaibe lie kecu raupwala ma.</para>
  <para style="ip">Leidung au mina kekie ge ne rau kegaine, peting ketsamtsam gade, nah penui lungdak ketsamtsam gade lia kegaine cidungde au kideube pelane ha rang kegai ge nah cidungde mina kekie cila nah mina kekie penui suila.</para>
  <para style="ip">Hebrew leipwak peria kenana teula. Peria kenabe peria keraibe de kecet de rangsui dai mede kencwalu ge peu gaila. Peria aidungde pie gailo nang Leidung kepeidau.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Laisiukwak Keraibe: Leidung 1-41</para>
  <para style="io1">Laisiukwak Kenabe: Leidung 42-72</para>
  <para style="io1">Laisiukwak Kecumbe: Leidung 73:89</para>
  <para style="io1">Laisiukwak Mdaibe: Leidung 90:106</para>
  <para style="io1">Laisiukwak Mengeibe: Leidung 107:150</para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="ms">Laisiukwak Keraibe</para>
  <para style="s">Makesangme nah kenlienme lampui</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 1:1" />Mina kesiame sam pung kemakme,</para>
  <para style="q" vid="PSA 1:1">mede kemaume lampui ga pwa kemakme,</para>
  <para style="q" vid="PSA 1:1">mede mide rangmsia kelame kakga bam kemakme samlam pungtu.<verse eid="PSA 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 1:2" />Dede RAMPAUBE zaibe gade penui suiyi ngau lula,</para>
  <para style="q" vid="PSA 1:2">nah pe zaibe ga penui tingmui tingba cetncok bamla.<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JOS 1:8">Jos. 1:8</ref></char></note><verse eid="PSA 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 1:3" />Penui au reuceudung kung ga tsingbang ling pwa kebam ge nzwada</para>
  <para style="q" vid="PSA 1:3">peting pehi dau pe tsidung bui kelade,</para>
  <para style="q" vid="PSA 1:3">pe nei regui dila kemakde;</para>
  <para style="q" vid="PSA 1:3">penui ma keheibe ketei gade hingpet lula.<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="JER 17:8">Jer. 17:8</ref>, <ref loc="PSA 92:12-14">Lei. 92:12-14</ref></char></note><verse eid="PSA 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 1:4" />Mina kesiame au ainzwa ma,</para>
  <para style="q" vid="PSA 1:4">dede cinzwa meliene ciurie tingkai ne gui pungdi kelabe nzwada.<verse eid="PSA 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 1:5" />Cine mina kesiame au tutiak benai nzeu gailak,</para>
  <para style="q" vid="PSA 1:5">mede kemaume kesamsangme kakga sap gailak.<verse eid="PSA 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 1:6" />Kedanemene RAMPAUBE kesamsangme lampui de luu lula,</para>
  <para style="q" vid="PSA 1:6">dede kesiame lampui au kap eh gah dizie.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="PSA 68:2">Lei. 68:2</ref>;<ref loc="PSA 73:27">73:27</ref>;<ref loc="PSA 92:9">92:9</ref></char></note><verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="s">RAMPAUBE keniakkelube Hegwangpei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 2:1" />Daitei eh heleuhdung<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">Heleuhdung: </char><char style="ft" closed="false">Tinggwang de ci kemakmedung.</char></note> makehebwak ga lano,</para>
  <para style="q" vid="PSA 2:1">nah daitei minadung teigai kelakbe riem kecu tei lano?<verse eid="PSA 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 2:2" />Kideu hegwangmedung penui sap keu ncütlu</para>
  <para style="q" vid="PSA 2:2">nah mina reu kengkieng teu kelame mariem ncüt eh</para>
  <para style="q" vid="PSA 2:2">RAMPAUBE nah pa ne keniak kegaibe<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="fq" closed="false">Pa ne keniak kegaibe: </char><char style="ft" closed="false">Pe Messiah</char></note> de mmaudi, nah penui ranggai,<note caller="-" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="REV 11:18">Keu. 11:18</ref>, <ref loc="ACT 4:25-26">Bat. 4:25-26</ref>;<ref loc="ACT 19:19">19:19</ref></char></note><verse eid="PSA 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 2:3" />“Penui ne anuide kangpwa kebam de teipang digo</para>
  <para style="q" vid="PSA 2:3">nah penui gu hegeuria keu keliengi digo.”<verse eid="PSA 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 2:4" />Tinggim ga kebambe penuide nui zie;</para>
  <para style="q" vid="PSA 2:4">Rampaube penuide teu henui teibam.<verse eid="PSA 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 2:5" />Pecai pe rata le penuide rangzie</para>
  <para style="q" vid="PSA 2:5">nah pe lunghop le penuide keheu eh cuh,<verse eid="PSA 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 2:6" />Tinggwang ranggai “Ih akatei a hegwangpei de keniak luda</para>
  <para style="q" vid="PSA 2:6">a lamlwatu kemci, Zion gade.”<verse eid="PSA 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 2:7" />Ih RAMPAUBE gu hezai de ranglia zie.</para>
  <para style="q" vid="PSA 2:7">Pa a dage rangdi, “Nang a napei!</para>
  <para style="q" vid="PSA 2:7">Henai gade Ih n pei dida.<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="MAT 3:17">Mat. 3:17</ref>;<ref loc="MAT 17:5">17:5</ref>, <ref loc="MRK 1:11">Mrk. 1:11</ref>;<ref loc="MRK 9:7">9:7</ref>, <ref loc="LUK 9:35">Luk. 9:35</ref>, <ref loc="JHN 1:49">Jhn. 1:49</ref>, <ref loc="ACT 13:33">Bat. 13:33</ref>, <ref loc="HEB 1:5">Heb. 1:5</ref>;<ref loc="HEB 5:5">5:5</ref>, <ref loc="2PE 1:17">2 Pet. 1:17</ref></char></note><verse eid="PSA 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 2:8" />A da kielu, iciude Ih ncu n mapwa ziemne heleuhdung ha zie</para>
  <para style="q" vid="PSA 2:8">nah n mabam tei kera kideu cuikui dihtubedung peu zie.<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="HEB 1:2">Heb. 1:2</ref></char></note><verse eid="PSA 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 2:9" />Nang penuide hegeutie gele dappop zie;</para>
  <para style="q" vid="PSA 2:9">li keteibe li nzwa, nang penuide dap kecai dizie.”<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="REV 2:27">Keu. 2:27</ref>;<ref loc="REV 12:5">12:5</ref>;<ref loc="REV 19:15">19:15</ref></char></note><verse eid="PSA 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 2:10" />Cine cu, nnui hegwangmedung, mriaklu;</para>
  <para style="q" vid="PSA 2:10">petau teilu, nnui kideu reu kengkieng teu kelame.<verse eid="PSA 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 2:11" />Kehing gade RAMPAUBE de reca lu</para>
  <para style="q" vid="PSA 2:11">nah mbeu eh nnui sui yilu.<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="PHP 2:12">Php. 2:12</ref></char></note><verse eid="PSA 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 2:12" />Nabe de kemamlu mecai Tinggwang ncu pe rata dizie,</para>
  <para style="q" vid="PSA 2:12">nah pa tingkak nage Tinggwang pe rata kegai gade nang tsai dizie.</para>
  <para style="q" vid="PSA 2:12">Pe da gwang nsiu kelume samlam pungtu.<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="s">Acu kelilu, Oh A Tinggwang</para>
  <para style="d">David lei, pa pe napei Absalom dade paktet kedidau.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 3:1" />RAMPAUBO, a ngauraume daikiee ge no!</para>
  <para style="q" vid="PSA 3:1">Kekiee ge acu mmau cuh dida.<verse eid="PSA 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 3:2" />Mi kekiee ge a ha rang,</para>
  <para style="q" vid="PSA 3:2">“Tinggwang kengha au pe da gah.” <char style="qs">Selah</char><verse eid="PSA 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 3:3" />Dede nang, RAMPAUBO, acu twagwa kepung a hegeu da,</para>
  <para style="q" vid="PSA 3:3">a kendu, nah a peu pwa ngangcuh kebeube da.<verse eid="PSA 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 3:4" />Ih RAMPAUBE dage hap gai,</para>
  <para style="q" vid="PSA 3:4">nah pa pe kemci kideutu<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">mount Zion </char></note> gade a sam keligai. <char style="qs">Selah</char><verse eid="PSA 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 3:5" />Ih zeu mie nah zipdi;</para>
  <para style="q" vid="PSA 3:5">Ih nrak cuh dailu, RAMPAUBE acu gum kebeu ziemne.<verse eid="PSA 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 3:6" />Ih ngauraume hemaa maadi de hing lak</para>
  <para style="q" vid="PSA 3:6">acu mmau kera twagwa pung kebamme de.<verse eid="PSA 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 3:7" />Cuhlu, RAMPAUBO! Acu kelibeu, a Tinggwang!</para>
  <para style="q" vid="PSA 3:7">Nang a ngauraume leune de pe bia gage kepeu zie kecune;</para>
  <para style="q" vid="PSA 3:7">nang mina kesiame geidung teicum dizie.<verse eid="PSA 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 3:8" />Kelikelu au RAMPAUBE dade gwangla.</para>
  <para style="q" vid="PSA 3:8">Oh RAMPAUBO! N samlamdung peu n minadung reuga bam lulo. <char style="qs">Selah</char><verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="s">Ih qu kegaidau a sam kelibeulo</para>
  <para style="d">Lei kempwakme muiteube ziemne; pe ria ketei leibungdung gade. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 4:1" />Ih qu kegaidau acu keli gailo, a kesamsang Tinggwang;</para>
  <para style="q" vid="PSA 4:1">Ih keherei kecudau acu ngha beulo.</para>
  <para style="q" vid="PSA 4:1">Acu ngaunggia gaibeu lo nah a kekie kingnei beulo.<verse eid="PSA 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 4:2" />Nnui minadung, daitie ge acu herüt kepeu de keu hengam teila laino?</para>
  <para style="q" vid="PSA 4:2">Daitie ge nnui ma kemtabe<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="fq" closed="false">Ma kemtabe: </char><char style="ft" closed="false">mamie rabedung</char></note> luuneu eh la laino nah kenretbe peeila laino? <char style="qs">Selah</char><verse eid="PSA 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 4:3" />Dede ci lulo RAMPAUBE ma kesangme de pegu tei zielie keuntsam luda.</para>
  <para style="q" vid="PSA 4:3">Ih qu kegaidau RAMPAUBE siu luzie.<verse eid="PSA 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 4:4" />Ngngi eh mbeulu, nah kemau teiso!</para>
  <para style="q" vid="PSA 4:4">Nang n zeu gade n mlung le cetncok sütlu nah zing delu.<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="EPH 4:26">Eph. 4:26</ref></char></note> <char style="qs">Selah</char><verse eid="PSA 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 4:5" />Ma kesamsangbe ratakdung teigai lu</para>
  <para style="q" vid="PSA 4:5">nah nang n kenlumde RAMPAUBE dage kailu.<verse eid="PSA 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 4:6" />Mina kekiee ge rangla, “Ma keyibe anuide caune keulia lai?”</para>
  <para style="q" vid="PSA 4:6">RAMPAUBO, n zu kebaa de anui reu ga peu baa lo.<verse eid="PSA 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 4:7" />Nang a nlung de suiyi peusi dida</para>
  <para style="q" vid="PSA 4:7">mi kedame penui mei nah zau keheci kekiee ge ngau keludau suiyi ngaukelu swade kiee eh.<verse eid="PSA 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 4:8" />Ih lungciep teu delwe zeu mie zie nah zip zie,</para>
  <para style="q" vid="PSA 4:8">kedanemene nang rünne, Oh RAMPAUBO, acu gum nah kwa kwakbeu kelane.<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="s">N masang gage acu saubeulo</para>
  <para style="d">Lei kempwakme muiteube ziemne; tingkai leibungdung le teikelu. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 5:1" />Ih ncu qu kegai kwade siulo, RAMPAUBO;</para>
  <para style="q" vid="PSA 5:1">a mra kwadung de cet gailo.<verse eid="PSA 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 5:2" />Ih qu kegai kwade siulo, a Hegwangpei nah a Tinggwang,</para>
  <para style="q" vid="PSA 5:2">Ih n dage kekie tei kegaine.<verse eid="PSA 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 5:3" />RAMPAUBO, tingcang nang a kehap kwa siu;</para>
  <para style="q" vid="PSA 5:3">tingcang nuge Ih a nggia n dage pwagwang zie nah regui eh kwabam zie.<verse eid="PSA 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 5:4" />Nang makesia ketei ga suizwa kela Tinggwang ma;</para>
  <para style="q" vid="PSA 5:4">mina kesiame au n giame tei gailak.<verse eid="PSA 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 5:5" />Ngang kelame au n dwaga saplak;</para>
  <para style="q" vid="PSA 5:5">nang kemaubata teikela pelane de ngkau la.<verse eid="PSA 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 5:6" />Nang kenretmedung de ngkap dizie;</para>
  <para style="q" vid="PSA 5:6">RAMPAUBE regeu kelame nah mide cwa kecume de ngkau la.<verse eid="PSA 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 5:7" />Dede Ih a ziemne au, n samkakkelu samsang kedi ziemne, Ih n ki ga gwang zie;</para>
  <para style="q" vid="PSA 5:7">herüt peu eh Ih n kemci kerecaki ga keumie.<verse eid="PSA 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 5:8" />Oh Rampaubo, n kesamsang gade a lampui sau beulo kedanemene a ngauraume ziemne;</para>
  <para style="q" vid="PSA 5:8">n lampui a dwaga tei mzui beulo.<verse eid="PSA 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 5:9" />Penui mui ga kesangbe bam kemak ziemne;</para>
  <para style="q" vid="PSA 5:9">penui helungbe au kesia le pui;</para>
  <para style="q" vid="PSA 5:9">penui rwak au herau ngkei pwa kebambe;</para>
  <para style="q" vid="PSA 5:9">penui penui mleu le kecwa sam rangla.<note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="ROM 3:13">Rom. 3:13</ref></char></note><verse eid="PSA 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 5:10" />Ngauraume dage maudi delie de eh rang beulo, Tinggwang;</para>
  <para style="q" vid="PSA 5:10">peu penui riem kegaidungde le penuide ngkap dilu!</para>
  <para style="q" vid="PSA 5:10">Penui mau kekiee de ziemne penuide gwagi dilu,</para>
  <para style="q" vid="PSA 5:10">kedanemene penui ncu renia kedi ziemne.<verse eid="PSA 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 5:11" />Dede n dage nsiu gai kelume leune depeu penui sui yilu;</para>
  <para style="q" vid="PSA 5:11">peu penuide penui suiyi kwa sahlu kedanemene nang penui de gumbeu delu;</para>
  <para style="q" vid="PSA 5:11">peu penuide n dage penui suiyi gailu, n zi de pesui kelame.<verse eid="PSA 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 5:12" />Nang kesamsangme de samlam beuzie kecune, RAMPAUBO;</para>
  <para style="q" vid="PSA 5:12">nang penuide kengha le penuide hegeu nzwa gum beula.<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="s">O RAMPAUBO, Acu kelibeu lo</para>
  <para style="d">Lei kempwak muiteube ziemne; pe ria ketei leibungdung gade, Sheminith ria gade telei kegai. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 6:1" />RAMPAUBO, n rata gade acu kesiu so</para>
  <para style="q" vid="PSA 6:1">mede n lunghop gade acu ledeu so.<verse eid="PSA 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 6:2" />Acu ngaunggia gailo, RAMPAUBO, Ih mnei kecune;</para>
  <para style="q" vid="PSA 6:2">acu teingkei beu, RAMPAUBO, a radung mbeu kebamne.<verse eid="PSA 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 6:3" />A rabe de keherei süt bam.</para>
  <para style="q" vid="PSA 6:3">Dede nang, RAMPAUBO, daitie ge ainzwa bam laino?<note caller="-" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="JHN 12:27">Jhn. 12:27</ref></char></note><verse eid="PSA 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 6:4" />Caili lo, RAMPAUBO! Acu kelibeu lo.</para>
  <para style="q" vid="PSA 6:4">N samkakkelu samsang de ziemne acu kelibeu lo!<verse eid="PSA 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 6:5" />Ketsai ga au ncu nsung kecu bam kemakne.</para>
  <para style="q" vid="PSA 6:5">Sheol<note caller="+" style="f"><char style="fr" closed="false">6:5 </char><char style="ft" closed="false">ketsaime deu</char></note> ga ncu cau hetwa pwapeu lai?<verse eid="PSA 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 6:6" />A lungrei ziemne Ih mnei bam dida.</para>
  <para style="q" vid="PSA 6:6">Tingmui ramsangne Ih a miakdui le a zeu tei puidi bam dida;</para>
  <para style="q" vid="PSA 6:6">Ih a miakdui le a zeu hwadi.<verse eid="PSA 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 6:7" />Lungrei ziemne a miak maimie di;</para>
  <para style="q" vid="PSA 6:7">a ngauraume ziemne a miak mnei süt di.<verse eid="PSA 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 6:8" />A dade tet mdei di, nnui kemau keteime pelane;</para>
  <para style="q" vid="PSA 6:8">kedanemene RAMPAUBE a kehap kwa siulu delu.<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">Mat. 7:23, Luk. 13:27</char></note><verse eid="PSA 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 6:9" />RAMPAUBE Ih ngaugia kie kegaide siu luda;</para>
  <para style="q" vid="PSA 6:9">RAMPAUBE a kekie tei beuda.<verse eid="PSA 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 6:10" />A ngauraume pelane nggam dizie nah keherei süt dizie.</para>
  <para style="q" vid="PSA 6:10">Penui penui cai nreu gwangzie nah hengam ngau zette zie.<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="s">Ih ndade Nsiula</para>
  <para style="d">David ne mpwak kelu lei ge, Benjaminme Cush samria gade RAMPAUBE dage pa lei tei kegai.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 7:1" />RAMPAUBE a Tinggwang, Ih n dage nsiu gaila!</para>
  <para style="q" vid="PSA 7:1">Acu gwa kelame dade keli beulo, nah ngha beulo.<verse eid="PSA 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 7:2" />Meliecai, hingho ge nzwa penui acu teurak dizie,</para>
  <para style="q" vid="PSA 7:2">teu takcai di eh migede acu keli beu gailak dizie.<verse eid="PSA 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 7:3" />RAMPAUBE a Tinggwang, Ih aide teicai,</para>
  <para style="q" vid="PSA 7:3">nah a ba ga kemau bamcai,<verse eid="PSA 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 7:4" />magade Ih a da lungciep kebambe da Ih kemau teidi liecai,</para>
  <para style="q" vid="PSA 7:4">mede pekie gah eh cimene a ngauraume de rejam di liecai, ma aidungde tei dicai, a samdung kingnei gailo.<verse eid="PSA 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 7:5" />Ciucai peu a ngaurau de a teilung zui lu nah a dwa railu;</para>
  <para style="q" vid="PSA 7:5">peu pecu a teilung pwa kideu gage pe pidau teilu</para>
  <para style="q" vid="PSA 7:5">nah ada herüt kebamde peu rebui gage kai dilu. <char style="qs">Selah</char><verse eid="PSA 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 7:6" />Cuhlu, RAMPAUBO, n rata le;</para>
  <para style="q" vid="PSA 7:6">a ngauraume rata de renia eh cuh lo;</para>
  <para style="q" vid="PSA 7:6">a ziemne nrak lulo nah kesamsang zai penui dage kai kebeude teigai lo.<verse eid="PSA 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 7:7" />Deudidung leune n taiga ngkwa twagwalu da;</para>
  <para style="q" vid="PSA 7:7">nreule n hegwangbam gade penui reu kengkieng teu gailo.<verse eid="PSA 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 7:8" />RAMPAUBO, heleuhdung tu tiak gailo;</para>
  <para style="q" vid="PSA 7:8">acu kelibeu lo, RAMPAUBO, kedanemene Ih masang nah mci kecune, Hutube Tinggwang.<verse eid="PSA 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 7:9" />Peu kemaume kesia tadung de tei sita lu, dede kesamsangme de tei ngkieng beu,</para>
  <para style="q" vid="PSA 7:9">kesamsang Tinggwang, nang mi nlung nah mi kecetdung ncet kelabe.<verse eid="PSA 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 7:10" />A hegeu de Tinggwang dade gwangla,</para>
  <para style="q" vid="PSA 7:10">petaube tei kebamme de kelibeu kelabe.<verse eid="PSA 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 7:11" />Tinggwang au kesamsang tutiakbe,</para>
  <para style="q" vid="PSA 7:11">tingnai ramsangne makesia de ngkau kela Tinggwang.<verse eid="PSA 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 7:12" />Magade mige pe mau pet mecai, Tinggwang au pe kingtie mui teizie</para>
  <para style="q" vid="PSA 7:12">nah pe lakpi hereu ziemne mtei luzie.<note caller="-" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="LUK 13:3-5">Luk. 13:3-5</ref></char></note><verse eid="PSA 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 7:13" />Pa hereunet pecu renia kerane mtei la;</para>
  <para style="q" vid="PSA 7:13">pa pe lakpitsidung miheu le teilu.<verse eid="PSA 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 7:14" />Kemau gade tetlak kedime ge de cetgai pielo,</para>
  <para style="q" vid="PSA 7:14">kengkap mariemdung pung kebamme, rejamlu kebui kenretdung nna kelume de.<verse eid="PSA 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 7:15" />Pa ma kuiki ge kuila nah pe kuiki tei lula</para>
  <para style="q" vid="PSA 7:15">nah pa tei kegai kuiki de ga cak nlüt dila.<verse eid="PSA 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 7:16" />Pekatei pe kengkap mariemdung de peda cailigwang daila,</para>
  <para style="q" vid="PSA 7:16">kedanemene pe zai kesia peda gwangdai kelane.<verse eid="PSA 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 7:17" />Ih RAMPAUBE de pe masang ziemne twala;</para>
  <para style="q" vid="PSA 7:17">Ih RAMPAUBE Hutube Tinggwang da ketwalei teigai zie.<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="s">N zi daikenzwa ge dino</para>
  <para style="d">Lei kempwak muiteube ziemne; Gittith ria gade telei kegai. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 8:1" />RAMPAUBE anui Rampaube, kideu pelane ga n zi dai hiage de dino,</para>
  <para style="q" vid="PSA 8:1">nang n kemdu nreule tinggimdung gade keulia gai.<verse eid="PSA 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 8:2" />Ngienadung nah nepamnadung mui gade nang hetwa ngaulu</para>
  <para style="q" vid="PSA 8:2">kedanemene n ngauraume ziemne,</para>
  <para style="q" vid="PSA 8:2">iciu eh nang ngauraume nah hekum peei kelame hangnana de kaamdi kerane.<note caller="-" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="MAT 21:16">Mat. 21:16</ref></char></note><verse eid="PSA 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 8:3" />Nang n zurangdung le tei kegai tinggimdung ga pie nghang kegaidau,</para>
  <para style="q" vid="PSA 8:3">hekei de nah hegidung de, nang pe bam gage kai kegaidung de,<verse eid="PSA 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 8:4" />mina leuh au n ziemne daikenzwa ge nlang no, nang penuide ncet kela,</para>
  <para style="q" vid="PSA 8:4">mede minadung dai no nang penui mapie kela?<note caller="+" style="f"><char style="fr" closed="false">8:4 </char><char style="ft" closed="false">Lei. 144:3, Job 7:17-18</char></note><verse eid="PSA 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 8:5" />Iciude nang penuide tinggimme swade keceunage gwale tei henah di ma</para>
  <para style="q" vid="PSA 8:5">nah penuide kendu nah hetwa peurwa kaibeu.<verse eid="PSA 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 8:6" />Nang pecu de peu n batadung reu ga kedi tei;</para>
  <para style="q" vid="PSA 8:6">nang maleune de pe pi kangga kaibeu:<note caller="+" style="f"><char style="fr" closed="false">8:6 </char><char style="ft" closed="false">1 Cor. 15:27, Eph. 1:22, Heb. 2:6-8, Acts 17:31</char></note><verse eid="PSA 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 8:7" />meurünna leune nah hetumseu,</para>
  <para style="q" vid="PSA 8:7">nah luh ga makaune leune de,<verse eid="PSA 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 8:8" />tingkam ruinedung, nah jaaidi ga hekadung, nah makaune jaaididung ga tetkah kebam pelane.<verse eid="PSA 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 8:9" />RAMPAUBE anui Tinggwang</para>
  <para style="q" vid="PSA 8:9">kideu pelane ga n zi dai hiage de dino!<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="s">Ih n bata miswakegahdung peei zie</para>
  <para style="d">Lei kempwak muiteube ziemne; Muth Labben ria gade telei kegai. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 9:1" />Ih RAMPAUBE de a nlung pelane le hetwa pwa peu zie;</para>
  <para style="q" vid="PSA 9:1">Ih miswakegah n tadung ha rang zie.<verse eid="PSA 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 9:2" />Ih n ziemne a suiyi süt eh lei teizie;</para>
  <para style="q" vid="PSA 9:2">Ih n zi de twa eh lei tei zie, Hutube Tinggwang!<verse eid="PSA 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 9:3" />A ngauraume caili nreu kegwangdau,</para>
  <para style="q" vid="PSA 9:3">penui n dwa gade kau nah kap dizie.<verse eid="PSA 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 9:4" />Kedanemene nang a zeu de gum beuda;</para>
  <para style="q" vid="PSA 9:4">nang n hegwangbam ga bam, kesamsang tutiakpe!<verse eid="PSA 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 9:5" />Nang nlumkemak heleuhdung de kesiu;</para>
  <para style="q" vid="PSA 9:5">nang kemaume de ngkap dida;</para>
  <para style="q" vid="PSA 9:5">nang penui zi kelungta nah kelungta ziemne hemai dida.<verse eid="PSA 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 9:6" />Ngauraume ngkap kedinzwa pangpop dida</para>
  <para style="q" vid="PSA 9:6">nang penui gu namdidung ngkap kedi dau.</para>
  <para style="q" vid="PSA 9:6">Penuide kensunghadung de bam si lakta.<verse eid="PSA 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 9:7" />Dede RAMPAUBE kelungta hegwang dida;</para>
  <para style="q" vid="PSA 9:7">Pa pe hegwangbam hetu tiak kera mtei luda.<verse eid="PSA 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 9:8" />Pa kideu de kesamsang le tiak zie</para>
  <para style="q" vid="PSA 9:8">nah Pa heleuhdung ziemne masangbe le tiak beuzie.<note caller="+" style="f"><char style="fr" closed="false">9:8 </char><char style="ft" closed="false">Lei. 96:13, Bat. 17:31</char></note><verse eid="PSA 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 9:9" />RAMPAUBE mine ngau rau kelame ziemne kensiu ge zie,</para>
  <para style="q" vid="PSA 9:9">keherei kecu tingdau kensiu ge.<verse eid="PSA 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 9:10" />N zi ci kecume ncu nlum la,</para>
  <para style="q" vid="PSA 9:10">kedanemene nang, RAMPAUBO, ncu peei gwang kelame de gidi la kemakne.<verse eid="PSA 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 9:11" />RAMPAUBE da ketwa lei tei gailu, Zion ga hegwang tei kebambe dage;</para>
  <para style="q" vid="PSA 9:11">heleuhdung dage pa tei kegaidung de rangbeu lu.<verse eid="PSA 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 9:12" />Kedanemene hejai teulwa kelame dade hekum peibeu kelabe Tinggwang nsungla kecune;</para>
  <para style="q" vid="PSA 9:12">keherei kebamme kehap kwa pa nsungtadi lama.<verse eid="PSA 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 9:13" />Acu ngaunggia gailo RAMPAUBO; pielo acu ngkau kelame dai kenzwa gede acu tei kehereila bi,</para>
  <para style="q" vid="PSA 9:13">nang acu ketsai kirie gade teumpet beu lubui.<verse eid="PSA 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 9:14" />Oh, iciu eh Ih n hetwa pelane ranglialu kerane.</para>
  <para style="q" vid="PSA 9:14">Zion napui kiriedung gade<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">Jerusalem mina dwade.</char></note></para>
  <para style="q" vid="PSA 9:14">Ih n kelikelu ziemne a sui yila zie.<verse eid="PSA 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 9:15" />Heleuhdung de penui katei tei kegai kuiki ga nlüt dida;</para>
  <para style="q" vid="PSA 9:15">penui pi penui ne hebai kaipwa kebam baih gage keu luda.<verse eid="PSA 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 9:16" />RAMPAUBE pekatei pecu peu cigai da; pa hetu tiak beu da;</para>
  <para style="q" vid="PSA 9:16">kenlienme pekatei pe ta gade pecu keu dida. <char style="qs">Selah</char><verse eid="PSA 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 9:17" />Kenlienmedung de peu caili dida nah Sheol gage langgai dida,</para>
  <para style="q" vid="PSA 9:17">Tinggwang de nsungta kedi heleuhdung leune de.<verse eid="PSA 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 9:18" />Kedanemene maisia kelame de nsungtadi muilak kecune,</para>
  <para style="q" vid="PSA 9:18">nah rei kelame regui de kelungta gah dilak.<verse eid="PSA 9:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 9:19" />Cuhlu, RAMPAUBO; peu tsaidi kelame de n reu ngkieng diso;</para>
  <para style="q" vid="PSA 9:19">n dwa gade peu heleuhdung tiak lulo<verse eid="PSA 9:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 9:20" />Penuide tei ngngi gailo, RAMPAUBO;</para>
  <para style="q" vid="PSA 9:20">peu heleuhdung de penui au mina tsaidi kelame lie kecu ci lulo. <char style="qs">Selah</char><verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="s">Nang daitei mbai lano?</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 10:1" />Daitei eh, RAMPAUBO, nang sap mdei lano?</para>
  <para style="q" vid="PSA 10:1">Daitei eh nang anui keherei kecu tingdau mbaih di lano?<verse eid="PSA 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 10:2" />Penui ngang kela ziemne, mina kesiame rei kelame de zuila;</para>
  <para style="q" vid="PSA 10:2">dede kesiame de peu penui katei ne mtei kelu baih gage peu baang dilu.<verse eid="PSA 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 10:3" />Mina kesiame penui lungning kecokdung ziemne ngang lala;</para>
  <para style="q" vid="PSA 10:3">pa ma kehenginme de samlam beula nah RAMPAUBE de rangmsia lala.<verse eid="PSA 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 10:4" />Mina kesiame au ngang kecu zu pungbam; pa Tinggwang de peei lama.</para>
  <para style="q" vid="PSA 10:4">Pa Tinggwang de madaude nsungla ma kedanemene pa pecu malie la kemakne.<verse eid="PSA 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 10:5" />Pa peting ramsangne ziune bamla,</para>
  <para style="q" vid="PSA 10:5">dede n kesamsang hezaidung au pe ziemne hu zu;</para>
  <para style="q" vid="PSA 10:5">pa pe ngauraumedung de nui lala.<verse eid="PSA 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 10:6" />Pa pe nlung gade rangla, “Ih madaude kau dilak;</para>
  <para style="q" vid="PSA 10:6">lungkela tane Ih madau gede keherei dau lak.”<verse eid="PSA 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 10:7" />Pe mui au reset nah kenretpedung nah mide keheu samdung le pui;</para>
  <para style="q" vid="PSA 10:7">pe mleu kangga mide tei kelunglei nah makesia sam bam.<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="ROM 3:14">Rom. 3:14</ref></char></note><verse eid="PSA 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 10:8" />Pa renamdung taiga mbai bamla;</para>
  <para style="q" vid="PSA 10:8">cikemak henidung gade pa mina mau kemakme de teitset la;</para>
  <para style="q" vid="PSA 10:8">pe miakdung mina magede teigai kelakme de peei la.<verse eid="PSA 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 10:9" />Pa pe mbai bam ga hingho nzwa kwa bam;</para>
  <para style="q" vid="PSA 10:9">pa pe ngau raume de tuilu kerane zeu eh kwa bamla.</para>
  <para style="q" vid="PSA 10:9">Pa pe ngau raume de pe baih teu kegai dau tui lula.<verse eid="PSA 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 10:10" />Pa ne tui kelume de tei kecai dila nah rejam dila;</para>
  <para style="q" vid="PSA 10:10">penui pe baih kengkieng dega caklüt dila.<verse eid="PSA 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 10:11" />Pa pe nlung gade rangla, “Tinggwang acu nsungta dila;</para>
  <para style="q" vid="PSA 10:11">pa pemiak ziangmui dida; pa madaude pie kera cet meda.”<verse eid="PSA 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 10:12" />Cuhlu, RAMPAUBO! N ba hwa ncuhlu, Tinggwang!</para>
  <para style="q" vid="PSA 10:12">Rei kelame de nsung tadi so.<verse eid="PSA 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 10:13" />Daitei mina kesiame Tinggwang de mlai lano</para>
  <para style="q" vid="PSA 10:13">nah pe nlung gade, “Nang acu mmau dilak ha,” de eh rangla no?<verse eid="PSA 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 10:14" />Nang ngaula, mide tei keherei kelame nah mi lungrei tei kelame de nang pie bammui la kecune.</para>
  <para style="q" vid="PSA 10:14">Magede teigai kelakme pecu le pwa ncu nlum beula;</para>
  <para style="q" vid="PSA 10:14">nang pe pei kegame de ngha beula.<verse eid="PSA 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 10:15" />Kemaume nah kesia keteime ba teicum dilo.</para>
  <para style="q" vid="PSA 10:15">Pa kemaudung tei kedine pecu saja peulo,</para>
  <para style="q" vid="PSA 10:15">pa cet kecu nang ci lak lie kelane.<verse eid="PSA 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 10:16" />RAMPAUBE au kelungta hegwang;</para>
  <para style="q" vid="PSA 10:16">Tinggwang de ci kemak leuhdung pe deu gade gwampet dila.<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="ft" closed="false">Rom. 11:26,27</char></note><verse eid="PSA 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 10:17" />RAMPAUBE, nang rei kelame kekie de siu luda;</para>
  <para style="q" vid="PSA 10:17">nang penui nlung teingkuu beu, nang penui kekie kingnei beu;<verse eid="PSA 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 10:18" />Nang pe pei kegame nah rei kelame de gum beula</para>
  <para style="q" vid="PSA 10:18">iciu eh mige de kideu aika kekeheu ta teisi dai kelakne.<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="s">RAMPAUBE au pe kerecaki kemci ge bam</para>
  <para style="d">Lei kempwak muiteube ziemne. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 11:1" />RAMPAUBE dage Ih nsiu gaila;</para>
  <para style="q" vid="PSA 11:1">nang dainzwa a dage,</para>
  <para style="q" vid="PSA 11:1">“Lamlwa ga nruine nzwa lim nghang lu,” de eh ranglu lai?<verse eid="PSA 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 11:2" />Kedanemene pielo! Kesiame pe lakpidung mteilu da.</para>
  <para style="q" vid="PSA 11:2">Penui lakpi ria gage pe lakpitsidung mtei gailu da</para>
  <para style="q" vid="PSA 11:2">makesangme nlung gage tingmuidau kapgai kerane.<verse eid="PSA 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 11:3" />Kedanemene pe bangdwabe teingkap dicai,</para>
  <para style="q" vid="PSA 11:3">kesamsangme dai teilu lai?<verse eid="PSA 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 11:4" />RAMPAUBE au pe hegwang bam ga bam;</para>
  <para style="q" vid="PSA 11:4">pe miak le pie bam, mina leuh de pa pe miak le pie ncet bam.<verse eid="PSA 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 11:5" />RAMPAUBE kesamsangme nah kesiame ai kenana de pieteune bamla,</para>
  <para style="q" vid="PSA 11:5">dede pa kesia ta tei keneume de ngkaula.<verse eid="PSA 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 11:6" />Pa kemaume reu gage miheutsu nah sulphur heu kebam tei cakkeimie gaila;</para>
  <para style="q" vid="PSA 11:6">pa tingkai kelumle penuide tei keherei la!<verse eid="PSA 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 11:7" />RAMPAUBE au samsang, nah ma kesamsangbe pesui la;</para>
  <para style="q" vid="PSA 11:7">makesangme pe zu ngau zie.<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="s">Makesangme mamsi meda</para>
  <para style="d">Lei kempwak muiteube ziemne; Sheminith ria gade telei kegai. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 12:1" />Anuide ngha lo, RAMPAUBO, kedanemene kesamsangme gah dide kecune;</para>
  <para style="q" vid="PSA 12:1">petau kelame mina leuh gade gah dida.<verse eid="PSA 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 12:2" />Mileune pe kidame dage kemta sam rangla;</para>
  <para style="q" vid="PSA 12:2">mileune kenret muileu le nah helung kena le marang la.<verse eid="PSA 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 12:3" />RAMPAUBO, kenret kerang muileudung de kaam dilo,</para>
  <para style="q" vid="PSA 12:3">mleu leune ngang eh rang keladung de.<verse eid="PSA 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 12:4" />Aidungde au ainzwa eh rang kegaime, “Anui mleu le anui ngkieng luzie.</para>
  <para style="q" vid="PSA 12:4">Anui mui mleu marang kegaidau, anui reu caune ngkieng lu buino?”<verse eid="PSA 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 12:5" />“Kegame de tei keherei kegai ziemne, ngha teu maisia kelamedung mra kegai ziemne,</para>
  <para style="q" vid="PSA 12:5">Ih cuhlu zie,” de eh RAMPAUBE rang.</para>
  <para style="q" vid="PSA 12:5">“Penui luu neu kela kengha de Ih penuide peu zie.”<verse eid="PSA 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 12:6" />RAMPAUBE samdung au nlumlu kebui samdung,</para>
  <para style="q" vid="PSA 12:6">rangkanggeu kideu gade</para>
  <para style="q" vid="PSA 12:6">pia hena mi le ru mcikelu nzwa.<verse eid="PSA 12:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 12:7" />Nang au RAMPAUBE! Nang penuide gum beula.</para>
  <para style="q" vid="PSA 12:7">Nang kesiame aidungde dade mina kemcime de kelungta gum beulo.<verse eid="PSA 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 12:8" />Kemaumedung kehei gade bam</para>
  <para style="q" vid="PSA 12:8">Kesiabe ndu kegai dau mina leuhdung kak gage.<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="s">Daitiege no, O RAMPAUBO</para>
  <para style="d">Lei kempwak muiteube ziemne. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 13:1" />Daitie ge, RAMPAUBO, nang acu nsungta bam laino?</para>
  <para style="q" vid="PSA 13:1">Daitie ge nang n zu a dade hebaih bam laino?<verse eid="PSA 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 13:2" />Daitie ge Ih a lung rei bam laino</para>
  <para style="q" vid="PSA 13:2">nah petingnai a nlung ga lungrei pung bam laino?</para>
  <para style="q" vid="PSA 13:2">Daitie ge a ngauraume a reu ngkieng bam laino?<verse eid="PSA 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 13:3" />Acu pie lo nah a sam keli lo, RAMPAUBE a Tinggwang!</para>
  <para style="q" vid="PSA 13:3">Kebaa a miak de peulo, mecai Ih ketsai ga zip dizie.<verse eid="PSA 13:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 13:4" />Peu a ngauraume de, “Ih pecu ngam luda,” de eh rangdi so,</para>
  <para style="q" vid="PSA 13:4">iciu eh peu a ngauraume de, “Ih a ngauraume reu ngkieng luda” de rang melu kerane; meliecai, a ngauraume Ih kau kedidau penui sui yizie.<verse eid="PSA 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 13:5" />Dede Ih n samkakkelu samsang ga nlum bam;</para>
  <para style="q" vid="PSA 13:5">n kelikelu ga Ih a sui yila.<verse eid="PSA 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 13:6" />Ih RAMPAUBE dage ketwalei teigai zie</para>
  <para style="q" vid="PSA 13:6">kedanemene pa a dage pe zai yisüt kegaine.<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="s">Kemieme Tinggwang gah lie rangla</para>
  <para style="d">Lei kempwak muiteube ziemne. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 14:1" />Kemieme pe nlung gade, “Tinggwang gah,” de eh rangbam la.</para>
  <para style="q" vid="PSA 14:1">Penui au hera nah kemaubedung tei dida;</para>
  <para style="q" vid="PSA 14:1">keyi ta ketei migede gah da.<verse eid="PSA 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 14:2" />RAMPAUBE tinggim gade mina leune de pie nghung gai</para>
  <para style="q" vid="PSA 14:2">migede ma keci,</para>
  <para style="q" vid="PSA 14:2">pecu peei kelame bam mi de eh piegai kerane.<verse eid="PSA 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 14:3" />Penui pelane nreutet dida. Penui pelane hera dida.</para>
  <para style="q" vid="PSA 14:3">Keyi ketei migede gah da, gah, hangge de gah.<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">Rom. 3:10-11</char></note><verse eid="PSA 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 14:4" />Penui magede ci ma, penui kemau tei kelame,</para>
  <para style="q" vid="PSA 14:4">penui tangku ketyei nzwa a minadung de tyei lula,</para>
  <para style="q" vid="PSA 14:4">dede RAMPAUBE de qula kemakme?<verse eid="PSA 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 14:5" />Penui kengngi le mbeu dizie,</para>
  <para style="q" vid="PSA 14:5">kedanemene Tinggwang au kesamsang ceheu de ngngwa lalu!<verse eid="PSA 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 14:6" />Nang kegahme de tei hengam teigai neula</para>
  <para style="q" vid="PSA 14:6">RAMPAUBE pe nsiube lie de.<verse eid="PSA 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 14:7" />Oh, RAMPAUBE lungh kebam Zion gade Israel da kelikelu gwang lucai!</para>
  <para style="q" vid="PSA 14:7">RAMPAUBE pe minadung de hebaang ketei gade ngngwa mpet kebeu dau,</para>
  <para style="q" vid="PSA 14:7">ciciu lude Jacob pe suiyi dizie nah Israel pe suiyi pui dizie!<note caller="+" style="f"><char style="fr" closed="false">14:7 </char><char style="ft" closed="false">Lei. 53:6, Luk. 1:69</char></note><verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="s">Cau n kideutu kemci ga lungh lai?</para>
  <para style="d">David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 15:1" />RAMPAUBO, cau gu paiki ga bamlu buino?<note caller="+" style="f"><char style="fr" closed="false">15:1 </char><char style="ft" closed="false">Keteu kegai samtie aide hebeu teikelamedung Jerusalem kerecaki kirieki dwaga gwang mtaklu kera bam peei eh keteubam kecunzwa sam ge.</char></note></para>
  <para style="q" vid="PSA 15:1">Cau n kemci kideutu ga lungh lubui no?<verse eid="PSA 15:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 15:2" />Kemau gah zing kecume, petau tei kelame</para>
  <para style="q" vid="PSA 15:2">nah pe nlung gade ma kesangbe rang kelame.<verse eid="PSA 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 15:3" />Pa pe mleu le rangmsia la ma,</para>
  <para style="q" vid="PSA 15:3">pa mi kedame de tei rejam lama,</para>
  <para style="q" vid="PSA 15:3">nah pa pe kidame de kii lama.<verse eid="PSA 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 15:4" />Pe miakngau gade pa mina mta mrwa kelame de gi dila,</para>
  <para style="q" vid="PSA 15:4">dede pa RAMPAUBE mie hing kelame de herüt peula.</para>
  <para style="q" vid="PSA 15:4">Pa ziuyi bam melie de sampet beula delwe pa pe sampetdung teicang lula.<verse eid="PSA 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 15:5" />Pa pekai tei mene rangkang hepwak peula.</para>
  <para style="q" vid="PSA 15:5">Pa mau kemakme de kemmau zierang tei kera hetau luu lamah.</para>
  <para style="q" vid="PSA 15:5">Aidungde tei kegaibe madauge de deu mlai gailak.<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="s">Nang a Rabe gidilak</para>
  <para style="d">David gu michtam<note caller="+" style="f"><char style="fr" closed="false">16:0 </char><char style="fq" closed="false">Michtam: </char><char style="ft" closed="false">ketsai gade kelikebeu lie. </char></note> ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 16:1" />Acu gum beulo, Tinggwang, kedanemene Ih n dage nsiu kegaine.<verse eid="PSA 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 16:2" />Ih RAMPAUBE dage rangla, “Nang au a RAMPAUBE; ncu si meliecai a keyidung au mage dema.<verse eid="PSA 16:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 16:3" />Mina kemcimedung kideu ga kebammedung, penui au mina keyime; a suiyi pelane penui da bam.<verse eid="PSA 16:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 16:4" />Penui kehereidung au kieesi dizie, hera kedadung de peei kelame. Ih hejai ratak penui rabedung dage ruigai beulak</para>
  <para style="q" vid="PSA 16:4">mede a mleu le cipau rabe zidung teuncuh beulak.<verse eid="PSA 16:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 16:5" />RAMPAUBO, nang au a kedet kelu lie zi ge nah a piak. Nang a mabam gum beula.<verse eid="PSA 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 16:6" />Heni keyidung gage a ziemne heraidung tei gai beu da; mapwa keyi ge agu kesangda.<verse eid="PSA 16:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 16:7" />RAMPAUBE a lampui saubeu kelabe de samlam beuzie; tingmui de a lung acu ledeu beula.<verse eid="PSA 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 16:8" />Ih RAMPAUBE de a dwa gage kai muila, iciu eh acu deu mlai di gailak!<verse eid="PSA 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 16:9" />Ci ziemne a nlung sui yibam; a kemdu herwa eh bam. Ih magede hing mene lung kesang luzie.<verse eid="PSA 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 16:10" />Kedanemene nang a rabe de ketsaime deu gage püt dilak. Nang hung kelamedung depeu kengkap ngau dilak.<verse eid="PSA 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 16:11" />Nang acu kering lampuibe ledeu beu da; nang kela ga au misui keyi le pui; n ba zetle ga kelungta misui keyi bam!”<note caller="+" style="f"><char style="fr" closed="false">16:11 </char><char style="ft" closed="false">verse 8-11b ga kebam samdungde gwang Bat. 2:25-28 gade de cikesiak ge ngau lula.</char></note><verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="s">N Hesiu mie kang gade</para>
  <para style="d">David gu kekie ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 17:1" />A nzeu kekie kingnei gailo, RAMPAUBO; a kengha kie kegai kingnei gailo!</para>
  <para style="q" vid="PSA 17:1">Kecwasam rang kemak muileu gade kepet a kekie kingnei gailo.<verse eid="PSA 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 17:2" />Teinzeu kelu peu ndade gwanglu; peu n miak de petau be ngaulu!<verse eid="PSA 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 17:3" />Nang magade a mlung kedakpie eh, tingmuidau nang ada gwangcai,</para>
  <para style="q" vid="PSA 17:3">nang acu teimci beuzie nah kesia mariem ketde ngau lak; a mui kemau tei dilak.<verse eid="PSA 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 17:4" />Minadung ta ria gade au, n mleu sam ziemne Ih akatei acu hezai mzui la kemakbe lampui gade teu ntsam dida.<verse eid="PSA 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 17:5" />N lampuidung ga Ih tet ntiprip la;</para>
  <para style="q" vid="PSA 17:5">a pi reneu dima.<verse eid="PSA 17:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 17:6" />Ih ncu qula, kedanemene nang a sam keli beu lalu, Tinggwang; a da nreu gwang lo nah Ih marang kegai dau a sam kingnei lo.<verse eid="PSA 17:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 17:7" />N samkakkelu samsang de miswakegah ria gade teilia lo, nang n da nsiu kelame de penui ngauraumedung dade kelibeu kelabe!<verse eid="PSA 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 17:8" />Nang n miak de ku kela nzwa eh acu gum beulo; n hesiu kangga acu hebai gailu<verse eid="PSA 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 17:9" />mina kesiame acu teikeherei kebam gade, a ngauraume acu twagwa pung kebamme dade.<verse eid="PSA 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 17:10" />Penui au migede de ngaunggia lama; penui mui ngang kela sam rangla.<verse eid="PSA 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 17:11" />Penui a pikietdung ga twagwalu. Penui acu tei ngkau di kerane acu pie eh bam.<verse eid="PSA 17:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 17:12" />Penui au hingho ge nzwa migede tui kera kwa bam, hingho ge nzwa eh kembai ni ga bwakela nzwa.<verse eid="PSA 17:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 17:13" />Cuhlu, RAMPAUBO! Penui de gwa ketang lo! Penui de beu ngkei penui zu gage sam lo! N kingtie le mina kesiame dade a teilung kelibeu lo!<verse eid="PSA 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 17:14" />N ba le acu mina dade keli beulo, RAMPAUBO, kideube mina aipau teilung rünne ga penui lungh kerelui kebamme dade!</para>
  <para style="q" vid="PSA 17:14">Nang hung kelame de mahei le samlam beulo; penui namedung kieesüt zie nah penui tsame ziemne penui mabam bangnzeu luzie.<verse eid="PSA 17:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 17:15" />A ziemne au, kesamsang gade n zu ngau zie; Ih mrak lwe ncu ngau kecudau, Ih mnung luzie.<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="ft" closed="false">Lei. 4:6-7:1, 1 Jhn. 3:2</char></note><verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="s">RAMPAUBE au a Tsura nah a kengkieng bam</para>
  <para style="d">Lei kempwak muiteube ziemne. David gu lei ge, RAMPAUBE kilabe, Saul ba gade nah pe ngauraume ba gade pecu kelibeu kecudau pa RAMPAUBE dage lei aide tei kegai. Pa lei teigai:</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 18:1" />Ih ncu hunglie, RAMPAUBO, a kengkieng.<verse eid="PSA 18:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 18:2" />RAMPAUBE au a tsura, a kengkieng bam, pa acu peu kwak lula; pa au a Tinggwang, a tsura; Ih pe dade nsiu lula.</para>
  <para style="q" vid="PSA 18:2">Pa a hegeu, a kelikelu kiibe, nah a nsiu kengkiengbe.<note caller="+" style="f"><char style="fr" closed="false">18:2 </char><char style="ft" closed="false">Heb. 2:13</char></note><verse eid="PSA 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 18:3" />Hetwa pwapeulu kebui RAMPAUBE de Ih qu gai zie, nah Ih a ngauraume dade kwak bamlu zie.<verse eid="PSA 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 18:4" />Ketsai kengngi le acu twagwapung bam, nah kengkap cui ne a reu ngkieng bam dida.<note caller="+" style="f"><char style="fr" closed="false">18:4 </char><char style="ft" closed="false">Lei. 116:3</char></note><verse eid="PSA 18:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 18:5" />Sheol de kehing le acu twagwapung bam dida; ketsai baih ne acu kang pwabam dida.<verse eid="PSA 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 18:6" />Reikela gade Ih RAMPAUBE de qugai; Ih a Tinggwang de kengha ziemne qugai. Pa pe kerecaki gade a kwa siulu;</para>
  <para style="q" vid="PSA 18:6">a kengha kekie peda mie canglu; cide pe kwen ga lütlu.<verse eid="PSA 18:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 18:7" />Pecai kideube nlai nah mbeudi; lamlwatu bangbeudung de mbeu</para>
  <para style="q" vid="PSA 18:7">nah nlaidi kedanemene Tinggwang pe rata kedine.<verse eid="PSA 18:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 18:8" />Pe ngkie gade mika kapet cuhdi, nah pe mui gade mi heu petdi. Miceu de cide ne rudi.<verse eid="PSA 18:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 18:9" />Pa tinggimdung ngkei gai nah pa nghung, nah kemui kedige pe pi kangga la.<verse eid="PSA 18:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 18:10" />Pa cherub<note caller="+" style="f"><char style="fr" closed="false">18:10 </char><char style="ft" closed="false">pe hesiu kepung kaune cf. Ezk. 1:5-14;10:21 </char></note> ge reuga bamlu eh lim la; pa tingkai hesiu gade lim la.<verse eid="PSA 18:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 18:11" />Pa pecu kemui gele hezui, twagwalu, tingkam ga mwangzui dui kepui gele.<verse eid="PSA 18:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 18:12" />Tangheu nah miheu cuidung kehepik kegai gade pe dwaga cakmie.<verse eid="PSA 18:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 18:13" />RAMPAUBE tinggim gade sahbak gai! Hutube Tinggwang kwa tangheu nah tingkehepikdung nzwa siudi.<verse eid="PSA 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 18:14" />Pa pe lakpitsidung kapgai nah pe ngauraumedung de tei zangra di; tingkehepikdung de le penuide tei kebwakdi.<verse eid="PSA 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 18:15" />O RAMPAUBO, nang hesiu kegai dau;</para>
  <para style="q1" vid="PSA 18:15">n rata eh mra kegai</para>
  <para style="q1" vid="PSA 18:15">duirwakdung ngaudi,</para>
  <para style="q" vid="PSA 18:15">kideube bangbeudung mta mrwadi.<verse eid="PSA 18:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 18:16" />Pa nreule de nghung; pa acu ngngwa lu! Pa acu dui kedi gade teu mpetlu.<verse eid="PSA 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 18:17" />Pa a ngauraume kengkieng gade acu kelibeu da, acu ngau keraume dade, penui a ziemne ngkieng ham kedi ziemne.<verse eid="PSA 18:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 18:18" />Ih a lungrei kebamdau ngauraumedung acu reniapet dede RAMPAUBE acu ngha beu!<verse eid="PSA 18:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 18:19" />Pa acu heni kenza gage lungmpet beu; pa acu ngha beu kedanemene pa acu pe sui kelane.<verse eid="PSA 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 18:20" />Ih samsang gai kecu ziemne RAMPAUBE a ziehi teibeu; a ba mci kecu ziemne pa acu teimcang beu.<verse eid="PSA 18:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 18:21" />Ih RAMPAUBE zaide mzai nah a Tinggwang dade Ih kemau tei eh nreu tetdi kemakne,<verse eid="PSA 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 18:22" />Pe kesamsang zaidung a dwa ga kebamne; nah pe samdung gade Ih nreu tetdi kemakne.<verse eid="PSA 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 18:23" />Ih pe dwa gade nzui, nah Ih kemau tei dimah.<verse eid="PSA 18:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 18:24" />Cine RAMPAUBE a kesamsang ziemne acu samlam beu, kedanemene pe miak dwa gade a ba mci kecu ziemne.<verse eid="PSA 18:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 18:25" />Samsang kecume dage, nang samsang la;</para>
  <para style="q2" vid="PSA 18:25">yicang kecume dade, nang nkatei ncu yicang kecu keulia la.<verse eid="PSA 18:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 18:26" />Mci kecume dage, nang nkatei ncu mci kecu keulia la; dede nang ngkoi kelame dade au mriak.<verse eid="PSA 18:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 18:27" />Nang keherei kelame de kelibeu la, dede nang ngang kelame de teu ngkau dila!<verse eid="PSA 18:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 18:28" />Nang a mitaubung de kebaa peu la; RAMPAUBE a Tinggwang a kemui de tei baa beula.<note caller="+" style="f"><char style="fr" closed="false">18:28 </char><char style="ft" closed="false">2 Sam. 22:29</char></note><verse eid="PSA 18:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 18:29" />N ziemne kekam kenan Ih pakkah lubui; tangdeu ge reu Ih a Tinggwang ziemne nsau kah lubui.<verse eid="PSA 18:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 18:30" />Tinggwang au, pe lampui au mzui! RAMPAUBE sam au mci!</para>
  <para style="q" vid="PSA 18:30">Pa au hegeu ge nzwa lie pe dade nsiu kera peei kelame ziemne.<verse eid="PSA 18:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 18:31" />Cau Tinggwang no RAMPAUBE ne mecai? Cau tsurabe no anui Tinggwang ne mecai?<verse eid="PSA 18:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 18:32" />Tinggwang a dage kiakang nzwa kengkieng kaibeu la, pa yicangsiak kecume de pe lampui sau beula.<verse eid="PSA 18:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 18:33" />Pa heti pi nzwa a pi tei mzet beu nah kecehu gage acu kaibeu!<verse eid="PSA 18:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 18:34" />Hereu tei kera pa a ba mtei beu nah hetageu lakpi teu ngkoilu kera a ba mtei beu.<verse eid="PSA 18:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 18:35" />Nang n kelikelu gu hegeu acu peuda. N ba zetle le acu ngha beu da, nah ngaugia de ne acu teingkieng beuda.<verse eid="PSA 18:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 18:36" />Nang a pi ziemne pe bam kedi ge teilu iciu eh a pi reneu di melu kerane.<verse eid="PSA 18:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 18:37" />Ih a ngauraume de zui mie nah penuide tuilu; penuide tei ngkap di kemakta Ih caili nreu gwang ma.<verse eid="PSA 18:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 18:38" />Ih penuide pwa sam iciu eh penui cuh dai melu kerane; penui a pi kangga kaumie.<verse eid="PSA 18:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 18:39" />Nang a dage hereu ziemne kiakang ge nzwa kengkieng kaibeu; acu renia cuh kelame de a kang gage kai dida.<verse eid="PSA 18:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 18:40" />Nang a ngauraume kedok acu peu; nah Ih acu ngau keraume leune de teingkap di.<verse eid="PSA 18:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 18:41" />Ngauraume kengha kiegai, dede migede penuide ngha ma; penui RAMPAUBE de qugai, dede pa penui sam keli ma.<verse eid="PSA 18:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 18:42" />Ih penuide dap takcai di eh tingkai ne guikela rebui nzwa teidi; Ih penuide lampuikidung gage tangdei nzwa keliengi di.<verse eid="PSA 18:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 18:43" />Nang acu mina keregi kecu gade acu kelibeu da. Nang acu heleuhdung reu pe peube teibeu da. Ih ci kemakme de a gwatei.<verse eid="PSA 18:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 18:44" />A sam siuge siu, penui a sam nzailu; sangmedung depeu a dwaga keukei mie.<note caller="+" style="f"><char style="fr" closed="false">18:44 </char><char style="ft" closed="false">2 Sam. 8:9-12</char></note><verse eid="PSA 18:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 18:45" />Sangme penui nsiubamdung gade mbeu eh mpet.<verse eid="PSA 18:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 18:46" />RAMPAUBE ring la; peu a tsura de hetwa punglu. Acu kelikebeube RAMPAUBE de peu hetwa herüt punglu lo.<verse eid="PSA 18:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 18:47" />Pa au a ziemne hekum peei beu kela Tinggwang, heleuhdung de a kangga kai beu kelabe.<verse eid="PSA 18:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 18:48" />A ngauraume dade acu kelilu da! Kesang, nang acu renia kelame reu acu kengkieng peu da! Nang regi kelame dade acu kelibeu da.<verse eid="PSA 18:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 18:49" />Cine Ih ncu twala zie, RAMPAUBO, heleuhdung kakgade; Ih ncu ketwa lei teila zie!<note caller="+" style="f"><char style="fr" closed="false">18:49 </char><char style="ft" closed="false">Rom. 15:9</char></note><verse eid="PSA 18:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 18:50" />Ngkieng kelu kedi Tinggwang pe hegwangpei de peu la, nah pegu keniak kelube de pe samkakkelu samsang de lia la, David de nah pe leuhme dage kelungta.<note caller="+" style="f"><char style="fr" closed="false">18:50 </char><char style="ft" closed="false">2 Sam. 7:16</char></note><verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="s">RAMPAUBE Zai au yicang</para>
  <para style="d">Lei kempwak muiteube ziemne. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 19:1" />Tinggimdung Tinggwang kemdu ranglia bam,</para>
  <para style="q" vid="PSA 19:1">nah tingkamdung pe tadung peu cigai bam!<verse eid="PSA 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 19:2" />Tingnai ge cai tingnai ge sam ranglia bam;</para>
  <para style="q" vid="PSA 19:2">tingmui ge cai tingmui ge pe maci keulia bam.<verse eid="PSA 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 19:3" />Marang kecu mede sam kerangdung de gah;</para>
  <para style="q" vid="PSA 19:3">penui kwa siu lama.<verse eid="PSA 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 19:4" />Iciuliede penui samdung kideu reu pelane ga la,</para>
  <para style="q" vid="PSA 19:4">nah penui samrang de kideu nli ga miecang la.</para>
  <para style="q" vid="PSA 19:4">Cipaudung kakga pa tingnaimiak ziemne ki ge tei pwabam.<note caller="+" style="f"><char style="fr" closed="false">19:4 </char><char style="ft" closed="false">samria aide Paul ne Rom. 10:18 ga rangdai kecu tei, peu samliakeyi de mmipet silukera ria gade teu ranggai.</char></note><verse eid="PSA 19:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 19:5" />Tingnaimiak de lakciube pei nzwa pe kibung gade mpet kecu nzwada</para>
  <para style="q" vid="PSA 19:5">nah mina kengkieng ge hezu nzu gaineu kela nzwada.<verse eid="PSA 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 19:6" />Tingnaimiak de tu ge lamde cuhla</para>
  <para style="q" vid="PSA 19:6">nah ting tetkah eh tu ge lamge tetgai dila;</para>
  <para style="q" vid="PSA 19:6">magede pe kelum de gade mbai gailak.<verse eid="PSA 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 19:7" />RAMPAUBE zai au yicang, rabe tei nring beula;</para>
  <para style="q" vid="PSA 19:7">RAMPAUBE zierang au nlumlu kebui ge, maci kegame de maci peula.<verse eid="PSA 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 19:8" />RAMPAUBE saulia kegaidung au petau, mlungbe suiyi tei lula;</para>
  <para style="q" vid="PSA 19:8">RAMPAUBE sam kai kebeudung au mci,</para>
  <para style="q" vid="PSA 19:8">cide mi miak de kebaa peu la.<verse eid="PSA 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 19:9" />RAMPAUBE de kerüt au mci, kelungta bamla;</para>
  <para style="q" vid="PSA 19:9">RAMPAUBE zaidung au kesang nah pelane petau ciak!<verse eid="PSA 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 19:10" />Cidungde au kecak swade pemi yiki, kecak yitube swade pemi kieeki;</para>
  <para style="q" vid="PSA 19:10">cidungde au heliadui swade kumki nah helialip gade zau kemie heliaduidung swade.<note caller="+" style="f"><char style="fr" closed="false">19:10 </char><char style="ft" closed="false">Lei. 119:72,103</char></note><verse eid="PSA 19:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 19:11" />Yeo, penui dade n kilabe de rangmriak beu;<note caller="+" style="f"><char style="fr" closed="false">19:11 </char><char style="ft" closed="false">2 Jhn. 1:8, Lei. 119:11</char></note></para>
  <para style="q" vid="PSA 19:11">penuide nzai keluga ziehi kedi ge bam.<verse eid="PSA 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 19:12" />Cauge pekatei pe maudung ngau lubui no?</para>
  <para style="q" vid="PSA 19:12">Cikemak maudung gade acu tei mci beulo.<verse eid="PSA 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 19:13" />N kilabe acu peu hegiekela maudung gade nziadi lulo;</para>
  <para style="q" vid="PSA 19:13">peu cidungde de a reu ngkieng diso.</para>
  <para style="q" vid="PSA 19:13">Iciude Ih yicangsiak luzie,</para>
  <para style="q" vid="PSA 19:13">nah Ih hezai gileu kedi maudung gade nzeulu kerane.<note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="ft" closed="false">Pum. 15:30</char></note><verse eid="PSA 19:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 19:14" />Peu a mui samdung nah a nlung kecetdung</para>
  <para style="q" vid="PSA 19:14">nang luulu kebui tei lulo,</para>
  <para style="q" vid="PSA 19:14">RAMPAUBO, a tsura nah acu ri kebeube.<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="s">Anui RAMPAUBE Tinggwang zi de nlumlu</para>
  <para style="d">Lei kempwak muiteube ziemne. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 20:1" />Nang keherei kecudau RAMPAUBE depeu ncu ngha lo;</para>
  <para style="q" vid="PSA 20:1">Jacob Tinggwang zi depeu ncu gum beulo<verse eid="PSA 20:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 20:2" />nah kemci ni gade kengha langgai lo</para>
  <para style="q" vid="PSA 20:2">ncu Zion gade ngha kerane.<verse eid="PSA 20:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 20:3" />N recadung pelane depeu pecu nsung lu</para>
  <para style="q" vid="PSA 20:3">nah n keru ratak de luulu. <char style="qs">Selah</char><verse eid="PSA 20:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 20:4" />N mlung luu keneudung depeu pecu teibeu lu</para>
  <para style="q" vid="PSA 20:4">nah n mariemdung pelane peu teicang beu.<verse eid="PSA 20:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 20:5" />Iciude anui nang ngkiengkelu gade anui sui yizie,</para>
  <para style="q" vid="PSA 20:5">nah, anui Tinggwang zi gade, anui pailimdung pwacuh zie.</para>
  <para style="q" vid="PSA 20:5">Peu RAMPAUBE de nnui kekiedung tei beulu.<note caller="+" style="f"><char style="fr" closed="false">20:5 </char><char style="ft" closed="false">Lei. 60:4</char></note><verse eid="PSA 20:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 20:6" />Cu au Ih cida RAMPAUBE ne keniak kelube de kelibeu kera;</para>
  <para style="q" vid="PSA 20:6">pa pecu pe kemci tinggim gade pe samkeli beuzie</para>
  <para style="q" vid="PSA 20:6">pecu rilukebui zetle ba kengkieng de le.<verse eid="PSA 20:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 20:7" />Mi kangge bagidung de nlum la nah kedame hekwendung de,</para>
  <para style="q" vid="PSA 20:7">dede anui au RAMPAUBE anui Tinggwang de qula.<note caller="+" style="f"><char style="fr" closed="false">20:7 </char><char style="ft" closed="false">Lei. 33:16-17</char></note><verse eid="PSA 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 20:8" />Penuide tei henah dizie nah kau dizie,</para>
  <para style="q" vid="PSA 20:8">dede anui cuh luzie nah anui sapntip luzie!<verse eid="PSA 20:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 20:9" />RAMPAUBO, hegwangpei de ngkiengkelu peulo;</para>
  <para style="q" vid="PSA 20:9">anui qu kegaidau anuide ngha lo.<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="s">Hegwangpei RAMPAUBE kengkieng ga pesui yibam</para>
  <para style="d">Lei kempwak muiteube ziemne. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 21:1" />Hegwangpei n kengkieng de pesui la, RAMPAUBO!</para>
  <para style="q" vid="PSA 21:1">Nang kepeu ngkiengkelude ziemne pa pesui yisüt la!<verse eid="PSA 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 21:2" />Nang pe mlung luu keneude peuda</para>
  <para style="q" vid="PSA 21:2">nah pa kie kegaide peuta dima. <char style="qs">Selah</char><verse eid="PSA 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 21:3" />Nang pecu samlam kedidung teugwang beu;</para>
  <para style="q" vid="PSA 21:3">nang pe peu gage kecak hegwang peurwa kemci kaibeu.<verse eid="PSA 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 21:4" />Pa n dage kering kie; nang pecu cide peudi;</para>
  <para style="q" vid="PSA 21:4">nang pecu teilung ketie kelungta peu.<verse eid="PSA 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 21:5" />Nang ngha kebeune pe kendu au di bam dida;</para>
  <para style="q" vid="PSA 21:5">nang pecu hetwa nah zierang kedi peu da.<verse eid="PSA 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 21:6" />Kelungta samlamdung nang pecu peu;</para>
  <para style="q" vid="PSA 21:6">nang pe da kelane pa pesuiyi bam dida.<verse eid="PSA 21:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 21:7" />Hegwangpei RAMPAUBE de nlum kecune;</para>
  <para style="q" vid="PSA 21:7">Hutube Tinggwang samkakkelu samsang de ziemne pa nlai gailak.<verse eid="PSA 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 21:8" />N ba le n ngauraume pelane de tui luzie;</para>
  <para style="q" vid="PSA 21:8">n zetle ba le ncu ngkau kelame de tui luzie.<verse eid="PSA 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 21:9" />Nang n rata kecudau, nang ngauraume de mibung gage keru nzwa ru dizie.</para>
  <para style="q" vid="PSA 21:9">RAMPAUBE pe lunghop gade penuide ngkap dizie,</para>
  <para style="q" vid="PSA 21:9">nah mi le penuide ru dizie.<verse eid="PSA 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 21:10" />Nang penui leuhme de kideu gade ngkap dizie</para>
  <para style="q" vid="PSA 21:10">nah mina ria gade penui dade lungh gwang kelu leune de ngkap dizie.<verse eid="PSA 21:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 21:11" />Kedanemene penui n dage kemau teigai kera cet kedine;</para>
  <para style="q" vid="PSA 21:11">penui teigai kelak mariem ge tei!<verse eid="PSA 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 21:12" />Nang penuide teu nreu caili dizie;</para>
  <para style="q" vid="PSA 21:12">nang penui dwa gade n lakpi pwampet zie.<verse eid="PSA 21:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 21:13" />Hetwa punglu, RAMPAUBO, n kengkieng gade;</para>
  <para style="q" vid="PSA 21:13">anui lei teizie nah n kengkieng de twazie.<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="s">Nang daitei acu pütdi auno?</para>
  <para style="d">Lei kempwak muiteube ziemne; “Heti lei,” gage teigai kelu. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 22:1" />A Tinggwang, a Tinggwang, acu daitei gidi no?</para>
  <para style="q" vid="PSA 22:1">Nang daitei acu kelibeu kera nah a kemra kwa gade dei ham ladi no?<verse eid="PSA 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 22:2" />A Tinggwang, Ih tingkebaa dau qu gai, dede nang a sam kelibeu ma,</para>
  <para style="q" vid="PSA 22:2">nah tingmui dau Ih zing de bam ma!<verse eid="PSA 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 22:3" />Dede nang au mci;</para>
  <para style="q" vid="PSA 22:3">Israelme hetwa ngau eh nang hegwangme kengkieng bam.<verse eid="PSA 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 22:4" />Anui paume ncu nlum eh gwang;</para>
  <para style="q" vid="PSA 22:4">penui ncu nlum, nah nang penuide kelibeu.<verse eid="PSA 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 22:5" />Penui ncu qugai nah nang penuide kesiabe gade kelibeu.</para>
  <para style="q" vid="PSA 22:5">Penui ncu nlumlu nah penuide peu ngngamdi ma.<verse eid="PSA 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 22:6" />Dede Ih au tangseu ge nah mina ma,</para>
  <para style="q" vid="PSA 22:6">mina leuh dade hengam ge nah mina acu mneu la.<verse eid="PSA 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 22:7" />Acu kengaume leuh acu rangmsia la;</para>
  <para style="q" vid="PSA 22:7">penui acu nuila; penui acu penui peungum gaila.<note caller="+" style="f"><char style="fr" closed="false">22:7 </char><char style="ft" closed="false">Mat. 27:39, Mrk. 15:29</char></note><verse eid="PSA 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 22:8" />Penui rangla, “Pa RAMPAUBE de nlumla;</para>
  <para style="q" vid="PSA 22:8">peu RAMPAUBE de pecu kelibeu.</para>
  <para style="q" vid="PSA 22:8">Pecu peu pecu keli beulu, kedanemene pa pecu pesui lu.”<note caller="+" style="f"><char style="fr" closed="false">22:8 </char><char style="ft" closed="false">Lei. 91:14</char></note><verse eid="PSA 22:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 22:9" />Nang acu a pui puk gade ngngwa lu;</para>
  <para style="q" vid="PSA 22:9">Ih tung kebam dau gade nang acu peu ncu nlumlu.<verse eid="PSA 22:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 22:10" />Acu mna kelu gade ncu peu dida;</para>
  <para style="q" vid="PSA 22:10">Ih a pui puk ga kebam dau gade nang a Tinggwang da!<verse eid="PSA 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 22:11" />A dade mdei ladi helo, keherei a da nna la kedine;</para>
  <para style="q" vid="PSA 22:11">migede acu ngha kera gah.<verse eid="PSA 22:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 22:12" />Hetumseudung kekiee ge acu twagwa la;</para>
  <para style="q" vid="PSA 22:12">Bashan gu hetumseu kengkiengdung acu twagwapung bam.<verse eid="PSA 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 22:13" />Penui penui mui ngkei pwa acu kwabam</para>
  <para style="q" vid="PSA 22:13">Hingho pe taktyei teurak tyei kela nzwa.<verse eid="PSA 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 22:14" />Dui ruigi kegai nzwa acu de rui mpet bam,</para>
  <para style="q" vid="PSA 22:14">nah a radung pebam gade mpet kwa dida.</para>
  <para style="q" vid="PSA 22:14">A mlung maca nzwa da;</para>
  <para style="q" vid="PSA 22:14">cide a lung gade lwatet dila.<verse eid="PSA 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 22:15" />Lidei le tei kelu ge cangh kedi nzwa a kengkieng cangh dida;</para>
  <para style="q" vid="PSA 22:15">nah a mleu a ngngak ga koppwa bam dida.</para>
  <para style="q" vid="PSA 22:15">Nang acu ketsai rebui gage kaigai dida.<note caller="+" style="f"><char style="fr" closed="false">22:15 </char><char style="ft" closed="false">Mac. 17:22</char></note><verse eid="PSA 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 22:16" />Heteudung ne acu twagwapung bam dida;</para>
  <para style="q" vid="PSA 22:16">makesia ketei maa acu twagwa luda;</para>
  <para style="q" vid="PSA 22:16">penui a ba nah a pi kui dida.<note caller="+" style="f"><char style="fr" closed="false">22:16 </char><char style="ft" closed="false">Mat. 27:35, Mrk. 15:29, Luk. 23:33</char></note><verse eid="PSA 22:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 22:17" />Ih a radung peei ciak lubui da.</para>
  <para style="q" vid="PSA 22:17">Penui acu pie nah pieling eh bam.<verse eid="PSA 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 22:18" />Penui a painidung penui kakgade nzi luda,</para>
  <para style="q" vid="PSA 22:18">penui a painidung ziemne dacak tei.<note caller="+" style="f"><char style="fr" closed="false">22:18 </char><char style="ft" closed="false">Mat. 27:35, Luk. 23:34, Jhn. 19:24-25</char></note><verse eid="PSA 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 22:19" />Mdei la di helo, RAMPAUBO;</para>
  <para style="q" vid="PSA 22:19">acu ngha kera nzet gailo, a kengkieng!<verse eid="PSA 22:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 22:20" />A rabe de kiengtie gade keli beulo,</para>
  <para style="q" vid="PSA 22:20">a teilung ket rünne kecu heteu aidungde dade keli beulo.<verse eid="PSA 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 22:21" />Acu hingho mui gade keli beulo;</para>
  <para style="q" vid="PSA 22:21">pezai kesia hetumseu kiidung dade acu keli beulo.<verse eid="PSA 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 22:22" />Ih a sinamedung de n zi ndu lia zie,</para>
  <para style="q" vid="PSA 22:22">hemaabe kakga de Ih ncu twa zie.<note caller="+" style="f"><char style="fr" closed="false">22:22 </char><char style="ft" closed="false">Heb. 2:12</char></note><verse eid="PSA 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 22:23" />RAMPAUBE de rüt kelane, pecu twalu!</para>
  <para style="q" vid="PSA 22:23">Pecu rütlu, nnui Jacob leuhme pelane!</para>
  <para style="q" vid="PSA 22:23">Pecu herüt peulu, nnui Israelme leuhme pelane!<note caller="+" style="f"><char style="fr" closed="false">22:23 </char><char style="ft" closed="false">Lei. 135:19-20</char></note><verse eid="PSA 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 22:24" />Kedanemene pa keherei kelame de mlaidi lama mede malie tadi ma;</para>
  <para style="q" vid="PSA 22:24">RAMPAUBE pe dade pe zu kebai di ma;</para>
  <para style="q" vid="PSA 22:24">keherei kelame pecu qugai kecu dau, pa kingnei lula.<verse eid="PSA 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 22:25" />Hemaa madi gade Ih ncu twa zie;</para>
  <para style="q" vid="PSA 22:25">Ih a sampet de pecu hing kelame dage teicang luzie.<verse eid="PSA 22:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 22:26" />Keherei kelame matyei zie nah nggei luzie;</para>
  <para style="q" vid="PSA 22:26">RAMPAUBE de peei kelame pecu twa zie.</para>
  <para style="q" vid="PSA 22:26">Peu nnui mlungdung kelungta lungh lalo.<verse eid="PSA 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 22:27" />Kideu ga mina pelane RAMPAUBE de nsung zie nah pe da nreu gwang luzie;</para>
  <para style="q" vid="PSA 22:27">heleuh leune kibaumedung n dwa ga keukei mie zie.<verse eid="PSA 22:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 22:28" />RAMPAUBE au hegwang;</para>
  <para style="q" vid="PSA 22:28">pa au heleuhdung reu kedibe.<note caller="+" style="f"><char style="fr" closed="false">22:28 </char><char style="ft" closed="false">Zec. 14:9</char></note><verse eid="PSA 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 22:29" />Kideu ga lungh keyime leune taktyei ngyi hengyi zie nah RAMPAUBE de reca zie;</para>
  <para style="q" vid="PSA 22:29">rebui ga nghungdi lai eh kebamme leune pe dwaga keumie zie,</para>
  <para style="q" vid="PSA 22:29">penuikatei penui teilung tei ntiegai kelakme.<verse eid="PSA 22:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 22:30" />Gwang kezeu heleuh ge pe ta tei kegaide;</para>
  <para style="q" vid="PSA 22:30">penui Rampaube ha penui cai gwang kezeu heleuhdung dage ranglia zie.<verse eid="PSA 22:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 22:31" />Penui gwang eh pe kesamsang ha ranglia zie;</para>
  <para style="q" vid="PSA 22:31">penui gwang dai kera ceheu dage pe ta ranglia zie!<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="s">RAMPAUBE au acu kekwabe</para>
  <para style="d">David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 23:1" />RAMPAUBE au acu kekwabe; Ih magede teu si kera bamsi meda.<note caller="+" style="f"><char style="fr" closed="false">23:1 </char><char style="ft" closed="false">Isa. 40:11, Ezk. 34:11-16</char></note><verse eid="PSA 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 23:2" />Pa acu peu luh kemdiak ga mtak lula;</para>
  <para style="q" vid="PSA 23:2">dui mlai kemak kemci jai gage ngngwagai beula.<verse eid="PSA 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 23:3" />Pa a teilung teiheci dai beula;</para>
  <para style="q" vid="PSA 23:3">pa acu lampui keyi gage sau gai beula pe zi ziemne.<verse eid="PSA 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 23:4" />Ih cabak kemuideu ga tetkah liede,</para>
  <para style="q" vid="PSA 23:4">nang acu ngngwa kelane Ih kesiabe de hing dilak;</para>
  <para style="q" vid="PSA 23:4">n meurün kekwatie nah n tuitie ne a ma piela.<verse eid="PSA 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 23:5" />Nang a ngauraume dwa gade a ziemne heni ge mtei pwabam;</para>
  <para style="q" vid="PSA 23:5">nang macale pwa a peu püt beula;<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="ft" closed="false">Ki mpaube ne pe giame peu maca le püt beukela zai aide penuide kerüt nah suiyi teu eh daukecu teila. Phariseeme pei Simon Luk. 7:46 ga Jisu de redau kecudau aide teilu tadikedi ngau lula.</char></note></para>
  <para style="q" vid="PSA 23:5">a piak pui nlim bam.<verse eid="PSA 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 23:6" />Ma keyi nah samkakkelu kesamsang a teilung pelane suila mui zie;</para>
  <para style="q" vid="PSA 23:6">nah Ih RAMPAUBE ki ga a teilung kelungta lungh dizie.<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="s">Kendu Gwangpei</para>
  <para style="d">David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 24:1" />Kideube au RAMPAUBE gu, nah cika kebam peciakne,</para>
  <para style="q" vid="PSA 24:1">kideu pelane, nah cika kelunghme leune.<verse eid="PSA 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 24:2" />Pa cide kideu jaaidung kang dui kecuk reu gage teilu</para>
  <para style="q" vid="PSA 24:2">nah hereukidung gage tei kegaine.<verse eid="PSA 24:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 24:3" />Cau RAMPAUBE lamlwa<note caller="+" style="f"><char style="fr" closed="false">24:3 </char><char style="ft" closed="false">zion</char></note> ga nghang lai?</para>
  <para style="q" vid="PSA 24:3">Cau pe kemci ni ga sap<note caller="+" style="f"><char style="fr" closed="false">24:3 </char><char style="ft" closed="false">reca </char></note> lai?<verse eid="PSA 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 24:4" />Pe ba mci kecume nah pe mlung kemcime;</para>
  <para style="q" vid="PSA 24:4">kenretpe ga pe lung kai kemakme,<note caller="+" style="f"><char style="fr" closed="false">24:4 </char><char style="ft" closed="false">mamie de reca kemakme.</char></note></para>
  <para style="q" vid="PSA 24:4">nah mide cwa eh resetla kemakme.<verse eid="PSA 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 24:5" />Pa RAMPAUBE dade samlam ngau zie</para>
  <para style="q" vid="PSA 24:5">nah pe kelikelu Tinggwang dade kesamsang ngau zie.<verse eid="PSA 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 24:6" />Tinggwang de peeikela heleuhdung ainzwa zie,</para>
  <para style="q" vid="PSA 24:6">Jacob Tinggwang de peei kelame. <char style="qs">Selah</char><verse eid="PSA 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 24:7" />Nnui peu ngang cuhlu, nnui heriekidung;</para>
  <para style="q" vid="PSA 24:7">cuhlu, kelungta kikamdung,</para>
  <para style="q" vid="PSA 24:7">iciu eh Hegwang kendu nlütlu kerane!<verse eid="PSA 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 24:8" />Hegwang Kendu aide cauno?</para>
  <para style="q" vid="PSA 24:8">RAMPAUBE, ngkieng nah kedi; RAMPAUBE, hereu ketei gade kedi.<verse eid="PSA 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 24:9" />Nnui peu ngang cuhlu, nnui heriekidung;</para>
  <para style="q" vid="PSA 24:9">cuhlu, kelungta kikamdung,</para>
  <para style="q" vid="PSA 24:9">iciu eh kendu Hegwangpei nlütlu kerane!<verse eid="PSA 24:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 24:10" />Kendu Hegwangpei aide cauno?</para>
  <para style="q" vid="PSA 24:10">Reugwame reu RAMPAUBE,</para>
  <para style="q" vid="PSA 24:10">pane kendu Hegwangpei da. <char style="qs">Selah</char><verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="s">N lampui acu ledeubeulo</para>
  <para style="q">David lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 25:1" />N dage, RAMPAUBO, Ih a teilung kaibeu la!<verse eid="PSA 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 25:2" />A Tinggwang, Ih ncu nlum.</para>
  <para style="q" vid="PSA 25:2">Acu peu hengam tei diso;</para>
  <para style="q" vid="PSA 25:2">peu a ngauraumedung a reu ngkieng eh penui sui yi diso.<verse eid="PSA 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 25:3" />N dage keregui kebam mige dade de peu hengam gwang diso,</para>
  <para style="q" vid="PSA 25:3">mide cwa kelame de peu hengam tei dilu!<verse eid="PSA 25:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 25:4" />N lampuidung acu lia lo, RAMPAUBO;</para>
  <para style="q" vid="PSA 25:4">n lampuidung acu ledeu beulo.<verse eid="PSA 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 25:5" />N kesang gage acu saugai beulo nah ledeu beulo,</para>
  <para style="q" vid="PSA 25:5">kedanemene nang acu keli kebeube a Tinggwang kecune;</para>
  <para style="q" vid="PSA 25:5">petingnai Ih n da regui bamla.<verse eid="PSA 25:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 25:6" />Nsung gailo, RAMPAUBO, n ngaugia ta nah n samkakkelu samsang;</para>
  <para style="q" vid="PSA 25:6">kedanemene cidungde ndaa de bamdi delu.<verse eid="PSA 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 25:7" />A rehangdau kemau tei kedidung nah Ih renia kegaidung de nsung helo;</para>
  <para style="q" vid="PSA 25:7">Samkakkelu samsang dele acu nsung gailo n keyi de ziemne, RAMPAUBO!<verse eid="PSA 25:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 25:8" />RAMPAUBE au yi nah mzui;</para>
  <para style="q" vid="PSA 25:8">ci ziemne pa kemaume de lampui ledeu lia la.<verse eid="PSA 25:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 25:9" />Pa kehename de petau gage saulia gaila</para>
  <para style="q" vid="PSA 25:9">nah pa pe lampui penuide ledeu beula.<verse eid="PSA 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 25:10" />Pe keku nah pe masang au nli dila ma</para>
  <para style="q" vid="PSA 25:10">RAMPAUBE sam kaikebeu de mzai kelame de pa penuide lampui sau lia lala.<note caller="+" style="f"><char style="fr" closed="false">25:10 </char><char style="ft" closed="false">Jhn. 1:17</char></note><verse eid="PSA 25:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 25:11" />N zi ziemne, RAMPAUBO,</para>
  <para style="q" vid="PSA 25:11">a maugi beulo, kedanemene cide disüt kecune.<verse eid="PSA 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 25:12" />RAMPAUBE de hing kelabe cauno?</para>
  <para style="q" vid="PSA 25:12">Pa lampui teigai kera ga Rampaube pecu saulia beuzie.<verse eid="PSA 25:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 25:13" />Pe teilung au ma keyibe le pui zie;</para>
  <para style="q" vid="PSA 25:13">nah pe dade lungh kegwangme ne hangdeu de gum luzie.<verse eid="PSA 25:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 25:14" />RAMPAUBE zangna au pecu herüt peu kelame ziemne,</para>
  <para style="q" vid="PSA 25:14">nah pa pe samkak de penuide peu cilu la.<note caller="+" style="f"><char style="fr" closed="false">25:14 </char><char style="ft" closed="false">Eph. 1:9;1:18</char></note><verse eid="PSA 25:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 25:15" />A miakdung au RAMPAUBE da bammui la,</para>
  <para style="q" vid="PSA 25:15">kedanemene pa a pi baih gade kelibeu zie kecune.<note caller="-" style="x"><char style="xo" closed="false">25:15 </char><char style="xt" closed="false"><ref loc="PSA 141:8">Lei. 141:8</ref></char></note><verse eid="PSA 25:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 25:16" />A da nreu gwanglo nah acu ngaunggia gailo;</para>
  <para style="q" vid="PSA 25:16">kedanemene Ih akatei la nah keherei la kecune.<verse eid="PSA 25:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 25:17" />A nlung kehereidung de au dihki dida;</para>
  <para style="q" vid="PSA 25:17">a lungreidung gade acu ngngwa mpet beulo!<verse eid="PSA 25:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 25:18" />A lungrei nah keherei kecudung pie gailo;</para>
  <para style="q" vid="PSA 25:18">a maudung leune gi beulo.<verse eid="PSA 25:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 25:19" />A ngauraumedung de pie gailo, kedanemene penui au kieesüt kecune;</para>
  <para style="q" vid="PSA 25:19">penui acu ngkautube le acu ngkau la.<verse eid="PSA 25:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 25:20" />A teilung gum beulo nah acu keli beulo;</para>
  <para style="q" vid="PSA 25:20">peu acu tei ngngam diso, kedanemene Ih n dage nsiu lalu!<verse eid="PSA 25:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 25:21" />A samsang nah a masang depeu acu gumlu,</para>
  <para style="q" vid="PSA 25:21">kedanemene Ih n dade regui kelane.<verse eid="PSA 25:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 25:22" />Israel de kelibeu lo, Tinggwang,</para>
  <para style="q" vid="PSA 25:22">penui keherei pelane gade!<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="s">Ih RAMPAUBE de suihau beuzie</para>
  <para style="d">David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 26:1" />Acu tiaklu, RAMPAUBO, kedanemene Ih kenzui lampui ga tet lalu;</para>
  <para style="q" vid="PSA 26:1">Ih RAMPAUBE de suihau mezing eh nlumla.<verse eid="PSA 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 26:2" />Acu ncetlu, RAMPAUBO, nah kedak pielu;</para>
  <para style="q" vid="PSA 26:2">a lungcetdung nah a nlung kedak pielu!<verse eid="PSA 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 26:3" />Kedanemene n samkakkelu samsang de a miak dwa ga bam kecune,</para>
  <para style="q" vid="PSA 26:3">nah Ih n masang ga tetla.<verse eid="PSA 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 26:4" />Mide cwa kelame de Ih kangngwa tei lama,</para>
  <para style="q" vid="PSA 26:4">mede Ih samsang kemakme de de ngngwa lama.<verse eid="PSA 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 26:5" />Makesia ketei maa de de Ih ngkau la,</para>
  <para style="q" vid="PSA 26:5">nah kesiame de Ih ngngwa lungh lama.<verse eid="PSA 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 26:6" />Ih nzeu lei kecu gade a ba mtiaklu,</para>
  <para style="q" vid="PSA 26:6">nah Ih n recabam tet twagwa, RAMPAUBO,<note caller="-" style="x"><char style="xo" closed="false">26:6 </char><char style="xt" closed="false"><ref loc="PSA 73:13">Lei. 73:13</ref></char></note><verse eid="PSA 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 26:7" />ketwa lei tei sahbak kerane</para>
  <para style="q" vid="PSA 26:7">nah n miswakegah batadung pelane ranglia kerane.<verse eid="PSA 26:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 26:8" />RAMPAUBO, nang lungh kebam ki de Ih a sui lie,</para>
  <para style="q" vid="PSA 26:8">n kendu kebam heni de!<verse eid="PSA 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 26:9" />Kemaume de ngkap kedi ga acu si helo</para>
  <para style="q" vid="PSA 26:9">mede mide dap ketsetme de si eh a teilung tei ngkap di helo,<verse eid="PSA 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 26:10" />penui ba ga mariem kesia la,</para>
  <para style="q" vid="PSA 26:10">nah penui ba zetle ga hetauhenim le pui pungla.<verse eid="PSA 26:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 26:11" />Dede Ih au, kemzui lampui ga tetla;</para>
  <para style="q" vid="PSA 26:11">acu kelibeu nah acu ngaunggia gailo.<verse eid="PSA 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 26:12" />A pi hangdeu kensam<note caller="+" style="f"><char style="fr" closed="false">26:12 </char><char style="fq" closed="false">Hangdeu kensam: </char><char style="ft" closed="false">Hangdeu kengkieng.</char></note> ga sapbam;</para>
  <para style="q" vid="PSA 26:12">hemaabe dwagade Ih RAMPAUBE de samlam beuzie!<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="s">RAMPAUBE au a kebaa nah a kelikelube</para>
  <para style="d">David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 27:1" />RAMPAUBE a kebaa nah acu ri kebeube;</para>
  <para style="q" vid="PSA 27:1">Ih cau de hing lai?</para>
  <para style="q" vid="PSA 27:1">RAMPAUBE a teilung kensiube;</para>
  <para style="q" vid="PSA 27:1">Ih cauge de hing swa lai?<verse eid="PSA 27:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 27:2" />Kemau keteime a teih tyei zie lie a da gwang kecudau,</para>
  <para style="q" vid="PSA 27:2">acu renia kelame nah a ngauraume penui pi nsui eh kau di.<verse eid="PSA 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 27:3" />Reugwame acu twagwapung bam liede,</para>
  <para style="q" vid="PSA 27:3">a nlung hing dilak;</para>
  <para style="q" vid="PSA 27:3">a da hereu teicuh di liede,</para>
  <para style="q" vid="PSA 27:3">cinzwa liede Ih kuu eh bamzie.<verse eid="PSA 27:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 27:4" />RAMPAUBE dade Ih mage kiela, nah Ih cide peei zie:<note caller="+" style="f"><char style="fr" closed="false">27:4 </char><char style="ft" closed="false">Lei. 6:8;23:6, Phi. 3:13</char></note></para>
  <para style="q" vid="PSA 27:4">Ih a teilung pelane RAMPAUBE kiga lunghlu kerane,</para>
  <para style="q" vid="PSA 27:4">RAMPAUBE keyi de pie kerane</para>
  <para style="q" vid="PSA 27:4">nah pe kerecaki gade Ih macet ncoklu kerane.<verse eid="PSA 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 27:5" />Kedanemene keherei tingdau kelu benai pa acu pe ki ga acu kebai luzie;</para>
  <para style="q" vid="PSA 27:5">pe paiki gum le pa acu gum luzie.</para>
  <para style="q" vid="PSA 27:5">Pa acu tsura reu gage teu ncuh gai beuzie!<note caller="+" style="f"><char style="fr" closed="false">27:5 </char><char style="ft" closed="false">Lei. 91:1;40:2;138:7</char></note><verse eid="PSA 27:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 27:6" />Pecai acu twagwa kebam a ngauraume leune reu ga a peu cuh di,</para>
  <para style="q" vid="PSA 27:6">nah pe paiki gade Ih a sui keyi ratakdung peu zie!</para>
  <para style="q" vid="PSA 27:6">Ih lei teizie nah RAMPAUBE dage leidung teigai zie!<note caller="+" style="f"><char style="fr" closed="false">27:6 </char><char style="ft" closed="false">Lei. 3:3</char></note><verse eid="PSA 27:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 27:7" />Kingneilu, RAMPAUBO, a kwa Ih n da mra kegaidau!</para>
  <para style="q" vid="PSA 27:7">Acu ngaunggia gailo, nah a sam keli lo!<note caller="+" style="f"><char style="fr" closed="false">27:7 </char><char style="ft" closed="false">Lei. 130:2-4;13:3</char></note><verse eid="PSA 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 27:8" />A mlung n ha rangla,</para>
  <para style="q" vid="PSA 27:8">“Pe zu peeilu!” Ih n zu peei la, RAMPAUBO!<verse eid="PSA 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 27:9" />N zu a dade kebai di helo;</para>
  <para style="q" vid="PSA 27:9">n kilabe de n rata le peu nreutetdi helo!</para>
  <para style="q" vid="PSA 27:9">Nang acu kenghabe tei beuda;</para>
  <para style="q" vid="PSA 27:9">acu gidi so mede pütdi so, acu rikebeube Tinggwang!<verse eid="PSA 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 27:10" />A pei nah a pui acu gidi liede,</para>
  <para style="q" vid="PSA 27:10">RAMPAUBE acu ngngwa luzie.<verse eid="PSA 27:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 27:11" />N lampui acu ledeu beulo, RAMPAUBO!</para>
  <para style="q" vid="PSA 27:11">Acu lampui kemzui gage ngngwa gai beulo</para>
  <para style="q" vid="PSA 27:11">a ngauraume ziemne.<note caller="+" style="f"><char style="fr" closed="false">27:11 </char><char style="ft" closed="false">Lei. 5:8 </char></note><verse eid="PSA 27:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 27:12" />A ngauraume luu keneu gage acu gidi helo,</para>
  <para style="q" vid="PSA 27:12">kedanemene kenret zierangdung acu mmau cuh kedine,</para>
  <para style="q" vid="PSA 27:12">nah penui rata cui ngngi mpet!<verse eid="PSA 27:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 27:13" />Ring kelame deu gade RAMPAUBE keyi de ngau kera Ih nlumlu meliecai a da daitei dizie bi?<note caller="+" style="f"><char style="fr" closed="false">27:13 </char><char style="ft" closed="false">Lei. 142:5</char></note><verse eid="PSA 27:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 27:14" />RAMPAUBE de kwa bamlu;</para>
  <para style="q" vid="PSA 27:14">ngkienglu, nah peu n nlung de kuu lu!</para>
  <para style="q" vid="PSA 27:14">RAMPAUBE de kwalu!<note caller="+" style="f"><char style="fr" closed="false">27:14 </char><char style="ft" closed="false">Lei. 31:24</char></note><verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="s">RAMPAUBE au a kengkieng nah a hegeu</para>
  <para style="d">David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 28:1" />N dage, RAMPAUBO, Ih mra gaila; a tsura, acu gidi so.</para>
  <para style="q" vid="PSA 28:1">Nang a sam kelibeu tadi cai, Ih herau ga nghung kelame de nzang dizie.<verse eid="PSA 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 28:2" />Ih n ngha kie kegai dau a nggia kwa kingnei,</para>
  <para style="q" vid="PSA 28:2">Ih n kemci ni lamge a ba hwa kegaidau!<verse eid="PSA 28:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 28:3" />Kesiame de si eh acu teukerei so,</para>
  <para style="q" vid="PSA 28:3">kesia keteime de si eh,</para>
  <para style="q" vid="PSA 28:3">pe kidacaina dage lungciep teu eh resiu la dede lungning kesia penui nlung ga la.<verse eid="PSA 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 28:4" />Penui batadung ziemne penui ngau kebui peulo nah penui ta kesiadung kie kegai saja de peulo,</para>
  <para style="q" vid="PSA 28:4">penui batadung ziemne penuide saja peulo nah penui ngau kerabe penuide peulo.<note caller="+" style="f"><char style="fr" closed="false">28:4 </char><char style="ft" closed="false">Mat. 16:27, Keu. 18:6,13;22:12</char></note><verse eid="PSA 28:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 28:5" />Kedanemene kesiame RAMPAUBE batadung de ci melu mede pe ba le tei kegaidung de,</para>
  <para style="q" vid="PSA 28:5">Tinggwang cidungde teurak dizie nah madaude tei hemi daibeu lak.<verse eid="PSA 28:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 28:6" />RAMPAUBE de hetwa peulo</para>
  <para style="q" vid="PSA 28:6">kedanemene pa a kengha nggia kwa kingnei kelune!<verse eid="PSA 28:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 28:7" />RAMPAUBE a kengkieng nah a hegeu;</para>
  <para style="q" vid="PSA 28:7">a nlung pecu nlumla, nah Ih kengha ngaulu da.</para>
  <para style="q" vid="PSA 28:7">Cine a nlung sui yisütlu,</para>
  <para style="q" vid="PSA 28:7">nah Ih pecu lei tei eh twa zie.<verse eid="PSA 28:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 28:8" />RAMPAUBE au pe minadung gu kengkiengbe,</para>
  <para style="q" vid="PSA 28:8">nah pane keniak kelube gu kelibeu kela kemsiube.<verse eid="PSA 28:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 28:9" />N minadung de kelibeulo nah n mapwa de samlam beulo.</para>
  <para style="q" vid="PSA 28:9">Penui meurün kekwabe lu nah penuide kelungta ngngwa lalu.<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="s">RAMPAUBE de Kendu peulo</para>
  <para style="d">David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 29:1" />RAMPAUBE de peulo, nnui Tinggwang gwamedung,</para>
  <para style="q" vid="PSA 29:1">RAMPAUBE de kendu nah kengkieng peulo!<verse eid="PSA 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 29:2" />RAMPAUBE de pe zi ngau kebui kendu peulo.</para>
  <para style="q" vid="PSA 29:2">RAMPAUBE kemci dwaga keumie lu!<verse eid="PSA 29:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 29:3" />RAMPAUBE kwa au dui reudung gade siubam;</para>
  <para style="q" vid="PSA 29:3">kemdu Tinggwang tingceu gaizeu,</para>
  <para style="q" vid="PSA 29:3">RAMPAUBE dui reudung pelane de tingceu gaizeu.<note caller="+" style="f"><char style="fr" closed="false">29:3 </char><char style="ft" closed="false">Job 37:4-5</char></note><verse eid="PSA 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 29:4" />RAMPAUBE kwa au ngkieng süt;</para>
  <para style="q" vid="PSA 29:4">RAMPAUBE kwa au hecili eh.<verse eid="PSA 29:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 29:5" />RAMPAUBE kwa cedar bangdung de teipang dila;</para>
  <para style="q" vid="PSA 29:5">RAMPAUBE Lebanon<note caller="+" style="f"><char style="fr" closed="false">29:5 </char><char style="ft" closed="false">Lebanon lamlwa</char></note> cedarbangdung de tei kecai dila.<verse eid="PSA 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 29:6" />Pa Lebanon de hetumna nzwa peu nsau</para>
  <para style="q" vid="PSA 29:6">nah Sirion lamlwa de peu hetumseuna nzwa.<verse eid="PSA 29:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 29:7" />RAMPAUBE kwa ne miheu tei mpet.<verse eid="PSA 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 29:8" />RAMPAUBE kwa ne renaamkang de tei mlai di;</para>
  <para style="q" vid="PSA 29:8">RAMPAUBE Kadesh renaamkang de tei mlai.<verse eid="PSA 29:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 29:9" />RAMPAUBE<note caller="+" style="f"><char style="fr" closed="false">29:9 </char><char style="ft" closed="false">he makes deer to go into labor,</char></note> kwa ne mhu bangdung teu kelai dida</para>
  <para style="q" vid="PSA 29:9">nah hegungdung de tei mrwa di.</para>
  <para style="q" vid="PSA 29:9">Kerecaki ga mina pelane, “Ndulo!” De eh rangdi.<verse eid="PSA 29:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 29:10" />RAMPAUBE duinai reuga hegwangpei tei eh bam.</para>
  <para style="q" vid="PSA 29:10">RAMPAUBE kelungta hegwang tei eh bam.<verse eid="PSA 29:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 29:11" />RAMPAUBE pe minadung de kengkieng peula;</para>
  <para style="q" vid="PSA 29:11">RAMPAUBE pe minadung de lungciep pwa samlam beula.<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="s">Suiyi tingcang gwanglu la</para>
  <para style="d">Lei ge; kerecaki pwa peu kecudau gu lei ge. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 30:1" />Ih ncu twa zie, RAMPAUBO, kedanemene nang acu kecok gade teucuh kebeune nah a ngauraume depeu acu nuidi kemakne.<verse eid="PSA 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 30:2" />RAMPAUBO a Tinggwang, Ih n dage a kengha nggia mra gai,</para>
  <para style="q" vid="PSA 30:2">nah nang acu tei hemi beu.<verse eid="PSA 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 30:3" />RAMPAUBO, nang Sheol gade a rabe kelibeu; herau ga nghungdi kera gade nang acu kelibeu.<verse eid="PSA 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 30:4" />RAMPAUBE dage ketwa lei teigai lu, nnui kesamsangmedung! Nang pe kemci de nsung keludau pecu hetwa peulu.<verse eid="PSA 30:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 30:5" />Kedanemene RAMPAUBE rata au tingkak nage gwale sila kemakne; dede pe zai keyi au kelungta bamla.</para>
  <para style="q" vid="PSA 30:5">Kehap au tingmui ziu ge ziemne gwangla, dede tingcang dau suiyi gwangla.<verse eid="PSA 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 30:6" />Ih a lung di eh akatei acu rangdi, “Acu madaude tei nlaidi gailak.”<verse eid="PSA 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 30:7" />RAMPAUBO, n zai keyi le nang acu lamlwa kengkieng ge nzwa teibeu da; dede nang n zu kebai kedi dau, Ih keherei di.<verse eid="PSA 30:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 30:8" />Ih n dage mra gai, RAMPAUBO, nang a Rampaube dade kengha peei!<verse eid="PSA 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 30:9" />A tsit ga kemmi daige bamno, Ih herau ga nlüt dicai? Rebui ne ncu twa zieni? Cidene ncu nlumlukebui de rangndu zieni?<verse eid="PSA 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 30:10" />Kingneilo, RAMPAUBO, nah acu nggia gailo!</para>
  <para style="q" vid="PSA 30:10">RAMPAUBO, a kenghabe lulo.<verse eid="PSA 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 30:11" />Nang a lungrei teipwa misui keyi limge tei dida; nang a sui kesiade keugi dida nah a suiyile peu pui luda.<verse eid="PSA 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 30:12" />Cine cu a kendu ncu ketwa lei tei zie nah zingde bam dilak; RAMPAUBE a Tinggwang, Ih ncu kelungta hetwa peu lazie!<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="s">N ba gage Ih a Rabe kaila</para>
  <para style="d">Lei kempwakme muiteube ziemne. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 31:1" />Ih n dage, RAMPAUBO, nsiu gaila;</para>
  <para style="q" vid="PSA 31:1">madaude peu acu hengam tei diso</para>
  <para style="q" vid="PSA 31:1">N kesamsang le acu kelibeu lo.<verse eid="PSA 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 31:2" />A kwa siu gailo; acu kelibeu zette lo;</para>
  <para style="q" vid="PSA 31:2">a kensiu tsurabe ge lulo,</para>
  <para style="q" vid="PSA 31:2">acu kelibeu kera kemsiu bam ge.<note caller="+" style="f"><char style="fr" closed="false">31:2 </char><char style="ft" closed="false">Lei. 102:2</char></note><verse eid="PSA 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 31:3" />Kedanemene nang au akensiube nah acu kegumbe;</para>
  <para style="q" vid="PSA 31:3">ciziemne n zi ziemne, a mapie nah acu teuswa beulo.<verse eid="PSA 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 31:4" />Penui hebaih a ziemne hebai pwa kebam gade acu teu mpet beulo,</para>
  <para style="q" vid="PSA 31:4">kedanemene nang a kemsiube kecune.<verse eid="PSA 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 31:5" />N ba gage Ih rabe kaibeu la;</para>
  <para style="q" vid="PSA 31:5">nang acu kelibeu zie, RAMPAUBO, makesang Tinggwang.<note caller="+" style="f"><char style="fr" closed="false">31:5 </char><char style="ft" closed="false">Luk. 23:46, Bat. 7:59, 1 Pet. 4:19</char></note><verse eid="PSA 31:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 31:6" />Kemta miedung reca kelame de Ih ngkaula,</para>
  <para style="q" vid="PSA 31:6">dede Ih RAMPAUBE de nlum.<note caller="+" style="f"><char style="fr" closed="false">31:6 </char><char style="ft" closed="false">Lei. 24:4</char></note><verse eid="PSA 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 31:7" />N samkakkelu samsang ga Ih a sui yi nah sui yisüt lazie,</para>
  <para style="q" vid="PSA 31:7">kedanemene nang a rei ngau de kecune;</para>
  <para style="q" vid="PSA 31:7">nang a rabe keherei kecu cibam.<verse eid="PSA 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 31:8" />Nang a ngauraume ba gage acu kaidi ma.</para>
  <para style="q" vid="PSA 31:8">Nang a pi heni kemza gage kaibeu.<verse eid="PSA 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 31:9" />Acu ngaunggia gailo, RAMPAUBO, kedanemene Ih keherei kelane;</para>
  <para style="q" vid="PSA 31:9">a rabe nah a pumteih ga lungrei kebam ngau eh a miak leu dida.<verse eid="PSA 31:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 31:10" />A suisiet le a teilung leu dida</para>
  <para style="q" vid="PSA 31:10">nah kencam le a mmidung leu dida.</para>
  <para style="q" vid="PSA 31:10">A mau ziemne a kengkieng mnei dida,</para>
  <para style="q" vid="PSA 31:10">nah a radung tuii eh gahdi zeuda.<verse eid="PSA 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 31:11" />A ngauraume pelane ziemne, mina acu ngau ngkau dida;</para>
  <para style="q" vid="PSA 31:11">a kidacaina acu pie eh penui swagah dida,</para>
  <para style="q" vid="PSA 31:11">nah acu ci kebamme hingsüt dida.</para>
  <para style="q" vid="PSA 31:11">Lampuiki ga acu kengaume a dade pak mdei dila.<verse eid="PSA 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 31:12" />Acu au ketsaime ge de mina nsung la kemak nzwa nsungta dida.</para>
  <para style="q" vid="PSA 31:12">Ih au kepang li ge nzwa dida.<verse eid="PSA 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 31:13" />Kedanemene Ih mi kekiee ge ngkim kempau kebam Ih siu da,</para>
  <para style="q" vid="PSA 31:13">kengngi samdung tu leune gade</para>
  <para style="q" vid="PSA 31:13">penui a da makesia teigai kera riem bam.</para>
  <para style="q" vid="PSA 31:13">Penui a teilung keuteu di kera riem bam dida.<verse eid="PSA 31:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 31:14" />Dede Ih ncu nlum, RAMPAUBO;</para>
  <para style="q" vid="PSA 31:14">Ih rangla, “Nang a Tinggwang.”<verse eid="PSA 31:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 31:15" />A tingdung au n ba ga bam.</para>
  <para style="q" vid="PSA 31:15">A ngauraume nah acu gwa zui kelame ba gade acu kelibeu lo.<verse eid="PSA 31:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 31:16" />N kilabe reu gage n zu le tau baa beulo;</para>
  <para style="q" vid="PSA 31:16">n samkakkelu samsang le acu kelibeu lo.<verse eid="PSA 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 31:17" />Acu peu hengam tei di helo, RAMPAUBO; kedanemene Ih n dage qugai lalu!</para>
  <para style="q" vid="PSA 31:17">Peu kesiame de hengam tei dilu! Peu penuide Sheol gade zingde bam dilu.<verse eid="PSA 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 31:18" />Kenret kela mleudung de peu zingde dilu</para>
  <para style="q" vid="PSA 31:18">kesamsangme de rang renia kelade</para>
  <para style="q" vid="PSA 31:18">ngang eh nah rangmsia kelade.<note caller="+" style="f"><char style="fr" closed="false">31:18 </char><char style="ft" closed="false">Lei. 94:4;120:2</char></note><verse eid="PSA 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 31:19" />N keyi daihiage de dino</para>
  <para style="q" vid="PSA 31:19">ncu rüt kelame ziemne hekwa pwa kebamde,</para>
  <para style="q" vid="PSA 31:19">n da nsiu kelame dage liabeu kelade</para>
  <para style="q" vid="PSA 31:19">mina leune dage!<verse eid="PSA 31:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 31:20" />Nang penui da la eh penuide kebai beula, mina ciemdung gade.</para>
  <para style="q" vid="PSA 31:20">Nang penuide gum teuna beula penui ngauraume penuide rang kemsia gade kensiu ni keyi gage kai beula.<verse eid="PSA 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 31:21" />RAMPAUBE depeu samlam punglu,</para>
  <para style="q" vid="PSA 31:21">kedanemene namdi ga acu a ngauraume twagwa kebam gade pa acu pe keyi kedi samkakkelu samsang de lia kecune.<verse eid="PSA 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 31:22" />Ih mzet delwe,</para>
  <para style="q" vid="PSA 31:22">“N miakngau gade acu gwagi dida,” de eh rangdi liede</para>
  <para style="q" vid="PSA 31:22">nang a nggia kwa siubeu</para>
  <para style="q" vid="PSA 31:22">Ih n dage mra kegai dau.<verse eid="PSA 31:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 31:23" />RAMPAUBE de kulu, samsang kela leune.</para>
  <para style="q" vid="PSA 31:23">Samsang kelame de RAMPAUBE gum beula,</para>
  <para style="q" vid="PSA 31:23">dede ngang kelame de penui ziehi teicang siak beula.<note caller="+" style="f"><char style="fr" closed="false">31:23 </char><char style="ft" closed="false">Lei. 97:10</char></note><verse eid="PSA 31:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 31:24" />Ngkieng lu nah kuu lu,</para>
  <para style="q" vid="PSA 31:24">RAMPAUBE de nlum eh kengha kie kela leune.<note caller="+" style="f"><char style="fr" closed="false">31:24 </char><char style="ft" closed="false">1 Cor. 16:13</char></note><verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="s">Kemau gibeu kedime samlam pungtu lie</para>
  <para style="d">David gu lei ge. Maschil ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 32:1" />Mina penui mau gibeu kedimedung samlam pungtu da,</para>
  <para style="q" vid="PSA 32:1">penui maudung keugi kedimedung.<note caller="+" style="f"><char style="fr" closed="false">32:1 </char><char style="ft" closed="false">Rom. 4:7</char></note><verse eid="PSA 32:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 32:2" />RAMPAUBE pecu maulie mmau kemakme samlam pungtu</para>
  <para style="q" vid="PSA 32:2">nah pe rabe ga mide kecwa bam kemakme.<note caller="+" style="f"><char style="fr" closed="false">32:2 </char><char style="ft" closed="false">Rom. 4:8</char></note><verse eid="PSA 32:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 32:3" />Ih zingde bamdi kecudau<note caller="+" style="f"><char style="fr" closed="false">32:3 </char><char style="fq" closed="false">zingde bamdi kecudau </char><char style="ft" closed="false">Ih a maupet tadi kecudau.</char></note>, a radung tuii bamdi</para>
  <para style="q" vid="PSA 32:3">Ih pe tingnai mra kebam ga.<verse eid="PSA 32:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 32:4" />Tingmui tingba n ba a ziemne rütsütdi.</para>
  <para style="q" vid="PSA 32:4">A kengkieng tinglum dau dui kecangh de nzwa canghdi. <char style="qs">Selah</char><verse eid="PSA 32:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 32:5" />Pecai Ih a mau n dage pet gai,</para>
  <para style="q" vid="PSA 32:5">nah n dage Ih a kemau hebai tadi.</para>
  <para style="q" vid="PSA 32:5">Ih ranggai, “RAMPAUBE dage Ih a kemaudung petgai zie,”</para>
  <para style="q" vid="PSA 32:5">nah nang a mau gibeu.<note caller="+" style="f"><char style="fr" closed="false">32:5 </char><char style="ft" closed="false">1 Jhn. 1:9</char></note><char style="qs">Selah</char><verse eid="PSA 32:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 32:6" />Aipau kie de ziemne n masang caisuime leune keherei tingdau n dage kekie teigailu maisia.</para>
  <para style="q" vid="PSA 32:6">Duinai puinliem kegwang dau, dui cide penui da gwangcang lak.<verse eid="PSA 32:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 32:7" />Nang a kensiu bam; nang a reidung gade acu gum beu zie.</para>
  <para style="q" vid="PSA 32:7">Ngkieng kelu leidung le nang acu twagwa luzie. <char style="qs">Selah</char><verse eid="PSA 32:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 32:8" />Nang mie kera lampui be ga Ih ncu saulia zie nah ledeu beu zie.</para>
  <para style="q" vid="PSA 32:8">N ma pie eh Ih ncu saulia zie.<verse eid="PSA 32:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 32:9" />Hekwen ge mede gada ge nzwa diso, maci kegah nzwa;</para>
  <para style="q" vid="PSA 32:9">cide de pe muikang nah tsingtie le kezeula</para>
  <para style="q" vid="PSA 32:9">peu penuide nang mie keneu ga peu mie kerane.<verse eid="PSA 32:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 32:10" />Kesiame suisiet kekiee ge bamla,</para>
  <para style="q" vid="PSA 32:10">dede RAMPAUBE samkakkelu samsang au pecu nlum kebamme da twagwa bamla.<verse eid="PSA 32:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 32:11" />RAMPAUBE da nnui sui yilu, nah nnui suiyi sütlu, nnui kesamsangme;</para>
  <para style="q" vid="PSA 32:11">suiyi kwa sahlu, nnui nlung kemzuimedung leune.<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="s">RAMPAUBE keku bam mui kelade</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 33:1" />RAMPAUBE da nnui suiyi sütlu, nnui kesamsangme;</para>
  <para style="q" vid="PSA 33:1">ketwa au petau kelame ziemne petau.<verse eid="PSA 33:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 33:2" />Leibung teu eh RAMPAUBE de hetwa peulo;</para>
  <para style="q" vid="PSA 33:2">peria kerei kebam leibung teu eh peda ketwa lei tei gailo.<note caller="+" style="f"><char style="fr" closed="false">33:2 </char><char style="ft" closed="false">Eph. 5:19</char></note><verse eid="PSA 33:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 33:3" />RAMPAUBE da lei keheci ge teigailo;</para>
  <para style="q" vid="PSA 33:3">kwa gapte lulo nah suiyi le lei tei gailo.<note caller="+" style="f"><char style="fr" closed="false">33:3 </char><char style="ft" closed="false">Keu. 14:3</char></note><verse eid="PSA 33:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 33:4" />Kedanemene RAMPAUBE sam au mzui kecune,</para>
  <para style="q" vid="PSA 33:4">nah pa tei kecu leune au masang.<verse eid="PSA 33:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 33:5" />Pa kesamsang nah kemzuibe pe suila.</para>
  <para style="q" vid="PSA 33:5">Kideu au RAMPAUBE samkakkelu samsang le pui.<verse eid="PSA 33:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 33:6" />RAMPAUBE sam le tinggimdung teilu,</para>
  <para style="q" vid="PSA 33:6">nah pe mui cui le hegidung teigai.<note caller="+" style="f"><char style="fr" closed="false">33:6 </char><char style="ft" closed="false">Heb. 11:3</char></note><verse eid="PSA 33:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 33:7" />Pa jaaidi dui pelane heni ket gage hekwa lula;</para>
  <para style="q" vid="PSA 33:7">pa duididung ma kehekwa ki gage kai lula.<verse eid="PSA 33:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 33:8" />Kideu pelane de peu RAMPAUBE de hinglu;</para>
  <para style="q" vid="PSA 33:8">kideu ga lung kebamme pelane pecu peu rütlu.<verse eid="PSA 33:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 33:9" />Kedanemene Tinggwang sam ranggai, nah kideu teilu kedine;</para>
  <para style="q" vid="PSA 33:9">pa aja kaigai, nah cide pebam ga sap kedine.<verse eid="PSA 33:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 33:10" />RAMPAUBE heleuh hekang tei kebamdung de gu lungning tei ngkung dila;</para>
  <para style="q" vid="PSA 33:10">pa mina riem kegaibedung reuga pa kengkieng teula.<verse eid="PSA 33:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 33:11" />RAMPAUBE mariem au kelungta bamla,</para>
  <para style="q" vid="PSA 33:11">pe nlung mariemdung au lunggwang kela leuh leune ziemne bamla.<verse eid="PSA 33:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 33:12" />RAMPAUBE de pe Tinggwang lie kecu heleuhdung de samlam pungtu delie,</para>
  <para style="q" vid="PSA 33:12">pa ne pe gu mapwame tei zie lie eh kedetkelu minadung.<verse eid="PSA 33:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 33:13" />RAMPAUBE tinggim gade piela;</para>
  <para style="q" vid="PSA 33:13">pa mina leune de ngaula.<verse eid="PSA 33:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 33:14" />Pa lung kebam heni gade,</para>
  <para style="q" vid="PSA 33:14">pa kideu ga lung kebamme leune de pie nghung la.<verse eid="PSA 33:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 33:15" />Pa penui lungning pelane teigai kegaibe</para>
  <para style="q" vid="PSA 33:15">penui tadung pelane piela.<verse eid="PSA 33:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 33:16" />Hegwangme migede reugwame kekiee ge ziemne ngking lula ma;</para>
  <para style="q" vid="PSA 33:16">reugwame pe kengkieng kedi ziemne ngking lula ma.<verse eid="PSA 33:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 33:17" />Hekwen au ngkienglu kera kenret regui ge;</para>
  <para style="q" vid="PSA 33:17">pe kengkieng kedi bam liede, pane keli gailak.<verse eid="PSA 33:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 33:18" />Pielo, RAMPAUBE miak au pecu rüt kelame de piela,</para>
  <para style="q" vid="PSA 33:18">pe samkakkelu samsang ga regui kebamme de<verse eid="PSA 33:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 33:19" />ketsai gade penuide ribeu kerane</para>
  <para style="q" vid="PSA 33:19">nah herakum tingdau peu ringbamlu kerane.<verse eid="PSA 33:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 33:20" />RAMPAUBE de anui kwa bamzie;</para>
  <para style="q" vid="PSA 33:20">pa anuide kenghabe nah anui geu.<verse eid="PSA 33:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 33:21" />Anui nlung RAMPAUBE da anui sui yisüt la,</para>
  <para style="q" vid="PSA 33:21">kedanemene anui pe kemci zi de nlum lalu.<verse eid="PSA 33:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 33:22" />Peu n samkakkelu samsang de, RAMPAUBO, peu anui da bamlo</para>
  <para style="q" vid="PSA 33:22">anui keregui n da kebam ziemne.<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="s">Nsipie eh RAMPAUBE au yi kecu cilulo</para>
  <para style="d">David gu lei ge; pa Abimelech dwaga kemie ciem ketei eh Abimelech ne pecu gwa kedi dau.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 34:1" />Ih RAMPAUBE de twa muila zie,</para>
  <para style="q" vid="PSA 34:1">pe ketwa a mui ga lamui zie.<verse eid="PSA 34:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 34:2" />Ih RAMPAUBE de twa zie!</para>
  <para style="q" vid="PSA 34:2">Keherei kelame de peu siulu nah penui sui yisütlu.<verse eid="PSA 34:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 34:3" />Acu ngngwa eh RAMPAUBE de twalo,</para>
  <para style="q" vid="PSA 34:3">anui nzang eh pe zi teucuh lugo.<verse eid="PSA 34:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 34:4" />Ih RAMPAUBE da kie nah pa a sam keli beu,</para>
  <para style="q" vid="PSA 34:4">nah Ih hingkela leune reuga pa acu kengkieng peu.<verse eid="PSA 34:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 34:5" />Pecu pie kebamme au baaha dila,</para>
  <para style="q" vid="PSA 34:5">nah penui zu au hengam teidi lama.<verse eid="PSA 34:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 34:6" />Keherei kela mipei aide RAMPAUBE dage mragai nah pa pe sam siulu</para>
  <para style="q" vid="PSA 34:6">nah pe keherei leune gade pecu kelibeu.<verse eid="PSA 34:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 34:7" />Pecu rüt kelame da RAMPAUBE tinggimgwame twagwa pung bamla</para>
  <para style="q" vid="PSA 34:7">nah penuide makehung gade kelilu la.<verse eid="PSA 34:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 34:8" />RAMPAUBE de kedak peilo delwe pe keyi de ci lulo.</para>
  <para style="q" vid="PSA 34:8">RAMPAUBE da nsiu kelabe de samlam pungtu.<note caller="+" style="f"><char style="fr" closed="false">34:8 </char><char style="ft" closed="false">1 Pet. 2:3</char></note><verse eid="PSA 34:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 34:9" />RAMPAUBE de rütlu, nnui pe kemci minadung.</para>
  <para style="q" vid="PSA 34:9">Pecu rüt kelamedung ziemne made kenrum gah.<verse eid="PSA 34:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 34:10" />Madau ge heri heret hinghodung ketyeipok gah dila nah mzeu lala,</para>
  <para style="q" vid="PSA 34:10">dede RAMPAUBE sam mzai kelame makeyibe magede camdi lak.<verse eid="PSA 34:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 34:11" />Gwanglu, a napeimedung, a kwa kingneilu.</para>
  <para style="q" vid="PSA 34:11">RAMPAUBE de herüt peu kecu Ih nnuide ledeu lia zie.<verse eid="PSA 34:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 34:12" />Cauge teilung luuneu lano</para>
  <para style="q" vid="PSA 34:12">nah tingba kekiee ge pesui lano,</para>
  <para style="q" vid="PSA 34:12">pa ma keyi ngaulu kerane?<verse eid="PSA 34:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 34:13" />Kesiabe gade mleu kezeu lulo</para>
  <para style="q" vid="PSA 34:13">nah kenret kerang gade kezeu lu.<note caller="+" style="f"><char style="fr" closed="false">34:13 </char><char style="ft" closed="false">Jas. 1:26</char></note><verse eid="PSA 34:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 34:14" />Makesia ketei gade nreu dilu nah makeyi teilu.</para>
  <para style="q" vid="PSA 34:14">Lungciep peeilu nah pecai zuilu.<note caller="+" style="f"><char style="fr" closed="false">34:14 </char><char style="ft" closed="false">Heb. 12:14</char></note><verse eid="PSA 34:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 34:15" />RAMPAUBE miak au kesamsangme reuga bamla</para>
  <para style="q" vid="PSA 34:15">nah pe kwen au nra kegai lam bamla.<note caller="+" style="f"><char style="fr" closed="false">34:15 </char><char style="ft" closed="false">Jhn. 9:31</char></note><verse eid="PSA 34:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 34:16" />RAMPAUBE makesia keteime de ngkau la,</para>
  <para style="q" vid="PSA 34:16">kideube gade peu penuide nsungta di kerane.<note caller="+" style="f"><char style="fr" closed="false">34:16 </char><char style="ft" closed="false">1 Pet. 3:10-12</char></note><verse eid="PSA 34:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 34:17" />Kesamsangme penui nggia kiela nah RAMPAUBE siu lula</para>
  <para style="q" vid="PSA 34:17">nah penui reidung leune gade kelibeu la.<verse eid="PSA 34:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 34:18" />RAMPAUBE au mi pe sui sia kelame taiga lala,</para>
  <para style="q" vid="PSA 34:18">nah pa mina penui keregui gah kedime pelane de keli lula.<verse eid="PSA 34:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 34:19" />Kesamsangme da keherei kekiee bamla,</para>
  <para style="q" vid="PSA 34:19">dede RAMPAUBE cidungde leune gade penuide keli beula.<note caller="+" style="f"><char style="fr" closed="false">34:19 </char><char style="ft" closed="false">Mac. 24:16, 1 Tim. 3:11</char></note><verse eid="PSA 34:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 34:20" />Pa penui radung kainzeu pwa bamla,</para>
  <para style="q" vid="PSA 34:20">ketde peu cumdi lama.<note caller="+" style="f"><char style="fr" closed="false">34:20 </char><char style="ft" closed="false">Jhn. 19:36</char></note><verse eid="PSA 34:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 34:21" />Kesiame kemaume de daptset zie.</para>
  <para style="q" vid="PSA 34:21">Kesamsangme de ngkau kelame de saja peuzie.<verse eid="PSA 34:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 34:22" />RAMPAUBE pe kilamedung de kelibeu la.</para>
  <para style="q" vid="PSA 34:22">Peda nsiu kera kegwangme leune migede mmau dilak.<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="s">RAMPAUBE au Dizu</para>
  <para style="d">David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 35:1" />RAMPAUBO, acu ngkau kelame de ngkaulo;</para>
  <para style="q" vid="PSA 35:1">acu regi kelame de regi lo.<verse eid="PSA 35:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 35:2" />N geu keceuna de nah n geu kedi de keu lulo;</para>
  <para style="q" vid="PSA 35:2">cuhlu nah acu ngha lo.<verse eid="PSA 35:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 35:3" />Acu gwa zui kelame de n ngei nah n hereu mrew pwa hwalu;</para>
  <para style="q" vid="PSA 35:3">a dage, “Ih n kelikelube da,” de eh ranglo.<verse eid="PSA 35:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 35:4" />A keringria peei kelame de peu ngngam nah hezi kesia pung dilu.</para>
  <para style="q" vid="PSA 35:4">Acu rezam zie lie riem kelame de peu caili dilu nah kebwak dilu.<verse eid="PSA 35:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 35:5" />Penuide peu tsiurie tingkai ne guiteu kelabe nzwa dilu,</para>
  <para style="q" vid="PSA 35:5">RAMPAUBE tinggimgwame penuide zui kegaidau.<verse eid="PSA 35:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 35:6" />Penui lampui de peu mui nah reneu dilu,</para>
  <para style="q" vid="PSA 35:6">RAMPAUBE tinggimgwame penuide zui kegaidau.<verse eid="PSA 35:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 35:7" />Pekie kegah gade penui a ziemne baih ge mtei pwabam;</para>
  <para style="q" vid="PSA 35:7">pekie kegah gade penui a ziemne makoiki ge kui pwabam.<verse eid="PSA 35:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 35:8" />Penui cimezing eh kebamdau kensum kengkap penuida peu gwang dilu.</para>
  <para style="q" vid="PSA 35:8">Penui mtei pwa kebam baih gage penuide keu dilu.</para>
  <para style="q" vid="PSA 35:8">Cikage peu penuide cakmie dilu, penui kengkap gage.<verse eid="PSA 35:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 35:9" />Dede Ih au RAMPAUBE da a suila zie</para>
  <para style="q" vid="PSA 35:9">nah acu rikebeu ne Ih a sui yila zie.<verse eid="PSA 35:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 35:10" />A kengkieng pelane teu rangzie, “RAMPAUBO, nang kenzwa cau bamno,</para>
  <para style="q" vid="PSA 35:10">keherei kelame de penui swa ngkieng kecume dade keli beu kelabe</para>
  <para style="q" vid="PSA 35:10">nah keregame dade ma kegahme nah keherei kelame de kelibeu kelabe?”<verse eid="PSA 35:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 35:11" />Samsang kemak zierangdung cuhbam dida;</para>
  <para style="q" vid="PSA 35:11">kenretpe le penui acu mmau.<verse eid="PSA 35:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 35:12" />Penui acu makeyi ge ziemne makesia ge peula.</para>
  <para style="q" vid="PSA 35:12">Ih a suisiet le puibam.<verse eid="PSA 35:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 35:13" />Dede, penui nra kebamdau, Ih rosopai bah;<note caller="+" style="f"><char style="fr" closed="false">35:13 </char><char style="fq" closed="false">Rosopai bah: </char><char style="ft" closed="false">rosopai bah nah mmwang kecu au pekie milung suisia bam kecu.</char></note></para>
  <para style="q" vid="PSA 35:13">I penui ziemne a peu keukeimie a kakrak gage kailwe</para>
  <para style="q" vid="PSA 35:13">mmwang la.<note caller="+" style="f"><char style="fr" closed="false">35:13 </char><char style="ft" closed="false">Job 30:25, Rom. 12:15</char></note><verse eid="PSA 35:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 35:14" />A sinabe ziemne au Ih a lung siala;</para>
  <para style="q" vid="PSA 35:14">Ih a pui ziemne au a sui sia eh keumie la<verse eid="PSA 35:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 35:15" />Dede Ih kaumie kecudau, ngauraume penui sui yisüt la nah gwang ngkwa lula;</para>
  <para style="q" vid="PSA 35:15">penui gwang ngkwa eh acu mmau la, nah Ih penuide a swagahdi.</para>
  <para style="q" vid="PSA 35:15">Penui acu mtak mene teurak la.<verse eid="PSA 35:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 35:16" />Acu rüt mezing eh penui acu keu henui teidi;</para>
  <para style="q" vid="PSA 35:16">penui rata le acu penui geigim lia.<note caller="+" style="f"><char style="fr" closed="false">35:16 </char><char style="ft" closed="false">Lei. 37:12</char></note><verse eid="PSA 35:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 35:17" />Rampaubo, dai tiege nang piebam laino?</para>
  <para style="q" vid="PSA 35:17">Penui gu tei kengkap tadung gade a rabe keli beulo,</para>
  <para style="q" vid="PSA 35:17">a teilung hinghodung kenzwame dade.<verse eid="PSA 35:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 35:18" />Iciulude Ih ncu hemaa maadi gade ncu twa zie;</para>
  <para style="q" vid="PSA 35:18">Ih ncu minadung kekiee kakgade ncu twa zie.<verse eid="PSA 35:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 35:19" />Mide cwa kelame a ngauraumedung de peu a reuga penui suiyi diso;</para>
  <para style="q" vid="PSA 35:19">penui mariem kesiadung depeu teidi helo.<note caller="+" style="f"><char style="fr" closed="false">35:19 </char><char style="ft" closed="false">Jhn. 15:25, Lei. 69:4</char></note><verse eid="PSA 35:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 35:20" />Kedanemene penui lungciep teu eh marang la kemakne,</para>
  <para style="q" vid="PSA 35:20">dede anui deu ga ziune lung kebamme de kecwa sam teu eh mmau kera teila la.<verse eid="PSA 35:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 35:21" />Penui penui mui ngkei nzalwe acu mmau la;</para>
  <para style="q" vid="PSA 35:21">penui rangla, “Aha, Aha, anui miak le ngauda.”<verse eid="PSA 35:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 35:22" />Nang ngau da, RAMPAUBO, zingde di helo;</para>
  <para style="q" vid="PSA 35:22">RAMPAUBO, a dade mdei di helo.<verse eid="PSA 35:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 35:23" />Nkatei ncu teucuh lulo nah acu gum kera nraklu;</para>
  <para style="q" vid="PSA 35:23">A Tinggwang nah a Rampaubo, a zie rang beulo.<verse eid="PSA 35:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 35:24" />Acu gum beulo, RAMPAUBE a Tinggwang, n kesamsang ziemne;</para>
  <para style="q" vid="PSA 35:24">peu penuide a reuga penui suiyi diso.<verse eid="PSA 35:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 35:25" />Peu penuide penui nlung gade, “Aha, anui luu keneube luu luda,” de eh peu rang diso.</para>
  <para style="q" vid="PSA 35:25">Peu penuide, “Anui pecu ngkap dida,” de eh peu rang diso.<verse eid="PSA 35:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 35:26" />A reidung ga penui sui kelame depeu hengam tei dilu nah peu kebwak dilu.</para>
  <para style="q" vid="PSA 35:26">Aswa yilie kelame depeu hengam nah hezi kesia le cum dilu.<verse eid="PSA 35:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 35:27" />Acu petau liede neu kelamedung de peu suiyi kwa sahlu nah peu penui sui yilu;</para>
  <para style="q" vid="PSA 35:27">peu penuide rangla muilu, “Twalu RAMPAUBE de,</para>
  <para style="q" vid="PSA 35:27">pa pe kilabe teilung keyi lungh kegai ga pe suiyi lala.”<verse eid="PSA 35:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 35:28" />Pecai Ih n masangbe rangzie</para>
  <para style="q" vid="PSA 35:28">nah Ih tingba pelane Ih ncu twazie.<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="s">N keku bam mui kelabe daiyiyino</para>
  <para style="d">Lei kempwakme muiteube ziemne. RAMPAUBE kilabe David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 36:1" />Mina kesiame ge pe mlung kecok gade pe kesiadung rang bamla,</para>
  <para style="q" vid="PSA 36:1">pe miakngau ga Tinggwang de kerüt kette gah.<note caller="+" style="f"><char style="fr" closed="false">36:1 </char><char style="ft" closed="false">Rom. 3:18</char></note><verse eid="PSA 36:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 36:2" />Kedanemene pa pekatei pecu hemak bam kelane,</para>
  <para style="q" vid="PSA 36:2">pa cet kela pe maudungde ci gai lak nah ngkau dilak lie lala.<verse eid="PSA 36:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 36:3" />Pe samdung au kemau le pui nah kenret rünne;</para>
  <para style="q" vid="PSA 36:3">pa au makecime neu mah nah makeyi teineu ma.<verse eid="PSA 36:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 36:4" />Pa pe zeu ga kebamdau, pa kemau tei kera riem bamla;</para>
  <para style="q" vid="PSA 36:4">pa kesia ta tei kera mtei la;</para>
  <para style="q" vid="PSA 36:4">pa makesiabe kette gidi lama.<verse eid="PSA 36:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 36:5" />N samkak kelu samsang, RAMPAUBO, tinggimdung ga hangcang bam;</para>
  <para style="q" vid="PSA 36:5">n samsang au hemwadung ga hangcang bam.<verse eid="PSA 36:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 36:6" />N masang au Tinggwang gu lamlwadung nzwada;</para>
  <para style="q" vid="PSA 36:6">nang ne tiak kegaidung au ma coksüt kecu nzwa.</para>
  <para style="q" vid="PSA 36:6">RAMPAUBO, nang minadunge de nah makaunedung de kaipwa bam lula.<verse eid="PSA 36:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 36:7" />N samkakkelu samsang daikenzwa gede pemi whung no, Tinggwang!</para>
  <para style="q" vid="PSA 36:7">Minadung n hesiu mie kangga msiu lula.<verse eid="PSA 36:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 36:8" />N kerecaki ga pui nliem kebam gade penui hengyi bam;</para>
  <para style="q" vid="PSA 36:8">nang penuide n suikeyi reuki gade peu sakla.<verse eid="PSA 36:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 36:9" />Kedanemene n da teilung bangbe kebamne;</para>
  <para style="q" vid="PSA 36:9">n keba gade anui keba ngau zie.<note caller="+" style="f"><char style="fr" closed="false">36:9 </char><char style="ft" closed="false">Jhn. 4:10, Keu. 21:6</char></note><verse eid="PSA 36:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 36:10" />N samkakkelu samsang de ncu ci kelame de peulo,</para>
  <para style="q" vid="PSA 36:10">pe nlung mzui kelame de gum beulo.<verse eid="PSA 36:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 36:11" />Peu ngang kelame de a da gwang nna so</para>
  <para style="q" vid="PSA 36:11">Kemaume de peu acu gwagi diso.<verse eid="PSA 36:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 36:12" />Cika kemaume kauzeu dida;</para>
  <para style="q" vid="PSA 36:12">penuide dap ngkau dida nah penui au cuh gailak eh bam dida.<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="s">Pa pegu kemci de püt dilak</para>
  <para style="d">David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 37:1" />Kesiame ziemne ncu keradi helo;</para>
  <para style="q" vid="PSA 37:1">kemau bata tei kelame de hengim so.<verse eid="PSA 37:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 37:2" />Kedanemene penui au kidi kela nzwa eh zette kidi zie</para>
  <para style="q" vid="PSA 37:2">nah cehei kendiak bangdung nzwa regui dizie.<verse eid="PSA 37:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 37:3" />RAMPAUBE de nlumlu nah makeyi teilu;</para>
  <para style="q" vid="PSA 37:3">kideube <note caller="+" style="f"><char style="fr" closed="false">37:3 </char><char style="fq" closed="false">Kideube: </char><char style="ft" closed="false">Sampet kebeu Canaan deude ga Tinggwang name kwak eh lungh kera. </char></note>ga lungh lu nah samsang eh kwaklu.<verse eid="PSA 37:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 37:4" />RAMPAUBE gade nnui sui yilu,</para>
  <para style="q" vid="PSA 37:4">iciulude pa nnui nlung luneudung nnuide peuzie.<note caller="+" style="f"><char style="fr" closed="false">37:4 </char><char style="ft" closed="false">Mat. 6:33</char></note><verse eid="PSA 37:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 37:5" />N teilung Tinggwang de peulu;</para>
  <para style="q" vid="PSA 37:5">pecu nlumlu, iciulude pa n mding tei eh heta tei beuzie.<verse eid="PSA 37:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 37:6" />Pa n masang de tei mbaa pwa ting kebaa de nzwa tei beuzie</para>
  <para style="q" vid="PSA 37:6">nah n kemzui zai de tingna tingba nzwa tei beuzie.<verse eid="PSA 37:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 37:7" />RAMPAUBE dwa ga ziune bamlu nah nnui lung tie eh pecu kwalu.</para>
  <para style="q" vid="PSA 37:7">Mikangge penui ta ketei ga teidau kegaidau nnui rata di helo,</para>
  <para style="q" vid="PSA 37:7">mede pa makemaudung riem kegaidau.<verse eid="PSA 37:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 37:8" />Nnui rata so nah liagai kelak teiso.</para>
  <para style="q" vid="PSA 37:8">Nnui lung keherei so. Aide au keherei rünne peula.<verse eid="PSA 37:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 37:9" />Kemau ta tei kelame de gwagi dizie,</para>
  <para style="q" vid="PSA 37:9">dede RAMPAUBE de kwa kebamme kideube gum luzie.<verse eid="PSA 37:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 37:10" />Peting tie mene kesiame pei de gah kedidau;</para>
  <para style="q" vid="PSA 37:10">nang pe bam ga pie zie, dede pa bamlak.<verse eid="PSA 37:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 37:11" />Dede kenciepme kideube gum luzie</para>
  <para style="q" vid="PSA 37:11">nah teilung keyi kelung ga penui sui yilu zie.<note caller="+" style="f"><char style="fr" closed="false">37:11 </char><char style="ft" closed="false">Mat. 5:5 </char></note><verse eid="PSA 37:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 37:12" />Kemaube pei kesamsangme de tei keherei kera riem bamla</para>
  <para style="q" vid="PSA 37:12">nah pa pecu pe rata eh geigim bamla.<verse eid="PSA 37:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 37:13" />Rampaube pecu nui bamla,</para>
  <para style="q" vid="PSA 37:13">kedanemene pa pe tutiak tingba gwangkelade ngau kebamne.<verse eid="PSA 37:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 37:14" />Kesiame penui gu kingtiedung keumpet luda nah penui lakpi ga luda</para>
  <para style="q" vid="PSA 37:14">keherei kelame de nah kegahme de ngkap di kerane,</para>
  <para style="q" vid="PSA 37:14">keyi tei kelame de daptset dizie.<verse eid="PSA 37:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 37:15" />Penui kingtiedung le penui katei penui nlung kui zie,</para>
  <para style="q" vid="PSA 37:15">nah penui lakpidung cum dizie.<verse eid="PSA 37:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 37:16" />Makesangme ma kecamnage kebambe au</para>
  <para style="q" vid="PSA 37:16">kesiame mahei pelane swa yiki.<verse eid="PSA 37:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 37:17" />Kedanemene kesiame badung au cum dizie,</para>
  <para style="q" vid="PSA 37:17">dede kesamsangme de RAMPAUBE ngha la.<verse eid="PSA 37:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 37:18" />Tingnaige cai tingnaige RAMPAUBE mau kemakme mapie bamla,</para>
  <para style="q" vid="PSA 37:18">nah penui mapwa kelungta bamzie.<verse eid="PSA 37:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 37:19" />Penui peting kesiadau ngngam dilak.</para>
  <para style="q" vid="PSA 37:19">Herakum gwang liede, penui tyei maisia kieege bam zie.<verse eid="PSA 37:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 37:20" />Dede kemaume kapdi zie.</para>
  <para style="q" vid="PSA 37:20">RAMPAUBE ngauraume cehei kemdu nzwa zie;</para>
  <para style="q" vid="PSA 37:20">penuide ngkap dizie nah mika nzwa gah dizie.<verse eid="PSA 37:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 37:21" />Kesiame ma hepokla dede peudai lama,</para>
  <para style="q" vid="PSA 37:21">dede kesamsangme au pe zaiyi nah ma peula.<verse eid="PSA 37:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 37:22" />Tinggwang ne samlam kebeume kideube gum luzie;</para>
  <para style="q" vid="PSA 37:22">pane reset beu kedime de au gwagi dizie.<verse eid="PSA 37:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 37:23" />RAMPAUBE pe samzai tei kelame lampui sau beula,</para>
  <para style="q" vid="PSA 37:23">Tinggwang penui teilung pelane ga pesui la.<verse eid="PSA 37:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 37:24" />Pa pe pi ma nrapgai liede, pa kaudilak,</para>
  <para style="q" vid="PSA 37:24">kedanemene RAMPAUBE pa pe ba le pecu tuipwa kebamne.<verse eid="PSA 37:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 37:25" />Ih piage hena bam nah cu au hecing dida;</para>
  <para style="q" vid="PSA 37:25">Kesamsangme de gi kedi madauge de Ih ngau ma,</para>
  <para style="q" vid="PSA 37:25">mede pe namedung maha tyei la eh.<verse eid="PSA 37:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 37:26" />Tingba ramsangne pa au pe zai yi nah ma peula,</para>
  <para style="q" vid="PSA 37:26">nah pe namedung au samlam ge dila.<verse eid="PSA 37:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 37:27" />Kemau ketei gade nreudilu nah petaube teilu;</para>
  <para style="q" vid="PSA 37:27">iciu lucai nang kelungta kwak eh bam luzie.<verse eid="PSA 37:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 37:28" />Kedanemene RAMPAUBE keyibe pesui lalu</para>
  <para style="q" vid="PSA 37:28">nah pe dade samsang kelame de gi dila melu.</para>
  <para style="q" vid="PSA 37:28">Penui kelungta kwak bam lula,</para>
  <para style="q" vid="PSA 37:28">dede kesiame namedung de gi dizie.<verse eid="PSA 37:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 37:29" />Kesamsangme kideube de gum luzie</para>
  <para style="q" vid="PSA 37:29">nah cika kelungta lungla dizie.<verse eid="PSA 37:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 37:30" />Kesamsangme mui le macisam rangla</para>
  <para style="q" vid="PSA 37:30">nah kemzuibe tei nkiee lula.<verse eid="PSA 37:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 37:31" />Pa pe Tinggwang sam pe nlung gage kaiteu lala;</para>
  <para style="q" vid="PSA 37:31">pe pi reneu dilak.<verse eid="PSA 37:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 37:32" />Kesiame kesamsangme de pieling eh bamla</para>
  <para style="q" vid="PSA 37:32">nah pecu daptset kera peei bamla.<verse eid="PSA 37:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 37:33" />RAMPAUBE pecu kemaube ba gage kaibeu dilak</para>
  <para style="q" vid="PSA 37:33">mede pe tuketiak dau pecu mmau dilak.<verse eid="PSA 37:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 37:34" />RAMPAUBE de kwalu nah pe sam mzailu,</para>
  <para style="q" vid="PSA 37:34">iciulu de pa ncu teucuh lu eh peu ncu kideube de gum luzie.</para>
  <para style="q" vid="PSA 37:34">Nang kemaume de gwagi kedi ngau zie.<verse eid="PSA 37:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 37:35" />Pe deu ga tsingbang kendiakpe ge nzwa lungh zangra kebam</para>
  <para style="q" vid="PSA 37:35">Ih kesiame nah ngau kehingme de ngau da.<verse eid="PSA 37:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 37:36" />Dede Ih tetkahgwang daige, pa cika bam ma.</para>
  <para style="q" vid="PSA 37:36">Ih pecu peei, dede pecu peeilu tadi.<note caller="+" style="f"><char style="fr" closed="false">37:36 </char><char style="ft" closed="false">Lei. 37:10</char></note><verse eid="PSA 37:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 37:37" />Keyime de mcetlu, nah makesangme de peilu;</para>
  <para style="q" vid="PSA 37:37">helung kenciepme pei ge ziemne gwangdai kezeu teilung keyi ge bam.<note caller="+" style="f"><char style="fr" closed="false">37:37 </char><char style="ft" closed="false">Isa. 32:17</char></note><verse eid="PSA 37:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 37:38" />Kemaume de ngkap ciak dizie;</para>
  <para style="q" vid="PSA 37:38">kemaume caineu gwang kera ngkap dida.<verse eid="PSA 37:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 37:39" />Kesamsangme da kelikelu au RAMPAUBE dade gwangla;</para>
  <para style="q" vid="PSA 37:39">keherei kecudau penuide pa gum beula.<verse eid="PSA 37:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 37:40" />RAMPAUBE penuide ngha la nah kelilu la.</para>
  <para style="q" vid="PSA 37:40">Pa penuide kemaume dade keli beula nah gum beula</para>
  <para style="q" vid="PSA 37:40">kedanemene penui pe dage nsiu kebamne.<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="s">Acu püt diso, O RAMPAUBO</para>
  <para style="d">David gu lei ge, nsunglu kerane.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 38:1" />RAMPAUBO, n rata teu acu herata helo;</para>
  <para style="q" vid="PSA 38:1">n lunghop gade acu saja peu so.<verse eid="PSA 38:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 38:2" />Kedanemene n lakpitsidung acu kuibam,</para>
  <para style="q" vid="PSA 38:2">nah n bale acu niagim pwabam.<verse eid="PSA 38:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 38:3" />N rata ziemne a pum nra bam;</para>
  <para style="q" vid="PSA 38:3">a mau ziemne a radung ngkieng meda.<verse eid="PSA 38:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 38:4" />Kedanemene a kemaudung ne acu puipung bam kedine;</para>
  <para style="q" vid="PSA 38:4">aidungde a ziemne hepüt rütsüt kecuge.<verse eid="PSA 38:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 38:5" />A rezamdung sia reureu dida nah nnam dida</para>
  <para style="q" vid="PSA 38:5">a kemie maudung ziemne.<verse eid="PSA 38:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 38:6" />Ih keu taksu dida nah acu tingnai ramsangne acu tei hengam tei;</para>
  <para style="q" vid="PSA 38:6">Ih tingba pelane hapbam dida.<verse eid="PSA 38:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 38:7" />Kedanemene a lungga, keru le puibam di kecune;</para>
  <para style="q" vid="PSA 38:7">a teih ga kengkieng gahda.<verse eid="PSA 38:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 38:8" />Ih au mnei dida nah pang takcai dida;</para>
  <para style="q" vid="PSA 38:8">Ih a nlung ga a lungrei kebam de ziemne Ih mra bam.<verse eid="PSA 38:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 38:9" />Rampaubo, nang Ih luuneutu bedung cibam,</para>
  <para style="q" vid="PSA 38:9">nah a mra kwadung n dade hebai pwabam ma.<verse eid="PSA 38:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 38:10" />A nlung mbeu bam, a kengkieng cam reureu zeu,</para>
  <para style="q" vid="PSA 38:10">nah a miak de pe kebaa cam reureu dida.<verse eid="PSA 38:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 38:11" />A zangmedung nah a kangngwame de Ih ainzwa kedi ziemne acu gidi da;</para>
  <para style="q" vid="PSA 38:11">a kidacainame de a dade sap mdei bam.<note caller="+" style="f"><char style="fr" closed="false">38:11 </char><char style="ft" closed="false">Lei. 31:11, Luk. 23:49</char></note><verse eid="PSA 38:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 38:12" />Acu teitsetdi neu kelame a ziemne baih mtei gai.</para>
  <para style="q" vid="PSA 38:12">Acu rezam zielie kelame kengkap samdung teu eh marang</para>
  <para style="q" vid="PSA 38:12">nah mide kecwa samdung petingnai rang bamla.<verse eid="PSA 38:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 38:13" />Dede, Ih au kwenpangme ge nzwa eh magede siu mah;</para>
  <para style="q" vid="PSA 38:13">Ih au pelet kegahme maranglu la kemakme nzwada.<verse eid="PSA 38:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 38:14" />Ih au ma siula kemakme ge nzwada</para>
  <para style="q" vid="PSA 38:14">nah sam keli lula kemakme nzwada.<verse eid="PSA 38:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 38:15" />RAMPAUBO, Ih ncu kwabam kesang;</para>
  <para style="q" vid="PSA 38:15">nang a sam keli zie, Rampaubo a Tinggwang.<verse eid="PSA 38:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 38:16" />A ngauraume acu nuineu di kelak ziemne Ih aide rangbam.</para>
  <para style="q" vid="PSA 38:16">Magagede Ih a pi reneu gai liecai, ngauraume a dage ngau kehing tadung tei zielu.<verse eid="PSA 38:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 38:17" />Kedanemene Ih kaudi lai eh bam kedine,</para>
  <para style="q" vid="PSA 38:17">nah Ih teei bammui bam.<verse eid="PSA 38:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 38:18" />Ih Tinggwang dage a mau pet gaila;</para>
  <para style="q" vid="PSA 38:18">Ih a mau ziemne a lungpang bam.<verse eid="PSA 38:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 38:19" />Dede a ngauraume au kieesüt bam;</para>
  <para style="q" vid="PSA 38:19">acu ngaurau buikemak gade ngaurau kebamme kieesüt bam.<verse eid="PSA 38:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 38:20" />Penui acu makeyi ge ziemne makesia peula;</para>
  <para style="q" vid="PSA 38:20">Ih makeyibe zuila lie de penui acu mmau bam muila.<verse eid="PSA 38:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 38:21" />Acu gidi helo, RAMPAUBO;</para>
  <para style="q" vid="PSA 38:21">a Tinggwang, a dade mdei eh la di helo.<verse eid="PSA 38:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 38:22" />Acu ngha ra gwang zette lulo,</para>
  <para style="q" vid="PSA 38:22">Rampaube, acu rikelube.<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="s">A tingbazie dai kie ge no?</para>
  <para style="d">Lei kempwakme muiteube ziemne, Jeduthun ziemne. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 39:1" />Ih tiak ludi, “Ih makerang de pie teune zie</para>
  <para style="q" vid="PSA 39:1">iciu eh Ih a mleu le kemau teidi kelakne.</para>
  <para style="q" vid="PSA 39:1">Ih a mui kang dizie</para>
  <para style="q" vid="PSA 39:1">kemaube pei dwaga kebamdau.”<note caller="+" style="f"><char style="fr" closed="false">39:1 </char><char style="ft" closed="false">Jas. 1:26</char></note><verse eid="PSA 39:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 39:2" />Ih zingde bam di; Ih makeyi ge de rang lak,</para>
  <para style="q" vid="PSA 39:2">nah Ih teei kela de teei mtei di.<verse eid="PSA 39:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 39:3" />A nlung lumdi;</para>
  <para style="q" vid="PSA 39:3">Ih ma aidungde cetncok kegaidau, a nlung mi nzwa heudi.</para>
  <para style="q" vid="PSA 39:3">Ge Ih marang cuhdi.<verse eid="PSA 39:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 39:4" />“RAMPAUBO, a teilungh cangdi keradau peu acu ci gailo.</para>
  <para style="q" vid="PSA 39:4">Nah a tingbadung daitie ge zie bi.</para>
  <para style="q" vid="PSA 39:4">Ih dai mzetzet eh gahdi ziebi acu keulia lo.<verse eid="PSA 39:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 39:5" />Pielo, nang a teilung a badeu lang nage gwale teibeu ma,</para>
  <para style="q" vid="PSA 39:5">nah a teilung pelane n dwa gade au magede ma.</para>
  <para style="q" vid="PSA 39:5">Mina keheibe de ngngi cui ge gwale ma kesang. <char style="qs">Selah</char><verse eid="PSA 39:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 39:6" />Mina keheibe de tingkaumie ge nzwa tetkela kesang.</para>
  <para style="q" vid="PSA 39:6">Mileune de</para>
  <para style="q" vid="PSA 39:6">mahei peei kera gage zette gai dila iciuliede aide caune ngau ziebi cila ma.<verse eid="PSA 39:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 39:7" />Cu, Rampaubo, Ih dai ziemne kwa bambi?</para>
  <para style="q" vid="PSA 39:7">Ncu rünne Ih a keregui bam.<verse eid="PSA 39:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 39:8" />A maudung gade acu kelibeu lo;</para>
  <para style="q" vid="PSA 39:8">acu le pwa kemieme nuineu tei diso.<verse eid="PSA 39:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 39:9" />Ih zingde bam dida nah Ih a mui nkei gailak dida,</para>
  <para style="q" vid="PSA 39:9">kedanemene nang ne aide tei kegaine.<verse eid="PSA 39:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 39:10" />Acu tei rezam sita lulo;</para>
  <para style="q" vid="PSA 39:10">N ba ne acu kepeu kegaide ne acu puipung bam dida.<verse eid="PSA 39:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 39:11" />Nang mina de penui mau ziemne ledeu kegaidau,</para>
  <para style="q" vid="PSA 39:11">penui luu keneudung de taklei nzwa tyei ngkapdi;</para>
  <para style="q" vid="PSA 39:11">mina leune de tingkai cui nage swa sima kesang. <char style="qs">Selah</char><verse eid="PSA 39:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 39:12" />A kengha kekie kingneilo, RAMPAUBO, nah a kwa siulo;</para>
  <para style="q" vid="PSA 39:12">A kehap kwa de siu gailo!</para>
  <para style="q" vid="PSA 39:12">A dage n kwenpang di helo,</para>
  <para style="q" vid="PSA 39:12">kedanemene Ih n da sangme de nzwa la kecune, a paumedung pelane nzwa Ih n giabe ge kecune.<note caller="+" style="f"><char style="fr" closed="false">39:12 </char><char style="ft" closed="false">Keu. 5:9;14:3, Lei. 52:6</char></note><verse eid="PSA 39:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 39:13" />Acu pie ta dilu iciu eh Ih a sui yi dailu kerane</para>
  <para style="q" vid="PSA 39:13">Ih tsaidi kemakne.”<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="s">Acu kenghabe nah kelikelube</para>
  <para style="d">Lei kempwakme muiteube ziemne. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 40:1" />Ih a lung tie eh RAMPAUBE de kwa;</para>
  <para style="q" vid="PSA 40:1">pa a kwa siulu nah a kehap de kingneilu.<verse eid="PSA 40:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 40:2" />Pa hekwa kecok kengngi gade acu teu mpetlu, nyiasai gade acu teumpet lu,</para>
  <para style="q" vid="PSA 40:2">nah pa a pi tsura gage kaibeu nah a pidau de peu kwaklu.<verse eid="PSA 40:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 40:3" />RAMPAUBE a mui gage lei keheci ge kaibeu, anui Tinggwang de twa.</para>
  <para style="q" vid="PSA 40:3">Mi kekiee ge cide ngau zie nah pecu herüt peulu</para>
  <para style="q" vid="PSA 40:3">nah RAMPAUBE de nlum luzie.<verse eid="PSA 40:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 40:4" />RAMPAUBE de nlum kelame samlam pungtu</para>
  <para style="q" vid="PSA 40:4">nah ngang kelame de mede pe dade nreutetdi eh kenretbedung da nreu gai kedime de rütla kemakme.<verse eid="PSA 40:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 40:5" />RAMPAUBE a Tinggwang, miswakegah n batadung nang teikegaidung de au kekiee ge,</para>
  <para style="q" vid="PSA 40:5">nah anui ziemne n lungcetdung de au pei canggai lak;</para>
  <para style="q" vid="PSA 40:5">Ih rang ndu gai nah cidungde ranggai liecai,</para>
  <para style="q" vid="PSA 40:5">cidungde au peilu kebui swade kiee zie.<verse eid="PSA 40:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 40:6" />Nang au ratak mede reca tei kegai luuneu mah,</para>
  <para style="q" vid="PSA 40:6">dede nang a kwendung ngkei beu;</para>
  <para style="q" vid="PSA 40:6">nang keru ratakdung mede kemau recadung nsui lamah.<verse eid="PSA 40:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 40:7" />Ge Ih ranggai, “Pielo, Ih gwang bam da;</para>
  <para style="q" vid="PSA 40:7">kerau laisiudum gage a ha rau pwabam.<verse eid="PSA 40:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 40:8" />Ih n lungning ketei ga a suiyi bam, a Tinggwang;</para>
  <para style="q" vid="PSA 40:8">a nlung ga n zaidung kai pwabam.”<note caller="+" style="f"><char style="fr" closed="false">40:8 </char><char style="ft" closed="false">Heb. 10:5-7</char></note><verse eid="PSA 40:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 40:9" />Ih mina maadi ga n kesamsang samlia keyide rang ndu liagai dida;</para>
  <para style="q" vid="PSA 40:9">RAMPAUBO, Ih aide tei kecu ga a mleu mtak di kemak nang cibam.<verse eid="PSA 40:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 40:10" />N kesamsang de Ih a lung gage hebai dimah;</para>
  <para style="q" vid="PSA 40:10">Ih n samsang nah nang ri kebeu de Ih rang mduilia gai da;</para>
  <para style="q" vid="PSA 40:10">N mina maadi dade Ih n samkakkelu samsang de mede ncu nlumlukebui de kebai dima.<note caller="+" style="f"><char style="fr" closed="false">40:10 </char><char style="ft" closed="false">Mina maadi (verse 9b, 10d) ga kebam au Isrealmena kerecaki ga gwang ngkwa kelude de rangbam (cf. 22:25;35:18).</char></note><verse eid="PSA 40:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 40:11" />N ngaugia tadung de a da gwang cangta kedi tei diso, RAMPAUBO;</para>
  <para style="q" vid="PSA 40:11">n samkakkelu samsang nah ncu nlumlukebui dene peu acu gum kwaklu.<verse eid="PSA 40:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 40:12" />Pei kapgai kelak kehereidung de ne acu twagwa pungbam;</para>
  <para style="q" vid="PSA 40:12">a kesiadung ne acu gumlu iciu eh Ih ma ngau sita dida;</para>
  <para style="q" vid="PSA 40:12">cidungde a peu ga a tamleidung swade kiee,</para>
  <para style="q" vid="PSA 40:12">nah a lung kekuu gah da.<verse eid="PSA 40:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 40:13" />N sui yilu, RAMPAUBO, acu kelilu kerane;</para>
  <para style="q" vid="PSA 40:13">mzet gwang acu ngha lo, RAMPAUBO.<verse eid="PSA 40:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 40:14" />Acu zui eh acu teitset zie lie he kelame de</para>
  <para style="q" vid="PSA 40:14">peu hengam ngaulu nah ngngai dilu.</para>
  <para style="q" vid="PSA 40:14">Acu tei rezam kegai ga penui sui kelame de,</para>
  <para style="q" vid="PSA 40:14">peu nreucaili dilu nah peu ngngam dilu.<verse eid="PSA 40:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 40:15" />Penui de penui hengam de ziemne peu penui swagah dilu,</para>
  <para style="q" vid="PSA 40:15">a dage, “Aha, aha!” De kelame de.<verse eid="PSA 40:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 40:16" />Dede ncu peei kelame depeu penui sui yilu nah n dage penui sui yisütlu;</para>
  <para style="q" vid="PSA 40:16">peu n kelikelu de ku kelame leude,</para>
  <para style="q" vid="PSA 40:16">“RAMPAUBE de twalu,” de rangmui lu.<verse eid="PSA 40:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 40:17" />Ih au kegahme nah ma gah;</para>
  <para style="q" vid="PSA 40:17">iciude Rampaube acu nsungla.</para>
  <para style="q" vid="PSA 40:17">Nang a kenghabe nah acu kelibeu kera gwang;</para>
  <para style="q" vid="PSA 40:17">acu nghabeu kera ridi helo, a Tinggwang.<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="s">O RAMPAUBO, acu ngaungialo</para>
  <para style="d">Lei kempwakme muiteube ziemne. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 41:1" />Kemneime ma pie kelamedung ne samlam pungtu;</para>
  <para style="q" vid="PSA 41:1">keherei kecu benai, RAMPAUBE pecu kelibeu zielu.<verse eid="PSA 41:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 41:2" />RAMPAUBE pecu gum beuzie nah pecu peu lunghbam luzie,</para>
  <para style="q" vid="PSA 41:2">nah pecu kideube gade samlam beuzie;</para>
  <para style="q" vid="PSA 41:2">RAMPAUBE pecu pe ngauraume kengkieng gage kai dilak.<verse eid="PSA 41:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 41:3" />Pe mateei zeulie gade pecu RAMPAUBE ngha beuzie;</para>
  <para style="q" vid="PSA 41:3">pe mateei zeulie de teikehemi zeulie teibeu zie.<verse eid="PSA 41:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 41:4" />Ih kiegai, “RAMPAUBO, acu ngaunggia gailo!</para>
  <para style="q" vid="PSA 41:4">Acu tei ngkei beulo, kedanemene Ih n dage kemau teigai dide kecune.”<verse eid="PSA 41:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 41:5" />A ngauraume acu ngau kerau sam rangla, penui rangla,</para>
  <para style="q" vid="PSA 41:5">‘Pa daidau tsai la nah pe zi nsungta dila?’<verse eid="PSA 41:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 41:6" />Magagede a ngauraume acu pie kera gwang cai, pa sam kemtabe rangla;</para>
  <para style="q" vid="PSA 41:6">penui acu tei ngkap kera hekwa lala;</para>
  <para style="q" vid="PSA 41:6">pa atai gade tet kedidau, pa cide kedame de ranglia la.<verse eid="PSA 41:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 41:7" />Acu ngaurau kelame pelane a ha hangge ge dage rang lala;</para>
  <para style="q" vid="PSA 41:7">acu rezam di kera regui lala.<verse eid="PSA 41:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 41:8" />Penui rangla, “Ketsai mateei peda la dida;</para>
  <para style="q" vid="PSA 41:8">pa cu au zeu bamdi delu, pa au cuh daigai lakta.”<verse eid="PSA 41:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 41:9" />Ih nlum kela a zangnabe kecang de,</para>
  <para style="q" vid="PSA 41:9">a taktyei tyei kelabe de,</para>
  <para style="q" vid="PSA 41:9">acu ngkau dida.<note caller="+" style="f"><char style="fr" closed="false">41:9 </char><char style="ft" closed="false">2 Sam. 15:12, Jhn. 13:18, Bat. 1:16</char></note><verse eid="PSA 41:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 41:10" />Dede nang, RAMPAUBO, acu ngaunggia gailo nah acu teu ncuh beulo</para>
  <para style="q" vid="PSA 41:10">iciu eh Ih penuide penui zie teidai beulu kerane.<verse eid="PSA 41:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 41:11" />Aide gade nang acu nsuila kecu Ih cibam,</para>
  <para style="q" vid="PSA 41:11">kedanemene a ngauraume a reu ngkinglu mekecune.<verse eid="PSA 41:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 41:12" />A ziemne au, Ih keyi tei kela ga nang acu ngha la</para>
  <para style="q" vid="PSA 41:12">nah nang kelungta n taiga acu gum beuzie.<verse eid="PSA 41:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 41:13" />Peu RAMPAUBE, Israel Tinggwang de hetwa punglu</para>
  <para style="q" vid="PSA 41:13">kelungta nah kelungta.</para>
  <para style="q" vid="PSA 41:13">Amen nah Amen.<note caller="+" style="f"><char style="fr" closed="false">41:13 </char><char style="ft" closed="false">Luk. 1:68, Lei. 106:48</char></note><verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="ms">Laisiukwak Kenabe</para>
  <para style="s">Daitei nang nsuisia lano, Oh a Rabo?</para>
  <para style="d">Lei kempwakme muiteube ziemne. Korah namedung gu maschil ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 42:1" />Heti dui reunadung de luu neu kela nzwa,</para>
  <para style="q" vid="PSA 42:1">cinzwa eh Ih de ncu hengim bam, Tinggwang.<verse eid="PSA 42:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 42:2" />Ih Tinggwang de luu neula, kering Tinggwang de,</para>
  <para style="q" vid="PSA 42:2">Ih daidau Tinggwang dwaga gwanglai?<note caller="+" style="f"><char style="fr" closed="false">42:2 </char><char style="ft" closed="false">Lei. 63:1, Keu. 22:4</char></note><verse eid="PSA 42:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 42:3" />Tingmui tingba a miakduidung le a taktyeipok teibam dida,</para>
  <para style="q" vid="PSA 42:3">a ngauraume a dage, “N Tinggwang si?” De eh rangmui kebamdau.<verse eid="PSA 42:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 42:4" />Ih ma aidungde nsunglu ge Ih a lung teei dila:</para>
  <para style="q" vid="PSA 42:4">Ih mina madungde de ngngwa tet nah penuide Tinggwang ki gage ngngwa gai</para>
  <para style="q" vid="PSA 42:4">suiyi kwa nah hetwa peu eh, hemaa maadi ge hengyi kebam.<verse eid="PSA 42:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 42:5" />Daitei nang, nsui sia la no?</para>
  <para style="q" vid="PSA 42:5">Daitei nang nlung gade nsui sia süt bam no?</para>
  <para style="q" vid="PSA 42:5">Ih Tinggwang da a keregui bam zie, Ih pecu twa dai zie kedanemene pa a Tinggwang acu rikelune.<note caller="+" style="f"><char style="fr" closed="false">42:5 </char><char style="ft" closed="false">Mat. 26:38, Mrk. 14:34. Jhn. 12:27</char></note><verse eid="PSA 42:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 42:6" />A Tinggwang, cu au a lung gade a suisiasüt bam dida,</para>
  <para style="q" vid="PSA 42:6">ciziemne Jordan deu gade Ih ncu nsung dailu zie,</para>
  <para style="q" vid="PSA 42:6">Hermon Deutu kecum gade, nah Mizar deutu gade.<verse eid="PSA 42:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 42:7" />N dui lwamie kecu kwa dene kecok ge ne kecok ge de qu gai;</para>
  <para style="q" vid="PSA 42:7">ngu duidicuidung nah n tingkaicuidung a reu ga gwang.<verse eid="PSA 42:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 42:8" />Dede tingba nsangne RAMPAUBE pe keku de acu pwa liala;</para>
  <para style="q" vid="PSA 42:8">delwe tingmui msangne Ih pe leidung tei zie,</para>
  <para style="q" vid="PSA 42:8">acu kering pwa kepeu be Tinggwang dade kei eh.<verse eid="PSA 42:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 42:9" />Ih Tinggwang dage ranggai zie, a tsura, “Acu daitei nsung tadi no?</para>
  <para style="q" vid="PSA 42:9">Daitei a ngauraume acu tei keherei kegai ziemne Ih asui sia la laino?”<verse eid="PSA 42:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 42:10" />A radung ga kingtie ge kebam nzwa, a ngauraumedung acu mmau bam,</para>
  <para style="q" vid="PSA 42:10">penui acu, “N Tinggwang daiga bamno?” De eh rangmui kebamdau.<verse eid="PSA 42:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 42:11" />Daitei nang, n suisia lano?</para>
  <para style="q" vid="PSA 42:11">Daitei nang n suisiasüt bamno, a rabo?</para>
  <para style="q" vid="PSA 42:11">Ih Tinggwang da a keregui bam zie, Ih pecu twa daizie kedanemene pa a kelikelube nah a Tinggwang kecune.<note caller="+" style="f"><char style="fr" closed="false">42:11 </char><char style="ft" closed="false">Lei. 43:5, Mrk. 14:34, Jhn. 12:27</char></note><verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="s">N kebaa nah n masang lang gailo</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 43:1" />A nzeu acu peulo, Tinggwang, nah samsang kemak heleuh ge dade a nzeu rang beulo.<verse eid="PSA 43:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 43:2" />Kedanemene nang au a kengkieng Tinggwang lu. Daitei acu mlai dino?</para>
  <para style="q" vid="PSA 43:2">Daitei a ngauraume acu tei keherei kegai ziemne Ih asui sia lano?<verse eid="PSA 43:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 43:3" />Oh, n kebaa nah n masang langgai lo, penuide peu a lampui saulia beulo.</para>
  <para style="q" vid="PSA 43:3">Peu penuide peu acu n kemci deutu<note caller="+" style="f"><char style="fr" closed="false">43:3 </char><char style="fq" closed="false">Kemci deutu: </char><char style="ft" closed="false">Zion </char></note> ga ngngwa gwanglo</para>
  <para style="q" vid="PSA 43:3">nah nang lungh kebam ga.<verse eid="PSA 43:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 43:4" />Pecai Ih Tinggwang recabam ga mie zie,</para>
  <para style="q" vid="PSA 43:4">Ih a suisüt kela a Tinggwang da.</para>
  <para style="q" vid="PSA 43:4">Ih harp le ncu twa zie, Tinggwang, a Tinggwang.<verse eid="PSA 43:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 43:5" />Daitei nang, nsui sia la no?</para>
  <para style="q" vid="PSA 43:5">Daitei nang alung gade nsui sia süt bam no?</para>
  <para style="q" vid="PSA 43:5">Ih Tinggwang da a keregui bam zie, Ih pecu twa dai zie kedanemene pa a Tinggwang acu rikelune.<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="s">Anuide nghalo</para>
  <para style="d">Lei kempwakme muiteube ziemne. Korah namedung gu lei ge. Maschil ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 44:1" />Anui kwen le anui siu da, Tinggwang,</para>
  <para style="q" vid="PSA 44:1">anui peimedung anuide ranglia da</para>
  <para style="q" vid="PSA 44:1">penui tingdau nang hetah tei kegaidung,</para>
  <para style="q" vid="PSA 44:1">nda tingdau.<verse eid="PSA 44:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 44:2" />Nang n ba le heleuhdung de gwa gidi,</para>
  <para style="q" vid="PSA 44:2">dede nang anui minadung de peu kwaklu;</para>
  <para style="q" vid="PSA 44:2">nang minadung de tei keherei,</para>
  <para style="q" vid="PSA 44:2">dede nang anui minadung de kideube ga lunghhing petlu.<verse eid="PSA 44:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 44:3" />Kedanemene penui katei n minadung penui kiengtie le penui hangdeu de gum kera ngau luma,</para>
  <para style="q" vid="PSA 44:3">mede penui katei penui ba le penuide kelilu ma;</para>
  <para style="q" vid="PSA 44:3">dede n zetle ba le, n bapum, nah n zu kebaa de ne,</para>
  <para style="q" vid="PSA 44:3">kedanemene nang penuide nsui kelane.<verse eid="PSA 44:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 44:4" />Tinggwang, Nang au a Hegwangpei;</para>
  <para style="q" vid="PSA 44:4">Jacob de ngamkelu peu.<verse eid="PSA 44:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 44:5" />N dade anui ngauraume de tei nkau dizie;</para>
  <para style="q" vid="PSA 44:5">n zi gade anuide renia cuh kelame de anui kang gage kailu zie.<verse eid="PSA 44:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 44:6" />Kedanemene Ih a lakpi de nlum kelakne,</para>
  <para style="q" vid="PSA 44:6">mede a kingtie ne acu kelilu lak.<verse eid="PSA 44:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 44:7" />Dede nang anui ngauraume dade anuide kelibeu da,</para>
  <para style="q" vid="PSA 44:7">nah anuide ngaurau kelame de peu hengam teidi.<verse eid="PSA 44:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 44:8" />Petingnai Tinggwang ziemne anui ngang la,</para>
  <para style="q" vid="PSA 44:8">nah anui n zi de kelungta twala zie. <char style="qs">Selah</char><verse eid="PSA 44:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 44:9" />Dede cu au nang anuide keliengi dida nah anuide peu hengam teugwang beu,</para>
  <para style="q" vid="PSA 44:9">nah nang anui reugwamedung de ngngwatet meda.<verse eid="PSA 44:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 44:10" />Nang anuide peu anui ngauraume dade nreutetdi;</para>
  <para style="q" vid="PSA 44:10">nah anuide ngaurau kelame anui gudung luu teu dida.<verse eid="PSA 44:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 44:11" />Nang anuide teipwa meurünna de gitset kera nzwa tei dida</para>
  <para style="q" vid="PSA 44:11">nah anuide heleuhdung kakga tei zangra dida.<verse eid="PSA 44:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 44:12" />Nang n minadung de pemi kegah gele zwa dida;</para>
  <para style="q" vid="PSA 44:12">cide ketei dele nang n mahei tei ngkiee swama.<verse eid="PSA 44:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 44:13" />Nang peu anui kidacaineme de anuide mmau,</para>
  <para style="q" vid="PSA 44:13">anui taiga kelame ne anuide rang msia nah henui teibam.<verse eid="PSA 44:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 44:14" />Nang peu heleuhdung kakgade anuide rangmsia,</para>
  <para style="q" vid="PSA 44:14">minadung kakgade anuide penui peungum bam.<verse eid="PSA 44:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 44:15" />Petingnai a hengam de a dwaga lala,</para>
  <para style="q" vid="PSA 44:15">nah a zu hengam de le acu gum pwabam<verse eid="PSA 44:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 44:16" />mide kesiu nah rang msiakelabe kwa ziemne,</para>
  <para style="q" vid="PSA 44:16">ngauraume nah hekum peei kelame ziemne.<verse eid="PSA 44:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 44:17" />Aidungde pelane anui reu ga gwang; iciu lie de anui ncu nsungtadi ma</para>
  <para style="q" vid="PSA 44:17">mede n samkak dage anui kenretdi ma.<verse eid="PSA 44:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 44:18" />Anui nlung nreu caili dima;</para>
  <para style="q" vid="PSA 44:18">anui piketdung n lampui gade tet tsam dima.<verse eid="PSA 44:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 44:19" />Iciuliede nang anuide heneudung kakgage tei msiasüt gai dida</para>
  <para style="q" vid="PSA 44:19">nah ketsai tingkaumie le anuide gum dida.<verse eid="PSA 44:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 44:20" />Magade anui Tinggwang zi nsungtadi liecai</para>
  <para style="q" vid="PSA 44:20">mede anui ba sang keda tinggwang dage hetwa petgai liecai,<verse eid="PSA 44:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 44:21" />Tinggwang aide peei gai lakni?</para>
  <para style="q" vid="PSA 44:21">Kedanemene pa mi lungning kengkiemdung de cilu kelane.<verse eid="PSA 44:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 44:22" />Kesang, n ziemne anuide daptset bammui dida;</para>
  <para style="q" vid="PSA 44:22">meurünna ge de gitset keranzwa anuide cetlu.<note caller="+" style="f"><char style="fr" closed="false">44:22 </char><char style="ft" closed="false">Rom. 8:36</char></note><verse eid="PSA 44:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 44:23" />Mraklu, daitei zip bamno, Rampaubo?</para>
  <para style="q" vid="PSA 44:23">Cuhlu, anuide kelungta gidi so.<verse eid="PSA 44:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 44:24" />Daitei n zu hebai lano</para>
  <para style="q" vid="PSA 44:24">nah anui rei nah lungreidung nsungtadi lano?<verse eid="PSA 44:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 44:25" />Anui rebui ga kaumie di kecune;</para>
  <para style="q" vid="PSA 44:25">anui pumdung kideu ga sia eh kaumie dida.<verse eid="PSA 44:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 44:26" />Anuide ngha kera cuh lulo</para>
  <para style="q" vid="PSA 44:26">nah n samkakkelu samsang de ziemne anuide keli beulo.<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="s">N hegwangbam au, O Tinggwang, kelungta</para>
  <para style="d">Lei kempwakme muiteube ziemne; Shoshannim gage tei gai. Korah namedung gu lei ge. Maschil ge. Kehung lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 45:1" />Ma ha keyibe le a nlung pui dida;</para>
  <para style="q" vid="PSA 45:1">Ih hegwangpei ziemne mpwak kelu samdung de Ih pei mtei lia zie;</para>
  <para style="q" vid="PSA 45:1">a mleu de ma rau kecime gu kerautie ge.<verse eid="PSA 45:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 45:2" />Nang mina namedung swade hezu yi;</para>
  <para style="q" vid="PSA 45:2">n muileudung gage ngaugia sam ruigai pwabam;</para>
  <para style="q" vid="PSA 45:2">ciziemne Tinggwang ncu kelungta samlam beu kecu anui cibam.<note caller="+" style="f"><char style="fr" closed="false">45:2 </char><char style="ft" closed="false">Luk. 4:22, Heb. 1:3-4</char></note><verse eid="PSA 45:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 45:3" />N kingtie n mbie gage kailu, kengkingbo,</para>
  <para style="q" vid="PSA 45:3">n kemdu nah kengkieng gade.<verse eid="PSA 45:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 45:4" />N kengkieng de hecili eh tet petlu,</para>
  <para style="q" vid="PSA 45:4">kedanemene kesamsang, mnwa, nah nlumlu kebui ziemne;</para>
  <para style="q" vid="PSA 45:4">n ba zetle ne ncu ngau kehingdung ledeu lia zie.<verse eid="PSA 45:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 45:5" />N lakpitsidung au pemui yi;</para>
  <para style="q" vid="PSA 45:5">minadung n kangga kaumie dila;</para>
  <para style="q" vid="PSA 45:5">n lakpitsidung au hegwangpei ngauraume mlungdung ga la dida.<verse eid="PSA 45:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 45:6" />O Tinggwang, n hegwangbam au, kelungta nah kelungta;</para>
  <para style="q" vid="PSA 45:6">n hegwangram au masang nah masang eh bamzie.<verse eid="PSA 45:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 45:7" />Nang kesamsangbe de nsui nah kesiabe de au ngkau la;</para>
  <para style="q" vid="PSA 45:7">cine Tinggwang, n Tinggwang, ne suiyi ca le</para>
  <para style="q" vid="PSA 45:7">ncu keniaklu n kangngwame swade kieeki eh.<note caller="+" style="f"><char style="fr" closed="false">45:7 </char><char style="ft" closed="false">Heb. 1:8-9</char></note><verse eid="PSA 45:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 45:8" />Nnui painidung pelane myrrh, aloe, nah cassia rim nnamla;</para>
  <para style="q" vid="PSA 45:8">hepwangeu hegwangkidung gade heria le tei kelu leibungdung ne n suiyi teilu.<verse eid="PSA 45:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 45:9" />Hegwangpeime napuimedung nnui herüt kepeu mipuidung kakga la;</para>
  <para style="q" vid="PSA 45:9">n zetle ba lebie hegwangpui Ophir kecakle<note caller="+" style="f"><char style="fr" closed="false">45:9 </char><char style="ft" closed="false">kecak yitube 1kg 9:28; 10:11, job 22:24, 28:16</char></note> cumlu eh bam.<verse eid="PSA 45:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 45:10" />Kingneilu, hegwang napui, kingnei teune lu;</para>
  <para style="q" vid="PSA 45:10">nkatei n minadung nah n pei ki nsungta dilu.<verse eid="PSA 45:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 45:11" />Ainzwa eh hegwangpei n zuyi de hengim zie;</para>
  <para style="q" vid="PSA 45:11">pa n mpaube; pecu rütlu.<verse eid="PSA 45:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 45:12" />Tyre namdi hegwang napui mapeu ge pwalwe cika gwang zie;</para>
  <para style="q" vid="PSA 45:12">minadung kakga de keheimedung n ngaugia kie zie.<verse eid="PSA 45:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 45:13" />Hegwangpei napui hegwangki ga ndusüt bam;</para>
  <para style="q" vid="PSA 45:13">pe niadung kecak le tei pwabam.<verse eid="PSA 45:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 45:14" />Pepai pegiak kepui nia teulu delwe pecu hegwangpei dage ngngwa gai dizie;</para>
  <para style="q" vid="PSA 45:14">kemci puidung, pe kangngwamedung pecai sui kelame,</para>
  <para style="q" vid="PSA 45:14">n dage ngngwa gwang beuzie.<verse eid="PSA 45:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 45:15" />Penui sui yi nah rengasüt zie;</para>
  <para style="q" vid="PSA 45:15">penui hegwangpei ki ga lüt zie.<verse eid="PSA 45:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 45:16" />N peimedung bam n namedung ne pwa leu zie,</para>
  <para style="q" vid="PSA 45:16">nang penuide peu kideu pelane ga hegwangme teizie.<verse eid="PSA 45:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 45:17" />Ih ceheu leune de n zi nsung lalu kera teibeu zie;</para>
  <para style="q" vid="PSA 45:17">cine minadung kelungta nah kelungta ncu hetwa peu zie.<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="s">Tinggwang au anui kensiube</para>
  <para style="d">Lei kempwakme muiteube ziemne. Korah namedung gu lei ge; Alamoth gage tei gai. Lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 46:1" />Tinggwang au anui nsiube nah kengkieng,</para>
  <para style="q" vid="PSA 46:1">keherei tingdau nghabeu la.<verse eid="PSA 46:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 46:2" />Ciziemne anui ngngi dilak, kideube nnui teudi liede,</para>
  <para style="q" vid="PSA 46:2">lamlwatudung jaaidi kecuk gage kelien gaidi liede,<verse eid="PSA 46:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 46:3" />pe duidung mra nah pe rata di liede, nah</para>
  <para style="q" vid="PSA 46:3">lamlwatudung mma kecu ziemne mbeu di liede.<note caller="+" style="f"><char style="fr" closed="false">46:3 </char><char style="ft" closed="false">Luk. 21:25, Mat. 7:25</char></note> <char style="qs">Selah</char><verse eid="PSA 46:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 46:4" />Tinggwang namdi be ga suiyi teu gwang beu kela kereuki reunadung bamla,</para>
  <para style="q" vid="PSA 46:4">Hutube Tinggwang lungh kebam kemci ni ga.<verse eid="PSA 46:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 46:5" />Tinggwang au namdibe sum ga la; pecu pwa nlaidi gailak;</para>
  <para style="q" vid="PSA 46:5">Tinggwang pecu ngha zie, nah pa cide tingcang nuge teigai zie.<verse eid="PSA 46:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 46:6" />Heleuhbedung penui rata di nah hegwangramdung mbeu di;</para>
  <para style="q" vid="PSA 46:6">pa mra cuhgai, nah kideube suimie di.<note caller="+" style="f"><char style="fr" closed="false">46:6 </char><char style="ft" closed="false">Keu. 11:18, Lei. 2:1</char></note><verse eid="PSA 46:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 46:7" />Kengkieng RAMPAUBE anuida la;</para>
  <para style="q" vid="PSA 46:7">Jacob Tinggwang au anui kensiube. <char style="qs">Selah</char><verse eid="PSA 46:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 46:8" />Gwanglu, ainie RAMPAUBE batadung,</para>
  <para style="q" vid="PSA 46:8">kideube ga kengkap kai kegai de pielo.<verse eid="PSA 46:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 46:9" />Pa kideube pelane ga hereu keteide kaam dida;</para>
  <para style="q" vid="PSA 46:9">pa lakpidung de teipangdi la nah hengeidung de dang takcai dila;</para>
  <para style="q" vid="PSA 46:9">pa hegeudung de ru dila.<verse eid="PSA 46:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 46:10" />Zingde dilu nah Ih Tinggwang lie kecu cilu;</para>
  <para style="q" vid="PSA 46:10">heleuhdung kakga acu hetwa peu zie; kideube reuga acu hetwa peu zie.<verse eid="PSA 46:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 46:11" />Kengking RAMPAUBE anuida la;</para>
  <para style="q" vid="PSA 46:11">Jacob Tinggwang au anui kensiube. <char style="qs">Selah</char><verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="s">Tinggwang au kideu pelane reu Hegwangpei</para>
  <para style="d">Lei kempwakme muiteube ziemne. Korah namedung gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 47:1" />Nnui bapeu lo, nnui mina pelane;</para>
  <para style="q" vid="PSA 47:1">Tinggwang dage kengkieng kwa le sah gailu.<verse eid="PSA 47:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 47:2" />Hutube RAMPAUBE au miswagah kecune;</para>
  <para style="q" vid="PSA 47:2">pa kideu pelane reu Hegwang kedi ge.<verse eid="PSA 47:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 47:3" />Pa minadung anui kangga kai dila</para>
  <para style="q" vid="PSA 47:3">nah heleuhdung de anui pi kangga kai dila.<verse eid="PSA 47:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 47:4" />Anui mapwa pa ne anui ziemne kedet beula,</para>
  <para style="q" vid="PSA 47:4">cide pa hung kela Jacob kemdu. <char style="qs">Selah</char><verse eid="PSA 47:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 47:5" />Tinggwang pe hegwang ga nghang dida suiyi kwa sah eh,</para>
  <para style="q" vid="PSA 47:5">RAMPAUBE telui kwa gai eh.<verse eid="PSA 47:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 47:6" />Tinggwang da ketwa leidung teigailu, ketwa leidung teilu;</para>
  <para style="q" vid="PSA 47:6">anui Hegwangpei da ketwa leidung teigailu, ketwa leidung teilu.<verse eid="PSA 47:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 47:7" />Kideube pelane reu Tinggwang Hegwang kecune;</para>
  <para style="q" vid="PSA 47:7">macet keci teu eh ketwa leidung teilu.<verse eid="PSA 47:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 47:8" />Heleuhdung reu Tinggwang hegwang teila;</para>
  <para style="q" vid="PSA 47:8">Tinggwang pe kemci hegwangbam ga bamla.<note caller="+" style="f"><char style="fr" closed="false">47:8 </char><char style="ft" closed="false">Lei. 96:10, Keu. 19:6</char></note><verse eid="PSA 47:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 47:9" />Heleuhdung reu kedime</para>
  <para style="q" vid="PSA 47:9">Abraham Tinggwang minadung de ngngwa ngkwa luda;</para>
  <para style="q" vid="PSA 47:9">kideube geu hegwangdung pelane Tinggwang gu kecune;</para>
  <para style="q" vid="PSA 47:9">kehei gade pecu hetwa peu sütla.<verse eid="PSA 47:9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="s">Zion, anui Tinggwang Namdi</para>
  <para style="d">Lei ge; Korah namedung gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 48:1" />RAMPAUBE au dizu nah twasüt kerabe,</para>
  <para style="q" vid="PSA 48:1">Tinggwang namdibe<note caller="+" style="f"><char style="fr" closed="false">48:1 </char><char style="fq" closed="false">Namdibe: </char><char style="ft" closed="false">Jerusalem</char></note> ga pe kemci lamlwa<note caller="+" style="f"><char style="fr" closed="false">48:1 </char><char style="fq" closed="false">Lamlwa </char><char style="ft" closed="false">Mount Zion</char></note> ga.<verse eid="PSA 48:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 48:2" />Pe hu au hezu yi, kideu pelane suiyibe,</para>
  <para style="q" vid="PSA 48:2">au Zion deutu, tingtünle mbie ga,<note caller="+" style="f"><char style="fr" closed="false">48:2 </char><char style="ft" closed="false">Mat. 5:35, Jer. 3:19</char></note></para>
  <para style="q" vid="PSA 48:2">Hegwang kedi namdi be.<verse eid="PSA 48:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 48:3" />Pe hegwangki gade Tinggwang pekatei pecu kensiube ge lie de eh peu pecu cigai.<verse eid="PSA 48:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 48:4" />Kedanemene, pielo, hegwangmedung gwang ngkwalu;</para>
  <para style="q" vid="PSA 48:4">penui ncüt eh nzangpet.<verse eid="PSA 48:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 48:5" />Penui cipau namdi de ngaugai, ge penui swa gahdi;</para>
  <para style="q" vid="PSA 48:5">penui ngngi di, nah penui pak zette tetdi.<verse eid="PSA 48:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 48:6" />Cika kengngi ne penuide tuilu,</para>
  <para style="q" vid="PSA 48:6">mipuige hena mna eh teei kela nzwa.<verse eid="PSA 48:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 48:7" />Naimiak kepetle tingkai le</para>
  <para style="q" vid="PSA 48:7">nang Tarshish namdi liemdung teimsia di.<verse eid="PSA 48:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 48:8" />Anui siu kelu nzwa, anui ngau da</para>
  <para style="q" vid="PSA 48:8">kengkieng RAMPAUBE namdibe ga, anui Tinggwang namdibe ga;</para>
  <para style="q" vid="PSA 48:8">Tinggwang cide peu kelungta kwak luzie. <char style="qs">Selah</char><verse eid="PSA 48:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 48:9" />Anui n samkakkelu samsang de cetncok gai, Oh Tinggwang,</para>
  <para style="q" vid="PSA 48:9">n kerecaki sum gade.<verse eid="PSA 48:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 48:10" />N zi au, Tinggwang kecu nzwa,</para>
  <para style="q" vid="PSA 48:10">cine kideu penli kecang ncu twa bam;</para>
  <para style="q" vid="PSA 48:10">n zetle ba ga kesamsang le puibam.<verse eid="PSA 48:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 48:11" />Peu Zion Deutu de pe sui yilu,</para>
  <para style="q" vid="PSA 48:11">Judah ga minadung depeu penui sui yilu</para>
  <para style="q" vid="PSA 48:11">n kesamsang hezaidung de ziemne.<verse eid="PSA 48:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 48:12" />Zion Deutu tet twagwalu, cide tet twagwalu;</para>
  <para style="q" vid="PSA 48:12">pe hapiadung peeilu,<verse eid="PSA 48:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 48:13" />pe kirie kwakeludung pie hemi gailo,</para>
  <para style="q" vid="PSA 48:13">nah pe hegwangkidung de pielo</para>
  <para style="q" vid="PSA 48:13">iciu eh pecai lungleu kerame de rang lialu kerane.<verse eid="PSA 48:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 48:14" />Aide ziemne Tinggwang au anui Tinggwang kelungta nah kelungta;</para>
  <para style="q" vid="PSA 48:14">ketsai kecangde pa anui lampui sau beuzie.<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="s">Ih daitei hing laino keherei tingdau</para>
  <para style="d">Lei kempwakme muiteube ziemne. Korah namedung gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 49:1" />Aide kingneilu, nnui mina leune;</para>
  <para style="q" vid="PSA 49:1">siulu, kideu ga lungh kebam leune,<verse eid="PSA 49:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 49:2" />kehenah nah kecehu kenanah de,</para>
  <para style="q" vid="PSA 49:2">kehei nah kegah pelane.<verse eid="PSA 49:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 49:3" />A mui macisam rang zie</para>
  <para style="q" vid="PSA 49:3">nah a lungcet au maci luzie.<verse eid="PSA 49:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 49:4" />Ih macisam de cet mning zie;</para>
  <para style="q" vid="PSA 49:4">Ih macisam de teu eh rang mcilia gai zie leibung kwa eh.<verse eid="PSA 49:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 49:5" />Kengngi gwang kecu dau Ih daitei hinglai,</para>
  <para style="q" vid="PSA 49:5">ngauraume acu twagwa kelu dau?<verse eid="PSA 49:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 49:6" />Ih daitei mina penui mahei de nlum kelame</para>
  <para style="q" vid="PSA 49:6">nah penui mahei ziemne ngang kelame de hingla lai?<verse eid="PSA 49:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 49:7" />Migede pe sinabe de rilu gailak kesang</para>
  <para style="q" vid="PSA 49:7">mede Tinggwang de pe teilung mi ha gailak,<verse eid="PSA 49:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 49:8" />kedanemene mina teilung rilu kera au pemi hungham kecune</para>
  <para style="q" vid="PSA 49:8">nah anui peu kera de migede ruicang gailak.<verse eid="PSA 49:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 49:9" />Iciu eh peu pe paube de timrimdi mene</para>
  <para style="q" vid="PSA 49:9">kelungta lungh bamlu kerane.<verse eid="PSA 49:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 49:10" />Kedanemene timrim kedi de mina ngau zie. Makecime tsai bam;</para>
  <para style="q" vid="PSA 49:10">kemieme de nah kemangme gah dizie</para>
  <para style="q" vid="PSA 49:10">nah penui mabam kedame de kaidiak dila.<verse eid="PSA 49:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 49:11" />Penui lungning au penui kibaume kelungta lungh kera cet lala,</para>
  <para style="q" vid="PSA 49:11">nah penui kelungh henidung de, ceuheu pelane ga;</para>
  <para style="q" vid="PSA 49:11">penui penui zidung dele penui kideube zi qula.<verse eid="PSA 49:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 49:12" />Dede mina, mahei kebambe, kelungta ringbam lula ma;</para>
  <para style="q" vid="PSA 49:12">pa au tsaidi kela teikuu nzwa da.<verse eid="PSA 49:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 49:13" />Aide, penui lampui, au kemie;</para>
  <para style="q" vid="PSA 49:13">dede minadung au penui kerangdung de suizwa lala. <char style="qs">Selah</char><verse eid="PSA 49:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 49:14" />Meurünna ge nzwa penuide au Sheol gage kaidi la,</para>
  <para style="q" vid="PSA 49:14">nah ketsai ne penuide kekwabe zie.</para>
  <para style="q" vid="PSA 49:14">Makesangme ne penui reu tingcang ngking luzie,</para>
  <para style="q" vid="PSA 49:14">nah penui pumdung Sheol gade ngkap dizie,</para>
  <para style="q" vid="PSA 49:14">penui lung kera heni ge de gah dizie.<verse eid="PSA 49:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 49:15" />Dede Sheol kengkieng gade Tinggwang a teilung keli beuzie;</para>
  <para style="q" vid="PSA 49:15">pa acu lulu zie. <char style="qs">Selah</char><verse eid="PSA 49:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 49:16" />Mige mahei keludau ngngi diso,</para>
  <para style="q" vid="PSA 49:16">nah pe ki kemdu kiee pet kedidau de.<verse eid="PSA 49:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 49:17" />Kedanemene pa tsai kedidau pa magede keu tet swa kelakne;</para>
  <para style="q" vid="PSA 49:17">pe kemdu pecu pecai nzang nghung lak.<verse eid="PSA 49:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 49:18" />Pa lungh kebamdau pe teilung de samlam pung lie cetla,</para>
  <para style="q" vid="PSA 49:18">nah nang nkatei nziemne lungh kegaidau minadung ncu hetwa peula,<verse eid="PSA 49:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 49:19" />pa pe peime ceheu ga mie dizie</para>
  <para style="q" vid="PSA 49:19">nah penui madaude kebaa de ngaudai silak.<verse eid="PSA 49:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 49:20" />Mige mahei bam dede maci gah kecume au</para>
  <para style="q" vid="PSA 49:20">tsaidi kela teikuudung nzwa da.<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="s">Tinggwang au Tutiakpei</para>
  <para style="d">Asaph gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 50:1" />Kengkingbe, Tinggwang, RAMPAUBE, ranggai da</para>
  <para style="q" vid="PSA 50:1">nah kideube naimiak kepetle gade naimiak kenlütle kecang de qugai.<verse eid="PSA 50:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 50:2" />Zion, hezu yicang kecu gade,</para>
  <para style="q" vid="PSA 50:2">bagai zeu Tinggwang.<verse eid="PSA 50:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 50:3" />Anui Tinggwang gwangla nah zing de bam ma;</para>
  <para style="q" vid="PSA 50:3">miheu ge pe dwa ga la,</para>
  <para style="q" vid="PSA 50:3">nah heratingkai le pecu twagwalu.<verse eid="PSA 50:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 50:4" />Tinggwang nreu ga kebam tinggimdung de qula</para>
  <para style="q" vid="PSA 50:4">nah kideube de iciu eh pa pe minadung de tiaklu kerane:<verse eid="PSA 50:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 50:5" />“A mina samsang kelame de hekwalu,</para>
  <para style="q" vid="PSA 50:5">ratak gade acu ngngwa samkak kelumedung de.”<verse eid="PSA 50:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 50:6" />Tinggimdung pa masang lie de eh rang mdulia zie,</para>
  <para style="q" vid="PSA 50:6">kedanemene Tinggwang au pekatei de hetuketiakbe kecune.<note caller="+" style="f"><char style="fr" closed="false">50:6 </char><char style="ft" closed="false">Lei. 97:6, Heb. 12:23</char></note> <char style="qs">Selah</char><verse eid="PSA 50:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 50:7" />“Kingneilu, a minadung, nah Ih rangzie;</para>
  <para style="q" vid="PSA 50:7">Ih au Tinggwang, n Tinggwang.<verse eid="PSA 50:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 50:8" />Ih nnui ratakdung ziemne nnuide kesiu ma;</para>
  <para style="q" vid="PSA 50:8">nnui gu keru ratakdung a dwa ga bammuila.<verse eid="PSA 50:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 50:9" />Ih nnui ki gade hetumseu ge de keulak,</para>
  <para style="q" vid="PSA 50:9">mede n meu ki gade hemeuseudung de keu lak.<verse eid="PSA 50:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 50:10" />Kedanemene renaam kaune pelane au agu kecune,</para>
  <para style="q" vid="PSA 50:10">nah kideutudung cangcang ga hetumdung.<verse eid="PSA 50:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 50:11" />Lamlwatudung ga nruine leune de Ih cibam,</para>
  <para style="q" vid="PSA 50:11">nah luh ga renaam kaunedung au agu.<verse eid="PSA 50:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 50:12" />Magade Ih mzeu liede, Ih ncu ranglak;</para>
  <para style="q" vid="PSA 50:12">kedanemene kideube agu kecune, nah cika kebam pelane.<note caller="+" style="f"><char style="fr" closed="false">50:12 </char><char style="ft" closed="false">Bat. 17:25, 1 Cor. 10:26 </char></note><verse eid="PSA 50:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 50:13" />Ih hetumseudung teih tyei zie ni</para>
  <para style="q" vid="PSA 50:13">mede hemeudung jai sak zie ni?<verse eid="PSA 50:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 50:14" />Tinggwang dage ketwa ratak teigailu,</para>
  <para style="q" vid="PSA 50:14">nah nnui sampet kelu pelane pwa Hutube Tinggwang de peulo.<note caller="+" style="f"><char style="fr" closed="false">50:14 </char><char style="ft" closed="false">Heb. 13:15, Ecc. 5:4-5</char></note><verse eid="PSA 50:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 50:15" />Keherei kegwangdau acu qulu;</para>
  <para style="q" vid="PSA 50:15">Ih ncu keli beuzie, nah nang acu twa zie.”<verse eid="PSA 50:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 50:16" />Dede kemaume dage Tinggwang ranggai,</para>
  <para style="q" vid="PSA 50:16">“Nang a zaidung pei lwe nang dai tei lai,</para>
  <para style="q" vid="PSA 50:16">nang n mui gade ruine Ih samkak kebeude rang kegai,<verse eid="PSA 50:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 50:17" />kedanemene nang keledeu de de ngkau</para>
  <para style="q" vid="PSA 50:17">nah a samdung de heling gidi zie?<verse eid="PSA 50:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 50:18" />Nang keragame ge de ngau kecudau, nang pecu suizwala;</para>
  <para style="q" vid="PSA 50:18">nang kemmha ta tei kelame de ngngwa kemmha ta teila.<verse eid="PSA 50:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 50:19" />Nang n mui kesiabe de peu dila,</para>
  <para style="q" vid="PSA 50:19">nah n mleu kenret rangla.<verse eid="PSA 50:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 50:20" />Nang mtum bam eh n sinabe de mmau lala;</para>
  <para style="q" vid="PSA 50:20">nang ngkatei n pui napei de rangmsia la.<verse eid="PSA 50:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 50:21" />Nang aidungde tei, dede Ih zingde bam,</para>
  <para style="q" vid="PSA 50:21">cine nang Ih nang kenzwame gelie de cetdi.</para>
  <para style="q" vid="PSA 50:21">Dede Ih nnuide kesiu zie nah teucuh beuzie, n miak dwade, nang tei kegai leune.<verse eid="PSA 50:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 50:22" />Aide kingnei teune lu, nnui Tinggwang de nsungta di kelame,</para>
  <para style="q" vid="PSA 50:22">meliecai Ih nnuide teu rak takcai dizie,</para>
  <para style="q" vid="PSA 50:22">nah migede ncu gwang ngha kera gah dizie!<verse eid="PSA 50:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 50:23" />Ketwa reca ratak tei kebeube acu twala la,</para>
  <para style="q" vid="PSA 50:23">nah keheibe de lampui kemzuibe ga tet kelame de</para>
  <para style="q" vid="PSA 50:23">Ih Tinggwang kelikelu de lia zie.”<note caller="+" style="f"><char style="fr" closed="false">50:23 </char><char style="ft" closed="false">Heb. 13:15</char></note><verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s">A mlung keheci ge damgailo, O Tinggwang</para>
  <para style="d">Kenlang leibungkekwame ziemne. David gu lei ge; pa Bathsheba ga miedi kecu cai caihakecibe Nathan pe da kegwangdau.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 51:1" />Acu ngaunggia lo, Tinggwang, n samkak kenlum de ziemne;</para>
  <para style="q" vid="PSA 51:1">n ngaugia tadung kedi de zi gade, a maudung de tei ngga beulo.<note caller="+" style="f"><char style="fr" closed="false">51:1 </char><char style="ft" closed="false">Luk. 18:13</char></note><verse eid="PSA 51:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 51:2" />A zai kesiabedung gade acu hui cangsiak beu</para>
  <para style="q" vid="PSA 51:2">nah a mau gade acu teimci beu.<verse eid="PSA 51:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 51:3" />Kedanemene Ih a maudung cibam,</para>
  <para style="q" vid="PSA 51:3">nah a maudung a dwaga bam muila.<note caller="+" style="f"><char style="fr" closed="false">51:3 </char><char style="ft" closed="false">2 Sam. 12:13</char></note><verse eid="PSA 51:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 51:4" />Ncu renya, ncu rünne, Ih kemau teidi</para>
  <para style="q" vid="PSA 51:4">nah n miakngau gade kesia teidi;</para>
  <para style="q" vid="PSA 51:4">nang kerang dau nang au petau;</para>
  <para style="q" vid="PSA 51:4">nang hetutiak kecudau nang au mzeu.<note caller="+" style="f"><char style="fr" closed="false">51:4 </char><char style="ft" closed="false">Luk. 15:18,21, Rom. 3:4</char></note><verse eid="PSA 51:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 51:5" />Pielo, acu au kemau gade mna lu;</para>
  <para style="q" vid="PSA 51:5">a pui acu tetlaklu herizi, Ih au kemaume dida.<verse eid="PSA 51:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 51:6" />Pielo, nang alung kesangbe lu neula;</para>
  <para style="q" vid="PSA 51:6">nah cika de nang acu maci ledeu beula.<verse eid="PSA 51:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 51:7" />Hyssop<note caller="+" style="f"><char style="fr" closed="false">51:7 </char><char style="fq" closed="false">Hyssop </char><char style="ft" closed="false">Hyssop was a small bush plant used for sprinkling water or blood on things and people in ceremonies of atonement and purification (see hyssop; Tet. 12:22; Lev. 14:1-7; Pum. 19:1-6, 16-19).</char></note> le pwa acu teimci beulo, nah Ih mcilu kerane;</para>
  <para style="q" vid="PSA 51:7">acu huibeu, nah Ih buising swade ha dizie.<verse eid="PSA 51:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 51:8" />Misuikeyi nah suiyibe peu acu siulo</para>
  <para style="q" vid="PSA 51:8">ciu eh nang peradung teicum kedi de pe sui yilu kerane.<verse eid="PSA 51:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 51:9" />A maudung gade n zu kebaidi lu</para>
  <para style="q" vid="PSA 51:9">a kemaudung pelane tei ngga beulo.<verse eid="PSA 51:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 51:10" />Helung kemci ge a nlung gage damgai beulo, Tinggwang,</para>
  <para style="q" vid="PSA 51:10">nah rabe petausiakpe alung gage teiheci beulo.<verse eid="PSA 51:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 51:11" />N dwa gade acu gwagi diso,</para>
  <para style="q" vid="PSA 51:11">nah n kemci Rabe ada de keuteu diso.<verse eid="PSA 51:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 51:12" />Nang n kelikelu suiyi de a dage teiheci dai lo,</para>
  <para style="q" vid="PSA 51:12">nah rabe neungga eh acu teintie beulo.<verse eid="PSA 51:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 51:13" />Ciu eh Ih kemauketeime de n zaibe gade ledeu zie,</para>
  <para style="q" vid="PSA 51:13">nah kemaumedung n da teu nreu gwang luzie.<verse eid="PSA 51:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 51:14" />Hejai lwa kegai de ziemne a mau gibeu lo, kelikelu a Tinggwang,</para>
  <para style="q" vid="PSA 51:14">nah n samsangbe suiyi de ziemne Ih sahbak gaizie.<verse eid="PSA 51:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 51:15" />Rampaubo, a muileukung ngkei beulo,</para>
  <para style="q" vid="PSA 51:15">nah a mui ncu ketwa ha rang zie.<verse eid="PSA 51:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 51:16" />Kedanemene retakdung ziemne nsuiyi lama, mecai Ih peu gai kera;</para>
  <para style="q" vid="PSA 51:16">nang keru recadung de hengim bam ma.<verse eid="PSA 51:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 51:17" />Tinggwang a ratakdung au acu kegai deda.</para>
  <para style="q" vid="PSA 51:17">Tinggwang, Nang, hena kegaime de nah helung nreu kelume de gidi lama.<verse eid="PSA 51:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 51:18" />Zion dage nnui suiyi eh keyibe teilu;</para>
  <para style="q" vid="PSA 51:18">Jerusalem namdi tangdeudung de teincuh dailu.<note caller="+" style="f"><char style="fr" closed="false">51:18 </char><char style="ft" closed="false">Zion nah Jerusalem aikena de namdi ket da.</char></note><verse eid="PSA 51:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 51:19" />Iciu cai nang kesamsang reca de ga nsuiyi luzie ni,</para>
  <para style="q" vid="PSA 51:19">keru recadung de nah keru recadung pelane;</para>
  <para style="q" vid="PSA 51:19">ciu cai anui minadung hetumseudung n ratakbam ga pwagwang zie.<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="s">Lidila kemak Tinggwang keku de bam muila</para>
  <para style="d">Kenlang leibungkekwame ziemne; David gu maschil ge; Edomme ge Doeg Saul da gwang nah ranggai, nah pe da rang eh, “Ahimelech kiga David gwang bam dida.”</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 52:1" />Nnui kengkieng minadung, daitei nnui mide teikeherei kecu gade hegie lano?</para>
  <para style="q" vid="PSA 52:1">Tinggwang samkak kelu kenlum au tingnai ramsang gwang la.<verse eid="PSA 52:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 52:2" />Nnui mleu mariemdung kengkap au hegeu pemui nzautau kebam nzwa, mide kecwa ta teibam.<verse eid="PSA 52:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 52:3" />Nnui keyibe swade kesia nnui suila</para>
  <para style="q" vid="PSA 52:3">nah makesangbe swade kenret kerangbe. <char style="qs">Selah</char><verse eid="PSA 52:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 52:4" />Nnui mikedame de teimsia di kela samdung pelane nnui suila,</para>
  <para style="q" vid="PSA 52:4">nnui mleu mide kecwabe.<verse eid="PSA 52:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 52:5" />Cinzwa eh Tinggwang de nnuide kelungta ziemne ngkapdi zie;</para>
  <para style="q" vid="PSA 52:5">pa nnui de ngngwa hang dizie nah paiki gade teu mpet dizie</para>
  <para style="q" vid="PSA 52:5">nah pa keringme deu gade nnuide keugi dizie. <char style="qs">Selah</char><verse eid="PSA 52:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 52:6" />Makesangme liede cide ngau nah hing zie;</para>
  <para style="q" vid="PSA 52:6">penui pecu nui eh rang zie,<verse eid="PSA 52:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 52:7" />“Pielo, mina aipaude Tinggwang de ngngei luma,</para>
  <para style="q" vid="PSA 52:7">dede pa pe mahei kekiee kebam de nlumla,</para>
  <para style="q" vid="PSA 52:7">nah pa au ngkieng pa kedame de ngkap kecudau.”<verse eid="PSA 52:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 52:8" />Dede a ziemne au, Ih au Tinggwang kiga kemdiak Olive bang ge nzwa lie;</para>
  <para style="q" vid="PSA 52:8">Ih Tinggwang samkak kenlum de kelungta nah kelungta nlum lazie.<verse eid="PSA 52:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 52:9" />Ih ncu rünne hetwa peula mui zie nang tei kegai dungde ziemne.</para>
  <para style="q" vid="PSA 52:9">Ih n zi ziemne kwabam zie, kedanemene cide au yi kecune,</para>
  <para style="q" vid="PSA 52:9">ncu kenlum medung kebam gade.<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="s">Keyi ketei migede bam ma</para>
  <para style="d">Kenlang leibungkekwame ziemne; Mahalath ga teleilu. David gu maschil ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 53:1" />Kemieme ge pe nlung gade rangla, “Tinggwang au gah.”</para>
  <para style="q" vid="PSA 53:1">Penui au mau dida nah mingau kenghet kesiadung tei dida;</para>
  <para style="q" vid="PSA 53:1">keyi keteime cika bamsi meda.<verse eid="PSA 53:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 53:2" />Tinggwang tinggim gade pie nghung la minadung de</para>
  <para style="q" vid="PSA 53:2">migede cika pecu cimi cimebi kecu piebam eh,</para>
  <para style="q" vid="PSA 53:2">cauge pecu peeila bi kecu.<verse eid="PSA 53:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 53:3" />Penui pelane nreutet di.</para>
  <para style="q" vid="PSA 53:3">Penui pelane mau bam dida.</para>
  <para style="q" vid="PSA 53:3">Cika hangge de keyi ketei bam meda, hangge de gah.<note caller="+" style="f"><char style="fr" closed="false">53:3 </char><char style="ft" closed="false">Lei. 14:1-3, Rom. 3:10-12</char></note><verse eid="PSA 53:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 53:4" />Kemau tei kelame aidungde made ci lama,</para>
  <para style="q" vid="PSA 53:4">a minadung de penui au tangku ketyei nzwa mnwa kelame</para>
  <para style="q" vid="PSA 53:4">nah penui Tinggwang de qula meni?<verse eid="PSA 53:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 53:5" />Penui kengngi kedi ga bam, ngngi kera pekie bam swa meliede;</para>
  <para style="q" vid="PSA 53:5">kedanemene caugame nnui ramzeuki de renia cuh bi Tinggwang penui radung teizang dizie;</para>
  <para style="q" vid="PSA 53:5">mina cinkenzwa de hengam gage kaidi zie kedanemene Tinggwang penui de pütti da.<verse eid="PSA 53:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 53:6" />Oh, Israel de kelikelu au Zion gade gwang zie!</para>
  <para style="q" vid="PSA 53:6">Tinggwang pe minadung de hebaang ketei gade ngngwa cailigwang kecudau,</para>
  <para style="q" vid="PSA 53:6">iciu cai Jacob pesuiyi dizie nah Israel da suiyibe bam zie!<note caller="+" style="f"><char style="fr" closed="false">53:6 </char><char style="ft" closed="false">Lei. 14:7</char></note><verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="s">RAMPAUBE a teilung teucuh beula</para>
  <para style="d">Kenlang leibungkekwame ziemne; peria ketei leibungdung ga. David gu maschil ge; Ziphime Saul da gwang nah rang eh, “Anui dade David pekatei pecu kebai meni?”</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 54:1" />Acu kelibeulo, Tinggwang, n zi gade,</para>
  <para style="q" vid="PSA 54:1">nah n kengkieng gade acu tiaklu.<verse eid="PSA 54:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 54:2" />A kekie kingneilo, Tinggwang;</para>
  <para style="q" vid="PSA 54:2">a mui gade kepet samdung de ngking gailo.<verse eid="PSA 54:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 54:3" />Kedanemene sangme acu teitsetdi kera renia cuh bam dida,</para>
  <para style="q" vid="PSA 54:3">nah ngaugia kega minadung acu teitset zie lie peeila dida;</para>
  <para style="q" vid="PSA 54:3">penui Tinggwang de penui dwa gage kailu ma. <char style="qs">Selah</char><verse eid="PSA 54:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 54:4" />Pielo, Tinggwang acu kenghabe;</para>
  <para style="q" vid="PSA 54:4">Rampaube acu gumbeu bammui kelabe da.<verse eid="PSA 54:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 54:5" />Tinggwang a ngauraume de kesiabe le ziehi tei beuzie;</para>
  <para style="q" vid="PSA 54:5">n kenlum gade, penuide ngkapdi!<verse eid="PSA 54:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 54:6" />Ih mta mapeu le pwa ncu ratak teibeu zie;</para>
  <para style="q" vid="PSA 54:6">Ih n zi de hetwa peu zie, RAMPAUBE, cide yi kecu ziemne.<verse eid="PSA 54:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 54:7" />Kedanemene keherei leune gade pa acu kelibeu da;</para>
  <para style="q" vid="PSA 54:7">a ngauraume dade ngking kelu a miak le ngau.<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="s">RAMPAUBE dage n püt lwak beula</para>
  <para style="d">Kenlang leibungkekwame ziemne; peria ketei leibungdung ga; David gu Maschil ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 55:1" />A kekie ngking gailo, Tinggwang;</para>
  <para style="q" vid="PSA 55:1">nah a ngaugia kie kegai gade mbai diso.<verse eid="PSA 55:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 55:2" />Acu heling sünne gailo nah acu samkeli lo;</para>
  <para style="q" vid="PSA 55:2">Ih a reidung gade kemtak ga<verse eid="PSA 55:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 55:3" />kedanemene a ngauraumedung kwa de ziemne,</para>
  <para style="q" vid="PSA 55:3">kesiame mide ngau kerau kecu ziemne;</para>
  <para style="q" vid="PSA 55:3">kedanemene penui ada keherei teugwang</para>
  <para style="q" vid="PSA 55:3">nah rata gade acu teikeherei.<verse eid="PSA 55:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 55:4" />Ada a nlung mbeusütti,</para>
  <para style="q" vid="PSA 55:4">nah ketsai kehing de ada bam dida.<verse eid="PSA 55:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 55:5" />Kengngi nah kehing de ada gwang bam dida,</para>
  <para style="q" vid="PSA 55:5">nah mahing kecu ada kepuih teibam dida.<verse eid="PSA 55:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 55:6" />Ih ranggai, “Oh, tamhau ge nzwa a hesiu bam liecai!</para>
  <para style="q" vid="PSA 55:6">Ciu cai Ih lim tetdi zie nah mtak dizie.<verse eid="PSA 55:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 55:7" />Pielo, ciucai Ih kemdei ga tetrwa la dida. Ih renaamkang ga bamdi zie da. <char style="qs">Selah</char><verse eid="PSA 55:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 55:8" />Ih nsiulu kera gage kelwa gai zie</para>
  <para style="q" vid="PSA 55:8">hera tingkai nah kaigui kedi gade.”<verse eid="PSA 55:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 55:9" />Penui de ngkapti lu, Rampaubo, penui samrang teikellu dilu!</para>
  <para style="q" vid="PSA 55:9">Kedanemene Ih namdibe ga keregi nah ngngwa kesia ngaugai.<verse eid="PSA 55:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 55:10" />Penui tingmui tingba tet twagwa kiriedung ga;</para>
  <para style="q" vid="PSA 55:10">kemau nah keherei le tei pui dida.<verse eid="PSA 55:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 55:11" />Kehei gade ma tei kemkap bam;</para>
  <para style="q" vid="PSA 55:11">puidikidung au mide teikeherei nah mide kecwa pe lampui.<verse eid="PSA 55:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 55:12" />Kedanemene acu kesiu kegaime cide a ngauraume ma,</para>
  <para style="q" vid="PSA 55:12">ciucai Ih punglie lubui;</para>
  <para style="q" vid="PSA 55:12">mede acu ngau rau kelabe a reu gade hegie lalie cai,</para>
  <para style="q" vid="PSA 55:12">ciu cai Ih pe dade mbaidi lubui kerane.<verse eid="PSA 55:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 55:13" />Dede cide au nang, Ih siakte mina ge,</para>
  <para style="q" vid="PSA 55:13">a kangngwame nah a zangbe kesangbe.<verse eid="PSA 55:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 55:14" />Anui ngngwa kangbau hemisüt lu;</para>
  <para style="q" vid="PSA 55:14">Anui mina kieesüt eh Tinggwang kiga tet nlüt lu.<verse eid="PSA 55:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 55:15" />Peu ketsai penui da cimezing eh gwanglo;</para>
  <para style="q" vid="PSA 55:15">penui de peu ringbam eh Sheol ga nghung lo,</para>
  <para style="q" vid="PSA 55:15">kedanemene kesiabe au cipau ga penui lungh bam, penui kakga gapte.<verse eid="PSA 55:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 55:16" />A ziemne au, Ih Tinggwang de kengha ziemne quzie,</para>
  <para style="q" vid="PSA 55:16">nah RAMPAUBE acu kelibeu zie.<verse eid="PSA 55:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 55:17" />Tinghegi, tingcang nah tingna dau Ih ncam nah mradi;</para>
  <para style="q" vid="PSA 55:17">Tinggwang a kwa siu zie.<verse eid="PSA 55:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 55:18" />Acu gwaketang kecu hereu gade pa a teilung de kwak eh kelilu zie,</para>
  <para style="q" vid="PSA 55:18">kedanemene acu gwaketang eh regi kelame au kieesüt.<verse eid="PSA 55:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 55:19" />Tinggwang, kelungta hegwang tei kelabe,</para>
  <para style="q" vid="PSA 55:19">penui de siulu zie nah penui de tei ngngam zie. <char style="qs">Selah</char></para>
  <para style="q" vid="PSA 55:19">Penui madaude kedi lama,</para>
  <para style="q" vid="PSA 55:19">nah penui Tinggwang de hing lama.<verse eid="PSA 55:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 55:20" />A zangbe pe ba hwacuh pecu ngngwa kezuyi eh kebamme de mmau di;</para>
  <para style="q" vid="PSA 55:20">pa samkak pe da kebamde de herüt peulu ma.<verse eid="PSA 55:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 55:21" />Pe samdung au maca nzwa mdui süt,</para>
  <para style="q" vid="PSA 55:21">dede pe nlung au mide nkau süt;</para>
  <para style="q" vid="PSA 55:21">pe samdung au macadui swade mnwa,</para>
  <para style="q" vid="PSA 55:21">ciuliede kesangbe au penui kingtiedung keteume.<verse eid="PSA 55:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 55:22" />N reidung RAMPAUBE dage kailu, nah pa ncu teirelui beu zie;</para>
  <para style="q" vid="PSA 55:22">pa kesangme de madaude peu tet ngkoi dilak.<note caller="+" style="f"><char style="fr" closed="false">55:22 </char><char style="ft" closed="false">1 Pet. 5:7, Lei. 37:24</char></note><verse eid="PSA 55:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 55:23" />Dede nang, Tinggwang, kesiame de kengkap hekwaki gage keu nghung dizie;</para>
  <para style="q" vid="PSA 55:23">hejai teilwa keneume nah mide kecwa medung au kedame teilung tie pempie de lungh lak,</para>
  <para style="q" vid="PSA 55:23">dede Ih ncu nlum bamzie.<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="s">Ih Tinggwang de nlumla</para>
  <para style="d">Kenlang leibungkekwame ziemne; Jonath elem rehokim ga teleilu. David gu lei ge. Michtam ge; Philistinme pecu Gath ga ngngwa mie kecudau.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 56:1" />Acu ngau nggia lo, Tinggwang, minadung acu ketang kebam ziemne!</para>
  <para style="q" vid="PSA 56:1">Tingbazie pelane a ngauraume acu teikeherei bamdi delu.<verse eid="PSA 56:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 56:2" />A ngauraume tingbazie pelane acu daucim;</para>
  <para style="q" vid="PSA 56:2">kedanemene penui zaisia eh acu regi ketang kecume kieesüt.<verse eid="PSA 56:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 56:3" />Ih ngngidi kecudau,</para>
  <para style="q" vid="PSA 56:3">Ih a kenlum de n da bam zie.<verse eid="PSA 56:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 56:4" />Tinggwang dage, pe sam Ih hetwa peu kelabe,</para>
  <para style="q" vid="PSA 56:4">Tinggwang da Ih a kenlum kai pwabam; Ih ngngi di lak;</para>
  <para style="q" vid="PSA 56:4">migede acu daige tei lulai?<verse eid="PSA 56:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 56:5" />Tingbazie pelane penui a samdung de teukerui la;</para>
  <para style="q" vid="PSA 56:5">penui kecet pelane kesiabe ziemne acu mmau.<verse eid="PSA 56:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 56:6" />Penui penuikatei gwang ngkwalu la, penui penuikatei mbailu la,</para>
  <para style="q" vid="PSA 56:6">nah penui a pipadung ling la,</para>
  <para style="q" vid="PSA 56:6">penui a teilung kwa kebam de nzwa.<verse eid="PSA 56:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 56:7" />Kemau tei eh penui de peu paktet diso.</para>
  <para style="q" vid="PSA 56:7">N rata gade minadung de teu nghung gailu, Tinggwang.<verse eid="PSA 56:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 56:8" />Ih tetgwang kecudung de nang peeibam</para>
  <para style="q" vid="PSA 56:8">nah a miakduidung n labung gage kailu;</para>
  <para style="q" vid="PSA 56:8">penui n laisiukwak ga bam meni?<verse eid="PSA 56:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 56:9" />Iciu eh Ih ncu qu kegai benai a ngauraume nreu caili dizie;</para>
  <para style="q" vid="PSA 56:9">aide Ih cibam, Tinggwang a ziemne kecu.<verse eid="PSA 56:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 56:10" />Tinggwang gade, pe sam Ih twa kelabe,</para>
  <para style="q" vid="PSA 56:10">RAMPAUBE gade, pe sam Ih twa kelabe,<verse eid="PSA 56:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11" />Tinggwang gade Ih nlum,</para>
  <para style="q" vid="PSA 56:11">Ih ngngi di lak.</para>
  <para style="q" vid="PSA 56:11">Cauge ada dai teilu laino?<verse eid="PSA 56:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 56:12" />Ih sampet keludung n dage a tah teicang gailu kera au ada bam, Tinggwang;</para>
  <para style="q" vid="PSA 56:12">Ih ncu ketwa recadung pwapeu zie.<verse eid="PSA 56:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 56:13" />Kedanemene nang ketsai gade a teilung kelibeu da;</para>
  <para style="q" vid="PSA 56:13">Ih kaudi kera de a pi gi beuda,</para>
  <para style="q" vid="PSA 56:13">ciu eh acu peu Tinggwang dwaga tetlu kerane</para>
  <para style="q" vid="PSA 56:13">keringbe kebaabe ga.<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="s">N kendu kideu pelane reuga lalu</para>
  <para style="d">Kenlang leibungkekwame ziemne; Al Tashheth ga teleilu. David lei ge. Michtam ge; pa Saul dade pak kedi dau, tsupop.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 57:1" />Acu ngaunggia lo, Tinggwang, acu ngaunggia lo,</para>
  <para style="q" vid="PSA 57:1">kedanemene Ih n da msiubam zie kehereidung cangdi kemakta.</para>
  <para style="q" vid="PSA 57:1">Ih acu gumlu kerane n hesiudung kangga bam zie kengkap aide cangdi kemakta.<verse eid="PSA 57:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 57:2" />Hutube Tinggwang dage Ih hap gai zie,</para>
  <para style="q" vid="PSA 57:2">Tinggwang dage, ma pelane a ziemne tei kegaibe.<verse eid="PSA 57:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 57:3" />Tinggwang tinggim gade kengha langgai nah acu kelibeu zie,</para>
  <para style="q" vid="PSA 57:3">acu teikeherei kelame da pe rata bam. <char style="qs">Selah</char></para>
  <para style="q" vid="PSA 57:3">Tinggwang ada keku kehung nah pe kenlum langgai zie.<verse eid="PSA 57:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 57:4" />A teilung au hinghodung kakga bam;</para>
  <para style="q" vid="PSA 57:4">Ih au acu tei ngkapti kera mtei lwe kebamme kakga bam.</para>
  <para style="q" vid="PSA 57:4">Ih au mina penui gei au hengeidung nah lakpidung kenzwame kakga bam,</para>
  <para style="q" vid="PSA 57:4">nah penui mleudung au kingtiedung pemui nzautau.<verse eid="PSA 57:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 57:5" />Ndu kelube teilo, Tinggwang, tinggimdung reu;</para>
  <para style="q" vid="PSA 57:5">n kendu de peu hangdeu pelane reu bamlu.<verse eid="PSA 57:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 57:6" />Ngauraume a pidung ziemne hetak ge teizang gai;</para>
  <para style="q" vid="PSA 57:6">Ih keherei bam di.</para>
  <para style="q" vid="PSA 57:6">Penui hekwaki a dwa gade kuilu.</para>
  <para style="q" vid="PSA 57:6">Penuikatei cipau sumbe ga kaumie di! <char style="qs">Selah</char><verse eid="PSA 57:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 57:7" />A nlung au ntip bam, Tinggwang, a nlung au ntip bam;</para>
  <para style="q" vid="PSA 57:7">Ih lei teizie, yeo, Ih ketwa leidung teizie.<verse eid="PSA 57:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 57:8" />Cuhlwe nraklu, rüt kela a mlung; nrak cuhlu, lute nah leibung; Ih tingnaimiak de nkia luzie.<verse eid="PSA 57:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 57:9" />Ih ncu hetwa peu zie, O a Tinggwang, minadung kakgade;</para>
  <para style="q" vid="PSA 57:9">Heleuhdung kakga de Ih ncu ketwa lei teizie.<verse eid="PSA 57:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 57:10" />Kedanemene n keku kedi au madau gede ga lama;</para>
  <para style="q" vid="PSA 57:10">tinggimdung ga cangla;</para>
  <para style="q" vid="PSA 57:10">nah n masang au ting tung bam.<verse eid="PSA 57:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 57:11" />Ndu kelube teilo, Tinggwang, tinggimdung reu;</para>
  <para style="q" vid="PSA 57:11">n kendu de peu hangdeu pelane reu bamlu.<verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="s">Tinggwang kideube tutiak kelabe</para>
  <para style="d">Kenlang leibungkekwame ziemne; Al Tashheth ga teleilu, David lei ge. Michtam ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 58:1" />Nnui hegwangketeume makesang rangla ni?</para>
  <para style="q" vid="PSA 58:1">Nnui minadung, nnui tutiak kemzuibe teila ni?<verse eid="PSA 58:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 58:2" />Ma, nang nlung gade makesia tei dida;</para>
  <para style="q" vid="PSA 58:2">nang n badung ne hangdeube ga keregi kecu mzibeu dida.<verse eid="PSA 58:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 58:3" />Kesiame tet ngkoidi la penui pe pui za bam kecudau liede;</para>
  <para style="q" vid="PSA 58:3">mnakelu gade penui tet ngkoi dila, kenretdung rangla.<verse eid="PSA 58:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 58:4" />Penui gu heiring au henei gu heiring nzwa;</para>
  <para style="q" vid="PSA 58:4">penui au henam nzwa penui kwen ngketpung bamla,<verse eid="PSA 58:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 58:5" />penui kehemeume kwa de kingnei teune lama,</para>
  <para style="q" vid="PSA 58:5">penui hebaciem keyi leune bam liede.<verse eid="PSA 58:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 58:6" />Penui mui gade penui geidung teipang dilu, Tinggwang;</para>
  <para style="q" vid="PSA 58:6">kehena hinghodung geidung kedi leune teipang dilu, RAMPAUBE.<verse eid="PSA 58:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 58:7" />Penui de dui lwapak kecu nzwa peu suimie dilu;</para>
  <para style="q" vid="PSA 58:7">penui lakpidung kap kegai dau, penuide peu penui mariemdung kegame ge nzwa lu.<verse eid="PSA 58:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 58:8" />Penui de peu nineupui ge nzwa suimie nah lwa tetti lu,</para>
  <para style="q" vid="PSA 58:8">mipui peting kemakne ngena mna eh madaude tingnaimiak ngau kemak nzwa.<verse eid="PSA 58:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 58:9" />N lidung hetu ruheu eh lum kecu ci kemakne dwage,</para>
  <para style="q" vid="PSA 58:9">pa tingkai nzetsüt kecu gene cidungde keuteu pwa dizie, kemdiak hetudung de nah hetudung ruheu kebam de nzwa.<verse eid="PSA 58:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 58:10" />Makesangme Tinggwang hekum peei kecu ngau lwe penui suiyi zie;</para>
  <para style="q" vid="PSA 58:10">pa kesiame jai gade pe pidung hui zie,<verse eid="PSA 58:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 58:11" />ciu eh minadung rang zie, “Kesangsiakpe, makesangme ziemne cika au ziehi bam;</para>
  <para style="q" vid="PSA 58:11">kesanglie kideube tutiak kelabe Tinggwang au bamlie.”<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="s">A ngauraume dade acu kelibeulo</para>
  <para style="d">Kenlang leibungkekwame ziemne; Al Tashheth ga teleilu. David gu lei ge. Michtam ge; Saul langkegai dau, nah penui pecu teitset kera heki de pie.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 59:1" />A ngauraumedung dade acu kelibeu lo, a Tinggwang;</para>
  <para style="q" vid="PSA 59:1">acu renia cuh kecume dade acu teu cehu beulo.<verse eid="PSA 59:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 59:2" />Kemau ta keteime dade acu keli pwapeu lo,</para>
  <para style="q" vid="PSA 59:2">nah hejai teilwa neu kelame dade acu kelibeu.<verse eid="PSA 59:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 59:3" />Kedanemene, pielo, penui a teilung de keu kerane mbai eh kwabam.</para>
  <para style="q" vid="PSA 59:3">Kengking minadung penuikatei penui gwang ngkwa eh acu gwaketang,</para>
  <para style="q" vid="PSA 59:3">dede Ih kesia tatei mede kemau tei kedi ziemne ma, RAMPAUBO.<verse eid="PSA 59:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 59:4" />Ih mau me liede penui acu mmau gai kera nteibam di;</para>
  <para style="q" vid="PSA 59:4">nraklu nah acu nghalu nah pielu.<verse eid="PSA 59:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 59:5" />Nang, RAMPAUBE reugwame reu Tinggwang, Israelme Tinggwang,</para>
  <para style="q" vid="PSA 59:5">cuhlu eh heleuhdung pelane de saja peugai;</para>
  <para style="q" vid="PSA 59:5">kesia kemau ta keteime de ngaunggia so. <char style="qs">Selah</char><verse eid="PSA 59:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 59:6" />Ngauraume tinghegi dau cailigwang, penui heteudung nzwa hap nrung di</para>
  <para style="q" vid="PSA 59:6">nah namdibe ga twagwa ladi.<verse eid="PSA 59:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 59:7" />Pielo, penui muile mide rang kemsia nah keheu kecu sam kingnei gailo;</para>
  <para style="q" vid="PSA 59:7">kingtiedung au penui muileu ga bam,</para>
  <para style="q" vid="PSA 59:7">kedanemene penui rang eh, “Cau anuide siu luno?”<verse eid="PSA 59:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 59:8" />Dede nang, RAMPAUBE, penuide nuibam;</para>
  <para style="q" vid="PSA 59:8">nang nlum kemak heleuhdung pelane de nuineu bam.<verse eid="PSA 59:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 59:9" />Tinggwang, a kengkingbe, Ih ncu a lung pelane peuzie;</para>
  <para style="q" vid="PSA 59:9">nang au a tsukwa kehube.<verse eid="PSA 59:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 59:10" />A Tinggwang pe samkakkelu samsang le acu dau zie;</para>
  <para style="q" vid="PSA 59:10">Tinggwang a hengim de peu a ngauraume dade ngaulu zie.<verse eid="PSA 59:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 59:11" />Penui de teitset diso, mecai a minadung nsungta dizie.</para>
  <para style="q" vid="PSA 59:11">N kengkieng le penui de teizang dilu nah penui de teingkau dilu, Rampaube anuide kegumbe.<verse eid="PSA 59:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 59:12" />Penui muidung maudung nah penui muileukungdung gu samdung ziemne,</para>
  <para style="q" vid="PSA 59:12">penui hegie kelade ne peu penuide tuiteu dilu,</para>
  <para style="q" vid="PSA 59:12">nah resetdung nah kenretdung penui rangkegai de ziemne.<verse eid="PSA 59:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 59:13" />Lunghop gade penui de mnwa dilu, penui de mnwa dilu ciu de penui bamsi tadi lu kerane;</para>
  <para style="q" vid="PSA 59:13">Tinggwang Jacob da hegwang tei kecu peu penuide cilu</para>
  <para style="q" vid="PSA 59:13">nah kideube penli ga kecang. <char style="qs">Selah</char><verse eid="PSA 59:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 59:14" />Tinghegidau penui cailigwang,</para>
  <para style="q" vid="PSA 59:14">heteudung nzwa namdibe twagwa eh hap mrung di.<verse eid="PSA 59:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 59:15" />Penui taktyeipok peei eh lu aika rwala</para>
  <para style="q" vid="PSA 59:15">nah penui mnunglu mecai penui heteu nzwa mra la.<verse eid="PSA 59:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 59:16" />Dede Ih n kengkieng ha teu lei teizie,</para>
  <para style="q" vid="PSA 59:16">nah tingcang dau n keku bammui kela ha teu Ih lei teizie!</para>
  <para style="q" vid="PSA 59:16">Kedanemene nang agu tsukwa kehu ge kecune</para>
  <para style="q" vid="PSA 59:16">nah Ih keherei kelu benai a kemsiube.<verse eid="PSA 59:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 59:17" />N dage, a kengkingbe, Ih lei tei twa zie;</para>
  <para style="q" vid="PSA 59:17">kedanemene Tinggwang a tsukwa kehube, samkak kelu kesamsang Tinggwang.<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="s">Pa anui ngauraume de dauciem dizie</para>
  <para style="d">Kenlang leibungkekwame ziemne; Shushan Eduth ga teleilu. David gu Michtam ge, ledeu kerane. Pa Aram Naharaim nah Aram Zobah de ngngwa keregi kecudau, nah Joab cailigwang nah Mcai Langkam gade Edomme cang kereiehkena de teitsetti.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 60:1" />Tinggwang, nang anui de kelien gi dida; anui de gumpwa kebam ga nang teipang nlüt;</para>
  <para style="q" vid="PSA 60:1">nang nrata bam di; anui de teiheci dailo.<verse eid="PSA 60:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 60:2" />Nang hangdeube de teumlai dida; nang cide teurak dida;</para>
  <para style="q" vid="PSA 60:2">pe lungreidung de teingkei beu, cide nlak kebam ziemne.<verse eid="PSA 60:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 60:3" />Nang n minadung de teikepa dungde peu ngau gai;</para>
  <para style="q" vid="PSA 60:3">nang anuide tet ngkoidi kela zau peu sak.<verse eid="PSA 60:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 60:4" />Ncu rüt kelame ziemne,</para>
  <para style="q" vid="PSA 60:4">nang pailim ge teleilu</para>
  <para style="q" vid="PSA 60:4">lakpi pungkelame de keulia lu kerane. <char style="qs">Selah</char><verse eid="PSA 60:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 60:5" />Ciciu eh nang hung kelame de kelilu kerane,</para>
  <para style="q" vid="PSA 60:5">n ba zetle ne anuide kelilu nah acu keligai.<verse eid="PSA 60:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 60:6" />Tinggwang pe kemcibe gade ranggai, “Ih a suiyi zie;</para>
  <para style="q" vid="PSA 60:6">Ih Shechem namdi de mzi dizie nah Succoth Langkam de keumpet ntsam dizie.<verse eid="PSA 60:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 60:7" />Gilead deudi au agu; nah Manasseh deudi au agu;</para>
  <para style="q" vid="PSA 60:7">Ephraim deudi liede a peucum;</para>
  <para style="q" vid="PSA 60:7">Judah deudi au agu tuitie.<verse eid="PSA 60:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 60:8" />Moab deudi au agu makehuikwak;</para>
  <para style="q" vid="PSA 60:8">Edomme de Ih a picum le beuzie<note caller="+" style="f"><char style="fr" closed="false">60:8 </char><char style="ft" closed="false">cide agu le kecu keulia kerane</char></note>;</para>
  <para style="q" vid="PSA 60:8">Ih ngkieng kelu gade sahbak gai zie Philistia ziemne.”<verse eid="PSA 60:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 60:9" />Kengkieng namdibe ga caune acu ngngwa gwang lai?</para>
  <para style="q" vid="PSA 60:9">Caune acu Edom ga teuswa tet lai?<verse eid="PSA 60:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 60:10" />Dede nang, Tinggwang, nang anuide püt dide meni?</para>
  <para style="q" vid="PSA 60:10">Nang anui reugwame de ngngwa hereuketei ga mie ma.<verse eid="PSA 60:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 60:11" />Ngauraume dade anuide ngha beulo,</para>
  <para style="q" vid="PSA 60:11">kedanemene mina ngha au kemta.<verse eid="PSA 60:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 60:12" />Tinggwang kengha gade anui ngkieng luzie;</para>
  <para style="q" vid="PSA 60:12">pa anui ngauraumedung de daucim ngkau dizie.<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="s">Tsura gage acu sau gailo</para>
  <para style="d">Kenlang leibungkekwame ziemne; peria ketei leibung ge ga. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 61:1" />Siulo Ih hap kegaide, Oh Tinggwang;</para>
  <para style="q" vid="PSA 61:1">a kekie kingneilo.<verse eid="PSA 61:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 61:2" />Hangdeu penli gade Ih ncu qu zie a nlung pang kedidau;</para>
  <para style="q" vid="PSA 61:2">aswa de kehu tangtsu gage acu ngngwa mie gailo.<verse eid="PSA 61:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 61:3" />Kedanemene nang aziemne au msiu ge kecune,</para>
  <para style="q" vid="PSA 61:3">ngauraume dade kengkieng tsukwa<note caller="+" style="f"><char style="fr" closed="false">61:3 </char><char style="fq" closed="false">Kengkieng tsukwa: </char><char style="ft" closed="false">Pe teilung caide pe leuhme ne pe hegwangbam pwaleu jüja ladi kecu.</char></note> ge.<verse eid="PSA 61:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 61:4" />N paiki ga acu peu kelungta lungh lo!</para>
  <para style="q" vid="PSA 61:4">N hesiudung kangga acu peu msiu lo. <char style="qs">Selah</char><verse eid="PSA 61:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 61:5" />Kedanemene nang, Tinggwang, a sampetdung siu luda,</para>
  <para style="q" vid="PSA 61:5">n zi de herüt peu kelame qwa nang acu mapwa peuda.<verse eid="PSA 61:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 61:6" />Hegwangpei teilung nang teintie beuzie;</para>
  <para style="q" vid="PSA 61:6">pe mmi ceheudung kekieege nzwa zie.<verse eid="PSA 61:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 61:7" />Pa Tinggwang dwaga kelungta bam dizie.<note caller="+" style="f"><char style="fr" closed="false">61:7 </char><char style="ft" closed="false">Oh Tinggwang, n keku nah kesamsang bam mui kela dele pecu gum beulo.</char></note><verse eid="PSA 61:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 61:8" />Ih lei tei n zi twa lamui zie</para>
  <para style="q" vid="PSA 61:8">ciu eh Ih a sampetdung de tingba ramsangne teilu kerane.<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="s">A Tinggwang rünne kwabam</para>
  <para style="d">Kenlang leibungkekwame ziemne; Jeduthun gu zaireli de cia. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 62:1" />Tinggwang de rünne Ih zingde eh kwabam;</para>
  <para style="q" vid="PSA 62:1">a kelikelu au pe dade gwang.<verse eid="PSA 62:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 62:2" />Pa rünne agu tangtsu nah acu kelikelube;</para>
  <para style="q" vid="PSA 62:2">pa au agu tsukwa kehube; Ih madaude ngamdi lak.<verse eid="PSA 62:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 62:3" />Dai tiege, nnui pelane, mina ge de ketang zie no,</para>
  <para style="q" vid="PSA 62:3">ciu eh nang pecu cwadi lu kerane</para>
  <para style="q" vid="PSA 62:3">kengngei tangdeu mede mlak kebam hegurieta ge nzwa?<verse eid="PSA 62:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 62:4" />Penui pe dade pa hetwakepeu heni gade teu nghungdi kera rünsangne peda resiu gai;</para>
  <para style="q" vid="PSA 62:4">penui kenretdung rang neu la;</para>
  <para style="q" vid="PSA 62:4">penui muidung gade au penui pecu samlam beu, dede penui mlungdung gade au penui pecu reset gai. <char style="qs">Selah</char><verse eid="PSA 62:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 62:5" />Tinggwang de rünne Ih zingde eh kwabam;</para>
  <para style="q" vid="PSA 62:5">a keregui pe dage kaipwa kebam ziemne.<verse eid="PSA 62:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 62:6" />Pa rünne agu tangtsu nah acu kelikelube;</para>
  <para style="q" vid="PSA 62:6">pa au agu tsukwa kehube; Ih madaude ngamdi dilak.<verse eid="PSA 62:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 62:7" />A kelikelu nah a kendu au Tinggwang da bam;</para>
  <para style="q" vid="PSA 62:7">Tinggwang acu gum kela kengkieng be nah a kemsiube.<verse eid="PSA 62:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 62:8" />Peting pelane Tinggwang de nlum bamlu, nnui minadung;</para>
  <para style="q" vid="PSA 62:8">pe dwa gage n nlung de sau gailu;</para>
  <para style="q" vid="PSA 62:8">Tinggwang au anuide kegumbe. <char style="qs">Selah</char><verse eid="PSA 62:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 62:9" />Mipeidung pelane de kenretla, nah mipeidung kedime de nah keceume de kemta;</para>
  <para style="q" vid="PSA 62:9">kemdetdung gade penui au mcala dizie;</para>
  <para style="q" vid="PSA 62:9">ngngwa mdet ncütle, penui au ngicui ge swade perüt mcaki.<verse eid="PSA 62:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 62:10" />Mide teikeherei mede kerega de nlum so;</para>
  <para style="q" vid="PSA 62:10">nah maheidung de suisam tei eh keregui bam so,</para>
  <para style="q" vid="PSA 62:10">kedanemene penui petsi bui lak; n nlung penui da kai pwabam diso.<note caller="+" style="f"><char style="fr" closed="false">62:10 </char><char style="ft" closed="false">Mat. 19:21-22, 1 Tim. 6:17</char></note><verse eid="PSA 62:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 62:11" />Tinggwang piage ranggai,</para>
  <para style="q" vid="PSA 62:11">Ih aide piana siuda:</para>
  <para style="q" vid="PSA 62:11">kengkieng au Tinggwang da bam.<verse eid="PSA 62:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 62:12" />Ncu de liede, Rampaube, samkak kelu kesamsangbe la,</para>
  <para style="q" vid="PSA 62:12">kedanemene penui tei kegai nzüt gade nang mina pelane ziehi tei beula.<note caller="+" style="f"><char style="fr" closed="false">62:12 </char><char style="ft" closed="false">Dan. 9:9, Mat. 16:27, Rom. 2:6, Keu. 22:12</char></note><verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="s">A Rabe ncu hengin bam</para>
  <para style="d">David gu lei ge, pa Judah hetaideu ga keladau.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 63:1" />Tinggwang, nang au a Tinggwang! Ih alung kaisüt eh ncu peei la,</para>
  <para style="q" vid="PSA 63:1">a rabe n ziemne hereu bam, nah a pumteih ncu hengin bam,</para>
  <para style="q" vid="PSA 63:1">hangdeu cika dui gah eh cangh kecuga.<verse eid="PSA 63:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 63:2" />Cine Ih ncu kerecaki ga piegai,</para>
  <para style="q" vid="PSA 63:2">n kengkieng nah n kendu de pie kerane.<verse eid="PSA 63:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 63:3" />Kedanemene n samkak kelu kesamsang au teilung swade yiki,</para>
  <para style="q" vid="PSA 63:3">a muileu ncu twa zie.<verse eid="PSA 63:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 63:4" />Cine Ih lungh kebam dau Ih ncu samlam zie;</para>
  <para style="q" vid="PSA 63:4">Ih n zi gade a badung hwacuh zie.<verse eid="PSA 63:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 63:5" />Taktyei keyi cide Ih tyei eh mnung luzie;</para>
  <para style="q" vid="PSA 63:5">Ih a muile suiyi lei tei ncu twa zie,<verse eid="PSA 63:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 63:6" />Ih a zeulie gade ncu mning kegai dau</para>
  <para style="q" vid="PSA 63:6">nah tingmui tingdau ncu cet ncuksüt gai.<verse eid="PSA 63:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 63:7" />Kedanemene nang acu kenghabe,</para>
  <para style="q" vid="PSA 63:7">nah n hesiu miekang gade Ih a suiyi la.<verse eid="PSA 63:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 63:8" />Ih ncu ngngei bamla;</para>
  <para style="q" vid="PSA 63:8">n ba zetle acu ngha beula.<verse eid="PSA 63:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 63:9" />Dede a teilung teingkap kera peei kelame</para>
  <para style="q" vid="PSA 63:9">hangdeu ngkangtube setdung<note caller="+" style="f"><char style="fr" closed="false">63:9 </char><char style="fq" closed="false">Hangdeu ngkangtube setdung </char><char style="ft" closed="false">Sheol-ketsai deu.</char></note> ga nghung zie;<verse eid="PSA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10" />penuide kiengtie keteume ba reu gage balie gaibeu dizie,</para>
  <para style="q" vid="PSA 63:10">nah penui maiserungdung gu taktyei ge dizie.<verse eid="PSA 63:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 63:11" />Dede hegwangpei Tinggwang da pe suiyi dizie;</para>
  <para style="q" vid="PSA 63:11">Tinggwang zi gade sampet kelu mileune pecule pwa hegie dizie,</para>
  <para style="q" vid="PSA 63:11">dede kenretdung rang kelame muidung ngkui ciak dizie.<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="s">Kenlienme dade acu pwakebai beulo</para>
  <para style="d">Kenlang leibungkekwame ziemne. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 64:1" />A kwa ngkinglo, Tinggwang, a ncam kingnei gailo;</para>
  <para style="q" vid="PSA 64:1">a ngauraume dade kengngi gade acu kelibeu lo.<verse eid="PSA 64:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 64:2" />Kesiaketeime ngkim eh mariem kebam gade acu kebai beulo,</para>
  <para style="q" vid="PSA 64:2">kesia keteime acu tei kebwak kebam gade.<verse eid="PSA 64:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 64:3" />Penui au kingtiedung nzwa penui mleu tui mzau pwabam;</para>
  <para style="q" vid="PSA 64:3">penui lakpitsidung gaa pwabam dida, kekaabe samdung,<verse eid="PSA 64:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 64:4" />ciu eh penui kengkim ni gade mina maukemakme de kaplu kerane;</para>
  <para style="q" vid="PSA 64:4">penui zette pecu kapgai nah magede hing ma.<verse eid="PSA 64:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 64:5" />Kesia mariem ga penuikatei penuilung teimdi lula;</para>
  <para style="q" vid="PSA 64:5">hetakdung tei kerane penui ngkim eh mpau ncütla la;</para>
  <para style="q" vid="PSA 64:5">penui rang eh, “Cau anui de ngau zie no?”<verse eid="PSA 64:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 64:6" />Penui kemau ciem rim ndeulu;</para>
  <para style="q" vid="PSA 64:6">“Anui teicang luda,” penui rang eh, “riem sünne keluge.”</para>
  <para style="q" vid="PSA 64:6">Helungbe kecet nah mina mlungdung au cuksüt.<verse eid="PSA 64:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 64:7" />Dede Tinggwang penui de kap zie;</para>
  <para style="q" vid="PSA 64:7">zette pe lakpitsidung ne penui de rezam dizie.<verse eid="PSA 64:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 64:8" />Penui de peu kaudi kera tei gaidi zie, kedanemene penui mleudung de penui de mmau bam;</para>
  <para style="q" vid="PSA 64:8">penui de ngau kecume leune penui peudung mlai dizie.<verse eid="PSA 64:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 64:9" />Mina pelane ngngi dizie</para>
  <para style="q" vid="PSA 64:9">nah Tinggwang tei kegaidung ndu zie.</para>
  <para style="q" vid="PSA 64:9">Penui mriaksüt eh pa tei kegaidung cet zie.<verse eid="PSA 64:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 64:10" />Makesangme RAMPAUBE da suiyi bam zie nah pe da msiu lu zie;</para>
  <para style="q" vid="PSA 64:10">helung kemzuime pelane pe dade hegie luzie.<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="s">O Tinggwang anuide kelikelu</para>
  <para style="d">Kenlang leibungkekwame ziemne. Lei ge. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 65:1" />N ziemne, Zion namdi ga Tinggwang, anui ketwa kwabam;</para>
  <para style="q" vid="PSA 65:1">anui samkak de n dage teugwang cangzie.<verse eid="PSA 65:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 65:2" />Nang kekie kingneikelabe,</para>
  <para style="q" vid="PSA 65:2">n da pumteihbe pelane gwang zie.<note caller="+" style="f"><char style="fr" closed="false">65:2 </char><char style="ft" closed="false">Bat. 10:34-35, Isa. 66:23</char></note><verse eid="PSA 65:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 65:3" />Kesiabedung anui reuga kiee reureu zeu;</para>
  <para style="q" vid="PSA 65:3">anui teimau kedidung ziemne, nang penui mau gibeu zie.<verse eid="PSA 65:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 65:4" />Nang n da ngngwa gwang nna kera kedet kelube au samlam pung</para>
  <para style="q" vid="PSA 65:4">ciu eh pa n kigu ga lungh kerane.</para>
  <para style="q" vid="PSA 65:4">N ki keyidung ziemne anui mnung lu zie,</para>
  <para style="q" vid="PSA 65:4">n kemci kerecaki.<verse eid="PSA 65:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 65:5" />Kesangbe gade nang heta keyidung tei eh anuide keli gaizie,</para>
  <para style="q" vid="PSA 65:5">anuide kelikebeube Tinggwang;</para>
  <para style="q" vid="PSA 65:5">kideube penlidung leune kereguibe au nang</para>
  <para style="q" vid="PSA 65:5">nah jaaidi kemdei ga kebamme ziemne.<verse eid="PSA 65:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 65:6" />Kedanemene lamlwadung tei ntip kebamme au nang,</para>
  <para style="q" vid="PSA 65:6">kengkieng le kang kelube au nang.<verse eid="PSA 65:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 65:7" />Jaaididung nra kwa de teinkam di kelabe au nang,</para>
  <para style="q" vid="PSA 65:7">penui duicuidung kwa de,</para>
  <para style="q" vid="PSA 65:7">nah minadung gu mra kwadung.<note caller="+" style="f"><char style="fr" closed="false">65:7 </char><char style="ft" closed="false">Mat. 8:26, Isa. 17:12-13</char></note><verse eid="PSA 65:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 65:8" />Kideu tu gadung kelunghme au nang tei kegaidung de hing eh lala;</para>
  <para style="q" vid="PSA 65:8">nang naimiak kepetle nah naimiak kenlütle de suiyi peu la.<verse eid="PSA 65:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 65:9" />Nang kideube de ngha kerane gwang; nang duirui gai;</para>
  <para style="q" vid="PSA 65:9">nang cide tei ngkiee süt beu;</para>
  <para style="q" vid="PSA 65:9">Tinggwang reuki au dui puiting bam;</para>
  <para style="q" vid="PSA 65:9">nang kideube telei kegai dau nang minadung de meibui pwapeu.<verse eid="PSA 65:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 65:10" />Tangdei pu kelu ga nang dui kai ngkiee süt beu;</para>
  <para style="q" vid="PSA 65:10">pu kelu pepeudung de nang tei nsam beula;</para>
  <para style="q" vid="PSA 65:10">nang cide tingrui dui ne tei mnwa beula;</para>
  <para style="q" vid="PSA 65:10">nang penui kakga mei keceudung samlam gai beula.<verse eid="PSA 65:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 65:11" />N zai keyi de luhtüt keyi dai kenzwa ge peu lano,</para>
  <para style="q" vid="PSA 65:11">nah nang kemie leu ga mahei lula.<verse eid="PSA 65:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 65:12" />Hetaideu ga ceheidung hezim ne zau bam,</para>
  <para style="q" vid="PSA 65:12">nah lamlwadung de suiyi ne kezui pwabam.<verse eid="PSA 65:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 65:13" />Ceheidung de kaune haudung ne kezui pwabam;</para>
  <para style="q" vid="PSA 65:13">meibui ne chabakdung reu liede kezui pwabam;</para>
  <para style="q" vid="PSA 65:13">penui suiyi ziemne sahbak, nah penui lei tei.<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="s">N Batadung miswakegah zulie</para>
  <para style="d">Kenlang leibungkekwame ziemne. Lei ge, ketwalei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 66:1" />Kideu pelane, Tinggwang da suiyi kwa tei gai;<verse eid="PSA 66:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 66:2" />Pezi kendu lei tei pet gai;</para>
  <para style="q" vid="PSA 66:2">pe hetwa kendu teigai.<verse eid="PSA 66:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 66:3" />Tinggwang dage rang eh, “N tadung au daikenzwa ge gede hing no!</para>
  <para style="q" vid="PSA 66:3">N kengkieng kedi ziemne n ngauraumedung nda keumie zie.<verse eid="PSA 66:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 66:4" />Kideu pelane ncu reca zie</para>
  <para style="q" vid="PSA 66:4">nah nda lei teigai zie;</para>
  <para style="q" vid="PSA 66:4">penui n zi de ketwalei teizie.” <char style="qs">Selah</char><verse eid="PSA 66:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 66:5" />Gwang eh pielo Tinggwang batadung;</para>
  <para style="q" vid="PSA 66:5">minadung dage pe batadung pa tei kegai au ngau kehing ge.<verse eid="PSA 66:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 66:6" />Tinggwang Kegie Jaaidi de hangdeu kecang ge teidi;</para>
  <para style="q" vid="PSA 66:6">penui hepi le kereuki tetkah gwang;</para>
  <para style="q" vid="PSA 66:6">cika anui peda renga bamla.<verse eid="PSA 66:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 66:7" />Pa pe kengkieng ne kelungta kedih teigwang;</para>
  <para style="q" vid="PSA 66:7">pe miak heleuhdung de pieling bam;</para>
  <para style="q" vid="PSA 66:7">Peu migede de penuide kemmau tei diso. <char style="qs">Selah</char><verse eid="PSA 66:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 66:8" />Tinggwang de samlam peu lu, nnui minadung,</para>
  <para style="q" vid="PSA 66:8">pecu hetwa kepeu kwa de peu siu lo.<verse eid="PSA 66:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 66:9" />Pa anui de keringme kak gage kainzeu,</para>
  <para style="q" vid="PSA 66:9">nah pa anui pidung de peu dauzeu kera peu lama.<verse eid="PSA 66:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 66:10" />N ziemne, Tinggwang, anui de kedei pie;</para>
  <para style="q" vid="PSA 66:10">rangkanggeu kedei pie kegai nzwa nang anui de kedei pie.<note caller="+" style="f"><char style="fr" closed="false">66:10 </char><char style="ft" closed="false">1 Pet. 1:7, Isa. 48:10</char></note><verse eid="PSA 66:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 66:11" />Nang anui de helang ge ga ngngwa gai;</para>
  <para style="q" vid="PSA 66:11">nang anui caidung ga hepüt kerüt ge kaigai.<verse eid="PSA 66:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 66:12" />Nang anui peudung reu ga peu minadung de tet nggwa;</para>
  <para style="q" vid="PSA 66:12">anui mih nah dui de tetka gwang,</para>
  <para style="q" vid="PSA 66:12">dede nang anui de heni kemza gage ngngwa mpet beu.<verse eid="PSA 66:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 66:13" />Ih n kiga keru recadung teu eh gwang zie;</para>
  <para style="q" vid="PSA 66:13">Ih a sampetdung ncu rui beu zie<verse eid="PSA 66:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 66:14" />a muileukung ne sampet kegai</para>
  <para style="q" vid="PSA 66:14">nah Ih teei keherei kebam dau a mui gade rang kegaide.<verse eid="PSA 66:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 66:15" />Ih makaunedung pelui keyibe teu ncu keru recadung pwapeu zie</para>
  <para style="q" vid="PSA 66:15">meurünseudung perim kehengui teu eh;</para>
  <para style="q" vid="PSA 66:15">Ih hetumseudung nah hemeudung pwapeu zie. <char style="qs">Selah</char><verse eid="PSA 66:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 66:16" />Gwang eh kingnei lu, nnui pelane Tinggwang de hing kelame,</para>
  <para style="q" vid="PSA 66:16">nah pa a keringria ziemne tei kegai Ih ndugai zie.<verse eid="PSA 66:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 66:17" />Ih a mui le pe dage hap gai,</para>
  <para style="q" vid="PSA 66:17">nah a mleu le pecu hetwa peugai.<verse eid="PSA 66:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 66:18" />Ih a nlung gade kemau ngaulu liecai,</para>
  <para style="q" vid="PSA 66:18">Rampaube a kekie kingneibeu tadi lubui.<note caller="+" style="f"><char style="fr" closed="false">66:18 </char><char style="ft" closed="false">Jhn. 9:31, Mac. 15:29</char></note><verse eid="PSA 66:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 66:19" />Dede Tinggwang siu kesang lu da;</para>
  <para style="q" vid="PSA 66:19">pa sünne eh a kekie kwa kingnei beuda.<verse eid="PSA 66:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 66:20" />Samlam Tinggwang da bamlu,</para>
  <para style="q" vid="PSA 66:20">a kekie</para>
  <para style="q" vid="PSA 66:20">mede pe samkak kesamsangbe ada de teunreu dila kemakpe.<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="s">Anui reuga n zu baa gailo</para>
  <para style="d">Kenlang leibungkekwame ziemne; peria ketei leibung ge ga. Ketwalei ge, lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 67:1" />Tinggwang de peu anuide ngaunggia nah anuide samlam lo</para>
  <para style="q" vid="PSA 67:1">nah pe zu anui da baa pet kera peulo <char style="qs">Selah</char><verse eid="PSA 67:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 67:2" />ciciu de n zaidung kideube cilu kerane,</para>
  <para style="q" vid="PSA 67:2">n kelikelu heleuhdung pelane kakga.<note caller="+" style="f"><char style="fr" closed="false">67:2 </char><char style="ft" closed="false">Luk. 2:30-31, Tit. 2:11</char></note><verse eid="PSA 67:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 67:3" />Peu minadung de ncu hetwa peulo, Tinggwang;</para>
  <para style="q" vid="PSA 67:3">peu minadung de ncu hetwa peulo.<verse eid="PSA 67:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 67:4" />Oh, heleuhdung de peu pe sui yilu nah suiyi ziemne lei teigai,</para>
  <para style="q" vid="PSA 67:4">kedanemene nang kemzuibe teu minadung tutiak zie</para>
  <para style="q" vid="PSA 67:4">nah kideu ga heleuhdung reu kedi teu zie. <char style="qs">Selah</char><verse eid="PSA 67:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 67:5" />Peu minadung de ncu hetwa peulo, Tinggwang;</para>
  <para style="q" vid="PSA 67:5">peu minadung de ncu hetwa peulo.<verse eid="PSA 67:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 67:6" />Kideube pe meilüt peuda</para>
  <para style="q" vid="PSA 67:6">nah Tinggwang, anui Tinggwang, anuide samlam beuda.<verse eid="PSA 67:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 67:7" />Tinggwang anuide samlam beu da,</para>
  <para style="q" vid="PSA 67:7">nah kideube penlidung pelane pecu herüt peu.<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="s">Tinggwang pe ngauraume de teizang dizie</para>
  <para style="d">Kenlang leibungkekwame ziemne, David gu lei ge, lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 68:1" />Tinggwang depeu cuhlu; pe ngauraumedung de peu zangra di;</para>
  <para style="q" vid="PSA 68:1">pecu ngkau kelame de liede peu pe dwa gade pak dila.<verse eid="PSA 68:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 68:2" />Mika de guipung tetti kela nzwa, penuide de mzia dilu;</para>
  <para style="q" vid="PSA 68:2">mi dwa gade maca lwadi kela nzwa,</para>
  <para style="q" vid="PSA 68:2">ciu eh kesiame de peu Tinggwang dwa gade ngkap dilu.<verse eid="PSA 68:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 68:3" />Dede kesangme de peu pesuiyi lu; Tinggwang dwa gade peu penui suiyi süt lu;</para>
  <para style="q" vid="PSA 68:3">penui de peu renga nah suiyisüt bamlu.<verse eid="PSA 68:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 68:4" />Tinggwang da lei teilu! Lei tei pezi twalu!</para>
  <para style="q" vid="PSA 68:4">Jordan Reuki langkam ga langkiedung ga tetka gwang kecube de twalu!</para>
  <para style="q" vid="PSA 68:4">Pe zi au RAMPAUBE! Renga bamlu pe dwaga de!<verse eid="PSA 68:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 68:5" />Pa au pe pei kegahme pei, hemipuidung de gumbeu kelabe,</para>
  <para style="q" vid="PSA 68:5">Tinggwang au pa lungh kebam kemci ni<note caller="+" style="f"><char style="fr" closed="false">68:5 </char><char style="fq" closed="false">Kemci ni </char><char style="ft" closed="false">Tinggim</char></note> ga bam<verse eid="PSA 68:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 68:6" />Tinggwang peki kegaime de lungh kera ki peula;</para>
  <para style="q" vid="PSA 68:6">pa lei tei eh hebaangme dungde ngngwa mpet;</para>
  <para style="q" vid="PSA 68:6">dede hangdeu kecangh ga ngngwa kesia bamla.<verse eid="PSA 68:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 68:7" />Tinggwang, nang n minadung dwaga tetpet kecudau,</para>
  <para style="q" vid="PSA 68:7">nang hetaideu ga tetka kegwang dau, <char style="qs">Selah</char><verse eid="PSA 68:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 68:8" />Kideube mbeu di;</para>
  <para style="q" vid="PSA 68:8">Tinggwang kebam ga tinggimdung liede tingrui gai,</para>
  <para style="q" vid="PSA 68:8">Tinggwang kebam gade pa Sinai ga kegwang dau, Tinggwang kebam ga, Israelme Tinggwang.<note caller="+" style="f"><char style="fr" closed="false">68:8 </char><char style="ft" closed="false">Heb. 12:26, Tut. 5:4-5</char></note><verse eid="PSA 68:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 68:9" />Nang, Tinggwang, tingrui kekieege langgai;</para>
  <para style="q" vid="PSA 68:9">nang n mapwa de tei ngkieng beu cide keherei kebam dau.<verse eid="PSA 68:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 68:10" />N minadung cika lungh;</para>
  <para style="q" vid="PSA 68:10">Nang, Tinggwang, n keyidung gade kegahme de peu.<verse eid="PSA 68:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 68:11" />Rampaube ne ajadungde kaibeu,</para>
  <para style="q" vid="PSA 68:11">nah penui dage reci ndulia kegaime au reugwa kenlangme.<verse eid="PSA 68:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 68:12" />Ngauraume gwangpeidung nah penui reugwame, penui pakdi,</para>
  <para style="q" vid="PSA 68:12">nah mipuidung kilung ga kwa kebamme sütkelu de mzi lu:<verse eid="PSA 68:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 68:13" />tamhaudung rangkanggeu ne kezuilu</para>
  <para style="q" vid="PSA 68:13">hesiudung kecak kenzim ge.</para>
  <para style="q" vid="PSA 68:13">Nnui mina kangge meurünkidung kakga bam kecudau, nnui daitei eh cide teino?<verse eid="PSA 68:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 68:14" />Ngkiengtube Tinggwang ne hegwangmedung de teizang gai,</para>
  <para style="q" vid="PSA 68:14">cide au Zalmon Lamlwa ga buising kei kegai nzwada.<verse eid="PSA 68:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 68:15" />Kengking lamlwatu au Bashan kideutu deudi deda;</para>
  <para style="q" vid="PSA 68:15">lamlwatu kehu ge au Bashan kideutu deudi.<verse eid="PSA 68:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 68:16" />Hengim eh daitie piebam no, nnui deudi kideutu kehube,</para>
  <para style="q" vid="PSA 68:16">lamlwatu ga Tinggwang pa lungh kera hengim kebam heni de?</para>
  <para style="q" vid="PSA 68:16">Kesang, RAMPAUBE cika kelungta lungh zie.<verse eid="PSA 68:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 68:17" />Tinggwang bagidung au cang ngkai, pecang reu pecang;</para>
  <para style="q" vid="PSA 68:17">Rampaube au penui kakga kemci ni ga bam, Sinai ga nzwa.<verse eid="PSA 68:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 68:18" />Nang kecehu ga; nang hebaang tei kebamme de lungmpet beu;</para>
  <para style="q" vid="PSA 68:18">nang minadung dade mapeudung ngaulu,</para>
  <para style="q" vid="PSA 68:18">ncu ngngwa regi eh renia kelame dade bai,</para>
  <para style="q" vid="PSA 68:18">ciu eh nang, RAMPAUBE Tinggwang, cika lungh lu kerane.<note caller="+" style="f"><char style="fr" closed="false">68:18 </char><char style="ft" closed="false">Eph. 4:8</char></note><verse eid="PSA 68:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 68:19" />Anui reidung cuibeu kelabe, Rampaube depeu samlam pung kelube tei lulo,</para>
  <para style="q" vid="PSA 68:19">anuide kelikebeube Tinggwang. <char style="qs">Selah</char><verse eid="PSA 68:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 68:20" />Anui Tinggwang au kelikebeu Tinggwang;</para>
  <para style="q" vid="PSA 68:20">RAMPAUBE Tinggwang au ketsai gade anuide keli beulu kelabe.<verse eid="PSA 68:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 68:21" />Dede Tinggwang pe ngauraume peudung dangdi zie,</para>
  <para style="q" vid="PSA 68:21">pe zaisia eh pecu renia kera tetgwang kelame de pepeudeu mai gade teirezam zie.<verse eid="PSA 68:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 68:22" />Rampaube rang eh, “Ih Bashan gade a ngauraume de ngngwa cailigwang zie;</para>
  <para style="q" vid="PSA 68:22">Ih penuide jaaidi kecok gade ngngwa cailigwang zie<verse eid="PSA 68:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 68:23" />ciu eh nang n ngauraume de teingkap, n pi hejai ga dau mie lu,</para>
  <para style="q" vid="PSA 68:23">nah ciu eh n teudung de penui qwa n ngauraumedung dade ngaulu kerane.”<verse eid="PSA 68:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 68:24" />Tinggwang, penui nang tet gwang kela ngau da,</para>
  <para style="q" vid="PSA 68:24">a Tinggwang tet gwang kela, a hegwangpei, kemci ni gade.<verse eid="PSA 68:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 68:25" />Lei keteime mie raidi, hecinglei keteime pecaisui,</para>
  <para style="q" vid="PSA 68:25">nah sumbe ga releimedung leibungdung dap eh la.<verse eid="PSA 68:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 68:26" />Recakidung gade Tinggwang de samlam lu;</para>
  <para style="q" vid="PSA 68:26">RAMPAUBE de twalu, nnui Israel dui lwa kebam gade kegwangme.<verse eid="PSA 68:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 68:27" />Cika Benjamin raitu bam, heleuh ceutube,</para>
  <para style="q" vid="PSA 68:27">pecai Judah muiteume nah penui maadung,</para>
  <para style="q" vid="PSA 68:27">Zebulun muiteume nah Naphtali muiteume.<verse eid="PSA 68:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 68:28" />Nnui Tinggwang, Israel, nnuide tei ngkieng beu;</para>
  <para style="q" vid="PSA 68:28">n kengkieng anuida keulia lo, Tinggwang, nang gwang kedi tingbazie dau keulia kecu nzwa.<verse eid="PSA 68:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 68:29" />N kerecaki Jerusalem gade n kengkieng de anuida keulia gailo,</para>
  <para style="q" vid="PSA 68:29">hegwangme nda mapeudung pwagwang kecu ga.<verse eid="PSA 68:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 68:30" />Ceheiziu ga kebam renaam kaudung<note caller="+" style="f"><char style="fr" closed="false">68:30 </char><char style="fq" closed="false">Renaam kaudung: </char><char style="ft" closed="false">samtie aide hippopotamus makaune de rang bamlie lala. Makaune aide Egypt deudi de saulia kecu mie ge. Cf. Ezk. 29:3. </char></note> de kesiu dilu.</para>
  <para style="q" vid="PSA 68:30">Minadung reu, hetumseudung nah hetumnadung de tei ngkiee kegai.</para>
  <para style="q" vid="PSA 68:30">Penuide hengam teigai nah peu mapeudung n da pwagwang lu;</para>
  <para style="q" vid="PSA 68:30">mina hereu teineu kelame de teu zangra dilu.<verse eid="PSA 68:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 68:31" />Hegwangnadung Egypt gade mpet zie;</para>
  <para style="q" vid="PSA 68:31">Cush pe ba Tinggwang da gwangcang kerane kelwa zie.<verse eid="PSA 68:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 68:32" />Tinggwang da lei tei gailu, nnui kideube hegwangram; <char style="qs">Selah</char></para>
  <para style="q" vid="PSA 68:32">RAMPAUBE de ketwa lei teigai lu.<verse eid="PSA 68:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 68:33" />Tinggimdung reu tinggim ga rwa kela pe dage, ndaa tingdau gade kebam de;</para>
  <para style="q" vid="PSA 68:33">pielo, pa pe kengkieng pwa sahbak gai.<verse eid="PSA 68:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 68:34" />Tinggwang dage n kengkieng sahgai lu;</para>
  <para style="q" vid="PSA 68:34">pe kedi au Israel reu,</para>
  <para style="q" vid="PSA 68:34">nah pe kengkieng au tingkamdung ga.<verse eid="PSA 68:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 68:35" />Tinggwang, n kemci ni gade nang au ngau kehing ge;</para>
  <para style="q" vid="PSA 68:35">Israelme Tinggwang, pe kengkieng nah kedi kengkieng minadungde peula.</para>
  <para style="q" vid="PSA 68:35">Tinggwang da samlam bamlo.<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="s">Acu kelilu, O Tinggwang</para>
  <para style="d">Kenlang leibungkekwame ziemne; Shoshannim ga teleilu. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 69:1" />Acu kelibeulo, Tinggwang;</para>
  <para style="q" vid="PSA 69:1">kedanemene duidung ne a teilung<note caller="+" style="f"><char style="fr" closed="false">69:1 </char><char style="ft" closed="false">dui a ngwang ga nghang cang dida</char></note> kerehim gage kai dida.<verse eid="PSA 69:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 69:2" />Ih tangnia kecok ga nlim mie, sap gai kera bam kegah ga;</para>
  <para style="q" vid="PSA 69:2">Ih dui kecok ga gwanglu, cika dui a reu puinlim di.<verse eid="PSA 69:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 69:3" />Ih hap kecu dene keherei bam; a rwak canghdi;</para>
  <para style="q" vid="PSA 69:3">a miak hema dida a Tinggwang nha kei eh kwa kebam dau.<verse eid="PSA 69:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 69:4" />Pekie kegah gade acu ngau nghetme kecume au a peu ga peutamlei dung swade kieeki;</para>
  <para style="q" vid="PSA 69:4">caugame acu teitset zie bi, pekiedung cimau delwe acu ngaurau kelame, cipaume ngkieng;</para>
  <para style="q" vid="PSA 69:4">Ih rega kemakpe, Ih peu caili maisia.<note caller="+" style="f"><char style="fr" closed="false">69:4 </char><char style="ft" closed="false">Jhn. 15:25, Lei. 35:19</char></note><verse eid="PSA 69:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 69:5" />Tinggwang, nang Ih maang keladung cibam,</para>
  <para style="q" vid="PSA 69:5">nah a maudung nda de kebai gailak.<verse eid="PSA 69:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 69:6" />A ziemne nda keregui kebamme dungde peu hengam tei diso, Rampaube reugwame reu RAMPAUBE;</para>
  <para style="q" vid="PSA 69:6">Ncu peei eh kelame de peu a ziemne herütpeu kemak ge tei diso, Israel Tinggwang.<verse eid="PSA 69:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 69:7" />N ziemne acu mina ki lala;</para>
  <para style="q" vid="PSA 69:7">delwe hengamle ada puila dida.<verse eid="PSA 69:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 69:8" />Israel a sinamedung dade Ih sangme ge dida,</para>
  <para style="q" vid="PSA 69:8">a pui dade Ih sangme ge dida.<verse eid="PSA 69:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 69:9" />N ki de hengim kecu dene acu tyei nggah dida,</para>
  <para style="q" vid="PSA 69:9">nah ratadung ncu herata kegaide ada kaumie zeu.<verse eid="PSA 69:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 69:10" />Ih mmwang eh matyei me ge,</para>
  <para style="q" vid="PSA 69:10">penui acu rangmsia.<verse eid="PSA 69:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 69:11" />Ih rosopai ne a pai tei keludau,</para>
  <para style="q" vid="PSA 69:11">Ih penui ziemne macisam ge dida.<verse eid="PSA 69:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 69:12" />Namdi kirie ga kwa eh bam kecume a ha rangdi;</para>
  <para style="q" vid="PSA 69:12">Ih au zausak kemieme lei ge.<verse eid="PSA 69:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 69:13" />Dede a ziemne au, a kekie de n ziemne, RAMPAUBE, cipau tingdau nang acu luulu zie;</para>
  <para style="q" vid="PSA 69:13">nlumlu kebui n kelikelu gade acu keligai lo.<verse eid="PSA 69:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 69:14" />Tangnia gade acu teumpet beulo, nah acu peu nlim diso;</para>
  <para style="q" vid="PSA 69:14">acu ngkau kelame dade acu ngngwa tetti beulo nah duidung kecok gade acu kelibeu lo.<verse eid="PSA 69:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 69:15" />Dui kedi ne peu acu hacim diso,</para>
  <para style="q" vid="PSA 69:15">mede kecok dene peu acu nggum teu diso.</para>
  <para style="q" vid="PSA 69:15">Acu peu hekwaki mui dene ngkui teu diso.<verse eid="PSA 69:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 69:16" />Acu keli lo, RAMPAUBE, kedanemene n samkak kesamsang au yi kecune;</para>
  <para style="q" vid="PSA 69:16">n ngaugiadung ada kieesüt bam kelane, ada nreu gwanglu.<verse eid="PSA 69:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 69:17" />N kilabe dade n zu kebaidi so,</para>
  <para style="q" vid="PSA 69:17">kedanemene Ih pumteihbe rei bam; zette acu keligai lo.<verse eid="PSA 69:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 69:18" />Ada gwang delwe acu kelibeu lo.</para>
  <para style="q" vid="PSA 69:18">A ngauraume ziemne, acu keli beu lo.<verse eid="PSA 69:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 69:19" />Nang a rata cibam, a ngngam, nah herütpeu kemak;</para>
  <para style="q" vid="PSA 69:19">a ngauraumedung pelane n dwaga bam.<verse eid="PSA 69:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 69:20" />Rata ne a nlung teipang dida; A püt kerüt ne kepui teibam;</para>
  <para style="q" vid="PSA 69:20">Ngaunggia kera Ih mina de peei, dede migede gah;</para>
  <para style="q" vid="PSA 69:20">Alung tei relui kera Ih peei, dede Ih ngaulu ma.<verse eid="PSA 69:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 69:21" />A taktyei ga penui acu heiring kai;</para>
  <para style="q" vid="PSA 69:21">Ih hereu luge penui acu kehiadui sak kera peu.<note caller="+" style="f"><char style="fr" closed="false">69:21 </char><char style="ft" closed="false">Mrk. 15:23,36, Luk. 23:36, Jhn. 19:28-29</char></note><verse eid="PSA 69:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 69:22" />Penui dwaga kekairak kebam de peu hebai ge dilu;</para>
  <para style="q" vid="PSA 69:22">penui kwak eh bam lie kecu cet kebam dau, peu cide hetak ge dilu.<verse eid="PSA 69:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 69:23" />Penui miakdung peu mui dilu ciu eh penui ngau ta dilu kerane;</para>
  <para style="q" vid="PSA 69:23">nah penui kiadung peu nlai la muilu.<note caller="+" style="f"><char style="fr" closed="false">69:23 </char><char style="ft" closed="false">Rom. 11:9-10</char></note><verse eid="PSA 69:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 69:24" />N rata kedi penui reuga ruigai lu,</para>
  <para style="q" vid="PSA 69:24">nah n rata süt kecu dene penui reu tetkah lu.<note caller="+" style="f"><char style="fr" closed="false">69:24 </char><char style="ft" closed="false">Keu. 16:1</char></note><verse eid="PSA 69:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 69:25" />Penui gu kelungh bam de peu ngkap dilu;</para>
  <para style="q" vid="PSA 69:25">penui paikidung ga peu migede lungh so.<note caller="+" style="f"><char style="fr" closed="false">69:25 </char><char style="ft" closed="false">Bat. 1:20</char></note><verse eid="PSA 69:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 69:26" />Kedanemene nang tei ngkau kedime de penui tei keherei la.</para>
  <para style="q" vid="PSA 69:26">Nang tei rezam kegaime ha penui mpau daila.<note caller="+" style="f"><char style="fr" closed="false">69:26 </char><char style="ft" closed="false">Isa. 53:4</char></note><verse eid="PSA 69:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 69:27" />Kemau teikedi caide kemau tei dai dai kecune penuide mmaulu;</para>
  <para style="q" vid="PSA 69:27">penuide peu n kelikelu ga magede penui qwa bam so.<verse eid="PSA 69:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 69:28" />Peu penui de Kering Laisiukwak gade tei nggah dilu</para>
  <para style="q" vid="PSA 69:28">nah kesangme de ngngwa kerau ga ncüt so.<note caller="+" style="f"><char style="fr" closed="false">69:28 </char><char style="ft" closed="false">Luk. 10:20, Keu. 3:5, 20:12,15; 21:27</char></note><verse eid="PSA 69:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 69:29" />Dede Ih au magah nah lungrei ne pui;</para>
  <para style="q" vid="PSA 69:29">n kelikelu ne peu, Tinggwang, acu kehu gage teucuh beulo.<verse eid="PSA 69:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 69:30" />Ih lei ge teu Tinggwang zi de twa lazie</para>
  <para style="q" vid="PSA 69:30">nah suiyi teu pecu kendu peu zie.<verse eid="PSA 69:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 69:31" />Hetumseu reca swade cide be RAMPAUBE pesui yiki gwa zie</para>
  <para style="q" vid="PSA 69:31">mede hetumseu pekiidung nah pe ngienglwakdung kebam swade.<verse eid="PSA 69:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 69:32" />Kenciepme cide ngau nah pe sui yila;</para>
  <para style="q" vid="PSA 69:32">nnui Tinggwang de peei kelame, peu nnui nlung ringbam lo.<verse eid="PSA 69:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 69:33" />Kedanemene RAMPAUBE rei kebamme kwa kingnei</para>
  <para style="q" vid="PSA 69:33">nah pe baangketeime de masipei tadi lama.<verse eid="PSA 69:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 69:34" />Peu tinggim nah kideube de pecu twalu,</para>
  <para style="q" vid="PSA 69:34">jaaididung nah cika pelane mlai eh kebam leune.<verse eid="PSA 69:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 69:35" />Kedanemene Tinggwang Zion de kelibeu zie nah Judah namdi teucuh dai beuzie;</para>
  <para style="q" vid="PSA 69:35">minadung cika lungh zie nah cide penui madung teilu zie.<verse eid="PSA 69:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 69:36" />Pe kilame leuhdung cide gumlu zie;</para>
  <para style="q" vid="PSA 69:36">nah pe zi de hung kelame cika lungh zie.<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="s">O RAMPAUBO, ridi helo</para>
  <para style="d">Kenlang leibungkekwame ziemne; David gu lei ge; nsung bamlu kerane.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 70:1" />Acu kelibeulo, Tinggwang!</para>
  <para style="q" vid="PSA 70:1">RAMPAUBO, zette gwang eh acu ngha lo.<verse eid="PSA 70:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 70:2" />A teilung keuteu pwadi kera tei kebamme peu</para>
  <para style="q" vid="PSA 70:2">ngngam nah tei hengam teigai;</para>
  <para style="q" vid="PSA 70:2">peu penuide nreu cailigwang nah rütkemak ga ngngwa gai,</para>
  <para style="q" vid="PSA 70:2">Ih keherei kecu ga penui suiyi kelame de.<note caller="+" style="f"><char style="fr" closed="false">70:2 </char><char style="ft" closed="false">Lei. 40:14</char></note><verse eid="PSA 70:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 70:3" />Ngauraume ngngam de ziemne peu penuide nreu cailigwanglu,</para>
  <para style="q" vid="PSA 70:3">caugame rang eh, “Aha, aha.”<verse eid="PSA 70:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 70:4" />Ncu peei kela leune depeu renga nah penui suiyi lu;</para>
  <para style="q" vid="PSA 70:4">n kelikelu de hung kelame de peu rangbam muilu,</para>
  <para style="q" vid="PSA 70:4">“Tinggwang da peu hetwa bamlu.”<verse eid="PSA 70:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 70:5" />Dede Ih au magah nah nnei bam;</para>
  <para style="q" vid="PSA 70:5">ada kelwa gwanglu, Tinggwang;</para>
  <para style="q" vid="PSA 70:5">nang a kengha nah nang acu kelibeu.</para>
  <para style="q" vid="PSA 70:5">RAMPAUBO, acu ngha kera ri diso.<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="s">A kengkieng cang kedidau acu püt diso</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 71:1" />Nda de, RAMPAUBE, Ih nsiu lula;</para>
  <para style="q" vid="PSA 71:1">peu madaude acu hengam ga kai diso.<verse eid="PSA 71:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 71:2" />Acu kelibeu nah n kesamsangbe gade acu peu kwak bamlu;</para>
  <para style="q" vid="PSA 71:2">nkwen ada pung nreugwang lu nah acu kelilu.<verse eid="PSA 71:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 71:3" />Ih mie kegai leune ga tsura ge nzwa a kemsiu teibeu lalu;</para>
  <para style="q" vid="PSA 71:3">nang acu kelibeu kerane aja kaibeu da,</para>
  <para style="q" vid="PSA 71:3">kedanemene nang a tsura nah a kensiube.<verse eid="PSA 71:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 71:4" />Acu kelibeu, a Tinggwang, kesiame ba gade.</para>
  <para style="q" vid="PSA 71:4">Mzui kemakme nah pezai kesiame ba gade.<verse eid="PSA 71:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 71:5" />Kedanemene nang a kereguibe, Rampaube RAMPAUBE.</para>
  <para style="q" vid="PSA 71:5">A hena ne gade Ih ncu nlum la.<verse eid="PSA 71:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 71:6" />Apui za gade nangne acu ngha zütza gwang;</para>
  <para style="q" vid="PSA 71:6">apui za gade acu ngngwa mpet kebeube au nang;</para>
  <para style="q" vid="PSA 71:6">a hetwa de au n ziemne mui zie.<verse eid="PSA 71:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 71:7" />Ih au mina kekieege ziemne puisau ge;</para>
  <para style="q" vid="PSA 71:7">nang au acu kegum kengkiengbe.<verse eid="PSA 71:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 71:8" />N hetwa le a mui pui dizie,</para>
  <para style="q" vid="PSA 71:8">tingbazie pelane n herüt le.<verse eid="PSA 71:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 71:9" />A hecing tingdau acu kelien gi diso;</para>
  <para style="q" vid="PSA 71:9">a kengkieng gah kedi dau acu püt diso.<verse eid="PSA 71:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 71:10" />Kedanemene a ngauraumedung a ha rangbam;</para>
  <para style="q" vid="PSA 71:10">a teilung de pie kebamme ngkwa lwe ngkim eh mariem bam.<verse eid="PSA 71:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 71:11" />Penui rang eh, “Tinggwang pecu gi dida;</para>
  <para style="q" vid="PSA 71:11">pe caisui eh pecu tuilu, kedanemene cika migede pecu kelibeu kera gah.”<verse eid="PSA 71:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 71:12" />Tinggwang, ada de mdei diso;</para>
  <para style="q" vid="PSA 71:12">a Tinggwang, acu ngha kera kelwa gai.<verse eid="PSA 71:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 71:13" />A teilung de ngaurau kelame de, peu penuide hengam tei nah ngkap dilu;</para>
  <para style="q" vid="PSA 71:13">acu tei rezam neu kelame de peu ngam nah hengam teidi lulo.<verse eid="PSA 71:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 71:14" />Dede Ih au nda keregui bammui zie</para>
  <para style="q" vid="PSA 71:14">nah ncu hetwa peu reureu zie.<verse eid="PSA 71:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 71:15" />A mui ne n kesamsang ha rang zie</para>
  <para style="q" vid="PSA 71:15">nah n kelikelu tingbazie pelane,</para>
  <para style="q" vid="PSA 71:15">Ih cide cicang melu liede.<verse eid="PSA 71:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 71:16" />Ih Rampaube RAMPAUBE kengkieng batadung teu eh gwang zie;</para>
  <para style="q" vid="PSA 71:16">Ih n kesamsang de ndugai zie, ngu rünne.<verse eid="PSA 71:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 71:17" />Tinggwang, nang a hena ne gade acu ledeu beuda;</para>
  <para style="q" vid="PSA 71:17">cu liede miswakegah nang tei kegaidung Ih ndu zie.<verse eid="PSA 71:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 71:18" />Kesang, Ih hecing di nah apeu pu kedi dau liede, Tinggwang, acu pütti so,</para>
  <para style="q" vid="PSA 71:18">peciabe ceheu dage n kengkieng de Ih ndulia kebam nzwa,</para>
  <para style="q" vid="PSA 71:18">n kengkieng gwang kera pelane dage.<verse eid="PSA 71:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 71:19" />N kesamsangbe liede, Tinggwang, cide hu zu;</para>
  <para style="q" vid="PSA 71:19">nang ma kedidung tei kegaibe, Tinggwang, cauge nang nzwa no?<verse eid="PSA 71:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 71:20" />Nang acu keherei kekieege peu ngau kegaibe</para>
  <para style="q" vid="PSA 71:20">anui de teimcang dai beuzie</para>
  <para style="q" vid="PSA 71:20">nah hangdeu kang gade anui teucuh dai beuzie.<verse eid="PSA 71:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 71:21" />Nang acu ciswa de tei mdiki beu zie;</para>
  <para style="q" vid="PSA 71:21">nang alung tei mla dai beu zie.<verse eid="PSA 71:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 71:22" />Ih leibung teu ncu tei keherei delie pwapeu zie</para>
  <para style="q" vid="PSA 71:22">ncu nlumlu kebui de ziemne, a Tinggwang;</para>
  <para style="q" vid="PSA 71:22">Ih leibung teu eh lei tei ncu twa zie,</para>
  <para style="q" vid="PSA 71:22">Israel gu Kemci Ge.<verse eid="PSA 71:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 71:23" />Ih lei tei ncu twa kecudau a muileukung suiyi teu sahbak zie,</para>
  <para style="q" vid="PSA 71:23">a rabe liede, nangne kelikebeu de.<verse eid="PSA 71:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 71:24" />Ih n masang ha mringbe ting rang zie;</para>
  <para style="q" vid="PSA 71:24">kedanemene acu tei msia di zie lie kelame de ngkapdi nah peu ngamdi delu.<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="s">Hegwangpei de n kenzeu peulo</para>
  <para style="d">Solomon gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 72:1" />N kesamsang hezaidung hegwangpei de peulu, Tinggwang,</para>
  <para style="q" vid="PSA 72:1">n kesamsang hegwang napei dage.<verse eid="PSA 72:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 72:2" />Peu pecu kesangbe gade kemzuibe teu n minadung tutiaklu kera</para>
  <para style="q" vid="PSA 72:2">nah magah kecume dage de kemzuibe teu eh.<verse eid="PSA 72:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 72:3" />Peu n lamlwadung minadung ziemne kezuyi peulu;</para>
  <para style="q" vid="PSA 72:3">peu kideutudung kesamsang peulu.<verse eid="PSA 72:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 72:4" />Peu pecu kegahme tutiak teune lu;</para>
  <para style="q" vid="PSA 72:4">pecu peu teumai kesiame de ngha lu</para>
  <para style="q" vid="PSA 72:4">nah penuide ngaurau kelame de nkap dilu.<note caller="+" style="f"><char style="fr" closed="false">72:4 </char><char style="ft" closed="false">Isa. 11:4</char></note><verse eid="PSA 72:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 72:5" />Peu penuide ncu rütlu tingnaimiak kebam dau,</para>
  <para style="q" vid="PSA 72:5">nah ceheudung pelane ga hekei bam kecu tiege.<verse eid="PSA 72:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 72:6" />Peu tingrui nzwa nghunglo cehei hedi pwa kebam ga,</para>
  <para style="q" vid="PSA 72:6">kideube ga tingrui kegai nzwa.<verse eid="PSA 72:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 72:7" />Peu makesangme de pe tingbaziedung gade lungh yilu,</para>
  <para style="q" vid="PSA 72:7">nah peu cika hekei gah di kemakta lungh keyile kepui teilu.<verse eid="PSA 72:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 72:8" />Peu pecu jaaidi reu jaaidi kengkieng teulu,</para>
  <para style="q" vid="PSA 72:8">nah hereuki gade kideube penli ga kecang.<verse eid="PSA 72:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 72:9" />Peu hetaideu ga lungh kebamme pe dwaga keumie lu;</para>
  <para style="q" vid="PSA 72:9">peu pe ngauraume de rebui mniak lu.<verse eid="PSA 72:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 72:10" />Peu Tarshish gwangpeidung nah duigwadeudung pecu mta mapeu zie;</para>
  <para style="q" vid="PSA 72:10">peu Sheba nah Seba gu gwangpeidung mapeudung pwapeu lu.<verse eid="PSA 72:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 72:11" />Kesang, peu hegwangdung pelane pe dwaga kaumie lu;</para>
  <para style="q" vid="PSA 72:11">peu heleuh pelane pe gwa teilu.<verse eid="PSA 72:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 72:12" />Kedanemene pa teumai kesia hap eh kebamme de ngha la</para>
  <para style="q" vid="PSA 72:12">nah kegahme penui de ngha kera bam kemakme.<verse eid="PSA 72:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 72:13" />Pa kegahme nah teumai kesiame de ngaunggia la,</para>
  <para style="q" vid="PSA 72:13">nah pa teumai kesiame teilung kelibeu la.<verse eid="PSA 72:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 72:14" />Pa keherei nah kerigi kecu gade penui teilungh keli beu,</para>
  <para style="q" vid="PSA 72:14">nah pe miakngau gade penui jai au pemihung.<note caller="+" style="f"><char style="fr" closed="false">72:14 </char><char style="ft" closed="false">Tit. 2:14</char></note><verse eid="PSA 72:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 72:15" />Peu pecu ringlu! Peu Sheba kecak de pecu peulu.</para>
  <para style="q" vid="PSA 72:15">Peu minadung de pe ziemne kekie teila muilu;</para>
  <para style="q" vid="PSA 72:15">peu Tinggwang de pecu tingbazie pelane samlam beulu.<verse eid="PSA 72:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 72:16" />Peu hangdeu cika meibui ne kepui teilu;</para>
  <para style="q" vid="PSA 72:16">lamlwa tudung ga peu penui meibang de mlai bamlu.</para>
  <para style="q" vid="PSA 72:16">Peu petsi de Lebanon nzwa lu;</para>
  <para style="q" vid="PSA 72:16">luh ga cehei lungh yi kebam nzwa eh peu minadung de namdidung gade lungh yilu.<verse eid="PSA 72:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 72:17" />Peu pe zi de kelungta bammui lu;</para>
  <para style="q" vid="PSA 72:17">peu pe zi de tingnaimiak kebamtane bamlu;</para>
  <para style="q" vid="PSA 72:17">peu pe dade minadung da samlam bamlu;</para>
  <para style="q" vid="PSA 72:17">peu heleuhdung pelane pecu samlam kepungbe de eh qulu.<verse eid="PSA 72:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 72:18" />Peu RAMPAUBE Tinggwang, Israel Tinggwang, da samlam bamlo,</para>
  <para style="q" vid="PSA 72:18">pa rünne miswakegah tadung tei kelabe.<note caller="+" style="f"><char style="fr" closed="false">72:18 </char><char style="ft" closed="false">Lei. 136:4</char></note><verse eid="PSA 72:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 72:19" />Peu pe zi kemdu de ga kelungta samlam bamlo,</para>
  <para style="q" vid="PSA 72:19">nah peu hangdeu pelane ga pe zi kemdu de pui lo.</para>
  <para style="q" vid="PSA 72:19">Amen nah Amen.<verse eid="PSA 72:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 72:20" />Jesse napei David kekiedung cang dida.<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms">Laisiukwak Kecumbe</para>
  <para style="s">A Tinggwang au kelungta a kengkieng nah a kwalie</para>
  <para style="d">Asaph gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 73:1" />Tinggwang au Israelme dade yi kesang,</para>
  <para style="q" vid="PSA 73:1">mina pelung kemcime dade.<verse eid="PSA 73:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 73:2" />Dede a ziemne au, a sap gade kaudi nage;</para>
  <para style="q" vid="PSA 73:2">Ih a kenlum bam tadi<verse eid="PSA 73:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 73:3" />kedanemene Ih ngang kelame de ngau a riakdi</para>
  <para style="q" vid="PSA 73:3">Ih kemaume lungh yi kecu ngau kegai dau.<verse eid="PSA 73:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 73:4" />Kedanemene penui lungrei ga penui tsai kemaktane,</para>
  <para style="q" vid="PSA 73:4">dede penui au ngking nah yi mcang bam.<verse eid="PSA 73:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 73:5" />Penui au mina kedame nzwa keherei ma;</para>
  <para style="q" vid="PSA 73:5">penuide au mina kedame nzwa tei keherei ma.<verse eid="PSA 73:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 73:6" />Penui hegie de ne ntei ge nzwa penui ngwang ga ntei la;</para>
  <para style="q" vid="PSA 73:6">zaikesia ne penui paidung nzwa ba la.<verse eid="PSA 73:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 73:7" />Penui lung gade makesia pet;</para>
  <para style="q" vid="PSA 73:7">penui nlung makesia cet eh naang lala.<verse eid="PSA 73:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 73:8" />Penui mide nuila nah makesia rangla;</para>
  <para style="q" vid="PSA 73:8">penui ngang eh kedame de ngau kerau ciem riem la.<verse eid="PSA 73:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 73:9" />Penui mui le tinggimdung de rang msia la,</para>
  <para style="q" vid="PSA 73:9">nah penui mleudung le kideube de rang msia la.<verse eid="PSA 73:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 73:10" />Cine pe minadungde penuide nreu gwangla</para>
  <para style="q" vid="PSA 73:10">nah penui sam neu ngga eh nlum lala.<verse eid="PSA 73:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 73:11" />Penui rang eh, “Tinggwang dainzwa cilu lano?</para>
  <para style="q" vid="PSA 73:11">Hutube Tinggwang da maci bamme ni?”<verse eid="PSA 73:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 73:12" />Aide cilu: mina aidungde au kemaume;</para>
  <para style="q" vid="PSA 73:12">penuida lungrei gah, mahei reu reu dila.<verse eid="PSA 73:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 73:13" />Magede mede ni Ih mci kebam de.</para>
  <para style="q" vid="PSA 73:13">Nah kemau tei kemak de.<verse eid="PSA 73:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 73:14" />Tingba pelane peu acu keherei</para>
  <para style="q" vid="PSA 73:14">nah tingcang ramsang ledeu beula.<verse eid="PSA 73:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 73:15" />Magade Ih rangdi cai, “Ih ma aidungde rang zie,”</para>
  <para style="q" vid="PSA 73:15">iciu cai Ih n cai lungh leu kera ceuheu aidungde de cwa dizie de nai ge.<verse eid="PSA 73:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 73:16" />Ih aidungde cet kera tei kegaidau,</para>
  <para style="q" vid="PSA 73:16">cide a ziemne hungham di.<verse eid="PSA 73:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 73:17" />Pecai Ih n kerecaki ga gwang O Tinggwang</para>
  <para style="q" vid="PSA 73:17">nah Ih kemaume kamtu ga gwang kera bam de cilu.<verse eid="PSA 73:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 73:18" />Nang penui de kereneu henidung gage kaidi bi zie;</para>
  <para style="q" vid="PSA 73:18">nang penuide peu kaumie eh kapdi zie.<verse eid="PSA 73:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 73:19" />Penui dainzwa kaknage gage hetaideu ge mie dino!</para>
  <para style="q" vid="PSA 73:19">Penui penli ga gwang lada nah ngaukehing ge gade cangdi zie.<verse eid="PSA 73:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 73:20" />Penui au mige mrak cuh eh mimang gadi kela nzwa da;</para>
  <para style="q" vid="PSA 73:20">Rampaubo, nang cuh kecudau, nang cipau mangdung de mning dailak.<verse eid="PSA 73:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 73:21" />Kedanemene a lungcet ga teei kedi dau,</para>
  <para style="q" vid="PSA 73:21">delwe acu rezam sütdi.<verse eid="PSA 73:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 73:22" />Ih ncu cilu tadi;</para>
  <para style="q" vid="PSA 73:22">Ih makaune mang eh kela nzwa di n dwa gade.<verse eid="PSA 73:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 73:23" />Ciuliede Ih nda la muila;</para>
  <para style="q" vid="PSA 73:23">nang a ba zetle herak teula.<verse eid="PSA 73:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 73:24" />Nang n samdung gade acu gumla beuzie</para>
  <para style="q" vid="PSA 73:24">nah pecai kemdu gade acu luulu zie.<verse eid="PSA 73:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 73:25" />Nang mecai a ziemne tinggim ga cau bam no?</para>
  <para style="q" vid="PSA 73:25">Kideu ga nang gwale migede Ih luu keneu ga.<verse eid="PSA 73:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 73:26" />A nlung nah a pumteih mnei kedi dau,</para>
  <para style="q" vid="PSA 73:26">dede Tinggwang au kelungta a kengkieng be.<verse eid="PSA 73:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 73:27" />N dade mdeitet kedime kap dizie;</para>
  <para style="q" vid="PSA 73:27">nang n samzai teikemakme pelane de tei ngkap dizie.<verse eid="PSA 73:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 73:28" />Dede a ziemne au, teimai kesiabe Ih Tinggwang da gwang kecude delie.</para>
  <para style="q" vid="PSA 73:28">Ih RAMPAUBE Tinggwang de a kemsiu tei luda.</para>
  <para style="q" vid="PSA 73:28">Ih n tadung leune mdugai zie.<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="s">Cuhlu, O Tinggwang n kiebe gumlu</para>
  <para style="d">Asaph gu maschil ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 74:1" />Tinggwang, daitei eh nang anuide kelungta gi dino?</para>
  <para style="q" vid="PSA 74:1">Daitei eh n rata le n meurünhau taktyei luh ru dino?<verse eid="PSA 74:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 74:2" />N mina de nsunggai lo, nang ndaa ting dau lui keludung,</para>
  <para style="q" vid="PSA 74:2">nang peu n mapwa tei zie lie eh kelikelu leuh de,</para>
  <para style="q" vid="PSA 74:2">nah kideutu Zion, nang kelung de ga.<verse eid="PSA 74:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 74:3" />Gwang pie lo ngkap cangsiak kedidung de,</para>
  <para style="q" vid="PSA 74:3">ngauraume ne kemci ni de ga teimsia kedi pelane.<verse eid="PSA 74:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 74:4" />N ngauraume ngkinglwe n kerecaki ga sah bam dida bam ni sum ga de nrung di da;</para>
  <para style="q" vid="PSA 74:4">penui hereu ngam kelu rehi gade pailimdung pwa cuh luda.<verse eid="PSA 74:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 74:5" />Penui nreudung le bi gwang dida</para>
  <para style="q" vid="PSA 74:5">Penui au minadung renaamkang ga tsingbangdung bi gwangkecu nzwada.<verse eid="PSA 74:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 74:6" />Bung kenzeudung pelane penuine teipang nah tei kecai dida;</para>
  <para style="q" vid="PSA 74:6">penui cidung de nreu nah hegeuteisang le dappop dida.<verse eid="PSA 74:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 74:7" />Penui n kerecaki gage mi kai dida;</para>
  <para style="q" vid="PSA 74:7">nang kelung bam de tei hera dida, hangdeu gage teumie dida.<verse eid="PSA 74:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 74:8" />Penui mlung gade rang, “Anui penui pelane de tei ngkap dizie.”</para>
  <para style="q" vid="PSA 74:8">Penui hangdeu ga n keredau ni leune ru dida.<verse eid="PSA 74:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 74:9" />Anui tinggwang dade ma rehidung gede ngau si meda;</para>
  <para style="q" vid="PSA 74:9">caihakecime ge de bam me da,</para>
  <para style="q" vid="PSA 74:9">nah anui kakga mige de aide dai tingtie ge bam zie bi cima.<verse eid="PSA 74:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 74:10" />Dai tiege, Tinggwang, ngauraume n dage henui tei bam laino?</para>
  <para style="q" vid="PSA 74:10">Ngauraume n zi rang msia lamui zieni?<verse eid="PSA 74:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 74:11" />Nang daitei n ba teu caili di zeu no, n zetle ba?</para>
  <para style="q" vid="PSA 74:11">N paini ga de n zetle ba keu lu nah penuide ngkap dilo,<verse eid="PSA 74:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 74:12" />Dede Tinggwang au a gwang pei n daa tingdung gade tei la dida,</para>
  <para style="q" vid="PSA 74:12">hangdeu ga kelikelu teu gwang eh.<verse eid="PSA 74:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 74:13" />Nang n kengkieng le duidi mzi dida;</para>
  <para style="q" vid="PSA 74:13">nang dui dung ga neidi dung peu tei kecai dida.<verse eid="PSA 74:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 74:14" />Nang leviathan<note caller="+" style="f"><char style="fr" closed="false">74:14 </char><char style="fq" closed="false">Leviathan </char><char style="ft" closed="false">Jaaidi caune.</char></note> peudung teipit dida;</para>
  <para style="q" vid="PSA 74:14">nang pecu le hetaideu ga kelung kaune pok tei dida.<verse eid="PSA 74:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 74:15" />Nang duilet nah duipwak dung ngkei pop dida;</para>
  <para style="q" vid="PSA 74:15">nang hereuki lwa kebamdung de teicangh dida.<verse eid="PSA 74:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 74:16" />Tingba au ngu, nah tingmui de ngu;</para>
  <para style="q" vid="PSA 74:16">nang tingnaimiak nah hekei de pebam gage kailu.<verse eid="PSA 74:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 74:17" />Nang kideu raidung pelane teigai;</para>
  <para style="q" vid="PSA 74:17">nang hepwak nah tingka tei gai.<verse eid="PSA 74:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 74:18" />Nsung gai lo ngauraume ncu dainzwa eh henui teigai bi, RAMPAUBO,</para>
  <para style="q" vid="PSA 74:18">nah kemangme n zi rangmsia kebamde.<verse eid="PSA 74:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 74:19" />N tamhau teilung de renaam kaune de peu di helo.</para>
  <para style="q" vid="PSA 74:19">N mina keherei kebamme dung teilung de nsung ta di helo.<verse eid="PSA 74:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 74:20" />N samkak de nsung gai lo,</para>
  <para style="q" vid="PSA 74:20">hangdeu kemui le gimdung ga nggwa kesia kebam de ziemne.<verse eid="PSA 74:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 74:21" />Keherei kelame de peu nggam eh caili di helo;</para>
  <para style="q" vid="PSA 74:21">peu kegahme de nah keherei kelame de n zi twa lulo.<note caller="-" style="x"><char style="xo" closed="false">74:21 </char><char style="xt" closed="false"><ref loc="PSA 103:6">Lei. 103:6</ref></char></note><verse eid="PSA 74:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 74:22" />Cuhlu, Tinggwang; n katei n nzeu rang lulo;</para>
  <para style="q" vid="PSA 74:22">nsung gailo dainzwa eh kemangme petingnai ncu henui tei bam.<verse eid="PSA 74:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 74:23" />N ngauraume ncu renia eh sah kelame kwa nsungta diso</para>
  <para style="q" vid="PSA 74:23">mede ngauraume sah eh kebam kwa de.<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="s">Tinggwang au kensambe tutiak teizie</para>
  <para style="d">Lei kempwakme muiteube ziemne; Al Tashheth gage teigai kelu. Asaph gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 75:1" />Anui ncu hetwa peula, Tinggwang;</para>
  <para style="q" vid="PSA 75:1">anui hetwa peu la, nang kebam lia kecu ziemne;</para>
  <para style="q" vid="PSA 75:1">mina n batadung miswa kega de rang la.<verse eid="PSA 75:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 75:2" />Riem kenzeu ting ga Ih petau tei eh hetutiak zie.<verse eid="PSA 75:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 75:3" />Kideu be nah kelung kau pelane hing eh mbeu dida,</para>
  <para style="q" vid="PSA 75:3">Ih kideu be ciadung tei ntip lula<char style="qs">Selah</char><verse eid="PSA 75:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 75:4" />Ih ngang kelame de rang, “Ngang diso,”</para>
  <para style="q" vid="PSA 75:4">nah kenlienme de, “N kii de pwacu diso.<verse eid="PSA 75:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 75:5" />N kii kehudung de gage pwa cuh diso;</para>
  <para style="q" vid="PSA 75:5">kehegie ngwang de teu marang so.”<verse eid="PSA 75:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 75:6" />Cide naimiak kepetle mede kenlwetle de gwang ma,</para>
  <para style="q" vid="PSA 75:6">nah cide hetaideu gade pwa cuh kecu gwang lama.<verse eid="PSA 75:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 75:7" />Dede Tinggwang au tutiak be;</para>
  <para style="q" vid="PSA 75:7">pa teu ngkau nah pwacuh beu kelabe da.<verse eid="PSA 75:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 75:8" />RAMPAUBE pe ba ga zau ta kepet piak de pwa kebam de ziemne,</para>
  <para style="q" vid="PSA 75:8">masaladung ncüt kenzeude, nah rui mpet gai.</para>
  <para style="q" vid="PSA 75:8">Kideu ga kenlienme leune zau kamtube kecang de sakbi zie.<verse eid="PSA 75:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 75:9" />Dede Ih rang jüja bam zie nang tei kegaide;</para>
  <para style="q" vid="PSA 75:9">Ih ketwa lei tei pwa Jacob Tinggwang de twa zie.<verse eid="PSA 75:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 75:10" />Pa rangla, “Ih kenlienme kiidung pelane dang dizie,</para>
  <para style="q" vid="PSA 75:10">dede kesamsangme kii au teucuh beuzie.”<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="s">Cau n dwaga saplu buino?</para>
  <para style="d">Lei kempwakme muiteube ziemne; pe ria ketei leibungdung gade. Asaph gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 76:1" />Tinggwang pe katei pecu peu Judah de cigai;</para>
  <para style="q" vid="PSA 76:1">pe zi au Israel ga di süt.<verse eid="PSA 76:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 76:2" />Pe paiki Salem<note caller="+" style="f"><char style="fr" closed="false">76:2 </char><char style="fq" closed="false">Salem: </char><char style="ft" closed="false">Israelme ting dwa Jerusalem de Salem de qula. Cf. Ken. 14:18.</char></note> ga bam;</para>
  <para style="q" vid="PSA 76:2">pa kelung ni au Zion.<verse eid="PSA 76:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 76:3" />Cika de pa lakpi gu tsidung teicum,</para>
  <para style="q" vid="PSA 76:3">hegeu, kingtie, nah hereu nia kedabe dung. <char style="qs">Selah</char><verse eid="PSA 76:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 76:4" />Nang ba sütgai eh n kemdu lia gai,</para>
  <para style="q" vid="PSA 76:4">lamlwadung gade kenghung dau, cika de nang ngauraume de ngamlu zie.<verse eid="PSA 76:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 76:5" />Reugwa kekuume gunia keugi kapdi;</para>
  <para style="q" vid="PSA 76:5">penui kau eh tsaidi.</para>
  <para style="q" vid="PSA 76:5">Reugwame pelane magede teisi gailak di.<verse eid="PSA 76:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 76:6" />Nang herata kegai gade, Jacob Tinggwang,</para>
  <para style="q" vid="PSA 76:6">hekwen teume nah hekwen kau zipdi.<verse eid="PSA 76:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 76:7" />Ncu, yeo ncu, hing lu kerabe;</para>
  <para style="q" vid="PSA 76:7">cau n miak ngau ga saplu buino nang n rata kebamdau?<verse eid="PSA 76:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 76:8" />Nang Tinggim gade n tutiak de peu siu;</para>
  <para style="q" vid="PSA 76:8">kideube hing nah zing dedi<verse eid="PSA 76:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 76:9" />nang, Tinggwang, cuh eh hetutiak kegaidau</para>
  <para style="q" vid="PSA 76:9">nah kideu ga keherei kelame de keli kebeudau. <char style="qs">Selah</char><verse eid="PSA 76:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 76:10" />N rata tutiak minadung dage kekai de ncu ketwa teu gwang zie;</para>
  <para style="q" vid="PSA 76:10">hereu gade ring kelume ncu reca zie.<verse eid="PSA 76:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 76:11" />RAMPAUBE n Tinggwang dage sampet dung tei lu nah kai nzeu lu.</para>
  <para style="q" vid="PSA 76:11">Pecu twagwa kebamme leune pecu mapeudung teugwang beulu pecu kerüt peulu kebui dage.<verse eid="PSA 76:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 76:12" />Tinggwang hegwang ngang kelame de tei henah dida;</para>
  <para style="q" vid="PSA 76:12">nah kideu ga hegwangmedung de keheu dida.<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="s">Keherei tingdau Ih RAMPAUBE de peeila</para>
  <para style="d">Lei kempwakme muiteube ziemne; Jeduthun ria rehi cai. Asaph gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 77:1" />Ih a kwa pet eh Tinggwang dage mragai zie;</para>
  <para style="q" vid="PSA 77:1">Ih a kwa le Tinggwang de qugai zie, nah a Tinggwang a kekie siu luzie.<verse eid="PSA 77:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 77:2" />Ih keherei kelu tingba benai Ih Rampaube dade kei;</para>
  <para style="q" vid="PSA 77:2">tingmuiziu pelane Ih a ba hwacuh kekei tei, nah penui leu dima.</para>
  <para style="q" vid="PSA 77:2">Alung kerelui gede ngau luma.<verse eid="PSA 77:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 77:3" />Ih Tinggwang de nsung keludau mragai;</para>
  <para style="q" vid="PSA 77:3">Ih mnei miedi kecudau pecu nsung dila. <char style="qs">Selah</char><verse eid="PSA 77:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 77:4" />Nang a miak tei mrak peu;</para>
  <para style="q" vid="PSA 77:4">Ih marang kera keherei sütdi.<verse eid="PSA 77:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 77:5" />Ih gwang kedi tingbadung de cetdi,</para>
  <para style="q" vid="PSA 77:5">gwang kedi ting tie süt kedi de.<verse eid="PSA 77:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 77:6" />Ih ma cetncok eh tingmui zie nggwangdi.</para>
  <para style="q" vid="PSA 77:6">Ih macet eh</para>
  <para style="q" vid="PSA 77:6">aide akatei acu keteu.<verse eid="PSA 77:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 77:7" />Rampaube a cu kelungta lutadi zieni?</para>
  <para style="q" vid="PSA 77:7">Pa a cu madau de ngaugia lia si lak deni?<verse eid="PSA 77:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 77:8" />Pe lungsang samkak de kelungta gadi zie deni?</para>
  <para style="q" vid="PSA 77:8">Pe sampet de kelungta gadi deni?<verse eid="PSA 77:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 77:9" />Tinggwang nggia kerade nsung tadi deni?</para>
  <para style="q" vid="PSA 77:9">Pe rata ne pe ngaugia de nkuidi deni? <char style="qs">Selah</char><verse eid="PSA 77:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 77:10" />Ih ranggai, “Aide a lung tei tube:</para>
  <para style="q" vid="PSA 77:10">Hutube Tinggwang kengkieng anui da bam sime de lie kecu de”<verse eid="PSA 77:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 77:11" />Dede n tadung de Ih nsung luzie, RAMPAUBO;</para>
  <para style="q" vid="PSA 77:11">N tei kegai miswakegah kehegwadung de Ih cet luzie.<verse eid="PSA 77:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 77:12" />Ih n tadung pelane cet sünne zie</para>
  <para style="q" vid="PSA 77:12">nah cidung de cetncok daizie.<verse eid="PSA 77:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 77:13" />N lampui au, Tinggwang, mci lie;</para>
  <para style="q" vid="PSA 77:13">daipau tinggwang anui Tinggwang kedi de de keda lano?<verse eid="PSA 77:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 77:14" />Nang au miswakega tadung ketei Tinggwang;</para>
  <para style="q" vid="PSA 77:14">nang n kengkieng minadung kakga ge liagai da.<verse eid="PSA 77:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 77:15" />Nang n minadung de ngking kelu n kengkieng kedide le peu da,</para>
  <para style="q" vid="PSA 77:15">Jacob tsaname de nah Joseph de. <char style="qs">Selah</char><verse eid="PSA 77:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 77:16" />Duidung de ncu ngau da, Tinggwang;</para>
  <para style="q" vid="PSA 77:16">duidung de n cu ngau da, nah penui hing di;</para>
  <para style="q" vid="PSA 77:16">kecokdung mbeu di.<verse eid="PSA 77:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 77:17" />Hemwadung dui rui mie;</para>
  <para style="q" vid="PSA 77:17">hemwa kemui tinggim pekwa peugai;</para>
  <para style="q" vid="PSA 77:17">n lakpitsidung<note caller="+" style="f"><char style="fr" closed="false">77:17 </char><char style="ft" closed="false">tingkehepiak </char></note> lim rwa bam.<verse eid="PSA 77:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 77:18" />N tingceu kwa tingkai ga siu;</para>
  <para style="q" vid="PSA 77:18">ting kehepik de kideube tei mba di;</para>
  <para style="q" vid="PSA 77:18">hangdeube mbeu nah mlai di.<verse eid="PSA 77:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 77:19" />N lampui dui gade mie</para>
  <para style="q" vid="PSA 77:19">nah n lampui duidung keswak ga mie,</para>
  <para style="q" vid="PSA 77:19">dede n pipadung ngau ma.<verse eid="PSA 77:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 77:20" />Nang n minadung de kauhau nzwa</para>
  <para style="q" vid="PSA 77:20">teuswa Moses nah Aaron ba teu eh.<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="s">Gwangkela Ceheu dage rang beulo</para>
  <para style="d">Asaph gu maschil ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 78:1" />A keledeu kingnei lu, a minadung,</para>
  <para style="q" vid="PSA 78:1">Ih kerang samdung kingnei lu.<verse eid="PSA 78:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 78:2" />Ih maregwa gade marang zie;</para>
  <para style="q" vid="PSA 78:2">Ih leitei zie ndaa kebai pwa kebam samdung dele.<note caller="+" style="f"><char style="fr" closed="false">78:2 </char><char style="ft" closed="false">Mat. 13:35</char></note><verse eid="PSA 78:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 78:3" />Sam aidungde anui siu nah ci kelube,</para>
  <para style="q" vid="PSA 78:3">anui paume anui dage rangkebeu samdung.<verse eid="PSA 78:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 78:4" />Anui penuide kebainzeu dilak penui name dade.</para>
  <para style="q" vid="PSA 78:4">Anui pecai lungh keleume de ranglia zie RAMPAUBE twalu kebui ta teikegai ha de,</para>
  <para style="q" vid="PSA 78:4">pe kengkieng, nah miswakegahdung pa teikegai de.<note caller="+" style="f"><char style="fr" closed="false">78:4 </char><char style="ft" closed="false">Deu. 4:9, Jos. 4:6-7, Eph. 6:4</char></note><verse eid="PSA 78:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 78:5" />Pa Jacob dage samkak kelu hezaidung tei gaibeu</para>
  <para style="q" vid="PSA 78:5">nah Israel dage hezai kaibeu.</para>
  <para style="q" vid="PSA 78:5">Pa anui paumedung de aja kaibeu</para>
  <para style="q" vid="PSA 78:5">iciu eh penui namedung dage pezaidung ledeu beulo.<verse eid="PSA 78:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 78:6" />Pa aja aide kaibeu iciu eh lungh keleume pe zai de cilu kera ziemne, hename mna mene kebamme,</para>
  <para style="q" vid="PSA 78:6">nah penui namedung de caune rang nswa beulai.<verse eid="PSA 78:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 78:7" />Iciu eh penui kenlum Tinggwang da bamlu kerane</para>
  <para style="q" vid="PSA 78:7">nah pa tei kegai dung nsung tadi lak</para>
  <para style="q" vid="PSA 78:7">dede pe ajadung nsung bamlu kerane.<verse eid="PSA 78:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 78:8" />Iciu lude penui penui paumedung nzwa dilak,</para>
  <para style="q" vid="PSA 78:8">penui au renia nah samzai teikemak ceheu ge,</para>
  <para style="q" vid="PSA 78:8">nah penui kecet dung petau kemak ceheu ge,</para>
  <para style="q" vid="PSA 78:8">nah penui rabe teilungh lam sap ntip ma nah Tinggwang dade masang ma.<note caller="+" style="f"><char style="fr" closed="false">78:8 </char><char style="ft" closed="false">2 Heg. 17:14-15 </char></note><verse eid="PSA 78:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 78:9" />Ephraimme lakpi reunet telei lu</para>
  <para style="q" vid="PSA 78:9">dede penui pak caili di hereu ketei benai.<verse eid="PSA 78:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 78:10" />Penui Tinggwang de samkak kelu de luulu tadi</para>
  <para style="q" vid="PSA 78:10">nah pe zai mzai meidi.<verse eid="PSA 78:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 78:11" />Penui Peta tei kegai dung nsung tadi,</para>
  <para style="q" vid="PSA 78:11">Pa miswakegah tadung penui dage tei kelia de.<verse eid="PSA 78:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 78:12" />Penui Pa miswakegah tadung</para>
  <para style="q" vid="PSA 78:12">penui paume miakngau tei eh</para>
  <para style="q" vid="PSA 78:12">Egypt deudi, Zoan<note caller="+" style="f"><char style="fr" closed="false">78:12 </char><char style="fq" closed="false">Zoan: </char><char style="ft" closed="false">Heni aide de Rameses namdibe lie de qula (Tet. 1:11). Hegwangme niadung kainzeu bamkela namdi aide Nile Reukikung ga naimiak kepetlebie bamla. </char></note> namdi langkie gade tei kegaidung de nsungtadi.<verse eid="PSA 78:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 78:13" />Pa Jaaidi de mzi di nah penui de peu kahlu;</para>
  <para style="q" vid="PSA 78:13">Pa dui depeu tangdeudung nzwa sapbam kera teigai.<note caller="+" style="f"><char style="fr" closed="false">78:13 </char><char style="ft" closed="false">Tet. 14:21-29</char></note><verse eid="PSA 78:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 78:14" />Pa tingna penuide hemwa le gumteu nzang</para>
  <para style="q" vid="PSA 78:14">nah tingmui pelane mi kebaale.<verse eid="PSA 78:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 78:15" />Pa tsura hetaideu gade teipang gai</para>
  <para style="q" vid="PSA 78:15">nah pa penuide dui teumai kesia kiee swade kiee eh peugai, Jaaidi singdung teipuilu kebui.<note caller="+" style="f"><char style="fr" closed="false">78:15 </char><char style="ft" closed="false">Tet. 17:1-6, Pum. 20:11-13, 1 Cor. 10:4</char></note><verse eid="PSA 78:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 78:16" />Pa tsura gade reuna dui lwa kepet teibeu</para>
  <para style="q" vid="PSA 78:16">nah kereukidung nzwa duilwa kepet teigai.<verse eid="PSA 78:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 78:17" />Dede penui pe dage kemau tei jüja ladi,</para>
  <para style="q" vid="PSA 78:17">Hutube Tinggwang de ngngwa hetaideu gade renia ladi.<verse eid="PSA 78:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 78:18" />Penui lung gade Tinggwang de kedei di</para>
  <para style="q" vid="PSA 78:18">penui ketyeipok tyei keneube tyei mnunglu kera kie kegai ziemne.<verse eid="PSA 78:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 78:19" />Penui Tinggwang de kemmau sam rangdi;</para>
  <para style="q" vid="PSA 78:19">penui rang eh cu, “Tinggwang hetaideu gade anui ziemne ketyeipok teleibeu kesang beu lubui ni?<verse eid="PSA 78:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 78:20" />Pielo, pa tsura kedeu kegai dau, duilwa pet</para>
  <para style="q" vid="PSA 78:20">nah reuna reuki dung lwapui di.</para>
  <para style="q" vid="PSA 78:20">Dede pa tangku de peulu bui ni?</para>
  <para style="q" vid="PSA 78:20">Pa pe mina dung de heteih peulu bui ni?”<verse eid="PSA 78:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 78:21" />Rampaube aide siu kegaidau, pa pe rata di;</para>
  <para style="q" vid="PSA 78:21">cine pe mi le Jacob de mcau eh rudi,</para>
  <para style="q" vid="PSA 78:21">nah pe rata Israel dage kai gaidi,<verse eid="PSA 78:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 78:22" />Kedanemene penui Tinggwang de nlum ta kedine</para>
  <para style="q" vid="PSA 78:22">nah pe kelikelu de nlumta kedine.<verse eid="PSA 78:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 78:23" />Iciu de pa ting kehu de aja kai gai</para>
  <para style="q" vid="PSA 78:23">nah tinggim kikam dung de ngkei gailo eh.<verse eid="PSA 78:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 78:24" />Pa manna<note caller="+" style="f"><char style="fr" closed="false">78:24 </char><char style="ft" closed="false">Tinggim tatyei</char></note> penuide peu tyei kera ziemne rui nhung gai beu,</para>
  <para style="q" vid="PSA 78:24">nah tinggim gade mei penuide peugai.<note caller="+" style="f"><char style="fr" closed="false">78:24 </char><char style="ft" closed="false">Tet. 16:4, Jhn. 6:31</char></note><verse eid="PSA 78:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 78:25" />Minadung tinggimgwame taktyei tyeilu.</para>
  <para style="q" vid="PSA 78:25">Pa penuide pui kenlim ketyeipok langgai beu.<verse eid="PSA 78:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 78:26" />Pa naimiak kepetle tingkai de peu tingkam gade gui gai,</para>
  <para style="q" vid="PSA 78:26">nah pe kengkieng le pa tingbangle gu tingkai mapie beu.<verse eid="PSA 78:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 78:27" />Pa penui dage heteih rui nhung gai beu rebui katung kecu nzwa eh,</para>
  <para style="q" vid="PSA 78:27">nruine peikap gaikelak Jaaidikung ga heciangdung kieege.<verse eid="PSA 78:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 78:28" />Cidung de penui ramzeuki sumga cakmie,</para>
  <para style="q" vid="PSA 78:28">penui paiki taidung leuga.<verse eid="PSA 78:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 78:29" />Cine penui tyei nah nggei lu.</para>
  <para style="q" vid="PSA 78:29">Pa penuide tyei keneu be peu gai.<verse eid="PSA 78:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 78:30" />Dede penui mnung tyei canglu ma;</para>
  <para style="q" vid="PSA 78:30">penui ketyeipok tyei eh bam.<verse eid="PSA 78:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 78:31" />Cine Tinggwang rata penui dage kaigai</para>
  <para style="q" vid="PSA 78:31">nah penui ngkingtume de teitsetdi.</para>
  <para style="q" vid="PSA 78:31">Pa Israel ga kedetkelu rehangme de teingkau di.<note caller="+" style="f"><char style="fr" closed="false">78:31 </char><char style="ft" closed="false">1 Cor. 10:5</char></note><verse eid="PSA 78:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 78:32" />Aiciu bam de, penui kemau tei bam di</para>
  <para style="q" vid="PSA 78:32">nah miswakegah batadung pa teikegai dungde nlumlu tadi.<verse eid="PSA 78:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 78:33" />Cine Tinggwang penui tingbadung tei ndui di;</para>
  <para style="q" vid="PSA 78:33">penui teilungdung ketsai kengi le puih di.<verse eid="PSA 78:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 78:34" />Tinggwang penuide teiherei kegai dau ne penui pecu peei mdeu zie,</para>
  <para style="q" vid="PSA 78:34">nah penui nreu gwang nah sünne eh pecu peei lu zie.<verse eid="PSA 78:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 78:35" />Penui helung nreulu delwe Tinggwang au penui tsura</para>
  <para style="q" vid="PSA 78:35">nah hutube Tinggwang penuide rikelube lie eh kecu nsunglu zie.<verse eid="PSA 78:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 78:36" />Dede penui pe dage kenret samdung rang zie</para>
  <para style="q" vid="PSA 78:36">nah sam kette lungsang ma.<verse eid="PSA 78:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 78:37" />Kedanemene penui lung pedage sap ntip lu kemakne,</para>
  <para style="q" vid="PSA 78:37">nah penui pecu samkak kelude samsang lu kemakne.<note caller="+" style="f"><char style="fr" closed="false">78:37 </char><char style="ft" closed="false">Bat. 8:21</char></note><verse eid="PSA 78:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 78:38" />Iciude Tinggwang, ngaugia le pui kebamne, penui mau gibeu nah penuide teingkap dima.</para>
  <para style="q" vid="PSA 78:38">Yeo, pia kekiee ge pa pe rata kezeudi</para>
  <para style="q" vid="PSA 78:38">nah pe lunghop de kezeu di.<verse eid="PSA 78:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 78:39" />Pa penuide teikelu pumteihbe lie kecu nsunglu,</para>
  <para style="q" vid="PSA 78:39">tingkai guitet dila, nah cailila kemak nzwa.<verse eid="PSA 78:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 78:40" />Penui daikenzwa gede hetaideu gade pecu mlaidi dino</para>
  <para style="q" vid="PSA 78:40">delwe hepui deudung gade pecu pelung tei msia dino!<verse eid="PSA 78:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 78:41" />Penui Tinggwang de kedei daidai</para>
  <para style="q" vid="PSA 78:41">nah Israel kemci Tinggwang rata teidi.<verse eid="PSA 78:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 78:42" />Penui pe kengkieng tadung cet luma,</para>
  <para style="q" vid="PSA 78:42">dainzwa penui ngauraume dade pa kelibeu bi kecu.<verse eid="PSA 78:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 78:43" />Pa pe rata keheu kegai ta Egypt deu gade</para>
  <para style="q" vid="PSA 78:43">nah Zoan cuikui gade miswakegah bata tei kegai dau.<verse eid="PSA 78:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 78:44" />Pa Egyptme reukidung de hejai teimie di</para>
  <para style="q" vid="PSA 78:44">iciu eh penuide peu penui reuki duidung sakgailak dilu kerane.<note caller="+" style="f"><char style="fr" closed="false">78:44 </char><char style="ft" closed="false">Tet. 7:17-21, Lei. 105:29</char></note><verse eid="PSA 78:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 78:45" />Pa tammainedung penui de teikeherei guide gai kera langgai<note caller="+" style="f"><char style="fr" closed="false">78:45 </char><char style="ft" closed="false">Tet. 8:20-24; Lei. 105:31a</char></note></para>
  <para style="q" vid="PSA 78:45">nah hegaudung ne penui deu kepui teidi.<note caller="+" style="f"><char style="fr" closed="false">78:45 </char><char style="ft" closed="false">Tet. 8:1-7, Lei. 105:30</char></note><verse eid="PSA 78:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 78:46" />Pa penui taluh</para>
  <para style="q" vid="PSA 78:46">nah penui meidung peu tangriem de tyei.<note caller="+" style="f"><char style="fr" closed="false">78:46 </char><char style="ft" closed="false">Tet. 10:1-20, Lei. 105:34-35</char></note><verse eid="PSA 78:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 78:47" />Pa penui kube luhdung tangheu le teimsia di</para>
  <para style="q" vid="PSA 78:47">nah caimunbangdung tangheu keisüt gai eh teimsiadi.<note caller="+" style="f"><char style="fr" closed="false">78:47 </char><char style="ft" closed="false">Tet. 9:18-26, Lei. 105:32-33</char></note><verse eid="PSA 78:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 78:48" />Pa tangheule penui tumdung de teitsetdi</para>
  <para style="q" vid="PSA 78:48">nah penui meuründung de hegi keimie teitsetdi.<verse eid="PSA 78:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 78:49" />Perata teu penuide teiherei sütgai.</para>
  <para style="q" vid="PSA 78:49">Pa lunghop, rata, nah keherei langgai</para>
  <para style="q" vid="PSA 78:49">ketsai sam pau kelame nzwa gwang.<verse eid="PSA 78:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 78:50" />Pa pe rata de kezeu dima;</para>
  <para style="q" vid="PSA 78:50">Pa penuide ketsai gade mbai beuma</para>
  <para style="q" vid="PSA 78:50">dede penuide rapia le teitsetdi.<verse eid="PSA 78:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 78:51" />Pa Ham paikidung<note caller="+" style="f"><char style="fr" closed="false">78:51 </char><char style="fq" closed="false">Ham paikidung: </char><char style="ft" closed="false">Aide Egypt de rangbam cf. 105:23,27; 106:22 gade Egypt de qupwa Ham kedeu de bam. Ham au Noah name hangge, Epyptme pau lie lala.</char></note> ga kelung penui kengkieng neraime,</para>
  <para style="q" vid="PSA 78:51">Egypt pelane ga neraibe de teitset ciakdi.<note caller="+" style="f"><char style="fr" closed="false">78:51 </char><char style="ft" closed="false">Tet. 12:29, Lei. 105:36</char></note><verse eid="PSA 78:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 78:52" />Pa pe minadung de meurün haude nzwa ngngwa mpet lu,</para>
  <para style="q" vid="PSA 78:52">nah penui maadi puisau tei eh hetaideu kahgwang.<verse eid="PSA 78:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 78:53" />Pa penuide ngngwa kwak gwanglu nah peu ngngidi mene,</para>
  <para style="q" vid="PSA 78:53">dede penui ngauraume de jaaidi dui ne hegakdi.<verse eid="PSA 78:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 78:54" />Pecai pa penuide ngngwa Canaan deu kemci kungga gwanglu,</para>
  <para style="q" vid="PSA 78:54">pe ba zetle ne gwakelu lamlwa aide ga.<verse eid="PSA 78:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 78:55" />Pa heleuhdung de penui dwa gade gwampet di</para>
  <para style="q" vid="PSA 78:55">nah penui kidung pwa pe minadung de peudi.</para>
  <para style="q" vid="PSA 78:55">Pa Israel leuhme depeu penui paikidung ga bamlu.<verse eid="PSA 78:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 78:56" />Iciu de penui Hutube Tinggwang de mmaudi nah mcaudi</para>
  <para style="q" vid="PSA 78:56">nah pe ajadung de kailu tadi,<verse eid="PSA 78:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 78:57" />Penui lungsang luma nah penui peimedung nzwa mide kecwa ta tei ladi;</para>
  <para style="q" vid="PSA 78:57">penui lakpitsi kengkoibe nzwa kedine nlum gailak di.<verse eid="PSA 78:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 78:58" />Kedanemene penui gu heni kehudung<note caller="+" style="f"><char style="fr" closed="false">78:58 </char><char style="ft" closed="false">nlum kemak reca nidung </char></note> dene pe rata teidi</para>
  <para style="q" vid="PSA 78:58">nah penui mamiedung pwa pe rata teidi.<verse eid="PSA 78:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 78:59" />Tinggwang aide siu kegaidau,</para>
  <para style="q" vid="PSA 78:59">Perata di nah Israelme de püt mcigi di.<verse eid="PSA 78:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 78:60" />Pa Shiloh namdi paiki dega lungh bamla kideu ga,</para>
  <para style="q" vid="PSA 78:60">pa mina kakga ngngwa kelunghbe paiki de.<verse eid="PSA 78:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 78:61" />Pa pe samkakbung de peu tuilu kebui peudi</para>
  <para style="q" vid="PSA 78:61">nah pe kemdu de<note caller="+" style="f"><char style="fr" closed="false">78:61 </char><char style="ft" closed="false">1 Sam. 4.1-22</char></note> ngauraume ba gage kaidi.<verse eid="PSA 78:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 78:62" />Pa pe minadung de kiengtie dwa gage peudi,</para>
  <para style="q" vid="PSA 78:62">nah pa pe mapwamedung de pe rata di.<verse eid="PSA 78:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 78:63" />Rehangmedung de mi le rutset ciakdi,</para>
  <para style="q" vid="PSA 78:63">nah releimedung meu gaikera gahdi.<verse eid="PSA 78:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 78:64" />Penui cingkume de kingtie le gitsetdi,</para>
  <para style="q" vid="PSA 78:64">nah penui hemipuidung depeu haplu tadi.<note caller="+" style="f"><char style="fr" closed="false">78:64 </char><char style="ft" closed="false">1 Sam. 4:11</char></note><verse eid="PSA 78:64" /></para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 78:65" />Pecai Rampaube mraklu mige kezip gade nrak kelunzwa,</para>
  <para style="q" vid="PSA 78:65">reugwame ge zau saklu eh mrung kecu nzwadi.<verse eid="PSA 78:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 78:66" />Pa pe ngauraume maadi de gwa cailidi;</para>
  <para style="q" vid="PSA 78:66">Pa penui de kelungta ngngam kera gage kaidi.<verse eid="PSA 78:66" /></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 78:67" />Pa Joseph pautsa kiria de pütdi,</para>
  <para style="q" vid="PSA 78:67">nah Ephraim leuhme de kedetlu tadi.<verse eid="PSA 78:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 78:68" />Pa Judah leuh de</para>
  <para style="q" vid="PSA 78:68">nah pa hung kela Zion Deutu de kedetlu.<verse eid="PSA 78:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 78:69" />Pa pe kerecaki Tinggimdung nzwa teilu,</para>
  <para style="q" vid="PSA 78:69">kelungta ziemne pa tei ntip süt lu kideube nzwa.<verse eid="PSA 78:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 78:70" />Pa pe kilabe, David de kedetlu,</para>
  <para style="q" vid="PSA 78:70">nah pecu meurün kwakela bam gade ngngwalu.<verse eid="PSA 78:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 78:71" />Pa pecu meurünpui pe na ngngwa keladungde kwa kela gade ngngwalu, nah pecu pa ngngwa gwanglu,</para>
  <para style="q" vid="PSA 78:71">pe minadung, Jacob leuhme, Israelme, nah pe magum kerame de kekwabe tei kerane.<verse eid="PSA 78:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 78:72" />David pe lung pelane teu penui mapie,</para>
  <para style="q" vid="PSA 78:72">nah pe baciem keyi teu eh penui puisau teibeu.<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="s">Daitie geno, O RAMPAUBO</para>
  <para style="d">Asaph gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 79:1" />Tinggwang, hegwame leuhdung n mapwa gumkera gwangbam dida;</para>
  <para style="q" vid="PSA 79:1">penui n kerecaki kemci de tei hera dida;</para>
  <para style="q" vid="PSA 79:1">penui Jerusalem de teingkapcio gwang dida.<note caller="+" style="f"><char style="fr" closed="false">79:1 </char><char style="ft" closed="false">Luk. 21:24, Keu. 11:2 </char></note><verse eid="PSA 79:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 79:2" />Penui n kilame tsaipaaudung de tinggim ruine taktyei ziemne peubam dida,</para>
  <para style="q" vid="PSA 79:2">nah n dade masang kelame paaudung kideu kaune de peu dida.<verse eid="PSA 79:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 79:3" />Penui n minadung jai teilwa eh dui nzwa Jerusalem pelane lwa dida,</para>
  <para style="q" vid="PSA 79:3">nah migede penui paau kungdi kera gah da.<note caller="+" style="f"><char style="fr" closed="false">79:3 </char><char style="ft" closed="false">Keu. 16:6</char></note><verse eid="PSA 79:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 79:4" />Anui namdame dwaga anui anui au kesiame ge dida,</para>
  <para style="q" vid="PSA 79:4">anuide twagwa kebamme dwa gade nuikeneu nah henui ge tei dida.<verse eid="PSA 79:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 79:5" />Rampaubo daitie ge zieno? N rata kelungta ladi zieni?</para>
  <para style="q" vid="PSA 79:5">Daitie ge n rata de miheu kecunzwa bamlai?<verse eid="PSA 79:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 79:6" />Ncu cimene kela heleuhdung</para>
  <para style="q" vid="PSA 79:6">nah n zi qu kemak deudi hegwangme namdi dung da n rata rui gailo.<note caller="+" style="f"><char style="fr" closed="false">79:6 </char><char style="ft" closed="false">1 The. 4:5, 2 The. 1:8</char></note><verse eid="PSA 79:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 79:7" />Kedanemene penui Jacob de daptset dida</para>
  <para style="q" vid="PSA 79:7">nah pe namdung ngkap dida.<verse eid="PSA 79:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 79:8" />Anui paume maudung ziemne anui de mmau diso;</para>
  <para style="q" vid="PSA 79:8">N ngaugia tadung anuida kegwangbe tei lo,</para>
  <para style="q1" vid="PSA 79:8">kedanemene anui au mneisüt lu.<verse eid="PSA 79:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 79:9" />Anuide ngha lo; anuide kelikelube Tinggwang, n zi kendu de ziemne;</para>
  <para style="q" vid="PSA 79:9">anuide kelibeu lo nah anui maudung gi beulo n zi gade.<verse eid="PSA 79:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 79:10" />Daitei heleuhdung depeu, “Daiga penui Tinggwang lano?” De ranglai.</para>
  <para style="q" vid="PSA 79:10">Peu n kilamedung jai lwakegai dene anui miakngau gade</para>
  <para style="q" vid="PSA 79:10">hekum heleuhdung da gwang kelube teilo.<note caller="+" style="f"><char style="fr" closed="false">79:10 </char><char style="ft" closed="false">Keu. 6:10;19:2</char></note><verse eid="PSA 79:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 79:11" />Hebaang tei kelame mra kwa n dwaga peu gwangcang lo;</para>
  <para style="q" vid="PSA 79:11">N kengkieng kedi dele tsai dilai eh kebam nadung de gum beulo.<verse eid="PSA 79:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 79:12" />Rampaubo anuide lungh twagwa kebam heleuhdung ncu kemneu ta tei kegai kieege swade</para>
  <para style="q" vid="PSA 79:12">pia hena peu dai beu lo.<verse eid="PSA 79:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 79:13" />Iciu eh anui n minadung nah n meurün haudung kelungta</para>
  <para style="q" vid="PSA 79:13">ncu hetwa peula muizie.</para>
  <para style="q" vid="PSA 79:13">Anui lungh cu keleu ceheu leune de ncu twa kera rang beuzie.<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="s">Anuide teucuh beulo, O Tinggwang</para>
  <para style="d">Lei kempwakme muiteube ziemne, Shoshannim Eduth dage kerautie telei kegai. Asaph reca lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 80:1" />Anui kekie kingnei gailo, O Israel de kekwabo,</para>
  <para style="q" vid="PSA 80:1">nang ne Joseph de kekwabe meurünhau de kekwa nzwa;</para>
  <para style="q" vid="PSA 80:1">nang cherubim<note caller="+" style="f"><char style="fr" closed="false">80:1 </char><char style="fq" closed="false">Cherubim: </char><char style="ft" closed="false">Hesiu tei kela kaune, RAMPAUBE hegwangbam de kwabam kela kaune. Eze. 1:5-14, 2 Heg. 19:15. </char></note> reuga bam kelabe, kebaa anuida tau gailo!<verse eid="PSA 80:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 80:2" />Ephraim, Benjamin, nah Manasseh leuhdung miakngau tei eh, n kengkieng ta teilia lo;</para>
  <para style="q" vid="PSA 80:2">gwang eh anuide kelibeu lo.<verse eid="PSA 80:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 80:3" />Tinggwang, anuide tei mcang dailu;</para>
  <para style="q" vid="PSA 80:3">Nzu kebaade anui reu gage kai gailo, iciude anuide kelilu zie.<verse eid="PSA 80:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 80:4" />Rampaube reugwame reu Tinggwang,</para>
  <para style="q" vid="PSA 80:4">daitie ge nang n minadung kie kegaidau n rata bamlai?<verse eid="PSA 80:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 80:5" />Nang penui helung kesia tyei kera peuda</para>
  <para style="q" vid="PSA 80:5">nah mimiakdui piak kedige sak kera peuda.<verse eid="PSA 80:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 80:6" />Nang anuida mage teigai anui namdame de ngngwa regeu kerane,</para>
  <para style="q" vid="PSA 80:6">nah anui ngauraume penui kakgade anuide nui bam dida.<verse eid="PSA 80:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 80:7" />O reugwame reu Tinggwang, anuide kelibeu dailo;</para>
  <para style="q" vid="PSA 80:7">N ngaugai anuide pwalia lo iciude anuide kelilu zie<verse eid="PSA 80:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 80:8" />Nang Egypt deudi gade kubebang keugwang luda;</para>
  <para style="q" vid="PSA 80:8">nang heleuhdung de gwa mpetdi nah cikage sum luda.<verse eid="PSA 80:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 80:9" />Nang cide ziemne hangdeu teimci luda;</para>
  <para style="q" vid="PSA 80:9">cide pe mah himlu nah deudi pelane gum puilu.<verse eid="PSA 80:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 80:10" />Lamlwadung pemie le sunglu,</para>
  <para style="q" vid="PSA 80:10">Tinggwang gu cedardung de pe kiak le lungh gumlu.<verse eid="PSA 80:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 80:11" />Cide pe kiakdung Mediterranean Jaaidi kemdei ga miecang</para>
  <para style="q" vid="PSA 80:11">nah pe mah him mie eh pe pwakdung pwakcuh Ephrateme Reuki kecang.<verse eid="PSA 80:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 80:12" />Daitei nang rie twagwa kenzeude dap pop dino</para>
  <para style="q" vid="PSA 80:12">iciu eh lampui tetkah kegwang leu depeu pecu raityei kerane ni?<verse eid="PSA 80:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 80:13" />Renaam nkiadung ne gwang tei msiadi</para>
  <para style="q" vid="PSA 80:13">nah makaunedung cide tyei.<verse eid="PSA 80:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 80:14" />Nreugwang dailo, reugwame reu Tinggwang;</para>
  <para style="q" vid="PSA 80:14">tinggim gade pie nghung gailo nah mcet gailo delwe nah kubeluh aide pie rengei beulo.<verse eid="PSA 80:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 80:15" />Aide nang ne n ba zetle le ling kegai mah de da,</para>
  <para style="q" vid="PSA 80:15">peu pwakcuh kera nang tei kegaide.<verse eid="PSA 80:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 80:16" />Cide bikau nah ru dida;</para>
  <para style="q" vid="PSA 80:16">penui gah dida nrata ziemne.<verse eid="PSA 80:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 80:17" />Peu n ba zetle ba de mina be reu ga bam kelube tei lo,</para>
  <para style="q" vid="PSA 80:17">n ziemne nang tei ngking kelu mina nabe reu gage.<verse eid="PSA 80:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 80:18" />Iciu de anui n dade nreutet dilak;</para>
  <para style="q" vid="PSA 80:18">anuide peu ringlu, ciciude anui nzi qu di zie.<verse eid="PSA 80:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 80:19" />Maleune peu kelabe RAMPAUBE Tinggwang, anuide retak dai lu;</para>
  <para style="q" vid="PSA 80:19">nzu kebaade anui reu gage baa gai lo, iciu de anui kelilu zie.<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="s">Oh, a minadung akwa kingneilo</para>
  <para style="d">Lei kempwakme muiteube ziemne; Gittith dage kerau tie telei kegai. Asaph reca lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 81:1" />Tinggwang dage anui kengkieng teu leitei sahgai lu;</para>
  <para style="q" vid="PSA 81:1">Jacob Tinggwang dage suiyi kwa sahbak gailo.<note caller="-" style="x"><char style="xo" closed="false">81:1 </char><char style="xt" closed="false"><ref loc="PSA 67:4">Lei. 67:4</ref></char></note><verse eid="PSA 81:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 81:2" />Lei tei lu nah tambourine,</para>
  <para style="q" vid="PSA 81:2">misui keyi leibung lyre nah harp pwa dap lu.<verse eid="PSA 81:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 81:3" />Anui hengyi tingba kemdeu dau keici,</para>
  <para style="q" vid="PSA 81:3">nah hekei bungri benai telui kwa gai lu.<verse eid="PSA 81:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 81:4" />Kedanemene aide Israelme ziemne hezai ge,</para>
  <para style="q" vid="PSA 81:4">Jacob Tinggwang ne aja kepeu zai ge.<note caller="+" style="f"><char style="fr" closed="false">81:4 </char><char style="ft" closed="false">Lei. 67:4</char></note><verse eid="PSA 81:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 81:5" />Pa hezaidung mzai kera kaibeu Joseph dage,</para>
  <para style="q" vid="PSA 81:5">Pa Egypt deu de mcau kecu dau, Ih makwa cikemak ge siu:<verse eid="PSA 81:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 81:6" />“Ih pepüt kerüt de pe hekeutu gade lwak dida; pe ba le nzap teukela rak de keumpet dida.<verse eid="PSA 81:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 81:7" />Nang keherei luge nang qugai, nah Ih ncu nghabeu;</para>
  <para style="q" vid="PSA 81:7">Ih nsam kelibeu herahang remangzing kebam gade.</para>
  <para style="q" vid="PSA 81:7">Ih ncu kedak gai Meribah<note caller="+" style="f"><char style="fr" closed="false">81:7 </char><char style="ft" closed="false">hetaideu</char></note> duidung gade.<note caller="+" style="f"><char style="fr" closed="false">81:7 </char><char style="ft" closed="false">Tet. 17:1-7; Pum. 20:2-13; Lei. 95:8-9</char></note> <char style="qs">Selah</char><verse eid="PSA 81:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 81:8" />Kingneilu, a minadung, kedanemene Ih nnuide mrai rang zie,</para>
  <para style="q" vid="PSA 81:8">Israel, magade nnui a kwa rünne kingnei zie cai!<verse eid="PSA 81:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 81:9" />Nnui kakga hera keda peu bam kerabe ma;</para>
  <para style="q" vid="PSA 81:9">nnui hera keda kette reca lak.<verse eid="PSA 81:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 81:10" />Ih RAMPAUBE nnui Tinggwang,</para>
  <para style="q" vid="PSA 81:10">nnuide Egypt deu gade ngngwa mpet kebeube.</para>
  <para style="q" vid="PSA 81:10">Nnui mui ngnga mdi gai, nah Ih tei pui beu zie.<note caller="+" style="f"><char style="fr" closed="false">81:10 </char><char style="ft" closed="false">Lei. 37:3-4</char></note><verse eid="PSA 81:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 81:11" />Dede a minadung a sam kingneilu tadi;</para>
  <para style="q" vid="PSA 81:11">Israel a samzai teilu tadi.<verse eid="PSA 81:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 81:12" />Cine Ih penui de penui zaira lungtak tei kera lampui ga ge kai beu di</para>
  <para style="q" vid="PSA 81:12">iciu eh penui miakngau gade dai petau bi teilu kerane.<note caller="+" style="f"><char style="fr" closed="false">81:12 </char><char style="ft" closed="false">Bat. 14:16</char></note><verse eid="PSA 81:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 81:13" />Oh, iciu eh a minadung a kwa kingneilu kera;</para>
  <para style="q" vid="PSA 81:13">oh, iciu eh a minadung a lampuidung ga tetlu kera.<verse eid="PSA 81:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 81:14" />Iciu lu cai Ih kelwa süt eh nggamlu zie penui ngauraume de</para>
  <para style="q" vid="PSA 81:14">nah a ba penui de teikeherei kelame dage hwa gai zie.<verse eid="PSA 81:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 81:15" />Rampaube de ngaurau kelame de peu pe dwa ga kehing le kepui sap ga la di zie!</para>
  <para style="q" vid="PSA 81:15">Peu penuide kelungta hengam teila dilu.<verse eid="PSA 81:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 81:16" />Ih Israel pok yitube wheat le tei zie;</para>
  <para style="q" vid="PSA 81:16">Ih nnuide peu nnung lu zie tangtsu gade kepet heliadui dele.”<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="s">Kenneime nah kegahme de kelilu</para>
  <para style="d">Asaph lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 82:1" />Tinggwang kemci ngkwa reuga sap bamla; kenret rabedung kakga pane tutiakbe tei bamla.<verse eid="PSA 82:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 82:2" />Dai tiege nang masang mene hetutiak lai</para>
  <para style="q1" vid="PSA 82:2">nah nnui kenlienme lam kepwa keulia lai? <char style="qs">Selah</char><verse eid="PSA 82:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 82:3" />Kegahme nah pepei kegahme de gum beulo;</para>
  <para style="q" vid="PSA 82:3">keherei nah kegahmedung mzeu lam saplu.<verse eid="PSA 82:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 82:4" />Kegahme nah mi ngha teumai kesiame de kelibeu lo;</para>
  <para style="q" vid="PSA 82:4">penui de kesiame ba gade keumpet beulo.<verse eid="PSA 82:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 82:5" />Kesiame ci luma, mede cet luma;</para>
  <para style="q" vid="PSA 82:5">penui malam ci mene kemui ga rwala di;</para>
  <para style="q" vid="PSA 82:5">kideube bangdwa leune pangpop dida.<verse eid="PSA 82:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 82:6" />Ih ranggai, “Nnui herabedung,</para>
  <para style="q" vid="PSA 82:6">nah nnui pelane Hutube Tinggwang namedung.<note caller="+" style="f"><char style="fr" closed="false">82:6 </char><char style="ft" closed="false">Jhn. 10:34</char></note><verse eid="PSA 82:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 82:7" />Iciu liede nnui minadung nzwa tsai dizie</para>
  <para style="q" vid="PSA 82:7">nah kau dizie hegwang na ge nzwa.”<verse eid="PSA 82:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 82:8" />Cuhlu, Tinggwang, kideu tutiak lo,</para>
  <para style="q" vid="PSA 82:8">kedanemene nang n mapwa heleuh pelane da bamlu.<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="s">O Tinggwang, mlei mene bam so</para>
  <para style="d">Lei ge. Asaph lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 83:1" />Tinggwang, nlei mene bam diso! Anui de püt diso nah mtak bam diso, Tinggwang.<verse eid="PSA 83:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 83:2" />Pielo, n ngauraume au kehebwak kaibam dida, nah ncu ngau keraume penui peudung ngang cuh bam dida.<verse eid="PSA 83:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 83:3" />Penui kenkiem ciem tei eh n minadung de mmau la nah ncütlwe heciem riem la nang gum kelume de mmau kerane.<verse eid="PSA 83:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 83:4" />Penui kakgade rangdi, “Gwanglu, nah anui penui leuh tei ngkap digo. Iciude Israel zi nsungtadilu kerane.”<verse eid="PSA 83:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 83:5" />Penui ncütlwe teigwang kera mariem ket riemlu; penui ngngwa zangna teilu ncu mmau kera,<verse eid="PSA 83:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 83:6" />Edom cuikui paikidung nah Ishmaelme, Moabme nah Hagritme.<verse eid="PSA 83:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 83:7" />Gebal, Ammon, Amalek; nah Philistiame de si eh nah Tyre namdi ga lungh kebamme.<verse eid="PSA 83:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 83:8" />Assyriame de si eh penui de ncütlu;</para>
  <para style="q" vid="PSA 83:8">penui reutak nia ge teilu Lot leuhme ziemne. <char style="qs">Selah</char><verse eid="PSA 83:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 83:9" />Penui dage teigai lo nang Midiame<note caller="+" style="f"><char style="fr" closed="false">83:9 </char><char style="ft" closed="false">Gideon mene penuide ngamlu judges 6:8 </char></note> dage teikegai nzwa,</para>
  <para style="q" vid="PSA 83:9">nang Kishon reu gade Sisera nah Jabin dage tei kegai nzwa.<verse eid="PSA 83:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 83:10" />Penui Endor gade kap ga dida</para>
  <para style="q" vid="PSA 83:10">nah kideu be mania lungyi kera deige nzwa tei dida.<note caller="+" style="f"><char style="fr" closed="false">83:10 </char><char style="ft" closed="false">Tut. 4:1-24</char></note><verse eid="PSA 83:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 83:11" />Penui kedime dage Oreb nah Zeeb da tei kegai nzwa tei gai lo,</para>
  <para style="q" vid="PSA 83:11">nah penui hegwangna medung pelane dage Zebah nah Zalmunna da tei kegai nzwa tei gailo.<verse eid="PSA 83:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 83:12" />Penui ranggai, “Ko anui katei</para>
  <para style="q" vid="PSA 83:12">Tinggwang deu keyi de luulu go.”<verse eid="PSA 83:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 83:13" />A Tinggwang, penui de tingkainrui rebui nzwa teu nrui dilo,</para>
  <para style="q" vid="PSA 83:13">reigau tingkai ne gui gidi kela nzwa,<verse eid="PSA 83:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 83:14" />mi hegung ru di kela nzwa,</para>
  <para style="q" vid="PSA 83:14">nah miheu lamlwatu dung ru di kela nzwa.<verse eid="PSA 83:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 83:15" />Penui de gwalo n kengkieng tingkai le,</para>
  <para style="q" vid="PSA 83:15">nah penui de keheu lo n rahang tingkai le.<verse eid="PSA 83:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 83:16" />Penui zu dung hengam le peu pui lu</para>
  <para style="q" vid="PSA 83:16">iciu eh penui nzi peei lubui, RAMPAUBO.<verse eid="PSA 83:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 83:17" />Penuide hengam gage kai beu di lu nah kelungta keheu la dilo;</para>
  <para style="q" vid="PSA 83:17">penuide peu hengam le pung tsaitim gah dilo.<verse eid="PSA 83:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 83:18" />Iciude penui cilu zie nang rünne, RAMPAUBE,</para>
  <para style="q" vid="PSA 83:18">kideu pelane reu Hutube Tinggwang lie kecu.<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="s">A rabe au RAMPAUBE ki regui bam</para>
  <para style="d">Lei kempwakme muiteube ziemne; Gittith dage kerau tie telei kegai. Korah napeidung gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 84:1" />Nang lungh kebam ni de dai kenzwa gede yino,</para>
  <para style="q" vid="PSA 84:1">Reugwame reu RAMPAUBE!<verse eid="PSA 84:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 84:2" />RAMPAUBE kigudung ga Ih bam kera regui lie, a hengim cide ziemne acu tei leu dida.</para>
  <para style="q" vid="PSA 84:2">Ih a keringria nah a nlung pelane teu lei tei ring kela Tinggwang de twa zie.<verse eid="PSA 84:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 84:3" />Tangkine liede pe ki ngaulu</para>
  <para style="q" vid="PSA 84:3">nah tanghaine pekatei pe ziemne peciep ge mtei lu cika pe na de mbumlu kerane</para>
  <para style="q" vid="PSA 84:3">n recabam taiga, reugwame reu RAMPAUBE,</para>
  <para style="q" vid="PSA 84:3">a gwangpei, nah a Tinggwang.<verse eid="PSA 84:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 84:4" />N ki ga lungh kebamme au samlam pung lie;</para>
  <para style="q" vid="PSA 84:4">penui ncu twa jüja bam. <char style="qs">Selah</char><verse eid="PSA 84:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 84:5" />N dade mina pe kengkieng ngaulu kelame daikenzwa gede yi no,</para>
  <para style="q" vid="PSA 84:5">penui Zion deutu ga reca beu neu lala.<verse eid="PSA 84:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 84:6" />Miakduidung Langkam<note caller="+" style="f"><char style="fr" closed="false">84:6 </char><char style="ft" closed="false">Baca langkam</char></note> de tetkah gwang, penui dui sak kera duiletdung ngaulu.</para>
  <para style="q" vid="PSA 84:6">Tingrui keraibe ne cide samlam pui beula.<verse eid="PSA 84:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 84:7" />Penui kengkieng gade kengkieng keda ga miela;</para>
  <para style="q" vid="PSA 84:7">penui pelane Zion<note caller="+" style="f"><char style="fr" closed="false">84:7 </char><char style="fq" closed="false">Zion </char><char style="ft" closed="false">Jerusalem</char></note> ga Tinggwang dwaga gwang.<verse eid="PSA 84:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 84:8" />RAMPAUBE Tinggwang, a kekie kingnei lo;</para>
  <para style="q" vid="PSA 84:8">Jacob Tinggwang, Ih dai rang au bi kingnei lulo! <char style="qs">Selah</char><verse eid="PSA 84:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 84:9" />Tinggwang, anui gu reunet ma piebeu lo;</para>
  <para style="q" vid="PSA 84:9">nangne keniak kelu hegwangpei de.<verse eid="PSA 84:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 84:10" />Kedanemene keda ga pecang swade n tutiak kidung ga tingnai ge be yiki.</para>
  <para style="q" vid="PSA 84:10">Ih a Tinggwang kiga kikam kekwabe tei neu,</para>
  <para style="q" vid="PSA 84:10">kesiame paikidung ga lungh kebam swade.<verse eid="PSA 84:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 84:11" />Kedanemene RAMPAUBE Tinggwang au anuide gum kelabe nah anui geu;</para>
  <para style="q" vid="PSA 84:11">RAMPAUBE ne ngaugia nah kendu peu zie;</para>
  <para style="q" vid="PSA 84:11">keyi tei kelame de pa madaude keyibe peu tadi lama<verse eid="PSA 84:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 84:12" />Reugwame reu RAMPAUBE,</para>
  <para style="q" vid="PSA 84:12">ncu nlum kelu minabe au samlam pung lie.<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="s">Anuide teingkieng dai beulo</para>
  <para style="d">Lei kempwakme muiteube ziemne. Korah napeidung gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 85:1" />RAMPAUBO, nang n deudi Israel de ngaugia keulia da;</para>
  <para style="q" vid="PSA 85:1">nang Jacob teilung tei ngkei beuda.<verse eid="PSA 85:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 85:2" />Nang n minadung mau gibeu dida;</para>
  <para style="q" vid="PSA 85:2">nang penui mau de hacim dida. <char style="qs">Selah</char><verse eid="PSA 85:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 85:3" />Nang n lunghop pelane keu caili dida;</para>
  <para style="q" vid="PSA 85:3">nang n rata kesia gade nreu caili dida.<verse eid="PSA 85:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 85:4" />Anuide tei mcangbeu, anuide kelikebeube Tinggwang,</para>
  <para style="q" vid="PSA 85:4">nah n suikemakpe anui dade keumzia di beu.<verse eid="PSA 85:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 85:5" />Nang kelungta anuide n rata la dizie ni?</para>
  <para style="q" vid="PSA 85:5">Gwangdai kera ceheudung bai nang n rata bam zie ni?<verse eid="PSA 85:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 85:6" />Nang anuide keli dai beu lak ni?</para>
  <para style="q" vid="PSA 85:6">Ciu eh n minadung nda pesuiyi lu zie.<verse eid="PSA 85:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 85:7" />N samkak kesamsang anuide keulia lo, RAMPAUBO,</para>
  <para style="q" vid="PSA 85:7">n kelikelu anuide peulo.<verse eid="PSA 85:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 85:8" />RAMPAUBE Tinggwang kerang de Ih kingnei zie,</para>
  <para style="q" vid="PSA 85:8">kedanemene pa pe minadung de ngngwa kezuyi teizie, pecu kenlum medung.</para>
  <para style="q" vid="PSA 85:8">Ciuliede penui kemang lampui ga nreutet daidi kerabe ma.<verse eid="PSA 85:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 85:9" />Tinggwang de hing kelame da pe kelikelu au nna gwang kesang la dida;</para>
  <para style="q" vid="PSA 85:9">ciu eh kemdu de anui deu ga bamlu zie.<verse eid="PSA 85:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 85:10" />Samkak kelu kesamsangbe nah nlumlukebui gwang redau luda;</para>
  <para style="q" vid="PSA 85:10">Makesangbe nah lungciep hangge ge de kemam zie.<verse eid="PSA 85:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 85:11" />Kenlum kesangbe hangdeu kang gade cuh lula,</para>
  <para style="q" vid="PSA 85:11">nah makesangbe tinggim gade pie nghung la.<verse eid="PSA 85:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 85:12" />Yeo, RAMPAUBE pe samlam keyidung peu zie,</para>
  <para style="q" vid="PSA 85:12">nah anui deu ga petsi bui luzie.<verse eid="PSA 85:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 85:13" />Makesangbe pe dwaga lazie</para>
  <para style="q" vid="PSA 85:13">nah pe pidaudung telei beuzie.<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="s">N keku au dizu lie</para>
  <para style="d">David gu kekie ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 86:1" />A kekie kingnei gailo, RAMPAUBO, nah a kekei keli beulo,</para>
  <para style="q" vid="PSA 86:1">kedanemene Ih au magah nah kengha teumaisia bam.<verse eid="PSA 86:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 86:2" />Acu gumlu, kedanemene Ih au samsang;</para>
  <para style="q" vid="PSA 86:2">a Tinggwang, ncu nlum kebam n kilabe acu kelilu.<verse eid="PSA 86:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 86:3" />Acu ngaunggia lo, Rampaubo,</para>
  <para style="q" vid="PSA 86:3">kedanemene Ih tingbazie pelane n dage hapgai bam.<verse eid="PSA 86:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 86:4" />N kilabe suiyi teilu,</para>
  <para style="q" vid="PSA 86:4">kedanemene n dage, Rampaubo, Ih a rabe teucuh gaila.<verse eid="PSA 86:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 86:5" />Rampaubo, nang au yi, nah kemaugi kera kwabam,</para>
  <para style="q" vid="PSA 86:5">nah n dage hap pet kegaime pelane de nang ngaugia kedi keulia.<verse eid="PSA 86:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 86:6" />RAMPAUBO, a kekie kingnei lo;</para>
  <para style="q" vid="PSA 86:6">a nggia kwa de siulo.<verse eid="PSA 86:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 86:7" />Ih keherei kelu benai Ih ncu qula,</para>
  <para style="q" vid="PSA 86:7">kadenemene nang acu keli zie.<verse eid="PSA 86:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 86:8" />Rabedung kakgade keukeda kera nang kenzwa mide gah, Rampaubo.</para>
  <para style="q" vid="PSA 86:8">N tadung nzwa heta kedabe bam ma.<verse eid="PSA 86:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 86:9" />Heleuh pelane nangne tei kegaibe gwang nah n dwaga keumie zie, Rampaubo.</para>
  <para style="q" vid="PSA 86:9">Penui n zi de herüt peuzie.<note caller="-" style="x"><char style="xo" closed="false">86:9 </char><char style="xt" closed="false"><ref loc="REV 15:4">Keu. 15:4</ref></char></note><verse eid="PSA 86:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 86:10" />Kedanemene nang au di nah miswakegah tadung teigai;</para>
  <para style="q" vid="PSA 86:10">nang rünne Tinggwang.<verse eid="PSA 86:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 86:11" />N zaidung acu ledeu beulo, RAMPAUBO. Ciciu lude Ih masang eh n sam mzai luzie.</para>
  <para style="q" vid="PSA 86:11">A nlung pelane teu n ta tei kera acu ledeu beulo.<verse eid="PSA 86:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 86:12" />Rampaube a Tinggwang, a nlung pelane teu Ih ncu twa zie;</para>
  <para style="q" vid="PSA 86:12">Ih n zi kelungta ndu lamui zie.<verse eid="PSA 86:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 86:13" />Kedanemene n samkak kesamsangbe ada au dizu;</para>
  <para style="q" vid="PSA 86:13">Ketsaime deu kecok gade nang a teilung kelibeu da.<verse eid="PSA 86:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 86:14" />Tinggwang, pezai kesiame acu mmau cuh zeu.</para>
  <para style="q" vid="PSA 86:14">Keregi kecu hemaa ge a teilung peeila dida.</para>
  <para style="q" vid="PSA 86:14">Penui ncu rüt kecu ga.<verse eid="PSA 86:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 86:15" />Dede nang, Rampaubo, au ngaugiabe nah ngaugia Tinggwang,</para>
  <para style="q" vid="PSA 86:15">zette rata lama, nah samkak kesamsangbe nah kenlum kesangbe ne kepui tei.<verse eid="PSA 86:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 86:16" />A taile nreugwang nah acu ngaunggia lo;</para>
  <para style="q" vid="PSA 86:16">n kengkieng n kilabe de peulo;</para>
  <para style="q" vid="PSA 86:16">n kila pui napei de kelibeu lo.<verse eid="PSA 86:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 86:17" />N ngaugia rehi ge acu keulia gailo.</para>
  <para style="q" vid="PSA 86:17">Ciu eh acu ngau nghet kelame cide ngau luzie nah hengam gage kaizie</para>
  <para style="q" vid="PSA 86:17">kedanemene nang, RAMPAUBE, acu nghabeu nah acu teirelui beuda.<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="s">N kendu ha ranggai zeuda</para>
  <para style="d">Korah napeidung gu lei ge; lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 87:1" />RAMPAUBE namdi teuncuh kelu kemci deutu ga sapbam;<verse eid="PSA 87:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 87:2" />RAMPAUBE Jacob gu paikidung pelane swade</para>
  <para style="q" vid="PSA 87:2">Zion<note caller="+" style="f"><char style="fr" closed="false">87:2 </char><char style="fq" closed="false">Zion: </char><char style="ft" closed="false">Jerusalem </char></note> kiriedung de be hung ki.<verse eid="PSA 87:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 87:3" />Kendu dungde n gu lie eh rangzie, Tinggwang namdi.<note caller="+" style="f"><char style="fr" closed="false">87:3 </char><char style="fq" closed="false">Tinggwang namdi: </char><char style="ft" closed="false">Jerusalem.</char></note> <char style="qs">Selah</char><verse eid="PSA 87:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 87:4" />“Ih a caisuime dage Rahab penai Babylon zi ranggai.</para>
  <para style="q" vid="PSA 87:4">Pielo, cika Philistia bam, nah Tyre, Cush de si eh,</para>
  <para style="q" vid="PSA 87:4">nah rangzie, ‘Aipaude au cika de mna da.’”<verse eid="PSA 87:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 87:5" />Zion gade aide rangzie, “Aidung ketket kecu pe dade mna lu;</para>
  <para style="q" vid="PSA 87:5">nah Hutube Tinggwang pa pekatei ne pecu damgai beuzie.”<verse eid="PSA 87:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 87:6" />RAMPAUBE heleuhdung zi kerau laisiukwak gage rau lude, pa rangzie,</para>
  <para style="q" vid="PSA 87:6">“Penui pelane Jerusalemme tei kap luzie.” <char style="qs">Selah</char><verse eid="PSA 87:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 87:7" />Cine lei keteime nah helim limcume liede ngngwa rang eh,</para>
  <para style="q" vid="PSA 87:7">“A duiletdung pelane n da bam.”<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="s">Ih tingmui tingba n dwaga sah bam</para>
  <para style="d">Lei ge, Korah napeidung gu lei ge; Lei kempwakme muiteube ziemne; Mahalath Leannoth ciem gage telei gailu. Ezrame Heman gu Maschil ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 88:1" />RAMPAUBE, a kelikelube Tinggwang,</para>
  <para style="q" vid="PSA 88:1">Ih n dwaga tingmui tingba happet gaila.<verse eid="PSA 88:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 88:2" />A kekie kingnei lo;</para>
  <para style="q" vid="PSA 88:2">a hap de heling sünne gaibeu lo.<verse eid="PSA 88:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 88:3" />Kedanemene Ih au kehereidung ne kepui teibam,</para>
  <para style="q" vid="PSA 88:3">nah a teilung ketsaime deu ga gwang cang dida.<verse eid="PSA 88:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 88:4" />Mina acu hekwaki ga nghungdi kelame nzwa tei gaila.</para>
  <para style="q" vid="PSA 88:4">Ih au mina kengkieng kegame ge.<verse eid="PSA 88:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 88:5" />Ketsaime kakga ge acu gi dida;</para>
  <para style="q" vid="PSA 88:5">Ih au ketsaime ge herau ga zeu kebam nzwa da,</para>
  <para style="q" vid="PSA 88:5">migede nsung ta dida</para>
  <para style="q" vid="PSA 88:5">kedanemene penui au nha cang gai lak delu<verse eid="PSA 88:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 88:6" />Nang acu hekwaki henatu sau gage kaigai,</para>
  <para style="q" vid="PSA 88:6">kemuibe nah kecok bamdung ga.<verse eid="PSA 88:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 88:7" />N lunghop a reuga rützu di,</para>
  <para style="q" vid="PSA 88:7">nah n cuidung pelane a reuga kaugai. <char style="qs">Selah</char><verse eid="PSA 88:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 88:8" />N ziemne, a zangme acu mlai dida.</para>
  <para style="q" vid="PSA 88:8">Nang acu penui miakngau gade miswakegah ge tei dida.</para>
  <para style="q" vid="PSA 88:8">Ih au pelung ga nam pwabam dida nah Ih pak gailak dida.<note caller="+" style="f"><char style="fr" closed="false">88:8 </char><char style="ft" closed="false">Job 19:13, Lei. 31:11, Luk. 23:49</char></note><verse eid="PSA 88:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 88:9" />Keherei ziemne a miak mnei reureu dida;</para>
  <para style="q" vid="PSA 88:9">Tingbazie pelane Ih ncu qu pet gai, RAMPAUBO;</para>
  <para style="q" vid="PSA 88:9">Ih n dage a ba nzang pet gaila.<verse eid="PSA 88:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 88:10" />Nang ketsaime ziemne miswakegahdung tei zieni?</para>
  <para style="q" vid="PSA 88:10">Tsai kedime cuh eh ncu twa zieni? <char style="qs">Selah</char><verse eid="PSA 88:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 88:11" />N samkakkelu samsang de herau gade rang lani,</para>
  <para style="q" vid="PSA 88:11">n lungsang ha de ngkapdi kela ni gade rangla ni?<verse eid="PSA 88:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 88:12" />Kemui gade n tadung miswakegah de,</para>
  <para style="q" vid="PSA 88:12">mede nsungta kedi bam gade n masang de cilu zieni?<verse eid="PSA 88:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 88:13" />Dede Ih n dage hapgai, RAMPAUBO;</para>
  <para style="q" vid="PSA 88:13">tingcang a kekie n dwaga gwangla.<verse eid="PSA 88:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 88:14" />RAMPAUBO, nang daitei eh acu mlai dino?</para>
  <para style="q" vid="PSA 88:14">Daitei eh nang a dade n zu kebai dino?<verse eid="PSA 88:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 88:15" />Ih au kebamtane keherei bam nah a henane gade tsai dilu nage eh lala.</para>
  <para style="q" vid="PSA 88:15">N kengngidung gade Ih keherei dida; Ih au keregui gah da.<verse eid="PSA 88:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 88:16" />N rata zairelidung a reuga kah gwang,</para>
  <para style="q" vid="PSA 88:16">nah n tadung ngaukehing ne acu ngkap dida.<verse eid="PSA 88:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 88:17" />Tingbazie pelane penui acu dui kedi nzwa twagwa bam;</para>
  <para style="q" vid="PSA 88:17">penui pelane acu twagwapung bam.<verse eid="PSA 88:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 88:18" />Nang a dade zangname nah kangngwame leune de keugi dida.</para>
  <para style="q" vid="PSA 88:18">Kemuibe rünne a kangngwa dida.<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="s">Ih RAMPAUBE keku de lei teizie</para>
  <para style="d">Ezrame Ethan gu maschil ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 89:1" />Ih kelungta RAMPAUBE samkakkelu samsang tadung lei tei zie.</para>
  <para style="q" vid="PSA 89:1">Ih n samsang ha de lunghgwang kera ceheudung de rang zie.<verse eid="PSA 89:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 89:2" />Kedanemene Ih rang dida, “Samkak masangbe au kelungta ziemne teilu;</para>
  <para style="q" vid="PSA 89:2">N kesamsang nang tinggimdung ga teikelude.”<verse eid="PSA 89:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 89:3" />“Ih kedetkelu gede ngngwa samkak ge tei pwabam,</para>
  <para style="q" vid="PSA 89:3">Ih a kilabe David dage sampet tei pwabam.<verse eid="PSA 89:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 89:4" />‘Ih n leuhme kelungta ziemne tei beuzie,</para>
  <para style="q" vid="PSA 89:4">nah Ih ceuheudung pelane gade n hegwangbam telei beuzie.”<note caller="+" style="f"><char style="fr" closed="false">89:4 </char><char style="ft" closed="false">Jhn. 7:42, 2 Sam. 7:11-16</char></note> <char style="qs">Selah</char><verse eid="PSA 89:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 89:5" />Tinggimdung nang miswa kegah batadung tei kegai de twala, RAMPAUBO;</para>
  <para style="q" vid="PSA 89:5">kemcime gwang ngkwakelu ga n kesamsang de twa bam.<verse eid="PSA 89:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 89:6" />Tinggim ga RAMPAUBE de keukeda kera cau bamno?</para>
  <para style="q" vid="PSA 89:6">Rabe namedung kakga cau RAMPAUBE zwa bamno?<verse eid="PSA 89:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 89:7" />Pa au kemci medung kangbau gade hetwa peusüt kecu Tinggwang ge</para>
  <para style="q" vid="PSA 89:7">nah pecu twagwa kebamme dade yisüt.<note caller="+" style="f"><char style="fr" closed="false">89:7 </char><char style="ft" closed="false">2 The. 1:10, Lei. 76:7, 11.</char></note><verse eid="PSA 89:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 89:8" />RAMPAUBE Tinggwang,</para>
  <para style="q" vid="PSA 89:8">cauge nang nzwa ngkieng no, RAMPAUBO?</para>
  <para style="q" vid="PSA 89:8">N kesamsang de ncu twagwa bam.<verse eid="PSA 89:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 89:9" />Nang nswak kebam jaaidi reu di;</para>
  <para style="q" vid="PSA 89:9">duicuidung nswak cuh kecudau, nang penuide kezeu lula.<verse eid="PSA 89:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 89:10" />Nang Rahab de teitakcai di ketsaime ge nzwa.</para>
  <para style="q" vid="PSA 89:10">Nang n ba kengkieng dene n ngauraume de teuzang di.<note caller="+" style="f"><char style="fr" closed="false">89:10 </char><char style="ft" closed="false">Luk. 1:51, Isa. 51:9</char></note><verse eid="PSA 89:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 89:11" />Tinggimdung au n gu, nah kideube liede.</para>
  <para style="q" vid="PSA 89:11">Nangne kideu teigai nah cika kebam pelane.<note caller="+" style="f"><char style="fr" closed="false">89:11 </char><char style="ft" closed="false">1 Cor. 10:26, Lei. 24:1-2</char></note><verse eid="PSA 89:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 89:12" />Nang ne nreule nah ngkangle de damgai.</para>
  <para style="q" vid="PSA 89:12">Tabor penai Hermon lamlwa n zi gade pe suiyi bam.<verse eid="PSA 89:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 89:13" />N da kengkieng ba ge bam</para>
  <para style="q" vid="PSA 89:13">nah heba kengkieng ge, nah n ba zetle au huzu.<verse eid="PSA 89:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 89:14" />Kesangbe nah kemzuibe au n hegwangbam gu bandwabe.</para>
  <para style="q" vid="PSA 89:14">Samkak kelu samsang nah nlumlukebui n dwaga gwang.<verse eid="PSA 89:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 89:15" />Mina ncu reca au samlampung lie!</para>
  <para style="q" vid="PSA 89:15">RAMPAUBO, penui n keba ga tet la.<verse eid="PSA 89:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 89:16" />Tingbazie pelane n zi gade penui suiyi bamla,</para>
  <para style="q" vid="PSA 89:16">nah n samsangbe gade penui ncu hetwa peula.<verse eid="PSA 89:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 89:17" />Nang au penui kengkieng ditube,</para>
  <para style="q" vid="PSA 89:17">n kengha ne anui ngkieng luda.<verse eid="PSA 89:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 89:18" />Kedanemene RAMPAUBE nang anuide kegumbe;</para>
  <para style="q" vid="PSA 89:18">anuide anui gwangpei Israel kemcime Tinggwang peu da.<verse eid="PSA 89:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 89:19" />Nang ndaa ge ncu nlum kelame dage marengei gade rang;</para>
  <para style="q" vid="PSA 89:19">nang rang eh, “Ih kengkieng ge reu peurwa ge telei beu dida.”</para>
  <para style="q" vid="PSA 89:19">Ih minadung kakgade hangge de kedet luda.<verse eid="PSA 89:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 89:20" />Ih a kilabe David de kedet luda;</para>
  <para style="q" vid="PSA 89:20">agu kemci maca le Ih pecu keniak luda.<note caller="+" style="f"><char style="fr" closed="false">89:20 </char><char style="ft" closed="false">Bat. 13:22</char></note><verse eid="PSA 89:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 89:21" />A ba pecu ngha zie;</para>
  <para style="q" vid="PSA 89:21">a ba pecu teingkieng beuzie.<verse eid="PSA 89:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 89:22" />David ge ngauraume migede pecu cwa gailak;</para>
  <para style="q" vid="PSA 89:22">kesiabe name migede pecu teikeherei gailak.<verse eid="PSA 89:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 89:23" />Ih pe dwa gade pe ngauraume de teitakcai dizie;</para>
  <para style="q" vid="PSA 89:23">Pecu ngaurau kelame de Ih teitset dizie.<verse eid="PSA 89:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 89:24" />A lungsangbe nah a samkak kesamsang peda lazie;</para>
  <para style="q" vid="PSA 89:24">a zi gade pa ngkieng luzie.<verse eid="PSA 89:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 89:25" />Ih pe ba keu jaaidi reu gage kaizie</para>
  <para style="q" vid="PSA 89:25">nah pe ba zetle hereukidung gage.<verse eid="PSA 89:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 89:26" />Pa acu qu pet zie, ‘Nang au a Pei,</para>
  <para style="q" vid="PSA 89:26">a Tinggwang, nah a kelikelu tsurabe.’<note caller="+" style="f"><char style="fr" closed="false">89:26 </char><char style="ft" closed="false">1 Pet. 1:17, Keu. 21:7</char></note><verse eid="PSA 89:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 89:27" />Ih pecu a neraibe nzwa eh tei luzie,</para>
  <para style="q" vid="PSA 89:27">kideu gade hegwangdung reu ditube.<verse eid="PSA 89:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 89:28" />Ih a samkak kesamsang de pe da kelungta lazie;</para>
  <para style="q" vid="PSA 89:28">nah a samkak pe da kela de gumla luzie.<verse eid="PSA 89:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 89:29" />Ih pe leuhme depeu kelungta bammui zie</para>
  <para style="q" vid="PSA 89:29">nah pe hegwangbam de tingkamdung nzwa bammui zie,<verse eid="PSA 89:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 89:30" />Magade pe name a zai de gi dicai</para>
  <para style="q" vid="PSA 89:30">nah agu ajadung ga tet luta dicai,<verse eid="PSA 89:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 89:31" />magade penui a zaidung gikah</para>
  <para style="q" vid="PSA 89:31">nah agu ajadung kainzeu lu mecai,<verse eid="PSA 89:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 89:32" />iciu cai Ih penui mau ziemne saja peu zie</para>
  <para style="q" vid="PSA 89:32">nah penui samzai tei kemak ziemne peu keherei zie.<verse eid="PSA 89:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 89:33" />Dede Ih pe dade a keku de bammui kelade keugi lak</para>
  <para style="q" vid="PSA 89:33">mede a sampet gade samsang tadi lak.<verse eid="PSA 89:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 89:34" />Ih a samkak teipang dilak</para>
  <para style="q" vid="PSA 89:34">mede a mui gade kepet a samdung keli dilak.<verse eid="PSA 89:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 89:35" />Piage nah pelane ziemne Ih a kemci gade sampet gaila,</para>
  <para style="q" vid="PSA 89:35">Ih David dade kenret lak:<verse eid="PSA 89:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 89:36" />pe leuhme kelungta bammui zie</para>
  <para style="q" vid="PSA 89:36">nah pe hegwangbam, tingnaimiak a dwaga kebamtane.<note caller="+" style="f"><char style="fr" closed="false">89:36 </char><char style="ft" closed="false">Luk. 1:32-33</char></note><verse eid="PSA 89:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 89:37" />Cide au hekei nzwa kelungta bammui zie,</para>
  <para style="q" vid="PSA 89:37">tinggim ga samsang zierangbe nzwa. <char style="qs">Selah</char><verse eid="PSA 89:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 89:38" />Dede nang mneilu ma nah mlai di;</para>
  <para style="q" vid="PSA 89:38">nang n gwangpei keniak kelube de n rata bam.<verse eid="PSA 89:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 89:39" />Nang n kilabe samkak de gi dida.</para>
  <para style="q" vid="PSA 89:39">Nang pe peurwa keumpet hangdeu gage kai dida.<verse eid="PSA 89:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 89:40" />Nang namdibe kiriedung pelane teingkau dida.</para>
  <para style="q" vid="PSA 89:40">Nang pe kudadung teingkap dida.<verse eid="PSA 89:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 89:41" />Tetkah kegwang kela mileune pegu rega.</para>
  <para style="q" vid="PSA 89:41">Pa pe kidame dade mingkau kepung ge dida.<verse eid="PSA 89:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 89:42" />Nang pe ngauraume ba zetle teucuh gai;</para>
  <para style="q" vid="PSA 89:42">nang pe ngauraume pelane suiyi teidi.<verse eid="PSA 89:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 89:43" />Nang pe kingtie keu kemta tei dida</para>
  <para style="q" vid="PSA 89:43">nah nang pecu hereu tei kecu dau ngha raudi<verse eid="PSA 89:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 89:44" />Nang pe keyi de penli gage teugwang dida;</para>
  <para style="q" vid="PSA 89:44">nang pe hegwangbam de hangdeu gage teu nghung dida.<verse eid="PSA 89:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 89:45" />Nang pe rehangting de teindui dida.</para>
  <para style="q" vid="PSA 89:45">Nang hengam ne pecu teicim dida. <char style="qs">Selah</char><verse eid="PSA 89:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 89:46" />Dai tiege, RAMPAUBO? Nang nkatei ncu kebai pwabam zieno, kelungta?</para>
  <para style="q" vid="PSA 89:46">Dai tiege n rata mih nzwa heu bam zie no?<verse eid="PSA 89:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 89:47" />Oh, a ting dai duige bi cet gailo,</para>
  <para style="q" vid="PSA 89:47">nah dai kemta ge ziemne nang n namedung pelane de damgai bi!<verse eid="PSA 89:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 89:48" />Cauge tsaidi mene ringlubui bi,</para>
  <para style="q" vid="PSA 89:48">mede Sheol ba gade pekatei pe teilung kelilu buino?<verse eid="PSA 89:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 89:49" />Rampaubo, daiga n samkak kesamsang tadung de bamno</para>
  <para style="q" vid="PSA 89:49">nang David dage n samsangbe gade sampet kebeude?<verse eid="PSA 89:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 89:50" />Nsung gailo, Rampaubo, n kilame dage kemneu tatei kegai</para>
  <para style="q" vid="PSA 89:50">nah dainzwa Ih heleuhdung dade kemneudung kekieege lialu dibi.<verse eid="PSA 89:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 89:51" />N ngauraume kemneudung kelien gai, RAMPAUBO;</para>
  <para style="q" vid="PSA 89:51">penui nangne keniak kelube pipadung rangmsia.<verse eid="PSA 89:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 89:52" />RAMPAUBE de kelungta samlam punglo.</para>
  <para style="q" vid="PSA 89:52">Amen nah Amen.<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms">Laisiukwak Mdaibe</para>
  <para style="s">Bam muikela gade bam muikela</para>
  <para style="d">Tinggwang nabe Moses gu kekie ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 90:1" />Rampaubo, nang au anui kemsiube</para>
  <para style="q" vid="PSA 90:1">ceheudung pelane gade.<verse eid="PSA 90:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 90:2" />Lamlwadung damgai kemakdwa,</para>
  <para style="q" vid="PSA 90:2">mede nang hangdeu nah kideu damgai kemakne,</para>
  <para style="q" vid="PSA 90:2">kelungta gade kelungta ga, nang au Tinggwang.<verse eid="PSA 90:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 90:3" />Nang mina de rebui gage tei cailigai,</para>
  <para style="q" vid="PSA 90:3">nah nang rang, “Nnui mina leuhdung, caili dai dilu.”<verse eid="PSA 90:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 90:4" />Kedanemene n miakngau gade mmi cang ge</para>
  <para style="q" vid="PSA 90:4">au nziene cide gwang kedibenai nzwa,</para>
  <para style="q" vid="PSA 90:4">nah tingmui dau bamdakkak kecam nage nzwa.<note caller="+" style="f"><char style="fr" closed="false">90:4 </char><char style="ft" closed="false">1 Pet. 3:8</char></note><verse eid="PSA 90:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 90:5" />Nang mina de duinai nzwa biakgi dila nah penui zipdi;</para>
  <para style="q" vid="PSA 90:5">tingcangdau penui cehei bang pwakcuh kecu nzwada.<verse eid="PSA 90:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 90:6" />Tingcangdau cide papet nah lunghcuh la;</para>
  <para style="q" vid="PSA 90:6">tinghegi cide kii nah cangh dila.<verse eid="PSA 90:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 90:7" />Kesang lie, anui au n rata ne mnwa lu,</para>
  <para style="q" vid="PSA 90:7">nah n lunghop gade anui ngngi mbeu bam.<verse eid="PSA 90:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 90:8" />Nang anui zaisietdung n dwaga kailu,</para>
  <para style="q" vid="PSA 90:8">mede kebai pwakebam maudung n kebaa dwa gade.<verse eid="PSA 90:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 90:9" />Anui teilung n lunghop gade gah di bam;</para>
  <para style="q" vid="PSA 90:9">anui mmidung mi ngi nzwa tetgui dizeu.<verse eid="PSA 90:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 90:10" />Anui mmidung au riakhena,</para>
  <para style="q" vid="PSA 90:10">mede riakheset anui pum yincang bam liecai;</para>
  <para style="q" vid="PSA 90:10">dede anui mmi yitube liede keherei nah lungrei ne puibam.</para>
  <para style="q" vid="PSA 90:10">Yeo, penui zette pak bam, nah anui lim tetti zeu.<verse eid="PSA 90:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 90:11" />Cauge n rata kengkieng de ci no,</para>
  <para style="q" vid="PSA 90:11">nah n lunghop de ncu kehing de nsamdi kecu?<verse eid="PSA 90:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 90:12" />Cine anui teilung pielu kera anuide ledeu beulo</para>
  <para style="q" vid="PSA 90:12">ciu eh anui maci eh lungh lu kerane.<verse eid="PSA 90:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 90:13" />Nreu cailigai, RAMPAUBO! Cide dai tiege laino?</para>
  <para style="q" vid="PSA 90:13">N kilamedung de ngaunggia gailo.<verse eid="PSA 90:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 90:14" />N samkakkelu kesamsang le tingcangdau anui lung taumla gailo</para>
  <para style="q" vid="PSA 90:14">ciu eh anui tingbaziedung leune ga anui suiyi süt bamlu kerane.<verse eid="PSA 90:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 90:15" />Nang anuide teikeherei kegai rehi gade tingbaziedung kieege anui suiyi teilo</para>
  <para style="q" vid="PSA 90:15">nah anui keherei daukecu mmidung kieege.<verse eid="PSA 90:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 90:16" />Peu n kilamedung de n bata ngaulo,</para>
  <para style="q" vid="PSA 90:16">nah n name de peu n kemdu ngaulo.<verse eid="PSA 90:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 90:17" />Peu Rampaube anui Tinggwang zai keyi de anui gu kelube tei lulo;</para>
  <para style="q" vid="PSA 90:17">anui badung le teikegai lungh yilu;</para>
  <para style="q" vid="PSA 90:17">kesang, anui badung le teikegai lungh yilu.<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="s">A kensiuki nah A kengkieng bam</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 91:1" />Hutube Tinggwang msiu ga lungh kebambe au</para>
  <para style="q" vid="PSA 91:1">Ngkiengtube miekang ga bamzie.<verse eid="PSA 91:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 91:2" />Ih RAMPAUBE ha rangzie, “Pa a kemsiube nah acu kegumbe,</para>
  <para style="q" vid="PSA 91:2">a Tinggwang, Ih nlumla kelabe.”<verse eid="PSA 91:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 91:3" />Kedanemene pa ncu rehume ba gade kelibeu zie</para>
  <para style="q" vid="PSA 91:3">nah rapia siasüt kecu gade.<verse eid="PSA 91:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 91:4" />Pa pe hesiudung ne ncu gum beuzie,</para>
  <para style="q" vid="PSA 91:4">nah pe hesiudung kangga nang msiu kera ngau luzie.</para>
  <para style="q" vid="PSA 91:4">Pe masang au kegumbe nah kemsiube.<verse eid="PSA 91:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 91:5" />Nang tingmui kengngi gede hing dilak,</para>
  <para style="q" vid="PSA 91:5">mede tingkebaa dau lakpitsi lim kela gede,<verse eid="PSA 91:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 91:6" />mede tingkemui ga terwa twagwa kebam rapia de de,</para>
  <para style="q" vid="PSA 91:6">mede tingna tingdau mateei kegwang de de.<verse eid="PSA 91:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 91:7" />Cang ge n lambie kaumie tsaidi lubui</para>
  <para style="q" vid="PSA 91:7">nah cang kerei ge n ba zetle,</para>
  <para style="q" vid="PSA 91:7">dede cide n da gwang canglak.<verse eid="PSA 91:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 91:8" />Nang pie kegai rünne zie</para>
  <para style="q" vid="PSA 91:8">nah kesiaketeime de saja kepeu ngauzie.<verse eid="PSA 91:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 91:9" />Kedanemene RAMPAUBE au a kemsiube!</para>
  <para style="q" vid="PSA 91:9">N kemsiube de liede Hutube Tinggwang tei lulo.<verse eid="PSA 91:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 91:10" />Herakesia gede n dwa rai gailak;</para>
  <para style="q" vid="PSA 91:10">kehebwak kette n ki taiga gwang nna lak.<verse eid="PSA 91:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 91:11" />Kedanemene pa pe samgwame de langpwa ncu gum beuzie,</para>
  <para style="q" vid="PSA 91:11">n lampui leune ga ncu gumbeu kerane.<verse eid="PSA 91:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 91:12" />Penui ba le penui ncu pwacuh zie</para>
  <para style="q" vid="PSA 91:12">ciu eh nang n pi tangtsu gage ketaudi melu kerane.<note caller="+" style="f"><char style="fr" closed="false">91:12 </char><char style="ft" closed="false">Mat. 4:6, Luk. 4:10-11, Heb. 1:14</char></note><verse eid="PSA 91:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 91:13" />Nang hinghodung nah heneidung de n pi kangga ge dau pang gaizie;</para>
  <para style="q" vid="PSA 91:13">nang hinghodung kehenabe nah heneidung de daucim zie.<verse eid="PSA 91:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 91:14" />Pa acu nlumla mui kecu ziemne, Ih pecu kelibeu zie.</para>
  <para style="q" vid="PSA 91:14">Ih pecu gum beuzie kedanemene pa au ada masang.<verse eid="PSA 91:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 91:15" />Tinggwang rangla, Ih keherei tingdau pe da lazie;</para>
  <para style="q" vid="PSA 91:15">Ih pecu ngkiengkelu peuzie nah pecu kerüt peuzie.<verse eid="PSA 91:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 91:16" />Ih pe teilungketie le pwa pe mnung tei beuzie,</para>
  <para style="q" vid="PSA 91:16">nah pecu a kelikelu keulia zie.<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s">N batadung daidi dino</para>
  <para style="d">Lei ge, Sabbath benai ziemne lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 92:1" />RAMPAUBE de teikeherei delie cide makeyi ge lie</para>
  <para style="q" vid="PSA 92:1">nah ketwalei teipwa n zi gage kekai, Hutube Tinggwang,<verse eid="PSA 92:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 92:2" />tingcang n samsang samkak de ranglia</para>
  <para style="q" vid="PSA 92:2">nah n kesamsang de tingmui ramsang,<verse eid="PSA 92:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 92:3" />leibung peria kereidung de si</para>
  <para style="q" vid="PSA 92:3">nah lyre siu keyi kwa.<verse eid="PSA 92:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 92:4" />N ziemne RAMPAUBO, n batadung teipwa kegai gade a sui yilu.</para>
  <para style="q" vid="PSA 92:4">A suiyi ziemne Ih lei teizie kedanemene n batadung ziemne.<verse eid="PSA 92:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 92:5" />N batadung daikenzwa gede dibi, RAMPAUBO!</para>
  <para style="q" vid="PSA 92:5">N kecet au cokzu lie.<note caller="+" style="f"><char style="fr" closed="false">92:5 </char><char style="ft" closed="false">Keu. 15:3, Rom. 11:33-34</char></note><verse eid="PSA 92:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 92:6" />Heramieme ge cila ma,</para>
  <para style="q" vid="PSA 92:6">mede kemangme ge aide cet gailak:<verse eid="PSA 92:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 92:7" />Kenlienme cehei nzwa pwakcuh kecudau,</para>
  <para style="q" vid="PSA 92:7">nah kesia bata teikela pelane lungh yi keludau liede,</para>
  <para style="q" vid="PSA 92:7">iciu liede penuide au kelung tane ngkap dizie.<verse eid="PSA 92:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 92:8" />Dede nang, RAMPAUBO, kelungtane hegwang teizie.<verse eid="PSA 92:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 92:9" />Kesang, N ngauraumedung de pie gailo, RAMPAUBO!</para>
  <para style="q" vid="PSA 92:9">Kesang, N ngauraumedung de pie gailo. Penui kap dizielu!</para>
  <para style="q" vid="PSA 92:9">Kemau ta teikela pelane depeu zangra dizie.<verse eid="PSA 92:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 92:10" />Nang a kii<note caller="+" style="f"><char style="fr" closed="false">92:10 </char><char style="fq" closed="false">Kii: </char><char style="ft" closed="false">Hebrewme let gade kengkieng de saulia kegai teila. </char></note> pwa nghang hetumseu kekuube kii nzwa beuda;</para>
  <para style="q" vid="PSA 92:10">maca keheci pwa acu keniak beuda.<verse eid="PSA 92:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 92:11" />A ngauraumedung kaumie kedi a miakle ngauda;</para>
  <para style="q" vid="PSA 92:11">a ngaurau medung kapdi kera a kwen le siuda.<verse eid="PSA 92:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 92:12" />Kesamsangme palm bang nzwa lungh yi luzie;</para>
  <para style="q" vid="PSA 92:12">penui Lebanon ga cedar nzwa lunghcuh luzie.<verse eid="PSA 92:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 92:13" />Penui de RAMPAUBE ki gage linggai;</para>
  <para style="q" vid="PSA 92:13">penui anui Tinggwang ki kigu gade lungh yi cuh lula:<verse eid="PSA 92:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 92:14" />Penui kecing dilu liede penui tsi builu;</para>
  <para style="q" vid="PSA 92:14">penui mdiak nah ringrak eh bam lula,<verse eid="PSA 92:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 92:15" />RAMPAUBE au nzui lie kecude keulia gai.</para>
  <para style="q" vid="PSA 92:15">Pa au a tsura, nah cika samsang kemak pe da lama.<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="s">RAMPAUBE Hegwang teibam dida</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 93:1" />RAMPAUBE hegwang teila; pa au kendu gade bah luda;</para>
  <para style="q" vid="PSA 93:1">RAMPAUBE pekatei kengkieng pai nah paikang teu lu.</para>
  <para style="q" vid="PSA 93:1">Kideube au tei ntiprip pwa bam, cide mlai gai lak.<verse eid="PSA 93:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 93:2" />Oh RAMPAUBO, n hegwangbam ndaa gade tei pwala dida;</para>
  <para style="q" vid="PSA 93:2">nang au ndaa gade lamui dida.<verse eid="PSA 93:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 93:3" />Jaaididung cuh dida, RAMPAUBO;</para>
  <para style="q" vid="PSA 93:3">penui penui kwa sah cuh;</para>
  <para style="q" vid="PSA 93:3">jaadi cuidung rediang nah mrung.<verse eid="PSA 93:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 93:4" />Kecehu ga kebam RAMPAUBE au,</para>
  <para style="q" vid="PSA 93:4">dui kekiee kwadung swade diki,</para>
  <para style="q" vid="PSA 93:4">yeo, jaadi cuidung kedi swade.<verse eid="PSA 93:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 93:5" />N kemci sampet de au nlumlu kebui ge;</para>
  <para style="q" vid="PSA 93:5">kemci le n ki tei hezuyi lu,</para>
  <para style="q" vid="PSA 93:5">RAMPAUBO, nang lungh kelatane.<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="s">RAMPAUBE pe minadung de püt dilak</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 94:1" />RAMPAUBO, Tinggwang pa hekum peei kelabe,</para>
  <para style="q" vid="PSA 94:1">Tinggwang saja peu kelabe, anui reugage baagai lulo.<note caller="+" style="f"><char style="fr" closed="false">94:1 </char><char style="ft" closed="false">Hez. 32:35</char></note><verse eid="PSA 94:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 94:2" />Cuhlu, kideube tutiakbe,</para>
  <para style="q" vid="PSA 94:2">ngang kelamede daipai penui ngaukerabe bi peu dilu.<verse eid="PSA 94:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 94:3" />Kenlienme daikenzwa tiege, RAMPAUBO,</para>
  <para style="q" vid="PSA 94:3">kenlienme daitie ge penui suiyi bamzie no?<verse eid="PSA 94:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 94:4" />Penui zai kedi samdung penui rangpet la,</para>
  <para style="q" vid="PSA 94:4">makesia ketei kelame leune penui hegie la.<verse eid="PSA 94:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 94:5" />Penui n minadung de teikeherei la, RAMPAUBO;</para>
  <para style="q" vid="PSA 94:5">deudi ga minadung de teikeherei la.<verse eid="PSA 94:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 94:6" />Penui hemipui nah sangme penui deudi ga lungh kebamme de teitset la,</para>
  <para style="q" vid="PSA 94:6">nah penui pepei kegah mede daptset la.<verse eid="PSA 94:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 94:7" />Penui rangla, “RAMPAUBE ngau lak,</para>
  <para style="q" vid="PSA 94:7">Jacob Tinggwang cide cetswa lama.”<verse eid="PSA 94:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 94:8" />Cetgai pielo, nnui mina kesiamedung!</para>
  <para style="q" vid="PSA 94:8">Nnui kemangmedung, daidauge ne nnui ma cilu zieno?<verse eid="PSA 94:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 94:9" />Pa pe kwen teibeu, pa masiu gailak zieni?</para>
  <para style="q" vid="PSA 94:9">Pa pe miak teigai, pa mangau gailak zieni?<verse eid="PSA 94:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 94:10" />Pa heleuhdung de ledeubeu kelabe, pa petau meni?</para>
  <para style="q" vid="PSA 94:10">Pa rünne maci pwa mina de peu kelabe, pa cilak ni?<verse eid="PSA 94:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 94:11" />RAMPAUBE minadung kecetdung cila,</para>
  <para style="q" vid="PSA 94:11">penui lungcet au kemta.<note caller="+" style="f"><char style="fr" closed="false">94:11 </char><char style="ft" closed="false">1 Cor. 3:20</char></note><verse eid="PSA 94:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 94:12" />RAMPAUBO, nangne ledeu kelabe de au samlam kepungme ge,</para>
  <para style="q" vid="PSA 94:12">n zai gade nang ledeubeu kelabe.<verse eid="PSA 94:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 94:13" />Keherei tingdau nang pecu kemtak peu,</para>
  <para style="q" vid="PSA 94:13">kenlienme ziemne pe kwaki kuilu kemaktane.<verse eid="PSA 94:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 94:14" />RAMPAUBE pe minadung de pütdi kelak</para>
  <para style="q" vid="PSA 94:14">mede pe mapwame de gidi kelak ziemne.<note caller="+" style="f"><char style="fr" closed="false">94:14 </char><char style="ft" closed="false">Rom. 11:12</char></note><verse eid="PSA 94:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 94:15" />Tutiakki gade kemzuibe ngaudai luzie lu;</para>
  <para style="q" vid="PSA 94:15">nah pelung mzuikela leune cide mzui luzie.<verse eid="PSA 94:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 94:16" />Cau a ziemne cuhsap eh kesia keteime de renia zieno?</para>
  <para style="q" vid="PSA 94:16">Cau a ziemne cuhsap eh kenlienme de renia zieno?<verse eid="PSA 94:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 94:17" />RAMPAUBE ne acu ngha beu meliecai,</para>
  <para style="q" vid="PSA 94:17">Ih nzet eh heni zingde kecu ga zeu miedi zieda.<verse eid="PSA 94:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 94:18" />Ih rang eh, “A pi reneu kecudau,”</para>
  <para style="q" vid="PSA 94:18">N samkak masang dene, RAMPAUBO, acu pwacuh beu.<verse eid="PSA 94:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 94:19" />Ih a lungrei kekiee ge kebamdau, nang a lung tau mlabeu eh a sui yi lula.<note caller="+" style="f"><char style="fr" closed="false">94:19 </char><char style="ft" closed="false">2 Cor. 1:5</char></note><verse eid="PSA 94:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 94:20" />Nang kengkap hegwangbam de ngngwa hemaa ge lubui ni?</para>
  <para style="q" vid="PSA 94:20">Mige hezai gade ma nsamkemak teila ni?<verse eid="PSA 94:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 94:21" />Penui makesang teilung keu dizie lie ngkwalwe ngkim eh riem la</para>
  <para style="q" vid="PSA 94:21">nah penui keyime de peu tsaidi kera mmau la.<verse eid="PSA 94:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 94:22" />Dede RAMPAUBE ne a renei kecehube,</para>
  <para style="q" vid="PSA 94:22">nah a Tinggwang au tsurabe kegumbe.<verse eid="PSA 94:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 94:23" />Pa penui katei kemau penui reu gage teugwang beu zie,</para>
  <para style="q" vid="PSA 94:23">nah penui katei kenlien gade penuide dangtüt dizie.</para>
  <para style="q" vid="PSA 94:23">RAMPAUBE anui Tinggwang penuide dangtüt dizie.<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="s">Anui ketwa leidung tei cugo</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 95:1" />Oh gwanglu, anui lei tei RAMPAUBE de peu go;</para>
  <para style="q" vid="PSA 95:1">anui suiyi leitei anui tsura kelikelube de peugo.<verse eid="PSA 95:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 95:2" />Anui suiyi makai teu pe dwaga nlüt go;</para>
  <para style="q" vid="PSA 95:2">anui reca leidung tei pecu peu go.<verse eid="PSA 95:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 95:3" />Kedanemene RAMPAUBE au kengkieng Tinggwang lu</para>
  <para style="q" vid="PSA 95:3">nah heradung pelane reu hegwang kengkiengbe.<verse eid="PSA 95:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 95:4" />Kideu heni kecokdung RAMPAUBE ba ga bam;</para>
  <para style="q" vid="PSA 95:4">lamlwa gu kecehudung pegu.<verse eid="PSA 95:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 95:5" />Jaaidi au pegu, pane cide tei kegai ziemne,</para>
  <para style="q" vid="PSA 95:5">nah pe ba le hangdeu kecanghdung teigai.<verse eid="PSA 95:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 95:6" />Oh gwanglu, anui keumie reca go;</para>
  <para style="q" vid="PSA 95:6">anui RAMPAUBE dwaga kwaktung lugo, anuide tei kegaibe:<verse eid="PSA 95:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 95:7" />Kedanemene pa au anui Tinggwang,</para>
  <para style="q" vid="PSA 95:7">nah pa anui mapie kela pe minadung nah pe ba ga kebam meurün,</para>
  <para style="q" vid="PSA 95:7">Henai, oh, nnui pe kwa kingneilu kera!<note caller="+" style="f"><char style="fr" closed="false">95:7 </char><char style="ft" closed="false">Tet. 17:7</char></note><verse eid="PSA 95:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 95:8" />“Meribah<note caller="+" style="f"><char style="fr" closed="false">95:8 </char><char style="fq" closed="false">Meribah: </char><char style="ft" closed="false">pekie keregi</char></note> ga nnui paumedung nzwa, nnui nlung tak diso,</para>
  <para style="q" vid="PSA 95:8">mede hetaideu ga Massah<note caller="+" style="f"><char style="fr" closed="false">95:8 </char><char style="fq" closed="false">Massah: </char><char style="ft" closed="false">pekie kedak kecu</char></note> tingba benai nzwa.<note caller="+" style="f"><char style="fr" closed="false">95:8 </char><char style="ft" closed="false">Tet. 17:1-7; Pum. 20:1-13; Hez. 6:16; 33:8</char></note><verse eid="PSA 95:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 95:9" />Cikade nnui paumedung acu kedei</para>
  <para style="q" vid="PSA 95:9">nah acu kedakpie, penui a batadung ngau liede.<verse eid="PSA 95:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 95:10" />Mmi riakdai ge ziemne Ih cipau ceheu dede a rata di</para>
  <para style="q" vid="PSA 95:10">eh rang, ‘Mina aidungde penui mlungdung gade pak mdei la; penui a lampuidung cilu meda.’<verse eid="PSA 95:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 95:11" />Cine a rata le Ih sampet teigai</para>
  <para style="q" vid="PSA 95:11">penui madaude a kemtakni de ga nlüt gailak.”<note caller="+" style="f"><char style="fr" closed="false">95:11 </char><char style="ft" closed="false">Heb. 3:7-19</char></note><verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="s">Kemci ziuyi gade recalo</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 96:1" />Oh, leikeheci ge RAMPAUBE dage tei gailu;</para>
  <para style="q" vid="PSA 96:1">RAMPAUBE dage lei tei gailu, kideu pelane.<note caller="+" style="f"><char style="fr" closed="false">96:1 </char><char style="ft" closed="false">Keu. 5:9, Lei. 33:3</char></note><verse eid="PSA 96:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 96:2" />RAMPAUBE dage lei tei gailu, pezi de peu samlampung kelu teilu;</para>
  <para style="q" vid="PSA 96:2">tingba ramsangne pa kelikelube lie reci beu lu.<verse eid="PSA 96:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 96:3" />Heleuhdung kakgage RAMPAUBE kendu zierang rangmci gailu,</para>
  <para style="q" vid="PSA 96:3">mimakecangh pe batadung heleuh pelane kakgage.<verse eid="PSA 96:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 96:4" />RAMPAUBE au di nah pe kedi de twasüt kerabe,</para>
  <para style="q" vid="PSA 96:4">heradung keda pelane reu pecu be hing kerabe.<verse eid="PSA 96:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 96:5" />Kedanemene heleuhdung pelane rabedung au mamiedung,</para>
  <para style="q" vid="PSA 96:5">dede pa au RAMPAUBE tinggimdung tei kegaibe.<verse eid="PSA 96:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 96:6" />Hetwa nah kedi au peda bam,</para>
  <para style="q" vid="PSA 96:6">kengkieng nah hezukeyi au pe kemci kiga bam.<verse eid="PSA 96:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 96:7" />RAMPAUBE de peulo, nnui pautsa namedung,</para>
  <para style="q" vid="PSA 96:7">RAMPAUBE de ketwa peulo, pe kendu nah kengkieng ziemne.<verse eid="PSA 96:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 96:8" />Kemdu pezi ngaulu kebui RAMPAUBE de peulo.</para>
  <para style="q" vid="PSA 96:8">Makai teugwang eh pe kedi kidung ga lüt lu,<verse eid="PSA 96:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 96:9" />Kemci suiyi teu RAMPAUBE dwa keumie lu;</para>
  <para style="q" vid="PSA 96:9">Pe dwa gage henah gai lu, kideu pelane.<verse eid="PSA 96:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 96:10" />Heleuhdung kakgage rang beulu, “RAMPAUBE kedi.”</para>
  <para style="q" vid="PSA 96:10">Kideube de si eh teilu; cide teu mlai gailak.</para>
  <para style="q" vid="PSA 96:10">Pa petaube gade mina tutiak zie.<verse eid="PSA 96:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 96:11" />Peu tinggimdung de pesui yilu, nah peu kideube de renga lu;</para>
  <para style="q" vid="PSA 96:11">peu jaaidi de mralu nah cika pui kebamdung de suiyi sah lu.<verse eid="PSA 96:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 96:12" />Peu luhdung de suiyi lu nah cika kebam pelane de.</para>
  <para style="q" vid="PSA 96:12">Iciu eh peu hegung ga tsingbangdung pelane de suiyi sah lu<verse eid="PSA 96:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 96:13" />RAMPAUBE dwaga, pa gwang kela ziemne.</para>
  <para style="q" vid="PSA 96:13">Pa au kideube tutiak zie lie gwang.</para>
  <para style="q" vid="PSA 96:13">Pa kesangbe gade kideube tutiak zie</para>
  <para style="q" vid="PSA 96:13">nah minadung pe kenlum gade zie.<note caller="+" style="f"><char style="fr" closed="false">96:13 </char><char style="ft" closed="false">Bat. 17:31</char></note><verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="s">RAMPAUBE Hegwang teibam</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 97:1" />RAMPAUBE au hegwangbe, peu kideube de pesuiyi lu;</para>
  <para style="q" vid="PSA 97:1">peu duigwadeudung pelane de pe sui yilu.<note caller="-" style="x"><char style="xo" closed="false">97:1 </char><char style="xt" closed="false"><ref loc="REV 19:7">Keu. 19:7</ref></char></note><verse eid="PSA 97:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 97:2" />Hemwadung nah kemui le pecu twagwa bam.</para>
  <para style="q" vid="PSA 97:2">Kemzui nah kesamsang au pe hegwangbam bangdwabe.<verse eid="PSA 97:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 97:3" />Mi pe dwa gade tetla</para>
  <para style="q" vid="PSA 97:3">nah petai leune ga pe ngauraume de ru nggah dila.<note caller="-" style="x"><char style="xo" closed="false">97:3 </char><char style="xt" closed="false"><ref loc="REV 11:5">Keu. 11:5</ref></char></note><verse eid="PSA 97:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 97:4" />Pa tingkehepik le kideube de tei mbaa gai;</para>
  <para style="q" vid="PSA 97:4">kideube ngau eh mbeu.<verse eid="PSA 97:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 97:5" />RAMPAUBE dwaga lamlwadung maca nzwa sui di,</para>
  <para style="q" vid="PSA 97:5">kideu pelane reu Rampaube.<verse eid="PSA 97:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 97:6" />Tinggimdung pe masang rang ndugai,</para>
  <para style="q" vid="PSA 97:6">nah heleuhdung pelane pe kemdu ngau dida.<verse eid="PSA 97:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 97:7" />Mamie heri lwe reca kelaleune ngngam zie,</para>
  <para style="q" vid="PSA 97:7">pemi kegah mamie recadung gade ngang kelame,</para>
  <para style="q" vid="PSA 97:7">pe da keumie lulo, nnui rabedung pelane!<verse eid="PSA 97:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 97:8" />Zion ga siu lu eh pesui yi lu,</para>
  <para style="q" vid="PSA 97:8">nah Judah namdidung renga lu</para>
  <para style="q" vid="PSA 97:8">n masang zaidung ziemne, RAMPAUBO.<verse eid="PSA 97:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 97:9" />Nang, RAMPAUBO, kideu pelane peureu hutube.</para>
  <para style="q" vid="PSA 97:9">Nang au rabedung pelane reu ditube.<note caller="-" style="x"><char style="xo" closed="false">97:9 </char><char style="xt" closed="false"><ref loc="JHN 3:31">Jhn. 3:31</ref></char></note><verse eid="PSA 97:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 97:10" />Nnui RAMPAUBE de hung kelame, kesia ngkau lu!</para>
  <para style="q" vid="PSA 97:10">Pa pecu kenlumme ge teilung gum beula,</para>
  <para style="q" vid="PSA 97:10">nah kenlienme ba gade pa penui de keumpet peula.<verse eid="PSA 97:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 97:11" />Makesangme ziemne kebaa baa beula</para>
  <para style="q" vid="PSA 97:11">nah lungsang eh kelame ziemne suiyi bamla.<verse eid="PSA 97:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 97:12" />RAMPAUBE gade suiyi bamlu, nnui kesamsangmedung,</para>
  <para style="q" vid="PSA 97:12">nah pe kemci nsung keludau ketwa peu lulo.<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="s">RAMPAUBE dage suiyikwa kwagailo</para>
  <para style="d">Lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 98:1" />Oh, RAMPAUBE dage lei keheci ge teigai lu,</para>
  <para style="q" vid="PSA 98:1">Pa ma miswakegahdung tei kegai ziemne;</para>
  <para style="q" vid="PSA 98:1">peba nzetle nah pebapum kemci le pecu ngkiengkelu peugai dida.<verse eid="PSA 98:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 98:2" />RAMPAUBE pa kelikelu teipwa peu cigai da;</para>
  <para style="q" vid="PSA 98:2">pa pe masang ngkei mzaha pwa heleuhdung pelane da ge lia dida.<verse eid="PSA 98:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 98:3" />Pa pe samkakkelu samsang de nsung luda nah Israel kilungme ziemne kesamsang de;</para>
  <para style="q" vid="PSA 98:3">kideu penli pelane gade Tinggwang kengkieng ngau zie.<note caller="+" style="f"><char style="fr" closed="false">98:3 </char><char style="ft" closed="false">Luk. 1:54, Bat. 28:28</char></note><verse eid="PSA 98:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 98:4" />Suiyi de ziemne RAMPAUBE dage sa gai lu, kideu pelane;</para>
  <para style="q" vid="PSA 98:4">leitei sabakte gai lu, suiyi ziemne lei teilu, nah ketwa lei teilu.<note caller="+" style="f"><char style="fr" closed="false">98:4 </char><char style="ft" closed="false">Isa. 44:23</char></note><verse eid="PSA 98:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 98:5" />Leitei RAMPAUBE de twalu leibung si delwe,</para>
  <para style="q" vid="PSA 98:5">leibung si delwe nah pekoa keyi lei tei lu,<verse eid="PSA 98:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 98:6" />Teluidung nah teki kwa silu</para>
  <para style="q" vid="PSA 98:6">hegwangpei dwa gade suiyi kwa teigai lu, RAMPAUBO.<verse eid="PSA 98:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 98:7" />Peu jaaidi de nralu nah cika kebam pelane de,</para>
  <para style="q" vid="PSA 98:7">kideube nah cika lunghkebam leune de.<verse eid="PSA 98:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 98:8" />Peu hereukidung de penui badung bapeu lu,</para>
  <para style="q" vid="PSA 98:8">nah peu kideutudung de suiyi ziemne sah lu.<verse eid="PSA 98:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 98:9" />RAMPAUBE au kideube tutiak kera gwang la;</para>
  <para style="q" vid="PSA 98:9">pa samsang eh kideube tutiak zie</para>
  <para style="q" vid="PSA 98:9">nah heleuhdungde de kenzuibe teu tiak zie.<note caller="+" style="f"><char style="fr" closed="false">98:9 </char><char style="ft" closed="false">Bat. 17:31</char></note><verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="s">Anui RAMPAUBE Tinggwang au mci</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 99:1" />RAMPAUBE au hegwangbe; heleuhdung depeu mbeu lu.</para>
  <para style="q" vid="PSA 99:1">Pa cherubim hegwang bam reuga bam; kideu teumlai di.<note caller="+" style="f"><char style="fr" closed="false">99:1 </char><char style="ft" closed="false">Keu. 11:18;19:6</char></note><verse eid="PSA 99:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 99:2" />RAMPAUBE au Zion ga kengkieng teubam;</para>
  <para style="q" vid="PSA 99:2">pa au heleuhdung pelane reu hetwa kepungbe lie.<verse eid="PSA 99:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 99:3" />Penui depeu n zi kedi nah kerüt de twa lulo;</para>
  <para style="q" vid="PSA 99:3">pa au mci.<verse eid="PSA 99:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 99:4" />Hegwangpei au ngkieng, nah pa kemzuibe pesui la;</para>
  <para style="q" vid="PSA 99:4">nang samsang eh teicu gaida;</para>
  <para style="q" vid="PSA 99:4">nang Jacob dage petaube nah kemzuibe tei gaida.<verse eid="PSA 99:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 99:5" />RAMPAUBE anui Tinggwang de twalu</para>
  <para style="q" vid="PSA 99:5">nah pe pidau bamga de reca lu.</para>
  <para style="q" vid="PSA 99:5">Pa au mci.<verse eid="PSA 99:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 99:6" />Moses nah Aaron au pe cingkumedung kakga bam,</para>
  <para style="q" vid="PSA 99:6">nah penui pezi qu kelamedung kakga Samuel bam.</para>
  <para style="q" vid="PSA 99:6">Penui RAMPAUBE de qugai, nah pa penui sam keligaibeu.<verse eid="PSA 99:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 99:7" />Pa penuide hemwa tsaidi gade mpau.</para>
  <para style="q" vid="PSA 99:7">Pa ajadung kai ntingring kebeu de penui kai nzeu lu,</para>
  <para style="q" vid="PSA 99:7">nah hezaidung pa penui dage kaibeu.<verse eid="PSA 99:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 99:8" />Nang penui sam kelibeu lu, RAMPAUBO anui Tinggwang</para>
  <para style="q" vid="PSA 99:8">nang au penui kemau gikebeu Tinggwang lu,</para>
  <para style="q" vid="PSA 99:8">dede pe kemau tadung dene penuide saja peu.<verse eid="PSA 99:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 99:9" />RAMPAUBE anui Tinggwang de twalu,</para>
  <para style="q" vid="PSA 99:9">nah kideutu kemci gade pecu reca lu,</para>
  <para style="q" vid="PSA 99:9">RAMPAUBE anui Tinggwang au mci kecu ziemne.<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s">Pe keku au bam muila</para>
  <para style="d">Tinggwang de ketwa lei.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 100:1" />RAMPAUBE dage suiyi sah gailu, kideu pelane.<verse eid="PSA 100:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 100:2" />Suiyi teu RAMPAUBE gwatei lu;</para>
  <para style="q" vid="PSA 100:2">suiyi lei tei eh pe dwaga gwanglu.<verse eid="PSA 100:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 100:3" />RAMPAUBE au Tinggwang lie kecu ci lulo;</para>
  <para style="q" vid="PSA 100:3">pa anuide teigai, nah anui au pe gu.</para>
  <para style="q" vid="PSA 100:3">Anui au pe mina nah pe meurünhau.<verse eid="PSA 100:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 100:4" />Twa eh pe kerecaki kirie ga lütlu,</para>
  <para style="q" vid="PSA 100:4">nah pe kigu ga kerüt teu eh lütlu.</para>
  <para style="q" vid="PSA 100:4">Pecu hetwa peulu nah pe zi de samlam beulu.<verse eid="PSA 100:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 100:5" />RAMPAUBE au yi kecu ziemne; pe samkak kesamsang kelungta</para>
  <para style="q" vid="PSA 100:5">nah pe masang au ceheudung pelane reu bamla.<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="s">Ih masang eh tet zie</para>
  <para style="d">David gu lei.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 101:1" />Ih samkakkelu kesamsang nah kemzuibe lei teizie,</para>
  <para style="q" vid="PSA 101:1">n dage, RAMPAUBO, Ih ketwa lei teizie.<verse eid="PSA 101:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 101:2" />Ih makesang lampui ga tet gwang zie.</para>
  <para style="q" vid="PSA 101:2">Oh, nang daidau a da gwang zie no?</para>
  <para style="q" vid="PSA 101:2">Ih a kilung gade masang eh tet zie.<verse eid="PSA 101:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 101:3" />Ih bata kesia gede a miakdung dwa gage kailak;</para>
  <para style="q" vid="PSA 101:3">Ih kemau kemta bata ngkau la;</para>
  <para style="q" vid="PSA 101:3">cide acu kerak gailak.<verse eid="PSA 101:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 101:4" />Mina kesiame acu gidi zie;</para>
  <para style="q" vid="PSA 101:4">Ih kesiabe samzai tei lama.<verse eid="PSA 101:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 101:5" />Ngkim eh pe kidame de rangmsia kelamedung de Ih ngkap dizie.</para>
  <para style="q" vid="PSA 101:5">Keheibe de ngang kelame nah pecu mning mdi kelame de Ih mbai beu lak.<verse eid="PSA 101:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 101:6" />Kideu ga kesamsangme de Ih pie eh peu a taiga bam zie.</para>
  <para style="q" vid="PSA 101:6">Cau yicang kecu lampui ga tet kelame de peu a gwa teizie.<verse eid="PSA 101:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 101:7" />Mide cwa kelame a ki lung ga bam gailak;</para>
  <para style="q" vid="PSA 101:7">kenretme depeu a dwaga bamlak.<verse eid="PSA 101:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 101:8" />Tingcang ramsang kideu ga kenlienme de Ih ngkap ciak dizie;</para>
  <para style="q" vid="PSA 101:8">RAMPAUBE namdi gade kesiaketei pelane de Ih keumpet dizie.<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="s">Adade nzu mbai diso</para>
  <para style="d">Keherei eh macet cita kedi dau RAMPAUBE dwa gage pelungrei pau kegai kekie.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 102:1" />A kengha kekie kingnei gailo, Oh RAMPAUBO;</para>
  <para style="q" vid="PSA 102:1">a kehap nang ngking gailo.<verse eid="PSA 102:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 102:2" />Ih keherei kelu tingdau nzu pung a dade mbaidi helo.</para>
  <para style="q" vid="PSA 102:2">Acu kingnei beulo.</para>
  <para style="q" vid="PSA 102:2">Ih ncu qugai kecudau, a sam keli kelwa beulo!<verse eid="PSA 102:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 102:3" />A tingbadung de mika nzwa kapak tetdi kezeu ziemne,</para>
  <para style="q" vid="PSA 102:3">nah a radung mi nzwa ru bam dida.<verse eid="PSA 102:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 102:4" />A nlung pangpop dida, nah Ih au cehei kii kedi be nzwa dida.</para>
  <para style="q" vid="PSA 102:4">Ih magede tyei kera nsungta dida.<verse eid="PSA 102:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 102:5" />Ih mra jüja bam sap kecune,</para>
  <para style="q" vid="PSA 102:5">Ih mcimrim gwang dida.<verse eid="PSA 102:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 102:6" />Ih au hetaideu ruine ge nzwa dida;</para>
  <para style="q" vid="PSA 102:6">Heni gi kedidung ga Ih biangkang ge nzwa dida,<verse eid="PSA 102:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 102:7" />Ih nrak eh zeu, nruine ge nlikwak eh</para>
  <para style="q" vid="PSA 102:7">ki peureu ga kebam ge nzwa,.<verse eid="PSA 102:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 102:8" />A ngauraume tingbazie pelane a rata tei,</para>
  <para style="q" vid="PSA 102:8">acu henui tei kelame a zi teu reset la dida,<verse eid="PSA 102:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 102:9" />Ih mimüt tangku nzwa tyei</para>
  <para style="q" vid="PSA 102:9">nah miakduidung a piak gage hailu da.<verse eid="PSA 102:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 102:10" />Kedanemene n rata kezeu gai kelakne,</para>
  <para style="q" vid="PSA 102:10">nang acu pwahu cuh lwe kelien mie dida.<verse eid="PSA 102:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 102:11" />A tingbaziedung au tingkau mie gadi kela nzwa da,</para>
  <para style="q" vid="PSA 102:11">nah Ih au cehei nzwa regui dida.<verse eid="PSA 102:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 102:12" />Dede nang, RAMPAUBO, kelungtane ring la,</para>
  <para style="q" vid="PSA 102:12">nah nkendu de au ceheudung pelane ziemne.<verse eid="PSA 102:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 102:13" />Nang cuhlwe Zion de ngau nggia zie.</para>
  <para style="q" vid="PSA 102:13">Cu pedage ngau kenggia ting kedine;</para>
  <para style="q" vid="PSA 102:13">mtei pwa kebam tingsiak be gwang kedine.<verse eid="PSA 102:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 102:14" />N kilamedung pe tangtsudung kusüt kecu ziemne</para>
  <para style="q" vid="PSA 102:14">nah pa kapkedi rebui de ngau pelung siala.<verse eid="PSA 102:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 102:15" />Heleuhdung n zi de rüt zie, RAMPAUBO,</para>
  <para style="q" vid="PSA 102:15">nah kideu ga hegwangmedung leune de nzi zierang kemdu de rüt zie.<verse eid="PSA 102:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 102:16" />RAMPAUBE Zion teidai luzie</para>
  <para style="q" vid="PSA 102:16">nah pezierang kemdu de keulia zie.<verse eid="PSA 102:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 102:17" />Cipau ting, pa keherei kelame kekie keli beuzie;</para>
  <para style="q" vid="PSA 102:17">pa penui kekie mlai dilak.<verse eid="PSA 102:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 102:18" />Gwang kezeu ceheudung ziemne aide rauteu lazie,</para>
  <para style="q" vid="PSA 102:18">nah mina mna mene kebammedung RAMPAUBE de twa zie.<verse eid="PSA 102:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 102:19" />Pa kemci kecehu gade pie nghung kecu ziemne;</para>
  <para style="q" vid="PSA 102:19">RAMPAUBE tinggim gade kideu ga pie nghunggai,<verse eid="PSA 102:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 102:20" />hebaangmedung mra kwa siu kera,</para>
  <para style="q" vid="PSA 102:20">tsaidi kera mmau kedimede lung mpetpeu kera.<verse eid="PSA 102:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 102:21" />Cine Zion ga RAMPAUBE zi rang zie</para>
  <para style="q" vid="PSA 102:21">nah Jerusalem gade pecu twazie.<verse eid="PSA 102:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 102:22" />Minadung nah hegwang ramdung ngkwa ncüt lwe</para>
  <para style="q" vid="PSA 102:22">RAMPAUBE tagwa tei kecu dau.<verse eid="PSA 102:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 102:23" />A teilung sum gade RAMPAUBE a kengkieng keuteu dida,</para>
  <para style="q" vid="PSA 102:23">pa a tingbaziedung tei mdui dida.<verse eid="PSA 102:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 102:24" />Ih ranggai, “A tinggwang teilung sum gade acu keuteudi helo,</para>
  <para style="q" vid="PSA 102:24">nang au ceheudung pelane ga lala.<verse eid="PSA 102:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 102:25" />Ndaa ting gade nang kideu teipwa pebam gage kailu;</para>
  <para style="q" vid="PSA 102:25">tinggimdung au n ba bata le teilu.<verse eid="PSA 102:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 102:26" />Tingkideu gah dizie, dede nang au bam zie;</para>
  <para style="q" vid="PSA 102:26">penui pelane pai nzwa lung hegwa dizie;</para>
  <para style="q" vid="PSA 102:26">pai nzwa, nang penuide gwagi dizie, nah penui gah dizie.<verse eid="PSA 102:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 102:27" />Dede nang au pelui bam muila,</para>
  <para style="q" vid="PSA 102:27">nah n mmidung penli bam ma.<verse eid="PSA 102:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 102:28" />N kilamedung namedung<note caller="+" style="f"><char style="fr" closed="false">102:28 </char><char style="fq" closed="false">Kilamedung namedung </char><char style="ft" closed="false">Samtie aide Israel leuhme de rangbam.</char></note> lungh lazie,</para>
  <para style="q" vid="PSA 102:28">nah penui leuhmedung nang kebam gade lungh zie.”<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="s">RAMPAUBE de twalo, O a Rabo</para>
  <para style="d">David leidung.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 103:1" />Ih RAMPAUBE de twagai a teilung pelane teu eh,</para>
  <para style="q" vid="PSA 103:1">nah a lung ga kebam pelane pezi kemci de de twagai.<verse eid="PSA 103:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 103:2" />Ih RAMPAUBE de twagai a teilung pelane teu eh,</para>
  <para style="q" vid="PSA 103:2">nah Ih pa bata keyi tei kegai leune nsunggai.<verse eid="PSA 103:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 103:3" />Pa n mau pelane gibeu;</para>
  <para style="q" vid="PSA 103:3">pa n mateei pelane tei ngkeibeu.<verse eid="PSA 103:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 103:4" />Pa n teilung kengkap gade kelibeu;</para>
  <para style="q" vid="PSA 103:4">pa keku na ngaugia teu ncu samlambeu.<verse eid="PSA 103:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 103:5" />Pa ma keyibedung pwa a teilung tei mnung beu,</para>
  <para style="q" vid="PSA 103:5">iciu eh helie ge nzwa n heriheret ting teiheci dailu.<note caller="+" style="f"><char style="fr" closed="false">103:5 </char><char style="ft" closed="false">Helie pe kengkieng and pe teilung ketie de ziemne cila la cf Isa. 40:31</char></note><verse eid="PSA 103:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 103:6" />RAMPAUBE kenzuibe tei beula</para>
  <para style="q" vid="PSA 103:6">nah keherei kebamme pelane de tutiak kenzuibe tei beula.<verse eid="PSA 103:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 103:7" />Pa Moses dage pelungningdung peuci gai,</para>
  <para style="q" vid="PSA 103:7">Israelme de pe batadung ngau gai.<note caller="-" style="x"><char style="xo" closed="false">103:7 </char><char style="xt" closed="false"><ref loc="PSA 147:19">Lei. 147:19</ref></char></note><verse eid="PSA 103:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 103:8" />RAMPAUBE au mide ngaunggia nah mide ku la;</para>
  <para style="q" vid="PSA 103:8">pa au pelung tie; nah pa au samkak kelu kesamsang le pui.<note caller="+" style="f"><char style="fr" closed="false">103:8 </char><char style="ft" closed="false">Lei. 86:15, 145:8</char></note><verse eid="PSA 103:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 103:9" />Pa mide kesiu eh bam lama;</para>
  <para style="q" vid="PSA 103:9">pa au kelungta perata eh bam lama.<verse eid="PSA 103:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 103:10" />Pa anui ngaulu kebui saja anuide peu lama</para>
  <para style="q" vid="PSA 103:10">mede anui maudung nah bata kesia ziehi peudai lama.<verse eid="PSA 103:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 103:11" />Kideu reuga tinghu kecu huge nzwa,</para>
  <para style="q" vid="PSA 103:11">pecu rüt kelame dade pe samkakkelu samsang au disüt.<verse eid="PSA 103:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 103:12" />Naimiak kepetle de naimiak kenlütle deige nzwa,</para>
  <para style="q" vid="PSA 103:12">cikenzwa deige RAMPAUBE anui dade anui mau keugi dida.<verse eid="PSA 103:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 103:13" />Mipei ge pe namedung dade pezai keyi nzwa,</para>
  <para style="q" vid="PSA 103:13">RAMPAUBE au pecu rüt kelamedung de cinzwa eh ngaunggia la.<verse eid="PSA 103:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 103:14" />Pa anuide daizwa teilubi ci bam;</para>
  <para style="q" vid="PSA 103:14">anui au rebui lie kecu pa cibam.<verse eid="PSA 103:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 103:15" />Anui teilung au cehei nzwa;</para>
  <para style="q" vid="PSA 103:15">anui luh ga mapa nzwa lungh yi cuh lula;<verse eid="PSA 103:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 103:16" />cide de tingkai guilwa, ge cide gah dila</para>
  <para style="q" vid="PSA 103:16">nah migede cide ndaa daiga lungh bi kecu ranggailak dila.<verse eid="PSA 103:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 103:17" />Dede RAMPAUBE de rüt kelame ziemne au, pe keku bam muila.</para>
  <para style="q" vid="PSA 103:17">Pe kesamsang ceheu pelane da la muila.<note caller="-" style="x"><char style="xo" closed="false">103:17 </char><char style="xt" closed="false"><ref loc="LUK 1:50">Luk. 1:50</ref></char></note><verse eid="PSA 103:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 103:18" />Penui pe samkak de kaizeu lula</para>
  <para style="q" vid="PSA 103:18">nah pe keledeusamdung de nsung lula.<verse eid="PSA 103:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 103:19" />RAMPAUBE tinggim ga pe hegwangbam bam tei luda,</para>
  <para style="q" vid="PSA 103:19">nah pe hegwangram au pelane reu hegwang.<verse eid="PSA 103:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 103:20" />RAMPAUBE de twalu, nnui pe tinggimgwame,</para>
  <para style="q" vid="PSA 103:20">nnui kengkingme, kengkieng nah pe sam mzai kelame,</para>
  <para style="q" vid="PSA 103:20">nah pa kerangbe kingnei kelame.<verse eid="PSA 103:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 103:21" />RAMPAUBE de twalu, nnui tinggim ga kengkiengme pelane,</para>
  <para style="q" vid="PSA 103:21">nnui pe kilamedung pe lungningbe tei kelame!<verse eid="PSA 103:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 103:22" />RAMPAUBE de twalu, pa damkelu pekiene,</para>
  <para style="q" vid="PSA 103:22">pane hegwang ketei heni leune ga.</para>
  <para style="q" vid="PSA 103:22">Ih a teilung pelane teu RAMPAUBE de twazie.<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="s">O RAMPAUBO Tinggwang, nang au dizulie</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 104:1" />Ih a teilung pelane teu RAMPAUBE de twa,</para>
  <para style="q" vid="PSA 104:1">RAMPAUBE a Tinggwang, nang daikenzwa ge dino!</para>
  <para style="q" vid="PSA 104:1">Ncu kerüt nah kemdu le bah pwa bam;<verse eid="PSA 104:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 104:2" />kebaa le ncu gumpwa bam pai bah kecu nzwa eh.</para>
  <para style="q" vid="PSA 104:2">Nang tinggim de paiki kehezuipai nzwa lim lu.<verse eid="PSA 104:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 104:3" />Nang n ki hesum hemwa reu gage kai lu,</para>
  <para style="q" vid="PSA 104:3">Nang hemwa teu n bagi teilu;</para>
  <para style="q" vid="PSA 104:3">nah tingkai hesiudung ga tet la.<verse eid="PSA 104:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 104:4" />Pa tingkai depeu samgwabe teila,</para>
  <para style="q" vid="PSA 104:4">mide pe kila teila.<note caller="-" style="x"><char style="xo" closed="false">104:4 </char><char style="xt" closed="false"><ref loc="HEB 1:7">Heb. 1:7</ref></char></note><verse eid="PSA 104:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 104:5" />Pa kideube bangdwa kai luda,</para>
  <para style="q" vid="PSA 104:5">nah cide madaude mlai lak.<verse eid="PSA 104:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 104:6" />Nang duikedi pwa kideube de pai nzwa gumlu da;</para>
  <para style="q" vid="PSA 104:6">dui ne kideutudung gum luda.<verse eid="PSA 104:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 104:7" />Nang dui de kesiu kegaidau penui lwa dila;</para>
  <para style="q" vid="PSA 104:7">nsam sah kegai kwa siu luge penui lwa renia tet dila.<verse eid="PSA 104:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 104:8" />Penui kideutudung reu lwahang nah langkam dung ga lwahung la,</para>
  <para style="q" vid="PSA 104:8">nang penui ziemne heni tei kegai ga.<verse eid="PSA 104:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 104:9" />Nang penui ziemne tetkah kelak herai kai dida,</para>
  <para style="q" vid="PSA 104:9">penui kideube de gumdai lakta.<verse eid="PSA 104:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 104:10" />Pa duiletdung depeu langkamdung ga lwa kera teigai;</para>
  <para style="q" vid="PSA 104:10">hereukidung lamlwadung kakga lwa.<verse eid="PSA 104:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 104:11" />Penui renaam kaunedung de dui peu la;</para>
  <para style="q" vid="PSA 104:11">gadadung penui hereu kap lula.<verse eid="PSA 104:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 104:12" />Hereuki kungga nruinedung penui ciepdung teila;</para>
  <para style="q" vid="PSA 104:12">penui pekiakdung gade lei teila.<note caller="-" style="x"><char style="xo" closed="false">104:12 </char><char style="xt" closed="false"><ref loc="MAT 13:32">Mat. 13:32</ref></char></note><verse eid="PSA 104:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 104:13" />Tinggim gade pa lamlwadung gage ting teirui gai beula.</para>
  <para style="q" vid="PSA 104:13">Kideube n samlamdung le pui lula.<verse eid="PSA 104:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 104:14" />Pa hekaune ziemne ceheidung peu lunghgai</para>
  <para style="q" vid="PSA 104:14">nah mabang mina de peu tahtyei lu kerane</para>
  <para style="q" vid="PSA 104:14">ciciu eh mina de peu kideube gade ketyeipok tatyei lu kerane.<verse eid="PSA 104:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 104:15" />Mina suiyi tei kerane pa zau teilu,</para>
  <para style="q" vid="PSA 104:15">olive ca, pe zu tei mbaa lu kerane,</para>
  <para style="q" vid="PSA 104:15">nah taktyei, pe teilung tei ngkieng lu kerane.<verse eid="PSA 104:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 104:16" />Lebanon ga cedar bangdung tingrui ngausüt lu;</para>
  <para style="q" vid="PSA 104:16">RAMPAUBE gu tsingbangdung, pa ling kegaidung de.<verse eid="PSA 104:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 104:17" />Cikage nruinedung penui ciep teu lula.</para>
  <para style="q" vid="PSA 104:17">Duirui heleibang gage pe ki tei lula.<verse eid="PSA 104:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 104:18" />Helungdung kideutu kehu ga lungh la,</para>
  <para style="q" vid="PSA 104:18">tangtsu kaunedung hetia ga mbai lula.<verse eid="PSA 104:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 104:19" />Pa hekeizie pei kera hekei teigai beu;<note caller="+" style="f"><char style="fr" closed="false">104:19 </char><char style="ft" closed="false">Ken. 1:14</char></note></para>
  <para style="q" vid="PSA 104:19">tingnaimiak mpet nlüt kera peting ci bam.<verse eid="PSA 104:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 104:20" />Nang tingmui teigai beu, ting kemui dau renaam kaune pelane pet la.<verse eid="PSA 104:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 104:21" />Hinghonadung mlai kepetdau mra la nah penui ketyeipok Tinggwang dade peila.<verse eid="PSA 104:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 104:22" />Tingnaimiak cuh dige, penui caili dai dila nah gwang penui ki ga zip dila.<verse eid="PSA 104:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 104:23" />Pecai minadung penui ta ga mie la nah tinghegi kecang ma teila.<verse eid="PSA 104:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 104:24" />RAMPAUBO, nang ma ketsamtsam nah kekiee ge teigai da!</para>
  <para style="q" vid="PSA 104:24">Nang maci le cidungde pelane teilu;</para>
  <para style="q" vid="PSA 104:24">kideu au n kaunedung le pui luda.<verse eid="PSA 104:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 104:25" />Cika jaaidi, cok nah mza süt bam,</para>
  <para style="q" vid="PSA 104:25">peeikap gai kelak makaune lungh bam,</para>
  <para style="q" vid="PSA 104:25">keceu nah kedi.<verse eid="PSA 104:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 104:26" />Heliemdung cipau reu ga tau la,</para>
  <para style="q" vid="PSA 104:26">nah cika Leviathan <note caller="+" style="f"><char style="fr" closed="false">104:26 </char><char style="fq" closed="false">Leviathan </char><char style="ft" closed="false">Aide Lei. 74:14 nah Isa. 27:1 gade de ngau lula, aide herasam rang keladung ga neidi ge.</char></note>de bam,</para>
  <para style="q" vid="PSA 104:26">nang ne tei kegai dui ga nggwa kera kaune da.<verse eid="PSA 104:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 104:27" />Cidung pelane n dade lungh bam</para>
  <para style="q" vid="PSA 104:27">penui de ketyeipok peting ga peulu kera.<verse eid="PSA 104:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 104:28" />Nang penuide cide kepeu dau, penui gwang ngkwa la;</para>
  <para style="q" vid="PSA 104:28">nang n ba ngkei kegai dau, penui nggei lula.<verse eid="PSA 104:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 104:29" />Nang nreutet dige, penui ngngi dila;</para>
  <para style="q" vid="PSA 104:29">nang penui cuingi keugi dicai,</para>
  <para style="q" vid="PSA 104:29">penui tsai dila nah penui rebui mmi caili dai dila.<note caller="+" style="f"><char style="fr" closed="false">104:29 </char><char style="ft" closed="false">Ken. 2:7, Ecc. 12:7</char></note><verse eid="PSA 104:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 104:30" />Nang penuide penui ngicui peu eh, penui de teilu;</para>
  <para style="q" vid="PSA 104:30">nang kideube de teilung keheci peu la.<verse eid="PSA 104:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 104:31" />RAMPAUBE kendu de peu kelungta bam kelube tei lulo!</para>
  <para style="q" vid="PSA 104:31">RAMPAUBE de peu pe bata ngau pesui yi kelube teilo!<verse eid="PSA 104:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 104:32" />Pa kideu ga pie gai, ge cide mbeu di;</para>
  <para style="q" vid="PSA 104:32">pa lamlwatudung tung gaige, penui mika mmi dila.<verse eid="PSA 104:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 104:33" />Ih a teilung pelane teu RAMPAUBE dage lei tei gaizie;</para>
  <para style="q" vid="PSA 104:33">Ih ring kebamtane ketwa lei tei a Tinggwang de twazie.<verse eid="PSA 104:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 104:34" />A lungcet de peu ge pecu pesui lulo,</para>
  <para style="q" vid="PSA 104:34">Ih a sui yizie RAMPAUBE gade.<verse eid="PSA 104:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 104:35" />Kemaume de peu ge kideu ga gahdi lulo,</para>
  <para style="q" vid="PSA 104:35">nah peu kesiame de la sita lulo.</para>
  <para style="q" vid="PSA 104:35">Ih a teilung pelane teu RAMPAUBE de twa zie,</para>
  <para style="q" vid="PSA 104:35">RAMPAUBE de twa lu!<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="s">Pe bata miswakegahdung pelane ha ranglo</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 105:1" />RAMPAUBE de ketwa peulo, pezi qu eh;</para>
  <para style="q" vid="PSA 105:1">heleuhdung dage pe batadung peu ci gailo.<verse eid="PSA 105:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 105:2" />RAMPAUBE de ketwa lei tei lo;</para>
  <para style="q" vid="PSA 105:2">pa miswakega batadung tei kegai pelane rang lo.<verse eid="PSA 105:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 105:3" />Kemci Rampaube zi gade nnui sui yilu;</para>
  <para style="q" vid="PSA 105:3">Rampaube de peei kela leu de peu lungciep suiyi bamlu.<verse eid="PSA 105:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 105:4" />RAMPAUBE de peei lu nah pe kengkieng de;</para>
  <para style="q" vid="PSA 105:4">pedwa ga gwang mui lu.<verse eid="PSA 105:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 105:5" />Nsungdai gailo Tinggwang miswakegah tei kegaidung de,</para>
  <para style="q" vid="PSA 105:5">pa miswakegah bata tei kegaidung nah pa hezai kai kebeudung de.<verse eid="PSA 105:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 105:6" />Nnui pe kilabe Abraham leuhmedung,</para>
  <para style="q" vid="PSA 105:6">nnui Jacob minadung, pa ne kedet kelu leuhmedung.<verse eid="PSA 105:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 105:7" />Pa au RAMPAUBE, anui Tinggwang.</para>
  <para style="q" vid="PSA 105:7">Pesam kai kebeu au kideu pelane ziemne.<verse eid="PSA 105:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 105:8" />Pa kelungta samkak kelude kaipwa bam zie,</para>
  <para style="q" vid="PSA 105:8">ceheu cang ge ziemne pe aja kai kebeudung.<verse eid="PSA 105:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 105:9" />Pa Abraham de ngngwa samkak kelude</para>
  <para style="q" vid="PSA 105:9">nah Isaac dage pe sampet kai kebeu de kainzeu lu.<note caller="-" style="x"><char style="xo" closed="false">105:9 </char><char style="xt" closed="false"><ref loc="LUK 1:72">Luk. 1:72</ref>,<ref loc="LUK 1:73">73</ref></char></note><verse eid="PSA 105:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 105:10" />Pa Jacob de ngngwa samkak lu,</para>
  <para style="q" vid="PSA 105:10">nah samkak aide Israelme da kelungta bam kera ge.<verse eid="PSA 105:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 105:11" />Pa rang eh cu, “Ih Canaan deude ncu peu zie,</para>
  <para style="q" vid="PSA 105:11">cide pwa peu ncu gum zie”.<verse eid="PSA 105:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 105:12" />Penui mina riak cam kebamdau pa aide ranggai,</para>
  <para style="q" vid="PSA 105:12">camsüt kecudau, nah Canaan deuga sangme ge kecudau.<verse eid="PSA 105:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 105:13" />Penui deudi ge gade deudi gega rwagwang,</para>
  <para style="q" vid="PSA 105:13">nah hegwangram ge gade keda ge ga.<verse eid="PSA 105:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 105:14" />Pa mige dede peu penuide teikeherei dima;</para>
  <para style="q" vid="PSA 105:14">penuide ziemne pa hegwangme de kesiugai.<verse eid="PSA 105:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 105:15" />Pa rangdi, “Ih keniak kelumedung de tung so;</para>
  <para style="q" vid="PSA 105:15">nah agu caihakecisam kerangmedung de tei rezam so.”<verse eid="PSA 105:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 105:16" />RAMPAUBE penui deudi gage herakum langgai;</para>
  <para style="q" vid="PSA 105:16">penui taktyei pelane keugi di.<verse eid="PSA 105:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 105:17" />Pa mige de penui dwa rai eh langgai;</para>
  <para style="q" vid="PSA 105:17">Joseph de kilame ge nzwa eh zwa beu.<verse eid="PSA 105:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 105:18" />Pepi kena hegeu le kangdi;</para>
  <para style="q" vid="PSA 105:18">pengwang gage hegeulwa ge kai pwabam.<verse eid="PSA 105:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 105:19" />Pa mrai kerang de teigwang kesang kemaktane.</para>
  <para style="q" vid="PSA 105:19">RAMPAUBE sam ne pecu kedak pie.<verse eid="PSA 105:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 105:20" />Hegwangpei kilamedung de langgai pecu lungmpetdi kerane;</para>
  <para style="q" vid="PSA 105:20">minadung reu kedime de pecu lungmpet beu.<verse eid="PSA 105:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 105:21" />Pa pecu peu pe ki kerengeibe teilu</para>
  <para style="q" vid="PSA 105:21">pe mabam pelane reu keteube<note caller="-" style="x"><char style="xo" closed="false">105:21 </char><char style="xt" closed="false"><ref loc="ACT 7:10">Bat. 7:10</ref></char></note><verse eid="PSA 105:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 105:22" />hegwangpei kang ga kedime reu kengkieng keteu</para>
  <para style="q" vid="PSA 105:22">nah pe hangkiamedung de maci ledeu kera kengkieng depeu.<verse eid="PSA 105:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 105:23" />Pecai Israel Egypt ga mie</para>
  <para style="q" vid="PSA 105:23">nah Jacob tingkakge Ham deudi ga lungh di.<verse eid="PSA 105:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 105:24" />RAMPAUBE pe minadung de nalung kekiee ge peu,</para>
  <para style="q" vid="PSA 105:24">nah penui ngauraumedung swade penuide tei ngking ki beu.<verse eid="PSA 105:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 105:25" />RAMPAUBE penui ngauraumedung depeu pe minadung de ngkaudi</para>
  <para style="q" vid="PSA 105:25">peu pe kilamedung de teikeherei kerane.<verse eid="PSA 105:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 105:26" />Pa pe kilabe Moses de langgai,</para>
  <para style="q" vid="PSA 105:26">nah Aaron, pane kedet kelube de.<verse eid="PSA 105:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 105:27" />Penui pe bata kedi teilia Egyptme kakgade,</para>
  <para style="q" vid="PSA 105:27">miswakegah bata teigai Ham deudi gade.<verse eid="PSA 105:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 105:28" />Pa kemui langgai nah cipau deudi de tei muiting gai,</para>
  <para style="q" vid="PSA 105:28">dede minadung pesam mzailu tadi.<verse eid="PSA 105:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 105:29" />Pa penui gu dui de hejai teidi</para>
  <para style="q" vid="PSA 105:29">nah penui gu heka teitset di.<verse eid="PSA 105:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 105:30" />Penui deudi ga hegau le puidi,</para>
  <para style="q" vid="PSA 105:30">hegwangme kibungdung kecangde.<verse eid="PSA 105:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 105:31" />RAMPAUBE pe sam kaigai, ge tammaine nah maisungne</para>
  <para style="q" vid="PSA 105:31">deudi pelane ga puidi.<verse eid="PSA 105:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 105:32" />Pa penui tingrui de pwa tangheu tei di,</para>
  <para style="q" vid="PSA 105:32">ting kehepik penui deu ga langgai.<verse eid="PSA 105:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 105:33" />Pa penui kubeluh nah nzüt bangdung ngkap di;</para>
  <para style="q" vid="PSA 105:33">pa penui deudi ga tsingbangdung teicum di.<verse eid="PSA 105:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 105:34" />Pa pesam kaigai, ge tangrimdung gwang di,</para>
  <para style="q" vid="PSA 105:34">tangrim kekiee ge.<verse eid="PSA 105:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 105:35" />Penui deuga tangriem ne ginia bang pelane tyeiteu di;</para>
  <para style="q" vid="PSA 105:35">Penui meibang pelane tyei teudi.<verse eid="PSA 105:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 105:36" />Pa penui deudi ga neraibe pelane de teitset di,</para>
  <para style="q" vid="PSA 105:36">penui kengkieng pelane pe tsi bui raitu kecudung.<verse eid="PSA 105:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 105:37" />Pecai pa Israelme de ngngwa mpet lu rangkanggeu nah kecak si eh;</para>
  <para style="q" vid="PSA 105:37">pe leuhme migede lampui kiga rei di mene.<verse eid="PSA 105:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 105:38" />Egyptme penui tetti ge penui suiyi di,</para>
  <para style="q" vid="PSA 105:38">kedanemene Egyptmedung penuide hing kedine.<verse eid="PSA 105:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 105:39" />Pa hemwa de kesung ge tei eh teizang gaibeu</para>
  <para style="q" vid="PSA 105:39">nah tingmui gi mbaa kera mi teigai beu.<verse eid="PSA 105:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 105:40" />Israelme ketyeipok kie, ge pa nruinedung langgai beu</para>
  <para style="q" vid="PSA 105:40">nah pa penuide peu tyeinggeilu kerane tinggim gade tangku peu.<note caller="-" style="x"><char style="xo" closed="false">105:40 </char><char style="xt" closed="false"><ref loc="JHN 6:31">Jhn. 6:31</ref></char></note><verse eid="PSA 105:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 105:41" />Pa tsura ngkei gai, ge dui lwapet;</para>
  <para style="q" vid="PSA 105:41">hereuki ge nzwa hetaideu ga lwa nghung.<note caller="+" style="f"><char style="fr" closed="false">105:41 </char><char style="ft" closed="false">Tet. 13:21-22</char></note><verse eid="PSA 105:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 105:42" />Pa pe kilabe Abraham dage</para>
  <para style="q" vid="PSA 105:42">pe sam kemci kai kebeude nsung lu.<verse eid="PSA 105:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 105:43" />Pa pe minadung de suiyi eh ngngwampet lu,</para>
  <para style="q" vid="PSA 105:43">pa ne kedet kelumedung de, ngkieng kelu sah eh.<verse eid="PSA 105:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 105:44" />Pa penuide mi kedame deudung pwapeu;</para>
  <para style="q" vid="PSA 105:44">penui minadung mabam leune luulu<verse eid="PSA 105:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 105:45" />ciciu eh peu pe minadung de pe zai nzailu</para>
  <para style="q" vid="PSA 105:45">nah pe sam kaikebeudung pelane nzailu kerane.</para>
  <para style="q" vid="PSA 105:45">RAMPAUBE de twalu.<note caller="+" style="f"><char style="fr" closed="false">105:45 </char><char style="ft" closed="false">Jos. 11:16-23</char></note><verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="s">RAMPAUBE de hetwa peulo, Pa au yi kecune</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 106:1" />RAMPAUBE de twalu!</para>
  <para style="q" vid="PSA 106:1">RAMPAUBE de ketwa peulo, pa au yi kecune;</para>
  <para style="q" vid="PSA 106:1">pe samkakkelu samsang de au kelungta bam muila.<verse eid="PSA 106:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 106:2" />Cauge RAMPAUBE bata kedidung pelane peikap lulai no</para>
  <para style="q" vid="PSA 106:2">mede ketwa peulu kebui batadung rang cang lulai no?<verse eid="PSA 106:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 106:3" />Pesam mzai kelame samlam pungtu,</para>
  <para style="q" vid="PSA 106:3">nah bata keyibe rünne teimui kelame.<verse eid="PSA 106:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 106:4" />Acu nsung gailo, RAMPAUBO, nang n minadung de ngha kecudau;</para>
  <para style="q" vid="PSA 106:4">nang penuide kelibeu kecudau acu de ngha lo.<verse eid="PSA 106:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 106:5" />Ciciu cai Ih nang kedet kelume ngking kelu de ngaulu zie,</para>
  <para style="q" vid="PSA 106:5">n leuhme penui sui keyi</para>
  <para style="q" vid="PSA 106:5">nah nangne pwa kepeu maleu teu ketwa kepeu de.<verse eid="PSA 106:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 106:6" />Anui paumedung nzwa anui mau dida;</para>
  <para style="q" vid="PSA 106:6">anui petau kemak tei dida nah anui makesia tei dida<verse eid="PSA 106:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 106:7" />Egypt ga anui paumedung Tinggwang bata miswakegah kedidung de ci lumah;</para>
  <para style="q" vid="PSA 106:7">nang pia kekieege penuide keku keu keliadung de penui nsung tadi;</para>
  <para style="q" vid="PSA 106:7">penui Jaaidi Kegie gade kengkingbe de renia di.<verse eid="PSA 106:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 106:8" />Dede pa penui de kelibeu, pe sampet kebeu nzwa,</para>
  <para style="q" vid="PSA 106:8">iciu eh pe kengkieng kedi de keulia kerane.<verse eid="PSA 106:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 106:9" />Pa Jaaidi Kegie de de kesiugai, ge cide canghdi.</para>
  <para style="q" vid="PSA 106:9">Delwe pa penuide kecok cika de hetaideu gage ngngwa mpetlu.<verse eid="PSA 106:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 106:10" />Pa penuide ngkau kelame ba gade penuide kelibeu,</para>
  <para style="q" vid="PSA 106:10">nah pa penuide ngauraumedung dade kelibeu.<note caller="-" style="x"><char style="xo" closed="false">106:10 </char><char style="xt" closed="false"><ref loc="LUK 1:71">Luk. 1:71</ref></char></note><verse eid="PSA 106:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 106:11" />Dede dui ne penui ngauraume de kegak teudi;</para>
  <para style="q" vid="PSA 106:11">penui mige de ringlu mah.<verse eid="PSA 106:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 106:12" />Ciciu ge pe minadung pe samdung nlumlu,</para>
  <para style="q" vid="PSA 106:12">nah ketwa lei tei pecu twa.<verse eid="PSA 106:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 106:13" />Dede penui pa tei kegai de nsungta zette di;</para>
  <para style="q" vid="PSA 106:13">penui pe keledeudung de kwa tadi.<verse eid="PSA 106:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 106:14" />Hetaideu gade penui hengim le kepui teigwang</para>
  <para style="q" vid="PSA 106:14">nah penui hangdeu ketsai gade Tinggwang kedei di.<note caller="+" style="f"><char style="fr" closed="false">106:14 </char><char style="ft" closed="false">1 Cor. 10:9</char></note><verse eid="PSA 106:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 106:15" />Cine pa penui kie kecube peu,</para>
  <para style="q2" vid="PSA 106:15">dede penui dage ngau kehing mateei langgai.<verse eid="PSA 106:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 106:16" />Ramzeuki gade penui Moses</para>
  <para style="q" vid="PSA 106:16">nah Aaron de ngau penui riakdi, RAMPAUBE kemci cingkupei de de.<verse eid="PSA 106:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 106:17" />Kideu ngkei gai eh Dathan de mnwa lu</para>
  <para style="q" vid="PSA 106:17">nah Abiram nah pe caisuime de gumcim di.<note caller="+" style="f"><char style="fr" closed="false">106:17 </char><char style="ft" closed="false">Pum. 16:1-35</char></note><verse eid="PSA 106:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 106:18" />Penui kakga mi cakmie;</para>
  <para style="q" vid="PSA 106:18">mi le kesia kenlienme de ru di.<verse eid="PSA 106:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 106:19" />Penui Horeb<note caller="+" style="f"><char style="fr" closed="false">106:19 </char><char style="fq" closed="false">Horeb </char><char style="ft" closed="false">Sinai deutu.</char></note> deutu gade hetumseu ge hegeu keyidung le teilu</para>
  <para style="q" vid="PSA 106:19">nah cipau miede de reca.<note caller="+" style="f"><char style="fr" closed="false">106:19 </char><char style="ft" closed="false">Tet. 32:1-14</char></note><verse eid="PSA 106:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 106:20" />Penui hetum cehei tyei kelabe mie ge pwa</para>
  <para style="q" vid="PSA 106:20">Tinggwang kemdu de rehiak lu.<note caller="-" style="x"><char style="xo" closed="false">106:20 </char><char style="xt" closed="false"><ref loc="ROM 1:23">Rom. 1:23</ref></char></note><verse eid="PSA 106:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 106:21" />Penui Tinggwang penuide kelikelube de nsung tadi,</para>
  <para style="q" vid="PSA 106:21">Egypt ga bata kedi leu tei kegaibe de.<verse eid="PSA 106:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 106:22" />Pa Ham deu gade miswakegah tei gai</para>
  <para style="q" vid="PSA 106:22">nah Jaaidi Kegie gade pe kengkieng kedi bata keulia.<verse eid="PSA 106:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 106:23" />Tinggwang pe minadung de ngkapti zielie kerang dau,</para>
  <para style="q" vid="PSA 106:23">pane kedetkelu kilabe, Moses, pe dwa sapkap lwe</para>
  <para style="q" vid="PSA 106:23">penuide ngkap di kera pe rata de kaam di meni.<verse eid="PSA 106:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 106:24" />Pecai penui kideu keyi de gidi,</para>
  <para style="q" vid="PSA 106:24">penui Tinggwang sampet nlum kemakne,<verse eid="PSA 106:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 106:25" />dede penui paikidung gade bam eh ncam di,</para>
  <para style="q" vid="PSA 106:25">nah RAMPAUBE samzai tei tadi.<verse eid="PSA 106:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 106:26" />Cine pa peba hwacuh penuide sam kai eh</para>
  <para style="q" vid="PSA 106:26">peu penuide hetaideu gade tsai dizie lie kecu,<verse eid="PSA 106:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 106:27" />penui namedung de heleuh kedadung kakgage tei zangra di zie lie,</para>
  <para style="q" vid="PSA 106:27">nah penuide peu sangme deu gade peu lungzang dizie lie eh.<note caller="-" style="x"><char style="xo" closed="false">106:27 </char><char style="xt" closed="false"><ref loc="PSA 44:11">Lei. 44:11</ref></char></note><verse eid="PSA 106:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 106:28" />Pecai Peor gade, penui minadung Baal<note caller="+" style="f"><char style="fr" closed="false">106:28 </char><char style="fq" closed="false">Baal </char><char style="ft" closed="false">Hezi aide pekie au kedibe mede mpaube, Laisiukwak Kehegwabe ga heleuh keda rabe zi tei eh teula la.</char></note> de kereca ga ncüt lu,</para>
  <para style="q" vid="PSA 106:28">nah keringria kega rabedung de ratak tei kebeudung de tyei.<verse eid="PSA 106:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 106:29" />Penui penui bata le RAMPAUBE rata teidi,</para>
  <para style="q" vid="PSA 106:29">nah mateei ngau kehingge penui kakga de petdi.<verse eid="PSA 106:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 106:30" />Ge Phinehas cuh lwe kemaume de saja peu,</para>
  <para style="q" vid="PSA 106:30">ge mateei de gahdi.<note caller="+" style="f"><char style="fr" closed="false">106:30 </char><char style="ft" closed="false">Pum. 25:1-13</char></note><verse eid="PSA 106:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 106:31" />Pecu au samsang lie de eh</para>
  <para style="q" vid="PSA 106:31">ceheu pelane ga kelungta rangla di.<verse eid="PSA 106:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 106:32" />Meribah duilet gade penui RAMPAUBE rata teidi,</para>
  <para style="q" vid="PSA 106:32">nah Moses penui ziemne kehereidi.<note caller="+" style="f"><char style="fr" closed="false">106:32 </char><char style="ft" closed="false">Pum. 20:1-13</char></note><verse eid="PSA 106:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 106:33" />Penui Moses suisiet teisüt di,</para>
  <para style="q" vid="PSA 106:33">nah pa macet mene ma rang zette di.<verse eid="PSA 106:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 106:34" />Penui heleube de tei msia dima,</para>
  <para style="q" vid="PSA 106:34">RAMPAUBE penuide rangkebeu nzwa,<verse eid="PSA 106:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 106:35" />dede penui heleuh kedadung de ngngwa lungh ncüt</para>
  <para style="q" vid="PSA 106:35">nah penui zaidung keteu lu<verse eid="PSA 106:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 106:36" />nah penui mamiedung de reca di,</para>
  <para style="q" vid="PSA 106:36">aide penui ziemne hebaih ge di.<verse eid="PSA 106:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 106:37" />Penui penui napei nah penui napuidung de pwa herakesiadung de ratak teibeu.<note caller="+" style="f"><char style="fr" closed="false">106:37 </char><char style="ft" closed="false">1 Cor. 10:20</char></note><verse eid="PSA 106:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 106:38" />Penui kemau kegahme de teitset,</para>
  <para style="q" vid="PSA 106:38">penui napei nah penui napui dungde,</para>
  <para style="q" vid="PSA 106:38">penui canaan gu mamiedung de ratak tei beu,</para>
  <para style="q" vid="PSA 106:38">dapketsetme ne hangdeu be tei hera dida.<verse eid="PSA 106:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 106:39" />Penui penui bata le penuide tei hera dida;</para>
  <para style="q" vid="PSA 106:39">penui ta au helipuidung ge nzwa di.<verse eid="PSA 106:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 106:40" />Cine RAMPAUBE pe minadung de perata di</para>
  <para style="q" vid="PSA 106:40">nah pa pekatei pe minadungde pesui tadi.<verse eid="PSA 106:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 106:41" />Pa penuide heleuh kedadung ba gage kaibeu di,</para>
  <para style="q" vid="PSA 106:41">nah penui ngauraume ne penui reu kedi teidi.<verse eid="PSA 106:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 106:42" />Penuide ngauraume ne tei keherei</para>
  <para style="q" vid="PSA 106:42">nah penui cipaume kang ga lungh ladi.<verse eid="PSA 106:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 106:43" />Pia kekieege RAMPAUBE pe minadung de ngha kera gwang,</para>
  <para style="q" vid="PSA 106:43">dede penui renia bamdi,</para>
  <para style="q" vid="PSA 106:43">nah penuikatei penui mau ziemne penuide tei mneidi.<verse eid="PSA 106:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 106:44" />Iciu liede, pa penui lungrei ngaulu</para>
  <para style="q" vid="PSA 106:44">pa penui nggia sah kegai kwa siu keludau.<verse eid="PSA 106:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 106:45" />Penui dage pa samkak kelude nsunglu,</para>
  <para style="q" vid="PSA 106:45">nah pe keku kedi ziemne pa pelung nciep dai lu.<verse eid="PSA 106:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 106:46" />Pa penuide ngam kelume de peu</para>
  <para style="q" vid="PSA 106:46">penuide ngaungia lu.<verse eid="PSA 106:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 106:47" />Anuide keli lu, O RAMPAUBO anui Tinggwang.</para>
  <para style="q" vid="PSA 106:47">Anuide heleuh kedadung kakgade ngngwa gwang dai beulo,</para>
  <para style="q" vid="PSA 106:47">iciu eh anui ncu ketwa peu zie nah n zi kemci de twa lu zie.<verse eid="PSA 106:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 106:48" />RAMPAUBE de twalu, Israelme Tinggwang de, pecu</para>
  <para style="q" vid="PSA 106:48">cude nah kelungta twalu!</para>
  <para style="q" vid="PSA 106:48">Mina pelane “Amen” de eh rangdi.</para>
  <para style="q" vid="PSA 106:48">RAMPAUBE de twalu!<note caller="-" style="x"><char style="xo" closed="false">106:48 </char><char style="xt" closed="false"><ref loc="PSA 41:13">Lei. 41:13</ref></char></note><verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms">Laisiukwak Mengeibe</para>
  <para style="s">RAMPAUBE de rikelume de peu ranglo</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 107:1" />RAMPAUBE de ketwa peu lo, pa au yi lu,</para>
  <para style="q" vid="PSA 107:1">nah pe samsang samkak au kelungta bamla.<verse eid="PSA 107:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 107:2" />RAMPAUBE anuide kelikebeu sam teu rang lo,</para>
  <para style="q" vid="PSA 107:2">pane ngauraume ba gade keli kelume pelane.<verse eid="PSA 107:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 107:3" />Pa nnuide sangme deu gwale ngngwa ngkwa luda,</para>
  <para style="q" vid="PSA 107:3">naimiak kepetle nah naimiak kenlütle gade,</para>
  <para style="q" vid="PSA 107:3">nreule nah ngkangle de.<note caller="-" style="x"><char style="xo" closed="false">107:3 </char><char style="xt" closed="false"><ref loc="PSA 106:47">Lei. 106:47</ref></char></note><verse eid="PSA 107:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 107:4" />Penui hetaideu lampui kegah ga raw ladi</para>
  <para style="q" vid="PSA 107:4">nah lungh kera namdi kette ngaulu tadi.<verse eid="PSA 107:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 107:5" />Penui mzeu nah hereu kedi ziemne,</para>
  <para style="q" vid="PSA 107:5">penui nnei cangsiak eh kau zeudi.<verse eid="PSA 107:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 107:6" />Ge penui rei gade RAMPAUBE de qu gai,</para>
  <para style="q" vid="PSA 107:6">nah pa penui rei gade penuide kelilu.<verse eid="PSA 107:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 107:7" />Pa penuide lampui kemzui be sau lia</para>
  <para style="q" vid="PSA 107:7">iciu eh penui namdi ga gwang eh lungh lu kerane.<verse eid="PSA 107:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 107:8" />Oh minadung pe samkakkelu samsang de ziemne RAMPAUBE de twa maisia</para>
  <para style="q" vid="PSA 107:8">nah pa mina ziemne miswa kega bata tei kegaidung ziemne.<verse eid="PSA 107:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 107:9" />Pa hereu kelame de peu sak set lula</para>
  <para style="q" vid="PSA 107:9">nah kenzeume de ketyeipok keyi le pui lula.<note caller="+" style="f"><char style="fr" closed="false">107:9 </char><char style="ft" closed="false">Luk. 1:53, Jer. 31:25</char></note><verse eid="PSA 107:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 107:10" />Mina kangge pesui sia delwe kemui ga bam,</para>
  <para style="q" vid="PSA 107:10">hebaangme keupwa keherei bam.<verse eid="PSA 107:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 107:11" />Kedanemene penui kengkieng Tinggwang samdung de renia kedine</para>
  <para style="q" vid="PSA 107:11">nah Hutube Tinggwang rang kebeudung de gileu kedine.<verse eid="PSA 107:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 107:12" />Pa penuilung tei henah lu peu penuide keherei kegai gade;</para>
  <para style="q" vid="PSA 107:12">penui kaudi, nah migede penuide ngha kera gah.<verse eid="PSA 107:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 107:13" />Ciciu ge penui keherei eh RAMPAUBE de qu gai,</para>
  <para style="q" vid="PSA 107:13">nah pa penui rei gade penuide keli lu.<verse eid="PSA 107:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 107:14" />Pa penuide penui lungrei nah kemui gade ngngwa mpetlu</para>
  <para style="q" vid="PSA 107:14">nah penui kangriadung de teitüt kecai di.<verse eid="PSA 107:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 107:15" />Oh minadung pe samsang samkak de ziemne RAMPAUBE de twa maisia,</para>
  <para style="q" vid="PSA 107:15">nah pa mina ziemne miswa kega bata tei kegaidung ziemne!<verse eid="PSA 107:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 107:16" />Pa hetah geu hebaangki heriekidung teipang</para>
  <para style="q" vid="PSA 107:16">nah hegeulwadung teicum dida.<verse eid="PSA 107:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 107:17" />Penui au kemieme, samzai tei kemak gade,</para>
  <para style="q" vid="PSA 107:17">nah penui maudung ziemne penui keherei bam.<verse eid="PSA 107:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 107:18" />Penui matyei neu tadi,</para>
  <para style="q" vid="PSA 107:18">nah penui ketsai kirie taiga gwangdi.<verse eid="PSA 107:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 107:19" />Ge penui rei gade RAMPAUBE de qu gai,</para>
  <para style="q" vid="PSA 107:19">nah pa penui rei gade penuide kelilu.<verse eid="PSA 107:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 107:20" />Pa pesam kaibeu eh penuide tei hemilu,</para>
  <para style="q" vid="PSA 107:20">nah penui rau gade penuide kelibeu.<note caller="-" style="x"><char style="xo" closed="false">107:20 </char><char style="xt" closed="false"><ref loc="PSA 147:15">Lei. 147:15</ref></char></note><verse eid="PSA 107:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 107:21" />Oh minadung pe samsang samkak de ziemne RAMPAUBE de twa maisia,</para>
  <para style="q" vid="PSA 107:21">nah pa mina ziemne miswakegah bata tei kegaidung ziemne!<verse eid="PSA 107:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 107:22" />Peu penui ratak teipwa pecu hetwa peu maisia,</para>
  <para style="q" vid="PSA 107:22">nah penui sui keyi lei gade pa tei kegai leune ndu maisia.<verse eid="PSA 107:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 107:23" />Mina kangge jaaidi gade liem taugwang</para>
  <para style="q" vid="PSA 107:23">delwe jaaidi gade penui pok hi tyei.<verse eid="PSA 107:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 107:24" />Cidungde RAMPAUBE teilu kebuibe ngau</para>
  <para style="q" vid="PSA 107:24">nah duidi reuga pe miswakegah batadung.<verse eid="PSA 107:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 107:25" />Kedanemene pa aja kaigai nah tingkai kaidi gui cu di</para>
  <para style="q" vid="PSA 107:25">duide cuidung guinlai di.<verse eid="PSA 107:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 107:26" />Penui liemdung de tingkai ga pung cehu cudi; nah kecuk gage teinliem di</para>
  <para style="q" vid="PSA 107:26">kengngi cikenzwa gade minadung penui kekuu gahdi.<verse eid="PSA 107:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 107:27" />Penui tanglia dedi sakmie kelume ge nzwa</para>
  <para style="q" vid="PSA 107:27">nah penui kecet de kemtadi.<verse eid="PSA 107:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 107:28" />Ge penui rei gade RAMPAUBE de qu gai,</para>
  <para style="q" vid="PSA 107:28">nah pa penui rei gade penuide keli lu.<verse eid="PSA 107:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 107:29" />Pa tingkai kaici de kaam dige</para>
  <para style="q" vid="PSA 107:29">nah duicui zing dedi.<verse eid="PSA 107:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 107:30" />Duidi cui zing de kedine penui sui yi di,</para>
  <para style="q" vid="PSA 107:30">nah pa penuide penui neu kebam liemtau bam ga ngngwa gwanglu.<verse eid="PSA 107:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 107:31" />Oh minadung samkakkelu samsang de ziemne RAMPAUBE de twalu maisia,</para>
  <para style="q" vid="PSA 107:31">nah minadung ziemne pa miswakegah batadung teigai!<verse eid="PSA 107:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 107:32" />Penui mina kangbau kecu gade pe kemdu peu ranglo</para>
  <para style="q" vid="PSA 107:32">nah kecingme baudi gade pecu twa lo.<verse eid="PSA 107:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 107:33" />RAMPAUBE hereukidung de hetaideu tei di</para>
  <para style="q" vid="PSA 107:33">dui rwakdung de kecang deu tei di,<verse eid="PSA 107:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 107:34" />nah pa tangnia keyi deu de pwa hangdeu ketsai ge teidi,</para>
  <para style="q" vid="PSA 107:34">kedanemene pe minadung kenlien ziemne.<verse eid="PSA 107:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 107:35" />Pa hetaideu de pwa rejaaidung tei di,</para>
  <para style="q" vid="PSA 107:35">nah kecang deu de pwa dui rwakdung ge teidi.<verse eid="PSA 107:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 107:36" />Pa mina kemzeume de peu cika lunghlu,</para>
  <para style="q" vid="PSA 107:36">nah penui lungh kera namdi ge tei lu.<verse eid="PSA 107:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 107:37" />Penui namdi heta taa kera tei lu, kubebangdung linglu</para>
  <para style="q" vid="PSA 107:37">nah luhlüt mmi süt lu.<verse eid="PSA 107:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 107:38" />RAMPAUBE penuide samlambeu cine penui kiee süt lu.</para>
  <para style="q" vid="PSA 107:38">Pa penui kaunedung de peu cam dima.<verse eid="PSA 107:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 107:39" />Penuide mine ngaurau nah hengam teidi</para>
  <para style="q" vid="PSA 107:39">keteei nah kehereine.<verse eid="PSA 107:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 107:40" />RAMPAUBE ngauraume muiteumedung de tei hengam tei gaila</para>
  <para style="q" vid="PSA 107:40">nah penuide peu hetaideu lampui kegah ga rwa ladi.<verse eid="PSA 107:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 107:41" />Dede pa kegame de penui lungrei gade kelilu</para>
  <para style="q" vid="PSA 107:41">nah penui kilungme de pe meurün hau nzwa pie rengei beu.<verse eid="PSA 107:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 107:42" />Ma kesangme aide ngau eh penui sui yi lu,</para>
  <para style="q" vid="PSA 107:42">nah kenlienme pelane de peu zing dedi.<verse eid="PSA 107:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 107:43" />Peu ningcing kecume de aidung de cet lulo,</para>
  <para style="q" vid="PSA 107:43">nah peu RAMPAUBE bata samkakkelu samsang de nsung bammui lulo.<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="s">Tinggwang de ngngwa anui kuusüt eh tei zie</para>
  <para style="d">Lei ge, David lei</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 108:1" />Ih nlum cang bam, Tinggwang;</para>
  <para style="q" vid="PSA 108:1">Ih n dage lei teizie, yeo, Ih ketwa lei teizie a nlung pekiene teu eh.<verse eid="PSA 108:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 108:2" />Mrak cuhlu, a leibung nah a harp le;</para>
  <para style="q" vid="PSA 108:2">Ih tingnaimiak de nkia luzie.<verse eid="PSA 108:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 108:3" />Ih ncu ketwa peu zie, RAMPAUBO, minadung kak gade;</para>
  <para style="q" vid="PSA 108:3">Ih heleuhdung kakgade n dage ketwa lei tei gaizie.<verse eid="PSA 108:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 108:4" />Kedanemene n samkakkelu samsang de au tinggimdung reu hangcang bam;</para>
  <para style="q" vid="PSA 108:4">nah n masang de ting tung bam.<verse eid="PSA 108:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 108:5" />N kedi pwa ting gage lialo, Tinggwang,</para>
  <para style="q" vid="PSA 108:5">nah n kendu de kideu pelane reu peu hetwa punglo.<verse eid="PSA 108:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 108:6" />Ciude nang ku kela minadung de kelilu kerane,</para>
  <para style="q" vid="PSA 108:6">n kengkieng zetle ba le anuide kelilu nah anui kekie keligai beulo.<verse eid="PSA 108:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 108:7" />Pe kemci ni gade Tinggwang ranggai da; “Ih a suiyi zie;</para>
  <para style="q" vid="PSA 108:7">Ih Shechem namdi de mzi di zie nah Succoth deu langkie de mzi dizie.<verse eid="PSA 108:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 108:8" />Gilead au a gu, nah Manasseh de a gu;</para>
  <para style="q" vid="PSA 108:8">Ephraim de a peurwa;</para>
  <para style="q" vid="PSA 108:8">Judah au a kedituitie.<verse eid="PSA 108:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 108:9" />Moab au a gu duipiakwak;</para>
  <para style="q" vid="PSA 108:9">Edom reu gage a picum keliengai zie;</para>
  <para style="q" vid="PSA 108:9">Ih ngkieng kelu kwa sah zie Philistia ziemne.<verse eid="PSA 108:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 108:10" />Cau acu kengkieng namdi de ga ngngwa nlwet beu zie no?</para>
  <para style="q" vid="PSA 108:10">Cau acu Edom ga ngngwa gwangbeu zie no?”<verse eid="PSA 108:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 108:11" />Tinggwang, nang anuide gi kesang dide ni?</para>
  <para style="q" vid="PSA 108:11">Nang hereu ga anui reugwame de ngngwa lüt lama.<verse eid="PSA 108:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 108:12" />Ngauraume dade anuide ngau kerau gade anuide ngha lo,</para>
  <para style="q" vid="PSA 108:12">kedanemene mina ngha au kemta.<verse eid="PSA 108:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 108:13" />Anui ngkieng luzie Tinggwang ngha gade;</para>
  <para style="q" vid="PSA 108:13">pa anui ngauraumedung de cai ketet dizie.<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="s">Acu nghalo, O RAMPAUBE a Tinggwang</para>
  <para style="d">Lei ketei kedibe ziemne. David lei.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 109:1" />Ih twa kela Tinggwang, nlei mene bam diso,<verse eid="PSA 109:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 109:2" />Kedanemene kenlienme nah mide kecwame acu tei;</para>
  <para style="q" vid="PSA 109:2">penui a ha kenretpe rang.<verse eid="PSA 109:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 109:3" />Penui a cu twagwa lwe ngau kerau samdung rang la,</para>
  <para style="q" vid="PSA 109:3">nah penui acu pekie kegah gade acu tei la.<note caller="-" style="x"><char style="xo" closed="false">109:3 </char><char style="xt" closed="false"><ref loc="JHN 15:25">Jhn. 15:25</ref></char></note><verse eid="PSA 109:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 109:4" />Ih penuide ku la liede penui a cu ngaurau,</para>
  <para style="q" vid="PSA 109:4">dede Ih penui ziemne kekie tei bamla.<verse eid="PSA 109:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 109:5" />Penui makeyi ziemne acu kesia peu dai la,</para>
  <para style="q" vid="PSA 109:5">nah penui a keku de ngaurau la.<verse eid="PSA 109:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 109:6" />A ngauraume tutiak kera tutiak kemau aidungde kenzwa gede kedet lulo;</para>
  <para style="q" vid="PSA 109:6">pe ngauraume gede pe lamsap kerane kedet lu.<verse eid="PSA 109:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 109:7" />Pecu tiak kecudau, peu pecu maudi lulo;</para>
  <para style="q" vid="PSA 109:7">peu pe kekie de kemauge di lu.<verse eid="PSA 109:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 109:8" />Peu pe teilung zie cam dilu;</para>
  <para style="q" vid="PSA 109:8">peu kedame gede pe bata tei dilu.<note caller="-" style="x"><char style="xo" closed="false">109:8 </char><char style="xt" closed="false"><ref loc="ACT 1:20">Bat. 1:20</ref></char></note><verse eid="PSA 109:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 109:9" />Peu pe namedungde de nggiane tei dilu,</para>
  <para style="q" vid="PSA 109:9">nah peu pe nau de hemipui ge tei dilu.<verse eid="PSA 109:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 109:10" />Peu pe namedung de hui eh haketeime tei dilu,</para>
  <para style="q" vid="PSA 109:10">penui ki kau kedi de gidi eh penui ma hala.<verse eid="PSA 109:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 109:11" />Pa mipaupung kelamedung de peu pema pelane keuteu dilu;</para>
  <para style="q" vid="PSA 109:11">peu sangmedung de pa tei kelu pelane luteu dilu.<verse eid="PSA 109:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 109:12" />Peu mige dede pe dade pezai yi so;</para>
  <para style="q" vid="PSA 109:12">peu mige dede pe name nggiane de ngau nggia so.<verse eid="PSA 109:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 109:13" />Peu pe namedung de gah dilu;</para>
  <para style="q" vid="PSA 109:13">peu penui zidung gwang kela ceheu de nsungta dilu.<verse eid="PSA 109:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 109:14" />Peu pe paumedung maudung de RAMPAUBE de ci lo; nah peu pe pui mau de madaude nsungta helo.<verse eid="PSA 109:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 109:15" />Peu penui mau RAMPAUBE dwaga lamui lu;</para>
  <para style="q" vid="PSA 109:15">peu RAMPAUBE de kideu ga penuide nsungtazing dilu kera tei lu.<verse eid="PSA 109:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 109:16" />Peu RAMPAUBE de aide teilu kedanemene aipau mina de madaude pe samkakkelu samsang de keulia kera cet lama,</para>
  <para style="q" vid="PSA 109:16">dede meliene mide tei keherei nah daptsetla, lungh gailak kelame de, kegame de,</para>
  <para style="q" vid="PSA 109:16">nah pe ngha kegame de.<verse eid="PSA 109:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 109:17" />Pa mide reset neu la; peu cide pe da cailigwang dai lulo.</para>
  <para style="q" vid="PSA 109:17">Pa mide samlam raula; peu samlam kette pe da gwang so.<verse eid="PSA 109:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 109:18" />Pa reset le pecu cum teu lala pe paini nzwa,</para>
  <para style="q" vid="PSA 109:18">nah pe resetdung de dui nzwa pepum ga zui lüt lulo,</para>
  <para style="q" vid="PSA 109:18">pe ra ga maca nzwa.<verse eid="PSA 109:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 109:19" />Peu pe resetdung pa paini teu kela nzwa pecu gumlu,</para>
  <para style="q" vid="PSA 109:19">kiakang pa pecu kangteu lamui kela nzwa.<verse eid="PSA 109:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 109:20" />Peu aide RAMPAUBE dade kegwang acu ngaurau kelamedung gu ziehi lulo,</para>
  <para style="q" vid="PSA 109:20">acu kemmau samdung kerangmedung de.<verse eid="PSA 109:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 109:21" />RAMPAUBE a Rampaube, n zi gade nang acu ngha beu lo.</para>
  <para style="q" vid="PSA 109:21">Kedanemene n samkakkelu samsang de au yi kecune, acu keli beu lo.<verse eid="PSA 109:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 109:22" />Ih maga nah kengha gah kecune,</para>
  <para style="q" vid="PSA 109:22">nah a nlung ga rezam pwa bam dida.<verse eid="PSA 109:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 109:23" />Ih tinghegi tingkaumie ge nzwa gah di lai auda;</para>
  <para style="q" vid="PSA 109:23">acu tangrim nage nzwa kecung mpet dida.<verse eid="PSA 109:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 109:24" />A ngkokpuikena mnei dida mmwang kecu gade;</para>
  <para style="q" vid="PSA 109:24">Ih a geu nah a ra swa si meda.<verse eid="PSA 109:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 109:25" />Acu mmau kelame acu mapei meda;</para>
  <para style="q" vid="PSA 109:25">penui acu ngau ge, penui peungum dila.<note caller="+" style="f"><char style="fr" closed="false">109:25 </char><char style="ft" closed="false">Heb. 10:12-13, Luk. 20:42-43</char></note><verse eid="PSA 109:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 109:26" />Acu ngha lo, RAMPAUBO a Tinggwang;</para>
  <para style="q" vid="PSA 109:26">acu keli beulo n samkakkelu samsang de le.<verse eid="PSA 109:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 109:27" />Peu penuide aide n bata lie kecu ci lulo,</para>
  <para style="q" vid="PSA 109:27">nang, RAMPAUBE, ne teigai lie kecu.<verse eid="PSA 109:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 109:28" />Penui acu reset liede, nang acu samlam beu bilo;</para>
  <para style="q" vid="PSA 109:28">penui acu tei kecudau, peu penuide ngam dilu,</para>
  <para style="q" vid="PSA 109:28">dede peu n kilabe de pe suiyi lulo.<note caller="+" style="f"><char style="fr" closed="false">109:28 </char><char style="ft" closed="false">1 Cor. 4:12</char></note><verse eid="PSA 109:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 109:29" />Peu a ngauraumedung de hengamle cum lulo;</para>
  <para style="q" vid="PSA 109:29">penuide peu penui ngam pai nzwa bah lulo.<verse eid="PSA 109:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 109:30" />Ih amui le RAMPAUBE de ketwa kedi sahbak eh peu zie.</para>
  <para style="q" vid="PSA 109:30">Ih pe minadung ngkwa gade pecu twa zie.<verse eid="PSA 109:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 109:31" />Kedanemene RAMPAUBE kegahbe lam gum beuzie,</para>
  <para style="q" vid="PSA 109:31">pecu mmau kelamedung dade kelibeu kerane.<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="s">A ba zetle bamlu</para>
  <para style="d">David Lei.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 110:1" />RAMPAUBE a mpaube dage rang, “Aika a ba zetle bamlu</para>
  <para style="q" vid="PSA 110:1">Ih n ngauraumedung de n pidau teidi kemaktane.”<note caller="+" style="f"><char style="fr" closed="false">110:1 </char><char style="ft" closed="false">Heb. 10:12-13, Luk. 20:42-43</char></note><verse eid="PSA 110:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 110:2" />Zion gade RAMPAUBE n hegwang kengkieng tei mdi beu zie;</para>
  <para style="q" vid="PSA 110:2">n ngauraumedung reu di lu.<verse eid="PSA 110:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 110:3" />N minadung neu ngnga eh penui paini kemci kai lwe n cai sui dizie</para>
  <para style="q" vid="PSA 110:3">nang ngking kelu benai;</para>
  <para style="q" vid="PSA 110:3">tingcang nuge hezin nzwa heluibwame n da gwang di zie.<verse eid="PSA 110:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 110:4" />RAMPAUBE pe sam pet beu da, nah cide keuteu dai dilak:</para>
  <para style="q" vid="PSA 110:4">“Nang kelungta cingkupei ge zie,</para>
  <para style="q" vid="PSA 110:4">Melchizedek de pwa leu eh.”<note caller="+" style="f"><char style="fr" closed="false">110:4 </char><char style="ft" closed="false">Heb. 7:17, 21</char></note><verse eid="PSA 110:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 110:5" />RAMPAUBE au n ba zetle bam.</para>
  <para style="q" vid="PSA 110:5">Pa pe rata kedi benai hegwangpeidung de teitset dizie.<note caller="-" style="x"><char style="xo" closed="false">110:5 </char><char style="xt" closed="false"><ref loc="PSA 143:5">Lei. 143:5</ref></char></note><verse eid="PSA 110:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 110:6" />Pa heleuhdung de tutiak zie;</para>
  <para style="q" vid="PSA 110:6">pa hereuketei nidung gage ketsaipaudung kaipui dizie;</para>
  <para style="q" vid="PSA 110:6">pa deudi kekie ge ga kedimedung de teitset di zie.<verse eid="PSA 110:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 110:7" />Pa lampuikung ga hereuki gade dui sak zie,</para>
  <para style="q" vid="PSA 110:7">nah pecai pa ngking lwe pe peu pung cuh di zie.<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="s">Tinggwang batadung au dizulie</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 111:1" />RAMPAUBE de twalu.</para>
  <para style="q" vid="PSA 111:1">Ih a mlung pekiene teu RAMPAUBE de twazie</para>
  <para style="q" vid="PSA 111:1">pe minadung keyi ngkwa gade, penui mbau kebam ga.<verse eid="PSA 111:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 111:2" />RAMPAUBE batadung au dizu lie,</para>
  <para style="q" vid="PSA 111:2">cidung ngau pesui la kelamedung cidung de cineu eh kwa bamla.<note caller="-" style="x"><char style="xo" closed="false">111:2 </char><char style="xt" closed="false"><ref loc="PSA 143:5">Lei. 143:5</ref></char></note><verse eid="PSA 111:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 111:3" />Pe bata au herüt nah kedile puipung,</para>
  <para style="q" vid="PSA 111:3">nah pe masang au kelungta lala.<verse eid="PSA 111:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 111:4" />Pa nsung lalu kera miswakegah batadung teila;</para>
  <para style="q" vid="PSA 111:4">RAMPAUBE au pe zai yi nah mide ngaunggia.<note caller="-" style="x"><char style="xo" closed="false">111:4 </char><char style="xt" closed="false"><ref loc="PSA 86:5">Lei. 86:5</ref></char></note><verse eid="PSA 111:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 111:5" />Pa pecaisuime samsang kelamedung pok pwa peula.</para>
  <para style="q" vid="PSA 111:5">Pa au pesam samkak kelude nsungla muizie.<verse eid="PSA 111:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 111:6" />Pa pe minadung dage pe kengkieng batadung pwa lia gai da</para>
  <para style="q" vid="PSA 111:6">penuide heleuh kedadung deu gum kera pwa peu kecu gade.<verse eid="PSA 111:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 111:7" />Pe batadung au masang nah nzui;</para>
  <para style="q" vid="PSA 111:7">pe keledeudung pelane nlum lubui.<verse eid="PSA 111:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 111:8" />Pe samdung au kelungta bamla,</para>
  <para style="q" vid="PSA 111:8">cidungde kesamsang gade nah sünne eh mneilu kerabe.<verse eid="PSA 111:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 111:9" />Pa pe minadung de ngam kelu pwapeu dida;</para>
  <para style="q" vid="PSA 111:9">dewe pa kelungta penuide ngngwa samkakkelu,</para>
  <para style="q" vid="PSA 111:9">kemci nah kengkieng au pa lie.<note caller="-" style="x"><char style="xo" closed="false">111:9 </char><char style="xt" closed="false"><ref loc="LUK 1:49">Luk. 1:49</ref>,<ref loc="LUK 1:68">68</ref></char></note><verse eid="PSA 111:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 111:10" />RAMPAUBE de kerüt peu kecu au maci luu kera bangdwa da;</para>
  <para style="q" vid="PSA 111:10">pe keledeudung mzai kelame au penui macet yibam.</para>
  <para style="q" vid="PSA 111:10">Pecu au kelungta twazie.<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="s">Makesangme madaude mlai dilak</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 112:1" />RAMPAUBE de twa lu.</para>
  <para style="q" vid="PSA 112:1">RAMPAUBE mie hing kelabe au samlam pungtu lie,</para>
  <para style="q" vid="PSA 112:1">pa aja kaikebeudung mzai la kecu pe sui kelabe.<verse eid="PSA 112:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 112:2" />Pe leuhmedung deudibe gade ngkieng luzie;</para>
  <para style="q" vid="PSA 112:2">mina kemzuime leuhmedung de Tinggwang ne samlam beuzie.<verse eid="PSA 112:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 112:3" />Pe kilung ga mahei nah mabam bam;</para>
  <para style="q" vid="PSA 112:3">pe masangdung kelungta bam zie.<verse eid="PSA 112:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 112:4" />Mina keyimedung ziemne kemui ga kebaa lala;</para>
  <para style="q" vid="PSA 112:4">pa mide ngau nggia, pezaiyi, nah mzui.<verse eid="PSA 112:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 112:5" />Pe zaiyi eh mide nggia kelame nah mide rangkang releu beu kelame da au kezuyi lala,</para>
  <para style="q" vid="PSA 112:5">pe bata masang eh tei kelabe.<verse eid="PSA 112:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 112:6" />Kedanemene pa au madaude kau dilak;</para>
  <para style="q" vid="PSA 112:6">masang kelabe de au nsungla mui zie.<verse eid="PSA 112:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 112:7" />Pa samlia kesiadung de hing lama;</para>
  <para style="q" vid="PSA 112:7">Pe kenlum au ngkieng, RAMPAUBE de nlum eh.<verse eid="PSA 112:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 112:8" />Pelung au keherei lama mede ngngi lama,</para>
  <para style="q" vid="PSA 112:8">pa pe ngauraume de ngamlwe ngkienglu kemaktane.<verse eid="PSA 112:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 112:9" />Pa mbang eh kegahme de ma peula;</para>
  <para style="q" vid="PSA 112:9">pe masangdung kelungta bamzie;</para>
  <para style="q" vid="PSA 112:9">pecu hetwa herüt peuzie.<verse eid="PSA 112:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 112:10" />Kenlienme aide ngau eh pe rata dizie;</para>
  <para style="q" vid="PSA 112:10">pa pe rata süt eh pe gei geigim dizie nah pa sui dizie;</para>
  <para style="q" vid="PSA 112:10">kenlienmedung kehengin au gah dizie.<note caller="-" style="x"><char style="xo" closed="false">112:10 </char><char style="xt" closed="false"><ref loc="ACT 7:54">Bat. 7:54</ref></char></note><verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="s">Cau anui RAMPAUBE Tinggwang nzwa no?</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 113:1" />RAMPAUBE de twalu.</para>
  <para style="q" vid="PSA 113:1">Pecu twalu, nnui RAMPAUBE kilamedung;</para>
  <para style="q" vid="PSA 113:1">RAMPAUBE zi twalu.<verse eid="PSA 113:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 113:2" />RAMPAUBE zi de peu samlam punglu,</para>
  <para style="q" vid="PSA 113:2">cude nah kelungta.<verse eid="PSA 113:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 113:3" />Naimiak kepet gade kenlüt kecang,</para>
  <para style="q" vid="PSA 113:3">RAMPAUBE zi twa kerabe.<verse eid="PSA 113:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 113:4" />RAMPAUBE heleuh pelane reu di,</para>
  <para style="q" vid="PSA 113:4">nah pe kemdu au tingkam reu ga la.<verse eid="PSA 113:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 113:5" />Cau anui Tinggwang RAMPAUBE nzwa no,</para>
  <para style="q" vid="PSA 113:5">cau kecehu ga bam no,<verse eid="PSA 113:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 113:6" />cau ting nah kideu pie kera</para>
  <para style="q" vid="PSA 113:6">keukei mie la no?<verse eid="PSA 113:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 113:7" />Pa kegame de rebui gade kwakcu lula</para>
  <para style="q" vid="PSA 113:7">nah kehereikelame de mimüt gade teucuh beula,<verse eid="PSA 113:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 113:8" />iciude peu pecu kedime na zangnamedung tei beula,</para>
  <para style="q" vid="PSA 113:8">pe minadung kedime nadung.<note caller="-" style="x"><char style="xo" closed="false">113:8 </char><char style="xt" closed="false"><ref loc="JOB 36:7">Job 36:7</ref></char></note><verse eid="PSA 113:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 113:9" />Pa pekilung ga suiyi peula,</para>
  <para style="q" vid="PSA 113:9">pa pecu henamedung pwa peu eh pecu peu pe suiyi la.</para>
  <para style="q" vid="PSA 113:9">RAMPAUBE de twalu.<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="s">Rampaube dwade mbeulu</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 114:1" />Israelme Egypt gi kedidau,</para>
  <para style="q" vid="PSA 114:1">Jacob kibaume sangme let kerangme dade tet kempetdau,<verse eid="PSA 114:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 114:2" />Judah pegu kemci ni ge di,</para>
  <para style="q" vid="PSA 114:2">Israel de pwa pegu hegwangram teidi.<verse eid="PSA 114:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 114:3" />Jaaidi Kegie de penuide ngau eh pak tetdi;</para>
  <para style="q" vid="PSA 114:3">Jordan reu lwa tadi.<note caller="-" style="x"><char style="xo" closed="false">114:3 </char><char style="xt" closed="false"><ref loc="PSA 77:16">Lei. 77:16</ref></char></note><verse eid="PSA 114:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 114:4" />Lamlwadung hemeudung nzwa nsau di,</para>
  <para style="q" vid="PSA 114:4">kideutudung meurünnadung nzwa nsau di.<verse eid="PSA 114:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 114:5" />Daitei paktet dino, duikedi?</para>
  <para style="q" vid="PSA 114:5">Jordan Reuki, nang daitei cainok dino?<verse eid="PSA 114:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 114:6" />Kideutudung, daitei nnui hemeudung nzwa nsau la no?</para>
  <para style="q" vid="PSA 114:6">Nnui keceu kideutudung, daitei meuründung nzwa nsau la no?<verse eid="PSA 114:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 114:7" />Nbeulu, kideu, Rampaube dwa ga,</para>
  <para style="q" vid="PSA 114:7">Jacob Tinggwang kebam gade.<note caller="-" style="x"><char style="xo" closed="false">114:7 </char><char style="xt" closed="false"><ref loc="PSA 96:9">Lei. 96:9</ref></char></note><verse eid="PSA 114:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 114:8" />Pa tangtsu teipwa rejaaidung tei dila,</para>
  <para style="q" vid="PSA 114:8">tangtsu ketakbe teipwa duirwakdung lwa kebam tei dila.<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="s">N zi de kemdu peuzie</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 115:1" />Anuide so, RAMPAUBO, anuide so,</para>
  <para style="q" vid="PSA 115:1">dede n zi de peu kemdu peu lo,</para>
  <para style="q" vid="PSA 115:1">keku bammui kelade nah masang de ziemne.<verse eid="PSA 115:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 115:2" />Daitei heleuhdung keteulai,</para>
  <para style="q" vid="PSA 115:2">“Penui Tinggwang cu daiga bamno?”<verse eid="PSA 115:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 115:3" />Anui Tinggwang au tinggim ga bam;</para>
  <para style="q" vid="PSA 115:3">pa tei keneube leune tei la.<verse eid="PSA 115:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 115:4" />Heleuhdung gu rabedung au rangkanggeu nah kecakle tei,</para>
  <para style="q" vid="PSA 115:4">mina ba le tei keludung.<verse eid="PSA 115:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 115:5" />Cipau rabedung de penui muidung bam, dede ma rangla ma;</para>
  <para style="q" vid="PSA 115:5">penui miakdung bam, dede ma ngau lama;<verse eid="PSA 115:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 115:6" />penui kwendung bam, dede ma siu lama;</para>
  <para style="q" vid="PSA 115:6">penui ngkiedung bam, dede mariem ci lama.<verse eid="PSA 115:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 115:7" />Cipau rabedung de penui badung bam, dede ma deu lula ma;</para>
  <para style="q" vid="PSA 115:7">penui pidung bam, dede penui tet lu lama;</para>
  <para style="q" vid="PSA 115:7">mede penui muidung gade marang lama.<note caller="-" style="x"><char style="xo" closed="false">115:7 </char><char style="xt" closed="false"><ref loc="PSA 135:16">Lei. 135:16</ref>,<ref loc="PSA 135:17">17</ref></char></note><verse eid="PSA 115:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 115:8" />Cidungde tei kegaimedung nah,</para>
  <para style="q" vid="PSA 115:8">cidung de nlum kelame leune de cipaudung de nzwa da.<verse eid="PSA 115:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 115:9" />Israel, RAMPAUBE de nlum lu;</para>
  <para style="q" vid="PSA 115:9">pa nnuide kenghabe nah kegumbe.<verse eid="PSA 115:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 115:10" />Aaron leuhmedung, RAMPAUBE de nlumlu;</para>
  <para style="q" vid="PSA 115:10">pa nnuide kenghabe nah kegumbe.<verse eid="PSA 115:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 115:11" />Nnui RAMPAUBE de kerüt peu kelamedung, pecu nlumlu;</para>
  <para style="q" vid="PSA 115:11">pa nnuide kenghabe nah kegumbe.<verse eid="PSA 115:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 115:12" />RAMPAUBE anuide nsungla nah samlam beu zie;</para>
  <para style="q" vid="PSA 115:12">pa Israel leuhme de samlam beuzie;</para>
  <para style="q" vid="PSA 115:12">pa Aaron leuhme de samlam beuzie.<verse eid="PSA 115:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 115:13" />Pecu hing kelame de pa samlam beu zie,</para>
  <para style="q" vid="PSA 115:13">hename nah hecingme de.<note caller="-" style="x"><char style="xo" closed="false">115:13 </char><char style="xt" closed="false"><ref loc="PSA 128:1">Lei. 128:1</ref></char></note><verse eid="PSA 115:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 115:14" />Peu RAMPAUBE de nnui leu tei ngkiee reureu beulo,</para>
  <para style="q" vid="PSA 115:14">nnuide nah nnui namedung de.<verse eid="PSA 115:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 115:15" />Nnuide peu RAMPAUBE de samlam beulo,</para>
  <para style="q" vid="PSA 115:15">tinggim nah kideu tei kegaibe de.<verse eid="PSA 115:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 115:16" />Tinggim au RAMPAUBE gu,</para>
  <para style="q" vid="PSA 115:16">dede pa kideube pwa mina de peu dida.<verse eid="PSA 115:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 115:17" />RAMPAUBE de au ketsaime ne twa lama,</para>
  <para style="q" vid="PSA 115:17">mede ketsaime deu ga nghung kedime twa lama.<verse eid="PSA 115:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 115:18" />Dede anui RAMPAUBE de ketwa peuzie</para>
  <para style="q" vid="PSA 115:18">cu nah kelungta.</para>
  <para style="q" vid="PSA 115:18">RAMPAUBE de twalu<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="s">Ih RAMPAUBE de hunglie</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 116:1" />Ih RAMPAUBE de hung la kedanemene pa</para>
  <para style="q" vid="PSA 116:1">a kwa siu nah a kekiedung kingnei kelane.<verse eid="PSA 116:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 116:2" />Pa a kwa kingnei la,</para>
  <para style="q" vid="PSA 116:2">Ih kelungta pecu qu zie.<verse eid="PSA 116:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 116:3" />Ketsai kengngi a cu twagwa la,</para>
  <para style="q" vid="PSA 116:3">nah herau kerim acu nna bamdi;</para>
  <para style="q" vid="PSA 116:3">Ih kengngi na lungpang le puidi.<note caller="-" style="x"><char style="xo" closed="false">116:3 </char><char style="xt" closed="false"><ref loc="PSA 18:4">Lei. 18:4</ref>,<ref loc="PSA 18:5">5</ref></char></note><verse eid="PSA 116:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 116:4" />Pecai Ih RAMPAUBE zi qugai:</para>
  <para style="q" vid="PSA 116:4">“RAMPAUBO acu ngaunggia eh, a teilung kelibeu lo.”<verse eid="PSA 116:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 116:5" />RAMPAUBE au mide ngaunggia nah mateunsam la;</para>
  <para style="q" vid="PSA 116:5">anui Tinggwang au mide ngaunggia la.<verse eid="PSA 116:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 116:6" />RAMPAUBE au kengha kegahme de gum beula;</para>
  <para style="q" vid="PSA 116:6">Ih kengngi ga ladi, nah pa ne acu kelibeu.<verse eid="PSA 116:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 116:7" />A rabe pe kemtak ni ga cailigwang daidi lubui da</para>
  <para style="q" vid="PSA 116:7">kedanemene RAMPAUBE a dade pezai yi kelane.<verse eid="PSA 116:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 116:8" />Kedanemene nang ketsai gade a teilung kelibeu da,</para>
  <para style="q" vid="PSA 116:8">a miakduidung peu lwa tadi,</para>
  <para style="q" vid="PSA 116:8">nah peu acu ngam dima.<verse eid="PSA 116:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 116:9" />Ih keringme deu ga de</para>
  <para style="q" vid="PSA 116:9">RAMPAUBE gwa tei zie.<verse eid="PSA 116:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 116:10" />Ih RAMPAUBE de nlum bam, Ih ainzwa kerang daude,</para>
  <para style="q" vid="PSA 116:10">“Ih kehereisüt dida.”<note caller="+" style="f"><char style="fr" closed="false">116:10 </char><char style="ft" closed="false">2 Cor. 4:13</char></note><verse eid="PSA 116:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 116:11" />Ngngi kebamdau Ih rang eh,</para>
  <para style="q" vid="PSA 116:11">“Mina aidung pelane au kenretme.”<note caller="-" style="x"><char style="xo" closed="false">116:11 </char><char style="xt" closed="false"><ref loc="ROM 3:4">Rom. 3:4</ref></char></note><verse eid="PSA 116:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 116:12" />Ih dainzwa RAMPAUBE pau rui lai</para>
  <para style="q" vid="PSA 116:12">a dage pe keyi pelane ziemne?<verse eid="PSA 116:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 116:13" />Ih kelikelu piak pwa eh,</para>
  <para style="q" vid="PSA 116:13">RAMPAUBE zi quzie.<verse eid="PSA 116:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 116:14" />Ih RAMPAUBE dage a sam pet keludung de teicang zie</para>
  <para style="q" vid="PSA 116:14">pe minadung pelane kebam gade.<verse eid="PSA 116:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 116:15" />Pe minadung tsai kegai au</para>
  <para style="q" vid="PSA 116:15">RAMPAUBE dwa gade pemi hungtu lie.<verse eid="PSA 116:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 116:16" />RAMPAUBO, kesangda, Ih n kilabe lie;</para>
  <para style="q" vid="PSA 116:16">Ih n kilabe, n kilapui napei lie;</para>
  <para style="q" vid="PSA 116:16">nang ketsai gade acu keli luda.<verse eid="PSA 116:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 116:17" />Ih ncu ketwa ratak peu zie</para>
  <para style="q" vid="PSA 116:17">nah RAMPAUBE zi quzie.<verse eid="PSA 116:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 116:18" />Ih RAMPAUBE dage a sam pet keludung de teicang zie</para>
  <para style="q" vid="PSA 116:18">pe minadung pelane kebam gade,<verse eid="PSA 116:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 116:19" />RAMPAUBE kigu gade,</para>
  <para style="q" vid="PSA 116:19">nnui kakga de, Jerusalem ga.</para>
  <para style="q" vid="PSA 116:19">RAMPAUBE de twalu.<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="s">RAMPAUBE masang bam muila</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 117:1" />RAMPAUBE de twalu, nnui heleuh pelane;</para>
  <para style="q" vid="PSA 117:1">pecu twalu, mina pelane.<note caller="-" style="x"><char style="xo" closed="false">117:1 </char><char style="xt" closed="false"><ref loc="ROM 15:11">Rom. 15:11</ref></char></note><verse eid="PSA 117:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 117:2" />Kedanemene pa anuide pe keku au di,</para>
  <para style="q" vid="PSA 117:2">nah RAMPAUBE de nlumlukebui au kelungta bamla.</para>
  <para style="q" vid="PSA 117:2">RAMPAUBE de twalu.<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="s">Pe keku au bam muila</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 118:1" />RAMPAUBE de hetwa peulu, kedanemene pa yi kecune,</para>
  <para style="q" vid="PSA 118:1">pe samkakkelu samsang kelungta la kecune.<verse eid="PSA 118:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 118:2" />Israel mina depeu,</para>
  <para style="q" vid="PSA 118:2">“Pe samkakkelu samsang kelungta la,” de eh peu ranglu.<verse eid="PSA 118:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 118:3" />Aaron leuhme depeu,</para>
  <para style="q" vid="PSA 118:3">“Pe samkakkelu samsang kelungta la,” de eh peu ranglu.<verse eid="PSA 118:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 118:4" />RAMPAUBE mie hing kelame de peu rang dailu caisuime de peu masanglu,</para>
  <para style="q" vid="PSA 118:4">“Pe keku samsang au kelungta la,” de eh peu ranglu.<verse eid="PSA 118:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 118:5" />Ih rei kela gade Ih RAMPAUBE de qugai;</para>
  <para style="q" vid="PSA 118:5">RAMPAUBE a sam keligai nah acu kelibeu.<verse eid="PSA 118:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 118:6" />RAMPAUBE a da la; Ih ngngi dilak;</para>
  <para style="q" vid="PSA 118:6">mina ne acu dai tei lulai?<note caller="+" style="f"><char style="fr" closed="false">118:6 </char><char style="ft" closed="false">Rom. 8:31, Heb. 13:6</char></note><verse eid="PSA 118:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 118:7" />RAMPAUBE acu ngha la nah a taiga la;</para>
  <para style="q" vid="PSA 118:7">Acu ngaurau kelame de Ih ngamkelu ngau zie.<verse eid="PSA 118:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 118:8" />RAMPAUBE da nsiu kelube yiki</para>
  <para style="q" vid="PSA 118:8">mina de kenlum swa.<verse eid="PSA 118:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 118:9" />RAMPAUBE da nsiu kelu be au yiki</para>
  <para style="q" vid="PSA 118:9">kengkiengmedung de kenlum swade.<verse eid="PSA 118:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 118:10" />Heleuh leune acu twagwa pungbam;</para>
  <para style="q" vid="PSA 118:10">RAMPAUBE zi gade Ih penuide ngkap dizie.<verse eid="PSA 118:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 118:11" />Penui acu twagwalu; yeo, penui acu twagwalu;</para>
  <para style="q" vid="PSA 118:11">RAMPAUBE zi gade Ih penuide ngkap dizie.<verse eid="PSA 118:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 118:12" />Tegeinedung nzwa penui acu twagwalu;</para>
  <para style="q" vid="PSA 118:12">penui hetubangdung ga mi gah zette di kela nzwa gah dila;</para>
  <para style="q" vid="PSA 118:12">RAMPAUBE zi gade Ih penuide ngkap dizie.<verse eid="PSA 118:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 118:13" />Penui acu tei nkau di kerane acu renia,</para>
  <para style="q" vid="PSA 118:13">dede RAMPAUBE acu ngha beu.<verse eid="PSA 118:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 118:14" />RAMPAUBE a kengkieng nah a suiyi,</para>
  <para style="q" vid="PSA 118:14">nah pane acu kelibeu kelabe.<verse eid="PSA 118:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 118:15" />Ngkieng kelu suiyi kwadung kesamsangme paikidung ga siu bam dida;</para>
  <para style="q" vid="PSA 118:15">RAMPAUBE zetle ba ngkinglu da.<verse eid="PSA 118:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 118:16" />RAMPAUBE zetle ba de hetwa pwa peu bam;</para>
  <para style="q" vid="PSA 118:16">RAMPAUBE zetle ba ngkinglu da.<verse eid="PSA 118:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 118:17" />Ih tsai dilak, dede ring luzie</para>
  <para style="q" vid="PSA 118:17">nah RAMPAUBE tadung de mdu lia zie.<verse eid="PSA 118:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 118:18" />RAMPAUBE acu saja peu msiasüt gai;</para>
  <para style="q" vid="PSA 118:18">dede pa acu ketsai ba gage kai dima.<note caller="+" style="f"><char style="fr" closed="false">118:18 </char><char style="ft" closed="false">2 Cor. 6:9, Heb. 12:10-11</char></note><verse eid="PSA 118:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 118:19" />Kesamsang kirieki acu let beulo;</para>
  <para style="q" vid="PSA 118:19">Ih cika lüt eh RAMPAUBE de hetwa peu zie.<verse eid="PSA 118:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 118:20" />Aide RAMPAUBE kirieki da;</para>
  <para style="q" vid="PSA 118:20">kesamsangme cikade nlüt zie.<note caller="-" style="x"><char style="xo" closed="false">118:20 </char><char style="xt" closed="false"><ref loc="JHN 10:9">Jhn. 10:9</ref></char></note><verse eid="PSA 118:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 118:21" />Ih ncu hetwa peu zie, kedanemene nang a kekie teibeu kecu ziemne,</para>
  <para style="q" vid="PSA 118:21">nah nang a kelikelube dide kecu ziemne.<verse eid="PSA 118:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 118:22" />Tangtsu ta keteime tangtsu kemta lie de gi kedi tangtsu de</para>
  <para style="q" vid="PSA 118:22">kimiak tangtsu teidi.<note caller="+" style="f"><char style="fr" closed="false">118:22 </char><char style="ft" closed="false">1 Pet. 2:4, Luk. 20:17</char></note><verse eid="PSA 118:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 118:23" />Aide RAMPAUBE ne teigai;</para>
  <para style="q" vid="PSA 118:23">aide anui miak dwa gade miswakegah ta ge.<verse eid="PSA 118:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 118:24" />Aipau benai RAMPAUBE pe bata teigai;</para>
  <para style="q" vid="PSA 118:24">anui renga zie nah aika anui sui yizie.<verse eid="PSA 118:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 118:25" />Ngaungia eh, RAMPAUBO, anuide kengkieng peulo!</para>
  <para style="q" vid="PSA 118:25">Ngaungia eh, RAMPAUBO, anuide yi kelu peulo!<verse eid="PSA 118:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 118:26" />RAMPAUBE zi gade kegwangbe ne samlam pungtu;</para>
  <para style="q" vid="PSA 118:26">RAMPAUBE ki gade anui nnuide samlam beula.<note caller="+" style="f"><char style="fr" closed="false">118:26 </char><char style="ft" closed="false">Mat. 23:39, Luk. 13:35, Mrk. 11:9-10</char></note><verse eid="PSA 118:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 118:27" />RAMPAUBE au Tinggwang, nah pa anuide kebaa peu da;</para>
  <para style="q" vid="PSA 118:27">ratak tei kegai de heria le kang eh recabam kiidung gage kang ncütlu.<verse eid="PSA 118:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 118:28" />Nang au a Tinggwang, nah Ih ncu hetwa pwa peuzie;</para>
  <para style="q" vid="PSA 118:28">nang au a Tinggwang; Ih ncu hetwa peu zie.<verse eid="PSA 118:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 118:29" />Oh, RAMPAUBE de hetwa peulo; kedanemene pa yi kecune;</para>
  <para style="q" vid="PSA 118:29">pe samkakkelu samsang kelungta la kecune.<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="s">N sam au a pi mitaubung</para>
  <para style="qa">ALEPH</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 119:1" />Penui teilung kemau kegahme ne samlam pungtu,</para>
  <para style="q" vid="PSA 119:1">RAMPAUBE zai gade tet kelame.<verse eid="PSA 119:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 119:2" />Pe ajadung mzui kelamedung ne samlam pungtu,</para>
  <para style="q" vid="PSA 119:2">penui nlung pelane teu pecu peei kelame<verse eid="PSA 119:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 119:3" />Penui ma tei maudi lama;</para>
  <para style="q" vid="PSA 119:3">penui RAMPAUBE lampui ga tetla la.<verse eid="PSA 119:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 119:4" />Oh RAMPAUBO, nang anuide n keledeu samdung nzai lulo beuda</para>
  <para style="q" vid="PSA 119:4">anuide peu cidungde mzui siakte lu kerane.<verse eid="PSA 119:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 119:5" />Oh, n zaidung mzui kela gade</para>
  <para style="q" vid="PSA 119:5">Ih ntip bam lu kera!<verse eid="PSA 119:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 119:6" />Iciu lude Ih n ajadung cet kegaidau</para>
  <para style="q" vid="PSA 119:6">acu hengam gage kai dilak.<verse eid="PSA 119:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 119:7" />Ih a mlung kemci le teu ncu twazie</para>
  <para style="q" vid="PSA 119:7">Ih n tutiak kemzuidung ci keludau.<verse eid="PSA 119:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 119:8" />Ih n zaidung nzai zie;</para>
  <para style="q" vid="PSA 119:8">acu gi diso.<verse eid="PSA 119:8" /></para>
  <para style="qa">BETH</para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 119:9" />Daiznwa rehangme ge pe teilung teimci pwabam lulai?</para>
  <para style="q" vid="PSA 119:9">N samdung kemzai gade zie.<verse eid="PSA 119:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 119:10" />Ih a nlung pelane teu ncu peei zie;</para>
  <para style="q" vid="PSA 119:10">Peu acu n ajadung gade tetmdei diso.<verse eid="PSA 119:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 119:11" />Ih a nlung gage n sam kaipwabam</para>
  <para style="q" vid="PSA 119:11">Ih n dage kemau teigai di melu kerane.<verse eid="PSA 119:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 119:12" />Nang samlam pung lei, RAMPAUBO;</para>
  <para style="q" vid="PSA 119:12">n zaidung acu ledeu beulo.<verse eid="PSA 119:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 119:13" />A mui le Ih rang ndu gaila</para>
  <para style="q" vid="PSA 119:13">n tutiak kemzuidung nang keulia kegai leune de.<verse eid="PSA 119:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 119:14" />N samkakkelu zaidung ga Ih sui la</para>
  <para style="q" vid="PSA 119:14">maheidung pelane swade.<verse eid="PSA 119:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 119:15" />Nang ranglia kegaidung de Ih cetncok zie</para>
  <para style="q" vid="PSA 119:15">nah lh n keledeudung cetla.<verse eid="PSA 119:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 119:16" />Ih n zaidung a suila la;</para>
  <para style="q" vid="PSA 119:16">Ih n sam nsung tadi lak.<verse eid="PSA 119:16" /></para>
  <para style="qa">GIMEL</para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 119:17" />N kilabe dage n zai yi gailo iciu eh Ih lunglu kerane</para>
  <para style="q" vid="PSA 119:17">nah n sam mzailu kerane.<verse eid="PSA 119:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 119:18" />A miak tei nrak gai beulo iciu eh</para>
  <para style="q" vid="PSA 119:18">Ih n zai ga miswakegah batadung pielu kerane.<verse eid="PSA 119:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 119:19" />Ih hangdeu be ga sangme ge;</para>
  <para style="q" vid="PSA 119:19">n ajadung a dade hebai diso.<verse eid="PSA 119:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 119:20" />Alung tei eh a kereguidung au</para>
  <para style="q" vid="PSA 119:20">peting pelane n tutiak kemzuidung de cineu eh bam la.<verse eid="PSA 119:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 119:21" />Nang ngang kelame de kesiula, reset pung kelame,</para>
  <para style="q" vid="PSA 119:21">n samdung mzai la kemakme.<verse eid="PSA 119:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 119:22" />Acu hengam nah tei kengngam gade acu kelibeu lo,</para>
  <para style="q" vid="PSA 119:22">kedanemene n samkak kelu zaidung de Ih mzai kecune.<verse eid="PSA 119:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 119:23" />Hegwangme ngkwalwe acu rangmsia la,</para>
  <para style="q" vid="PSA 119:23">dede n kilabe au n zaidung cetncok lala.<verse eid="PSA 119:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 119:24" />N samkak kelu zaidung au a suiyi da,</para>
  <para style="q" vid="PSA 119:24">nah penui au a keledeumedung.<verse eid="PSA 119:24" /></para>
  <para style="qa">DALETH</para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 119:25" />A teilung rebui ga herak pwabam!</para>
  <para style="q" vid="PSA 119:25">N sam le acu teilung peulo.<verse eid="PSA 119:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 119:26" />Ih a lampuidung ncu ranglia da, nah nang a sam kelibeu;</para>
  <para style="q" vid="PSA 119:26">n zaidung acu ledeu beulo.<verse eid="PSA 119:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 119:27" />N keledeu lampuidung de peu acu cilo,</para>
  <para style="q" vid="PSA 119:27">iciu eh Ih n keledeusam miswakegahdung de cetncok kerane.<verse eid="PSA 119:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 119:28" />Ih au suisiet le puipung!</para>
  <para style="q" vid="PSA 119:28">N sam le acu tei ngkieng beulo.<verse eid="PSA 119:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 119:29" />Mide kecwa lampui gade acu teu nreu beulo;</para>
  <para style="q" vid="PSA 119:29">n zai keyi gade acu n zai ledeu beulo.<verse eid="PSA 119:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 119:30" />Kesamsang lampui de Ih kedet luda;</para>
  <para style="q" vid="PSA 119:30">A dwa gade n tutiak kemzuidung de Ih mzai muila.<verse eid="PSA 119:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 119:31" />N samkak kelu zaidung de Ih herak ntip pwabam;</para>
  <para style="q" vid="PSA 119:31">RAMPAUBO, acu peu hengam tei diso.<verse eid="PSA 119:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 119:32" />N ajadung lampui ga Ih pak zie,</para>
  <para style="q" vid="PSA 119:32">kedanemene nang ne cide tei kera a nlung tei mdibeu kecune.<verse eid="PSA 119:32" /></para>
  <para style="qa">HE</para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 119:33" />Acu ledeu beulo, RAMPAUBO, n zai kiedungde,</para>
  <para style="q" vid="PSA 119:33">nah kekam kecang Ih cide nzai lazie.<verse eid="PSA 119:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 119:34" />Macet keci acu peulo, nah Ih n zai mzui luzie;</para>
  <para style="q" vid="PSA 119:34">A nlung pelane teu Ih cide nzai luzie.<verse eid="PSA 119:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 119:35" />N ajadung lampui gage acu ngngwa gailo,</para>
  <para style="q" vid="PSA 119:35">kedanemene Ih cika tet kera a suila la.<verse eid="PSA 119:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 119:36" />N samkakkelu zaidung lebie ge a nlung de saugai beu</para>
  <para style="q" vid="PSA 119:36">nah samsang kemak kehengim gade acu teu mdei dilu.<verse eid="PSA 119:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 119:37" />Kemtabe<note caller="+" style="f"><char style="fr" closed="false">119:37 </char><char style="fq" closed="false">Kemtabe </char><char style="ft" closed="false">Mamie kereca</char></note> niadung kepie gade a miak teunreu dilu;</para>
  <para style="q" vid="PSA 119:37">n sui lungning gade acu tei ngkieng beulo.<verse eid="PSA 119:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 119:38" />N kilabe ziemne n sampet de teicang beulo</para>
  <para style="q" vid="PSA 119:38">ncu herüt peu kelame dage n sam petgai kebeude.<verse eid="PSA 119:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 119:39" />Ih hing kebam acu ki kecu gade acu teu tetdi beulo,</para>
  <para style="q" vid="PSA 119:39">kedanemene n kesamsang hezaidung au yi kecune.<verse eid="PSA 119:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 119:40" />Pielo, Ih n keledeudung nzai neula;</para>
  <para style="q" vid="PSA 119:40">n kesamsang gade acu tei ngkieng beulo.<verse eid="PSA 119:40" /></para>
  <para style="qa">VAV</para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 119:41" />RAMPAUBO, madaude nlidi la kemak n keku acu peulo,</para>
  <para style="q" vid="PSA 119:41">n kelikelu, n sam pet kebeude nzwa;<verse eid="PSA 119:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 119:42" />iciude acu kii kelame sam keli lu kera a da bam zie,</para>
  <para style="q" vid="PSA 119:42">kedanemene Ih n sam nlum lalu.<verse eid="PSA 119:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 119:43" />A mui gade kesang sam keuteu di helo,</para>
  <para style="q" vid="PSA 119:43">kedanemene a keregui n tutiak kemzuidung ga bamlu.<verse eid="PSA 119:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 119:44" />Ih n zaidung mzai lamui zie,</para>
  <para style="q" vid="PSA 119:44">kelungta nah kelungta.<verse eid="PSA 119:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 119:45" />Ih kwak eh tet zie,</para>
  <para style="q" vid="PSA 119:45">kedanemene Ih n keledeudung de peei lalu.<verse eid="PSA 119:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 119:46" />Ih n sam kaikebeudung de hegwangmedung dwa gade rang zie</para>
  <para style="q" vid="PSA 119:46">nah ngngam dilak.<note caller="-" style="x"><char style="xo" closed="false">119:46 </char><char style="xt" closed="false"><ref loc="ROM 1:16">Rom. 1:16</ref></char></note><verse eid="PSA 119:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 119:47" />Ih n ajadung ga asui lala,</para>
  <para style="q" vid="PSA 119:47">Ih hungsüt keladung de.<verse eid="PSA 119:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 119:48" />Ih n ajadung de rüt zie, Ih hung kelade;</para>
  <para style="q" vid="PSA 119:48">Ih n zaidung de cetncok zie.<verse eid="PSA 119:48" /></para>
  <para style="qa">ZAYIN</para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 119:49" />N kilabe dage n sampet de teicang kera nsunggai lo</para>
  <para style="q" vid="PSA 119:49">kedanemene nang acu keregui peu kecune.<verse eid="PSA 119:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 119:50" />Aide Ih keherei keladau acu tei ncieplu kelabe:</para>
  <para style="q" vid="PSA 119:50">n sam pet kebeude acu kering peu kelade.<verse eid="PSA 119:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 119:51" />Ngang kelame acu mneula,</para>
  <para style="q" vid="PSA 119:51">dede n zai gade Ih nreu tetdi ma.<verse eid="PSA 119:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 119:52" />Ih ndaa de n tutiak kemzuidung de cet lala, RAMPAUBO,</para>
  <para style="q" vid="PSA 119:52">nah Ih akatei acu a lung tau mla lula.<verse eid="PSA 119:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 119:53" />Ih a ratasüt dila</para>
  <para style="q" vid="PSA 119:53">kenlienme n zai mlai kedide ziemne.<verse eid="PSA 119:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 119:54" />N zaidung de a leidung da</para>
  <para style="q" vid="PSA 119:54">Ih kak nage lung kebam ki dega.<verse eid="PSA 119:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 119:55" />Ih tingmui n zi cet la, RAMPAUBO,</para>
  <para style="q" vid="PSA 119:55">nah Ih n zai mzai la.<verse eid="PSA 119:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 119:56" />Aide Ih teimui la</para>
  <para style="q" vid="PSA 119:56">kedanemene Ih n keledeu de mzai lalu.<verse eid="PSA 119:56" /></para>
  <para style="qa">HETH</para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 119:57" />Ih luneu kela au nang RAMPAUBO;</para>
  <para style="q" vid="PSA 119:57">Ih n samdung mzai kera cet luda.<verse eid="PSA 119:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 119:58" />Ih n dade a mlung pelane teu acu nghalo de kiela;</para>
  <para style="q" vid="PSA 119:58">acu ngaunggia lo, n sam pet kebeu nzwa.<verse eid="PSA 119:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 119:59" />Ih a lampuidung cet mning gai</para>
  <para style="q" vid="PSA 119:59">nah n samkak kelu zaidung gage a pi teu nreu gai luda.<verse eid="PSA 119:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 119:60" />Ih ridi mene nzet eh</para>
  <para style="q" vid="PSA 119:60">n gu ajadung mzai lu kerane.<verse eid="PSA 119:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 119:61" />Kenlienme baih ne acu teu pwabam;</para>
  <para style="q" vid="PSA 119:61">Ih n zai nsungta dima.<verse eid="PSA 119:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 119:62" />Ih tingmuisum ge ncu twa kerane cuh la</para>
  <para style="q" vid="PSA 119:62">n tutiak kemzuidung de ziemne.<verse eid="PSA 119:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 119:63" />Ih ncu herüt peu kelame leune zangme ge,</para>
  <para style="q" vid="PSA 119:63">n keledeudung mzai kelame leune.<verse eid="PSA 119:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 119:64" />Kideu be, RAMPAUBO, n samkakkelu samsang le pui;</para>
  <para style="q" vid="PSA 119:64">n zaidung acu ledeu beulo.<verse eid="PSA 119:64" /></para>
  <para style="qa">TETH</para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 119:65" />N kilabe dage nang makeyi teigai,</para>
  <para style="q" vid="PSA 119:65">RAMPAUBO, n sam le.<verse eid="PSA 119:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 119:66" />Acu ma petaube nah keci kecet ledeu beulo,</para>
  <para style="q" vid="PSA 119:66">kedanemene Ih n ajadung de nlum lalu.<verse eid="PSA 119:66" /></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 119:67" />Ih keherei di kemakne kemau lampui ga tetla,</para>
  <para style="q" vid="PSA 119:67">dede cu au Ih n sam mzaila.<verse eid="PSA 119:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 119:68" />Oh RAMPAUBO, nang au yi, nah nang rünne makeyi teila;</para>
  <para style="q" vid="PSA 119:68">n zaidung acu ledeu beulo.<verse eid="PSA 119:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 119:69" />Ngang kelamedung kenretdung dele a ha rangmsia la,</para>
  <para style="q" vid="PSA 119:69">dede Ih a nlung pelane teu n keledeu de mzaila.<verse eid="PSA 119:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 119:70" />Penui nlungdung au tak,</para>
  <para style="q" vid="PSA 119:70">dede Ih n zai gade asui keyi ngau lula.<verse eid="PSA 119:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 119:71" />Ih keherei kegaide a ziemne keyi ge</para>
  <para style="q" vid="PSA 119:71">iciu eh Ih n zaidung cilu kerane.<verse eid="PSA 119:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 119:72" />N mui gade keledeu sam de</para>
  <para style="q" vid="PSA 119:72">kecak nah rangkanggeu pecang pecang swade a ziemne pemi whung ki.<verse eid="PSA 119:72" /></para>
  <para style="qa">YOD</para>
  <para style="q">
    <verse number="73" style="v" sid="PSA 119:73" />N ba le acu teigai nah a rehi teu beu;</para>
  <para style="q" vid="PSA 119:73">acu maci peulo iciu eh Ih n ajadung cilu kerane.<verse eid="PSA 119:73" /></para>
  <para style="q">
    <verse number="74" style="v" sid="PSA 119:74" />Ncu rüt kelame acu ngau kegaidau penui sui yizie</para>
  <para style="q" vid="PSA 119:74">kedanemene Ih n sam ga keregui ngaulu kelane.<verse eid="PSA 119:74" /></para>
  <para style="q">
    <verse number="75" style="v" sid="PSA 119:75" />Ih cibam, RAMPAUBO, n hezaidung au masang lie kecu,</para>
  <para style="q" vid="PSA 119:75">nah n masang ne acu saja peula.<verse eid="PSA 119:75" /></para>
  <para style="q">
    <verse number="76" style="v" sid="PSA 119:76" />N samkakkelu samsang de le a lung tau mla beulo,</para>
  <para style="q" vid="PSA 119:76">nang n kilabe de n sampet kai kebeu nzwa.<verse eid="PSA 119:76" /></para>
  <para style="q">
    <verse number="77" style="v" sid="PSA 119:77" />Acu ngaunggia gailo iciu eh Ih lunglu kerane,</para>
  <para style="q" vid="PSA 119:77">kedanemene Ih n zai de a sui lalu.<verse eid="PSA 119:77" /></para>
  <para style="q">
    <verse number="78" style="v" sid="PSA 119:78" />Peu ngang kelame de ngngam dilu,</para>
  <para style="q" vid="PSA 119:78">kedanemene penui acu rangmsia lalu;</para>
  <para style="q" vid="PSA 119:78">dede Ih au n keledeudung de cetncok lazie.<verse eid="PSA 119:78" /></para>
  <para style="q">
    <verse number="79" style="v" sid="PSA 119:79" />Peu ncu rüt kelame de a da nreu gwanglu,</para>
  <para style="q" vid="PSA 119:79">n samkak kelu zaidung de ci kebamme.<verse eid="PSA 119:79" /></para>
  <para style="q">
    <verse number="80" style="v" sid="PSA 119:80" />Peu a nlung de n zaidung gade mmau kecu tei diso</para>
  <para style="q" vid="PSA 119:80">iciu eh acu hengam ga kai di melu kerane.<verse eid="PSA 119:80" /></para>
  <para style="qa">KAPH</para>
  <para style="q">
    <verse number="81" style="v" sid="PSA 119:81" />Nang acu kelibeu kera kwa eh Ih mnei dida!</para>
  <para style="q" vid="PSA 119:81">N sam ga Ih regui bam.<verse eid="PSA 119:81" /></para>
  <para style="q">
    <verse number="82" style="v" sid="PSA 119:82" />A miak le n sampet de ngaugai neu bam;</para>
  <para style="q" vid="PSA 119:82">nang daidau a lung tau mla beu zieno?<verse eid="PSA 119:82" /></para>
  <para style="q">
    <verse number="83" style="v" sid="PSA 119:83" />Kedanemene Ih mika ga teigeu zaula ge nzwa dida;</para>
  <para style="q" vid="PSA 119:83">Ih n zaidung nsungta dima.<verse eid="PSA 119:83" /></para>
  <para style="q">
    <verse number="84" style="v" sid="PSA 119:84" />Dai tingtie ge n kilabe aide lia lai;</para>
  <para style="q" vid="PSA 119:84">acu mneu kelame de nang daidau tiak lai?<verse eid="PSA 119:84" /></para>
  <para style="q">
    <verse number="85" style="v" sid="PSA 119:85" />N sam de gika di eh,</para>
  <para style="q" vid="PSA 119:85">Ngang kelame a ziemne hom kui luda.<verse eid="PSA 119:85" /></para>
  <para style="q">
    <verse number="86" style="v" sid="PSA 119:86" />N ajadung leune au nlum lubui;</para>
  <para style="q" vid="PSA 119:86">cipau minadung acu nret eh acu ngaurau la; acu ngha lo.<verse eid="PSA 119:86" /></para>
  <para style="q">
    <verse number="87" style="v" sid="PSA 119:87" />Penui kideu gade peu a teilung kekambe tei di nage da,</para>
  <para style="q" vid="PSA 119:87">dede Ih n keledeudung de mlai dima.<verse eid="PSA 119:87" /></para>
  <para style="q">
    <verse number="88" style="v" sid="PSA 119:88" />Bammui kela n keku de le, acu peu lunglo,</para>
  <para style="q" vid="PSA 119:88">iciu eh Ih n ajadung mzailu kerane.<verse eid="PSA 119:88" /></para>
  <para style="qa">LAMEDH</para>
  <para style="q">
    <verse number="89" style="v" sid="PSA 119:89" />RAMPAUBO, n sam kelungta lala;</para>
  <para style="q" vid="PSA 119:89">n sam au tinggim ga ntiprip bam.<verse eid="PSA 119:89" /></para>
  <para style="q">
    <verse number="90" style="v" sid="PSA 119:90" />N masang ceheu pelane ga bamla;</para>
  <para style="q" vid="PSA 119:90">nang kideu de teigai, nah cide pelui eh bam.<verse eid="PSA 119:90" /></para>
  <para style="q">
    <verse number="91" style="v" sid="PSA 119:91" />Mapelane henai kecangde ntakdi ma, n tutiak kemzuidung gage rang kegai nzwa,</para>
  <para style="q" vid="PSA 119:91">kedanemene mapelane n kiladung lu.<verse eid="PSA 119:91" /></para>
  <para style="q">
    <verse number="92" style="v" sid="PSA 119:92" />Magade Ih n zai a sui la meliecai,</para>
  <para style="q" vid="PSA 119:92">Ih a reidung gade tsaidi zie dege.<verse eid="PSA 119:92" /></para>
  <para style="q">
    <verse number="93" style="v" sid="PSA 119:93" />N keledeudung de Ih madaude nsungta dilak,</para>
  <para style="q" vid="PSA 119:93">kedanemene cidungde gade nang peu acu ringbam delu.<verse eid="PSA 119:93" /></para>
  <para style="q">
    <verse number="94" style="v" sid="PSA 119:94" />Ih au ngu; acu kelibeu,</para>
  <para style="q" vid="PSA 119:94">kedanemene Ih n keledeudung de peei lalu.<verse eid="PSA 119:94" /></para>
  <para style="q">
    <verse number="95" style="v" sid="PSA 119:95" />Kenlienme acu tei ngkapti kera mtei bam,</para>
  <para style="q" vid="PSA 119:95">dede Ih n samkak kelu zaidung de cilu kera peei zie.<verse eid="PSA 119:95" /></para>
  <para style="q">
    <verse number="96" style="v" sid="PSA 119:96" />Mapelane de penli kebam Ih ci luda,</para>
  <para style="q" vid="PSA 119:96">dede n ajadung au disüt eh penli teima.<verse eid="PSA 119:96" /></para>
  <para style="qa">MEM</para>
  <para style="q">
    <verse number="97" style="v" sid="PSA 119:97" />Oh dai kenzwa gede Ih n zai de a sui no!</para>
  <para style="q" vid="PSA 119:97">Ih cide tingba zie pelane cetncok lala.<verse eid="PSA 119:97" /></para>
  <para style="q">
    <verse number="98" style="v" sid="PSA 119:98" />N ajadung acu a ngauraume swade tei mteu beula,</para>
  <para style="q" vid="PSA 119:98">kedanemene n ajadung au keheidau de a da lalu.<verse eid="PSA 119:98" /></para>
  <para style="q">
    <verse number="99" style="v" sid="PSA 119:99" />A keledeumedung swade a maci kiee ki,</para>
  <para style="q" vid="PSA 119:99">kedanemene Ih n samkak kelu zaidung de cetncok lalu.<verse eid="PSA 119:99" /></para>
  <para style="q">
    <verse number="100" style="v" sid="PSA 119:100" />Ih aswa hecingmedung swade ma cikiee ki lula;</para>
  <para style="q" vid="PSA 119:100">aide au Ih n keledeudung de mzai la kecune.<verse eid="PSA 119:100" /></para>
  <para style="q">
    <verse number="101" style="v" sid="PSA 119:101" />Ih kemau lampui leune gade mbai dida</para>
  <para style="q" vid="PSA 119:101">iciu eh Ih n sam mzailu kerane.<verse eid="PSA 119:101" /></para>
  <para style="q">
    <verse number="102" style="v" sid="PSA 119:102" />N samsang hezaidungde Ih mlai dima,</para>
  <para style="q" vid="PSA 119:102">kedanemene nang acu ledeu beu delu.<verse eid="PSA 119:102" /></para>
  <para style="q">
    <verse number="103" style="v" sid="PSA 119:103" />N samdung a ziemne dai kenzwa gede kum no,</para>
  <para style="q" vid="PSA 119:103">yeo, heliadui swade kum amui gade!<verse eid="PSA 119:103" /></para>
  <para style="q">
    <verse number="104" style="v" sid="PSA 119:104" />N keledeudung gade Ih maci ngau lula;</para>
  <para style="q" vid="PSA 119:104">cine Ih kenret lampui leune ngkau la.<verse eid="PSA 119:104" /></para>
  <para style="qa">NUN</para>
  <para style="q">
    <verse number="105" style="v" sid="PSA 119:105" />N sam au a lampui saulia la</para>
  <para style="q" vid="PSA 119:105">nah a lampui ziemne kebaa ge.<verse eid="PSA 119:105" /></para>
  <para style="q">
    <verse number="106" style="v" sid="PSA 119:106" />Ih a sam pet kaila nah cide Ih teibi zie,</para>
  <para style="q" vid="PSA 119:106">Ih n tutiak kemzuidung de mzai kera de.<verse eid="PSA 119:106" /></para>
  <para style="q">
    <verse number="107" style="v" sid="PSA 119:107" />Ih kehereisüt bam;</para>
  <para style="q" vid="PSA 119:107">acu peu lunglo, RAMPAUBO, nang n sam kaikebeu de nzwa.<verse eid="PSA 119:107" /></para>
  <para style="q">
    <verse number="108" style="v" sid="PSA 119:108" />RAMPAUBO, Ih mta pwa kepeu reca de luulo,</para>
  <para style="q" vid="PSA 119:108">nah n samsang hezaidungde acu ledeu beulo.<verse eid="PSA 119:108" /></para>
  <para style="q">
    <verse number="109" style="v" sid="PSA 119:109" />A teilung au kengngi ga lamui lala,</para>
  <para style="q" vid="PSA 119:109">dede Ih n zaidungde nsung ta dima.<verse eid="PSA 119:109" /></para>
  <para style="q">
    <verse number="110" style="v" sid="PSA 119:110" />Kenlienmedung a ziemne baih ge teu pwabam,</para>
  <para style="q" vid="PSA 119:110">dede Ih n keledeudung gade tet mdei dima.<verse eid="PSA 119:110" /></para>
  <para style="q">
    <verse number="111" style="v" sid="PSA 119:111" />N samkak kelu zaidung de Ih kelungta a mapwa liede eh luu luda,</para>
  <para style="q" vid="PSA 119:111">kedanemene cidungde a nlung suiyi delu.<verse eid="PSA 119:111" /></para>
  <para style="q">
    <verse number="112" style="v" sid="PSA 119:112" />A nlung n zaidung mzai kerane tiak luda</para>
  <para style="q" vid="PSA 119:112">kelungta penli kecang.<verse eid="PSA 119:112" /></para>
  <para style="qa">SAMEKH</para>
  <para style="q">
    <verse number="113" style="v" sid="PSA 119:113" />Lung na tei kelame de Ih ngkaula,</para>
  <para style="q" vid="PSA 119:113">dede Ih n zai a sui la.<verse eid="PSA 119:113" /></para>
  <para style="q">
    <verse number="114" style="v" sid="PSA 119:114" />Nang au a kensiu ki nah acu kegumbe;</para>
  <para style="q" vid="PSA 119:114">n sam ga a keregui bam.<verse eid="PSA 119:114" /></para>
  <para style="q">
    <verse number="115" style="v" sid="PSA 119:115" />A dade mdei di, nnui kesia keteimedung,</para>
  <para style="q" vid="PSA 119:115">iciu eh Ih a Tinggwang ajadung de mzailu kerane.<verse eid="PSA 119:115" /></para>
  <para style="q">
    <verse number="116" style="v" sid="PSA 119:116" />N sam de le acu kengkieng peulo iciu eh lunglu kerane</para>
  <para style="q" vid="PSA 119:116">acu peu a keregui gade hengam ngau diso.<verse eid="PSA 119:116" /></para>
  <para style="q">
    <verse number="117" style="v" sid="PSA 119:117" />Acu nghalo, iciu lude Ih kwak luzie;</para>
  <para style="q" vid="PSA 119:117">Ih n zaidung de cet ncok lamui zie.<verse eid="PSA 119:117" /></para>
  <para style="q">
    <verse number="118" style="v" sid="PSA 119:118" />Nang n zaidung mzai kemakmedung de gidi la,</para>
  <para style="q" vid="PSA 119:118">kedanemene penui au mide cwa kelame nah nlumlu kebuime ma.<verse eid="PSA 119:118" /></para>
  <para style="q">
    <verse number="119" style="v" sid="PSA 119:119" />Kideube kenlienmedung de kehera nzwa keu mpetti la;</para>
  <para style="q" vid="PSA 119:119">cine Ih n ajadung a sui la.<verse eid="PSA 119:119" /></para>
  <para style="q">
    <verse number="120" style="v" sid="PSA 119:120" />Ncu kehing gade a pum mbeu dila,</para>
  <para style="q" vid="PSA 119:120">nah Ih n samsang hezaidungde ziemne kengngi le pui dida.<verse eid="PSA 119:120" /></para>
  <para style="qa">AYIN</para>
  <para style="q">
    <verse number="121" style="v" sid="PSA 119:121" />Ih kemzuibe nah petaube tei la;</para>
  <para style="q" vid="PSA 119:121">acu a ngauraume dage gigai beu so.<verse eid="PSA 119:121" /></para>
  <para style="q">
    <verse number="122" style="v" sid="PSA 119:122" />Nang n kilabe acu ngha zielie kecu n sam pet gailo;</para>
  <para style="q" vid="PSA 119:122">ngang kelame de acu peu tei keherei di helo.<verse eid="PSA 119:122" /></para>
  <para style="q">
    <verse number="123" style="v" sid="PSA 119:123" />N kelikelu de kwa eh a miak leu dida</para>
  <para style="q" vid="PSA 119:123">nah n kesamsang sam de ziemne.<verse eid="PSA 119:123" /></para>
  <para style="q">
    <verse number="124" style="v" sid="PSA 119:124" />N samkakkelu samsang de n kilabe acu keulia lo,</para>
  <para style="q" vid="PSA 119:124">nah n zaidung de acu ledeu beulo.<verse eid="PSA 119:124" /></para>
  <para style="q">
    <verse number="125" style="v" sid="PSA 119:125" />Ih n kilabe; acu maci peulo</para>
  <para style="q" vid="PSA 119:125">iciu eh Ih n samkakkelu zaidung de cilu kerane.<verse eid="PSA 119:125" /></para>
  <para style="q">
    <verse number="126" style="v" sid="PSA 119:126" />RAMPAUBE pe bata tei kera ting dida,</para>
  <para style="q" vid="PSA 119:126">kedanemene minadung n zai gikah di delu.<verse eid="PSA 119:126" /></para>
  <para style="q">
    <verse number="127" style="v" sid="PSA 119:127" />Ih n ajadung de hung kesang</para>
  <para style="q" vid="PSA 119:127">kecak swade, kecak mcitube swade.<verse eid="PSA 119:127" /></para>
  <para style="q">
    <verse number="128" style="v" sid="PSA 119:128" />Cine Ih n zaidung mzai teune la,</para>
  <para style="q" vid="PSA 119:128">nah Ih kenret lampuidung pelane ngkau la.<verse eid="PSA 119:128" /></para>
  <para style="qa">PE</para>
  <para style="q">
    <verse number="129" style="v" sid="PSA 119:129" />N hezaidung au miswagah,</para>
  <para style="q" vid="PSA 119:129">cide ziemne Ih cidungde mzaila.<verse eid="PSA 119:129" /></para>
  <para style="q">
    <verse number="130" style="v" sid="PSA 119:130" />N keledeu sam rangmci kegaidung dene kebaa peula;</para>
  <para style="q" vid="PSA 119:130">ledeu beu kemakme de maci peula.<verse eid="PSA 119:130" /></para>
  <para style="q">
    <verse number="131" style="v" sid="PSA 119:131" />Ih a mui nkei lu nah ngngi gai la,</para>
  <para style="q" vid="PSA 119:131">kedanemene Ih n ajadung luu neu kecune.<verse eid="PSA 119:131" /></para>
  <para style="q">
    <verse number="132" style="v" sid="PSA 119:132" />A da nreu gwanglo nah acu ngaunggia gailo,</para>
  <para style="q" vid="PSA 119:132">nang ncu ku kelame dage teigai mui kelade nzwa eh.<verse eid="PSA 119:132" /></para>
  <para style="q">
    <verse number="133" style="v" sid="PSA 119:133" />Nang n sam le a pikietdung sau lialo;</para>
  <para style="q" vid="PSA 119:133">peu kemau gede areu ngking diso.<verse eid="PSA 119:133" /></para>
  <para style="q">
    <verse number="134" style="v" sid="PSA 119:134" />Mide tei keherei kecume dade acu keli beulo</para>
  <para style="q" vid="PSA 119:134">iciu eh Ih n keledeudung mzai lu kerane.<verse eid="PSA 119:134" /></para>
  <para style="q">
    <verse number="135" style="v" sid="PSA 119:135" />N kilabe a dage n zu le taubaa beulo,</para>
  <para style="q" vid="PSA 119:135">nah n zaidung ledeu beulo.<verse eid="PSA 119:135" /></para>
  <para style="q">
    <verse number="136" style="v" sid="PSA 119:136" />A miakduidung a miak gade kereuki nzwa lwamie</para>
  <para style="q" vid="PSA 119:136">kedanemene minadung n zai mzaila kemakne.<verse eid="PSA 119:136" /></para>
  <para style="qa">TSADHE</para>
  <para style="q">
    <verse number="137" style="v" sid="PSA 119:137" />Nang au masang, RAMPAUBO,</para>
  <para style="q" vid="PSA 119:137">nah n hezaidung au mzui.<note caller="-" style="x"><char style="xo" closed="false">119:137 </char><char style="xt" closed="false"><ref loc="PSA 145:17">Lei. 145:17</ref></char></note><verse eid="PSA 119:137" /></para>
  <para style="q">
    <verse number="138" style="v" sid="PSA 119:138" />Nang n samkakkelu zaidung masang eh</para>
  <para style="q" vid="PSA 119:138">nah samsang eh peu gai.<verse eid="PSA 119:138" /></para>
  <para style="q">
    <verse number="139" style="v" sid="PSA 119:139" />Ih rata mi nzwa alung ga pui bam</para>
  <para style="q" vid="PSA 119:139">kedanemene a ngauraumedung n samdung nsungta kedi ziemne.<verse eid="PSA 119:139" /></para>
  <para style="q">
    <verse number="140" style="v" sid="PSA 119:140" />N sam de pie teune gaida,</para>
  <para style="q" vid="PSA 119:140">nah n kilabe cide de dai kenzwa gede pesui no.<verse eid="PSA 119:140" /></para>
  <para style="q">
    <verse number="141" style="v" sid="PSA 119:141" />Ih au magedema nah mina ne acu ngkau,</para>
  <para style="q" vid="PSA 119:141">dede Ih n keledeudung de nsungta dima.<verse eid="PSA 119:141" /></para>
  <para style="q">
    <verse number="142" style="v" sid="PSA 119:142" />N tutiak au kelungta petau,</para>
  <para style="q" vid="PSA 119:142">nah n zai au nlum lubui.<verse eid="PSA 119:142" /></para>
  <para style="q">
    <verse number="143" style="v" sid="PSA 119:143" />Keherei nah lungrei le acu pui dida,</para>
  <para style="q" vid="PSA 119:143">n sam kaikebeudungde ne suiyi ada teu gwang beu la.<verse eid="PSA 119:143" /></para>
  <para style="q">
    <verse number="144" style="v" sid="PSA 119:144" />N samkak kelu zaidung au kelungta masang;</para>
  <para style="q" vid="PSA 119:144">acu maci peulo Ih lunglu kerane.<verse eid="PSA 119:144" /></para>
  <para style="qa">QOPH</para>
  <para style="q">
    <verse number="145" style="v" sid="PSA 119:145" />Ih a nlung pelane teu mra gai, “A sam kelilo, RAMPAUBO,</para>
  <para style="q" vid="PSA 119:145">Ih n zaidung mzai zie.<verse eid="PSA 119:145" /></para>
  <para style="q">
    <verse number="146" style="v" sid="PSA 119:146" />Ih ncu kekie gade qugai; acu kelibeu lo,</para>
  <para style="q" vid="PSA 119:146">nah Ih n samkak kelu zaidung de mzai zie.”<verse eid="PSA 119:146" /></para>
  <para style="q">
    <verse number="147" style="v" sid="PSA 119:147" />Tingnaimiak kepet dwa Ih kengha kiegai.</para>
  <para style="q" vid="PSA 119:147">Ih n samdung ga keregui bam.<verse eid="PSA 119:147" /></para>
  <para style="q">
    <verse number="148" style="v" sid="PSA 119:148" />Tingmui ting tsamdi kemaktane a miak mrak pwabam</para>
  <para style="q" vid="PSA 119:148">iciu eh Ih n sam cetncok lu kerane.<verse eid="PSA 119:148" /></para>
  <para style="q">
    <verse number="149" style="v" sid="PSA 119:149" />N samkakkelu samsang gade a kwa kingneilo;</para>
  <para style="q" vid="PSA 119:149">acu peu ringbamlo, RAMPAUBO, n samsang hezaidung gage n sampet kai kebeunzwa eh.<verse eid="PSA 119:149" /></para>
  <para style="q">
    <verse number="150" style="v" sid="PSA 119:150" />Acu mneu kelame a da gwang mna reureu bam,</para>
  <para style="q" vid="PSA 119:150">dede penui au n zai gade mdeila.<verse eid="PSA 119:150" /></para>
  <para style="q">
    <verse number="151" style="v" sid="PSA 119:151" />Nang au nna bam, RAMPAUBO,</para>
  <para style="q" vid="PSA 119:151">nah n ajadung pelane nlum lubui.<verse eid="PSA 119:151" /></para>
  <para style="q">
    <verse number="152" style="v" sid="PSA 119:152" />Ndaa ge Ih n samkak kelu zaidung gade cilu</para>
  <para style="q" vid="PSA 119:152">nang cidungde de kelungta pebam gage kaipwa kebamde.<verse eid="PSA 119:152" /></para>
  <para style="qa">RESH</para>
  <para style="q">
    <verse number="153" style="v" sid="PSA 119:153" />A reidung de pie gailo nah acu nghalo,</para>
  <para style="q" vid="PSA 119:153">kedanemene Ih n zai nsungtadi melu.<verse eid="PSA 119:153" /></para>
  <para style="q">
    <verse number="154" style="v" sid="PSA 119:154" />A kie rangbeulo nah acu keli beulo;</para>
  <para style="q" vid="PSA 119:154">acu gumbeulo, n sam gage n sampet kai kebeu nzwa.<verse eid="PSA 119:154" /></para>
  <para style="q">
    <verse number="155" style="v" sid="PSA 119:155" />Kelikelu kenlienme dade mdei bam,</para>
  <para style="q" vid="PSA 119:155">kedanemene penui n zaidung de penui suila kemakne.<verse eid="PSA 119:155" /></para>
  <para style="q">
    <verse number="156" style="v" sid="PSA 119:156" />N ngaugia batadung au dizu, RAMPAUBO;</para>
  <para style="q" vid="PSA 119:156">acu peu ringbamlo, nang tei bammui kelanzwa.<verse eid="PSA 119:156" /></para>
  <para style="q">
    <verse number="157" style="v" sid="PSA 119:157" />Acu teikeherei kelame nah a ngauraume au kieesüt,</para>
  <para style="q" vid="PSA 119:157">dede Ih n samkak kelu zaidung gade nreutet dima.<verse eid="PSA 119:157" /></para>
  <para style="q">
    <verse number="158" style="v" sid="PSA 119:158" />Mide cwa kelame de Ih kemneu miakpie le piela</para>
  <para style="q" vid="PSA 119:158">kedanemene penui n sam mzai la melu.<verse eid="PSA 119:158" /></para>
  <para style="q">
    <verse number="159" style="v" sid="PSA 119:159" />Pielo Ih dai kenzwa gede n keledeudung de a sui no;</para>
  <para style="q" vid="PSA 119:159">acu peu ringbamlo, RAMPAUBO, n samkakkelu samsang ga n sampet kai kebeu nzwa.<verse eid="PSA 119:159" /></para>
  <para style="q">
    <verse number="160" style="v" sid="PSA 119:160" />N sam pelane au kesang;</para>
  <para style="q" vid="PSA 119:160">n tutiak kemzuidung leune au kelungta bamla.<verse eid="PSA 119:160" /></para>
  <para style="qa">SHIN</para>
  <para style="q">
    <verse number="161" style="v" sid="PSA 119:161" />Pekie tei mene hegwangpei napeidung acu tei keherei la,</para>
  <para style="q" vid="PSA 119:161">dede a nlung au n sam de rütla.<note caller="-" style="x"><char style="xo" closed="false">119:161 </char><char style="xt" closed="false"><ref loc="PSA 119:23">Lei. 119:23</ref></char></note><verse eid="PSA 119:161" /></para>
  <para style="q">
    <verse number="162" style="v" sid="PSA 119:162" />Ih n sam ga a sui yila</para>
  <para style="q" vid="PSA 119:162">mige mahei kekiee ge ngaulu kelame ge nzwa.<verse eid="PSA 119:162" /></para>
  <para style="q">
    <verse number="163" style="v" sid="PSA 119:163" />Ih kenretpe ngkau nah ngau rau,</para>
  <para style="q" vid="PSA 119:163">dede Ih n zai de a suila.<verse eid="PSA 119:163" /></para>
  <para style="q">
    <verse number="164" style="v" sid="PSA 119:164" />Tingnaige pia hena ncu twa la</para>
  <para style="q" vid="PSA 119:164">n tutiak kemzuidung de ziemne.<verse eid="PSA 119:164" /></para>
  <para style="q">
    <verse number="165" style="v" sid="PSA 119:165" />Lungciep kedi ge, n zai pesui kelame da la;</para>
  <para style="q" vid="PSA 119:165">penuide de tei ngkaulu kera magede gah.<verse eid="PSA 119:165" /></para>
  <para style="q">
    <verse number="166" style="v" sid="PSA 119:166" />Ih n kelikelu de regui bam, RAMPAUBO,</para>
  <para style="q" vid="PSA 119:166">nah Ih n ajadung de mzaila.<verse eid="PSA 119:166" /></para>
  <para style="q">
    <verse number="167" style="v" sid="PSA 119:167" />Ih n ajadung de mzaila,</para>
  <para style="q" vid="PSA 119:167">nah Ih cide a sui yisütla.<verse eid="PSA 119:167" /></para>
  <para style="q">
    <verse number="168" style="v" sid="PSA 119:168" />Ih n keledeudung nah n ajadung mzai la,</para>
  <para style="q" vid="PSA 119:168">kedanemene Ih ketei leune nang cibam kecune.<verse eid="PSA 119:168" /></para>
  <para style="qa">TAV</para>
  <para style="q">
    <verse number="169" style="v" sid="PSA 119:169" />Ih kengha kie kegai de kingneilo, RAMPAUBO;</para>
  <para style="q" vid="PSA 119:169">n sam de ci kera acu maci peulo.<verse eid="PSA 119:169" /></para>
  <para style="q">
    <verse number="170" style="v" sid="PSA 119:170" />A nggia kekie de peu n da gwang canglo;</para>
  <para style="q" vid="PSA 119:170">acu nghalo, nang n sam gage sampet kegai nzwa.<verse eid="PSA 119:170" /></para>
  <para style="q">
    <verse number="171" style="v" sid="PSA 119:171" />A muileu gade peu ketwa pui eh rui mpetlo,</para>
  <para style="q" vid="PSA 119:171">kedanemene nang n zaidung acu ledeubeu kecune.<verse eid="PSA 119:171" /></para>
  <para style="q">
    <verse number="172" style="v" sid="PSA 119:172" />Peu a mleu de n sam ha lei teilo,</para>
  <para style="q" vid="PSA 119:172">kedanemene n ajadung pelane petau kecune.<verse eid="PSA 119:172" /></para>
  <para style="q">
    <verse number="173" style="v" sid="PSA 119:173" />Peu n ba de acu nghalo,</para>
  <para style="q" vid="PSA 119:173">kedanemene Ih n keledeudung de kedetlu delu.<verse eid="PSA 119:173" /></para>
  <para style="q">
    <verse number="174" style="v" sid="PSA 119:174" />N kelilu de Ih luu neula, RAMPAUBO,</para>
  <para style="q" vid="PSA 119:174">nah n zai de a suiyi delei.<verse eid="PSA 119:174" /></para>
  <para style="q">
    <verse number="175" style="v" sid="PSA 119:175" />Peu acu ringlo nah ncu twalo,</para>
  <para style="q" vid="PSA 119:175">nah peu n samsang hezaidung depeu acu ngha lo.<verse eid="PSA 119:175" /></para>
  <para style="q">
    <verse number="176" style="v" sid="PSA 119:176" />Ih meurün gah kedibe nzwa rwala dida;</para>
  <para style="q" vid="PSA 119:176">n kilabe acu peei lulo,</para>
  <para style="q" vid="PSA 119:176">kedanemene Ih n ajadung nsungtadi melu.<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="s">Acu kelibeulo, O RAMPAUBO</para>
  <para style="d">Kenghang lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 120:1" />Ih keherei keludau, Ih RAMPAUBE de kekie gade qugai,</para>
  <para style="q" vid="PSA 120:1">nah pa acu samli peu.<verse eid="PSA 120:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 120:2" />Ateilung keli beu lo, RAMPAUBE, penui muidung le kenret kerangmedung</para>
  <para style="q" vid="PSA 120:2">nah penui mleudung le cwa kecu gade.<verse eid="PSA 120:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 120:3" />Pa dainzwa ncu saja peu zieno, nah daipai ge Tinggwang nda teisi gai zieno,</para>
  <para style="q" vid="PSA 120:3">nang kenret rang kelabe?<verse eid="PSA 120:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 120:4" />Pa ncu regwame ge gu lakpitsi pemui keyidung le zie geibei kebam miceu ru kebam gade</para>
  <para style="q" vid="PSA 120:4">nah miceu ru giebei kecule nnuide saja peu zie.<verse eid="PSA 120:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 120:5" />Keherei kecu au Ih da kedanemene Ih Meshech<note caller="+" style="f"><char style="fr" closed="false">120:5 </char><char style="ft" closed="false">cuikuidung</char></note> ga tingkak nage ziemne lung bam;</para>
  <para style="q" vid="PSA 120:5">Ih cipau dwa Kedar cuikui gu paikidung kakga lung.<verse eid="PSA 120:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 120:6" />Peting ketie ge</para>
  <para style="q" vid="PSA 120:6">Ih kezuyi ngkau kelamedung de ngngwa lung.<verse eid="PSA 120:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 120:7" />Ih au kezuyi ziemne,</para>
  <para style="q" vid="PSA 120:7">dede Ih marang kegai dau, penui au hereu ketei ziemne.<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="s">Acu kengha RAMPAUBE dade gwangla</para>
  <para style="d">Kengha kekie lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 121:1" />Ih a miakdung ngang cuh lamlwadung gage pie gai.</para>
  <para style="q" vid="PSA 121:1">Acu kengha daiga de gwang lai?<verse eid="PSA 121:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 121:2" />Acu kengha RAMPAUBE dade gwang zie,</para>
  <para style="q" vid="PSA 121:2">tinggim nah kideu tei kegaibe dade.<verse eid="PSA 121:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 121:3" />RAMPAUBE peu n pi reneu dilak;</para>
  <para style="q" vid="PSA 121:3">ncu kegumbe au ziangmui dilak.<verse eid="PSA 121:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 121:4" />Pielo, Israel de kegumbe</para>
  <para style="q" vid="PSA 121:4">madaude ziangmui mede zip lama.<verse eid="PSA 121:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 121:5" />RAMPAUBE au ncu kegumbe;</para>
  <para style="q" vid="PSA 121:5">RAMPAUBE au ncu gumbeu kera n taiga bam.<verse eid="PSA 121:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 121:6" />Ting baa kecudau tingnaimiak ne ncu tei rezam dilak,</para>
  <para style="q" vid="PSA 121:6">mede tingmui hekei nede.<verse eid="PSA 121:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 121:7" />RAMPAUBE ne tei rezam kera leune gade ncu gum beu zie,</para>
  <para style="q" vid="PSA 121:7">nah pa ne n teilung gum beu zie.<verse eid="PSA 121:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 121:8" />RAMPAUBE ne nang ketei leune gade</para>
  <para style="q" vid="PSA 121:8">cu nah kelungta ncu gum beuzie.<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="s">Anui RAMPAUBE kiga mie cugo</para>
  <para style="d">David gu, kengha kekie lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 122:1" />Penui acu, “RAMPAUBE kiga<note caller="+" style="f"><char style="fr" closed="false">122:1 </char><char style="ft" closed="false">Jerusalem ki ga</char></note> tet go lie,” de eh rang kegaidau Ih a suiyi di.<verse eid="PSA 122:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 122:2" />Jerusalem, anui pidung au ngu kiriedung lungga sap bam dida!<verse eid="PSA 122:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 122:3" />Jerusalem, sünne eh riam kelu namdi ge nzwa tei lulo!<verse eid="PSA 122:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 122:4" />Heleuhdung Jerusalem ga tet nghang, RAMPAUBE gu heleuhdung,</para>
  <para style="q" vid="PSA 122:4">Israel ziemne zierang ge nzwa,</para>
  <para style="q" vid="PSA 122:4">RAMPAUBE zi de hetwa peu kerane.<verse eid="PSA 122:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 122:5" />Cika tutiak gu hegwangbamdung teipwa bam,</para>
  <para style="q" vid="PSA 122:5">David ki gu hegwangbamdung.<verse eid="PSA 122:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 122:6" />Jerusalem kezuyi ziemne kekie tei lu!</para>
  <para style="q" vid="PSA 122:6">“Namdi aide de hung kelamedung da kezuyi bamlu.<verse eid="PSA 122:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 122:7" />Oh Jerusalem, ncu gumkebam kiriedung lungki ga peu lungciep bamlo,</para>
  <para style="q" vid="PSA 122:7">nah n kedikidung ga peu kwabam lulo.”<verse eid="PSA 122:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 122:8" />A kibaume nah a zangmedung ziemne Ih rangzie, “Peu nnui kakga kezuyi bamlo.”<verse eid="PSA 122:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 122:9" />RAMPAUBE anui Tinggwang zi gade,</para>
  <para style="q" vid="PSA 122:9">Ih ncu peu lungh yilu kerane kiela.<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="s">Anui miakdung RAMPAUBE anui Tinggwang de piela</para>
  <para style="d">Kengha kekie lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 123:1" />Ih n dage ngangcuh piegai,</para>
  <para style="q" vid="PSA 123:1">nang au tinggimdung ga hegwang tei kebambe.<verse eid="PSA 123:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 123:2" />Pielo, kilamedung miakdung penui mpaube ba pie kebam nzwa,</para>
  <para style="q" vid="PSA 123:2">kilapui ge miakdung pe mpaubepui ba de kepie nzwa,</para>
  <para style="q" vid="PSA 123:2">cine pa anuide ngaunggia kemak tane</para>
  <para style="q" vid="PSA 123:2">anui miakdung RAMPAUBE anui Tinggwang de pie bam.<verse eid="PSA 123:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 123:3" />Anuide ngaunggia gailo, RAMPAUBO, anuide ngaunggia gailo,</para>
  <para style="q" vid="PSA 123:3">kedanemene anui au mi hengam le pui bam dida.<verse eid="PSA 123:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 123:4" />Anui de au pezai kesiame ne</para>
  <para style="q" vid="PSA 123:4">masi pei meda</para>
  <para style="q" vid="PSA 123:4">nah ngang kelame ne henui teisüt dida.<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="s">Anuide kengha au RAMPAUBE zi ga bam</para>
  <para style="d">David gu; kengha kekie lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 124:1" />“Magade RAMPAUBE anui lam sap melie cai,”</para>
  <para style="q" vid="PSA 124:1">peu Israel de cu rang lo,<verse eid="PSA 124:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 124:2" />“Magade anui ngauraume anuide renia cuh kecudau</para>
  <para style="q" vid="PSA 124:2">RAMPAUBE anui lam kesapbe bam melie cai,<verse eid="PSA 124:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 124:3" />penui anuide rata gade reniacuh kecudau</para>
  <para style="q" vid="PSA 124:3">penui anuide nring mnwa luzie dege.<verse eid="PSA 124:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 124:4" />Dui ne anuide pung tet di zie dege;</para>
  <para style="q" vid="PSA 124:4">duidiet ne anuide gumpung dizie dege.<verse eid="PSA 124:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 124:5" />Pecai duicui kengkieng ne anuide hegak dizie dege.”<verse eid="PSA 124:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 124:6" />RAMPAUBE de peu samlam pung kelube teilo,</para>
  <para style="q" vid="PSA 124:6">peu ngauraume de anuide ngkapdi meda.<verse eid="PSA 124:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 124:7" />Anui au nruine ge teihgwame taq gade mbai kelu nzwa da;</para>
  <para style="q" vid="PSA 124:7">hetak sia dida, nah anui pak luda.<verse eid="PSA 124:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 124:8" />Anui gu kengha au RAMPAUBE da bam,</para>
  <para style="q" vid="PSA 124:8">tinggim nah kideu tei kegaibe da.<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="s">RAMPAUBE pe minadung de gumbam</para>
  <para style="d">Kengha kekie lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 125:1" />RAMPAUBE da kenlum kebammedung</para>
  <para style="q" vid="PSA 125:1">au Zion deutuh nzwa da, mlai dilak, kelungta bammui zie.<verse eid="PSA 125:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 125:2" />Lamlwadung ne Jerusalem de twagwa kebam nzwa,</para>
  <para style="q" vid="PSA 125:2">RAMPAUBE ne pe minadung de</para>
  <para style="q" vid="PSA 125:2">cu nah kelung ta twagwa bam zie.<verse eid="PSA 125:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 125:3" />Kenlienme gu tuitie dene peu makesangme deu teu kerabe ma.</para>
  <para style="q" vid="PSA 125:3">Mecai makesangme kesia teidi lubui.<verse eid="PSA 125:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 125:4" />Keyi teilu, RAMPAUBO, keyimedung dage</para>
  <para style="q" vid="PSA 125:4">nah penui lung mzui kelamedung dage.<verse eid="PSA 125:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 125:5" />Dede nang kenlienme dage ketei dau,</para>
  <para style="q" vid="PSA 125:5">RAMPAUBE lampuidung gi kedime de ngngwa tet dizie.</para>
  <para style="q" vid="PSA 125:5">Peu Israelme da lungciepbe bamlu.<note caller="-" style="x"><char style="xo" closed="false">125:5 </char><char style="xt" closed="false"><ref loc="PRO 2:15">Mac. 2:15</ref></char></note><verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="s">Anui gudung pwa anuide peu dailo, O RAMPAUBO</para>
  <para style="d">Kengha kekie lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 126:1" />RAMPAUBE ne zion de tei mahei dai kebeudau,</para>
  <para style="q" vid="PSA 126:1">anui au hemang mmi kebammedung nzwa da.<verse eid="PSA 126:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 126:2" />Pecai anui muidung au kenui le puidi</para>
  <para style="q" vid="PSA 126:2">nah anui mleudung dung lei keteidung le.</para>
  <para style="q" vid="PSA 126:2">Pecai heleuhdung ranggai,</para>
  <para style="q" vid="PSA 126:2">“RAMPAUBE ne penui ziemne ma kedidung teibeu.”<verse eid="PSA 126:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 126:3" />RAMPAUBE ne anui ziemne ma kedidung teigai;</para>
  <para style="q" vid="PSA 126:3">anui au daikenzwa gede misuiyi no!<verse eid="PSA 126:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 126:4" />Anuide teimcang dai beulo, RAMPAUBO,</para>
  <para style="q" vid="PSA 126:4">Negev ga reuceuna dungde nzwa.<verse eid="PSA 126:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 126:5" />Heleuh kegidau hap kecumedung penui suiyi sah eh luhlüt zie.<verse eid="PSA 126:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 126:6" />Hap eh heleuh punglwe tet kepetme,</para>
  <para style="q" vid="PSA 126:6">penui sui keyi lei tei cailigwang zie, penui luhlüt pung lwe.<note caller="-" style="x"><char style="xo" closed="false">126:6 </char><char style="xt" closed="false"><ref loc="LUK 6:21">Luk. 6:21</ref></char></note><verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="s">RAMPAUBE ne kibe teima liecai</para>
  <para style="d">Solomon gu kengha kekie lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 127:1" />RAMPAUBE ne kibe teigai kemaktane,</para>
  <para style="q" vid="PSA 127:1">penui kemta gage makam teigai la, cide tei kegaimedung.</para>
  <para style="q" vid="PSA 127:1">RAMPAUBE ne namdibe kwa kemaktane,</para>
  <para style="q" vid="PSA 127:1">kepieme sap eh kemta gage kwa bam.<verse eid="PSA 127:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 127:2" />N ziemne cuhzi bamde kemta,</para>
  <para style="q" vid="PSA 127:2">kilung gwang ri bamde,</para>
  <para style="q" vid="PSA 127:2">mede nri eh heta tei kegai taktyei tyeibam de,</para>
  <para style="q" vid="PSA 127:2">kedanemene RAMPAUBE pa hung kelamedung ziemne penui zip kebam daude pwapeu la.<verse eid="PSA 127:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 127:3" />Pielo, henamedung au RAMPAUBE dade kegwang mapeu ge,</para>
  <para style="q" vid="PSA 127:3">nah mna beu kela za gu petsi de au pe dade kegwang ziehi ge.<verse eid="PSA 127:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 127:4" />Mige heriheret dau pe namedung lungh kelu au,</para>
  <para style="q" vid="PSA 127:4">regwame ge ba ga lakpitsidung kebam nzwa da.<verse eid="PSA 127:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 127:5" />Mige pe lakpitsidung kepui tei kebambe au dai kenzwa gede samlam pung no.</para>
  <para style="q" vid="PSA 127:5">Pa pe ngauraumedung de namdi kirie gade renia kecudau</para>
  <para style="q" vid="PSA 127:5">pecu peu hengam tei dilak.<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="s">RAMPAUBE mie hing kelame samlam punglie</para>
  <para style="d">Kengha kekie lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 128:1" />RAMPAUBE de herüt peu kelame leune au samlam kepung melie,</para>
  <para style="q" vid="PSA 128:1">pe lampuidung ga tet kelame.<verse eid="PSA 128:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 128:2" />Nang nta tei kegai ne, ncu suiyi peu zie;</para>
  <para style="q" vid="PSA 128:2">nang dai kenzwa ge misuiyi nah samlam no.<verse eid="PSA 128:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 128:3" />Nnau au n kilung ga</para>
  <para style="q" vid="PSA 128:3">kubebang petsi bui süt beu kelabe nzwa zie;</para>
  <para style="q" vid="PSA 128:3">n namedung au olive bangdung nzwa zie</para>
  <para style="q" vid="PSA 128:3">n tatyei bam taiga.<verse eid="PSA 128:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 128:4" />Yeo, kesang, RAMPAUBE de herüt kepeume</para>
  <para style="q" vid="PSA 128:4">ge de au samlam beu zie.<verse eid="PSA 128:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 128:5" />Peu RAMPAUBE de ncu Zion gade samlam beu lo;</para>
  <para style="q" vid="PSA 128:5">peu n teilung pekiene Jerusalem ga kwak kebam ngau lo.<verse eid="PSA 128:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 128:6" />Peu ncu lungh eh n tsamedung de ngau lo.</para>
  <para style="q" vid="PSA 128:6">Peu Israel da kezuyi bam lo.<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="s">Penui A hename gade acu teikeherei gwang</para>
  <para style="d">Kengha kekie lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 129:1" />“Ih heriheret kebam dau gade a ngauraume acu renia bam muila,”</para>
  <para style="q" vid="PSA 129:1">peu Israel de ranglo.<verse eid="PSA 129:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 129:2" />“Ih heriheret kebam dau gade penui acu kaa bam mui la,</para>
  <para style="q" vid="PSA 129:2">dede penui acu ngam lumah.<verse eid="PSA 129:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 129:3" />Penui akia gage tei rejam ncuk süt gai;</para>
  <para style="q" vid="PSA 129:3">nah cide luh puhkedi ge nzwa dida.<verse eid="PSA 129:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 129:4" />RAMPAUBE au samsang;</para>
  <para style="q" vid="PSA 129:4">pane kesiame gu heriadung dangdi.”<verse eid="PSA 129:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 129:5" />Peu penui pelane de ngamdi lu nah nreu caili lu,</para>
  <para style="q" vid="PSA 129:5">Zion de ngkau kelamedung de.<verse eid="PSA 129:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 129:6" />Peu penuide kireudung ga cehei lungh cuh kemakne</para>
  <para style="q" vid="PSA 129:6">regui di kela nzwa dilu,<verse eid="PSA 129:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 129:7" />cide luhlüt kecume ba ga keu hekwa gailak</para>
  <para style="q" vid="PSA 129:7">mede herei kang ncüt kecume hekakrak ga keu hekwa gailak.<verse eid="PSA 129:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 129:8" />Peu tetkah gwang kecumedung de rang so,</para>
  <para style="q" vid="PSA 129:8">“Peu RAMPAUBE samlam nda bam lo;</para>
  <para style="q" vid="PSA 129:8">anui ncu RAMPAUBE zi gade samlam gai la.”<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="s">A rabe RAMPAUBE de kwabam</para>
  <para style="d">Kengha kekie lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 130:1" />Ih keherei kwaki gade ncu qugai, Oh RAMPAUBO.<verse eid="PSA 130:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 130:2" />Rampaube, a kwa kingnei gailo;</para>
  <para style="q" vid="PSA 130:2">ngaugia ziemne a nggia mra kebamde</para>
  <para style="q" vid="PSA 130:2">kingnei teune gailo.<verse eid="PSA 130:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 130:3" />Magade nang, RAMPAUBE, kemaudung giak nzeu cai,</para>
  <para style="q" vid="PSA 130:3">Rampaube, cau ne sap lulai?<verse eid="PSA 130:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 130:4" />Dede nda kemaugi kecu bam,</para>
  <para style="q" vid="PSA 130:4">cide ncu herüt peu la.<verse eid="PSA 130:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 130:5" />Ih RAMPAUBE de kwabam, a rabe kwabam,</para>
  <para style="q" vid="PSA 130:5">nah Ih pesam ga regui bam.<verse eid="PSA 130:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 130:6" />Kekwamedung tingcang de kekwa swade</para>
  <para style="q" vid="PSA 130:6">a rabe RAMPAUBE de kwa ki bam.<verse eid="PSA 130:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 130:7" />Israel, RAMPAUBE da regui bam lo.</para>
  <para style="q" vid="PSA 130:7">RAMPAUBE au ngaugia le pui,</para>
  <para style="q" vid="PSA 130:7">nah pa au kelibeu neu sütla.<verse eid="PSA 130:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 130:8" />RAMPAUBE au kemaudung pelane gade</para>
  <para style="q" vid="PSA 130:8">Israel de kelikebeube.<note caller="-" style="x"><char style="xo" closed="false">130:8 </char><char style="xt" closed="false"><ref loc="PSA 131:3">Lei. 131:3</ref></char></note><verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="s">Ih a rabe de mlai ma mede matiemene bamlu</para>
  <para style="d">David gu; kengha kekie lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 131:1" />RAMPAUBE, a nlung au ngang ma mede a miakdung au ngangdang ma.</para>
  <para style="q" vid="PSA 131:1">Ih akatei a ziemne kereguidung kedi gah</para>
  <para style="q" vid="PSA 131:1">mede makie a ziemne pa ham kedibedung de.<verse eid="PSA 131:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 131:2" />Kesang Ih zing dedi nah a rabe de zing dedi;</para>
  <para style="q" vid="PSA 131:2">tungkebam hena nage pepui taiga kebam nzwa,</para>
  <para style="q" vid="PSA 131:2">a da kebam a rabe au tungkebam hena nage nzwa.<verse eid="PSA 131:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 131:3" />Oh Israel, RAMPAUBE da n keregui</para>
  <para style="q" vid="PSA 131:3">cu nah kelungta bamlo.<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="s">RAMPAUBE Zion kedet luda</para>
  <para style="d">Kengha kekie lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 132:1" />RAMPAUBE, David zi gade</para>
  <para style="q" vid="PSA 132:1">keherei kecu pelane nsunggai.<verse eid="PSA 132:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 132:2" />Pa RAMPAUBE de sampet kegai de nsunggai,</para>
  <para style="q" vid="PSA 132:2">pa dainzwa Jacob gu kengkieng Tinggwang dage sampetgai bi.<verse eid="PSA 132:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 132:3" />Pa rang, “Ih a ki ga lütlak</para>
  <para style="q" vid="PSA 132:3">mede zeu ga gwanglak,<verse eid="PSA 132:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 132:4" />Ih a miakdung de kezip halak</para>
  <para style="q" vid="PSA 132:4">mede a miakkum de kemtak halak<verse eid="PSA 132:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 132:5" />Ih RAMPAUBE ziemne heni ge peeilu kemaktane,</para>
  <para style="q" vid="PSA 132:5">Jacob kengkieng Tinggwang ziemne paiki ge peulu kemaktane.”<note caller="-" style="x"><char style="xo" closed="false">132:5 </char><char style="xt" closed="false"><ref loc="ACT 7:46">Bat. 7:46</ref></char></note><verse eid="PSA 132:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 132:6" />Pielo, anui Ephrathah<note caller="+" style="f"><char style="fr" closed="false">132:6 </char><char style="fq" closed="false">Ephrathah </char><char style="ft" closed="false">Aide Jerusalem namdi ndaa pe zi kehegwabe lie lala. Rut. 1:1-2, Mic. 5:2.</char></note> gade cipau hade siuda;</para>
  <para style="q" vid="PSA 132:6">anui cide Jaar<note caller="+" style="f"><char style="fr" closed="false">132:6 </char><char style="fq" closed="false">Jaar </char><char style="ft" closed="false">Aide Jerusalem namdi gade naimiak kenlütlebe pet eh kilometer kereiemdai cai kebam Kiriath Jearim namde da.</char></note> luhdung gade ngau luda.<verse eid="PSA 132:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 132:7" />Anui Tinggwang kiga miego;</para>
  <para style="q" vid="PSA 132:7">anui pe pi kai kecu bam gade reca zie.<verse eid="PSA 132:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 132:8" />Cuh lu, RAMPAUBE, ngu kemtak bam ga,</para>
  <para style="q" vid="PSA 132:8">nang nah samkakbung n kengkieng de!<verse eid="PSA 132:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 132:9" />Peu ngu cingkume de kesamsang paini teulu;</para>
  <para style="q" vid="PSA 132:9">peu ngu kesamsang mede suiyi sah lo.<verse eid="PSA 132:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 132:10" />Nkilabe David zi gade,</para>
  <para style="q" vid="PSA 132:10">n keniakkelu hegwangpei dade nreutet diso.<verse eid="PSA 132:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 132:11" />RAMPAUBE David dage sampet teibi kera pe sam pet gaibeu,</para>
  <para style="q" vid="PSA 132:11">cipau sampet de pa teibi mene talak:</para>
  <para style="q" vid="PSA 132:11">“Ih n name hang ge de peu n hegwang bam ga kaibeu zie.<note caller="+" style="f"><char style="fr" closed="false">132:11 </char><char style="ft" closed="false">2 Sam. 7:12, Bat. 2:30</char></note><verse eid="PSA 132:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 132:12" />Magade n namedung agu samkak</para>
  <para style="q" vid="PSA 132:12">nah Ih hezaidung penuide ledeu kebeu de kai nzeulu cai,</para>
  <para style="q" vid="PSA 132:12">penui name dung de ngu hegwang bam ga kelunghta bam di zie.”<verse eid="PSA 132:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 132:13" />RAMPAUBE Zion de kedet luda,</para>
  <para style="q" vid="PSA 132:13">pa pebam ziemne pecu luuneu di.<verse eid="PSA 132:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 132:14" />Nang ranggai “Aide kelungta ziemne agu kemtak bam.</para>
  <para style="q" vid="PSA 132:14">Ih aika lungh zie, kedanemene Ih pecu lu keneu ne.<verse eid="PSA 132:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 132:15" />Ih pecu kekiee ge teu makesia leune samlambeu zie.</para>
  <para style="q" vid="PSA 132:15">Pa maga kebam de taktyei le tei mnung beu zie.<verse eid="PSA 132:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 132:16" />Ih kelikelu le pe cingkumedung de cum beu zie,</para>
  <para style="q" vid="PSA 132:16">pecu kenlummedung suiyi ziemne sa zie.<verse eid="PSA 132:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 132:17" />Cika Ih David de pekii pwak cuh kecu tei zie</para>
  <para style="q" vid="PSA 132:17">nah keniak kelube a hegwangpei ziemne kebaabung kaibeu zie.<note caller="-" style="x"><char style="xo" closed="false">132:17 </char><char style="xt" closed="false"><ref loc="LUK 1:69">Luk. 1:69</ref></char></note><verse eid="PSA 132:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 132:18" />Ih pe ngauraumedung de hengam le cum luzie,</para>
  <para style="q" vid="PSA 132:18">dede pe dade hegwang peurwa baa zie.”<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="s">Sinamedung ket tei eh lungh kebam</para>
  <para style="d">David gu kengha kekie lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 133:1" />Ainie, daikenzwa gede yi nah daikenzwa gede ramciem no</para>
  <para style="q" vid="PSA 133:1">sinamedung ngngwa ncüt eh lunghbam kecu!<verse eid="PSA 133:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 133:2" />Cide au maca püt kelu pemi kehung pe peu gade</para>
  <para style="q" vid="PSA 133:2">tangkeimai gage lwa nghung kecu nzwada,</para>
  <para style="q" vid="PSA 133:2">Aaron tangkeimai,</para>
  <para style="q" vid="PSA 133:2">nah cipaucai de cide pe mcwa ngwang riadung ga lwa kemie.<verse eid="PSA 133:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 133:3" />Cide au Hermon deutu gade hezindung</para>
  <para style="q" vid="PSA 133:3">Zion deutudung ga keeimie kecu nzwada.</para>
  <para style="q" vid="PSA 133:3">Kedanemene cikade RAMPAUBE kelungta pe samlam sampet gaibeu,</para>
  <para style="q" vid="PSA 133:3">kering penli kegah de.<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="s">Gwanglu, RAMPAUBE de twalo</para>
  <para style="d">Kengha kekie lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 134:1" />Gwang lu, RAMPAUBE de samlam beu, nnui pelane RAMPAUBE kilamedung,</para>
  <para style="q" vid="PSA 134:1">nnui RAMPAUBE kiga tingmuidau pe gwatei kela leune.<note caller="-" style="x"><char style="xo" closed="false">134:1 </char><char style="xt" closed="false"><ref loc="REV 19:5">Keu. 19:5</ref></char></note><verse eid="PSA 134:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 134:2" />Nnui ba hwa gailu kemci bam gage</para>
  <para style="q" vid="PSA 134:2">nah RAMPAUBE de samlam beu.<verse eid="PSA 134:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 134:3" />RAMPAUBE Tinggim nah kedeu tei kegaibe de,</para>
  <para style="q" vid="PSA 134:3">peu Zion gade nnuide samlam beulo.<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="s">N zi, O RAMPAUBO, bam muila</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 135:1" />RAMPAUBE de twalu.</para>
  <para style="q" vid="PSA 135:1">RAMPAUBE zi de twalu.</para>
  <para style="q" vid="PSA 135:1">Pecu twalu, nnui RAMPAUBE kilamedung,<note caller="-" style="x"><char style="xo" closed="false">135:1 </char><char style="xt" closed="false"><ref loc="PSA 113:1">Lei. 113:1</ref></char></note><verse eid="PSA 135:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 135:2" />nang RAMPAUBE ki ga kesapme,</para>
  <para style="q" vid="PSA 135:2">anui Tinggwang ki kisie ga.<verse eid="PSA 135:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 135:3" />RAMPAUBE de twalu, kedanemene pa au yilu;</para>
  <para style="q" vid="PSA 135:3">lei tei pezi twalu, kedanemene cide ketei au yilu.<verse eid="PSA 135:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 135:4" />Kedanemene RAMPAUBE peziemne Jacob de kedetlu,</para>
  <para style="q" vid="PSA 135:4">Israel de pegu teilu.<verse eid="PSA 135:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 135:5" />Ih ci RAMPAUBE au di kecu,</para>
  <para style="q" vid="PSA 135:5">anui Tinggwang au hera kedadung pelane reu.<verse eid="PSA 135:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 135:6" />RAMPAUBE ma keheibe tei keneube,</para>
  <para style="q" vid="PSA 135:6">tinggim gade, kideu gade, jaaidi gade nah pe kang kecokdung pelane gade pa teila.<verse eid="PSA 135:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 135:7" />Pa hemwadung kemdei gade teugwang la,</para>
  <para style="q" vid="PSA 135:7">ting kehepikdung de tingrui de nzang kecu tei</para>
  <para style="q" vid="PSA 135:7">nah pa pegu mania kibung gade tingkai keumpet gaila.<verse eid="PSA 135:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 135:8" />Pa Egypt gu neraibe de teitset di,</para>
  <para style="q" vid="PSA 135:8">mipei nah makaunedung kenana de.<verse eid="PSA 135:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 135:9" />Pa ma rengei nah mimakecang nnui kakga langgai, Egypt,</para>
  <para style="q" vid="PSA 135:9">Pharaoh nah pe kilamedung pelane dage.<verse eid="PSA 135:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 135:10" />Pa heleuhdung kekiee gede ngkapdi</para>
  <para style="q" vid="PSA 135:10">nah hegwang kengkingme de teitsetdi,<verse eid="PSA 135:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 135:11" />Sihon Amoritme gwangpei</para>
  <para style="q" vid="PSA 135:11">nah Og Bashanme gwangpei</para>
  <para style="q" vid="PSA 135:11">nah Canaan ga hegwangramdung pelane.<verse eid="PSA 135:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 135:12" />Pa anuide penui deu gum kera pwapeu,</para>
  <para style="q" vid="PSA 135:12">pe mina Israelme de peu gumlu kera peudi.<verse eid="PSA 135:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 135:13" />N zi, Oh RAMPAUBO, kelungta ncu nsung lazie;</para>
  <para style="q" vid="PSA 135:13">n kendu, Oh RAMPAUBO, ceheudung pelane ncu nsungla dizie.<verse eid="PSA 135:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 135:14" />Kedanemene RAMPAUBE pe mina de gumla</para>
  <para style="q" vid="PSA 135:14">nah pe kilamedung de ngau nggia la.<note caller="-" style="x"><char style="xo" closed="false">135:14 </char><char style="xt" closed="false"><ref loc="DEU 32:36">Hez. 32:36</ref> </char></note><verse eid="PSA 135:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 135:15" />Heleuhdung mamiedung au rangkanggeu nah kecak,</para>
  <para style="q" vid="PSA 135:15">cide mina badung bata.<verse eid="PSA 135:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 135:16" />Cipau mamiedung au penui muidung bam, dede penui marang gailak;</para>
  <para style="q" vid="PSA 135:16">penui miakdung bam, dede ngau gailak;<verse eid="PSA 135:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 135:17" />penui kwendung bam, dede penui siu gailak,</para>
  <para style="q" vid="PSA 135:17">mede ngicui de penui muidung ga gah.<note caller="-" style="x"><char style="xo" closed="false">135:17 </char><char style="xt" closed="false"><ref loc="REV 9:20">Keu. 9:20</ref></char></note><verse eid="PSA 135:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 135:18" />Penuide teikegaime nah mi keheibe de</para>
  <para style="q" vid="PSA 135:18">penuide nlum kelamedung au penui nzwa.<verse eid="PSA 135:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 135:19" />Oh Israel leuhmedung, RAMPAUBE de samlam beu;</para>
  <para style="q" vid="PSA 135:19">Oh Aaron leuhmedung, RAMPAUBE de samlam beu.<verse eid="PSA 135:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 135:20" />Oh Levi leuhmedung, RAMPAUBE de twalu;</para>
  <para style="q" vid="PSA 135:20">nnui RAMPAUBE de herüt peu kelame, RAMPAUBE de twalu.<verse eid="PSA 135:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 135:21" />Zion gade RAMPAUBE de samlam beu,</para>
  <para style="q" vid="PSA 135:21">Jerusalem ga kelunghme.</para>
  <para style="q" vid="PSA 135:21">RAMPAUBE de twalu.<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="s">Pe keku au bam muila</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 136:1" />Oh, RAMPAUBE de hetwa peulo; kedanemene pa au yilu,</para>
  <para style="q" vid="PSA 136:1">pa samkakkelu samsang de au kelungta bam muila.<verse eid="PSA 136:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 136:2" />Oh, tinggwangdung gu Tinggwang de hetwa peu lo,</para>
  <para style="q" vid="PSA 136:2">kedanemene pa samkakkelu samsang de au kelungta bam muila.<verse eid="PSA 136:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 136:3" />Oh, Rampaudung reu Rampau de hetwa peulo, kedanemene pa samkakkelu samsang de au kelungta bam muila.<verse eid="PSA 136:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 136:4" />Pecu hetwa peulo pa rünne mimakecang kedi teikegai be,</para>
  <para style="q" vid="PSA 136:4">kedanemene pa samkakkelu samsang de au kelungta bammui la,<verse eid="PSA 136:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 136:5" />pe maci le pa tinggimdung teilu,</para>
  <para style="q" vid="PSA 136:5">kedanemene pa samkakkelu samsang de au kelungta bam muila.<verse eid="PSA 136:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 136:6" />Pecu hetwa peulo pa duidung reu gage kideu tei zang mpet kegai be,</para>
  <para style="q" vid="PSA 136:6">kedanemene pa samkakkelu samsang de au kelungta bammui la,<verse eid="PSA 136:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 136:7" />peda de kebaa kedidung<note caller="+" style="f"><char style="fr" closed="false">136:7 </char><char style="fq" closed="false">Kebaa kedidung </char><char style="ft" closed="false">Tingnaimiak nah hekei de rangbam.</char></note> teigai,</para>
  <para style="q" vid="PSA 136:7">kedanemene pa samkakkelu samsang de au kelungta bammui la.<verse eid="PSA 136:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 136:8" />Pecu hetwa peulo tingnaimiak de tingba reu di kera ha kebeube de,</para>
  <para style="q" vid="PSA 136:8">kedanemene pa samkakkelu samsang de au kelungta bammui la,<verse eid="PSA 136:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 136:9" />hekei nah hegidung de tingmui reu di kera,</para>
  <para style="q" vid="PSA 136:9">kedanemene pa samkakkelu samsang de au kelungta bammui la.<verse eid="PSA 136:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 136:10" />Pecu hetwa peu lo Egyptme neraibe de teitset kegaibe de,</para>
  <para style="q" vid="PSA 136:10">kedanemene pa samkakkelu samsang de au kelungta bammui la, <note caller="+" style="f"><char style="fr" closed="false">136:10 </char><char style="ft" closed="false">Tet. 12:29, Lei. 78:52;135:8.</char></note><verse eid="PSA 136:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 136:11" />nah pa Israelme de penui kakgade ngngwampet lu,</para>
  <para style="q" vid="PSA 136:11">kedanemene pa samkakkelu samsang de au kelungta bam muila,<verse eid="PSA 136:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 136:12" />peba kengkieng le nah peba hwa eh,</para>
  <para style="q" vid="PSA 136:12">kedanemene pa samkakkelu samsang de au kelungta bammui la.<verse eid="PSA 136:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 136:13" />Pecu hetwa peu lo Jaadi Kegie mzi kegaibe de,</para>
  <para style="q" vid="PSA 136:13">kedanemene pa samkakkelu samsang de au kelungta bammui la,<verse eid="PSA 136:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 136:14" />nah peu Israelme de peu sum gade kahlu,</para>
  <para style="q" vid="PSA 136:14">kedanemene pa samkakkelu samsang de au kelungta bammui la,<verse eid="PSA 136:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 136:15" />dede Pharaoh nah pe reugwame de Jaaidi Kegie gage kelien gaidi,</para>
  <para style="q" vid="PSA 136:15">kedanemene pa samkakkelu samsang de au kelungta bammui la.<verse eid="PSA 136:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 136:16" />Pecu hetwa peulo hetaideu gade pe mina de nzang mpet kebeube de,</para>
  <para style="q" vid="PSA 136:16">kedanemene pa samkakkelu samsang de au kelungta bammui la,<verse eid="PSA 136:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 136:17" />pa hegwangpei kedidung de tei ketset be,</para>
  <para style="q" vid="PSA 136:17">kedanemene pa samkakkelu samsang de au kelungta bammui la.<verse eid="PSA 136:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 136:18" />Pecu hetwa peu lo pa hegwangpei dung kenlangme de tei ketset be,</para>
  <para style="q" vid="PSA 136:18">kedanemene pa samkakkelu samsang de au kelungta bammui la,<verse eid="PSA 136:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 136:19" />Sihon Amoritme gu hegwangpei,</para>
  <para style="q" vid="PSA 136:19">kedanemene pa samkakkelu samsang de au kelungta bammui la,<verse eid="PSA 136:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 136:20" />nah Og Bashanme gu hegwangpei,</para>
  <para style="q" vid="PSA 136:20">kedanemene pa samkakkelu samsang de au kelungta bammui la.<verse eid="PSA 136:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 136:21" />Pecu hetwa peu lo penui deu gumlu kera ha kebeube de,</para>
  <para style="q" vid="PSA 136:21">kedanemene pa samkakkelu samsang de au kelungta bammui la,<verse eid="PSA 136:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 136:22" />Israelme pe kilabe de peu gumlu kera,</para>
  <para style="q" vid="PSA 136:22">kedanemene pa samkakkelu samsang de au kelungta bammui la,<verse eid="PSA 136:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 136:23" />anuide nsung kegaibe nah anui gu hengam gade anuide ngha kebeube de,</para>
  <para style="q" vid="PSA 136:23">kedanemene pa samkakkelu samsang de au kelungta bammui la.<verse eid="PSA 136:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 136:24" />Pecu hetwa peu lo anui ngauraume reu ngamlu kera ha kebeube de,</para>
  <para style="q" vid="PSA 136:24">kedanemene pa samkakkelu samsang de au kelungta bammui la,<verse eid="PSA 136:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 136:25" />pa ring kela kaudung pelane de taktyei peula,</para>
  <para style="q" vid="PSA 136:25">kedanemene pa samkakkelu samsang de au kelungta bammui la.<verse eid="PSA 136:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 136:26" />Oh, tinggim kebam Tinggwang de hetwa peu lo,</para>
  <para style="q" vid="PSA 136:26">kedanemene pa samkakkelu samsang de au kelungta bammui la.<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="s">Dainzwa anui RAMPAUBE lei tei lulai?</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 137:1" />Babylon reukidung ga</para>
  <para style="q" vid="PSA 137:1">anui bamlu nah hap</para>
  <para style="q" vid="PSA 137:1">anui Zion de nsung kegai dau.<verse eid="PSA 137:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 137:2" />Cika poplar bangdung ga</para>
  <para style="q" vid="PSA 137:2">anui gu leibungdung gwaklu.<verse eid="PSA 137:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 137:3" />Cika anuide tui kelumedung anuide lei teigai lo di,</para>
  <para style="q" vid="PSA 137:3">nah cau anuide henui tei bi anui suiyi lu lo di, ainzwa rang eh,</para>
  <para style="q" vid="PSA 137:3">“Anui de Zion leidung ge tei gai lo.”<verse eid="PSA 137:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 137:4" />Anui dainzwa RAMPAUBE lei teigai lu lai</para>
  <para style="q" vid="PSA 137:4">sangme deu gade?<verse eid="PSA 137:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 137:5" />Ih ncu nsung ta di cai, O Jerusalem,</para>
  <para style="q" vid="PSA 137:5">a ba zetle peu lei ketei de nsung tadi lulo.<verse eid="PSA 137:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 137:6" />Peu ge a mui nreu gage a mleu kau dilu</para>
  <para style="q" vid="PSA 137:6">Ih magade ncu mning tadicai,</para>
  <para style="q" vid="PSA 137:6">Ih magade Jerusalem de kedetlu tadicai a suiyi disüt cu swade.<verse eid="PSA 137:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 137:7" />Nsung lulo, Oh RAMPAUBO, Edomme ne teikegai de</para>
  <para style="q" vid="PSA 137:7">Jerusalem kaukedi benai.</para>
  <para style="q" vid="PSA 137:7">Penui rang, “Hiet ngkaudi, hiet nkau di</para>
  <para style="q" vid="PSA 137:7">pe bangdwa ga kecang.”<verse eid="PSA 137:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 137:8" />Babylon gu minadung, matie mene ngkap dizie da,</para>
  <para style="q" vid="PSA 137:8">peu cipaume de samlam pung kelube teilu, caune ncu peu caili bi</para>
  <para style="q" vid="PSA 137:8">nang anui dage tei kegaidung ziemne,<note caller="-" style="x"><char style="xo" closed="false">137:8 </char><char style="xt" closed="false"><ref loc="REV 18:6">Keu. 18:6</ref></char></note><verse eid="PSA 137:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 137:9" />Peu cipaume de samlampung kelube teilu, caune n namedung de</para>
  <para style="q" vid="PSA 137:9">tangtsu gage pwa lak bi.<note caller="-" style="x"><char style="xo" closed="false">137:9 </char><char style="xt" closed="false"><ref loc="ISA 13:16">Isa. 13:16</ref></char></note><verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="s">RAMPAUBE de ketwa peulo</para>
  <para style="d">David Leidung.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 138:1" />Ih a lung pelane teu ncu twazie;</para>
  <para style="q" vid="PSA 138:1">Ih rabedung dwa gade ncu ketwalei tei zie.<verse eid="PSA 138:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 138:2" />Ih n kemci kerecaki dwaga keumie zie</para>
  <para style="q" vid="PSA 138:2">nah n zi de hetwa peu zie n samkakkelu samsang de ziemne nah ncu nlumlu kebui ziemne.</para>
  <para style="q" vid="PSA 138:2">Nang n sam<note caller="+" style="f"><char style="fr" closed="false">138:2 </char><char style="ft" closed="false">samkak kelu</char></note> nah n zi ma keheibe reu kemdu tei kedi ne.<verse eid="PSA 138:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 138:3" />Ih ncu qu kegai benai, nang a sam keli beu;</para>
  <para style="q" vid="PSA 138:3">nang acu tei ngkuu beu nah a rabe tei ngkieng beu.<verse eid="PSA 138:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 138:4" />Kideu ga hegwangmedung pelane ncu hetwa peuzie, RAMPAUBO,</para>
  <para style="q" vid="PSA 138:4">kedanemene penui n mui gade samdung de siuzie.<verse eid="PSA 138:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 138:5" />Kesang lei, heta tei kegaidung ziemne penui lei tei zie RAMPAUBO,</para>
  <para style="q" vid="PSA 138:5">kedanemene RAMPAUBE kemdu au di lu.<verse eid="PSA 138:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 138:6" />RAMPAUBE au hu süt bam, ciuliede pa kehename ma pie la,</para>
  <para style="q" vid="PSA 138:6">dede pa ngang kelame de kemdei gade ci lu la.<verse eid="PSA 138:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 138:7" />Ih kengyi sum ga tetla de, nang a teilung gum beu la;</para>
  <para style="q" vid="PSA 138:7">nang n badung pet cangzie a ngauraume ratadung ga,</para>
  <para style="q" vid="PSA 138:7">nah n ba zetle le acu keli beuzie.<verse eid="PSA 138:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 138:8" />RAMPAUBE au a da la penli ga kecang;</para>
  <para style="q" vid="PSA 138:8">n samkak de samsang, RAMPAUBE, kelungta la mui zie.</para>
  <para style="q" vid="PSA 138:8">Nang n badung le tei kelume ge de pütdi helo.<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="s">Acu kecunglo, O Tinggwang, delwe a mlung cilulo</para>
  <para style="d">Lei kempwakme muiteube ziemne. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 139:1" />RAMPAUBO, nang acu pie teune luda, nah nang acu cila.<note caller="-" style="x"><char style="xo" closed="false">139:1 </char><char style="xt" closed="false"><ref loc="ROM 8:27">Rom. 8:27</ref></char></note><verse eid="PSA 139:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 139:2" />Nang Ih ntum kecudau nah cu kecudau cibam;</para>
  <para style="q" vid="PSA 139:2">nang kemdei gade a lungning pelane cila.<verse eid="PSA 139:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 139:3" />Ih zeu kebam nah a lampui nang ngaubam;</para>
  <para style="q" vid="PSA 139:3">Ih teikela leune nang ci bamla.<verse eid="PSA 139:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 139:4" />Ih samge de rang kemak dwade,</para>
  <para style="q" vid="PSA 139:4">RAMPAUBO, nang cide ci mcigi bam.<verse eid="PSA 139:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 139:5" />Acai nah adwa de nang acu twagwa bam</para>
  <para style="q" vid="PSA 139:5">nah n ba areu gage kailu.<verse eid="PSA 139:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 139:6" />Cikenzwa maci au a ziemne kieezu;</para>
  <para style="q" vid="PSA 139:6">cide au huzu, nah Ih tungcang gailak.<verse eid="PSA 139:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 139:7" />N rabe dade Ih tetpwa daiga mielai?</para>
  <para style="q" vid="PSA 139:7">Nang kebam gade Ih daigage pak gailai?<verse eid="PSA 139:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 139:8" />Ih tinggimdung ga hang ge, nang cika bam;</para>
  <para style="q" vid="PSA 139:8">Ih Sheol bam ga a zeu teilu de, nang cika bam.<verse eid="PSA 139:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 139:9" />Ih tingcang hesiu gade lim tet dide,</para>
  <para style="q" vid="PSA 139:9">nah duikedi mdeitu le ga lung kera gwang dide,<verse eid="PSA 139:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 139:10" />Cikade n ba le a lampui saubeu zie,</para>
  <para style="q" vid="PSA 139:10">n ba zetle le acu gumlu zie.<verse eid="PSA 139:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 139:11" />Ih ainzwa rang liede, “kemui ne acu kebai bi dizie,</para>
  <para style="q" vid="PSA 139:11">nah kebaa acu twagwa kebam de mui dizie,”<verse eid="PSA 139:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 139:12" />kemui de n dade au mui ma.</para>
  <para style="q" vid="PSA 139:12">Tingkemui de tingkeba dau nzwa baa zie,</para>
  <para style="q" vid="PSA 139:12">kedanemene n dade au kemui nah kebaa nzwakap kecune.<verse eid="PSA 139:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 139:13" />Nangne a lungnet pelane damgai;</para>
  <para style="q" vid="PSA 139:13">nang ne a pui za gade acu tamtok ncütlu.<verse eid="PSA 139:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 139:14" />Ih ncu twa zie,</para>
  <para style="q" vid="PSA 139:14">kedanemene Ih au n bata miswakegah ge kecune.</para>
  <para style="q" vid="PSA 139:14">A rabe ma aide ci hemisüt bam.<note caller="-" style="x"><char style="xo" closed="false">139:14 </char><char style="xt" closed="false"><ref loc="REV 15:3">Keu. 15:3</ref></char></note><verse eid="PSA 139:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 139:15" />A radung n dade hebai dima</para>
  <para style="q" vid="PSA 139:15">a pui ja gade tamtok teune lu,</para>
  <para style="q" vid="PSA 139:15">Ih cika kembai gade lungh di cu kecu dau, Ih cika kebam nang ci.<verse eid="PSA 139:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 139:16" />A pui za gade nang acu ngau;</para>
  <para style="q" vid="PSA 139:16">tingbazie acu kepeudung pelane n laisiukwak gage rauteula,</para>
  <para style="q" vid="PSA 139:16">tingbazie raitu de gwang kemak dwa de.<verse eid="PSA 139:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 139:17" />O Tinggwang, n lungcetdung de daikenzwa gede a ziemne pemi hung no!</para>
  <para style="q" vid="PSA 139:17">Penui dai kieede kieeno!<verse eid="PSA 139:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 139:18" />Ih cidungde peei cai, penui au heciang dung swa kiee zie.</para>
  <para style="q" vid="PSA 139:18">Ih mrak luge, Ih ncu ngngwa bam.<verse eid="PSA 139:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 139:19" />O Tinggwang, nang mi kesiame de teitset lubui liecai;</para>
  <para style="q" vid="PSA 139:19">a dade tet mdei dilu, nnui mide teiketset medung.<verse eid="PSA 139:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 139:20" />Penui n dade penui zaisia la nah mide cwala;</para>
  <para style="q" vid="PSA 139:20">n ngauraumedung kenret rangla.<verse eid="PSA 139:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 139:21" />O RAMPAUBO, Ih ncu ngkau kelame de nkau meni?</para>
  <para style="q" vid="PSA 139:21">Ih ncu renia kelame de ngaurau la meni?<note caller="-" style="x"><char style="xo" closed="false">139:21 </char><char style="xt" closed="false"><ref loc="REV 2:6">Keu. 2:6</ref></char></note><verse eid="PSA 139:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 139:22" />Ih penui de ngkau cangsiak lie;</para>
  <para style="q" vid="PSA 139:22">penui a ngauraumedung dida.<verse eid="PSA 139:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 139:23" />Acu mcet teune lu, Oh Tinggwang, nah a nlung cilu;</para>
  <para style="q" vid="PSA 139:23">acu kedakpie lu nah a lungcet cilu.<verse eid="PSA 139:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 139:24" />A da makesia gede bamcai pielu,</para>
  <para style="q" vid="PSA 139:24">nah kelungta bam kela lampui gage acu sau beulo.<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="s">Kemaume dade acu kelibeulo, O RAMPAUBO</para>
  <para style="d">Lei kempwakme muiteube ziemne. David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 140:1" />RAMPAUBO, makesia gade acu kelibeu lo;</para>
  <para style="q" vid="PSA 140:1">mina kesiame dade acu gum beulo.<verse eid="PSA 140:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 140:2" />Penui penui nlungdung ga makesiabe riem la;</para>
  <para style="q" vid="PSA 140:2">penui tingba ramsang hereu dung teu gwang la.<verse eid="PSA 140:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 140:3" />Penui mleudung au heneidung rezam nzwa;</para>
  <para style="q" vid="PSA 140:3">henei gu ncaidung penui mui lim ga bamla.<note caller="+" style="f"><char style="fr" closed="false">140:3 </char><char style="ft" closed="false">Rom. 3:13, Jas. 3:8.</char></note> <char style="qs">Selah</char><verse eid="PSA 140:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 140:4" />Makesiame badung gade acu kainzeu beu, RAMPAUBO;</para>
  <para style="q" vid="PSA 140:4">regie kecume dade acu gum beulo</para>
  <para style="q" vid="PSA 140:4">acu tei nkau di kera riem kelame dade.<verse eid="PSA 140:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 140:5" />Ngang kelame a ziemne baih teu pwabam;</para>
  <para style="q" vid="PSA 140:5">penui aziemne hebai ge tei pwabam;</para>
  <para style="q" vid="PSA 140:5">penui a ziemne hebaidung kai pwabam. <char style="qs">Selah</char><verse eid="PSA 140:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 140:6" />Ih ncu rang RAMPAUBO, “Nang au a Tinggwang;</para>
  <para style="q" vid="PSA 140:6">ngaunggia eh Ih hap kegai de kingnei gai lo,”<verse eid="PSA 140:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 140:7" />RAMPAUBO, a Tinggwang, nang au ngkingsüt eh acu kelilu bui;</para>
  <para style="q" vid="PSA 140:7">nang hereu benai apeu gumbeu da.<verse eid="PSA 140:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 140:8" />RAMPAUBE, makesiabe de pe luneudung peu so;</para>
  <para style="q" vid="PSA 140:8">penui nkim ciemdung de peu teicanglu so.<verse eid="PSA 140:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 140:9" />Acu twagwa kebam ngauraume depeu penui peudung cuhlu;</para>
  <para style="q" vid="PSA 140:9">peu penui muileudung de penui katei penuide gumcim dilu.<verse eid="PSA 140:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 140:10" />Peu miceu ru kebam de penui reuga cakmie lu;</para>
  <para style="q" vid="PSA 140:10">penui de mi ga heling gai dilu,</para>
  <para style="q" vid="PSA 140:10">pesing kegah koikidung gage, madaude peu cuhdai lak kerane.<verse eid="PSA 140:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 140:11" />Peu mina mleudung de kideu ga kwak kera tei diso;</para>
  <para style="q" vid="PSA 140:11">peu makesiabe de pezai kesiame peidung de gi ngkaudi lu.<verse eid="PSA 140:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 140:12" />Ih ci RAMPAUBE tutiak kecudau kehename lam pwa kera,</para>
  <para style="q" vid="PSA 140:12">nah kegahme de kemzeube ha beu kera.<verse eid="PSA 140:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 140:13" />Kesangmedung n zi de hetwa pwapeu bi zie;</para>
  <para style="q" vid="PSA 140:13">kemzuimedung nang kebam ga lungh zie.<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="s">Akwa kingnei gailo</para>
  <para style="d">David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 141:1" />RAMPAUBO, Ih nda ge hapgai la; a da zette gwanglu.</para>
  <para style="q" vid="PSA 141:1">Ih ncu qu kegai dau kingnei gai lo.<note caller="+" style="f"><char style="fr" closed="false">141:1 </char><char style="ft" closed="false">Keu. 5:8; 8:3-4, Mac. 3:25, 1 Pet. 3:6.</char></note><verse eid="PSA 141:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 141:2" />A kekie ndwa gade marim kehengui ge nzwalu;</para>
  <para style="q" vid="PSA 141:2">A badung hwa kegai de tinghegi ratak nzwa lu.<verse eid="PSA 141:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 141:3" />RAMPAUBO, a mui reu gage kekwabe ge kaigai lo;</para>
  <para style="q" vid="PSA 141:3">a muileudung kekwabe teilo.<note caller="-" style="x"><char style="xo" closed="false">141:3 </char><char style="xt" closed="false"><ref loc="JAS 1:26">Jas. 1:26</ref></char></note><verse eid="PSA 141:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 141:4" />Peu a n lung de makesia keheibe</para>
  <para style="q" vid="PSA 141:4">mede kemau tadung peu teidi so</para>
  <para style="q" vid="PSA 141:4">makesia zai keteime de ngngwa eh.</para>
  <para style="q" vid="PSA 141:4">Peu acu penui taktyeidung keheibe de tyei diso.<verse eid="PSA 141:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 141:5" />Peu ma kesangme ge depeu acu teilu; a ziemne cide au hezai keyi ta ge zie.</para>
  <para style="q" vid="PSA 141:5">Pecu peu acu ledeu lu; cide au apeu ga maca ge nzwa zie;</para>
  <para style="q" vid="PSA 141:5">peu a peu de cide luurau diso.</para>
  <para style="q" vid="PSA 141:5">Dede a kekie au penui kesia tadung de ngkau muila zie.<verse eid="PSA 141:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 141:6" />Ngauraume gu kedimedung de tsura hetia gade kelien nghung dizie;</para>
  <para style="q" vid="PSA 141:6">akatei a sam au keyibe lei kecu penui siuzie.<verse eid="PSA 141:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 141:7" />Penui ainzwa rangmaisia, “Mige hangdeu pu nah tei pangpop kegaidau,</para>
  <para style="q" vid="PSA 141:7">ciu eh Sheol mui ga anui radung tei zangra gai.”<verse eid="PSA 141:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 141:8" />A miak au n da la, RAMPAUBO, Tinggwang;</para>
  <para style="q" vid="PSA 141:8">Ih n dage nsiu la; a rabe de püt diso.<verse eid="PSA 141:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 141:9" />Penui a ziemne hebaihdung tei kenzeu gade acu gumlu,</para>
  <para style="q" vid="PSA 141:9">makesia keteimedung hebai gade.<verse eid="PSA 141:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 141:10" />Ih pakdi kecudau</para>
  <para style="q" vid="PSA 141:10">peu kesiame de penui katei penui hebai ga kau dilu.<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="s">Nang au a kensiuki</para>
  <para style="d">David gu lei ge, pa tsupop ga kebamdau; kekie ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 142:1" />Ih sah eh RAMPAUBE dage kengha kiegai;</para>
  <para style="q" vid="PSA 142:1">Ih RAMPAUBE kengha de zimene mra gai.<verse eid="PSA 142:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 142:2" />Ih a suisiet RAMPAUBE dwa gage ruigai;</para>
  <para style="q" vid="PSA 142:2">Ih a reidung peda ranggai.<verse eid="PSA 142:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 142:3" />A rabe a da kebam de mnei kedidau,</para>
  <para style="q" vid="PSA 142:3">nang a lampui ci.</para>
  <para style="q" vid="PSA 142:3">Ih tetkela lampui ga</para>
  <para style="q" vid="PSA 142:3">a ngauraume a ziemne hebai ge kebainzeu.<verse eid="PSA 142:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 142:4" />Ih a zetle piegai nah ngau</para>
  <para style="q" vid="PSA 142:4">migede a mapie kera gah kecu.</para>
  <para style="q" vid="PSA 142:4">Ih paklu kera gahdi;</para>
  <para style="q" vid="PSA 142:4">migede a teilung ma pie kera gah.<verse eid="PSA 142:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 142:5" />Ih ncu qugai, RAMPAUBO;</para>
  <para style="q" vid="PSA 142:5">Ih ranggai, “Nang au a kensiube,</para>
  <para style="q" vid="PSA 142:5">kering deu ga nang au a lie zi.<verse eid="PSA 142:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 142:6" />Ih kengha ziemne qu kegaidau kingnei gailo,</para>
  <para style="q" vid="PSA 142:6">kedanemene Ih hena süt eh teugwang lalu;</para>
  <para style="q" vid="PSA 142:6">acu tei keherei kelamedung dade acu kelibeu,</para>
  <para style="q" vid="PSA 142:6">kedanemene penui au aswa ngkieng kecune.<verse eid="PSA 142:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 142:7" />Hebaangki gade a rabe teumpet beu</para>
  <para style="q" vid="PSA 142:7">ciciu de Ih n zi de twa luzie.</para>
  <para style="q" vid="PSA 142:7">Kesamsangmedung acu twagwa luzie</para>
  <para style="q" vid="PSA 142:7">kedanemene nang a dade n zai yila lu.”<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="s">A rabe ncu hengin bam</para>
  <para style="d">David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 143:1" />A kekie kingnei lulo, RAMPAUBO; a nggia kingnei gailo.</para>
  <para style="q" vid="PSA 143:1">N lungsang nah n samsang de ziemne, a sam keli gailo!<verse eid="PSA 143:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 143:2" />N kilabe de ngngwalwe tutiak kera lüt diso,</para>
  <para style="q" vid="PSA 143:2">kedanemene n miakngau gade mi gede ma kesangme ga.<note caller="+" style="f"><char style="fr" closed="false">143:2 </char><char style="ft" closed="false">Rom. 3:20, 1 Cor. 4:4, Gal. 2:6.</char></note><verse eid="PSA 143:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 143:3" />A ngauraume ne a rabe de gwacang luda;</para>
  <para style="q" vid="PSA 143:3">pa a cu hangdeu gage hedeu dida;</para>
  <para style="q" vid="PSA 143:3">pa a cu kemui ga lung kera tei dida</para>
  <para style="q" vid="PSA 143:3">ndaa tsai kedimedung nzwa.<verse eid="PSA 143:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 143:4" />A lung ga a rabe puipung bam;</para>
  <para style="q" vid="PSA 143:4">a nlung ngkung dida.<verse eid="PSA 143:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 143:5" />Ih tingba gwang kedidung de nsung gai;</para>
  <para style="q" vid="PSA 143:5">Ih n tadung pelane cetncok gai;</para>
  <para style="q" vid="PSA 143:5">Nang teicang keludung de Ih piecaili gai.<verse eid="PSA 143:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 143:6" />Ih n dage kekie gade a ba hwa gaila;</para>
  <para style="q" vid="PSA 143:6">kideu kecang ga n ziemne a rabe hereu bam dida. <char style="qs">Selah</char><verse eid="PSA 143:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 143:7" />Sam keli zette gailo, RAMPAUBO, kedanemene a rabe mnei dida.</para>
  <para style="q" vid="PSA 143:7">A dade nzu Kebai diso,</para>
  <para style="q" vid="PSA 143:7">mecai hekwaki ga nghung kedime ge nzwadi zielu.<verse eid="PSA 143:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 143:8" />N samkakkelu samsang de peu acu tingcang dau siu lulo,</para>
  <para style="q" vid="PSA 143:8">kedanemene Ih ncu nlum lalu.</para>
  <para style="q" vid="PSA 143:8">Ih tet mai kesia lampui de acu saulia lo,</para>
  <para style="q" vid="PSA 143:8">kedanemene Ih ndage a rabe teu ncuh gai la.<verse eid="PSA 143:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 143:9" />A ngauraume dade acu kelibeu, RAMPAUBO;</para>
  <para style="q" vid="PSA 143:9">Ih n dage mbai kera pakgai lalu.<verse eid="PSA 143:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 143:10" />N lungning tei kera acu ledeu beulo,</para>
  <para style="q" vid="PSA 143:10">kedanemene nang au a Tinggwang.</para>
  <para style="q" vid="PSA 143:10">Peu n rabe keyi de</para>
  <para style="q" vid="PSA 143:10">acu petau ketei be deu gage sau gai beulo.<verse eid="PSA 143:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 143:11" />RAMPAUBO, N zi de ziemne, acu peu ring bam lo;</para>
  <para style="q" vid="PSA 143:11">n kesamsang le a rabe keherei kecu gade teumpet beula.<verse eid="PSA 143:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 143:12" />Ngu samkakkelu samsang le a ngauraume de tei nggahdi</para>
  <para style="q" vid="PSA 143:12">nah a teilung ga ngauraume pelane de tei ngkapdi lo,</para>
  <para style="q" vid="PSA 143:12">kedanemene Ih au n kilabe lu.<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="s">A Tsura nah a kengkieng bam</para>
  <para style="d">David gu lei ge.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 144:1" />RAMPAUBE, a tsurabe de peu samlampung kelube teilo,</para>
  <para style="q" vid="PSA 144:1">hereu teikera ziemne a badung ledeu kelabe</para>
  <para style="q" vid="PSA 144:1">nah keregi kera ziemne a zurangpuidung.<verse eid="PSA 144:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 144:2" />Nang au agu kesamsang samkak kelube nah a kengkieng reketbam,</para>
  <para style="q" vid="PSA 144:2">a bam kehube nah acu kelikelube,</para>
  <para style="q" vid="PSA 144:2">acu kegumbe nah Ih pe dage nsiu kelabe,</para>
  <para style="q" vid="PSA 144:2">a kang gade heleuhdung de kezeu lu kelabe.<verse eid="PSA 144:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 144:3" />RAMPAUBO, mina be daipaino nang pecu mcet kebambe de</para>
  <para style="q" vid="PSA 144:3">mede mina nabe nang mning kebambe de?<note caller="+" style="f"><char style="fr" closed="false">144:3 </char><char style="ft" closed="false">Lei. 8:4.</char></note><verse eid="PSA 144:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 144:4" />Mina au ngngi cuige nzwa;</para>
  <para style="q" vid="PSA 144:4">pe tingbadung au tingkaumie ge pakla kelanzwa.<verse eid="PSA 144:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 144:5" />Tinggim de ngkei lwe nghung lulo, RAMPAUBO;</para>
  <para style="q" vid="PSA 144:5">lamlwadung de tunggai eh penuide mika tei dilo.<verse eid="PSA 144:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 144:6" />Ting kehepiakdung langgai eh a ngauraumedung de teizang dilo;</para>
  <para style="q" vid="PSA 144:6">n lakpitsidung kapkai nah penuide kebwak dilu.<verse eid="PSA 144:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 144:7" />Nreule de n ba pet;</para>
  <para style="q" vid="PSA 144:7">dui kekiee gade,</para>
  <para style="q" vid="PSA 144:7">sangmedung ba gade acu keli beulo.<verse eid="PSA 144:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 144:8" />Penui muidung kenret rangla,</para>
  <para style="q" vid="PSA 144:8">nah penui nzetle ba au kemau.<verse eid="PSA 144:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 144:9" />Ih nda ge lei keheci ge teigai zie, Tinggwang;</para>
  <para style="q" vid="PSA 144:9">leibung peria kerei gade Ih lei tei ncu twazie.<note caller="+" style="f"><char style="fr" closed="false">144:9 </char><char style="ft" closed="false">Keu. 5:9; 14:3.</char></note><verse eid="PSA 144:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 144:10" />Hegwangmedung de kelikelu kepeu be,</para>
  <para style="q" vid="PSA 144:10">David n kilabe de kingtie kesiabe gade kelikelube.<verse eid="PSA 144:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 144:11" />Acu sangmedung ba gade kelibeu nah lungmpet beulo.</para>
  <para style="q" vid="PSA 144:11">Penui muidung kenret rangla,</para>
  <para style="q" vid="PSA 144:11">nah penui nzetle ba au kemau.<verse eid="PSA 144:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 144:12" />Peu anui namedung de tsingbangdung lung cangsiak kelube nzwa lulo penui rehang tingdau</para>
  <para style="q" vid="PSA 144:12">nah anui napuidung de hegwang ki kimiak ga hetsia hezu keyibe nzwa.<verse eid="PSA 144:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 144:13" />Peu anui baudung tah kelu ketsamtsam le kepui teilo,</para>
  <para style="q" vid="PSA 144:13">nah anui meuründung de cangcang nah cang kerei hing pet lulo anui luhdung ga.<verse eid="PSA 144:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 144:14" />Iciu eh anui tumdung de pena kekiee bam luzie.</para>
  <para style="q" vid="PSA 144:14">Migede anui heriedung teipop lüt lak; gwa kempet de bam lak</para>
  <para style="q" vid="PSA 144:14">nah anui lampuikidung ga kehap de gah zie.<verse eid="PSA 144:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 144:15" />Mina cikenzwa samlamdung kebam me samlam pungtu;</para>
  <para style="q" vid="PSA 144:15">mina pe Tinggwang au RAMPAUBE kecume pe sui yila.<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="s">RAMPAUBE au dizulie</para>
  <para style="d">Ketwa lei ge. David gu.</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 145:1" />Ih ncu twazie, a Tinggwang, Hegwangpei;</para>
  <para style="q" vid="PSA 145:1">Ih n zi de samlam zie kelungta.<verse eid="PSA 145:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 145:2" />Tingba ramsangne Ih ncu samlam zie;</para>
  <para style="q" vid="PSA 145:2">Ih n zi de twa zie kelungta.<verse eid="PSA 145:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 145:3" />RAMPAUBE au di nah pe kedi de twa kerabe;</para>
  <para style="q" vid="PSA 145:3">pe kedi au peicang gailak.<verse eid="PSA 145:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 145:4" />N batadung de twazie ceheu ge gade pecai be ceheu nah</para>
  <para style="q" vid="PSA 145:4">n bata kedidung ha rangzie.<verse eid="PSA 145:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 145:5" />Ih n kedi kemdu</para>
  <para style="q" vid="PSA 145:5">nah mimakecang n batadung de cetncok zie.<verse eid="PSA 145:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 145:6" />Penui nta miswakegah kengkieng de rangzie,</para>
  <para style="q" vid="PSA 145:6">nah Ih n kedi de ndu gaizie.<verse eid="PSA 145:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 145:7" />Penui n keyi le kepui de ndu gai zie,</para>
  <para style="q" vid="PSA 145:7">nah penui n masang ha lei tei zie.<verse eid="PSA 145:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 145:8" />RAMPAUBE au mide hung nah nggia beula,</para>
  <para style="q" vid="PSA 145:8">pe rata zette lama nah kenlum samkak le kepui teila.<verse eid="PSA 145:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 145:9" />RAMPAUBE au pelane dade yi;</para>
  <para style="q" vid="PSA 145:9">pe kenciep ngaugiadung au peta pelane reuga la.<verse eid="PSA 145:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 145:10" />Nang tei kelu pelane ncu hetwa peuzie, RAMPAUBO;</para>
  <para style="q" vid="PSA 145:10">ncu kenlumme ncu samlam beuzie.<verse eid="PSA 145:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 145:11" />Penui n hegwangram kemdu de rangzie,</para>
  <para style="q" vid="PSA 145:11">nah penui n kengkieng de rangzie.<verse eid="PSA 145:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 145:12" />Penui mina dage Tinggwang bata kedi</para>
  <para style="q" vid="PSA 145:12">nah pe hegwang kedi kendu liazie.<verse eid="PSA 145:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 145:13" />N hegwang au kelungta hegwang,</para>
  <para style="q" vid="PSA 145:13">nah n kengkieng au ceheudung pelane da lazie.<verse eid="PSA 145:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 145:14" />RAMPAUBE kau kelame de ngha la</para>
  <para style="q" vid="PSA 145:14">nah kau kebamme de kwakcuh beula.<verse eid="PSA 145:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 145:15" />Ma pelane ncu pie eh kwabam la;</para>
  <para style="q" vid="PSA 145:15">nang penuide ketyeipok peting siakdau peula.<verse eid="PSA 145:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 145:16" />Nang n ba ngkeibeu</para>
  <para style="q" vid="PSA 145:16">nah ring kela leune hengim teicang beu la.<verse eid="PSA 145:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 145:17" />RAMPAUBE au pe lampui pelane ga masang</para>
  <para style="q" vid="PSA 145:17">nah samsang eh pe ta leune teila.<note caller="+" style="f"><char style="fr" closed="false">145:17 </char><char style="ft" closed="false">Keu. 15:3; 16:5.</char></note><verse eid="PSA 145:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 145:18" />RAMPAUBE au pecu qu kelame pelane da nna bam,</para>
  <para style="q" vid="PSA 145:18">pecu nlumlukebui gade qu kela pelane da.<verse eid="PSA 145:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 145:19" />Pa pecu rüt kelame hengim tei beu la;</para>
  <para style="q" vid="PSA 145:19">pa penui kwa siula nah kelibeu la.<verse eid="PSA 145:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 145:20" />RAMPAUBE pecu kekume pelane ma pie bamla,</para>
  <para style="q" vid="PSA 145:20">dede pa kenlienme pelane de ngkap dizie.<verse eid="PSA 145:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 145:21" />A mui gade RAMPAUBE de ketwa rangpet zie;</para>
  <para style="q" vid="PSA 145:21">mina pelane de pe kemci zide kelungta samlam kebeube teilo.<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="s">Hegwang napei dage n kenlum kaizeu so</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 146:1" />RAMPAUBE de twa.</para>
  <para style="q" vid="PSA 146:1">RAMPAUBE de twa, a rabo.<verse eid="PSA 146:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 146:2" />Ih a teilung pelane teu eh RAMPAUBE de hetwa peula;</para>
  <para style="q" vid="PSA 146:2">Ih a Tinggwang dage ketwa lei teigai zie Ih kelungtane.<verse eid="PSA 146:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 146:3" />Hegwang namedung dage</para>
  <para style="q" vid="PSA 146:3">mede mina dage, penui da kelikelu kegahme dage n kenlum kai diso.<verse eid="PSA 146:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 146:4" />Mige keringcui de ntak kedidau, pa tangdei ga caili gwangdai dila;</para>
  <para style="q" vid="PSA 146:4">cipau nai pa riemteu keladung cang dila.<verse eid="PSA 146:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 146:5" />Pe ngha ziemne Jacob Tinggwang da kebam be samlam pungtu,</para>
  <para style="q" vid="PSA 146:5">pe keregui RAMPAUBE Tinggwang da kebambe.<verse eid="PSA 146:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 146:6" />RAMPAUBE tinggim nah kideu teilu,</para>
  <para style="q" vid="PSA 146:6">jaaidi, nah cidung ga kebam pelane;</para>
  <para style="q" vid="PSA 146:6">pa nlumlukebui de kelungta ncet bamla.<note caller="+" style="f"><char style="fr" closed="false">146:6 </char><char style="ft" closed="false">Bat. 4:24; 14:15; 17:24, Keu. 10:6; 14:17.</char></note><verse eid="PSA 146:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 146:7" />Pa mine teikeherei kelame ziemne hetu tiakla</para>
  <para style="q" vid="PSA 146:7">nah mzeu kelame de ketyeipok peu la.</para>
  <para style="q" vid="PSA 146:7">RAMPAUBE hebaangmedung de lungmpet beu la;<verse eid="PSA 146:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 146:8" />RAMPAUBE miakcetme de peu ma ngaulu;</para>
  <para style="q" vid="PSA 146:8">RAMPAUBE henah kelame dung de teu cuh beu;</para>
  <para style="q" vid="PSA 146:8">RAMPAUBE mina kesamsang medung de ku.<verse eid="PSA 146:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 146:9" />RAMPAUBE kideu ga sangmedung de gumbeu;</para>
  <para style="q" vid="PSA 146:9">pa pe pei kegame nah hemipui de teu cu beu,</para>
  <para style="q" vid="PSA 146:9">dede pa kenlienmedung de renia la.<verse eid="PSA 146:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 146:10" />RAMPAUBE kelungta hegwang teizie,</para>
  <para style="q" vid="PSA 146:10">nnui Tinggwang, Zion, ceheudung pelane ziemne.</para>
  <para style="q" vid="PSA 146:10">RAMPAUBE de twa.<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="s">Pa helung keherei kelame de de tei relui beula</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 147:1" />RAMPAUBE de twalu,</para>
  <para style="q" vid="PSA 147:1">anui Tinggwang dage ketwa lei teigai kecu yilie,</para>
  <para style="q" vid="PSA 147:1">cide au keyi ge, nah ketwa au petau.<verse eid="PSA 147:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 147:2" />RAMPAUBE Jerusalem tei dailu,</para>
  <para style="q" vid="PSA 147:2">pa Israelme zangra keladung de ngngwa ncüt dailu.<verse eid="PSA 147:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 147:3" />RAMPAUBE pe lung keherei kelame de teihemi beula</para>
  <para style="q" vid="PSA 147:3">nah penui rezam zamdung kangbeu la.<verse eid="PSA 147:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 147:4" />Pa hegidung pei,</para>
  <para style="q" vid="PSA 147:4">pa penui pelane zi nsiak lie.<verse eid="PSA 147:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 147:5" />Anui RAMPAUBE au di nah pe kengkieng au disüt,</para>
  <para style="q" vid="PSA 147:5">pe maci au mdet gailak.<verse eid="PSA 147:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 147:6" />RAMPAUBE mine kemneume de teucuh beula,</para>
  <para style="q" vid="PSA 147:6">pa kenlienme de kideu gage tei kau dila.<verse eid="PSA 147:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 147:7" />RAMPAUBE dage ketwa lei tei gailu,</para>
  <para style="q" vid="PSA 147:7">anui Tinggwang dage ketwa leidung tei gailu leibung keu eh.<verse eid="PSA 147:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 147:8" />Pa hemwadung le tinggimdung gum cim dila nah kideu ziemne tingrui teigai la,</para>
  <para style="q" vid="PSA 147:8">lamlwatudung ga cehei lung kera teibeu la.<note caller="-" style="x"><char style="xo" closed="false">147:8 </char><char style="xt" closed="false"><ref loc="ACT 14:17">Bat. 14:17</ref></char></note><verse eid="PSA 147:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 147:9" />Pa makaunedung de matyei kera peula</para>
  <para style="q" vid="PSA 147:9">nah nruine nra kegai dau pa matyei kera peula.<note caller="-" style="x"><char style="xo" closed="false">147:9 </char><char style="xt" closed="false"><ref loc="LUK 12:24">Luk. 12:24</ref></char></note><verse eid="PSA 147:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 147:10" />Pa hekwen ge kengkieng de pe suiyi swa lama,</para>
  <para style="q" vid="PSA 147:10">pa mige pe pi kengkieng gade pe suiyi swa lama.<verse eid="PSA 147:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 147:11" />RAMPAUBE pecu kerütme de pe suiyi la,</para>
  <para style="q" vid="PSA 147:11">pe samkakkelu kesamsang nlum kelame de.<verse eid="PSA 147:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 147:12" />RAMPAUBE de twalu, Jerusalem,</para>
  <para style="q" vid="PSA 147:12">n Tinggwang de twalu, Zion.<verse eid="PSA 147:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 147:13" />Pa n herieki piakdung tei ngking beu kela ziemne,</para>
  <para style="q" vid="PSA 147:13">pa nnui kakga n namedung de samlam beula.<verse eid="PSA 147:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 147:14" />Pa n railung ga mahei teugwang beula,</para>
  <para style="q" vid="PSA 147:14">pa wheat yitube le n nnung teibeu la.<verse eid="PSA 147:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 147:15" />Pa pe sam kideu gage langgai la,</para>
  <para style="q" vid="PSA 147:15">pe sam pak nzet sütla.<verse eid="PSA 147:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 147:16" />Pa buising langkwa nzwa teilu la,</para>
  <para style="q" vid="PSA 147:16">pa hesiu teizang la mimüt nzwa.<verse eid="PSA 147:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 147:17" />Pa tangheu taktyeipok ketangrabe nzwa tei zangra beu la,</para>
  <para style="q" vid="PSA 147:17">caune kengkung pa lang kegaide lia lulai?<verse eid="PSA 147:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 147:18" />Pa pe sam langgai nah cide tei suidi,</para>
  <para style="q" vid="PSA 147:18">pa tingkai gui kera nah dui lwa kera teigai.<verse eid="PSA 147:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 147:19" />Pa pe sam Jacob dage ranggai, pe zaidung</para>
  <para style="q" vid="PSA 147:19">nah pe samsang zaidung Israel dage.<verse eid="PSA 147:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 147:20" />Pa cide heleuh keda keheibe dage teigai ma,</para>
  <para style="q" vid="PSA 147:20">nah pe zaidung de au, penui cima.</para>
  <para style="q" vid="PSA 147:20">RAMPAUBE de twalu.<note caller="-" style="x"><char style="xo" closed="false">147:20 </char><char style="xt" closed="false"><ref loc="ROM 3:2">Rom. 3:2</ref></char></note><verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="s">RAMPAUBE zi de twa lulo</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 148:1" />RAMPAUBE de twalu.</para>
  <para style="q" vid="PSA 148:1">RAMPAUBE de twalu, nnui tinggimdung ga kebamme;</para>
  <para style="q" vid="PSA 148:1">pecu twalu, nnui kehudung ga kebamme.<verse eid="PSA 148:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 148:2" />Pecu twalu, RAMPAUBE samgwame pelane;</para>
  <para style="q" vid="PSA 148:2">pecu twalu, pe tinggimreugwame pelane.<verse eid="PSA 148:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 148:3" />Pecu twalu, naimiak na hekei;</para>
  <para style="q" vid="PSA 148:3">pecu twalu, nnui hegidung baa kebam pelane.<verse eid="PSA 148:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 148:4" />Pecu twalu, hutube tinggim</para>
  <para style="q" vid="PSA 148:4">nah nnui dui tinggim ga kebamdungde.<verse eid="PSA 148:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 148:5" />Peu penuide RAMPAUBE zi twalu,</para>
  <para style="q" vid="PSA 148:5">kedanemene pa pesam kai, nah penuide damlu.<verse eid="PSA 148:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 148:6" />Pa penuide kelungta ziemne tei lu;</para>
  <para style="q" vid="PSA 148:6">pa hezai ge teilu cide madaude kedi lak.<verse eid="PSA 148:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 148:7" />Pecu twalu kideu gade,</para>
  <para style="q" vid="PSA 148:7">nnui jaaidi neididung nah dui kedi kecokdung pelane,<verse eid="PSA 148:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 148:8" />mi nah tangheu, buising nah hemwadung,</para>
  <para style="q" vid="PSA 148:8">tingkai kaidi pe sam teicang beula.<verse eid="PSA 148:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 148:9" />Pecu twalu, kideutudung nah lamlwadung pelane,</para>
  <para style="q" vid="PSA 148:9">matsi bangdung nah cedardung pelane,<verse eid="PSA 148:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 148:10" />renaam kaune nah gui kelube,</para>
  <para style="q" vid="PSA 148:10">makaune bwa kelabe nah nruinedung.<verse eid="PSA 148:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 148:11" />RAMPAUBE de twalu, kideu ga hegwangmedung nah heleuhdung pelane,</para>
  <para style="q" vid="PSA 148:11">hegwangpei namedung nah kideu ga kedime pelane,<verse eid="PSA 148:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 148:12" />rehangmedung nah releimedung,</para>
  <para style="q" vid="PSA 148:12">kecingme nah henamedung de.<verse eid="PSA 148:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 148:13" />Peu penui pelane de RAMPAUBE zi twa lo,</para>
  <para style="q" vid="PSA 148:13">pezi rünne teucuh kelu ziemne nah pe kendu kideu reu</para>
  <para style="q" vid="PSA 148:13">nah tinggimdung ga kecang.<verse eid="PSA 148:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 148:14" />Pa pe mina kii teucuh beu<note caller="+" style="f"><char style="fr" closed="false">148:14 </char><char style="ft" closed="false">Pa pe leuhme de teingkieng beu.</char></note></para>
  <para style="q" vid="PSA 148:14">ketwa pecu kenlumme pelane dade kecu ziemne,</para>
  <para style="q" vid="PSA 148:14">Israelmedung, mina pecu kenname.</para>
  <para style="q" vid="PSA 148:14">RAMPAUBE de twalu.<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="s">RAMPAUBE dage lei keheci ge teigailo</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 149:1" />RAMPAUBE de twalu.</para>
  <para style="q" vid="PSA 149:1">Lei keheci ge RAMPAUBE dage teigai lu;</para>
  <para style="q" vid="PSA 149:1">kenlumme ngkwa gade pe ketwa lei teilu.<note caller="+" style="f"><char style="fr" closed="false">149:1 </char><char style="ft" closed="false">Keu. 5:9; 14:3.</char></note><verse eid="PSA 149:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 149:2" />Peu Israel de penuide tei kegaibe Tinggwang de penui suiyi lo;</para>
  <para style="q" vid="PSA 149:2">peu Zion medung de penui gwangpei de penui suiyi lo.<verse eid="PSA 149:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 149:3" />Helim lim eh pe zi twalu;</para>
  <para style="q" vid="PSA 149:3">peu penuide pe dage tambourine nah leibung kwa eh ketwa leidung teigailu.<verse eid="PSA 149:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 149:4" />Kedanemene RAMPAUBE pe minadung de pe suila;</para>
  <para style="q" vid="PSA 149:4">pa kehename de kelikelu le tei ndula.<verse eid="PSA 149:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 149:5" />Peu kenlummedung de herüt aide gade penui sui yilo;</para>
  <para style="q" vid="PSA 149:5">peu penuide suiyi ziemne penui zeudung gade lei teilu.<verse eid="PSA 149:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 149:6" />Tinggwang de ketwa de penui muiga bam kelube teilu</para>
  <para style="q" vid="PSA 149:6">nah kingtie ge pemui lule ailam kebam penui baga bam<verse eid="PSA 149:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 149:7" />heleuhdung de hekum peei eh mmau kera</para>
  <para style="q" vid="PSA 149:7">nah minadung de saja peu kera.<verse eid="PSA 149:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 149:8" />Penui penui gwangpei dungde hegeuriadung le kang luzie</para>
  <para style="q" vid="PSA 149:8">nah penui muiteumedung de hegeukapdung le kap luzie.<verse eid="PSA 149:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 149:9" />Penui hetutiak kera rauteu kela cide teizie.</para>
  <para style="q" vid="PSA 149:9">Aide le pwane pecu kenlummedung pelane ziemne herüt ge zie.</para>
  <para style="q" vid="PSA 149:9">RAMPAUBE de twalu.<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="s">Maleune de peu RAMPAUBE de twalo</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 150:1" />RAMPAUBE de twalu.</para>
  <para style="q" vid="PSA 150:1">Tinggwang de pe kemci ni gade twalu;</para>
  <para style="q" vid="PSA 150:1">pecu twalu kengkieng tinggimdung gade;<verse eid="PSA 150:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 150:2" />Tinggwang de twalu pe bata kedidung ziemne;</para>
  <para style="q" vid="PSA 150:2">pecu twalu pe kedi di tsamceu kecu ziemne.<verse eid="PSA 150:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 150:3" />Meurünseu ki kwa sahbak eh pecu twalu;</para>
  <para style="q" vid="PSA 150:3">pecu twalu lute nah leibung teu eh.<verse eid="PSA 150:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 150:4" />Tinggwang de twalu tambourinedung kwa eh nah lim eh;</para>
  <para style="q" vid="PSA 150:4">pecu twalu peria ketei leibung na tingkai leibungdung teu eh.<verse eid="PSA 150:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 150:5" />Pecu twalu ntwaidung kediang eh;</para>
  <para style="q" vid="PSA 150:5">pecu twalu ntwai dung kediang ntei süt eh.<verse eid="PSA 150:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 150:6" />Peu pengi kebam leune de RAMPAUBE de twalu.</para>
  <para style="q" vid="PSA 150:6">RAMPAUBE de twalu.<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>