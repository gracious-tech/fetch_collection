<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EZR" style="id">EN_ULT en_English_ltr Mon Sep 23 2019 10:41:47 GMT-0400 (EDT) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Ezra</para>
  <para style="toc1">Ezra Laisiukwak</para>
  <para style="toc2">Ezra</para>
  <para style="toc3">Ezr.</para>
  <para style="mt">Ezra</para>
  <para style="mt">Ezra Laisiukwak</para>
  <para style="is">Mraisam</para>
  <para style="ip">Ezra laisiukwak ga Jewme Babylon baang teikela gade cailikelu ha raupwala. Cide 539 BC dau Persia gwangpei Cyrus ajah, mina dungde Zerubbabel muiteu gade Jerusalem ga cailigwanglu kebui tei kebeu gade, ndeu lu. Minadung nlwa eh kerecaki teidai kecu teilu nah ratakdung tei dailu. Dede mmi kereieheset ge nreulebie ngauraume ne penuide teimci di. Kekamle 521 BC bekum Persia gwangpei Darius dade ajah de ngaulwe penui depeu teicang lu. Minadung kerecaki de 515 BC bekum teicanglwe teimci lu.</para>
  <para style="ip">458 BC bekum cingkupei Ezra Babylon baang teikela maa de Jerusalem ga cailigwang dailu. Pa mina dungde hezai ledeu beu nah penui renet teilung teimci beu iciu eh penuide twagwapung kebam leuhdung penui au Tinggwang kedetkelu leuh ge kecu ngaulu kerane. Ezra au Ezra penai Nehemiah laisiukwak kenade rau kegaibe da.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Hebaangme Judah deuga cailikegwang keraibe (1:1-2:70)</para>
  <para style="io1">Kerecaki teidai kelu (3:1-6:22)</para>
  <para style="io1">Ezra cailikegwang nah pe bata (7:1-10:44)</para>
  <chapter number="1" style="c" sid="EZR 1" />
  <para style="s">Cyrus hebaangme caili kera ngha kagai</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 1:1" />Persiame gwangpei, Cyrus hegwang teikelu mmi kerai bekum, RAMPAUBE sam Jeremiah dage ranggai kebeu de teicang lu kerane, RAMPAUBE Persia gwangpei Cyrus lung teigai beu. Cine pa aja ge pe hegwangram leune gage kaigai, nah kerau gage peu bamlu, de rang eh: <verse eid="EZR 1:1" /><verse number="2" style="v" sid="EZR 1:2" />“Persia gwangpei Cyrus ainzwa rangzeu: Tinggim Tinggwang, RAMPAUBE, kideu hegwangramdung pelane acu peu dida, nah pa ne acu Judah deuceu ga kebam, Jerusalem gage pe ziemne ki ge tei kerane nlum beuda. <verse eid="EZR 1:2" /><verse number="3" style="v" sid="EZR 1:3" />Nnui kakga caube ne pe minadung pelane gade no? Peu pe Tinggwang de peda la lulo, nah Judah ga kebam Jerusalem dega peu pecu nghang lulo, nah peu pecu RAMPAUBE, Israel Tinggwang ki tei lulo. Pa au Jerusalem ga kebam Tinggwang deda. <verse eid="EZR 1:3" /><verse number="4" style="v" sid="EZR 1:4" />Nah heni kehei leuga bang kelume pa lungh kebam gade, peu pe minadung lungh kebamme de pecu rangkanggeu nah kecak, nah mabamdung nah kauruinedung le ngha beulu, nah Jerusalem ga kebam Tinggwang ki de ziemne suiyi makai de si eh.”<verse eid="EZR 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 1:5" />Pecai Judah penai Benjamin leuh ga pepeu keteumedung, nah cingkumedung, nah Levimedung, nah Tinggwang ne helung tei kebeume pelane de si eh, Jerusalem ga kebam RAMPAUBE ki de tei kerane mteilu. <verse eid="EZR 1:5" /><verse number="6" style="v" sid="EZR 1:6" />Nah penuide twagwa kebamme pelane rangkanggeu lidung, kecak, mabamdung, nah kauruinedung le, nah pemi kehung mapeudung le penuide ngha beu, mta pwa kepeudung de si mene. <verse eid="EZR 1:6" /><verse number="7" style="v" sid="EZR 1:7" />Nah hegwangpei Cyrus RAMPAUBE ki lidung hegwangpei Nebuchadnezzar ne Jerusalem gade pwampet kelude pwa mpetlu nah cidungde pe rabedung ki gage kaidi.<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="2KI 25:8-17">2 Heg. 25:8-17</ref></char></note> <verse eid="EZR 1:7" /><verse number="8" style="v" sid="EZR 1:8" />Nah Persiame gwangpei, Cyrus cidungde mabam keteube Mithredath ba gage kai beudi. Nah pa cidungde Judah reu kedibe, Sheshbazzar de peimpet beudi. <verse eid="EZR 1:8" /><verse number="9" style="v" sid="EZR 1:9" />Nah cidungde aipau kieege: kecak lidung 30, rangkanggeu lidung 1,000, kieceunadung 29, <verse eid="EZR 1:9" /><verse number="10" style="v" sid="EZR 1:10" />kecak kwakceunadung 30, rangkanggeu kwakceunadung 410, nah keda lidung 1,000. <verse eid="EZR 1:10" /><verse number="11" style="v" sid="EZR 1:11" />Kecak nah rangkanggeu lidung pelane ge 5,400. Sheshbazzar aidungde pelane langgi kedimedung Babylon gade Jerusalem ga kemiedau pung nghang lu.<verse eid="EZR 1:11" /></para>
  <chapter eid="EZR 1" />
  <chapter number="2" style="c" sid="EZR 2" />
  <para style="s">Hebaangme cailigwang kelume zidung</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 2:1" />Cu aidungde deuceu namedung, langgi kedi hebaang ketei gade nghang kelumedung, Babylon deuceu gwangpei Nebuchadnezzar ne Babylon gage langi kedime. Nah penui Jerusalem nah Judah ga cailigwangdi, mi hange ge kecu pe namdibe riep ga; <verse eid="EZR 2:1" /><verse number="2" style="v" sid="EZR 2:2" />Zerubbabel, Jeshua, Nehemiah, Seraiah, Reelaiah, Mordecai, Bilshan, Mispar, Bigvai, Rehum, nah Baanah de ngngwa kegwangme. Aide Israelmedung peupei.<verse eid="EZR 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 2:3" />Parosh napeidung cai 2,172.<verse eid="EZR 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 2:4" />Shephatiah napeidung cai 372.<verse eid="EZR 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 2:5" />Arah napeidung cai 775.<verse eid="EZR 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 2:6" />Pahath-Moab napeidung, Jeshua nah Joab napeidung cai 2,812.<verse eid="EZR 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 2:7" />Elam napeidung cai 1,254.<verse eid="EZR 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 2:8" />Zattu napeidung cai 945.<verse eid="EZR 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 2:9" />Zakkai napeidung cai 760.<verse eid="EZR 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 2:10" />Bani napeidung cai 642.<verse eid="EZR 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 2:11" />Bebai napeidung cai 623.<verse eid="EZR 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 2:12" />Azgad napeidung cai 1,222.<verse eid="EZR 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 2:13" />Adonikam napeidung cai 666.<verse eid="EZR 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZR 2:14" />Bigvai napeidung cai 2,056.<verse eid="EZR 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZR 2:15" />Adin napeidung cai 454.<verse eid="EZR 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 2:16" />Ater napeidung, Hezekiah gade cai 98.<verse eid="EZR 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 2:17" />Bezai napeidung cai 323.<verse eid="EZR 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZR 2:18" />Jorah napeidung cai 112.<verse eid="EZR 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZR 2:19" />Hashum napeidung cai 223.<verse eid="EZR 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZR 2:20" />Gibbar napeidung cai 95.<verse eid="EZR 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 2:21" />Bethlehem napeidung cai 123.<verse eid="EZR 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZR 2:22" />Netophah mepeidung cai 56.<verse eid="EZR 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 2:23" />Anathoth mepeidung cai 128.<verse eid="EZR 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 2:24" />Azmaveth napeidung cai 42.<verse eid="EZR 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZR 2:25" />Kirjath-Arim, Kephirah, nah Beeroth napeidung cai 743.<verse eid="EZR 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZR 2:26" />Ramah nah Geba napeidung cai 621.<verse eid="EZR 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 2:27" />Michmas mepeidung cai 122.<verse eid="EZR 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZR 2:28" />Bethel nah Ai mepeidung cai 223.<verse eid="EZR 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EZR 2:29" />Nebo napeidung cai 52.<verse eid="EZR 2:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZR 2:30" />Magbish napeidung cai 156.<verse eid="EZR 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 2:31" />Elam keda napeidung cai 1,254.<verse eid="EZR 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EZR 2:32" />Harim napeidung cai 320.<verse eid="EZR 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EZR 2:33" />Lod napeidung, Hadid, nah Ono cai 725.<verse eid="EZR 2:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="EZR 2:34" />Jericho napeidung cai 345.<verse eid="EZR 2:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EZR 2:35" />Senaah napeidung cai 3,630.<verse eid="EZR 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EZR 2:36" />Cingkumedung: Jeshua kilung ga Jedaiah napeidung cai 973. <verse eid="EZR 2:36" /><verse number="37" style="v" sid="EZR 2:37" />Immer napeidung cai 1,052. <verse eid="EZR 2:37" /><verse number="38" style="v" sid="EZR 2:38" />Pashhur napeidung cai 1,247. <verse eid="EZR 2:38" /><verse number="39" style="v" sid="EZR 2:39" />Harim napeidung cai 1,017.<verse eid="EZR 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EZR 2:40" />Levimedung: Jeshua nah Kadmiel napeidung, Hodaviah napeidung cai 74.<verse eid="EZR 2:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="EZR 2:41" />Lei keteime: Asaph napeidung cai 128.<verse eid="EZR 2:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="EZR 2:42" />Heriekekwame napeidung: Shallum napeidung, Ater napeidung, Talmon napeidung, Akkub napeidung, Hatita napeidung, nah Shobai napeidung pelane ge 139.<verse eid="EZR 2:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="EZR 2:43" />Nethinme: Ziha napeidung, Hasupha napeidung, Tabbaoth napeidung, <verse eid="EZR 2:43" /><verse number="44" style="v" sid="EZR 2:44" />Keros napeidung, Siaha napeidung, Padon napeidung, <verse eid="EZR 2:44" /><verse number="45" style="v" sid="EZR 2:45" />Lebanah napeidung, Hagabah napeidung, Akkub napeidung, <verse eid="EZR 2:45" /><verse number="46" style="v" sid="EZR 2:46" />Hagab napeidung, Shalmai napeidung, nah Hanan napeidung, <verse eid="EZR 2:46" /><verse number="47" style="v" sid="EZR 2:47" />Giddel napeidung: Gahar napeidung, Reaiah napeidung, <verse eid="EZR 2:47" /><verse number="48" style="v" sid="EZR 2:48" />Rezin napeidung, Nekoda napeidung, Gazzam napeidung, <verse eid="EZR 2:48" /><verse number="49" style="v" sid="EZR 2:49" />Uzza napeidung, Paseah napeidung, Besai napeidung, <verse eid="EZR 2:49" /><verse number="50" style="v" sid="EZR 2:50" />Asnah napeidung, Meunim napeidung, nah Nephusim napeidung, <verse eid="EZR 2:50" /><verse number="51" style="v" sid="EZR 2:51" />Bakbuk napeidung, Hakupha napeidung, Harhur napeidung, <verse eid="EZR 2:51" /><verse number="52" style="v" sid="EZR 2:52" />Bazluth napeidung, Mehida napeidung, Harsha napeidung, <verse eid="EZR 2:52" /><verse number="53" style="v" sid="EZR 2:53" />Barkos napeidung, Sisera napeidung, Temah napeidung, <verse eid="EZR 2:53" /><verse number="54" style="v" sid="EZR 2:54" />Neziah napeidung, nah Hatipha napeidung.<verse eid="EZR 2:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="EZR 2:55" />Hegwangpei Solomon kilame napeidung: Sotai napeidung, Hassophereth napeidung, Peruda napeidung, <verse eid="EZR 2:55" /><verse number="56" style="v" sid="EZR 2:56" />Jaalah napeidung, Darkon napeidung, Giddel napeidung, <verse eid="EZR 2:56" /><verse number="57" style="v" sid="EZR 2:57" />Shephatiah napeidung, Hattil napeidung, Pochereth Hazzebaim napeidung, nah Ami napeidung. <verse eid="EZR 2:57" /><verse number="58" style="v" sid="EZR 2:58" />Nethinme nah Solomon kilame napeidung pelane cai 392.<verse eid="EZR 2:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="EZR 2:59" />Aidungde Tel Melah, Tel Harsha, Kerub, Addon, nah Immer namceu gade cailigwang kelumedung; dede penui paume pautsa mede penui leuh, penui Israel gade mi mebi kecu cimci luma. <verse eid="EZR 2:59" /><verse number="60" style="v" sid="EZR 2:60" />Delaiah napeidung, Tobiah napeidung, nah Nekoda napeidung cai 652. <verse eid="EZR 2:60" /><verse number="61" style="v" sid="EZR 2:61" />Nah cingkume napeidung gade: Habaiah napeidung; Hakkoz napeidung; nah Barzillai napeidung, pa Gileadme Barzillai napui de penau lu, cine pecu penui zi teu qudi. <verse eid="EZR 2:61" /><verse number="62" style="v" sid="EZR 2:62" />Aidungde penui paume zi paupak ha raupwa kenzeu ga peei lu, dede cidungde ngau luma. Nah penuide cingkuta ketei ga luulu tadi. <verse eid="EZR 2:62" /><verse number="63" style="v" sid="EZR 2:63" />Nah Tirshatha penui dade cingkupei Urim nah Thummim teulu kebuige bam kemaktane penuide peu mcitube kemci taktyei de teidau gailak lie eh rangdi.<verse eid="EZR 2:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="EZR 2:64" />Hemaabe pelane ge 42,360: <verse eid="EZR 2:64" /><verse number="65" style="v" sid="EZR 2:65" />penui kilapeidung nah penui kilapuidung 7,337 de si mene; penui ziemne lei keteime mipui nah mipei 200 bam. <verse eid="EZR 2:65" /><verse number="66" style="v" sid="EZR 2:66" />Penui hekwendung cai 736. Penui kwenceu cai 245. <verse eid="EZR 2:66" /><verse number="67" style="v" sid="EZR 2:67" />Penui utdung cai 435. Penui gadadung cai 6,720.<verse eid="EZR 2:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="EZR 2:68" />Nah pautsa peu keteume kangge RAMPAUBE ki Jerusalem ga kebamde ga gwang keludau, penui Tinggwang ki kehegwa ni de gage teidai kera ziemne suiyi makai kaibeu. <verse eid="EZR 2:68" /><verse number="69" style="v" sid="EZR 2:69" />Penui heta mabam de gage penui peulu kebui nsam gade kaibeu: kecak daric 61,000<note caller="+" style="f"><char style="fr" closed="false">2:69 </char><char style="fq" closed="false">Kecak daric 61,000: </char><char style="ft" closed="false">kecak kilogram 500.</char></note>, nah rangkanggeu mina 5,000<note caller="+" style="f"><char style="fr" closed="false">2:69 </char><char style="fq" closed="false">Rangkanggeu mina 5,000: </char><char style="ft" closed="false">rangkanggeu tonne 2.8</char></note>, nah cingkume paini 100.<verse eid="EZR 2:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="EZR 2:70" />Cine cingkumedung, nah Levimedung, nah minadung kakgade kangge, nah lei ketei medung, nah herieki kekwamedung, nah Nethinme penui namdidung ga lunghdi. Iciu eh Israelme pelane penui namdidung ga bamdi.<verse eid="EZR 2:70" /></para>
  <chapter eid="EZR 2" />
  <chapter number="3" style="c" sid="EZR 3" />
  <para style="s">Recabam teidai kecu</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 3:1" />Babylon gade cailigwang kelucai kei hena bekei canglu nah Israelmedung penui namdidung ga bam. Nah minadung ket tei eh Jerusalem ga gwang ngkwalu. <verse eid="EZR 3:1" /><verse number="2" style="v" sid="EZR 3:2" />Cidau Jozadak napei Jeshua cuhlu, nah pe siname cingkume, nah Zerubbabel Shealtiel napei, nah pe sinamedung, nah penui Israel Tinggwang recabam de teilu, Tinggwang minabe Moses zai ga ge rau pwa kebam de nzwa eh cipau gage keru recadung teigai beulu kerane.<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">Mat. 1:12, Luk. 3:27</char></note> <verse eid="EZR 3:2" /><verse number="3" style="v" sid="EZR 3:3" />Langgi kedi gade cailigwang kelume recabam de pe bangdwa bam de gage teilu, penui cika lungh kebamme<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="fq" closed="false">Cika lungh kebamme: </char><char style="ft" closed="false">penui gwang kemakdwa lungh kebam Israelme kemakme.</char></note> de hing liede. Pecai penui cikage RAMPAUBE de keru reca tei gaibeu, tingcang nah tinghegi keru recadung. <verse eid="EZR 3:3" /><verse number="4" style="v" sid="EZR 3:4" />Pecai penui Moses gu hezai ga raupwa kelade nzwa eh Paiki Ngyi de mneilu, tingba ramsang keru recade teilu, langgnai ge teimai kesiade mzui eh. <verse eid="EZR 3:4" /><verse number="5" style="v" sid="EZR 3:5" />Nah aipaucai keru recadung tei jüja bam di, nah keicidung<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="fq" closed="false">Keicidung </char><char style="ft" closed="false">hekeizie tingba raitube.</char></note> ziemne, nah RAMPAUBE ziemne teimci kelu kedet kelu tingdung pelane ziemne, nah suiyi makai RAMPAUBE de kepeu keheibe ziemne.<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">Pum. 28:11-15</char></note> <verse eid="EZR 3:5" /><verse number="6" style="v" sid="EZR 3:6" />Penui kei hena ga tingbazie raitube benai gade RAMPAUBE dage keru recadung de teigai cuhdi, RAMPAUBE kerecaki teilu mereu liede.<verse eid="EZR 3:6" /></para>
  <para style="s">Kerecaki teidai kecu</para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 3:7" />Nah penui tsupangme de nah tsingta keteime de rangkanggeu peu, nah taktyei, kesak, nah maca keu Sidonme nah Tyrme de peu, Lebanon gade Joppa jaaidi ga cedar tsingbangdung teugwang kerane, penuide Persia gwangpei Cyrus ne pe sam peu kegaide mzui eh.<verse eid="EZR 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 3:8" />Nah penui Jerusalem ga Tinggwang ki ga gwangkelu mmi pe kenabe kum, keina bekei dau, Shealtiel napei Zerubbabel, nah Jozadak napei Jeshua, nah penui siname kedame cingkume nah Levime, nah hebaang tei kela gade Jerusalem ga gwang kelu pelane heta tei ndeu lu, nah penui Levime mmi ngkai nah pe nreu lebieme de RAMPAUBE ki heta ketei ga pierengei kera nlumgai beudi.<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">minadung Babylon gade cailigwang kelucai mmi pe kanabe keina bekei.</char></note> <verse eid="EZR 3:8" /><verse number="9" style="v" sid="EZR 3:9" />Nah Jeshua, pe napeidung nah pe siname, Kadmiel nah pe napeidung, Judah napeidung, Tinggwang kerecaki ga heta tei kebamme de pie kerengeime tei kerane ket teilu, Henadad napeidung, penui napeidung nah penui siname Levime de si eh. <note caller="+" style="f"><char style="fq" closed="false">Judah napeidung </char><char style="ft" closed="false">mede </char><char style="fqa" closed="false">Hodaviah napeidung </char><char style="ft" closed="false">(Ezra 2:40)</char></note> <verse eid="EZR 3:9" /><verse number="10" style="v" sid="EZR 3:10" />Nah ki keteime RAMPAUBE kerecaki bangdwa de teincuh lu. Nah cingkume penui nia kailwe teluidung teu eh saplu, nah Levime, Asaph napeime, ntwaidung pwalwe saplu, Israel gwangpei David zai dungde teu eh RAMPAUBE de twa kerane. <verse eid="EZR 3:10" /><verse number="11" style="v" sid="EZR 3:11" />Cidau penui lei teidi, RAMPAUBE de twa nah teikeherei delie eh: “Pa au yilie, kedanemene pe samkakkelu samsang de Israelme da bammui kelane!” Mina pelane RAMPAUBE de twa eh sahbak degai, kedanemene RAMPAUBE ki bangdwa de tei ncuh kelune. <verse eid="EZR 3:11" /><verse number="12" style="v" sid="EZR 3:12" />Dede cingkume nah Levime kekiee ge kakga, nah pautsa peu keteume, kecingme kerecaki raitude kengaume, sahbak eh hap bamdi, penui miakngau gade kerecaki aide pe bangdwa de tei ncuh kegaidau. Dede mina kekiee ge suiyi kwa sahbak eh sahgai. <verse eid="EZR 3:12" /><verse number="13" style="v" sid="EZR 3:13" />Cine minadung suiyi kwa sah kebamde nah minadung kehap kwade ci ntsamlu tadi, kedanemene minadung sah kegaide mdu sütdi nah makwa de kemdei gade de siu kedine.<verse eid="EZR 3:13" /></para>
  <chapter eid="EZR 3" />
  <chapter number="4" style="c" sid="EZR 4" />
  <para style="s">Teidai kecude kemcwa</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 4:1" />Cu Judah nah Benjamin ngauraume langgi kedi gade cailigwang kelume RAMPAUBE, Israel Tinggwang kerecaki tei bamlie kecu siulu. <verse eid="EZR 4:1" /><verse number="2" style="v" sid="EZR 4:2" />Cine penui Zerubbabel nah pautsame peu keteume da gwang nah penui dage penui rangdi, “Anuide peu nnuide ngngwa teilo, kedanemene, nnui nzwa, anuide nnui Tinggwang de peeila nah anui Assyria gwangpei Esarhaddon, anuide aika ngngwa kegwangbe tingdau gade pe dage ratak teigai bamla lu.” <verse eid="EZR 4:2" /><verse number="3" style="v" sid="EZR 4:3" />Dede Zerubbabel, nah Jeshua, nah Israel ga pautsa peu keteume kedame penui dage rangdi, “Nnui anuide ngngwa anui Tinggwang ki ketei ga magede tei kera gah, dede anui anuikatei ngngwa RAMPAUBE, Israel Tinggwang ziemne, Persia gwangpei, hegwangpei Cyrus anuide teilo kebeude nzwa cide tei luzie.”<verse eid="EZR 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 4:4" />Nah cinzwa eh cipau deu ga kelunghme Judahme lung teingngi nah keheu bamdi, nah penuide peu ki tei kera hingdi, <verse eid="EZR 4:4" /><verse number="5" style="v" sid="EZR 4:5" />nah kedime de hetauhenim peu penuide mlai eh penui mariemdung teingkung di kera, Persia gwangpei, Cyrus hegwang ketei tingdau, nah Persia gwangpei, Darius hegwang tei kebamtane.<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">Persia hegwangpei Darius 521 gade 486 B.C. Kecang hegwang tei Cyrus nah Cambyses cia.</char></note><verse eid="EZR 4:5" /></para>
  <para style="s">Xerxes penai Artaxerxes kekamle kemcwa</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 4:6" />Cu Ahasuerus hegwang ketei tingdau,<note caller="+" style="f"><char style="ft" closed="false">Pecu </char><char style="fqa">Xerxes </char> de de qula. </note> pe hegwang tei keraidau, penui Judah nah Jerusalem ga kelunghme dage kemmau sam raugai.<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">Hegwangpei Ahasuerus I Darius cai hegwang tei 486 gade 465 BC. Kecang.</char></note><verse eid="EZR 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 4:7" />Nah Persia gwangpei Artaxerxes hegwang ketei tingdau, Bishlam, Mithredath, Tabeel, nah penui zangme kedamedung Persia gwangpei, Artaxerxes dage laisiu raugai, nah laisiu raupwa kebamde Aramaic let gade raugai nah Aramaic gade pei kedet gai.<verse eid="EZR 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 4:8" />Hezai kedibe, Rehum nah keraube<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="fq" closed="false">Keraube </char><char style="ft" closed="false">deuceu ga keraube.</char></note> Shimshai Jerusalem de kemmau laisiu ge raupwa hegwangpei Artaxerxes dage ainzwa raugai:<verse eid="EZR 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 4:9" />Pecai hezai kedibe Rehum, nah keraube Shimshai, nah penai zangme kedamedung, tutiakme nah, hegwangme, kedime, Persiame, Erechme, Babylonme, nah Susame (cide, Elamme), <verse eid="EZR 4:9" /><verse number="10" style="v" sid="EZR 4:10" />nah heleuh kedadung di nah ngkiengsüt kecube Ashurbanipal ne langgi di eh peu penuide Samaria namdidung ga lungh kedimedung nah Hereuki Gwale kedame de si. Nah cu:<verse eid="EZR 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 4:11" />(Aide penui pe dage laisiu langkegai deda:)</para>
  <para style="p" vid="EZR 4:11">“Hegwangpei Artaxerxes dage; N kilame, Euphrates reuki ga kelunghme; nah cu:<verse eid="EZR 4:11" /></para>
  <para style="s">Hegwangpei Artaxerxes dage kekai</para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 4:12" />Jewme n tingdeu keda gade kegwangme Jerusalem ga anui taiga gwang bamlie kecu hegwangpei depeu ci lulo. Penui au samzai tei kemak nah kemau namdi de teicuh daizeu, penui namdi riedung teicang zeu, nah pe bangdwadung de retak bam dida. <verse eid="EZR 4:12" /><verse number="13" style="v" sid="EZR 4:13" />Cu hegwangpei depeu cilo, magade cipau namdi de nah tangdeudung de teicanglu liecai, penui herahadung peuta dizie, nah n hegwangpei mabam cam dizie.<verse eid="EZR 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZR 4:14" />Cu, kedanemene anui hegwangpei kangga lungh kebamme, nah anui hegwangpei de rütkemak ta ketei au ngau neuma, aide ziemne anui hegwangpei dage langgai nah reci gaila, <verse eid="EZR 4:14" /><verse number="15" style="v" sid="EZR 4:15" />iciude pa n paume raukenzeudung laisiukwak<note caller="+" style="f"><char style="fr" closed="false">4:15 </char><char style="fq" closed="false">N paume raukenzeudung laisiukwak: </char><char style="ft" closed="false">hezai keteume ne kaikenzeu kwakdung kesangbe.</char></note> ga peeilu kerane. Nang raukenzeudung laisiukwak de gade ngau luzie nah namdi cide au samzai teikemak namdi ge nah hegwangme nah deuceudung de teikeherei kecu gelie eh ci luzie, nah ndaa de penui kakga regi jüja gwang. Aide ziemne, namdi cide de ngkapdi. <verse eid="EZR 4:15" /><verse number="16" style="v" sid="EZR 4:16" />Magade namdi cide tei dailu nah kiriedung teicang lucai, aide ziemne Euphrates Reuki nang n mzi bamsi kelak anui hegwangpei dage peu ci gaila.”<verse eid="EZR 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 4:17" />Hegwangpei sam aidungde keligai:</para>
  <para style="p" vid="EZR 4:17">“Hezai kedibe Rehum, nah Shimshai keraube, nah penai zangme Samaria ga lungh kelame leune, nah Hereuki Gwale pelane dage kaila. Kelum gaila:<verse eid="EZR 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZR 4:18" />Nnui anui dage langkegai laisiu de sünne eh a dwagade peigai beuda. <verse eid="EZR 4:18" /><verse number="19" style="v" sid="EZR 4:19" />Cine Ih aja ge kaibeu, nah penui pie kecung, nah ndaa de namdi cide hegwangme de mlai nah cika samzai teikemak nah kerenia kecu bamkela ci luda. <verse eid="EZR 4:19" /><verse number="20" style="v" sid="EZR 4:20" />Nah hegwang kengkiengme Jerusalem reu hegwang teigwang, Euphrates reuki leune reude kedimedung, nah heraha leune penuide peula.<verse eid="EZR 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 4:21" />Cu, mina aidungde de tei mtakdi kera aja kaigai lo, iciude namdi cipaude tei kera Ih ne aja kaigai kemakta teidai melu kerane. <verse eid="EZR 4:21" /><verse number="22" style="v" sid="EZR 4:22" />Nah aide mladi mene sünne eh teilu. Daitei eh hegwangme qwa teinggah kiee si laino?”<verse eid="EZR 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 4:23" />Cidau hegwangpei Artaxerxes laisiu de Rehum nah keraube Shimshai, nah penai kangme dwagade pei kegaidau, penui Jerusalem ga Jewme da kelwa mie, nah penuide penui kemei tei eh namdi de teidai kera kaamdi. <verse eid="EZR 4:23" /><verse number="24" style="v" sid="EZR 4:24" />Cipau tingdau Jerusalem ga kebam Tinggwang recaki ta tei kebamde mtakdi, nah cide Persia hegwangpei, Darius hegwang ketei mmi pe kenabe di kemakta heta kaam nzeudi.<verse eid="EZR 4:24" /></para>
  <chapter eid="EZR 4" />
  <chapter number="5" style="c" sid="EZR 5" />
  <para style="s">Tattenai ne Darius dage laisiu kekai</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 5:1" />Pecai caihakecime, caihakecibe Haggai nah Iddo napei Zechariah, Judah ga nah Jerusalem ga kebam Jewmedung dage Israel Tinggwang, penui reuga kebambe zi teu caihakecisam ranggai. <verse eid="EZR 5:1" /><verse number="2" style="v" sid="EZR 5:2" />Pecai Shealtiel napei Zerubbabel, nah Jozadak napei Jeshua, cuhlu eh Jerusalem ga kebam Tinggwang recaki tei cuhdi, nah Tinggwang gu caihakecime penuide ngha eh penuide ngngwa la.<verse eid="EZR 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 5:3" />Cipau tingdau, Euphrates Reuki deuceudibe Tattenai, nah Shethar-Bozenai, nah penui zangme penuida gwang eh penuide keteugai, “Caune nnuide aipau ki de tei kera nah aide teicang kera aja peu no?”<verse eid="EZR 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 5:4" />Cidau anui penui dage ranggai, “Aipau ki de tei kebamme zidung daino?”<verse eid="EZR 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 5:5" />Dede Tinggwang miak au Jew hangkiame reuga bam, nah penui penuide kaam dima Darius da sam kaigai beu eh pa pe sam keu kelidi kemaktane.<verse eid="EZR 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 5:6" />Laisiu de Tattenai, Euphrates Reuki deuceudibe, nah Shethar-Bozenai nah pe kangngwame, kedime Euphrates Reuki ga kebamme, hegwangpei Darius dage lang kegaide. <verse eid="EZR 5:6" /><verse number="7" style="v" sid="EZR 5:7" />Penui pe dage paulia ge langgai nah pelung ga ainzwa rauteula;</para>
  <para style="p" vid="EZR 5:7">“Hegwangpei Darius dage kaila: Lungciep leune bam kelube teilo.<verse eid="EZR 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 5:8" />Hegwangpei depeu cilo anui Judah deuceu, Tinggwang kedi kiga mielie kecu, nah cide tangtsudung disüt kecule tei pwabam, nah tangdeudung tsingget le teinzeu. Aipau ta de teune eh teibam nah penui ba gade heta tei nzetsüt nah teisüt lu bam. <verse eid="EZR 5:8" /><verse number="9" style="v" sid="EZR 5:9" />Pecai anui aipau hangkiame de keteugai, ainzwa eh anui penuide ranggai, ‘Caune nnuide aipau ki de tei kera aja kai beuno nah pe rehi de teicang kera?’ <verse eid="EZR 5:9" /><verse number="10" style="v" sid="EZR 5:10" />Nah anui penui dage penui zidung keteusi gai, peu ncu cilu kerane, iciude anui penui kakga muiteume zi dungde raulu kerane.<verse eid="EZR 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 5:11" />Nah penui ainzwa anuide sam keli caili eh ranggai, ‘Anui au tinggim nah kideu Tinggwang gu kilamedung lie, nah anui au ki mmi kekieege aipau dwa tei kedide teidai bam, nah Israel hegwang kedi<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="fq" closed="false">Israel hegwang kedi </char><char style="ft" closed="false">Solomon-pezi rang ma kedanemene Persiame pecu ci kelakne.</char></note> ne cide teigai nah cide teicang beu. <verse eid="EZR 5:11" /><verse number="12" style="v" sid="EZR 5:12" />Ciuliede, kedanemene anui peime tinggim ga Tinggwang rata tei kedine, pa penuide Chaldeanme pei, Babylon gwangpei Nebuchadnezzar, ba gage kaibeu di, nah pa aipau ki de teimsiadi nah minadung de Babylon gage langgi di.<verse eid="EZR 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 5:13" />Dede Babylon gwangpei, Cyrus hegwang teikelu mmi raitu bekum, hegwangpei Cyrus Tinggwang ki aide teidai kera aja kaigai. <verse eid="EZR 5:13" /><verse number="14" style="v" sid="EZR 5:14" />Nah Tinggwang ki gu kecak nah rangkanggeu lidung Nebuchadnezzar ne Jerusalem ga kebam kerecaki gade pwa kelude nah Babylon kerecaki gage cidungde pwagwang lu. Hegwangpei Cyrus Babylon kerecaki gade cidungde keu mpetlu delwe cidungde mige pe zi Sheshbazzar lie kecuge dage peudi, pa pecu peu deuceudibe tei kelube de. <verse eid="EZR 5:14" /><verse number="15" style="v" sid="EZR 5:15" />Pecai pa pe dage rangbeu, “Aipau lidung de keutet culo. Jerusalem ga kebam kerecaki gage cidungde keumie kailu, nah peu heni cide gage Tinggwang ki tei lulo.” <verse eid="EZR 5:15" /><verse number="16" style="v" sid="EZR 5:16" />Cipaucai Sheshbazzar gwang; pa Tinggwang ki Jerusalem ga kebam bangdwa tei ndeu gaibeu. Nah cipau ting gade cu kecang teibam reu, dede cide teicang luma.’<verse eid="EZR 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 5:17" />Nah cu, magade hegwangpei sui liecai, peu hegwangpei mabam ki Babylon ga kebamde gade mahei kecung lo, Hegwangpei Cyrus Jerusalem ga Tinggwang ki tei lulo beu mi mebi kecu cilu kera. Nah peu pecu aipau hade ziemne hegwangpei lungning anui dage langgai beulo.”<verse eid="EZR 5:17" /></para>
  <chapter eid="EZR 5" />
  <chapter number="6" style="c" sid="EZR 6" />
  <para style="s">Darius aja</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 6:1" />Pecai hegwangpei Darius aja ge kaigai eh penui Babylon ga laisiudung kekai ki ga, ma pemi kehung kai kenzeu kiga peeilo eh. <verse eid="EZR 6:1" /><verse number="2" style="v" sid="EZR 6:2" />Pecai Media deuceu ga kebam Ecbatana hetaideu gade laisiudum ge ngaulu, nah sam ainzwa rau pwala:<verse eid="EZR 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 6:3" />“Hegwangpei Cyrus hegwang teikelu raitu bekum, hegwangpei Cyrus Jerusalem ga kebam Tinggwang ki de ziemne aja ge kaigai:</para>
  <para style="p" vid="EZR 6:3">‘Peu ki de tei ncuhlu, ratakdung teigai kebeu nide gage, nah peu pe bangdwa teicuh dailu. Pe hu cubit 60 zie. Pe di cubit 60 zie, <verse eid="EZR 6:3" /><verse number="4" style="v" sid="EZR 6:4" />tangtsu kedi lip cum nah tsing keheci lip ge le. Nah peu pemi hegwangpei mabam gade kaibeu lu. <verse eid="EZR 6:4" /><verse number="5" style="v" sid="EZR 6:5" />Nah cide si eh, peu Tinggwang kerecaki ga (kecak nah rangkanggeu) lidung, Nebuchadnezzar Jerusalem ga kebam kerecaki gade keumpet kelude nah Babylon ga keugwang kelude, teu cailigwang lu. Nah Jerusalem ga kebam kerecaki dega peu keugwang dailu. Iciu eh nnui cidungde Tinggwang kerecaki gage kailu maisia.’”<verse eid="EZR 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 6:6" />Pecai hegwangpei Darius sam aide langgai: “Cu Euphrates Reuki kenlütle deuceudibe Tattenai, Shethar-Bozenai, nah penui kangzangme nah Euphrates Reuki kenlütle deuceu kedimedung: cikade mdei dilu. <verse eid="EZR 6:6" /><verse number="7" style="v" sid="EZR 6:7" />Aipau Tinggwang kerecaki ta de püt dilu. Peu Jewme deuceudibe nah Jewme hangkiame de ndaa kesap nide gage Tinggwang kerecaki teigai lu. <verse eid="EZR 6:7" /><verse number="8" style="v" sid="EZR 6:8" />Tinggwang kerecaki ketei ga nnui Jewme hangkiame, aidungde dage dai teigai maisiabi kecu Ih aja ge kaila. Nah hema mpet kedidung peu hegwangpei mabam gade (cide cai, heraha Euphrates Reuki kenlütle deuceu gu) penuide peu siakte beulu, iciu eh heta de mtakdi melu kerane. <verse eid="EZR 6:8" /><verse number="9" style="v" sid="EZR 6:9" />Nah teumaikesia keheibede (Jerusalem ga kebam cingkumedung teu maisialie kecube, ketumseu keceunadung, mede meurünseudung, mede meurünnadung tinggim Tinggwang dage keru recadung teigai kerane, wheat, ncai, zau, mede olive ca), (cide teiluta diso) cide peu tingba ge cai tingba ge penuide pwapeu lu, <verse eid="EZR 6:9" /><verse number="10" style="v" sid="EZR 6:10" />iciude penui perim-kehengui ratakdung tinggim Tinggwang dage reca teigai beulu kerane nah hegwangpei nah pe name teilung ziemne kielu kerane.<verse eid="EZR 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 6:11" />Nah Ih aja ge kai gaila, mina keheibe de hezai aide mzailu kemakbe de, tsingsum ge pe ki gade teumpet lu, nah, teu cuhlu eh pecu cikage reugai dizie. Nah aide ziemne pe ki peu ralie tum ge tei dizie. <verse eid="EZR 6:11" /><verse number="12" style="v" sid="EZR 6:12" />Nah peu Tinggwang pe zi cika bam zielie kelabe de hegwang keheibe de mede mina cide kedidi kera, nah Tinggwang kerecaki Jerusalem ga kebam de teimsiadi kera keteibe de keliengi kedibe teilu. Ih, Darius, aja aide kaila. Peu cide tei siakte lu!”<verse eid="EZR 6:12" /></para>
  <para style="s">Kerecaki teicang kelu nah tei kemci</para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 6:13" />Pecai Tattenai, Euphrates Reuki kenlütle deuceudibe de, Shethar-Bozenai, nah penui kangzangme cinzwa tei siaktelu, hegwangpei Darius langkegai de mzui eh. <verse eid="EZR 6:13" /><verse number="14" style="v" sid="EZR 6:14" />Nah Jewme hangkiame Haggai caihakecibe nah Zechariah Iddo napei ne caihasam rang kegaide nzwa eh teilu nah lungh yidi. Nah penui Israel Tinggwang aja nah Cyrus, nah Darius, nah Persia gwangpei Artaxerxes ajai kai kebeude mzui eh reca ni de teilu. <verse eid="EZR 6:14" /><verse number="15" style="v" sid="EZR 6:15" />Nah aipau kerecaki de Adar bekei lang cumne benai teicang lu, cide hegwangpei Darius hegwang tei kebam mmi herok bekum.<verse eid="EZR 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 6:16" />Nah Israelmedung, cingkume, nah Levime, nah langgi kedimedung pelane penui suiyi eh Tinggwang kerecaki aide teimci gaibeu. <verse eid="EZR 6:16" /><verse number="17" style="v" sid="EZR 6:17" />Nah Tinggwang kerecaki aide teimci gai kerane, penui hetumseu hai ge, meurünseu hai na, nah meurünna hai mdai, nah hemeuseu kereiekena peugai, Israelme pelane kemau reca tei kerane, Israel leuhme riak rehi gade. <verse eid="EZR 6:17" /><verse number="18" style="v" sid="EZR 6:18" />Nah penui cingkume de penui mzidung gade heta nlum beudi, nah Levime de penui mzidung ga, Jerusalem ga kebam Tinggwang ta de ziemne, Moses laisiukwak ga rauteu kelade nzwa eh.<note caller="+" style="f"><char style="fr" closed="false">6:18 </char><char style="ft" closed="false">Tet. 29, Lev. 8, Pum. 3-4</char></note><verse eid="EZR 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZR 6:19" />Cine langgi kedimedung Kahkegwang ngyi penui cailigwang kelu raitube kei ziangreiemdai benai hengyi lu. <verse eid="EZR 6:19" /><verse number="20" style="v" sid="EZR 6:20" />Kedanemene cingkume nah Levime ngngwa ket tei eh penuikatei penuide teimci lu, penui pelane de mcilu. Nah penui Kahkegwang meurünna de gilu langgi kedi napeidung pelane ziemne, nah penui siname ziemne, cingkume, nah penui ziemne de.<note caller="+" style="f"><char style="fr" closed="false">6:20 </char><char style="ft" closed="false">2 Hel. 30:17; 35:10-11</char></note> <verse eid="EZR 6:20" /><verse number="21" style="v" sid="EZR 6:21" />Nah Israelmedung, langgi kedi gade cailigwang kelume nah heleuhbe cipau deu ga lungh kebamme mci kemak zai gade penuide kai ntsam kelu pelane ngngwa ketaktyei, RAMPAUBE, Israel Tinggwang de peei kera ziemne. <verse eid="EZR 6:21" /><verse number="22" style="v" sid="EZR 6:22" />Cine penui Cehikaikemak Tangku Ngyi<note caller="+" style="f"><char style="fr" closed="false">6:22 </char><char style="fq" closed="false">Cehikaikemak Tangku Ngyi </char><char style="ft" closed="false">Kahkegwang ngyi de hengyi canglu siakte Cehi kai kemak Tangku Ngyi hengyi la. Kei raitube kei ziangreimengei benai gade zie ngkaieket benai kecang lang henane hengyi la. Tet. 12:15-20, Lev. 23:6, Pum. 28:17, Hez. 16:1-8</char></note> de penui suiyi eh lang henane hengyi lu, kedanemene RAMPAUBE penui suiyi kepui tei kebeune, nah peu Assyria gwangpei lung penui lam ge nreugai kelune, iciu eh penui Israel Tinggwang, Tinggwang kerecaki ketei ga ngha kebeune.<verse eid="EZR 6:22" /></para>
  <chapter eid="EZR 6" />
  <chapter number="7" style="c" sid="EZR 7" />
  <para style="s">Ezra Jerusalem ga kegwang</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 7:1" />Mmi kekiee gecai, Persia gwangpei, Artaxerxes hegwang ketei tingdau: Ezra (Seraiah napei, Azariah napei, Hilkiah napei, <verse eid="EZR 7:1" /><verse number="2" style="v" sid="EZR 7:2" />Shallum napei, Zadok napei, Ahitub napei, <verse eid="EZR 7:2" /><verse number="3" style="v" sid="EZR 7:3" />Amariah napei, Azariah napei, Meraioth napei, <verse eid="EZR 7:3" /><verse number="4" style="v" sid="EZR 7:4" />Zerahiah napei, Uzzi napei, Bukki napei, <verse eid="EZR 7:4" /><verse number="5" style="v" sid="EZR 7:5" />Abishua napei, Phinehas napei, Eleazar napei, Aaron napei cingku kedibe), <verse eid="EZR 7:5" /><verse number="6" style="v" sid="EZR 7:6" />Ezra aipaude Babylon gade gwang, nah pa RAMPAUBE, Israel Tinggwang ne Moses de kepeu zai ga yisüt kecume ge. Nah pa kie kegai pelane hegwangpei pecu teibeu RAMPAUBE pe Tinggwang ba pe reuga kebamne.<verse eid="EZR 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 7:7" />Nah Israel napeidung kangge gade nah cingkume gade, nah Levime, nah lei keteime, nah herieki kekwame, nah kerecaki ga kilamedung Jerusalem ga nghang Hegwangpei Artaxerxes hegwang ketei mmi hena tingdau. <verse eid="EZR 7:7" /><verse number="8" style="v" sid="EZR 7:8" />Nah pa Jerusalem ga kei mengei bekei gwanglu, cide hegwangpei hegwang teikelu mmi hena bekum. <verse eid="EZR 7:8" /><verse number="9" style="v" sid="EZR 7:9" />Kedanemene Babylon gade kei raitu bekei tingba raitu benai hebeuh teicuh gai. Nah pa kei mengei bekei tingba raitu benai Jerusalem ga gwanglu, pe Tinggwang pecu ngha kebeune. <verse eid="EZR 7:9" /><verse number="10" style="v" sid="EZR 7:10" />Kedanemene Ezra RAMPAUBE hezai kai kebeude peei kera ntip bam, nah cide teilu kera, nah Israel ga zaisiedung nah hezaidung ge ledeu kera.<verse eid="EZR 7:10" /></para>
  <para style="s">Hegwangpei Artaxerxes ne Ezra dage kekai laisiu</para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 7:11" />Cu laisiu aide Hegwangpei Artaxerxes ne cingkupei Ezra, laisiu kecibe RAMPAUBE aja kai kebeu samdung nah Israelme ziemne hezai kai kebeu dage raukegai:<verse eid="EZR 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 7:12" />“Hegwangme reu hegwangpei, Artaxerxes ne kaipwa cingkupei Ezra, tinggim Tinggwang hezai kecibe dage kaila. Kelum gaila:<verse eid="EZR 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 7:13" />a hegwangram ga pelane de, Jerusalem ga ncu ngngwa mie keneume, Israelme gade, nah pe cingkumedung nah Levimedung, mie lubui lie eh Ih aja kai gaila.<verse eid="EZR 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZR 7:14" />Kedanemene hegwangpei dwagade, nah pe keledeumedung hang hena, Judah deuceu ha nah Jerusalem namdi ha n Tinggwang zai gade, n baga kebam ria gade dainzwa bambi keteu kera ncu langgai nzeu, <verse eid="EZR 7:14" /><verse number="15" style="v" sid="EZR 7:15" />nah rangkanggeu nah kecak hegwangpei nah pe keledeume mta mapeu Israel Tinggwang Jerusalem ga lungh kebam de kepeude keu gwang kerane, <verse eid="EZR 7:15" /><verse number="16" style="v" sid="EZR 7:16" />nang rangkanggeu nah kecak pelane Babylon deuceu pelane gade ngau kelube, mina nah cingkumedung mta mapeu kepeu teusi eh, Jerusalem ga kebamme Tinggwang kerecaki ziemne pemi tei mene kepeube: <verse eid="EZR 7:16" /><verse number="17" style="v" sid="EZR 7:17" />ciziemne, nang rangkang aide, teu teune eh hetumseudung luilu, hemeuseudung, meurünnadung, nah penui kereca tsiu nah penui kesak reca; nah nang cidungde recabam Jerusalem ga n Tinggwang kerecaki ga kebamde gage reca teigai beulu. <verse eid="EZR 7:17" /><verse number="18" style="v" sid="EZR 7:18" />Nah n ziemne nah n maame ziemne rangkanggeu nah kecak bangkelu dungde teu yi kerabe tei lubui, n Tinggwang suibe nzwa eh teilu. <verse eid="EZR 7:18" /><verse number="19" style="v" sid="EZR 7:19" />Nah n Tinggwang kerecaki tade ziemne lidung ncu kepeudung, Jerusalem Tinggwang dwa gage pung gwang ciak gai beulu. <verse eid="EZR 7:19" /><verse number="20" style="v" sid="EZR 7:20" />Nah n Tinggwang kerecaki ziemne teu maikesia kedabe leune nang pwapeu mai kesiabe, nang hegwangki mabam gade peu lubui.<verse eid="EZR 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 7:21" />Nah Ih, hegwangpei Artaxerxes, Euphrates kenlütle deuceu mabam keteume pelane dage aja kai gaila: Ezra (Cingkupei, tinggim Tinggwang zai kecibe) nnui dade kekie leune, cide tei sünne beu lulo; <verse eid="EZR 7:21" /><verse number="22" style="v" sid="EZR 7:22" />rangkanggeu kikkars 100<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="fq" closed="false">kikkars 100 </char><char style="ft" closed="false">3,500 kilogram kenzwage</char></note> kiee ge, nah wheat cors 100<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="fq" closed="false">cors 100 </char><char style="ft" closed="false">2,722 kilogram kenzwage</char></note> kieege, nah zau baths 100<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="fq" closed="false">baths 100: </char><char style="ft" closed="false">2,000 litre kenzwage.</char></note> kieege, nah maca baths 100 kieege, nah mcai teu maikesia kieege peu lulo. <verse eid="EZR 7:22" /><verse number="23" style="v" sid="EZR 7:23" />Tinggim Tinggwang dade kegwang aja kai kebeu pelane, tinggim Tinggwang kerecaki ziemne cide gapte tei teune beulu. Kedanemene daitei eh peu pe rata hegwangpei gwangram nah pe napeidung da gwangdi laino?<verse eid="EZR 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 7:24" />Nah nziemne au cingkume pelane reuga heraha kera riem kecu, ceha, mede hezai tei kecu Levime, lei keteime, herieki kekwame, kerecaki kekwame, nah cipau Tinggwang kerecaki kilame reu kengkieng peuma. <verse eid="EZR 7:24" /><verse number="25" style="v" sid="EZR 7:25" />Nah Ezra n ziemne au, Tinggwang maci n baga kebam ria gade, Euphrates Reuki ga kebamme mina leune de tutiak lu kerame tiak lu nah keteumedung tutiakme de kedetlu, n Tinggwang zaidung ci kebam leune. Nah nang ci kemakme de ledeu maisia. <verse eid="EZR 7:25" /><verse number="26" style="v" sid="EZR 7:26" />Nah n Tinggwang zai nah hegwangpei zai mnei kemakme leune dage, tutiakbe pe reu gage tei teune eh teigai beuzie, ketsai ziemne liede, mede langgi kera ziemne liede, mede pe ma tuiteukedi ziemne, mede hebaang ketei ziemne.”<verse eid="EZR 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 7:27" />RAMPAUBE anui paume Tinggwang de twalu, Jerusalem ga kebam, RAMPAUBE kerecaki de rütlu kera, pa hegwangpei mlung gage cikenzwa peu, <verse eid="EZR 7:27" /><verse number="28" style="v" sid="EZR 7:28" />nah samkakkelu samsang de hegwangpei dwa gade, nah pecu keledeume, nah hegwangpei kengkieng kedime pelane dwa gade acu liagai. Nah Ih, RAMPAUBE a Tinggwang acu ngngwa kelane Ih acu teingkieng lu, nah Ih Israel gade muiteume dungde acu ngngwa nghang kera hekwa luda.<verse eid="EZR 7:28" /></para>
  <chapter eid="EZR 7" />
  <chapter number="8" style="c" sid="EZR 8" />
  <para style="s">Jerusalem ga cailikegwang</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 8:1" />Cu aidungde penui pautsa peume nah penui paupak ria gade raukelu zidung, hegwangpei Artaxerxes hegwang tei kebamdau Babylon gade acu ngngwa nghang kelume:<verse eid="EZR 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZR 8:2" />Phinehas pautsa gade cai Gershom.</para>
  <para style="p" vid="EZR 8:2">Ithamar pautsa gade cai Daniel.</para>
  <para style="p" vid="EZR 8:2">David pautsa gade cai Hattush.<verse eid="EZR 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 8:3" />Shecaniah pautsa gade,</para>
  <para style="p" vid="EZR 8:3">Parosh pautsa gade cai Zechariah, nah pecu ngngwa paupak ria gade hezi raukelume mipei 150.<verse eid="EZR 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 8:4" />Pahath-Moab pautsa gade cai Zerahiah napei Eliehoenai, nah pecu ngngwa mipei 200 ge si.<verse eid="EZR 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 8:5" />Shekaniah pautsa gade cai Jahaziel napei, nah pecu ngngwa mipei 300 ge si.<note caller="+" style="f"><char style="fq" closed="false">Shekaniah pautsa gade cai Jahaziel napei </char><char style="ft" closed="false">mecai </char><char style="fqa" closed="false">Zattu pautsa gade cai Shekaniah, Jahaziel napei </char><char style="ft" closed="false">(Greek Septuagint nah kehegwa laisiudung keda ga) </char></note><verse eid="EZR 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 8:6" />Nah Adin pautsa gade cai, Jonathan napei Ebed, nah pecu ngngwa mipei 50 ge si.<verse eid="EZR 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 8:7" />Elam pautsa gade cai, Athaliah napei Jeshaiah, nah pecu ngngwa mipei 70 ge si.<verse eid="EZR 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 8:8" />Nah Shephatiah pautsa gade cai, Michael napei Zebadiah, nah pecu ngngwa mipei 80 ge si.<verse eid="EZR 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 8:9" />Joab pautsa gade cai, Jehiel napei Obadiah, nah pecu ngngwa mipei 218 ge si.<verse eid="EZR 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 8:10" />Shelomith pautsa gade cai, Josiphiah napei, nah pecu ngngwa mipei 160 ge si.<verse eid="EZR 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 8:11" />Nah Bebai pautsa gade cai, Bebai napei Zechariah, nah pecu ngngwa mipei 28 ge si.<verse eid="EZR 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 8:12" />Nah Azgad pautsa gade cai, Hakkatan napei Johanan, nah pecu ngngwa mipei 110 ge si<verse eid="EZR 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 8:13" />Nah Adonikam pautsa gade gwang kekamme, nah aidungde penui zidung: Eliphelet, Jeuel, nah Shemaiah, nah pecu ngngwa mipei 60 ge si.<verse eid="EZR 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZR 8:14" />Nah Bigvai pautsa gade cai, Uthai nah Zaccur, nah pecu ngngwa mipei 70 ge si.<verse eid="EZR 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZR 8:15" />Nah Ih penuide kereuki, Ahava namdi ga lwa kemie de gage ngngwa ngkwa gailu, nah anui cika lang cumne ge ramzeuki teilwe bamlu. Delwe Ih minadung nah cingkume de pie gwang, dede Ih Levi pautsa gade migede de ngau luma. <verse eid="EZR 8:15" /><verse number="16" style="v" sid="EZR 8:16" />Pecai Ih qugai: muiteumedung Eliezer, Ariel, Shemaiah, nah Elnathan, nah Jarib, nah Elnathan, nah Nathan, nah Zechariah, nah Meshullam de; nah makecime Joiarib nah Elnathan de. <verse eid="EZR 8:16" /><verse number="17" style="v" sid="EZR 8:17" />Nah Ih penuide Kasiphia de qu kela heni ga Levime muiteube Iddo da mielo aja kaigai. Nah Ih Iddo nah pe maame Levime nah Kasiphia ga kerecaki kilamedung dage rang kera samdung penui mui gage kaibeu, anuida anui Tinggwang kerecaki gwatei kelame de ngngwa gwanglu kerane.<verse eid="EZR 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZR 8:18" />Nah anui reuga anui Tinggwang ngaugia kelane, penui anui dage ngngwa gwang beu: makeci kauge Mahli pautsa gade, Levi napei, Israel napei, Sherebiah, nah pe napei nah pe sinamedung 18 de; <verse eid="EZR 8:18" /><verse number="19" style="v" sid="EZR 8:19" />nah Merari pautsa gade Hashabiah nah Jeshaiah de pecu si, pe sinamedung nah penui napeidung ge mina hang 20; <verse eid="EZR 8:19" /><verse number="20" style="v" sid="EZR 8:20" />nah Levime de ngngwa heta tei kera kerecaki kilame gade David nah kedimedung ne kerecaki kilame pwa kepeu mina 220. Penui pelane zi rau pwala.<verse eid="EZR 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 8:21" />Cidau Ih mmwang kera cika Ahava reuki gade mdugai, Tinggwang dwa gade anuikatei henah gwang kerane, pe dade lampui kemzuibe anui ziemne nah anui name ziemne peei kera, nah anui mabamdung pelane ziemne. <verse eid="EZR 8:21" /><verse number="22" style="v" sid="EZR 8:22" />Kedanemene Ih hegwangpei reugwame nah hekwen keteume dade anui lampui ga ketetdau ngauraume dade ngha beulo kie kera nggam di. Kedanemene anui hegwangpei dage marang eh, ranggai, “Anui Tinggwang ba au pecu keyi ziemne peei kelame leune da lala, dede pe kengkieng nah pe rata au pecu püt kedime pelane de renia la.” <verse eid="EZR 8:22" /><verse number="23" style="v" sid="EZR 8:23" />Cine anui mmwang eh anui Tinggwang dade aipau kie de ziemne kiegai, nah pa anui kekie teibeu.<verse eid="EZR 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 8:24" />Cidau Ih cingkume muiteume gade 12 keuntsam lu: Sherebiah, Hashabiah, nah penuide ngngwa eh penui siname gade hangkerei. <verse eid="EZR 8:24" /><verse number="25" style="v" sid="EZR 8:25" />Nah Ih penuide rangkanggeu mdet mpet peudi, nah kecak de, nah lidung, anui Tinggwang kerecaki de ziemne mapeu kepeudung hegwangpei ne, nah pe keledeumedung, pe kedimedung, nah Israelme pelane (ngau kelumedung) de peudi. <verse eid="EZR 8:25" /><verse number="26" style="v" sid="EZR 8:26" />Nah Ih penui ba gage rangkanggeu kikkars 650<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="fq" closed="false">Kikkars 650: </char><char style="ft" closed="false">24 ton kenzwage.</char></note>, lidung rangkanggeu kikkars 100<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="fq" closed="false">Kikkars 100: </char><char style="ft" closed="false">3,400 kilogram kenzwage.</char></note>, kecak kikkars 100 mdet gaibeu, <verse eid="EZR 8:26" /><verse number="27" style="v" sid="EZR 8:27" />nah kecak kwak 20 darics 1,000<note caller="+" style="f"><char style="fr" closed="false">8:27 </char><char style="fq" closed="false">Darics 1,000: </char><char style="ft" closed="false">8.6 kilogram kenzwage.</char></note>, nah hetageu kwak kemdui, pemi kehung kecak nzwa keyi kena. <verse eid="EZR 8:27" /><verse number="28" style="v" sid="EZR 8:28" />Nah Ih penui dage rangdi, “Nang au RAMPAUBE dade mci, nah aipau lidung de mci. Nah rangkanggeu de nah kecak au RAMPAUBE, nnui paume Tinggwang dage mta mapeu ge. <verse eid="EZR 8:28" /><verse number="29" style="v" sid="EZR 8:29" />Cidungde Jerusalem ga, RAMPAUBE ki kibungdung ga nnui cingkume nah Levime muiteumedung nah Israel pautsa peume dwa gage mdet gaibeu kemaktane pierengei teune lu.”<verse eid="EZR 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZR 8:30" />Cine cingkume nah Levime rangkanggeu, nah kecak, nah lidung perüt mdetkelu luu lu, cidungde Jerusalem ga, anui Tinggwang kerecaki ga teugwanglu kerane.<verse eid="EZR 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 8:31" />Pecai anui Ahava reuki gade kei raitu bekei ziangreiekena<note caller="+" style="f"><char style="fr" closed="false">8:31 </char><char style="fq" closed="false">Kei raitu bekei ziangreiekena </char><char style="ft" closed="false">Ndaa Hebrewme gu Lunar tingkum kepei ria gade pei eh liecai, cipau tingba de au Kezing (Apr.) 19 da.</char></note> benai Jerusalem ga mie kera tet mpetlu. Nah anui Tinggwang ba anui reuga la, nah pa ngauraume ba gade anuide kelibeu nah lampui swa kebamme dade. <verse eid="EZR 8:31" /><verse number="32" style="v" sid="EZR 8:32" />Cine anui Jerusalem ga gwanglu, nah cika anui langcum ne bamlu. <verse eid="EZR 8:32" /><verse number="33" style="v" sid="EZR 8:33" />Nah penui Jerusalem ga gwangkelu langmdai ne benai, rangkanggeu nah kecak nah lidung de rüt mdetlu: anui Tinggwang kerecaki gade Uriah napei, Meremoth cingkube ba gage kaibeu di, nah pecu ngngwa kelabe cai Phinehas napei Eleazar, (nah penuide ngngwa kela Levimedung, Jeshua napei Jozabad, nah Binnui napei Noadiah); <verse eid="EZR 8:33" /><verse number="34" style="v" sid="EZR 8:34" />ma pelane pe riak peilu nah perüt teulu. Nah perüt pelane cipau tingdau raukelu teilu.<verse eid="EZR 8:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EZR 8:35" />Pecai hebaangketei gade cailigwang kelume, langgi kedi napeidung, Israel Tinggwang dage keru ratak teilu: Israel pelane ziemne ketumseu 12, hemeuseu 96, meurünnadung 77, nah kemau reca ziemne hemeuseu 12. Ma pelane RAMPAUBE dage keru ratak ge teikelu teilu.<verse eid="EZR 8:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EZR 8:36" />Nah penui hegwangpei ajadung kai kebeude hegwangpei deuceudidung dage nah Euphrates kenlütle deuceudidung dage peudi. Nah penui minadung nah Tinggwang kerecaki de ngha beu.<verse eid="EZR 8:36" /></para>
  <chapter eid="EZR 8" />
  <chapter number="9" style="c" sid="EZR 9" />
  <para style="s">Keleilüt hade ziemne Ezra kekie</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 9:1" />Pecai ma aidungde teicang kelucai, Jewme muiteume a da gwang eh rang, “Israel ga minadung, nah cingkume, nah Levimedung penui katei penuide mina deu gade kai ntsam luma, Canaanme, Hittime, Perizzitme, Jebusme, Ammonme, Moabme, Egyptme, nah Amoritme penui kemneu ketei tadung ria gade. <verse eid="EZR 9:1" /><verse number="2" style="v" sid="EZR 9:2" />Kedanemene penui napuidung kakgade penui nau kera nah penui napeidung nau kera penui luulu, iciu eh penui kemci leuh dede cika lungh kebamme de ngngwa teihera di. Nah muiteume nah kedimedung ne samsang kemak aide gade raitu.” <verse eid="EZR 9:2" /><verse number="3" style="v" sid="EZR 9:3" />Nah Ih makie aide siulu herizi, Ih keregui gahdi eh a paini hietdi. Nah Ih peutam nah a tangkei mai taidi, nah Ih a suisia süt eh ntum bamdi.<note caller="+" style="f"><char style="fr" closed="false">9:3 </char><char style="ft" closed="false">Mat. 26:65, Job 1:20</char></note> <verse eid="EZR 9:3" /><verse number="4" style="v" sid="EZR 9:4" />Nah langgi kedime masanglu kemak ziemne Israel Tinggwang samdung de ziemne ngngi kedime pelane acu twagwa lu. Nah tinghegi reca de tei kemaktane Ih a suisia süt eh ntum bamdi.<verse eid="EZR 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 9:5" />Nah tinghegi ratak tei kedidau, Ih a lung keherei kebam gade cuhlu, nah cidau Ih a paini nah a cwatie hietdi. Nah Ih a pi koktung mie, nah RAMPAUBE a Tinggwang dage a ba hwa gai. <verse eid="EZR 9:5" /><verse number="6" style="v" sid="EZR 9:6" />Nah Ih kekietei, “A Tinggwang, Ih n dage a zu pung ncuh kera ngngam dida, a Tinggwang. Anui mau au anui peu reuga swade hu kedine, nah anui mau tinggimdung ga nghang cang dida.<note caller="-" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="DAN 9:7">Dan. 9:7</ref>,<ref loc="DAN 9:8">8</ref></char></note> <verse eid="EZR 9:6" /><verse number="7" style="v" sid="EZR 9:7" />Anui peime tingdau gade henai tingba kecang anui mau teisüt dida. Nah anui maudung ziemne, anuikatei, anui gwangpeidung, nah anui cingkume de hegwangpeidung deu ba gage, kiengtie ga, hebaang ketei ga, nah tuiteu kedi ga, nah hengam ketei gage pwapeu dida, henai tingba nzwa.<verse eid="EZR 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 9:8" />Dede cu, tingkak ge ziemne, RAMPAUBE anui Tinggwang anuide ngaunggia beuda anui ziemne baangkelume depeu paklu kerane, nah pe kemci ni ga anuide kai ntip beulu kerane, iciu eh anui Tinggwang anui miak teimrak beuda nah hebaang teikela gade anuide kerelui kecam nage peuda. <verse eid="EZR 9:8" /><verse number="9" style="v" sid="EZR 9:9" />Kedanemene anui au Persiame deudi ga hebaangme kecune, dede anuide hebaang gade anui Tinggwang anuide püt dima. Dede pa anui dage samkakkelu masang de Persia gwangpei zu dwade teintie beu anuide kerelui peu kerane, anui Tinggwang kerecaki kwakcuh lu kerane nah sia kedidung de teihemi dailu kerane, nah kensiu herie ge Judah ga nah Jerusalem ga nnuide peu kerane.<verse eid="EZR 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 9:10" />Cine cu, anui Tinggwang, aide cia anui daige ranglu laino? Anui n ajadung gileu daidi kecune,<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="DAN 9:5">Dan. 9:5</ref>,<ref loc="DAN 9:10">10</ref>,<ref loc="DAN 9:11">11</ref></char></note> <verse eid="EZR 9:10" /><verse number="11" style="v" sid="EZR 9:11" />nang caihakecime, n kilamedung ba gade aja kai eh, ranggai, ‘Nnui gum kerane lüt lai eh kebam deude au kehera deu ge cipau deudung ga kelunghme kehera de ziemne, penui kemneu, mcikemak batadung dene tuge lamde kedale kecang cide teipui kedine. <verse eid="EZR 9:11" /><verse number="12" style="v" sid="EZR 9:12" />Cu cine, nnui napui dungde penui napeidung dage peuso, mede penui napuidung de nnui napeidung ziemne luuso, mede nnui penui kezuyi peeiso mede penui mahei kelungtane, ciude nnui ngkieng lu eh nah hangdeu ga ma keyi tyeilu kerane nah nnui napeidung depeu kelungta mabam cide gumlu kerane.’<note caller="+" style="f"><char style="fr" closed="false">9:12 </char><char style="ft" closed="false">Hez. 7:3</char></note><verse eid="EZR 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 9:13" />Dede anui bata kesiadung teikedi nah anui mau kedide ziemne anui reuga kegwang leune caide (nang, anui Tinggwang, anui maudung ziemne swa cam eh anuide saja peu, nah ainzwa eh nang anuide ringkelu pwa peuda), <verse eid="EZR 9:13" /><verse number="14" style="v" sid="EZR 9:14" />anui n ajadung gikah daidi zieni nah mina kemneu ta keteimedung de ngngwa keleilüt daizie ni? Nang tei ngkapdi kemaktane anuide n rata lakni, ciu eh bangkelume mede ring kelume gahdi kera?<verse eid="EZR 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZR 9:15" />RAMPAUBO, Israel Tinggwang, nang au masang, kedanemene anui au henai nzwa, ringkelume ge teibam. Pielo! Anui kemaume ge tei eh n dwaga bam, migede aide ziemne n dwaga sap gailak kecune.”<verse eid="EZR 9:15" /></para>
  <chapter eid="EZR 9" />
  <chapter number="10" style="c" sid="EZR 10" />
  <para style="s">Mina penui mau kepet</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 10:1" />Nah Ezra kekie tei nah pa Tinggwang kerecaki dwade keumie hap eh pe mau petgai herizi, Israel gade hemaa disüt ge, mipei, nah mipui, nah hename Ezra de twagwalu. Nah minadung hapsüt bamdi.<verse eid="EZR 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZR 10:2" />Pecai Elam pautsame ge, Jehiel napei Shekaniah samkeli eh Ezra dage rangdi, “Anuikatei anui Tinggwang dade samsang kemak ta tei dida nah mideu gade sangme Jewme kemakme naudung de luu dida. Dede cu, Israelme ziemne keregui ge bamreu. <verse eid="EZR 10:2" /><verse number="3" style="v" sid="EZR 10:3" />Cine cu, mipui aidungde, nah penui name de langgi di kera anui Tinggwang de ngngwa samkak lugo, a mpaube, nah anui Tinggwang aja de hing kelame ledeu kebeude gade. Nah peu hezaibe gade cide tei lulo. <verse eid="EZR 10:3" /><verse number="4" style="v" sid="EZR 10:4" />Cuhlu, kedanemene aide tei kera n reuga bamlu, nah anui ncu ngngwa sap bam. Kuulu delwe aide teilu.”<verse eid="EZR 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 10:5" />Nah Ezra cuhlu eh cingkume muiteume, Levimedung, nah Israel pelane depeu sam aide nzwa tei zielie kecu samkak ge sampet kera teilu. Cine penui sampet eh samkaklu. <verse eid="EZR 10:5" /><verse number="6" style="v" sid="EZR 10:6" />Nah Ezra cuhlu Tinggwang kerecaki dwade nah pa Eliashib napei Jehohanan kibungdung ga lütdi. Nah pa cika lüt. Pa tangku tyei ma nah pa dui de sak ma, dede langgi kedime cailikegwangme Tinggwang da samsang kemak ziemne pelung keherei eh bamdi.<verse eid="EZR 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 10:7" />Nah penui Judah nah Jerusalem leune ga langgi kedime pelane de Jerusalem ga gwang ngkwa lulo eh sam kaigai. <verse eid="EZR 10:7" /><verse number="8" style="v" sid="EZR 10:8" />Nah muiteumedung nah hangkiamedung rang kebeude nzwa langcumne gage gwanglu kemakme leune de, pe mabam pelane tuiteu dizie. Nah pecu langgi kedime maadi de gade keuntsam dizie.<verse eid="EZR 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 10:9" />Cine Judah nah Benjamin gade mipei pelane langcumne gage Jerusalem ga ngkwalu. Cide kei hekui be kei,<note caller="+" style="f"><char style="fr" closed="false">10:9 </char><char style="fq" closed="false">Kei hekui be kei </char><char style="ft" closed="false">Aipau kei de Kislev dela.</char></note> ziangreiengkai cipau kei.<note caller="+" style="f"><char style="fr" closed="false">10:9 </char><char style="fq" closed="false">Ziangreiengkai cipau kei </char><char style="ft" closed="false">ndaa Hebrewme tingkum kepei ria gade pei cai, Kebam (Dec.) 19 da.</char></note> Nah mina pelane Tinggwang kerecaki sumga ntumlu, aipau kiede ziemne mbeu eh, nah tingruide ziemne.<verse eid="EZR 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 10:10" />Nah Ezra cingkube cuhlu delwe penuida rangdi, “Nnui katei nnui samsang kemak ta tei dida nah sangme Israelme kemakme puide nnui nau tei, Israelme kemaude gage kaisi eh. <verse eid="EZR 10:10" /><verse number="11" style="v" sid="EZR 10:11" />Dede cu, RAMPAUBE de ketwa peulu, nnui peimedung Tinggwang, nah pe lungningbe teilu. Nah hangdeu mina dade nnui katei nnuide keuntsam lu, nah sangme pui dade.”<note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="ft" closed="false">Lev. 20:22-26</char></note><verse eid="EZR 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 10:12" />Pecai kangbau kebam pelane samkeli nah sahbak eh rangdi, “Petau da, N samria gade, anui cinzwa tei luzie. <verse eid="EZR 10:12" /><verse number="13" style="v" sid="EZR 10:13" />Iciuliede, minadung kieesüt bam nah tingrui ting, nah anui hegwale sapbam kera kengkieng gah. Nah heta aide langnai ge mede langna ne gade teilu kebuibe ma, kedanemene anui mina kekiee ge kemau aika tei kecune. <verse eid="EZR 10:13" /><verse number="14" style="v" sid="EZR 10:14" />Peu anui muiteume de kangbau pelane ziemne saplu. Nah anui namdidung ga kelame pelane sangme pui de penau teikelume de peu rangkebeu tingdau gwanglu, nah hangkiame nah tutiakme de namdidung gade penui ngngwa eh, anui Tinggwang rata kesiade anui dade cailigwang kemaktane aipau kiede ziemne gade lie de.”<verse eid="EZR 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZR 10:15" />Asahel napei Jonathan, nah Tikvah napei Jahzeiah rünne aide laklie di. Nah Meshullam nah Shabbethai, Levime, penuide kengha gaibeu. <verse eid="EZR 10:15" /><verse number="16" style="v" sid="EZR 10:16" />Cine langgi kedime aide teilu, nah minadung (penui pautsa peume, penui pautsa ria gade, nah penui pelane de hezidung gade) cingkupei Ezra dage keuntsam gailu. Nah kei kerei bekei raitu benai penui aide peei mpet kera bamlu.<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="ft" closed="false">Heta be kei kerei be kei raitu benai ndeulu, ngkwakelu lang kereine cia. Aide Tebeth bekei, Kebam (Dec.) 29, 485 B.C. dau lubui.</char></note> <verse eid="EZR 10:16" /><verse number="17" style="v" sid="EZR 10:17" />Nah penui mi pelane de ngngwa, sangme puide pe nau kebam dungde, kei raitu bekei raitu benai tutiak teicang lu.<verse eid="EZR 10:17" /></para>
  <para style="s">Keleilüt eh maukedime</para>
  <para style="p">
    <verse number="18" style="v" sid="EZR 10:18" />Nah cingkume napeidung kakgade sangme pui de penau kelume kesa ngaulu; Jeshua pautsa, Jozadak napei, nah pe siname gade: Maaseiah, nah Eliezer, nah Jarib, nah Gedaliah. <verse eid="EZR 10:18" /><verse number="19" style="v" sid="EZR 10:19" />Cine penui penui naudung tadi kera sampetlu, nah penui maudung zimene, meurünhau gade meurünseu gede penui maudung ziemne ratak teikera pwa peudi.<verse eid="EZR 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZR 10:20" />Nah Immer pautsa gade cai Hanani penai Zebadiah.<verse eid="EZR 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 10:21" />Nah Harim pautsa gade cai Maaseiah, nah Elijah, nah Shemaiah, nah Jehiel, nah Uzziah.<verse eid="EZR 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZR 10:22" />Nah Pashhur pautsa gade cai Elioenai, Maaseiah, Ishmael, Nethanel, Jozabad, nah Elasah.<verse eid="EZR 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 10:23" />Nah Levime gade cai Jozabad, nah Shimei, nah Kelaiah (cide, Kelita), Pethahiah, Judah, nah Eliezer.<verse eid="EZR 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 10:24" />Nah leiketeimedung gade cai Eliashib. Nah herieki kekwame gade cai Shallum, nah Telem, nah Uri.<verse eid="EZR 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZR 10:25" />Nah aidungde Israelme kedame gade. Parosh pautsa gade cai Ramiah, nah Izziah, nah Malkijah, nah Mijamin, nah Eleazar, nah Malkijah, nah Benaiah.<note caller="+" style="f"><char style="fq" closed="false">nah Malkijah, nah Benaiah </char><char style="ft" closed="false">mecai </char><char style="fqa" closed="false">nah Hashabiah, nah Benaiah </char><char style="ft" closed="false">(LXX) </char></note><verse eid="EZR 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZR 10:26" />Nah Elam pautsa gade cai Mattaniah, Zechariah, nah Jehiel, nah Abdi, nah Jeremoth, nah Elijah.<verse eid="EZR 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 10:27" />Nah Zattu pautsa gade cai Elioenai, Eliashib, Mattaniah, nah Jeremoth, nah Zabad, nah Aziza.<verse eid="EZR 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZR 10:28" />Nah Bebai pautsa gade cai Jehohanan, Hananiah, Zabbai, nah Athalai.<verse eid="EZR 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EZR 10:29" />Nah Bani pautsa gade cai Meshullam, Malluk, nah Adaiah, Jashub, nah Sheal, nah Jeremoth.<note caller="+" style="f"><char style="fq" closed="false">Bani </char><char style="ft" closed="false">mecai </char><char style="fqa" closed="false">Binnui </char><char style="ft" closed="false">(LXX)</char></note><verse eid="EZR 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZR 10:30" />Nah Pahath-Moab pautsa gade cai Adna, nah Kelal, Benaiah, Maaseiah, Mattaniah, Bezalel, nah Binnui, nah Manasseh.<verse eid="EZR 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 10:31" />Nah Harim pautsa gade cai Eliezer, Ishijah, Malkijah, Shemaiah, Shimeon, <verse eid="EZR 10:31" /><verse number="32" style="v" sid="EZR 10:32" />Benjamin, Malluk, nah Shemariah.<verse eid="EZR 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EZR 10:33" />Hashum pautsa gade cai Mattenai, Mattattah, Zabad, Eliphelet, Jeremai, Manasseh, nah Shimei.<verse eid="EZR 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="EZR 10:34" />Bani pautsa gade cai Maadai, Amram, nah Uel, <verse eid="EZR 10:34" /><verse number="35" style="v" sid="EZR 10:35" />Benaiah, Bedeiah, Keluhi, <verse eid="EZR 10:35" /><verse number="36" style="v" sid="EZR 10:36" />Vaniah, Meremoth, Eliashib, <verse eid="EZR 10:36" /><verse number="37" style="v" sid="EZR 10:37" />Mattaniah, Mattenai, nah Jaasu, <verse eid="EZR 10:37" /><verse number="38" style="v" sid="EZR 10:38" />nah Bani, nah Binnui, nah Shimei,<verse eid="EZR 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="EZR 10:39" />nah Shelemiah, nah Nathan, nah Adaiah, <verse eid="EZR 10:39" /><verse number="40" style="v" sid="EZR 10:40" />Maknadebai, Shashai, Sharai, <verse eid="EZR 10:40" /><verse number="41" style="v" sid="EZR 10:41" />Azarel, nah Shelemiah, Shemariah, <verse eid="EZR 10:41" /><verse number="42" style="v" sid="EZR 10:42" />Shallum, Amariah, nah Joseph.<verse eid="EZR 10:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="EZR 10:43" />Nah Nebo pautsa gade cai Jeiel, Mattithiah, Zabad, Zebina, Jaddai, nah Joel, nah Benaiah.<verse eid="EZR 10:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="EZR 10:44" />Aidungde pelane sangme puidung de penui nau teilu. Nah penui kakga mipuidung bam, nah penui mipeinadung mna beu.<note caller="+" style="f"><char style="fq" closed="false">Nah penui kakga mipuidung bam, nah penui mipeinadung mna beu. </char><char style="ft" closed="false">mecai </char><char style="fqa" closed="false">Nah penui penuide penui napeidung de si eh lang gidi </char></note><verse eid="EZR 10:44" /></para>
  <chapter eid="EZR 10" />
</usx>