<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Zeme(N) Bible Project</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Joel</para>
  <para style="toc1">Joel Laisiukwak</para>
  <para style="toc2">Joel</para>
  <para style="toc3">Joe.</para>
  <para style="mt">Joel</para>
  <para style="mt">Joel Laisiukwak</para>
  <para style="is">Mraisam</para>
  <para style="ip">Joel zi au Samkak Kehegwabe ga bamsüt liede, laisiukwak aika rangnswa kelade gwale caihakecibe aipaude ha magede ci ma-pa au Pethuel napei.</para>
  <para style="ip">Laisiukwak aika Joel au tangrim ne Palestine teikengkap siasüt kecu ge ha rau süt kegai tei. Aikade pa tutiak kebambe rehi ge ngau nah minadung de Tinggwang de nreugwang lulo mraisam ranggai. Joel au “Rampaube tingba” gwangla delie ranggai nah tutiak diki kecuge teugwang laibam lie recigai.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Tangrim Gwakelüt ge (1:1-12)</para>
  <para style="io1">Helungkenreu Qukegai ge (1:13-20)</para>
  <para style="io1">Mrairangkegai nah Tinggwang Sampet (2:1-32)</para>
  <para style="io1">Tinggwang tutiak kekambe nah pe kedi (3:1-21)</para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="s">Tangrim Gwakelüt ge</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />Aide RAMPAUBE sam, Pethuel napei Caihakecibe Joel da kegwangbe.<verse eid="JOL 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 1:2" />Aide siulu, nnui hangkiamedung,</para>
  <para style="q" vid="JOL 1:2">nah kingneilu, nnui Judea deudi ga lungh kebam pelane.</para>
  <para style="q" vid="JOL 1:2">Ai kenzwa madaude nnui tingdau</para>
  <para style="q" vid="JOL 1:2">mede nnui paume tingdau tei deni?<verse eid="JOL 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 1:3" />Cide n namedung da rangbeu,</para>
  <para style="q" vid="JOL 1:3">nah n namedung penui namedung dage,</para>
  <para style="q" vid="JOL 1:3">nah penui namedung pecai ceheu dage.<verse eid="JOL 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 1:4" />Dang kela tangriem ne püt kedidung de tangrim maadi nlai kela maa ne tyeilu;</para>
  <para style="q" vid="JOL 1:4">tangrim maadi nlai kela maa püt kedibe nsau eh tet kela tangriem maa ne tyeilu,</para>
  <para style="q" vid="JOL 1:4">nah nsau eh tet kela tangrim maa ne püt kedibe mateikemsia tangrim ne tyeilu.<verse eid="JOL 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 1:5" />Cuhlu, nnui zau sak kaudung, nah haplu!</para>
  <para style="q" vid="JOL 1:5">Hei eh haplu, nnui pelane zau kesak medung,</para>
  <para style="q" vid="JOL 1:5">kedanemene zau kekum de nnui mui gade dang mpet dida.<verse eid="JOL 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 1:6" />Adeu ga heleuh ge ncu renia kera ncuh lwe bam dida,</para>
  <para style="q" vid="JOL 1:6">ngkieng nah pei kap gai kelak.</para>
  <para style="q" vid="JOL 1:6">Penui geidung au hingho gei nzwa,</para>
  <para style="q" vid="JOL 1:6">nah hinghopui geidung nzwa nzau.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="REV 9:7-10">Keu. 9:7-10</ref></char></note><verse eid="JOL 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 1:7" />Agu kubeluh teingkap dida</para>
  <para style="q" vid="JOL 1:7">nah agu nzüt bangdung ria dida.</para>
  <para style="q" vid="JOL 1:7">Pegeu gau lu nah kelien gi dida;</para>
  <para style="q" vid="JOL 1:7">pe tsingkiakdung gau ha dida.<verse eid="JOL 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 1:8" />Haplu relei kemci pui rosopai bah lwe pa pe nahpei lai eh kebam ge tsit heei kecu nzwa.<verse eid="JOL 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 1:9" />Meiciu reca nah sak kera reca de RAMPAUBE ki gade dang gi dida.</para>
  <para style="q" vid="JOL 1:9">Cingkumedung, RAMPAUBE kilamedung, hap bam dida.<verse eid="JOL 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 1:10" />Luhdung au mrwa dida,</para>
  <para style="q" vid="JOL 1:10">hangdeu be hap bam dida kedanemene mei ciu tei msia kedine.</para>
  <para style="q" vid="JOL 1:10">Zau kehecibe dung cangh dida,</para>
  <para style="q" vid="JOL 1:10">macadung lwa ta dida.<verse eid="JOL 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 1:11" />Ngam lu, nnui heta ketamedung,</para>
  <para style="q" vid="JOL 1:11">nah haplu, nnui kube gurie kwa kelamedung,</para>
  <para style="q" vid="JOL 1:11">wheat nah barley ziemne.</para>
  <para style="q" vid="JOL 1:11">Kedanemene luhlüt kera luh ngkap di delu.<verse eid="JOL 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 1:12" />Kubetsi bangdung hui dida nah nzüt bangdung cangh dida,</para>
  <para style="q" vid="JOL 1:12">kuraletsi bangdung, palm bangdung nah tampaktsi bangdung,</para>
  <para style="q" vid="JOL 1:12">luh ga tsingbang kebam pelane hui di.</para>
  <para style="q" vid="JOL 1:12">Mina namedung dade suiyibe hui kedi ziemne.<verse eid="JOL 1:12" /></para>
  <para style="s">Helungkemreu Qukegai ge</para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 1:13" />Rosopai bah lwe haplu, nnui cingkumedung!</para>
  <para style="q" vid="JOL 1:13">Recabam kwa kebam kilamedung, haplu.</para>
  <para style="q" vid="JOL 1:13">Gwanglu, tingmuiziu pelane hei eh hap eh rosopai bahlu, nnui a Tinggwang kilamedung.</para>
  <para style="q" vid="JOL 1:13">Kedanemene ciu mapeu nah sak kera mapeudung de nnui Tinggwang ki gage kai nzeu dida.<verse eid="JOL 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 1:14" />Kemci mmwang kera qulu,</para>
  <para style="q" vid="JOL 1:14">nah kemci hemaa ge qulu.</para>
  <para style="q" vid="JOL 1:14">Hangkiamedung nah cipau deu ga kebam heleuh pelane</para>
  <para style="q" vid="JOL 1:14">RAMPAUBE nnui Tinggwang ki ga hekwa lu,</para>
  <para style="q" vid="JOL 1:14">nah RAMPAUBE dage hap gailu.<verse eid="JOL 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 1:15" />RAMPAUBE tingba au gwang nna bam kedine.</para>
  <para style="q" vid="JOL 1:15">Ngkiengtube Tinggwang kekap teugwang gai kera tingba.</para>
  <para style="q" vid="JOL 1:15">Cipaunai kehing daikenzwa ge teugwang gai zieno!<verse eid="JOL 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 1:16" />Taktyei anui miak dwa gade keu mpet ti meni?</para>
  <para style="q" vid="JOL 1:16">nah suiyi anui Tinggwang ki gade?<verse eid="JOL 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 1:17" />Heleuhdung hangdeu ga ki bam dida,</para>
  <para style="q" vid="JOL 1:17">mei hekwa ki mrwa dida,</para>
  <para style="q" vid="JOL 1:17">nah baudung de kau dida,</para>
  <para style="q" vid="JOL 1:17">kedanemene ciu cangh kedine.<verse eid="JOL 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 1:18" />Makaunedung dainzwa mrung bam bie!</para>
  <para style="q" vid="JOL 1:18">Kauruine haudung dainzwa zie bi cimene bam dida</para>
  <para style="q" vid="JOL 1:18">penui tsehei gah kedine.</para>
  <para style="q" vid="JOL 1:18">Nah meurün haudung de keherei bam dida.<verse eid="JOL 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 1:19" />RAMPAUBO, Ih n dage hap gaila.</para>
  <para style="q" vid="JOL 1:19">Kedanemene mi le tsehei deu hetaideudung tyei nggah dida,</para>
  <para style="q" vid="JOL 1:19">nah miheu le luh ga tsingbang pelane ru dida.<verse eid="JOL 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 1:20" />Luh ga makaunedung de n dage mra gai bam dida,</para>
  <para style="q" vid="JOL 1:20">kedanemene hereukidung cangh kedine,</para>
  <para style="q" vid="JOL 1:20">nah mi le hetaideu tseheidung tyei nggah dida.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s">Tangrim Reugwamaa ge</para>
  <para style="q">
    <verse number="1" style="v" sid="JOL 2:1" />Zion ga telui kwa gai,</para>
  <para style="q" vid="JOL 2:1">nah a kemci lamlwatu gade makwa tei mra gaibeu!</para>
  <para style="q" vid="JOL 2:1">Hangdeu ga lungh kebam pelane de peu hing eh mbeu gai,</para>
  <para style="q" vid="JOL 2:1">kedanemene RAMPAUBE tingbazie gwang la dida;</para>
  <para style="q" vid="JOL 2:1">kesang, nna dida.<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">Jerusalem</char></note><verse eid="JOL 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 2:2" />Cide mui nah misuikesia tingba ge zie,</para>
  <para style="q" vid="JOL 2:2">hemwa mau nah muiting kecu tingba ge.</para>
  <para style="q" vid="JOL 2:2">Lamlwatudung ga kemui zang kedi nzwa,</para>
  <para style="q" vid="JOL 2:2">mi kekiee ge nah kengkieng minadung,</para>
  <para style="q" vid="JOL 2:2">madau ge de cinzwa kemak,</para>
  <para style="q" vid="JOL 2:2">nah madau de cinzwa dai lak,</para>
  <para style="q" vid="JOL 2:2">ceheu kekiee ge cai de.<note caller="-" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="MAT 24:21">Mat. 24:21</ref></char></note><verse eid="JOL 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 2:3" />Mi ne pedwa gade tyei nggah di au da,</para>
  <para style="q" vid="JOL 2:3">nah pecai ga miheu heu bam dida.</para>
  <para style="q" vid="JOL 2:3">Hangdeu cide pedwa gade au Eden gurie nzwa hezuyi,</para>
  <para style="q" vid="JOL 2:3">dede pecai gade au teimsia kedi hetaideu ge.</para>
  <para style="q" vid="JOL 2:3">Kesang, magede cika de pak di gai lak.<verse eid="JOL 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 2:4" />Penuide ngau kegai dau hekwendung nzwa,</para>
  <para style="q" vid="JOL 2:4">nah penui hereu kwendung nzwa pakla.<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="REV 9:7">Keu. 9:7</ref></char></note><verse eid="JOL 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 2:5" />Penui lamlwatudung reuga nsau hang gai ge,</para>
  <para style="q" vid="JOL 2:5">penui hekwen bagidung kwa nzwa di, tsehei kekibe heu kecu nzwa pet,</para>
  <para style="q" vid="JOL 2:5">mina kedi ge hereu tei kera mtei kelu de nzwa.<note caller="-" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="REV 9:9">Keu. 9:9</ref></char></note><verse eid="JOL 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 2:6" />Penui kebam dau minadung de keheu di</para>
  <para style="q" vid="JOL 2:6">nah penui zu de hamhui di.<verse eid="JOL 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 2:7" />Penui kengkieng reugwame nzwa pak la;</para>
  <para style="q" vid="JOL 2:7">penui reugwame nzwa tangdeu nra la;</para>
  <para style="q" vid="JOL 2:7">penui tet la nah penui pikiet ket ga nsamram eh,</para>
  <para style="q" vid="JOL 2:7">nah lampui gade penui tet tei nli di lama.<verse eid="JOL 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 2:8" />Mede hang gege dede keda lam nia gai di lama;</para>
  <para style="q" vid="JOL 2:8">penui penuikatei lampui ga tet la;</para>
  <para style="q" vid="JOL 2:8">penui hereu net reu dung gade tet lubui dede</para>
  <para style="q" vid="JOL 2:8">penui pikiet maudi lama.<verse eid="JOL 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 2:9" />Penui namdi ga gwaketang lüt,</para>
  <para style="q" vid="JOL 2:9">penui namdi tangdeu ga pak,</para>
  <para style="q" vid="JOL 2:9">penui kidung ga nra hang,</para>
  <para style="q" vid="JOL 2:9">penui keregamedung nzwa hebakidung gade lüt.<verse eid="JOL 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 2:10" />Kideube penui dwa gade ncui di,</para>
  <para style="q" vid="JOL 2:10">ting mbeu di,</para>
  <para style="q" vid="JOL 2:10">tingnaimiak nah hekei muidi, nah hegidung baa si tadi.<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">Mat. 24:29, Mark. 13:24-25, Keu. 6:12-13, 8:12, 9:2</char></note><verse eid="JOL 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 2:11" />RAMPAUBE pe reugwame dwa gade pe kwa ncuh gai,</para>
  <para style="q" vid="JOL 2:11">pe reugwamedung kiee zu kedine;</para>
  <para style="q" vid="JOL 2:11">kedanemene pe sam kemzai, maadung de ngkieng.</para>
  <para style="q" vid="JOL 2:11">Kedanemene RAMPAUBE tingba au di nah ngaukehing tingba.</para>
  <para style="q" vid="JOL 2:11">Cauge cikade ringlu lai?<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="REV 6:17">Keu. 6:17</ref></char></note><verse eid="JOL 2:11" /></para>
  <para style="s">Nnui Nlung Pangpop gailu</para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 2:12" />RAMPAUBE rang ndugai “Dede cude,”</para>
  <para style="q" vid="JOL 2:12">“Nnui mlung pelane teu ada gwanglu.</para>
  <para style="q" vid="JOL 2:12">Mmwang, hap nah heei eh.”<verse eid="JOL 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 2:13" />Nnui mlung teurak di nnui pai ni katei rünne mene,</para>
  <para style="q" vid="JOL 2:13">nah RAMPAUBE nnui Tinggwang da cailigwang lu.</para>
  <para style="q" vid="JOL 2:13">Kedanemene pa au pezai yi nah ngaugia le puilu,</para>
  <para style="q" vid="JOL 2:13">pa au perata mneu la nah pe samkak kainzeu la,</para>
  <para style="q" vid="JOL 2:13">nah pa saja peu kera zette lama.<verse eid="JOL 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 2:14" />Cau ne ci? Pa nreu gwang nnui da ngaugia bam lubui,</para>
  <para style="q" vid="JOL 2:14">nah pecai ga samlam kai nzeu lu,</para>
  <para style="q" vid="JOL 2:14">ciu mapeu nah sak kera mapeu RAMPAUBE nnui Tinggwang ziemne?<verse eid="JOL 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 2:15" />Zion gade telui kwa gailo,</para>
  <para style="q" vid="JOL 2:15">kemci mmwang kera qulu,</para>
  <para style="q" vid="JOL 2:15">nah kemci hemaa ge qulu.<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">Jerusalem</char></note><verse eid="JOL 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 2:16" />Mina dung de qulu,</para>
  <para style="q" vid="JOL 2:16">kemci hekwa kera ziemne qulu.</para>
  <para style="q" vid="JOL 2:16">Hecingmedung de hekwa lu,</para>
  <para style="q" vid="JOL 2:16">henamedung de hekwa lu</para>
  <para style="q" vid="JOL 2:16">nah ngienadung de.</para>
  <para style="q" vid="JOL 2:16">Lakciubepeidung de pe kibungdung gade mpet maisia</para>
  <para style="q" vid="JOL 2:16">nah lakciube pui de hemeu ketei bam gade mpet maisia.<verse eid="JOL 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 2:17" />Peu cingkumedung, RAMPAUBE kilamedung de</para>
  <para style="q" vid="JOL 2:17">recabam penai kimuiki kak ga haplu.</para>
  <para style="q" vid="JOL 2:17">Peu penuide kielu, “N minadung de ngaunggia gailo, RAMPAUBO,</para>
  <para style="q" vid="JOL 2:17">nah n magumdung de peu keu henui tei di helo,</para>
  <para style="q" vid="JOL 2:17">heleuhdung ne mneu nah kii di melu kerane.</para>
  <para style="q" vid="JOL 2:17">Daitei penui heleuhdung kakga</para>
  <para style="q" vid="JOL 2:17">‘Penui Tinggwang daiga lano?’” de eh ranglai.<verse eid="JOL 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 2:18" />Pecai RAMPAUBE pe leuhme ziemne pelung nei di</para>
  <para style="q" vid="JOL 2:18">nah pe minadung de ngaunggia di.<verse eid="JOL 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 2:19" />RAMPAUBE pesam keli nah pe minadung da rang,</para>
  <para style="q" vid="JOL 2:19">“Pielo, Ih nnuide ciu lang beu zie, zau keheci, nah maca.</para>
  <para style="q" vid="JOL 2:19">Nnui cidung le mnung dizie,</para>
  <para style="q" vid="JOL 2:19">nah peu ge heleuh kedadung nnuide nneu si lak.<verse eid="JOL 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 2:20" />Ih tingtünle de kegwang reugwamedung de nnui dade keu mdei di beu zie,</para>
  <para style="q" vid="JOL 2:20">nah penuide Ih deucang nah mi lung kemak deu ga teu gai dizie,</para>
  <para style="q" vid="JOL 2:20">penui dwa le tingnaimiak kepetle jaaidi ga,</para>
  <para style="q" vid="JOL 2:20">nah pecai maa de tingnaimiak kenlüt jaaidi ga.</para>
  <para style="q" vid="JOL 2:20">Penui tim nnam cuh dizie,</para>
  <para style="q" vid="JOL 2:20">nah cipau rim nnam kesia de cuh dizie.”</para>
  <para style="q2" vid="JOL 2:20">Kesang, Rampaube ma kedidung tei gai da.<verse eid="JOL 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOL 2:21" />Ngngi di so, O hangdeu, nsuiyi nah renga lu,</para>
  <para style="q" vid="JOL 2:21">kedanemene RAMPAUBE au makedi tei zielu.<verse eid="JOL 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOL 2:22" />Ngngi di so, nnui luh kaunedung,</para>
  <para style="q" vid="JOL 2:22">hetaideu ga tsehei deu dung pwak cuh luzie,</para>
  <para style="q" vid="JOL 2:22">tsingbangdung petsi kei zie, nah nzüttsi bang</para>
  <para style="q" vid="JOL 2:22">nah kubetsi bangdung kepui ngau lubui.<verse eid="JOL 2:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOL 2:23" />Nnui sui yilu, O Zion namedung,</para>
  <para style="q" vid="JOL 2:23">nah nnui sui yilu RAMPAUBE nnui Tinggwang gade. Pa nnui de herei tingrui petau ge peu da, nda nzwa pa nnuide herei tingrui nah heriak tingrui de pwapeu zie.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="HAB 3:18">Hab. 3:18</ref></char></note><verse eid="JOL 2:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOL 2:24" />Hecaipung ga tsiu le pui dizie,</para>
  <para style="q" vid="JOL 2:24">nah zau keheci nah macadung le pebung pui nlim dizie.<verse eid="JOL 2:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOL 2:25" />“Ih nnuide tangriemdung ne nnui mei tyei nggah kedidung de peu caili dai beuzie,</para>
  <para style="q" vid="JOL 2:25">nsau kela tangriem, nah matei msia kela tangriem nah ma dang kela tangriem,</para>
  <para style="q" vid="JOL 2:25">Ih ne reugwame kedi nnui kakga lang kegai de.<verse eid="JOL 2:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOL 2:26" />Nang kekieege tyei nah pui nlim luzie,</para>
  <para style="q" vid="JOL 2:26">nah RAMPAUBE nnui Tinggwang zi twa zie,</para>
  <para style="q" vid="JOL 2:26">nnui kakga mimakecang bata tei kegaibe de,</para>
  <para style="q" vid="JOL 2:26">nah madau de a minadung de kengngam gage kaidai dilak.<verse eid="JOL 2:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOL 2:27" />Nang cilu zie Ih Israel me kakga la lie kecu,</para>
  <para style="q" vid="JOL 2:27">nah Ih RAMPAUBE nnui Tinggwang,</para>
  <para style="q" vid="JOL 2:27">nah keda gah lie kecu,</para>
  <para style="q" vid="JOL 2:27">nah madau gede a minadung de kengngam gage kaidai dilak.<verse eid="JOL 2:27" /></para>
  <para style="s">Rampaube Tingba</para>
  <para style="q">
    <verse number="28" style="v" sid="JOL 2:28" />Aipaucai ainzwa gwang zie,</para>
  <para style="q" vid="JOL 2:28">Ih mina pumteih leune ga a Rabe rui gai zie,</para>
  <para style="q" vid="JOL 2:28">nah nnui napeidung nah nnui napuidung caiha rangzie.</para>
  <para style="q" vid="JOL 2:28">Nnui mina hangkiame hemang mmi zie,</para>
  <para style="q" vid="JOL 2:28">nnui rehangme ma rengei ngau zie.<note caller="+" style="f"><char style="fr" closed="false">2:28 </char><char style="ft" closed="false">Bat. 2;17-21, Tit. 3:6</char></note><verse eid="JOL 2:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOL 2:29" />Kilamepei nah kilamepei dung da dede,</para>
  <para style="q" vid="JOL 2:29">cipau tingdau Ih a Rabe rui gai zie.<verse eid="JOL 2:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOL 2:30" />Ih tingkam nah kideu ga miswakega tei lia zie,</para>
  <para style="q" vid="JOL 2:30">hejai, mi, nah mika gu heciadung.<note caller="+" style="f"><char style="fr" closed="false">2:30 </char><char style="ft" closed="false">Luk. 21:25, Keu. 8:7</char></note><verse eid="JOL 2:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOL 2:31" />Tingnaimiak mui nlüt dizie</para>
  <para style="q" vid="JOL 2:31">nah hekei hejai nzwa dizie,</para>
  <para style="q" vid="JOL 2:31">RAMPAUBE tingba kedi nah kengngi de kegwang dwa.<verse eid="JOL 2:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOL 2:32" />Ciu eh RAMPAUBE dade kengha kie kelube de kelibeu zie.</para>
  <para style="q" vid="JOL 2:32">Mount Zion nah Jerusalem ga midung ge mbai luzie kecune,</para>
  <para style="q" vid="JOL 2:32">RAMPAUBE kerang de nzwa,</para>
  <para style="q" vid="JOL 2:32">nah ring kelume kak de</para>
  <para style="q" vid="JOL 2:32">RAMPAUBE ne qu kelume.<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s">Heleuhdung Tuketiak</para>
  <para style="q">
    <verse number="1" style="v" sid="JOL 3:1" />Ainie, RAMPAUBE rang eh, cipau tingbadung nah cipau tingdau,</para>
  <para style="q" vid="JOL 3:1">Ih Judah nah Jerusalem ga lungh keyi peudai zie.<verse eid="JOL 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 3:2" />Ih heleuhdung pelane hekwa zie,</para>
  <para style="q" vid="JOL 3:2">nah penuide Jehoshaphat gu Langkam ga ngngwa gwang luzie.<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">Tutiak cabak</char></note></para>
  <para style="q" vid="JOL 3:2">Ih cikade penui tutiak zie,</para>
  <para style="q" vid="JOL 3:2">a minadung ziemne nah agu gum kera Israel ziemne,</para>
  <para style="q" vid="JOL 3:2">heleuhdung kakga ge teizang kegai medung,</para>
  <para style="q" vid="JOL 3:2">nah penui a deudi, Israel mzi kedine.<verse eid="JOL 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 3:3" />Penui a minadung ziemne dacak tei,</para>
  <para style="q" vid="JOL 3:3">mipeina ge heli li kerane zwadi,</para>
  <para style="q" vid="JOL 3:3">nah mipuina de zau ziemne zwadi</para>
  <para style="q" vid="JOL 3:3">iciu eh penui saklu kerane.<verse eid="JOL 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 3:4" />Cu, nnui dai ziemne acu renia lano,</para>
  <para style="q" vid="JOL 3:4">Tyre, Sidon nah Philistia cuikuidung pelane?</para>
  <para style="q" vid="JOL 3:4">Nnui ma dung ge ziemne apau rui dai kera tei bam ni?</para>
  <para style="q" vid="JOL 3:4">Magade nnui apau rui dai kera tei bam cai,</para>
  <para style="q" vid="JOL 3:4">Ih zette nnui tei kegai dene saja nnui peu gage teu caili gwang dai beu zie.<verse eid="JOL 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 3:5" />Kedanemene nnui a rangkanggeu nah agu kecak keu pwa dida</para>
  <para style="q" vid="JOL 3:5">nah nnui agu pemi kehung mabamdung nnui gu kereca kidung gage teu gwang luda.<verse eid="JOL 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 3:6" />Nnui Judah napeidung nah Jerusalem napeidung de Greekmedung dage zwa dida,</para>
  <para style="q" vid="JOL 3:6">ci nzwa eh penui peu penui deu gade kemdei gage ngngwa gai lu kerane.<verse eid="JOL 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 3:7" />Pielo, Ih penuide kelungh mpet gaizie da, nnui ne penuide zwa kebeu bam gade,</para>
  <para style="q" vid="JOL 3:7">nah nnui rui kegai de nnuikatei nnui peu ga teu cailigwang beu zie.<verse eid="JOL 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 3:8" />Ih nnui napeidung nah nnui napuidung de</para>
  <para style="q" vid="JOL 3:8">Judah namedung dage zwa beu zie.</para>
  <para style="q" vid="JOL 3:8">Penui Arabianme helila keteime dage zwa beuzie,</para>
  <para style="q" vid="JOL 3:8">kemdei ga kebam leuh dage,</para>
  <para style="q" vid="JOL 3:8">kedanemene RAMPAUBE ne rang beu dida lu.<verse eid="JOL 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 3:9" />Aide heleuhdung dage kereci gai beulo,</para>
  <para style="q" vid="JOL 3:9">“Nnui hereu tei kera mteilu,</para>
  <para style="q" vid="JOL 3:9">kengkieng minadung de kelung gai cu,</para>
  <para style="q" vid="JOL 3:9">peu penuide gwang nna lu,</para>
  <para style="q" vid="JOL 3:9">peu reugwame pelane de hang lu.<verse eid="JOL 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 3:10" />Nnui hepeidung kingtiedung gage reki lu</para>
  <para style="q" vid="JOL 3:10">nah tsingsu kiedung hengei gage reki lu.</para>
  <para style="q" vid="JOL 3:10">Peu kemnei mede</para>
  <para style="q" vid="JOL 3:10">‘Ih au ngking,’ de eh ranglu.<verse eid="JOL 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 3:11" />Kelwalu nah gwanglu,</para>
  <para style="q" vid="JOL 3:11">twagwa kebam heleuhdung pelane,</para>
  <para style="q" vid="JOL 3:11">cika nnui gwang hekwa lu.</para>
  <para style="q" vid="JOL 3:11">O RAMPAUBO, ngu kengkieng reugwamedung de ngngwa hunglu.<verse eid="JOL 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 3:12" />Peu heleuhdung de penuikatei nkia nrak lu</para>
  <para style="q" vid="JOL 3:12">nah Jehoshaphat Langkam ga hanglu.<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">Tutiak cabak</char></note></para>
  <para style="q" vid="JOL 3:12">Kedanemene cika Ih ntum lwe twagwa kebam</para>
  <para style="q" vid="JOL 3:12">heleuhdung leune tutiak zie.<verse eid="JOL 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 3:13" />Tangkane le rum cu,</para>
  <para style="q" vid="JOL 3:13">kedanemene luh be meu dida.</para>
  <para style="q" vid="JOL 3:13">Gwanglu, delwe kubetsidung riak kecai gai cu,</para>
  <para style="q" vid="JOL 3:13">kedanemene zauniakbam pui bam dida.</para>
  <para style="q" vid="JOL 3:13">Zau kendwa bung dung pui nlim bam dida,</para>
  <para style="q" vid="JOL 3:13">kedanemene penui kesia de kie ham kedine.”<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Mrk. 4:29, Keu. 14:15-18</char></note><verse eid="JOL 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 3:14" />Mina cangcang Tutiak Langkam ga bam.</para>
  <para style="q" vid="JOL 3:14">Kedanemene RAMPAUBE Tutiak tingba Langkam ga nna bam kedine.<verse eid="JOL 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 3:15" />Tingnaimiak nah hekei mui dizie,</para>
  <para style="q" vid="JOL 3:15">hegidung baa sita dizie.<verse eid="JOL 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 3:16" />RAMPAUBE Zion gade mrung zie,</para>
  <para style="q" vid="JOL 3:16">nah Jerusalem gade pekwa sahbak gai zie.</para>
  <para style="q" vid="JOL 3:16">Tinggimdung nah kideube mbeu dizie,</para>
  <para style="q" vid="JOL 3:16">dede RAMPAUBE au pe minadung ziemne kensiu be zie,</para>
  <para style="q" vid="JOL 3:16">nah Israel namedung ziemne kengkiengbam ge zie.<verse eid="JOL 3:16" /></para>
  <para style="s">Tinggwang Minadung ziemne Samlamdung</para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 3:17" />Cine Ih RAMPAUBE nnui Tinggwang,</para>
  <para style="q" vid="JOL 3:17">Zion deutu nah lamlwatu kemci, ga kelungbe lie kecu ci luzie.</para>
  <para style="q" vid="JOL 3:17">Iciu lude Jerusalem namdi mci luzie,</para>
  <para style="q" vid="JOL 3:17">nah cikemakmedung migede cika tetkah si lak.<verse eid="JOL 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 3:18" />Cipau tingba gwang kelu benai</para>
  <para style="q" vid="JOL 3:18">lamlwadung ga zau kekumbe le zau hua zie,</para>
  <para style="q" vid="JOL 3:18">nah lamlwatudung gade tungdui lwa zie,</para>
  <para style="q" vid="JOL 3:18">Judah reukidung pelane gade dui lwa dizie,</para>
  <para style="q" vid="JOL 3:18">nah RAMPAUBE ki gade duilet ge pet dizie,</para>
  <para style="q" vid="JOL 3:18">Shittim Langkam de dui peuzie.<verse eid="JOL 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 3:19" />Egypt au gikedi deu ngkap kedi ge dizie,</para>
  <para style="q" vid="JOL 3:19">nah Edom au gikedi hetaideu ge dizie,</para>
  <para style="q" vid="JOL 3:19">kedanemene Judah namedung dage keherei ta tei kegai ne,</para>
  <para style="q" vid="JOL 3:19">kedanemene penui kemzuime de penui deu gade tei tset kedine.<verse eid="JOL 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 3:20" />Dede Judah au lungh lamui dizie,</para>
  <para style="q" vid="JOL 3:20">nah Jerusalem au ceheu ramsang la dizie.<verse eid="JOL 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOL 3:21" />Penuide teitset kedi kum peeilu kemak de Ih ne peei zie,</para>
  <para style="q" vid="JOL 3:21">kedanemene RAMPAUBE au Zion deutu ga lunghla.<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>