<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EST" style="id">- Zeme(N) Bible Project</book>
  <para style="ide">UTF-8</para>
  <para style="h">Esther</para>
  <para style="toc3">Est.</para>
  <para style="toc2">Esther</para>
  <para style="toc1">Esther Laisiukwak</para>
  <para style="mt1">Esther</para>
  <para style="mt1">Esther Laisiukwak</para>
  <para style="is">Mraisam</para>
  <para style="ip">Esther laisiukwak de Susa, Persiame namdi, Xerxes tingdau, pa Persia reu kedi 486-465 BC dau ha ge. Laisiukwak de Jewme relei hezukeyi Hegwangpei Xerxes pe hegwangpui tei kera kedet kelu ha ge. Haman Jewme pelane de daptset di kera riem kecudau, Hegwangpui Esther sinabe Mordecai au Esther de pe minadung de keli lulo eh rang kecu. Kerehim gage pe teilung kai eh, pa hegwangpei dede rangbi eh Jewme de kelilu.</para>
  <para style="ip">Tinggwang zi laisiukwak aika bam meliede, pa pe minadung kedetkelume mapie kela au lia mcigi gai. Jewme de kelikelu ha misuikeyi de mmi ramsang Purim Ngyi dau mneila, cidau Esther laisiukwak de pei bak de gaila.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Esther de hegwangpui Teikelu (1:1-2:23)</para>
  <para style="io1">Jewme de ngkapdi kera Haman ciem (3:1-5:14)</para>
  <para style="io1">Jewme ngkiengkelu (6:1-10:3)</para>
  <chapter number="1" style="c" sid="EST 1" />
  <para style="s">Hegwangpui Vashti de keugikedi</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 1:1" />Cu Ahasuerus tingdau (pa au Ahasuerus, India gade Cush<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">Cush: </char><char style="ft" closed="false">Ethiopia.</char></note> ga kecang, 127 deuceudung reu hegwang keteibe pei); <verse eid="EST 1:1" /><verse number="2" style="v" sid="EST 1:2" />cipau tingdau, hegwangpei Ahasuerus pe kengkieng hegwangbam ga kebam dau, cide Susa kuda ga: <verse eid="EST 1:2" /><verse number="3" style="v" sid="EST 1:3" />pa hegwang tei kelu mmi pe kecum bekum, pe kangga kedime nah kerengeime pelane ziemne pa taktyei ngyi kedi mteigai beu, Persia nah Media reugwame, makecime, nah deuceu ga kedimedung pe dwaga gwang bam, <verse eid="EST 1:3" /><verse number="4" style="v" sid="EST 1:4" />cidau pa pe hegwangram mahei kemdu nah pe kedi hezukeyi kebaa de peting kekiee ge ziemne liagai, zie 180 ge.<verse eid="EST 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 1:5" />Nah taktyei ngyi kedi keraibe tingba ziedung de canglu ge, hegwangpei Susa kuda ga kebamme mina pelane ziemne, ceutu gade ditu ga kecang, lang henane ge ziemne, hegwangpei ki gurie kigu gade taktyei ngyi mtei beu. <verse eid="EST 1:5" /><verse number="6" style="v" sid="EST 1:6" />Langcim helang nah kemhei byssus riadung ga nzu bam nah gieremang rangkanggeu ringgoi nah marble tsiapumdung ga bam. Kecak nah rangkanggeu bamdung be porphyry nah alabaster nah tangtsu pemi kehungbe le tei kelu tetkenggwa kisie gage kailu. <verse eid="EST 1:6" /><verse number="7" style="v" sid="EST 1:7" />Nah kecak piakdung gage zau kai beu, piakdung ket swa ket tsamtsam cio; nah hegwang zau au kieesüt bam hegwangpei mbang eh kebam rehi gade. <verse eid="EST 1:7" /><verse number="8" style="v" sid="EST 1:8" />Nah cide hezai kai kebeu ria gade sak, “Cika migede de ketang ma,” kedanemene iciu eh hegwangpei pe ki pie kerengeime dage peu mina keheibe de de pesui riep gade sak lulo beudi delu. <verse eid="EST 1:8" /><verse number="9" style="v" sid="EST 1:9" />Cipaureude, hegwangpui Vashti liede hegwangpei Ahasuerus hegwangki lungga kebam mipuidung de taktyei ngyi mtei pwapeu bam.<verse eid="EST 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 1:10" />Hegwangpei ngyi langhenane benai, hegwangpei zausak le pesui yi eh mnung kui kebamdau, pa Mehuman, Biztha, Harbona, Bigtha nah Abagtha, Zethar nah Karkas (Eunuch hang hena hegwangpei Ahasuerus dwaga hegwa keteime) dage rangdi, <verse eid="EST 1:10" /><verse number="11" style="v" sid="EST 1:11" />hegwangpui Vashti de hegwangpei dwaga pe hegwang peurwa mrwalwe nzang gwanglo eh, iciu eh minadung nah kedimedung dage pe hezukeyi de keulia kera; kedanemene pa ngau hezu yisüt kecune. <verse eid="EST 1:11" /><verse number="12" style="v" sid="EST 1:12" />Dede hegwangpui Vashti hegwangpei sam eunuchmedung dage kai kebeu de mlaidi. Ge hegwangpei pe rata sütdi, nah lunghop le peda puidi.<verse eid="EST 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 1:13" />Pecai hegwangpei makecime, hezai nah aja kecime dage ranggai, (kedanemene cidau hegwangpei hezai kecimedung nah tutiak kecimedung dade penui lungning keteu kela zai kebamne; <verse eid="EST 1:13" /><verse number="14" style="v" sid="EST 1:14" />nah petai nna kebamme cai Karshena, Shethar, Admatha, Tarshish, Meres, Mersena, Memukan, Persia nah Media ga kedimedung hang hena hegwangpei da kebam caihakecime, hegwangram ga bam raitumedung): <verse eid="EST 1:14" /><verse number="15" style="v" sid="EST 1:15" />“Hezai ria gade, hegwangpui Vashti de aipaude gade daipai tei kerabe no, pa hegwangpei Ahasuerus eunuchmedung dage aja lang kegaide mzai mei kedine?”<verse eid="EST 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 1:16" />Nah Memukan gwang hegwangpei nah kedimedung dwa gade keligai, “Hegwangpui Vashti hegwangpei da rünne tei mau gai meda, dede kedimedung pelane nah hegwangpei Ahasuerus gu deuceudung ga kebam minadung pelane dage teigai da. <verse eid="EST 1:16" /><verse number="17" style="v" sid="EST 1:17" />Kedanemene hegwangpui tei kegai ma aide mipui pelane da cigwang dizie, aiciu eh penui nahpeidung de penui dwa gade mlai dizie, ‘Hegwangpei Ahasuerus hegwangpui Vashti de pe dwaga ngngwa gwanglo ranggai, dede pa gwang ma,’ de eh penui kerang dau. <verse eid="EST 1:17" /><verse number="18" style="v" sid="EST 1:18" />Cu tingbazie aika, Persia nah Media ga kedime naudung hegwangpui ha siu kelume hegwangpei kangga kedimedung pelane dage cinzwa rang zie da; delwe cika ngau kenghet nah lunghop bam dizie! <verse eid="EST 1:18" /><verse number="19" style="v" sid="EST 1:19" />Magade hegwangpei pesui liecai, hegwang zai gade peu pesam kaigai beulo, nah cide peu Persia nah Mediame hezaidung gage rau lulo (cide madauge de gah dilak) peu Vashti de madaude hegwangpei Ahasuerus dwa ga gwang dai lak lie kecu; nah peu hegwangpei de hegwangpui bam de pe kidabe pui, peswa yiki kecu pui de de peu dilu. <verse eid="EST 1:19" /><verse number="20" style="v" sid="EST 1:20" />Pecai hegwangpei pe hegwangram pelane ziemne hezai kai kegai de cigwang luzie, pe hegwangram dizu liede. Iciude mipuidung leune penui nahpeidung de rüt luzie, ditu gade ceutu kecang liede.”<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">Mipui leune, kedi nah keceu liede, penui nahpeime de herüt peu zie</char></note><verse eid="EST 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 1:21" />Sam cide hegwangpei nah kedimedung penui suilu; nah hegwangpei au Memukan kerang samde nzwa teilu. <verse eid="EST 1:21" /><verse number="22" style="v" sid="EST 1:22" />Nah pa hegwang deuceudung pelane ga laisiudung langgai beu, deuceu ge gade deuceu ge ga penui rau kela ria gade, nah minadung leune de penui kwa led rehi gade raulwe langgai beu: mipei leune peki ga kengkieng teu maisia lie kecu nah pe mina led ria gade marang zie lie kecu.<verse eid="EST 1:22" /></para>
  <chapter eid="EST 1" />
  <chapter number="2" style="c" sid="EST 2" />
  <para style="s">Esther de Hegwangpui Teikelu</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 2:1" />Ma aidungde cai, hegwangpei Ahasuerus rata ngkung mie di ge, pa Vashti de nsung gwangdi nah pa daipai tei gai bi kecu, nah pe dage teigai kera pesam kai kebeu de mning bam di. <verse eid="EST 2:1" /><verse number="2" style="v" sid="EST 2:2" />Pecai hegwangpei gu rehangme pegwa keteimedung ne ranggai, “Peu penuide hegwangpei ziemne relei kemcimedung nah hezu keyidung ge de peeilo. <verse eid="EST 2:2" /><verse number="3" style="v" sid="EST 2:3" />Nah peu hegwangpei de pe hegwangram ga deuceu leune ga kerengeime de kedetlu. Pecai peu penuide relei kemcipui nah hezu keyi leude Susa kengking reketbam ga, mipui ki ga Hegai (hegwangpei gu eunuch mipuidung kerengeibe) ba gage ngngwa gwang gai beulu. Delwe penuide tei hezu keyi maca peulu. <verse eid="EST 2:3" /><verse number="4" style="v" sid="EST 2:4" />Pecai hegwangpei ngau pe suitube releipui de peu Vashti bam leu eh hegwangpui teilu.” Nah sam cide hegwangpei dade yi di, cine pa cide mzui lu.<verse eid="EST 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 2:5" />Mipei ge, Jewme ge, Susa kengking reketbam ga bam, nah pe zi cai Mordecai, Jair napei, Shimei napei, Kish napei (Benjamin leuhme pei ge, <verse eid="EST 2:5" /><verse number="6" style="v" sid="EST 2:6" />Babylon gwangpei Nebuchadnezzar ne Jerusalem gade Judah gwangpei Jeconiah de langgi kedi, hebaangme de si eh langgi kedimedung kakga pa de si). <verse eid="EST 2:6" /><verse number="7" style="v" sid="EST 2:7" />Nah pa Hadassah (pa au Esther) de pe pui pe pei keku teu pecu nküt cuhlu, pe pau napui de, kedanemene pe ziemne pe pei mede pe pui gede kegah dene. Releipui de au pe rehi yi nah ngau yi. Nah pe pei penai pe pui tsaidi ge, Mordecai ne pecu pe napui ge nzwa ngngwa lu. <verse eid="EST 2:7" /><verse number="8" style="v" sid="EST 2:8" />Cinzwa eh, hegwangpei pe sam kai kebeudung nah pe hezaidung siu kelu dau, nah relei puidung kekiee gede Susa kengking reketbam ga Hegai ba gage ngngwa gwang kebam dau, Esther de de hegwangpei ki ga ngngwa gwang Hegai (mipuidung de kerengeibe) ba gage kaibeu. <verse eid="EST 2:8" /><verse number="9" style="v" sid="EST 2:9" />Nah releipui de ngau pesui yilu, nah pa pe suiyi teilu. Cine pa zette pecu maca peu nah pecu taktyei peugai, nah mipui kehena hang hena de hegwangpei ki gade kedet mpet pecu peu gai. Nah pa mipuidung ki yitube ga pecu nah pegwa tei kera releimedung de ngngwa mie gai beudi. <verse eid="EST 2:9" /><verse number="10" style="v" sid="EST 2:10" />Esther pa daipai leuhme mede pa dai gade gwang bi kecu rang ndu ma, kedanemene Mordecai ne pa ma aidung de rang lak kera kampwa kebamne. <verse eid="EST 2:10" /><verse number="11" style="v" sid="EST 2:11" />Nah tingba ramsang Mordecai mipui ki kigu dwaga tet nlüt mpet bammuila, Esther da kezuyi nah peda daipai tei bam bi kecu cilu kerane.<verse eid="EST 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 2:12" />Releime hangge ge kecu hegwangpei Ahasuerus da ngngwalia kera penlia gwang keludau, cide cai kei kereiekena caine, mipuimedung de tei hezuyi kecu zai ria gade. Kedanemene ainzwa eh penuide tei hezuyi kecu ting de teicang kerabe: kei herok ge Myrrh ca le püt, pecai kei herok ge perim kehenguidung nah mipuimedung de tei hezuyi kecu ca le pütla. <verse eid="EST 2:12" /><verse number="13" style="v" sid="EST 2:13" />Pecai cinzwa eh, mipui kehena hegwangpei da mie zie. Pa rang kegai leune pecu peula, pecu ngngwa le mipuidung ki gade hegwangpei ki ga kemie dau. <verse eid="EST 2:13" /><verse number="14" style="v" sid="EST 2:14" />Pa tinghegi miela, nah tingcang pa mipuiki keda ga cailigwang dila, Shaashgaz (hegwangpei nauseupuidung de kerengeibe eunuch) ba ga gwang dila. Pa hegwangpei da mie dailak, hegwangpei pecu pesui eh pecu pe zi qu gai kemaktane.<verse eid="EST 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 2:15" />Cu au Esther (Abihail napui, Mordecai pau, pa pecu luu pwa pe napui teilu) hegwangpei da mie kera penlia di ge, pa magede teu mai kesia peei si ma, Hegai (hegwangpei gu eunuch mipuidung de kerengeibe) ne kerang de gwale. Nah Esther de kengau leune pecu penui suidi. <verse eid="EST 2:15" /><verse number="16" style="v" sid="EST 2:16" />Cine Esther de hegwangpei Ahasuerus da ngngwa gwang, pe hegwang ki ga, kei kerei bekei (cide au Tebeth bekei), pa hegwang tei kelu mmi hena bekum. <verse eid="EST 2:16" /><verse number="17" style="v" sid="EST 2:17" />Nah hegwangpei mipuidung leune swa Esther de pesui yiki di nah pa relei kemci leune swade pesui yi nah pe keku ngau kieelu. Cine pa pe peu reu gage hegwang peurwa rwa gai, nah pa Vashti de mene pecu be peu hegwangpui teidi. <verse eid="EST 2:17" /><verse number="18" style="v" sid="EST 2:18" />Cipaucai hegwangpei pe kang kedimedung nah pe kilamedung ziemne ketaktyei kedi ge teigai, Esther gu ketaktyei de kecude. Nah pa deuceudung ziemne kemtak tingba ge kaibeu, nah pa hegwangpei nsam gade mta mapeudung zibeu.<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="fq" closed="false">Zibeu </char><char style="ft" closed="false">Deuceu leune de kemaugi maha peugai.</char></note><verse eid="EST 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EST 2:19" />Cu relei kemcidung pia pekenabe gwang hekwa dai kebam dau, Mordecai de hegwangpei rieki ga ntum bam<note caller="+" style="f"><char style="fr" closed="false">2:19 </char><char style="ft" closed="false">Mordecai au hegwang ki ga kedime.</char></note>. <verse eid="EST 2:19" /><verse number="20" style="v" sid="EST 2:20" />Esther pa pe leuh pe hiak (cide cai, pe minadung) ndu lia di mene bam, Mordecai ne pecu kam pwa kebam nzwa eh. Nah Esther Mordecai sam mzai jüja eh teigwang, ndaa pane pema pie kela dau nzwa eh. <verse eid="EST 2:20" /><verse number="21" style="v" sid="EST 2:21" />Cipau tingdau, Mordecai hegwangpei rieki ga ntum bam ge, Bigthan nah Teresh (hegwangpei gu eunuch hegwangbam reket bam kelabe kena) penai rata di; nah penai hegwangpei Ahasuerus de renia eh penai ba kai kera heciem riemlu. <verse eid="EST 2:21" /><verse number="22" style="v" sid="EST 2:22" />Dede Mordecai cide ha ci teu di, cine hegwangpui Esther da cide ndu lia beudi; ge Esther Mordecai zi gade hegwangpei dage paubeu. <verse eid="EST 2:22" /><verse number="23" style="v" sid="EST 2:23" />Cipaucai cide ha peei hecung eh cide ngau mpet lu, nah cipau kena de de tsingbang ge gage gwak di. Nah cide hegwangpei dwa gade bata laisiukwak gage raulu.<verse eid="EST 2:23" /></para>
  <chapter eid="EST 2" />
  <chapter number="3" style="c" sid="EST 3" />
  <para style="s">Jewme de Ngkapdi kera Haman Ciem</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 3:1" />Ma aidungde cai, hegwangpei Ahasuerus, Agagme pei Hammedatha napei Haman<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="fq" closed="false">Haman </char><char style="ft" closed="false">Amalekme hegwangpei Agag leuhme.</char></note> de tei ndu gaibeu. Pa pecu teucuh gaibeu delwe pe kengkieng bam peda kebamme kedimedung leune reu gage kaibeu. <verse eid="EST 3:1" /><verse number="2" style="v" sid="EST 3:2" />Pecai hegwangpei kirie ga kebam hegwangpei kilamedung leune Haman dwa keumie nah koktungmie bam, kedanemene hegwangpei aja kai kegai ziemne. Dede Mordecai keumie mede pa koktungmie ma. <verse eid="EST 3:2" /><verse number="3" style="v" sid="EST 3:3" />Pecai hegwangpei kirie ga kebam hegwangpei kilamedung Mordecai dage rangdi, “Daitei lie nang hegwangpei gu aja de gikah zeu nau?” <verse eid="EST 3:3" /><verse number="4" style="v" sid="EST 3:4" />Penui tingba ge cai tingba ge eh pecu mpau kegai dau de, pa penui kwa kingnei ma. Cine penui Haman dage rangbeu di Mordecai samdung de liagai di lak mi de, kedanemene pa au Jewme liede eh penui dage rangbeu di kecune. <note caller="+" style="f"><char style="fq" closed="false">Pecu mpau kegai dau </char><char style="ft" closed="false">mede </char><char style="fqa" closed="false">penui pecu mpau gai herizi </char><char style="ft" closed="false">(Hebrew Qere) </char></note> <verse eid="EST 3:4" /><verse number="5" style="v" sid="EST 3:5" />Pecai Haman Mordecai pedwa keumie kemak mede koktungmie kemak ngaulu. Nah Haman da rata le puidi. <verse eid="EST 3:5" /><verse number="6" style="v" sid="EST 3:6" />Nah Mordecai rünne de saja peu kera pa nnung lu tadi, kedanemene penui Mordecai leuhme de pecu rang kebeu ne. Cine Haman Jewme leune de tei ngkapdi kera heciem peei cuhdi, Mordecai leuhme, Ahasuerus hegwangram ga kebam leune de.<verse eid="EST 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 3:7" />Kei raitube kei, cide au Nisan bekei, hegwangpei Ahasuerus hegwang tei kelu mmi kereiekena bekum, Pur (cide “dacak”) tingba ge cai tingba ge nah keige cai keige Haman dwa gade teilu; kereiekena kecang, cide au Adar bekei. <verse eid="EST 3:7" /><verse number="8" style="v" sid="EST 3:8" />Pecai Haman hegwangpei Ahasuerus dage rang, “N hegwangram deuceu leune ga mina kangge zangra la nah minadung kakgade tsamla. Nah penui gu hezaidung au mileune dade tsamsütla, nah hegwangpei gu hezaidung penui mzai lama. Nah penuide saja peu mene pütdi kera au hegwangpei ziemne pe kemmi gah.” <verse eid="EST 3:8" /><verse number="9" style="v" sid="EST 3:9" />Magade hegwangpei ziemne keyi ge lie cai, penuide ngkapdi kera rau gai beu lulo, nah Ih rangkanggeu talent 10,000<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="fq" closed="false">Talent 10,000 </char><char style="ft" closed="false">3,40,000 kg</char></note> mata keteime ba gage kaigai beuzie, hegwangpei gu mabamdung ga nlütlu kerane. <verse eid="EST 3:9" /><verse number="10" style="v" sid="EST 3:10" />Cipaucai hegwangpei pe ba gade pegu kaugiak bakap<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="fq" closed="false">Kaugiak bakap </char><char style="ft" closed="false">Hengwangme bakap, mdu kegai giakkai kecu nah penuide kedi teibeu kecu.</char></note> keu mpetlu, delwe pa cide Agagme pei Hammedatha napei Haman, Jewme ngaurabe de peudi. <verse eid="EST 3:10" /><verse number="11" style="v" sid="EST 3:11" />Nah hegwangpei Haman dage rang, “Rangkanggeu ncu; nah minadung de peu dida, cidungde teu n suibe teilu kerane.”<verse eid="EST 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 3:12" />Nah hegwangpei gu laisiukecimedung de qu kelu raitu bekei<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="fq" closed="false">Raitu bekei </char><char style="ft" closed="false">Nisan kei raitube.</char></note>, 13 tingba benai, nah Haman ne raulu lo aja kai kegai ria gade cide rau lu; hegwangpei gu kedimedung dage; nah deuceu ge cai deuceu ge reu kebam deuceudidung dage; nah mina ge cai mina ge gu kedimedung dage; deuceu ge cai deuceu ge kerau ria gade, nah mina ge cai mina ge heled ria gade. Cide hegwangpei Ahasuerus zi gade raulu, nah cide hegwangpei kaugiak bakap le giakdi. <verse eid="EST 3:12" /><verse number="13" style="v" sid="EST 3:13" />Nah laisiudung de hegwangpei gu deuceudung leune ga teukengwame ba gage langgai beudi, ngkap zing kera, gi tset kera, nah Jewme hena gade hecing kecang leune de ngkapdi kerane, henamedung nah mipuidung, tingnai ge gage, kei 12 bekei ziangreikecum benai (cide Adar bekei), nah penui gu tui kelu mabamdung luu teudi kera. <verse eid="EST 3:13" /><verse number="14" style="v" sid="EST 3:14" />Rau pwa kenzeu kwak ge, deuceu ge cai deuceu pelane ga hezai ge lie peu kera de, minadung leune de peu cigai aipau tingba de ziemne mteilu kerane. <verse eid="EST 3:14" /><verse number="15" style="v" sid="EST 3:15" />Teukengwame mzet eh miedi hegwangpei aja de ne, nah hezai de Susa kengkieng reketbam gage peugai. Nah hegwangpei penai Haman sak kerane ntum bamlu, dede Susa namdi kebwak bamdi.<verse eid="EST 3:15" /></para>
  <chapter eid="EST 3" />
  <chapter number="4" style="c" sid="EST 4" />
  <para style="s">Mordecai ne Kengha lulo Esther de Kecungkegai</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 4:1" />Cu Mordecai aidungde tei kedi leune ha cilu ge, Mordecai pesui sia eh pe painidung hietdi<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="fq" closed="false">Pe painidung hietdi: </char><char style="ft" closed="false">pesui sia kebam lia kera.</char></note> delwe rosopai teu lwe mimüt le pecu pütlu. Nah pa namdi kakga tetkah mie, nah pa pesui siasüt eh sahbak eh hap gai. <verse eid="EST 4:1" /><verse number="2" style="v" sid="EST 4:2" />Nah pa hegwangpei kirie dwaga kecang gwale lüt sima, kedanemene migede rosopai bahlwe hegwangpei kirie ga lütla kemakne. <verse eid="EST 4:2" /><verse number="3" style="v" sid="EST 4:3" />Nah deuceu ge eh deuceu ge leune ga, keheibe bam ga hegwangpei aja nah pe hezai gwang cang kelu ga, Jewmedung penui suisia sütdi, nah mmwang, nah heei eh hap bamdi; mina kekieege rosopai bah nah mimüt ga zeu bamdi.<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">suisiet, miakdui kezau, nah kehap au rei kebam marehi ge.</char></note> <verse eid="EST 4:3" /><verse number="4" style="v" sid="EST 4:4" />Esther kila releimedung pegu eunuchme de ngngwa lwe gwang pecu Mordecai ha ranglia kecudau, hegwangpui pe lung kehereisütdi. Nah pa Mordecai de pa bah kebam rosopai keu mpetdi delwe paidung bah lulo langgai beu, dede Mordecai cidungde luu ma.<verse eid="EST 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 4:5" />Cine Esther Hathak de qugai, pa au hegwangpei eunuchmedung kakga hegwang ne peu pecu pe kila tei zie lie kedet kelube. Esther pe dage aja kaibeu, Mordecai daipai tei au bi nah daiziemne ciciu bambi kecu cilu kerane. <verse eid="EST 4:5" /><verse number="6" style="v" sid="EST 4:6" />Cine Hathak Mordecai da mie, namdi heni kemza ga hegwangpei kirie dwaga kebam de ga. <verse eid="EST 4:6" /><verse number="7" style="v" sid="EST 4:7" />Nah Mordecai pe dage tei kedibe leune pecu paubeu, nah hegwangpei mabamdung gage Haman rangkanggeu<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="fq" closed="false">Rangkanggeu: </char><char style="ft" closed="false">rangkang</char></note> dai kieege kaibeu zie lie rang beubi paubeu, Jewmedung de mmau eh penuide ngkapdi kerane. <verse eid="EST 4:7" /><verse number="8" style="v" sid="EST 4:8" />Mordecai pecu penuide tei ngkap zing di kera hezai laisiu Susa hegwang ki gade kekai de de peugai, Esther de keu lialu kerane, nah pecu reci gaibeu lu kera, nah peu pecu mie hegwangpei dade pe nggia kie kera nah pe dwade pe minadung de ngau nggia lo de kielu kerane. <verse eid="EST 4:8" /><verse number="9" style="v" sid="EST 4:9" />Cine Hathak mie delwe Esther da Mordecai samdung de rangbeu.<verse eid="EST 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 4:10" />Pecai Esther Hathak de Mordecai dage aide rang beulo de aja kaigai: <verse eid="EST 4:10" /><verse number="11" style="v" sid="EST 4:11" />“Hegwangpei kilamedung leune nah hegwangpei gu deuceudung ga minadung penui ci bam kap cide au keheibe mipei mede mipui de pecu qugai mene helungle kigu ga kelütme ziemne au hezaibe ket ta: penuide peu tsai kera; dede magade hegwangpei pe kecak tuitie le cipaude dage hetwa gai cai, pa ring luzie. Dede acu au hegwangpei da gwang lulo qu kemak zie camrei dida.” <verse eid="EST 4:11" /><verse number="12" style="v" sid="EST 4:12" />Cine Esther samdung Mordecai dage Hathach pau beu. <verse eid="EST 4:12" /><verse number="13" style="v" sid="EST 4:13" />Pecai Mordecai Esther da sam lang cailigai: “Nang hegwangpei ki gade pak kera cet so, Jewme pelane dade. <verse eid="EST 4:13" /><verse number="14" style="v" sid="EST 4:14" />Kedanemene nang aikenzwa tingdau mlei mene bam dicai, Jewmedung ziemne tei kengkei nah kelikebeu kera keda gade gwang dizie, dede nang nah n pei kilungme gah dizie. Nah aikenzwa tingdau ziemne ncu peu hegwangpui tei pwabam lubui?”<verse eid="EST 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 4:15" />Pecai Esther Mordecai dage sam keligai kera rangdi: <verse eid="EST 4:15" /><verse number="16" style="v" sid="EST 4:16" />“Miecu, Susa ga Jewmedung kebam pelane de hekwalu. Nah a ziemne mmwang lulo, matyei mede sak mene, tingmui tingba lang cumne ziemne. Ih nah a kila nküt releipuidung liede cinzwa mmwang luzie. Pecai ciciu kecudau, Ih hegwangpei da mie zie, cide hezai rehi gade meliede; nah Ih tsai maisia cai, Ih tsai de luzie.” <verse eid="EST 4:16" /><verse number="17" style="v" sid="EST 4:17" />Cine Mordecai mie delwe Esther pecu tei lulo rang kebeu leune nzwa eh teilu.<verse eid="EST 4:17" /></para>
  <chapter eid="EST 4" />
  <chapter number="5" style="c" sid="EST 5" />
  <para style="s">Esther Hegwangpei dade Kekie</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 5:1" />Esther mmwang kebam langcumne benai, pe hegwang paini kailu nah hegwangki kigu lungga saplu, hegwangpei ki de ketsapreu eh. Cidau hegwangpei hegwangki ga pe hegwangbam ga bam, hegwangki kimuiki ketsapreu kebam ga. <verse eid="EST 5:1" /><verse number="2" style="v" sid="EST 5:2" />Nah cinzwa eh, hegwangpei hegwangpui Esther kigu ga sap kebam ngaulu herizi, pa pecu ngau pesui lu. Nah hegwangpei pe ba ga kebam kecak tuitie de Esther dage ketwa gai, cine Esther gwang nna delwe tuitie tün tunggai. <verse eid="EST 5:2" /><verse number="3" style="v" sid="EST 5:3" />Nah hegwangpei pe dage rangdi, “Dai ne ncu kebwak lano hegwangpui Esther? Nah nang dai kie neu lano? Hegwangram pempie kieege liede, ncu cide peu beuzie.” <verse eid="EST 5:3" /><verse number="4" style="v" sid="EST 5:4" />Nah Esther keligai, “Hegwangpei pesui lie cai, peu henai hegwangpei ziemne mtei pwa kebam taktyei bam ga Haman de ngngwa gwang lulo.” <verse eid="EST 5:4" /><verse number="5" style="v" sid="EST 5:5" />Pecai hegwangpei rangdi, “Haman de zette ngngwa gwanglo, Esther kie kela de teilu kerane. Nah Hegwangpei Haman de Esther ne mtei kenzeu taktyei bam ga ngngwa gwanglu.”<verse eid="EST 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 5:6" />Pecai hegwangpei zau sak kebam dau Esther dage rangdi, “Nang dai luu neu lano? Nah cide ncu peu beuzie. Nang dai kie neu lano? Hegwangram pempie kieege liede, cide teibeu zie.”<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="MRK 6:23">Mrk. 6:23</ref></char></note> <verse eid="EST 5:6" /><verse number="7" style="v" sid="EST 5:7" />Pecai Esther samkeli eh rangdi, “Ih tei beulo kie kela nah a kekie de au: <verse eid="EST 5:7" /><verse number="8" style="v" sid="EST 5:8" />magade Ih hegwangpei dwa gade pesuibe teilu liecai, nah Ih tei beulo kie kelade peubeu kera nah a kekie tei beu kerade hegwangpei ziemne keyi ge liecai, peu hegwangpei de Ih nnai ziemne mtei beula kebam taktyei bam ga Haman de ngngwa gwanglu, nah Ih cidau ne luu neu kelabe ncu ranglia zie.”<verse eid="EST 5:8" /></para>
  <para style="s">Mordecai de Haman Perata süt kedi</para>
  <para style="p">
    <verse number="9" style="v" sid="EST 5:9" />Nah Haman cipaunai pesui yi eh tetdi. Dede Haman Mordecai hegwangpei rieki ga kebam, pa cuh sap ma mede pecu kerüt peu kemak ngaulu herizi, Haman Mordecai de pe rata sütdi. <verse eid="EST 5:9" /><verse number="10" style="v" sid="EST 5:10" />Dede Haman pekatei pecu kezeulu delwe peki ga gwangdi. Pecai pa pe zangmedung nah pe nau Zeresh de qugai. <verse eid="EST 5:10" /><verse number="11" style="v" sid="EST 5:11" />Pecai Haman penui dade pe mahei ndulia gai, nah pe napeidung dai kieege bambi, nah dainzwa hegwangpei pecu peu kedi teilu dibi nah pa dainzwa pecu hegwangpei gu kerengeime nah kedimedung reu teu cuh beu bi kecu pe gie ranggai. <verse eid="EST 5:11" /><verse number="12" style="v" sid="EST 5:12" />Nah Haman rangdi, “Cide peu reu si eh, hegwangpui Esther pa taktyei mtei kebeu ga peu hegwangpei de ngngwa acu gwale migede ngngwa gwang ma. Nah ncünne liede, pa acu nah hegwangpei de qu bam.” <verse eid="EST 5:12" /><verse number="13" style="v" sid="EST 5:13" />Dede Jewme pei Mordecai hegwangpei rieki ga ntum kebam Ih kengau tane aidungde a dade magede ma. <verse eid="EST 5:13" /><verse number="14" style="v" sid="EST 5:14" />Pecai pe nau Zeresh, pe zangmedung pelane si eh pe da rangdi, “Peu penuide tsingbang 50 cubit<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="fq" closed="false">50 cubit: </char><char style="ft" closed="false">feet 75 </char></note> hu ge teilo. Nah tingcang hegwangpei dage rangbeu, nah peu penuide cika ge Mordecai de gwakdi. Ciciu eh nang n sui yi eh hegwangpei de ngngwa taktyei bam ga mie lulo.” Nah sam cide Haman dwa gade keyi mariem ge di, nah pa tsingbang de teilu.<verse eid="EST 5:14" /></para>
  <chapter eid="EST 5" />
  <chapter number="6" style="c" sid="EST 6" />
  <para style="s">Mordecai de Ketwa</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 6:1" />Cipau ziu de hegwangpei zip gailak di. Nah pa ma kenlang be tei kedidung rau kenzeu laisiukwak de keu gwanglo pe kedime de aja kaigai iciu eh cide pe dage pei lialu kerane. <verse eid="EST 6:1" /><verse number="2" style="v" sid="EST 6:2" />Nah cika Mordecai ne Bigthana penai Teresh ha rang kebeu, penai au hegwangpei gu eunuch kikam kenlüt ga kekwabe kena, penai hegwangpei Ahasuerus de renia eh penai ba kai di kera ciem de rau kenzeu ngaulu. <verse eid="EST 6:2" /><verse number="3" style="v" sid="EST 6:3" />Pecai hegwangpei rangdi, “Aide ziemne Mordecai de dai kenzwa herüt mede ma keyi kedi peu gai no?” Nah rehangme hegwangpei gwa keteime keligai, “Pe ziemne magede tei gai melie.” <verse eid="EST 6:3" /><verse number="4" style="v" sid="EST 6:4" />Pecai hegwangpei keteu eh, “Kigu ga cau bam no?” Haman cidau hegwangpei ki hegwale kigu ga nlütlu delwe Mordecai de pa pe ziemne mteipwa kebam tsingbang de gage gwak dilo de eh hegwangpei dage rangbeu kera gwang bam. <verse eid="EST 6:4" /><verse number="5" style="v" sid="EST 6:5" />Nah hegwangpei minadung ne pe dage rangdi, “Ainie, Haman au kigu ga sap bam.” Nah hegwangpei rangbeu, “Peu pecu lütlu.”<verse eid="EST 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 6:6" />Pecai Haman lüt, hegwangpei pe dage rangdi, “Hegwangpei herüt peu gai neu kebam peide ziemne daipai tei lai no?” Pecai Haman pelung gade rangdi, “Hegwangpei acu swa cau de herüt peu neu bam lai?” <verse eid="EST 6:6" /><verse number="7" style="v" sid="EST 6:7" />Cine Haman hegwangpei sam keligai, “Hegwangpei herüt peu gai neu kelabe de ziemne: <verse eid="EST 6:7" /><verse number="8" style="v" sid="EST 6:8" />Peu penuide hegwangpei teu kelabe hegwang paini ge nah hegwangpei hekwen teu kelabe nah hegwangme gu peurwa ge pe peu gage kai kebeu de teugwang beulu. <verse eid="EST 6:8" /><verse number="9" style="v" sid="EST 6:9" />Ciciu eh paini cide nah hekwen cide hegwangpei gu kedime mina hutumedung ba gage kai beu. Nah peu penuide hegwangpei pesui yi eh herüt peula kebam mina de bah beu, nah peu pecu hekwen reu gage bamlwe namdi sum ga heni kenza bam ga mielu, nah pe dwade reci gailo, ‘Hegwangpei pesui yi eh herüt peu kegaime de ainzwa tei gai lalie!’” <verse eid="EST 6:9" /><verse number="10" style="v" sid="EST 6:10" />Cine hegwangpei Haman dage rangdi, “Zette, paini penai hekwen keulu, nang kerang de nzwa, nah cide Jewme pei Mordecai ziemne hegwangpei rieki ga ntum kebambe dage teilu. Sam tie gede nang kerang leune gade peu tei mene ta diso.”<verse eid="EST 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 6:11" />Cine Haman paini nah hekwen keulu, nah pa Mordecai de bah beu nah pecu peu hekwen reu ga bamlwe namdi heni kenza ga mie, nah pe dwa gade reci kegai tei, “Hegwangpei pesui yi eh herüt peu gai keneube de au ainzwa tei gai la lie!” <verse eid="EST 6:11" /><verse number="12" style="v" sid="EST 6:12" />Cipaucai Mordecai hegwangpei rieki ga cailigwang, dede Haman pesui sia süt eh pe peu kezui punglu eh pe ki ga mzet gwang di. <verse eid="EST 6:12" /><verse number="13" style="v" sid="EST 6:13" />Pecai Haman pe dage teikegai leune pe nau Zeresh de nah pe zangmedung pelane dage paulia beu. Pecai pe mina makecime nah pe nau Zeresh pe dage rangdi, “Magade Mordecai, nang pe dwa de kau kedi pei de, au Jewme leuh ge liecai, iciucai nang pe dade ngkieng gailak, dede nang pedwa gade kau bizie.” <verse eid="EST 6:13" /><verse number="14" style="v" sid="EST 6:14" />Penui pecu ngngwa marang bam reu kecu dau hegwangpei gu eunuchme gwang cangdi. Nah penui mzet eh Haman de Esther ne mtei kenzeu taktyei bam ga ngngwa gwangdi.<verse eid="EST 6:14" /></para>
  <chapter eid="EST 6" />
  <chapter number="7" style="c" sid="EST 7" />
  <para style="s">Haman de Gwakkedi</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 7:1" />Cine hegwangpei Haman de ngngwa lwe hegwangpui Esther de ngngwa tyei sak kera gwang. <verse eid="EST 7:1" /><verse number="2" style="v" sid="EST 7:2" />Nah hegwangpei Esther dage tingba pekena benai zau sak kebam dau rangdai, “Nang dai luu neu lano, Hegwangpui Esther? Nah cide ncu peu beuzie. Nah nang dai kie lano? Hegwangram pempie kieege liede, nah cide teibeu zie.”<note caller="-" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="MRK 6:23">Mrk. 6:23</ref> </char></note> <verse eid="EST 7:2" /><verse number="3" style="v" sid="EST 7:3" />Ge Hegwangpui Esther sam keli eh rangdi, “Magade Ih n dwa gade nsui teilu lie cai, O hegwangpei, nah hegwangpei ziemne cide keyige lie cai, Ih teibeulo kie kela de au a teilung de nah a kekie de au a minadung de de peu ringlu kera deda. <verse eid="EST 7:3" /><verse number="4" style="v" sid="EST 7:4" />Kedanemene a mina nah acu tei ngkap zingdi kera, gitset di kera nah tei msia di kerane anuide zwa dida. Cu magade anuide hebaangme nzwa nah kila puidung tei kera zwagai lie cai, Ih nlei mene bam dizie nage, kedanemene ci kenzwa rei le au hegwangpei de tei kebwak cu petau ma.”<verse eid="EST 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 7:5" />Pecai Hegwangpei Ahasuerus Hegwangpui Esther dade rangdi, “Pa cauno, cipau mina de? Mina cipaude daiga bam no, ci kenzwa ta teigai kera pelung ga kepui tei kebam de?” <verse eid="EST 7:5" /><verse number="6" style="v" sid="EST 7:6" />Esther sam keligai, “Mipei ge, mide tei keherei kelabe, nah mi ngauraube de au mina kesia Haman aide lie!” Pecai Haman hegwangpei nah hegwangpui dwa gade ngngi sütdi. <verse eid="EST 7:6" /><verse number="7" style="v" sid="EST 7:7" />Pecai hegwangpei perata süt eh zau sak kebam bam gade cuh sapdi delwe hegwale hegwangki gurie ga miedi. Dede Haman au cika bamdi iciu eh pa hegwangpui Esther dade pe teilung ziemne pe nggia kie kerane, kedanemene hegwangpei pecu mcau eh makesia ge tei gai kera pa ngau kedine. <verse eid="EST 7:7" /><verse number="8" style="v" sid="EST 7:8" />Cu hegwangpei hegwangki gurie gade zau kesak bam ga cailigwang kecudau, Haman Esther kebam bamtie ga zeu miedi. Nah hegwangpei ranggai, “Ih a hegwangki ga bam eh de pa hegwangpui de teu lau ni?” Hegwangpei sam aide rang bam kegai dau penui Haman zu kezuidi.<note caller="+" style="f"><char style="fr" closed="false">7:8 </char><char style="ft" closed="false">Persiame hezai gade cai migede teitset di lia kebambe peu kezuidi la.</char></note><verse eid="EST 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 7:9" />Pecai Harbona, hegwangpei dwa gade eunuchmedung kakgade hangge, rangdi, “Delwe, ainie, Haman Mordecai ziemne tsingbang ge mtei pwa kela, hegwangpei ziemne keyige rang kebeu be, Haman ki ga 50 cubit<note caller="+" style="f"><char style="fr" closed="false">7:9 </char><char style="fq" closed="false">50 cubit: </char><char style="ft" closed="false">feet 75</char></note> hu ge sap bam.” Nah hegwangpei rang eh, “Pecu cikage gwakdi.” <verse eid="EST 7:9" /><verse number="10" style="v" sid="EST 7:10" />Cine Mordecai ziemne pane mtei kenzeu bam gage penui Haman de tsingbang gage gwakdi, nah hegwangpei rata ngkung miedi.<verse eid="EST 7:10" /></para>
  <chapter eid="EST 7" />
  <chapter number="8" style="c" sid="EST 8" />
  <para style="s">Jewme Keleu gade Hegwangpei Aja</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 8:1" />Cipau nai, hegwangpei Ahasuerus, Hegwangpui Esther de Jewme ngauraube, Haman mabam pelane pwa peudi. Nah Mordecai hegwangpei dwaga gwang kelu teilu, kedanemene Esther pa au pe kibaume lie kecu ranglia kebeune. <verse eid="EST 8:1" /><verse number="2" style="v" sid="EST 8:2" />Pecai hegwangpei pe kaugiak bakap keu mpetlu, pa Haman dade keukeli kelu de, delwe Mordecai de cide peudi. Nah Esther Mordecai de peu Haman mabam de rengeilu.<verse eid="EST 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 8:3" />Pecai Esther pa tei kedibe tei dai, nah pa hegwangpei dwa gade marang. Pa pe pi ga zeu mie delwe hap eh nah pe dade Agagme pei, Haman kesia de nah pe ciem pa Jewme ziemne riem pwa kebam de keudi beulo pe nggia kie gai. <verse eid="EST 8:3" /><verse number="4" style="v" sid="EST 8:4" />Nah hegwangpei Esther de kecak tuitie de hwagai beu, cine Esther cuhlu delwe hegwangpei dwa ga saplu. <verse eid="EST 8:4" /><verse number="5" style="v" sid="EST 8:5" />Nah pa pe nggia kie, “Magade hegwangpei ziemne cide petau lie cai, nah Ih pe dwa de pe suibe teilu lie cai, nah hegwangpei dwa gade sambe petau lie cai, nah Ih pe dwa de yi lie cai, laisiudung de pung cailigwang dailu kera raudi lulo, Agagme pei Hammedatha napei, Haman ciem de, hegwangpei deuceu leune ga Jewme kebamme de tei ngkapdi kerane pa rau kegaide. <verse eid="EST 8:5" /><verse number="6" style="v" sid="EST 8:6" />Kedanemene Ih dainzwa eh lialu lai no kemau a minadung ngau kera de? Nah Ih dainzwa a kibaume de tei kengkap ngau eh lialu laino?”<verse eid="EST 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 8:7" />Nah hegwangpei Ahasuerus hegwangpui Esther nah Jewme pei Mordecai dage rangdi, “Ainie, Ih Haman ki Esther de peu dida, nah penui pecu tsingbang gage gwak dida, aipau de ziemne, pa Jewme de mmau eh pe ba kai kegai ziemne. <verse eid="EST 8:7" /><verse number="8" style="v" sid="EST 8:8" />Cine nnai Jewme ziemne nnai dwade petaube hegwangpei zi gade raulu, nah cide hegwangpei kaugiak bakap le dap gaidi. Kedanemene hegwangpei zi gade nah hegwangpei kaugiak bakap le dap kedi laisiu rau kelu migede keu caili kera gahlu.”<verse eid="EST 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 8:9" />Cine keicum bekei, cide Sivan<note caller="+" style="f"><char style="fr" closed="false">8:9 </char><char style="fq" closed="false">Sivan: </char><char style="ft" closed="false">Babylonme hekeizie gade cai keicum bekei nah May-June kera da.</char></note> bekei, zie ngkaiekecum benai, cipau tingdau hegwangpei gu laisiukecimedung de qulu. Nah Mordecai ne aja leune kai kebeu rehi gade Jewme dage, nah kedime dage, nah deuceudidung nah deuceudung kedime India gade Cush<note caller="+" style="f"><char style="fr" closed="false">8:9 </char><char style="fq" closed="false">Cush: </char><char style="ft" closed="false">Ethiopia.</char></note> kemdei ga kecang dage laisiu raugai: 127 deuceudung, deuceu ge cai deuceu ge kerau zai rehi gade, nah mina ge cai mina ge let rehi gade, nah Jewme dage penui kerau zai rehi gade nah penui let rehi gade. <verse eid="EST 8:9" /><verse number="10" style="v" sid="EST 8:10" />Nah pa hegwangpei Ahasuerus zi gade raulu, nah pa hegwangpei kaugiak bakap le dapdi. Nah pa laisiudung de (hegwangki kündung, hekwenleina, hekwen pak kecibedung reu ga cwa kelame ba gage langgai) <verse eid="EST 8:10" /><verse number="11" style="v" sid="EST 8:11" />hegwangpei ne Jewme de namdi ge cai namdi leune ga kebamme dage kepeu: ngkwalu kera nah penui teilung ziemne sap kera, nah ngkap zingdi kera, gitset kera, nah mina keheibe de mede deuceube penuide gwaketang lu kebuime de ngkap kera, hename nah mipuidung, nah penui gu tui kelu mabamdung luu teudi kera; <verse eid="EST 8:11" /><verse number="12" style="v" sid="EST 8:12" />hegwangpei Ahasuerus deuceudung leune ga, langnaige gage, cide kei kereiekena zie kereiekecumbe nai, cide Adar bekei. <verse eid="EST 8:12" /><verse number="13" style="v" sid="EST 8:13" />Raupwa kebam laisiu de hezai lie eh deuceu leune ga pwa peu kera teidi. Cide mina leune de peu cilu kerane, nah peu Jewme de cipaunai ziemne mtei lu eh, penui ngauraume dade hekum peeilu kerane. <verse eid="EST 8:13" /><verse number="14" style="v" sid="EST 8:14" />Teukengwame, hegwangki gu hekwendung keteume, hegwangpei sam de ne kelwa eh nah mzet süt eh mie di. Nah hezai de Susa kengking reketbam gade peugai.<verse eid="EST 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 8:15" />Pecai Mordecai hegwangpei dwa de tetdi, hegwang paini kemhei nah keha ge bah eh, kecak peurwa kedi ge nah langcimpai keyi nah gieremang pai ge teulu eh, nah Susa namdi de mlwa nah suiyi sütdi. <verse eid="EST 8:15" /><verse number="16" style="v" sid="EST 8:16" />Jewme ziemne kebaa nah suiyi, nah misuikeyi nah hetwaherüt bamlu. <verse eid="EST 8:16" /><verse number="17" style="v" sid="EST 8:17" />Deuceu leune ga nah namdi leune ga, hegwangpei sam de nah pe hezai de kegwang leune ga, Jewme ziemne suiyi nah kemlwa, taktyei ngyi nah tingba keyi ge bamlu. Nah cipau deu ga minadung kedame kekiee ge de Jewme teidi, kedanemene Jewme de kehing penui da gwang kedine.<verse eid="EST 8:17" /></para>
  <chapter eid="EST 8" />
  <chapter number="9" style="c" sid="EST 9" />
  <para style="s">Jewme Ngkiengkelu</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 9:1" />Cu kei kereiekena, cide Adar bekei, ziangreikecum benai, hegwangpei sam nah pe hezai de teilu kera peting gwang cang kelu dau, Jewme ngauraumedung penui kang gage kailu kera regui kedi benai de: dede cide ciciu kelube mene, Jewmedung penuide ngaurau kelamedung de penui kang gage kailu. <verse eid="EST 9:1" /><verse number="2" style="v" sid="EST 9:2" />Jewmedung penui namdidung ga hegwangpei Ahasuerus deuceudung pelane ga penui gwang ngkwalu, penuide tei msia kera peei kelame de heba ge kezang pet ketang kerane. Dede migede penui dwaga sap beu ma, kedanemene penuide hing kecu minadung pelane da bam kedine. <verse eid="EST 9:2" /><verse number="3" style="v" sid="EST 9:3" />Nah deuceudung ga kedimedung pelane, nah deuceu dimedung, nah peuteumedung, nah hegwangpei ziemne heta keteimedung, penui au Jewmedung de teu ncuh bam, kedanemene Mordecai de kehingde penui da bam kedine. <verse eid="EST 9:3" /><verse number="4" style="v" sid="EST 9:4" />Kedanemene Mordecai au hegwangpei ki gade mdu pet di, nah pe kedi ha cide deuceudung pelane ga mdu pet di, kedanemene Mordecai de kecu pei de au yi reureu nah di reureu di kecune.<verse eid="EST 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 9:5" />Nah Jewmedung penui ngauraume pelane de kingtie le bi, nah gitset, nah ngkapdi; nah penuide ngaurau kelamedung de de penui sui teidi. <verse eid="EST 9:5" /><verse number="6" style="v" sid="EST 9:6" />Nah Susa kengking reketbam gade Jewmedung ne minadung haimengei teitsetdi. <verse eid="EST 9:6" /><verse number="7" style="v" sid="EST 9:7" />Nah Parshandatha, nah Dalphon, nah Aspatha, <verse eid="EST 9:7" /><verse number="8" style="v" sid="EST 9:8" />nah Poratha, nah Adalia, nah Aridatha, <verse eid="EST 9:8" /><verse number="9" style="v" sid="EST 9:9" />nah Parmashta, nah Arisai, nah Aridai, nah Vaizatha, <verse eid="EST 9:9" /><verse number="10" style="v" sid="EST 9:10" />Haman napeidung hangkerei, Hammedatha napei, Jewmedung de ngaurau kelabe, penui gitsetdi. Dede penui teitset kedime ngauraume gu hema ket de tui ma. <verse eid="EST 9:10" /><verse number="11" style="v" sid="EST 9:11" />Cipau nai, Susa kengking reketbam gade mina hang daikie gede teitsetdi bi kecu hegwangpei da sam teugwang beu.<verse eid="EST 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 9:12" />Cine hegwangpei hegwangpui Esther dage rang, “Susa Kengking reketbam gade Jewmedung ne minadung haimengei ge de teitset nah ngkapdi, Haman napeidung hangkerei de si eh. Hegwangpei deuceudung kebang ga, penui daipai tei dino? Nang dai luu no? Nah cide ncu peu zie. Nah nang kie neu kela de dai no? Pecaide, cide teibeu zie.” <verse eid="EST 9:12" /><verse number="13" style="v" sid="EST 9:13" />Nah Esther rangdi, “Magade hegwangpei dade keyi ge lie cai, Susa ga kelung Jewmedung de henai gu hezai de nzwa peu cide ncünne liede peu beu dilo, nah peu Haman napeidung hangkerei de tsingbang gage gwakdi lo.” <verse eid="EST 9:13" /><verse number="14" style="v" sid="EST 9:14" />Nah hegwangpei aide teilu kera rang beudi. Nah hezai ge Susa gage kaigai, nah penui Haman napeidung hangkerei de gwakdi. <verse eid="EST 9:14" /><verse number="15" style="v" sid="EST 9:15" />Cine Susa ga Jewmedung kebamme Adar bekei ziangreimdai benai penui gwang ngkwalu, nah penui Susa ga mina haicum de teitsetdi. Dede penui teitset kedime ngauraume gu hema ket de tui ma.<verse eid="EST 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 9:16" />Nah Jewme kedamedung hegwangpei deuceudung ga kebammedung penui gwang ngkwalu delwe penui teilung gumlu; nah penui ngauraume dade mtaklu, nah penui ngauraume cang riakhenamengei de gitsetlu. Dede penui hema tui ma. <verse eid="EST 9:16" /><verse number="17" style="v" sid="EST 9:17" />Adar bekei ziangreikecum benai: pecai penui mtaklu; cipau kei ziangreimdai dau, pecai penui ketyei kesak nah suiyi tingba ge teilu.<verse eid="EST 9:17" /></para>
  <para style="s">Purim Hengyikelu</para>
  <para style="p">
    <verse number="18" style="v" sid="EST 9:18" />Dede Susa ga kebam Jewmedung cipau kei ziangreikecum benai nah ziangreimdai benai gwang ngkwalu. Nah cipau kei ziangreimengei benai penui mtaklu, nah penui ketyei kesak nah suiyi tingba ge teilu. <verse eid="EST 9:18" /><verse number="19" style="v" sid="EST 9:19" />Ciziemne, Jewmedung, renam ga lungh kebammedung, Adar bekei ziangreimdai de ketyei kesak nah suiyi tingba nah keyi tingba ge mneilu: nah hangge gede mta mapeudung kepeu tingba ge teilu.<verse eid="EST 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EST 9:20" />Nah Mordecai ne ma aidungde raulu. Nah pa laisiudung Jewmedung leune hegwangpei Ahasuerus deuceudung pelane ga kebamme dage langgai beu, kenna ga kebammedung nah kemdei ga kebammedung dage, <verse eid="EST 9:20" /><verse number="21" style="v" sid="EST 9:21" />penui ziemne ndeu gai kera Adar bekei ziangreimdai benai nah ziangreimengei benai tei kecu, mmi ramsang kum, <verse eid="EST 9:21" /><verse number="22" style="v" sid="EST 9:22" />Jewmedung penui ngauraumedung dade mtak kelu tingbadung ge teilu, nah suisiet gade suiyi teu gwang kebeu kei nah kehap gade keyibe tei gwang kebeu tingba ge tei lu, cinzwa eh cidungde ketyei kesak nah suiyi nah mige pe zangbe de mapeudung kepeu, nah teumai kesiame de mapeudung kepeu tingbadung teilu. <verse eid="EST 9:22" /><verse number="23" style="v" sid="EST 9:23" />Nah Jewmedung penui tei cuh kecude, nah Mordecai ne penui dage dai raugai beubi cide luu lu. <verse eid="EST 9:23" /><verse number="24" style="v" sid="EST 9:24" />Kedanemene Haman, Hammedatha napei, Agagme pei, Jewmedung pelane de kereniabe, ngauraube Jewmedung de tei ngkap zingdi kerane heciem riemlu; nah pa Pur (“dacak kecu”) tei gai iciu eh penui lung tei keherei nah penuide tei ngkap dilu kerane. <verse eid="EST 9:24" /><verse number="25" style="v" sid="EST 9:25" />Dede pa hegwangpei dwaga gwang kecu dau, pa rau kenzeu laisiu gade rang eh, “Peu pe mariem kesia Jewmedung ziemne nkim eh pa riem kenzeu de pe dage cailigwang dilo, nah peu penuide pecu nah pe napeidung de tsingbang gage gwakdi lu.” <verse eid="EST 9:25" /><verse number="26" style="v" sid="EST 9:26" />Ciziemne, penui tingba aidungde de, “Purim,” lie qudi, Pur zi ria gade. Ciziemne, rau kenzeu sam riadung pelane gade, nah penui ma aide kengau gade nah penui da ma aide gwang kedi gade, <verse eid="EST 9:26" /><verse number="27" style="v" sid="EST 9:27" />Jewmedung ma aide tei ncuh lu nah penui luu kelu tei lu, nah penui leuh, nah penuide ngngwa ncüt kelu pelane de (nah cide madaude gah dilak) tingbazie aikena de penui kerau ria gade tei gwang kera, nah penuine kedet kelube tingdau tingkum ge cai tingkum ge ria gade. <verse eid="EST 9:27" /><verse number="28" style="v" sid="EST 9:28" />Cine tingbazie aidungde de nsunglu nah cide ceheu ge eh ceheu ge, kelak ge eh kelak ge, deuceu ge eh deuceu ge, nah namdi ge eh namdi ge gage tei lu. Nah Purim tingbazie aidungde au Jewmedung da gade madaude gah dilak, nah penui kensung aide penui leuh da gade penli tei dilak.<verse eid="EST 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EST 9:29" />Pecai hegwangpui Esther, Abihail napui, nah Jewme pei Mordecai, rau kenzeu Purim laisiu kenabe de teu ncuh lu kerane pe kengkieng pelane teu raugai. <verse eid="EST 9:29" /><verse number="30" style="v" sid="EST 9:30" />Nah pa rau kenzeu laisiudung cide Jewmedung pelane dage langgai beu, deuceudung 127 gage, Ahasuerus gwangram gage, kezuyi nah kesangbe samdung, <verse eid="EST 9:30" /><verse number="31" style="v" sid="EST 9:31" />Purim hengyi aidungde penai ne kedet kelu tingdung gage teigai lu kerane, Jewme pei Mordecai nah hegwangpui Esther ne penui ziemne riem kebeu de nzwa eh, nah penai ne penai teilung de cet eh nah penai leuh de cet eh riem kebeu de nzwa eh, kemmwang nah penui kehap ting mnei kelu nzwa eh. <verse eid="EST 9:31" /><verse number="32" style="v" sid="EST 9:32" />Nah Esther ne hezai kai kegai gade Purim zai ndeu kelu teilu.<verse eid="EST 9:32" /></para>
  <chapter eid="EST 9" />
  <chapter number="10" style="c" sid="EST 10" />
  <para style="s">Mordecai Kedi</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 10:1" />Pecai hegwangpei Ahasuerus pe hegwangram pelane ga nah jaaidi duigwadeudung ga maha peu kera kaigai. <verse eid="EST 10:1" /><verse number="2" style="v" sid="EST 10:2" />Nah pe kengkieng nah pe kedi tei kegai tadung leune, Mordecai kedi teikelu ha peciakne hegwangpei ne pecu kedi tei kebeu, Persia penai Media gwangpei kena tingdau hakwak gage cidungde raupwa la meluini?<note caller="+" style="f"><char style="fr" closed="false">10:2 </char><char style="ft" closed="false">1 Heg. 14:19,29; 15:7; 2 Hel. 25:26; 32:32</char></note> <verse eid="EST 10:2" /><verse number="3" style="v" sid="EST 10:3" />Kedanemene Jewme pei Mordecai au hegwangpei Ahasuerus ciabe pekenabe, nah Jewmedung de kakgade kenlangbe, nah pe siname kekiee ge ne penui sui kelabe, pe minadung ziemne keyi ge peei beula nah pe leuhme pelane dage kezuyibe rangbeu la.<verse eid="EST 10:3" /></para>
  <chapter eid="EST 10" />
</usx>