<usx version="3.0">
  <book code="1TH" style="id">EN_ULT en_English_ltr Fri Feb 21 2020 15:48:31 GMT-0500 (EST) tc</book>
  <para style="ide">UTF-8</para>
  <para style="h">1 Thessolonians</para>
  <para style="toc1">Paul ne Thessaloniame Dage Raukegai Laisiu Keraibe</para>
  <para style="toc2">Thessaloniame Keraibe</para>
  <para style="toc3">1 The.</para>
  <para style="mt">1 Thessalonians</para>
  <para style="mt">Paul ne Thessaloniame Dage Raukegai Laisiu Keraibe</para>
  <para style="is">Mraisam</para>
  <para style="ip">Paul pe beuh pekenabe tei keludau Thessalonica ga ngqwa ncuh gai. Pa cika mtakkak kecum ledeu, dede Jewme pecu ngkausüt kedine pa cide püt maisiadi. Timothy dade Thessalonica ha siulwe, Paul laisiu aide Corinth gade raugai (AD 51 dau) Thessaloniame de teingkuu nah penuide Khristian ha ledeu sigai kerane.</para>
  <para style="ip">Paul au Thessaloniame kuu nah “kehereisüt liede” penui kenlumde pütdi kemakne penuide twagai rai. Pa penuide “dainzwa Tinggwang suiyi tei eh lunghlu buibi” ledeu gai. Nah pa penuide Jisu au ngkim eh gwang kera rangmui gai, cine pa gwang kemakta penui matei eh bamlu maikesia ranggai.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Mraisam nah kenggai (1:1-10)</para>
  <para style="io1">Ngqwa ga Paul bata (2:1-3:13)</para>
  <para style="io1">Rampaube gwang kera keledeu (4:1-5:11)</para>
  <para style="io1">Kekambe (5:12-28)</para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="s">Keraisam</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />Paul nah Silvanus,<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">Silvanus: </char><char style="ft" closed="false">Aika nah keda laisiukwakdung ga de (2 Cor 1:19), Paul pa nzang kelamedung kakde mige de Silvanus de qula, dede Silvanus au Bata laisiukwak ga Silas de qukela deda. </char></note> nah Timothy ne Peibe Tinggwang nah Rampaube Jisu Khrista gade Thessalonia namdi ga ngqwabe dage laisiu raukegai.<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Paul ne laisiu aide raugai, nah Silvanus penai Timothy au kelum kegai samdung ga pecu nzang kecu rünne.</char></note> Ngaugia nah lungciep peu nnuida bam kelube tei lulo.<note caller="+" style="f"><char style="ft" closed="false">Kesa kehegwa laisiudung ga </char><char style="fqa">Peu ngaugia nah lungciep anui Pei Tinggwang nah Rampaube Jisu Khrista gade nnuida bam kelube tei lulo, de kecude si.</char> </note><verse eid="1TH 1:1" /></para>
  <para style="s">Thessaloniame kenlum</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />Nnui pelane ziemne anui Tinggwang de twabam muila, nah anui kekie ga nnui ziemne kiebam muila, <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />anui Tinggwang nah Peibe dwade nnui kenlum bata, keku bata, nah anui Rampaube Jisu Khrista gade nnui keregui ntip kebam de nsung eh. <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />Kedanemene Tinggwang kuku kepung sinamedung, pa ne nnuide kedetkelu anui cibam,<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="EPH 1:4">Eph. 1:4</ref></char></note> <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />kedanemene anui samliakeyi de sam rünne gade nnuida teugwang ma, dede kengkieng nah Kemci Rabe gade si nah sam cide kesangsiak lie eh. Anui nnui kakga kelunghdau dainzwa nnui ziuyi ziemne lungh bi kecu cide nnuide cibam. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />Nah nnui anuide nah Rampaube de kerelime tei luda, kedanemene nnui kehereisüt eh samlia cide Kemci Rabe gade nnui suiyisüt eh luu kelune. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />Cide ziemne, nnui Macedonia nah Achaia deuceu ga kenlumme leune ziemne saulia ge teilu da. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />Kesang nnui dade Rampaube sam Macedonia nah Achaia ga rangpet kecu rünne ma, dede nnui Tinggwang de kenlum de heni pelane ga rangla dida. Cine, anui penuide magede rangsi mede yida. <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />Kedanemene penui dainzwa nnui anuide ngngwalu dibi kecu ha, nah nnui dainzwa mamiedung kereca gade Tinggwang da nreu gwanglwe ringkela nah kesang Tinggwang gwa teilu dibi kecu penuikatei rangla kedine, <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />nah pe Na Tinggim gade caili kegwang kwa kera, pa ne ketsai gade kwak nring kelube, Jisu, Tinggwang lunghop gwang kera gade anuide kelikelube.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">Thessalonica ga Paul bata</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />Kedanemene sinamedung, anui nnuida kegwang de kemta ge di kemak nnuikatei de cide cibam. <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />Dede pedwa Philippi namdi gade anuide tei kehereisüt nah teu hengam tei kecu nnui cibam. Nah anuide mi ngaurau süt liede, anui Tinggwang gade kuu eh, Tinggwang samliakeyi de nnui dage ranglia kelu teilu da. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />Kedanemene anui kecung kegaide au petau kemak mede mci kemak mede mide kecwa gade ma. <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />Meliene, Tinggwang anuide luulu eh anuide samliakeyi de mpüt kebeu nzwa, anui mina suiyi tei kerane rang lama, dede Tinggwang, anui mlung kedakpie kelabe suiyi tei kerane rangla. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />Kedanemene nnui ci kebam nzwa, madaude anui ketwa samdung teugwang ma, mede hengin gumlu kera sam teugwang ma, Tinggwang ne anui zierangbe delie. <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />Mede anui mina hetwa peei lama, nnui dade mede mi kedame dade de. <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />Khrista ne langkegaime kecune anui nnui dade kielu kebui anui nzeu bam. Cuide, nnui kakga anui hename nzwadi, mipui ge pe name mapie kebam nzwa, <note caller="+" style="f"><char style="ft" closed="false">Kesa kehegwa laisiudung ga, </char><char style="fqa">Meliene, Anui au mipui ge pe na ma pie kebam nzwa nnui dade nciep la, de eh peila. </char> </note> <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />cine anui nnuide keku ziemne, anui Tinggwang samliakeyi de kerang rünne mene anui teilung de nnuide kaibeu kera anui mtei luda. Kedanemene nnui au anui hungkelame dida kecune. <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />Kedanemene sinamedung, anui dainzwa rei nah heta teibi kecu nnui nsung bam zie, anui Tinggwang dade kegwang samliakeyi nnui dage zierang keteidau, nnui migede de tei nrütdi melu kerane anui tingmui tingba heta tei. <verse eid="1TH 2:9" /><verse number="10" style="v" sid="1TH 2:10" />Nnui nlumkelume kakgade anui daikenzwa gede anui zai mci nah masang nah maumezing bi kecu nnui nah Tinggwang de anui zierang da. <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />Anui nnui hangge ge kecude mipei ge pekatei pe name de ngngwa kelanzwa nnuide ngngwa kecu nnui cibam. <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />Tinggwang, pa nnuide pe hegwangram nah kendu gage qugai kelube, luulu kebui teilung lungh lulo eh nnuide kecung nah teingkuu eh qu gaila.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />Anui Tinggwang de aide ziemne twabam muila, cide cai, nnui anui dade Tinggwang sam siu kelude mina sam nzwa luu luma, dede Tinggwang sam lie de luulu, cide au kesang delu, nah cide nnui nlumkelume da heta teibam. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />Kedanemene nnui, sinamedung, Judea deuceu ga Khrista Jisu da kebam Tinggwang ngqwadung de kerelime tei luda. Penui keherei kecu nzwa, nnui de nnui ramme dade keherei da, penui de Jewme dade keherei kecu nzwa, <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />Rampaube Jisu de nah caihakecime de teitset kedime, nah anuide teikeherei nah Tinggwang suiyi teila kemakme nah penui au mina pelane de ngaurau la. <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />Penui anuide peu Gentileme dage kelikelu hade zierang tei laklie eh kaam, iciu eh penui katei penui maudung teipui bam muila. Dede kamtu ga Tinggwang lunghop penui reuga gwang bam dida.<verse eid="1TH 2:16" /></para>
  <para style="s">Paul Thessaloniame de ngaugaineu bamkedi</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />Dede, sinamedung, nnui dade anui tingkak nage helungbe gade mene pumteih gade lamna di. Anui nnuide reguisüt eh gwang nnuide kezungau dai kera reguisüt bam. <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />Kedanemene anui nnuida cailigwang neusüt, kesang Ih, Paul, piage rünne mene mana de mie kera tei, dede Satan ne anuide kaamdi. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />Anui Rampaube Jisu caili kegwangdau, nnui ziemne mecai? Pe dwade anui daipai regui mede suiyi mede hetwa punglu kebui bamno? <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />Kedanemene nnui au anui kendube nah anui suiyibe kecune.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />Kekambe dau, anui lia si gailak dige, anui Athens namdi ga anuikatei bamdi kecube yiki kera cetlu, <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />nah anui anui sinabe Timothy nah Khrista samliakeyi dega Tinggwang kilabe, de peu nnui kenlum teingkieng lu nah nnui lung teingkuu lu kerane nnui dage langgai la, <note caller="+" style="f"><char style="ft" closed="false">Kesa kehegwa laisiudung, </char><char style="fqa">Anui sinabe nah Khrista samliakeyi ga Tinggwang ziemne ngngwa hekang eh heta keteibe Timothy de anui langgai la, de eh peeila.</char> </note> <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />iciu eh migede de lungrei aidungde ziemne kebwakdi melu kerane. Kedanemene aide ziemne anuide kedetkelu nnuikatei cide cibam delu. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />Kedanemene anui nnuide ngngwa kebamdau, anui keherei zielie eh nnuide mrairang beudi delu, nah nnui cikebam nzwa, cinzwa teigwang da. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />Aide ziemne, Ih lia gailak dige, Mdakkepie <note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="fq" closed="false">Mdakkepie: </char><char style="ft" closed="false">Herakesiabe</char></note>ne nnuide kedeidi kera kehing ne nah anui ta kemta teidi melu kerane, nnui kenlum ha cilu kera Ih Timothy de langgai.<verse eid="1TH 3:5" /></para>
  <para style="s">Timothy helungtaukemla sam teukegwang</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />Dede cu Timothy nnui dade anuida gwang luda, nah nnui kenlum nah keku samkeyi anuida teugwang cang beuda. Pa nnui anuide nsung bammui lalie kecu nah anui nnuide kerengau gaineu kebamde nzwa nnui de anuide ngau gaineu eh kela anuide pau beuda. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />Aide ziemne, sinamedung, anui lungrei nah keherei kecu leune ga, nnui kenlum ziemne anui lungtaumla luda. <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />Kedanemene nnui Rampaube da sap ntip bamcai, anui cu au ringbam di delu. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />Anui Tinggwang dwade nnui ziemne suiyi ngaukelu leune ziemne, anui dai ketwa gede Tinggwang de nnui ziemne peu laino? <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />Nnuide gwang kezungau dailu kerane, nah nnui kenlum cang kemak ga kaibeulu kerane, tingmui tingba anui laikai tei eh kie bamla.<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />Cu anui Peibe Tinggwang, nah anui Rampaube Jisu de anuide peu nnuida gwang kera lampui saulia kelube tei lulo. <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />Nah peu Rampaube de nnui hangge gede nah mileune de kereku kecude teingkiee nah kepui tei kelube tei lulo, anui keku nnui ziemne kepui tei kebam nzwa. <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />Peu pecu nnui lung teingkieng kelube tei lulo, iciu eh nnui anui Rampaube Jisu pe kemcime dungde ngngwalwe caili kegwangdau, anui Tinggwang nah Peibe dwade nnui lung mci nah mmaugai kelakme teilu kerane. Amen!<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">Tinggwang suiyi ketei teilung</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />Cine kamtube, sinamedung, nnui tei kebam nzwa, nnui dainzwa tetgwang eh Tinggwang suiyi tei maisiabi kecu nnui anui dade cikelu nzwa, ci swade teisi lo, anui nnuide Rampaube Jisu zi gade kecung eh kie gaila. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />Kedanemene anui Rampaube Jisu zi gade nnuide daipai ledeu beubi kecu nnui cibam lu. <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />Kedanemene Tinggwang lungning au peu nnuide mcilu<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="fq" closed="false">Peu nnuide mcilu kera: </char><char style="ft" closed="false">Nnui mcilu kera au Tinggwang lungning nah pe aja da.</char></note> kera nah kemmha gade peu nnuide kezeulu kera; <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />nnui hangge ge kecu mci nah hetwa pung eh nnui penau teilu kera ci kera, <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />Tinggwang de ci kemakme Gentileme nzwa kemmha ta kehengin gade mene; <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />peu migede de makie aide ga hezai gikah, nah pe sinabe de petau kemakdung tei diso. Kedanemene anui nnui dage mrairang beu eh zierang tei kebeu nzwa, Rampaube ma aidungde peciakne kum keteibe kecu ziemne.<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 94:1">Lei. 94:1</ref></char></note> <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />Kedanemene Tinggwang anuide mcikemak gage qugai ma, dede kemci gage. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />Ciziemne, keheibede aide de mlai kelame mina de mlai bam ma, dede Tinggwang de, nnuide pe Kemci Rabe peu kelabe de.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />Dede caihereiswacing kereku kecude, anui nnui dage magede raugai mede yida, kedanemene hangge gede kereku kera Tinggwang ne nnuide ledeubeu dida kecune. <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />Nnui Macedonia deuceu leune ga kela siname peciakne ziemne aidungde tei kesang gaida. Dede sinamedung, aiswade teisi lo eh anui nnuide kecung gaila, <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />nah anui nnuide ledeu kebeu nzwa, zingde lungh kera gage ka gailu, nah nnuikatei nnui ta teilu, nah nnui bale matei lulo, <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />iciude nnui nlumkemakme dwade tet teune lu kerane nah nnui kenaang gede bamta dilu kerane.<verse eid="1TH 4:12" /></para>
  <para style="s">Rampaube cailikegwang</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />Dede sinamedung, anui peu nnuide zip kedimedung ha ci mene peu bamneu ma, ciciu eh keregui kegahme nzwa nnui suisiadi melu kerane. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />Kedanemene anui Jisu tsailwe ringcuhdai kedi nlum la, cine Jisu cailigwang kecudau, Tinggwang kenlumme zip kedimedung de pecu ngngwa cailigwang daizie. <verse eid="1TH 4:14" /><verse number="15" style="v" sid="1TH 4:15" />Kedanemene anui Rampaube sam gade aide nnui dage rangla, cide anui ring kebamme, Rampaube gwangdai kera ga bang kebamme, zip kedimedung dwarai eh tetlak. <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />Rampaube tinggim gade nghung zie. Pa ma sahbak gai eh gwang zie, tinggimgwame kedibe aja kai gaizie, nah Tinggwang teluibe kwagai zie, nah Khrista da la eh tsaikedime ringcuh raizie. <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />Pecai anui ring kebamme, bang kelume, penuide ngngwa nghang hemwa gade keu ncütlwe tingkai gade Rampaube de redau zie. Iciu eh anui Rampaube de ngngwa lamui dizie. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />Ciziemne, sam aidungde teu eh hange ge lung taumla lulo.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />Cu sinamedung, peting nah pehidung<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="fq" closed="false">Peting nah pehidung: </char><char style="ft" closed="false">Aide aika Rampaube Jisu gwang kera de rangbam.</char></note> ziemne, anui nnui dage magede raugai maikesia ge meda. <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />Kedanemene Rampaube caili kegwang tingba au keregame ge tingmui ne gwang kela nzwa gwang kera nnui ci hemisüt bam. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />Minadung, “Kezuyi nah lungciep bam,” de rang kebamdau, zette kengkap, mipui tetlak kelame hena tedteei teei gwang kela nzwa penuida gwang zie. Nah penui madaude pak gailak.<note caller="-" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="MAT 24:37-39">Mat. 24:37-39</ref></char></note> <verse eid="1TH 5:3" /><verse number="4" style="v" sid="1TH 5:4" />Dede sinamedung, nnui au cipau tingba de de peu keregame kegwang nzwa nnuide keheu kera kemui ga bam meda. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />Kedanemene nnui peciakne kebaabe name nah ting kebaabe name kecune. Anui tingmui gu mede kemuibe gu ma. <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />Cine, anui kedame nzwa zip kerabe ma. Meliene, anui mrak nah mcing bam lugo. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />Zip kelame, tingmui zip la, nah sakmie kelame, tingmui mie bamla. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />Dede anui au tingkebaa gu kecu ziemne, anui mcing bam eh kenlum nah keku hekarakcum de kailu maisia nah kelikelu keregui dele anui peurwa teilwe bam maisia.<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="ISA 59:17">Isa. 59:17</ref></char></note> <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />Kedanemene Tinggwang anuide lunghop ziemne kedet luma, dede anui Rampaube Jisu Khrista gade kelikelu ngaulu kerane. <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />Anui ziemne pa delie, iciu eh anui ringbam mede tsaidi liede, anui pecu ngngwa lunghlu kerane. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />Cine nnui teibam kela nzwa, hange ge lung taumla nah ket ket de ngha bam lulo.<verse eid="1TH 5:11" /></para>
  <para style="s">Ledeukegai kekambe</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />Dede sinamedung, nnui kakga mata tei kelamedung de nah Rampaube gade nnui reuga kebamme nah nnuide ledeu kelamede rüt lulo eh, anui nnui dade kiela, <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />nah penui batadung ziemne penuide kusüt eh kerüt peu lulo. Nnui kakga kezuyi eh bamlu. <verse eid="1TH 5:13" /><verse number="14" style="v" sid="1TH 5:14" />Nah sinamedung, petau teikemakme de rang mriaklu, pelung kesiame lung teingkuu lu, kemneime de nghalu, nah mileune dade helungtie lulo, anui nnuide kecung gaila. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />Migede petau kemakpe ziemne petau kemakpe le tei gwa melu kerane mriaklu, dede hangge ge dage nah pelane dage keyibe tei kera peei muilu.<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="1PE 3:9">1 Pet. 3:9</ref></char></note> <verse eid="1TH 5:15" /><verse number="16" style="v" sid="1TH 5:16" />Nnui suiyi lamui lulo. <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />Mtak mene kielu. <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />Maleune gade Tinggwang de hetwa peulu. Kedanemene aide Khrista Jisu gade nnui ziemne Tinggwang lungning kecune. <verse eid="1TH 5:18" /><verse number="19" style="v" sid="1TH 5:19" />Kemci Rabe de tei mmüt diso. <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />Caihakecisamdung de mlai diso. <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />Ma pelane kedakpie lu. Keyibe kerak teu bamlu. <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />Makesia leune gade mbai dilu.<note caller="-" style="x"><char style="xo" closed="false">5:22 </char><char style="xt" closed="false"><ref loc="PHP 4:8">Php. 4:8</ref></char></note><verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />Lungciep Tinggwang depeu nnuide tei mci cangbeu kelube teilo; nah nnui rabe, nah keringria, nah mipum de peu yicangsiak nah kemau gede gah eh anui Rampaube Jisu Khrista cailikegwang dau bam kelube tei lulo. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />Nnuide qu kelabe au samsang, nah pa cide tei beuzie.<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />Sinamedung, anui ziemne de kielu.<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />Siname pelane de kemci hemam teu kelum gailo.<note caller="-" style="x"><char style="xo" closed="false">5:26 </char><char style="xt" closed="false"><ref loc="ROM 16:16">Rom. 16:16</ref>, <ref loc="1CO 16:20">1 Cor. 16:20</ref>, <ref loc="2CO 13:12">2 Cor. 13:12</ref></char></note> <verse eid="1TH 5:26" /><verse number="27" style="v" sid="1TH 5:27" />Ih laisiu aide kenlummedung pelane dage peilia gailo de nnuide Rampaube zi gade nlum sünne gaila.<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />Anui Rampaube Jisu Khrista ngaugia depeu nnuida bamlu lo.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>