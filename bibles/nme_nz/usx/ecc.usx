<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Zeme(N) Bible Project</book>
  <para style="toc3">Kel.</para>
  <para style="toc2">Keledeube</para>
  <para style="toc1">Keledeube Laisiukwak</para>
  <para style="mt">Ecclesiastes</para>
  <para style="mt">Keledeube Laisiukwak</para>
  <para style="is">Mraisam</para>
  <para style="ip">Keledeube mina teilung ha mcet gai. “Keledeube” macisam, kehegakecu, kengkieng, mahei, renet, nah kedadung pie mcet gai. Ma aidung pelane pe keyi au lalie nah cidung au peting dau nah pebam petau kecu ga au pe keyi bam, dede pe keyi bamtie lubui magade Tinggwang ne mina teilungh sum ga balie cai. Tinggwang de hetwa nah herüt nah Tinggwang gwaketei ga samsang siak kecude mina teilung gade mlangtube lie. Tinggwang si mecai, “Keledeube” rangla, maleune pekiegah.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Teilung au pekie gah lie (1:1-11)</para>
  <para style="io1">Maci penli (1:12-2:26)</para>
  <para style="io1">Maleune peting ge bam (3:1-22)</para>
  <para style="io1">Misuitakedi nah nnung cang kebam (4:1-5:20)</para>
  <para style="io1">Teilung aide au nnung cang kemak (6:1-8:17)</para>
  <para style="io1">Maci teu teilung kezeukela (9:1-10:20)</para>
  <para style="io1">Maci kesangbe Tinggwang mie kehing (11:1-12:14)</para>
  <chapter number="1" style="c" sid="ECC 1" />
  <para style="s">Maleune Pekiegah</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1" />Sam aidungde Keledeube, David leuhme nah Jerusalem ga hegwangpei gu samdung. <verse eid="ECC 1:1" /><verse number="2" style="v" sid="ECC 1:2" />Keledeube aide rangla.</para>
  <para style="q1" vid="ECC 1:2">“Mwangzui ge nzwa,</para>
  <para style="q2" vid="ECC 1:2">tingkai kenciep guirui ge kenzwa,</para>
  <para style="q1" vid="ECC 1:2">maleune gah dila, keteu gai kera kekieege püt diak gai.<verse eid="ECC 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 1:3" />Minadung tingnaimiak kanggade bata kehung tei kegai pelane gade dai ge gie luno?<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">1King 4:32 </char></note><verse eid="ECC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 1:4" />Ceheu ge tetdi,</para>
  <para style="q2" vid="ECC 1:4">nah ceheu kedage gwang dai, <note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="fq" closed="false">Ceheu ge tetdi, nah ceheu kedage gwang dai, </char><char style="ft" closed="false">kecingme tsaidi ge ngienadung de mna dailu</char></note></para>
  <para style="q1" vid="ECC 1:4">dede kideube au pelui pela kelungta bamla. <note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">Hos. 11:4, Phil. 3:1-12, Lei. 45:14</char></note><verse eid="ECC 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 1:5" />Tingnaimiak cuhlu,</para>
  <para style="q2" vid="ECC 1:5">nah cide nlüt dai dila</para>
  <para style="q1" vid="ECC 1:5">nah kelwa eh cide cuh dai kera ni ga cailigwang dai dila.<verse eid="ECC 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 1:6" />Tingkai tingbangle ge guigai</para>
  <para style="q2" vid="ECC 1:6">nah tingtünle ge gui nrui gwang gaila,</para>
  <para style="q1" vid="ECC 1:6">cide pe lampui gade nrui eh bammuila</para>
  <para style="q2" vid="ECC 1:6">nah cailigwang dai la.<verse eid="ECC 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 1:7" />Hereuki pelane jaaidi gage lwa gaila,</para>
  <para style="q2" vid="ECC 1:7">dede jaaidi cide madaude puidi lama.</para>
  <para style="q1" vid="ECC 1:7">Hereukidung lwa mie kela ga,</para>
  <para style="q2" vid="ECC 1:7">cika lwagai dai dila.<verse eid="ECC 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 1:8" />Maleune de leu eh nnei dila,</para>
  <para style="q2" vid="ECC 1:8">nah migede cide rangkecai lia lu kera gah.</para>
  <para style="q1" vid="ECC 1:8">Mimiak ma ngau kegaidung dele nnunglu lama,</para>
  <para style="q2" vid="ECC 1:8">mede mikwen ma siu kegaidung dele nnunglu lama.<verse eid="ECC 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 1:9" />Daipai teigwang bi cide teidai zie,</para>
  <para style="q2" vid="ECC 1:9">nah dai dungge teidi debi, cide teidai zie.</para>
  <para style="q1" vid="ECC 1:9">Tingnaimiak kangga magede keheci gede gah.<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">2 Hel. 1:16</char></note><verse eid="ECC 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 1:10" />Ma keheibe ziemne de,</para>
  <para style="q2" vid="ECC 1:10">‘Pielo, aide ma keheci geda,’ de eh ranglu kera bamni?</para>
  <para style="q1" vid="ECC 1:10">Daidung ge bamdi debi, cide ndaa tingtie gade bam dida,</para>
  <para style="q2" vid="ECC 1:10">cide anui dwa tingtie ceheudung gade bam dida.<verse eid="ECC 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 1:11" />Ndaa tingdau tei kedibe migede nsung bam lama,</para>
  <para style="q2" vid="ECC 1:11">nah cipaucai ne tei kedibedung de</para>
  <para style="q2" vid="ECC 1:11">nah aipau cai teigwang kerabedung de</para>
  <para style="q1" vid="ECC 1:11">cidungde nsung bam kera gede nzwa ma.”<verse eid="ECC 1:11" /></para>
  <para style="s">Maci au Pekiegah</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12" />Ih keledeume ge, nah Ih Jerusalem ga Israelme reu hegwangpei. <verse eid="ECC 1:12" /><verse number="13" style="v" sid="ECC 1:13" />Ih maci teu eh tinggim kangga kebam maleune pie nah peei kera a lungcet petlu. Kepeei tah cide hetah kehung ge Tinggwang ne mina namedung de peu naang bam lu kera kaigai. <verse eid="ECC 1:13" /><verse number="14" style="v" sid="ECC 1:14" />Ih tingnaimiak kang gade bata tei kela leune ngauda, nah pielo, cidungde pelane de mwangzui ge nah tingkai gede gwazui kelage nzwa da.<verse eid="ECC 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 1:15" />Kengkoibe de tei nzui dai gailak!</para>
  <para style="q1" vid="ECC 1:15">Gah kedibe de pei gailak! <verse eid="ECC 1:15" /><verse number="16" style="v" sid="ECC 1:16" />Ih akatei acu rang eh, “Pielo, Jerusalem ga a dwa lungh kedimedung pelane swade kemteu Ih ngau kieeki luda. A lungcet gade kemteu nah maci kedi Ih ngau da.” <verse eid="ECC 1:16" /><verse number="17" style="v" sid="ECC 1:17" />Cine Ih kemteu, herakemie nah kemiedung cilu kerane a lungcet pet luda. Aide de tingkai gede gwazui kera mtei kegai ge nzwa kecu Ih cilu. <verse eid="ECC 1:17" /><verse number="18" style="v" sid="ECC 1:18" />Kedanemene, kemteu kiee kebam ga lungrei de kiee la, nah maci kiee kelame, cipaume suisiet de kieeki.<verse eid="ECC 1:18" /></para>
  <chapter eid="ECC 1" />
  <chapter number="2" style="c" sid="ECC 2" />
  <para style="s">Kehega kecu Pekiegah</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1" />Ih akatei acu ranggai, “Cu au gwanglu, Ih ncu suiyi le pwane kedak pie zie da. Cine suiyi teu kehega lu.” Dede pielo, ma aide de bam tie kemak tingkai kenciep ge gwale ma. <verse eid="ECC 2:1" /><verse number="2" style="v" sid="ECC 2:2" />Ih kenui ha ranggai, “Cide au kemie ge,” nah kehega kecu ha de, “Cide daitei lubui bam no?” <verse eid="ECC 2:2" /><verse number="3" style="v" sid="ECC 2:3" />Ih zau le pwane a lungsui suiyi teilu kera cet eh teigai. Ih kemie herak teu bamreu liede, kemteu le pwane a kecet de teuswa kera peu. Ih tinggim kangga minadung penui teilung tingba ziedung ga penui daipai tei de yi zie bi Ih cineu eh peei.<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="ft" closed="false">Rev. 22:1-2</char></note> <verse eid="ECC 2:3" /><verse number="4" style="v" sid="ECC 2:4" />Ih ma kedidung tei luda. Ih akatei a ziemne kidung tei luda nah kube luhdung de ling luda. <verse eid="ECC 2:4" /><verse number="5" style="v" sid="ECC 2:5" />Ih akatei a ziemne heguriedung nah mtakbamdung teilu; Ih cikage matsibang ketsamtsam linglu da. <verse eid="ECC 2:5" /><verse number="6" style="v" sid="ECC 2:6" />Ih hegung ga tsingbang lungh kebam bedung de dui hetau kerane tekwadung teilu. <verse eid="ECC 2:6" /><verse number="7" style="v" sid="ECC 2:7" />Ih kilabaangme mipei nah mipui de luilu; kilabaangme a hegwangki gade mna kelube de bam. A dwa Jerusalem ga hegwang teigwang kedime leune swade agu makaune hau nah kauruine kieeki bam.<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">Sol 3:5, 8:4</char></note> <verse eid="ECC 2:7" /><verse number="8" style="v" sid="ECC 2:8" />Ih akatei a ziemne rangkanggeu nah kecakdung, hegwangme nah deuceudung gu mabamdung hekwalu. Ih akatei a ziemne lei keteime mipui de nah mipei de teugwanglu, mina namedung suiyi teilu kelame, nah nauseupui kekieege. <verse eid="ECC 2:8" /><verse number="9" style="v" sid="ECC 2:9" />Cine Ih Jerusalem namdi ga a dwa kelungme leune swade diki nah mahei kieeki, nah a maci a da bam jüja bam.<verse eid="ECC 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 2:10" />A miak dai ngauneu labi,</para>
  <para style="q2" vid="ECC 2:10">Ih cidungde dade kezeudi ma.</para>
  <para style="q1" vid="ECC 2:10">Ih a mlung suiyi leune gade acu kezeudi ma,</para>
  <para style="q2" vid="ECC 2:10">kedanemene Ih a bata kehung leune ga a mlung suiyi bam kecune</para>
  <para style="q2" vid="ECC 2:10">nah kehega kelu suiyi le pwane a bata ziehi de kecune.<verse eid="ECC 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 2:11" />Iciu eh Ih a ba le teicang kelu batadung pelane piegai,</para>
  <para style="q2" vid="ECC 2:11">nah Ih heta tei kelubedung de piegai,</para>
  <para style="q1" vid="ECC 2:11">dede, maleune de mwangzui ge nah tingkai de gwazui kela ge nzwa.</para>
  <para style="q2" vid="ECC 2:11">Tingnaimiak kangga kebam cika magede kemmi gah.<verse eid="ECC 2:11" /></para>
  <para style="s">Maci nah Kemie au Pekiegah</para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 2:12" />Iciu eh Ih kemteu,</para>
  <para style="q2" vid="ECC 2:12">nah herakemie nah kemie ha nreu gwang cet gai.</para>
  <para style="q1" vid="ECC 2:12">Hegwangpei aipaude cai gwanglai kezeu hegwangpei daipai tei lubui zeureu no,</para>
  <para style="q2" vid="ECC 2:12">kedanemene cidungde tei ciak dide kecune?<verse eid="ECC 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 2:13" />Ge cu au Ih cilu zeuda</para>
  <para style="q2" vid="ECC 2:13">kemteu au kemie swade yiki lie kecu,</para>
  <para style="q2" vid="ECC 2:13">kebaa au kemui swade yiki kecu nzwa.<verse eid="ECC 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 2:14" />Makecibe au pa daiga tetla bi cila,</para>
  <para style="q2" vid="ECC 2:14">dede kemiebe au kemui ga tet lala,</para>
  <para style="q1" vid="ECC 2:14">ciuliede penui pelane da teigwang kera nsam zie kecu Ih cibam.<verse eid="ECC 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 2:15" />Pecai Ih mninggai,</para>
  <para style="q2" vid="ECC 2:15">“Kemieme da daipai tei bi,</para>
  <para style="q2" vid="ECC 2:15">cide a dage de teigwang zie.</para>
  <para style="q1" vid="ECC 2:15">Cine pe kentsam dai ge bam no Ih macisüt bam liede?”</para>
  <para style="q2" vid="ECC 2:15">Ih a lung gade samcaklu,</para>
  <para style="q2" vid="ECC 2:15">“Aide de mwangzui kenzwa ge gwale ma.” <note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">Lei. 80:8-13, Eze. 13:4</char></note><verse eid="ECC 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 2:16" />Kedanemene makecibe pei de, kemiebe de nzwa, petingtie nsungla lama.</para>
  <para style="q2" vid="ECC 2:16">Gwang kera tingbaziedung gade maleune de peting ketie ge gade nsungta dizie.</para>
  <para style="q1" vid="ECC 2:16">Kemiebe de nzwa makecibe pei de tsai dizie.<verse eid="ECC 2:16" /></para>
  <para style="s">Hetaketei au Pekiegah</para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 2:17" />Cine teilung aide Ih ngkaula kedanemene tingnaimiak kanggade bata tei kegai pelane de a ziemne au sia kecune. Aide au kedanemene maleune de mwangzui ge nah tingkai de gwazui kera riem kela ge nzwa kecune. <verse eid="ECC 2:17" /><verse number="18" style="v" sid="ECC 2:18" />Ih tingnaimiak kanggade mata tei eh a bata teicang kelu pelane pwa a suiyi luma, kedanemene a cai lungh leu kerabe dage Ih cidungde püt diak gai bi dizie kecune. <verse eid="ECC 2:18" /><verse number="19" style="v" sid="ECC 2:19" />Kedanemene caune cilu lai pa kemriakme ge ziemi kemieme ge ziebi kecu? Iciuliede Ih a bata nah a maci le teikelu pelane reu pane pempaube tei zie lu. Aide de mwangzui ge nzwa da. <verse eid="ECC 2:19" /><verse number="20" style="v" sid="ECC 2:20" />Cine, Ih tingnaimiak kanggade a bata tei kelu leune reu gage a lung keherei cuh di. <verse eid="ECC 2:20" /><verse number="21" style="v" sid="ECC 2:21" />Kedanemene mige kemteu, maci nah heciemkeyi teu eh mata tei bam lubui, dede pa pe da kebam pelane mige cide magede teigai kemak ge dage pütdiak gaibeu dizie kecune. Aide de mwangzui ge nzwa nah suisiet kedi ge. <verse eid="ECC 2:21" /><verse number="22" style="v" sid="ECC 2:22" />Kedanemene mige tingnaimiak kanggade nrisüt eh pa mata tei nah pelung kai süt eh pe bata teicang kera tei kegai ziemne pa dai kemmi ge ngaulu di no? <verse eid="ECC 2:22" /><verse number="23" style="v" sid="ECC 2:23" />Tingba ramsangne pe tahdung au keherei nah leu, cine pe rabe tingmui kemtak ngaulu ta dila. Aide de mwangzui ge nzwa da. <verse eid="ECC 2:23" /><verse number="24" style="v" sid="ECC 2:24" />Mige ntaku eh tyei nah sak eh pe ziemne yi kerabe tahdung tei eh mnung kebambe swade magede keyi bam sima. Ma kesang aide Tinggwang ba gade kegwang Ih ngau da. <verse eid="ECC 2:24" /><verse number="25" style="v" sid="ECC 2:25" />Kedanemene, cauge matyei lu lai mede cauge suiyi gede ngaulu lai no, a Tinggwang dade meliecai? <verse eid="ECC 2:25" /><verse number="26" style="v" sid="ECC 2:26" />Kedanemene mi keheibe de pe suiyi teilu kelame, Tinggwang pecu kemteu, maci nah suiyi peula. Iciuliede, kemaume de au pa keu kehekwa nah keu kehebau tah tei kera peula, iciu eh pa cide Tinggwang suiyi tei kelabe de peu dilu kerane. Ma aide de mwangzui ge nzwa da nah tingkai de gwazui kera riem kela ge da.<verse eid="ECC 2:26" /></para>
  <chapter eid="ECC 2" />
  <chapter number="3" style="c" sid="ECC 3" />
  <para style="s">Maleune Peting ziemne Peting ge</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 3:1" />Kedanemene ma pelane ziemne peting ge riet pwabam, nah tinggim kangga ma keheibe ziemne peting pehi ge bam. <note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">Isa. 3:1</char></note><verse eid="ECC 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 3:2" />Kemna ting ge bam, nah tsai kera ting ge bam,</para>
  <para style="q1" vid="ECC 3:2">keling ting, nah kepai ting,<verse eid="ECC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 3:3" />dapketset ting nah tei kengkei ting,</para>
  <para style="q1" vid="ECC 3:3">tei kengkau ting nah teicuh kecu ting.<verse eid="ECC 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 3:4" />Kehap ting ge bam nah kenui ting ge,</para>
  <para style="q1" vid="ECC 3:4">lungrei ting nah helim ting,<verse eid="ECC 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 3:5" />tangtsu kelien kera ting nah tangtsu kehekwa ting,</para>
  <para style="q1" vid="ECC 3:5">mi kedame gede kehemam ting, nah kehemam gade nzia kecu ting.<verse eid="ECC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 3:6" />Ma peei kera ting ge bam nah peei tadi kera ting,</para>
  <para style="q1" vid="ECC 3:6">ma kai nzeu kera ting nah kelien gidi kera ting,<verse eid="ECC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 3:7" />pai teikehak ting nah pai keretak ting,</para>
  <para style="q1" vid="ECC 3:7">zingde bam kera ting nah marang kera ting.<verse eid="ECC 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 3:8" />Kereku kera ting ge bam nah kengkau ting,</para>
  <para style="q1" vid="ECC 3:8">hereu ting nah kezuyi ting. <verse eid="ECC 3:8" /><verse number="9" style="v" sid="ECC 3:9" />Makam tei kelame ge pa pe bata gade daige mmi lu dino? <verse eid="ECC 3:9" /><verse number="10" style="v" sid="ECC 3:10" />Tinggwang ne minadung de mata teicang lulo pwapeu kebeu tahdung Ih ngau da. <verse eid="ECC 3:10" /><verse number="11" style="v" sid="ECC 3:11" />Peting petausiak ga zeutu kerabe Tinggwang teigai. Pa kelungta kering de penui lung gage kaigai beu. Dede mina be Tinggwang tei kegai bata de cet cicang luma, penui kendeu gade gwang penli ga kecang de. <verse eid="ECC 3:11" /><verse number="12" style="v" sid="ECC 3:12" />Mi keheibe de pesui yi kebam nah ringkebam dau ge makeyi tah teibam kecude swa keyi bam si kemak Ih cibam, <verse eid="ECC 3:12" /><verse number="13" style="v" sid="ECC 3:13" />nah iciu eh mileune de tyei nah sak maisia, nah pe batadung leune gade makeyi gwang kelu teu kehega lu kera cilu maisia. Aide au Tinggwang dade mapeu ge. <verse eid="ECC 3:13" /><verse number="14" style="v" sid="ECC 3:14" />Tinggwang daige teigai bi cide kelungta bam kela Ih ci. Magede cikage kaisi mede keuteu di gailak, kedanemene cide au Tinggwang ne teigai, iciu eh minadung herüt teu eh peda gwanglu kerane.<verse eid="ECC 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 3:15" />Daidung ge teibam bi cidungde tei kedibe dida;</para>
  <para style="q2" vid="ECC 3:15">daidung ge teigwang kerabe bi cidungde tei kedibe ge dida.</para>
  <para style="q1" vid="ECC 3:15">Tinggwang minadung de peu ma hebai kenzeube peei kerane teigai.<note caller="+" style="f"><char style="ft" closed="false">Tinggwang minadung de peu ma hebai kenzeube peei</char><char style="fqa">de mene,</char> keda keheci laisiukwak ga aipau de tsamceu eh tei pwa bam. </note> <verse eid="ECC 3:15" /><verse number="16" style="v" sid="ECC 3:16" />Tingnaimiak kangga kemzuibe bam kera ga makesiabedung kebam Ih ngau da, nah makesangbe bam ga, makesiabedung bam. <verse eid="ECC 3:16" /><verse number="17" style="v" sid="ECC 3:17" />Ih mninggai, “Tinggwang au makesangme nah kesiame de penui bata leunedung ziemne peting siakdau penui tu tiakzie.” <verse eid="ECC 3:17" /><verse number="18" style="v" sid="ECC 3:18" />Ih mninggai, “Tinggwang minadung de kedakla penui au makaune ge nzwa kecu keulia kerane.” <verse eid="ECC 3:18" /><verse number="19" style="v" sid="ECC 3:19" />Kedanemene mina namedung caiha nah makaune caiha au penui ziemne nzwakap. Mige tsit au mi kedame ge tsit nzwa. Penui ziemne au penui cuingi pekiene de nzwakap. Makaune reu mina magede yi kentwa gede gah. Kedanemene ma pekiene cuingi rünne ge meluini? <verse eid="ECC 3:19" /><verse number="20" style="v" sid="ECC 3:20" />Ma pelane de heni ket gage tetgai la. Maleune de rebui gade gwang, nah maleune de rebui ga caili dizie. <verse eid="ECC 3:20" /><verse number="21" style="v" sid="ECC 3:21" />Mina rabe nreule ge tet gaila mi nah makaune rabe kideu kangle ge tetgai labi kecu caune cilu lai? <note caller="+" style="f"><char style="ft" closed="false">Kesa laisiukwakdung ga </char><char style="fqa">mina rabe, nreule ge tet gaila, nah makaune rabe, ngkangle kideu ga nghung la bi kecu cau ne cilu lai no? </char> </note> <verse eid="ECC 3:21" /><verse number="22" style="v" sid="ECC 3:22" />Cine Ih cidai kelu au, keheibe de pe bata ziemne pesui yi kelabe swade makeyi gede gah da, kedanemene cide au peu pecu tei kerane nlum gai beu di delu. Pa tsai kedi cai daitei zeubi kecu pie kerane caune pecu teu cailigwang luzie no?<verse eid="ECC 3:22" /></para>
  <chapter eid="ECC 3" />
  <chapter number="4" style="c" sid="ECC 4" />
  <para style="s">Minekemneu, Hetaketei, Zangna kegah</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1" />Tingnaimiak kangga keherei kebam pekiene ha Ih piage cet gai dai.</para>
  <para style="q1" vid="ECC 4:1">Nah ainie, keherei kebamme miakduidung,</para>
  <para style="q2" vid="ECC 4:1">nah penui lung taumla gai kera migede gah!</para>
  <para style="q1" vid="ECC 4:1">Kengkieng au penuide teikeherei kelame ba ga bam,</para>
  <para style="q2" vid="ECC 4:1">nah migede penui lung taumla kera gah di! <note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">Pro. 5:19</char></note><verse eid="ECC 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 4:2" />Cine Ih au tsai kedime dele pwane</para>
  <para style="q2" vid="ECC 4:2">cu ring kebammedung swade penui raci ki lie cet lala.<verse eid="ECC 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 4:3" />Iciuliede, penai swa ngngim ki kecu au lungh gwang kemakme,</para>
  <para style="q2" vid="ECC 4:3">tingnaimiak kangga makesia tah ketei gede ngaugai kemakme. <verse eid="ECC 4:3" /><verse number="4" style="v" sid="ECC 4:4" />Iciu eh bata tei kegai leune nah heciem keyi bata leune ga kidabe lungnyimei di kela Ih ngau da. Ma aide de mwangzui ge nzwa da nah tingkai de kwa eh kum kela ge nzwa da.<verse eid="ECC 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 4:5" />Kemieme ge pe ba tuipwa eh bamla nah mata tei lama,</para>
  <para style="q2" vid="ECC 4:5">cine pe taktyei au pekatei pe pumteih deda.<verse eid="ECC 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 4:6" />Dede ziune eh heta tei eh ma kecam nage mmi kelube yiki reu</para>
  <para style="q2" vid="ECC 4:6">ba na le heta tei eh tingkai de kum kera tei kecu swa au. <verse eid="ECC 4:6" /><verse number="7" style="v" sid="ECC 4:7" />Nah Ih ciswa de mta mrwa gwa kecu, nah mwangzui naimiak kangga de gah di kela hadung gede cet daigai. <note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">Eph. 5:27</char></note><verse eid="ECC 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 4:8" />Mige pekatei rünne eh bamla.</para>
  <para style="q2" vid="ECC 4:8">Migede pe da bam kemakme ge, pena de gah nah pe sinabe de gah.</para>
  <para style="q1" vid="ECC 4:8">Pa mata tei kela leune de penli teima,</para>
  <para style="q2" vid="ECC 4:8">nah pa mabam mmi kelu lepwane pe mnung teilu lama.</para>
  <para style="q1" vid="ECC 4:8">Pa pe swa gah eh, “Ih cau ziemne hetah tei bam no</para>
  <para style="q2" vid="ECC 4:8">iciu eh Ih akatei acu suiyi mlai di lano?”</para>
  <para style="q1" vid="ECC 4:8">Aide de mwangzui ge da, marehi kesia geda.<verse eid="ECC 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 4:9" />Mi hangge swa hangna yiki;</para>
  <para style="q2" vid="ECC 4:9">penai ncüt delwe penai bata gade ziehi keyi hi lula.<verse eid="ECC 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 4:10" />Kedanemene magade hangge kaumie di liede, kedage ne pe zangbe de teu cuh lubui.</para>
  <para style="q2" vid="ECC 4:10">Iciuliede, mige pekatei nli kebambe de au, pa kau kedi dau lungrei pecai sui dila</para>
  <para style="q2" vid="ECC 4:10">magade migede pecu teucuh lu kera gah liecai.<verse eid="ECC 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 4:11" />Magade hangna zeu ncüt lucai, penai lum lubui,</para>
  <para style="q2" vid="ECC 4:11">Dede dainzwa mige pekatei lumlu zie no?<verse eid="ECC 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 4:12" />Mi hangge pekatei kebambe de au ngam di lubui,</para>
  <para style="q2" vid="ECC 4:12">dede hangna au gwaketang kebam gade sap lubui,</para>
  <para style="q2" vid="ECC 4:12">nah heria kecum teu ncüt kelube cak zette di lama.<verse eid="ECC 4:12" /></para>
  <para style="s">Yisi kelu au Pekiegah</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13" />Magah liede heluibuame ge mteu kebam au cing kedi kemie hegwangpei keherei gwang kera pecu rang mriak kegai cidungde kingnei cita kedibe swade yiki. <verse eid="ECC 4:13" /><verse number="14" style="v" sid="ECC 4:14" />Aide au kesang, magade heluibuame cide hebaangki gade mpet hegwang tei liede, mede pecu cipau hegwangram ga makegahme ge eh mnalu liede. <verse eid="ECC 4:14" /><verse number="15" style="v" sid="ECC 4:15" />Kideu ga ringkebam leune de tingnaimiak kangga tet mlai kebam Ih ngau nah cika heluibuame ge cuh hegwangpei bam leu kerabe de de Ih ngau. <verse eid="ECC 4:15" /><verse number="16" style="v" sid="ECC 4:16" />Hegwangpei kehecibe samzai tei kera mina kekiee ge bam, dede aipaucai, mina kekiee ge pecu hetwa peu sita dizie. Ainzwa kecu au mwangzui ge kesang nah tingkai de gwazui eh kum kela kenzwa geda.<verse eid="ECC 4:16" /></para>
  <chapter eid="ECC 4" />
  <chapter number="5" style="c" sid="ECC 5" />
  <para style="s">Tinggwang de Rüt eh Saplu</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1" />Tinggwang kerecaki ga kegwang dau n pikiet pie sünne lu. Kemiemedung penui kemau teila lie kecu ci kemakme gu ratak pwapeu kera swade kingnei kerane gwang nna lu.<verse eid="ECC 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 5:2" />N mui gade marang zette kecu teiso,</para>
  <para style="q2" vid="ECC 5:2">nah n mlung de peu kehei tei eh Tinggwang dwa gade sampet tei zette di so.</para>
  <para style="q1" vid="ECC 5:2">Tinggwang au tinggim ga bam, dede nang au kideu ga bam,</para>
  <para style="q2" vid="ECC 5:2">cine n samdung de peu camlu.<verse eid="ECC 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 5:3" />Nang magade ma kekiee ge tei kera bam eh n lung naang lacai, nang hemangdung kesia mmi di lubui.</para>
  <para style="q2" vid="ECC 5:3">Nang samdung rang kiee reu de, nang kemie samdung rang kieegwa di lubui.<verse eid="ECC 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 5:4" />Nang Tinggwang dage sampet kegai dau, cide tei kera peting teu tie diso, kedanemene Tinggwang au kemieme da pe suiyi gah. Nang tei zielie sampet kelude teilu. <verse eid="ECC 5:4" /><verse number="5" style="v" sid="ECC 5:5" />Sampet lu eh teicanglu kemak au sampet tei kemak be yiki. <verse eid="ECC 5:5" /><verse number="6" style="v" sid="ECC 5:6" />Peu n mui de n pumteih de kemau tei kera peu so. Cingkube gu samgwabe dage ainzwa rangso, “Cipau sampet de au teimau kedi ge.” Daitei lugu sampet kenret tei eh Tinggwang rata tei eh Tinggwang de n batadung peu tei ngkap di kera no? <verse eid="ECC 5:6" /><verse number="7" style="v" sid="ECC 5:7" />Kedanemene hemang kekiee mmi kegai ga, samdung kekiee rang kegai ga nzwa, cika pekie kegah mwangzui bam. Cine Tinggwang mie hinglu.<verse eid="ECC 5:7" /></para>
  <para style="s">Mahei au Pekiegah</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8" />Nnui nnui deukui ga makegahme de teikeherei nah penui nzeube swet teu kedi ngau kegai dau, cide migede cikemak nzwa nnui ngaupwa nnui swagah so, kedanemene cika mina kengkieng teu delwe penui kangga kebammedung de pie bam, nah penui reu kedime bamsi reu. <verse eid="ECC 5:8" /><verse number="9" style="v" sid="ECC 5:9" />Cikage si eh, kideu gade ma lungh kelu leune de peciakne ziemne da, nah hegwangpei de luhdung gade ma lungh kelube keulu la.<verse eid="ECC 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 5:10" />Keheibe de rangkanggeu luu neu kelabe rangkanggeu le pe mnung teicang gailak,</para>
  <para style="q2" vid="ECC 5:10">nah keheibe de makehei luu neu kelabe luu neu si muila.</para>
  <para style="q1" vid="ECC 5:10">Aide de, mwangzui ge.<verse eid="ECC 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 5:11" />Mabam mahei kiee reuge, cide tyei kerane mina de kieesi dila.</para>
  <para style="q1" vid="ECC 5:11">Mabam mpaube ziemne pe mahei cide pekeyi dai bam no</para>
  <para style="q2" vid="ECC 5:11">pemiak le pie kebam rünne kera gwale ma?<verse eid="ECC 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 5:12" />Hetah tei kelame ge au zip hemisüt lula,</para>
  <para style="q2" vid="ECC 5:12">pa matyei kiee liede nah tyei cam liede,</para>
  <para style="q1" vid="ECC 5:12">dede keheibe pei au pe mabam ne pecu zip hemilu kera peu lama.<verse eid="ECC 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 5:13" />Tingnaimiak kangga ma kesia kebam Ih ngau:</para>
  <para style="q1" vid="ECC 5:13">pempaube pe mabamdung keu hekwa kecu, cide pekatei pe ziemne suisiet kedi teugwang beula.<verse eid="ECC 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 5:14" />Ma keheibe pei pe ra gah eh pe mahei ngkap kedi dau,</para>
  <para style="q2" vid="ECC 5:14">pa pekatei pe napei, pe dade lungh kelube ziemne magede pe ba gage bang beulu tadi la.<verse eid="ECC 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 5:15" />Minabe pe pui pok gade gwang kelu nzwa,</para>
  <para style="q2" vid="ECC 5:15">pa paula eh caili tet zie.</para>
  <para style="q1" vid="ECC 5:15">Pa pe ba lepwa tei kelu tsibui kette keutet gailak.<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="1TI 6:7">1 Tim. 6:7</ref></char></note><verse eid="ECC 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 5:16" />Ma keda kesia ge liecai,</para>
  <para style="q1" vid="ECC 5:16">mige gwang kelu nzwa, pa tetdai dila.</para>
  <para style="q1" vid="ECC 5:16">Cine pa tingkai gage pe bata tei kegai de pe kemmi daige bam no?<verse eid="ECC 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 5:17" />Pe teilung tingdau kemuibe de pa ngngwa matyei</para>
  <para style="q2" vid="ECC 5:17">iciu eh mateei nah rata lepwa pa keherei süt.<verse eid="ECC 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18" />Pielo, Ih makeyi nah kezeu tube ci kelu au, nang n bata pelane gade gie kelube teu tyei nah sak eh kehega kelude da, anuide Tinggwang ne peu kebeu teilung tingbaziedung ga tingnaimiak kangga hetah tei kecudau. Kedanemene aide ziemne mina de het keluda. <verse eid="ECC 5:18" /><verse number="19" style="v" sid="ECC 5:19" />Keheibe de Tinggwang ne pecu mabam mahei nah pe qwa luulu kebui kepeu nah pe bata ketei ga pe sui yisüt kebam, aide Tinggwang dade mta mapeu da. <verse eid="ECC 5:19" /><verse number="20" style="v" sid="ECC 5:20" />Pa pe teilung tingbaziedung ha cet bammui lak, kedanemene Tinggwang au pecu peu pa tei kehega kebam tahdung tei eh naang jüja bam kelane.<verse eid="ECC 5:20" /></para>
  <chapter eid="ECC 5" />
  <chapter number="6" style="c" sid="ECC 6" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1" />Tingnaimiak kangga kebam makesia ge kebam Ih ngau, nah cide mina reuga pezie rüt delwe bam. <verse eid="ECC 6:1" /><verse number="2" style="v" sid="ECC 6:2" />Tinggwang mipei gede mahei, mabam nah herüt pwapeu lubui iciu eh pa pekatei pe ziemne ma gede luu sineu kecu bam kelakne, dede Tinggwang pecu cide teu kehega lu kera ziuyi peu ma. Iciu meliene, mikedame gene pe mabamdung keuteu dila. Aide au mwangzui, kesiabe ge. <verse eid="ECC 6:2" /><verse number="3" style="v" sid="ECC 6:3" />Magade mipei ge pe name haige bam nah mmi kekieege lunghlu, iciu eh pe mmi tingbaziedung kiesüt, dede magade pa makeyi lepwa pelung cang luma nah pecu teu kungdi melie cai, ciucai Ih rangla, ngiena tsai eh mna kelube au pe swade yiki. <verse eid="ECC 6:3" /><verse number="4" style="v" sid="ECC 6:4" />Ngiena cikenzwa ge au pekie kegah gage mna gai nah kemui gade pa tsai di, nah pezi de ngkim mbai nzeu dila. <verse eid="ECC 6:4" /><verse number="5" style="v" sid="ECC 6:5" />Ngiena aide tingnaimiak de ngauma mede magede ci meliede, dede pa au cipau pei de ngaulu kemak kemtak ngaulu. <verse eid="ECC 6:5" /><verse number="6" style="v" sid="ECC 6:6" />Magade mige tingkum mmi cangna ge ring eh lunghlu, dede pa makeyidung teu eh kehega cilu meliecai, pa de mileune nzwa tsaidi la.<verse eid="ECC 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 6:7" />Mina pelane tyei kerane heta tei la,</para>
  <para style="q2" vid="ECC 6:7">dede pa pe tyeineu le pwane mnunglu lama.<verse eid="ECC 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 6:8" />Kesangsiakpe, kemriakme pei kemiebe dade pekeyi dai bam no?</para>
  <para style="q2" vid="ECC 6:8">Ma kegahbe pei ziemne pekeyi daige bam no</para>
  <para style="q3" vid="ECC 6:8">magade pa kedame dwa gade keyi ciem teici lalie de?<verse eid="ECC 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 6:9" />Mimiak dai ngaulu zeubi cide ngau lwe mnung kebambe be yiki</para>
  <para style="q2" vid="ECC 6:9">anui tyei keneube ngaulu neu eh cet kebambe swade,</para>
  <para style="q1" vid="ECC 6:9">cide liede mwangzui ge nah tingkai gwazui kela kenzwa ge.<verse eid="ECC 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 6:10" />Daidung dam pwabam di debi cidungde zi msiak beu dida, nah minadung dainzwa labi cidungde de ci bam dida. Cine tutiak ngkiengtube de ngngwa sia eh renia kebam au kemta ge dida. <note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">mede Tinggwang</char></note><verse eid="ECC 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 6:11" />Samdung rang kiee reu ge, pekie kegah kemta kieesi reureu,</para>
  <para style="q2" vid="ECC 6:11">cine mina ziemne cide pekeyi daige bam no?<verse eid="ECC 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 6:12" />Kedanemene mige pe teilung kedui nah kemta tingkaumie ge nzwa tetkah tetdi kela teilung teu keyibe kecu dainzwa cilu laino? Caune minabe de pa tsai kedicai tingnaimiak kangga dai gwang zie bi kecu rangbeu lulai?<verse eid="ECC 6:12" /></para>
  <chapter eid="ECC 6" />
  <chapter number="7" style="c" sid="ECC 7" />
  <para style="s">Macisam</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 7:1" />Hezi keyi au pemi kehung marim kehengui swade yiki,</para>
  <para style="q2" vid="ECC 7:1">nah ketsai tingba au kemna tingba swade yiki.<verse eid="ECC 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 7:2" />Taktyei ngyi hengyi kebam kiga mie kera swade</para>
  <para style="q2" vid="ECC 7:2">hei eh hap kebambe kiga mie kecube yiki,</para>
  <para style="q1" vid="ECC 7:2">kedanemene teilung cang kedi benai hei eh hap kecu au mina pelane da gwangla,</para>
  <para style="q2" vid="ECC 7:2">cine ring kebamme ma aide penui mlung gage kai teula lu maisia.<verse eid="ECC 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 7:3" />Suisiet au kenui swade yiki,</para>
  <para style="q2" vid="ECC 7:3">kedanemene misui kesia gwang kelu cia milung suiyi gwang la.<verse eid="ECC 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 7:4" />Mlung kemteu au hei eh hap kebam kiga lala,</para>
  <para style="q2" vid="ECC 7:4">dede kemiebe mlung au ketyei ngyi kiga lala.<verse eid="ECC 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 7:5" />Kemieme gu leidung kingnei kebam swade</para>
  <para style="q2" vid="ECC 7:5">kemteu kehesiu kingnei kebambe au yiki.<verse eid="ECC 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 7:6" />Kedanemene malang kebam li kangga hetudung heu eh pok kebam nzwa da,</para>
  <para style="q2" vid="ECC 7:6">kemiemedung nui kebamde de.</para>
  <para style="q1" vid="ECC 7:6">Aide de mwangzui ge nzwa da.<verse eid="ECC 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 7:7" />Kemriakme ge migu süttyei kegaine pecu tei mie dila,</para>
  <para style="q2" vid="ECC 7:7">nah hetauhenim ne milung tei hera dila.<verse eid="ECC 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 7:8" />Ma penlibe au pe bangdwabe swade yiki;</para>
  <para style="q2" vid="ECC 7:8">nah mina pelung tie kelabe au pezai ngang kelabe swade yiki.<verse eid="ECC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 7:9" />Nlung gade rata zette diso,</para>
  <para style="q2" vid="ECC 7:9">kedanemene rata au kemiemedung mlung ga bamla.<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="JAS 1:19">Jas. 1:19</ref></char></note> <note caller="+" style="f"><char style="fr" closed="false">7:9 </char><char style="ft" closed="false">James 1:19</char></note><verse eid="ECC 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 7:10" />“Daitei eh cu swade ndaa tingbe yiki no?” de rangso.</para>
  <para style="q2" vid="ECC 7:10">Kedanemene nang aide maci teu eh keteu bam ma.<verse eid="ECC 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 7:11" />Maci au, mapwa ge nzwa makeyi ge.</para>
  <para style="q2" vid="ECC 7:11">Cide tingnaimiak ngau kebamme de kemmi peula.<verse eid="ECC 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 7:12" />Kedanemene rangkang ncu gumkwak beulu kela nzwa kemteu de ncu gumkwak beu zie,</para>
  <para style="q2" vid="ECC 7:12">dede maci pekeyi au keheibe de peda cide kebamme teilung pwapeu la.<verse eid="ECC 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 7:13" />Tinggwang batadung de cet gailo:</para>
  <para style="q1" vid="ECC 7:13">Caune pa tei ngkoi kedibe tei mzui luzie no? <note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">Gen 30:14-16</char></note><verse eid="ECC 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 7:14" />Peting yi kebamdau, keyi cide teu n suiyi eh lunghlu,</para>
  <para style="q2" vid="ECC 7:14">dede peting sia kecudau, aide cet lu:</para>
  <para style="q1" vid="ECC 7:14">Tinggwang keyibe nah kesiabe de teigai.</para>
  <para style="q2" vid="ECC 7:14">Makie aide ziemne, migede pa tet kedi cai dai gwang ziebi kecu ci gailak.<verse eid="ECC 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15" />Ih a teilung kemta tingbadung ga ma kekiee ge ngau da.</para>
  <para style="q1" vid="ECC 7:15">Makesangme ge penui masang eh bam liede tsai gah kedi ngau da,</para>
  <para style="q1" vid="ECC 7:15">nah cika mina kesiame de penui kesia teila liede teilung ketie lunghlu bam.<verse eid="ECC 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 7:16" />Cine nkatei ncu lepwa makesangme lie dedi so,</para>
  <para style="q2" vid="ECC 7:16">n miak gade mteu lu.</para>
  <para style="q1" vid="ECC 7:16">Daitei nkatei ncu teimsia di lulai?<verse eid="ECC 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 7:17" />Cine nlien ham diso mede mie ham diso.</para>
  <para style="q2" vid="ECC 7:17">Daitei nang n tingkemak dwa tsai lai?<verse eid="ECC 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 7:18" />Nang kemteu aide herak teu kebam au n ziemne keyi ge,</para>
  <para style="q2" vid="ECC 7:18">nah n masang de peu n dade tet diso.</para>
  <para style="q1" vid="ECC 7:18">Kedanemene Tinggwang mie hing kelabe au pa tei mai kesiabe pelane teicang luzie.<verse eid="ECC 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 7:19" />Kemteume ziemne au maci pe kengkieng bam,</para>
  <para style="q2" vid="ECC 7:19">namdi ge ga hegwangme kerei swade ngkieng ki.<verse eid="ECC 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 7:20" />Kideu ga migede makesangme,</para>
  <para style="q2" vid="ECC 7:20">keyi tei nah madaude kemau teila kemakme gah.<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="ROM 3:10">Rom. 3:10</ref></char></note><verse eid="ECC 7:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ECC 7:21" />Sam rang kegai pelane kingnei so,</para>
  <para style="q2" vid="ECC 7:21">kedanemene n kilabe ncu reset kecu nang siudi lubui.<verse eid="ECC 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ECC 7:22" />Cinzwa, nang nkatei ncu cisiak de bam n mlung gade</para>
  <para style="q2" vid="ECC 7:22">mi kedame gede nang reset bam kela.<verse eid="ECC 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23" />Ma aidung pelane Ih maci teu eh lia gaila. Ih ranggai,</para>
  <para style="q1" vid="ECC 7:23">“Ih au mteu bam zie,”</para>
  <para style="q2" vid="ECC 7:23">dede cide au kiee pwa Ih teicang gai kelak ge.<verse eid="ECC 7:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ECC 7:24" />Maci au mdei dida nah cok zudi.</para>
  <para style="q2" vid="ECC 7:24">Caune cide peei lulai?<verse eid="ECC 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ECC 7:25" />Ih maci lu kera nah kedakpie kerane a lung kaigai</para>
  <para style="q2" vid="ECC 7:25">nah maci peei kera nah kesangbe rang hecai lu kera peei,</para>
  <para style="q1" vid="ECC 7:25">nah makesia au kemang</para>
  <para style="q2" vid="ECC 7:25">nah kemie au herakemie gelie kecu cilu kerane.<verse eid="ECC 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ECC 7:26" />Mipui keheibede pelung ga hetak</para>
  <para style="q1" vid="ECC 7:26">nah hebaih rak kesia pui kebam au</para>
  <para style="q2" vid="ECC 7:26">ketsai swade kaa ki lie kecu Ih cilu,</para>
  <para style="q2" vid="ECC 7:26">nah penui ba hegeuria ne pi pwabam.</para>
  <para style="q1" vid="ECC 7:26">Caugame Tinggwang suiyibe tei labi</para>
  <para style="q1" vid="ECC 7:26">cipaume mipui cide dade pak lubui,</para>
  <para style="q2" vid="ECC 7:26">dede kemaume de au pa ne ngngwa teu dila.<verse eid="ECC 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ECC 7:27" />“Ih ci nah ngau kelu aide cet gailo,” keledeube ranggai. “Ih makesangbe ci nah rang hecai kelu ngaulu kerane Ih ngau nah ci kelube ket cai ket kaisi jüja bam.<verse eid="ECC 7:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ECC 7:28" />Ma aide Ih cude peei kebam da,</para>
  <para style="q1" vid="ECC 7:28">dede Ih cide ngaulu mereu.</para>
  <para style="q1" vid="ECC 7:28">Ih mipei cangge kakga de makesangme hangge au ngaulu da,</para>
  <para style="q2" vid="ECC 7:28">dede mipui pelane kakga de Ih cide ngaulu ma.<verse eid="ECC 7:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ECC 7:29" />Tinggwang mina de mzui nah masang eh damgai,</para>
  <para style="q2" vid="ECC 7:29">dede penui cide gidi eh keherei peei ladi delie kecu</para>
  <para style="q2" vid="ECC 7:29">Ih aide rünne cilu.”<verse eid="ECC 7:29" /></para>
  <chapter eid="ECC 7" />
  <chapter number="8" style="c" sid="ECC 8" />
  <para style="q1">
    <verse number="1" style="v" sid="ECC 8:1" />Mteu kelabe cau no?</para>
  <para style="q2" vid="ECC 8:1">Mi teilung ga teikela hadung caune ci no?</para>
  <para style="q1" vid="ECC 8:1">Mina da bam kedi maci cide ne pezu pung mbaa la,</para>
  <para style="q2" vid="ECC 8:1">nah iciu eh pezu tak kela de teili dila.<verse eid="ECC 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ECC 8:2" />Hegwangpei sam mzai lulo Ih nnuide ranggai la, kedanemene nang samsang kera Tinggwang dwa gade sampet lu delu. <verse eid="ECC 8:2" /><verse number="3" style="v" sid="ECC 8:3" />Pe dwa gade nreu zette tetdi kera cet so, nah kemaube lampwa eh sap so, kedanemene hegwangpei pa tei keneu leune tei kelane. <verse eid="ECC 8:3" /><verse number="4" style="v" sid="ECC 8:4" />Hegwangpei pesamdung teu hegwang teila, cine caune pe dage, “Nang daitei zeu bi” de rang lubui no?<verse eid="ECC 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 8:5" />Hegwangpei gu aja mzai kelame keherei gade mria lula.</para>
  <para style="q2" vid="ECC 8:5">Helung mteu eh kelabe au daitei maisia bi nah daidau tei ziebi cilu la.<verse eid="ECC 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 8:6" />Maleune ziemne samli petausiakpe bamla nah tei caili kerating bamla,</para>
  <para style="q2" vid="ECC 8:6">kedanemene mina reidung au dizu kecune.<verse eid="ECC 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 8:7" />Pecia dai gwang zie bi migede cima.</para>
  <para style="q2" vid="ECC 8:7">Caune daipai gwang zie bi kecu pe dage rangbeu lu zie no?<verse eid="ECC 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 8:8" />Migede pekatei pe cuingi reu kengkieng gah iciu eh pe cuingi tei mtaklu kera, <note caller="+" style="f"><char style="ft" closed="false">Kesa laisiukwak ga</char><char style="fqa">Migede tingkai reu gah iciu eh tingkai tei mtak lu kera de bam. </char> </note></para>
  <para style="q2" vid="ECC 8:8">nah migede pekatei petsit tingba reu kengkieng bam ma.</para>
  <para style="q1" vid="ECC 8:8">Nah migede de hereu tei keladau reugwame gade keu mpetdi lama,</para>
  <para style="q2" vid="ECC 8:8">nah kesiabe baang tei kelame kesiabe ne pecu kelilu gailak.<verse eid="ECC 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 8:9" />Ih aidung pelane de cet caili gaida; Tingnaimiak kangga bata lie kela leune gage Ih alung kaigai da. Mige ne mi kedage de tei keherei eh pelung tei rezam gai kecuting de bam la. <note caller="+" style="f"><char style="ft" closed="false">Kesa laisiukwak ga </char><char style="fqa">pekatei pecu rezam kecu. </char> Hebrew gade rau pwa kebam de aide kena keheibe nzwa eh raugai lubui. </note> <verse eid="ECC 8:9" /><verse number="10" style="v" sid="ECC 8:10" />Cine mina pezai kesiame de hemaa mtei dwa gade kung kecu Ih ngauda. Penuide kemci nidung gade pwa gwang kung nah penui heta kesia tei kegai namdi gade minadung ne penuide hetwa peu kebam Ih ngauda. Aide de pekie kegah kemta ge.<verse eid="ECC 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 8:11" />Ma kemau tei kegai ziemne kemau ziehi teibeu zette tadi ge, cide kemau teikera gage mina mlung de teugai dila. <verse eid="ECC 8:11" /><verse number="12" style="v" sid="ECC 8:12" />Kemaume ge kemau kesia ta pia haige tei eh teilung ketie ring eh lunghlu liede, Ih ci kebam au Tinggwang de herüt peu kelame, pe dwa ga sap delwe herüt pe dage keulia kelame be yiki. <verse eid="ECC 8:12" /><verse number="13" style="v" sid="ECC 8:13" />Dede mina kesiame ziemne au cide pekeyi gede gah; pa pe teilung ketie gede bam lak. Pe tingba ziedung au tingkaumie ge nzwa zette gah dizie, kedanemene pa Tinggwang de rüt kemakne.<verse eid="ECC 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 8:14" />Mwangzui kemta pekie kegah keda ge bamsi reu, ma kedage kideu ga teikela ge. Makesangme da tei nah gwang kelabe kesia kemaume dade tei nah gwangla, nah kemau kesia keteime da tei nah gwang kelabe makesangme dade tei nah gwangla. Ih rangla, aide de kemta mwangzui ge da. <verse eid="ECC 8:14" /><verse number="15" style="v" sid="ECC 8:15" />Cine Ih misuiyi eh bam kera rangbeu la, kedanemene tingnaimiak kangga mige tyei nah sak lwe pe suiyi eh kebambe swade magede keyi bam si ma. Tingnaimiak kangga pa pe tatei kela gade nah pe teilung tingbaziedung pelane gade Tinggwang ne kepeu mapeu suiyi cide pecu nzang lamui zie.<verse eid="ECC 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16" />Ih kemteu cilu kerane alung kai kegaidau nah kideu ga bata, tingmui de nah tingna de mimiak de peu zipdi mene tei kelabedung cilu kerane cet kegaidau, <verse eid="ECC 8:16" /><verse number="17" style="v" sid="ECC 8:17" />iciu eh Ih Tinggwang ne tei kegai tadung pelane de cetgai, nah tingnaimiak kangga bata tei kelabedung mina ne cicang gailak di. Mina ne pe laikai daikenzwa ge kai eh cide cilu kera tei liede, pa cidungde cicang nah ngaucang gailak. Kemteube pei pa cibam de eh nlum bam lubui, dede pa de cicang ma.<verse eid="ECC 8:17" /></para>
  <chapter eid="ECC 8" />
  <chapter number="9" style="c" sid="ECC 9" />
  <para style="s">Pelane ziemne Heni Ket</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1" />Kedanemene Ih aidungde pelane de alung gade cilu kerane cet lala, cide makesangme nah makecime nah penui batadung. Penui pelane Tinggwang ba ga bam. Migede mige da keku mede kengkau gwang kera cima.<verse eid="ECC 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 9:2" />Mileune ziemne de caiha au ket. Caiha ket cide mipelane de kwa bam</para>
  <para style="q2" vid="ECC 9:2">Makesangme nah kenlienme,</para>
  <para style="q2" vid="ECC 9:2">keyime, <note caller="+" style="f"><char style="ft" closed="false">ndaa rau kela nzwa cu keheci laisiukwakdung gade ainzwa rau la </char><char style="fqa">keyime nah kesiame. </char> Ainzwa eh, pe samria rau canglu la. Keraume aide nzwa eh rau lubui. </note></para>
  <para style="q2" vid="ECC 9:2">kemcime, nah mcikemakme,</para>
  <para style="q2" vid="ECC 9:2">Tinggwang dage ratak teibeu kelame nah ratak teibeu la kemakme.</para>
  <para style="q1" vid="ECC 9:2">Mina keyime tsaidi kela nzwa,</para>
  <para style="q2" vid="ECC 9:2">kemaume de cinzwa tsai dizie.</para>
  <para style="q1" vid="ECC 9:2">Samkak tei kelame tsaidi kela nzwa,</para>
  <para style="q2" vid="ECC 9:2">samkak reset tei hing kelame de tsai dizie.<verse eid="ECC 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 9:3" />Tingnaimiak kangga tei kela maleune ziemne caiha kesia ge bam, ma aide penui pelane da teila. Mina mlungdung au ma kesiabe le puibam, nah penui ring kebamdau penui mlung ga kemie le gum teu lala. Iciu eh cipau cai penui tsai dila. <verse eid="ECC 9:3" /><verse number="4" style="v" sid="ECC 9:4" />Kedanemene caugame keringme de ngngwa ncüt bam bi, cika keregui ge bam, hingho tsai kedibe swade heteu ring kebambe yiki kecu nzwa.<verse eid="ECC 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 9:5" />Kedanemene ring kebamme penui tsai dizie kecu cibam,</para>
  <para style="q2" vid="ECC 9:5">dede tsai di kecume au magede ci meda.</para>
  <para style="q1" vid="ECC 9:5">Penui ziehi ngaulu kera gede bam si meda,</para>
  <para style="q2" vid="ECC 9:5">kedanemene penui ziemne maleune de nsungta dida.<verse eid="ECC 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 9:6" />Penui keku, helungkesia, nah penui riak</para>
  <para style="q2" vid="ECC 9:6">cidungde ndaa ge gah dida.</para>
  <para style="q1" vid="ECC 9:6">Tingnaimiak kangga tei kela leune gade</para>
  <para style="q2" vid="ECC 9:6">penui heni gede madaude ngaulu silak ta.<verse eid="ECC 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7" />Nang tet kela ga tet lalu, ngu tangku nsuiyi eh tyeilu, nah nlung suiyi eh matsizau piak saklu, kedanemene batadung keyi teikelu ngyi ga Tinggwang pe suiyi lala. <verse eid="ECC 9:7" /><verse number="8" style="v" sid="ECC 9:8" />Peu n paini nia ha lamui lu nah n peu maca le keniaklu. <verse eid="ECC 9:8" /><verse number="9" style="v" sid="ECC 9:9" />N teilung kemta teilung aide pelane ga nang hungtu kelabe nnau de ngngwa nsuiyi eh lunghlu, Tinggwang ne tingnaimiak kangga ncu pwa kepeu pekie kegah n tingbaziedung pelane teu eh. Cide au nang tingnaimiak kangga n teilung ting n bata teikelu ziehi da. <verse eid="ECC 9:9" /><verse number="10" style="v" sid="ECC 9:10" />N ba ga nang dai tatei kera ngaulu bi cide n kengkieng teu eh teilu, kedanemene nang gwang lai kela Ketsaime deu ga au bata mede lungcet gede gah mede maci mede kemteu gede gah.<verse eid="ECC 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11" />Ih ma kedage tingnaimiak kangga ngau:</para>
  <para style="q2" vid="ECC 9:11">Hezukemzu au mina kemzetme gu swama.</para>
  <para style="q2" vid="ECC 9:11">Hereu ketei au mina kengkingme gu swama.</para>
  <para style="q2" vid="ECC 9:11">Tangku au mina ningcing kemriakme gu ma.</para>
  <para style="q2" vid="ECC 9:11">Mahei au mina kecikecetme gu ma.</para>
  <para style="q2" vid="ECC 9:11">Ziuyi au mina makecime gu ma.</para>
  <para style="q1" vid="ECC 9:11">Iciu meliene, penui pelane dade cide peting nah ziuyi rehi gade gwangdi la.<verse eid="ECC 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 9:12" />Kesang, migede petingba daidau gwang ziebi cima.</para>
  <para style="q2" vid="ECC 9:12">Helang kengkieng gage hekadung tuilu kela nzwa,</para>
  <para style="q2" vid="ECC 9:12">mede hetak gage nruine keulu kela nzwa,</para>
  <para style="q1" vid="ECC 9:12">mina namedung dede peting kesiadung ne tuiteu dila,</para>
  <para style="q2" vid="ECC 9:12">penui da cide zette gwang kegaidau.<verse eid="ECC 9:12" /></para>
  <para style="s">Maci au Kemie Swayi</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13" />Ih tingnaimiak kangga maci a dade disüt kecuge ngauda. <verse eid="ECC 9:13" /><verse number="14" style="v" sid="ECC 9:14" />Mina kiee kemakge bam kela namdi keceu nage bamla, ge hegwang kengkieng ge gwang cide de renia nah cide twagwalu, nah cikage twagwa kera nidung kedi mteilu. <verse eid="ECC 9:14" /><verse number="15" style="v" sid="ECC 9:15" />Cidau cipau namdi ga makegah, makecime pei ge bamla, pe maci ziemne namdi cide kelilu. Dede pecai, migede cipau ma kegahbe de nsung tadi. <verse eid="ECC 9:15" /><verse number="16" style="v" sid="ECC 9:16" />Cine Ih ci kelu, “Maci au kengkieng swade yiki, dede makegahme ge maci au mlai dila, nah pe samdung kingnei lama.”<verse eid="ECC 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 9:17" />Kemieme kakga hegwangme mrung eh sah kebam kwa swade</para>
  <para style="q2" vid="ECC 9:17">mina makecime sam zingde rang kegai au siu yiki la.<verse eid="ECC 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 9:18" />Maci au hereu netdung swade yiki,</para>
  <para style="q2" vid="ECC 9:18">dede kemaume hangge ne makeyi kekieege tei ngkap di lubui.<verse eid="ECC 9:18" /></para>
  <chapter eid="ECC 9" />
  <chapter number="10" style="c" sid="ECC 10" />
  <para style="q1">
    <verse number="1" style="v" sid="ECC 10:1" />Tammainedung ketsaibe ne marim kehenguibe tei nnam siadi kela nzwa,</para>
  <para style="q2" vid="ECC 10:1">kemang nage ne maci nah herüt ngam di lubui.<verse eid="ECC 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 10:2" />Kemteume ge pe mlung petaube ga tet lala,</para>
  <para style="q2" vid="ECC 10:2">dede kemiebe mlung au kemaube ta tei kera cet lala.<verse eid="ECC 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 10:3" />Kemiebe lampuiki ga tet nghung kela dau,</para>
  <para style="q2" vid="ECC 10:3">pe kecet yicang lama,</para>
  <para style="q3" vid="ECC 10:3">iciu eh pa kemieme gelie kecu mileune de lia lala.<verse eid="ECC 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 10:4" />Hegwangme ge ncu pe rata di cai, nang n ta püt gaibeu so.</para>
  <para style="q2" vid="ECC 10:4">Nang nlei mene bam dicai rata kedi cide ngkam dizie.<verse eid="ECC 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 10:5" />Tingnaimiak kangga Ih makesia ge ngau,</para>
  <para style="q2" vid="ECC 10:5">hegwangme dade ma petau kemakpe gwang kela:<verse eid="ECC 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 10:6" />Kemieme de muiteu tei kera bam pwapeu,</para>
  <para style="q2" vid="ECC 10:6">iciu eh ma tei lu kelame de be bam kehena pwapeu.<verse eid="ECC 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 10:7" />Hebaangmedung ne hekwen teu kela Ih ngau da,</para>
  <para style="q2" vid="ECC 10:7">nah ma tei lu kelame be hebaangme nzwa penui pi le kideu ga tet lala.<verse eid="ECC 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 10:8" />Mikeheibe de hekwaki kui kelame</para>
  <para style="q2" vid="ECC 10:8">cika cakmie di lubui, nah mige tsukwa teipop lwe tei ngkau dige,</para>
  <para style="q2" vid="ECC 10:8">henei ne pecu nsau la.<verse eid="ECC 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 10:9" />Tangtsu bungh kelame</para>
  <para style="q2" vid="ECC 10:9">tangtsu ne penui de rezam di lubui,</para>
  <para style="q1" vid="ECC 10:9">nah tsing ntau kelame ge</para>
  <para style="q2" vid="ECC 10:9">pe ta cide pe ziemne kerehim bam.<verse eid="ECC 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 10:10" />Hegeu pemui sia dicai, nah mige cide hereei hemi gai melie cai, pa pezie kengkieng kekiee keu si maisia, dede maci au ma teicang lu kebui ziuyi pwapeu la.<verse eid="ECC 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 10:11" />Henei de kemeu di kemak dwage henei cide ne mige de nsau di cai,</para>
  <para style="q2" vid="ECC 10:11">kemeu kerabe pei ziemne ma kemmi gede gah.<verse eid="ECC 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 10:12" />Kemteu me mui gade sam rang kegaidung au hezuyi,</para>
  <para style="q2" vid="ECC 10:12">dede kemangme au pe muileu ne pecu ngkap di la.<verse eid="ECC 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 10:13" />Kemangme mui gade samdung rangpet kegai dau, kemie samdung mpet la,</para>
  <para style="q2" vid="ECC 10:13">nah iciu eh gwang kekamle dige kemie rata kesia le pemui gade lwa bam dila.<verse eid="ECC 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 10:14" />Kemieme ge samdung kekieege rang lala,</para>
  <para style="q2" vid="ECC 10:14">dede migede dai gwang zie bi cilama.</para>
  <para style="q2" vid="ECC 10:14">Caune pa tet kedi cai ga dai gwang zie bi cilu zie no?<verse eid="ECC 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 10:15" />Kemieme penui nri eh bata tei keladung lepwa penuide tei mnei dila,</para>
  <para style="q2" vid="ECC 10:15">iciu eh penui nam ga gwang kera lampui de cita dila.<verse eid="ECC 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 10:16" />Co, hangdeubo, magade rehang heluibuame ge ne nnui reu hegwang tei liecai,</para>
  <para style="q2" vid="ECC 10:16">nah magade nnui muiteumedung tingcang gade taktyei ngyi hengyi bam di liecai!<verse eid="ECC 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 10:17" />Dede nnui samlam pung delie, deudibo, magade nnui reu kedime napei ne hegwang tei liecai,</para>
  <para style="q2" vid="ECC 10:17">nah nnui muiteumedung sakmie kera ziemne mene penui pum kengkieng ngaulu kera ziemne</para>
  <para style="q2" vid="ECC 10:17">peting siakdau matyei lu la liecai!<verse eid="ECC 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 10:18" />Kenghet ziemne kilim cakmie zie,</para>
  <para style="q2" vid="ECC 10:18">nah bata tei la kemak badung ziemne ki be zau zie.<verse eid="ECC 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 10:19" />Suiyi ngaulu kerane mina taktyei telei la,</para>
  <para style="q2" vid="ECC 10:19">zau au mina teilung tei renga la,</para>
  <para style="q3" vid="ECC 10:19">nah rangkang ne teumai kesia pelane teipuih teicang beula.<verse eid="ECC 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 10:20" />Hegwangpei de reset so, nlung ga dede reset so,</para>
  <para style="q2" vid="ECC 10:20">nah n zeubung gade mina makeheime de reset so.</para>
  <para style="q1" vid="ECC 10:20">Kedanemene tingkam ga kela nruine ne n sam paugwang beu dizie;</para>
  <para style="q2" vid="ECC 10:20">pe hesiu tei kela leune ne cidungde teizang gaibeu di lubui.<verse eid="ECC 10:20" /></para>
  <chapter eid="ECC 10" />
  <chapter number="11" style="c" sid="ECC 11" />
  <para style="s">Dui Reuga Tangku</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 11:1" />Ngu tangku duidung gage lang mpet gai culo,</para>
  <para style="q2" vid="ECC 11:1">kedanemene, tingbazie kekieege cai nang cide ngau dai luzie.<verse eid="ECC 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 11:2" />Cide nang mina hanghena, mede hangheset gade liede mzi beulu,</para>
  <para style="q2" vid="ECC 11:2">kedanemene kideu ga daidau keherei gwang zie bi nang cimelu.<verse eid="ECC 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 11:3" />Magade hemwadung ga tingrui kepuih teidi cai,</para>
  <para style="q2" vid="ECC 11:3">cide pekatei pecu kideu gage tei mrwa gai la,</para>
  <para style="q1" vid="ECC 11:3">nah magade tsingbang tingbangle mede tingtünle ge kaugai di cai,</para>
  <para style="q2" vid="ECC 11:3">tsingbang cide daiga ge kaugai bi cika peluila eh bam dila.<verse eid="ECC 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 11:4" />Keheibe de tingkai maa pie bam kedibe heleuh linglu tadi lubui,</para>
  <para style="q2" vid="ECC 11:4">nah keheibe de hemwa maa pie bam kedibe luhlüt lu tadi lubui.<verse eid="ECC 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 11:5" />Nang tingkai lampui cila kemak nzwa,</para>
  <para style="q2" vid="ECC 11:5">nah tetlak pui za ga ngiena rah dainzwa bwa zeubi kecu cila kemak nzwa, <note caller="+" style="f"><char style="ft" closed="false">Kesa keheci laisiukwak ga </char><char style="fqa">Tetlak kela dau nang ngiena da teilung dainzwa gwang la bi cila kemak nzwa de bam. </char> </note></para>
  <para style="q1" vid="ECC 11:5">Tinggwang maleune dam kegaibe</para>
  <para style="q2" vid="ECC 11:5">batadung nang cicang gailak.<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="JHN 3:8">Jhn. 3:8</ref></char></note><verse eid="ECC 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 11:6" />Tingcang ting heleuh keu linglu;</para>
  <para style="q2" vid="ECC 11:6">tinghegi kemaktane, bata tei mai kesiabedung n ba le teilu,</para>
  <para style="q1" vid="ECC 11:6">kedanemene dai de lungcuh zie bi nang ci kemakne,</para>
  <para style="q2" vid="ECC 11:6">tingcang ting zie mi mede tinghegi ting zie bi, mede aide zie mi mede cide zie bi,</para>
  <para style="q2" vid="ECC 11:6">mede kenana de nzwa kap eh yi beu zie bi nang ci kemakne.<verse eid="ECC 11:6" /></para>
  <para style="s">Hanglei Dauge Ncu Damkegaibe de Nsunglu</para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 11:7" />Kesangsiakpe, kebaa au hezuyi süt,</para>
  <para style="q2" vid="ECC 11:7">nah mimiak le tingcang naimiak ngau kegai au suiyi ge kesang.<verse eid="ECC 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 11:8" />Mige magade tingkum kekieege ringlu liecai,</para>
  <para style="q2" vid="ECC 11:8">peu pecu cidung pelane gade pe suiyi lu,</para>
  <para style="q1" vid="ECC 11:8">dede kesia kemui tingbadung gwang lai kezeu dede pecu peu cetlu,</para>
  <para style="q2" vid="ECC 11:8">kedanemene cide kieesüt zie lu.</para>
  <para style="q1" vid="ECC 11:8">Gwang lai kezeu ma pelane de mwangzui ge nzwa gah di kera swa sima.<verse eid="ECC 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 11:9" />Heluibuame gou, nang hena kebam dau nsuiyi lu,</para>
  <para style="q2" vid="ECC 11:9">nah nang hena kebam tingdau n nlung suiyi tei eh kehega lu.</para>
  <para style="q1" vid="ECC 11:9">N nlung suiyi hengimdung peei lu,</para>
  <para style="q2" vid="ECC 11:9">nah n miak dwaga nang ngaulu kebam pelane gade de.</para>
  <para style="q1" vid="ECC 11:9">Iciu de, ma aidung pekiene ziemne Tinggwang ntu tiak kera ci lulo.<verse eid="ECC 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 11:10" />N nlung gade rata gwa gidi lu,</para>
  <para style="q2" vid="ECC 11:10">nah n pumteih ga keteeikeneei pelane nsungta dilu,</para>
  <para style="q1" vid="ECC 11:10">kedanemene, heluibuame nah penui kengkieng rentsi au mwangzui ge cai sima.<verse eid="ECC 11:10" /></para>
  <chapter eid="ECC 11" />
  <chapter number="12" style="c" sid="ECC 12" />
  <para style="q1">
    <verse number="1" style="v" sid="ECC 12:1" />Nang hena kebam dau ncu dam kegaibe de nsunglu,</para>
  <para style="q2" vid="ECC 12:1">keherei kecu tingbadung gwangdi kemak dwa ge,</para>
  <para style="q2" vid="ECC 12:1">nah cipau tingkumdung gwang di eh,</para>
  <para style="q3" vid="ECC 12:1">“Ih aidung de ga lung kehega meda,” de nang rangdi kemak dwa,<verse eid="ECC 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 12:2" />ma aidung de teilu hekei nah hegidung nah tingnaimiak pe kebaa gah di eh mui di kemak dwa,</para>
  <para style="q2" vid="ECC 12:2">iciu eh tingrui caiga hemwa kemui caili gwang di kemak dwa.<verse eid="ECC 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 12:3" />Cipau tingdau au reketmedung mbeu dizie,</para>
  <para style="q2" vid="ECC 12:3">nah mipei kengkiengme keukei dizie,</para>
  <para style="q1" vid="ECC 12:3">nah mipuidung maniak kelame mtak dizie kedanemene penui hekang cam dizie kecune,</para>
  <para style="q1" vid="ECC 12:3">nah kikam gade pie mpet kelame penui ma ngau mcilu tadi zie.<verse eid="ECC 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 12:4" />Cipau tingdau puidiki ga kikamdung ngkui dizie,</para>
  <para style="q2" vid="ECC 12:4">nah maniak kebam kwa mtak dizie,</para>
  <para style="q1" vid="ECC 12:4">cidau nruine kwa ne mipeidung de tei mrak dizie,</para>
  <para style="q2" vid="ECC 12:4">nah releime lei tei kela kwa gah dizie.<verse eid="ECC 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 12:5" />Cipau tingdau mipeidung heni kecehudung de hing dizie</para>
  <para style="q2" vid="ECC 12:5">nah puidiki ga kengngi kekieege bam dizie,</para>
  <para style="q1" vid="ECC 12:5">nah almond bang pepa pah kecudau,</para>
  <para style="q2" vid="ECC 12:5">nah tangriem penui katei penui de teu kereei kedidau,</para>
  <para style="q2" vid="ECC 12:5">nah nang n luilung gade tei keneube teilu tadi kecudau.</para>
  <para style="q1" vid="ECC 12:5">Minabe kelungta peki kemtak ni ga gwang di</para>
  <para style="q2" vid="ECC 12:5">nah mina puidikidung ga hei eh hap eh tet nghung zie. <note caller="+" style="f"><char style="fr" closed="false">12:5 </char><char style="ft" closed="false">Ketsai mede herau mna kedi</char></note><verse eid="ECC 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 12:6" />Ncu dam kegaibe de nsung lu</para>
  <para style="q2" vid="ECC 12:6">rangkanggeu ria cak di kemak dwa ge,</para>
  <para style="q2" vid="ECC 12:6">mede kecak kwakgwa pang di kemak dwa,</para>
  <para style="q2" vid="ECC 12:6">mede duilet ga duibung popdi kemak dwa,</para>
  <para style="q2" vid="ECC 12:6">mede tekwa ga heria cakdi kemak dwa,<verse eid="ECC 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 12:7" />kideu gade gwang kela rebui kideu ga caili gwangdi kemak dwa,</para>
  <para style="q2" vid="ECC 12:7">nah Tinggwang ne pwapeu kebeu rabe Tinggwang da caili gwang di kemak dwa.<verse eid="ECC 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 12:8" />“Mwangrim ge kenzwa da,” keledeube rangzeu, “Maleune de mwangzui ge nzwa gah di zeu.”<verse eid="ECC 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9" />Keledeube au maci nah pa minadung de maci ledeu beu la. Pa cide pekeyi pekesia peei luda iciu eh macisamdung kekiee ge perehi gage mtei gai di. <verse eid="ECC 12:9" /><verse number="10" style="v" sid="ECC 12:10" />Keledeube pe samdung mcihegi, kesamsang nah kesangbe teu eh rau kera peei luda.<verse eid="ECC 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 12:11" />Makecime samdung au kauruine lampui sau kela tuiting ge nzwa da. Makecime ne ledeu kelu samdung hekwa kelu au gojal gia ntipbing kelube nzwa da, Meurün kekwabe hangge ne ledeu kebeu.<note caller="+" style="f"><char style="fr" closed="false">12:11 </char><char style="ft" closed="false">Meurün kekwabe ge de kecu pekie au Tinggwang mede Solomon de rang kecu nzwa bam</char></note> <verse eid="ECC 12:11" /><verse number="12" style="v" sid="ECC 12:12" />A na, nang mage gade mriak si lu: laisiukwakdung raucang kelu penli gah, nah laisiu peei kie ham kecu n pum tei mnei dizie.<verse eid="ECC 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 12:13" />Maleune kingnei cangsiak kelu cai</para>
  <para style="q2" vid="ECC 12:13">cide tei cangsiak lu kerane,</para>
  <para style="q1" vid="ECC 12:13">nang n Tinggwang de hinglu nah pe aja kai kebeu pelane mzai lu,</para>
  <para style="q2" vid="ECC 12:13">kedanemene mina dage tei lulo kebeu au aide pekiene da.<verse eid="ECC 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 12:14" />Kedanemene bata tei kegai pelane ziemne Tinggwang ne tutiak teugwang zie,</para>
  <para style="q2" vid="ECC 12:14">ma ngkim kembai leune de si eh,</para>
  <para style="q1" vid="ECC 12:14">keyibe de kesiabe de. <note caller="+" style="f"><char style="fr" closed="false">12:14 </char><char style="ft" closed="false">2 Cor. 5:10</char></note><verse eid="ECC 12:14" /></para>
  <chapter eid="ECC 12" />
</usx>