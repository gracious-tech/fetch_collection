<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Zeme(N) Bible Project</book>
  <para style="ide">UTF-8</para>
  <para style="h">Habakkuk</para>
  <para style="toc1">Habakkuk Laisiukwak</para>
  <para style="toc2">Habakkuk</para>
  <para style="toc3">Hab.</para>
  <para style="mt">Habakkuk</para>
  <para style="mt">Habakkuk Laisiukwak</para>
  <para style="is">Mraisam</para>
  <para style="ip">Tinggwang penai caihakecibe mpausam de nzwa Habakkuk raugai. Habakkuk au Judah ga kedimedung kegahme de teikeherei ngaulu, cine pa daitei eh Tinggwang kenlien mina aidungde peu lunghyi lubi keteu gai. Tinggwang au Babylonme gwang eh Judah de saja peu kera rang kegai dau, Habakkuk pelung nei kidi. Dainzwa Tinggwang au Babylonme teu heta tei lai zeubi pa cilu tadi, penui au Jewme kenlienme swade nlienki kecume, peu tutiak leugwang gai kerade. Tinggwang samli peu kegai au kemzuime au Tinggwang petaube teu kebam cisiak kebamne. Tinggwang au Habakkuk dage peting siakdau Babylonme ziemne kemzuibe gwang zie kecude rangbeu. Habakkuk ketwa kekiee ge tei eh pe laisiukwak penli di.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Habakkuk keheteu nah Tinggwang samli (1:1-11)</para>
  <para style="io1">Habakkuk keheteu kenabe nah Tinggwang samli (1:12-2:20)</para>
  <para style="io1">Habakkuk kekie (3:1-19)</para>
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="s">Habakkuk Kencam</para>
  <para style="m">
    <verse number="1" style="v" sid="HAB 1:1" />Caihakecibe Habakkuk sam ngaukelu,<verse eid="HAB 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HAB 1:2" />“RAMPAUBO, Ih daitie ge kengha ziemne mra laino, nah nang kingnei lak no?</para>
  <para style="q" vid="HAB 1:2">Ih n dage mra gai, ‘Zaisiet!’ dede nang ngha beulak.<verse eid="HAB 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 1:3" />Nang daitei acu peu samsangkemak zai cikenzwa ngau nah bata kesia peu pie bamla no?</para>
  <para style="q" vid="HAB 1:3">Kekap nah zaisiet a dwaga bam; nah luga aika keregi, nah kesamlim kecu cuhdi.<verse eid="HAB 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 1:4" />Cine hezaibe mnei di zeu, nah madaude kemzuibe teibeu meda,</para>
  <para style="q" vid="HAB 1:4">Kedanemene kemaume ne kemzuime de twagwapung bam; cine kemzuibe de au kebai gi dida.”<verse eid="HAB 1:4" /></para>
  <para style="sp">Habakkuk dage RAMPAUBE samli</para>
  <para style="s">Rampaube Samli</para>
  <para style="q">
    <verse number="5" style="v" sid="HAB 1:5" />“Heleuhdung de piegai nah penuide mcet bamlu; nnui swagah süt lu!</para>
  <para style="q" vid="HAB 1:5">Ih nnui tingdau mage nnui nlum gailak zing kecu ge teigai bi lai eh bam nnuide peu cide cigwang kecudau.<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ACT 13:41">Bat. 13:41</ref></char></note><verse eid="HAB 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 1:6" />Cine pielo! Ih Chaldeame de teucuh lai eh bam, cipau zaisiet nah mtakla kemak leuh de,</para>
  <para style="q" vid="HAB 1:6">penui gu kemak hangdeu gumlu kerane penui kideube ga tetpet la dida.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="REV 20:9">Keu. 20:9</ref></char></note><verse eid="HAB 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HAB 1:7" />Penui au ngaukehing nah kengngi ge; penuikatei penui suibe teila.<verse eid="HAB 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 1:8" />Penui hekwendung de kaudaunadung swade mzetki, tinghegi heneudung swade mzetki.</para>
  <para style="q" vid="HAB 1:8">Cine penui hekwendung piceu,</para>
  <para style="q" vid="HAB 1:8">nah penui gu hekwen keteume mdei süt kecu gade gwa gwangla, penui lingrie nzwa eh matyei kera kelwa lim gwang.<verse eid="HAB 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 1:9" />Penui pelane regi kerane gwangla;</para>
  <para style="q" vid="HAB 1:9">penui maakiee au heciang deu tingkai nzwa eh tet, nah penui hebaangme heciangdung nzwa hekwa zie.<verse eid="HAB 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 1:10" />Cine penui hegwangpeidung de henui teila, nah kedimedung au penui ziemne henui ge gwale ma.</para>
  <para style="q" vid="HAB 1:10">Penui kuda bamdung de de nuineu la, kedanemene penui hangdeu hekwa cuh lula nah cide keu lula.<verse eid="HAB 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 1:11" />Pecai tingkai gui kelwa gwang zie; cide guikah tet dizie, penui au kemaume, penui kengkieng au penui tinggwang da.”<verse eid="HAB 1:11" /></para>
  <para style="sp">Habakkuk Rampaube dade keteu daigai kecu</para>
  <para style="s">Habakkuk Kencam Kenabe</para>
  <para style="q">
    <verse number="12" style="v" sid="HAB 1:12" />“Nang ndaa gwang kedi ting gade meni, RAMPAUBE a Tinggwang, a Kemcibe? Anui au tsai dilak.</para>
  <para style="q" vid="HAB 1:12">RAMPAUBE penuide tutiak kera ziemne nlum gaibeu, nah nang, Tangtsube, penui de teimzuilu kerane teicuh luda.<verse eid="HAB 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 1:13" />Kemau ga piegai kera n miak au mci hamdi, nah nang mina kemau ketei ngau kebam de n lungning ma;</para>
  <para style="q" vid="HAB 1:13">nang daitei mina peciem ketei kemau aidungde de lialu lai no?</para>
  <para style="q" vid="HAB 1:13">Nang daitei eh kemaume penui swa masangki kecume de ngkap kebam dau mlei mene bamdi zeu no?<verse eid="HAB 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 1:14" />Nang mina de jaaidi ga heka nzwa teigai, kaucietnadung penui reuga kedibe kega nzwa.<verse eid="HAB 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 1:15" />Pa minadung de kagwak le heka ketui nzwa tui;</para>
  <para style="q" vid="HAB 1:15">pegu helang ga minadung de teukerei tet;</para>
  <para style="q" vid="HAB 1:15">pegu teu kehekwa rak gade penuide teu hekwalu;</para>
  <para style="q" vid="HAB 1:15">cine pa herwa nah pe suiyi bam.<verse eid="HAB 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HAB 1:16" />Cine pa pegu langdung de reca eh keru ratak teibeu la</para>
  <para style="q" vid="HAB 1:16">nah pegu kehekwa rak de de marim kehengui rugai beula,</para>
  <para style="q" vid="HAB 1:16">cine pa pegu helang ziemne lungh kehega bam,</para>
  <para style="q" vid="HAB 1:16">nah pe taktyei de tyei yitube.<verse eid="HAB 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 1:17" />Cine pa pegu helang tei mta bam zieni,</para>
  <para style="q" vid="HAB 1:17">nah pa pe ngaugia teu mene heleuhbedung de teingkap eh bam zieni?”<verse eid="HAB 1:17" /></para>
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="q">
    <verse number="1" style="v" sid="HAB 2:1" />Ih a kekwabam ga saplu nah reketbam ga akatei kwa bam zie,</para>
  <para style="q" vid="HAB 2:1">nah RAMPAUBE a dage dai ranggai zie bi Ih kwa teune eh piebam zie</para>
  <para style="q" vid="HAB 2:1">nah Ih dainzwa a ncam gade nreulu zie bi.<verse eid="HAB 2:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="HAB 2:2" />RAMPAUBE a sam keli eh ranggai,</para>
  <para style="q" vid="HAB 2:2">“Marengei aide raupwa bamlu, nah lidei kwak gage rau mcigi lu iciu eh cide piage peigai de peilu kerane.<verse eid="HAB 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 2:3" />Kedanemene marengei cide au gwangdai kera tingdau ziemne nah cide rangbeu bi zie nah tei mene ta lak.</para>
  <para style="q" vid="HAB 2:3">Cide gwang ri liede, kwa bamlu. Cide gwang bi zie nah cide gwang ridi lak.<verse eid="HAB 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 2:4" />Pielo! Kemau tei neu kelame au pe da keyi gah eh pe zaidi dila. Dede samsang kelame au pe kenlum gade lunghla.<verse eid="HAB 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HAB 2:5" />Zau au pezai kesia rehangpei gede peu samzai tei kelakne kecwa ge,</para>
  <para style="q" vid="HAB 2:5">dede herau ge nzwa pe kehengim di nah ketsai nzwa mnunglu lama.</para>
  <para style="q" vid="HAB 2:5">Pekatei pe ziemne pa heleuhdung de teu hekwa nah pekatei pe ziemne minadung pelane de peu ngkwalu.<verse eid="HAB 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 2:6" />Ma aidungde teu eh pecu rangmsia dilak ni nah pecu henui lei tei eh aide rang zie,</para>
  <para style="q" vid="HAB 2:6">‘Co pegu kemakbe tei ngkiee kebambe de nang au tei lubui da! Nang daitiege nnui pau pung kelame teu eh peulo eh hei reureu bam laino?’<verse eid="HAB 2:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="HAB 2:7" />Nnui pau pung kelame cimezing eh cuhdai lak ni, nah nang hing kelade mrak gwangdai lak ni?</para>
  <para style="q2" vid="HAB 2:7">nnui penui ziemne mbeu dizie.<verse eid="HAB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HAB 2:8" />Nnui mina heleuh kekiee gede tui kedine, penui ring kebamme pelane nnuide tuilu zie.</para>
  <para style="q2" vid="HAB 2:8">Nnui mide daptset kedine nah hangdeu, namdidung dage nah lungh kebam peciakne dage nnui zai kesia ziemne.<verse eid="HAB 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 2:9" />‘Co, cauge pe ki ziemne peciem kesia ge teigai bi nnui au tei lubui da,</para>
  <para style="q2" vid="HAB 2:9">iciu eh pa herakesiabe dade kelilu kerane pe ciep tei hu gai.’<verse eid="HAB 2:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="HAB 2:10" />Mina kekieege de teitset kedine nnui nnui kilungme dage hengam teugwang beu da, nah nnuikatei nnui dage kemau teigai luda.<verse eid="HAB 2:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="HAB 2:11" />Tangtsudung kirie gade hap pet dizie, nah hejadung ne penui sam keli zie,<verse eid="HAB 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HAB 2:12" />‘Co kemau reu gage namdi tumlu nah cide mide daptset eh teilu.’<verse eid="HAB 2:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="HAB 2:13" />Keda leuhdung kemta bata tei eh mnei dida</para>
  <para style="q2" vid="HAB 2:13">nah penui teikelu leune miheu mmi dida, aide reugwame reu RAMPAUBE dade meni?<verse eid="HAB 2:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="HAB 2:14" />Dede kideube au RAMPAUBE kendu maci le jaaidi ga dui pui kebam nzwa pui dizie.<verse eid="HAB 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 2:15" />‘Co cau pe kidame de sak kera ketang labi,</para>
  <para style="q" vid="HAB 2:15">nang n rata keulia gai nah penuide peu sakmie</para>
  <para style="q" vid="HAB 2:15">ciu eh penui paula kebam de pie kerane.’<verse eid="HAB 2:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="HAB 2:16" />Kendu be meliene hengam le nnui da pui di zie.</para>
  <para style="q" vid="HAB 2:16">Cu nnui nlia da! Saklu nah nnui nnui geu rumkemak de peu ngau dizie!</para>
  <para style="q2" vid="HAB 2:16">RAMPAUBE ba zetle kebam piak de n da gwang lada,</para>
  <para style="q2" vid="HAB 2:16">nah hengam le n kendu hezuipung dizie.<verse eid="HAB 2:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="HAB 2:17" />Nnui Lebanon dage nnui zaisia kegai de nnui de nzu dizie nah makaunedung ma tei kemsia de le nnuide keheu zieda.</para>
  <para style="q2" vid="HAB 2:17">Kedanemene nnui mina jai teilwa kegai ziemne nah hangdeu, namdidung, nah cika lungh kebamdung de da nnui zaisia gai.<verse eid="HAB 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="HAB 2:18" />Heri kelu mamie aide n ziemne pe kemmi dai bam no? Kedanemene cida au mina teikelu ge, hegeu tei lwa kelu gade teigai kecu, cide au kenret keledeu ge;</para>
  <para style="q" vid="HAB 2:18">cine pa mlei kemak herabedung de tei kegai ga pe kenlum kebamne.<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false">Lie115:4-8; 135:15-18; Isa 44:9-20; 46:6-7; Jer 10:2-16 58. </char></note><verse eid="HAB 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HAB 2:19" />‘Co tsingkang gede mraklu de kegai nnui au tei lubui da! Mede mlei kemak tangtsu kangge dage cuhlu de kegaibe!’ Ma aidungde magede ledeu lubui ni?</para>
  <para style="q" vid="HAB 2:19">Pielo, cide rangkanggeu nah kecak le puipung, dede peda keringria gah zing<note caller="+" style="f"><char style="fr" closed="false">2:19 </char><char style="ft" closed="false">1 Cor. 12:2</char></note>.<verse eid="HAB 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="HAB 2:20" />Dede RAMPAUBE au pe kemci kerecaki ga bam! Kideube pelane pe dwa gade zing de dilu.”<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="s">Habakkuk Kekie</para>
  <para style="m">
    <verse number="1" style="v" sid="HAB 3:1" />Caihakecibe Habakkuk gu kekie. Shigionoth gade:<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">Shigionoth au Hebrew tet gade lei zai rehi rang kegai ge cide Leidung nzwa.</char></note><verse eid="HAB 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HAB 3:2" />RAMPAUBO, nang tei kegai de Ih siuda, nah Ih ngngi bam.</para>
  <para style="q" vid="HAB 3:2">RAMPAUBO, n tatei kegaide cu anui tingdau teigai dailo; cu tingdau ga peu cilu kerane;</para>
  <para style="q" vid="HAB 3:2">n ratadi liede ngaunggia lu kera nsunggai lo.<verse eid="HAB 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAB 3:3" />Tinggwang au Teman gade gwang, nah Kemci Tinggwang au Paran deutu gade gwang.<char style="qs">Selah</char></para>
  <para style="q" vid="HAB 3:3">Pe kendu le tinggimdung gumpung bam, nah kideube ga pe hetwa le puibam<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">Teman au Edom deuzi ge, Judah namdi tingpeule. Edom namdi ziemne sap kebam pelane. </char></note>.<verse eid="HAB 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAB 3:4" />Kebaa nzwa baaha ge, pe ba gade kebaa ria kena baaha ge bam;</para>
  <para style="q" vid="HAB 3:4">nah cika pa pe kengkieng kebai pwabam.<verse eid="HAB 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HAB 3:5" />Mateei kesia pedwa mie raidi,</para>
  <para style="q" vid="HAB 3:5">nah rapia de pe caisui la.<verse eid="HAB 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAB 3:6" />Pa mtaklu nah kideube de mdet gai; pa piegai nah heleuhdung de kecui gai.</para>
  <para style="q" vid="HAB 3:6">Kelungta kela lamlwatudung de tei zangra di, nah bammui kela hangdeutudung hena miedi.</para>
  <para style="q" vid="HAB 3:6">Pe lampui au bammui kelabe.<verse eid="HAB 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HAB 3:7" />Cushme paikidung gade keherei kebam, nah paiki kelim pai Midiame deu ga kebam mbeu bam kecu Ih ngau.<verse eid="HAB 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAB 3:8" />RAMPAUBE hereukidung de pe rata bam ni? Hereukidung dage n lunghop bam ni,</para>
  <para style="q" vid="HAB 3:8">mede jaaidi de n rata bam no,</para>
  <para style="q" vid="HAB 3:8">nang n hekwendung nah ngkieng kelu n bagidung reuga tet keladau?<verse eid="HAB 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HAB 3:9" />Nang n lakpi teu kera mteilu; nang n lakpitsidung n lakpi gage kailu! <char style="qs">Selah </char></para>
  <para style="q" vid="HAB 3:9">Nang kideube de hereukidung le mzi lu.<verse eid="HAB 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAB 3:10" />Lamlwatudung ncu ngaulu eh mbeudi.</para>
  <para style="q" vid="HAB 3:10">Dui penui reu ga rui mie; jaaidi kecok mra gai.</para>
  <para style="q" vid="HAB 3:10">Cide pe nswakdung cehu cuhdi.<verse eid="HAB 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAB 3:11" />Tingnaimiak nah hekei penai bam hutu gade mlai mene sapdi,</para>
  <para style="q" vid="HAB 3:11">n lakpitsidung lim kela gade pe baa ngau kegaine,</para>
  <para style="q" vid="HAB 3:11">nah n ngei tingkepik nzwa kepik kegaine.<verse eid="HAB 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HAB 3:12" />Nang n rata eh kideu tetkah gwang. N lunghop gade nang heleuhdung de dapgai.<verse eid="HAB 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HAB 3:13" />Nang n minadung de kelilu kerane tetpet, nangne keniak kelube de kelilu kerane.</para>
  <para style="q" vid="HAB 3:13">Nang kenlienme kilung ga muiteube de kekei miedi nah pe caisuime de ngkap zingdi. <char style="qs">Selah</char><verse eid="HAB 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HAB 3:14" />Nang pe reugwame peu bungdi penui lakpitsidung le kedanemene cide anui de teizang di kera rahang nzwa kegwang ne,</para>
  <para style="q" vid="HAB 3:14">kegahme de ngkim eh tei keherei bam kelame nzwa penui ngkau eh.<verse eid="HAB 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HAB 3:15" />Nang n kwendung teu eh jaaidi reu tet, nah dui kengkieng de tei mdi dida.<verse eid="HAB 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HAB 3:16" />Ih siuda, nah a lung gade mbeudi! A muileukung ngngi di pekwa de siu gai ge.</para>
  <para style="q" vid="HAB 3:16">Kemnei a radung ga gwangdi nah a lung gade Ih mbeudi,</para>
  <para style="q" vid="HAB 3:16">anuide gwaketang kecume de saja peu kera Ih zingde eh peting gwang kera kwa kebamdau.<verse eid="HAB 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HAB 3:17" />Nzütbangdung petsi ga liede</para>
  <para style="q2" vid="HAB 3:17">nah kubebang ga petsi bui melie de;</para>
  <para style="q" vid="HAB 3:17">nah olive bang buipet kecude yilu melie de,</para>
  <para style="q2" vid="HAB 3:17">nah luhdung mei bui petlu melie de,</para>
  <para style="q2" vid="HAB 3:17">nah kauhaudung tsaidi liede</para>
  <para style="q2" vid="HAB 3:17">nah hetum kidung mta dide, Ih aide tei zie.<verse eid="HAB 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="HAB 3:18" />Iciude, Ih RAMPAUBE da a suila zie.</para>
  <para style="q2" vid="HAB 3:18">Ih a suiyi zie kedanemene RAMPAUBE au a kelikelube lu.<verse eid="HAB 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HAB 3:19" />RAMPAUBE Tinggwang au a kengkingbe</para>
  <para style="q2" vid="HAB 3:19">nah pa a pi heti pi nzwa teibeu.</para>
  <para style="q2" vid="HAB 3:19">Pa acu heni kecehudung ga teuswa beu.</para>
  <para style="q3" vid="HAB 3:19">Lei pie kerengeibe da, a leiria bungdung gade.<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>