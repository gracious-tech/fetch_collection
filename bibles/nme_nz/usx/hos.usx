<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HOS" style="id">- Zeme(N) Bible Project</book>
  <para style="toc3">Hos.</para>
  <para style="toc2">Hosea</para>
  <para style="toc1">Hosea Laisiukwak</para>
  <para style="mt">Hosea</para>
  <para style="mt">Hosea Laisiukwak</para>
  <para style="is">Mraisam</para>
  <para style="ip">Caihakecibe Hosea au nreule gwangram ga kelunghme, pa cide de Ephraim ki qula. Pa hegwangpei Jeroboam 753 BC bekum tsai kedi dwa pe bata ndeu lu, nah pa 721 BC bekum Samaria kaukedi dwa pe samdung peu gai.</para>
  <para style="ip">Pesam 1-3 ga pa masangkemak pe nau Gomer de keku ha ranggai. Pa masang kemak de au Israel Tinggwang de samkak kelude teilung gade masanglu ta kedide. Tinggwang pe samlamdung pelane ziemne pecu nggia nah hunglu kecube mene, Israelmedung penui meiciu pwa mamiedung de recabeu.</para>
  <para style="ip">Nzeukemak nah mide petau tei eh ngngwa lu kemak aide penui au Tinggwang de nah penui ramme de hung kemak keulia kebam tei.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Hosea pe kelak ga kelung ha (1:1-3:5)</para>
  <para style="io1">Israel Kemau (4:1-6:3)</para>
  <para style="io2">Israel ziemne Saja (6:4-10:15)</para>
  <para style="io2">Tinggwang tutiak nah ngaugia</para>
  <chapter number="1" style="c" sid="HOS 1" />
  <para style="s">Hosea Nau nah Pename</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1" />Judah deuceu ga hegwangmedung Uzziah, Jotham, Ahaz nah Hezekiah, Beeri napei Hosea tingdau nah Israel gwangpei Joash napei Jeroboam tingdau RAMPAUBE sam aide gwang. <verse eid="HOS 1:1" /><verse number="2" style="v" sid="HOS 1:2" />RAMPAUBE Hosea dade marang raitu kecudau, RAMPAUBE pe dage rangdi,</para>
  <para style="q" vid="HOS 1:2">“Miecu, helipui gede n nau tei kera luulu.</para>
  <para style="q" vid="HOS 1:2">Pa pename lungh luzie helili gade.</para>
  <para style="q" vid="HOS 1:2">Kideube au helili süt bam kedine</para>
  <para style="q" vid="HOS 1:2">RAMPAUBE de pütdi eh.” <verse eid="HOS 1:2" /><verse number="3" style="v" sid="HOS 1:3" />Cine Hosea mie Diblaim napui Gomer de pe naulu, nah pa tetlak lwe mipeina ge pecu mna beu. <verse eid="HOS 1:3" /><verse number="4" style="v" sid="HOS 1:4" />Pecai RAMPAUBE Hosea dage rangdi,</para>
  <para style="q" vid="HOS 1:4">“Pezi Jezreel qulu.</para>
  <para style="q" vid="HOS 1:4">Kedanemene tiemene</para>
  <para style="q" vid="HOS 1:4">Ih Jehu kelak de saja peu zie</para>
  <para style="q" vid="HOS 1:4">Jezreel ga hejai teilwa kegaine,</para>
  <para style="q" vid="HOS 1:4">nah Ih Israel kelak gwangram</para>
  <para style="q" vid="HOS 1:4">de peu penli tei dizie.<verse eid="HOS 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 1:5" />Cide Ih Jezreel Langkam gade,</para>
  <para style="q" vid="HOS 1:5">Israel lakpi teicum kegai benai</para>
  <para style="q" vid="HOS 1:5">teigwang zie.” <verse eid="HOS 1:5" /><verse number="6" style="v" sid="HOS 1:6" />Gomer tetlak dailwe mipuina ge mna lu. Pecai RAMPAUBE Hosea dage rangdi,</para>
  <para style="q" vid="HOS 1:6">“Pe zi Lo-Ruhamah qulu,</para>
  <para style="q" vid="HOS 1:6">kedanemene Ih Israel kelak dage</para>
  <para style="q" vid="HOS 1:6">ngaugia bamsi lakta nah</para>
  <para style="q" vid="HOS 1:6">Ih penui mau gibeu lakta.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="1PE 2:10">1 Pet. 2:10</ref></char></note><verse eid="HOS 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 1:7" />Dede Ih Judah kelak da ngaugia bam zie,</para>
  <para style="q" vid="HOS 1:7">nah a katei penuide kelilu zie, Ih RAMPAUBE penui Tinggwang.</para>
  <para style="q" vid="HOS 1:7">Ih penuide</para>
  <para style="q" vid="HOS 1:7">lakpi, kiengtie, hereuketei, hekwendung mede hekwenketeume de teu eh keli beulak.”<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="TIT 3:4">Tit. 3:4</ref>,<ref loc="TIT 3:5">5</ref></char></note><verse eid="HOS 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 1:8" />Gomer au Lo-Ruhamah de nlau kelucai, pa tetlak dailwe mipeina ge mna lu. <verse eid="HOS 1:8" /><verse number="9" style="v" sid="HOS 1:9" />Pecai RAMPAUBE rangdi,</para>
  <para style="q" vid="HOS 1:9">“Pezi Lo-Ammi qulu,</para>
  <para style="q" vid="HOS 1:9">nnui a mina mede kecune,</para>
  <para style="q" vid="HOS 1:9">nah Ih au nnui Tinggwang meda.<verse eid="HOS 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 1:10" />Dede Israel ga minadung</para>
  <para style="q" vid="HOS 1:10">duikedikung ga heciangdung nzwa zie,</para>
  <para style="q" vid="HOS 1:10">cide mdet mede peici gailak.</para>
  <para style="q" vid="HOS 1:10">Cikade penui dage,</para>
  <para style="q" vid="HOS 1:10">‘Nnui au a mina meda,’ de eh rang kebeu gade,</para>
  <para style="q" vid="HOS 1:10">penui dage,</para>
  <para style="q" vid="HOS 1:10">‘Nnui au ringkela Tinggwang minadung,’<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">Rom. 9:26-28, 2 Cor. 6:18, 1 pet. 2:10.</char></note> de eh rang zie.<verse eid="HOS 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 1:11" />Judah ga minadung nah Israel ga miandung</para>
  <para style="q2" vid="HOS 1:11">ngngwa ngkwa luzie</para>
  <para style="q" vid="HOS 1:11">penui ziemne penui muiteu ge kedet luzie</para>
  <para style="q" vid="HOS 1:11">nah penui kideube gade cuh luzie</para>
  <para style="q" vid="HOS 1:11">Jezreel tingba de au dizu zie kecune.<verse eid="HOS 1:11" /></para>
  <chapter eid="HOS 1" />
  <chapter number="2" style="c" sid="HOS 2" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 2:1" />N sinamedung dage ranggailo, ‘A minadung!’</para>
  <para style="q" vid="HOS 2:1">nah n tipuidung dage ranggailo, ‘Nnuide de ngaugia pwalia gaida.’”<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="1PE 2:10">1 Pet. 2:10</ref></char></note><verse eid="HOS 2:1" /></para>
  <para style="s">Israel tutiak nah Teucuh kebeu</para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 2:2" />A name, nnui pui de kemmau teugwang hetu tulo, hetuhera ge teugwanglu,</para>
  <para style="q2" vid="HOS 2:2">pa au anau mede kecune,</para>
  <para style="q2" vid="HOS 2:2">nah Ih pe nahpei meda.</para>
  <para style="q" vid="HOS 2:2">Pecu peupe helita de pedade keugi dilu,</para>
  <para style="q" vid="HOS 2:2">nah pe kemmha ta de pe tung kena kakgade.<verse eid="HOS 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 2:3" />Mecai, Ih pecu peu paaula dizie</para>
  <para style="q" vid="HOS 2:3">nah pe paaula de peu pecu kemna tingba benai nzwa lia gai zie.</para>
  <para style="q" vid="HOS 2:3">Ih pecu peu hetaideu nzwa dizie,</para>
  <para style="q" vid="HOS 2:3">kideu cangh kedibe nzwa,</para>
  <para style="q" vid="HOS 2:3">nah Ih pecu peu hereu eh tsai dizie.<verse eid="HOS 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 2:4" />Ih pe namedung de peu ngaugia bamta dizie,</para>
  <para style="q" vid="HOS 2:4">penui au helili kecube pui namedung kecune.<verse eid="HOS 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 2:5" />Penui pui au helipui ge kecune,</para>
  <para style="q" vid="HOS 2:5">nah penuide tetlak kelupui au hengam ta teidi.</para>
  <para style="q" vid="HOS 2:5">Pa rangdi, “Ih a mraimedung caisiu zie,</para>
  <para style="q" vid="HOS 2:5">penui acu tangku nah dui,</para>
  <para style="q" vid="HOS 2:5">a painidung,</para>
  <para style="q" vid="HOS 2:5">a gu maca nah zau pwapeu la kecune.”<verse eid="HOS 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 2:6" />Cine Ih pe lampui kaamdi kerane hetu le herie rie dizie.</para>
  <para style="q" vid="HOS 2:6">Ih pecu mmau eh herie teicu dizie</para>
  <para style="q" vid="HOS 2:6">iciu eh peu pecu pe lampui ngaulu tadi kerane.<verse eid="HOS 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 2:7" />Pa pe mraime de zuimie zie,</para>
  <para style="q" vid="HOS 2:7">dede pa penuide gwacang gailak.</para>
  <para style="q" vid="HOS 2:7">Pa penuide peei zie,</para>
  <para style="q" vid="HOS 2:7">dede pa penuide ngau gailak.</para>
  <para style="q" vid="HOS 2:7">Pecai pa rangzie,</para>
  <para style="q" vid="HOS 2:7">“Ih a nahpei raitube da cailigwang zieda,</para>
  <para style="q" vid="HOS 2:7">kedanemene cide au cuswa a ziemne yiki zie kecune.”<verse eid="HOS 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 2:8" />Kedanemene pa au Ih ne pecu meiciu</para>
  <para style="q" vid="HOS 2:8">zauci nah maca kepeu ci ma,</para>
  <para style="q" vid="HOS 2:8">nah rangkang nah kecak peusüt kegai cibam me kecune,</para>
  <para style="q" vid="HOS 2:8">cide pecai penui Baal ziemne teu eh bamla.<verse eid="HOS 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 2:9" />Cine Ih luhlüt dau pe meiciu keu caili dizie,</para>
  <para style="q" vid="HOS 2:9">nah peting dau a zauci de.</para>
  <para style="q" vid="HOS 2:9">Ih agu mamaipai nah helangpai keu caili dizie</para>
  <para style="q" vid="HOS 2:9">pa cide teu bahteu kelade.<verse eid="HOS 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 2:10" />Pecai Ih pe mraipeidung dwa pecu tei paaula gaizie,</para>
  <para style="q" vid="HOS 2:10">nah mige de a ba gade pecu keli beulak.<verse eid="HOS 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 2:11" />Ih pegu hengyidung de peu penli dizie,</para>
  <para style="q" vid="HOS 2:11">pe hengyidung, pe keici ngyidung, pe sabbath ngyidung de, nah pe renet ngkwa pelane.<verse eid="HOS 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 2:12" />“Ih pegu kubetsidung nah pegu tangzüt bangdung ngkap dizie,</para>
  <para style="q" vid="HOS 2:12">cide ha pa rangbam kelade,</para>
  <para style="q" vid="HOS 2:12">‘Aidungde a mraipeidung ne acu kepeu ziehidung.’</para>
  <para style="q" vid="HOS 2:12">Ih penuide hegung ge teibeu zie,</para>
  <para style="q" vid="HOS 2:12">nah renaam ga makaunedung cidungde tyei zie.<verse eid="HOS 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 2:13" />Ih pecu baaldung de kerecadung saja peu zie,</para>
  <para style="q" vid="HOS 2:13">pa penui dage kehengui ru kegai dau,</para>
  <para style="q" vid="HOS 2:13">pa pegu bakapdung nah henetdung teu hezutei keludau,</para>
  <para style="q" vid="HOS 2:13">nah pa pe mraipeidung da mie eh acu nsungta kedidau,</para>
  <para style="q" vid="HOS 2:13">Aide RAMPAUBE ndu gaila.”<verse eid="HOS 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 2:14" />Cine Ih pecu ngaudia luzie. Ih pecu hetaideu ga ngngwa mie</para>
  <para style="q" vid="HOS 2:14">pedage sam kenciep rangzie.<verse eid="HOS 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 2:15" />Ih pecu pegu kubeluhdung peudai dizie,</para>
  <para style="q" vid="HOS 2:15">nah Achor Langkam de keregui kikam ge tei zie.</para>
  <para style="q" vid="HOS 2:15">Pa cikade nda pe relei dau nzwa a sam keli beuzie,</para>
  <para style="q" vid="HOS 2:15">pa Egypt deu gade kempet dau nzwa.<verse eid="HOS 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HOS 2:16" />“Cipau nai, aide RAMPAUBE ndu kegai,</para>
  <para style="q" vid="HOS 2:16">nang acu, ‘A nahpei,’ de qu zie,</para>
  <para style="q" vid="HOS 2:16">nah nang acule, ‘A Baal,’ de eh qusi lakta.<verse eid="HOS 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HOS 2:17" />Ih penui mui gade Baal zidung keugi dizie,</para>
  <para style="q" vid="HOS 2:17">penui zidung nsungla sita dizie.”<verse eid="HOS 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="HOS 2:18" />“Cipau nai Ih penui ziemne</para>
  <para style="q" vid="HOS 2:18">renaamga makaunedung de ngngwa samkak ge tei luzie,</para>
  <para style="q" vid="HOS 2:18">tinggim ga nruinedung si eh,</para>
  <para style="q" vid="HOS 2:18">nah kideu ga bwakela kaunedung si eh.</para>
  <para style="q" vid="HOS 2:18">Ih lakpi, kiengtie, nah kideube gade hereu aidung gwagi dizie,</para>
  <para style="q" vid="HOS 2:18">nah Ih ncu peu kwak eh zeu luzie.<verse eid="HOS 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HOS 2:19" />Ih kelungta n nahpei teilu kera sampet beuzie,</para>
  <para style="q" vid="HOS 2:19">Ih masang, nzui, kesamsang, nah ngaugia gade n nahpei teilu kera sampet beuzie.<verse eid="HOS 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="HOS 2:20" />Ih samsang eh ndage sampet kegai teizie,</para>
  <para style="q" vid="HOS 2:20">nah nang RAMPAUBE de ci luzie.<verse eid="HOS 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="HOS 2:21" />Cipai nai,</para>
  <para style="q" vid="HOS 2:21">Ih samli peu zie, aide RAMPAUBE ndu kegai,</para>
  <para style="q" vid="HOS 2:21">Ih tinggimdung de samli peuzie</para>
  <para style="q" vid="HOS 2:21">nah penui kideube de samli peu zie.<verse eid="HOS 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="HOS 2:22" />Kideube meiciu, zauci nah maca de samli peu zie,</para>
  <para style="q" vid="HOS 2:22">nah penui Jezreel de samli peuzie.<verse eid="HOS 2:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="HOS 2:23" />Ih penuide a ziemne kideube gage ling luzie,</para>
  <para style="q" vid="HOS 2:23">nah Ih Lo-Ruhamah de ngaugia peu zie.</para>
  <para style="q" vid="HOS 2:23">Ih Lo-Ammi dage rangzie,</para>
  <para style="q" vid="HOS 2:23">‘Nang au Ammi Attah,’</para>
  <para style="q" vid="HOS 2:23">nah penui adage rangzie, ‘Nang au a Tinggwang.’”<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">Rom. 9:25, 1 Pet. 2:10</char></note><verse eid="HOS 2:23" /></para>
  <chapter eid="HOS 2" />
  <chapter number="3" style="c" sid="HOS 3" />
  <para style="s">Hosea Penau de ngngwa yi daikelu</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1" />RAMPAUBE piage a dage rang dai, “Mie daicu, mipui ge de hunglu, pe nahpei ne hung kelage de, dede helili kelapui gede, pecu hunglu. RAMPAUBE Israelme de hung kela nzwa, pecu hunglu, penui hera kedadung da nreu gwang eh kubetsi kekibe ne teikelu tangku de hungdi liede.” <verse eid="HOS 3:1" /><verse number="2" style="v" sid="HOS 3:2" />Cine Ih pecu a ziemne rangkanggeu kereimengei nah barley homer ge<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">220 liter</char></note> nah lethek ge<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">110 liter</char></note> le luilu.<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">rangkanggeu haige riakhena </char></note> <verse eid="HOS 3:2" /><verse number="3" style="v" sid="HOS 3:3" />Ih pedage rangdi, “Nang tingbazie kekiee ge acu ngngwa lung maisia. Nang helipui ge teilak mede mi kedame gu teilak. Cinzwa, Ih ncu ngngwa luzie.” <verse eid="HOS 3:3" /><verse number="4" style="v" sid="HOS 3:4" />Israelme au hegwangpei ge, hegwang napei, ratak, tsusum, hekeutupai mede kilung kelak mamiedung si mene lunghzie kecune. <verse eid="HOS 3:4" /><verse number="5" style="v" sid="HOS 3:5" />Pecai Israelme cailigwang zie nah RAMPAUBE, penui Tinggwang nah penui gwangpei David de peeizie, nah kamtule bie, penui RAMPAUBE nah pe keyi dwaga mbeu eh gwang zie.<verse eid="HOS 3:5" /></para>
  <chapter eid="HOS 3" />
  <chapter number="4" style="c" sid="HOS 4" />
  <para style="s">Israel de kemmau</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 4:1" />RAMPAUBE sam kingneilu, nnui Israelmedung.</para>
  <para style="q" vid="HOS 4:1">RAMPAUBE au kideube ga kelunghme de kemmau hetuketu ge bam,</para>
  <para style="q" vid="HOS 4:1">kedanemene cika makesang mede samkakkelu samsang, mede kideube ga Tinggwang de keci bamta kedine.<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="REV 6:10">Keu. 6:10</ref></char></note><verse eid="HOS 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 4:2" />Cika reset, kenret, teiketset kerega nah kemmha bam,</para>
  <para style="q" vid="HOS 4:2">minadung herietdung pelane gikah dida, nah hejai teilwa kecu cai teilwa bam dida.<verse eid="HOS 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 4:3" />Cine kideube canghdi zeuda,</para>
  <para style="q" vid="HOS 4:3">nah cika kelunghme leune riemdi zeuda;</para>
  <para style="q" vid="HOS 4:3">renaam ga makaunedung nah tingkam ga nruinedung,</para>
  <para style="q" vid="HOS 4:3">jaaidi ga heka kecang de, keugi di zeuda. <verse eid="HOS 4:3" /><verse number="4" style="v" sid="HOS 4:4" />Dede mige de de peu hetutu kera teugwang so;</para>
  <para style="q" vid="HOS 4:4">migede de peu kedage de mmau so.</para>
  <para style="q" vid="HOS 4:4">Kedanemene Ih mmau kelame au nnui, cingkumedung lu.<verse eid="HOS 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 4:5" />Nnui cingkumedung tingna kau dizie,</para>
  <para style="q" vid="HOS 4:5">caihakecime de nnuide ngngwa tingmui kau dizie,</para>
  <para style="q" vid="HOS 4:5">nah Ih nnui puide ngkap dizie.<verse eid="HOS 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 4:6" />A minadung de ngkap dida macilu kemakne.</para>
  <para style="q" vid="HOS 4:6">Nnui cingkumedung maci gi kedine,</para>
  <para style="q" vid="HOS 4:6">Ih de a cingkume ketei gade nnuide gi dizie.</para>
  <para style="q" vid="HOS 4:6">Ih nnui Tinggwang liede, nnui a zai nsungta kedine,</para>
  <para style="q" vid="HOS 4:6">Ih de nnui namedung de nsungta dizie.<verse eid="HOS 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 4:7" />Cingkume kiee reuge,</para>
  <para style="q" vid="HOS 4:7">penui adage kemau teigai kieeki.</para>
  <para style="q" vid="HOS 4:7">Cine Ih nnui gu hetwa de teu hengam tei dizie.<verse eid="HOS 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 4:8" />Penui a minadung kemau ketei gade tyeinggei lula;</para>
  <para style="q" vid="HOS 4:8">penui au penui kenlienta kieeki lu kera hengim la.<verse eid="HOS 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 4:9" />Minadung de nzwa cingkume dede saja peuzie:</para>
  <para style="q" vid="HOS 4:9">Penui tadung pelane ziemne Ih penuide saja peu zie;</para>
  <para style="q" vid="HOS 4:9">Ih penui batadung ziemne rui beu zie.<verse eid="HOS 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 4:10" />Penui tyei zie dede tyeiset lak;</para>
  <para style="q" vid="HOS 4:10">penui helili zie dede kieesi gailak,</para>
  <para style="q" vid="HOS 4:10">kedanemene penui RAMPAUBE dade ndei sütla kedine.<verse eid="HOS 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 4:11" />Penui au kemmha, zau, nah zauci penui suila, cidene penui peusui keugi dida.<verse eid="HOS 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 4:12" />A minadung penui gu tsing mamiedung de keteu la,</para>
  <para style="q" vid="HOS 4:12">nah penui tuitiedung ne caiha rang beula.</para>
  <para style="q" vid="HOS 4:12">Kedanemene kemmha kecet ne penui peusui tei mangla kedine,</para>
  <para style="q" vid="HOS 4:12">nah penui helipuidung ta teila dida penui Tinggwang dade samsang mene.<verse eid="HOS 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 4:13" />Penui lamlwatudung twangdung gage ratak tei gaila</para>
  <para style="q" vid="HOS 4:13">nah kideutudung gage kehengui ru gaila,</para>
  <para style="q" vid="HOS 4:13">mhubang, poplarbang nah terebinth gage,</para>
  <para style="q" vid="HOS 4:13">cidung pehum yi kecune.</para>
  <para style="q" vid="HOS 4:13">Cine n napuidung kemmha ta teila,</para>
  <para style="q" vid="HOS 4:13">nah n na naumedung hangngwata teila.<verse eid="HOS 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 4:14" />Ih n napuidung de saja peulak penui kemmhata tei kera tiak keludau,</para>
  <para style="q" vid="HOS 4:14">mede n na naumedung hangngwata ketei dau.</para>
  <para style="q" vid="HOS 4:14">Kedanemene mipeidung de penuide helipuidung de peula,</para>
  <para style="q" vid="HOS 4:14">nah penui ratakdung tei beula iciu eh penui kerecaki helipui de ngngwa kemmhata teilu kerane.</para>
  <para style="q" vid="HOS 4:14">Hangkiasam rang kela nzwa, Heleuh ge cilu maige ngkap dizie.<verse eid="HOS 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 4:15" />Nang Israel, kemmha ta tei dilu de,</para>
  <para style="q" vid="HOS 4:15">peu Judah de mau di selo.</para>
  <para style="q" vid="HOS 4:15">Gilgal ga mieso, nnui minadung;</para>
  <para style="q" vid="HOS 4:15">Beth Aven ga hangso,</para>
  <para style="q" vid="HOS 4:15">nah, “RAMPAUBE ringkela nzwa,” de rang eh reset so.<verse eid="HOS 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HOS 4:16" />Israel tumleina lungtak nzwa pelungtak kedine.</para>
  <para style="q" vid="HOS 4:16">Dainzwa eh RAMPAUBE tseheiziu ga meurünnadung de nzwa penuide tseheiziu ga ngngwa gwang lu laino?<verse eid="HOS 4:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HOS 4:17" />Ephraim mamiedung de ngngwa ket tei luda;</para>
  <para style="q" vid="HOS 4:17">pecu püt dilu.<verse eid="HOS 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="HOS 4:18" />Penui zau kengkieng de gah dide,</para>
  <para style="q" vid="HOS 4:18">penui au kemmha ta tei bamla;</para>
  <para style="q" vid="HOS 4:18">penui reu kedime penui ngamta de hungla.<verse eid="HOS 4:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="HOS 4:19" />Tingkai ne pecu pe hesiudung gage kezui luzie;</para>
  <para style="q" vid="HOS 4:19">nah penui nlum kemak ratakdung ziemne penui ngngam dizie.<verse eid="HOS 4:19" /></para>
  <chapter eid="HOS 4" />
  <chapter number="5" style="c" sid="HOS 5" />
  <para style="s">Israel de kemmau</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 5:1" />“Aide kingnei lulo, cingkumedung!</para>
  <para style="q" vid="HOS 5:1">Kingnei sünne gailo, Israelme!</para>
  <para style="q" vid="HOS 5:1">Kingneilu, hegwang kelak ga kelungme!</para>
  <para style="q" vid="HOS 5:1">Kedanemene nnui pelane reu ga tutiak gwang zie.</para>
  <para style="q" vid="HOS 5:1">Nnui Mizpah ga hetak ge dida</para>
  <para style="q" vid="HOS 5:1">nah Tabor deutu reu ga helang zangra ge dida. <verse eid="HOS 5:1" /><verse number="2" style="v" sid="HOS 5:2" />Mlaikelame mide daptset sütla dida,</para>
  <para style="q" vid="HOS 5:2">dede Ih penui pelane de saja peu zie,<verse eid="HOS 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 5:3" />Ih Ephraim de cibam,</para>
  <para style="q" vid="HOS 5:3">nah Israel au adade mbai bamma.</para>
  <para style="q" vid="HOS 5:3">Ephraim, nang cu au helipui ge nzwa dida;</para>
  <para style="q" vid="HOS 5:3">Israel hera dida.<verse eid="HOS 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 5:4" />Penui batadung penuide peu Tinggwang da nreugwang lak,</para>
  <para style="q" vid="HOS 5:4">kemmha lungcet de penui da bam kecune,</para>
  <para style="q" vid="HOS 5:4">nah penui RAMPAUBE de ci ma.<verse eid="HOS 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 5:5" />Israel ngang kelade pecu mmaula;</para>
  <para style="q" vid="HOS 5:5">Cine Israel penai Ephraim penai mau gade kau dizie;</para>
  <para style="q" vid="HOS 5:5">nah Judah de penai de ngngwa kau dizie.<verse eid="HOS 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 5:6" />Penui penui gu meuründung nah kauhaudung de ngngwa RAMPAUBE de peei kera mie zie,</para>
  <para style="q" vid="HOS 5:6">dede penui pecu peei gailak,</para>
  <para style="q" vid="HOS 5:6">kedanemene pa penui da la mede kecune.<verse eid="HOS 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 5:7" />Penui RAMPAUBE dade masang luma,</para>
  <para style="q" vid="HOS 5:7">penui hekaknadung mna kebeune.</para>
  <para style="q" vid="HOS 5:7">Keici ngyidung penui luh si eh penuide tuityei luzie.<verse eid="HOS 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 5:8" />Gibeah gade hereu teki kwa gailo,</para>
  <para style="q" vid="HOS 5:8">nah Ramah gade telui kwa gailo.</para>
  <para style="q" vid="HOS 5:8">Beth Aven nam ga hereu sah gailo:</para>
  <para style="q" vid="HOS 5:8">‘Benjamin! Anui nnui caisui luzie.’<verse eid="HOS 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 5:9" />Saja kepeu tingba benai Ephraim mrwa dizie.</para>
  <para style="q" vid="HOS 5:9">Israel leuhmedung kakgade teigwangbi kerabe Ih ndu lia dida.<verse eid="HOS 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 5:10" />Judah ga muiteumedung au herai tsu pwa mlai kelame nzwa lie.</para>
  <para style="q" vid="HOS 5:10">Ih dui nzwa eh penui reu gage a lunghop ruigai zie.<verse eid="HOS 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 5:11" />Ephraim de teikecai dida;</para>
  <para style="q" vid="HOS 5:11">pecu kemmau gade teikecai dida,</para>
  <para style="q" vid="HOS 5:11">kedanemene pa neungga eh mamiedung caisiu kedine.<verse eid="HOS 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 5:12" />Cine Ih Ephraim ziemne taklei ge nzwa zie,</para>
  <para style="q" vid="HOS 5:12">nah Judah kelak zimene ntu nzwa zie.<verse eid="HOS 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 5:13" />Ephraim pe mateei ngau keludau,</para>
  <para style="q" vid="HOS 5:13">nah Judah pe zam ngau keludau,</para>
  <para style="q" vid="HOS 5:13">cidau Ephraim Assyria ga mie,</para>
  <para style="q" vid="HOS 5:13">nah Judah samgwame de hegwang kedibe dage kengha kie kera langgai.</para>
  <para style="q" vid="HOS 5:13">Dede pa au nnuide teingkei beulu tadi</para>
  <para style="q" vid="HOS 5:13">mede nnui zam tei mmi lu tadi.<verse eid="HOS 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 5:14" />Cine Ih au Ephraim dade hingho ge nzwa zie,</para>
  <para style="q" vid="HOS 5:14">nah Judah kelak ziemne hinghona ge nzwa zie.</para>
  <para style="q" vid="HOS 5:14">Ih, Ih kecangde, teurakdi eh pak dizie;</para>
  <para style="q" vid="HOS 5:14">Ih penuide pungtet dizie,</para>
  <para style="q" vid="HOS 5:14">nah penuide kelilu kera migede gah dizie.<verse eid="HOS 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 5:15" />Ih tet zie da delwe a bam ga cailigwang dizie,</para>
  <para style="q" vid="HOS 5:15">penui penui mau petlu eh acu peei kemaktane,</para>
  <para style="q" vid="HOS 5:15">penui keherei eh acu lungsang tei pei kemaktane.”<verse eid="HOS 5:15" /></para>
  <chapter eid="HOS 5" />
  <chapter number="6" style="c" sid="HOS 6" />
  <para style="s">Israel Helung nreu kemak</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 6:1" />Israelme hangge ge dage ranggai, “Gwanglu, anui RAMPAUBE da caili gwang cugo.</para>
  <para style="q" vid="HOS 6:1">Pa anuide teurak kecai dida, dede pa anuide teingkei beu zielu;</para>
  <para style="q" vid="HOS 6:1">pa anuide rezam dida, dede pa anui zamdung de kang beuzie.<verse eid="HOS 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 6:2" />Langna cai pa anuide tei ngkieng beuzie,</para>
  <para style="q" vid="HOS 6:2">pa anuide langcumne benai teucuh beuzie,</para>
  <para style="q" vid="HOS 6:2">nah anui pe dwaga lungh zie.<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">Luk. 24:46</char></note><verse eid="HOS 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 6:3" />Anui RAMPAUBE de ci lugo;</para>
  <para style="q" vid="HOS 6:3">RAMPAUBE de cilu kera anui laikai tei lugo.</para>
  <para style="q" vid="HOS 6:3">Anui RAMPAUBE de cilu kera laikai tei lugo;</para>
  <para style="q" vid="HOS 6:3">pa tetpet kera au tingcang nuge nzwa dizie;</para>
  <para style="q" vid="HOS 6:3">pa anui da tingrui nzwa gwang zie,</para>
  <para style="q" vid="HOS 6:3">heriak tingrui hangdeu ga rui kemie nzwa.”<verse eid="HOS 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 6:4" />Ephraim, Ih ncu teu daitei laino?</para>
  <para style="q" vid="HOS 6:4">Judah, Ih ncu teu daitei laino?</para>
  <para style="q" vid="HOS 6:4">N kesamsang au tingcang mwa ge nzwa,</para>
  <para style="q" vid="HOS 6:4">hezin gah zette di kelabe nzwa.<verse eid="HOS 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 6:5" />Cine Ih caihakecime de teu penuide dang kecaidi kerane langgai,</para>
  <para style="q" vid="HOS 6:5">Ih penuide a mui gade kepet samdungde le teitset dida.</para>
  <para style="q" vid="HOS 6:5">N tutiak au kebaa baa kepet nzwa lie.<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="JER 5:14">Jer. 5:14</ref></char></note><verse eid="HOS 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 6:6" />Ih ratak mene kesamsangbe asui kelane,</para>
  <para style="q" vid="HOS 6:6">nah keru recadung swade Tinggwang maci be.<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">Mat. 9:13, 12:7, Mrk. 12:33</char></note><verse eid="HOS 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 6:7" />Penui Adam nzwa samkakkelu de gileu dida;</para>
  <para style="q" vid="HOS 6:7">penui a dade masang tadi.<verse eid="HOS 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 6:8" />Gilead au kesiaketeime namdi ge</para>
  <para style="q" vid="HOS 6:8">hejai pipadung le puidi.<verse eid="HOS 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 6:9" />Sütketyeime maa migede kwa kebam nzwa,</para>
  <para style="q" vid="HOS 6:9">cinzwa cingkumedung gwang ngkwalu Shechem namdi ga heni kemci kemie lampui gade mide daptset gai kera;</para>
  <para style="q" vid="HOS 6:9">penui hengam maudung ge tei dida.<verse eid="HOS 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 6:10" />Israel kelak ga Ih ma kehing ge ngau da;</para>
  <para style="q" vid="HOS 6:10">Ephraim helili kecu cika bam, nah Israel hera dida.<verse eid="HOS 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 6:11" />Oh Judah, n ziemne, saja luhlüt ge mtei luda,</para>
  <para style="q" vid="HOS 6:11">Ih a minadung de peu lungh yi dai kecu dau.<verse eid="HOS 6:11" /></para>
  <chapter eid="HOS 6" />
  <chapter number="7" style="c" sid="HOS 7" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 7:1" />Ih Israel de teingkei beu neu kedi dau,</para>
  <para style="q" vid="HOS 7:1">Ephraim mau ngaupet dila,</para>
  <para style="q" vid="HOS 7:1">Samaria kemau batadung de,</para>
  <para style="q" vid="HOS 7:1">penui mide kecwata tei kecune;</para>
  <para style="q" vid="HOS 7:1">penui hangge ge dade sütla,</para>
  <para style="q" vid="HOS 7:1">nah puidi ga sütketyeime ketang lüt la.<verse eid="HOS 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 7:2" />Penui penui mlung gade cilu lama</para>
  <para style="q" vid="HOS 7:2">Ih penui kemau tadung pelane nsungla lie kecude.</para>
  <para style="q" vid="HOS 7:2">Cu au penui tadung penuide twagwa luda;</para>
  <para style="q" vid="HOS 7:2">cidungde a miakdwa gala.<verse eid="HOS 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 7:3" />Penui penui kemau le penui gwangpei suiyi tei lula,</para>
  <para style="q" vid="HOS 7:3">nah penui kenretle penui reu kedime de.<verse eid="HOS 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 7:4" />Penui au pelane kemmhata keteime,</para>
  <para style="q" vid="HOS 7:4">tangku kerube ne mimang teilum kelube nzwa,</para>
  <para style="q" vid="HOS 7:4">tokkui kenet kecu gade cide ngaupetlu kemakta</para>
  <para style="q" vid="HOS 7:4">misum ketum sita kedi nzwa.<verse eid="HOS 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 7:5" />Hegwangpei tingba benai kedimedung zau cuile penuide teimnei dila.</para>
  <para style="q" vid="HOS 7:5">Pa mide cwa kecume de pe ba ketwapet gai beula.<verse eid="HOS 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 7:6" />Mimang kenzwa mlungdung punglwe,</para>
  <para style="q" vid="HOS 7:6">penui mide kecwa ciem riem lula.</para>
  <para style="q" vid="HOS 7:6">Penui rata au tingmui ziu pelane lum bamla;</para>
  <para style="q" vid="HOS 7:6">tingcang cide miheu nzwa ru lumsüt bamla.<verse eid="HOS 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 7:7" />Penui pelane mimang nzwa lum bamla,</para>
  <para style="q" vid="HOS 7:7">nah penui reu kedime de tuityei lula.</para>
  <para style="q" vid="HOS 7:7">Penui gwangpeidung pelane kau dida,</para>
  <para style="q" vid="HOS 7:7">penui mige de acu qu lama.<verse eid="HOS 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 7:8" />Ephraim minadung<note caller="+" style="f"><char style="fr" closed="false">7:8 </char><char style="fq" closed="false">Ephraim minadung: </char><char style="ft" closed="false">Israelmedung</char></note> kakga ncüt lala.</para>
  <para style="q" vid="HOS 7:8">Ephraim au tangku kengpiak ge keu kedetgai kemakbe nzwa lie.<verse eid="HOS 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 7:9" />Sangme ne pe kengkieng tuityei luda,</para>
  <para style="q" vid="HOS 7:9">dede pa cide ci lama,</para>
  <para style="q" vid="HOS 7:9">peupu tamdung pe reuga la,</para>
  <para style="q" vid="HOS 7:9">dede pa cide ci lama.<verse eid="HOS 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 7:10" />Israel ngangkela de pe zierang tei eh mmaula;</para>
  <para style="q" vid="HOS 7:10">iciude, penui au penui Tinggwang RAMPAUBE da cailigwang lama,</para>
  <para style="q" vid="HOS 7:10">mede penui pecu de peei lama, ma aidung pelane teigwang liede.<verse eid="HOS 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 7:11" />Ephraim au tamhau ge nzwa da, mie nah pe kecet bam ma.</para>
  <para style="q" vid="HOS 7:11">Keraibe Egypt de qu gai,</para>
  <para style="q" vid="HOS 7:11">pecai kengha kie kerane Assyria gage lim gai dila.<verse eid="HOS 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 7:12" />Penui kemie dau, Ih penui reu gage a helang samgai zie,</para>
  <para style="q" vid="HOS 7:12">Ih penuide tingkam ruine de nzwa tei cak kei dizie.</para>
  <para style="q" vid="HOS 7:12">Ih penuide saja peu zie</para>
  <para style="q" vid="HOS 7:12">penui hemaa tei eh lim keladau.<verse eid="HOS 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 7:13" />Ainie penui au!</para>
  <para style="q" vid="HOS 7:13">Penui a dade mdeila dida,</para>
  <para style="q" vid="HOS 7:13">kengkap penui da gwangla dida!</para>
  <para style="q" vid="HOS 7:13">Penui acu mlai dida!</para>
  <para style="q" vid="HOS 7:13">Ih penuide kelilu bui nage,</para>
  <para style="q" vid="HOS 7:13">dede penui a dage kemret dida.<verse eid="HOS 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 7:14" />Penui mlung pelane teu eh ada hap gai ma,</para>
  <para style="q" vid="HOS 7:14">dede penui au penui zeudung gade hap bam.</para>
  <para style="q" vid="HOS 7:14">Penui meiciu nah zauci hekwa luda,</para>
  <para style="q" vid="HOS 7:14">nah penui a dade nreu dida.<verse eid="HOS 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 7:15" />Ih penuide ledeu beu nah penui ba teingkieng beu liede,</para>
  <para style="q" vid="HOS 7:15">penui cu acu mmau eh heciem riem bam dida.<verse eid="HOS 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HOS 7:16" />Penui cailigwang,</para>
  <para style="q" vid="HOS 7:16">dede penui ada cailigwang ma, Hutube Tinggwang da.</para>
  <para style="q" vid="HOS 7:16">Penui au lakpi ntip kemakbe nzwa da.</para>
  <para style="q" vid="HOS 7:16">Penui reu kedime kiengtie gade kau dizie</para>
  <para style="q" vid="HOS 7:16">Penui mui kesia ziemne.</para>
  <para style="q" vid="HOS 7:16">Penui au Egypt deu ga mi nuineu tei zie.<verse eid="HOS 7:16" /></para>
  <chapter eid="HOS 7" />
  <chapter number="8" style="c" sid="HOS 8" />
  <para style="s">Israel kaigwa Rum kera</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 8:1" />“RAMPAUBE rang eh, n muileu gage telui ge kailu!</para>
  <para style="q" vid="HOS 8:1">Helie ge au RAMPAUBE kelak reu ga gwangla da</para>
  <para style="q" vid="HOS 8:1">minadung a samkak de gileu kedine</para>
  <para style="q" vid="HOS 8:1">nah a aja de mlai kedine<verse eid="HOS 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 8:2" />Penui a dage sah gai, ‘A Tinggwang, anui Israelme ncu cibam.’<verse eid="HOS 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 8:3" />Dede Israel au ma keyibe gi dida,</para>
  <para style="q" vid="HOS 8:3">nah ngauraume pecu zuimie zie.<verse eid="HOS 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 8:4" />Penui hegwangpeidung kedet lula,</para>
  <para style="q" vid="HOS 8:4">dede a dade ma.</para>
  <para style="q" vid="HOS 8:4">Penui hegwangnadung kedet lula,</para>
  <para style="q" vid="HOS 8:4">dede a dade ma.</para>
  <para style="q" vid="HOS 8:4">Penui rangkang nah kecak le</para>
  <para style="q" vid="HOS 8:4">penui ziemne mamiedung tei luda,</para>
  <para style="q" vid="HOS 8:4">dede cide penuide ngkapdi kerane.”<verse eid="HOS 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 8:5" />“N tumna de mlai dida, Samaria.</para>
  <para style="q" vid="HOS 8:5">Mina aidungde reu ga rata ru bam dida.</para>
  <para style="q" vid="HOS 8:5">Daitiege penui mau eh lazie no?<verse eid="HOS 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 8:6" />Mamie aide Israel gade kegwang;</para>
  <para style="q" vid="HOS 8:6">cide heta keteime ge ne teilu;</para>
  <para style="q" vid="HOS 8:6">Cide au Tinggwang ma!</para>
  <para style="q" vid="HOS 8:6">Samaria ga reca kela kecak tumna mie de teikecai dizie.<verse eid="HOS 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 8:7" />Minadung tingkai gigai</para>
  <para style="q" vid="HOS 8:7">nah rahang rumlu.</para>
  <para style="q" vid="HOS 8:7">Sap kebam ciude pe bui gah;</para>
  <para style="q" vid="HOS 8:7">cide tokkui tei gailak.</para>
  <para style="q" vid="HOS 8:7">Cide ci lude,</para>
  <para style="q" vid="HOS 8:7">sangme ne cide tyei luzie.<verse eid="HOS 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 8:8" />Israel de au mneu luda;</para>
  <para style="q" vid="HOS 8:8">cu au penui kemta ge tei eh heleuhdung kakga la dida.<verse eid="HOS 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 8:9" />Penui kengha kie kerane Assyria hang</para>
  <para style="q" vid="HOS 8:9">pekatei renaam gada ge nzwa.</para>
  <para style="q" vid="HOS 8:9">Ephraim pe ziemne pe mraimedung de lilu.<verse eid="HOS 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 8:10" />Penui mraimedung de heleuhdung kakde li lu liede,</para>
  <para style="q" vid="HOS 8:10">Ih cu penuide keu hekwa luzie.</para>
  <para style="q" vid="HOS 8:10">Penui riem eh gah dizie</para>
  <para style="q" vid="HOS 8:10">Kedanemene hegwang nadung penuide kemneu ziemne.<verse eid="HOS 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 8:11" />Ephraim au kemau recadung ziemne recabamdung teingkie luda,</para>
  <para style="q" vid="HOS 8:11">dede cidungde kemautadung tei kerane recabamdung dida.<verse eid="HOS 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 8:12" />Ih penui ziemne a zai pia cang kerei raubeu lubui,</para>
  <para style="q" vid="HOS 8:12">dede penui cide ma ketsam ge nzwa pie dila.<verse eid="HOS 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 8:13" />Acu ratak tei kebeu a recadung au,</para>
  <para style="q" vid="HOS 8:13">penui heteih pwa ratak teila nah cide tyei lula,</para>
  <para style="q" vid="HOS 8:13">dede, Ih RAMPAUBE cidungde luulak.</para>
  <para style="q" vid="HOS 8:13">Ih penui maudung cu mning luzie</para>
  <para style="q" vid="HOS 8:13">nah penui mau ziemne saja peu zie.</para>
  <para style="q" vid="HOS 8:13">Ih penuide Egypt gage lang caili gai dizie.<verse eid="HOS 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 8:14" />Israel acu nsungta dida, pecu Teikegaibe de,</para>
  <para style="q" vid="HOS 8:14">nah hegwangkidung tei luda.</para>
  <para style="q" vid="HOS 8:14">Judah au kengkieng namdidung kekiee ge kwa luda,</para>
  <para style="q" vid="HOS 8:14">dede Ih au pe namdidung gage mi langgai zie;</para>
  <para style="q" vid="HOS 8:14">cide pe reneidung ngkap dizie.<verse eid="HOS 8:14" /></para>
  <chapter eid="HOS 8" />
  <chapter number="9" style="c" sid="HOS 9" />
  <para style="s">Israel ziemne Saja</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 9:1" />N suiyi so, Israel,</para>
  <para style="q" vid="HOS 9:1">heleuh kedame suiyi kelanzwa.</para>
  <para style="q" vid="HOS 9:1">Nang n Tinggwang de pütdi eh</para>
  <para style="q" vid="HOS 9:1">peda masang luta kedine.</para>
  <para style="q" vid="HOS 9:1">Hecaipung pelane gade</para>
  <para style="q" vid="HOS 9:1">helipui ge ziehi peu kera nang n suiyi la.<verse eid="HOS 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 9:2" />Dede hecaipung nah zauniakbam au penui pok tei gailak;</para>
  <para style="q" vid="HOS 9:2">zauci tei kera kubetsi gah dizie.<verse eid="HOS 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 9:3" />Penui RAMPAUBE deu ga lunghsi lakta;</para>
  <para style="q" vid="HOS 9:3">meliene, Ephraim Egypt ga cailimie zie,</para>
  <para style="q" vid="HOS 9:3">nah tingnaige Assyria gade penui ketyeipok kehera tyei zie.<verse eid="HOS 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 9:4" />Penui RAMPAUBE dage zau recadung teibeu silak,</para>
  <para style="q" vid="HOS 9:4">mede cidungde pe suiyi tei gailak.</para>
  <para style="q" vid="HOS 9:4">Penui recadung au penui dade hapkelame taktyei ge nzwa dizie:</para>
  <para style="q" vid="HOS 9:4">cide ketyeime leune hera dizie.</para>
  <para style="q" vid="HOS 9:4">Penui taktyei cide penui ziemne rünne dizie;</para>
  <para style="q" vid="HOS 9:4">cide RAMPAUBE ki ga lütlak.<verse eid="HOS 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 9:5" />Nnui hengyi tingba riet kenzeu benai,</para>
  <para style="q" vid="HOS 9:5">RAMPAUBE hengyi tingba ziemne daipai teilai no?<verse eid="HOS 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 9:6" />Kedanemene, pielo, penui kengkap de mbai lucai,</para>
  <para style="q" vid="HOS 9:6">Egypt penuide pa hekwa luzie,</para>
  <para style="q" vid="HOS 9:6">nah Memphis<note caller="+" style="f"><char style="fr" closed="false">9:6 </char><char style="ft" closed="false">Memphis au Egypt kehegwabe tingtun lebie namdi sumbe.</char></note> penuide kung dizie.</para>
  <para style="q" vid="HOS 9:6">Penui rangkanggeu mabamdung ziemne cai,</para>
  <para style="q" vid="HOS 9:6">hetuhwadung ne cidungde gum luzie,</para>
  <para style="q" vid="HOS 9:6">nah hetudung ne penui paikidung pui dizie.<verse eid="HOS 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 9:7" />Saja peu kera tingbazie gwangzeu;</para>
  <para style="q" vid="HOS 9:7">ziehi kepeu tingbaziedung gwang lada.</para>
  <para style="q" vid="HOS 9:7">Israel pelane depeu ma aidung cilu.</para>
  <para style="q" vid="HOS 9:7">Caihakecibe au kemie kau ge,</para>
  <para style="q" vid="HOS 9:7">nah helung tei kebeube au mie dida,</para>
  <para style="q" vid="HOS 9:7">nnui mausüt eh</para>
  <para style="q" vid="HOS 9:7">zaisiet bamsüt kedine.<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="LUK 21:22">Luk. 21:22</ref></char></note><verse eid="HOS 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 9:8" />Caihakecibe au a Tinggwang ziemne Ephraim reu kekwabe da.</para>
  <para style="q" vid="HOS 9:8">Dede pe lampui leunedung ga nruine tak ge lakap,</para>
  <para style="q" vid="HOS 9:8">nah pecu kerenia kecu au pe Tinggwang ki ga bam.<verse eid="HOS 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 9:9" />Penuikatei penuide tei msiasüt pwala dida</para>
  <para style="q" vid="HOS 9:9">Gibeah tingdau nzwa.</para>
  <para style="q" vid="HOS 9:9">Tinggwang penui maudung nsung luzie,</para>
  <para style="q" vid="HOS 9:9">nah pa penui maudung ziemne saja peuzie.<verse eid="HOS 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 9:10" />RAMPAUBE rangla, “Ih Israel de ngau luge, cide au hetaideu ga kubetsi ngaukelu nzwa lie.</para>
  <para style="q" vid="HOS 9:10">Peting dau tangzüttsi bang ga petsi raitube nzwa. Ih nnui paumedung de ngaulu.</para>
  <para style="q" vid="HOS 9:10">Dede penui Baal Peor Deutu da miedi,</para>
  <para style="q" vid="HOS 9:10">nah penui hengam ketei mamie cide de recadi.</para>
  <para style="q" vid="HOS 9:10">Penui au penui hungkela mamie nzwa kemneu teidi.<verse eid="HOS 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 9:11" />Ephraim ziemne au, penui kendu au nruine ge nzwa limtet dizie.</para>
  <para style="q" vid="HOS 9:11">Cika hena kemna, tetlak kecu, nah pena pung kecu bam silak.<verse eid="HOS 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 9:12" />Penui hename de ngkwet ncuhlu liede,</para>
  <para style="q" vid="HOS 9:12">Ih penuide keutet dizie iciu eh migede de bang beulak.</para>
  <para style="q" vid="HOS 9:12">Penui keherei zie Ih penui dade nreutet kedi benai!<verse eid="HOS 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 9:13" />Ih Ephraim de ngauda, Tyre kesiak ge, duikung ga ling nzeu eh,</para>
  <para style="q" vid="HOS 9:13">Dede Ephraim pe name de dapstetdi kera mi kedame dage teumpet beu dizie.”<verse eid="HOS 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 9:14" />Penuide peulo, RAMPAUBO, nang penuide daipai peuzie no?</para>
  <para style="q" vid="HOS 9:14">Penuide hena keidi kela henabam nah hetung pedui peugai kelak peulo.<verse eid="HOS 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 9:15" />“Gilgal namdi ga penui kenlien pelane ziemne,</para>
  <para style="q" vid="HOS 9:15">cikade Ih penuide ngkau cuhdi.</para>
  <para style="q" vid="HOS 9:15">Penui kemau tadung ziemne,</para>
  <para style="q" vid="HOS 9:15">Ih penuide a ki gade gwampet dizie.</para>
  <para style="q" vid="HOS 9:15">Ih penuide hung si lakta;</para>
  <para style="q" vid="HOS 9:15">penui reu kedime pelane au kebwak kelame.<verse eid="HOS 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HOS 9:16" />Ephraim mateei dida,</para>
  <para style="q" vid="HOS 9:16">nah penui mah au cangh dida;</para>
  <para style="q" vid="HOS 9:16">cidung petsi kei meda.</para>
  <para style="q" vid="HOS 9:16">Penui hename bam liede,</para>
  <para style="q" vid="HOS 9:16">Ih penui hungkela nadungde ketsai gage kai dizie.”<verse eid="HOS 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HOS 9:17" />A Tinggwang penuide mlai dizie</para>
  <para style="q" vid="HOS 9:17">penui pe samzai tei kemakne.</para>
  <para style="q" vid="HOS 9:17">Penui au heleuhdung kakga rwahui kelame dizie.<verse eid="HOS 9:17" /></para>
  <chapter eid="HOS 9" />
  <chapter number="10" style="c" sid="HOS 10" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 10:1" />Israel au kubebang hing eh petsi bui kebam ge.</para>
  <para style="q" vid="HOS 10:1">Petsi kiee dige,</para>
  <para style="q" vid="HOS 10:1">pa recabam tei kieeki lu.</para>
  <para style="q" vid="HOS 10:1">Pedeu hingpet luge,</para>
  <para style="q" vid="HOS 10:1">pa pe tsiadung teihemi lu.<verse eid="HOS 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 10:2" />Penui mlung au mide kecwa;</para>
  <para style="q" vid="HOS 10:2">cu au penui penui mau pung maisia da.</para>
  <para style="q" vid="HOS 10:2">RAMPAUBE penui recabam teipang dizie;</para>
  <para style="q" vid="HOS 10:2">pa penui tsiadung ngkap dizie.<verse eid="HOS 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 10:3" />Pecai penui rangzie,</para>
  <para style="q" vid="HOS 10:3">“Anui gwangpei gah,</para>
  <para style="q" vid="HOS 10:3">anui RAMPAUBE mie hing kemakne,</para>
  <para style="q" vid="HOS 10:3">nah hegwangpei ge, pa anui ziemne daipai tei lulai?”<verse eid="HOS 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 10:4" />Penui sam kemtabe rangla</para>
  <para style="q" vid="HOS 10:4">nah kemretbe reset samkakkelu teila.</para>
  <para style="q" vid="HOS 10:4">Cine kenzeube luh ge ga</para>
  <para style="q" vid="HOS 10:4">heiring heidung nzwa nzanghang.<verse eid="HOS 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 10:5" />Samaria ga kelunghme ngngi dizie</para>
  <para style="q" vid="HOS 10:5">Beth Aven ketumnadung ziemne.</para>
  <para style="q" vid="HOS 10:5">Cika pe minadung cidung reu hapla,</para>
  <para style="q" vid="HOS 10:5">mamie kereca cingkume cidungde</para>
  <para style="q" vid="HOS 10:5">kendu ziemne hap kela nzwa,</para>
  <para style="q" vid="HOS 10:5">dede cidungde cika bamsi meda.<verse eid="HOS 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 10:6" />Assyria gage mamie cide pungmie kaidi zie</para>
  <para style="q" vid="HOS 10:6">hegwangpei de mtamapeu ge eh peu kerane.</para>
  <para style="q" vid="HOS 10:6">Ephraim hengam teizie,</para>
  <para style="q" vid="HOS 10:6">nah Israel au pegu mamiedung ziemne ngngam dizie.<verse eid="HOS 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 10:7" />Samaria gwangpei de</para>
  <para style="q" vid="HOS 10:7">ngkap dizie,</para>
  <para style="q" vid="HOS 10:7">dui reuga tsingpeukang ge nzwa.<verse eid="HOS 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 10:8" />Kelien nlumkemakme reca nidung de ngkapdi zie.</para>
  <para style="q" vid="HOS 10:8">Aide Israel mau!</para>
  <para style="q" vid="HOS 10:8">Hetu nah hetubangdung penui recabam reuga lungh dizie.</para>
  <para style="q" vid="HOS 10:8">Minadung lamlwadung dage rangzie, “Anuide gumlu!”</para>
  <para style="q" vid="HOS 10:8">nah kideutudung dage, “Anui reuga meumie lu!”<verse eid="HOS 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 10:9" />“Israel,</para>
  <para style="q" vid="HOS 10:9">nang Gibeah tingdau gade kemau teila dida;</para>
  <para style="q" vid="HOS 10:9">cika kemau rünne le puih bam dida.</para>
  <para style="q" vid="HOS 10:9">Gibeah ga maula kedi nadung de hereu gwang zupwadi lakni?<verse eid="HOS 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 10:10" />Ih neu kedidau, Ih penuide ledeu zie.</para>
  <para style="q" vid="HOS 10:10">Heleuhdung ngkwalwe penuide regi zie</para>
  <para style="q" vid="HOS 10:10">nah penui teimau kedi kena kieege penuide saja peuzie.<verse eid="HOS 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 10:11" />Ephraim au ciu neu neukela ledeukelu tumleina ge,</para>
  <para style="q" vid="HOS 10:11">Cine Ih ngwanggai ge pe ngwang gage cwagai beuzie.</para>
  <para style="q" vid="HOS 10:11">Ih Ephraim reu gage ngwanggai ge kai beuzie;</para>
  <para style="q" vid="HOS 10:11">Judah hangdeu puu zie;</para>
  <para style="q" vid="HOS 10:11">Jacob pekatei hepei nia zie.<verse eid="HOS 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 10:12" />Makesang de nkatei mruk gailu,</para>
  <para style="q" vid="HOS 10:12">nah samkakkelu kesamsang de rum lulo.</para>
  <para style="q" vid="HOS 10:12">Hangdeu ta kemakde puu gailu,</para>
  <para style="q" vid="HOS 10:12">kedanemene RAMPAUBE de pei kera tingdi delu,</para>
  <para style="q" vid="HOS 10:12">pa gwang eh nnui reu gage makesang ruigai beu kemaktane.<note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="JER 4:3">Jer. 4:3</ref></char></note><verse eid="HOS 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 10:13" />Nnui kenlien puu luda;</para>
  <para style="q" vid="HOS 10:13">nnui nzeukemak rum luda.</para>
  <para style="q" vid="HOS 10:13">Nnui mide kecwa tsi tyei luda</para>
  <para style="q" vid="HOS 10:13">nnui mariem de nah</para>
  <para style="q" vid="HOS 10:13">nnui reugwame kekiee ge kabamde ga nlum kedine.<verse eid="HOS 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 10:14" />Cine hereu kehebwak ge nnui leuhme kakga cuh dizie,</para>
  <para style="q" vid="HOS 10:14">nah nnui riekelu namdidung pelane ngkapdi zie.</para>
  <para style="q" vid="HOS 10:14">Cide reugwa benai Beth Arbel de hegwangpei Shalman ne ngkapkedi nzwa dizie,</para>
  <para style="q" vid="HOS 10:14">mipuidungde de penui name si eh kedeumci kedi nzwa.<verse eid="HOS 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 10:15" />Cine aide nnui dage teigai dizie, Bethel,</para>
  <para style="q" vid="HOS 10:15">nnui kenlien disüt kedine.</para>
  <para style="q" vid="HOS 10:15">Tingba lütde Israel gwangpei de dangtüt mci dizie.”<verse eid="HOS 10:15" /></para>
  <chapter eid="HOS 10" />
  <chapter number="11" style="c" sid="HOS 11" />
  <para style="s">Tinggwang Israel de keku</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 11:1" />RAMPAUBE ranggai, “Israel hena dau Ih pecu hung gwang,</para>
  <para style="q" vid="HOS 11:1">nah Ih a napei de Egypt gade qu mpet lu.<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="MAT 2:15">Mat. 2:15</ref></char></note><verse eid="HOS 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 11:2" />Penuide qu reuge,</para>
  <para style="q" vid="HOS 11:2">penui a dade ndei tet di.</para>
  <para style="q" vid="HOS 11:2">Penui Baaldung dage ratak teigai</para>
  <para style="q" vid="HOS 11:2">nah mamiedung dage kehengui rugai.<verse eid="HOS 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 11:3" />Dede Ih ne Ephraim de tetlu kera ledeu beu.</para>
  <para style="q" vid="HOS 11:3">Ih ne penui ba teucuh lu</para>
  <para style="q" vid="HOS 11:3">dede Ih penui mapie kela penui ci lama.<verse eid="HOS 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 11:4" />Ih mina ria teu eh penui puisau tei,</para>
  <para style="q" vid="HOS 11:4">Kehung riadung teu eh.</para>
  <para style="q" vid="HOS 11:4">Ih au penui dade penui geijara ga penui ngwanggai tei relui beu kelabe nzwa,</para>
  <para style="q" vid="HOS 11:4">nah Ih kwaktungmie penui pok tei.<verse eid="HOS 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 11:5" />Penui Egypt deu ga cailigwang lakni?</para>
  <para style="q" vid="HOS 11:5">Assyria penui reu hegwang tei lakni</para>
  <para style="q" vid="HOS 11:5">penui ada cailigwang rau kedine?<verse eid="HOS 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 11:6" />Kiengtie penui namdidung reuga cakmie zie</para>
  <para style="q" vid="HOS 11:6">nah penui herieki tsiadung de teimsia dizie;</para>
  <para style="q" vid="HOS 11:6">delwe penuide ngkap dizie</para>
  <para style="q" vid="HOS 11:6">penui katei penui ciem ziemne.<verse eid="HOS 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 11:7" />A minadung a dade nreu di kera mninglu.</para>
  <para style="q" vid="HOS 11:7">Penui Hutube de qugai liede,</para>
  <para style="q" vid="HOS 11:7">migede penuide ngha lak.<verse eid="HOS 11:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 11:8" />Ih dainzwa ncu püt lulai, Ephraim?</para>
  <para style="q" vid="HOS 11:8">Ih dainzwa ncu mide pwapeu di lulai, Israel?</para>
  <para style="q" vid="HOS 11:8">Ih dainzwa ncu Admah nam nzwa teilu lai?</para>
  <para style="q" vid="HOS 11:8">Ih dainzwa ncu Zeboyim de nzwa tei lulai?</para>
  <para style="q" vid="HOS 11:8">A lung ga a mlung pelane de kenwakcu gaida.<verse eid="HOS 11:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 11:9" />Ih a rata kecude teu matei lak;</para>
  <para style="q" vid="HOS 11:9">Ih Ephraim de ngkap dailak da.</para>
  <para style="q" vid="HOS 11:9">Ih au Tinggwang kecune</para>
  <para style="q" vid="HOS 11:9">nah mina melu.</para>
  <para style="q" vid="HOS 11:9">Ih nnui kakga Kemcibe,</para>
  <para style="q" vid="HOS 11:9">nah Ih a lunghop gade gwang lak.<verse eid="HOS 11:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 11:10" />Penui RAMPAUBE caisui zie;</para>
  <para style="q" vid="HOS 11:10">nah hingho ge nzwa mra gaizie.</para>
  <para style="q" vid="HOS 11:10">Pa mra gaide,</para>
  <para style="q" vid="HOS 11:10">pe namedung mbeu eh naimiak kenlütle de gwang zie.<verse eid="HOS 11:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 11:11" />Penui mbeu eh nruine ge nzwa Egypt gade gwang zie,</para>
  <para style="q" vid="HOS 11:11">tamhau ge nzwa eh Assyria deu gade gwang zie.</para>
  <para style="q" vid="HOS 11:11">Ih penuide peu penui kidung ga lung zie, aide RAMPAUBE ndu kegai deda.<verse eid="HOS 11:11" /></para>
  <para style="s">Israel Mau</para>
  <para style="p">
    <verse number="12" style="v" sid="HOS 11:12" />Ephraim ne kenretle,</para>
  <para style="q" vid="HOS 11:12">nah Israel kelak de kecwa teu acu twagwalu.</para>
  <para style="q" vid="HOS 11:12">Dede Judah au Tinggwang samzai teila,</para>
  <para style="q" vid="HOS 11:12">nah pa au Ih, Kemcibe dade masangla.”<verse eid="HOS 11:12" /></para>
  <chapter eid="HOS 11" />
  <chapter number="12" style="c" sid="HOS 12" />
  <para style="q">
    <verse number="1" style="v" sid="HOS 12:1" />Ephraim au tingkai tyei eh lunghla</para>
  <para style="q" vid="HOS 12:1">nah naimiak kepetle tingkai caisui la.</para>
  <para style="q" vid="HOS 12:1">Pa au kenret nah zaisiet teingkiee jüja bamla.</para>
  <para style="q" vid="HOS 12:1">Penui Assyria de ngngwa samkakkelu ge teilu</para>
  <para style="q" vid="HOS 12:1">nah olive ca Egypt gage pung gaila.<verse eid="HOS 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 12:2" />RAMPAUBE au Judah de de hetutu kera ge la</para>
  <para style="q" vid="HOS 12:2">nah Jacob tei kegaide ziemne saja peu laibam;</para>
  <para style="q" vid="HOS 12:2">pa batadung ziemne saja peu zie.<verse eid="HOS 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 12:3" />Jacob henabam gade pe sinabe pideu heraklu,</para>
  <para style="q" vid="HOS 12:3">nah pa ngkieng cuh luge Tinggwang de renia.<verse eid="HOS 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 12:4" />Pa tinggimgwabe de renia eh ngkienglu.</para>
  <para style="q" vid="HOS 12:4">Pa hap nah pe nggia kiedi.</para>
  <para style="q" vid="HOS 12:4">Pa Tinggwang de Bethel gade redau lu;</para>
  <para style="q" vid="HOS 12:4">cikade Tinggwang pecu mpau.<verse eid="HOS 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 12:5" />Aide reugwame reu RAMPAUBE;</para>
  <para style="q" vid="HOS 12:5">pe zi “RAMPAUBE” de qu eh lazie.<verse eid="HOS 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 12:6" />Cine n Tinggwang da cailigwang lu.</para>
  <para style="q" vid="HOS 12:6">Kesamkkak kelu kesamsang de nah kemzuibe de kaizeu lu,</para>
  <para style="q" vid="HOS 12:6">nah n Tinggwang de kwa jüja lalu.<verse eid="HOS 12:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 12:7" />Heliketeime penui badung ga kenret riangteukwak bam,</para>
  <para style="q" vid="HOS 12:7">penui mide cwa neula.<verse eid="HOS 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 12:8" />Ephraim rangdi, “Ih mahei süt lu kesangda;</para>
  <para style="q" vid="HOS 12:8">Ih a ziemne mahei pei luda.</para>
  <para style="q" vid="HOS 12:8">A bata leune ga penui a mau gede ngau gailak,</para>
  <para style="q" vid="HOS 12:8">kemau keheibe liede.”<note caller="-" style="x"><char style="xo" closed="false">12:8 </char><char style="xt" closed="false"><ref loc="REV 3:17">Keu. 3:17</ref></char></note><verse eid="HOS 12:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 12:9" />“Ih nnui Tinggwang RAMPAUBE Egypt deu gade nnuide ngngwa mpet kebeube,</para>
  <para style="q" vid="HOS 12:9">Ih nnuide peu paikidung ga lungh daizie,</para>
  <para style="q" vid="HOS 12:9">hengyi riempwa kebam tingbadung dau nzwa.<verse eid="HOS 12:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 12:10" />Ih caihakecime dage mpaugai,</para>
  <para style="q" vid="HOS 12:10">nah Ih penuide nnui ziemne marengei kekie ge peu gai.</para>
  <para style="q" vid="HOS 12:10">Caihakecime ba gade Ih samgwadung peu gai.”<verse eid="HOS 12:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 12:11" />Gilead ga kenlienta la liecai,</para>
  <para style="q" vid="HOS 12:11">minadung au pemi gah kesang da.</para>
  <para style="q" vid="HOS 12:11">Gilgal ga penui hetumseudung ratak teigai;</para>
  <para style="q" vid="HOS 12:11">penui recabamdung au renaam ga hetaluh puh lwe tangtsukangdung kebau kenzeu nzwa zie.<note caller="+" style="f"><char style="fr" closed="false">12:11 </char><char style="ft" closed="false">Gilead namceu aide Jordan Reuki kepetle bie deukui ga bam. Hosea ting dau heja teikelwa nah zaisiet le kebam ci. </char></note><verse eid="HOS 12:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 12:12" />Jacob au Aram deu gage pak gaidi;</para>
  <para style="q" vid="HOS 12:12">Israel henau ge pei lu kerane meurün haudung kwa.<verse eid="HOS 12:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 12:13" />RAMPAUBE caihakecibe dade Israel de Egypt gade ngngwa mpetlu,</para>
  <para style="q" vid="HOS 12:13">delwe caihakecibe ne penui mapielu.<verse eid="HOS 12:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 12:14" />Ephraim RAMPAUBE rata teisüt dida.</para>
  <para style="q" vid="HOS 12:14">Cine pe Rampaube pe reu gage pe jai teilwa gaizie</para>
  <para style="q" vid="HOS 12:14">nah pe ngam de pe reu gage kai caili beuzie.<verse eid="HOS 12:14" /></para>
  <chapter eid="HOS 12" />
  <chapter number="13" style="c" sid="HOS 13" />
  <para style="s">Israel da RAMPAUBE rata</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 13:1" />“Ndaa Ephraim marang kegai dau, mina mbeu dila.</para>
  <para style="q" vid="HOS 13:1">Pa Israel ga pecu teimdi lu,</para>
  <para style="q" vid="HOS 13:1">dede pa Baal mie recakedi ziemne maudi, nah pa tsaidi.<verse eid="HOS 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 13:2" />Cu penui kemau tei reureu di.</para>
  <para style="q" vid="HOS 13:2">Penui rangkanggeule hegeumiedung teilu,</para>
  <para style="q" vid="HOS 13:2">mamiedung teihemi lu kebuita tei eh,</para>
  <para style="q" vid="HOS 13:2">cidung pelane heciemta keteime ne tei.</para>
  <para style="q" vid="HOS 13:2">Minadung penui ha rang,</para>
  <para style="q" vid="HOS 13:2">‘Mina ratak teibeu kela aidungde hetumnadung de kemam la.’<verse eid="HOS 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 13:3" />Cine penui au tingcang mwadung nzwa zie,</para>
  <para style="q" vid="HOS 13:3">hezin gah nzetdi kelabe nzwa,</para>
  <para style="q" vid="HOS 13:3">tsiurie hecaipung ge gade tingkai ne guipung di kelabe nzwa,</para>
  <para style="q" vid="HOS 13:3">nah mika minrwangki gade mpetdi kelabe nzwa.<verse eid="HOS 13:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 13:4" />Dede Ih RAMPAUBE Tinggwang nnuide Egypt deu gade ngngwa mpet kebeube.</para>
  <para style="q" vid="HOS 13:4">Nnui acu gwale hera keda ha ranglak;</para>
  <para style="q" vid="HOS 13:4">nnui Ih gwale, kelikelube keda gah lie eh rang zie.<verse eid="HOS 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 13:5" />Ih nnuide hetaideu gade ci luda,</para>
  <para style="q" vid="HOS 13:5">canghking kela deu gade.<verse eid="HOS 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 13:6" />Nnui ceheiziu bam ge, nnui pui lula;</para>
  <para style="q" vid="HOS 13:6">nah nnui nggei luge, nnui ngang dila.</para>
  <para style="q" vid="HOS 13:6">Cide ziemne nnui acu nsungta dila.<verse eid="HOS 13:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 13:7" />Ih penui dade hingho nzwa dizie;</para>
  <para style="q" vid="HOS 13:7">kaudauna nzwa Ih lampui kwa zie.<verse eid="HOS 13:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 13:8" />Ih hegumpui pe namedung de süt teu kedibe nzwa penuide ketang zie.</para>
  <para style="q" vid="HOS 13:8">Ih penui hekarak rui dizie,</para>
  <para style="q" vid="HOS 13:8">nah cikade Ih penuide hingho ge nzwa tuityei luzie,</para>
  <para style="q" vid="HOS 13:8">teikuu ge nzwa penuide teurak kecai dizie.<verse eid="HOS 13:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 13:9" />Ih nnuide ngkap dizie, Israel;</para>
  <para style="q" vid="HOS 13:9">caune nnuide ngha lulai?<verse eid="HOS 13:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 13:10" />Cu au daiga nnui gwangpei lano,</para>
  <para style="q" vid="HOS 13:10">pa nnui namdidung pelane gade nnuide kelilu kera?</para>
  <para style="q" vid="HOS 13:10">Nnui a dage rang kegai, nnui reu kedimedung daiga lano,</para>
  <para style="q" vid="HOS 13:10">‘Acu hegwangpei nah hegwangnadung peulo’?<verse eid="HOS 13:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 13:11" />Ih a rata gade nnuide hegwang ge peu,</para>
  <para style="q" vid="HOS 13:11">nah Ih a lunghop gade pecu keu gidi.<verse eid="HOS 13:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 13:12" />Ephraim mau kekwapwa bam dida,</para>
  <para style="q" vid="HOS 13:12">pe maudung de kekwa cuh luda.<verse eid="HOS 13:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 13:13" />Hena kemna tedteei de pe da gwang zie,</para>
  <para style="q" vid="HOS 13:13">dede pa au maci kemak nage,</para>
  <para style="q" vid="HOS 13:13">kedanemene pecu kemna ting dige, pa henabam gade mpetme kecune.<verse eid="HOS 13:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 13:14" />Ih penuide Sheol<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="fq" closed="false">Sheol </char><char style="ft" closed="false">Ketsaime deu</char></note> ba gade keliu zieni?</para>
  <para style="q" vid="HOS 13:14">Ketsai gade Ih penuide kelilu zieni?</para>
  <para style="q" vid="HOS 13:14">Ketsai, daiga n rapiadung lano?</para>
  <para style="q" vid="HOS 13:14">Sheol, daiga n kengkap lano?</para>
  <para style="q" vid="HOS 13:14">Ngaukenggia au a miak gade kebai dida.”<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false">1 Kor. 15:55, Keu. 6:8</char></note><verse eid="HOS 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 13:15" />Ephraim au pe sinamedung kakde lungh hing liede,</para>
  <para style="q" vid="HOS 13:15">naimiak kepetle tingkai gwang zie;</para>
  <para style="q" vid="HOS 13:15">RAMPAUBE tingkai de au hetaideu gade guilwet zie.</para>
  <para style="q" vid="HOS 13:15">Ephraim duilet cangh dizie,</para>
  <para style="q" vid="HOS 13:15">nah pe tekwa ga dui bamlak.</para>
  <para style="q" vid="HOS 13:15">Pe ngauraube pe maniaki gade pemi kehungbe leune ngkap dizie.<verse eid="HOS 13:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HOS 13:16" />Samaria mau dizie,</para>
  <para style="q" vid="HOS 13:16">pa pe Tinggwang de mlai kedine.</para>
  <para style="q" vid="HOS 13:16">Penui kiengtie gade kau dizie;</para>
  <para style="q" vid="HOS 13:16">penui namedung de kedeu kecai dizie,</para>
  <para style="q" vid="HOS 13:16">nah penui tetlak kela puidung de reupop dizie.<verse eid="HOS 13:16" /></para>
  <chapter eid="HOS 13" />
  <chapter number="14" style="c" sid="HOS 14" />
  <para style="s">Samlam teu gwanglu kerane Helung kenreu</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 14:1" />Israel, nnui Tinggwang RAMPAUBE da cailigwang lulo,</para>
  <para style="q" vid="HOS 14:1">nnui mau ziemne nnui kaudi kecune.<verse eid="HOS 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 14:2" />RAMPAUBE da cailigwanglu delwe kielu.</para>
  <para style="q" vid="HOS 14:2">Pedage ranglu, “Anui mau pelane keugi dilo nah keyibe leu luu lulo,</para>
  <para style="q" vid="HOS 14:2">iciude anui muileu ga ketwa pwa ncu reca beulu kerane.<note caller="-" style="x"><char style="xo" closed="false">14:2 </char><char style="xt" closed="false"><ref loc="HEB 13:15">Heb. 13:15</ref></char></note><verse eid="HOS 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 14:3" />Assyria anuide kelilu gailak;</para>
  <para style="q" vid="HOS 14:3">anui hekwenpung lwe hereu ga mielak.</para>
  <para style="q" vid="HOS 14:3">Mede anui anui ba le teikelu mamiedung de,</para>
  <para style="q" vid="HOS 14:3">‘Nnui au anui rabe,’</para>
  <para style="q" vid="HOS 14:3">pe pei kegahme n dade ngaugia ngau lula,” de rang silak,<verse eid="HOS 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 14:4" />“RAMPAUBE ranggai, Ih penui nreutet kedide teingkei beuzie;</para>
  <para style="q" vid="HOS 14:4">Ih penuide hung süt zie,</para>
  <para style="q" vid="HOS 14:4">penui dade a rata nreu tet kedine.<verse eid="HOS 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 14:5" />Ih Israel dade hezin ge nzwa zie;</para>
  <para style="q" vid="HOS 14:5">pa teizuine pa nzwa pa zie</para>
  <para style="q" vid="HOS 14:5">nah Lebanon ga cedar nzwa pe mah him luzie.<verse eid="HOS 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 14:6" />Pe kiakdung nzangpet zie;</para>
  <para style="q" vid="HOS 14:6">pe zuyi au olive bangdung nzwa zie,</para>
  <para style="q" vid="HOS 14:6">nah pe riemkeyi au Lebanon ga cedar bangdung nzwa zie.<verse eid="HOS 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 14:7" />Mina pe miekang ga kelunghme cailigwang zie;</para>
  <para style="q" vid="HOS 14:7">penui hereibang nzwa pa zie</para>
  <para style="q" vid="HOS 14:7">nah kubebang nzwa pa zie.</para>
  <para style="q" vid="HOS 14:7">Pe nsa keyi au Lebanon zau nzwa zie.<verse eid="HOS 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 14:8" />Ephraim, Ih mamiedung teu daitei si laino?</para>
  <para style="q" vid="HOS 14:8">Ih pe sam keli zie nah pe mapie luzie.</para>
  <para style="q" vid="HOS 14:8">Ih au Cypress pe neidung ndiak bam mui kelabe nzwa;</para>
  <para style="q" vid="HOS 14:8">a dade n tsi gwangla.”<verse eid="HOS 14:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 14:9" />Cau maci bam no pa ma cidungde cilu kera?</para>
  <para style="q" vid="HOS 14:9">Cau aidungde ci no iciu eh pa cidung cilu kerane?</para>
  <para style="q" vid="HOS 14:9">RAMPAUBE lampuidung au mzui lie,</para>
  <para style="q" vid="HOS 14:9">nah masang kelame cidungde ga tet ziee,</para>
  <para style="q" vid="HOS 14:9">dede malai kelame cidungde ga mrap eh kau dizie.<verse eid="HOS 14:9" /></para>
  <chapter eid="HOS 14" />
</usx>