<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">- Zeme(N) Bible Project</book>
  <para style="toc3">Zep.</para>
  <para style="toc2">Zephaniah</para>
  <para style="toc1">Zephaniah Laisiukwak</para>
  <para style="mt">Zephaniah</para>
  <para style="mt">Zephaniah Laisiukwak</para>
  <para style="is">Mraisam</para>
  <para style="ip">Zephaniah bata ketei Josiah (640-609 BC) hegwang tingdau. Pa Rampaube tingba au Judah penai Jerusalem reuga tutiak teugwang beu kera mrai ranggai nah pa Jewme de Tinggwang da cailigwang lulo qugai.</para>
  <para style="ip">Zephaniah au pecaide Judah kidamedung dede ngkap dizie lie mrai ranggai. Keregui sam ge rang eh, Tinggwang au pe minadung de kilung ngngwa gwang beuzie lie sampet gai.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Tinggwang Tutiak recikegai (1:1-2:3)</para>
  <para style="io1">Heleuhdung Tutiak (2:4-15)</para>
  <para style="io1">Jerusalem Caiha (3:1-20)</para>
  <chapter number="1" style="c" sid="ZEP 1" />
  <para style="s">Gwangkela Kengkap Sam</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1" />Cushi napei Zephaniah Gedaliah napei Amariah napei Hezekiah napei, Judah gwangpei Amon napei Josiah tingdau RAMPAUBE sam aide gwang.<verse eid="ZEP 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEP 1:2" />“Kideu reu kebam maleune Ih tei ngkap dizie, RAMPAUBE ne aide ndu kegai.<verse eid="ZEP 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 1:3" />Ih mina nah makaune de ngkap dizie; Ih tinggim nruine nah jaaidi hekadung de ngkap dizie,</para>
  <para style="q" vid="ZEP 1:3">Ih kenlienme de tei ngkau dizie da.</para>
  <para style="q" vid="ZEP 1:3">Kedanemene Ih kideu peureu mina de ngkap zing dizie, RAMPAUBE ne aide ndu kegai. <note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="MAT 13:41">Mat. 13:41</ref></char></note><verse eid="ZEP 1:3" /></para>
  <para style="s">Judah de Kemmau</para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 1:4" />Ih Jerusalem ga minadung nah Judah ga saja peu zie.</para>
  <para style="q" vid="ZEP 1:4">Ih heni aide gade Baal bang kebamdung nah cingkume kakga mamie kerecame zidung keugi dizie.<verse eid="ZEP 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEP 1:5" />Kireu ga hang tingnaimiak, hekei, hegidung de reca kelame,</para>
  <para style="q" vid="ZEP 1:5">nah RAMPAUBE de reca nah sampet tei gai kelame dede pe hegwangpei dage de sampet tei kelame.<verse eid="ZEP 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEP 1:6" />Caugamme RAMPAUBE caisui tei kela gade nreu tet dibi, caugamme RAMPAUBE de peei la mebi mede pe puisau de peei la mebi cipaume de gi dizie.”<verse eid="ZEP 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEP 1:7" />RAMPAUBE dwaga mlei mene bam lu! Kedanemene RAMPAUBE tutiak tingba mna dida;</para>
  <para style="q" vid="ZEP 1:7">RAMPAUBE ratak de mtei luda nah pe qu kegaimedung de teu ncam luzie.<verse eid="ZEP 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEP 1:8" />“RAMPAUBE ratak ketei benai ma aidungde gwang zie,</para>
  <para style="q" vid="ZEP 1:8">Ih hegwangme napui nah pe hegwang napeimedung de saja peu zie, nah sangme niadung kekai pelane.<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">hera kedadung de reca kelame</char></note><verse eid="ZEP 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEP 1:9" />Cipau nai kimui ga nsau kebamme,</para>
  <para style="q" vid="ZEP 1:9">pe mpaube kiga kehebwak nah kecwa teugwang kegaime dage Ih keherei teugwang beuzie.<verse eid="ZEP 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEP 1:10" />Cine cipaunai de zie, RAMPAUBE ne aide ndu kegai,</para>
  <para style="q" vid="ZEP 1:10">ciu eh Jerusalem Heka Rieki ga kehap kwa gwang zie, deuzi pekenabe ga dekehap bam dizie,</para>
  <para style="q" vid="ZEP 1:10">nah kideutu gade kau kemie kwa cisüt kecu.<verse eid="ZEP 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEP 1:11" />Haplu deuzi helila bam ga kelungmedung,</para>
  <para style="q" vid="ZEP 1:11">kedanemene helila keteime leune kap dizie; rangkanggeu mdet eh zwa kela leu de ngkap dizie.<verse eid="ZEP 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 1:12" />Cipau tingdau</para>
  <para style="q" vid="ZEP 1:12">Ih Jerusalem ga mitaubung pwalu eh mipeimedung de teikeherei kerane penuide peei zie</para>
  <para style="q" vid="ZEP 1:12">caugamme zausak mie eh nah penui mlung gade ainzwa rang kebamme,</para>
  <para style="q" vid="ZEP 1:12">‘RAMPAUBE au magede anui reu gage tei gai lak, ma keyi ge mede kesia ge liede.’<verse eid="ZEP 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEP 1:13" />Penui maheidung süt teu dizie, nah penui kidung au sia di eh gi dizie!</para>
  <para style="q" vid="ZEP 1:13">Penui kidung tei lu ciu liede cidung ga lung luma, nah kube ling lu ciu liede penui zau sak luma.<verse eid="ZEP 1:13" /></para>
  <para style="s">Rampaube Tingba Kedide</para>
  <para style="q">
    <verse number="14" style="v" sid="ZEP 1:14" />RAMPAUBE gu tutiak tingba kedi de mna bam dida, mna nah mzet sütla!</para>
  <para style="q" vid="ZEP 1:14">RAMPAUBE tingba benai sah kegai kwa au kengking reugwame hap sah nrung kegai nzwa zie.<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="REV 6:17">Keu. 6:17</ref></char></note><verse eid="ZEP 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 1:15" />Cipaunai rata tingba ge zie,</para>
  <para style="q" vid="ZEP 1:15">keherei nah lungrei tingba ge, rahang nah kengkap tingba ge,</para>
  <para style="q" vid="ZEP 1:15">kemui nah suisiet tingba ge, hemwa nah muiting kecu tingba ge zie.<verse eid="ZEP 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEP 1:16" />Renia kwakelu namdi de renia eh</para>
  <para style="q" vid="ZEP 1:16">hereu telui kwadung nah tsukwa kehudung nah hereu reudi kepui tingba ge zie.<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">hereu telui kwadung</char></note><verse eid="ZEP 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEP 1:17" />Ih lungrei mina leune da teugwang beu zie, ciciu eh penui miakcietme ge nzwa dizie</para>
  <para style="q" vid="ZEP 1:17">penui RAMPAUBE dage kemau tei kedine.</para>
  <para style="q" vid="ZEP 1:17">Penui jaidung rebui nzwa lwa pet zie, nah penui lungniadung ne mateu ge nzwa dizie.<verse eid="ZEP 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ZEP 1:18" />Penui gu rangkanggeu mede kecakdung ne</para>
  <para style="q" vid="ZEP 1:18">RAMPAUBE rata kedi benai penuide keli gailak. Pe rata mi ne kideu pelane de ngkap dizie,</para>
  <para style="q" vid="ZEP 1:18">kedanemene pa penli teigai zie, kehing penli be kideu ga lungh kela leune dage kaizie.”<verse eid="ZEP 1:18" /></para>
  <chapter eid="ZEP 1" />
  <chapter number="2" style="c" sid="ZEP 2" />
  <para style="s">Philistia de Kemmau</para>
  <para style="q">
    <verse number="1" style="v" sid="ZEP 2:1" />Hengam kegah heleuhdung, nnuikatei nuide ngngwa ngkwalu nah ngkwa ncütlu,<verse eid="ZEP 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEP 2:2" />hezai de gwang di kemak dwa gage nah ciurie gah di kela nzwa,</para>
  <para style="q" vid="ZEP 2:2">RAMPAUBE rata nah lunghop nnui da gwang di kemak dwa gage, RAMPAUBE lunghop nnui da gwang di kemak dwa gage.<verse eid="ZEP 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 2:3" />RAMPAUBE de peeilu, kideu ga hena eh pe sam kai kebeu mzai kela mina leune!</para>
  <para style="q" vid="ZEP 2:3">Makesang be peeilu. Kehena de peeilu,</para>
  <para style="q" vid="ZEP 2:3">ciciu kelu gade RAMPAUBE pe rata kedi benai ncu gum luzie.<verse eid="ZEP 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 2:4" />Gaza namdi de au gi dizie, nah Ashkelon namdi au ngkap dizie.</para>
  <para style="q" vid="ZEP 2:4">Penui Ashdod namdi de tingna dau gwagi dizie, nah penui Ekron namdi de ngkap dizie!<verse eid="ZEP 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEP 2:5" />Co jaaidi kung ga kelunghme kau dida, Kerethite leuhmedung! RAMPAUBE nnui reu gage kemmau sam rang gai dida,</para>
  <para style="q" vid="ZEP 2:5">Canaan, Philistiame deu. Ih nnuide ngkap dizie migede bang zeu kemaktane.<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">Kerethitme au Philistiame kakga pautsa ge nah aika Philistiame heleuh mteina zi gade raugai pwabam.</char></note><verse eid="ZEP 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEP 2:6" />Cine jaaidi kung dung de meurün kekwame ziemne tsehei bam ge dizie nah meurün bam ge dizie.<verse eid="ZEP 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEP 2:7" />Duidikui cuikui de Judah kilungme bang kelume ne gum dizie,</para>
  <para style="q" vid="ZEP 2:7">aidungde ne cika penui kaunedung pie dizie. Penui minadung tingmui Ashkelon kiga zeu zie,</para>
  <para style="q" vid="ZEP 2:7">kedanemene RAMPAUBE penui Tinggwang penui de gum luzie nah penuide peu lunghyi dai luzie.<verse eid="ZEP 2:7" /></para>
  <para style="s">Moab nah Ammon de Kemmau</para>
  <para style="q">
    <verse number="8" style="v" sid="ZEP 2:8" />“Ih Moabme de ki nah Ammonme henui tei kebam kwa siu</para>
  <para style="q" vid="ZEP 2:8">penui a minadung de mneu nah penui deurai de hebwak kecudau.<verse eid="ZEP 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEP 2:9" />Ciziemne, Ih ring kebam nzwa, aide reugwame reu RAMPAUBE ne ndu gai, Israel Tinggwang,</para>
  <para style="q" vid="ZEP 2:9">Moab au Sodom nzwa dizie, nah Ammon mina dung Gomorrah nzwa dizie;</para>
  <para style="q" vid="ZEP 2:9">hetu bam ge nah mcai koiki ge dizie, madaude lungh gai kelak deu ge dizie.</para>
  <para style="q" vid="ZEP 2:9">Dede bang kelu a minadung penuide gwa dizie, nah bang kelu a minadung cide gum luzie.”<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">Sodom nah Gomorrah de Tinggwang ne pe mau ziemne volcano teucuh eh ngkapdi (Ken 19.23-29).</char></note><verse eid="ZEP 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEP 2:10" />Ainzwa eh Moab nah Ammonme da gwang zie penui zai kedi de ziemne, kedanemene penui reugwame reu RAMPAUBE de ki nah nuineu kela ziemne. <verse eid="ZEP 2:10" /><verse number="11" style="v" sid="ZEP 2:11" />Ciu eh penui RAMPAUBE de hing dizie, kedanemene pa kideu ga rabedung de tei nggah dizie. Mileune pecu reca zie, pekatei pe deu rip gade, jaaidi kung leune ga kelungh gade de.<verse eid="ZEP 2:11" /></para>
  <para style="s">Cush de Kemmau</para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 2:12" />Nnui Cushitme de de a gu kingtie lepwa kui dizie,<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">Pedum aide ga “Cushitme” de kecu Egyptme de rangbam lubui, kedanemene hegwang tei kegwang mmi ngkaiemengei ting de (B.C), Cushitme ne Egypt reu hegwang teigwang. Caiha aide rang kemakne mmi camrei dwa penui kengkieng cang di.</char></note><verse eid="ZEP 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEP 2:13" />nah Tinggwang tingpeule lungh kebamme de nah Assyria deudi de ngkap dizie,</para>
  <para style="q" vid="ZEP 2:13">ciu eh Nineveh namdi de gidi eh ngkap dizie nah hangdeu ketsai deu swa de kecang deu ge dizie.<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">Ndaa ha gade ci kelu, Medeme nah Babylonme ne 612 B.C. tingdau Nineveh de tuilu, cine Zephaniah pe caiha teicang kelu ngau cangbam lubui. Nahum laisiukwak gage Nineveh kau kedi ha siu keludau Assyria kengkieng kanggade keherei kelame penui sui yi kedi keulia kegai rau pwala. Namdi cide ngkapzing dedi iciu eh mbeu bam kela Greek mepei Xenophon 401 B.C. dau namdi cika kemie dau namdi cika magede kebam ngaulu tadi.</char></note><verse eid="ZEP 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ZEP 2:14" />Cide ga makaune bam ge tei dizie, heleuh be gu makaune pelane,</para>
  <para style="q" vid="ZEP 2:14">deucang deu nah makoiki ga kelungh biangkang dung hecia dung ga pebam tei zie.</para>
  <para style="q" vid="ZEP 2:14">Penui kenra kwa hebaki gade siu dizie; tet kenggwa ni ga tangtsudung pang dizie; hezu keyi cedar ciadung sia dizie.<verse eid="ZEP 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 2:15" />Aide hetwa kepung namdi mage de hing mene lungh bam,</para>
  <para style="q" vid="ZEP 2:15">de eh penui mlung ga cet la, “Acu migede ngngwa nsam lu kera gah.”</para>
  <para style="q" vid="ZEP 2:15">Cide kengngi keulia kebam ge, teikuudung kebam ni ge dizie.</para>
  <para style="q" vid="ZEP 2:15">Cide tet kah leune rata kwa sah eh kedeiga ba lia la.<verse eid="ZEP 2:15" /></para>
  <chapter eid="ZEP 2" />
  <chapter number="3" style="c" sid="ZEP 3" />
  <para style="s">Jerusalem Caiha</para>
  <para style="q">
    <verse number="1" style="v" sid="ZEP 3:1" />Jerusalem namdi ga kekap gwang zie! Kebwak kela namdi de tei msia dida.<verse eid="ZEP 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEP 3:2" />Pa Tinggwang rang kegai kwa kingnei ma, mede RAMPAUBE ledeu kegaide mnei ma.</para>
  <para style="q" vid="ZEP 3:2">Pa RAMPAUBE de nlum ma nah Tinggwang da gwang si dai lak ta.<verse eid="ZEP 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 3:3" />Kedime au hingho mra kelabe dung nzwa.</para>
  <para style="q" vid="ZEP 3:3">Pe tutiakmedung au heneudung tinghegi gage tyei ciaklu eh tingcang tyei kera gah dila.<verse eid="ZEP 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 3:4" />Caihakecimedung da samzai kegah nah heleuhbe de ngngwa kebwak la.</para>
  <para style="q" vid="ZEP 3:4">Cingkumedung kemcibe dung tei hera dila nah hezai gika kecu ta tei la.<verse eid="ZEP 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEP 3:5" />RAMPAUBE penui dwa de kemzuibe teila. Pa petabe teila.</para>
  <para style="q" vid="ZEP 3:5">Tingcang ramsangne pa kemzuibe pwa peu la! Cide keba gade kebai di lama, dede kesiamedung au hengam penui da gah.<verse eid="ZEP 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEP 3:6" />“Ih heleuhdung de ngkap dida, penui kengkieng reketbamdung de sia dida.</para>
  <para style="q" vid="ZEP 3:6">Penui gu puidikidung Ih tei msia dida, ciciu eh cide ga mide tet ngwa ta dizie.</para>
  <para style="q" vid="ZEP 3:6">Namdibe tei msia dida ciciu eh cide ga migede lungh dai gai lak.<verse eid="ZEP 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEP 3:7" />Ih ranggai, ‘Acu kehing de nnui da bam lu zie. Ledeu kegai de mzai zie</para>
  <para style="q" vid="ZEP 3:7">nah lungh kebam ki de nnui gi dilak ciu eh nnui dage tei gai zielie kebamdung keu hezia beu zie.’</para>
  <para style="q" vid="ZEP 3:7">Dede tingcang gade penui tah kesia teineu dila.<verse eid="ZEP 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEP 3:8" />Cine acu kwa bamlu, RAMPAUBE ne aide ndu kegai, Ih cuh eh kemau tei kelame de ngkap di kemaktane.</para>
  <para style="q" vid="ZEP 3:8">Heleuhdung de teu hekwalu kera Ih mtei lu da, hegwangramdung de teu hekwalu kera,</para>
  <para style="q" vid="ZEP 3:8">ciu eh penuide peu a rata cui pelane penui reu ga kailu kerane;</para>
  <para style="q" vid="ZEP 3:8">ciu eh heu kebam a lunghop de gage kideube de ngkap dizie.<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="REV 16:1">Keu. 16:1</ref></char></note><verse eid="ZEP 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEP 3:9" />Ciciu liede Ih mina samrangdung de tei mci beuzie,</para>
  <para style="q" vid="ZEP 3:9">ciu eh pelane ket tei eh RAMPAUBE zierang teilu kerane.<verse eid="ZEP 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEP 3:10" />Cush reuki gwale kelungh acu reca kelame, a mina lungh zangra kelame, a dage recadung teugwang gaizie.<verse eid="ZEP 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEP 3:11" />Cipaunai nnui tah gade acu renia kela leu de Ih hengam tei dilak,</para>
  <para style="q" vid="ZEP 3:11">cipau tingdau nnui kakga penuide mning mdi kelame de keugi dizie,</para>
  <para style="q" vid="ZEP 3:11">nah nnui au a gu kemci lamlwatu ga kemmau be tah teisi dailak.<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">Rennet ria gade ngang kelade samria a gu kemci lamlwatu gade liagai, cide Tinggwang kerecaki kebam deutu. Mina cipau bam gade ngang kebam de au Tinggwang de nneu kecu da.</char></note><verse eid="ZEP 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 3:12" />Dede hena kelame nah kegame de nnui kakgage kaigai zie,</para>
  <para style="q" vid="ZEP 3:12">nah penui RAMPAUBE zi gade kemsiu ngau luzie.<verse eid="ZEP 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEP 3:13" />Israel bang kelume kemmau tah tei silak mede kenretdung rang lak,</para>
  <para style="q" vid="ZEP 3:13">nah penui mui gade kecwa sam gede rang lak;</para>
  <para style="q" vid="ZEP 3:13">cine penui lungyi nah kwak luzie, nah migede penui da kengngi teugwang beu lak.”<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="REV 14:5">Keu. 14:5</ref></char></note><verse eid="ZEP 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ZEP 3:14" />Lei teilu, Zion napuidung! Sah gai lu, Israelmedung.</para>
  <para style="q" vid="ZEP 3:14">Renga lu nah nnui mlung pekie teu pecu twa lo, Jerusalem napuimedung.<verse eid="ZEP 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 3:15" />RAMPAUBE nnui dade saja de keu hezia dida; Pa nnui ngauraume de gwagi dida!</para>
  <para style="q" vid="ZEP 3:15">RAMPAUBE au nnui kakga Israel gwangpei. Nnui madau gede kesiabe de hing lak ta!<verse eid="ZEP 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEP 3:16" />Cipaunai penui Jerusalem dage rang zie,</para>
  <para style="q" vid="ZEP 3:16">“Ngngi so, Zion. Nnui ba bari bam diso.<verse eid="ZEP 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEP 3:17" />RAMPAUBE nnui Tinggwang au nnui kakga bam, Pe kengkieng ne nnuide keli beuzie.</para>
  <para style="q" vid="ZEP 3:17">Pa nnui ziemne Pesui yi luzie; pe keku ziemne nnui ziune bam luzie;</para>
  <para style="q" vid="ZEP 3:17">Pa nnui ziemne Pesui keyi kwa sah zie.<verse eid="ZEP 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ZEP 3:18" />Ih suisiet pung kelame, ketyei ngyi ga mie lu kemakme de qu hekwa luzie,</para>
  <para style="q" vid="ZEP 3:18">ciu eh nnui hengam ngau si dai lak.<verse eid="ZEP 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ZEP 3:19" />Ainie, nnuide tei keherei kelame de Ih renia zie.</para>
  <para style="q" vid="ZEP 3:19">Cidau, swa eh sia kelame nah mi sipei la kemakme ma pie luzie.</para>
  <para style="q" vid="ZEP 3:19">Ih penuide peu hetwa kepungme, nah penui hengam tei kela gade kideu ga kemdume teibeu zie.<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">Mik 4:6-7</char></note><verse eid="ZEP 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ZEP 3:20" />Cidau Ih nnuide teu swa beu zie; Ih nnuide teu hekwa luzie.</para>
  <para style="q" vid="ZEP 3:20">Ih kideu heleuhdung pelane de peu nnuide herüt peu zie nah twa zie, Ih nnuide peu lungyi dailu kera ci keludau,”</para>
  <para style="q" vid="ZEP 3:20">de eh RAMPAUBE ranggai.<verse eid="ZEP 3:20" /></para>
  <chapter eid="ZEP 3" />
</usx>