<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Zeme(N) Bible Project</book>
  <para style="toc3">Amo.</para>
  <para style="toc2">Amos</para>
  <para style="toc1">Amos Laisiukwak</para>
  <para style="mt">Amos</para>
  <para style="mt">Amos Laisiukwak</para>
  <para style="is">Mraisam</para>
  <para style="ip">Keraube zi Amos, pekie “Hepüt” mede “Hepütkepungbe”. Amos au meurün kekwame ge Tinggwang ne pecu Israel namdidung nreule cingku teilo qulu, hegwangram nreube ga mahei nah mabam kebam tingdau.</para>
  <para style="ip">Minadung Tinggwang dade nreu kedine pa Tinggwang tutiak reci gai, kegahme dade zaisiet, nah pekatei peziu ci eh lunghla kedine.</para>
  <para style="ip">Makengau mengei gade, Amos kekap ting gwang kela ngaudi.</para>
  <para style="ip">Pa minadung dage Tinggwang de redau kera mtei lulo ranggai. Dede Tinggwang de hung kelame ziemne keregui sam ge Amos peugai. David hegwangram teidai lu kera tingba gwangkela nah Tinggwang minadung kwak eh lung kerade.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Israel kidamedung reuga tutiak (1:1-2:5)</para>
  <para style="io1">Israel reuga Tutiak (2:6-16)</para>
  <para style="io1">Israel kemautei kedi (3:1-6:14)</para>
  <para style="io1">Makengau mengei (7:1-9:10)</para>
  <para style="io1">Israel Teucuhdaikelu (9:11-15)</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="s">Israel Kidamedung Reuga Tutiak</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />Amos ma aidungde Israelme de lungpang kela, Tekoa namceu ga meurün kekwabe hangge, keuliakegai gade ngaulu, Uzziah Judah ga Hegwang ketei tingdau pa ma aidungde ngaulu, nah Joash napei Jeroboam Israel deuceu ga hegwang ketei tingdau, nlui keteu dwa mmi kena. <verse eid="AMO 1:1" /><verse number="2" style="v" sid="AMO 1:2" />Pa ranggai,</para>
  <para style="q" vid="AMO 1:2">“RAMPAUBE Zion gade sah gai zie;</para>
  <para style="q" vid="AMO 1:2">Jerusalem gade pe sah kwa cuh gai zie.</para>
  <para style="q" vid="AMO 1:2">Meurün kekwamedung gu tseheidung ki dizie;</para>
  <para style="q" vid="AMO 1:2">Carmel deutu regui dizie.”<verse eid="AMO 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 1:3" />RAMPAUBE ainzwa rangla:</para>
  <para style="q" vid="AMO 1:3">“Damascusme gu kemau kecum de ziemne,</para>
  <para style="q" vid="AMO 1:3">mdai de si eh,</para>
  <para style="q" vid="AMO 1:3">Ih penuide saja peu bizie,</para>
  <para style="q" vid="AMO 1:3">kedanemene penui hegeuniadung le Gileadme de dap kecune.<verse eid="AMO 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 1:4" />Ih Hazael hegwangki gage mi langgai zie,</para>
  <para style="q" vid="AMO 1:4">nah cidene Ben Hadad hegwangpei kengking reketbam ru nggah dizie.<verse eid="AMO 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 1:5" />Ih Damascus kirieki tsiadung teipang dizie</para>
  <para style="q" vid="AMO 1:5">nah Aven Chabak peureu kedibe de ngkap dizie,</para>
  <para style="q" vid="AMO 1:5">nah Beth Eden namdi ga kedibe de si eh.</para>
  <para style="q" vid="AMO 1:5">Aram minadung Kir deu ga hebaang tei mie dizie,”</para>
  <para style="q" vid="AMO 1:5">RAMPAUBE rangla.<verse eid="AMO 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 1:6" />Ainzwa RAMPAUBE ranggai:</para>
  <para style="q" vid="AMO 1:6">“Gazame gu kemau kecum de ziemne,</para>
  <para style="q" vid="AMO 1:6">mdai de si eh,</para>
  <para style="q" vid="AMO 1:6">Ih penuide saja peu bizie,</para>
  <para style="q" vid="AMO 1:6">kedanemene penui mina pelane de hebaang tei eh,</para>
  <para style="q" vid="AMO 1:6">Edomme ba gage penuide kai beudi.<verse eid="AMO 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 1:7" />Gaza namdi riedung gage Ih mi langgai zie,</para>
  <para style="q" vid="AMO 1:7">nah pe kengking reketbam cide ru nggah dizie.<verse eid="AMO 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 1:8" />Ih Ashdod namdi ga mina lungh kebamme de</para>
  <para style="q" vid="AMO 1:8">nah Ashkelon namdi ga hegwang kedime de ngkap dizie.</para>
  <para style="q" vid="AMO 1:8">Ih Ekron namdi de saja peu zie,</para>
  <para style="q" vid="AMO 1:8">nah Philistinme kebangbe tsaiciak dizie,”</para>
  <para style="q" vid="AMO 1:8">RAMPAUBE Tinggwang rangla.<verse eid="AMO 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 1:9" />Ainzwa RAMPAUBE ranggai:</para>
  <para style="q" vid="AMO 1:9">“Tyreme gu kemau kecum de ziemne,</para>
  <para style="q" vid="AMO 1:9">mdai de si eh,</para>
  <para style="q" vid="AMO 1:9">Ih penuide saja peu bizie,</para>
  <para style="q" vid="AMO 1:9">kedanemene penui mina pelane de Edom dage kaibeu kedine,</para>
  <para style="q" vid="AMO 1:9">nah caireiswacing samkak de teipang di.<verse eid="AMO 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 1:10" />Ih Tyre namdi riedung gage mi langgai zie,</para>
  <para style="q" vid="AMO 1:10">nah pe kengking reketbam cide ru nggah dizie.”<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">Mat. 11:21-22, Luk 10:13-14</char></note><verse eid="AMO 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 1:11" />RAMPAUBE ainzwa rangla,</para>
  <para style="q" vid="AMO 1:11">“Edomme gu kemau kecum de ziemne,</para>
  <para style="q" vid="AMO 1:11">mdai de si eh,</para>
  <para style="q" vid="AMO 1:11">Ih penuide saja peu bizie,</para>
  <para style="q" vid="AMO 1:11">kedanemene pa kingtie teu pe sinabe Israelme de gwaketang,</para>
  <para style="q" vid="AMO 1:11">nah ngau kenggia pelane keu gidi.</para>
  <para style="q" vid="AMO 1:11">Pe rata kezeu mene jüja ladi,</para>
  <para style="q" vid="AMO 1:11">nah pe lunghop kelungtane ladi.<verse eid="AMO 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 1:12" />Ih Teman namdi gage mi langgai zie,</para>
  <para style="q" vid="AMO 1:12">nah Bozrah hegwangkidung ru nggah dizie.”<verse eid="AMO 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 1:13" />RAMPAUBE ainzwa rangla,</para>
  <para style="q" vid="AMO 1:13">“Ammonme gu kemau kecum de ziemne,</para>
  <para style="q" vid="AMO 1:13">mdai de si eh,</para>
  <para style="q" vid="AMO 1:13">Ih penuide saja peu bizie,</para>
  <para style="q" vid="AMO 1:13">kedanemene penui Gilead ga mipui tetlak kelame de rim mpet,</para>
  <para style="q" vid="AMO 1:13">penui deuraidung tei mdi kerane.<verse eid="AMO 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 1:14" />Ih Rabbah namdi riedung gage mi mtau gai zie,</para>
  <para style="q" vid="AMO 1:14">nah cide hegwangkidung ru nggah dizie,</para>
  <para style="q" vid="AMO 1:14">hereu keregi benai sah gai zie,</para>
  <para style="q" vid="AMO 1:14">tingkai gui süt kecu benai rahang de si zie.<verse eid="AMO 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 1:15" />Penui gwangpei mibaang tei tet dizie,</para>
  <para style="q" vid="AMO 1:15">pa nah pecu ngngwa ncüt kela kedimedung,”</para>
  <para style="q" vid="AMO 1:15">RAMPAUBE rangla.<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="q">
    <verse number="1" style="v" sid="AMO 2:1" />RAMPAUBE ainzwa rangla:</para>
  <para style="q" vid="AMO 2:1">“Moabme gu kemau kecum de ziemne,</para>
  <para style="q" vid="AMO 2:1">mdai de si eh,</para>
  <para style="q" vid="AMO 2:1">Ih penuide saja peu bizie,</para>
  <para style="q" vid="AMO 2:1">kedanemene pa Edom hegwangpei</para>
  <para style="q" vid="AMO 2:1">radung ru mimüt tei kedine.<verse eid="AMO 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 2:2" />Ih Moab deu gage mi langgai zie,</para>
  <para style="q" vid="AMO 2:2">nah cide Kerioth namdi kengking reketbam ru nggah dizie,</para>
  <para style="q" vid="AMO 2:2">Moabme mra eh tsai zie,</para>
  <para style="q" vid="AMO 2:2">sahbak kegai gade nah telui kwa gade.<verse eid="AMO 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 2:3" />Ih pe tutiakme de ngkap dizie,</para>
  <para style="q" vid="AMO 2:3">nah Ih pe hegwangnapei de teitset dizie,”</para>
  <para style="q" vid="AMO 2:3">RAMPAUBE rangla.<verse eid="AMO 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 2:4" />RAMPAUBE ainzwa rangla,</para>
  <para style="q" vid="AMO 2:4">“Judahme gu kemau kecum de ziemne,</para>
  <para style="q" vid="AMO 2:4">mdai de si eh,</para>
  <para style="q" vid="AMO 2:4">Ih penuide saja peu bizie,</para>
  <para style="q" vid="AMO 2:4">kedanemene penui RAMPAUBE zai be mlai kedine,</para>
  <para style="q" vid="AMO 2:4">nah pe hezaidung mzailu kemakne.</para>
  <para style="q" vid="AMO 2:4">Penui kenret ziemne penui petau kemak gage tet di,</para>
  <para style="q" vid="AMO 2:4">penui paume ndaa tet kedi caiga tetla dida.<verse eid="AMO 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 2:5" />Ih Judah reu gage mi langgai zie,</para>
  <para style="q" vid="AMO 2:5">nah cide Jerusalem kengking reketbam ru nggah dizie.”<verse eid="AMO 2:5" /></para>
  <para style="s">Israel Reuga Tutiak</para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 2:6" />RAMPAUBE ainzwa rangla,</para>
  <para style="q" vid="AMO 2:6">“Israelme gu kemau kecum de ziemne,</para>
  <para style="q" vid="AMO 2:6">mdai de si eh,</para>
  <para style="q" vid="AMO 2:6">Ih penuide saja peu bizie,</para>
  <para style="q" vid="AMO 2:6">kedanemene penui rangkanggeu ziemne keyime de zwa dida</para>
  <para style="q" vid="AMO 2:6">nah picum ge ziemne kegame de zwa di.<verse eid="AMO 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 2:7" />Mina hangdeu ga rebui tangdei caiciem kela nzwa penui makegame peu caiciem;</para>
  <para style="q" vid="AMO 2:7">penui kemneime de nia gidi.</para>
  <para style="q" vid="AMO 2:7">Mige nah pe pei mipui hangge de ngngwa nauhepei zai tei dida</para>
  <para style="q" vid="AMO 2:7">nah iciu eh a zi kemci de tei hera di.<verse eid="AMO 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 2:8" />Kereca ni leune ga kegame dade penui pau bamdo kelu paidung teu,</para>
  <para style="q" vid="AMO 2:8">nah hepau pung kelame ne su kebeu de teu penui Tinggwang ki gade zau sakla.<verse eid="AMO 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 2:9" />Dede Ih Ammoritme de penui dwa gade ngkapdi,</para>
  <para style="q" vid="AMO 2:9">penui ra au cedar ra hu ge nzwa;</para>
  <para style="q" vid="AMO 2:9">pa au mhubangdung nzwa ngking.</para>
  <para style="q" vid="AMO 2:9">Dede pe peureu petsi kebam de</para>
  <para style="q" vid="AMO 2:9">nah pekangle pemah de Ih ngkap di.<verse eid="AMO 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 2:10" />Cipaureu de, Ih nnuide Egypt deu gade ngngwa mpet beu</para>
  <para style="q" vid="AMO 2:10">nah mmi riakdai ge hetaideu gade nnui lampui saubeu</para>
  <para style="q" vid="AMO 2:10">Ammoritme deu de luulu kerane.<verse eid="AMO 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 2:11" />Ih nnui namedung kakgade caihakecime de teu cuhgai</para>
  <para style="q" vid="AMO 2:11">nah nnui rehang kangge de Nazaritme<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fq" closed="false">Nazaritme </char><char style="ft" closed="false">Nazaritme au Tinggwang ta tei kera teu ntsam kelume </char></note> tei kera</para>
  <para style="q" vid="AMO 2:11">Ciciu meni,</para>
  <para style="q" vid="AMO 2:11">Israelmedung?,</para>
  <para style="q" vid="AMO 2:11">RAMPAUBE ne aide ndugai.<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">Nazaritme de penui peutam bietlu kera peu ma mede zau sak kera. Naziritme hezai ga lia kegai nzwa penui sampet kekiee ge pet gai maisia: Pum 6.1-21.</char></note><verse eid="AMO 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 2:12" />Dede nnui Nazaritme de peu zau sak</para>
  <para style="q" vid="AMO 2:12">nah caihakecime de peu caiha keci sam rang lak lie aja kai.<verse eid="AMO 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 2:13" />Pielo, Ih nnuide rüt takcai dizie</para>
  <para style="q" vid="AMO 2:13">tsiu puiting eh pung kela bagi migede rüt takcailu kebui nzwa.<verse eid="AMO 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 2:14" />Pak kecime mbai gai lak;</para>
  <para style="q" vid="AMO 2:14">kengkingme pe kengking gage kaisi gailak;</para>
  <para style="q" vid="AMO 2:14">mede pekatei pe kengking le pecu keli gailak.<verse eid="AMO 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 2:15" />Lakpi kepwame sapgai lak dizie;</para>
  <para style="q" vid="AMO 2:15">pak nzetsüt kecume mbai gai lak;</para>
  <para style="q" vid="AMO 2:15">hekwen keteume penui katei penui teilung keli gailak.<verse eid="AMO 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="AMO 2:16" />Cipau nai reugwame kuutumedung kecangde</para>
  <para style="q" vid="AMO 2:16">penui paula eh pak dizie,</para>
  <para style="q" vid="AMO 2:16">RAMPAUBE ne aide ndugai.”<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="s">Israel de Mmau eh Zierangme Qukegai</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />RAMPAUBE nnuide rang mmau kebam sam aide kingnei gailo, Israelme, Ih Egypt deu gade ngngwa kempet pelane de mmau eh:<verse eid="AMO 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 3:2" />“Ih ncu rünne kedetlu</para>
  <para style="q" vid="AMO 3:2">kideu ga heleuh pelane dade.</para>
  <para style="q" vid="AMO 3:2">Cine Ih ncu saja peu zie</para>
  <para style="q" vid="AMO 3:2">n kemaudung pelane ziemne.”<verse eid="AMO 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 3:3" />Hangna kesuizwa mene</para>
  <para style="q" vid="AMO 3:3">penai ngngwa tet ncüt zieni?<verse eid="AMO 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 3:4" />Hingho hegung gade</para>
  <para style="q" vid="AMO 3:4">keda makaune de tuilu mecai hingho mrung zie ni?</para>
  <para style="q" vid="AMO 3:4">Hinghona peki gade</para>
  <para style="q" vid="AMO 3:4">pa magede tuilu mecai nra zie ni?<verse eid="AMO 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 3:5" />Kideu ga hetak gede teupwa bam mene</para>
  <para style="q" vid="AMO 3:5">daidau nruine ge hetak ga mie keu zie no?</para>
  <para style="q" vid="AMO 3:5">Hetak ge cide magede tui mene</para>
  <para style="q" vid="AMO 3:5">hangdeu gade cuh nkap zieni?<verse eid="AMO 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 3:6" />Magade namdi ga telui kwa gai cai,</para>
  <para style="q" vid="AMO 3:6">minadung ngngi lak ni?</para>
  <para style="q" vid="AMO 3:6">Magade namdi ga keherei gwang liecai</para>
  <para style="q" vid="AMO 3:6">cide RAMPAUBE ne langgai meni?<verse eid="AMO 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 3:7" />RAMPAUBE Tinggwang pe kilame caihakecime</para>
  <para style="q" vid="AMO 3:7">dage pe kecet ranglia mene magede tei lama.<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">Keu. 10:7, Lei. 25:14, Jhn 15:15</char></note><verse eid="AMO 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 3:8" />Hingho nrung gai;</para>
  <para style="q" vid="AMO 3:8">cau hing melai no?</para>
  <para style="q" vid="AMO 3:8">RAMPAUBE Tinggwang marang gai de;</para>
  <para style="q" vid="AMO 3:8">cauge caihakeci sam rang melu lai no?<verse eid="AMO 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 3:9" />Ashdod kengking reketbamdung gage,</para>
  <para style="q" vid="AMO 3:9">nah Egypt deu kengking reketbamdung gage aide ranggai beulo;</para>
  <para style="q" vid="AMO 3:9">“Samaria lamlwatudung ga nnui gwang ngkwa lu</para>
  <para style="q" vid="AMO 3:9">nah peda daipai cikehebwak kedi bambi pie lo,</para>
  <para style="q" vid="AMO 3:9">nah peda daipai keherei bam bi kecu.<verse eid="AMO 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 3:10" />Penui dainzwa petaube teilu zie bi cikemak ziemne,</para>
  <para style="q" vid="AMO 3:10">RAMPAUBE ne aide ndugai,</para>
  <para style="q" vid="AMO 3:10">Penui zaisiet</para>
  <para style="q" vid="AMO 3:10">nah mide tei ngkap kelu le kengking reketbamdung kai puilu.”<verse eid="AMO 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 3:11" />Cine RAMPAUBE Tinggwang ainzwa rangla:</para>
  <para style="q" vid="AMO 3:11">“Ngauraume ne kideu twagwalu zie,</para>
  <para style="q" vid="AMO 3:11">nah nnui kengkingbam teu nghung dizie</para>
  <para style="q" vid="AMO 3:11">nah nnui kengkingbam tei msia dizie.”<verse eid="AMO 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 3:12" />RAMPAUBE ainzwa rangla:</para>
  <para style="q" vid="AMO 3:12">“Meurün kekwabe hingho mui gade</para>
  <para style="q" vid="AMO 3:12">pe pi kena rünne, mede pe kwen ge keu keli lula kecu nzwa;</para>
  <para style="q" vid="AMO 3:12">cinzwa Israelme Samaria ga kelungme de de kelilu zie;</para>
  <para style="q" vid="AMO 3:12">penuide bamtie ge gutu nage</para>
  <para style="q" vid="AMO 3:12">mede zeulie ge gu sau nage rünne gi gai beuzie.”<verse eid="AMO 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 3:13" />Kingnei lwe zierang teilu</para>
  <para style="q" vid="AMO 3:13">Jacob leuhme dage ranglia lo,</para>
  <para style="q" vid="AMO 3:13">RAMPAUBE Tinggwang ne aide ndugai, reugwame reu Tinggwang:<verse eid="AMO 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 3:14" />“Ih Israelme maudung ziemne saja kepeu benai,</para>
  <para style="q" vid="AMO 3:14">Ih Bethel recabamdung de ngkap dizie.</para>
  <para style="q" vid="AMO 3:14">Recabam kiidung de ngkap dizie</para>
  <para style="q" vid="AMO 3:14">nah hangdeu ga kaumie dizie.<verse eid="AMO 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 3:15" />Ih tingtiak ki penai</para>
  <para style="q" vid="AMO 3:15">tinglum ki ngkap dizie.</para>
  <para style="q" vid="AMO 3:15">Hepwa ngeu le tei kelu kidung sia dizie,</para>
  <para style="q" vid="AMO 3:15">nah ki kedidung gah dizie,</para>
  <para style="q" vid="AMO 3:15">RAMPAUBE ne aide ndugai.”<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="s">Israel Tinggwang da Cailigwang kemak</para>
  <para style="q">
    <verse number="1" style="v" sid="AMO 4:1" />Sam aide kingnei lu,</para>
  <para style="q" vid="AMO 4:1">nnui Bashan hetumdung,<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">Samariame puidung de Bashan ga hetumdung de kedakegai. </char></note></para>
  <para style="q" vid="AMO 4:1">nnui Samaria lamlwatu ga kebammedung,</para>
  <para style="q" vid="AMO 4:1">nnui kegame de nneu kelame,</para>
  <para style="q" vid="AMO 4:1">nnui kengha teu maisia kelame de tei keherei kelame,</para>
  <para style="q" vid="AMO 4:1">nnui nahpeimedung dade,</para>
  <para style="q" vid="AMO 4:1">“Anuide zau teu gwang beulo” de eh rang kelame.<verse eid="AMO 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 4:2" />RAMPAUBE Tinggwang pe kemci gade sampet dida,</para>
  <para style="q" vid="AMO 4:2">“Pielo, tingbadung nnui da gwang zie</para>
  <para style="q" vid="AMO 4:2">cidau penui kagwakdung le nnuide teugi dizie,</para>
  <para style="q" vid="AMO 4:2">nnui pelane de heka kagwak le teugi dizie.<verse eid="AMO 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 4:3" />Nnui namdi kirie kepang kakgade mpet zie,</para>
  <para style="q" vid="AMO 4:3">nnui mige ge kecu cide gade nzuizang eh mpet zie,</para>
  <para style="q" vid="AMO 4:3">nah nnuide Harmon lambie ge kelien mpet dizie,</para>
  <para style="q" vid="AMO 4:3">RAMPAUBE ne aide ndugai.”<verse eid="AMO 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 4:4" />“Bethel namdi ga mie kemau tei lulo,</para>
  <para style="q" vid="AMO 4:4">Gilgal namdi ga mielu nah kemau tei ngkiee lu,</para>
  <para style="q" vid="AMO 4:4">tingcang ramsang nnui ratak teu gwanglu,</para>
  <para style="q" vid="AMO 4:4">langcum ne cai ramsang nnui kereizige teugwang lu.<verse eid="AMO 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 4:5" />Tangku le ketwa ratak tei gailu;</para>
  <para style="q" vid="AMO 4:5">suiyi makai peu kegaide cide rang ndu lia lu,</para>
  <para style="q" vid="AMO 4:5">kedanemene aide nnui suiyi tei lula,</para>
  <para style="q" vid="AMO 4:5">nnui Israelme,</para>
  <para style="q" vid="AMO 4:5">RAMPAUBE Tinggwang ne aide ndugai.<verse eid="AMO 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 4:6" />Ih nnui namdi pelane gage herakum teugwang gaibeu,</para>
  <para style="q" vid="AMO 4:6">nah nnui deu pelane ga peu tangku cam di.</para>
  <para style="q" vid="AMO 4:6">Iciuliede nnui a da nreu cailigwang ma,</para>
  <para style="q" vid="AMO 4:6">RAMPAUBE ne aide ndugai.<verse eid="AMO 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 4:7" />Ih nnui dade tingrui liede kamdi</para>
  <para style="q" vid="AMO 4:7">luhlüt kera keicum ge bam reu kecudau liede.</para>
  <para style="q" vid="AMO 4:7">Ih namdi ket ga tingrui peugai,</para>
  <para style="q" vid="AMO 4:7">nah namdi kedadung ga tingrui peugai ma.</para>
  <para style="q" vid="AMO 4:7">Hangdeu ket reuga tingrui gai,</para>
  <para style="q" vid="AMO 4:7">dede hangdeu reuga tingrui gai kemak de cangdi.<verse eid="AMO 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 4:8" />Namdi kena mede kecum duisak kerane namdi keda ga mie,</para>
  <para style="q" vid="AMO 4:8">dede nnung lu ma.</para>
  <para style="q" vid="AMO 4:8">Iciuliede nnui a da nreu cailigwang ma,</para>
  <para style="q" vid="AMO 4:8">RAMPAUBE ne aide ndugai.<verse eid="AMO 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 4:9" />Ih nnui dage nnui gu luh niadung lung kesia peugai.</para>
  <para style="q" vid="AMO 4:9">Nnui guriedung kekiee ge,</para>
  <para style="q" vid="AMO 4:9">nnui gu kube luhdung,</para>
  <para style="q" vid="AMO 4:9">nnui gu nzüttsi bangdung,</para>
  <para style="q" vid="AMO 4:9">nah nnui gu olive bangdung,</para>
  <para style="q" vid="AMO 4:9">tangriemdung ne tyei nggah ciak di.</para>
  <para style="q" vid="AMO 4:9">Iciuliede nnui a da nreugwang ma,</para>
  <para style="q" vid="AMO 4:9">RAMPAUBE ne aide ndugai.<verse eid="AMO 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 4:10" />Ih Egypt deudi ga nzwa nnui dage rapia langgai.</para>
  <para style="q" vid="AMO 4:10">Ih nnui rehangme de kingtie le teitset di,</para>
  <para style="q" vid="AMO 4:10">nnui hekwendung teu tetdi,</para>
  <para style="q" vid="AMO 4:10">nah nnui ramzeukidung ga ketsaipau timrim le</para>
  <para style="q" vid="AMO 4:10">nnui ngkie kidung ga gwangdi,</para>
  <para style="q" vid="AMO 4:10">Iciuliede nnui a da cailigwang ma,</para>
  <para style="q" vid="AMO 4:10">RAMPAUBE ne aide ndugai.<verse eid="AMO 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 4:11" />Ih nnui namdidung kesa ngkap dida</para>
  <para style="q" vid="AMO 4:11">Tinggwang Sodom nah Gomorrah ngkap kedi nzwa</para>
  <para style="q" vid="AMO 4:11">nnui au tsingtie heu bam eh mi gade teu mpet kelu nzwa da</para>
  <para style="q" vid="AMO 4:11">iciuliede nnui a da nreu gwang ma,</para>
  <para style="q" vid="AMO 4:11">RAMPAUBE ne aide ndugai.<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false">Ken. 19:24-25</char></note><verse eid="AMO 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 4:12" />Cine Israelme Ih nnui dage ma hingsüt kecu ge teigai zie;</para>
  <para style="q" vid="AMO 4:12">nah Ih nnui dage ma hingsüt kecu ge teigai zie kecune,</para>
  <para style="q" vid="AMO 4:12">nnui Tinggwang de redau kera mtei lulo, Israel!<verse eid="AMO 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 4:13" />Cine, pielo, lamlwatudung tei kegaibe</para>
  <para style="q" vid="AMO 4:13">tingkai liede dam gai,</para>
  <para style="q" vid="AMO 4:13">pe kecet peu minadung de cigai,</para>
  <para style="q" vid="AMO 4:13">tingcang teipwa muiting di,</para>
  <para style="q" vid="AMO 4:13">nah kideu kecehu henidung ga tetla,</para>
  <para style="q" vid="AMO 4:13">RAMPAUBE, reugwame reu Tinggwang, cide pezi.” <note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="ft" closed="false">2 Kor. 6:18</char></note><verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s">Kehap nah Helungkemreu Qukegai</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />Israelme Ih nnui reu gage hei eh hap eh rang kegai sam aide kingneilu.<verse eid="AMO 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 5:2" />Kemci Israel kau dida;</para>
  <para style="q" vid="AMO 5:2">pa cuh dai si lak ta;</para>
  <para style="q" vid="AMO 5:2">pecu pe deu gage gigai dida;</para>
  <para style="q" vid="AMO 5:2">migede pecu teucuh beu kera gah.<verse eid="AMO 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 5:3" />RAMPAUBE Tinggwang aide ziemne rangla:</para>
  <para style="q" vid="AMO 5:3">“Namdi gade mina cang ge ngngwa tet pet kegai gade haige rünne bang beuzie,</para>
  <para style="q" vid="AMO 5:3">nah mina haige ngngwa tet pet kegai namdi gade kerei rünne bang beuzie,</para>
  <para style="q" vid="AMO 5:3">Israel kilungme.”<verse eid="AMO 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 5:4" />RAMPAUBE aide ziemne Israelme dage rangla:</para>
  <para style="q" vid="AMO 5:4">“Acu peeilu delwe lungh lu!<verse eid="AMO 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 5:5" />Bethel de peei so;</para>
  <para style="q" vid="AMO 5:5">mede Gilgal ga lüt so;</para>
  <para style="q" vid="AMO 5:5">Beersheba ga mbeu mie so.</para>
  <para style="q" vid="AMO 5:5">Kedanemene Gilgal au mibaang tei di bi zie lu,</para>
  <para style="q" vid="AMO 5:5">nah Bethel magede ta dizie.<verse eid="AMO 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 5:6" />RAMPAUBE de peeilu delwe lunghlu,</para>
  <para style="q" vid="AMO 5:6">mecai pa Joseph leuhme dage</para>
  <para style="q" vid="AMO 5:6">mi nzwa heu pet zie.</para>
  <para style="q" vid="AMO 5:6">Mi cidene ru nggah dizie,</para>
  <para style="q" vid="AMO 5:6">nah Bethel ga pe hereu kak beu kera migede bam lak.<verse eid="AMO 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 5:7" />Mina cidungde kesamsang de pwa kekaadung tei di</para>
  <para style="q" vid="AMO 5:7">nah kesamsangme de kelien mie kideu gage kai dila!”<verse eid="AMO 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 5:8" />Tinggwang Tialiangkileime nah Orion teigai;<note caller="+" style="f"><char style="fr" closed="false">5:8 </char><char style="ft" closed="false">heriakting nah hereiting gu hegidung,</char></note></para>
  <para style="q" vid="AMO 5:8">pa kemui pwa tingcang teidi;</para>
  <para style="q" vid="AMO 5:8">pa tingba pwa tingmui teidi</para>
  <para style="q" vid="AMO 5:8">nah jaaidi gade duidung de qugai;</para>
  <para style="q" vid="AMO 5:8">pa cidungde rui mpet kideu reu gage kai.</para>
  <para style="q" vid="AMO 5:8">Pezi au RAMPAUBE!<verse eid="AMO 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 5:9" />Pa kengkingme dage kengkap zette teugwang beula</para>
  <para style="q" vid="AMO 5:9">iciu eh kengking reketbam ga kengkap gwangla.<verse eid="AMO 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 5:10" />Namdi rieki gade mi keheibe de penuide ledeu kegaime de ngkau la,</para>
  <para style="q" vid="AMO 5:10">nah kesangbe kerangme keheibe de penui ngau nghet la.<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="GAL 4:16">Gal. 4:16</ref></char></note><verse eid="AMO 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 5:11" />Nnui kegahme de dauciem mie kecune</para>
  <para style="q" vid="AMO 5:11">nah pe dade wheat pe qwa keuteu di kecune,</para>
  <para style="q" vid="AMO 5:11">nnui tangtsule kidung teilu liede,</para>
  <para style="q" vid="AMO 5:11">nnui cika lungh lak.</para>
  <para style="q" vid="AMO 5:11">Nnui kubetsi luh keyidung bam,</para>
  <para style="q" vid="AMO 5:11">dede nnui cikade ngau kelu zau sak lak.<verse eid="AMO 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 5:12" />Nnui pia dai kieege hezai gileu bi</para>
  <para style="q" vid="AMO 5:12">nah n maudung dai dige di bi kecu Ih cibam,</para>
  <para style="q" vid="AMO 5:12">nnui kesamsangme de tei keherei kelame,</para>
  <para style="q" vid="AMO 5:12">hetau henim luu,</para>
  <para style="q" vid="AMO 5:12">nah namdi rieki gade kegahme dade cainok dila.<verse eid="AMO 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 5:13" />Cine makecetme keheibe de peting cikenzwa dau mlei mene bamla,</para>
  <para style="q" vid="AMO 5:13">cide peting be kesiane.<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="EPH 5:16">Eph. 5:16</ref></char></note><verse eid="AMO 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 5:14" />Kesiabe mene keyibe peeilu,</para>
  <para style="q" vid="AMO 5:14">iciu eh nang ringlu kerane.</para>
  <para style="q" vid="AMO 5:14">Cine RAMPAUBE, reugwame reu Tinggwang, nnuide ngngwa lazie,</para>
  <para style="q" vid="AMO 5:14">nnui kerang nzwa eh.<verse eid="AMO 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 5:15" />Kesiabe ngkaulu, keyibe hunglu,</para>
  <para style="q" vid="AMO 5:15">namdi kirie ga kemzuibe dwa cuhlu.</para>
  <para style="q" vid="AMO 5:15">Iciu lucai RAMPAUBE, reugwame reu Tinggwang, Joseph leuhme bang kebeume de de ngaunggia beuzie.<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="ROM 12:9">Rom. 12:9</ref></char></note><verse eid="AMO 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="AMO 5:16" />Cine, RAMPAUBE ainzwa rangla,</para>
  <para style="q" vid="AMO 5:16">reugwame reu Tinggwang, Rampaube</para>
  <para style="q" vid="AMO 5:16">“Lungrei le petu pekungdung leune ga pui dizie,</para>
  <para style="q" vid="AMO 5:16">nah penui puidikidung leune gade rang zie,</para>
  <para style="q" vid="AMO 5:16">‘Ainie suisiet! Ainie suisiet!’</para>
  <para style="q" vid="AMO 5:16">Penui heta ketame de ketsai nggia lulo quzie</para>
  <para style="q" vid="AMO 5:16">nah ketsai nggia kecumedung de hap lulo zie.<verse eid="AMO 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="AMO 5:17" />Kubeluh pelane ga hap bam dizie,</para>
  <para style="q" vid="AMO 5:17">Ih nnui kakgade tet kahgwang zie kecune,”</para>
  <para style="q" vid="AMO 5:17">RAMPAUBE rangla.<verse eid="AMO 5:17" /></para>
  <para style="s">Rampaube Tingba</para>
  <para style="q">
    <verse number="18" style="v" sid="AMO 5:18" />Ainie keherei gwang lada nnui RAMPAUBE tingba ngauneu kelame da!</para>
  <para style="q" vid="AMO 5:18">RAMPAUBE tingba de daitei nnui regui lano?</para>
  <para style="q" vid="AMO 5:18">Cide kebaa mene kemui ge zie,<verse eid="AMO 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="AMO 5:19" />mige hingho ge dade pak kela dau</para>
  <para style="q" vid="AMO 5:19">hegum ge pecu redau kelu nzwa,</para>
  <para style="q" vid="AMO 5:19">mede pa ki gega gwang eh tangdeu gage peba kai</para>
  <para style="q" vid="AMO 5:19">eh henei ge ne pecu nsau kedi nzwa.<verse eid="AMO 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="AMO 5:20" />RAMPAUBE tingba kebaa mene kemui tingba ge lak ni?</para>
  <para style="q" vid="AMO 5:20">Suisiet lepui nah kebaa gah eh?<verse eid="AMO 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="AMO 5:21" />RAMPAUBE rang eh, “Ih ngkau, Ih nnui hengyidung a suima,</para>
  <para style="q" vid="AMO 5:21">nnui ngkwa kebam hemaabe de a suima.<verse eid="AMO 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="AMO 5:22" />Nnui keru recadung nah mei recadung acu peu liede,</para>
  <para style="q" vid="AMO 5:22">Ih cidungde luu lak,</para>
  <para style="q" vid="AMO 5:22">mede nnui gu makaune pelui keyibe le hemaabe recadung tei kegaide de Ih pie lak.<verse eid="AMO 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="AMO 5:23" />A dade nnui lei kwadung keutet di lo;</para>
  <para style="q" vid="AMO 5:23">Ih nnui leibung kwadung kingnei lak.<verse eid="AMO 5:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="AMO 5:24" />Cipau nding gade, peu kemzuibe de dui nzwa lwa lu,</para>
  <para style="q" vid="AMO 5:24">nah kesamsang de peu hereuki cangh dila kemak nzwa lwa lulo.<verse eid="AMO 5:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="AMO 5:25" />Israel leuhme, nnui mmi riakdai ge hetaideu ga keladau</para>
  <para style="q" vid="AMO 5:25">ratak nah reca teugwang acu peu ni?<verse eid="AMO 5:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="AMO 5:26" />Nnui Sikkuth miedung pwa cuh, nnui gwangpei,</para>
  <para style="q" vid="AMO 5:26">nah Kaiwan, nnui gu hegi rabe,</para>
  <para style="q" vid="AMO 5:26">nnui katei nnui ziemne tei keludung de.<note caller="+" style="f"><char style="fr" closed="false">5:26 </char><char style="ft" closed="false">Bat 7:42-43 </char></note><verse eid="AMO 5:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="AMO 5:27" />Cine Ih nnuide Damascus gwale ge langgi dizie,”</para>
  <para style="q" vid="AMO 5:27">RAMPAUBE rangla,</para>
  <para style="q" vid="AMO 5:27">pezi au reugwame reu Tinggwang.<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s">Kwakkebam Kengngi</para>
  <para style="q">
    <verse number="1" style="v" sid="AMO 6:1" />Ainie Zion ga relui eh kebamme da keherei gwang zieda,<note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="ft" closed="false">Jerusalem namdi </char></note></para>
  <para style="q" vid="AMO 6:1">nah Samaria deudi kideutu ga kwak kebamme,</para>
  <para style="q" vid="AMO 6:1">heleuhdung gade mina kenlang yitume,</para>
  <para style="q" vid="AMO 6:1">Israelme cipaume da kengha ziemne gwangla!<verse eid="AMO 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 6:2" />Nnui muiteume rangla, “Kalneh namdi ga mie delwe pielo;</para>
  <para style="q" vid="AMO 6:2">cikade Hamath namdi ga mie lu, namdi kedi de;</para>
  <para style="q" vid="AMO 6:2">pecai Philistiame namdi Gath ga hung lu.</para>
  <para style="q" vid="AMO 6:2">Nnui hegwangram kena swa penui be yiki ni?</para>
  <para style="q" vid="AMO 6:2">Penui deurai be nnui deurai swa diki ni?”<verse eid="AMO 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 6:3" />Ainie tingba kesiadung keu mpetti kelame da keherei gwang zieda,</para>
  <para style="q" vid="AMO 6:3">nah kehebwak hegwangbam teugwang nnaki gaibeu.<verse eid="AMO 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 6:4" />Penui hepwa ngeu zeudung ga zeu la</para>
  <para style="q" vid="AMO 6:4">nah penui bamtiedung ga bam.</para>
  <para style="q" vid="AMO 6:4">Penui meurün hau gade meuründung</para>
  <para style="q" vid="AMO 6:4">nah hetum ki gade hetumnadung teih tyei.<verse eid="AMO 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 6:5" />Penui leibungdung kwa eh kemie leidung tei;</para>
  <para style="q" vid="AMO 6:5">penui David leibungdung ketei nzwa tei neula.<verse eid="AMO 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 6:6" />Penui hekwakdung gade zau sak</para>
  <para style="q" vid="AMO 6:6">nah penui katei penui de macadung yitube le keniak,</para>
  <para style="q" vid="AMO 6:6">dede Joseph leuhme kap kedine penui hei eh hap ma.<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">Israel gu kengkap</char></note><verse eid="AMO 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 6:7" />Cine cu penui mibaang tei raitume de ngngwa eh hebaang tei dizie,</para>
  <para style="q" vid="AMO 6:7">nah taktyeidung tyei eh mbau kebam de gah dizie.<verse eid="AMO 6:7" /></para>
  <para style="s">Rampaube Israel ngang kelade ngkaula</para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 6:8" />“Ih RAMPAUBE Tinggwang, akatei a zi gade sampet gaila,</para>
  <para style="q" vid="AMO 6:8">RAMPAUBE Tinggwang reugwame reu Tinggwang ne aide ndugai,</para>
  <para style="q" vid="AMO 6:8">Ih Jacob hegie de a sui ma;</para>
  <para style="q" vid="AMO 6:8">Ih pe kengking reketbam de ngkau.</para>
  <para style="q" vid="AMO 6:8">Cine Ih namdi cika kebam pelane de pwa pe ngauraume de peu dizie.” <verse eid="AMO 6:8" /><verse number="9" style="v" sid="AMO 6:9" />Magade kilung cika mina hangkerei bang beu cai, ciciu cai penui tsaiciak dizie. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />Cidau ketsaibe kibaume penui paau pwa kera gwang kecudau, ki gade ketsai paau pwa mpet kelu cai ketsai kelamluibe de, Magade pa kilung ga kebam be dade rang eh, “Cika mikangge ncu ngngwa bam reu ni?” Magade pa, “Ma,” de rang cai. Iciu cai pa rang zie, “Zing de lu, kedanemene anui RAMPAUBE zi qu kerabe melu.”<verse eid="AMO 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 6:11" />Cine, pielo, RAMPAUBE aja kaigai zie,</para>
  <para style="q" vid="AMO 6:11">nah ki kedibe dap kecai dizie,</para>
  <para style="q" vid="AMO 6:11">nah ki keceu be tei nsia dizie.<verse eid="AMO 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 6:12" />Hekwendung tangtsu tia gade pakla ni?</para>
  <para style="q" vid="AMO 6:12">Mige hetumseudung de cika ngngwa puh lani?</para>
  <para style="q" vid="AMO 6:12">Iciuliede nnui kemzuibe kereu pwa heiring teidi</para>
  <para style="q" vid="AMO 6:12">nah kesamsang tsi de kekaa gage kai di.<verse eid="AMO 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 6:13" />Lo Debar reu nnui sui kelame,</para>
  <para style="q" vid="AMO 6:13">penui rangla, “Anui katei anui kengking le Karnaim luulu meni?”<verse eid="AMO 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 6:14" />“Dede pielo, Ih nnuide renia kera heleuh ge teucuh gai zie,</para>
  <para style="q" vid="AMO 6:14">Israel leuhme, RAMPAUBE Tinggwang ne aide ndugai, reugwame reu Tinggwang.</para>
  <para style="q" vid="AMO 6:14">Penui nnuide teikeherei zie</para>
  <para style="q" vid="AMO 6:14">Lebo Hamath gade gwang Arabah hereuki kecang.”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s">Tangrim, Mi nah Kemdet Ria Ge</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />RAMPAUBE Tinggwang aide acu keu liagai. Pielo, heriakting mei lungh cuh kera mtei kecudau pa tangriem hauge de teigai, nah, ainie, cide au hegwangpei luhlüt kelu cai lungh cuh kela mei. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />Tangrim cidungde kideu ga ginei kemdiak tyei cang kedicai Ih ranggai, “RAMPAUBE Tinggwang, ngaunggia eh n minadung mau gi beulo; dainzwa eh Jacob ringlu zie no? Pa au ceuham kecune.” <verse eid="AMO 7:2" /><verse number="3" style="v" sid="AMO 7:3" />RAMPAUBE pelung nreu lwe pa rangdi, “Cide peu tei dilak.”<verse eid="AMO 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />RAMPAUBE Tinggwang ainzwa acu keulia: Pielo, RAMPAUBE Tinggwang hetutiak kera mi qugai, cide ma kekiee tei cangh di, hangdeu kang dui kecok nah kideu de de ru nggah dilai di. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />Dede Ih ranggai, “RAMPAUBE Tinggwang, kenggia eh mtak dilo; dainzwa eh Jacob ringlu zie no? Pa au ceuham kecune.” <verse eid="AMO 7:5" /><verse number="6" style="v" sid="AMO 7:6" />RAMPAUBE pelung nreu lwe, “Aide liede peu tei dilak,” de eh RAMPAUBE Tinggwang ranggai.<verse eid="AMO 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />Pa aide acu keulia gai: Ainie, Rampaube herie taiga sap, pe ba ga kemdet ria gede si la. <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />RAMPAUBE a dage ranggai, “Amos, nang daipai ngau zeu no?” Ih ranggai, “Kemdet ria ge.” Ge Rampaube rang eh, “Ainie, Ih a mina Israel kakgage kemdet ria kai zie. Ih penuide saja peu kera alung nreu daidi lakta.<verse eid="AMO 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 7:9" />Isaac gu heni kecehudung de ngkap dizie,</para>
  <para style="q" vid="AMO 7:9">Israelme gu kemci nidung kau gah dizie,</para>
  <para style="q" vid="AMO 7:9">nah Ih hegwangpei Jeroboam gwangram de kingtie le renia cuh zie da.”<verse eid="AMO 7:9" /></para>
  <para style="s">Amos penai Amaziah</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />Pecai Amaziah, Bethel recabam ni ga cingkupei kedibe, Israel gwangpei Jeroboam dage sam langgai: “Amos Israelme kakgade lungcet kesia riem bam dida. Kideube pe samdung leune lia gai lakta. <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />Amos aide ziemne ranggai,</para>
  <para style="q" vid="AMO 7:11">‘Jeroboam kingtie gade tsai zie,</para>
  <para style="q" vid="AMO 7:11">nah Israelme penui deu gade mbai eh keda deu ga peu gwang bi dizie.’” <verse eid="AMO 7:11" /><verse number="12" style="v" sid="AMO 7:12" />Amaziah Amos dage rang, “Caihakecibo, tet di, Judah deu ga pak cailigwang di, nah cikade tangku tyei nah cairasam ranglu. <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />Dede Bethel aikade caiha rang sita dilu, cide hegwangpei kemcibam ge kecune nah hegwang kige lu.”<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />Ge Amos Amaziah dage ranggai, “Ih au caihakecime ma mede caihakecime name de ma. Ih au kauruine kekwame ge, Ih sycamore nzütbangdung pie lamlui la. <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />Dede meurün kwa kela dau RAMPAUBE acu ngngwa lu nah a da rang, ‘Mie cu, a mina Israelme da ge cairasam ranggai lu.’ <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />Cu RAMPAUBE sam kingnei lulo. Nnui rangla, ‘Israelme dage cairasam rang sita lo, nah Isaac leuhme de rang msia tadi lo.’ <verse eid="AMO 7:16" /><verse number="17" style="v" sid="AMO 7:17" />Ciziemne, RAMPAUBE ainzwa rangla,</para>
  <para style="q" vid="AMO 7:17">‘N nau namdi gade helipui ge tei dizie.</para>
  <para style="q" vid="AMO 7:17">N napeidung nah n napuidung kingtie gade kau dizie;</para>
  <para style="q" vid="AMO 7:17">ndeu mdet lu eh mzi beu dizie;</para>
  <para style="q" vid="AMO 7:17">nah nang nci kemak deu gade tsai dizie,</para>
  <para style="q" vid="AMO 7:17">nah Israelme penui deu gade kedame deu ga hebaang tei mie bi dizie.’”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s">Matsi Meukebam Rak ge</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />RAMPAUBE Tinggwang ainzwa eh acu keulia. Pielo, tinglum gu matsi biaktui ge! <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />RAMPAUBE keteugai, “Amos, nang daipai ngau zeu no?” Ih ranggai, “Tinglum gu matsi biaktui ge.” Ge RAMPAUBE a dage ranggai,</para>
  <para style="q" vid="AMO 8:2">“A mina Israelme ziemne penlibe gwang dida;</para>
  <para style="q" vid="AMO 8:2">Ih penuide saja peu kera a lung nreu dai dilak.<verse eid="AMO 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 8:3" />Aide RAMPAUBE Tinggwang ne ndugai,</para>
  <para style="q" vid="AMO 8:3">Cipau nai ngqwaki leidung kehapkwa ge dizie,</para>
  <para style="q" vid="AMO 8:3">kecai paaudung kekiee ge, penuide maleune gage kelien gai!</para>
  <para style="q" vid="AMO 8:3">Nlei mene!”<verse eid="AMO 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 8:4" />Aide kingnei lulo, nnui naang kelame de caicim kelame</para>
  <para style="q" vid="AMO 8:4">nah kideu ga kegahme de keugi di kelame. <verse eid="AMO 8:4" /><verse number="5" style="v" sid="AMO 8:5" />Penui rangla,</para>
  <para style="q" vid="AMO 8:5">“Daidau hekei keheci cangdi zie de bi,</para>
  <para style="q" vid="AMO 8:5">iciu eh anui mei zwa dailu kerane?</para>
  <para style="q" vid="AMO 8:5">Daidau ge sabbath tingba cang di zie de bi,</para>
  <para style="q" vid="AMO 8:5">iciu eh anui gu wheat zwa lu kerane?</para>
  <para style="q" vid="AMO 8:5">Anui pemdet tei mceu dizie</para>
  <para style="q" vid="AMO 8:5">nah pemi tei nkiee luzie,</para>
  <para style="q" vid="AMO 8:5">kenret mdet teu eh anui mide cwa kela nzwa.<verse eid="AMO 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 8:6" />Anui aiciu eh wheat kesiabe zwa lu kerane, rangkanggeu le kegahme de luilu zie,</para>
  <para style="q" vid="AMO 8:6">nah picum gele kennangme de lui luzie.” <verse eid="AMO 8:6" /><verse number="7" style="v" sid="AMO 8:7" />Jacob kengang dene RAMPAUBE pekatei sampet dida, “Ih penui kemau bata tei kedi madauge de nsungta dilak.”<verse eid="AMO 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 8:8" />Kideube ai ziemne teu kelai dilak ni,</para>
  <para style="q" vid="AMO 8:8">nah cika lungh kebam leune hei eh hap sia lak ni?</para>
  <para style="q" vid="AMO 8:8">Nile reuki nzwa cidungde pelane cuh hang dizie</para>
  <para style="q" vid="AMO 8:8">nah cide pereu mlim rwa nah pekang mlim mie dai di zie,</para>
  <para style="q" vid="AMO 8:8">Egypt deudi ga kereuki nzwa.<verse eid="AMO 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 8:9" />“Cipaunai ciciu gwang zie,</para>
  <para style="q" vid="AMO 8:9">RAMPAUBE Tinggwang ne aide ndugai,</para>
  <para style="q" vid="AMO 8:9">tingna tingnaimiak nlüt di kera Ih tei dizie,</para>
  <para style="q" vid="AMO 8:9">nah kebaa ting dau kideube Ih tei mui dizie.<note caller="+" style="f"><char style="fr" closed="false">8:9 </char><char style="ft" closed="false">Mat. 27:45, Mrk 15:33, Luk 23:44-45</char></note><verse eid="AMO 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 8:10" />Ih nnui hengyidung kedi pwa suisiet tei dizie</para>
  <para style="q" vid="AMO 8:10">nah nnui leidung leune lungrei kwa ge dizie.</para>
  <para style="q" vid="AMO 8:10">Ih nnui pelane de teipwa peu roso pai bah zie</para>
  <para style="q" vid="AMO 8:10">nah pelane peu kwak dizie.</para>
  <para style="q" vid="AMO 8:10">Pena pumlibe ziemne hei eh hap kecu nzwa Ih tei dizie,</para>
  <para style="q" vid="AMO 8:10">nah cipau penli tingba benai au kekaa ge zie.<verse eid="AMO 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 8:11" />Pielo, petingbadung gwang zeu,</para>
  <para style="q" vid="AMO 8:11">RAMPAUBE Tinggwang ne aide ndugai,</para>
  <para style="q" vid="AMO 8:11">Ih herakum kideu gage langgai zie,</para>
  <para style="q" vid="AMO 8:11">tangku ziemne herakum ma,</para>
  <para style="q" vid="AMO 8:11">mede dui kehereu ziemne ma,</para>
  <para style="q" vid="AMO 8:11">dede RAMPAUBE samdung kingnei kera ziemne.<verse eid="AMO 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 8:12" />Penui tet jaaidi ge gade jaaidi gega gwang,</para>
  <para style="q" vid="AMO 8:12">penui tingtünle de naimiak kepetle ge pak gai</para>
  <para style="q" vid="AMO 8:12">RAMPAUBE sam peei eh,</para>
  <para style="q" vid="AMO 8:12">dede penui cide peei gailak.<verse eid="AMO 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 8:13" />Cipaunai hezukeyi relei kemci puidung</para>
  <para style="q" vid="AMO 8:13">nah rehangmena hereu eh nnei dizie.<verse eid="AMO 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 8:14" />Samaria ga Ashimah rabepui maudung zi teu samkak kelame</para>
  <para style="q" vid="AMO 8:14">nah, ‘N tinggwang ring kela nzwa, Dan,’</para>
  <para style="q" vid="AMO 8:14">nah ‘Beersheba lampui bam kela nzwa’ de eh rang kelame,</para>
  <para style="q" vid="AMO 8:14">penui kau dizie nah cuh dai gai lak dizie.”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s">Israel de Ngkapdi kera</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />Ih Rampaube de marengei ge gade ngau, recabam taiga sap kebam, nah pa aja kaigai, “Sum tsia peudung gage dapsüt gai iciu de pesing nlai di kerane.</para>
  <para style="q" vid="AMO 9:1">Cidungde kedeu takcai gai eh peu minadung peu ga cak mielu,</para>
  <para style="q" vid="AMO 9:1">nah penui pelane de Ih kingtie le gi tset dizie.</para>
  <para style="q" vid="AMO 9:1">Penui migede pak tetdi gai lak,</para>
  <para style="q" vid="AMO 9:1">penui migede mzia di gai lak.<note caller="-" style="x"><char style="xo" closed="false">9:1 </char><char style="xt" closed="false"><ref loc="PSA 68:21">Lei. 68:21</ref></char></note><verse eid="AMO 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 9:2" />Penui ketsaime deuga kuimie liede,</para>
  <para style="q" vid="AMO 9:2">cika de a ba le penuide tui luzie.</para>
  <para style="q" vid="AMO 9:2">Penui Tinggim mrahang liede,</para>
  <para style="q" vid="AMO 9:2">cika de Ih penuide teu nghung dizie.<verse eid="AMO 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 9:3" />Penui Carmel deutu ga mbai liede,</para>
  <para style="q" vid="AMO 9:3">cika de Ih penuide peei lwe tui luzie.</para>
  <para style="q" vid="AMO 9:3">Penui a miak dwa gade dui kedi sing ga mbai liede,</para>
  <para style="q" vid="AMO 9:3">cika de Ih henei dage aja peu zie, nah cide ne penuide nsau zie.<verse eid="AMO 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 9:4" />Penui hebaang tei di liede, penui ngauraume ne penuide tui tetdi liede,</para>
  <para style="q" vid="AMO 9:4">cikade Ih kingtie dage aja kai zie, nah cide le penuide gitset dizie.</para>
  <para style="q" vid="AMO 9:4">Ih a miak penui dage kai pwa bam zie penuide peu keherei kerane nah keyi ziemne ma.”<verse eid="AMO 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 9:5" />Reugwame reu RAMPAUBE Tinggwang</para>
  <para style="q" vid="AMO 9:5">kideu tung gai nah cide sui dizie;</para>
  <para style="q" vid="AMO 9:5">cika lungh kebam leune hei eh hap dizie;</para>
  <para style="q" vid="AMO 9:5">ci pelane hereuki nzwa cuh hang zie,</para>
  <para style="q" vid="AMO 9:5">nah Egypt reuki nzwa cip mie dai zie.<verse eid="AMO 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 9:6" />Tinggim ga takswa tei kelube cide au pa delei,</para>
  <para style="q" vid="AMO 9:6">nah kideu reu gage pa pe ting bang teilu.</para>
  <para style="q" vid="AMO 9:6">Pa dui kedi gu duidung qugai la,</para>
  <para style="q" vid="AMO 9:6">nah kideu zu gage penuide rui mpet kai la, pe zi au RAMPAUBE.<verse eid="AMO 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 9:7" />“Nnui a dwa de Cush deudi mena nzwa meni,</para>
  <para style="q" vid="AMO 9:7">Israelmedung,</para>
  <para style="q" vid="AMO 9:7">RAMPAUBE ne aide ndugai,</para>
  <para style="q" vid="AMO 9:7">Ih Egyptme deu gade Israel de ngngwa mpet meni,</para>
  <para style="q" vid="AMO 9:7">Crete gade Philistinme,</para>
  <para style="q" vid="AMO 9:7">nah Kir gade Arameanme de?<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false">Ethiopia deudi ga minadung</char></note><verse eid="AMO 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 9:8" />Pielo, RAMPAUBE Tinggwang au kemau puipung kebam hegwangram ga pe miak kai pwa bam dida,</para>
  <para style="q" vid="AMO 9:8">nah Ih kideube zu gade cide ngkap dizie,</para>
  <para style="q" vid="AMO 9:8">Ih Jacob leuhme pelane de tei ngkap dilak,</para>
  <para style="q" vid="AMO 9:8">RAMPAUBE ne aide ndugai.<verse eid="AMO 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 9:9" />Pielo, Ih aja ge kai zie,</para>
  <para style="q" vid="AMO 9:9">nah Ih heleuh pelane kakgade Israel leuhme de teu kecui gai zie,</para>
  <para style="q" vid="AMO 9:9">mige nrei gage tsiu kehelia nzwa,</para>
  <para style="q" vid="AMO 9:9">ciciu eh tangtsu ceutu nabe de hangdeu ga cak mie lak.<verse eid="AMO 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 9:10" />A minadung kemaume leune kingtie gade tsai zie,</para>
  <para style="q" vid="AMO 9:10">‘Kengkap anui reu ga gwang lak mede redau lak’, de rang kelame.<verse eid="AMO 9:10" /></para>
  <para style="s">Israel de Teuncudaikelu</para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 9:11" />Cipau nai Ih David hegwangram kaukedi paiki de teucuh luzie,</para>
  <para style="q" vid="AMO 9:11">nah cide pang kebam de lamlui dizie,</para>
  <para style="q" vid="AMO 9:11">kau kedi cide Ih teu cuh lu zie,</para>
  <para style="q" vid="AMO 9:11">nah cide retak lwe ndaa tingba dung de nzwa lu zie.<verse eid="AMO 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 9:12" />Penui Edom ga bang kenzeu de luu luzie,</para>
  <para style="q" vid="AMO 9:12">nah a zi gade qu kelu heleuh pelane,</para>
  <para style="q" vid="AMO 9:12">RAMPAUBE ne aide ndugai, pa aide tei gai.<note caller="-" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="ACT 15:16-18">Bat. 15:16-18</ref></char></note><verse eid="AMO 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 9:13" />Pielo, petingbadung gwang zie, RAMPAUBE ne aide ndugai,</para>
  <para style="q" vid="AMO 9:13">kepuhme ne kerumme de pakkah kedidau,</para>
  <para style="q" vid="AMO 9:13">nah kubetsi tei kelame pebang leuh tei kelame de pakkah dizie.</para>
  <para style="q" vid="AMO 9:13">Lamlwatudung zaukum zau beuzie,</para>
  <para style="q" vid="AMO 9:13">nah hangdeutudung pelane cide lwa ncüt zie.<verse eid="AMO 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 9:14" />Ih a mina Israelme mibaang tei kela gade teu cailigwang dai luzie,</para>
  <para style="q" vid="AMO 9:14">kau kedi namdidung de penui retak dai luzie nah cika lungh zie,</para>
  <para style="q" vid="AMO 9:14">penui kube bangdung ling luzie nah pezau sak zie,</para>
  <para style="q" vid="AMO 9:14">nah penui hegurie tei zie nah petsi tyei zie.<verse eid="AMO 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 9:15" />Ih penui gu kideu reu gage penuide linggai zie,</para>
  <para style="q" vid="AMO 9:15">nah penuide madaude kideu gade paidai dilak,</para>
  <para style="q" vid="AMO 9:15">Ih penuide peu kedi de,”</para>
  <para style="q" vid="AMO 9:15">RAMPAUBE nnui Tinggwang ne ranggai.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>