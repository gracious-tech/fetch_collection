<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Zeme(N) Bible Project</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Nahum</para>
  <para style="toc1">Nahum Laisiukwak</para>
  <para style="toc2">Nahum</para>
  <para style="toc3">Nah.</para>
  <para style="mt">Nahum</para>
  <para style="mt">Nahum Laisiukwak</para>
  <para style="is">Mraisam</para>
  <para style="ip">Nahum au century kekamle dau caihakecime ge. Pa au Zephaniah, Jeremiah nah Habakkuk penui tingdau caiha rang.</para>
  <para style="ip">Nahum laisiukwak au Assyriame namdi Nineveh de kemmau caiha. Assyriame zaisiet teu eh heleuh ketsai ket de gwakelu caiha ranggai. Pa Nineveh de gwa nah kengkap ha ranggai nah Assyria gwangram penli tei di kera.</para>
  <para style="ip">Nahum au Judah de ledeu kegai rünne cide penuide renet ngyidung mnei lulo kecude, Assyriame madaude Jerusalem de keheu dailak kecune.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Rampaube rata Nineveh de kemmau (1:1-15)</para>
  <para style="io1">Nineveh kaudi kera (2:1-13)</para>
  <para style="io1">Nineveh lungrei (3:1-19)</para>
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="s">Rampaube Rata Nineveh de Kemmau</para>
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />Nineveh ha ndu kegai. Elkosh nam gade kegwang Nahum dage marengei keu kelia laisiukwak.<verse eid="NAM 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 1:2" />RAMPAUBE au lungriak nah hekum kepeei Tinggwang.</para>
  <para style="q" vid="NAM 1:2">RAMPAUBE au ratakesia teu hekum peei la nah pe ngauraume da pe rata bammui la la.<verse eid="NAM 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 1:3" />RAMPAUBE au pe rata zette lama, nah pe kengkieng au disüt; Pa madaude kemaume de saja peu mene tadi lama,</para>
  <para style="q" vid="NAM 1:3">RAMPAUBE tet kemie ga rahang kaigui guinri nah hemwadung au pe pi le tei ngka kegai rebui da.<verse eid="NAM 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 1:4" />Pa jaaidi de kesiu gaila nah cide tei cangh dila; pa hereukidung pelane tei cangh dila.</para>
  <para style="q" vid="NAM 1:4">Bashan ki dila, nah Carmel lamlwatu lie de; Lebanon mapadung ki dila.<verse eid="NAM 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 1:5" />Tinggwang dwa gade lamlwatudung nlai dila, nah kideutudung sui dila;</para>
  <para style="q" vid="NAM 1:5">kideu mbeu dila, nah pe minadung ngkap dila.<verse eid="NAM 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 1:6" />Pe lunghop dwaga caune sap lulai? Cau pe lunghop de mbai lulai?</para>
  <para style="q" vid="NAM 1:6">Pa perata miheu nzwa ruigai la, pe dwa gade tsuradung pangpop dila.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="REV 6:17">Keu. 6:17</ref></char></note><verse eid="NAM 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 1:7" />Rampaube au yi, keherei tingdau minadung de gum beula; nah pa peda nreu kegwangme ma piela.<verse eid="NAM 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 1:8" />Dede pa duidiet cisüt kecu nzwa pe ngauraume de ngkapzing dila; pa penuide kemui gage kai dila.<verse eid="NAM 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 1:9" />Nnui RAMPAUBE de mmau eh daipai ciem pei lano?</para>
  <para style="q" vid="NAM 1:9">Pa nnuide ngkap dizie, keherei pia pe kenabe cuh silak.<verse eid="NAM 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 1:10" />Pe ngauraume hetu kerepi pwa kebam bedung nzwa dizie; nah penui penui zau le sak mie kelame nzwa dizie;</para>
  <para style="q" vid="NAM 1:10">penuide reigau ki kedi be nzwa ru dizie.<verse eid="NAM 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="NAM 1:11" />Nineveh nda de mige kenliem ciemle puiting eh petlu, pa RAMPAUBE de mmau eh heciem riem, pa makesia teu ncuh beu kelame ge.<verse eid="NAM 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="NAM 1:12" />RAMPAUBE pe minadung Israelme dage ranggai kecu, “Penui ngkieng nah kieesüt lie de, iciu liede penuide ngkap dizie;</para>
  <para style="q" vid="NAM 1:12">nah penui Assyriame gah dizie. Ih nnuide teikeherei di liede, dede Ih nnuide tei keherei dai si lakta.<verse eid="NAM 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="NAM 1:13" />Assyriame kengking de Ih cu penui ngwanggai de nnui dade lwak dizie da, nah nnuide kangpwa kebam riadungde teicak dizie da.”<verse eid="NAM 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="NAM 1:14" />N ziemne RAMPAUBE aja ge kaibeu, Nineveh:</para>
  <para style="q" vid="NAM 1:14">“Penui zi teu ndwa la kera penui leuh lunglak,</para>
  <para style="q" vid="NAM 1:14">Ih penui rabedung mie kerecakidung ga kebamdung de ngkap dizie.</para>
  <para style="q" vid="NAM 1:14">Ih penui ziemne herau kui luzie, penui ringla lu dui kedi ne.”<verse eid="NAM 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="NAM 1:15" />Pielo, samlia keyi teu eh lamlwatudung reuga gwang la, Pa ngngwakeyi reci gaibeu!</para>
  <para style="q" vid="NAM 1:15">O Judah, nnui hengyidung hengyi lu delwe nnui sampet de kai zeulu,</para>
  <para style="q" vid="NAM 1:15">kedanemene kenlienme madau de nnui deu gwalüt dailak ta; penuide ngkapzing dida. <note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">Bata 10:36, Rom. 10:15, Eph. 6:15</char></note><verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="s">Nineveh Kaudi kera</para>
  <para style="q">
    <verse number="1" style="v" sid="NAM 2:1" />Ncu tei zangra gai di kerabe ncu renia cuh lada.</para>
  <para style="q" vid="NAM 2:1">Namdi kiriedung kwalu, lampuidung kwalu,</para>
  <para style="q" vid="NAM 2:1">reutak ziemne mteilu, n kengkieng pelane mteilu.<verse eid="NAM 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 2:2" />RAMPAUBE au Israel kendu nzwa eh Jacob kendu peu dai zie,</para>
  <para style="q" vid="NAM 2:2">süt ketyeime penuide tei ngkap di liede nah penui kubebang kiakdung tei ngkap di liede.<verse eid="NAM 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 2:3" />Ngauraume reugwa kengkiengme hegeu kegiedung pungla, nah kegie paini kenzwabedung teula;</para>
  <para style="q" vid="NAM 2:3">bagidung penui hegeu niadung penui mtei kelu benai kepik di, nah cypress ngeidung keu kezip rwa di.<verse eid="NAM 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 2:4" />Bagidung puidi kiga pak pesuira tei; penui namdi sum ga pak nlüt mpet.</para>
  <para style="q" vid="NAM 2:4">Penuide ngau kegai helei nzwa, nah tingkehepik nzwa pak bam.<verse eid="NAM 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 2:5" />Pa kedimedung de qugai; penui tetpet ge penui pi nsui gai eh kau mie;</para>
  <para style="q" vid="NAM 2:5">penui nzet namdi kirie be ga gwaketang, delwe kensiu hegeu kedi ge mtei luda.<verse eid="NAM 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 2:6" />Hereukidung tai ga heriekidung telai ngkei gai nah hegwang kidung sui tet dida.<verse eid="NAM 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 2:7" />Hezai ga rau pwabam dida: Hegwangpui de hebaang tei dida;</para>
  <para style="q" vid="NAM 2:7">pe kilame tamhaudung nzwa mradi, nah penui sui sia eh penui hekakrak kepeudi.<verse eid="NAM 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 2:8" />Nineveh rejaai ge nzwa bam la, dede cu au pe minadung dui lwa kebam nzwa pak bam dida.</para>
  <para style="q" vid="NAM 2:8">Mi kedame sa gai, “Mtaklu, Mtaklu,” dede migede cainok tadi.<verse eid="NAM 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 2:9" />Rangkanggeu sütlu, kecakde tuilu, maheile pui penli kegah tei ma,</para>
  <para style="q" vid="NAM 2:9">namdi cika mahei le kepui teibam luu keneu leu.<verse eid="NAM 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 2:10" />Nineveh mrwa dida, pecu gidi da, nah ngkap dida. Mlungdung ngnyi eh sui bam dida, ngkokpuidung mbeudi da,</para>
  <para style="q" vid="NAM 2:10">nah kengkieng gada; penui zudung ham hui dida.<verse eid="NAM 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="NAM 2:11" />Cu daiga hinghodung bam bamno, hingho nadung pok ketei ni de,</para>
  <para style="q" vid="NAM 2:11">cika hinghoseu nah hinghopuidung mie kelade, nah penui name de peu made hing mene bamlu kelade.<verse eid="NAM 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="NAM 2:12" />Hingho makaune de tuilu delwe cide hinghopui</para>
  <para style="q" vid="NAM 2:12">nah pena me ziemne teurak kecai lu, pa heteei teurak takcai kelu le pekui tei puilu.<verse eid="NAM 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="NAM 2:13" />Rampaube rangla, “Ih nnui ngaurau be da,</para>
  <para style="q" vid="NAM 2:13">Ih nnui bagidung ru mika ge dizie nah kiengtie ge ne hingho nadung de gitset dizie,</para>
  <para style="q" vid="NAM 2:13">Ih nnui deu gade taktyei pok nnuide peu si lakta, nah nnui kie kegai samgwame kwa de kingnei silak ta.”<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="s">Nineveh da Kenggi</para>
  <para style="q">
    <verse number="1" style="v" sid="NAM 3:1" />Co, Nineveh namdi ga hejai pui kebam!</para>
  <para style="q" vid="NAM 3:1">Cika kenret nah kerega nia le puiting bam; Cika kesia ketei mtak lama.<verse eid="NAM 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 3:2" />Dede cu au heria kehebiet kwadung nah garitadung kwa,</para>
  <para style="q" vid="NAM 3:2">hekwen kepak kwa, bagidung ketet kwa.<verse eid="NAM 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 3:3" />Hekwen keteume regi kera pakpet,</para>
  <para style="q" vid="NAM 3:3">kingtiedung kelik kecu, hengeidung mzai kecu,</para>
  <para style="q" vid="NAM 3:3">kekiee ge de teitsetti da, ketsai pau keswa hu lu da.</para>
  <para style="q" vid="NAM 3:3">Ketsaipau pei kap kai kelak bam; penuide gwang ketang cume ketsaipau reu ga kaumie.<verse eid="NAM 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 3:4" />Aide tei kebam de au hezukeyi helipuidung, cidungde kehemeu tah ketei ga kedibe pui, penuide teu helila ketei kekiee ge bam kedine,</para>
  <para style="q" vid="NAM 3:4">pa heleuhdung de pe helipui ta le zwa dila, nah minadung de pe kehemeu ta le.<verse eid="NAM 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 3:5" />“Pielo, Ih ncu mmau la, aide reugwame reu RAMPAUBE ne ndugai, Ih ncu gau paula dizie</para>
  <para style="q" vid="NAM 3:5">nah peu heleuhdung de nang paula bam kecu peu ngau zie, hegwangram pelane ga n ngngam ngau zie.<verse eid="NAM 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 3:6" />Ih n dage kehera kemneeu bedung le pwa beu gai zie nah peu ncu nneu zie; Ih peu minadung de ncu pie zie.<verse eid="NAM 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 3:7" />Ncu kengau leu ne caisim dizie, penui rang eh</para>
  <para style="q" vid="NAM 3:7">‘Nineveh ngkap dida; cau pe ziemne hei eh hap lai no?’</para>
  <para style="q" vid="NAM 3:7">Cau pecu kemak neu la no?”<verse eid="NAM 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 3:8" />Nang Nile reuki ga tei pwa kebam Thebes namdi swa yiki ni, petaiga dui twagwa kebam,</para>
  <para style="q" vid="NAM 3:8">jaaidi de pe kekwabe, pe kirie au jaaidi deda?<verse eid="NAM 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 3:9" />Cush nah Egypt au pe kengkieng, nah pe kengkieng penli gah;</para>
  <para style="q" vid="NAM 3:9">Put nah Libya namdi pe zangnabe da.<verse eid="NAM 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 3:10" />Dede Thebes de pung tetti; pecu tuilu;</para>
  <para style="q" vid="NAM 3:10">puidiki leune ga pe name de daptsetti;</para>
  <para style="q" vid="NAM 3:10">pe ngauraume pe mipeidung de luu kera dacak tei,</para>
  <para style="q" vid="NAM 3:10">nah pe mipei kengkieng leu de hegeuria le kangdi.<verse eid="NAM 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="NAM 3:11" />Nineveh nang de zausakme ge tei zie; nang mbai kera tei zie,</para>
  <para style="q" vid="NAM 3:11">nah nang n ngauraume dade mbai lu kera tei cu zieda.<verse eid="NAM 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="NAM 3:12" />Nnui reneidung nzüttsi meu keraibe nzütbangdung nzwa zie:</para>
  <para style="q" vid="NAM 3:12">pebang kecui gai de petsi nnui mui ga cak lüt gapte zie.<verse eid="NAM 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="NAM 3:13" />Pielo, nnui kakga minadung au mnei;</para>
  <para style="q" vid="NAM 3:13">ngauraume ziemne ndeu kiriedung ngkei nzaha pwa bam,</para>
  <para style="q" vid="NAM 3:13">mapakdung de mi ne ru dizie.<verse eid="NAM 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="NAM 3:14" />Mie delwe gwaketang kera ziemne dui pwa lwe mteilu; nah nnui kudadung tei ntiplu;</para>
  <para style="q" vid="NAM 3:14">tangdeitsu tei kera lidei keniaklu;</para>
  <para style="q" vid="NAM 3:14">delwe tangdeitsudung teilu.<verse eid="NAM 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="NAM 3:15" />Mi ne nuide ru dizie, nah kiengtie ne nnuide dang di zie. Tangriem ne maleune tyei ngga di kela nzwa nnuide tyei ngga dizie.</para>
  <para style="q" vid="NAM 3:15">Bwa kela tangriemdung nzwa nah tangriem maadi nlai kela maa nzwa nnui katei nnuide tei nkiee lu.<verse eid="NAM 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="NAM 3:16" />Nnui heliketeime tinggimdung ga hegidung swa de kiee eh tei luda; dede penui au tangriemdung nzwa: penui hesiu mzang mpet la nah pecai lim tet dila.<verse eid="NAM 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="NAM 3:17" />Nnui hegwangmedung au tangriemdung nzwa da, nah reugwame kedidung au tangriem hau nzwa da</para>
  <para style="q" vid="NAM 3:17">tingkengkung benai tangdeu ga taubam dila.</para>
  <para style="q" vid="NAM 3:17">Dede tingnaimiak pet ge penui lim tet dila nah migede penui dai ga mie di bi ci lama.<verse eid="NAM 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="NAM 3:18" />Assyria gwangpei, n meurün kekwamedung zip dida; ngu mina keyi medung zeu mtak dida.</para>
  <para style="q" vid="NAM 3:18">N minadung de hangdeutudung gage teizang dida nah penuide migede kilung ga ngngwa gwang dai kera gahdi.<verse eid="NAM 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="NAM 3:19" />N rezamdung de tei mmi gai lak ta. N rezamdung de teeisüt dida.</para>
  <para style="q" vid="NAM 3:19">Keheibe de ngkap kedi n ha kesiu leune penui suiyi eh nreu gage bapeu gai zie.</para>
  <para style="q" vid="NAM 3:19">Kedanemene penli kegah n bata kesiadung de cau dage gwang meno tadi no?<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>