<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAG" style="id">- Zeme(N) Bible Project</book>
  <para style="ide">UTF-8</para>
  <para style="h">Haggai</para>
  <para style="toc1">Haggai Laisiukwak</para>
  <para style="toc2">Haggai</para>
  <para style="toc3">Hag.</para>
  <para style="mt">Haggai</para>
  <para style="mt">Haggai Laisiukwak</para>
  <para style="is">Mraisam</para>
  <para style="ip">Cyrus 538 BC bekum aja kai eh Jewme de peu hebaangtei kela gade Jerusalem ga cailigwang kera mmi heset di. Minadung Tinggwang kerecakibe teicang lu mene bamreu.</para>
  <para style="ip">Haggai samlia au Rampaube ki tei kera ting di delie ranggai. Zerubbabel penai Joshua muiteu gade nah Haggai sam gade 520-515 BC dau kerecaki teidai lu.</para>
  <para style="ip">Haggai minadung dage ndaa kerecaki keraide kendu swade penui teilai kebam kerecaki de au diki zie lie ranggai, pie kegai au kerecaki aide be ceuki liede. Kerecaki aide au diki zie kedanemene ki aide Tinggwang pe kendule teipui luzie kecune.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Kerecaki teidai kera qu kegai (1:1-15)</para>
  <para style="io1">Kerecaki keheci de ziemne keregui (2:1-9)</para>
  <para style="io1">Samlam petkebeudung</para>
  <para style="io1">Tinggwang kekamle ngkiengkelu</para>
  <chapter number="1" style="c" sid="HAG 1" />
  <para style="s">Rampaube Ki Teikera Qukegai</para>
  <para style="p">
    <verse number="1" style="v" sid="HAG 1:1" />Darius Persia ga hegwang mmi kena bekum, kei herok bekei, hekei raitu benai, RAMPAUBE caihakecibe Haggai dade Judah deuceudi Shealtiel napei Zerubbabel nah cingku kedibe Jehozadak napei Joshua dage ranggai, <verse eid="HAG 1:1" /><verse number="2" style="v" sid="HAG 1:2" />“Reugwame reu RAMPAUBE ainzwa ranggai: Mina aidungde ainzwa rang, ‘Anui gwang kera mede RAMPAUBE ki tei kera ting mereu.’” <verse eid="HAG 1:2" /><verse number="3" style="v" sid="HAG 1:3" />Ciciu eh caihakecibe Haggai dage RAMPAUBE sam ranggai,<verse eid="HAG 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAG 1:4" />“Nnuikatei ki tei kelu ga nnui lungh bam eh,</para>
  <para style="q" vid="HAG 1:4">kerecaki aide peu kauzeu bam zieni?<verse eid="HAG 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HAG 1:5" />Cine cu reugwame reu RAMPAUBE sam aide ranggai:</para>
  <para style="q" vid="HAG 1:5">Nnui dainzwa lungh labi ci lulo!<verse eid="HAG 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAG 1:6" />Nnui heleuh kekiee ge linggai, dede kecam nage luhlüt lu; nnui tyei dede nggei luma;</para>
  <para style="q" vid="HAG 1:6">nnui sak dede sakmie luma. Nnui painia teu dede nnuide teilum luma,</para>
  <para style="q" vid="HAG 1:6">nah mahi ketyeime penui mangau de penui hebiena ketip gage kekai nzwa!”<verse eid="HAG 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HAG 1:7" />Reugwame reu RAMPAUBE ainzwa ranggai:</para>
  <para style="q" vid="HAG 1:7">“Nnui dainzwa lung labi cilu lo!<verse eid="HAG 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAG 1:8" />Lamlwa ga mie tsing pwa gwang a kerecaki teilu;</para>
  <para style="q" vid="HAG 1:8">ciu lucai Ih a suiyi ngau luzie, nah a zi ndu luzie, RAMPAUBE ainzwa ranggai.”<verse eid="HAG 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HAG 1:9" />“Nnui ngau kielu kera peei, dede pielo! kecam nage gwale nnui kilung teu gwang luma, Ih cidung teizang kedine!</para>
  <para style="q" vid="HAG 1:9">Dai ziemne no?” Reugwame reu RAMPAUBE penuide peu cigai.</para>
  <para style="q" vid="HAG 1:9">“Kedanemene kerecaki be sia bam dida, cinzwa eh pelane nnui kilung ziemne nnui ta tei la dida.<verse eid="HAG 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HAG 1:10" />Kedanemene tinggimdung gade nnui ziemne hezin peu kelade mtak dida, nah kideu gade ngaulu keladung ngkui dida.<verse eid="HAG 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HAG 1:11" />Kideu ga nah lamlwatudung, meitsi ga</para>
  <para style="q" vid="HAG 1:11">nah zau keheci, maca nah kideu ga lulwet cang dizie,</para>
  <para style="q" vid="HAG 1:11">mina da nah makaunedung, nah nnui tei kegai dung reu kecang langgai dida!”<verse eid="HAG 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HAG 1:12" />Pecai Shealtiel napei Zerubbabel, nah Jehozadak napei cingku kedibe Joshua, langgi kedi gade cailigwang kelume, RAMPAUBE penui Tinggwang samdung nah caihakecibe Haggai samzai teilu, kedanemene RAMPAUBE penui Tinggwang ne pecu langgai nah minadung RAMPAUBE de kehing penui da bam di. <verse eid="HAG 1:12" /><verse number="13" style="v" sid="HAG 1:13" />Pecai Haggai, RAMPAUBE sam paukelabe minadung dage RAMPAUBE sam pau nah ranggai, “Ih nnuide ngngwa la!, aide RAMPAUBE rang ndu kegai!”<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="MAT 28:20">Mat. 28:20</ref></char></note> <verse eid="HAG 1:13" /><verse number="14" style="v" sid="HAG 1:14" />Cine deuceudi Judah, Shealtiel napei Zerubbabel nah cingku kedibe Jehozadak napei Joshua nah cailigwang kelu medung, rabe ne penui lung tei beu eh reugwame reu RAMPAUBE penui Tinggwang kerecaki ga heta tei bam di <verse eid="HAG 1:14" /><verse number="15" style="v" sid="HAG 1:15" />aide Darius hegwang mmi pekena bekum kei herok zie ngkai-mdai benai.<verse eid="HAG 1:15" /></para>
  <chapter eid="HAG 1" />
  <chapter number="2" style="c" sid="HAG 2" />
  <para style="s">Ki Keheci Kendu Sampet kebeu</para>
  <para style="p">
    <verse number="1" style="v" sid="HAG 2:1" />Kei hena bekei zie ngkai-ket benai, RAMPAUBE sam Haggai caihasam kecibe da ranggai, <verse eid="HAG 2:1" /><verse number="2" style="v" sid="HAG 2:2" />“Judah deuceudi Shealtiel napei Zerubbabel, nah Jehozadak napei Joshua cingku kedibe, nah mina bang kebamme dage sam aide rang lo beu.<verse eid="HAG 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="HAG 2:3" />Nnui kak ga caudung ge</para>
  <para style="q" vid="HAG 2:3">kerecaki ndaa nzwa pekeyi kebam ngau no?</para>
  <para style="q" vid="HAG 2:3">Cu cide nnui dainzwa ngau bam no?</para>
  <para style="q" vid="HAG 2:3">Cide nnui miak gade magede kemak nzwa dide meni?<verse eid="HAG 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="HAG 2:4" />Cu au kuu lu Zerubbabel!, aide RAMPAUBE rang ndu kegai,</para>
  <para style="q" vid="HAG 2:4">nah kuu lu, Jehozadak napei cingku kedibe Joshua;</para>
  <para style="q" vid="HAG 2:4">nah kuu lu, kideu cika kelungh leune!, aide RAMPAUBE rang ndu kegai,</para>
  <para style="q" vid="HAG 2:4">nah nnui ta teilu, kedanemene Ih nnuide ngngwa la!, reugwame reu RAMPAUBE aide rang ndu kegai.<verse eid="HAG 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HAG 2:5" />Nnui Egypt gade mpet kelu dau nnuide ngngwa samkak aide tei luda,</para>
  <para style="q" vid="HAG 2:5">nah a rabe nnuide ngngwa la. Nnui ngngi diso!<verse eid="HAG 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HAG 2:6" />Kedanemene reugwame reu RAMPAUBE ainzwa ranggai: Tie kemakne</para>
  <para style="q" vid="HAG 2:6">Ih ting kideu, jaaidi hangdeu kecang dung tei kelai gai dai zie!<verse eid="HAG 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HAG 2:7" />Ih heleuh leune tei kelai gai zie, nah kideu pelane acu ma pemi kehung pwa peuzie,</para>
  <para style="q" vid="HAG 2:7">nah reca ki de kendu le tei pui lu zie de reugwame reu RAMPAUBE rang ndu kegai.<verse eid="HAG 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HAG 2:8" />Rangkanggeu nah kecak dung au agu!, reugwame reu RAMPAUBE rang ndu kegai.<verse eid="HAG 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HAG 2:9" />Kerecaki kendu de kerai dau swa paucai be di gwa dizie, de reugwame reu RAMPAUBE rang ndu kegai,</para>
  <para style="q" vid="HAG 2:9">nah heni aide ga Ih lungciep teu gwang beuzie!, aide reugwame reu RAMPAUBE rang ndu kegai.”<verse eid="HAG 2:9" /></para>
  <para style="s">Herakedi Minadung ziemne Samlam</para>
  <para style="p">
    <verse number="10" style="v" sid="HAG 2:10" />Darius tingdau mmi pekena bekum kei hekui bekei zie ngkai eh mdai benai, RAMPAUBE sam caihasam kecibe Haggai da ranggai, <verse eid="HAG 2:10" /><verse number="11" style="v" sid="HAG 2:11" />“Reugwame reu RAMPAUBE ainzwa ranggai: Hezai ziemne cingkumedung dade keteu nah ranglo, <verse eid="HAG 2:11" /><verse number="12" style="v" sid="HAG 2:12" />‘Magade mige RAMPAUBE dage heteih pwa reca peu kera de pe pai gage dum teu la cai, nah pedum cide tangku, zau mede maca, mede taktyeipok kehei gede teu ncüt dicai, cidung mci dizie ni?’” cingkumedung samkeligai “Ma” de ranggai. <verse eid="HAG 2:12" /><verse number="13" style="v" sid="HAG 2:13" />Pecai Haggai rangdi, “Magade mige ketsai pau tung kedi ziemne hera di eh keda dung tung dicai, cidung hera di zie ni?” Cingkumedung rangdi, “Yeo, cidung de hera dizie.” <verse eid="HAG 2:13" /><verse number="14" style="v" sid="HAG 2:14" />Cine Haggai ranggai, “Cinzwa eh a dwaga kebam mina aidung nah heleuh aidung de cikenzwa medung da!, aide RAMPAUBE rang ndu kegai, penui heta aidung pelane tei gai. Penui acu peu kegai dung au hera! <verse eid="HAG 2:14" /><verse number="15" style="v" sid="HAG 2:15" />Ndaa ting gade cu kecang nnui mapie kebeu cu au nnui lung ga nsung lulo. Ndaa au tangtsu ge reu gage tangtsu ge RAMPAUBE kereca ki gage kai pwa bam la. <verse eid="HAG 2:15" /><verse number="16" style="v" sid="HAG 2:16" />Cine dainzwa no? Mei tum ngkai<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">kilogram 200 </char></note> kebam de nang mie pie kecudau, cika tum kerei<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">kilogram 100 </char></note> gwale ga; nah nang zaula riakngei ge<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">litre 100 </char></note> pwa kera ziemne mie, dede cika ngkai rünne gwale gah. <verse eid="HAG 2:16" /><verse number="17" style="v" sid="HAG 2:17" />Nnui tei kegai leune rwa dida nah Ih nnuide tei keherei gai, ciciu gai liede nnui a da cailigwang luma, aide reugwame reu RAMPAUBE rang ndu kegai. <verse eid="HAG 2:17" /><verse number="18" style="v" sid="HAG 2:18" />Henai tingba gade nsung lulo, kei hekui zie ngkai-mdai benai, aipau nai gade RAMPAUBE kerecaki pe bangdwa kelu nsung la lulo! <verse eid="HAG 2:18" /><verse number="19" style="v" sid="HAG 2:19" />Kehekwa bam ga heleuhdung bamreu ni? kubebang, nzüttsi bang, kuraletsi, nah olive bang petsi bui beu meda! Dede henai gade Ih nnuide samlam beuzie!”<verse eid="HAG 2:19" /></para>
  <para style="s">Zerubbabel Rampaube gu Bakap</para>
  <para style="p">
    <verse number="20" style="v" sid="HAG 2:20" />Pecai RAMPAUBE sam pekenabe hekei zie ngkai-mdai benai Haggai dage ranggai, <verse eid="HAG 2:20" /><verse number="21" style="v" sid="HAG 2:21" />“Judah ga deuceudi, Zerubbabel da sam aide rang beulo,</para>
  <para style="q" vid="HAG 2:21">‘Ih tinggimdung nah hangdeu teu kelai dizie.<verse eid="HAG 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="HAG 2:22" />Kedanemene Ih hegwangbam tei ngkap dizie nah heleuh leune hegwangram kengkieng dung keugi dizie!</para>
  <para style="q" vid="HAG 2:22">Ih bagidung nah teu kelame de ngkap dizie; hekwendung nah cwa kela medung de teikau dizie, penui ketket de penui siname kiengtie ziemne gi dizie.<verse eid="HAG 2:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="HAG 2:23" />Kengkieng RAMPAUBE sampet aide peu gaila, Cipaunai Shealtiel napei Zerubbabel a gwa tei kera Ih ncu kedet luzie, aide RAMPAUBE ne rang ndu kegai.</para>
  <para style="q" vid="HAG 2:23">Ih ncu kengkieng peu zie, kedanemene Ih ncu kedet kelune!</para>
  <para style="q" vid="HAG 2:23">aide reugwame reu RAMPAUBE rang ndu kegai!’”<verse eid="HAG 2:23" /></para>
  <chapter eid="HAG 2" />
</usx>