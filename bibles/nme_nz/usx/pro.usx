<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Zeme(N) Bible Project</book>
  <para style="toc3">Mac.</para>
  <para style="toc2">Macisam</para>
  <para style="toc1">Macisam Laisiukwak</para>
  <para style="mt">Proverbs</para>
  <para style="mt">Macisamdung Laisiukwak</para>
  <para style="is">Mraisam</para>
  <para style="ip">Macisam au makeci samdung nah tingba ramsang teu lungh kera keledeusam keyibedung laisiukwak “Rampaube mie kehing au kecikecet bangdwa” lie eh delu. Pesam keraibe mdaide maci kemlang ha reki kegai tei.</para>
  <para style="ip">Pecai, kenabe samria kena samriadung pekie ketsamtsam: laktak kelungzai reli, kanggwa, kenzuibe, kemie, magah, mahei, kelak, keku, nah zausak nah kemmha de kemmau macisamdung raugai.</para>
  <para style="ip">Macisam luliede aidungde Hegwangpei Solomon dade gwang. Kedadung au Hezekiah minadung reu rausui gai. Agur penai Lemuel ne pe sam kamtube kenade raugai.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Maci nah kemie ha keledeu (1:1-9:18)</para>
  <para style="io1">Solomon Macisamdung (10:1-22:16)</para>
  <para style="io1">Makecime samdung (22:17-24:34)</para>
  <para style="io1">Solomon Macisam kedadung (25:1-29:27)</para>
  <para style="io1">Agur penai Lemuel samdung (30:1-31:31)</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s">Keraisam</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />David napei Israel gwangpei Solomon<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">Solomon</char><char style="ft" closed="false">: Solomon au Israel deudi gwangpei, hegwangpei David napei</char></note> macisamdung.<verse eid="PRO 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 1:2" />Macisamdung aidungde au maci nah keledeusam ledeu kerane,</para>
  <para style="q" vid="PRO 1:2">pekie kecoksamdung ledeu kerane,<verse eid="PRO 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 1:3" />iciu eh nnui keledeusam cide ngaulu eh</para>
  <para style="q" vid="PRO 1:3">petaube, kemzuibe nah kesamsangbe tei eh lungh lu kerane.<verse eid="PRO 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 1:4" />Macisamdung cidung mang eh kelame de tei mriak lu</para>
  <para style="q" vid="PRO 1:4">nah rehangmedung de peu ma cilu nah ma petaube teilu kerane.<verse eid="PRO 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 1:5" />Makecime de peu kingnei lu eh penui maci kieesi kelu teilu</para>
  <para style="q" vid="PRO 1:5">nah kecikecet kebamme de peu puisau ngaukelu teilu,<verse eid="PRO 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 1:6" />macisamdung, samgwa,</para>
  <para style="q" vid="PRO 1:6">nah makecime samdung nah penui samregwadung cilu kerane.<verse eid="PRO 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 1:7" />RAMPAUBE de kerüt au maci bangdwabe</para>
  <para style="q" vid="PRO 1:7">kemangme maci nah keledeu de mlaila.<verse eid="PRO 1:7" /></para>
  <para style="s">Mide Kehemeu Kemmau</para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 1:8" />A na, n pei ncu marang kelia de kingnei lu</para>
  <para style="q" vid="PRO 1:8">nah n pui keledeusamdung de keu kezia diso;<verse eid="PRO 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 1:9" />cidungde n peu ga peurwa keyi ge zie</para>
  <para style="q" vid="PRO 1:9">nah heteiria n ngwang gage gwak kebam nzwa.<verse eid="PRO 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 1:10" />A na, kemauketeime ncu penui mau gage teugai kera tei cai,</para>
  <para style="q" vid="PRO 1:10">penui caisui kera keli dilu.<verse eid="PRO 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 1:11" />Magade penui rang eh, ‘‘Anui da gwang lu,</para>
  <para style="q" vid="PRO 1:11">anui mide teitset kera kwa bam go,</para>
  <para style="q" vid="PRO 1:11">anui mbailu delwe pekie kegah gade mina mau kemakme de ketang go.<verse eid="PRO 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 1:12" />Anui penuide nring mnwa lugo, Sheol pepum keyime de keupwa di kela nzwa,</para>
  <para style="q" vid="PRO 1:12">nah penuide hekwaki ga nghai mie kecume nzwa teidi go;<verse eid="PRO 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 1:13" />anui mahei pemi kehung ketsamtsam leune ngau luzie;</para>
  <para style="q" vid="PRO 1:13">anui mi dade rega keludungde le anui ki tei pui luzie.<verse eid="PRO 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 1:14" />Anuide gwang hemaa lu;</para>
  <para style="q" vid="PRO 1:14">iciude anui pelane rangkangbung ncüt luzie.’’<verse eid="PRO 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 1:15" />A na, penuide lampui ga nzang tet so;</para>
  <para style="q" vid="PRO 1:15">penui ketet ga n pi peu cia diso;<verse eid="PRO 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 1:16" />penui pi makesia gage pak gaila</para>
  <para style="q" vid="PRO 1:16">nah penui hejai teilwa gai kera kenang dila.<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">Isa. 59:7, Rom. 3:15-17</char></note><verse eid="PRO 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 1:17" />Nruine keheibe dwa gage helang kelien kegai au kemta ge.<verse eid="PRO 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 1:18" />Dede mina aidungde penuikatei penui baih teu pwabam la,</para>
  <para style="q" vid="PRO 1:18">penui tsailu kera baih ge.<verse eid="PRO 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 1:19" />Mina keheibe de petau kemak gade mahei ngau keludung de ainzwa da;</para>
  <para style="q" vid="PRO 1:19">petau kemak mahei de herak teu kelame teilung keuteu dila. <note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">Eze. 22:13</char></note><verse eid="PRO 1:19" /></para>
  <para style="s">Maci de Kemlai</para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 1:20" />Maci puidiki gade sahbakla,</para>
  <para style="q" vid="PRO 1:20">pa litaknidung gade sahbakla;<verse eid="PRO 1:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 1:21" />puidiki peureu gade pa sahbakla,</para>
  <para style="q" vid="PRO 1:21">namdi kirie<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="fq" closed="false">Namdi kirie</char><char style="ft" closed="false">: Ndaa kirie aide gade hezaibe gade hemaabe ziemne hetu tiak kecu teila</char></note> kimui gade pa marang bam,<verse eid="PRO 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 1:22" />“Kemangmedung, nnui daitie ge mang neu bam zieno?</para>
  <para style="q" vid="PRO 1:22">Mide kekiimedung, nnui daitie ge mide kekii ga nnui sui bam zieno,</para>
  <para style="q" vid="PRO 1:22">nah kemiemedung, nnui daitie ge maci ngkau bam zieno?<verse eid="PRO 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 1:23" />Ih ncu ledeu kebeu de gage nlung kailu;</para>
  <para style="q" vid="PRO 1:23">Ih a kecet de ncu rui gaibeu zie;</para>
  <para style="q" vid="PRO 1:23">Ih a sam de peu ncu cilu zie.<verse eid="PRO 1:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 1:24" />Ih qugai, dede nang a kwa kingnei raudi;</para>
  <para style="q" vid="PRO 1:24">Ih a ba kezangpet gaida, dede migede helungkai eh kingnei ma.<verse eid="PRO 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 1:25" />Dede nang Ih ncu rangkelia de mapie ma</para>
  <para style="q" vid="PRO 1:25">nah ncu ledeukebeu de gage nlung kaima.<verse eid="PRO 1:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 1:26" />Nang keherei keludau Ih ncu nui dizie</para>
  <para style="q" vid="PRO 1:26">nah kehing kegwang dau Ih ncu kii zie,<verse eid="PRO 1:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 1:27" />kehing rahang nzwa n da kegwang dau</para>
  <para style="q" vid="PRO 1:27">nah kengkap tingkai kenrui nzwa n da kegwang dau,</para>
  <para style="q" vid="PRO 1:27">lungrei nah lungsiet n da kegwang dau.<verse eid="PRO 1:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 1:28" />Iciude penui acu qu zie, dede Ih penui sam keli lak;</para>
  <para style="q" vid="PRO 1:28">penui swagah eh acu qu zie, dede penui acu peei gailak.<verse eid="PRO 1:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 1:29" />Kedanemene penui maci ngkaula</para>
  <para style="q" vid="PRO 1:29">nah RAMPAUBE mie hinglu kemakne,<note caller="+" style="f"><char style="fr" closed="false">1:29 </char><char style="fq" closed="false">RAMPAUBE mie hinglu kemakne</char><char style="ft" closed="false">: RAMPAUBE sam mzai kera mlai muila</char></note><verse eid="PRO 1:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 1:30" />penui a keledeu de mzai luma,</para>
  <para style="q" vid="PRO 1:30">nah Ih rangkelia leune mlaidi.<verse eid="PRO 1:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 1:31" />Penui ling kegai tsi de penui tyei zie,</para>
  <para style="q" vid="PRO 1:31">nah penui ciemdung tsi dele penui pui luzie.<verse eid="PRO 1:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 1:32" />Macikemakme nreu tet kegai dau penuide teitset dila,</para>
  <para style="q" vid="PRO 1:32">nah kemieme ma cetla kemakne penuide teingkap dila.<verse eid="PRO 1:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 1:33" />Dede a sam kingnei kelume kwak eh lungh luzie</para>
  <para style="q" vid="PRO 1:33">nah magede lungpang tei kera gah eh kwak luzie.”<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s">Macisam pe Keyi</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 2:1" />A na, nang a sam de luulu</para>
  <para style="q" vid="PRO 2:1">nah Ih ncu hezai kaikebeu de kainzeu pwabam lucai,<verse eid="PRO 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 2:2" />macisam kingneilu</para>
  <para style="q" vid="PRO 2:2">nah kecikecet gage n mlung ngngei gailu.<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">Macisamdung 23:12</char></note><verse eid="PRO 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 2:3" />Nang maci ziemne n nggia kie</para>
  <para style="q" vid="PRO 2:3">nah cide ziemne mragai cai,<verse eid="PRO 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 2:4" />nang cide de rangkanggeu kepeei nzwa peei cai</para>
  <para style="q" vid="PRO 2:4">nah nang maci kebai pwakebam maheidung kepeei nzwa peei cai,<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="MAT 13:44">Mat. 13:44</ref></char></note><verse eid="PRO 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 2:5" />iciu lucai nang RAMPAUBE mie kehing de ci luzie</para>
  <para style="q" vid="PRO 2:5">nah nang Tinggwang maci ngau luzie.<verse eid="PRO 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 2:6" />Kedanemene RAMPAUBE maci peula,</para>
  <para style="q" vid="PRO 2:6">pemui gade maci nah kecikecet gwang la.<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="JAS 1:5">Jas. 1:5</ref></char></note><verse eid="PRO 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 2:7" />Pa pe suiyi tei kelame ziemne maci hekwa beula,</para>
  <para style="q" vid="PRO 2:7">pa au masang eh tet kelame de gum beula,<verse eid="PRO 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 2:8" />makesang lampuidung pa gum beula</para>
  <para style="q" vid="PRO 2:8">nah pa pecu nlum kelame lampui gum beuzie.<verse eid="PRO 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 2:9" />Iciude nang daipaibe samsang, mzui nah matei kensam bi kecu ci luzie,</para>
  <para style="q" vid="PRO 2:9">nah lampui keyi leune ci luzie.<verse eid="PRO 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 2:10" />Kedanemene maci n mlung ga lüt luzie</para>
  <para style="q" vid="PRO 2:10">nah maci de ne n rabe suiyi tei beuzie.<verse eid="PRO 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 2:11" />N lungcet dene n mapie beuzie,</para>
  <para style="q" vid="PRO 2:11">kecikecet ne ncu gumbeu zie.<verse eid="PRO 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 2:12" />Cidungde ne ncu lampui kesia gade keli beuzie,</para>
  <para style="q" vid="PRO 2:12">nah kecwa sam kerangme dade,<verse eid="PRO 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 2:13" />lampui petaube püt kedime</para>
  <para style="q" vid="PRO 2:13">nah kemui lampui ga tet kelamedung.<verse eid="PRO 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 2:14" />Penui kemau tei kecudau penui suiyi la</para>
  <para style="q" vid="PRO 2:14">nah kesiaketei de penui suiyi la.<verse eid="PRO 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 2:15" />Penui masangkemak lampui ga pwala</para>
  <para style="q" vid="PRO 2:15">nah mide cwa eh penui pipa kebai dila.<verse eid="PRO 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 2:16" />Maci nah n lungcet dene ncu kemmha pui dade,</para>
  <para style="q" vid="PRO 2:16">nah pezai petaukemak pui nah kemta sam kerangdung gade keli beuzie.<verse eid="PRO 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 2:17" />Pa pe nahpei de pütdi la</para>
  <para style="q" vid="PRO 2:17">nah pa Tinggwang dage samkak kelude nsungta dila.<verse eid="PRO 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 2:18" />Kedanemene pe ki ketsai ga nghim hung dila,</para>
  <para style="q" vid="PRO 2:18">nah pe pipadung ncu herau gage saugai beuzie.<verse eid="PRO 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 2:19" />Mina peda kemieme pelane cailigwang dailak</para>
  <para style="q" vid="PRO 2:19">nah penui kering lampuidung de ngau gailak.<verse eid="PRO 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 2:20" />Cine nang mina keyime lampui ga tetgwang zie</para>
  <para style="q" vid="PRO 2:20">nah mina masang kelame lampuidung sui gwang zie.<verse eid="PRO 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 2:21" />Kedanemene petau tei eh kelame hangdeube ga lungh dizie,</para>
  <para style="q" vid="PRO 2:21">nah masang kelame cika lungh bam dizie.<verse eid="PRO 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 2:22" />Dede kesiame de au hangdeube gade keu mpet dizie,</para>
  <para style="q" vid="PRO 2:22">nah kenlum kegahme de cikade keugi dizie.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 3:1" />A na, Ih ncu teilo kebeudung de nsungta diso</para>
  <para style="q" vid="PRO 3:1">nah a keledeudung n mlung gage kaizeu lu,<verse eid="PRO 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 3:2" />kedanemene cidungde ne n teilung tei ntie beuzie,</para>
  <para style="q" vid="PRO 3:2">nah ncu lungciep kaisi beuzie.<verse eid="PRO 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 3:3" />Peu madaude samkakkelu samsang nah nlumlukebui de ncu püt diso,</para>
  <para style="q" vid="PRO 3:3">cidungde n ngwang gage kang ncütlu,</para>
  <para style="q" vid="PRO 3:3">cidungde n mlung gage raulu.<verse eid="PRO 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 3:4" />Ciu lucai nang Tinggwang nah mina</para>
  <para style="q" vid="PRO 3:4">suiyi teilu zie nah hezi keyi ngau luzie. <note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">Luk. 2:52, Rom. 12:17, 2 Cor. 8:21</char></note><verse eid="PRO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />N mlung pekiene teu RAMPAUBE de nlumlu</para>
  <para style="q" vid="PRO 3:5">nah n kecikecet de ga ngngei diso;<verse eid="PRO 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 3:6" />nang ketei leune ga pecu hetwa peulu</para>
  <para style="q" vid="PRO 3:6">iciude pa n lampuidung tei mzui beuzie.<verse eid="PRO 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 3:7" />Nkatei ncu le mteu lie cetso;</para>
  <para style="q" vid="PRO 3:7">RAMPAUBE mie hinglu nah kesiabe gade nreu tetdi lu.<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">Rom. 12:16</char></note><verse eid="PRO 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 3:8" />Cide n pumteih teingkei beuzie</para>
  <para style="q" vid="PRO 3:8">nah n pum teimcang beuzie.<verse eid="PRO 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 3:9" />N mahei nah n deu gade ngaukelu</para>
  <para style="q" vid="PRO 3:9">petsiraitudung teu RAMPAUBE de rütlu,<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">Tet. 23.19; Pum. 28.26-31; Hez. 26.1-15</char></note><verse eid="PRO 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 3:10" />iciu lucai n ciukidung pui luzie</para>
  <para style="q" vid="PRO 3:10">nah zaubung, zau keheci le pui nlim dizie.<verse eid="PRO 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 3:11" />A na, RAMPAUBE ledeu kegaide mlai diso</para>
  <para style="q" vid="PRO 3:11">nah pa kesiu kegaide ngkau diso,<verse eid="PRO 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 3:12" />kedanemene RAMPAUBE pa hung kelame de ledeu la,</para>
  <para style="q" vid="PRO 3:12">mipei ge pe na pe suiyi teikelabe de ledeu kela nzwa.<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">Eph. 6:4, Heb. 12:5-7</char></note><verse eid="PRO 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 3:13" />Maci ngau kelube au samlam pungtu;</para>
  <para style="q" vid="PRO 3:13">pa kecikecet de ngau lula.<verse eid="PRO 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 3:14" />Maci gade kemmi ngaukelu au rangkanggeu gade kemmi ngaukelu swa yiki</para>
  <para style="q" vid="PRO 3:14">nah pe mmi au kecak de swa yiki.<verse eid="PRO 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 3:15" />Maci au hega swade pemi hung ki,</para>
  <para style="q" vid="PRO 3:15">nang lukeneu keheibe de cide de keukeda gailak.<verse eid="PRO 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 3:16" />Pe teilung ketie pe ba zetle ga bam;</para>
  <para style="q" vid="PRO 3:16">pe ba mhile ga maheidung nah kerüt bam.<verse eid="PRO 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 3:17" />Pe lampuidung au ngaugia lampuidung</para>
  <para style="q" vid="PRO 3:17">nah pe lampuidung pelane au lungciepbe.<verse eid="PRO 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 3:18" />Pa au pecu gipung bam kelume ziemne kering tsingbang ge,</para>
  <para style="q" vid="PRO 3:18">pecu gipung kebamme au pe suiyi bamla.<verse eid="PRO 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 3:19" />RAMPAUBE maci gade kideube de damgai,</para>
  <para style="q" vid="PRO 3:19">kecikecet teu eh pa tinggimdung teilu.<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">Lei. 104:24, 136:5</char></note><verse eid="PRO 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 3:20" />Pe maci gade duidung lwa petlu</para>
  <para style="q" vid="PRO 3:20">nah hemwadung hezin zaugai.<verse eid="PRO 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 3:21" />A na, kemteu nah kecikecet de kainzeu lu,</para>
  <para style="q" vid="PRO 3:21">nah peu ci kenade ndade tet diso.<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />Ci kenade n rabe ziemne keringbe zie</para>
  <para style="q" vid="PRO 3:22">nah n ngwang ga hezu keyi ge zie.<verse eid="PRO 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 3:23" />Iciude nang n lampui kwak eh tet luzie</para>
  <para style="q" vid="PRO 3:23">nah n pi dwak dilak;<verse eid="PRO 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 3:24" />nang zeu mie kecudau, nang ngngi dilak;</para>
  <para style="q" vid="PRO 3:24">nang zeu mie kecudau, nang zip hemi luzie.<verse eid="PRO 3:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 3:25" />Kengngi zette kegwang ziemne ngngi diso</para>
  <para style="q" vid="PRO 3:25">mede kesiabe ne teikemsia teu kegwang dau,<verse eid="PRO 3:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 3:26" />kedanemene RAMPAUBE n lambie bam zie</para>
  <para style="q" vid="PRO 3:26">nah hebaih ga paklet lu kera gade n pi keu mzia beuzie.<verse eid="PRO 3:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 3:27" />Ngaulubui siak kecume dade keyibe keu kezeu diso,</para>
  <para style="q" vid="PRO 3:27">cide teikera nang kengking kebam dau.<verse eid="PRO 3:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 3:28" />N kidame dage,</para>
  <para style="q" vid="PRO 3:28">“Tetcu, delwe gwang dailu, Ih ncünne cide peu zie,” de eh rangso,</para>
  <para style="q" vid="PRO 3:28">nang nda rangkang kebam dau.<verse eid="PRO 3:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 3:29" />N kidame de teikeherei kera riam so,</para>
  <para style="q" vid="PRO 3:29">pa ncu nlum eh n taiga lungh bam.<verse eid="PRO 3:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 3:30" />Pekie kegah gade migede de ngngwa kesamlim so,</para>
  <para style="q" vid="PRO 3:30">pa ncu rezam kera magede teigai kemak cai.<verse eid="PRO 3:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 3:31" />Pezai kesiame de nriak so</para>
  <para style="q" vid="PRO 3:31">mede pa keteibe ma keheibe de teiso.<verse eid="PRO 3:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 3:32" />Kedanemene kesia keteime de RAMPAUBE ngkaula,</para>
  <para style="q" vid="PRO 3:32">dede kemzuime da pe kekuu bamla.<verse eid="PRO 3:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 3:33" />RAMPAUBE reset au kesia keteime kiga bamla,</para>
  <para style="q" vid="PRO 3:33">dede pa kesamsangme ki samlam beula.<verse eid="PRO 3:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 3:34" />Mide rangmsia kelame de pa rangmsia la,</para>
  <para style="q" vid="PRO 3:34">dede henah kelame de pe suiyi la.<note caller="+" style="f"><char style="fr" closed="false">3:34 </char><char style="ft" closed="false">James 4:6, 1 Pet. 5:5</char></note><verse eid="PRO 3:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 3:35" />Mina kemteume kerüt ngau lula,</para>
  <para style="q" vid="PRO 3:35">dede kemieme hengam rünne ngaula.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s">Macisam au Ngkingcang</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 4:1" />A namedung, nnui pei keledeusam kingneilu,</para>
  <para style="q" vid="PRO 4:1">nah helungkai lu ciude nnui kecikecet daibi kecu ci luzie.<verse eid="PRO 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 4:2" />Ih nnuide keledeusam keyidung peu bam;</para>
  <para style="q" vid="PRO 4:2">a keledeu de mlai diso.<verse eid="PRO 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 4:3" />Ih hena keceuna dau, apei apui na pumli tei kebam dau,<verse eid="PRO 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 4:4" />pa acu ledeubeu eh a dage ranggai,</para>
  <para style="q" vid="PRO 4:4">“A samdung n mlung gage kainzeu lu;</para>
  <para style="q" vid="PRO 4:4">Ih teilo kebeudung kainzeu lu eh lungh lulo.<verse eid="PRO 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 4:5" />Maci nah kecikecet teulu;</para>
  <para style="q" vid="PRO 4:5">Ih rangkegai samdung de nsungta so nah keugi diso;<verse eid="PRO 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 4:6" />Maci gi diso, iciude pa n mapie la zie;</para>
  <para style="q" vid="PRO 4:6">pecu hunglu, iciude pa ncu peu kwak luzie.<verse eid="PRO 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 4:7" />Maci au ma nlangtube, cine maci luulu</para>
  <para style="q" vid="PRO 4:7">nah nang ngaukelu pelane gade kecikecet luulu.<verse eid="PRO 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 4:8" />Maci de hunglu, iciude pa ncu teucuh beuzie;</para>
  <para style="q" vid="PRO 4:8">pecu gailu, iciude pa ncu kerüt teugwang beuzie.<verse eid="PRO 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 4:9" />Pa n peu ga kerüt peurwa ge kaibeu zie;</para>
  <para style="q" vid="PRO 4:9">pa ncu hezukeyi peurwa ge peu zie.”<verse eid="PRO 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 4:10" />A na, kingneilu, nah a samdung gage nlungkai lu,</para>
  <para style="q" vid="PRO 4:10">iciude nang teilung ketie lungh luzie.<verse eid="PRO 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 4:11" />Ih ncu maci lampui gage ngngwa gaibeu;</para>
  <para style="q" vid="PRO 4:11">Ih ncu lampui kemzuibe saubeu dida.<verse eid="PRO 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 4:12" />Nang tet kecudau, migede n lampui kaam lak</para>
  <para style="q" vid="PRO 4:12">nah nang pak kegaidau de, nang kau dilak.<verse eid="PRO 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 4:13" />Keledeusam de herakteu bamlu, cide püt diso;</para>
  <para style="q" vid="PRO 4:13">cide gumlu, kedanemene cide n teilung delu.<verse eid="PRO 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 4:14" />Kesiame lampui pwaso</para>
  <para style="q" vid="PRO 4:14">nah kemau tei kelame cai suiso.<verse eid="PRO 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 4:15" />Cide mria lu, cika lütso;</para>
  <para style="q" vid="PRO 4:15">cide gade nreu tet dilu nah lampui keda ga tet dilu.<verse eid="PRO 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 4:16" />Kedanemene penui kemau teidi kemaktane ziep gailak</para>
  <para style="q" vid="PRO 4:16">nah penui kangge de rezam di kemaktane mrak eh zeu bamla.<verse eid="PRO 4:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 4:17" />Kedanemene penui kenlien taktyei tyei la</para>
  <para style="q" vid="PRO 4:17">nah zaisiet zau sakla.<verse eid="PRO 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 4:18" />Dede makesangme lampui au tingnaimiak kepet nzwa da,</para>
  <para style="q" vid="PRO 4:18">cide baa reu reu eh tingba gwang kelu nzwa da.<verse eid="PRO 4:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 4:19" />Kenlienme lampui au tingmui nzwa mui,</para>
  <para style="q" vid="PRO 4:19">penui daipai dwak lwe kaumie zeubi kecu ci lama.<verse eid="PRO 4:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 4:20" />A na, a samdung de cet heling lulo;</para>
  <para style="q" vid="PRO 4:20">Ih kerang de ga nlungkai eh kingneilu.<verse eid="PRO 4:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 4:21" />Cidungde peu madaude n dade nreu tet diso;</para>
  <para style="q" vid="PRO 4:21">cidungde n mlung gage kailu.<verse eid="PRO 4:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 4:22" />Kedanemene a samdung ngau kelume ziemne au kering,</para>
  <para style="q" vid="PRO 4:22">nah penui pum pelane ziemne keyi ge.<verse eid="PRO 4:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 4:23" />N mlung de peu kwak eh bamlu nah sünne eh gum teu pwabam lu,</para>
  <para style="q" vid="PRO 4:23">kedanemene cide gade kering duirwak lwapet lalu.<verse eid="PRO 4:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 4:24" />Sam petau kemakbe n dade keugi dilu,</para>
  <para style="q" vid="PRO 4:24">nah samkesiabe n dade keu mdei dilu.<verse eid="PRO 4:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 4:25" />Peu n miak mzuizang eh pielu,</para>
  <para style="q" vid="PRO 4:25">nah n dwa ga kebam de pie mting lu.<verse eid="PRO 4:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 4:26" />N pi ziemne lampui kensambe teilu;</para>
  <para style="q" vid="PRO 4:26">iciude nang ketei leune kwak luzie.<verse eid="PRO 4:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 4:27" />Zetle mede hile ge nreu gaiso;</para>
  <para style="q" vid="PRO 4:27">makesiabe gade nreu tet dilu.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s">Kemmha Kemmau</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 5:1" />A na, a maci de gage nlung kailu;</para>
  <para style="q" vid="PRO 5:1">a kecikecet de kingnei teune lu,<verse eid="PRO 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 5:2" />iciu eh nang petaube teilu kerane</para>
  <para style="q" vid="PRO 5:2">nah n samdung maci gumlu kerane.<verse eid="PRO 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 5:3" />Kedanemene kemmha pui samdung au helia dui zau kemie nzwa</para>
  <para style="q" vid="PRO 5:3">nah pe sam au maca swa mdui ki,<verse eid="PRO 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 5:4" />dede penli kedi dau pa au kekaa bang ge nzwa kaa dizie,</para>
  <para style="q" vid="PRO 5:4">kingtie pe mui keyibe ne dang kegai nzwa zie.<verse eid="PRO 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 5:5" />Pepi ketsai gage tet hungla;</para>
  <para style="q" vid="PRO 5:5">pe pikietdung Sheol<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="fq" closed="false">Sheol </char><char style="ft" closed="false">Ketsaime deu</char></note> gage tet gaila.<verse eid="PRO 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 5:6" />Pa kering lampui gage pe lung kai lama.</para>
  <para style="q" vid="PRO 5:6">Pe pi kietdung huii lala; pa dai gage tetgai labi ci lama.<verse eid="PRO 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 5:7" />Cu, a namedung, a sam kingnei lu;</para>
  <para style="q" vid="PRO 5:7">a mui gade kepet samdung kingnei tadi eh nreu tet kedi teiso.<verse eid="PRO 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 5:8" />Pe dade n lampui kai mdei dilu,</para>
  <para style="q" vid="PRO 5:8">nah peki kikam taiga gwang nna deso.<verse eid="PRO 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 5:9" />Mecai n da kerüt kebam de mikedamedung de peu dizie</para>
  <para style="q" vid="PRO 5:9">mede n teilung pezai kesiame dage kai dizie;<verse eid="PRO 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 5:10" />cikemakmedung ne n mabam leu pwa dizie;</para>
  <para style="q" vid="PRO 5:10">nang bata de cikemakme kiga nlüt dizie.<verse eid="PRO 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 5:11" />Nah teilung kekamle</para>
  <para style="q" vid="PRO 5:11">n teih nah n pum teingkap kegai dau nang teei eh mra dizie.<verse eid="PRO 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 5:12" />Nang ncam eh rang zie, “Ih daikenzwa gede keledeusam de mlai dino</para>
  <para style="q" vid="PRO 5:12">nah a lung keledeu mlai dino!<verse eid="PRO 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 5:13" />Ih a keledeumedung sam mzai lu meda</para>
  <para style="q" vid="PRO 5:13">mede a keledeumedung sam kingnei lu meda.<verse eid="PRO 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 5:14" />Ih au mtei dwa gade, minadung gwang ngkwa kebam kak gade</para>
  <para style="q" vid="PRO 5:14">ngkap zingdi nage da.”<verse eid="PRO 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 5:15" />Nkatei ngu duibung<note caller="+" style="f"><char style="fr" closed="false">5:15 </char><char style="fq" closed="false">Duibung </char><char style="ft" closed="false">hangdeu kangga tingrui dui kehekwabung</char></note> gade dui saklu</para>
  <para style="q" vid="PRO 5:15">nah nkatei n tekwa duilwa kebam gade dui saklu.<verse eid="PRO 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 5:16" />Peu ngu duirwakdung kehei leune ga pui nlim zie ni</para>
  <para style="q" vid="PRO 5:16">nah peu ngu reuceu dui namdi sum ga lwamie zieni?<verse eid="PRO 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 5:17" />Peu cidungde nkatei n ziemne lu</para>
  <para style="q" vid="PRO 5:17">nah n da kebam cikemakmedung ziemne so.<verse eid="PRO 5:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 5:18" />Peu ngu duilet de samlam beulu</para>
  <para style="q" vid="PRO 5:18">nah n nau kelube puide de nsui lu,<verse eid="PRO 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 5:19" />kedanemene pa au heti nzwa hezuyi nah pe zaiyi.</para>
  <para style="q" vid="PRO 5:19">Peu pe keku ncu kemnung peu muilu;</para>
  <para style="q" vid="PRO 5:19">peu pe keku le ncu twagwa bammui lu.<verse eid="PRO 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 5:20" />Kedanemene a na, ncu daitei peu kemmha puide kemeu pwabam lai?</para>
  <para style="q" vid="PRO 5:20">Nang daitei mi keda nau zuyi de nsui laino?<verse eid="PRO 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 5:21" />RAMPAUBE mige ma teikela leune ngaula</para>
  <para style="q" vid="PRO 5:21">nah pa ketet lampui leune pie bamla.<verse eid="PRO 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 5:22" />Kesia keteime de pekatei pe maudung gage keu dizie;</para>
  <para style="q" vid="PRO 5:22">pe mau lang gage pecu keu pwabam dizie.<verse eid="PRO 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 5:23" />Peda puisau bam kemakne pa tsai dila;</para>
  <para style="q" vid="PRO 5:23">pa mang kemtei dene pecu petau kemak gage teugai dida.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s">Kemie de Kemmau</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 6:1" />A na, nang n kidabe pau ruibeu kera n rangkang keumpet ntsam nzeu cai,</para>
  <para style="q" vid="PRO 6:1">nang cikemakme ge pau ruibeu kera n sam petbeu dicai,<verse eid="PRO 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 6:2" />iciucai n sampet dene nang nziemne baih ge tei luda</para>
  <para style="q" vid="PRO 6:2">nah n mui gade kepet samdung dene ncu keu luda.<verse eid="PRO 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 6:3" />A na, n samdung ne ncu keu keludau, aide teilu nah nkatei ncu kelilu,</para>
  <para style="q" vid="PRO 6:3">nang n kidabe ba gage kaugai di delu;</para>
  <para style="q" vid="PRO 6:3">mie delwe nkatei ncu teihenah lu nah n kidabe dwa gade nggia kielu.<verse eid="PRO 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 6:4" />Peu n miakdung de kette zipso</para>
  <para style="q" vid="PRO 6:4">nah n miakkum de kette zip diso.<verse eid="PRO 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 6:5" />Heti ge teihgwabe dade pak mbaikelu nzwa nkatei ncu kelilu,</para>
  <para style="q" vid="PRO 6:5">nruine ge matak keteime ba gade pakkelu nzwa.<verse eid="PRO 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 6:6" />Nang kenghetbo, tangtiane de piegai lo,</para>
  <para style="q" vid="PRO 6:6">pe teilung zaidung cet gailo, nah mriak lulo.<verse eid="PRO 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 6:7" />Pe muiteube,</para>
  <para style="q" vid="PRO 6:7">kedibe, mede kengkieng keteube gah,<verse eid="PRO 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 6:8" />dede pa hepwak tingdau pe taktyei mtei lula</para>
  <para style="q" vid="PRO 6:8">nah luhlüt dau<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="fq" closed="false">luhlüt dau </char><char style="ft" closed="false">tingtiak dau</char></note> tyei kera hekwa lula.<verse eid="PRO 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 6:9" />Nang kenghetbo, nang daitie ge zip bam launo?</para>
  <para style="q" vid="PRO 6:9">Nang zip kebam gade daidau cu launo?<verse eid="PRO 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 6:10" />“Manage zip gai ziereu, manage zip gai ziereu,</para>
  <para style="q" vid="PRO 6:10">a ba tuilwe manage mtak gai ziereu”<verse eid="PRO 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 6:11" />nah n magah au sütketyeime ge nzwa gwang zie,</para>
  <para style="q" vid="PRO 6:11">nah nang teumai kesiabedung pe reunet teulwe sütketyeime ge nzwa gwang zie.<verse eid="PRO 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 6:12" />Kemta nah kenlien kauge</para>
  <para style="q" vid="PRO 6:12">pa kenret rang eh hui pwa lala,<verse eid="PRO 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 6:13" />pe miak miakhim, pe pidung le maciemdung tei</para>
  <para style="q" vid="PRO 6:13">nah pe zurangdung le sau eh.<verse eid="PRO 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 6:14" />Pa mide kecwa nlung pung delwe heciem kesia riemla;</para>
  <para style="q" vid="PRO 6:14">pa keheidau de kelung zwa kemak kelung gaila.<verse eid="PRO 6:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 6:15" />Ciziemne peda kengkap zette gwang zie;</para>
  <para style="q" vid="PRO 6:15">piage gage pecu teingkei gai kelak keherei gwang zie.<verse eid="PRO 6:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 6:16" />RAMPAUBE ngau kengkau ma herok bam,</para>
  <para style="q" vid="PRO 6:16">pa kemneu ma hena bam.<verse eid="PRO 6:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 6:17" />Ngang kelame miakdung, kenret kela mleu,</para>
  <para style="q" vid="PRO 6:17">kemzuime de teitset kela badung,<verse eid="PRO 6:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 6:18" />heciem kesiadung riem kela lungning,</para>
  <para style="q" vid="PRO 6:18">kesia tei kera zette pet kela pi,<verse eid="PRO 6:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 6:19" />Kenret zierang ketei</para>
  <para style="q" vid="PRO 6:19">nah sinamedung kakgage kesamlim ling kegai.<verse eid="PRO 6:19" /></para>
  <para style="s">Kemmha de Kemmau</para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 6:20" />A na, n pei teilo kebeube mzai lu</para>
  <para style="q" vid="PRO 6:20">nah n pui ledeu kebeube gi diso.<verse eid="PRO 6:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 6:21" />Cidungde n lung gage kang nzeu pwabam muilu;</para>
  <para style="q" vid="PRO 6:21">cidungde n ngwang gage keulu.<verse eid="PRO 6:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 6:22" />Nang tet keladau, cidungde ncu sau beuzie;</para>
  <para style="q" vid="PRO 6:22">nang zip kebamdau, cidungde ncu gum beuzie;</para>
  <para style="q" vid="PRO 6:22">nah nang nrak cuh kecudau, cidungde ncu ledeu beuzie.<verse eid="PRO 6:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 6:23" />Kedanemene ajadung au mitaubung ge, nah keledeusam au kebaa ge;</para>
  <para style="q" vid="PRO 6:23">keledeusam au kering lampuibe da.<verse eid="PRO 6:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 6:24" />Cide mipui kesiame dade ncu keu kezia beuzie,</para>
  <para style="q" vid="PRO 6:24">mipui kesiame kemdui samdung kerang gade.<verse eid="PRO 6:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 6:25" />N mlung gade pe zuiyi de hengim diso,</para>
  <para style="q" vid="PRO 6:25">nah peu pecu pemiak maidung le ncu tui teu diso.<verse eid="PRO 6:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 6:26" />Helipui (kezeu/zeu)gede tangku kwak ge mi le lui lubui,<note caller="+" style="f"><char style="fr" closed="false">6:26 </char><char style="ft" closed="false">helipui ge mi tangku ge mi nzwa kap </char></note></para>
  <para style="q" vid="PRO 6:26">dede mikedame naude kelwet au n teilung pelane kai kegai nzwa da.<verse eid="PRO 6:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 6:27" />Mige pe paidung ru mene</para>
  <para style="q" vid="PRO 6:27">pe hekakrak gage mi pung lubui ni?<verse eid="PRO 6:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 6:28" />Mige pepi nsie mene</para>
  <para style="q" vid="PRO 6:28">miceu kelum ga tet lubui ni?<verse eid="PRO 6:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 6:29" />Mige pe kidabe nau da mie kecube de cinzwa da;</para>
  <para style="q" vid="PRO 6:29">pecu tung kecube saja ngau mene talak.<verse eid="PRO 6:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 6:30" />Keregame ge pa mzeu eh teumai kesia ne rega lacai</para>
  <para style="q" vid="PRO 6:30">Mina pecu mlai lama.<verse eid="PRO 6:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 6:31" />Dede pecu tui lucai, pa regakelu pia hena kieege peu dai zie;</para>
  <para style="q" vid="PRO 6:31">pa pe kiga pemi ketei leune peu maisia.<verse eid="PRO 6:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 6:32" />Kemmha ta keteibe magede kecet gah;</para>
  <para style="q" vid="PRO 6:32">cide tei kelabe pekatei pecu teimsia bam da.<verse eid="PRO 6:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 6:33" />Rezam nah hengam pa ngau kera pe nsam,</para>
  <para style="q" vid="PRO 6:33">nah pa ngngam lamui dizie.<verse eid="PRO 6:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 6:34" />Mipei ge pe nau ziemne pe ngauraume dade pe lungriak kecu dau perata süt dila;</para>
  <para style="q" vid="PRO 6:34">pa pekum kepeei dau ngaugia kette bam lak.<verse eid="PRO 6:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 6:35" />Pa hemaa kepeu kette luu lak</para>
  <para style="q" vid="PRO 6:35">nah pecu lui gailak, nang pecu mapeudung kekiee ge peu liede.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s">Kemmha Pui de Kemmau</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 7:1" />A na, a samdung kainzeu lu</para>
  <para style="q" vid="PRO 7:1">nah Ih teilo kebeudung nlung gage kainzeu lu.<verse eid="PRO 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 7:2" />Ih teilo kebeudung de teilu, iciude nang ring luzie</para>
  <para style="q" vid="PRO 7:2">nah a keledeusam de ma kedabe leune reu kai kwaklu.<verse eid="PRO 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 7:3" />Cidungde n zurangdung gage keulu;</para>
  <para style="q" vid="PRO 7:3">cidungde n mlung gage raulu.<verse eid="PRO 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 7:4" />Maci dage ranglu, “Nang au a tipui,”</para>
  <para style="q" vid="PRO 7:4">nah lungcet de n kibaume lie qulu,<verse eid="PRO 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 7:5" />iciu eh kemmha pui dade ncu teu mbailu kerane,</para>
  <para style="q" vid="PRO 7:5">mipui kesiame kemdui samdung dade mria lu kerane.<verse eid="PRO 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 7:6" />A ki kebaki ga</para>
  <para style="q" vid="PRO 7:6">rapwa kebam gade Ih pie mpet gai.<verse eid="PRO 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 7:7" />Ih minadung macikemakme de piegai,</para>
  <para style="q" vid="PRO 7:7">nah rehangmedung kakgade</para>
  <para style="q" vid="PRO 7:7">rehangme kemang kauge de Ih ngau.<verse eid="PRO 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 7:8" />Cipau rehangbe kemmha lungh kebam kimiak taiga puidiki ga tetla,</para>
  <para style="q" vid="PRO 7:8">nah pa cipau puide ki le tet mie.<verse eid="PRO 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 7:9" />Cide tinghegi, mui lai eh kebamdau,</para>
  <para style="q" vid="PRO 7:9">tingmui nah muiting kedi dau.<verse eid="PRO 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 7:10" />Cika mipui ge pecu redau,</para>
  <para style="q" vid="PRO 7:10">helipui ge nzwa pe henet teulu, kemau lung pung bam.<verse eid="PRO 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 7:11" />Pa au hengam kegah nah pecui ketei pui ge;</para>
  <para style="q" vid="PRO 7:11">pa pe kilungga bam gimlu lama.<verse eid="PRO 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 7:12" />Cu puidikidung ga nah pecai litakni ga lazie,</para>
  <para style="q" vid="PRO 7:12">nah pa mide teirezam gai kerane kimiak leune ga mbailwe kwabam.<verse eid="PRO 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 7:13" />Cine pa rehangbe de tuibing lu eh pecu kemam gai,</para>
  <para style="q" vid="PRO 7:13">pa pezu kuusüt eh peda ranggai,<verse eid="PRO 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 7:14" />“Ih henai kezuyi reca teigai,</para>
  <para style="q" vid="PRO 7:14">Ih a sampetdung teicang luda,<verse eid="PRO 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 7:15" />cine Ih ncu redau kera tet petla,</para>
  <para style="q" vid="PRO 7:15">ncu peei luneu eh, nah Ih ncu ngau luda.<verse eid="PRO 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 7:16" />Ih a zeu ga zeukam kam luda</para>
  <para style="q" vid="PRO 7:16">Egypt deudi gade ngaukelu langcimpai pegiak ketei le.<verse eid="PRO 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 7:17" />Ih a zeu perimkehengui</para>
  <para style="q" vid="PRO 7:17">myrrh, aloedung nah cinnamon le perim tei mmi pwabam.<verse eid="PRO 7:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 7:18" />Gwanglu, anai tingcang kecang kemrai bam go;</para>
  <para style="q" vid="PRO 7:18">anai kemrai tadung tei eh kehega süt go.<verse eid="PRO 7:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 7:19" />Kedanemene a nahpei au kilung ga gah;</para>
  <para style="q" vid="PRO 7:19">pa beuhdei tetdi.<verse eid="PRO 7:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 7:20" />Pa pe rangkang bungge keu pungla;</para>
  <para style="q" vid="PRO 7:20">pa hekei bungri benai ne cailigwang zie.”<verse eid="PRO 7:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 7:21" />Pa pe samrang kekiee le pecu teu nreudi;</para>
  <para style="q" vid="PRO 7:21">pa pe sam keyidung le pecu petaukemak gage saugai beu.<verse eid="PRO 7:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 7:22" />Hetumseu gitset kera teugwang kela nzwa</para>
  <para style="q" vid="PRO 7:22">pa zette pecai sui tetdi,</para>
  <para style="q" vid="PRO 7:22">heti ge baih gage keukedi nzwa,<verse eid="PRO 7:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 7:23" />lakpitsi ge le pe nceu reudi kemaktane.</para>
  <para style="q" vid="PRO 7:23">Pa au nruine ge hetak ga lim kemie nzwa da.</para>
  <para style="q" vid="PRO 7:23">Cide pe teilung teingkap di zielie kecu pa ci ma.<verse eid="PRO 7:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 7:24" />Cu, a namedung a kwa kingnei lu;</para>
  <para style="q" vid="PRO 7:24">Ih kerang samdung gage nnui lung kailu.<verse eid="PRO 7:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 7:25" />Peu n mlung pe lampuidung gage nreu tetgai diso;</para>
  <para style="q" vid="PRO 7:25">pe lampuidung gage tet maugai diso<verse eid="PRO 7:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 7:26" />Pa minadung kekiee gede reu ngkau kap dida;</para>
  <para style="q" vid="PRO 7:26">pa mina kekiee gede teitset dida.<verse eid="PRO 7:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 7:27" />Pe ki au ketsaime deu lampuidung ga bam;</para>
  <para style="q" vid="PRO 7:27">cidungde ketsai kemui zeubung ga nghung la.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s">Maci au Qubam</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 8:1" />Maci qu bam meni?</para>
  <para style="q" vid="PRO 8:1">Kecikecet pe kwa sahbak gai meni?<verse eid="PRO 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 8:2" />Kideutudung ga lampui kuung ga,</para>
  <para style="q" vid="PRO 8:2">puihaidung ga, maci pe sap tei luda.<verse eid="PRO 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 8:3" />Herieki dwaga namdi kenlüt kimui ga,</para>
  <para style="q" vid="PRO 8:3">namdi kimuidung ga, pa qu bam.<verse eid="PRO 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 8:4" />“Minadung, Ih nnuide qu bam;</para>
  <para style="q" vid="PRO 8:4">a kwa au kideu ga mina pelane ziemne.<verse eid="PRO 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 8:5" />Nnui kemangmedung, maci lu,</para>
  <para style="q" vid="PRO 8:5">nah nnui kemiemedung, nnui kecikecet lungcet bamlu kera tei maisia.<verse eid="PRO 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 8:6" />Kingnei lu, kedanemene Ih sam keyitubedung rangzeu;</para>
  <para style="q" vid="PRO 8:6">nah a mui ngkei kegaidau Ih kemzuibedung rang zie.<verse eid="PRO 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 8:7" />Kedanemene a mui nlumlu kebuibe rangla,</para>
  <para style="q" vid="PRO 8:7">nah makesiabe au a mui ngkaula.<verse eid="PRO 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 8:8" />A mui samdung pelane au kemzuibe;</para>
  <para style="q" vid="PRO 8:8">cidungde ga kenret mede puisau tei maukedi magede gah.<verse eid="PRO 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 8:9" />Kecikecet kebambe dade au cidung pelane mzui bam;</para>
  <para style="q" vid="PRO 8:9">maci ngaukelume ziemne a samdung au mzui.<verse eid="PRO 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 8:10" />Rangkanggeu swade Ih marang kelia debe luulu;</para>
  <para style="q" vid="PRO 8:10">kecak yitube swade maci be luulu.<verse eid="PRO 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 8:11" />Kedanemene maci au hegadung swade yiki;</para>
  <para style="q" vid="PRO 8:11">mahei kette pecu keda gailak.<verse eid="PRO 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 8:12" />Ih, Maci, lungcet teu eh lunghla,</para>
  <para style="q" vid="PRO 8:12">nah a da maci nah keyi kesia cet keci bam.<verse eid="PRO 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 8:13" />RAMPAUBE mie kehing au kesiabe de ngkau kera da.</para>
  <para style="q" vid="PRO 8:13">Ih ngang kecu nah pecu mning kemdi ngkaula, kesia lampui,</para>
  <para style="q" vid="PRO 8:13">nah kenret sam kerang Ih cidungde ngkaula.<verse eid="PRO 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 8:14" />Ada keledeu keyi nah maci kesangbe bam;</para>
  <para style="q" vid="PRO 8:14">Ih au kecibe; kengkieng ada bam. <note caller="+" style="f"><char style="fr" closed="false">8:14 </char><char style="ft" closed="false">Job 12:13</char></note><verse eid="PRO 8:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 8:15" />A ziemne hegwangmedung hegwang teulu bam, nah muiteumedung hezai keyibedung tei lula.<note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="ROM 13:1">Rom. 13:1</ref></char></note><verse eid="PRO 8:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 8:16" />A ziemne hegwangpeidung kengking teulu bam,</para>
  <para style="q" vid="PRO 8:16">kedimedung nah kemzuibe teu eh kedi keteime pelane de.<verse eid="PRO 8:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 8:17" />Ih acu hung kelame de hungla,</para>
  <para style="q" vid="PRO 8:17">nah acu lungsang tei peei kelame acu ngau lubui.<verse eid="PRO 8:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 8:18" />A da ketwa nah maheidung bam,</para>
  <para style="q" vid="PRO 8:18">mahei keyi nah kesamsangbe.<verse eid="PRO 8:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 8:19" />A da kebam tsi au kecak swa yiki, kecak yitube swade;</para>
  <para style="q" vid="PRO 8:19">a dade ngau kelube au rangkanggeu yitube swa yiki.<verse eid="PRO 8:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 8:20" />Ih makesang lampui ga tetla,</para>
  <para style="q" vid="PRO 8:20">kemzeube lampuidung kakga.<verse eid="PRO 8:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 8:21" />Cine, Ih acu hung kelamede peu mahei gum luzie;</para>
  <para style="q" vid="PRO 8:21">Ih penui mabam kidung tei pui beuzie.<verse eid="PRO 8:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 8:22" />RAMPAUBE raitu gade acu damgai,</para>
  <para style="q" vid="PRO 8:22">pe batadung gade raitube.<verse eid="PRO 8:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 8:23" />Ndaa gede acu teilu, raitu gade,</para>
  <para style="q" vid="PRO 8:23">kideube teikelu dwa gade.<verse eid="PRO 8:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 8:24" />Duididung bam kemak dwa acu mna lu,</para>
  <para style="q" vid="PRO 8:24">duilet duilwa pet kemak dwa.<verse eid="PRO 8:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 8:25" />Lamlwadung de teigai kemak dwa,</para>
  <para style="q" vid="PRO 8:25">nah kideutudung dwa, acu mna lu. <note caller="+" style="f"><char style="fr" closed="false">8:25 </char><char style="ft" closed="false">John 1:1-2, Col. 1:17</char></note><verse eid="PRO 8:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 8:26" />RAMPAUBE kideube mede luhdung teigai kemak dwa acu mna lu,</para>
  <para style="q" vid="PRO 8:26">mede kideu ga rebui raitube dwade.<verse eid="PRO 8:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 8:27" />Pa tinggimdung ketei dau gade Ih la dida,</para>
  <para style="q" vid="PRO 8:27">pa dui kecok reu gage ting teukezang kegaidau gade.<verse eid="PRO 8:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 8:28" />Pa nreu lege hemwadung tei kegaidau de Ih cika bam nah</para>
  <para style="q" vid="PRO 8:28">duilet dui pesing ga pebam tei keludau de.<verse eid="PRO 8:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 8:29" />Pa jaaidi penli tei kegai daude, Ih la dida,</para>
  <para style="q" vid="PRO 8:29">ciu eh duidung pa rangkegai gwale zangdi melu kerane,</para>
  <para style="q" vid="PRO 8:29">nah kideu bangbeu kedwa ziemne penli kaikebeu dau de.<verse eid="PRO 8:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 8:30" />Ih pe taiga la, heciemta tei kecibe nzwa;</para>
  <para style="q" vid="PRO 8:30">tingnaige cai tingnaige Ih au pe suiyibe,</para>
  <para style="q" vid="PRO 8:30">pe dwa de renga eh bammui la.<verse eid="PRO 8:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 8:31" />Ih pe kideu pelane de suiyi bamla,</para>
  <para style="q" vid="PRO 8:31">nah a suiyi au minadung da bam.<verse eid="PRO 8:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 8:32" />Cu, a namedung, a kwa kingnei lu,</para>
  <para style="q" vid="PRO 8:32">kedanemene lampuidung kainzeu kelumedung samlam ngau luzie.<verse eid="PRO 8:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 8:33" />Ih marang kelia de kingnei lu nah mriak lu;</para>
  <para style="q" vid="PRO 8:33">cide mlai diso.<verse eid="PRO 8:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 8:34" />A kwa kingnei kelume samlam ngau luzie.</para>
  <para style="q" vid="PRO 8:34">Pa a kikamdung ga tingnai ramsangne kwabam zie,</para>
  <para style="q" vid="PRO 8:34">a kikam tsiadung taiga de kwa eh.<verse eid="PRO 8:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 8:35" />Kedanemene acu peei kelume keheibe, kering ngau luzie,</para>
  <para style="q" vid="PRO 8:35">nah pa RAMPAUBE suiyi ngau luzie.<verse eid="PRO 8:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PRO 8:36" />Dede acu ngaulu kemakme, pe teilung rezam dila;</para>
  <para style="q" vid="PRO 8:36">acu ngkau kelame pelane ketsai pesui la.”<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s">Maci nah Kemie Qu kebam</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 9:1" />Maci peki tei luda;</para>
  <para style="q" vid="PRO 9:1">pa tangtsu gade hetsia hena teilu.<verse eid="PRO 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 9:2" />Pa pe kaune daptset luda; pa pe zau hai luda,</para>
  <para style="q" vid="PRO 9:2">nah pa pe taktyeibam mtei luda.<verse eid="PRO 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 9:3" />Pa pe kilapuidung de langgai dida;</para>
  <para style="q" vid="PRO 9:3">namdi heni kecehudung gade mide qugai kerane,<verse eid="PRO 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 9:4" />“Cauge mang eh lano? Peu pecu aika nreu gwang lu!”</para>
  <para style="q" vid="PRO 9:4">Pe mriak kegahme dage pa ranggai.<verse eid="PRO 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 9:5" />“Gwanglu eh a taktyei tyeilu,</para>
  <para style="q" vid="PRO 9:5">nah Ih zau hai kelude saklu.<verse eid="PRO 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 9:6" />Macikemak tadung pütdi eh lungh lu;</para>
  <para style="q" vid="PRO 9:6">maci lampui ga tetlu.<verse eid="PRO 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 9:7" />Mide rang kemsiabe de ledeu kelabe kemneu ngau zie,</para>
  <para style="q" vid="PRO 9:7">nah mina kesiame gede ledeu kelabe kekii ngau zie.<verse eid="PRO 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 9:8" />Mide rangmsia kelame de ledeu so, pa ncu nkau dizie;</para>
  <para style="q" vid="PRO 9:8">kemriakme gede ledeu lu, iciude pa ncu hung zie.<verse eid="PRO 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 9:9" />Kemriakme gede ledeulu, iciude pa mriak si luzie;</para>
  <para style="q" vid="PRO 9:9">makesangme gede ledeulu, iciude pa maci siki luzie.<verse eid="PRO 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 9:10" />RAMPAUBE mie kehing au maci bangdwa be,</para>
  <para style="q" vid="PRO 9:10">nah Kemci Tinggwang lungcet au maci.<note caller="+" style="f"><char style="fr" closed="false">9:10 </char><char style="ft" closed="false">Mac. 1:7</char></note><verse eid="PRO 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 9:11" />Kedanemene a dade n tingbaziedung teingkiee luzie</para>
  <para style="q" vid="PRO 9:11">nah n mmi kekiee ge n teilung gage kaisi beuzie.<verse eid="PRO 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 9:12" />Nang mriak cai, nkatei n ziemne mriak bamda,</para>
  <para style="q" vid="PRO 9:12">nah nang mide rangmsia cai, nang cide nkatei n püt zie.”<verse eid="PRO 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 9:13" />Kemang puige au maci ma;</para>
  <para style="q" vid="PRO 9:13">pecu ledeu ma nah pa magede cima.<verse eid="PRO 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 9:14" />Pa peki kimui ga bamla,</para>
  <para style="q" vid="PRO 9:14">namdi cehutu ga teibam ga bamla.<verse eid="PRO 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 9:15" />Pa mina puidiki ga kah kegwangme de qubam,</para>
  <para style="q" vid="PRO 9:15">minadung pe lampui ga mzuizang eh tet kelame de.<verse eid="PRO 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 9:16" />“Kemangme keheibe de peu aika nreu gwanglu,”</para>
  <para style="q" vid="PRO 9:16">Mina kemieme dage pa rangla,<verse eid="PRO 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 9:17" />“Dui rega kelube au kum,</para>
  <para style="q" vid="PRO 9:17">nah hebaipwa kebam tangku au nggum.”<verse eid="PRO 9:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 9:18" />Dede pa au cika ketsaime bamlie kecu cima,</para>
  <para style="q" vid="PRO 9:18">pa qukelu pe giamedung au Sheol<note caller="+" style="f"><char style="fr" closed="false">9:18 </char><char style="fq" closed="false">Sheol</char><char style="ft" closed="false">: ketsaime deu</char></note> kecok ga bamlie kecu.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s">Solomon Macisam</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />Solomon macisamdung.</para>
  <para style="q" vid="PRO 10:1">Hena kemriakme ge pe pei suiyi tei lula</para>
  <para style="q" vid="PRO 10:1">dede hena kemiena ge pe pui de lungrei teugwang beula.<verse eid="PRO 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 10:2" />Masang kemak gade mahei ngaukelu pemi gah,</para>
  <para style="q" vid="PRO 10:2">dede makeyi ketei de ncu ketsai gade kelibeu zie.<verse eid="PRO 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 10:3" />RAMPAUBE mina keyime de peu mzeu di lama,</para>
  <para style="q" vid="PRO 10:3">dede pa kesiame hengim de teibeu lama. <note caller="+" style="f"><char style="fr" closed="false">10:3 </char><char style="ft" closed="false">Lei. 34:9-10</char></note><verse eid="PRO 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 10:4" />Kenghet ba ne mina de tei magah dila,</para>
  <para style="q" vid="PRO 10:4">dede mina kemrime ba au mahei ngausüt lula.<verse eid="PRO 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 10:5" />Kemriakme hepwakting<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="fq" closed="false">hepwakting </char><char style="ft" closed="false">luhlüt ting</char></note> dau mei hekwa lula,</para>
  <para style="q" vid="PRO 10:5">dede luhlüt tingdau zip kebam kera pe ziemne hengam ge.<verse eid="PRO 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 10:6" />Tinggwang mapeudung mina keyime peureu ga gwang zie,</para>
  <para style="q" vid="PRO 10:6">dede mina kesiame samdung kesia zaisiet kebai teu lala.<verse eid="PRO 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 10:7" />Mina keyime ge pecu nsung kelame suiyi tei lula,</para>
  <para style="q" vid="PRO 10:7">dede kesiame zi au tim gah dizie.<verse eid="PRO 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 10:8" />Makecetme keledeu sam luulu la,</para>
  <para style="q" vid="PRO 10:8">dede kemie sam rang kelabe au kap dizie.<verse eid="PRO 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 10:9" />Makesang lampui ga tet kelame kwak luzie,</para>
  <para style="q" vid="PRO 10:9">dede pe lampui teingkoi kelabe de mtei dwa liagai zie.<note caller="-" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="ACT 13:10">Bat. 13:10</ref></char></note><verse eid="PRO 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 10:10" />Miak lisau kelame lungrei mdeu lula,</para>
  <para style="q" vid="PRO 10:10">dede kemie sam rangkelabe de kelien ngkei dizie. <note caller="+" style="f"><char style="ft" closed="false">Kesa keheci laisiudung ga ainzwa peila </char><char style="fqa">dede kuu eh ledeu kelabe kezuyi teugwang lula.</char> </note><verse eid="PRO 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 10:11" />Mina keyime sam au kering dui rwakge,</para>
  <para style="q" vid="PRO 10:11">dede mina kesiame sam au zaisiet kebai teu petla.<verse eid="PRO 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 10:12" />Mide ngaukerau ngngwakesia mdeu beula,</para>
  <para style="q" vid="PRO 10:12">dede keku au kemau leune gi beula.<note caller="+" style="f"><char style="fr" closed="false">10:12 </char><char style="ft" closed="false">1 Cor. 13:7, James 5:20, 1 Pet. 4:8</char></note><verse eid="PRO 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 10:13" />Mina keningcingme maci sam rangla,</para>
  <para style="q" vid="PRO 10:13">dede kemangme de saja peuzie.<verse eid="PRO 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 10:14" />Kemriakme maci hekwa lula,</para>
  <para style="q" vid="PRO 10:14">dede kemangme ge samrang ne kengkap teugwang nna beula.<verse eid="PRO 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 10:15" />Makeheime ge mabam au riekelu pe namdi deda;</para>
  <para style="q" vid="PRO 10:15">magah kegahme de ngkap dila.<verse eid="PRO 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 10:16" />Mina keyime ziehi au kering;</para>
  <para style="q" vid="PRO 10:16">kemaume gie kelu dene penuide kemau gage ngngwa gai beula.<verse eid="PRO 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 10:17" />Keledeusam mzai kelume ziemne kering lampui ge bam,</para>
  <para style="q" vid="PRO 10:17">dede keledeusam mlai kelame kengkap gage tetgai dila.<verse eid="PRO 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 10:18" />Mide ngaukerau kebai teu kelame kenret rangla,</para>
  <para style="q" vid="PRO 10:18">nah ledkieesam rang kelame au kemieme ge da.<verse eid="PRO 10:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 10:19" />Sam kekiee ga kemau gah lama,</para>
  <para style="q" vid="PRO 10:19">dede cet teune eh marang kelame au kenriakme da.<verse eid="PRO 10:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 10:20" />Mina makesangme mleu au rangkanggeu kemcibe nzwa da;</para>
  <para style="q" vid="PRO 10:20">kesiame mlung ga pemi kecamnage gwale gah.<verse eid="PRO 10:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 10:21" />Mina makesangme sam mikekiee de teihemi beula,</para>
  <para style="q" vid="PRO 10:21">dede kemieme ge pe mriak kegahne tsai dila.<verse eid="PRO 10:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 10:22" />RAMPAUBE mapeu keyidung mahei teugwang beula</para>
  <para style="q" vid="PRO 10:22">nah pa cide ga lungrei kaisi lama.<verse eid="PRO 10:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 10:23" />Kesia ketei au kemieme kenggwa ge,</para>
  <para style="q" vid="PRO 10:23">dede kemteu au mina keningcingme ziemne suiyi ge.<verse eid="PRO 10:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 10:24" />Kesiame ge pa hingkela dene pecu ngam dizie,</para>
  <para style="q" vid="PRO 10:24">dede makesangme luu keneu kelabe tei beuzie.<verse eid="PRO 10:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 10:25" />Kesiame rahang ge nzwa guigwang gai eh penui gah dila,</para>
  <para style="q" vid="PRO 10:25">dede makesangme au duirwak ge nzwa kwak bammui zie.<verse eid="PRO 10:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 10:26" />Kenghetbe au pecu langkegaibe dade,</para>
  <para style="q" vid="PRO 10:26">kehiadui migei tei kerehim nzwa nah mimiak ga mika kebam nzwa.<verse eid="PRO 10:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 10:27" />RAMPAUBE mie hing ring ketie peula,</para>
  <para style="q" vid="PRO 10:27">dede mina kesiame teilung tei ndui dizie.<verse eid="PRO 10:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 10:28" />Mina makesangme keregui au penui suikeyi deda,</para>
  <para style="q" vid="PRO 10:28">dede mina kesiame mmi tei nduidi zie.<verse eid="PRO 10:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 10:29" />RAMPAUBE lampui makesangme de gumbeu la,</para>
  <para style="q" vid="PRO 10:29">dede cide kesiame de ngkap dila.<verse eid="PRO 10:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 10:30" />Mina makesangme de madaude kelien gi dilak,</para>
  <para style="q" vid="PRO 10:30">dede kesiame kideube ga lungh bam lak.<verse eid="PRO 10:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 10:31" />Mina makesangme mui gade maci buipet lula,</para>
  <para style="q" vid="PRO 10:31">dede kesiame mleu dang mpet dizie.<verse eid="PRO 10:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 10:32" />Makesangme daipai rangde mina luulu ziebi cila,</para>
  <para style="q" vid="PRO 10:32">dede kesiame mui gade au kesiabe rünne rangla.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 11:1" />RAMPAUBE riangteukwak petau kemakpe ngkau la,</para>
  <para style="q" vid="PRO 11:1">dede pa perüt samsang eh teukecu pe suiyi la.<note caller="+" style="f"><char style="fr" closed="false">11:1 </char><char style="ft" closed="false">Lev. 19:35-36; Hez. 25:13-16; Mic. 6:10-11</char></note><verse eid="PRO 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 11:2" />Ngang kecu ga, hengam gwangla,</para>
  <para style="q" vid="PRO 11:2">dede henah kegai ga maci bamla.<verse eid="PRO 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 11:3" />Keyime de makesang ne saulia la,</para>
  <para style="q" vid="PRO 11:3">dede nlumgai kelakme kengkoi ta keteine penuide ngkap dila.<verse eid="PRO 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 11:4" />Hetuketiak benai mahei pemi teilak,</para>
  <para style="q" vid="PRO 11:4">dede petaube keteine ncu ketsai gade kelibeu zie.<verse eid="PRO 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 11:5" />Makesangme ge petau ketei ne pe lampui tei mzui lula,</para>
  <para style="q" vid="PRO 11:5">dede mina kesiame penuikatei penui ta kesiane kau dizie.<verse eid="PRO 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 11:6" />Tinggwang suiyi tei kelame petaube ketei ne penuide kelibeu la,</para>
  <para style="q" vid="PRO 11:6">dede nlumgai kelakme penui hengin ne penuide keu dila.<verse eid="PRO 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 11:7" />Mina kesiame tsai dige, pe hengin de pecu ngngwa tsai dila</para>
  <para style="q" vid="PRO 11:7">nah pe kengkieng ga pe keregui kebamde magede ta dila.<verse eid="PRO 11:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 11:8" />Makesangme de keherei gade keunzia beula</para>
  <para style="q" vid="PRO 11:8">nah cide kesiame da gwang dila.<verse eid="PRO 11:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 11:9" />Nlum kemakme pa samrang le pe kidabe de ngkap dila,</para>
  <para style="q" vid="PRO 11:9">dede maci ne mina makesangme de kelilu la.<verse eid="PRO 11:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 11:10" />Makesangme lunghyi luge, namdi ge pesuiyi dila;</para>
  <para style="q" vid="PRO 11:10">kesiame tsai dige, suiyi kwa sahla.<verse eid="PRO 11:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 11:11" />Mapeu keyi teugwang Tinggwang suiyi tei kelume ziemne, namdi di si lula;</para>
  <para style="q" vid="PRO 11:11">kesiame sam ziemne namdi pangpop dila.<verse eid="PRO 11:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 11:12" />Mige pe zangme ha rang kemsia au kemie,</para>
  <para style="q" vid="PRO 11:12">dede kenriakme ge au mlei mene bam dila.<verse eid="PRO 11:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 11:13" />Ledkieesam rang kelame kengkiemsam pau dila,</para>
  <para style="q" vid="PRO 11:13">dede nlumlu kebuime ge cide hebai lula.<verse eid="PRO 11:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 11:14" />Kemteu puisau kegah ga heleuhbe kau dila,</para>
  <para style="q" vid="PRO 11:14">dede kemteume kekiee sui keteukelu gade ngkieng lula.<verse eid="PRO 11:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 11:15" />Keheibede cikemakme rangkang kehepok ga zierang teibeu cai keherei kecu ngau bi zie,</para>
  <para style="q" vid="PRO 11:15">dede sampet cinkenzwa teirau kelame kwak luzie.<verse eid="PRO 11:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 11:16" />Pe zai keyi puige kerüt ngau lula,</para>
  <para style="q" vid="PRO 11:16">dede pe zai kesiame mahei peei la.<verse eid="PRO 11:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 11:17" />Pe zai keyime ge pekatei pe ziemne gie lula,</para>
  <para style="q" vid="PRO 11:17">dede pe zai kesiame ge pekatei pecu rezam lula.<verse eid="PRO 11:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 11:18" />Mina kesiame ge pe ziehi ngaulu kerane nretla,</para>
  <para style="q" vid="PRO 11:18">dede makesangbe ling kegaibe kesangbe ziehi ngau lula.<verse eid="PRO 11:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 11:19" />Makesangme petaube tei kelame ring luzie,</para>
  <para style="q" vid="PRO 11:19">dede kemau cai zui kelame tsai dizie.<verse eid="PRO 11:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 11:20" />RAMPAUBE makesia mning kelame de ngkau la,</para>
  <para style="q" vid="PRO 11:20">dede kemau kegah lampui ga tet kelame de pa pe suila.<verse eid="PRO 11:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 11:21" />Aide cisiakte lu, kemaume saja ngau mene talak,</para>
  <para style="q" vid="PRO 11:21">dede mina makesangme leuhme de kelibeu zie.<verse eid="PRO 11:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 11:22" />Hezukeyi puige makeyi kesia cet ntsamlu kemak au</para>
  <para style="q" vid="PRO 11:22">hebak ngkie gage kecak ringgoi kekai nzwa da.<verse eid="PRO 11:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 11:23" />Mina keyime keyibe rünne hengin la,</para>
  <para style="q" vid="PRO 11:23">dede mina kesiame hengin au rata rünne.<verse eid="PRO 11:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 11:24" />Mige teizang la, dede pa hekwa kiee silu zie;</para>
  <para style="q" vid="PRO 11:24">kedage peu kerabe de herak pwabam la, peda magah gwang dizie.<verse eid="PRO 11:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 11:25" />Mbang kelame lungh yi luzie</para>
  <para style="q" vid="PRO 11:25">nah mi kedame de dui pwapeu kelabe dui ngaudai luzie.<verse eid="PRO 11:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 11:26" />Mei zwabeu rau kecube de mina reset beula,</para>
  <para style="q" vid="PRO 11:26">dede zwa kebeume peu ga mapeu keyi peurwa kai beula.<verse eid="PRO 11:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 11:27" />Sünne eh keyibe peei kelame mi suiyi peeila da,</para>
  <para style="q" vid="PRO 11:27">dede kesiabe peei kelame kesiabe ngau luzie.<verse eid="PRO 11:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 11:28" />Penui maheidung de nlum kelame kau dizie,</para>
  <para style="q" vid="PRO 11:28">dede tsing nei nzwa, mina keyime lunghyi luzie.<verse eid="PRO 11:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 11:29" />Pekatei pe kilung ga keherei teugwang kegaibe magede gum gailak,</para>
  <para style="q" vid="PRO 11:29">nah kemieme kenriakme kila tei dizie.<verse eid="PRO 11:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 11:30" />Mina makesangme au kering tsingbang nzwa dizie,</para>
  <para style="q" vid="PRO 11:30">dede zaisiet au keringriadung keuteu dila.<verse eid="PRO 11:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 11:31" />Ainie! Mina makesangme pa ngaulu kebui nsam ngau lula;</para>
  <para style="q" vid="PRO 11:31">kesiame nah kemaume daikiee gede ngau laino!<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="1PE 4:18">1 Pet. 4:18</ref></char></note><verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 12:1" />Caugame ledeukebeu de pe sui labi cipaume maci de pe suila,</para>
  <para style="q" vid="PRO 12:1">dede keledeu ngkau kelabe kemangme da.<verse eid="PRO 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 12:2" />RAMPAUBE mina keyime de ngha beula</para>
  <para style="q" vid="PRO 12:2">dede mina makesiabe riem kelame de mmau la.<verse eid="PRO 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 12:3" />Kesiabe ne migede de tei ngkieng beulu lama,</para>
  <para style="q" vid="PRO 12:3">dede mina makesangme sap teu ngkau gailak.<verse eid="PRO 12:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 12:4" />Henau keyi puige au pe nahpei peurwa ge,</para>
  <para style="q" vid="PRO 12:4">dede hengam punggwang kebeu puige au pera ketim mateei ge nzwa da. <note caller="+" style="f"><char style="fr" closed="false">12:4 </char><char style="ft" closed="false">Mac. 31:10-31</char></note><verse eid="PRO 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 12:5" />Makesangme kesangbe riem beula,</para>
  <para style="q" vid="PRO 12:5">dede kesiame ne rangkelia au mide cwala.<verse eid="PRO 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 12:6" />Mina kesiame samdung au mbailwe mide bungde teitset kera kwa bamla,</para>
  <para style="q" vid="PRO 12:6">dede kesamsangme sam ne penuide kelibeu la.<verse eid="PRO 12:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 12:7" />Mina kesiamedung de ngamdi zie nah penui gah dila,</para>
  <para style="q" vid="PRO 12:7">dede makesangme kelak saplu zie.<verse eid="PRO 12:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 12:8" />Migede pa pe maci daikiee ge bam bi kecu rehi gade twa la,</para>
  <para style="q" vid="PRO 12:8">dede makesia peusui pung kelame de masipei lama.<verse eid="PRO 12:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 12:9" />Maidakme ge tei eh kebam be yiki, kilame ge tei eh,</para>
  <para style="q" vid="PRO 12:9">n kemlang ha rang hegie eh ketyeipok kegah swa au.<verse eid="PRO 12:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 12:10" />Mina keyime pe kauruine teumaikesiabe pie teune beula,</para>
  <para style="q" vid="PRO 12:10">dede kesiame ngaukenggia bata kecangde siasüt la.<verse eid="PRO 12:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 12:11" />Pe deu ga matei kegaibe ketyeipok kekiee hekwa luzie,</para>
  <para style="q" vid="PRO 12:11">dede kemta tadung cai zui kelame au kemangme da.<verse eid="PRO 12:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 12:12" />Kenlienme mikedame dade mina kesiame rega kelube regui la,</para>
  <para style="q" vid="PRO 12:12">dede makesangme penuikatei penui ta gade petsi buipet lula.<verse eid="PRO 12:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 12:13" />Kesiame ge de pekatei pe sam kesia gage keu lula,</para>
  <para style="q" vid="PRO 12:13">dede makesangme kengngidung gade mbai lula.<verse eid="PRO 12:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 12:14" />Mige pe samrang gade makeyi kepui bui lula,</para>
  <para style="q" vid="PRO 12:14">pe bata rehi gade pecu ziehi peu kela nzwa.<verse eid="PRO 12:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 12:15" />Kemieme ge pa tetkela lampui de petau lie cetla,</para>
  <para style="q" vid="PRO 12:15">dede kemriakme ge keledeu sam de kingnei lula.<verse eid="PRO 12:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 12:16" />Kemieme ge pe rata zette la,</para>
  <para style="q" vid="PRO 12:16">dede rangkemsia siude siukemak nzwa ta kedime au kemriakme da.<verse eid="PRO 12:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 12:17" />Makesangbe rang kelabe ma petau rangla,</para>
  <para style="q" vid="PRO 12:17">dede kenret zierang keteime kenretdung rangla.<verse eid="PRO 12:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 12:18" />Macet sünne mene zette ma kerangme ge sam au kingtie le bi kedi nzwa da,</para>
  <para style="q" vid="PRO 12:18">dede kemteume sam mide teingkei beula.<verse eid="PRO 12:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 12:19" />Makesangbe samdung kelungta bamla,</para>
  <para style="q" vid="PRO 12:19">dede kenret samdung au tingkak nage ziemne gwale ma.<verse eid="PRO 12:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 12:20" />Kemau teikera cet kelame mlung ga kecwa lala,</para>
  <para style="q" vid="PRO 12:20">dede kezuyi ziemne heta teikelame da suiyi gwang la.<verse eid="PRO 12:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 12:21" />Makesangme da makesia gwang lama,</para>
  <para style="q" vid="PRO 12:21">dede kesiame da keherei le pui dila.<verse eid="PRO 12:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 12:22" />RAMPAUBE kenret kerangme de ngkau la,</para>
  <para style="q" vid="PRO 12:22">dede samsang eh lungh kelame de pe suiyi la.<verse eid="PRO 12:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 12:23" />Kenriakme ge pe maci hekam lula,</para>
  <para style="q" vid="PRO 12:23">dede kemangme penui maci kemak sah gaila.<verse eid="PRO 12:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 12:24" />Pe ba kemrime kedi tei zie,</para>
  <para style="q" vid="PRO 12:24">dede kenghetme de penui kemei tei eh peu mata teizie.<verse eid="PRO 12:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 12:25" />Lungrei bam kedime ge pe sui kau dila,</para>
  <para style="q" vid="PRO 12:25">dede sam keyi ne pesuiyi tei beula.<verse eid="PRO 12:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 12:26" />Makesangme au pe zangme ziemne puisau ge,</para>
  <para style="q" vid="PRO 12:26">dede kesiame lampui ne penuide kemau gage teugai dila.<verse eid="PRO 12:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 12:27" />Kenghetme penui peei kelabe ngau gailak,</para>
  <para style="q" vid="PRO 12:27">dede kemrime ge pemikehung mahei ngau lubui.<verse eid="PRO 12:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 12:28" />Makesang lampui ga tet kelame kering ngau lula,</para>
  <para style="q" vid="PRO 12:28">nah lampui cide ga ketsai bamlak.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 13:1" />Kemteu nabe pe pei keledeu kingnei lula,</para>
  <para style="q" vid="PRO 13:1">dede mide rangkemsiame kesiu kecude kingneilu lama.<verse eid="PRO 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 13:2" />Mige pe samrang gade ma keyidung ngau lula,</para>
  <para style="q" vid="PRO 13:2">dede pe ciem kesiame au zaisiet tyeineu lala.<verse eid="PRO 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 13:3" />Pe muigum tei kelame pe teilung kwak luzie,</para>
  <para style="q" vid="PRO 13:3">dede pe muigum kegahme pekatei pe teilung ngkap dila.<verse eid="PRO 13:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 13:4" />Mina kenghetme tyeikeneu kiee sütla dede magede ngaulu lama,</para>
  <para style="q" vid="PRO 13:4">dede mina kemrime ketyeikesak puikenlim kemnung ngau lula.<verse eid="PRO 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 13:5" />Mina kesangme kenret ngkau la,</para>
  <para style="q" vid="PRO 13:5">dede kesiame ge pekatei pe rata tei lula, nah pa hengam kepung tei dila.<verse eid="PRO 13:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 13:6" />Makesang ne penui lampui ga maukemakme de gum beula,</para>
  <para style="q" vid="PRO 13:6">dede kesia au kemau tei kelame de teingkau dila.<verse eid="PRO 13:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 13:7" />Mikangge pekatei pecu le keheime lie eh lala, dede magede bam lama,</para>
  <para style="q" vid="PRO 13:7">nah mikangge mapelane peu dila, dede mahei kesang bamla.<verse eid="PRO 13:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 13:8" />Keheime ge pe mahei teu pe teilung kelilu la,</para>
  <para style="q" vid="PRO 13:8">dede makegahme gede mide keheu lama.<verse eid="PRO 13:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 13:9" />Mina makesangme kebaa baa ha bamla,</para>
  <para style="q" vid="PRO 13:9">dede kesiame mibung tei mmüt dizie.<verse eid="PRO 13:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 13:10" />Ngang kecu ngngwa kesia rünne mna beula,</para>
  <para style="q" vid="PRO 13:10">dede keledeu keyi kingnei kelame da maci bamla.<verse eid="PRO 13:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 13:11" />Ngang eh hegie süt kedidau mahei cam reureu dila,</para>
  <para style="q" vid="PRO 13:11">dede pe bata tei eh rangkang peei kelabe heisi luzie.<verse eid="PRO 13:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 13:12" />Keregui ngauri kedidau milung pang dila,</para>
  <para style="q" vid="PRO 13:12">dede hengin kelabe teikelu au kering tsing bang geda.<verse eid="PRO 13:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 13:13" />Keledeusam mlai kelabe pekatei peda keherei punggwang lula,</para>
  <para style="q" vid="PRO 13:13">dede keledeusam de kerüt peu kelabe de ziehi peu zie.<verse eid="PRO 13:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 13:14" />Makecime keledeusam au kering duilet ge,</para>
  <para style="q" vid="PRO 13:14">ncu ketsai baih gade teu nzia beu zie.<verse eid="PRO 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 13:15" />Lungcet keyi hetwa pung lula,</para>
  <para style="q" vid="PRO 13:15">dede mide kecwame lampui au madaude penli gah.<verse eid="PRO 13:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 13:16" />Mina kemriakme keheibe keteiga macet eh teila,</para>
  <para style="q" vid="PRO 13:16">dede kemangme pe macet kegah ta keulia la.<verse eid="PRO 13:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 13:17" />Samgwa kesiame ge keherei gage cakgai dila,</para>
  <para style="q" vid="PRO 13:17">dede samgwa kesamsangme kezuyi teu gwang beula.<verse eid="PRO 13:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 13:18" />Keledeusam luu neula kemakme magah zie nah hengam ngau zie,</para>
  <para style="q" vid="PRO 13:18">dede ledeu kebeube mzai kelume da kerüt gwang zie.<verse eid="PRO 13:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 13:19" />Regui kelabe teicang kelu au tyei keneube tyei mnung kelu ge,</para>
  <para style="q" vid="PRO 13:19">dede kemangme kemau gade nreutet raula.<verse eid="PRO 13:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 13:20" />Kemteume de ngngwa tetlu, iciude nang mteu luzie,</para>
  <para style="q" vid="PRO 13:20">dede kemangme kangngwame keherei ngau zie.<verse eid="PRO 13:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 13:21" />Kemaume cai keherei suila,</para>
  <para style="q" vid="PRO 13:21">dede mina makesangme de ziehi keyi peula.<verse eid="PRO 13:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 13:22" />Mina keyime petsame de mahei lunghdiak beula,</para>
  <para style="q" vid="PRO 13:22">dede kemaume mahei au makesangme ziemne hekwa bamla.<verse eid="PRO 13:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 13:23" />Makegahme tatyei kemak luh gade ketyeipok kekiee builu bui,</para>
  <para style="q" vid="PRO 13:23">dede cide masang kemakme ne sütteu dila.<verse eid="PRO 13:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 13:24" />Pe nade ledeu kemakbe pecu hung lama,</para>
  <para style="q" vid="PRO 13:24">dede pe nade hung kelabe pecu ledeu teune beula.<verse eid="PRO 13:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 13:25" />Makesangme pa teikeneu leu tyeiset kemakta tyei bamla,</para>
  <para style="q" vid="PRO 13:25">dede kemaume mzeu bam mui zie.<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 14:1" />Mipui kemteu pui au peki tei ncuh lula,</para>
  <para style="q" vid="PRO 14:1">dede kemie pui au pekatei pe ba le cide teimsia dila.<verse eid="PRO 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 14:2" />Masang eh lungh kelame RAMPAUBE de hing eh lungh la,</para>
  <para style="q" vid="PRO 14:2">dede masang mene lungh kelabe pecu ngkaula.<verse eid="PRO 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 14:3" />Kemieme mui gade pe gim dap kera geutie ge petla</para>
  <para style="q" vid="PRO 14:3">dede kemriakme mui au penuide gum beula.<verse eid="PRO 14:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 14:4" />Kauruine kegah ga penui kwak mci bamla</para>
  <para style="q" vid="PRO 14:4">dede mei kekiee ngaulu kera au hetumseu kengkieng ga zie.<verse eid="PRO 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 14:5" />Kesamsang zierang keteime ge nret lama,</para>
  <para style="q" vid="PRO 14:5">dede kenret zierang keteime kenret ngngi mpetla,<verse eid="PRO 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 14:6" />Mide rangmsia kelame maci peeila dede ngaulu lama,</para>
  <para style="q" vid="PRO 14:6">dede macet teune kecume au maci ngau relui lula.<note caller="-" style="x"><char style="xo" closed="false">14:6 </char><char style="xt" closed="false"><ref loc="PRO 17:24">Mac. 17:24</ref></char></note><verse eid="PRO 14:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 14:7" />Kemieme dade nreu tet dilu,</para>
  <para style="q" vid="PRO 14:7">kedanemene nang pe mui gade maci ngau gailak.<verse eid="PRO 14:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 14:8" />Kemriakme maci au pekatei pe lampui cilu kera,</para>
  <para style="q" vid="PRO 14:8">dede kemieme mie au mide kecwa.<verse eid="PRO 14:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 14:9" />Kemau reca ratak tei kegai dau kemieme nui neu bamla</para>
  <para style="q" vid="PRO 14:9">dede makesangme kakga suiyi mzila.<verse eid="PRO 14:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 14:10" />N mlung suikesia de nkatei n gu</para>
  <para style="q" vid="PRO 14:10">nah cikemakme n suiyi mzi lama.<verse eid="PRO 14:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 14:11" />Mina kesiame ki teimsia dizie</para>
  <para style="q" vid="PRO 14:11">dede kemzuime ki yi reureu dizie.<verse eid="PRO 14:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 14:12" />Mina petau lie cetkela lampui ge bam,</para>
  <para style="q" vid="PRO 14:12">dede cide ketsai gage rünne ngngwa gaila.<verse eid="PRO 14:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 14:13" />Mige pelung keherei bam liede nui bam lubui</para>
  <para style="q" vid="PRO 14:13">nah suiyi kekamle suisiet ngau di lubui.<verse eid="PRO 14:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 14:14" />Masang kemakme au pe zai rehi gade pe ziehi ngau zie</para>
  <para style="q" vid="PRO 14:14">dede keyime ge au keyibe ngau zie.<verse eid="PRO 14:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 14:15" />Kemieme maleune nlum la,</para>
  <para style="q" vid="PRO 14:15">dede kemriakme pe pikiet cet teune la.<verse eid="PRO 14:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 14:16" />Kemriakme ge kesiabe de hing eh nreu tet dila</para>
  <para style="q" vid="PRO 14:16">dede kemieme au kuusüt eh rangmriak kebeusamdung mlaidi la.<verse eid="PRO 14:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 14:17" />Pe rata zette kecube au kemie tah teila</para>
  <para style="q" vid="PRO 14:17">nah makesia ciem riem kelame de mi ngkaula.<verse eid="PRO 14:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 14:18" />Macikemakme kemie gum lula,</para>
  <para style="q" vid="PRO 14:18">dede kemriakme de maci teu ziehi tei beula.<verse eid="PRO 14:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 14:19" />Mina kesiamedung mina keyime dwaga keumie zie</para>
  <para style="q" vid="PRO 14:19">nah mina kenlienme makesangme kirie ga keumie zie.<verse eid="PRO 14:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 14:20" />Makegahbe de au pe kangngwame nede ngkaula,</para>
  <para style="q" vid="PRO 14:20">dede makeheibe au pe zangna kiee sütla.<verse eid="PRO 14:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 14:21" />Pe kidame de ncau kelame au kemau teibam dida,</para>
  <para style="q" vid="PRO 14:21">dede makegahme de ngha kelame au samlam pungtu.<verse eid="PRO 14:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 14:22" />Makesia cet nah riem kelame kemau teidi la meni?</para>
  <para style="q" vid="PRO 14:22">Dede makeyi tei kera riem kelame mi dade samkakkelu samsang nah nlumlu kebui ngau lula.<verse eid="PRO 14:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 14:23" />Mrisüt kegai dau kemmi ngau lula,</para>
  <para style="q" vid="PRO 14:23">dede makerang rünne dige, cide magah gage teu gwanggai beula.<verse eid="PRO 14:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 14:24" />Kemteume peurwa au penui mahei da</para>
  <para style="q" vid="PRO 14:24">dede kemieme kemie au penuide kemie rünne teugwang si beula.<verse eid="PRO 14:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 14:25" />Makesang zierangme mide kelibeu la,</para>
  <para style="q" vid="PRO 14:25">dede kemau zierangme kenret ngngi mpetla.<verse eid="PRO 14:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 14:26" />Mige RAMPAUBE de rüt keludau, pa pecu kenlum bam lula;</para>
  <para style="q" vid="PRO 14:26">ma aidung au pe name de gumlu kera kengking bam ge nzwa zie.<verse eid="PRO 14:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 14:27" />RAMPAUBE mie kehing au kering duilet ge lie,</para>
  <para style="q" vid="PRO 14:27">iciu eh mige ketsai baih gade nreulu kerane.<verse eid="PRO 14:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 14:28" />Hegwangpei kendu au pe mina kekiee ge kebam gade ngau lula</para>
  <para style="q" vid="PRO 14:28">dede mina si mecai pe au magede ma.<verse eid="PRO 14:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 14:29" />Pelung ketieme ge au kecikecet keyi bamla,</para>
  <para style="q" vid="PRO 14:29">dede pe rata zette kelame au kemie keulia bam da.<verse eid="PRO 14:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 14:30" />Helung kenciep mipum tei mring beula,</para>
  <para style="q" vid="PRO 14:30">dede mide ngau miriak kecu mira teitim dila.<verse eid="PRO 14:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 14:31" />Kegahme de mneu kelabe pecu Damkegaibe de reset bam da,</para>
  <para style="q" vid="PRO 14:31">dede kegahme de ngha kelabe pecu kerüt peu bam da.<verse eid="PRO 14:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 14:32" />Mina kesiame de pe bata kesiabedung ne teu ngkau dila,</para>
  <para style="q" vid="PRO 14:32">dede makesangme au ketsai gade de kemsiu ngau lula.<verse eid="PRO 14:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 14:33" />Maci au lungcet keyime lung ga bamla,</para>
  <para style="q" vid="PRO 14:33">dede kemieme kakgade pa pecu peu ci lula.<verse eid="PRO 14:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 14:34" />Ma petaube tei luge heleuhbe de teu ncuh lula</para>
  <para style="q" vid="PRO 14:34">dede kemau au keheibe ziemne hengam ge.<verse eid="PRO 14:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 14:35" />Hegwangpei mriak eh bata teikela kilame de pe suila,</para>
  <para style="q" vid="PRO 14:35">dede pe rata au hengam ta tei kecume ziemne.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 15:1" />Sam kenciep teu keli kegai gade rata teu nreu lula,</para>
  <para style="q" vid="PRO 15:1">dede sam kesia rata tei ncuh gaila.<verse eid="PRO 15:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 15:2" />Kemteume mleu maci de ketwa peula</para>
  <para style="q" vid="PRO 15:2">dede kemieme mui gade kemie sam lwa petla.<verse eid="PRO 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 15:3" />RAMPAUBE miak au maleune gala,</para>
  <para style="q" vid="PRO 15:3">kesiame nah keyime de kwa eh.<verse eid="PRO 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 15:4" />Teikengkei mleu au kering tsingbang ge,</para>
  <para style="q" vid="PRO 15:4">dede cwakela mleu au rabe de teitset dila.<verse eid="PRO 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 15:5" />Kemieme ge pe pei ledeu kebeude mlai la,</para>
  <para style="q" vid="PRO 15:5">dede ledeu kegai gade ci kelume au kemriakme.<verse eid="PRO 15:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 15:6" />Makesangme kiga au mahei kekiee bamla,</para>
  <para style="q" vid="PRO 15:6">dede kesiame mangau au pecu tei keherei dila.<verse eid="PRO 15:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 15:7" />Kemteume muileu maci teizang beula</para>
  <para style="q" vid="PRO 15:7">dede kemieme mlung au ciciu lama.<verse eid="PRO 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 15:8" />RAMPAUBE mina kesiame ratakdung ngaurau la</para>
  <para style="q" vid="PRO 15:8">dede kemzuime kekie pe suila.<verse eid="PRO 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 15:9" />RAMPAUBE au kesia me de ngkau la</para>
  <para style="q" vid="PRO 15:9">dede pa au petau kecube peei kelame de pesui la.<verse eid="PRO 15:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 15:10" />Lampui petaube püt kedime keherei kecule ledeu kera kwa bamla,</para>
  <para style="q" vid="PRO 15:10">nah keledeu ngkau kelabe au tsai dizie.<verse eid="PRO 15:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 15:11" />Sheol<note caller="+" style="f"><char style="fr" closed="false">15:11 </char><char style="fq" closed="false">Sheol</char><char style="ft" closed="false">: Ketsaime deu</char></note> nah kengkap RAMPAUBE dwaga let pwa bam,</para>
  <para style="q" vid="PRO 15:11">iciu cai mina lungning dainzwa mbai lulai?<verse eid="PRO 15:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 15:12" />Mide kii kelame au pecu ledeu kecu pe sui lama;</para>
  <para style="q" vid="PRO 15:12">pa kemriakme da mie lak.<verse eid="PRO 15:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 15:13" />Misui yi kebam dau mi zu nuirum bamla,</para>
  <para style="q" vid="PRO 15:13">dede lungrei misui tei tsai dila.<verse eid="PRO 15:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 15:14" />Lungcet keyime maci peei la</para>
  <para style="q" vid="PRO 15:14">dede kemieme mui au kemie sam le pui bamla.<verse eid="PRO 15:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 15:15" />Keherei kelame teilung au hairei tei bam muila,</para>
  <para style="q" vid="PRO 15:15">dede misuiyi kebamme hengyi bam muila.<verse eid="PRO 15:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 15:16" />RAMPAUBE mie hing eh manage kebam au yiki</para>
  <para style="q" vid="PRO 15:16">mahei kekiee ge eh daitei ziebi cimene kebam swade.<verse eid="PRO 15:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 15:17" />Keku bam eh ngngwa ginei ketyeibe au</para>
  <para style="q" vid="PRO 15:17">kengaurau eh heteih yitube tyei kebam swade yiki.<verse eid="PRO 15:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 15:18" />Pe rata kesiame kesamlim kecu teucuh beula,</para>
  <para style="q" vid="PRO 15:18">dede pelung ketieme ngngwa keyi teugwang beula.<verse eid="PRO 15:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 15:19" />Kenghetme lampui au hetu rie nzwa delie,</para>
  <para style="q" vid="PRO 15:19">dede makesangme lampui au puidiki tei pwa kebam nzwa lie.<verse eid="PRO 15:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 15:20" />Kemteu nabe pe pei suiyi tei beula,</para>
  <para style="q" vid="PRO 15:20">dede kemiebe pe puide ncaula.<verse eid="PRO 15:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 15:21" />Pe peusui tei kemakme kemie ta pe suila,</para>
  <para style="q" vid="PRO 15:21">dede kecikecet kebamme lampui kemzuibe pwala.<verse eid="PRO 15:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 15:22" />Puisau kegah ga mariem mau dila,</para>
  <para style="q" vid="PRO 15:22">dede puisau kekiee kebam ga matei petau lula.<verse eid="PRO 15:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 15:23" />Mige ma petau tei eh keli kegai dau pe suiyi lula;</para>
  <para style="q" vid="PRO 15:23">peting siakdau sam petaube rang kegai daiyi gede yino!<verse eid="PRO 15:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 15:24" />Kemriakme kering lampui lebie pwa hangla,</para>
  <para style="q" vid="PRO 15:24">iciu eh penui Sheol<note caller="+" style="f"><char style="fr" closed="false">15:24 </char><char style="fq" closed="false">Sheol</char><char style="ft" closed="false">: Ketsaime deu</char></note> gade nreu tet dilu kerane.<verse eid="PRO 15:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 15:25" />RAMPAUBE ngang kelame ki teimsia dila,</para>
  <para style="q" vid="PRO 15:25">dede pa hemipuidung mabam gum beula.<verse eid="PRO 15:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 15:26" />RAMPAUBE mina kesiame kecet ngkaula,</para>
  <para style="q" vid="PRO 15:26">dede ngaukenggia samdung au pe dwade mci.<verse eid="PRO 15:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 15:27" />Keregame pe kilung ga ma kehebwak teugwang beula,</para>
  <para style="q" vid="PRO 15:27">dede hetauhenim ngkau kelame ring luzie.<verse eid="PRO 15:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 15:28" />Kemzuime au sam keli kecu dwa pe lung gade macetla,</para>
  <para style="q" vid="PRO 15:28">dede mina kesiame au makesia leune rangla.<verse eid="PRO 15:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 15:29" />RAMPAUBE au mina kesiame dade mdei dila,</para>
  <para style="q" vid="PRO 15:29">dede pa kemzuime kekie kingneila.<note caller="-" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="JHN 9:31">Jhn. 9:31</ref></char></note><verse eid="PRO 15:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 15:30" />Mimiak kebaa au milung ga suiyi keugwang beula,</para>
  <para style="q" vid="PRO 15:30">nah samliakeyibe au mipum teihemi beula.<verse eid="PRO 15:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 15:31" />Mina kangge lung petau tei kera ncu ledeu kebeu dau nang kingnei lucai,</para>
  <para style="q" vid="PRO 15:31">nang kemriakme kakga bam luzie.<verse eid="PRO 15:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 15:32" />Pecu ledeu kegaide mlai kelabe pekatei pecu ncau bam da,</para>
  <para style="q" vid="PRO 15:32">dede pecu ledeu kebeude kingnei kelube maciki lula.<verse eid="PRO 15:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 15:33" />RAMPAUBE de kehing au maci ledeu beula,</para>
  <para style="q" vid="PRO 15:33">nah mitwa pung kemak dwa henah railu maisia.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 16:1" />Mina da heciem riem kecu bam,</para>
  <para style="q" vid="PRO 16:1">dede sam keli kera au RAMPAUBE dade gwang.<verse eid="PRO 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 16:2" />Mige pa teikela leune pe dade petau lie cetla,</para>
  <para style="q" vid="PRO 16:2">dede RAMPAUBE pe lungcetdung piela.<verse eid="PRO 16:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 16:3" />RAMPAUBE dage n ta pelane kaibeu lu,</para>
  <para style="q" vid="PRO 16:3">iciude n mariemdung teicang luzie.<verse eid="PRO 16:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 16:4" />RAMPAUBE maleune de makie ge ziemne teigai,</para>
  <para style="q" vid="PRO 16:4">kesiame de de kengkap benai ziemne teigai.<note caller="-" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="COL 1:16">Col. 1:16</ref></char></note><verse eid="PRO 16:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 16:5" />RAMPAUBE ngang kelame de ngkaula,</para>
  <para style="q" vid="PRO 16:5">dede aide cisiak delu: penui au saja ngau mene talak.<verse eid="PRO 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 16:6" />Samkakkelu samsang nah kenlum gade kemaudung gi dida,</para>
  <para style="q" vid="PRO 16:6">nah RAMPAUBE de kerüt gade mina kesiabe dade nreu lula.<verse eid="PRO 16:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 16:7" />Mige RAMPAUBE suiyi tei luge,</para>
  <para style="q" vid="PRO 16:7">pe ngauraume de peu pecu ngngwa kezuyilu kera tei beula.<verse eid="PRO 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 16:8" />Ma keceuna ge masang delwe ngaukelu au</para>
  <para style="q" vid="PRO 16:8">petaukemak gade ma kekiee ge ngaukelu swade yiki.<verse eid="PRO 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 16:9" />Mige pelung gade matei kera riem lula,</para>
  <para style="q" vid="PRO 16:9">dede RAMPAUBE pe pikietdung sau beula.<verse eid="PRO 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 16:10" />Hegwangpei muileu ga mariem keyi bam,</para>
  <para style="q" vid="PRO 16:10">pe mui kemzuibe cwadi kerabe ma.<verse eid="PRO 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 16:11" />Makesang riangteukwak RAMPAUBE dade gwangla,</para>
  <para style="q" vid="PRO 16:11">perak ga kemdetkang pelane pe bata.<verse eid="PRO 16:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 16:12" />Hegwangme ma kesiadung tei kecudau, cidung au ngkau kerabe,</para>
  <para style="q" vid="PRO 16:12">kedanemene hegwangbam au petaube ketei gade teingkieng lu kecune.<verse eid="PRO 16:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 16:13" />Hegwangpei kesangbe kerang muileu de pe suila,</para>
  <para style="q" vid="PRO 16:13">nah pa kesangbe kerangme de hungla.<verse eid="PRO 16:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 16:14" />Hegwangpei rata au ketsai samgwame da,</para>
  <para style="q" vid="PRO 16:14">dede kemteume au pe rata tei ncieplu kera teila.<verse eid="PRO 16:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 16:15" />Hegwangpei zu ga kebaa ga kering bamla,</para>
  <para style="q" vid="PRO 16:15">nah pe suiyi au heriak tingdau tingrui teugwang beu kela hemwa nzwa da.<verse eid="PRO 16:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 16:16" />Kemteu ngaukelu au kecak swade daikenzwa gede yi no.</para>
  <para style="q" vid="PRO 16:16">Rangkanggeu swade kecikecet ngaulu kera kedetlu kerabe.<verse eid="PRO 16:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 16:17" />Kemzuime puidiki kesiabe dade nreu tet dila,</para>
  <para style="q" vid="PRO 16:17">pe lampui gum kelabe pe teilung kelilu la.<verse eid="PRO 16:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 16:18" />Kekap dwa ngang kecu gwangla,</para>
  <para style="q" vid="PRO 16:18">nah mide mning mdi kecudwa kau kecu gwangla.<verse eid="PRO 16:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 16:19" />Hegie kelame de ngngwa sütkelu maa mzi kecu swa au</para>
  <para style="q" vid="PRO 16:19">kegahme kakga henah kelube yiki.<verse eid="PRO 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 16:20" />Pecu ledeu kegaidung cet teune kegaime keyibe ngau luzie,</para>
  <para style="q" vid="PRO 16:20">nah RAMPAUBE de nlum kelame de samlam beuzie.<verse eid="PRO 16:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 16:21" />Kemteume de macet teune kecume lie la,</para>
  <para style="q" vid="PRO 16:21">nah sam keyi ledeu kecu ciem teihemi lula.<verse eid="PRO 16:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 16:22" />Kemteume ziemne maci au kering duilet ge,</para>
  <para style="q" vid="PRO 16:22">dede kemangme keledeu au penui kemie nzwa da.<verse eid="PRO 16:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 16:23" />Kemriakme mlung au penui mui puisaube,</para>
  <para style="q" vid="PRO 16:23">nah penui muileu gage luulu kebui kaisi beula.<verse eid="PRO 16:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 16:24" />Sam kenciep au heliadui nzwa,</para>
  <para style="q" vid="PRO 16:24">rabe ziemne yi nah mira teingkei beula.<verse eid="PRO 16:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 16:25" />Mina petau lie cetkela lampui ge bam,</para>
  <para style="q" vid="PRO 16:25">dede cide ketsai gage ngngwa beula.<verse eid="PRO 16:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 16:26" />Maketeibe pe taktyeipok ziemne matei heriki lula,</para>
  <para style="q" vid="PRO 16:26">pe mzeu ne pecu kecung beula.<verse eid="PRO 16:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 16:27" />Kemta kauge makehebwak tei ncuh beula,</para>
  <para style="q" vid="PRO 16:27">nah pe marang au ru ketei mi ge nzwa.<verse eid="PRO 16:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 16:28" />Kesiame makehebwak tei ncuh beula,</para>
  <para style="q" vid="PRO 16:28">nah letkiee sam zangna keyime de de teuntsam dila.<verse eid="PRO 16:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 16:29" />Pe zai kesiame pe kidabe dade kenret rangla,</para>
  <para style="q" vid="PRO 16:29">nah pecu lampui kesia le ge nzanggai beula.<verse eid="PRO 16:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 16:30" />Miaklisau kelame makesiadung cet nah riem bamla;</para>
  <para style="q" vid="PRO 16:30">muilim tip kebamme makesia teugwang beula.<verse eid="PRO 16:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 16:31" />Mipeutam kepu au kendu peurwa ge;</para>
  <para style="q" vid="PRO 16:31">cide au petau tei eh lunghkelu gade ngau lula.<verse eid="PRO 16:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 16:32" />Reugwame ge tei kera swade mi rata mzet kemakbe yiki,</para>
  <para style="q" vid="PRO 16:32">nah namdi ngam kelube swade pekatei pe rabe de kezeu kelube ngkieng ki.<verse eid="PRO 16:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 16:33" />Ma cilu kerane dacak la,</para>
  <para style="q" vid="PRO 16:33">dede RAMPAUBE dade samli gwangla.<note caller="-" style="x"><char style="xo" closed="false">16:33 </char><char style="xt" closed="false"><ref loc="ACT 1:26">Bat. 1:26</ref></char></note><verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 17:1" />Zing de eh tangku kecangh ketaknage ketei au,</para>
  <para style="q" vid="PRO 17:1">kilung kenggi le pui eh hengyi bam kecu swa yiki lie.<verse eid="PRO 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 17:2" />Kila kemriakme hengam ketei nabe reu dizie</para>
  <para style="q" vid="PRO 17:2">nah caireiswacingme ge nzwa mapwa pelie ngau lubui.<verse eid="PRO 17:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 17:3" />Teikemci li au rangkanggeu ziemne nah mimang mangdi au kecak ziemne,</para>
  <para style="q" vid="PRO 17:3">dede RAMPAUBE helung teimci beula.<note caller="-" style="x"><char style="xo" closed="false">17:3 </char><char style="xt" closed="false"><ref loc="1PE 1:17">1 Pet. 1:17</ref></char></note><verse eid="PRO 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 17:4" />Kemau keteime kesiame samdung kingnei la,</para>
  <para style="q" vid="PRO 17:4">kenretme ge kenretsam kingnei la.<verse eid="PRO 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 17:5" />Kegahme de rangmsia kelame penuide Damkegaibe de kii la,</para>
  <para style="q" vid="PRO 17:5">nah mi kedame kengkap pe suiyi kelabe saja ngau mene talak.<verse eid="PRO 17:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 17:6" />Kecingme peurwa au pe tsamedung da</para>
  <para style="q" vid="PRO 17:6">nah pepui pepei au pena me de kerüt teugwang beula.<verse eid="PRO 17:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 17:7" />Kemieme ge marang keci au zeu ma;</para>
  <para style="q" vid="PRO 17:7">hegwangme kenret kerang au zeu me gwareu.<verse eid="PRO 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 17:8" />Hetauhenim kepeube dwade cide au kereka tsukang ge nzwa;</para>
  <para style="q" vid="PRO 17:8">pa nreu kegai leu ga pa teidau lula.<verse eid="PRO 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 17:9" />Keheibe de kemau tei kegaime mau gibeu kedibe au keku peei la,</para>
  <para style="q" vid="PRO 17:9">dede kemau teikegai de rang daidai kecume zangna keyide teipang dila.<verse eid="PRO 17:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 17:10" />Makecime de kesiu kegai au kemieme gede</para>
  <para style="q" vid="PRO 17:10">pia haige dap kecu swade maci si lula.<verse eid="PRO 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 17:11" />Mina kesiame makehebwak gwale peei lama,</para>
  <para style="q" vid="PRO 17:11">cine pe zai kesia samgwame de pe dage langgai zie.<verse eid="PRO 17:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 17:12" />Kemangme gede pe kemie ta teibam eh dau kecu swa au</para>
  <para style="q" vid="PRO 17:12">hegumpui pena rega teu kedi puige de redau kecube yiki.<verse eid="PRO 17:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 17:13" />Mige ma keyibe ziemne kesiabe peu caili cai,</para>
  <para style="q" vid="PRO 17:13">kesiabe madaude peki püt lak.<verse eid="PRO 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 17:14" />Kesamlim kendeu au mige dui reu pwa kehei leune gage kai kegai nzwa da,</para>
  <para style="q" vid="PRO 17:14">cine kehebwak petdi kemakne ge nreu tet dilu.<verse eid="PRO 17:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 17:15" />Kemaume de peu tet kedibe nah kesamsangme de mmau kelabe,</para>
  <para style="q" vid="PRO 17:15">kenana RAMPAUBE ngkaula.<verse eid="PRO 17:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 17:16" />Kemieme ge daitei maci kepei gage rangkang mpet bam lai,</para>
  <para style="q" vid="PRO 17:16">kedanemene peda maci lu kera peusui gahlu?<verse eid="PRO 17:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 17:17" />Zangname ge pe keku keulia bam muila,</para>
  <para style="q" vid="PRO 17:17">nah caireiswacingme au keherei kecudau kemapie kerane mnalu.<verse eid="PRO 17:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 17:18" />Mina pe peusui kegahme teipang gai kelak sampet teila,</para>
  <para style="q" vid="PRO 17:18">nah pe kidabe paudung rui kera püt pung dila.<verse eid="PRO 17:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 17:19" />Ma kehebwak pe sui kelame kemau pe suila;</para>
  <para style="q" vid="PRO 17:19">pe kikam pi tei huzu kecume keherei peei bam da.<verse eid="PRO 17:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 17:20" />Mina pe lung kengkoime magede keyi ngaulu lama;</para>
  <para style="q" vid="PRO 17:20">petau kemakbe rang kelame kengkap gage kaugai dila.<verse eid="PRO 17:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 17:21" />Kemieme pui pei au pekatei pe dage lungrei punggwang gaila,</para>
  <para style="q" vid="PRO 17:21">nah kemie nabe pei au suiyi bam lama.<verse eid="PRO 17:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 17:22" />Misui yi kebam au mipum tei mmi beula,</para>
  <para style="q" vid="PRO 17:22">dede misui sia kecu au mira tei cangh dila.<verse eid="PRO 17:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 17:23" />Mina kesiame mbai eh hetauhenim keu lula,</para>
  <para style="q" vid="PRO 17:23">tutiak petau kemakbe tiak beula.<verse eid="PRO 17:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 17:24" />Kemriakme maci pie bamla,</para>
  <para style="q" vid="PRO 17:24">dede kemieme kideutudung pie bamla.<verse eid="PRO 17:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 17:25" />Kemie nage au pepei lungrei</para>
  <para style="q" vid="PRO 17:25">nah pecu mnakelu pui ziemne suisiet ge.<verse eid="PRO 17:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 17:26" />Kemzuibe de saja peu kecu au petau ma;</para>
  <para style="q" vid="PRO 17:26">mede kenlangme pe masang kebamme de dap kecu petau ma.<verse eid="PRO 17:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 17:27" />Makecime marang kie lama,</para>
  <para style="q" vid="PRO 17:27">nah kecikecet kebamme pelung tiela.<verse eid="PRO 17:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 17:28" />Kemieme zing de bamcai pecu au kemriakme gelie cetla;</para>
  <para style="q" vid="PRO 17:28">pa marang mene bam cai, pecu kemriakme ge lie bamla.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 18:1" />Mina kedame de ncüt kemakme pekatei pe hengin peeila,</para>
  <para style="q" vid="PRO 18:1">nah pa tutiak kemzuibe leune de ngngwa rang repia lala.<verse eid="PRO 18:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 18:2" />Kemieme ge kecikecet gade magede pe suiyi ngaulu lama,</para>
  <para style="q" vid="PRO 18:2">dede pe lungning keuliakegai rünne gade.<verse eid="PRO 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 18:3" />Kemaume ge kegwang dau, makesia nzang gwangla,</para>
  <para style="q" vid="PRO 18:3">kengngam nah mide rangkemsia de si eh.<verse eid="PRO 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 18:4" />Mige samdung au duikedi nzwa cuk;</para>
  <para style="q" vid="PRO 18:4">maci duilet au hereuki duilwa kebam nzwa da.<verse eid="PRO 18:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 18:5" />Kemaube lam pwa kecu petau ma,</para>
  <para style="q" vid="PRO 18:5">mede maukemakbe de peu kemzuibe ngaulu ta kedi.<verse eid="PRO 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 18:6" />Kemieme ge kesamlim peda teugwang lula,</para>
  <para style="q" vid="PRO 18:6">nah pe mui kedap ge kiela.<verse eid="PRO 18:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 18:7" />Kemieme ge sam au pekatei pecu tei kengkap,</para>
  <para style="q" vid="PRO 18:7">nah pe sam le pekatei pecu baih gage keu lula.<verse eid="PRO 18:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 18:8" />Ledkieesam kerang au taktyei nggumsüt kecu nzwa,</para>
  <para style="q" vid="PRO 18:8">nah cidungde mipum lung ga gwang dila.<verse eid="PRO 18:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 18:9" />Heta tei kenghetme ge au</para>
  <para style="q" vid="PRO 18:9">matei msiasüt kelame ge sinabe.<verse eid="PRO 18:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 18:10" />RAMPAUBE zi au tsukwa kehu kengkieng ge;</para>
  <para style="q" vid="PRO 18:10">cika makesangme pak mie eh kwak lula.<verse eid="PRO 18:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 18:11" />Keheime ge mabam au pe namdi riekelu deda,</para>
  <para style="q" vid="PRO 18:11">nah pe kemning gade cide au tsukwa kecehu ge nzwa.<verse eid="PRO 18:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 18:12" />Mige kau kemak dwa pe lung hegie bamla,</para>
  <para style="q" vid="PRO 18:12">dede henah gai mai ketwa ngau gailak.<verse eid="PRO 18:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 18:13" />Mige sam kingnei rai mene sam keli cai,</para>
  <para style="q" vid="PRO 18:13">cide au kemie nah hengam.<verse eid="PRO 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 18:14" />Mige mateei kebamdau rabe ne pecu peu ringbam luzie,</para>
  <para style="q" vid="PRO 18:14">dede rabe de rezam dicai caune lia lulai?<verse eid="PRO 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 18:15" />Kemriakme maci ngau lula,</para>
  <para style="q" vid="PRO 18:15">nah makecime cide kingnei kera peei bamla.<verse eid="PRO 18:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 18:16" />Mige mtamapeu kepeu de ziemne</para>
  <para style="q" vid="PRO 18:16">mina kenlangme de redaulu kera lampui ngkeibeu lubui.<verse eid="PRO 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 18:17" />Hetiakbam gade marang keraibe pecu renia kebambe gwang ma keteucu kemaktane</para>
  <para style="q" vid="PRO 18:17">pe be petau kecu nzwa bamla.<verse eid="PRO 18:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 18:18" />Dacak ketei kesamlim kecu tei ndui beula,</para>
  <para style="q" vid="PRO 18:18">nah kengkiengme hangna renia kebamde kezeu beula.<verse eid="PRO 18:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 18:19" />N kibaume de ngha lu iciude penui ncu namdi kengkieng kirie nzwa gum beuzie,</para>
  <para style="q" vid="PRO 18:19">dede nang penuide ngngwa kesamlim cai, penui n ziemne kikamdung ngkui dizie.<verse eid="PRO 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 18:20" />Sam keyi au taktyei keyi ketyei nzwa mnung lula,</para>
  <para style="q" vid="PRO 18:20">sam petaube kemnung teugwang beula.<verse eid="PRO 18:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 18:21" />Ketsai nah kering au mi mleu ne kezeu pwabam,</para>
  <para style="q" vid="PRO 18:21">nah mi mleu de hung kelame cide tsi tyei zie.<verse eid="PRO 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 18:22" />Henau keyi ngau kelube makeyi ge ngau luda;</para>
  <para style="q" vid="PRO 18:22">nah RAMPAUBE dade suiyi ngau lula.<verse eid="PRO 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 18:23" />Kegahme ngaugia kiela,</para>
  <para style="q" vid="PRO 18:23">dede makeheibe sam siasüt eh keli la.<verse eid="PRO 18:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 18:24" />Kangge zangna kekiee kebam rangla, nah penui ne pecu teimsia dila,</para>
  <para style="q" vid="PRO 18:24">dede zangna kangge au caiherei swacing swade nna kila.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 19:1" />Magah liede samsang eh kebambe au</para>
  <para style="q" vid="PRO 19:1">kemieme ge sam kesia rangkela swa yiki.<verse eid="PRO 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 19:2" />Maci si mene kehengin kebam au yi ma,</para>
  <para style="q" vid="PRO 19:2">nah pak nzet süt kecume lampui pak mau dila.<verse eid="PRO 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 19:3" />Mige pekatei pe mie le pe teilung ngkap dila,</para>
  <para style="q" vid="PRO 19:3">nah pe mlung RAMPAUBE de mmau la.<verse eid="PRO 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 19:4" />Keheime zangna kekieege ngausi lula,</para>
  <para style="q" vid="PRO 19:4">dede kegahme ge au pe zangna kebam kecamnage de dade teuntsam dila.<verse eid="PRO 19:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 19:5" />Kenret zierang tei kelame de saja peu mene talak,</para>
  <para style="q" vid="PRO 19:5">nah kenret rang kelame mbai gailak.<verse eid="PRO 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 19:6" />Mina kekieege mbang eh peu kelabe dade kengha kiela,</para>
  <para style="q" vid="PRO 19:6">nah mileune de mta mapeudung peu kelabe zangme teineu la.<verse eid="PRO 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 19:7" />Kegahme ge pe sinamedung kecang de pecu ngkau la;</para>
  <para style="q" vid="PRO 19:7">pe zangme pe dade tet mdei kedimedung de daikenzwa gede pecu ngau ngkau lai!</para>
  <para style="q" vid="PRO 19:7">Pa penuide qu gai, dede penui au tet dida.<verse eid="PRO 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 19:8" />Maci ngaulu kera tei kelabe pe teilung hungla;</para>
  <para style="q" vid="PRO 19:8">kecikecet kainzeu kelube ma keyibe ngaulu zie.<verse eid="PRO 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 19:9" />Kenret zierang tei kelame de saja peu mene talak,</para>
  <para style="q" vid="PRO 19:9">nah kenret rang kelame de ngkap dizie.<verse eid="PRO 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 19:10" />Kemieme ge lungh kehega eh lungh kecu zeu ma,</para>
  <para style="q" vid="PRO 19:10">kilame ge kedime reu di kera petau kemak nzwa.<verse eid="PRO 19:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 19:11" />Pe lungcet keyime pe rata kezeu lula,</para>
  <para style="q" vid="PRO 19:11">nah pe dage kemau teikegai gi kebeu pe kendu ge.<verse eid="PRO 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 19:12" />Hegwangpei rata au hingho kemra nzwa,</para>
  <para style="q" vid="PRO 19:12">dede pezai keyi au tseheinei ga hezin nzwa.<verse eid="PRO 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 19:13" />Hena kemang nabe au pe pei de kekap teu gwang beula,</para>
  <para style="q" vid="PRO 19:13">nah henau samrang repia kebam pui au dui zau jüja kebam nzwa da.<verse eid="PRO 19:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 19:14" />Mige ki nah mahei pe puipei dade gum lula,</para>
  <para style="q" vid="PRO 19:14">dede makeci nau au RAMPAUBE ne peula.<verse eid="PRO 19:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 19:15" />Kenghetme ge zip zing eh bamla,</para>
  <para style="q" vid="PRO 19:15">dede bata tei keraume mzeu eh bam zie.<verse eid="PRO 19:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 19:16" />Tinggwang aja mzai kelume pe teilung gumkwak lula,</para>
  <para style="q" vid="PRO 19:16">dede mige pe lampuidung cetla kemakbe tsai zie.<verse eid="PRO 19:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 19:17" />Kegahme de ngaunggia kelame RAMPAUBE de releu beu bamda,</para>
  <para style="q" vid="PRO 19:17">nah pa tei kegaide de pa pecu rui pwapeu daizie.<note caller="-" style="x"><char style="xo" closed="false">19:17 </char><char style="xt" closed="false"><ref loc="MAT 25:40">Mat. 25:40</ref></char></note><verse eid="PRO 19:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 19:18" />N name hena eh maci lu kebui dauge ledeu beulu,</para>
  <para style="q" vid="PRO 19:18">nah nang pecu ketsai gage kaidi kera cetso.<verse eid="PRO 19:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 19:19" />Pe rata kesiame de saja peu maisia;</para>
  <para style="q" vid="PRO 19:19">nang pecu kelibeu cai, nang pekenabe de tei dai kerabe.<verse eid="PRO 19:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 19:20" />Keledeusam kingnei lu delwe cide de luulu,</para>
  <para style="q" vid="PRO 19:20">iciude n teilung kekamle gwang de nang mriak luzie.<verse eid="PRO 19:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 19:21" />Minadung mlung ga mariem kekiee ge bam lubui,</para>
  <para style="q" vid="PRO 19:21">dede RAMPAUBE suibe rünne tei zie.<verse eid="PRO 19:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 19:22" />Minadung lukeneu au masang kecu,</para>
  <para style="q" vid="PRO 19:22">nah kegahme au kenretme swade yiki.<verse eid="PRO 19:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 19:23" />RAMPAUBE de kerüt kering gage mina de saugai beula,</para>
  <para style="q" vid="PRO 19:23">keheibe de cide kebambe nnung luzie</para>
  <para style="q" vid="PRO 19:23">nah rezam lu kebui gade kwak luzie.<verse eid="PRO 19:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 19:24" />Kenghetme gili gage pe ba kaila;</para>
  <para style="q" vid="PRO 19:24">pa pemui gage de pwa nghang daigai lama.<verse eid="PRO 19:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 19:25" />Mide henui tei kelame de saja peulo, iciude kemangme mriak luzie;</para>
  <para style="q" vid="PRO 19:25">makecime de ledeu lo, iciude penui maci silu zie.<verse eid="PRO 19:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 19:26" />Pe pei mahei keuteu nah pe puide gwagi kedibe au</para>
  <para style="q" vid="PRO 19:26">kengngam nah hengam teu gwangbeu kela napei ge da.<verse eid="PRO 19:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 19:27" />A na, nang keledeu samdung kingnei ta dicai,</para>
  <para style="q" vid="PRO 19:27">nang maci samdung gade mdei tet dizie.<verse eid="PRO 19:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 19:28" />Masang kemak zierang keteibe au kemzeube de rangmsia la,</para>
  <para style="q" vid="PRO 19:28">nah kenlienme sam kemaudung mnwa dila.<verse eid="PRO 19:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 19:29" />Mide rangmsia kelame de mmau kera</para>
  <para style="q" vid="PRO 19:29">nah kemieme de dap kera mtei pwabam.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 20:1" />Zau au mide kii kela ge nah zau kengkingbe au regi kela ge;</para>
  <para style="q" vid="PRO 20:1">zausak kecune pe lampui cita kedi keheibe de kemriakme ma.<verse eid="PRO 20:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 20:2" />Hegwangpei de kehing au hingho mra kebamde de hing kecu nzwa da;</para>
  <para style="q" vid="PRO 20:2">pe rata tei kecume pe teilung ngkap dila.<verse eid="PRO 20:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 20:3" />Kesamlim kecu mbai kelu au keheibe ziemne ma keyi ge,</para>
  <para style="q" vid="PRO 20:3">dede kemieme kesamlim bangdwa beula.<verse eid="PRO 20:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 20:4" />Kenghetme herei tingdau luh puu lama;</para>
  <para style="q" vid="PRO 20:4">pa luhlüt tingdau mei peei la dede magede ngau gailak.<verse eid="PRO 20:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 20:5" />Mige lungcetdung au dui kecok nzwa,</para>
  <para style="q" vid="PRO 20:5">dede makecime cide twak mpet lula.<verse eid="PRO 20:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 20:6" />Mina kekieege pa dai kenzwa gede masang bi kecu rangla,</para>
  <para style="q" vid="PRO 20:6">dede kesangbe de cau pei mpet lubui no?<verse eid="PRO 20:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 20:7" />Makesangme ge pezai samsang eh tetla,</para>
  <para style="q" vid="PRO 20:7">nah pe namedung pe lampui pwa kelame de samlam beuzie.<verse eid="PRO 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 20:8" />Hegwangpei hetu ketiakbam ga kebambe</para>
  <para style="q" vid="PRO 20:8">makesiabe leune pie eh pe dwa gade keugi dila.<verse eid="PRO 20:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 20:9" />Cauge rang lubui no, “Ih a lungcet kai mci pwabam;</para>
  <para style="q" vid="PRO 20:9">Ih a kemau gade mci dida”?<verse eid="PRO 20:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 20:10" />Perüt teu masang kemak nah ndet masang kemak</para>
  <para style="q" vid="PRO 20:10">kenana de RAMPAUBE ngkaula.<verse eid="PRO 20:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 20:11" />Rehang relei mege de pe bata gade ci lula,</para>
  <para style="q" vid="PRO 20:11">pe zai mci nah masang mi mebi kecu gade.<verse eid="PRO 20:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 20:12" />Mi kwen masiu kera nah mimiak ma ngau kera kenana de,</para>
  <para style="q" vid="PRO 20:12">RAMPAUBE ne teigai.<verse eid="PRO 20:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 20:13" />Kezip de hung so mecai nang ma gah dizie;</para>
  <para style="q" vid="PRO 20:13">ma teinang bamlu, iciude nang tyeikap gaikelak ngau luzie.<verse eid="PRO 20:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 20:14" />Makeluibe, “Cide kemta! Cide kemta!” de eh rangla,</para>
  <para style="q" vid="PRO 20:14">dede pa mpetlwe pemi lia kelude rang eh hegie bamla.<verse eid="PRO 20:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 20:15" />Kecak nah pemi kehung tangtsu kekiee ge bam,</para>
  <para style="q" vid="PRO 20:15">dede maci sam kerang au pemi kehung nia gelie.<verse eid="PRO 20:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 20:16" />Sangme pau teibeu kera sampet kebeube ge pai kai nzeulu,</para>
  <para style="q" vid="PRO 20:16">nah mci kemak pui pau teibeu kera sampet kecudau cide samkak keluge teilu.<verse eid="PRO 20:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 20:17" />Mide kecwa gade tangku ngaukelu nggum la,</para>
  <para style="q" vid="PRO 20:17">dede bam sangne pemui tsutia le pui dizie.<verse eid="PRO 20:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 20:18" />Keledeusam kingnei kelu gade mariem yi lula,</para>
  <para style="q" vid="PRO 20:18">nah kemteu puisau si mene hereu ga renia kera lüt so.<verse eid="PRO 20:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 20:19" />Ledkieesam kengkim kaizeu lu lama,</para>
  <para style="q" vid="PRO 20:19">cine nang mina marang kekiee zu kecume dade mbai lu.<verse eid="PRO 20:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 20:20" />Mige pepui mede pepei de reset cai,</para>
  <para style="q" vid="PRO 20:20">pe mibung muiting kecu gade tei mmüt dizie.<verse eid="PRO 20:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 20:21" />Mabam keraidau ngau kelwa kelu au,</para>
  <para style="q" vid="PRO 20:21">kekam lebie pekeyi cam dizie.<verse eid="PRO 20:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 20:22" />“Kemau aide ziemne Ih ncu gibeu lak!” de eh rangso,</para>
  <para style="q" vid="PRO 20:22">RAMPAUBE de kwalu iciude pa ncu kelibeu zie.<verse eid="PRO 20:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 20:23" />RAMPAUBE perüt teu nsam kemak ngkau la,</para>
  <para style="q" vid="PRO 20:23">nah riangteukwak teu samsang kemak au yi ma.<verse eid="PRO 20:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 20:24" />RAMPAUBE anui pikietdung saulia beula;</para>
  <para style="q" vid="PRO 20:24">cine pe teilung dailam mie zeubi kecu caune ci lulai?.<verse eid="PRO 20:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 20:25" />“Ma aide au mci,” de rang zette kedi</para>
  <para style="q" vid="PRO 20:25">nah sampet kedi caine pekie daibi de cet kecu au mina ziemne hebaih ge.<verse eid="PRO 20:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 20:26" />Hegwangpei kemriak ge makesia teikelame de peei mpet lula,</para>
  <para style="q" vid="PRO 20:26">nah ngaunggia mene penuide saja peuzie.<verse eid="PRO 20:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 20:27" />Mina rabe au RAMPAUBE mibung ge,</para>
  <para style="q" vid="PRO 20:27">pelung ga kebam pelane peei lula.<verse eid="PRO 20:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 20:28" />Ngaugia nah kesamsang ne Hegwangpei de peu kwak lula;</para>
  <para style="q" vid="PRO 20:28">keku ne pe hegwang peu kwakbam lula.<verse eid="PRO 20:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 20:29" />Rehangme kendu au penui kengking,</para>
  <para style="q" vid="PRO 20:29">nah kecingme hezukeyi au penui peutam kepu deda.<verse eid="PRO 20:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 20:30" />Ma kehung daukelu gade ma kesiabe teimci beula,</para>
  <para style="q" vid="PRO 20:30">nah keledeu ne helung teimci lula.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 21:1" />Hegwangpei mlung au RAMPAUBE ba gade reuceuna ge nzwa;</para>
  <para style="q" vid="PRO 21:1">pa pe suibe gage teu kereu gai dila.<verse eid="PRO 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 21:2" />Mileune de pa teikela pekiene petaulie cetla,</para>
  <para style="q" vid="PRO 21:2">dede RAMPAUBE mina lungningdung piela.<verse eid="PRO 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 21:3" />Petau nah kemzuibe ketei au</para>
  <para style="q" vid="PRO 21:3">ratak teugwang kebeu swade RAMPAUBE pe suila.<verse eid="PRO 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 21:4" />Ngang kela miakpie nah ngang kela mlung,</para>
  <para style="q" vid="PRO 21:4">kesiame mitaubung, aidungde au kemau.<verse eid="PRO 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 21:5" />Mariem teune kelame kiee si luzie,</para>
  <para style="q" vid="PRO 21:5">dede ma tei zette kelame ma gah dizie.<verse eid="PRO 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 21:6" />Kenret sam kerang gade mahei ngau keludung au</para>
  <para style="q" vid="PRO 21:6">gah zette di kela mwangzui ge nah teitset kela baih ge.<verse eid="PRO 21:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 21:7" />Kenlienme de au penui zaikesia ne ngkap dizie,</para>
  <para style="q" vid="PRO 21:7">penui petaube tei rau kedine.<verse eid="PRO 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 21:8" />Kemauketeime lampui au ngkoi,</para>
  <para style="q" vid="PRO 21:8">dede keyime petaube teila.<verse eid="PRO 21:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 21:9" />Kesamlim keci nau gede ngngwa kige ga lungh kecu swa au</para>
  <para style="q" vid="PRO 21:9">kipeu kimiak ga lungh kecube yiki.<verse eid="PRO 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 21:10" />Kenlienme kemau teineu eh bamla;</para>
  <para style="q" vid="PRO 21:10">pa pe kidame de ngaungia lama.<verse eid="PRO 21:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 21:11" />Mide rangmsia kelame de saja peu ge, kemangme maci lula,</para>
  <para style="q" vid="PRO 21:11">nah makecime de ledeu ge, pa maci si lula.<verse eid="PRO 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 21:12" />Makesangbe kenlienbe ki pie bamla;</para>
  <para style="q" vid="PRO 21:12">nah pa kenlienme de tei ngkap dila.<verse eid="PRO 21:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 21:13" />Kegahme mra kwa kingnei meidi kelabe,</para>
  <para style="q" vid="PRO 21:13">pa mra kegai dau pecu keli beu ta dizie.<verse eid="PRO 21:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 21:14" />Kengkim mapeu mi rata kezeu beula,</para>
  <para style="q" vid="PRO 21:14">nah kebai pwa kebam mapeu lunghop kesia kezeu beula.<verse eid="PRO 21:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 21:15" />Kemzuibe tei luge, keyime pe sui yila,</para>
  <para style="q" vid="PRO 21:15">dede kesiabe ta tei kelame da ngaukehing teugwang beula.<verse eid="PRO 21:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 21:16" />Macet keyibe gade tet mdei kedibe,</para>
  <para style="q" vid="PRO 21:16">ketsaime maa ga mtak zie.<verse eid="PRO 21:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 21:17" />Pe zaira tei eh kehega kebam de pesui kelame magah dizie;</para>
  <para style="q" vid="PRO 21:17">zau nah ketyeipok keyi tyeineu kelame mahei gailak.<verse eid="PRO 21:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 21:18" />Mina kesiame de makesangme ding tei saja peula,</para>
  <para style="q" vid="PRO 21:18">nah masangkemakme de mina kemzuime ding tei saja peula.<verse eid="PRO 21:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 21:19" />Kesamlim keci nau gede ngngwa lungh kecu swa au</para>
  <para style="q" vid="PRO 21:19">hetaideu ga kelungh be yiki.<verse eid="PRO 21:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 21:20" />Makecime kiga mahei luukeneube nah maca kaizeu la,</para>
  <para style="q" vid="PRO 21:20">dede kemangme penui rangkang ngau lu herizi tei zang dila.<verse eid="PRO 21:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 21:21" />Pe zaiyi nah ma petaube tei kelabe,</para>
  <para style="q" vid="PRO 21:21">mina aipaude kering, kesamsangbe, nah kerüt ngau lula.<verse eid="PRO 21:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 21:22" />Kemriakme ge kengkiengme namdi ngam lula,</para>
  <para style="q" vid="PRO 21:22">nah penuide gumpwa kebam kengkieng tsukwa de teimsia dila.<verse eid="PRO 21:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 21:23" />Pe samrang nah pe mleu ketip teune kelume,</para>
  <para style="q" vid="PRO 21:23">keherei lu kera gade pecu kezeu lula.<verse eid="PRO 21:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 21:24" />Pekatei pecu mning mdi nah pe zai kesiame, zi au “Mide Rangkemsiame” da,</para>
  <para style="q" vid="PRO 21:24">pa au ngang nah pe zai kesia pwa liala.<verse eid="PRO 21:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 21:25" />Kenghetbe hengin ne pecu teitset dila,</para>
  <para style="q" vid="PRO 21:25">pe ba mata tei keraune.<verse eid="PRO 21:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 21:26" />Pa tingba ramsang ne teisi neu reureu bamla,</para>
  <para style="q" vid="PRO 21:26">dede makesangbe peu la nah suihau mene peula.<verse eid="PRO 21:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 21:27" />Kenlienme ratak tei kebeu au kengkau ge,</para>
  <para style="q" vid="PRO 21:27">pe makesia mning eh teu kegwang au ngkau ki.<verse eid="PRO 21:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 21:28" />Kenret zierang au gah dizie,</para>
  <para style="q" vid="PRO 21:28">dede kingnei kelame au kelungta zierang tei lazie.<verse eid="PRO 21:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 21:29" />Kenlienme kemau tei jüja lala,</para>
  <para style="q" vid="PRO 21:29">dede makesangme au pekatei pe lampuidung cisiak la.<verse eid="PRO 21:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 21:30" />RAMPAUBE de renia lu kera</para>
  <para style="q" vid="PRO 21:30">maci, mede kecikecet, mede saukelia gede gah.<verse eid="PRO 21:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 21:31" />Regi kera benai ziemne hekwendung mtei lubui,</para>
  <para style="q" vid="PRO 21:31">dede hereu ngkienglu kera au RAMPAUBE da bam.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 22:1" />Mahei kekieege swade hezi keyi be kedet lu,</para>
  <para style="q" vid="PRO 22:1">nah rangkanggeu nah kecak swade hetwakepung be yiki.<verse eid="PRO 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 22:2" />Keheibe nah kegahbe aide kegucüt bam,</para>
  <para style="q" vid="PRO 22:2">RAMPAUBE au penai hangnana de damkegaibe.<verse eid="PRO 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 22:3" />Kemriakme keherei gwang kezeu ngaulwe cide gade mbai lula,</para>
  <para style="q" vid="PRO 22:3">dede kemangme cide ga lütla nah cide ziemne reila.<verse eid="PRO 22:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 22:4" />Kehenah nah RAMPAUBE kerüt ziehi au</para>
  <para style="q" vid="PRO 22:4">mahei, ketwa nah ringketie.<verse eid="PRO 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 22:5" />Kenlienme lampui ga hetu nah baih bamla;</para>
  <para style="q" vid="PRO 22:5">pe teilung gum kelume cidungde gade mbai luzie.<verse eid="PRO 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 22:6" />Hename gede pa dainzwa lungh maisia bi ledeu beulu,</para>
  <para style="q" vid="PRO 22:6">iciude pa hecing kelucai cipau keledeu de gade nreu caili tet dilak.<note caller="-" style="x"><char style="xo" closed="false">22:6 </char><char style="xt" closed="false"><ref loc="EPH 6:4">Eph. 6:4</ref></char></note><verse eid="PRO 22:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 22:7" />Keheime kegahme reu kengkieng teula,</para>
  <para style="q" vid="PRO 22:7">nah rangkang kereleube au releu kebeube baangme da.<verse eid="PRO 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 22:8" />Mzuikemak leuh gi kegaibe, kekap rum zie,</para>
  <para style="q" vid="PRO 22:8">nah pe rata tie de gah dizie.<verse eid="PRO 22:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 22:9" />Mbang kelabe de samlam beuzie,</para>
  <para style="q" vid="PRO 22:9">pa kegahme de ketyeipok mzi beula kecune.<verse eid="PRO 22:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 22:10" />Mide rangmsia kelame de gwagi dilu, ciciude regi kecu gah dizie;</para>
  <para style="q" vid="PRO 22:10">nah kesamlim, nah mide kii kecu gah dizie.<verse eid="PRO 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 22:11" />Helung kemci</para>
  <para style="q" vid="PRO 22:11">pe sui kelabe,</para>
  <para style="q" vid="PRO 22:11">nah sam keyi rang kelabe,</para>
  <para style="q" vid="PRO 22:11">pa au hegwangpei de pe zangbe tei zie.<verse eid="PRO 22:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 22:12" />RAMPAUBE maci de pie regum bamla,</para>
  <para style="q" vid="PRO 22:12">dede pa mide kecwame samdung kelien gi dila.<verse eid="PRO 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 22:13" />Kenghetbe rangla, “Lampuiki ga hingho la!,</para>
  <para style="q" vid="PRO 22:13">Acu namdi sum gade teitset dizie.”<verse eid="PRO 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 22:14" />Kemmha pui mui au hekwaki kecok ge;</para>
  <para style="q" vid="PRO 22:14">cide gage kau kegaime keheibede de RAMPAUBE pe rata sütla.<verse eid="PRO 22:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 22:15" />Hename mlung ga ma kemtabe kainzeu pwa bamla,</para>
  <para style="q" vid="PRO 22:15">dede ledeu kegai gade cide gwagi dila.<verse eid="PRO 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 22:16" />Pe mahei tei ngkiee lu kerane makegahme de teikeherei kelabe,</para>
  <para style="q" vid="PRO 22:16">mede makeheime de peudi kelabe, magah dizie.<verse eid="PRO 22:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 22:17" />N kwen ngkeilwe makecime samdung kingnei lu,</para>
  <para style="q" vid="PRO 22:17">nah a maci de gage nlung kailu,<verse eid="PRO 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 22:18" />kedanemene nang cidungde kainzeu lucai,</para>
  <para style="q" vid="PRO 22:18">nah cidung pelane n muileu ga mtei pwa bam lucai, cide n ziemne keyi ge zie.<verse eid="PRO 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 22:19" />Peu n kenlum RAMPAUBE da bamlu kerane,</para>
  <para style="q" vid="PRO 22:19">Ih henai cidungde ncu ledeu beula.<verse eid="PRO 22:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 22:20" />Ih n ziemne sam camrei raupwa la,</para>
  <para style="q" vid="PRO 22:20">cidungde maci nah keledeu samdung,<verse eid="PRO 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 22:21" />ncu kesangbe nah nlumlukebui sam ledeu beu kerane,</para>
  <para style="q" vid="PRO 22:21">ciciude ncu langkegaimedung de nang sam kesangbe keli beulu kerane.<verse eid="PRO 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 22:22" />Kegahme ge gu pa au magah lu de eh rega teu diso,</para>
  <para style="q" vid="PRO 22:22">mede herieki ga kengha teu maikesiame de nneu so,<verse eid="PRO 22:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 22:23" />RAMPAUBE ne penui tutiak nzang zie,</para>
  <para style="q" vid="PRO 22:23">nah pa kegahme gu rega teu kedimedung teilung luu teu dizie.<verse eid="PRO 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 22:24" />Pe rata kesiame de ngngwa zangna teiso,</para>
  <para style="q" vid="PRO 22:24">nah pe lunghop kesiame de ngngwa zangna teiso,<verse eid="PRO 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 22:25" />mecai nang pe zaidung de keteu luzie</para>
  <para style="q" vid="PRO 22:25">delwe nang n rabe de kengkap gage kaidi lubui.<verse eid="PRO 22:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 22:26" />Sampet tei kecu ga kesuizwa eh bateu kecume ge teiso,</para>
  <para style="q" vid="PRO 22:26">mede mikedame pau ruibeu zielie sampet so.<verse eid="PRO 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 22:27" />Nang peu gailak di cai,</para>
  <para style="q" vid="PRO 22:27">penui nzeu kecang de luu teu dizie.<verse eid="PRO 22:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 22:28" />N paume herai tsu kai kenzeude</para>
  <para style="q" vid="PRO 22:28">keu mpetti so.<verse eid="PRO 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 22:29" />Nang mige pe bata yisüt kecume gede ngau ni? Pa hegwangme dwa ga sap zie;</para>
  <para style="q" vid="PRO 22:29">pa mina magede kemakme dwa ga sap lak.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 23:1" />Nang kengkieng keteume de ngngwa matyei kera bam keludau,</para>
  <para style="q" vid="PRO 23:1">n dwaga kebamdung mcet sünne lu,<verse eid="PRO 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 23:2" />nang ma kekieege tyei kelame ge cai,</para>
  <para style="q" vid="PRO 23:2">nkatei ncu kezeu lu.<verse eid="PRO 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 23:3" />Pe taktyei keyidung hengin so,</para>
  <para style="q" vid="PRO 23:3">kedanemene cide au mide kecwa taktyei lu.<verse eid="PRO 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 23:4" />Mahei silu kerane mata tei nri sütso;</para>
  <para style="q" vid="PRO 23:4">mriak eh mtak kerating cilu.<note caller="-" style="x"><char style="xo" closed="false">23:4 </char><char style="xt" closed="false"><ref loc="1TI 6:9">1 Tim. 6:9</ref></char></note><verse eid="PRO 23:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 23:5" />Nang n miak peu cika baa gai zieni?</para>
  <para style="q" vid="PRO 23:5">Cide au gah dizie,</para>
  <para style="q" vid="PRO 23:5">kedanemene cide helie nzwa pe hesiu pung eh</para>
  <para style="q" vid="PRO 23:5">ting gage liem tet gai dizie.<verse eid="PRO 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 23:6" />Mina kesiame gu ketyeipok tyeiso,</para>
  <para style="q" vid="PRO 23:6">nah pe ketyeipok keyi de hengin so,<verse eid="PRO 23:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 23:7" />kedanemene pa au ketyeipok mi peei kelame ge.</para>
  <para style="q" vid="PRO 23:7">“Tyeilu nah saklu!” de pa n dage rangla,</para>
  <para style="q" vid="PRO 23:7">dede pe lungcet au ciciu lama.<verse eid="PRO 23:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 23:8" />Nang keceu nage tyei kelude nrui nghang dizie</para>
  <para style="q" vid="PRO 23:8">nah nang twa kegai pelane kemta tei dizie.<verse eid="PRO 23:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 23:9" />Kemieme dage marang so,</para>
  <para style="q" vid="PRO 23:9">kedanemene pa n kemteu samdung de nlai dizie lu.<verse eid="PRO 23:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 23:10" />Ndaa de kebam herai tsu de deu kelai so</para>
  <para style="q" vid="PRO 23:10">mede nggiana deu luu teu diso,<verse eid="PRO 23:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 23:11" />kedanemene penuide Rikelube au ngkieng</para>
  <para style="q" vid="PRO 23:11">nah pa ncu mmau eh penui tutiak zie.<verse eid="PRO 23:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 23:12" />Keledeusam de gage nlung kailu</para>
  <para style="q" vid="PRO 23:12">nah macisamdung kingnei lu.<verse eid="PRO 23:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 23:13" />Henamedung de ledeu kera lunghau so,</para>
  <para style="q" vid="PRO 23:13">kedanemene nang pecu ledeu lucai, pa tsai dilak.<verse eid="PRO 23:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 23:14" />Nang ne pecu tsingtie le dap maisia</para>
  <para style="q" vid="PRO 23:14">delwe pe rabe Sheol <note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="fq" closed="false">Sheol</char><char style="ft" closed="false">: Ketsaime deu</char></note>gade kelibeu kerabe.<verse eid="PRO 23:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 23:15" />A na, n lung mteu cai,</para>
  <para style="q" vid="PRO 23:15">Ih de a sui yizie;<verse eid="PRO 23:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 23:16" />nang petaube rang kecudau</para>
  <para style="q" vid="PRO 23:16">a rabe pe suiyi luzie.<verse eid="PRO 23:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 23:17" />Peu n nlung de kemaume de hengin so,</para>
  <para style="q" vid="PRO 23:17">dede n ting pekiene RAMPAUBE de hing jüja lalu.<verse eid="PRO 23:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 23:18" />Paucai teigwang kera ge bam</para>
  <para style="q" vid="PRO 23:18">nah nang regui kebam de tei nggah dilak.<verse eid="PRO 23:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 23:19" />Kingneilu, nang!, a na,</para>
  <para style="q" vid="PRO 23:19">delwe mriaklu nah n lung petau gage teu gailu.<verse eid="PRO 23:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 23:20" />Zau sakmie kecumedung de ngngwa so,</para>
  <para style="q" vid="PRO 23:20">mede heteih tyei kecimedung de kekangngwa so,<verse eid="PRO 23:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 23:21" />kedanemene sak kemieme nah ketyeikau de ma gah dizie,</para>
  <para style="q" vid="PRO 23:21">nah kezip ne penuide peu paineu bah zie.<verse eid="PRO 23:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 23:22" />N pei ncu teilung kepeube kwa kingneilu</para>
  <para style="q" vid="PRO 23:22">nah n pui cing dide, nang pecu ngkau diso.<verse eid="PRO 23:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 23:23" />Makesangbe luilu, dede cide zwa diso;</para>
  <para style="q" vid="PRO 23:23">maci, keledeusam nah lungcet keyi luilu.<verse eid="PRO 23:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 23:24" />Makesangme ge pei au pe sui yizie,</para>
  <para style="q" vid="PRO 23:24">nah kemteu nabe lungh kelube au pe suiyi luzie.<verse eid="PRO 23:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 23:25" />Peu n pei penai n pui de penai sui yilu,</para>
  <para style="q" vid="PRO 23:25">nah ncu mna kebeube de peu pe sui yilu.<verse eid="PRO 23:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 23:26" />A na, n mlung acu peulo</para>
  <para style="q" vid="PRO 23:26">nah n miak de peu a puisaudung pie lulo.<verse eid="PRO 23:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 23:27" />Kedanemene helipui au hekwa kecok ge,</para>
  <para style="q" vid="PRO 23:27">nah kemmha pui ge au kenrum tekwaki ge.<verse eid="PRO 23:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 23:28" />Pa sütketyeime nzwa kwabam la</para>
  <para style="q" vid="PRO 23:28">nah pa minadung kakga mide kecwamedung tei ngkiee si reu beula.<verse eid="PRO 23:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 23:29" />Cau keherei bam no? Cau pe sui sia bam no? Cau regi lano?</para>
  <para style="q" vid="PRO 23:29">Cau ncam bam no? Cau made tei mene rezam zamdung pung lano?</para>
  <para style="q" vid="PRO 23:29">Cau pe miak giebei bam no?<verse eid="PRO 23:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 23:30" />Zau sak bam kelame,</para>
  <para style="q" vid="PRO 23:30">zau hai kelube sak kelame.<verse eid="PRO 23:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 23:31" />Zau gie kedibe pieso,</para>
  <para style="q" vid="PRO 23:31">cide hepiak ga nzaihei</para>
  <para style="q" vid="PRO 23:31">nah mduipai eh nghung dila liede.<verse eid="PRO 23:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 23:32" />Kekam ga cide henei nzwa nsau zie</para>
  <para style="q" vid="PRO 23:32">nah henei kerabe ne nsau kedi nzwa teei zie.<verse eid="PRO 23:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 23:33" />N miakngau gade ma ketsamdung ngau dizie,</para>
  <para style="q" vid="PRO 23:33">nah n lung gade makesiadung rang dizie.<verse eid="PRO 23:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 23:34" />Nang jaaididung reu ga zip kelame ge nzwa dizie,</para>
  <para style="q" vid="PRO 23:34">mede liem nreutu ga zeu kebamme nzwa zie.<verse eid="PRO 23:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 23:35" />Nang, “Penui acu tei,” de eh rang zie, “dede acu rezam dima.</para>
  <para style="q" vid="PRO 23:35">Penui acu dap, dede Ih cide cilu ma.</para>
  <para style="q" vid="PRO 23:35">Ih daidau mrak cu lai? Ih sak si maisia da.”<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 24:1" />Kemaume de ngau n riak so,</para>
  <para style="q" vid="PRO 24:1">mede penuide ngngwa kera hengin so,<verse eid="PRO 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 24:2" />kedanemene penui lung au ma teimsia kera riemla,</para>
  <para style="q" vid="PRO 24:2">nah penui mui au makesiabe rangla.<verse eid="PRO 24:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 24:3" />Kemteu gade ki tei lula,</para>
  <para style="q" vid="PRO 24:3">nah macetkeyi gade cide teingkieng lula.<verse eid="PRO 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 24:4" />Maci le kibungdung au ma pemi kehung</para>
  <para style="q" vid="PRO 24:4">nah hezu keyidung le tei pui lula.<verse eid="PRO 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 24:5" />Kemteu reugwame ge au ngking,</para>
  <para style="q" vid="PRO 24:5">nah mina makecime ge au ngking si reureu lula;<verse eid="PRO 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 24:6" />pe kemteu puisau gade nang hereu regi lubui,</para>
  <para style="q" vid="PRO 24:6">nah keledeume kekieege kebam ga ngamkelu bamla.<verse eid="PRO 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 24:7" />Kemteu samdung au kemieme ziemne cok hamdi;</para>
  <para style="q" vid="PRO 24:7">herieki<note caller="+" style="f"><char style="fr" closed="false">24:7 </char><char style="fq" closed="false">Herieki</char><char style="ft" closed="false">: herieki aide ndaa tingdau namceu ga minadung mbau eh maha kenlangbedung mpau reki kebam de rangbam.</char></note> gade pa marang lama.<verse eid="PRO 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 24:8" />Mige kemau tei kera riem bamla,</para>
  <para style="q" vid="PRO 24:8">minadung pecu makehebwak mpaube lie qula.<verse eid="PRO 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 24:9" />Kemie ciem riem kela au kemau,</para>
  <para style="q" vid="PRO 24:9">nah mide rangmsia kelame ge de minadung ngkaula.<verse eid="PRO 24:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 24:10" />Keherei kecudau nang ngngi eh mnei dicai,</para>
  <para style="q" vid="PRO 24:10">nang ngking ma.<verse eid="PRO 24:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 24:11" />Petau kemak gade teitsetdi lai kebamme de kelilu,</para>
  <para style="q" vid="PRO 24:11">nah daptsetdi kera gage tet gai kecumedung de tei mtak dilu.<verse eid="PRO 24:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 24:12" />Nang magade, “Ainie, anui au aide ha au magede cima,” de eh rang cai,</para>
  <para style="q" vid="PRO 24:12">n lungning pie kelabe nang dai rang zeubi ci meni?</para>
  <para style="q" vid="PRO 24:12">N teilung gumbeu kelabe, pa ci meni?</para>
  <para style="q" vid="PRO 24:12">Tinggwang mileune de pe bata nzwa ziehi peu lak ni?<note caller="+" style="f"><char style="fr" closed="false">24:12 </char><char style="ft" closed="false">Matt. 16:27, Rom. 2:6, Keu. 2:23, Keu. 22:12 </char></note><verse eid="PRO 24:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 24:13" />A na, heliadui tyeilu kedanemene cide au yi,</para>
  <para style="q" vid="PRO 24:13">nah helia liep gade zau kemie heliadui au n mleu gade kum.<verse eid="PRO 24:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 24:14" />Kemteu au n rabe ziemne cinzwa da,</para>
  <para style="q" vid="PRO 24:14">nang cide ngau lucai, caiha bam zie</para>
  <para style="q" vid="PRO 24:14">nah n regui de tei nggah dilak.<verse eid="PRO 24:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 24:15" />Kemaume ge makesangme ki sütteu di kera kwa kecube nzwa kwa bam so.</para>
  <para style="q" vid="PRO 24:15">Pe ki teimsia diso!<verse eid="PRO 24:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 24:16" />Kedanemene makesangme pia hena kaumie liede cuhdai lula,</para>
  <para style="q" vid="PRO 24:16">dede kemaume de au keherei ne ngkap dila.<verse eid="PRO 24:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 24:17" />N ngauraume keherei dau keludau n suiyi so,</para>
  <para style="q" vid="PRO 24:17">nah pa kau kecudau n suiyi so,<verse eid="PRO 24:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 24:18" />mecai RAMPAUBE ci luzie nah pa pe suilak,</para>
  <para style="q" vid="PRO 24:18">nah n ngauraume dade pe lunghop teu caili dizie.<verse eid="PRO 24:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 24:19" />Kemau teikelame ziemne n lung keherei so,</para>
  <para style="q" vid="PRO 24:19">nah mina kesiamedung de nriak so,<note caller="+" style="f"><char style="fr" closed="false">24:19 </char><char style="ft" closed="false">Lei. 37:1</char></note><verse eid="PRO 24:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 24:20" />kedanemene kesiame au pe caiha gah,</para>
  <para style="q" vid="PRO 24:20">nah mina kesiame mibung mmüt dizie.<verse eid="PRO 24:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 24:21" />A na, RAMPAUBE de nah hegwangpei de rütlu;</para>
  <para style="q" vid="PRO 24:21">penaide ngaurau kelame de ngngwa so,<note caller="-" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="1PE 2:17">1 Pet. 2:17</ref></char></note><verse eid="PRO 24:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 24:22" />kedanemene kaknage gage penuide ngkapti kera gwang zie,</para>
  <para style="q" vid="PRO 24:22">nah penai dade kengkap daikenzwa ge gwang ziebi kecu caune cilu lai?<verse eid="PRO 24:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 24:23" />Kemteumedung ne aidungde rang si gai.</para>
  <para style="q" vid="PRO 24:23">Hetuketiakme ge milam pwa kecu au yi ma.<verse eid="PRO 24:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 24:24" />Mina kesiamedung dage, “Nang au makesangme ge,”</para>
  <para style="q" vid="PRO 24:24">de eh rang kecume de au minadung ne reset zie nah heleuhdung ngkau zie.<verse eid="PRO 24:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 24:25" />Dede mina kesiamedung de ledeu kelame au penui suiyi luzie,</para>
  <para style="q" vid="PRO 24:25">nah penui au mapeu keyidung ngau luzie.<verse eid="PRO 24:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 24:26" />Kesangbe rang keli kegai au</para>
  <para style="q" vid="PRO 24:26">muileu gage kemam kegai nzwada.<verse eid="PRO 24:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 24:27" />Hegwale n ta tei kera mteilu,</para>
  <para style="q" vid="PRO 24:27">nah luh ga nang teu mai kesiabe maleune mteilu;</para>
  <para style="q" vid="PRO 24:27">cipaucai ne n ki teilu.<verse eid="PRO 24:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 24:28" />Pekie kegah gade n kidabe de mmau eh zierang teiso,</para>
  <para style="q" vid="PRO 24:28">nah n sam le mide cwaso.<verse eid="PRO 24:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 24:29" />“Pa a dage tei kegai nzwa Ih de pe dage teigai beuzie;</para>
  <para style="q" vid="PRO 24:29">Pa tei kegai de Ih de pe nsam tei beuzie” de eh rang so.<verse eid="PRO 24:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 24:30" />Ih kenghetme ge,</para>
  <para style="q" vid="PRO 24:30">kemangbe kube luh tetkah gwang.<verse eid="PRO 24:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 24:31" />Cide hetu le lungh pui bam;</para>
  <para style="q" vid="PRO 24:31">hangdeu ceheibangdung le lungh pui bam,</para>
  <para style="q" vid="PRO 24:31">nah pe tangtsu rie de meu dida.<verse eid="PRO 24:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 24:32" />Pecai Ih cide piegai eh cipau hade cetgai;</para>
  <para style="q" vid="PRO 24:32">Ih piegai eh keledeu ge cilu.<verse eid="PRO 24:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 24:33" />Kaknage ziangmui gailu, kaknage zip gailu,</para>
  <para style="q" vid="PRO 24:33">kaknage batuilwe mtak gailu<note caller="+" style="f"><char style="fr" closed="false">24:33 </char><char style="ft" closed="false">Mac. 6:10</char></note>,<verse eid="PRO 24:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 24:34" />iciude keregame ge nzwa magah n da gwang zie,</para>
  <para style="q" vid="PRO 24:34">nah nang teumaikesiabe pe reunet teulwe sütketyeime nzwa gwang zie.<note caller="+" style="f"><char style="fr" closed="false">24:34 </char><char style="ft" closed="false">Mac. 6:11</char></note><verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s">Solomon Macisam Kedadung</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />Aidungde Solomon macisamdung, Judah gwangpei, Hezekiah kangga pe kedimedung ne rau keludung.<verse eid="PRO 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 25:2" />Ma kebaiteu kelade au Tinggwang kendu,</para>
  <para style="q" vid="PRO 25:2">nah cide rangmci lia kegai au hegwangme kendu.<verse eid="PRO 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 25:3" />Tinggimdung kecehu nah kideu kecok cicang gailak kecu nzwa,</para>
  <para style="q" vid="PRO 25:3">hegwangme lungning de cicang gailak.<verse eid="PRO 25:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 25:4" />Rangkanggeu gade keheradung de keu gidi,</para>
  <para style="q" vid="PRO 25:4">iciude hegeu kerekibe rangkanggeu keu pe ta<note caller="+" style="f"><char style="fr" closed="false">25:4 </char><char style="fq" closed="false">pe ta </char><char style="ft" closed="false">hezukeyi nia</char></note> tei lubui.<verse eid="PRO 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 25:5" />Ciciuliede, mina kesiamedung de hegwangpei dwa gade keugi dilu,</para>
  <para style="q" vid="PRO 25:5">iciude pe hegwang petaube tei eh tei ngkieng luzie.<verse eid="PRO 25:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 25:6" />Hegwangpei dwa gade nkatei ncu twa so,</para>
  <para style="q" vid="PRO 25:6">nah kenlangmedung ziemne tei pwa kebam bam ga sap so.<verse eid="PRO 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 25:7" />Peu kenlangme dwa gade ncu hengam teidi kera swade,</para>
  <para style="q" vid="PRO 25:7">Pa ne ncu, “Aika hanglu,” de kerang be yiki.</para>
  <para style="q" vid="PRO 25:7">Nang kengau de,<note caller="-" style="x"><char style="xo" closed="false">25:7 </char><char style="xt" closed="false"><ref loc="LUK 14:10">Luk. 14:10</ref>,<ref loc="LUK 14:11">11</ref></char></note><verse eid="PRO 25:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 25:8" />tutiakbam ga teu kelwa mie diso.</para>
  <para style="q" vid="PRO 25:8">Kedanemene kekamle n kidabe ncu teu hengam tei kecudau</para>
  <para style="q" vid="PRO 25:8">nang daitei lai?<verse eid="PRO 25:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 25:9" />N kidabe nnai kakgade n ha de nzanglu</para>
  <para style="q" vid="PRO 25:9">nah kedame kengkiem de mide ranglia so,<verse eid="PRO 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 25:10" />mecai cide siukelube n reu gage hengam teigai beuzie,</para>
  <para style="q" vid="PRO 25:10">nah n ha kesiade kebai gailak dizie.<verse eid="PRO 25:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 25:11" />Sam petaube peting siakdau rangkegai au</para>
  <para style="q2" vid="PRO 25:11">kecak apple rangkanggeu kwak gage kaipwa kebam nzwa da.<verse eid="PRO 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 25:12" />Makecimege ne kingnei keneume dage keledeu sam rang kegai au</para>
  <para style="q" vid="PRO 25:12">kecak bakap mede kecakle tei kelu hetei heta nzwa da.<verse eid="PRO 25:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 25:13" />Kenlum samgwabe au pecu langkegaime dwade luhlüt ting kelum dau</para>
  <para style="q" vid="PRO 25:13">kengkung buising nzwa da;</para>
  <para style="q" vid="PRO 25:13">pa pe mpaume lung tei ringrak beula.<verse eid="PRO 25:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 25:14" />Pa peu kemak mapeude ziemne hegie kelabe</para>
  <para style="q" vid="PRO 25:14">au hemwa nah tingkai dui teugwang beula kemakpe nzwa da.<verse eid="PRO 25:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 25:15" />Milung tie kecu au kedibe lung tei nreudi lubui,</para>
  <para style="q" vid="PRO 25:15">nah sam kemnwa au teihra de teipang lubui.<verse eid="PRO 25:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 25:16" />Nang heliadui ngau lucai, tyeilu kebui ge tyeilu,</para>
  <para style="q" vid="PRO 25:16">mecai, cide tyei kieeham lu eh ncu tei nruidi lubui.<verse eid="PRO 25:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 25:17" />N kidame ki ga mie heriham so,</para>
  <para style="q" vid="PRO 25:17">pa ncu ngngwa leudi lubui nah ncu ngkaudi lubui.<verse eid="PRO 25:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 25:18" />Mige pe kidabe kenret zierang ketei au</para>
  <para style="q" vid="PRO 25:18">tsingtie ge hereu ga keu kelabe nzwa, mede kingtiege, mede lakpitsi pemui keyi ge nzwa.<verse eid="PRO 25:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 25:19" />Nang keherei kelu tingdau masang kemakme ge de nlum kecu au</para>
  <para style="q" vid="PRO 25:19">migei kesia ge mede mipi daukeli kegai nzwa da.<verse eid="PRO 25:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 25:20" />Mige pelung keherei süt eh kebambe dage lei tei kegaibe au</para>
  <para style="q" vid="PRO 25:20">tingtiak tingdau mige pe pai gaugi kegai nzwa,</para>
  <para style="q" vid="PRO 25:20">mede keteei zam gage kehiadui rui kegai nzwa da.<verse eid="PRO 25:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 25:21" />N ngauraube mzeu lacai, pecu ketyeipok tyei kera peulu,</para>
  <para style="q" vid="PRO 25:21">nah pa hereu lacai, pecu dui sak kera peulu,<verse eid="PRO 25:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 25:22" />iciude nang heu kebam hengam miceudung pe peu gage twakgai zie</para>
  <para style="q" vid="PRO 25:22">nah RAMPAUBE ncu ziehi peu zie.<note caller="+" style="f"><char style="fr" closed="false">25:22 </char><char style="ft" closed="false">Matt. 5:44, Rom. 12:20</char></note><verse eid="PRO 25:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 25:23" />Tingbangle tingkai tingrui teugwang kela nzwa,</para>
  <para style="q" vid="PRO 25:23">cinzwa kengkiem sam kerang mleu au rata teugwang beula.<verse eid="PRO 25:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 25:24" />Kesamlim kecu nauge de ngngwa kilung ge ga ngngwa lungh kecu swa au</para>
  <para style="q" vid="PRO 25:24">kipeu kimiak ga kelungh be yiki.<note caller="+" style="f"><char style="fr" closed="false">25:24 </char><char style="ft" closed="false">Pro. 21:9</char></note><verse eid="PRO 25:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 25:25" />Kemdei deudi gade samliakeyi kesiu au</para>
  <para style="q" vid="PRO 25:25">mige hereu kebam dau duikung kesak nzwa da.<verse eid="PRO 25:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 25:26" />Makesangme ge mina kesiame ciem gade kau kedi au</para>
  <para style="q" vid="PRO 25:26">duirwak keherabe mede tekwa teimsia kedibe nzwa da.<verse eid="PRO 25:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 25:27" />Heliadui tyei kieeham kecu au yi ma;</para>
  <para style="q" vid="PRO 25:27">cide au mitwa kekiee ngauneu eh peeikela nzwa da.<verse eid="PRO 25:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 25:28" />Pe rata ketip lula kemakbe au</para>
  <para style="q" vid="PRO 25:28">namdi kau kedi nah pe kiriedung kegah nzwa da.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 26:1" />Hepwak tingdau buising kei kecu mede luhlüt tingdau tingrui kecu au zeu kemak nzwa,</para>
  <para style="q" vid="PRO 26:1">kemieme ge de twa kera au zeu ma.<verse eid="PRO 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 26:2" />Tangkine nah nruine tau mene lim mpet nlüt kebam nzwa,</para>
  <para style="q" vid="PRO 26:2">reset ngaubui kemakpe au gwang tungcang lak.<verse eid="PRO 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 26:3" />Hekwen ge de kebiet kerabe, gada mui kang kerabe</para>
  <para style="q" vid="PRO 26:3">nah kemieme ge de dap kerabe.<verse eid="PRO 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 26:4" />Kemieme ge keteu kegai kemtage keli so,</para>
  <para style="q" vid="PRO 26:4">mecai nangde penui nzwa kemieme ge dizie.<verse eid="PRO 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 26:5" />Kemieme ge de kemie sam gele keli gai beulu,</para>
  <para style="q" vid="PRO 26:5">ciude pa pekatei pe miakngau gade mriak lie melu kerane.<verse eid="PRO 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 26:6" />Kemieme ge de sampau kera langgai kegaibe au</para>
  <para style="q" vid="PRO 26:6">pekatei pe pi dang lula nah keherei mnwa lula.<verse eid="PRO 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 26:7" />Kemieme ge mui gade macisamdung kerang au</para>
  <para style="q" vid="PRO 26:7">pi kesiame pi pe ta teila kemak nzwa da.<verse eid="PRO 26:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 26:8" />Kemieme ge de ketwa au</para>
  <para style="q" vid="PRO 26:8">tangtsu ge tamnung gage kang kegai nzwa da.<verse eid="PRO 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 26:9" />Kemieme ge macisamdung kerang au</para>
  <para style="q" vid="PRO 26:9">sakmie kelume ge ba ga hetu lütkedi nzwa da.<verse eid="PRO 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 26:10" />Kemieme ge de mede keheibe pecu tetkah kegwangbe zie li kecube au</para>
  <para style="q" vid="PRO 26:10">lakpikekapme petai ga kebam mileune de rezam kela nzwa da.<verse eid="PRO 26:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 26:11" />Kemieme ge kemangta pia pekenabe ketei au,</para>
  <para style="q" vid="PRO 26:11">heteu pe nrui ga nli gwang dai kela nzwa da.<note caller="-" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="2PE 2:20-22">2 Pet. 2:20-22</ref></char></note><verse eid="PRO 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 26:12" />Nang mige pe miakngau gade pekatei pecu maci lie la eh ngau ni?</para>
  <para style="q" vid="PRO 26:12">Cipaude swa kemieme ge da keregui kieeki.<verse eid="PRO 26:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 26:13" />Kenghetme ge rangla, “Lampuiki ga hingho bam!</para>
  <para style="q" vid="PRO 26:13">Puidiki kakga hingho ge la!”<verse eid="PRO 26:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 26:14" />Kenghetme ge pe zeu ga zeudet kebam au,</para>
  <para style="q" vid="PRO 26:14">kikam pebam gade ngkei ngkui kebam nzwa da.<verse eid="PRO 26:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 26:15" />Kenghetpe au pe kwak ga ge pe ba kaila,</para>
  <para style="q" vid="PRO 26:15">dede pe mui gage mpang kera pe kengking kette gah.<note caller="+" style="f"><char style="fr" closed="false">26:15 </char><char style="ft" closed="false">Mac. 19:24</char></note><verse eid="PRO 26:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 26:16" />Mina hanghena tutiak keyi teu ranglia kegai swade</para>
  <para style="q" vid="PRO 26:16">kenghetme ge pekatei pe miak gade pa mriakki lie bamla.<verse eid="PRO 26:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 26:17" />Mige tetkah gwang kela ga mikedame kesamlim bam kecu ga gwang deiga kecu au,</para>
  <para style="q" vid="PRO 26:17">heteu kwen keriak gai kecu nzwa da.<verse eid="PRO 26:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 26:18" />Kemiebe pei ge lakpitsi heu kebam ge kap kegaide au,<verse eid="PRO 26:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 26:19" />cide au pe kidabe de cwa eh aide rang kegai nzwa da,</para>
  <para style="q" vid="PRO 26:19">“Ih au henui teibam meluini?”<verse eid="PRO 26:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 26:20" />Tsing cang kedine, mi mmüt dila;</para>
  <para style="q" vid="PRO 26:20">nah ledkieesam rang kemak ga kesamlim tadi la.<verse eid="PRO 26:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 26:21" />Miceu ne peu misumdangdung de heu bam lula nah tsing ne mi de peu heu bam lu kecu nzwa,</para>
  <para style="q" vid="PRO 26:21">makebwak kelame kesamlim kecu teibeu bamla.<verse eid="PRO 26:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 26:22" />Ledkieesam kerang au penggumkeyi kecam nage nzi ketyei nzwa;</para>
  <para style="q" vid="PRO 26:22">cidungde pumtei helungle nhung gai dila.<verse eid="PRO 26:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 26:23" />Makesia rang neu eh ru kebam mui nah kemau mlung teupung kebam au</para>
  <para style="q" vid="PRO 26:23">tangdei li gage hezu keyi ge keniak kenzeuge nzwa da.<verse eid="PRO 26:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 26:24" />Mige mikedame de ngkau kelabe pe lungcet hebai teu eh pemui le hezusam rangla</para>
  <para style="q" vid="PRO 26:24">nah pa pekatei peda mide cwagai kera kwabam la.<verse eid="PRO 26:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 26:25" />Pa nciep eh marang bam lubui, dede pecu nlum so,</para>
  <para style="q" vid="PRO 26:25">kedanemene pe mlung ga au heciem hena riem pwa bam.<verse eid="PRO 26:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 26:26" />Pa mide ngaurau kecu de pe ciem le gum pwa bam liede,</para>
  <para style="q" vid="PRO 26:26">pa kemau tei kela de mbau kebam<note caller="+" style="f"><char style="fr" closed="false">26:26 </char><char style="fq" closed="false">mbau kebam </char><char style="ft" closed="false">mteina mbau kebam ni</char></note> ga keulia di zie.<verse eid="PRO 26:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 26:27" />Mitak tei kelame pe katei cika cak lüt di zie</para>
  <para style="q" vid="PRO 26:27">nah tangtsu cwak kegaibe da caili gwang dai zie.<verse eid="PRO 26:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 26:28" />Kenret kelame ge au pa ne tei rejam kedime de ngkau la</para>
  <para style="q" vid="PRO 26:28">nah hegiehelia kela mui au kekap teu gwang la.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 27:1" />Ncünne ziemne ngang diso,</para>
  <para style="q" vid="PRO 27:1">dai tingba ge teu gwang zie bi nang ci kemakne.<note caller="-" style="x"><char style="xo" closed="false">27:1 </char><char style="xt" closed="false"><ref loc="JAS 4:13">Jas. 4:13</ref>,<ref loc="JAS 4:14">14</ref></char></note><verse eid="PRO 27:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 27:2" />Mi kedame de peu ncu twa lu nah nkatei n mui ne mene;</para>
  <para style="q" vid="PRO 27:2">cikemakme ge ne nah nkatei n muileu gade di mene;<verse eid="PRO 27:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 27:3" />Tangtsu gu perüt penai heciang gu perüt de cet gai lo,</para>
  <para style="q" vid="PRO 27:3">kemangme ge ne mirata tei kegai de au ci kena swade rüt ki.<verse eid="PRO 27:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 27:4" />Rata au pezai sia nah lunghop au pui nlim,</para>
  <para style="q" vid="PRO 27:4">dede cau be heriak kesia dwa sap lulai?<verse eid="PRO 27:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 27:5" />Mdu eh herata kegai au yiki</para>
  <para style="q" vid="PRO 27:5">kengkim keku swa.<verse eid="PRO 27:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 27:6" />Zangname ge ne rezam kegai de au samsang lie,</para>
  <para style="q" vid="PRO 27:6">dede ngauraume ge ncu hemam mteisüt di lubui.<verse eid="PRO 27:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 27:7" />Mi ge tyei nggei lwe kebamdau heliadui keli dizie,</para>
  <para style="q" vid="PRO 27:7">dede mzeu kebamme ge ziemne, kekaabedung de kum dila.<verse eid="PRO 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 27:8" />Nruine ge pe ciep gade pak kedi nzwa</para>
  <para style="q" vid="PRO 27:8">mige pa lungh kebam gade tet mzia kedi au.<verse eid="PRO 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 27:9" />Marim keyi nah kehengui de helung suiyi peula,</para>
  <para style="q" vid="PRO 27:9">dede zangname keyi au pe lungsang teu rangkelia gade gwangla.<verse eid="PRO 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 27:10" />N zangme nah n pei zangme de gi diso,</para>
  <para style="q" vid="PRO 27:10">nah n sinabe ki ga mie so nang keherei kelu benai.</para>
  <para style="q" vid="PRO 27:10">N tai ga kebam n kidabe au yiki n sinabe kemdei ga kebam be de swa.<verse eid="PRO 27:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 27:11" />Mriaklu, a na, nah a mlung suiyi tei lu;</para>
  <para style="q" vid="PRO 27:11">ciu eh acu henui tei kelame de Ih penuide a sam keli caili beu zie.<verse eid="PRO 27:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 27:12" />Kenriakme keherei ngau eh pekatei pecu hebai lula,</para>
  <para style="q" vid="PRO 27:12">dede macet kemakme mie la nah cide ziemne keherei dizie.<verse eid="PRO 27:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 27:13" />Mina cikemakme ge zierang teibeu kelabe gu paini ge keu lu,</para>
  <para style="q" vid="PRO 27:13">nah cipau sampet de kainzeu lu pa kemmha pui ge zierang cuh kecudau.<note caller="+" style="f"><char style="fr" closed="false">27:13 </char><char style="ft" closed="false">Pro. 20:16</char></note><verse eid="PRO 27:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 27:14" />Caugame pe kidabe de tingcang nuge sahbak eh samlam beu bi,</para>
  <para style="q" vid="PRO 27:14">cipau samlam de au reset ge lie eh cet di lubui!<verse eid="PRO 27:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 27:15" />Kesamlim nau ge au</para>
  <para style="q" vid="PRO 27:15">ting kerui benai dui zau taptap kemie nzwa da;<verse eid="PRO 27:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 27:16" />pecu kaam kegai au tingkai de kekaam nzwa da,</para>
  <para style="q" vid="PRO 27:16">mede n ba zetle le maca nzap kegai nzwa da.<verse eid="PRO 27:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 27:17" />Hegeu ne hegeu de tei nzau la;</para>
  <para style="q" vid="PRO 27:17">ci nzwa eh, mina ne pe zangme de tei nzau lula.<verse eid="PRO 27:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 27:18" />Nzütbang kelamluibe pe tsi tyei zie,</para>
  <para style="q" vid="PRO 27:18">nah pe mpaube de gum kelabe de au kerüt peu zie.<verse eid="PRO 27:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 27:19" />Dui gade mige pe zu ngau kela nzwa eh,</para>
  <para style="q" vid="PRO 27:19">ciu eh mige mlung be gade pecu ngau lula.<verse eid="PRO 27:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 27:20" />Sheol nah Abaddon madaude mnung lula kemak nzwa eh,</para>
  <para style="q" vid="PRO 27:20">mina miak madaude mnung lu lama.<verse eid="PRO 27:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 27:21" />Mih le rangkanggeu nah kecak de kesi piela;</para>
  <para style="q" vid="PRO 27:21">nah mige de twa kegai gade pecu kedei pie la.<verse eid="PRO 27:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 27:22" />Nang kemangme ge de ketautie ge le, tsiu kakga neu gai liede,</para>
  <para style="q" vid="PRO 27:22">dede pe kemang de au pecu püt lak.<verse eid="PRO 27:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 27:23" />Nang n kauruinedung rehi de ci bi maisia</para>
  <para style="q" vid="PRO 27:23">nah n tumdung de n lung nei lu,<verse eid="PRO 27:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 27:24" />mahei au bammui lula melu.</para>
  <para style="q" vid="PRO 27:24">Hegwangpeurwa ge ceheu leune ga bammui lula ni?<verse eid="PRO 27:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 27:25" />Nang reigau gah di kela de ci maisia nah keheci bwa pet kelade,</para>
  <para style="q" vid="PRO 27:25">nah kideutu ga tsehei hekwalu kera ting de.<verse eid="PRO 27:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 27:26" />Cipau meuründung nnui de paini peu zie</para>
  <para style="q" vid="PRO 27:26">nah hemeudung de luh mi peu zie.<verse eid="PRO 27:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 27:27" />Hemeu tungdui nnui taktyei ziemne bam zie, nnui kilungme ziemne taktyei,</para>
  <para style="q" vid="PRO 27:27">nah n kila releime de hezu teihemi lu kerane.<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 28:1" />Kenlienme mige penui de gwa meliede pak la, dede makesangme au hingho na nzwa kuu.<verse eid="PRO 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 28:2" />Hangdeube ga kemau de ziemne, peuketeume kiee bam,</para>
  <para style="q" vid="PRO 28:2">dede macet nah maci kebam pei ge dade heleuhbe sap tie lula.<verse eid="PRO 28:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 28:3" />Ma kegah pei ge keda kegahme de tei keherei kela de</para>
  <para style="q" vid="PRO 28:3">tingrui kesia ne taktyei bang beu kemak nzwa da.<verse eid="PRO 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 28:4" />Hezai gi kedime kenlienme de twa la,</para>
  <para style="q" vid="PRO 28:4">dede hezai kai nzeu kelame penuide ngngwa renia la.<verse eid="PRO 28:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 28:5" />Kesiame kemzuibe ci lama,</para>
  <para style="q" vid="PRO 28:5">dede RAMPAUBE de pei kelame ma leune ci bam.<verse eid="PRO 28:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 28:6" />Magah eh kesang lampui ga tet kelabe au yiki,</para>
  <para style="q" vid="PRO 28:6">mige mahei eh masang kemak lampuidung ga ketet swa.<verse eid="PRO 28:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 28:7" />Hezai kai nzeu kelu be au maci kebam napei ge,</para>
  <para style="q" vid="PRO 28:7">dede matyei neu zu kelame de zangna tei kelabe au pe pei de tei hengam la.<note caller="+" style="f"><char style="fr" closed="false">28:7 </char><char style="ft" closed="false">Pro. 10:1, 13:1</char></note><verse eid="PRO 28:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 28:8" />Peqai keu kiee eh pe mahei tei kelabe</para>
  <para style="q" vid="PRO 28:8">kegahme de kenggia beu kelame ziemne pe mahei hekwa la la.<verse eid="PRO 28:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 28:9" />Mige pe kwen hezai kekingnei gade nreu tet dicai,</para>
  <para style="q" vid="PRO 28:9">pe kekie liede kemneu ge.<verse eid="PRO 28:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 28:10" />Kemzuime gede kemau lampui ga sau kebeu be</para>
  <para style="q" vid="PRO 28:10">pekatei pe baih ga kaumie zie,</para>
  <para style="q" vid="PRO 28:10">dede kemau kegahbe au mabam keyi bam zie.<verse eid="PRO 28:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 28:11" />Mahei kecume ge pekatei pe miak gade mriak lie bam lubui,</para>
  <para style="q" vid="PRO 28:11">dede kegahme ge kecikecet kebamme ge pecu peei mpetti zie.<verse eid="PRO 28:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 28:12" />Makesangme ngking kelu dau, cika kemdu kedi ge bam;</para>
  <para style="q" vid="PRO 28:12">dede kesiame kengking teu kelu dau, minadung de peei mpet dila.<verse eid="PRO 28:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 28:13" />Pe mau kebai kedibe de yipet gailak,</para>
  <para style="q" vid="PRO 28:13">dede pe mau pet kelube nah cidungde gi kelube de au ngaugia keulia zie.<note caller="-" style="x"><char style="xo" closed="false">28:13 </char><char style="xt" closed="false"><ref loc="1JN 1:9">1 Jhn. 1:9</ref></char></note><verse eid="PRO 28:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 28:14" />Kerüt gade lungh bammui kelabe<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="fq" closed="false">Kerüt gade lungh bammui kelabe </char><char style="ft" closed="false">makesia tei hing kelabe</char></note> de au samlam pung,</para>
  <para style="q" vid="PRO 28:14">dede keheibe pe mlung tei tak kedi au keherei gage kaugai dizie.<verse eid="PRO 28:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 28:15" />Kedi kesia ge au hingho kenrabe mede hegum pe zai kesia ge nzwa lie</para>
  <para style="q" vid="PRO 28:15">makegahme reu ga.<verse eid="PRO 28:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 28:16" />Kedi pe lungcet keyi kegahbe au zaisiet ge,</para>
  <para style="q" vid="PRO 28:16">masang kemak de kengkaube pe tingbazie tie zie.<verse eid="PRO 28:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 28:17" />Magade mige mide hejai tei lwadi eh mau di liecai,</para>
  <para style="q" vid="PRO 28:17">pa tsai di kemakta hing eh rwapwa kelame ge dizie</para>
  <para style="q" vid="PRO 28:17">nah migede pecu ngha lak.<verse eid="PRO 28:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 28:18" />Makesang ga tet kelame de au kai kwak luzie,</para>
  <para style="q" vid="PRO 28:18">dede lampui kenkoi ga tet kelabe au kau zette dizie.<verse eid="PRO 28:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 28:19" />Pe deu ga heta tei kela be au taktyei kekiee ge bam zie,</para>
  <para style="q" vid="PRO 28:19">dede kemta caisui kelame au kegah kieesüt zie.<verse eid="PRO 28:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 28:20" />Kesamsangme au samlamdung disüt kecu bam zie,</para>
  <para style="q" vid="PRO 28:20">dede mahei zette kedime au saja ngau mene ta dilak.<verse eid="PRO 28:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 28:21" />Heneuherüt keulia kecu yima,</para>
  <para style="q" vid="PRO 28:21">dede tangku kwak ge ziemne mina ma teimau dizie.<verse eid="PRO 28:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 28:22" />Ma mzaham kecume ge maheidung gage kelwa gaila,</para>
  <para style="q" vid="PRO 28:22">dede pa magah pe reuga gwang kera de ci lama.<note caller="-" style="x"><char style="xo" closed="false">28:22 </char><char style="xt" closed="false"><ref loc="1TI 6:9">1 Tim. 6:9</ref></char></note><verse eid="PRO 28:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 28:23" />Caugame mige de ledeu gai bi, pecaine pe dade suiyi ngau kiegwa luzie</para>
  <para style="q" vid="PRO 28:23">mina pe mui gade pecu kecwa sam rang kegaime swade.<verse eid="PRO 28:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 28:24" />Keheibe de pe pui pe pei gu rega eh, “Mau melie,” rangla cai</para>
  <para style="q" vid="PRO 28:24">pa au kengkap kangngwame ge delie.<verse eid="PRO 28:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 28:25" />Kehengimme kehebwak teucuh beu la,</para>
  <para style="q" vid="PRO 28:25">dede RAMPAUBE de nlum kelabe au lung yi lu zie.<verse eid="PRO 28:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 28:26" />Pekatei pe mlung be de nlum kelabe au kemang kau ge,</para>
  <para style="q" vid="PRO 28:26">dede maci ga tet kela be au kenggi gade mbai dizie.<verse eid="PRO 28:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 28:27" />Kegahme de peu kegaime au teumaikesia magede gah dilak,</para>
  <para style="q" vid="PRO 28:27">dede caugame penui dage pe miak ngkuidi bi reset kekieege ngau zie.<note caller="+" style="f"><char style="fr" closed="false">28:27 </char><char style="ft" closed="false">Pro. 11:24,25</char></note><verse eid="PRO 28:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 28:28" />Kesiame cuh ge, mina penui katei penuide hebai la;</para>
  <para style="q" vid="PRO 28:28">dede penui kap dige, kemzuime kiee si dila.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q">
    <verse number="1" style="v" sid="PRO 29:1" />Mige mina rata ngau kiee zu eh bam liede pelung tak eh bam cai</para>
  <para style="q" vid="PRO 29:1">zette teingkap pwa teihemi gai kelak ge tei dizie.<verse eid="PRO 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 29:2" />Mina makesangme kiee si kegai dau, minadung sui yila,</para>
  <para style="q" vid="PRO 29:2">dede kenlienme ne kedibe di ge, mina ncam dila.<note caller="+" style="f"><char style="fr" closed="false">29:2 </char><char style="ft" closed="false">Pro. 28:12</char></note><verse eid="PRO 29:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 29:3" />Maci de hung kelame pe pei suiyi tei la,</para>
  <para style="q" vid="PRO 29:3">dede helipuidung de ngngwa kelabe pe mahei ngkap dila.<note caller="-" style="x"><char style="xo" closed="false">29:3 </char><char style="xt" closed="false"><ref loc="LUK 15:13">Luk. 15:13</ref></char></note><verse eid="PRO 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 29:4" />Hegwangpei kemzuibe teu eh hangdeu teucuh lula,</para>
  <para style="q" vid="PRO 29:4">dede hetauhenim kie kelabe tei msia dila.<verse eid="PRO 29:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 29:5" />Mige pe kidabe de cwa kela be au</para>
  <para style="q" vid="PRO 29:5">pe pi ziemne hetak kaam la.<verse eid="PRO 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 29:6" />Kesiame penui mau gage penuide keuh lula,</para>
  <para style="q" vid="PRO 29:6">dede makesangme lei tei nah penui sui yibam la.<verse eid="PRO 29:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 29:7" />Makesangme kegahme mzeudung ci la;</para>
  <para style="q" vid="PRO 29:7">kenlienme maci cidungde ci lamah.<verse eid="PRO 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 29:8" />Mi de henui tei kelamedung namdi be ga mi twa gai la,</para>
  <para style="q" vid="PRO 29:8">dede kemriakme au lunghop gade caili lula.<verse eid="PRO 29:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 29:9" />Kenriakme ge kemangme gede ngngwa kesamlim kecu dau,</para>
  <para style="q" vid="PRO 29:9">pa pe rata la nah nui la, nah cika mtak gai kera bam lak.<verse eid="PRO 29:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 29:10" />Hejai teilwa neu kelame mmau gai kelakme de ngkau la</para>
  <para style="q" vid="PRO 29:10">nah kemzuime teilung peei la.<verse eid="PRO 29:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 29:11" />Kemangme pe rata pelane lia la,</para>
  <para style="q" vid="PRO 29:11">dede kenriakme kam di nah pekatei pecu kezeu dila.<verse eid="PRO 29:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 29:12" />Kedime ge kenret samdung gage pelung kai dicai,</para>
  <para style="q" vid="PRO 29:12">pe kangga kedime pelane kenretme tei dizie.<verse eid="PRO 29:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 29:13" />Makegahme nah tei keherei kelabe de au nzwa lie,</para>
  <para style="q" vid="PRO 29:13">RAMPAUBE penai hangna na de pe nai miak kebaa peu bam kelane.<verse eid="PRO 29:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 29:14" />Magade hegwangpei kegahbe de kesangbe teu eh hetutiak liecai,</para>
  <para style="q" vid="PRO 29:14">pe hegwangbam kelungta ziemne tei luzie.<verse eid="PRO 29:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 29:15" />Tsingrang nah ledeu kegai au maci peula,</para>
  <para style="q" vid="PRO 29:15">dede hename de peu pesuira tei cai pe pui de tei hengam beula.<verse eid="PRO 29:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 29:16" />Kesiame kengkieng teu luge, kemau ketei kiee dila,</para>
  <para style="q" vid="PRO 29:16">dede kemzuime au kesiame kekau de ngau zie.<note caller="+" style="f"><char style="fr" closed="false">29:16 </char><char style="ft" closed="false">Pro. 28:12, 28; 29:2</char></note><verse eid="PRO 29:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 29:17" />N napei de ledeu lu ciciu de pa ncu kerelui peu zie;</para>
  <para style="q" vid="PRO 29:17">pa n teilung gage suiyi peu zie.<verse eid="PRO 29:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 29:18" />Caihakeci miakngau kegah ga au minadung penui zaira tei eh pak la,</para>
  <para style="q" vid="PRO 29:18">dede hezaibe mzai kelume au samlam pung lei.<verse eid="PRO 29:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 29:19" />Kilame ge de samdung le ledeu gai lak,</para>
  <para style="q" vid="PRO 29:19">pa cilu liede, samli be bam lak.<verse eid="PRO 29:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 29:20" />Mige pe samdung nzet kela gede ngau ni?</para>
  <para style="q" vid="PRO 29:20">Pe ziemne swa au kemangme ziemne be keregui kie.<verse eid="PRO 29:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 29:21" />Mige pe kilabe de pe henane gade mzai kelame,</para>
  <para style="q" vid="PRO 29:21">kekam le gwang de keherei kecu dau zie.<verse eid="PRO 29:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 29:22" />Rata kau ge kesamlim kera teu kerui la</para>
  <para style="q" vid="PRO 29:22">nah lunghop mpaube kemaudung kekiee ge tei bamla.<verse eid="PRO 29:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 29:23" />Ngang kelame de tei hena dila,</para>
  <para style="q" vid="PRO 29:23">dede kehena rabe pe da kelame de au kerüt peu zie.<note caller="+" style="f"><char style="fr" closed="false">29:23 </char><char style="ft" closed="false">Pro. 11:2, Pro. 16:18, Matt. 23:12</char></note><note caller="-" style="x"><char style="xo" closed="false">29:23 </char><char style="xt" closed="false"><ref loc="MAT 23:12">Mat. 23:12</ref></char></note><verse eid="PRO 29:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 29:24" />Keregame de mzang kelabe au pekatei pe teilung de ngkau la;</para>
  <para style="q" vid="PRO 29:24">pa reset de siu dede magede rang lama.<verse eid="PRO 29:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 29:25" />Mina de kehing au hebai ge tei dila,</para>
  <para style="q" vid="PRO 29:25">dede RAMPAUBE de nlum kelame de gum luzie.<verse eid="PRO 29:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 29:26" />Mina kekiee ge kedime zu peei la,</para>
  <para style="q" vid="PRO 29:26">dede RAMPAUBE dade mina kemzui ngau lula.<verse eid="PRO 29:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 29:27" />Mzeukemakbe de au makesangme ngkau la,</para>
  <para style="q" vid="PRO 29:27">nah kenlienbe makesangme de ngkau la.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s">Agur Samdung</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Jakeh napei Agur samdung, kerangbe:</para>
  <para style="q1" vid="PRO 30:1">Mina aide Ithiel dage mdugai, Ithiel nah Ucal dage:<verse eid="PRO 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 30:2" />Ih mina swade makaune nzwa ki dida</para>
  <para style="q" vid="PRO 30:2">nah Ih mina kecet nzwa macet keci de gada.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />Ih kemteu sam de keteu luma,</para>
  <para style="q" vid="PRO 30:3">mede Kemci Tinggwang maci de a da gah.<verse eid="PRO 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 30:4" />Cauge tinggim ga hang nah nghung no?</para>
  <para style="q" vid="PRO 30:4">Cau pe ba gage tingkai herak lu dino?</para>
  <para style="q" vid="PRO 30:4">Cau pe cwatie gage duidung hekwalu dino?</para>
  <para style="q" vid="PRO 30:4">Cau kideube raidung leune kailu dino?</para>
  <para style="q" vid="PRO 30:4">Pe zi cau no, nah pe napei zi cau no? Nang cibam zie cai acu ranglia lo!<note caller="-" style="x"><char style="xo" closed="false">30:4 </char><char style="xt" closed="false"><ref loc="JHN 3:13">Jhn. 3:13</ref></char></note><verse eid="PRO 30:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 30:5" />Tinggwang sam leune kedei pie dida;</para>
  <para style="q" vid="PRO 30:5">pe dage nsiu kegai leune de pa au gum beula.<verse eid="PRO 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 30:6" />Tinggwang samdung gage kai si so,</para>
  <para style="q" vid="PRO 30:6">mecai pa ncu ledeu gai zie,</para>
  <para style="q" vid="PRO 30:6">nah nang kenretme gelie kecu keu lia zie.<note caller="+" style="f"><char style="fr" closed="false">30:6 </char><char style="ft" closed="false">Hez. 4:2, Hez. 12:32</char></note><verse eid="PRO 30:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 30:7" />Ih n dade ma kena kie la,</para>
  <para style="q" vid="PRO 30:7">Ih tsaidi kemak dwa a dade cidungde kebai di so:<verse eid="PRO 30:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 30:8" />Kemtabe nah kenretdung a dade keu mdei di.</para>
  <para style="q" vid="PRO 30:8">Acu magah mede mahei peu so,</para>
  <para style="q" vid="PRO 30:8">teu maikesia ge rünne taktyei acu peu lo.<note caller="-" style="x"><char style="xo" closed="false">30:8 </char><char style="xt" closed="false"><ref loc="1TI 6:8">1 Tim. 6:8</ref></char></note><verse eid="PRO 30:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 30:9" />Ih kiee zu bam dicai, Ih ncu mlai nah rang di lubui, “RAMPAUBE cau no?”</para>
  <para style="q" vid="PRO 30:9">Mede Ih magah dicai,</para>
  <para style="q" vid="PRO 30:9">Ih rega nah a Tinggwang zi de tei hengam tei di lubui.<verse eid="PRO 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 30:10" />Kilabe de pe mpaube dwa de madaude rang msia so,</para>
  <para style="q" vid="PRO 30:10">mecai pa ncu reset zie nah nang mau dizie.<verse eid="PRO 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 30:11" />Ceheu ge penui pei de reset kecu tei</para>
  <para style="q" vid="PRO 30:11">nah penui pui de samlam beu lama.<verse eid="PRO 30:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 30:12" />Ceheu ge penui miak gade au mci kecu ge la,</para>
  <para style="q" vid="PRO 30:12">nah ciude penui kehera de hui mci dima.<verse eid="PRO 30:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 30:13" />Ceheu ge penui miak hu kecu la,</para>
  <para style="q" vid="PRO 30:13">nah penui miakkum dai hu ge cu no!<verse eid="PRO 30:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 30:14" />Ceheu ge pe gei au kingtiedung,</para>
  <para style="q" vid="PRO 30:14">nah penui gei jara au kieceunadung nzwa,</para>
  <para style="q" vid="PRO 30:14">ciu eh penui kegahme de kideu gade nah kengha teumaisia cume de minadung kakgade ngkap di kerane.<verse eid="PRO 30:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 30:15" />Tambet pe napui hangna bam: “Peulo nah peulo” de eh penai hap.</para>
  <para style="q" vid="PRO 30:15">Ma kecum ge madaude nnung canglu kelak ge bam,</para>
  <para style="q" vid="PRO 30:15">mdai cide madaude “Cang da” de rang lama:<verse eid="PRO 30:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 30:16" />Sheol; nagah pui:</para>
  <para style="q" vid="PRO 30:16">hangdeu madau gede dui le nnung lu kemak;</para>
  <para style="q" vid="PRO 30:16">nah mi madau gede “Cangda!” de rangkemak de.<verse eid="PRO 30:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 30:17" />Pe pei de henui tei kelabe miak de</para>
  <para style="q" vid="PRO 30:17">nah pe pui samzai teila kemak,</para>
  <para style="q" vid="PRO 30:17">chabak ga hegakdung ne pe miak nsau mpet dizie,</para>
  <para style="q" vid="PRO 30:17">nah pecu heraruidung ne tyei luzie.<verse eid="PRO 30:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 30:18" />Ma kecum a ziemne a swagah süt kecuge bam,</para>
  <para style="q" vid="PRO 30:18">mdai ge Ih ci gai kelak:<verse eid="PRO 30:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 30:19" />tinggim ga helie zai nzwa;</para>
  <para style="q" vid="PRO 30:19">nah tangtsu reuga henei zai nzwa;</para>
  <para style="q" vid="PRO 30:19">jaaidi mlungbe ga lim zai nzwa;</para>
  <para style="q" vid="PRO 30:19">nah mipei ge mipui kehena ge de ngngwa kebam zai nzwa.<verse eid="PRO 30:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 30:20" />Aide kemmha pui ge zai:</para>
  <para style="q" vid="PRO 30:20">pa tyeila nah pe mui neu dila<note caller="+" style="f"><char style="fr" closed="false">30:20 </char><char style="fq" closed="false">pa tyeila nah pe mui neu dila </char><char style="ft" closed="false">pa mmha la nah pekatei pecu dui pia nci dai dila</char></note></para>
  <para style="q" vid="PRO 30:20">nah rangla, “Ih magede teimau ma.”<verse eid="PRO 30:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 30:21" />Ma kecum kangga kideube mbeu bam,</para>
  <para style="q" vid="PRO 30:21">nah mdai be kangga cide au lia gai lak:<verse eid="PRO 30:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 30:22" />kila ge hegwang tei kedidau;</para>
  <para style="q" vid="PRO 30:22">kemie kau ge pa taktyei be pui kelu dau;<verse eid="PRO 30:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 30:23" />kengkau pui ge pa kemeu dau;</para>
  <para style="q" vid="PRO 30:23">nah kilapui ge pe mpaube pui bam keu kelu dau.<verse eid="PRO 30:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 30:24" />Kideu ga ma mdai ge ceu</para>
  <para style="q" vid="PRO 30:24">dede penui au mriak süt:<verse eid="PRO 30:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 30:25" />tangtiane au ngking kemak kaune ge,</para>
  <para style="q" vid="PRO 30:25">dede penui tinglum dau penui pok telei lula;<verse eid="PRO 30:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 30:26" />tsura kaunedung au kengking kaunedung ma,</para>
  <para style="q" vid="PRO 30:26">dede penui tsura gage penui ki tei lula.<verse eid="PRO 30:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 30:27" />Tangriemdung penui hegwang gah,</para>
  <para style="q" vid="PRO 30:27">dede penui hemaa tei eh mlai lala.<verse eid="PRO 30:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 30:28" />Kikwabe ziemne au, nang n ba kena gage herak lubui,</para>
  <para style="q" vid="PRO 30:28">dede penuide hegwangme kidung gade de ngau lula.<verse eid="PRO 30:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 30:29" />Ma kecum ncüt delwe tetpet kecu ngau kehega sütla</para>
  <para style="q" vid="PRO 30:29">nah mdai au sünne eh tet la:<verse eid="PRO 30:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 30:30" />hingho ge, makaunedung kak de ngkingtube,</para>
  <para style="q" vid="PRO 30:30">mage dade de caili dila ma;<verse eid="PRO 30:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 30:31" />mitwa luu neu eh tetkela ruirie ge; hemeu ge;</para>
  <para style="q" vid="PRO 30:31">nah hegwang ge pecai ga pe reugwamedung kebam.<verse eid="PRO 30:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 30:32" />Nang mie eh, n katei ncu hetwa pwa peu lacai</para>
  <para style="q" vid="PRO 30:32">mede nang kesiabe riem la cai,</para>
  <para style="q" vid="PRO 30:32">mtak dilu nah cet mtinglu.<verse eid="PRO 30:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 30:33" />Tungdui pwa kenuak gaige pecaa ngaulu kela nzwa</para>
  <para style="q" vid="PRO 30:33">nah mi ngkie keriak gaige cide hezai di kela nzwa,</para>
  <para style="q" vid="PRO 30:33">cine rata gade matei kedi au ngngwa kesia bui beula.<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s">Hegwangpei Lemuel Samdung</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Hegwangpei Lemuel samdung, pe pui pecu tei lulo eh ledeu kebeu ge.<verse eid="PRO 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 31:2" />Daino, a napei? Cide daino, a na akube?</para>
  <para style="q" vid="PRO 31:2">Nang dai luu neu no, a kekie keli kebeu nabe?<verse eid="PRO 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 31:3" />N kengking mipuidung de peu diso,</para>
  <para style="q" vid="PRO 31:3">mede n zaidung hegwangpeidung de ngkap di kelame de.<verse eid="PRO 31:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 31:4" />Cide hegwangme ziemne ma, Lemuel, hegwangme zau sak kera ziemne ma,</para>
  <para style="q" vid="PRO 31:4">mede peu keteume zau kengking hengim kerabe ma,<verse eid="PRO 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 31:5" />kedanemene penui sak luge penui hezai kai kenzeudung nsungta dila,</para>
  <para style="q" vid="PRO 31:5">nah keherei kebamme mzeu de tei nggah dila.<verse eid="PRO 31:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 31:6" />Zau kengking kap gahdi kezeume ge de peu lo</para>
  <para style="q" vid="PRO 31:6">nah lungrei kieesüt kecume de zau peu lo.<verse eid="PRO 31:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 31:7" />Pa sak luzie nah pa pe magah de nsungta dizie</para>
  <para style="q" vid="PRO 31:7">nah pa perei de nsungta dizie.<verse eid="PRO 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 31:8" />Marang lula kemakme ziemne rang lo,</para>
  <para style="q" vid="PRO 31:8">kap gahdi kezeu pelane de ziemne.<verse eid="PRO 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 31:9" />Rang petgai nah petaube tutiak de le tiaklu</para>
  <para style="q" vid="PRO 31:9">nah kegahme nah teumaikesiame ziemne nggia kie lu.<verse eid="PRO 31:9" /></para>
  <para style="s">Sam kekambe: Pe zai keyi Nau</para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 31:10" />Cau henau keyi ge peei lulai?</para>
  <para style="q" vid="PRO 31:10">Pe mi au hegadung swade yiki.<verse eid="PRO 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 31:11" />Pe nahpei pe mlung gade pecu nlum la,</para>
  <para style="q" vid="PRO 31:11">nah pa madaude magah dilak.<verse eid="PRO 31:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 31:12" />Pa pe ziemne ma keyidung teila nah kesiabe tei lama</para>
  <para style="q" vid="PRO 31:12">pe tingbadung pelane.<verse eid="PRO 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 31:13" />Pa mamai nah linen pai kedet,</para>
  <para style="q" vid="PRO 31:13">nah pe bata de pe sui yi eh tei bamla.<verse eid="PRO 31:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 31:14" />Pa heli ketei liemdung nzwa;</para>
  <para style="q" vid="PRO 31:14">pa kilung ga ketyeipok kemdei gade teugwang lula.<verse eid="PRO 31:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 31:15" />Pa tingmui kebam dau cuh dila</para>
  <para style="q" vid="PRO 31:15">nah pe kilungme de taktyei mtei beula,</para>
  <para style="q" vid="PRO 31:15">nah pa kilapuidung de heta mzi beula.<verse eid="PRO 31:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 31:16" />Pa luh ge pie eh cide lui lula,</para>
  <para style="q" vid="PRO 31:16">pe ba gade bui kelu tsi dele pa kubeluh ge ling lula.<verse eid="PRO 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 31:17" />Pa pe renci le pekatei pecu mtei lu la</para>
  <para style="q" vid="PRO 31:17">nah pe ba tei ngking lula.<note caller="-" style="x"><char style="xo" closed="false">31:17 </char><char style="xt" closed="false"><ref loc="LUK 12:35">Luk. 12:35</ref></char></note><verse eid="PRO 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 31:18" />Pa daipai tei de keyi ge pe ziemne gielu zie bi ci nswa lula;</para>
  <para style="q" vid="PRO 31:18">tingmui dau de pa ma tei nnang bamla.<verse eid="PRO 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 31:19" />Pe ba helang hedui eh nnang bam,</para>
  <para style="q" vid="PRO 31:19">nah pa kehedui ria de herak teu bamlu.<verse eid="PRO 31:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 31:20" />Pa mina ma kegahme de ngha beula;</para>
  <para style="q" vid="PRO 31:20">pa mina teumaikesiame de maikesiabe peula.<verse eid="PRO 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 31:21" />Pa buising kekei dau pe kilungme ziemne hing di lamah,</para>
  <para style="q" vid="PRO 31:21">pe kilungme pelane de pai kelumbe bah kelune.<verse eid="PRO 31:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 31:22" />Pa pe zeu ziemne paidung teilu,</para>
  <para style="q" vid="PRO 31:22">nah pa linen pai gieremang hezu keyi bah la.<verse eid="PRO 31:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 31:23" />Pe nahpei de au kiriedung<note caller="+" style="f"><char style="fr" closed="false">31:23 </char><char style="fq" closed="false">kiriedung </char><char style="ft" closed="false">heni aide, namceu de ga muiteumedung gwang ngkwa eh maha mpau eh tei kerabe tiak bam kela ni ge.</char></note> gade ci lula,</para>
  <para style="q" vid="PRO 31:23">pa namceu hangkiame de ngngwa ntum kebamdau.<verse eid="PRO 31:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 31:24" />Pa langcimpai niadung tei lu nah zwa la,</para>
  <para style="q" vid="PRO 31:24">nah pa kiakangdung tei lwe heli keteime dage zwa beula.<verse eid="PRO 31:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 31:25" />Pa au kengking nah herüt le pecu cum lu,</para>
  <para style="q" vid="PRO 31:25">nah pa gwang keradau nui la.<verse eid="PRO 31:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 31:26" />Pa maci teu marang la</para>
  <para style="q" vid="PRO 31:26">nah pezai hena kecu pe mui ga bamla.<verse eid="PRO 31:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 31:27" />Pa pe kilungme zaidung pie bam la la</para>
  <para style="q" vid="PRO 31:27">nah mide tei nghet di kela tangku tyei lama.<verse eid="PRO 31:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 31:28" />Pe namedung cuh eh pecu samlam kepung lie eh qu la,</para>
  <para style="q" vid="PRO 31:28">nah pe nahpei pecu twa eh rangla,<verse eid="PRO 31:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 31:29" />“Mipui kekiee ge keyi teilu,</para>
  <para style="q" vid="PRO 31:29">dede nang cidung pelane kakde yitu da.”<verse eid="PRO 31:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 31:30" />Kehemeu au mide kecwa, hezu keyi au gah dila,</para>
  <para style="q" vid="PRO 31:30">dede RAMPAUBE de herüt peu kela pui ge, pecu au twa zie.<verse eid="PRO 31:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 31:31" />Pe bata tsi de pecu peulo</para>
  <para style="q" vid="PRO 31:31">nah pe tadung de peu namceu heriekidung gade hetwa peulo.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>