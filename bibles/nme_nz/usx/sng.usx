<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Zeme(N) Bible Project</book>
  <para style="toc3">Sol.</para>
  <para style="toc2">Solomon Lei</para>
  <para style="toc1">Solomon Lei Laisiukwak</para>
  <para style="mt">Song of Songs</para>
  <para style="mt">Solomon Lei Laisiukwak</para>
  <para style="is">Mraisam</para>
  <para style="ip">Makecime midung ge Leidung aide Khrista pe minade keku lia kebam rehi ge lie bamde, mina kekiee le au Leidung aide mige penai pe mraipui leidung kekwa kelu ge lie cetla. Cide au mina kereku kecu nah laktak rehi ge.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Hemeupui nah Hemeupei (1:1-2:7)</para>
  <para style="io1">Pe mraipei de ketwa (3:6-5:1)</para>
  <para style="io1">Keku keherei kecu ge (5:2-7:9)</para>
  <para style="io1">Pütdi mene Ncütkela (7:10-8:14)</para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="s">Solomon Leidung</para>
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />Leidung kak gade lei yitubedung, Solomon gu leidung.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1KI 4:32">1 Heg. 4:32</ref></char></note><verse eid="SNG 1:1" /></para>
  <para style="sp">Mipui be pekatei pecu rang kebam</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 1:2" />Oh, pe mui kehemamdung le pwa acu hemam gailo,</para>
  <para style="sp" vid="SNG 1:2">Mipuibe mipei dage rang kebam</para>
  <para style="q" vid="SNG 1:2">n keku au zau swa yiki.<verse eid="SNG 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 1:3" />N keheniak ca perim kehengui keyi bam;</para>
  <para style="q" vid="SNG 1:3">n zi au lwabam kela marim kehengui nzwa,</para>
  <para style="q" vid="SNG 1:3">cine releime ncu mrai bam.<verse eid="SNG 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 1:4" />Nang acu ngngwa lu, delwe anai ngngwa pak dizie.</para>
  <para style="sp" vid="SNG 1:4">Mipui be pekatei pecu rang kebam</para>
  <para style="q" vid="SNG 1:4">Hegwangpei acu pe bungdung ga ngngwa gwanglu.</para>
  <para style="sp" vid="SNG 1:4">Mipui be mipei dage rang kebam</para>
  <para style="q" vid="SNG 1:4">Anai suiyi eh bam; n ziemne anai suiyi bam;</para>
  <para style="q" vid="SNG 1:4">anai n keku dele renga gai go; cide au zau swa yiki.</para>
  <para style="q" vid="SNG 1:4">Mipui kedadung ncu penui sui kera cide au pezai da.<verse eid="SNG 1:4" /></para>
  <para style="sp">Mipui be mipui kedadung dage rang kebam</para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 1:5" />Ih au remang dede hezuyi,</para>
  <para style="q" vid="SNG 1:5">nnui Jerusalem napuimedung,</para>
  <para style="q" vid="SNG 1:5">Kedar paikidung nzwa remang,</para>
  <para style="q" vid="SNG 1:5">Solomon kehezu paidung nzwa hezuyi.<verse eid="SNG 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 1:6" />Ih remang kecune acu pieling eh bam so,</para>
  <para style="q" vid="SNG 1:6">kedanemene tingnaimiak ne acu pu di delu.</para>
  <para style="q" vid="SNG 1:6">A pui napeimedung acu penui rata di;</para>
  <para style="q" vid="SNG 1:6">penui acu kubeluhdung ga peu kekwabe tei,</para>
  <para style="q" vid="SNG 1:6">dede a katei a kubeluh be pielu tadi.<verse eid="SNG 1:6" /></para>
  <para style="sp">Mipui be mipei dage rang kebam</para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 1:7" />Acu ranglia lo, a kubepei,</para>
  <para style="q" vid="SNG 1:7">n kauhau de peu daigade matyei lano?</para>
  <para style="q" vid="SNG 1:7">N kauhau de tingna tingding dau daiga peu mtak lano?</para>
  <para style="q" vid="SNG 1:7">Daitei Ih mige</para>
  <para style="q" vid="SNG 1:7">n zangmedung kauhau taigai hui pwa la kecume ge nzwa laino?<verse eid="SNG 1:7" /></para>
  <para style="sp">Mipei be mipui dage rang kebam</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 1:8" />Mipuime kakgade hezu yitube pui, nang ci mecai,</para>
  <para style="q" vid="SNG 1:8">a kauhaudung cai pwalu,</para>
  <para style="q" vid="SNG 1:8">nah n meudung de meurünkekwame paikidung taiga peu cehei peei tyeilu.<verse eid="SNG 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 1:9" />Ih ncu keu keda gai, a mraipui,</para>
  <para style="q" vid="SNG 1:9">Pharaoh bagi kwendung kakga hekwenpui ge da.<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="2CH 1:16">2 Hel. 1:16</ref></char></note><verse eid="SNG 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 1:10" />N biadung hezukeyi netdung de ziemne ngau yisüt,</para>
  <para style="q" vid="SNG 1:10">nah n nggwang jewel<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fq" closed="false">Jewel: </char><char style="ft" closed="false">tangtsu pemi kehung</char></note> riadung nzu mie kebam.<verse eid="SNG 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 1:11" />N ziemne kecak hezukeyi netdung teibeu zie</para>
  <para style="q" vid="SNG 1:11">rangkanggeu netdung de si eh.<verse eid="SNG 1:11" /></para>
  <para style="sp">Mipui be pekatei pecu rang kebam</para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 1:12" />Hegwangpei pe zeu ga zeu kebam dau,</para>
  <para style="q" vid="SNG 1:12">a rim kehengui ca gade perim keyi mpet.<verse eid="SNG 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 1:13" />A kubepei au a ziemne myrrh dum ge nzwa</para>
  <para style="q" vid="SNG 1:13">tingmui a hekakrak reuga zeu kebam.<verse eid="SNG 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 1:14" />A kubepei au mapadung peu hena nzwa da</para>
  <para style="q" vid="SNG 1:14">En Gedi kubeluhdung ga kebamdung de nzwa.<verse eid="SNG 1:14" /></para>
  <para style="sp">Mipei be mipui dage rang kebam</para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 1:15" />Kingneilu, nang au hezuyi, a kubepoi;</para>
  <para style="p" vid="SNG 1:15">kingneilu, nang au hezuyi;</para>
  <para style="q" vid="SNG 1:15">n miakdung au tamhaudung nzwa.<verse eid="SNG 1:15" /></para>
  <para style="sp">Mipui be mipei dage rang kebam</para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 1:16" />Kingneilu, nang au hezuyi, a kubepei, daikenzwa gede hezuyi no.</para>
  <para style="q" vid="SNG 1:16">Cehei kerenudung de anai zeu da.<verse eid="SNG 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 1:17" />Anai ki hesumdung au cedardung;</para>
  <para style="q" vid="SNG 1:17">anai gu kipaikang au firdung.<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="s">Mraipui</para>
  <para style="sp">Mipui be mipei dage rang kebam</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 2:1" />Ih au Sharon ga hangdeu pa nage,</para>
  <para style="p" vid="SNG 2:1">langkamdung ga teizuine pa ge.<verse eid="SNG 2:1" /></para>
  <para style="sp">Mipei be mipui dage rang kebam</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 2:2" />Hetudung kakga teizuine pa ge nzwa,</para>
  <para style="q" vid="SNG 2:2">a mraipui de releimedung kakga ci nzwa da.<verse eid="SNG 2:2" /></para>
  <para style="sp">Mipui be pekatei pecu rang kebam</para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 2:3" />Hegung ga tsingbangdung kakga tampaktsi bang ge nzwa,</para>
  <para style="q" vid="SNG 2:3">a mraipei de mipeidung kak gade cide nzwa da.</para>
  <para style="q" vid="SNG 2:3">Ih pe mie kangga a sui süt eh ntumla,</para>
  <para style="q" vid="SNG 2:3">nah pe tsi au a ziemne kum.<note caller="-" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="REV 22:1">Keu. 22:1</ref>,<ref loc="REV 22:2">2</ref></char></note><verse eid="SNG 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 2:4" />Pa acu zau ki ga ngngwa gwang,</para>
  <para style="q" vid="SNG 2:4">nah a reu ga pe pailim au keku.<verse eid="SNG 2:4" /></para>
  <para style="sp">Mipui be mipei dage rang kebam</para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 2:5" />Kubetsi tei nki kelube tangku le peu a pumci ngau dailo nah tampaktsidung le acu tei heci dailo,</para>
  <para style="q" vid="SNG 2:5">kedanemene Ih au kemrai gade mnei bam dida.<verse eid="SNG 2:5" /></para>
  <para style="sp">Mipui be pekatei pecu rang kebam</para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 2:6" />Pe ba hile a peu kangga bam,</para>
  <para style="q" vid="SNG 2:6">nah pe ba zetle le acu gai bam.<verse eid="SNG 2:6" /></para>
  <para style="sp">Mipui be mipui kedadung dage rang kebam</para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 2:7" />Ih nnui de peu sampet gai neubam, Jerusalem napuimedung,</para>
  <para style="q" vid="SNG 2:7">luh ga pak keci heti nah helung zi gade sampet gailo</para>
  <para style="q" vid="SNG 2:7">nnui kemrai de tei ndeu mede tei mrak gaiso</para>
  <para style="q" vid="SNG 2:7">pa neu kemakta.<verse eid="SNG 2:7" /></para>
  <para style="sp">Mipui be pekatei pecu rang kebam</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 2:8" />Ainie, a mraipei kwa! Kingneilu, pa gwang lada,</para>
  <para style="q" vid="SNG 2:8">lamlwatudung reu gade nsau ka gwang lada,</para>
  <para style="q" vid="SNG 2:8">kideutudung reu gade nsau gwang lada.<verse eid="SNG 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 2:9" />A mraipei au pak keci helung mede hetiseuna ge nzwa;</para>
  <para style="q" vid="SNG 2:9">pielo, pa au anai kirie caiga sap bam,</para>
  <para style="q" vid="SNG 2:9">hebaki gade pieling nlüt bam,</para>
  <para style="q" vid="SNG 2:9">rie pwa kebam gade pie nlüt gai.<verse eid="SNG 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 2:10" />A mraipei acu resiu eh ranggai,</para>
  <para style="q" vid="SNG 2:10">“Cuhlu, a mrai poe;</para>
  <para style="q" vid="SNG 2:10">a mrai poe, acu nzang gwanglu.<verse eid="SNG 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 2:11" />Pielo, tingtiak kah gwang dida;</para>
  <para style="q" vid="SNG 2:11">tingrui cang dida nah tet dida.<verse eid="SNG 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 2:12" />Hangdeu ga mapadung de pa bam dida;</para>
  <para style="q" vid="SNG 2:12">tsingbang kiak su kera nah nruinne kwa nra kera ting gwang bam dida,</para>
  <para style="q" vid="SNG 2:12">nah anui deu ga tamhaudung kwa siu bam dida.<verse eid="SNG 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 2:13" />Tangzüttsi bang kemdiak tangzüttsidung tei meu di zeu da,</para>
  <para style="q" vid="SNG 2:13">nah kube pa pa bam dida;</para>
  <para style="q" vid="SNG 2:13">perim kehengui penui dade mpet.</para>
  <para style="q" vid="SNG 2:13">Cuhlu, a mrai poe, hezukeyi poi, nah acu nzang gwanglu.<verse eid="SNG 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 2:14" />A tamhau, tsura koikidung gega kebam,</para>
  <para style="q" vid="SNG 2:14">kengkiem hetialwa tsura koikidung gega kebam,</para>
  <para style="q" vid="SNG 2:14">peu acu n zu ngaulo.</para>
  <para style="q" vid="SNG 2:14">Acu peu n kwa siulo,</para>
  <para style="q" vid="SNG 2:14">kedanemene n kwa au kum, nah n zu au hezuyi.”<verse eid="SNG 2:14" /></para>
  <para style="sp">Mipui be mipei dage rang kebam</para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 2:15" />Anai ziemne maiserungdung de tuilu, maiserung keceunadung</para>
  <para style="q" vid="SNG 2:15">kubeluh tei msiadi keladung de,</para>
  <para style="q" vid="SNG 2:15">kedanemene anai gu kubeluh au pa bam dida.<verse eid="SNG 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 2:16" />A mraipui au agu, nah Ih au pegu;</para>
  <para style="q" vid="SNG 2:16">pa pe kauhau de teizuinedung kakga neungga eh kwabam la.<verse eid="SNG 2:16" /></para>
  <para style="sp">Mipui be mipei dage rang kebam</para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 2:17" />Tetti lu, a mraipei,</para>
  <para style="q" vid="SNG 2:17">tingcang cikemak tingkai guigai kemakne nah kemuibedung gah di kemakne.</para>
  <para style="q" vid="SNG 2:17">Tetti lu; pak keci helung mede hetiseuna ge nzwa lu</para>
  <para style="q" vid="SNG 2:17">nsam kemak lamlwatudung ga kebam nzwa.<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="sp">Mipui be pekatei pecu rang kebam</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 3:1" />Tingmui a zeu ga</para>
  <para style="q" vid="SNG 3:1">a kubepei de Ih nsung bam;</para>
  <para style="q" vid="SNG 3:1">Ih pecu peei, dede Ih pecu ngaulu ma.<note caller="-" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="ISA 3:1">Isa. 3:1</ref></char></note><verse eid="SNG 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 3:2" />Ih akatei a dage rang, “Ih cuhlu zie nah namdi be ga huirwa zie,</para>
  <para style="q" vid="SNG 3:2">puiceunadung nah puididung ga;</para>
  <para style="q" vid="SNG 3:2">Ih a kubepei de peei zie.”</para>
  <para style="q" vid="SNG 3:2">Ih pecu peei, dede Ih pecu ngaulu ma.<verse eid="SNG 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 3:3" />Reketme namdi be ga hui gwang keladau acu ngaulu.</para>
  <para style="q" vid="SNG 3:3">Ih penuide keteu gai, “Nnui a kubepei de ngau mi?”<verse eid="SNG 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 3:4" />Ih penuide tetkah kedi mating tie de kemakne</para>
  <para style="q" vid="SNG 3:4">a kubepei de Ih ngaulu.</para>
  <para style="q" vid="SNG 3:4">Ih pecu tuilu nah pecu peu tetti ma</para>
  <para style="q" vid="SNG 3:4">a pui kiga Ih pecu ngngwa gwanglu kemaktane,</para>
  <para style="q" vid="SNG 3:4">acu nna kelube bung ga.<verse eid="SNG 3:4" /></para>
  <para style="sp">Mipui be mipui kedadung dage rang kebam</para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 3:5" />Ih nnui de peu sampet gai neubam, Jerusalem napuimedung,</para>
  <para style="q" vid="SNG 3:5">Luh ga pak keci helung nah hetidung zi gade sampet gailo,</para>
  <para style="q" vid="SNG 3:5">nnui kemrai de tei ndeu mede tei mrak gaiso</para>
  <para style="q" vid="SNG 3:5">pa neu kemaktane.<verse eid="SNG 3:5" /></para>
  <para style="sp">Mipui be pekatei pecu rang kebam</para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 3:6" />Hetaideu gade nghang kela cide daino</para>
  <para style="q" vid="SNG 3:6">mika tsia ge nzwa,</para>
  <para style="q" vid="SNG 3:6">myrrh nah marim kehengui gele perim tei hengui kelu nzwa,</para>
  <para style="q" vid="SNG 3:6">heli keteime ne pemütdung zwa kelu de?<verse eid="SNG 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 3:7" />Pielo, cide au Solomon zeu;</para>
  <para style="q" vid="SNG 3:7">reugwame riakherok cide de twagwalu,</para>
  <para style="q" vid="SNG 3:7">Israel reugwame riakherok.<verse eid="SNG 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 3:8" />Penui pelane kiengtie kepwa ciem ci nah penui au hereu tei kemnimme.</para>
  <para style="q" vid="SNG 3:8">Penui kiengtie ramcau penui mbie ga bam la,</para>
  <para style="q" vid="SNG 3:8">tingmui kengngi ziemne mtei pwabam.<verse eid="SNG 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 3:9" />Hegwangpei Solomon pekatei pe ziemne rapwalu kela teibam ge</para>
  <para style="q" vid="SNG 3:9">Lebanon gade tsing ngau kelube le teilu.<verse eid="SNG 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 3:10" />Pe tsiadung rangkanggeu le teilu;</para>
  <para style="q" vid="SNG 3:10">nah kecak le pe cai teilu, nah pe bam pai gieremang kecu ge le teilu.</para>
  <para style="q" vid="SNG 3:10">Pe lungki au keku le pwa tei hezuyi gai</para>
  <para style="q" vid="SNG 3:10">Jerusalem napuimedung ne.<verse eid="SNG 3:10" /></para>
  <para style="sp">Mipui be Jerusalem puidung de rang kebam</para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 3:11" />Zion napuidung, hegwale mpetlu, delwe Hegwangpei Solomon de piegailo,</para>
  <para style="q" vid="SNG 3:11">pe pui ne pe peu gage kai kebeu hegwang peurwa pung kebam</para>
  <para style="q" vid="SNG 3:11">pe nautak benai,</para>
  <para style="q" vid="SNG 3:11">pa pe suiyi kebam benai.<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="s">Mraipei</para>
  <para style="sp">Mipei be mipui dage rang kebam</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 4:1" />Oh, nang au hezuyi lie, a kubepoe; nang au hezuyi lie.</para>
  <para style="q" vid="SNG 4:1">N miakdung au tamhaudung nzwa lie n peuzui cai gade.</para>
  <para style="q" vid="SNG 4:1">N peutam au hemeu haudung nzwa da</para>
  <para style="q" vid="SNG 4:1">Gilead deutu gade nghung kela nzwa.<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="PRO 5:19">Mac. 5:19</ref></char></note><verse eid="SNG 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 4:2" />N geidung au meurün hau penui mai cune bit lwe kebam de nzwa da,</para>
  <para style="q" vid="SNG 4:2">hui kecu ni gade nghang kela.</para>
  <para style="q" vid="SNG 4:2">Peciakne de nedui ge bam,</para>
  <para style="q" vid="SNG 4:2">nah penui kakga petau kemak ge de gah.<verse eid="SNG 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 4:3" />N muileu au helangria kegie ge nzwa;</para>
  <para style="q" vid="SNG 4:3">n mui au hezuyi.</para>
  <para style="q" vid="SNG 4:3">N biadung au kuraletsi pempie nzwa</para>
  <para style="q" vid="SNG 4:3">n peuzui cai gade.<verse eid="SNG 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 4:4" />N nggwang au tangtsudung le teipwa kebam David gu renei nzwa,</para>
  <para style="q" vid="SNG 4:4">cika hegeu pecang gwak pung bam,</para>
  <para style="q" vid="SNG 4:4">reugwame pelane gu hegeudung.<verse eid="SNG 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 4:5" />N hekakrak kena de au hetina kena,</para>
  <para style="q" vid="SNG 4:5">helung nedui kena,</para>
  <para style="q" vid="SNG 4:5">teizuine padung kakga ma peei tyei kela de nzwa da.<verse eid="SNG 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 4:6" />Tingcang gwang di kemakne nah kemuibedung gah di kemakne,</para>
  <para style="q" vid="SNG 4:6">Ih myrrh lamlwatu ga mie zie</para>
  <para style="q" vid="SNG 4:6">nah perim kehengui kideutu ga.<verse eid="SNG 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 4:7" />Nang au maleune gade de hezuyi, a kubepoe</para>
  <para style="q" vid="SNG 4:7">nah ma kesia ge de n da gah.<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="EPH 5:27">Eph. 5:27</ref></char></note><verse eid="SNG 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 4:8" />Lebanon gade acu nzang gwanglu, a lakciubepoe.</para>
  <para style="q" vid="SNG 4:8">Lebanon gade acu nzang gwanglu;</para>
  <para style="q" vid="SNG 4:8">Amana deutu gade gwanglu,</para>
  <para style="q" vid="SNG 4:8">Senir nah Hermon deutu gade,</para>
  <para style="q" vid="SNG 4:8">hingho bam gade,</para>
  <para style="q" vid="SNG 4:8">kaudaunadung kideutudung ga lungh kebam gade.<verse eid="SNG 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 4:9" />Nang ne a mlung luu pwa dida, a tipui, a nau;</para>
  <para style="q" vid="SNG 4:9">nang ne a mlung luu pwa dida,</para>
  <para style="q" vid="SNG 4:9">n miakpie ge gade,</para>
  <para style="q" vid="SNG 4:9">n heteiria ga jewel ge ne.<verse eid="SNG 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 4:10" />N keku daikenzwa ge de hezuyi no, a tipui, anau!</para>
  <para style="q" vid="SNG 4:10">N keku au zau swa yiki,</para>
  <para style="q" vid="SNG 4:10">nah n rim kehengui de au mosala swa yiki.<verse eid="SNG 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 4:11" />N muileu gade, anau, heliadui zau mie;</para>
  <para style="q" vid="SNG 4:11">heliadui nah tungdui n mleu kangga bam;</para>
  <para style="q" vid="SNG 4:11">n painidung rim au Lebanon rim keyi de nzwa.<verse eid="SNG 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 4:12" />A tipui, anau au kengkiem gurie ge,</para>
  <para style="q" vid="SNG 4:12">kengkiem gurie ge, duilet nkiem pwa kebambe ge.<verse eid="SNG 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 4:13" />N kiakdung au kuraletsi bangdung lungh kebam luh ge nah petsi yitube buila,</para>
  <para style="q" vid="SNG 4:13">nah henna nah nard bangdung de si eh,<verse eid="SNG 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 4:14" />Nard nah saffron,</para>
  <para style="q" vid="SNG 4:14">calamus nah cinnamon nah mosala leune de si eh,</para>
  <para style="q" vid="SNG 4:14">myrrh nah aloe nah mosala yitubedung.<verse eid="SNG 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 4:15" />Nang au hegurie duilet ge,</para>
  <para style="q" vid="SNG 4:15">dui kemci tekwa ge,</para>
  <para style="q" vid="SNG 4:15">Lebanon gade lwa mie kebam reuceunadung.<verse eid="SNG 4:15" /></para>
  <para style="sp">Mipui be mipei dage rang kebam</para>
  <para style="s">Mraipui</para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 4:16" />Mraklu, tingtünle tingkai; gwanglu, tingbangle tingkai;</para>
  <para style="q" vid="SNG 4:16">a gurie gage gui gailo iciu eh peu pe mosala rim keyi kehenguidung gui mpetlu kerane.</para>
  <para style="q" vid="SNG 4:16">A kubepei de peu pe gurie ga gwanglu</para>
  <para style="q" vid="SNG 4:16">nah peu matsi yitubedung tyei lo.<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="s">Mraipei</para>
  <para style="sp">Mipei be mipui dage rang kebam</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 5:1" />Ih a gurie ga lüt luda, a tipui, a nau;</para>
  <para style="q" vid="SNG 5:1">Ih myrrh nah mosala hekwalu da.</para>
  <para style="q" vid="SNG 5:1">Ih au helialip nah heliadui tyeilu da;</para>
  <para style="q" vid="SNG 5:1">Ih a zau de tungdui si eh saklu da.</para>
  <para style="sp" vid="SNG 5:1">Zangmedung mipei nah mipui de rang kebam</para>
  <para style="q" vid="SNG 5:1">Tyeilu, zangnamedung;</para>
  <para style="q" vid="SNG 5:1">saklu nah keku le sakmie lu.<verse eid="SNG 5:1" /></para>
  <para style="sp">Mipui be pekatei pecu rang kebam</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 5:2" />Ih au zip bam, dede a mlung au mrak bam.</para>
  <para style="q" vid="SNG 5:2">A kubepei kikam ketung bam nah pa rang,</para>
  <para style="q" vid="SNG 5:2">“Acu kikam ngkei beulo, a tipui, a kubepui, a tamhau, a kemcipui,</para>
  <para style="q" vid="SNG 5:2">kedanemene hezin le a peu hwa dida,</para>
  <para style="q" vid="SNG 5:2">a peutam mwangzui le hwa dida.”<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="REV 3:20">Keu. 3:20</ref></char></note><verse eid="SNG 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 5:3" />“Ih a paini lwak mpetti da; Ih cide teu dailu maisia ni?</para>
  <para style="q" vid="SNG 5:3">Ih a pi hui dida; Ih a pi tei hera dai di maisia ni?”<verse eid="SNG 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 5:4" />A kubepei kikam ngkei kecu gage pe ba kaigai,</para>
  <para style="q" vid="SNG 5:4">nah a mlung pe ziemne herwa di.<verse eid="SNG 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 5:5" />Ih a kubepei de kikam ngkei beu kerane cuhlu;</para>
  <para style="q" vid="SNG 5:5">a badung gade myrrh zaumie bam,</para>
  <para style="q" vid="SNG 5:5">a zurangdung myrrh le hwa bam,</para>
  <para style="q" vid="SNG 5:5">kikam bazap ga.<verse eid="SNG 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 5:6" />Ih a kubepei ziemne kikam ngkei beu,</para>
  <para style="q" vid="SNG 5:6">dede a kubepei au nreu tetti da.</para>
  <para style="q" vid="SNG 5:6">Pa marang gai kecu dau a sui siadi.</para>
  <para style="q" vid="SNG 5:6">Ih pecu peei twagwa, dede Ih pecu ngaulu ma;</para>
  <para style="q" vid="SNG 5:6">Ih pecu qu gai, dede pa a sam kelibeu ma.<verse eid="SNG 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 5:7" />Reketme namdi ga hui gwang keladau acu ngaulu.</para>
  <para style="q" vid="SNG 5:7">Penui acu tei nah acu rejam di;</para>
  <para style="q" vid="SNG 5:7">kekwame kirie ga kebamme ne a pai süt pwadi.<verse eid="SNG 5:7" /></para>
  <para style="sp">Mipui be namdi be ga mipuidung de rang kebam</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 5:8" />Ih nnuide peu sampet gai neubam, Jerusalem napuidung,</para>
  <para style="q" vid="SNG 5:8">nnui a kubepei de peeilu cai,</para>
  <para style="q" vid="SNG 5:8">Nnui pecu peu dai cilu lai no?,</para>
  <para style="q" vid="SNG 5:8">Ih kemrai ne mnei dida de kecu.<verse eid="SNG 5:8" /></para>
  <para style="sp">Namdi be ga mipuidung mipui be de rang kebam</para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 5:9" />Dainzwa eh n kubepei kedame kubepei swa yiki no,</para>
  <para style="q" vid="SNG 5:9">mipuime kak gade hezu yitube poe?</para>
  <para style="q" vid="SNG 5:9">Daitei n kubepei kedame kubepei swa yiki no,</para>
  <para style="q" vid="SNG 5:9">anuide ai kenzwa sampet tei kera kie kecu.<verse eid="SNG 5:9" /></para>
  <para style="s">Mrapui</para>
  <para style="sp">Namdi be ga mipui be mipuidung de rang kebam</para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 5:10" />A kubepei au hezuyi nah gie remang,</para>
  <para style="q" vid="SNG 5:10">mina cang kerei swa de yi.<verse eid="SNG 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 5:11" />Pe peu au kecak yitube;</para>
  <para style="q" vid="SNG 5:11">pe tam au ndau nah hegak nzwa tiak.<verse eid="SNG 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 5:12" />Pe miakdung au reunaki taiga tamhau nzwa da,</para>
  <para style="q" vid="SNG 5:12">tungdui gage hui pwa kebam, jeweldung de le mtei pwa kebam nzwa.<verse eid="SNG 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 5:13" />Pe biadung au mosala guriedung nzwa,</para>
  <para style="q" vid="SNG 5:13">marim kehenguidung pung kebam.</para>
  <para style="q" vid="SNG 5:13">Pe muileu au teizuine padung, myrrh dui zau mie kebam nzwa.<verse eid="SNG 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 5:14" />Pe badung au kecak kenggwadung nah jeweldung de si eh;</para>
  <para style="q" vid="SNG 5:14">pe za au hepwangeu sapphiredung le gumpung bam.<verse eid="SNG 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 5:15" />Pe pidung au marble tsia, kecak singkam gage sum pwa kebam;</para>
  <para style="q" vid="SNG 5:15">pa au Lebanon nzwa, cedardung nzwa yi.<verse eid="SNG 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 5:16" />Pe mui au kum zu;</para>
  <para style="q" vid="SNG 5:16">pa au nca cangsiak.</para>
  <para style="q" vid="SNG 5:16">Aide au a kubepei, nah aide au a zangbe,</para>
  <para style="q" vid="SNG 5:16">Jerusalem napuimedung.<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="s">Zangname</para>
  <para style="sp">Jerusalem puidung mipui be dage rang kebam</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 6:1" />N mraipei daiga miedi no,</para>
  <para style="q" vid="SNG 6:1">mipuime kakgade hezu yitube poe?</para>
  <para style="q" vid="SNG 6:1">Mraipei dai lambie miedi no,</para>
  <para style="q" vid="SNG 6:1">anui ncu ngngwa pecu peei beu kerane?<verse eid="SNG 6:1" /></para>
  <para style="sp">Mipui be pekatei pecu rang kebam</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 6:2" />A kubepei pe gurie ga hungdi,</para>
  <para style="q" vid="SNG 6:2">mosala luhdung ga,</para>
  <para style="q" vid="SNG 6:2">hegurie ga pe kauhau de peu matyei kera nah teizuine pa hekwa kerane.<verse eid="SNG 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 6:3" />Ih au a kubepei gu, nah pa au agu;</para>
  <para style="q" vid="SNG 6:3">pa neungga eh pe kauhau de teizuine padung kakga peu matyei la.<verse eid="SNG 6:3" /></para>
  <para style="s">Mraipei</para>
  <para style="sp">Mipei mipui dage rang kebam</para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 6:4" />Nang au Tirzah nzwa hezuyi, a kubepoe,</para>
  <para style="q" vid="SNG 6:4">Jerusalem nzwa hezuyi,</para>
  <para style="q" vid="SNG 6:4">reugwame penui pailim teu kelame nzwa herüt pung kela.<verse eid="SNG 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 6:5" />N miak de a dade nreu di lulo,</para>
  <para style="q" vid="SNG 6:5">kedanemene ci kena de a ziemne ngking dida.</para>
  <para style="q" vid="SNG 6:5">N peutam au hemeu haudung nzwa da</para>
  <para style="q" vid="SNG 6:5">Gilead deutu gade nghung kela nzwa.<verse eid="SNG 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 6:6" />N geidung au meurün puidung nzwa da,</para>
  <para style="q" vid="SNG 6:6">hui kecu ni gade nghang kela nzwa da.</para>
  <para style="q" vid="SNG 6:6">Peciakne de nedui ge bam,</para>
  <para style="q" vid="SNG 6:6">nah penui kakga gah de di ma.<verse eid="SNG 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 6:7" />N biadung au kuraletsi pempie ge nzwa</para>
  <para style="q" vid="SNG 6:7">n peuzui cai gade.<verse eid="SNG 6:7" /></para>
  <para style="sp">Mipei pekatei pecu rang kebam</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 6:8" />Cika hegwangpuidung riakherok bam, nauseupui riakheset,</para>
  <para style="q" vid="SNG 6:8">nah releime peei kap gai kelak ge bam.<verse eid="SNG 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 6:9" />A tamhau, a kemcipui, pa rünne delie;</para>
  <para style="q" vid="SNG 6:9">pa au pe pui na pumli;</para>
  <para style="q" vid="SNG 6:9">pe pui ne nna kelu gade pe pui suitube.</para>
  <para style="q" vid="SNG 6:9">Releimedung pecu ngau nah pecu samlam kepung puige lie qu di;</para>
  <para style="q" vid="SNG 6:9">hegwangpuidung nah nauseupuidung de pecu ngau, nah pecu twadi:<verse eid="SNG 6:9" /></para>
  <para style="sp">Hegwangpuidung nah nauseupuidung rang kecu</para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 6:10" />“Tingcang nzwa kecu aide cauno,</para>
  <para style="q" vid="SNG 6:10">hekei nzwa hezukeyi,</para>
  <para style="q" vid="SNG 6:10">tingnaimiak nzwa baa,</para>
  <para style="q" vid="SNG 6:10">reugwame penui pailim teu kelame nzwa herüt pung kela?”<verse eid="SNG 6:10" /></para>
  <para style="sp">Mipei be pekatei pecu rang kebam</para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 6:11" />Matsibangdung ziu kakga Ih nghung</para>
  <para style="q" vid="SNG 6:11">langkam ga mabang keceunadung lungh kepet de pie kerane,</para>
  <para style="q" vid="SNG 6:11">kubebang penei keheci bwa mi bwapet mebi pie kerane,</para>
  <para style="q" vid="SNG 6:11">nah kuraletsi bangdung pa mi pa mebi pie kerane.<verse eid="SNG 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 6:12" />Ih a sui sütti eh</para>
  <para style="q" vid="SNG 6:12">Ih hegwang napei bagi reuga tet kela nzwa di.<verse eid="SNG 6:12" /></para>
  <para style="sp">Zangmedung mipui de rang kebam</para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 6:13" />Ncai nreu lu, ncai nreu lu, yi cangsiak kecube poe;</para>
  <para style="q" vid="SNG 6:13">ncai nreu lu, ncai nreu lu iciu eh anui ncu pieling gailu kerane.</para>
  <para style="sp" vid="SNG 6:13">Mipui be zangme de rang kebam</para>
  <para style="q" vid="SNG 6:13">Nnui daitei yi cangsiak kecube pui de pieling eh bam no,</para>
  <para style="q" vid="SNG 6:13">reugwame hemaa kena helim lim kebam nzwa?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="sp">Mipei be mipui dage rang kebam</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 7:1" />N picumdung ga n pi daikenzwa ge de ngau hezuyi no, hegwangpei napoe!</para>
  <para style="q" vid="SNG 7:1">N mniepum kengkoi kena de au jeweldung nzwa da,</para>
  <para style="q" vid="SNG 7:1">heciemta tei kecime tah nzwa da.<verse eid="SNG 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 7:2" />N nla au hekwak kenggwa ge nzwa da;</para>
  <para style="q" vid="SNG 7:2">peu cide ga madaude zau tei ncüt kelu cam nrum diso.</para>
  <para style="q" vid="SNG 7:2">N za au wheat meikwa ge</para>
  <para style="q" vid="SNG 7:2">teizuine padung le twagwa kebam nzwa da.<verse eid="SNG 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 7:3" />N tung kena de au hetina kena nzwa da,</para>
  <para style="q" vid="SNG 7:3">helung nedui kena ge.<verse eid="SNG 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 7:4" />N ngwang au hepwangeu le tei kelu renei ge nzwa da;</para>
  <para style="q" vid="SNG 7:4">n miak kena de au Heshbon ga kebam rejaai nzwa da</para>
  <para style="q" vid="SNG 7:4">Bath Rabbim kirie taiga kebam.</para>
  <para style="q" vid="SNG 7:4">N ngkie au Lebanon hapia</para>
  <para style="q" vid="SNG 7:4">Damascus lebie pie kebam de nzwa da.<verse eid="SNG 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 7:5" />N peu au Carmel nzwa da;</para>
  <para style="q" vid="SNG 7:5">n peutam au gieremang ketiak ge.</para>
  <para style="q" vid="SNG 7:5">Hegwangpei de cide kangpwakelu dene tuibang pwa bam.<verse eid="SNG 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 7:6" />Daikenzwa ge hezuyi nah daikenzwa ge heguipung no,</para>
  <para style="q" vid="SNG 7:6">a kubepoe, misui herwa süt kecuge lie!<verse eid="SNG 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 7:7" />Nang au palm bang ra tie ge nzwa da,</para>
  <para style="q" vid="SNG 7:7">nah n tung kena au matsi peudung ge nzwa da.<verse eid="SNG 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 7:8" />Ih ranggai, “Ih cipau palm bang dega nra neu;</para>
  <para style="q" vid="SNG 7:8">Ih pe kiakdung kerak gai zie.”</para>
  <para style="q" vid="SNG 7:8">N tung kena de peu kubetsidung peu nzwa lulo,</para>
  <para style="q" vid="SNG 7:8">nah ncui rim de peu tampaktsi rim nzwa lulo.<verse eid="SNG 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 7:9" />N mui de peu zau yitube nzwa lulo,</para>
  <para style="q" vid="SNG 7:9">a kubepui ziemne lwa sünne eh,</para>
  <para style="q" vid="SNG 7:9">ziep kebamme muileu gade lwa mie eh.<verse eid="SNG 7:9" /></para>
  <para style="sp">Mipui be mipei dage rang kebam</para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 7:10" />Ih au a kubepei gu,</para>
  <para style="q" vid="SNG 7:10">nah pa acu hengim bam.<verse eid="SNG 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 7:11" />Gwanglu, a kubepei, deudikungga pet golie;</para>
  <para style="q" vid="SNG 7:11">kilwadung ga pe zeuziu bam golie<verse eid="SNG 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 7:12" />Tingcang cuh zi lwe kubeluhdung ga mie golie;</para>
  <para style="q" vid="SNG 7:12">kubebang penei keheci bwa mi bwapet mebi kecu,</para>
  <para style="q" vid="SNG 7:12">pe padung pa di demi de kecu,</para>
  <para style="q" vid="SNG 7:12">nah kuraletsi bangdung pa au demi de kecu pie gai golie.</para>
  <para style="q" vid="SNG 7:12">Cika Ih ncu a keku peugai zie.<verse eid="SNG 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 7:13" />Mandrake bang perim kehengui nnamlu zie;</para>
  <para style="q" vid="SNG 7:13">anai kebam kikam be ga matsi keyi ketsamtsam, keheci nah kehegwa pelane bam,</para>
  <para style="q" vid="SNG 7:13">Ih n ziemne hekwa pwa kebam de, a kubepoi.<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="sp">Mipui be mipei dage rang kebam</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 8:1" />Ih peu ncu a sinabe lie neu lie,</para>
  <para style="q" vid="SNG 8:1">a pui tung gade tung kelube.</para>
  <para style="q" vid="SNG 8:1">Iciu eh Ih hegwale ncu redau kecudau de, Ih ncu kemam lubuilu,</para>
  <para style="q" vid="SNG 8:1">nah migede acu pelung sia dilak lu.<verse eid="SNG 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 8:2" />Ih n puisau tei pwa ncu a pui kiga ngngwa gwang zie,</para>
  <para style="q" vid="SNG 8:2">pa acu ledeu kebeube.</para>
  <para style="q" vid="SNG 8:2">Ih ncu masala zau peu sak kera ha zie</para>
  <para style="q" vid="SNG 8:2">nah a kuraletsi le tei pwa kebam petsi dui peu sak zie.<verse eid="SNG 8:2" /></para>
  <para style="sp">Mipui be pekatei pecu rang kebam</para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 8:3" />Pe ba hile a peu kangga bam,</para>
  <para style="q" vid="SNG 8:3">nah pe ba zetle le acu kemui bam.<verse eid="SNG 8:3" /></para>
  <para style="sp">Mipui be mipui kedadung dage rang kebam</para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 8:4" />Ih nnuide peu sampet gai neubam, Jerusalem napuimedung,</para>
  <para style="q" vid="SNG 8:4">nnui kemrai tei kebwak mede tei mrak lak lie kecu</para>
  <para style="q" vid="SNG 8:4">pa neu kemaktane.<verse eid="SNG 8:4" /></para>
  <para style="s">Zangname</para>
  <para style="sp">Jerusalem puidung mipui be dage rang kebam</para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 8:5" />Hetaideu gade nghang kela aide cau no,</para>
  <para style="q" vid="SNG 8:5">pe kubepei de ngngei kebambe de?</para>
  <para style="sp" vid="SNG 8:5">Mipui be mipei dage rang kebam</para>
  <para style="q" vid="SNG 8:5">Ih ncu tampaktsi bang kang gade tei mraklu;</para>
  <para style="q" vid="SNG 8:5">cikade n pui ncu tetlak lu;</para>
  <para style="q" vid="SNG 8:5">cikade ncu mnalu.<verse eid="SNG 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 8:6" />Acu n mlung gage baang lu,</para>
  <para style="q" vid="SNG 8:6">n ba gage tuipwa kelu nzwa,</para>
  <para style="q" vid="SNG 8:6">kedanemene keku au ketsai nzwa ngking.</para>
  <para style="q" vid="SNG 8:6">Mrai kemcui au pe keku gah Sheol nzwa;</para>
  <para style="q" vid="SNG 8:6">pe miheudung heupetla; cide au mi heusüt kecu ge,</para>
  <para style="q" vid="SNG 8:6">miheu kedadung swa lum gwa kecu ge.<note caller="-" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="ISA 49:16">Isa. 49:16</ref></char></note><verse eid="SNG 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 8:7" />Dui kekiee le keku cide peu gailak,</para>
  <para style="q" vid="SNG 8:7">duinai le cide pung tetti gailak.</para>
  <para style="q" vid="SNG 8:7">Mipei ge pe ki mabam pelane keku ziemne peu cai,</para>
  <para style="q" vid="SNG 8:7">cide de au mlai dizie.<verse eid="SNG 8:7" /></para>
  <para style="s">Zangname</para>
  <para style="sp">Mipui be heimedung penui katei penui kakga resiu kebam</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 8:8" />Anui tipuina ge bam,</para>
  <para style="q" vid="SNG 8:8">nah pe tung de ceu zeu reu.</para>
  <para style="q" vid="SNG 8:8">Mige gwang hemeu ziemne pecu kie kecu benai</para>
  <para style="q" vid="SNG 8:8">anui tipuina ziemne anui dai ge tei lu lai no?<verse eid="SNG 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 8:9" />Pa tangdeu ge cai,</para>
  <para style="q" vid="SNG 8:9">anui pereu gage rangkanggeu hapia ge teigai zie.</para>
  <para style="q" vid="SNG 8:9">Pa kikam ge cai</para>
  <para style="q" vid="SNG 8:9">anui cedar kwakdung le pecu mtei gai zie.<verse eid="SNG 8:9" /></para>
  <para style="s">Mraipui</para>
  <para style="sp">Mipui be pekatei pecu rang kebam</para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 8:10" />Ih kirie ge bamla, dede cu au a tung kuda hapiadung nzwa dida;</para>
  <para style="q" vid="SNG 8:10">cine Ih au pe miak dwa gade lungciep teugwang beu kela ge dida.<note caller="-" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="PSA 45:11">Lei. 45:11</ref></char></note><verse eid="SNG 8:10" /></para>
  <para style="sp">Mipui be pekatei pecu rang kebam</para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 8:11" />Baal Hamon ga Solomon gu kubeluh ge bam.</para>
  <para style="q" vid="SNG 8:11">Pa kubeluh cide lamlui lu kebuime de ha beu.</para>
  <para style="q" vid="SNG 8:11">Hangge ge kecu petsi ziemne rangkanggeu shekel cangge ge keugwang beu kerabe.<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="MAT 21:33">Mat. 21:33</ref></char></note><verse eid="SNG 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 8:12" />A kubeluh, agu rünne, cide a dwa ga bam;</para>
  <para style="q" vid="SNG 8:12">shekel cangge de n ziemne da, Solomon,</para>
  <para style="q" vid="SNG 8:12">nah shekel haina de petsi pie rengei kebeume ziemne.<verse eid="SNG 8:12" /></para>
  <para style="sp">Mipei be mipui dage rang kebam</para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 8:13" />Nang heguriedung ga lungh kebamme,</para>
  <para style="q" vid="SNG 8:13">a zangmedung n kwa kingnei eh bam;</para>
  <para style="q" vid="SNG 8:13">acu peu kingnei gailo.<verse eid="SNG 8:13" /></para>
  <para style="sp">Mipui be mipei dage rang kebam</para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 8:14" />Kelwalu, a kubepei,</para>
  <para style="q" vid="SNG 8:14">nah pak keci helung mede hetiseuna ge nzwalu</para>
  <para style="q" vid="SNG 8:14">mosala lamlwatudung ga.<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>