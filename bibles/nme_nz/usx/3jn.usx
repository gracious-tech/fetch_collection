  <book code="3JN" style="id">EN_EULT en_English_ltr Fri Nov 13 2020 12:18:52 GMT+0530 (India Standard Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">3 John</para>
  <para style="toc1">John ne raukegai laisiu kecumbe</para>
  <para style="toc2">John Kecumbe</para>
  <para style="toc3">3 Jhn.</para>
  <para style="mt">3 John</para>
  <para style="mt">John ne raukegai laisiu kecumbe</para>
  <para style="is">Mraisam</para>
  <para style="ip">John kecumbe de raupwa Gaius, John zangbe nah ngqwa ga muiteube dage kai. Gaius ngqwa ga mige pezi Diotrephes lie bamla, nah pa Tinggwang gwamedung de mlai eh bamla. John laisiu aide raupwa Gaius de pe kengha ziemne twa nah kenggia sam ranggai nah Diotrephes mide bazwa lula kemakne kesiu gai. Makie aide ziemne John ngqwa aide ga kelwagwang kera sampet gai.</para>
  <para style="iot">Pelung ga keladung</para>
  <para style="io1">Kelum kegai (1-4)</para>
  <para style="io1">Gaius de kecung kegai (5-8)</para>
  <para style="io1">Diotrephes de kesiu kegai (9-10)</para>
  <para style="io1">Kekambe (13-14)</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Hangkiabe ne laisiu aide raupwa, keku Gaius, Ih kesang gade hungkelabe dage kekai.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />Kehung azangbo, n rabe kilam yi kebam nzwa, maleune gade peu yilu kerane nah pumteih yimcang bam kerane Ih kie gaila. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Kedanemene nang kesangbe ga tetkela nzwa, sinamedung gwang eh nang kesangbe ga kela ha zierang tei kegai dau, Ih a suiyi süt lie. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Ih a namedung kesangbe ga tetla lie kecu siu kecu swa Ih a sui yiki kecu gahlie.<verse eid="3JN 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Kehung azangbo, nang anui zangme kenlumme ziemne heta ketei ga masang lie, penui au sangme liede, <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />penui n keku zierang de ngqwabe dwa gade ranggai da. Nang penuide Tinggwang dwade petaube tei eh penui beuh ga tet jüja gwanglu kera ngha lo, <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />kedanemene penui Gentileme dade kengha gede teu mene pe zi ziemne tetpet di delu. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Ciziemne anui cikenzwamedung de au ngha kerabe, ciciu eh anui kesangbe ga ngngwa heta keteime teilu kerane.<verse eid="3JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Ih madungge raupwa ngqwabe dage kaigai, dede Diotrephes, penui muiteu tei keneube, anuide ngngwa luma. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Aide ziemne, Ih kegwang dau, pe tadung pa tei kebam de pie kera Ih qu gaizie—anuide sam kesiabe le kemmaudung de. Dede ma aidungde le nnung mene, pa sinamedung de ngngwa luma, nah pa penuide ngngwa luneu kelame de de kaam dila delwe penuide ngqwaki gade de gwagi dila. <verse eid="3JN 1:10" /><verse number="11" style="v" sid="3JN 1:11" />Kehung azangbo, kesiabe reli so, dede keyibe reli lu. Keyi tei kelabe au Tinggwang dade gwang; kesia tei kelabe au Tinggwang de ngau ma. <verse eid="3JN 1:11" /><verse number="12" style="v" sid="3JN 1:12" />Demetrius ha mileune ne nah kesangbe ne de zierang teigai. Nah anuide pe zierang tei gaila nah anui zierang de kesang lie kecu nang cibam.<verse eid="3JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Ih ma kekiee ge n dage raugai kera bam, dede Ih cidungde keraudui nah kerautie le raugai neuma. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />Dede Ih ncu zette kerengau kera regui bam, nah anai kezu ngau eh kempau zie.<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="2JN 1:12">2 Jhn. 1:12</ref></char></note> <verse eid="3JN 1:14" /><verse number="15" style="v" sid="3JN 1:15" />Peu lungciep nda bam kelube tei lulo. Zangnamedung ncu kelum gaila. Zangnamedung hangge ge kecu de kelum gailo.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>