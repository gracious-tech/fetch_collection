<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="3JN" style="id">Sanskrit Bible (NT) in Kannada Script (ಸತ್ಯವೇದಃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">3 John</para>
  <para style="toc1">೩ ಯೋಹನಃ ಪತ್ರಂ</para>
  <para style="toc2">೩ ಯೋಹನಃ</para>
  <para style="toc3">೩ ಯೋಹನಃ</para>
  <para style="mt1">೩ ಯೋಹನಃ ಪತ್ರಂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಪ್ರಾಚೀನೋ ಽಹಂ ಸತ್ಯಮತಾದ್ ಯಸ್ಮಿನ್ ಪ್ರೀಯೇ ತಂ ಪ್ರಿಯತಮಂ ಗಾಯಂ ಪ್ರತಿ ಪತ್ರಂ ಲಿಖಾಮಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಹೇ ಪ್ರಿಯ, ತವಾತ್ಮಾ ಯಾದೃಕ್ ಶುಭಾನ್ವಿತಸ್ತಾದೃಕ್ ಸರ್ವ್ವವಿಷಯೇ ತವ ಶುಭಂ ಸ್ವಾಸ್ಥ್ಯಞ್ಚ ಭೂಯಾತ್|</para>
  <para style="p">
    <verse number="3" style="v"/>ಭ್ರಾತೃಭಿರಾಗತ್ಯ ತವ ಸತ್ಯಮತಸ್ಯಾರ್ಥತಸ್ತ್ವಂ ಕೀದೃಕ್ ಸತ್ಯಮತಮಾಚರಸ್ಯೇತಸ್ಯ ಸಾಕ್ಷ್ಯೇ ದತ್ತೇ ಮಮ ಮಹಾನನ್ದೋ ಜಾತಃ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಮಮ ಸನ್ತಾನಾಃ ಸತ್ಯಮತಮಾಚರನ್ತೀತಿವಾರ್ತ್ತಾತೋ ಮಮ ಯ ಆನನ್ದೋ ಜಾಯತೇ ತತೋ ಮಹತ್ತರೋ ನಾಸ್ತಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಹೇ ಪ್ರಿಯ, ಭ್ರಾತೃನ್ ಪ್ರತಿ ವಿಶೇಷತಸ್ತಾನ್ ವಿದೇಶಿನೋ ಭೃाತೃನ್ ಪ್ರತಿ ತ್ವಯಾ ಯದ್ಯತ್ ಕೃತಂ ತತ್ ಸರ್ವ್ವಂ ವಿಶ್ವಾಸಿನೋ ಯೋಗ್ಯಂ|</para>
  <para style="p">
    <verse number="6" style="v"/>ತೇ ಚ ಸಮಿತೇಃ ಸಾಕ್ಷಾತ್ ತವ ಪ್ರಮ್ನಃ ಪ್ರಮಾಣಂ ದತ್ತವನ್ತಃ, ಅಪರಮ್ ಈಶ್ವರಯೋಗ್ಯರೂಪೇಣ ತಾನ್ ಪ್ರಸ್ಥಾಪಯತಾ ತ್ವಯಾ ಸತ್ಕರ್ಮ್ಮ ಕಾರಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯತಸ್ತೇ ತಸ್ಯ ನಾಮ್ನಾ ಯಾತ್ರಾಂ ವಿಧಾಯ ಭಿನ್ನಜಾತೀಯೇಭ್ಯಃ ಕಿಮಪಿ ನ ಗೃಹೀತವನ್ತಃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ತಸ್ಮಾದ್ ವಯಂ ಯತ್ ಸತ್ಯಮತಸ್ಯ ಸಹಾಯಾ ಭವೇಮ ತದರ್ಥಮೇತಾದೃಶಾ ಲೋಕಾ ಅಸ್ಮಾಭಿರನುಗ್ರಹೀತವ್ಯಾಃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಸಮಿತಿಂ ಪ್ರತ್ಯಹಂ ಪತ್ರಂ ಲಿಖಿತವಾನ್ ಕಿನ್ತು ತೇಷಾಂ ಮಧ್ಯೇ ಯೋ ದಿಯತ್ರಿಫಿಃ ಪ್ರಧಾನಾಯತೇ ಸೋ ಽಸ್ಮಾನ್ ನ ಗೃಹ್ಲಾತಿ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಅತೋ ಽಹಂ ಯದೋಪಸ್ಥಾಸ್ಯಾಮಿ ತದಾ ತೇನ ಯದ್ಯತ್ ಕ್ರಿಯತೇ ತತ್ ಸರ್ವ್ವಂ ತಂ ಸ್ಮಾರಯಿಷ್ಯಾಮಿ, ಯತಃ ಸ ದುರ್ವ್ವಾಕ್ಯೈರಸ್ಮಾನ್ ಅಪವದತಿ, ತೇನಾಪಿ ತೃಪ್ತಿಂ ನ ಗತ್ವಾ ಸ್ವಯಮಪಿ ಭ್ರಾತೃನ್ ನಾನುಗೃಹ್ಲಾತಿ ಯೇ ಚಾನುಗ್ರಹೀತುಮಿಚ್ಛನ್ತಿ ತಾನ್ ಸಮಿತಿತೋ ಽಪಿ ಬಹಿಷ್ಕರೋತಿ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಹೇ ಪ್ರಿಯ, ತ್ವಯಾ ದುಷ್ಕರ್ಮ್ಮ ನಾನುಕ್ರಿಯತಾಂ ಕಿನ್ತು ಸತ್ಕರ್ಮ್ಮೈವ| ಯಃ ಸತ್ಕರ್ಮ್ಮಾಚಾರೀ ಸ ಈಶ್ವರಾತ್ ಜಾತಃ, ಯೋ ದುಷ್ಕರ್ಮ್ಮಾಚಾರೀ ಸ ಈಶ್ವರಂ ನ ದೃಷ್ಟವಾನ್|</para>
  <para style="p">
    <verse number="12" style="v"/>ದೀಮೀತ್ರಿಯಸ್ಯ ಪಕ್ಷೇ ಸರ್ವ್ವೈಃ ಸಾಕ್ಷ್ಯಮ್ ಅದಾಯಿ ವಿಶೇಷತಃ ಸತ್ಯಮತೇನಾಪಿ, ವಯಮಪಿ ತತ್ಪಕ್ಷೇ ಸಾಕ್ಷ್ಯಂ ದದ್ಮಃ, ಅಸ್ಮಾಕಞ್ಚ ಸಾಕ್ಷ್ಯಂ ಸತ್ಯಮೇವೇತಿ ಯೂಯಂ ಜಾನೀಥ|</para>
  <para style="p">
    <verse number="13" style="v"/>ತ್ವಾಂ ಪ್ರತಿ ಮಯಾ ಬಹೂನಿ ಲೇಖಿತವ್ಯಾನಿ ಕಿನ್ತು ಮಸೀಲೇಖನೀಭ್ಯಾಂ ಲೇಖಿತುಂ ನೇಚ್ಛಾಮಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಅಚಿರೇಣ ತ್ವಾಂ ದ್ರಕ್ಷ್ಯಾಮೀತಿ ಮಮ ಪ್ರತ್ಯಾಶಾಸ್ತೇ ತದಾವಾಂ ಸಮ್ಮುಖೀಭೂಯ ಪರಸ್ಪರಂ ಸಮ್ಭಾಷಿಷ್ಯಾವಹೇ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತವ ಶಾನ್ತಿ ರ್ಭೂಯಾತ್| ಅಸ್ಮಾಕಂ ಮಿತ್ರಾಣಿ ತ್ವಾಂ ನಮಸ್ಕಾರಂ ಜ್ಞಾಪಯನ್ತಿ ತ್ವಮಪ್ಯೇಕೈಕಸ್ಯ ನಾಮ ಪ್ರೋಚ್ಯ ಮಿತ್ರೇಭ್ಯೋ ನಮಸ್ಕುರು| ಇತಿ|</para>
</usx>
