<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="PHM" style="id">Sanskrit Bible (NT) in Kannada Script (ಸತ್ಯವೇದಃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Philemon</para>
  <para style="toc1">ಫಿಲೋಮೋನಂ ಪತ್ರಂ</para>
  <para style="toc2">ಫಿಲೋಮೋನಃ</para>
  <para style="toc3">ಫಿಲೋಮೋನಃ</para>
  <para style="mt1">ಫಿಲೋಮೋನಂ ಪತ್ರಂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಖ್ರೀಷ್ಟಸ್ಯ ಯೀಶೋ ರ್ಬನ್ದಿದಾಸಃ ಪೌಲಸ್ತೀಥಿಯನಾಮಾ ಭ್ರಾತಾ ಚ ಪ್ರಿಯಂ ಸಹಕಾರಿಣಂ ಫಿಲೀಮೋನಂ</para>
  <para style="p">
    <verse number="2" style="v"/>ಪ್ರಿಯಾಮ್ ಆಪ್ಪಿಯಾಂ ಸಹಸೇನಾಮ್ ಆರ್ಖಿಪ್ಪಂ ಫಿಲೀಮೋನಸ್ಯ ಗೃಹೇ ಸ್ಥಿತಾಂ ಸಮಿತಿಞ್ಚ ಪ್ರತಿ ಪತ್ರಂ ಲಿಖತಃ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅಸ್ಮಾಕಂ ತಾತ ಈಶ್ವರಃ ಪ್ರಭು ರ್ಯೀಶುಖ್ರೀಷ್ಟಶ್ಚ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಶಾನ್ತಿಮ್ ಅನುಗ್ರಹಞ್ಚ ಕ್ರಿಯಾಸ್ತಾಂ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಪ್ರಭುಂ ಯೀಶುಂ ಪ್ರತಿ ಸರ್ವ್ವಾನ್ ಪವಿತ್ರಲೋಕಾನ್ ಪ್ರತಿ ಚ ತವ ಪ್ರೇಮವಿಶ್ವಾಸಯೋ ರ್ವೃತ್ತಾನ್ತಂ ನಿಶಮ್ಯಾಹಂ</para>
  <para style="p">
    <verse number="5" style="v"/>ಪ್ರಾರ್ಥನಾಸಮಯೇ ತವ ನಾಮೋಚ್ಚಾರಯನ್ ನಿರನ್ತರಂ ಮಮೇಶ್ವರಂ ಧನ್ಯಂ ವದಾಮಿ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅಸ್ಮಾಸು ಯದ್ಯತ್ ಸೌಜನ್ಯಂ ವಿದ್ಯತೇ ತತ್ ಸರ್ವ್ವಂ ಖ್ರೀಷ್ಟಂ ಯೀಶುಂ ಯತ್ ಪ್ರತಿ ಭವತೀತಿ ಜ್ಞಾನಾಯ ತವ ವಿಶ್ವಾಸಮೂಲಿಕಾ ದಾನಶೀಲತಾ ಯತ್ ಸಫಲಾ ಭವೇತ್ ತದಹಮ್ ಇಚ್ಛಾಮಿ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಹೇ ಭ್ರಾತಃ, ತ್ವಯಾ ಪವಿತ್ರಲೋಕಾನಾಂ ಪ್ರಾಣ ಆಪ್ಯಾಯಿತಾ ಅಭವನ್ ಏತಸ್ಮಾತ್ ತವ ಪ್ರೇಮ್ನಾಸ್ಮಾಕಂ ಮಹಾನ್ ಆನನ್ದಃ ಸಾನ್ತ್ವನಾ ಚ ಜಾತಃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ತ್ವಯಾ ಯತ್ ಕರ್ತ್ತವ್ಯಂ ತತ್ ತ್ವಾಮ್ ಆಜ್ಞಾಪಯಿತುಂ ಯದ್ಯಪ್ಯಹಂ ಖ್ರೀಷ್ಟೇನಾತೀವೋತ್ಸುಕೋ ಭವೇಯಂ ತಥಾಪಿ ವೃದ್ಧ</para>
  <para style="p">
    <verse number="9" style="v"/>ಇದಾನೀಂ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಬನ್ದಿದಾಸಶ್ಚೈವಮ್ಭೂತೋ ಯಃ ಪೌಲಃ ಸೋಽಹಂ ತ್ವಾಂ ವಿನೇತುಂ ವರಂ ಮನ್ಯೇ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಅತಃ ಶೃಙ್ಖಲಬದ್ಧೋಽಹಂ ಯಮಜನಯಂ ತಂ ಮದೀಯತನಯಮ್ ಓನೀಷಿಮಮ್ ಅಧಿ ತ್ವಾಂ ವಿನಯೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಸ ಪೂರ್ವ್ವಂ ತವಾನುಪಕಾರಕ ಆಸೀತ್ ಕಿನ್ತ್ವಿದಾನೀಂ ತವ ಮಮ ಚೋಪಕಾರೀ ಭವತಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ತಮೇವಾಹಂ ತವ ಸಮೀಪಂ ಪ್ರೇಷಯಾಮಿ, ಅತೋ ಮದೀಯಪ್ರಾಣಸ್ವರೂಪಃ ಸ ತ್ವಯಾನುಗೃಹ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಸುಸಂವಾದಸ್ಯ ಕೃತೇ ಶೃಙ್ಖಲಬದ್ಧೋಽಹಂ ಪರಿಚಾರಕಮಿವ ತಂ ಸ್ವಸನ್ನಿಧೌ ವರ್ತ್ತಯಿತುಮ್ ಐಚ್ಛಂ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಕಿನ್ತು ತವ ಸೌಜನ್ಯಂ ಯದ್ ಬಲೇನ ನ ಭೂತ್ವಾ ಸ್ವೇಚ್ಛಾಯಾಃ ಫಲಂ ಭವೇತ್ ತದರ್ಥಂ ತವ ಸಮ್ಮತಿಂ ವಿನಾ ಕಿಮಪಿ ಕರ್ತ್ತವ್ಯಂ ನಾಮನ್ಯೇ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಕೋ ಜಾನಾತಿ ಕ್ಷಣಕಾಲಾರ್ಥಂ ತ್ವತ್ತಸ್ತಸ್ಯ ವಿಚ್ಛೇದೋಽಭವದ್ ಏತಸ್ಯಾಯಮ್ ಅಭಿಪ್ರಾಯೋ ಯತ್ ತ್ವಮ್ ಅನನ್ತಕಾಲಾರ್ಥಂ ತಂ ಲಪ್ಸ್ಯಸೇ</para>
  <para style="p">
    <verse number="16" style="v"/>ಪುನ ರ್ದಾಸಮಿವ ಲಪ್ಸ್ಯಸೇ ತನ್ನಹಿ ಕಿನ್ತು ದಾಸಾತ್ ಶ್ರೇಷ್ಠಂ ಮಮ ಪ್ರಿಯಂ ತವ ಚ ಶಾರೀರಿಕಸಮ್ಬನ್ಧಾತ್ ಪ್ರಭುಸಮ್ಬನ್ಧಾಚ್ಚ ತತೋಽಧಿಕಂ ಪ್ರಿಯಂ ಭ್ರಾತರಮಿವ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಅತೋ ಹೇತೋ ರ್ಯದಿ ಮಾಂ ಸಹಭಾಗಿನಂ ಜಾನಾಸಿ ತರ್ಹಿ ಮಾಮಿವ ತಮನುಗೃಹಾಣ|</para>
  <para style="p">
    <verse number="18" style="v"/>ತೇನ ಯದಿ ತವ ಕಿಮಪ್ಯಪರಾದ್ಧಂ ತುಭ್ಯಂ ಕಿಮಪಿ ಧಾರ್ಯ್ಯತೇ ವಾ ತರ್ಹಿ ತತ್ ಮಮೇತಿ ವಿದಿತ್ವಾ ಗಣಯ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಅಹಂ ತತ್ ಪರಿಶೋತ್ಸ್ಯಾಮಿ, ಏತತ್ ಪೌಲೋಽಹಂ ಸ್ವಹಸ್ತೇನ ಲಿಖಾಮಿ, ಯತಸ್ತ್ವಂ ಸ್ವಪ್ರಾಣಾನ್ ಅಪಿ ಮಹ್ಯಂ ಧಾರಯಸಿ ತದ್ ವಕ್ತುಂ ನೇಚ್ಛಾಮಿ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಭೋ ಭ್ರಾತಃ, ಪ್ರಭೋಃ ಕೃತೇ ಮಮ ವಾಞ್ಛಾಂ ಪೂರಯ ಖ್ರೀಷ್ಟಸ್ಯ ಕೃತೇ ಮಮ ಪ್ರಾಣಾನ್ ಆಪ್ಯಾಯಯ|</para>
  <para style="p">
    <verse number="21" style="v"/>ತವಾಜ್ಞಾಗ್ರಾಹಿತ್ವೇ ವಿಶ್ವಸ್ಯ ಮಯಾ ಏತತ್ ಲಿಖ್ಯತೇ ಮಯಾ ಯದುಚ್ಯತೇ ತತೋಽಧಿಕಂ ತ್ವಯಾ ಕಾರಿಷ್ಯತ ಇತಿ ಜಾನಾಮಿ|</para>
  <para style="p">
    <verse number="22" style="v"/>ತತ್ಕರಣಸಮಯೇ ಮದರ್ಥಮಪಿ ವಾಸಗೃಹಂ ತ್ವಯಾ ಸಜ್ಜೀಕ್ರಿಯತಾಂ ಯತೋ ಯುಷ್ಮಾಕಂ ಪ್ರಾರ್ಥನಾನಾಂ ಫಲರೂಪೋ ವರ ಇವಾಹಂ ಯುಷ್ಮಭ್ಯಂ ದಾಯಿಷ್ಯೇ ಮಮೇತಿ ಪ್ರತ್ಯಾಶಾ ಜಾಯತೇ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಖ್ರೀಷ್ಟಸ್ಯ ಯೀಶಾಃ ಕೃತೇ ಮಯಾ ಸಹ ಬನ್ದಿರಿಪಾಫ್ರಾ</para>
  <para style="p">
    <verse number="24" style="v"/>ಮಮ ಸಹಕಾರಿಣೋ ಮಾರ್ಕ ಆರಿಷ್ಟಾರ್ಖೋ ದೀಮಾ ಲೂಕಶ್ಚ ತ್ವಾಂ ನಮಸ್ಕಾರಂ ವೇದಯನ್ತಿ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಅಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯಾನುಗ್ರಹೋ ಯುಷ್ಮಾಕಮ್ ಆತ್ಮನಾ ಸಹ ಭೂಯಾತ್| ಆಮೇನ್|</para>
</usx>
