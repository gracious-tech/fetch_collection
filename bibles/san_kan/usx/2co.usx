<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="2CO" style="id">Sanskrit Bible (NT) in Kannada Script (ಸತ್ಯವೇದಃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">2 Corinthians</para>
  <para style="toc1">೨ ಕರಿನ್ಥಿನಃ ಪತ್ರಂ</para>
  <para style="toc2">೨ ಕರಿನ್ಥಿನಃ</para>
  <para style="toc3">೨ ಕರಿನ್ಥಿನಃ</para>
  <para style="mt1">೨ ಕರಿನ್ಥಿನಃ ಪತ್ರಂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಈಶ್ವರಸ್ಯೇಚ್ಛಯಾ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಪ್ರೇರಿತಃ ಪೌಲಸ್ತಿಮಥಿರ್ಭ್ರಾತಾ ಚ ದ್ವಾವೇತೌ ಕರಿನ್ಥನಗರಸ್ಥಾಯೈ ಈಶ್ವರೀಯಸಮಿತಯ ಆಖಾಯಾದೇಶಸ್ಥೇಭ್ಯಃ ಸರ್ವ್ವೇಭ್ಯಃ ಪವಿತ್ರಲೋಕೇಭ್ಯಶ್ಚ ಪತ್ರಂ ಲಿಖತಃ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಅಸ್ಮಾಕಂ ತಾತಸ್ಯೇಶ್ವರಸ್ಯ ಪ್ರಭೋರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಚಾನುಗ್ರಹಃ ಶಾನ್ತಿಶ್ಚ ಯುಷ್ಮಾಸು ವರ್ತ್ತತಾಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಕೃಪಾಲುಃ ಪಿತಾ ಸರ್ವ್ವಸಾನ್ತ್ವನಾಕಾರೀಶ್ವರಶ್ಚ ಯೋಽಸ್ಮತ್ಪ್ರಭೋರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ತಾತ ಈಶ್ವರಃ ಸ ಧನ್ಯೋ ಭವತು|</para>
  <para style="p">
    <verse number="4" style="v"/>ಯತೋ ವಯಮ್ ಈಶ್ವರಾತ್ ಸಾನ್ತ್ವನಾಂ ಪ್ರಾಪ್ಯ ತಯಾ ಸಾನ್ತ್ವನಯಾ ಯತ್ ಸರ್ವ್ವವಿಧಕ್ಲಿಷ್ಟಾನ್ ಲೋಕಾನ್ ಸಾನ್ತ್ವಯಿತುಂ ಶಕ್ನುಯಾಮ ತದರ್ಥಂ ಸೋಽಸ್ಮಾಕಂ ಸರ್ವ್ವಕ್ಲೇಶಸಮಯೇಽಸ್ಮಾನ್ ಸಾನ್ತ್ವಯತಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯತಃ ಖ್ರೀಷ್ಟಸ್ಯ ಕ್ಲೇಶಾ ಯದ್ವದ್ ಬಾಹುಲ್ಯೇನಾಸ್ಮಾಸು ವರ್ತ್ತನ್ತೇ ತದ್ವದ್ ವಯಂ ಖ್ರೀಷ್ಟೇನ ಬಹುಸಾನ್ತ್ವನಾಢ್ಯಾ ಅಪಿ ಭವಾಮಃ|</para>
  <para style="p">
    <verse number="6" style="v"/>ವಯಂ ಯದಿ ಕ್ಲಿಶ್ಯಾಮಹೇ ತರ್ಹಿ ಯುಷ್ಮಾಕಂ ಸಾನ್ತ್ವನಾಪರಿತ್ರಾಣಯೋಃ ಕೃತೇ ಕ್ಲಿಶ್ಯಾಮಹೇ ಯತೋಽಸ್ಮಾಭಿ ರ್ಯಾದೃಶಾನಿ ದುಃಖಾನಿ ಸಹ್ಯನ್ತೇ ಯುಷ್ಮಾಕಂ ತಾದೃಶದುಃಖಾನಾಂ ಸಹನೇನ ತೌ ಸಾಧಯಿಷ್ಯೇತೇ ಇತ್ಯಸ್ಮಿನ್ ಯುಷ್ಮಾನಧಿ ಮಮ ದೃಢಾ ಪ್ರತ್ಯಾಶಾ ಭವತಿ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯದಿ ವಾ ವಯಂ ಸಾನ್ತ್ವನಾಂ ಲಭಾಮಹೇ ತರ್ಹಿ ಯುಷ್ಮಾಕಂ ಸಾನ್ತ್ವನಾಪರಿತ್ರಾಣಯೋಃ ಕೃತೇ ತಾಮಪಿ ಲಭಾಮಹೇ| ಯತೋ ಯೂಯಂ ಯಾದೃಗ್ ದುಃಖಾನಾಂ ಭಾಗಿನೋಽಭವತ ತಾದೃಕ್ ಸಾನ್ತ್ವನಾಯಾ ಅಪಿ ಭಾಗಿನೋ ಭವಿಷ್ಯಥೇತಿ ವಯಂ ಜಾನೀಮಃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಆಶಿಯಾದೇಶೇ ಯಃ ಕ್ಲೇಶೋಽಸ್ಮಾನ್ ಆಕ್ರಾಮ್ಯತ್ ತಂ ಯೂಯಂ ಯದ್ ಅನವಗತಾಸ್ತಿಷ್ಠತ ತನ್ಮಯಾ ಭದ್ರಂ ನ ಮನ್ಯತೇ| ತೇನಾತಿಶಕ್ತಿಕ್ಲೇಶೇನ ವಯಮತೀವ ಪೀಡಿತಾಸ್ತಸ್ಮಾತ್ ಜೀವನರಕ್ಷಣೇ ನಿರುಪಾಯಾ ಜಾತಾಶ್ಚ,</para>
  <para style="p">
    <verse number="9" style="v"/>ಅತೋ ವಯಂ ಸ್ವೇಷು ನ ವಿಶ್ವಸ್ಯ ಮೃತಲೋಕಾನಾಮ್ ಉತ್ಥಾಪಯಿತರೀಶ್ವರೇ ಯದ್ ವಿಶ್ವಾಸಂ ಕುರ್ಮ್ಮಸ್ತದರ್ಥಮ್ ಅಸ್ಮಾಭಿಃ ಪ್ರಾಣದಣ್ಡೋ ಭೋಕ್ತವ್ಯ ಇತಿ ಸ್ವಮನಸಿ ನಿಶ್ಚಿತಂ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಏತಾದೃಶಭಯಙ್ಕರಾತ್ ಮೃತ್ಯೋ ರ್ಯೋ ಽಸ್ಮಾನ್ ಅತ್ರಾಯತೇದಾನೀಮಪಿ ತ್ರಾಯತೇ ಸ ಇತಃ ಪರಮಪ್ಯಸ್ಮಾನ್ ತ್ರಾಸ್ಯತೇ ಽಸ್ಮಾಕಮ್ ಏತಾದೃಶೀ ಪ್ರತ್ಯಾಶಾ ವಿದ್ಯತೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಏತದರ್ಥಮಸ್ಮತ್ಕೃತೇ ಪ್ರಾರ್ಥನಯಾ ವಯಂ ಯುಷ್ಮಾಭಿರುಪಕರ್ತ್ತವ್ಯಾಸ್ತಥಾ ಕೃತೇ ಬಹುಭಿ ರ್ಯಾಚಿತೋ ಯೋಽನುಗ್ರಹೋಽಸ್ಮಾಸು ವರ್ತ್ತಿಷ್ಯತೇ ತತ್ಕೃತೇ ಬಹುಭಿರೀಶ್ವರಸ್ಯ ಧನ್ಯವಾದೋಽಪಿ ಕಾರಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಅಪರಞ್ಚ ಸಂಸಾರಮಧ್ಯೇ ವಿಶೇಷತೋ ಯುಷ್ಮನ್ಮಧ್ಯೇ ವಯಂ ಸಾಂಸಾರಿಕ್ಯಾ ಧಿಯಾ ನಹಿ ಕಿನ್ತ್ವೀಶ್ವರಸ್ಯಾನುಗ್ರಹೇಣಾಕುಟಿಲತಾಮ್ ಈಶ್ವರೀಯಸಾರಲ್ಯಞ್ಚಾಚರಿತವನ್ತೋಽತ್ರಾಸ್ಮಾಕಂ ಮನೋ ಯತ್ ಪ್ರಮಾಣಂ ದದಾತಿ ತೇನ ವಯಂ ಶ್ಲಾಘಾಮಹೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯುಷ್ಮಾಭಿ ರ್ಯದ್ ಯತ್ ಪಠ್ಯತೇ ಗೃಹ್ಯತೇ ಚ ತದನ್ಯತ್ ಕಿಮಪಿ ಯುಷ್ಮಭ್ಯಮ್ ಅಸ್ಮಾಭಿ ರ್ನ ಲಿಖ್ಯತೇ ತಚ್ಚಾನ್ತಂ ಯಾವದ್ ಯುಷ್ಮಾಭಿ ರ್ಗ್ರಹೀಷ್ಯತ ಇತ್ಯಸ್ಮಾಕಮ್ ಆಶಾ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯೂಯಮಿತಃ ಪೂರ್ವ್ವಮಪ್ಯಸ್ಮಾನ್ ಅಂಶತೋ ಗೃಹೀತವನ್ತಃ, ಯತಃ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ದಿನೇ ಯದ್ವದ್ ಯುಷ್ಮಾಸ್ವಸ್ಮಾಕಂ ಶ್ಲಾಘಾ ತದ್ವದ್ ಅಸ್ಮಾಸು ಯುಷ್ಮಾಕಮಪಿ ಶ್ಲಾಘಾ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅಪರಂ ಯೂಯಂ ಯದ್ ದ್ವಿತೀಯಂ ವರಂ ಲಭಧ್ವೇ ತದರ್ಥಮಿತಃ ಪೂರ್ವ್ವಂ ತಯಾ ಪ್ರತ್ಯಾಶಯಾ ಯುಷ್ಮತ್ಸಮೀಪಂ ಗಮಿಷ್ಯಾಮಿ</para>
  <para style="p">
    <verse number="16" style="v"/>ಯುಷ್ಮದ್ದೇಶೇನ ಮಾಕಿದನಿಯಾದೇಶಂ ವ್ರಜಿತ್ವಾ ಪುನಸ್ತಸ್ಮಾತ್ ಮಾಕಿದನಿಯಾದೇಶಾತ್ ಯುಷ್ಮತ್ಸಮೀಪಮ್ ಏತ್ಯ ಯುಷ್ಮಾಭಿ ರ್ಯಿಹೂದಾದೇಶಂ ಪ್ರೇಷಯಿಷ್ಯೇ ಚೇತಿ ಮಮ ವಾಞ್ಛಾಸೀತ್|</para>
  <para style="p">
    <verse number="17" style="v"/>ಏತಾದೃಶೀ ಮನ್ತ್ರಣಾ ಮಯಾ ಕಿಂ ಚಾಞ್ಚಲ್ಯೇನ ಕೃತಾ? ಯದ್ ಯದ್ ಅಹಂ ಮನ್ತ್ರಯೇ ತತ್ ಕಿಂ ವಿಷಯಿಲೋಕಇವ ಮನ್ತ್ರಯಾಣ ಆದೌ ಸ್ವೀಕೃತ್ಯ ಪಶ್ಚಾದ್ ಅಸ್ವೀಕುರ್ವ್ವೇ?</para>
  <para style="p">
    <verse number="18" style="v"/>ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಮಯಾ ಕಥಿತಾನಿ ವಾಕ್ಯಾನ್ಯಗ್ರೇ ಸ್ವೀಕೃತಾನಿ ಶೇಷೇಽಸ್ವೀಕೃತಾನಿ ನಾಭವನ್ ಏತೇನೇಶ್ವರಸ್ಯ ವಿಶ್ವಸ್ತತಾ ಪ್ರಕಾಶತೇ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಮಯಾ ಸಿಲ್ವಾನೇನ ತಿಮಥಿನಾ ಚೇಶ್ವರಸ್ಯ ಪುತ್ರೋ ಯೋ ಯೀಶುಖ್ರೀಷ್ಟೋ ಯುಷ್ಮನ್ಮಧ್ಯೇ ಘೋಷಿತಃ ಸ ತೇನ ಸ್ವೀಕೃತಃ ಪುನರಸ್ವೀಕೃತಶ್ಚ ತನ್ನಹಿ ಕಿನ್ತು ಸ ತಸ್ಯ ಸ್ವೀಕಾರಸ್ವರೂಪಏವ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಈಶ್ವರಸ್ಯ ಮಹಿಮಾ ಯದ್ ಅಸ್ಮಾಭಿಃ ಪ್ರಕಾಶೇತ ತದರ್ಥಮ್ ಈಶ್ವರೇಣ ಯದ್ ಯತ್ ಪ್ರತಿಜ್ಞಾತಂ ತತ್ಸರ್ವ್ವಂ ಖ್ರೀಷ್ಟೇನ ಸ್ವೀಕೃತಂ ಸತ್ಯೀಭೂತಞ್ಚ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಯುಷ್ಮಾನ್ ಅಸ್ಮಾಂಶ್ಚಾಭಿಷಿಚ್ಯ ಯಃ ಖ್ರೀಷ್ಟೇ ಸ್ಥಾಸ್ನೂನ್ ಕರೋತಿ ಸ ಈಶ್ವರ ಏವ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಸ ಚಾಸ್ಮಾನ್ ಮುದ್ರಾಙ್ಕಿತಾನ್ ಅಕಾರ್ಷೀತ್ ಸತ್ಯಾಙ್ಕಾರಸ್ಯ ಪಣಖರೂಪಮ್ ಆತ್ಮಾನಂ ಅಸ್ಮಾಕಮ್ ಅನ್ತಃಕರಣೇಷು ನಿರಕ್ಷಿಪಚ್ಚ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಅಪರಂ ಯುಷ್ಮಾಸು ಕರುಣಾಂ ಕುರ್ವ್ವನ್ ಅಹಮ್ ಏತಾವತ್ಕಾಲಂ ಯಾವತ್ ಕರಿನ್ಥನಗರಂ ನ ಗತವಾನ್ ಇತಿ ಸತ್ಯಮೇತಸ್ಮಿನ್ ಈಶ್ವರಂ ಸಾಕ್ಷಿಣಂ ಕೃತ್ವಾ ಮಯಾ ಸ್ವಪ್ರಾಣಾನಾಂ ಶಪಥಃ ಕ್ರಿಯತೇ|</para>
  <para style="p">
    <verse number="24" style="v"/>ವಯಂ ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸಸ್ಯ ನಿಯನ್ತಾರೋ ನ ಭವಾಮಃ ಕಿನ್ತು ಯುಷ್ಮಾಕಮ್ ಆನನ್ದಸ್ಯ ಸಹಾಯಾ ಭವಾಮಃ, ಯಸ್ಮಾದ್ ವಿಶ್ವಾಸೇ ಯುಷ್ಮಾಕಂ ಸ್ಥಿತಿ ರ್ಭವತಿ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅಪರಞ್ಚಾಹಂ ಪುನಃ ಶೋಕಾಯ ಯುಷ್ಮತ್ಸನ್ನಿಧಿಂ ನ ಗಮಿಷ್ಯಾಮೀತಿ ಮನಸಿ ನಿರಚೈಷಂ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯಸ್ಮಾದ್ ಅಹಂ ಯದಿ ಯುಷ್ಮಾನ್ ಶೋಕಯುಕ್ತಾನ್ ಕರೋಮಿ ತರ್ಹಿ ಮಯಾ ಯಃ ಶೋಕಯುಕ್ತೀಕೃತಸ್ತಂ ವಿನಾ ಕೇನಾಪರೇಣಾಹಂ ಹರ್ಷಯಿಷ್ಯೇ?</para>
  <para style="p">
    <verse number="3" style="v"/>ಮಮ ಯೋ ಹರ್ಷಃ ಸ ಯುಷ್ಮಾಕಂ ಸರ್ವ್ವೇಷಾಂ ಹರ್ಷ ಏವೇತಿ ನಿಶ್ಚಿತಂ ಮಯಾಬೋಧಿ; ಅತಏವ ಯೈರಹಂ ಹರ್ಷಯಿತವ್ಯಸ್ತೈ ರ್ಮದುಪಸ್ಥಿತಿಸಮಯೇ ಯನ್ಮಮ ಶೋಕೋ ನ ಜಾಯೇತ ತದರ್ಥಮೇವ ಯುಷ್ಮಭ್ಯಮ್ ಏತಾದೃಶಂ ಪತ್ರಂ ಮಯಾ ಲಿಖಿತಂ|</para>
  <para style="p">
    <verse number="4" style="v"/>ವಸ್ತುತಸ್ತು ಬಹುಕ್ಲೇಶಸ್ಯ ಮನಃಪೀಡಾಯಾಶ್ಚ ಸಮಯೇಽಹಂ ಬಹ್ವಶ್ರುಪಾತೇನ ಪತ್ರಮೇಕಂ ಲಿಖಿತವಾನ್ ಯುಷ್ಮಾಕಂ ಶೋಕಾರ್ಥಂ ತನ್ನಹಿ ಕಿನ್ತು ಯುಷ್ಮಾಸು ಮದೀಯಪ್ರೇಮಬಾಹುಲ್ಯಸ್ಯ ಜ್ಞಾಪನಾರ್ಥಂ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯೇನಾಹಂ ಶೋಕಯುಕ್ತೀಕೃತಸ್ತೇನ ಕೇವಲಮಹಂ ಶೋಕಯುಕ್ತೀಕೃತಸ್ತನ್ನಹಿ ಕಿನ್ತ್ವಂಶತೋ ಯೂಯಂ ಸರ್ವ್ವೇಽಪಿ ಯತೋಽಹಮತ್ರ ಕಸ್ಮಿಂಶ್ಚಿದ್ ದೋಷಮಾರೋಪಯಿತುಂ ನೇಚ್ಛಾಮಿ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಬಹೂನಾಂ ಯತ್ ತರ್ಜ್ಜನಂ ತೇನ ಜನೇನಾಲಮ್ಭಿ ತತ್ ತದರ್ಥಂ ಪ್ರಚುರಂ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅತಃ ಸ ದುಃಖಸಾಗರೇ ಯನ್ನ ನಿಮಜ್ಜತಿ ತದರ್ಥಂ ಯುಷ್ಮಾಭಿಃ ಸ ಕ್ಷನ್ತವ್ಯಃ ಸಾನ್ತ್ವಯಿತವ್ಯಶ್ಚ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಇತಿ ಹೇತೋಃ ಪ್ರರ್ಥಯೇಽಹಂ ಯುಷ್ಮಾಭಿಸ್ತಸ್ಮಿನ್ ದಯಾ ಕ್ರಿಯತಾಂ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಯೂಯಂ ಸರ್ವ್ವಕರ್ಮ್ಮಣಿ ಮಮಾದೇಶಂ ಗೃಹ್ಲೀಥ ನ ವೇತಿ ಪರೀಕ್ಷಿತುಮ್ ಅಹಂ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಲಿಖಿತವಾನ್|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯಸ್ಯ ಯೋ ದೋಷೋ ಯುಷ್ಮಾಭಿಃ ಕ್ಷಮ್ಯತೇ ತಸ್ಯ ಸ ದೋಷೋ ಮಯಾಪಿ ಕ್ಷಮ್ಯತೇ ಯಶ್ಚ ದೋಷೋ ಮಯಾ ಕ್ಷಮ್ಯತೇ ಸ ಯುಷ್ಮಾಕಂ ಕೃತೇ ಖ್ರೀಷ್ಟಸ್ಯ ಸಾಕ್ಷಾತ್ ಕ್ಷಮ್ಯತೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಶಯತಾನಃ ಕಲ್ಪನಾಸ್ಮಾಭಿರಜ್ಞಾತಾ ನಹಿ, ಅತೋ ವಯಂ ಯತ್ ತೇನ ನ ವಞ್ಚ್ಯಾಮಹೇ ತದರ್ಥಮ್ ಅಸ್ಮಾಭಿಃ ಸಾವಧಾನೈ ರ್ಭವಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಅಪರಞ್ಚ ಖ್ರೀಷ್ಟಸ್ಯ ಸುಸಂವಾದಘೋಷಣಾರ್ಥಂ ಮಯಿ ತ್ರೋಯಾನಗರಮಾಗತೇ ಪ್ರಭೋಃ ಕರ್ಮ್ಮಣೇ ಚ ಮದರ್ಥಂ ದ್ವಾರೇ ಮುಕ್ತೇ</para>
  <para style="p">
    <verse number="13" style="v"/>ಸತ್ಯಪಿ ಸ್ವಭ್ರಾತುಸ್ತೀತಸ್ಯಾವಿದ್ಯಮಾನತ್ವಾತ್ ಮದೀಯಾತ್ಮನಃ ಕಾಪಿ ಶಾನ್ತಿ ರ್ನ ಬಭೂವ, ತಸ್ಮಾದ್ ಅಹಂ ತಾನ್ ವಿಸರ್ಜ್ಜನಂ ಯಾಚಿತ್ವಾ ಮಾಕಿದನಿಯಾದೇಶಂ ಗನ್ತುಂ ಪ್ರಸ್ಥಾನಮ್ ಅಕರವಂ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯ ಈಶ್ವರಃ ಸರ್ವ್ವದಾ ಖ್ರೀಷ್ಟೇನಾಸ್ಮಾನ್ ಜಯಿನಃ ಕರೋತಿ ಸರ್ವ್ವತ್ರ ಚಾಸ್ಮಾಭಿಸ್ತದೀಯಜ್ಞಾನಸ್ಯ ಗನ್ಧಂ ಪ್ರಕಾಶಯತಿ ಸ ಧನ್ಯಃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಯಸ್ಮಾದ್ ಯೇ ತ್ರಾಣಂ ಲಪ್ಸ್ಯನ್ತೇ ಯೇ ಚ ವಿನಾಶಂ ಗಮಿಷ್ಯನ್ತಿ ತಾನ್ ಪ್ರತಿ ವಯಮ್ ಈಶ್ವರೇಣ ಖ್ರೀಷ್ಟಸ್ಯ ಸೌಗನ್ಧ್ಯಂ ಭವಾಮಃ|</para>
  <para style="p">
    <verse number="16" style="v"/>ವಯಮ್ ಏಕೇಷಾಂ ಮೃತ್ಯವೇ ಮೃತ್ಯುಗನ್ಧಾ ಅಪರೇಷಾಞ್ಚ ಜೀವನಾಯ ಜೀವನಗನ್ಧಾ ಭವಾಮಃ, ಕಿನ್ತ್ವೇತಾದೃಶಕರ್ಮ್ಮಸಾಧನೇ ಕಃ ಸಮರ್ಥೋಽಸ್ತಿ?</para>
  <para style="p">
    <verse number="17" style="v"/>ಅನ್ಯೇ ಬಹವೋ ಲೋಕಾ ಯದ್ವದ್ ಈಶ್ವರಸ್ಯ ವಾಕ್ಯಂ ಮೃಷಾಶಿಕ್ಷಯಾ ಮಿಶ್ರಯನ್ತಿ ವಯಂ ತದ್ವತ್ ತನ್ನ ಮಿಶ್ರಯನ್ತಃ ಸರಲಭಾವೇನೇಶ್ವರಸ್ಯ ಸಾಕ್ಷಾದ್ ಈಶ್ವರಸ್ಯಾದೇಶಾತ್ ಖ್ರೀಷ್ಟೇನ ಕಥಾಂ ಭಾಷಾಮಹೇ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ವಯಂ ಕಿಮ್ ಆತ್ಮಪ್ರಶಂಸನಂ ಪುನರಾರಭಾಮಹೇ? ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಯುಷ್ಮತ್ತೋ ವಾ ಪರೇಷಾಂ ಕೇಷಾಞ್ಚಿದ್ ಇವಾಸ್ಮಾಕಮಪಿ ಕಿಂ ಪ್ರಶಂಸಾಪತ್ರೇಷು ಪ್ರಯೋಜನಮ್ ಆಸ್ತೇ?</para>
  <para style="p">
    <verse number="2" style="v"/>ಯೂಯಮೇವಾಸ್ಮಾಕಂ ಪ್ರಶಂಸಾಪತ್ರಂ ತಚ್ಚಾಸ್ಮಾಕಮ್ ಅನ್ತಃಕರಣೇಷು ಲಿಖಿತಂ ಸರ್ವ್ವಮಾನವೈಶ್ಚ ಜ್ಞೇಯಂ ಪಠನೀಯಞ್ಚ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಯತೋ ಽಸ್ಮಾಭಿಃ ಸೇವಿತಂ ಖ್ರೀಷ್ಟಸ್ಯ ಪತ್ರಂ ಯೂಯಪೇವ, ತಚ್ಚ ನ ಮಸ್ಯಾ ಕಿನ್ತ್ವಮರಸ್ಯೇಶ್ವರಸ್ಯಾತ್ಮನಾ ಲಿಖಿತಂ ಪಾಷಾಣಪತ್ರೇಷು ತನ್ನಹಿ ಕಿನ್ತು ಕ್ರವ್ಯಮಯೇಷು ಹೃತ್ಪತ್ರೇಷು ಲಿಖಿತಮಿತಿ ಸುಸ್ಪಷ್ಟಂ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಖ್ರೀಷ್ಟೇನೇಶ್ವರಂ ಪ್ರತ್ಯಸ್ಮಾಕಮ್ ಈದೃಶೋ ದೃಢವಿಶ್ವಾಸೋ ವಿದ್ಯತೇ;</para>
  <para style="p">
    <verse number="5" style="v"/>ವಯಂ ನಿಜಗುಣೇನ ಕಿಮಪಿ ಕಲ್ಪಯಿತುಂ ಸಮರ್ಥಾ ಇತಿ ನಹಿ ಕಿನ್ತ್ವೀಶ್ವರಾದಸ್ಮಾಕಂ ಸಾಮರ್ಥ್ಯಂ ಜಾಯತೇ|</para>
  <para style="p">
    <verse number="6" style="v"/>ತೇನ ವಯಂ ನೂತನನಿಯಮಸ್ಯಾರ್ಥತೋ ಽಕ್ಷರಸಂಸ್ಥಾನಸ್ಯ ತನ್ನಹಿ ಕಿನ್ತ್ವಾತ್ಮನ ಏವ ಸೇವನಸಾಮರ್ಥ್ಯಂ ಪ್ರಾಪ್ತಾಃ| ಅಕ್ಷರಸಂಸ್ಥಾನಂ ಮೃತ್ಯುಜನಕಂ ಕಿನ್ತ್ವಾತ್ಮಾ ಜೀವನದಾಯಕಃ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅಕ್ಷರೈ ರ್ವಿಲಿಖಿತಪಾಷಾಣರೂಪಿಣೀ ಯಾ ಮೃತ್ಯೋಃ ಸೇವಾ ಸಾ ಯದೀದೃಕ್ ತೇಜಸ್ವಿನೀ ಜಾತಾ ಯತ್ತಸ್ಯಾಚಿರಸ್ಥಾಯಿನಸ್ತೇಜಸಃ ಕಾರಣಾತ್ ಮೂಸಸೋ ಮುಖಮ್ ಇಸ್ರಾಯೇಲೀಯಲೋಕೈಃ ಸಂದ್ರಷ್ಟುಂ ನಾಶಕ್ಯತ,</para>
  <para style="p">
    <verse number="8" style="v"/>ತರ್ಹ್ಯಾತ್ಮನಃ ಸೇವಾ ಕಿಂ ತತೋಽಪಿ ಬಹುತೇಜಸ್ವಿನೀ ನ ಭವೇತ್?</para>
  <para style="p">
    <verse number="9" style="v"/>ದಣ್ಡಜನಿಕಾ ಸೇವಾ ಯದಿ ತೇಜೋಯುಕ್ತಾ ಭವೇತ್ ತರ್ಹಿ ಪುಣ್ಯಜನಿಕಾ ಸೇವಾ ತತೋಽಧಿಕಂ ಬಹುತೇಜೋಯುಕ್ತಾ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಉಭಯೋಸ್ತುಲನಾಯಾಂ ಕೃತಾಯಾಮ್ ಏಕಸ್ಯಾಸ್ತೇಜೋ ದ್ವಿತೀಯಾಯಾಃ ಪ್ರಖರತರೇಣ ತೇಜಸಾ ಹೀನತೇಜೋ ಭವತಿ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಯಸ್ಮಾದ್ ಯತ್ ಲೋಪನೀಯಂ ತದ್ ಯದಿ ತೇಜೋಯುಕ್ತಂ ಭವೇತ್ ತರ್ಹಿ ಯತ್ ಚಿರಸ್ಥಾಯಿ ತದ್ ಬಹುತರತೇಜೋಯುಕ್ತಮೇವ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಈದೃಶೀಂ ಪ್ರತ್ಯಾಶಾಂ ಲಬ್ಧ್ವಾ ವಯಂ ಮಹತೀಂ ಪ್ರಗಲ್ಭತಾಂ ಪ್ರಕಾಶಯಾಮಃ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಇಸ್ರಾಯೇಲೀಯಲೋಕಾ ಯತ್ ತಸ್ಯ ಲೋಪನೀಯಸ್ಯ ತೇಜಸಃ ಶೇಷಂ ನ ವಿಲೋಕಯೇಯುಸ್ತದರ್ಥಂ ಮೂಸಾ ಯಾದೃಗ್ ಆವರಣೇನ ಸ್ವಮುಖಮ್ ಆಚ್ಛಾದಯತ್ ವಯಂ ತಾದೃಕ್ ನ ಕುರ್ಮ್ಮಃ|</para>
  <para style="p">
    <verse number="14" style="v"/>ತೇಷಾಂ ಮನಾಂಸಿ ಕಠಿನೀಭೂತಾನಿ ಯತಸ್ತೇಷಾಂ ಪಠನಸಮಯೇ ಸ ಪುರಾತನೋ ನಿಯಮಸ್ತೇನಾವರಣೇನಾದ್ಯಾಪಿ ಪ್ರಚ್ಛನ್ನಸ್ತಿಷ್ಠತಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತಚ್ಚ ನ ದೂರೀಭವತಿ ಯತಃ ಖ್ರೀಷ್ಟೇನೈವ ತತ್ ಲುಪ್ಯತೇ| ಮೂಸಸಃ ಶಾಸ್ತ್ರಸ್ಯ ಪಾಠಸಮಯೇಽದ್ಯಾಪಿ ತೇಷಾಂ ಮನಾಂಸಿ ತೇನಾವರಣೇನ ಪ್ರಚ್ಛಾದ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಕಿನ್ತು ಪ್ರಭುಂ ಪ್ರತಿ ಮನಸಿ ಪರಾವೃತ್ತೇ ತದ್ ಆವರಣಂ ದೂರೀಕಾರಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಯಃ ಪ್ರಭುಃ ಸ ಏವ ಸ ಆತ್ಮಾ ಯತ್ರ ಚ ಪ್ರಭೋರಾತ್ಮಾ ತತ್ರೈವ ಮುಕ್ತಿಃ|</para>
  <para style="p">
    <verse number="18" style="v"/>ವಯಞ್ಚ ಸರ್ವ್ವೇಽನಾಚ್ಛಾದಿತೇನಾಸ್ಯೇನ ಪ್ರಭೋಸ್ತೇಜಸಃ ಪ್ರತಿಬಿಮ್ಬಂ ಗೃಹ್ಲನ್ತ ಆತ್ಮಸ್ವರೂಪೇಣ ಪ್ರಭುನಾ ರೂಪಾನ್ತರೀಕೃತಾ ವರ್ದ್ಧಮಾನತೇಜೋಯುಕ್ತಾಂ ತಾಮೇವ ಪ್ರತಿಮೂರ್ತ್ತಿಂ ಪ್ರಾಪ್ನುಮಃ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅಪರಞ್ಚ ವಯಂ ಕರುಣಾಭಾಜೋ ಭೂತ್ವಾ ಯದ್ ಏತತ್ ಪರಿಚಾರಕಪದಮ್ ಅಲಭಾಮಹಿ ನಾತ್ರ ಕ್ಲಾಮ್ಯಾಮಃ,</para>
  <para style="p">
    <verse number="2" style="v"/>ಕಿನ್ತು ತ್ರಪಾಯುಕ್ತಾನಿ ಪ್ರಚ್ಛನ್ನಕರ್ಮ್ಮಾಣಿ ವಿಹಾಯ ಕುಟಿಲತಾಚರಣಮಕುರ್ವ್ವನ್ತ ಈಶ್ವರೀಯವಾಕ್ಯಂ ಮಿಥ್ಯಾವಾಕ್ಯೈರಮಿಶ್ರಯನ್ತಃ ಸತ್ಯಧರ್ಮ್ಮಸ್ಯ ಪ್ರಕಾಶನೇನೇಶ್ವರಸ್ಯ ಸಾಕ್ಷಾತ್ ಸರ್ವ್ವಮಾನವಾನಾಂ ಸಂವೇದಗೋಚರೇ ಸ್ವಾನ್ ಪ್ರಶಂಸನೀಯಾನ್ ದರ್ಶಯಾಮಃ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅಸ್ಮಾಭಿ ರ್ಘೋಷಿತಃ ಸುಸಂವಾದೋ ಯದಿ ಪ್ರಚ್ಛನ್ನಃ; ಸ್ಯಾತ್ ತರ್ಹಿ ಯೇ ವಿನಂಕ್ಷ್ಯನ್ತಿ ತೇಷಾಮೇವ ದೃಷ್ಟಿತಃ ಸ ಪ್ರಚ್ಛನ್ನಃ;</para>
  <para style="p">
    <verse number="4" style="v"/>ಯತ ಈಶ್ವರಸ್ಯ ಪ್ರತಿಮೂರ್ತ್ತಿ ರ್ಯಃ ಖ್ರೀಷ್ಟಸ್ತಸ್ಯ ತೇಜಸಃ ಸುಸಂವಾದಸ್ಯ ಪ್ರಭಾ ಯತ್ ತಾನ್ ನ ದೀಪಯೇತ್ ತದರ್ಥಮ್ ಇಹ ಲೋಕಸ್ಯ ದೇವೋಽವಿಶ್ವಾಸಿನಾಂ ಜ್ಞಾನನಯನಮ್ ಅನ್ಧೀಕೃತವಾನ್ ಏತಸ್ಯೋದಾಹರಣಂ ತೇ ಭವನ್ತಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ವಯಂ ಸ್ವಾನ್ ಘೋಷಯಾಮ ಇತಿ ನಹಿ ಕಿನ್ತು ಖ್ರೀಷ್ಟಂ ಯೀಶುಂ ಪ್ರಭುಮೇವಾಸ್ಮಾಂಶ್ಚ ಯೀಶೋಃ ಕೃತೇ ಯುಷ್ಮಾಕಂ ಪರಿಚಾರಕಾನ್ ಘೋಷಯಾಮಃ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಯ ಈಶ್ವರೋ ಮಧ್ಯೇತಿಮಿರಂ ಪ್ರಭಾಂ ದೀಪನಾಯಾದಿಶತ್ ಸ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯಾಸ್ಯ ಈಶ್ವರೀಯತೇಜಸೋ ಜ್ಞಾನಪ್ರಭಾಯಾ ಉದಯಾರ್ಥಮ್ ಅಸ್ಮಾಕಮ್ ಅನ್ತಃಕರಣೇಷು ದೀಪಿತವಾನ್|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅಪರಂ ತದ್ ಧನಮ್ ಅಸ್ಮಾಭಿ ರ್ಮೃಣ್ಮಯೇಷು ಭಾಜನೇಷು ಧಾರ್ಯ್ಯತೇ ಯತಃ ಸಾದ್ಭುತಾ ಶಕ್ತಿ ರ್ನಾಸ್ಮಾಕಂ ಕಿನ್ತ್ವೀಶ್ವರಸ್ಯೈವೇತಿ ಜ್ಞಾತವ್ಯಂ|</para>
  <para style="p">
    <verse number="8" style="v"/>ವಯಂ ಪದೇ ಪದೇ ಪೀಡ್ಯಾಮಹೇ ಕಿನ್ತು ನಾವಸೀದಾಮಃ, ವಯಂ ವ್ಯಾಕುಲಾಃ ಸನ್ತೋಽಪಿ ನಿರುಪಾಯಾ ನ ಭವಾಮಃ;</para>
  <para style="p">
    <verse number="9" style="v"/>ವಯಂ ಪ್ರದ್ರಾವ್ಯಮಾನಾ ಅಪಿ ನ ಕ್ಲಾಮ್ಯಾಮಃ, ನಿಪಾತಿತಾ ಅಪಿ ನ ವಿನಶ್ಯಾಮಃ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಅಸ್ಮಾಕಂ ಶರೀರೇ ಖ್ರೀಷ್ಟಸ್ಯ ಜೀವನಂ ಯತ್ ಪ್ರಕಾಶೇತ ತದರ್ಥಂ ತಸ್ಮಿನ್ ಶರೀರೇ ಯೀಶೋ ರ್ಮರಣಮಪಿ ಧಾರಯಾಮಃ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಯೀಶೋ ರ್ಜೀವನಂ ಯದ್ ಅಸ್ಮಾಕಂ ಮರ್ತ್ತ್ಯದೇಹೇ ಪ್ರಕಾಶೇತ ತದರ್ಥಂ ಜೀವನ್ತೋ ವಯಂ ಯೀಶೋಃ ಕೃತೇ ನಿತ್ಯಂ ಮೃತ್ಯೌ ಸಮರ್ಪ್ಯಾಮಹೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಇತ್ಥಂ ವಯಂ ಮೃತ್ಯಾಕ್ರಾನ್ತಾ ಯೂಯಞ್ಚ ಜೀವನಾಕ್ರಾನ್ತಾಃ|</para>
  <para style="p">
    <verse number="13" style="v"/>ವಿಶ್ವಾಸಕಾರಣಾದೇವ ಸಮಭಾಷಿ ಮಯಾ ವಚಃ| ಇತಿ ಯಥಾ ಶಾಸ್ತ್ರೇ ಲಿಖಿತಂ ತಥೈವಾಸ್ಮಾಭಿರಪಿ ವಿಶ್ವಾಸಜನಕಮ್ ಆತ್ಮಾನಂ ಪ್ರಾಪ್ಯ ವಿಶ್ವಾಸಃ ಕ್ರಿಯತೇ ತಸ್ಮಾಚ್ಚ ವಚಾಂಸಿ ಭಾಷ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಪ್ರಭು ರ್ಯೀಶು ರ್ಯೇನೋತ್ಥಾಪಿತಃ ಸ ಯೀಶುನಾಸ್ಮಾನಪ್ಯುತ್ಥಾಪಯಿಷ್ಯತಿ ಯುಷ್ಮಾಭಿಃ ಸಾರ್ದ್ಧಂ ಸ್ವಸಮೀಪ ಉಪಸ್ಥಾಪಯಿಷ್ಯತಿ ಚ, ವಯಮ್ ಏತತ್ ಜಾನೀಮಃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅತಏವ ಯುಷ್ಮಾಕಂ ಹಿತಾಯ ಸರ್ವ್ವಮೇವ ಭವತಿ ತಸ್ಮಾದ್ ಬಹೂನಾಂ ಪ್ರಚುರಾನುुಗ್ರಹಪ್ರಾಪ್ತೇ ರ್ಬಹುಲೋಕಾನಾಂ ಧನ್ಯವಾದೇನೇಶ್ವರಸ್ಯ ಮಹಿಮಾ ಸಮ್ಯಕ್ ಪ್ರಕಾಶಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="16" style="v"/>ತತೋ ಹೇತೋ ರ್ವಯಂ ನ ಕ್ಲಾಮ್ಯಾಮಃ ಕಿನ್ತು ಬಾಹ್ಯಪುರುಷೋ ಯದ್ಯಪಿ ಕ್ಷೀಯತೇ ತಥಾಪ್ಯಾನ್ತರಿಕಃ ಪುರುಷೋ ದಿನೇ ದಿನೇ ನೂತನಾಯತೇ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಕ್ಷಣಮಾತ್ರಸ್ಥಾಯಿ ಯದೇತತ್ ಲಘಿಷ್ಠಂ ದುಃಖಂ ತದ್ ಅತಿಬಾಹುಲ್ಯೇನಾಸ್ಮಾಕಮ್ ಅನನ್ತಕಾಲಸ್ಥಾಯಿ ಗರಿಷ್ಠಸುಖಂ ಸಾಧಯತಿ,</para>
  <para style="p">
    <verse number="18" style="v"/>ಯತೋ ವಯಂ ಪ್ರತ್ಯಕ್ಷಾನ್ ವಿಷಯಾನ್ ಅನುದ್ದಿಶ್ಯಾಪ್ರತ್ಯಕ್ಷಾನ್ ಉದ್ದಿಶಾಮಃ| ಯತೋ ಹೇತೋಃ ಪ್ರತ್ಯಕ್ಷವಿಷಯಾಃ ಕ್ಷಣಮಾತ್ರಸ್ಥಾಯಿನಃ ಕಿನ್ತ್ವಪ್ರತ್ಯಕ್ಷಾ ಅನನ್ತಕಾಲಸ್ಥಾಯಿನಃ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅಪರಮ್ ಅಸ್ಮಾಕಮ್ ಏತಸ್ಮಿನ್ ಪಾರ್ಥಿವೇ ದೂಷ್ಯರೂಪೇ ವೇಶ್ಮನಿ ಜೀರ್ಣೇ ಸತೀಶ್ವರೇಣ ನಿರ್ಮ್ಮಿತಮ್ ಅಕರಕೃತಮ್ ಅಸ್ಮಾಕಮ್ ಅನನ್ತಕಾಲಸ್ಥಾಯಿ ವೇಶ್ಮೈಕಂ ಸ್ವರ್ಗೇ ವಿದ್ಯತ ಇತಿ ವಯಂ ಜಾನೀಮಃ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯತೋ ಹೇತೋರೇತಸ್ಮಿನ್ ವೇಶ್ಮನಿ ತಿಷ್ಠನ್ತೋ ವಯಂ ತಂ ಸ್ವರ್ಗೀಯಂ ವಾಸಂ ಪರಿಧಾತುಮ್ ಆಕಾಙ್ಕ್ಷ್ಯಮಾಣಾ ನಿಃಶ್ವಸಾಮಃ|</para>
  <para style="p">
    <verse number="3" style="v"/>ತಥಾಪೀದಾನೀಮಪಿ ವಯಂ ತೇನ ನ ನಗ್ನಾಃ ಕಿನ್ತು ಪರಿಹಿತವಸನಾ ಮನ್ಯಾಮಹೇ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಏತಸ್ಮಿನ್ ದೂಷ್ಯೇ ತಿಷ್ಠನತೋ ವಯಂ ಕ್ಲಿಶ್ಯಮಾನಾ ನಿಃಶ್ವಸಾಮಃ, ಯತೋ ವಯಂ ವಾಸಂ ತ್ಯಕ್ತುಮ್ ಇಚ್ಛಾಮಸ್ತನ್ನಹಿ ಕಿನ್ತು ತಂ ದ್ವಿತೀಯಂ ವಾಸಂ ಪರಿಧಾತುಮ್ ಇಚ್ಛಾಮಃ, ಯತಸ್ತಥಾ ಕೃತೇ ಜೀವನೇನ ಮರ್ತ್ಯಂ ಗ್ರಸಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಏತದರ್ಥಂ ವಯಂ ಯೇನ ಸೃಷ್ಟಾಃ ಸ ಈಶ್ವರ ಏವ ಸ ಚಾಸ್ಮಭ್ಯಂ ಸತ್ಯಙ್ಕಾರಸ್ಯ ಪಣಸ್ವರೂಪಮ್ ಆತ್ಮಾನಂ ದತ್ತವಾನ್|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅತಏವ ವಯಂ ಸರ್ವ್ವದೋತ್ಸುಕಾ ಭವಾಮಃ ಕಿಞ್ಚ ಶರೀರೇ ಯಾವದ್ ಅಸ್ಮಾಭಿ ರ್ನ್ಯುಷ್ಯತೇ ತಾವತ್ ಪ್ರಭುತೋ ದೂರೇ ಪ್ರೋಷ್ಯತ ಇತಿ ಜಾನೀಮಃ,</para>
  <para style="p">
    <verse number="7" style="v"/>ಯತೋ ವಯಂ ದೃಷ್ಟಿಮಾರ್ಗೇ ನ ಚರಾಮಃ ಕಿನ್ತು ವಿಶ್ವಾಸಮಾರ್ಗೇ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಅಪರಞ್ಚ ಶರೀರಾದ್ ದೂರೇ ಪ್ರವಸ್ತುಂ ಪ್ರಭೋಃ ಸನ್ನಿಧೌ ನಿವಸ್ತುಞ್ಚಾಕಾಙ್ಕ್ಷ್ಯಮಾಣಾ ಉತ್ಸುಕಾ ಭವಾಮಃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ತಸ್ಮಾದೇವ ಕಾರಣಾದ್ ವಯಂ ತಸ್ಯ ಸನ್ನಿಧೌ ನಿವಸನ್ತಸ್ತಸ್ಮಾದ್ ದೂರೇ ಪ್ರವಸನ್ತೋ ವಾ ತಸ್ಮೈ ರೋಚಿತುಂ ಯತಾಮಹೇ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯಸ್ಮಾತ್ ಶರೀರಾವಸ್ಥಾಯಾಮ್ ಏಕೈಕೇನ ಕೃತಾನಾಂ ಕರ್ಮ್ಮಣಾಂ ಶುಭಾಶುಭಫಲಪ್ರಾಪ್ತಯೇ ಸರ್ವ್ವೈಸ್ಮಾಭಿಃ ಖ್ರೀಷ್ಟಸ್ಯ ವಿಚಾರಾಸನಸಮ್ಮುಖ ಉಪಸ್ಥಾತವ್ಯಂ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅತಏವ ಪ್ರಭೋ ರ್ಭಯಾನಕತ್ವಂ ವಿಜ್ಞಾಯ ವಯಂ ಮನುಜಾನ್ ಅನುನಯಾಮಃ ಕಿಞ್ಚೇಶ್ವರಸ್ಯ ಗೋಚರೇ ಸಪ್ರಕಾಶಾ ಭವಾಮಃ, ಯುಷ್ಮಾಕಂ ಸಂವೇದಗೋಚರೇಽಪಿ ಸಪ್ರಕಾಶಾ ಭವಾಮ ಇತ್ಯಾಶಂಸಾಮಹೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಅನೇನ ವಯಂ ಯುಷ್ಮಾಕಂ ಸನ್ನಿಧೌ ಪುನಃ ಸ್ವಾನ್ ಪ್ರಶಂಸಾಮ ಇತಿ ನಹಿ ಕಿನ್ತು ಯೇ ಮನೋ ವಿನಾ ಮುಖೈಃ ಶ್ಲಾಘನ್ತೇ ತೇಭ್ಯಃ ಪ್ರತ್ಯುತ್ತರದಾನಾಯ ಯೂಯಂ ಯಥಾಸ್ಮಾಭಿಃ ಶ್ಲಾಘಿತುಂ ಶಕ್ನುಥ ತಾದೃಶಮ್ ಉಪಾಯಂ ಯುಷ್ಮಭ್ಯಂ ವಿತರಾಮಃ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯದಿ ವಯಂ ಹತಜ್ಞಾನಾ ಭವಾಮಸ್ತರ್ಹಿ ತದ್ ಈಶ್ವರಾರ್ಥಕಂ ಯದಿ ಚ ಸಜ್ಞಾನಾ ಭವಾಮಸ್ತರ್ಹಿ ತದ್ ಯುಷ್ಮದರ್ಥಕಂ|</para>
  <para style="p">
    <verse number="14" style="v"/>ವಯಂ ಖ್ರೀಷ್ಟಸ್ಯ ಪ್ರೇಮ್ನಾ ಸಮಾಕೃಷ್ಯಾಮಹೇ ಯತಃ ಸರ್ವ್ವೇಷಾಂ ವಿನಿಮಯೇನ ಯದ್ಯೇಕೋ ಜನೋಽಮ್ರಿಯತ ತರ್ಹಿ ತೇ ಸರ್ವ್ವೇ ಮೃತಾ ಇತ್ಯಾಸ್ಮಾಭಿ ರ್ಬುಧ್ಯತೇ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅಪರಞ್ಚ ಯೇ ಜೀವನ್ತಿ ತೇ ಯತ್ ಸ್ವಾರ್ಥಂ ನ ಜೀವನ್ತಿ ಕಿನ್ತು ತೇಷಾಂ ಕೃತೇ ಯೋ ಜನೋ ಮೃತಃ ಪುನರುತ್ಥಾಪಿತಶ್ಚ ತಮುದ್ದಿಶ್ಯ ಯತ್ ಜೀವನ್ತಿ ತದರ್ಥಮೇವ ಸ ಸರ್ವ್ವೇಷಾಂ ಕೃತೇ ಮೃತವಾನ್|</para>
  <para style="p">
    <verse number="16" style="v"/>ಅತೋ ಹೇತೋರಿತಃ ಪರಂ ಕೋಽಪ್ಯಸ್ಮಾಭಿ ರ್ಜಾತಿತೋ ನ ಪ್ರತಿಜ್ಞಾತವ್ಯಃ| ಯದ್ಯಪಿ ಪೂರ್ವ್ವಂ ಖ್ರೀಷ್ಟೋ ಜಾತಿತೋಽಸ್ಮಾಭಿಃ ಪ್ರತಿಜ್ಞಾತಸ್ತಥಾಪೀದಾನೀಂ ಜಾತಿತಃ ಪುನ ರ್ನ ಪ್ರತಿಜ್ಞಾಯತೇ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಕೇನಚಿತ್ ಖ್ರೀಷ್ಟ ಆಶ್ರಿತೇ ನೂತನಾ ಸೃಷ್ಟಿ ರ್ಭವತಿ ಪುರಾತನಾನಿ ಲುಪ್ಯನ್ತೇ ಪಶ್ಯ ನಿಖಿಲಾನಿ ನವೀನಾನಿ ಭವನ್ತಿ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಸರ್ವ್ವಞ್ಚೈತದ್ ಈಶ್ವರಸ್ಯ ಕರ್ಮ್ಮ ಯತೋ ಯೀಶುಖ್ರೀಷ್ಟೇನ ಸ ಏವಾಸ್ಮಾನ್ ಸ್ವೇನ ಸಾರ್ದ್ಧಂ ಸಂಹಿತವಾನ್ ಸನ್ಧಾನಸಮ್ಬನ್ಧೀಯಾಂ ಪರಿಚರ್ಯ್ಯಾಮ್ ಅಸ್ಮಾಸು ಸಮರ್ಪಿತವಾಂಶ್ಚ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಯತಃ ಈಶ್ವರಃ ಖ್ರೀಷ್ಟಮ್ ಅಧಿಷ್ಠಾಯ ಜಗತೋ ಜನಾನಾಮ್ ಆಗಾಂಸಿ ತೇಷಾಮ್ ಋಣಮಿವ ನ ಗಣಯನ್ ಸ್ವೇನ ಸಾರ್ದ್ಧಂ ತಾನ್ ಸಂಹಿತವಾನ್ ಸನ್ಧಿವಾರ್ತ್ತಾಮ್ ಅಸ್ಮಾಸು ಸಮರ್ಪಿತವಾಂಶ್ಚ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಅತೋ ವಯಂ ಖ್ರೀಷ್ಟಸ್ಯ ವಿನಿಮಯೇನ ದೌತ್ಯಂ ಕರ್ಮ್ಮ ಸಮ್ಪಾದಯಾಮಹೇ, ಈಶ್ವರಶ್ಚಾಸ್ಮಾಭಿ ರ್ಯುಷ್ಮಾನ್ ಯಾಯಾಚ್ಯತೇ ತತಃ ಖ್ರೀಷ್ಟಸ್ಯ ವಿನಿಮಯೇನ ವಯಂ ಯುಷ್ಮಾನ್ ಪ್ರಾರ್ಥಯಾಮಹೇ ಯೂಯಮೀಶ್ವರೇಣ ಸನ್ಧತ್ತ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಯತೋ ವಯಂ ತೇನ ಯದ್ ಈಶ್ವರೀಯಪುಣ್ಯಂ ಭವಾಮಸ್ತದರ್ಥಂ ಪಾಪೇನ ಸಹ ಯಸ್ಯ ಜ್ಞಾತೇಯಂ ನಾಸೀತ್ ಸ ಏವ ತೇನಾಸ್ಮಾಕಂ ವಿನಿಮಯೇನ ಪಾಪಃ ಕೃತಃ|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ತಸ್ಯ ಸಹಾಯಾ ವಯಂ ಯುಷ್ಮಾನ್ ಪ್ರಾರ್ಥಯಾಮಹೇ, ಈಶ್ವರಸ್ಯಾನುಗ್ರಹೋ ಯುಷ್ಮಾಭಿ ರ್ವೃಥಾ ನ ಗೃಹ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತೇನೋಕ್ತಮೇತತ್, ಸಂಶ್ರೋಷ್ಯಾಮಿ ಶುಭೇ ಕಾಲೇ ತ್ವದೀಯಾಂ ಪ್ರಾರ್ಥನಾಮ್ ಅಹಂ| ಉಪಕಾರಂ ಕರಿಷ್ಯಾಮಿ ಪರಿತ್ರಾಣದಿನೇ ತವ| ಪಶ್ಯತಾಯಂ ಶುಭಕಾಲಃ ಪಶ್ಯತೇದಂ ತ್ರಾಣದಿನಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅಸ್ಮಾಕಂ ಪರಿಚರ್ಯ್ಯಾ ಯನ್ನಿಷ್ಕಲಙ್ಕಾ ಭವೇತ್ ತದರ್ಥಂ ವಯಂ ಕುತ್ರಾಪಿ ವಿಘ್ನಂ ನ ಜನಯಾಮಃ,</para>
  <para style="p">
    <verse number="4" style="v"/>ಕಿನ್ತು ಪ್ರಚುರಸಹಿಷ್ಣುತಾ ಕ್ಲೇಶೋ ದೈನ್ಯಂ ವಿಪತ್ ತಾಡನಾ ಕಾರಾಬನ್ಧನಂ ನಿವಾಸಹೀನತ್ವಂ ಪರಿಶ್ರಮೋ ಜಾಗರಣಮ್ ಉಪವಸನಂ</para>
  <para style="p">
    <verse number="5" style="v"/>ನಿರ್ಮ್ಮಲತ್ವಂ ಜ್ಞಾನಂ ಮೃದುಶೀಲತಾ ಹಿತೈಷಿತಾ</para>
  <para style="p">
    <verse number="6" style="v"/>ಪವಿತ್ರ ಆತ್ಮಾ ನಿಷ್ಕಪಟಂ ಪ್ರೇಮ ಸತ್ಯಾಲಾಪ ಈಶ್ವರೀಯಶಕ್ತಿ</para>
  <para style="p">
    <verse number="7" style="v"/>ರ್ದಕ್ಷಿಣವಾಮಾಭ್ಯಾಂ ಕರಾಭ್ಯಾಂ ಧರ್ಮ್ಮಾಸ್ತ್ರಧಾರಣಂ</para>
  <para style="p">
    <verse number="8" style="v"/>ಮಾನಾಪಮಾನಯೋರಖ್ಯಾತಿಸುಖ್ಯಾತ್ಯೋ ರ್ಭಾಗಿತ್ವಮ್ ಏತೈಃ ಸರ್ವ್ವೈರೀಶ್ವರಸ್ಯ ಪ್ರಶಂಸ್ಯಾನ್ ಪರಿಚಾರಕಾನ್ ಸ್ವಾನ್ ಪ್ರಕಾಶಯಾಮಃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಭ್ರಮಕಸಮಾ ವಯಂ ಸತ್ಯವಾದಿನೋ ಭವಾಮಃ, ಅಪರಿಚಿತಸಮಾ ವಯಂ ಸುಪರಿಚಿತಾ ಭವಾಮಃ, ಮೃತಕಲ್ಪಾ ವಯಂ ಜೀವಾಮಃ, ದಣ್ಡ್ಯಮಾನಾ ವಯಂ ನ ಹನ್ಯಾಮಹೇ,</para>
  <para style="p">
    <verse number="10" style="v"/>ಶೋಕಯುಕ್ತಾಶ್ಚ ವಯಂ ಸದಾನನ್ದಾಮಃ, ದರಿದ್ರಾ ವಯಂ ಬಹೂನ್ ಧನಿನಃ ಕುರ್ಮ್ಮಃ, ಅಕಿಞ್ಚನಾಶ್ಚ ವಯಂ ಸರ್ವ್ವಂ ಧಾರಯಾಮಃ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಹೇ ಕರಿನ್ಥಿನಃ, ಯುಷ್ಮಾಕಂ ಪ್ರತಿ ಮಮಾಸ್ಯಂ ಮುಕ್ತಂ ಮಮಾನ್ತಃಕರಣಾಞ್ಚ ವಿಕಸಿತಂ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯೂಯಂ ಮಮಾನ್ತರೇ ನ ಸಙ್ಕೋಚಿತಾಃ ಕಿಞ್ಚ ಯೂಯಮೇವ ಸಙ್ಕೋಚಿತಚಿತ್ತಾಃ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಕಿನ್ತು ಮಹ್ಯಂ ನ್ಯಾಯ್ಯಫಲದಾನಾರ್ಥಂ ಯುಷ್ಮಾಭಿರಪಿ ವಿಕಸಿತೈ ರ್ಭವಿತವ್ಯಮ್ ಇತ್ಯಹಂ ನಿಜಬಾಲಕಾನಿವ ಯುಷ್ಮಾನ್ ವದಾಮಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಅಪರಮ್ ಅಪ್ರತ್ಯಯಿಭಿಃ ಸಾರ್ದ್ಧಂ ಯೂಯಮ್ ಏಕಯುಗೇ ಬದ್ಧಾ ಮಾ ಭೂತ, ಯಸ್ಮಾದ್ ಧರ್ಮ್ಮಾಧರ್ಮ್ಮಯೋಃ ಕಃ ಸಮ್ಬನ್ಧೋಽಸ್ತಿ? ತಿಮಿರೇಣ ಸರ್ದ್ಧಂ ಪ್ರಭಾಯಾ ವಾ ಕಾ ತುಲನಾಸ್ತಿ?</para>
  <para style="p">
    <verse number="15" style="v"/>ಬಿಲೀಯಾಲದೇವೇನ ಸಾಕಂ ಖ್ರೀಷ್ಟಸ್ಯ ವಾ ಕಾ ಸನ್ಧಿಃ? ಅವಿಶ್ವಾಸಿನಾ ಸಾರ್ದ್ಧಂ ವಾ ವಿಶ್ವಾಸಿಲೋಕಸ್ಯಾಂಶಃ ಕಃ?</para>
  <para style="p">
    <verse number="16" style="v"/>ಈಶ್ವರಸ್ಯ ಮನ್ದಿರೇಣ ಸಹ ವಾ ದೇವಪ್ರತಿಮಾನಾಂ ಕಾ ತುಲನಾ? ಅಮರಸ್ಯೇಶ್ವರಸ್ಯ ಮನ್ದಿರಂ ಯೂಯಮೇವ| ಈಶ್ವರೇಣ ತದುಕ್ತಂ ಯಥಾ, ತೇಷಾಂ ಮಧ್ಯೇಽಹಂ ಸ್ವಾವಾಸಂ ನಿಧಾಸ್ಯಾಮಿ ತೇಷಾಂ ಮಧ್ಯೇ ಚ ಯಾತಾಯಾತಂ ಕುರ್ವ್ವನ್ ತೇಷಾಮ್ ಈಶ್ವರೋ ಭವಿಷ್ಯಾಮಿ ತೇ ಚ ಮಲ್ಲೋಕಾ ಭವಿಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಅತೋ ಹೇತೋಃ ಪರಮೇಶ್ವರಃ ಕಥಯತಿ ಯೂಯಂ ತೇಷಾಂ ಮಧ್ಯಾದ್ ಬಹಿರ್ಭೂಯ ಪೃಥಗ್ ಭವತ, ಕಿಮಪ್ಯಮೇಧ್ಯಂ ನ ಸ್ಪೃಶತ; ತೇನಾಹಂ ಯುಷ್ಮಾನ್ ಗ್ರಹೀಷ್ಯಾಮಿ,</para>
  <para style="p">
    <verse number="18" style="v"/>ಯುಷ್ಮಾಕಂ ಪಿತಾ ಭವಿಷ್ಯಾಮಿ ಚ, ಯೂಯಞ್ಚ ಮಮ ಕನ್ಯಾಪುತ್ರಾ ಭವಿಷ್ಯಥೇತಿ ಸರ್ವ್ವಶಕ್ತಿಮತಾ ಪರಮೇಶ್ವರೇಣೋಕ್ತಂ|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅತಏವ ಹೇ ಪ್ರಿಯತಮಾಃ, ಏತಾದೃಶೀಃ ಪ್ರತಿಜ್ಞಾಃ ಪ್ರಾಪ್ತೈರಸ್ಮಾಭಿಃ ಶರೀರಾತ್ಮನೋಃ ಸರ್ವ್ವಮಾಲಿನ್ಯಮ್ ಅಪಮೃಜ್ಯೇಶ್ವರಸ್ಯ ಭಕ್ತ್ಯಾ ಪವಿತ್ರಾಚಾರಃ ಸಾಧ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯೂಯಮ್ ಅಸ್ಮಾನ್ ಗೃಹ್ಲೀತ| ಅಸ್ಮಾಭಿಃ ಕಸ್ಯಾಪ್ಯನ್ಯಾಯೋ ನ ಕೃತಃ ಕೋಽಪಿ ನ ವಞ್ಚಿತಃ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಯುಷ್ಮಾನ್ ದೋಷಿಣಃ ಕರ್ತ್ತಮಹಂ ವಾಕ್ಯಮೇತದ್ ವದಾಮೀತಿ ನಹಿ ಯುಷ್ಮಾಭಿಃ ಸಹ ಜೀವನಾಯ ಮರಣಾಯ ವಾ ವಯಂ ಯುಷ್ಮಾನ್ ಸ್ವಾನ್ತಃಕರಣೈ ರ್ಧಾರಯಾಮ ಇತಿ ಪೂರ್ವ್ವಂ ಮಯೋಕ್ತಂ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಮಮ ಮಹೇತ್ಸಾಹೋ ಜಾಯತೇ ಯುಷ್ಮಾನ್ ಅಧ್ಯಹಂ ಬಹು ಶ್ಲಾಘೇ ಚ ತೇನ ಸರ್ವ್ವಕ್ಲೇಶಸಮಯೇಽಹಂ ಸಾನ್ತ್ವನಯಾ ಪೂರ್ಣೋ ಹರ್ಷೇಣ ಪ್ರಫುಲ್ಲಿತಶ್ಚ ಭವಾಮಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಅಸ್ಮಾಸು ಮಾಕಿದನಿಯಾದೇಶಮ್ ಆಗತೇಷ್ವಸ್ಮಾಕಂ ಶರೀರಸ್ಯ ಕಾಚಿದಪಿ ಶಾನ್ತಿ ರ್ನಾಭವತ್ ಕಿನ್ತು ಸರ್ವ್ವತೋ ಬಹಿ ರ್ವಿರೋಧೇನಾನ್ತಶ್ಚ ಭೀತ್ಯಾ ವಯಮ್ ಅಪೀಡ್ಯಾಮಹಿ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಕಿನ್ತು ನಮ್ರಾಣಾಂ ಸಾನ್ತ್ವಯಿತಾ ಯ ಈಶ್ವರಃ ಸ ತೀತಸ್ಯಾಗಮನೇನಾಸ್ಮಾನ್ ಅಸಾನ್ತ್ವಯತ್|</para>
  <para style="p">
    <verse number="7" style="v"/>ಕೇವಲಂ ತಸ್ಯಾಗಮನೇನ ತನ್ನಹಿ ಕಿನ್ತು ಯುಷ್ಮತ್ತೋ ಜಾತಯಾ ತಸ್ಯ ಸಾನ್ತ್ವನಯಾಪಿ, ಯತೋಽಸ್ಮಾಸು ಯುಷ್ಮಾಕಂ ಹಾರ್ದ್ದವಿಲಾಪಾಸಕ್ತತ್ವೇಷ್ವಸ್ಮಾಕಂ ಸಮೀಪೇ ವರ್ಣಿತೇಷು ಮಮ ಮಹಾನನ್ದೋ ಜಾತಃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಅಹಂ ಪತ್ರೇಣ ಯುಷ್ಮಾನ್ ಶೋಕಯುಕ್ತಾನ್ ಕೃತವಾನ್ ಇತ್ಯಸ್ಮಾದ್ ಅನ್ವತಪ್ಯೇ ಕಿನ್ತ್ವಧುನಾ ನಾನುತಪ್ಯೇ| ತೇನ ಪತ್ರೇಣ ಯೂಯಂ ಕ್ಷಣಮಾತ್ರಂ ಶೋಕಯುಕ್ತೀಭೂತಾ ಇತಿ ಮಯಾ ದೃಶ್ಯತೇ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಇತ್ಯಸ್ಮಿನ್ ಯುಷ್ಮಾಕಂ ಶೋಕೇನಾಹಂ ಹೃಷ್ಯಾಮಿ ತನ್ನಹಿ ಕಿನ್ತು ಮನಃಪರಿವರ್ತ್ತನಾಯ ಯುಷ್ಮಾಕಂ ಶೋಕೋಽಭವದ್ ಇತ್ಯನೇನ ಹೃಷ್ಯಾಮಿ ಯತೋಽಸ್ಮತ್ತೋ ಯುಷ್ಮಾಕಂ ಕಾಪಿ ಹಾನಿ ರ್ಯನ್ನ ಭವೇತ್ ತದರ್ಥಂ ಯುಷ್ಮಾಕಮ್ ಈಶ್ವರೀಯಃ ಶೋेಕೋ ಜಾತಃ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಸ ಈಶ್ವರೀಯಃ ಶೋಕಃ ಪರಿತ್ರಾಣಜನಕಂ ನಿರನುತಾಪಂ ಮನಃಪರಿವರ್ತ್ತನಂ ಸಾಧಯತಿ ಕಿನ್ತು ಸಾಂಸಾರಿಕಃ ಶೋಕೋ ಮೃತ್ಯುಂ ಸಾಧಯತಿ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಪಶ್ಯತ ತೇನೇಶ್ವರೀಯೇಣ ಶೋಕೇನ ಯುಷ್ಮಾಕಂ ಕಿಂ ನ ಸಾಧಿತಂ? ಯತ್ನೋ ದೋಷಪ್ರಕ್ಷಾಲನಮ್ ಅಸನ್ತುಷ್ಟತ್ವಂ ಹಾರ್ದ್ದಮ್ ಆಸಕ್ತತ್ವಂ ಫಲದಾನಞ್ಚೈತಾನಿ ಸರ್ವ್ವಾಣಿ| ತಸ್ಮಿನ್ ಕರ್ಮ್ಮಣಿ ಯೂಯಂ ನಿರ್ಮ್ಮಲಾ ಇತಿ ಪ್ರಮಾಣಂ ಸರ್ವ್ವೇಣ ಪ್ರಕಾರೇಣ ಯುಷ್ಮಾಭಿ ರ್ದತ್ತಂ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯೇನಾಪರಾದ್ಧಂ ತಸ್ಯ ಕೃತೇ ಕಿಂವಾ ಯಸ್ಯಾಪರಾದ್ಧಂ ತಸ್ಯ ಕೃತೇ ಮಯಾ ಪತ್ರಮ್ ಅಲೇಖಿ ತನ್ನಹಿ ಕಿನ್ತು ಯುಷ್ಮಾನಧ್ಯಸ್ಮಾಕಂ ಯತ್ನೋ ಯದ್ ಈಶ್ವರಸ್ಯ ಸಾಕ್ಷಾದ್ ಯುಷ್ಮತ್ಸಮೀಪೇ ಪ್ರಕಾಶೇತ ತದರ್ಥಮೇವ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಉಕ್ತಕಾರಣಾದ್ ವಯಂ ಸಾನ್ತ್ವನಾಂ ಪ್ರಾಪ್ತಾಃ; ತಾಞ್ಚ ಸಾನ್ತ್ವನಾಂ ವಿನಾವರೋ ಮಹಾಹ್ಲಾದಸ್ತೀತಸ್ಯಾಹ್ಲಾದಾದಸ್ಮಾಭಿ ರ್ಲಬ್ಧಃ, ಯತಸ್ತಸ್ಯಾತ್ಮಾ ಸರ್ವ್ವೈ ರ್ಯುಷ್ಮಾಭಿಸ್ತೃಪ್ತಃ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಪೂರ್ವ್ವಂ ತಸ್ಯ ಸಮೀಪೇಽಹಂ ಯುಷ್ಮಾಭಿರ್ಯದ್ ಅಶ್ಲಾಘೇ ತೇನ ನಾಲಜ್ಜೇ ಕಿನ್ತು ವಯಂ ಯದ್ವದ್ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಸತ್ಯಭಾವೇನ ಸಕಲಮ್ ಅಭಾಷಾಮಹಿ ತದ್ವತ್ ತೀತಸ್ಯ ಸಮೀಪೇಽಸ್ಮಾಕಂ ಶ್ಲಾಘನಮಪಿ ಸತ್ಯಂ ಜಾತಂ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಯೂಯಂ ಕೀದೃಕ್ ತಸ್ಯಾಜ್ಞಾ ಅಪಾಲಯತ ಭಯಕಮ್ಪಾಭ್ಯಾಂ ತಂ ಗೃಹೀತವನ್ತಶ್ಚೈತಸ್ಯ ಸ್ಮರಣಾದ್ ಯುಷ್ಮಾಸು ತಸ್ಯ ಸ್ನೇಹೋ ಬಾಹುಲ್ಯೇನ ವರ್ತ್ತತೇ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯುಷ್ಮಾಸ್ವಹಂ ಸರ್ವ್ವಮಾಶಂಸೇ, ಇತ್ಯಸ್ಮಿನ್ ಮಮಾಹ್ಲಾದೋ ಜಾಯತೇ|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಮಾಕಿದನಿಯಾದೇಶಸ್ಥಾಸು ಸಮಿತಿಷು ಪ್ರಕಾಶಿತೋ ಯ ಈಶ್ವರಸ್ಯಾನುಗ್ರಹಸ್ತಮಹಂ ಯುಷ್ಮಾನ್ ಜ್ಞಾಪಯಾಮಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ವಸ್ತುತೋ ಬಹುಕ್ಲೇಶಪರೀಕ್ಷಾಸಮಯೇ ತೇಷಾಂ ಮಹಾನನ್ದೋಽತೀವದೀನತಾ ಚ ವದಾನ್ಯತಾಯಾಃ ಪ್ರಚುರಫಲಮ್ ಅಫಲಯತಾಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ತೇ ಸ್ವೇಚ್ಛಯಾ ಯಥಾಶಕ್ತಿ ಕಿಞ್ಚಾತಿಶಕ್ತಿ ದಾನ ಉದ್ಯುಕ್ತಾ ಅಭವನ್ ಇತಿ ಮಯಾ ಪ್ರಮಾಣೀಕ್ರಿಯತೇ|</para>
  <para style="p">
    <verse number="4" style="v"/>ವಯಞ್ಚ ಯತ್ ಪವಿತ್ರಲೋಕೇಭ್ಯಸ್ತೇಷಾಂ ದಾನಮ್ ಉಪಕಾರಾರ್ಥಕಮ್ ಅಂಶನಞ್ಚ ಗೃಹ್ಲಾಮಸ್ತದ್ ಬಹುನುನಯೇನಾಸ್ಮಾನ್ ಪ್ರಾರ್ಥಿತವನ್ತಃ|</para>
  <para style="p">
    <verse number="5" style="v"/>ವಯಂ ಯಾದೃಕ್ ಪ್ರತ್ಯೈ಼ಕ್ಷಾಮಹಿ ತಾದೃಗ್ ಅಕೃತ್ವಾ ತೇಽಗ್ರೇ ಪ್ರಭವೇ ತತಃ ಪರಮ್ ಈಶ್ವರಸ್ಯೇಚ್ಛಯಾಸ್ಮಭ್ಯಮಪಿ ಸ್ವಾನ್ ನ್ಯವೇದಯನ್|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅತೋ ಹೇತೋಸ್ತ್ವಂ ಯಥಾರಬ್ಧವಾನ್ ತಥೈವ ಕರಿನ್ಥಿನಾಂ ಮಧ್ಯೇಽಪಿ ತದ್ ದಾನಗ್ರಹಣಂ ಸಾಧಯೇತಿ ಯುಷ್ಮಾನ್ ಅಧಿ ವಯಂ ತೀತಂ ಪ್ರಾರ್ಥಯಾಮಹಿ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅತೋ ವಿಶ್ವಾಸೋ ವಾಕ್ಪಟುತಾ ಜ್ಞಾನಂ ಸರ್ವ್ವೋತ್ಸಾಹೋ ಽಸ್ಮಾಸು ಪ್ರೇಮ ಚೈತೈ ರ್ಗುಣೈ ರ್ಯೂಯಂ ಯಥಾಪರಾನ್ ಅತಿಶೇಧ್ವೇ ತಥೈವೈತೇನ ಗುಣೇನಾಪ್ಯತಿಶೇಧ್ವಂ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಏತದ್ ಅಹಮ್ ಆಜ್ಞಯಾ ಕಥಯಾಮೀತಿ ನಹಿ ಕಿನ್ತ್ವನ್ಯೇಷಾಮ್ ಉತ್ಸಾಹಕಾರಣಾದ್ ಯುಷ್ಮಾಕಮಪಿ ಪ್ರೇಮ್ನಃ ಸಾರಲ್ಯಂ ಪರೀಕ್ಷಿತುಮಿಚ್ಛತಾ ಮಯೈತತ್ ಕಥ್ಯತೇ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಯೂಯಞ್ಚಾಸ್ಮತ್ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯಾನುಗ್ರಹಂ ಜಾನೀಥ ಯತಸ್ತಸ್ಯ ನಿರ್ಧನತ್ವೇನ ಯೂಯಂ ಯದ್ ಧನಿನೋ ಭವಥ ತದರ್ಥಂ ಸ ಧನೀ ಸನ್ನಪಿ ಯುಷ್ಮತ್ಕೃತೇ ನಿರ್ಧನೋಽಭವತ್|</para>
  <para style="p">
    <verse number="10" style="v"/>ಏತಸ್ಮಿನ್ ಅಹಂ ಯುಷ್ಮಾನ್ ಸ್ವವಿಚಾರಂ ಜ್ಞಾಪಯಾಮಿ| ಗತಂ ಸಂವತ್ಸರಮ್ ಆರಭ್ಯ ಯೂಯಂ ಕೇವಲಂ ಕರ್ಮ್ಮ ಕರ್ತ್ತಂ ತನ್ನಹಿ ಕಿನ್ತ್ವಿಚ್ಛುಕತಾಂ ಪ್ರಕಾಶಯಿತುಮಪ್ಯುಪಾಕ್ರಾಭ್ಯಧ್ವಂ ತತೋ ಹೇತೋ ರ್ಯುಷ್ಮತ್ಕೃತೇ ಮಮ ಮನ್ತ್ರಣಾ ಭದ್ರಾ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅತೋ ಽಧುನಾ ತತ್ಕರ್ಮ್ಮಸಾಧನಂ ಯುಷ್ಮಾಭಿಃ ಕ್ರಿಯತಾಂ ತೇನ ಯದ್ವದ್ ಇಚ್ಛುಕತಾಯಾಮ್ ಉತ್ಸಾಹಸ್ತದ್ವದ್ ಏಕೈಕಸ್ಯ ಸಮ್ಪದನುಸಾರೇಣ ಕರ್ಮ್ಮಸಾಧನಮ್ ಅಪಿ ಜನಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯಸ್ಮಿನ್ ಇಚ್ಛುಕತಾ ವಿದ್ಯತೇ ತೇನ ಯನ್ನ ಧಾರ್ಯ್ಯತೇ ತಸ್ಮಾತ್ ಸೋಽನುಗೃಹ್ಯತ ಇತಿ ನಹಿ ಕಿನ್ತು ಯದ್ ಧಾರ್ಯ್ಯತೇ ತಸ್ಮಾದೇವ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯತ ಇತರೇಷಾಂ ವಿರಾಮೇಣ ಯುಷ್ಮಾಕಞ್ಚ ಕ್ಲೇಶೇನ ಭವಿತವ್ಯಂ ತನ್ನಹಿ ಕಿನ್ತು ಸಮತಯೈವ|</para>
  <para style="p">
    <verse number="14" style="v"/>ವರ್ತ್ತಮಾನಸಮಯೇ ಯುಷ್ಮಾಕಂ ಧನಾಧಿಕ್ಯೇನ ತೇಷಾಂ ಧನನ್ಯೂನತಾ ಪೂರಯಿತವ್ಯಾ ತಸ್ಮಾತ್ ತೇಷಾಮಪ್ಯಾಧಿಕ್ಯೇನ ಯುಷ್ಮಾಕಂ ನ್ಯೂನತಾ ಪೂರಯಿಷ್ಯತೇ ತೇನ ಸಮತಾ ಜನಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತದೇವ ಶಾಸ್ತ್ರೇಽಪಿ ಲಿಖಿತಮ್ ಆಸ್ತೇ ಯಥಾ, ಯೇನಾಧಿಕಂ ಸಂಗೃಹೀತಂ ತಸ್ಯಾಧಿಕಂ ನಾಭವತ್ ಯೇನ ಚಾಲ್ಪಂ ಸಂಗೃಹೀತಂ ತಸ್ಯಾಲ್ಪಂ ನಾಭವತ್|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯುಷ್ಮಾಕಂ ಹಿತಾಯ ತೀತಸ್ಯ ಮನಸಿ ಯ ಈಶ್ವರ ಇಮಮ್ ಉದ್ಯೋಗಂ ಜನಿತವಾನ್ ಸ ಧನ್ಯೋ ಭವತು|</para>
  <para style="p">
    <verse number="17" style="v"/>ತೀತೋಽಸ್ಮಾಕಂ ಪ್ರಾರ್ಥನಾಂ ಗೃಹೀತವಾನ್ ಕಿಞ್ಚ ಸ್ವಯಮ್ ಉದ್ಯುಕ್ತಃ ಸನ್ ಸ್ವೇಚ್ಛಯಾ ಯುಷ್ಮತ್ಸಮೀಪಂ ಗತವಾನ್|</para>
  <para style="p">
    <verse number="18" style="v"/>ತೇನ ಸಹ ಯೋಽಪರ ಏಕೋ ಭ್ರಾತಾಸ್ಮಾಭಿಃ ಪ್ರೇಷಿತಃ ಸುಸಂವಾದಾತ್ ತಸ್ಯ ಸುಖ್ಯಾತ್ಯಾ ಸರ್ವ್ವಾಃ ಸಮಿತಯೋ ವ್ಯಾಪ್ತಾಃ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಪ್ರಭೋ ರ್ಗೌರವಾಯ ಯುಷ್ಮಾಕಮ್ ಇಚ್ಛುಕತಾಯೈ ಚ ಸ ಸಮಿತಿಭಿರೇತಸ್ಯೈ ದಾನಸೇವಾಯೈ ಅಸ್ಮಾಕಂ ಸಙ್ಗಿತ್ವೇ ನ್ಯಯೋಜ್ಯತ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಯತೋ ಯಾ ಮಹೋಪಾಯನಸೇವಾಸ್ಮಾಭಿ ರ್ವಿಧೀಯತೇ ತಾಮಧಿ ವಯಂ ಯತ್ ಕೇನಾಪಿ ನ ನಿನ್ದ್ಯಾಮಹೇ ತದರ್ಥಂ ಯತಾಮಹೇ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಯತಃ ಕೇವಲಂ ಪ್ರಭೋಃ ಸಾಕ್ಷಾತ್ ತನ್ನಹಿ ಕಿನ್ತು ಮಾನವಾನಾಮಪಿ ಸಾಕ್ಷಾತ್ ಸದಾಚಾರಂ ಕರ್ತ್ತುಮ್ ಆಲೋಚಾಮಹೇ|</para>
  <para style="p">
    <verse number="22" style="v"/>ತಾಭ್ಯಾಂ ಸಹಾಪರ ಏಕೋ ಯೋ ಭ್ರಾತಾಸ್ಮಾಭಿಃ ಪ್ರೇಷಿತಃ ಸೋಽಸ್ಮಾಭಿ ರ್ಬಹುವಿಷಯೇಷು ಬಹವಾರಾನ್ ಪರೀಕ್ಷಿತ ಉದ್ಯೋಗೀವ ಪ್ರಕಾಶಿತಶ್ಚ ಕಿನ್ತ್ವಧುನಾ ಯುಷ್ಮಾಸು ದೃಢವಿಶ್ವಾಸಾತ್ ತಸ್ಯೋತ್ಸಾಹೋ ಬಹು ವವೃಧೇ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಯದಿ ಕಶ್ಚಿತ್ ತೀತಸ್ಯ ತತ್ತ್ವಂ ಜಿಜ್ಞಾಸತೇ ತರ್ಹಿ ಸ ಮಮ ಸಹಭಾಗೀ ಯುಷ್ಮನ್ಮಧ್ಯೇ ಸಹಕಾರೀ ಚ, ಅಪರಯೋ ರ್ಭ್ರಾತ್ರೋಸ್ತತ್ತ್ವಂ ವಾ ಯದಿ ಜಿಜ್ಞಾಸತೇ ತರ್ಹಿ ತೌ ಸಮಿತೀನಾಂ ದೂತೌ ಖ್ರೀಷ್ಟಸ್ಯ ಪ್ರತಿಬಿಮ್ಬೌ ಚೇತಿ ತೇನ ಜ್ಞಾಯತಾಂ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಅತೋ ಹೇತೋಃ ಸಮಿತೀನಾಂ ಸಮಕ್ಷಂ ಯುಷ್ಮತ್ಪ್ರೇಮ್ನೋಽಸ್ಮಾಕಂ ಶ್ಲಾಘಾಯಾಶ್ಚ ಪ್ರಾಮಾಣ್ಯಂ ತಾನ್ ಪ್ರತಿ ಯುಷ್ಮಾಭಿಃ ಪ್ರಕಾಶಯಿತವ್ಯಂ|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಪವಿತ್ರಲೋಕಾನಾಮ್ ಉಪಕಾರಾರ್ಥಕಸೇವಾಮಧಿ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಮಮ ಲಿಖನಂ ನಿಷ್ಪ್ರಯೋಜನಂ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯತ ಆಖಾಯಾದೇಶಸ್ಥಾ ಲೋಕಾ ಗತವರ್ಷಮ್ ಆರಭ್ಯ ತತ್ಕಾರ್ಯ್ಯ ಉದ್ಯತಾಃ ಸನ್ತೀತಿ ವಾಕ್ಯೇನಾಹಂ ಮಾಕಿದನೀಯಲೋಕಾನಾಂ ಸಮೀಪೇ ಯುಷ್ಮಾಕಂ ಯಾಮ್ ಇಚ್ಛುಕತಾಮಧಿ ಶ್ಲಾಘೇ ತಾಮ್ ಅವಗತೋಽಸ್ಮಿ ಯುಷ್ಮಾಕಂ ತಸ್ಮಾದ್ ಉತ್ಸಾಹಾಚ್ಚಾಪರೇಷಾಂ ಬಹೂನಾಮ್ ಉದ್ಯೋಗೋ ಜಾತಃ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಕಿಞ್ಚೈತಸ್ಮಿನ್ ಯುಷ್ಮಾನ್ ಅಧ್ಯಸ್ಮಾಕಂ ಶ್ಲಾಘಾ ಯದ್ ಅತಥ್ಯಾ ನ ಭವೇತ್ ಯೂಯಞ್ಚ ಮಮ ವಾಕ್ಯಾನುಸಾರಾದ್ ಯದ್ ಉದ್ಯತಾಸ್ತಿಷ್ಠೇತ ತದರ್ಥಮೇವ ತೇ ಭ್ರಾತರೋ ಮಯಾ ಪ್ರೇಷಿತಾಃ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಯಸ್ಮಾತ್ ಮಯಾ ಸಾರ್ದ್ಧಂ ಕೈಶ್ಚಿತ್ ಮಾಕಿದನೀಯಭ್ರಾತೃಭಿರಾಗತ್ಯ ಯೂಯಮನುದ್ಯತಾ ಇತಿ ಯದಿ ದೃಶ್ಯತೇ ತರ್ಹಿ ತಸ್ಮಾದ್ ದೃಢವಿಶ್ವಾಸಾದ್ ಯುಷ್ಮಾಕಂ ಲಜ್ಜಾ ಜನಿಷ್ಯತ ಇತ್ಯಸ್ಮಾಭಿ ರ್ನ ವಕ್ತವ್ಯಂ ಕಿನ್ತ್ವಸ್ಮಾಕಮೇವ ಲಜ್ಜಾ ಜನಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಅತಃ ಪ್ರಾಕ್ ಪ್ರತಿಜ್ಞಾತಂ ಯುಷ್ಮಾಕಂ ದಾನಂ ಯತ್ ಸಞ್ಚಿತಂ ಭವೇತ್ ತಚ್ಚ ಯದ್ ಗ್ರಾಹಕತಾಯಾಃ ಫಲಮ್ ಅಭೂತ್ವಾ ದಾನಶೀಲತಾಯಾ ಏವ ಫಲಂ ಭವೇತ್ ತದರ್ಥಂ ಮಮಾಗ್ರೇ ಗಮನಾಯ ತತ್ಸಞ್ಚಯನಾಯ ಚ ತಾನ್ ಭ್ರಾತೃನ್ ಆದೇಷ್ಟುಮಹಂ ಪ್ರಯೋಜನಮ್ ಅಮನ್ಯೇ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅಪರಮಪಿ ವ್ಯಾಹರಾಮಿ ಕೇನಚಿತ್ ಕ್ಷುದ್ರಭಾವೇನ ಬೀಜೇಷೂಪ್ತೇಷು ಸ್ವಲ್ಪಾನಿ ಶಸ್ಯಾನಿ ಕರ್ತ್ತಿಷ್ಯನ್ತೇ, ಕಿಞ್ಚ ಕೇನಚಿದ್ ಬಹುದಭವೇನ ಬೀಜೇಷೂಪ್ತೇಷು ಬಹೂನಿ ಶಸ್ಯಾನಿ ಕರ್ತ್ತಿಷ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಏಕೈಕೇನ ಸ್ವಮನಸಿ ಯಥಾ ನಿಶ್ಚೀಯತೇ ತಥೈವ ದೀಯತಾಂ ಕೇನಾಪಿ ಕಾತರೇಣ ಭೀತೇನ ವಾ ನ ದೀಯತಾಂ ಯತ ಈಶ್ವರೋ ಹೃಷ್ಟಮಾನಸೇ ದಾತರಿ ಪ್ರೀಯತೇ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಅಪರಮ್ ಈಶ್ವರೋ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಸರ್ವ್ವವಿಧಂ ಬಹುಪ್ರದಂ ಪ್ರಸಾದಂ ಪ್ರಕಾಶಯಿತುಮ್ ಅರ್ಹತಿ ತೇನ ಯೂಯಂ ಸರ್ವ್ವವಿಷಯೇ ಯಥೇಷ್ಟಂ ಪ್ರಾಪ್ಯ ಸರ್ವ್ವೇಣ ಸತ್ಕರ್ಮ್ಮಣಾ ಬಹುಫಲವನ್ತೋ ಭವಿಷ್ಯಥ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಏತಸ್ಮಿನ್ ಲಿಖಿತಮಾಸ್ತೇ, ಯಥಾ, ವ್ಯಯತೇ ಸ ಜನೋ ರಾಯಂ ದುರ್ಗತೇಭ್ಯೋ ದದಾತಿ ಚ| ನಿತ್ಯಸ್ಥಾಯೀ ಚ ತದ್ಧರ್ಮ್ಮಃ</para>
  <para style="p">
    <verse number="10" style="v"/>ಬೀಜಂ ಭೇಜನೀಯಮ್ ಅನ್ನಞ್ಚ ವಪ್ತ್ರೇ ಯೇನ ವಿಶ್ರಾಣ್ಯತೇ ಸ ಯುಷ್ಮಭ್ಯಮ್ ಅಪಿ ಬೀಜಂ ವಿಶ್ರಾಣ್ಯ ಬಹುಲೀಕರಿಷ್ಯತಿ ಯುಷ್ಮಾಕಂ ಧರ್ಮ್ಮಫಲಾನಿ ವರ್ದ್ಧಯಿಷ್ಯತಿ ಚ|</para>
  <para style="p">
    <verse number="11" style="v"/>ತೇನ ಸರ್ವ್ವವಿಷಯೇ ಸಧನೀಭೂತೈ ರ್ಯುಷ್ಮಾಭಿಃ ಸರ್ವ್ವವಿಷಯೇ ದಾನಶೀಲತಾಯಾಂ ಪ್ರಕಾಶಿತಾಯಾಮ್ ಅಸ್ಮಾಭಿರೀಶ್ವರಸ್ಯ ಧನ್ಯವಾದಃ ಸಾಧಯಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಏತಯೋಪಕಾರಸೇವಯಾ ಪವಿತ್ರಲೋಕಾನಾಮ್ ಅರ್ಥಾಭಾವಸ್ಯ ಪ್ರತೀಕಾರೋ ಜಾಯತ ಇತಿ ಕೇವಲಂ ನಹಿ ಕಿನ್ತ್ವೀಶ್ಚರಸ್ಯ ಧನ್ಯವಾದೋಽಪಿ ಬಾಹುಲ್ಯೇನೋತ್ಪಾದ್ಯತೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯತ ಏತಸ್ಮಾದ್ ಉಪಕಾರಕರಣಾದ್ ಯುಷ್ಮಾಕಂ ಪರೀಕ್ಷಿತತ್ವಂ ಬುದ್ಧ್ವಾ ಬಹುಭಿಃ ಖ್ರೀಷ್ಟಸುಸಂವಾದಾಙ್ಗೀಕರಣೇ ಯುಷ್ಮಾಕಮ್ ಆಜ್ಞಾಗ್ರಾಹಿತ್ವಾತ್ ತದ್ಭಾಗಿತ್ವೇ ಚ ತಾನ್ ಅಪರಾಂಶ್ಚ ಪ್ರತಿ ಯುಷ್ಮಾಕಂ ದಾತೃತ್ವಾದ್ ಈಶ್ವರಸ್ಯ ಧನ್ಯವಾದಃ ಕಾರಿಷ್ಯತೇ,</para>
  <para style="p">
    <verse number="14" style="v"/>ಯುಷ್ಮದರ್ಥಂ ಪ್ರಾರ್ಥನಾಂ ಕೃತ್ವಾ ಚ ಯುಷ್ಮಾಸ್ವೀಶ್ವರಸ್ಯ ಗರಿಷ್ಠಾನುಗ್ರಹಾದ್ ಯುಷ್ಮಾಸು ತೈಃ ಪ್ರೇಮ ಕಾರಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅಪರಮ್ ಈಶ್ವರಸ್ಯಾನಿರ್ವ್ವಚನೀಯದಾನಾತ್ ಸ ಧನ್ಯೋ ಭೂಯಾತ್|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಯುಷ್ಮತ್ಪ್ರತ್ಯಕ್ಷೇ ನಮ್ರಃ ಕಿನ್ತು ಪರೋಕ್ಷೇ ಪ್ರಗಲ್ಭಃ ಪೌಲೋಽಹಂ ಖ್ರೀಷ್ಟಸ್ಯ ಕ್ಷಾನ್ತ್ಯಾ ವಿನೀತ್ಯಾ ಚ ಯುಷ್ಮಾನ್ ಪ್ರಾರ್ಥಯೇ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಮಮ ಪ್ರಾರ್ಥನೀಯಮಿದಂ ವಯಂ ಯೈಃ ಶಾರೀರಿಕಾಚಾರಿಣೋ ಮನ್ಯಾಮಹೇ ತಾನ್ ಪ್ರತಿ ಯಾಂ ಪ್ರಗಲ್ಭತಾಂ ಪ್ರಕಾಶಯಿತುಂ ನಿಶ್ಚಿನೋಮಿ ಸಾ ಪ್ರಗಲ್ಭತಾ ಸಮಾಗತೇನ ಮಯಾಚರಿತವ್ಯಾ ನ ಭವತು|</para>
  <para style="p">
    <verse number="3" style="v"/>ಯತಃ ಶರೀರೇ ಚರನ್ತೋಽಪಿ ವಯಂ ಶಾರೀರಿಕಂ ಯುದ್ಧಂ ನ ಕುರ್ಮ್ಮಃ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಅಸ್ಮಾಕಂ ಯುದ್ಧಾಸ್ತ್ರಾಣಿ ಚ ನ ಶಾರೀರಿಕಾನಿ ಕಿನ್ತ್ವೀಶ್ವರೇಣ ದುರ್ಗಭಞ್ಜನಾಯ ಪ್ರಬಲಾನಿ ಭವನ್ತಿ,</para>
  <para style="p">
    <verse number="5" style="v"/>ತೈಶ್ಚ ವಯಂ ವಿತರ್ಕಾನ್ ಈಶ್ವರೀಯತತ್ತ್ವಜ್ಞಾನಸ್ಯ ಪ್ರತಿಬನ್ಧಿಕಾಂ ಸರ್ವ್ವಾಂ ಚಿತ್ತಸಮುನ್ನತಿಞ್ಚ ನಿಪಾತಯಾಮಃ ಸರ್ವ್ವಸಙ್ಕಲ್ಪಞ್ಚ ಬನ್ದಿನಂ ಕೃತ್ವಾ ಖ್ರೀಷ್ಟಸ್ಯಾಜ್ಞಾಗ್ರಾಹಿಣಂ ಕುರ್ಮ್ಮಃ,</para>
  <para style="p">
    <verse number="6" style="v"/>ಯುಷ್ಮಾಕಮ್ ಆಜ್ಞಾಗ್ರಾಹಿತ್ವೇ ಸಿದ್ಧೇ ಸತಿ ಸರ್ವ್ವಸ್ಯಾಜ್ಞಾಲಙ್ಘನಸ್ಯ ಪ್ರತೀಕಾರಂ ಕರ್ತ್ತುಮ್ ಉದ್ಯತಾ ಆಸ್ಮಹೇ ಚ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯದ್ ದೃಷ್ಟಿಗೋಚರಂ ತದ್ ಯುಷ್ಮಾಭಿ ರ್ದೃಶ್ಯತಾಂ| ಅಹಂ ಖ್ರೀಷ್ಟಸ್ಯ ಲೋಕ ಇತಿ ಸ್ವಮನಸಿ ಯೇನ ವಿಜ್ಞಾಯತೇ ಸ ಯಥಾ ಖ್ರೀಷ್ಟಸ್ಯ ಭವತಿ ವಯಮ್ ಅಪಿ ತಥಾ ಖ್ರೀಷ್ಟಸ್ಯ ಭವಾಮ ಇತಿ ಪುನರ್ವಿವಿಚ್ಯ ತೇನ ಬುಧ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಯುಷ್ಮಾಕಂ ನಿಪಾತಾಯ ತನ್ನಹಿ ಕಿನ್ತು ನಿಷ್ಠಾಯೈ ಪ್ರಭುನಾ ದತ್ತಂ ಯದಸ್ಮಾಕಂ ಸಾಮರ್ಥ್ಯಂ ತೇನ ಯದ್ಯಪಿ ಕಿಞ್ಚಿದ್ ಅಧಿಕಂ ಶ್ಲಾಘೇ ತಥಾಪಿ ತಸ್ಮಾನ್ನ ತ್ರಪಿಷ್ಯೇ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಅಹಂ ಪತ್ರೈ ರ್ಯುಷ್ಮಾನ್ ತ್ರಾಸಯಾಮಿ ಯುಷ್ಮಾಭಿರೇತನ್ನ ಮನ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="10" style="v"/>ತಸ್ಯ ಪತ್ರಾಣಿ ಗುರುತರಾಣಿ ಪ್ರಬಲಾನಿ ಚ ಭವನ್ತಿ ಕಿನ್ತು ತಸ್ಯ ಶಾರೀರಸಾಕ್ಷಾತ್ಕಾರೋ ದುರ್ಬ್ಬಲ ಆಲಾಪಶ್ಚ ತುಚ್ಛನೀಯ ಇತಿ ಕೈಶ್ಚಿದ್ ಉಚ್ಯತೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಕಿನ್ತು ಪರೋಕ್ಷೇ ಪತ್ರೈ ರ್ಭಾಷಮಾಣಾ ವಯಂ ಯಾದೃಶಾಃ ಪ್ರಕಾಶಾಮಹೇ ಪ್ರತ್ಯಕ್ಷೇ ಕರ್ಮ್ಮ ಕುರ್ವ್ವನ್ತೋಽಪಿ ತಾದೃಶಾ ಏವ ಪ್ರಕಾಶಿಷ್ಯಾಮಹೇ ತತ್ ತಾದೃಶೇನ ವಾಚಾಲೇನ ಜ್ಞಾಯತಾಂ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಸ್ವಪ್ರಶಂಸಕಾನಾಂ ಕೇಷಾಞ್ಚಿನ್ಮಧ್ಯೇ ಸ್ವಾನ್ ಗಣಯಿತುಂ ತೈಃ ಸ್ವಾನ್ ಉಪಮಾತುಂ ವಾ ವಯಂ ಪ್ರಗಲ್ಭಾ ನ ಭವಾಮಃ, ಯತಸ್ತೇ ಸ್ವಪರಿಮಾಣೇನ ಸ್ವಾನ್ ಪರಿಮಿಮತೇ ಸ್ವೈಶ್ಚ ಸ್ವಾನ್ ಉಪಮಿಭತೇ ತಸ್ಮಾತ್ ನಿರ್ಬ್ಬೋಧಾ ಭವನ್ತಿ ಚ|</para>
  <para style="p">
    <verse number="13" style="v"/>ವಯಮ್ ಅಪರಿಮಿತೇನ ನ ಶ್ಲಾಘಿಷ್ಯಾಮಹೇ ಕಿನ್ತ್ವೀಶ್ವರೇಣ ಸ್ವರಜ್ಜ್ವಾ ಯುಷ್ಮದ್ದೇಶಗಾಮಿ ಯತ್ ಪರಿಮಾಣಮ್ ಅಸ್ಮದರ್ಥಂ ನಿರೂಪಿತಂ ತೇನೈವ ಶ್ಲಾಘಿಷ್ಯಾಮಹೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯುಷ್ಮಾಕಂ ದೇಶೋಽಸ್ಮಾಭಿರಗನ್ತವ್ಯಸ್ತಸ್ಮಾದ್ ವಯಂ ಸ್ವಸೀಮಾಮ್ ಉಲ್ಲಙ್ಘಾಮಹೇ ತನ್ನಹಿ ಯತಃ ಖ್ರೀಷ್ಟಸ್ಯ ಸುಸಂವಾದೇನಾಪರೇಷಾಂ ಪ್ರಾಗ್ ವಯಮೇವ ಯುಷ್ಮಾನ್ ಪ್ರಾಪ್ತವನ್ತಃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ವಯಂ ಸ್ವಸೀಮಾಮ್ ಉಲ್ಲಙ್ಘ್ಯ ಪರಕ್ಷೇತ್ರೇಣ ಶ್ಲಾಘಾಮಹೇ ತನ್ನಹಿ, ಕಿಞ್ಚ ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸೇ ವೃದ್ಧಿಂ ಗತೇ ಯುಷ್ಮದ್ದೇಶೇಽಸ್ಮಾಕಂ ಸೀಮಾ ಯುಷ್ಮಾಭಿರ್ದೀರ್ಘಂ ವಿಸ್ತಾರಯಿಷ್ಯತೇ,</para>
  <para style="p">
    <verse number="16" style="v"/>ತೇನ ವಯಂ ಯುಷ್ಮಾಕಂ ಪಶ್ಚಿಮದಿಕ್ಸ್ಥೇಷು ಸ್ಥಾನೇಷು ಸುಸಂವಾದಂ ಘೋಷಯಿಷ್ಯಾಮಃ, ಇತ್ಥಂ ಪರಸೀಮಾಯಾಂ ಪರೇಣ ಯತ್ ಪರಿಷ್ಕೃತಂ ತೇನ ನ ಶ್ಲಾಘಿಷ್ಯಾಮಹೇ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಯಃ ಕಶ್ಚಿತ್ ಶ್ಲಾಘಮಾನಃ ಸ್ಯಾತ್ ಶ್ಲಾಘತಾಂ ಪ್ರಭುನಾ ಸ ಹಿ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಸ್ವೇನ ಯಃ ಪ್ರಶಂಸ್ಯತೇ ಸ ಪರೀಕ್ಷಿತೋ ನಹಿ ಕಿನ್ತು ಪ್ರಭುನಾ ಯಃ ಪ್ರಶಂಸ್ಯತೇ ಸ ಏವ ಪರೀಕ್ಷಿತಃ|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಯೂಯಂ ಮಮಾಜ್ಞಾನತಾಂ ಕ್ಷಣಂ ಯಾವತ್ ಸೋಢುಮ್ ಅರ್ಹಥ, ಅತಃ ಸಾ ಯುಷ್ಮಾಭಿಃ ಸಹ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಈಶ್ವರೇ ಮಮಾಸಕ್ತತ್ವಾದ್ ಅಹಂ ಯುಷ್ಮಾನಧಿ ತಪೇ ಯಸ್ಮಾತ್ ಸತೀಂ ಕನ್ಯಾಮಿವ ಯುಷ್ಮಾನ್ ಏಕಸ್ಮಿನ್ ವರೇಽರ್ಥತಃ ಖ್ರೀಷ್ಟೇ ಸಮರ್ಪಯಿತುಮ್ ಅಹಂ ವಾಗ್ದಾನಮ್ ಅಕಾರ್ಷಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಕಿನ್ತು ಸರ್ಪೇಣ ಸ್ವಖಲತಯಾ ಯದ್ವದ್ ಹವಾ ವಞ್ಚಯಾಞ್ಚಕೇ ತದ್ವತ್ ಖ್ರೀಷ್ಟಂ ಪ್ರತಿ ಸತೀತ್ವಾದ್ ಯುಷ್ಮಾಕಂ ಭ್ರಂಶಃ ಸಮ್ಭವಿಷ್ಯತೀತಿ ಬಿಭೇಮಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಅಸ್ಮಾಭಿರನಾಖ್ಯಾಪಿತೋಽಪರಃ ಕಶ್ಚಿದ್ ಯೀಶು ರ್ಯದಿ ಕೇನಚಿದ್ ಆಗನ್ತುಕೇನಾಖ್ಯಾಪ್ಯತೇ ಯುಷ್ಮಾಭಿಃ ಪ್ರಾಗಲಬ್ಧ ಆತ್ಮಾ ವಾ ಯದಿ ಲಭ್ಯತೇ ಪ್ರಾಗಗೃಹೀತಃ ಸುಸಂವಾದೋ ವಾ ಯದಿ ಗೃಹ್ಯತೇ ತರ್ಹಿ ಮನ್ಯೇ ಯೂಯಂ ಸಮ್ಯಕ್ ಸಹಿಷ್ಯಧ್ವೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಕಿನ್ತು ಮುಖ್ಯೇಭ್ಯಃ ಪ್ರೇರಿತೇಭ್ಯೋಽಹಂ ಕೇನಚಿತ್ ಪ್ರಕಾರೇಣ ನ್ಯೂನೋ ನಾಸ್ಮೀತಿ ಬುಧ್ಯೇ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಮಮ ವಾಕ್ಪಟುತಾಯಾ ನ್ಯೂನತ್ವೇ ಸತ್ಯಪಿ ಜ್ಞಾನಸ್ಯ ನ್ಯೂನತ್ವಂ ನಾಸ್ತಿ ಕಿನ್ತು ಸರ್ವ್ವವಿಷಯೇ ವಯಂ ಯುಷ್ಮದ್ಗೋಚರೇ ಪ್ರಕಾಶಾಮಹೇ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯುಷ್ಮಾಕಮ್ ಉನ್ನತ್ಯೈ ಮಯಾ ನಮ್ರತಾಂ ಸ್ವೀಕೃತ್ಯೇಶ್ವರಸ್ಯ ಸುಸಂವಾದೋ ವಿನಾ ವೇತನಂ ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ಯದ್ ಅಘೋಷ್ಯತ ತೇನ ಮಯಾ ಕಿಂ ಪಾಪಮ್ ಅಕಾರಿ?</para>
  <para style="p">
    <verse number="8" style="v"/>ಯುಷ್ಮಾಕಂ ಸೇವನಾಯಾಹಮ್ ಅನ್ಯಸಮಿತಿಭ್ಯೋ ಭೃತಿ ಗೃಹ್ಲನ್ ಧನಮಪಹೃತವಾನ್,</para>
  <para style="p">
    <verse number="9" style="v"/>ಯದಾ ಚ ಯುಷ್ಮನ್ಮಧ್ಯೇಽವಽರ್ತ್ತೇ ತದಾ ಮಮಾರ್ಥಾಭಾವೇ ಜಾತೇ ಯುಷ್ಮಾಕಂ ಕೋಽಪಿ ಮಯಾ ನ ಪೀಡಿತಃ; ಯತೋ ಮಮ ಸೋಽರ್ಥಾಭಾವೋ ಮಾಕಿದನಿಯಾದೇಶಾದ್ ಆಗತೈ ಭ್ರಾತೃಭಿ ನ್ಯವಾರ್ಯ್ಯತ, ಇತ್ಥಮಹಂ ಕ್ಕಾಪಿ ವಿಷಯೇ ಯಥಾ ಯುಷ್ಮಾಸು ಭಾರೋ ನ ಭವಾಮಿ ತಥಾ ಮಯಾತ್ಮರಕ್ಷಾ ಕೃತಾ ಕರ್ತ್ತವ್ಯಾ ಚ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಖ್ರೀಷ್ಟಸ್ಯ ಸತ್ಯತಾ ಯದಿ ಮಯಿ ತಿಷ್ಠತಿ ತರ್ಹಿ ಮಮೈಷಾ ಶ್ಲಾಘಾ ನಿಖಿಲಾಖಾಯಾದೇಶೇ ಕೇನಾಪಿ ನ ರೋತ್ಸ್ಯತೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಏತಸ್ಯ ಕಾರಣಂ ಕಿಂ? ಯುಷ್ಮಾಸು ಮಮ ಪ್ರೇಮ ನಾಸ್ತ್ಯೇತತ್ ಕಿಂ ತತ್ಕಾರಣಂ? ತದ್ ಈಶ್ವರೋ ವೇತ್ತಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯೇ ಛಿದ್ರಮನ್ವಿಷ್ಯನ್ತಿ ತೇ ಯತ್ ಕಿಮಪಿ ಛಿದ್ರಂ ನ ಲಭನ್ತೇ ತದರ್ಥಮೇವ ತತ್ ಕರ್ಮ್ಮ ಮಯಾ ಕ್ರಿಯತೇ ಕಾರಿಷ್ಯತೇ ಚ ತಸ್ಮಾತ್ ತೇ ಯೇನ ಶ್ಲಾಘನ್ತೇ ತೇನಾಸ್ಮಾಕಂ ಸಮಾನಾ ಭವಿಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ತಾದೃಶಾ ಭಾಕ್ತಪ್ರೇರಿತಾಃ ಪ್ರವಞ್ಚಕಾಃ ಕಾರವೋ ಭೂತ್ವಾ ಖ್ರೀಷ್ಟಸ್ಯ ಪ್ರೇರಿತಾನಾಂ ವೇಶಂ ಧಾರಯನ್ತಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ತಚ್ಚಾಶ್ಚರ್ಯ್ಯಂ ನಹಿ; ಯತಃ ಸ್ವಯಂ ಶಯತಾನಪಿ ತೇಜಸ್ವಿದೂತಸ್ಯ ವೇಶಂ ಧಾರಯತಿ,</para>
  <para style="p">
    <verse number="15" style="v"/>ತತಸ್ತಸ್ಯ ಪರಿಚಾರಕಾ ಅಪಿ ಧರ್ಮ್ಮಪರಿಚಾರಕಾಣಾಂ ವೇಶಂ ಧಾರಯನ್ತೀತ್ಯದ್ಭುತಂ ನಹಿ; ಕಿನ್ತು ತೇಷಾಂ ಕರ್ಮ್ಮಾಣಿ ಯಾದೃಶಾನಿ ಫಲಾನ್ಯಪಿ ತಾದೃಶಾನಿ ಭವಿಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಅಹಂ ಪುನ ರ್ವದಾಮಿ ಕೋಽಪಿ ಮಾಂ ನಿರ್ಬ್ಬೋಧಂ ನ ಮನ್ಯತಾಂ ಕಿಞ್ಚ ಯದ್ಯಪಿ ನಿರ್ಬ್ಬೋಧೋ ಭವೇಯಂ ತಥಾಪಿ ಯೂಯಂ ನಿರ್ಬ್ಬೋಧಮಿವ ಮಾಮನುಗೃಹ್ಯ ಕ್ಷಣೈಕಂ ಯಾವತ್ ಮಮಾತ್ಮಶ್ಲಾಘಾಮ್ ಅನುಜಾನೀತ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಏತಸ್ಯಾಃ ಶ್ಲಾಘಾಯಾ ನಿಮಿತ್ತಂ ಮಯಾ ಯತ್ ಕಥಿತವ್ಯಂ ತತ್ ಪ್ರಭುನಾದಿಷ್ಟೇನೇವ ಕಥ್ಯತೇ ತನ್ನಹಿ ಕಿನ್ತು ನಿರ್ಬ್ಬೋಧೇನೇವ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಅಪರೇ ಬಹವಃ ಶಾರೀರಿಕಶ್ಲಾಘಾಂ ಕುರ್ವ್ವತೇ ತಸ್ಮಾದ್ ಅಹಮಪಿ ಶ್ಲಾಘಿಷ್ಯೇ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಬುದ್ಧಿಮನ್ತೋ ಯೂಯಂ ಸುಖೇನ ನಿರ್ಬ್ಬೋಧಾನಾಮ್ ಆಚಾರಂ ಸಹಧ್ವೇ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಕೋಽಪಿ ಯದಿ ಯುಷ್ಮಾನ್ ದಾಸಾನ್ ಕರೋತಿ ಯದಿ ವಾ ಯುಷ್ಮಾಕಂ ಸರ್ವ್ವಸ್ವಂ ಗ್ರಸತಿ ಯದಿ ವಾ ಯುಷ್ಮಾನ್ ಹರತಿ ಯದಿ ವಾತ್ಮಾಭಿಮಾನೀ ಭವತಿ ಯದಿ ವಾ ಯುಷ್ಮಾಕಂ ಕಪೋಲಮ್ ಆಹನ್ತಿ ತರ್ಹಿ ತದಪಿ ಯೂಯಂ ಸಹಧ್ವೇ|</para>
  <para style="p">
    <verse number="21" style="v"/>ದೌರ್ಬ್ಬಲ್ಯಾದ್ ಯುಷ್ಮಾಭಿರವಮಾನಿತಾ ಇವ ವಯಂ ಭಾಷಾಮಹೇ, ಕಿನ್ತ್ವಪರಸ್ಯ ಕಸ್ಯಚಿದ್ ಯೇನ ಪ್ರಗಲ್ಭತಾ ಜಾಯತೇ ತೇನ ಮಮಾಪಿ ಪ್ರಗಲ್ಭತಾ ಜಾಯತ ಇತಿ ನಿರ್ಬ್ಬೋಧೇನೇವ ಮಯಾ ವಕ್ತವ್ಯಂ|</para>
  <para style="p">
    <verse number="22" style="v"/>ತೇ ಕಿಮ್ ಇಬ್ರಿಲೋಕಾಃ? ಅಹಮಪೀಬ್ರೀ| ತೇ ಕಿಮ್ ಇಸ್ರಾಯೇಲೀಯಾಃ? ಅಹಮಪೀಸ್ರಾಯೇಲೀಯಃ| ತೇ ಕಿಮ್ ಇಬ್ರಾಹೀಮೋ ವಂಶಾಃ? ಅಹಮಪೀಬ್ರಾಹೀಮೋ ವಂಶಃ|</para>
  <para style="p">
    <verse number="23" style="v"/>ತೇ ಕಿಂ ಖ್ರೀಷ್ಟಸ್ಯ ಪರಿಚಾರಕಾಃ? ಅಹಂ ತೇಭ್ಯೋಽಪಿ ತಸ್ಯ ಮಹಾಪರಿಚಾರಕಃ; ಕಿನ್ತು ನಿರ್ಬ್ಬೋಧ ಇವ ಭಾಷೇ, ತೇಭ್ಯೋಽಪ್ಯಹಂ ಬಹುಪರಿಶ್ರಮೇ ಬಹುಪ್ರಹಾರೇ ಬಹುವಾರಂ ಕಾರಾಯಾಂ ಬಹುವಾರಂ ಪ್ರಾಣನಾಶಸಂಶಯೇ ಚ ಪತಿತವಾನ್|</para>
  <para style="p">
    <verse number="24" style="v"/>ಯಿಹೂದೀಯೈರಹಂ ಪಞ್ಚಕೃತ್ವ ಊನಚತ್ವಾರಿಂಶತ್ಪ್ರಹಾರೈರಾಹತಸ್ತ್ರಿರ್ವೇತ್ರಾಘಾತಮ್ ಏಕಕೃತ್ವಃ ಪ್ರಸ್ತರಾಘಾತಞ್ಚ ಪ್ರಪ್ತವಾನ್|</para>
  <para style="p">
    <verse number="25" style="v"/>ವಾರತ್ರಯಂ ಪೋತಭಞ್ಜನೇನ ಕ್ಲಿಷ್ಟೋಽಹಮ್ ಅಗಾಧಸಲಿಲೇ ದಿನಮೇಕಂ ರಾತ್ರಿಮೇಕಾಞ್ಚ ಯಾಪಿತವಾನ್|</para>
  <para style="p">
    <verse number="26" style="v"/>ಬಹುವಾರಂ ಯಾತ್ರಾಭಿ ರ್ನದೀನಾಂ ಸಙ್ಕಟೈ ರ್ದಸ್ಯೂನಾಂ ಸಙ್ಕಟೈಃ ಸ್ವಜಾತೀಯಾನಾಂ ಸಙ್ಕಟೈ ರ್ಭಿನ್ನಜಾತೀಯಾನಾಂ ಸಙ್ಕಟೈ ರ್ನಗರಸ್ಯ ಸಙ್ಕಟೈ ರ್ಮರುಭೂಮೇಃ ಸಙ್ಕಟೈ ಸಾಗರಸ್ಯ ಸಙ್ಕಟೈ ರ್ಭಾಕ್ತಭ್ರಾತೃಣಾಂ ಸಙ್ಕಟೈಶ್ಚ</para>
  <para style="p">
    <verse number="27" style="v"/>ಪರಿಶ್ರಮಕ್ಲೇಶಾಭ್ಯಾಂ ವಾರಂ ವಾರಂ ಜಾಗರಣೇನ ಕ್ಷುಧಾತೃಷ್ಣಾಭ್ಯಾಂ ಬಹುವಾರಂ ನಿರಾಹಾರೇಣ ಶೀತನಗ್ನತಾಭ್ಯಾಞ್ಚಾಹಂ ಕಾಲಂ ಯಾಪಿತವಾನ್|</para>
  <para style="p">
    <verse number="28" style="v"/>ತಾದೃಶಂ ನೈಮಿತ್ತಿಕಂ ದುಃಖಂ ವಿನಾಹಂ ಪ್ರತಿದಿನಮ್ ಆಕುಲೋ ಭವಾಮಿ ಸರ್ವ್ವಾಸಾಂ ಸಮಿತೀನಾಂ ಚಿನ್ತಾ ಚ ಮಯಿ ವರ್ತ್ತತೇ|</para>
  <para style="p">
    <verse number="29" style="v"/>ಯೇನಾಹಂ ನ ದುರ್ಬ್ಬಲೀಭವಾಮಿ ತಾದೃಶಂ ದೌರ್ಬ್ಬಲ್ಯಂ ಕಃ ಪಾಪ್ನೋತಿ?</para>
  <para style="p">
    <verse number="30" style="v"/>ಯದಿ ಮಯಾ ಶ್ಲಾಘಿತವ್ಯಂ ತರ್ಹಿ ಸ್ವದುರ್ಬ್ಬಲತಾಮಧಿ ಶ್ಲಾಘಿಷ್ಯೇ|</para>
  <para style="p">
    <verse number="31" style="v"/>ಮಯಾ ಮೃಷಾವಾಕ್ಯಂ ನ ಕಥ್ಯತ ಇತಿ ನಿತ್ಯಂ ಪ್ರಶಂಸನೀಯೋಽಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ತಾತ ಈಶ್ವರೋ ಜಾನಾತಿ|</para>
  <para style="p">
    <verse number="32" style="v"/>ದಮ್ಮೇಷಕನಗರೇಽರಿತಾರಾಜಸ್ಯ ಕಾರ್ಯ್ಯಾಧ್ಯಕ್ಷೋ ಮಾಂ ಧರ್ತ್ತುಮ್ ಇಚ್ಛನ್ ಯದಾ ಸೈನ್ಯೈಸ್ತದ್ ದಮ್ಮೇಷಕನಗರಮ್ ಅರಕ್ಷಯತ್</para>
  <para style="p">
    <verse number="33" style="v"/>ತದಾಹಂ ಲೋಕೈಃ ಪಿಟಕಮಧ್ಯೇ ಪ್ರಾಚೀರಗವಾಕ್ಷೇಣಾವರೋಹಿತಸ್ತಸ್ಯ ಕರಾತ್ ತ್ರಾಣಂ ಪ್ರಾಪಂ|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಆತ್ಮಶ್ಲಾಘಾ ಮಮಾನುಪಯುಕ್ತಾ ಕಿನ್ತ್ವಹಂ ಪ್ರಭೋ ರ್ದರ್ಶನಾದೇಶಾನಾಮ್ ಆಖ್ಯಾನಂ ಕಥಯಿತುಂ ಪ್ರವರ್ತ್ತೇ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಇತಶ್ಚತುರ್ದಶವತ್ಸರೇಭ್ಯಃ ಪೂರ್ವ್ವಂ ಮಯಾ ಪರಿಚಿತ ಏಕೋ ಜನಸ್ತೃತೀಯಂ ಸ್ವರ್ಗಮನೀಯತ, ಸ ಸಶರೀರೇಣ ನಿಃಶರೀರೇಣ ವಾ ತತ್ ಸ್ಥಾನಮನೀಯತ ತದಹಂ ನ ಜಾನಾಮಿ ಕಿನ್ತ್ವೀಶ್ವರೋ ಜಾನಾತಿ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಸ ಮಾನವಃ ಸ್ವರ್ಗಂ ನೀತಃ ಸನ್ ಅಕಥ್ಯಾನಿ ಮರ್ತ್ತ್ಯವಾಗತೀತಾನಿ ಚ ವಾಕ್ಯಾನಿ ಶ್ರುತವಾನ್|</para>
  <para style="p">
    <verse number="4" style="v"/>ಕಿನ್ತು ತದಾನೀಂ ಸ ಸಶರೀರೋ ನಿಃಶರೀರೋ ವಾಸೀತ್ ತನ್ಮಯಾ ನ ಜ್ಞಾಯತೇ ತದ್ ಈಶ್ವರೇಣೈವ ಜ್ಞಾಯತೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ತಮಧ್ಯಹಂ ಶ್ಲಾಘಿಷ್ಯೇ ಮಾಮಧಿ ನಾನ್ಯೇನ ಕೇನಚಿದ್ ವಿಷಯೇಣ ಶ್ಲಾಘಿಷ್ಯೇ ಕೇವಲಂ ಸ್ವದೌರ್ಬ್ಬಲ್ಯೇನ ಶ್ಲಾಘಿಷ್ಯೇ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಯದ್ಯಹಮ್ ಆತ್ಮಶ್ಲಾಘಾಂ ಕರ್ತ್ತುಮ್ ಇಚ್ಛೇಯಂ ತಥಾಪಿ ನಿರ್ಬ್ಬೋಧ ಇವ ನ ಭವಿಷ್ಯಾಮಿ ಯತಃ ಸತ್ಯಮೇವ ಕಥಯಿಷ್ಯಾಮಿ, ಕಿನ್ತು ಲೋಕಾ ಮಾಂ ಯಾದೃಶಂ ಪಶ್ಯನ್ತಿ ಮಮ ವಾಕ್ಯಂ ಶ್ರುತ್ವಾ ವಾ ಯಾದೃಶಂ ಮಾಂ ಮನ್ಯತೇ ತಸ್ಮಾತ್ ಶ್ರೇಷ್ಠಂ ಮಾಂ ಯನ್ನ ಗಣಯನ್ತಿ ತದರ್ಥಮಹಂ ತತೋ ವಿರಂಸ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅಪರಮ್ ಉತ್ಕೃಷ್ಟದರ್ಶನಪ್ರಾಪ್ತಿತೋ ಯದಹಮ್ ಆತ್ಮಾಭಿಮಾನೀ ನ ಭವಾಮಿ ತದರ್ಥಂ ಶರೀರವೇಧಕಮ್ ಏಕಂ ಶೂಲಂ ಮಹ್ಯಮ್ ಅದಾಯಿ ತತ್ ಮದೀಯಾತ್ಮಾಭಿಮಾನನಿವಾರಣಾರ್ಥಂ ಮಮ ತಾಡಯಿತಾ ಶಯತಾನೋ ದೂತಃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಮತ್ತಸ್ತಸ್ಯ ಪ್ರಸ್ಥಾನಂ ಯಾಚಿತುಮಹಂ ತ್ರಿಸ್ತಮಧಿ ಪ್ರಭುಮುದ್ದಿಶ್ಯ ಪ್ರಾರ್ಥನಾಂ ಕೃತವಾನ್|</para>
  <para style="p">
    <verse number="9" style="v"/>ತತಃ ಸ ಮಾಮುಕ್ತವಾನ್ ಮಮಾನುಗ್ರಹಸ್ತವ ಸರ್ವ್ವಸಾಧಕಃ, ಯತೋ ದೌರ್ಬ್ಬಲ್ಯಾತ್ ಮಮ ಶಕ್ತಿಃ ಪೂರ್ಣತಾಂ ಗಚ್ಛತೀತಿ| ಅತಃ ಖ್ರೀಷ್ಟಸ್ಯ ಶಕ್ತಿ ರ್ಯನ್ಮಾಮ್ ಆಶ್ರಯತಿ ತದರ್ಥಂ ಸ್ವದೌರ್ಬ್ಬಲ್ಯೇನ ಮಮ ಶ್ಲಾಘನಂ ಸುಖದಂ|</para>
  <para style="p">
    <verse number="10" style="v"/>ತಸ್ಮಾತ್ ಖ್ರೀಷ್ಟಹೇತೋ ರ್ದೌರ್ಬ್ಬಲ್ಯನಿನ್ದಾದರಿದ್ರತಾವಿಪಕ್ಷತಾಕಷ್ಟಾದಿಷು ಸನ್ತುಷ್ಯಾಮ್ಯಹಂ| ಯದಾಹಂ ದುರ್ಬ್ಬಲೋಽಸ್ಮಿ ತದೈವ ಸಬಲೋ ಭವಾಮಿ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಏತೇನಾತ್ಮಶ್ಲಾಘನೇನಾಹಂ ನಿರ್ಬ್ಬೋಧ ಇವಾಭವಂ ಕಿನ್ತು ಯೂಯಂ ತಸ್ಯ ಕಾರಣಂ ಯತೋ ಮಮ ಪ್ರಶಂಸಾ ಯುಷ್ಮಾಭಿರೇವ ಕರ್ತ್ತವ್ಯಾಸೀತ್| ಯದ್ಯಪ್ಯಮ್ ಅಗಣ್ಯೋ ಭವೇಯಂ ತಥಾಪಿ ಮುಖ್ಯತಮೇಭ್ಯಃ ಪ್ರೇರಿತೇಭ್ಯಃ ಕೇನಾಪಿ ಪ್ರಕಾರೇಣ ನಾಹಂ ನ್ಯೂನೋಽಸ್ಮಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಸರ್ವ್ವಥಾದ್ಭುತಕ್ರಿಯಾಶಕ್ತಿಲಕ್ಷಣೈಃ ಪ್ರೇರಿತಸ್ಯ ಚಿಹ್ನಾನಿ ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ಸಧೈರ್ಯ್ಯಂ ಮಯಾ ಪ್ರಕಾಶಿತಾನಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಮಮ ಪಾಲನಾರ್ಥಂ ಯೂಯಂ ಮಯಾ ಭಾರಾಕ್ರಾನ್ತಾ ನಾಭವತೈತದ್ ಏಕಂ ನ್ಯೂನತ್ವಂ ವಿನಾಪರಾಭ್ಯಃ ಸಮಿತಿಭ್ಯೋ ಯುಷ್ಮಾಕಂ ಕಿಂ ನ್ಯೂನತ್ವಂ ಜಾತಂ? ಅನೇನ ಮಮ ದೋಷಂ ಕ್ಷಮಧ್ವಂ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಪಶ್ಯತ ತೃತೀಯವಾರಂ ಯುुಷ್ಮತ್ಸಮೀಪಂ ಗನ್ತುಮುದ್ಯತೋಽಸ್ಮಿ ತತ್ರಾಪ್ಯಹಂ ಯುಷ್ಮಾನ್ ಭಾರಾಕ್ರಾನ್ತಾನ್ ನ ಕರಿಷ್ಯಾಮಿ| ಯುಷ್ಮಾಕಂ ಸಮ್ಪತ್ತಿಮಹಂ ನ ಮೃಗಯೇ ಕಿನ್ತು ಯುಷ್ಮಾನೇವ, ಯತಃ ಪಿತ್ರೋಃ ಕೃತೇ ಸನ್ತಾನಾನಾಂ ಧನಸಞ್ಚಯೋಽನುಪಯುಕ್ತಃ ಕಿನ್ತು ಸನ್ತಾನಾನಾಂ ಕೃತೇ ಪಿತ್ರೋ ರ್ಧನಸಞ್ಚಯ ಉಪಯುಕ್ತಃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅಪರಞ್ಚ ಯುಷ್ಮಾಸು ಬಹು ಪ್ರೀಯಮಾಣೋಽಪ್ಯಹಂ ಯದಿ ಯುಷ್ಮತ್ತೋಽಲ್ಪಂ ಪ್ರಮ ಲಭೇ ತಥಾಪಿ ಯುಷ್ಮಾಕಂ ಪ್ರಾಣರಕ್ಷಾರ್ಥಂ ಸಾನನ್ದಂ ಬಹು ವ್ಯಯಂ ಸರ್ವ್ವವ್ಯಯಞ್ಚ ಕರಿಷ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯೂಯಂ ಮಯಾ ಕಿಞ್ಚಿದಪಿ ನ ಭಾರಾಕ್ರಾನ್ತಾ ಇತಿ ಸತ್ಯಂ, ಕಿನ್ತ್ವಹಂ ಧೂರ್ತ್ತಃ ಸನ್ ಛಲೇನ ಯುಷ್ಮಾನ್ ವಞ್ಚಿತವಾನ್ ಏತತ್ ಕಿಂ ಕೇನಚಿದ್ ವಕ್ತವ್ಯಂ?</para>
  <para style="p">
    <verse number="17" style="v"/>ಯುಷ್ಮತ್ಸಮೀಪಂ ಮಯಾ ಯೇ ಲೋಕಾಃ ಪ್ರಹಿತಾಸ್ತೇಷಾಮೇಕೇನ ಕಿಂ ಮಮ ಕೋಽಪ್ಯರ್ಥಲಾಭೋ ಜಾತಃ?</para>
  <para style="p">
    <verse number="18" style="v"/>ಅಹಂ ತೀತಂ ವಿನೀಯ ತೇನ ಸಾರ್ದ್ಧಂ ಭ್ರಾತರಮೇಕಂ ಪ್ರೇಷಿತವಾನ್ ಯುಷ್ಮತ್ತಸ್ತೀತೇನ ಕಿಮ್ ಅರ್ಥೋ ಲಬ್ಧಃ? ಏಕಸ್ಮಿನ್ ಭಾವ ಏಕಸ್ಯ ಪದಚಿಹ್ನೇಷು ಚಾವಾಂ ಕಿಂ ನ ಚರಿತವನ್ತೌ?</para>
  <para style="p">
    <verse number="19" style="v"/>ಯುಷ್ಮಾಕಂ ಸಮೀಪೇ ವಯಂ ಪುನ ರ್ದೋಷಕ್ಷಾಲನಕಥಾಂ ಕಥಯಾಮ ಇತಿ ಕಿಂ ಬುಧ್ಯಧ್ವೇ? ಹೇ ಪ್ರಿಯತಮಾಃ, ಯುಷ್ಮಾಕಂ ನಿಷ್ಠಾರ್ಥಂ ವಯಮೀಶ್ವರಸ್ಯ ಸಮಕ್ಷಂ ಖ್ರೀಷ್ಟೇನ ಸರ್ವ್ವಾಣ್ಯೇತಾನಿ ಕಥಯಾಮಃ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಅಹಂ ಯದಾಗಮಿಷ್ಯಾಮಿ, ತದಾ ಯುಷ್ಮಾನ್ ಯಾದೃಶಾನ್ ದ್ರಷ್ಟುಂ ನೇಚ್ಛಾಮಿ ತಾದೃಶಾನ್ ದ್ರಕ್ಷ್ಯಾಮಿ, ಯೂಯಮಪಿ ಮಾಂ ಯಾದೃಶಂ ದ್ರಷ್ಟುಂ ನೇಚ್ಛಥ ತಾದೃಶಂ ದ್ರಕ್ಷ್ಯಥ, ಯುಷ್ಮನ್ಮಧ್ಯೇ ವಿವಾದ ಈರ್ಷ್ಯಾ ಕ್ರೋಧೋ ವಿಪಕ್ಷತಾ ಪರಾಪವಾದಃ ಕರ್ಣೇಜಪನಂ ದರ್ಪಃ ಕಲಹಶ್ಚೈತೇ ಭವಿಷ್ಯನ್ತಿ;</para>
  <para style="p">
    <verse number="21" style="v"/>ತೇನಾಹಂ ಯುಷ್ಮತ್ಸಮೀಪಂ ಪುನರಾಗತ್ಯ ಮದೀಯೇಶ್ವರೇಣ ನಮಯಿಷ್ಯೇ, ಪೂರ್ವ್ವಂ ಕೃತಪಾಪಾನ್ ಲೋಕಾನ್ ಸ್ವೀಯಾಶುಚಿತಾವೇಶ್ಯಾಗಮನಲಮ್ಪಟತಾಚರಣಾದ್ ಅನುತಾಪಮ್ ಅಕೃತವನ್ತೋ ದೃಷ್ಟ್ವಾ ಚ ತಾನಧಿ ಮಮ ಶೋಕೋ ಜನಿಷ್ಯತ ಇತಿ ಬಿಭೇಮಿ|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಏತತ್ತೃತೀಯವಾರಮ್ ಅಹಂ ಯುಷ್ಮತ್ಸಮೀಪಂ ಗಚ್ಛಾಮಿ ತೇನ ಸರ್ವ್ವಾ ಕಥಾ ದ್ವಯೋಸ್ತ್ರಯಾಣಾಂ ವಾ ಸಾಕ್ಷಿಣಾಂ ಮುಖೇನ ನಿಶ್ಚೇಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಪೂರ್ವ್ವಂ ಯೇ ಕೃತಪಾಪಾಸ್ತೇಭ್ಯೋಽನ್ಯೇಭ್ಯಶ್ಚ ಸರ್ವ್ವೇಭ್ಯೋ ಮಯಾ ಪೂರ್ವ್ವಂ ಕಥಿತಂ, ಪುನರಪಿ ವಿದ್ಯಮಾನೇನೇವೇದಾನೀಮ್ ಅವಿದ್ಯಮಾನೇನ ಮಯಾ ಕಥ್ಯತೇ, ಯದಾ ಪುನರಾಗಮಿಷ್ಯಾಮಿ ತದಾಹಂ ನ ಕ್ಷಮಿಷ್ಯೇ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಖ್ರೀಷ್ಟೋ ಮಯಾ ಕಥಾಂ ಕಥಯತ್ಯೇತಸ್ಯ ಪ್ರಮಾಣಂ ಯೂಯಂ ಮೃಗಯಧ್ವೇ, ಸ ತು ಯುಷ್ಮಾನ್ ಪ್ರತಿ ದುರ್ಬ್ಬಲೋ ನಹಿ ಕಿನ್ತು ಸಬಲ ಏವ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಯದ್ಯಪಿ ಸ ದುರ್ಬ್ಬಲತಯಾ ಕ್ರುಶ ಆರೋಪ್ಯತ ತಥಾಪೀಶ್ವರೀಯಶಕ್ತಯಾ ಜೀವತಿ; ವಯಮಪಿ ತಸ್ಮಿನ್ ದುರ್ಬ್ಬಲಾ ಭವಾಮಃ, ತಥಾಪಿ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಪ್ರಕಾಶಿತಯೇಶ್ವರೀಯಶಕ್ತ್ಯಾ ತೇನ ಸಹ ಜೀವಿಷ್ಯಾಮಃ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಅತೋ ಯೂಯಂ ವಿಶ್ವಾಸಯುಕ್ತಾ ಆಧ್ವೇ ನ ವೇತಿ ಜ್ಞಾತುಮಾತ್ಮಪರೀಕ್ಷಾಂ ಕುರುಧ್ವಂ ಸ್ವಾನೇವಾನುಸನ್ಧತ್ತ| ಯೀಶುಃ ಖ್ರೀಷ್ಟೋ ಯುಷ್ಮನ್ಮಧ್ಯೇ ವಿದ್ಯತೇ ಸ್ವಾನಧಿ ತತ್ ಕಿಂ ನ ಪ್ರತಿಜಾನೀಥ? ತಸ್ಮಿನ್ ಅವಿದ್ಯಮಾನೇ ಯೂಯಂ ನಿಷ್ಪ್ರಮಾಣಾ ಭವಥ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಕಿನ್ತು ವಯಂ ನಿಷ್ಪ್ರಮಾಣಾ ನ ಭವಾಮ ಇತಿ ಯುಷ್ಮಾಭಿ ರ್ಭೋತ್ಸ್ಯತೇ ತತ್ರ ಮಮ ಪ್ರತ್ಯಾಶಾ ಜಾಯತೇ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯೂಯಂ ಕಿಮಪಿ ಕುತ್ಸಿತಂ ಕರ್ಮ್ಮ ಯನ್ನ ಕುರುಥ ತದಹಮ್ ಈಶ್ವರಮುದ್ದಿಶ್ಯ ಪ್ರಾರ್ಥಯೇ| ವಯಂ ಯತ್ ಪ್ರಾಮಾಣಿಕಾ ಇವ ಪ್ರಕಾಶಾಮಹೇ ತದರ್ಥಂ ತತ್ ಪ್ರಾರ್ಥಯಾಮಹ ಇತಿ ನಹಿ, ಕಿನ್ತು ಯೂಯಂ ಯತ್ ಸದಾಚಾರಂ ಕುರುಥ ವಯಞ್ಚ ನಿಷ್ಪ್ರಮಾಣಾ ಇವ ಭವಾಮಸ್ತದರ್ಥಂ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಯತಃ ಸತ್ಯತಾಯಾ ವಿಪಕ್ಷತಾಂ ಕರ್ತ್ತುಂ ವಯಂ ನ ಸಮರ್ಥಾಃ ಕಿನ್ತು ಸತ್ಯತಾಯಾಃ ಸಾಹಾಯ್ಯಂ ಕರ್ತ್ತುಮೇವ|</para>
  <para style="p">
    <verse number="9" style="v"/>ವಯಂ ಯದಾ ದುರ್ಬ್ಬಲಾ ಭವಾಮಸ್ತದಾ ಯುಷ್ಮಾನ್ ಸಬಲಾನ್ ದೃಷ್ಟ್ವಾನನ್ದಾಮೋ ಯುಷ್ಮಾಕಂ ಸಿದ್ಧತ್ವಂ ಪ್ರಾರ್ಥಯಾಮಹೇ ಚ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಅತೋ ಹೇತೋಃ ಪ್ರಭು ರ್ಯುಷ್ಮಾಕಂ ವಿನಾಶಾಯ ನಹಿ ಕಿನ್ತು ನಿಷ್ಠಾಯೈ ಯತ್ ಸಾಮರ್ಥ್ಯಮ್ ಅಸ್ಮಭ್ಯಂ ದತ್ತವಾನ್ ತೇನ ಯದ್ ಉಪಸ್ಥಿತಿಕಾಲೇ ಕಾಠಿನ್ಯಂ ಮಯಾಚರಿತವ್ಯಂ ನ ಭವೇತ್ ತದರ್ಥಮ್ ಅನುಪಸ್ಥಿತೇನ ಮಯಾ ಸರ್ವ್ವಾಣ್ಯೇತಾನಿ ಲಿಖ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಶೇಷೇ ವದಾಮಿ ಯೂಯಮ್ ಆನನ್ದತ ಸಿದ್ಧಾ ಭವತ ಪರಸ್ಪರಂ ಪ್ರಬೋಧಯತ, ಏಕಮನಸೋ ಭವತ ಪ್ರಣಯಭಾವಮ್ ಆಚರತ| ಪ್ರೇಮಶಾನ್ತ್ಯೋರಾಕರ ಈಶ್ವರೋ ಯುಷ್ಮಾಕಂ ಸಹಾಯೋ ಭೂಯಾತ್|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯೂಯಂ ಪವಿತ್ರಚುಮ್ಬನೇನ ಪರಸ್ಪರಂ ನಮಸ್ಕುರುಧ್ವಂ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಪವಿತ್ರಲೋಕಾಃ ಸರ್ವ್ವೇ ಯುಷ್ಮಾನ್ ನಮನ್ತಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯಾನುಗ್ರಹ ಈಶ್ವರಸ್ಯ ಪ್ರೇಮ ಪವಿತ್ರಸ್ಯಾತ್ಮನೋ ಭಾಗಿತ್ವಞ್ಚ ಸರ್ವ್ವಾನ್ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಭೂಯಾತ್| ತಥಾಸ್ತು|</para>
</usx>
