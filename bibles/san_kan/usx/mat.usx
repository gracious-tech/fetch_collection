<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="MAT" style="id">Sanskrit Bible (NT) in Kannada Script (ಸತ್ಯವೇದಃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Matthew</para>
  <para style="toc1">ಮಥಿಲಿಖಿತಃ ಸುಸಂವಾದಃ</para>
  <para style="toc2">ಮಥಿಃ</para>
  <para style="toc3">ಮಥಿಃ</para>
  <para style="mt1">ಮಥಿಲಿಖಿತಃ ಸುಸಂವಾದಃ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಇಬ್ರಾಹೀಮಃ ಸನ್ತಾನೋ ದಾಯೂದ್ ತಸ್ಯ ಸನ್ತಾನೋ ಯೀಶುಖ್ರೀಷ್ಟಸ್ತಸ್ಯ ಪೂರ್ವ್ವಪುರುಷವಂಶಶ್ರೇಣೀ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಇಬ್ರಾಹೀಮಃ ಪುತ್ರ ಇಸ್ಹಾಕ್ ತಸ್ಯ ಪುತ್ರೋ ಯಾಕೂಬ್ ತಸ್ಯ ಪುತ್ರೋ ಯಿಹೂದಾಸ್ತಸ್ಯ ಭ್ರಾತರಶ್ಚ|</para>
  <para style="p">
    <verse number="3" style="v"/>ತಸ್ಮಾದ್ ಯಿಹೂದಾತಸ್ತಾಮರೋ ಗರ್ಭೇ ಪೇರಸ್ಸೇರಹೌ ಜಜ್ಞಾತೇ, ತಸ್ಯ ಪೇರಸಃ ಪುತ್ರೋ ಹಿಷ್ರೋಣ್ ತಸ್ಯ ಪುತ್ರೋ ಽರಾಮ್|</para>
  <para style="p">
    <verse number="4" style="v"/>ತಸ್ಯ ಪುತ್ರೋ ಽಮ್ಮೀನಾದಬ್ ತಸ್ಯ ಪುತ್ರೋ ನಹಶೋನ್ ತಸ್ಯ ಪುತ್ರಃ ಸಲ್ಮೋನ್|</para>
  <para style="p">
    <verse number="5" style="v"/>ತಸ್ಮಾದ್ ರಾಹಬೋ ಗರ್ಭೇ ಬೋಯಮ್ ಜಜ್ಞೇ, ತಸ್ಮಾದ್ ರೂತೋ ಗರ್ಭೇ ಓಬೇದ್ ಜಜ್ಞೇ, ತಸ್ಯ ಪುತ್ರೋ ಯಿಶಯಃ|</para>
  <para style="p">
    <verse number="6" style="v"/>ತಸ್ಯ ಪುತ್ರೋ ದಾಯೂದ್ ರಾಜಃ ತಸ್ಮಾದ್ ಮೃತೋರಿಯಸ್ಯ ಜಾಯಾಯಾಂ ಸುಲೇಮಾನ್ ಜಜ್ಞೇ|</para>
  <para style="p">
    <verse number="7" style="v"/>ತಸ್ಯ ಪುತ್ರೋ ರಿಹಬಿಯಾಮ್, ತಸ್ಯ ಪುತ್ರೋಽಬಿಯಃ, ತಸ್ಯ ಪುತ್ರ ಆಸಾ:|</para>
  <para style="p">
    <verse number="8" style="v"/>ತಸ್ಯ ಸುತೋ ಯಿಹೋಶಾಫಟ್ ತಸ್ಯ ಸುತೋ ಯಿಹೋರಾಮ ತಸ್ಯ ಸುತ ಉಷಿಯಃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ತಸ್ಯ ಸುತೋ ಯೋಥಮ್ ತಸ್ಯ ಸುತ ಆಹಮ್ ತಸ್ಯ ಸುತೋ ಹಿಷ್ಕಿಯಃ|</para>
  <para style="p">
    <verse number="10" style="v"/>ತಸ್ಯ ಸುತೋ ಮಿನಶಿಃ, ತಸ್ಯ ಸುತ ಆಮೋನ್ ತಸ್ಯ ಸುತೋ ಯೋಶಿಯಃ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಬಾಬಿಲ್ನಗರೇ ಪ್ರವಸನಾತ್ ಪೂರ್ವ್ವಂ ಸ ಯೋಶಿಯೋ ಯಿಖನಿಯಂ ತಸ್ಯ ಭ್ರಾತೃಂಶ್ಚ ಜನಯಾಮಾಸ|</para>
  <para style="p">
    <verse number="12" style="v"/>ತತೋ ಬಾಬಿಲಿ ಪ್ರವಸನಕಾಲೇ ಯಿಖನಿಯಃ ಶಲ್ತೀಯೇಲಂ ಜನಯಾಮಾಸ, ತಸ್ಯ ಸುತಃ ಸಿರುಬ್ಬಾವಿಲ್|</para>
  <para style="p">
    <verse number="13" style="v"/>ತಸ್ಯ ಸುತೋ ಽಬೋಹುದ್ ತಸ್ಯ ಸುತ ಇಲೀಯಾಕೀಮ್ ತಸ್ಯ ಸುತೋಽಸೋರ್|</para>
  <para style="p">
    <verse number="14" style="v"/>ಅಸೋರಃ ಸುತಃ ಸಾದೋಕ್ ತಸ್ಯ ಸುತ ಆಖೀಮ್ ತಸ್ಯ ಸುತ ಇಲೀಹೂದ್|</para>
  <para style="p">
    <verse number="15" style="v"/>ತಸ್ಯ ಸುತ ಇಲಿಯಾಸರ್ ತಸ್ಯ ಸುತೋ ಮತ್ತನ್|</para>
  <para style="p">
    <verse number="16" style="v"/>ತಸ್ಯ ಸುತೋ ಯಾಕೂಬ್ ತಸ್ಯ ಸುತೋ ಯೂಷಫ್ ತಸ್ಯ ಜಾಯಾ ಮರಿಯಮ್; ತಸ್ಯ ಗರ್ಭೇ ಯೀಶುರಜನಿ, ತಮೇವ ಖ್ರೀಷ್ಟಮ್ (ಅರ್ಥಾದ್ ಅಭಿಷಿಕ್ತಂ) ವದನ್ತಿ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಇತ್ಥಮ್ ಇಬ್ರಾಹೀಮೋ ದಾಯೂದಂ ಯಾವತ್ ಸಾಕಲ್ಯೇನ ಚತುರ್ದಶಪುರುಷಾಃ; ಆ ದಾಯೂದಃ ಕಾಲಾದ್ ಬಾಬಿಲಿ ಪ್ರವಸನಕಾಲಂ ಯಾವತ್ ಚತುರ್ದಶಪುರುಷಾ ಭವನ್ತಿ| ಬಾಬಿಲಿ ಪ್ರವಾಸನಕಾಲಾತ್ ಖ್ರೀಷ್ಟಸ್ಯ ಕಾಲಂ ಯಾವತ್ ಚತುರ್ದಶಪುರುಷಾ ಭವನ್ತಿ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಜನ್ಮ ಕಥ್ಥತೇ| ಮರಿಯಮ್ ನಾಮಿಕಾ ಕನ್ಯಾ ಯೂಷಫೇ ವಾಗ್ದತ್ತಾಸೀತ್, ತದಾ ತಯೋಃ ಸಙ್ಗಮಾತ್ ಪ್ರಾಕ್ ಸಾ ಕನ್ಯಾ  ಪವಿತ್ರೇಣಾತ್ಮನಾ ಗರ್ಭವತೀ ಬಭೂವ|</para>
  <para style="p">
    <verse number="19" style="v"/>ತತ್ರ ತಸ್ಯಾಃ ಪತಿ ರ್ಯೂಷಫ್ ಸೌಜನ್ಯಾತ್ ತಸ್ಯಾಃ ಕಲಙ್ಗಂ ಪ್ರಕಾಶಯಿತುಮ್ ಅನಿಚ್ಛನ್ ಗೋಪನೇನೇ ತಾಂ ಪಾರಿತ್ಯಕ್ತುಂ ಮನಶ್ಚಕ್ರೇ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಸ ತಥೈವ ಭಾವಯತಿ, ತದಾನೀಂ ಪರಮೇಶ್ವರಸ್ಯ ದೂತಃ ಸ್ವಪ್ನೇ ತಂ ದರ್ಶನಂ ದತ್ತ್ವಾ ವ್ಯಾಜಹಾರ, ಹೇ ದಾಯೂದಃ ಸನ್ತಾನ ಯೂಷಫ್ ತ್ವಂ ನಿಜಾಂ ಜಾಯಾಂ ಮರಿಯಮಮ್ ಆದಾತುಂ ಮಾ ಭೈಷೀಃ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಯತಸ್ತಸ್ಯಾ ಗರ್ಭಃ ಪವಿತ್ರಾದಾತ್ಮನೋಽಭವತ್, ಸಾ ಚ ಪುತ್ರಂ ಪ್ರಸವಿಷ್ಯತೇ, ತದಾ ತ್ವಂ ತಸ್ಯ ನಾಮ ಯೀಶುಮ್ (ಅರ್ಥಾತ್ ತ್ರಾತಾರಂ) ಕರೀಷ್ಯಸೇ, ಯಸ್ಮಾತ್ ಸ ನಿಜಮನುಜಾನ್ ತೇಷಾಂ ಕಲುಷೇಭ್ಯ ಉದ್ಧರಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಇತ್ಥಂ ಸತಿ, ಪಶ್ಯ ಗರ್ಭವತೀ ಕನ್ಯಾ ತನಯಂ ಪ್ರಸವಿಷ್ಯತೇ| ಇಮ್ಮಾನೂಯೇಲ್ ತದೀಯಞ್ಚ ನಾಮಧೇಯಂ ಭವಿಷ್ಯತಿ|| ಇಮ್ಮಾನೂಯೇಲ್ ಅಸ್ಮಾಕಂ ಸಙ್ಗೀಶ್ವರಇತ್ಯರ್ಥಃ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಇತಿ ಯದ್ ವಚನಂ ಪುರ್ವ್ವಂ ಭವಿಷ್ಯದ್ವಕ್ತ್ರಾ ಈಶ್ವರಃ ಕಥಾಯಾಮಾಸ, ತತ್ ತದಾನೀಂ ಸಿದ್ಧಮಭವತ್|</para>
  <para style="p">
    <verse number="24" style="v"/>ಅನನ್ತರಂ ಯೂಷಫ್ ನಿದ್ರಾತೋ ಜಾಗರಿತ ಉತ್ಥಾಯ ಪರಮೇಶ್ವರೀಯದೂತಸ್ಯ ನಿದೇಶಾನುಸಾರೇಣ ನಿಜಾಂ ಜಾಯಾಂ ಜಗ್ರಾಹ,</para>
  <para style="p">
    <verse number="25" style="v"/>ಕಿನ್ತು ಯಾವತ್ ಸಾ ನಿಜಂ ಪ್ರಥಮಸುತಂ ಅ ಸುಷುವೇ, ತಾವತ್ ತಾಂ ನೋಪಾಗಚ್ಛತ್, ತತಃ ಸುತಸ್ಯ ನಾಮ ಯೀಶುಂ ಚಕ್ರೇ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅನನ್ತರಂ ಹೇರೋದ್ ಸಂಜ್ಞಕೇ ರಾಜ್ಞಿ ರಾಜ್ಯಂ ಶಾಸತಿ ಯಿಹೂದೀಯದೇಶಸ್ಯ ಬೈತ್ಲೇಹಮಿ ನಗರೇ ಯೀಶೌ ಜಾತವತಿ ಚ, ಕತಿಪಯಾ ಜ್ಯೋತಿರ್ವ್ವುದಃ ಪೂರ್ವ್ವಸ್ಯಾ ದಿಶೋ ಯಿರೂಶಾಲಮ್ನಗರಂ ಸಮೇತ್ಯ ಕಥಯಮಾಸುಃ,</para>
  <para style="p">
    <verse number="2" style="v"/>ಯೋ ಯಿಹೂದೀಯಾನಾಂ ರಾಜಾ ಜಾತವಾನ್, ಸ ಕುತ್ರಾಸ್ತೇ? ವಯಂ ಪೂರ್ವ್ವಸ್ಯಾಂ ದಿಶಿ ತಿಷ್ಠನ್ತಸ್ತದೀಯಾಂ ತಾರಕಾಮ್ ಅಪಶ್ಯಾಮ ತಸ್ಮಾತ್ ತಂ ಪ್ರಣನ್ತುಮ್ ಅाಗಮಾಮ|</para>
  <para style="p">
    <verse number="3" style="v"/>ತದಾ ಹೇರೋದ್ ರಾಜಾ ಕಥಾಮೇತಾಂ ನಿಶಮ್ಯ ಯಿರೂಶಾಲಮ್ನಗರಸ್ಥಿತೈಃ ಸರ್ವ್ವಮಾನವೈಃ ಸಾರ್ದ್ಧಮ್ ಉದ್ವಿಜ್ಯ</para>
  <para style="p">
    <verse number="4" style="v"/>ಸರ್ವ್ವಾನ್ ಪ್ರಧಾನಯಾಜಕಾನ್ ಅಧ್ಯಾಪಕಾಂಶ್ಚ ಸಮಾಹೂಯಾನೀಯ ಪಪ್ರಚ್ಛ, ಖ್ರೀಷ್ಟಃ ಕುತ್ರ ಜನಿಷ್ಯತೇ?</para>
  <para style="p">
    <verse number="5" style="v"/>ತದಾ ತೇ ಕಥಯಾಮಾಸುಃ, ಯಿಹೂದೀಯದೇಶಸ್ಯ ಬೈತ್ಲೇಹಮಿ ನಗರೇ, ಯತೋ ಭವಿಷ್ಯದ್ವಾದಿನಾ ಇತ್ಥಂ ಲಿಖಿತಮಾಸ್ತೇ,</para>
  <para style="p">
    <verse number="6" style="v"/>ಸರ್ವ್ವಾಭ್ಯೋ ರಾಜಧಾನೀಭ್ಯೋ ಯಿಹೂದೀಯಸ್ಯ ನೀವೃತಃ| ಹೇ ಯೀಹೂದೀಯದೇಶಸ್ಯೇ ಬೈತ್ಲೇಹಮ್ ತ್ವಂ ನ ಚಾವರಾ| ಇಸ್ರಾಯೇಲೀಯಲೋಕಾನ್ ಮೇ ಯತೋ ಯಃ ಪಾಲಯಿಷ್ಯತಿ| ತಾದೃಗೇಕೋ ಮಹಾರಾಜಸ್ತ್ವನ್ಮಧ್ಯ ಉದ್ಭವಿಷ್ಯತೀ||</para>
  <para style="p">
    <verse number="7" style="v"/>ತದಾನೀಂ ಹೇರೋದ್ ರಾಜಾ ತಾನ್ ಜ್ಯೋತಿರ್ವ್ವಿದೋ ಗೋಪನಮ್ ಆಹೂಯ ಸಾ ತಾರಕಾ ಕದಾ ದೃಷ್ಟಾಭವತ್ , ತದ್ ವಿನಿಶ್ಚಯಾಮಾಸ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಅಪರಂ ತಾನ್ ಬೈತ್ಲೇಹಮಂ ಪ್ರಹೀತ್ಯ ಗದಿತವಾನ್, ಯೂಯಂ ಯಾತ, ಯತ್ನಾತ್ ತಂ ಶಿಶುಮ್ ಅನ್ವಿಷ್ಯ ತದುದ್ದೇಶೇ ಪ್ರಾಪ್ತೇ ಮಹ್ಯಂ ವಾರ್ತ್ತಾಂ ದಾಸ್ಯಥ, ತತೋ ಮಯಾಪಿ ಗತ್ವಾ ಸ ಪ್ರಣಂಸ್ಯತೇ|</para>
  <para style="p">
    <verse number="9" style="v"/>ತದಾನೀಂ ರಾಜ್ಞ ಏತಾದೃಶೀಮ್ ಆಜ್ಞಾಂ ಪ್ರಾಪ್ಯ ತೇ ಪ್ರತಸ್ಥಿರೇ, ತತಃ ಪೂರ್ವ್ವರ್ಸ್ಯಾಂ ದಿಶಿ ಸ್ಥಿತೈಸ್ತೈ ರ್ಯಾ ತಾರಕಾ ದೃಷ್ಟಾ ಸಾ ತಾರಕಾ ತೇಷಾಮಗ್ರೇ ಗತ್ವಾ ಯತ್ರ ಸ್ಥಾನೇ ಶಿಶೂರಾಸ್ತೇ, ತಸ್ಯ ಸ್ಥಾನಸ್ಯೋಪರಿ ಸ್ಥಗಿತಾ ತಸ್ಯೌ|</para>
  <para style="p">
    <verse number="10" style="v"/>ತದ್ ದೃಷ್ಟ್ವಾ ತೇ ಮಹಾನನ್ದಿತಾ ಬಭೂವುಃ,</para>
  <para style="p">
    <verse number="11" style="v"/>ತತೋ ಗೇಹಮಧ್ಯ ಪ್ರವಿಶ್ಯ ತಸ್ಯ ಮಾತ್ರಾ ಮರಿಯಮಾ ಸಾದ್ಧಂ ತಂ ಶಿಶುಂ ನಿರೀಕ್ಷಯ ದಣ್ಡವದ್ ಭೂತ್ವಾ ಪ್ರಣೇಮುಃ, ಅಪರಂ ಸ್ವೇಷಾಂ ಘನಸಮ್ಪತ್ತಿಂ ಮೋಚಯಿತ್ವಾ ಸುವರ್ಣಂ ಕುನ್ದುರುಂ ಗನ್ಧರಮಞ್ಚ ತಸ್ಮೈ ದರ್ಶನೀಯಂ ದತ್ತವನ್ತಃ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಪಶ್ಚಾದ್ ಹೇರೋದ್ ರಾಜಸ್ಯ ಸಮೀಪಂ ಪುನರಪಿ ಗನ್ತುಂ ಸ್ವಪ್ನ ಈಶ್ವರೇಣ ನಿಷಿದ್ಧಾಃ ಸನ್ತೋ ಽನ್ಯೇನ ಪಥಾ ತೇ ನಿಜದೇಶಂ ಪ್ರತಿ ಪ್ರತಸ್ಥಿರೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅನನ್ತರಂ ತೇಷು ಗತವತ್ಮು ಪರಮೇಶ್ವರಸ್ಯ ದೂತೋ ಯೂಷಫೇ ಸ್ವಪ್ನೇ ದರ್ಶನಂ ದತ್ವಾ ಜಗಾದ, ತ್ವಮ್ ಉತ್ಥಾಯ ಶಿಶುಂ ತನ್ಮಾತರಞ್ಚ ಗೃಹೀತ್ವಾ ಮಿಸರ್ದೇಶಂ ಪಲಾಯಸ್ವ, ಅಪರಂ ಯಾವದಹಂ ತುಭ್ಯಂ ವಾರ್ತ್ತಾಂ ನ ಕಥಯಿಷ್ಯಾಮಿ, ತಾವತ್ ತತ್ರೈವ ನಿವಸ, ಯತೋ ರಾಜಾ ಹೇರೋದ್ ಶಿಶುಂ ನಾಶಯಿತುಂ ಮೃಗಯಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ತದಾನೀಂ ಯೂಷಫ್ ಉತ್ಥಾಯ ರಜನ್ಯಾಂ ಶಿಶುಂ ತನ್ಮಾತರಞ್ಚ ಗೃಹೀತ್ವಾ ಮಿಸರ್ದೇಶಂ ಪ್ರತಿ ಪ್ರತಸ್ಥೇ,</para>
  <para style="p">
    <verse number="15" style="v"/>ಗತ್ವಾ ಚ ಹೇರೋದೋ ನೃಪತೇ ರ್ಮರಣಪರ್ಯ್ಯನ್ತಂ ತತ್ರ ದೇಶೇ ನ್ಯುವಾಸ, ತೇನ ಮಿಸರ್ದೇಶಾದಹಂ ಪುತ್ರಂ ಸ್ವಕೀಯಂ ಸಮುಪಾಹೂಯಮ್| ಯದೇತದ್ವಚನಮ್ ಈಶ್ವರೇಣ ಭವಿಷ್ಯದ್ವಾದಿನಾ ಕಥಿತಂ ತತ್ ಸಫಲಮಭೂತ್|</para>
  <para style="p">
    <verse number="16" style="v"/>ಅನನ್ತರಂ ಹೇರೋದ್ ಜ್ಯೋತಿರ್ವಿದ್ಭಿರಾತ್ಮಾನಂ ಪ್ರವಞ್ಚಿತಂ ವಿಜ್ಞಾಯ ಭೃಶಂ ಚುಕೋಪ; ಅಪರಂ ಜ್ಯೋತಿರ್ವ್ವಿದ್ಭ್ಯಸ್ತೇನ ವಿನಿಶ್ಚಿತಂ ಯದ್ ದಿನಂ ತದ್ದಿನಾದ್ ಗಣಯಿತ್ವಾ ದ್ವಿತೀಯವತ್ಸರಂ ಪ್ರವಿಷ್ಟಾ ಯಾವನ್ತೋ ಬಾಲಕಾ ಅಸ್ಮಿನ್ ಬೈತ್ಲೇಹಮ್ನಗರೇ ತತ್ಸೀಮಮಧ್ಯೇ ಚಾಸನ್, ಲೋಕಾನ್ ಪ್ರಹಿತ್ಯ ತಾನ್ ಸರ್ವ್ವಾನ್ ಘಾತಯಾಮಾಸ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಅತಃ ಅನೇಕಸ್ಯ ವಿಲಾಪಸ್ಯ ನಿನಾದ: ಕ್ರನ್ದನಸ್ಯ ಚ| ಶೋಕೇನ ಕೃತಶಬ್ದಶ್ಚ ರಾಮಾಯಾಂ ಸಂನಿಶಮ್ಯತೇ| ಸ್ವಬಾಲಗಣಹೇತೋರ್ವೈ ರಾಹೇಲ್ ನಾರೀ ತು ರೋದಿನೀ| ನ ಮನ್ಯತೇ ಪ್ರಬೋಧನ್ತು ಯತಸ್ತೇ ನೈವ ಮನ್ತಿ ಹಿ||</para>
  <para style="p">
    <verse number="18" style="v"/>ಯದೇತದ್ ವಚನಂ ಯಿರೀಮಿಯನಾಮಕಭವಿಷ್ಯದ್ವಾದಿನಾ ಕಥಿತಂ ತತ್ ತದಾನೀಂ ಸಫಲಮ್ ಅಭೂತ್|</para>
  <para style="p">
    <verse number="19" style="v"/>ತದನನ್ತರಂ ಹೇರೇದಿ ರಾಜನಿ ಮೃತೇ ಪರಮೇಶ್ವರಸ್ಯ ದೂತೋ ಮಿಸರ್ದೇಶೇ ಸ್ವಪ್ನೇ ದರ್ಶನಂ ದತ್ತ್ವಾ ಯೂಷಫೇ ಕಥಿತವಾನ್</para>
  <para style="p">
    <verse number="20" style="v"/>ತ್ವಮ್ ಉತ್ಥಾಯ ಶಿಶುಂ ತನ್ಮಾತರಞ್ಚ ಗೃಹೀತ್ವಾ ಪುನರಪೀಸ್ರಾಯೇಲೋ ದೇಶಂ ಯಾಹೀ, ಯೇ ಜನಾಃ ಶಿಶುಂ ನಾಶಯಿತುಮ್ ಅಮೃಗಯನ್ತ, ತೇ ಮೃತವನ್ತಃ|</para>
  <para style="p">
    <verse number="21" style="v"/>ತದಾನೀಂ ಸ ಉತ್ಥಾಯ ಶಿಶುಂ ತನ್ಮಾತರಞ್ಚ ಗೃಹ್ಲನ್ ಇಸ್ರಾಯೇಲ್ದೇಶಮ್ ಆಜಗಾಮ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಕಿನ್ತು ಯಿಹೂದೀಯದೇಶೇ ಅರ್ಖಿಲಾಯನಾಮ ರಾಜಕುಮಾರೋ ನಿಜಪಿತು ರ್ಹೇರೋದಃ ಪದಂ ಪ್ರಾಪ್ಯ ರಾಜತ್ವಂ ಕರೋತೀತಿ ನಿಶಮ್ಯ ತತ್ ಸ್ಥಾನಂ ಯಾತುಂ ಶಙ್ಕಿತವಾನ್, ಪಶ್ಚಾತ್ ಸ್ವಪ್ನ ಈಶ್ವರಾತ್ ಪ್ರಬೋಧಂ ಪ್ರಾಪ್ಯ ಗಾಲೀಲ್ದೇಶಸ್ಯ ಪ್ರದೇಶೈಕಂ ಪ್ರಸ್ಥಾಯ ನಾಸರನ್ನಾಮ ನಗರಂ ಗತ್ವಾ ತತ್ರ ನ್ಯುಷಿತವಾನ್,</para>
  <para style="p">
    <verse number="23" style="v"/>ತೇನ ತಂ ನಾಸರತೀಯಂ ಕಥಯಿಷ್ಯನ್ತಿ, ಯದೇತದ್ವಾಕ್ಯಂ ಭವಿಷ್ಯದ್ವಾದಿಭಿರುಕ್ತ್ತಂ ತತ್ ಸಫಲಮಭವತ್|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ತದಾನೋಂ ಯೋಹ್ನ್ನಾಮಾ ಮಜ್ಜಯಿತಾ ಯಿಹೂದೀಯದೇಶಸ್ಯ ಪ್ರಾನ್ತರಮ್ ಉಪಸ್ಥಾಯ ಪ್ರಚಾರಯನ್ ಕಥಯಾಮಾಸ,</para>
  <para style="p">
    <verse number="2" style="v"/>ಮನಾಂಸಿ ಪರಾವರ್ತ್ತಯತ, ಸ್ವರ್ಗೀಯರಾಜತ್ವಂ ಸಮೀಪಮಾಗತಮ್|</para>
  <para style="p">
    <verse number="3" style="v"/>ಪರಮೇಶಸ್ಯ ಪನ್ಥಾನಂ ಪರಿಷ್ಕುರುತ ಸರ್ವ್ವತಃ| ತಸ್ಯ ರಾಜಪಥಾಂಶ್ಚೈವ ಸಮೀಕುರುತ ಸರ್ವ್ವಥಾ| ಇತ್ಯೇತತ್ ಪ್ರಾನ್ತರೇ ವಾಕ್ಯಂ ವದತಃ ಕಸ್ಯಚಿದ್ ರವಃ||</para>
  <para style="p">
    <verse number="4" style="v"/>ಏತದ್ವಚನಂ ಯಿಶಯಿಯಭವಿಷ್ಯದ್ವಾದಿನಾ ಯೋಹನಮುದ್ದಿಶ್ಯ ಭಾಷಿತಮ್| ಯೋಹನೋ ವಸನಂ ಮಹಾಙ್ಗರೋಮಜಂ ತಸ್ಯ ಕಟೌ ಚರ್ಮ್ಮಕಟಿಬನ್ಧನಂ; ಸ ಚ ಶೂಕಕೀಟಾನ್ ಮಧು ಚ ಭುಕ್ತವಾನ್|</para>
  <para style="p">
    <verse number="5" style="v"/>ತದಾನೀಂ ಯಿರೂಶಾಲಮ್ನಗರನಿವಾಸಿನಃ ಸರ್ವ್ವೇ ಯಿಹೂದಿದೇಶೀಯಾ ಯರ್ದ್ದನ್ತಟಿನ್ಯಾ ಉಭಯತಟಸ್ಥಾಶ್ಚ ಮಾನವಾ ಬಹಿರಾಗತ್ಯ ತಸ್ಯ ಸಮೀಪೇ</para>
  <para style="p">
    <verse number="6" style="v"/>ಸ್ವೀಯಂ ಸ್ವೀಯಂ ದುರಿತಮ್ ಅಙ್ಗೀಕೃತ್ಯ ತಸ್ಯಾಂ ಯರ್ದ್ದನಿ ತೇನ ಮಜ್ಜಿತಾ ಬಭೂವುಃ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅಪರಂ ಬಹೂನ್ ಫಿರೂಶಿನಃ ಸಿದೂಕಿನಶ್ಚ ಮನುಜಾನ್ ಮಂಕ್ತುಂ ಸ್ವಸಮೀಪಮ್ ಆಗಚ್ಛ್ತೋ ವಿಲೋಕ್ಯ ಸ ತಾನ್ ಅಭಿದಧೌ, ರೇ ರೇ ಭುಜಗವಂಶಾ ಆಗಾಮೀನಃ ಕೋಪಾತ್ ಪಲಾಯಿತುಂ ಯುಷ್ಮಾನ್ ಕಶ್ಚೇತಿತವಾನ್?</para>
  <para style="p">
    <verse number="8" style="v"/>ಮನಃಪರಾವರ್ತ್ತನಸ್ಯ ಸಮುಚಿತಂ ಫಲಂ ಫಲತ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಕಿನ್ತ್ವಸ್ಮಾಕಂ ತಾತ ಇಬ್ರಾಹೀಮ್ ಅಸ್ತೀತಿ ಸ್ವೇಷು ಮನಃಸು ಚೀನ್ತಯನ್ತೋ ಮಾ ವ್ಯಾಹರತ| ಯತೋ ಯುಷ್ಮಾನ್ ಅಹಂ ವದಾಮಿ, ಈಶ್ವರ ಏತೇಭ್ಯಃ ಪಾಷಾಣೇಭ್ಯ ಇಬ್ರಾಹೀಮಃ ಸನ್ತಾನಾನ್ ಉತ್ಪಾದಯಿತುಂ ಶಕ್ನೋತಿ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಅಪರಂ ಪಾದಪಾನಾಂ ಮೂಲೇ ಕುಠಾರ ಇದಾನೀಮಪಿ ಲಗನ್ ಆಸ್ತೇ, ತಸ್ಮಾದ್ ಯಸ್ಮಿನ್ ಪಾದಪೇ ಉತ್ತಮಂ ಫಲಂ ನ ಭವತಿ, ಸ ಕೃತ್ತೋ ಮಧ್ಯೇಽಗ್ನಿಂ ನಿಕ್ಷೇಪ್ಸ್ಯತೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅಪರಮ್ ಅಹಂ ಮನಃಪರಾವರ್ತ್ತನಸೂಚಕೇನ ಮಜ್ಜನೇನ ಯುಷ್ಮಾನ್ ಮಜ್ಜಯಾಮೀತಿ ಸತ್ಯಂ, ಕಿನ್ತು ಮಮ ಪಶ್ಚಾದ್ ಯ ಆಗಚ್ಛತಿ, ಸ ಮತ್ತೋಪಿ ಮಹಾನ್, ಅಹಂ ತದೀಯೋಪಾನಹೌ ವೋಢುಮಪಿ ನಹಿ ಯೋಗ್ಯೋಸ್ಮಿ, ಸ ಯುಷ್ಮಾನ್ ವಹ್ನಿರೂಪೇ ಪವಿತ್ರ ಆತ್ಮನಿ ಸಂಮಜ್ಜಯಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ತಸ್ಯ ಕಾರೇ ಸೂರ್ಪ ಆಸ್ತೇ, ಸ ಸ್ವೀಯಶಸ್ಯಾನಿ ಸಮ್ಯಕ್ ಪ್ರಸ್ಫೋಟ್ಯ ನಿಜಾನ್ ಸಕಲಗೋಧೂಮಾನ್ ಸಂಗೃಹ್ಯ ಭಾಣ್ಡಾಗಾರೇ ಸ್ಥಾಪಯಿಷ್ಯತಿ, ಕಿಂನ್ತು ಸರ್ವ್ವಾಣಿ ವುಷಾಣ್ಯನಿರ್ವ್ವಾಣವಹ್ನಿನಾ ದಾಹಯಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅನನ್ತರಂ ಯೀಶು ರ್ಯೋಹನಾ ಮಜ್ಜಿತೋ ಭವಿತುಂ ಗಾಲೀಲ್ಪ್ರದೇಶಾದ್ ಯರ್ದ್ದನಿ ತಸ್ಯ ಸಮೀಪಮ್ ಆಜಗಾಮ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಕಿನ್ತು ಯೋಹನ್ ತಂ ನಿಷಿಧ್ಯ ಬಭಾಷೇ, ತ್ವಂ ಕಿಂ ಮಮ ಸಮೀಪಮ್ ಆಗಚ್ಛಸಿ? ವರಂ ತ್ವಯಾ ಮಜ್ಜನಂ ಮಮ ಪ್ರಯೋಜನಮ್ ಆಸ್ತೇ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತದಾನೀಂ ಯೀಶುಃ ಪ್ರತ್ಯವೋಚತ್; ಈದಾನೀಮ್ ಅನುಮನ್ಯಸ್ವ, ಯತ ಇತ್ಥಂ ಸರ್ವ್ವಧರ್ಮ್ಮಸಾಧನಮ್ ಅಸ್ಮಾಕಂ ಕರ್ತ್ತವ್ಯಂ, ತತಃ ಸೋಽನ್ವಮನ್ಯತ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಅನನ್ತರಂ ಯೀಶುರಮ್ಮಸಿ ಮಜ್ಜಿತುಃ ಸನ್ ತತ್ಕ್ಷಣಾತ್ ತೋಯಮಧ್ಯಾದ್ ಉತ್ಥಾಯ ಜಗಾಮ, ತದಾ ಜೀಮೂತದ್ವಾರೇ ಮುಕ್ತೇ ಜಾತೇ, ಸ ಈಶ್ವರಸ್ಯಾತ್ಮಾನಂ ಕಪೋತವದ್ ಅವರುಹ್ಯ ಸ್ವೋಪರ್ಯ್ಯಾಗಚ್ಛನ್ತಂ ವೀಕ್ಷಾಞ್ಚಕ್ರೇ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಅಪರಮ್ ಏಷ ಮಮ ಪ್ರಿಯಃ ಪುತ್ರ ಏತಸ್ಮಿನ್ನೇವ ಮಮ ಮಹಾಸನ್ತೋಷ ಏತಾದೃಶೀ ವ್ಯೋಮಜಾ ವಾಗ್ ಬಭೂವ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ತತಃ ಪರಂ ಯೀಶುಃ ಪ್ರತಾರಕೇಣ ಪರೀಕ್ಷಿತೋ ಭವಿತುಮ್ ಆತ್ಮನಾ ಪ್ರಾನ್ತರಮ್ ಆಕೃಷ್ಟಃ</para>
  <para style="p">
    <verse number="2" style="v"/>ಸನ್ ಚತ್ವಾರಿಂಶದಹೋರಾತ್ರಾನ್ ಅನಾಹಾರಸ್ತಿಷ್ಠನ್ ಕ್ಷುಧಿತೋ ಬಭೂವ|</para>
  <para style="p">
    <verse number="3" style="v"/>ತದಾನೀಂ ಪರೀಕ್ಷಿತಾ ತತ್ಸಮೀಪಮ್ ಆಗತ್ಯ ವ್ಯಾಹೃತವಾನ್, ಯದಿ ತ್ವಮೀಶ್ವರಾತ್ಮಜೋ ಭವೇಸ್ತರ್ಹ್ಯಾಜ್ಞಯಾ ಪಾಷಾಣಾನೇತಾನ್ ಪೂಪಾನ್ ವಿಧೇಹಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ತತಃ ಸ ಪ್ರತ್ಯಬ್ರವೀತ್, ಇತ್ಥಂ ಲಿಖಿತಮಾಸ್ತೇ, "ಮನುಜಃ ಕೇವಲಪೂಪೇನ ನ ಜೀವಿಷ್ಯತಿ, ಕಿನ್ತ್ವೀಶ್ವರಸ್ಯ ವದನಾದ್ ಯಾನಿ ಯಾನಿ ವಚಾಂಸಿ ನಿಃಸರನ್ತಿ ತೈರೇವ ಜೀವಿಷ್ಯತಿ| "</para>
  <para style="p">
    <verse number="5" style="v"/>ತದಾ ಪ್ರತಾರಕಸ್ತಂ ಪುಣ್ಯನಗರಂ ನೀತ್ವಾ ಮನ್ದಿರಸ್ಯ ಚೂಡೋಪರಿ ನಿಧಾಯ ಗದಿತವಾನ್,</para>
  <para style="p">
    <verse number="6" style="v"/>ತ್ವಂ ಯದಿಶ್ವರಸ್ಯ ತನಯೋ ಭವೇಸ್ತರ್ಹೀತೋಽಧಃ ಪತ, ಯತ ಇತ್ಥಂ ಲಿಖಿತಮಾಸ್ತೇ, ಆದೇಕ್ಷ್ಯತಿ ನಿಜಾನ್ ದೂತಾನ್ ರಕ್ಷಿತುಂ ತ್ವಾಂ ಪರಮೇಶ್ವರಃ| ಯಥಾ ಸರ್ವ್ವೇಷು ಮಾರ್ಗೇಷು ತ್ವದೀಯಚರಣದ್ವಯೇ| ನ ಲಗೇತ್ ಪ್ರಸ್ತರಾಘಾತಸ್ತ್ವಾಂ ಘರಿಷ್ಯನ್ತಿ ತೇ ಕರೈಃ||</para>
  <para style="p">
    <verse number="7" style="v"/>ತದಾನೀಂ ಯೀಶುಸ್ತಸ್ಮೈ ಕಥಿತವಾನ್ ಏತದಪಿ ಲಿಖಿತಮಾಸ್ತೇ, "ತ್ವಂ ನಿಜಪ್ರಭುಂ ಪರಮೇಶ್ವರಂ ಮಾ ಪರೀಕ್ಷಸ್ವ| "</para>
  <para style="p">
    <verse number="8" style="v"/>ಅನನ್ತರಂ ಪ್ರತಾರಕಃ ಪುನರಪಿ ತಮ್ ಅತ್ಯುಞ್ಚಧರಾಧರೋಪರಿ ನೀತ್ವಾ ಜಗತಃ ಸಕಲರಾಜ್ಯಾನಿ ತದೈಶ್ವರ್ಯ್ಯಾಣಿ ಚ ದರ್ಶಯಾಶ್ಚಕಾರ ಕಥಯಾಞ್ಚಕಾರ ಚ,</para>
  <para style="p">
    <verse number="9" style="v"/>ಯದಿ ತ್ವಂ ದಣ್ಡವದ್ ಭವನ್ ಮಾಂ ಪ್ರಣಮೇಸ್ತರ್ಹ್ಯಹಮ್ ಏತಾನಿ ತುಭ್ಯಂ ಪ್ರದಾಸ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="10" style="v"/>ತದಾನೀಂ ಯೀಶುಸ್ತಮವೋಚತ್, ದೂರೀಭವ ಪ್ರತಾರಕ, ಲಿಖಿತಮಿದಮ್ ಆಸ್ತೇ, "ತ್ವಯಾ ನಿಜಃ ಪ್ರಭುಃ ಪರಮೇಶ್ವರಃ ಪ್ರಣಮ್ಯಃ ಕೇವಲಃ ಸ ಸೇವ್ಯಶ್ಚ| "</para>
  <para style="p">
    <verse number="11" style="v"/>ತತಃ ಪ್ರತಾರಕೇಣ ಸ ಪರ್ಯ್ಯತ್ಯಾಜಿ, ತದಾ ಸ್ವರ್ಗೀಯದೂತೈರಾಗತ್ಯ ಸ ಸಿಷೇವೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ತದನನ್ತರಂ ಯೋಹನ್ ಕಾರಾಯಾಂ ಬಬನ್ಧೇ, ತದ್ವಾರ್ತ್ತಾಂ ನಿಶಮ್ಯ ಯೀಶುನಾ ಗಾಲೀಲ್ ಪ್ರಾಸ್ಥೀಯತ|</para>
  <para style="p">
    <verse number="13" style="v"/>ತತಃ ಪರಂ ಸ ನಾಸರನ್ನಗರಂ ವಿಹಾಯ ಜಲಘೇಸ್ತಟೇ ಸಿಬೂಲೂನ್ನಪ್ತಾಲೀ ಏತಯೋರುವಭಯೋಃ ಪ್ರದೇಶಯೋಃ ಸೀಮ್ನೋರ್ಮಧ್ಯವರ್ತ್ತೀ ಯ: ಕಫರ್ನಾಹೂಮ್ ತನ್ನಗರಮ್ ಇತ್ವಾ ನ್ಯವಸತ್|</para>
  <para style="p">
    <verse number="14" style="v"/>ತಸ್ಮಾತ್, ಅನ್ಯಾದೇಶೀಯಗಾಲೀಲಿ ಯರ್ದ್ದನ್ಪಾರೇಽಬ್ಧಿರೋಧಸಿ| ನಪ್ತಾಲಿಸಿಬೂಲೂನ್ದೇಶೌ ಯತ್ರ ಸ್ಥಾನೇ ಸ್ಥಿತೌ ಪುರಾ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತತ್ರತ್ಯಾ ಮನುಜಾ ಯೇ ಯೇ ಪರ್ಯ್ಯಭ್ರಾಮ್ಯನ್ ತಮಿಸ್ರಕೇ| ತೈರ್ಜನೈರ್ಬೃಹದಾಲೋಕಃ ಪರಿದರ್ಶಿಷ್ಯತೇ ತದಾ| ಅವಸನ್ ಯೇ ಜನಾ ದೇಶೇ ಮೃತ್ಯುಚ್ಛಾಯಾಸ್ವರೂಪಕೇ| ತೇಷಾಮುಪರಿ ಲೋಕಾನಾಮಾಲೋಕಃ ಸಂಪ್ರಕಾಶಿತಃ||</para>
  <para style="p">
    <verse number="16" style="v"/>ಯದೇತದ್ವಚನಂ ಯಿಶಯಿಯಭವಿಷ್ಯದ್ವಾದಿನಾ ಪ್ರೋಕ್ತಂ, ತತ್ ತದಾ ಸಫಲಮ್ ಅಭೂತ್|</para>
  <para style="p">
    <verse number="17" style="v"/>ಅನನ್ತರಂ ಯೀಶುಃ ಸುಸಂವಾದಂ ಪ್ರಚಾರಯನ್ ಏತಾಂ ಕಥಾಂ ಕಥಯಿತುಮ್ ಆರೇಭೇ, ಮನಾಂಸಿ ಪರಾವರ್ತ್ತಯತ, ಸ್ವರ್ಗೀಯರಾಜತ್ವಂ ಸವಿಧಮಭವತ್|</para>
  <para style="p">
    <verse number="18" style="v"/>ತತಃ ಪರಂ ಯೀಶು ರ್ಗಾಲೀಲೋ ಜಲಧೇಸ್ತಟೇನ ಗಚ್ಛನ್ ಗಚ್ಛನ್ ಆನ್ದ್ರಿಯಸ್ತಸ್ಯ ಭ್ರಾತಾ ಶಿಮೋನ್ ಅರ್ಥತೋ ಯಂ ಪಿತರಂ ವದನ್ತಿ ಏತಾವುಭೌ ಜಲಘೌ ಜಾಲಂ ಕ್ಷಿಪನ್ತೌ ದದರ್ಶ, ಯತಸ್ತೌ ಮೀನಧಾರಿಣಾವಾಸ್ತಾಮ್|</para>
  <para style="p">
    <verse number="19" style="v"/>ತದಾ ಸ ತಾವಾಹೂಯ ವ್ಯಾಜಹಾರ, ಯುವಾಂ ಮಮ ಪಶ್ಚಾದ್ ಆಗಚ್ಛತಂ, ಯುವಾಮಹಂ ಮನುಜಧಾರಿಣೌ ಕರಿಷ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="20" style="v"/>ತೇನೈವ ತೌ ಜಾಲಂ ವಿಹಾಯ ತಸ್ಯ ಪಶ್ಚಾತ್ ಆಗಚ್ಛತಾಮ್|</para>
  <para style="p">
    <verse number="21" style="v"/>ಅನನ್ತರಂ ತಸ್ಮಾತ್ ಸ್ಥಾನಾತ್ ವ್ರಜನ್ ವ್ರಜನ್ ಸಿವದಿಯಸ್ಯ ಸುತೌ ಯಾಕೂಬ್ ಯೋಹನ್ನಾಮಾನೌ ದ್ವೌ ಸಹಜೌ ತಾತೇನ ಸಾರ್ದ್ಧಂ ನೌಕೋಪರಿ ಜಾಲಸ್ಯ ಜೀರ್ಣೋದ್ಧಾರಂ ಕುರ್ವ್ವನ್ತೌ ವೀಕ್ಷ್ಯ ತಾವಾಹೂತವಾನ್|</para>
  <para style="p">
    <verse number="22" style="v"/>ತತ್ಕ್ಷಣಾತ್ ತೌ ನಾವಂ ಸ್ವತಾತಞ್ಚ ವಿಹಾಯ ತಸ್ಯ ಪಶ್ಚಾದ್ಗಾಮಿನೌ ಬಭೂವತುಃ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಅನನ್ತರಂ ಭಜನಭವನೇ ಸಮುಪದಿಶನ್ ರಾಜ್ಯಸ್ಯ ಸುಸಂವಾದಂ ಪ್ರಚಾರಯನ್ ಮನುಜಾನಾಂ ಸರ್ವ್ವಪ್ರಕಾರಾನ್ ರೋಗಾನ್ ಸರ್ವ್ವಪ್ರಕಾರಪೀಡಾಶ್ಚ ಶಮಯನ್ ಯೀಶುಃ ಕೃತ್ಸ್ನಂ ಗಾಲೀಲ್ದೇಶಂ ಭ್ರಮಿತುಮ್ ಆರಭತ|</para>
  <para style="p">
    <verse number="24" style="v"/>ತೇನ ಕೃತ್ಸ್ನಸುರಿಯಾದೇಶಸ್ಯ ಮಧ್ಯಂ ತಸ್ಯ ಯಶೋ ವ್ಯಾಪ್ನೋತ್, ಅಪರಂ ಭೂತಗ್ರಸ್ತಾ ಅಪಸ್ಮಾರರ್ಗೀಣಃ ಪಕ್ಷಾಧಾತಿಪ್ರಭೃತಯಶ್ಚ ಯಾವನ್ತೋ ಮನುಜಾ ನಾನಾವಿಧವ್ಯಾಧಿಭಿಃ ಕ್ಲಿಷ್ಟಾ ಆಸನ್, ತೇಷು ಸರ್ವ್ವೇಷು ತಸ್ಯ ಸಮೀಪಮ್ ಆನೀತೇಷು ಸ ತಾನ್ ಸ್ವಸ್ಥಾನ್ ಚಕಾರ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಏತೇನ ಗಾಲೀಲ್-ದಿಕಾಪನಿ-ಯಿರೂಶಾಲಮ್-ಯಿಹೂದೀಯದೇಶೇಭ್ಯೋ ಯರ್ದ್ದನಃ ಪಾರಾಞ್ಚ ಬಹವೋ ಮನುಜಾಸ್ತಸ್ಯ ಪಶ್ಚಾದ್ ಆಗಚ್ಛನ್|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅನನ್ತರಂ ಸ ಜನನಿವಹಂ ನಿರೀಕ್ಷ್ಯ ಭೂಧರೋಪರಿ ವ್ರಜಿತ್ವಾ ಸಮುಪವಿವೇಶ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತದಾನೀಂ ಶಿಷ್ಯೇಷು ತಸ್ಯ ಸಮೀಪಮಾಗತೇಷು ತೇನ ತೇಭ್ಯ ಏಷಾ ಕಥಾ ಕಥ್ಯಾಞ್ಚಕ್ರೇ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅಭಿಮಾನಹೀನಾ ಜನಾ ಧನ್ಯಾಃ, ಯತಸ್ತೇ ಸ್ವರ್ಗೀಯರಾಜ್ಯಮ್ ಅಧಿಕರಿಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಖಿದ್ಯಮಾನಾ ಮನುಜಾ ಧನ್ಯಾಃ, ಯಸ್ಮಾತ್ ತೇ ಸಾನ್ತ್ವನಾಂ ಪ್ರಾಪ್ಸನ್ತಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ನಮ್ರಾ ಮಾನವಾಶ್ಚ ಧನ್ಯಾಃ, ಯಸ್ಮಾತ್ ತೇ ಮೇದಿನೀಮ್ ಅಧಿಕರಿಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಧರ್ಮ್ಮಾಯ ಬುಭುಕ್ಷಿತಾಃ ತೃಷಾರ್ತ್ತಾಶ್ಚ ಮನುಜಾ ಧನ್ಯಾಃ, ಯಸ್ಮಾತ್ ತೇ ಪರಿತರ್ಪ್ಸ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಕೃಪಾಲವೋ ಮಾನವಾ ಧನ್ಯಾಃ, ಯಸ್ಮಾತ್ ತೇ ಕೃಪಾಂ ಪ್ರಾಪ್ಸ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ನಿರ್ಮ್ಮಲಹೃದಯಾ ಮನುಜಾಶ್ಚ ಧನ್ಯಾಃ, ಯಸ್ಮಾತ್ ತ ಈಶ್ಚರಂ ದ್ರಕ್ಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಮೇಲಯಿತಾರೋ ಮಾನವಾ ಧನ್ಯಾಃ, ಯಸ್ಮಾತ್ ತ ಈಶ್ಚರಸ್ಯ ಸನ್ತಾನತ್ವೇನ ವಿಖ್ಯಾಸ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಧರ್ಮ್ಮಕಾರಣಾತ್ ತಾಡಿತಾ ಮನುಜಾ ಧನ್ಯಾ, ಯಸ್ಮಾತ್ ಸ್ವರ್ಗೀಯರಾಜ್ಯೇ ತೇಷಾಮಧಿಕರೋ ವಿದ್ಯತೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಯದಾ ಮನುಜಾ ಮಮ ನಾಮಕೃತೇ ಯುಷ್ಮಾನ್ ನಿನ್ದನ್ತಿ ತಾಡಯನ್ತಿ ಮೃಷಾ ನಾನಾದುರ್ವ್ವಾಕ್ಯಾನಿ ವದನ್ತಿ ಚ, ತದಾ ಯುಯಂ ಧನ್ಯಾಃ|</para>
  <para style="p">
    <verse number="12" style="v"/>ತದಾ ಆನನ್ದತ, ತಥಾ ಭೃಶಂ ಹ್ಲಾದಧ್ವಞ್ಚ, ಯತಃ ಸ್ವರ್ಗೇ ಭೂಯಾಂಸಿ ಫಲಾನಿ ಲಪ್ಸ್ಯಧ್ವೇ; ತೇ ಯುಷ್ಮಾಕಂ ಪುರಾತನಾನ್ ಭವಿಷ್ಯದ್ವಾದಿನೋಽಪಿ ತಾದೃಗ್ ಅತಾಡಯನ್|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯುಯಂ ಮೇದಿನ್ಯಾಂ ಲವಣರೂಪಾಃ, ಕಿನ್ತು ಯದಿ ಲವಣಸ್ಯ ಲವಣತ್ವಮ್ ಅಪಯಾತಿ, ತರ್ಹಿ ತತ್ ಕೇನ ಪ್ರಕಾರೇಣ ಸ್ವಾದುಯುಕ್ತಂ ಭವಿಷ್ಯತಿ? ತತ್ ಕಸ್ಯಾಪಿ ಕಾರ್ಯ್ಯಸ್ಯಾಯೋಗ್ಯತ್ವಾತ್ ಕೇವಲಂ ಬಹಿಃ ಪ್ರಕ್ಷೇಪ್ತುಂ ನರಾಣಾಂ ಪದತಲೇನ ದಲಯಿತುಞ್ಚ ಯೋಗ್ಯಂ ಭವತಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯೂಯಂ ಜಗತಿ ದೀಪ್ತಿರೂಪಾಃ, ಭೂಧರೋಪರಿ ಸ್ಥಿತಂ ನಗರಂ ಗುಪ್ತಂ ಭವಿತುಂ ನಹಿ ಶಕ್ಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅಪರಂ ಮನುಜಾಃ ಪ್ರದೀಪಾನ್ ಪ್ರಜ್ವಾಲ್ಯ ದ್ರೋಣಾಧೋ ನ ಸ್ಥಾಪಯನ್ತಿ, ಕಿನ್ತು ದೀಪಾಧಾರೋಪರ್ಯ್ಯೇವ ಸ್ಥಾಪಯನ್ತಿ, ತೇನ ತೇ ದೀಪಾ ಗೇಹಸ್ಥಿತಾನ್ ಸಕಲಾನ್ ಪ್ರಕಾಶಯನ್ತಿ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯೇನ ಮಾನವಾ ಯುಷ್ಮಾಕಂ ಸತ್ಕರ್ಮ್ಮಾಣಿ ವಿಲೋಕ್ಯ ಯುಷ್ಮಾಕಂ ಸ್ವರ್ಗಸ್ಥಂ ಪಿತರಂ ಧನ್ಯಂ ವದನ್ತಿ, ತೇಷಾಂ ಸಮಕ್ಷಂ ಯುಷ್ಮಾಕಂ ದೀಪ್ತಿಸ್ತಾದೃಕ್ ಪ್ರಕಾಶತಾಮ್|</para>
  <para style="p">
    <verse number="17" style="v"/>ಅಹಂ ವ್ಯವಸ್ಥಾಂ ಭವಿಷ್ಯದ್ವಾಕ್ಯಞ್ಚ ಲೋಪ್ತುಮ್ ಆಗತವಾನ್, ಇತ್ಥಂ ಮಾನುಭವತ, ತೇ ದ್ವೇ ಲೋಪ್ತುಂ ನಾಗತವಾನ್, ಕಿನ್ತು ಸಫಲೇ ಕರ್ತ್ತುಮ್ ಆಗತೋಸ್ಮಿ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಅಪರಂ ಯುಷ್ಮಾನ್ ಅಹಂ ತಥ್ಯಂ ವದಾಮಿ ಯಾವತ್ ವ್ಯೋಮಮೇದಿನ್ಯೋ ರ್ಧ್ವಂಸೋ ನ ಭವಿಷ್ಯತಿ, ತಾವತ್ ಸರ್ವ್ವಸ್ಮಿನ್ ಸಫಲೇ ನ ಜಾತೇ ವ್ಯವಸ್ಥಾಯಾ ಏಕಾ ಮಾತ್ರಾ ಬಿನ್ದುರೇಕೋಪಿ ವಾ ನ ಲೋಪ್ಸ್ಯತೇ|</para>
  <para style="p">
    <verse number="19" style="v"/>ತಸ್ಮಾತ್ ಯೋ ಜನ ಏತಾಸಾಮ್ ಆಜ್ಞಾನಾಮ್ ಅತಿಕ್ಷುದ್ರಾಮ್ ಏಕಾಜ್ಞಾಮಪೀ ಲಂಘತೇ ಮನುಜಾಂಞ್ಚ ತಥೈವ ಶಿಕ್ಷಯತಿ, ಸ ಸ್ವರ್ಗೀಯರಾಜ್ಯೇ ಸರ್ವ್ವೇಭ್ಯಃ ಕ್ಷುದ್ರತ್ವೇನ ವಿಖ್ಯಾಸ್ಯತೇ, ಕಿನ್ತು ಯೋ ಜನಸ್ತಾಂ ಪಾಲಯತಿ, ತಥೈವ ಶಿಕ್ಷಯತಿ ಚ, ಸ ಸ್ವರ್ಗೀಯರಾಜ್ಯೇ ಪ್ರಧಾನತ್ವೇನ ವಿಖ್ಯಾಸ್ಯತೇ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಅಪರಂ ಯುಷ್ಮಾನ್ ಅಹಂ ವದಾಮಿ, ಅಧ್ಯಾಪಕಫಿರೂಶಿಮಾನವಾನಾಂ ಧರ್ಮ್ಮಾನುಷ್ಠಾನಾತ್ ಯುಷ್ಮಾಕಂ ಧರ್ಮ್ಮಾನುಷ್ಠಾನೇ ನೋತ್ತಮೇ ಜಾತೇ ಯೂಯಮ್ ಈಶ್ವರೀಯರಾಜ್ಯಂ ಪ್ರವೇಷ್ಟುಂ ನ ಶಕ್ಷ್ಯಥ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಅಪರಞ್ಚ ತ್ವಂ ನರಂ ಮಾ ವಧೀಃ, ಯಸ್ಮಾತ್ ಯೋ ನರಂ ಹನ್ತಿ, ಸ ವಿಚಾರಸಭಾಯಾಂ ದಣ್ಡಾರ್ಹೋ ಭವಿಷ್ಯತಿ, ಪೂರ್ವ್ವಕಾಲೀನಜನೇಭ್ಯ ಇತಿ ಕಥಿತಮಾಸೀತ್, ಯುಷ್ಮಾಭಿರಶ್ರಾವಿ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಕಿನ್ತ್ವಹಂ ಯುಷ್ಮಾನ್ ವದಾಮಿ, ಯಃ ಕಶ್ಚಿತ್ ಕಾರಣಂ ವಿನಾ ನಿಜಭ್ರಾತ್ರೇ ಕುಪ್ಯತಿ, ಸ ವಿಚಾರಸಭಾಯಾಂ ದಣ್ಡಾರ್ಹೋ ಭವಿಷ್ಯತಿ; ಯಃ ಕಶ್ಚಿಚ್ಚ ಸ್ವೀಯಸಹಜಂ ನಿರ್ಬ್ಬೋಧಂ ವದತಿ, ಸ ಮಹಾಸಭಾಯಾಂ ದಣ್ಡಾರ್ಹೋ ಭವಿಷ್ಯತಿ; ಪುನಶ್ಚ ತ್ವಂ ಮೂಢ ಇತಿ ವಾಕ್ಯಂ ಯದಿ ಕಶ್ಚಿತ್ ಸ್ವೀಯಭ್ರಾತರಂ ವಕ್ತಿ, ತರ್ಹಿ ನರಕಾಗ್ನೌ ಸ ದಣ್ಡಾರ್ಹೋ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಅತೋ ವೇದ್ಯಾಃ ಸಮೀಪಂ ನಿಜನೈವೇದ್ಯೇ ಸಮಾನೀತೇಽಪಿ ನಿಜಭ್ರಾತರಂ ಪ್ರತಿ ಕಸ್ಮಾಚ್ಚಿತ್ ಕಾರಣಾತ್ ತ್ವಂ ಯದಿ ದೋಷೀ ವಿದ್ಯಸೇ, ತದಾನೀಂ ತವ ತಸ್ಯ ಸ್ಮೃತಿ ರ್ಜಾಯತೇ ಚ,</para>
  <para style="p">
    <verse number="24" style="v"/>ತರ್ಹಿ ತಸ್ಯಾ ವೇದ್ಯಾಃ ಸಮೀಪೇ ನಿಜನೈವೈದ್ಯಂ ನಿಧಾಯ ತದೈವ ಗತ್ವಾ ಪೂರ್ವ್ವಂ ತೇನ ಸಾರ್ದ್ಧಂ ಮಿಲ, ಪಶ್ಚಾತ್ ಆಗತ್ಯ ನಿಜನೈವೇದ್ಯಂ ನಿವೇದಯ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಅನ್ಯಞ್ಚ ಯಾವತ್ ವಿವಾದಿನಾ ಸಾರ್ದ್ಧಂ ವರ್ತ್ಮನಿ ತಿಷ್ಠಸಿ, ತಾವತ್ ತೇನ ಸಾರ್ದ್ಧಂ ಮೇಲನಂ ಕುರು; ನೋ ಚೇತ್ ವಿವಾದೀ ವಿಚಾರಯಿತುಃ ಸಮೀಪೇ ತ್ವಾಂ ಸಮರ್ಪಯತಿ ವಿಚಾರಯಿತಾ ಚ ರಕ್ಷಿಣಃ ಸನ್ನಿಧೌ ಸಮರ್ಪಯತಿ ತದಾ ತ್ವಂ ಕಾರಾಯಾಂ ಬಧ್ಯೇಥಾಃ|</para>
  <para style="p">
    <verse number="26" style="v"/>ತರ್ಹಿ ತ್ವಾಮಹಂ ತಥ್ಥಂ ಬ್ರವೀಮಿ, ಶೇಷಕಪರ್ದಕೇಽಪಿ ನ ಪರಿಶೋಧಿತೇ ತಸ್ಮಾತ್ ಸ್ಥಾನಾತ್ ಕದಾಪಿ ಬಹಿರಾಗನ್ತುಂ ನ ಶಕ್ಷ್ಯಸಿ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಅಪರಂ ತ್ವಂ ಮಾ ವ್ಯಭಿಚರ, ಯದೇತದ್ ವಚನಂ ಪೂರ್ವ್ವಕಾಲೀನಲೋಕೇಭ್ಯಃ ಕಥಿತಮಾಸೀತ್, ತದ್ ಯೂಯಂ ಶ್ರುತವನ್ತಃ;</para>
  <para style="p">
    <verse number="28" style="v"/>ಕಿನ್ತ್ವಹಂ ಯುಷ್ಮಾನ್ ವದಾಮಿ, ಯದಿ ಕಶ್ಚಿತ್ ಕಾಮತಃ ಕಾಞ್ಚನ ಯೋಷಿತಂ ಪಶ್ಯತಿ, ತರ್ಹಿ ಸ ಮನಸಾ ತದೈವ ವ್ಯಭಿಚರಿತವಾನ್|</para>
  <para style="p">
    <verse number="29" style="v"/>ತಸ್ಮಾತ್ ತವ ದಕ್ಷಿಣಂ ನೇತ್ರಂ ಯದಿ ತ್ವಾಂ ಬಾಧತೇ, ತರ್ಹಿ ತನ್ನೇತ್ರಮ್ ಉತ್ಪಾಟ್ಯ ದೂರೇ ನಿಕ್ಷಿಪ, ಯಸ್ಮಾತ್ ತವ ಸರ್ವ್ವವಪುಷೋ ನರಕೇ ನಿಕ್ಷೇಪಾತ್ ತವೈಕಾಙ್ಗಸ್ಯ ನಾಶೋ ವರಂ|</para>
  <para style="p">
    <verse number="30" style="v"/>ಯದ್ವಾ ತವ ದಕ್ಷಿಣಃ ಕರೋ ಯದಿ ತ್ವಾಂ ಬಾಧತೇ, ತರ್ಹಿ ತಂ ಕರಂ ಛಿತ್ತ್ವಾ ದೂರೇ ನಿಕ್ಷಿಪ, ಯತಃ ಸರ್ವ್ವವಪುಷೋ ನರಕೇ ನಿಕ್ಷೇಪಾತ್ ಏಕಾಙ್ಗಸ್ಯ ನಾಶೋ ವರಂ|</para>
  <para style="p">
    <verse number="31" style="v"/>ಉಕ್ತಮಾಸ್ತೇ, ಯದಿ ಕಶ್ಚಿನ್ ನಿಜಜಾಯಾಂ ಪರಿತ್ಯಕ್ತ್ತುಮ್ ಇಚ್ಛತಿ, ತರ್ಹಿ ಸ ತಸ್ಯೈ ತ್ಯಾಗಪತ್ರಂ ದದಾತು|</para>
  <para style="p">
    <verse number="32" style="v"/>ಕಿನ್ತ್ವಹಂ ಯುಷ್ಮಾನ್ ವ್ಯಾಹರಾಮಿ, ವ್ಯಭಿಚಾರದೋಷೇ ನ ಜಾತೇ ಯದಿ ಕಶ್ಚಿನ್ ನಿಜಜಾಯಾಂ ಪರಿತ್ಯಜತಿ, ತರ್ಹಿ ಸ ತಾಂ ವ್ಯಭಿಚಾರಯತಿ; ಯಶ್ಚ ತಾಂ ತ್ಯಕ್ತಾಂ ಸ್ತ್ರಿಯಂ ವಿವಹತಿ, ಸೋಪಿ ವ್ಯಭಿಚರತಿ|</para>
  <para style="p">
    <verse number="33" style="v"/>ಪುನಶ್ಚ ತ್ವಂ ಮೃಷಾ ಶಪಥಮ್ ನ ಕುರ್ವ್ವನ್ ಈಶ್ಚರಾಯ ನಿಜಶಪಥಂ ಪಾಲಯ, ಪೂರ್ವ್ವಕಾಲೀನಲೋಕೇಭ್ಯೋ ಯೈಷಾ ಕಥಾ ಕಥಿತಾ, ತಾಮಪಿ ಯೂಯಂ ಶ್ರುತವನ್ತಃ|</para>
  <para style="p">
    <verse number="34" style="v"/>ಕಿನ್ತ್ವಹಂ ಯುಷ್ಮಾನ್ ವದಾಮಿ, ಕಮಪಿ ಶಪಥಂ ಮಾ ಕಾರ್ಷ್ಟ, ಅರ್ಥತಃ ಸ್ವರ್ಗನಾಮ್ನಾ ನ, ಯತಃ ಸ ಈಶ್ವರಸ್ಯ ಸಿಂಹಾಸನಂ;</para>
  <para style="p">
    <verse number="35" style="v"/>ಪೃಥಿವ್ಯಾ ನಾಮ್ನಾಪಿ ನ, ಯತಃ ಸಾ ತಸ್ಯ ಪಾದಪೀಠಂ; ಯಿರೂಶಾಲಮೋ ನಾಮ್ನಾಪಿ ನ, ಯತಃ ಸಾ ಮಹಾರಾಜಸ್ಯ ಪುರೀ;</para>
  <para style="p">
    <verse number="36" style="v"/>ನಿಜಶಿರೋನಾಮ್ನಾಪಿ ನ, ಯಸ್ಮಾತ್ ತಸ್ಯೈಕಂ ಕಚಮಪಿ ಸಿತಮ್ ಅಸಿತಂ ವಾ ಕರ್ತ್ತುಂ ತ್ವಯಾ ನ ಶಕ್ಯತೇ|</para>
  <para style="p">
    <verse number="37" style="v"/>ಅಪರಂ ಯೂಯಂ ಸಂಲಾಪಸಮಯೇ ಕೇವಲಂ ಭವತೀತಿ ನ ಭವತೀತಿ ಚ ವದತ ಯತ ಇತೋಽಧಿಕಂ ಯತ್ ತತ್ ಪಾಪಾತ್ಮನೋ ಜಾಯತೇ|</para>
  <para style="p">
    <verse number="38" style="v"/>ಅಪರಂ ಲೋಚನಸ್ಯ ವಿನಿಮಯೇನ ಲೋಚನಂ ದನ್ತಸ್ಯ ವಿನಿಮಯೇನ ದನ್ತಃ ಪೂರ್ವ್ವಕ್ತಮಿದಂ ವಚನಞ್ಚ ಯುಷ್ಮಾಭಿರಶ್ರೂಯತ|</para>
  <para style="p">
    <verse number="39" style="v"/>ಕಿನ್ತ್ವಹಂ ಯುಷ್ಮಾನ್ ವದಾಮಿ ಯೂಯಂ ಹಿಂಸಕಂ ನರಂ ಮಾ ವ್ಯಾಘಾತಯತ| ಕಿನ್ತು ಕೇನಚಿತ್ ತವ ದಕ್ಷಿಣಕಪೋಲೇ ಚಪೇಟಾಘಾತೇ ಕೃತೇ ತಂ ಪ್ರತಿ ವಾಮಂ ಕಪೋಲಞ್ಚ ವ್ಯಾಘೋಟಯ|</para>
  <para style="p">
    <verse number="40" style="v"/>ಅಪರಂ ಕೇನಚಿತ್ ತ್ವಯಾ ಸಾರ್ಧ್ದಂ ವಿವಾದಂ ಕೃತ್ವಾ ತವ ಪರಿಧೇಯವಸನೇ ಜಿಘೃತಿತೇ ತಸ್ಮಾಯುತ್ತರೀಯವಸನಮಪಿ ದೇಹಿ|</para>
  <para style="p">
    <verse number="41" style="v"/>ಯದಿ ಕಶ್ಚಿತ್ ತ್ವಾಂ ಕ್ರೋಶಮೇಕಂ ನಯನಾರ್ಥಂ ಅನ್ಯಾಯತೋ ಧರತಿ, ತದಾ ತೇನ ಸಾರ್ಧ್ದಂ ಕ್ರೋಶದ್ವಯಂ ಯಾಹಿ|</para>
  <para style="p">
    <verse number="42" style="v"/>ಯಶ್ಚ ಮಾನವಸ್ತ್ವಾಂ ಯಾಚತೇ, ತಸ್ಮೈ ದೇಹಿ, ಯದಿ ಕಶ್ಚಿತ್ ತುಭ್ಯಂ ಧಾರಯಿತುಮ್ ಇಚ್ಛತಿ, ತರ್ಹಿ ತಂ ಪ್ರತಿ ಪರಾಂಮುಖೋ ಮಾ ಭೂಃ|</para>
  <para style="p">
    <verse number="43" style="v"/>ನಿಜಸಮೀಪವಸಿನಿ ಪ್ರೇಮ ಕುರು, ಕಿನ್ತು ಶತ್ರುಂ ಪ್ರತಿ ದ್ವೇಷಂ ಕುರು, ಯದೇತತ್ ಪುರೋಕ್ತಂ ವಚನಂ ಏತದಪಿ ಯೂಯಂ ಶ್ರುತವನ್ತಃ|</para>
  <para style="p">
    <verse number="44" style="v"/>ಕಿನ್ತ್ವಹಂ ಯುಷ್ಮಾನ್ ವದಾಮಿ, ಯೂಯಂ ರಿಪುವ್ವಪಿ ಪ್ರೇಮ ಕುರುತ, ಯೇ ಚ ಯುಷ್ಮಾನ್ ಶಪನ್ತೇ, ತಾನ, ಆಶಿಷಂ ವದತ, ಯೇ ಚ ಯುಷ್ಮಾನ್ ಋृತೀಯನ್ತೇ, ತೇಷಾಂ ಮಙ್ಗಲಂ ಕುರುತ, ಯೇ ಚ ಯುಷ್ಮಾನ್ ನಿನ್ದನ್ತಿ, ತಾಡಯನ್ತಿ ಚ, ತೇಷಾಂ ಕೃತೇ ಪ್ರಾರ್ಥಯಧ್ವಂ|</para>
  <para style="p">
    <verse number="45" style="v"/>ತತ್ರ ಯಃ ಸತಾಮಸತಾಞ್ಚೋಪರಿ ಪ್ರಭಾಕರಮ್ ಉದಾಯಯತಿ, ತಥಾ ಧಾರ್ಮ್ಮಿಕಾನಾಮಧಾರ್ಮ್ಮಿಕಾನಾಞ್ಚೋಪರಿ ನೀರಂ ವರ್ಷಯತಿ ತಾದೃಶೋ ಯೋ ಯುಷ್ಮಾಕಂ ಸ್ವರ್ಗಸ್ಥಃ ಪಿತಾ, ಯೂಯಂ ತಸ್ಯೈವ ಸನ್ತಾನಾ ಭವಿಷ್ಯಥ|</para>
  <para style="p">
    <verse number="46" style="v"/>ಯೇ ಯುಷ್ಮಾಸು ಪ್ರೇಮ ಕುರ್ವ್ವನ್ತಿ, ಯೂಯಂ ಯದಿ ಕೇವಲಂ ತೇವ್ವೇವ ಪ್ರೇಮ ಕುರುಥ, ತರ್ಹಿ ಯುಷ್ಮಾಕಂ ಕಿಂ ಫಲಂ ಭವಿಷ್ಯತಿ? ಚಣ್ಡಾಲಾ ಅಪಿ ತಾದೃಶಂ ಕಿಂ ನ ಕುರ್ವ್ವನ್ತಿ?</para>
  <para style="p">
    <verse number="47" style="v"/>ಅಪರಂ ಯೂಯಂ ಯದಿ ಕೇವಲಂ ಸ್ವೀಯಭ್ರಾತೃತ್ವೇನ ನಮತ, ತರ್ಹಿ ಕಿಂ ಮಹತ್ ಕರ್ಮ್ಮ ಕುರುಥ? ಚಣ್ಡಾಲಾ ಅಪಿ ತಾದೃಶಂ ಕಿಂ ನ ಕುರ್ವ್ವನ್ತಿ?</para>
  <para style="p">
    <verse number="48" style="v"/>ತಸ್ಮಾತ್ ಯುಷ್ಮಾಕಂ ಸ್ವರ್ಗಸ್ಥಃ ಪಿತಾ ಯಥಾ ಪೂರ್ಣೋ ಭವತಿ, ಯೂಯಮಪಿ ತಾದೃಶಾ ಭವತ|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಸಾವಧಾನಾ ಭವತ, ಮನುಜಾನ್ ದರ್ಶಯಿತುಂ ತೇಷಾಂ ಗೋಚರೇ ಧರ್ಮ್ಮಕರ್ಮ್ಮ ಮಾ ಕುರುತ, ತಥಾ ಕೃತೇ ಯುಷ್ಮಾಕಂ ಸ್ವರ್ಗಸ್ಥಪಿತುಃ ಸಕಾಶಾತ್ ಕಿಞ್ಚನ ಫಲಂ ನ ಪ್ರಾಪ್ಸ್ಯಥ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತ್ವಂ ಯದಾ ದದಾಸಿ ತದಾ ಕಪಟಿನೋ ಜನಾ ಯಥಾ ಮನುಜೇಭ್ಯಃ ಪ್ರಶಂಸಾಂ ಪ್ರಾಪ್ತುಂ ಭಜನಭವನೇ ರಾಜಮಾರ್ಗೇ ಚ ತೂರೀಂ ವಾದಯನ್ತಿ, ತಥಾ ಮಾ ಕುರಿु, ಅಹಂ ತುಭ್ಯಂ ಯಥಾರ್ಥಂ ಕಥಯಾಮಿ, ತೇ ಸ್ವಕಾಯಂ ಫಲಮ್ ಅಲಭನ್ತ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಕಿನ್ತು ತ್ವಂ ಯದಾ ದದಾಸಿ, ತದಾ ನಿಜದಕ್ಷಿಣಕರೋ ಯತ್ ಕರೋತಿ, ತದ್ ವಾಮಕರಂ ಮಾ ಜ್ಞಾಪಯ|</para>
  <para style="p">
    <verse number="4" style="v"/>ತೇನ ತವ ದಾನಂ ಗುಪ್ತಂ ಭವಿಷ್ಯತಿ ಯಸ್ತು ತವ ಪಿತಾ ಗುಪ್ತದರ್ಶೀ, ಸ ಪ್ರಕಾಶ್ಯ ತುಭ್ಯಂ ಫಲಂ ದಾಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಅಪರಂ ಯದಾ ಪ್ರಾರ್ಥಯಸೇ, ತದಾ ಕಪಟಿನಇವ ಮಾ ಕುರು, ಯಸ್ಮಾತ್ ತೇ ಭಜನಭವನೇ ರಾಜಮಾರ್ಗಸ್ಯ ಕೋಣೇ ತಿಷ್ಠನ್ತೋ ಲೋಕಾನ್ ದರ್ಶಯನ್ತಃ ಪ್ರಾರ್ಥಯಿತುಂ ಪ್ರೀಯನ್ತೇ; ಅಹಂ ಯುಷ್ಮಾನ್ ತಥ್ಯಂ ವದಾಮಿ, ತೇ ಸ್ವಕೀಯಫಲಂ ಪ್ರಾಪ್ನುವನ್|</para>
  <para style="p">
    <verse number="6" style="v"/>ತಸ್ಮಾತ್ ಪ್ರಾರ್ಥನಾಕಾಲೇ ಅನ್ತರಾಗಾರಂ ಪ್ರವಿಶ್ಯ ದ್ವಾರಂ ರುದ್ವ್ವಾ ಗುಪ್ತಂ ಪಶ್ಯತಸ್ತವ ಪಿತುಃ ಸಮೀಪೇ ಪ್ರಾರ್ಥಯಸ್ವ; ತೇನ ತವ ಯಃ ಪಿತಾ ಗುಪ್ತದರ್ಶೀ, ಸ ಪ್ರಕಾಶ್ಯ ತುಭ್ಯಂ ಫಲಂ ದಾಸ್ಯತಿl</para>
  <para style="p">
    <verse number="7" style="v"/>ಅಪರಂ ಪ್ರಾರ್ಥನಾಕಾಲೇ ದೇವಪೂಜಕಾಇವ ಮುಧಾ ಪುನರುಕ್ತಿಂ ಮಾ ಕುರು, ಯಸ್ಮಾತ್ ತೇ ಬೋಧನ್ತೇ, ಬಹುವಾರಂ ಕಥಾಯಾಂ ಕಥಿತಾಯಾಂ ತೇಷಾಂ ಪ್ರಾರ್ಥನಾ ಗ್ರಾಹಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಯೂಯಂ ತೇಷಾಮಿವ ಮಾ ಕುರುತ, ಯಸ್ಮಾತ್ ಯುಷ್ಮಾಕಂ ಯದ್ ಯತ್ ಪ್ರಯೋಜನಂ ಯಾಚನಾತಃ ಪ್ರಾಗೇವ ಯುಷ್ಮಾಕಂ ಪಿತಾ ತತ್ ಜಾನಾತಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಅತಏವ ಯೂಯಮ ಈದೃಕ್ ಪ್ರಾರ್ಥಯಧ್ವಂ, ಹೇ ಅಸ್ಮಾಕಂ ಸ್ವರ್ಗಸ್ಥಪಿತಃ, ತವ ನಾಮ ಪೂಜ್ಯಂ ಭವತು|</para>
  <para style="p">
    <verse number="10" style="v"/>ತವ ರಾಜತ್ವಂ ಭವತು; ತವೇಚ್ಛಾ ಸ್ವರ್ಗೇ ಯಥಾ ತಥೈವ ಮೇದಿನ್ಯಾಮಪಿ ಸಫಲಾ ಭವತು|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅಸ್ಮಾಕಂ ಪ್ರಯೋಜನೀಯಮ್ ಆಹಾರಮ್ ಅದ್ಯ ದೇಹಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ವಯಂ ಯಥಾ ನಿಜಾಪರಾಧಿನಃ ಕ್ಷಮಾಮಹೇ, ತಥೈವಾಸ್ಮಾಕಮ್ ಅಪರಾಧಾನ್ ಕ್ಷಮಸ್ವ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅಸ್ಮಾನ್ ಪರೀಕ್ಷಾಂ ಮಾನಯ, ಕಿನ್ತು ಪಾಪಾತ್ಮನೋ ರಕ್ಷ; ರಾಜತ್ವಂ ಗೌರವಂ ಪರಾಕ್ರಮಃ ಏತೇ ಸರ್ವ್ವೇ ಸರ್ವ್ವದಾ ತವ; ತಥಾಸ್ತು|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯದಿ ಯೂಯಮ್ ಅನ್ಯೇಷಾಮ್ ಅಪರಾಧಾನ್ ಕ್ಷಮಧ್ವೇ ತರ್ಹಿ ಯುಷ್ಮಾಕಂ ಸ್ವರ್ಗಸ್ಥಪಿತಾಪಿ ಯುಷ್ಮಾನ್ ಕ್ಷಮಿಷ್ಯತೇ;</para>
  <para style="p">
    <verse number="15" style="v"/>ಕಿನ್ತು ಯದಿ ಯೂಯಮ್ ಅನ್ಯೇಷಾಮ್ ಅಪರಾಧಾನ್ ನ ಕ್ಷಮಧ್ವೇ, ತರ್ಹಿ ಯುಷ್ಮಾಕಂ ಜನಕೋಪಿ ಯುಷ್ಮಾಕಮ್ ಅಪರಾಧಾನ್ ನ ಕ್ಷಮಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಅಪರಮ್ ಉಪವಾಸಕಾಲೇ ಕಪಟಿನೋ ಜನಾ ಮಾನುಷಾನ್ ಉಪವಾಸಂ ಜ್ಞಾಪಯಿತುಂ ಸ್ವೇಷಾಂ ವದನಾನಿ ಮ್ಲಾನಾನಿ ಕುರ್ವ್ವನ್ತಿ, ಯೂಯಂ ತಇವ ವಿಷಣವದನಾ ಮಾ ಭವತ; ಅಹಂ ಯುಷ್ಮಾನ್ ತಥ್ಯಂ ವದಾಮಿ ತೇ ಸ್ವಕೀಯಫಲಮ್ ಅಲಭನ್ತ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಯದಾ ತ್ವಮ್ ಉಪವಸಸಿ, ತದಾ ಯಥಾ ಲೋಕೈಸ್ತ್ವಂ ಉಪವಾಸೀವ ನ ದೃಶ್ಯಸೇ, ಕಿನ್ತು ತವ ಯೋಽಗೋಚರಃ ಪಿತಾ ತೇನೈವ ದೃಶ್ಯಸೇ, ತತ್ಕೃತೇ ನಿಜಶಿರಸಿ ತೈಲಂ ಮರ್ದ್ದಯ ವದನಞ್ಚ ಪ್ರಕ್ಷಾಲಯ;</para>
  <para style="p">
    <verse number="18" style="v"/>ತೇನ ತವ ಯಃ ಪಿತಾ ಗುಪ್ತದರ್ಶೀ ಸ ಪ್ರಕಾಶ್ಯ ತುಭ್ಯಂ ಫಲಂ ದಾಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಅಪರಂ ಯತ್ರ ಸ್ಥಾನೇ ಕೀಟಾಃ ಕಲಙ್ಕಾಶ್ಚ ಕ್ಷಯಂ ನಯನ್ತಿ, ಚೌರಾಶ್ಚ ಸನ್ಧಿಂ ಕರ್ತ್ತಯಿತ್ವಾ ಚೋರಯಿತುಂ ಶಕ್ನುವನ್ತಿ, ತಾದೃಶ್ಯಾಂ ಮೇದಿನ್ಯಾಂ ಸ್ವಾರ್ಥಂ ಧನಂ ಮಾ ಸಂಚಿನುತ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಕಿನ್ತು ಯತ್ರ ಸ್ಥಾನೇ ಕೀಟಾಃ ಕಲಙ್ಕಾಶ್ಚ ಕ್ಷಯಂ ನ ನಯನ್ತಿ, ಚೌರಾಶ್ಚ ಸನ್ಧಿಂ ಕರ್ತ್ತಯಿತ್ವಾ ಚೋರಯಿತುಂ ನ ಶಕ್ನುವನ್ತಿ, ತಾದೃಶೇ ಸ್ವರ್ಗೇ ಧನಂ ಸಞ್ಚಿನುತ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಯಸ್ಮಾತ್ ಯತ್ರ ಸ್ಥಾನೇ ಯುಷ್ಮಾಂಕ ಧನಂ ತತ್ರೈವ ಖಾನೇ ಯುಷ್ಮಾಕಂ ಮನಾಂಸಿ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಲೋಚನಂ ದೇಹಸ್ಯ ಪ್ರದೀಪಕಂ, ತಸ್ಮಾತ್ ಯದಿ ತವ ಲೋಚನಂ ಪ್ರಸನ್ನಂ ಭವತಿ, ತರ್ಹಿ ತವ ಕೃತ್ಸ್ನಂ ವಪು ರ್ದೀಪ್ತಿಯುಕ್ತಂ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಕಿನ್ತು ಲೋಚನೇಽಪ್ರಸನ್ನೇ ತವ ಕೃತ್ಸ್ನಂ ವಪುಃ ತಮಿಸ್ರಯುಕ್ತಂ ಭವಿಷ್ಯತಿ| ಅತಏವ ಯಾ ದೀಪ್ತಿಸ್ತ್ವಯಿ ವಿದ್ಯತೇ, ಸಾ ಯದಿ ತಮಿಸ್ರಯುಕ್ತಾ ಭವತಿ, ತರ್ಹಿ ತತ್ ತಮಿಸ್ರಂ ಕಿಯನ್ ಮಹತ್|</para>
  <para style="p">
    <verse number="24" style="v"/>ಕೋಪಿ ಮನುಜೋ ದ್ವೌ ಪ್ರಭೂ ಸೇವಿತುಂ ನ ಶಕ್ನೋತಿ, ಯಸ್ಮಾದ್ ಏಕಂ ಸಂಮನ್ಯ ತದನ್ಯಂ ನ ಸಮ್ಮನ್ಯತೇ, ಯದ್ವಾ ಏಕತ್ರ ಮನೋ ನಿಧಾಯ ತದನ್ಯಮ್ ಅವಮನ್ಯತೇ; ತಥಾ ಯೂಯಮಪೀಶ್ವರಂ ಲಕ್ಷ್ಮೀಞ್ಚೇತ್ಯುಭೇ ಸೇವಿತುಂ ನ ಶಕ್ನುಥ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಅಪರಮ್ ಅಹಂ ಯುಷ್ಮಭ್ಯಂ ತಥ್ಯಂ ಕಥಯಾಮಿ, ಕಿಂ ಭಕ್ಷಿಷ್ಯಾಮಃ? ಕಿಂ ಪಾಸ್ಯಾಮಃ? ಇತಿ ಪ್ರಾಣಧಾರಣಾಯ ಮಾ ಚಿನ್ತಯತ; ಕಿಂ ಪರಿಧಾಸ್ಯಾಮಃ? ಇತಿ ಕಾಯರಕ್ಷಣಾಯ ನ ಚಿನ್ತಯತ; ಭಕ್ಷ್ಯಾತ್ ಪ್ರಾಣಾ ವಸನಾಞ್ಚ ವಪೂಂಷಿ ಕಿಂ ಶ್ರೇಷ್ಠಾಣಿ ನ ಹಿ?</para>
  <para style="p">
    <verse number="26" style="v"/>ವಿಹಾಯಸೋ ವಿಹಙ್ಗಮಾನ್ ವಿಲೋಕಯತ; ತೈ ರ್ನೋಪ್ಯತೇ ನ ಕೃತ್ಯತೇ ಭಾಣ್ಡಾಗಾರೇ ನ ಸಞ್ಚೀಯತೇಽಪಿ; ತಥಾಪಿ ಯುಷ್ಮಾಕಂ ಸ್ವರ್ಗಸ್ಥಃ ಪಿತಾ ತೇಭ್ಯ ಆಹಾರಂ ವಿತರತಿ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಯೂಯಂ ತೇಭ್ಯಃ ಕಿಂ ಶ್ರೇಷ್ಠಾ ನ ಭವಥ? ಯುಷ್ಮಾಕಂ ಕಶ್ಚಿತ್ ಮನುಜಃ ಚಿನ್ತಯನ್ ನಿಜಾಯುಷಃ ಕ್ಷಣಮಪಿ ವರ್ದ್ಧಯಿತುಂ ಶಕ್ನೋತಿ?</para>
  <para style="p">
    <verse number="28" style="v"/>ಅಪರಂ ವಸನಾಯ ಕುತಶ್ಚಿನ್ತಯತ? ಕ್ಷೇತ್ರೋತ್ಪನ್ನಾನಿ ಪುಷ್ಪಾಣಿ ಕಥಂ ವರ್ದ್ಧನ್ತೇ ತದಾಲೋಚಯತ| ತಾನಿ ತನ್ತೂನ್ ನೋತ್ಪಾದಯನ್ತಿ ಕಿಮಪಿ ಕಾರ್ಯ್ಯಂ ನ ಕುರ್ವ್ವನ್ತಿ;</para>
  <para style="p">
    <verse number="29" style="v"/>ತಥಾಪ್ಯಹಂ ಯುಷ್ಮಾನ್ ವದಾಮಿ, ಸುಲೇಮಾನ್ ತಾದೃಗ್ ಐಶ್ವರ್ಯ್ಯವಾನಪಿ ತತ್ಪುಷ್ಪಮಿವ ವಿಭೂಷಿತೋ ನಾಸೀತ್|</para>
  <para style="p">
    <verse number="30" style="v"/>ತಸ್ಮಾತ್ ಕ್ಷದ್ಯ ವಿದ್ಯಮಾನಂ ಶ್ಚಃ ಚುಲ್ಲ್ಯಾಂ ನಿಕ್ಷೇಪ್ಸ್ಯತೇ ತಾದೃಶಂ ಯತ್ ಕ್ಷೇತ್ರಸ್ಥಿತಂ ಕುಸುಮಂ ತತ್ ಯದೀಶ್ಚರ ಇತ್ಥಂ ಬಿಭೂಷಯತಿ, ತರ್ಹಿ ಹೇ ಸ್ತೋಕಪ್ರತ್ಯಯಿನೋ ಯುಷ್ಮಾನ್ ಕಿಂ ನ ಪರಿಧಾಪಯಿಷ್ಯತಿ?</para>
  <para style="p">
    <verse number="31" style="v"/>ತಸ್ಮಾತ್ ಅಸ್ಮಾಭಿಃ ಕಿಮತ್ಸ್ಯತೇ? ಕಿಞ್ಚ ಪಾಯಿಷ್ಯತೇ? ಕಿಂ ವಾ ಪರಿಧಾಯಿಷ್ಯತೇ, ಇತಿ ನ ಚಿನ್ತಯತ|</para>
  <para style="p">
    <verse number="32" style="v"/>ಯಸ್ಮಾತ್ ದೇವಾರ್ಚ್ಚಕಾ ಅಪೀತಿ ಚೇಷ್ಟನ್ತೇ; ಏತೇಷು ದ್ರವ್ಯೇಷು ಪ್ರಯೋಜನಮಸ್ತೀತಿ ಯುಷ್ಮಾಕಂ ಸ್ವರ್ಗಸ್ಥಃ ಪಿತಾ ಜಾನಾತಿ|</para>
  <para style="p">
    <verse number="33" style="v"/>ಅತಏವ ಪ್ರಥಮತ ಈಶ್ವರೀಯರಾಜ್ಯಂ ಧರ್ಮ್ಮಞ್ಚ ಚೇಷ್ಟಧ್ವಂ, ತತ ಏತಾನಿ ವಸ್ತೂನಿ ಯುಷ್ಮಭ್ಯಂ ಪ್ರದಾಯಿಷ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="34" style="v"/>ಶ್ವಃ ಕೃತೇ ಮಾ ಚಿನ್ತಯತ, ಶ್ವಏವ ಸ್ವಯಂ ಸ್ವಮುದ್ದಿಶ್ಯ ಚಿನ್ತಯಿಷ್ಯತಿ; ಅದ್ಯತನೀ ಯಾ ಚಿನ್ತಾ ಸಾದ್ಯಕೃತೇ ಪ್ರಚುರತರಾ|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಯಥಾ ಯೂಯಂ ದೋಷೀಕೃತಾ ನ ಭವಥ, ತತ್ಕೃತೇಽನ್ಯಂ ದೋಷಿಣಂ ಮಾ ಕುರುತ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯತೋ ಯಾದೃಶೇನ ದೋಷೇಣ ಯೂಯಂ ಪರಾನ್ ದೋಷಿಣಃ ಕುರುಥ, ತಾದೃಶೇನ ದೋಷೇಣ ಯೂಯಮಪಿ ದೋಷೀಕೃತಾ ಭವಿಷ್ಯಥ, ಅನ್ಯಞ್ಚ ಯೇನ ಪರಿಮಾಣೇನ ಯುಷ್ಮಾಭಿಃ ಪರಿಮೀಯತೇ, ತೇನೈವ ಪರಿಮಾಣೇನ ಯುಷ್ಮತ್ಕೃತೇ ಪರಿಮಾಯಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅಪರಞ್ಚ ನಿಜನಯನೇ ಯಾ ನಾಸಾ ವಿದ್ಯತೇ, ತಾಮ್ ಅನಾಲೋಚ್ಯ ತವ ಸಹಜಸ್ಯ ಲೋಚನೇ ಯತ್ ತೃಣಮ್ ಆಸ್ತೇ, ತದೇವ ಕುತೋ ವೀಕ್ಷಸೇ?</para>
  <para style="p">
    <verse number="4" style="v"/>ತವ ನಿಜಲೋಚನೇ ನಾಸಾಯಾಂ ವಿದ್ಯಮಾನಾಯಾಂ, ಹೇ ಭ್ರಾತಃ, ತವ ನಯನಾತ್ ತೃಣಂ ಬಹಿಷ್ಯರ್ತುಂ ಅನುಜಾನೀಹಿ, ಕಥಾಮೇತಾಂ ನಿಜಸಹಜಾಯ ಕಥಂ ಕಥಯಿತುಂ ಶಕ್ನೋಷಿ?</para>
  <para style="p">
    <verse number="5" style="v"/>ಹೇ ಕಪಟಿನ್, ಆದೌ ನಿಜನಯನಾತ್ ನಾಸಾಂ ಬಹಿಷ್ಕುರು ತತೋ ನಿಜದೃಷ್ಟೌ ಸುಪ್ರಸನ್ನಾಯಾಂ ತವ ಭ್ರಾತೃ ರ್ಲೋಚನಾತ್ ತೃಣಂ ಬಹಿಷ್ಕರ್ತುಂ ಶಕ್ಷ್ಯಸಿ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅನ್ಯಞ್ಚ ಸಾರಮೇಯೇಭ್ಯಃ ಪವಿತ್ರವಸ್ತೂನಿ ಮಾ ವಿತರತ, ವರಾಹಾಣಾಂ ಸಮಕ್ಷಞ್ಚ ಮುಕ್ತಾ ಮಾ ನಿಕ್ಷಿಪತ; ನಿಕ್ಷೇಪಣಾತ್ ತೇ ತಾಃ ಸರ್ವ್ವಾಃ ಪದೈ ರ್ದಲಯಿಷ್ಯನ್ತಿ, ಪರಾವೃತ್ಯ ಯುಷ್ಮಾನಪಿ ವಿದಾರಯಿಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯಾಚಧ್ವಂ ತತೋ ಯುಷ್ಮಭ್ಯಂ ದಾಯಿಷ್ಯತೇ; ಮೃಗಯಧ್ವಂ ತತ ಉದ್ದೇಶಂ ಲಪ್ಸ್ಯಧ್ವೇ; ದ್ವಾರಮ್ ಆಹತ, ತತೋ ಯುಷ್ಮತ್ಕೃತೇ ಮುಕ್ತಂ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಯಸ್ಮಾದ್ ಯೇನ ಯಾಚ್ಯತೇ, ತೇನ ಲಭ್ಯತೇ; ಯೇನ ಮೃಗ್ಯತೇ ತೇನೋದ್ದೇಶಃ ಪ್ರಾಪ್ಯತೇ; ಯೇನ ಚ ದ್ವಾರಮ್ ಆಹನ್ಯತೇ, ತತ್ಕೃತೇ ದ್ವಾರಂ ಮೋಚ್ಯತೇ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಆತ್ಮಜೇನ ಪೂಪೇ ಪ್ರಾರ್ಥಿತೇ ತಸ್ಮೈ ಪಾಷಾಣಂ ವಿಶ್ರಾಣಯತಿ,</para>
  <para style="p">
    <verse number="10" style="v"/>ಮೀನೇ ಯಾಚಿತೇ ಚ ತಸ್ಮೈ ಭುಜಗಂ ವಿತರತಿ, ಏತಾದೃಶಃ ಪಿತಾ ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ಕ ಆಸ್ತೇ?</para>
  <para style="p">
    <verse number="11" style="v"/>ತಸ್ಮಾದ್ ಯೂಯಮ್ ಅಭದ್ರಾಃ ಸನ್ತೋಽಪಿ ಯದಿ ನಿಜಬಾಲಕೇಭ್ಯ ಉತ್ತಮಂ ದ್ರವ್ಯಂ ದಾತುಂ ಜಾನೀಥ, ತರ್ಹಿ ಯುಷ್ಮಾಕಂ ಸ್ವರ್ಗಸ್ಥಃ ಪಿತಾ ಸ್ವೀಯಯಾಚಕೇಭ್ಯಃ ಕಿಮುತ್ತಮಾನಿ ವಸ್ತೂನಿ ನ ದಾಸ್ಯತಿ?</para>
  <para style="p">
    <verse number="12" style="v"/>ಯೂಷ್ಮಾನ್ ಪ್ರತೀತರೇಷಾಂ ಯಾದೃಶೋ ವ್ಯವಹಾರೋ ಯುಷ್ಮಾಕಂ ಪ್ರಿಯಃ, ಯೂಯಂ ತಾನ್ ಪ್ರತಿ ತಾದೃಶಾನೇವ ವ್ಯವಹಾರಾನ್ ವಿಧತ್ತ; ಯಸ್ಮಾದ್ ವ್ಯವಸ್ಥಾಭವಿಷ್ಯದ್ವಾದಿನಾಂ ವಚನಾನಾಮ್ ಇತಿ ಸಾರಮ್|</para>
  <para style="p">
    <verse number="13" style="v"/>ಸಙ್ಕೀರ್ಣದ್ವಾರೇಣ ಪ್ರವಿಶತ; ಯತೋ ನರಕಗಮನಾಯ ಯದ್ ದ್ವಾರಂ ತದ್ ವಿಸ್ತೀರ್ಣಂ ಯಚ್ಚ ವರ್ತ್ಮ ತದ್ ಬೃಹತ್ ತೇನ ಬಹವಃ ಪ್ರವಿಶನ್ತಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಅಪರಂ ಸ್ವರ್ಗಗಮನಾಯ ಯದ್ ದ್ವಾರಂ ತತ್ ಕೀದೃಕ್ ಸಂಕೀರ್ಣಂ| ಯಚ್ಚ ವರ್ತ್ಮ ತತ್ ಕೀದೃಗ್ ದುರ್ಗಮಮ್| ತದುದ್ದೇಷ್ಟಾರಃ ಕಿಯನ್ತೋಽಲ್ಪಾಃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅಪರಞ್ಚ ಯೇ ಜನಾ ಮೇಷವೇಶೇನ ಯುಷ್ಮಾಕಂ ಸಮೀಪಮ್ ಆಗಚ್ಛನ್ತಿ, ಕಿನ್ತ್ವನ್ತರ್ದುರನ್ತಾ ವೃಕಾ ಏತಾದೃಶೇಭ್ಯೋ ಭವಿಷ್ಯದ್ವಾದಿಭ್ಯಃ ಸಾವಧಾನಾ ಭವತ, ಯೂಯಂ ಫಲೇನ ತಾನ್ ಪರಿಚೇತುಂ ಶಕ್ನುಥ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಮನುಜಾಃ ಕಿಂ ಕಣ್ಟಕಿನೋ ವೃಕ್ಷಾದ್ ದ್ರಾಕ್ಷಾಫಲಾನಿ ಶೃಗಾಲಕೋಲಿತಶ್ಚ ಉಡುಮ್ಬರಫಲಾನಿ ಶಾತಯನ್ತಿ?</para>
  <para style="p">
    <verse number="17" style="v"/>ತದ್ವದ್ ಉತ್ತಮ ಏವ ಪಾದಪ ಉತ್ತಮಫಲಾನಿ ಜನಯತಿ, ಅಧಮಪಾದಪಏವಾಧಮಫಲಾನಿ ಜನಯತಿ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಕಿನ್ತೂತ್ತಮಪಾದಪಃ ಕದಾಪ್ಯಧಮಫಲಾನಿ ಜನಯಿತುಂ ನ ಶಕ್ನೋತಿ, ತಥಾಧಮೋಪಿ ಪಾದಪ ಉತ್ತಮಫಲಾನಿ ಜನಯಿತುಂ ನ ಶಕ್ನೋತಿ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಅಪರಂ ಯೇ ಯೇ ಪಾದಪಾ ಅಧಮಫಲಾನಿ ಜನಯನ್ತಿ, ತೇ ಕೃತ್ತಾ ವಹ್ನೌ ಕ್ಷಿಪ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಅತಏವ ಯೂಯಂ ಫಲೇನ ತಾನ್ ಪರಿಚೇಷ್ಯಥ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಯೇ ಜನಾ ಮಾಂ ಪ್ರಭುಂ ವದನ್ತಿ, ತೇ ಸರ್ವ್ವೇ ಸ್ವರ್ಗರಾಜ್ಯಂ ಪ್ರವೇಕ್ಷ್ಯನ್ತಿ ತನ್ನ, ಕಿನ್ತು ಯೋ ಮಾನವೋ ಮಮ ಸ್ವರ್ಗಸ್ಥಸ್ಯ ಪಿತುರಿಷ್ಟಂ ಕರ್ಮ್ಮ ಕರೋತಿ ಸ ಏವ ಪ್ರವೇಕ್ಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="22" style="v"/>ತದ್ ದಿನೇ ಬಹವೋ ಮಾಂ ವದಿಷ್ಯನ್ತಿ, ಹೇ ಪ್ರಭೋ ಹೇ ಪ್ರಭೋ, ತವ ನಾಮ್ನಾ ಕಿಮಸ್ಮಾಮಿ ರ್ಭವಿಷ್ಯದ್ವಾಕ್ಯಂ ನ ವ್ಯಾಹೃತಂ? ತವ ನಾಮ್ನಾ ಭೂತಾಃ ಕಿಂ ನ ತ್ಯಾಜಿತಾಃ? ತವ ನಾಮ್ನಾ ಕಿಂ ನಾನಾದ್ಭುತಾನಿ ಕರ್ಮ್ಮಾಣಿ ನ ಕೃತಾನಿ?</para>
  <para style="p">
    <verse number="23" style="v"/>ತದಾಹಂ ವದಿಷ್ಯಾಮಿ, ಹೇ ಕುಕರ್ಮ್ಮಕಾರಿಣೋ ಯುಷ್ಮಾನ್ ಅಹಂ ನ ವೇದ್ಮಿ, ಯೂಯಂ ಮತ್ಸಮೀಪಾದ್ ದೂರೀಭವತ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಯಃ ಕಶ್ಚಿತ್ ಮಮೈತಾಃ ಕಥಾಃ ಶ್ರುತ್ವಾ ಪಾಲಯತಿ, ಸ ಪಾಷಾಣೋಪರಿ ಗೃಹನಿರ್ಮ್ಮಾತ್ರಾ ಜ್ಞಾನಿನಾ ಸಹ ಮಯೋಪಮೀಯತೇ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಯತೋ ವೃಷ್ಟೌ ಸತ್ಯಾಮ್ ಆಪ್ಲಾವ ಆಗತೇ ವಾಯೌ ವಾತೇ ಚ ತೇಷು ತದ್ಗೇಹಂ ಲಗ್ನೇಷು ಪಾಷಾಣೋಪರಿ ತಸ್ಯ ಭಿತ್ತೇಸ್ತನ್ನ ಪತತಿl</para>
  <para style="p">
    <verse number="26" style="v"/>ಕಿನ್ತು ಯಃ ಕಶ್ಚಿತ್ ಮಮೈತಾಃ ಕಥಾಃ ಶ್ರುತ್ವಾ ನ ಪಾಲಯತಿ ಸ ಸೈಕತೇ ಗೇಹನಿರ್ಮ್ಮಾತ್ರಾ ಽಜ್ಞಾನಿನಾ ಉಪಮೀಯತೇ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಯತೋ ಜಲವೃಷ್ಟೌ ಸತ್ಯಾಮ್ ಆಪ್ಲಾವ ಆಗತೇ ಪವನೇ ವಾತೇ ಚ ತೈ ರ್ಗೃಹೇ ಸಮಾಘಾತೇ ತತ್ ಪತತಿ ತತ್ಪತನಂ ಮಹದ್ ಭವತಿ|</para>
  <para style="p">
    <verse number="28" style="v"/>ಯೀಶುನೈತೇಷು ವಾಕ್ಯೇಷು ಸಮಾಪಿತೇಷು ಮಾನವಾಸ್ತದೀಯೋಪದೇಶಮ್ ಆಶ್ಚರ್ಯ್ಯಂ ಮೇನಿರೇ|</para>
  <para style="p">
    <verse number="29" style="v"/>ಯಸ್ಮಾತ್ ಸ ಉಪಾಧ್ಯಾಯಾ ಇವ ತಾನ್ ನೋಪದಿದೇಶ ಕಿನ್ತು ಸಮರ್ಥಪುರುಷಇವ ಸಮುಪದಿದೇಶ|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಯದಾ ಸ ಪರ್ವ್ವತಾದ್ ಅವಾರೋಹತ್ ತದಾ ಬಹವೋ ಮಾನವಾಸ್ತತ್ಪಶ್ಚಾದ್ ವವ್ರಜುಃ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಏಕಃ ಕುಷ್ಠವಾನ್ ಆಗತ್ಯ ತಂ ಪ್ರಣಮ್ಯ ಬಭಾಷೇ, ಹೇ ಪ್ರಭೋ, ಯದಿ ಭವಾನ್ ಸಂಮನ್ಯತೇ, ತರ್ಹಿ ಮಾಂ ನಿರಾಮಯಂ ಕರ್ತ್ತುಂ ಶಕ್ನೋತಿ|</para>
  <para style="p">
    <verse number="3" style="v"/>ತತೋ ಯೀಶುಃ ಕರಂ ಪ್ರಸಾರ್ಯ್ಯ ತಸ್ಯಾಙ್ಗಂ ಸ್ಪೃಶನ್ ವ್ಯಾಜಹಾರ, ಸಮ್ಮನ್ಯೇಽಹಂ ತ್ವಂ ನಿರಾಮಯೋ ಭವ; ತೇನ ಸ ತತ್ಕ್ಷಣಾತ್ ಕುಷ್ಠೇನಾಮೋಚಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ತತೋ ಯೀಶುಸ್ತಂ ಜಗಾದ, ಅವಧೇಹಿ ಕಥಾಮೇತಾಂ ಕಶ್ಚಿದಪಿ ಮಾ ಬ್ರೂಹಿ, ಕಿನ್ತು ಯಾಜಕಸ್ಯ ಸನ್ನಿಧಿಂ ಗತ್ವಾ ಸ್ವಾತ್ಮಾನಂ ದರ್ಶಯ ಮನುಜೇಭ್ಯೋ ನಿಜನಿರಾಮಯತ್ವಂ ಪ್ರಮಾಣಯಿತುಂ ಮೂಸಾನಿರೂಪಿತಂ ದ್ರವ್ಯಮ್ ಉತ್ಸೃಜ ಚ|</para>
  <para style="p">
    <verse number="5" style="v"/>ತದನನ್ತರಂ ಯೀಶುನಾ ಕಫರ್ನಾಹೂಮ್ನಾಮನಿ ನಗರೇ ಪ್ರವಿಷ್ಟೇ ಕಶ್ಚಿತ್ ಶತಸೇನಾಪತಿಸ್ತತ್ಸಮೀಪಮ್ ಆಗತ್ಯ ವಿನೀಯ ಬಭಾಷೇ,</para>
  <para style="p">
    <verse number="6" style="v"/>ಹೇ ಪ್ರಭೋ, ಮದೀಯ ಏಕೋ ದಾಸಃ ಪಕ್ಷಾಘಾತವ್ಯಾಧಿನಾ ಭೃಶಂ ವ್ಯಥಿತಃ, ಸತು ಶಯನೀಯ ಆಸ್ತೇ|</para>
  <para style="p">
    <verse number="7" style="v"/>ತದಾನೀಂ ಯೀಶುಸ್ತಸ್ಮೈ ಕಥಿತವಾನ್, ಅಹಂ ಗತ್ವಾ ತಂ ನಿರಾಮಯಂ ಕರಿಷ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ತತಃ ಸ ಶತಸೇನಾಪತಿಃ ಪ್ರತ್ಯವದತ್, ಹೇ ಪ್ರಭೋ, ಭವಾನ್ ಯತ್ ಮಮ ಗೇಹಮಧ್ಯಂ ಯಾತಿ ತದ್ಯೋಗ್ಯಭಾಜನಂ ನಾಹಮಸ್ಮಿ; ವಾಙ್ಮಾತ್ರಮ್ ಆದಿಶತು, ತೇನೈವ ಮಮ ದಾಸೋ ನಿರಾಮಯೋ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಯತೋ ಮಯಿ ಪರನಿಧ್ನೇಽಪಿ ಮಮ ನಿದೇಶವಶ್ಯಾಃ ಕತಿ ಕತಿ ಸೇನಾಃ ಸನ್ತಿ, ತತ ಏಕಸ್ಮಿನ್ ಯಾಹೀತ್ಯುಕ್ತೇ ಸ ಯಾತಿ, ತದನ್ಯಸ್ಮಿನ್ ಏಹೀತ್ಯುಕ್ತೇ ಸ ಆಯಾತಿ, ತಥಾ ಮಮ ನಿಜದಾಸೇ ಕರ್ಮ್ಮೈತತ್ ಕುರ್ವ್ವಿತ್ಯುಕ್ತೇ ಸ ತತ್ ಕರೋತಿ|</para>
  <para style="p">
    <verse number="10" style="v"/>ತದಾನೀಂ ಯೀಶುಸ್ತಸ್ಯೈತತ್ ವಚೋ ನಿಶಮ್ಯ ವಿಸ್ಮಯಾಪನ್ನೋಽಭೂತ್; ನಿಜಪಶ್ಚಾದ್ಗಾಮಿನೋ ಮಾನವಾನ್ ಅವೋಚ್ಚ, ಯುಷ್ಮಾನ್ ತಥ್ಯಂ ವಚ್ಮಿ, ಇಸ್ರಾಯೇಲೀಯಲೋಕಾನಾಂ ಮಧ್ಯೇಽಪಿ ನೈತಾದೃಶೋ ವಿಶ್ವಾಸೋ ಮಯಾ ಪ್ರಾಪ್ತಃ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅನ್ಯಚ್ಚಾಹಂ ಯುಷ್ಮಾನ್ ವದಾಮಿ, ಬಹವಃ ಪೂರ್ವ್ವಸ್ಯಾಃ ಪಶ್ಚಿಮಾಯಾಶ್ಚ ದಿಶ ಆಗತ್ಯ ಇಬ್ರಾಹೀಮಾ ಇಸ್ಹಾಕಾ ಯಾಕೂಬಾ ಚ ಸಾಕಮ್ ಮಿಲಿತ್ವಾ ಸಮುಪವೇಕ್ಷ್ಯನ್ತಿ;</para>
  <para style="p">
    <verse number="12" style="v"/>ಕಿನ್ತು ಯತ್ರ ಸ್ಥಾನೇ ರೋದನದನ್ತಘರ್ಷಣೇ ಭವತಸ್ತಸ್ಮಿನ್ ಬಹಿರ್ಭೂತತಮಿಸ್ರೇ ರಾಜ್ಯಸ್ಯ ಸನ್ತಾನಾ ನಿಕ್ಷೇಸ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ತತಃ ಪರಂ ಯೀಶುಸ್ತಂ ಶತಸೇನಾಪತಿಂ ಜಗಾದ, ಯಾಹಿ, ತವ ಪ್ರತೀತ್ಯನುಸಾರತೋ ಮಙ್ಗಲಂ ಭೂಯಾತ್; ತದಾ ತಸ್ಮಿನ್ನೇವ ದಣ್ಡೇ ತದೀಯದಾಸೋ ನಿರಾಮಯೋ ಬಭೂವ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಅನನ್ತರಂ ಯೀಶುಃ ಪಿತರಸ್ಯ ಗೇಹಮುಪಸ್ಥಾಯ ಜ್ವರೇಣ ಪೀಡಿತಾಂ ಶಯನೀಯಸ್ಥಿತಾಂ ತಸ್ಯ ಶ್ವಶ್ರೂಂ ವೀಕ್ಷಾಞ್ಚಕ್ರೇ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತತಸ್ತೇನ ತಸ್ಯಾಃ ಕರಸ್ಯ ಸ್ಪೃಷ್ಟತವಾತ್ ಜ್ವರಸ್ತಾಂ ತತ್ಯಾಜ, ತದಾ ಸಾ ಸಮುತ್ಥಾಯ ತಾನ್ ಸಿಷೇವೇ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಅನನ್ತರಂ ಸನ್ಧ್ಯಾಯಾಂ ಸತ್ಯಾಂ ಬಹುಶೋ ಭೂತಗ್ರಸ್ತಮನುಜಾನ್ ತಸ್ಯ ಸಮೀಪಮ್ ಆನಿನ್ಯುಃ ಸ ಚ ವಾಕ್ಯೇನ ಭೂತಾನ್ ತ್ಯಾಜಯಾಮಾಸ, ಸರ್ವ್ವಪ್ರಕಾರಪೀಡಿತಜನಾಂಶ್ಚ ನಿರಾಮಯಾನ್ ಚಕಾರ;</para>
  <para style="p">
    <verse number="17" style="v"/>ತಸ್ಮಾತ್, ಸರ್ವ್ವಾ ದುರ್ಬ್ಬಲತಾಸ್ಮಾಕಂ ತೇನೈವ ಪರಿಧಾರಿತಾ| ಅಸ್ಮಾಕಂ ಸಕಲಂ ವ್ಯಾಧಿಂ ಸಏವ ಸಂಗೃಹೀತವಾನ್| ಯದೇತದ್ವಚನಂ ಯಿಶಯಿಯಭವಿಷ್ಯದ್ವಾದಿನೋಕ್ತಮಾಸೀತ್, ತತ್ತದಾ ಸಫಲಮಭವತ್|</para>
  <para style="p">
    <verse number="18" style="v"/>ಅನನ್ತರಂ ಯೀಶುಶ್ಚತುರ್ದಿಕ್ಷು ಜನನಿವಹಂ ವಿಲೋಕ್ಯ ತಟಿನ್ಯಾಃ ಪಾರಂ ಯಾತುಂ ಶಿಷ್ಯಾನ್ ಆದಿದೇಶ|</para>
  <para style="p">
    <verse number="19" style="v"/>ತದಾನೀಮ್ ಏಕ ಉಪಾಧ್ಯಾಯ ಆಗತ್ಯ ಕಥಿತವಾನ್, ಹೇ ಗುರೋ, ಭವಾನ್ ಯತ್ರ ಯಾಸ್ಯತಿ ತತ್ರಾಹಮಪಿ ಭವತಃ ಪಶ್ಚಾದ್ ಯಾಸ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="20" style="v"/>ತತೋ ಯೀಶು ರ್ಜಗಾದ, ಕ್ರೋಷ್ಟುಃ ಸ್ಥಾತುಂ ಸ್ಥಾನಂ ವಿದ್ಯತೇ, ವಿಹಾಯಸೋ ವಿಹಙ್ಗಮಾನಾಂ ನೀಡಾನಿ ಚ ಸನ್ತಿ; ಕಿನ್ತು ಮನುಷ್ಯಪುತ್ರಸ್ಯ ಶಿರಃ ಸ್ಥಾಪಯಿತುಂ ಸ್ಥಾನಂ ನ ವಿದ್ಯತೇ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಅನನ್ತರಮ್ ಅಪರ ಏಕಃ ಶಿಷ್ಯಸ್ತಂ ಬಭಾಷೇ, ಹೇ ಪ್ರಭೋ, ಪ್ರಥಮತೋ ಮಮ ಪಿತರಂ ಶ್ಮಶಾನೇ ನಿಧಾತುಂ ಗಮನಾರ್ಥಂ ಮಾಮ್ ಅನುಮನ್ಯಸ್ವ|</para>
  <para style="p">
    <verse number="22" style="v"/>ತತೋ ಯೀಶುರುಕ್ತವಾನ್ ಮೃತಾ ಮೃತಾನ್ ಶ್ಮಶಾನೇ ನಿದಧತು, ತ್ವಂ ಮಮ ಪಶ್ಚಾದ್ ಆಗಚ್ಛ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಅನನ್ತರಂ ತಸ್ಮಿನ್ ನಾವಮಾರೂಢೇ ತಸ್ಯ ಶಿಷ್ಯಾಸ್ತತ್ಪಶ್ಚಾತ್ ಜಗ್ಮುಃ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಪಶ್ಚಾತ್ ಸಾಗರಸ್ಯ ಮಧ್ಯಂ ತೇಷು ಗತೇಷು ತಾದೃಶಃ ಪ್ರಬಲೋ ಝಞ್ಭ್ಶನಿಲ ಉದತಿಷ್ಠತ್, ಯೇನ ಮಹಾತರಙ್ಗ ಉತ್ಥಾಯ ತರಣಿಂ ಛಾದಿತವಾನ್, ಕಿನ್ತು ಸ ನಿದ್ರಿತ ಆಸೀತ್|</para>
  <para style="p">
    <verse number="25" style="v"/>ತದಾ ಶಿಷ್ಯಾ ಆಗತ್ಯ ತಸ್ಯ ನಿದ್ರಾಭಙ್ಗಂ ಕೃತ್ವಾ ಕಥಯಾಮಾಸುಃ, ಹೇ ಪ್ರಭೋ, ವಯಂ ಮ್ರಿಯಾಮಹೇ, ಭವಾನ್ ಅಸ್ಮಾಕಂ ಪ್ರಾಣಾನ್ ರಕ್ಷತು|</para>
  <para style="p">
    <verse number="26" style="v"/>ತದಾ ಸ ತಾನ್ ಉಕ್ತವಾನ್, ಹೇ ಅಲ್ಪವಿಶ್ವಾಸಿನೋ ಯೂಯಂ ಕುತೋ ವಿಭೀಥ? ತತಃ ಸ ಉತ್ಥಾಯ ವಾತಂ ಸಾಗರಞ್ಚ ತರ್ಜಯಾಮಾಸ, ತತೋ ನಿರ್ವ್ವಾತಮಭವತ್|</para>
  <para style="p">
    <verse number="27" style="v"/>ಅಪರಂ ಮನುಜಾ ವಿಸ್ಮಯಂ ವಿಲೋಕ್ಯ ಕಥಯಾಮಾಸುಃ, ಅಹೋ ವಾತಸರಿತ್ಪತೀ ಅಸ್ಯ ಕಿಮಾಜ್ಞಾಗ್ರಾಹಿಣೌ? ಕೀದೃಶೋಽಯಂ ಮಾನವಃ|</para>
  <para style="p">
    <verse number="28" style="v"/>ಅನನ್ತರಂ ಸ ಪಾರಂ ಗತ್ವಾ ಗಿದೇರೀಯದೇಶಮ್ ಉಪಸ್ಥಿತವಾನ್; ತದಾ ದ್ವೌ ಭೂತಗ್ರಸ್ತಮನುಜೌ ಶ್ಮಶಾನಸ್ಥಾನಾದ್ ಬಹಿ ರ್ಭೂತ್ವಾ ತಂ ಸಾಕ್ಷಾತ್ ಕೃತವನ್ತೌ, ತಾವೇತಾದೃಶೌ ಪ್ರಚಣ್ಡಾವಾಸ್ತಾಂ ಯತ್ ತೇನ ಸ್ಥಾನೇನ ಕೋಪಿ ಯಾತುಂ ನಾಶಕ್ನೋತ್|</para>
  <para style="p">
    <verse number="29" style="v"/>ತಾವುಚೈಃ ಕಥಯಾಮಾಸತುಃ, ಹೇ ಈಶ್ವರಸ್ಯ ಸೂನೋ ಯೀಶೋ, ತ್ವಯಾ ಸಾಕಮ್ ಆವಯೋಃ ಕಃ ಸಮ್ಬನ್ಧಃ? ನಿರೂಪಿತಕಾಲಾತ್ ಪ್ರಾಗೇವ ಕಿಮಾವಾಭ್ಯಾಂ ಯಾತನಾಂ ದಾತುಮ್ ಅತ್ರಾಗತೋಸಿ?</para>
  <para style="p">
    <verse number="30" style="v"/>ತದಾನೀಂ ತಾಭ್ಯಾಂ ಕಿಞ್ಚಿದ್ ದೂರೇ ವರಾಹಾಣಾಮ್ ಏಕೋ ಮಹಾವ್ರಜೋಽಚರತ್|</para>
  <para style="p">
    <verse number="31" style="v"/>ತತೋ ಭೂತೌ ತೌ ತಸ್ಯಾನ್ತಿಕೇ ವಿನೀಯ ಕಥಯಾಮಾಸತುಃ, ಯದ್ಯಾವಾಂ ತ್ಯಾಜಯಸಿ, ತರ್ಹಿ ವರಾಹಾಣಾಂ ಮಧ್ಯೇವ್ರಜಮ್ ಆವಾಂ ಪ್ರೇರಯ|</para>
  <para style="p">
    <verse number="32" style="v"/>ತದಾ ಯೀಶುರವದತ್ ಯಾತಂ, ಅನನ್ತರಂ ತೌ ಯದಾ ಮನುಜೌ ವಿಹಾಯ ವರಾಹಾನ್ ಆಶ್ರಿತವನ್ತೌ, ತದಾ ತೇ ಸರ್ವ್ವೇ ವರಾಹಾ ಉಚ್ಚಸ್ಥಾನಾತ್ ಮಹಾಜವೇನ ಧಾವನ್ತಃ ಸಾಗರೀಯತೋಯೇ ಮಜ್ಜನ್ತೋ ಮಮ್ರುಃ|</para>
  <para style="p">
    <verse number="33" style="v"/>ತತೋ ವರಾಹರಕ್ಷಕಾಃ ಪಲಾಯಮಾನಾ ಮಧ್ಯೇನಗರಂ ತೌ ಭೂತಗ್ರಸ್ತೌ ಪ್ರತಿ ಯದ್ಯದ್ ಅಘಟತ, ತಾಃ ಸರ್ವ್ವವಾರ್ತ್ತಾ ಅವದನ್|</para>
  <para style="p">
    <verse number="34" style="v"/>ತತೋ ನಾಗರಿಕಾಃ ಸರ್ವ್ವೇ ಮನುಜಾ ಯೀಶುಂ ಸಾಕ್ಷಾತ್ ಕರ್ತ್ತುಂ ಬಹಿರಾಯಾತಾಃ ತಞ್ಚ ವಿಲೋಕ್ಯ ಪ್ರಾರ್ಥಯಾಞ್ಚಕ್ರಿರೇ ಭವಾನ್ ಅಸ್ಮಾಕಂ ಸೀಮಾತೋ ಯಾತು|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅನನ್ತರಂ ಯೀಶು ರ್ನೌಕಾಮಾರುಹ್ಯ ಪುನಃ ಪಾರಮಾಗತ್ಯ ನಿಜಗ್ರಾಮಮ್ ಆಯಯೌ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತತಃ ಕತಿಪಯಾ ಜನಾ ಏಕಂ ಪಕ್ಷಾಘಾತಿನಂ ಸ್ವಟ್ಟೋಪರಿ ಶಾಯಯಿತ್ವಾ ತತ್ಸಮೀಪಮ್ ಆನಯನ್; ತತೋ ಯೀಶುಸ್ತೇಷಾಂ ಪ್ರತೀತಿಂ ವಿಜ್ಞಾಯ ತಂ ಪಕ್ಷಾಘಾತಿನಂ ಜಗಾದ, ಹೇ ಪುತ್ರ, ಸುಸ್ಥಿರೋ ಭವ, ತವ ಕಲುಷಸ್ಯ ಮರ್ಷಣಂ ಜಾತಮ್|</para>
  <para style="p">
    <verse number="3" style="v"/>ತಾಂ ಕಥಾಂ ನಿಶಮ್ಯ ಕಿಯನ್ತ ಉಪಾಧ್ಯಾಯಾ ಮನಃಸು ಚಿನ್ತಿತವನ್ತ ಏಷ ಮನುಜ ಈಶ್ವರಂ ನಿನ್ದತಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ತತಃ ಸ ತೇಷಾಮ್ ಏತಾದೃಶೀಂ ಚಿನ್ತಾಂ ವಿಜ್ಞಾಯ ಕಥಿತವಾನ್, ಯೂಯಂ ಮನಃಸು ಕೃತ ಏತಾದೃಶೀಂ ಕುಚಿನ್ತಾಂ ಕುರುಥ?</para>
  <para style="p">
    <verse number="5" style="v"/>ತವ ಪಾಪಮರ್ಷಣಂ ಜಾತಂ, ಯದ್ವಾ ತ್ವಮುತ್ಥಾಯ ಗಚ್ಛ, ದ್ವಯೋರನಯೋ ರ್ವಾಕ್ಯಯೋಃ ಕಿಂ ವಾಕ್ಯಂ ವಕ್ತುಂ ಸುಗಮಂ?</para>
  <para style="p">
    <verse number="6" style="v"/>ಕಿನ್ತು ಮೇದಿನ್ಯಾಂ ಕಲುಷಂ ಕ್ಷಮಿತುಂ ಮನುಜಸುತಸ್ಯ ಸಾಮರ್ಥ್ಯಮಸ್ತೀತಿ ಯೂಯಂ ಯಥಾ ಜಾನೀಥ, ತದರ್ಥಂ ಸ ತಂ ಪಕ್ಷಾಘಾತಿನಂ ಗದಿತವಾನ್, ಉತ್ತಿಷ್ಠ, ನಿಜಶಯನೀಯಂ ಆದಾಯ ಗೇಹಂ ಗಚ್ಛ|</para>
  <para style="p">
    <verse number="7" style="v"/>ತತಃ ಸ ತತ್ಕ್ಷಣಾದ್ ಉತ್ಥಾಯ ನಿಜಗೇಹಂ ಪ್ರಸ್ಥಿತವಾನ್|</para>
  <para style="p">
    <verse number="8" style="v"/>ಮಾನವಾ ಇತ್ಥಂ ವಿಲೋಕ್ಯ ವಿಸ್ಮಯಂ ಮೇನಿರೇ, ಈಶ್ವರೇಣ ಮಾನವಾಯ ಸಾಮರ್ಥ್ಯಮ್ ಈದೃಶಂ ದತ್ತಂ ಇತಿ ಕಾರಣಾತ್ ತಂ ಧನ್ಯಂ ಬಭಾಷಿರೇ ಚ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಅನನ್ತರಂ ಯೀಶುಸ್ತತ್ಸ್ಥಾನಾದ್ ಗಚ್ಛನ್ ಗಚ್ಛನ್ ಕರಸಂಗ್ರಹಸ್ಥಾನೇ ಸಮುಪವಿಷ್ಟಂ ಮಥಿನಾಮಾನಮ್ ಏಕಂ ಮನುಜಂ ವಿಲೋಕ್ಯ ತಂ ಬಭಾಷೇ, ಮಮ ಪಶ್ಚಾದ್ ಆಗಚ್ಛ, ತತಃ ಸ ಉತ್ಥಾಯ ತಸ್ಯ ಪಶ್ಚಾದ್ ವವ್ರಾಜ|</para>
  <para style="p">
    <verse number="10" style="v"/>ತತಃ ಪರಂ ಯೀಶೌ ಗೃಹೇ ಭೋಕ್ತುಮ್ ಉಪವಿಷ್ಟೇ ಬಹವಃ ಕರಸಂಗ್ರಾಹಿಣಃ ಕಲುಷಿಣಶ್ಚ ಮಾನವಾ ಆಗತ್ಯ ತೇನ ಸಾಕಂ ತಸ್ಯ ಶಿಷ್ಯೈಶ್ಚ ಸಾಕಮ್ ಉಪವಿವಿಶುಃ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಫಿರೂಶಿನಸ್ತದ್ ದೃಷ್ಟ್ವಾ ತಸ್ಯ ಶಿಷ್ಯಾನ್ ಬಭಾಷಿರೇ, ಯುಷ್ಮಾಕಂ ಗುರುಃ ಕಿಂ ನಿಮಿತ್ತಂ ಕರಸಂಗ್ರಾಹಿಭಿಃ ಕಲುಷಿಭಿಶ್ಚ ಸಾಕಂ ಭುಂಕ್ತೇ?</para>
  <para style="p">
    <verse number="12" style="v"/>ಯೀಶುಸ್ತತ್ ಶ್ರುತ್ವಾ ತಾನ್ ಪ್ರತ್ಯವದತ್, ನಿರಾಮಯಲೋಕಾನಾಂ ಚಿಕಿತ್ಸಕೇನ ಪ್ರಯೋಜನಂ ನಾಸ್ತಿ, ಕಿನ್ತು ಸಾಮಯಲೋಕಾನಾಂ ಪ್ರಯೋಜನಮಾಸ್ತೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅತೋ ಯೂಯಂ ಯಾತ್ವಾ ವಚನಸ್ಯಾಸ್ಯಾರ್ಥಂ ಶಿಕ್ಷಧ್ವಮ್, ದಯಾಯಾಂ ಮೇ ಯಥಾ ಪ್ರೀತಿ ರ್ನ ತಥಾ ಯಜ್ಞಕರ್ಮ್ಮಣಿ| ಯತೋಽಹಂ ಧಾರ್ಮ್ಮಿಕಾನ್ ಆಹ್ವಾತುಂ ನಾಗತೋಽಸ್ಮಿ ಕಿನ್ತು ಮನಃ ಪರಿವರ್ತ್ತಯಿತುಂ ಪಾಪಿನ ಆಹ್ವಾತುಮ್ ಆಗತೋಽಸ್ಮಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಅನನ್ತರಂ ಯೋಹನಃ ಶಿಷ್ಯಾಸ್ತಸ್ಯ ಸಮೀಪಮ್ ಆಗತ್ಯ ಕಥಯಾಮಾಸುಃ, ಫಿರೂಶಿನೋ ವಯಞ್ಚ ಪುನಃ ಪುನರುಪವಸಾಮಃ, ಕಿನ್ತು ತವ ಶಿಷ್ಯಾ ನೋಪವಸನ್ತಿ, ಕುತಃ?</para>
  <para style="p">
    <verse number="15" style="v"/>ತದಾ ಯೀಶುಸ್ತಾನ್ ಅವೋಚತ್ ಯಾವತ್ ಸಖೀನಾಂ ಸಂಙ್ಗೇ ಕನ್ಯಾಯಾ ವರಸ್ತಿಷ್ಠತಿ, ತಾವತ್ ಕಿಂ ತೇ ವಿಲಾಪಂ ಕರ್ತ್ತುಂ ಶಕ್ಲುವನ್ತಿ? ಕಿನ್ತು ಯದಾ ತೇಷಾಂ ಸಂಙ್ಗಾದ್ ವರಂ ನಯನ್ತಿ, ತಾದೃಶಃ ಸಮಯ ಆಗಮಿಷ್ಯತಿ, ತದಾ ತೇ ಉಪವತ್ಸ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಪುರಾತನವಸನೇ ಕೋಪಿ ನವೀನವಸ್ತ್ರಂ ನ ಯೋಜಯತಿ, ಯಸ್ಮಾತ್ ತೇನ ಯೋಜಿತೇನ ಪುರಾತನವಸನಂ ಛಿನತ್ತಿ ತಚ್ಛಿದ್ರಞ್ಚ ಬಹುಕುತ್ಸಿತಂ ದೃಶ್ಯತೇ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಅನ್ಯಞ್ಚ ಪುರಾತನಕುತ್ವಾಂ ಕೋಪಿ ನವಾನಗೋಸ್ತನೀರಸಂ ನ ನಿದಧಾತಿ, ಯಸ್ಮಾತ್ ತಥಾ ಕೃತೇ ಕುತೂ ರ್ವಿದೀರ್ಯ್ಯತೇ ತೇನ ಗೋಸ್ತನೀರಸಃ ಪತತಿ ಕುತೂಶ್ಚ ನಶ್ಯತಿ; ತಸ್ಮಾತ್ ನವೀನಾಯಾಂ ಕುತ್ವಾಂ ನವೀನೋ ಗೋಸ್ತನೀರಸಃ ಸ್ಥಾಪ್ಯತೇ, ತೇನ ದ್ವಯೋರವನಂ ಭವತಿ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಅಪರಂ ತೇನೈತತ್ಕಥಾಕಥನಕಾಲೇ ಏಕೋಽಧಿಪತಿಸ್ತಂ ಪ್ರಣಮ್ಯ ಬಭಾಷೇ, ಮಮ ದುಹಿತಾ ಪ್ರಾಯೇಣೈತಾವತ್ಕಾಲೇ ಮೃತಾ, ತಸ್ಮಾದ್ ಭವಾನಾಗತ್ಯ ತಸ್ಯಾ ಗಾತ್ರೇ ಹಸ್ತಮರ್ಪಯತು, ತೇನ ಸಾ ಜೀವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="19" style="v"/>ತದಾನೀಂ ಯೀಶುಃ ಶಿಷ್ಯೈಃ ಸಾಕಮ್ ಉತ್ಥಾಯ ತಸ್ಯ ಪಶ್ಚಾದ್ ವವ್ರಾಜ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಇತ್ಯನನ್ತರೇ ದ್ವಾದಶವತ್ಸರಾನ್ ಯಾವತ್ ಪ್ರದರಾಮಯೇನ ಶೀರ್ಣೈಕಾ ನಾರೀ ತಸ್ಯ ಪಶ್ಚಾದ್ ಆಗತ್ಯ ತಸ್ಯ ವಸನಸ್ಯ ಗ್ರನ್ಥಿಂ ಪಸ್ಪರ್ಶ;</para>
  <para style="p">
    <verse number="21" style="v"/>ಯಸ್ಮಾತ್ ಮಯಾ ಕೇವಲಂ ತಸ್ಯ ವಸನಂ ಸ್ಪೃಷ್ಟ್ವಾ ಸ್ವಾಸ್ಥ್ಯಂ ಪ್ರಾಪ್ಸ್ಯತೇ, ಸಾ ನಾರೀತಿ ಮನಸಿ ನಿಶ್ಚಿತವತೀ|</para>
  <para style="p">
    <verse number="22" style="v"/>ತತೋ ಯೀಶುರ್ವದನಂ ಪರಾವರ್ತ್ತ್ಯ ತಾಂ ಜಗಾದ, ಹೇ ಕನ್ಯೇ, ತ್ವಂ ಸುಸ್ಥಿರಾ ಭವ, ತವ ವಿಶ್ವಾಸಸ್ತ್ವಾಂ ಸ್ವಸ್ಥಾಮಕಾರ್ಷೀತ್| ಏತದ್ವಾಕ್ಯೇ ಗದಿತಏವ ಸಾ ಯೋಷಿತ್ ಸ್ವಸ್ಥಾಭೂತ್|</para>
  <para style="p">
    <verse number="23" style="v"/>ಅಪರಂ ಯೀಶುಸ್ತಸ್ಯಾಧ್ಯಕ್ಷಸ್ಯ ಗೇಹಂ ಗತ್ವಾ ವಾದಕಪ್ರಭೃತೀನ್ ಬಹೂನ್ ಲೋಕಾನ್ ಶಬ್ದಾಯಮಾನಾನ್ ವಿಲೋಕ್ಯ ತಾನ್ ಅವದತ್,</para>
  <para style="p">
    <verse number="24" style="v"/>ಪನ್ಥಾನಂ ತ್ಯಜ, ಕನ್ಯೇಯಂ ನಾಮ್ರಿಯತ ನಿದ್ರಿತಾಸ್ತೇ; ಕಥಾಮೇತಾಂ ಶ್ರುತ್ವಾ ತೇ ತಮುಪಜಹಸುಃ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಕಿನ್ತು ಸರ್ವ್ವೇಷು ಬಹಿಷ್ಕೃತೇಷು ಸೋಽಭ್ಯನ್ತರಂ ಗತ್ವಾ ಕನ್ಯಾಯಾಃ ಕರಂ ಧೃತವಾನ್, ತೇನ ಸೋದತಿಷ್ಠತ್;</para>
  <para style="p">
    <verse number="26" style="v"/>ತತಸ್ತತ್ಕರ್ಮ್ಮಣೋ ಯಶಃ ಕೃತ್ಸ್ನಂ ತಂ ದೇಶಂ ವ್ಯಾಪ್ತವತ್|</para>
  <para style="p">
    <verse number="27" style="v"/>ತತಃ ಪರಂ ಯೀಶುಸ್ತಸ್ಮಾತ್ ಸ್ಥಾನಾದ್ ಯಾತ್ರಾಂ ಚಕಾರ; ತದಾ ಹೇ ದಾಯೂದಃ ಸನ್ತಾನ, ಅಸ್ಮಾನ್ ದಯಸ್ವ, ಇತಿ ವದನ್ತೌ ದ್ವೌ ಜನಾವನ್ಧೌ ಪ್ರೋಚೈರಾಹೂಯನ್ತೌ ತತ್ಪಶ್ಚಾದ್ ವವ್ರಜತುಃ|</para>
  <para style="p">
    <verse number="28" style="v"/>ತತೋ ಯೀಶೌ ಗೇಹಮಧ್ಯಂ ಪ್ರವಿಷ್ಟಂ ತಾವಪಿ ತಸ್ಯ ಸಮೀಪಮ್ ಉಪಸ್ಥಿತವನ್ತೌ, ತದಾನೀಂ ಸ ತೌ ಪೃಷ್ಟವಾನ್ ಕರ್ಮ್ಮೈತತ್ ಕರ್ತ್ತುಂ ಮಮ ಸಾಮರ್ಥ್ಯಮ್ ಆಸ್ತೇ, ಯುವಾಂ ಕಿಮಿತಿ ಪ್ರತೀಥಃ? ತದಾ ತೌ ಪ್ರತ್ಯೂಚತುಃ, ಸತ್ಯಂ ಪ್ರಭೋ|</para>
  <para style="p">
    <verse number="29" style="v"/>ತದಾನೀಂ ಸ ತಯೋ ರ್ಲೋಚನಾನಿ ಸ್ಪೃಶನ್ ಬಭಾಷೇ, ಯುವಯೋಃ ಪ್ರತೀತ್ಯನುಸಾರಾದ್ ಯುವಯೋ ರ್ಮಙ್ಗಲಂ ಭೂಯಾತ್| ತೇನ ತತ್ಕ್ಷಣಾತ್ ತಯೋ ರ್ನೇತ್ರಾಣಿ ಪ್ರಸನ್ನಾನ್ಯಭವನ್,</para>
  <para style="p">
    <verse number="30" style="v"/>ಪಶ್ಚಾದ್ ಯೀಶುಸ್ತೌ ದೃಢಮಾಜ್ಞಾಪ್ಯ ಜಗಾದ, ಅವಧತ್ತಮ್ ಏತಾಂ ಕಥಾಂ ಕೋಪಿ ಮನುಜೋ ಮ ಜಾನೀಯಾತ್|</para>
  <para style="p">
    <verse number="31" style="v"/>ಕಿನ್ತು ತೌ ಪ್ರಸ್ಥಾಯ ತಸ್ಮಿನ್ ಕೃತ್ಸ್ನೇ ದೇಶೇ ತಸ್ಯ ಕೀರ್ತ್ತಿಂ ಪ್ರಕಾಶಯಾಮಾಸತುಃ|</para>
  <para style="p">
    <verse number="32" style="v"/>ಅಪರಂ ತೌ ಬಹಿರ್ಯಾತ ಏತಸ್ಮಿನ್ನನ್ತರೇ ಮನುಜಾ ಏಕಂ ಭೂತಗ್ರಸ್ತಮೂಕಂ ತಸ್ಯ ಸಮೀಪಮ್ ಆನೀತವನ್ತಃ|</para>
  <para style="p">
    <verse number="33" style="v"/>ತೇನ ಭೂತೇ ತ್ಯಾಜಿತೇ ಸ ಮೂಕಃ ಕಥಾಂ ಕಥಯಿತುಂ ಪ್ರಾರಭತ, ತೇನ ಜನಾ ವಿಸ್ಮಯಂ ವಿಜ್ಞಾಯ ಕಥಯಾಮಾಸುಃ, ಇಸ್ರಾಯೇಲೋ ವಂಶೇ ಕದಾಪಿ ನೇದೃಗದೃಶ್ಯತ;</para>
  <para style="p">
    <verse number="34" style="v"/>ಕಿನ್ತು ಫಿರೂಶಿನಃ ಕಥಯಾಞ್ಚಕ್ರುಃ ಭೂತಾಧಿಪತಿನಾ ಸ ಭೂತಾನ್ ತ್ಯಾಜಯತಿ|</para>
  <para style="p">
    <verse number="35" style="v"/>ತತಃ ಪರಂ ಯೀಶುಸ್ತೇಷಾಂ ಭಜನಭವನ ಉಪದಿಶನ್ ರಾಜ್ಯಸ್ಯ ಸುಸಂವಾದಂ ಪ್ರಚಾರಯನ್ ಲೋಕಾನಾಂ ಯಸ್ಯ ಯ ಆಮಯೋ ಯಾ ಚ ಪೀಡಾಸೀತ್, ತಾನ್ ಶಮಯನ್ ಶಮಯಂಶ್ಚ ಸರ್ವ್ವಾಣಿ ನಗರಾಣಿ ಗ್ರಾಮಾಂಶ್ಚ ಬಭ್ರಾಮ|</para>
  <para style="p">
    <verse number="36" style="v"/>ಅನ್ಯಞ್ಚ ಮನುಜಾನ್ ವ್ಯಾಕುಲಾನ್ ಅರಕ್ಷಕಮೇಷಾನಿವ ಚ ತ್ಯಕ್ತಾನ್ ನಿರೀಕ್ಷ್ಯ ತೇಷು ಕಾರುಣಿಕಃ ಸನ್ ಶಿಷ್ಯಾನ್ ಅವದತ್,</para>
  <para style="p">
    <verse number="37" style="v"/>ಶಸ್ಯಾನಿ ಪ್ರಚುರಾಣಿ ಸನ್ತಿ, ಕಿನ್ತು ಛೇತ್ತಾರಃ ಸ್ತೋಕಾಃ|</para>
  <para style="p">
    <verse number="38" style="v"/>ಕ್ಷೇತ್ರಂ ಪ್ರತ್ಯಪರಾನ್ ಛೇದಕಾನ್ ಪ್ರಹೇತುಂ ಶಸ್ಯಸ್ವಾಮಿನಂ ಪ್ರಾರ್ಥಯಧ್ವಮ್|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅನನ್ತರಂ ಯೀಶು ರ್ದ್ವಾದಶಶಿಷ್ಯಾನ್ ಆಹೂಯಾಮೇಧ್ಯಭೂತಾನ್ ತ್ಯಾಜಯಿತುಂ ಸರ್ವ್ವಪ್ರಕಾರರೋಗಾನ್ ಪೀಡಾಶ್ಚ ಶಮಯಿತುಂ ತೇಭ್ಯಃ ಸಾಮರ್ಥ್ಯಮದಾತ್|</para>
  <para style="p">
    <verse number="2" style="v"/>ತೇಷಾಂ ದ್ವಾದಶಪ್ರೇಷ್ಯಾಣಾಂ ನಾಮಾನ್ಯೇತಾನಿ| ಪ್ರಥಮಂ ಶಿಮೋನ್ ಯಂ ಪಿತರಂ ವದನ್ತಿ, ತತಃ ಪರಂ ತಸ್ಯ ಸಹಜ ಆನ್ದ್ರಿಯಃ, ಸಿವದಿಯಸ್ಯ ಪುತ್ರೋ ಯಾಕೂಬ್</para>
  <para style="p">
    <verse number="3" style="v"/>ತಸ್ಯ ಸಹಜೋ ಯೋಹನ್; ಫಿಲಿಪ್ ಬರ್ಥಲಮಯ್ ಥೋಮಾಃ ಕರಸಂಗ್ರಾಹೀ ಮಥಿಃ, ಆಲ್ಫೇಯಪುತ್ರೋ ಯಾಕೂಬ್,</para>
  <para style="p">
    <verse number="4" style="v"/>ಕಿನಾನೀಯಃ ಶಿಮೋನ್, ಯ ಈಷ್ಕರಿಯೋತೀಯಯಿಹೂದಾಃ ಖ್ರೀಷ್ಟಂ ಪರಕರೇಽರ್ಪಯತ್|</para>
  <para style="p">
    <verse number="5" style="v"/>ಏತಾನ್ ದ್ವಾದಶಶಿಷ್ಯಾನ್ ಯೀಶುಃ ಪ್ರೇಷಯನ್ ಇತ್ಯಾಜ್ಞಾಪಯತ್, ಯೂಯಮ್ ಅನ್ಯದೇಶೀಯಾನಾಂ ಪದವೀಂ ಶೇಮಿರೋಣೀಯಾನಾಂ ಕಿಮಪಿ ನಗರಞ್ಚ ನ ಪ್ರವಿಶ್ಯೇ</para>
  <para style="p">
    <verse number="6" style="v"/>ಇಸ್ರಾಯೇಲ್ಗೋತ್ರಸ್ಯ ಹಾರಿತಾ ಯೇ ಯೇ ಮೇಷಾಸ್ತೇಷಾಮೇವ ಸಮೀಪಂ ಯಾತ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಗತ್ವಾ ಗತ್ವಾ ಸ್ವರ್ಗಸ್ಯ ರಾಜತ್ವಂ ಸವಿಧಮಭವತ್, ಏತಾಂ ಕಥಾಂ ಪ್ರಚಾರಯತ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಆಮಯಗ್ರಸ್ತಾನ್ ಸ್ವಸ್ಥಾನ್ ಕುರುತ, ಕುಷ್ಠಿನಃ ಪರಿಷ್ಕುರುತ, ಮೃತಲೋಕಾನ್ ಜೀವಯತ, ಭೂತಾನ್ ತ್ಯಾಜಯತ, ವಿನಾ ಮೂಲ್ಯಂ ಯೂಯಮ್ ಅಲಭಧ್ವಂ ವಿನೈವ ಮೂಲ್ಯಂ ವಿಶ್ರಾಣಯತ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಕಿನ್ತು ಸ್ವೇಷಾಂ ಕಟಿಬನ್ಧೇಷು ಸ್ವರ್ಣರೂಪ್ಯತಾಮ್ರಾಣಾಂ ಕಿಮಪಿ ನ ಗೃಹ್ಲೀತ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಅನ್ಯಚ್ಚ ಯಾತ್ರಾಯೈ ಚೇಲಸಮ್ಪುಟಂ ವಾ ದ್ವಿತೀಯವಸನಂ ವಾ ಪಾದುಕೇ ವಾ ಯಷ್ಟಿಃ, ಏತಾನ್ ಮಾ ಗೃಹ್ಲೀತ, ಯತಃ ಕಾರ್ಯ್ಯಕೃತ್ ಭರ್ತ್ತುಂ ಯೋಗ್ಯೋ ಭವತಿ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅಪರಂ ಯೂಯಂ ಯತ್ ಪುರಂ ಯಞ್ಚ ಗ್ರಾಮಂ ಪ್ರವಿಶಥ, ತತ್ರ ಯೋ ಜನೋ ಯೋಗ್ಯಪಾತ್ರಂ ತಮವಗತ್ಯ ಯಾನಕಾಲಂ ಯಾವತ್ ತತ್ರ ತಿಷ್ಠತ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯದಾ ಯೂಯಂ ತದ್ಗೇಹಂ ಪ್ರವಿಶಥ, ತದಾ ತಮಾಶಿಷಂ ವದತ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯದಿ ಸ ಯೋಗ್ಯಪಾತ್ರಂ ಭವತಿ, ತರ್ಹಿ ತತ್ಕಲ್ಯಾಣಂ ತಸ್ಮೈ ಭವಿಷ್ಯತಿ, ನೋಚೇತ್ ಸಾಶೀರ್ಯುಷ್ಮಭ್ಯಮೇವ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಕಿನ್ತು ಯೇ ಜನಾ ಯುಷ್ಮಾಕಮಾತಿಥ್ಯಂ ನ ವಿದಧತಿ ಯುಷ್ಮಾಕಂ ಕಥಾಞ್ಚ ನ ಶೃಣ್ವನ್ತಿ ತೇಷಾಂ ಗೇಹಾತ್ ಪುರಾದ್ವಾ ಪ್ರಸ್ಥಾನಕಾಲೇ ಸ್ವಪದೂಲೀಃ ಪಾತಯತ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಯುಷ್ಮಾನಹಂ ತಥ್ಯಂ ವಚ್ಮಿ ವಿಚಾರದಿನೇ ತತ್ಪುರಸ್ಯ ದಶಾತಃ ಸಿದೋಮಮೋರಾಪುರಯೋರ್ದಶಾ ಸಹ್ಯತರಾ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಪಶ್ಯತ, ವೃಕಯೂಥಮಧ್ಯೇ ಮೇಷಃ ಯಥಾವಿಸ್ತಥಾ ಯುಷ್ಮಾನ ಪ್ರಹಿಣೋಮಿ, ತಸ್ಮಾದ್ ಯೂಯಮ್ ಅಹಿರಿವ ಸತರ್ಕಾಃ ಕಪೋತಾಇವಾಹಿಂಸಕಾ ಭವತ|</para>
  <para style="p">
    <verse number="17" style="v"/>ನೃಭ್ಯಃ ಸಾವಧಾನಾ ಭವತ; ಯತಸ್ತೈ ರ್ಯೂಯಂ ರಾಜಸಂಸದಿ ಸಮರ್ಪಿಷ್ಯಧ್ವೇ ತೇಷಾಂ ಭಜನಗೇಹೇ ಪ್ರಹಾರಿಷ್ಯಧ್ವೇ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಯೂಯಂ ಮನ್ನಾಮಹೇತೋಃ ಶಾಸ್ತೃಣಾಂ ರಾಜ್ಞಾಞ್ಚ ಸಮಕ್ಷಂ ತಾನನ್ಯದೇಶಿನಶ್ಚಾಧಿ ಸಾಕ್ಷಿತ್ವಾರ್ಥಮಾನೇಷ್ಯಧ್ವೇ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಕಿನ್ತ್ವಿತ್ಥಂ ಸಮರ್ಪಿತಾ ಯೂಯಂ ಕಥಂ ಕಿಮುತ್ತರಂ ವಕ್ಷ್ಯಥ ತತ್ರ ಮಾ ಚಿನ್ತಯತ, ಯತಸ್ತದಾ ಯುಷ್ಮಾಭಿ ರ್ಯದ್ ವಕ್ತವ್ಯಂ ತತ್ ತದ್ದಣ್ಡೇ ಯುಷ್ಮನ್ಮನಃ ಸು ಸಮುಪಸ್ಥಾಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಯಸ್ಮಾತ್ ತದಾ ಯೋ ವಕ್ಷ್ಯತಿ ಸ ನ ಯೂಯಂ ಕಿನ್ತು ಯುಷ್ಮಾಕಮನ್ತರಸ್ಥಃ ಪಿತ್ರಾತ್ಮಾ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಸಹಜಃ ಸಹಜಂ ತಾತಃ ಸುತಞ್ಚ ಮೃತೌ ಸಮರ್ಪಯಿಷ್ಯತಿ, ಅಪತ್ಯಾಗಿ ಸ್ವಸ್ವಪಿತ್ರೋे ರ್ವಿಪಕ್ಷೀಭೂಯ ತೌ ಘಾತಯಿಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಮನ್ನಮಹೇತೋಃ ಸರ್ವ್ವೇ ಜನಾ ಯುಷ್ಮಾನ್ ಋृತೀಯಿಷ್ಯನ್ತೇ, ಕಿನ್ತು ಯಃ ಶೇಷಂ ಯಾವದ್ ಧೈರ್ಯ್ಯಂ ಘೃತ್ವಾ ಸ್ಥಾಸ್ಯತಿ, ಸ ತ್ರಾಯಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="23" style="v"/>ತೈ ರ್ಯದಾ ಯೂಯಮೇಕಪುರೇ ತಾಡಿಷ್ಯಧ್ವೇ, ತದಾ ಯೂಯಮನ್ಯಪುರಂ ಪಲಾಯಧ್ವಂ ಯುಷ್ಮಾನಹಂ ತಥ್ಯಂ ವಚ್ಮಿ ಯಾವನ್ಮನುಜಸುತೋ ನೈತಿ ತಾವದ್ ಇಸ್ರಾಯೇಲ್ದೇಶೀಯಸರ್ವ್ವನಗರಭ್ರಮಣಂ ಸಮಾಪಯಿತುಂ ನ ಶಕ್ಷ್ಯಥ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಗುರೋಃ ಶಿಷ್ಯೋ ನ ಮಹಾನ್, ಪ್ರಭೋರ್ದಾಸೋ ನ ಮಹಾನ್|</para>
  <para style="p">
    <verse number="25" style="v"/>ಯದಿ ಶಿಷ್ಯೋ ನಿಜಗುರೋ ರ್ದಾಸಶ್ಚ ಸ್ವಪ್ರಭೋಃ ಸಮಾನೋ ಭವತಿ ತರ್ಹಿ ತದ್ ಯಥೇಷ್ಟಂ| ಚೇತ್ತೈರ್ಗೃಹಪತಿರ್ಭೂತರಾಜ ಉಚ್ಯತೇ, ತರ್ಹಿ ಪರಿವಾರಾಃ ಕಿಂ ತಥಾ ನ ವಕ್ಷ್ಯನ್ತೇ?</para>
  <para style="p">
    <verse number="26" style="v"/>ಕಿನ್ತು ತೇಭ್ಯೋ ಯೂಯಂ ಮಾ ಬಿಭೀತ, ಯತೋ ಯನ್ನ ಪ್ರಕಾಶಿಷ್ಯತೇ, ತಾದೃಕ್ ಛಾದಿತಂ ಕಿಮಪಿ ನಾಸ್ತಿ, ಯಚ್ಚ ನ ವ್ಯಞ್ಚಿಷ್ಯತೇ, ತಾದೃಗ್ ಗುಪ್ತಂ ಕಿಮಪಿ ನಾಸ್ತಿ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಯದಹಂ ಯುಷ್ಮಾನ್ ತಮಸಿ ವಚ್ಮಿ ತದ್ ಯುಷ್ಮಾಭಿರ್ದೀಪ್ತೌ ಕಥ್ಯತಾಂ; ಕರ್ಣಾಭ್ಯಾಂ ಯತ್ ಶ್ರೂಯತೇ ತದ್ ಗೇಹೋಪರಿ ಪ್ರಚಾರ್ಯ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="28" style="v"/>ಯೇ ಕಾಯಂ ಹನ್ತುಂ ಶಕ್ನುವನ್ತಿ ನಾತ್ಮಾನಂ, ತೇಭ್ಯೋ ಮಾ ಭೈಷ್ಟ; ಯಃ ಕಾಯಾತ್ಮಾನೌ ನಿರಯೇ ನಾಶಯಿತುಂ, ಶಕ್ನೋತಿ, ತತೋ ಬಿಭೀತ|</para>
  <para style="p">
    <verse number="29" style="v"/>ದ್ವೌ ಚಟಕೌ ಕಿಮೇಕತಾಮ್ರಮುದ್ರಯಾ ನ ವಿಕ್ರೀಯೇತೇ? ತಥಾಪಿ ಯುಷ್ಮತ್ತಾತಾನುಮತಿಂ ವಿನಾ ತೇಷಾಮೇಕೋಪಿ ಭುವಿ ನ ಪತತಿ|</para>
  <para style="p">
    <verse number="30" style="v"/>ಯುಷ್ಮಚ್ಛಿರಸಾಂ ಸರ್ವ್ವಕಚಾ ಗಣಿತಾಂಃ ಸನ್ತಿ|</para>
  <para style="p">
    <verse number="31" style="v"/>ಅತೋ ಮಾ ಬಿಭೀತ, ಯೂಯಂ ಬಹುಚಟಕೇಭ್ಯೋ ಬಹುಮೂಲ್ಯಾಃ|</para>
  <para style="p">
    <verse number="32" style="v"/>ಯೋ ಮನುಜಸಾಕ್ಷಾನ್ಮಾಮಙ್ಗೀಕುರುತೇ ತಮಹಂ ಸ್ವರ್ಗಸ್ಥತಾತಸಾಕ್ಷಾದಙ್ಗೀಕರಿಷ್ಯೇ|</para>
  <para style="p">
    <verse number="33" style="v"/>ಪೃಥ್ವ್ಯಾಮಹಂ ಶಾನ್ತಿಂ ದಾತುಮಾಗತಇತಿ ಮಾನುಭವತ, ಶಾನ್ತಿಂ ದಾತುಂ ನ ಕಿನ್ತ್ವಸಿಂ|</para>
  <para style="p">
    <verse number="34" style="v"/>ಪಿತೃಮಾತೃಶ್ಚಶ್ರೂಭಿಃ ಸಾಕಂ ಸುತಸುತಾಬಧೂ ರ್ವಿರೋಧಯಿತುಞ್ಚಾಗತೇाಸ್ಮಿ|</para>
  <para style="p">
    <verse number="35" style="v"/>ತತಃ ಸ್ವಸ್ವಪರಿವಾರಏವ ನೃಶತ್ರು ರ್ಭವಿತಾ|</para>
  <para style="p">
    <verse number="36" style="v"/>ಯಃ ಪಿತರಿ ಮಾತರಿ ವಾ ಮತ್ತೋಧಿಕಂ ಪ್ರೀಯತೇ, ಸ ನ ಮದರ್ಹಃ;</para>
  <para style="p">
    <verse number="37" style="v"/>ಯಶ್ಚ ಸುತೇ ಸುತಾಯಾಂ ವಾ ಮತ್ತೋಧಿಕಂ ಪ್ರೀಯತೇ, ಸೇाಪಿ ನ ಮದರ್ಹಃ|</para>
  <para style="p">
    <verse number="38" style="v"/>ಯಃ ಸ್ವಕ್ರುಶಂ ಗೃಹ್ಲನ್ ಮತ್ಪಶ್ಚಾನ್ನೈತಿ, ಸೇाಪಿ ನ ಮದರ್ಹಃ|</para>
  <para style="p">
    <verse number="39" style="v"/>ಯಃ ಸ್ವಪ್ರಾಣಾನವತಿ, ಸ ತಾನ್ ಹಾರಯಿಷ್ಯತೇ, ಯಸ್ತು ಮತ್ಕೃತೇ ಸ್ವಪ್ರಾಣಾನ್ ಹಾರಯತಿ, ಸ ತಾನವತಿ|</para>
  <para style="p">
    <verse number="40" style="v"/>ಯೋ ಯುಷ್ಮಾಕಮಾತಿಥ್ಯಂ ವಿದಧಾತಿ, ಸ ಮಮಾತಿಥ್ಯಂ ವಿದಧಾತಿ, ಯಶ್ಚ ಮಮಾತಿಥ್ಯಂ ವಿದಧಾತಿ, ಸ ಮತ್ಪ್ರೇರಕಸ್ಯಾತಿಥ್ಯಂ ವಿದಧಾತಿ|</para>
  <para style="p">
    <verse number="41" style="v"/>ಯೋ ಭವಿಷ್ಯದ್ವಾದೀತಿ ಜ್ಞಾತ್ವಾ ತಸ್ಯಾತಿಥ್ಯಂ ವಿಧತ್ತೇ, ಸ ಭವಿಷ್ಯದ್ವಾದಿನಃ ಫಲಂ ಲಪ್ಸ್ಯತೇ, ಯಶ್ಚ ಧಾರ್ಮ್ಮಿಕ ಇತಿ ವಿದಿತ್ವಾ ತಸ್ಯಾತಿಥ್ಯಂ ವಿಧತ್ತೇ ಸ ಧಾರ್ಮ್ಮಿಕಮಾನವಸ್ಯ ಫಲಂ ಪ್ರಾಪ್ಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="42" style="v"/>ಯಶ್ಚ ಕಶ್ಚಿತ್ ಏತೇಷಾಂ ಕ್ಷುದ್ರನರಾಣಾಮ್ ಯಂ ಕಞ್ಚನೈಕಂ ಶಿಷ್ಯ ಇತಿ ವಿದಿತ್ವಾ ಕಂಸೈಕಂ ಶೀತಲಸಲಿಲಂ ತಸ್ಮೈ ದತ್ತೇ, ಯುಷ್ಮಾನಹಂ ತಥ್ಯಂ ವದಾಮಿ, ಸ ಕೇನಾಪಿ ಪ್ರಕಾರೇಣ ಫಲೇನ ನ ವಞ್ಚಿಷ್ಯತೇ|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಇತ್ಥಂ ಯೀಶುಃ ಸ್ವದ್ವಾದಶಶಿಷ್ಯಾಣಾಮಾಜ್ಞಾಪನಂ ಸಮಾಪ್ಯ ಪುರೇ ಪುರ ಉಪದೇಷ್ಟುಂ ಸುಸಂವಾದಂ ಪ್ರಚಾರಯಿತುಂ ತತ್ಸ್ಥಾನಾತ್ ಪ್ರತಸ್ಥೇ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಅನನ್ತರಂ ಯೋಹನ್ ಕಾರಾಯಾಂ ತಿಷ್ಠನ್ ಖ್ರಿಷ್ಟಸ್ಯ ಕರ್ಮ್ಮಣಾಂ ವಾರ್ತ್ತಂ ಪ್ರಾಪ್ಯ ಯಸ್ಯಾಗಮನವಾರ್ತ್ತಾಸೀತ್ ಸಏವ ಕಿಂ ತ್ವಂ? ವಾ ವಯಮನ್ಯಮ್ ಅಪೇಕ್ಷಿಷ್ಯಾಮಹೇ?</para>
  <para style="p">
    <verse number="3" style="v"/>ಏತತ್ ಪ್ರಷ್ಟುಂ ನಿಜೌ ದ್ವೌ ಶಿಷ್ಯೌ ಪ್ರಾಹಿಣೋತ್|</para>
  <para style="p">
    <verse number="4" style="v"/>ಯೀಶುಃ ಪ್ರತ್ಯವೋಚತ್, ಅನ್ಧಾ ನೇತ್ರಾಣಿ ಲಭನ್ತೇ, ಖಞ್ಚಾ ಗಚ್ಛನ್ತಿ, ಕುಷ್ಠಿನಃ ಸ್ವಸ್ಥಾ ಭವನ್ತಿ, ಬಧಿರಾಃ ಶೃಣ್ವನ್ತಿ, ಮೃತಾ ಜೀವನ್ತ ಉತ್ತಿಷ್ಠನ್ತಿ, ದರಿದ್ರಾಣಾಂ ಸಮೀಪೇ ಸುಸಂವಾದಃ ಪ್ರಚಾರ್ಯ್ಯತ,</para>
  <para style="p">
    <verse number="5" style="v"/>ಏತಾನಿ ಯದ್ಯದ್ ಯುವಾಂ ಶೃಣುಥಃ ಪಶ್ಯಥಶ್ಚ ಗತ್ವಾ ತದ್ವಾರ್ತ್ತಾಂ ಯೋಹನಂ ಗದತಂ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಯಸ್ಯಾಹಂ ನ ವಿಘ್ನೀಭವಾಮಿ, ಸಏವ ಧನ್ಯಃ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅನನ್ತರಂ ತಯೋಃ ಪ್ರಸ್ಥಿತಯೋ ರ್ಯೀಶು ರ್ಯೋಹನಮ್ ಉದ್ದಿಶ್ಯ ಜನಾನ್ ಜಗಾದ, ಯೂಯಂ ಕಿಂ ದ್ರಷ್ಟುಂ ವಹಿರ್ಮಧ್ಯೇಪ್ರಾನ್ತರಮ್ ಅಗಚ್ಛತ? ಕಿಂ ವಾತೇನ ಕಮ್ಪಿತಂ ನಲಂ?</para>
  <para style="p">
    <verse number="8" style="v"/>ವಾ ಕಿಂ ವೀಕ್ಷಿತುಂ ವಹಿರ್ಗತವನ್ತಃ? ಕಿಂ ಪರಿಹಿತಸೂಕ್ಷ್ಮವಸನಂ ಮನುಜಮೇಕಂ? ಪಶ್ಯತ, ಯೇ ಸೂಕ್ಷ್ಮವಸನಾನಿ ಪರಿದಧತಿ, ತೇ ರಾಜಧಾನ್ಯಾಂ ತಿಷ್ಠನ್ತಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ತರ್ಹಿ ಯೂಯಂ ಕಿಂ ದ್ರಷ್ಟುಂ ಬಹಿರಗಮತ, ಕಿಮೇಕಂ ಭವಿಷ್ಯದ್ವಾದಿನಂ? ತದೇವ ಸತ್ಯಂ| ಯುಷ್ಮಾನಹಂ ವದಾಮಿ, ಸ ಭವಿಷ್ಯದ್ವಾದಿನೋಪಿ ಮಹಾನ್;</para>
  <para style="p">
    <verse number="10" style="v"/>ಯತಃ, ಪಶ್ಯ ಸ್ವಕೀಯದೂತೋಯಂ ತ್ವದಗ್ರೇ ಪ್ರೇಷ್ಯತೇ ಮಯಾ| ಸ ಗತ್ವಾ ತವ ಪನ್ಥಾನಂ ಸ್ಮಯಕ್ ಪರಿಷ್ಕರಿಷ್ಯತಿ|| ಏತದ್ವಚನಂ ಯಮಧಿ ಲಿಖಿತಮಾಸ್ತೇ ಸೋಽಯಂ ಯೋಹನ್|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅಪರಂ ಯುಷ್ಮಾನಹಂ ತಥ್ಯಂ ಬ್ರವೀಮಿ, ಮಜ್ಜಯಿತು ರ್ಯೋಹನಃ ಶ್ರೇಷ್ಠಃ ಕೋಪಿ ನಾರೀತೋ ನಾಜಾಯತ; ತಥಾಪಿ ಸ್ವರ್ಗರಾಜ್ಯಮಧ್ಯೇ ಸರ್ವ್ವೇಭ್ಯೋ ಯಃ ಕ್ಷುದ್ರಃ ಸ ಯೋಹನಃ ಶ್ರೇಷ್ಠಃ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಅಪರಞ್ಚ ಆ ಯೋಹನೋಽದ್ಯ ಯಾವತ್ ಸ್ವರ್ಗರಾಜ್ಯಂ ಬಲಾದಾಕ್ರಾನ್ತಂ ಭವತಿ ಆಕ್ರಮಿನಶ್ಚ ಜನಾ ಬಲೇನ ತದಧಿಕುರ್ವ್ವನ್ತಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯತೋ ಯೋಹನಂ ಯಾವತ್ ಸರ್ವ್ವಭವಿಷ್ಯದ್ವಾದಿಭಿ ರ್ವ್ಯವಸ್ಥಯಾ ಚ ಉಪದೇಶಃ ಪ್ರಾಕಾಶ್ಯತ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯದಿ ಯೂಯಮಿದಂ ವಾಕ್ಯಂ ಗ್ರಹೀತುಂ ಶಕ್ನುಥ, ತರ್ಹಿ ಶ್ರೇಯಃ, ಯಸ್ಯಾಗಮನಸ್ಯ ವಚನಮಾಸ್ತೇ ಸೋಽಯಮ್ ಏಲಿಯಃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಯಸ್ಯ ಶ್ರೋತುಂ ಕರ್ಣೌ ಸ್ತಃ ಸ ಶೃಣೋತು|</para>
  <para style="p">
    <verse number="16" style="v"/>ಏತೇ ವಿದ್ಯಮಾನಜನಾಃ ಕೈ ರ್ಮಯೋಪಮೀಯನ್ತೇ? ಯೇ ಬಾಲಕಾ ಹಟ್ಟ ಉಪವಿಶ್ಯ ಸ್ವಂ ಸ್ವಂ ಬನ್ಧುಮಾಹೂಯ ವದನ್ತಿ,</para>
  <para style="p">
    <verse number="17" style="v"/>ವಯಂ ಯುಷ್ಮಾಕಂ ಸಮೀಪೇ ವಂಶೀರವಾದಯಾಮ, ಕಿನ್ತು ಯೂಯಂ ನಾನೃತ್ಯತ; ಯುಷ್ಮಾಕಂ ಸಮೀಪೇ ಚ ವಯಮರೋದಿಮ, ಕಿನ್ತು ಯೂಯಂ ನ ವ್ಯಲಪತ, ತಾದೃಶೈ ರ್ಬಾಲಕೈಸ್ತ ಉಪಮಾಯಿಷ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಯತೋ ಯೋಹನ್ ಆಗತ್ಯ ನ ಭುಕ್ತವಾನ್ ನ ಪೀತವಾಂಶ್ಚ, ತೇನ ಲೋಕಾ ವದನ್ತಿ, ಸ ಭೂತಗ್ರಸ್ತ ಇತಿ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಮನುಜಸುತ ಆಗತ್ಯ ಭುಕ್ತವಾನ್ ಪೀತವಾಂಶ್ಚ, ತೇನ ಲೋಕಾ ವದನ್ತಿ, ಪಶ್ಯತ ಏಷ ಭೋಕ್ತಾ ಮದ್ಯಪಾತಾ ಚಣ್ಡಾಲಪಾಪಿನಾಂ ಬನ್ಧಶ್ಚ, ಕಿನ್ತು ಜ್ಞಾನಿನೋ ಜ್ಞಾನವ್ಯವಹಾರಂ ನಿರ್ದೋಷಂ ಜಾನನ್ತಿ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಸ ಯತ್ರ ಯತ್ರ ಪುರೇ ಬಹ್ವಾಶ್ಚರ್ಯ್ಯಂ ಕರ್ಮ್ಮ ಕೃತವಾನ್, ತನ್ನಿವಾಸಿನಾಂ ಮನಃಪರಾವೃತ್ತ್ಯಭಾವಾತ್ ತಾನಿ ನಗರಾಣಿ ಪ್ರತಿ ಹನ್ತೇತ್ಯುಕ್ತಾ ಕಥಿತವಾನ್,</para>
  <para style="p">
    <verse number="21" style="v"/>ಹಾ ಕೋರಾಸೀನ್, ಹಾ ಬೈತ್ಸೈದೇ, ಯುಷ್ಮನ್ಮಧ್ಯೇ ಯದ್ಯದಾಶ್ಚರ್ಯ್ಯಂ ಕರ್ಮ್ಮ ಕೃತಂ ಯದಿ ತತ್ ಸೋರಸೀದೋನ್ನಗರ ಅಕಾರಿಷ್ಯತ, ತರ್ಹಿ ಪೂರ್ವ್ವಮೇವ ತನ್ನಿವಾಸಿನಃ ಶಾಣವಸನೇ ಭಸ್ಮನಿ ಚೋಪವಿಶನ್ತೋ ಮನಾಂಸಿ ಪರಾವರ್ತ್ತಿಷ್ಯನ್ತ|</para>
  <para style="p">
    <verse number="22" style="v"/>ತಸ್ಮಾದಹಂ ಯುಷ್ಮಾನ್ ವದಾಮಿ, ವಿಚಾರದಿನೇ ಯುಷ್ಮಾಕಂ ದಶಾತಃ ಸೋರಸೀದೋನೋ ರ್ದಶಾ ಸಹ್ಯತರಾ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಅಪರಞ್ಚ ಬತ ಕಫರ್ನಾಹೂಮ್, ತ್ವಂ ಸ್ವರ್ಗಂ ಯಾವದುನ್ನತೋಸಿ, ಕಿನ್ತು ನರಕೇ ನಿಕ್ಷೇಪ್ಸ್ಯಸೇ, ಯಸ್ಮಾತ್ ತ್ವಯಿ ಯಾನ್ಯಾಶ್ಚರ್ಯ್ಯಾಣಿ ಕರ್ಮ್ಮಣ್ಯಕಾರಿಷತ, ಯದಿ ತಾನಿ ಸಿದೋಮ್ನಗರ ಅಕಾರಿಷ್ಯನ್ತ, ತರ್ಹಿ ತದದ್ಯ ಯಾವದಸ್ಥಾಸ್ಯತ್|</para>
  <para style="p">
    <verse number="24" style="v"/>ಕಿನ್ತ್ವಹಂ ಯುಷ್ಮಾನ್ ವದಾಮಿ, ವಿಚಾರದಿನೇ ತವ ದಣ್ಡತಃ ಸಿದೋಮೋ ದಣ್ಡೋ ಸಹ್ಯತರೋ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಏತಸ್ಮಿನ್ನೇವ ಸಮಯೇ ಯೀಶುಃ ಪುನರುವಾಚ, ಹೇ ಸ್ವರ್ಗಪೃಥಿವ್ಯೋರೇಕಾಧಿಪತೇ ಪಿತಸ್ತ್ವಂ ಜ್ಞಾನವತೋ ವಿದುಷಶ್ಚ ಲೋಕಾನ್ ಪ್ರತ್ಯೇತಾನಿ ನ ಪ್ರಕಾಶ್ಯ ಬಾಲಕಾನ್ ಪ್ರತಿ ಪ್ರಕಾಶಿತವಾನ್, ಇತಿ ಹೇತೋಸ್ತ್ವಾಂ ಧನ್ಯಂ ವದಾಮಿ|</para>
  <para style="p">
    <verse number="26" style="v"/>ಹೇ ಪಿತಃ, ಇತ್ಥಂ ಭವೇತ್ ಯತ ಇದಂ ತ್ವದೃಷ್ಟಾವುತ್ತಮಂ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಪಿತ್ರಾ ಮಯಿ ಸರ್ವ್ವಾಣಿ ಸಮರ್ಪಿತಾನಿ, ಪಿತರಂ ವಿನಾ ಕೋಪಿ ಪುತ್ರಂ ನ ಜಾನಾತಿ, ಯಾನ್ ಪ್ರತಿ ಪುತ್ರೇಣ ಪಿತಾ ಪ್ರಕಾಶ್ಯತೇ ತಾನ್ ವಿನಾ ಪುತ್ರಾದ್ ಅನ್ಯಃ ಕೋಪಿ ಪಿತರಂ ನ ಜಾನಾತಿ|</para>
  <para style="p">
    <verse number="28" style="v"/>ಹೇ ಪರಿಶ್ರಾನ್ತಾ ಭಾರಾಕ್ರಾನ್ತಾಶ್ಚ ಲೋಕಾ ಯೂಯಂ ಮತ್ಸನ್ನಿಧಿಮ್ ಆಗಚ್ಛತ, ಅಹಂ ಯುಷ್ಮಾನ್ ವಿಶ್ರಮಯಿಷ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="29" style="v"/>ಅಹಂ ಕ್ಷಮಣಶೀಲೋ ನಮ್ರಮನಾಶ್ಚ, ತಸ್ಮಾತ್ ಮಮ ಯುಗಂ ಸ್ವೇಷಾಮುಪರಿ ಧಾರಯತ ಮತ್ತಃ ಶಿಕ್ಷಧ್ವಞ್ಚ, ತೇನ ಯೂಯಂ ಸ್ವೇ ಸ್ವೇ ಮನಸಿ ವಿಶ್ರಾಮಂ ಲಪ್ಸ್ಯಧ್ಬೇ|</para>
  <para style="p">
    <verse number="30" style="v"/>ಯತೋ ಮಮ ಯುಗಮ್ ಅನಾಯಾಸಂ ಮಮ ಭಾರಶ್ಚ ಲಘುಃ|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅನನ್ತರಂ ಯೀಶು ರ್ವಿಶ್ರಾಮವಾರೇ ಶ್ಸ್ಯಮಧ್ಯೇನ ಗಚ್ಛತಿ, ತದಾ ತಚ್ಛಿಷ್ಯಾ ಬುಭುಕ್ಷಿತಾಃ ಸನ್ತಃ ಶ್ಸ್ಯಮಞ್ಜರೀಶ್ಛತ್ವಾ ಛಿತ್ವಾ ಖಾದಿತುಮಾರಭನ್ತ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತದ್ ವಿಲೋಕ್ಯ ಫಿರೂಶಿನೋ ಯೀಶುಂ ಜಗದುಃ, ಪಶ್ಯ ವಿಶ್ರಾಮವಾರೇ ಯತ್ ಕರ್ಮ್ಮಾಕರ್ತ್ತವ್ಯಂ ತದೇವ ತವ ಶಿಷ್ಯಾಃ ಕುರ್ವ್ವನ್ತಿ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಸ ತಾನ್ ಪ್ರತ್ಯಾವದತ, ದಾಯೂದ್ ತತ್ಸಙ್ಗಿನಶ್ಚ ಬುಭುಕ್ಷಿತಾಃ ಸನ್ತೋ ಯತ್ ಕರ್ಮ್ಮಾಕುರ್ವ್ವನ್ ತತ್ ಕಿಂ ಯುಷ್ಮಾಭಿ ರ್ನಾಪಾಠಿ?</para>
  <para style="p">
    <verse number="4" style="v"/>ಯೇ ದರ್ಶನೀಯಾಃ ಪೂಪಾಃ ಯಾಜಕಾನ್ ವಿನಾ ತಸ್ಯ ತತ್ಸಙ್ಗಿಮನುಜಾನಾಞ್ಚಾಭೋಜನೀಯಾಸ್ತ ಈಶ್ವರಾವಾಸಂ ಪ್ರವಿಷ್ಟೇನ ತೇನ ಭುಕ್ತಾಃ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಅನ್ಯಚ್ಚ ವಿಶ್ರಾಮವಾರೇ ಮಧ್ಯೇಮನ್ದಿರಂ ವಿಶ್ರಾಮವಾರೀಯಂ ನಿಯಮಂ ಲಙ್ವನ್ತೋಪಿ ಯಾಜಕಾ ನಿರ್ದೋಷಾ ಭವನ್ತಿ, ಶಾಸ್ತ್ರಮಧ್ಯೇ ಕಿಮಿದಮಪಿ ಯುಷ್ಮಾಭಿ ರ್ನ ಪಠಿತಂ?</para>
  <para style="p">
    <verse number="6" style="v"/>ಯುಷ್ಮಾನಹಂ ವದಾಮಿ, ಅತ್ರ ಸ್ಥಾನೇ ಮನ್ದಿರಾದಪಿ ಗರೀಯಾನ್ ಏಕ ಆಸ್ತೇ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಕಿನ್ತು ದಯಾಯಾಂ ಮೇ ಯಥಾ ಪ್ರೀತಿ ರ್ನ ತಥಾ ಯಜ್ಞಕರ್ಮ್ಮಣಿ| ಏತದ್ವಚನಸ್ಯಾರ್ಥಂ ಯದಿ ಯುಯಮ್ ಅಜ್ಞಾಸಿಷ್ಟ ತರ್ಹಿ ನಿರ್ದೋಷಾನ್ ದೋಷಿಣೋ ನಾಕಾರ್ಷ್ಟ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಅನ್ಯಚ್ಚ ಮನುಜಸುತೋ ವಿಶ್ರಾಮವಾರಸ್ಯಾಪಿ ಪತಿರಾಸ್ತೇ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಅನನ್ತರಂ ಸ ತತ್ಸ್ಥಾನಾತ್ ಪ್ರಸ್ಥಾಯ ತೇಷಾಂ ಭಜನಭವನಂ ಪ್ರವಿಷ್ಟವಾನ್, ತದಾನೀಮ್ ಏಕಃ ಶುಷ್ಕಕರಾಮಯವಾನ್ ಉಪಸ್ಥಿತವಾನ್|</para>
  <para style="p">
    <verse number="10" style="v"/>ತತೋ ಯೀಶುಮ್ ಅಪವದಿತುಂ ಮಾನುಷಾಃ ಪಪ್ರಚ್ಛುಃ, ವಿಶ್ರಾಮವಾರೇ ನಿರಾಮಯತ್ವಂ ಕರಣೀಯಂ ನ ವಾ?</para>
  <para style="p">
    <verse number="11" style="v"/>ತೇನ ಸ ಪ್ರತ್ಯುವಾಚ, ವಿಶ್ರಾಮವಾರೇ ಯದಿ ಕಸ್ಯಚಿದ್ ಅವಿ ರ್ಗರ್ತ್ತೇ ಪತತಿ, ತರ್ಹಿ ಯಸ್ತಂ ಘೃತ್ವಾ ನ ತೋಲಯತಿ, ಏತಾದೃಶೋ ಮನುಜೋ ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ಕ ಆಸ್ತೇ?</para>
  <para style="p">
    <verse number="12" style="v"/>ಅವೇ ರ್ಮಾನವಃ ಕಿಂ ನಹಿ ಶ್ರೇಯಾನ್? ಅತೋ ವಿಶ್ರಾಮವಾರೇ ಹಿತಕರ್ಮ್ಮ ಕರ್ತ್ತವ್ಯಂ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅನನ್ತರಂ ಸ ತಂ ಮಾನವಂ ಗದಿತವಾನ್, ಕರಂ ಪ್ರಸಾರಯ; ತೇನ ಕರೇ ಪ್ರಸಾರಿತೇ ಸೋನ್ಯಕರವತ್ ಸ್ವಸ್ಥೋಽಭವತ್|</para>
  <para style="p">
    <verse number="14" style="v"/>ತದಾ ಫಿರೂಶಿನೋ ಬಹಿರ್ಭೂಯ ಕಥಂ ತಂ ಹನಿಷ್ಯಾಮ ಇತಿ ಕುಮನ್ತ್ರಣಾಂ ತತ್ಪ್ರಾತಿಕೂಲ್ಯೇನ ಚಕ್ರುಃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತತೋ ಯೀಶುಸ್ತದ್ ವಿದಿತ್ವಾ ಸ್ಥನಾನ್ತರಂ ಗತವಾನ್; ಅನ್ಯೇಷು ಬಹುನರೇಷು ತತ್ಪಶ್ಚಾದ್ ಗತೇಷು ತಾನ್ ಸ ನಿರಾಮಯಾನ್ ಕೃತ್ವಾ ಇತ್ಯಾಜ್ಞಾಪಯತ್,</para>
  <para style="p">
    <verse number="16" style="v"/>ಯೂಯಂ ಮಾಂ ನ ಪರಿಚಾಯಯತ|</para>
  <para style="p">
    <verse number="17" style="v"/>ತಸ್ಮಾತ್ ಮಮ ಪ್ರೀಯೋ ಮನೋನೀತೋ ಮನಸಸ್ತುಷ್ಟಿಕಾರಕಃ| ಮದೀಯಃ ಸೇವಕೋ ಯಸ್ತು ವಿದ್ಯತೇ ತಂ ಸಮೀಕ್ಷತಾಂ| ತಸ್ಯೋಪರಿ ಸ್ವಕೀಯಾತ್ಮಾ ಮಯಾ ಸಂಸ್ಥಾಪಯಿಷ್ಯತೇ| ತೇನಾನ್ಯದೇಶಜಾತೇಷು ವ್ಯವಸ್ಥಾ ಸಂಪ್ರಕಾಶ್ಯತೇ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಕೇನಾಪಿ ನ ವಿರೋಧಂ ಸ ವಿವಾದಞ್ಚ ಕರಿಷ್ಯತಿ| ನ ಚ ರಾಜಪಥೇ ತೇನ ವಚನಂ ಶ್ರಾವಯಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="19" style="v"/>ವ್ಯವಸ್ಥಾ ಚಲಿತಾ ಯಾವತ್ ನಹಿ ತೇನ ಕರಿಷ್ಯತೇ| ತಾವತ್ ನಲೋ ವಿದೀರ್ಣೋಽಪಿ ಭಂಕ್ಷ್ಯತೇ ನಹಿ ತೇನ ಚ| ತಥಾ ಸಧೂಮವರ್ತ್ತಿಞ್ಚ ನ ಸ ನಿರ್ವ್ವಾಪಯಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಪ್ರತ್ಯಾಶಾಞ್ಚ ಕರಿಷ್ಯನ್ತಿ ತನ್ನಾಮ್ನಿ ಭಿನ್ನದೇಶಜಾಃ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಯಾನ್ಯೇತಾನಿ ವಚನಾನಿ ಯಿಶಯಿಯಭವಿಷ್ಯದ್ವಾದಿನಾ ಪ್ರೋಕ್ತಾನ್ಯಾಸನ್, ತಾನಿ ಸಫಲಾನ್ಯಭವನ್|</para>
  <para style="p">
    <verse number="22" style="v"/>ಅನನ್ತರಂ ಲೋಕೈ ಸ್ತತ್ಸಮೀಪಮ್ ಆನೀತೋ ಭೂತಗ್ರಸ್ತಾನ್ಧಮೂಕೈಕಮನುಜಸ್ತೇನ ಸ್ವಸ್ಥೀಕೃತಃ, ತತಃ ಸೋಽನ್ಧೋ ಮೂಕೋ ದ್ರಷ್ಟುಂ ವಕ್ತುಞ್ಚಾರಬ್ಧವಾನ್|</para>
  <para style="p">
    <verse number="23" style="v"/>ಅನೇನ ಸರ್ವ್ವೇ ವಿಸ್ಮಿತಾಃ ಕಥಯಾಞ್ಚಕ್ರುಃ, ಏಷಃ ಕಿಂ ದಾಯೂದಃ ಸನ್ತಾನೋ ನಹಿ?</para>
  <para style="p">
    <verse number="24" style="v"/>ಕಿನ್ತು ಫಿರೂಶಿನಸ್ತತ್ ಶ್ರುತ್ವಾ ಗದಿತವನ್ತಃ, ಬಾಲ್ಸಿಬೂಬ್ನಾಮ್ನೋ ಭೂತರಾಜಸ್ಯ ಸಾಹಾಯ್ಯಂ ವಿನಾ ನಾಯಂ ಭೂತಾನ್ ತ್ಯಾಜಯತಿ|</para>
  <para style="p">
    <verse number="25" style="v"/>ತದಾನೀಂ ಯೀಶುಸ್ತೇಷಾಮ್ ಇತಿ ಮಾನಸಂ ವಿಜ್ಞಾಯ ತಾನ್ ಅವದತ್ ಕಿಞ್ಚನ ರಾಜ್ಯಂ ಯದಿ ಸ್ವವಿಪಕ್ಷಾದ್ ಭಿದ್ಯತೇ, ತರ್ಹಿ ತತ್ ಉಚ್ಛಿದ್ಯತೇ; ಯಚ್ಚ ಕಿಞ್ಚನ ನಗರಂ ವಾ ಗೃಹಂ ಸ್ವವಿಪಕ್ಷಾದ್ ವಿಭಿದ್ಯತೇ, ತತ್ ಸ್ಥಾತುಂ ನ ಶಕ್ನೋತಿ|</para>
  <para style="p">
    <verse number="26" style="v"/>ತದ್ವತ್ ಶಯತಾನೋ ಯದಿ ಶಯತಾನಂ ಬಹಿಃ ಕೃತ್ವಾ ಸ್ವವಿಪಕ್ಷಾತ್ ಪೃಥಕ್ ಪೃಥಕ್ ಭವತಿ, ತರ್ಹಿ ತಸ್ಯ ರಾಜ್ಯಂ ಕೇನ ಪ್ರಕಾರೇಣ ಸ್ಥಾಸ್ಯತಿ?</para>
  <para style="p">
    <verse number="27" style="v"/>ಅಹಞ್ಚ ಯದಿ ಬಾಲ್ಸಿಬೂಬಾ ಭೂತಾನ್ ತ್ಯಾಜಯಾಮಿ, ತರ್ಹಿ ಯುಷ್ಮಾಕಂ ಸನ್ತಾನಾಃ ಕೇನ ಭೂತಾನ್ ತ್ಯಾಜಯನ್ತಿ? ತಸ್ಮಾದ್ ಯುಷ್ಮಾಕಮ್ ಏತದ್ವಿಚಾರಯಿತಾರಸ್ತ ಏವ ಭವಿಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="28" style="v"/>ಕಿನ್ತವಹಂ ಯದೀಶ್ವರಾತ್ಮನಾ ಭೂತಾನ್ ತ್ಯಾಜಯಾಮಿ, ತರ್ಹೀಶ್ವರಸ್ಯ ರಾಜ್ಯಂ ಯುಷ್ಮಾಕಂ ಸನ್ನಿಧಿಮಾಗತವತ್|</para>
  <para style="p">
    <verse number="29" style="v"/>ಅನ್ಯಞ್ಚ ಕೋಪಿ ಬಲವನ್ತ ಜನಂ ಪ್ರಥಮತೋ ನ ಬದ್ವ್ವಾ ಕೇನ ಪ್ರಕಾರೇಣ ತಸ್ಯ ಗೃಹಂ ಪ್ರವಿಶ್ಯ ತದ್ದ್ರವ್ಯಾದಿ ಲೋಠಯಿತುಂ ಶಕ್ನೋತಿ? ಕಿನ್ತು ತತ್ ಕೃತ್ವಾ ತದೀಯಗೃಸ್ಯ ದ್ರವ್ಯಾದಿ ಲೋಠಯಿತುಂ ಶಕ್ನೋತಿ|</para>
  <para style="p">
    <verse number="30" style="v"/>ಯಃ ಕಶ್ಚಿತ್ ಮಮ ಸ್ವಪಕ್ಷೀಯೋ ನಹಿ ಸ ವಿಪಕ್ಷೀಯ ಆಸ್ತೇ, ಯಶ್ಚ ಮಯಾ ಸಾಕಂ ನ ಸಂಗೃಹ್ಲಾತಿ, ಸ ವಿಕಿರತಿ|</para>
  <para style="p">
    <verse number="31" style="v"/>ಅತಏವ ಯುಷ್ಮಾನಹಂ ವದಾಮಿ, ಮನುಜಾನಾಂ ಸರ್ವ್ವಪ್ರಕಾರಪಾಪಾನಾಂ ನಿನ್ದಾಯಾಶ್ಚ ಮರ್ಷಣಂ ಭವಿತುಂ ಶಕ್ನೋತಿ, ಕಿನ್ತು ಪವಿತ್ರಸ್ಯಾತ್ಮನೋ ವಿರುದ್ಧನಿನ್ದಾಯಾ ಮರ್ಷಣಂ ಭವಿತುಂ ನ ಶಕ್ನೋತಿ|</para>
  <para style="p">
    <verse number="32" style="v"/>ಯೋ ಮನುಜಸುತಸ್ಯ ವಿರುದ್ಧಾಂ ಕಥಾಂ ಕಥಯತಿ, ತಸ್ಯಾಪರಾಧಸ್ಯ ಕ್ಷಮಾ ಭವಿತುಂ ಶಕ್ನೋತಿ, ಕಿನ್ತು ಯಃ ಕಶ್ಚಿತ್ ಪವಿತ್ರಸ್ಯಾತ್ಮನೋ ವಿರುದ್ಧಾಂ ಕಥಾಂ ಕಥಯತಿ ನೇಹಲೋಕೇ ನ ಪ್ರೇತ್ಯ ತಸ್ಯಾಪರಾಧಸ್ಯ ಕ್ಷಮಾ ಭವಿತುಂ ಶಕ್ನೋತಿ|</para>
  <para style="p">
    <verse number="33" style="v"/>ಪಾದಪಂ ಯದಿ ಭದ್ರಂ ವದಥ, ತರ್ಹಿ ತಸ್ಯ ಫಲಮಪಿ ಸಾಧು ವಕ್ತವ್ಯಂ, ಯದಿ ಚ ಪಾದಪಂ ಅಸಾಧುಂ ವದಥ, ತರ್ಹಿ ತಸ್ಯ ಫಲಮಪ್ಯಸಾಧು ವಕ್ತವ್ಯಂ; ಯತಃ ಸ್ವೀಯಸ್ವೀಯಫಲೇನ ಪಾದಪಃ ಪರಿಚೀಯತೇ|</para>
  <para style="p">
    <verse number="34" style="v"/>ರೇ ಭುಜಗವಂಶಾ ಯೂಯಮಸಾಧವಃ ಸನ್ತಃ ಕಥಂ ಸಾಧು ವಾಕ್ಯಂ ವಕ್ತುಂ ಶಕ್ಷ್ಯಥ? ಯಸ್ಮಾದ್ ಅನ್ತಃಕರಣಸ್ಯ ಪೂರ್ಣಭಾವಾನುಸಾರಾದ್ ವದನಾದ್ ವಚೋ ನಿರ್ಗಚ್ಛತಿ|</para>
  <para style="p">
    <verse number="35" style="v"/>ತೇನ ಸಾಧುರ್ಮಾನವೋಽನ್ತಃಕರಣರೂಪಾತ್ ಸಾಧುಭಾಣ್ಡಾಗಾರಾತ್ ಸಾಧು ದ್ರವ್ಯಂ ನಿರ್ಗಮಯತಿ, ಅಸಾಧುರ್ಮಾನುಷಸ್ತ್ವಸಾಧುಭಾಣ್ಡಾಗಾರಾದ್ ಅಸಾಧುವಸ್ತೂನಿ ನಿರ್ಗಮಯತಿ|</para>
  <para style="p">
    <verse number="36" style="v"/>ಕಿನ್ತ್ವಹಂ ಯುಷ್ಮಾನ್ ವದಾಮಿ, ಮನುಜಾ ಯಾವನ್ತ್ಯಾಲಸ್ಯವಚಾಂಸಿ ವದನ್ತಿ, ವಿಚಾರದಿನೇ ತದುತ್ತರಮವಶ್ಯಂ ದಾತವ್ಯಂ,</para>
  <para style="p">
    <verse number="37" style="v"/>ಯತಸ್ತ್ವಂ ಸ್ವೀಯವಚೋಭಿ ರ್ನಿರಪರಾಧಃ ಸ್ವೀಯವಚೋಭಿಶ್ಚ ಸಾಪರಾಧೋ ಗಣಿಷ್ಯಸೇ|</para>
  <para style="p">
    <verse number="38" style="v"/>ತದಾನೀಂ ಕತಿಪಯಾ ಉಪಾಧ್ಯಾಯಾಃ ಫಿರೂಶಿನಶ್ಚ ಜಗದುಃ, ಹೇ ಗುರೋ ವಯಂ ಭವತ್ತಃ ಕಿಞ್ಚನ ಲಕ್ಷ್ಮ ದಿದೃಕ್ಷಾಮಃ|</para>
  <para style="p">
    <verse number="39" style="v"/>ತದಾ ಸ ಪ್ರತ್ಯುಕ್ತವಾನ್, ದುಷ್ಟೋ ವ್ಯಭಿಚಾರೀ ಚ ವಂಶೋ ಲಕ್ಷ್ಮ ಮೃಗಯತೇ, ಕಿನ್ತು ಭವಿಷ್ಯದ್ವಾದಿನೋ ಯೂನಸೋ ಲಕ್ಷ್ಮ ವಿಹಾಯಾನ್ಯತ್ ಕಿಮಪಿ ಲಕ್ಷ್ಮ ತೇ ನ ಪ್ರದರ್ಶಯಿಷ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="40" style="v"/>ಯತೋ ಯೂನಮ್ ಯಥಾ ತ್ರ್ಯಹೋರಾತ್ರಂ ಬೃಹನ್ಮೀನಸ್ಯ ಕುಕ್ಷಾವಾಸೀತ್, ತಥಾ ಮನುಜಪುತ್ರೋಪಿ ತ್ರ್ಯಹೋರಾತ್ರಂ ಮೇದಿನ್ಯಾ ಮಧ್ಯೇ ಸ್ಥಾಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="41" style="v"/>ಅಪರಂ ನೀನಿವೀಯಾ ಮಾನವಾ ವಿಚಾರದಿನ ಏತದ್ವಂಶೀಯಾನಾಂ ಪ್ರತಿಕೂಲಮ್ ಉತ್ಥಾಯ ತಾನ್ ದೋಷಿಣಃ ಕರಿಷ್ಯನ್ತಿ, ಯಸ್ಮಾತ್ತೇ ಯೂನಸ ಉಪದೇಶಾತ್ ಮನಾಂಸಿ ಪರಾವರ್ತ್ತಯಾಞ್ಚಕ್ರಿರೇ, ಕಿನ್ತ್ವತ್ರ ಯೂನಸೋಪಿ ಗುರುತರ ಏಕ ಆಸ್ತೇ|</para>
  <para style="p">
    <verse number="42" style="v"/>ಪುನಶ್ಚ ದಕ್ಷಿಣದೇಶೀಯಾ ರಾಜ್ಞೀ ವಿಚಾರದಿನ ಏತದ್ವಂಶೀಯಾನಾಂ ಪ್ರತಿಕೂಲಮುತ್ಥಾಯ ತಾನ್ ದೋಷಿಣಃ ಕರಿಷ್ಯತಿ ಯತಃ ಸಾ ರಾಜ್ಞೀ ಸುಲೇಮನೋ ವಿದ್ಯಾಯಾಃ ಕಥಾಂ ಶ್ರೋತುಂ ಮೇದಿನ್ಯಾಃ ಸೀಮ್ನ ಆಗಚ್ಛತ್, ಕಿನ್ತು ಸುಲೇಮನೋಪಿ ಗುರುತರ ಏಕೋ ಜನೋಽತ್ರ ಆಸ್ತೇ|</para>
  <para style="p">
    <verse number="43" style="v"/>ಅಪರಂ ಮನುಜಾದ್ ಬಹಿರ್ಗತೋ ಽಪವಿತ್ರಭೂತಃ ಶುಷ್ಕಸ್ಥಾನೇನ ಗತ್ವಾ ವಿಶ್ರಾಮಂ ಗವೇಷಯತಿ, ಕಿನ್ತು ತದಲಭಮಾನಃ ಸ ವಕ್ತಿ, ಯಸ್ಮಾ; ನಿಕೇತನಾದ್ ಆಗಮಂ, ತದೇವ ವೇಶ್ಮ ಪಕಾವೃತ್ಯ ಯಾಮಿ|</para>
  <para style="p">
    <verse number="44" style="v"/>ಪಶ್ಚಾತ್ ಸ ತತ್ ಸ್ಥಾನಮ್ ಉಪಸ್ಥಾಯ ತತ್ ಶೂನ್ಯಂ ಮಾರ್ಜ್ಜಿತಂ ಶೋಭಿತಞ್ಚ ವಿಲೋಕ್ಯ ವ್ರಜನ್ ಸ್ವತೋಪಿ ದುಷ್ಟತರಾನ್ ಅನ್ಯಸಪ್ತಭೂತಾನ್ ಸಙ್ಗಿನಃ ಕರೋತಿ|</para>
  <para style="p">
    <verse number="45" style="v"/>ತತಸ್ತೇ ತತ್ ಸ್ಥಾನಂ ಪ್ರವಿಶ್ಯ ನಿವಸನ್ತಿ, ತೇನ ತಸ್ಯ ಮನುಜಸ್ಯ ಶೇಷದಶಾ ಪೂರ್ವ್ವದಶಾತೋತೀವಾಶುಭಾ ಭವತಿ, ಏತೇಷಾಂ ದುಷ್ಟವಂಶ್ಯಾನಾಮಪಿ ತಥೈವ ಘಟಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="46" style="v"/>ಮಾನವೇಭ್ಯ ಏತಾಸಾಂ ಕಥನಾಂ ಕಥನಕಾಲೇ ತಸ್ಯ ಮಾತಾ ಸಹಜಾಶ್ಚ ತೇನ ಸಾಕಂ ಕಾಞ್ಚಿತ್ ಕಥಾಂ ಕಥಯಿತುಂ ವಾಞ್ಛನ್ತೋ ಬಹಿರೇವ ಸ್ಥಿತವನ್ತಃ|</para>
  <para style="p">
    <verse number="47" style="v"/>ತತಃ ಕಶ್ಚಿತ್ ತಸ್ಮೈ ಕಥಿತವಾನ್, ಪಶ್ಯ ತವ ಜನನೀ ಸಹಜಾಶ್ಚ ತ್ವಯಾ ಸಾಕಂ ಕಾಞ್ಚನ ಕಥಾಂ ಕಥಯಿತುಂ ಕಾಮಯಮಾನಾ ಬಹಿಸ್ತಿಷ್ಠನ್ತಿ|</para>
  <para style="p">
    <verse number="48" style="v"/>ಕಿನ್ತು ಸ ತಂ ಪ್ರತ್ಯವದತ್, ಮಮ ಕಾ ಜನನೀ? ಕೇ ವಾ ಮಮ ಸಹಜಾಃ?</para>
  <para style="p">
    <verse number="49" style="v"/>ಪಶ್ಚಾತ್ ಶಿಷ್ಯಾನ್ ಪ್ರತಿ ಕರಂ ಪ್ರಸಾರ್ಯ್ಯ ಕಥಿತವಾನ್, ಪಶ್ಯ ಮಮ ಜನನೀ ಮಮ ಸಹಜಾಶ್ಚೈತೇ;</para>
  <para style="p">
    <verse number="50" style="v"/>ಯಃ ಕಶ್ಚಿತ್ ಮಮ ಸ್ವರ್ಗಸ್ಥಸ್ಯ ಪಿತುರಿಷ್ಟಂ ಕರ್ಮ್ಮ ಕುರುತೇ, ಸಏವ ಮಮ ಭ್ರಾತಾ ಭಗಿನೀ ಜನನೀ ಚ|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅಪರಞ್ಚ ತಸ್ಮಿನ್ ದಿನೇ ಯೀಶುಃ ಸದ್ಮನೋ ಗತ್ವಾ ಸರಿತ್ಪತೇ ರೋಧಸಿ ಸಮುಪವಿವೇಶ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತತ್ರ ತತ್ಸನ್ನಿಧೌ ಬಹುಜನಾನಾಂ ನಿವಹೋಪಸ್ಥಿತೇಃ ಸ ತರಣಿಮಾರುಹ್ಯ ಸಮುಪಾವಿಶತ್, ತೇನ ಮಾನವಾ ರೋಧಸಿ ಸ್ಥಿತವನ್ತಃ|</para>
  <para style="p">
    <verse number="3" style="v"/>ತದಾನೀಂ ಸ ದೃಷ್ಟಾನ್ತೈಸ್ತಾನ್ ಇತ್ಥಂ ಬಹುಶ ಉಪದಿಷ್ಟವಾನ್| ಪಶ್ಯತ, ಕಶ್ಚಿತ್ ಕೃಷೀವಲೋ ಬೀಜಾನಿ ವಪ್ತುಂ ಬಹಿರ್ಜಗಾಮ,</para>
  <para style="p">
    <verse number="4" style="v"/>ತಸ್ಯ ವಪನಕಾಲೇ ಕತಿಪಯಬೀಜೇಷು ಮಾರ್ಗಪಾರ್ಶ್ವೇ ಪತಿತೇಷು ವಿಹಗಾಸ್ತಾನಿ ಭಕ್ಷಿತವನ್ತಃ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಅಪರಂ ಕತಿಪಯಬೀಜೇಷು ಸ್ತೋಕಮೃದ್ಯುಕ್ತಪಾಷಾಣೇ ಪತಿತೇಷು ಮೃದಲ್ಪತ್ವಾತ್ ತತ್ಕ್ಷಣಾತ್ ತಾನ್ಯಙ್ಕುರಿತಾನಿ,</para>
  <para style="p">
    <verse number="6" style="v"/>ಕಿನ್ತು ರವಾವುದಿತೇ ದಗ್ಧಾನಿ ತೇಷಾಂ ಮೂಲಾಪ್ರವಿಷ್ಟತ್ವಾತ್ ಶುಷ್ಕತಾಂ ಗತಾನಿ ಚ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅಪರಂ ಕತಿಪಯಬೀಜೇಷು ಕಣ್ಟಕಾನಾಂ ಮಧ್ಯೇ ಪತಿತೇಷು ಕಣ್ಟಕಾನ್ಯೇಧಿತ್ವಾ ತಾನಿ ಜಗ್ರಸುಃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಅಪರಞ್ಚ ಕತಿಪಯಬೀಜಾನಿ ಉರ್ವ್ವರಾಯಾಂ ಪತಿತಾನಿ; ತೇಷಾಂ ಮಧ್ಯೇ ಕಾನಿಚಿತ್ ಶತಗುಣಾನಿ ಕಾನಿಚಿತ್ ಷಷ್ಟಿಗುಣಾನಿ ಕಾನಿಚಿತ್ ತ್ರಿಂಶಗುಂಣಾನಿ ಫಲಾನಿ ಫಲಿತವನ್ತಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಶ್ರೋತುಂ ಯಸ್ಯ ಶ್ರುತೀ ಆಸಾತೇ ಸ ಶೃಣುಯಾತ್|</para>
  <para style="p">
    <verse number="10" style="v"/>ಅನನ್ತರಂ ಶಿಷ್ಯೈರಾಗತ್ಯ ಸೋಽಪೃಚ್ಛ್ಯತ, ಭವತಾ ತೇಭ್ಯಃ ಕುತೋ ದೃಷ್ಟಾನ್ತಕಥಾ ಕಥ್ಯತೇ?</para>
  <para style="p">
    <verse number="11" style="v"/>ತತಃ ಸ ಪ್ರತ್ಯವದತ್, ಸ್ವರ್ಗರಾಜ್ಯಸ್ಯ ನಿಗೂಢಾಂ ಕಥಾಂ ವೇದಿತುಂ ಯುಷ್ಮಭ್ಯಂ ಸಾಮರ್ಥ್ಯಮದಾಯಿ, ಕಿನ್ತು ತೇಭ್ಯೋ ನಾದಾಯಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯಸ್ಮಾದ್ ಯಸ್ಯಾನ್ತಿಕೇ ವರ್ದ್ಧತೇ, ತಸ್ಮಾಯೇವ ದಾಯಿಷ್ಯತೇ, ತಸ್ಮಾತ್ ತಸ್ಯ ಬಾಹುಲ್ಯಂ ಭವಿಷ್ಯತಿ, ಕಿನ್ತು ಯಸ್ಯಾನ್ತಿಕೇ ನ ವರ್ದ್ಧತೇ, ತಸ್ಯ ಯತ್ ಕಿಞ್ಚನಾಸ್ತೇ, ತದಪಿ ತಸ್ಮಾದ್ ಆದಾಯಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ತೇ ಪಶ್ಯನ್ತೋಪಿ ನ ಪಶ್ಯನ್ತಿ, ಶೃಣ್ವನ್ತೋಪಿ ನ ಶೃಣ್ವನ್ತಿ, ಬುಧ್ಯಮಾನಾ ಅಪಿ ನ ಬುಧ್ಯನ್ತೇ ಚ, ತಸ್ಮಾತ್ ತೇಭ್ಯೋ ದೃಷ್ಟಾನ್ತಕಥಾ ಕಥ್ಯತೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯಥಾ ಕರ್ಣೈಃ ಶ್ರೋಷ್ಯಥ ಯೂಯಂ ವೈ ಕಿನ್ತು ಯೂಯಂ ನ ಭೋತ್ಸ್ಯಥ| ನೇತ್ರೈರ್ದ್ರಕ್ಷ್ಯಥ ಯೂಯಞ್ಚ ಪರಿಜ್ಞಾತುಂ ನ ಶಕ್ಷ್ಯಥ| ತೇ ಮಾನುಷಾ ಯಥಾ ನೈವ ಪರಿಪಶ್ಯನ್ತಿ ಲೋಚನೈಃ| ಕರ್ಣೈ ರ್ಯಥಾ ನ ಶೃಣ್ವನ್ತಿ ನ ಬುಧ್ಯನ್ತೇ ಚ ಮಾನಸೈಃ| ವ್ಯಾವರ್ತ್ತಿತೇಷು ಚಿತ್ತೇಷು ಕಾಲೇ ಕುತ್ರಾಪಿ ತೈರ್ಜನೈಃ| ಮತ್ತಸ್ತೇ ಮನುಜಾಃ ಸ್ವಸ್ಥಾ ಯಥಾ ನೈವ ಭವನ್ತಿ ಚ| ತಥಾ ತೇಷಾಂ ಮನುಷ್ಯಾಣಾಂ ಕ್ರಿಯನ್ತೇ ಸ್ಥೂಲಬುದ್ಧಯಃ| ಬಧಿರೀಭೂತಕರ್ಣಾಶ್ಚ ಜಾತಾಶ್ಚ ಮುದ್ರಿತಾ ದೃಶಃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಯದೇತಾನಿ ವಚನಾನಿ ಯಿಶಯಿಯಭವಿಷ್ಯದ್ವಾದಿನಾ ಪ್ರೋಕ್ತಾನಿ ತೇಷು ತಾನಿ ಫಲನ್ತಿ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಕಿನ್ತು ಯುಷ್ಮಾಕಂ ನಯನಾನಿ ಧನ್ಯಾನಿ, ಯಸ್ಮಾತ್ ತಾನಿ ವೀಕ್ಷನ್ತೇ; ಧನ್ಯಾಶ್ಚ ಯುಷ್ಮಾಕಂ ಶಬ್ದಗ್ರಹಾಃ, ಯಸ್ಮಾತ್ ತೈರಾಕರ್ಣ್ಯತೇ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಮಯಾ ಯೂಯಂ ತಥ್ಯಂ ವಚಾಮಿ ಯುಷ್ಮಾಭಿ ರ್ಯದ್ಯದ್ ವೀಕ್ಷ್ಯತೇ, ತದ್ ಬಹವೋ ಭವಿಷ್ಯದ್ವಾದಿನೋ ಧಾರ್ಮ್ಮಿಕಾಶ್ಚ ಮಾನವಾ ದಿದೃಕ್ಷನ್ತೋಪಿ ದ್ರಷ್ಟುಂ ನಾಲಭನ್ತ, ಪುನಶ್ಚ ಯೂಯಂ ಯದ್ಯತ್ ಶೃಣುಥ, ತತ್ ತೇ ಶುಶ್ರೂಷಮಾಣಾ ಅಪಿ ಶ್ರೋತುಂ ನಾಲಭನ್ತ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಕೃಷೀವಲೀಯದೃಷ್ಟಾನ್ತಸ್ಯಾರ್ಥಂ ಶೃಣುತ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಮಾರ್ಗಪಾರ್ಶ್ವೇ ಬೀಜಾನ್ಯುಪ್ತಾನಿ ತಸ್ಯಾರ್ಥ ಏಷಃ, ಯದಾ ಕಶ್ಚಿತ್ ರಾಜ್ಯಸ್ಯ ಕಥಾಂ ನಿಶಮ್ಯ ನ ಬುಧ್ಯತೇ, ತದಾ ಪಾಪಾತ್ಮಾಗತ್ಯ ತದೀಯಮನಸ ಉಪ್ತಾಂ ಕಥಾಂ ಹರನ್ ನಯತಿ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಅಪರಂ ಪಾಷಾಣಸ್ಥಲೇ ಬೀಜಾನ್ಯುಪ್ತಾನಿ ತಸ್ಯಾರ್ಥ ಏಷಃ; ಕಶ್ಚಿತ್ ಕಥಾಂ ಶ್ರುತ್ವೈವ ಹರ್ಷಚಿತ್ತೇನ ಗೃಹ್ಲಾತಿ,</para>
  <para style="p">
    <verse number="21" style="v"/>ಕಿನ್ತು ತಸ್ಯ ಮನಸಿ ಮೂಲಾಪ್ರವಿಷ್ಟತ್ವಾತ್ ಸ ಕಿಞ್ಚಿತ್ಕಾಲಮಾತ್ರಂ ಸ್ಥಿರಸ್ತಿಷ್ಠತಿ; ಪಶ್ಚಾತ ತತ್ಕಥಾಕಾರಣಾತ್ ಕೋಪಿ ಕ್ಲೇಸ್ತಾಡನಾ ವಾ ಚೇತ್ ಜಾಯತೇ, ತರ್ಹಿ ಸ ತತ್ಕ್ಷಣಾದ್ ವಿಘ್ನಮೇತಿ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಅಪರಂ ಕಣ್ಟಕಾನಾಂ ಮಧ್ಯೇ ಬೀಜಾನ್ಯುಪ್ತಾನಿ ತದರ್ಥ ಏಷಃ; ಕೇನಚಿತ್ ಕಥಾಯಾಂ ಶ್ರುತಾಯಾಂ ಸಾಂಸಾರಿಕಚಿನ್ತಾಭಿ ರ್ಭ್ರಾನ್ತಿಭಿಶ್ಚ ಸಾ ಗ್ರಸ್ಯತೇ, ತೇನ ಸಾ ಮಾ ವಿಫಲಾ ಭವತಿ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಅಪರಮ್ ಉರ್ವ್ವರಾಯಾಂ ಬೀಜಾನ್ಯುಪ್ತಾನಿ ತದರ್ಥ ಏಷಃ; ಯೇ ತಾಂ ಕಥಾಂ ಶ್ರುತ್ವಾ ವುಧ್ಯನ್ತೇ, ತೇ ಫಲಿತಾಃ ಸನ್ತಃ ಕೇಚಿತ್ ಶತಗುಣಾನಿ ಕೇಚಿತ ಷಷ್ಟಿಗುಣಾನಿ ಕೇಚಿಚ್ಚ ತ್ರಿಂಶದ್ಗುಣಾನಿ ಫಲಾನಿ ಜನಯನ್ತಿ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಅನನ್ತರಂ ಸೋಪರಾಮೇಕಾಂ ದೃಷ್ಟಾನ್ತಕಥಾಮುಪಸ್ಥಾಪ್ಯ ತೇಭ್ಯಃ ಕಥಯಾಮಾಸ; ಸ್ವರ್ಗೀಯರಾಜ್ಯಂ ತಾದೃಶೇನ ಕೇನಚಿದ್ ಗೃಹಸ್ಥೇನೋಪಮೀಯತೇ, ಯೇನ ಸ್ವೀಯಕ್ಷೇತ್ರೇ ಪ್ರಶಸ್ತಬೀಜಾನ್ಯೌಪ್ಯನ್ತ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಕಿನ್ತು ಕ್ಷಣದಾಯಾಂ ಸಕಲಲೋಕೇಷು ಸುಪ್ತೇಷು ತಸ್ಯ ರಿಪುರಾಗತ್ಯ ತೇಷಾಂ ಗೋಧೂಮಬೀಜಾನಾಂ ಮಧ್ಯೇ ವನ್ಯಯವಮಬೀಜಾನ್ಯುಪ್ತ್ವಾ ವವ್ರಾಜ|</para>
  <para style="p">
    <verse number="26" style="v"/>ತತೋ ಯದಾ ಬೀಜೇಭ್ಯೋಽಙ್ಕರಾ ಜಾಯಮಾನಾಃ ಕಣಿಶಾನಿ ಘೃತವನ್ತಃ; ತದಾ ವನ್ಯಯವಸಾನ್ಯಪಿ ದೃಶ್ಯಮಾನಾನ್ಯಭವನ್|</para>
  <para style="p">
    <verse number="27" style="v"/>ತತೋ ಗೃಹಸ್ಥಸ್ಯ ದಾಸೇಯಾ ಆಗಮ್ಯ ತಸ್ಮೈ ಕಥಯಾಞ್ಚಕ್ರುಃ, ಹೇ ಮಹೇಚ್ಛ, ಭವತಾ ಕಿಂ ಕ್ಷೇತ್ರೇ ಭದ್ರಬೀಜಾನಿ ನೌಪ್ಯನ್ತ? ತಥಾತ್ವೇ ವನ್ಯಯವಸಾನಿ ಕೃತ ಆಯನ್?</para>
  <para style="p">
    <verse number="28" style="v"/>ತದಾನೀಂ ತೇನ ತೇ ಪ್ರತಿಗದಿತಾಃ, ಕೇನಚಿತ್ ರಿಪುಣಾ ಕರ್ಮ್ಮದಮಕಾರಿ| ದಾಸೇಯಾಃ ಕಥಯಾಮಾಸುಃ, ವಯಂ ಗತ್ವಾ ತಾನ್ಯುತ್ಪಾಯ್ಯ ಕ್ಷಿಪಾಮೋ ಭವತಃ ಕೀದೃಶೀಚ್ಛಾ ಜಾಯತೇ?</para>
  <para style="p">
    <verse number="29" style="v"/>ತೇನಾವಾದಿ, ನಹಿ, ಶಙ್ಕೇಽಹಂ ವನ್ಯಯವಸೋತ್ಪಾಟನಕಾಲೇ ಯುಷ್ಮಾಭಿಸ್ತೈಃ ಸಾಕಂ ಗೋಧೂಮಾ ಅಪ್ಯುತ್ಪಾಟಿಷ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="30" style="v"/>ಅತಃ ಶ್ಸ್ಯಕರ್ತ್ತನಕಾಲಂ ಯಾವದ್ ಉಭಯಾನ್ಯಪಿ ಸಹ ವರ್ದ್ಧನ್ತಾಂ, ಪಶ್ಚಾತ್ ಕರ್ತ್ತನಕಾಲೇ ಕರ್ತ್ತಕಾನ್ ವಕ್ಷ್ಯಾಮಿ, ಯೂಯಮಾದೌ ವನ್ಯಯವಸಾನಿ ಸಂಗೃಹ್ಯ ದಾಹಯಿತುಂ ವೀಟಿಕಾ ಬದ್ವ್ವಾ ಸ್ಥಾಪಯತ; ಕಿನ್ತು ಸರ್ವ್ವೇ ಗೋಧೂಮಾ ಯುಷ್ಮಾಭಿ ರ್ಭಾಣ್ಡಾಗಾರಂ ನೀತ್ವಾ ಸ್ಥಾಪ್ಯನ್ತಾಮ್|</para>
  <para style="p">
    <verse number="31" style="v"/>ಅನನ್ತರಂ ಸೋಪರಾಮೇಕಾಂ ದೃಷ್ಟಾನ್ತಕಥಾಮುತ್ಥಾಪ್ಯ ತೇಭ್ಯಃ ಕಥಿತವಾನ್ ಕಶ್ಚಿನ್ಮನುಜಃ ಸರ್ಷಪಬೀಜಮೇಕಂ ನೀತ್ವಾ ಸ್ವಕ್ಷೇತ್ರ ಉವಾಪ|</para>
  <para style="p">
    <verse number="32" style="v"/>ಸರ್ಷಪಬೀಜಂ ಸರ್ವ್ವಸ್ಮಾದ್ ಬೀಜಾತ್ ಕ್ಷುದ್ರಮಪಿ ಸದಙ್ಕುರಿತಂ ಸರ್ವ್ವಸ್ಮಾತ್ ಶಾಕಾತ್ ಬೃಹದ್ ಭವತಿ; ಸ ತಾದೃಶಸ್ತರು ರ್ಭವತಿ, ಯಸ್ಯ ಶಾಖಾಸು ನಭಸಃ ಖಗಾ ಆಗತ್ಯ ನಿವಸನ್ತಿ; ಸ್ವರ್ಗೀಯರಾಜ್ಯಂ ತಾದೃಶಸ್ಯ ಸರ್ಷಪೈಕಸ್ಯ ಸಮಮ್|</para>
  <para style="p">
    <verse number="33" style="v"/>ಪುನರಪಿ ಸ ಉಪಮಾಕಥಾಮೇಕಾಂ ತೇಭ್ಯಃ ಕಥಯಾಞ್ಚಕಾರ; ಕಾಚನ ಯೋಷಿತ್ ಯತ್ ಕಿಣ್ವಮಾದಾಯ ದ್ರೋಣತ್ರಯಮಿತಗೋಧೂಮಚೂರ್ಣಾನಾಂ ಮಧ್ಯೇ ಸರ್ವ್ವೇಷಾಂ ಮಿಶ್ರೀಭವನಪರ್ಯ್ಯನ್ತಂ ಸಮಾಚ್ಛಾದ್ಯ ನಿಧತ್ತವತೀ, ತತ್ಕಿಣ್ವಮಿವ ಸ್ವರ್ಗರಾಜ್ಯಂ|</para>
  <para style="p">
    <verse number="34" style="v"/>ಇತ್ಥಂ ಯೀಶು ರ್ಮನುಜನಿವಹಾನಾಂ ಸನ್ನಿಧಾವುಪಮಾಕಥಾಭಿರೇತಾನ್ಯಾಖ್ಯಾನಾನಿ ಕಥಿತವಾನ್ ಉಪಮಾಂ ವಿನಾ ತೇಭ್ಯಃ ಕಿಮಪಿ ಕಥಾಂ ನಾಕಥಯತ್|</para>
  <para style="p">
    <verse number="35" style="v"/>ಏತೇನ ದೃಷ್ಟಾನ್ತೀಯೇನ ವಾಕ್ಯೇನ ವ್ಯಾದಾಯ ವದನಂ ನಿಜಂ| ಅಹಂ ಪ್ರಕಾಶಯಿಷ್ಯಾಮಿ ಗುಪ್ತವಾಕ್ಯಂ ಪುರಾಭವಂ| ಯದೇತದ್ವಚನಂ ಭವಿಷ್ಯದ್ವಾದಿನಾ ಪ್ರೋಕ್ತಮಾಸೀತ್, ತತ್ ಸಿದ್ಧಮಭವತ್|</para>
  <para style="p">
    <verse number="36" style="v"/>ಸರ್ವ್ವಾನ್ ಮನುಜಾನ್ ವಿಸೃಜ್ಯ ಯೀಶೌ ಗೃಹಂ ಪ್ರವಿಷ್ಟೇ ತಚ್ಛಿಷ್ಯಾ ಆಗತ್ಯ ಯೀಶವೇ ಕಥಿತವನ್ತಃ, ಕ್ಷೇತ್ರಸ್ಯ ವನ್ಯಯವಸೀಯದೃಷ್ಟಾನ್ತಕಥಾಮ್ ಭವಾನ ಅಸ್ಮಾನ್ ಸ್ಪಷ್ಟೀಕೃತ್ಯ ವದತು|</para>
  <para style="p">
    <verse number="37" style="v"/>ತತಃ ಸ ಪ್ರತ್ಯುವಾಚ, ಯೇನ ಭದ್ರಬೀಜಾನ್ಯುಪ್ಯನ್ತೇ ಸ ಮನುಜಪುತ್ರಃ,</para>
  <para style="p">
    <verse number="38" style="v"/>ಕ್ಷೇತ್ರಂ ಜಗತ್, ಭದ್ರಬೀಜಾನೀ ರಾಜ್ಯಸ್ಯ ಸನ್ತಾನಾಃ,</para>
  <para style="p">
    <verse number="39" style="v"/>ವನ್ಯಯವಸಾನಿ ಪಾಪಾತ್ಮನಃ ಸನ್ತಾನಾಃ| ಯೇನ ರಿಪುಣಾ ತಾನ್ಯುಪ್ತಾನಿ ಸ ಶಯತಾನಃ, ಕರ್ತ್ತನಸಮಯಶ್ಚ ಜಗತಃ ಶೇಷಃ, ಕರ್ತ್ತಕಾಃ ಸ್ವರ್ಗೀಯದೂತಾಃ|</para>
  <para style="p">
    <verse number="40" style="v"/>ಯಥಾ ವನ್ಯಯವಸಾನಿ ಸಂಗೃಹ್ಯ ದಾಹ್ಯನ್ತೇ, ತಥಾ ಜಗತಃ ಶೇಷೇ ಭವಿಷ್ಯತಿ;</para>
  <para style="p">
    <verse number="41" style="v"/>ಅರ್ಥಾತ್ ಮನುಜಸುತಃ ಸ್ವಾಂಯದೂತಾನ್ ಪ್ರೇಷಯಿಷ್ಯತಿ, ತೇನ ತೇ ಚ ತಸ್ಯ ರಾಜ್ಯಾತ್ ಸರ್ವ್ವಾನ್ ವಿಘ್ನಕಾರಿಣೋಽಧಾರ್ಮ್ಮಿಕಲೋಕಾಂಶ್ಚ ಸಂಗೃಹ್ಯ</para>
  <para style="p">
    <verse number="42" style="v"/>ಯತ್ರ ರೋದನಂ ದನ್ತಘರ್ಷಣಞ್ಚ ಭವತಿ, ತತ್ರಾಗ್ನಿಕುಣ್ಡೇ ನಿಕ್ಷೇಪ್ಸ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="43" style="v"/>ತದಾನೀಂ ಧಾರ್ಮ್ಮಿಕಲೋಕಾಃ ಸ್ವೇಷಾಂ ಪಿತೂ ರಾಜ್ಯೇ ಭಾಸ್ಕರಇವ ತೇಜಸ್ವಿನೋ ಭವಿಷ್ಯನ್ತಿ| ಶ್ರೋತುಂ ಯಸ್ಯ ಶ್ರುತೀ ಆಸಾತೇ, ಮ ಶೃಣುಯಾತ್|</para>
  <para style="p">
    <verse number="44" style="v"/>ಅಪರಞ್ಚ ಕ್ಷೇತ್ರಮಧ್ಯೇ ನಿಧಿಂ ಪಶ್ಯನ್ ಯೋ ಗೋಪಯತಿ, ತತಃ ಪರಂ ಸಾನನ್ದೋ ಗತ್ವಾ ಸ್ವೀಯಸರ್ವ್ವಸ್ವಂ ವಿಕ್ರೀಯ ತ್ತಕ್ಷೇತ್ರಂ ಕ್ರೀಣಾತಿ, ಸ ಇವ ಸ್ವರ್ಗರಾಜ್ಯಂ|</para>
  <para style="p">
    <verse number="45" style="v"/>ಅನ್ಯಞ್ಚ ಯೋ ವಣಿಕ್ ಉತ್ತಮಾಂ ಮುಕ್ತಾಂ ಗವೇಷಯನ್</para>
  <para style="p">
    <verse number="46" style="v"/>ಮಹಾರ್ಘಾಂ ಮುಕ್ತಾಂ ವಿಲೋಕ್ಯ ನಿಜಸರ್ವ್ವಸ್ವಂ ವಿಕ್ರೀಯ ತಾಂ ಕ್ರೀಣಾತಿ, ಸ ಇವ ಸ್ವರ್ಗರಾಜ್ಯಂ|</para>
  <para style="p">
    <verse number="47" style="v"/>ಪುನಶ್ಚ ಸಮುದ್ರೋ ನಿಕ್ಷಿಪ್ತಃ ಸರ್ವ್ವಪ್ರಕಾರಮೀನಸಂಗ್ರಾಹ್ಯಾನಾಯಇವ ಸ್ವರ್ಗರಾಜ್ಯಂ|</para>
  <para style="p">
    <verse number="48" style="v"/>ತಸ್ಮಿನ್ ಆನಾಯೇ ಪೂರ್ಣೇ ಜನಾ ಯಥಾ ರೋಧಸ್ಯುತ್ತೋಲ್ಯ ಸಮುಪವಿಶ್ಯ ಪ್ರಶಸ್ತಮೀನಾನ್ ಸಂಗ್ರಹ್ಯ ಭಾಜನೇಷು ನಿದಧತೇ, ಕುತ್ಸಿತಾನ್ ನಿಕ್ಷಿಪನ್ತಿ;</para>
  <para style="p">
    <verse number="49" style="v"/>ತಥೈವ ಜಗತಃ ಶೇಷೇ ಭವಿಷ್ಯತಿ, ಫಲತಃ ಸ್ವರ್ಗೀಯದೂತಾ ಆಗತ್ಯ ಪುಣ್ಯವಜ್ಜನಾನಾಂ ಮಧ್ಯಾತ್ ಪಾಪಿನಃ ಪೃಥಕ್ ಕೃತ್ವಾ ವಹ್ನಿಕುಣ್ಡೇ ನಿಕ್ಷೇಪ್ಸ್ಯನ್ತಿ,</para>
  <para style="p">
    <verse number="50" style="v"/>ತತ್ರ ರೋದನಂ ದನ್ತೈ ರ್ದನ್ತಘರ್ಷಣಞ್ಚ ಭವಿಷ್ಯತಃ|</para>
  <para style="p">
    <verse number="51" style="v"/>ಯೀಶುನಾ ತೇ ಪೃಷ್ಟಾ ಯುಷ್ಮಾಭಿಃ ಕಿಮೇತಾನ್ಯಾಖ್ಯಾನಾನ್ಯಬುಧ್ಯನ್ತ? ತದಾ ತೇ ಪ್ರತ್ಯವದನ್, ಸತ್ಯಂ ಪ್ರಭೋ|</para>
  <para style="p">
    <verse number="52" style="v"/>ತದಾನೀಂ ಸ ಕಥಿತವಾನ್, ನಿಜಭಾಣ್ಡಾಗಾರಾತ್ ನವೀನಪುರಾತನಾನಿ ವಸ್ತೂನಿ ನಿರ್ಗಮಯತಿ ಯೋ ಗೃಹಸ್ಥಃ ಸ ಇವ ಸ್ವರ್ಗರಾಜ್ಯಮಧಿ ಶಿಕ್ಷಿತಾಃ ಸ್ವರ್ವ ಉಪದೇಷ್ಟಾರಃ|</para>
  <para style="p">
    <verse number="53" style="v"/>ಅನನ್ತರಂ ಯೀಶುರೇತಾಃ ಸರ್ವ್ವಾ ದೃಷ್ಟಾನ್ತಕಥಾಃ ಸಮಾಪ್ಯ ತಸ್ಮಾತ್ ಸ್ಥಾನಾತ್ ಪ್ರತಸ್ಥೇ| ಅಪರಂ ಸ್ವದೇಶಮಾಗತ್ಯ ಜನಾನ್ ಭಜನಭವನ ಉಪದಿಷ್ಟವಾನ್;</para>
  <para style="p">
    <verse number="54" style="v"/>ತೇ ವಿಸ್ಮಯಂ ಗತ್ವಾ ಕಥಿತವನ್ತ ಏತಸ್ಯೈತಾದೃಶಂ ಜ್ಞಾನಮ್ ಆಶ್ಚರ್ಯ್ಯಂ ಕರ್ಮ್ಮ ಚ ಕಸ್ಮಾದ್ ಅಜಾಯತ?</para>
  <para style="p">
    <verse number="55" style="v"/>ಕಿಮಯಂ ಸೂತ್ರಧಾರಸ್ಯ ಪುತ್ರೋ ನಹಿ? ಏತಸ್ಯ ಮಾತು ರ್ನಾಮ ಚ ಕಿಂ ಮರಿಯಮ್ ನಹಿ? ಯಾಕುಬ್-ಯೂಷಫ್-ಶಿಮೋನ್-ಯಿಹೂದಾಶ್ಚ ಕಿಮೇತಸ್ಯ ಭ್ರಾತರೋ ನಹಿ?</para>
  <para style="p">
    <verse number="56" style="v"/>ಏತಸ್ಯ ಭಗಿನ್ಯಶ್ಚ ಕಿಮಸ್ಮಾಕಂ ಮಧ್ಯೇ ನ ಸನ್ತಿ? ತರ್ಹಿ ಕಸ್ಮಾದಯಮೇತಾನಿ ಲಬ್ಧವಾನ್? ಇತ್ಥಂ ಸ ತೇಷಾಂ ವಿಘ್ನರೂಪೋ ಬಭೂವ;</para>
  <para style="p">
    <verse number="57" style="v"/>ತತೋ ಯೀಶುನಾ ನಿಗದಿತಂ ಸ್ವದೇಶೀಯಜನಾನಾಂ ಮಧ್ಯಂ ವಿನಾ ಭವಿಷ್ಯದ್ವಾದೀ ಕುತ್ರಾಪ್ಯನ್ಯತ್ರ ನಾಸಮ್ಮಾನ್ಯೋ ಭವತೀ|</para>
  <para style="p">
    <verse number="58" style="v"/>ತೇಷಾಮವಿಶ್ವಾಸಹೇತೋಃ ಸ ತತ್ರ ಸ್ಥಾನೇ ಬಹ್ವಾಶ್ಚರ್ಯ್ಯಕರ್ಮ್ಮಾಣಿ ನ ಕೃತವಾನ್|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ತದಾನೀಂ ರಾಜಾ ಹೇರೋದ್ ಯೀಶೋ ರ್ಯಶಃ ಶ್ರುತ್ವಾ ನಿಜದಾಸೇಯಾನ್ ಜಗಾದ್,</para>
  <para style="p">
    <verse number="2" style="v"/>ಏಷ ಮಜ್ಜಯಿತಾ ಯೋಹನ್, ಪ್ರಮಿತೇಭಯಸ್ತಸ್ಯೋತ್ಥಾನಾತ್ ತೇನೇತ್ಥಮದ್ಭುತಂ ಕರ್ಮ್ಮ ಪ್ರಕಾಶ್ಯತೇ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಪುರಾ ಹೇರೋದ್ ನಿಜಭ್ರಾತು: ಫಿಲಿಪೋ ಜಾಯಾಯಾ ಹೇರೋದೀಯಾಯಾ ಅನುರೋಧಾದ್ ಯೋಹನಂ ಧಾರಯಿತ್ವಾ ಬದ್ಧಾ ಕಾರಾಯಾಂ ಸ್ಥಾಪಿತವಾನ್|</para>
  <para style="p">
    <verse number="4" style="v"/>ಯತೋ ಯೋಹನ್ ಉಕ್ತವಾನ್, ಏತ್ಸಯಾಃ ಸಂಗ್ರಹೋ ಭವತೋ ನೋಚಿತಃ|</para>
  <para style="p">
    <verse number="5" style="v"/>ತಸ್ಮಾತ್ ನೃಪತಿಸ್ತಂ ಹನ್ತುಮಿಚ್ಛನ್ನಪಿ ಲೋಕೇಭ್ಯೋ ವಿಭಯಾಞ್ಚಕಾರ; ಯತಃ ಸರ್ವ್ವೇ ಯೋಹನಂ ಭವಿಷ್ಯದ್ವಾದಿನಂ ಮೇನಿರೇ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಕಿನ್ತು ಹೇರೋದೋ ಜನ್ಮಾಹೀಯಮಹ ಉಪಸ್ಥಿತೇ ಹೇರೋದೀಯಾಯಾ ದುಹಿತಾ ತೇಷಾಂ ಸಮಕ್ಷಂ ನೃತಿತ್ವಾ ಹೇರೋದಮಪ್ರೀಣ್ಯತ್|</para>
  <para style="p">
    <verse number="7" style="v"/>ತಸ್ಮಾತ್ ಭೂಪತಿಃ ಶಪಥಂ ಕುರ್ವ್ವನ್ ಇತಿ ಪ್ರತ್ಯಜ್ಞಾಸೀತ್, ತ್ವಯಾ ಯದ್ ಯಾಚ್ಯತೇ, ತದೇವಾಹಂ ದಾಸ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಸಾ ಕುಮಾರೀ ಸ್ವೀಯಮಾತುಃ ಶಿಕ್ಷಾಂ ಲಬ್ಧಾ ಬಭಾಷೇ, ಮಜ್ಜಯಿತುರ್ಯೋಹನ ಉತ್ತಮಾಙ್ಗಂ ಭಾಜನೇ ಸಮಾನೀಯ ಮಹ್ಯಂ ವಿಶ್ರಾಣಯ|</para>
  <para style="p">
    <verse number="9" style="v"/>ತತೋ ರಾಜಾ ಶುಶೋಚ, ಕಿನ್ತು ಭೋಜನಾಯೋಪವಿಶತಾಂ ಸಙ್ಗಿನಾಂ ಸ್ವಕೃತಶಪಥಸ್ಯ ಚಾನುರೋಧಾತ್ ತತ್ ಪ್ರದಾತುಮ ಆದಿದೇಶ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಪಶ್ಚಾತ್ ಕಾರಾಂ ಪ್ರತಿ ನರಂ ಪ್ರಹಿತ್ಯ ಯೋಹನ ಉತ್ತಮಾಙ್ಗಂ ಛಿತ್ತ್ವಾ</para>
  <para style="p">
    <verse number="11" style="v"/>ತತ್ ಭಾಜನ ಆನಾಯ್ಯ ತಸ್ಯೈ ಕುಮಾರ್ಯ್ಯೈ ವ್ಯಶ್ರಾಣಯತ್, ತತಃ ಸಾ ಸ್ವಜನನ್ಯಾಃ ಸಮೀಪಂ ತನ್ನಿನಾಯ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಪಶ್ಚಾತ್ ಯೋಹನಃ ಶಿಷ್ಯಾ ಆಗತ್ಯ ಕಾಯಂ ನೀತ್ವಾ ಶ್ಮಶಾನೇ ಸ್ಥಾಪಯಾಮಾಸುಸ್ತತೋ ಯೀಶೋಃ ಸನ್ನಿಧಿಂ ವ್ರಜಿತ್ವಾ ತದ್ವಾರ್ತ್ತಾಂ ಬಭಾಷಿರೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅನನ್ತರಂ ಯೀಶುರಿತಿ ನಿಶಭ್ಯ ನಾವಾ ನಿರ್ಜನಸ್ಥಾನಮ್ ಏಕಾಕೀ ಗತವಾನ್, ಪಶ್ಚಾತ್ ಮಾನವಾಸ್ತತ್ ಶ್ರುತ್ವಾ ನಾನಾನಗರೇಭ್ಯ ಆಗತ್ಯ ಪದೈಸ್ತತ್ಪಶ್ಚಾದ್ ಈಯುಃ|</para>
  <para style="p">
    <verse number="14" style="v"/>ತದಾನೀಂ ಯೀಶು ರ್ಬಹಿರಾಗತ್ಯ ಮಹಾನ್ತಂ ಜನನಿವಹಂ ನಿರೀಕ್ಷ್ಯ ತೇಷು ಕಾರುಣಿಕಃ ಮನ್ ತೇಷಾಂ ಪೀಡಿತಜನಾನ್ ನಿರಾಮಯಾನ್ ಚಕಾರ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತತಃ ಪರಂ ಸನ್ಧ್ಯಾಯಾಂ ಶಿಷ್ಯಾಸ್ತದನ್ತಿಕಮಾಗತ್ಯ ಕಥಯಾಞ್ಚಕ್ರುಃ, ಇದಂ ನಿರ್ಜನಸ್ಥಾನಂ ವೇಲಾಪ್ಯವಸನ್ನಾ; ತಸ್ಮಾತ್ ಮನುಜಾನ್ ಸ್ವಸ್ವಗ್ರಾಮಂ ಗನ್ತುಂ ಸ್ವಾರ್ಥಂ ಭಕ್ಷ್ಯಾಣಿ ಕ್ರೇತುಞ್ಚ ಭವಾನ್ ತಾನ್ ವಿಸೃಜತು|</para>
  <para style="p">
    <verse number="16" style="v"/>ಕಿನ್ತು ಯೀಶುಸ್ತಾನವಾದೀತ್, ತೇಷಾಂ ಗಮನೇ ಪ್ರಯೋಜನಂ ನಾಸ್ತಿ, ಯೂಯಮೇವ ತಾನ್ ಭೋಜಯತ|</para>
  <para style="p">
    <verse number="17" style="v"/>ತದಾ ತೇ ಪ್ರತ್ಯವದನ್, ಅಸ್ಮಾಕಮತ್ರ ಪೂಪಪಞ್ಚಕಂ ಮೀನದ್ವಯಞ್ಚಾಸ್ತೇ|</para>
  <para style="p">
    <verse number="18" style="v"/>ತದಾನೀಂ ತೇನೋಕ್ತಂ ತಾನಿ ಮದನ್ತಿಕಮಾನಯತ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಅನನ್ತರಂ ಸ ಮನುಜಾನ್ ಯವಸೋಪರ್ಯ್ಯುಪವೇಷ್ಟುಮ್ ಆಜ್ಞಾಪಯಾಮಾಸ; ಅಪರ ತತ್ ಪೂಪಪಞ್ಚಕಂ ಮೀನದ್ವಯಞ್ಚ ಗೃಹ್ಲನ್ ಸ್ವರ್ಗಂ ಪ್ರತಿ ನಿರೀಕ್ಷ್ಯೇಶ್ವರೀಯಗುಣಾನ್ ಅನೂದ್ಯ ಭಂಕ್ತ್ವಾ ಶಿಷ್ಯೇಭ್ಯೋ ದತ್ತವಾನ್, ಶಿಷ್ಯಾಶ್ಚ ಲೋಕೇಭ್ಯೋ ದದುಃ|</para>
  <para style="p">
    <verse number="20" style="v"/>ತತಃ ಸರ್ವ್ವೇ ಭುಕ್ತ್ವಾ ಪರಿತೃಪ್ತವನ್ತಃ, ತತಸ್ತದವಶಿಷ್ಟಭಕ್ಷ್ಯೈಃ ಪೂರ್ಣಾನ್ ದ್ವಾದಶಡಲಕಾನ್ ಗೃಹೀತವನ್ತಃ|</para>
  <para style="p">
    <verse number="21" style="v"/>ತೇ ಭೋಕ್ತಾರಃ ಸ್ತ್ರೀರ್ಬಾಲಕಾಂಶ್ಚ ವಿಹಾಯ ಪ್ರಾಯೇಣ ಪಞ್ಚ ಸಹಸ್ರಾಣಿ ಪುಮಾಂಸ ಆಸನ್|</para>
  <para style="p">
    <verse number="22" style="v"/>ತದನನ್ತರಂ ಯೀಶು ರ್ಲೋಕಾನಾಂ ವಿಸರ್ಜನಕಾಲೇ ಶಿಷ್ಯಾನ್ ತರಣಿಮಾರೋಢುಂ ಸ್ವಾಗ್ರೇ ಪಾರಂ ಯಾತುಞ್ಚ ಗಾಢಮಾದಿಷ್ಟವಾನ್|</para>
  <para style="p">
    <verse number="23" style="v"/>ತತೋ ಲೋಕೇಷು ವಿಸೃಷ್ಟೇಷು ಸ ವಿವಿಕ್ತೇ ಪ್ರಾರ್ಥಯಿತುಂ ಗಿರಿಮೇಕಂ ಗತ್ವಾ ಸನ್ಧ್ಯಾಂ ಯಾವತ್ ತತ್ರೈಕಾಕೀ ಸ್ಥಿತವಾನ್|</para>
  <para style="p">
    <verse number="24" style="v"/>ಕಿನ್ತು ತದಾನೀಂ ಸಮ್ಮುಖವಾತತ್ವಾತ್ ಸರಿತ್ಪತೇ ರ್ಮಧ್ಯೇ ತರಙ್ಗೈಸ್ತರಣಿರ್ದೋಲಾಯಮಾನಾಭವತ್|</para>
  <para style="p">
    <verse number="25" style="v"/>ತದಾ ಸ ಯಾಮಿನ್ಯಾಶ್ಚತುರ್ಥಪ್ರಹರೇ ಪದ್ಭ್ಯಾಂ ವ್ರಜನ್ ತೇಷಾಮನ್ತಿಕಂ ಗತವಾನ್|</para>
  <para style="p">
    <verse number="26" style="v"/>ಕಿನ್ತು ಶಿಷ್ಯಾಸ್ತಂ ಸಾಗರೋಪರಿ ವ್ರಜನ್ತಂ ವಿಲೋಕ್ಯ ಸಮುದ್ವಿಗ್ನಾ ಜಗದುಃ, ಏಷ ಭೂತ ಇತಿ ಶಙ್ಕಮಾನಾ ಉಚ್ಚೈಃ ಶಬ್ದಾಯಾಞ್ಚಕ್ರಿರೇ ಚ|</para>
  <para style="p">
    <verse number="27" style="v"/>ತದೈವ ಯೀಶುಸ್ತಾನವದತ್, ಸುಸ್ಥಿರಾ ಭವತ, ಮಾ ಭೈಷ್ಟ, ಏಷೋಽಹಮ್|</para>
  <para style="p">
    <verse number="28" style="v"/>ತತಃ ಪಿತರ ಇತ್ಯುಕ್ತವಾನ್, ಹೇ ಪ್ರಭೋ, ಯದಿ ಭವಾನೇವ, ತರ್ಹಿ ಮಾಂ ಭವತ್ಸಮೀಪಂ ಯಾತುಮಾಜ್ಞಾಪಯತು|</para>
  <para style="p">
    <verse number="29" style="v"/>ತತಃ ತೇನಾದಿಷ್ಟಃ ಪಿತರಸ್ತರಣಿತೋಽವರುಹ್ಯ ಯೀಶೇाರನ್ತಿಕಂ ಪ್ರಾಪ್ತುಂ ತೋಯೋಪರಿ ವವ್ರಾಜ|</para>
  <para style="p">
    <verse number="30" style="v"/>ಕಿನ್ತು ಪ್ರಚಣ್ಡಂ ಪವನಂ ವಿಲೋಕ್ಯ ಭಯಾತ್ ತೋಯೇ ಮಂಕ್ತುಮ್ ಆರೇಭೇ, ತಸ್ಮಾದ್ ಉಚ್ಚೈಃ ಶಬ್ದಾಯಮಾನಃ ಕಥಿತವಾನ್, ಹೇ ಪ್ರಭೋ, ಮಾಮವತು|</para>
  <para style="p">
    <verse number="31" style="v"/>ಯೀಶುಸ್ತತ್ಕ್ಷಣಾತ್ ಕರಂ ಪ್ರಸಾರ್ಯ್ಯ ತಂ ಧರನ್ ಉಕ್ತವಾನ್, ಹ ಸ್ತೋಕಪ್ರತ್ಯಯಿನ್ ತ್ವಂ ಕುತಃ ಸಮಶೇಥಾಃ?</para>
  <para style="p">
    <verse number="32" style="v"/>ಅನನ್ತರಂ ತಯೋಸ್ತರಣಿಮಾರೂಢಯೋಃ ಪವನೋ ನಿವವೃತೇ|</para>
  <para style="p">
    <verse number="33" style="v"/>ತದಾನೀಂ ಯೇ ತರಣ್ಯಾಮಾಸನ್, ತ ಆಗತ್ಯ ತಂ ಪ್ರಣಭ್ಯ ಕಥಿತವನ್ತಃ, ಯಥಾರ್ಥಸ್ತ್ವಮೇವೇಶ್ವರಸುತಃ|</para>
  <para style="p">
    <verse number="34" style="v"/>ಅನನ್ತರಂ ಪಾರಂ ಪ್ರಾಪ್ಯ ತೇ ಗಿನೇಷರನ್ನಾಮಕಂ ನಗರಮುಪತಸ್ಥುಃ,</para>
  <para style="p">
    <verse number="35" style="v"/>ತದಾ ತತ್ರತ್ಯಾ ಜನಾ ಯೀಶುಂ ಪರಿಚೀಯ ತದ್ದೇಶ್ಸ್ಯ ಚತುರ್ದಿಶೋ ವಾರ್ತ್ತಾಂ ಪ್ರಹಿತ್ಯ ಯತ್ರ ಯಾವನ್ತಃ ಪೀಡಿತಾ ಆಸನ್, ತಾವತಏವ ತದನ್ತಿಕಮಾನಯಾಮಾಸುಃ|</para>
  <para style="p">
    <verse number="36" style="v"/>ಅಪರಂ ತದೀಯವಸನಸ್ಯ ಗ್ರನ್ಥಿಮಾತ್ರಂ ಸ್ಪ್ರಷ್ಟುಂ ವಿನೀಯ ಯಾವನ್ತೋ ಜನಾಸ್ತತ್ ಸ್ಪರ್ಶಂ ಚಕ್ರಿರೇ, ತೇ ಸರ್ವ್ವಏವ ನಿರಾಮಯಾ ಬಭೂವುಃ|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅಪರಂ ಯಿರೂಶಾಲಮ್ನಗರೀಯಾಃ ಕತಿಪಯಾ ಅಧ್ಯಾಪಕಾಃ ಫಿರೂಶಿನಶ್ಚ ಯೀಶೋಃ ಸಮೀಪಮಾಗತ್ಯ ಕಥಯಾಮಾಸುಃ,</para>
  <para style="p">
    <verse number="2" style="v"/>ತವ ಶಿಷ್ಯಾಃ ಕಿಮರ್ಥಮ್ ಅಪ್ರಕ್ಷಾಲಿತಕರೈ ರ್ಭಕ್ಷಿತ್ವಾ ಪರಮ್ಪರಾಗತಂ ಪ್ರಾಚೀನಾನಾಂ ವ್ಯವಹಾರಂ ಲಙ್ವನ್ತೇ?</para>
  <para style="p">
    <verse number="3" style="v"/>ತತೋ ಯೀಶುಃ ಪ್ರತ್ಯುವಾಚ, ಯೂಯಂ ಪರಮ್ಪರಾಗತಾಚಾರೇಣ ಕುತ ಈಶ್ವರಾಜ್ಞಾಂ ಲಙ್ವಧ್ವೇ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಈಶ್ವರ ಇತ್ಯಾಜ್ಞಾಪಯತ್, ತ್ವಂ ನಿಜಪಿತರೌ ಸಂಮನ್ಯೇಥಾಃ, ಯೇನ ಚ ನಿಜಪಿತರೌ ನಿನ್ದ್ಯೇತೇ, ಸ ನಿಶ್ಚಿತಂ ಮ್ರಿಯೇತ;</para>
  <para style="p">
    <verse number="5" style="v"/>ಕಿನ್ತು ಯೂಯಂ ವದಥ, ಯಃ ಸ್ವಜನಕಂ ಸ್ವಜನನೀಂ ವಾ ವಾಕ್ಯಮಿದಂ ವದತಿ, ಯುವಾಂ ಮತ್ತೋ ಯಲ್ಲಭೇಥೇ, ತತ್ ನ್ಯವಿದ್ಯತ,</para>
  <para style="p">
    <verse number="6" style="v"/>ಸ ನಿಜಪಿತರೌ ಪುನ ರ್ನ ಸಂಮಂಸ್ಯತೇ| ಇತ್ಥಂ ಯೂಯಂ ಪರಮ್ಪರಾಗತೇನ ಸ್ವೇಷಾಮಾಚಾರೇಣೇಶ್ವರೀಯಾಜ್ಞಾಂ ಲುಮ್ಪಥ|</para>
  <para style="p">
    <verse number="7" style="v"/>ರೇ ಕಪಟಿನಃ ಸರ್ವ್ವೇ ಯಿಶಯಿಯೋ ಯುಷ್ಮಾನಧಿ ಭವಿಷ್ಯದ್ವಚನಾನ್ಯೇತಾನಿ ಸಮ್ಯಗ್ ಉಕ್ತವಾನ್|</para>
  <para style="p">
    <verse number="8" style="v"/>ವದನೈ ರ್ಮನುಜಾ ಏತೇ ಸಮಾಯಾನ್ತಿ ಮದನ್ತಿಕಂ| ತಥಾಧರೈ ರ್ಮದೀಯಞ್ಚ ಮಾನಂ ಕುರ್ವ್ವನ್ತಿ ತೇ ನರಾಃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಕಿನ್ತು ತೇಷಾಂ ಮನೋ ಮತ್ತೋ ವಿದೂರಏವ ತಿಷ್ಠತಿ| ಶಿಕ್ಷಯನ್ತೋ ವಿಧೀನ್ ನ್ರಾಜ್ಞಾ ಭಜನ್ತೇ ಮಾಂ ಮುಧೈವ ತೇ|</para>
  <para style="p">
    <verse number="10" style="v"/>ತತೋ ಯೀಶು ರ್ಲೋಕಾನ್ ಆಹೂಯ ಪ್ರೋಕ್ತವಾನ್, ಯೂಯಂ ಶ್ರುತ್ವಾ ಬುಧ್ಯಧ್ಬಂ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಯನ್ಮುಖಂ ಪ್ರವಿಶತಿ, ತತ್ ಮನುಜಮ್ ಅಮೇಧ್ಯಂ ನ ಕರೋತಿ, ಕಿನ್ತು ಯದಾಸ್ಯಾತ್ ನಿರ್ಗಚ್ಛತಿ, ತದೇವ ಮಾನುಷಮಮೇಧ್ಯೀ ಕರೋತೀ|</para>
  <para style="p">
    <verse number="12" style="v"/>ತದಾನೀಂ ಶಿಷ್ಯಾ ಆಗತ್ಯ ತಸ್ಮೈ ಕಥಯಾಞ್ಚಕ್ರುಃ, ಏತಾಂ ಕಥಾಂ ಶ್ರುತ್ವಾ ಫಿರೂಶಿನೋ ವ್ಯರಜ್ಯನ್ತ, ತತ್ ಕಿಂ ಭವತಾ ಜ್ಞಾಯತೇ?</para>
  <para style="p">
    <verse number="13" style="v"/>ಸ ಪ್ರತ್ಯವದತ್, ಮಮ ಸ್ವರ್ಗಸ್ಥಃ ಪಿತಾ ಯಂ ಕಞ್ಚಿದಙ್ಕುರಂ ನಾರೋಪಯತ್, ಸ ಉತ್ಪಾವ್ದ್ಯತೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ತೇ ತಿಷ್ಠನ್ತು, ತೇ ಅನ್ಧಮನುಜಾನಾಮ್ ಅನ್ಧಮಾರ್ಗದರ್ಶಕಾ ಏವ; ಯದ್ಯನ್ಧೋಽನ್ಧಂ ಪನ್ಥಾನಂ ದರ್ಶಯತಿ, ತರ್ಹ್ಯುಭೌ ಗರ್ತ್ತೇ ಪತತಃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತದಾ ಪಿತರಸ್ತಂ ಪ್ರತ್ಯವದತ್, ದೃಷ್ಟಾನ್ತಮಿಮಮಸ್ಮಾನ್ ಬೋಧಯತು|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯೀಶುನಾ ಪ್ರೋಕ್ತಂ, ಯೂಯಮದ್ಯ ಯಾವತ್ ಕಿಮಬೋಧಾಃ ಸ್ಥ?</para>
  <para style="p">
    <verse number="17" style="v"/>ಕಥಾಮಿಮಾಂ ಕಿಂ ನ ಬುಧ್ಯಧ್ಬೇ ? ಯದಾಸ್ಯಂ ಪ್ರೇವಿಶತಿ, ತದ್ ಉದರೇ ಪತನ್ ಬಹಿರ್ನಿರ್ಯಾತಿ,</para>
  <para style="p">
    <verse number="18" style="v"/>ಕಿನ್ತ್ವಾಸ್ಯಾದ್ ಯನ್ನಿರ್ಯಾತಿ, ತದ್ ಅನ್ತಃಕರಣಾತ್ ನಿರ್ಯಾತತ್ವಾತ್ ಮನುಜಮಮೇಧ್ಯಂ ಕರೋತಿ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಯತೋಽನ್ತಃಕರಣಾತ್ ಕುಚಿನ್ತಾ ಬಧಃ ಪಾರದಾರಿಕತಾ ವೇಶ್ಯಾಗಮನಂ ಚೈರ್ಯ್ಯಂ ಮಿಥ್ಯಾಸಾಕ್ಷ್ಯಮ್ ಈಶ್ವರನಿನ್ದಾ ಚೈತಾನಿ ಸರ್ವ್ವಾಣಿ ನಿರ್ಯ್ಯಾನ್ತಿ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಏತಾನಿ ಮನುಷ್ಯಮಪವಿತ್ರೀ ಕುರ್ವ್ವನ್ತಿ ಕಿನ್ತ್ವಪ್ರಕ್ಷಾಲಿತಕರೇಣ ಭೋಜನಂ ಮನುಜಮಮೇಧ್ಯಂ ನ ಕರೋತಿ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಅನನ್ತರಂ ಯೀಶುಸ್ತಸ್ಮಾತ್ ಸ್ಥಾನಾತ್ ಪ್ರಸ್ಥಾಯ ಸೋರಸೀದೋನ್ನಗರಯೋಃ ಸೀಮಾಮುಪತಸ್ಯೌ|</para>
  <para style="p">
    <verse number="22" style="v"/>ತದಾ ತತ್ಸೀಮಾತಃ ಕಾಚಿತ್ ಕಿನಾನೀಯಾ ಯೋಷಿದ್ ಆಗತ್ಯ ತಮುಚ್ಚೈರುವಾಚ, ಹೇ ಪ್ರಭೋ ದಾಯೂದಃ ಸನ್ತಾನ, ಮಮೈಕಾ ದುಹಿತಾಸ್ತೇ ಸಾ ಭೂತಗ್ರಸ್ತಾ ಸತೀ ಮಹಾಕ್ಲೇಶಂ ಪ್ರಾಪ್ನೋತಿ ಮಮ ದಯಸ್ವ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಕಿನ್ತು ಯೀಶುಸ್ತಾಂ ಕಿಮಪಿ ನೋಕ್ತವಾನ್, ತತಃ ಶಿಷ್ಯಾ ಆಗತ್ಯ ತಂ ನಿವೇದಯಾಮಾಸುಃ, ಏಷಾ ಯೋಷಿದ್ ಅಸ್ಮಾಕಂ ಪಶ್ಚಾದ್ ಉಚ್ಚೈರಾಹೂಯಾಗಚ್ಛತಿ, ಏನಾಂ ವಿಸೃಜತು|</para>
  <para style="p">
    <verse number="24" style="v"/>ತದಾ ಸ ಪ್ರತ್ಯವದತ್, ಇಸ್ರಾಯೇಲ್ಗೋತ್ರಸ್ಯ ಹಾರಿತಮೇಷಾನ್ ವಿನಾ ಕಸ್ಯಾಪ್ಯನ್ಯಸ್ಯ ಸಮೀಪಂ ನಾಹಂ ಪ್ರೇಷಿತೋಸ್ಮಿ|</para>
  <para style="p">
    <verse number="25" style="v"/>ತತಃ ಸಾ ನಾರೀಸಮಾಗತ್ಯ ತಂ ಪ್ರಣಮ್ಯ ಜಗಾದ, ಹೇ ಪ್ರಭೋ ಮಾಮುಪಕುರು|</para>
  <para style="p">
    <verse number="26" style="v"/>ಸ ಉಕ್ತವಾನ್, ಬಾಲಕಾನಾಂ ಭಕ್ಷ್ಯಮಾದಾಯ ಸಾರಮೇಯೇಭ್ಯೋ ದಾನಂ ನೋಚಿತಂ|</para>
  <para style="p">
    <verse number="27" style="v"/>ತದಾ ಸಾ ಬಭಾಷೇ, ಹೇ ಪ್ರಭೋ, ತತ್ ಸತ್ಯಂ, ತಥಾಪಿ ಪ್ರಭೋ ರ್ಭಞ್ಚಾದ್ ಯದುಚ್ಛಿಷ್ಟಂ ಪತತಿ, ತತ್ ಸಾರಮೇಯಾಃ ಖಾದನ್ತಿ|</para>
  <para style="p">
    <verse number="28" style="v"/>ತತೋ ಯೀಶುಃ ಪ್ರತ್ಯವದತ್, ಹೇ ಯೋಷಿತ್, ತವ ವಿಶ್ವಾಸೋ ಮಹಾನ್ ತಸ್ಮಾತ್ ತವ ಮನೋಭಿಲಷಿತಂ ಸಿದ್ಯ್ಯತು, ತೇನ ತಸ್ಯಾಃ ಕನ್ಯಾ ತಸ್ಮಿನ್ನೇವ ದಣ್ಡೇ ನಿರಾಮಯಾಭವತ್|</para>
  <para style="p">
    <verse number="29" style="v"/>ಅನನ್ತರಂ ಯೀಶಸ್ತಸ್ಮಾತ್ ಸ್ಥಾನಾತ್ ಪ್ರಸ್ಥಾಯ ಗಾಲೀಲ್ಸಾಗರಸ್ಯ ಸನ್ನಿಧಿಮಾಗತ್ಯ ಧರಾಧರಮಾರುಹ್ಯ ತತ್ರೋಪವಿವೇಶ|</para>
  <para style="p">
    <verse number="30" style="v"/>ಪಶ್ಚಾತ್ ಜನನಿವಹೋ ಬಹೂನ್ ಖಞ್ಚಾನ್ಧಮೂಕಶುಷ್ಕಕರಮಾನುಷಾನ್ ಆದಾಯ ಯೀಶೋಃ ಸಮೀಪಮಾಗತ್ಯ ತಚ್ಚರಣಾನ್ತಿಕೇ ಸ್ಥಾಪಯಾಮಾಸುಃ, ತತಃ ಸಾ ತಾನ್ ನಿರಾಮಯಾನ್ ಅಕರೋತ್|</para>
  <para style="p">
    <verse number="31" style="v"/>ಇತ್ಥಂ ಮೂಕಾ ವಾಕ್ಯಂ ವದನ್ತಿ, ಶುಷ್ಕಕರಾಃ ಸ್ವಾಸ್ಥ್ಯಮಾಯಾನ್ತಿ, ಪಙ್ಗವೋ ಗಚ್ಛನ್ತಿ, ಅನ್ಧಾ ವೀಕ್ಷನ್ತೇ, ಇತಿ ವಿಲೋಕ್ಯ ಲೋಕಾ ವಿಸ್ಮಯಂ ಮನ್ಯಮಾನಾ ಇಸ್ರಾಯೇಲ ಈಶ್ವರಂ ಧನ್ಯಂ ಬಭಾಷಿರೇ|</para>
  <para style="p">
    <verse number="32" style="v"/>ತದಾನೀಂ ಯೀಶುಃ ಸ್ವಶಿಷ್ಯಾನ್ ಆಹೂಯ ಗದಿತವಾನ್, ಏತಜ್ಜನನಿವಹೇಷು ಮಮ ದಯಾ ಜಾಯತೇ, ಏತೇ ದಿನತ್ರಯಂ ಮಯಾ ಸಾಕಂ ಸನ್ತಿ, ಏಷಾಂ ಭಕ್ಷ್ಯವಸ್ತು ಚ ಕಞ್ಚಿದಪಿ ನಾಸ್ತಿ, ತಸ್ಮಾದಹಮೇತಾನಕೃತಾಹಾರಾನ್ ನ ವಿಸ್ರಕ್ಷ್ಯಾಮಿ, ತಥಾತ್ವೇ ವರ್ತ್ಮಮಧ್ಯೇ ಕ್ಲಾಮ್ಯೇಷುಃ|</para>
  <para style="p">
    <verse number="33" style="v"/>ತದಾ ಶಿಷ್ಯಾ ಊಚುಃ, ಏತಸ್ಮಿನ್ ಪ್ರಾನ್ತರಮಧ್ಯ ಏತಾವತೋ ಮರ್ತ್ಯಾನ್ ತರ್ಪಯಿತುಂ ವಯಂ ಕುತ್ರ ಪೂಪಾನ್ ಪ್ರಾಪ್ಸ್ಯಾಮಃ?</para>
  <para style="p">
    <verse number="34" style="v"/>ಯೀಶುರಪೃಚ್ಛತ್, ಯುಷ್ಮಾಕಂ ನಿಕಟೇ ಕತಿ ಪೂಪಾ ಆಸತೇ? ತ ಊಚುಃ, ಸಪ್ತಪೂಪಾ ಅಲ್ಪಾಃ ಕ್ಷುದ್ರಮೀನಾಶ್ಚ ಸನ್ತಿ|</para>
  <para style="p">
    <verse number="35" style="v"/>ತದಾನೀಂ ಸ ಲೋಕನಿವಹಂ ಭೂಮಾವುಪವೇಷ್ಟುಮ್ ಆದಿಶ್ಯ</para>
  <para style="p">
    <verse number="36" style="v"/>ತಾನ್ ಸಪ್ತಪೂಪಾನ್ ಮೀನಾಂಶ್ಚ ಗೃಹ್ಲನ್ ಈಶ್ವರೀಯಗುಣಾನ್ ಅನೂದ್ಯ ಭಂಕ್ತ್ವಾ ಶಿಷ್ಯೇಭ್ಯೋ ದದೌ, ಶಿಷ್ಯಾ ಲೋಕೇಭ್ಯೋ ದದುಃ|</para>
  <para style="p">
    <verse number="37" style="v"/>ತತಃ ಸರ್ವ್ವೇ ಭುಕ್ತ್ವಾ ತೃಪ್ತವನ್ತಃ; ತದವಶಿಷ್ಟಭಕ್ಷ್ಯೇಣ ಸಪ್ತಡಲಕಾನ್ ಪರಿಪೂರ್ಯ್ಯ ಸಂಜಗೃಹುಃ|</para>
  <para style="p">
    <verse number="38" style="v"/>ತೇ ಭೋಕ್ತಾರೋ ಯೋಷಿತೋ ಬಾಲಕಾಂಶ್ಚ ವಿಹಾಯ ಪ್ರಾಯೇಣ ಚತುಃಸಹಸ್ರಾಣಿ ಪುರುಷಾ ಆಸನ್|</para>
  <para style="p">
    <verse number="39" style="v"/>ತತಃ ಪರಂ ಸ ಜನನಿವಹಂ ವಿಸೃಜ್ಯ ತರಿಮಾರುಹ್ಯ ಮಗ್ದಲಾಪ್ರದೇಶಂ ಗತವಾನ್|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ತದಾನೀಂ ಫಿರೂಶಿನಃ ಸಿದೂಕಿನಶ್ಚಾಗತ್ಯ ತಂ ಪರೀಕ್ಷಿತುಂ ನಭಮೀಯಂ ಕಿಞ್ಚನ ಲಕ್ಷ್ಮ ದರ್ಶಯಿತುಂ ತಸ್ಮೈ ನಿವೇದಯಾಮಾಸುಃ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತತಃ ಸ ಉಕ್ತವಾನ್, ಸನ್ಧ್ಯಾಯಾಂ ನಭಸೋ ರಕ್ತತ್ವಾದ್ ಯೂಯಂ ವದಥ, ಶ್ವೋ ನಿರ್ಮ್ಮಲಂ ದಿನಂ ಭವಿಷ್ಯತಿ;</para>
  <para style="p">
    <verse number="3" style="v"/>ಪ್ರಾತಃಕಾಲೇ ಚ ನಭಸೋ ರಕ್ತತ್ವಾತ್ ಮಲಿನತ್ವಾಞ್ಚ ವದಥ, ಝಞ್ಭ್ಶದ್ಯ ಭವಿಷ್ಯತಿ| ಹೇ ಕಪಟಿನೋ ಯದಿ ಯೂಯಮ್ ಅನ್ತರೀಕ್ಷಸ್ಯ ಲಕ್ಷ್ಮ ಬೋದ್ಧುಂ ಶಕ್ನುಥ, ತರ್ಹಿ ಕಾಲಸ್ಯೈತಸ್ಯ ಲಕ್ಷ್ಮ ಕಥಂ ಬೋದ್ಧುಂ ನ ಶಕ್ನುಥ?</para>
  <para style="p">
    <verse number="4" style="v"/>ಏತತ್ಕಾಲಸ್ಯ ದುಷ್ಟೋ ವ್ಯಭಿಚಾರೀ ಚ ವಂಶೋ ಲಕ್ಷ್ಮ ಗವೇಷಯತಿ, ಕಿನ್ತು ಯೂನಸೋ ಭವಿಷ್ಯದ್ವಾದಿನೋ ಲಕ್ಷ್ಮ ವಿನಾನ್ಯತ್ ಕಿಮಪಿ ಲಕ್ಷ್ಮ ತಾನ್ ನ ದರ್ಶಯಿಯ್ಯತೇ| ತದಾನೀಂ ಸ ತಾನ್ ವಿಹಾಯ ಪ್ರತಸ್ಥೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಅನನ್ತರಮನ್ಯಪಾರಗಮನಕಾಲೇ ತಸ್ಯ ಶಿಷ್ಯಾಃ ಪೂಪಮಾನೇತುಂ ವಿಸ್ಮೃತವನ್ತಃ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಯೀಶುಸ್ತಾನವಾದೀತ್, ಯೂಯಂ ಫಿರೂಶಿನಾಂ ಸಿದೂಕಿನಾಞ್ಚ ಕಿಣ್ವಂ ಪ್ರತಿ ಸಾವಧಾನಾಃ ಸತರ್ಕಾಶ್ಚ ಭವತ|</para>
  <para style="p">
    <verse number="7" style="v"/>ತೇನ ತೇ ಪರಸ್ಪರಂ ವಿವಿಚ್ಯ ಕಥಯಿತುಮಾರೇಭಿರೇ, ವಯಂ ಪೂಪಾನಾನೇತುಂ ವಿಸ್ಮೃತವನ್ತ ಏತತ್ಕಾರಣಾದ್ ಇತಿ ಕಥಯತಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಕಿನ್ತು ಯೀಶುಸ್ತದ್ವಿಜ್ಞಾಯ ತಾನವೋಚತ್, ಹೇ ಸ್ತೋಕವಿಶ್ವಾಸಿನೋ ಯೂಯಂ ಪೂಪಾನಾನಯನಮಧಿ ಕುತಃ ಪರಸ್ಪರಮೇತದ್ ವಿವಿಂಕ್ಯ?</para>
  <para style="p">
    <verse number="9" style="v"/>ಯುಷ್ಮಾಭಿಃ ಕಿಮದ್ಯಾಪಿ ನ ಜ್ಞಾಯತೇ? ಪಞ್ಚಭಿಃ ಪೂಪೈಃ ಪಞ್ಚಸಹಸ್ರಪುರುಷೇಷು ಭೋಜಿತೇಷು ಭಕ್ಷ್ಯೋಚ್ಛಿಷ್ಟಪೂರ್ಣಾನ್ ಕತಿ ಡಲಕಾನ್ ಸಮಗೃಹ್ಲೀತಂ;</para>
  <para style="p">
    <verse number="10" style="v"/>ತಥಾ ಸಪ್ತಭಿಃ ಪೂಪೈಶ್ಚತುಃಸಹಸ್ರಪುರುಷೇಷು ಭೇಜಿತೇಷು ಕತಿ ಡಲಕಾನ್ ಸಮಗೃಹ್ಲೀತ, ತತ್ ಕಿಂ ಯುಷ್ಮಾಭಿರ್ನ ಸ್ಮರ್ಯ್ಯತೇ?</para>
  <para style="p">
    <verse number="11" style="v"/>ತಸ್ಮಾತ್ ಫಿರೂಶಿನಾಂ ಸಿದೂಕಿನಾಞ್ಚ ಕಿಣ್ವಂ ಪ್ರತಿ ಸಾವಧಾನಾಸ್ತಿಷ್ಠತ, ಕಥಾಮಿಮಾಮ್ ಅಹಂ ಪೂಪಾನಧಿ ನಾಕಥಯಂ, ಏತದ್ ಯೂಯಂ ಕುತೋ ನ ಬುಧ್ಯಧ್ವೇ?</para>
  <para style="p">
    <verse number="12" style="v"/>ತದಾನೀಂ ಪೂಪಕಿಣ್ವಂ ಪ್ರತಿ ಸಾವಧಾನಾಸ್ತಿಷ್ಠತೇತಿ ನೋಕ್ತ್ವಾ ಫಿರೂಶಿನಾಂ ಸಿದೂಕಿನಾಞ್ಚ ಉಪದೇಶಂ ಪ್ರತಿ ಸಾವಧಾನಾಸ್ತಿಷ್ಠತೇತಿ ಕಥಿತವಾನ್, ಇತಿ ತೈರಬೋಧಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅಪರಞ್ಚ ಯೀಶುಃ ಕೈಸರಿಯಾ-ಫಿಲಿಪಿಪ್ರದೇಶಮಾಗತ್ಯ ಶಿಷ್ಯಾನ್ ಅಪೃಚ್ಛತ್, ಯೋಽಹಂ ಮನುಜಸುತಃ ಸೋಽಹಂ ಕಃ? ಲೋಕೈರಹಂ ಕಿಮುಚ್ಯೇ?</para>
  <para style="p">
    <verse number="14" style="v"/>ತದಾನೀಂ ತೇ ಕಥಿತವನ್ತಃ, ಕೇಚಿದ್ ವದನ್ತಿ ತ್ವಂ ಮಜ್ಜಯಿತಾ ಯೋಹನ್, ಕೇಚಿದ್ವದನ್ತಿ, ತ್ವಮ್ ಏಲಿಯಃ, ಕೇಚಿಚ್ಚ ವದನ್ತಿ, ತ್ವಂ ಯಿರಿಮಿಯೋ ವಾ ಕಶ್ಚಿದ್ ಭವಿಷ್ಯದ್ವಾದೀತಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಪಶ್ಚಾತ್ ಸ ತಾನ್ ಪಪ್ರಚ್ಛ, ಯೂಯಂ ಮಾಂ ಕಂ ವದಥ? ತತಃ ಶಿಮೋನ್ ಪಿತರ ಉವಾಚ,</para>
  <para style="p">
    <verse number="16" style="v"/>ತ್ವಮಮರೇಶ್ವರಸ್ಯಾಭಿಷಿಕ್ತಪುತ್ರಃ|</para>
  <para style="p">
    <verse number="17" style="v"/>ತತೋ ಯೀಶುಃ ಕಥಿತವಾನ್, ಹೇ ಯೂನಸಃ ಪುತ್ರ ಶಿಮೋನ್ ತ್ವಂ ಧನ್ಯಃ; ಯತಃ ಕೋಪಿ ಅನುಜಸ್ತ್ವಯ್ಯೇತಜ್ಜ್ಞಾನಂ ನೋದಪಾದಯತ್, ಕಿನ್ತು ಮಮ ಸ್ವರ್ಗಸ್ಯಃ ಪಿತೋದಪಾದಯತ್|</para>
  <para style="p">
    <verse number="18" style="v"/>ಅತೋಽಹಂ ತ್ವಾಂ ವದಾಮಿ, ತ್ವಂ ಪಿತರಃ (ಪ್ರಸ್ತರಃ) ಅಹಞ್ಚ ತಸ್ಯ ಪ್ರಸ್ತರಸ್ಯೋಪರಿ ಸ್ವಮಣ್ಡಲೀಂ ನಿರ್ಮ್ಮಾಸ್ಯಾಮಿ, ತೇನ ನಿರಯೋ ಬಲಾತ್ ತಾಂ ಪರಾಜೇತುಂ ನ ಶಕ್ಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಅಹಂ ತುಭ್ಯಂ ಸ್ವರ್ಗೀಯರಾಜ್ಯಸ್ಯ ಕುಞ್ಜಿಕಾಂ ದಾಸ್ಯಾಮಿ, ತೇನ ಯತ್ ಕಿಞ್ಚನ ತ್ವಂ ಪೃಥಿವ್ಯಾಂ ಭಂತ್ಸ್ಯಸಿ ತತ್ಸ್ವರ್ಗೇ ಭಂತ್ಸ್ಯತೇ, ಯಚ್ಚ ಕಿಞ್ಚನ ಮಹ್ಯಾಂ ಮೋಕ್ಷ್ಯಸಿ ತತ್ ಸ್ವರ್ಗೇ ಮೋಕ್ಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಪಶ್ಚಾತ್ ಸ ಶಿಷ್ಯಾನಾದಿಶತ್, ಅಹಮಭಿಷಿಕ್ತೋ ಯೀಶುರಿತಿ ಕಥಾಂ ಕಸ್ಮೈಚಿದಪಿ ಯೂಯಂ ಮಾ ಕಥಯತ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಅನ್ಯಞ್ಚ ಯಿರೂಶಾಲಮ್ನಗರಂ ಗತ್ವಾ ಪ್ರಾಚೀನಲೋಕೇಭ್ಯಃ ಪ್ರಧಾನಯಾಜಕೇಭ್ಯ ಉಪಾಧ್ಯಾಯೇಭ್ಯಶ್ಚ ಬಹುದುಃಖಭೋಗಸ್ತೈ ರ್ಹತತ್ವಂ ತೃತೀಯದಿನೇ ಪುನರುತ್ಥಾನಞ್ಚ ಮಮಾವಶ್ಯಕಮ್ ಏತಾಃ ಕಥಾ ಯೀಶುಸ್ತತ್ಕಾಲಮಾರಭ್ಯ ಶಿಷ್ಯಾನ್ ಜ್ಞಾಪಯಿತುಮ್ ಆರಬ್ಧವಾನ್|</para>
  <para style="p">
    <verse number="22" style="v"/>ತದಾನೀಂ ಪಿತರಸ್ತಸ್ಯ ಕರಂ ಘೃತ್ವಾ ತರ್ಜಯಿತ್ವಾ ಕಥಯಿತುಮಾರಬ್ಧವಾನ್, ಹೇ ಪ್ರಭೋ, ತತ್ ತ್ವತ್ತೋ ದೂರಂ ಯಾತು, ತ್ವಾಂ ಪ್ರತಿ ಕದಾಪಿ ನ ಘಟಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಕಿನ್ತು ಸ ವದನಂ ಪರಾವರ್ತ್ಯ ಪಿತರಂ ಜಗಾದ, ಹೇ ವಿಘ್ನಕಾರಿನ್, ಮತ್ಸಮ್ಮುಖಾದ್ ದೂರೀಭವ, ತ್ವಂ ಮಾಂ ಬಾಧಸೇ, ಈಶ್ವರೀಯಕಾರ್ಯ್ಯಾತ್ ಮಾನುಷೀಯಕಾರ್ಯ್ಯಂ ತುಭ್ಯಂ ರೋಚತೇ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಅನನ್ತರಂ ಯೀಶುಃ ಸ್ವೀಯಶಿಷ್ಯಾನ್ ಉಕ್ತವಾನ್ ಯಃ ಕಶ್ಚಿತ್ ಮಮ ಪಶ್ಚಾದ್ಗಾಮೀ ಭವಿತುಮ್ ಇಚ್ಛತಿ, ಸ ಸ್ವಂ ದಾಮ್ಯತು, ತಥಾ ಸ್ವಕ್ರುಶಂ ಗೃಹ್ಲನ್ ಮತ್ಪಶ್ಚಾದಾಯಾತು|</para>
  <para style="p">
    <verse number="25" style="v"/>ಯತೋ ಯಃ ಪ್ರಾಣಾನ್ ರಕ್ಷಿತುಮಿಚ್ಛತಿ, ಸ ತಾನ್ ಹಾರಯಿಷ್ಯತಿ, ಕಿನ್ತು ಯೋ ಮದರ್ಥಂ ನಿಜಪ್ರಾಣಾನ್ ಹಾರಯತಿ, ಸ ತಾನ್ ಪ್ರಾಪ್ಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="26" style="v"/>ಮಾನುಷೋ ಯದಿ ಸರ್ವ್ವಂ ಜಗತ್ ಲಭತೇ ನಿಜಪ್ರಣಾನ್ ಹಾರಯತಿ, ತರ್ಹಿ ತಸ್ಯ ಕೋ ಲಾಭಃ? ಮನುಜೋ ನಿಜಪ್ರಾಣಾನಾಂ ವಿನಿಮಯೇನ ವಾ ಕಿಂ ದಾತುಂ ಶಕ್ನೋತಿ?</para>
  <para style="p">
    <verse number="27" style="v"/>ಮನುಜಸುತಃ ಸ್ವದೂತೈಃ ಸಾಕಂ ಪಿತುಃ ಪ್ರಭಾವೇಣಾಗಮಿಷ್ಯತಿ; ತದಾ ಪ್ರತಿಮನುಜಂ ಸ್ವಸ್ವಕರ್ಮ್ಮಾನುಸಾರಾತ್ ಫಲಂ ದಾಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="28" style="v"/>ಅಹಂ ಯುಷ್ಮಾನ್ ತಥ್ಯಂ ವಚ್ಮಿ, ಸರಾಜ್ಯಂ ಮನುಜಸುತಮ್ ಆಗತಂ ನ ಪಶ್ಯನ್ತೋ ಮೃತ್ಯುಂ ನ ಸ್ವಾದಿಷ್ಯನ್ತಿ, ಏತಾದೃಶಾಃ ಕತಿಪಯಜನಾ ಅತ್ರಾಪಿ ದಣ್ಡಾಯಮಾನಾಃ ಸನ್ತಿ|</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅನನ್ತರಂ ಷಡ್ದಿನೇಭ್ಯಃ ಪರಂ ಯೀಶುಃ ಪಿತರಂ ಯಾಕೂಬಂ ತತ್ಸಹಜಂ ಯೋಹನಞ್ಚ ಗೃಹ್ಲನ್ ಉಚ್ಚಾದ್ರೇ ರ್ವಿವಿಕ್ತಸ್ಥಾನಮ್ ಆಗತ್ಯ ತೇಷಾಂ ಸಮಕ್ಷಂ ರೂಪಮನ್ಯತ್ ದಧಾರ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತೇನ ತದಾಸ್ಯಂ ತೇಜಸ್ವಿ, ತದಾಭರಣಮ್ ಆಲೋಕವತ್ ಪಾಣ್ಡರಮಭವತ್|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅನ್ಯಚ್ಚ ತೇನ ಸಾಕಂ ಸಂಲಪನ್ತೌ ಮೂಸಾ ಏಲಿಯಶ್ಚ ತೇಭ್ಯೋ ದರ್ಶನಂ ದದತುಃ|</para>
  <para style="p">
    <verse number="4" style="v"/>ತದಾನೀಂ ಪಿತರೋ ಯೀಶುಂ ಜಗಾದ, ಹೇ ಪ್ರಭೋ ಸ್ಥಿತಿರತ್ರಾಸ್ಮಾಕಂ ಶುಭಾ, ಯದಿ ಭವತಾನುಮನ್ಯತೇ, ತರ್ಹಿ ಭವದರ್ಥಮೇಕಂ ಮೂಸಾರ್ಥಮೇಕಮ್ ಏಲಿಯಾರ್ಥಞ್ಚೈಕಮ್ ಇತಿ ತ್ರೀಣಿ ದೂಷ್ಯಾಣಿ ನಿರ್ಮ್ಮಮ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಏತತ್ಕಥನಕಾಲ ಏಕ ಉಜ್ಜವಲಃ ಪಯೋದಸ್ತೇಷಾಮುಪರಿ ಛಾಯಾಂ ಕೃತವಾನ್, ವಾರಿದಾದ್ ಏಷಾ ನಭಸೀಯಾ ವಾಗ್ ಬಭೂವ, ಮಮಾಯಂ ಪ್ರಿಯಃ ಪುತ್ರಃ, ಅಸ್ಮಿನ್ ಮಮ ಮಹಾಸನ್ತೋಷ ಏತಸ್ಯ ವಾಕ್ಯಂ ಯೂಯಂ ನಿಶಾಮಯತ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಕಿನ್ತು ವಾಚಮೇತಾಂ ಶೃಣ್ವನ್ತಏವ ಶಿಷ್ಯಾ ಮೃಶಂ ಶಙ್ಕಮಾನಾ ನ್ಯುಬ್ಜಾ ನ್ಯಪತನ್|</para>
  <para style="p">
    <verse number="7" style="v"/>ತದಾ ಯೀಶುರಾಗತ್ಯ ತೇಷಾಂ ಗಾತ್ರಾಣಿ ಸ್ಪೃಶನ್ ಉವಾಚ, ಉತ್ತಿಷ್ಠತ, ಮಾ ಭೈಷ್ಟ|</para>
  <para style="p">
    <verse number="8" style="v"/>ತದಾನೀಂ ನೇತ್ರಾಣ್ಯುನ್ಮೀಲ್ಯ ಯೀಶುಂ ವಿನಾ ಕಮಪಿ ನ ದದೃಶುಃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ತತಃ ಪರಮ್ ಅದ್ರೇರವರೋಹಣಕಾಲೇ ಯೀಶುಸ್ತಾನ್ ಇತ್ಯಾದಿದೇಶ, ಮನುಜಸುತಸ್ಯ ಮೃತಾನಾಂ ಮಧ್ಯಾದುತ್ಥಾನಂ ಯಾವನ್ನ ಜಾಯತೇ, ತಾವತ್ ಯುಷ್ಮಾಭಿರೇತದ್ದರ್ಶನಂ ಕಸ್ಮೈಚಿದಪಿ ನ ಕಥಯಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="10" style="v"/>ತದಾ ಶಿಷ್ಯಾಸ್ತಂ ಪಪ್ರಚ್ಛುಃ, ಪ್ರಥಮಮ್ ಏಲಿಯ ಆಯಾಸ್ಯತೀತಿ ಕುತ ಉಪಾಧ್ಯಾಯೈರುಚ್ಯತೇ?</para>
  <para style="p">
    <verse number="11" style="v"/>ತತೋ ಯೀಶುಃ ಪ್ರತ್ಯವಾದೀತ್, ಏಲಿಯಃ ಪ್ರಾಗೇತ್ಯ ಸರ್ವ್ವಾಣಿ ಸಾಧಯಿಷ್ಯತೀತಿ ಸತ್ಯಂ,</para>
  <para style="p">
    <verse number="12" style="v"/>ಕಿನ್ತ್ವಹಂ ಯುಷ್ಮಾನ್ ವಚ್ಮಿ, ಏಲಿಯ ಏತ್ಯ ಗತಃ, ತೇ ತಮಪರಿಚಿತ್ಯ ತಸ್ಮಿನ್ ಯಥೇಚ್ಛಂ ವ್ಯವಜಹುಃ; ಮನುಜಸುತೇನಾಪಿ ತೇಷಾಮನ್ತಿಕೇ ತಾದೃಗ್ ದುಃಖಂ ಭೋಕ್ತವ್ಯಂ|</para>
  <para style="p">
    <verse number="13" style="v"/>ತದಾನೀಂ ಸ ಮಜ್ಜಯಿತಾರಂ ಯೋಹನಮಧಿ ಕಥಾಮೇತಾಂ ವ್ಯಾಹೃತವಾನ್, ಇತ್ಥಂ ತಚ್ಛಿಷ್ಯಾ ಬುಬುಧಿರೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಪಶ್ಚಾತ್ ತೇಷು ಜನನಿವಹಸ್ಯಾನ್ತಿಕಮಾಗತೇಷು ಕಶ್ಚಿತ್ ಮನುಜಸ್ತದನ್ತಿಕಮೇತ್ಯ ಜಾನೂನೀ ಪಾತಯಿತ್ವಾ ಕಥಿತವಾನ್,</para>
  <para style="p">
    <verse number="15" style="v"/>ಹೇ ಪ್ರಭೋ, ಮತ್ಪುತ್ರಂ ಪ್ರತಿ ಕೃಪಾಂ ವಿದಧಾತು, ಸೋಪಸ್ಮಾರಾಮಯೇನ ಭೃಶಂ ವ್ಯಥಿತಃ ಸನ್ ಪುನಃ ಪುನ ರ್ವಹ್ನೌ ಮುಹು ರ್ಜಲಮಧ್ಯೇ ಪತತಿ|</para>
  <para style="p">
    <verse number="16" style="v"/>ತಸ್ಮಾದ್ ಭವತಃ ಶಿಷ್ಯಾಣಾಂ ಸಮೀಪೇ ತಮಾನಯಂ ಕಿನ್ತು ತೇ ತಂ ಸ್ವಾಸ್ಥಂ ಕರ್ತ್ತುಂ ನ ಶಕ್ತಾಃ|</para>
  <para style="p">
    <verse number="17" style="v"/>ತದಾ ಯೀಶುಃ ಕಥಿತವಾನ್ ರೇ ಅವಿಶ್ವಾಸಿನಃ, ರೇ ವಿಪಥಗಾಮಿನಃ, ಪುನಃ ಕತಿಕಾಲಾನ್ ಅಹಂ ಯುಷ್ಮಾಕಂ ಸನ್ನಿಧೌ ಸ್ಥಾಸ್ಯಾಮಿ? ಕತಿಕಾಲಾನ್ ವಾ ಯುಷ್ಮಾನ್ ಸಹಿಷ್ಯೇ? ತಮತ್ರ ಮಮಾನ್ತಿಕಮಾನಯತ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಪಶ್ಚಾದ್ ಯೀಶುನಾ ತರ್ಜತಏವ ಸ ಭೂತಸ್ತಂ ವಿಹಾಯ ಗತವಾನ್, ತದ್ದಣ್ಡಏವ ಸ ಬಾಲಕೋ ನಿರಾಮಯೋಽಭೂತ್|</para>
  <para style="p">
    <verse number="19" style="v"/>ತತಃ ಶಿಷ್ಯಾ ಗುಪ್ತಂ ಯೀಶುಮುಪಾಗತ್ಯ ಬಭಾಷಿರೇ, ಕುತೋ ವಯಂ ತಂ ಭೂತಂ ತ್ಯಾಜಯಿತುಂ ನ ಶಕ್ತಾಃ?</para>
  <para style="p">
    <verse number="20" style="v"/>ಯೀಶುನಾ ತೇ ಪ್ರೋಕ್ತಾಃ, ಯುಷ್ಮಾಕಮಪ್ರತ್ಯಯಾತ್;</para>
  <para style="p">
    <verse number="21" style="v"/>ಯುಷ್ಮಾನಹಂ ತಥ್ಯಂ ವಚ್ಮಿ ಯದಿ ಯುಷ್ಮಾಕಂ ಸರ್ಷಪೈಕಮಾತ್ರೋಪಿ ವಿಶ್ವಾಸೋ ಜಾಯತೇ, ತರ್ಹಿ ಯುಷ್ಮಾಭಿರಸ್ಮಿನ್ ಶೈಲೇ ತ್ವಮಿತಃ ಸ್ಥಾನಾತ್ ತತ್ ಸ್ಥಾನಂ ಯಾಹೀತಿ ಬ್ರೂತೇ ಸ ತದೈವ ಚಲಿಷ್ಯತಿ, ಯುಷ್ಮಾಕಂ ಕಿಮಪ್ಯಸಾಧ್ಯಞ್ಚ ಕರ್ಮ್ಮ ನ ಸ್ಥಾಸ್ಯಾತಿ| ಕಿನ್ತು ಪ್ರಾರ್ಥನೋಪವಾಸೌ ವಿನೈತಾದೃಶೋ ಭೂತೋ ನ ತ್ಯಾಜ್ಯೇತ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಅಪರಂ ತೇಷಾಂ ಗಾಲೀಲ್ಪ್ರದೇಶೇ ಭ್ರಮಣಕಾಲೇ ಯೀಶುನಾ ತೇ ಗದಿತಾಃ, ಮನುಜಸುತೋ ಜನಾನಾಂ ಕರೇಷು ಸಮರ್ಪಯಿಷ್ಯತೇ ತೈ ರ್ಹನಿಷ್ಯತೇ ಚ,</para>
  <para style="p">
    <verse number="23" style="v"/>ಕಿನ್ತು ತೃತೀಯೇಽಹಿ्ನ ಮ ಉತ್ಥಾಪಿಷ್ಯತೇ, ತೇನ ತೇ ಭೃಶಂ ದುಃಖಿತಾ ಬಭೂವಃ|</para>
  <para style="p">
    <verse number="24" style="v"/>ತದನನ್ತರಂ ತೇಷು ಕಫರ್ನಾಹೂಮ್ನಗರಮಾಗತೇಷು ಕರಸಂಗ್ರಾಹಿಣಃ ಪಿತರಾನ್ತಿಕಮಾಗತ್ಯ ಪಪ್ರಚ್ಛುಃ, ಯುಷ್ಮಾಕಂ ಗುರುಃ ಕಿಂ ಮನ್ದಿರಾರ್ಥಂ ಕರಂ ನ ದದಾತಿ? ತತಃ ಪಿತರಃ ಕಥಿತವಾನ್ ದದಾತಿ|</para>
  <para style="p">
    <verse number="25" style="v"/>ತತಸ್ತಸ್ಮಿನ್ ಗೃಹಮಧ್ಯಮಾಗತೇ ತಸ್ಯ ಕಥಾಕಥನಾತ್ ಪೂರ್ವ್ವಮೇವ ಯೀಶುರುವಾಚ, ಹೇ ಶಿಮೋನ್, ಮೇದಿನ್ಯಾ ರಾಜಾನಃ ಸ್ವಸ್ವಾಪತ್ಯೇಭ್ಯಃ ಕಿಂ ವಿದೇಶಿಭ್ಯಃ ಕೇಭ್ಯಃ ಕರಂ ಗೃಹ್ಲನ್ತಿ? ಅತ್ರ ತ್ವಂ ಕಿಂ ಬುಧ್ಯಸೇ? ತತಃ ಪಿತರ ಉಕ್ತವಾನ್, ವಿದೇಶಿಭ್ಯಃ|</para>
  <para style="p">
    <verse number="26" style="v"/>ತದಾ ಯೀಶುರುಕ್ತವಾನ್, ತರ್ಹಿ ಸನ್ತಾನಾ ಮುಕ್ತಾಃ ಸನ್ತಿ|</para>
  <para style="p">
    <verse number="27" style="v"/>ತಥಾಪಿ ಯಥಾಸ್ಮಾಭಿಸ್ತೇಷಾಮನ್ತರಾಯೋ ನ ಜನ್ಯತೇ, ತತ್ಕೃತೇ ಜಲಧೇಸ್ತೀರಂ ಗತ್ವಾ ವಡಿಶಂ ಕ್ಷಿಪ, ತೇನಾದೌ ಯೋ ಮೀನ ಉತ್ಥಾಸ್ಯತಿ, ತಂ ಘೃತ್ವಾ ತನ್ಮುಖೇ ಮೋಚಿತೇ ತೋಲಕೈಕಂ ರೂಪ್ಯಂ ಪ್ರಾಪ್ಸ್ಯಸಿ, ತದ್ ಗೃಹೀತ್ವಾ ತವ ಮಮ ಚ ಕೃತೇ ತೇಭ್ಯೋ ದೇಹಿ|</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ತದಾನೀಂ ಶಿಷ್ಯಾ ಯೀಶೋಃ ಸಮೀಪಮಾಗತ್ಯ ಪೃಷ್ಟವನ್ತಃ ಸ್ವರ್ಗರಾಜ್ಯೇ ಕಃ ಶ್ರೇಷ್ಠಃ?</para>
  <para style="p">
    <verse number="2" style="v"/>ತತೋ ಯೀಶುಃ ಕ್ಷುದ್ರಮೇಕಂ ಬಾಲಕಂ ಸ್ವಸಮೀಪಮಾನೀಯ ತೇಷಾಂ ಮಧ್ಯೇ ನಿಧಾಯ ಜಗಾದ,</para>
  <para style="p">
    <verse number="3" style="v"/>ಯುಷ್ಮಾನಹಂ ಸತ್ಯಂ ಬ್ರವೀಮಿ, ಯೂಯಂ ಮನೋವಿನಿಮಯೇನ ಕ್ಷುದ್ರಬಾಲವತ್ ನ ಸನ್ತಃ ಸ್ವರ್ಗರಾಜ್ಯಂ ಪ್ರವೇಷ್ಟುಂ ನ ಶಕ್ನುಥ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಯಃ ಕಶ್ಚಿದ್ ಏತಸ್ಯ ಕ್ಷುದ್ರಬಾಲಕಸ್ಯ ಸಮಮಾತ್ಮಾನಂ ನಮ್ರೀಕರೋತಿ, ಸಏವ ಸ್ವರ್ಗರಾಜಯೇ ಶ್ರೇಷ್ಠಃ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯಃ ಕಶ್ಚಿದ್ ಏತಾದೃಶಂ ಕ್ಷುದ್ರಬಾಲಕಮೇಕಂ ಮಮ ನಾಮ್ನಿ ಗೃಹ್ಲಾತಿ, ಸ ಮಾಮೇವ ಗೃಹ್ಲಾತಿ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಕಿನ್ತು ಯೋ ಜನೋ ಮಯಿ ಕೃತವಿಶ್ವಾಸಾನಾಮೇತೇಷಾಂ ಕ್ಷುದ್ರಪ್ರಾಣಿನಾಮ್ ಏಕಸ್ಯಾಪಿ ವಿಧ್ನಿಂ ಜನಯತಿ, ಕಣ್ಠಬದ್ಧಪೇಷಣೀಕಸ್ಯ ತಸ್ಯ ಸಾಗರಾಗಾಧಜಲೇ ಮಜ್ಜನಂ ಶ್ರೇಯಃ|</para>
  <para style="p">
    <verse number="7" style="v"/>ವಿಘ್ನಾತ್ ಜಗತಃ ಸನ್ತಾಪೋ ಭವಿಷ್ಯತಿ, ವಿಘ್ನೋಽವಶ್ಯಂ ಜನಯಿಷ್ಯತೇ, ಕಿನ್ತು ಯೇನ ಮನುಜೇನ ವಿಘ್ನೋ ಜನಿಷ್ಯತೇ ತಸ್ಯೈವ ಸನ್ತಾಪೋ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ತಸ್ಮಾತ್ ತವ ಕರಶ್ಚರಣೋ ವಾ ಯದಿ ತ್ವಾಂ ಬಾಧತೇ, ತರ್ಹಿ ತಂ ಛಿತ್ತ್ವಾ ನಿಕ್ಷಿಪ, ದ್ವಿಕರಸ್ಯ ದ್ವಿಪದಸ್ಯ ವಾ ತವಾನಪ್ತವಹ್ನೌ ನಿಕ್ಷೇಪಾತ್, ಖಞ್ಜಸ್ಯ ವಾ ಛಿನ್ನಹಸ್ತಸ್ಯ ತವ ಜೀವನೇ ಪ್ರವೇಶೋ ವರಂ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಅಪರಂ ತವ ನೇತ್ರಂ ಯದಿ ತ್ವಾಂ ಬಾಧತೇ, ತರ್ಹಿ ತದಪ್ಯುತ್ಪಾವ್ಯ ನಿಕ್ಷಿಪ, ದ್ವಿನೇತ್ರಸ್ಯ ನರಕಾಗ್ನೌ ನಿಕ್ಷೇಪಾತ್ ಕಾಣಸ್ಯ ತವ ಜೀವನೇ ಪ್ರವೇಶೋ ವರಂ|</para>
  <para style="p">
    <verse number="10" style="v"/>ತಸ್ಮಾದವಧದ್ಧಂ, ಏತೇಷಾಂ ಕ್ಷುದ್ರಪ್ರಾಣಿನಾಮ್ ಏಕಮಪಿ ಮಾ ತುಚ್ಛೀಕುರುತ,</para>
  <para style="p">
    <verse number="11" style="v"/>ಯತೋ ಯುಷ್ಮಾನಹಂ ತಥ್ಯಂ ಬ್ರವೀಮಿ, ಸ್ವರ್ಗೇ ತೇಷಾಂ ದೂತಾ ಮಮ ಸ್ವರ್ಗಸ್ಥಸ್ಯ ಪಿತುರಾಸ್ಯಂ ನಿತ್ಯಂ ಪಶ್ಯನ್ತಿ| ಏವಂ ಯೇ ಯೇ ಹಾರಿತಾಸ್ತಾನ್ ರಕ್ಷಿತುಂ ಮನುಜಪುತ್ರ ಆಗಚ್ಛತ್|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯೂಯಮತ್ರ ಕಿಂ ವಿವಿಂಗ್ಘ್ವೇ? ಕಸ್ಯಚಿದ್ ಯದಿ ಶತಂ ಮೇಷಾಃ ಸನ್ತಿ, ತೇಷಾಮೇಕೋ ಹಾರ್ಯ್ಯತೇ ಚ, ತರ್ಹಿ ಸ ಏಕೋನಶತಂ ಮೇಷಾನ್ ವಿಹಾಯ ಪರ್ವ್ವತಂ ಗತ್ವಾ ತಂ ಹಾರಿತಮೇಕಂ ಕಿಂ ನ ಮೃಗಯತೇ?</para>
  <para style="p">
    <verse number="13" style="v"/>ಯದಿ ಚ ಕದಾಚಿತ್ ತನ್ಮೇಷೋದ್ದೇಶಂ ಲಮತೇ, ತರ್ಹಿ ಯುಷ್ಮಾನಹಂ ಸತ್ಯಂ ಕಥಯಾಮಿ, ಸೋಽವಿಪಥಗಾಮಿಭ್ಯ ಏಕೋನಶತಮೇಷೇಭ್ಯೋಪಿ ತದೇಕಹೇತೋರಧಿಕಮ್ ಆಹ್ಲಾದತೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ತದ್ವದ್ ಏತೇಷಾಂ ಕ್ಷುದ್ರಪ್ರಾಏिನಾಮ್ ಏಕೋಪಿ ನಶ್ಯತೀತಿ ಯುಷ್ಮಾಕಂ ಸ್ವರ್ಗಸ್ಥಪಿತು ರ್ನಾಭಿಮತಮ್|</para>
  <para style="p">
    <verse number="15" style="v"/>ಯದ್ಯಪಿ ತವ ಭ್ರಾತಾ ತ್ವಯಿ ಕಿಮಪ್ಯಪರಾಧ್ಯತಿ, ತರ್ಹಿ ಗತ್ವಾ ಯುವಯೋರ್ದ್ವಯೋಃ ಸ್ಥಿತಯೋಸ್ತಸ್ಯಾಪರಾಧಂ ತಂ ಜ್ಞಾಪಯ| ತತ್ರ ಸ ಯದಿ ತವ ವಾಕ್ಯಂ ಶೃಣೋತಿ, ತರ್ಹಿ ತ್ವಂ ಸ್ವಭ್ರಾತರಂ ಪ್ರಾಪ್ತವಾನ್,</para>
  <para style="p">
    <verse number="16" style="v"/>ಕಿನ್ತು ಯದಿ ನ ಶೃಣೋತಿ, ತರ್ಹಿ ದ್ವಾಭ್ಯಾಂ ತ್ರಿಭಿ ರ್ವಾ ಸಾಕ್ಷೀಭಿಃ ಸರ್ವ್ವಂ ವಾಕ್ಯಂ ಯಥಾ ನಿಶ್ಚಿತಂ ಜಾಯತೇ, ತದರ್ಥಮ್ ಏಕಂ ದ್ವೌ ವಾ ಸಾಕ್ಷಿಣೌ ಗೃಹೀತ್ವಾ ಯಾಹಿ|</para>
  <para style="p">
    <verse number="17" style="v"/>ತೇನ ಸ ಯದಿ ತಯೋ ರ್ವಾಕ್ಯಂ ನ ಮಾನ್ಯತೇ, ತರ್ಹಿ ಸಮಾಜಂ ತಜ್ಜ್ಞಾಪಯ, ಕಿನ್ತು ಯದಿ ಸಮಾಜಸ್ಯಾಪಿ ವಾಕ್ಯಂ ನ ಮಾನ್ಯತೇ,ತರ್ಹಿ ಸ ತವ ಸಮೀಪೇ ದೇವಪೂಜಕಇವ ಚಣ್ಡಾಲಇವ ಚ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಅಹಂ ಯುಷ್ಮಾನ್ ಸತ್ಯಂ ವದಾಮಿ, ಯುಷ್ಮಾಭಿಃ ಪೃಥಿವ್ಯಾಂ ಯದ್ ಬಧ್ಯತೇ ತತ್ ಸ್ವರ್ಗೇ ಭಂತ್ಸ್ಯತೇ; ಮೇದಿನ್ಯಾಂ ಯತ್ ಭೋಚ್ಯತೇ, ಸ್ವರ್ಗೇಽಪಿ ತತ್ ಮೋಕ್ಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಪುನರಹಂ ಯುಷ್ಮಾನ್ ವದಾಮಿ, ಮೇದಿನ್ಯಾಂ ಯುಷ್ಮಾಕಂ ಯದಿ ದ್ವಾವೇಕವಾಕ್ಯೀಭೂಯ ಕಿಞ್ಚಿತ್ ಪ್ರಾರ್ಥಯೇತೇ, ತರ್ಹಿ ಮಮ ಸ್ವರ್ಗಸ್ಥಪಿತ್ರಾ ತತ್ ತಯೋಃ ಕೃತೇ ಸಮ್ಪನ್ನಂ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಯತೋ ಯತ್ರ ದ್ವೌ ತ್ರಯೋ ವಾ ಮಮ ನಾನ್ನಿ ಮಿಲನ್ತಿ, ತತ್ರೈವಾಹಂ ತೇಷಾಂ ಮಧ್ಯೇಽಸ್ಮಿ|</para>
  <para style="p">
    <verse number="21" style="v"/>ತದಾನೀಂ ಪಿತರಸ್ತತ್ಸಮೀಪಮಾಗತ್ಯ ಕಥಿತವಾನ್ ಹೇ ಪ್ರಭೋ, ಮಮ ಭ್ರಾತಾ ಮಮ ಯದ್ಯಪರಾಧ್ಯತಿ, ತರ್ಹಿ ತಂ ಕತಿಕೃತ್ವಃ ಕ್ಷಮಿಷ್ಯೇ?</para>
  <para style="p">
    <verse number="22" style="v"/>ಕಿಂ ಸಪ್ತಕೃತ್ವಃ? ಯೀಶುಸ್ತಂ ಜಗಾದ, ತ್ವಾಂ ಕೇವಲಂ ಸಪ್ತಕೃತ್ವೋ ಯಾವತ್ ನ ವದಾಮಿ, ಕಿನ್ತು ಸಪ್ತತ್ಯಾ ಗುಣಿತಂ ಸಪ್ತಕೃತ್ವೋ ಯಾವತ್|</para>
  <para style="p">
    <verse number="23" style="v"/>ಅಪರಂ ನಿಜದಾಸೈಃ ಸಹ ಜಿಗಣಯಿಷುಃ ಕಶ್ಚಿದ್ ರಾಜೇವ ಸ್ವರ್ಗರಾಜಯಂ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಆರಬ್ಧೇ ತಸ್ಮಿನ್ ಗಣನೇ ಸಾರ್ದ್ಧಸಹಸ್ರಮುದ್ರಾಪೂರಿತಾನಾಂ ದಶಸಹಸ್ರಪುಟಕಾನಾಮ್ ಏಕೋಽಘಮರ್ಣಸ್ತತ್ಸಮಕ್ಷಮಾನಾಯಿ|</para>
  <para style="p">
    <verse number="25" style="v"/>ತಸ್ಯ ಪರಿಶೋಧನಾಯ ದ್ರವ್ಯಾಭಾವಾತ್ ಪರಿಶೋಧನಾರ್ಥಂ ಸ ತದೀಯಭಾರ್ಯ್ಯಾಪುತ್ರಾದಿಸರ್ವ್ವಸ್ವಞ್ಚ ವಿಕ್ರೀಯತಾಮಿತಿ ತತ್ಪ್ರಭುರಾದಿದೇಶ|</para>
  <para style="p">
    <verse number="26" style="v"/>ತೇನ ಸ ದಾಸಸ್ತಸ್ಯ ಪಾದಯೋಃ ಪತನ್ ಪ್ರಣಮ್ಯ ಕಥಿತವಾನ್ , ಹೇ ಪ್ರಭೋ ಭವತಾ ಘೈರ್ಯ್ಯೇ ಕೃತೇ ಮಯಾ ಸರ್ವ್ವಂ ಪರಿಶೋಧಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="27" style="v"/>ತದಾನೀಂ ದಾಸಸ್ಯ ಪ್ರಭುಃ ಸಕರುಣಃ ಸನ್ ಸಕಲರ್ಣಂ ಕ್ಷಮಿತ್ವಾ ತಂ ತತ್ಯಾಜ|</para>
  <para style="p">
    <verse number="28" style="v"/>ಕಿನ್ತು ತಸ್ಮಿನ್ ದಾಸೇ ಬಹಿ ರ್ಯಾತೇ, ತಸ್ಯ ಶತಂ ಮುದ್ರಾಚತುರ್ಥಾಂಶಾನ್ ಯೋ ಧಾರಯತಿ, ತಂ ಸಹದಾಸಂ ದೃಷ್ದ್ವಾ ತಸ್ಯ ಕಣ್ಠಂ ನಿಷ್ಪೀಡ್ಯ ಗದಿತವಾನ್, ಮಮ ಯತ್ ಪ್ರಾಪ್ಯಂ ತತ್ ಪರಿಶೋಧಯ|</para>
  <para style="p">
    <verse number="29" style="v"/>ತದಾ ತಸ್ಯ ಸಹದಾಸಸ್ತತ್ಪಾದಯೋಃ ಪತಿತ್ವಾ ವಿನೀಯ ಬಭಾಷೇ, ತ್ವಯಾ ಧೈರ್ಯ್ಯೇ ಕೃತೇ ಮಯಾ ಸರ್ವ್ವಂ ಪರಿಶೋಧಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="30" style="v"/>ತಥಾಪಿ ಸ ತತ್ ನಾಙಗೀಕೃತ್ಯ ಯಾವತ್ ಸರ್ವ್ವಮೃಣಂ ನ ಪರಿಶೋಧಿತವಾನ್ ತಾವತ್ ತಂ ಕಾರಾಯಾಂ ಸ್ಥಾಪಯಾಮಾಸ|</para>
  <para style="p">
    <verse number="31" style="v"/>ತದಾ ತಸ್ಯ ಸಹದಾಸಾಸ್ತಸ್ಯೈತಾದೃಗ್ ಆಚರಣಂ ವಿಲೋಕ್ಯ ಪ್ರಭೋಃ ಸಮೀಪಂ ಗತ್ವಾ ಸರ್ವ್ವಂ ವೃತ್ತಾನ್ತಂ ನಿವೇದಯಾಮಾಸುಃ|</para>
  <para style="p">
    <verse number="32" style="v"/>ತದಾ ತಸ್ಯ ಪ್ರಭುಸ್ತಮಾಹೂಯ ಜಗಾದ, ರೇ ದುಷ್ಟ ದಾಸ, ತ್ವಯಾ ಮತ್ಸನ್ನಿಧೌ ಪ್ರಾರ್ಥಿತೇ ಮಯಾ ತವ ಸರ್ವ್ವಮೃಣಂ ತ್ಯಕ್ತಂ;</para>
  <para style="p">
    <verse number="33" style="v"/>ಯಥಾ ಚಾಹಂ ತ್ವಯಿ ಕರುಣಾಂ ಕೃತವಾನ್, ತಥೈವ ತ್ವತ್ಸಹದಾಸೇ ಕರುಣಾಕರಣಂ ಕಿಂ ತವ ನೋಚಿತಂ?</para>
  <para style="p">
    <verse number="34" style="v"/>ಇತಿ ಕಥಯಿತ್ವಾ ತಸ್ಯ ಪ್ರಭುಃ ಕ್ರುದ್ಧ್ಯನ್ ನಿಜಪ್ರಾಪ್ಯಂ ಯಾವತ್ ಸ ನ ಪರಿಶೋಧಿತವಾನ್, ತಾವತ್ ಪ್ರಹಾರಕಾನಾಂ ಕರೇಷು ತಂ ಸಮರ್ಪಿತವಾನ್|</para>
  <para style="p">
    <verse number="35" style="v"/>ಯದಿ ಯೂಯಂ ಸ್ವಾನ್ತಃಕರಣೈಃ ಸ್ವಸ್ವಸಹಜಾನಾಮ್ ಅಪರಾಧಾನ್ ನ ಕ್ಷಮಧ್ವೇ, ತರ್ಹಿ ಮಮ ಸ್ವರ್ಗಸ್ಯಃ ಪಿತಾಪಿ ಯುಷ್ಮಾನ್ ಪ್ರತೀತ್ಥಂ ಕರಿಷ್ಯತಿ|</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅನನ್ತರಮ್ ಏತಾಸು ಕಥಾಸು ಸಮಾಪ್ತಾಸು ಯೀಶು ರ್ಗಾಲೀಲಪ್ರದೇಶಾತ್ ಪ್ರಸ್ಥಾಯ ಯರ್ದನ್ತೀರಸ್ಥಂ ಯಿಹೂದಾಪ್ರದೇಶಂ ಪ್ರಾಪ್ತಃ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತದಾ ತತ್ಪಶ್ಚಾತ್ ಜನನಿವಹೇ ಗತೇ ಸ ತತ್ರ ತಾನ್ ನಿರಾಮಯಾನ್ ಅಕರೋತ್|</para>
  <para style="p">
    <verse number="3" style="v"/>ತದನನ್ತರಂ ಫಿರೂಶಿನಸ್ತತ್ಸಮೀಪಮಾಗತ್ಯ ಪಾರೀಕ್ಷಿತುಂ ತಂ ಪಪ್ರಚ್ಛುಃ, ಕಸ್ಮಾದಪಿ ಕಾರಣಾತ್ ನರೇಣ ಸ್ವಜಾಯಾ ಪರಿತ್ಯಾಜ್ಯಾ ನ ವಾ?</para>
  <para style="p">
    <verse number="4" style="v"/>ಸ ಪ್ರತ್ಯುವಾಚ, ಪ್ರಥಮಮ್ ಈಶ್ವರೋ ನರತ್ವೇನ ನಾರೀತ್ವೇನ ಚ ಮನುಜಾನ್ ಸಸರ್ಜ, ತಸ್ಮಾತ್ ಕಥಿತವಾನ್,</para>
  <para style="p">
    <verse number="5" style="v"/>ಮಾನುಷಃ ಸ್ವಪಿತರೌ ಪರಿತ್ಯಜ್ಯ ಸ್ವಪತ್ನ್ಯಾಮ್ ಆಸಕ್ಷ್ಯತೇ, ತೌ ದ್ವೌ ಜನಾವೇಕಾಙ್ಗೌ ಭವಿಷ್ಯತಃ, ಕಿಮೇತದ್ ಯುಷ್ಮಾಭಿ ರ್ನ ಪಠಿತಮ್?</para>
  <para style="p">
    <verse number="6" style="v"/>ಅತಸ್ತೌ ಪುನ ರ್ನ ದ್ವೌ ತಯೋರೇಕಾಙ್ಗತ್ವಂ ಜಾತಂ, ಈಶ್ವರೇಣ ಯಚ್ಚ ಸಮಯುಜ್ಯತ, ಮನುಜೋ ನ ತದ್ ಭಿನ್ದ್ಯಾತ್|</para>
  <para style="p">
    <verse number="7" style="v"/>ತದಾನೀಂ ತೇ ತಂ ಪ್ರತ್ಯವದನ್, ತಥಾತ್ವೇ ತ್ಯಾಜ್ಯಪತ್ರಂ ದತ್ತ್ವಾ ಸ್ವಾಂ ಸ್ವಾಂ ಜಾಯಾಂ ತ್ಯಕ್ತುಂ ವ್ಯವಸ್ಥಾಂ ಮೂಸಾಃ ಕಥಂ ಲಿಲೇಖ?</para>
  <para style="p">
    <verse number="8" style="v"/>ತತಃ ಸ ಕಥಿತವಾನ್, ಯುಷ್ಮಾಕಂ ಮನಸಾಂ ಕಾಠಿನ್ಯಾದ್ ಯುಷ್ಮಾನ್ ಸ್ವಾಂ ಸ್ವಾಂ ಜಾಯಾಂ ತ್ಯಕ್ತುಮ್ ಅನ್ವಮನ್ಯತ ಕಿನ್ತು ಪ್ರಥಮಾದ್ ಏಷೋ ವಿಧಿರ್ನಾಸೀತ್|</para>
  <para style="p">
    <verse number="9" style="v"/>ಅತೋ ಯುಷ್ಮಾನಹಂ ವದಾಮಿ, ವ್ಯಭಿಚಾರಂ ವಿನಾ ಯೋ ನಿಜಜಾಯಾಂ ತ್ಯಜೇತ್ ಅನ್ಯಾಞ್ಚ ವಿವಹೇತ್, ಸ ಪರದಾರಾನ್ ಗಚ್ಛತಿ; ಯಶ್ಚ ತ್ಯಕ್ತಾಂ ನಾರೀಂ ವಿವಹತಿ ಸೋಪಿ ಪರದಾರೇಷು ರಮತೇ|</para>
  <para style="p">
    <verse number="10" style="v"/>ತದಾ ತಸ್ಯ ಶಿಷ್ಯಾಸ್ತಂ ಬಭಾಷಿರೇ, ಯದಿ ಸ್ವಜಾಯಯಾ ಸಾಕಂ ಪುಂಸ ಏತಾದೃಕ್ ಸಮ್ಬನ್ಧೋ ಜಾಯತೇ, ತರ್ಹಿ ವಿವಹನಮೇವ ನ ಭದ್ರಂ|</para>
  <para style="p">
    <verse number="11" style="v"/>ತತಃ ಸ ಉಕ್ತವಾನ್, ಯೇಭ್ಯಸ್ತತ್ಸಾಮರ್ಥ್ಯಂ ಆದಾಯಿ, ತಾನ್ ವಿನಾನ್ಯಃ ಕೋಪಿ ಮನುಜ ಏತನ್ಮತಂ ಗ್ರಹೀತುಂ ನ ಶಕ್ನೋತಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಕತಿಪಯಾ ಜನನಕ್ಲೀಬಃ ಕತಿಪಯಾ ನರಕೃತಕ್ಲೀಬಃ ಸ್ವರ್ಗರಾಜ್ಯಾಯ ಕತಿಪಯಾಃ ಸ್ವಕೃತಕ್ಲೀಬಾಶ್ಚ ಸನ್ತಿ, ಯೇ ಗ್ರಹೀತುಂ ಶಕ್ನುವನ್ತಿ ತೇ ಗೃಹ್ಲನ್ತು|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅಪರಮ್ ಯಥಾ ಸ ಶಿಶೂನಾಂ ಗಾತ್ರೇಷು ಹಸ್ತಂ ದತ್ವಾ ಪ್ರಾರ್ಥಯತೇ, ತದರ್ಥಂ ತತ್ಸಮೀಂಪಂ ಶಿಶವ ಆನೀಯನ್ತ, ತತ ಆನಯಿತೃನ್ ಶಿಷ್ಯಾಸ್ತಿರಸ್ಕೃತವನ್ತಃ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಕಿನ್ತು ಯೀಶುರುವಾಚ, ಶಿಶವೋ ಮದನ್ತಿಕಮ್ ಆಗಚ್ಛನ್ತು, ತಾನ್ ಮಾ ವಾರಯತ, ಏತಾದೃಶಾಂ ಶಿಶೂನಾಮೇವ ಸ್ವರ್ಗರಾಜ್ಯಂ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತತಃ ಸ ತೇಷಾಂ ಗಾತ್ರೇಷು ಹಸ್ತಂ ದತ್ವಾ ತಸ್ಮಾತ್ ಸ್ಥಾನಾತ್ ಪ್ರತಸ್ಥೇ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಅಪರಮ್ ಏಕ ಆಗತ್ಯ ತಂ ಪಪ್ರಚ್ಛ, ಹೇ ಪರಮಗುರೋ, ಅನನ್ತಾಯುಃ ಪ್ರಾಪ್ತುಂ ಮಯಾ ಕಿಂ ಕಿಂ ಸತ್ಕರ್ಮ್ಮ ಕರ್ತ್ತವ್ಯಂ?</para>
  <para style="p">
    <verse number="17" style="v"/>ತತಃ ಸ ಉವಾಚ, ಮಾಂ ಪರಮಂ ಕುತೋ ವದಸಿ? ವಿನೇಶ್ಚರಂ ನ ಕೋಪಿ ಪರಮಃ, ಕಿನ್ತು ಯದ್ಯನನ್ತಾಯುಃ ಪ್ರಾಪ್ತುಂ ವಾಞ್ಛಸಿ, ತರ್ಹ್ಯಾಜ್ಞಾಃ ಪಾಲಯ|</para>
  <para style="p">
    <verse number="18" style="v"/>ತದಾ ಸ ಪೃಷ್ಟವಾನ್, ಕಾಃ ಕಾ ಆಜ್ಞಾಃ? ತತೋ ಯೀಶುಃ ಕಥಿತವಾನ್, ನರಂ ಮಾ ಹನ್ಯಾಃ, ಪರದಾರಾನ್ ಮಾ ಗಚ್ಛೇಃ, ಮಾ ಚೋರಯೇಃ, ಮೃಷಾಸಾಕ್ಷ್ಯಂ ಮಾ ದದ್ಯಾಃ,</para>
  <para style="p">
    <verse number="19" style="v"/>ನಿಜಪಿತರೌ ಸಂಮನ್ಯಸ್ವ, ಸ್ವಸಮೀಪವಾಸಿನಿ ಸ್ವವತ್ ಪ್ರೇಮ ಕುರು|</para>
  <para style="p">
    <verse number="20" style="v"/>ಸ ಯುವಾ ಕಥಿತವಾನ್, ಆ ಬಾಲ್ಯಾದ್ ಏತಾಃ ಪಾಲಯಾಮಿ, ಇದಾನೀಂ ಕಿಂ ನ್ಯೂನಮಾಸ್ತೇ?</para>
  <para style="p">
    <verse number="21" style="v"/>ತತೋ ಯೀಶುರವದತ್, ಯದಿ ಸಿದ್ಧೋ ಭವಿತುಂ ವಾಞ್ಛಸಿ, ತರ್ಹಿ ಗತ್ವಾ ನಿಜಸರ್ವ್ವಸ್ವಂ ವಿಕ್ರೀಯ ದರಿದ್ರೇಭ್ಯೋ ವಿತರ, ತತಃ ಸ್ವರ್ಗೇ ವಿತ್ತಂ ಲಪ್ಸ್ಯಸೇ; ಆಗಚ್ಛ, ಮತ್ಪಶ್ಚಾದ್ವರ್ತ್ತೀ ಚ ಭವ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಏತಾಂ ವಾಚಂ ಶ್ರುತ್ವಾ ಸ ಯುವಾ ಸ್ವೀಯಬಹುಸಮ್ಪತ್ತೇ ರ್ವಿಷಣಃ ಸನ್ ಚಲಿತವಾನ್|</para>
  <para style="p">
    <verse number="23" style="v"/>ತದಾ ಯೀಶುಃ ಸ್ವಶಿಷ್ಯಾನ್ ಅವದತ್, ಧನಿನಾಂ ಸ್ವರ್ಗರಾಜ್ಯಪ್ರವೇಶೋ ಮಹಾದುಷ್ಕರ ಇತಿ ಯುಷ್ಮಾನಹಂ ತಥ್ಯಂ ವದಾಮಿ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಪುನರಪಿ ಯುಷ್ಮಾನಹಂ ವದಾಮಿ, ಧನಿನಾಂ ಸ್ವರ್ಗರಾಜ್ಯಪ್ರವೇಶಾತ್ ಸೂಚೀಛಿದ್ರೇಣ ಮಹಾಙ್ಗಗಮನಂ ಸುಕರಂ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಇತಿ ವಾಕ್ಯಂ ನಿಶಮ್ಯ ಶಿಷ್ಯಾ ಅತಿಚಮತ್ಕೃತ್ಯ ಕಥಯಾಮಾಸುಃ; ತರ್ಹಿ ಕಸ್ಯ ಪರಿತ್ರಾಣಂ ಭವಿತುಂ ಶಕ್ನೋತಿ?</para>
  <para style="p">
    <verse number="26" style="v"/>ತದಾ ಸ ತಾನ್ ದೃಷ್ದ್ವಾ ಕಥಯಾಮಾಸ, ತತ್ ಮಾನುಷಾಣಾಮಶಕ್ಯಂ ಭವತಿ, ಕಿನ್ತ್ವೀಶ್ವರಸ್ಯ ಸರ್ವ್ವಂ ಶಕ್ಯಮ್|</para>
  <para style="p">
    <verse number="27" style="v"/>ತದಾ ಪಿತರಸ್ತಂ ಗದಿತವಾನ್, ಪಶ್ಯ, ವಯಂ ಸರ್ವ್ವಂ ಪರಿತ್ಯಜ್ಯ ಭವತಃ ಪಶ್ಚಾದ್ವರ್ತ್ತಿನೋ ಽಭವಾಮ; ವಯಂ ಕಿಂ ಪ್ರಾಪ್ಸ್ಯಾಮಃ?</para>
  <para style="p">
    <verse number="28" style="v"/>ತತೋ ಯೀಶುಃ ಕಥಿತವಾನ್, ಯುಷ್ಮಾನಹಂ ತಥ್ಯಂ ವದಾಮಿ, ಯೂಯಂ ಮಮ ಪಶ್ಚಾದ್ವರ್ತ್ತಿನೋ ಜಾತಾ ಇತಿ ಕಾರಣಾತ್ ನವೀನಸೃಷ್ಟಿಕಾಲೇ ಯದಾ ಮನುಜಸುತಃ ಸ್ವೀಯೈಶ್ಚರ್ಯ್ಯಸಿಂಹಾಸನ ಉಪವೇಕ್ಷ್ಯತಿ, ತದಾ ಯೂಯಮಪಿ ದ್ವಾದಶಸಿಂಹಾಸನೇಷೂಪವಿಶ್ಯ ಇಸ್ರಾಯೇಲೀಯದ್ವಾದಶವಂಶಾನಾಂ ವಿಚಾರಂ ಕರಿಷ್ಯಥ|</para>
  <para style="p">
    <verse number="29" style="v"/>ಅನ್ಯಚ್ಚ ಯಃ ಕಶ್ಚಿತ್ ಮಮ ನಾಮಕಾರಣಾತ್ ಗೃಹಂ ವಾ ಭ್ರಾತರಂ ವಾ ಭಗಿನೀಂ ವಾ ಪಿತರಂ ವಾ ಮಾತರಂ ವಾ ಜಾಯಾಂ ವಾ ಬಾಲಕಂ ವಾ ಭೂಮಿಂ ಪರಿತ್ಯಜತಿ, ಸ ತೇಷಾಂ ಶತಗುಣಂ ಲಪ್ಸ್ಯತೇ, ಅನನ್ತಾಯುಮೋಽಧಿಕಾರಿತ್ವಞ್ಚ ಪ್ರಾಪ್ಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="30" style="v"/>ಕಿನ್ತು ಅಗ್ರೀಯಾ ಅನೇಕೇ ಜನಾಃ ಪಶ್ಚಾತ್, ಪಶ್ಚಾತೀಯಾಶ್ಚಾನೇಕೇ ಲೋಕಾ ಅಗ್ರೇ ಭವಿಷ್ಯನ್ತಿ|</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಸ್ವರ್ಗರಾಜ್ಯಮ್ ಏತಾದೃಶಾ ಕೇನಚಿದ್ ಗೃಹಸ್ಯೇನ ಸಮಂ, ಯೋಽತಿಪ್ರಭಾತೇ ನಿಜದ್ರಾಕ್ಷಾಕ್ಷೇತ್ರೇ ಕೃಷಕಾನ್ ನಿಯೋಕ್ತುಂ ಗತವಾನ್|</para>
  <para style="p">
    <verse number="2" style="v"/>ಪಶ್ಚಾತ್ ತೈಃ ಸಾಕಂ ದಿನೈಕಭೃತಿಂ ಮುದ್ರಾಚತುರ್ಥಾಂಶಂ ನಿರೂಪ್ಯ ತಾನ್ ದ್ರಾಕ್ಷಾಕ್ಷೇತ್ರಂ ಪ್ರೇರಯಾಮಾಸ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅನನ್ತರಂ ಪ್ರಹರೈಕವೇಲಾಯಾಂ ಗತ್ವಾ ಹಟ್ಟೇ ಕತಿಪಯಾನ್ ನಿಷ್ಕರ್ಮ್ಮಕಾನ್ ವಿಲೋಕ್ಯ ತಾನವದತ್,</para>
  <para style="p">
    <verse number="4" style="v"/>ಯೂಯಮಪಿ ಮಮ ದ್ರಾಕ್ಷಾಕ್ಷೇತ್ರಂ ಯಾತ, ಯುಷ್ಮಭ್ಯಮಹಂ ಯೋಗ್ಯಭೃತಿಂ ದಾಸ್ಯಾಮಿ, ತತಸ್ತೇ ವವ್ರಜುಃ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಪುನಶ್ಚ ಸ ದ್ವಿತೀಯತೃತೀಯಯೋಃ ಪ್ರಹರಯೋ ರ್ಬಹಿ ರ್ಗತ್ವಾ ತಥೈವ ಕೃತವಾನ್|</para>
  <para style="p">
    <verse number="6" style="v"/>ತತೋ ದಣ್ಡದ್ವಯಾವಶಿಷ್ಟಾಯಾಂ ವೇಲಾಯಾಂ ಬಹಿ ರ್ಗತ್ವಾಪರಾನ್ ಕತಿಪಯಜನಾನ್ ನಿಷ್ಕರ್ಮ್ಮಕಾನ್ ವಿಲೋಕ್ಯ ಪೃಷ್ಟವಾನ್, ಯೂಯಂ ಕಿಮರ್ಥಮ್ ಅತ್ರ ಸರ್ವ್ವಂ ದಿನಂ ನಿಷ್ಕರ್ಮ್ಮಾಣಸ್ತಿಷ್ಠಥ?</para>
  <para style="p">
    <verse number="7" style="v"/>ತೇ ಪ್ರತ್ಯವದನ್, ಅಸ್ಮಾನ್ ನ ಕೋಪಿ ಕರ್ಮಮಣಿ ನಿಯುಂಕ್ತೇ| ತದಾನೀಂ ಸ ಕಥಿತವಾನ್, ಯೂಯಮಪಿ ಮಮ ದ್ರಾಕ್ಷಾಕ್ಷೇತ್ರಂ ಯಾತ, ತೇನ ಯೋಗ್ಯಾಂ ಭೃತಿಂ ಲಪ್ಸ್ಯಥ|</para>
  <para style="p">
    <verse number="8" style="v"/>ತದನನ್ತರಂ ಸನ್ಧ್ಯಾಯಾಂ ಸತ್ಯಾಂ ಸಏವ ದ್ರಾಕ್ಷಾಕ್ಷೇತ್ರಪತಿರಧ್ಯಕ್ಷಂ ಗದಿವಾನ್, ಕೃಷಕಾನ್ ಆಹೂಯ ಶೇಷಜನಮಾರಭ್ಯ ಪ್ರಥಮಂ ಯಾವತ್ ತೇಭ್ಯೋ ಭೃತಿಂ ದೇಹಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ತೇನ ಯೇ ದಣ್ಡದ್ವಯಾವಸ್ಥಿತೇ ಸಮಾಯಾತಾಸ್ತೇಷಾಮ್ ಏಕೈಕೋ ಜನೋ ಮುದ್ರಾಚತುರ್ಥಾಂಶಂ ಪ್ರಾಪ್ನೋತ್|</para>
  <para style="p">
    <verse number="10" style="v"/>ತದಾನೀಂ ಪ್ರಥಮನಿಯುಕ್ತಾ ಜನಾ ಆಗತ್ಯಾನುಮಿತವನ್ತೋ ವಯಮಧಿಕಂ ಪ್ರಪ್ಸ್ಯಾಮಃ, ಕಿನ್ತು ತೈರಪಿ ಮುದ್ರಾಚತುರ್ಥಾಂಶೋಽಲಾಭಿ|</para>
  <para style="p">
    <verse number="11" style="v"/>ತತಸ್ತೇ ತಂ ಗೃಹೀತ್ವಾ ತೇನ ಕ್ಷೇತ್ರಪತಿನಾ ಸಾಕಂ ವಾಗ್ಯುದ್ಧಂ ಕುರ್ವ್ವನ್ತಃ ಕಥಯಾಮಾಸುಃ,</para>
  <para style="p">
    <verse number="12" style="v"/>ವಯಂ ಕೃತ್ಸ್ನಂ ದಿನಂ ತಾಪಕ್ಲೇಶೌ ಸೋಢವನ್ತಃ, ಕಿನ್ತು ಪಶ್ಚಾತಾಯಾ ಸೇ ಜನಾ ದಣ್ಡದ್ವಯಮಾತ್ರಂ ಪರಿಶ್ರಾನ್ತವನ್ತಸ್ತೇಽಸ್ಮಾಭಿಃ ಸಮಾನಾಂಶಾಃ ಕೃತಾಃ|</para>
  <para style="p">
    <verse number="13" style="v"/>ತತಃ ಸ ತೇಷಾಮೇಕಂ ಪ್ರತ್ಯುವಾಚ, ಹೇ ವತ್ಸ, ಮಯಾ ತ್ವಾಂ ಪ್ರತಿ ಕೋಪ್ಯನ್ಯಾಯೋ ನ ಕೃತಃ ಕಿಂ ತ್ವಯಾ ಮತ್ಸಮಕ್ಷಂ ಮುದ್ರಾಚತುರ್ಥಾಂಶೋ ನಾಙ್ಗೀಕೃತಃ?</para>
  <para style="p">
    <verse number="14" style="v"/>ತಸ್ಮಾತ್ ತವ ಯತ್ ಪ್ರಾಪ್ಯಂ ತದಾದಾಯ ಯಾಹಿ, ತುಭ್ಯಂ ಯತಿ, ಪಶ್ಚಾತೀಯನಿಯುಕ್ತಲೋಕಾಯಾಪಿ ತತಿ ದಾತುಮಿಚ್ಛಾಮಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಸ್ವೇಚ್ಛಯಾ ನಿಜದ್ರವ್ಯವ್ಯವಹರಣಂ ಕಿಂ ಮಯಾ ನ ಕರ್ತ್ತವ್ಯಂ? ಮಮ ದಾತೃತ್ವಾತ್ ತ್ವಯಾ ಕಿಮ್ ಈರ್ಷ್ಯಾದೃಷ್ಟಿಃ ಕ್ರಿಯತೇ?</para>
  <para style="p">
    <verse number="16" style="v"/>ಇತ್ಥಮ್ ಅಗ್ರೀಯಲೋಕಾಃ ಪಶ್ಚತೀಯಾ ಭವಿಷ್ಯನ್ತಿ, ಪಶ್ಚಾತೀಯಜನಾಶ್ಚಗ್ರೀಯಾ ಭವಿಷ್ಯನ್ತಿ, ಅಹೂತಾ ಬಹವಃ ಕಿನ್ತ್ವಲ್ಪೇ ಮನೋಭಿಲಷಿತಾಃ|</para>
  <para style="p">
    <verse number="17" style="v"/>ತದನನ್ತರಂ ಯೀಶು ರ್ಯಿರೂಶಾಲಮ್ನಗರಂ ಗಚ್ಛನ್ ಮಾರ್ಗಮಧ್ಯೇ ಶಿಷ್ಯಾನ್ ಏಕಾನ್ತೇ ವಭಾಷೇ,</para>
  <para style="p">
    <verse number="18" style="v"/>ಪಶ್ಯ ವಯಂ ಯಿರೂಶಾಲಮ್ನಗರಂ ಯಾಮಃ, ತತ್ರ ಪ್ರಧಾನಯಾಜಕಾಧ್ಯಾಪಕಾನಾಂ ಕರೇಷು ಮನುಷ್ಯಪುತ್ರಃ ಸಮರ್ಪಿಷ್ಯತೇ;</para>
  <para style="p">
    <verse number="19" style="v"/>ತೇ ಚ ತಂ ಹನ್ತುಮಾಜ್ಞಾಪ್ಯ ತಿರಸ್ಕೃತ್ಯ ವೇತ್ರೇಣ ಪ್ರಹರ್ತ್ತುಂ ಕ್ರುಶೇ ಧಾತಯಿತುಞ್ಚಾನ್ಯದೇಶೀಯಾನಾಂ ಕರೇಷು ಸಮರ್ಪಯಿಷ್ಯನ್ತಿ, ಕಿನ್ತು ಸ ತೃತೀಯದಿವಸೇ ಶ್ಮಶಾನಾದ್ ಉತ್ಥಾಪಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="20" style="v"/>ತದಾನೀಂ ಸಿವದೀಯಸ್ಯ ನಾರೀ ಸ್ವಪುತ್ರಾವಾದಾಯ ಯೀಶೋಃ ಸಮೀಪಮ್ ಏತ್ಯ ಪ್ರಣಮ್ಯ ಕಞ್ಚನಾನುಗ್ರಹಂ ತಂ ಯಯಾಚೇ|</para>
  <para style="p">
    <verse number="21" style="v"/>ತದಾ ಯೀಶುಸ್ತಾಂ ಪ್ರೋಕ್ತವಾನ್, ತ್ವಂ ಕಿಂ ಯಾಚಸೇ? ತತಃ ಸಾ ಬಭಾಷೇ, ಭವತೋ ರಾಜತ್ವೇ ಮಮಾನಯೋಃ ಸುತಯೋರೇಕಂ ಭವದ್ದಕ್ಷಿಣಪಾರ್ಶ್ವೇ ದ್ವಿತೀಯಂ ವಾಮಪಾರ್ಶ್ವ ಉಪವೇಷ್ಟುಮ್ ಆಜ್ಞಾಪಯತು|</para>
  <para style="p">
    <verse number="22" style="v"/>ಯೀಶುಃ ಪ್ರತ್ಯುವಾಚ, ಯುವಾಭ್ಯಾಂ ಯದ್ ಯಾಚ್ಯತೇ, ತನ್ನ ಬುಧ್ಯತೇ, ಅಹಂ ಯೇನ ಕಂಸೇನ ಪಾಸ್ಯಾಮಿ ಯುವಾಭ್ಯಾಂ ಕಿಂ ತೇನ ಪಾತುಂ ಶಕ್ಯತೇ? ಅಹಞ್ಚ ಯೇನ ಮಜ್ಜೇನೇನ ಮಜ್ಜಿಷ್ಯೇ, ಯುವಾಭ್ಯಾಂ ಕಿಂ ತೇನ ಮಜ್ಜಯಿತುಂ ಶಕ್ಯತೇ? ತೇ ಜಗದುಃ ಶಕ್ಯತೇ|</para>
  <para style="p">
    <verse number="23" style="v"/>ತದಾ ಸ ಉಕ್ತವಾನ್, ಯುವಾಂ ಮಮ ಕಂಸೇನಾವಶ್ಯಂ ಪಾಸ್ಯಥಃ, ಮಮ ಮಜ್ಜನೇನ ಚ ಯುವಾಮಪಿ ಮಜ್ಜಿಷ್ಯೇಥೇ, ಕಿನ್ತು ಯೇಷಾಂ ಕೃತೇ ಮತ್ತಾತೇನ ನಿರೂಪಿತಮ್ ಇದಂ ತಾನ್ ವಿಹಾಯಾನ್ಯಂ ಕಮಪಿ ಮದ್ದಕ್ಷಿಣಪಾರ್ಶ್ವೇ ವಾಮಪಾರ್ಶ್ವೇ ಚ ಸಮುಪವೇಶಯಿತುಂ ಮಮಾಧಿಕಾರೋ ನಾಸ್ತಿ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಏತಾಂ ಕಥಾಂ ಶ್ರುತ್ವಾನ್ಯೇ ದಶಶಿಷ್ಯಾಸ್ತೌ ಭ್ರಾತರೌ ಪ್ರತಿ ಚುಕುಪುಃ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಕಿನ್ತು ಯೀಶುಃ ಸ್ವಸಮೀಪಂ ತಾನಾಹೂಯ ಜಗಾದ, ಅನ್ಯದೇಶೀಯಲೋಕಾನಾಂ ನರಪತಯಸ್ತಾನ್ ಅಧಿಕುರ್ವ್ವನ್ತಿ, ಯೇ ತು ಮಹಾನ್ತಸ್ತೇ ತಾನ್ ಶಾಸತಿ, ಇತಿ ಯೂಯಂ ಜಾನೀಥ|</para>
  <para style="p">
    <verse number="26" style="v"/>ಕಿನ್ತು ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ನ ತಥಾ ಭವೇತ್, ಯುಷ್ಮಾಕಂ ಯಃ ಕಶ್ಚಿತ್ ಮಹಾನ್ ಬುಭೂಷತಿ, ಸ ಯುಷ್ಮಾನ್ ಸೇವೇತ;</para>
  <para style="p">
    <verse number="27" style="v"/>ಯಶ್ಚ ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ಮುಖ್ಯೋ ಬುಭೂಷತಿ, ಸ ಯುಷ್ಮಾಕಂ ದಾಸೋ ಭವೇತ್|</para>
  <para style="p">
    <verse number="28" style="v"/>ಇತ್ಥಂ ಮನುಜಪುತ್ರಃ ಸೇವ್ಯೋ ಭವಿತುಂ ನಹಿ, ಕಿನ್ತು ಸೇವಿತುಂ ಬಹೂನಾಂ ಪರಿತ್ರಾಣಮೂಲ್ಯಾರ್ಥಂ ಸ್ವಪ್ರಾಣಾನ್ ದಾತುಞ್ಚಾಗತಃ|</para>
  <para style="p">
    <verse number="29" style="v"/>ಅನನ್ತರಂ ಯಿರೀಹೋನಗರಾತ್ ತೇಷಾಂ ಬಹಿರ್ಗಮನಸಮಯೇ ತಸ್ಯ ಪಶ್ಚಾದ್ ಬಹವೋ ಲೋಕಾ ವವ್ರಜುಃ|</para>
  <para style="p">
    <verse number="30" style="v"/>ಅಪರಂ ವರ್ತ್ಮಪಾರ್ಶ್ವ ಉಪವಿಶನ್ತೌ ದ್ವಾವನ್ಧೌ ತೇನ ಮಾರ್ಗೇಣ ಯೀಶೋ ರ್ಗಮನಂ ನಿಶಮ್ಯ ಪ್ರೋಚ್ಚೈಃ ಕಥಯಾಮಾಸತುಃ, ಹೇ ಪ್ರಭೋ ದಾಯೂದಃ ಸನ್ತಾನ, ಆವಯೋ ರ್ದಯಾಂ ವಿಧೇಹಿ|</para>
  <para style="p">
    <verse number="31" style="v"/>ತತೋ ಲೋಕಾಃ ಸರ್ವ್ವೇ ತುಷ್ಣೀಮ್ಭವತಮಿತ್ಯುಕ್ತ್ವಾ ತೌ ತರ್ಜಯಾಮಾಸುಃ; ತಥಾಪಿ ತೌ ಪುನರುಚ್ಚೈಃ ಕಥಯಾಮಾಸತುಃ ಹೇ ಪ್ರಭೋ ದಾಯೂದಃ ಸನ್ತಾನ, ಆವಾಂ ದಯಸ್ವ|</para>
  <para style="p">
    <verse number="32" style="v"/>ತದಾನೀಂ ಯೀಶುಃ ಸ್ಥಗಿತಃ ಸನ್ ತಾವಾಹೂಯ ಭಾಷಿತವಾನ್, ಯುವಯೋಃ ಕೃತೇ ಮಯಾ ಕಿಂ ಕರ್ತ್ತರ್ವ್ಯಂ? ಯುವಾಂ ಕಿಂ ಕಾಮಯೇಥೇ?</para>
  <para style="p">
    <verse number="33" style="v"/>ತದಾ ತಾವುಕ್ತವನ್ತೌ, ಪ್ರಭೋ ನೇತ್ರಾಣಿ ನೌ ಪ್ರಸನ್ನಾನಿ ಭವೇಯುಃ|</para>
  <para style="p">
    <verse number="34" style="v"/>ತದಾನೀಂ ಯೀಶುಸ್ತೌ ಪ್ರತಿ ಪ್ರಮನ್ನಃ ಸನ್ ತಯೋ ರ್ನೇತ್ರಾಣಿ ಪಸ್ಪರ್ಶ, ತೇನೈವ ತೌ ಸುವೀಕ್ಷಾಞ್ಚಕ್ರಾತೇ ತತ್ಪಶ್ಚಾತ್ ಜಗ್ಮುತುಶ್ಚ|</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅನನ್ತರಂ ತೇಷು ಯಿರೂಶಾಲಮ್ನಗರಸ್ಯ ಸಮೀಪವೇರ್ತ್ತಿನೋ ಜೈತುನನಾಮಕಧರಾಧರಸ್ಯ ಸಮೀಪಸ್ಥ್ತಿಂ ಬೈತ್ಫಗಿಗ್ರಾಮಮ್ ಆಗತೇಷು, ಯೀಶುಃ ಶಿಷ್ಯದ್ವಯಂ ಪ್ರೇಷಯನ್ ಜಗಾದ,</para>
  <para style="p">
    <verse number="2" style="v"/>ಯುವಾಂ ಸಮ್ಮುಖಸ್ಥಗ್ರಾಮಂ ಗತ್ವಾ ಬದ್ಧಾಂ ಯಾಂ ಸವತ್ಸಾಂ ಗರ್ದ್ದಭೀಂ ಹಠಾತ್ ಪ್ರಾಪ್ಸ್ಯಥಃ, ತಾಂ ಮೋಚಯಿತ್ವಾ ಮದನ್ತಿಕಮ್ ಆನಯತಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ತತ್ರ ಯದಿ ಕಶ್ಚಿತ್ ಕಿಞ್ಚಿದ್ ವಕ್ಷ್ಯತಿ, ತರ್ಹಿ ವದಿಷ್ಯಥಃ, ಏತಸ್ಯಾಂ ಪ್ರಭೋಃ ಪ್ರಯೋಜನಮಾಸ್ತೇ, ತೇನ ಸ ತತ್ಕ್ಷಣಾತ್ ಪ್ರಹೇಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಸೀಯೋನಃ ಕನ್ಯಕಾಂ ಯೂಯಂ ಭಾಷಧ್ವಮಿತಿ ಭಾರತೀಂ| ಪಶ್ಯ ತೇ ನಮ್ರಶೀಲಃ ಸನ್ ನೃಪ ಆರುಹ್ಯ ಗರ್ದಭೀಂ| ಅರ್ಥಾದಾರುಹ್ಯ ತದ್ವತ್ಸಮಾಯಾಸ್ಯತಿ ತ್ವದನ್ತಿಕಂ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಭವಿಷ್ಯದ್ವಾದಿನೋಕ್ತಂ ವಚನಮಿದಂ ತದಾ ಸಫಲಮಭೂತ್|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅನನ್ತರಂ ತೌ ಶ್ಷ್ಯಿौ ಯೀಶೋ ರ್ಯಥಾನಿದೇಶಂ ತಂ ಗ್ರಾಮಂ ಗತ್ವಾ</para>
  <para style="p">
    <verse number="7" style="v"/>ಗರ್ದಭೀಂ ತದ್ವತ್ಸಞ್ಚ ಸಮಾನೀತವನ್ತೌ, ಪಶ್ಚಾತ್ ತದುಪರಿ ಸ್ವೀಯವಸನಾನೀ ಪಾತಯಿತ್ವಾ ತಮಾರೋಹಯಾಮಾಸತುಃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ತತೋ ಬಹವೋ ಲೋಕಾ ನಿಜವಸನಾನಿ ಪಥಿ ಪ್ರಸಾರಯಿತುಮಾರೇಭಿರೇ, ಕತಿಪಯಾ ಜನಾಶ್ಚ ಪಾದಪಪರ್ಣಾದಿಕಂ ಛಿತ್ವಾ ಪಥಿ ವಿಸ್ತಾರಯಾಮಾಸುಃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಅಗ್ರಗಾಮಿನಃ ಪಶ್ಚಾದ್ಗಾಮಿನಶ್ಚ ಮನುಜಾ ಉಚ್ಚೈರ್ಜಯ ಜಯ ದಾಯೂದಃ ಸನ್ತಾನೇತಿ ಜಗದುಃ ಪರಮೇಶ್ವರಸ್ಯ ನಾಮ್ನಾ ಯ ಆಯಾತಿ ಸ ಧನ್ಯಃ, ಸರ್ವ್ವೋಪರಿಸ್ಥಸ್ವರ್ಗೇಪಿ ಜಯತಿ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಇತ್ಥಂ ತಸ್ಮಿನ್ ಯಿರೂಶಾಲಮಂ ಪ್ರವಿಷ್ಟೇ ಕೋಽಯಮಿತಿ ಕಥನಾತ್ ಕೃತ್ಸ್ನಂ ನಗರಂ ಚಞ್ಚಲಮಭವತ್|</para>
  <para style="p">
    <verse number="11" style="v"/>ತತ್ರ ಲೋಕೋಃ ಕಥಯಾಮಾಸುಃ, ಏಷ ಗಾಲೀಲ್ಪ್ರದೇಶೀಯ-ನಾಸರತೀಯ-ಭವಿಷ್ಯದ್ವಾದೀ ಯೀಶುಃ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಅನನ್ತರಂ ಯೀಶುರೀಶ್ವರಸ್ಯ ಮನ್ದಿರಂ ಪ್ರವಿಶ್ಯ ತನ್ಮಧ್ಯಾತ್ ಕ್ರಯವಿಕ್ರಯಿಣೋ ವಹಿಶ್ಚಕಾರ; ವಣಿಜಾಂ ಮುದ್ರಾಸನಾನೀ ಕಪೋತವಿಕ್ರಯಿಣಾಞ್ಚಸನಾನೀ ಚ ನ್ಯುವ್ಜಯಾಮಾಸ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅಪರಂ ತಾನುವಾಚ, ಏಷಾ ಲಿಪಿರಾಸ್ತೇ, "ಮಮ ಗೃಹಂ ಪ್ರಾರ್ಥನಾಗೃಹಮಿತಿ ವಿಖ್ಯಾಸ್ಯತಿ", ಕಿನ್ತು ಯೂಯಂ ತದ್ ದಸ್ಯೂನಾಂ ಗಹ್ವರಂ ಕೃತವನ್ತಃ|</para>
  <para style="p">
    <verse number="14" style="v"/>ತದನನ್ತರಮ್ ಅನ್ಧಖಞ್ಚಲೋಕಾಸ್ತಸ್ಯ ಸಮೀಪಮಾಗತಾಃ, ಸ ತಾನ್ ನಿರಾಮಯಾನ್ ಕೃತವಾನ್|</para>
  <para style="p">
    <verse number="15" style="v"/>ಯದಾ ಪ್ರಧಾನಯಾಜಕಾ ಅಧ್ಯಾಪಕಾಶ್ಚ ತೇನ ಕೃತಾನ್ಯೇತಾನಿ ಚಿತ್ರಕರ್ಮ್ಮಾಣಿ ದದೃಶುಃ, ಜಯ ಜಯ ದಾಯೂದಃ ಸನ್ತಾನ, ಮನ್ದಿರೇ ಬಾಲಕಾನಾಮ್ ಏತಾದೃಶಮ್ ಉಚ್ಚಧ್ವನಿಂ ಶುಶ್ರುವುಶ್ಚ, ತದಾ ಮಹಾಕ್ರುದ್ಧಾ ಬಭೂವಃ,</para>
  <para style="p">
    <verse number="16" style="v"/>ತಂ ಪಪ್ರಚ್ಛುಶ್ಚ, ಇಮೇ ಯದ್ ವದನ್ತಿ, ತತ್ ಕಿಂ ತ್ವಂ ಶೃಣೋಷಿ? ತತೋ ಯೀಶುಸ್ತಾನ್ ಅವೋಚತ್, ಸತ್ಯಮ್; ಸ್ತನ್ಯಪಾಯಿಶಿಶೂನಾಞ್ಚ ಬಾಲಕಾನಾಞ್ಚ ವಕ್ತ್ರತಃ| ಸ್ವಕೀಯಂ ಮಹಿಮಾನಂ ತ್ವಂ ಸಂಪ್ರಕಾಶಯಸಿ ಸ್ವಯಂ| ಏತದ್ವಾಕ್ಯಂ ಯೂಯಂ ಕಿಂ ನಾಪಠತ?</para>
  <para style="p">
    <verse number="17" style="v"/>ತತಸ್ತಾನ್ ವಿಹಾಯ ಸ ನಗರಾದ್ ಬೈಥನಿಯಾಗ್ರಾಮಂ ಗತ್ವಾ ತತ್ರ ರಜನೀಂ ಯಾಪಯಾಮಾಸ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಅನನ್ತರಂ ಪ್ರಭಾತೇ ಸತಿ ಯೀಶುಃ ಪುನರಪಿ ನಗರಮಾಗಚ್ಛನ್ ಕ್ಷುಧಾರ್ತ್ತೋ ಬಭೂವ|</para>
  <para style="p">
    <verse number="19" style="v"/>ತತೋ ಮಾರ್ಗಪಾರ್ಶ್ವ ಉಡುಮ್ಬರವೃಕ್ಷಮೇಕಂ ವಿಲೋಕ್ಯ ತತ್ಸಮೀಪಂ ಗತ್ವಾ ಪತ್ರಾಣಿ ವಿನಾ ಕಿಮಪಿ ನ ಪ್ರಾಪ್ಯ ತಂ ಪಾದಪಂ ಪ್ರೋವಾಚ, ಅದ್ಯಾರಭ್ಯ ಕದಾಪಿ ತ್ವಯಿ ಫಲಂ ನ ಭವತು; ತೇನ ತತ್ಕ್ಷಣಾತ್ ಸ ಉಡುಮ್ಬರಮಾಹೀರುಹಃ ಶುಷ್ಕತಾಂ ಗತಃ|</para>
  <para style="p">
    <verse number="20" style="v"/>ತದ್ ದೃಷ್ಟ್ವಾ ಶಿಷ್ಯಾ ಆಶ್ಚರ್ಯ್ಯಂ ವಿಜ್ಞಾಯ ಕಥಯಾಮಾಸುಃ, ಆಃ, ಉಡುಮ್ವರಪಾದಪೋಽತಿತೂರ್ಣಂ ಶುಷ್ಕೋಽಭವತ್|</para>
  <para style="p">
    <verse number="21" style="v"/>ತತೋ ಯೀಶುಸ್ತಾನುವಾಚ, ಯುಷ್ಮಾನಹಂ ಸತ್ಯಂ ವದಾಮಿ, ಯದಿ ಯೂಯಮಸನ್ದಿಗ್ಧಾಃ ಪ್ರತೀಥ, ತರ್ಹಿ ಯೂಯಮಪಿ ಕೇವಲೋಡುಮ್ವರಪಾದಪಂ ಪ್ರತೀತ್ಥಂ ಕರ್ತ್ತುಂ ಶಕ್ಷ್ಯಥ, ತನ್ನ, ತ್ವಂ ಚಲಿತ್ವಾ ಸಾಗರೇ ಪತೇತಿ ವಾಕ್ಯಂ ಯುಷ್ಮಾಭಿರಸ್ಮಿನ ಶೈಲೇ ಪ್ರೋಕ್ತೇಪಿ ತದೈವ ತದ್ ಘಟಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="22" style="v"/>ತಥಾ ವಿಶ್ವಸ್ಯ ಪ್ರಾರ್ಥ್ಯ ಯುಷ್ಮಾಭಿ ರ್ಯದ್ ಯಾಚಿಷ್ಯತೇ, ತದೇವ ಪ್ರಾಪ್ಸ್ಯತೇ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಅನನ್ತರಂ ಮನ್ದಿರಂ ಪ್ರವಿಶ್ಯೋಪದೇಶನಸಮಯೇ ತತ್ಸಮೀಪಂ ಪ್ರಧಾನಯಾಜಕಾಃ ಪ್ರಾಚೀನಲೋಕಾಶ್ಚಾಗತ್ಯ ಪಪ್ರಚ್ಛುಃ, ತ್ವಯಾ ಕೇನ ಸಾಮರ್ಥ್ಯನೈತಾನಿ ಕರ್ಮ್ಮಾಣಿ ಕ್ರಿಯನ್ತೇ? ಕೇನ ವಾ ತುಭ್ಯಮೇತಾನಿ ಸಾಮರ್ಥ್ಯಾನಿ ದತ್ತಾನಿ?</para>
  <para style="p">
    <verse number="24" style="v"/>ತತೋ ಯೀಶುಃ ಪ್ರತ್ಯವದತ್, ಅಹಮಪಿ ಯುಷ್ಮಾನ್ ವಾಚಮೇಕಾಂ ಪೃಚ್ಛಾಮಿ, ಯದಿ ಯೂಯಂ ತದುತ್ತರಂ ದಾತುಂ ಶಕ್ಷ್ಯಥ, ತದಾ ಕೇನ ಸಾಮರ್ಥ್ಯೇನ ಕರ್ಮ್ಮಾಣ್ಯೇತಾನಿ ಕರೋಮಿ, ತದಹಂ ಯುಷ್ಮಾನ್ ವಕ್ಷ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಯೋಹನೋ ಮಜ್ಜನಂ ಕಸ್ಯಾಜ್ಞಯಾಭವತ್? ಕಿಮೀಶ್ವರಸ್ಯ ಮನುಷ್ಯಸ್ಯ ವಾ? ತತಸ್ತೇ ಪರಸ್ಪರಂ ವಿವಿಚ್ಯ ಕಥಯಾಮಾಸುಃ, ಯದೀಶ್ವರಸ್ಯೇತಿ ವದಾಮಸ್ತರ್ಹಿ ಯೂಯಂ ತಂ ಕುತೋ ನ ಪ್ರತ್ಯೈತ? ವಾಚಮೇತಾಂ ವಕ್ಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="26" style="v"/>ಮನುಷ್ಯಸ್ಯೇತಿ ವಕ್ತುಮಪಿ ಲೋಕೇಭ್ಯೋ ಬಿಭೀಮಃ, ಯತಃ ಸರ್ವ್ವೈರಪಿ ಯೋಹನ್ ಭವಿಷ್ಯದ್ವಾದೀತಿ ಜ್ಞಾಯತೇ|</para>
  <para style="p">
    <verse number="27" style="v"/>ತಸ್ಮಾತ್ ತೇ ಯೀಶುಂ ಪ್ರತ್ಯವದನ್, ತದ್ ವಯಂ ನ ವಿದ್ಮಃ| ತದಾ ಸ ತಾನುಕ್ತವಾನ್, ತರ್ಹಿ ಕೇನ ಸಾಮರಥ್ಯೇನ ಕರ್ಮ್ಮಾಣ್ಯೇತಾನ್ಯಹಂ ಕರೋಮಿ, ತದಪ್ಯಹಂ ಯುಷ್ಮಾನ್ ನ ವಕ್ಷ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="28" style="v"/>ಕಸ್ಯಚಿಜ್ಜನಸ್ಯ ದ್ವೌ ಸುತಾವಾಸ್ತಾಂ ಸ ಏಕಸ್ಯ ಸುತಸ್ಯ ಸಮೀಪಂ ಗತ್ವಾ ಜಗಾದ, ಹೇ ಸುತ, ತ್ವಮದ್ಯ ಮಮ ದ್ರಾಕ್ಷಾಕ್ಷೇತ್ರೇ ಕರ್ಮ್ಮ ಕರ್ತುಂ ವ್ರಜ|</para>
  <para style="p">
    <verse number="29" style="v"/>ತತಃ ಸ ಉಕ್ತವಾನ್, ನ ಯಾಸ್ಯಾಮಿ, ಕಿನ್ತು ಶೇಷೇಽನುತಪ್ಯ ಜಗಾಮ|</para>
  <para style="p">
    <verse number="30" style="v"/>ಅನನ್ತರಂ ಸೋನ್ಯಸುತಸ್ಯ ಸಮೀಪಂ ಗತ್ವಾ ತಥೈವ ಕಥ್ತಿವಾನ್; ತತಃ ಸ ಪ್ರತ್ಯುವಾಚ, ಮಹೇಚ್ಛ ಯಾಮಿ, ಕಿನ್ತು ನ ಗತಃ|</para>
  <para style="p">
    <verse number="31" style="v"/>ಏತಯೋಃ ಪುತ್ರಯೋ ರ್ಮಧ್ಯೇ ಪಿತುರಭಿಮತಂ ಕೇನ ಪಾಲಿತಂ? ಯುಷ್ಮಾಭಿಃ ಕಿಂ ಬುಧ್ಯತೇ? ತತಸ್ತೇ ಪ್ರತ್ಯೂಚುಃ, ಪ್ರಥಮೇನ ಪುुತ್ರೇಣ| ತದಾನೀಂ ಯೀಶುಸ್ತಾನುವಾಚ, ಅಹಂ ಯುಷ್ಮಾನ್ ತಥ್ಯಂ ವದಾಮಿ, ಚಣ್ಡಾಲಾ ಗಣಿಕಾಶ್ಚ ಯುಷ್ಮಾಕಮಗ್ರತ ಈಶ್ವರಸ್ಯ ರಾಜ್ಯಂ ಪ್ರವಿಶನ್ತಿ|</para>
  <para style="p">
    <verse number="32" style="v"/>ಯತೋ ಯುಷ್ಮಾಕಂ ಸಮೀಪಂ ಯೋಹನಿ ಧರ್ಮ್ಮಪಥೇನಾಗತೇ ಯೂಯಂ ತಂ ನ ಪ್ರತೀಥ, ಕಿನ್ತು ಚಣ್ಡಾಲಾ ಗಣಿಕಾಶ್ಚ ತಂ ಪ್ರತ್ಯಾಯನ್, ತದ್ ವಿಲೋಕ್ಯಾಪಿ ಯೂಯಂ ಪ್ರತ್ಯೇತುಂ ನಾಖಿದ್ಯಧ್ವಂ|</para>
  <para style="p">
    <verse number="33" style="v"/>ಅಪರಮೇಕಂ ದೃಷ್ಟಾನ್ತಂ ಶೃಣುತ, ಕಶ್ಚಿದ್ ಗೃಹಸ್ಥಃ ಕ್ಷೇತ್ರೇ ದ್ರಾಕ್ಷಾಲತಾ ರೋಪಯಿತ್ವಾ ತಚ್ಚತುರ್ದಿಕ್ಷು ವಾರಣೀಂ ವಿಧಾಯ ತನ್ಮಧ್ಯೇ ದ್ರಾಕ್ಷಾಯನ್ತ್ರಂ ಸ್ಥಾಪಿತವಾನ್, ಮಾಞ್ಚಞ್ಚ ನಿರ್ಮ್ಮಿತವಾನ್, ತತಃ ಕೃಷಕೇಷು ತತ್ ಕ್ಷೇತ್ರಂ ಸಮರ್ಪ್ಯ ಸ್ವಯಂ ದೂರದೇಶಂ ಜಗಾಮ|</para>
  <para style="p">
    <verse number="34" style="v"/>ತದನನ್ತರಂ ಫಲಸಮಯ ಉಪಸ್ಥಿತೇ ಸ ಫಲಾನಿ ಪ್ರಾಪ್ತುಂ ಕೃಷೀವಲಾನಾಂ ಸಮೀಪಂ ನಿಜದಾಸಾನ್ ಪ್ರೇಷಯಾಮಾಸ|</para>
  <para style="p">
    <verse number="35" style="v"/>ಕಿನ್ತು ಕೃಷೀವಲಾಸ್ತಸ್ಯ ತಾನ್ ದಾಸೇಯಾನ್ ಧೃತ್ವಾ ಕಞ್ಚನ ಪ್ರಹೃತವನ್ತಃ, ಕಞ್ಚನ ಪಾಷಾಣೈರಾಹತವನ್ತಃ, ಕಞ್ಚನ ಚ ಹತವನ್ತಃ|</para>
  <para style="p">
    <verse number="36" style="v"/>ಪುನರಪಿ ಸ ಪ್ರಭುಃ ಪ್ರಥಮತೋಽಧಿಕದಾಸೇಯಾನ್ ಪ್ರೇಷಯಾಮಾಸ, ಕಿನ್ತು ತೇ ತಾನ್ ಪ್ರತ್ಯಪಿ ತಥೈವ ಚಕ್ರುಃ|</para>
  <para style="p">
    <verse number="37" style="v"/>ಅನನ್ತರಂ ಮಮ ಸುತೇ ಗತೇ ತಂ ಸಮಾದರಿಷ್ಯನ್ತೇ, ಇತ್ಯುಕ್ತ್ವಾ ಶೇಷೇ ಸ ನಿಜಸುತಂ ತೇಷಾಂ ಸನ್ನಿಧಿಂ ಪ್ರೇಷಯಾಮಾಸ|</para>
  <para style="p">
    <verse number="38" style="v"/>ಕಿನ್ತು ತೇ ಕೃಷೀವಲಾಃ ಸುತಂ ವೀಕ್ಷ್ಯ ಪರಸ್ಪರಮ್ ಇತಿ ಮನ್ತ್ರಯಿತುಮ್ ಆರೇಭಿರೇ, ಅಯಮುತ್ತರಾಧಿಕಾರೀ ವಯಮೇನಂ ನಿಹತ್ಯಾಸ್ಯಾಧಿಕಾರಂ ಸ್ವವಶೀಕರಿಷ್ಯಾಮಃ|</para>
  <para style="p">
    <verse number="39" style="v"/>ಪಶ್ಚಾತ್ ತೇ ತಂ ಧೃತ್ವಾ ದ್ರಾಕ್ಷಾಕ್ಷೇತ್ರಾದ್ ಬಹಿಃ ಪಾತಯಿತ್ವಾಬಧಿಷುಃ|</para>
  <para style="p">
    <verse number="40" style="v"/>ಯದಾ ಸ ದ್ರಾಕ್ಷಾಕ್ಷೇತ್ರಪತಿರಾಗಮಿಷ್ಯತಿ, ತದಾ ತಾನ್ ಕೃಷೀವಲಾನ್ ಕಿಂ ಕರಿಷ್ಯತಿ?</para>
  <para style="p">
    <verse number="41" style="v"/>ತತಸ್ತೇ ಪ್ರತ್ಯವದನ್, ತಾನ್ ಕಲುಷಿಣೋ ದಾರುಣಯಾತನಾಭಿರಾಹನಿಷ್ಯತಿ, ಯೇ ಚ ಸಮಯಾನುಕ್ರಮಾತ್ ಫಲಾನಿ ದಾಸ್ಯನ್ತಿ, ತಾದೃಶೇಷು ಕೃಷೀವಲೇಷು ಕ್ಷೇತ್ರಂ ಸಮರ್ಪಯಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="42" style="v"/>ತದಾ ಯೀಶುನಾ ತೇ ಗದಿತಾಃ, ಗ್ರಹಣಂ ನ ಕೃತಂ ಯಸ್ಯ ಪಾಷಾಣಸ್ಯ ನಿಚಾಯಕೈಃ| ಪ್ರಧಾನಪ್ರಸ್ತರಃ ಕೋಣೇ ಸಏವ ಸಂಭವಿಷ್ಯತಿ| ಏತತ್ ಪರೇಶಿತುಃ ಕರ್ಮ್ಮಾಸ್ಮದೃಷ್ಟಾವದ್ಭುತಂ ಭವೇತ್| ಧರ್ಮ್ಮಗ್ರನ್ಥೇ ಲಿಖಿತಮೇತದ್ವಚನಂ ಯುಷ್ಮಾಭಿಃ ಕಿಂ ನಾಪಾಠಿ?</para>
  <para style="p">
    <verse number="43" style="v"/>ತಸ್ಮಾದಹಂ ಯುಷ್ಮಾನ್ ವದಾಮಿ, ಯುಷ್ಮತ್ತ ಈಶ್ವರೀಯರಾಜ್ಯಮಪನೀಯ ಫಲೋತ್ಪಾದಯಿತ್ರನ್ಯಜಾತಯೇ ದಾಯಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="44" style="v"/>ಯೋ ಜನ ಏತತ್ಪಾಷಾಣೋಪರಿ ಪತಿಷ್ಯತಿ, ತಂ ಸ ಭಂಕ್ಷ್ಯತೇ, ಕಿನ್ತ್ವಯಂ ಪಾಷಾಣೋ ಯಸ್ಯೋಪರಿ ಪತಿಷ್ಯತಿ, ತಂ ಸ ಧೂಲಿವತ್ ಚೂರ್ಣೀಕರಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="45" style="v"/>ತದಾನೀಂ ಪ್ರಾಧನಯಾಜಕಾಃ ಫಿರೂಶಿನಶ್ಚ ತಸ್ಯೇಮಾಂ ದೃಷ್ಟಾನ್ತಕಥಾಂ ಶ್ರುತ್ವಾ ಸೋಽಸ್ಮಾನುದ್ದಿಶ್ಯ ಕಥಿತವಾನ್, ಇತಿ ವಿಜ್ಞಾಯ ತಂ ಧರ್ತ್ತುಂ ಚೇಷ್ಟಿತವನ್ತಃ;</para>
  <para style="p">
    <verse number="46" style="v"/>ಕಿನ್ತು ಲೋಕೇಭ್ಯೋ ಬಿಭ್ಯುಃ, ಯತೋ ಲೋಕೈಃ ಸ ಭವಿಷ್ಯದ್ವಾದೀತ್ಯಜ್ಞಾಯಿ|</para>
  <chapter number="22" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅನನ್ತರಂ ಯೀಶುಃ ಪುನರಪಿ ದೃಷ್ಟಾನ್ತೇನ ತಾನ್ ಅವಾದೀತ್,</para>
  <para style="p">
    <verse number="2" style="v"/>ಸ್ವರ್ಗೀಯರಾಜ್ಯಮ್ ಏತಾದೃಶಸ್ಯ ನೃಪತೇಃ ಸಮಂ, ಯೋ ನಿಜ ಪುತ್ರಂ ವಿವಾಹಯನ್ ಸರ್ವ್ವಾನ್ ನಿಮನ್ತ್ರಿತಾನ್ ಆನೇತುಂ ದಾಸೇಯಾನ್ ಪ್ರಹಿತವಾನ್,</para>
  <para style="p">
    <verse number="3" style="v"/>ಕಿನ್ತು ತೇ ಸಮಾಗನ್ತುಂ ನೇಷ್ಟವನ್ತಃ|</para>
  <para style="p">
    <verse number="4" style="v"/>ತತೋ ರಾಜಾ ಪುನರಪಿ ದಾಸಾನನ್ಯಾನ್ ಇತ್ಯುಕ್ತ್ವಾ ಪ್ರೇಷಯಾಮಾಸ, ನಿಮನ್ತ್ರಿತಾನ್ ವದತ, ಪಶ್ಯತ, ಮಮ ಭೇಜ್ಯಮಾಸಾದಿತಮಾಸ್ತೇ, ನಿಜವ್ಟಷಾದಿಪುಷ್ಟಜನ್ತೂನ್ ಮಾರಯಿತ್ವಾ ಸರ್ವ್ವಂ ಖಾದ್ಯದ್ರವ್ಯಮಾಸಾದಿತವಾನ್, ಯೂಯಂ ವಿವಾಹಮಾಗಚ್ಛತ|</para>
  <para style="p">
    <verse number="5" style="v"/>ತಥಪಿ ತೇ ತುಚ್ಛೀಕೃತ್ಯ ಕೇಚಿತ್ ನಿಜಕ್ಷೇತ್ರಂ ಕೇಚಿದ್ ವಾಣಿಜ್ಯಂ ಪ್ರತಿ ಸ್ವಸ್ವಮಾರ್ಗೇಣ ಚಲಿತವನ್ತಃ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅನ್ಯೇ ಲೋಕಾಸ್ತಸ್ಯ ದಾಸೇಯಾನ್ ಧೃತ್ವಾ ದೌರಾತ್ಮ್ಯಂ ವ್ಯವಹೃತ್ಯ ತಾನವಧಿಷುಃ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅನನ್ತರಂ ಸ ನೃಪತಿಸ್ತಾಂ ವಾರ್ತ್ತಾಂ ಶ್ರುತ್ವಾ ಕ್ರುಧ್ಯನ್ ಸೈನ್ಯಾನಿ ಪ್ರಹಿತ್ಯ ತಾನ್ ಘಾತಕಾನ್ ಹತ್ವಾ ತೇಷಾಂ ನಗರಂ ದಾಹಯಾಮಾಸ|</para>
  <para style="p">
    <verse number="8" style="v"/>ತತಃ ಸ ನಿಜದಾಸೇಯಾನ್ ಬಭಾಷೇ, ವಿವಾಹೀಯಂ ಭೋಜ್ಯಮಾಸಾದಿತಮಾಸ್ತೇ, ಕಿನ್ತು ನಿಮನ್ತ್ರಿತಾ ಜನಾ ಅಯೋಗ್ಯಾಃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ತಸ್ಮಾದ್ ಯೂಯಂ ರಾಜಮಾರ್ಗಂ ಗತ್ವಾ ಯಾವತೋ ಮನುಜಾನ್ ಪಶ್ಯತ, ತಾವತಏವ ವಿವಾಹೀಯಭೋಜ್ಯಾಯ ನಿಮನ್ತ್ರಯತ|</para>
  <para style="p">
    <verse number="10" style="v"/>ತದಾ ತೇ ದಾಸೇಯಾ ರಾಜಮಾರ್ಗಂ ಗತ್ವಾ ಭದ್ರಾನ್ ಅಭದ್ರಾನ್ ವಾ ಯಾವತೋ ಜನಾನ್ ದದೃಶುಃ, ತಾವತಏವ ಸಂಗೃಹ್ಯಾನಯನ್; ತತೋಽಭ್ಯಾಗತಮನುಜೈ ರ್ವಿವಾಹಗೃಹಮ್ ಅಪೂರ್ಯ್ಯತ|</para>
  <para style="p">
    <verse number="11" style="v"/>ತದಾನೀಂ ಸ ರಾಜಾ ಸರ್ವ್ವಾನಭ್ಯಾಗತಾನ್ ದ್ರಷ್ಟುಮ್ ಅಭ್ಯನ್ತರಮಾಗತವಾನ್; ತದಾ ತತ್ರ ವಿವಾಹೀಯವಸನಹೀನಮೇಕಂ ಜನಂ ವೀಕ್ಷ್ಯ ತಂ ಜಗಾದ್,</para>
  <para style="p">
    <verse number="12" style="v"/>ಹೇ ಮಿತ್ರ,ತ್ವಂ ವಿವಾಹೀಯವಸನಂ ವಿನಾ ಕಥಮತ್ರ ಪ್ರವಿಷ್ಟವಾನ್? ತೇನ ಸ ನಿರುತ್ತರೋ ಬಭೂವ|</para>
  <para style="p">
    <verse number="13" style="v"/>ತದಾ ರಾಜಾ ನಿಜಾನುಚರಾನ್ ಅವದತ್, ಏತಸ್ಯ ಕರಚರಣಾನ್ ಬದ್ಧಾ ಯತ್ರ ರೋದನಂ ದನ್ತೈರ್ದನ್ತಘರ್ಷಣಞ್ಚ ಭವತಿ, ತತ್ರ ವಹಿರ್ಭೂತತಮಿಸ್ರೇ ತಂ ನಿಕ್ಷಿಪತ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಇತ್ಥಂ ಬಹವ ಆಹೂತಾ ಅಲ್ಪೇ ಮನೋಭಿಮತಾಃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅನನ್ತರಂ ಫಿರೂಶಿನಃ ಪ್ರಗತ್ಯ ಯಥಾ ಸಂಲಾಪೇನ ತಮ್ ಉನ್ಮಾಥೇ ಪಾತಯೇಯುಸ್ತಥಾ ಮನ್ತ್ರಯಿತ್ವಾ</para>
  <para style="p">
    <verse number="16" style="v"/>ಹೇರೋದೀಯಮನುಜೈಃ ಸಾಕಂ ನಿಜಶಿಷ್ಯಗಣೇನ ತಂ ಪ್ರತಿ ಕಥಯಾಮಾಸುಃ, ಹೇ ಗುರೋ, ಭವಾನ್ ಸತ್ಯಃ ಸತ್ಯಮೀಶ್ವರೀಯಮಾರ್ಗಮುಪದಿಶತಿ, ಕಮಪಿ ಮಾನುಷಂ ನಾನುರುಧ್ಯತೇ, ಕಮಪಿ ನಾಪೇಕ್ಷತೇ ಚ, ತದ್ ವಯಂ ಜಾನೀಮಃ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಅತಃ ಕೈಸರಭೂಪಾಯ ಕರೋಽಸ್ಮಾಕಂ ದಾತವ್ಯೋ ನ ವಾ? ಅತ್ರ ಭವತಾ ಕಿಂ ಬುಧ್ಯತೇ? ತದ್ ಅಸ್ಮಾನ್ ವದತು|</para>
  <para style="p">
    <verse number="18" style="v"/>ತತೋ ಯೀಶುಸ್ತೇಷಾಂ ಖಲತಾಂ ವಿಜ್ಞಾಯ ಕಥಿತವಾನ್, ರೇ ಕಪಟಿನಃ ಯುಯಂ ಕುತೋ ಮಾಂ ಪರಿಕ್ಷಧ್ವೇ?</para>
  <para style="p">
    <verse number="19" style="v"/>ತತ್ಕರದಾನಸ್ಯ ಮುದ್ರಾಂ ಮಾಂ ದರ್ಶಯತ| ತದಾನೀಂ ತೈಸ್ತಸ್ಯ ಸಮೀಪಂ ಮುದ್ರಾಚತುರ್ಥಭಾಗ ಆನೀತೇ</para>
  <para style="p">
    <verse number="20" style="v"/>ಸ ತಾನ್ ಪಪ್ರಚ್ಛ, ಅತ್ರ ಕಸ್ಯೇಯಂ ಮೂರ್ತ್ತಿ ರ್ನಾಮ ಚಾಸ್ತೇ? ತೇ ಜಗದುಃ, ಕೈಸರಭೂಪಸ್ಯ|</para>
  <para style="p">
    <verse number="21" style="v"/>ತತಃ ಸ ಉಕ್ತವಾನ, ಕೈಸರಸ್ಯ ಯತ್ ತತ್ ಕೈಸರಾಯ ದತ್ತ, ಈಶ್ವರಸ್ಯ ಯತ್ ತದ್ ಈಶ್ವರಾಯ ದತ್ತ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಇತಿ ವಾಕ್ಯಂ ನಿಶಮ್ಯ ತೇ ವಿಸ್ಮಯಂ ವಿಜ್ಞಾಯ ತಂ ವಿಹಾಯ ಚಲಿತವನ್ತಃ|</para>
  <para style="p">
    <verse number="23" style="v"/>ತಸ್ಮಿನ್ನಹನಿ ಸಿದೂಕಿನೋಽರ್ಥಾತ್ ಶ್ಮಶಾನಾತ್ ನೋತ್ಥಾಸ್ಯನ್ತೀತಿ ವಾಕ್ಯಂ ಯೇ ವದನ್ತಿ, ತೇ ಯೀಶೇाರನ್ತಿಕಮ್ ಆಗತ್ಯ ಪಪ್ರಚ್ಛುಃ,</para>
  <para style="p">
    <verse number="24" style="v"/>ಹೇ ಗುರೋ, ಕಶ್ಚಿನ್ಮನುಜಶ್ಚೇತ್ ನಿಃಸನ್ತಾನಃ ಸನ್ ಪ್ರಾಣಾನ್ ತ್ಯಜತಿ, ತರ್ಹಿ ತಸ್ಯ ಭ್ರಾತಾ ತಸ್ಯ ಜಾಯಾಂ ವ್ಯುಹ್ಯ ಭ್ರಾತುಃ ಸನ್ತಾನಮ್ ಉತ್ಪಾದಯಿಷ್ಯತೀತಿ ಮೂಸಾ ಆದಿಷ್ಟವಾನ್|</para>
  <para style="p">
    <verse number="25" style="v"/>ಕಿನ್ತ್ವಸ್ಮಾಕಮತ್ರ ಕೇಽಪಿ ಜನಾಃ ಸಪ್ತಸಹೋದರಾ ಆಸನ್, ತೇಷಾಂ ಜ್ಯೇಷ್ಠ ಏಕಾಂ ಕನ್ಯಾಂ ವ್ಯವಹಾತ್, ಅಪರಂ ಪ್ರಾಣತ್ಯಾಗಕಾಲೇ ಸ್ವಯಂ ನಿಃಸನ್ತಾನಃ ಸನ್ ತಾಂ ಸ್ತ್ರಿಯಂ ಸ್ವಭ್ರಾತರಿ ಸಮರ್ಪಿತವಾನ್,</para>
  <para style="p">
    <verse number="26" style="v"/>ತತೋ ದ್ವಿತೀಯಾದಿಸಪ್ತಮಾನ್ತಾಶ್ಚ ತಥೈವ ಚಕ್ರುಃ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಶೇಷೇ ಸಾಪೀ ನಾರೀ ಮಮಾರ|</para>
  <para style="p">
    <verse number="28" style="v"/>ಮೃತಾನಾಮ್ ಉತ್ಥಾನಸಮಯೇ ತೇಷಾಂ ಸಪ್ತಾನಾಂ ಮಧ್ಯೇ ಸಾ ನಾರೀ ಕಸ್ಯ ಭಾರ್ಯ್ಯಾ ಭವಿಷ್ಯತಿ? ಯಸ್ಮಾತ್ ಸರ್ವ್ವಏವ ತಾಂ ವ್ಯವಹನ್|</para>
  <para style="p">
    <verse number="29" style="v"/>ತತೋ ಯೀಶುಃ ಪ್ರತ್ಯವಾದೀತ್, ಯೂಯಂ ಧರ್ಮ್ಮಪುಸ್ತಕಮ್ ಈಶ್ವರೀಯಾಂ ಶಕ್ತಿಞ್ಚ ನ ವಿಜ್ಞಾಯ ಭ್ರಾನ್ತಿಮನ್ತಃ|</para>
  <para style="p">
    <verse number="30" style="v"/>ಉತ್ಥಾನಪ್ರಾಪ್ತಾ ಲೋಕಾ ನ ವಿವಹನ್ತಿ, ನ ಚ ವಾಚಾ ದೀಯನ್ತೇ, ಕಿನ್ತ್ವೀಶ್ವರಸ್ಯ ಸ್ವರ್ಗಸ್ಥದೂತಾನಾಂ ಸದೃಶಾ ಭವನ್ತಿ|</para>
  <para style="p">
    <verse number="31" style="v"/>ಅಪರಂ ಮೃತಾನಾಮುತ್ಥಾನಮಧಿ ಯುಷ್ಮಾನ್ ಪ್ರತೀಯಮೀಶ್ವರೋಕ್ತಿಃ,</para>
  <para style="p">
    <verse number="32" style="v"/>"ಅಹಮಿಬ್ರಾಹೀಮ ಈಶ್ವರ ಇಸ್ಹಾಕ ಈಶ್ವರೋ ಯಾಕೂಬ ಈಶ್ವರ" ಇತಿ ಕಿಂ ಯುಷ್ಮಾಭಿ ರ್ನಾಪಾಠಿ? ಕಿನ್ತ್ವೀಶ್ವರೋ ಜೀವತಾಮ್ ಈಶ್ವರ:, ಸ ಮೃತಾನಾಮೀಶ್ವರೋ ನಹಿ|</para>
  <para style="p">
    <verse number="33" style="v"/>ಇತಿ ಶ್ರುತ್ವಾ ಸರ್ವ್ವೇ ಲೋಕಾಸ್ತಸ್ಯೋಪದೇಶಾದ್ ವಿಸ್ಮಯಂ ಗತಾಃ|</para>
  <para style="p">
    <verse number="34" style="v"/>ಅನನ್ತರಂ ಸಿದೂಕಿನಾಮ್ ನಿರುತ್ತರತ್ವವಾರ್ತಾಂ ನಿಶಮ್ಯ ಫಿರೂಶಿನ ಏಕತ್ರ ಮಿಲಿತವನ್ತಃ,</para>
  <para style="p">
    <verse number="35" style="v"/>ತೇಷಾಮೇಕೋ ವ್ಯವಸ್ಥಾಪಕೋ ಯೀಶುಂ ಪರೀಕ್ಷಿತುಂ ಪಪಚ್ಛ,</para>
  <para style="p">
    <verse number="36" style="v"/>ಹೇ ಗುರೋ ವ್ಯವಸ್ಥಾಶಾಸ್ತ್ರಮಧ್ಯೇ ಕಾಜ್ಞಾ ಶ್ರೇಷ್ಠಾ?</para>
  <para style="p">
    <verse number="37" style="v"/>ತತೋ ಯೀಶುರುವಾಚ, ತ್ವಂ ಸರ್ವ್ವಾನ್ತಃಕರಣೈಃ ಸರ್ವ್ವಪ್ರಾಣೈಃ ಸರ್ವ್ವಚಿತ್ತೈಶ್ಚ ಸಾಕಂ ಪ್ರಭೌ ಪರಮೇಶ್ವರೇ ಪ್ರೀಯಸ್ವ,</para>
  <para style="p">
    <verse number="38" style="v"/>ಏಷಾ ಪ್ರಥಮಮಹಾಜ್ಞಾ| ತಸ್ಯಾಃ ಸದೃಶೀ ದ್ವಿತೀಯಾಜ್ಞೈಷಾ,</para>
  <para style="p">
    <verse number="39" style="v"/>ತವ ಸಮೀಪವಾಸಿನಿ ಸ್ವಾತ್ಮನೀವ ಪ್ರೇಮ ಕುರು|</para>
  <para style="p">
    <verse number="40" style="v"/>ಅನಯೋ ರ್ದ್ವಯೋರಾಜ್ಞಯೋಃ ಕೃತ್ಸ್ನವ್ಯವಸ್ಥಾಯಾ ಭವಿಷ್ಯದ್ವಕ್ತೃಗ್ರನ್ಥಸ್ಯ ಚ ಭಾರಸ್ತಿಷ್ಠತಿ|</para>
  <para style="p">
    <verse number="41" style="v"/>ಅನನ್ತರಂ ಫಿರೂಶಿನಾಮ್ ಏಕತ್ರ ಸ್ಥಿತಿಕಾಲೇ ಯೀಶುಸ್ತಾನ್ ಪಪ್ರಚ್ಛ,</para>
  <para style="p">
    <verse number="42" style="v"/>ಖ್ರೀಷ್ಟಮಧಿ ಯುಷ್ಮಾಕಂ ಕೀದೃಗ್ಬೋಧೋ ಜಾಯತೇ? ಸ ಕಸ್ಯ ಸನ್ತಾನಃ? ತತಸ್ತೇ ಪ್ರತ್ಯವದನ್, ದಾಯೂದಃ ಸನ್ತಾನಃ|</para>
  <para style="p">
    <verse number="43" style="v"/>ತದಾ ಸ ಉಕ್ತವಾನ್, ತರ್ಹಿ ದಾಯೂದ್ ಕಥಮ್ ಆತ್ಮಾಧಿಷ್ಠಾನೇನ ತಂ ಪ್ರಭುಂ ವದತಿ ?</para>
  <para style="p">
    <verse number="44" style="v"/>ಯಥಾ ಮಮ ಪ್ರಭುಮಿದಂ ವಾಕ್ಯಮವದತ್ ಪರಮೇಶ್ವರಃ| ತವಾರೀನ್ ಪಾದಪೀಠಂ ತೇ ಯಾವನ್ನಹಿ ಕರೋಮ್ಯಹಂ| ತಾವತ್ ಕಾಲಂ ಮದೀಯೇ ತ್ವಂ ದಕ್ಷಪಾರ್ಶ್ವ ಉಪಾವಿಶ| ಅತೋ ಯದಿ ದಾಯೂದ್ ತಂ ಪ್ರಭುಂ ವದತಿ, ರ್ತಿಹ ಸ ಕಥಂ ತಸ್ಯ ಸನ್ತಾನೋ ಭವತಿ?</para>
  <para style="p">
    <verse number="45" style="v"/>ತದಾನೀಂ ತೇಷಾಂ ಕೋಪಿ ತದ್ವಾಕ್ಯಸ್ಯ ಕಿಮಪ್ಯುತ್ತರಂ ದಾತುಂ ನಾಶಕ್ನೋತ್;</para>
  <para style="p">
    <verse number="46" style="v"/>ತದ್ದಿನಮಾರಭ್ಯ ತಂ ಕಿಮಪಿ ವಾಕ್ಯಂ ಪ್ರಷ್ಟುಂ ಕಸ್ಯಾಪಿ ಸಾಹಸೋ ನಾಭವತ್|</para>
  <chapter number="23" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅನನ್ತರಂ ಯೀಶು ರ್ಜನನಿವಹಂ ಶಿಷ್ಯಾಂಶ್ಚಾವದತ್,</para>
  <para style="p">
    <verse number="2" style="v"/>ಅಧ್ಯಾಪಕಾಃ ಫಿರೂಶಿನಶ್ಚ ಮೂಸಾಸನೇ ಉಪವಿಶನ್ತಿ,</para>
  <para style="p">
    <verse number="3" style="v"/>ಅತಸ್ತೇ ಯುಷ್ಮಾನ್ ಯದ್ಯತ್ ಮನ್ತುಮ್ ಆಜ್ಞಾಪಯನ್ತಿ, ತತ್ ಮನ್ಯಧ್ವಂ ಪಾಲಯಧ್ವಞ್ಚ, ಕಿನ್ತು ತೇಷಾಂ ಕರ್ಮ್ಮಾನುರೂಪಂ ಕರ್ಮ್ಮ ನ ಕುರುಧ್ವಂ; ಯತಸ್ತೇಷಾಂ ವಾಕ್ಯಮಾತ್ರಂ ಸಾರಂ ಕಾರ್ಯ್ಯೇ ಕಿಮಪಿ ನಾಸ್ತಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ತೇ ದುರ್ವ್ವಹಾನ್ ಗುರುತರಾನ್ ಭಾರಾನ್ ಬದ್ವ್ವಾ ಮನುಷ್ಯಾಣಾಂ ಸ್ಕನ್ಧೇಪರಿ ಸಮರ್ಪಯನ್ತಿ, ಕಿನ್ತು ಸ್ವಯಮಙ್ಗುಲ್ಯೈಕಯಾಪಿ ನ ಚಾಲಯನ್ತಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಕೇವಲಂ ಲೋಕದರ್ಶನಾಯ ಸರ್ವ್ವಕರ್ಮ್ಮಾಣಿ ಕುರ್ವ್ವನ್ತಿ; ಫಲತಃ ಪಟ್ಟಬನ್ಧಾನ್ ಪ್ರಸಾರ್ಯ್ಯ ಧಾರಯನ್ತಿ, ಸ್ವವಸ್ತ್ರೇಷು ಚ ದೀರ್ಘಗ್ರನ್ಥೀನ್ ಧಾರಯನ್ತಿ;</para>
  <para style="p">
    <verse number="6" style="v"/>ಭೋಜನಭವನ ಉಚ್ಚಸ್ಥಾನಂ, ಭಜನಭವನೇ ಪ್ರಧಾನಮಾಸನಂ,</para>
  <para style="p">
    <verse number="7" style="v"/>ಹಟ್ಠೇ ನಮಸ್ಕಾರಂ ಗುರುರಿತಿ ಸಮ್ಬೋಧನಞ್ಚೈತಾನಿ ಸರ್ವ್ವಾಣಿ ವಾಞ್ಛನ್ತಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಕಿನ್ತು ಯೂಯಂ ಗುರವ ಇತಿ ಸಮ್ಬೋಧನೀಯಾ ಮಾ ಭವತ, ಯತೋ ಯುಷ್ಮಾಕಮ್ ಏಕಃ ಖ್ರೀಷ್ಟಏವ ಗುರು</para>
  <para style="p">
    <verse number="9" style="v"/>ರ್ಯೂಯಂ ಸರ್ವ್ವೇ ಮಿಥೋ ಭ್ರಾತರಶ್ಚ| ಪುನಃ ಪೃಥಿವ್ಯಾಂ ಕಮಪಿ ಪಿತೇತಿ ಮಾ ಸಮ್ಬುಧ್ಯಧ್ವಂ, ಯತೋ ಯುಷ್ಮಾಕಮೇಕಃ ಸ್ವರ್ಗಸ್ಥಏವ ಪಿತಾ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯೂಯಂ ನಾಯಕೇತಿ ಸಮ್ಭಾಷಿತಾ ಮಾ ಭವತ, ಯತೋ ಯುಷ್ಮಾಕಮೇಕಃ ಖ್ರೀಷ್ಟಏವ ನಾಯಕಃ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅಪರಂ ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ಯಃ ಪುಮಾನ್ ಶ್ರೇಷ್ಠಃ ಸ ಯುಷ್ಮಾನ್ ಸೇವಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯತೋ ಯಃ ಸ್ವಮುನ್ನಮತಿ, ಸ ನತಃ ಕರಿಷ್ಯತೇ; ಕಿನ್ತು ಯಃ ಕಶ್ಚಿತ್ ಸ್ವಮವನತಂ ಕರೋತಿ, ಸ ಉನ್ನತಃ ಕರಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಹನ್ತ ಕಪಟಿನ ಉಪಾಧ್ಯಾಯಾಃ ಫಿರೂಶಿನಶ್ಚ, ಯೂಯಂ ಮನುಜಾನಾಂ ಸಮಕ್ಷಂ ಸ್ವರ್ಗದ್ವಾರಂ ರುನ್ಧ, ಯೂಯಂ ಸ್ವಯಂ ತೇನ ನ ಪ್ರವಿಶಥ, ಪ್ರವಿವಿಕ್ಷೂನಪಿ ವಾರಯಥ| ವತ ಕಪಟಿನ ಉಪಾಧ್ಯಾಯಾಃ ಫಿರೂಶಿನಶ್ಚ ಯೂಯಂ ಛಲಾದ್ ದೀರ್ಘಂ ಪ್ರಾರ್ಥ್ಯ ವಿಧವಾನಾಂ ಸರ್ವ್ವಸ್ವಂ ಗ್ರಸಥ, ಯುಷ್ಮಾಕಂ ಘೋರತರದಣ್ಡೋ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಹನ್ತ ಕಪಟಿನ ಉಪಾಧ್ಯಾಯಾಃ ಫಿರೂಶಿನಶ್ಚ, ಯೂಯಮೇಕಂ ಸ್ವಧರ್ಮ್ಮಾವಲಮ್ಬಿನಂ ಕರ್ತ್ತುಂ ಸಾಗರಂ ಭೂಮಣ್ಡಲಞ್ಚ ಪ್ರದಕ್ಷಿಣೀಕುರುಥ,</para>
  <para style="p">
    <verse number="15" style="v"/>ಕಞ್ಚನ ಪ್ರಾಪ್ಯ ಸ್ವತೋ ದ್ವಿಗುಣನರಕಭಾಜನಂ ತಂ ಕುರುಥ|</para>
  <para style="p">
    <verse number="16" style="v"/>ವತ ಅನ್ಧಪಥದರ್ಶಕಾಃ ಸರ್ವ್ವೇ, ಯೂಯಂ ವದಥ, ಮನ್ದಿರಸ್ಯ ಶಪಥಕರಣಾತ್ ಕಿಮಪಿ ನ ದೇಯಂ; ಕಿನ್ತು ಮನ್ದಿರಸ್ಥಸುವರ್ಣಸ್ಯ ಶಪಥಕರಣಾದ್ ದೇಯಂ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಹೇ ಮೂಢಾ ಹೇ ಅನ್ಧಾಃ ಸುವರ್ಣಂ ತತ್ಸುವರ್ಣಪಾವಕಮನ್ದಿರಮ್ ಏತಯೋರುಭಯೋ ರ್ಮಧ್ಯೇ ಕಿಂ ಶ್ರೇಯಃ?</para>
  <para style="p">
    <verse number="18" style="v"/>ಅನ್ಯಚ್ಚ ವದಥ, ಯಜ್ಞವೇದ್ಯಾಃ ಶಪಥಕರಣಾತ್ ಕಿಮಪಿ ನ ದೇಯಂ, ಕಿನ್ತು ತದುಪರಿಸ್ಥಿತಸ್ಯ ನೈವೇದ್ಯಸ್ಯ ಶಪಥಕರಣಾದ್ ದೇಯಂ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಹೇ ಮೂಢಾ ಹೇ ಅನ್ಧಾಃ, ನೈವೇದ್ಯಂ ತನ್ನೈವೇದ್ಯಪಾವಕವೇದಿರೇತಯೋರುಭಯೋ ರ್ಮಧ್ಯೇ ಕಿಂ ಶ್ರೇಯಃ?</para>
  <para style="p">
    <verse number="20" style="v"/>ಅತಃ ಕೇನಚಿದ್ ಯಜ್ಞವೇದ್ಯಾಃ ಶಪಥೇ ಕೃತೇ ತದುಪರಿಸ್ಥಸ್ಯ ಸರ್ವ್ವಸ್ಯ ಶಪಥಃ ಕ್ರಿಯತೇ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಕೇನಚಿತ್ ಮನ್ದಿರಸ್ಯ ಶಪಥೇ ಕೃತೇ ಮನ್ದಿರತನ್ನಿವಾಸಿನೋಃ ಶಪಥಃ ಕ್ರಿಯತೇ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಕೇನಚಿತ್ ಸ್ವರ್ಗಸ್ಯ ಶಪಥೇ ಕೃತೇ ಈಶ್ವರೀಯಸಿಂಹಾಸನತದುಪರ್ಯ್ಯುಪವಿಷ್ಟಯೋಃ ಶಪಥಃ ಕ್ರಿಯತೇ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಹನ್ತ ಕಪಟಿನ ಉಪಾಧ್ಯಾಯಾಃ ಫಿರೂಶಿನಶ್ಚ, ಯೂಯಂ ಪೋದಿನಾಯಾಃ ಸಿತಚ್ಛತ್ರಾಯಾ ಜೀರಕಸ್ಯ ಚ ದಶಮಾಂಶಾನ್ ದತ್ಥ, ಕಿನ್ತು ವ್ಯವಸ್ಥಾಯಾ ಗುರುತರಾನ್ ನ್ಯಾಯದಯಾವಿಶ್ವಾಸಾನ್ ಪರಿತ್ಯಜಥ; ಇಮೇ ಯುಷ್ಮಾಭಿರಾಚರಣೀಯಾ ಅಮೀ ಚ ನ ಲಂಘನೀಯಾಃ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಹೇ ಅನ್ಧಪಥದರ್ಶಕಾ ಯೂಯಂ ಮಶಕಾನ್ ಅಪಸಾರಯಥ, ಕಿನ್ತು ಮಹಾಙ್ಗಾನ್ ಗ್ರಸಥ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಹನ್ತ ಕಪಟಿನ ಉಪಾಧ್ಯಾಯಾಃ ಫಿರೂಶಿನಶ್ಚ, ಯೂಯಂ ಪಾನಪಾತ್ರಾಣಾಂ ಭೋಜನಪಾತ್ರಾಣಾಞ್ಚ ಬಹಿಃ ಪರಿಷ್ಕುರುಥ; ಕಿನ್ತು ತದಭ್ಯನ್ತರಂ ದುರಾತ್ಮತಯಾ ಕಲುಷೇಣ ಚ ಪರಿಪೂರ್ಣಮಾಸ್ತೇ|</para>
  <para style="p">
    <verse number="26" style="v"/>ಹೇ ಅನ್ಧಾಃ ಫಿರೂಶಿಲೋಕಾ ಆದೌ ಪಾನಪಾತ್ರಾಣಾಂ ಭೋಜನಪಾತ್ರಾಣಾಞ್ಚಾಭ್ಯನ್ತರಂ ಪರಿಷ್ಕುರುತ, ತೇನ ತೇಷಾಂ ಬಹಿರಪಿ ಪರಿಷ್ಕಾರಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಹನ್ತ ಕಪಟಿನ ಉಪಾಧ್ಯಾಯಾಃ ಫಿರೂಶಿನಶ್ಚ, ಯೂಯಂ ಶುಕ್ಲೀಕೃತಶ್ಮಶಾನಸ್ವರೂಪಾ ಭವಥ, ಯಥಾ ಶ್ಮಶಾನಭವನಸ್ಯ ಬಹಿಶ್ಚಾರು, ಕಿನ್ತ್ವಭ್ಯನ್ತರಂ ಮೃತಲೋಕಾನಾಂ ಕೀಕಶೈಃ ಸರ್ವ್ವಪ್ರಕಾರಮಲೇನ ಚ ಪರಿಪೂರ್ಣಮ್;</para>
  <para style="p">
    <verse number="28" style="v"/>ತಥೈವ ಯೂಯಮಪಿ ಲೋಕಾನಾಂ ಸಮಕ್ಷಂ ಬಹಿರ್ಧಾರ್ಮ್ಮಿಕಾಃ ಕಿನ್ತ್ವನ್ತಃಕರಣೇಷು ಕೇವಲಕಾಪಟ್ಯಾಧರ್ಮ್ಮಾಭ್ಯಾಂ ಪರಿಪೂರ್ಣಾಃ|</para>
  <para style="p">
    <verse number="29" style="v"/>ಹಾ ಹಾ ಕಪಟಿನ ಉಪಾಧ್ಯಾಯಾಃ ಫಿರೂಶಿನಶ್ಚ, ಯೂಯಂ ಭವಿಷ್ಯದ್ವಾದಿನಾಂ ಶ್ಮಶಾನಗೇಹಂ ನಿರ್ಮ್ಮಾಥ, ಸಾಧೂನಾಂ ಶ್ಮಶಾನನಿಕೇತನಂ ಶೋಭಯಥ</para>
  <para style="p">
    <verse number="30" style="v"/>ವದಥ ಚ ಯದಿ ವಯಂ ಸ್ವೇಷಾಂ ಪೂರ್ವ್ವಪುರುಷಾಣಾಂ ಕಾಲ ಅಸ್ಥಾಸ್ಯಾಮ, ತರ್ಹಿ ಭವಿಷ್ಯದ್ವಾದಿನಾಂ ಶೋಣಿತಪಾತನೇ ತೇಷಾಂ ಸಹಭಾಗಿನೋ ನಾಭವಿಷ್ಯಾಮ|</para>
  <para style="p">
    <verse number="31" style="v"/>ಅತೋ ಯೂಯಂ ಭವಿಷ್ಯದ್ವಾದಿಘಾತಕಾನಾಂ ಸನ್ತಾನಾ ಇತಿ ಸ್ವಯಮೇವ ಸ್ವೇಷಾಂ ಸಾಕ್ಷ್ಯಂ ದತ್ಥ|</para>
  <para style="p">
    <verse number="32" style="v"/>ಅತೋ ಯೂಯಂ ನಿಜಪೂರ್ವ್ವಪುರುಷಾಣಾಂ ಪರಿಮಾಣಪಾತ್ರಂ ಪರಿಪೂರಯತ|</para>
  <para style="p">
    <verse number="33" style="v"/>ರೇ ಭುಜಗಾಃ ಕೃಷ್ಣಭುಜಗವಂಶಾಃ, ಯೂಯಂ ಕಥಂ ನರಕದಣ್ಡಾದ್ ರಕ್ಷಿಷ್ಯಧ್ವೇ|</para>
  <para style="p">
    <verse number="34" style="v"/>ಪಶ್ಯತ, ಯುಷ್ಮಾಕಮನ್ತಿಕಮ್ ಅಹಂ ಭವಿಷ್ಯದ್ವಾದಿನೋ ಬುದ್ಧಿಮತ ಉಪಾಧ್ಯಾಯಾಂಶ್ಚ ಪ್ರೇಷಯಿಷ್ಯಾಮಿ, ಕಿನ್ತು ತೇಷಾಂ ಕತಿಪಯಾ ಯುಷ್ಮಾಭಿ ರ್ಘಾನಿಷ್ಯನ್ತೇ, ಕ್ರುಶೇ ಚ ಘಾನಿಷ್ಯನ್ತೇ, ಕೇಚಿದ್ ಭಜನಭವನೇ ಕಷಾಭಿರಾಘಾನಿಷ್ಯನ್ತೇ, ನಗರೇ ನಗರೇ ತಾಡಿಷ್ಯನ್ತೇ ಚ;</para>
  <para style="p">
    <verse number="35" style="v"/>ತೇನ ಸತ್ಪುರುಷಸ್ಯ ಹಾಬಿಲೋ ರಕ್ತಪಾತಮಾರಭ್ಯ ಬೇರಿಖಿಯಃ ಪುತ್ರಂ ಯಂ ಸಿಖರಿಯಂ ಯೂಯಂ ಮನ್ದಿರಯಜ್ಞವೇದ್ಯೋ ರ್ಮಧ್ಯೇ ಹತವನ್ತಃ, ತದೀಯಶೋಣಿತಪಾತಂ ಯಾವದ್ ಅಸ್ಮಿನ್ ದೇಶೇ ಯಾವತಾಂ ಸಾಧುಪುರುಷಾಣಾಂ ಶೋಣಿತಪಾತೋ ಽಭವತ್ ತತ್ ಸರ್ವ್ವೇಷಾಮಾಗಸಾಂ ದಣ್ಡಾ ಯುಷ್ಮಾಸು ವರ್ತ್ತಿಷ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="36" style="v"/>ಅಹಂ ಯುಷ್ಮಾನ್ತ ತಥ್ಯಂ ವದಾಮಿ, ವಿದ್ಯಮಾನೇಽಸ್ಮಿನ್ ಪುರುಷೇ ಸರ್ವ್ವೇ ವರ್ತ್ತಿಷ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="37" style="v"/>ಹೇ ಯಿರೂಶಾಲಮ್ ಹೇ ಯಿರೂಶಾಲಮ್ ನಗರಿ ತ್ವಂ ಭವಿಷ್ಯದ್ವಾದಿನೋ ಹತವತೀ, ತವ ಸಮೀಪಂ ಪ್ರೇರಿತಾಂಶ್ಚ ಪಾಷಾಣೈರಾಹತವತೀ, ಯಥಾ ಕುಕ್ಕುಟೀ ಶಾವಕಾನ್ ಪಕ್ಷಾಧಃ ಸಂಗೃಹ್ಲಾತಿ, ತಥಾ ತವ ಸನ್ತಾನಾನ್ ಸಂಗ್ರಹೀತುಂ ಅಹಂ ಬಹುವಾರಮ್ ಐಚ್ಛಂ; ಕಿನ್ತು ತ್ವಂ ನ ಸಮಮನ್ಯಥಾಃ|</para>
  <para style="p">
    <verse number="38" style="v"/>ಪಶ್ಯತ ಯಷ್ಮಾಕಂ ವಾಸಸ್ಥಾನಮ್ ಉಚ್ಛಿನ್ನಂ ತ್ಯಕ್ಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="39" style="v"/>ಅಹಂ ಯುಷ್ಮಾನ್ ತಥ್ಯಂ ವದಾಮಿ, ಯಃ ಪರಮೇಶ್ವರಸ್ಯ ನಾಮ್ನಾಗಚ್ಛತಿ, ಸ ಧನ್ಯ ಇತಿ ವಾಣೀಂ ಯಾವನ್ನ ವದಿಷ್ಯಥ, ತಾವತ್ ಮಾಂ ಪುನ ರ್ನ ದ್ರಕ್ಷ್ಯಥ|</para>
  <chapter number="24" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅನನ್ತರಂ ಯೀಶು ರ್ಯದಾ ಮನ್ದಿರಾದ್ ಬಹಿ ರ್ಗಚ್ಛತಿ, ತದಾನೀಂ ಶಿಷ್ಯಾಸ್ತಂ ಮನ್ದಿರನಿರ್ಮ್ಮಾಣಂ ದರ್ಶಯಿತುಮಾಗತಾಃ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತತೋ ಯೀಶುಸ್ತಾನುವಾಚ, ಯೂಯಂ ಕಿಮೇತಾನಿ ನ ಪಶ್ಯಥ? ಯುಷ್ಮಾನಹಂ ಸತ್ಯಂ ವದಾಮಿ, ಏತನ್ನಿಚಯನಸ್ಯ ಪಾಷಾಣೈಕಮಪ್ಯನ್ಯಪಾಷಾಣೇाಪರಿ ನ ಸ್ಥಾಸ್ಯತಿ ಸರ್ವ್ವಾಣಿ ಭೂಮಿಸಾತ್ ಕಾರಿಷ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅನನ್ತರಂ ತಸ್ಮಿನ್ ಜೈತುನಪರ್ವ್ವತೋಪರಿ ಸಮುಪವಿಷ್ಟೇ ಶಿಷ್ಯಾಸ್ತಸ್ಯ ಸಮೀಪಮಾಗತ್ಯ ಗುಪ್ತಂ ಪಪ್ರಚ್ಛುಃ, ಏತಾ ಘಟನಾಃ ಕದಾ ಭವಿಷ್ಯನ್ತಿ? ಭವತ ಆಗಮನಸ್ಯ ಯುಗಾನ್ತಸ್ಯ ಚ ಕಿಂ ಲಕ್ಷ್ಮ? ತದಸ್ಮಾನ್ ವದತು|</para>
  <para style="p">
    <verse number="4" style="v"/>ತದಾನೀಂ ಯೀಶುಸ್ತಾನವೋಚತ್, ಅವಧದ್ವ್ವಂ, ಕೋಪಿ ಯುಷ್ಮಾನ್ ನ ಭ್ರಮಯೇತ್|</para>
  <para style="p">
    <verse number="5" style="v"/>ಬಹವೋ ಮಮ ನಾಮ ಗೃಹ್ಲನ್ತ ಆಗಮಿಷ್ಯನ್ತಿ, ಖ್ರೀಷ್ಟೋಽಹಮೇವೇತಿ ವಾಚಂ ವದನ್ತೋ ಬಹೂನ್ ಭ್ರಮಯಿಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಯೂಯಞ್ಚ ಸಂಗ್ರಾಮಸ್ಯ ರಣಸ್ಯ ಚಾಡಮ್ಬರಂ ಶ್ರೋಷ್ಯಥ, ಅವಧದ್ವ್ವಂ ತೇನ ಚಞ್ಚಲಾ ಮಾ ಭವತ, ಏತಾನ್ಯವಶ್ಯಂ ಘಟಿಷ್ಯನ್ತೇ, ಕಿನ್ತು ತದಾ ಯುಗಾನ್ತೋ ನಹಿ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅಪರಂ ದೇಶಸ್ಯ ವಿಪಕ್ಷೋ ದೇಶೋ ರಾಜ್ಯಸ್ಯ ವಿಪಕ್ಷೋ ರಾಜ್ಯಂ ಭವಿಷ್ಯತಿ, ಸ್ಥಾನೇ ಸ್ಥಾನೇ ಚ ದುರ್ಭಿಕ್ಷಂ ಮಹಾಮಾರೀ ಭೂಕಮ್ಪಶ್ಚ ಭವಿಷ್ಯನ್ತಿ,</para>
  <para style="p">
    <verse number="8" style="v"/>ಏತಾನಿ ದುಃಖೋಪಕ್ರಮಾಃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ತದಾನೀಂ ಲೋಕಾ ದುಃಖಂ ಭೋಜಯಿತುಂ ಯುಷ್ಮಾನ್ ಪರಕರೇಷು ಸಮರ್ಪಯಿಷ್ಯನ್ತಿ ಹನಿಷ್ಯನ್ತಿ ಚ, ತಥಾ ಮಮ ನಾಮಕಾರಣಾದ್ ಯೂಯಂ ಸರ್ವ್ವದೇಶೀಯಮನುಜಾನಾಂ ಸಮೀಪೇ ಘೃಣಾರ್ಹಾ ಭವಿಷ್ಯಥ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಬಹುಷು ವಿಘ್ನಂ ಪ್ರಾಪ್ತವತ್ಸು ಪರಸ್ಪರಮ್ ಋृತೀಯಾಂ ಕೃತವತ್ಸು ಚ ಏಕೋಽಪರಂ ಪರಕರೇಷು ಸಮರ್ಪಯಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="11" style="v"/>ತಥಾ ಬಹವೋ ಮೃಷಾಭವಿಷ್ಯದ್ವಾದಿನ ಉಪಸ್ಥಾಯ ಬಹೂನ್ ಭ್ರಮಯಿಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ದುಷ್ಕರ್ಮ್ಮಣಾಂ ಬಾಹುಲ್ಯಾಞ್ಚ ಬಹೂನಾಂ ಪ್ರೇಮ ಶೀತಲಂ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಕಿನ್ತು ಯಃ ಕಶ್ಚಿತ್ ಶೇಷಂ ಯಾವದ್ ಧೈರ್ಯ್ಯಮಾಶ್ರಯತೇ, ಸಏವ ಪರಿತ್ರಾಯಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಅಪರಂ ಸರ್ವ್ವದೇಶೀಯಲೋಕಾನ್ ಪ್ರತಿಮಾಕ್ಷೀ ಭವಿತುಂ ರಾಜಸ್ಯ ಶುಭಸಮಾಚಾರಃ ಸರ್ವ್ವಜಗತಿ ಪ್ರಚಾರಿಷ್ಯತೇ, ಏತಾದೃಶಿ ಸತಿ ಯುಗಾನ್ತ ಉಪಸ್ಥಾಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅತೋ ಯತ್ ಸರ್ವ್ವನಾಶಕೃದ್ಘೃಣಾರ್ಹಂ ವಸ್ತು ದಾನಿಯೇಲ್ಭವಿಷ್ಯದ್ವದಿನಾ ಪ್ರೋಕ್ತಂ ತದ್ ಯದಾ ಪುಣ್ಯಸ್ಥಾನೇ ಸ್ಥಾಪಿತಂ ದ್ರಕ್ಷ್ಯಥ, (ಯಃ ಪಠತಿ, ಸ ಬುಧ್ಯತಾಂ)</para>
  <para style="p">
    <verse number="16" style="v"/>ತದಾನೀಂ ಯೇ ಯಿಹೂದೀಯದೇಶೇ ತಿಷ್ಠನ್ತಿ, ತೇ ಪರ್ವ್ವತೇಷು ಪಲಾಯನ್ತಾಂ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಯಃ ಕಶ್ಚಿದ್ ಗೃಹಪೃಷ್ಠೇ ತಿಷ್ಠತಿ, ಸ ಗೃಹಾತ್ ಕಿಮಪಿ ವಸ್ತ್ವಾನೇತುಮ್ ಅಧೇा ನಾವರೋಹೇತ್|</para>
  <para style="p">
    <verse number="18" style="v"/>ಯಶ್ಚ ಕ್ಷೇತ್ರೇ ತಿಷ್ಠತಿ, ಸೋಪಿ ವಸ್ತ್ರಮಾನೇತುಂ ಪರಾವೃತ್ಯ ನ ಯಾಯಾತ್|</para>
  <para style="p">
    <verse number="19" style="v"/>ತದಾನೀಂ ಗರ್ಭಿಣೀಸ್ತನ್ಯಪಾಯಯಿತ್ರೀಣಾಂ ದುರ್ಗತಿ ರ್ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಅತೋ ಯಷ್ಮಾಕಂ ಪಲಾಯನಂ ಶೀತಕಾಲೇ ವಿಶ್ರಾಮವಾರೇ ವಾ ಯನ್ನ ಭವೇತ್, ತದರ್ಥಂ ಪ್ರಾರ್ಥಯಧ್ವಮ್|</para>
  <para style="p">
    <verse number="21" style="v"/>ಆ ಜಗದಾರಮ್ಭಾದ್ ಏತತ್ಕಾಲಪರ್ಯ್ಯನನ್ತಂ ಯಾದೃಶಃ ಕದಾಪಿ ನಾಭವತ್ ನ ಚ ಭವಿಷ್ಯತಿ ತಾದೃಶೋ ಮಹಾಕ್ಲೇಶಸ್ತದಾನೀಮ್ ಉಪಸ್ಥಾಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="22" style="v"/>ತಸ್ಯ ಕ್ಲೇಶಸ್ಯ ಸಮಯೋ ಯದಿ ಹ್ಸ್ವೋ ನ ಕ್ರಿಯೇತ, ತರ್ಹಿ ಕಸ್ಯಾಪಿ ಪ್ರಾಣಿನೋ ರಕ್ಷಣಂ ಭವಿತುಂ ನ ಶಕ್ನುಯಾತ್, ಕಿನ್ತು ಮನೋನೀತಮನುಜಾನಾಂ ಕೃತೇ ಸ ಕಾಲೋ ಹ್ಸ್ವೀಕರಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಅಪರಞ್ಚ ಪಶ್ಯತ, ಖ್ರೀಷ್ಟೋಽತ್ರ ವಿದ್ಯತೇ, ವಾ ತತ್ರ ವಿದ್ಯತೇ, ತದಾನೀಂ ಯದೀ ಕಶ್ಚಿದ್ ಯುಷ್ಮಾನ ಇತಿ ವಾಕ್ಯಂ ವದತಿ, ತಥಾಪಿ ತತ್ ನ ಪ್ರತೀತ್|</para>
  <para style="p">
    <verse number="24" style="v"/>ಯತೋ ಭಾಕ್ತಖ್ರೀಷ್ಟಾ ಭಾಕ್ತಭವಿಷ್ಯದ್ವಾದಿನಶ್ಚ ಉಪಸ್ಥಾಯ ಯಾನಿ ಮಹನ್ತಿ ಲಕ್ಷ್ಮಾಣಿ ಚಿತ್ರಕರ್ಮ್ಮಾಣಿ ಚ ಪ್ರಕಾಶಯಿಷ್ಯನ್ತಿ, ತೈ ರ್ಯದಿ ಸಮ್ಭವೇತ್ ತರ್ಹಿ ಮನೋನೀತಮಾನವಾ ಅಪಿ ಭ್ರಾಮಿಷ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಪಶ್ಯತ, ಘಟನಾತಃ ಪೂರ್ವ್ವಂ ಯುಷ್ಮಾನ್ ವಾರ್ತ್ತಾಮ್ ಅವಾದಿಷಮ್|</para>
  <para style="p">
    <verse number="26" style="v"/>ಅತಃ ಪಶ್ಯತ, ಸ ಪ್ರಾನ್ತರೇ ವಿದ್ಯತ ಇತಿ ವಾಕ್ಯೇ ಕೇನಚಿತ್ ಕಥಿತೇಪಿ ಬಹಿ ರ್ಮಾ ಗಚ್ಛತ, ವಾ ಪಶ್ಯತ, ಸೋನ್ತಃಪುರೇ ವಿದ್ಯತೇ, ಏತದ್ವಾಕ್ಯ ಉಕ್ತೇಪಿ ಮಾ ಪ್ರತೀತ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಯತೋ ಯಥಾ ವಿದ್ಯುತ್ ಪೂರ್ವ್ವದಿಶೋ ನಿರ್ಗತ್ಯ ಪಶ್ಚಿಮದಿಶಂ ಯಾವತ್ ಪ್ರಕಾಶತೇ, ತಥಾ ಮಾನುಷಪುತ್ರಸ್ಯಾಪ್ಯಾಗಮನಂ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="28" style="v"/>ಯತ್ರ ಶವಸ್ತಿಷ್ಠತಿ, ತತ್ರೇವ ಗೃಧ್ರಾ ಮಿಲನ್ತಿ|</para>
  <para style="p">
    <verse number="29" style="v"/>ಅಪರಂ ತಸ್ಯ ಕ್ಲೇಶಸಮಯಸ್ಯಾವ್ಯವಹಿತಪರತ್ರ ಸೂರ್ಯ್ಯಸ್ಯ ತೇಜೋ ಲೋಪ್ಸ್ಯತೇ, ಚನ್ದ್ರಮಾ ಜ್ಯೋಸ್ನಾಂ ನ ಕರಿಷ್ಯತಿ, ನಭಸೋ ನಕ್ಷತ್ರಾಣಿ ಪತಿಷ್ಯನ್ತಿ, ಗಗಣೀಯಾ ಗ್ರಹಾಶ್ಚ ವಿಚಲಿಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="30" style="v"/>ತದಾನೀಮ್ ಆಕಾಶಮಧ್ಯೇ ಮನುಜಸುತಸ್ಯ ಲಕ್ಷ್ಮ ದರ್ಶಿಷ್ಯತೇ, ತತೋ ನಿಜಪರಾಕ್ರಮೇಣ ಮಹಾತೇಜಸಾ ಚ ಮೇಘಾರೂಢಂ ಮನುಜಸುತಂ ನಭಸಾಗಚ್ಛನ್ತಂ ವಿಲೋಕ್ಯ ಪೃಥಿವ್ಯಾಃ ಸರ್ವ್ವವಂಶೀಯಾ ವಿಲಪಿಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="31" style="v"/>ತದಾನೀಂ ಸ ಮಹಾಶಬ್ದಾಯಮಾನತೂರ್ಯ್ಯಾ ವಾದಕಾನ್ ನಿಜದೂತಾನ್ ಪ್ರಹೇಷ್ಯತಿ, ತೇ ವ್ಯೋಮ್ನ ಏಕಸೀಮಾತೋಽಪರಸೀಮಾಂ ಯಾವತ್ ಚತುರ್ದಿಶಸ್ತಸ್ಯ ಮನೋನೀತಜನಾನ್ ಆನೀಯ ಮೇಲಯಿಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="32" style="v"/>ಉಡುಮ್ಬರಪಾದಪಸ್ಯ ದೃಷ್ಟಾನ್ತಂ ಶಿಕ್ಷಧ್ವಂ; ಯದಾ ತಸ್ಯ ನವೀನಾಃ ಶಾಖಾ ಜಾಯನ್ತೇ, ಪಲ್ಲವಾದಿಶ್ಚ ನಿರ್ಗಚ್ಛತಿ, ತದಾ ನಿದಾಘಕಾಲಃ ಸವಿಧೋ ಭವತೀತಿ ಯೂಯಂ ಜಾನೀಥ;</para>
  <para style="p">
    <verse number="33" style="v"/>ತದ್ವದ್ ಏತಾ ಘಟನಾ ದೃಷ್ಟ್ವಾ ಸ ಸಮಯೋ ದ್ವಾರ ಉಪಾಸ್ಥಾದ್ ಇತಿ ಜಾನೀತ|</para>
  <para style="p">
    <verse number="34" style="v"/>ಯುಷ್ಮಾನಹಂ ತಥ್ಯಂ ವದಾಮಿ, ಇದಾನೀನ್ತನಜನಾನಾಂ ಗಮನಾತ್ ಪೂರ್ವ್ವಮೇವ ತಾನಿ ಸರ್ವ್ವಾಣಿ ಘಟಿಷ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="35" style="v"/>ನಭೋಮೇದಿನ್ಯೋ ರ್ಲುಪ್ತಯೋರಪಿ ಮಮ ವಾಕ್ ಕದಾಪಿ ನ ಲೋಪ್ಸ್ಯತೇ|</para>
  <para style="p">
    <verse number="36" style="v"/>ಅಪರಂ ಮಮ ತಾತಂ ವಿನಾ ಮಾನುಷಃ ಸ್ವರ್ಗಸ್ಥೋ ದೂತೋ ವಾ ಕೋಪಿ ತದ್ದಿನಂ ತದ್ದಣ್ಡಞ್ಚ ನ ಜ್ಞಾಪಯತಿ|</para>
  <para style="p">
    <verse number="37" style="v"/>ಅಪರಂ ನೋಹೇ ವಿದ್ಯಮಾನೇ ಯಾದೃಶಮಭವತ್ ತಾದೃಶಂ ಮನುಜಸುತಸ್ಯಾಗಮನಕಾಲೇಪಿ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="38" style="v"/>ಫಲತೋ ಜಲಾಪ್ಲಾವನಾತ್ ಪೂರ್ವ್ವಂ ಯದ್ದಿನಂ ಯಾವತ್ ನೋಹಃ ಪೋತಂ ನಾರೋಹತ್, ತಾವತ್ಕಾಲಂ ಯಥಾ ಮನುಷ್ಯಾ ಭೋಜನೇ ಪಾನೇ ವಿವಹನೇ ವಿವಾಹನೇ ಚ ಪ್ರವೃತ್ತಾ ಆಸನ್;</para>
  <para style="p">
    <verse number="39" style="v"/>ಅಪರಮ್ ಆಪ್ಲಾವಿತೋಯಮಾಗತ್ಯ ಯಾವತ್ ಸಕಲಮನುಜಾನ್ ಪ್ಲಾವಯಿತ್ವಾ ನಾನಯತ್, ತಾವತ್ ತೇ ಯಥಾ ನ ವಿದಾಮಾಸುಃ, ತಥಾ ಮನುಜಸುತಾಗಮನೇಪಿ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="40" style="v"/>ತದಾ ಕ್ಷೇತ್ರಸ್ಥಿತಯೋರ್ದ್ವಯೋರೇಕೋ ಧಾರಿಷ್ಯತೇ, ಅಪರಸ್ತ್ಯಾಜಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="41" style="v"/>ತಥಾ ಪೇಷಣ್ಯಾ ಪಿಂಷತ್ಯೋರುಭಯೋ ರ್ಯೋಷಿತೋರೇಕಾ ಧಾರಿಷ್ಯತೇಽಪರಾ ತ್ಯಾಜಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="42" style="v"/>ಯುಷ್ಮಾಕಂ ಪ್ರಭುಃ ಕಸ್ಮಿನ್ ದಣ್ಡ ಆಗಮಿಷ್ಯತಿ, ತದ್ ಯುಷ್ಮಾಭಿ ರ್ನಾವಗಮ್ಯತೇ, ತಸ್ಮಾತ್ ಜಾಗ್ರತಃ ಸನ್ತಸ್ತಿಷ್ಠತ|</para>
  <para style="p">
    <verse number="43" style="v"/>ಕುತ್ರ ಯಾಮೇ ಸ್ತೇನ ಆಗಮಿಷ್ಯತೀತಿ ಚೇದ್ ಗೃಹಸ್ಥೋ ಜ್ಞಾತುಮ್ ಅಶಕ್ಷ್ಯತ್, ತರ್ಹಿ ಜಾಗರಿತ್ವಾ ತಂ ಸನ್ಧಿಂ ಕರ್ತ್ತಿತುಮ್ ಅವಾರಯಿಷ್ಯತ್ ತದ್ ಜಾನೀತ|</para>
  <para style="p">
    <verse number="44" style="v"/>ಯುಷ್ಮಾಭಿರವಧೀಯತಾಂ, ಯತೋ ಯುಷ್ಮಾಭಿ ರ್ಯತ್ರ ನ ಬುಧ್ಯತೇ, ತತ್ರೈವ ದಣ್ಡೇ ಮನುಜಸುತ ಆಯಾಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="45" style="v"/>ಪ್ರಭು ರ್ನಿಜಪರಿವಾರಾನ್ ಯಥಾಕಾಲಂ ಭೋಜಯಿತುಂ ಯಂ ದಾಸಮ್ ಅಧ್ಯಕ್ಷೀಕೃತ್ಯ ಸ್ಥಾಪಯತಿ, ತಾದೃಶೋ ವಿಶ್ವಾಸ್ಯೋ ಧೀಮಾನ್ ದಾಸಃ ಕಃ?</para>
  <para style="p">
    <verse number="46" style="v"/>ಪ್ರಭುರಾಗತ್ಯ ಯಂ ದಾಸಂ ತಥಾಚರನ್ತಂ ವೀಕ್ಷತೇ, ಸಏವ ಧನ್ಯಃ|</para>
  <para style="p">
    <verse number="47" style="v"/>ಯುಷ್ಮಾನಹಂ ಸತ್ಯಂ ವದಾಮಿ, ಸ ತಂ ನಿಜಸರ್ವ್ವಸ್ವಸ್ಯಾಧಿಪಂ ಕರಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="48" style="v"/>ಕಿನ್ತು ಪ್ರಭುರಾಗನ್ತುಂ ವಿಲಮ್ಬತ ಇತಿ ಮನಸಿ ಚಿನ್ತಯಿತ್ವಾ ಯೋ ದುಷ್ಟೋ ದಾಸೋ</para>
  <para style="p">
    <verse number="49" style="v"/>ಽಪರದಾಸಾನ್ ಪ್ರಹರ್ತ್ತುಂ ಮತ್ತಾನಾಂ ಸಙ್ಗೇ ಭೋಕ್ತುಂ ಪಾತುಞ್ಚ ಪ್ರವರ್ತ್ತತೇ,</para>
  <para style="p">
    <verse number="50" style="v"/>ಸ ದಾಸೋ ಯದಾ ನಾಪೇಕ್ಷತೇ, ಯಞ್ಚ ದಣ್ಡಂ ನ ಜಾನಾತಿ, ತತ್ಕಾಲಏವ ತತ್ಪ್ರಭುರುಪಸ್ಥಾಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="51" style="v"/>ತದಾ ತಂ ದಣ್ಡಯಿತ್ವಾ ಯತ್ರ ಸ್ಥಾನೇ ರೋದನಂ ದನ್ತಘರ್ಷಣಞ್ಚಾಸಾತೇ, ತತ್ರ ಕಪಟಿಭಿಃ ಸಾಕಂ ತದ್ದಶಾಂ ನಿರೂಪಯಿಷ್ಯತಿ|</para>
  <chapter number="25" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಯಾ ದಶ ಕನ್ಯಾಃ ಪ್ರದೀಪಾನ್ ಗೃಹ್ಲತ್ಯೋ ವರಂ ಸಾಕ್ಷಾತ್ ಕರ್ತ್ತುಂ ಬಹಿರಿತಾಃ, ತಾಭಿಸ್ತದಾ ಸ್ವರ್ಗೀಯರಾಜ್ಯಸ್ಯ ಸಾದೃಶ್ಯಂ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತಾಸಾಂ ಕನ್ಯಾನಾಂ ಮಧ್ಯೇ ಪಞ್ಚ ಸುಧಿಯಃ ಪಞ್ಚ ದುರ್ಧಿಯ ಆಸನ್|</para>
  <para style="p">
    <verse number="3" style="v"/>ಯಾ ದುರ್ಧಿಯಸ್ತಾಃ ಪ್ರದೀಪಾನ್ ಸಙ್ಗೇ ಗೃಹೀತ್ವಾ ತೈಲಂ ನ ಜಗೃಹುಃ,</para>
  <para style="p">
    <verse number="4" style="v"/>ಕಿನ್ತು ಸುಧಿಯಃ ಪ್ರದೀಪಾನ್ ಪಾತ್ರೇಣ ತೈಲಞ್ಚ ಜಗೃಹುಃ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಅನನ್ತರಂ ವರೇ ವಿಲಮ್ಬಿತೇ ತಾಃ ಸರ್ವ್ವಾ ನಿದ್ರಾವಿಷ್ಟಾ ನಿದ್ರಾಂ ಜಗ್ಮುಃ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅನನ್ತರಮ್ ಅರ್ದ್ಧರಾತ್ರೇ ಪಶ್ಯತ ವರ ಆಗಚ್ಛತಿ, ತಂ ಸಾಕ್ಷಾತ್ ಕರ್ತ್ತುಂ ಬಹಿರ್ಯಾತೇತಿ ಜನರವಾತ್</para>
  <para style="p">
    <verse number="7" style="v"/>ತಾಃ ಸರ್ವ್ವಾಃ ಕನ್ಯಾ ಉತ್ಥಾಯ ಪ್ರದೀಪಾನ್ ಆಸಾದಯಿತುಂ ಆರಭನ್ತ|</para>
  <para style="p">
    <verse number="8" style="v"/>ತತೋ ದುರ್ಧಿಯಃ ಸುಧಿಯ ಊಚುಃ, ಕಿಞ್ಚಿತ್ ತೈಲಂ ದತ್ತ, ಪ್ರದೀಪಾ ಅಸ್ಮಾಕಂ ನಿರ್ವ್ವಾಣಾಃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಕಿನ್ತು ಸುಧಿಯಃ ಪ್ರತ್ಯವದನ್, ದತ್ತೇ ಯುಷ್ಮಾನಸ್ಮಾಂಶ್ಚ ಪ್ರತಿ ತೈಲಂ ನ್ಯೂನೀಭವೇತ್, ತಸ್ಮಾದ್ ವಿಕ್ರೇತೃಣಾಂ ಸಮೀಪಂ ಗತ್ವಾ ಸ್ವಾರ್ಥಂ ತೈಲಂ ಕ್ರೀಣೀತ|</para>
  <para style="p">
    <verse number="10" style="v"/>ತದಾ ತಾಸು ಕ್ರೇತುಂ ಗತಾಸು ವರ ಆಜಗಾಮ, ತತೋ ಯಾಃ ಸಜ್ಜಿತಾ ಆಸನ್, ತಾಸ್ತೇನ ಸಾಕಂ ವಿವಾಹೀಯಂ ವೇಶ್ಮ ಪ್ರವಿವಿಶುಃ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅನನ್ತರಂ ದ್ವಾರೇ ರುದ್ಧೇ ಅಪರಾಃ ಕನ್ಯಾ ಆಗತ್ಯ ಜಗದುಃ, ಹೇ ಪ್ರಭೋ, ಹೇ ಪ್ರಭೋ, ಅಸ್ಮಾನ್ ಪ್ರತಿ ದ್ವಾರಂ ಮೋಚಯ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಕಿನ್ತು ಸ ಉಕ್ತವಾನ್, ತಥ್ಯಂ ವದಾಮಿ, ಯುಷ್ಮಾನಹಂ ನ ವೇದ್ಮಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅತೋ ಜಾಗ್ರತಃ ಸನ್ತಸ್ತಿಷ್ಠತ, ಮನುಜಸುತಃ ಕಸ್ಮಿನ್ ದಿನೇ ಕಸ್ಮಿನ್ ದಣ್ಡೇ ವಾಗಮಿಷ್ಯತಿ, ತದ್ ಯುಷ್ಮಾಭಿ ರ್ನ ಜ್ಞಾಯತೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಅಪರಂ ಸ ಏತಾದೃಶಃ ಕಸ್ಯಚಿತ್ ಪುಂಸಸ್ತುಲ್ಯಃ, ಯೋ ದೂರದೇಶಂ ಪ್ರತಿ ಯಾತ್ರಾಕಾಲೇ ನಿಜದಾಸಾನ್ ಆಹೂಯ ತೇಷಾಂ ಸ್ವಸ್ವಸಾಮರ್ಥ್ಯಾನುರೂಪಮ್</para>
  <para style="p">
    <verse number="15" style="v"/>ಏಕಸ್ಮಿನ್ ಮುದ್ರಾಣಾಂ ಪಞ್ಚ ಪೋಟಲಿಕಾಃ ಅನ್ಯಸ್ಮಿಂಶ್ಚ ದ್ವೇ ಪೋಟಲಿಕೇ ಅಪರಸ್ಮಿಂಶ್ಚ ಪೋಟಲಿಕೈಕಾಮ್ ಇತ್ಥಂ ಪ್ರತಿಜನಂ ಸಮರ್ಪ್ಯ ಸ್ವಯಂ ಪ್ರವಾಸಂ ಗತವಾನ್|</para>
  <para style="p">
    <verse number="16" style="v"/>ಅನನ್ತರಂ ಯೋ ದಾಸಃ ಪಞ್ಚ ಪೋಟಲಿಕಾಃ ಲಬ್ಧವಾನ್, ಸ ಗತ್ವಾ ವಾಣಿಜ್ಯಂ ವಿಧಾಯ ತಾ ದ್ವಿಗುಣೀಚಕಾರ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಯಶ್ಚ ದಾಸೋ ದ್ವೇ ಪೋಟಲಿಕೇ ಅಲಭತ, ಸೋಪಿ ತಾ ಮುದ್ರಾ ದ್ವಿಗುಣೀಚಕಾರ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಕಿನ್ತು ಯೋ ದಾಸ ಏಕಾಂ ಪೋಟಲಿಕಾಂ ಲಬ್ಧವಾನ್, ಸ ಗತ್ವಾ ಭೂಮಿಂ ಖನಿತ್ವಾ ತನ್ಮಧ್ಯೇ ನಿಜಪ್ರಭೋಸ್ತಾ ಮುದ್ರಾ ಗೋಪಯಾಞ್ಚಕಾರ|</para>
  <para style="p">
    <verse number="19" style="v"/>ತದನನ್ತರಂ ಬಹುತಿಥೇ ಕಾಲೇ ಗತೇ ತೇಷಾಂ ದಾಸಾನಾಂ ಪ್ರಭುರಾಗತ್ಯ ತೈರ್ದಾಸೈಃ ಸಮಂ ಗಣಯಾಞ್ಚಕಾರ|</para>
  <para style="p">
    <verse number="20" style="v"/>ತದಾನೀಂ ಯಃ ಪಞ್ಚ ಪೋಟಲಿಕಾಃ ಪ್ರಾಪ್ತವಾನ್ ಸ ತಾ ದ್ವಿಗುಣೀಕೃತಮುದ್ರಾ ಆನೀಯ ಜಗಾದ; ಹೇ ಪ್ರಭೋ, ಭವತಾ ಮಯಿ ಪಞ್ಚ ಪೋಟಲಿಕಾಃ ಸಮರ್ಪಿತಾಃ, ಪಶ್ಯತು, ತಾ ಮಯಾ ದ್ವಿಗುಣೀಕೃತಾಃ|</para>
  <para style="p">
    <verse number="21" style="v"/>ತದಾನೀಂ ತಸ್ಯ ಪ್ರಭುಸ್ತಮುವಾಚ, ಹೇ ಉತ್ತಮ ವಿಶ್ವಾಸ್ಯ ದಾಸ, ತ್ವಂ ಧನ್ಯೋಸಿ, ಸ್ತೋಕೇನ ವಿಶ್ವಾಸ್ಯೋ ಜಾತಃ, ತಸ್ಮಾತ್ ತ್ವಾಂ ಬಹುವಿತ್ತಾಧಿಪಂ ಕರೋಮಿ, ತ್ವಂ ಸ್ವಪ್ರಭೋಃ ಸುಖಸ್ಯ ಭಾಗೀ ಭವ|</para>
  <para style="p">
    <verse number="22" style="v"/>ತತೋ ಯೇನ ದ್ವೇ ಪೋಟಲಿಕೇ ಲಬ್ಧೇ ಸೋಪ್ಯಾಗತ್ಯ ಜಗಾದ, ಹೇ ಪ್ರಭೋ, ಭವತಾ ಮಯಿ ದ್ವೇ ಪೋಟಲಿಕೇ ಸಮರ್ಪಿತೇ, ಪಶ್ಯತು ತೇ ಮಯಾ ದ್ವಿಗುಣೀಕೃತೇ|</para>
  <para style="p">
    <verse number="23" style="v"/>ತೇನ ತಸ್ಯ ಪ್ರಭುಸ್ತಮವೋಚತ್, ಹೇ ಉತ್ತಮ ವಿಶ್ವಾಸ್ಯ ದಾಸ, ತ್ವಂ ಧನ್ಯೋಸಿ, ಸ್ತೋಕೇನ ವಿಶ್ವಾಸ್ಯೋ ಜಾತಃ, ತಸ್ಮಾತ್ ತ್ವಾಂ ಬಹುದ್ರವಿಣಾಧಿಪಂ ಕರೋಮಿ, ತ್ವಂ ನಿಜಪ್ರಭೋಃ ಸುಖಸ್ಯ ಭಾಗೀ ಭವ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಅನನ್ತರಂ ಯ ಏಕಾಂ ಪೋಟಲಿಕಾಂ ಲಬ್ಧವಾನ್, ಸ ಏತ್ಯ ಕಥಿತವಾನ್, ಹೇ ಪ್ರಭೋ, ತ್ವಾಂ ಕಠಿನನರಂ ಜ್ಞಾತವಾನ್, ತ್ವಯಾ ಯತ್ರ ನೋಪ್ತಂ, ತತ್ರೈವ ಕೃತ್ಯತೇ, ಯತ್ರ ಚ ನ ಕೀರ್ಣಂ, ತತ್ರೈವ ಸಂಗೃಹ್ಯತೇ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಅತೋಹಂ ಸಶಙ್ಕಃ ಸನ್ ಗತ್ವಾ ತವ ಮುದ್ರಾ ಭೂಮಧ್ಯೇ ಸಂಗೋಪ್ಯ ಸ್ಥಾಪಿತವಾನ್, ಪಶ್ಯ, ತವ ಯತ್ ತದೇವ ಗೃಹಾಣ|</para>
  <para style="p">
    <verse number="26" style="v"/>ತದಾ ತಸ್ಯ ಪ್ರಭುಃ ಪ್ರತ್ಯವದತ್ ರೇ ದುಷ್ಟಾಲಸ ದಾಸ, ಯತ್ರಾಹಂ ನ ವಪಾಮಿ, ತತ್ರ ಛಿನದ್ಮಿ, ಯತ್ರ ಚ ನ ಕಿರಾಮಿ, ತತ್ರೇವ ಸಂಗೃಹ್ಲಾಮೀತಿ ಚೇದಜಾನಾಸ್ತರ್ಹಿ</para>
  <para style="p">
    <verse number="27" style="v"/>ವಣಿಕ್ಷು ಮಮ ವಿತ್ತಾರ್ಪಣಂ ತವೋಚಿತಮಾಸೀತ್, ಯೇನಾಹಮಾಗತ್ಯ ವೃದ್ವ್ಯಾ ಸಾಕಂ ಮೂಲಮುದ್ರಾಃ ಪ್ರಾಪ್ಸ್ಯಮ್|</para>
  <para style="p">
    <verse number="28" style="v"/>ಅತೋಸ್ಮಾತ್ ತಾಂ ಪೋಟಲಿಕಾಮ್ ಆದಾಯ ಯಸ್ಯ ದಶ ಪೋಟಲಿಕಾಃ ಸನ್ತಿ ತಸ್ಮಿನ್ನರ್ಪಯತ|</para>
  <para style="p">
    <verse number="29" style="v"/>ಯೇನ ವರ್ದ್ವ್ಯತೇ ತಸ್ಮಿನ್ನೈವಾರ್ಪಿಷ್ಯತೇ, ತಸ್ಯೈವ ಚ ಬಾಹುಲ್ಯಂ ಭವಿಷ್ಯತಿ, ಕಿನ್ತು ಯೇನ ನ ವರ್ದ್ವ್ಯತೇ, ತಸ್ಯಾನ್ತಿಕೇ ಯತ್ ಕಿಞ್ಚನ ತಿಷ್ಠತಿ, ತದಪಿ ಪುನರ್ನೇಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="30" style="v"/>ಅಪರಂ ಯೂಯಂ ತಮಕರ್ಮ್ಮಣ್ಯಂ ದಾಸಂ ನೀತ್ವಾ ಯತ್ರ ಸ್ಥಾನೇ ಕ್ರನ್ದನಂ ದನ್ತಘರ್ಷಣಞ್ಚ ವಿದ್ಯೇತೇ, ತಸ್ಮಿನ್ ಬಹಿರ್ಭೂತತಮಸಿ ನಿಕ್ಷಿಪತ|</para>
  <para style="p">
    <verse number="31" style="v"/>ಯದಾ ಮನುಜಸುತಃ ಪವಿತ್ರದೂತಾನ್ ಸಙ್ಗಿನಃ ಕೃತ್ವಾ ನಿಜಪ್ರಭಾವೇನಾಗತ್ಯ ನಿಜತೇಜೋಮಯೇ ಸಿಂಹಾಸನೇ ನಿವೇಕ್ಷ್ಯತಿ,</para>
  <para style="p">
    <verse number="32" style="v"/>ತದಾ ತತ್ಸಮ್ಮುಖೇ ಸರ್ವ್ವಜಾತೀಯಾ ಜನಾ ಸಂಮೇಲಿಷ್ಯನ್ತಿ| ತತೋ ಮೇಷಪಾಲಕೋ ಯಥಾ ಛಾಗೇಭ್ಯೋಽವೀನ್ ಪೃಥಕ್ ಕರೋತಿ ತಥಾ ಸೋಪ್ಯೇಕಸ್ಮಾದನ್ಯಮ್ ಇತ್ಥಂ ತಾನ್ ಪೃಥಕ ಕೃತ್ವಾವೀನ್</para>
  <para style="p">
    <verse number="33" style="v"/>ದಕ್ಷಿಣೇ ಛಾಗಾಂಶ್ಚ ವಾಮೇ ಸ್ಥಾಪಯಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="34" style="v"/>ತತಃ ಪರಂ ರಾಜಾ ದಕ್ಷಿಣಸ್ಥಿತಾನ್ ಮಾನವಾನ್ ವದಿಷ್ಯತಿ, ಆಗಚ್ಛತ ಮತ್ತಾತಸ್ಯಾನುಗ್ರಹಭಾಜನಾನಿ, ಯುಷ್ಮತ್ಕೃತ ಆ ಜಗದಾರಮ್ಭತ್ ಯದ್ ರಾಜ್ಯಮ್ ಆಸಾದಿತಂ ತದಧಿಕುರುತ|</para>
  <para style="p">
    <verse number="35" style="v"/>ಯತೋ ಬುಭುಕ್ಷಿತಾಯ ಮಹ್ಯಂ ಭೋಜ್ಯಮ್ ಅದತ್ತ, ಪಿಪಾಸಿತಾಯ ಪೇಯಮದತ್ತ, ವಿದೇಶಿನಂ ಮಾಂ ಸ್ವಸ್ಥಾನಮನಯತ,</para>
  <para style="p">
    <verse number="36" style="v"/>ವಸ್ತ್ರಹೀನಂ ಮಾಂ ವಸನಂ ಪರ್ಯ್ಯಧಾಪಯತ, ಪೀಡೀತಂ ಮಾಂ ದ್ರಷ್ಟುಮಾಗಚ್ಛತ, ಕಾರಾಸ್ಥಞ್ಚ ಮಾಂ ವೀಕ್ಷಿತುಮ ಆಗಚ್ಛತ|</para>
  <para style="p">
    <verse number="37" style="v"/>ತದಾ ಧಾರ್ಮ್ಮಿಕಾಃ ಪ್ರತಿವದಿಷ್ಯನ್ತಿ, ಹೇ ಪ್ರಭೋ, ಕದಾ ತ್ವಾಂ ಕ್ಷುಧಿತಂ ವೀಕ್ಷ್ಯ ವಯಮಭೋಜಯಾಮ? ವಾ ಪಿಪಾಸಿತಂ ವೀಕ್ಷ್ಯ ಅಪಾಯಯಾಮ?</para>
  <para style="p">
    <verse number="38" style="v"/>ಕದಾ ವಾ ತ್ವಾಂ ವಿದೇಶಿನಂ ವಿಲೋಕ್ಯ ಸ್ವಸ್ಥಾನಮನಯಾಮ? ಕದಾ ವಾ ತ್ವಾಂ ನಗ್ನಂ ವೀಕ್ಷ್ಯ ವಸನಂ ಪರ್ಯ್ಯಧಾಪಯಾಮ?</para>
  <para style="p">
    <verse number="39" style="v"/>ಕದಾ ವಾ ತ್ವಾಂ ಪೀಡಿತಂ ಕಾರಾಸ್ಥಞ್ಚ ವೀಕ್ಷ್ಯ ತ್ವದನ್ತಿಕಮಗಚ್ಛಾಮ?</para>
  <para style="p">
    <verse number="40" style="v"/>ತದಾನೀಂ ರಾಜಾ ತಾನ್ ಪ್ರತಿವದಿಷ್ಯತಿ, ಯುಷ್ಮಾನಹಂ ಸತ್ಯಂ ವದಾಮಿ, ಮಮೈತೇಷಾಂ ಭ್ರಾತೃಣಾಂ ಮಧ್ಯೇ ಕಞ್ಚನೈಕಂ ಕ್ಷುದ್ರತಮಂ ಪ್ರತಿ ಯದ್ ಅಕುರುತ, ತನ್ಮಾಂ ಪ್ರತ್ಯಕುರುತ|</para>
  <para style="p">
    <verse number="41" style="v"/>ಪಶ್ಚಾತ್ ಸ ವಾಮಸ್ಥಿತಾನ್ ಜನಾನ್ ವದಿಷ್ಯತಿ, ರೇ ಶಾಪಗ್ರಸ್ತಾಃ ಸರ್ವ್ವೇ, ಶೈತಾನೇ ತಸ್ಯ ದೂತೇಭ್ಯಶ್ಚ ಯೋಽನನ್ತವಹ್ನಿರಾಸಾದಿತ ಆಸ್ತೇ, ಯೂಯಂ ಮದನ್ತಿಕಾತ್ ತಮಗ್ನಿಂ ಗಚ್ಛತ|</para>
  <para style="p">
    <verse number="42" style="v"/>ಯತೋ ಕ್ಷುಧಿತಾಯ ಮಹ್ಯಮಾಹಾರಂ ನಾದತ್ತ, ಪಿಪಾಸಿತಾಯ ಮಹ್ಯಂ ಪೇಯಂ ನಾದತ್ತ,</para>
  <para style="p">
    <verse number="43" style="v"/>ವಿದೇಶಿನಂ ಮಾಂ ಸ್ವಸ್ಥಾನಂ ನಾನಯತ, ವಸನಹೀನಂ ಮಾಂ ವಸನಂ ನ ಪರ್ಯ್ಯಧಾಪಯತ, ಪೀಡಿತಂ ಕಾರಾಸ್ಥಞ್ಚ ಮಾಂ ವೀಕ್ಷಿತುಂ ನಾಗಚ್ಛತ|</para>
  <para style="p">
    <verse number="44" style="v"/>ತದಾ ತೇ ಪ್ರತಿವದಿಷ್ಯನ್ತಿ, ಹೇ ಪ್ರಭೋ, ಕದಾ ತ್ವಾಂ ಕ್ಷುಧಿತಂ ವಾ ಪಿಪಾಸಿತಂ ವಾ ವಿದೇಶಿನಂ ವಾ ನಗ್ನಂ ವಾ ಪೀಡಿತಂ ವಾ ಕಾರಾಸ್ಥಂ ವೀಕ್ಷ್ಯ ತ್ವಾಂ ನಾಸೇವಾಮಹಿ?</para>
  <para style="p">
    <verse number="45" style="v"/>ತದಾ ಸ ತಾನ್ ವದಿಷ್ಯತಿ, ತಥ್ಯಮಹಂ ಯುಷ್ಮಾನ್ ಬ್ರವೀಮಿ, ಯುಷ್ಮಾಭಿರೇಷಾಂ ಕಞ್ಚನ ಕ್ಷೋದಿಷ್ಠಂ ಪ್ರತಿ ಯನ್ನಾಕಾರಿ, ತನ್ಮಾಂ ಪ್ರತ್ಯೇವ ನಾಕಾರಿ|</para>
  <para style="p">
    <verse number="46" style="v"/>ಪಶ್ಚಾದಮ್ಯನನ್ತಶಾಸ್ತಿಂ ಕಿನ್ತು ಧಾರ್ಮ್ಮಿಕಾ ಅನನ್ತಾಯುಷಂ ಭೋಕ್ತುಂ ಯಾಸ್ಯನ್ತಿ|</para>
  <chapter number="26" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಯೀಶುರೇತಾನ್ ಪ್ರಸ್ತಾವಾನ್ ಸಮಾಪ್ಯ ಶಿಷ್ಯಾನೂಚೇ,</para>
  <para style="p">
    <verse number="2" style="v"/>ಯುಷ್ಮಾಭಿ ರ್ಜ್ಞಾತಂ ದಿನದ್ವಯಾತ್ ಪರಂ ನಿಸ್ತಾರಮಹ ಉಪಸ್ಥಾಸ್ಯತಿ, ತತ್ರ ಮನುಜಸುತಃ ಕ್ರುಶೇನ ಹನ್ತುಂ ಪರಕರೇಷು ಸಮರ್ಪಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="3" style="v"/>ತತಃ ಪರಂ ಪ್ರಧಾನಯಾಜಕಾಧ್ಯಾಪಕಪ್ರಾಞ್ಚಃ ಕಿಯಫಾನಾಮ್ನೋ ಮಹಾಯಾಜಕಸ್ಯಾಟ್ಟಾಲಿಕಾಯಾಂ ಮಿಲಿತ್ವಾ</para>
  <para style="p">
    <verse number="4" style="v"/>ಕೇನೋಪಾಯೇನ ಯೀಶುಂ ಧೃತ್ವಾ ಹನ್ತುಂ ಶಕ್ನುಯುರಿತಿ ಮನ್ತ್ರಯಾಞ್ಚಕ್ರುಃ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಕಿನ್ತು ತೈರುಕ್ತಂ ಮಹಕಾಲೇ ನ ಧರ್ತ್ತವ್ಯಃ, ಧೃತೇ ಪ್ರಜಾನಾಂ ಕಲಹೇನ ಭವಿತುಂ ಶಕ್ಯತೇ|</para>
  <para style="p">
    <verse number="6" style="v"/>ತತೋ ಬೈಥನಿಯಾಪುರೇ ಶಿಮೋನಾಖ್ಯಸ್ಯ ಕುಷ್ಠಿನೋ ವೇಶ್ಮನಿ ಯೀಶೌ ತಿಷ್ಠತಿ</para>
  <para style="p">
    <verse number="7" style="v"/>ಕಾಚನ ಯೋಷಾ ಶ್ವೇತೋಪಲಭಾಜನೇನ ಮಹಾರ್ಘ್ಯಂ ಸುಗನ್ಧಿ ತೈಲಮಾನೀಯ ಭೋಜನಾಯೋಪವಿಶತಸ್ತಸ್ಯ ಶಿರೋಭ್ಯಷೇಚತ್|</para>
  <para style="p">
    <verse number="8" style="v"/>ಕಿನ್ತು ತದಾಲೋಕ್ಯ ತಚ್ಛಿಷ್ಯೈಃ ಕುಪಿತೈರುಕ್ತಂ, ಕುತ ಇತ್ಥಮಪವ್ಯಯತೇ?</para>
  <para style="p">
    <verse number="9" style="v"/>ಚೇದಿದಂ ವ್ಯಕ್ರೇಷ್ಯತ, ತರ್ಹಿ ಭೂರಿಮೂಲ್ಯಂ ಪ್ರಾಪ್ಯ ದರಿದ್ರೇಭ್ಯೋ ವ್ಯತಾರಿಷ್ಯತ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯೀಶುನಾ ತದವಗತ್ಯ ತೇ ಸಮುದಿತಾಃ, ಯೋಷಾಮೇನಾಂ ಕುತೋ ದುಃಖಿನೀಂ ಕುರುಥ, ಸಾ ಮಾಂ ಪ್ರತಿ ಸಾಧು ಕರ್ಮ್ಮಾಕಾರ್ಷೀತ್|</para>
  <para style="p">
    <verse number="11" style="v"/>ಯುಷ್ಮಾಕಮಂ ಸಮೀಪೇ ದರಿದ್ರಾಃ ಸತತಮೇವಾಸತೇ, ಕಿನ್ತು ಯುಷ್ಮಾಕಮನ್ತಿಕೇಹಂ ನಾಸೇ ಸತತಂ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಸಾ ಮಮ ಕಾಯೋಪರಿ ಸುಗನ್ಧಿತೈಲಂ ಸಿಕ್ತ್ವಾ ಮಮ ಶ್ಮಶಾನದಾನಕರ್ಮ್ಮಾಕಾರ್ಷೀತ್|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅತೋಹಂ ಯುಷ್ಮಾನ್ ತಥ್ಯಂ ವದಾಮಿ ಸರ್ವ್ವಸ್ಮಿನ್ ಜಗತಿ ಯತ್ರ ಯತ್ರೈಷ ಸುಸಮಾಚಾರಃ ಪ್ರಚಾರಿಷ್ಯತೇ, ತತ್ರ ತತ್ರೈತಸ್ಯಾ ನಾರ್ಯ್ಯಾಃ ಸ್ಮರಣಾರ್ಥಮ್ ಕರ್ಮ್ಮೇದಂ ಪ್ರಚಾರಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ತತೋ ದ್ವಾದಶಶಿಷ್ಯಾಣಾಮ್ ಈಷ್ಕರಿಯೋತೀಯಯಿಹೂದಾನಾಮಕ ಏಕಃ ಶಿಷ್ಯಃ ಪ್ರಧಾನಯಾಜಕಾನಾಮನ್ತಿಕಂ ಗತ್ವಾ ಕಥಿತವಾನ್,</para>
  <para style="p">
    <verse number="15" style="v"/>ಯದಿ ಯುಷ್ಮಾಕಂ ಕರೇಷು ಯೀಶುಂ ಸಮರ್ಪಯಾಮಿ, ತರ್ಹಿ ಕಿಂ ದಾಸ್ಯಥ? ತದಾನೀಂ ತೇ ತಸ್ಮೈ ತ್ರಿಂಶನ್ಮುದ್ರಾ ದಾತುಂ ಸ್ಥಿರೀಕೃತವನ್ತಃ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಸ ತದಾರಭ್ಯ ತಂ ಪರಕರೇಷು ಸಮರ್ಪಯಿತುಂ ಸುಯೋಗಂ ಚೇಷ್ಟಿತವಾನ್|</para>
  <para style="p">
    <verse number="17" style="v"/>ಅನನ್ತರಂ ಕಿಣ್ವಶೂನ್ಯಪೂಪಪರ್ವ್ವಣಃ ಪ್ರಥಮೇಹ್ನಿ ಶಿಷ್ಯಾ ಯೀಶುಮ್ ಉಪಗತ್ಯ ಪಪ್ರಚ್ಛುಃ ಭವತ್ಕೃತೇ ಕುತ್ರ ವಯಂ ನಿಸ್ತಾರಮಹಭೋಜ್ಯಮ್ ಆಯೋಜಯಿಷ್ಯಾಮಃ? ಭವತಃ ಕೇಚ್ಛಾ?</para>
  <para style="p">
    <verse number="18" style="v"/>ತದಾ ಸ ಗದಿತವಾನ್, ಮಧ್ಯೇನಗರಮಮುಕಪುಂಸಃ ಸಮೀಪಂ ವ್ರಜಿತ್ವಾ ವದತ, ಗುರು ರ್ಗದಿತವಾನ್, ಮತ್ಕಾಲಃ ಸವಿಧಃ, ಸಹ ಶಿಷ್ಯೈಸ್ತ್ವದಾಲಯೇ ನಿಸ್ತಾರಮಹಭೋಜ್ಯಂ ಭೋಕ್ಷ್ಯೇ|</para>
  <para style="p">
    <verse number="19" style="v"/>ತದಾ ಶಿಷ್ಯಾ ಯೀಶೋಸ್ತಾದೃಶನಿದೇಶಾನುರೂಪಕರ್ಮ್ಮ ವಿಧಾಯ ತತ್ರ ನಿಸ್ತಾರಮಹಭೋಜ್ಯಮಾಸಾದಯಾಮಾಸುಃ|</para>
  <para style="p">
    <verse number="20" style="v"/>ತತಃ ಸನ್ಧ್ಯಾಯಾಂ ಸತ್ಯಾಂ ದ್ವಾದಶಭಿಃ ಶಿಷ್ಯೈಃ ಸಾಕಂ ಸ ನ್ಯವಿಶತ್|</para>
  <para style="p">
    <verse number="21" style="v"/>ಅಪರಂ ಭುಞ್ಜಾನ ಉಕ್ತವಾನ್ ಯುಷ್ಮಾನ್ ತಥ್ಯಂ ವದಾಮಿ, ಯುಷ್ಮಾಕಮೇಕೋ ಮಾಂ ಪರಕರೇಷು ಸಮರ್ಪಯಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="22" style="v"/>ತದಾ ತೇಽತೀವ ದುಃಖಿತಾ ಏಕೈಕಶೋ ವಕ್ತುಮಾರೇಭಿರೇ, ಹೇ ಪ್ರಭೋ, ಸ ಕಿಮಹಂ?</para>
  <para style="p">
    <verse number="23" style="v"/>ತತಃ ಸ ಜಗಾದ, ಮಯಾ ಸಾಕಂ ಯೋ ಜನೋ ಭೋಜನಪಾತ್ರೇ ಕರಂ ಸಂಕ್ಷಿಪತಿ, ಸ ಏವ ಮಾಂ ಪರಕರೇಷು ಸಮರ್ಪಯಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಮನುಜಸುತಮಧಿ ಯಾದೃಶಂ ಲಿಖಿತಮಾಸ್ತೇ, ತದನುರೂಪಾ ತದ್ಗತಿ ರ್ಭವಿಷ್ಯತಿ; ಕಿನ್ತು ಯೇನ ಪುಂಸಾ ಸ ಪರಕರೇಷು ಸಮರ್ಪಯಿಷ್ಯತೇ, ಹಾ ಹಾ ಚೇತ್ ಸ ನಾಜನಿಷ್ಯತ, ತದಾ ತಸ್ಯ ಕ್ಷೇಮಮಭವಿಷ್ಯತ್|</para>
  <para style="p">
    <verse number="25" style="v"/>ತದಾ ಯಿಹೂದಾನಾಮಾ ಯೋ ಜನಸ್ತಂ ಪರಕರೇಷು ಸಮರ್ಪಯಿಷ್ಯತಿ, ಸ ಉಕ್ತವಾನ್, ಹೇ ಗುರೋ, ಸ ಕಿಮಹಂ? ತತಃ ಸ ಪ್ರತ್ಯುಕ್ತವಾನ್, ತ್ವಯಾ ಸತ್ಯಂ ಗದಿತಮ್|</para>
  <para style="p">
    <verse number="26" style="v"/>ಅನನ್ತರಂ ತೇಷಾಮಶನಕಾಲೇ ಯೀಶುಃ ಪೂಪಮಾದಾಯೇಶ್ವರೀಯಗುಣಾನನೂದ್ಯ ಭಂಕ್ತ್ವಾ ಶಿಷ್ಯೇಭ್ಯಃ ಪ್ರದಾಯ ಜಗಾದ, ಮದ್ವಪುಃಸ್ವರೂಪಮಿಮಂ ಗೃಹೀತ್ವಾ ಖಾದತ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಪಶ್ಚಾತ್ ಸ ಕಂಸಂ ಗೃಹ್ಲನ್ ಈಶ್ವರೀಯಗುಣಾನನೂದ್ಯ ತೇಭ್ಯಃ ಪ್ರದಾಯ ಕಥಿತವಾನ್, ಸರ್ವ್ವೈ ರ್ಯುಷ್ಮಾಭಿರನೇನ ಪಾತವ್ಯಂ,</para>
  <para style="p">
    <verse number="28" style="v"/>ಯಸ್ಮಾದನೇಕೇಷಾಂ ಪಾಪಮರ್ಷಣಾಯ ಪಾತಿತಂ ಯನ್ಮನ್ನೂತ್ನನಿಯಮರೂಪಶೋಣಿತಂ ತದೇತತ್|</para>
  <para style="p">
    <verse number="29" style="v"/>ಅಪರಮಹಂ ನೂತ್ನಗೋಸ್ತನೀರಸಂ ನ ಪಾಸ್ಯಾಮಿ, ತಾವತ್ ಗೋಸ್ತನೀಫಲರಸಂ ಪುನಃ ಕದಾಪಿ ನ ಪಾಸ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="30" style="v"/>ಪಶ್ಚಾತ್ ತೇ ಗೀತಮೇಕಂ ಸಂಗೀಯ ಜೈತುನಾಖ್ಯಗಿರಿಂ ಗತವನ್ತಃ|</para>
  <para style="p">
    <verse number="31" style="v"/>ತದಾನೀಂ ಯೀಶುಸ್ತಾನವೋಚತ್, ಅಸ್ಯಾಂ ರಜನ್ಯಾಮಹಂ ಯುಷ್ಮಾಕಂ ಸರ್ವ್ವೇಷಾಂ ವಿಘ್ನರೂಪೋ ಭವಿಷ್ಯಾಮಿ, ಯತೋ ಲಿಖಿತಮಾಸ್ತೇ, "ಮೇಷಾಣಾಂ ರಕ್ಷಕೋ ಯಸ್ತಂ ಪ್ರಹರಿಷ್ಯಾಮ್ಯಹಂ ತತಃ| ಮೇಷಾಣಾಂ ನಿವಹೋ ನೂನಂ ಪ್ರವಿಕೀರ್ಣೋ ಭವಿಷ್ಯತಿ"||</para>
  <para style="p">
    <verse number="32" style="v"/>ಕಿನ್ತು ಶ್ಮಶಾನಾತ್ ಸಮುತ್ಥಾಯ ಯುಷ್ಮಾಕಮಗ್ರೇಽಹಂ ಗಾಲೀಲಂ ಗಮಿಷ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="33" style="v"/>ಪಿತರಸ್ತಂ ಪ್ರೋವಾಚ, ಭವಾಂಶ್ಚೇತ್ ಸರ್ವ್ವೇಷಾಂ ವಿಘ್ನರೂಪೋ ಭವತಿ, ತಥಾಪಿ ಮಮ ನ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="34" style="v"/>ತತೋ ಯೀಶುನಾ ಸ ಉಕ್ತಃ, ತುಭ್ಯಮಹಂ ತಥ್ಯಂ ಕಥಯಾಮಿ, ಯಾಮಿನ್ಯಾಮಸ್ಯಾಂ ಚರಣಾಯುಧಸ್ಯ ರವಾತ್ ಪೂರ್ವ್ವಂ ತ್ವಂ ಮಾಂ ತ್ರಿ ರ್ನಾಙ್ಗೀಕರಿಷ್ಯಸಿ|</para>
  <para style="p">
    <verse number="35" style="v"/>ತತಃ ಪಿತರ ಉದಿತವಾನ್, ಯದ್ಯಪಿ ತ್ವಯಾ ಸಮಂ ಮರ್ತ್ತವ್ಯಂ, ತಥಾಪಿ ಕದಾಪಿ ತ್ವಾಂ ನ ನಾಙ್ಗೀಕರಿಷ್ಯಾಮಿ; ತಥೈವ ಸರ್ವ್ವೇ ಶಿಷ್ಯಾಶ್ಚೋಚುಃ|</para>
  <para style="p">
    <verse number="36" style="v"/>ಅನನ್ತರಂ ಯೀಶುಃ ಶಿಷ್ಯೈಃ ಸಾಕಂ ಗೇತ್ಶಿಮಾನೀನಾಮಕಂ ಸ್ಥಾನಂ ಪ್ರಸ್ಥಾಯ ತೇಭ್ಯಃ ಕಥಿತವಾನ್, ಅದಃ ಸ್ಥಾನಂ ಗತ್ವಾ ಯಾವದಹಂ ಪ್ರಾರ್ಥಯಿಷ್ಯೇ ತಾವದ್ ಯೂಯಮತ್ರೋಪವಿಶತ|</para>
  <para style="p">
    <verse number="37" style="v"/>ಪಶ್ಚಾತ್ ಸ ಪಿತರಂ ಸಿವದಿಯಸುತೌ ಚ ಸಙ್ಗಿನಃ ಕೃತ್ವಾ ಗತವಾನ್, ಶೋಕಾಕುಲೋಽತೀವ ವ್ಯಥಿತಶ್ಚ ಬಭೂವ|</para>
  <para style="p">
    <verse number="38" style="v"/>ತಾನವಾದೀಚ್ಚ ಮೃತಿಯಾತನೇವ ಮತ್ಪ್ರಾಣಾನಾಂ ಯಾತನಾ ಜಾಯತೇ, ಯೂಯಮತ್ರ ಮಯಾ ಸಾರ್ದ್ಧಂ ಜಾಗೃತ|</para>
  <para style="p">
    <verse number="39" style="v"/>ತತಃ ಸ ಕಿಞ್ಚಿದ್ದೂರಂ ಗತ್ವಾಧೋಮುಖಃ ಪತನ್ ಪ್ರಾರ್ಥಯಾಞ್ಚಕ್ರೇ, ಹೇ ಮತ್ಪಿತರ್ಯದಿ ಭವಿತುಂ ಶಕ್ನೋತಿ, ತರ್ಹಿ ಕಂಸೋಽಯಂ ಮತ್ತೋ ದೂರಂ ಯಾತು; ಕಿನ್ತು ಮದಿಚ್ಛಾವತ್ ನ ಭವತು, ತ್ವದಿಚ್ಛಾವದ್ ಭವತು|</para>
  <para style="p">
    <verse number="40" style="v"/>ತತಃ ಸ ಶಿಷ್ಯಾನುಪೇತ್ಯ ತಾನ್ ನಿದ್ರತೋ ನಿರೀಕ್ಷ್ಯ ಪಿತರಾಯ ಕಥಯಾಮಾಸ, ಯೂಯಂ ಮಯಾ ಸಾಕಂ ದಣ್ಡಮೇಕಮಪಿ ಜಾಗರಿತುಂ ನಾಶನ್ಕುತ?</para>
  <para style="p">
    <verse number="41" style="v"/>ಪರೀಕ್ಷಾಯಾಂ ನ ಪತಿತುಂ ಜಾಗೃತ ಪ್ರಾರ್ಥಯಧ್ವಞ್ಚ; ಆತ್ಮಾ ಸಮುದ್ಯತೋಸ್ತಿ, ಕಿನ್ತು ವಪು ರ್ದುರ್ಬ್ಬಲಂ|</para>
  <para style="p">
    <verse number="42" style="v"/>ಸ ದ್ವಿತೀಯವಾರಂ ಪ್ರಾರ್ಥಯಾಞ್ಚಕ್ರೇ, ಹೇ ಮತ್ತಾತ, ನ ಪೀತೇ ಯದಿ ಕಂಸಮಿದಂ ಮತ್ತೋ ದೂರಂ ಯಾತುಂ ನ ಶಕ್ನೋತಿ, ತರ್ಹಿ ತ್ವದಿಚ್ಛಾವದ್ ಭವತು|</para>
  <para style="p">
    <verse number="43" style="v"/>ಸ ಪುನರೇತ್ಯ ತಾನ್ ನಿದ್ರತೋ ದದರ್ಶ, ಯತಸ್ತೇಷಾಂ ನೇತ್ರಾಣಿ ನಿದ್ರಯಾ ಪೂರ್ಣಾನ್ಯಾಸನ್|</para>
  <para style="p">
    <verse number="44" style="v"/>ಪಶ್ಚಾತ್ ಸ ತಾನ್ ವಿಹಾಯ ವ್ರಜಿತ್ವಾ ತೃತೀಯವಾರಂ ಪೂರ್ವ್ವವತ್ ಕಥಯನ್ ಪ್ರಾರ್ಥಿತವಾನ್|</para>
  <para style="p">
    <verse number="45" style="v"/>ತತಃ ಶಿಷ್ಯಾನುಪಾಗತ್ಯ ಗದಿತವಾನ್, ಸಾಮ್ಪ್ರತಂ ಶಯಾನಾಃ ಕಿಂ ವಿಶ್ರಾಮ್ಯಥ? ಪಶ್ಯತ, ಸಮಯ ಉಪಾಸ್ಥಾತ್, ಮನುಜಸುತಃ ಪಾಪಿನಾಂ ಕರೇಷು ಸಮರ್ಪ್ಯತೇ|</para>
  <para style="p">
    <verse number="46" style="v"/>ಉತ್ತಿಷ್ಠತ, ವಯಂ ಯಾಮಃ, ಯೋ ಮಾಂ ಪರಕರೇಷು ಮಸರ್ಪಯಿಷ್ಯತಿ, ಪಶ್ಯತ, ಸ ಸಮೀಪಮಾಯಾತಿ|</para>
  <para style="p">
    <verse number="47" style="v"/>ಏತತ್ಕಥಾಕಥನಕಾಲೇ ದ್ವಾದಶಶಿಷ್ಯಾಣಾಮೇಕೋ ಯಿಹೂದಾನಾಮಕೋ ಮುಖ್ಯಯಾಜಕಲೋಕಪ್ರಾಚೀನೈಃ ಪ್ರಹಿತಾನ್ ಅಸಿಧಾರಿಯಷ್ಟಿಧಾರಿಣೋ ಮನುಜಾನ್ ಗೃಹೀತ್ವಾ ತತ್ಸಮೀಪಮುಪತಸ್ಥೌ|</para>
  <para style="p">
    <verse number="48" style="v"/>ಅಸೌ ಪರಕರೇಷ್ವರ್ಪಯಿತಾ ಪೂರ್ವ್ವಂ ತಾನ್ ಇತ್ಥಂ ಸಙ್ಕೇತಯಾಮಾಸ, ಯಮಹಂ ಚುಮ್ಬಿಷ್ಯೇ, ಸೋಽಸೌ ಮನುಜಃ,ಸಏವ ಯುಷ್ಮಾಭಿ ರ್ಧಾರ್ಯ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="49" style="v"/>ತದಾ ಸ ಸಪದಿ ಯೀಶುಮುಪಾಗತ್ಯ ಹೇ ಗುರೋ, ಪ್ರಣಮಾಮೀತ್ಯುಕ್ತ್ವಾ ತಂ ಚುಚುಮ್ಬೇ|</para>
  <para style="p">
    <verse number="50" style="v"/>ತದಾ ಯೀಶುಸ್ತಮುವಾಚ, ಹೇ ಮಿತ್ರಂ ಕಿಮರ್ಥಮಾಗತೋಸಿ? ತದಾ ತೈರಾಗತ್ಯ ಯೀಶುರಾಕ್ರಮ್ಯ ದಘ್ರೇ|</para>
  <para style="p">
    <verse number="51" style="v"/>ತತೋ ಯೀಶೋಃ ಸಙ್ಗಿನಾಮೇಕಃ ಕರಂ ಪ್ರಸಾರ್ಯ್ಯ ಕೋಷಾದಸಿಂ ಬಹಿಷ್ಕೃತ್ಯ ಮಹಾಯಾಜಕಸ್ಯ ದಾಸಮೇಕಮಾಹತ್ಯ ತಸ್ಯ ಕರ್ಣಂ ಚಿಚ್ಛೇದ|</para>
  <para style="p">
    <verse number="52" style="v"/>ತತೋ ಯೀಶುಸ್ತಂ ಜಗಾದ, ಖಡ್ಗಂ ಸ್ವಸ್ಥಾನೇे ನಿಧೇಹಿ ಯತೋ ಯೇ ಯೇ ಜನಾ ಅಸಿಂ ಧಾರಯನ್ತಿ, ತಏವಾಸಿನಾ ವಿನಶ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="53" style="v"/>ಅಪರಂ ಪಿತಾ ಯಥಾ ಮದನ್ತಿಕಂ ಸ್ವರ್ಗೀಯದೂತಾನಾಂ ದ್ವಾದಶವಾಹಿನೀತೋಽಧಿಕಂ ಪ್ರಹಿಣುಯಾತ್ ಮಯಾ ತಮುದ್ದಿಶ್ಯೇದಾನೀಮೇವ ತಥಾ ಪ್ರಾರ್ಥಯಿತುಂ ನ ಶಕ್ಯತೇ, ತ್ವಯಾ ಕಿಮಿತ್ಥಂ ಜ್ಞಾಯತೇ?</para>
  <para style="p">
    <verse number="54" style="v"/>ತಥಾ ಸತೀತ್ಥಂ ಘಟಿಷ್ಯತೇ ಧರ್ಮ್ಮಪುಸ್ತಕಸ್ಯ ಯದಿದಂ ವಾಕ್ಯಂ ತತ್ ಕಥಂ ಸಿಧ್ಯೇತ್?</para>
  <para style="p">
    <verse number="55" style="v"/>ತದಾನೀಂ ಯೀಶು ರ್ಜನನಿವಹಂ ಜಗಾದ, ಯೂಯಂ ಖಡ್ಗಯಷ್ಟೀನ್ ಆದಾಯ ಮಾಂ ಕಿಂ ಚೌರಂ ಧರ್ತ್ತುಮಾಯಾತಾಃ? ಅಹಂ ಪ್ರತ್ಯಹಂ ಯುಷ್ಮಾಭಿಃ ಸಾಕಮುಪವಿಶ್ಯ ಸಮುಪಾದಿಶಂ, ತದಾ ಮಾಂ ನಾಧರತ;</para>
  <para style="p">
    <verse number="56" style="v"/>ಕಿನ್ತು ಭವಿಷ್ಯದ್ವಾದಿನಾಂ ವಾಕ್ಯಾನಾಂ ಸಂಸಿದ್ಧಯೇ ಸರ್ವ್ವಮೇತದಭೂತ್| ತದಾ ಸರ್ವ್ವೇ ಶಿಷ್ಯಾಸ್ತಂ ವಿಹಾಯ ಪಲಾಯನ್ತ|</para>
  <para style="p">
    <verse number="57" style="v"/>ಅನನ್ತರಂ ತೇ ಮನುಜಾ ಯೀಶುಂ ಧೃತ್ವಾ ಯತ್ರಾಧ್ಯಾಪಕಪ್ರಾಞ್ಚಃ ಪರಿಷದಂ ಕುರ್ವ್ವನ್ತ ಉಪಾವಿಶನ್ ತತ್ರ ಕಿಯಫಾನಾाಮಕಮಹಾಯಾಜಕಸ್ಯಾನ್ತಿಕಂ ನಿನ್ಯುಃ|</para>
  <para style="p">
    <verse number="58" style="v"/>ಕಿನ್ತು ಶೇಷೇ ಕಿಂ ಭವಿಷ್ಯತೀತಿ ವೇತ್ತುಂ ಪಿತರೋ ದೂರೇ ತತ್ಪಶ್ಚಾದ್ ವ್ರಜಿತ್ವಾ ಮಹಾಯಾಜಕಸ್ಯಾಟ್ಟಾಲಿಕಾಂ ಪ್ರವಿಶ್ಯ ದಾಸೈಃ ಸಹಿತ ಉಪಾವಿಶತ್|</para>
  <para style="p">
    <verse number="59" style="v"/>ತದಾನೀಂ ಪ್ರಧಾನಯಾಜಕಪ್ರಾಚೀನಮನ್ತ್ರಿಣಃ ಸರ್ವ್ವೇ ಯೀಶುಂ ಹನ್ತುಂ ಮೃಷಾಸಾಕ್ಷ್ಯಮ್ ಅಲಿಪ್ಸನ್ತ,</para>
  <para style="p">
    <verse number="60" style="v"/>ಕಿನ್ತು ನ ಲೇಭಿರೇ| ಅನೇಕೇಷು ಮೃಷಾಸಾಕ್ಷಿಷ್ವಾಗತೇಷ್ವಪಿ ತನ್ನ ಪ್ರಾಪುಃ|</para>
  <para style="p">
    <verse number="61" style="v"/>ಶೇಷೇ ದ್ವೌ ಮೃಷಾಸಾಕ್ಷಿಣಾವಾಗತ್ಯ ಜಗದತುಃ, ಪುಮಾನಯಮಕಥಯತ್, ಅಹಮೀಶ್ವರಮನ್ದಿರಂ ಭಂಕ್ತ್ವಾ ದಿನತ್ರಯಮಧ್ಯೇ ತನ್ನಿರ್ಮ್ಮಾತುಂ ಶಕ್ನೋಮಿ|</para>
  <para style="p">
    <verse number="62" style="v"/>ತದಾ ಮಹಾಯಾಜಕ ಉತ್ಥಾಯ ಯೀಶುಮ್ ಅವಾದೀತ್| ತ್ವಂ ಕಿಮಪಿ ನ ಪ್ರತಿವದಸಿ? ತ್ವಾಮಧಿ ಕಿಮೇತೇ ಸಾಕ್ಷ್ಯಂ ವದನ್ತಿ?</para>
  <para style="p">
    <verse number="63" style="v"/>ಕಿನ್ತು ಯೀಶು ರ್ಮೌನೀಭೂಯ ತಸ್ಯೌ| ತತೋ ಮಹಾಯಾಜಕ ಉಕ್ತವಾನ್, ತ್ವಾಮ್ ಅಮರೇಶ್ವರನಾಮ್ನಾ ಶಪಯಾಮಿ, ತ್ವಮೀಶ್ವರಸ್ಯ ಪುತ್ರೋಽಭಿಷಿಕ್ತೋ ಭವಸಿ ನವೇತಿ ವದ|</para>
  <para style="p">
    <verse number="64" style="v"/>ಯೀಶುಃ ಪ್ರತ್ಯವದತ್, ತ್ವಂ ಸತ್ಯಮುಕ್ತವಾನ್; ಅಹಂ ಯುಷ್ಮಾನ್ ತಥ್ಯಂ ವದಾಮಿ, ಇತಃಪರಂ ಮನುಜಸುತಂ ಸರ್ವ್ವಶಕ್ತಿಮತೋ ದಕ್ಷಿಣಪಾರ್ಶ್ವೇ ಸ್ಥಾತುಂ ಗಗಣಸ್ಥಂ ಜಲಧರಾನಾರುಹ್ಯಾಯಾನ್ತಂ ವೀಕ್ಷಧ್ವೇ|</para>
  <para style="p">
    <verse number="65" style="v"/>ತದಾ ಮಹಾಯಾಜಕೋ ನಿಜವಸನಂ ಛಿತ್ತ್ವಾ ಜಗಾದ, ಏಷ ಈಶ್ವರಂ ನಿನ್ದಿತವಾನ್, ಅಸ್ಮಾಕಮಪರಸಾಕ್ಷ್ಯೇಣ ಕಿಂ ಪ್ರಯೋಜನಂ? ಪಶ್ಯತ, ಯೂಯಮೇವಾಸ್ಯಾಸ್ಯಾದ್ ಈಶ್ವರನಿನ್ದಾಂ ಶ್ರುತವನ್ತಃ,</para>
  <para style="p">
    <verse number="66" style="v"/>ಯುಷ್ಮಾಭಿಃ ಕಿಂ ವಿವಿಚ್ಯತೇ? ತೇ ಪ್ರತ್ಯೂಚುಃ, ವಧಾರ್ಹೋಽಯಂ|</para>
  <para style="p">
    <verse number="67" style="v"/>ತತೋ ಲೋಕೈಸ್ತದಾಸ್ಯೇ ನಿಷ್ಠೀವಿತಂ ಕೇಚಿತ್ ಪ್ರತಲಮಾಹತ್ಯ ಕೇಚಿಚ್ಚ ಚಪೇಟಮಾಹತ್ಯ ಬಭಾಷಿರೇ,</para>
  <para style="p">
    <verse number="68" style="v"/>ಹೇ ಖ್ರೀಷ್ಟ ತ್ವಾಂ ಕಶ್ಚಪೇಟಮಾಹತವಾನ್? ಇತಿ ಗಣಯಿತ್ವಾ ವದಾಸ್ಮಾನ್|</para>
  <para style="p">
    <verse number="69" style="v"/>ಪಿತರೋ ಬಹಿರಙ್ಗನ ಉಪವಿಶತಿ, ತದಾನೀಮೇಕಾ ದಾಸೀ ತಮುಪಾಗತ್ಯ ಬಭಾಷೇ, ತ್ವಂ ಗಾಲೀಲೀಯಯೀಶೋಃ ಸಹಚರಏಕಃ|</para>
  <para style="p">
    <verse number="70" style="v"/>ಕಿನ್ತು ಸ ಸರ್ವ್ವೇಷಾಂ ಸಮಕ್ಷಮ್ ಅನಙ್ಗೀಕೃತ್ಯಾವಾದೀತ್, ತ್ವಯಾ ಯದುಚ್ಯತೇ, ತದರ್ಥಮಹಂ ನ ವೇದ್ಮಿ|</para>
  <para style="p">
    <verse number="71" style="v"/>ತದಾ ತಸ್ಮಿನ್ ಬಹಿರ್ದ್ವಾರಂ ಗತೇ ಽನ್ಯಾ ದಾಸೀ ತಂ ನಿರೀಕ್ಷ್ಯ ತತ್ರತ್ಯಜನಾನವದತ್, ಅಯಮಪಿ ನಾಸರತೀಯಯೀಶುನಾ ಸಾರ್ದ್ಧಮ್ ಆಸೀತ್|</para>
  <para style="p">
    <verse number="72" style="v"/>ತತಃ ಸ ಶಪಥೇನ ಪುನರನಙ್ಗೀಕೃತ್ಯ ಕಥಿತವಾನ್, ತಂ ನರಂ ನ ಪರಿಚಿನೋಮಿ|</para>
  <para style="p">
    <verse number="73" style="v"/>ಕ್ಷಣಾತ್ ಪರಂ ತಿಷ್ಠನ್ತೋ ಜನಾ ಏತ್ಯ ಪಿತರಮ್ ಅವದನ್, ತ್ವಮವಶ್ಯಂ ತೇಷಾಮೇಕ ಇತಿ ತ್ವದುಚ್ಚಾರಣಮೇವ ದ್ಯೋತಯತಿ|</para>
  <para style="p">
    <verse number="74" style="v"/>ಕಿನ್ತು ಸೋಽಭಿಶಪ್ಯ ಕಥಿತವಾನ್, ತಂ ಜನಂ ನಾಹಂ ಪರಿಚಿನೋಮಿ, ತದಾ ಸಪದಿ ಕುಕ್ಕುಟೋ ರುರಾವ|</para>
  <para style="p">
    <verse number="75" style="v"/>ಕುಕ್ಕುಟರವಾತ್ ಪ್ರಾಕ್ ತ್ವಂ ಮಾಂ ತ್ರಿರಪಾಹ್ನೋಷ್ಯಸೇ, ಯೈಷಾ ವಾಗ್ ಯೀಶುನಾವಾದಿ ತಾಂ ಪಿತರಃ ಸಂಸ್ಮೃತ್ಯ ಬಹಿರಿತ್ವಾ ಖೇದಾದ್ ಭೃಶಂ ಚಕ್ರನ್ದ|</para>
  <chapter number="27" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಪ್ರಭಾತೇ ಜಾತೇ ಪ್ರಧಾನಯಾಜಕಲೋಕಪ್ರಾಚೀನಾ ಯೀಶುಂ ಹನ್ತುಂ ತತ್ಪ್ರತಿಕೂಲಂ ಮನ್ತ್ರಯಿತ್ವಾ</para>
  <para style="p">
    <verse number="2" style="v"/>ತಂ ಬದ್ವ್ವಾ ನೀತ್ವಾ ಪನ್ತೀಯಪೀಲಾತಾಖ್ಯಾಧಿಪೇ ಸಮರ್ಪಯಾಮಾಸುಃ|</para>
  <para style="p">
    <verse number="3" style="v"/>ತತೋ ಯೀಶೋಃ ಪರಕರೇವ್ವರ್ಪಯಿತಾ ಯಿಹೂದಾಸ್ತತ್ಪ್ರಾಣಾದಣ್ಡಾಜ್ಞಾಂ ವಿದಿತ್ವಾ ಸನ್ತಪ್ತಮನಾಃ ಪ್ರಧಾನಯಾಜಕಲೋಕಪ್ರಾಚೀನಾನಾಂ ಸಮಕ್ಷಂ ತಾಸ್ತ್ರೀಂಶನ್ಮುದ್ರಾಃ ಪ್ರತಿದಾಯಾವಾದೀತ್,</para>
  <para style="p">
    <verse number="4" style="v"/>ಏತನ್ನಿರಾಗೋನರಪ್ರಾಣಪರಕರಾರ್ಪಣಾತ್ ಕಲುಷಂ ಕೃತವಾನಹಂ| ತದಾ ತ ಉದಿತವನ್ತಃ, ತೇನಾಸ್ಮಾಕಂ ಕಿಂ? ತ್ವಯಾ ತದ್ ಬುಧ್ಯತಾಮ್|</para>
  <para style="p">
    <verse number="5" style="v"/>ತತೋ ಯಿಹೂದಾ ಮನ್ದಿರಮಧ್ಯೇ ತಾ ಮುದ್ರಾ ನಿಕ್ಷಿಪ್ಯ ಪ್ರಸ್ಥಿತವಾನ್ ಇತ್ವಾ ಚ ಸ್ವಯಮಾತ್ಮಾನಮುದ್ಬಬನ್ಧ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಪಶ್ಚಾತ್ ಪ್ರಧಾನಯಾಜಕಾಸ್ತಾ ಮುದ್ರಾ ಆದಾಯ ಕಥಿತವನ್ತಃ, ಏತಾ ಮುದ್ರಾಃ ಶೋಣಿತಮೂಲ್ಯಂ ತಸ್ಮಾದ್ ಭಾಣ್ಡಾಗಾರೇ ನ ನಿಧಾತವ್ಯಾಃ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅನನ್ತರಂ ತೇ ಮನ್ತ್ರಯಿತ್ವಾ ವಿದೇಶಿನಾಂ ಶ್ಮಶಾನಸ್ಥಾನಾಯ ತಾಭಿಃ ಕುಲಾಲಸ್ಯ ಕ್ಷೇತ್ರಮಕ್ರೀಣನ್|</para>
  <para style="p">
    <verse number="8" style="v"/>ಅತೋಽದ್ಯಾಪಿ ತತ್ಸ್ಥಾನಂ ರಕ್ತಕ್ಷೇತ್ರಂ ವದನ್ತಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಇತ್ಥಂ ಸತಿ ಇಸ್ರಾಯೇಲೀಯಸನ್ತಾನೈ ರ್ಯಸ್ಯ ಮೂಲ್ಯಂ ನಿರುಪಿತಂ, ತಸ್ಯ ತ್ರಿಂಶನ್ಮುದ್ರಾಮಾನಂ ಮೂಲ್ಯಂ</para>
  <para style="p">
    <verse number="10" style="v"/>ಮಾಂ ಪ್ರತಿ ಪರಮೇಶ್ವರಸ್ಯಾದೇಶಾತ್ ತೇಭ್ಯ ಆದೀಯತ, ತೇನ ಚ ಕುಲಾಲಸ್ಯ ಕ್ಷೇತ್ರಂ ಕ್ರೀತಮಿತಿ ಯದ್ವಚನಂ ಯಿರಿಮಿಯಭವಿಷ್ಯದ್ವಾದಿನಾ ಪ್ರೋಕ್ತಂ ತತ್ ತದಾಸಿಧ್ಯತ್|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅನನ್ತರಂ ಯೀಶೌ ತದಧಿಪತೇಃ ಸಮ್ಮುಖ ಉಪತಿಷ್ಠತಿ ಸ ತಂ ಪಪ್ರಚ್ಛ, ತ್ವಂ ಕಿಂ ಯಿಹೂದೀಯಾನಾಂ ರಾಜಾ? ತದಾ ಯೀಶುಸ್ತಮವದತ್, ತ್ವಂ ಸತ್ಯಮುಕ್ತವಾನ್|</para>
  <para style="p">
    <verse number="12" style="v"/>ಕಿನ್ತು ಪ್ರಧಾನಯಾಜಕಪ್ರಾಚೀನೈರಭಿಯುಕ್ತೇನ ತೇನ ಕಿಮಪಿ ನ ಪ್ರತ್ಯವಾದಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ತತಃ ಪೀಲಾತೇನ ಸ ಉದಿತಃ, ಇಮೇ ತ್ವತ್ಪ್ರತಿಕೂಲತಃ ಕತಿ ಕತಿ ಸಾಕ್ಷ್ಯಂ ದದತಿ, ತತ್ ತ್ವಂ ನ ಶೃಣೋಷಿ?</para>
  <para style="p">
    <verse number="14" style="v"/>ತಥಾಪಿ ಸ ತೇಷಾಮೇಕಸ್ಯಾಪಿ ವಚಸ ಉತ್ತರಂ ನೋದಿತವಾನ್; ತೇನ ಸೋಽಧಿಪತಿ ರ್ಮಹಾಚಿತ್ರಂ ವಿದಾಮಾಸ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅನ್ಯಚ್ಚ ತನ್ಮಹಕಾಲೇಽಧಿಪತೇರೇತಾದೃಶೀ ರಾತಿರಾಸೀತ್, ಪ್ರಜಾ ಯಂ ಕಞ್ಚನ ಬನ್ಧಿನಂ ಯಾಚನ್ತೇ, ತಮೇವ ಸ ಮೋಚಯತೀತಿ|</para>
  <para style="p">
    <verse number="16" style="v"/>ತದಾನೀಂ ಬರಬ್ಬಾನಾಮಾ ಕಶ್ಚಿತ್ ಖ್ಯಾತಬನ್ಧ್ಯಾಸೀತ್|</para>
  <para style="p">
    <verse number="17" style="v"/>ತತಃ ಪೀಲಾತಸ್ತತ್ರ ಮಿಲಿತಾನ್ ಲೋಕಾನ್ ಅಪೃಚ್ಛತ್, ಏಷ ಬರಬ್ಬಾ ಬನ್ಧೀ ಖ್ರೀಷ್ಟವಿಖ್ಯಾತೋ ಯೀಶುಶ್ಚೈತಯೋಃ ಕಂ ಮೋಚಯಿಷ್ಯಾಮಿ? ಯುಷ್ಮಾಕಂ ಕಿಮೀಪ್ಸಿತಂ?</para>
  <para style="p">
    <verse number="18" style="v"/>ತೈರೀರ್ಷ್ಯಯಾ ಸ ಸಮರ್ಪಿತ ಇತಿ ಸ ಜ್ಞಾತವಾನ್|</para>
  <para style="p">
    <verse number="19" style="v"/>ಅಪರಂ ವಿಚಾರಾಸನೋಪವೇಶನಕಾಲೇ ಪೀಲಾತಸ್ಯ ಪತ್ನೀ ಭೃತ್ಯಂ ಪ್ರಹಿತ್ಯ ತಸ್ಮೈ ಕಥಯಾಮಾಸ, ತಂ ಧಾರ್ಮ್ಮಿಕಮನುಜಂ ಪ್ರತಿ ತ್ವಯಾ ಕಿಮಪಿ ನ ಕರ್ತ್ತವ್ಯಂ; ಯಸ್ಮಾತ್ ತತ್ಕೃತೇಽದ್ಯಾಹಂ ಸ್ವಪ್ನೇ ಪ್ರಭೂತಕಷ್ಟಮಲಭೇ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಅನನ್ತರಂ ಪ್ರಧಾನಯಾಜಕಪ್ರಾಚೀನಾ ಬರಬ್ಬಾಂ ಯಾಚಿತ್ವಾದಾತುಂ ಯೀಶುಞ್ಚ ಹನ್ತುಂ ಸಕಲಲೋಕಾನ್ ಪ್ರಾವರ್ತ್ತಯನ್|</para>
  <para style="p">
    <verse number="21" style="v"/>ತತೋಽಧಿಪತಿಸ್ತಾನ್ ಪೃಷ್ಟವಾನ್, ಏತಯೋಃ ಕಮಹಂ ಮೋಚಯಿಷ್ಯಾಮಿ? ಯುಷ್ಮಾಕಂ ಕೇಚ್ಛಾ? ತೇ ಪ್ರೋಚು ರ್ಬರಬ್ಬಾಂ|</para>
  <para style="p">
    <verse number="22" style="v"/>ತದಾ ಪೀಲಾತಃ ಪಪ್ರಚ್ಛ, ತರ್ಹಿ ಯಂ ಖ್ರೀಷ್ಟಂ ವದನ್ತಿ, ತಂ ಯೀಶುಂ ಕಿಂ ಕರಿಷ್ಯಾಮಿ? ಸರ್ವ್ವೇ ಕಥಯಾಮಾಸುಃ, ಸ ಕ್ರುಶೇನ ವಿಧ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="23" style="v"/>ತತೋಽಧಿಪತಿರವಾದೀತ್, ಕುತಃ? ಕಿಂ ತೇನಾಪರಾದ್ಧಂ? ಕಿನ್ತು ತೇ ಪುನರುಚೈ ರ್ಜಗದುಃ, ಸ ಕ್ರುಶೇನ ವಿಧ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="24" style="v"/>ತದಾ ನಿಜವಾಕ್ಯಮಗ್ರಾಹ್ಯಮಭೂತ್, ಕಲಹಶ್ಚಾಪ್ಯಭೂತ್, ಪೀಲಾತ ಇತಿ ವಿಲೋಕ್ಯ ಲೋಕಾನಾಂ ಸಮಕ್ಷಂ ತೋಯಮಾದಾಯ ಕರೌ ಪ್ರಕ್ಷಾಲ್ಯಾವೋಚತ್, ಏತಸ್ಯ ಧಾರ್ಮ್ಮಿಕಮನುಷ್ಯಸ್ಯ ಶೋಣಿತಪಾತೇ ನಿರ್ದೋಷೋಽಹಂ, ಯುಷ್ಮಾಭಿರೇವ ತದ್ ಬುಧ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="25" style="v"/>ತದಾ ಸರ್ವ್ವಾಃ ಪ್ರಜಾಃ ಪ್ರತ್ಯವೋಚನ್, ತಸ್ಯ ಶೋಣಿತಪಾತಾಪರಾಧೋಽಸ್ಮಾಕಮ್ ಅಸ್ಮತ್ಸನ್ತಾನಾನಾಞ್ಚೋಪರಿ ಭವತು|</para>
  <para style="p">
    <verse number="26" style="v"/>ತತಃ ಸ ತೇಷಾಂ ಸಮೀಪೇ ಬರಬ್ಬಾಂ ಮೋಚಯಾಮಾಸ ಯೀಶುನ್ತು ಕಷಾಭಿರಾಹತ್ಯ ಕ್ರುಶೇನ ವೇಧಿತುಂ ಸಮರ್ಪಯಾಮಾಸ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಅನನ್ತರಮ್ ಅಧಿಪತೇಃ ಸೇನಾ ಅಧಿಪತೇ ರ್ಗೃಹಂ ಯೀಶುಮಾನೀಯ ತಸ್ಯ ಸಮೀಪೇ ಸೇನಾಸಮೂಹಂ ಸಂಜಗೃಹುಃ|</para>
  <para style="p">
    <verse number="28" style="v"/>ತತಸ್ತೇ ತಸ್ಯ ವಸನಂ ಮೋಚಯಿತ್ವಾ ಕೃಷ್ಣಲೋಹಿತವರ್ಣವಸನಂ ಪರಿಧಾಪಯಾಮಾಸುಃ</para>
  <para style="p">
    <verse number="29" style="v"/>ಕಣ್ಟಕಾನಾಂ ಮುಕುಟಂ ನಿರ್ಮ್ಮಾಯ ತಚ್ಛಿರಸಿ ದದುಃ, ತಸ್ಯ ದಕ್ಷಿಣಕರೇ ವೇತ್ರಮೇಕಂ ದತ್ತ್ವಾ ತಸ್ಯ ಸಮ್ಮುಖೇ ಜಾನೂನಿ ಪಾತಯಿತ್ವಾ, ಹೇ ಯಿಹೂದೀಯಾನಾಂ ರಾಜನ್, ತುಭ್ಯಂ ನಮ ಇತ್ಯುಕ್ತ್ವಾ ತಂ ತಿರಶ್ಚಕ್ರುಃ,</para>
  <para style="p">
    <verse number="30" style="v"/>ತತಸ್ತಸ್ಯ ಗಾತ್ರೇ ನಿಷ್ಠೀವಂ ದತ್ವಾ ತೇನ ವೇತ್ರೇಣ ಶಿರ ಆಜಘ್ನುಃ|</para>
  <para style="p">
    <verse number="31" style="v"/>ಇತ್ಥಂ ತಂ ತಿರಸ್ಕೃತ್ಯ ತದ್ ವಸನಂ ಮೋಚಯಿತ್ವಾ ಪುನರ್ನಿಜವಸನಂ ಪರಿಧಾಪಯಾಞ್ಚಕ್ರುಃ, ತಂ ಕ್ರುಶೇನ ವೇಧಿತುಂ ನೀತವನ್ತಃ|</para>
  <para style="p">
    <verse number="32" style="v"/>ಪಶ್ಚಾತ್ತೇ ಬಹಿರ್ಭೂಯ ಕುರೀಣೀಯಂ ಶಿಮೋನ್ನಾಮಕಮೇಕಂ ವಿಲೋಕ್ಯ ಕ್ರುಶಂ ವೋಢುಂ ತಮಾದದಿರೇ|</para>
  <para style="p">
    <verse number="33" style="v"/>ಅನನ್ತರಂ ಗುಲ್ಗಲ್ತಾಮ್ ಅರ್ಥಾತ್ ಶಿರಸ್ಕಪಾಲನಾಮಕಸ್ಥಾನಮು ಪಸ್ಥಾಯ ತೇ ಯೀಶವೇ ಪಿತ್ತಮಿಶ್ರಿತಾಮ್ಲರಸಂ ಪಾತುಂ ದದುಃ,</para>
  <para style="p">
    <verse number="34" style="v"/>ಕಿನ್ತು ಸ ತಮಾಸ್ವಾದ್ಯ ನ ಪಪೌ|</para>
  <para style="p">
    <verse number="35" style="v"/>ತದಾನೀಂ ತೇ ತಂ ಕ್ರುಶೇನ ಸಂವಿಧ್ಯ ತಸ್ಯ ವಸನಾನಿ ಗುಟಿಕಾಪಾತೇನ ವಿಭಜ್ಯ ಜಗೃಹುಃ, ತಸ್ಮಾತ್, ವಿಭಜನ್ತೇಽಧರೀಯಂ ಮೇ ತೇ ಮನುಷ್ಯಾಃ ಪರಸ್ಪರಂ| ಮದುತ್ತರೀಯವಸ್ತ್ರಾರ್ಥಂ ಗುಟಿಕಾಂ ಪಾತಯನ್ತಿ ಚ|| ಯದೇತದ್ವಚನಂ ಭವಿಷ್ಯದ್ವಾದಿಭಿರುಕ್ತಮಾಸೀತ್, ತದಾ ತದ್ ಅಸಿಧ್ಯತ್,</para>
  <para style="p">
    <verse number="36" style="v"/>ಪಶ್ಚಾತ್ ತೇ ತತ್ರೋಪವಿಶ್ಯ ತದ್ರಕ್ಷಣಕರ್ವ್ವಣಿ ನಿಯುಕ್ತಾಸ್ತಸ್ಥುಃ|</para>
  <para style="p">
    <verse number="37" style="v"/>ಅಪರಮ್ ಏಷ ಯಿಹೂದೀಯಾನಾಂ ರಾಜಾ ಯೀಶುರಿತ್ಯಪವಾದಲಿಪಿಪತ್ರಂ ತಚ್ಛಿರಸ ಊರ್ದ್ವ್ವೇ ಯೋಜಯಾಮಾಸುಃ|</para>
  <para style="p">
    <verse number="38" style="v"/>ತತಸ್ತಸ್ಯ ವಾಮೇ ದಕ್ಷಿಣೇ ಚ ದ್ವೌ ಚೈರೌ ತೇನ ಸಾಕಂ ಕ್ರುಶೇನ ವಿವಿಧುಃ|</para>
  <para style="p">
    <verse number="39" style="v"/>ತದಾ ಪಾನ್ಥಾ ನಿಜಶಿರೋ ಲಾಡಯಿತ್ವಾ ತಂ ನಿನ್ದನ್ತೋ ಜಗದುಃ,</para>
  <para style="p">
    <verse number="40" style="v"/>ಹೇ ಈಶ್ವರಮನ್ದಿರಭಞ್ಜಕ ದಿನತ್ರಯೇ ತನ್ನಿರ್ಮ್ಮಾತಃ ಸ್ವಂ ರಕ್ಷ, ಚೇತ್ತ್ವಮೀಶ್ವರಸುತಸ್ತರ್ಹಿ ಕ್ರುಶಾದವರೋಹ|</para>
  <para style="p">
    <verse number="41" style="v"/>ಪ್ರಧಾನಯಾಜಕಾಧ್ಯಾಪಕಪ್ರಾಚೀನಾಶ್ಚ ತಥಾ ತಿರಸ್ಕೃತ್ಯ ಜಗದುಃ,</para>
  <para style="p">
    <verse number="42" style="v"/>ಸೋಽನ್ಯಜನಾನಾವತ್, ಕಿನ್ತು ಸ್ವಮವಿತುಂ ನ ಶಕ್ನೋತಿ| ಯದೀಸ್ರಾಯೇಲೋ ರಾಜಾ ಭವೇತ್, ತರ್ಹೀದಾನೀಮೇವ ಕ್ರುಶಾದವರೋಹತು, ತೇನ ತಂ ವಯಂ ಪ್ರತ್ಯೇಷ್ಯಾಮಃ|</para>
  <para style="p">
    <verse number="43" style="v"/>ಸ ಈಶ್ವರೇ ಪ್ರತ್ಯಾಶಾಮಕರೋತ್, ಯದೀಶ್ವರಸ್ತಸ್ಮಿನ್ ಸನ್ತುಷ್ಟಸ್ತರ್ಹೀದಾನೀಮೇವ ತಮವೇತ್, ಯತಃ ಸ ಉಕ್ತವಾನ್ ಅಹಮೀಶ್ವರಸುತಃ|</para>
  <para style="p">
    <verse number="44" style="v"/>ಯೌ ಸ್ತೇನೌ ಸಾಕಂ ತೇನ ಕ್ರುಶೇನ ವಿದ್ಧೌ ತೌ ತದ್ವದೇವ ತಂ ನಿನಿನ್ದತುಃ|</para>
  <para style="p">
    <verse number="45" style="v"/>ತದಾ ದ್ವಿತೀಯಯಾಮಾತ್ ತೃತೀಯಯಾಮಂ ಯಾವತ್ ಸರ್ವ್ವದೇಶೇ ತಮಿರಂ ಬಭೂವ,</para>
  <para style="p">
    <verse number="46" style="v"/>ತೃತೀಯಯಾಮೇ "ಏಲೀ ಏಲೀ ಲಾಮಾ ಶಿವಕ್ತನೀ", ಅರ್ಥಾತ್ ಮದೀಶ್ವರ ಮದೀಶ್ವರ ಕುತೋ ಮಾಮತ್ಯಾಕ್ಷೀಃ? ಯೀಶುರುಚ್ಚೈರಿತಿ ಜಗಾದ|</para>
  <para style="p">
    <verse number="47" style="v"/>ತದಾ ತತ್ರ ಸ್ಥಿತಾಃ ಕೇಚಿತ್ ತತ್ ಶ್ರುತ್ವಾ ಬಭಾಷಿರೇ, ಅಯಮ್ ಏಲಿಯಮಾಹೂಯತಿ|</para>
  <para style="p">
    <verse number="48" style="v"/>ತೇಷಾಂ ಮಧ್ಯಾದ್ ಏಕಃ ಶೀಘ್ರಂ ಗತ್ವಾ ಸ್ಪಞ್ಜಂ ಗೃಹೀತ್ವಾ ತತ್ರಾಮ್ಲರಸಂ ದತ್ತ್ವಾ ನಲೇನ ಪಾತುಂ ತಸ್ಮೈ ದದೌ|</para>
  <para style="p">
    <verse number="49" style="v"/>ಇತರೇಽಕಥಯನ್ ತಿಷ್ಠತ, ತಂ ರಕ್ಷಿತುಮ್ ಏಲಿಯ ಆಯಾತಿ ನವೇತಿ ಪಶ್ಯಾಮಃ|</para>
  <para style="p">
    <verse number="50" style="v"/>ಯೀಶುಃ ಪುನರುಚೈರಾಹೂಯ ಪ್ರಾಣಾನ್ ಜಹೌ|</para>
  <para style="p">
    <verse number="51" style="v"/>ತತೋ ಮನ್ದಿರಸ್ಯ ವಿಚ್ಛೇದವಸನಮ್ ಊರ್ದ್ವ್ವಾದಧೋ ಯಾವತ್ ಛಿದ್ಯಮಾನಂ ದ್ವಿಧಾಭವತ್,</para>
  <para style="p">
    <verse number="52" style="v"/>ಭೂಮಿಶ್ಚಕಮ್ಪೇ ಭೂಧರೋವ್ಯದೀರ್ಯ್ಯತ ಚ| ಶ್ಮಶಾನೇ ಮುಕ್ತೇ ಭೂರಿಪುಣ್ಯವತಾಂ ಸುಪ್ತದೇಹಾ ಉದತಿಷ್ಠನ್,</para>
  <para style="p">
    <verse number="53" style="v"/>ಶ್ಮಶಾನಾದ್ ವಹಿರ್ಭೂಯ ತದುತ್ಥಾನಾತ್ ಪರಂ ಪುಣ್ಯಪುರಂ ಗತ್ವಾ ಬಹುಜನಾನ್ ದರ್ಶಯಾಮಾಸುಃ|</para>
  <para style="p">
    <verse number="54" style="v"/>ಯೀಶುರಕ್ಷಣಾಯ ನಿಯುಕ್ತಃ ಶತಸೇನಾಪತಿಸ್ತತ್ಸಙ್ಗಿನಶ್ಚ ತಾದೃಶೀಂ ಭೂಕಮ್ಪಾದಿಘಟನಾಂ ದೃಷ್ಟ್ವಾ ಭೀತಾ ಅವದನ್, ಏಷ ಈಶ್ವರಪುತ್ರೋ ಭವತಿ|</para>
  <para style="p">
    <verse number="55" style="v"/>ಯಾ ಬಹುಯೋಷಿತೋ ಯೀಶುಂ ಸೇವಮಾನಾ ಗಾಲೀಲಸ್ತತ್ಪಶ್ಚಾದಾಗತಾಸ್ತಾಸಾಂ ಮಧ್ಯೇ</para>
  <para style="p">
    <verse number="56" style="v"/>ಮಗ್ದಲೀನೀ ಮರಿಯಮ್ ಯಾಕೂಬ್ಯೋಶ್ಯೋ ರ್ಮಾತಾ ಯಾ ಮರಿಯಮ್ ಸಿಬದಿಯಪುತ್ರಯೋ ರ್ಮಾತಾ ಚ ಯೋಷಿತ ಏತಾ ದೂರೇ ತಿಷ್ಠನ್ತ್ಯೋ ದದೃಶುಃ|</para>
  <para style="p">
    <verse number="57" style="v"/>ಸನ್ಧ್ಯಾಯಾಂ ಸತ್ಯಮ್ ಅರಿಮಥಿಯಾನಗರಸ್ಯ ಯೂಷಫ್ನಾಮಾ ಧನೀ ಮನುಜೋ ಯೀಶೋಃ ಶಿಷ್ಯತ್ವಾತ್</para>
  <para style="p">
    <verse number="58" style="v"/>ಪೀಲಾತಸ್ಯ ಸಮೀಪಂ ಗತ್ವಾ ಯೀಶೋಃ ಕಾಯಂ ಯಯಾಚೇ, ತೇನ ಪೀಲಾತಃ ಕಾಯಂ ದಾತುಮ್ ಆದಿದೇಶ|</para>
  <para style="p">
    <verse number="59" style="v"/>ಯೂಷಫ್ ತತ್ಕಾಯಂ ನೀತ್ವಾ ಶುಚಿವಸ್ತ್ರೇಣಾಚ್ಛಾದ್ಯ</para>
  <para style="p">
    <verse number="60" style="v"/>ಸ್ವಾರ್ಥಂ ಶೈಲೇ ಯತ್ ಶ್ಮಶಾನಂ ಚಖಾನ, ತನ್ಮಧ್ಯೇ ತತ್ಕಾಯಂ ನಿಧಾಯ ತಸ್ಯ ದ್ವಾರಿ ವೃಹತ್ಪಾಷಾಣಂ ದದೌ|</para>
  <para style="p">
    <verse number="61" style="v"/>ಕಿನ್ತು ಮಗ್ದಲೀನೀ ಮರಿಯಮ್ ಅನ್ಯಮರಿಯಮ್ ಏತೇ ಸ್ತ್ರಿಯೌ ತತ್ರ ಶ್ಮಶಾನಸಮ್ಮುಖ ಉಪವಿವಿಶತುಃ|</para>
  <para style="p">
    <verse number="62" style="v"/>ತದನನ್ತರಂ ನಿಸ್ತಾರೋತ್ಸವಸ್ಯಾಯೋಜನದಿನಾತ್ ಪರೇಽಹನಿ ಪ್ರಧಾನಯಾಜಕಾಃ ಫಿರೂಶಿನಶ್ಚ ಮಿಲಿತ್ವಾ ಪೀಲಾತಮುಪಾಗತ್ಯಾಕಥಯನ್,</para>
  <para style="p">
    <verse number="63" style="v"/>ಹೇ ಮಹೇಚ್ಛ ಸ ಪ್ರತಾರಕೋ ಜೀವನ ಅಕಥಯತ್, ದಿನತ್ರಯಾತ್ ಪರಂ ಶ್ಮಶಾನಾದುತ್ಥಾಸ್ಯಾಮಿ ತದ್ವಾಕ್ಯಂ ಸ್ಮರಾಮೋ ವಯಂ;</para>
  <para style="p">
    <verse number="64" style="v"/>ತಸ್ಮಾತ್ ತೃತೀಯದಿನಂ ಯಾವತ್ ತತ್ ಶ್ಮಶಾನಂ ರಕ್ಷಿತುಮಾದಿಶತು, ನೋಚೇತ್ ತಚ್ಛಿಷ್ಯಾ ಯಾಮಿನ್ಯಾಮಾಗತ್ಯ ತಂ ಹೃತ್ವಾ ಲೋಕಾನ್ ವದಿಷ್ಯನ್ತಿ, ಸ ಶ್ಮಶಾನಾದುದತಿಷ್ಠತ್, ತಥಾ ಸತಿ ಪ್ರಥಮಭ್ರಾನ್ತೇಃ ಶೇಷೀಯಭ್ರಾನ್ತಿ ರ್ಮಹತೀ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="65" style="v"/>ತದಾ ಪೀಲಾತ ಅವಾದೀತ್, ಯುಷ್ಮಾಕಂ ಸಮೀಪೇ ರಕ್ಷಿಗಣ ಆಸ್ತೇ, ಯೂಯಂ ಗತ್ವಾ ಯಥಾ ಸಾಧ್ಯಂ ರಕ್ಷಯತ|</para>
  <para style="p">
    <verse number="66" style="v"/>ತತಸ್ತೇ ಗತ್ವಾ ತದ್ದೂाರಪಾಷಾಣಂ ಮುದ್ರಾಙ್ಕಿತಂ ಕೃತ್ವಾ ರಕ್ಷಿಗಣಂ ನಿಯೋಜ್ಯ ಶ್ಮಶಾನಂ ರಕ್ಷಯಾಮಾಸುಃ|</para>
  <chapter number="28" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ತತಃ ಪರಂ ವಿಶ್ರಾಮವಾರಸ್ಯ ಶೇಷೇ ಸಪ್ತಾಹಪ್ರಥಮದಿನಸ್ಯ ಪ್ರಭೋತೇ ಜಾತೇ ಮಗ್ದಲೀನೀ ಮರಿಯಮ್ ಅನ್ಯಮರಿಯಮ್ ಚ ಶ್ಮಶಾನಂ ದ್ರಷ್ಟುಮಾಗತಾ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತದಾ ಮಹಾನ್ ಭೂಕಮ್ಪೋಽಭವತ್; ಪರಮೇಶ್ವರೀಯದೂತಃ ಸ್ವರ್ಗಾದವರುಹ್ಯ ಶ್ಮಶಾನದ್ವಾರಾತ್ ಪಾಷಾಣಮಪಸಾರ್ಯ್ಯ ತದುಪರ್ಯ್ಯುಪವಿವೇಶ|</para>
  <para style="p">
    <verse number="3" style="v"/>ತದ್ವದನಂ ವಿದ್ಯುದ್ವತ್ ತೇಜೋಮಯಂ ವಸನಂ ಹಿಮಶುಭ್ರಞ್ಚ|</para>
  <para style="p">
    <verse number="4" style="v"/>ತದಾನೀಂ ರಕ್ಷಿಣಸ್ತದ್ಭಯಾತ್ ಕಮ್ಪಿತಾ ಮೃತವದ್ ಬಭೂವಃ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಸ ದೂತೋ ಯೋಷಿತೋ ಜಗಾದ, ಯೂಯಂ ಮಾ ಭೈಷ್ಟ, ಕ್ರುಶಹತಯೀಶುಂ ಮೃಗಯಧ್ವೇ ತದಹಂ ವೇದ್ಮಿ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಸೋಽತ್ರ ನಾಸ್ತಿ, ಯಥಾವದತ್ ತಥೋತ್ಥಿತವಾನ್; ಏತತ್ ಪ್ರಭೋಃ ಶಯನಸ್ಥಾನಂ ಪಶ್ಯತ|</para>
  <para style="p">
    <verse number="7" style="v"/>ತೂರ್ಣಂ ಗತ್ವಾ ತಚ್ಛಿಷ್ಯಾನ್ ಇತಿ ವದತ, ಸ ಶ್ಮಶಾನಾದ್ ಉದತಿಷ್ಠತ್, ಯುಷ್ಮಾಕಮಗ್ರೇ ಗಾಲೀಲಂ ಯಾಸ್ಯತಿ ಯೂಯಂ ತತ್ರ ತಂ ವೀಕ್ಷಿಷ್ಯಧ್ವೇ, ಪಶ್ಯತಾಹಂ ವಾರ್ತ್ತಾಮಿಮಾಂ ಯುಷ್ಮಾನವಾದಿಷಂ|</para>
  <para style="p">
    <verse number="8" style="v"/>ತತಸ್ತಾ ಭಯಾತ್ ಮಹಾನನ್ದಾಞ್ಚ ಶ್ಮಶಾನಾತ್ ತೂರ್ಣಂ ಬಹಿರ್ಭೂಯ ತಚ್ಛಿಷ್ಯಾನ್ ವಾರ್ತ್ತಾಂ ವಕ್ತುಂ ಧಾವಿತವತ್ಯಃ| ಕಿನ್ತು ಶಿಷ್ಯಾನ್ ವಾರ್ತ್ತಾಂ ವಕ್ತುಂ ಯಾನ್ತಿ, ತದಾ ಯೀಶು ರ್ದರ್ಶನಂ ದತ್ತ್ವಾ ತಾ ಜಗಾದ,</para>
  <para style="p">
    <verse number="9" style="v"/>ಯುಷ್ಮಾಕಂ ಕಲ್ಯಾಣಂ ಭೂಯಾತ್, ತತಸ್ತಾ ಆಗತ್ಯ ತತ್ಪಾದಯೋಃ ಪತಿತ್ವಾ ಪ್ರಣೇಮುಃ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯೀಶುಸ್ತಾ ಅವಾದೀತ್, ಮಾ ಬಿಭೀತ, ಯೂಯಂ ಗತ್ವಾ ಮಮ ಭ್ರಾತೃನ್ ಗಾಲೀಲಂ ಯಾತುಂ ವದತ, ತತ್ರ ತೇ ಮಾಂ ದ್ರಕ್ಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಸ್ತ್ರಿಯೋ ಗಚ್ಛನ್ತಿ, ತದಾ ರಕ್ಷಿಣಾಂ ಕೇಚಿತ್ ಪುರಂ ಗತ್ವಾ ಯದ್ಯದ್ ಘಟಿತಂ ತತ್ಸರ್ವ್ವಂ ಪ್ರಧಾನಯಾಜಕಾನ್ ಜ್ಞಾಪಿತವನ್ತಃ|</para>
  <para style="p">
    <verse number="12" style="v"/>ತೇ ಪ್ರಾಚೀನೈಃ ಸಮಂ ಸಂಸದಂ ಕೃತ್ವಾ ಮನ್ತ್ರಯನ್ತೋ ಬಹುಮುದ್ರಾಃ ಸೇನಾಭ್ಯೋ ದತ್ತ್ವಾವದನ್,</para>
  <para style="p">
    <verse number="13" style="v"/>ಅಸ್ಮಾಸು ನಿದ್ರಿತೇಷು ತಚ್ಛಿಷ್ಯಾ ಯಾಮಿನ್ಯಾಮಾಗತ್ಯ ತಂ ಹೃತ್ವಾನಯನ್, ಇತಿ ಯೂಯಂ ಪ್ರಚಾರಯತ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯದ್ಯೇತದಧಿಪತೇಃ ಶ್ರೋತ್ರಗೋಚರೀಭವೇತ್, ತರ್ಹಿ ತಂ ಬೋಧಯಿತ್ವಾ ಯುಷ್ಮಾನವಿಷ್ಯಾಮಃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತತಸ್ತೇ ಮುದ್ರಾ ಗೃಹೀತ್ವಾ ಶಿಕ್ಷಾನುರೂಪಂ ಕರ್ಮ್ಮ ಚಕ್ರುಃ, ಯಿಹೂದೀಯಾನಾಂ ಮಧ್ಯೇ ತಸ್ಯಾದ್ಯಾಪಿ ಕಿಂವದನ್ತೀ ವಿದ್ಯತೇ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಏಕಾದಶ ಶಿಷ್ಯಾ ಯೀಶುನಿರೂಪಿತಾಗಾಲೀಲಸ್ಯಾದ್ರಿಂ ಗತ್ವಾ</para>
  <para style="p">
    <verse number="17" style="v"/>ತತ್ರ ತಂ ಸಂವೀಕ್ಷ್ಯ ಪ್ರಣೇಮುಃ, ಕಿನ್ತು ಕೇಚಿತ್ ಸನ್ದಿಗ್ಧವನ್ತಃ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಯೀಶುಸ್ತೇಷಾಂ ಸಮೀಪಮಾಗತ್ಯ ವ್ಯಾಹೃತವಾನ್, ಸ್ವರ್ಗಮೇದಿನ್ಯೋಃ ಸರ್ವ್ವಾಧಿಪತಿತ್ವಭಾರೋ ಮಯ್ಯರ್ಪಿತ ಆಸ್ತೇ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಅತೋ ಯೂಯಂ ಪ್ರಯಾಯ ಸರ್ವ್ವದೇಶೀಯಾನ್ ಶಿಷ್ಯಾನ್ ಕೃತ್ವಾ ಪಿತುಃ ಪುತ್ರಸ್ಯ ಪವಿತ್ರಸ್ಯಾತ್ಮನಶ್ಚ ನಾಮ್ನಾ ತಾನವಗಾಹಯತ; ಅಹಂ ಯುಷ್ಮಾನ್ ಯದ್ಯದಾದಿಶಂ ತದಪಿ ಪಾಲಯಿತುಂ ತಾನುಪಾದಿಶತ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಪಶ್ಯತ, ಜಗದನ್ತಂ ಯಾವತ್ ಸದಾಹಂ ಯುಷ್ಮಾಭಿಃ ಸಾಕಂ ತಿಷ್ಠಾಮಿ| ಇತಿ|</para>
</usx>
