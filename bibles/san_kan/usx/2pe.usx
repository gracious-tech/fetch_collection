<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="2PE" style="id">Sanskrit Bible (NT) in Kannada Script (ಸತ್ಯವೇದಃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">2 Peter</para>
  <para style="toc1">೨ ಪಿತರಸ್ಯ ಪತ್ರಂ</para>
  <para style="toc2">೨ ಪಿತರಃ</para>
  <para style="toc3">೨ ಪಿತರಃ</para>
  <para style="mt1">೨ ಪಿತರಸ್ಯ ಪತ್ರಂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಯೇ ಜನಾ ಅಸ್ಮಾಭಿಃ ಸಾರ್ದ್ಧಮ್ ಅಸ್ತದೀಶ್ವರೇ ತ್ರಾತರಿ ಯೀಶುಖ್ರೀಷ್ಟೇ ಚ ಪುಣ್ಯಸಮ್ಬಲಿತವಿಶ್ವಾಸಧನಸ್ಯ ಸಮಾನಾಂಶಿತ್ವಂ ಪ್ರಾಪ್ತಾಸ್ತಾನ್ ಪ್ರತಿ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ದಾಸಃ ಪ್ರೇರಿತಶ್ಚ ಶಿಮೋನ್ ಪಿತರಃ ಪತ್ರಂ ಲಿಖತಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಈಶ್ವರಸ್ಯಾಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶೋಶ್ಚ ತತ್ವಜ್ಞಾನೇನ ಯುಷ್ಮಾಸ್ವನುಗ್ರಹಶಾನ್ತ್ಯೋ ರ್ಬಾಹುಲ್ಯಂ ವರ್ತ್ತತಾಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಜೀವನಾರ್ಥಮ್ ಈಶ್ವರಭಕ್ತ್ಯರ್ಥಞ್ಚ ಯದ್ಯದ್ ಆವಶ್ಯಕಂ ತತ್ ಸರ್ವ್ವಂ ಗೌರವಸದ್ಗುಣಾಭ್ಯಾಮ್ ಅಸ್ಮದಾಹ್ವಾನಕಾರಿಣಸ್ತತ್ತ್ವಜ್ಞಾನದ್ವಾರಾ ತಸ್ಯೇಶ್ವರೀಯಶಕ್ತಿರಸ್ಮಭ್ಯಂ ದತ್ತವತೀ|</para>
  <para style="p">
    <verse number="4" style="v"/>ತತ್ಸರ್ವ್ವೇಣ ಚಾಸ್ಮಭ್ಯಂ ತಾದೃಶಾ ಬಹುಮೂಲ್ಯಾ ಮಹಾಪ್ರತಿಜ್ಞಾ ದತ್ತಾ ಯಾಭಿ ರ್ಯೂಯಂ ಸಂಸಾರವ್ಯಾಪ್ತಾತ್ ಕುತ್ಸಿತಾಭಿಲಾಷಮೂಲಾತ್ ಸರ್ವ್ವನಾಶಾದ್ ರಕ್ಷಾಂ ಪ್ರಾಪ್ಯೇಶ್ವರೀಯಸ್ವಭಾವಸ್ಯಾಂಶಿನೋ ಭವಿತುಂ ಶಕ್ನುಥ|</para>
  <para style="p">
    <verse number="5" style="v"/>ತತೋ ಹೇತೋ ರ್ಯೂಯಂ ಸಮ್ಪೂರ್ಣಂ ಯತ್ನಂ ವಿಧಾಯ ವಿಶ್ವಾಸೇ ಸೌಜನ್ಯಂ ಸೌಜನ್ಯೇ ಜ್ಞಾನಂ</para>
  <para style="p">
    <verse number="6" style="v"/>ಜ್ಞಾನ ಆಯತೇನ್ದ್ರಿಯತಾಮ್ ಆಯತೇನ್ದ್ರಿಯತಾಯಾಂ ಧೈರ್ಯ್ಯಂ ಧೈರ್ಯ್ಯ ಈಶ್ವರಭಕ್ತಿಮ್</para>
  <para style="p">
    <verse number="7" style="v"/>ಈಶ್ವರಭಕ್ತೌ ಭ್ರಾತೃಸ್ನೇಹೇ ಚ ಪ್ರೇಮ ಯುಙ್ಕ್ತ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಏತಾನಿ ಯದಿ ಯುಷ್ಮಾಸು ವಿದ್ಯನ್ತೇे ವರ್ದ್ಧನ್ತೇ ಚ ತರ್ಹ್ಯಸ್ಮತ್ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ತತ್ತ್ವಜ್ಞಾನೇ ಯುಷ್ಮಾನ್ ಅಲಸಾನ್ ನಿಷ್ಫಲಾಂಶ್ಚ ನ ಸ್ಥಾಪಯಿಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಕಿನ್ತ್ವೇತಾನಿ ಯಸ್ಯ ನ ವಿದ್ಯನ್ತೇ ಸೋ ಽನ್ಧೋ ಮುದ್ರಿತಲೋಚನಃ ಸ್ವಕೀಯಪೂರ್ವ್ವಪಾಪಾನಾಂ ಮಾರ್ಜ್ಜನಸ್ಯ ವಿಸ್ಮೃತಿಂ ಗತಶ್ಚ|</para>
  <para style="p">
    <verse number="10" style="v"/>ತಸ್ಮಾದ್ ಹೇ ಭ್ರಾತರಃ, ಯೂಯಂ ಸ್ವಕೀಯಾಹ್ವಾನವರಣಯೋ ರ್ದೃಢಕರಣೇ ಬಹು ಯತಧ್ವಂ, ತತ್ ಕೃತ್ವಾ ಕದಾಚ ನ ಸ್ಖಲಿಷ್ಯಥ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಯತೋ ಽನೇನ ಪ್ರಕಾರೇಣಾಸ್ಮಾಕಂ ಪ್ರಭೋಸ್ತ್ರಾತೃ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯಾನನ್ತರಾಜ್ಯಸ್ಯ ಪ್ರವೇಶೇನ ಯೂಯಂ ಸುಕಲೇನ ಯೋಜಯಿಷ್ಯಧ್ವೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯದ್ಯಪಿ ಯೂಯಮ್ ಏತತ್ ಸರ್ವ್ವಂ ಜಾನೀಥ ವರ್ತ್ತಮಾನೇ ಸತ್ಯಮತೇ ಸುಸ್ಥಿರಾ ಭವಥ ಚ ತಥಾಪಿ ಯುಷ್ಮಾನ್ ಸರ್ವ್ವದಾ ತತ್ ಸ್ಮಾರಯಿತುಮ್ ಅಹಮ್ ಅಯತ್ನವಾನ್ ನ ಭವಿಷ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯಾವದ್ ಏತಸ್ಮಿನ್ ದೂಷ್ಯೇ ತಿಷ್ಠಾಮಿ ತಾವದ್ ಯುಷ್ಮಾನ್ ಸ್ಮಾರಯನ್ ಪ್ರಬೋಧಯಿತುಂ ವಿಹಿತಂ ಮನ್ಯೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯತೋ ಽಸ್ಮಾಕಂ ಪ್ರಭು ರ್ಯೀಶುಖ್ರೀಷ್ಟೋ ಮಾಂ ಯತ್ ಜ್ಞಾಪಿತವಾನ್ ತದನುಸಾರಾದ್ ದೂಷ್ಯಮೇತತ್ ಮಯಾ ಶೀಘ್ರಂ ತ್ಯಕ್ತವ್ಯಮ್ ಇತಿ ಜಾನಾಮಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಮಮ ಪರಲೋಕಗಮನಾತ್ ಪರಮಪಿ ಯೂಯಂ ಯದೇತಾನಿ ಸ್ಮರ್ತ್ತುಂ ಶಕ್ಷ್ಯಥ ತಸ್ಮಿನ್ ಸರ್ವ್ವಥಾ ಯತಿಷ್ಯೇ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯತೋ ಽಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಪರಾಕ್ರಮಂ ಪುನರಾಗಮನಞ್ಚ ಯುಷ್ಮಾನ್ ಜ್ಞಾಪಯನ್ತೋ ವಯಂ ಕಲ್ಪಿತಾನ್ಯುಪಾಖ್ಯಾನಾನ್ಯನ್ವಗಚ್ಛಾಮೇತಿ ನಹಿ ಕಿನ್ತು ತಸ್ಯ ಮಹಿಮ್ನಃ ಪ್ರತ್ಯಕ್ಷಸಾಕ್ಷಿಣೋ ಭೂತ್ವಾ ಭಾಷಿತವನ್ತಃ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಯತಃ ಸ ಪಿತುರೀಶ್ವರಾದ್ ಗೌರವಂ ಪ್ರಶಂಸಾಞ್ಚ ಪ್ರಾಪ್ತವಾನ್ ವಿಶೇಷತೋ ಮಹಿಮಯುಕ್ತತೇಜೋಮಧ್ಯಾದ್ ಏತಾದೃಶೀ ವಾಣೀ ತಂ ಪ್ರತಿ ನಿರ್ಗತವತೀ, ಯಥಾ, ಏಷ ಮಮ ಪ್ರಿಯಪುತ್ರ ಏತಸ್ಮಿನ್ ಮಮ ಪರಮಸನ್ತೋಷಃ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಸ್ವರ್ಗಾತ್ ನಿರ್ಗತೇಯಂ ವಾಣೀ ಪವಿತ್ರಪರ್ವ್ವತೇ ತೇನ ಸಾರ್ದ್ಧಂ ವಿದ್ಯಮಾನೈರಸ್ಮಾಭಿರಶ್ರಾವಿ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಅಪರಮ್ ಅಸ್ಮತ್ಸಮೀಪೇ ದೃಢತರಂ ಭವಿಷ್ಯದ್ವಾಕ್ಯಂ ವಿದ್ಯತೇ ಯೂಯಞ್ಚ ಯದಿ ದಿನಾರಮ್ಭಂ ಯುಷ್ಮನ್ಮನಃಸು ಪ್ರಭಾತೀಯನಕ್ಷತ್ರಸ್ಯೋದಯಞ್ಚ ಯಾವತ್ ತಿಮಿರಮಯೇ ಸ್ಥಾನೇ ಜ್ವಲನ್ತಂ ಪ್ರದೀಪಮಿವ ತದ್ ವಾಕ್ಯಂ ಸಮ್ಮನ್ಯಧ್ವೇ ತರ್ಹಿ ಭದ್ರಂ ಕರಿಷ್ಯಥ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಶಾಸ್ತ್ರೀಯಂ ಕಿಮಪಿ ಭವಿಷ್ಯದ್ವಾಕ್ಯಂ ಮನುಷ್ಯಸ್ಯ ಸ್ವಕೀಯಭಾವಬೋಧಕಂ ನಹಿ, ಏತದ್ ಯುಷ್ಮಾಭಿಃ ಸಮ್ಯಕ್ ಜ್ಞಾಯತಾಂ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಯತೋ ಭವಿಷ್ಯದ್ವಾಕ್ಯಂ ಪುರಾ ಮಾನುಷಾಣಾಮ್ ಇಚ್ಛಾತೋ ನೋತ್ಪನ್ನಂ ಕಿನ್ತ್ವೀಶ್ವರಸ್ಯ ಪವಿತ್ರಲೋಕಾಃ ಪವಿತ್ರೇಣಾತ್ಮನಾ ಪ್ರವರ್ತ್ತಿತಾಃ ಸನ್ತೋ ವಾಕ್ಯಮ್ ಅಭಾಷನ್ತ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅಪರಂ ಪೂರ್ವ್ವಕಾಲೇ ಯಥಾ ಲೋಕಾನಾಂ ಮಧ್ಯೇ ಮಿಥ್ಯಾಭವಿಷ್ಯದ್ವಾದಿನ ಉಪಾತಿಷ್ಠನ್ ತಥಾ ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇಽಪಿ ಮಿಥ್ಯಾಶಿಕ್ಷಕಾ ಉಪಸ್ಥಾಸ್ಯನ್ತಿ, ತೇ ಸ್ವೇಷಾಂ ಕ್ರೇತಾರಂ ಪ್ರಭುಮ್ ಅನಙ್ಗೀಕೃತ್ಯ ಸತ್ವರಂ ವಿನಾಶಂ ಸ್ವೇಷು ವರ್ತ್ತಯನ್ತಿ ವಿನಾಶಕವೈಧರ್ಮ್ಮ್ಯಂ ಗುಪ್ತಂ ಯುಷ್ಮನ್ಮಧ್ಯಮ್ ಆನೇಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತತೋ ಽನೇಕೇಷು ತೇಷಾಂ ವಿನಾಶಕಮಾರ್ಗಂ ಗತೇಷು ತೇಭ್ಯಃ ಸತ್ಯಮಾರ್ಗಸ್ಯ ನಿನ್ದಾ ಸಮ್ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅಪರಞ್ಚ ತೇ ಲೋಭಾತ್ ಕಾಪಟ್ಯವಾಕ್ಯೈ ರ್ಯುಷ್ಮತ್ತೋ ಲಾಭಂ ಕರಿಷ್ಯನ್ತೇ ಕಿನ್ತು ತೇಷಾಂ ಪುರಾತನದಣ್ಡಾಜ್ಞಾ ನ ವಿಲಮ್ಬತೇ ತೇಷಾಂ ವಿನಾಶಶ್ಚ ನ ನಿದ್ರಾತಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಈಶ್ವರಃ ಕೃತಪಾಪಾನ್ ದೂತಾನ್ ನ ಕ್ಷಮಿತ್ವಾ ತಿಮಿರಶೃಙ್ಖಲೈಃ ಪಾತಾಲೇ ರುದ್ಧ್ವಾ ವಿಚಾರಾರ್ಥಂ ಸಮರ್ಪಿತವಾನ್|</para>
  <para style="p">
    <verse number="5" style="v"/>ಪುರಾತನಂ ಸಂಸಾರಮಪಿ ನ ಕ್ಷಮಿತ್ವಾ ತಂ ದುಷ್ಟಾನಾಂ ಸಂಸಾರಂ ಜಲಾಪ್ಲಾವನೇನ ಮಜ್ಜಯಿತ್ವಾ ಸಪ್ತಜನೈಃ ಸಹಿತಂ ಧರ್ಮ್ಮಪ್ರಚಾರಕಂ ನೋಹಂ ರಕ್ಷಿತವಾನ್|</para>
  <para style="p">
    <verse number="6" style="v"/>ಸಿದೋಮಮ್ ಅಮೋರಾ ಚೇತಿನಾಮಕೇ ನಗರೇ ಭವಿಷ್ಯತಾಂ ದುಷ್ಟಾನಾಂ ದೃಷ್ಟಾನ್ತಂ ವಿಧಾಯ ಭಸ್ಮೀಕೃತ್ಯ ವಿನಾಶೇನ ದಣ್ಡಿತವಾನ್;</para>
  <para style="p">
    <verse number="7" style="v"/>ಕಿನ್ತು ತೈಃ ಕುತ್ಸಿತವ್ಯಭಿಚಾರಿಭಿ ರ್ದುಷ್ಟಾತ್ಮಭಿಃ ಕ್ಲಿಷ್ಟಂ ಧಾರ್ಮ್ಮಿಕಂ ಲೋಟಂ ರಕ್ಷಿತವಾನ್|</para>
  <para style="p">
    <verse number="8" style="v"/>ಸ ಧಾರ್ಮ್ಮಿಕೋ ಜನಸ್ತೇಷಾಂ ಮಧ್ಯೇ ನಿವಸನ್ ಸ್ವೀಯದೃಷ್ಟಿಶ್ರೋತ್ರಗೋಚರೇಭ್ಯಸ್ತೇಷಾಮ್ ಅಧರ್ಮ್ಮಾಚಾರೇಭ್ಯಃ ಸ್ವಕೀಯಧಾರ್ಮ್ಮಿಕಮನಸಿ ದಿನೇ ದಿನೇ ತಪ್ತವಾನ್|</para>
  <para style="p">
    <verse number="9" style="v"/>ಪ್ರಭು ರ್ಭಕ್ತಾನ್ ಪರೀಕ್ಷಾದ್ ಉದ್ಧರ್ತ್ತುಂ ವಿಚಾರದಿನಞ್ಚ ಯಾವದ್ ದಣ್ಡ್ಯಾಮಾನಾನ್ ಅಧಾರ್ಮ್ಮಿಕಾನ್ ರೋದ್ಧುಂ ಪಾರಯತಿ,</para>
  <para style="p">
    <verse number="10" style="v"/>ವಿಶೇಷತೋ ಯೇ ಽಮೇಧ್ಯಾಭಿಲಾಷಾತ್ ಶಾರೀರಿಕಸುಖಮ್ ಅನುಗಚ್ಛನ್ತಿ ಕರ್ತೃತ್ವಪದಾನಿ ಚಾವಜಾನನ್ತಿ ತಾನೇವ (ರೋದ್ಧುಂ ಪಾರಯತಿ| ) ತೇ ದುಃಸಾಹಸಿನಃ ಪ್ರಗಲ್ಭಾಶ್ಚ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅಪರಂ ಬಲಗೌರವಾಭ್ಯಾಂ ಶ್ರೇಷ್ಠಾ ದಿವ್ಯದೂತಾಃ ಪ್ರಭೋಃ ಸನ್ನಿಧೌ ಯೇಷಾಂ ವೈಪರೀತ್ಯೇನ ನಿನ್ದಾಸೂಚಕಂ ವಿಚಾರಂ ನ ಕುರ್ವ್ವನ್ತಿ ತೇಷಾಮ್ ಉಚ್ಚಪದಸ್ಥಾನಾಂ ನಿನ್ದನಾದ್ ಇಮೇ ನ ಭೀತಾಃ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಕಿನ್ತು ಯೇ ಬುದ್ಧಿಹೀನಾಃ ಪ್ರಕೃತಾ ಜನ್ತವೋ ಧರ್ತ್ತವ್ಯತಾಯೈ ವಿನಾಶ್ಯತಾಯೈ ಚ ಜಾಯನ್ತೇ ತತ್ಸದೃಶಾ ಇಮೇ ಯನ್ನ ಬುಧ್ಯನ್ತೇ ತತ್ ನಿನ್ದನ್ತಃ ಸ್ವಕೀಯವಿನಾಶ್ಯತಯಾ ವಿನಂಕ್ಷ್ಯನ್ತಿ ಸ್ವೀಯಾಧರ್ಮ್ಮಸ್ಯ ಫಲಂ ಪ್ರಾಪ್ಸ್ಯನ್ತಿ ಚ|</para>
  <para style="p">
    <verse number="13" style="v"/>ತೇ ದಿವಾ ಪ್ರಕೃಷ್ಟಭೋಜನಂ ಸುಖಂ ಮನ್ಯನ್ತೇ ನಿಜಛಲೈಃ ಸುಖಭೋಗಿನಃ ಸನ್ತೋ ಯುಷ್ಮಾಭಿಃ ಸಾರ್ದ್ಧಂ ಭೋಜನಂ ಕುರ್ವ್ವನ್ತಃ ಕಲಙ್ಕಿನೋ ದೋಷಿಣಶ್ಚ ಭವನ್ತಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ತೇಷಾಂ ಲೋಚನಾನಿ ಪರದಾರಾಕಾಙ್ಕ್ಷೀಣಿ ಪಾಪೇ ಚಾಶ್ರಾನ್ತಾನಿ ತೇ ಚಞ್ಚಲಾನಿ ಮನಾಂಸಿ ಮೋಹಯನ್ತಿ ಲೋಭೇ ತತ್ಪರಮನಸಃ ಸನ್ತಿ ಚ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತೇ ಶಾಪಗ್ರಸ್ತಾ ವಂಶಾಃ ಸರಲಮಾರ್ಗಂ ವಿಹಾಯ ಬಿಯೋರಪುತ್ರಸ್ಯ ಬಿಲಿಯಮಸ್ಯ ವಿಪಥೇನ ವ್ರಜನ್ತೋ ಭ್ರಾನ್ತಾ ಅಭವನ್| ಸ ಬಿಲಿಯಮೋ ಽಪ್ಯಧರ್ಮ್ಮಾತ್ ಪ್ರಾಪ್ಯೇ ಪಾರಿತೋಷಿಕೇಽಪ್ರೀಯತ,</para>
  <para style="p">
    <verse number="16" style="v"/>ಕಿನ್ತು ನಿಜಾಪರಾಧಾದ್ ಭರ್ತ್ಸನಾಮ್ ಅಲಭತ ಯತೋ ವಚನಶಕ್ತಿಹೀನಂ ವಾಹನಂ ಮಾನುಷಿಕಗಿರಮ್ ಉಚ್ಚಾರ್ಯ್ಯ ಭವಿಷ್ಯದ್ವಾದಿನ ಉನ್ಮತ್ತತಾಮ್ ಅಬಾಧತ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಇಮೇ ನಿರ್ಜಲಾನಿ ಪ್ರಸ್ರವಣಾನಿ ಪ್ರಚಣ್ಡವಾಯುನಾ ಚಾಲಿತಾ ಮೇಘಾಶ್ಚ ತೇಷಾಂ ಕೃತೇ ನಿತ್ಯಸ್ಥಾಯೀ ಘೋರತರಾನ್ಧಕಾರಃ ಸಞ್ಚಿತೋ ಽಸ್ತಿ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಯೇ ಚ ಜನಾ ಭ್ರಾನ್ತ್ಯಾಚಾರಿಗಣಾತ್ ಕೃಚ್ಛ್ರೇಣೋದ್ಧೃತಾಸ್ತಾನ್ ಇಮೇ ಽಪರಿಮಿತದರ್ಪಕಥಾ ಭಾಷಮಾಣಾಃ ಶಾರೀರಿಕಸುಖಾಭಿಲಾಷೈಃ ಕಾಮಕ್ರೀಡಾಭಿಶ್ಚ ಮೋಹಯನ್ತಿ|</para>
  <para style="p">
    <verse number="19" style="v"/>ತೇಭ್ಯಃ ಸ್ವಾಧೀನತಾಂ ಪ್ರತಿಜ್ಞಾಯ ಸ್ವಯಂ ವಿನಾಶ್ಯತಾಯಾ ದಾಸಾ ಭವನ್ತಿ, ಯತಃ, ಯೋ ಯೇನೈವ ಪರಾಜಿಗ್ಯೇ ಸ ಜಾತಸ್ತಸ್ಯ ಕಿಙ್ಕರಃ|</para>
  <para style="p">
    <verse number="20" style="v"/>ತ್ರಾತುಃ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಜ್ಞಾನೇನ ಸಂಸಾರಸ್ಯ ಮಲೇಭ್ಯ ಉದ್ಧೃತಾ ಯೇ ಪುನಸ್ತೇಷು ನಿಮಜ್ಜ್ಯ ಪರಾಜೀಯನ್ತೇ ತೇಷಾಂ ಪ್ರಥಮದಶಾತಃ ಶೇಷದಶಾ ಕುತ್ಸಿತಾ ಭವತಿ|</para>
  <para style="p">
    <verse number="21" style="v"/>ತೇಷಾಂ ಪಕ್ಷೇ ಧರ್ಮ್ಮಪಥಸ್ಯ ಜ್ಞಾನಾಪ್ರಾಪ್ತಿ ರ್ವರಂ ನ ಚ ನಿರ್ದ್ದಿಷ್ಟಾತ್ ಪವಿತ್ರವಿಧಿಮಾರ್ಗಾತ್ ಜ್ಞಾನಪ್ರಾಪ್ತಾನಾಂ ಪರಾವರ್ತ್ತನಂ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಕಿನ್ತು ಯೇಯಂ ಸತ್ಯಾ ದೃಷ್ಟಾನ್ತಕಥಾ ಸೈವ ತೇಷು ಫಲಿತವತೀ, ಯಥಾ, ಕುಕ್ಕುರಃ ಸ್ವೀಯವಾನ್ತಾಯ ವ್ಯಾವರ್ತ್ತತೇ ಪುನಃ ಪುನಃ| ಲುಠಿತುಂ ಕರ್ದ್ದಮೇ ತದ್ವತ್ ಕ್ಷಾಲಿತಶ್ಚೈವ ಶೂಕರಃ||</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಪ್ರಿಯತಮಾಃ, ಯೂಯಂ ಯಥಾ ಪವಿತ್ರಭವಿಷ್ಯದ್ವಕ್ತೃಭಿಃ ಪೂರ್ವ್ವೋಕ್ತಾನಿ ವಾಕ್ಯಾನಿ ತ್ರಾತ್ರಾ ಪ್ರಭುನಾ ಪ್ರೇರಿತಾನಾಮ್ ಅಸ್ಮಾಕಮ್ ಆದೇಶಞ್ಚ ಸಾರಥ ತಥಾ ಯುಷ್ಮಾನ್ ಸ್ಮಾರಯಿತ್ವಾ</para>
  <para style="p">
    <verse number="2" style="v"/>ಯುಷ್ಮಾಕಂ ಸರಲಭಾವಂ ಪ್ರಬೋಧಯಿತುಮ್ ಅಹಂ ದ್ವಿತೀಯಮ್ ಇದಂ ಪತ್ರಂ ಲಿಖಾಮಿ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಪ್ರಥಮಂ ಯುಷ್ಮಾಭಿರಿದಂ ಜ್ಞಾಯತಾಂ ಯತ್ ಶೇಷೇ ಕಾಲೇ ಸ್ವೇಚ್ಛಾಚಾರಿಣೋ ನಿನ್ದಕಾ ಉಪಸ್ಥಾಯ</para>
  <para style="p">
    <verse number="4" style="v"/>ವದಿಷ್ಯನ್ತಿ ಪ್ರಭೋರಾಗಮನಸ್ಯ ಪ್ರತಿಜ್ಞಾ ಕುತ್ರ? ಯತಃ ಪಿತೃಲೋಕಾನಾಂ ಮಹಾನಿದ್ರಾಗಮನಾತ್ ಪರಂ ಸರ್ವ್ವಾಣಿ ಸೃಷ್ಟೇರಾರಮ್ಭಕಾಲೇ ಯಥಾ ತಥೈವಾವತಿಷ್ಠನ್ತೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಪೂರ್ವ್ವಮ್ ಈಶ್ವರಸ್ಯ ವಾಕ್ಯೇನಾಕಾಶಮಣ್ಡಲಂ ಜಲಾದ್ ಉತ್ಪನ್ನಾ ಜಲೇ ಸನ್ತಿಷ್ಠಮಾನಾ ಚ ಪೃಥಿವ್ಯವಿದ್ಯತೈತದ್ ಅನಿಚ್ಛುಕತಾತಸ್ತೇ ನ ಜಾನಾನ್ತಿ,</para>
  <para style="p">
    <verse number="6" style="v"/>ತತಸ್ತಾತ್ಕಾಲಿಕಸಂಸಾರೋ ಜಲೇನಾಪ್ಲಾವಿತೋ ವಿನಾಶಂ ಗತಃ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಕಿನ್ತ್ವಧುನಾ ವರ್ತ್ತಮಾನೇ ಆಕಾಶಭೂಮಣ್ಡಲೇ ತೇನೈವ ವಾಕ್ಯೇನ ವಹ್ನ್ಯರ್ಥಂ ಗುಪ್ತೇ ವಿಚಾರದಿನಂ ದುಷ್ಟಮಾನವಾನಾಂ ವಿನಾಶಞ್ಚ ಯಾವದ್ ರಕ್ಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಹೇ ಪ್ರಿಯತಮಾಃ, ಯೂಯಮ್ ಏತದೇಕಂ ವಾಕ್ಯಮ್ ಅನವಗತಾ ಮಾ ಭವತ ಯತ್ ಪ್ರಭೋಃ ಸಾಕ್ಷಾದ್ ದಿನಮೇಕಂ ವರ್ಷಸಹಸ್ರವದ್ ವರ್ಷಸಹಸ್ರಞ್ಚ ದಿನೈಕವತ್|</para>
  <para style="p">
    <verse number="9" style="v"/>ಕೇಚಿದ್ ಯಥಾ ವಿಲಮ್ಬಂ ಮನ್ಯನ್ತೇ ತಥಾ ಪ್ರಭುಃ ಸ್ವಪ್ರತಿಜ್ಞಾಯಾಂ ವಿಲಮ್ಬತೇ ತನ್ನಹಿ ಕಿನ್ತು ಕೋಽಪಿ ಯನ್ನ ವಿನಶ್ಯೇತ್ ಸರ್ವ್ವಂ ಏವ ಮನಃಪರಾವರ್ತ್ತನಂ ಗಚ್ಛೇಯುರಿತ್ಯಭಿಲಷನ್ ಸೋ ಽಸ್ಮಾನ್ ಪ್ರತಿ ದೀರ್ಘಸಹಿಷ್ಣುತಾಂ ವಿದಧಾತಿ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಕಿನ್ತು ಕ್ಷಪಾಯಾಂ ಚೌರ ಇವ ಪ್ರಭೋ ರ್ದಿನಮ್ ಆಗಮಿಷ್ಯತಿ ತಸ್ಮಿನ್ ಮಹಾಶಬ್ದೇನ ಗಗನಮಣ್ಡಲಂ ಲೋಪ್ಸ್ಯತೇ ಮೂಲವಸ್ತೂನಿ ಚ ತಾಪೇನ ಗಲಿಷ್ಯನ್ತೇ ಪೃಥಿವೀ ತನ್ಮಧ್ಯಸ್ಥಿತಾನಿ ಕರ್ಮ್ಮಾಣಿ ಚ ಧಕ್ಷ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅತಃ ಸರ್ವ್ವೈರೇತೈ ರ್ವಿಕಾರೇ ಗನ್ತವ್ಯೇ ಸತಿ ಯಸ್ಮಿನ್ ಆಕಾಶಮಣ್ಡಲಂ ದಾಹೇನ ವಿಕಾರಿಷ್ಯತೇ ಮೂಲವಸ್ತೂನಿ ಚ ತಾಪೇನ ಗಲಿಷ್ಯನ್ತೇ</para>
  <para style="p">
    <verse number="12" style="v"/>ತಸ್ಯೇಶ್ವರದಿನಸ್ಯಾಗಮನಂ ಪ್ರತೀಕ್ಷಮಾಣೈರಾಕಾಙ್ಕ್ಷಮಾಣೈಶ್ಚ ಯೂಷ್ಮಾಭಿ ರ್ಧರ್ಮ್ಮಾಚಾರೇಶ್ವರಭಕ್ತಿಭ್ಯಾಂ ಕೀದೃಶೈ ರ್ಲೋಕೈ ರ್ಭವಿತವ್ಯಂ?</para>
  <para style="p">
    <verse number="13" style="v"/>ತಥಾಪಿ ವಯಂ ತಸ್ಯ ಪ್ರತಿಜ್ಞಾನುಸಾರೇಣ ಧರ್ಮ್ಮಸ್ಯ ವಾಸಸ್ಥಾನಂ ನೂತನಮ್ ಆಕಾಶಮಣ್ಡಲಂ ನೂತನಂ ಭೂಮಣ್ಡಲಞ್ಚ ಪ್ರತೀಕ್ಷಾಮಹೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಅತಏವ ಹೇ ಪ್ರಿಯತಮಾಃ, ತಾನಿ ಪ್ರತೀಕ್ಷಮಾಣಾ ಯೂಯಂ ನಿಷ್ಕಲಙ್ಕಾ ಅನಿನ್ದಿತಾಶ್ಚ ಭೂತ್ವಾ ಯತ್ ಶಾನ್ತ್ಯಾಶ್ರಿತಾಸ್ತಿಷ್ಠಥೈತಸ್ಮಿನ್ ಯತಧ್ವಂ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ದೀರ್ಘಸಹಿಷ್ಣುತಾಞ್ಚ ಪರಿತ್ರಾಣಜನಿಕಾಂ ಮನ್ಯಧ್ವಂ| ಅಸ್ಮಾಕಂ ಪ್ರಿಯಭ್ರಾತ್ರೇ ಪೌಲಾಯ ಯತ್ ಜ್ಞಾನಮ್ ಅದಾಯಿ ತದನುಸಾರೇಣ ಸೋಽಪಿ ಪತ್ರೇ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ತದೇವಾಲಿಖತ್|</para>
  <para style="p">
    <verse number="16" style="v"/>ಸ್ವಕೀಯಸರ್ವ್ವಪತ್ರೇಷು ಚೈತಾನ್ಯಧಿ ಪ್ರಸ್ತುತ್ಯ ತದೇವ ಗದತಿ| ತೇಷು ಪತ್ರೇಷು ಕತಿಪಯಾನಿ ದುರೂಹ್ಯಾಣಿ ವಾಕ್ಯಾನಿ ವಿದ್ಯನ್ತೇ ಯೇ ಚ ಲೋಕಾ ಅಜ್ಞಾನಾಶ್ಚಞ್ಚಲಾಶ್ಚ ತೇ ನಿಜವಿನಾಶಾರ್ಥಮ್ ಅನ್ಯಶಾಸ್ತ್ರೀಯವಚನಾನೀವ ತಾನ್ಯಪಿ ವಿಕಾರಯನ್ತಿ|</para>
  <para style="p">
    <verse number="17" style="v"/>ತಸ್ಮಾದ್ ಹೇ ಪ್ರಿಯತಮಾಃ, ಯೂಯಂ ಪೂರ್ವ್ವಂ ಬುದ್ಧ್ವಾ ಸಾವಧಾನಾಸ್ತಿಷ್ಠತ, ಅಧಾರ್ಮ್ಮಿಕಾಣಾಂ ಭ್ರಾನ್ತಿಸ್ರೋತಸಾಪಹೃತಾಃ ಸ್ವಕೀಯಸುಸ್ಥಿರತ್ವಾತ್ ಮಾ ಭ್ರಶ್ಯತ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಕಿನ್ತ್ವಸ್ಮಾಕಂ ಪ್ರಭೋಸ್ತ್ರಾತು ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯಾನುಗ್ರಹೇ ಜ್ಞಾನೇ ಚ ವರ್ದ್ಧಧ್ವಂ| ತಸ್ಯ ಗೌರವಮ್ ಇದಾನೀಂ ಸದಾಕಾಲಞ್ಚ ಭೂಯಾತ್| ಆಮೇನ್|</para>
</usx>
