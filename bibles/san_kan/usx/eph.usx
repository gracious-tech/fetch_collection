<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="EPH" style="id">Sanskrit Bible (NT) in Kannada Script (ಸತ್ಯವೇದಃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Ephesians</para>
  <para style="toc1">ಇಫಿಷಿಣಃ ಪತ್ರಂ</para>
  <para style="toc2">ಇಫಿಷಿಣಃ</para>
  <para style="toc3">ಇಫಿಷಿಣಃ</para>
  <para style="mt1">ಇಫಿಷಿಣಃ ಪತ್ರಂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಈಶ್ವರಸ್ಯೇಚ್ಛಯಾ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಪ್ರೇರಿತಃ ಪೌಲ ಇಫಿಷನಗರಸ್ಥಾನ್ ಪವಿತ್ರಾನ್ ಖ್ರೀಷ್ಟಯೀಶೌ ವಿಶ್ವಾಸಿನೋ ಲೋಕಾನ್ ಪ್ರತಿ ಪತ್ರಂ ಲಿಖತಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಅಸ್ಮಾಕಂ ತಾತಸ್ಯೇಶ್ವರಸ್ಯ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಚಾನುಗ್ರಹಃ ಶಾನ್ತಿಶ್ಚ ಯುಷ್ಮಾಸು ವರ್ತ್ತತಾಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶೋಃ ಖ್ರೀಷ್ಟಸ್ಯ ತಾತ ಈಶ್ವರೋ ಧನ್ಯೋ ಭವತು; ಯತಃ ಸ ಖ್ರೀಷ್ಟೇನಾಸ್ಮಭ್ಯಂ ಸರ್ವ್ವಮ್ ಆಧ್ಯಾತ್ಮಿಕಂ ಸ್ವರ್ಗೀಯವರಂ ದತ್ತವಾನ್|</para>
  <para style="p">
    <verse number="4" style="v"/>ವಯಂ ಯತ್ ತಸ್ಯ ಸಮಕ್ಷಂ ಪ್ರೇಮ್ನಾ ಪವಿತ್ರಾ ನಿಷ್ಕಲಙ್ಕಾಶ್ಚ ಭವಾಮಸ್ತದರ್ಥಂ ಸ ಜಗತಃ ಸೃಷ್ಟೇ ಪೂರ್ವ್ವಂ ತೇನಾಸ್ಮಾನ್ ಅಭಿರೋಚಿತವಾನ್, ನಿಜಾಭಿಲಷಿತಾನುರೋಧಾಚ್ಚ</para>
  <para style="p">
    <verse number="5" style="v"/>ಯೀಶುನಾ ಖ್ರೀಷ್ಟೇನ ಸ್ವಸ್ಯ ನಿಮಿತ್ತಂ ಪುತ್ರತ್ವಪದೇಽಸ್ಮಾನ್ ಸ್ವಕೀಯಾನುಗ್ರಹಸ್ಯ ಮಹತ್ತ್ವಸ್ಯ ಪ್ರಶಂಸಾರ್ಥಂ ಪೂರ್ವ್ವಂ ನಿಯುಕ್ತವಾನ್|</para>
  <para style="p">
    <verse number="6" style="v"/>ತಸ್ಮಾದ್ ಅನುಗ್ರಹಾತ್ ಸ ಯೇನ ಪ್ರಿಯತಮೇನ ಪುತ್ರೇಣಾಸ್ಮಾನ್ ಅನುಗೃಹೀತವಾನ್,</para>
  <para style="p">
    <verse number="7" style="v"/>ವಯಂ ತಸ್ಯ ಶೋಣಿತೇನ ಮುಕ್ತಿಮ್ ಅರ್ಥತಃ ಪಾಪಕ್ಷಮಾಂ ಲಬ್ಧವನ್ತಃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ತಸ್ಯ ಯ ಈದೃಶೋಽನುಗ್ರಹನಿಧಿಸ್ತಸ್ಮಾತ್ ಸೋಽಸ್ಮಭ್ಯಂ ಸರ್ವ್ವವಿಧಂ ಜ್ಞಾನಂ ಬುದ್ಧಿಞ್ಚ ಬಾಹುಲ್ಯರೂಪೇಣ ವಿತರಿತವಾನ್|</para>
  <para style="p">
    <verse number="9" style="v"/>ಸ್ವರ್ಗಪೃಥಿವ್ಯೋ ರ್ಯದ್ಯದ್ ವಿದ್ಯತೇ ತತ್ಸರ್ವ್ವಂ ಸ ಖ್ರೀಷ್ಟೇ ಸಂಗ್ರಹೀಷ್ಯತೀತಿ ಹಿತೈಷಿಣಾ</para>
  <para style="p">
    <verse number="10" style="v"/>ತೇನ ಕೃತೋ ಯೋ ಮನೋರಥಃ ಸಮ್ಪೂರ್ಣತಾಂ ಗತವತ್ಸು ಸಮಯೇಷು ಸಾಧಯಿತವ್ಯಸ್ತಮಧಿ ಸ ಸ್ವಕೀಯಾಭಿಲಾಷಸ್ಯ ನಿಗೂಢಂ ಭಾವಮ್ ಅಸ್ಮಾನ್ ಜ್ಞಾಪಿತವಾನ್|</para>
  <para style="p">
    <verse number="11" style="v"/>ಪೂರ್ವ್ವಂ ಖ್ರೀಷ್ಟೇ ವಿಶ್ವಾಸಿನೋ ಯೇ ವಯಮ್ ಅಸ್ಮತ್ತೋ ಯತ್ ತಸ್ಯ ಮಹಿಮ್ನಃ ಪ್ರಶಂಸಾ ಜಾಯತೇ,</para>
  <para style="p">
    <verse number="12" style="v"/>ತದರ್ಥಂ ಯಃ ಸ್ವಕೀಯೇಚ್ಛಾಯಾಃ ಮನ್ತ್ರಣಾತಃ ಸರ್ವ್ವಾಣಿ ಸಾಧಯತಿ ತಸ್ಯ ಮನೋರಥಾದ್ ವಯಂ ಖ್ರೀಷ್ಟೇನ ಪೂರ್ವ್ವಂ ನಿರೂಪಿತಾಃ ಸನ್ತೋಽಧಿಕಾರಿಣೋ ಜಾತಾಃ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯೂಯಮಪಿ ಸತ್ಯಂ ವಾಕ್ಯಮ್ ಅರ್ಥತೋ ಯುಷ್ಮತ್ಪರಿತ್ರಾಣಸ್ಯ ಸುಸಂವಾದಂ ನಿಶಮ್ಯ ತಸ್ಮಿನ್ನೇವ ಖ್ರೀಷ್ಟೇ ವಿಶ್ವಸಿತವನ್ತಃ ಪ್ರತಿಜ್ಞಾತೇನ ಪವಿತ್ರೇಣಾತ್ಮನಾ ಮುದ್ರಯೇವಾಙ್ಕಿತಾಶ್ಚ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯತಸ್ತಸ್ಯ ಮಹಿಮ್ನಃ ಪ್ರಕಾಶಾಯ ತೇನ ಕ್ರೀತಾನಾಂ ಲೋಕಾನಾಂ ಮುಕ್ತಿ ರ್ಯಾವನ್ನ ಭವಿಷ್ಯತಿ ತಾವತ್ ಸ ಆತ್ಮಾಸ್ಮಾಕಮ್ ಅಧಿಕಾರಿತ್ವಸ್ಯ ಸತ್ಯಙ್ಕಾರಸ್ಯ ಪಣಸ್ವರೂಪೋ ಭವತಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಪ್ರಭೌ ಯೀಶೌ ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸಃ ಸರ್ವ್ವೇಷು ಪವಿತ್ರಲೋಕೇಷು ಪ್ರೇಮ ಚಾಸ್ತ ಇತಿ ವಾರ್ತ್ತಾಂ ಶ್ರುತ್ವಾಹಮಪಿ</para>
  <para style="p">
    <verse number="16" style="v"/>ಯುಷ್ಮಾನಧಿ ನಿರನ್ತರಮ್ ಈಶ್ವರಂ ಧನ್ಯಂ ವದನ್ ಪ್ರಾರ್ಥನಾಸಮಯೇ ಚ ಯುಷ್ಮಾನ್ ಸ್ಮರನ್ ವರಮಿಮಂ ಯಾಚಾಮಿ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಅಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ತಾತೋ ಯಃ ಪ್ರಭಾವಾಕರ ಈಶ್ವರಃ ಸ ಸ್ವಕೀಯತತ್ತ್ವಜ್ಞಾನಾಯ ಯುಷ್ಮಭ್ಯಂ ಜ್ಞಾನಜನಕಮ್ ಪ್ರಕಾಶಿತವಾಕ್ಯಬೋಧಕಞ್ಚಾತ್ಮಾನಂ ದೇಯಾತ್|</para>
  <para style="p">
    <verse number="18" style="v"/>ಯುಷ್ಮಾಕಂ ಜ್ಞಾನಚಕ್ಷೂಂಷಿ ಚ ದೀಪ್ತಿಯುಕ್ತಾನಿ ಕೃತ್ವಾ ತಸ್ಯಾಹ್ವಾನಂ ಕೀದೃಶ್ಯಾ ಪ್ರತ್ಯಾಶಯಾ ಸಮ್ಬಲಿತಂ ಪವಿತ್ರಲೋಕಾನಾಂ ಮಧ್ಯೇ ತೇನ ದತ್ತೋಽಧಿಕಾರಃ ಕೀದೃಶಃ ಪ್ರಭಾವನಿಧಿ ರ್ವಿಶ್ವಾಸಿಷು ಚಾಸ್ಮಾಸು ಪ್ರಕಾಶಮಾನಸ್ಯ</para>
  <para style="p">
    <verse number="19" style="v"/>ತದೀಯಮಹಾಪರಾಕ್ರಮಸ್ಯ ಮಹತ್ವಂ ಕೀದೃಗ್ ಅನುಪಮಂ ತತ್ ಸರ್ವ್ವಂ ಯುಷ್ಮಾನ್ ಜ್ಞಾಪಯತು|</para>
  <para style="p">
    <verse number="20" style="v"/>ಯತಃ ಸ ಯಸ್ಯಾಃ ಶಕ್ತೇಃ ಪ್ರಬಲತಾಂ ಖ್ರೀಷ್ಟೇ ಪ್ರಕಾಶಯನ್ ಮೃತಗಣಮಧ್ಯಾತ್ ತಮ್ ಉತ್ಥಾಪಿತವಾನ್,</para>
  <para style="p">
    <verse number="21" style="v"/>ಅಧಿಪತಿತ್ವಪದಂ ಶಾಸನಪದಂ ಪರಾಕ್ರಮೋ ರಾಜತ್ವಞ್ಚೇತಿನಾಮಾನಿ ಯಾವನ್ತಿ ಪದಾನೀಹ ಲೋಕೇ ಪರಲೋಕೇ ಚ ವಿದ್ಯನ್ತೇ ತೇಷಾಂ ಸರ್ವ್ವೇಷಾಮ್ ಊರ್ದ್ಧ್ವೇ ಸ್ವರ್ಗೇ ನಿಜದಕ್ಷಿಣಪಾರ್ಶ್ವೇ ತಮ್ ಉಪವೇಶಿತವಾನ್,</para>
  <para style="p">
    <verse number="22" style="v"/>ಸರ್ವ್ವಾಣಿ ತಸ್ಯ ಚರಣಯೋರಧೋ ನಿಹಿತವಾನ್ ಯಾ ಸಮಿತಿಸ್ತಸ್ಯ ಶರೀರಂ ಸರ್ವ್ವತ್ರ ಸರ್ವ್ವೇಷಾಂ ಪೂರಯಿತುಃ ಪೂರಕಞ್ಚ ಭವತಿ ತಂ ತಸ್ಯಾ ಮೂರ್ದ್ಧಾನಂ ಕೃತ್ವಾ</para>
  <para style="p">
    <verse number="23" style="v"/>ಸರ್ವ್ವೇಷಾಮ್ ಉಪರ್ಯ್ಯುಪರಿ ನಿಯುಕ್ತವಾಂಶ್ಚ ಸೈವ ಶಕ್ತಿರಸ್ಮಾಸ್ವಪಿ ತೇನ ಪ್ರಕಾಶ್ಯತೇ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಪುರಾ ಯೂಯಮ್ ಅಪರಾಧೈಃ ಪಾಪೈಶ್ಚ ಮೃತಾಃ ಸನ್ತಸ್ತಾನ್ಯಾಚರನ್ತ ಇಹಲೋಕಸ್ಯ ಸಂಸಾರಾನುಸಾರೇಣಾಕಾಶರಾಜ್ಯಸ್ಯಾಧಿಪತಿಮ್</para>
  <para style="p">
    <verse number="2" style="v"/>ಅರ್ಥತಃ ಸಾಮ್ಪ್ರತಮ್ ಆಜ್ಞಾಲಙ್ಘಿವಂಶೇಷು ಕರ್ಮ್ಮಕಾರಿಣಮ್ ಆತ್ಮಾನಮ್ ಅನ್ವವ್ರಜತ|</para>
  <para style="p">
    <verse number="3" style="v"/>ತೇಷಾಂ ಮಧ್ಯೇ ಸರ್ವ್ವೇ ವಯಮಪಿ ಪೂರ್ವ್ವಂ ಶರೀರಸ್ಯ ಮನಸ್ಕಾಮನಾಯಾಞ್ಚೇಹಾಂ ಸಾಧಯನ್ತಃ ಸ್ವಶರೀರಸ್ಯಾಭಿಲಾಷಾನ್ ಆಚರಾಮ ಸರ್ವ್ವೇಽನ್ಯ ಇವ ಚ ಸ್ವಭಾವತಃ ಕ್ರೋಧಭಜನಾನ್ಯಭವಾಮ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಕಿನ್ತು ಕರುಣಾನಿಧಿರೀಶ್ವರೋ ಯೇನ ಮಹಾಪ್ರೇಮ್ನಾಸ್ಮಾನ್ ದಯಿತವಾನ್</para>
  <para style="p">
    <verse number="5" style="v"/>ತಸ್ಯ ಸ್ವಪ್ರೇಮ್ನೋ ಬಾಹುಲ್ಯಾದ್ ಅಪರಾಧೈ ರ್ಮೃತಾನಪ್ಯಸ್ಮಾನ್ ಖ್ರೀಷ್ಟೇನ ಸಹ ಜೀವಿತವಾನ್ ಯತೋಽನುಗ್ರಹಾದ್ ಯೂಯಂ ಪರಿತ್ರಾಣಂ ಪ್ರಾಪ್ತಾಃ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಸ ಚ ಖ್ರೀಷ್ಟೇನ ಯೀಶುನಾಸ್ಮಾನ್ ತೇನ ಸಾರ್ದ್ಧಮ್ ಉತ್ಥಾಪಿತವಾನ್ ಸ್ವರ್ಗ ಉಪವೇಶಿತವಾಂಶ್ಚ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಇತ್ಥಂ ಸ ಖ್ರೀಷ್ಟೇನ ಯೀಶುನಾಸ್ಮಾನ್ ಪ್ರತಿ ಸ್ವಹಿತೈಷಿತಯಾ ಭಾವಿಯುಗೇಷು ಸ್ವಕೀಯಾನುಗ್ರಹಸ್ಯಾನುಪಮಂ ನಿಧಿಂ ಪ್ರಕಾಶಯಿತುಮ್ ಇಚ್ಛತಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಯೂಯಮ್ ಅನುಗ್ರಹಾದ್ ವಿಶ್ವಾಸೇನ ಪರಿತ್ರಾಣಂ ಪ್ರಾಪ್ತಾಃ, ತಚ್ಚ ಯುಷ್ಮನ್ಮೂಲಕಂ ನಹಿ ಕಿನ್ತ್ವೀಶ್ವರಸ್ಯೈವ ದಾನಂ,</para>
  <para style="p">
    <verse number="9" style="v"/>ತತ್ ಕರ್ಮ್ಮಣಾಂ ಫಲಮ್ ಅಪಿ ನಹಿ, ಅತಃ ಕೇನಾಪಿ ನ ಶ್ಲಾಘಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯತೋ ವಯಂ ತಸ್ಯ ಕಾರ್ಯ್ಯಂ ಪ್ರಾಗ್ ಈಶ್ವರೇಣ ನಿರೂಪಿತಾಭಿಃ ಸತ್ಕ್ರಿಯಾಭಿಃ ಕಾಲಯಾಪನಾಯ ಖ್ರೀಷ್ಟೇ ಯೀಶೌ ತೇನ ಮೃಷ್ಟಾಶ್ಚ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಪುರಾ ಜನ್ಮನಾ ಭಿನ್ನಜಾತೀಯಾ ಹಸ್ತಕೃತಂ ತ್ವಕ್ಛೇದಂ ಪ್ರಾಪ್ತೈ ರ್ಲೋಕೈಶ್ಚಾಚ್ಛಿನ್ನತ್ವಚ ಇತಿನಾಮ್ನಾ ಖ್ಯಾತಾ ಯೇ ಯೂಯಂ ತೈ ರ್ಯುಷ್ಮಾಭಿರಿದಂ ಸ್ಮರ್ತ್ತವ್ಯಂ</para>
  <para style="p">
    <verse number="12" style="v"/>ಯತ್ ತಸ್ಮಿನ್ ಸಮಯೇ ಯೂಯಂ ಖ್ರೀಷ್ಟಾದ್ ಭಿನ್ನಾ ಇಸ್ರಾಯೇಲಲೋಕಾನಾಂ ಸಹವಾಸಾದ್ ದೂರಸ್ಥಾಃ ಪ್ರತಿಜ್ಞಾಸಮ್ಬಲಿತನಿಯಮಾನಾಂ ಬಹಿಃ ಸ್ಥಿತಾಃ ಸನ್ತೋ ನಿರಾಶಾ ನಿರೀಶ್ವರಾಶ್ಚ ಜಗತ್ಯಾಧ್ವಮ್ ಇತಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಕಿನ್ತ್ವಧುನಾ ಖ್ರೀಷ್ಟೇ ಯೀಶಾವಾಶ್ರಯಂ ಪ್ರಾಪ್ಯ ಪುರಾ ದೂರವರ್ತ್ತಿನೋ ಯೂಯಂ ಖ್ರೀಷ್ಟಸ್ಯ ಶೋಣಿತೇನ ನಿಕಟವರ್ತ್ತಿನೋಽಭವತ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯತಃ ಸ ಏವಾಸ್ಮಾಕಂ ಸನ್ಧಿಃ ಸ ದ್ವಯಮ್ ಏಕೀಕೃತವಾನ್ ಶತ್ರುತಾರೂಪಿಣೀಂ ಮಧ್ಯವರ್ತ್ತಿನೀಂ ಪ್ರಭೇದಕಭಿತ್ತಿಂ ಭಗ್ನವಾನ್ ದಣ್ಡಾಜ್ಞಾಯುಕ್ತಂ ವಿಧಿಶಾಸ್ತ್ರಂ ಸ್ವಶರೀರೇಣ ಲುಪ್ತವಾಂಶ್ಚ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಯತಃ ಸ ಸನ್ಧಿಂ ವಿಧಾಯ ತೌ ದ್ವೌ ಸ್ವಸ್ಮಿನ್ ಏಕಂ ನುತನಂ ಮಾನವಂ ಕರ್ತ್ತುಂ</para>
  <para style="p">
    <verse number="16" style="v"/>ಸ್ವಕೀಯಕ್ರುಶೇ ಶತ್ರುತಾಂ ನಿಹತ್ಯ ತೇನೈವೈಕಸ್ಮಿನ್ ಶರೀರೇ ತಯೋ ರ್ದ್ವಯೋರೀಶ್ವರೇಣ ಸನ್ಧಿಂ ಕಾರಯಿತುಂ ನಿಶ್ಚತವಾನ್|</para>
  <para style="p">
    <verse number="17" style="v"/>ಸ ಚಾಗತ್ಯ ದೂರವರ್ತ್ತಿನೋ ಯುಷ್ಮಾನ್ ನಿಕಟವರ್ತ್ತಿನೋ ಽಸ್ಮಾಂಶ್ಚ ಸನ್ಧೇ ರ್ಮಙ್ಗಲವಾರ್ತ್ತಾಂ ಜ್ಞಾಪಿತವಾನ್|</para>
  <para style="p">
    <verse number="18" style="v"/>ಯತಸ್ತಸ್ಮಾದ್ ಉಭಯಪಕ್ಷೀಯಾ ವಯಮ್ ಏಕೇನಾತ್ಮನಾ ಪಿತುಃ ಸಮೀಪಂ ಗಮನಾಯ ಸಾಮರ್ಥ್ಯಂ ಪ್ರಾಪ್ತವನ್ತಃ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಅತ ಇದಾನೀಂ ಯೂಯಮ್ ಅಸಮ್ಪರ್ಕೀಯಾ ವಿದೇಶಿನಶ್ಚ ನ ತಿಷ್ಠನತಃ ಪವಿತ್ರಲೋಕೈಃ ಸಹವಾಸಿನ ಈಶ್ವರಸ್ಯ ವೇಶ್ಮವಾಸಿನಶ್ಚಾಧ್ವೇ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಅಪರಂ ಪ್ರೇರಿತಾ ಭವಿಷ್ಯದ್ವಾದಿನಶ್ಚ ಯತ್ರ ಭಿತ್ತಿಮೂಲಸ್ವರೂಪಾಸ್ತತ್ರ ಯೂಯಂ ತಸ್ಮಿನ್ ಮೂಲೇ ನಿಚೀಯಧ್ವೇ ತತ್ರ ಚ ಸ್ವಯಂ ಯೀಶುಃ ಖ್ರೀಷ್ಟಃ ಪ್ರಧಾನಃ ಕೋಣಸ್ಥಪ್ರಸ್ತರಃ|</para>
  <para style="p">
    <verse number="21" style="v"/>ತೇನ ಕೃತ್ಸ್ನಾ ನಿರ್ಮ್ಮಿತಿಃ ಸಂಗ್ರಥ್ಯಮಾನಾ ಪ್ರಭೋಃ ಪವಿತ್ರಂ ಮನ್ದಿರಂ ಭವಿತುಂ ವರ್ದ್ಧತೇ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಯೂಯಮಪಿ ತತ್ರ ಸಂಗ್ರಥ್ಯಮಾನಾ ಆತ್ಮನೇಶ್ವರಸ್ಯ ವಾಸಸ್ಥಾನಂ ಭವಥ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅತೋ ಹೇತೋ ರ್ಭಿನ್ನಜಾತೀಯಾನಾಂ ಯುಷ್ಮಾಕಂ ನಿಮಿತ್ತಂ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಬನ್ದೀ ಯಃ ಸೋಽಹಂ ಪೌಲೋ ಬ್ರವೀಮಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯುಷ್ಮದರ್ಥಮ್ ಈಶ್ವರೇಣ ಮಹ್ಯಂ ದತ್ತಸ್ಯ ವರಸ್ಯ ನಿಯಮಃ ಕೀದೃಶಸ್ತದ್ ಯುಷ್ಮಾಭಿರಶ್ರಾವೀತಿ ಮನ್ಯೇ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅರ್ಥತಃ ಪೂರ್ವ್ವಂ ಮಯಾ ಸಂಕ್ಷೇಪೇಣ ಯಥಾ ಲಿಖಿತಂ ತಥಾಹಂ ಪ್ರಕಾಶಿತವಾಕ್ಯೇನೇಶ್ವರಸ್ಯ ನಿಗೂಢಂ ಭಾವಂ ಜ್ಞಾಪಿತೋಽಭವಂ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಅತೋ ಯುಷ್ಮಾಭಿಸ್ತತ್ ಪಠಿತ್ವಾ ಖ್ರೀಷ್ಟಮಧಿ ತಸ್ಮಿನ್ನಿಗೂಢೇ ಭಾವೇ ಮಮ ಜ್ಞಾನಂ ಕೀದೃಶಂ ತದ್ ಭೋತ್ಸ್ಯತೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಪೂರ್ವ್ವಯುಗೇಷು ಮಾನವಸನ್ತಾನಾಸ್ತಂ ಜ್ಞಾಪಿತಾ ನಾಸನ್ ಕಿನ್ತ್ವಧುನಾ ಸ ಭಾವಸ್ತಸ್ಯ ಪವಿತ್ರಾನ್ ಪ್ರೇರಿತಾನ್ ಭವಿಷ್ಯದ್ವಾದಿನಶ್ಚ ಪ್ರತ್ಯಾತ್ಮನಾ ಪ್ರಕಾಶಿತೋಽಭವತ್;</para>
  <para style="p">
    <verse number="6" style="v"/>ಅರ್ಥತ ಈಶ್ವರಸ್ಯ ಶಕ್ತೇಃ ಪ್ರಕಾಶಾತ್ ತಸ್ಯಾನುಗ್ರಹೇಣ ಯೋ ವರೋ ಮಹ್ಯಮ್ ಅದಾಯಿ ತೇನಾಹಂ ಯಸ್ಯ ಸುಸಂವಾದಸ್ಯ ಪರಿಚಾರಕೋಽಭವಂ,</para>
  <para style="p">
    <verse number="7" style="v"/>ತದ್ವಾರಾ ಖ್ರೀಷ್ಟೇನ ಭಿನ್ನಜಾತೀಯಾ ಅನ್ಯೈಃ ಸಾರ್ದ್ಧಮ್ ಏಕಾಧಿಕಾರಾ ಏಕಶರೀರಾ ಏಕಸ್ಯಾಃ ಪ್ರತಿಜ್ಞಾಯಾ ಅಂಶಿನಶ್ಚ ಭವಿಷ್ಯನ್ತೀತಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಸರ್ವ್ವೇಷಾಂ ಪವಿತ್ರಲೋಕಾನಾಂ ಕ್ಷುದ್ರತಮಾಯ ಮಹ್ಯಂ ವರೋಽಯಮ್ ಅದಾಯಿ ಯದ್ ಭಿನ್ನಜಾತೀಯಾನಾಂ ಮಧ್ಯೇ ಬೋಧಾಗಯಸ್ಯ ಗುಣನಿಧೇಃ ಖ್ರೀಷ್ಟಸ್ಯ ಮಙ್ಗಲವಾರ್ತ್ತಾಂ ಪ್ರಚಾರಯಾಮಿ,</para>
  <para style="p">
    <verse number="9" style="v"/>ಕಾಲಾವಸ್ಥಾತಃ ಪೂರ್ವ್ವಸ್ಮಾಚ್ಚ ಯೋ ನಿಗೂಢಭಾವ ಈಶ್ವರೇ ಗುಪ್ತ ಆಸೀತ್ ತದೀಯನಿಯಮಂ ಸರ್ವ್ವಾನ್ ಜ್ಞಾಪಯಾಮಿ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯತ ಈಶ್ವರಸ್ಯ ನಾನಾರೂಪಂ ಜ್ಞಾನಂ ಯತ್ ಸಾಮ್ಪ್ರತಂ ಸಮಿತ್ಯಾ ಸ್ವರ್ಗೇ ಪ್ರಾಧಾನ್ಯಪರಾಕ್ರಮಯುಕ್ತಾನಾಂ ದೂತಾನಾಂ ನಿಕಟೇ ಪ್ರಕಾಶ್ಯತೇ ತದರ್ಥಂ ಸ ಯೀಶುನಾ ಖ್ರೀಷ್ಟೇನ ಸರ್ವ್ವಾಣಿ ಸೃಷ್ಟವಾನ್|</para>
  <para style="p">
    <verse number="11" style="v"/>ಯತೋ ವಯಂ ಯಸ್ಮಿನ್ ವಿಶ್ವಸ್ಯ ದೃಢಭಕ್ತ್ಯಾ ನಿರ್ಭಯತಾಮ್ ಈಶ್ವರಸ್ಯ ಸಮಾಗಮೇ ಸಾಮರ್ಥ್ಯಞ್ಚ</para>
  <para style="p">
    <verse number="12" style="v"/>ಪ್ರಾಪ್ತವನ್ತಸ್ತಮಸ್ಮಾಕಂ ಪ್ರಭುಂ ಯೀಶುಂ ಖ್ರೀಷ್ಟಮಧಿ ಸ ಕಾಲಾವಸ್ಥಾಯಾಃ ಪೂರ್ವ್ವಂ ತಂ ಮನೋರಥಂ ಕೃತವಾನ್|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅತೋಽಹಂ ಯುಷ್ಮನ್ನಿಮಿತ್ತಂ ದುಃಖಭೋಗೇನ ಕ್ಲಾನ್ತಿಂ ಯನ್ನ ಗಚ್ಛಾಮೀತಿ ಪ್ರಾರ್ಥಯೇ ಯತಸ್ತದೇವ ಯುಷ್ಮಾಕಂ ಗೌರವಂ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಅತೋ ಹೇತೋಃ ಸ್ವರ್ಗಪೃಥಿವ್ಯೋಃ ಸ್ಥಿತಃ ಕೃತ್ಸ್ನೋ ವಂಶೋ ಯಸ್ಯ ನಾಮ್ನಾ ವಿಖ್ಯಾತಸ್ತಮ್</para>
  <para style="p">
    <verse number="15" style="v"/>ಅಸ್ಮತ್ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಪಿತರಮುದ್ದಿಶ್ಯಾಹಂ ಜಾನುನೀ ಪಾತಯಿತ್ವಾ ತಸ್ಯ ಪ್ರಭಾವನಿಧಿತೋ ವರಮಿಮಂ ಪ್ರಾರ್ಥಯೇ|</para>
  <para style="p">
    <verse number="16" style="v"/>ತಸ್ಯಾತ್ಮನಾ ಯುಷ್ಮಾಕಮ್ ಆನ್ತರಿಕಪುರುಷಸ್ಯ ಶಕ್ತೇ ರ್ವೃದ್ಧಿಃ ಕ್ರಿಯತಾಂ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಖ್ರೀಷ್ಟಸ್ತು ವಿಶ್ವಾಸೇನ ಯುಷ್ಮಾಕಂ ಹೃದಯೇಷು ನಿವಸತು| ಪ್ರೇಮಣಿ ಯುಷ್ಮಾಕಂ ಬದ್ಧಮೂಲತ್ವಂ ಸುಸ್ಥಿರತ್ವಞ್ಚ ಭವತು|</para>
  <para style="p">
    <verse number="18" style="v"/>ಇತ್ಥಂ ಪ್ರಸ್ಥತಾಯಾ ದೀರ್ಘತಾಯಾ ಗಭೀರತಾಯಾ ಉಚ್ಚತಾಯಾಶ್ಚ ಬೋಧಾಯ ಸರ್ವ್ವೈಃ ಪವಿತ್ರಲೋಕೈಃ ಪ್ರಾಪ್ಯಂ ಸಾಮರ್ಥ್ಯಂ ಯುಷ್ಮಾಭಿ ರ್ಲಭ್ಯತಾಂ,</para>
  <para style="p">
    <verse number="19" style="v"/>ಜ್ಞಾನಾತಿರಿಕ್ತಂ ಖ್ರೀಷ್ಟಸ್ಯ ಪ್ರೇಮ ಜ್ಞಾಯತಾಮ್ ಈಶ್ವರಸ್ಯ ಸಮ್ಪೂರ್ಣವೃದ್ಧಿಪರ್ಯ್ಯನ್ತಂ ಯುಷ್ಮಾಕಂ ವೃದ್ಧಿ ರ್ಭವತು ಚ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಅಸ್ಮಾಕಮ್ ಅನ್ತರೇ ಯಾ ಶಕ್ತಿಃ ಪ್ರಕಾಶತೇ ತಯಾ ಸರ್ವ್ವಾತಿರಿಕ್ತಂ ಕರ್ಮ್ಮ ಕುರ್ವ್ವನ್ ಅಸ್ಮಾಕಂ ಪ್ರಾರ್ಥನಾಂ ಕಲ್ಪನಾಞ್ಚಾತಿಕ್ರಮಿತುಂ ಯಃ ಶಕ್ನೋತಿ</para>
  <para style="p">
    <verse number="21" style="v"/>ಖ್ರೀಷ್ಟಯೀಶುನಾ ಸಮಿತೇ ರ್ಮಧ್ಯೇ ಸರ್ವ್ವೇಷು ಯುಗೇಷು ತಸ್ಯ ಧನ್ಯವಾದೋ ಭವತು| ಇತಿ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅತೋ ಬನ್ದಿರಹಂ ಪ್ರಭೋ ರ್ನಾಮ್ನಾ ಯುಷ್ಮಾನ್ ವಿನಯೇ ಯೂಯಂ ಯೇನಾಹ್ವಾನೇನಾಹೂತಾಸ್ತದುಪಯುಕ್ತರೂಪೇಣ</para>
  <para style="p">
    <verse number="2" style="v"/>ಸರ್ವ್ವಥಾ ನಮ್ರತಾಂ ಮೃದುತಾಂ ತಿತಿಕ್ಷಾಂ ಪರಸ್ಪರಂ ಪ್ರಮ್ನಾ ಸಹಿಷ್ಣುತಾಞ್ಚಾಚರತ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಪ್ರಣಯಬನ್ಧನೇನ ಚಾತ್ಮನ ಏैಕ್ಯಂ ರಕ್ಷಿತುಂ ಯತಧ್ವಂ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಯೂಯಮ್ ಏಕಶರೀರಾ ಏಕಾತ್ಮಾನಶ್ಚ ತದ್ವದ್ ಆಹ್ವಾನೇನ ಯೂಯಮ್ ಏಕಪ್ರತ್ಯಾಶಾಪ್ರಾಪ್ತಯೇ ಸಮಾಹೂತಾಃ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯುಷ್ಮಾಕಮ್ ಏಕಃ ಪ್ರಭುರೇಕೋ ವಿಶ್ವಾಸ ಏಕಂ ಮಜ್ಜನಂ, ಸರ್ವ್ವೇಷಾಂ ತಾತಃ</para>
  <para style="p">
    <verse number="6" style="v"/>ಸರ್ವ್ವೋಪರಿಸ್ಥಃ ಸರ್ವ್ವವ್ಯಾಪೀ ಸರ್ವ್ವೇಷಾಂ ಯುಷ್ಮಾಕಂ ಮಧ್ಯವರ್ತ್ತೀ ಚೈಕ ಈಶ್ವರ ಆಸ್ತೇ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಕಿನ್ತು ಖ್ರೀಷ್ಟಸ್ಯ ದಾನಪರಿಮಾಣಾನುಸಾರಾದ್ ಅಸ್ಮಾಕಮ್ ಏಕೈಕಸ್ಮೈ ವಿಶೇಷೋ ವರೋಽದಾಯಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಯಥಾ ಲಿಖಿತಮ್ ಆಸ್ತೇ, "ಊರ್ದ್ಧ್ವಮ್ ಆರುಹ್ಯ ಜೇತೃನ್ ಸ ವಿಜಿತ್ಯ ಬನ್ದಿನೋಽಕರೋತ್| ತತಃ ಸ ಮನುಜೇಭ್ಯೋಽಪಿ ಸ್ವೀಯಾನ್ ವ್ಯಶ್ರಾಣಯದ್ ವರಾನ್|| "</para>
  <para style="p">
    <verse number="9" style="v"/>ಊರ್ದ್ಧ್ವಮ್ ಆರುಹ್ಯೇತಿವಾಕ್ಯಸ್ಯಾಯಮರ್ಥಃ ಸ ಪೂರ್ವ್ವಂ ಪೃಥಿವೀರೂಪಂ ಸರ್ವ್ವಾಧಃಸ್ಥಿತಂ ಸ್ಥಾನಮ್ ಅವತೀರ್ಣವಾನ್;</para>
  <para style="p">
    <verse number="10" style="v"/>ಯಶ್ಚಾವತೀರ್ಣವಾನ್ ಸ ಏವ ಸ್ವರ್ಗಾಣಾಮ್ ಉಪರ್ಯ್ಯುಪರ್ಯ್ಯಾರೂಢವಾನ್ ಯತಃ ಸರ್ವ್ವಾಣಿ ತೇನ ಪೂರಯಿತವ್ಯಾನಿ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಸ ಏವ ಚ ಕಾಂಶ್ಚನ ಪ್ರೇರಿತಾನ್ ಅಪರಾನ್ ಭವಿಷ್ಯದ್ವಾದಿನೋಽಪರಾನ್ ಸುಸಂವಾದಪ್ರಚಾರಕಾನ್ ಅಪರಾನ್ ಪಾಲಕಾನ್ ಉಪದೇಶಕಾಂಶ್ಚ ನಿಯುಕ್ತವಾನ್|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯಾವದ್ ವಯಂ ಸರ್ವ್ವೇ ವಿಶ್ವಾಸಸ್ಯೇಶ್ವರಪುತ್ರವಿಷಯಕಸ್ಯ ತತ್ತ್ವಜ್ಞಾನಸ್ಯ ಚೈಕ್ಯಂ ಸಮ್ಪೂರ್ಣಂ ಪುರುಷರ್ಥಞ್ಚಾರ್ಥತಃ ಖ್ರೀಷ್ಟಸ್ಯ ಸಮ್ಪೂರ್ಣಪರಿಮಾಣಸ್ಯ ಸಮಂ ಪರಿಮಾಣಂ ನ ಪ್ರಾಪ್ನುಮಸ್ತಾವತ್</para>
  <para style="p">
    <verse number="13" style="v"/>ಸ ಪರಿಚರ್ಯ್ಯಾಕರ್ಮ್ಮಸಾಧನಾಯ ಖ್ರೀಷ್ಟಸ್ಯ ಶರೀರಸ್ಯ ನಿಷ್ಠಾಯೈ ಚ ಪವಿತ್ರಲೋಕಾನಾಂ ಸಿದ್ಧತಾಯಾಸ್ತಾದೃಶಮ್ ಉಪಾಯಂ ನಿಶ್ಚಿತವಾನ್|</para>
  <para style="p">
    <verse number="14" style="v"/>ಅತಏವ ಮಾನುಷಾಣಾಂ ಚಾತುರೀತೋ ಭ್ರಮಕಧೂರ್ತ್ತತಾಯಾಶ್ಛಲಾಚ್ಚ ಜಾತೇನ ಸರ್ವ್ವೇಣ ಶಿಕ್ಷಾವಾಯುನಾ ವಯಂ ಯದ್ ಬಾಲಕಾ ಇವ ದೋಲಾಯಮಾನಾ ನ ಭ್ರಾಮ್ಯಾಮ ಇತ್ಯಸ್ಮಾಭಿ ರ್ಯತಿತವ್ಯಂ,</para>
  <para style="p">
    <verse number="15" style="v"/>ಪ್ರೇಮ್ನಾ ಸತ್ಯತಾಮ್ ಆಚರದ್ಭಿಃ ಸರ್ವ್ವವಿಷಯೇ ಖ್ರೀಷ್ಟಮ್ ಉದ್ದಿಶ್ಯ ವರ್ದ್ಧಿತವ್ಯಞ್ಚ, ಯತಃ ಸ ಮೂರ್ದ್ಧಾ,</para>
  <para style="p">
    <verse number="16" style="v"/>ತಸ್ಮಾಚ್ಚೈಕೈಕಸ್ಯಾಙ್ಗಸ್ಯ ಸ್ವಸ್ವಪರಿಮಾಣಾನುಸಾರೇಣ ಸಾಹಾಯ್ಯಕರಣಾದ್ ಉಪಕಾರಕೈಃ ಸರ್ವ್ವೈಃ ಸನ್ಧಿಭಿಃ ಕೃತ್ಸ್ನಸ್ಯ ಶರೀರಸ್ಯ ಸಂಯೋಗೇ ಸಮ್ಮಿಲನೇ ಚ ಜಾತೇ ಪ್ರೇಮ್ನಾ ನಿಷ್ಠಾಂ ಲಭಮಾನಂ ಕೃತ್ಸ್ನಂ ಶರೀರಂ ವೃದ್ಧಿಂ ಪ್ರಾಪ್ನೋತಿ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಯುಷ್ಮಾನ್ ಅಹಂ ಪ್ರಭುನೇದಂ ಬ್ರವೀಮ್ಯಾದಿಶಾಮಿ ಚ, ಅನ್ಯೇ ಭಿನ್ನಜಾತೀಯಾ ಇವ ಯೂಯಂ ಪೂನ ರ್ಮಾಚರತ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಯತಸ್ತೇ ಸ್ವಮನೋಮಾಯಾಮ್ ಆಚರನ್ತ್ಯಾನ್ತರಿಕಾಜ್ಞಾನಾತ್ ಮಾನಸಿಕಕಾಠಿನ್ಯಾಚ್ಚ ತಿಮಿರಾವೃತಬುದ್ಧಯ ಈಶ್ವರೀಯಜೀವನಸ್ಯ ಬಗೀರ್ಭೂತಾಶ್ಚ ಭವನ್ತಿ,</para>
  <para style="p">
    <verse number="19" style="v"/>ಸ್ವಾನ್ ಚೈತನ್ಯಶೂನ್ಯಾನ್ ಕೃತ್ವಾ ಚ ಲೋಭೇನ ಸರ್ವ್ವವಿಧಾಶೌಚಾಚರಣಾಯ ಲಮ್ಪಟತಾಯಾಂ ಸ್ವಾನ್ ಸಮರ್ಪಿತವನ್ತಃ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಕಿನ್ತು ಯೂಯಂ ಖ್ರೀಷ್ಟಂ ನ ತಾದೃಶಂ ಪರಿಚಿತವನ್ತಃ,</para>
  <para style="p">
    <verse number="21" style="v"/>ಯತೋ ಯೂಯಂ ತಂ ಶ್ರುತವನ್ತೋ ಯಾ ಸತ್ಯಾ ಶಿಕ್ಷಾ ಯೀಶುತೋ ಲಭ್ಯಾ ತದನುಸಾರಾತ್ ತದೀಯೋಪದೇಶಂ ಪ್ರಾಪ್ತವನ್ತಶ್ಚೇತಿ ಮನ್ಯೇ|</para>
  <para style="p">
    <verse number="22" style="v"/>ತಸ್ಮಾತ್ ಪೂರ್ವ್ವಕಾಲಿಕಾಚಾರಕಾರೀ ಯಃ ಪುರಾತನಪುರುಷೋ ಮಾಯಾಭಿಲಾಷೈ ರ್ನಶ್ಯತಿ ತಂ ತ್ಯಕ್ತ್ವಾ ಯುಷ್ಮಾಭಿ ರ್ಮಾನಸಿಕಭಾವೋ ನೂತನೀಕರ್ತ್ತವ್ಯಃ,</para>
  <para style="p">
    <verse number="23" style="v"/>ಯೋ ನವಪುರುಷ ಈಶ್ವರಾನುರೂಪೇಣ ಪುಣ್ಯೇನ ಸತ್ಯತಾಸಹಿತೇನ</para>
  <para style="p">
    <verse number="24" style="v"/>ಧಾರ್ಮ್ಮಿಕತ್ವೇನ ಚ ಸೃಷ್ಟಃ ಸ ಏವ ಪರಿಧಾತವ್ಯಶ್ಚ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಅತೋ ಯೂಯಂ ಸರ್ವ್ವೇ ಮಿಥ್ಯಾಕಥನಂ ಪರಿತ್ಯಜ್ಯ ಸಮೀಪವಾಸಿಭಿಃ ಸಹ ಸತ್ಯಾಲಾಪಂ ಕುರುತ ಯತೋ ವಯಂ ಪರಸ್ಪರಮ್ ಅಙ್ಗಪ್ರತ್ಯಙ್ಗಾ ಭವಾಮಃ|</para>
  <para style="p">
    <verse number="26" style="v"/>ಅಪರಂ ಕ್ರೋಧೇ ಜಾತೇ ಪಾಪಂ ಮಾ ಕುರುಧ್ವಮ್, ಅಶಾನ್ತೇ ಯುಷ್ಮಾಕಂ ರೋಷೇಸೂರ್ಯ್ಯೋಽಸ್ತಂ ನ ಗಚ್ಛತು|</para>
  <para style="p">
    <verse number="27" style="v"/>ಅಪರಂ ಶಯತಾನೇ ಸ್ಥಾನಂ ಮಾ ದತ್ತ|</para>
  <para style="p">
    <verse number="28" style="v"/>ಚೋರಃ ಪುನಶ್ಚೈರ್ಯ್ಯಂ ನ ಕರೋತು ಕಿನ್ತು ದೀನಾಯ ದಾನೇ ಸಾಮರ್ಥ್ಯಂ ಯಜ್ಜಾಯತೇ ತದರ್ಥಂ ಸ್ವಕರಾಭ್ಯಾಂ ಸದ್ವೃತ್ತ್ಯಾ ಪರಿಶ್ರಮಂ ಕರೋತು|</para>
  <para style="p">
    <verse number="29" style="v"/>ಅಪರಂ ಯುಷ್ಮಾಕಂ ವದನೇಭ್ಯಃ ಕೋಽಪಿ ಕದಾಲಾಪೋ ನ ನಿರ್ಗಚ್ಛತು, ಕಿನ್ತು ಯೇನ ಶ್ರೋತುರುಪಕಾರೋ ಜಾಯತೇ ತಾದೃಶಃ ಪ್ರಯೋಜನೀಯನಿಷ್ಠಾಯೈ ಫಲದಾಯಕ ಆಲಾಪೋ ಯುಷ್ಮಾಕಂ ಭವತು|</para>
  <para style="p">
    <verse number="30" style="v"/>ಅಪರಞ್ಚ ಯೂಯಂ ಮುಕ್ತಿದಿನಪರ್ಯ್ಯನ್ತಮ್ ಈಶ್ವರಸ್ಯ ಯೇನ ಪವಿತ್ರೇಣಾತ್ಮನಾ ಮುದ್ರಯಾಙ್ಕಿತಾ ಅಭವತ ತಂ ಶೋಕಾನ್ವಿತಂ ಮಾ ಕುರುತ|</para>
  <para style="p">
    <verse number="31" style="v"/>ಅಪರಂ ಕಟುವಾಕ್ಯಂ ರೋಷಃ ಕೋಷಃ ಕಲಹೋ ನಿನ್ದಾ ಸರ್ವ್ವವಿಧದ್ವೇಷಶ್ಚೈತಾನಿ ಯುಷ್ಮಾಕಂ ಮಧ್ಯಾದ್ ದೂರೀಭವನ್ತು|</para>
  <para style="p">
    <verse number="32" style="v"/>ಯೂಯಂ ಪರಸ್ಪರಂ ಹಿತೈಷಿಣಃ ಕೋಮಲಾನ್ತಃಕರಣಾಶ್ಚ ಭವತ| ಅಪರಮ್ ಈಶ್ವರಃ ಖ್ರೀಷ್ಟೇನ ಯದ್ವದ್ ಯುಷ್ಮಾಕಂ ದೋಷಾನ್ ಕ್ಷಮಿತವಾನ್ ತದ್ವದ್ ಯೂಯಮಪಿ ಪರಸ್ಪರಂ ಕ್ಷಮಧ್ವಂ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅತೋ ಯೂಯಂ ಪ್ರಿಯಬಾಲಕಾ ಇವೇಶ್ವರಸ್ಯಾನುಕಾರಿಣೋ ಭವತ,</para>
  <para style="p">
    <verse number="2" style="v"/>ಖ್ರೀಷ್ಟ ಇವ ಪ್ರೇಮಾಚಾರಂ ಕುರುತ ಚ, ಯತಃ ಸೋಽಸ್ಮಾಸು ಪ್ರೇಮ ಕೃತವಾನ್ ಅಸ್ಮಾಕಂ ವಿನಿಮಯೇನ ಚಾತ್ಮನಿವೇದನಂ ಕೃತ್ವಾ ಗ್ರಾಹ್ಯಸುಗನ್ಧಾರ್ಥಕಮ್ ಉಪಹಾರಂ ಬಲಿಞ್ಚೇಶ್ವರಾಚ ದತ್ತವಾನ್|</para>
  <para style="p">
    <verse number="3" style="v"/>ಕಿನ್ತು ವೇಶ್ಯಾಗಮನಂ ಸರ್ವ್ವವಿಧಾಶೌಚಕ್ರಿಯಾ ಲೋಭಶ್ಚೈತೇಷಾಮ್ ಉಚ್ಚಾರಣಮಪಿ ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ನ ಭವತು, ಏತದೇವ ಪವಿತ್ರಲೋಕಾನಾಮ್ ಉಚಿತಂ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಅಪರಂ ಕುತ್ಸಿತಾಲಾಪಃ ಪ್ರಲಾಪಃ ಶ್ಲೇಷೋಕ್ತಿಶ್ಚ ನ ಭವತು ಯತ ಏತಾನ್ಯನುಚಿತಾನಿ ಕಿನ್ತ್ವೀಶ್ವರಸ್ಯ ಧನ್ಯವಾದೋ ಭವತು|</para>
  <para style="p">
    <verse number="5" style="v"/>ವೇಶ್ಯಾಗಾಮ್ಯಶೌಚಾಚಾರೀ ದೇವಪೂಜಕ ಇವ ಗಣ್ಯೋ ಲೋಭೀ ಚೈತೇಷಾಂ ಕೋಷಿ ಖ್ರೀಷ್ಟಸ್ಯ ರಾಜ್ಯೇಽರ್ಥತ ಈಶ್ವರಸ್ಯ ರಾಜ್ಯೇ ಕಮಪ್ಯಧಿಕಾರಂ ನ ಪ್ರಾಪ್ಸ್ಯತೀತಿ ಯುಷ್ಮಾಭಿಃ ಸಮ್ಯಕ್ ಜ್ಞಾಯತಾಂ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅನರ್ಥಕವಾಕ್ಯೇನ ಕೋಽಪಿ ಯುಷ್ಮಾನ್ ನ ವಞ್ಚಯತು ಯತಸ್ತಾದೃಗಾಚಾರಹೇತೋರನಾಜ್ಞಾಗ್ರಾಹಿಷು ಲೋಕೇಷ್ವೀಶ್ವರಸ್ಯ ಕೋಪೋ ವರ್ತ್ತತೇ|</para>
  <para style="p">
    <verse number="7" style="v"/>ತಸ್ಮಾದ್ ಯೂಯಂ ತೈಃ ಸಹಭಾಗಿನೋ ನ ಭವತ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಪೂರ್ವ್ವಂ ಯೂಯಮ್ ಅನ್ಧಕಾರಸ್ವರೂಪಾ ಆಧ್ವಂ ಕಿನ್ತ್ವಿದಾನೀಂ ಪ್ರಭುನಾ ದೀಪ್ತಿಸ್ವರೂಪಾ ಭವಥ ತಸ್ಮಾದ್ ದೀಪ್ತೇಃ ಸನ್ತಾನಾ ಇವ ಸಮಾಚರತ|</para>
  <para style="p">
    <verse number="9" style="v"/>ದೀಪ್ತೇ ರ್ಯತ್ ಫಲಂ ತತ್ ಸರ್ವ್ವವಿಧಹಿತೈಷಿತಾಯಾಂ ಧರ್ಮ್ಮೇ ಸತ್ಯಾಲಾಪೇ ಚ ಪ್ರಕಾಶತೇ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಪ್ರಭವೇ ಯದ್ ರೋಚತೇ ತತ್ ಪರೀಕ್ಷಧ್ವಂ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಯೂಯಂ ತಿಮಿರಸ್ಯ ವಿಫಲಕರ್ಮ್ಮಣಾಮ್ ಅಂಶಿನೋ ನ ಭೂತ್ವಾ ತೇಷಾಂ ದೋಷಿತ್ವಂ ಪ್ರಕಾಶಯತ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯತಸ್ತೇ ಲೋಕಾ ರಹಮಿ ಯದ್ ಯದ್ ಆಚರನ್ತಿ ತದುಚ್ಚಾರಣಮ್ ಅಪಿ ಲಜ್ಜಾಜನಕಂ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯತೋ ದೀಪ್ತ್ಯಾ ಯದ್ ಯತ್ ಪ್ರಕಾಶ್ಯತೇ ತತ್ ತಯಾ ಚಕಾಸ್ಯತೇ ಯಚ್ಚ ಚಕಾಸ್ತಿ ತದ್ ದೀಪ್ತಿಸ್ವರೂಪಂ ಭವತಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಏತತ್ಕಾರಣಾದ್ ಉಕ್ತಮ್ ಆಸ್ತೇ, "ಹೇ ನಿದ್ರಿತ ಪ್ರಬುಧ್ಯಸ್ವ ಮೃತೇಭ್ಯಶ್ಚೋತ್ಥಿತಿಂ ಕುರು| ತತ್ಕೃತೇ ಸೂರ್ಯ್ಯವತ್ ಖ್ರೀಷ್ಟಃ ಸ್ವಯಂ ತ್ವಾಂ ದ್ಯೋತಯಿಷ್ಯತಿ| "</para>
  <para style="p">
    <verse number="15" style="v"/>ಅತಃ ಸಾವಧಾನಾ ಭವತ, ಅಜ್ಞಾನಾ ಇವ ಮಾಚರತ ಕಿನ್ತು ಜ್ಞಾನಿನ ಇವ ಸತರ್ಕಮ್ ಆಚರತ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಸಮಯಂ ಬಹುಮೂಲ್ಯಂ ಗಣಯಧ್ವಂ ಯತಃ ಕಾಲಾ ಅಭದ್ರಾಃ|</para>
  <para style="p">
    <verse number="17" style="v"/>ತಸ್ಮಾದ್ ಯೂಯಮ್ ಅಜ್ಞಾನಾ ನ ಭವತ ಕಿನ್ತು ಪ್ರಭೋರಭಿಮತಂ ಕಿಂ ತದವಗತಾ ಭವತ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಸರ್ವ್ವನಾಶಜನಕೇನ ಸುರಾಪಾನೇನ ಮತ್ತಾ ಮಾ ಭವತ ಕಿನ್ತ್ವಾತ್ಮನಾ ಪೂರ್ಯ್ಯಧ್ವಂ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಅಪರಂ ಗೀತೈ ರ್ಗಾನೈಃ ಪಾರಮಾರ್ಥಿಕಕೀರ್ತ್ತನೈಶ್ಚ ಪರಸ್ಪರಮ್ ಆಲಪನ್ತೋ ಮನಸಾ ಸಾರ್ದ್ಧಂ ಪ್ರಭುಮ್ ಉದ್ದಿಶ್ಯ ಗಾಯತ ವಾದಯತ ಚ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಸರ್ವ್ವದಾ ಸರ್ವ್ವವಿಷಯೇಽಸ್ಮತ್ಪ್ರಭೋ ಯೀಶೋಃ ಖ್ರೀಷ್ಟಸ್ಯ ನಾಮ್ನಾ ತಾತಮ್ ಈಶ್ವರಂ ಧನ್ಯಂ ವದತ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಯೂಯಮ್ ಈಶ್ವರಾದ್ ಭೀತಾಃ ಸನ್ತ ಅನ್ಯೇಽಪರೇಷಾಂ ವಶೀಭೂತಾ ಭವತ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಹೇ ಯೋಷಿತಃ, ಯೂಯಂ ಯಥಾ ಪ್ರಭೋಸ್ತಥಾ ಸ್ವಸ್ವಸ್ವಾಮಿನೋ ವಶಙ್ಗತಾ ಭವತ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಯತಃ ಖ್ರೀಷ್ಟೋ ಯದ್ವತ್ ಸಮಿತೇ ರ್ಮೂರ್ದ್ಧಾ ಶರೀರಸ್ಯ ತ್ರಾತಾ ಚ ಭವತಿ ತದ್ವತ್ ಸ್ವಾಮೀ ಯೋಷಿತೋ ಮೂರ್ದ್ಧಾ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಅತಃ ಸಮಿತಿ ರ್ಯದ್ವತ್ ಖ್ರೀಷ್ಟಸ್ಯ ವಶೀಭೂತಾ ತದ್ವದ್ ಯೋಷಿದ್ಭಿರಪಿ ಸ್ವಸ್ವಸ್ವಾಮಿನೋ ವಶತಾ ಸ್ವೀಕರ್ತ್ತವ್ಯಾ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಅಪರಞ್ಚ ಹೇ ಪುರುಷಾಃ, ಯೂಯಂ ಖ್ರೀಷ್ಟ ಇವ ಸ್ವಸ್ವಯೋಷಿತ್ಸು ಪ್ರೀಯಧ್ವಂ|</para>
  <para style="p">
    <verse number="26" style="v"/>ಸ ಖ್ರೀಷ್ಟೋಽಪಿ ಸಮಿತೌ ಪ್ರೀತವಾನ್ ತಸ್ಯಾಃ ಕೃತೇ ಚ ಸ್ವಪ್ರಾಣಾನ್ ತ್ಯಕ್ತವಾನ್ ಯತಃ ಸ ವಾಕ್ಯೇ ಜಲಮಜ್ಜನೇನ ತಾಂ ಪರಿಷ್ಕೃತ್ಯ ಪಾವಯಿತುಮ್</para>
  <para style="p">
    <verse number="27" style="v"/>ಅಪರಂ ತಿಲಕವಲ್ಯಾದಿವಿಹೀನಾಂ ಪವಿತ್ರಾಂ ನಿಷ್ಕಲಙ್ಕಾಞ್ಚ ತಾಂ ಸಮಿತಿಂ ತೇಜಸ್ವಿನೀಂ ಕೃತ್ವಾ ಸ್ವಹಸ್ತೇ ಸಮರ್ಪಯಿತುಞ್ಚಾಭಿಲಷಿತವಾನ್|</para>
  <para style="p">
    <verse number="28" style="v"/>ತಸ್ಮಾತ್ ಸ್ವತನುವತ್ ಸ್ವಯೋಷಿತಿ ಪ್ರೇಮಕರಣಂ ಪುರುಷಸ್ಯೋಚಿತಂ, ಯೇನ ಸ್ವಯೋಷಿತಿ ಪ್ರೇಮ ಕ್ರಿಯತೇ ತೇನಾತ್ಮಪ್ರೇಮ ಕ್ರಿಯತೇ|</para>
  <para style="p">
    <verse number="29" style="v"/>ಕೋಽಪಿ ಕದಾಪಿ ನ ಸ್ವಕೀಯಾಂ ತನುಮ್ ಋತೀಯಿತವಾನ್ ಕಿನ್ತು ಸರ್ವ್ವೇ ತಾಂ ವಿಭ್ರತಿ ಪುಷ್ಣನ್ತಿ ಚ| ಖ್ರೀಷ್ಟೋಽಪಿ ಸಮಿತಿಂ ಪ್ರತಿ ತದೇವ ಕರೋತಿ,</para>
  <para style="p">
    <verse number="30" style="v"/>ಯತೋ ವಯಂ ತಸ್ಯ ಶರೀರಸ್ಯಾಙ್ಗಾನಿ ಮಾಂಸಾಸ್ಥೀನಿ ಚ ಭವಾಮಃ|</para>
  <para style="p">
    <verse number="31" style="v"/>ಏತದರ್ಥಂ ಮಾನವಃ ಸ್ವಮಾತಾಪಿತರೋै ಪರಿತ್ಯಜ್ಯ ಸ್ವಭಾರ್ಯ್ಯಾಯಾಮ್ ಆಸಂಕ್ಷ್ಯತಿ ತೌ ದ್ವೌ ಜನಾವೇಕಾಙ್ಗೌ ಭವಿಷ್ಯತಃ|</para>
  <para style="p">
    <verse number="32" style="v"/>ಏತನ್ನಿಗೂಢವಾಕ್ಯಂ ಗುರುತರಂ ಮಯಾ ಚ ಖ್ರೀಷ್ಟಸಮಿತೀ ಅಧಿ ತದ್ ಉಚ್ಯತೇ|</para>
  <para style="p">
    <verse number="33" style="v"/>ಅತಏವ ಯುಷ್ಮಾಕಮ್ ಏಕೈಕೋ ಜನ ಆತ್ಮವತ್ ಸ್ವಯೋಷಿತಿ ಪ್ರೀಯತಾಂ ಭಾರ್ಯ್ಯಾಪಿ ಸ್ವಾಮಿನಂ ಸಮಾದರ್ತ್ತುಂ ಯತತಾಂ|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಬಾಲಕಾಃ, ಯೂಯಂ ಪ್ರಭುಮ್ ಉದ್ದಿಶ್ಯ ಪಿತ್ರೋರಾಜ್ಞಾಗ್ರಾಹಿಣೋ ಭವತ ಯತಸ್ತತ್ ನ್ಯಾಯ್ಯಂ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತ್ವಂ ನಿಜಪಿತರಂ ಮಾತರಞ್ಚ ಸಮ್ಮನ್ಯಸ್ವೇತಿ ಯೋ ವಿಧಿಃ ಸ ಪ್ರತಿಜ್ಞಾಯುಕ್ತಃ ಪ್ರಥಮೋ ವಿಧಿಃ</para>
  <para style="p">
    <verse number="3" style="v"/>ಫಲತಸ್ತಸ್ಮಾತ್ ತವ ಕಲ್ಯಾಣಂ ದೇಶೇ ಚ ದೀರ್ಘಕಾಲಮ್ ಆಯು ರ್ಭವಿಷ್ಯತೀತಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಅಪರಂ ಹೇ ಪಿತರಃ, ಯೂಯಂ ಸ್ವಬಾಲಕಾನ್ ಮಾ ರೋಷಯತ ಕಿನ್ತು ಪ್ರಭೋ ರ್ವಿನೀತ್ಯಾದೇಶಾಭ್ಯಾಂ ತಾನ್ ವಿನಯತ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಹೇ ದಾಸಾಃ, ಯೂಯಂ ಖ್ರೀಷ್ಟಮ್ ಉದ್ದಿಶ್ಯ ಸಭಯಾಃ ಕಮ್ಪಾನ್ವಿತಾಶ್ಚ ಭೂತ್ವಾ ಸರಲಾನ್ತಃಕರಣೈರೈಹಿಕಪ್ರಭೂನಾಮ್ ಆಜ್ಞಾಗ್ರಾಹಿಣೋ ಭವತ|</para>
  <para style="p">
    <verse number="6" style="v"/>ದೃಷ್ಟಿಗೋಚರೀಯಪರಿಚರ್ಯ್ಯಯಾ ಮಾನುಷೇಭ್ಯೋ ರೋಚಿತುಂ ಮಾ ಯತಧ್ವಂ ಕಿನ್ತು ಖ್ರೀಷ್ಟಸ್ಯ ದಾಸಾ ಇವ ನಿವಿಷ್ಟಮನೋಭಿರೀಶ್ಚರಸ್ಯೇಚ್ಛಾಂ ಸಾಧಯತ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಮಾನವಾನ್ ಅನುದ್ದಿಶ್ಯ ಪ್ರಭುಮೇವೋದ್ದಿಶ್ಯ ಸದ್ಭಾವೇನ ದಾಸ್ಯಕರ್ಮ್ಮ ಕುರುಧ್ವಂ|</para>
  <para style="p">
    <verse number="8" style="v"/>ದಾಸಮುಕ್ತಯೋ ರ್ಯೇನ ಯತ್ ಸತ್ಕರ್ಮ್ಮ ಕ್ರಿಯತೇ ತೇನ ತಸ್ಯ ಫಲಂ ಪ್ರಭುತೋ ಲಪ್ಸ್ಯತ ಇತಿ ಜಾನೀತ ಚ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಅಪರಂ ಹೇ ಪ್ರಭವಃ, ಯುಷ್ಮಾಭಿ ರ್ಭರ್ತ್ಸನಂ ವಿಹಾಯ ತಾನ್ ಪ್ರತಿ ನ್ಯಾಯ್ಯಾಚರಣಂ ಕ್ರಿಯತಾಂ ಯಶ್ಚ ಕಸ್ಯಾಪಿ ಪಕ್ಷಪಾತಂ ನ ಕರೋತಿ ಯುಷ್ಮಾಕಮಪಿ ತಾದೃಶ ಏಕಃ ಪ್ರಭುಃ ಸ್ವರ್ಗೇ ವಿದ್ಯತ ಇತಿ ಜ್ಞಾಯತಾಂ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಅಧಿಕನ್ತು ಹೇ ಭ್ರಾತರಃ, ಯೂಯಂ ಪ್ರಭುನಾ ತಸ್ಯ ವಿಕ್ರಮಯುಕ್ತಶಕ್ತ್ಯಾ ಚ ಬಲವನ್ತೋ ಭವತ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಯೂಯಂ ಯತ್ ಶಯತಾನಶ್ಛಲಾನಿ ನಿವಾರಯಿತುಂ ಶಕ್ನುಥ ತದರ್ಥಮ್ ಈಶ್ವರೀಯಸುಸಜ್ಜಾಂ ಪರಿಧದ್ಧ್ವಂ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯತಃ ಕೇವಲಂ ರಕ್ತಮಾಂಸಾಭ್ಯಾಮ್ ಇತಿ ನಹಿ ಕಿನ್ತು ಕರ್ತೃತ್ವಪರಾಕ್ರಮಯುಕ್ತೈಸ್ತಿಮಿರರಾಜ್ಯಸ್ಯೇಹಲೋಕಸ್ಯಾಧಿಪತಿಭಿಃ ಸ್ವರ್ಗೋದ್ಭವೈ ರ್ದುಷ್ಟಾತ್ಮಭಿರೇವ ಸಾರ್ದ್ಧಮ್ ಅಸ್ಮಾಭಿ ರ್ಯುದ್ಧಂ ಕ್ರಿಯತೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅತೋ ಹೇತೋ ರ್ಯೂಯಂ ಯಯಾ ಸಂಕುेಲೇ ದಿನೇಽವಸ್ಥಾತುಂ ಸರ್ವ್ವಾಣಿ ಪರಾಜಿತ್ಯ ದೃಢಾಃ ಸ್ಥಾತುಞ್ಚ ಶಕ್ಷ್ಯಥ ತಾಮ್ ಈಶ್ವರೀಯಸುಸಜ್ಜಾಂ ಗೃಹ್ಲೀತ|</para>
  <para style="p">
    <verse number="14" style="v"/>ವಸ್ತುತಸ್ತು ಸತ್ಯತ್ವೇನ ಶೃಙ್ಖಲೇನ ಕಟಿಂ ಬದ್ಧ್ವಾ ಪುಣ್ಯೇನ ವರ್ಮ್ಮಣಾ ವಕ್ಷ ಆಚ್ಛಾದ್ಯ</para>
  <para style="p">
    <verse number="15" style="v"/>ಶಾನ್ತೇಃ ಸುವಾರ್ತ್ತಯಾ ಜಾತಮ್ ಉತ್ಸಾಹಂ ಪಾದುಕಾಯುಗಲಂ ಪದೇ ಸಮರ್ಪ್ಯ ತಿಷ್ಠತ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯೇನ ಚ ದುಷ್ಟಾತ್ಮನೋಽಗ್ನಿಬಾಣಾನ್ ಸರ್ವ್ವಾನ್ ನಿರ್ವ್ವಾಪಯಿತುಂ ಶಕ್ಷ್ಯಥ ತಾದೃಶಂ ಸರ್ವ್ವಾಚ್ಛಾದಕಂ ಫಲಕಂ ವಿಶ್ವಾಸಂ ಧಾರಯತ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಶಿರಸ್ತ್ರಂ ಪರಿತ್ರಾಣಮ್ ಆತ್ಮನಃ ಖಙ್ಗಞ್ಚೇಶ್ವರಸ್ಯ ವಾಕ್ಯಂ ಧಾರಯತ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಸರ್ವ್ವಸಮಯೇ ಸರ್ವ್ವಯಾಚನೇನ ಸರ್ವ್ವಪ್ರಾರ್ಥನೇನ ಚಾತ್ಮನಾ ಪ್ರಾರ್ಥನಾಂ ಕುರುಧ್ವಂ ತದರ್ಥಂ ದೃಢಾಕಾಙ್ಕ್ಷಯಾ ಜಾಗ್ರತಃ ಸರ್ವ್ವೇಷಾಂ ಪವಿತ್ರಲೋಕಾನಾಂ ಕೃತೇ ಸದಾ ಪ್ರಾರ್ಥನಾಂ ಕುರುಧ್ವಂ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಅಹಞ್ಚ ಯಸ್ಯ ಸುಸಂವಾದಸ್ಯ ಶೃಙ್ಖಲಬದ್ಧಃ ಪ್ರಚಾರಕದೂತೋಽಸ್ಮಿ ತಮ್ ಉಪಯುಕ್ತೇನೋತ್ಸಾಹೇನ ಪ್ರಚಾರಯಿತುಂ ಯಥಾ ಶಕ್ನುಯಾಂ</para>
  <para style="p">
    <verse number="20" style="v"/>ತಥಾ ನಿರ್ಭಯೇನ ಸ್ವರೇಣೋತ್ಸಾಹೇನ ಚ ಸುಸಂವಾದಸ್ಯ ನಿಗೂಢವಾಕ್ಯಪ್ರಚಾರಾಯ ವಕ್ತೃाತಾ ಯತ್ ಮಹ್ಯಂ ದೀಯತೇ ತದರ್ಥಂ ಮಮಾಪಿ ಕೃತೇ ಪ್ರಾರ್ಥನಾಂ ಕುರುಧ್ವಂ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಅಪರಂ ಮಮ ಯಾವಸ್ಥಾಸ್ತಿ ಯಚ್ಚ ಮಯಾ ಕ್ರಿಯತೇ ತತ್ ಸರ್ವ್ವಂ ಯದ್ ಯುಷ್ಮಾಭಿ ರ್ಜ್ಞಾಯತೇ ತದರ್ಥಂ ಪ್ರಭುನಾ ಪ್ರಿಯಭ್ರಾತಾ ವಿಶ್ವಾಸ್ಯಃ ಪರಿಚಾರಕಶ್ಚ ತುಖಿಕೋ ಯುಷ್ಮಾನ್ ತತ್ ಜ್ಞಾಪಯಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಯೂಯಂ ಯದ್ ಅಸ್ಮಾಕಮ್ ಅವಸ್ಥಾಂ ಜಾನೀಥ ಯುಷ್ಮಾಕಂ ಮನಾಂಸಿ ಚ ಯತ್ ಸಾನ್ತ್ವನಾಂ ಲಭನ್ತೇ ತದರ್ಥಮೇವಾಹಂ ಯುಷ್ಮಾಕಂ ಸನ್ನಿಧಿಂ ತಂ ಪ್ರೇಷಿತವಾನ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಅಪರಮ್ ಈಶ್ವರಃ ಪ್ರಭು ರ್ಯೀಶುಖ್ರೀಷ್ಟಶ್ಚ ಸರ್ವ್ವೇಭ್ಯೋ ಭ್ರಾತೃಭ್ಯಃ ಶಾನ್ತಿಂ ವಿಶ್ವಾಸಸಹಿತಂ ಪ್ರೇಮ ಚ ದೇಯಾತ್|</para>
  <para style="p">
    <verse number="24" style="v"/>ಯೇ ಕೇಚಿತ್ ಪ್ರಭೌ ಯೀಶುಖ್ರೀಷ್ಟೇಽಕ್ಷಯಂ ಪ್ರೇಮ ಕುರ್ವ್ವನ್ತಿ ತಾನ್ ಪ್ರತಿ ಪ್ರಸಾದೋ ಭೂಯಾತ್| ತಥಾಸ್ತು|</para>
</usx>
