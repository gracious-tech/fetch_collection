<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="JUD" style="id">Sanskrit Bible (NT) in Kannada Script (ಸತ್ಯವೇದಃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Jude</para>
  <para style="toc1">ಯಿಹೂದಾಃ ಪತ್ರಂ</para>
  <para style="toc2">ಯಿಹೂದಾಃ</para>
  <para style="toc3">ಯಿಹೂದಾಃ</para>
  <para style="mt1">ಯಿಹೂದಾಃ ಪತ್ರಂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ದಾಸೋ ಯಾಕೂಬೋ ಭ್ರಾತಾ ಯಿಹೂದಾಸ್ತಾತೇನೇಶ್ವರೇಣ ಪವಿತ್ರೀಕೃತಾನ್ ಯೀಶುಖ್ರೀಷ್ಟೇನ ರಕ್ಷಿತಾಂಶ್ಚಾಹೂತಾನ್ ಲೋಕಾನ್ ಪ್ರತಿ ಪತ್ರಂ ಲಿಖತಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಕೃಪಾ ಶಾನ್ತಿಃ ಪ್ರೇಮ ಚ ಬಾಹುಲ್ಯರೂಪೇಣ ಯುಷ್ಮಾಸ್ವಧಿತಿಷ್ಠತು|</para>
  <para style="p">
    <verse number="3" style="v"/>ಹೇ ಪ್ರಿಯಾಃ, ಸಾಧಾರಣಪರಿತ್ರಾಣಮಧಿ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಲೇಖಿತುಂ ಮಮ ಬಹುಯತ್ನೇ ಜಾತೇ ಪೂರ್ವ್ವಕಾಲೇ ಪವಿತ್ರಲೋಕೇಷು ಸಮರ್ಪಿತೋ ಯೋ ಧರ್ಮ್ಮಸ್ತದರ್ಥಂ ಯೂಯಂ ಪ್ರಾಣವ್ಯಯೇನಾಪಿ ಸಚೇಷ್ಟಾ ಭವತೇತಿ ವಿನಯಾರ್ಥಂ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಪತ್ರಲೇಖನಮಾವಶ್ಯಕಮ್ ಅಮನ್ಯೇ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಯಸ್ಮಾದ್ ಏತದ್ರೂಪದಣ್ಡಪ್ರಾಪ್ತಯೇ ಪೂರ್ವ್ವಂ ಲಿಖಿತಾಃ ಕೇಚಿಜ್ಜನಾ ಅಸ್ಮಾನ್ ಉಪಸೃಪ್ತವನ್ತಃ, ತೇ ಽಧಾರ್ಮ್ಮಿಕಲೋಕಾ ಅಸ್ಮಾಕಮ್ ಈಶ್ವರಸ್ಯಾನುಗ್ರಹಂ ಧ್ವಜೀಕೃತ್ಯ ಲಮ್ಪಟತಾಮ್ ಆಚರನ್ತಿ, ಅದ್ವಿತೀಯೋ ಽಧಿಪತಿ ರ್ಯೋ ಽಸ್ಮಾಕಂ ಪ್ರಭು ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ತಂ ನಾಙ್ಗೀಕುರ್ವ್ವನ್ತಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ತಸ್ಮಾದ್ ಯೂಯಂ ಪುರಾ ಯದ್ ಅವಗತಾಸ್ತತ್ ಪುನ ರ್ಯುಷ್ಮಾನ್ ಸ್ಮಾರಯಿತುಮ್ ಇಚ್ಛಾಮಿ, ಫಲತಃ ಪ್ರಭುರೇಕಕೃತ್ವಃ ಸ್ವಪ್ರಜಾ ಮಿಸರದೇಶಾದ್ ಉದಧಾರ ಯತ್ ತತಃ ಪರಮ್ ಅವಿಶ್ವಾಸಿನೋ ವ್ಯನಾಶಯತ್|</para>
  <para style="p">
    <verse number="6" style="v"/>ಯೇ ಚ ಸ್ವರ್ಗದೂತಾಃ ಸ್ವೀಯಕರ್ತೃತ್ವಪದೇ ನ ಸ್ಥಿತ್ವಾ ಸ್ವವಾಸಸ್ಥಾನಂ ಪರಿತ್ಯಕ್ತವನ್ತಸ್ತಾನ್ ಸ ಮಹಾದಿನಸ್ಯ ವಿಚಾರಾರ್ಥಮ್ ಅನ್ಧಕಾರಮಯೇ ಽಧಃಸ್ಥಾನೇ ಸದಾಸ್ಥಾಯಿಭಿ ರ್ಬನ್ಧನೈರಬಧ್ನಾತ್|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅಪರಂ ಸಿದೋಮಮ್ ಅಮೋರಾ ತನ್ನಿಕಟಸ್ಥನಗರಾಣಿ ಚೈತೇಷಾಂ ನಿವಾಸಿನಸ್ತತ್ಸಮರೂಪಂ ವ್ಯಭಿಚಾರಂ ಕೃತವನ್ತೋ ವಿಷಮಮೈಥುನಸ್ಯ ಚೇಷ್ಟಯಾ ವಿಪಥಂ ಗತವನ್ತಶ್ಚ ತಸ್ಮಾತ್ ತಾನ್ಯಪಿ ದೃಷ್ಟಾನ್ತಸ್ವರೂಪಾಣಿ ಭೂತ್ವಾ ಸದಾತನವಹ್ನಿನಾ ದಣ್ಡಂ ಭುಞ್ಜತೇ|</para>
  <para style="p">
    <verse number="8" style="v"/>ತಥೈವೇಮೇ ಸ್ವಪ್ನಾಚಾರಿಣೋಽಪಿ ಸ್ವಶರೀರಾಣಿ ಕಲಙ್ಕಯನ್ತಿ ರಾಜಾಧೀನತಾಂ ನ ಸ್ವೀಕುರ್ವ್ವನ್ತ್ಯುಚ್ಚಪದಸ್ಥಾನ್ ನಿನ್ದನ್ತಿ ಚ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಕಿನ್ತು ಪ್ರಧಾನದಿವ್ಯದೂತೋ ಮೀಖಾಯೇಲೋ ಯದಾ ಮೂಸಸೋ ದೇಹೇ ಶಯತಾನೇನ ವಿವದಮಾನಃ ಸಮಭಾಷತ ತದಾ ತಿಸ್ಮನ್ ನಿನ್ದಾರೂಪಂ ದಣ್ಡಂ ಸಮರ್ಪಯಿತುಂ ಸಾಹಸಂ ನ ಕೃತ್ವಾಕಥಯತ್ ಪ್ರಭುಸ್ತ್ವಾಂ ಭರ್ತ್ಸಯತಾಂ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಕಿನ್ತ್ವಿಮೇ ಯನ್ನ ಬುಧ್ಯನ್ತೇ ತನ್ನಿನ್ದನ್ತಿ ಯಚ್ಚ ನಿರ್ಬ್ಬೋಧಪಶವ ಇವೇನ್ದ್ರಿಯೈರವಗಚ್ಛನ್ತಿ ತೇನ ನಶ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="11" style="v"/>ತಾನ್ ಧಿಕ್, ತೇ ಕಾಬಿಲೋ ಮಾರ್ಗೇ ಚರನ್ತಿ ಪಾರಿತೋಷಿಕಸ್ಯಾಶಾತೋ ಬಿಲಿಯಮೋ ಭ್ರಾನ್ತಿಮನುಧಾವನ್ತಿ ಕೋರಹಸ್ಯ ದುರ್ಮ್ಮುಖತ್ವೇನ ವಿನಶ್ಯನ್ತಿ ಚ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯುಷ್ಮಾಕಂ ಪ್ರೇಮಭೋಜ್ಯೇಷು ತೇ ವಿಘ್ನಜನಕಾ ಭವನ್ತಿ, ಆತ್ಮಮ್ಭರಯಶ್ಚ ಭೂತ್ವಾ ನಿರ್ಲಜ್ಜಯಾ ಯುಷ್ಮಾಭಿಃ ಸಾರ್ದ್ಧಂ ಭುಞ್ಜತೇ| ತೇ ವಾಯುಭಿಶ್ಚಾಲಿತಾ ನಿಸ್ತೋಯಮೇಘಾ ಹೇಮನ್ತಕಾಲಿಕಾ ನಿಷ್ಫಲಾ ದ್ವಿ ರ್ಮೃತಾ ಉನ್ಮೂಲಿತಾ ವೃಕ್ಷಾಃ,</para>
  <para style="p">
    <verse number="13" style="v"/>ಸ್ವಕೀಯಲಜ್ಜಾಫೇಣೋದ್ವಮಕಾಃ ಪ್ರಚಣ್ಡಾಃ ಸಾಮುದ್ರತರಙ್ಗಾಃ ಸದಾಕಾಲಂ ಯಾವತ್ ಘೋರತಿಮಿರಭಾಗೀನಿ ಭ್ರಮಣಕಾರೀಣಿ ನಕ್ಷತ್ರಾಣಿ ಚ ಭವನ್ತಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಆದಮತಃ ಸಪ್ತಮಃ ಪುರುಷೋ ಯೋ ಹನೋಕಃ ಸ ತಾನುದ್ದಿಶ್ಯ ಭವಿಷ್ಯದ್ವಾಕ್ಯಮಿದಂ ಕಥಿತವಾನ್, ಯಥಾ, ಪಶ್ಯ ಸ್ವಕೀಯಪುಣ್ಯಾನಾಮ್ ಅಯುತೈ ರ್ವೇಷ್ಟಿತಃ ಪ್ರಭುಃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಸರ್ವ್ವಾನ್ ಪ್ರತಿ ವಿಚಾರಾಜ್ಞಾಸಾಧನಾಯಾಗಮಿಷ್ಯತಿ| ತದಾ ಚಾಧಾರ್ಮ್ಮಿಕಾಃ ಸರ್ವ್ವೇ ಜಾತಾ ಯೈರಪರಾಧಿನಃ| ವಿಧರ್ಮ್ಮಕರ್ಮ್ಮಣಾಂ ತೇಷಾಂ ಸರ್ವ್ವೇಷಾಮೇವ ಕಾರಣಾತ್| ತಥಾ ತದ್ವೈಪರೀತ್ಯೇನಾಪ್ಯಧರ್ಮ್ಮಾಚಾರಿಪಾಪಿನಾಂ| ಉಕ್ತಕಠೋರವಾಕ್ಯಾನಾಂ ಸರ್ವ್ವೇಷಾಮಪಿ ಕಾರಣಾತ್| ಪರಮೇಶೇನ ದೋಷಿತ್ವಂ ತೇಷಾಂ ಪ್ರಕಾಶಯಿಷ್ಯತೇ||</para>
  <para style="p">
    <verse number="16" style="v"/>ತೇ ವಾಕ್ಕಲಹಕಾರಿಣಃ ಸ್ವಭಾಗ್ಯನಿನ್ದಕಾಃ ಸ್ವೇಚ್ಛಾಚಾರಿಣೋ ದರ್ಪವಾದಿಮುಖವಿಶಿಷ್ಟಾ ಲಾಭಾರ್ಥಂ ಮನುಷ್ಯಸ್ತಾವಕಾಶ್ಚ ಸನ್ತಿ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಕಿನ್ತು ಹೇ ಪ್ರಿಯತಮಾಃ, ಅಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಪ್ರೇರಿತೈ ರ್ಯದ್ ವಾಕ್ಯಂ ಪೂರ್ವ್ವಂ ಯುಷ್ಮಭ್ಯಂ ಕಥಿತಂ ತತ್ ಸ್ಮರತ,</para>
  <para style="p">
    <verse number="18" style="v"/>ಫಲತಃ ಶೇಷಸಮಯೇ ಸ್ವೇಚ್ಛಾತೋ ಽಧರ್ಮ್ಮಾಚಾರಿಣೋ ನಿನ್ದಕಾ ಉಪಸ್ಥಾಸ್ಯನ್ತೀತಿ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಏತೇ ಲೋಕಾಃ ಸ್ವಾನ್ ಪೃಥಕ್ ಕುರ್ವ್ವನ್ತಃ ಸಾಂಸಾರಿಕಾ ಆತ್ಮಹೀನಾಶ್ಚ ಸನ್ತಿ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಕಿನ್ತು ಹೇ ಪ್ರಿಯತಮಾಃ, ಯೂಯಂ ಸ್ವೇಷಾಮ್ ಅತಿಪವಿತ್ರವಿಶ್ವಾಸೇ ನಿಚೀಯಮಾನಾಃ ಪವಿತ್ರೇಣಾತ್ಮನಾ ಪ್ರಾರ್ಥನಾಂ ಕುರ್ವ್ವನ್ತ</para>
  <para style="p">
    <verse number="21" style="v"/>ಈಶ್ವರಸ್ಯ ಪ್ರೇಮ್ನಾ ಸ್ವಾನ್ ರಕ್ಷತ, ಅನನ್ತಜೀವನಾಯ ಚಾಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಕೃಪಾಂ ಪ್ರತೀಕ್ಷಧ್ವಂ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಅಪರಂ ಯೂಯಂ ವಿವಿಚ್ಯ ಕಾಂಶ್ಚಿದ್ ಅನುಕಮ್ಪಧ್ವಂ</para>
  <para style="p">
    <verse number="23" style="v"/>ಕಾಂಶ್ಚಿದ್ ಅಗ್ನಿತ ಉದ್ಧೃತ್ಯ ಭಯಂ ಪ್ರದರ್ಶ್ಯ ರಕ್ಷತ, ಶಾರೀರಿಕಭಾವೇನ ಕಲಙ್ಕಿತಂ ವಸ್ತ್ರಮಪಿ ಋತೀಯಧ್ವಂ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಅಪರಞ್ಚ ಯುಷ್ಮಾನ್ ಸ್ಖಲನಾದ್ ರಕ್ಷಿತುಮ್ ಉಲ್ಲಾಸೇನ ಸ್ವೀಯತೇಜಸಃ ಸಾಕ್ಷಾತ್ ನಿರ್ದ್ದೋಷಾನ್ ಸ್ಥಾಪಯಿತುಞ್ಚ ಸಮರ್ಥೋ</para>
  <para style="p">
    <verse number="25" style="v"/>ಯೋ ಽಸ್ಮಾಕಮ್ ಅದ್ವಿತೀಯಸ್ತ್ರಾಣಕರ್ತ್ತಾ ಸರ್ವ್ವಜ್ಞ ಈಶ್ವರಸ್ತಸ್ಯ ಗೌರವಂ ಮಹಿಮಾ ಪರಾಕ್ರಮಃ ಕರ್ತೃತ್ವಞ್ಚೇದಾನೀಮ್ ಅನನ್ತಕಾಲಂ ಯಾವದ್ ಭೂಯಾತ್| ಆಮೇನ್|</para>
</usx>
