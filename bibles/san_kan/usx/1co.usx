<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1CO" style="id">Sanskrit Bible (NT) in Kannada Script (ಸತ್ಯವೇದಃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 Corinthians</para>
  <para style="toc1">೧ ಕರಿನ್ಥಿನಃ ಪತ್ರಂ</para>
  <para style="toc2">೧ ಕರಿನ್ಥಿನಃ</para>
  <para style="toc3">೧ ಕರಿನ್ಥಿನಃ</para>
  <para style="mt1">೧ ಕರಿನ್ಥಿನಃ ಪತ್ರಂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಯಾವನ್ತಃ ಪವಿತ್ರಾ ಲೋಕಾಃ ಸ್ವೇಷಾಮ್ ಅಸ್ಮಾಕಞ್ಚ ವಸತಿಸ್ಥಾನೇಷ್ವಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶೋಃ ಖ್ರೀಷ್ಟಸ್ಯ ನಾಮ್ನಾ ಪ್ರಾರ್ಥಯನ್ತೇ ತೈಃ ಸಹಾಹೂತಾನಾಂ ಖ್ರೀಷ್ಟೇನ ಯೀಶುನಾ ಪವಿತ್ರೀಕೃತಾನಾಂ ಲೋಕಾನಾಂ ಯ ಈಶ್ವರೀಯಧರ್ಮ್ಮಸಮಾಜಃ ಕರಿನ್ಥನಗರೇ ವಿದ್ಯತೇ</para>
  <para style="p">
    <verse number="2" style="v"/>ತಂ ಪ್ರತೀಶ್ವರಸ್ಯೇಚ್ಛಯಾಹೂತೋ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಪ್ರೇರಿತಃ ಪೌಲಃ ಸೋಸ್ಥಿನಿನಾಮಾ ಭ್ರಾತಾ ಚ ಪತ್ರಂ ಲಿಖತಿ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅಸ್ಮಾಕಂ ಪಿತ್ರೇಶ್ವರೇಣ ಪ್ರಭುನಾ ಯೀಶುಖ್ರೀಷ್ಟೇನ ಚ ಪ್ರಸಾದಃ ಶಾನ್ತಿಶ್ಚ ಯುಷ್ಮಭ್ಯಂ ದೀಯತಾಂ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಈಶ್ವರೋ ಯೀಶುಖ್ರೀಷ್ಟೇನ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಪ್ರಸಾದಂ ಪ್ರಕಾಶಿತವಾನ್, ತಸ್ಮಾದಹಂ ಯುಷ್ಮನ್ನಿಮಿತ್ತಂ ಸರ್ವ್ವದಾ ಮದೀಯೇಶ್ವರಂ ಧನ್ಯಂ ವದಾಮಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಖ್ರೀಷ್ಟಸಮ್ಬನ್ಧೀಯಂ ಸಾಕ್ಷ್ಯಂ ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ಯೇನ ಪ್ರಕಾರೇಣ ಸಪ್ರಮಾಣಮ್ ಅಭವತ್</para>
  <para style="p">
    <verse number="6" style="v"/>ತೇನ ಯೂಯಂ ಖ್ರೀಷ್ಟಾತ್ ಸರ್ವ್ವವಿಧವಕ್ತೃತಾಜ್ಞಾನಾದೀನಿ ಸರ್ವ್ವಧನಾನಿ ಲಬ್ಧವನ್ತಃ|</para>
  <para style="p">
    <verse number="7" style="v"/>ತತೋಽಸ್ಮತ್ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಪುನರಾಗಮನಂ ಪ್ರತೀಕ್ಷಮಾಣಾನಾಂ ಯುಷ್ಮಾಕಂ ಕಸ್ಯಾಪಿ ವರಸ್ಯಾಭಾವೋ ನ ಭವತಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಅಪರಮ್ ಅಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ದಿವಸೇ ಯೂಯಂ ಯನ್ನಿರ್ದ್ದೋಷಾ ಭವೇತ ತದರ್ಥಂ ಸಏವ ಯಾವದನ್ತಂ ಯುಷ್ಮಾನ್ ಸುಸ್ಥಿರಾನ್ ಕರಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಯ ಈಶ್ವರಃ ಸ್ವಪುತ್ರಸ್ಯಾಸ್ಮತ್ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯಾಂಶಿನಃ ಕರ್ತ್ತುಂ ಯುಷ್ಮಾನ್ ಆಹೂತವಾನ್ ಸ ವಿಶ್ವಸನೀಯಃ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಅಸ್ಮಾಕಂ ಪ್ರಭುಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ನಾಮ್ನಾ ಯುಷ್ಮಾನ್ ವಿನಯೇಽಹಂ ಸರ್ವ್ವೈ ರ್ಯುಷ್ಮಾಭಿರೇಕರೂಪಾಣಿ ವಾಕ್ಯಾನಿ ಕಥ್ಯನ್ತಾಂ ಯುಷ್ಮನ್ಮಧ್ಯೇ ಭಿನ್ನಸಙ್ಘಾತಾ ನ ಭವನ್ತು ಮನೋವಿಚಾರಯೋರೈಕ್ಯೇನ ಯುಷ್ಮಾಕಂ ಸಿದ್ಧತ್ವಂ ಭವತು|</para>
  <para style="p">
    <verse number="11" style="v"/>ಹೇ ಮಮ ಭ್ರಾತರೋ ಯುಷ್ಮನ್ಮಧ್ಯೇ ವಿವಾದಾ ಜಾತಾ ಇತಿ ವಾರ್ತ್ತಾಮಹಂ ಕ್ಲೋಯ್ಯಾಃ ಪರಿಜನೈ ರ್ಜ್ಞಾಪಿತಃ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಮಮಾಭಿಪ್ರೇತಮಿದಂ ಯುಷ್ಮಾಕಂ ಕಶ್ಚಿತ್ ಕಶ್ಚಿದ್ ವದತಿ ಪೌಲಸ್ಯ ಶಿಷ್ಯೋಽಹಮ್ ಆಪಲ್ಲೋಃ ಶಿಷ್ಯೋಽಹಂ ಕೈಫಾಃ ಶಿಷ್ಯೋಽಹಂ ಖ್ರೀಷ್ಟಸ್ಯ ಶಿಷ್ಯೋಽಹಮಿತಿ ಚ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಖ್ರೀಷ್ಟಸ್ಯ ಕಿಂ ವಿಭೇದಃ ಕೃತಃ? ಪೌಲಃ ಕಿಂ ಯುಷ್ಮತ್ಕೃತೇ ಕ್ರುಶೇ ಹತಃ? ಪೌಲಸ್ಯ ನಾಮ್ನಾ ವಾ ಯೂಯಂ ಕಿಂ ಮಜ್ಜಿತಾಃ?</para>
  <para style="p">
    <verse number="14" style="v"/>ಕ್ರಿಷ್ಪಗಾಯೌ ವಿನಾ ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇಽನ್ಯಃ ಕೋಽಪಿ ಮಯಾ ನ ಮಜ್ಜಿತ ಇತಿ ಹೇತೋರಹಮ್ ಈಶ್ವರಂ ಧನ್ಯಂ ವದಾಮಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಏತೇನ ಮಮ ನಾಮ್ನಾ ಮಾನವಾ ಮಯಾ ಮಜ್ಜಿತಾ ಇತಿ ವಕ್ತುಂ ಕೇನಾಪಿ ನ ಶಕ್ಯತೇ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಅಪರಂ ಸ್ತಿಫಾನಸ್ಯ ಪರಿಜನಾ ಮಯಾ ಮಜ್ಜಿತಾಸ್ತದನ್ಯಃ ಕಶ್ಚಿದ್ ಯನ್ಮಯಾ ಮಜ್ಜಿತಸ್ತದಹಂ ನ ವೇದ್ಮಿ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಖ್ರೀಷ್ಟೇನಾಹಂ ಮಜ್ಜನಾರ್ಥಂ ನ ಪ್ರೇರಿತಃ ಕಿನ್ತು ಸುಸಂವಾದಸ್ಯ ಪ್ರಚಾರಾರ್ಥಮೇವ; ಸೋಽಪಿ ವಾಕ್ಪಟುತಯಾ ಮಯಾ ನ ಪ್ರಚಾರಿತವ್ಯಃ, ಯತಸ್ತಥಾ ಪ್ರಚಾರಿತೇ ಖ್ರೀಷ್ಟಸ್ಯ ಕ್ರುಶೇ ಮೃತ್ಯುಃ ಫಲಹೀನೋ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಯತೋ ಹೇತೋ ರ್ಯೇ ವಿನಶ್ಯನ್ತಿ ತೇ ತಾಂ ಕ್ರುಶಸ್ಯ ವಾರ್ತ್ತಾಂ ಪ್ರಲಾಪಮಿವ ಮನ್ಯನ್ತೇ ಕಿಞ್ಚ ಪರಿತ್ರಾಣಂ ಲಭಮಾನೇಷ್ವಸ್ಮಾಸು ಸಾ ಈಶ್ವರೀಯಶಕ್ತಿಸ್ವರೂಪಾ|</para>
  <para style="p">
    <verse number="19" style="v"/>ತಸ್ಮಾದಿತ್ಥಂ ಲಿಖಿತಮಾಸ್ತೇ, ಜ್ಞಾನವತಾನ್ತು ಯತ್ ಜ್ಞಾನಂ ತನ್ಮಯಾ ನಾಶಯಿಷ್ಯತೇ| ವಿಲೋಪಯಿಷ್ಯತೇ ತದ್ವದ್ ಬುದ್ಧಿ ರ್ಬದ್ಧಿಮತಾಂ ಮಯಾ||</para>
  <para style="p">
    <verse number="20" style="v"/>ಜ್ಞಾನೀ ಕುತ್ರ? ಶಾಸ್ತ್ರೀ ವಾ ಕುತ್ರ? ಇಹಲೋಕಸ್ಯ ವಿಚಾರತತ್ಪರೋ ವಾ ಕುತ್ರ? ಇಹಲೋಕಸ್ಯ ಜ್ಞಾನಂ ಕಿಮೀಶ್ವರೇಣ ಮೋಹೀಕೃತಂ ನಹಿ?</para>
  <para style="p">
    <verse number="21" style="v"/>ಈಶ್ವರಸ್ಯ ಜ್ಞಾನಾದ್ ಇಹಲೋಕಸ್ಯ ಮಾನವಾಃ ಸ್ವಜ್ಞಾನೇನೇಶ್ವರಸ್ಯ ತತ್ತ್ವಬೋಧಂ ನ ಪ್ರಾಪ್ತವನ್ತಸ್ತಸ್ಮಾದ್ ಈಶ್ವರಃ ಪ್ರಚಾರರೂಪಿಣಾ ಪ್ರಲಾಪೇನ ವಿಶ್ವಾಸಿನಃ ಪರಿತ್ರಾತುಂ ರೋಚಿತವಾನ್|</para>
  <para style="p">
    <verse number="22" style="v"/>ಯಿಹೂದೀಯಲೋಕಾ ಲಕ್ಷಣಾನಿ ದಿದೃಕ್ಷನ್ತಿ ಭಿನ್ನದೇಶೀಯಲೋಕಾಸ್ತು ವಿದ್ಯಾಂ ಮೃಗಯನ್ತೇ,</para>
  <para style="p">
    <verse number="23" style="v"/>ವಯಞ್ಚ ಕ್ರುಶೇ ಹತಂ ಖ್ರೀಷ್ಟಂ ಪ್ರಚಾರಯಾಮಃ| ತಸ್ಯ ಪ್ರಚಾರೋ ಯಿಹೂದೀಯೈ ರ್ವಿಘ್ನ ಇವ ಭಿನ್ನದೇಶೀಯೈಶ್ಚ ಪ್ರಲಾಪ ಇವ ಮನ್ಯತೇ,</para>
  <para style="p">
    <verse number="24" style="v"/>ಕಿನ್ತು ಯಿಹೂದೀಯಾನಾಂ ಭಿನ್ನದೇಶೀಯಾನಾಞ್ಚ ಮಧ್ಯೇ ಯೇ ಆಹೂತಾಸ್ತೇಷು ಸ ಖ್ರೀಷ್ಟ ಈಶ್ವರೀಯಶಕ್ತಿರಿವೇಶ್ವರೀಯಜ್ಞಾನಮಿವ ಚ ಪ್ರಕಾಶತೇ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಯತ ಈಶ್ವರೇ ಯಃ ಪ್ರಲಾಪ ಆರೋಪ್ಯತೇ ಸ ಮಾನವಾತಿರಿಕ್ತಂ ಜ್ಞಾನಮೇವ ಯಚ್ಚ ದೌರ್ಬ್ಬಲ್ಯಮ್ ಈಶ್ವರ ಆರೋಪ್ಯತೇ ತತ್ ಮಾನವಾತಿರಿಕ್ತಂ ಬಲಮೇವ|</para>
  <para style="p">
    <verse number="26" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಆಹೂತಯುಷ್ಮದ್ಗಣೋ ಯಷ್ಮಾಭಿರಾಲೋಕ್ಯತಾಂ ತನ್ಮಧ್ಯೇ ಸಾಂಸಾರಿಕಜ್ಞಾನೇನ ಜ್ಞಾನವನ್ತಃ ಪರಾಕ್ರಮಿಣೋ ವಾ ಕುಲೀನಾ ವಾ ಬಹವೋ ನ ವಿದ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಯತ ಈಶ್ವರೋ ಜ್ಞಾನವತಸ್ತ್ರಪಯಿತುಂ ಮೂರ್ಖಲೋಕಾನ್ ರೋಚಿತವಾನ್ ಬಲಾನಿ ಚ ತ್ರಪಯಿತುಮ್ ಈಶ್ವರೋ ದುರ್ಬ್ಬಲಾನ್ ರೋಚಿತವಾನ್|</para>
  <para style="p">
    <verse number="28" style="v"/>ತಥಾ ವರ್ತ್ತಮಾನಲೋಕಾನ್ ಸಂಸ್ಥಿತಿಭ್ರಷ್ಟಾನ್ ಕರ್ತ್ತುಮ್ ಈಶ್ವರೋ ಜಗತೋಽಪಕೃಷ್ಟಾನ್ ಹೇಯಾನ್ ಅವರ್ತ್ತಮಾನಾಂಶ್ಚಾಭಿರೋಚಿತವಾನ್|</para>
  <para style="p">
    <verse number="29" style="v"/>ತತ ಈಶ್ವರಸ್ಯ ಸಾಕ್ಷಾತ್ ಕೇನಾಪ್ಯಾತ್ಮಶ್ಲಾಘಾ ನ ಕರ್ತ್ತವ್ಯಾ|</para>
  <para style="p">
    <verse number="30" style="v"/>ಯೂಯಞ್ಚ ತಸ್ಮಾತ್ ಖ್ರೀಷ್ಟೇ ಯೀಶೌ ಸಂಸ್ಥಿತಿಂ ಪ್ರಾಪ್ತವನ್ತಃ ಸ ಈಶ್ವರಾದ್ ಯುಷ್ಮಾಕಂ ಜ್ಞಾನಂ ಪುಣ್ಯಂ ಪವಿತ್ರತ್ವಂ ಮುಕ್ತಿಶ್ಚ ಜಾತಾ|</para>
  <para style="p">
    <verse number="31" style="v"/>ಅತಏವ ಯದ್ವದ್ ಲಿಖಿತಮಾಸ್ತೇ ತದ್ವತ್, ಯಃ ಕಶ್ಚಿತ್ ಶ್ಲಾಘಮಾನಃ ಸ್ಯಾತ್ ಶ್ಲಾಘತಾಂ ಪ್ರಭುನಾ ಸ ಹಿ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಭ್ರಾತರೋ ಯುಷ್ಮತ್ಸಮೀಪೇ ಮಮಾಗಮನಕಾಲೇಽಹಂ ವಕ್ತೃತಾಯಾ ವಿದ್ಯಾಯಾ ವಾ ನೈಪುಣ್ಯೇನೇಶ್ವರಸ್ಯ ಸಾಕ್ಷ್ಯಂ ಪ್ರಚಾರಿತವಾನ್ ತನ್ನಹಿ;</para>
  <para style="p">
    <verse number="2" style="v"/>ಯತೋ ಯೀಶುಖ್ರೀಷ್ಟಂ ತಸ್ಯ ಕ್ರುಶೇ ಹತತ್ವಞ್ಚ ವಿನಾ ನಾನ್ಯತ್ ಕಿಮಪಿ ಯುಷ್ಮನ್ಮಧ್ಯೇ ಜ್ಞಾಪಯಿತುಂ ವಿಹಿತಂ ಬುದ್ಧವಾನ್|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅಪರಞ್ಚಾತೀವ ದೌರ್ಬ್ಬಲ್ಯಭೀತಿಕಮ್ಪಯುಕ್ತೋ ಯುಷ್ಮಾಭಿಃ ಸಾರ್ದ್ಧಮಾಸಂ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಅಪರಂ ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸೋ ಯತ್ ಮಾನುಷಿಕಜ್ಞಾನಸ್ಯ ಫಲಂ ನ ಭವೇತ್ ಕಿನ್ತ್ವೀಶ್ವರೀಯಶಕ್ತೇಃ ಫಲಂ ಭವೇತ್,</para>
  <para style="p">
    <verse number="5" style="v"/>ತದರ್ಥಂ ಮಮ ವಕ್ತೃತಾ ಮದೀಯಪ್ರಚಾರಶ್ಚ ಮಾನುಷಿಕಜ್ಞಾನಸ್ಯ ಮಧುರವಾಕ್ಯಸಮ್ಬಲಿತೌ ನಾಸ್ತಾಂ ಕಿನ್ತ್ವಾತ್ಮನಃ ಶಕ್ತೇಶ್ಚ ಪ್ರಮಾಣಯುಕ್ತಾವಾಸ್ತಾಂ|</para>
  <para style="p">
    <verse number="6" style="v"/>ವಯಂ ಜ್ಞಾನಂ ಭಾಷಾಮಹೇ ತಚ್ಚ ಸಿದ್ಧಲೋಕೈ ರ್ಜ್ಞಾನಮಿವ ಮನ್ಯತೇ, ತದಿಹಲೋಕಸ್ಯ ಜ್ಞಾನಂ ನಹಿ, ಇಹಲೋಕಸ್ಯ ನಶ್ವರಾಣಾಮ್ ಅಧಿಪತೀನಾಂ ವಾ ಜ್ಞಾನಂ ನಹಿ;</para>
  <para style="p">
    <verse number="7" style="v"/>ಕಿನ್ತು ಕಾಲಾವಸ್ಥಾಯಾಃ ಪೂರ್ವ್ವಸ್ಮಾದ್ ಯತ್ ಜ್ಞಾನಮ್ ಅಸ್ಮಾಕಂ ವಿಭವಾರ್ಥಮ್ ಈಶ್ವರೇಣ ನಿಶ್ಚಿತ್ಯ ಪ್ರಚ್ಛನ್ನಂ ತನ್ನಿಗೂಢಮ್ ಈಶ್ವರೀಯಜ್ಞಾನಂ ಪ್ರಭಾಷಾಮಹೇ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಇಹಲೋಕಸ್ಯಾಧಿಪತೀನಾಂ ಕೇನಾಪಿ ತತ್ ಜ್ಞಾನಂ ನ ಲಬ್ಧಂ, ಲಬ್ಧೇ ಸತಿ ತೇ ಪ್ರಭಾವವಿಶಿಷ್ಟಂ ಪ್ರಭುಂ ಕ್ರುಶೇ ನಾಹನಿಷ್ಯನ್|</para>
  <para style="p">
    <verse number="9" style="v"/>ತದ್ವಲ್ಲಿಖಿತಮಾಸ್ತೇ, ನೇತ್ರೇಣ ಕ್ಕಾಪಿ ನೋ ದೃಷ್ಟಂ ಕರ್ಣೇನಾಪಿ ಚ ನ ಶ್ರುತಂ| ಮನೋಮಧ್ಯೇ ತು ಕಸ್ಯಾಪಿ ನ ಪ್ರವಿಷ್ಟಂ ಕದಾಪಿ ಯತ್| ಈಶ್ವರೇ ಪ್ರೀಯಮಾಣಾನಾಂ ಕೃತೇ ತತ್ ತೇನ ಸಞ್ಚಿತಂ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಅಪರಮೀಶ್ವರಃ ಸ್ವಾತ್ಮನಾ ತದಸ್ಮಾಕಂ ಸಾಕ್ಷಾತ್ ಪ್ರಾಕಾಶಯತ್; ಯತ ಆತ್ಮಾ ಸರ್ವ್ವಮೇವಾನುಸನ್ಧತ್ತೇ ತೇನ ಚೇಶ್ವರಸ್ಯ ಮರ್ಮ್ಮತತ್ತ್ವಮಪಿ ಬುಧ್ಯತೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಮನುಜಸ್ಯಾನ್ತಃಸ್ಥಮಾತ್ಮಾನಂ ವಿನಾ ಕೇನ ಮನುಜೇನ ತಸ್ಯ ಮನುಜಸ್ಯ ತತ್ತ್ವಂ ಬುಧ್ಯತೇ? ತದ್ವದೀಶ್ವರಸ್ಯಾತ್ಮಾನಂ ವಿನಾ ಕೇನಾಪೀಶ್ವರಸ್ಯ ತತ್ತ್ವಂ ನ ಬುಧ್ಯತೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ವಯಞ್ಚೇಹಲೋಕಸ್ಯಾತ್ಮಾನಂ ಲಬ್ಧವನ್ತಸ್ತನ್ನಹಿ ಕಿನ್ತ್ವೀಶ್ವರಸ್ಯೈವಾತ್ಮಾನಂ ಲಬ್ಧವನ್ತಃ, ತತೋ ಹೇತೋರೀಶ್ವರೇಣ ಸ್ವಪ್ರಸಾದಾದ್ ಅಸ್ಮಭ್ಯಂ ಯದ್ ಯದ್ ದತ್ತಂ ತತ್ಸರ್ವ್ವಮ್ ಅಸ್ಮಾಭಿ ರ್ಜ್ಞಾತುಂ ಶಕ್ಯತೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ತಚ್ಚಾಸ್ಮಾಭಿ ರ್ಮಾನುಷಿಕಜ್ಞಾನಸ್ಯ ವಾಕ್ಯಾನಿ ಶಿಕ್ಷಿತ್ವಾ ಕಥ್ಯತ ಇತಿ ನಹಿ ಕಿನ್ತ್ವಾತ್ಮತೋ ವಾಕ್ಯಾನಿ ಶಿಕ್ಷಿತ್ವಾತ್ಮಿಕೈ ರ್ವಾಕ್ಯೈರಾತ್ಮಿಕಂ ಭಾವಂ ಪ್ರಕಾಶಯದ್ಭಿಃ ಕಥ್ಯತೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಪ್ರಾಣೀ ಮನುಷ್ಯ ಈಶ್ವರೀಯಾತ್ಮನಃ ಶಿಕ್ಷಾಂ ನ ಗೃಹ್ಲಾತಿ ಯತ ಆತ್ಮಿಕವಿಚಾರೇಣ ಸಾ ವಿಚಾರ್ಯ್ಯೇತಿ ಹೇತೋಃ ಸ ತಾಂ ಪ್ರಲಾಪಮಿವ ಮನ್ಯತೇ ಬೋದ್ಧುಞ್ಚ ನ ಶಕ್ನೋತಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಆತ್ಮಿಕೋ ಮಾನವಃ ಸರ್ವ್ವಾಣಿ ವಿಚಾರಯತಿ ಕಿನ್ತು ಸ್ವಯಂ ಕೇನಾಪಿ ನ ವಿಚಾರ್ಯ್ಯತೇ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯತ ಈಶ್ವರಸ್ಯ ಮನೋ ಜ್ಞಾತ್ವಾ ತಮುಪದೇಷ್ಟುಂ ಕಃ ಶಕ್ನೋತಿ? ಕಿನ್ತು ಖ್ರೀಷ್ಟಸ್ಯ ಮನೋಽಸ್ಮಾಭಿ ರ್ಲಬ್ಧಂ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಅಹಮಾತ್ಮಿಕೈರಿವ ಯುಷ್ಮಾಭಿಃ ಸಮಂ ಸಮ್ಭಾಷಿತುಂ ನಾಶಕ್ನವಂ ಕಿನ್ತು ಶಾರೀರಿಕಾಚಾರಿಭಿಃ ಖ್ರೀಷ್ಟಧರ್ಮ್ಮೇ ಶಿಶುತುಲ್ಯೈಶ್ಚ ಜನೈರಿವ ಯುಷ್ಮಾಭಿಃ ಸಹ ಸಮಭಾಷೇ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯುಷ್ಮಾನ್ ಕಠಿನಭಕ್ಷ್ಯಂ ನ ಭೋಜಯನ್ ದುಗ್ಧಮ್ ಅಪಾಯಯಂ ಯತೋ ಯೂಯಂ ಭಕ್ಷ್ಯಂ ಗ್ರಹೀತುಂ ತದಾ ನಾಶಕ್ನುತ ಇದಾನೀಮಪಿ ನ ಶಕ್ನುಥ, ಯತೋ ಹೇತೋರಧುನಾಪಿ ಶಾರೀರಿಕಾಚಾರಿಣ ಆಧ್ವೇ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಯುಷ್ಮನ್ಮಧ್ಯೇ ಮಾತ್ಸರ್ಯ್ಯವಿವಾದಭೇದಾ ಭವನ್ತಿ ತತಃ ಕಿಂ ಶಾರೀರಿಕಾಚಾರಿಣೋ ನಾಧ್ವೇ ಮಾನುಷಿಕಮಾರ್ಗೇಣ ಚ ನ ಚರಥ?</para>
  <para style="p">
    <verse number="4" style="v"/>ಪೌಲಸ್ಯಾಹಮಿತ್ಯಾಪಲ್ಲೋರಹಮಿತಿ ವಾ ಯದ್ವಾಕ್ಯಂ ಯುಷ್ಮಾಕಂ ಕೈಶ್ಚಿತ್ ಕೈಶ್ಚಿತ್ ಕಥ್ಯತೇ ತಸ್ಮಾದ್ ಯೂಯಂ ಶಾರೀರಿಕಾಚಾರಿಣ ನ ಭವಥ?</para>
  <para style="p">
    <verse number="5" style="v"/>ಪೌಲಃ ಕಃ? ಆಪಲ್ಲೋ ರ್ವಾ ಕಃ? ತೌ ಪರಿಚಾರಕಮಾತ್ರೌ ತಯೋರೇಕೈಕಸ್ಮೈ ಚ ಪ್ರಭು ರ್ಯಾದೃಕ್ ಫಲಮದದಾತ್ ತದ್ವತ್ ತಯೋರ್ದ್ವಾರಾ ಯೂಯಂ ವಿಶ್ವಾಸಿನೋ ಜಾತಾಃ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅಹಂ ರೋಪಿತವಾನ್ ಆಪಲ್ಲೋಶ್ಚ ನಿಷಿಕ್ತವಾನ್ ಈಶ್ವರಶ್ಚಾವರ್ದ್ಧಯತ್|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅತೋ ರೋಪಯಿತೃಸೇಕ್ತಾರಾವಸಾರೌ ವರ್ದ್ಧಯಿತೇಶ್ವರ ಏವ ಸಾರಃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ರೋಪಯಿತೃಸೇಕ್ತಾರೌ ಚ ಸಮೌ ತಯೋರೇಕೈಕಶ್ಚ ಸ್ವಶ್ರಮಯೋಗ್ಯಂ ಸ್ವವೇತನಂ ಲಪ್ಸ್ಯತೇ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಆವಾಮೀಶ್ವರೇಣ ಸಹ ಕರ್ಮ್ಮಕಾರಿಣೌ, ಈಶ್ವರಸ್ಯ ಯತ್ ಕ್ಷೇತ್ರಮ್ ಈಶ್ವರಸ್ಯ ಯಾ ನಿರ್ಮ್ಮಿತಿಃ ಸಾ ಯೂಯಮೇವ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಈಶ್ವರಸ್ಯ ಪ್ರಸಾದಾತ್ ಮಯಾ ಯತ್ ಪದಂ ಲಬ್ಧಂ ತಸ್ಮಾತ್ ಜ್ಞಾನಿನಾ ಗೃಹಕಾರಿಣೇವ ಮಯಾ ಭಿತ್ತಿಮೂಲಂ ಸ್ಥಾಪಿತಂ ತದುಪರಿ ಚಾನ್ಯೇನ ನಿಚೀಯತೇ| ಕಿನ್ತು ಯೇನ ಯನ್ನಿಚೀಯತೇ ತತ್ ತೇನ ವಿವಿಚ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಯತೋ ಯೀಶುಖ್ರೀಷ್ಟರೂಪಂ ಯದ್ ಭಿತ್ತಿಮೂಲಂ ಸ್ಥಾಪಿತಂ ತದನ್ಯತ್ ಕಿಮಪಿ ಭಿತ್ತಿಮೂಲಂ ಸ್ಥಾಪಯಿತುಂ ಕೇನಾಪಿ ನ ಶಕ್ಯತೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಏತದ್ಭಿತ್ತಿಮೂಲಸ್ಯೋಪರಿ ಯದಿ ಕೇಚಿತ್ ಸ್ವರ್ಣರೂಪ್ಯಮಣಿಕಾಷ್ಠತೃಣನಲಾನ್ ನಿಚಿನ್ವನ್ತಿ,</para>
  <para style="p">
    <verse number="13" style="v"/>ತರ್ಹ್ಯೇಕೈಕಸ್ಯ ಕರ್ಮ್ಮ ಪ್ರಕಾಶಿಷ್ಯತೇ ಯತಃ ಸ ದಿವಸಸ್ತತ್ ಪ್ರಕಾಶಯಿಷ್ಯತಿ| ಯತೋ ಹತೋಸ್ತನ ದಿವಸೇನ ವಹ್ನಿಮಯೇನೋದೇತವ್ಯಂ ತತ ಏಕೈಕಸ್ಯ ಕರ್ಮ್ಮ ಕೀದೃಶಮೇತಸ್ಯ ಪರೀಕ್ಷಾ ಬಹ್ನಿನಾ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯಸ್ಯ ನಿಚಯನರೂಪಂ ಕರ್ಮ್ಮ ಸ್ಥಾಸ್ನು ಭವಿಷ್ಯತಿ ಸ ವೇತನಂ ಲಪ್ಸ್ಯತೇ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಯಸ್ಯ ಚ ಕರ್ಮ್ಮ ಧಕ್ಷ್ಯತೇ ತಸ್ಯ ಕ್ಷತಿ ರ್ಭವಿಷ್ಯತಿ ಕಿನ್ತು ವಹ್ನೇ ರ್ನಿರ್ಗತಜನ ಇವ ಸ ಸ್ವಯಂ ಪರಿತ್ರಾಣಂ ಪ್ರಾಪ್ಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯೂಯಮ್ ಈಶ್ವರಸ್ಯ ಮನ್ದಿರಂ ಯುಷ್ಮನ್ಮಧ್ಯೇ ಚೇಶ್ವರಸ್ಯಾತ್ಮಾ ನಿವಸತೀತಿ ಕಿಂ ನ ಜಾನೀಥ?</para>
  <para style="p">
    <verse number="17" style="v"/>ಈಶ್ವರಸ್ಯ ಮನ್ದಿರಂ ಯೇನ ವಿನಾಶ್ಯತೇ ಸೋಽಪೀಶ್ವರೇಣ ವಿನಾಶಯಿಷ್ಯತೇ ಯತ ಈಶ್ವರಸ್ಯ ಮನ್ದಿರಂ ಪವಿತ್ರಮೇವ ಯೂಯಂ ತು ತನ್ಮನ್ದಿರಮ್ ಆಧ್ವೇ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಕೋಪಿ ಸ್ವಂ ನ ವಞ್ಚಯತಾಂ| ಯುಷ್ಮಾಕಂ ಕಶ್ಚನ ಚೇದಿಹಲೋಕಸ್ಯ ಜ್ಞಾನೇನ ಜ್ಞಾನವಾನಹಮಿತಿ ಬುಧ್ಯತೇ ತರ್ಹಿ ಸ ಯತ್ ಜ್ಞಾನೀ ಭವೇತ್ ತದರ್ಥಂ ಮೂಢೋ ಭವತು|</para>
  <para style="p">
    <verse number="19" style="v"/>ಯಸ್ಮಾದಿಹಲೋಕಸ್ಯ ಜ್ಞಾನಮ್ ಈಶ್ವರಸ್ಯ ಸಾಕ್ಷಾತ್ ಮೂಢತ್ವಮೇವ| ಏತಸ್ಮಿನ್ ಲಿಖಿತಮಪ್ಯಾಸ್ತೇ, ತೀಕ್ಷ್ಣಾ ಯಾ ಜ್ಞಾನಿನಾಂ ಬುದ್ಧಿಸ್ತಯಾ ತಾನ್ ಧರತೀಶ್ವರಃ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಪುನಶ್ಚ| ಜ್ಞಾನಿನಾಂ ಕಲ್ಪನಾ ವೇತ್ತಿ ಪರಮೇಶೋ ನಿರರ್ಥಕಾಃ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಅತಏವ ಕೋಽಪಿ ಮನುಜೈರಾತ್ಮಾನಂ ನ ಶ್ಲಾಘತಾಂ ಯತಃ ಸರ್ವ್ವಾಣಿ ಯುಷ್ಮಾಕಮೇವ,</para>
  <para style="p">
    <verse number="22" style="v"/>ಪೌಲ ವಾ ಆಪಲ್ಲೋ ರ್ವಾ ಕೈಫಾ ವಾ ಜಗದ್ ವಾ ಜೀವನಂ ವಾ ಮರಣಂ ವಾ ವರ್ತ್ತಮಾನಂ ವಾ ಭವಿಷ್ಯದ್ವಾ ಸರ್ವ್ವಾಣ್ಯೇವ ಯುಷ್ಮಾಕಂ,</para>
  <para style="p">
    <verse number="23" style="v"/>ಯೂಯಞ್ಚ ಖ್ರೀಷ್ಟಸ್ಯ, ಖ್ರೀಷ್ಟಶ್ಚೇಶ್ವರಸ್ಯ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಲೋಕಾ ಅಸ್ಮಾನ್ ಖ್ರೀಷ್ಟಸ್ಯ ಪರಿಚಾರಕಾನ್ ಈಶ್ವರಸ್ಯ ನಿಗೂಠವಾಕ್ಯಧನಸ್ಯಾಧ್ಯಕ್ಷಾಂಶ್ಚ ಮನ್ಯನ್ತಾಂ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಕಿಞ್ಚ ಧನಾಧ್ಯಕ್ಷೇಣ ವಿಶ್ವಸನೀಯೇನ ಭವಿತವ್ಯಮೇತದೇವ ಲೋಕೈ ರ್ಯಾಚ್ಯತೇ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅತೋ ವಿಚಾರಯದ್ಭಿ ರ್ಯುಷ್ಮಾಭಿರನ್ಯೈಃ ಕೈಶ್ಚಿನ್ ಮನುಜೈ ರ್ವಾ ಮಮ ಪರೀಕ್ಷಣಂ ಮಯಾತೀವ ಲಘು ಮನ್ಯತೇ ಽಹಮಪ್ಯಾತ್ಮಾನಂ ನ ವಿಚಾರಯಾಮಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಮಯಾ ಕಿಮಪ್ಯಪರಾದ್ಧಮಿತ್ಯಹಂ ನ ವೇದ್ಮಿ ಕಿನ್ತ್ವೇತೇನ ಮಮ ನಿರಪರಾಧತ್ವಂ ನ ನಿಶ್ಚೀಯತೇ ಪ್ರಭುರೇವ ಮಮ ವಿಚಾರಯಿತಾಸ್ತಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಅತ ಉಪಯುಕ್ತಸಮಯಾತ್ ಪೂರ್ವ್ವಮ್ ಅರ್ಥತಃ ಪ್ರಭೋರಾಗಮನಾತ್ ಪೂರ್ವ್ವಂ ಯುಷ್ಮಾಭಿ ರ್ವಿಚಾರೋ ನ ಕ್ರಿಯತಾಂ| ಪ್ರಭುರಾಗತ್ಯ ತಿಮಿರೇಣ ಪ್ರಚ್ಛನ್ನಾನಿ ಸರ್ವ್ವಾಣಿ ದೀಪಯಿಷ್ಯತಿ ಮನಸಾಂ ಮನ್ತ್ರಣಾಶ್ಚ ಪ್ರಕಾಶಯಿಷ್ಯತಿ ತಸ್ಮಿನ್ ಸಮಯ ಈಶ್ವರಾದ್ ಏಕೈಕಸ್ಯ ಪ್ರಶಂಸಾ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಹೇ ಭ್ರಾತರಃ ಸರ್ವ್ವಾಣ್ಯೇತಾನಿ ಮಯಾತ್ಮಾನಮ್ ಆಪಲ್ಲವಞ್ಚೋದ್ದಿಶ್ಯ ಕಥಿತಾನಿ ತಸ್ಯೈತತ್ ಕಾರಣಂ ಯುಯಂ ಯಥಾ ಶಾಸ್ತ್ರೀಯವಿಧಿಮತಿಕ್ರಮ್ಯ ಮಾನವಮ್ ಅತೀವ ನಾದರಿಷ್ಯಧ್ಬ ಈತ್ಥಞ್ಚೈಕೇನ ವೈಪರೀತ್ಯಾದ್ ಅಪರೇಣ ನ ಶ್ಲಾಘಿಷ್ಯಧ್ಬ ಏತಾದೃಶೀಂ ಶಿಕ್ಷಾಮಾವಯೋರ್ದೃಷ್ಟಾನ್ತಾತ್ ಲಪ್ಸ್ಯಧ್ವೇ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅಪರಾತ್ ಕಸ್ತ್ವಾಂ ವಿಶೇಷಯತಿ? ತುಭ್ಯಂ ಯನ್ನ ದತ್ತ ತಾದೃಶಂ ಕಿಂ ಧಾರಯಸಿ? ಅದತ್ತೇನೇವ ದತ್ತೇನ ವಸ್ತುನಾ ಕುತಃ ಶ್ಲಾಘಸೇ?</para>
  <para style="p">
    <verse number="8" style="v"/>ಇದಾನೀಮೇವ ಯೂಯಂ ಕಿಂ ತೃಪ್ತಾ ಲಬ್ಧಧನಾ ವಾ? ಅಸ್ಮಾಸ್ವವಿದ್ಯಮಾನೇಷು ಯೂಯಂ ಕಿಂ ರಾಜತ್ವಪದಂ ಪ್ರಾಪ್ತಾಃ? ಯುಷ್ಮಾಕಂ ರಾಜತ್ವಂ ಮಯಾಭಿಲಷಿತಂ ಯತಸ್ತೇನ ಯುಷ್ಮಾಭಿಃ ಸಹ ವಯಮಪಿ ರಾಜ್ಯಾಂಶಿನೋ ಭವಿಷ್ಯಾಮಃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಪ್ರೇರಿತಾ ವಯಂ ಶೇಷಾ ಹನ್ತವ್ಯಾಶ್ಚೇವೇಶ್ವರೇಣ ನಿದರ್ಶಿತಾಃ| ಯತೋ ವಯಂ ಸರ್ವ್ವಲೋಕಾನಾಮ್ ಅರ್ಥತಃ ಸ್ವರ್ಗೀಯದೂತಾನಾಂ ಮಾನವಾನಾಞ್ಚ ಕೌತುಕಾಸ್ಪದಾನಿ ಜಾತಾಃ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಖ್ರೀಷ್ಟಸ್ಯ ಕೃತೇ ವಯಂ ಮೂಢಾಃ ಕಿನ್ತು ಯೂಯಂ ಖ್ರೀಷ್ಟೇನ ಜ್ಞಾನಿನಃ, ವಯಂ ದುರ್ಬ್ಬಲಾ ಯೂಯಞ್ಚ ಸಬಲಾಃ, ಯೂಯಂ ಸಮ್ಮಾನಿತಾ ವಯಞ್ಚಾಪಮಾನಿತಾಃ|</para>
  <para style="p">
    <verse number="11" style="v"/>ವಯಮದ್ಯಾಪಿ ಕ್ಷುಧಾರ್ತ್ತಾಸ್ತೃಷ್ಣಾರ್ತ್ತಾ ವಸ್ತ್ರಹೀನಾಸ್ತಾಡಿತಾ ಆಶ್ರಮರಹಿತಾಶ್ಚ ಸನ್ತಃ</para>
  <para style="p">
    <verse number="12" style="v"/>ಕರ್ಮ್ಮಣಿ ಸ್ವಕರಾನ್ ವ್ಯಾಪಾರಯನ್ತಶ್ಚ ದುಃಖೈಃ ಕಾಲಂ ಯಾಪಯಾಮಃ| ಗರ್ಹಿತೈರಸ್ಮಾಭಿರಾಶೀಃ ಕಥ್ಯತೇ ದೂರೀಕೃತೈಃ ಸಹ್ಯತೇ ನಿನ್ದಿತೈಃ ಪ್ರಸಾದ್ಯತೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ವಯಮದ್ಯಾಪಿ ಜಗತಃ ಸಮ್ಮಾರ್ಜನೀಯೋಗ್ಯಾ ಅವಕರಾ ಇವ ಸರ್ವ್ವೈ ರ್ಮನ್ಯಾಮಹೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯುಷ್ಮಾನ್ ತ್ರಪಯಿತುಮಹಮೇತಾನಿ ಲಿಖಾಮೀತಿ ನಹಿ ಕಿನ್ತು ಪ್ರಿಯಾತ್ಮಜಾನಿವ ಯುಷ್ಮಾನ್ ಪ್ರಬೋಧಯಾಮಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಯತಃ ಖ್ರೀಷ್ಟಧರ್ಮ್ಮೇ ಯದ್ಯಪಿ ಯುಷ್ಮಾಕಂ ದಶಸಹಸ್ರಾಣಿ ವಿನೇತಾರೋ ಭವನ್ತಿ ತಥಾಪಿ ಬಹವೋ ಜನಕಾ ನ ಭವನ್ತಿ ಯತೋಽಹಮೇವ ಸುಸಂವಾದೇನ ಯೀಶುಖ್ರೀಷ್ಟೇ ಯುಷ್ಮಾನ್ ಅಜನಯಂ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಅತೋ ಯುಷ್ಮಾನ್ ವಿನಯೇಽಹಂ ಯೂಯಂ ಮದನುಗಾಮಿನೋ ಭವತ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಇತ್ಯರ್ಥಂ ಸರ್ವ್ವೇಷು ಧರ್ಮ್ಮಸಮಾಜೇಷು ಸರ್ವ್ವತ್ರ ಖ್ರೀಷ್ಟಧರ್ಮ್ಮಯೋಗ್ಯಾ ಯೇ ವಿಧಯೋ ಮಯೋಪದಿಶ್ಯನ್ತೇ ತಾನ್ ಯೋ ಯುಷ್ಮಾನ್ ಸ್ಮಾರಯಿಷ್ಯತ್ಯೇವಮ್ಭೂತಂ ಪ್ರಭೋಃ ಕೃತೇ ಪ್ರಿಯಂ ವಿಶ್ವಾಸಿನಞ್ಚ ಮದೀಯತನಯಂ ತೀಮಥಿಯಂ ಯುಷ್ಮಾಕಂ ಸಮೀಪಂ ಪ್ರೇಷಿತವಾನಹಂ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಅಪರಮಹಂ ಯುಷ್ಮಾಕಂ ಸಮೀಪಂ ನ ಗಮಿಷ್ಯಾಮೀತಿ ಬುದ್ಧ್ವಾ ಯುಷ್ಮಾಕಂ ಕಿಯನ್ತೋ ಲೋಕಾ ಗರ್ವ್ವನ್ತಿ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಕಿನ್ತು ಯದಿ ಪ್ರಭೇರಿಚ್ಛಾ ಭವತಿ ತರ್ಹ್ಯಹಮವಿಲಮ್ಬಂ ಯುಷ್ಮತ್ಸಮೀಪಮುಪಸ್ಥಾಯ ತೇಷಾಂ ದರ್ಪಧ್ಮಾತಾನಾಂ ಲೋಕಾನಾಂ ವಾಚಂ ಜ್ಞಾಸ್ಯಾಮೀತಿ ನಹಿ ಸಾಮರ್ಥ್ಯಮೇವ ಜ್ಞಾಸ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಯಸ್ಮಾದೀಶ್ವರಸ್ಯ ರಾಜತ್ವಂ ವಾಗ್ಯುಕ್ತಂ ನಹಿ ಕಿನ್ತು ಸಾಮರ್ಥ್ಯಯುಕ್ತಂ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಯುಷ್ಮಾಕಂ ಕಾ ವಾಞ್ಛಾ? ಯುಷ್ಮತ್ಸಮೀಪೇ ಮಯಾ ಕಿಂ ದಣ್ಡಪಾಣಿನಾ ಗನ್ತವ್ಯಮುತ ಪ್ರೇಮನಮ್ರತಾತ್ಮಯುಕ್ತೇನ ವಾ?</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅಪರಂ ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ವ್ಯಭಿಚಾರೋ ವಿದ್ಯತೇ ಸ ಚ ವ್ಯಭಿಚಾರಸ್ತಾದೃಶೋ ಯದ್ ದೇವಪೂಜಕಾನಾಂ ಮಧ್ಯೇಽಪಿ ತತ್ತುಲ್ಯೋ ನ ವಿದ್ಯತೇ ಫಲತೋ ಯುಷ್ಮಾಕಮೇಕೋ ಜನೋ ವಿಮಾತೃಗಮನಂ ಕೃರುತ ಇತಿ ವಾರ್ತ್ತಾ ಸರ್ವ್ವತ್ರ ವ್ಯಾಪ್ತಾ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತಥಾಚ ಯೂಯಂ ದರ್ಪಧ್ಮಾತಾ ಆಧ್ಬೇ, ತತ್ ಕರ್ಮ್ಮ ಯೇನ ಕೃತಂ ಸ ಯಥಾ ಯುಷ್ಮನ್ಮಧ್ಯಾದ್ ದೂರೀಕ್ರಿಯತೇ ತಥಾ ಶೋಕೋ ಯುಷ್ಮಾಭಿ ರ್ನ ಕ್ರಿಯತೇ ಕಿಮ್ ಏತತ್?</para>
  <para style="p">
    <verse number="3" style="v"/>ಅವಿದ್ಯಮಾನೇ ಮದೀಯಶರೀರೇ ಮಮಾತ್ಮಾ ಯುಷ್ಮನ್ಮಧ್ಯೇ ವಿದ್ಯತೇ ಅತೋಽಹಂ ವಿದ್ಯಮಾನ ಇವ ತತ್ಕರ್ಮ್ಮಕಾರಿಣೋ ವಿಚಾರಂ ನಿಶ್ಚಿತವಾನ್,</para>
  <para style="p">
    <verse number="4" style="v"/>ಅಸ್ಮತ್ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ನಾಮ್ನಾ ಯುಷ್ಮಾಕಂ ಮದೀಯಾತ್ಮನಶ್ಚ ಮಿಲನೇ ಜಾತೇ ಽಸ್ಮತ್ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಶಕ್ತೇಃ ಸಾಹಾಯ್ಯೇನ</para>
  <para style="p">
    <verse number="5" style="v"/>ಸ ನರಃ ಶರೀರನಾಶಾರ್ಥಮಸ್ಮಾಭಿಃ ಶಯತಾನೋ ಹಸ್ತೇ ಸಮರ್ಪಯಿತವ್ಯಸ್ತತೋಽಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶೋ ರ್ದಿವಸೇ ತಸ್ಯಾತ್ಮಾ ರಕ್ಷಾಂ ಗನ್ತುಂ ಶಕ್ಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಯುಷ್ಮಾಕಂ ದರ್ಪೋ ನ ಭದ್ರಾಯ ಯೂಯಂ ಕಿಮೇತನ್ನ ಜಾನೀಥ, ಯಥಾ, ವಿಕಾರಃ ಕೃತ್ಸ್ನಶಕ್ತೂನಾಂ ಸ್ವಲ್ಪಕಿಣ್ವೇನ ಜಾಯತೇ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯೂಯಂ ಯತ್ ನವೀನಶಕ್ತುಸ್ವರೂಪಾ ಭವೇತ ತದರ್ಥಂ ಪುರಾತನಂ ಕಿಣ್ವಮ್ ಅವಮಾರ್ಜ್ಜತ ಯತೋ ಯುಷ್ಮಾಭಿಃ ಕಿಣ್ವಶೂನ್ಯೈ ರ್ಭವಿತವ್ಯಂ| ಅಪರಮ್ ಅಸ್ಮಾಕಂ ನಿಸ್ತಾರೋತ್ಸವೀಯಮೇಷಶಾವಕೋ ಯಃ ಖ್ರೀಷ್ಟಃ ಸೋಽಸ್ಮದರ್ಥಂ ಬಲೀಕೃತೋ ಽಭವತ್|</para>
  <para style="p">
    <verse number="8" style="v"/>ಅತಃ ಪುರಾತನಕಿಣ್ವೇನಾರ್ಥತೋ ದುಷ್ಟತಾಜಿಘಾಂಸಾರೂಪೇಣ ಕಿಣ್ವೇನ ತನ್ನಹಿ ಕಿನ್ತು ಸಾರಲ್ಯಸತ್ಯತ್ವರೂಪಯಾ ಕಿಣ್ವಶೂನ್ಯತಯಾಸ್ಮಾಭಿರುತ್ಸವಃ ಕರ್ತ್ತವ್ಯಃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ವ್ಯಾಭಿಚಾರಿಣಾಂ ಸಂಸರ್ಗೋ ಯುಷ್ಮಾಭಿ ರ್ವಿಹಾತವ್ಯ ಇತಿ ಮಯಾ ಪತ್ರೇ ಲಿಖಿತಂ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಕಿನ್ತ್ವೈಹಿಕಲೋಕಾನಾಂ ಮಧ್ಯೇ ಯೇ ವ್ಯಭಿಚಾರಿಣೋ ಲೋಭಿನ ಉಪದ್ರಾವಿಣೋ ದೇವಪೂಜಕಾ ವಾ ತೇಷಾಂ ಸಂಸರ್ಗಃ ಸರ್ವ್ವಥಾ ವಿಹಾತವ್ಯ ಇತಿ ನಹಿ, ವಿಹಾತವ್ಯೇ ಸತಿ ಯುಷ್ಮಾಭಿ ರ್ಜಗತೋ ನಿರ್ಗನ್ತವ್ಯಮೇವ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಕಿನ್ತು ಭ್ರಾತೃತ್ವೇನ ವಿಖ್ಯಾತಃ ಕಶ್ಚಿಜ್ಜನೋ ಯದಿ ವ್ಯಭಿಚಾರೀ ಲೋಭೀ ದೇವಪೂಜಕೋ ನಿನ್ದಕೋ ಮದ್ಯಪ ಉಪದ್ರಾವೀ ವಾ ಭವೇತ್ ತರ್ಹಿ ತಾದೃಶೇನ ಮಾನವೇನ ಸಹ ಭೋಜನಪಾನೇಽಪಿ ಯುಷ್ಮಾಭಿ ರ್ನ ಕರ್ತ್ತವ್ಯೇ ಇತ್ಯಧುನಾ ಮಯಾ ಲಿಖಿತಂ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಸಮಾಜಬಹಿಃಸ್ಥಿತಾನಾಂ ಲೋಕಾನಾಂ ವಿಚಾರಕರಣೇ ಮಮ ಕೋಽಧಿಕಾರಃ? ಕಿನ್ತು ತದನ್ತರ್ಗತಾನಾಂ ವಿಚಾರಣಂ ಯುಷ್ಮಾಭಿಃ ಕಿಂ ನ ಕರ್ತ್ತವ್ಯಂ ಭವೇತ್?</para>
  <para style="p">
    <verse number="13" style="v"/>ಬಹಿಃಸ್ಥಾನಾಂ ತು ವಿಚಾರ ಈಶ್ವರೇಣ ಕಾರಿಷ್ಯತೇ| ಅತೋ ಯುಷ್ಮಾಭಿಃ ಸ ಪಾತಕೀ ಸ್ವಮಧ್ಯಾದ್ ಬಹಿಷ್ಕ್ರಿಯತಾಂ|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಯುಷ್ಮಾಕಮೇಕಸ್ಯ ಜನಸ್ಯಾಪರೇಣ ಸಹ ವಿವಾದೇ ಜಾತೇ ಸ ಪವಿತ್ರಲೋಕೈ ರ್ವಿಚಾರಮಕಾರಯನ್ ಕಿಮ್ ಅಧಾರ್ಮ್ಮಿಕಲೋಕೈ ರ್ವಿಚಾರಯಿತುಂ ಪ್ರೋತ್ಸಹತೇ?</para>
  <para style="p">
    <verse number="2" style="v"/>ಜಗತೋಽಪಿ ವಿಚಾರಣಂ ಪವಿತ್ರಲೋಕೈಃ ಕಾರಿಷ್ಯತ ಏತದ್ ಯೂಯಂ ಕಿಂ ನ ಜಾನೀಥ? ಅತೋ ಜಗದ್ ಯದಿ ಯುಷ್ಮಾಭಿ ರ್ವಿಚಾರಯಿತವ್ಯಂ ತರ್ಹಿ ಕ್ಷುದ್ರತಮವಿಚಾರೇಷು ಯೂಯಂ ಕಿಮಸಮರ್ಥಾಃ?</para>
  <para style="p">
    <verse number="3" style="v"/>ದೂತಾ ಅಪ್ಯಸ್ಮಾಭಿ ರ್ವಿಚಾರಯಿಷ್ಯನ್ತ ಇತಿ ಕಿಂ ನ ಜಾನೀಥ? ಅತ ಐಹಿಕವಿಷಯಾಃ ಕಿಮ್ ಅಸ್ಮಾಭಿ ರ್ನ ವಿಚಾರಯಿತವ್ಯಾ ಭವೇಯುಃ?</para>
  <para style="p">
    <verse number="4" style="v"/>ಐಹಿಕವಿಷಯಸ್ಯ ವಿಚಾರೇ ಯುಷ್ಮಾಭಿಃ ಕರ್ತ್ತವ್ಯೇ ಯೇ ಲೋಕಾಃ ಸಮಿತೌ ಕ್ಷುದ್ರತಮಾಸ್ತ ಏವ ನಿಯುಜ್ಯನ್ತಾಂ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಅಹಂ ಯುಷ್ಮಾನ್ ತ್ರಪಯಿತುಮಿಚ್ಛನ್ ವದಾಮಿ ಯೃಷ್ಮನ್ಮಧ್ಯೇ ಕಿಮೇಕೋಽಪಿ ಮನುಷ್ಯಸ್ತಾದೃಗ್ ಬುದ್ಧಿಮಾನ್ನಹಿ ಯೋ ಭ್ರಾತೃವಿವಾದವಿಚಾರಣೇ ಸಮರ್ಥಃ ಸ್ಯಾತ್?</para>
  <para style="p">
    <verse number="6" style="v"/>ಕಿಞ್ಚೈಕೋ ಭ್ರಾತಾ ಭ್ರಾತ್ರಾನ್ಯೇನ ಕಿಮವಿಶ್ವಾಸಿನಾಂ ವಿಚಾರಕಾಣಾಂ ಸಾಕ್ಷಾದ್ ವಿವದತೇ? ಯಷ್ಮನ್ಮಧ್ಯೇ ವಿವಾದಾ ವಿದ್ಯನ್ತ ಏತದಪಿ ಯುಷ್ಮಾಕಂ ದೋಷಃ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯೂಯಂ ಕುತೋಽನ್ಯಾಯಸಹನಂ ಕ್ಷತಿಸಹನಂ ವಾ ಶ್ರೇಯೋ ನ ಮನ್ಯಧ್ವೇ?</para>
  <para style="p">
    <verse number="8" style="v"/>ಕಿನ್ತು ಯೂಯಮಪಿ ಭ್ರಾತೃನೇವ ಪ್ರತ್ಯನ್ಯಾಯಂ ಕ್ಷತಿಞ್ಚ ಕುರುಥ ಕಿಮೇತತ್?</para>
  <para style="p">
    <verse number="9" style="v"/>ಈಶ್ವರಸ್ಯ ರಾಜ್ಯೇಽನ್ಯಾಯಕಾರಿಣಾಂ ಲೋಕಾನಾಮಧಿಕಾರೋ ನಾಸ್ತ್ಯೇತದ್ ಯೂಯಂ ಕಿಂ ನ ಜಾನೀಥ? ಮಾ ವಞ್ಚ್ಯಧ್ವಂ, ಯೇ ವ್ಯಭಿಚಾರಿಣೋ ದೇವಾರ್ಚ್ಚಿನಃ ಪಾರದಾರಿಕಾಃ ಸ್ತ್ರೀವದಾಚಾರಿಣಃ ಪುಂಮೈಥುನಕಾರಿಣಸ್ತಸ್ಕರಾ</para>
  <para style="p">
    <verse number="10" style="v"/>ಲೋಭಿನೋ ಮದ್ಯಪಾ ನಿನ್ದಕಾ ಉಪದ್ರಾವಿಣೋ ವಾ ತ ಈಶ್ವರಸ್ಯ ರಾಜ್ಯಭಾಗಿನೋ ನ ಭವಿಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಯೂಯಞ್ಚೈವಂವಿಧಾ ಲೋಕಾ ಆಸ್ತ ಕಿನ್ತು ಪ್ರಭೋ ರ್ಯೀಶೋ ರ್ನಾಮ್ನಾಸ್ಮದೀಶ್ವರಸ್ಯಾತ್ಮನಾ ಚ ಯೂಯಂ ಪ್ರಕ್ಷಾಲಿತಾಃ ಪಾವಿತಾಃ ಸಪುಣ್ಯೀಕೃತಾಶ್ಚ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಮದರ್ಥಂ ಸರ್ವ್ವಂ ದ್ರವ್ಯಮ್ ಅಪ್ರತಿಷಿದ್ಧಂ ಕಿನ್ತು ನ ಸರ್ವ್ವಂ ಹಿತಜನಕಂ| ಮದರ್ಥಂ ಸರ್ವ್ವಮಪ್ರತಿಷಿದ್ಧಂ ತಥಾಪ್ಯಹಂ ಕಸ್ಯಾಪಿ ದ್ರವ್ಯಸ್ಯ ವಶೀಕೃತೋ ನ ಭವಿಷ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಉದರಾಯ ಭಕ್ಷ್ಯಾಣಿ ಭಕ್ಷ್ಯೇಭ್ಯಶ್ಚೋದರಂ, ಕಿನ್ತು ಭಕ್ಷ್ಯೋದರೇ ಈಶ್ವರೇಣ ನಾಶಯಿಷ್ಯೇತೇ; ಅಪರಂ ದೇಹೋ ನ ವ್ಯಭಿಚಾರಾಯ ಕಿನ್ತು ಪ್ರಭವೇ ಪ್ರಭುಶ್ಚ ದೇಹಾಯ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯಶ್ಚೇಶ್ವರಃ ಪ್ರಭುಮುತ್ಥಾಪಿತವಾನ್ ಸ ಸ್ವಶಕ್ತ್ಯಾಸ್ಮಾನಪ್ಯುತ್ಥಾಪಯಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಯುಷ್ಮಾಕಂ ಯಾನಿ ಶರೀರಾಣಿ ತಾನಿ ಖ್ರೀಷ್ಟಸ್ಯಾಙ್ಗಾನೀತಿ ಕಿಂ ಯೂಯಂ ನ ಜಾನೀಥ? ಅತಃ ಖ್ರೀಷ್ಟಸ್ಯ ಯಾನ್ಯಙ್ಗಾನಿ ತಾನಿ ಮಯಾಪಹೃತ್ಯ ವೇಶ್ಯಾಯಾ ಅಙ್ಗಾನಿ ಕಿಂ ಕಾರಿಷ್ಯನ್ತೇ? ತನ್ನ ಭವತು|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯಃ ಕಶ್ಚಿದ್ ವೇಶ್ಯಾಯಾಮ್ ಆಸಜ್ಯತೇ ಸ ತಯಾ ಸಹೈಕದೇಹೋ ಭವತಿ ಕಿಂ ಯೂಯಮೇತನ್ನ ಜಾನೀಥ? ಯತೋ ಲಿಖಿತಮಾಸ್ತೇ, ಯಥಾ, ತೌ ದ್ವೌ ಜನಾವೇಕಾಙ್ಗೌ ಭವಿಷ್ಯತಃ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಮಾನವಾ ಯಾನ್ಯನ್ಯಾನಿ ಕಲುಷಾಣಿ ಕುರ್ವ್ವತೇ ತಾನಿ ವಪು ರ್ನ ಸಮಾವಿಶನ್ತಿ ಕಿನ್ತು ವ್ಯಭಿಚಾರಿಣಾ ಸ್ವವಿಗ್ರಹಸ್ಯ ವಿರುದ್ಧಂ ಕಲ್ಮಷಂ ಕ್ರಿಯತೇ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಮಾನವಾ ಯಾನ್ಯನ್ಯಾನಿ ಕಲುಷಾಣಿ ಕುರ್ವ್ವತೇ ತಾನಿ ವಪು ರ್ನ ಸಮಾವಿಶನ್ತಿ ಕಿನ್ತು ವ್ಯಭಿಚಾರಿಣಾ ಸ್ವವಿಗ್ರಹಸ್ಯ ವಿರುದ್ಧಂ ಕಲ್ಮಷಂ ಕ್ರಿಯತೇ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಯುಷ್ಮಾಕಂ ಯಾನಿ ವಪೂಂಸಿ ತಾನಿ ಯುಷ್ಮದನ್ತಃಸ್ಥಿತಸ್ಯೇಶ್ವರಾಲ್ಲಬ್ಧಸ್ಯ ಪವಿತ್ರಸ್ಯಾತ್ಮನೋ ಮನ್ದಿರಾಣಿ ಯೂಯಞ್ಚ ಸ್ವೇಷಾಂ ಸ್ವಾಮಿನೋ ನಾಧ್ವೇ ಕಿಮೇತದ್ ಯುಷ್ಮಾಭಿ ರ್ನ ಜ್ಞಾಯತೇ?</para>
  <para style="p">
    <verse number="20" style="v"/>ಯೂಯಂ ಮೂಲ್ಯೇನ ಕ್ರೀತಾ ಅತೋ ವಪುರ್ಮನೋಭ್ಯಾಮ್ ಈಶ್ವರೋ ಯುಷ್ಮಾಭಿಃ ಪೂಜ್ಯತಾಂ ಯತ ಈಶ್ವರ ಏವ ತಯೋಃ ಸ್ವಾಮೀ|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅಪರಞ್ಚ ಯುಷ್ಮಾಭಿ ರ್ಮಾಂ ಪ್ರತಿ ಯತ್ ಪತ್ರಮಲೇಖಿ ತಸ್ಯೋತ್ತರಮೇತತ್, ಯೋಷಿತೋಽಸ್ಪರ್ಶನಂ ಮನುಜಸ್ಯ ವರಂ;</para>
  <para style="p">
    <verse number="2" style="v"/>ಕಿನ್ತು ವ್ಯಭಿಚಾರಭಯಾದ್ ಏಕೈಕಸ್ಯ ಪುಂಸಃ ಸ್ವಕೀಯಭಾರ್ಯ್ಯಾ ಭವತು ತದ್ವದ್ ಏಕೈಕಸ್ಯಾ ಯೋಷಿತೋ ಽಪಿ ಸ್ವಕೀಯಭರ್ತ್ತಾ ಭವತು|</para>
  <para style="p">
    <verse number="3" style="v"/>ಭಾರ್ಯ್ಯಾಯೈ ಭರ್ತ್ರಾ ಯದ್ಯದ್ ವಿತರಣೀಯಂ ತದ್ ವಿತೀರ್ಯ್ಯತಾಂ ತದ್ವದ್ ಭರ್ತ್ರೇಽಪಿ ಭಾರ್ಯ್ಯಯಾ ವಿತರಣೀಯಂ ವಿತೀರ್ಯ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಭಾರ್ಯ್ಯಾಯಾಃ ಸ್ವದೇಹೇ ಸ್ವತ್ವಂ ನಾಸ್ತಿ ಭರ್ತ್ತುರೇವ, ತದ್ವದ್ ಭರ್ತ್ತುರಪಿ ಸ್ವದೇಹೇ ಸ್ವತ್ವಂ ನಾಸ್ತಿ ಭಾರ್ಯ್ಯಾಯಾ ಏವ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಉಪೋಷಣಪ್ರಾರ್ಥನಯೋಃ ಸೇವನಾರ್ಥಮ್ ಏಕಮನ್ತ್ರಣಾನಾಂ ಯುಷ್ಮಾಕಂ ಕಿಯತ್ಕಾಲಂ ಯಾವದ್ ಯಾ ಪೃಥಕ್ಸ್ಥಿತಿ ರ್ಭವತಿ ತದನ್ಯೋ ವಿಚ್ಛೇದೋ ಯುಷ್ಮನ್ಮಧ್ಯೇ ನ ಭವತು, ತತಃ ಪರಮ್ ಇನ್ದ್ರಿಯಾಣಾಮ್ ಅಧೈರ್ಯ್ಯಾತ್ ಶಯತಾನ್ ಯದ್ ಯುಷ್ಮಾನ್ ಪರೀಕ್ಷಾಂ ನ ನಯೇತ್ ತದರ್ಥಂ ಪುನರೇಕತ್ರ ಮಿಲತ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಏತದ್ ಆದೇಶತೋ ನಹಿ ಕಿನ್ತ್ವನುಜ್ಞಾತ ಏವ ಮಯಾ ಕಥ್ಯತೇ,</para>
  <para style="p">
    <verse number="7" style="v"/>ಯತೋ ಮಮಾವಸ್ಥೇವ ಸರ್ವ್ವಮಾನವಾನಾಮವಸ್ಥಾ ಭವತ್ವಿತಿ ಮಮ ವಾಞ್ಛಾ ಕಿನ್ತ್ವೀಶ್ವರಾದ್ ಏಕೇನೈಕೋ ವರೋಽನ್ಯೇನ ಚಾನ್ಯೋ ವರ ಇತ್ಥಮೇಕೈಕೇನ ಸ್ವಕೀಯವರೋ ಲಬ್ಧಃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಅಪರಮ್ ಅಕೃತವಿವಾಹಾನ್ ವಿಧವಾಶ್ಚ ಪ್ರತಿ ಮಮೈತನ್ನಿವೇದನಂ ಮಮೇವ ತೇಷಾಮವಸ್ಥಿತಿ ರ್ಭದ್ರಾ;</para>
  <para style="p">
    <verse number="9" style="v"/>ಕಿಞ್ಚ ಯದಿ ತೈರಿನ್ದ್ರಿಯಾಣಿ ನಿಯನ್ತುಂ ನ ಶಕ್ಯನ್ತೇ ತರ್ಹಿ ವಿವಾಹಃ ಕ್ರಿಯತಾಂ ಯತಃ ಕಾಮದಹನಾದ್ ವ್ಯೂಢತ್ವಂ ಭದ್ರಂ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯೇ ಚ ಕೃತವಿವಾಹಾಸ್ತೇ ಮಯಾ ನಹಿ ಪ್ರಭುನೈವೈತದ್ ಆಜ್ಞಾಪ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಭಾರ್ಯ್ಯಾ ಭರ್ತ್ತೃತಃ ಪೃಥಕ್ ನ ಭವತು| ಯದಿ ವಾ ಪೃಥಗ್ಭೂತಾ ಸ್ಯಾತ್ ತರ್ಹಿ ನಿರ್ವಿವಾಹಾ ತಿಷ್ಠತು ಸ್ವೀಯಪತಿನಾ ವಾ ಸನ್ದಧಾತು ಭರ್ತ್ತಾಪಿ ಭಾರ್ಯ್ಯಾಂ ನ ತ್ಯಜತು|</para>
  <para style="p">
    <verse number="12" style="v"/>ಇತರಾನ್ ಜನಾನ್ ಪ್ರತಿ ಪ್ರಭು ರ್ನ ಬ್ರವೀತಿ ಕಿನ್ತ್ವಹಂ ಬ್ರವೀಮಿ; ಕಸ್ಯಚಿದ್ ಭ್ರಾತುರ್ಯೋಷಿದ್ ಅವಿಶ್ವಾಸಿನೀ ಸತ್ಯಪಿ ಯದಿ ತೇನ ಸಹವಾಸೇ ತುಷ್ಯತಿ ತರ್ಹಿ ಸಾ ತೇನ ನ ತ್ಯಜ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="13" style="v"/>ತದ್ವತ್ ಕಸ್ಯಾಶ್ಚಿದ್ ಯೋಷಿತಃ ಪತಿರವಿಶ್ವಾಸೀ ಸನ್ನಪಿ ಯದಿ ತಯಾ ಸಹವಾಸೇ ತುಷ್ಯತಿ ತರ್ಹಿ ಸ ತಯಾ ನ ತ್ಯಜ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯತೋಽವಿಶ್ವಾಸೀ ಭರ್ತ್ತಾ ಭಾರ್ಯ್ಯಯಾ ಪವಿತ್ರೀಭೂತಃ, ತದ್ವದವಿಶ್ವಾಸಿನೀ ಭಾರ್ಯ್ಯಾ ಭರ್ತ್ರಾ ಪವಿತ್ರೀಭೂತಾ; ನೋಚೇದ್ ಯುಷ್ಮಾಕಮಪತ್ಯಾನ್ಯಶುಚೀನ್ಯಭವಿಷ್ಯನ್ ಕಿನ್ತ್ವಧುನಾ ತಾನಿ ಪವಿತ್ರಾಣಿ ಸನ್ತಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅವಿಶ್ವಾಸೀ ಜನೋ ಯದಿ ವಾ ಪೃಥಗ್ ಭವತಿ ತರ್ಹಿ ಪೃಥಗ್ ಭವತು; ಏತೇನ ಭ್ರಾತಾ ಭಗಿನೀ ವಾ ನ ನಿಬಧ್ಯತೇ ತಥಾಪಿ ವಯಮೀಶ್ವರೇಣ ಶಾನ್ತಯೇ ಸಮಾಹೂತಾಃ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಹೇ ನಾರಿ ತವ ಭರ್ತ್ತುಃ ಪರಿತ್ರಾಣಂ ತ್ವತ್ತೋ ಭವಿಷ್ಯತಿ ನ ವೇತಿ ತ್ವಯಾ ಕಿಂ ಜ್ಞಾಯತೇ? ಹೇ ನರ ತವ ಜಾಯಾಯಾಃ ಪರಿತ್ರಾಣಂ ತ್ವತ್ತೇा ಭವಿಷ್ಯತಿ ನ ವೇತಿ ತ್ವಯಾ ಕಿಂ ಜ್ಞಾಯತೇ?</para>
  <para style="p">
    <verse number="17" style="v"/>ಏಕೈಕೋ ಜನಃ ಪರಮೇಶ್ವರಾಲ್ಲಬ್ಧಂ ಯದ್ ಭಜತೇ ಯಸ್ಯಾಞ್ಚಾವಸ್ಥಾಯಾಮ್ ಈಶ್ವರೇಣಾಹ್ವಾಯಿ ತದನುಸಾರೇಣೈವಾಚರತು ತದಹಂ ಸರ್ವ್ವಸಮಾಜಸ್ಥಾನ್ ಆದಿಶಾಮಿ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಛಿನ್ನತ್ವಗ್ ಭೃತ್ವಾ ಯ ಆಹೂತಃ ಸ ಪ್ರಕೃಷ್ಟತ್ವಕ್ ನ ಭವತು, ತದ್ವದ್ ಅಛಿನ್ನತ್ವಗ್ ಭೂತ್ವಾ ಯ ಆಹೂತಃ ಸ ಛಿನ್ನತ್ವಕ್ ನ ಭವತು|</para>
  <para style="p">
    <verse number="19" style="v"/>ತ್ವಕ್ಛೇದಃ ಸಾರೋ ನಹಿ ತದ್ವದತ್ವಕ್ಛೇದೋಽಪಿ ಸಾರೋ ನಹಿ ಕಿನ್ತ್ವೀಶ್ವರಸ್ಯಾಜ್ಞಾನಾಂ ಪಾಲನಮೇವ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಯೋ ಜನೋ ಯಸ್ಯಾಮವಸ್ಥಾಯಾಮಾಹ್ವಾಯಿ ಸ ತಸ್ಯಾಮೇವಾವತಿಷ್ಠತಾಂ|</para>
  <para style="p">
    <verse number="21" style="v"/>ದಾಸಃ ಸನ್ ತ್ವಂ ಕಿಮಾಹೂತೋಽಸಿ? ತನ್ಮಾ ಚಿನ್ತಯ, ತಥಾಚ ಯದಿ ಸ್ವತನ್ತ್ರೋ ಭವಿತುಂ ಶಕ್ನುಯಾಸ್ತರ್ಹಿ ತದೇವ ವೃಣು|</para>
  <para style="p">
    <verse number="22" style="v"/>ಯತಃ ಪ್ರಭುನಾಹೂತೋ ಯೋ ದಾಸಃ ಸ ಪ್ರಭೋ ರ್ಮೋಚಿತಜನಃ| ತದ್ವದ್ ತೇನಾಹೂತಃ ಸ್ವತನ್ತ್ರೋ ಜನೋಽಪಿ ಖ್ರೀಷ್ಟಸ್ಯ ದಾಸ ಏವ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಯೂಯಂ ಮೂಲ್ಯೇನ ಕ್ರೀತಾ ಅತೋ ಹೇತೋ ರ್ಮಾನವಾನಾಂ ದಾಸಾ ಮಾ ಭವತ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಹೇ ಭ್ರಾತರೋ ಯಸ್ಯಾಮವಸ್ಥಾಯಾಂ ಯಸ್ಯಾಹ್ವಾನಮಭವತ್ ತಯಾ ಸ ಈಶ್ವರಸ್ಯ ಸಾಕ್ಷಾತ್ ತಿಷ್ಠತು|</para>
  <para style="p">
    <verse number="25" style="v"/>ಅಪರಮ್ ಅಕೃತವಿವಾಹಾನ್ ಜನಾನ್ ಪ್ರತಿ ಪ್ರಭೋಃ ಕೋಽಪ್ಯಾದೇಶೋ ಮಯಾ ನ ಲಬ್ಧಃ ಕಿನ್ತು ಪ್ರಭೋರನುಕಮ್ಪಯಾ ವಿಶ್ವಾಸ್ಯೋ ಭೂತೋಽಹಂ ಯದ್ ಭದ್ರಂ ಮನ್ಯೇ ತದ್ ವದಾಮಿ|</para>
  <para style="p">
    <verse number="26" style="v"/>ವರ್ತ್ತಮಾನಾತ್ ಕ್ಲೇಶಸಮಯಾತ್ ಮನುಷ್ಯಸ್ಯಾನೂಢತ್ವಂ ಭದ್ರಮಿತಿ ಮಯಾ ಬುಧ್ಯತೇ|</para>
  <para style="p">
    <verse number="27" style="v"/>ತ್ವಂ ಕಿಂ ಯೋಷಿತಿ ನಿಬದ್ಧೋಽಸಿ ತರ್ಹಿ ಮೋಚನಂ ಪ್ರಾಪ್ತುಂ ಮಾ ಯತಸ್ವ| ಕಿಂ ವಾ ಯೋಷಿತೋ ಮುಕ್ತೋಽಸಿ? ತರ್ಹಿ ಜಾಯಾಂ ಮಾ ಗವೇಷಯ|</para>
  <para style="p">
    <verse number="28" style="v"/>ವಿವಾಹಂ ಕುರ್ವ್ವತಾ ತ್ವಯಾ ಕಿಮಪಿ ನಾಪಾರಾಧ್ಯತೇ ತದ್ವದ್ ವ್ಯೂಹ್ಯಮಾನಯಾ ಯುವತ್ಯಾಪಿ ಕಿಮಪಿ ನಾಪರಾಧ್ಯತೇ ತಥಾಚ ತಾದೃಶೌ ದ್ವೌ ಜನೌ ಶಾರೀರಿಕಂ ಕ್ಲೇಶಂ ಲಪ್ಸ್ಯೇತೇ ಕಿನ್ತು ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಮಮ ಕರುಣಾ ವಿದ್ಯತೇ|</para>
  <para style="p">
    <verse number="29" style="v"/>ಹೇ ಭ್ರಾತರೋಽಹಮಿದಂ ಬ್ರವೀಮಿ, ಇತಃ ಪರಂ ಸಮಯೋಽತೀವ ಸಂಕ್ಷಿಪ್ತಃ,</para>
  <para style="p">
    <verse number="30" style="v"/>ಅತಃ ಕೃತದಾರೈರಕೃತದಾರೈರಿವ ರುದದ್ಭಿಶ್ಚಾರುದದ್ಭಿರಿವ ಸಾನನ್ದೈಶ್ಚ ನಿರಾನನ್ದೈರಿವ ಕ್ರೇತೃಭಿಶ್ಚಾಭಾಗಿಭಿರಿವಾಚರಿತವ್ಯಂ</para>
  <para style="p">
    <verse number="31" style="v"/>ಯೇ ಚ ಸಂಸಾರೇ ಚರನ್ತಿ ತೈ ರ್ನಾತಿಚರಿತವ್ಯಂ ಯತ ಇಹಲೇाಕಸ್ಯ ಕೌತುಕೋ ವಿಚಲತಿ|</para>
  <para style="p">
    <verse number="32" style="v"/>ಕಿನ್ತು ಯೂಯಂ ಯನ್ನಿಶ್ಚಿನ್ತಾ ಭವೇತೇತಿ ಮಮ ವಾಞ್ಛಾ| ಅಕೃತವಿವಾಹೋ ಜನೋ ಯಥಾ ಪ್ರಭುಂ ಪರಿತೋಷಯೇತ್ ತಥಾ ಪ್ರಭುಂ ಚಿನ್ತಯತಿ,</para>
  <para style="p">
    <verse number="33" style="v"/>ಕಿನ್ತು ಕೃತವಿವಾಹೋ ಜನೋ ಯಥಾ ಭಾರ್ಯ್ಯಾಂ ಪರಿತೋಷಯೇತ್ ತಥಾ ಸಂಸಾರಂ ಚಿನ್ತಯತಿ|</para>
  <para style="p">
    <verse number="34" style="v"/>ತದ್ವದ್ ಊಢಯೋಷಿತೋ ಽನೂಢಾ ವಿಶಿಷ್ಯತೇ| ಯಾನೂಢಾ ಸಾ ಯಥಾ ಕಾಯಮನಸೋಃ ಪವಿತ್ರಾ ಭವೇತ್ ತಥಾ ಪ್ರಭುಂ ಚಿನ್ತಯತಿ ಯಾ ಚೋಢಾ ಸಾ ಯಥಾ ಭರ್ತ್ತಾರಂ ಪರಿತೋಷಯೇತ್ ತಥಾ ಸಂಸಾರಂ ಚಿನ್ತಯತಿ|</para>
  <para style="p">
    <verse number="35" style="v"/>ಅಹಂ ಯದ್ ಯುಷ್ಮಾನ್ ಮೃಗಬನ್ಧಿನ್ಯಾ ಪರಿಕ್ಷಿಪೇಯಂ ತದರ್ಥಂ ನಹಿ ಕಿನ್ತು ಯೂಯಂ ಯದನಿನ್ದಿತಾ ಭೂತ್ವಾ ಪ್ರಭೋಃ ಸೇವನೇಽಬಾಧಮ್ ಆಸಕ್ತಾ ಭವೇತ ತದರ್ಥಮೇತಾನಿ ಸರ್ವ್ವಾಣಿ ಯುಷ್ಮಾಕಂ ಹಿತಾಯ ಮಯಾ ಕಥ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="36" style="v"/>ಕಸ್ಯಚಿತ್ ಕನ್ಯಾಯಾಂ ಯೌವನಪ್ರಾಪ್ತಾಯಾಂ ಯದಿ ಸ ತಸ್ಯಾ ಅನೂಢತ್ವಂ ನಿನ್ದನೀಯಂ ವಿವಾಹಶ್ಚ ಸಾಧಯಿತವ್ಯ ಇತಿ ಮನ್ಯತೇ ತರ್ಹಿ ಯಥಾಭಿಲಾಷಂ ಕರೋತು, ಏತೇನ ಕಿಮಪಿ ನಾಪರಾತ್ಸ್ಯತಿ ವಿವಾಹಃ ಕ್ರಿಯತಾಂ|</para>
  <para style="p">
    <verse number="37" style="v"/>ಕಿನ್ತು ದುಃಖೇನಾಕ್ಲಿಷ್ಟಃ ಕಶ್ಚಿತ್ ಪಿತಾ ಯದಿ ಸ್ಥಿರಮನೋಗತಃ ಸ್ವಮನೋಽಭಿಲಾಷಸಾಧನೇ ಸಮರ್ಥಶ್ಚ ಸ್ಯಾತ್ ಮಮ ಕನ್ಯಾ ಮಯಾ ರಕ್ಷಿತವ್ಯೇತಿ ಮನಸಿ ನಿಶ್ಚಿನೋತಿ ಚ ತರ್ಹಿ ಸ ಭದ್ರಂ ಕರ್ಮ್ಮ ಕರೋತಿ|</para>
  <para style="p">
    <verse number="38" style="v"/>ಅತೋ ಯೋ ವಿವಾಹಂ ಕರೋತಿ ಸ ಭದ್ರಂ ಕರ್ಮ್ಮ ಕರೋತಿ ಯಶ್ಚ ವಿವಾಹಂ ನ ಕರೋತಿ ಸ ಭದ್ರತರಂ ಕರ್ಮ್ಮ ಕರೋತಿ|</para>
  <para style="p">
    <verse number="39" style="v"/>ಯಾವತ್ಕಾಲಂ ಪತಿ ರ್ಜೀವತಿ ತಾವದ್ ಭಾರ್ಯ್ಯಾ ವ್ಯವಸ್ಥಯಾ ನಿಬದ್ಧಾ ತಿಷ್ಠತಿ ಕಿನ್ತು ಪತ್ಯೌ ಮಹಾನಿದ್ರಾಂ ಗತೇ ಸಾ ಮುಕ್ತೀಭೂಯ ಯಮಭಿಲಷತಿ ತೇನ ಸಹ ತಸ್ಯಾ ವಿವಾಹೋ ಭವಿತುಂ ಶಕ್ನೋತಿ, ಕಿನ್ತ್ವೇತತ್ ಕೇವಲಂ ಪ್ರಭುಭಕ್ತಾನಾಂ ಮಧ್ಯೇ|</para>
  <para style="p">
    <verse number="40" style="v"/>ತಥಾಚ ಸಾ ಯದಿ ನಿಷ್ಪತಿಕಾ ತಿಷ್ಠತಿ ತರ್ಹಿ ತಸ್ಯಾಃ ಕ್ಷೇಮಂ ಭವಿಷ್ಯತೀತಿ ಮಮ ಭಾವಃ| ಅಪರಮ್ ಈಶ್ವರಸ್ಯಾತ್ಮಾ ಮಮಾಪ್ಯನ್ತ ರ್ವಿದ್ಯತ ಇತಿ ಮಯಾ ಬುಧ್ಯತೇ|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ದೇವಪ್ರಸಾದೇ ಸರ್ವ್ವೇಷಾಮ್ ಅಸ್ಮಾಕಂ ಜ್ಞಾನಮಾಸ್ತೇ ತದ್ವಯಂ ವಿದ್ಮಃ| ತಥಾಪಿ ಜ್ಞಾನಂ ಗರ್ವ್ವಂ ಜನಯತಿ ಕಿನ್ತು ಪ್ರೇಮತೋ ನಿಷ್ಠಾ ಜಾಯತೇ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಅತಃ ಕಶ್ಚನ ಯದಿ ಮನ್ಯತೇ ಮಮ ಜ್ಞಾನಮಾಸ್ತ ಇತಿ ತರ್ಹಿ ತೇನ ಯಾದೃಶಂ ಜ್ಞಾನಂ ಚೇಷ್ಟಿತವ್ಯಂ ತಾದೃಶಂ ಕಿಮಪಿ ಜ್ಞಾನಮದ್ಯಾಪಿ ನ ಲಬ್ಧಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಕಿನ್ತು ಯ ಈಶ್ವರೇ ಪ್ರೀಯತೇ ಸ ಈಶ್ವರೇಣಾಪಿ ಜ್ಞಾಯತೇ|</para>
  <para style="p">
    <verse number="4" style="v"/>ದೇವತಾಬಲಿಪ್ರಸಾದಭಕ್ಷಣೇ ವಯಮಿದಂ ವಿದ್ಮೋ ಯತ್ ಜಗನ್ಮಧ್ಯೇ ಕೋಽಪಿ ದೇವೋ ನ ವಿದ್ಯತೇ, ಏಕಶ್ಚೇಶ್ವರೋ ದ್ವಿತೀಯೋ ನಾಸ್ತೀತಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಸ್ವರ್ಗೇ ಪೃಥಿವ್ಯಾಂ ವಾ ಯದ್ಯಪಿ ಕೇಷುಚಿದ್ ಈಶ್ವರ ಇತಿ ನಾಮಾರೋಪ್ಯತೇ ತಾದೃಶಾಶ್ಚ ಬಹವ ಈಶ್ವರಾ ಬಹವಶ್ಚ ಪ್ರಭವೋ ವಿದ್ಯನ್ತೇ</para>
  <para style="p">
    <verse number="6" style="v"/>ತಥಾಪ್ಯಸ್ಮಾಕಮದ್ವಿತೀಯ ಈಶ್ವರಃ ಸ ಪಿತಾ ಯಸ್ಮಾತ್ ಸರ್ವ್ವೇಷಾಂ ಯದರ್ಥಞ್ಚಾಸ್ಮಾಕಂ ಸೃಷ್ಟಿ ರ್ಜಾತಾ, ಅಸ್ಮಾಕಞ್ಚಾದ್ವಿತೀಯಃ ಪ್ರಭುಃ ಸ ಯೀಶುಃ ಖ್ರೀಷ್ಟೋ ಯೇನ ಸರ್ವ್ವವಸ್ತೂನಾಂ ಯೇನಾಸ್ಮಾಕಮಪಿ ಸೃಷ್ಟಿಃ ಕೃತಾ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅಧಿಕನ್ತು ಜ್ಞಾನಂ ಸರ್ವ್ವೇಷಾಂ ನಾಸ್ತಿ ಯತಃ ಕೇಚಿದದ್ಯಾಪಿ ದೇವತಾಂ ಸಮ್ಮನ್ಯ ದೇವಪ್ರಸಾದಮಿವ ತದ್ ಭಕ್ಷ್ಯಂ ಭುಞ್ಜತೇ ತೇನ ದುರ್ಬ್ಬಲತಯಾ ತೇಷಾಂ ಸ್ವಾನ್ತಾನಿ ಮಲೀಮಸಾನಿ ಭವನ್ತಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಕಿನ್ತು ಭಕ್ಷ್ಯದ್ರವ್ಯಾದ್ ವಯಮ್ ಈಶ್ವರೇಣ ಗ್ರಾಹ್ಯಾ ಭವಾಮಸ್ತನ್ನಹಿ ಯತೋ ಭುಙ್ಕ್ತ್ವಾ ವಯಮುತ್ಕೃಷ್ಟಾ ನ ಭವಾಮಸ್ತದ್ವದಭುಙ್ಕ್ತ್ವಾಪ್ಯಪಕೃಷ್ಟಾ ನ ಭವಾಮಃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಅತೋ ಯುಷ್ಮಾಕಂ ಯಾ ಕ್ಷಮತಾ ಸಾ ದುರ್ಬ್ಬಲಾನಾಮ್ ಉನ್ಮಾಥಸ್ವರೂಪಾ ಯನ್ನ ಭವೇತ್ ತದರ್ಥಂ ಸಾವಧಾನಾ ಭವತ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯತೋ ಜ್ಞಾನವಿಶಿಷ್ಟಸ್ತ್ವಂ ಯದಿ ದೇವಾಲಯೇ ಉಪವಿಷ್ಟಃ ಕೇನಾಪಿ ದೃಶ್ಯಸೇ ತರ್ಹಿ ತಸ್ಯ ದುರ್ಬ್ಬಲಸ್ಯ ಮನಸಿ ಕಿಂ ಪ್ರಸಾದಭಕ್ಷಣ ಉತ್ಸಾಹೋ ನ ಜನಿಷ್ಯತೇ?</para>
  <para style="p">
    <verse number="11" style="v"/>ತಥಾ ಸತಿ ಯಸ್ಯ ಕೃತೇ ಖ್ರೀಷ್ಟೋ ಮಮಾರ ತವ ಸ ದುರ್ಬ್ಬಲೋ ಭ್ರಾತಾ ತವ ಜ್ಞಾನಾತ್ ಕಿಂ ನ ವಿನಂಕ್ಷ್ಯತಿ?</para>
  <para style="p">
    <verse number="12" style="v"/>ಇತ್ಯನೇನ ಪ್ರಕಾರೇಣ ಭ್ರಾತೃಣಾಂ ವಿರುದ್ಧಮ್ ಅಪರಾಧ್ಯದ್ಭಿಸ್ತೇಷಾಂ ದುರ್ಬ್ಬಲಾನಿ ಮನಾಂಸಿ ವ್ಯಾಘಾತಯದ್ಭಿಶ್ಚ ಯುಷ್ಮಾಭಿಃ ಖ್ರೀಷ್ಟಸ್ಯ ವೈಪರೀತ್ಯೇನಾಪರಾಧ್ಯತೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅತೋ ಹೇತೋಃ ಪಿಶಿತಾಶನಂ ಯದಿ ಮಮ ಭ್ರಾತು ರ್ವಿಘ್ನಸ್ವರೂಪಂ ಭವೇತ್ ತರ್ಹ್ಯಹಂ ಯತ್ ಸ್ವಭ್ರಾತು ರ್ವಿಘ್ನಜನಕೋ ನ ಭವೇಯಂ ತದರ್ಥಂ ಯಾವಜ್ಜೀವನಂ ಪಿಶಿತಂ ನ ಭೋಕ್ಷ್ಯೇ|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅಹಂ ಕಿಮ್ ಏಕಃ ಪ್ರೇರಿತೋ ನಾಸ್ಮಿ? ಕಿಮಹಂ ಸ್ವತನ್ತ್ರೋ ನಾಸ್ಮಿ? ಅಸ್ಮಾಕಂ ಪ್ರಭು ರ್ಯೀಶುಃ ಖ್ರೀಷ್ಟಃ ಕಿಂ ಮಯಾ ನಾದರ್ಶಿ? ಯೂಯಮಪಿ ಕಿಂ ಪ್ರಭುನಾ ಮದೀಯಶ್ರಮಫಲಸ್ವರೂಪಾ ನ ಭವಥ?</para>
  <para style="p">
    <verse number="2" style="v"/>ಅನ್ಯಲೋಕಾನಾಂ ಕೃತೇ ಯದ್ಯಪ್ಯಹಂ ಪ್ರೇರಿತೋ ನ ಭವೇಯಂ ತಥಾಚ ಯುಷ್ಮತ್ಕೃತೇ ಪ್ರೇರಿತೋಽಸ್ಮಿ ಯತಃ ಪ್ರಭುನಾ ಮಮ ಪ್ರೇರಿತತ್ವಪದಸ್ಯ ಮುದ್ರಾಸ್ವರೂಪಾ ಯೂಯಮೇವಾಧ್ವೇ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಯೇ ಲೋಕಾ ಮಯಿ ದೋಷಮಾರೋಪಯನ್ತಿ ತಾನ್ ಪ್ರತಿ ಮಮ ಪ್ರತ್ಯುತ್ತರಮೇತತ್|</para>
  <para style="p">
    <verse number="4" style="v"/>ಭೋಜನಪಾನಯೋಃ ಕಿಮಸ್ಮಾಕಂ ಕ್ಷಮತಾ ನಾಸ್ತಿ?</para>
  <para style="p">
    <verse number="5" style="v"/>ಅನ್ಯೇ ಪ್ರೇರಿತಾಃ ಪ್ರಭೋ ರ್ಭ್ರಾತರೌ ಕೈಫಾಶ್ಚ ಯತ್ ಕುರ್ವ್ವನ್ತಿ ತದ್ವತ್ ಕಾಞ್ಚಿತ್ ಧರ್ಮ್ಮಭಗಿನೀಂ ವ್ಯೂಹ್ಯ ತಯಾ ಸಾರ್ದ್ಧಂ ಪರ್ಯ್ಯಟಿತುಂ ವಯಂ ಕಿಂ ನ ಶಕ್ನುಮಃ?</para>
  <para style="p">
    <verse number="6" style="v"/>ಸಾಂಸಾರಿಕಶ್ರಮಸ್ಯ ಪರಿತ್ಯಾಗಾತ್ ಕಿಂ ಕೇವಲಮಹಂ ಬರ್ಣಬ್ಬಾಶ್ಚ ನಿವಾರಿತೌ?</para>
  <para style="p">
    <verse number="7" style="v"/>ನಿಜಧನವ್ಯಯೇನ ಕಃ ಸಂಗ್ರಾಮಂ ಕರೋತಿ? ಕೋ ವಾ ದ್ರಾಕ್ಷಾಕ್ಷೇತ್ರಂ ಕೃತ್ವಾ ತತ್ಫಲಾನಿ ನ ಭುಙ್ಕ್ತೇ? ಕೋ ವಾ ಪಶುವ್ರಜಂ ಪಾಲಯನ್ ತತ್ಪಯೋ ನ ಪಿವತಿ?</para>
  <para style="p">
    <verse number="8" style="v"/>ಕಿಮಹಂ ಕೇವಲಾಂ ಮಾನುಷಿಕಾಂ ವಾಚಂ ವದಾಮಿ? ವ್ಯವಸ್ಥಾಯಾಂ ಕಿಮೇತಾದೃಶಂ ವಚನಂ ನ ವಿದ್ಯತೇ?</para>
  <para style="p">
    <verse number="9" style="v"/>ಮೂಸಾವ್ಯವಸ್ಥಾಗ್ರನ್ಥೇ ಲಿಖಿತಮಾಸ್ತೇ, ತ್ವಂ ಶಸ್ಯಮರ್ದ್ದಕವೃಷಸ್ಯಾಸ್ಯಂ ನ ಭಂತ್ಸ್ಯಸೀತಿ| ಈಶ್ವರೇಣ ಬಲೀವರ್ದ್ದಾನಾಮೇವ ಚಿನ್ತಾ ಕಿಂ ಕ್ರಿಯತೇ?</para>
  <para style="p">
    <verse number="10" style="v"/>ಕಿಂ ವಾ ಸರ್ವ್ವಥಾಸ್ಮಾಕಂ ಕೃತೇ ತದ್ವಚನಂ ತೇನೋಕ್ತಂ? ಅಸ್ಮಾಕಮೇವ ಕೃತೇ ತಲ್ಲಿಖಿತಂ| ಯಃ ಕ್ಷೇತ್ರಂ ಕರ್ಷತಿ ತೇನ ಪ್ರತ್ಯಾಶಾಯುಕ್ತೇನ ಕರ್ಷ್ಟವ್ಯಂ, ಯಶ್ಚ ಶಸ್ಯಾನಿ ಮರ್ದ್ದಯತಿ ತೇನ ಲಾಭಪ್ರತ್ಯಾಶಾಯುಕ್ತೇನ ಮರ್ದ್ದಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಯುಷ್ಮತ್ಕೃತೇಽಸ್ಮಾಭಿಃ ಪಾರತ್ರಿಕಾಣಿ ಬೀಜಾನಿ ರೋಪಿತಾನಿ, ಅತೋ ಯುಷ್ಮಾಕಮೈಹಿಕಫಲಾನಾಂ ವಯಮ್ ಅಂಶಿನೋ ಭವಿಷ್ಯಾಮಃ ಕಿಮೇತತ್ ಮಹತ್ ಕರ್ಮ್ಮ?</para>
  <para style="p">
    <verse number="12" style="v"/>ಯುಷ್ಮಾಸು ಯೋಽಧಿಕಾರಸ್ತಸ್ಯ ಭಾಗಿನೋ ಯದ್ಯನ್ಯೇ ಭವೇಯುಸ್ತರ್ಹ್ಯಸ್ಮಾಭಿಸ್ತತೋಽಧಿಕಂ ಕಿಂ ತಸ್ಯ ಭಾಗಿಭಿ ರ್ನ ಭವಿತವ್ಯಂ? ಅಧಿಕನ್ತು ವಯಂ ತೇನಾಧಿಕಾರೇಣ ನ ವ್ಯವಹೃತವನ್ತಃ ಕಿನ್ತು ಖ್ರೀಷ್ಟೀಯಸುಸಂವಾದಸ್ಯ ಕೋಽಪಿ ವ್ಯಾಘಾತೋಽಸ್ಮಾಭಿರ್ಯನ್ನ ಜಾಯೇತ ತದರ್ಥಂ ಸರ್ವ್ವಂ ಸಹಾಮಹೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅಪರಂ ಯೇ ಪವಿತ್ರವಸ್ತೂನಾಂ ಪರಿಚರ್ಯ್ಯಾಂ ಕುರ್ವ್ವನ್ತಿ ತೇ ಪವಿತ್ರವಸ್ತುತೋ ಭಕ್ಷ್ಯಾಣಿ ಲಭನ್ತೇ, ಯೇ ಚ ವೇದ್ಯಾಃ ಪರಿಚರ್ಯ್ಯಾಂ ಕುರ್ವ್ವನ್ತಿ ತೇ ವೇದಿಸ್ಥವಸ್ತೂನಾಮ್ ಅಂಶಿನೋ ಭವನ್ತ್ಯೇತದ್ ಯೂಯಂ ಕಿಂ ನ ವಿದ?</para>
  <para style="p">
    <verse number="14" style="v"/>ತದ್ವದ್ ಯೇ ಸುಸಂವಾದಂ ಘೋಷಯನ್ತಿ ತೈಃ ಸುಸಂವಾದೇನ ಜೀವಿತವ್ಯಮಿತಿ ಪ್ರಭುನಾದಿಷ್ಟಂ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅಹಮೇತೇಷಾಂ ಸರ್ವ್ವೇಷಾಂ ಕಿಮಪಿ ನಾಶ್ರಿತವಾನ್ ಮಾಂ ಪ್ರತಿ ತದನುಸಾರಾತ್ ಆಚರಿತವ್ಯಮಿತ್ಯಾಶಯೇನಾಪಿ ಪತ್ರಮಿದಂ ಮಯಾ ನ ಲಿಖ್ಯತೇ ಯತಃ ಕೇನಾಪಿ ಜನೇನ ಮಮ ಯಶಸೋ ಮುಧಾಕರಣಾತ್ ಮಮ ಮರಣಂ ವರಂ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಸುಸಂವಾದಘೇಷಣಾತ್ ಮಮ ಯಶೋ ನ ಜಾಯತೇ ಯತಸ್ತದ್ಘೋಷಣಂ ಮಮಾವಶ್ಯಕಂ ಯದ್ಯಹಂ ಸುಸಂವಾದಂ ನ ಘೋಷಯೇಯಂ ತರ್ಹಿ ಮಾಂ ಧಿಕ್|</para>
  <para style="p">
    <verse number="17" style="v"/>ಇಚ್ಛುಕೇನ ತತ್ ಕುರ್ವ್ವತಾ ಮಯಾ ಫಲಂ ಲಪ್ಸ್ಯತೇ ಕಿನ್ತ್ವನಿಚ್ಛುಕೇಽಪಿ ಮಯಿ ತತ್ಕರ್ಮ್ಮಣೋ ಭಾರೋಽರ್ಪಿತೋಽಸ್ತಿ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಏತೇನ ಮಯಾ ಲಭ್ಯಂ ಫಲಂ ಕಿಂ? ಸುಸಂವಾದೇನ ಮಮ ಯೋಽಧಿಕಾರ ಆಸ್ತೇ ತಂ ಯದಭದ್ರಭಾವೇನ ನಾಚರೇಯಂ ತದರ್ಥಂ ಸುಸಂವಾದಘೋಷಣಸಮಯೇ ತಸ್ಯ ಖ್ರೀಷ್ಟೀಯಸುಸಂವಾದಸ್ಯ ನಿರ್ವ್ಯಯೀಕರಣಮೇವ ಮಮ ಫಲಂ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಸರ್ವ್ವೇಷಾಮ್ ಅನಾಯತ್ತೋಽಹಂ ಯದ್ ಭೂರಿಶೋ ಲೋಕಾನ್ ಪ್ರತಿಪದ್ಯೇ ತದರ್ಥಂ ಸರ್ವ್ವೇಷಾಂ ದಾಸತ್ವಮಙ್ಗೀಕೃತವಾನ್|</para>
  <para style="p">
    <verse number="20" style="v"/>ಯಿಹೂದೀಯಾನ್ ಯತ್ ಪ್ರತಿಪದ್ಯೇ ತದರ್ಥಂ ಯಿಹೂದೀಯಾನಾಂ ಕೃತೇ ಯಿಹೂದೀಯಇವಾಭವಂ| ಯೇ ಚ ವ್ಯವಸ್ಥಾಯತ್ತಾಸ್ತಾನ್ ಯತ್ ಪ್ರತಿಪದ್ಯೇ ತದರ್ಥಂ ವ್ಯವಸ್ಥಾನಾಯತ್ತೋ ಯೋಽಹಂ ಸೋಽಹಂ ವ್ಯವಸ್ಥಾಯತ್ತಾನಾಂ ಕೃತೇ ವ್ಯವಸ್ಥಾಯತ್ತಇವಾಭವಂ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಯೇ ಚಾಲಬ್ಧವ್ಯವಸ್ಥಾಸ್ತಾನ್ ಯತ್ ಪ್ರತಿಪದ್ಯೇ ತದರ್ಥಮ್ ಈಶ್ವರಸ್ಯ ಸಾಕ್ಷಾದ್ ಅಲಬ್ಧವ್ಯವಸ್ಥೋ ನ ಭೂತ್ವಾ ಖ್ರೀಷ್ಟೇನ ಲಬ್ಧವ್ಯವಸ್ಥೋ ಯೋಽಹಂ ಸೋಽಹಮ್ ಅಲಬ್ಧವ್ಯವಸ್ಥಾನಾಂ ಕೃತೇಽಲಬ್ಧವ್ಯವಸ್ಥ ಇವಾಭವಂ|</para>
  <para style="p">
    <verse number="22" style="v"/>ದುರ್ಬ್ಬಲಾನ್ ಯತ್ ಪ್ರತಿಪದ್ಯೇ ತದರ್ಥಮಹಂ ದುರ್ಬ್ಬಲಾನಾಂ ಕೃತೇ ದುರ್ಬ್ಬಲಇವಾಭವಂ| ಇತ್ಥಂ ಕೇನಾಪಿ ಪ್ರಕಾರೇಣ ಕತಿಪಯಾ ಲೋಕಾ ಯನ್ಮಯಾ ಪರಿತ್ರಾಣಂ ಪ್ರಾಪ್ನುಯುಸ್ತದರ್ಥಂ ಯೋ ಯಾದೃಶ ಆಸೀತ್ ತಸ್ಯ ಕೃತೇ ಽಹಂ ತಾದೃಶಇವಾಭವಂ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಇದೃಶ ಆಚಾರಃ ಸುಸಂವಾದಾರ್ಥಂ ಮಯಾ ಕ್ರಿಯತೇ ಯತೋಽಹಂ ತಸ್ಯ ಫಲಾನಾಂ ಸಹಭಾಗೀ ಭವಿತುಮಿಚ್ಛಾಮಿ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಪಣ್ಯಲಾಭಾರ್ಥಂ ಯೇ ಧಾವನ್ತಿ ಧಾವತಾಂ ತೇಷಾಂ ಸರ್ವ್ವೇಷಾಂ ಕೇವಲ ಏಕಃ ಪಣ್ಯಂ ಲಭತೇ ಯುಷ್ಮಾಭಿಃ ಕಿಮೇತನ್ನ ಜ್ಞಾಯತೇ? ಅತೋ ಯೂಯಂ ಯಥಾ ಪಣ್ಯಂ ಲಪ್ಸ್ಯಧ್ವೇ ತಥೈವ ಧಾವತ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಮಲ್ಲಾ ಅಪಿ ಸರ್ವ್ವಭೋಗೇ ಪರಿಮಿತಭೋಗಿನೋ ಭವನ್ತಿ ತೇ ತು ಮ್ಲಾನಾಂ ಸ್ರಜಂ ಲಿಪ್ಸನ್ತೇ ಕಿನ್ತು ವಯಮ್ ಅಮ್ಲಾನಾಂ ಲಿಪ್ಸಾಮಹೇ|</para>
  <para style="p">
    <verse number="26" style="v"/>ತಸ್ಮಾದ್ ಅಹಮಪಿ ಧಾವಾಮಿ ಕಿನ್ತು ಲಕ್ಷ್ಯಮನುದ್ದಿಶ್ಯ ಧಾವಾಮಿ ತನ್ನಹಿ| ಅಹಂ ಮಲ್ಲಇವ ಯುಧ್ಯಾಮಿ ಚ ಕಿನ್ತು ಛಾಯಾಮಾಘಾತಯನ್ನಿವ ಯುಧ್ಯಾಮಿ ತನ್ನಹಿ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಇತರಾನ್ ಪ್ರತಿ ಸುಸಂವಾದಂ ಘೋಷಯಿತ್ವಾಹಂ ಯತ್ ಸ್ವಯಮಗ್ರಾಹ್ಯೋ ನ ಭವಾಮಿ ತದರ್ಥಂ ದೇಹಮ್ ಆಹನ್ಮಿ ವಶೀಕುರ್ವ್ವೇ ಚ|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಅಸ್ಮತ್ಪಿತೃಪುರುಷಾನಧಿ ಯೂಯಂ ಯದಜ್ಞಾತಾ ನ ತಿಷ್ಠತೇತಿ ಮಮ ವಾಞ್ಛಾ, ತೇ ಸರ್ವ್ವೇ ಮೇಘಾಧಃಸ್ಥಿತಾ ಬಭೂವುಃ ಸರ್ವ್ವೇ ಸಮುದ್ರಮಧ್ಯೇನ ವವ್ರಜುಃ,</para>
  <para style="p">
    <verse number="2" style="v"/>ಸರ್ವ್ವೇ ಮೂಸಾಮುದ್ದಿಶ್ಯ ಮೇಘಸಮುದ್ರಯೋ ರ್ಮಜ್ಜಿತಾ ಬಭೂವುಃ</para>
  <para style="p">
    <verse number="3" style="v"/>ಸರ್ವ್ವ ಏಕಮ್ ಆತ್ಮಿಕಂ ಭಕ್ಷ್ಯಂ ಬುಭುಜಿರ ಏಕಮ್ ಆತ್ಮಿಕಂ ಪೇಯಂ ಪಪುಶ್ಚ</para>
  <para style="p">
    <verse number="4" style="v"/>ಯತಸ್ತೇಽನುಚರತ ಆತ್ಮಿಕಾದ್ ಅಚಲಾತ್ ಲಬ್ಧಂ ತೋಯಂ ಪಪುಃ ಸೋಽಚಲಃ ಖ್ರೀಷ್ಟಏವ|</para>
  <para style="p">
    <verse number="5" style="v"/>ತಥಾ ಸತ್ಯಪಿ ತೇಷಾಂ ಮಧ್ಯೇಽಧಿಕೇಷು ಲೋಕೇಷ್ವೀಶ್ವರೋ ನ ಸನ್ತುತೋಷೇತಿ ಹೇತೋಸ್ತೇ ಪ್ರನ್ತರೇ ನಿಪಾತಿತಾಃ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಏತಸ್ಮಿನ್ ತೇ ಽಸ್ಮಾಕಂ ನಿದರ್ಶನಸ್ವರೂಪಾ ಬಭೂವುಃ; ಅತಸ್ತೇ ಯಥಾ ಕುತ್ಸಿತಾಭಿಲಾಷಿಣೋ ಬಭೂವುರಸ್ಮಾಭಿಸ್ತಥಾ ಕುತ್ಸಿತಾಭಿಲಾಷಿಭಿ ರ್ನ ಭವಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಲಿಖಿತಮಾಸ್ತೇ, ಲೋಕಾ ಭೋಕ್ತುಂ ಪಾತುಞ್ಚೋಪವಿವಿಶುಸ್ತತಃ ಕ್ರೀಡಿತುಮುತ್ಥಿತಾ ಇತಯನೇನ ಪ್ರಕಾರೇಣ ತೇಷಾಂ ಕೈಶ್ಚಿದ್ ಯದ್ವದ್ ದೇವಪೂಜಾ ಕೃತಾ ಯುಷ್ಮಾಭಿಸ್ತದ್ವತ್ ನ ಕ್ರಿಯತಾಂ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಅಪರಂ ತೇಷಾಂ ಕೈಶ್ಚಿದ್ ಯದ್ವದ್ ವ್ಯಭಿಚಾರಃ ಕೃತಸ್ತೇನ ಚೈಕಸ್ಮಿನ್ ದಿನೇ ತ್ರಯೋವಿಂಶತಿಸಹಸ್ರಾಣಿ ಲೋಕಾ ನಿಪಾತಿತಾಸ್ತದ್ವದ್ ಅಸ್ಮಾಭಿ ರ್ವ್ಯಭಿಚಾರೋ ನ ಕರ್ತ್ತವ್ಯಃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ತೇಷಾಂ ಕೇಚಿದ್ ಯದ್ವತ್ ಖ್ರೀಷ್ಟಂ ಪರೀಕ್ಷಿತವನ್ತಸ್ತಸ್ಮಾದ್ ಭುಜಙ್ಗೈ ರ್ನಷ್ಟಾಶ್ಚ ತದ್ವದ್ ಅಸ್ಮಾಭಿಃ ಖ್ರೀಷ್ಟೋ ನ ಪರೀಕ್ಷಿತವ್ಯಃ|</para>
  <para style="p">
    <verse number="10" style="v"/>ತೇಷಾಂ ಕೇಚಿದ್ ಯಥಾ ವಾಕ್ಕಲಹಂ ಕೃತವನ್ತಸ್ತತ್ಕಾರಣಾತ್ ಹನ್ತ್ರಾ ವಿನಾಶಿತಾಶ್ಚ ಯುಷ್ಮಾಭಿಸ್ತದ್ವದ್ ವಾಕ್ಕಲಹೋ ನ ಕ್ರಿಯತಾಂ|</para>
  <para style="p">
    <verse number="11" style="v"/>ತಾನ್ ಪ್ರತಿ ಯಾನ್ಯೇತಾನಿ ಜಘಟಿರೇ ತಾನ್ಯಸ್ಮಾಕಂ ನಿದರ್ಶನಾನಿ ಜಗತಃ ಶೇಷಯುಗೇ ವರ್ತ್ತಮಾನಾನಾಮ್ ಅಸ್ಮಾಕಂ ಶಿಕ್ಷಾರ್ಥಂ ಲಿಖಿತಾನಿ ಚ ಬಭೂವುಃ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಅತಏವ ಯಃ ಕಶ್ಚಿದ್ ಸುಸ್ಥಿರಂಮನ್ಯಃ ಸ ಯನ್ನ ಪತೇತ್ ತತ್ರ ಸಾವಧಾನೋ ಭವತು|</para>
  <para style="p">
    <verse number="13" style="v"/>ಮಾನುಷಿಕಪರೀಕ್ಷಾತಿರಿಕ್ತಾ ಕಾಪಿ ಪರೀಕ್ಷಾ ಯುಷ್ಮಾನ್ ನಾಕ್ರಾಮತ್, ಈಶ್ವರಶ್ಚ ವಿಶ್ವಾಸ್ಯಃ ಸೋಽತಿಶಕ್ತ್ಯಾಂ ಪರೀಕ್ಷಾಯಾಂ ಪತನಾತ್ ಯುಷ್ಮಾನ್ ರಕ್ಷಿಷ್ಯತಿ, ಪರೀಕ್ಷಾ ಚ ಯದ್ ಯುಷ್ಮಾಭಿಃ ಸೋಢುಂ ಶಕ್ಯತೇ ತದರ್ಥಂ ತಯಾ ಸಹ ನಿಸ್ತಾರಸ್ಯ ಪನ್ಥಾನಂ ನಿರೂಪಯಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಹೇ ಪ್ರಿಯಭ್ರಾತರಃ, ದೇವಪೂಜಾತೋ ದೂರಮ್ ಅಪಸರತ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅಹಂ ಯುಷ್ಮಾನ್ ವಿಜ್ಞಾನ್ ಮತ್ವಾ ಪ್ರಭಾಷೇ ಮಯಾ ಯತ್ ಕಥ್ಯತೇ ತದ್ ಯುಷ್ಮಾಭಿ ರ್ವಿವಿಚ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯದ್ ಧನ್ಯವಾದಪಾತ್ರಮ್ ಅಸ್ಮಾಭಿ ರ್ಧನ್ಯಂ ಗದ್ಯತೇ ತತ್ ಕಿಂ ಖ್ರೀಷ್ಟಸ್ಯ ಶೋಣಿತಸ್ಯ ಸಹಭಾಗಿತ್ವಂ ನಹಿ? ಯಶ್ಚ ಪೂಪೋಽಸ್ಮಾಭಿ ರ್ಭಜ್ಯತೇ ಸ ಕಿಂ ಖ್ರೀಷ್ಟಸ್ಯ ವಪುಷಃ ಸಹಭಾಗಿತ್ವಂ ನಹಿ?</para>
  <para style="p">
    <verse number="17" style="v"/>ವಯಂ ಬಹವಃ ಸನ್ತೋಽಪ್ಯೇಕಪೂಪಸ್ವರೂಪಾ ಏಕವಪುಃಸ್ವರೂಪಾಶ್ಚ ಭವಾಮಃ, ಯತೋ ವಯಂ ಸರ್ವ್ವ ಏಕಪೂಪಸ್ಯ ಸಹಭಾಗಿನಃ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಯೂಯಂ ಶಾರೀರಿಕಮ್ ಇಸ್ರಾಯೇಲೀಯವಂಶಂ ನಿರೀಕ್ಷಧ್ವಂ| ಯೇ ಬಲೀನಾಂ ಮಾಂಸಾನಿ ಭುಞ್ಜತೇ ತೇ ಕಿಂ ಯಜ್ಞವೇದ್ಯಾಃ ಸಹಭಾಗಿನೋ ನ ಭವನ್ತಿ?</para>
  <para style="p">
    <verse number="19" style="v"/>ಇತ್ಯನೇನ ಮಯಾ ಕಿಂ ಕಥ್ಯತೇ? ದೇವತಾ ವಾಸ್ತವಿಕೀ ದೇವತಾಯೈ ಬಲಿದಾನಂ ವಾ ವಾಸ್ತವಿಕಂ ಕಿಂ ಭವೇತ್?</para>
  <para style="p">
    <verse number="20" style="v"/>ತನ್ನಹಿ ಕಿನ್ತು ಭಿನ್ನಜಾತಿಭಿ ರ್ಯೇ ಬಲಯೋ ದೀಯನ್ತೇ ತ ಈಶ್ವರಾಯ ತನ್ನಹಿ ಭೂತೇಭ್ಯಏವ ದೀಯನ್ತೇ ತಸ್ಮಾದ್ ಯೂಯಂ ಯದ್ ಭೂತಾನಾಂ ಸಹಭಾಗಿನೋ ಭವಥೇತ್ಯಹಂ ನಾಭಿಲಷಾಮಿ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಪ್ರಭೋಃ ಕಂಸೇನ ಭೂತಾನಾಮಪಿ ಕಂಸೇನ ಪಾನಂ ಯುಷ್ಮಾಭಿರಸಾಧ್ಯಂ; ಯೂಯಂ ಪ್ರಭೋ ರ್ಭೋಜ್ಯಸ್ಯ ಭೂತಾನಾಮಪಿ ಭೋಜ್ಯಸ್ಯ ಸಹಭಾಗಿನೋ ಭವಿತುಂ ನ ಶಕ್ನುಥ|</para>
  <para style="p">
    <verse number="22" style="v"/>ವಯಂ ಕಿಂ ಪ್ರಭುಂ ಸ್ಪರ್ದ್ಧಿಷ್ಯಾಮಹೇ? ವಯಂ ಕಿಂ ತಸ್ಮಾದ್ ಬಲವನ್ತಃ?</para>
  <para style="p">
    <verse number="23" style="v"/>ಮಾಂ ಪ್ರತಿ ಸರ್ವ್ವಂ ಕರ್ಮ್ಮಾಪ್ರತಿಷಿದ್ಧಂ ಕಿನ್ತು ನ ಸರ್ವ್ವಂ ಹಿತಜನಕಂ ಸರ್ವ್ವಮ್ ಅಪ್ರತಿಷಿದ್ಧಂ ಕಿನ್ತು ನ ಸರ್ವ್ವಂ ನಿಷ್ಠಾಜನಕಂ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಆತ್ಮಹಿತಃ ಕೇನಾಪಿ ನ ಚೇಷ್ಟಿತವ್ಯಃ ಕಿನ್ತು ಸರ್ವ್ವೈಃ ಪರಹಿತಶ್ಚೇಷ್ಟಿತವ್ಯಃ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಆಪಣೇ ಯತ್ ಕ್ರಯ್ಯಂ ತದ್ ಯುಷ್ಮಾಭಿಃ ಸಂವೇದಸ್ಯಾರ್ಥಂ ಕಿಮಪಿ ನ ಪೃಷ್ಟ್ವಾ ಭುಜ್ಯತಾಂ</para>
  <para style="p">
    <verse number="26" style="v"/>ಯತಃ ಪೃಥಿವೀ ತನ್ಮಧ್ಯಸ್ಥಞ್ಚ ಸರ್ವ್ವಂ ಪರಮೇಶ್ವರಸ್ಯ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಅಪರಮ್ ಅವಿಶ್ವಾಸಿಲೋಕಾನಾಂ ಕೇನಚಿತ್ ನಿಮನ್ತ್ರಿತಾ ಯೂಯಂ ಯದಿ ತತ್ರ ಜಿಗಮಿಷಥ ತರ್ಹಿ ತೇನ ಯದ್ ಯದ್ ಉಪಸ್ಥಾಪ್ಯತೇ ತದ್ ಯುಷ್ಮಾಭಿಃ ಸಂವೇದಸ್ಯಾರ್ಥಂ ಕಿಮಪಿ ನ ಪೃಷ್ಟ್ವಾ ಭುಜ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="28" style="v"/>ಕಿನ್ತು ತತ್ರ ಯದಿ ಕಶ್ಚಿದ್ ಯುಷ್ಮಾನ್ ವದೇತ್ ಭಕ್ಷ್ಯಮೇತದ್ ದೇವತಾಯಾಃ ಪ್ರಸಾದ ಇತಿ ತರ್ಹಿ ತಸ್ಯ ಜ್ಞಾಪಯಿತುರನುರೋಧಾತ್ ಸಂವೇದಸ್ಯಾರ್ಥಞ್ಚ ತದ್ ಯುಷ್ಮಾಭಿ ರ್ನ ಭೋಕ್ತವ್ಯಂ| ಪೃಥಿವೀ ತನ್ಮಧ್ಯಸ್ಥಞ್ಚ ಸರ್ವ್ವಂ ಪರಮೇಶ್ವರಸ್ಯ,</para>
  <para style="p">
    <verse number="29" style="v"/>ಸತ್ಯಮೇತತ್, ಕಿನ್ತು ಮಯಾ ಯಃ ಸಂವೇದೋ ನಿರ್ದ್ದಿಶ್ಯತೇ ಸ ತವ ನಹಿ ಪರಸ್ಯೈವ|</para>
  <para style="p">
    <verse number="30" style="v"/>ಅನುಗ್ರಹಪಾತ್ರೇಣ ಮಯಾ ಧನ್ಯವಾದಂ ಕೃತ್ವಾ ಯದ್ ಭುಜ್ಯತೇ ತತ್ಕಾರಣಾದ್ ಅಹಂ ಕುತೋ ನಿನ್ದಿಷ್ಯೇ?</para>
  <para style="p">
    <verse number="31" style="v"/>ತಸ್ಮಾದ್ ಭೋಜನಂ ಪಾನಮ್ ಅನ್ಯದ್ವಾ ಕರ್ಮ್ಮ ಕುರ್ವ್ವದ್ಭಿ ರ್ಯುಷ್ಮಾಭಿಃ ಸರ್ವ್ವಮೇವೇಶ್ವರಸ್ಯ ಮಹಿಮ್ನಃ ಪ್ರಕಾಶಾರ್ಥಂ ಕ್ರಿಯತಾಂ|</para>
  <para style="p">
    <verse number="32" style="v"/>ಯಿಹೂದೀಯಾನಾಂ ಭಿನ್ನಜಾತೀಯಾನಾಮ್ ಈಶ್ವರಸ್ಯ ಸಮಾಜಸ್ಯ ವಾ ವಿಘ್ನಜನಕೈ ರ್ಯುಷ್ಮಾಭಿ ರ್ನ ಭವಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="33" style="v"/>ಅಹಮಪ್ಯಾತ್ಮಹಿತಮ್ ಅಚೇಷ್ಟಮಾನೋ ಬಹೂನಾಂ ಪರಿತ್ರಾಣಾರ್ಥಂ ತೇಷಾಂ ಹಿತಂ ಚೇಷ್ಟಮಾನಃ ಸರ್ವ್ವವಿಷಯೇ ಸರ್ವ್ವೇಷಾಂ ತುಷ್ಟಿಕರೋ ಭವಾಮೀತ್ಯನೇನಾಹಂ ಯದ್ವತ್ ಖ್ರೀಷ್ಟಸ್ಯಾನುಗಾಮೀ ತದ್ವದ್ ಯೂಯಂ ಮಮಾನುಗಾಮಿನೋ ಭವತ|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಯೂಯಂ ಸರ್ವ್ವಸ್ಮಿನ್ ಕಾರ್ಯ್ಯೇ ಮಾಂ ಸ್ಮರಥ ಮಯಾ ಚ ಯಾದೃಗುಪದಿಷ್ಟಾಸ್ತಾದೃಗಾಚರಥೈತತ್ಕಾರಣಾತ್ ಮಯಾ ಪ್ರಶಂಸನೀಯಾ ಆಧ್ಬೇ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತಥಾಪಿ ಮಮೈಷಾ ವಾಞ್ಛಾ ಯದ್ ಯೂಯಮಿದಮ್ ಅವಗತಾ ಭವಥ,</para>
  <para style="p">
    <verse number="3" style="v"/>ಏಕೈಕಸ್ಯ ಪುರುಷಸ್ಯೋತ್ತಮಾಙ್ಗಸ್ವರೂಪಃ ಖ್ರೀಷ್ಟಃ, ಯೋಷಿತಶ್ಚೋತ್ತಮಾಙ್ಗಸ್ವರೂಪಃ ಪುಮಾನ್, ಖ್ರೀಷ್ಟಸ್ಯ ಚೋತ್ತಮಾಙ್ಗಸ್ವರೂಪ ಈಶ್ವರಃ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಅಪರಮ್ ಆಚ್ಛಾದಿತೋತ್ತಮಾಙ್ಗೇನ ಯೇನ ಪುಂಸಾ ಪ್ರಾರ್ಥನಾ ಕ್ರಿಯತ ಈಶ್ವರೀಯವಾಣೀ ಕಥ್ಯತೇ ವಾ ತೇನ ಸ್ವೀಯೋತ್ತಮಾಙ್ಗಮ್ ಅವಜ್ಞಾಯತೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಅನಾಚ್ಛಾದಿತೋತ್ತಮಾಙ್ಗಯಾ ಯಯಾ ಯೋಷಿತಾ ಚ ಪ್ರಾರ್ಥನಾ ಕ್ರಿಯತ ಈಶ್ವರೀಯವಾಣೀ ಕಥ್ಯತೇ ವಾ ತಯಾಪಿ ಸ್ವೀಯೋತ್ತಮಾಙ್ಗಮ್ ಅವಜ್ಞಾಯತೇ ಯತಃ ಸಾ ಮುಣ್ಡಿತಶಿರಃಸದೃಶಾ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅನಾಚ್ಛಾದಿತಮಸ್ತಕಾ ಯಾ ಯೋಷಿತ್ ತಸ್ಯಾಃ ಶಿರಃ ಮುಣ್ಡನೀಯಮೇವ ಕಿನ್ತು ಯೋಷಿತಃ ಕೇಶಚ್ಛೇದನಂ ಶಿರೋಮುಣ್ಡನಂ ವಾ ಯದಿ ಲಜ್ಜಾಜನಕಂ ಭವೇತ್ ತರ್ಹಿ ತಯಾ ಸ್ವಶಿರ ಆಚ್ಛಾದ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಪುಮಾನ್ ಈಶ್ವರಸ್ಯ ಪ್ರತಿಮೂರ್ತ್ತಿಃ ಪ್ರತಿತೇಜಃಸ್ವರೂಪಶ್ಚ ತಸ್ಮಾತ್ ತೇನ ಶಿರೋ ನಾಚ್ಛಾದನೀಯಂ ಕಿನ್ತು ಸೀಮನ್ತಿನೀ ಪುಂಸಃ ಪ್ರತಿಬಿಮ್ಬಸ್ವರೂಪಾ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಯತೋ ಯೋಷಾತಃ ಪುಮಾನ್ ನೋದಪಾದಿ ಕಿನ್ತು ಪುಂಸೋ ಯೋಷಿದ್ ಉದಪಾದಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಅಧಿಕನ್ತು ಯೋಷಿತಃ ಕೃತೇ ಪುಂಸಃ ಸೃಷ್ಟಿ ರ್ನ ಬಭೂವ ಕಿನ್ತು ಪುಂಸಃ ಕೃತೇ ಯೋಷಿತಃ ಸೃಷ್ಟಿ ರ್ಬಭೂವ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಇತಿ ಹೇತೋ ರ್ದೂತಾನಾಮ್ ಆದರಾದ್ ಯೋಷಿತಾ ಶಿರಸ್ಯಧೀನತಾಸೂಚಕಮ್ ಆವರಣಂ ಧರ್ತ್ತವ್ಯಂ|</para>
  <para style="p">
    <verse number="11" style="v"/>ತಥಾಪಿ ಪ್ರಭೋ ರ್ವಿಧಿನಾ ಪುಮಾಂಸಂ ವಿನಾ ಯೋಷಿನ್ನ ಜಾಯತೇ ಯೋಷಿತಞ್ಚ ವಿನಾ ಪುಮಾನ್ ನ ಜಾಯತೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯತೋ ಯಥಾ ಪುಂಸೋ ಯೋಷಿದ್ ಉದಪಾದಿ ತಥಾ ಯೋಷಿತಃ ಪುಮಾನ್ ಜಾಯತೇ, ಸರ್ವ್ವವಸ್ತೂನಿ ಚೇಶ್ವರಾದ್ ಉತ್ಪದ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯುಷ್ಮಾಭಿರೇವೈತದ್ ವಿವಿಚ್ಯತಾಂ, ಅನಾವೃತಯಾ ಯೋಷಿತಾ ಪ್ರಾರ್ಥನಂ ಕಿಂ ಸುದೃಶ್ಯಂ ಭವೇತ್?</para>
  <para style="p">
    <verse number="14" style="v"/>ಪುರುಷಸ್ಯ ದೀರ್ಘಕೇಶತ್ವಂ ತಸ್ಯ ಲಜ್ಜಾಜನಕಂ, ಕಿನ್ತು ಯೋಷಿತೋ ದೀರ್ಘಕೇಶತ್ವಂ ತಸ್ಯಾ ಗೌರವಜನಕಂ</para>
  <para style="p">
    <verse number="15" style="v"/>ಯತ ಆಚ್ಛಾದನಾಯ ತಸ್ಯೈ ಕೇಶಾ ದತ್ತಾ ಇತಿ ಕಿಂ ಯುಷ್ಮಾಭಿಃ ಸ್ವಭಾವತೋ ನ ಶಿಕ್ಷ್ಯತೇ?</para>
  <para style="p">
    <verse number="16" style="v"/>ಅತ್ರ ಯದಿ ಕಶ್ಚಿದ್ ವಿವದಿತುಮ್ ಇಚ್ಛೇತ್ ತರ್ಹ್ಯಸ್ಮಾಕಮ್ ಈಶ್ವರೀಯಸಮಿತೀನಾಞ್ಚ ತಾದೃಶೀ ರೀತಿ ರ್ನ ವಿದ್ಯತೇ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಯುಷ್ಮಾಭಿ ರ್ನ ಭದ್ರಾಯ ಕಿನ್ತು ಕುತ್ಸಿತಾಯ ಸಮಾಗಮ್ಯತೇ ತಸ್ಮಾದ್ ಏತಾನಿ ಭಾಷಮಾಣೇನ ಮಯಾ ಯೂಯಂ ನ ಪ್ರಶಂಸನೀಯಾಃ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಪ್ರಥಮತಃ ಸಮಿತೌ ಸಮಾಗತಾನಾಂ ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ಭೇದಾಃ ಸನ್ತೀತಿ ವಾರ್ತ್ತಾ ಮಯಾ ಶ್ರೂಯತೇ ತನ್ಮಧ್ಯೇ ಕಿಞ್ಚಿತ್ ಸತ್ಯಂ ಮನ್ಯತೇ ಚ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಯತೋ ಹೇತೋ ರ್ಯುಷ್ಮನ್ಮಧ್ಯೇ ಯೇ ಪರೀಕ್ಷಿತಾಸ್ತೇ ಯತ್ ಪ್ರಕಾಶ್ಯನ್ತೇ ತದರ್ಥಂ ಭೇದೈ ರ್ಭವಿತವ್ಯಮೇವ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಏಕತ್ರ ಸಮಾಗತೈ ರ್ಯುಷ್ಮಾಭಿಃ ಪ್ರಭಾವಂ ಭೇाಜ್ಯಂ ಭುಜ್ಯತ ಇತಿ ನಹಿ;</para>
  <para style="p">
    <verse number="21" style="v"/>ಯತೋ ಭೋಜನಕಾಲೇ ಯುಷ್ಮಾಕಮೇಕೈಕೇನ ಸ್ವಕೀಯಂ ಭಕ್ಷ್ಯಂ ತೂರ್ಣಂ ಗ್ರಸ್ಯತೇ ತಸ್ಮಾದ್ ಏಕೋ ಜನೋ ಬುಭುಕ್ಷಿತಸ್ತಿಷ್ಠತಿ, ಅನ್ಯಶ್ಚ ಪರಿತೃಪ್ತೋ ಭವತಿ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಭೋಜನಪಾನಾರ್ಥಂ ಯುಷ್ಮಾಕಂ ಕಿಂ ವೇಶ್ಮಾನಿ ನ ಸನ್ತಿ? ಯುಷ್ಮಾಭಿ ರ್ವಾ ಕಿಮ್ ಈಶ್ವರಸ್ಯ ಸಮಿತಿಂ ತುಚ್ಛೀಕೃತ್ಯ ದೀನಾ ಲೋಕಾ ಅವಜ್ಞಾಯನ್ತೇ? ಇತ್ಯನೇನ ಮಯಾ ಕಿಂ ವಕ್ತವ್ಯಂ? ಯೂಯಂ ಕಿಂ ಮಯಾ ಪ್ರಶಂಸನೀಯಾಃ? ಏತಸ್ಮಿನ್ ಯೂಯಂ ನ ಪ್ರಶಂಸನೀಯಾಃ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಪ್ರಭುತೋ ಯ ಉಪದೇಶೋ ಮಯಾ ಲಬ್ಧೋ ಯುಷ್ಮಾಸು ಸಮರ್ಪಿತಶ್ಚ ಸ ಏಷಃ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಪರಕರಸಮರ್ಪಣಕ್ಷಪಾಯಾಂ ಪ್ರಭು ರ್ಯೀಶುಃ ಪೂಪಮಾದಾಯೇಶ್ವರಂ ಧನ್ಯಂ ವ್ಯಾಹೃತ್ಯ ತಂ ಭಙ್ಕ್ತ್ವಾ ಭಾಷಿತವಾನ್ ಯುಷ್ಮಾಭಿರೇತದ್ ಗೃಹ್ಯತಾಂ ಭುಜ್ಯತಾಞ್ಚ ತದ್ ಯುಷ್ಮತ್ಕೃತೇ ಭಗ್ನಂ ಮಮ ಶರೀರಂ; ಮಮ ಸ್ಮರಣಾರ್ಥಂ ಯುಷ್ಮಾಭಿರೇತತ್ ಕ್ರಿಯತಾಂ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಪುನಶ್ಚ ಭೇಜನಾತ್ ಪರಂ ತಥೈವ ಕಂಸಮ್ ಆದಾಯ ತೇನೋಕ್ತಂ ಕಂಸೋಽಯಂ ಮಮ ಶೋಣಿತೇನ ಸ್ಥಾಪಿತೋ ನೂತನನಿಯಮಃ; ಯತಿವಾರಂ ಯುಷ್ಮಾಭಿರೇತತ್ ಪೀಯತೇ ತತಿವಾರಂ ಮಮ ಸ್ಮರಣಾರ್ಥಂ ಪೀಯತಾಂ|</para>
  <para style="p">
    <verse number="26" style="v"/>ಯತಿವಾರಂ ಯುಷ್ಮಾಭಿರೇಷ ಪೂಪೋ ಭುಜ್ಯತೇ ಭಾಜನೇನಾನೇನ ಪೀಯತೇ ಚ ತತಿವಾರಂ ಪ್ರಭೋರಾಗಮನಂ ಯಾವತ್ ತಸ್ಯ ಮೃತ್ಯುಃ ಪ್ರಕಾಶ್ಯತೇ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಅಪರಞ್ಚ ಯಃ ಕಶ್ಚಿದ್ ಅಯೋಗ್ಯತ್ವೇನ ಪ್ರಭೋರಿಮಂ ಪೂಪಮ್ ಅಶ್ನಾತಿ ತಸ್ಯಾನೇನ ಭಾಜನೇನ ಪಿವತಿ ಚ ಸ ಪ್ರಭೋಃ ಕಾಯರುಧಿರಯೋ ರ್ದಣ್ಡದಾಯೀ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="28" style="v"/>ತಸ್ಮಾತ್ ಮಾನವೇನಾಗ್ರ ಆತ್ಮಾನ ಪರೀಕ್ಷ್ಯ ಪಶ್ಚಾದ್ ಏಷ ಪೂಪೋ ಭುಜ್ಯತಾಂ ಕಂಸೇನಾನೇನ ಚ ಪೀಯತಾಂ|</para>
  <para style="p">
    <verse number="29" style="v"/>ಯೇನ ಚಾನರ್ಹತ್ವೇನ ಭುಜ್ಯತೇ ಪೀಯತೇ ಚ ಪ್ರಭೋಃ ಕಾಯಮ್ ಅವಿಮೃಶತಾ ತೇನ ದಣ್ಡಪ್ರಾಪ್ತಯೇ ಭುಜ್ಯತೇ ಪೀಯತೇ ಚ|</para>
  <para style="p">
    <verse number="30" style="v"/>ಏತತ್ಕಾರಣಾದ್ ಯುಷ್ಮಾಕಂ ಭೂರಿಶೋ ಲೋಕಾ ದುರ್ಬ್ಬಲಾ ರೋಗಿಣಶ್ಚ ಸನ್ತಿ ಬಹವಶ್ಚ ಮಹಾನಿದ್ರಾಂ ಗತಾಃ|</para>
  <para style="p">
    <verse number="31" style="v"/>ಅಸ್ಮಾಭಿ ರ್ಯದ್ಯಾತ್ಮವಿಚಾರೋಽಕಾರಿಷ್ಯತ ತರ್ಹಿ ದಣ್ಡೋ ನಾಲಪ್ಸ್ಯತ;</para>
  <para style="p">
    <verse number="32" style="v"/>ಕಿನ್ತು ಯದಾಸ್ಮಾಕಂ ವಿಚಾರೋ ಭವತಿ ತದಾ ವಯಂ ಜಗತೋ ಜನೈಃ ಸಮಂ ಯದ್ ದಣ್ಡಂ ನ ಲಭಾಮಹೇ ತದರ್ಥಂ ಪ್ರಭುನಾ ಶಾಸ್ತಿಂ ಭುಂಜ್ಮಹೇ|</para>
  <para style="p">
    <verse number="33" style="v"/>ಹೇ ಮಮ ಭ್ರಾತರಃ, ಭೋಜನಾರ್ಥಂ ಮಿಲಿತಾನಾಂ ಯುಷ್ಮಾಕಮ್ ಏಕೇನೇತರೋಽನುಗೃಹ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="34" style="v"/>ಯಶ್ಚ ಬುಭುಕ್ಷಿತಃ ಸ ಸ್ವಗೃಹೇ ಭುಙ್ಕ್ತಾಂ| ದಣ್ಡಪ್ರಾಪ್ತಯೇ ಯುಷ್ಮಾಭಿ ರ್ನ ಸಮಾಗಮ್ಯತಾಂ| ಏತದ್ಭಿನ್ನಂ ಯದ್ ಆದೇಷ್ಟವ್ಯಂ ತದ್ ಯುಷ್ಮತ್ಸಮೀಪಾಗಮನಕಾಲೇ ಮಯಾದೇಕ್ಷ್ಯತೇ|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಯೂಯಂ ಯದ್ ಆತ್ಮಿಕಾನ್ ದಾಯಾನ್ ಅನವಗತಾಸ್ತಿಷ್ಠಥ ತದಹಂ ನಾಭಿಲಷಾಮಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಪೂರ್ವ್ವಂ ಭಿನ್ನಜಾತೀಯಾ ಯೂಯಂ ಯದ್ವದ್ ವಿನೀತಾಸ್ತದ್ವದ್ ಅವಾಕ್ಪ್ರತಿಮಾನಾಮ್ ಅನುಗಾಮಿನ ಆಧ್ಬಮ್ ಇತಿ ಜಾನೀಥ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಇತಿ ಹೇತೋರಹಂ ಯುಷ್ಮಭ್ಯಂ ನಿವೇದಯಾಮಿ, ಈಶ್ವರಸ್ಯಾತ್ಮನಾ ಭಾಷಮಾಣಃ ಕೋಽಪಿ ಯೀಶುಂ ಶಪ್ತ ಇತಿ ನ ವ್ಯಾಹರತಿ, ಪುನಶ್ಚ ಪವಿತ್ರೇಣಾತ್ಮನಾ ವಿನೀತಂ ವಿನಾನ್ಯಃ ಕೋಽಪಿ ಯೀಶುಂ ಪ್ರಭುರಿತಿ ವ್ಯಾಹರ್ತ್ತುಂ ನ ಶಕ್ನೋತಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ದಾಯಾ ಬಹುವಿಧಾಃ ಕಿನ್ತ್ವೇಕ ಆತ್ಮಾ</para>
  <para style="p">
    <verse number="5" style="v"/>ಪರಿಚರ್ಯ್ಯಾಶ್ಚ ಬಹುವಿಧಾಃ ಕಿನ್ತ್ವೇಕಃ ಪ್ರಭುಃ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಸಾಧನಾನಿ ಬಹುವಿಧಾನಿ ಕಿನ್ತು ಸರ್ವ್ವೇಷು ಸರ್ವ್ವಸಾಧಕ ಈಶ್ವರ ಏಕಃ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಏಕೈಕಸ್ಮೈ ತಸ್ಯಾತ್ಮನೋ ದರ್ಶನಂ ಪರಹಿತಾರ್ಥಂ ದೀಯತೇ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಏಕಸ್ಮೈ ತೇನಾತ್ಮನಾ ಜ್ಞಾನವಾಕ್ಯಂ ದೀಯತೇ, ಅನ್ಯಸ್ಮೈ ತೇನೈವಾತ್ಮನಾದಿಷ್ಟಂ ವಿದ್ಯಾವಾಕ್ಯಮ್,</para>
  <para style="p">
    <verse number="9" style="v"/>ಅನ್ಯಸ್ಮೈ ತೇನೈವಾತ್ಮನಾ ವಿಶ್ವಾಸಃ, ಅನ್ಯಸ್ಮೈ ತೇನೈವಾತ್ಮನಾ ಸ್ವಾಸ್ಥ್ಯದಾನಶಕ್ತಿಃ,</para>
  <para style="p">
    <verse number="10" style="v"/>ಅನ್ಯಸ್ಮೈ ದುಃಸಾಧ್ಯಸಾಧನಶಕ್ತಿರನ್ಯಸ್ಮೈ ಚೇಶ್ವರೀಯಾದೇಶಃ, ಅನ್ಯಸ್ಮೈ ಚಾತಿಮಾನುಷಿಕಸ್ಯಾದೇಶಸ್ಯ ವಿಚಾರಸಾಮರ್ಥ್ಯಮ್, ಅನ್ಯಸ್ಮೈ ಪರಭಾಷಾಭಾಷಣಶಕ್ತಿರನ್ಯಸ್ಮೈ ಚ ಭಾಷಾರ್ಥಭಾಷಣಸಾಮರ್ಯಂ ದೀಯತೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಏಕೇನಾದ್ವಿತೀಯೇನಾತ್ಮನಾ ಯಥಾಭಿಲಾಷಮ್ ಏಕೈಕಸ್ಮೈ ಜನಾಯೈಕೈಕಂ ದಾನಂ ವಿತರತಾ ತಾನಿ ಸರ್ವ್ವಾಣಿ ಸಾಧ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ದೇಹ ಏಕಃ ಸನ್ನಪಿ ಯದ್ವದ್ ಬಹ್ವಙ್ಗಯುಕ್ತೋ ಭವತಿ, ತಸ್ಯೈಕಸ್ಯ ವಪುಷೋ ಽಙ್ಗಾನಾಂ ಬಹುತ್ವೇನ ಯದ್ವದ್ ಏಕಂ ವಪು ರ್ಭವತಿ, ತದ್ವತ್ ಖ್ರೀಷ್ಟಃ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯತೋ ಹೇತೋ ರ್ಯಿಹೂದಿಭಿನ್ನಜಾತೀಯದಾಸಸ್ವತನ್ತ್ರಾ ವಯಂ ಸರ್ವ್ವೇ ಮಜ್ಜನೇನೈಕೇನಾತ್ಮನೈಕದೇಹೀಕೃತಾಃ ಸರ್ವ್ವೇ ಚೈಕಾತ್ಮಭುಕ್ತಾ ಅಭವಾಮ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಏಕೇನಾಙ್ಗೇನ ವಪು ರ್ನ ಭವತಿ ಕಿನ್ತು ಬಹುಭಿಃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತತ್ರ ಚರಣಂ ಯದಿ ವದೇತ್ ನಾಹಂ ಹಸ್ತಸ್ತಸ್ಮಾತ್ ಶರೀರಸ್ಯ ಭಾಗೋ ನಾಸ್ಮೀತಿ ತರ್ಹ್ಯನೇನ ಶರೀರಾತ್ ತಸ್ಯ ವಿಯೋಗೋ ನ ಭವತಿ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಶ್ರೋತ್ರಂ ವಾ ಯದಿ ವದೇತ್ ನಾಹಂ ನಯನಂ ತಸ್ಮಾತ್ ಶರೀರಸ್ಯಾಂಶೋ ನಾಸ್ಮೀತಿ ತರ್ಹ್ಯನೇನ ಶರೀರಾತ್ ತಸ್ಯ ವಿಯೋಗೋ ನ ಭವತಿ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಕೃತ್ಸ್ನಂ ಶರೀರಂ ಯದಿ ದರ್ಶನೇನ್ದ್ರಿಯಂ ಭವೇತ್ ತರ್ಹಿ ಶ್ರವಣೇನ್ದ್ರಿಯಂ ಕುತ್ರ ಸ್ಥಾಸ್ಯತಿ? ತತ್ ಕೃತ್ಸ್ನಂ ಯದಿ ವಾ ಶ್ರವಣೇನ್ದ್ರಿಯಂ ಭವೇತ್ ತರ್ಹಿ ಘ್ರಣೇನ್ದ್ರಿಯಂ ಕುತ್ರ ಸ್ಥಾಸ್ಯತಿ?</para>
  <para style="p">
    <verse number="18" style="v"/>ಕಿನ್ತ್ವಿದಾನೀಮ್ ಈಶ್ವರೇಣ ಯಥಾಭಿಲಷಿತಂ ತಥೈವಾಙ್ಗಪ್ರತ್ಯಙ್ಗಾನಾಮ್ ಏಕೈಕಂ ಶರೀರೇ ಸ್ಥಾಪಿತಂ|</para>
  <para style="p">
    <verse number="19" style="v"/>ತತ್ ಕೃತ್ಸ್ನಂ ಯದ್ಯೇಕಾಙ್ಗರೂಪಿ ಭವೇತ್ ತರ್ಹಿ ಶರೀರೇ ಕುತ್ರ ಸ್ಥಾಸ್ಯತಿ?</para>
  <para style="p">
    <verse number="20" style="v"/>ತಸ್ಮಾದ್ ಅಙ್ಗಾನಿ ಬಹೂನಿ ಸನ್ತಿ ಶರೀರಂ ತ್ವೇಕಮೇವ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಅತಏವ ತ್ವಯಾ ಮಮ ಪ್ರಯೋಜನಂ ನಾಸ್ತೀತಿ ವಾಚಂ ಪಾಣಿಂ ವದಿತುಂ ನಯನಂ ನ ಶಕ್ನೋತಿ, ತಥಾ ಯುವಾಭ್ಯಾಂ ಮಮ ಪ್ರಯೋಜನಂ ನಾಸ್ತೀತಿ ಮೂರ್ದ್ಧಾ ಚರಣೌ ವದಿತುಂ ನ ಶಕ್ನೋತಿಃ;</para>
  <para style="p">
    <verse number="22" style="v"/>ವಸ್ತುತಸ್ತು ವಿಗ್ರಹಸ್ಯ ಯಾನ್ಯಙ್ಗಾನ್ಯಸ್ಮಾಭಿ ರ್ದುರ್ಬ್ಬಲಾನಿ ಬುಧ್ಯನ್ತೇ ತಾನ್ಯೇವ ಸಪ್ರಯೋಜನಾನಿ ಸನ್ತಿ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಯಾನಿ ಚ ಶರೀರಮಧ್ಯೇಽವಮನ್ಯಾನಿ ಬುಧ್ಯತೇ ತಾನ್ಯಸ್ಮಾಭಿರಧಿಕಂ ಶೋಭ್ಯನ್ತೇ| ಯಾನಿ ಚ ಕುದೃಶ್ಯಾನಿ ತಾನಿ ಸುದೃಶ್ಯತರಾಣಿ ಕ್ರಿಯನ್ತೇ</para>
  <para style="p">
    <verse number="24" style="v"/>ಕಿನ್ತು ಯಾನಿ ಸ್ವಯಂ ಸುದೃಶ್ಯಾನಿ ತೇಷಾಂ ಶೋಭನಮ್ ನಿಷ್ಪ್ರಯೋಜನಂ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಶರೀರಮಧ್ಯೇ ಯದ್ ಭೇದೋ ನ ಭವೇತ್ ಕಿನ್ತು ಸರ್ವ್ವಾಣ್ಯಙ್ಗಾನಿ ಯದ್ ಐಕ್ಯಭಾವೇನ ಸರ್ವ್ವೇಷಾಂ ಹಿತಂ ಚಿನ್ತಯನ್ತಿ ತದರ್ಥಮ್ ಈಶ್ವರೇಣಾಪ್ರಧಾನಮ್ ಆದರಣೀಯಂ ಕೃತ್ವಾ ಶರೀರಂ ವಿರಚಿತಂ|</para>
  <para style="p">
    <verse number="26" style="v"/>ತಸ್ಮಾದ್ ಏಕಸ್ಯಾಙ್ಗಸ್ಯ ಪೀಡಾಯಾಂ ಜಾತಾಯಾಂ ಸರ್ವ್ವಾಣ್ಯಙ್ಗಾನಿ ತೇನ ಸಹ ಪೀಡ್ಯನ್ತೇ, ಏಕಸ್ಯ ಸಮಾದರೇ ಜಾತೇ ಚ ಸರ್ವ್ವಾಣಿ ತೇನ ಸಹ ಸಂಹೃಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಯೂಯಞ್ಚ ಖ್ರೀಷ್ಟಸ್ಯ ಶರೀರಂ, ಯುಷ್ಮಾಕಮ್ ಏಕೈಕಶ್ಚ ತಸ್ಯೈಕೈಕಮ್ ಅಙ್ಗಂ|</para>
  <para style="p">
    <verse number="28" style="v"/>ಕೇಚಿತ್ ಕೇಚಿತ್ ಸಮಿತಾವೀಶ್ವರೇಣ ಪ್ರಥಮತಃ ಪ್ರೇರಿತಾ ದ್ವಿತೀಯತ ಈಶ್ವರೀಯಾದೇಶವಕ್ತಾರಸ್ತೃತೀಯತ ಉಪದೇಷ್ಟಾರೋ ನಿಯುಕ್ತಾಃ, ತತಃ ಪರಂ ಕೇಭ್ಯೋಽಪಿ ಚಿತ್ರಕಾರ್ಯ್ಯಸಾಧನಸಾಮರ್ಥ್ಯಮ್ ಅನಾಮಯಕರಣಶಕ್ತಿರುಪಕೃತೌ ಲೋಕಶಾಸನೇ ವಾ ನೈಪುಣ್ಯಂ ನಾನಾಭಾಷಾಭಾಷಣಸಾಮರ್ಥ್ಯಂ ವಾ ತೇನ ವ್ಯತಾರಿ|</para>
  <para style="p">
    <verse number="29" style="v"/>ಸರ್ವ್ವೇ ಕಿಂ ಪ್ರೇರಿತಾಃ? ಸರ್ವ್ವೇ ಕಿಮ್ ಈಶ್ವರೀಯಾದೇಶವಕ್ತಾರಃ? ಸರ್ವ್ವೇ ಕಿಮ್ ಉಪದೇಷ್ಟಾರಃ? ಸರ್ವ್ವೇ ಕಿಂ ಚಿತ್ರಕಾರ್ಯ್ಯಸಾಧಕಾಃ?</para>
  <para style="p">
    <verse number="30" style="v"/>ಸರ್ವ್ವೇ ಕಿಮ್ ಅನಾಮಯಕರಣಶಕ್ತಿಯುಕ್ತಾಃ? ಸರ್ವ್ವೇ ಕಿಂ ಪರಭಾಷಾವಾದಿನಃ? ಸರ್ವ್ವೇ ವಾ ಕಿಂ ಪರಭಾಷಾರ್ಥಪ್ರಕಾಶಕಾಃ?</para>
  <para style="p">
    <verse number="31" style="v"/>ಯೂಯಂ ಶ್ರೇಷ್ಠದಾಯಾನ್ ಲಬ್ಧುಂ ಯತಧ್ವಂ| ಅನೇನ ಯೂಯಂ ಮಯಾ ಸರ್ವ್ವೋತ್ತಮಮಾರ್ಗಂ ದರ್ಶಯಿತವ್ಯಾಃ|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಮರ್ತ್ಯಸ್ವರ್ಗೀಯಾಣಾಂ ಭಾಷಾ ಭಾಷಮಾಣೋಽಹಂ ಯದಿ ಪ್ರೇಮಹೀನೋ ಭವೇಯಂ ತರ್ಹಿ ವಾದಕತಾಲಸ್ವರೂಪೋ ನಿನಾದಕಾರಿಭೇರೀಸ್ವರೂಪಶ್ಚ ಭವಾಮಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಅಪರಞ್ಚ ಯದ್ಯಹಮ್ ಈಶ್ವರೀಯಾದೇಶಾಢ್ಯಃ ಸ್ಯಾಂ ಸರ್ವ್ವಾಣಿ ಗುಪ್ತವಾಕ್ಯಾನಿ ಸರ್ವ್ವವಿದ್ಯಾಞ್ಚ ಜಾನೀಯಾಂ ಪೂರ್ಣವಿಶ್ವಾಸಃ ಸನ್ ಶೈಲಾನ್ ಸ್ಥಾನಾನ್ತರೀಕರ್ತ್ತುಂ ಶಕ್ನುಯಾಞ್ಚ ಕಿನ್ತು ಯದಿ ಪ್ರೇಮಹೀನೋ ಭವೇಯಂ ತರ್ಹ್ಯಗಣನೀಯ ಏವ ಭವಾಮಿ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅಪರಂ ಯದ್ಯಹಮ್ ಅನ್ನದಾನೇನ ಸರ್ವ್ವಸ್ವಂ ತ್ಯಜೇಯಂ ದಾಹನಾಯ ಸ್ವಶರೀರಂ ಸಮರ್ಪಯೇಯಞ್ಚ ಕಿನ್ತು ಯದಿ ಪ್ರೇಮಹೀನೋ ಭವೇಯಂ ತರ್ಹಿ ತತ್ಸರ್ವ್ವಂ ಮದರ್ಥಂ ನಿಷ್ಫಲಂ ಭವತಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಪ್ರೇಮ ಚಿರಸಹಿಷ್ಣು ಹಿತೈಷಿ ಚ, ಪ್ರೇಮ ನಿರ್ದ್ವೇಷಮ್ ಅಶಠಂ ನಿರ್ಗರ್ವ್ವಞ್ಚ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಅಪರಂ ತತ್ ಕುತ್ಸಿತಂ ನಾಚರತಿ, ಆತ್ಮಚೇಷ್ಟಾಂ ನ ಕುರುತೇ ಸಹಸಾ ನ ಕ್ರುಧ್ಯತಿ ಪರಾನಿಷ್ಟಂ ನ ಚಿನ್ತಯತಿ,</para>
  <para style="p">
    <verse number="6" style="v"/>ಅಧರ್ಮ್ಮೇ ನ ತುಷ್ಯತಿ ಸತ್ಯ ಏವ ಸನ್ತುಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="7" style="v"/>ತತ್ ಸರ್ವ್ವಂ ತಿತಿಕ್ಷತೇ ಸರ್ವ್ವತ್ರ ವಿಶ್ವಸಿತಿ ಸರ್ವ್ವತ್ರ ಭದ್ರಂ ಪ್ರತೀಕ್ಷತೇ ಸರ್ವ್ವಂ ಸಹತೇ ಚ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಪ್ರೇಮ್ನೋ ಲೋಪಃ ಕದಾಪಿ ನ ಭವಿಷ್ಯತಿ, ಈಶ್ವರೀಯಾದೇಶಕಥನಂ ಲೋಪ್ಸ್ಯತೇ ಪರಭಾಷಾಭಾಷಣಂ ನಿವರ್ತ್ತಿಷ್ಯತೇ ಜ್ಞಾನಮಪಿ ಲೋಪಂ ಯಾಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಯತೋಽಸ್ಮಾಕಂ ಜ್ಞಾನಂ ಖಣ್ಡಮಾತ್ರಮ್ ಈಶ್ವರೀಯಾದೇಶಕಥನಮಪಿ ಖಣ್ಡಮಾತ್ರಂ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಕಿನ್ತ್ವಸ್ಮಾಸು ಸಿದ್ಧತಾಂ ಗತೇಷು ತಾನಿ ಖಣ್ಡಮಾತ್ರಾಣಿ ಲೋಪಂ ಯಾಸ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಬಾಲ್ಯಕಾಲೇಽಹಂ ಬಾಲ ಇವಾಭಾಷೇ ಬಾಲ ಇವಾಚಿನ್ತಯಞ್ಚ ಕಿನ್ತು ಯೌವನೇ ಜಾತೇ ತತ್ಸರ್ವ್ವಂ ಬಾಲ್ಯಾಚರಣಂ ಪರಿತ್ಯಕ್ತವಾನ್|</para>
  <para style="p">
    <verse number="12" style="v"/>ಇದಾನೀಮ್ ಅಭ್ರಮಧ್ಯೇನಾಸ್ಪಷ್ಟಂ ದರ್ಶನಮ್ ಅಸ್ಮಾಭಿ ರ್ಲಭ್ಯತೇ ಕಿನ್ತು ತದಾ ಸಾಕ್ಷಾತ್ ದರ್ಶನಂ ಲಪ್ಸ್ಯತೇ| ಅಧುನಾ ಮಮ ಜ್ಞಾನಮ್ ಅಲ್ಪಿಷ್ಠಂ ಕಿನ್ತು ತದಾಹಂ ಯಥಾವಗಮ್ಯಸ್ತಥೈವಾವಗತೋ ಭವಿಷ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಇದಾನೀಂ ಪ್ರತ್ಯಯಃ ಪ್ರತ್ಯಾಶಾ ಪ್ರೇಮ ಚ ತ್ರೀಣ್ಯೇತಾನಿ ತಿಷ್ಠನ್ತಿ ತೇಷಾಂ ಮಧ್ಯೇ ಚ ಪ್ರೇಮ ಶ್ರೇಷ್ಠಂ|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಯೂಯಂ ಪ್ರೇಮಾಚರಣೇ ಪ್ರಯತಧ್ವಮ್ ಆತ್ಮಿಕಾನ್ ದಾಯಾನಪಿ ವಿಶೇಷತ ಈಶ್ವರೀಯಾದೇಶಕಥನಸಾಮರ್ಥ್ಯಂ ಪ್ರಾಪ್ತುಂ ಚೇಷ್ಟಧ್ವಂ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯೋ ಜನಃ ಪರಭಾಷಾಂ ಭಾಷತೇ ಸ ಮಾನುಷಾನ್ ನ ಸಮ್ಭಾಷತೇ ಕಿನ್ತ್ವೀಶ್ವರಮೇವ ಯತಃ ಕೇನಾಪಿ ಕಿಮಪಿ ನ ಬುಧ್ಯತೇ ಸ ಚಾತ್ಮನಾ ನಿಗೂಢವಾಕ್ಯಾನಿ ಕಥಯತಿ;</para>
  <para style="p">
    <verse number="3" style="v"/>ಕಿನ್ತು ಯೋ ಜನ ಈಶ್ವರೀಯಾದೇಶಂ ಕಥಯತಿ ಸ ಪರೇಷಾಂ ನಿಷ್ಠಾಯೈ ಹಿತೋಪದೇಶಾಯ ಸಾನ್ತ್ವನಾಯೈ ಚ ಭಾಷತೇ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಪರಭಾಷಾವಾದ್ಯಾತ್ಮನ ಏವ ನಿಷ್ಠಾಂ ಜನಯತಿ ಕಿನ್ತ್ವೀಶ್ವರೀಯಾದೇಶವಾದೀ ಸಮಿತೇ ರ್ನಿಷ್ಠಾಂ ಜನಯತಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯುಷ್ಮಾಕಂ ಸರ್ವ್ವೇಷಾಂ ಪರಭಾಷಾಭಾಷಣಮ್ ಇಚ್ಛಾಮ್ಯಹಂ ಕಿನ್ತ್ವೀಶ್ವರೀಯಾದೇಶಕಥನಮ್ ಅಧಿಕಮಪೀಚ್ಛಾಮಿ| ಯತಃ ಸಮಿತೇ ರ್ನಿಷ್ಠಾಯೈ ಯೇನ ಸ್ವವಾಕ್ಯಾನಾಮ್ ಅರ್ಥೋ ನ ಕ್ರಿಯತೇ ತಸ್ಮಾತ್ ಪರಭಾಷಾವಾದಿತ ಈಶ್ವರೀಯಾದೇಶವಾದೀ ಶ್ರೇಯಾನ್|</para>
  <para style="p">
    <verse number="6" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಇದಾನೀಂ ಮಯಾ ಯದಿ ಯುಷ್ಮತ್ಸಮೀಪಂ ಗಮ್ಯತೇ ತರ್ಹೀಶ್ವರೀಯದರ್ಶನಸ್ಯ ಜ್ಞಾನಸ್ಯ ವೇಶ್ವರೀಯಾದೇಶಸ್ಯ ವಾ ಶಿಕ್ಷಾಯಾ ವಾ ವಾಕ್ಯಾನಿ ನ ಭಾಷಿತ್ವಾ ಪರಭಾಷಾಂ ಭಾಷಮಾಣೇನ ಮಯಾ ಯೂಯಂ ಕಿಮುಪಕಾರಿಷ್ಯಧ್ವೇ?</para>
  <para style="p">
    <verse number="7" style="v"/>ಅಪರಂ ವಂಶೀವಲ್ಲಕ್ಯಾದಿಷು ನಿಷ್ಪ್ರಾಣಿಷು ವಾದ್ಯಯನ್ತ್ರೇಷು ವಾದಿತೇಷು ಯದಿ ಕ್ಕಣಾ ನ ವಿಶಿಷ್ಯನ್ತೇ ತರ್ಹಿ ಕಿಂ ವಾದ್ಯಂ ಕಿಂ ವಾ ಗಾನಂ ಭವತಿ ತತ್ ಕೇನ ಬೋದ್ಧುಂ ಶಕ್ಯತೇ?</para>
  <para style="p">
    <verse number="8" style="v"/>ಅಪರಂ ರಣತೂರ್ಯ್ಯಾ ನಿಸ್ವಣೋ ಯದ್ಯವ್ಯಕ್ತೋ ಭವೇತ್ ತರ್ಹಿ ಯುದ್ಧಾಯ ಕಃ ಸಜ್ಜಿಷ್ಯತೇ?</para>
  <para style="p">
    <verse number="9" style="v"/>ತದ್ವತ್ ಜಿಹ್ವಾಭಿ ರ್ಯದಿ ಸುಗಮ್ಯಾ ವಾಕ್ ಯುಷ್ಮಾಭಿ ರ್ನ ಗದ್ಯೇತ ತರ್ಹಿ ಯದ್ ಗದ್ಯತೇ ತತ್ ಕೇನ ಭೋತ್ಸ್ಯತೇ? ವಸ್ತುತೋ ಯೂಯಂ ದಿಗಾಲಾಪಿನ ಇವ ಭವಿಷ್ಯಥ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಜಗತಿ ಕತಿಪ್ರಕಾರಾ ಉಕ್ತಯೋ ವಿದ್ಯನ್ತೇ? ತಾಸಾಮೇಕಾಪಿ ನಿರರ್ಥಿಕಾ ನಹಿ;</para>
  <para style="p">
    <verse number="11" style="v"/>ಕಿನ್ತೂಕ್ತೇರರ್ಥೋ ಯದಿ ಮಯಾ ನ ಬುಧ್ಯತೇ ತರ್ಹ್ಯಹಂ ವಕ್ತ್ರಾ ಮ್ಲೇಚ್ಛ ಇವ ಮಂಸ್ಯೇ ವಕ್ತಾಪಿ ಮಯಾ ಮ್ಲೇಚ್ಛ ಇವ ಮಂಸ್ಯತೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ತಸ್ಮಾದ್ ಆತ್ಮಿಕದಾಯಲಿಪ್ಸವೋ ಯೂಯಂ ಸಮಿತೇ ರ್ನಿಷ್ಠಾರ್ಥಂ ಪ್ರಾಪ್ತಬಹುವರಾ ಭವಿತುಂ ಯತಧ್ವಂ,</para>
  <para style="p">
    <verse number="13" style="v"/>ಅತಏವ ಪರಭಾಷಾವಾದೀ ಯದ್ ಅರ್ಥಕರೋಽಪಿ ಭವೇತ್ ತತ್ ಪ್ರಾರ್ಥಯತಾಂ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯದ್ಯಹಂ ಪರಭಾಷಯಾ ಪ್ರರ್ಥನಾಂ ಕುರ್ಯ್ಯಾಂ ತರ್ಹಿ ಮದೀಯ ಆತ್ಮಾ ಪ್ರಾರ್ಥಯತೇ, ಕಿನ್ತು ಮಮ ಬುದ್ಧಿ ರ್ನಿಷ್ಫಲಾ ತಿಷ್ಠತಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಇತ್ಯನೇನ ಕಿಂ ಕರಣೀಯಂ? ಅಹಮ್ ಆತ್ಮನಾ ಪ್ರಾರ್ಥಯಿಷ್ಯೇ ಬುದ್ಧ್ಯಾಪಿ ಪ್ರಾರ್ಥಯಿಷ್ಯೇ; ಅಪರಂ ಆತ್ಮನಾ ಗಾಸ್ಯಾಮಿ ಬುದ್ಧ್ಯಾಪಿ ಗಾಸ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="16" style="v"/>ತ್ವಂ ಯದಾತ್ಮನಾ ಧನ್ಯವಾದಂ ಕರೋಷಿ ತದಾ ಯದ್ ವದಸಿ ತದ್ ಯದಿ ಶಿಷ್ಯೇನೇವೋಪಸ್ಥಿತೇನ ಜನೇನ ನ ಬುದ್ಧ್ಯತೇ ತರ್ಹಿ ತವ ಧನ್ಯವಾದಸ್ಯಾನ್ತೇ ತಥಾಸ್ತ್ವಿತಿ ತೇನ ವಕ್ತಂ ಕಥಂ ಶಕ್ಯತೇ?</para>
  <para style="p">
    <verse number="17" style="v"/>ತ್ವಂ ಸಮ್ಯಗ್ ಈಶ್ವರಂ ಧನ್ಯಂ ವದಸೀತಿ ಸತ್ಯಂ ತಥಾಪಿ ತತ್ರ ಪರಸ್ಯ ನಿಷ್ಠಾ ನ ಭವತಿ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಯುಷ್ಮಾಕಂ ಸರ್ವ್ವೇಭ್ಯೋಽಹಂ ಪರಭಾಷಾಭಾಷಣೇ ಸಮರ್ಥೋಽಸ್ಮೀತಿ ಕಾರಣಾದ್ ಈಶ್ವರಂ ಧನ್ಯಂ ವದಾಮಿ;</para>
  <para style="p">
    <verse number="19" style="v"/>ತಥಾಪಿ ಸಮಿತೌ ಪರೋಪದೇಶಾರ್ಥಂ ಮಯಾ ಕಥಿತಾನಿ ಪಞ್ಚ ವಾಕ್ಯಾನಿ ವರಂ ನ ಚ ಲಕ್ಷಂ ಪರಭಾಷೀಯಾನಿ ವಾಕ್ಯಾನಿ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಹೇ ಭ್ರಾತರಃ,ಯೂಯಂ ಬುದ್ಧ್ಯಾ ಬಾಲಕಾಇವ ಮಾ ಭೂತ ಪರನ್ತು ದುಷ್ಟತಯಾ ಶಿಶವಇವ ಭೂತ್ವಾ ಬುದ್ಧ್ಯಾ ಸಿದ್ಧಾ ಭವತ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಶಾಸ್ತ್ರ ಇದಂ ಲಿಖಿತಮಾಸ್ತೇ, ಯಥಾ, ಇತ್ಯವೋಚತ್ ಪರೇಶೋಽಹಮ್ ಆಭಾಷಿಷ್ಯ ಇಮಾನ್ ಜನಾನ್| ಭಾಷಾಭಿಃ ಪರಕೀಯಾಭಿ ರ್ವಕ್ತ್ರೈಶ್ಚ ಪರದೇಶಿಭಿಃ| ತಥಾ ಮಯಾ ಕೃತೇಽಪೀಮೇ ನ ಗ್ರಹೀಷ್ಯನ್ತಿ ಮದ್ವಚಃ||</para>
  <para style="p">
    <verse number="22" style="v"/>ಅತಏವ ತತ್ ಪರಭಾಷಾಭಾಷಣಂ ಅವಿಶ್ಚಾಸಿನಃ ಪ್ರತಿ ಚಿಹ್ನರೂಪಂ ಭವತಿ ನ ಚ ವಿಶ್ವಾಸಿನಃ ಪ್ರತಿ; ಕಿನ್ತ್ವೀಶ್ವರೀಯಾದೇಶಕಥನಂ ನಾವಿಶ್ವಾಸಿನಃ ಪ್ರತಿ ತದ್ ವಿಶ್ವಾಸಿನಃ ಪ್ರತ್ಯೇವ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಸಮಿತಿಭುಕ್ತೇಷು ಸರ್ವ್ವೇಷು ಏಕಸ್ಮಿನ್ ಸ್ಥಾನೇ ಮಿಲಿತ್ವಾ ಪರಭಾಷಾಂ ಭಾಷಮಾಣೇಷು ಯದಿ ಜ್ಞಾನಾಕಾಙ್ಕ್ಷಿಣೋಽವಿಶ್ವಾಸಿನೋ ವಾ ತತ್ರಾಗಚ್ಛೇಯುಸ್ತರ್ಹಿ ಯುಷ್ಮಾನ್ ಉನ್ಮತ್ತಾನ್ ಕಿಂ ನ ವದಿಷ್ಯನ್ತಿ?</para>
  <para style="p">
    <verse number="24" style="v"/>ಕಿನ್ತು ಸರ್ವ್ವೇಷ್ವೀಶ್ವರೀಯಾದೇಶಂ ಪ್ರಕಾಶಯತ್ಸು ಯದ್ಯವಿಶ್ವಾಸೀ ಜ್ಞಾನಾಕಾಙ್ಕ್ಷೀ ವಾ ಕಶ್ಚಿತ್ ತತ್ರಾಗಚ್ಛತಿ ತರ್ಹಿ ಸರ್ವ್ವೈರೇವ ತಸ್ಯ ಪಾಪಜ್ಞಾನಂ ಪರೀಕ್ಷಾ ಚ ಜಾಯತೇ,</para>
  <para style="p">
    <verse number="25" style="v"/>ತತಸ್ತಸ್ಯಾನ್ತಃಕರಣಸ್ಯ ಗುಪ್ತಕಲ್ಪನಾಸು ವ್ಯಕ್ತೀಭೂತಾಸು ಸೋಽಧೋಮುಖಃ ಪತನ್ ಈಶ್ವರಮಾರಾಧ್ಯ ಯುಷ್ಮನ್ಮಧ್ಯ ಈಶ್ವರೋ ವಿದ್ಯತೇ ಇತಿ ಸತ್ಯಂ ಕಥಾಮೇತಾಂ ಕಥಯಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="26" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಸಮ್ಮಿಲಿತಾನಾಂ ಯುಷ್ಮಾಕಮ್ ಏಕೇನ ಗೀತಮ್ ಅನ್ಯೇನೋಪದೇಶೋಽನ್ಯೇನ ಪರಭಾಷಾನ್ಯೇನ ಐಶ್ವರಿಕದರ್ಶನಮ್ ಅನ್ಯೇನಾರ್ಥಬೋಧಕಂ ವಾಕ್ಯಂ ಲಭ್ಯತೇ ಕಿಮೇತತ್? ಸರ್ವ್ವಮೇವ ಪರನಿಷ್ಠಾರ್ಥಂ ಯುಷ್ಮಾಭಿಃ ಕ್ರಿಯತಾಂ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಯದಿ ಕಶ್ಚಿದ್ ಭಾಷಾನ್ತರಂ ವಿವಕ್ಷತಿ ತರ್ಹ್ಯೇಕಸ್ಮಿನ್ ದಿನೇ ದ್ವಿಜನೇನ ತ್ರಿಜನೇನ ವಾ ಪರಭಾाಷಾ ಕಥ್ಯತಾಂ ತದಧಿಕೈರ್ನ ಕಥ್ಯತಾಂ ತೈರಪಿ ಪರ್ಯ್ಯಾಯಾನುಸಾರಾತ್ ಕಥ್ಯತಾಂ, ಏಕೇನ ಚ ತದರ್ಥೋ ಬೋಧ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="28" style="v"/>ಕಿನ್ತ್ವರ್ಥಾಭಿಧಾಯಕಃ ಕೋಽಪಿ ಯದಿ ನ ವಿದ್ಯತೇ ತರ್ಹಿ ಸ ಸಮಿತೌ ವಾಚಂಯಮಃ ಸ್ಥಿತ್ವೇಶ್ವರಾಯಾತ್ಮನೇ ಚ ಕಥಾಂ ಕಥಯತು|</para>
  <para style="p">
    <verse number="29" style="v"/>ಅಪರಂ ದ್ವೌ ತ್ರಯೋ ವೇಶ್ವರೀಯಾದೇಶವಕ್ತಾರಃ ಸ್ವಂ ಸ್ವಮಾದೇಶಂ ಕಥಯನ್ತು ತದನ್ಯೇ ಚ ತಂ ವಿಚಾರಯನ್ತು|</para>
  <para style="p">
    <verse number="30" style="v"/>ಕಿನ್ತು ತತ್ರಾಪರೇಣ ಕೇನಚಿತ್ ಜನೇನೇಶ್ವರೀಯಾದೇಶೇ ಲಬ್ಧೇ ಪ್ರಥಮೇನ ಕಥನಾತ್ ನಿವರ್ತ್ತಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="31" style="v"/>ಸರ್ವ್ವೇ ಯತ್ ಶಿಕ್ಷಾಂ ಸಾನ್ತ್ವನಾಞ್ಚ ಲಭನ್ತೇ ತದರ್ಥಂ ಯೂಯಂ ಸರ್ವ್ವೇ ಪರ್ಯ್ಯಾಯೇಣೇಶ್ವರೀಯಾದೇಶಂ ಕಥಯಿತುಂ ಶಕ್ನುಥ|</para>
  <para style="p">
    <verse number="32" style="v"/>ಈಶ್ವರೀಯಾದೇಶವಕ್ತೃಣಾಂ ಮನಾಂಸಿ ತೇಷಾಮ್ ಅಧೀನಾನಿ ಭವನ್ತಿ|</para>
  <para style="p">
    <verse number="33" style="v"/>ಯತ ಈಶ್ವರಃ ಕುಶಾಸನಜನಕೋ ನಹಿ ಸುಶಾಸನಜನಕ ಏವೇತಿ ಪವಿತ್ರಲೋಕಾನಾಂ ಸರ್ವ್ವಸಮಿತಿಷು ಪ್ರಕಾಶತೇ|</para>
  <para style="p">
    <verse number="34" style="v"/>ಅಪರಞ್ಚ ಯುಷ್ಮಾಕಂ ವನಿತಾಃ ಸಮಿತಿಷು ತೂಷ್ಣೀಮ್ಭೂತಾಸ್ತಿಷ್ಠನ್ತು ಯತಃ ಶಾಸ್ತ್ರಲಿಖಿತೇನ ವಿಧಿನಾ ತಾಃ ಕಥಾಪ್ರಚಾರಣಾತ್ ನಿವಾರಿತಾಸ್ತಾಭಿ ರ್ನಿಘ್ರಾಭಿ ರ್ಭವಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="35" style="v"/>ಅತಸ್ತಾ ಯದಿ ಕಿಮಪಿ ಜಿಜ್ಞಾಸನ್ತೇ ತರ್ಹಿ ಗೇಹೇಷು ಪತೀನ್ ಪೃಚ್ಛನ್ತು ಯತಃ ಸಮಿತಿಮಧ್ಯೇ ಯೋಷಿತಾಂ ಕಥಾಕಥನಂ ನಿನ್ದನೀಯಂ|</para>
  <para style="p">
    <verse number="36" style="v"/>ಐಶ್ವರಂ ವಚಃ ಕಿಂ ಯುಷ್ಮತ್ತೋ ನಿರಗಮತ? ಕೇವಲಂ ಯುಷ್ಮಾನ್ ವಾ ತತ್ ಕಿಮ್ ಉಪಾಗತಂ?</para>
  <para style="p">
    <verse number="37" style="v"/>ಯಃ ಕಶ್ಚಿದ್ ಆತ್ಮಾನಮ್ ಈಶ್ವರೀಯಾದೇಶವಕ್ತಾರಮ್ ಆತ್ಮನಾವಿಷ್ಟಂ ವಾ ಮನ್ಯತೇ ಸ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಮಯಾ ಯದ್ ಯತ್ ಲಿಖ್ಯತೇ ತತ್ಪ್ರಭುನಾಜ್ಞಾಪಿತಮ್ ಈತ್ಯುರರೀ ಕರೋತು|</para>
  <para style="p">
    <verse number="38" style="v"/>ಕಿನ್ತು ಯಃ ಕಶ್ಚಿತ್ ಅಜ್ಞೋ ಭವತಿ ಸೋಽಜ್ಞ ಏವ ತಿಷ್ಠತು|</para>
  <para style="p">
    <verse number="39" style="v"/>ಅತಏವ ಹೇ ಭ್ರಾತರಃ, ಯೂಯಮ್ ಈಶ್ವರೀಯಾದೇಶಕಥನಸಾಮರ್ಥ್ಯಂ ಲಬ್ಧುಂ ಯತಧ್ವಂ ಪರಭಾಷಾಭಾಷಣಮಪಿ ಯುಷ್ಮಾಭಿ ರ್ನ ನಿವಾರ್ಯ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="40" style="v"/>ಸರ್ವ್ವಕರ್ಮ್ಮಾಣಿ ಚ ವಿಧ್ಯನುಸಾರತಃ ಸುಪರಿಪಾಟ್ಯಾ ಕ್ರಿಯನ್ತಾಂ|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಯಃ ಸುಸಂವಾದೋ ಮಯಾ ಯುಷ್ಮತ್ಸಮೀಪೇ ನಿವೇದಿತೋ ಯೂಯಞ್ಚ ಯಂ ಗೃಹೀತವನ್ತ ಆಶ್ರಿತವನ್ತಶ್ಚ ತಂ ಪುನ ರ್ಯುಷ್ಮಾನ್ ವಿಜ್ಞಾಪಯಾಮಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸೋ ಯದಿ ವಿತಥೋ ನ ಭವೇತ್ ತರ್ಹಿ ಸುಸಂವಾದಯುಕ್ತಾನಿ ಮಮ ವಾಕ್ಯಾನಿ ಸ್ಮರತಾಂ ಯುಷ್ಮಾಕಂ ತೇನ ಸುಸಂವಾದೇನ ಪರಿತ್ರಾಣಂ ಜಾಯತೇ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಯತೋಽಹಂ ಯದ್ ಯತ್ ಜ್ಞಾಪಿತಸ್ತದನುಸಾರಾತ್ ಯುಷ್ಮಾಸು ಮುಖ್ಯಾಂ ಯಾಂ ಶಿಕ್ಷಾಂ ಸಮಾರ್ಪಯಂ ಸೇಯಂ, ಶಾಸ್ತ್ರಾನುಸಾರಾತ್ ಖ್ರೀಷ್ಟೋಽಸ್ಮಾಕಂ ಪಾಪಮೋಚನಾರ್ಥಂ ಪ್ರಾಣಾನ್ ತ್ಯಕ್ತವಾನ್,</para>
  <para style="p">
    <verse number="4" style="v"/>ಶ್ಮಶಾನೇ ಸ್ಥಾಪಿತಶ್ಚ ತೃತೀಯದಿನೇ ಶಾಸ್ತ್ರಾನುಸಾರಾತ್ ಪುನರುತ್ಥಾಪಿತಃ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಸ ಚಾಗ್ರೇ ಕೈಫೈ ತತಃ ಪರಂ ದ್ವಾದಶಶಿಷ್ಯೇಭ್ಯೋ ದರ್ಶನಂ ದತ್ತವಾನ್|</para>
  <para style="p">
    <verse number="6" style="v"/>ತತಃ ಪರಂ ಪಞ್ಚಶತಾಧಿಕಸಂಖ್ಯಕೇಭ್ಯೋ ಭ್ರಾತೃಭ್ಯೋ ಯುಗಪದ್ ದರ್ಶನಂ ದತ್ತವಾನ್ ತೇಷಾಂ ಕೇಚಿತ್ ಮಹಾನಿದ್ರಾಂ ಗತಾ ಬಹುತರಾಶ್ಚಾದ್ಯಾಪಿ ವರ್ತ್ತನ್ತೇ|</para>
  <para style="p">
    <verse number="7" style="v"/>ತದನನ್ತರಂ ಯಾಕೂಬಾಯ ತತ್ಪಶ್ಚಾತ್ ಸರ್ವ್ವೇಭ್ಯಃ ಪ್ರೇರಿತೇಭ್ಯೋ ದರ್ಶನಂ ದತ್ತವಾನ್|</para>
  <para style="p">
    <verse number="8" style="v"/>ಸರ್ವ್ವಶೇಷೇಽಕಾಲಜಾತತುಲ್ಯೋ ಯೋಽಹಂ, ಸೋಽಹಮಪಿ ತಸ್ಯ ದರ್ಶನಂ ಪ್ರಾಪ್ತವಾನ್|</para>
  <para style="p">
    <verse number="9" style="v"/>ಈಶ್ವರಸ್ಯ ಸಮಿತಿಂ ಪ್ರತಿ ದೌರಾತ್ಮ್ಯಾಚರಣಾದ್ ಅಹಂ ಪ್ರೇರಿತನಾಮ ಧರ್ತ್ತುಮ್ ಅಯೋಗ್ಯಸ್ತಸ್ಮಾತ್ ಪ್ರೇರಿತಾನಾಂ ಮಧ್ಯೇ ಕ್ಷುದ್ರತಮಶ್ಚಾಸ್ಮಿ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯಾದೃಶೋಽಸ್ಮಿ ತಾದೃಶ ಈಶ್ವರಸ್ಯಾನುಗ್ರಹೇಣೈವಾಸ್ಮಿ; ಅಪರಂ ಮಾಂ ಪ್ರತಿ ತಸ್ಯಾನುಗ್ರಹೋ ನಿಷ್ಫಲೋ ನಾಭವತ್, ಅನ್ಯೇಭ್ಯಃ ಸರ್ವ್ವೇಭ್ಯೋ ಮಯಾಧಿಕಃ ಶ್ರಮಃ ಕೃತಃ, ಕಿನ್ತು ಸ ಮಯಾ ಕೃತಸ್ತನ್ನಹಿ ಮತ್ಸಹಕಾರಿಣೇಶ್ವರಸ್ಯಾನುಗ್ರಹೇಣೈವ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅತಏವ ಮಯಾ ಭವೇತ್ ತೈ ರ್ವಾ ಭವೇತ್ ಅಸ್ಮಾಭಿಸ್ತಾದೃಶೀ ವಾರ್ತ್ತಾ ಘೋಷ್ಯತೇ ಸೈವ ಚ ಯುಷ್ಮಾಭಿ ರ್ವಿಶ್ವಾಸೇನ ಗೃಹೀತಾ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಮೃತ್ಯುದಶಾತಃ ಖ್ರೀಷ್ಟ ಉತ್ಥಾಪಿತ ಇತಿ ವಾರ್ತ್ತಾ ಯದಿ ತಮಧಿ ಘೋಷ್ಯತೇ ತರ್ಹಿ ಮೃತಲೋಕಾನಾಮ್ ಉತ್ಥಿತಿ ರ್ನಾಸ್ತೀತಿ ವಾಗ್ ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ಕೈಶ್ಚಿತ್ ಕುತಃ ಕಥ್ಯತೇ?</para>
  <para style="p">
    <verse number="13" style="v"/>ಮೃತಾನಾಮ್ ಉತ್ಥಿತಿ ರ್ಯದಿ ನ ಭವೇತ್ ತರ್ಹಿ ಖ್ರೀಷ್ಟೋಽಪಿ ನೋತ್ಥಾಪಿತಃ</para>
  <para style="p">
    <verse number="14" style="v"/>ಖ್ರೀಷ್ಟಶ್ಚ ಯದ್ಯನುತ್ಥಾಪಿತಃ ಸ್ಯಾತ್ ತರ್ಹ್ಯಸ್ಮಾಕಂ ಘೋಷಣಂ ವಿತಥಂ ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸೋಽಪಿ ವಿತಥಃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ವಯಞ್ಚೇಶ್ವರಸ್ಯ ಮೃಷಾಸಾಕ್ಷಿಣೋ ಭವಾಮಃ, ಯತಃ ಖ್ರೀಷ್ಟ ಸ್ತೇನೋತ್ಥಾಪಿತಃ ಇತಿ ಸಾಕ್ಷ್ಯಮ್ ಅಸ್ಮಾಭಿರೀಶ್ವರಮಧಿ ದತ್ತಂ ಕಿನ್ತು ಮೃತಾನಾಮುತ್ಥಿತಿ ರ್ಯದಿ ನ ಭವೇತ್ ತರ್ಹಿ ಸ ತೇನ ನೋತ್ಥಾಪಿತಃ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯತೋ ಮೃತಾನಾಮುತ್ಥಿತಿ ರ್ಯತಿ ನ ಭವೇತ್ ತರ್ಹಿ ಖ್ರೀಷ್ಟೋಽಪ್ಯುತ್ಥಾಪಿತತ್ವಂ ನ ಗತಃ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಖ್ರೀಷ್ಟಸ್ಯ ಯದ್ಯನುತ್ಥಾಪಿತಃ ಸ್ಯಾತ್ ತರ್ಹಿ ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸೋ ವಿತಥಃ, ಯೂಯಮ್ ಅದ್ಯಾಪಿ ಸ್ವಪಾಪೇಷು ಮಗ್ನಾಸ್ತಿಷ್ಠಥ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಅಪರಂ ಖ್ರೀಷ್ಟಾಶ್ರಿತಾ ಯೇ ಮಾನವಾ ಮಹಾನಿದ್ರಾಂ ಗತಾಸ್ತೇಽಪಿ ನಾಶಂ ಗತಾಃ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಖ್ರೀಷ್ಟೋ ಯದಿ ಕೇವಲಮಿಹಲೋಕೇ ಽಸ್ಮಾಕಂ ಪ್ರತ್ಯಾಶಾಭೂಮಿಃ ಸ್ಯಾತ್ ತರ್ಹಿ ಸರ್ವ್ವಮರ್ತ್ಯೇಭ್ಯೋ ವಯಮೇವ ದುರ್ಭಾಗ್ಯಾಃ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಇದಾನೀಂ ಖ್ರೀಷ್ಟೋ ಮೃತ್ಯುದಶಾತ ಉತ್ಥಾಪಿತೋ ಮಹಾನಿದ್ರಾಗತಾನಾಂ ಮಧ್ಯೇ ಪ್ರಥಮಫಲಸ್ವರೂಪೋ ಜಾತಶ್ಚ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಯತೋ ಯದ್ವತ್ ಮಾನುಷದ್ವಾರಾ ಮೃತ್ಯುಃ ಪ್ರಾದುರ್ಭೂತಸ್ತದ್ವತ್ ಮಾನುಷದ್ವಾರಾ ಮೃತಾನಾಂ ಪುನರುತ್ಥಿತಿರಪಿ ಪ್ರದುರ್ಭೂತಾ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಆದಮಾ ಯಥಾ ಸರ್ವ್ವೇ ಮರಣಾಧೀನಾ ಜಾತಾಸ್ತಥಾ ಖ್ರೀಷ್ಟೇನ ಸರ್ವ್ವೇ ಜೀವಯಿಷ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಕಿನ್ತ್ವೇಕೈಕೇನ ಜನೇನ ನಿಜೇ ನಿಜೇ ಪರ್ಯ್ಯಾಯ ಉತ್ಥಾತವ್ಯಂ ಪ್ರಥಮತಃ ಪ್ರಥಮಜಾತಫಲಸ್ವರೂಪೇನ ಖ್ರೀಷ್ಟೇನ, ದ್ವಿತೀಯತಸ್ತಸ್ಯಾಗಮನಸಮಯೇ ಖ್ರೀಷ್ಟಸ್ಯ ಲೋಕೈಃ|</para>
  <para style="p">
    <verse number="24" style="v"/>ತತಃ ಪರಮ್ ಅನ್ತೋ ಭವಿಷ್ಯತಿ ತದಾನೀಂ ಸ ಸರ್ವ್ವಂ ಶಾಸನಮ್ ಅಧಿಪತಿತ್ವಂ ಪರಾಕ್ರಮಞ್ಚ ಲುಪ್ತ್ವಾ ಸ್ವಪಿತರೀಶ್ವರೇ ರಾಜತ್ವಂ ಸಮರ್ಪಯಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಯತಃ ಖ್ರೀಷ್ಟಸ್ಯ ರಿಪವಃ ಸರ್ವ್ವೇ ಯಾವತ್ ತೇನ ಸ್ವಪಾದಯೋರಧೋ ನ ನಿಪಾತಯಿಷ್ಯನ್ತೇ ತಾವತ್ ತೇನೈವ ರಾಜತ್ವಂ ಕರ್ತ್ತವ್ಯಂ|</para>
  <para style="p">
    <verse number="26" style="v"/>ತೇನ ವಿಜೇತವ್ಯೋ ಯಃ ಶೇಷರಿಪುಃ ಸ ಮೃತ್ಯುರೇವ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಲಿಖಿತಮಾಸ್ತೇ ಸರ್ವ್ವಾಣಿ ತಸ್ಯ ಪಾದಯೋ ರ್ವಶೀಕೃತಾನಿ| ಕಿನ್ತು ಸರ್ವ್ವಾಣ್ಯೇವ ತಸ್ಯ ವಶೀಕೃತಾನೀತ್ಯುಕ್ತೇ ಸತಿ ಸರ್ವ್ವಾಣಿ ಯೇನ ತಸ್ಯ ವಶೀಕೃತಾನಿ ಸ ಸ್ವಯಂ ತಸ್ಯ ವಶೀಭೂತೋ ನ ಜಾತ ಇತಿ ವ್ಯಕ್ತಂ|</para>
  <para style="p">
    <verse number="28" style="v"/>ಸರ್ವ್ವೇಷು ತಸ್ಯ ವಶೀಭೂತೇಷು ಸರ್ವ್ವಾಣಿ ಯೇನ ಪುತ್ರಸ್ಯ ವಶೀಕೃತಾನಿ ಸ್ವಯಂ ಪುತ್ರೋಽಪಿ ತಸ್ಯ ವಶೀಭೂತೋ ಭವಿಷ್ಯತಿ ತತ ಈಶ್ವರಃ ಸರ್ವ್ವೇಷು ಸರ್ವ್ವ ಏವ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="29" style="v"/>ಅಪರಂ ಪರೇತಲೋಕಾನಾಂ ವಿನಿಮಯೇನ ಯೇ ಮಜ್ಜ್ಯನ್ತೇ ತೈಃ ಕಿಂ ಲಪ್ಸ್ಯತೇ? ಯೇಷಾಂ ಪರೇತಲೋಕಾನಾಮ್ ಉತ್ಥಿತಿಃ ಕೇನಾಪಿ ಪ್ರಕಾರೇಣ ನ ಭವಿಷ್ಯತಿ ತೇಷಾಂ ವಿನಿಮಯೇನ ಕುತೋ ಮಜ್ಜನಮಪಿ ತೈರಙ್ಗೀಕ್ರಿಯತೇ?</para>
  <para style="p">
    <verse number="30" style="v"/>ವಯಮಪಿ ಕುತಃ ಪ್ರತಿದಣ್ಡಂ ಪ್ರಾಣಭೀತಿಮ್ ಅಙ್ಗೀಕುರ್ಮ್ಮಹೇ?</para>
  <para style="p">
    <verse number="31" style="v"/>ಅಸ್ಮತ್ಪ್ರಭುನಾ ಯೀಶುಖ್ರೀಷ್ಟೇನ ಯುಷ್ಮತ್ತೋ ಮಮ ಯಾ ಶ್ಲಾಘಾಸ್ತೇ ತಸ್ಯಾಃ ಶಪಥಂ ಕೃತ್ವಾ ಕಥಯಾಮಿ ದಿನೇ ದಿನೇಽಹಂ ಮೃತ್ಯುಂ ಗಚ್ಛಾಮಿ|</para>
  <para style="p">
    <verse number="32" style="v"/>ಇಫಿಷನಗರೇ ವನ್ಯಪಶುಭಿಃ ಸಾರ್ದ್ಧಂ ಯದಿ ಲೌಕಿಕಭಾವಾತ್ ಮಯಾ ಯುದ್ಧಂ ಕೃತಂ ತರ್ಹಿ ತೇನ ಮಮ ಕೋ ಲಾಭಃ? ಮೃತಾನಾಮ್ ಉತ್ಥಿತಿ ರ್ಯದಿ ನ ಭವೇತ್ ತರ್ಹಿ, ಕುರ್ಮ್ಮೋ ಭೋಜನಪಾನೇಽದ್ಯ ಶ್ವಸ್ತು ಮೃತ್ಯು ರ್ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="33" style="v"/>ಇತ್ಯನೇನ ಧರ್ಮ್ಮಾತ್ ಮಾ ಭ್ರಂಶಧ್ವಂ| ಕುಸಂಸರ್ಗೇಣ ಲೋಕಾನಾಂ ಸದಾಚಾರೋ ವಿನಶ್ಯತಿ|</para>
  <para style="p">
    <verse number="34" style="v"/>ಯೂಯಂ ಯಥೋಚಿತಂ ಸಚೈತನ್ಯಾಸ್ತಿಷ್ಠತ, ಪಾಪಂ ಮಾ ಕುರುಧ್ವಂ, ಯತೋ ಯುಷ್ಮಾಕಂ ಮಧ್ಯ ಈಶ್ವರೀಯಜ್ಞಾನಹೀನಾಃ ಕೇಽಪಿ ವಿದ್ಯನ್ತೇ ಯುಷ್ಮಾಕಂ ತ್ರಪಾಯೈ ಮಯೇದಂ ಗದ್ಯತೇ|</para>
  <para style="p">
    <verse number="35" style="v"/>ಅಪರಂ ಮೃತಲೋಕಾಃ ಕಥಮ್ ಉತ್ಥಾಸ್ಯನ್ತಿ? ಕೀದೃಶಂ ವಾ ಶರೀರಂ ಲಬ್ಧ್ವಾ ಪುನರೇಷ್ಯನ್ತೀತಿ ವಾಕ್ಯಂ ಕಶ್ಚಿತ್ ಪ್ರಕ್ಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="36" style="v"/>ಹೇ ಅಜ್ಞ ತ್ವಯಾ ಯದ್ ಬೀಜಮ್ ಉಪ್ಯತೇ ತದ್ ಯದಿ ನ ಮ್ರಿಯೇತ ತರ್ಹಿ ನ ಜೀವಯಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="37" style="v"/>ಯಯಾ ಮೂರ್ತ್ತ್ಯಾ ನಿರ್ಗನ್ತವ್ಯಂ ಸಾ ತ್ವಯಾ ನೋಪ್ಯತೇ ಕಿನ್ತು ಶುಷ್ಕಂ ಬೀಜಮೇವ; ತಚ್ಚ ಗೋಧೂಮಾದೀನಾಂ ಕಿಮಪಿ ಬೀಜಂ ಭವಿತುಂ ಶಕ್ನೋತಿ|</para>
  <para style="p">
    <verse number="38" style="v"/>ಈಶ್ವರೇಣೇವ ಯಥಾಭಿಲಾಷಂ ತಸ್ಮೈ ಮೂರ್ತ್ತಿ ರ್ದೀಯತೇ, ಏಕೈಕಸ್ಮೈ ಬೀಜಾಯ ಸ್ವಾ ಸ್ವಾ ಮೂರ್ತ್ತಿರೇವ ದೀಯತೇ|</para>
  <para style="p">
    <verse number="39" style="v"/>ಸರ್ವ್ವಾಣಿ ಪಲಲಾನಿ ನೈಕವಿಧಾನಿ ಸನ್ತಿ, ಮನುಷ್ಯಪಶುಪಕ್ಷಿಮತ್ಸ್ಯಾದೀನಾಂ ಭಿನ್ನರೂಪಾಣಿ ಪಲಲಾನಿ ಸನ್ತಿ|</para>
  <para style="p">
    <verse number="40" style="v"/>ಅಪರಂ ಸ್ವರ್ಗೀಯಾ ಮೂರ್ತ್ತಯಃ ಪಾರ್ಥಿವಾ ಮೂರ್ತ್ತಯಶ್ಚ ವಿದ್ಯನ್ತೇ ಕಿನ್ತು ಸ್ವರ್ಗೀಯಾನಾಮ್ ಏಕರೂಪಂ ತೇಜಃ ಪಾರ್ಥಿವಾನಾಞ್ಚ ತದನ್ಯರೂಪಂ ತೇಜೋಽಸ್ತಿ|</para>
  <para style="p">
    <verse number="41" style="v"/>ಸೂರ್ಯ್ಯಸ್ಯ ತೇಜ ಏಕವಿಧಂ ಚನ್ದ್ರಸ್ಯ ತೇಜಸ್ತದನ್ಯವಿಧಂ ತಾರಾಣಾಞ್ಚ ತೇಜೋಽನ್ಯವಿಧಂ, ತಾರಾಣಾಂ ಮಧ್ಯೇಽಪಿ ತೇಜಸಸ್ತಾರತಮ್ಯಂ ವಿದ್ಯತೇ|</para>
  <para style="p">
    <verse number="42" style="v"/>ತತ್ರ ಲಿಖಿತಮಾಸ್ತೇ ಯಥಾ, ‘ಆದಿಪುರುಷ ಆದಮ್ ಜೀವತ್ಪ್ರಾಣೀ ಬಭೂವ,’ ಕಿನ್ತ್ವನ್ತಿಮ ಆದಮ್ (ಖ್ರೀಷ್ಟೋ) ಜೀವನದಾಯಕ ಆತ್ಮಾ ಬಭೂವ|</para>
  <para style="p">
    <verse number="43" style="v"/>ಯದ್ ಉಪ್ಯತೇ ತತ್ ತುಚ್ಛಂ ಯಚ್ಚೋತ್ಥಾಸ್ಯತಿ ತದ್ ಗೌರವಾನ್ವಿತಂ; ಯದ್ ಉಪ್ಯತೇ ತನ್ನಿರ್ಬ್ಬಲಂ ಯಚ್ಚೋತ್ಥಾಸ್ಯತಿ ತತ್ ಶಕ್ತಿಯುಕ್ತಂ|</para>
  <para style="p">
    <verse number="44" style="v"/>ಯತ್ ಶರೀರಮ್ ಉಪ್ಯತೇ ತತ್ ಪ್ರಾಣಾನಾಂ ಸದ್ಮ, ಯಚ್ಚ ಶರೀರಮ್ ಉತ್ಥಾಸ್ಯತಿ ತದ್ ಆತ್ಮನಃ ಸದ್ಮ| ಪ್ರಾಣಸದ್ಮಸ್ವರೂಪಂ ಶರೀರಂ ವಿದ್ಯತೇ, ಆತ್ಮಸದ್ಮಸ್ವರೂಪಮಪಿ ಶರೀರಂ ವಿದ್ಯತೇ|</para>
  <para style="p">
    <verse number="45" style="v"/>ತತ್ರ ಲಿಖಿತಮಾಸ್ತೇ ಯಥಾ, ಆದಿಪುರುಷ ಆದಮ್ ಜೀವತ್ಪ್ರಾಣೀ ಬಭೂವ, ಕಿನ್ತ್ವನ್ತಿಮ ಆದಮ್ (ಖ್ರೀಷ್ಟೋ) ಜೀವನದಾಯಕ ಆತ್ಮಾ ಬಭೂವ|</para>
  <para style="p">
    <verse number="46" style="v"/>ಆತ್ಮಸದ್ಮ ನ ಪ್ರಥಮಂ ಕಿನ್ತು ಪ್ರಾಣಸದ್ಮೈವ ತತ್ಪಶ್ಚಾದ್ ಆತ್ಮಸದ್ಮ|</para>
  <para style="p">
    <verse number="47" style="v"/>ಆದ್ಯಃ ಪುರುಷೇ ಮೃದ ಉತ್ಪನ್ನತ್ವಾತ್ ಮೃಣ್ಮಯೋ ದ್ವಿತೀಯಶ್ಚ ಪುರುಷಃ ಸ್ವರ್ಗಾದ್ ಆಗತಃ ಪ್ರಭುಃ|</para>
  <para style="p">
    <verse number="48" style="v"/>ಮೃಣ್ಮಯೋ ಯಾದೃಶ ಆಸೀತ್ ಮೃಣ್ಮಯಾಃ ಸರ್ವ್ವೇ ತಾದೃಶಾ ಭವನ್ತಿ ಸ್ವರ್ಗೀಯಶ್ಚ ಯಾದೃಶೋಽಸ್ತಿ ಸ್ವರ್ಗೀಯಾಃ ಸರ್ವ್ವೇ ತಾದೃಶಾ ಭವನ್ತಿ|</para>
  <para style="p">
    <verse number="49" style="v"/>ಮೃಣ್ಮಯಸ್ಯ ರೂಪಂ ಯದ್ವದ್ ಅಸ್ಮಾಭಿ ರ್ಧಾರಿತಂ ತದ್ವತ್ ಸ್ವರ್ಗೀಯಸ್ಯ ರೂಪಮಪಿ ಧಾರಯಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="50" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಯುಷ್ಮಾನ್ ಪ್ರತಿ ವ್ಯಾಹರಾಮಿ, ಈಶ್ವರಸ್ಯ ರಾಜ್ಯೇ ರಕ್ತಮಾಂಸಯೋರಧಿಕಾರೋ ಭವಿತುಂ ನ ಶಕ್ನೋತಿ, ಅಕ್ಷಯತ್ವೇ ಚ ಕ್ಷಯಸ್ಯಾಧಿಕಾರೋ ನ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="51" style="v"/>ಪಶ್ಯತಾಹಂ ಯುಷ್ಮಭ್ಯಂ ನಿಗೂಢಾಂ ಕಥಾಂ ನಿವೇದಯಾಮಿ|</para>
  <para style="p">
    <verse number="52" style="v"/>ಸರ್ವ್ವೈರಸ್ಮಾಭಿ ರ್ಮಹಾನಿದ್ರಾ ನ ಗಮಿಷ್ಯತೇ ಕಿನ್ತ್ವನ್ತಿಮದಿನೇ ತೂರ್ಯ್ಯಾಂ ವಾದಿತಾಯಾಮ್ ಏಕಸ್ಮಿನ್ ವಿಪಲೇ ನಿಮಿಷೈಕಮಧ್ಯೇ ಸರ್ವ್ವೈ ರೂಪಾನ್ತರಂ ಗಮಿಷ್ಯತೇ, ಯತಸ್ತೂರೀ ವಾದಿಷ್ಯತೇ, ಮೃತಲೋಕಾಶ್ಚಾಕ್ಷಯೀಭೂತಾ ಉತ್ಥಾಸ್ಯನ್ತಿ ವಯಞ್ಚ ರೂಪಾನ್ತರಂ ಗಮಿಷ್ಯಾಮಃ|</para>
  <para style="p">
    <verse number="53" style="v"/>ಯತಃ ಕ್ಷಯಣೀಯೇನೈತೇನ ಶರೀರೇಣಾಕ್ಷಯತ್ವಂ ಪರಿಹಿತವ್ಯಂ, ಮರಣಾಧೀನೇನೈತೇನ ದೇಹೇನ ಚಾಮರತ್ವಂ ಪರಿಹಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="54" style="v"/>ಏತಸ್ಮಿನ್ ಕ್ಷಯಣೀಯೇ ಶರೀರೇ ಽಕ್ಷಯತ್ವಂ ಗತೇ, ಏತಸ್ಮನ್ ಮರಣಾಧೀನೇ ದೇಹೇ ಚಾಮರತ್ವಂ ಗತೇ ಶಾಸ್ತ್ರೇ ಲಿಖಿತಂ ವಚನಮಿದಂ ಸೇತ್ಸ್ಯತಿ, ಯಥಾ, ಜಯೇನ ಗ್ರಸ್ಯತೇ ಮೃತ್ಯುಃ|</para>
  <para style="p">
    <verse number="55" style="v"/>ಮೃತ್ಯೋ ತೇ ಕಣ್ಟಕಂ ಕುತ್ರ ಪರಲೋಕ ಜಯಃ ಕ್ಕ ತೇ||</para>
  <para style="p">
    <verse number="56" style="v"/>ಮೃತ್ಯೋಃ ಕಣ್ಟಕಂ ಪಾಪಮೇವ ಪಾಪಸ್ಯ ಚ ಬಲಂ ವ್ಯವಸ್ಥಾ|</para>
  <para style="p">
    <verse number="57" style="v"/>ಈಶ್ವರಶ್ಚ ಧನ್ಯೋ ಭವತು ಯತಃ ಸೋಽಸ್ಮಾಕಂ ಪ್ರಭುನಾ ಯೀಶುಖ್ರೀಷ್ಟೇನಾಸ್ಮಾನ್ ಜಯಯುಕ್ತಾನ್ ವಿಧಾಪಯತಿ|</para>
  <para style="p">
    <verse number="58" style="v"/>ಅತೋ ಹೇ ಮಮ ಪ್ರಿಯಭ್ರಾತರಃ; ಯೂಯಂ ಸುಸ್ಥಿರಾ ನಿಶ್ಚಲಾಶ್ಚ ಭವತ ಪ್ರಭೋಃ ಸೇವಾಯಾಂ ಯುಷ್ಮಾಕಂ ಪರಿಶ್ರಮೋ ನಿಷ್ಫಲೋ ನ ಭವಿಷ್ಯತೀತಿ ಜ್ಞಾತ್ವಾ ಪ್ರಭೋಃ ಕಾರ್ಯ್ಯೇ ಸದಾ ತತ್ಪರಾ ಭವತ|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಪವಿತ್ರಲೋಕಾನಾಂ ಕೃತೇ ಯೋಽರ್ಥಸಂಗ್ರಹಸ್ತಮಧಿ ಗಾಲಾತೀಯದೇಶಸ್ಯ ಸಮಾಜಾ ಮಯಾ ಯದ್ ಆದಿಷ್ಟಾಸ್ತದ್ ಯುಷ್ಮಾಭಿರಪಿ ಕ್ರಿಯತಾಂ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಮಮಾಗಮನಕಾಲೇ ಯದ್ ಅರ್ಥಸಂಗ್ರಹೋ ನ ಭವೇತ್ ತನ್ನಿಮಿತ್ತಂ ಯುಷ್ಮಾಕಮೇಕೈಕೇನ ಸ್ವಸಮ್ಪದಾನುಸಾರಾತ್ ಸಞ್ಚಯಂ ಕೃತ್ವಾ ಸಪ್ತಾಹಸ್ಯ ಪ್ರಥಮದಿವಸೇ ಸ್ವಸಮೀಪೇ ಕಿಞ್ಚಿತ್ ನಿಕ್ಷಿಪ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ತತೋ ಮಮಾಗಮನಸಮಯೇ ಯೂಯಂ ಯಾನೇವ ವಿಶ್ವಾಸ್ಯಾ ಇತಿ ವೇದಿಷ್ಯಥ ತೇಭ್ಯೋಽಹಂ ಪತ್ರಾಣಿ ದತ್ತ್ವಾ ಯುಷ್ಮಾಕಂ ತದ್ದಾನಸ್ಯ ಯಿರೂಶಾಲಮಂ ನಯನಾರ್ಥಂ ತಾನ್ ಪ್ರೇಷಯಿಷ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಕಿನ್ತು ಯದಿ ತತ್ರ ಮಮಾಪಿ ಗಮನಮ್ ಉಚಿತಂ ಭವೇತ್ ತರ್ಹಿ ತೇ ಮಯಾ ಸಹ ಯಾಸ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಸಾಮ್ಪ್ರತಂ ಮಾಕಿದನಿಯಾದೇಶಮಹಂ ಪರ್ಯ್ಯಟಾಮಿ ತಂ ಪರ್ಯ್ಯಟ್ಯ ಯುಷ್ಮತ್ಸಮೀಪಮ್ ಆಗಮಿಷ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅನನ್ತರಂ ಕಿಂ ಜಾನಾಮಿ ಯುಷ್ಮತ್ಸನ್ನಿಧಿಮ್ ಅವಸ್ಥಾಸ್ಯೇ ಶೀತಕಾಲಮಪಿ ಯಾಪಯಿಷ್ಯಾಮಿ ಚ ಪಶ್ಚಾತ್ ಮಮ ಯತ್ ಸ್ಥಾನಂ ಗನ್ತವ್ಯಂ ತತ್ರೈವ ಯುಷ್ಮಾಭಿರಹಂ ಪ್ರೇರಯಿತವ್ಯಃ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯತೋಽಹಂ ಯಾತ್ರಾಕಾಲೇ ಕ್ಷಣಮಾತ್ರಂ ಯುಷ್ಮಾನ್ ದ್ರಷ್ಟುಂ ನೇಚ್ಛಾಮಿ ಕಿನ್ತು ಪ್ರಭು ರ್ಯದ್ಯನುಜಾನೀಯಾತ್ ತರ್ಹಿ ಕಿಞ್ಚಿದ್ ದೀರ್ಘಕಾಲಂ ಯುಷ್ಮತ್ಸಮೀಪೇ ಪ್ರವಸ್ತುಮ್ ಇಚ್ಛಾಮಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ತಥಾಪಿ ನಿಸ್ತಾರೋತ್ಸವಾತ್ ಪರಂ ಪಞ್ಚಾಶತ್ತಮದಿನಂ ಯಾವದ್ ಇಫಿಷಪುರ್ಯ್ಯಾಂ ಸ್ಥಾಸ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಯಸ್ಮಾದ್ ಅತ್ರ ಕಾರ್ಯ್ಯಸಾಧನಾರ್ಥಂ ಮಮಾನ್ತಿಕೇ ಬೃಹದ್ ದ್ವಾರಂ ಮುಕ್ತಂ ಬಹವೋ ವಿಪಕ್ಷಾ ಅಪಿ ವಿದ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="10" style="v"/>ತಿಮಥಿ ರ್ಯದಿ ಯುಷ್ಮಾಕಂ ಸಮೀಪಮ್ ಆಗಚ್ಛೇತ್ ತರ್ಹಿ ಯೇನ ನಿರ್ಭಯಂ ಯುಷ್ಮನ್ಮಧ್ಯೇ ವರ್ತ್ತೇತ ತತ್ರ ಯುಷ್ಮಾಭಿ ರ್ಮನೋ ನಿಧೀಯತಾಂ ಯಸ್ಮಾದ್ ಅಹಂ ಯಾದೃಕ್ ಸೋಽಪಿ ತಾದೃಕ್ ಪ್ರಭೋಃ ಕರ್ಮ್ಮಣೇ ಯತತೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಕೋಽಪಿ ತಂ ಪ್ರತ್ಯನಾದರಂ ನ ಕರೋತು ಕಿನ್ತು ಸ ಮಮಾನ್ತಿಕಂ ಯದ್ ಆಗನ್ತುಂ ಶಕ್ನುಯಾತ್ ತದರ್ಥಂ ಯುಷ್ಮಾಭಿಃ ಸಕುಶಲಂ ಪ್ರೇಷ್ಯತಾಂ| ಭ್ರಾತೃಭಿಃ ಸಾರ್ದ್ಧಮಹಂ ತಂ ಪ್ರತೀಕ್ಷೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಆಪಲ್ಲುಂ ಭ್ರಾತರಮಧ್ಯಹಂ ನಿವೇದಯಾಮಿ ಭ್ರಾತೃಭಿಃ ಸಾಕಂ ಸೋಽಪಿ ಯದ್ ಯುಷ್ಮಾಕಂ ಸಮೀಪಂ ವ್ರಜೇತ್ ತದರ್ಥಂ ಮಯಾ ಸ ಪುನಃ ಪುನರ್ಯಾಚಿತಃ ಕಿನ್ತ್ವಿದಾನೀಂ ಗಮನಂ ಸರ್ವ್ವಥಾ ತಸ್ಮೈ ನಾರೋಚತ, ಇತಃಪರಂ ಸುಸಮಯಂ ಪ್ರಾಪ್ಯ ಸ ಗಮಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯೂಯಂ ಜಾಗೃತ ವಿಶ್ವಾಸೇ ಸುಸ್ಥಿರಾ ಭವತ ಪೌರುಷಂ ಪ್ರಕಾಶಯತ ಬಲವನ್ತೋ ಭವತ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯುಷ್ಮಾಭಿಃ ಸರ್ವ್ವಾಣಿ ಕರ್ಮ್ಮಾಣಿ ಪ್ರೇಮ್ನಾ ನಿಷ್ಪಾದ್ಯನ್ತಾಂ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಅಹಂ ಯುಷ್ಮಾನ್ ಇದಮ್ ಅಭಿಯಾಚೇ ಸ್ತಿಫಾನಸ್ಯ ಪರಿಜನಾ ಆಖಾಯಾದೇಶಸ್ಯ ಪ್ರಥಮಜಾತಫಲಸ್ವರೂಪಾಃ, ಪವಿತ್ರಲೋಕಾನಾಂ ಪರಿಚರ್ಯ್ಯಾಯೈ ಚ ತ ಆತ್ಮನೋ ನ್ಯವೇದಯನ್ ಇತಿ ಯುಷ್ಮಾಭಿ ರ್ಜ್ಞಾಯತೇ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಅತೋ ಯೂಯಮಪಿ ತಾದೃಶಲೋಕಾನಾಮ್ ಅಸ್ಮತ್ಸಹಾಯಾನಾಂ ಶ್ರಮಕಾರಿಣಾಞ್ಚ ಸರ್ವ್ವೇಷಾಂ ವಶ್ಯಾ ಭವತ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಸ್ತಿಫಾನಃ ಫರ್ತ್ತೂನಾತ ಆಖಾಯಿಕಶ್ಚ ಯದ್ ಅತ್ರಾಗಮನ್ ತೇನಾಹಮ್ ಆನನ್ದಾಮಿ ಯತೋ ಯುಷ್ಮಾಭಿರ್ಯತ್ ನ್ಯೂನಿತಂ ತತ್ ತೈಃ ಸಮ್ಪೂರಿತಂ|</para>
  <para style="p">
    <verse number="18" style="v"/>ತೈ ರ್ಯುಷ್ಮಾಕಂ ಮಮ ಚ ಮನಾಂಸ್ಯಾಪ್ಯಾಯಿತಾನಿ| ತಸ್ಮಾತ್ ತಾದೃಶಾ ಲೋಕಾ ಯುಷ್ಮಾಭಿಃ ಸಮ್ಮನ್ತವ್ಯಾಃ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಯುಷ್ಮಭ್ಯಮ್ ಆಶಿಯಾದೇಶಸ್ಥಸಮಾಜಾನಾಂ ನಮಸ್ಕೃತಿಮ್ ಆಕ್ಕಿಲಪ್ರಿಸ್ಕಿಲ್ಲಯೋಸ್ತನ್ಮಣ್ಡಪಸ್ಥಸಮಿತೇಶ್ಚ ಬಹುನಮಸ್ಕೃತಿಂ ಪ್ರಜಾನೀತ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಸರ್ವ್ವೇ ಭ್ರಾತರೋ ಯುಷ್ಮಾನ್ ನಮಸ್ಕುರ್ವ್ವನ್ತೇ| ಯೂಯಂ ಪವಿತ್ರಚುಮ್ಬನೇನ ಮಿಥೋ ನಮತ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಪೌಲೋಽಹಂ ಸ್ವಕರಲಿಖಿತಂ ನಮಸ್ಕೃತಿಂ ಯುಷ್ಮಾನ್ ವೇದಯೇ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಯದಿ ಕಶ್ಚಿದ್ ಯೀಶುಖ್ರೀಷ್ಟೇ ನ ಪ್ರೀಯತೇ ತರ್ಹಿ ಸ ಶಾಪಗ್ರಸ್ತೋ ಭವೇತ್ ಪ್ರಭುರಾಯಾತಿ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಅಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯಾನುಗ್ರಹೋ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಭೂಯಾತ್|</para>
  <para style="p">
    <verse number="24" style="v"/>ಖ್ರೀಷ್ಟಂ ಯೀಶುಮ್ ಆಶ್ರಿತಾನ್ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಮಮ ಪ್ರೇಮ ತಿಷ್ಠತು| ಇತಿ||</para>
</usx>
