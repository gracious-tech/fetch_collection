<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="2TH" style="id">Sanskrit Bible (NT) in Kannada Script (ಸತ್ಯವೇದಃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">2 Thessalonians</para>
  <para style="toc1">೨ ಥಿಷಲನೀಕಿನಃ ಪತ್ರಂ</para>
  <para style="toc2">೨ ಥಿಷಲನೀಕಿನಃ</para>
  <para style="toc3">೨ ಥಿಷಲನೀಕಿನಃ</para>
  <para style="mt1">೨ ಥಿಷಲನೀಕಿನಃ ಪತ್ರಂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಪೌಲಃ ಸಿಲ್ವಾನಸ್ತೀಮಥಿಯಶ್ಚೇತಿನಾಮಾನೋ ವಯಮ್ ಅಸ್ಮದೀಯತಾತಮ್ ಈಶ್ವರಂ ಪ್ರಭುಂ ಯೀಶುಖ್ರೀಷ್ಟಞ್ಚಾಶ್ರಿತಾಂ ಥಿಷಲನೀಕಿನಾಂ ಸಮಿತಿಂ ಪ್ರತಿ ಪತ್ರಂ ಲಿಖಾಮಃ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಅಸ್ಮಾಕಂ ತಾತ ಈಶ್ವರಃ ಪ್ರಭು ರ್ಯೀಶುಖ್ರೀಷ್ಟಶ್ಚ ಯುಷ್ಮಾಸ್ವನುಗ್ರಹಂ ಶಾನ್ತಿಞ್ಚ ಕ್ರಿಯಾಸ್ತಾಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಯುಷ್ಮಾಕಂ ಕೃತೇ ಸರ್ವ್ವದಾ ಯಥಾಯೋಗ್ಯಮ್ ಈಶ್ವರಸ್ಯ ಧನ್ಯವಾದೋ ಽಸ್ಮಾಭಿಃ ಕರ್ತ್ತವ್ಯಃ, ಯತೋ ಹೇತೋ ರ್ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸ ಉತ್ತರೋತ್ತರಂ ವರ್ದ್ಧತೇ ಪರಸ್ಪರಮ್ ಏಕೈಕಸ್ಯ ಪ್ರೇಮ ಚ ಬಹುಫಲಂ ಭವತಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ತಸ್ಮಾದ್ ಯುಷ್ಮಾಭಿ ರ್ಯಾವನ್ತ ಉಪದ್ರವಕ್ಲೇಶಾಃ ಸಹ್ಯನ್ತೇ ತೇಷು ಯದ್ ಧೇैರ್ಯ್ಯಂ ಯಶ್ಚ ವಿಶ್ವಾಸಃ ಪ್ರಕಾಶ್ಯತೇ ತತ್ಕಾರಣಾದ್ ವಯಮ್ ಈಶ್ವರೀಯಸಮಿತಿಷು ಯುಷ್ಮಾಭಿಃ ಶ್ಲಾಘಾಮಹೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ತಚ್ಚೇಶ್ವರಸ್ಯ ನ್ಯಾಯವಿಚಾರಸ್ಯ ಪ್ರಮಾಣಂ ಭವತಿ ಯತೋ ಯೂಯಂ ಯಸ್ಯ ಕೃತೇ ದುಃಖಂ ಸಹಧ್ವಂ ತಸ್ಯೇಶ್ವರೀಯರಾಜ್ಯಸ್ಯ ಯೋಗ್ಯಾ ಭವಥ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಯತಃ ಸ್ವಕೀಯಸ್ವರ್ಗದೂತಾನಾಂ ಬಲೈಃ ಸಹಿತಸ್ಯ ಪ್ರಭೋ ರ್ಯೀಶೋಃ ಸ್ವರ್ಗಾದ್ ಆಗಮನಕಾಲೇ ಯುಷ್ಮಾಕಂ ಕ್ಲೇಶಕೇಭ್ಯಃ ಕ್ಲೇಶೇನ ಫಲದಾನಂ ಸಾರ್ದ್ಧಮಸ್ಮಾಭಿಶ್ಚ</para>
  <para style="p">
    <verse number="7" style="v"/>ಕ್ಲಿಶ್ಯಮಾನೇಭ್ಯೋ ಯುಷ್ಮಭ್ಯಂ ಶಾನ್ತಿದಾನಮ್ ಈಶ್ವರೇಣ ನ್ಯಾಯ್ಯಂ ಭೋತ್ಸ್ಯತೇ;</para>
  <para style="p">
    <verse number="8" style="v"/>ತದಾನೀಮ್ ಈಶ್ವರಾನಭಿಜ್ಞೇಭ್ಯೋ ಽಸ್ಮತ್ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಸುಸಂವಾದಾಗ್ರಾಹಕೇಭ್ಯಶ್ಚ ಲೋಕೇಭ್ಯೋ ಜಾಜ್ವಲ್ಯಮಾನೇನ ವಹ್ನಿನಾ ಸಮುಚಿತಂ ಫಲಂ ಯೀಶುನಾ ದಾಸ್ಯತೇ;</para>
  <para style="p">
    <verse number="9" style="v"/>ತೇ ಚ ಪ್ರಭೋ ರ್ವದನಾತ್ ಪರಾಕ್ರಮಯುಕ್ತವಿಭವಾಚ್ಚ ಸದಾತನವಿನಾಶರೂಪಂ ದಣ್ಡಂ ಲಪ್ಸ್ಯನ್ತೇ,</para>
  <para style="p">
    <verse number="10" style="v"/>ಕಿನ್ತು ತಸ್ಮಿನ್ ದಿನೇ ಸ್ವಕೀಯಪವಿತ್ರಲೋಕೇಷು ವಿರಾಜಿತುಂ ಯುಷ್ಮಾನ್ ಅಪರಾಂಶ್ಚ ಸರ್ವ್ವಾನ್ ವಿಶ್ವಾಸಿಲೋಕಾನ್ ವಿಸ್ಮಾಪಯಿತುಞ್ಚ ಸ ಆಗಮಿಷ್ಯತಿ ಯತೋ ಽಸ್ಮಾಕಂ ಪ್ರಮಾಣೇ ಯುಷ್ಮಾಭಿ ರ್ವಿಶ್ವಾಸೋಽಕಾರಿ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅತೋಽಸ್ಮಾಕಮ್ ಈಶ್ವರೋ ಯುಷ್ಮಾನ್ ತಸ್ಯಾಹ್ವಾನಸ್ಯ ಯೋಗ್ಯಾನ್ ಕರೋತು ಸೌಜನ್ಯಸ್ಯ ಶುಭಫಲಂ ವಿಶ್ವಾಸಸ್ಯ ಗುಣಞ್ಚ ಪರಾಕ್ರಮೇಣ ಸಾಧಯತ್ವಿತಿ ಪ್ರಾರ್ಥನಾಸ್ಮಾಭಿಃ ಸರ್ವ್ವದಾ ಯುಷ್ಮನ್ನಿಮಿತ್ತಂ ಕ್ರಿಯತೇ,</para>
  <para style="p">
    <verse number="12" style="v"/>ಯತಸ್ತಥಾ ಸತ್ಯಸ್ಮಾಕಮ್ ಈಶ್ವರಸ್ಯ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಚಾನುಗ್ರಹಾದ್ ಅಸ್ಮತ್ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ನಾಮ್ನೋ ಗೌರವಂ ಯುಷ್ಮಾಸು ಯುಷ್ಮಾಕಮಪಿ ಗೌರವಂ ತಸ್ಮಿನ್ ಪ್ರಕಾಶಿಷ್ಯತೇ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಅಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯಾಗಮನಂ ತಸ್ಯ ಸಮೀಪೇ ಽಸ್ಮಾಕಂ ಸಂಸ್ಥಿತಿಞ್ಚಾಧಿ ವಯಂ ಯುಷ್ಮಾನ್ ಇದಂ ಪ್ರಾರ್ಥಯಾಮಹೇे,</para>
  <para style="p">
    <verse number="2" style="v"/>ಪ್ರಭೇಸ್ತದ್ ದಿನಂ ಪ್ರಾಯೇಣೋಪಸ್ಥಿತಮ್ ಇತಿ ಯದಿ ಕಶ್ಚಿದ್ ಆತ್ಮನಾ ವಾಚಾ ವಾ ಪತ್ರೇಣ ವಾಸ್ಮಾಕಮ್ ಆದೇಶಂ ಕಲ್ಪಯನ್ ಯುಷ್ಮಾನ್ ಗದತಿ ತರ್ಹಿ ಯೂಯಂ ತೇನ ಚಞ್ಚಲಮನಸ ಉದ್ವಿಗ್ನಾಶ್ಚ ನ ಭವತ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಕೇನಾಪಿ ಪ್ರಕಾರೇಣ ಕೋಽಪಿ ಯುಷ್ಮಾನ್ ನ ವಞ್ಚಯತು ಯತಸ್ತಸ್ಮಾದ್ ದಿನಾತ್ ಪೂರ್ವ್ವಂ ಧರ್ಮ್ಮಲೋಪೇನೋಪಸ್ಯಾತವ್ಯಂ,</para>
  <para style="p">
    <verse number="4" style="v"/>ಯಶ್ಚ ಜನೋ ವಿಪಕ್ಷತಾಂ ಕುರ್ವ್ವನ್ ಸರ್ವ್ವಸ್ಮಾದ್ ದೇವಾತ್ ಪೂಜನೀಯವಸ್ತುಶ್ಚೋನ್ನಂಸ್ಯತೇ ಸ್ವಮ್ ಈಶ್ವರಮಿವ ದರ್ಶಯನ್ ಈಶ್ವರವದ್ ಈಶ್ವರಸ್ಯ ಮನ್ದಿರ ಉಪವೇಕ್ಷ್ಯತಿ ಚ ತೇನ ವಿನಾಶಪಾತ್ರೇಣ ಪಾಪಪುರುಷೇಣೋದೇತವ್ಯಂ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯದಾಹಂ ಯುಷ್ಮಾಕಂ ಸನ್ನಿಧಾವಾಸಂ ತದಾನೀಮ್ ಏತದ್ ಅಕಥಯಮಿತಿ ಯೂಯಂ ಕಿಂ ನ ಸ್ಮರಥ?</para>
  <para style="p">
    <verse number="6" style="v"/>ಸಾಮ್ಪ್ರತಂ ಸ ಯೇನ ನಿವಾರ್ಯ್ಯತೇ ತದ್ ಯೂಯಂ ಜಾನೀಥ, ಕಿನ್ತು ಸ್ವಸಮಯೇ ತೇನೋದೇತವ್ಯಂ|</para>
  <para style="p">
    <verse number="7" style="v"/>ವಿಧರ್ಮ್ಮಸ್ಯ ನಿಗೂಢೋ ಗುಣ ಇದಾನೀಮಪಿ ಫಲತಿ ಕಿನ್ತು ಯಸ್ತಂ ನಿವಾರಯತಿ ಸೋಽದ್ಯಾಪಿ ದೂರೀಕೃತೋ ನಾಭವತ್|</para>
  <para style="p">
    <verse number="8" style="v"/>ತಸ್ಮಿನ್ ದೂರೀಕೃತೇ ಸ ವಿಧರ್ಮ್ಮ್ಯುದೇಷ್ಯತಿ ಕಿನ್ತು ಪ್ರಭು ರ್ಯೀಶುಃ ಸ್ವಮುಖಪವನೇನ ತಂ ವಿಧ್ವಂಸಯಿಷ್ಯತಿ ನಿಜೋಪಸ್ಥಿತೇಸ್ತೇಜಸಾ ವಿನಾಶಯಿಷ್ಯತಿ ಚ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಶಯತಾನಸ್ಯ ಶಕ್ತಿಪ್ರಕಾಶನಾದ್ ವಿನಾಶ್ಯಮಾನಾನಾಂ ಮಧ್ಯೇ ಸರ್ವ್ವವಿಧಾಃ ಪರಾಕ್ರಮಾ ಭ್ರಮಿಕಾ ಆಶ್ಚರ್ಯ್ಯಕ್ರಿಯಾ ಲಕ್ಷಣಾನ್ಯಧರ್ಮ್ಮಜಾತಾ ಸರ್ವ್ವವಿಧಪ್ರತಾರಣಾ ಚ ತಸ್ಯೋಪಸ್ಥಿತೇಃ ಫಲಂ ಭವಿಷ್ಯತಿ;</para>
  <para style="p">
    <verse number="10" style="v"/>ಯತೋ ಹೇತೋಸ್ತೇ ಪರಿತ್ರಾಣಪ್ರಾಪ್ತಯೇ ಸತ್ಯಧರ್ಮ್ಮಸ್ಯಾನುರಾಗಂ ನ ಗೃಹೀತವನ್ತಸ್ತಸ್ಮಾತ್ ಕಾರಣಾದ್</para>
  <para style="p">
    <verse number="11" style="v"/>ಈಶ್ವರೇಣ ತಾನ್ ಪ್ರತಿ ಭ್ರಾನ್ತಿಕರಮಾಯಾಯಾಂ ಪ್ರೇಷಿತಾಯಾಂ ತೇ ಮೃಷಾವಾಕ್ಯೇ ವಿಶ್ವಸಿಷ್ಯನ್ತಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯತೋ ಯಾವನ್ತೋ ಮಾನವಾಃ ಸತ್ಯಧರ್ಮ್ಮೇ ನ ವಿಶ್ವಸ್ಯಾಧರ್ಮ್ಮೇಣ ತುಷ್ಯನ್ತಿ ತೈಃ ಸರ್ವ್ವೈ ರ್ದಣ್ಡಭಾಜನೈ ರ್ಭವಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಹೇ ಪ್ರಭೋಃ ಪ್ರಿಯಾ ಭ್ರಾತರಃ, ಯುಷ್ಮಾಕಂ ಕೃತ ಈಶ್ವರಸ್ಯ ಧನ್ಯವಾದೋಽಸ್ಮಾಭಿಃ ಸರ್ವ್ವದಾ ಕರ್ತ್ತವ್ಯೋ ಯತ ಈಶ್ವರ ಆ ಪ್ರಥಮಾದ್ ಆತ್ಮನಃ ಪಾವನೇನ ಸತ್ಯಧರ್ಮ್ಮೇ ವಿಶ್ವಾಸೇನ ಚ ಪರಿತ್ರಾಣಾರ್ಥಂ ಯುಷ್ಮಾನ್ ವರೀತವಾನ್</para>
  <para style="p">
    <verse number="14" style="v"/>ತದರ್ಥಞ್ಚಾಸ್ಮಾಭಿ ರ್ಘೋಷಿತೇನ ಸುಸಂವಾದೇನ ಯುಷ್ಮಾನ್ ಆಹೂಯಾಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ತೇಜಸೋಽಧಿಕಾರಿಣಃ ಕರಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅತೋ ಹೇ ಭ್ರಾತರಃ ಯೂಯಮ್ ಅಸ್ಮಾಕಂ ವಾಕ್ಯೈಃ ಪತ್ರೈಶ್ಚ ಯಾಂ ಶಿಕ್ಷಾಂ ಲಬ್ಧವನ್ತಸ್ತಾಂ ಕೃತ್ಸ್ನಾಂ ಶಿಕ್ಷಾಂ ಧಾರಯನ್ತಃ ಸುಸ್ಥಿರಾ ಭವತ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಅಸ್ಮಾಕಂ ಪ್ರಭು ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ತಾತ ಈಶ್ವರಶ್ಚಾರ್ಥತೋ ಯೋ ಯುಷ್ಮಾಸು ಪ್ರೇಮ ಕೃತವಾನ್ ನಿತ್ಯಾಞ್ಚ ಸಾನ್ತ್ವನಾಮ್ ಅನುಗ್ರಹೇಣೋತ್ತಮಪ್ರತ್ಯಾಶಾಞ್ಚ ಯುಷ್ಮಭ್ಯಂ ದತ್ತವಾನ್</para>
  <para style="p">
    <verse number="17" style="v"/>ಸ ಸ್ವಯಂ ಯುಷ್ಮಾಕಮ್ ಅನ್ತಃಕರಣಾನಿ ಸಾನ್ತ್ವಯತು ಸರ್ವ್ವಸ್ಮಿನ್ ಸದ್ವಾಕ್ಯೇ ಸತ್ಕರ್ಮ್ಮಣಿ ಚ ಸುಸ್ಥಿರೀಕರೋತು ಚ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಶೇಷೇ ವದಾಮಿ, ಯೂಯಮ್ ಅಸ್ಮಭ್ಯಮಿದಂ ಪ್ರಾರ್ಥಯಧ್ವಂ ಯತ್ ಪ್ರಭೋ ರ್ವಾಕ್ಯಂ ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ಯಥಾ ತಥೈವಾನ್ಯತ್ರಾಪಿ ಪ್ರಚರೇತ್ ಮಾನ್ಯಞ್ಚ ಭವೇತ್;</para>
  <para style="p">
    <verse number="2" style="v"/>ಯಚ್ಚ ವಯಮ್ ಅವಿವೇಚಕೇಭ್ಯೋ ದುಷ್ಟೇಭ್ಯಶ್ಚ ಲೋಕೇಭ್ಯೋ ರಕ್ಷಾಂ ಪ್ರಾಪ್ನುಯಾಮ ಯತಃ ಸರ್ವ್ವೇಷಾಂ ವಿಶ್ವಾಸೋ ನ ಭವತಿ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಕಿನ್ತು ಪ್ರಭು ರ್ವಿಶ್ವಾಸ್ಯಃ ಸ ಏವ ಯುಷ್ಮಾನ್ ಸ್ಥಿರೀಕರಿಷ್ಯತಿ ದುಷ್ಟಸ್ಯ ಕರಾದ್ ಉದ್ಧರಿಷ್ಯತಿ ಚ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಯೂಯಮ್ ಅಸ್ಮಾಭಿ ರ್ಯದ್ ಆದಿಶ್ಯಧ್ವೇ ತತ್ ಕುರುಥ ಕರಿಷ್ಯಥ ಚೇತಿ ವಿಶ್ವಾಸೋ ಯುಷ್ಮಾನಧಿ ಪ್ರಭುನಾಸ್ಮಾಕಂ ಜಾಯತೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಈಶ್ವರಸ್ಯ ಪ್ರೇಮ್ನಿ ಖ್ರೀಷ್ಟಸ್ಯ ಸಹಿಷ್ಣುತಾಯಾಞ್ಚ ಪ್ರಭುಃ ಸ್ವಯಂ ಯುಷ್ಮಾಕಮ್ ಅನ್ತಃಕರಣಾನಿ ವಿನಯತು|</para>
  <para style="p">
    <verse number="6" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಅಸ್ಮತ್ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ನಾಮ್ನಾ ವಯಂ ಯುಷ್ಮಾನ್ ಇದಮ್ ಆದಿಶಾಮಃ, ಅಸ್ಮತ್ತೋ ಯುಷ್ಮಾಭಿ ರ್ಯಾ ಶಿಕ್ಷಲಮ್ಭಿ ತಾಂ ವಿಹಾಯ ಕಶ್ಚಿದ್ ಭ್ರಾತಾ ಯದ್ಯವಿಹಿತಾಚಾರಂ ಕರೋತಿ ತರ್ಹಿ ಯೂಯಂ ತಸ್ಮಾತ್ ಪೃಥಗ್ ಭವತ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯತೋ ವಯಂ ಯುಷ್ಮಾಭಿಃ ಕಥಮ್ ಅನುಕರ್ತ್ತವ್ಯಾಸ್ತದ್ ಯೂಯಂ ಸ್ವಯಂ ಜಾನೀಥ| ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ವಯಮ್ ಅವಿಹಿತಾಚಾರಿಣೋ ನಾಭವಾಮ,</para>
  <para style="p">
    <verse number="8" style="v"/>ವಿನಾಮೂಲ್ಯಂ ಕಸ್ಯಾಪ್ಯನ್ನಂ ನಾಭುಂಜ್ಮಹಿ ಕಿನ್ತು ಕೋಽಪಿ ಯದ್ ಅಸ್ಮಾಭಿ ರ್ಭಾರಗ್ರಸ್ತೋ ನ ಭವೇತ್ ತದರ್ಥಂ ಶ್ರಮೇಣ ಕ್ಲೇಶೇನ ಚ ದಿವಾನಿಶಂ ಕಾರ್ಯ್ಯಮ್ ಅಕುರ್ಮ್ಮ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಅತ್ರಾಸ್ಮಾಕಮ್ ಅಧಿಕಾರೋ ನಾಸ್ತೀತ್ಥಂ ನಹಿ ಕಿನ್ತ್ವಸ್ಮಾಕಮ್ ಅನುಕರಣಾಯ ಯುಷ್ಮಾನ್ ದೃಷ್ಟಾನ್ತಂ ದರ್ಶಯಿತುಮ್ ಇಚ್ಛನ್ತಸ್ತದ್ ಅಕುರ್ಮ್ಮ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯತೋ ಯೇನ ಕಾರ್ಯ್ಯಂ ನ ಕ್ರಿಯತೇ ತೇನಾಹಾರೋಽಪಿ ನ ಕ್ರಿಯತಾಮಿತಿ ವಯಂ ಯುಷ್ಮತ್ಸಮೀಪ ಉಪಸ್ಥಿತಿಕಾಲೇಽಪಿ ಯುಷ್ಮಾನ್ ಆದಿಶಾಮ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಯುಷ್ಮನ್ಮಧ್ಯೇ ಽವಿಹಿತಾಚಾರಿಣಃ ಕೇಽಪಿ ಜನಾ ವಿದ್ಯನ್ತೇ ತೇ ಚ ಕಾರ್ಯ್ಯಮ್ ಅಕುರ್ವ್ವನ್ತ ಆಲಸ್ಯಮ್ ಆಚರನ್ತೀತ್ಯಸ್ಮಾಭಿಃ ಶ್ರೂಯತೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ತಾದೃಶಾನ್ ಲೋಕಾನ್ ಅಸ್ಮತಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ನಾಮ್ನಾ ವಯಮ್ ಇದಮ್ ಆದಿಶಾಮ ಆಜ್ಞಾಪಯಾಮಶ್ಚ, ತೇ ಶಾನ್ತಭಾವೇನ ಕಾರ್ಯ್ಯಂ ಕುರ್ವ್ವನ್ತಃ ಸ್ವಕೀಯಮನ್ನಂ ಭುಞ್ಜತಾಂ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅಪರಂ ಹೇ ಭ್ರಾತರಃ, ಯೂಯಂ ಸದಾಚರಣೇ ನ ಕ್ಲಾಮ್ಯತ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯದಿ ಚ ಕಶ್ಚಿದೇತತ್ಪತ್ರೇ ಲಿಖಿತಾಮ್ ಅಸ್ಮಾಕಮ್ ಆಜ್ಞಾಂ ನ ಗೃಹ್ಲಾತಿ ತರ್ಹಿ ಯೂಯಂ ತಂ ಮಾನುಷಂ ಲಕ್ಷಯತ ತಸ್ಯ ಸಂಸರ್ಗಂ ತ್ಯಜತ ಚ ತೇನ ಸ ತ್ರಪಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಕಿನ್ತು ತಂ ನ ಶತ್ರುಂ ಮನ್ಯಮಾನಾ ಭ್ರಾತರಮಿವ ಚೇತಯತ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಶಾನ್ತಿದಾತಾ ಪ್ರಭುಃ ಸರ್ವ್ವತ್ರ ಸರ್ವ್ವಥಾ ಯುಷ್ಮಭ್ಯಂ ಶಾನ್ತಿಂ ದೇಯಾತ್| ಪ್ರಭು ರ್ಯುಷ್ಮಾಕಂ ಸರ್ವ್ವೇಷಾಂ ಸಙ್ಗೀ ಭೂಯಾತ್|</para>
  <para style="p">
    <verse number="17" style="v"/>ನಮಸ್ಕಾರ ಏಷ ಪೌಲಸ್ಯ ಮಮ ಕರೇಣ ಲಿಖಿತೋಽಭೂತ್ ಸರ್ವ್ವಸ್ಮಿನ್ ಪತ್ರ ಏತನ್ಮಮ ಚಿಹ್ನಮ್ ಏತಾದೃಶೈರಕ್ಷರೈ ರ್ಮಯಾ ಲಿಖ್ಯತೇ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಅಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯಾನುुಗ್ರಹಃ ಸರ್ವ್ವೇಷು ಯುಷ್ಮಾಸು ಭೂಯಾತ್| ಆಮೇನ್|</para>
</usx>
