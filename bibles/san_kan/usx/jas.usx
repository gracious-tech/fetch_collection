<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="JAS" style="id">Sanskrit Bible (NT) in Kannada Script (ಸತ್ಯವೇದಃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">James</para>
  <para style="toc1">ಯಾಕೂಬಃ ಪತ್ರಂ</para>
  <para style="toc2">ಯಾಕೂಬಃ</para>
  <para style="toc3">ಯಾಕೂಬಃ</para>
  <para style="mt1">ಯಾಕೂಬಃ ಪತ್ರಂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಈಶ್ವರಸ್ಯ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಚ ದಾಸೋ ಯಾಕೂಬ್ ವಿಕೀರ್ಣೀಭೂತಾನ್ ದ್ವಾದಶಂ ವಂಶಾನ್ ಪ್ರತಿ ನಮಸ್ಕೃತ್ಯ ಪತ್ರಂ ಲಿಖತಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಹೇ ಮಮ ಭ್ರಾತರಃ, ಯೂಯಂ ಯದಾ ಬಹುವಿಧಪರೀಕ್ಷಾಷು ನಿಪತತ ತದಾ ತತ್ ಪೂರ್ಣಾನನ್ದಸ್ಯ ಕಾರಣಂ ಮನ್ಯಧ್ವಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಯತೋ ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸಸ್ಯ ಪರೀಕ್ಷಿತತ್ವೇನ ಧೈರ್ಯ್ಯಂ ಸಮ್ಪಾದ್ಯತ ಇತಿ ಜಾನೀಥ|</para>
  <para style="p">
    <verse number="4" style="v"/>ತಚ್ಚ ಧೈರ್ಯ್ಯಂ ಸಿದ್ಧಫಲಂ ಭವತು ತೇನ ಯೂಯಂ ಸಿದ್ಧಾಃ ಸಮ್ಪೂರ್ಣಾಶ್ಚ ಭವಿಷ್ಯಥ ಕಸ್ಯಾಪಿ ಗುಣಸ್ಯಾಭಾವಶ್ಚ ಯುಷ್ಮಾಕಂ ನ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯುಷ್ಮಾಕಂ ಕಸ್ಯಾಪಿ ಜ್ಞಾನಾಭಾವೋ ಯದಿ ಭವೇತ್ ತರ್ಹಿ ಯ ಈಶ್ವರಃ ಸರಲಭಾವೇನ ತಿರಸ್ಕಾರಞ್ಚ ವಿನಾ ಸರ್ವ್ವೇಭ್ಯೋ ದದಾತಿ ತತಃ ಸ ಯಾಚತಾಂ ತತಸ್ತಸ್ಮೈ ದಾಯಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಕಿನ್ತು ಸ ನಿಃಸನ್ದೇಹಃ ಸನ್ ವಿಶ್ವಾಸೇನ ಯಾಚತಾಂ ಯತಃ ಸನ್ದಿಗ್ಧೋ ಮಾನವೋ ವಾಯುನಾ ಚಾಲಿತಸ್ಯೋತ್ಪ್ಲವಮಾನಸ್ಯ ಚ ಸಮುದ್ರತರಙ್ಗಸ್ಯ ಸದೃಶೋ ಭವತಿ|</para>
  <para style="p">
    <verse number="7" style="v"/>ತಾದೃಶೋ ಮಾನವಃ ಪ್ರಭೋಃ ಕಿಞ್ಚಿತ್ ಪ್ರಾಪ್ಸ್ಯತೀತಿ ನ ಮನ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="8" style="v"/>ದ್ವಿಮನಾ ಲೋಕಃ ಸರ್ವ್ವಗತಿಷು ಚಞ್ಚಲೋ ಭವತಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಯೋ ಭ್ರಾತಾ ನಮ್ರಃ ಸ ನಿಜೋನ್ನತ್ಯಾ ಶ್ಲಾಘತಾಂ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯಶ್ಚ ಧನವಾನ್ ಸ ನಿಜನಮ್ರತಯಾ ಶ್ಲಾಘತಾಂಯತಃ ಸ ತೃಣಪುಷ್ಪವತ್ ಕ್ಷಯಂ ಗಮಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಯತಃ ಸತಾಪೇನ ಸೂರ್ಯ್ಯೇಣೋದಿತ್ಯ ತೃಣಂ ಶೋಷ್ಯತೇ ತತ್ಪುಷ್ಪಞ್ಚ ಭ್ರಶ್ಯತಿ ತೇನ ತಸ್ಯ ರೂಪಸ್ಯ ಸೌನ್ದರ್ಯ್ಯಂ ನಶ್ಯತಿ ತದ್ವದ್ ಧನಿಲೋಕೋಽಪಿ ಸ್ವೀಯಮೂಢತಯಾ ಮ್ಲಾಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯೋ ಜನಃ ಪರೀಕ್ಷಾಂ ಸಹತೇ ಸ ಏವ ಧನ್ಯಃ, ಯತಃ ಪರೀಕ್ಷಿತತ್ವಂ ಪ್ರಾಪ್ಯ ಸ ಪ್ರಭುನಾ ಸ್ವಪ್ರೇಮಕಾರಿಭ್ಯಃ ಪ್ರತಿಜ್ಞಾತಂ ಜೀವನಮುಕುಟಂ ಲಪ್ಸ್ಯತೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಈಶ್ವರೋ ಮಾಂ ಪರೀಕ್ಷತ ಇತಿ ಪರೀಕ್ಷಾಸಮಯೇ ಕೋಽಪಿ ನ ವದತು ಯತಃ ಪಾಪಾಯೇಶ್ವರಸ್ಯ ಪರೀಕ್ಷಾ ನ ಭವತಿ ಸ ಚ ಕಮಪಿ ನ ಪರೀಕ್ಷತೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಕಿನ್ತು ಯಃ ಕಶ್ಚಿತ್ ಸ್ವೀಯಮನೋವಾಞ್ಛಯಾಕೃಷ್ಯತೇ ಲೋಭ್ಯತೇ ಚ ತಸ್ಯೈವ ಪರೀಕ್ಷಾ ಭವತಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತಸ್ಮಾತ್ ಸಾ ಮನೋವಾಞ್ಛಾ ಸಗರ್ಭಾ ಭೂತ್ವಾ ದುಷ್ಕೃತಿಂ ಪ್ರಸೂತೇ ದುಷ್ಕೃತಿಶ್ಚ ಪರಿಣಾಮಂ ಗತ್ವಾ ಮೃತ್ಯುಂ ಜನಯತಿ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಹೇ ಮಮ ಪ್ರಿಯಭ್ರಾತರಃ, ಯೂಯಂ ನ ಭ್ರಾಮ್ಯತ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಯತ್ ಕಿಞ್ಚಿದ್ ಉತ್ತಮಂ ದಾನಂ ಪೂರ್ಣೋ ವರಶ್ಚ ತತ್ ಸರ್ವ್ವಮ್ ಊರ್ದ್ಧ್ವಾದ್ ಅರ್ಥತೋ ಯಸ್ಮಿನ್ ದಶಾನ್ತರಂ ಪರಿವರ್ತ್ತನಜಾತಚ್ಛಾಯಾ ವಾ ನಾಸ್ತಿ ತಸ್ಮಾದ್ ದೀಪ್ತ್ಯಾಕರಾತ್ ಪಿತುರವರೋಹತಿ|</para>
  <para style="p">
    <verse number="18" style="v"/>ತಸ್ಯ ಸೃಷ್ಟವಸ್ತೂನಾಂ ಮಧ್ಯೇ ವಯಂ ಯತ್ ಪ್ರಥಮಫಲಸ್ವರೂಪಾ ಭವಾಮಸ್ತದರ್ಥಂ ಸ ಸ್ವೇಚ್ಛಾತಃ ಸತ್ಯಮತಸ್ಯ ವಾಕ್ಯೇನಾಸ್ಮಾನ್ ಜನಯಾಮಾಸ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಅತಏವ ಹೇ ಮಮ ಪ್ರಿಯಭ್ರಾತರಃ, ಯುಷ್ಮಾಕಮ್ ಏಕೈಕೋ ಜನಃ ಶ್ರವಣೇ ತ್ವರಿತಃ ಕಥನೇ ಧೀರಃ ಕ್ರೋಧೇಽಪಿ ಧೀರೋ ಭವತು|</para>
  <para style="p">
    <verse number="20" style="v"/>ಯತೋ ಮಾನವಸ್ಯ ಕ್ರೋಧ ಈಶ್ವರೀಯಧರ್ಮ್ಮಂ ನ ಸಾಧಯತಿ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಅತೋ ಹೇತೋ ರ್ಯೂಯಂ ಸರ್ವ್ವಾಮ್ ಅಶುಚಿಕ್ರಿಯಾಂ ದುಷ್ಟತಾಬಾಹುಲ್ಯಞ್ಚ ನಿಕ್ಷಿಪ್ಯ ಯುಷ್ಮನ್ಮನಸಾಂ ಪರಿತ್ರಾಣೇ ಸಮರ್ಥಂ ರೋಪಿತಂ ವಾಕ್ಯಂ ನಮ್ರಭಾವೇನ ಗೃಹ್ಲೀತ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಅಪರಞ್ಚ ಯೂಯಂ ಕೇವಲಮ್ ಆತ್ಮವಞ್ಚಯಿತಾರೋ ವಾಕ್ಯಸ್ಯ ಶ್ರೋತಾರೋ ನ ಭವತ ಕಿನ್ತು ವಾಕ್ಯಸ್ಯ ಕರ್ಮ್ಮಕಾರಿಣೋ ಭವತ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಯತೋ ಯಃ ಕಶ್ಚಿದ್ ವಾಕ್ಯಸ್ಯ ಕರ್ಮ್ಮಕಾರೀ ನ ಭೂತ್ವಾ ಕೇವಲಂ ತಸ್ಯ ಶ್ರೋತಾ ಭವತಿ ಸ ದರ್ಪಣೇ ಸ್ವೀಯಶಾರೀರಿಕವದನಂ ನಿರೀಕ್ಷಮಾಣಸ್ಯ ಮನುಜಸ್ಯ ಸದೃಶಃ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಆತ್ಮಾಕಾರೇ ದೃಷ್ಟೇ ಸ ಪ್ರಸ್ಥಾಯ ಕೀದೃಶ ಆಸೀತ್ ತತ್ ತತ್ಕ್ಷಣಾದ್ ವಿಸ್ಮರತಿ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಕಿನ್ತು ಯಃ ಕಶ್ಚಿತ್ ನತ್ವಾ ಮುಕ್ತೇಃ ಸಿದ್ಧಾಂ ವ್ಯವಸ್ಥಾಮ್ ಆಲೋಕ್ಯ ತಿಷ್ಠತಿ ಸ ವಿಸ್ಮೃತಿಯುಕ್ತಃ ಶ್ರೋತಾ ನ ಭೂತ್ವಾ ಕರ್ಮ್ಮಕರ್ತ್ತೈವ ಸನ್ ಸ್ವಕಾರ್ಯ್ಯೇ ಧನ್ಯೋ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="26" style="v"/>ಅನಾಯತ್ತರಸನಃ ಸನ್ ಯಃ ಕಶ್ಚಿತ್ ಸ್ವಮನೋ ವಞ್ಚಯಿತ್ವಾ ಸ್ವಂ ಭಕ್ತಂ ಮನ್ಯತೇ ತಸ್ಯ ಭಕ್ತಿ ರ್ಮುಧಾ ಭವತಿ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಕ್ಲೇಶಕಾಲೇ ಪಿತೃಹೀನಾನಾಂ ವಿಧವಾನಾಞ್ಚ ಯದ್ ಅವೇಕ್ಷಣಂ ಸಂಸಾರಾಚ್ಚ ನಿಷ್ಕಲಙ್ಕೇನ ಯದ್ ಆತ್ಮರಕ್ಷಣಂ ತದೇವ ಪಿತುರೀಶ್ವರಸ್ಯ ಸಾಕ್ಷಾತ್ ಶುಚಿ ರ್ನಿರ್ಮ್ಮಲಾ ಚ ಭಕ್ತಿಃ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಮಮ ಭ್ರಾತರಃ, ಯೂಯಮ್ ಅಸ್ಮಾಕಂ ತೇಜಸ್ವಿನಃ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಧರ್ಮ್ಮಂ ಮುಖಾಪೇಕ್ಷಯಾ ನ ಧಾರಯತ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯತೋ ಯುಷ್ಮಾಕಂ ಸಭಾಯಾಂ ಸ್ವರ್ಣಾಙ್ಗುರೀಯಕಯುಕ್ತೇ ಭ್ರಾಜಿಷ್ಣುಪರಿಚ್ಛದೇ ಪುರುಷೇ ಪ್ರವಿಷ್ಟೇ ಮಲಿನವಸ್ತ್ರೇ ಕಸ್ಮಿಂಶ್ಚಿದ್ ದರಿದ್ರೇಽಪಿ ಪ್ರವಿಷ್ಟೇ</para>
  <para style="p">
    <verse number="3" style="v"/>ಯೂಯಂ ಯದಿ ತಂ ಭ್ರಾಜಿಷ್ಣುಪರಿಚ್ಛದವಸಾನಂ ಜನಂ ನಿರೀಕ್ಷ್ಯ ವದೇತ ಭವಾನ್ ಅತ್ರೋತ್ತಮಸ್ಥಾನ ಉಪವಿಶತ್ವಿತಿ ಕಿಞ್ಚ ತಂ ದರಿದ್ರಂ ಯದಿ ವದೇತ ತ್ವಮ್ ಅಮುಸ್ಮಿನ್ ಸ್ಥಾನೇ ತಿಷ್ಠ ಯದ್ವಾತ್ರ ಮಮ ಪಾದಪೀಠ ಉಪವಿಶೇತಿ,</para>
  <para style="p">
    <verse number="4" style="v"/>ತರ್ಹಿ ಮನಃಸು ವಿಶೇಷ್ಯ ಯೂಯಂ ಕಿಂ ಕುತರ್ಕೈಃ ಕುವಿಚಾರಕಾ ನ ಭವಥ?</para>
  <para style="p">
    <verse number="5" style="v"/>ಹೇ ಮಮ ಪ್ರಿಯಭ್ರಾತರಃ, ಶೃಣುತ, ಸಂಸಾರೇ ಯೇ ದರಿದ್ರಾಸ್ತಾನ್ ಈಶ್ವರೋ ವಿಶ್ವಾಸೇನ ಧನಿನಃ ಸ್ವಪ್ರೇಮಕಾರಿಭ್ಯಶ್ಚ ಪ್ರತಿಶ್ರುತಸ್ಯ ರಾಜ್ಯಸ್ಯಾಧಿಕಾರಿಣಃ ಕರ್ತ್ತುಂ ಕಿಂ ನ ವರೀತವಾನ್? ಕಿನ್ತು ದರಿದ್ರೋ ಯುಷ್ಮಾಭಿರವಜ್ಞಾಯತೇ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಧನವನ್ತ ಏವ ಕಿಂ ಯುಷ್ಮಾನ್ ನೋಪದ್ರವನ್ತಿ ಬಲಾಚ್ಚ ವಿಚಾರಾಸನಾನಾಂ ಸಮೀಪಂ ನ ನಯನ್ತಿ?</para>
  <para style="p">
    <verse number="7" style="v"/>ಯುಷ್ಮದುಪರಿ ಪರಿಕೀರ್ತ್ತಿತಂ ಪರಮಂ ನಾಮ ಕಿಂ ತೈರೇವ ನ ನಿನ್ದ್ಯತೇ?</para>
  <para style="p">
    <verse number="8" style="v"/>ಕಿಞ್ಚ ತ್ವಂ ಸ್ವಸಮೀಪವಾಸಿನಿ ಸ್ವಾತ್ಮವತ್ ಪ್ರೀಯಸ್ವ, ಏತಚ್ಛಾಸ್ತ್ರೀಯವಚನಾನುಸಾರತೋ ಯದಿ ಯೂಯಂ ರಾಜಕೀಯವ್ಯವಸ್ಥಾಂ ಪಾಲಯಥ ತರ್ಹಿ ಭದ್ರಂ ಕುರುಥ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಯದಿ ಚ ಮುಖಾಪೇಕ್ಷಾಂ ಕುರುಥ ತರ್ಹಿ ಪಾಪಮ್ ಆಚರಥ ವ್ಯವಸ್ಥಯಾ ಚಾಜ್ಞಾಲಙ್ಘಿನ ಇವ ದೂಷ್ಯಧ್ವೇ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯತೋ ಯಃ ಕಶ್ಚಿತ್ ಕೃತ್ಸ್ನಾಂ ವ್ಯವಸ್ಥಾಂ ಪಾಲಯತಿ ಸ ಯದ್ಯೇಕಸ್ಮಿನ್ ವಿಧೌ ಸ್ಖಲತಿ ತರ್ಹಿ ಸರ್ವ್ವೇಷಾಮ್ ಅಪರಾಧೀ ಭವತಿ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಯತೋ ಹೇತೋಸ್ತ್ವಂ ಪರದಾರಾನ್ ಮಾ ಗಚ್ಛೇತಿ ಯಃ ಕಥಿತವಾನ್ ಸ ಏವ ನರಹತ್ಯಾಂ ಮಾ ಕುರ್ಯ್ಯಾ ಇತ್ಯಪಿ ಕಥಿತವಾನ್ ತಸ್ಮಾತ್ ತ್ವಂ ಪರದಾರಾನ್ ನ ಗತ್ವಾ ಯದಿ ನರಹತ್ಯಾಂ ಕರೋಷಿ ತರ್ಹಿ ವ್ಯವಸ್ಥಾಲಙ್ಘೀ ಭವಸಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಮುಕ್ತೇ ರ್ವ್ಯವಸ್ಥಾತೋ ಯೇಷಾಂ ವಿಚಾರೇಣ ಭವಿತವ್ಯಂ ತಾದೃಶಾ ಲೋಕಾ ಇವ ಯೂಯಂ ಕಥಾಂ ಕಥಯತ ಕರ್ಮ್ಮ ಕುರುತ ಚ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯೋ ದಯಾಂ ನಾಚರತಿ ತಸ್ಯ ವಿಚಾರೋ ನಿರ್ದ್ದಯೇನ ಕಾರಿಷ್ಯತೇ, ಕಿನ್ತು ದಯಾ ವಿಚಾರಮ್ ಅಭಿಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಹೇ ಮಮ ಭ್ರಾತರಃ, ಮಮ ಪ್ರತ್ಯಯೋಽಸ್ತೀತಿ ಯಃ ಕಥಯತಿ ತಸ್ಯ ಕರ್ಮ್ಮಾಣಿ ಯದಿ ನ ವಿದ್ಯನ್ತ ತರ್ಹಿ ತೇನ ಕಿಂ ಫಲಂ? ತೇನ ಪ್ರತ್ಯಯೇನ ಕಿಂ ತಸ್ಯ ಪರಿತ್ರಾಣಂ ಭವಿತುಂ ಶಕ್ನೋತಿ?</para>
  <para style="p">
    <verse number="15" style="v"/>ಕೇಷುಚಿದ್ ಭ್ರಾತೃಷು ಭಗಿನೀಷು ವಾ ವಸನಹೀನೇಷು ಪ್ರಾತ್ಯಹಿಕಾಹಾರಹೀನೇಷು ಚ ಸತ್ಸು ಯುಷ್ಮಾಕಂ ಕೋಽಪಿ ತೇಭ್ಯಃ ಶರೀರಾರ್ಥಂ ಪ್ರಯೋಜನೀಯಾನಿ ದ್ರವ್ಯಾಣಿ ನ ದತ್ವಾ ಯದಿ ತಾನ್ ವದೇತ್,</para>
  <para style="p">
    <verse number="16" style="v"/>ಯೂಯಂ ಸಕುಶಲಂ ಗತ್ವೋಷ್ಣಗಾತ್ರಾ ಭವತ ತೃಪ್ಯತ ಚೇತಿ ತರ್ಹ್ಯೇತೇನ ಕಿಂ ಫಲಂ?</para>
  <para style="p">
    <verse number="17" style="v"/>ತದ್ವತ್ ಪ್ರತ್ಯಯೋ ಯದಿ ಕರ್ಮ್ಮಭಿ ರ್ಯುಕ್ತೋ ನ ಭವೇತ್ ತರ್ಹ್ಯೇಕಾಕಿತ್ವಾತ್ ಮೃತ ಏವಾಸ್ತೇ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಕಿಞ್ಚ ಕಶ್ಚಿದ್ ಇದಂ ವದಿಷ್ಯತಿ ತವ ಪ್ರತ್ಯಯೋ ವಿದ್ಯತೇ ಮಮ ಚ ಕರ್ಮ್ಮಾಣಿ ವಿದ್ಯನ್ತೇ, ತ್ವಂ ಕರ್ಮ್ಮಹೀನಂ ಸ್ವಪ್ರತ್ಯಯಂ ಮಾಂ ದರ್ಶಯ ತರ್ಹ್ಯಹಮಪಿ ಮತ್ಕರ್ಮ್ಮಭ್ಯಃ ಸ್ವಪ್ರತ್ಯಯಂ ತ್ವಾಂ ದರ್ಶಯಿಷ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಏಕ ಈಶ್ವರೋ ಽಸ್ತೀತಿ ತ್ವಂ ಪ್ರತ್ಯೇಷಿ| ಭದ್ರಂ ಕರೋಷಿ| ಭೂತಾ ಅಪಿ ತತ್ ಪ್ರತಿಯನ್ತಿ ಕಮ್ಪನ್ತೇ ಚ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಕಿನ್ತು ಹೇ ನಿರ್ಬ್ಬೋಧಮಾನವ, ಕರ್ಮ್ಮಹೀನಃ ಪ್ರತ್ಯಯೋ ಮೃತ ಏವಾಸ್ತ್ಯೇತದ್ ಅವಗನ್ತುಂ ಕಿಮ್ ಇಚ್ಛಸಿ?</para>
  <para style="p">
    <verse number="21" style="v"/>ಅಸ್ಮಾಕಂ ಪೂರ್ವ್ವಪುರುಷೋ ಯ ಇಬ್ರಾಹೀಮ್ ಸ್ವಪುತ್ರಮ್ ಇಸ್ಹಾಕಂ ಯಜ್ಞವೇದ್ಯಾಮ್ ಉತ್ಸೃಷ್ಟವಾನ್ ಸ ಕಿಂ ಕರ್ಮ್ಮಭ್ಯೋ ನ ಸಪುಣ್ಯೀಕೃತಃ?</para>
  <para style="p">
    <verse number="22" style="v"/>ಪ್ರತ್ಯಯೇ ತಸ್ಯ ಕರ್ಮ್ಮಣಾಂ ಸಹಕಾರಿಣಿ ಜಾತೇ ಕರ್ಮ್ಮಭಿಃ ಪ್ರತ್ಯಯಃ ಸಿದ್ಧೋ ಽಭವತ್ ತತ್ ಕಿಂ ಪಶ್ಯಸಿ?</para>
  <para style="p">
    <verse number="23" style="v"/>ಇತ್ಥಞ್ಚೇದಂ ಶಾಸ್ತ್ರೀಯವಚನಂ ಸಫಲಮ್ ಅಭವತ್, ಇಬ್ರಾಹೀಮ್ ಪರಮೇಶ್ವರೇ ವಿಶ್ವಸಿತವಾನ್ ತಚ್ಚ ತಸ್ಯ ಪುಣ್ಯಾಯಾಗಣ್ಯತ ಸ ಚೇಶ್ವರಸ್ಯ ಮಿತ್ರ ಇತಿ ನಾಮ ಲಬ್ಧವಾನ್|</para>
  <para style="p">
    <verse number="24" style="v"/>ಪಶ್ಯತ ಮಾನವಃ ಕರ್ಮ್ಮಭ್ಯಃ ಸಪುಣ್ಯೀಕ್ರಿಯತೇ ನ ಚೈಕಾಕಿನಾ ಪ್ರತ್ಯಯೇನ|</para>
  <para style="p">
    <verse number="25" style="v"/>ತದ್ವದ್ ಯಾ ರಾಹಬ್ನಾಮಿಕಾ ವಾರಾಙ್ಗನಾ ಚಾರಾನ್ ಅನುಗೃಹ್ಯಾಪರೇಣ ಮಾರ್ಗೇಣ ವಿಸಸರ್ಜ ಸಾಪಿ ಕಿಂ ಕರ್ಮ್ಮಭ್ಯೋ ನ ಸಪುಣ್ಯೀಕೃತಾ?</para>
  <para style="p">
    <verse number="26" style="v"/>ಅತಏವಾತ್ಮಹೀನೋ ದೇಹೋ ಯಥಾ ಮೃತೋಽಸ್ತಿ ತಥೈವ ಕರ್ಮ್ಮಹೀನಃ ಪ್ರತ್ಯಯೋಽಪಿ ಮೃತೋಽಸ್ತಿ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಮಮ ಭ್ರಾತರಃ, ಶಿಕ್ಷಕೈರಸ್ಮಾಭಿ ರ್ಗುರುತರದಣ್ಡೋ ಲಪ್ಸ್ಯತ ಇತಿ ಜ್ಞಾತ್ವಾ ಯೂಯಮ್ ಅನೇಕೇ ಶಿಕ್ಷಕಾ ಮಾ ಭವತ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯತಃ ಸರ್ವ್ವೇ ವಯಂ ಬಹುವಿಷಯೇಷು ಸ್ಖಲಾಮಃ, ಯಃ ಕಶ್ಚಿದ್ ವಾಕ್ಯೇ ನ ಸ್ಖಲತಿ ಸ ಸಿದ್ಧಪುರುಷಃ ಕೃತ್ಸ್ನಂ ವಶೀಕರ್ತ್ತುಂ ಸಮರ್ಥಶ್ಚಾಸ್ತಿ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಪಶ್ಯತ ವಯಮ್ ಅಶ್ವಾನ್ ವಶೀಕರ್ತ್ತುಂ ತೇಷಾಂ ವಕ್ತ್ರೇಷು ಖಲೀನಾನ್ ನಿಧಾಯ ತೇಷಾಂ ಕೃತ್ಸ್ನಂ ಶರೀರಮ್ ಅನುವರ್ತ್ತಯಾಮಃ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಪಶ್ಯತ ಯೇ ಪೋತಾ ಅತೀವ ಬೃಹದಾಕಾರಾಃ ಪ್ರಚಣ್ಡವಾತೈಶ್ಚ ಚಾಲಿತಾಸ್ತೇಽಪಿ ಕರ್ಣಧಾರಸ್ಯ ಮನೋಽಭಿಮತಾದ್ ಅತಿಕ್ಷುದ್ರೇಣ ಕರ್ಣೇನ ವಾಞ್ಛಿತಂ ಸ್ಥಾನಂ ಪ್ರತ್ಯನುವರ್ತ್ತನ್ತೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ತದ್ವದ್ ರಸನಾಪಿ ಕ್ಷುದ್ರತರಾಙ್ಗಂ ಸನ್ತೀ ದರ್ಪವಾಕ್ಯಾನಿ ಭಾಷತೇ| ಪಶ್ಯ ಕೀದೃಙ್ಮಹಾರಣ್ಯಂ ದಹ್ಯತೇ ಽಲ್ಪೇನ ವಹ್ನಿನಾ|</para>
  <para style="p">
    <verse number="6" style="v"/>ರಸನಾಪಿ ಭವೇದ್ ವಹ್ನಿರಧರ್ಮ್ಮರೂಪಪಿಷ್ಟಪೇ| ಅಸ್ಮದಙ್ಗೇಷು ರಸನಾ ತಾದೃಶಂ ಸನ್ತಿಷ್ಠತಿ ಸಾ ಕೃತ್ಸ್ನಂ ದೇಹಂ ಕಲಙ್ಕಯತಿ ಸೃಷ್ಟಿರಥಸ್ಯ ಚಕ್ರಂ ಪ್ರಜ್ವಲಯತಿ ನರಕಾನಲೇನ ಜ್ವಲತಿ ಚ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಪಶುಪಕ್ಷ್ಯುರೋಗಜಲಚರಾಣಾಂ ಸರ್ವ್ವೇಷಾಂ ಸ್ವಭಾವೋ ದಮಯಿತುಂ ಶಕ್ಯತೇ ಮಾನುಷಿಕಸ್ವಭಾವೇನ ದಮಯಾಞ್ಚಕ್ರೇ ಚ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಕಿನ್ತು ಮಾನವಾನಾಂ ಕೇನಾಪಿ ಜಿಹ್ವಾ ದಮಯಿತುಂ ನ ಶಕ್ಯತೇ ಸಾ ನ ನಿವಾರ್ಯ್ಯಮ್ ಅನಿಷ್ಟಂ ಹಲಾಹಲವಿಷೇಣ ಪೂರ್ಣಾ ಚ|</para>
  <para style="p">
    <verse number="9" style="v"/>ತಯಾ ವಯಂ ಪಿತರಮ್ ಈಶ್ವರಂ ಧನ್ಯಂ ವದಾಮಃ, ತಯಾ ಚೇಶ್ವರಸ್ಯ ಸಾದೃಶ್ಯೇ ಸೃಷ್ಟಾನ್ ಮಾನವಾನ್ ಶಪಾಮಃ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಏಕಸ್ಮಾದ್ ವದನಾದ್ ಧನ್ಯವಾದಶಾಪೌ ನಿರ್ಗಚ್ಛತಃ| ಹೇ ಮಮ ಭ್ರಾತರಃ, ಏತಾದೃಶಂ ನ ಕರ್ತ್ತವ್ಯಂ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಪ್ರಸ್ರವಣಃ ಕಿಮ್ ಏಕಸ್ಮಾತ್ ಛಿದ್ರಾತ್ ಮಿಷ್ಟಂ ತಿಕ್ತಞ್ಚ ತೋಯಂ ನಿರ್ಗಮಯತಿ?</para>
  <para style="p">
    <verse number="12" style="v"/>ಹೇ ಮಮ ಭ್ರಾತರಃ, ಉಡುಮ್ಬರತರುಃ ಕಿಂ ಜಿತಫಲಾನಿ ದ್ರಾಕ್ಷಾಲತಾ ವಾ ಕಿಮ್ ಉಡುಮ್ಬರಫಲಾನಿ ಫಲಿತುಂ ಶಕ್ನೋತಿ? ತದ್ವದ್ ಏಕಃ ಪ್ರಸ್ರವಣೋ ಲವಣಮಿಷ್ಟೇ ತೋಯೇ ನಿರ್ಗಮಯಿತುಂ ನ ಶಕ್ನೋತಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ಜ್ಞಾನೀ ಸುಬೋಧಶ್ಚ ಕ ಆಸ್ತೇ? ತಸ್ಯ ಕರ್ಮ್ಮಾಣಿ ಜ್ಞಾನಮೂಲಕಮೃದುತಾಯುಕ್ತಾನೀತಿ ಸದಾಚಾರಾತ್ ಸ ಪ್ರಮಾಣಯತು|</para>
  <para style="p">
    <verse number="14" style="v"/>ಕಿನ್ತು ಯುಷ್ಮದನ್ತಃಕರಣಮಧ್ಯೇ ಯದಿ ತಿಕ್ತೇರ್ಷ್ಯಾ ವಿವಾದೇಚ್ಛಾ ಚ ವಿದ್ಯತೇ ತರ್ಹಿ ಸತ್ಯಮತಸ್ಯ ವಿರುದ್ಧಂ ನ ಶ್ಲಾಘಧ್ವಂ ನಚಾನೃತಂ ಕಥಯತ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತಾದೃಶಂ ಜ್ಞಾನಮ್ ಊರ್ದ್ಧ್ವಾದ್ ಆಗತಂ ನಹಿ ಕಿನ್ತು ಪಾರ್ಥಿವಂ ಶರೀರಿ ಭೌತಿಕಞ್ಚ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯತೋ ಹೇತೋರೀರ್ಷ್ಯಾ ವಿವಾದೇಚ್ಛಾ ಚ ಯತ್ರ ವೇದ್ಯೇತೇ ತತ್ರೈವ ಕಲಹಃ ಸರ್ವ್ವಂ ದುಷ್ಕೃತಞ್ಚ ವಿದ್ಯತೇ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಕಿನ್ತೂರ್ದ್ಧ್ವಾದ್ ಆಗತಂ ಯತ್ ಜ್ಞಾನಂ ತತ್ ಪ್ರಥಮಂ ಶುಚಿ ತತಃ ಪರಂ ಶಾನ್ತಂ ಕ್ಷಾನ್ತಮ್ ಆಶುಸನ್ಧೇಯಂ ದಯಾದಿಸತ್ಫಲೈಃ ಪರಿಪೂರ್ಣಮ್ ಅಸನ್ದಿಗ್ಧಂ ನಿಷ್ಕಪಟಞ್ಚ ಭವತಿ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಶಾನ್ತ್ಯಾಚಾರಿಭಿಃ ಶಾನ್ತ್ಯಾ ಧರ್ಮ್ಮಫಲಂ ರೋಪ್ಯತೇ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ಸಮರಾ ರಣಶ್ಚ ಕುತ ಉತ್ಪದ್ಯನ್ತೇ? ಯುಷ್ಮದಙ್ಗಶಿಬಿರಾಶ್ರಿತಾಭ್ಯಃ ಸುಖೇಚ್ಛಾಭ್ಯಃ ಕಿಂ ನೋತ್ಪದ್ಯನ್ತೇे?</para>
  <para style="p">
    <verse number="2" style="v"/>ಯೂಯಂ ವಾಞ್ಛಥ ಕಿನ್ತು ನಾಪ್ನುಥ, ಯೂಯಂ ನರಹತ್ಯಾಮ್ ಈರ್ಷ್ಯಾಞ್ಚ ಕುರುಥ ಕಿನ್ತು ಕೃತಾರ್ಥಾ ಭವಿತುಂ ನ ಶಕ್ನುಥ, ಯೂಯಂ ಯುಧ್ಯಥ ರಣಂ ಕುರುಥ ಚ ಕಿನ್ತ್ವಪ್ರಾಪ್ತಾಸ್ತಿಷ್ಠಥ, ಯತೋ ಹೇತೋಃ ಪ್ರಾರ್ಥನಾಂ ನ ಕುರುಥ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಯೂಯಂ ಪ್ರಾರ್ಥಯಧ್ವೇ ಕಿನ್ತು ನ ಲಭಧ್ವೇ ಯತೋ ಹೇತೋಃ ಸ್ವಸುಖಭೋಗೇಷು ವ್ಯಯಾರ್ಥಂ ಕು ಪ್ರಾರ್ಥಯಧ್ವೇ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಹೇ ವ್ಯಭಿಚಾರಿಣೋ ವ್ಯಭಿಚಾರಿಣ್ಯಶ್ಚ, ಸಂಸಾರಸ್ಯ ಯತ್ ಮೈತ್ರ್ಯಂ ತದ್ ಈಶ್ವರಸ್ಯ ಶಾತ್ರವಮಿತಿ ಯೂಯಂ ಕಿಂ ನ ಜಾನೀಥ? ಅತ ಏವ ಯಃ ಕಶ್ಚಿತ್ ಸಂಸಾರಸ್ಯ ಮಿತ್ರಂ ಭವಿತುಮ್ ಅಭಿಲಷತಿ ಸ ಏವೇಶ್ವರಸ್ಯ ಶತ್ರು ರ್ಭವತಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯೂಯಂ ಕಿಂ ಮನ್ಯಧ್ವೇ? ಶಾಸ್ತ್ರಸ್ಯ ವಾಕ್ಯಂ ಕಿಂ ಫಲಹೀನಂ ಭವೇತ್? ಅಸ್ಮದನ್ತರ್ವಾಸೀ ಯ ಆತ್ಮಾ ಸ ವಾ ಕಿಮ್ ಈರ್ಷ್ಯಾರ್ಥಂ ಪ್ರೇಮ ಕರೋತಿ?</para>
  <para style="p">
    <verse number="6" style="v"/>ತನ್ನಹಿ ಕಿನ್ತು ಸ ಪ್ರತುಲಂ ವರಂ ವಿತರತಿ ತಸ್ಮಾದ್ ಉಕ್ತಮಾಸ್ತೇ ಯಥಾ, ಆತ್ಮಾಭಿಮಾನಲೋಕಾನಾಂ ವಿಪಕ್ಷೋ ಭವತೀಶ್ವರಃ| ಕಿನ್ತು ತೇನೈವ ನಮ್ರೇಭ್ಯಃ ಪ್ರಸಾದಾದ್ ದೀಯತೇ ವರಃ||</para>
  <para style="p">
    <verse number="7" style="v"/>ಅತಏವ ಯೂಯಮ್ ಈಶ್ವರಸ್ಯ ವಶ್ಯಾ ಭವತ ಶಯತಾನಂ ಸಂರುನ್ಧ ತೇನ ಸ ಯುಷ್ಮತ್ತಃ ಪಲಾಯಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಈಶ್ವರಸ್ಯ ಸಮೀಪವರ್ತ್ತಿನೋ ಭವತ ತೇನ ಸ ಯುಷ್ಮಾಕಂ ಸಮೀಪವರ್ತ್ತೀ ಭವಿಷ್ಯತಿ| ಹೇ ಪಾಪಿನಃ, ಯೂಯಂ ಸ್ವಕರಾನ್ ಪರಿಷ್ಕುರುಧ್ವಂ| ಹೇ ದ್ವಿಮನೋಲೋಕಾಃ, ಯೂಯಂ ಸ್ವಾನ್ತಃಕರಣಾನಿ ಶುಚೀನಿ ಕುರುಧ್ವಂ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಯೂಯಮ್ ಉದ್ವಿಜಧ್ವಂ ಶೋಚತ ವಿಲಪತ ಚ, ಯುಷ್ಮಾಕಂ ಹಾಸಃ ಶೋಕಾಯ, ಆನನ್ದಶ್ಚ ಕಾತರತಾಯೈ ಪರಿವರ್ತ್ತೇತಾಂ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಪ್ರಭೋಃ ಸಮಕ್ಷಂ ನಮ್ರಾ ಭವತ ತಸ್ಮಾತ್ ಸ ಯುಷ್ಮಾನ್ ಉಚ್ಚೀಕರಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಯೂಯಂ ಪರಸ್ಪರಂ ಮಾ ದೂಷಯತ| ಯಃ ಕಶ್ಚಿದ್ ಭ್ರಾತರಂ ದೂಷಯತಿ ಭ್ರಾತು ರ್ವಿಚಾರಞ್ಚ ಕರೋತಿ ಸ ವ್ಯವಸ್ಥಾಂ ದೂಷಯತಿ ವ್ಯವಸ್ಥಾಯಾಶ್ಚ ವಿಚಾರಂ ಕರೋತಿ| ತ್ವಂ ಯದಿ ವ್ಯವಸ್ಥಾಯಾ ವಿಚಾರಂ ಕರೋಷಿ ತರ್ಹಿ ವ್ಯವಸ್ಥಾಪಾಲಯಿತಾ ನ ಭವಸಿ ಕಿನ್ತು ವಿಚಾರಯಿತಾ ಭವಸಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಅದ್ವಿತೀಯೋ ವ್ಯವಸ್ಥಾಪಕೋ ವಿಚಾರಯಿತಾ ಚ ಸ ಏವಾಸ್ತೇ ಯೋ ರಕ್ಷಿತುಂ ನಾಶಯಿತುಞ್ಚ ಪಾರಯತಿ| ಕಿನ್ತು ಕಸ್ತ್ವಂ ಯತ್ ಪರಸ್ಯ ವಿಚಾರಂ ಕರೋಷಿ?</para>
  <para style="p">
    <verse number="13" style="v"/>ಅದ್ಯ ಶ್ವೋ ವಾ ವಯಮ್ ಅಮುಕನಗರಂ ಗತ್ವಾ ತತ್ರ ವರ್ಷಮೇಕಂ ಯಾಪಯನ್ತೋ ವಾಣಿಜ್ಯಂ ಕರಿಷ್ಯಾಮಃ ಲಾಭಂ ಪ್ರಾಪ್ಸ್ಯಾಮಶ್ಚೇತಿ ಕಥಾಂ ಭಾಷಮಾಣಾ ಯೂಯಮ್ ಇದಾನೀಂ ಶೃಣುತ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಶ್ವಃ ಕಿಂ ಘಟಿಷ್ಯತೇ ತದ್ ಯೂಯಂ ನ ಜಾನೀಥ ಯತೋ ಜೀವನಂ ವೋ ಭವೇತ್ ಕೀದೃಕ್ ತತ್ತು ಬಾಷ್ಪಸ್ವರೂಪಕಂ, ಕ್ಷಣಮಾತ್ರಂ ಭವೇದ್ ದೃಶ್ಯಂ ಲುಪ್ಯತೇ ಚ ತತಃ ಪರಂ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತದನುಕ್ತ್ವಾ ಯುಷ್ಮಾಕಮ್ ಇದಂ ಕಥನೀಯಂ ಪ್ರಭೋರಿಚ್ಛಾತೋ ವಯಂ ಯದಿ ಜೀವಾಮಸ್ತರ್ಹ್ಯೇತತ್ ಕರ್ಮ್ಮ ತತ್ ಕರ್ಮ್ಮ ವಾ ಕರಿಷ್ಯಾಮ ಇತಿ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಕಿನ್ತ್ವಿದಾನೀಂ ಯೂಯಂ ಗರ್ವ್ವವಾಕ್ಯೈಃ ಶ್ಲಾಘನಂ ಕುರುಧ್ವೇ ತಾದೃಶಂ ಸರ್ವ್ವಂ ಶ್ಲಾಘನಂ ಕುತ್ಸಿತಮೇವ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಅತೋ ಯಃ ಕಶ್ಚಿತ್ ಸತ್ಕರ್ಮ್ಮ ಕರ್ತ್ತಂ ವಿದಿತ್ವಾ ತನ್ನ ಕರೋತಿ ತಸ್ಯ ಪಾಪಂ ಜಾಯತೇ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಧನವನ್ತಃ, ಯೂಯಮ್ ಇದಾನೀಂ ಶೃಣುತ ಯುಷ್ಮಾಭಿರಾಗಮಿಷ್ಯತ್ಕ್ಲೇಶಹೇತೋಃ ಕ್ರನ್ದ್ಯತಾಂ ವಿಲಪ್ಯತಾಞ್ಚ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯುಷ್ಮಾಕಂ ದ್ರವಿಣಂ ಜೀರ್ಣಂ ಕೀಟಭುಕ್ತಾಃ ಸುಚೇಲಕಾಃ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಕನಕಂ ರಜತಞ್ಚಾಪಿ ವಿಕೃತಿಂ ಪ್ರಗಮಿಷ್ಯತಿ, ತತ್ಕಲಙ್ಕಶ್ಚ ಯುಷ್ಮಾಕಂ ಪಾಪಂ ಪ್ರಮಾಣಯಿಷ್ಯತಿ, ಹುತಾಶವಚ್ಚ ಯುಷ್ಮಾಕಂ ಪಿಶಿತಂ ಖಾದಯಿಷ್ಯತಿ| ಇತ್ಥಮ್ ಅನ್ತಿಮಘಸ್ರೇಷು ಯುಷ್ಮಾಭಿಃ ಸಞ್ಚಿತಂ ಧನಂ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಪಶ್ಯತ ಯೈಃ ಕೃಷೀವಲೈ ರ್ಯುಷ್ಮಾಕಂ ಶಸ್ಯಾನಿ ಛಿನ್ನಾನಿ ತೇಭ್ಯೋ ಯುಷ್ಮಾಭಿ ರ್ಯದ್ ವೇತನಂ ಛಿನ್ನಂ ತದ್ ಉಚ್ಚೈ ರ್ಧ್ವನಿಂ ಕರೋತಿ ತೇಷಾಂ ಶಸ್ಯಚ್ಛೇದಕಾನಾಮ್ ಆರ್ತ್ತರಾವಃ ಸೇನಾಪತೇಃ ಪರಮೇಶ್ವರಸ್ಯ ಕರ್ಣಕುಹರಂ ಪ್ರವಿಷ್ಟಃ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯೂಯಂ ಪೃಥಿವ್ಯಾಂ ಸುಖಭೋಗಂ ಕಾಮುಕತಾಞ್ಚಾರಿತವನ್ತಃ, ಮಹಾಭೋಜಸ್ಯ ದಿನ ಇವ ನಿಜಾನ್ತಃಕರಣಾನಿ ಪರಿತರ್ಪಿತವನ್ತಶ್ಚ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅಪರಞ್ಚ ಯುಷ್ಮಾಭಿ ರ್ಧಾರ್ಮ್ಮಿಕಸ್ಯ ದಣ್ಡಾಜ್ಞಾ ಹತ್ಯಾ ಚಾಕಾರಿ ತಥಾಪಿ ಸ ಯುಷ್ಮಾನ್ ನ ಪ್ರತಿರುದ್ಧವಾನ್|</para>
  <para style="p">
    <verse number="7" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಯೂಯಂ ಪ್ರಭೋರಾಗಮನಂ ಯಾವದ್ ಧೈರ್ಯ್ಯಮಾಲಮ್ಬಧ್ವಂ| ಪಶ್ಯತ ಕೃಷಿವಲೋ ಭೂಮೇ ರ್ಬಹುಮೂಲ್ಯಂ ಫಲಂ ಪ್ರತೀಕ್ಷಮಾಣೋ ಯಾವತ್ ಪ್ರಥಮಮ್ ಅನ್ತಿಮಞ್ಚ ವೃಷ್ಟಿಜಲಂ ನ ಪ್ರಾಪ್ನೋತಿ ತಾವದ್ ಧೈರ್ಯ್ಯಮ್ ಆಲಮ್ಬತೇ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಯೂಯಮಪಿ ಧೈರ್ಯ್ಯಮಾಲಮ್ಬ್ಯ ಸ್ವಾನ್ತಃಕರಣಾನಿ ಸ್ಥಿರೀಕುರುತ, ಯತಃ ಪ್ರಭೋರುಪಸ್ಥಿತಿಃ ಸಮೀಪವರ್ತ್ತಿನ್ಯಭವತ್|</para>
  <para style="p">
    <verse number="9" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಯೂಯಂ ಯದ್ ದಣ್ಡ್ಯಾ ನ ಭವೇತ ತದರ್ಥಂ ಪರಸ್ಪರಂ ನ ಗ್ಲಾಯತ, ಪಶ್ಯತ ವಿಚಾರಯಿತಾ ದ್ವಾರಸಮೀಪೇ ತಿಷ್ಠತಿ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಹೇ ಮಮ ಭ್ರಾತರಃ, ಯೇ ಭವಿಷ್ಯದ್ವಾದಿನಃ ಪ್ರಭೋ ರ್ನಾಮ್ನಾ ಭಾಷಿತವನ್ತಸ್ತಾನ್ ಯೂಯಂ ದುಃಖಸಹನಸ್ಯ ಧೈರ್ಯ್ಯಸ್ಯ ಚ ದೃಷ್ಟಾನ್ತಾನ್ ಜಾನೀತ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಪಶ್ಯತ ಧೈರ್ಯ್ಯಶೀಲಾ ಅಸ್ಮಾಭಿ ರ್ಧನ್ಯಾ ಉಚ್ಯನ್ತೇ| ಆಯೂಬೋ ಧೈರ್ಯ್ಯಂ ಯುಷ್ಮಾಭಿರಶ್ರಾವಿ ಪ್ರಭೋಃ ಪರಿಣಾಮಶ್ಚಾದರ್ಶಿ ಯತಃ ಪ್ರಭು ರ್ಬಹುಕೃಪಃ ಸಕರುಣಶ್ಚಾಸ್ತಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಹೇ ಭ್ರಾತರಃ ವಿಶೇಷತ ಇದಂ ವದಾಮಿ ಸ್ವರ್ಗಸ್ಯ ವಾ ಪೃಥಿವ್ಯಾ ವಾನ್ಯವಸ್ತುನೋ ನಾಮ ಗೃಹೀತ್ವಾ ಯುಷ್ಮಾಭಿಃ ಕೋಽಪಿ ಶಪಥೋ ನ ಕ್ರಿಯತಾಂ, ಕಿನ್ತು ಯಥಾ ದಣ್ಡ್ಯಾ ನ ಭವತ ತದರ್ಥಂ ಯುಷ್ಮಾಕಂ ತಥೈವ ತನ್ನಹಿ ಚೇತಿವಾಕ್ಯಂ ಯಥೇಷ್ಟಂ ಭವತು|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯುಷ್ಮಾಕಂ ಕಶ್ಚಿದ್ ದುಃಖೀ ಭವತಿ? ಸ ಪ್ರಾರ್ಥನಾಂ ಕರೋತು| ಕಶ್ಚಿದ್ ವಾನನ್ದಿತೋ ಭವತಿ? ಸ ಗೀತಂ ಗಾಯತು|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯುಷ್ಮಾಕಂ ಕಶ್ಚಿತ್ ಪೀಡಿತೋ ಽಸ್ತಿ? ಸ ಸಮಿತೇಃ ಪ್ರಾಚೀನಾನ್ ಆಹ್ವಾತು ತೇ ಚ ಪಭೋ ರ್ನಾಮ್ನಾ ತಂ ತೈಲೇನಾಭಿಷಿಚ್ಯ ತಸ್ಯ ಕೃತೇ ಪ್ರಾರ್ಥನಾಂ ಕುರ್ವ್ವನ್ತು|</para>
  <para style="p">
    <verse number="15" style="v"/>ತಸ್ಮಾದ್ ವಿಶ್ವಾಸಜಾತಪ್ರಾರ್ಥನಯಾ ಸ ರೋಗೀ ರಕ್ಷಾಂ ಯಾಸ್ಯತಿ ಪ್ರಭುಶ್ಚ ತಮ್ ಉತ್ಥಾಪಯಿಷ್ಯತಿ ಯದಿ ಚ ಕೃತಪಾಪೋ ಭವೇತ್ ತರ್ಹಿ ಸ ತಂ ಕ್ಷಮಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯೂಯಂ ಪರಸ್ಪರಮ್ ಅಪರಾಧಾನ್ ಅಙ್ಗೀಕುರುಧ್ವಮ್ ಆರೋಗ್ಯಪ್ರಾಪ್ತ್ಯರ್ಥಞ್ಚೈಕಜನೋ ಽನ್ಯಸ್ಯ ಕೃತೇ ಪ್ರಾರ್ಥನಾಂ ಕರೋತು ಧಾರ್ಮ್ಮಿಕಸ್ಯ ಸಯತ್ನಾ ಪ್ರಾರ್ಥನಾ ಬಹುಶಕ್ತಿವಿಶಿಷ್ಟಾ ಭವತಿ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಯ ಏಲಿಯೋ ವಯಮಿವ ಸುಖದುಃಖಭೋಗೀ ಮರ್ತ್ತ್ಯ ಆಸೀತ್ ಸ ಪ್ರಾರ್ಥನಯಾನಾವೃಷ್ಟಿಂ ಯಾಚಿತವಾನ್ ತೇನ ದೇಶೇ ಸಾರ್ದ್ಧವತ್ಸರತ್ರಯಂ ಯಾವದ್ ವೃಷ್ಟಿ ರ್ನ ಬಭೂವ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಪಶ್ಚಾತ್ ತೇನ ಪುನಃ ಪ್ರಾರ್ಥನಾಯಾಂ ಕೃತಾಯಾಮ್ ಆಕಾಶಸ್ತೋಯಾನ್ಯವರ್ಷೀತ್ ಪೃಥಿವೀ ಚ ಸ್ವಫಲಾನಿ ಪ್ರಾರೋಹಯತ್|</para>
  <para style="p">
    <verse number="19" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಯುಷ್ಮಾಕಂ ಕಸ್ಮಿಂಶ್ಚಿತ್ ಸತ್ಯಮತಾದ್ ಭ್ರಷ್ಟೇ ಯದಿ ಕಶ್ಚಿತ್ ತಂ ಪರಾವರ್ತ್ತಯತಿ</para>
  <para style="p">
    <verse number="20" style="v"/>ತರ್ಹಿ ಯೋ ಜನಃ ಪಾಪಿನಂ ವಿಪಥಭ್ರಮಣಾತ್ ಪರಾವರ್ತ್ತಯತಿ ಸ ತಸ್ಯಾತ್ಮಾನಂ ಮೃತ್ಯುತ ಉದ್ಧರಿಷ್ಯತಿ ಬಹುಪಾಪಾನ್ಯಾವರಿಷ್ಯತಿ ಚೇತಿ ಜಾನಾತು|</para>
</usx>
