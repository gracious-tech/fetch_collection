<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="COL" style="id">Sanskrit Bible (NT) in Kannada Script (ಸತ್ಯವೇದಃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Colossians</para>
  <para style="toc1">ಕಲಸಿನಃ ಪತ್ರಂ</para>
  <para style="toc2">ಕಲಸಿನಃ</para>
  <para style="toc3">ಕಲಸಿನಃ</para>
  <para style="mt1">ಕಲಸಿನಃ ಪತ್ರಂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಈಶ್ವರಸ್ಯೇಚ್ಛಯಾ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಪ್ರೇರಿತಃ ಪೌಲಸ್ತೀಮಥಿಯೋ ಭ್ರಾತಾ ಚ ಕಲಸೀನಗರಸ್ಥಾನ್ ಪವಿತ್ರಾನ್ ವಿಶ್ವಸ್ತಾನ್ ಖ್ರೀಷ್ಟಾಶ್ರಿತಭ್ರಾತೃನ್ ಪ್ರತಿ ಪತ್ರಂ ಲಿಖತಃ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಅಸ್ಮಾಕಂ ತಾತ ಈಶ್ವರಃ ಪ್ರಭು ರ್ಯೀಶುಖ್ರೀಷ್ಟಶ್ಚ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಪ್ರಸಾದಂ ಶಾನ್ತಿಞ್ಚ ಕ್ರಿಯಾಸ್ತಾಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಖ್ರೀಷ್ಟೇ ಯೀಶೌ ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸಸ್ಯ ಸರ್ವ್ವಾನ್ ಪವಿತ್ರಲೋಕಾನ್ ಪ್ರತಿ ಪ್ರೇಮ್ನಶ್ಚ ವಾರ್ತ್ತಾಂ ಶ್ರುತ್ವಾ</para>
  <para style="p">
    <verse number="4" style="v"/>ವಯಂ ಸದಾ ಯುಷ್ಮದರ್ಥಂ ಪ್ರಾರ್ಥನಾಂ ಕುರ್ವ್ವನ್ತಃ ಸ್ವರ್ಗೇ ನಿಹಿತಾಯಾ ಯುಷ್ಮಾಕಂ ಭಾವಿಸಮ್ಪದಃ ಕಾರಣಾತ್ ಸ್ವಕೀಯಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ತಾತಮ್ ಈಶ್ವರಂ ಧನ್ಯಂ ವದಾಮಃ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯೂಯಂ ತಸ್ಯಾ ಭಾವಿಸಮ್ಪದೋ ವಾರ್ತ್ತಾಂ ಯಯಾ ಸುಸಂವಾದರೂಪಿಣ್ಯಾ ಸತ್ಯವಾಣ್ಯಾ ಜ್ಞಾಪಿತಾಃ</para>
  <para style="p">
    <verse number="6" style="v"/>ಸಾ ಯದ್ವತ್ ಕೃಸ್ನಂ ಜಗದ್ ಅಭಿಗಚ್ಛತಿ ತದ್ವದ್ ಯುಷ್ಮಾನ್ ಅಪ್ಯಭ್ಯಗಮತ್, ಯೂಯಞ್ಚ ಯದ್ ದಿನಮ್ ಆರಭ್ಯೇಶ್ವರಸ್ಯಾನುಗ್ರಹಸ್ಯ ವಾರ್ತ್ತಾಂ ಶ್ರುತ್ವಾ ಸತ್ಯರೂಪೇಣ ಜ್ಞಾತವನ್ತಸ್ತದಾರಭ್ಯ ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇಽಪಿ ಫಲತಿ ವರ್ದ್ಧತೇ ಚ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅಸ್ಮಾಕಂ ಪ್ರಿಯಃ ಸಹದಾಸೋ ಯುಷ್ಮಾಕಂ ಕೃತೇ ಚ ಖ್ರೀಷ್ಟಸ್ಯ ವಿಶ್ವಸ್ತಪರಿಚಾರಕೋ ಯ ಇಪಫ್ರಾಸ್ತದ್ ವಾಕ್ಯಂ</para>
  <para style="p">
    <verse number="8" style="v"/>ಯುಷ್ಮಾನ್ ಆದಿಷ್ಟವಾನ್ ಸ ಏವಾಸ್ಮಾನ್ ಆತ್ಮನಾ ಜನಿತಂ ಯುಷ್ಮಾಕಂ ಪ್ರೇಮ ಜ್ಞಾಪಿತವಾನ್|</para>
  <para style="p">
    <verse number="9" style="v"/>ವಯಂ ಯದ್ ದಿನಮ್ ಆರಭ್ಯ ತಾಂ ವಾರ್ತ್ತಾಂ ಶ್ರುತವನ್ತಸ್ತದಾರಭ್ಯ ನಿರನ್ತರಂ ಯುಷ್ಮಾಕಂ ಕೃತೇ ಪ್ರಾರ್ಥನಾಂ ಕುರ್ಮ್ಮಃ ಫಲತೋ ಯೂಯಂ ಯತ್ ಪೂರ್ಣಾಭ್ಯಾಮ್ ಆತ್ಮಿಕಜ್ಞಾನವುದ್ಧಿಭ್ಯಾಮ್ ಈಶ್ವರಸ್ಯಾಭಿತಮಂ ಸಮ್ಪೂರ್ಣರೂಪೇಣಾವಗಚ್ಛೇತ,</para>
  <para style="p">
    <verse number="10" style="v"/>ಪ್ರಭೋ ರ್ಯೋಗ್ಯಂ ಸರ್ವ್ವಥಾ ಸನ್ತೋಷಜನಕಞ್ಚಾಚಾರಂ ಕುರ್ಯ್ಯಾತಾರ್ಥತ ಈಶ್ವರಜ್ಞಾನೇ ವರ್ದ್ಧಮಾನಾಃ ಸರ್ವ್ವಸತ್ಕರ್ಮ್ಮರೂಪಂ ಫಲಂ ಫಲೇತ,</para>
  <para style="p">
    <verse number="11" style="v"/>ಯಥಾ ಚೇಶ್ವರಸ್ಯ ಮಹಿಮಯುಕ್ತಯಾ ಶಕ್ತ್ಯಾ ಸಾನನ್ದೇನ ಪೂರ್ಣಾಂ ಸಹಿಷ್ಣುತಾಂ ತಿತಿಕ್ಷಾಞ್ಚಾಚರಿತುಂ ಶಕ್ಷ್ಯಥ ತಾದೃಶೇನ ಪೂರ್ಣಬಲೇನ ಯದ್ ಬಲವನ್ತೋ ಭವೇತ,</para>
  <para style="p">
    <verse number="12" style="v"/>ಯಶ್ಚ ಪಿತಾ ತೇಜೋವಾಸಿನಾಂ ಪವಿತ್ರಲೋಕಾನಾಮ್ ಅಧಿಕಾರಸ್ಯಾಂಶಿತ್ವಾಯಾಸ್ಮಾನ್ ಯೋಗ್ಯಾನ್ ಕೃತವಾನ್ ತಂ ಯದ್ ಧನ್ಯಂ ವದೇತ ವರಮ್ ಏನಂ ಯಾಚಾಮಹೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯತಃ ಸೋಽಸ್ಮಾನ್ ತಿಮಿರಸ್ಯ ಕರ್ತ್ತೃತ್ವಾದ್ ಉದ್ಧೃತ್ಯ ಸ್ವಕೀಯಸ್ಯ ಪ್ರಿಯಪುತ್ರಸ್ಯ ರಾಜ್ಯೇ ಸ್ಥಾಪಿತವಾನ್|</para>
  <para style="p">
    <verse number="14" style="v"/>ತಸ್ಮಾತ್ ಪುತ್ರಾದ್ ವಯಂ ಪರಿತ್ರಾಣಮ್ ಅರ್ಥತಃ ಪಾಪಮೋಚನಂ ಪ್ರಾಪ್ತವನ್ತಃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಸ ಚಾದೃಶ್ಯಸ್ಯೇಶ್ವರಸ್ಯ ಪ್ರತಿಮೂರ್ತಿಃ ಕೃತ್ಸ್ನಾಯಾಃ ಸೃಷ್ಟೇರಾದಿಕರ್ತ್ತಾ ಚ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯತಃ ಸರ್ವ್ವಮೇವ ತೇನ ಸಸೃಜೇ ಸಿಂಹಾಸನರಾಜತ್ವಪರಾಕ್ರಮಾದೀನಿ ಸ್ವರ್ಗಮರ್ತ್ತ್ಯಸ್ಥಿತಾನಿ ದೃಶ್ಯಾದೃಶ್ಯಾನಿ ವಸ್ತೂನಿ ಸರ್ವ್ವಾಣಿ ತೇನೈವ ತಸ್ಮೈ ಚ ಸಸೃಜಿರೇ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಸ ಸರ್ವ್ವೇಷಾಮ್ ಆದಿಃ ಸರ್ವ್ವೇಷಾಂ ಸ್ಥಿತಿಕಾರಕಶ್ಚ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಸ ಏವ ಸಮಿತಿರೂಪಾಯಾಸ್ತನೋ ರ್ಮೂರ್ದ್ಧಾ ಕಿಞ್ಚ ಸರ್ವ್ವವಿಷಯೇ ಸ ಯದ್ ಅಗ್ರಿಯೋ ಭವೇತ್ ತದರ್ಥಂ ಸ ಏವ ಮೃತಾನಾಂ ಮಧ್ಯಾತ್ ಪ್ರಥಮತ ಉತ್ಥಿತೋಽಗ್ರಶ್ಚ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಯತ ಈಶ್ವರಸ್ಯ ಕೃತ್ಸ್ನಂ ಪೂರ್ಣತ್ವಂ ತಮೇವಾವಾಸಯಿತುಂ</para>
  <para style="p">
    <verse number="20" style="v"/>ಕ್ರುಶೇ ಪಾತಿತೇನ ತಸ್ಯ ರಕ್ತೇನ ಸನ್ಧಿಂ ವಿಧಾಯ ತೇನೈವ ಸ್ವರ್ಗಮರ್ತ್ತ್ಯಸ್ಥಿತಾನಿ ಸರ್ವ್ವಾಣಿ ಸ್ವೇನ ಸಹ ಸನ್ಧಾಪಯಿತುಞ್ಚೇಶ್ವರೇಣಾಭಿಲೇಷೇ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಪೂರ್ವ್ವಂ ದೂರಸ್ಥಾ ದುಷ್ಕ್ರಿಯಾರತಮನಸ್ಕತ್ವಾತ್ ತಸ್ಯ ರಿಪವಶ್ಚಾಸ್ತ ಯೇ ಯೂಯಂ ತಾನ್ ಯುಷ್ಮಾನ್ ಅಪಿ ಸ ಇದಾನೀಂ ತಸ್ಯ ಮಾಂಸಲಶರೀರೇ ಮರಣೇನ ಸ್ವೇನ ಸಹ ಸನ್ಧಾಪಿತವಾನ್|</para>
  <para style="p">
    <verse number="22" style="v"/>ಯತಃ ಸ ಸ್ವಸಮ್ಮುಖೇ ಪವಿತ್ರಾನ್ ನಿಷ್ಕಲಙ್ಕಾನ್ ಅನಿನ್ದನೀಯಾಂಶ್ಚ ಯುಷ್ಮಾನ್ ಸ್ಥಾಪಯಿತುಮ್ ಇಚ್ಛತಿ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಕಿನ್ತ್ವೇತದರ್ಥಂ ಯುಷ್ಮಾಭಿ ರ್ಬದ್ಧಮೂಲೈಃ ಸುಸ್ಥಿರೈಶ್ಚ ಭವಿತವ್ಯಮ್, ಆಕಾಶಮಣ್ಡಲಸ್ಯಾಧಃಸ್ಥಿತಾನಾಂ ಸರ್ವ್ವಲೋಕಾನಾಂ ಮಧ್ಯೇ ಚ ಘುಷ್ಯಮಾಣೋ ಯಃ ಸುಸಂವಾದೋ ಯುಷ್ಮಾಭಿರಶ್ರಾವಿ ತಜ್ಜಾತಾಯಾಂ ಪ್ರತ್ಯಾಶಾಯಾಂ ಯುಷ್ಮಾಭಿರಚಲೈ ರ್ಭವಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="24" style="v"/>ತಸ್ಯ ಸುಸಂವಾದಸ್ಯೈಕಃ ಪರಿಚಾರಕೋ ಯೋಽಹಂ ಪೌಲಃ ಸೋಽಹಮ್ ಇದಾನೀಮ್ ಆನನ್ದೇನ ಯುಷ್ಮದರ್ಥಂ ದುಃಖಾನಿ ಸಹೇ ಖ್ರೀಷ್ಟಸ್ಯ ಕ್ಲೇಶಭೋಗಸ್ಯ ಯೋಂಶೋಽಪೂರ್ಣಸ್ತಮೇವ ತಸ್ಯ ತನೋಃ ಸಮಿತೇಃ ಕೃತೇ ಸ್ವಶರೀರೇ ಪೂರಯಾಮಿ ಚ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಯತ ಈಶ್ವರಸ್ಯ ಮನ್ತ್ರಣಯಾ ಯುಷ್ಮದರ್ಥಮ್ ಈಶ್ವರೀಯವಾಕ್ಯಸ್ಯ ಪ್ರಚಾರಸ್ಯ ಭಾರೋ ಮಯಿ ಸಮಪಿತಸ್ತಸ್ಮಾದ್ ಅಹಂ ತಸ್ಯಾಃ ಸಮಿತೇಃ ಪರಿಚಾರಕೋಽಭವಂ|</para>
  <para style="p">
    <verse number="26" style="v"/>ತತ್ ನಿಗೂಢಂ ವಾಕ್ಯಂ ಪೂರ್ವ್ವಯುಗೇಷು ಪೂರ್ವ್ವಪುರುಷೇಭ್ಯಃ ಪ್ರಚ್ಛನ್ನಮ್ ಆಸೀತ್ ಕಿನ್ತ್ವಿದಾನೀಂ ತಸ್ಯ ಪವಿತ್ರಲೋಕಾನಾಂ ಸನ್ನಿಧೌ ತೇನ ಪ್ರಾಕಾಶ್ಯತ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಯತೋ ಭಿನ್ನಜಾತೀಯಾನಾಂ ಮಧ್ಯೇ ತತ್ ನಿಗೂಢವಾಕ್ಯಂ ಕೀದೃಗ್ಗೌರವನಿಧಿಸಮ್ಬಲಿತಂ ತತ್ ಪವಿತ್ರಲೋಕಾನ್ ಜ್ಞಾಪಯಿತುಮ್ ಈಶ್ವರೋಽಭ್ಯಲಷತ್| ಯುಷ್ಮನ್ಮಧ್ಯವರ್ತ್ತೀ ಖ್ರೀಷ್ಟ ಏವ ಸ ನಿಧಿ ರ್ಗೈರವಾಶಾಭೂಮಿಶ್ಚ|</para>
  <para style="p">
    <verse number="28" style="v"/>ತಸ್ಮಾದ್ ವಯಂ ತಮೇವ ಘೋಷಯನ್ತೋ ಯದ್ ಏಕೈಕಂ ಮಾನವಂ ಸಿದ್ಧೀಭೂತಂ ಖ್ರೀಷ್ಟೇ ಸ್ಥಾಪಯೇಮ ತದರ್ಥಮೇಕೈಕಂ ಮಾನವಂ ಪ್ರಬೋಧಯಾಮಃ ಪೂರ್ಣಜ್ಞಾನೇನ ಚೈಕೈಕಂ ಮಾನವಂ ಉಪದಿಶಾಮಃ|</para>
  <para style="p">
    <verse number="29" style="v"/>ಏತದರ್ಥಂ ತಸ್ಯ ಯಾ ಶಕ್ತಿಃ ಪ್ರಬಲರೂಪೇಣ ಮಮ ಮಧ್ಯೇ ಪ್ರಕಾಶತೇ ತಯಾಹಂ ಯತಮಾನಃ ಶ್ರಾಭ್ಯಾಮಿ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಯುಷ್ಮಾಕಂ ಲಾಯದಿಕೇಯಾಸ್ಥಭ್ರಾತೃಣಾಞ್ಚ ಕೃತೇ ಯಾವನ್ತೋ ಭ್ರಾತರಶ್ಚ ಮಮ ಶಾರೀರಿಕಮುಖಂ ನ ದೃಷ್ಟವನ್ತಸ್ತೇಷಾಂ ಕೃತೇ ಮಮ ಕಿಯಾನ್ ಯತ್ನೋ ಭವತಿ ತದ್ ಯುಷ್ಮಾನ್ ಜ್ಞಾಪಯಿತುಮ್ ಇಚ್ಛಾಮಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಫಲತಃ ಪೂರ್ಣಬುದ್ಧಿರೂಪಧನಭೋಗಾಯ ಪ್ರೇಮ್ನಾ ಸಂಯುಕ್ತಾನಾಂ ತೇಷಾಂ ಮನಾಂಸಿ ಯತ್ ಪಿತುರೀಶ್ವರಸ್ಯ ಖ್ರೀಷ್ಟಸ್ಯ ಚ ನಿಗೂಢವಾಕ್ಯಸ್ಯ ಜ್ಞಾನಾರ್ಥಂ ಸಾನ್ತ್ವನಾಂ ಪ್ರಾಪ್ನುಯುರಿತ್ಯರ್ಥಮಹಂ ಯತೇ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಯತೋ ವಿದ್ಯಾಜ್ಞಾನಯೋಃ ಸರ್ವ್ವೇ ನಿಧಯಃ ಖ್ರೀಷ್ಟೇ ಗುಪ್ತಾಃ ಸನ್ತಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಕೋಽಪಿ ಯುಷ್ಮಾನ್ ವಿನಯವಾಕ್ಯೇನ ಯನ್ನ ವಞ್ಚಯೇತ್ ತದರ್ಥಮ್ ಏತಾನಿ ಮಯಾ ಕಥ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯುಷ್ಮತ್ಸನ್ನಿಧೌ ಮಮ ಶರೀರೇಽವರ್ತ್ತಮಾನೇಽಪಿ ಮಮಾತ್ಮಾ ವರ್ತ್ತತೇ ತೇನ ಯುಷ್ಮಾಕಂ ಸುರೀತಿಂ ಖ್ರೀಷ್ಟವಿಶ್ವಾಸೇ ಸ್ಥಿರತ್ವಞ್ಚ ದೃಷ್ಟ್ವಾಹಮ್ ಆನನ್ದಾಮಿ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅತೋ ಯೂಯಂ ಪ್ರಭುಂ ಯೀಶುಖ್ರೀಷ್ಟಂ ಯಾದೃಗ್ ಗೃಹೀತವನ್ತಸ್ತಾದೃಕ್ ತಮ್ ಅನುಚರತ|</para>
  <para style="p">
    <verse number="7" style="v"/>ತಸ್ಮಿನ್ ಬದ್ಧಮೂಲಾಃ ಸ್ಥಾಪಿತಾಶ್ಚ ಭವತ ಯಾ ಚ ಶಿಕ್ಷಾ ಯುಷ್ಮಾಭಿ ರ್ಲಬ್ಧಾ ತದನುಸಾರಾದ್ ವಿಶ್ವಾಸೇ ಸುಸ್ಥಿರಾಃ ಸನ್ತಸ್ತೇನೈವ ನಿತ್ಯಂ ಧನ್ಯವಾದಂ ಕುರುತ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಸಾವಧಾನಾ ಭವತ ಮಾನುಷಿಕಶಿಕ್ಷಾತ ಇಹಲೋಕಸ್ಯ ವರ್ಣಮಾಲಾತಶ್ಚೋತ್ಪನ್ನಾ ಖ್ರೀಷ್ಟಸ್ಯ ವಿಪಕ್ಷಾ ಯಾ ದರ್ಶನವಿದ್ಯಾ ಮಿಥ್ಯಾಪ್ರತಾರಣಾ ಚ ತಯಾ ಕೋಽಪಿ ಯುಷ್ಮಾಕಂ ಕ್ಷತಿಂ ನ ಜನಯತು|</para>
  <para style="p">
    <verse number="9" style="v"/>ಯತ ಈಶ್ವರಸ್ಯ ಕೃತ್ಸ್ನಾ ಪೂರ್ಣತಾ ಮೂರ್ತ್ತಿಮತೀ ಖ್ರೀಷ್ಟೇ ವಸತಿ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯೂಯಞ್ಚ ತೇನ ಪೂರ್ಣಾ ಭವಥ ಯತಃ ಸ ಸರ್ವ್ವೇಷಾಂ ರಾಜತ್ವಕರ್ತ್ತೃತ್ವಪದಾನಾಂ ಮೂರ್ದ್ಧಾಸ್ತಿ,</para>
  <para style="p">
    <verse number="11" style="v"/>ತೇನ ಚ ಯೂಯಮ್ ಅಹಸ್ತಕೃತತ್ವಕ್ಛೇದೇನಾರ್ಥತೋ ಯೇನ ಶಾರೀರಪಾಪಾನಾಂ ವಿಗ್ರಸತ್ಯಜ್ಯತೇ ತೇನ ಖ್ರೀಷ್ಟಸ್ಯ ತ್ವಕ್ಛೇದೇನ ಛಿನ್ನತ್ವಚೋ ಜಾತಾ</para>
  <para style="p">
    <verse number="12" style="v"/>ಮಜ್ಜನೇ ಚ ತೇನ ಸಾರ್ದ್ಧಂ ಶ್ಮಶಾನಂ ಪ್ರಾಪ್ತಾಃ ಪುನ ರ್ಮೃತಾನಾಂ ಮಧ್ಯಾತ್ ತಸ್ಯೋತ್ಥಾಪಯಿತುರೀಶ್ವರಸ್ಯ ಶಕ್ತೇಃ ಫಲಂ ಯೋ ವಿಶ್ವಾಸಸ್ತದ್ವಾರಾ ತಸ್ಮಿನ್ನೇವ ಮಜ್ಜನೇ ತೇನ ಸಾರ್ದ್ಧಮ್ ಉತ್ಥಾಪಿತಾ ಅಭವತ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಸ ಚ ಯುಷ್ಮಾನ್ ಅಪರಾಧೈಃ ಶಾರೀರಿಕಾತ್ವಕ್ಛೇದೇನ ಚ ಮೃತಾನ್ ದೃಷ್ಟ್ವಾ ತೇನ ಸಾರ್ದ್ಧಂ ಜೀವಿತವಾನ್ ಯುಷ್ಮಾಕಂ ಸರ್ವ್ವಾನ್ ಅಪರಾಧಾನ್ ಕ್ಷಮಿತವಾನ್,</para>
  <para style="p">
    <verse number="14" style="v"/>ಯಚ್ಚ ದಣ್ಡಾಜ್ಞಾರೂಪಂ ಋಣಪತ್ರಮ್ ಅಸ್ಮಾಕಂ ವಿರುದ್ಧಮ್ ಆಸೀತ್ ತತ್ ಪ್ರಮಾರ್ಜ್ಜಿತವಾನ್ ಶಲಾಕಾಭಿಃ ಕ್ರುಶೇ ಬದ್ಧ್ವಾ ದೂರೀಕೃತವಾಂಶ್ಚ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಕಿಞ್ಚ ತೇನ ರಾಜತ್ವಕರ್ತ್ತೃತ್ವಪದಾನಿ ನಿಸ್ತೇಜಾಂಸಿ ಕೃತ್ವಾ ಪರಾಜಿತಾನ್ ರಿಪೂನಿವ ಪ್ರಗಲ್ಭತಯಾ ಸರ್ವ್ವೇಷಾಂ ದೃಷ್ಟಿಗೋಚರೇ ಹ್ರೇಪಿತವಾನ್|</para>
  <para style="p">
    <verse number="16" style="v"/>ಅತೋ ಹೇತೋಃ ಖಾದ್ಯಾಖಾದ್ಯೇ ಪೇಯಾಪೇಯೇ ಉತ್ಸವಃ ಪ್ರತಿಪದ್ ವಿಶ್ರಾಮವಾರಶ್ಚೈತೇಷು ಸರ್ವ್ವೇಷು ಯುಷ್ಮಾಕಂ ನ್ಯಾಯಾಧಿಪತಿರೂಪಂ ಕಮಪಿ ಮಾ ಗೃಹ್ಲೀತ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಯತ ಏತಾನಿ ಛಾಯಾಸ್ವರೂಪಾಣಿ ಕಿನ್ತು ಸತ್ಯಾ ಮೂರ್ತ್ತಿಃ ಖ್ರೀಷ್ಟಃ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಅಪರಞ್ಚ ನಮ್ರತಾ ಸ್ವರ್ಗದೂತಾನಾಂ ಸೇವಾ ಚೈತಾದೃಶಮ್ ಇಷ್ಟಕರ್ಮ್ಮಾಚರನ್ ಯಃ ಕಶ್ಚಿತ್ ಪರೋಕ್ಷವಿಷಯಾನ್ ಪ್ರವಿಶತಿ ಸ್ವಕೀಯಶಾರೀರಿಕಭಾವೇನ ಚ ಮುಧಾ ಗರ್ವ್ವಿತಃ ಸನ್</para>
  <para style="p">
    <verse number="19" style="v"/>ಸನ್ಧಿಭಿಃ ಶಿರಾಭಿಶ್ಚೋಪಕೃತಂ ಸಂಯುಕ್ತಞ್ಚ ಕೃತ್ಸ್ನಂ ಶರೀರಂ ಯಸ್ಮಾತ್ ಮೂರ್ದ್ಧತ ಈಶ್ವರೀಯವೃದ್ಧಿಂ ಪ್ರಾಪ್ನೋತಿ ತಂ ಮೂರ್ದ್ಧಾನಂ ನ ಧಾರಯತಿ ತೇನ ಮಾನವೇನ ಯುಷ್ಮತ್ತಃ ಫಲಾಪಹರಣಂ ನಾನುಜಾನೀತ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಯದಿ ಯೂಯಂ ಖ್ರೀಷ್ಟೇನ ಸಾರ್ದ್ಧಂ ಸಂಸಾರಸ್ಯ ವರ್ಣಮಾಲಾಯೈ ಮೃತಾ ಅಭವತ ತರ್ಹಿ ಯೈै ರ್ದ್ರವ್ಯೈ ರ್ಭೋಗೇನ ಕ್ಷಯಂ ಗನ್ತವ್ಯಂ</para>
  <para style="p">
    <verse number="21" style="v"/>ತಾನಿ ಮಾ ಸ್ಪೃಶ ಮಾ ಭುಂಕ್ಷ್ವ ಮಾ ಗೃಹಾಣೇತಿ ಮಾನವೈರಾದಿಷ್ಟಾನ್ ಶಿಕ್ಷಿತಾಂಶ್ಚ ವಿಧೀನ್</para>
  <para style="p">
    <verse number="22" style="v"/>ಆಚರನ್ತೋ ಯೂಯಂ ಕುತಃ ಸಂಸಾರೇ ಜೀವನ್ತ ಇವ ಭವಥ?</para>
  <para style="p">
    <verse number="23" style="v"/>ತೇ ವಿಧಯಃ ಸ್ವೇಚ್ಛಾಭಕ್ತ್ಯಾ ನಮ್ರತಯಾ ಶರೀರಕ್ಲೇಶನೇನ ಚ ಜ್ಞಾನವಿಧಿವತ್ ಪ್ರಕಾಶನ್ತೇ ತಥಾಪಿ ತೇಽಗಣ್ಯಾಃ ಶಾರೀರಿಕಭಾವವರ್ದ್ಧಕಾಶ್ಚ ಸನ್ತಿ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಯದಿ ಯೂಯಂ ಖ್ರೀಷ್ಟೇನ ಸಾರ್ದ್ಧಮ್ ಉತ್ಥಾಪಿತಾ ಅಭವತ ತರ್ಹಿ ಯಸ್ಮಿನ್ ಸ್ಥಾನೇ ಖ್ರೀಷ್ಟ ಈಶ್ವರಸ್ಯ ದಕ್ಷಿಣಪಾರ್ಶ್ವೇ ಉಪವಿಷ್ಟ ಆಸ್ತೇ ತಸ್ಯೋರ್ದ್ಧ್ವಸ್ಥಾನಸ್ಯ ವಿಷಯಾನ್ ಚೇಷ್ಟಧ್ವಂ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಪಾರ್ಥಿವವಿಷಯೇಷು ನ ಯತಮಾನಾ ಊರ್ದ್ಧ್ವಸ್ಥವಿಷಯೇಷು ಯತಧ್ವಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಯತೋ ಯೂಯಂ ಮೃತವನ್ತೋ ಯುಷ್ಮಾಕಂ ಜೀವಿತಞ್ಚ ಖ್ರೀಷ್ಟೇನ ಸಾರ್ದ್ಧಮ್ ಈಶ್ವರೇ ಗುಪ್ತಮ್ ಅಸ್ತಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಅಸ್ಮಾಕಂ ಜೀವನಸ್ವರೂಪಃ ಖ್ರೀಷ್ಟೋ ಯದಾ ಪ್ರಕಾಶಿಷ್ಯತೇ ತದಾ ತೇನ ಸಾರ್ದ್ಧಂ ಯೂಯಮಪಿ ವಿಭವೇನ ಪ್ರಕಾಶಿಷ್ಯಧ್ವೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಅತೋ ವೇಶ್ಯಾಗಮನಮ್ ಅಶುಚಿಕ್ರಿಯಾ ರಾಗಃ ಕುತ್ಸಿತಾಭಿಲಾಷೋ ದೇವಪೂಜಾತುಲ್ಯೋ ಲೋಭಶ್ಚೈತಾನಿ ರ್ಪಾिಥವಪುರುಷಸ್ಯಾಙ್ಗಾನಿ ಯುಷ್ಮಾಭಿ ರ್ನಿಹನ್ಯನ್ತಾಂ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಯತ ಏತೇಭ್ಯಃ ಕರ್ಮ್ಮಭ್ಯ ಆಜ್ಞಾಲಙ್ಘಿನೋ ಲೋಕಾನ್ ಪ್ರತೀಶ್ವರಸ್ಯ ಕ್ರೋಧೋ ವರ್ತ್ತತೇ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಪೂರ್ವ್ವಂ ಯದಾ ಯೂಯಂ ತಾನ್ಯುಪಾಜೀವತ ತದಾ ಯೂಯಮಪಿ ತಾನ್ಯೇವಾಚರತ;</para>
  <para style="p">
    <verse number="8" style="v"/>ಕಿನ್ತ್ವಿದಾನೀಂ ಕ್ರೋಧೋ ರೋಷೋ ಜಿಹಿಂಸಿಷಾ ದುರ್ಮುಖತಾ ವದನನಿರ್ಗತಕದಾಲಪಶ್ಚೈತಾನಿ ಸರ್ವ್ವಾಣಿ ದೂರೀಕುರುಧ್ವಂ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಯೂಯಂ ಪರಸ್ಪರಂ ಮೃಷಾಕಥಾಂ ನ ವದತ ಯತೋ ಯೂಯಂ ಸ್ವಕರ್ಮ್ಮಸಹಿತಂ ಪುರಾತನಪುರುಷಂ ತ್ಯಕ್ತವನ್ತಃ</para>
  <para style="p">
    <verse number="10" style="v"/>ಸ್ವಸ್ರಷ್ಟುಃ ಪ್ರತಿಮೂರ್ತ್ಯಾ ತತ್ತ್ವಜ್ಞಾನಾಯ ನೂತನೀಕೃತಂ ನವೀನಪುರುಷಂ ಪರಿಹಿತವನ್ತಶ್ಚ|</para>
  <para style="p">
    <verse number="11" style="v"/>ತೇನ ಚ ಯಿಹೂದಿಭಿನ್ನಜಾತೀಯಯೋಶ್ಛಿನ್ನತ್ವಗಚ್ಛಿನ್ನತ್ವಚೋ ರ್ಮ್ಲೇಚ್ಛಸ್ಕುಥೀಯಯೋ ರ್ದಾಸಮುಕ್ತಯೋಶ್ಚ ಕೋಽಪಿ ವಿಶೇಷೋ ನಾಸ್ತಿ ಕಿನ್ತು ಸರ್ವ್ವೇಷು ಸರ್ವ್ವಃ ಖ್ರೀಷ್ಟ ಏವಾಸ್ತೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಅತಏವ ಯೂಯಮ್ ಈಶ್ವರಸ್ಯ ಮನೋಭಿಲಷಿತಾಃ ಪವಿತ್ರಾಃ ಪ್ರಿಯಾಶ್ಚ ಲೋಕಾ ಇವ ಸ್ನೇಹಯುಕ್ತಾಮ್ ಅನುಕಮ್ಪಾಂ ಹಿತೈಷಿತಾಂ ನಮ್ರತಾಂ ತಿತಿಕ್ಷಾಂ ಸಹಿಷ್ಣುತಾಞ್ಚ ಪರಿಧದ್ಧ್ವಂ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯೂಯಮ್ ಏಕೈಕಸ್ಯಾಚರಣಂ ಸಹಧ್ವಂ ಯೇನ ಚ ಯಸ್ಯ ಕಿಮಪ್ಯಪರಾಧ್ಯತೇ ತಸ್ಯ ತಂ ದೋಷಂ ಸ ಕ್ಷಮತಾಂ, ಖ್ರೀಷ್ಟೋ ಯುಷ್ಮಾಕಂ ದೋಷಾನ್ ಯದ್ವದ್ ಕ್ಷಮಿತವಾನ್ ಯೂಯಮಪಿ ತದ್ವತ್ ಕುರುಧ್ವಂ|</para>
  <para style="p">
    <verse number="14" style="v"/>ವಿಶೇಷತಃ ಸಿದ್ಧಿಜನಕೇನ ಪ್ರೇಮಬನ್ಧನೇನ ಬದ್ಧಾ ಭವತ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಯಸ್ಯಾಃ ಪ್ರಾಪ್ತಯೇ ಯೂಯಮ್ ಏಕಸ್ಮಿನ್ ಶರೀರೇ ಸಮಾಹೂತಾ ಅಭವತ ಸೇಶ್ವರೀಯಾ ಶಾನ್ತಿ ರ್ಯುಷ್ಮಾಕಂ ಮನಾಂಸ್ಯಧಿತಿಷ್ಠತು ಯೂಯಞ್ಚ ಕೃತಜ್ಞಾ ಭವತ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಖ್ರೀಷ್ಟಸ್ಯ ವಾಕ್ಯಂ ಸರ್ವ್ವವಿಧಜ್ಞಾನಾಯ ಸಮ್ಪೂರ್ಣರೂಪೇಣ ಯುಷ್ಮದನ್ತರೇ ನಿವಮತು, ಯೂಯಞ್ಚ ಗೀತೈ ರ್ಗಾನೈಃ ಪಾರಮಾರ್ಥಿಕಸಙ್ಕೀರ್ತ್ತನೈಶ್ಚ ಪರಸ್ಪರಮ್ ಆದಿಶತ ಪ್ರಬೋಧಯತ ಚ, ಅನುಗೃಹೀತತ್ವಾತ್ ಪ್ರಭುಮ್ ಉದ್ದಿಶ್ಯ ಸ್ವಮನೋಭಿ ರ್ಗಾಯತ ಚ|</para>
  <para style="p">
    <verse number="17" style="v"/>ವಾಚಾ ಕರ್ಮ್ಮಣಾ ವಾ ಯದ್ ಯತ್ ಕುರುತ ತತ್ ಸರ್ವ್ವಂ ಪ್ರಭೋ ರ್ಯೀಶೋ ರ್ನಾಮ್ನಾ ಕುರುತ ತೇನ ಪಿತರಮ್ ಈಶ್ವರಂ ಧನ್ಯಂ ವದತ ಚ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಹೇ ಯೋಷಿತಃ, ಯೂಯಂ ಸ್ವಾಮಿನಾಂ ವಶ್ಯಾ ಭವತ ಯತಸ್ತದೇವ ಪ್ರಭವೇ ರೋಚತೇ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಹೇ ಸ್ವಾಮಿನಃ, ಯೂಯಂ ಭಾರ್ಯ್ಯಾಸು ಪ್ರೀಯಧ್ವಂ ತಾಃ ಪ್ರತಿ ಪರುಷಾಲಾಪಂ ಮಾ ಕುರುಧ್ವಂ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಹೇ ಬಾಲಾಃ, ಯೂಯಂ ಸರ್ವ್ವವಿಷಯೇ ಪಿತ್ರೋರಾಜ್ಞಾಗ್ರಾಹಿಣೋ ಭವತ ಯತಸ್ತದೇವ ಪ್ರಭೋಃ ಸನ್ತೋಷಜನಕಂ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಹೇ ಪಿತರಃ, ಯುಷ್ಮಾಕಂ ಸನ್ತಾನಾ ಯತ್ ಕಾತರಾ ನ ಭವೇಯುಸ್ತದರ್ಥಂ ತಾನ್ ಪ್ರತಿ ಮಾ ರೋಷಯತ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಹೇ ದಾಸಾಃ, ಯೂಯಂ ಸರ್ವ್ವವಿಷಯ ಐಹಿಕಪ್ರಭೂನಾಮ್ ಆಜ್ಞಾಗ್ರಾಹಿಣೋ ಭವತ ದೃಷ್ಟಿಗೋಚರೀಯಸೇವಯಾ ಮಾನವೇಭ್ಯೋ ರೋಚಿತುಂ ಮಾ ಯತಧ್ವಂ ಕಿನ್ತು ಸರಲಾನ್ತಃಕರಣೈಃ ಪ್ರಭೋ ರ್ಭಾीತ್ಯಾ ಕಾರ್ಯ್ಯಂ ಕುರುಧ್ವಂ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಯಚ್ಚ ಕುರುಧ್ವೇ ತತ್ ಮಾನುಷಮನುದ್ದಿಶ್ಯ ಪ್ರಭುಮ್ ಉದ್ದಿಶ್ಯ ಪ್ರಫುಲ್ಲಮನಸಾ ಕುರುಧ್ವಂ,</para>
  <para style="p">
    <verse number="24" style="v"/>ಯತೋ ವಯಂ ಪ್ರಭುತಃ ಸ್ವರ್ಗಾಧಿಕಾರರೂಪಂ ಫಲಂ ಲಪ್ಸ್ಯಾಮಹ ಇತಿ ಯೂಯಂ ಜಾನೀಥ ಯಸ್ಮಾದ್ ಯೂಯಂ ಪ್ರಭೋಃ ಖ್ರೀಷ್ಟಸ್ಯ ದಾಸಾ ಭವಥ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಕಿನ್ತು ಯಃ ಕಶ್ಚಿದ್ ಅನುಚಿತಂ ಕರ್ಮ್ಮ ಕರೋತಿ ಸ ತಸ್ಯಾನುಚಿತಕರ್ಮ್ಮಣಃ ಫಲಂ ಲಪ್ಸ್ಯತೇ ತತ್ರ ಕೋಽಪಿ ಪಕ್ಷಪಾತೋ ನ ಭವಿಷ್ಯತಿ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅಪರಞ್ಚ ಹೇ ಅಧಿಪತಯಃ, ಯೂಯಂ ದಾಸಾನ್ ಪ್ರತಿ ನ್ಯಾಯ್ಯಂ ಯಥಾರ್ಥಞ್ಚಾಚರಣಂ ಕುರುಧ್ವಂ ಯುಷ್ಮಾಕಮಪ್ಯೇಕೋಽಧಿಪತಿಃ ಸ್ವರ್ಗೇ ವಿದ್ಯತ ಇತಿ ಜಾನೀತ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯೂಯಂ ಪ್ರಾರ್ಥನಾಯಾಂ ನಿತ್ಯಂ ಪ್ರವರ್ತ್ತಧ್ವಂ ಧನ್ಯವಾದಂ ಕುರ್ವ್ವನ್ತಸ್ತತ್ರ ಪ್ರಬುದ್ಧಾಸ್ತಿಷ್ಠತ ಚ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಪ್ರಾರ್ಥನಾಕಾಲೇ ಮಮಾಪಿ ಕೃತೇ ಪ್ರಾರ್ಥನಾಂ ಕುರುಧ್ವಂ,</para>
  <para style="p">
    <verse number="4" style="v"/>ಫಲತಃ ಖ್ರೀಷ್ಟಸ್ಯ ಯನ್ನಿಗೂಢವಾಕ್ಯಕಾರಣಾದ್ ಅಹಂ ಬದ್ಧೋಽಭವಂ ತತ್ಪ್ರಕಾಶಾಯೇಶ್ವರೋ ಯತ್ ಮದರ್ಥಂ ವಾಗ್ದ್ವಾರಂ ಕುರ್ಯ್ಯಾತ್, ಅಹಞ್ಚ ಯಥೋಚಿತಂ ತತ್ ಪ್ರಕಾಶಯಿತುಂ ಶಕ್ನುಯಾಮ್ ಏತತ್ ಪ್ರಾರ್ಥಯಧ್ವಂ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯೂಯಂ ಸಮಯಂ ಬಹುಮೂಲ್ಯಂ ಜ್ಞಾತ್ವಾ ಬಹಿಃಸ್ಥಾನ್ ಲೋಕಾನ್ ಪ್ರತಿ ಜ್ಞಾನಾಚಾರಂ ಕುರುಧ್ವಂ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಯುಷ್ಮಾಕಮ್ ಆಲಾಪಃ ಸರ್ವ್ವದಾನುಗ್ರಹಸೂಚಕೋ ಲವಣೇನ ಸುಸ್ವಾದುಶ್ಚ ಭವತು ಯಸ್ಮೈ ಯದುತ್ತರಂ ದಾತವ್ಯಂ ತದ್ ಯುಷ್ಮಾಭಿರವಗಮ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಮಮ ಯಾ ದಶಾಕ್ತಿ ತಾಂ ತುಖಿಕನಾಮಾ ಪ್ರಭೌ ಪ್ರಿಯೋ ಮಮ ಭ್ರಾತಾ ವಿಶ್ವಸನೀಯಃ ಪರಿಚಾರಕಃ ಸಹದಾಸಶ್ಚ ಯುಷ್ಮಾನ್ ಜ್ಞಾಪಯಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಸ ಯದ್ ಯುಷ್ಮಾಕಂ ದಶಾಂ ಜಾನೀಯಾತ್ ಯುಷ್ಮಾಕಂ ಮನಾಂಸಿ ಸಾನ್ತ್ವಯೇಚ್ಚ ತದರ್ಥಮೇವಾಹಂ</para>
  <para style="p">
    <verse number="9" style="v"/>ತಮ್ ಓನೀಷಿಮನಾಮಾನಞ್ಚ ಯುಷ್ಮದ್ದೇಶೀಯಂ ವಿಶ್ವಸ್ತಂ ಪ್ರಿಯಞ್ಚ ಭ್ರಾತರಂ ಪ್ರೇಷಿತವಾನ್ ತೌ ಯುಷ್ಮಾನ್ ಅತ್ರತ್ಯಾಂ ಸರ್ವ್ವವಾರ್ತ್ತಾಂ ಜ್ಞಾಪಯಿಷ್ಯತಃ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಆರಿಷ್ಟಾರ್ಖನಾಮಾ ಮಮ ಸಹಬನ್ದೀ ಬರ್ಣಬ್ಬಾ ಭಾಗಿನೇಯೋ ಮಾರ್ಕೋ ಯುಷ್ಟನಾಮ್ನಾ ವಿಖ್ಯಾತೋ ಯೀಶುಶ್ಚೈತೇ ಛಿನ್ನತ್ವಚೋ ಭ್ರಾತರೋ ಯುಷ್ಮಾನ್ ನಮಸ್ಕಾರಂ ಜ್ಞಾಪಯನ್ತಿ, ತೇಷಾಂ ಮಧ್ಯೇ ಮಾರ್ಕಮಧಿ ಯೂಯಂ ಪೂರ್ವ್ವಮ್ ಆಜ್ಞಾಪಿತಾಃ ಸ ಯದಿ ಯುಷ್ಮತ್ಸಮೀಪಮ್ ಉಪತಿಷ್ಠೇತ್ ತರ್ಹಿ ಯುಷ್ಮಾಭಿ ರ್ಗೃಹ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಕೇವಲಮೇತ ಈಶ್ವರರಾಜ್ಯೇ ಮಮ ಸಾನ್ತ್ವನಾಜನಕಾಃ ಸಹಕಾರಿಣೋಽಭವನ್|</para>
  <para style="p">
    <verse number="12" style="v"/>ಖ್ರೀಷ್ಟಸ್ಯ ದಾಸೋ ಯೋ ಯುಷ್ಮದ್ದೇಶೀಯ ಇಪಫ್ರಾಃ ಸ ಯುಷ್ಮಾನ್ ನಮಸ್ಕಾರಂ ಜ್ಞಾಪಯತಿ ಯೂಯಞ್ಚೇಶ್ವರಸ್ಯ ಸರ್ವ್ವಸ್ಮಿನ್ ಮನೋಽಭಿಲಾಷೇ ಯತ್ ಸಿದ್ಧಾಃ ಪೂರ್ಣಾಶ್ಚ ಭವೇತ ತದರ್ಥಂ ಸ ನಿತ್ಯಂ ಪ್ರಾರ್ಥನಯಾ ಯುಷ್ಮಾಕಂ ಕೃತೇ ಯತತೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯುಷ್ಮಾಕಂ ಲಾಯದಿಕೇಯಾಸ್ಥಿತಾನಾಂ ಹಿಯರಾಪಲಿಸ್ಥಿತಾನಾಞ್ಚ ಭ್ರಾತೃಣಾಂ ಹಿತಾಯ ಸೋಽತೀವ ಚೇಷ್ಟತ ಇತ್ಯಸ್ಮಿನ್ ಅಹಂ ತಸ್ಯ ಸಾಕ್ಷೀ ಭವಾಮಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಲೂಕನಾಮಾ ಪ್ರಿಯಶ್ಚಿಕಿತ್ಸಕೋ ದೀಮಾಶ್ಚ ಯುಷ್ಮಭ್ಯಂ ನಮಸ್ಕುರ್ವ್ವಾತೇ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಯೂಯಂ ಲಾಯದಿಕೇಯಾಸ್ಥಾನ್ ಭ್ರಾತೃನ್ ನುಮ್ಫಾಂ ತದ್ಗೃಹಸ್ಥಿತಾಂ ಸಮಿತಿಞ್ಚ ಮಮ ನಮಸ್ಕಾರಂ ಜ್ಞಾಪಯತ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಅಪರಂ ಯುಷ್ಮತ್ಸನ್ನಿಧೌ ಪತ್ರಸ್ಯಾಸ್ಯ ಪಾಠೇ ಕೃತೇ ಲಾಯದಿಕೇಯಾಸ್ಥಸಮಿತಾವಪಿ ತಸ್ಯ ಪಾಠೋ ಯಥಾ ಭವೇತ್ ಲಾಯದಿಕೇಯಾಞ್ಚ ಯತ್ ಪತ್ರಂ ಮಯಾ ಪ್ರಹಿತಂ ತದ್ ಯಥಾ ಯುಷ್ಮಾಭಿರಪಿ ಪಠ್ಯೇತ ತಥಾ ಚೇಷ್ಟಧ್ವಂ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಅಪರಮ್ ಆರ್ಖಿಪ್ಪಂ ವದತ ಪ್ರಭೋ ರ್ಯತ್ ಪರಿಚರ್ಯ್ಯಾಪದಂ ತ್ವಯಾಪ್ರಾಪಿ ತತ್ಸಾಧನಾಯ ಸಾವಧಾನೋ ಭವ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಅಹಂ ಪೌಲಃ ಸ್ವಹಸ್ತಾಕ್ಷರೇಣ ಯುಷ್ಮಾನ್ ನಮಸ್ಕಾರಂ ಜ್ಞಾಪಯಾಮಿ ಯೂಯಂ ಮಮ ಬನ್ಧನಂ ಸ್ಮರತ| ಯುಷ್ಮಾನ್ ಪ್ರತ್ಯನುಗ್ರಹೋ ಭೂಯಾತ್| ಆಮೇನ|</para>
</usx>
