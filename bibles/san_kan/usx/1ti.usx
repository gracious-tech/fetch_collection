<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1TI" style="id">Sanskrit Bible (NT) in Kannada Script (ಸತ್ಯವೇದಃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 Timothy</para>
  <para style="toc1">೧ ತೀಮಥಿಯಂ ಪತ್ರಂ</para>
  <para style="toc2">೧ ತೀಮಥಿಯಃ</para>
  <para style="toc3">೧ ತೀಮಥಿಯಃ</para>
  <para style="mt1">೧ ತೀಮಥಿಯಂ ಪತ್ರಂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅಸ್ಮಾಕಂ ತ್ರಾಣಕರ್ತ್ತುರೀಶ್ವರಸ್ಯಾಸ್ಮಾಕಂ ಪ್ರತ್ಯಾಶಾಭೂಮೇಃ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಚಾಜ್ಞಾನುಸಾರತೋ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಪ್ರೇರಿತಃ ಪೌಲಃ ಸ್ವಕೀಯಂ ಸತ್ಯಂ ಧರ್ಮ್ಮಪುತ್ರಂ ತೀಮಥಿಯಂ ಪ್ರತಿ ಪತ್ರಂ ಲಿಖತಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಅಸ್ಮಾಕಂ ತಾತ ಈಶ್ವರೋಽಸ್ಮಾಕಂ ಪ್ರಭು ರ್ಯೀಶುಖ್ರೀಷ್ಟಶ್ಚ ತ್ವಯಿ ಅನುಗ್ರಹಂ ದಯಾಂ ಶಾನ್ತಿಞ್ಚ ಕುರ್ಯ್ಯಾಸ್ತಾಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಮಾಕಿದನಿಯಾದೇಶೇ ಮಮ ಗಮನಕಾಲೇ ತ್ವಮ್ ಇಫಿಷನಗರೇ ತಿಷ್ಠನ್ ಇತರಶಿಕ್ಷಾ ನ ಗ್ರಹೀತವ್ಯಾ, ಅನನ್ತೇಷೂಪಾಖ್ಯಾನೇಷು ವಂಶಾವಲಿಷು ಚ ಯುಷ್ಮಾಭಿ ರ್ಮನೋ ನ ನಿವೇಶಿತವ್ಯಮ್</para>
  <para style="p">
    <verse number="4" style="v"/>ಇತಿ ಕಾಂಶ್ಚಿತ್ ಲೋಕಾನ್ ಯದ್ ಉಪದಿಶೇರೇತತ್ ಮಯಾದಿಷ್ಟೋಽಭವಃ, ಯತಃ ಸರ್ವ್ವೈರೇತೈ ರ್ವಿಶ್ವಾಸಯುಕ್ತೇಶ್ವರೀಯನಿಷ್ಠಾ ನ ಜಾಯತೇ ಕಿನ್ತು ವಿವಾದೋ ಜಾಯತೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಉಪದೇಶಸ್ಯ ತ್ವಭಿಪ್ರೇತಂ ಫಲಂ ನಿರ್ಮ್ಮಲಾನ್ತಃಕರಣೇನ ಸತ್ಸಂವೇದೇನ ನಿಷ್ಕಪಟವಿಶ್ವಾಸೇನ ಚ ಯುಕ್ತಂ ಪ್ರೇಮ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಕೇಚಿತ್ ಜನಾಶ್ಚ ಸರ್ವ್ವಾಣ್ಯೇತಾನಿ ವಿಹಾಯ ನಿರರ್ಥಕಕಥಾನಾಮ್ ಅನುಗಮನೇನ ವಿಪಥಗಾಮಿನೋಽಭವನ್,</para>
  <para style="p">
    <verse number="7" style="v"/>ಯದ್ ಭಾಷನ್ತೇ ಯಚ್ಚ ನಿಶ್ಚಿನ್ವನ್ತಿ ತನ್ನ ಬುಧ್ಯಮಾನಾ ವ್ಯವಸ್ಥೋಪದೇಷ್ಟಾರೋ ಭವಿತುಮ್ ಇಚ್ಛನ್ತಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಸಾ ವ್ಯವಸ್ಥಾ ಯದಿ ಯೋಗ್ಯರೂಪೇಣ ಗೃಹ್ಯತೇ ತರ್ಹ್ಯುತ್ತಮಾ ಭವತೀತಿ ವಯಂ ಜಾನೀಮಃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಅಪರಂ ಸಾ ವ್ಯವಸ್ಥಾ ಧಾರ್ಮ್ಮಿಕಸ್ಯ ವಿರುದ್ಧಾ ನ ಭವತಿ ಕಿನ್ತ್ವಧಾರ್ಮ್ಮಿಕೋ ಽವಾಧ್ಯೋ ದುಷ್ಟಃ ಪಾಪಿಷ್ಠೋ ಽಪವಿತ್ರೋ ಽಶುಚಿಃ ಪಿತೃಹನ್ತಾ ಮಾತೃಹನ್ತಾ ನರಹನ್ತಾ</para>
  <para style="p">
    <verse number="10" style="v"/>ವೇಶ್ಯಾಗಾಮೀ ಪುಂಮೈಥುನೀ ಮನುಷ್ಯವಿಕ್ರೇತಾ ಮಿಥ್ಯಾವಾದೀ ಮಿಥ್ಯಾಶಪಥಕಾರೀ ಚ ಸರ್ವ್ವೇಷಾಮೇತೇಷಾಂ ವಿರುದ್ಧಾ,</para>
  <para style="p">
    <verse number="11" style="v"/>ತಥಾ ಸಚ್ಚಿದಾನನ್ದೇಶ್ವರಸ್ಯ ಯೋ ವಿಭವಯುಕ್ತಃ ಸುಸಂವಾದೋ ಮಯಿ ಸಮರ್ಪಿತಸ್ತದನುಯಾಯಿಹಿತೋಪದೇಶಸ್ಯ ವಿಪರೀತಂ ಯತ್ ಕಿಞ್ಚಿದ್ ಭವತಿ ತದ್ವಿರುದ್ಧಾ ಸಾ ವ್ಯವಸ್ಥೇತಿ ತದ್ಗ್ರಾಹಿಣಾ ಜ್ಞಾತವ್ಯಂ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಮಹ್ಯಂ ಶಕ್ತಿದಾತಾ ಯೋಽಸ್ಮಾಕಂ ಪ್ರಭುಃ ಖ್ರೀಷ್ಟಯೀಶುಸ್ತಮಹಂ ಧನ್ಯಂ ವದಾಮಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯತಃ ಪುರಾ ನಿನ್ದಕ ಉಪದ್ರಾವೀ ಹಿಂಸಕಶ್ಚ ಭೂತ್ವಾಪ್ಯಹಂ ತೇನ ವಿಶ್ವಾಸ್ಯೋ ಽಮನ್ಯೇ ಪರಿಚಾರಕತ್ವೇ ನ್ಯಯುಜ್ಯೇ ಚ| ತದ್ ಅವಿಶ್ವಾಸಾಚರಣಮ್ ಅಜ್ಞಾನೇನ ಮಯಾ ಕೃತಮಿತಿ ಹೇತೋರಹಂ ತೇನಾನುಕಮ್ಪಿತೋಽಭವಂ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಅಪರಂ ಖ್ರೀಷ್ಟೇ ಯೀಶೌ ವಿಶ್ವಾಸಪ್ರೇಮಭ್ಯಾಂ ಸಹಿತೋಽಸ್ಮತ್ಪ್ರಭೋರನುಗ್ರಹೋ ಽತೀವ ಪ್ರಚುರೋಽಭತ್|</para>
  <para style="p">
    <verse number="15" style="v"/>ಪಾಪಿನಃ ಪರಿತ್ರಾತುಂ ಖ್ರೀಷ್ಟೋ ಯೀಶು ರ್ಜಗತಿ ಸಮವತೀರ್ಣೋಽಭವತ್, ಏಷಾ ಕಥಾ ವಿಶ್ವಾಸನೀಯಾ ಸರ್ವ್ವೈ ಗ್ರಹಣೀಯಾ ಚ|</para>
  <para style="p">
    <verse number="16" style="v"/>ತೇಷಾಂ ಪಾಪಿನಾಂ ಮಧ್ಯೇಽಹಂ ಪ್ರಥಮ ಆಸಂ ಕಿನ್ತು ಯೇ ಮಾನವಾ ಅನನ್ತಜೀವನಪ್ರಾಪ್ತ್ಯರ್ಥಂ ತಸ್ಮಿನ್ ವಿಶ್ವಸಿಷ್ಯನ್ತಿ ತೇಷಾಂ ದೃಷ್ಟಾನ್ತೇ ಮಯಿ ಪ್ರಥಮೇ ಯೀಶುನಾ ಖ್ರೀಷ್ಟೇನ ಸ್ವಕೀಯಾ ಕೃತ್ಸ್ನಾ ಚಿರಸಹಿಷ್ಣುತಾ ಯತ್ ಪ್ರಕಾಶ್ಯತೇ ತದರ್ಥಮೇವಾಹಮ್ ಅನುಕಮ್ಪಾಂ ಪ್ರಾಪ್ತವಾನ್|</para>
  <para style="p">
    <verse number="17" style="v"/>ಅನಾದಿರಕ್ಷಯೋಽದೃಶ್ಯೋ ರಾಜಾ ಯೋಽದ್ವಿತೀಯಃ ಸರ್ವ್ವಜ್ಞ ಈಶ್ವರಸ್ತಸ್ಯ ಗೌರವಂ ಮಹಿಮಾ ಚಾನನ್ತಕಾಲಂ ಯಾವದ್ ಭೂಯಾತ್| ಆಮೇನ್|</para>
  <para style="p">
    <verse number="18" style="v"/>ಹೇ ಪುತ್ರ ತೀಮಥಿಯ ತ್ವಯಿ ಯಾನಿ ಭವಿಷ್ಯದ್ವಾಕ್ಯಾನಿ ಪುರಾ ಕಥಿತಾನಿ ತದನುಸಾರಾದ್ ಅಹಮ್ ಏನಮಾದೇಶಂ ತ್ವಯಿ ಸಮರ್ಪಯಾಮಿ, ತಸ್ಯಾಭಿಪ್ರಾಯೋಽಯಂ ಯತ್ತ್ವಂ ತೈ ರ್ವಾಕ್ಯೈರುತ್ತಮಯುದ್ಧಂ ಕರೋಷಿ</para>
  <para style="p">
    <verse number="19" style="v"/>ವಿಶ್ವಾಸಂ ಸತ್ಸಂವೇದಞ್ಚ ಧಾರಯಸಿ ಚ| ಅನಯೋಃ ಪರಿತ್ಯಾಗಾತ್ ಕೇಷಾಞ್ಚಿದ್ ವಿಶ್ವಾಸತರೀ ಭಗ್ನಾಭವತ್|</para>
  <para style="p">
    <verse number="20" style="v"/>ಹುಮಿನಾಯಸಿಕನ್ದರೌ ತೇಷಾಂ ಯೌ ದ್ವೌ ಜನೌ, ತೌ ಯದ್ ಧರ್ಮ್ಮನಿನ್ದಾಂ ಪುನ ರ್ನ ಕರ್ತ್ತುಂ ಶಿಕ್ಷೇತೇ ತದರ್ಥಂ ಮಯಾ ಶಯತಾನಸ್ಯ ಕರೇ ಸಮರ್ಪಿತೌ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಮಮ ಪ್ರಥಮ ಆದೇಶೋಽಯಂ, ಪ್ರಾರ್ಥನಾವಿನಯನಿವೇದನಧನ್ಯವಾದಾಃ ಕರ್ತ್ತವ್ಯಾಃ,</para>
  <para style="p">
    <verse number="2" style="v"/>ಸರ್ವ್ವೇಷಾಂ ಮಾನವಾನಾಂ ಕೃತೇ ವಿಶೇಷತೋ ವಯಂ ಯತ್ ಶಾನ್ತತ್ವೇನ ನಿರ್ವ್ವಿರೋಧತ್ವೇನ ಚೇಶ್ಚರಭಕ್ತಿಂ ವಿನೀತತ್ವಞ್ಚಾಚರನ್ತಃ ಕಾಲಂ ಯಾಪಯಾಮಸ್ತದರ್ಥಂ ನೃಪತೀನಾಮ್ ಉಚ್ಚಪದಸ್ಥಾನಾಞ್ಚ ಕೃತೇ ತೇ ಕರ್ತ್ತವ್ಯಾಃ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಯತೋಽಸ್ಮಾಕಂ ತಾರಕಸ್ಯೇಶ್ವರಸ್ಯ ಸಾಕ್ಷಾತ್ ತದೇವೋತ್ತಮಂ ಗ್ರಾಹ್ಯಞ್ಚ ಭವತಿ,</para>
  <para style="p">
    <verse number="4" style="v"/>ಸ ಸರ್ವ್ವೇಷಾಂ ಮಾನವಾನಾಂ ಪರಿತ್ರಾಣಂ ಸತ್ಯಜ್ಞಾನಪ್ರಾಪ್ತಿಞ್ಚೇಚ್ಛತಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯತ ಏಕೋಽದ್ವಿತೀಯ ಈಶ್ವರೋ ವಿದ್ಯತೇ ಕಿಞ್ಚೇಶ್ವರೇ ಮಾನವೇಷು ಚೈಕೋ ಽದ್ವಿತೀಯೋ ಮಧ್ಯಸ್ಥಃ</para>
  <para style="p">
    <verse number="6" style="v"/>ಸ ನರಾವತಾರಃ ಖ್ರೀಷ್ಟೋ ಯೀಶು ರ್ವಿದ್ಯತೇ ಯಃ ಸರ್ವ್ವೇಷಾಂ ಮುಕ್ತೇ ರ್ಮೂಲ್ಯಮ್ ಆತ್ಮದಾನಂ ಕೃತವಾನ್| ಏತೇನ ಯೇನ ಪ್ರಮಾಣೇನೋಪಯುಕ್ತೇ ಸಮಯೇ ಪ್ರಕಾಶಿತವ್ಯಂ,</para>
  <para style="p">
    <verse number="7" style="v"/>ತದ್ಘೋಷಯಿತಾ ದೂತೋ ವಿಶ್ವಾಸೇ ಸತ್ಯಧರ್ಮ್ಮೇ ಚ ಭಿನ್ನಜಾತೀಯಾನಾಮ್ ಉಪದೇಶಕಶ್ಚಾಹಂ ನ್ಯಯೂಜ್ಯೇ, ಏತದಹಂ ಖ್ರೀಷ್ಟಸ್ಯ ನಾಮ್ನಾ ಯಥಾತಥ್ಯಂ ವದಾಮಿ ನಾನೃತಂ ಕಥಯಾಮಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಅತೋ ಮಮಾಭಿಮತಮಿದಂ ಪುರುಷೈಃ ಕ್ರೋಧಸನ್ದೇಹೌ ವಿನಾ ಪವಿತ್ರಕರಾನ್ ಉತ್ತೋಲ್ಯ ಸರ್ವ್ವಸ್ಮಿನ್ ಸ್ಥಾನೇ ಪ್ರಾರ್ಥನಾ ಕ್ರಿಯತಾಂ|</para>
  <para style="p">
    <verse number="9" style="v"/>ತದ್ವತ್ ನಾರ್ಯ್ಯೋಽಪಿ ಸಲಜ್ಜಾಃ ಸಂಯತಮನಸಶ್ಚ ಸತ್ಯೋ ಯೋಗ್ಯಮಾಚ್ಛಾದನಂ ಪರಿದಧತು ಕಿಞ್ಚ ಕೇಶಸಂಸ್ಕಾರೈಃ ಕಣಕಮುಕ್ತಾಭಿ ರ್ಮಹಾರ್ಘ್ಯಪರಿಚ್ಛದೈಶ್ಚಾತ್ಮಭೂಷಣಂ ನ ಕುರ್ವ್ವತ್ಯಃ</para>
  <para style="p">
    <verse number="10" style="v"/>ಸ್ವೀಕೃತೇಶ್ವರಭಕ್ತೀನಾಂ ಯೋಷಿತಾಂ ಯೋಗ್ಯೈಃ ಸತ್ಯರ್ಮ್ಮಭಿಃ ಸ್ವಭೂಷಣಂ ಕುರ್ವ್ವತಾಂ|</para>
  <para style="p">
    <verse number="11" style="v"/>ನಾರೀ ಸಮ್ಪೂರ್ಣವಿನೀತತ್ವೇನ ನಿರ್ವಿರೋಧಂ ಶಿಕ್ಷತಾಂ|</para>
  <para style="p">
    <verse number="12" style="v"/>ನಾರ್ಯ್ಯಾಃ ಶಿಕ್ಷಾದಾನಂ ಪುರುಷಾಯಾಜ್ಞಾದಾನಂ ವಾಹಂ ನಾನುಜಾನಾಮಿ ತಯಾ ನಿರ್ವ್ವಿರೋेಧತ್ವಮ್ ಆಚರಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯತಃ ಪ್ರಥಮಮ್ ಆದಮಸ್ತತಃ ಪರಂ ಹವಾಯಾಃ ಸೃಷ್ಟಿ ರ್ಬಭೂವ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಕಿಞ್ಚಾದಮ್ ಭ್ರಾನ್ತಿಯುಕ್ತೋ ನಾಭವತ್ ಯೋಷಿದೇವ ಭ್ರಾನ್ತಿಯುಕ್ತಾ ಭೂತ್ವಾತ್ಯಾಚಾರಿಣೀ ಬಭೂವ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತಥಾಪಿ ನಾರೀಗಣೋ ಯದಿ ವಿಶ್ವಾಸೇ ಪ್ರೇಮ್ನಿ ಪವಿತ್ರತಾಯಾಂ ಸಂಯತಮನಸಿ ಚ ತಿಷ್ಠತಿ ತರ್ಹ್ಯಪತ್ಯಪ್ರಸವವರ್ತ್ಮನಾ ಪರಿತ್ರಾಣಂ ಪ್ರಾಪ್ಸ್ಯತಿ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಯದಿ ಕಶ್ಚಿದ್ ಅಧ್ಯಕ್ಷಪದಮ್ ಆಕಾಙ್ಕ್ಷತೇ ತರ್ಹಿ ಸ ಉತ್ತಮಂ ಕರ್ಮ್ಮ ಲಿಪ್ಸತ ಇತಿ ಸತ್ಯಂ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಅತೋಽಧ್ಯಕ್ಷೇಣಾನಿನ್ದಿತೇನೈಕಸ್ಯಾ ಯೋಷಿತೋ ಭರ್ತ್ರಾ ಪರಿಮಿತಭೋಗೇನ ಸಂಯತಮನಸಾ ಸಭ್ಯೇನಾತಿಥಿಸೇವಕೇನ ಶಿಕ್ಷಣೇ ನಿಪುಣೇನ</para>
  <para style="p">
    <verse number="3" style="v"/>ನ ಮದ್ಯಪೇನ ನ ಪ್ರಹಾರಕೇಣ ಕಿನ್ತು ಮೃದುಭಾವೇನ ನಿರ್ವ್ವಿವಾದೇನ ನಿರ್ಲೋಭೇನ</para>
  <para style="p">
    <verse number="4" style="v"/>ಸ್ವಪರಿವಾರಾಣಾಮ್ ಉತ್ತಮಶಾಸಕೇನ ಪೂರ್ಣವಿನೀತತ್ವಾದ್ ವಶ್ಯಾನಾಂ ಸನ್ತಾನಾನಾಂ ನಿಯನ್ತ್ರಾ ಚ ಭವಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯತ ಆತ್ಮಪರಿವಾರಾನ್ ಶಾಸಿತುಂ ಯೋ ನ ಶಕ್ನೋತಿ ತೇನೇಶ್ವರಸ್ಯ ಸಮಿತೇಸ್ತತ್ತ್ವಾವಧಾರಣಂ ಕಥಂ ಕಾರಿಷ್ಯತೇ?</para>
  <para style="p">
    <verse number="6" style="v"/>ಅಪರಂ ಸ ಗರ್ವ್ವಿತೋ ಭೂತ್ವಾ ಯತ್ ಶಯತಾನ ಇವ ದಣ್ಡಯೋಗ್ಯೋ ನ ಭವೇತ್ ತದರ್ಥಂ ತೇನ ನವಶಿಷ್ಯೇಣ ನ ಭವಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯಚ್ಚ ನಿನ್ದಾಯಾಂ ಶಯತಾನಸ್ಯ ಜಾಲೇ ಚ ನ ಪತೇತ್ ತದರ್ಥಂ ತೇನ ಬಹಿಃಸ್ಥಲೋಕಾನಾಮಪಿ ಮಧ್ಯೇ ಸುಖ್ಯಾತಿಯುಕ್ತೇನ ಭವಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="8" style="v"/>ತದ್ವತ್ ಪರಿಚಾರಕೈರಪಿ ವಿನೀತೈ ರ್ದ್ವಿವಿಧವಾಕ್ಯರಹಿತೈ ರ್ಬಹುಮದ್ಯಪಾನೇ ಽನಾಸಕ್ತೈ ರ್ನಿರ್ಲೋಭೈಶ್ಚ ಭವಿತವ್ಯಂ,</para>
  <para style="p">
    <verse number="9" style="v"/>ನಿರ್ಮ್ಮಲಸಂವೇದೇನ ಚ ವಿಶ್ವಾಸಸ್ಯ ನಿಗೂಢವಾಕ್ಯಂ ಧಾತಿವ್ಯಞ್ಚ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಅಗ್ರೇ ತೇಷಾಂ ಪರೀಕ್ಷಾ ಕ್ರಿಯತಾಂ ತತಃ ಪರಮ್ ಅನಿನ್ದಿತಾ ಭೂತ್ವಾ ತೇ ಪರಿಚರ್ಯ್ಯಾಂ ಕುರ್ವ್ವನ್ತು|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅಪರಂ ಯೋಷಿದ್ಭಿರಪಿ ವಿನೀತಾಭಿರನಪವಾದಿಕಾಭಿಃ ಸತರ್ಕಾಭಿಃ ಸರ್ವ್ವತ್ರ ವಿಶ್ವಾಸ್ಯಾಭಿಶ್ಚ ಭವಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಪರಿಚಾರಕಾ ಏಕೈಕಯೋಷಿತೋ ಭರ್ತ್ತಾರೋ ಭವೇಯುಃ, ನಿಜಸನ್ತಾನಾನಾಂ ಪರಿಜನಾನಾಞ್ಚ ಸುಶಾಸನಂ ಕುರ್ಯ್ಯುಶ್ಚ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯತಃ ಸಾ ಪರಿಚರ್ಯ್ಯಾ ಯೈ ರ್ಭದ್ರರೂಪೇಣ ಸಾಧ್ಯತೇ ತೇ ಶ್ರೇಷ್ಠಪದಂ ಪ್ರಾಪ್ನುವನ್ತಿ ಖ್ರೀಷ್ಟೇ ಯೀಶೌ ವಿಶ್ವಾಸೇನ ಮಹೋತ್ಸುಕಾ ಭವನ್ತಿ ಚ|</para>
  <para style="p">
    <verse number="14" style="v"/>ತ್ವಾಂ ಪ್ರತ್ಯೇತತ್ಪತ್ರಲೇಖನಸಮಯೇ ಶೀಘ್ರಂ ತ್ವತ್ಸಮೀಪಗಮನಸ್ಯ ಪ್ರತ್ಯಾಶಾ ಮಮ ವಿದ್ಯತೇ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಯದಿ ವಾ ವಿಲಮ್ಬೇಯ ತರ್ಹೀಶ್ವರಸ್ಯ ಗೃಹೇ ಽರ್ಥತಃ ಸತ್ಯಧರ್ಮ್ಮಸ್ಯ ಸ್ತಮ್ಭಭಿತ್ತಿಮೂಲಸ್ವರೂಪಾಯಾಮ್ ಅಮರೇಶ್ವರಸ್ಯ ಸಮಿತೌ ತ್ವಯಾ ಕೀದೃಶ ಆಚಾರಃ ಕರ್ತ್ತವ್ಯಸ್ತತ್ ಜ್ಞಾತುಂ ಶಕ್ಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಅಪರಂ ಯಸ್ಯ ಮಹತ್ತ್ವಂ ಸರ್ವ್ವಸ್ವೀಕೃತಮ್ ಈಶ್ವರಭಕ್ತೇಸ್ತತ್ ನಿಗೂಢವಾಕ್ಯಮಿದಮ್ ಈಶ್ವರೋ ಮಾನವದೇಹೇ ಪ್ರಕಾಶಿತ ಆತ್ಮನಾ ಸಪುಣ್ಯೀಕೃತೋ ದೂತೈಃ ಸನ್ದೃಷ್ಟಃ ಸರ್ವ್ವಜಾತೀಯಾನಾಂ ನಿಕಟೇ ಘೋಷಿತೋ ಜಗತೋ ವಿಶ್ವಾಸಪಾತ್ರೀಭೂತಸ್ತೇಜಃಪ್ರಾಪ್ತಯೇ ಸ್ವರ್ಗಂ ನೀತಶ್ಚೇತಿ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಪವಿತ್ರ ಆತ್ಮಾ ಸ್ಪಷ್ಟಮ್ ಇದಂ ವಾಕ್ಯಂ ವದತಿ ಚರಮಕಾಲೇ ಕತಿಪಯಲೋಕಾ ವಹ್ನಿನಾಙ್ಕಿತತ್ವಾತ್</para>
  <para style="p">
    <verse number="2" style="v"/>ಕಠೋರಮನಸಾಂ ಕಾಪಟ್ಯಾದ್ ಅನೃತವಾದಿನಾಂ ವಿವಾಹನಿಷೇಧಕಾನಾಂ ಭಕ್ಷ್ಯವಿಶೇಷನಿಷೇಧಕಾನಾಞ್ಚ</para>
  <para style="p">
    <verse number="3" style="v"/>ಭೂತಸ್ವರೂಪಾಣಾಂ ಶಿಕ್ಷಾಯಾಂ ಭ್ರಮಕಾತ್ಮನಾಂ ವಾಕ್ಯೇಷು ಚ ಮನಾಂಸಿ ನಿವೇಶ್ಯ ಧರ್ಮ್ಮಾದ್ ಭ್ರಂಶಿಷ್ಯನ್ತೇ| ತಾನಿ ತು ಭಕ್ಷ್ಯಾಣಿ ವಿಶ್ವಾಸಿನಾಂ ಸ್ವೀಕೃತಸತ್ಯಧರ್ಮ್ಮಾಣಾಞ್ಚ ಧನ್ಯವಾದಸಹಿತಾಯ ಭೋಗಾಯೇಶ್ವರೇಣ ಸಸೃಜಿರೇ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಯತ ಈಶ್ವರೇಣ ಯದ್ಯತ್ ಸೃಷ್ಟಂ ತತ್ ಸರ್ವ್ವಮ್ ಉತ್ತಮಂ ಯದಿ ಚ ಧನ್ಯವಾದೇನ ಭುಜ್ಯತೇ ತರ್ಹಿ ತಸ್ಯ ಕಿಮಪಿ ನಾಗ್ರಾಹ್ಯಂ ಭವತಿ,</para>
  <para style="p">
    <verse number="5" style="v"/>ಯತ ಈಶ್ವರಸ್ಯ ವಾಕ್ಯೇನ ಪ್ರಾರ್ಥನಯಾ ಚ ತತ್ ಪವಿತ್ರೀಭವತಿ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಏತಾನಿ ವಾಕ್ಯಾನಿ ಯದಿ ತ್ವಂ ಭ್ರಾತೃನ್ ಜ್ಞಾಪಯೇಸ್ತರ್ಹಿ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯೋತ್ತಮ್ಃ ಪರಿಚಾರಕೋ ಭವಿಷ್ಯಸಿ ಯೋ ವಿಶ್ವಾಸೋ ಹಿತೋಪದೇಶಶ್ಚ ತ್ವಯಾ ಗೃಹೀತಸ್ತದೀಯವಾಕ್ಯೈರಾಪ್ಯಾಯಿಷ್ಯಸೇ ಚ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯಾನ್ಯುಪಾಖ್ಯಾನಾನಿ ದುರ್ಭಾವಾನಿ ವೃದ್ಧಯೋಷಿತಾಮೇವ ಯೋಗ್ಯಾನಿ ಚ ತಾನಿ ತ್ವಯಾ ವಿಸೃಜ್ಯನ್ತಾಮ್ ಈಶ್ವರಭಕ್ತಯೇ ಯತ್ನಃ ಕ್ರಿಯತಾಞ್ಚ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಯತಃ ಶಾರೀರಿಕೋ ಯತ್ನಃ ಸ್ವಲ್ಪಫಲದೋ ಭವತಿ ಕಿನ್ತ್ವೀಶ್ವರಭಕ್ತಿರೈಹಿಕಪಾರತ್ರಿಕಜೀವನಯೋಃ ಪ್ರತಿಜ್ಞಾಯುಕ್ತಾ ಸತೀ ಸರ್ವ್ವತ್ರ ಫಲದಾ ಭವತಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ವಾಕ್ಯಮೇತದ್ ವಿಶ್ವಸನೀಯಂ ಸರ್ವ್ವೈ ರ್ಗ್ರಹಣೀಯಞ್ಚ ವಯಞ್ಚ ತದರ್ಥಮೇವ ಶ್ರಾಮ್ಯಾಮೋ ನಿನ್ದಾಂ ಭುಂಜ್ಮಹೇ ಚ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯತೋ ಹೇತೋಃ ಸರ್ವ್ವಮಾನವಾನಾಂ ವಿಶೇಷತೋ ವಿಶ್ವಾಸಿನಾಂ ತ್ರಾತಾ ಯೋಽಮರ ಈಶ್ವರಸ್ತಸ್ಮಿನ್ ವಯಂ ವಿಶ್ವಸಾಮಃ|</para>
  <para style="p">
    <verse number="11" style="v"/>ತ್ವಮ್ ಏತಾನಿ ವಾಕ್ಯಾನಿ ಪ್ರಚಾರಯ ಸಮುಪದಿಶ ಚ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಅಲ್ಪವಯಷ್ಕತ್ವಾತ್ ಕೇನಾಪ್ಯವಜ್ಞೇಯೋ ನ ಭವ ಕಿನ್ತ್ವಾಲಾಪೇನಾಚರಣೇನ ಪ್ರೇಮ್ನಾ ಸದಾತ್ಮತ್ವೇನ ವಿಶ್ವಾಸೇನ ಶುಚಿತ್ವೇನ ಚ ವಿಶ್ವಾಸಿನಾಮ್ ಆದರ್ಶೋ ಭವ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯಾವನ್ನಾಹಮ್ ಆಗಮಿಷ್ಯಾಮಿ ತಾವತ್ ತ್ವ ಪಾಠೇ ಚೇತಯನೇ ಉಪದೇಶೇ ಚ ಮನೋ ನಿಧತ್ಸ್ವ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಪ್ರಾಚೀನಗಣಹಸ್ತಾರ್ಪಣಸಹಿತೇನ ಭವಿಷ್ಯದ್ವಾಕ್ಯೇನ ಯದ್ದಾನಂ ತುಭ್ಯಂ ವಿಶ್ರಾಣಿತಂ ತವಾನ್ತಃಸ್ಥೇ ತಸ್ಮಿನ್ ದಾನೇ ಶಿಥಿಲಮನಾ ಮಾ ಭವ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಏತೇಷು ಮನೋ ನಿವೇಶಯ, ಏತೇಷು ವರ್ತ್ತಸ್ವ, ಇತ್ಥಞ್ಚ ಸರ್ವ್ವವಿಷಯೇ ತವ ಗುಣವೃದ್ಧಿಃ ಪ್ರಕಾಶತಾಂ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಸ್ವಸ್ಮಿನ್ ಉಪದೇಶೇ ಚ ಸಾವಧಾನೋ ಭೂತ್ವಾವತಿಷ್ಠಸ್ವ ತತ್ ಕೃತ್ವಾ ತ್ವಯಾತ್ಮಪರಿತ್ರಾಣಂ ಶ್ರೋತೃಣಾಞ್ಚ ಪರಿತ್ರಾಣಂ ಸಾಧಯಿಷ್ಯತೇ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ತ್ವಂ ಪ್ರಾಚೀನಂ ನ ಭರ್ತ್ಸಯ ಕಿನ್ತು ತಂ ಪಿತರಮಿವ ಯೂನಶ್ಚ ಭ್ರಾತೃನಿವ</para>
  <para style="p">
    <verse number="2" style="v"/>ವೃದ್ಧಾಃ ಸ್ತ್ರಿಯಶ್ಚ ಮಾತೃನಿವ ಯುವತೀಶ್ಚ ಪೂರ್ಣಶುಚಿತ್ವೇನ ಭಗಿನೀರಿವ ವಿನಯಸ್ವ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅಪರಂ ಸತ್ಯವಿಧವಾಃ ಸಮ್ಮನ್ಯಸ್ವ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಕಸ್ಯಾಶ್ಚಿದ್ ವಿಧವಾಯಾ ಯದಿ ಪುತ್ರಾಃ ಪೌತ್ರಾ ವಾ ವಿದ್ಯನ್ತೇ ತರ್ಹಿ ತೇ ಪ್ರಥಮತಃ ಸ್ವೀಯಪರಿಜನಾನ್ ಸೇವಿತುಂ ಪಿತ್ರೋಃ ಪ್ರತ್ಯುಪಕರ್ತ್ತುಞ್ಚ ಶಿಕ್ಷನ್ತಾಂ ಯತಸ್ತದೇವೇಶ್ವರಸ್ಯ ಸಾಕ್ಷಾದ್ ಉತ್ತಮಂ ಗ್ರಾಹ್ಯಞ್ಚ ಕರ್ಮ್ಮ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಅಪರಂ ಯಾ ನಾರೀ ಸತ್ಯವಿಧವಾ ನಾಥಹೀನಾ ಚಾಸ್ತಿ ಸಾ ಈಶ್ವರಸ್ಯಾಶ್ರಯೇ ತಿಷ್ಠನ್ತೀ ದಿವಾನಿಶಂ ನಿವೇದನಪ್ರಾರ್ಥನಾಭ್ಯಾಂ ಕಾಲಂ ಯಾಪಯತಿ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಕಿನ್ತು ಯಾ ವಿಧವಾ ಸುಖಭೋಗಾಸಕ್ತಾ ಸಾ ಜೀವತ್ಯಪಿ ಮೃತಾ ಭವತಿ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅತಏವ ತಾ ಯದ್ ಅನಿನ್ದಿತಾ ಭವೇಯೂಸ್ತದರ್ಥಮ್ ಏತಾನಿ ತ್ವಯಾ ನಿದಿಶ್ಯನ್ತಾಂ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಯದಿ ಕಶ್ಚಿತ್ ಸ್ವಜಾತೀಯಾನ್ ಲೋಕಾನ್ ವಿಶೇಷತಃ ಸ್ವೀಯಪರಿಜನಾನ್ ನ ಪಾಲಯತಿ ತರ್ಹಿ ಸ ವಿಶ್ವಾಸಾದ್ ಭ್ರಷ್ಟೋ ಽಪ್ಯಧಮಶ್ಚ ಭವತಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ವಿಧವಾವರ್ಗೇ ಯಸ್ಯಾ ಗಣನಾ ಭವತಿ ತಯಾ ಷಷ್ಟಿವತ್ಸರೇಭ್ಯೋ ನ್ಯೂನವಯಸ್ಕಯಾ ನ ಭವಿತವ್ಯಂ; ಅಪರಂ ಪೂರ್ವ್ವಮ್ ಏಕಸ್ವಾಮಿಕಾ ಭೂತ್ವಾ</para>
  <para style="p">
    <verse number="10" style="v"/>ಸಾ ಯತ್ ಶಿಶುಪೋಷಣೇನಾತಿಥಿಸೇವನೇನ ಪವಿತ್ರಲೋಕಾನಾಂ ಚರಣಪ್ರಕ್ಷಾಲನೇನ ಕ್ಲಿಷ್ಟಾನಾಮ್ ಉಪಕಾರೇಣ ಸರ್ವ್ವವಿಧಸತ್ಕರ್ಮ್ಮಾಚರಣೇನ ಚ ಸತ್ಕರ್ಮ್ಮಕರಣಾತ್ ಸುಖ್ಯಾತಿಪ್ರಾಪ್ತಾ ಭವೇತ್ ತದಪ್ಯಾವಶ್ಯಕಂ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಕಿನ್ತು ಯುವತೀ ರ್ವಿಧವಾ ನ ಗೃಹಾಣ ಯತಃ ಖ್ರೀಷ್ಟಸ್ಯ ವೈಪರೀತ್ಯೇನ ತಾಸಾಂ ದರ್ಪೇ ಜಾತೇ ತಾ ವಿವಾಹಮ್ ಇಚ್ಛನ್ತಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ತಸ್ಮಾಚ್ಚ ಪೂರ್ವ್ವಧರ್ಮ್ಮಂ ಪರಿತ್ಯಜ್ಯ ದಣ್ಡನೀಯಾ ಭವನ್ತಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅನನ್ತರಂ ತಾ ಗೃಹಾದ್ ಗೃಹಂ ಪರ್ಯ್ಯಟನ್ತ್ಯ ಆಲಸ್ಯಂ ಶಿಕ್ಷನ್ತೇ ಕೇವಲಮಾಲಸ್ಯಂ ನಹಿ ಕಿನ್ತ್ವನರ್ಥಕಾಲಾಪಂ ಪರಾಧಿಕಾರಚರ್ಚ್ಚಾಞ್ಚಾಪಿ ಶಿಕ್ಷಮಾಣಾ ಅನುಚಿತಾನಿ ವಾಕ್ಯಾನಿ ಭಾಷನ್ತೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಅತೋ ಮಮೇಚ್ಛೇಯಂ ಯುವತ್ಯೋ ವಿಧವಾ ವಿವಾಹಂ ಕುರ್ವ್ವತಾಮ್ ಅಪತ್ಯವತ್ಯೋ ಭವನ್ತು ಗೃಹಕರ್ಮ್ಮ ಕುರ್ವ್ವತಾಞ್ಚೇತ್ಥಂ ವಿಪಕ್ಷಾಯ ಕಿಮಪಿ ನಿನ್ದಾದ್ವಾರಂ ನ ದದತು|</para>
  <para style="p">
    <verse number="15" style="v"/>ಯತ ಇತಃ ಪೂರ್ವ್ವಮ್ ಅಪಿ ಕಾಶ್ಚಿತ್ ಶಯತಾನಸ್ಯ ಪಶ್ಚಾದ್ಗಾಮಿನ್ಯೋ ಜಾತಾಃ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಅಪರಂ ವಿಶ್ವಾಸಿನ್ಯಾ ವಿಶ್ವಾಸಿನೋ ವಾ ಕಸ್ಯಾಪಿ ಪರಿವಾರಾಣಾಂ ಮಧ್ಯೇ ಯದಿ ವಿಧವಾ ವಿದ್ಯನ್ತೇ ತರ್ಹಿ ಸ ತಾಃ ಪ್ರತಿಪಾಲಯತು ತಸ್ಮಾತ್ ಸಮಿತೌ ಭಾರೇ ಽನಾರೋಪಿತೇ ಸತ್ಯವಿಧವಾನಾಂ ಪ್ರತಿಪಾಲನಂ ಕರ್ತ್ತುಂ ತಯಾ ಶಕ್ಯತೇ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಯೇ ಪ್ರಾಞ್ಚಃ ಸಮಿತಿಂ ಸಮ್ಯಗ್ ಅಧಿತಿಷ್ಠನ್ತಿ ವಿಶೇಷತ ಈಶ್ವರವಾಕ್ಯೇನೋಪದೇಶೇನ ಚ ಯೇ ಯತ್ನಂ ವಿದಧತೇ ತೇ ದ್ವಿಗುಣಸ್ಯಾದರಸ್ಯ ಯೋಗ್ಯಾ ಮಾನ್ಯನ್ತಾಂ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಯಸ್ಮಾತ್ ಶಾಸ್ತ್ರೇ ಲಿಖಿತಮಿದಮಾಸ್ತೇ, ತ್ವಂ ಶಸ್ಯಮರ್ದ್ದಕವೃಷಸ್ಯಾಸ್ಯಂ ಮಾ ಬಧಾನೇತಿ, ಅಪರಮಪಿ ಕಾರ್ಯ್ಯಕೃದ್ ವೇತನಸ್ಯ ಯೋಗ್ಯೋ ಭವತೀತಿ|</para>
  <para style="p">
    <verse number="19" style="v"/>ದ್ವೌ ತ್ರೀನ್ ವಾ ಸಾಕ್ಷಿಣೋ ವಿನಾ ಕಸ್ಯಾಚಿತ್ ಪ್ರಾಚೀನಸ್ಯ ವಿರುದ್ಧಮ್ ಅಭಿಯೋಗಸ್ತ್ವಯಾ ನ ಗೃಹ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಅಪರಂ ಯೇ ಪಾಪಮಾಚರನ್ತಿ ತಾನ್ ಸರ್ವ್ವೇಷಾಂ ಸಮಕ್ಷಂ ಭರ್ತ್ಸಯಸ್ವ ತೇನಾಪರೇಷಾಮಪಿ ಭೀತಿ ರ್ಜನಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಅಹಮ್ ಈಶ್ವರಸ್ಯ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಮನೋನೀತದಿವ್ಯದೂತಾನಾಞ್ಚ ಗೋಚರೇ ತ್ವಾಮ್ ಇದಮ್ ಆಜ್ಞಾಪಯಾಮಿ ತ್ವಂ ಕಸ್ಯಾಪ್ಯನುರೋಧೇನ ಕಿಮಪಿ ನ ಕುರ್ವ್ವನ ವಿನಾಪಕ್ಷಪಾತಮ್ ಏತಾನ ವಿಧೀನ್ ಪಾಲಯ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಕಸ್ಯಾಪಿ ಮೂರ್ದ್ಧಿ ಹಸ್ತಾಪರ್ಣಂ ತ್ವರಯಾ ಮಾಕಾರ್ಷೀಃ| ಪರಪಾಪಾನಾಞ್ಚಾಂಶೀ ಮಾ ಭವ| ಸ್ವಂ ಶುಚಿಂ ರಕ್ಷ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಅಪರಂ ತವೋದರಪೀಡಾಯಾಃ ಪುನಃ ಪುನ ದುರ್ಬ್ಬಲತಾಯಾಶ್ಚ ನಿಮಿತ್ತಂ ಕೇವಲಂ ತೋಯಂ ನ ಪಿವನ್ ಕಿಞ್ಚಿನ್ ಮದ್ಯಂ ಪಿವ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಕೇಷಾಞ್ಚಿತ್ ಮಾನವಾನಾಂ ಪಾಪಾನಿ ವಿಚಾರಾತ್ ಪೂರ್ವ್ವಂ ಕೇಷಾಞ್ಚಿತ್ ಪಶ್ಚಾತ್ ಪ್ರಕಾಶನ್ತೇ|</para>
  <para style="p">
    <verse number="25" style="v"/>ತಥೈವ ಸತ್ಕರ್ಮ್ಮಾಣ್ಯಪಿ ಪ್ರಕಾಶನ್ತೇ ತದನ್ಯಥಾ ಸತಿ ಪ್ರಚ್ಛನ್ನಾನಿ ಸ್ಥಾತುಂ ನ ಶಕ್ನುವನ್ತಿ|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಯಾವನ್ತೋ ಲೋಕಾ ಯುಗಧಾರಿಣೋ ದಾಸಾಃ ಸನ್ತಿ ತೇ ಸ್ವಸ್ವಸ್ವಾಮಿನಂ ಪೂರ್ಣಸಮಾದರಯೋಗ್ಯಂ ಮನ್ಯನ್ತಾಂ ನೋ ಚೇದ್ ಈಶ್ವರಸ್ಯ ನಾಮ್ನ ಉಪದೇಶಸ್ಯ ಚ ನಿನ್ದಾ ಸಮ್ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯೇಷಾಞ್ಚ ಸ್ವಾಮಿನೋ ವಿಶ್ವಾಸಿನಃ ಭವನ್ತಿ ತೈಸ್ತೇ ಭ್ರಾತೃತ್ವಾತ್ ನಾವಜ್ಞೇಯಾಃ ಕಿನ್ತು ತೇ ಕರ್ಮ್ಮಫಲಭೋಗಿನೋ ವಿಶ್ವಾಸಿನಃ ಪ್ರಿಯಾಶ್ಚ ಭವನ್ತೀತಿ ಹೇತೋಃ ಸೇವನೀಯಾ ಏವ, ತ್ವಮ್ ಏತಾನಿ ಶಿಕ್ಷಯ ಸಮುಪದಿಶ ಚ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಯಃ ಕಶ್ಚಿದ್ ಇತರಶಿಕ್ಷಾಂ ಕರೋತಿ, ಅಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಹಿತವಾಕ್ಯಾನೀಶ್ವರಭಕ್ತೇ ರ್ಯೋಗ್ಯಾಂ ಶಿಕ್ಷಾಞ್ಚ ನ ಸ್ವೀಕರೋತಿ</para>
  <para style="p">
    <verse number="4" style="v"/>ಸ ದರ್ಪಧ್ಮಾತಃ ಸರ್ವ್ವಥಾ ಜ್ಞಾನಹೀನಶ್ಚ ವಿವಾದೈ ರ್ವಾಗ್ಯುದ್ಧೈಶ್ಚ ರೋಗಯುಕ್ತಶ್ಚ ಭವತಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ತಾದೃಶಾದ್ ಭಾವಾದ್ ಈರ್ಷ್ಯಾವಿರೋಧಾಪವಾದದುಷ್ಟಾಸೂಯಾ ಭ್ರಷ್ಟಮನಸಾಂ ಸತ್ಯಜ್ಞಾನಹೀನಾನಾಮ್ ಈಶ್ವರಭಕ್ತಿಂ ಲಾಭೋಪಾಯಮ್ ಇವ ಮನ್ಯಮಾನಾನಾಂ ಲೋಕಾನಾಂ ವಿವಾದಾಶ್ಚ ಜಾಯನ್ತೇ ತಾದೃಶೇಭ್ಯೋ ಲೋಕೇಭ್ಯಸ್ತ್ವಂ ಪೃಥಕ್ ತಿಷ್ಠ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಸಂಯತೇಚ್ಛಯಾ ಯುಕ್ತಾ ಯೇಶ್ವರಭಕ್ತಿಃ ಸಾ ಮಹಾಲಾಭೋಪಾಯೋ ಭವತೀತಿ ಸತ್ಯಂ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಏತಜ್ಜಗತ್ಪ್ರವೇಶನಕಾಲೇಽಸ್ಮಾಭಿಃ ಕಿಮಪಿ ನಾನಾಯಿ ತತ್ತಯಜನಕಾಲೇಽಪಿ ಕಿಮಪಿ ನೇತುಂ ನ ಶಕ್ಷ್ಯತ ಇತಿ ನಿಶ್ಚಿತಂ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಅತಏವ ಖಾದ್ಯಾನ್ಯಾಚ್ಛಾದನಾನಿ ಚ ಪ್ರಾಪ್ಯಾಸ್ಮಾಭಿಃ ಸನ್ತುಷ್ಟೈ ರ್ಭವಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಯೇ ತು ಧನಿನೋ ಭವಿತುಂ ಚೇಷ್ಟನ್ತೇ ತೇ ಪರೀಕ್ಷಾಯಾಮ್ ಉನ್ಮಾಥೇ ಪತನ್ತಿ ಯೇ ಚಾಭಿಲಾಷಾ ಮಾನವಾನ್ ವಿನಾಶೇ ನರಕೇ ಚ ಮಜ್ಜಯನ್ತಿ ತಾದೃಶೇಷ್ವಜ್ಞಾನಾಹಿತಾಭಿಲಾಷೇಷ್ವಪಿ ಪತನ್ತಿ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯತೋಽರ್ಥಸ್ಪೃಹಾ ಸರ್ವ್ವೇಷಾಂ ದುರಿತಾನಾಂ ಮೂಲಂ ಭವತಿ ತಾಮವಲಮ್ಬ್ಯ ಕೇಚಿದ್ ವಿಶ್ವಾಸಾದ್ ಅಭ್ರಂಶನ್ತ ನಾನಾಕ್ಲೇಶೈಶ್ಚ ಸ್ವಾನ್ ಅವಿಧ್ಯನ್|</para>
  <para style="p">
    <verse number="11" style="v"/>ಹೇ ಈಶ್ವರಸ್ಯ ಲೋಕ ತ್ವಮ್ ಏತೇಭ್ಯಃ ಪಲಾಯ್ಯ ಧರ್ಮ್ಮ ಈಶ್ವರಭಕ್ತಿ ರ್ವಿಶ್ವಾಸಃ ಪ್ರೇಮ ಸಹಿಷ್ಣುತಾ ಕ್ಷಾನ್ತಿಶ್ಚೈತಾನ್ಯಾಚರ|</para>
  <para style="p">
    <verse number="12" style="v"/>ವಿಶ್ವಾಸರೂಪಮ್ ಉತ್ತಮಯುದ್ಧಂ ಕುರು, ಅನನ್ತಜೀವನಮ್ ಆಲಮ್ಬಸ್ವ ಯತಸ್ತದರ್ಥಂ ತ್ವಮ್ ಆಹೂತೋ ಽಭವಃ, ಬಹುಸಾಕ್ಷಿಣಾಂ ಸಮಕ್ಷಞ್ಚೋತ್ತಮಾಂ ಪ್ರತಿಜ್ಞಾಂ ಸ್ವೀಕೃತವಾನ್|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅಪರಂ ಸರ್ವ್ವೇಷಾಂ ಜೀವಯಿತುರೀಶ್ವರಸ್ಯ ಸಾಕ್ಷಾದ್ ಯಶ್ಚ ಖ್ರೀಷ್ಟೋ ಯೀಶುಃ ಪನ್ತೀಯಪೀಲಾತಸ್ಯ ಸಮಕ್ಷಮ್ ಉತ್ತಮಾಂ ಪ್ರತಿಜ್ಞಾಂ ಸ್ವೀಕೃತವಾನ್ ತಸ್ಯ ಸಾಕ್ಷಾದ್ ಅಹಂ ತ್ವಾಮ್ ಇದಮ್ ಆಜ್ಞಾಪಯಾಮಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಈಶ್ವರೇಣ ಸ್ವಸಮಯೇ ಪ್ರಕಾಶಿತವ್ಯಮ್ ಅಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯಾಗಮನಂ ಯಾವತ್ ತ್ವಯಾ ನಿಷ್ಕಲಙ್ಕತ್ವೇನ ನಿರ್ದ್ದೋಷತ್ವೇನ ಚ ವಿಧೀ ರಕ್ಷ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಸ ಈಶ್ವರಃ ಸಚ್ಚಿದಾನನ್ದಃ, ಅದ್ವಿತೀಯಸಮ್ರಾಟ್, ರಾಜ್ಞಾಂ ರಾಜಾ, ಪ್ರಭೂನಾಂ ಪ್ರಭುಃ,</para>
  <para style="p">
    <verse number="16" style="v"/>ಅಮರತಾಯಾ ಅದ್ವಿತೀಯ ಆಕರಃ, ಅಗಮ್ಯತೇಜೋನಿವಾಸೀ, ಮರ್ತ್ತ್ಯಾನಾಂ ಕೇನಾಪಿ ನ ದೃಷ್ಟಃ ಕೇನಾಪಿ ನ ದೃಶ್ಯಶ್ಚ| ತಸ್ಯ ಗೌರವಪರಾಕ್ರಮೌ ಸದಾತನೌ ಭೂಯಾಸ್ತಾಂ| ಆಮೇನ್|</para>
  <para style="p">
    <verse number="17" style="v"/>ಇಹಲೋಕೇ ಯೇ ಧನಿನಸ್ತೇ ಚಿತ್ತಸಮುನ್ನತಿಂ ಚಪಲೇ ಧನೇ ವಿಶ್ವಾಸಞ್ಚ ನ ಕುರ್ವ್ವತಾಂ ಕಿನ್ತು ಭೋಗಾರ್ಥಮ್ ಅಸ್ಮಭ್ಯಂ ಪ್ರಚುರತ್ವೇನ ಸರ್ವ್ವದಾತಾ</para>
  <para style="p">
    <verse number="18" style="v"/>ಯೋಽಮರ ಈಶ್ವರಸ್ತಸ್ಮಿನ್ ವಿಶ್ವಸನ್ತು ಸದಾಚಾರಂ ಕುರ್ವ್ವನ್ತು ಸತ್ಕರ್ಮ್ಮಧನೇನ ಧನಿನೋ ಸುಕಲಾ ದಾತಾರಶ್ಚ ಭವನ್ತು,</para>
  <para style="p">
    <verse number="19" style="v"/>ಯಥಾ ಚ ಸತ್ಯಂ ಜೀವನಂ ಪಾಪ್ನುಯುಸ್ತಥಾ ಪಾರತ್ರಿಕಾಮ್ ಉತ್ತಮಸಮ್ಪದಂ ಸಞ್ಚಿನ್ವನ್ತ್ವೇತಿ ತ್ವಯಾದಿಶ್ಯನ್ತಾಂ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಹೇ ತೀಮಥಿಯ, ತ್ವಮ್ ಉಪನಿಧಿಂ ಗೋಪಯ ಕಾಲ್ಪನಿಕವಿದ್ಯಾಯಾ ಅಪವಿತ್ರಂ ಪ್ರಲಾಪಂ ವಿರೋಧೋಕ್ತಿಞ್ಚ ತ್ಯಜ ಚ,</para>
  <para style="p">
    <verse number="21" style="v"/>ಯತಃ ಕತಿಪಯಾ ಲೋಕಾಸ್ತಾಂ ವಿದ್ಯಾಮವಲಮ್ಬ್ಯ ವಿಶ್ವಾಸಾದ್ ಭ್ರಷ್ಟಾ ಅಭವನ| ಪ್ರಸಾದಸ್ತವ ಸಹಾಯೋ ಭೂಯಾತ್| ಆಮೇನ್|</para>
</usx>
