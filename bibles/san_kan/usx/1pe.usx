<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1PE" style="id">Sanskrit Bible (NT) in Kannada Script (ಸತ್ಯವೇದಃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 Peter</para>
  <para style="toc1">೧ ಪಿತರಸ್ಯ ಪತ್ರಂ</para>
  <para style="toc2">೧ ಪಿತರಃ</para>
  <para style="toc3">೧ ಪಿತರಃ</para>
  <para style="mt1">೧ ಪಿತರಸ್ಯ ಪತ್ರಂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಪನ್ತ-ಗಾಲಾತಿಯಾ-ಕಪ್ಪದಕಿಯಾ-ಆಶಿಯಾ-ಬಿಥುನಿಯಾದೇಶೇಷು ಪ್ರವಾಸಿನೋ ಯೇ ವಿಕೀರ್ಣಲೋಕಾಃ</para>
  <para style="p">
    <verse number="2" style="v"/>ಪಿತುರೀಶ್ವರಸ್ಯ ಪೂರ್ವ್ವನಿರ್ಣಯಾದ್ ಆತ್ಮನಃ ಪಾವನೇನ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯಾಜ್ಞಾಗ್ರಹಣಾಯ ಶೋಣಿತಪ್ರೋಕ್ಷಣಾಯ ಚಾಭಿರುಚಿತಾಸ್ತಾನ್ ಪ್ರತಿ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಪ್ರೇರಿತಃ ಪಿತರಃ ಪತ್ರಂ ಲಿಖತಿ| ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಬಾಹುಲ್ಯೇನ ಶಾನ್ತಿರನುಗ್ರಹಶ್ಚ ಭೂಯಾಸ್ತಾಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ತಾತ ಈಶ್ವರೋ ಧನ್ಯಃ, ಯತಃ ಸ ಸ್ವಕೀಯಬಹುಕೃಪಾತೋ ಮೃತಗಣಮಧ್ಯಾದ್ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯೋತ್ಥಾನೇನ ಜೀವನಪ್ರತ್ಯಾಶಾರ್ಥಮ್ ಅರ್ಥತೋ</para>
  <para style="p">
    <verse number="4" style="v"/>ಽಕ್ಷಯನಿಷ್ಕಲಙ್ಕಾಮ್ಲಾನಸಮ್ಪತ್ತಿಪ್ರಾಪ್ತ್ಯರ್ಥಮ್ ಅಸ್ಮಾನ್ ಪುನ ರ್ಜನಯಾಮಾಸ| ಸಾ ಸಮ್ಪತ್ತಿಃ ಸ್ವರ್ಗೇ ಽಸ್ಮಾಕಂ ಕೃತೇ ಸಞ್ಚಿತಾ ತಿಷ್ಠತಿ,</para>
  <para style="p">
    <verse number="5" style="v"/>ಯೂಯಞ್ಚೇಶ್ವರಸ್ಯ ಶಕ್ತಿತಃ ಶೇಷಕಾಲೇ ಪ್ರಕಾಶ್ಯಪರಿತ್ರಾಣಾರ್ಥಂ ವಿಶ್ವಾಸೇನ ರಕ್ಷ್ಯಧ್ವೇ|</para>
  <para style="p">
    <verse number="6" style="v"/>ತಸ್ಮಾದ್ ಯೂಯಂ ಯದ್ಯಪ್ಯಾನನ್ದೇನ ಪ್ರಫುಲ್ಲಾ ಭವಥ ತಥಾಪಿ ಸಾಮ್ಪ್ರತಂ ಪ್ರಯೋಜನಹೇತೋಃ ಕಿಯತ್ಕಾಲಪರ್ಯ್ಯನ್ತಂ ನಾನಾವಿಧಪರೀಕ್ಷಾಭಿಃ ಕ್ಲಿಶ್ಯಧ್ವೇ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯತೋ ವಹ್ನಿನಾ ಯಸ್ಯ ಪರೀಕ್ಷಾ ಭವತಿ ತಸ್ಮಾತ್ ನಶ್ವರಸುವರ್ಣಾದಪಿ ಬಹುಮೂಲ್ಯಂ ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸರೂಪಂ ಯತ್ ಪರೀಕ್ಷಿತಂ ಸ್ವರ್ಣಂ ತೇನ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯಾಗಮನಸಮಯೇ ಪ್ರಶಂಸಾಯಾಃ ಸಮಾದರಸ್ಯ ಗೌರವಸ್ಯ ಚ ಯೋಗ್ಯತಾ ಪ್ರಾಪ್ತವ್ಯಾ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಯೂಯಂ ತಂ ಖ್ರೀಷ್ಟಮ್ ಅದೃಷ್ಟ್ವಾಪಿ ತಸ್ಮಿನ್ ಪ್ರೀಯಧ್ವೇ ಸಾಮ್ಪ್ರತಂ ತಂ ನ ಪಶ್ಯನ್ತೋಽಪಿ ತಸ್ಮಿನ್ ವಿಶ್ವಸನ್ತೋ ಽನಿರ್ವ್ವಚನೀಯೇನ ಪ್ರಭಾವಯುಕ್ತೇನ ಚಾನನ್ದೇನ ಪ್ರಫುಲ್ಲಾ ಭವಥ,</para>
  <para style="p">
    <verse number="9" style="v"/>ಸ್ವವಿಶ್ವಾಸಸ್ಯ ಪರಿಣಾಮರೂಪಮ್ ಆತ್ಮನಾಂ ಪರಿತ್ರಾಣಂ ಲಭಧ್ವೇ ಚ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯುಷ್ಮಾಸು ಯೋ ಽನುಗ್ರಹೋ ವರ್ತ್ತತೇ ತದ್ವಿಷಯೇ ಯ ಈಶ್ವರೀಯವಾಕ್ಯಂ ಕಥಿತವನ್ತಸ್ತೇ ಭವಿಷ್ಯದ್ವಾದಿನಸ್ತಸ್ಯ ಪರಿತ್ರಾಣಸ್ಯಾನ್ವೇಷಣಮ್ ಅನುಸನ್ಧಾನಞ್ಚ ಕೃತವನ್ತಃ|</para>
  <para style="p">
    <verse number="11" style="v"/>ವಿಶೇಷತಸ್ತೇಷಾಮನ್ತರ್ವ್ವಾಸೀ ಯಃ ಖ್ರೀಷ್ಟಸ್ಯಾತ್ಮಾ ಖ್ರೀಷ್ಟೇ ವರ್ತ್ತಿಷ್ಯಮಾಣಾನಿ ದುಃಖಾನಿ ತದನುಗಾಮಿಪ್ರಭಾವಞ್ಚ ಪೂರ್ವ್ವಂ ಪ್ರಾಕಾಶಯತ್ ತೇನ ಕಃ ಕೀದೃಶೋ ವಾ ಸಮಯೋ ನಿರದಿಶ್ಯತೈತಸ್ಯಾನುಸನ್ಧಾನಂ ಕೃತವನ್ತಃ|</para>
  <para style="p">
    <verse number="12" style="v"/>ತತಸ್ತೈ ರ್ವಿಷಯೈಸ್ತೇ ಯನ್ನ ಸ್ವಾನ್ ಕಿನ್ತ್ವಸ್ಮಾನ್ ಉಪಕುರ್ವ್ವನ್ತ್ಯೇತತ್ ತೇಷಾಂ ನಿಕಟೇ ಪ್ರಾಕಾಶ್ಯತ| ಯಾಂಶ್ಚ ತಾನ್ ವಿಷಯಾನ್ ದಿವ್ಯದೂತಾ ಅಪ್ಯವನತಶಿರಸೋ ನಿರೀಕ್ಷಿತುಮ್ ಅಭಿಲಷನ್ತಿ ತೇ ವಿಷಯಾಃ ಸಾಮ್ಪ್ರತಂ ಸ್ವರ್ಗಾತ್ ಪ್ರೇಷಿತಸ್ಯ ಪವಿತ್ರಸ್ಯಾತ್ಮನಃ ಸಹಾಯ್ಯಾದ್ ಯುಷ್ಮತ್ಸಮೀಪೇ ಸುಸಂವಾದಪ್ರಚಾರಯಿತೃಭಿಃ ಪ್ರಾಕಾಶ್ಯನ್ತ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅತಏವ ಯೂಯಂ ಮನಃಕಟಿಬನ್ಧನಂ ಕೃತ್ವಾ ಪ್ರಬುದ್ಧಾಃ ಸನ್ತೋ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಪ್ರಕಾಶಸಮಯೇ ಯುಷ್ಮಾಸು ವರ್ತ್ತಿಷ್ಯಮಾನಸ್ಯಾನುಗ್ರಹಸ್ಯ ಸಮ್ಪೂರ್ಣಾಂ ಪ್ರತ್ಯಾಶಾಂ ಕುರುತ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಅಪರಂ ಪೂರ್ವ್ವೀಯಾಜ್ಞಾನತಾವಸ್ಥಾಯಾಃ ಕುತ್ಸಿತಾಭಿಲಾಷಾಣಾಂ ಯೋಗ್ಯಮ್ ಆಚಾರಂ ನ ಕುರ್ವ್ವನ್ತೋ ಯುಷ್ಮದಾಹ್ವಾನಕಾರೀ ಯಥಾ ಪವಿತ್ರೋ ಽಸ್ತಿ</para>
  <para style="p">
    <verse number="15" style="v"/>ಯೂಯಮಪ್ಯಾಜ್ಞಾಗ್ರಾಹಿಸನ್ತಾನಾ ಇವ ಸರ್ವ್ವಸ್ಮಿನ್ ಆಚಾರೇ ತಾದೃಕ್ ಪವಿತ್ರಾ ಭವತ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯತೋ ಲಿಖಿತಮ್ ಆಸ್ತೇ, ಯೂಯಂ ಪವಿತ್ರಾಸ್ತಿಷ್ಠತ ಯಸ್ಮಾದಹಂ ಪವಿತ್ರಃ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಅಪರಞ್ಚ ಯೋ ವಿನಾಪಕ್ಷಪಾತಮ್ ಏಕೈಕಮಾನುಷಸ್ಯ ಕರ್ಮ್ಮಾನುಸಾರಾದ್ ವಿಚಾರಂ ಕರೋತಿ ಸ ಯದಿ ಯುಷ್ಮಾಭಿಸ್ತಾತ ಆಖ್ಯಾಯತೇ ತರ್ಹಿ ಸ್ವಪ್ರವಾಸಸ್ಯ ಕಾಲೋ ಯುಷ್ಮಾಭಿ ರ್ಭೀತ್ಯಾ ಯಾಪ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಯೂಯಂ ನಿರರ್ಥಕಾತ್ ಪೈತೃಕಾಚಾರಾತ್ ಕ್ಷಯಣೀಯೈ ರೂಪ್ಯಸುವರ್ಣಾದಿಭಿ ರ್ಮುಕ್ತಿಂ ನ ಪ್ರಾಪ್ಯ</para>
  <para style="p">
    <verse number="19" style="v"/>ನಿಷ್ಕಲಙ್ಕನಿರ್ಮ್ಮಲಮೇಷಶಾವಕಸ್ಯೇವ ಖ್ರೀಷ್ಟಸ್ಯ ಬಹುಮೂಲ್ಯೇನ ರುಧಿರೇಣ ಮುಕ್ತಿಂ ಪ್ರಾಪ್ತವನ್ತ ಇತಿ ಜಾನೀಥ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಸ ಜಗತೋ ಭಿತ್ತಿಮೂಲಸ್ಥಾಪನಾತ್ ಪೂರ್ವ್ವಂ ನಿಯುಕ್ತಃ ಕಿನ್ತು ಚರಮದಿನೇಷು ಯುಷ್ಮದರ್ಥಂ ಪ್ರಕಾಶಿತೋ ಽಭವತ್|</para>
  <para style="p">
    <verse number="21" style="v"/>ಯತಸ್ತೇನೈವ ಮೃತಗಣಾತ್ ತಸ್ಯೋತ್ಥಾಪಯಿತರಿ ತಸ್ಮೈ ಗೌರವದಾತರಿ ಚೇಶ್ವರೇ ವಿಶ್ವಸಿಥ ತಸ್ಮಾದ್ ಈಶ್ವರೇ ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸಃ ಪ್ರತ್ಯಾಶಾ ಚಾಸ್ತೇ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಯೂಯಮ್ ಆತ್ಮನಾ ಸತ್ಯಮತಸ್ಯಾಜ್ಞಾಗ್ರಹಣದ್ವಾರಾ ನಿಷ್ಕಪಟಾಯ ಭ್ರಾತೃಪ್ರೇಮ್ನೇ ಪಾವಿತಮನಸೋ ಭೂತ್ವಾ ನಿರ್ಮ್ಮಲಾನ್ತಃಕರಣೈಃ ಪರಸ್ಪರಂ ಗಾಢಂ ಪ್ರೇಮ ಕುರುತ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಯಸ್ಮಾದ್ ಯೂಯಂ ಕ್ಷಯಣೀಯವೀರ್ಯ್ಯಾತ್ ನಹಿ ಕಿನ್ತ್ವಕ್ಷಯಣೀಯವೀರ್ಯ್ಯಾದ್ ಈಶ್ವರಸ್ಯ ಜೀವನದಾಯಕೇನ ನಿತ್ಯಸ್ಥಾಯಿನಾ ವಾಕ್ಯೇನ ಪುನರ್ಜನ್ಮ ಗೃಹೀತವನ್ತಃ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಸರ್ವ್ವಪ್ರಾಣೀ ತೃಣೈಸ್ತುಲ್ಯಸ್ತತ್ತೇಜಸ್ತೃಣಪುಷ್ಪವತ್| ತೃಣಾನಿ ಪರಿಶುಷ್ಯತಿ ಪುಷ್ಪಾಣಿ ನಿಪತನ್ತಿ ಚ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಕಿನ್ತು ವಾಕ್ಯಂ ಪರೇಶಸ್ಯಾನನ್ತಕಾಲಂ ವಿತಿಷ್ಠತೇ| ತದೇವ ಚ ವಾಕ್ಯಂ ಸುಸಂವಾದೇನ ಯುಷ್ಮಾಕಮ್ ಅನ್ತಿಕೇ ಪ್ರಕಾಶಿತಂ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಸರ್ವ್ವಾನ್ ದ್ವೇಷಾನ್ ಸರ್ವ್ವಾಂಶ್ಚ ಛಲಾನ್ ಕಾಪಟ್ಯಾನೀರ್ಷ್ಯಾಃ ಸಮಸ್ತಗ್ಲಾನಿಕಥಾಶ್ಚ ದೂರೀಕೃತ್ಯ</para>
  <para style="p">
    <verse number="2" style="v"/>ಯುಷ್ಮಾಭಿಃ ಪರಿತ್ರಾಣಾಯ ವೃದ್ಧಿಪ್ರಾಪ್ತ್ಯರ್ಥಂ ನವಜಾತಶಿಶುಭಿರಿವ ಪ್ರಕೃತಂ ವಾಗ್ದುಗ್ಧಂ ಪಿಪಾಸ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಯತಃ ಪ್ರಭು ರ್ಮಧುರ ಏತಸ್ಯಾಸ್ವಾದಂ ಯೂಯಂ ಪ್ರಾಪ್ತವನ್ತಃ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಅಪರಂ ಮಾನುಷೈರವಜ್ಞಾತಸ್ಯ ಕಿನ್ತ್ವೀಶ್ವರೇಣಾಭಿರುಚಿತಸ್ಯ ಬಹುಮೂಲ್ಯಸ್ಯ ಜೀವತ್ಪ್ರಸ್ತರಸ್ಯೇವ ತಸ್ಯ ಪ್ರಭೋಃ ಸನ್ನಿಧಿಮ್ ಆಗತಾ</para>
  <para style="p">
    <verse number="5" style="v"/>ಯೂಯಮಪಿ ಜೀವತ್ಪ್ರಸ್ತರಾ ಇವ ನಿಚೀಯಮಾನಾ ಆತ್ಮಿಕಮನ್ದಿರಂ ಖ್ರೀಷ್ಟೇನ ಯೀಶುನಾ ಚೇಶ್ವರತೋಷಕಾಣಾಮ್ ಆತ್ಮಿಕಬಲೀನಾಂ ದಾನಾರ್ಥಂ ಪವಿತ್ರೋ ಯಾಜಕವರ್ಗೋ ಭವಥ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಯತಃ ಶಾಸ್ತ್ರೇ ಲಿಖಿತಮಾಸ್ತೇ, ಯಥಾ, ಪಶ್ಯ ಪಾಷಾಣ ಏಕೋ ಽಸ್ತಿ ಸೀಯೋನಿ ಸ್ಥಾಪಿತೋ ಮಯಾ| ಮುಖ್ಯಕೋಣಸ್ಯ ಯೋಗ್ಯಃ ಸ ವೃತಶ್ಚಾತೀವ ಮೂಲ್ಯವಾನ್| ಯೋ ಜನೋ ವಿಶ್ವಸೇತ್ ತಸ್ಮಿನ್ ಸ ಲಜ್ಜಾಂ ನ ಗಮಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="7" style="v"/>ವಿಶ್ವಾಸಿನಾಂ ಯುಷ್ಮಾಕಮೇವ ಸಮೀಪೇ ಸ ಮೂಲ್ಯವಾನ್ ಭವತಿ ಕಿನ್ತ್ವವಿಶ್ವಾಸಿನಾಂ ಕೃತೇ ನಿಚೇತೃಭಿರವಜ್ಞಾತಃ ಸ ಪಾಷಾಣಃ ಕೋಣಸ್ಯ ಭಿತ್ತಿಮೂಲಂ ಭೂತ್ವಾ ಬಾಧಾಜನಕಃ ಪಾಷಾಣಃ ಸ್ಖಲನಕಾರಕಶ್ಚ ಶೈಲೋ ಜಾತಃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ತೇ ಚಾವಿಶ್ವಾಸಾದ್ ವಾಕ್ಯೇನ ಸ್ಖಲನ್ತಿ ಸ್ಖಲನೇ ಚ ನಿಯುಕ್ತಾಃ ಸನ್ತಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಕಿನ್ತು ಯೂಯಂ ಯೇನಾನ್ಧಕಾರಮಧ್ಯಾತ್ ಸ್ವಕೀಯಾಶ್ಚರ್ಯ್ಯದೀಪ್ತಿಮಧ್ಯಮ್ ಆಹೂತಾಸ್ತಸ್ಯ ಗುಣಾನ್ ಪ್ರಕಾಶಯಿತುಮ್ ಅಭಿರುಚಿತೋ ವಂಶೋ ರಾಜಕೀಯೋ ಯಾಜಕವರ್ಗಃ ಪವಿತ್ರಾ ಜಾತಿರಧಿಕರ್ತ್ತವ್ಯಾಃ ಪ್ರಜಾಶ್ಚ ಜಾತಾಃ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಪೂರ್ವ್ವಂ ಯೂಯಂ ತಸ್ಯ ಪ್ರಜಾ ನಾಭವತ ಕಿನ್ತ್ವಿದಾನೀಮ್ ಈಶ್ವರಸ್ಯ ಪ್ರಜಾ ಆಧ್ವೇ| ಪೂರ್ವ್ವಮ್ ಅನನುಕಮ್ಪಿತಾ ಅಭವತ ಕಿನ್ತ್ವಿದಾನೀಮ್ ಅನುಕಮ್ಪಿತಾ ಆಧ್ವೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಹೇ ಪ್ರಿಯತಮಾಃ, ಯೂಯಂ ಪ್ರವಾಸಿನೋ ವಿದೇಶಿನಶ್ಚ ಲೋಕಾ ಇವ ಮನಸಃ ಪ್ರಾತಿಕೂಲ್ಯೇನ ಯೋಧಿಭ್ಯಃ ಶಾರೀರಿಕಸುಖಾಭಿಲಾಷೇಭ್ಯೋ ನಿವರ್ತ್ತಧ್ವಮ್ ಇತ್ಯಹಂ ವಿನಯೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ದೇವಪೂಜಕಾನಾಂ ಮಧ್ಯೇ ಯುಷ್ಮಾಕಮ್ ಆಚಾರ ಏವಮ್ ಉತ್ತಮೋ ಭವತು ಯಥಾ ತೇ ಯುಷ್ಮಾನ್ ದುಷ್ಕರ್ಮ್ಮಕಾರಿಲೋಕಾನಿವ ಪುನ ರ್ನ ನಿನ್ದನ್ತಃ ಕೃಪಾದೃಷ್ಟಿದಿನೇ ಸ್ವಚಕ್ಷುರ್ಗೋಚರೀಯಸತ್ಕ್ರಿಯಾಭ್ಯ ಈಶ್ವರಸ್ಯ ಪ್ರಶಂಸಾಂ ಕುರ್ಯ್ಯುಃ|</para>
  <para style="p">
    <verse number="13" style="v"/>ತತೋ ಹೇತೋ ರ್ಯೂಯಂ ಪ್ರಭೋರನುರೋಧಾತ್ ಮಾನವಸೃಷ್ಟಾನಾಂ ಕರ್ತೃತ್ವಪದಾನಾಂ ವಶೀಭವತ ವಿಶೇಷತೋ ಭೂಪಾಲಸ್ಯ ಯತಃ ಸ ಶ್ರೇಷ್ಠಃ,</para>
  <para style="p">
    <verse number="14" style="v"/>ದೇಶಾಧ್ಯಕ್ಷಾಣಾಞ್ಚ ಯತಸ್ತೇ ದುಷ್ಕರ್ಮ್ಮಕಾರಿಣಾಂ ದಣ್ಡದಾನಾರ್ಥಂ ಸತ್ಕರ್ಮ್ಮಕಾರಿಣಾಂ ಪ್ರಶಂಸಾರ್ಥಞ್ಚ ತೇನ ಪ್ರೇರಿತಾಃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಇತ್ಥಂ ನಿರ್ಬ್ಬೋಧಮಾನುಷಾಣಾಮ್ ಅಜ್ಞಾನತ್ವಂ ಯತ್ ಸದಾಚಾರಿಭಿ ರ್ಯುಷ್ಮಾಭಿ ರ್ನಿರುತ್ತರೀಕ್ರಿಯತೇ ತದ್ ಈಶ್ವರಸ್ಯಾಭಿಮತಂ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯೂಯಂ ಸ್ವಾಧೀನಾ ಇವಾಚರತ ತಥಾಪಿ ದುಷ್ಟತಾಯಾ ವೇಷಸ್ವರೂಪಾಂ ಸ್ವಾಧೀನತಾಂ ಧಾರಯನ್ತ ಇವ ನಹಿ ಕಿನ್ತ್ವೀಶ್ವರಸ್ಯ ದಾಸಾ ಇವ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಸರ್ವ್ವಾನ್ ಸಮಾದ್ರಿಯಧ್ವಂ ಭ್ರಾತೃವರ್ಗೇ ಪ್ರೀಯಧ್ವಮ್ ಈಶ್ವರಾದ್ ಬಿಭೀತ ಭೂಪಾಲಂ ಸಮ್ಮನ್ಯಧ್ವಂ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಹೇ ದಾಸಾಃ ಯೂಯಂ ಸಮ್ಪೂರ್ಣಾದರೇಣ ಪ್ರಭೂನಾಂ ವಶ್ಯಾ ಭವತ ಕೇವಲಂ ಭದ್ರಾಣಾಂ ದಯಾಲೂನಾಞ್ಚ ನಹಿ ಕಿನ್ತ್ವನೃಜೂನಾಮಪಿ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಯತೋ ಽನ್ಯಾಯೇನ ದುಃಖಭೋಗಕಾಲ ಈಶ್ವರಚಿನ್ತಯಾ ಯತ್ ಕ್ಲೇಶಸಹನಂ ತದೇವ ಪ್ರಿಯಂ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಪಾಪಂ ಕೃತ್ವಾ ಯುಷ್ಮಾಕಂ ಚಪೇಟಾಘಾತಸಹನೇನ ಕಾ ಪ್ರಶಂಸಾ? ಕಿನ್ತು ಸದಾಚಾರಂ ಕೃತ್ವಾ ಯುಷ್ಮಾಕಂ ಯದ್ ದುಃಖಸಹನಂ ತದೇವೇಶ್ವರಸ್ಯ ಪ್ರಿಯಂ|</para>
  <para style="p">
    <verse number="21" style="v"/>ತದರ್ಥಮೇವ ಯೂಯಮ್ ಆಹೂತಾ ಯತಃ ಖ್ರೀಷ್ಟೋಽಪಿ ಯುಷ್ಮನ್ನಿಮಿತ್ತಂ ದುಃಖಂ ಭುಕ್ತ್ವಾ ಯೂಯಂ ಯತ್ ತಸ್ಯ ಪದಚಿಹ್ನೈ ರ್ವ್ರಜೇತ ತದರ್ಥಂ ದೃಷ್ಟಾನ್ತಮೇಕಂ ದರ್ಶಿತವಾನ್|</para>
  <para style="p">
    <verse number="22" style="v"/>ಸ ಕಿಮಪಿ ಪಾಪಂ ನ ಕೃತವಾನ್ ತಸ್ಯ ವದನೇ ಕಾಪಿ ಛಲಸ್ಯ ಕಥಾ ನಾಸೀತ್|</para>
  <para style="p">
    <verse number="23" style="v"/>ನಿನ್ದಿತೋ ಽಪಿ ಸನ್ ಸ ಪ್ರತಿನಿನ್ದಾಂ ನ ಕೃತವಾನ್ ದುಃಖಂ ಸಹಮಾನೋ ಽಪಿ ನ ಭರ್ತ್ಸಿತವಾನ್ ಕಿನ್ತು ಯಥಾರ್ಥವಿಚಾರಯಿತುಃ ಸಮೀಪೇ ಸ್ವಂ ಸಮರ್ಪಿತವಾನ್|</para>
  <para style="p">
    <verse number="24" style="v"/>ವಯಂ ಯತ್ ಪಾಪೇಭ್ಯೋ ನಿವೃತ್ಯ ಧರ್ಮ್ಮಾರ್ಥಂ ಜೀವಾಮಸ್ತದರ್ಥಂ ಸ ಸ್ವಶರೀರೇಣಾಸ್ಮಾಕಂ ಪಾಪಾನಿ ಕ್ರುಶ ಊಢವಾನ್ ತಸ್ಯ ಪ್ರಹಾರೈ ರ್ಯೂಯಂ ಸ್ವಸ್ಥಾ ಅಭವತ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಯತಃ ಪೂರ್ವ್ವಂ ಯೂಯಂ ಭ್ರಮಣಕಾರಿಮೇಷಾ ಇವಾಧ್ವಂ ಕಿನ್ತ್ವಧುನಾ ಯುಷ್ಮಾಕಮ್ ಆತ್ಮನಾಂ ಪಾಲಕಸ್ಯಾಧ್ಯಕ್ಷಸ್ಯ ಚ ಸಮೀಪಂ ಪ್ರತ್ಯಾವರ್ತ್ತಿತಾಃ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಯೋಷಿತಃ, ಯೂಯಮಪಿ ನಿಜಸ್ವಾಮಿನಾಂ ವಶ್ಯಾ ಭವತ ತಥಾ ಸತಿ ಯದಿ ಕೇಚಿದ್ ವಾಕ್ಯೇ ವಿಶ್ವಾಸಿನೋ ನ ಸನ್ತಿ ತರ್ಹಿ</para>
  <para style="p">
    <verse number="2" style="v"/>ತೇ ವಿನಾವಾಕ್ಯಂ ಯೋಷಿತಾಮ್ ಆಚಾರೇಣಾರ್ಥತಸ್ತೇಷಾಂ ಪ್ರತ್ಯಕ್ಷೇಣ ಯುಷ್ಮಾಕಂ ಸಭಯಸತೀತ್ವಾಚಾರೇಣಾಕ್ರಷ್ಟುಂ ಶಕ್ಷ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅಪರಂ ಕೇಶರಚನಯಾ ಸ್ವರ್ಣಾಲಙ್ಕಾರಧಾರಣೋನ ಪರಿಚ್ಛದಪರಿಧಾನೇನ ವಾ ಯುಷ್ಮಾಕಂ ವಾಹ್ಯಭೂಷಾ ನ ಭವತು,</para>
  <para style="p">
    <verse number="4" style="v"/>ಕಿನ್ತ್ವೀಶ್ವರಸ್ಯ ಸಾಕ್ಷಾದ್ ಬಹುಮೂಲ್ಯಕ್ಷಮಾಶಾನ್ತಿಭಾವಾಕ್ಷಯರತ್ನೇನ ಯುಕ್ತೋ ಗುಪ್ತ ಆನ್ತರಿಕಮಾನವ ಏವ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯತಃ ಪೂರ್ವ್ವಕಾಲೇ ಯಾಃ ಪವಿತ್ರಸ್ತ್ರಿಯ ಈಶ್ವರೇ ಪ್ರತ್ಯಾಶಾಮಕುರ್ವ್ವನ್ ತಾ ಅಪಿ ತಾದೃಶೀಮೇವ ಭೂಷಾಂ ಧಾರಯನ್ತ್ಯೋ ನಿಜಸ್ವಾಮಿನಾಂ ವಶ್ಯಾ ಅಭವನ್|</para>
  <para style="p">
    <verse number="6" style="v"/>ತಥೈವ ಸಾರಾ ಇಬ್ರಾಹೀಮೋ ವಶ್ಯಾ ಸತೀ ತಂ ಪತಿಮಾಖ್ಯಾತವತೀ ಯೂಯಞ್ಚ ಯದಿ ಸದಾಚಾರಿಣ್ಯೋ ಭವಥ ವ್ಯಾಕುಲತಯಾ ಚ ಭೀತಾ ನ ಭವಥ ತರ್ಹಿ ತಸ್ಯಾಃ ಕನ್ಯಾ ಆಧ್ವೇ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಹೇ ಪುರುಷಾಃ, ಯೂಯಂ ಜ್ಞಾನತೋ ದುರ್ಬ್ಬಲತರಭಾಜನೈರಿವ ಯೋಷಿದ್ಭಿಃ ಸಹವಾಸಂ ಕುರುತ, ಏಕಸ್ಯ ಜೀವನವರಸ್ಯ ಸಹಭಾಗಿನೀಭ್ಯತಾಭ್ಯಃ ಸಮಾದರಂ ವಿತರತ ಚ ನ ಚೇದ್ ಯುಷ್ಮಾಕಂ ಪ್ರಾರ್ಥನಾನಾಂ ಬಾಧಾ ಜನಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="8" style="v"/>ವಿಶೇಷತೋ ಯೂಯಂ ಸರ್ವ್ವ ಏಕಮನಸಃ ಪರದುಃಖೈ ರ್ದುಃಖಿತಾ ಭ್ರಾತೃಪ್ರಮಿಣಃ ಕೃಪಾವನ್ತಃ ಪ್ರೀತಿಭಾವಾಶ್ಚ ಭವತ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಅನಿಷ್ಟಸ್ಯ ಪರಿಶೋಧೇನಾನಿಷ್ಟಂ ನಿನ್ದಾಯಾ ವಾ ಪರಿಶೋಧೇನ ನಿನ್ದಾಂ ನ ಕುರ್ವ್ವನ್ತ ಆಶಿಷಂ ದತ್ತ ಯತೋ ಯೂಯಮ್ ಆಶಿರಧಿಕಾರಿಣೋ ಭವಿತುಮಾಹೂತಾ ಇತಿ ಜಾನೀಥ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಅಪರಞ್ಚ, ಜೀವನೇ ಪ್ರೀಯಮಾಣೋ ಯಃ ಸುದಿನಾನಿ ದಿದೃಕ್ಷತೇ| ಪಾಪಾತ್ ಜಿಹ್ವಾಂ ಮೃಷಾವಾಕ್ಯಾತ್ ಸ್ವಾಧರೌ ಸ ನಿವರ್ತ್ತಯೇತ್|</para>
  <para style="p">
    <verse number="11" style="v"/>ಸ ತ್ಯಜೇದ್ ದುಷ್ಟತಾಮಾರ್ಗಂ ಸತ್ಕ್ರಿಯಾಞ್ಚ ಸಮಾಚರೇತ್| ಮೃಗಯಾಣಶ್ಚ ಶಾನ್ತಿಂ ಸ ನಿತ್ಯಮೇವಾನುಧಾವತು|</para>
  <para style="p">
    <verse number="12" style="v"/>ಲೋಚನೇ ಪರಮೇಶಸ್ಯೋನ್ಮೀಲಿತೇ ಧಾರ್ಮ್ಮಿಕಾನ್ ಪ್ರತಿ| ಪ್ರಾರ್ಥನಾಯಾಃ ಕೃತೇ ತೇಷಾಃ ತಚ್ಛ್ರೋತ್ರೇ ಸುಗಮೇ ಸದಾ| ಕ್ರೋಧಾಸ್ಯಞ್ಚ ಪರೇಶಸ್ಯ ಕದಾಚಾರಿಷು ವರ್ತ್ತತೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅಪರಂ ಯದಿ ಯೂಯಮ್ ಉತ್ತಮಸ್ಯಾನುಗಾಮಿನೋ ಭವಥ ತರ್ಹಿ ಕೋ ಯುಷ್ಮಾನ್ ಹಿಂಸಿಷ್ಯತೇ?</para>
  <para style="p">
    <verse number="14" style="v"/>ಯದಿ ಚ ಧರ್ಮ್ಮಾರ್ಥಂ ಕ್ಲಿಶ್ಯಧ್ವಂ ತರ್ಹಿ ಧನ್ಯಾ ಭವಿಷ್ಯಥ| ತೇಷಾಮ್ ಆಶಙ್ಕಯಾ ಯೂಯಂ ನ ಬಿಭೀತ ನ ವಿಙ್ಕ್ತ ವಾ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಮನೋಭಿಃ ಕಿನ್ತು ಮನ್ಯಧ್ವಂ ಪವಿತ್ರಂ ಪ್ರಭುಮೀಶ್ವರಂ| ಅಪರಞ್ಚ ಯುಷ್ಮಾಕಮ್ ಆನ್ತರಿಕಪ್ರತ್ಯಾಶಾಯಾಸ್ತತ್ತ್ವಂ ಯಃ ಕಶ್ಚಿತ್ ಪೃಚ್ಛತಿ ತಸ್ಮೈ ಶಾನ್ತಿಭೀತಿಭ್ಯಾಮ್ ಉತ್ತರಂ ದಾತುಂ ಸದಾ ಸುಸಜ್ಜಾ ಭವತ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯೇ ಚ ಖ್ರೀಷ್ಟಧರ್ಮ್ಮೇ ಯುಷ್ಮಾಕಂ ಸದಾಚಾರಂ ದೂಷಯನ್ತಿ ತೇ ದುಷ್ಕರ್ಮ್ಮಕಾರಿಣಾಮಿವ ಯುಷ್ಮಾಕಮ್ ಅಪವಾದೇನ ಯತ್ ಲಜ್ಜಿತಾ ಭವೇಯುಸ್ತದರ್ಥಂ ಯುಷ್ಮಾಕಮ್ ಉತ್ತಮಃ ಸಂವೇದೋ ಭವತು|</para>
  <para style="p">
    <verse number="17" style="v"/>ಈಶ್ವರಸ್ಯಾಭಿಮತಾದ್ ಯದಿ ಯುಷ್ಮಾಭಿಃ ಕ್ಲೇಶಃ ಸೋಢವ್ಯಸ್ತರ್ಹಿ ಸದಾಚಾರಿಭಿಃ ಕ್ಲೇಶಸಹನಂ ವರಂ ನ ಚ ಕದಾಚಾರಿಭಿಃ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಯಸ್ಮಾದ್ ಈಶ್ವರಸ್ಯ ಸನ್ನಿಧಿಮ್ ಅಸ್ಮಾನ್ ಆನೇತುಮ್ ಅಧಾರ್ಮ್ಮಿಕಾಣಾಂ ವಿನಿಮಯೇನ ಧಾರ್ಮ್ಮಿಕಃ ಖ್ರೀಷ್ಟೋ ಽಪ್ಯೇಕಕೃತ್ವಃ ಪಾಪಾನಾಂ ದಣ್ಡಂ ಭುಕ್ತವಾನ್, ಸ ಚ ಶರೀರಸಮ್ಬನ್ಧೇ ಮಾರಿತಃ ಕಿನ್ತ್ವಾತ್ಮನಃ ಸಮ್ಬನ್ಧೇ ಪುನ ರ್ಜೀವಿತೋ ಽಭವತ್|</para>
  <para style="p">
    <verse number="19" style="v"/>ತತ್ಸಮ್ಬನ್ಧೇ ಚ ಸ ಯಾತ್ರಾಂ ವಿಧಾಯ ಕಾರಾಬದ್ಧಾನಾಮ್ ಆತ್ಮನಾಂ ಸಮೀಪೇ ವಾಕ್ಯಂ ಘೋಷಿತವಾನ್|</para>
  <para style="p">
    <verse number="20" style="v"/>ಪುರಾ ನೋಹಸ್ಯ ಸಮಯೇ ಯಾವತ್ ಪೋತೋ ನಿರಮೀಯತ ತಾವದ್ ಈಶ್ವರಸ್ಯ ದೀರ್ಘಸಹಿಷ್ಣುತಾ ಯದಾ ವ್ಯಲಮ್ಬತ ತದಾ ತೇಽನಾಜ್ಞಾಗ್ರಾಹಿಣೋಽಭವನ್| ತೇನ ಪೋತೋನಾಲ್ಪೇಽರ್ಥಾದ್ ಅಷ್ಟಾವೇವ ಪ್ರಾಣಿನಸ್ತೋಯಮ್ ಉತ್ತೀರ್ಣಾಃ|</para>
  <para style="p">
    <verse number="21" style="v"/>ತನ್ನಿದರ್ಶನಞ್ಚಾವಗಾಹನಂ (ಅರ್ಥತಃ ಶಾರೀರಿಕಮಲಿನತಾಯಾ ಯಸ್ತ್ಯಾಗಃ ಸ ನಹಿ ಕಿನ್ತ್ವೀಶ್ವರಾಯೋತ್ತಮಸಂವೇದಸ್ಯ ಯಾ ಪ್ರತಜ್ಞಾ ಸೈವ) ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಪುನರುತ್ಥಾನೇನೇದಾನೀಮ್ ಅಸ್ಮಾನ್ ಉತ್ತಾರಯತಿ,</para>
  <para style="p">
    <verse number="22" style="v"/>ಯತಃ ಸ ಸ್ವರ್ಗಂ ಗತ್ವೇಶ್ವರಸ್ಯ ದಕ್ಷಿಣೇ ವಿದ್ಯತೇ ಸ್ವರ್ಗೀಯದೂತಾಃ ಶಾಸಕಾ ಬಲಾನಿ ಚ ತಸ್ಯ ವಶೀಭೂತಾ ಅಭವನ್|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅಸ್ಮಾಕಂ ವಿನಿಮಯೇನ ಖ್ರೀಷ್ಟಃ ಶರೀರಸಮ್ಬನ್ಧೇ ದಣ್ಡಂ ಭುಕ್ತವಾನ್ ಅತೋ ಹೇತೋಃ ಶರೀರಸಮ್ಬನ್ಧೇ ಯೋ ದಣ್ಡಂ ಭುಕ್ತವಾನ್ ಸ ಪಾಪಾತ್ ಮುಕ್ತ</para>
  <para style="p">
    <verse number="2" style="v"/>ಇತಿಭಾವೇನ ಯೂಯಮಪಿ ಸುಸಜ್ಜೀಭೂಯ ದೇಹವಾಸಸ್ಯಾವಶಿಷ್ಟಂ ಸಮಯಂ ಪುನರ್ಮಾನವಾನಾಮ್ ಇಚ್ಛಾಸಾಧನಾರ್ಥಂ ನಹಿ ಕಿನ್ತ್ವೀಶ್ವರಸ್ಯೇಚ್ಛಾಸಾಧನಾರ್ಥಂ ಯಾಪಯತ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಆಯುಷೋ ಯಃ ಸಮಯೋ ವ್ಯತೀತಸ್ತಸ್ಮಿನ್ ಯುಷ್ಮಾಭಿ ರ್ಯದ್ ದೇವಪೂಜಕಾನಾಮ್ ಇಚ್ಛಾಸಾಧನಂ ಕಾಮಕುತ್ಸಿತಾಭಿಲಾಷಮದ್ಯಪಾನರಙ್ಗರಸಮತ್ತತಾಘೃಣಾರ್ಹದೇವಪೂಜಾಚರಣಞ್ಚಾಕಾರಿ ತೇನ ಬಾಹುಲ್ಯಂ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಯೂಯಂ ತೈಃ ಸಹ ತಸ್ಮಿನ್ ಸರ್ವ್ವನಾಶಪಙ್ಕೇ ಮಜ್ಜಿತುಂ ನ ಧಾವಥ, ಇತ್ಯನೇನಾಶ್ಚರ್ಯ್ಯಂ ವಿಜ್ಞಾಯ ತೇ ಯುಷ್ಮಾನ್ ನಿನ್ದನ್ತಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಕಿನ್ತು ಯೋ ಜೀವತಾಂ ಮೃತಾನಾಞ್ಚ ವಿಚಾರಂ ಕರ್ತ್ತುಮ್ ಉದ್ಯತೋಽಸ್ತಿ ತಸ್ಮೈ ತೈರುತ್ತರಂ ದಾಯಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಯತೋ ಹೇತೋ ರ್ಯೇ ಮೃತಾಸ್ತೇಷಾಂ ಯತ್ ಮಾನವೋದ್ದೇಶ್ಯಃ ಶಾರೀರಿಕವಿಚಾರಃ ಕಿನ್ತ್ವೀಶ್ವರೋದ್ದೇಶ್ಯಮ್ ಆತ್ಮಿಕಜೀವನಂ ಭವತ್ ತದರ್ಥಂ ತೇಷಾಮಪಿ ಸನ್ನಿಧೌ ಸುಸಮಾಚಾರಃ ಪ್ರಕಾಶಿತೋಽಭವತ್|</para>
  <para style="p">
    <verse number="7" style="v"/>ಸರ್ವ್ವೇಷಾಮ್ ಅನ್ತಿಮಕಾಲ ಉಪಸ್ಥಿತಸ್ತಸ್ಮಾದ್ ಯೂಯಂ ಸುಬುದ್ಧಯಃ ಪ್ರಾರ್ಥನಾರ್ಥಂ ಜಾಗ್ರತಶ್ಚ ಭವತ|</para>
  <para style="p">
    <verse number="8" style="v"/>ವಿಶೇಷತಃ ಪರಸ್ಪರಂ ಗಾಢಂ ಪ್ರೇಮ ಕುರುತ, ಯತಃ, ಪಾಪಾನಾಮಪಿ ಬಾಹುಲ್ಯಂ ಪ್ರೇಮ್ನೈವಾಚ್ಛಾದಯಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಕಾತರೋಕ್ತಿಂ ವಿನಾ ಪರಸ್ಪರಮ್ ಆತಿಥ್ಯಂ ಕೃರುತ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯೇನ ಯೋ ವರೋ ಲಬ್ಧಸ್ತೇನೈವ ಸ ಪರಮ್ ಉಪಕರೋತೃ, ಇತ್ಥಂ ಯೂಯಮ್ ಈಶ್ವರಸ್ಯ ಬಹುವಿಧಪ್ರಸಾದಸ್ಯೋತ್ತಮಾ ಭಾಣ್ಡಾಗಾರಾಧಿಪಾ ಭವತ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಯೋ ವಾಕ್ಯಂ ಕಥಯತಿ ಸ ಈಶ್ವರಸ್ಯ ವಾಕ್ಯಮಿವ ಕಥಯತು ಯಶ್ಚ ಪರಮ್ ಉಪಕರೋತಿ ಸ ಈಶ್ವರದತ್ತಸಾಮರ್ಥ್ಯಾದಿವೋಪಕರೋತು| ಸರ್ವ್ವವಿಷಯೇ ಯೀಶುಖ್ರೀಷ್ಟೇನೇಶ್ವರಸ್ಯ ಗೌರವಂ ಪ್ರಕಾಶ್ಯತಾಂ ತಸ್ಯೈವ ಗೌರವಂ ಪರಾಕ್ರಮಶ್ಚ ಸರ್ವ್ವದಾ ಭೂಯಾತ್| ಆಮೇನ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಹೇ ಪ್ರಿಯತಮಾಃ, ಯುಷ್ಮಾಕಂ ಪರೀಕ್ಷಾರ್ಥಂ ಯಸ್ತಾಪೋ ಯುಷ್ಮಾಸು ವರ್ತ್ತತೇ ತಮ್ ಅಸಮ್ಭವಘಟಿತಂ ಮತ್ವಾ ನಾಶ್ಚರ್ಯ್ಯಂ ಜಾನೀತ,</para>
  <para style="p">
    <verse number="13" style="v"/>ಕಿನ್ತು ಖ್ರೀಷ್ಟೇನ ಕ್ಲೇಶಾನಾಂ ಸಹಭಾಗಿತ್ವಾದ್ ಆನನ್ದತ ತೇನ ತಸ್ಯ ಪ್ರತಾಪಪ್ರಕಾಶೇಽಪ್ಯಾನನನ್ದೇನ ಪ್ರಫುಲ್ಲಾ ಭವಿಷ್ಯಥ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯದಿ ಖ್ರೀಷ್ಟಸ್ಯ ನಾಮಹೇತುನಾ ಯುಷ್ಮಾಕಂ ನಿನ್ದಾ ಭವತಿ ತರ್ಹಿ ಯೂಯಂ ಧನ್ಯಾ ಯತೋ ಗೌರವದಾಯಕ ಈಶ್ವರಸ್ಯಾತ್ಮಾ ಯುಷ್ಮಾಸ್ವಧಿತಿಷ್ಠತಿ ತೇಷಾಂ ಮಧ್ಯೇ ಸ ನಿನ್ದ್ಯತೇ ಕಿನ್ತು ಯುಷ್ಮನ್ಮಧ್ಯೇ ಪ್ರಶಂಸ್ಯತೇ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಕಿನ್ತು ಯುಷ್ಮಾಕಂ ಕೋಽಪಿ ಹನ್ತಾ ವಾ ಚೈರೋ ವಾ ದುಷ್ಕರ್ಮ್ಮಕೃದ್ ವಾ ಪರಾಧಿಕಾರಚರ್ಚ್ಚಕ ಇವ ದಣ್ಡಂ ನ ಭುಙ್ಕ್ತಾಂ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯದಿ ಚ ಖ್ರೀಷ್ಟೀಯಾನ ಇವ ದಣ್ಡಂ ಭುಙ್ಕ್ತೇ ತರ್ಹಿ ಸ ನ ಲಜ್ಜಮಾನಸ್ತತ್ಕಾರಣಾದ್ ಈಶ್ವರಂ ಪ್ರಶಂಸತು|</para>
  <para style="p">
    <verse number="17" style="v"/>ಯತೋ ವಿಚಾರಸ್ಯಾರಮ್ಭಸಮಯೇ ಈಶ್ವರಸ್ಯ ಮನ್ದಿರೇ ಯುಜ್ಯತೇ ಯದಿ ಚಾಸ್ಮತ್ಸ್ವಾರಭತೇ ತರ್ಹೀಶ್ವರೀಯಸುಸಂವಾದಾಗ್ರಾಹಿಣಾಂ ಶೇಷದಶಾ ಕಾ ಭವಿಷ್ಯತಿ?</para>
  <para style="p">
    <verse number="18" style="v"/>ಧಾರ್ಮ್ಮಿಕೇನಾಪಿ ಚೇತ್ ತ್ರಾಣಮ್ ಅತಿಕೃಚ್ಛ್ರೇಣ ಗಮ್ಯತೇ| ತರ್ಹ್ಯಧಾರ್ಮ್ಮಿಕಪಾಪಿಭ್ಯಾಮ್ ಆಶ್ರಯಃ ಕುತ್ರ ಲಪ್ಸ್ಯತೇ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಅತ ಈಶ್ವರೇಚ್ಛಾತೋ ಯೇ ದುಃಖಂ ಭುಞ್ಜತೇ ತೇ ಸದಾಚಾರೇಣ ಸ್ವಾತ್ಮಾನೋ ವಿಶ್ವಾಸ್ಯಸ್ರಷ್ಟುರೀಶ್ವಸ್ಯ ಕರಾಭ್ಯಾಂ ನಿದಧತಾಂ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಖ್ರೀಷ್ಟಸ್ಯ ಕ್ಲೇಶಾನಾಂ ಸಾಕ್ಷೀ ಪ್ರಕಾಶಿಷ್ಯಮಾಣಸ್ಯ ಪ್ರತಾಪಸ್ಯಾಂಶೀ ಪ್ರಾಚೀನಶ್ಚಾಹಂ ಯುಷ್ಮಾಕಂ ಪ್ರಾಚೀನಾನ್ ವಿನೀಯೇದಂ ವದಾಮಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯುಷ್ಮಾಕಂ ಮಧ್ಯವರ್ತ್ತೀ ಯ ಈಶ್ವರಸ್ಯ ಮೇಷವೃನ್ದೋ ಯೂಯಂ ತಂ ಪಾಲಯತ ತಸ್ಯ ವೀಕ್ಷಣಂ ಕುರುತ ಚ, ಆವಶ್ಯಕತ್ವೇನ ನಹಿ ಕಿನ್ತು ಸ್ವೇಚ್ಛಾತೋ ನ ವ ಕುಲೋಭೇನ ಕಿನ್ತ್ವಿಚ್ಛುಕಮನಸಾ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅಪರಮ್ ಅಂಶಾನಾಮ್ ಅಧಿಕಾರಿಣ ಇವ ನ ಪ್ರಭವತ ಕಿನ್ತು ವೃನ್ದಸ್ಯ ದೃಷ್ಟಾನ್ತಸ್ವರೂಪಾ ಭವತ|</para>
  <para style="p">
    <verse number="4" style="v"/>ತೇನ ಪ್ರಧಾನಪಾಲಕ ಉಪಸ್ಥಿತೇ ಯೂಯಮ್ ಅಮ್ಲಾನಂ ಗೌರವಕಿರೀಟಂ ಲಪ್ಸ್ಯಧ್ವೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಹೇ ಯುವಾನಃ, ಯೂಯಮಪಿ ಪ್ರಾಚೀನಲೋಕಾನಾಂ ವಶ್ಯಾ ಭವತ ಸರ್ವ್ವೇ ಚ ಸರ್ವ್ವೇಷಾಂ ವಶೀಭೂಯ ನಮ್ರತಾಭರಣೇನ ಭೂಷಿತಾ ಭವತ, ಯತಃ,ಆತ್ಮಾಭಿಮಾನಿಲೋಕಾನಾಂ ವಿಪಕ್ಷೋ ಭವತೀಶ್ವರಃ| ಕಿನ್ತು ತೇನೈವ ನಮ್ರೇಭ್ಯಃ ಪ್ರಸಾದಾದ್ ದೀಯತೇ ವರಃ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅತೋ ಯೂಯಮ್ ಈಶ್ವರಸ್ಯ ಬಲವತ್ಕರಸ್ಯಾಧೋ ನಮ್ರೀಭೂಯ ತಿಷ್ಠತ ತೇನ ಸ ಉಚಿತಸಮಯೇ ಯುಷ್ಮಾನ್ ಉಚ್ಚೀಕರಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯೂಯಂ ಸರ್ವ್ವಚಿನ್ತಾಂ ತಸ್ಮಿನ್ ನಿಕ್ಷಿಪತ ಯತಃ ಸ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಚಿನ್ತಯತಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಯೂಯಂ ಪ್ರಬುದ್ಧಾ ಜಾಗ್ರತಶ್ಚ ತಿಷ್ಠತ ಯತೋ ಯುಷ್ಮಾಕಂ ಪ್ರತಿವಾದೀ ಯಃ ಶಯತಾನಃ ಸ ಗರ್ಜ್ಜನಕಾರೀ ಸಿಂಹ ಇವ ಪರ್ಯ್ಯಟನ್ ಕಂ ಗ್ರಸಿಷ್ಯಾಮೀತಿ ಮೃಗಯತೇ,</para>
  <para style="p">
    <verse number="9" style="v"/>ಅತೋ ವಿಶ್ವಾಸೇ ಸುಸ್ಥಿರಾಸ್ತಿಷ್ಠನ್ತಸ್ತೇನ ಸಾರ್ದ್ಧಂ ಯುಧ್ಯತ, ಯುಷ್ಮಾಕಂ ಜಗನ್ನಿವಾಸಿಭ್ರಾತೃಷ್ವಪಿ ತಾದೃಶಾಃ ಕ್ಲೇಶಾ ವರ್ತ್ತನ್ತ ಇತಿ ಜಾನೀತ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಕ್ಷಣಿಕದುಃಖಭೋಗಾತ್ ಪರಮ್ ಅಸ್ಮಭ್ಯಂ ಖ್ರೀಷ್ಟೇನ ಯೀಶುನಾ ಸ್ವಕೀಯಾನನ್ತಗೌರವದಾನಾರ್ಥಂ ಯೋಽಸ್ಮಾನ್ ಆಹೂತವಾನ್ ಸ ಸರ್ವ್ವಾನುಗ್ರಾಹೀಶ್ವರಃ ಸ್ವಯಂ ಯುಷ್ಮಾನ್ ಸಿದ್ಧಾನ್ ಸ್ಥಿರಾನ್ ಸಬಲಾನ್ ನಿಶ್ಚಲಾಂಶ್ಚ ಕರೋತು|</para>
  <para style="p">
    <verse number="11" style="v"/>ತಸ್ಯ ಗೌರವಂ ಪರಾಕ್ರಮಶ್ಚಾನನ್ತಕಾಲಂ ಯಾವದ್ ಭೂಯಾತ್| ಆಮೇನ್|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯಃ ಸಿಲ್ವಾನೋ (ಮನ್ಯೇ) ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸ್ಯೋ ಭ್ರಾತಾ ಭವತಿ ತದ್ವಾರಾಹಂ ಸಂಕ್ಷೇಪೇಣ ಲಿಖಿತ್ವಾ ಯುಷ್ಮಾನ್ ವಿನೀತವಾನ್ ಯೂಯಞ್ಚ ಯಸ್ಮಿನ್ ಅಧಿತಿಷ್ಠಥ ಸ ಏವೇಶ್ವರಸ್ಯ ಸತ್ಯೋ ಽನುಗ್ರಹ ಇತಿ ಪ್ರಮಾಣಂ ದತ್ತವಾನ್|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯುಷ್ಮಾಭಿಃ ಸಹಾಭಿರುಚಿತಾ ಯಾ ಸಮಿತಿ ರ್ಬಾಬಿಲಿ ವಿದ್ಯತೇ ಸಾ ಮಮ ಪುತ್ರೋ ಮಾರ್ಕಶ್ಚ ಯುಷ್ಮಾನ್ ನಮಸ್ಕಾರಂ ವೇದಯತಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯೂಯಂ ಪ್ರೇಮಚುಮ್ಬನೇನ ಪರಸ್ಪರಂ ನಮಸ್ಕುರುತ| ಯೀಶುಖ್ರೀಷ್ಟಾಶ್ರಿತಾನಾಂ ಯುಷ್ಮಾಕಂ ಸರ್ವ್ವೇಷಾಂ ಶಾನ್ತಿ ರ್ಭೂಯಾತ್| ಆಮೇನ್|</para>
</usx>
