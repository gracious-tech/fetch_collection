<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1TH" style="id">Sanskrit Bible (NT) in Kannada Script (ಸತ್ಯವೇದಃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 Thessalonians</para>
  <para style="toc1">೧ ಥಿಷಲನೀಕಿನಃ ಪತ್ರಂ</para>
  <para style="toc2">೧ ಥಿಷಲನೀಕಿನಃ</para>
  <para style="toc3">೧ ಥಿಷಲನೀಕಿನಃ</para>
  <para style="mt1">೧ ಥಿಷಲನೀಕಿನಃ ಪತ್ರಂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಪೌಲಃ ಸಿಲ್ವಾನಸ್ತೀಮಥಿಯಶ್ಚ ಪಿತುರೀಶ್ವರಸ್ಯ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಚಾಶ್ರಯಂ ಪ್ರಾಪ್ತಾ ಥಿಷಲನೀಕೀಯಸಮಿತಿಂ ಪ್ರತಿ ಪತ್ರಂ ಲಿಖನ್ತಿ| ಅಸ್ಮಾಕಂ ತಾತ ಈಶ್ವರಃ ಪ್ರಭು ರ್ಯೀಶುಖ್ರೀಷ್ಟಶ್ಚ ಯುಷ್ಮಾನ್ ಪ್ರತ್ಯನುಗ್ರಹಂ ಶಾನ್ತಿಞ್ಚ ಕ್ರಿಯಾಸ್ತಾಂ|</para>
  <para style="p">
    <verse number="2" style="v"/>ವಯಂ ಸರ್ವ್ವೇಷಾಂ ಯುಷ್ಮಾಕಂ ಕೃತೇ ಈಶ್ವರಂ ಧನ್ಯಂ ವದಾಮಃ ಪ್ರಾರ್ಥನಾಸಮಯೇ ಯುಷ್ಮಾಕಂ ನಾಮೋಚ್ಚಾರಯಾಮಃ,</para>
  <para style="p">
    <verse number="3" style="v"/>ಅಸ್ಮಾಕಂ ತಾತಸ್ಯೇಶ್ವರಸ್ಯ ಸಾಕ್ಷಾತ್ ಪ್ರಭೌ ಯೀಶುಖ್ರೀಷ್ಟೇ ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸೇನ ಯತ್ ಕಾರ್ಯ್ಯಂ ಪ್ರೇಮ್ನಾ ಯಃ ಪರಿಶ್ರಮಃ ಪ್ರತ್ಯಾಶಯಾ ಚ ಯಾ ತಿತಿಕ್ಷಾ ಜಾಯತೇ</para>
  <para style="p">
    <verse number="4" style="v"/>ತತ್ ಸರ್ವ್ವಂ ನಿರನ್ತರಂ ಸ್ಮರಾಮಶ್ಚ| ಹೇ ಪಿಯಭ್ರಾತರಃ, ಯೂಯಮ್ ಈಶ್ವರೇಣಾಭಿರುಚಿತಾ ಲೋಕಾ ಇತಿ ವಯಂ ಜಾನೀಮಃ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯತೋಽಸ್ಮಾಕಂ ಸುಸಂವಾದಃ ಕೇವಲಶಬ್ದೇನ ಯುಷ್ಮಾನ್ ನ ಪ್ರವಿಶ್ಯ ಶಕ್ತ್ಯಾ ಪವಿತ್ರೇಣಾತ್ಮನಾ ಮಹೋತ್ಸಾಹೇನ ಚ ಯುಷ್ಮಾನ್ ಪ್ರಾವಿಶತ್| ವಯನ್ತು ಯುಷ್ಮಾಕಂ ಕೃತೇ ಯುಷ್ಮನ್ಮಧ್ಯೇ ಕೀದೃಶಾ ಅಭವಾಮ ತದ್ ಯುಷ್ಮಾಭಿ ರ್ಜ್ಞಾಯತೇ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಯೂಯಮಪಿ ಬಹುಕ್ಲೇಶಭೋಗೇನ ಪವಿತ್ರೇಣಾತ್ಮನಾ ದತ್ತೇನಾನನ್ದೇನ ಚ ವಾಕ್ಯಂ ಗೃಹೀತ್ವಾಸ್ಮಾಕಂ ಪ್ರಭೋಶ್ಚಾನುಗಾಮಿನೋಽಭವತ|</para>
  <para style="p">
    <verse number="7" style="v"/>ತೇನ ಮಾಕಿದನಿಯಾಖಾಯಾದೇಶಯೋ ರ್ಯಾವನ್ತೋ ವಿಶ್ವಾಸಿನೋ ಲೋಕಾಃ ಸನ್ತಿ ಯೂಯಂ ತೇಷಾಂ ಸರ್ವ್ವೇಷಾಂ ನಿದರ್ಶನಸ್ವರೂಪಾ ಜಾತಾಃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಯತೋ ಯುಷ್ಮತ್ತಃ ಪ್ರತಿನಾದಿತಯಾ ಪ್ರಭೋ ರ್ವಾಣ್ಯಾ ಮಾಕಿದನಿಯಾಖಾಯಾದೇಶೌ ವ್ಯಾಪ್ತೌ ಕೇವಲಮೇತನ್ನಹಿ ಕಿನ್ತ್ವೀಶ್ವರೇ ಯುಷ್ಮಾಕಂ ಯೋ ವಿಶ್ವಾಸಸ್ತಸ್ಯ ವಾರ್ತ್ತಾ ಸರ್ವ್ವತ್ರಾಶ್ರಾವಿ, ತಸ್ಮಾತ್ ತತ್ರ ವಾಕ್ಯಕಥನಮ್ ಅಸ್ಮಾಕಂ ನಿಷ್ಪ್ರಯೋಜನಂ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಯತೋ ಯುಷ್ಮನ್ಮಧ್ಯೇ ವಯಂ ಕೀದೃಶಂ ಪ್ರವೇಶಂ ಪ್ರಾಪ್ತಾ ಯೂಯಞ್ಚ ಕಥಂ ಪ್ರತಿಮಾ ವಿಹಾಯೇಶ್ವರಂ ಪ್ರತ್ಯಾವರ್ತ್ತಧ್ವಮ್ ಅಮರಂ ಸತ್ಯಮೀಶ್ವರಂ ಸೇವಿತುಂ</para>
  <para style="p">
    <verse number="10" style="v"/>ಮೃತಗಣಮಧ್ಯಾಚ್ಚ ತೇನೋತ್ಥಾಪಿತಸ್ಯ ಪುತ್ರಸ್ಯಾರ್ಥತ ಆಗಾಮಿಕ್ರೋಧಾದ್ ಅಸ್ಮಾಕಂ ನಿಸ್ತಾರಯಿತು ರ್ಯೀಶೋಃ ಸ್ವರ್ಗಾದ್ ಆಗಮನಂ ಪ್ರತೀಕ್ಷಿತುಮ್ ಆರಭಧ್ವಮ್ ಏತತ್ ಸರ್ವ್ವಂ ತೇ ಲೋಕಾಃ ಸ್ವಯಮ್ ಅಸ್ಮಾನ್ ಜ್ಞಾಪಯನ್ತಿ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಯುಷ್ಮನ್ಮಧ್ಯೇ ಽಸ್ಮಾಕಂ ಪ್ರವೇಶೋ ನಿಷ್ಫಲೋ ನ ಜಾತ ಇತಿ ಯೂಯಂ ಸ್ವಯಂ ಜಾನೀಥ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಅಪರಂ ಯುಷ್ಮಾಭಿ ರ್ಯಥಾಶ್ರಾವಿ ತಥಾ ಪೂರ್ವ್ವಂ ಫಿಲಿಪೀನಗರೇ ಕ್ಲಿಷ್ಟಾ ನಿನ್ದಿತಾಶ್ಚ ಸನ್ತೋಽಪಿ ವಯಮ್ ಈಶ್ವರಾದ್ ಉತ್ಸಾಹಂ ಲಬ್ಧ್ವಾ ಬಹುಯತ್ನೇನ ಯುಷ್ಮಾನ್ ಈಶ್ವರಸ್ಯ ಸುಸಂವಾದಮ್ ಅಬೋಧಯಾಮ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಯತೋಽಸ್ಮಾಕಮ್ ಆದೇಶೋ ಭ್ರಾನ್ತೇರಶುಚಿಭಾವಾದ್ ವೋತ್ಪನ್ನಃ ಪ್ರವಞ್ಚನಾಯುಕ್ತೋ ವಾ ನ ಭವತಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಕಿನ್ತ್ವೀಶ್ವರೇಣಾಸ್ಮಾನ್ ಪರೀಕ್ಷ್ಯ ವಿಶ್ವಸನೀಯಾನ್ ಮತ್ತ್ವಾ ಚ ಯದ್ವತ್ ಸುಸಂವಾದೋಽಸ್ಮಾಸು ಸಮಾರ್ಪ್ಯತ ತದ್ವದ್ ವಯಂ ಮಾನವೇಭ್ಯೋ ನ ರುರೋಚಿಷಮಾಣಾಃ ಕಿನ್ತ್ವಸ್ಮದನ್ತಃಕರಣಾನಾಂ ಪರೀಕ್ಷಕಾಯೇಶ್ವರಾಯ ರುರೋಚಿಷಮಾಣಾ ಭಾಷಾಮಹೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ವಯಂ ಕದಾಪಿ ಸ್ತುತಿವಾದಿನೋ ನಾಭವಾಮೇತಿ ಯೂಯಂ ಜಾನೀಥ ಕದಾಪಿ ಛಲವಸ್ತ್ರೇಣ ಲೋಭಂ ನಾಚ್ಛಾದಯಾಮೇತ್ಯಸ್ಮಿನ್ ಈಶ್ವರಃ ಸಾಕ್ಷೀ ವಿದ್ಯತೇ|</para>
  <para style="p">
    <verse number="6" style="v"/>ವಯಂ ಖ್ರೀಷ್ಟಸ್ಯ ಪ್ರೇರಿತಾ ಇವ ಗೌರವಾನ್ವಿತಾ ಭವಿತುಮ್ ಅಶಕ್ಷ್ಯಾಮ ಕಿನ್ತು ಯುಷ್ಮತ್ತಃ ಪರಸ್ಮಾದ್ ವಾ ಕಸ್ಮಾದಪಿ ಮಾನವಾದ್ ಗೌರವಂ ನ ಲಿಪ್ಸಮಾನಾ ಯುಷ್ಮನ್ಮಧ್ಯೇ ಮೃದುಭಾವಾ ಭೂತ್ವಾವರ್ತ್ತಾಮಹಿ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯಥಾ ಕಾಚಿನ್ಮಾತಾ ಸ್ವಕೀಯಶಿಶೂನ್ ಪಾಲಯತಿ ತಥಾ ವಯಮಪಿ ಯುಷ್ಮಾನ್ ಕಾಙ್ಕ್ಷಮಾಣಾ</para>
  <para style="p">
    <verse number="8" style="v"/>ಯುಷ್ಮಭ್ಯಂ ಕೇವಲಮ್ ಈಶ್ವರಸ್ಯ ಸುಸಂವಾದಂ ತನ್ನಹಿ ಕಿನ್ತು ಸ್ವಕೀಯಪ್ರಾಣಾನ್ ಅಪಿ ದಾತುಂ ಮನೋಭಿರಭ್ಯಲಷಾಮ, ಯತೋ ಯೂಯಮ್ ಅಸ್ಮಾಕಂ ಸ್ನೇಹಪಾತ್ರಾಣ್ಯಭವತ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಅಸ್ಮಾಕಂ ಶ್ರಮಃ ಕ್ಲೇेಶಶ್ಚ ಯುಷ್ಮಾಭಿಃ ಸ್ಮರ್ಯ್ಯತೇ ಯುಷ್ಮಾಕಂ ಕೋಽಪಿ ಯದ್ ಭಾರಗ್ರಸ್ತೋ ನ ಭವೇತ್ ತದರ್ಥಂ ವಯಂ ದಿವಾನಿಶಂ ಪರಿಶ್ರಾಮ್ಯನ್ತೋ ಯುಷ್ಮನ್ಮಧ್ಯ ಈಶ್ವರಸ್ಯ ಸುಸಂವಾದಮಘೋಷಯಾಮ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಅಪರಞ್ಚ ವಿಶ್ವಾಸಿನೋ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ವಯಂ ಕೀದೃಕ್ ಪವಿತ್ರತ್ವಯಥಾರ್ಥತ್ವನಿರ್ದೋಷತ್ವಾಚಾರಿಣೋಽಭವಾಮೇತ್ಯಸ್ಮಿನ್ ಈಶ್ವರೋ ಯೂಯಞ್ಚ ಸಾಕ್ಷಿಣ ಆಧ್ವೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅಪರಞ್ಚ ಯದ್ವತ್ ಪಿತಾ ಸ್ವಬಾಲಕಾನ್ ತದ್ವದ್ ವಯಂ ಯುಷ್ಮಾಕಮ್ ಏಕೈಕಂ ಜನಮ್ ಉಪದಿಷ್ಟವನ್ತಃ ಸಾನ್ತ್ವಿತವನ್ತಶ್ಚ,</para>
  <para style="p">
    <verse number="12" style="v"/>ಯ ಈಶ್ವರಃ ಸ್ವೀಯರಾಜ್ಯಾಯ ವಿಭವಾಯ ಚ ಯುಷ್ಮಾನ್ ಆಹೂತವಾನ್ ತದುಪಯುಕ್ತಾಚರಣಾಯ ಯುಷ್ಮಾನ್ ಪ್ರವರ್ತ್ತಿತವನ್ತಶ್ಚೇತಿ ಯೂಯಂ ಜಾನೀಥ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯಸ್ಮಿನ್ ಸಮಯೇ ಯೂಯಮ್ ಅಸ್ಮಾಕಂ ಮುಖಾದ್ ಈಶ್ವರೇಣ ಪ್ರತಿಶ್ರುತಂ ವಾಕ್ಯಮ್ ಅಲಭಧ್ವಂ ತಸ್ಮಿನ್ ಸಮಯೇ ತತ್ ಮಾನುಷಾಣಾಂ ವಾಕ್ಯಂ ನ ಮತ್ತ್ವೇಶ್ವರಸ್ಯ ವಾಕ್ಯಂ ಮತ್ತ್ವಾ ಗೃಹೀತವನ್ತ ಇತಿ ಕಾರಣಾದ್ ವಯಂ ನಿರನ್ತರಮ್ ಈಶ್ವರಂ ಧನ್ಯಂ ವದಾಮಃ, ಯತಸ್ತದ್ ಈಶ್ವರಸ್ಯ ವಾಕ್ಯಮ್ ಇತಿ ಸತ್ಯಂ ವಿಶ್ವಾಸಿನಾಂ ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ತಸ್ಯ ಗುಣಃ ಪ್ರಕಾಶತೇ ಚ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಖ್ರೀಷ್ಟಾಶ್ರಿತವತ್ಯ ಈಶ್ವರಸ್ಯ ಯಾಃ ಸಮಿತ್ಯೋ ಯಿಹೂದಾದೇಶೇ ಸನ್ತಿ ಯೂಯಂ ತಾಸಾಮ್ ಅನುಕಾರಿಣೋಽಭವತ, ತದ್ಭುಕ್ತಾ ಲೋಕಾಶ್ಚ ಯದ್ವದ್ ಯಿಹೂದಿಲೋಕೇಭ್ಯಸ್ತದ್ವದ್ ಯೂಯಮಪಿ ಸ್ವಜಾತೀಯಲೋಕೇಭ್ಯೋ ದುಃಖಮ್ ಅಲಭಧ್ವಂ|</para>
  <para style="p">
    <verse number="15" style="v"/>ತೇ ಯಿಹೂದೀಯಾಃ ಪ್ರಭುಂ ಯೀಶುಂ ಭವಿಷ್ಯದ್ವಾದಿನಶ್ಚ ಹತವನ್ತೋ ಽಸ್ಮಾನ್ ದೂರೀಕೃತವನ್ತಶ್ಚ, ತ ಈಶ್ವರಾಯ ನ ರೋಚನ್ತೇ ಸರ್ವ್ವೇಷಾಂ ಮಾನವಾನಾಂ ವಿಪಕ್ಷಾ ಭವನ್ತಿ ಚ;</para>
  <para style="p">
    <verse number="16" style="v"/>ಅಪರಂ ಭಿನ್ನಜಾತೀಯಲೋಕಾನಾಂ ಪರಿತ್ರಾಣಾರ್ಥಂ ತೇಷಾಂ ಮಧ್ಯೇ ಸುಸಂವಾದಘೋಷಣಾದ್ ಅಸ್ಮಾನ್ ಪ್ರತಿಷೇಧನ್ತಿ ಚೇತ್ಥಂ ಸ್ವೀಯಪಾಪಾನಾಂ ಪರಿಮಾಣಮ್ ಉತ್ತರೋತ್ತರಂ ಪೂರಯನ್ತಿ, ಕಿನ್ತು ತೇಷಾಮ್ ಅನ್ತಕಾರೀ ಕ್ರೋಧಸ್ತಾನ್ ಉಪಕ್ರಮತೇ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಹೇ ಭ್ರಾತರಃ ಮನಸಾ ನಹಿ ಕಿನ್ತು ವದನೇನ ಕಿಯತ್ಕಾಲಂ ಯುಷ್ಮತ್ತೋ ಽಸ್ಮಾಕಂ ವಿಚ್ಛೇದೇ ಜಾತೇ ವಯಂ ಯುಷ್ಮಾಕಂ ಮುಖಾನಿ ದ್ರಷ್ಟುಮ್ ಅತ್ಯಾಕಾಙ್ಕ್ಷಯಾ ಬಹು ಯತಿತವನ್ತಃ|</para>
  <para style="p">
    <verse number="18" style="v"/>ದ್ವಿರೇಕಕೃತ್ವೋ ವಾ ಯುಷ್ಮತ್ಸಮೀಪಗಮನಾಯಾಸ್ಮಾಕಂ ವಿಶೇಷತಃ ಪೌಲಸ್ಯ ಮಮಾಭಿಲಾಷೋಽಭವತ್ ಕಿನ್ತು ಶಯತಾನೋ ಽಸ್ಮಾನ್ ನಿವಾರಿತವಾನ್|</para>
  <para style="p">
    <verse number="19" style="v"/>ಯತೋಽಸ್ಮಾಕಂ ಕಾ ಪ್ರತ್ಯಾಶಾ ಕೋ ವಾನನ್ದಃ ಕಿಂ ವಾ ಶ್ಲಾಘ್ಯಕಿರೀಟಂ? ಅಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯಾಗಮನಕಾಲೇ ತತ್ಸಮ್ಮುಖಸ್ಥಾ ಯೂಯಂ ಕಿಂ ತನ್ನ ಭವಿಷ್ಯಥ?</para>
  <para style="p">
    <verse number="20" style="v"/>ಯೂಯಮ್ ಏವಾಸ್ಮಾಕಂ ಗೌರವಾನನ್ದಸ್ವರೂಪಾ ಭವಥ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಅತೋಽಹಂ ಯದಾ ಸನ್ದೇಹಂ ಪುನಃ ಸೋಢುಂ ನಾಶಕ್ನುವಂ ತದಾನೀಮ್ ಆಥೀನೀನಗರ ಏಕಾಕೀ ಸ್ಥಾತುಂ ನಿಶ್ಚಿತ್ಯ</para>
  <para style="p">
    <verse number="2" style="v"/>ಸ್ವಭ್ರಾತರಂ ಖ್ರೀಷ್ಟಸ್ಯ ಸುಸಂವಾದೇ ಸಹಕಾರಿಣಞ್ಚೇಶ್ವರಸ್ಯ ಪರಿಚಾರಕಂ ತೀಮಥಿಯಂ ಯುಷ್ಮತ್ಸಮೀಪಮ್ ಅಪ್ರೇಷಯಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ವರ್ತ್ತಮಾನೈಃ ಕ್ಲೇಶೈಃ ಕಸ್ಯಾಪಿ ಚಾಞ್ಚಲ್ಯಂ ಯಥಾ ನ ಜಾಯತೇ ತಥಾ ತೇ ತ್ವಯಾ ಸ್ಥಿರೀಕ್ರಿಯನ್ತಾಂ ಸ್ವಕೀಯಧರ್ಮ್ಮಮಧಿ ಸಮಾಶ್ವಾಸ್ಯನ್ತಾಞ್ಚೇತಿ ತಮ್ ಆದಿಶಂ|</para>
  <para style="p">
    <verse number="4" style="v"/>ವಯಮೇತಾದೃಶೇ ಕ್ಲೇेಶೇ ನಿಯುಕ್ತಾ ಆಸ್ಮಹ ಇತಿ ಯೂಯಂ ಸ್ವಯಂ ಜಾನೀಥ, ಯತೋಽಸ್ಮಾಕಂ ದುರ್ಗತಿ ರ್ಭವಿಷ್ಯತೀತಿ ವಯಂ ಯುಷ್ಮಾಕಂ ಸಮೀಪೇ ಸ್ಥಿತಿಕಾಲೇಽಪಿ ಯುಷ್ಮಾನ್ ಅಬೋಧಯಾಮ, ತಾದೃಶಮೇವ ಚಾಭವತ್ ತದಪಿ ಜಾನೀಥ|</para>
  <para style="p">
    <verse number="5" style="v"/>ತಸ್ಮಾತ್ ಪರೀಕ್ಷಕೇಣ ಯುಷ್ಮಾಸು ಪರೀಕ್ಷಿತೇಷ್ವಸ್ಮಾಕಂ ಪರಿಶ್ರಮೋ ವಿಫಲೋ ಭವಿಷ್ಯತೀತಿ ಭಯಂ ಸೋಢುಂ ಯದಾಹಂ ನಾಶಕ್ನುವಂ ತದಾ ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸಸ್ಯ ತತ್ತ್ವಾವಧಾರಣಾಯ ತಮ್ ಅಪ್ರೇಷಯಂ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಕಿನ್ತ್ವಧುನಾ ತೀಮಥಿಯೋ ಯುಷ್ಮತ್ಸಮೀಪಾದ್ ಅಸ್ಮತ್ಸನ್ನಿಧಿಮ್ ಆಗತ್ಯ ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸಪ್ರೇಮಣೀ ಅಧ್ಯಸ್ಮಾನ್ ಸುವಾರ್ತ್ತಾಂ ಜ್ಞಾಪಿತವಾನ್ ವಯಞ್ಚ ಯಥಾ ಯುಷ್ಮಾನ್ ಸ್ಮರಾಮಸ್ತಥಾ ಯೂಯಮಪ್ಯಸ್ಮಾನ್ ಸರ್ವ್ವದಾ ಪ್ರಣಯೇನ ಸ್ಮರಥ ದ್ರಷ್ಟುಮ್ ಆಕಾಙ್ಕ್ಷಧ್ವೇ ಚೇತಿ ಕಥಿತವಾನ್|</para>
  <para style="p">
    <verse number="7" style="v"/>ಹೇ ಭ್ರಾತರಃ, ವಾರ್ತ್ತಾಮಿಮಾಂ ಪ್ರಾಪ್ಯ ಯುಷ್ಮಾನಧಿ ವಿಶೇಷತೋ ಯುಷ್ಮಾಕಂ ಕ್ಲೇಶದುಃಖಾನ್ಯಧಿ ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸಾದ್ ಅಸ್ಮಾಕಂ ಸಾನ್ತ್ವನಾಜಾಯತ;</para>
  <para style="p">
    <verse number="8" style="v"/>ಯತೋ ಯೂಯಂ ಯದಿ ಪ್ರಭಾವವತಿಷ್ಠಥ ತರ್ಹ್ಯನೇನ ವಯಮ್ ಅಧುನಾ ಜೀವಾಮಃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ವಯಞ್ಚಾಸ್ಮದೀಯೇಶ್ವರಸ್ಯ ಸಾಕ್ಷಾದ್ ಯುಷ್ಮತ್ತೋ ಜಾತೇನ ಯೇನಾನನ್ದೇನ ಪ್ರಫುಲ್ಲಾ ಭವಾಮಸ್ತಸ್ಯ ಕೃತ್ಸ್ನಸ್ಯಾನನ್ದಸ್ಯ ಯೋಗ್ಯರೂಪೇಣೇಶ್ವರಂ ಧನ್ಯಂ ವದಿತುಂ ಕಥಂ ಶಕ್ಷ್ಯಾಮಃ?</para>
  <para style="p">
    <verse number="10" style="v"/>ವಯಂ ಯೇನ ಯುಷ್ಮಾಕಂ ವದನಾನಿ ದ್ರಷ್ಟುಂ ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸೇ ಯದ್ ಅಸಿದ್ಧಂ ವಿದ್ಯತೇ ತತ್ ಸಿದ್ಧೀಕರ್ತ್ತುಞ್ಚ ಶಕ್ಷ್ಯಾಮಸ್ತಾದೃಶಂ ವರಂ ದಿವಾನಿಶಂ ಪ್ರಾರ್ಥಯಾಮಹೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅಸ್ಮಾಕಂ ತಾತೇನೇಶ್ವರೇಣ ಪ್ರಭುನಾ ಯೀಶುಖ್ರೀಷ್ಟೇನ ಚ ಯುಷ್ಮತ್ಸಮೀಪಗಮನಾಯಾಸ್ಮಾಕಂ ಪನ್ಥಾ ಸುಗಮಃ ಕ್ರಿಯತಾಂ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಪರಸ್ಪರಂ ಸರ್ವ್ವಾಂಶ್ಚ ಪ್ರತಿ ಯುಷ್ಮಾಕಂ ಪ್ರೇಮ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಚಾಸ್ಮಾಕಂ ಪ್ರೇಮ ಪ್ರಭುನಾ ವರ್ದ್ಧ್ಯತಾಂ ಬಹುಫಲಂ ಕ್ರಿಯತಾಞ್ಚ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅಪರಮಸ್ಮಾಕಂ ಪ್ರಭು ರ್ಯೀಶುಖ್ರೀಷ್ಟಃ ಸ್ವಕೀಯೈಃ ಸರ್ವ್ವೈಃ ಪವಿತ್ರಲೋಕೈಃ ಸಾರ್ದ್ಧಂ ಯದಾಗಮಿಷ್ಯತಿ ತದಾ ಯೂಯಂ ಯಥಾಸ್ಮಾಕಂ ತಾತಸ್ಯೇಶ್ವರಸ್ಯ ಸಮ್ಮುಖೇ ಪವಿತ್ರತಯಾ ನಿರ್ದೋಷಾ ಭವಿಷ್ಯಥ ತಥಾ ಯುಷ್ಮಾಕಂ ಮನಾಂಸಿ ಸ್ಥಿರೀಕ್ರಿಯನ್ತಾಂ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಯುಷ್ಮಾಭಿಃ ಕೀದೃಗ್ ಆಚರಿತವ್ಯಂ ಈಶ್ವರಾಯ ರೋಚಿತವ್ಯಞ್ಚ ತದಧ್ಯಸ್ಮತ್ತೋ ಯಾ ಶಿಕ್ಷಾ ಲಬ್ಧಾ ತದನುಸಾರಾತ್ ಪುನರತಿಶಯಂ ಯತ್ನಃ ಕ್ರಿಯತಾಮಿತಿ ವಯಂ ಪ್ರಭುಯೀಶುನಾ ಯುಷ್ಮಾನ್ ವಿನೀಯಾದಿಶಾಮಃ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯತೋ ವಯಂ ಪ್ರಭುಯೀಶುನಾ ಕೀದೃಶೀರಾಜ್ಞಾ ಯುಷ್ಮಾಸು ಸಮರ್ಪಿತವನ್ತಸ್ತದ್ ಯೂಯಂ ಜಾನೀಥ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಈಶ್ವರಸ್ಯಾಯಮ್ ಅಭಿಲಾಷೋ ಯದ್ ಯುಷ್ಮಾಕಂ ಪವಿತ್ರತಾ ಭವೇತ್, ಯೂಯಂ ವ್ಯಭಿಚಾರಾದ್ ದೂರೇ ತಿಷ್ಠತ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಯುಷ್ಮಾಕಮ್ ಏಕೈಕೋ ಜನಃ ಸ್ವಕೀಯಂ ಪ್ರಾಣಾಧಾರಂ ಪವಿತ್ರಂ ಮಾನ್ಯಞ್ಚ ರಕ್ಷತು,</para>
  <para style="p">
    <verse number="5" style="v"/>ಯೇ ಚ ಭಿನ್ನಜಾತೀಯಾ ಲೋಕಾ ಈಶ್ವರಂ ನ ಜಾನನ್ತಿ ತ ಇವ ತತ್ ಕಾಮಾಭಿಲಾಷಸ್ಯಾಧೀನಂ ನ ಕರೋತು|</para>
  <para style="p">
    <verse number="6" style="v"/>ಏತಸ್ಮಿನ್ ವಿಷಯೇ ಕೋಽಪ್ಯತ್ಯಾಚಾರೀ ಭೂತ್ವಾ ಸ್ವಭ್ರಾತರಂ ನ ವಞ್ಚಯತು ಯತೋಽಸ್ಮಾಭಿಃ ಪೂರ್ವ್ವಂ ಯಥೋಕ್ತಂ ಪ್ರಮಾಣೀಕೃತಞ್ಚ ತಥೈವ ಪ್ರಭುರೇತಾದೃಶಾನಾಂ ಕರ್ಮ್ಮಣಾಂ ಸಮುಚಿತಂ ಫಲಂ ದಾಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯಸ್ಮಾದ್ ಈಶ್ವರೋಽಸ್ಮಾನ್ ಅಶುಚಿತಾಯೈ ನಾಹೂತವಾನ್ ಕಿನ್ತು ಪವಿತ್ರತ್ವಾಯೈವಾಹೂತವಾನ್|</para>
  <para style="p">
    <verse number="8" style="v"/>ಅತೋ ಹೇತೋ ರ್ಯಃ ಕಶ್ಚಿದ್ ವಾಕ್ಯಮೇತನ್ನ ಗೃಹ್ಲಾತಿ ಸ ಮನುಷ್ಯಮ್ ಅವಜಾನಾತೀತಿ ನಹಿ ಯೇನ ಸ್ವಕೀಯಾತ್ಮಾ ಯುಷ್ಮದನ್ತರೇ ಸಮರ್ಪಿತಸ್ತಮ್ ಈಶ್ವರಮ್ ಏವಾವಜಾನಾತಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಭ್ರಾತೃಷು ಪ್ರೇಮಕರಣಮಧಿ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಮಮ ಲಿಖನಂ ನಿಷ್ಪ್ರಯೋಜನಂ ಯತೋ ಯೂಯಂ ಪರಸ್ಪರಂ ಪ್ರೇಮಕರಣಾಯೇಶ್ವರಶಿಕ್ಷಿತಾ ಲೋಕಾ ಆಧ್ವೇ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಕೃತ್ಸ್ನೇ ಮಾಕಿದನಿಯಾದೇಶೇ ಚ ಯಾವನ್ತೋ ಭ್ರಾತರಃ ಸನ್ತಿ ತಾನ್ ಸರ್ವ್ವಾನ್ ಪ್ರತಿ ಯುಷ್ಮಾಭಿಸ್ತತ್ ಪ್ರೇಮ ಪ್ರಕಾಶ್ಯತೇ ತಥಾಪಿ ಹೇ ಭ್ರಾತರಃ, ವಯಂ ಯುಷ್ಮಾನ್ ವಿನಯಾಮಹೇ ಯೂಯಂ ಪುನ ರ್ಬಹುತರಂ ಪ್ರೇಮ ಪ್ರಕಾಶಯತ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅಪರಂ ಯೇ ಬಹಿಃಸ್ಥಿತಾಸ್ತೇಷಾಂ ದೃಷ್ಟಿಗೋಚರೇ ಯುಷ್ಮಾಕಮ್ ಆಚರಣಂ ಯತ್ ಮನೋರಮ್ಯಂ ಭವೇತ್ ಕಸ್ಯಾಪಿ ವಸ್ತುನಶ್ಚಾಭಾವೋ ಯುಷ್ಮಾಕಂ ಯನ್ನ ಭವೇತ್,</para>
  <para style="p">
    <verse number="12" style="v"/>ಏತದರ್ಥಂ ಯೂಯಮ್ ಅಸ್ಮತ್ತೋ ಯಾದೃಶಮ್ ಆದೇಶಂ ಪ್ರಾಪ್ತವನ್ತಸ್ತಾದೃಶಂ ನಿರ್ವಿರೋಧಾಚಾರಂ ಕರ್ತ್ತುಂ ಸ್ವಸ್ವಕರ್ಮ್ಮಣಿ ಮನಾಂಮಿ ನಿಧಾತುಂ ನಿಜಕರೈಶ್ಚ ಕಾರ್ಯ್ಯಂ ಸಾಧಯಿತುಂ ಯತಧ್ವಂ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಹೇ ಭ್ರಾತರಃ ನಿರಾಶಾ ಅನ್ಯೇ ಲೋಕಾ ಇವ ಯೂಯಂ ಯನ್ನ ಶೋಚೇಧ್ವಂ ತದರ್ಥಂ ಮಹಾನಿದ್ರಾಗತಾನ್ ಲೋಕಾನಧಿ ಯುಷ್ಮಾಕಮ್ ಅಜ್ಞಾನತಾ ಮಯಾ ನಾಭಿಲಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯೀಶು ರ್ಮೃತವಾನ್ ಪುನರುಥಿತವಾಂಶ್ಚೇತಿ ಯದಿ ವಯಂ ವಿಶ್ವಾಸಮಸ್ತರ್ಹಿ ಯೀಶುಮ್ ಆಶ್ರಿತಾನ್ ಮಹಾನಿದ್ರಾಪ್ರಾಪ್ತಾನ್ ಲೋಕಾನಪೀಶ್ವರೋಽವಶ್ಯಂ ತೇನ ಸಾರ್ದ್ಧಮ್ ಆನೇಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಯತೋಽಹಂ ಪ್ರಭೋ ರ್ವಾಕ್ಯೇನ ಯುಷ್ಮಾನ್ ಇದಂ ಜ್ಞಾಪಯಾಮಿ; ಅಸ್ಮಾಕಂ ಮಧ್ಯೇ ಯೇ ಜನಾಃ ಪ್ರಭೋರಾಗಮನಂ ಯಾವತ್ ಜೀವನ್ತೋಽವಶೇಕ್ಷ್ಯನ್ತೇ ತೇ ಮಹಾನಿದ್ರಿತಾನಾಮ್ ಅಗ್ರಗಾಮಿನೋನ ನ ಭವಿಷ್ಯನ್ತಿ;</para>
  <para style="p">
    <verse number="16" style="v"/>ಯತಃ ಪ್ರಭುಃ ಸಿಂಹನಾದೇನ ಪ್ರಧಾನಸ್ವರ್ಗದೂತಸ್ಯೋಚ್ಚೈಃ ಶಬ್ದೇನೇಶ್ವರೀಯತೂರೀವಾದ್ಯೇನ ಚ ಸ್ವಯಂ ಸ್ವರ್ಗಾದ್ ಅವರೋಕ್ಷ್ಯತಿ ತೇನ ಖ್ರೀಷ್ಟಾಶ್ರಿತಾ ಮೃತಲೋಕಾಃ ಪ್ರಥಮಮ್ ಉತ್ಥಾಸ್ಯಾನ್ತಿ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಅಪರಮ್ ಅಸ್ಮಾಕಂ ಮಧ್ಯೇ ಯೇ ಜೀವನ್ತೋಽವಶೇಕ್ಷ್ಯನ್ತೇ ತ ಆಕಾಶೇ ಪ್ರಭೋಃ ಸಾಕ್ಷಾತ್ಕರಣಾರ್ಥಂ ತೈಃ ಸಾರ್ದ್ಧಂ ಮೇಘವಾಹನೇನ ಹರಿಷ್ಯನ್ತೇ; ಇತ್ಥಞ್ಚ ವಯಂ ಸರ್ವ್ವದಾ ಪ್ರಭುನಾ ಸಾರ್ದ್ಧಂ ಸ್ಥಾಸ್ಯಾಮಃ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಅತೋ ಯೂಯಮ್ ಏತಾಭಿಃ ಕಥಾಭಿಃ ಪರಸ್ಪರಂ ಸಾನ್ತ್ವಯತ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಕಾಲಾನ್ ಸಮಯಾಂಶ್ಚಾಧಿ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಮಮ ಲಿಖನಂ ನಿಷ್ಪ್ರಯೋಜನಂ,</para>
  <para style="p">
    <verse number="2" style="v"/>ಯತೋ ರಾತ್ರೌ ಯಾದೃಕ್ ತಸ್ಕರಸ್ತಾದೃಕ್ ಪ್ರಭೋ ರ್ದಿನಮ್ ಉಪಸ್ಥಾಸ್ಯತೀತಿ ಯೂಯಂ ಸ್ವಯಮೇವ ಸಮ್ಯಗ್ ಜಾನೀಥ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಶಾನ್ತಿ ರ್ನಿರ್ವ್ವಿನ್ಘತ್ವಞ್ಚ ವಿದ್ಯತ ಇತಿ ಯದಾ ಮಾನವಾ ವದಿಷ್ಯನ್ತಿ ತದಾ ಪ್ರಸವವೇದನಾ ಯದ್ವದ್ ಗರ್ಬ್ಭಿನೀಮ್ ಉಪತಿಷ್ಠತಿ ತದ್ವದ್ ಅಕಸ್ಮಾದ್ ವಿನಾಶಸ್ತಾನ್ ಉಪಸ್ಥಾಸ್ಯತಿ ತೈರುದ್ಧಾರೋ ನ ಲಪ್ಸ್ಯತೇ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಕಿನ್ತು ಹೇ ಭ್ರಾತರಃ, ಯೂಯಮ್ ಅನ್ಧಕಾರೇಣಾವೃತಾ ನ ಭವಥ ತಸ್ಮಾತ್ ತದ್ದಿನಂ ತಸ್ಕರ ಇವ ಯುಷ್ಮಾನ್ ನ ಪ್ರಾಪ್ಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಸರ್ವ್ವೇ ಯೂಯಂ ದೀಪ್ತೇಃ ಸನ್ತಾನಾ ದಿವಾಯಾಶ್ಚ ಸನ್ತಾನಾ ಭವಥ ವಯಂ ನಿಶಾವಂಶಾಸ್ತಿಮಿರವಂಶಾ ವಾ ನ ಭವಾಮಃ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅತೋ ಽಪರೇ ಯಥಾ ನಿದ್ರಾಗತಾಃ ಸನ್ತಿ ತದ್ವದ್ ಅಸ್ಮಾಭಿ ರ್ನ ಭವಿತವ್ಯಂ ಕಿನ್ತು ಜಾಗರಿತವ್ಯಂ ಸಚೇತನೈಶ್ಚ ಭವಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯೇ ನಿದ್ರಾನ್ತಿ ತೇ ನಿಶಾಯಾಮೇವ ನಿದ್ರಾನ್ತಿ ತೇ ಚ ಮತ್ತಾ ಭವನ್ತಿ ತೇ ರಜನ್ಯಾಮೇವ ಮತ್ತಾ ಭವನ್ತಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಕಿನ್ತು ವಯಂ ದಿವಸಸ್ಯ ವಂಶಾ ಭವಾಮಃ; ಅತೋ ಽಸ್ಮಾಭಿ ರ್ವಕ್ಷಸಿ ಪ್ರತ್ಯಯಪ್ರೇಮರೂಪಂ ಕವಚಂ ಶಿರಸಿ ಚ ಪರಿತ್ರಾಣಾಶಾರೂಪಂ ಶಿರಸ್ತ್ರಂ ಪರಿಧಾಯ ಸಚೇತನೈ ರ್ಭವಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಯತ ಈಶ್ವರೋಽಸ್ಮಾನ್ ಕ್ರೋಧೇ ನ ನಿಯುಜ್ಯಾಸ್ಮಾಕಂ ಪ್ರಭುನಾ ಯೀಶುಖ್ರೀಷ್ಟೇನ ಪರಿತ್ರಾಣಸ್ಯಾಧಿಕಾರೇ ನಿಯುुಕ್ತವಾನ್,</para>
  <para style="p">
    <verse number="10" style="v"/>ಜಾಗ್ರತೋ ನಿದ್ರಾಗತಾ ವಾ ವಯಂ ಯತ್ ತೇನ ಪ್ರಭುನಾ ಸಹ ಜೀವಾಮಸ್ತದರ್ಥಂ ಸೋಽಸ್ಮಾಕಂ ಕೃತೇ ಪ್ರಾಣಾನ್ ತ್ಯಕ್ತವಾನ್|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅತಏವ ಯೂಯಂ ಯದ್ವತ್ ಕುರುಥ ತದ್ವತ್ ಪರಸ್ಪರಂ ಸಾನ್ತ್ವಯತ ಸುಸ್ಥಿರೀಕುರುಧ್ವಞ್ಚ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಯುಷ್ಮಾಕಂ ಮಧ್ಯೇ ಯೇ ಜನಾಃ ಪರಿಶ್ರಮಂ ಕುರ್ವ್ವನ್ತಿ ಪ್ರಭೋ ರ್ನಾಮ್ನಾ ಯುಷ್ಮಾನ್ ಅಧಿತಿಷ್ಠನ್ತ್ಯುಪದಿಶನ್ತಿ ಚ ತಾನ್ ಯೂಯಂ ಸಮ್ಮನ್ಯಧ್ವಂ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಸ್ವಕರ್ಮ್ಮಹೇತುನಾ ಚ ಪ್ರೇಮ್ನಾ ತಾನ್ ಅತೀವಾದೃಯಧ್ವಮಿತಿ ಮಮ ಪ್ರಾರ್ಥನಾ, ಯೂಯಂ ಪರಸ್ಪರಂ ನಿರ್ವ್ವಿರೋಧಾ ಭವತ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಯುಷ್ಮಾನ್ ವಿನಯಾಮಹೇ ಯೂಯಮ್ ಅವಿಹಿತಾಚಾರಿಣೋ ಲೋಕಾನ್ ಭರ್ತ್ಸಯಧ್ವಂ, ಕ್ಷುದ್ರಮನಸಃ ಸಾನ್ತ್ವಯತ, ದುರ್ಬ್ಬಲಾನ್ ಉಪಕುರುತ, ಸರ್ವ್ವಾನ್ ಪ್ರತಿ ಸಹಿಷ್ಣವೋ ಭವತ ಚ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅಪರಂ ಕಮಪಿ ಪ್ರತ್ಯನಿಷ್ಟಸ್ಯ ಫಲಮ್ ಅನಿಷ್ಟಂ ಕೇನಾಪಿ ಯನ್ನ ಕ್ರಿಯೇತ ತದರ್ಥಂ ಸಾವಧಾನಾ ಭವತ, ಕಿನ್ತು ಪರಸ್ಪರಂ ಸರ್ವ್ವಾನ್ ಮಾನವಾಂಶ್ಚ ಪ್ರತಿ ನಿತ್ಯಂ ಹಿತಾಚಾರಿಣೋ ಭವತ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಸರ್ವ್ವದಾನನ್ದತ|</para>
  <para style="p">
    <verse number="17" style="v"/>ನಿರನ್ತರಂ ಪ್ರಾರ್ಥನಾಂ ಕುರುಧ್ವಂ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಸರ್ವ್ವವಿಷಯೇ ಕೃತಜ್ಞತಾಂ ಸ್ವೀಕುರುಧ್ವಂ ಯತ ಏತದೇವ ಖ್ರೀಷ್ಟಯೀಶುನಾ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಪ್ರಕಾಶಿತಮ್ ಈಶ್ವರಾಭಿಮತಂ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಪವಿತ್ರಮ್ ಆತ್ಮಾನಂ ನ ನಿರ್ವ್ವಾಪಯತ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಈಶ್ವರೀಯಾದೇಶಂ ನಾವಜಾನೀತ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಸರ್ವ್ವಾಣಿ ಪರೀಕ್ಷ್ಯ ಯದ್ ಭದ್ರಂ ತದೇವ ಧಾರಯತ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಯತ್ ಕಿಮಪಿ ಪಾಪರೂಪಂ ಭವತಿ ತಸ್ಮಾದ್ ದೂರಂ ತಿಷ್ಠತ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಶಾನ್ತಿದಾಯಕ ಈಶ್ವರಃ ಸ್ವಯಂ ಯುಷ್ಮಾನ್ ಸಮ್ಪೂರ್ಣತ್ವೇನ ಪವಿತ್ರಾನ್ ಕರೋತು, ಅಪರಮ್ ಅಸ್ಮತ್ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯಾಗಮನಂ ಯಾವದ್ ಯುಷ್ಮಾಕಮ್ ಆತ್ಮಾನಃ ಪ್ರಾಣಾಃ ಶರೀರಾಣಿ ಚ ನಿಖಿಲಾನಿ ನಿರ್ದ್ದೋಷತ್ವೇನ ರಕ್ಷ್ಯನ್ತಾಂ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಯೋ ಯುಷ್ಮಾನ್ ಆಹ್ವಯತಿ ಸ ವಿಶ್ವಸನೀಯೋಽತಃ ಸ ತತ್ ಸಾಧಯಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಅಸ್ಮಾಕಂ ಕೃತೇ ಪ್ರಾರ್ಥನಾಂ ಕುರುಧ್ವಂ|</para>
  <para style="p">
    <verse number="26" style="v"/>ಪವಿತ್ರಚುಮ್ಬನೇನ ಸರ್ವ್ವಾನ್ ಭ್ರಾತೃನ್ ಪ್ರತಿ ಸತ್ಕುರುಧ್ವಂ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಪತ್ರಮಿದಂ ಸರ್ವ್ವೇಷಾಂ ಪವಿತ್ರಾಣಾಂ ಭ್ರಾತೃಣಾಂ ಶ್ರುತಿಗೋಚರೇ ಯುಷ್ಮಾಭಿಃ ಪಠ್ಯತಾಮಿತಿ ಪ್ರಭೋ ರ್ನಾಮ್ನಾ ಯುಷ್ಮಾನ್ ಶಪಯಾಮಿ|</para>
  <para style="p">
    <verse number="28" style="v"/>ಅಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯಾನುಗ್ರತೇ ಯುಷ್ಮಾಸು ಭೂಯಾತ್| ಆಮೇನ್|</para>
</usx>
