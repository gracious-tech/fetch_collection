<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="PHP" style="id">Sanskrit Bible (NT) in Kannada Script (ಸತ್ಯವೇದಃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Philippians</para>
  <para style="toc1">ಫಿಲಿಪಿನಃ ಪತ್ರಂ</para>
  <para style="toc2">ಫಿಲಿಪಿನಃ</para>
  <para style="toc3">ಫಿಲಿಪಿನಃ</para>
  <para style="mt1">ಫಿಲಿಪಿನಃ ಪತ್ರಂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಪೌಲತೀಮಥಿನಾಮಾನೌ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ದಾಸೌ ಫಿಲಿಪಿನಗರಸ್ಥಾನ್ ಖ್ರೀಷ್ಟಯೀಶೋಃ ಸರ್ವ್ವಾನ್ ಪವಿತ್ರಲೋಕಾನ್ ಸಮಿತೇರಧ್ಯಕ್ಷಾನ್ ಪರಿಚಾರಕಾಂಶ್ಚ ಪ್ರತಿ ಪತ್ರಂ ಲಿಖತಃ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಅಸ್ಮಾಕಂ ತಾತ ಈಶ್ವರಃ ಪ್ರಭು ರ್ಯೀಶುಖ್ರೀಷ್ಟಶ್ಚ ಯುಷ್ಮಭ್ಯಂ ಪ್ರಸಾದಸ್ಯ ಶಾನ್ತೇಶ್ಚ ಭೋಗಂ ದೇಯಾಸ್ತಾಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅಹಂ ನಿರನ್ತರಂ ನಿಜಸರ್ವ್ವಪ್ರಾರ್ಥನಾಸು ಯುಷ್ಮಾಕಂ ಸರ್ವ್ವೇಷಾಂ ಕೃತೇ ಸಾನನ್ದಂ ಪ್ರಾರ್ಥನಾಂ ಕುರ್ವ್ವನ್</para>
  <para style="p">
    <verse number="4" style="v"/>ಯತಿ ವಾರಾನ್ ಯುಷ್ಮಾಕಂ ಸ್ಮರಾಮಿ ತತಿ ವಾರಾನ್ ಆ ಪ್ರಥಮಾದ್ ಅದ್ಯ ಯಾವದ್</para>
  <para style="p">
    <verse number="5" style="v"/>ಯುಷ್ಮಾಕಂ ಸುಸಂವಾದಭಾಗಿತ್ವಕಾರಣಾದ್ ಈಶ್ವರಂ ಧನ್ಯಂ ವದಾಮಿ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಯುಷ್ಮನ್ಮಧ್ಯೇ ಯೇನೋತ್ತಮಂ ಕರ್ಮ್ಮ ಕರ್ತ್ತುಮ್ ಆರಮ್ಭಿ ತೇನೈವ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ದಿನಂ ಯಾವತ್ ತತ್ ಸಾಧಯಿಷ್ಯತ ಇತ್ಯಸ್ಮಿನ್ ದೃಢವಿಶ್ವಾಸೋ ಮಮಾಸ್ತೇ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯುಷ್ಮಾನ್ ಸರ್ವ್ವಾನ್ ಅಧಿ ಮಮ ತಾದೃಶೋ ಭಾವೋ ಯಥಾರ್ಥೋ ಯತೋಽಹಂ ಕಾರಾವಸ್ಥಾಯಾಂ ಪ್ರತ್ಯುತ್ತರಕರಣೇ ಸುಸಂವಾದಸ್ಯ ಪ್ರಾಮಾಣ್ಯಕರಣೇ ಚ ಯುಷ್ಮಾನ್ ಸರ್ವ್ವಾನ್ ಮಯಾ ಸಾರ್ದ್ಧಮ್ ಏಕಾನುಗ್ರಹಸ್ಯ ಭಾಗಿನೋ ಮತ್ವಾ ಸ್ವಹೃದಯೇ ಧಾರಯಾಮಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಅಪರಮ್ ಅಹಂ ಖ್ರೀಷ್ಟಯೀಶೋಃ ಸ್ನೇಹವತ್ ಸ್ನೇಹೇನ ಯುಷ್ಮಾನ್ ಕೀದೃಶಂ ಕಾಙ್ಕ್ಷಾಮಿ ತದಧೀಶ್ವರೋ ಮಮ ಸಾಕ್ಷೀ ವಿದ್ಯತೇ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಮಯಾ ಯತ್ ಪ್ರಾರ್ಥ್ಯತೇ ತದ್ ಇದಂ ಯುಷ್ಮಾಕಂ ಪ್ರೇಮ ನಿತ್ಯಂ ವೃದ್ಧಿಂ ಗತ್ವಾ</para>
  <para style="p">
    <verse number="10" style="v"/>ಜ್ಞಾನಸ್ಯ ವಿಶಿಷ್ಟಾನಾಂ ಪರೀಕ್ಷಿಕಾಯಾಶ್ಚ ಸರ್ವ್ವವಿಧಬುದ್ಧೇ ರ್ಬಾಹುಲ್ಯಂ ಫಲತು,</para>
  <para style="p">
    <verse number="11" style="v"/>ಖ್ರೀಷ್ಟಸ್ಯ ದಿನಂ ಯಾವದ್ ಯುಷ್ಮಾಕಂ ಸಾರಲ್ಯಂ ನಿರ್ವಿಘ್ನತ್ವಞ್ಚ ಭವತು, ಈಶ್ವರಸ್ಯ ಗೌರವಾಯ ಪ್ರಶಂಸಾಯೈ ಚ ಯೀಶುನಾ ಖ್ರೀಷ್ಟೇನ ಪುಣ್ಯಫಲಾನಾಂ ಪೂರ್ಣತಾ ಯುಷ್ಮಭ್ಯಂ ದೀಯತಾಮ್ ಇತಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಮಾಂ ಪ್ರತಿ ಯದ್ ಯದ್ ಘಟಿತಂ ತೇನ ಸುಸಂವಾದಪ್ರಚಾರಸ್ಯ ಬಾಧಾ ನಹಿ ಕಿನ್ತು ವೃದ್ಧಿರೇವ ಜಾತಾ ತದ್ ಯುಷ್ಮಾನ್ ಜ್ಞಾಪಯಿತುಂ ಕಾಮಯೇಽಹಂ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅಪರಮ್ ಅಹಂ ಖ್ರೀಷ್ಟಸ್ಯ ಕೃತೇ ಬದ್ಧೋಽಸ್ಮೀತಿ ರಾಜಪುರ್ಯ್ಯಾಮ್ ಅನ್ಯಸ್ಥಾನೇಷು ಚ ಸರ್ವ್ವೇಷಾಂ ನಿಕಟೇ ಸುಸ್ಪಷ್ಟಮ್ ಅಭವತ್,</para>
  <para style="p">
    <verse number="14" style="v"/>ಪ್ರಭುಸಮ್ಬನ್ಧೀಯಾ ಅನೇಕೇ ಭ್ರಾತರಶ್ಚ ಮಮ ಬನ್ಧನಾದ್ ಆಶ್ವಾಸಂ ಪ್ರಾಪ್ಯ ವರ್ದ್ಧಮಾನೇನೋತ್ಸಾಹೇನ ನಿಃಕ್ಷೋಭಂ ಕಥಾಂ ಪ್ರಚಾರಯನ್ತಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಕೇಚಿದ್ ದ್ವೇಷಾದ್ ವಿರೋಧಾಚ್ಚಾಪರೇ ಕೇಚಿಚ್ಚ ಸದ್ಭಾವಾತ್ ಖ್ರೀಷ್ಟಂ ಘೋಷಯನ್ತಿ;</para>
  <para style="p">
    <verse number="16" style="v"/>ಯೇ ವಿರೋಧಾತ್ ಖ್ರೀಷ್ಟಂ ಘೋಷಯನ್ತಿ ತೇ ಪವಿತ್ರಭಾವಾತ್ ತನ್ನ ಕುರ್ವ್ವನ್ತೋ ಮಮ ಬನ್ಧನಾನಿ ಬಹುತರಕ್ಲೋಶದಾಯೀನಿ ಕರ್ತ್ತುಮ್ ಇಚ್ಛನ್ತಿ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಯೇ ಚ ಪ್ರೇಮ್ನಾ ಘೋಷಯನ್ತಿ ತೇ ಸುಸಂವಾದಸ್ಯ ಪ್ರಾಮಾಣ್ಯಕರಣೇಽಹಂ ನಿಯುಕ್ತೋಽಸ್ಮೀತಿ ಜ್ಞಾತ್ವಾ ತತ್ ಕುರ್ವ್ವನ್ತಿ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಕಿಂ ಬಹುನಾ? ಕಾಪಟ್ಯಾತ್ ಸರಲಭಾವಾದ್ ವಾ ಭವೇತ್, ಯೇನ ಕೇನಚಿತ್ ಪ್ರಕಾರೇಣ ಖ್ರೀಷ್ಟಸ್ಯ ಘೋಷಣಾ ಭವತೀತ್ಯಸ್ಮಿನ್ ಅಹಮ್ ಆನನ್ದಾಮ್ಯಾನನ್ದಿಷ್ಯಾಮಿ ಚ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಯುಷ್ಮಾಕಂ ಪ್ರಾರ್ಥನಯಾ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯಾತ್ಮನಶ್ಚೋಪಕಾರೇಣ ತತ್ ಮನ್ನಿಸ್ತಾರಜನಕಂ ಭವಿಷ್ಯತೀತಿ ಜಾನಾಮಿ|</para>
  <para style="p">
    <verse number="20" style="v"/>ತತ್ರ ಚ ಮಮಾಕಾಙ್ಕ್ಷಾ ಪ್ರತ್ಯಾಶಾ ಚ ಸಿದ್ಧಿಂ ಗಮಿಷ್ಯತಿ ಫಲತೋಽಹಂ ಕೇನಾಪಿ ಪ್ರಕಾರೇಣ ನ ಲಜ್ಜಿಷ್ಯೇ ಕಿನ್ತು ಗತೇ ಸರ್ವ್ವಸ್ಮಿನ್ ಕಾಲೇ ಯದ್ವತ್ ತದ್ವದ್ ಇದಾನೀಮಪಿ ಸಮ್ಪೂರ್ಣೋತ್ಸಾಹದ್ವಾರಾ ಮಮ ಶರೀರೇಣ ಖ್ರೀಷ್ಟಸ್ಯ ಮಹಿಮಾ ಜೀವನೇ ಮರಣೇ ವಾ ಪ್ರಕಾಶಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಯತೋ ಮಮ ಜೀವನಂ ಖ್ರೀಷ್ಟಾಯ ಮರಣಞ್ಚ ಲಾಭಾಯ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಕಿನ್ತು ಯದಿ ಶರೀರೇ ಮಯಾ ಜೀವಿತವ್ಯಂ ತರ್ಹಿ ತತ್ ಕರ್ಮ್ಮಫಲಂ ಫಲಿಷ್ಯತಿ ತಸ್ಮಾತ್ ಕಿಂ ವರಿತವ್ಯಂ ತನ್ಮಯಾ ನ ಜ್ಞಾಯತೇ|</para>
  <para style="p">
    <verse number="23" style="v"/>ದ್ವಾಭ್ಯಾಮ್ ಅಹಂ ಸಮ್ಪೀಡ್ಯೇ, ದೇಹವಾಸತ್ಯಜನಾಯ ಖ್ರೀಷ್ಟೇನ ಸಹವಾಸಾಯ ಚ ಮಮಾಭಿಲಾಷೋ ಭವತಿ ಯತಸ್ತತ್ ಸರ್ವ್ವೋತ್ತಮಂ|</para>
  <para style="p">
    <verse number="24" style="v"/>ಕಿನ್ತು ದೇಹೇ ಮಮಾವಸ್ಥಿತ್ಯಾ ಯುಷ್ಮಾಕಮ್ ಅಧಿಕಪ್ರಯೋಜನಂ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಅಹಮ್ ಅವಸ್ಥಾಸ್ಯೇ ಯುಷ್ಮಾಭಿಃ ಸರ್ವ್ವೈಃ ಸಾರ್ದ್ಧಮ್ ಅವಸ್ಥಿತಿಂ ಕರಿಷ್ಯೇ ಚ ತಯಾ ಚ ವಿಶ್ವಾಸೇ ಯುಷ್ಮಾಕಂ ವೃದ್ಧ್ಯಾನನ್ದೌ ಜನಿಷ್ಯೇತೇ ತದಹಂ ನಿಶ್ಚಿತಂ ಜಾನಾಮಿ|</para>
  <para style="p">
    <verse number="26" style="v"/>ತೇನ ಚ ಮತ್ತೋಽರ್ಥತೋ ಯುಷ್ಮತ್ಸಮೀಪೇ ಮಮ ಪುನರುಪಸ್ಥಿತತ್ವಾತ್ ಯೂಯಂ ಖ್ರೀಷ್ಟೇನ ಯೀಶುನಾ ಬಹುತರಮ್ ಆಹ್ಲಾದಂ ಲಪ್ಸ್ಯಧ್ವೇ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಯೂಯಂ ಸಾವಧಾನಾ ಭೂತ್ವಾ ಖ್ರೀಷ್ಟಸ್ಯ ಸುಸಂವಾದಸ್ಯೋಪಯುಕ್ತಮ್ ಆಚಾರಂ ಕುರುಧ್ವಂ ಯತೋಽಹಂ ಯುಷ್ಮಾನ್ ಉಪಾಗತ್ಯ ಸಾಕ್ಷಾತ್ ಕುರ್ವ್ವನ್ ಕಿಂ ವಾ ದೂರೇ ತಿಷ್ಠನ್ ಯುಷ್ಮಾಕಂ ಯಾಂ ವಾರ್ತ್ತಾಂ ಶ್ರೋತುಮ್ ಇಚ್ಛಾಮಿ ಸೇಯಂ ಯೂಯಮ್ ಏಕಾತ್ಮಾನಸ್ತಿಷ್ಠಥ, ಏಕಮನಸಾ ಸುಸಂವಾದಸಮ್ಬನ್ಧೀಯವಿಶ್ವಾಸಸ್ಯ ಪಕ್ಷೇ ಯತಧ್ವೇ, ವಿಪಕ್ಷೈಶ್ಚ ಕೇನಾಪಿ ಪ್ರಕಾರೇಣ ನ ವ್ಯಾಕುಲೀಕ್ರಿಯಧ್ವ ಇತಿ|</para>
  <para style="p">
    <verse number="28" style="v"/>ತತ್ ತೇಷಾಂ ವಿನಾಶಸ್ಯ ಲಕ್ಷಣಂ ಯುಷ್ಮಾಕಞ್ಚೇಶ್ವರದತ್ತಂ ಪರಿತ್ರಾಣಸ್ಯ ಲಕ್ಷಣಂ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="29" style="v"/>ಯತೋ ಯೇನ ಯುಷ್ಮಾಭಿಃ ಖ್ರೀಷ್ಟೇ ಕೇವಲವಿಶ್ವಾಸಃ ಕ್ರಿಯತೇ ತನ್ನಹಿ ಕಿನ್ತು ತಸ್ಯ ಕೃತೇ ಕ್ಲೇಶೋಽಪಿ ಸಹ್ಯತೇ ತಾದೃಶೋ ವರಃ ಖ್ರೀಷ್ಟಸ್ಯಾನುರೋಧಾದ್ ಯುಷ್ಮಾಭಿಃ ಪ್ರಾಪಿ,</para>
  <para style="p">
    <verse number="30" style="v"/>ತಸ್ಮಾತ್ ಮಮ ಯಾದೃಶಂ ಯುದ್ಧಂ ಯುಷ್ಮಾಭಿರದರ್ಶಿ ಸಾಮ್ಪ್ರತಂ ಶ್ರೂಯತೇ ಚ ತಾದೃಶಂ ಯುದ್ಧಂ ಯುಷ್ಮಾಕಮ್ ಅಪಿ ಭವತಿ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಖ್ರೀಷ್ಟಾದ್ ಯದಿ ಕಿಮಪಿ ಸಾನ್ತ್ವನಂ ಕಶ್ಚಿತ್ ಪ್ರೇಮಜಾತೋ ಹರ್ಷಃ ಕಿಞ್ಚಿದ್ ಆತ್ಮನಃ ಸಮಭಾಗಿತ್ವಂ ಕಾಚಿದ್ ಅನುಕಮ್ಪಾ ಕೃಪಾ ವಾ ಜಾಯತೇ ತರ್ಹಿ ಯೂಯಂ ಮಮಾಹ್ಲಾದಂ ಪೂರಯನ್ತ</para>
  <para style="p">
    <verse number="2" style="v"/>ಏಕಭಾವಾ ಏಕಪ್ರೇಮಾಣ ಏಕಮನಸ ಏಕಚೇಷ್ಟಾಶ್ಚ ಭವತ|</para>
  <para style="p">
    <verse number="3" style="v"/>ವಿರೋಧಾದ್ ದರ್ಪಾದ್ ವಾ ಕಿಮಪಿ ಮಾ ಕುರುತ ಕಿನ್ತು ನಮ್ರತಯಾ ಸ್ವೇಭ್ಯೋಽಪರಾನ್ ವಿಶಿಷ್ಟಾನ್ ಮನ್ಯಧ್ವಂ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಕೇವಲಮ್ ಆತ್ಮಹಿತಾಯ ನ ಚೇಷ್ಟಮಾನಾಃ ಪರಹಿತಾಯಾಪಿ ಚೇಷ್ಟಧ್ವಂ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಖ್ರೀಷ್ಟಸ್ಯ ಯೀಶೋ ರ್ಯಾದೃಶಃ ಸ್ವಭಾವೋ ಯುಷ್ಮಾಕಮ್ ಅಪಿ ತಾದೃಶೋ ಭವತು|</para>
  <para style="p">
    <verse number="6" style="v"/>ಸ ಈಶ್ವರರೂಪೀ ಸನ್ ಸ್ವಕೀಯಾಮ್ ಈಶ್ವರತುಲ್ಯತಾಂ ಶ್ಲಾಘಾಸ್ಪದಂ ನಾಮನ್ಯತ,</para>
  <para style="p">
    <verse number="7" style="v"/>ಕಿನ್ತು ಸ್ವಂ ಶೂನ್ಯಂ ಕೃತ್ವಾ ದಾಸರೂಪೀ ಬಭೂವ ನರಾಕೃತಿಂ ಲೇಭೇ ಚ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಇತ್ಥಂ ನರಮೂರ್ತ್ತಿಮ್ ಆಶ್ರಿತ್ಯ ನಮ್ರತಾಂ ಸ್ವೀಕೃತ್ಯ ಮೃತ್ಯೋರರ್ಥತಃ ಕ್ರುಶೀಯಮೃತ್ಯೋರೇವ ಭೋಗಾಯಾಜ್ಞಾಗ್ರಾಹೀ ಬಭೂವ|</para>
  <para style="p">
    <verse number="9" style="v"/>ತತ್ಕಾರಣಾದ್ ಈಶ್ವರೋಽಪಿ ತಂ ಸರ್ವ್ವೋನ್ನತಂ ಚಕಾರ ಯಚ್ಚ ನಾಮ ಸರ್ವ್ವೇಷಾಂ ನಾಮ್ನಾಂ ಶ್ರೇಷ್ಠಂ ತದೇವ ತಸ್ಮೈ ದದೌ,</para>
  <para style="p">
    <verse number="10" style="v"/>ತತಸ್ತಸ್ಮೈ ಯೀಶುನಾಮ್ನೇ ಸ್ವರ್ಗಮರ್ತ್ಯಪಾತಾಲಸ್ಥಿತೈಃ ಸರ್ವ್ವೈ ರ್ಜಾನುಪಾತಃ ಕರ್ತ್ತವ್ಯಃ,</para>
  <para style="p">
    <verse number="11" style="v"/>ತಾತಸ್ಥೇಶ್ವರಸ್ಯ ಮಹಿಮ್ನೇ ಚ ಯೀಶುಖ್ರೀಷ್ಟಃ ಪ್ರಭುರಿತಿ ಜಿಹ್ವಾಭಿಃ ಸ್ವೀಕರ್ತ್ತವ್ಯಂ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಅತೋ ಹೇ ಪ್ರಿಯತಮಾಃ, ಯುಷ್ಮಾಭಿ ರ್ಯದ್ವತ್ ಸರ್ವ್ವದಾ ಕ್ರಿಯತೇ ತದ್ವತ್ ಕೇವಲೇ ಮಮೋಪಸ್ಥಿತಿಕಾಲೇ ತನ್ನಹಿ ಕಿನ್ತ್ವಿದಾನೀಮ್ ಅನುಪಸ್ಥಿತೇಽಪಿ ಮಯಿ ಬಹುತರಯತ್ನೇನಾಜ್ಞಾಂ ಗೃಹೀತ್ವಾ ಭಯಕಮ್ಪಾಭ್ಯಾಂ ಸ್ವಸ್ವಪರಿತ್ರಾಣಂ ಸಾಧ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯತ ಈಶ್ವರ ಏವ ಸ್ವಕೀಯಾನುರೋಧಾದ್ ಯುಷ್ಮನ್ಮಧ್ಯೇ ಮನಸ್ಕಾಮನಾಂ ಕರ್ಮ್ಮಸಿದ್ಧಿಞ್ಚ ವಿದಧಾತಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಯೂಯಂ ಕಲಹವಿವಾದರ್ವಿಜತಮ್ ಆಚಾರಂ ಕುರ್ವ್ವನ್ತೋಽನಿನ್ದನೀಯಾ ಅಕುಟಿಲಾ</para>
  <para style="p">
    <verse number="15" style="v"/>ಈಶ್ವರಸ್ಯ ನಿಷ್ಕಲಙ್ಕಾಶ್ಚ ಸನ್ತಾನಾಇವ ವಕ್ರಭಾವಾನಾಂ ಕುಟಿಲಾಚಾರಿಣಾಞ್ಚ ಲೋಕಾನಾಂ ಮಧ್ಯೇ ತಿಷ್ಠತ,</para>
  <para style="p">
    <verse number="16" style="v"/>ಯತಸ್ತೇಷಾಂ ಮಧ್ಯೇ ಯೂಯಂ ಜೀವನವಾಕ್ಯಂ ಧಾರಯನ್ತೋ ಜಗತೋ ದೀಪಕಾ ಇವ ದೀಪ್ಯಧ್ವೇ| ಯುಷ್ಮಾಭಿಸ್ತಥಾ ಕೃತೇ ಮಮ ಯತ್ನಃ ಪರಿಶ್ರಮೋ ವಾ ನ ನಿಷ್ಫಲೋ ಜಾತ ಇತ್ಯಹಂ ಖ್ರೀಷ್ಟಸ್ಯ ದಿನೇ ಶ್ಲಾಘಾಂ ಕರ್ತ್ತುಂ ಶಕ್ಷ್ಯಾಮಿ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಯುಷ್ಮಾಕಂ ವಿಶ್ವಾಸಾರ್ಥಕಾಯ ಬಲಿದಾನಾಯ ಸೇವನಾಯ ಚ ಯದ್ಯಪ್ಯಹಂ ನಿವೇದಿತವ್ಯೋ ಭವೇಯಂ ತಥಾಪಿ ತೇನಾನನ್ದಾಮಿ ಸರ್ವ್ವೇಷಾಂ ಯುಷ್ಮಾಕಮ್ ಆನನ್ದಸ್ಯಾಂಶೀ ಭವಾಮಿ ಚ|</para>
  <para style="p">
    <verse number="18" style="v"/>ತದ್ವದ್ ಯೂಯಮಪ್ಯಾನನ್ದತ ಮದೀಯಾನನ್ದಸ್ಯಾಂಶಿನೋ ಭವತ ಚ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಯುಷ್ಮಾಕಮ್ ಅವಸ್ಥಾಮ್ ಅವಗತ್ಯಾಹಮಪಿ ಯತ್ ಸಾನ್ತ್ವನಾಂ ಪ್ರಾಪ್ನುಯಾಂ ತದರ್ಥಂ ತೀಮಥಿಯಂ ತ್ವರಯಾ ಯುಷ್ಮತ್ಸಮೀಪಂ ಪ್ರೇಷಯಿಷ್ಯಾಮೀತಿ ಪ್ರಭೌ ಪ್ರತ್ಯಾಶಾಂ ಕುರ್ವ್ವೇ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಯಃ ಸತ್ಯರೂಪೇಣ ಯುಷ್ಮಾಕಂ ಹಿತಂ ಚಿನ್ತಯತಿ ತಾದೃಶ ಏಕಭಾವಸ್ತಸ್ಮಾದನ್ಯಃ ಕೋಽಪಿ ಮಮ ಸನ್ನಿಧೌ ನಾಸ್ತಿ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಯತೋಽಪರೇ ಸರ್ವ್ವೇ ಯೀಶೋಃ ಖ್ರೀಷ್ಟಸ್ಯ ವಿಷಯಾನ್ ನ ಚಿನ್ತಯನ್ತ ಆತ್ಮವಿಷಯಾನ್ ಚಿನ್ತಯನ್ತಿ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಕಿನ್ತು ತಸ್ಯ ಪರೀಕ್ಷಿತತ್ವಂ ಯುಷ್ಮಾಭಿ ರ್ಜ್ಞಾಯತೇ ಯತಃ ಪುತ್ರೋ ಯಾದೃಕ್ ಪಿತುಃ ಸಹಕಾರೀ ಭವತಿ ತಥೈವ ಸುಸಂವಾದಸ್ಯ ಪರಿಚರ್ಯ್ಯಾಯಾಂ ಸ ಮಮ ಸಹಕಾರೀ ಜಾತಃ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಅತಏವ ಮಮ ಭಾವಿದಶಾಂ ಜ್ಞಾತ್ವಾ ತತ್ಕ್ಷಣಾತ್ ತಮೇವ ಪ್ರೇಷಯಿತುಂ ಪ್ರತ್ಯಾಶಾಂ ಕುರ್ವ್ವೇ</para>
  <para style="p">
    <verse number="24" style="v"/>ಸ್ವಯಮ್ ಅಹಮಪಿ ತೂರ್ಣಂ ಯುಷ್ಮತ್ಸಮೀಪಂ ಗಮಿಷ್ಯಾಮೀತ್ಯಾಶಾಂ ಪ್ರಭುನಾ ಕುರ್ವ್ವೇ|</para>
  <para style="p">
    <verse number="25" style="v"/>ಅಪರಂ ಯ ಇಪಾಫ್ರದೀತೋ ಮಮ ಭ್ರಾತಾ ಕರ್ಮ್ಮಯುದ್ಧಾಭ್ಯಾಂ ಮಮ ಸಹಾಯಶ್ಚ ಯುಷ್ಮಾಕಂ ದೂತೋ ಮದೀಯೋಪಕಾರಾಯ ಪ್ರತಿನಿಧಿಶ್ಚಾಸ್ತಿ ಯುಷ್ಮತ್ಸಮೀಪೇ ತಸ್ಯ ಪ್ರೇಷಣಮ್ ಆವಶ್ಯಕಮ್ ಅಮನ್ಯೇ|</para>
  <para style="p">
    <verse number="26" style="v"/>ಯತಃ ಸ ಯುಷ್ಮಾನ್ ಸರ್ವ್ವಾನ್ ಅಕಾಙ್ಕ್ಷತ ಯುಷ್ಮಾಭಿಸ್ತಸ್ಯ ರೋಗಸ್ಯ ವಾರ್ತ್ತಾಶ್ರಾವೀತಿ ಬುದ್ಧ್ವಾ ಪರ್ಯ್ಯಶೋಚಚ್ಚ|</para>
  <para style="p">
    <verse number="27" style="v"/>ಸ ಪೀಡಯಾ ಮೃತಕಲ್ಪೋಽಭವದಿತಿ ಸತ್ಯಂ ಕಿನ್ತ್ವೀಶ್ವರಸ್ತಂ ದಯಿತವಾನ್ ಮಮ ಚ ದುಃಖಾತ್ ಪರಂ ಪುನರ್ದುಃಖಂ ಯನ್ನ ಭವೇತ್ ತದರ್ಥಂ ಕೇವಲಂ ತಂ ನ ದಯಿತ್ವಾ ಮಾಮಪಿ ದಯಿತವಾನ್|</para>
  <para style="p">
    <verse number="28" style="v"/>ಅತಏವ ಯೂಯಂ ತಂ ವಿಲೋಕ್ಯ ಯತ್ ಪುನರಾನನ್ದೇತ ಮಮಾಪಿ ದುಃಖಸ್ಯ ಹ್ರಾಸೋ ಯದ್ ಭವೇತ್ ತದರ್ಥಮ್ ಅಹಂ ತ್ವರಯಾ ತಮ್ ಅಪ್ರೇಷಯಂ|</para>
  <para style="p">
    <verse number="29" style="v"/>ಅತೋ ಯೂಯಂ ಪ್ರಭೋಃ ಕೃತೇ ಸಮ್ಪೂರ್ಣೇನಾನನ್ದೇನ ತಂ ಗೃಹ್ಲೀತ ತಾದೃಶಾನ್ ಲೋಕಾಂಶ್ಚಾದರಣೀಯಾನ್ ಮನ್ಯಧ್ವಂ|</para>
  <para style="p">
    <verse number="30" style="v"/>ಯತೋ ಮಮ ಸೇವನೇ ಯುಷ್ಮಾಕಂ ತ್ರುಟಿಂ ಪೂರಯಿತುಂ ಸ ಪ್ರಾಣಾನ್ ಪಣೀಕೃತ್ಯ ಖ್ರೀಷ್ಟಸ್ಯ ಕಾರ್ಯ್ಯಾರ್ಥಂ ಮೃತಪ್ರಾಯೇಽಭವತ್|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಶೇಷೇ ವದಾಮಿ ಯೂಯಂ ಪ್ರಭಾವಾನನ್ದತ| ಪುನಃ ಪುನರೇಕಸ್ಯ ವಚೋ ಲೇಖನಂ ಮಮ ಕ್ಲೇಶದಂ ನಹಿ ಯುಷ್ಮದರ್ಥಞ್ಚ ಭ್ರಮನಾಶಕಂ ಭವತಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯೂಯಂ ಕುಕ್ಕುರೇಭ್ಯಃ ಸಾವಧಾನಾ ಭವತ ದುಷ್ಕರ್ಮ್ಮಕಾರಿಭ್ಯಃ ಸಾವಧಾನಾ ಭವತ ಛಿನ್ನಮೂಲೇಭ್ಯೋ ಲೋಕೇಭ್ಯಶ್ಚ ಸಾವಧಾನಾ ಭವತ|</para>
  <para style="p">
    <verse number="3" style="v"/>ವಯಮೇವ ಛಿನ್ನತ್ವಚೋ ಲೋಕಾ ಯತೋ ವಯಮ್ ಆತ್ಮನೇಶ್ವರಂ ಸೇವಾಮಹೇ ಖ್ರೀಷ್ಟೇನ ಯೀಶುನಾ ಶ್ಲಾಘಾಮಹೇ ಶರೀರೇಣ ಚ ಪ್ರಗಲ್ಭತಾಂ ನ ಕುರ್ವ್ವಾಮಹೇ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಕಿನ್ತು ಶರೀರೇ ಮಮ ಪ್ರಗಲ್ಭತಾಯಾಃ ಕಾರಣಂ ವಿದ್ಯತೇ, ಕಶ್ಚಿದ್ ಯದಿ ಶರೀರೇಣ ಪ್ರಗಲ್ಭತಾಂ ಚಿಕೀರ್ಷತಿ ತರ್ಹಿ ತಸ್ಮಾದ್ ಅಪಿ ಮಮ ಪ್ರಗಲ್ಭತಾಯಾ ಗುರುತರಂ ಕಾರಣಂ ವಿದ್ಯತೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯತೋಽಹಮ್ ಅಷ್ಟಮದಿವಸೇ ತ್ವಕ್ಛೇದಪ್ರಾಪ್ತ ಇಸ್ರಾಯೇಲ್ವಂಶೀಯೋ ಬಿನ್ಯಾಮೀನಗೋಷ್ಠೀಯ ಇಬ್ರಿಕುಲಜಾತ ಇಬ್ರಿಯೋ ವ್ಯವಸ್ಥಾಚರಣೇ ಫಿರೂಶೀ</para>
  <para style="p">
    <verse number="6" style="v"/>ಧರ್ಮ್ಮೋತ್ಸಾಹಕಾರಣಾತ್ ಸಮಿತೇರುಪದ್ರವಕಾರೀ ವ್ಯವಸ್ಥಾತೋ ಲಭ್ಯೇ ಪುಣ್ಯೇ ಚಾನಿನ್ದನೀಯಃ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಕಿನ್ತು ಮಮ ಯದ್ಯತ್ ಲಭ್ಯಮ್ ಆಸೀತ್ ತತ್ ಸರ್ವ್ವಮ್ ಅಹಂ ಖ್ರೀಷ್ಟಸ್ಯಾನುರೋಧಾತ್ ಕ್ಷತಿಮ್ ಅಮನ್ಯೇ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಕಿಞ್ಚಾಧುನಾಪ್ಯಹಂ ಮತ್ಪ್ರಭೋಃ ಖ್ರೀಷ್ಟಸ್ಯ ಯೀಶೋ ರ್ಜ್ಞಾನಸ್ಯೋತ್ಕೃಷ್ಟತಾಂ ಬುದ್ಧ್ವಾ ತತ್ ಸರ್ವ್ವಂ ಕ್ಷತಿಂ ಮನ್ಯೇ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಯತೋ ಹೇತೋರಹಂ ಯತ್ ಖ್ರೀಷ್ಟಂ ಲಭೇಯ ವ್ಯವಸ್ಥಾತೋ ಜಾತಂ ಸ್ವಕೀಯಪುಣ್ಯಞ್ಚ ನ ಧಾರಯನ್ ಕಿನ್ತು ಖ್ರೀಷ್ಟೇ ವಿಶ್ವಸನಾತ್ ಲಭ್ಯಂ ಯತ್ ಪುಣ್ಯಮ್ ಈಶ್ವರೇಣ ವಿಶ್ವಾಸಂ ದೃಷ್ಟ್ವಾ ದೀಯತೇ ತದೇವ ಧಾರಯನ್ ಯತ್ ಖ್ರೀಷ್ಟೇ ವಿದ್ಯೇಯ ತದರ್ಥಂ ತಸ್ಯಾನುರೋಧಾತ್ ಸರ್ವ್ವೇಷಾಂ ಕ್ಷತಿಂ ಸ್ವೀಕೃತ್ಯ ತಾನಿ ಸರ್ವ್ವಾಣ್ಯವಕರಾನಿವ ಮನ್ಯೇ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯತೋ ಹೇತೋರಹಂ ಖ್ರೀಷ್ಟಂ ತಸ್ಯ ಪುನರುತ್ಥಿತೇ ರ್ಗುಣಂ ತಸ್ಯ ದುಃಖಾನಾಂ ಭಾಗಿತ್ವಞ್ಚ ಜ್ಞಾತ್ವಾ ತಸ್ಯ ಮೃತ್ಯೋರಾಕೃತಿಞ್ಚ ಗೃಹೀತ್ವಾ</para>
  <para style="p">
    <verse number="11" style="v"/>ಯೇನ ಕೇನಚಿತ್ ಪ್ರಕಾರೇಣ ಮೃತಾನಾಂ ಪುನರುತ್ಥಿತಿಂ ಪ್ರಾಪ್ತುಂ ಯತೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಮಯಾ ತತ್ ಸರ್ವ್ವಮ್ ಅಧುನಾ ಪ್ರಾಪಿ ಸಿದ್ಧತಾ ವಾಲಮ್ಭಿ ತನ್ನಹಿ ಕಿನ್ತು ಯದರ್ಥಮ್ ಅಹಂ ಖ್ರೀಷ್ಟೇನ ಧಾರಿತಸ್ತದ್ ಧಾರಯಿತುಂ ಧಾವಾಮಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಮಯಾ ತದ್ ಧಾರಿತಮ್ ಇತಿ ನ ಮನ್ಯತೇ ಕಿನ್ತ್ವೇತದೈಕಮಾತ್ರಂ ವದಾಮಿ ಯಾನಿ ಪಶ್ಚಾತ್ ಸ್ಥಿತಾನಿ ತಾನಿ ವಿಸ್ಮೃತ್ಯಾಹಮ್ ಅಗ್ರಸ್ಥಿತಾನ್ಯುದ್ದಿಶ್ಯ</para>
  <para style="p">
    <verse number="14" style="v"/>ಪೂರ್ಣಯತ್ನೇನ ಲಕ್ಷ್ಯಂ ಪ್ರತಿ ಧಾವನ್ ಖ್ರೀಷ್ಟಯೀಶುನೋರ್ದ್ಧ್ವಾತ್ ಮಾಮ್ ಆಹ್ವಯತ ಈಶ್ವರಾತ್ ಜೇತೃಪಣಂ ಪ್ರಾಪ್ತುಂ ಚೇಷ್ಟೇ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅಸ್ಮಾಕಂ ಮಧ್ಯೇ ಯೇ ಸಿದ್ಧಾಸ್ತೈಃ ಸರ್ವ್ವೈಸ್ತದೇವ ಭಾವ್ಯತಾಂ, ಯದಿ ಚ ಕಞ್ಚನ ವಿಷಯಮ್ ಅಧಿ ಯುಷ್ಮಾಕಮ್ ಅಪರೋ ಭಾವೋ ಭವತಿ ತರ್ಹೀಶ್ವರಸ್ತಮಪಿ ಯುಷ್ಮಾಕಂ ಪ್ರತಿ ಪ್ರಕಾಶಯಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಕಿನ್ತು ವಯಂ ಯದ್ಯದ್ ಅವಗತಾ ಆಸ್ಮಸ್ತತ್ರಾಸ್ಮಾಭಿರೇಕೋ ವಿಧಿರಾಚರಿತವ್ಯ ಏಕಭಾವೈ ರ್ಭವಿತವ್ಯಞ್ಚ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಯೂಯಂ ಮಮಾನುಗಾಮಿನೋ ಭವತ ವಯಞ್ಚ ಯಾದೃಗಾಚರಣಸ್ಯ ನಿದರ್ಶನಸ್ವರೂಪಾ ಭವಾಮಸ್ತಾದೃಗಾಚಾರಿಣೋ ಲೋಕಾನ್ ಆಲೋಕಯಧ್ವಂ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಯತೋಽನೇಕೇ ವಿಪಥೇ ಚರನ್ತಿ ತೇ ಚ ಖ್ರೀಷ್ಟಸ್ಯ ಕ್ರುಶಸ್ಯ ಶತ್ರವ ಇತಿ ಪುರಾ ಮಯಾ ಪುನಃ ಪುನಃ ಕಥಿತಮ್ ಅಧುನಾಪಿ ರುದತಾ ಮಯಾ ಕಥ್ಯತೇ|</para>
  <para style="p">
    <verse number="19" style="v"/>ತೇಷಾಂ ಶೇಷದಶಾ ಸರ್ವ್ವನಾಶ ಉದರಶ್ಚೇಶ್ವರೋ ಲಜ್ಜಾ ಚ ಶ್ಲಾಘಾ ಪೃಥಿವ್ಯಾಞ್ಚ ಲಗ್ನಂ ಮನಃ|</para>
  <para style="p">
    <verse number="20" style="v"/>ಕಿನ್ತ್ವಸ್ಮಾಕಂ ಜನಪದಃ ಸ್ವರ್ಗೇ ವಿದ್ಯತೇ ತಸ್ಮಾಚ್ಚಾಗಮಿಷ್ಯನ್ತಂ ತ್ರಾತಾರಂ ಪ್ರಭುಂ ಯೀಶುಖ್ರೀಷ್ಟಂ ವಯಂ ಪ್ರತೀಕ್ಷಾಮಹೇ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಸ ಚ ಯಯಾ ಶಕ್ತ್ಯಾ ಸರ್ವ್ವಾಣ್ಯೇವ ಸ್ವಸ್ಯ ವಶೀಕರ್ತ್ತುಂ ಪಾರಯತಿ ತಯಾಸ್ಮಾಕಮ್ ಅಧಮಂ ಶರೀರಂ ರೂಪಾನ್ತರೀಕೃತ್ಯ ಸ್ವಕೀಯತೇಜೋಮಯಶರೀರಸ್ಯ ಸಮಾಕಾರಂ ಕರಿಷ್ಯತಿ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಮದೀಯಾನನ್ದಮುಕುಟಸ್ವರೂಪಾಃ ಪ್ರಿಯತಮಾ ಅಭೀಷ್ಟತಮಾ ಭ್ರಾತರಃ, ಹೇ ಮಮ ಸ್ನೇಹಪಾತ್ರಾಃ, ಯೂಯಮ್ ಇತ್ಥಂ ಪಭೌ ಸ್ಥಿರಾಸ್ತಿಷ್ಠತ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಹೇ ಇವದಿಯೇ ಹೇ ಸುನ್ತುಖಿ ಯುವಾಂ ಪ್ರಭೌ ಏಕಭಾವೇ ಭವತಮ್ ಏತದ್ ಅಹಂ ಪ್ರಾರ್ಥಯೇ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಹೇ ಮಮ ಸತ್ಯ ಸಹಕಾರಿನ್ ತ್ವಾಮಪಿ ವಿನೀಯ ವದಾಮಿ ಏತಯೋರುಪಕಾರಸ್ತ್ವಯಾ ಕ್ರಿಯತಾಂ ಯತಸ್ತೇ ಕ್ಲೀಮಿನಾದಿಭಿಃ ಸಹಕಾರಿಭಿಃ ಸಾರ್ದ್ಧಂ ಸುಸಂವಾದಪ್ರಚಾರಣಾಯ ಮಮ ಸಾಹಾಯ್ಯಾರ್ಥಂ ಪರಿಶ್ರಮಮ್ ಅಕುರ್ವ್ವತಾಂ ತೇಷಾಂ ಸರ್ವ್ವೇಷಾಂ ನಾಮಾನಿ ಚ ಜೀವನಪುಸ್ತಕೇ ಲಿಖಿತಾನಿ ವಿದ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಯೂಯಂ ಪ್ರಭೌ ಸರ್ವ್ವದಾನನ್ದತ| ಪುನ ರ್ವದಾಮಿ ಯೂಯಮ್ ಆನನ್ದತ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಯುಷ್ಮಾಕಂ ವಿನೀತತ್ವಂ ಸರ್ವ್ವಮಾನವೈ ರ್ಜ್ಞಾಯತಾಂ, ಪ್ರಭುಃ ಸನ್ನಿಧೌ ವಿದ್ಯತೇ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಯೂಯಂ ಕಿಮಪಿ ನ ಚಿನ್ತಯತ ಕಿನ್ತು ಧನ್ಯವಾದಯುಕ್ತಾಭ್ಯಾಂ ಪ್ರಾರ್ಥನಾಯಾಞ್ಚಾಭ್ಯಾಂ ಸರ್ವ್ವವಿಷಯೇ ಸ್ವಪ್ರಾರ್ಥನೀಯಮ್ ಈಶ್ವರಾಯ ನಿವೇದಯತ|</para>
  <para style="p">
    <verse number="7" style="v"/>ತಥಾ ಕೃತ ಈಶ್ವರೀಯಾ ಯಾ ಶಾನ್ತಿಃ ಸರ್ವ್ವಾಂ ಬುದ್ಧಿಮ್ ಅತಿಶೇತೇ ಸಾ ಯುಷ್ಮಾಕಂ ಚಿತ್ತಾನಿ ಮನಾಂಸಿ ಚ ಖ್ರೀಷ್ಟೇ ಯೀಶೌ ರಕ್ಷಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಹೇ ಭ್ರಾತರಃ, ಶೇಷೇ ವದಾಮಿ ಯದ್ಯತ್ ಸತ್ಯಮ್ ಆದರಣೀಯಂ ನ್ಯಾಯ್ಯಂ ಸಾಧು ಪ್ರಿಯಂ ಸುಖ್ಯಾತಮ್ ಅನ್ಯೇಣ ಯೇನ ಕೇನಚಿತ್ ಪ್ರಕಾರೇಣ ವಾ ಗುಣಯುಕ್ತಂ ಪ್ರಶಂಸನೀಯಂ ವಾ ಭವತಿ ತತ್ರೈವ ಮನಾಂಸಿ ನಿಧಧ್ವಂ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಯೂಯಂ ಮಾಂ ದೃಷ್ಟ್ವಾ ಶ್ರುತ್ವಾ ಚ ಯದ್ಯತ್ ಶಿಕ್ಷಿತವನ್ತೋ ಗೃಹೀತವನ್ತಶ್ಚ ತದೇವಾಚರತ ತಸ್ಮಾತ್ ಶಾನ್ತಿದಾಯಕ ಈಶ್ವರೋ ಯುಷ್ಮಾಭಿಃ ಸಾರ್ದ್ಧಂ ಸ್ಥಾಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಮಮೋಪಕಾರಾಯ ಯುಷ್ಮಾಕಂ ಯಾ ಚಿನ್ತಾ ಪೂರ್ವ್ವಮ್ ಆಸೀತ್ ಕಿನ್ತು ಕರ್ಮ್ಮದ್ವಾರಂ ನ ಪ್ರಾಪ್ನೋತ್ ಇದಾನೀಂ ಸಾ ಪುನರಫಲತ್ ಇತ್ಯಸ್ಮಿನ್ ಪ್ರಭೌ ಮಮ ಪರಮಾಹ್ಲಾದೋಽಜಾಯತ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅಹಂ ಯದ್ ದೈನ್ಯಕಾರಣಾದ್ ಇದಂ ವದಾಮಿ ತನ್ನಹಿ ಯತೋ ಮಮ ಯಾ ಕಾಚಿದ್ ಅವಸ್ಥಾ ಭವೇತ್ ತಸ್ಯಾಂ ಸನ್ತೋಷ್ಟುಮ್ ಅಶಿಕ್ಷಯಂ|</para>
  <para style="p">
    <verse number="12" style="v"/>ದರಿದ್ರತಾಂ ಭೋಕ್ತುಂ ಶಕ್ನೋಮಿ ಧನಾಢ್ಯತಾಮ್ ಅಪಿ ಭೋಕ್ತುಂ ಶಕ್ನೋಮಿ ಸರ್ವ್ವಥಾ ಸರ್ವ್ವವಿಷಯೇಷು ವಿನೀತೋಽಹಂ ಪ್ರಚುರತಾಂ ಕ್ಷುಧಾಞ್ಚ ಧನಂ ದೈನ್ಯಞ್ಚಾವಗತೋಽಸ್ಮಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಮಮ ಶಕ್ತಿದಾಯಕೇನ ಖ್ರೀಷ್ಟೇನ ಸರ್ವ್ವಮೇವ ಮಯಾ ಶಕ್ಯಂ ಭವತಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಕಿನ್ತು ಯುಷ್ಮಾಭಿ ರ್ದೈನ್ಯನಿವಾರಣಾಯ ಮಾಮ್ ಉಪಕೃತ್ಯ ಸತ್ಕರ್ಮ್ಮಾಕಾರಿ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಹೇ ಫಿಲಿಪೀಯಲೋಕಾಃ, ಸುಸಂವಾದಸ್ಯೋದಯಕಾಲೇ ಯದಾಹಂ ಮಾಕಿದನಿಯಾದೇಶಾತ್ ಪ್ರತಿಷ್ಠೇ ತದಾ ಕೇವಲಾನ್ ಯುಷ್ಮಾನ್ ವಿನಾಪರಯಾ ಕಯಾಪಿ ಸಮಿತ್ಯಾ ಸಹ ದಾನಾದಾನಯೋ ರ್ಮಮ ಕೋಽಪಿ ಸಮ್ಬನ್ಧೋ ನಾಸೀದ್ ಇತಿ ಯೂಯಮಪಿ ಜಾನೀಥ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಯತೋ ಯುಷ್ಮಾಭಿ ರ್ಮಮ ಪ್ರಯೋಜನಾಯ ಥಿಷಲನೀಕೀನಗರಮಪಿ ಮಾಂ ಪ್ರತಿ ಪುನಃ ಪುನರ್ದಾನಂ ಪ್ರೇಷಿತಂ|</para>
  <para style="p">
    <verse number="17" style="v"/>ಅಹಂ ಯದ್ ದಾನಂ ಮೃಗಯೇ ತನ್ನಹಿ ಕಿನ್ತು ಯುಷ್ಮಾಕಂ ಲಾಭವರ್ದ್ಧಕಂ ಫಲಂ ಮೃಗಯೇ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಕಿನ್ತು ಮಮ ಕಸ್ಯಾಪ್ಯಭಾವೋ ನಾಸ್ತಿ ಸರ್ವ್ವಂ ಪ್ರಚುರಮ್ ಆಸ್ತೇ ಯತ ಈಶ್ವರಸ್ಯ ಗ್ರಾಹ್ಯಂ ತುಷ್ಟಿಜನಕಂ ಸುಗನ್ಧಿನೈವೇದ್ಯಸ್ವರೂಪಂ ಯುಷ್ಮಾಕಂ ದಾನಂ ಇಪಾಫ್ರದಿತಾದ್ ಗೃಹೀತ್ವಾಹಂ ಪರಿತೃಪ್ತೋಽಸ್ಮಿ|</para>
  <para style="p">
    <verse number="19" style="v"/>ಮಮೇಶ್ವರೋಽಪಿ ಖ್ರೀಷ್ಟೇನ ಯೀಶುನಾ ಸ್ವಕೀಯವಿಭವನಿಧಿತಃ ಪ್ರಯೋಜನೀಯಂ ಸರ್ವ್ವವಿಷಯಂ ಪೂರ್ಣರೂಪಂ ಯುಷ್ಮಭ್ಯಂ ದೇಯಾತ್|</para>
  <para style="p">
    <verse number="20" style="v"/>ಅಸ್ಮಾಕಂ ಪಿತುರೀಶ್ವರಸ್ಯ ಧನ್ಯವಾದೋಽನನ್ತಕಾಲಂ ಯಾವದ್ ಭವತು| ಆಮೇನ್|</para>
  <para style="p">
    <verse number="21" style="v"/>ಯೂಯಂ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯೈಕೈಕಂ ಪವಿತ್ರಜನಂ ನಮಸ್ಕುರುತ| ಮಮ ಸಙ್ಗಿಭ್ರಾತರೋ ಯೂಷ್ಮಾನ್ ನಮಸ್ಕುರ್ವ್ವತೇ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಸರ್ವ್ವೇ ಪವಿತ್ರಲೋಕಾ ವಿಶೇಷತಃ ಕೈಸರಸ್ಯ ಪರಿಜನಾ ಯುಷ್ಮಾನ್ ನಮಸ್ಕುರ್ವ್ವತೇ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಅಸ್ಮಾಕಂ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯ ಪ್ರಸಾದಃ ಸರ್ವ್ವಾನ್ ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಭೂಯಾತ್| ಆಮೇನ್|</para>
</usx>
