<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="2JN" style="id">Sanskrit Bible (NT) in Kannada Script (ಸತ್ಯವೇದಃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">2 John</para>
  <para style="toc1">೨ ಯೋಹನಃ ಪತ್ರಂ</para>
  <para style="toc2">೨ ಯೋಹನಃ</para>
  <para style="toc3">೨ ಯೋಹನಃ</para>
  <para style="mt1">೨ ಯೋಹನಃ ಪತ್ರಂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಅಭಿರುಚಿತೇ ಕುರಿಯೇ, ತ್ವಾಂ ತವ ಪುತ್ರಾಂಶ್ಚ ಪ್ರತಿ ಪ್ರಾಚೀನೋಽಹಂ ಪತ್ರಂ ಲಿಖಾಮಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಸತ್ಯಮತಾದ್ ಯುಷ್ಮಾಸು ಮಮ ಪ್ರೇಮಾಸ್ತಿ ಕೇವಲಂ ಮಮ ನಹಿ ಕಿನ್ತು ಸತ್ಯಮತಜ್ಞಾನಾಂ ಸರ್ವ್ವೇಷಾಮೇವ| ಯತಃ ಸತ್ಯಮತಮ್ ಅಸ್ಮಾಸು ತಿಷ್ಠತ್ಯನನ್ತಕಾಲಂ ಯಾವಚ್ಚಾಸ್ಮಾಸು ಸ್ಥಾಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಪಿತುರೀಶ್ವರಾತ್ ತತ್ಪಿತುಃ ಪುತ್ರಾತ್ ಪ್ರಭೋ ರ್ಯೀಶುಖ್ರೀಷ್ಟಾಚ್ಚ ಪ್ರಾಪ್ಯೋ ಽನುಗ್ರಹಃ ಕೃಪಾ ಶಾನ್ತಿಶ್ಚ ಸತ್ಯತಾಪ್ರೇಮಭ್ಯಾಂ ಸಾರ್ದ್ಧಂ ಯುಷ್ಮಾನ್ ಅಧಿತಿಷ್ಠತು|</para>
  <para style="p">
    <verse number="4" style="v"/>ವಯಂ ಪಿತೃತೋ ಯಾಮ್ ಆಜ್ಞಾಂ ಪ್ರಾಪ್ತವನ್ತಸ್ತದನುಸಾರೇಣ ತವ ಕೇಚಿದ್ ಆತ್ಮಜಾಃ ಸತ್ಯಮತಮ್ ಆಚರನ್ತ್ಯೇತಸ್ಯ ಪ್ರಮಾಣಂ ಪ್ರಾಪ್ಯಾಹಂ ಭೃಶಮ್ ಆನನ್ದಿತವಾನ್|</para>
  <para style="p">
    <verse number="5" style="v"/>ಸಾಮ್ಪ್ರತಞ್ಚ ಹೇ ಕುರಿಯೇ, ನವೀನಾಂ ಕಾಞ್ಚಿದ್ ಆಜ್ಞಾಂ ನ ಲಿಖನ್ನಹಮ್ ಆದಿತೋ ಲಬ್ಧಾಮ್ ಆಜ್ಞಾಂ ಲಿಖನ್ ತ್ವಾಮ್ ಇದಂ ವಿನಯೇ ಯದ್ ಅಸ್ಮಾಭಿಃ ಪರಸ್ಪರಂ ಪ್ರೇಮ ಕರ್ತ್ತವ್ಯಂ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅಪರಂ ಪ್ರೇಮೈತೇನ ಪ್ರಕಾಶತೇ ಯದ್ ವಯಂ ತಸ್ಯಾಜ್ಞಾ ಆಚರೇಮ| ಆದಿತೋ ಯುಷ್ಮಾಭಿ ರ್ಯಾ ಶ್ರುತಾ ಸೇಯಮ್ ಆಜ್ಞಾ ಸಾ ಚ ಯುಷ್ಮಾಭಿರಾಚರಿತವ್ಯಾ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯತೋ ಬಹವಃ ಪ್ರವಞ್ಚಕಾ ಜಗತ್ ಪ್ರವಿಶ್ಯ ಯೀಶುಖ್ರೀಷ್ಟೋ ನರಾವತಾರೋ ಭೂತ್ವಾಗತ ಏತತ್ ನಾಙ್ಗೀಕುರ್ವ್ವನ್ತಿ ಸ ಏವ ಪ್ರವಞ್ಚಕಃ ಖ್ರೀಷ್ಟಾರಿಶ್ಚಾಸ್ತಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಅಸ್ಮಾಕಂ ಶ್ರಮೋ ಯತ್ ಪಣ್ಡಶ್ರಮೋ ನ ಭವೇತ್ ಕಿನ್ತು ಸಮ್ಪೂರ್ಣಂ ವೇತನಮಸ್ಮಾಭಿ ರ್ಲಭ್ಯೇತ ತದರ್ಥಂ ಸ್ವಾನಧಿ ಸಾವಧಾನಾ ಭವತಃ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಯಃ ಕಶ್ಚಿದ್ ವಿಪಥಗಾಮೀ ಭೂತ್ವಾ ಖ್ರೀಷ್ಟಸ್ಯ ಶಿಕ್ಷಾಯಾಂ ನ ತಿಷ್ಠತಿ ಸ ಈಶ್ವರಂ ನ ಧಾರಯತಿ ಖ್ರೀಷ್ಟಸ್ಯ ಶಿಜ್ಞಾಯಾಂ ಯಸ್ತಿಷ್ಠತಿ ಸ ಪಿತರಂ ಪುತ್ರಞ್ಚ ಧಾರಯತಿ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಯಃ ಕಶ್ಚಿದ್ ಯುಷ್ಮತ್ಸನ್ನಿಧಿಮಾಗಚ್ಛನ್ ಶಿಕ್ಷಾಮೇನಾಂ ನಾನಯತಿ ಸ ಯುಷ್ಮಾಭಿಃ ಸ್ವವೇಶ್ಮನಿ ನ ಗೃಹ್ಯತಾಂ ತವ ಮಙ್ಗಲಂ ಭೂಯಾದಿತಿ ವಾಗಪಿ ತಸ್ಮೈ ನ ಕಥ್ಯತಾಂ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಯತಸ್ತವ ಮಙ್ಗಲಂ ಭೂಯಾದಿತಿ ವಾಚಂ ಯಃ ಕಶ್ಚಿತ್ ತಸ್ಮೈ ಕಥಯತಿ ಸ ತಸ್ಯ ದುಷ್ಕರ್ಮ್ಮಣಾಮ್ ಅಂಶೀ ಭವತಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯುಷ್ಮಾನ್ ಪ್ರತಿ ಮಯಾ ಬಹೂನಿ ಲೇಖಿತವ್ಯಾನಿ ಕಿನ್ತು ಪತ್ರಮಸೀಭ್ಯಾಂ ತತ್ ಕರ್ತ್ತುಂ ನೇಚ್ಛಾಮಿ, ಯತೋ ಽಸ್ಮಾಕಮ್ ಆನನ್ದೋ ಯಥಾ ಸಮ್ಪೂರ್ಣೋ ಭವಿಷ್ಯತಿ ತಥಾ ಯುಷ್ಮತ್ಸಮೀಪಮುಪಸ್ಥಾಯಾಹಂ ಸಮ್ಮುಖೀಭೂಯ ಯುಷ್ಮಾಭಿಃ ಸಮ್ಭಾಷಿಷ್ಯ ಇತಿ ಪ್ರತ್ಯಾಶಾ ಮಮಾಸ್ತೇ|</para>
  <para style="p">
    <verse number="13" style="v"/>ತವಾಭಿರುಚಿತಾಯಾ ಭಗಿನ್ಯಾ ಬಾಲಕಾಸ್ತ್ವಾಂ ನಮಸ್ಕಾರಂ ಜ್ಞಾಪಯನ್ತಿ| ಆಮೇನ್|</para>
</usx>
