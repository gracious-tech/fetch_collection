<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="2TI" style="id">Sanskrit Bible (NT) in Kannada Script (ಸತ್ಯವೇದಃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">2 Timothy</para>
  <para style="toc1">೨ ತೀಮಥಿಯಂ ಪತ್ರಂ</para>
  <para style="toc2">೨ ತೀಮಥಿಯಃ</para>
  <para style="toc3">೨ ತೀಮಥಿಯಃ</para>
  <para style="mt1">೨ ತೀಮಥಿಯಂ ಪತ್ರಂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಖ್ರೀಷ್ಟೇನ ಯೀಶುನಾ ಯಾ ಜೀವನಸ್ಯ ಪ್ರತಿಜ್ಞಾ ತಾಮಧೀಶ್ವರಸ್ಯೇಚ್ಛಯಾ ಯೀಶೋಃ ಖ್ರೀಷ್ಟಸ್ಯೈಕಃ ಪ್ರೇರಿತಃ ಪೌಲೋಽಹಂ ಸ್ವಕೀಯಂ ಪ್ರಿಯಂ ಧರ್ಮ್ಮಪುತ್ರಂ ತೀಮಥಿಯಂ ಪ್ರತಿ ಪತ್ರಂ ಲಿಖಾಮಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತಾತ ಈಶ್ವರೋಽಸ್ಮಾಕಂ ಪ್ರಭು ರ್ಯೀಶುಖ್ರೀಷ್ಟಶ್ಚ ತ್ವಯಿ ಪ್ರಸಾದಂ ದಯಾಂ ಶಾನ್ತಿಞ್ಚ ಕ್ರಿಯಾಸ್ತಾಂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಅಹಮ್ ಆ ಪೂರ್ವ್ವಪುರುಷಾತ್ ಯಮ್ ಈಶ್ವರಂ ಪವಿತ್ರಮನಸಾ ಸೇವೇ ತಂ ಧನ್ಯಂ ವದನಂ ಕಥಯಾಮಿ, ಅಹಮ್ ಅಹೋರಾತ್ರಂ ಪ್ರಾರ್ಥನಾಸಮಯೇ ತ್ವಾಂ ನಿರನ್ತರಂ ಸ್ಮರಾಮಿ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಯಶ್ಚ ವಿಶ್ವಾಸಃ ಪ್ರಥಮೇ ಲೋಯೀನಾಮಿಕಾಯಾಂ ತವ ಮಾತಾಮಹ್ಯಾಮ್ ಉನೀಕೀನಾಮಿಕಾಯಾಂ ಮಾತರಿ ಚಾತಿಷ್ಠತ್ ತವಾನ್ತರೇಽಪಿ ತಿಷ್ಠತೀತಿ ಮನ್ಯೇ</para>
  <para style="p">
    <verse number="5" style="v"/>ತವ ತಂ ನಿಷ್ಕಪಟಂ ವಿಶ್ವಾಸಂ ಮನಸಿ ಕುರ್ವ್ವನ್ ತವಾಶ್ರುಪಾತಂ ಸ್ಮರನ್ ಯಥಾನನ್ದೇನ ಪ್ರಫಲ್ಲೋ ಭವೇಯಂ ತದರ್ಥಂ ತವ ದರ್ಶನಮ್ ಆಕಾಙ್ಕ್ಷೇ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅತೋ ಹೇತೋ ರ್ಮಮ ಹಸ್ತಾರ್ಪಣೇನ ಲಬ್ಧೋ ಯ ಈಶ್ವರಸ್ಯ ವರಸ್ತ್ವಯಿ ವಿದ್ಯತೇ ತಮ್ ಉಜ್ಜ್ವಾಲಯಿತುಂ ತ್ವಾಂ ಸ್ಮಾರಯಾಮಿ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಯತ ಈಶ್ವರೋಽಸ್ಮಭ್ಯಂ ಭಯಜನಕಮ್ ಆತ್ಮಾನಮ್ ಅದತ್ತ್ವಾ ಶಕ್ತಿಪ್ರೇಮಸತರ್ಕತಾನಾಮ್ ಆಕರಮ್ ಆತ್ಮಾನಂ ದತ್ತವಾನ್|</para>
  <para style="p">
    <verse number="8" style="v"/>ಅತಏವಾಸ್ಮಾಕಂ ಪ್ರಭುಮಧಿ ತಸ್ಯ ವನ್ದಿದಾಸಂ ಮಾಮಧಿ ಚ ಪ್ರಮಾಣಂ ದಾತುಂ ನ ತ್ರಪಸ್ವ ಕಿನ್ತ್ವೀಶ್ವರೀಯಶಕ್ತ್ಯಾ ಸುಸಂವಾದಸ್ಯ ಕೃತೇ ದುಃಖಸ್ಯ ಸಹಭಾಗೀ ಭವ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಸೋಽಸ್ಮಾನ್ ಪರಿತ್ರಾಣಪಾತ್ರಾಣಿ ಕೃತವಾನ್ ಪವಿತ್ರೇಣಾಹ್ವಾನೇನಾಹೂತವಾಂಶ್ಚ; ಅಸ್ಮತ್ಕರ್ಮ್ಮಹೇತುನೇತಿ ನಹಿ ಸ್ವೀಯನಿರೂಪಾಣಸ್ಯ ಪ್ರಸಾದಸ್ಯ ಚ ಕೃತೇ ತತ್ ಕೃತವಾನ್| ಸ ಪ್ರಸಾದಃ ಸೃಷ್ಟೇಃ ಪೂರ್ವ್ವಕಾಲೇ ಖ್ರೀಷ್ಟೇನ ಯೀಶುನಾಸ್ಮಭ್ಯಮ್ ಅದಾಯಿ,</para>
  <para style="p">
    <verse number="10" style="v"/>ಕಿನ್ತ್ವಧುನಾಸ್ಮಾಕಂ ಪರಿತ್ರಾತು ರ್ಯೀಶೋಃ ಖ್ರೀಷ್ಟಸ್ಯಾಗಮನೇನ ಪ್ರಾಕಾಶತ| ಖ್ರೀಷ್ಟೋ ಮೃತ್ಯುಂ ಪರಾಜಿತವಾನ್ ಸುಸಂವಾದೇನ ಚ ಜೀವನಮ್ ಅಮರತಾಞ್ಚ ಪ್ರಕಾಶಿತವಾನ್|</para>
  <para style="p">
    <verse number="11" style="v"/>ತಸ್ಯ ಘೋಷಯಿತಾ ದೂತಶ್ಚಾನ್ಯಜಾತೀಯಾನಾಂ ಶಿಕ್ಷಕಶ್ಚಾಹಂ ನಿಯುಕ್ತೋಽಸ್ಮಿ|</para>
  <para style="p">
    <verse number="12" style="v"/>ತಸ್ಮಾತ್ ಕಾರಣಾತ್ ಮಮಾಯಂ ಕ್ಲೇಶೋ ಭವತಿ ತೇನ ಮಮ ಲಜ್ಜಾ ನ ಜಾಯತೇ ಯತೋಽಹಂ ಯಸ್ಮಿನ್ ವಿಶ್ವಸಿತವಾನ್ ತಮವಗತೋಽಸ್ಮಿ ಮಹಾದಿನಂ ಯಾವತ್ ಮಮೋಪನಿಧೇ ರ್ಗೋಪನಸ್ಯ ಶಕ್ತಿಸ್ತಸ್ಯ ವಿದ್ಯತ ಇತಿ ನಿಶ್ಚಿತಂ ಜಾನಾಮಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಹಿತದಾಯಕಾನಾಂ ವಾಕ್ಯಾನಾಮ್ ಆದರ್ಶರೂಪೇಣ ಮತ್ತಃ ಶ್ರುತಾಃ ಖ್ರೀಷ್ಟೇ ಯೀಶೌ ವಿಶ್ವಾಸಪ್ರೇಮ್ನೋಃ ಕಥಾ ಧಾರಯ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಅಪರಮ್ ಅಸ್ಮದನ್ತರ್ವಾಸಿನಾ ಪವಿತ್ರೇಣಾತ್ಮನಾ ತಾಮುತ್ತಮಾಮ್ ಉಪನಿಧಿಂ ಗೋಪಯ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಆಶಿಯಾದೇಶೀಯಾಃ ಸರ್ವ್ವೇ ಮಾಂ ತ್ಯಕ್ತವನ್ತ ಇತಿ ತ್ವಂ ಜಾನಾಸಿ ತೇಷಾಂ ಮಧ್ಯೇ ಫೂಗಿಲ್ಲೋ ಹರ್ಮ್ಮಗಿನಿಶ್ಚ ವಿದ್ಯೇತೇ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಪ್ರಭುರನೀಷಿಫರಸ್ಯ ಪರಿವಾರಾನ್ ಪ್ರತಿ ಕೃಪಾಂ ವಿದಧಾತು ಯತಃ ಸ ಪುನಃ ಪುನ ರ್ಮಾಮ್ ಆಪ್ಯಾಯಿತವಾನ್</para>
  <para style="p">
    <verse number="17" style="v"/>ಮಮ ಶೃಙ್ಖಲೇನ ನ ತ್ರಪಿತ್ವಾ ರೋಮಾನಗರೇ ಉಪಸ್ಥಿತಿಸಮಯೇ ಯತ್ನೇನ ಮಾಂ ಮೃಗಯಿತ್ವಾ ಮಮೋದ್ದೇಶಂ ಪ್ರಾಪ್ತವಾನ್|</para>
  <para style="p">
    <verse number="18" style="v"/>ಅತೋ ವಿಚಾರದಿನೇ ಸ ಯಥಾ ಪ್ರಭೋಃ ಕೃಪಾಭಾಜನಂ ಭವೇತ್ ತಾದೃಶಂ ವರಂ ಪ್ರಭುಸ್ತಸ್ಮೈ ದೇಯಾತ್| ಇಫಿಷನಗರೇಽಪಿ ಸ ಕತಿ ಪ್ರಕಾರೈ ರ್ಮಾಮ್ ಉಪಕೃತವಾನ್ ತತ್ ತ್ವಂ ಸಮ್ಯಗ್ ವೇತ್ಸಿ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಹೇ ಮಮ ಪುತ್ರ, ಖ್ರೀಷ್ಟಯೀಶುತೋ ಯೋಽನುಗ್ರಹಸ್ತಸ್ಯ ಬಲೇನ ತ್ವಂ ಬಲವಾನ್ ಭವ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಅಪರಂ ಬಹುಭಿಃ ಸಾಕ್ಷಿಭಿಃ ಪ್ರಮಾಣೀಕೃತಾಂ ಯಾಂ ಶಿಕ್ಷಾಂ ಶ್ರುತವಾನಸಿ ತಾಂ ವಿಶ್ವಾಸ್ಯೇಷು ಪರಸ್ಮೈ ಶಿಕ್ಷಾದಾನೇ ನಿಪುಣೇಷು ಚ ಲೋಕೇಷು ಸಮರ್ಪಯ|</para>
  <para style="p">
    <verse number="3" style="v"/>ತ್ವಂ ಯೀಶುಖ್ರೀಷ್ಟಸ್ಯೋತ್ತಮೋ ಯೋದ್ಧೇವ ಕ್ಲೇಶಂ ಸಹಸ್ವ|</para>
  <para style="p">
    <verse number="4" style="v"/>ಯೋ ಯುದ್ಧಂ ಕರೋತಿ ಸ ಸಾಂಸಾರಿಕೇ ವ್ಯಾಪಾರೇ ಮಗ್ನೋ ನ ಭವತಿ ಕಿನ್ತು ಸ್ವನಿಯೋಜಯಿತ್ರೇ ರೋಚಿತುಂ ಚೇಷ್ಟತೇ|</para>
  <para style="p">
    <verse number="5" style="v"/>ಅಪರಂ ಯೋ ಮಲ್ಲೈ ರ್ಯುಧ್ಯತಿ ಸ ಯದಿ ನಿಯಮಾನುಸಾರೇಣ ನ ಯುದ್ಧ್ಯತಿ ತರ್ಹಿ ಕಿರೀಟಂ ನ ಲಪ್ಸ್ಯತೇ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಅಪರಂ ಯಃ ಕೃಷೀವಲಃ ಕರ್ಮ್ಮ ಕರೋತಿ ತೇನ ಪ್ರಥಮೇನ ಫಲಭಾಗಿನಾ ಭವಿತವ್ಯಂ|</para>
  <para style="p">
    <verse number="7" style="v"/>ಮಯಾ ಯದುಚ್ಯತೇ ತತ್ ತ್ವಯಾ ಬುಧ್ಯತಾಂ ಯತಃ ಪ್ರಭುಸ್ತುಭ್ಯಂ ಸರ್ವ್ವತ್ರ ಬುದ್ಧಿಂ ದಾಸ್ಯತಿ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಮಮ ಸುಸಂವಾದಸ್ಯ ವಚನಾನುಸಾರಾದ್ ದಾಯೂದ್ವಂಶೀಯಂ ಮೃತಗಣಮಧ್ಯಾದ್ ಉತ್ಥಾಪಿತಞ್ಚ ಯೀಶುಂ ಖ್ರೀಷ್ಟಂ ಸ್ಮರ|</para>
  <para style="p">
    <verse number="9" style="v"/>ತತ್ಸುಸಂವಾದಕಾರಣಾದ್ ಅಹಂ ದುಷ್ಕರ್ಮ್ಮೇವ ಬನ್ಧನದಶಾಪರ್ಯ್ಯನ್ತಂ ಕ್ಲೇಶಂ ಭುಞ್ಜೇ ಕಿನ್ತ್ವೀಶ್ವರಸ್ಯ ವಾಕ್ಯಮ್ ಅಬದ್ಧಂ ತಿಷ್ಠತಿ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಖ್ರೀಷ್ಟೇನ ಯೀಶುನಾ ಯದ್ ಅನನ್ತಗೌರವಸಹಿತಂ ಪರಿತ್ರಾಣಂ ಜಾಯತೇ ತದಭಿರುಚಿತೈ ರ್ಲೋಕೈರಪಿ ಯತ್ ಲಭ್ಯೇತ ತದರ್ಥಮಹಂ ತೇಷಾಂ ನಿಮಿತ್ತಂ ಸರ್ವ್ವಾಣ್ಯೇತಾನಿ ಸಹೇ|</para>
  <para style="p">
    <verse number="11" style="v"/>ಅಪರಮ್ ಏಷಾ ಭಾರತೀ ಸತ್ಯಾ ಯದಿ ವಯಂ ತೇನ ಸಾರ್ದ್ಧಂ ಮ್ರಿಯಾಮಹೇ ತರ್ಹಿ ತೇನ ಸಾರ್ದ್ಧಂ ಜೀವಿವ್ಯಾಮಃ, ಯದಿ ಚ ಕ್ಲೇಶಂ ಸಹಾಮಹೇ ತರ್ಹಿ ತೇನ ಸಾರ್ದ್ಧಂ ರಾಜತ್ವಮಪಿ ಕರಿಷ್ಯಾಮಹೇ|</para>
  <para style="p">
    <verse number="12" style="v"/>ಯದಿ ವಯಂ ತಮ್ ಅನಙ್ಗೀಕುರ್ಮ್ಮಸ್ತರ್ಹಿ ಸೋ ಽಸ್ಮಾನಪ್ಯನಙ್ಗೀಕರಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯದಿ ವಯಂ ನ ವಿಶ್ವಾಸಾಮಸ್ತರ್ಹಿ ಸ ವಿಶ್ವಾಸ್ಯಸ್ತಿಷ್ಠತಿ ಯತಃ ಸ್ವಮ್ ಅಪಹ್ನೋತುಂ ನ ಶಕ್ನೋತಿ|</para>
  <para style="p">
    <verse number="14" style="v"/>ತ್ವಮೇತಾನಿ ಸ್ಮಾರಯನ್ ತೇ ಯಥಾ ನಿಷ್ಫಲಂ ಶ್ರೋತೃಣಾಂ ಭ್ರಂಶಜನಕಂ ವಾಗ್ಯುದ್ಧಂ ನ ಕುರ್ಯ್ಯಸ್ತಥಾ ಪ್ರಭೋಃ ಸಮಕ್ಷಂ ದೃಢಂ ವಿನೀಯಾದಿಶ|</para>
  <para style="p">
    <verse number="15" style="v"/>ಅಪರಂ ತ್ವಮ್ ಈಶ್ವರಸ್ಯ ಸಾಕ್ಷಾತ್ ಸ್ವಂ ಪರೀಕ್ಷಿತಮ್ ಅನಿನ್ದನೀಯಕರ್ಮ್ಮಕಾರಿಣಞ್ಚ ಸತ್ಯಮತಸ್ಯ ವಾಕ್ಯಾನಾಂ ಸದ್ವಿಭಜನೇ ನಿಪುಣಞ್ಚ ದರ್ಶಯಿತುಂ ಯತಸ್ವ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಕಿನ್ತ್ವಪವಿತ್ರಾ ಅನರ್ಥಕಕಥಾ ದೂರೀಕುರು ಯತಸ್ತದಾಲಮ್ಬಿನ ಉತ್ತರೋತ್ತರಮ್ ಅಧರ್ಮ್ಮೇ ವರ್ದ್ಧಿಷ್ಯನ್ತೇ,</para>
  <para style="p">
    <verse number="17" style="v"/>ತೇಷಾಞ್ಚ ವಾಕ್ಯಂ ಗಲಿತಕ್ಷತವತ್ ಕ್ಷಯವರ್ದ್ಧಕೋ ಭವಿಷ್ಯತಿ ತೇಷಾಂ ಮಧ್ಯೇ ಹುಮಿನಾಯಃ ಫಿಲೀತಶ್ಚೇತಿನಾಮಾನೌ ದ್ವೌ ಜನೌ ಸತ್ಯಮತಾದ್ ಭ್ರಷ್ಟೌ ಜಾತೌ,</para>
  <para style="p">
    <verse number="18" style="v"/>ಮೃತಾನಾಂ ಪುನರುತ್ಥಿತಿ ರ್ವ್ಯತೀತೇತಿ ವದನ್ತೌ ಕೇಷಾಞ್ಚಿದ್ ವಿಶ್ವಾಸಮ್ ಉತ್ಪಾಟಯತಶ್ಚ|</para>
  <para style="p">
    <verse number="19" style="v"/>ತಥಾಪೀಶ್ವರಸ್ಯ ಭಿತ್ತಿಮೂಲಮ್ ಅಚಲಂ ತಿಷ್ಠತಿ ತಸ್ಮಿಂಶ್ಚೇಯಂ ಲಿಪಿ ರ್ಮುದ್ರಾಙ್ಕಿತಾ ವಿದ್ಯತೇ| ಯಥಾ, ಜಾನಾತಿ ಪರಮೇಶಸ್ತು ಸ್ವಕೀಯಾನ್ ಸರ್ವ್ವಮಾನವಾನ್| ಅಪಗಚ್ಛೇದ್ ಅಧರ್ಮ್ಮಾಚ್ಚ ಯಃ ಕಶ್ಚಿತ್ ಖ್ರೀಷ್ಟನಾಮಕೃತ್||</para>
  <para style="p">
    <verse number="20" style="v"/>ಕಿನ್ತು ಬೃಹನ್ನಿಕೇತನೇ ಕೇವಲ ಸುವರ್ಣಮಯಾನಿ ರೌಪ್ಯಮಯಾಣಿ ಚ ಭಾಜನಾನಿ ವಿದ್ಯನ್ತ ಇತಿ ತರ್ಹಿ ಕಾಷ್ಠಮಯಾನಿ ಮೃಣ್ಮಯಾನ್ಯಪಿ ವಿದ್ಯನ್ತೇ ತೇಷಾಞ್ಚ ಕಿಯನ್ತಿ ಸಮ್ಮಾನಾಯ ಕಿಯನ್ತಪಮಾನಾಯ ಚ ಭವನ್ತಿ|</para>
  <para style="p">
    <verse number="21" style="v"/>ಅತೋ ಯದಿ ಕಶ್ಚಿದ್ ಏತಾದೃಶೇಭ್ಯಃ ಸ್ವಂ ಪರಿಷ್ಕರೋತಿ ತರ್ಹಿ ಸ ಪಾವಿತಂ ಪ್ರಭೋಃ ಕಾರ್ಯ್ಯಯೋಗ್ಯಂ ಸರ್ವ್ವಸತ್ಕಾರ್ಯ್ಯಾಯೋಪಯುಕ್ತಂ ಸಮ್ಮಾನಾರ್ಥಕಞ್ಚ ಭಾಜನಂ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಯೌವನಾವಸ್ಥಾಯಾ ಅಭಿಲಾಷಾಸ್ತ್ವಯಾ ಪರಿತ್ಯಜ್ಯನ್ತಾಂ ಧರ್ಮ್ಮೋ ವಿಶ್ವಾಸಃ ಪ್ರೇಮ ಯೇ ಚ ಶುಚಿಮನೋಭಿಃ ಪ್ರಭುಮ್ ಉದ್ದಿಶ್ಯ ಪ್ರಾರ್ಥನಾಂ ಕುರ್ವ್ವತೇ ತೈಃ ಸಾರ್ದ್ಧಮ್ ಐಕ್ಯಭಾವಶ್ಚೈತೇಷು ತ್ವಯಾ ಯತ್ನೋ ವಿಧೀಯತಾಂ|</para>
  <para style="p">
    <verse number="23" style="v"/>ಅಪರಂ ತ್ವಮ್ ಅನರ್ಥಕಾನ್ ಅಜ್ಞಾನಾಂಶ್ಚ ಪ್ರಶ್ನಾನ್ ವಾಗ್ಯುದ್ಧೋತ್ಪಾದಕಾನ್ ಜ್ಞಾತ್ವಾ ದೂರೀಕುರು|</para>
  <para style="p">
    <verse number="24" style="v"/>ಯತಃ ಪ್ರಭೋ ರ್ದಾಸೇನ ಯುದ್ಧಮ್ ಅಕರ್ತ್ತವ್ಯಂ ಕಿನ್ತು ಸರ್ವ್ವಾನ್ ಪ್ರತಿ ಶಾನ್ತೇನ ಶಿಕ್ಷಾದಾನೇಚ್ಛುಕೇನ ಸಹಿಷ್ಣುನಾ ಚ ಭವಿತವ್ಯಂ, ವಿಪಕ್ಷಾಶ್ಚ ತೇನ ನಮ್ರತ್ವೇನ ಚೇತಿತವ್ಯಾಃ|</para>
  <para style="p">
    <verse number="25" style="v"/>ತಥಾ ಕೃತೇ ಯದೀಶ್ವರಃ ಸತ್ಯಮತಸ್ಯ ಜ್ಞಾನಾರ್ಥಂ ತೇಭ್ಯೋ ಮನಃಪರಿವರ್ತ್ತನರೂಪಂ ವರಂ ದದ್ಯಾತ್,</para>
  <para style="p">
    <verse number="26" style="v"/>ತರ್ಹಿ ತೇ ಯೇನ ಶಯತಾನೇನ ನಿಜಾಭಿಲಾಷಸಾಧನಾಯ ಧೃತಾಸ್ತಸ್ಯ ಜಾಲಾತ್ ಚೇತನಾಂ ಪ್ರಾಪ್ಯೋದ್ಧಾರಂ ಲಬ್ಧುಂ ಶಕ್ಷ್ಯನ್ತಿ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಚರಮದಿನೇಷು ಕ್ಲೇಶಜನಕಾಃ ಸಮಯಾ ಉಪಸ್ಥಾಸ್ಯನ್ತೀತಿ ಜಾನೀಹಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ಯತಸ್ತಾತ್ಕಾಲಿಕಾ ಲೋಕಾ ಆತ್ಮಪ್ರೇಮಿಣೋ ಽರ್ಥಪ್ರೇಮಿಣ ಆತ್ಮಶ್ಲಾಘಿನೋ ಽಭಿಮಾನಿನೋ ನಿನ್ದಕಾಃ ಪಿತ್ರೋರನಾಜ್ಞಾಗ್ರಾಹಿಣಃ ಕೃತಘ್ನಾ ಅಪವಿತ್ರಾಃ</para>
  <para style="p">
    <verse number="3" style="v"/>ಪ್ರೀತಿವರ್ಜಿತಾ ಅಸನ್ಧೇಯಾ ಮೃಷಾಪವಾದಿನೋ ಽಜಿತೇನ್ದ್ರಿಯಾಃ ಪ್ರಚಣ್ಡಾ ಭದ್ರದ್ವೇಷಿಣೋ</para>
  <para style="p">
    <verse number="4" style="v"/>ವಿಶ್ವಾಸಘಾತಕಾ ದುಃಸಾಹಸಿನೋ ದರ್ಪಧ್ಮಾತಾ ಈಶ್ವರಾಪ್ರೇಮಿಣಃ ಕಿನ್ತು ಸುಖಪ್ರೇಮಿಣೋ</para>
  <para style="p">
    <verse number="5" style="v"/>ಭಕ್ತವೇಶಾಃ ಕಿನ್ತ್ವಸ್ವೀಕೃತಭಕ್ತಿಗುಣಾ ಭವಿಷ್ಯನ್ತಿ; ಏತಾದೃಶಾನಾಂ ಲೋಕಾನಾಂ ಸಂಮರ್ಗಂ ಪರಿತ್ಯಜ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಯತೋ ಯೇ ಜನಾಃ ಪ್ರಚ್ಛನ್ನಂ ಗೇಹಾನ್ ಪ್ರವಿಶನ್ತಿ ಪಾಪೈ ರ್ಭಾರಗ್ರಸ್ತಾ ನಾನಾವಿಧಾಭಿಲಾಷೈಶ್ಚಾಲಿತಾ ಯಾಃ ಕಾಮಿನ್ಯೋ</para>
  <para style="p">
    <verse number="7" style="v"/>ನಿತ್ಯಂ ಶಿಕ್ಷನ್ತೇ ಕಿನ್ತು ಸತ್ಯಮತಸ್ಯ ತತ್ತ್ವಜ್ಞಾನಂ ಪ್ರಾಪ್ತುಂ ಕದಾಚಿತ್ ನ ಶಕ್ನುವನ್ತಿ ತಾ ದಾಸೀವದ್ ವಶೀಕುರ್ವ್ವತೇ ಚ ತೇ ತಾದೃಶಾ ಲೋಕಾಃ|</para>
  <para style="p">
    <verse number="8" style="v"/>ಯಾನ್ನಿ ರ್ಯಾಮ್ಬ್ರಿಶ್ಚ ಯಥಾ ಮೂಸಮಂ ಪ್ರತಿ ವಿಪಕ್ಷತ್ವಮ್ ಅಕುರುತಾಂ ತಥೈವ ಭ್ರಷ್ಟಮನಸೋ ವಿಶ್ವಾಸವಿಷಯೇ ಽಗ್ರಾಹ್ಯಾಶ್ಚೈತೇ ಲೋಕಾ ಅಪಿ ಸತ್ಯಮತಂ ಪ್ರತಿ ವಿಪಕ್ಷತಾಂ ಕುರ್ವ್ವನ್ತಿ|</para>
  <para style="p">
    <verse number="9" style="v"/>ಕಿನ್ತು ತೇ ಬಹುದೂರಮ್ ಅಗ್ರಸರಾ ನ ಭವಿಷ್ಯನ್ತಿ ಯತಸ್ತಯೋ ರ್ಮೂಢತಾ ಯದ್ವತ್ ತದ್ವದ್ ಏತೇಷಾಮಪಿ ಮೂಢತಾ ಸರ್ವ್ವದೃಶ್ಯಾ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="10" style="v"/>ಮಮೋಪದೇಶಃ ಶಿಷ್ಟತಾಭಿಪ್ರಾಯೋ ವಿಶ್ವಾಸೋ ರ್ಧರ್ಯ್ಯಂ ಪ್ರೇಮ ಸಹಿಷ್ಣುತೋಪದ್ರವಃ ಕ್ಲೇಶಾ</para>
  <para style="p">
    <verse number="11" style="v"/>ಆನ್ತಿಯಖಿಯಾಯಾಮ್ ಇಕನಿಯೇ ಲೂಸ್ತ್ರಾಯಾಞ್ಚ ಮಾಂ ಪ್ರತಿ ಯದ್ಯದ್ ಅಘಟತ ಯಾಂಶ್ಚೋಪದ್ರವಾನ್ ಅಹಮ್ ಅಸಹೇ ಸರ್ವ್ವಮೇತತ್ ತ್ವಮ್ ಅವಗತೋಽಸಿ ಕಿನ್ತು ತತ್ಸರ್ವ್ವತಃ ಪ್ರಭು ರ್ಮಾಮ್ ಉದ್ಧೃತವಾನ್|</para>
  <para style="p">
    <verse number="12" style="v"/>ಪರನ್ತು ಯಾವನ್ತೋ ಲೋಕಾಃ ಖ್ರೀಷ್ಟೇನ ಯೀಶುನೇಶ್ವರಭಕ್ತಿಮ್ ಆಚರಿತುಮ್ ಇಚ್ಛನ್ತಿ ತೇಷಾಂ ಸರ್ವ್ವೇಷಾಮ್ ಉಪದ್ರವೋ ಭವಿಷ್ಯತಿ|</para>
  <para style="p">
    <verse number="13" style="v"/>ಅಪರಂ ಪಾಪಿಷ್ಠಾಃ ಖಲಾಶ್ಚ ಲೋಕಾ ಭ್ರಾಮ್ಯನ್ತೋ ಭ್ರಮಯನ್ತಶ್ಚೋತ್ತರೋತ್ತರಂ ದುಷ್ಟತ್ವೇನ ವರ್ದ್ಧಿಷ್ಯನ್ತೇ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಕಿನ್ತು ತ್ವಂ ಯದ್ ಯದ್ ಅಶಿಕ್ಷಥಾಃ, ಯಚ್ಚ ತ್ವಯಿ ಸಮರ್ಪಿತಮ್ ಅಭೂತ್ ತಸ್ಮಿನ್ ಅವತಿಷ್ಠ, ಯತಃ ಕಸ್ಮಾತ್ ಶಿಕ್ಷಾಂ ಪ್ರಾಪ್ತೋಽಸಿ ತದ್ ವೇತ್ಸಿ;</para>
  <para style="p">
    <verse number="15" style="v"/>ಯಾನಿ ಚ ಧರ್ಮ್ಮಶಾಸ್ತ್ರಾಣಿ ಖ್ರೀಷ್ಟೇ ಯೀಶೌ ವಿಶ್ವಾಸೇನ ಪರಿತ್ರಾಣಪ್ರಾಪ್ತಯೇ ತ್ವಾಂ ಜ್ಞಾನಿನಂ ಕರ್ತ್ತುಂ ಶಕ್ನುವನ್ತಿ ತಾನಿ ತ್ವಂ ಶೈಶವಕಾಲಾದ್ ಅವಗತೋಽಸಿ|</para>
  <para style="p">
    <verse number="16" style="v"/>ತತ್ ಸರ್ವ್ವಂ ಶಾಸ್ತ್ರಮ್ ಈಶ್ವರಸ್ಯಾತ್ಮನಾ ದತ್ತಂ ಶಿಕ್ಷಾಯೈ ದೋಷಬೋಧಾಯ ಶೋಧನಾಯ ಧರ್ಮ್ಮವಿನಯಾಯ ಚ ಫಲಯೂಕ್ತಂ ಭವತಿ</para>
  <para style="p">
    <verse number="17" style="v"/>ತೇನ ಚೇಶ್ವರಸ್ಯ ಲೋಕೋ ನಿಪುಣಃ ಸರ್ವ್ವಸ್ಮೈ ಸತ್ಕರ್ಮ್ಮಣೇ ಸುಸಜ್ಜಶ್ಚ ಭವತಿ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ಈಶ್ವರಸ್ಯ ಗೋಚರೇ ಯಶ್ಚ ಯೀಶುಃ ಖ್ರೀಷ್ಟಃ ಸ್ವೀಯಾಗಮನಕಾಲೇ ಸ್ವರಾಜತ್ವೇನ ಜೀವತಾಂ ಮೃತಾನಾಞ್ಚ ಲೋಕಾನಾಂ ವಿಚಾರಂ ಕರಿಷ್ಯತಿ ತಸ್ಯ ಗೋಚರೇ ಽಹಂ ತ್ವಾಮ್ ಇದಂ ದೃಢಮ್ ಆಜ್ಞಾಪಯಾಮಿ|</para>
  <para style="p">
    <verse number="2" style="v"/>ತ್ವಂ ವಾಕ್ಯಂ ಘೋಷಯ ಕಾಲೇಽಕಾಲೇ ಚೋತ್ಸುಕೋ ಭವ ಪೂರ್ಣಯಾ ಸಹಿಷ್ಣುತಯಾ ಶಿಕ್ಷಯಾ ಚ ಲೋಕಾನ್ ಪ್ರಬೋಧಯ ಭರ್ತ್ಸಯ ವಿನಯಸ್ವ ಚ|</para>
  <para style="p">
    <verse number="3" style="v"/>ಯತ ಏತಾದೃಶಃ ಸಮಯ ಆಯಾತಿ ಯಸ್ಮಿನ್ ಲೋಕಾ ಯಥಾರ್ಥಮ್ ಉಪದೇಶಮ್ ಅಸಹ್ಯಮಾನಾಃ ಕರ್ಣಕಣ್ಡೂಯನವಿಶಿಷ್ಟಾ ಭೂತ್ವಾ ನಿಜಾಭಿಲಾಷಾತ್ ಶಿಕ್ಷಕಾನ್ ಸಂಗ್ರಹೀಷ್ಯನ್ತಿ</para>
  <para style="p">
    <verse number="4" style="v"/>ಸತ್ಯಮತಾಚ್ಚ ಶ್ರೋತ್ರಾಣಿ ನಿವರ್ತ್ತ್ಯ ವಿಪಥಗಾಮಿನೋ ಭೂತ್ವೋಪಾಖ್ಯಾನೇಷು ಪ್ರವರ್ತ್ತಿಷ್ಯನ್ತೇ;</para>
  <para style="p">
    <verse number="5" style="v"/>ಕಿನ್ತು ತ್ವಂ ಸರ್ವ್ವವಿಷಯೇ ಪ್ರಬುದ್ಧೋ ಭವ ದುಃಖಭೋಗಂ ಸ್ವೀಕುರು ಸುಸಂವಾದಪ್ರಚಾರಕಸ್ಯ ಕರ್ಮ್ಮ ಸಾಧಯ ನಿಜಪರಿಚರ್ಯ್ಯಾಂ ಪೂರ್ಣತ್ವೇನ ಕುರು ಚ|</para>
  <para style="p">
    <verse number="6" style="v"/>ಮಮ ಪ್ರಾಣಾನಾಮ್ ಉತ್ಸರ್ಗೋ ಭವತಿ ಮಮ ಪ್ರಸ್ಥಾನಕಾಲಶ್ಚೋಪಾತಿಷ್ಠತ್|</para>
  <para style="p">
    <verse number="7" style="v"/>ಅಹಮ್ ಉತ್ತಮಯುದ್ಧಂ ಕೃತವಾನ್ ಗನ್ತವ್ಯಮಾರ್ಗಸ್ಯಾನ್ತಂ ಯಾವದ್ ಧಾವಿತವಾನ್ ವಿಶ್ವಾಸಞ್ಚ ರಕ್ಷಿತವಾನ್|</para>
  <para style="p">
    <verse number="8" style="v"/>ಶೇಷಂ ಪುಣ್ಯಮುಕುಟಂ ಮದರ್ಥಂ ರಕ್ಷಿತಂ ವಿದ್ಯತೇ ತಚ್ಚ ತಸ್ಮಿನ್ ಮಹಾದಿನೇ ಯಥಾರ್ಥವಿಚಾರಕೇಣ ಪ್ರಭುನಾ ಮಹ್ಯಂ ದಾಯಿಷ್ಯತೇ ಕೇವಲಂ ಮಹ್ಯಮ್ ಇತಿ ನಹಿ ಕಿನ್ತು ಯಾವನ್ತೋ ಲೋಕಾಸ್ತಸ್ಯಾಗಮನಮ್ ಆಕಾಙ್ಕ್ಷನ್ತೇ ತೇಭ್ಯಃ ಸರ್ವ್ವೇಭ್ಯೋ ಽಪಿ ದಾಯಿಷ್ಯತೇ|</para>
  <para style="p">
    <verse number="9" style="v"/>ತ್ವಂ ತ್ವರಯಾ ಮತ್ಸಮೀಪಮ್ ಆಗನ್ತುಂ ಯತಸ್ವ,</para>
  <para style="p">
    <verse number="10" style="v"/>ಯತೋ ದೀಮಾ ಐಹಿಕಸಂಸಾರಮ್ ಈಹಮಾನೋ ಮಾಂ ಪರಿತ್ಯಜ್ಯ ಥಿಷಲನೀಕೀಂ ಗತವಾನ್ ತಥಾ ಕ್ರೀಷ್ಕಿ ರ್ಗಾಲಾತಿಯಾಂ ಗತವಾನ್ ತೀತಶ್ಚ ದಾಲ್ಮಾತಿಯಾಂ ಗತವಾನ್|</para>
  <para style="p">
    <verse number="11" style="v"/>ಕೇವಲೋ ಲೂಕೋ ಮಯಾ ಸಾರ್ದ್ಧಂ ವಿದ್ಯತೇ| ತ್ವಂ ಮಾರ್ಕಂ ಸಙ್ಗಿನಂ ಕೃತ್ವಾಗಚ್ಛ ಯತಃ ಸ ಪರಿಚರ್ಯ್ಯಯಾ ಮಮೋಪಕಾರೀ ಭವಿಷ್ಯತಿ,</para>
  <para style="p">
    <verse number="12" style="v"/>ತುಖಿಕಞ್ಚಾಹಮ್ ಇಫಿಷನಗರಂ ಪ್ರೇಷಿತವಾನ್|</para>
  <para style="p">
    <verse number="13" style="v"/>ಯದ್ ಆಚ್ಛಾದನವಸ್ತ್ರಂ ತ್ರೋಯಾನಗರೇ ಕಾರ್ಪಸ್ಯ ಸನ್ನಿಧೌ ಮಯಾ ನಿಕ್ಷಿಪ್ತಂ ತ್ವಮಾಗಮನಸಮಯೇ ತತ್ ಪುಸ್ತಕಾನಿ ಚ ವಿಶೇಷತಶ್ಚರ್ಮ್ಮಗ್ರನ್ಥಾನ್ ಆನಯ|</para>
  <para style="p">
    <verse number="14" style="v"/>ಕಾಂಸ್ಯಕಾರಃ ಸಿಕನ್ದರೋ ಮಮ ಬಹ್ವನಿಷ್ಟಂ ಕೃತವಾನ್ ಪ್ರಭುಸ್ತಸ್ಯ ಕರ್ಮ್ಮಣಾಂ ಸಮುಚಿತಫಲಂ ದದಾತು|</para>
  <para style="p">
    <verse number="15" style="v"/>ತ್ವಮಪಿ ತಸ್ಮಾತ್ ಸಾವಧಾನಾಸ್ತಿಷ್ಠ ಯತಃ ಸೋಽಸ್ಮಾಕಂ ವಾಕ್ಯಾನಾಮ್ ಅತೀವ ವಿಪಕ್ಷೋ ಜಾತಃ|</para>
  <para style="p">
    <verse number="16" style="v"/>ಮಮ ಪ್ರಥಮಪ್ರತ್ಯುತ್ತರಸಮಯೇ ಕೋಽಪಿ ಮಮ ಸಹಾಯೋ ನಾಭವತ್ ಸರ್ವ್ವೇ ಮಾಂ ಪರ್ಯ್ಯತ್ಯಜನ್ ತಾನ್ ಪ್ರತಿ ತಸ್ಯ ದೋಷಸ್ಯ ಗಣನಾ ನ ಭೂಯಾತ್;</para>
  <para style="p">
    <verse number="17" style="v"/>ಕಿನ್ತು ಪ್ರಭು ರ್ಮಮ ಸಹಾಯೋ ಽಭವತ್ ಯಥಾ ಚ ಮಯಾ ಘೋಷಣಾ ಸಾಧ್ಯೇತ ಭಿನ್ನಜಾತೀಯಾಶ್ಚ ಸರ್ವ್ವೇ ಸುಸಂವಾದಂ ಶೃಣುಯುಸ್ತಥಾ ಮಹ್ಯಂ ಶಕ್ತಿಮ್ ಅದದಾತ್ ತತೋ ಽಹಂ ಸಿಂಹಸ್ಯ ಮುಖಾದ್ ಉದ್ಧೃತಃ|</para>
  <para style="p">
    <verse number="18" style="v"/>ಅಪರಂ ಸರ್ವ್ವಸ್ಮಾದ್ ದುಷ್ಕರ್ಮ್ಮತಃ ಪ್ರಭು ರ್ಮಾಮ್ ಉದ್ಧರಿಷ್ಯತಿ ನಿಜಸ್ವರ್ಗೀಯರಾಜ್ಯಂ ನೇತುಂ ಮಾಂ ತಾರಯಿಷ್ಯತಿ ಚ| ತಸ್ಯ ಧನ್ಯವಾದಃ ಸದಾಕಾಲಂ ಭೂಯಾತ್| ಆಮೇನ್|</para>
  <para style="p">
    <verse number="19" style="v"/>ತ್ವಂ ಪ್ರಿಷ್ಕಾಮ್ ಆಕ್ಕಿಲಮ್ ಅನೀಷಿಫರಸ್ಯ ಪರಿಜನಾಂಶ್ಚ ನಮಸ್ಕುರು|</para>
  <para style="p">
    <verse number="20" style="v"/>ಇರಾಸ್ತಃ ಕರಿನ್ಥನಗರೇ ಽತಿಷ್ಠತ್ ತ್ರಫಿಮಶ್ಚ ಪೀಡಿತತ್ವಾತ್ ಮಿಲೀತನಗರೇ ಮಯಾ ವ್ಯಹೀಯತ|</para>
  <para style="p">
    <verse number="21" style="v"/>ತ್ವಂ ಹೇಮನ್ತಕಾಲಾತ್ ಪೂರ್ವ್ವಮ್ ಆಗನ್ತುಂ ಯತಸ್ವ| ಉಬೂಲಃ ಪೂದಿ ರ್ಲೀನಃ ಕ್ಲೌದಿಯಾ ಸರ್ವ್ವೇ ಭ್ರಾತರಶ್ಚ ತ್ವಾಂ ನಮಸ್ಕುರ್ವ್ವತೇ|</para>
  <para style="p">
    <verse number="22" style="v"/>ಪ್ರಭು ರ್ಯೀಶುಃ ಖ್ರೀಷ್ಟಸ್ತವಾತ್ಮನಾ ಸಹ ಭೂಯಾತ್| ಯುಷ್ಮಾಸ್ವನುಗ್ರಹೋ ಭೂಯಾತ್| ಆಮೇನ್|</para>
</usx>
