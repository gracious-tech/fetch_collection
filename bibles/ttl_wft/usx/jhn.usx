<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">TO43.SFM15/10/2022 DM TOTELA FIRST DRAFT SENANGA ZAMBIA.</book>
  <para style="h">JOANI</para>
  <para style="toc1">Amajwi Malotu aga naga ng’ola Joani</para>
  <para style="toc2">Joani</para>
  <para style="toc3">Jn</para>
  <para style="mt2">Amajwi Malotu aga naga ng’ola</para>
  <para style="mt1">Joani</para>
  <para style="imt">INZIBAAZO</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">Ijwi nalya tendigwa umuntu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />Mi ko kalili ijwi ku matatikilo, mi ijwi kwa Nyambe kalili, kame Ijwi kalili Nyambe. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />Cwale ku matatikilo ijwi kalili kwa Nyambe. <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />Cwale kaje bintu byonse nabya bumbigwa, mi ati tali neje, takuli cintu naca bumbigwa ici cabumbigwi. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />Cwale bumi kabuli kwakwe, mi bobo ubumi kabuli ituba lyo muntu. <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />Mi ituba kame libega mwififi, mi ififi taa na lya koma ituba.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />Kokali unkosi naga tumigwa kwa Nyambe gwe zina lya Joani. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />Ici naga kezela Joani bumpaki, kuti apake bye tuba, buti abantu bonse bazumine kakwe. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />Ije wawa taa kali ituba, bulyo naga keza kupaka bye tuba. <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />Leli kalili ituba lya cote, ituba ili nalya keza mulonga no ku munikila umuntu gense.<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />Ijwi mwilonga kali kele, kono kakwe Nyambe naga bumba ilonga, mi ilonga taa na lya muzekelela. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />Ku muntu gwakwe naga keza, kono abantu bakwe taa naba mutambula. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />Kono kwa babo bonse naba mutambula, aba naba zumina mwi zina lyakwe, naga bawa inguzu kuba bana Nyambe, <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />taa nababa bana Nyambe mukuzaligwa ko muntu, kampa mukuzaligwa ko nyama, kampa mumu gajalo go nkosi, kono ku kuzaligwa kwa Nyambe.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />Mi Ijwi kale lya tendigwa umuntu, mi kale ga keza ku jaka kwetu. Natwa bona ubunene bwakwe, bunene bwa jojo ne Mwana bulyo, uju naga zwa kwa Tata, ka bumbite inkumbu na cote.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />Joani kapaka byakwe, mi kale akugiliza natyo buti, “Nije joju kani sukulula byakwe aa kani tyo buti, ‘Uju ani keza mwishule ala niita ukuti no mutanzi kwangu.’ ”<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />Ko inkumbu cakwe icinene, naga tuwa imfwijaguzi ji kambikila amfwijaguzi natwa tambula. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Ukuti umulao nagwa wegwa ka Mushe, inkumbu na cote nabya keza ka Jesu Kilesite. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />Takuli umuntu nanag genke uju naga bona Nyambe, bwita Mwane bulyo genke uju akele naje, neje naga tubikulwila byakwe byonse, neje naga muzibaaza.<verse eid="JHN 1:18" /></para>
  <para style="s">Ubumpaki bwa Joani Mukolobezi</para>
  <para style="r">(<ref loc="MAT 3">Mateu3</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Mi bobu bo bumpaki bwa Joani, Amajuda aba kabali mwa Jelusalema kale batuma Mapulisita no Malivi keza kubuza Joani buti, “Nigweni?”<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />Joani taa na gakana ukubataba, kono kale ga gamba akancenene buti, “Taali nime Kelesite.”<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />Mi kale bamu buza buti, “Nigweni?” “Nigwe Eliya?” “Joani kale gabe taba buti,</para>
  <para style="p" vid="JHN 1:21">“Tali nime.”</para>
  <para style="p" vid="JHN 1:21">“Kale bamu buza buti, “Nigwe muboni?”</para>
  <para style="p" vid="JHN 1:21">Kale abetaba buti, “Tali nime.”<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />Mi kale batyo kwakwe buti, “Cwale nigweni?” Utuwe inkalabo jo kubogoza kwaba balatutumi. Buti ulitela buti ni gweni?”<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />Joani kale gabe taba muku gamba amajwi go muboni Isaya,</para>
  <para style="q1" vid="JHN 1:23">“Nime ijwi lya jojo akugiliza mu mangusu,</para>
  <para style="q2" vid="JHN 1:23">Mugolole inzila jo Mfumu!’”<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Mi Amafalisi aba naba tumigwa, <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />mi kale ba buza Joani buti, “Ati tali nigwe Mesiya kampa Eliya kampa umuboni, cwale cinzi aa ukolobeza?”<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />Joani kale gabe taba buti, “Ko menzi ni kolobeza, kono mukati kenu kuli zimene (umuntu) uju tamu zekelele. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />Nije akeza mwishule lyangu, tanigoli uku shumununa utugozi to nshangu jakwe.”<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />Byebi byonse naza tendaandala mu munzi gwa Betenia, mwi silya lyo lwizi lwa Jodani, momo Joani umu kakolobeza.<verse eid="JHN 1:28" /></para>
  <para style="s1">Ingugana ja Nyambe</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Ijuba nalya nungako, Joani kale ga bona Jesu na keza kwakwe, no kutyo buti, “Jilya ne Ngugana ja Nyambe, iji jiinda ibitendantu ibimangoju bye longa! <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Neje uju kani gamba byakwe aa kani tyo buti, ‘Mukwame alakeza mwishule lyangu, kono munene kwangu, ukuti kokali uku nanisini kuzaligwa.’ <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Ime wawa ni cote taa kani muzekelele, mpaa kani kolobeza ko menzi, mukuta buti abikuluke ku bantu ba Isilaele.”<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />Mi Joani kapaka buti, “Nana bona Umoya guzwa kwigulu gu sezumuka go kukoza sinagwe nu nziba no kutula kwakwe. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Cwale ime ni cote taa kani muzekelele, kono Nyambe uju naa nituma keza ku mukolobeza ko menzi, neje naa ni lugwila buti, ‘Mukwame uju no bone na sezumukilwa ku Moya, no kukala kwakwe, neje uju na kolobeze ko Moya go Kucena.’ <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Nana bona no kuwa bumpaki buti joju no Mwana Nyambe.”<verse eid="JHN 1:34" /></para>
  <para style="s1">Abazigigwa be Tanzi ba Jesu</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Ijuba nalya nungako, Joani kakele kame na bazigigwa bakwe bobile, <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />Aa naga bona Jesu naita, kale gatyo buti, “Ngamulole Ingugana ja Nyambe!”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />Babo bazigigwa bobile aa bashugwa bobo, kale ba umpilila Jesu. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />Jesu aa lola mwishule, kale ga bona buti kame ka ba muumpilile, kale gatyo kwabo buti, “Cinzi mushaka?”</para>
  <para style="p" vid="JHN 1:38">Kale bamutaba buti, “Labbi” (Aa kutaluswa Muzigi) Uku ujoja kwibo?”<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />Jesu kale gatyo buti, “Mukeze mi kuti mubone.” Mi kale baja no kabona umu kakala, mi kale bakala naje lelyo ijuba, ko kuti se kajili inako jo lutengwana (kuma 4 koloko).<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Andileasi, Simoni mwancegwe gwa Pitolosi, kali jumwinya kwa babo bobile naba umpilila Jesu, aa naba shugwa majwi ga Joani. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />Icintu ce tanzi ici naga tenda Andileasi ca kushaka mukulwe Simoni no ku mulugwila buti, “Tulagwani Mesiya.” (Ili litalusa Kelesite).<verse eid="JHN 1:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 1:42" />Mi Andiliyasi kale galeta Simoni kwa Jesu.</para>
  <para style="p" vid="JHN 1:42">Jesu aa naga mubona kale gatyo buti,</para>
  <para style="q1" vid="JHN 1:42">“Nigwe Simoni mwana Joani, kono kuti no kugigwe Kefasi.” (Intaluso ni Pitolosi, “ibwe.”)<verse eid="JHN 1:42" /></para>
  <para style="s1">Jesu aa Kuga Filipi no Natanaele</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Ijuba nalya nungako, Jesu kale gaba no mugajalo go kuja kwa Galileya, mi kale ga shangana Filipi no kutyo kwakwe buti, “Ni umpilile.” <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />Mi Filipi mu munzi gwa Betisaida kazwa, umunzi gwa Andulu na Pitolosi. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />Filipi kale gagwana Nataele no kutyo kwakwe buti, “Tula mugwani uju naga n’oligwa kwa Mushe mwibuka lyo mulao, kame uju na baboni ba Nyambe naba n’ola byakwe. Ni Jesu gwa Nazaleta, Mwana Josefa.”<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />Natanaele kale ga buza buti, “Nanzaleta, kocili cintu cilotu cigola kuzwa momo?” Filipi kale gatyo buti, “Gwize ubone.”<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />Jesu aa bona Natanaele na keza kwakwe no kugamba byakwe buti, “Nga mubone umu Isilaele gwe conse kwakwe takuli kuoma.”<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />Natanaele kale ga buza Jesu buti, “Buti ulanizibili?” Jesu kale getaba buti, “Filipi nasini kuku kuga, nana kubona nokele mwisiko lyo cishamu co bukuju.”<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />Cwale Natanaela kale ga buza buti, “Muzigi, uli Mwana Nyambe, uli Umfumu gwa Isilaele.”<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />Jesu kale etaba buti, “Bulyo uzumina ko kuti ni la kulugwili buti nana ku bona mwisiko lyo cishamu co vukuju. Kuti no bone ibintu binene biita byebyo.” <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />Kame kale anungako buti, “Nicote wawa nasa milugwila, kuti na mubone igulu aa livwikuka ne mangiloi ga Nyambe naga kambama no ku sezumuka a Mwana Muntu.”<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s1">Umukiti go maseswa mwa Kana</para>
  <para style="r">(<ref loc="MAT 22:2">Mateu22.2</ref>; <ref loc="JHN 5:36">Joani5.36</ref>; <ref loc="MAT 9:15">Mateu9.15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />Mwijuba lya tatu, kale kwa tendala umukiti go maseswa mu munzi gwa Kana, mu cilalanda ca Galileya. Nyina gwa Jesu ko kali, <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />Jesu ne bazigigwa bakwe nabo naba kugigwa ku mukiti. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />Mi waine aa sejila mani, Nyina gwa Jesu kale ga mulugwila buti, “Iwaine jilamani.”<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />Jesu kale ge mwitaba buti, “Maa, tobotele uku ni lugwila byo kutenda? Inako jangu jisini kusika.”<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />Nyina kale alugwila abaika buti, “Mutende ibi saka ami gambaguze byonse.”<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Ko kakuli tuzunga to mabwe totosanwe ne kakole katu ningikitweo, utu kaba shambilanga Amajuda mwi nako jo mikiti kuja ko cizo cabo utu katusika akulema kutenda amakumi gobile kampa gotatwe. <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />Jesu kale alugwila abaika buti, “Musintile amenzi mutuzunga tubumbe.” Mane tu sintauke, <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />Jesu kale aba lugwila buti, “Cwale muteke mu menzi gago mumu twalile uju ajendesa umukiti.” Kale ba mutwalila gago menzi. <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />Mujendesi go mukiti aa shutula amenzi aga naga zoka waine. Taa kazekelele jejo iwaine uku kajizwa kono, abaika aba naba kateka menzi kabezi, mi umujendisi kale akugila umusesi kumbali <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />nokutyo, “Umuntu gense gasa tagilanga iwaine indotu tansila, mi abantu aa sebala dakwi lwini, ko kuwegwa iwaine imangoju, kono igwe ula biki indotu kusika jejino inako!”<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Byebi ne bisupo bye tanzi naga tenda Jesu mu munzi gwa Kana mwa Galileya, ka byebyo naga bikululwa mu bunene bwakwe, mi abazigigwa bakwe naba muzumina.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />Byebyo aa sebila mani, Jesu kale aja kwa Kapenaumi ne nyina, noba kwakwe, no bazigigwa bakwe, koko kale bakekalako bulyo amajuba amace.<verse eid="JHN 2:12" /></para>
  <para style="s1">Jesu aa tanda aba kaba gulisa mu malibela go Tempele</para>
  <para style="r">(<ref loc="MAT 21:12-13">Mateu21.12-13</ref>; <ref loc="MRK 11:15-17">Maleka11.15-17</ref>; <ref loc="LUK 19:45-46">Luka19.45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />Umukiti go majuda gwe Mpaseka seka gu kokelele afuwi, mi Jesu kale aja kwa Jelusalema. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />Momo mwilapa lyo Tempele Jesu kale akagwana abantu ba gulisa in’ombe, ingu no tukwilimba, mi bamwinya nabe kele bucinca amashelen’i amatafule gabo. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />Jesu kale aosha iciwepu amukumba go n’ombe, mi kale abatanda bonse mwi lapa lyo Tempele, ne ngu, in’ombe jabo bobo. Kame kale amwaga mwaga ama shelen’i aga kabakwesi kucinca, no kugwisa amatafule gabo. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Mi kale alugwila aba kaba gulisa utu nkwilimba buti, mutu zwisemo tonse, muleke ukuzola injugo ja Tata icibaka co magulikizo. <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />Abazigigwa bakwe kale ba gaja ubu kun’olelwe, “Nyambe, icisemo cangu ku njugo jako, casa jakila mu cizuba cangu sinagwe mulilo.”<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Ama juda kale babuza buti, “Ni cisupo ja buti iji soko utende, iji saka jitu bonise buti uli kwesi inguzu jo kutenda zezo zokukala bobo.”<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />Jesu kale abataba buti, “Mu jakulule Itempele jeji, Ime kuti nani jijake mu majuba go tatwe bulyo.”<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />Amajuda kale bamubuza buti, “Itempele jeji naja tuindila imyaka jo makumi gone natosanwe nakakole (46) muku jaka, kono igwe buti utyo kuti, no jijake muma juba go tatwe.”<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />Kono Itempele ka sukulula Jesu kaguli umubili gwakwe. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Jesu aa sala buki ku bafwu, abazigigwa bakwe kale bagaja ibi naga gamba, mi kale bazumina in’olo, no majwi sali kugamba Jesu.<verse eid="JHN 2:22" /></para>
  <para style="s">Inzibo ja Jesu abumi bo muntu</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />Jesu aa kakele mwa Jelusalema mwinako jo mukiti gwe Mpaseka, ubungi bo bantu kale babona ibisupo katenda mi kale bazumina mwizina lyakwe. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />Kono Jesu ta a kaba sepite, ukuti kabezi bonse. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />Mi taa kashaka ubumpaki bungi bo muntu, ukuti kezi ici kacili mu mojo go muntu gense.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">Jesu na Nekudema</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Cwale ku Mafalisi kokali unkosi gwe zina lya Nikodema, uju kaali jumwinya gwa mu nkuta jo Majuda. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Amasiku kale akeza kwa Jesu ku mubuza buti, “Muzigi, tuli zekelele buti uli muzigi uju azwa kwa Nyambe, ko kuti takuli uju agola uku tenda byebi ibisupo utenda, uku Nyambe takele neje.”<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />Jesu kale amutaba buti, “Niconse nasa kulugwila wawa, takuli uju agola kubona u Mubuso gwa Nyambe, uku tala bonigwa lya bili.”<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />Nikodema kale etaba buti, “Buti abotele unkosi uju sa kulite kuzaligwa kame? Mi tagoli uku bogwela lya bili mwi vumo lya nyina buti akazaligwe.”<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />Jesu kale emwi taba buti, “Nicote wawa nasa kulugwila, takuli uju agoli uku ngina mu Mubuso gwa Nyambe ati tala zaligwi ko menzi no Moya. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Ici naca zaligwa ku muntu ni muntu ukuti ici naca zaligwa ku Moya ni moya. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />Uleke ku komokwa aani ku lugwila buti uli botele uku zaligwa kame. <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />Inkuli jasa uunga ubuji shakila. Igwe ula shugwa umulumo gwe nkuli ji uunga, kono ta gwizi uku jizwa noku jija, bobo ku kalile no muntu gense uju naga zaligwa ko Moya.”<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />Nikodema kale abuza Jesu buti, “Buti bibotele kukalila?”<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />Jesu kale ga mutaba buti, “Igwe uli muzigi go bantu ba Isilaele, mi toshugwisisi zezi zintu.” <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />Nicote nasa kulugwila wawa, twasa gamba ibi tuzekelele mi twasa paka kwebi natwa bona, kono neshunu ano abantu tabazumini ubumpaki bwetu. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Ta muzumini aa ni mi gambaguza ibintu bya aano ansi, cwale buti mubotele uku zumina muzumini ati nani gamba ibintu bya kwigulu? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />Takuli umuntu saja kwigulu bwita Mwana Muntu genke uju sazwa kwigulu.<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />Sinagwe ni Mushe ubu naga nanwina ijoka mu mangusu, cwale no Mwana Muntu ali jelele uku nanunigwa, <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />ukuti umuntu gense uju a zumina kwakwe nagwane bumi tabumani. <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />Ukuti Nyambe naga shaka lwini longa mane naga liwa Mwane genke, ukuti gense uju azumina kwakwe taana nafwe kono nagwane ubumi ta bumani. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />Nyambe taa naga tuma Mwane mwilonga keza kuba umuatuli, kono kuba umujojesi gwe longa.<verse eid="JHN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18" />Umuntu gense uju azumina kwakwe taa na atulwe, kono uju akana uku zumina kuti na atuligwe, ukuti taa na zumina mwi zina lya Mwana Nyambe. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />Mi iji ne nkatulo, ituba nalya keza Mwilonga, kono abantu naba shaka ififi kuita Ituba, ukuti imisebezi jabo kajili mimangoju. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />Umuntu gense uju atenda bumangoju ali zimbite iseli, mi takezi mwi tuba ukuti ali jogete ibitendantu byakwe bimangoju buti mane bibonaale. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />Kono gense uju ajoja ko jonse gasa keza mwi tuba ukuti ku bonaale buti ibi natenda nabya tendigwa mu mensho ga Nyambe.<verse eid="JHN 3:21" /></para>
  <para style="s1">Jesu na Joani</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Mwishule lya byebi, Jesu neba zigigwa bakwe kale baja mu cilalanda ca Judeya, mi kale ga sigala nabo na kolobeza. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />Mi Joani naje ka kwesi uku kolobeza mwa Enoni, afuwi no Salimi, ukuti amenzi kagali mangi momo mu cibaka, abantu kaba keza no ku kolobezigwa. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />Ao Joani kasini ku shuminigwa ku tuligwa mu ntolongo.<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />Cwale kale kwaba nenkani mukati ko bazigigwa ba Joani no Mujuda jumwinya kuja ko cizo co ku licenisa. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />Kale ba keza kwa Joani no kumu buza buti, “Muzigi, umuntu uju kakele negwe mwi silya lyo lwizi lwa Jodani, uju nagwa paka byakwe, ngolole kame akwesi uku kolobeza, mi abantu bonse kwakwe bakwesi kuja.<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />Joani kale abe taba buti, “Takuli umuntu uju agola kutambula cimwinya bwita ici awegwa cizwa kwigulu.” <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Nenwe muli bampaki bangu, ku koza aa na natyo buti, “Tali nime Mesiya,” kono Ime bulyo nana tumigwa buti ni litangize kwakwe. <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Mi mwini musesigwa musesi, kono umusele go musesi uju azimene afuwi mi ala mushugwa asa jangala aa shugwa ijwi lyo musesi, ukuti ku jangala kwangu kunene. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Ije ali botele ukuba munene, ime nibe umunini.<verse eid="JHN 3:30" /></para>
  <para style="s1">Jesu nije azwa kwigulu</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />Uju azwa kwi gulu alaita abantu bonse, kono uju azwa ansi asa gambagula ibintu bya ansi. Cwale jojo azwa kwigulu egulu lyabo akele. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />Asa gamba ibi naga bona no ku shugwa, kono takuli uju azumina ubumpaki bwakwe. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />Uju azumina ibi agamba, gasa nyatela buti Nyambe gwa cote. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Uju naa tumigwa kwa Nyambe gasa gamba majwi ga Nyambe, kono Nyambe gasa muwa Moya ugu tagu kwesi amamaninino. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />Tata naga shaka umwana no ku muwa ibintu byonse mu nguzu jakwe. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Umuntu gense uju a zumina kwa Mwana Nyambe kuti nagwane ubumi tabumani, kono uju akana Mwana tana bone ubumi, mi ubukali bwa Nyambe kuti nabu kale kwakwe.<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s1">Jesu no Mwanakazi go Musamaliya</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Cwale Amafalisi aa bashugwa buti Jesu ka sigulula noku kolobeza abazigigwa bangi kuita Joani, <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />mi Jesu tali neje ka kolobeza kono bazigigwa bakwe. <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Cwale Jesu kale azwa mwa Judeya noku bogola kame kwa Galileya. <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />Mi kale ga koshokanya mu cilalanda ca Samaliya.<verse eid="JHN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5" />Mi kale akeza kusika mu munzi gu kugigwa Sikale gwa Musamaliya, ugu ka gukele afuwi negwa lya Jakobo, ili nagawa mwane Josefa. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Ao ko kalili ikalo lya Jakobo, Jesu kale akala ekalo ao kebaka lyo kukotela mu lujendo lwakwe, mi see kakuli kamwi ko malumba (12 nkoloko).<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />Umwanakazi go Musamaliya aa keza ku kuteka menzi, Jesu kale atyo kwakwe, “Ngo niwe ku menzi go kunywa.” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />Abazigigwa bakwe mu munzi nabaja ku kagula ibilyo.<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />Umwanakazi go Musamaliya kale atyo kwa Jesu, “Tali igwe uli Mujuda, ime nili mwanakazi go Musamaliya, cwale cinzi aa ukumbila menzi kwangu?” Ukuti Amajuda taba goli uku gwanana no Masamaliya.<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />Jesu kale amu taba buti, “Ati no zekelele impo ja Nyambe buti nini joju uju aku kumbila amenzi, nola mubuzi mi ka kuwa amenzi go bumi tabumani.”<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />Cwale umwanakazi kale amutaba buti, “Mfumwangu, tokwesi icitekiso, mi ikalo lya kunoka. Kwibo ubotele uku gwana menzi go bumi? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />Ikalo leli ni sukuzetu Jakobo naga lituwa, mi ije no bane ne bimunantu byonse, naba nywa momu mwi kalo. To jelele kuba umunene kuita Jakobo?<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />Jesu kale ataba buti, “Umuntu gense uju anywa gaga menzi kame kuti nafwe inyontwa, <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />kono gense uju anywa menzi niwa taa nafwe inyontwa. Mi cwale amenzi aga nani bawe kuti naga zoke iweluwelu ili taliwili ili livwelaukila ubumi tabumani.”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />Umwanakazi kale amu taba buti, “Mfumwangu niwe gaga menzi buti nani leke kufwa inyontwa kuti nileke ku kezanga ku tekanga menzi momu mwi kalo.”<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />Jesu kale amu taba buti, “Ujende uka kuge umukwame gwako mi ukeze naje.<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />Mwanakazi kale ataba buti, “Tani kwesi mukwame. Jesu kale atyo kwakwe, bya wawa oo gamba buti tokwesi mukwame. <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />Na gwa sesigwa kuba nkosi ba tosanwe, kame unkosi ujoja naje tali mukwame gwako. Bya wawa usukulula.”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />Umwanakazi kale ataba buti, “Umfumwangu, nila boni buti uli muboni.” <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />“Basukuzetu kaba ku mbililanga Nyambe aleli ilundu, kono inwe amajuda buti mutyo, Jelusalema ceci cibaka cijelele uku kumbililwa.”<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />Jesu kale amutaba buti, “Mwanakazi uni zumine, inako jila keza aa tana mulapele Tata aleli ilundu kampa mwa Jelusalema. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Inwe mwe Masamaliya mwasa kumbila ici ta mu zekelele, kono iswe Amajuda tulizi uju tukumbila, uku jojeswa ku Majuda kuzwa. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Inako jila keza mi naja sika abalapeli bo conse aa naba kumbile Nyambe mu Moya ne cote, ukuti go mufuta go balapeli Nyambe aba shaka. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />Nyambe ni Moya, mi abalapeli bakwe bali jelele uku lapela ko Moya ne cote.”<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />Umwanakazi kale atyo kwakwe, “Ni lizekelele buti Mesiya (uju akugigwa Kelesite) ala keza, aa nakeze kuti natu sunde ibintu byonse.<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />Jesu kale atyo kwakwe buti, “Nime ije, uju agambagula negwe.”<verse eid="JHN 4:26" /></para>
  <para style="s1">Abazigwa aa ba gwanana na Jesu</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />Mwa jejo inako abazigigwa ba Jesu kale ba bogola, mi kale ba komokwa lwini aa ba gwana Jesu na gambagula no mwanakazi. Kono takuli nanga genke uju naa mubuza buti, “Cinzi ushaka?” Kampa “Cinzi aa ugambagula naje?”<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Cwale umwanakazi kale aleka icitekiso cakwe no kubogola ku munzi no ka gambaguza abantu buti, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“Mwize mubone unkosi uju ala ni gambaguzi ibintu byonse ibi taa na natenda. Jojo ali jeleele kuba Mesiya gwa Nyambe?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />Mi kale bazwa mu munzi no kaja kwa Jesu.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />Mwi nako jejo abazigigwa ba Jesu kaba kwesi ku mukumbila buti, “Muzigi, ulye cimwinya!”<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />Kono kale atyo kwabo, “Nili kwesi icilyo ici tamu zekelele.”<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />Ao abazigigwa kale bali gambaguza mukati kabo buti, “Buti kwali umuntu uju ala muwi ibilyo?”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />Jesu kale atyo kwabo, “ibilyo byangu, kuzumina izi ashaka Nyambe uju naa nituma no kumana umusebezi gwakwe. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Buti mutyo, ‘Tali myezi jone seji sigalile jo ku zimbula.’ Mi nasa milugwila, mugalule mensho genu mulole ku lugwa; ibilyo sebi libizwite mi sebi libotelwe uku zimbuligwa! <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Umuntu uju a zimbula gasa wegwa ubu zimbuli bo lukau lobumi ubu tabumani, buti umubyali no muzimbuli bagwanane muku jangala. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />Mpaa kuzwa mu gambagwilo gwa cote gutyo, ‘Jumwinya kubyala jumwinya ku zimbula.’ <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Nana mitumi uku zimbula ibi taa na mwa byala, bamwinya kame naba belekamo, mi inwe kame mugwana inkambikile ku musebezi gwabo.”<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />Ubungi bo Masamaliya ba mwa gogo munzi kale ba zumina kwa Jesu ukuti ubumpaki bo mwanakazi ka butyo, “Naa ni gambaguza ibintu byonse ibi nana tenda.” <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />Amasamaliya abakeza kwa Jesu, kale ba mukumbila buti akale nabo kale akala nabo amajuba gobile.<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />Ubungi bo bantu kale ba zumina kebaka lyo majwi gakwe, <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />Mi kale batyo ku mwanakazi buti, “Tula zumini ano, tali kwa byebyo ulatu gambaguzi, kono iswe tula mu lishugwili, tulizi nenja buti, neje Mujojesi gwe longa lyonse.<verse eid="JHN 4:42" /></para>
  <para style="s1">Jesu aa oza mwana nduna go muninzana</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Amajuba gobile ase ga lamani, Jesu kale ananuka no kuja kwa Galileya. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />Ije naga gamba buti, “Umuboni gwa Nyambe ta kutekigwi mwilonga lyakwe.” <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Aa sala siki mu cilalanda ca Galileya, abantu kale ba mu tambula ukuti nabo nabaja kwa Jelusalema ku mukiti gwe Mpaseka mi naba kabona bintu bonse naga tenda mwi nako jo mukiti.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />Jesu kale abogola ku munzi gwa Kana mu cilalanda ca Galileya, umu naga ka zola amenzi kuzoka iwaine. Mwa Kapenauma mu munzi kokali unduna go mfumu mwane kali mulwele. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Jojo unkosi aa na shugwa buti Jesu alasiki mwa Galileya kuzwa kwa Judeya, kale akeza kwakwe no ka mu kumbila buti aje kwa Kapenauma buti aka oze mwane go muninzana uju seee kakokelele ku kufwa. <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />Jesu kale atyo kwakwe buti, “Ati tamuboni amaponiso no mamakazo taa na muzumine.”<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />“Unduna kale atyo kwa Jesu buti, “Mfumwangu, sezumuka mwanangu nasini kufwa!”<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />Jesu kale amwitaba buti, “Kaje, mwano kuti ajoje!”</para>
  <para style="p" vid="JHN 4:50">Unkosi kale azumina ijwi lya Jesu naa gamba no ka lijila. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />Aa kasili munzila jakwe, abaika bakwe kale ba mushangana no ku mulugwila buti, “Mwano ala joja!”<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />Kale aba buza inako mwane iji ala tatiki uku lishugwa nenja, kale batyo kwakwe, “Ijona ku manako go kamwi (1 kolonko) ielenge aa nalya muleka.” <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />Isi kale aziba buti ne nako iji naa tyo Jesu kwakwe buti, “Mwano kuti ajoje.” Mi ije no lwasi lwakwe loonse kale bazumina. <verse eid="JHN 4:53" /><verse number="54" style="v" sid="JHN 4:54" />Mi ce cisupo cabili naga tenda Jesu aa salazwi kwa Judeya kuja kwa Galileya.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">Jesu aa oza unkosi go kugolomena ku kaziba lyo Nsabata</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Byebyo aa sebilamani, Jesu kale aja kwa Jelusalema ku mukiti gwa jumwinya bo Majuda. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />Momo mwa Jelusalema afuwi no cinzi ce ngu, ko kali kaziba ka kugigwa Betizata. Mumu shobo go Ebele, aka ka kajakilwe amandandulu go mawisizo jo binzi byajo tosanwe. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Momo mu binzi kakulele abalwele bangi aba kabali biofu, aba ba tegena, nebo kugolomena. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />Kumwinya ingeloi lya Nyambe kali sezumukanga momo mukaziba, keza ku vwelangula menzi. Umu lwele gwe tanzi uju kashambamo momo mukaziba, amenzi aa se gala vwelauki ko kulwaluka kubulwele bonse ubu kaala. <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />Momo moo kakele unkosi uju naga lwala imyaka ja 38 (makumi go tatwe ne tosanwe no totatwe). <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />Jesu aa mubona nalele, kale gaziba buti unkosi kaali mulwele e nako moo jinde, kale ga mubuza, “Uli shakite uku lwaluka?”<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />“Mfumu,” umulwele kale gataba, “Takuli muntu uju anitimbila mukaziba amenzi aga vwelauka. Kame nikwesi kujeleka kuti ningine mukati, jumwinya kame anitilila.”<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />Jesu kale gatyo kwakwe, “Zimana! Uinde ubulo bwako, ujende.” <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />Ao bulyo unkosi kale galwaluka, no kuinda ishasha lyakwe. Kame ijuba kalili lyo mukibelo, <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />Amajuda kale bazumininana no kutela umukwame uju kali umulwele, “Lyeli lya mukibelo, umulao tagu tuzuminizi kuti igwe uinde ishasha lyako.”<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />Kale ga bataba buti, ‘Uinde ubulo bwako ujende.’ ”<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />Cwale kale bamu buza, “Nini jojo uju ala kulugwili kuti utende zezi?”<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />Uju naga lwalukiswa takezi ubu akalile Jesu, kakuli kagugi ko bantu mucibaka ceco, ao Jesu kale ajobela mukati ko bantu.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />Ao bulyo Jesu kale ga mugwana mu Tempele no kutyo kwakwe, “Tegeleza, ulalwaluki aano, uleke ukutenda ubumangoju ukuti cimangoju cimwinya kuti na ciku bogwele.”<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />Unkosi jojo aa kaja kale aja bugambaguza Amajuda buti ni Jesu uju naga ni lwalukisa. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />Amajuda kale batatika uku cana Jesu, ukuti naga tenda lwalukisa mwijuba lyo Nsabata. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />Jesu kale atyo kwabo buti, “Tata kame abeleka muma juba gonse, neme nili swanele kusebeza.”<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />Ko kutenda bulyao Amajuda kale ba shaka ukuyaga Jesu kuita etanzi, kono tali bulyo kucola umulao gwe Nsabata, kono no kuti Nyambe nisi, kame alikwesi inguzu jilikana naja Nyambe.<verse eid="JHN 5:18" /></para>
  <para style="s1">Inguzu jo Mwana Muntu</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Jesu kale abataba, “Kame nimi gambaguza icote, Umwana tagoli kutenda ibintu ije mwini, bulyo agola ukutenda isi atenda.” Kebaka lyo kuti icintu conse Tata naje Mwana kucitenda. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Tata kame ashaka Mwane no kumulagiza ibi ajelele ukutenda byonse. Kame kuti amulagize ibitendantu binene kuita byebi, kuti mukomoke. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Sinagwe ni Tata abusa ababa lafwi no kubawa bumi, no Mwana kame awa ubumi kwa baba ashaka. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />Tata ta atuli umuntu, kono naga wa Mwana kuatula ibintu byonse. <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />Kuti bonse bakutike Mwana sinagwe ubu bakutikila Tata. Uju takutiki Mwana takutiki na Tata uju naga ni tuma.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />“Nicote nasa milugwila buti, uju ashugwa ijwi lyangu no kuzumina kwa jojo alanitumi kuti agwane ubumi tabumani. Tana batulwe, kono kale balazwi mu, lufu kuja mubumi. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />Kaniti niti kame nimi lugwila buti, inako kame kuti najikeze jejo abafu ao nabashugwe ijwi lyo Mwana Nyambe aba saka bali shugwe kuti babuke. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Sinagwe Tata akwesi ubumi kwakwe no Mwana bulyo kame nagawa ubumi kwakwe. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />Kame ala muwi ubu jendesi jo kuatula, ukuti ndeje Mwana Muntu. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />Muleke ku komokwa kwa jeji intaba, inako kame jikeza jababo bali mu mabita bonse kuti bashugwe ijwi lyakwe, <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />kuti babuke aba balatendi ibilotu bazikukile bumi, babo bala tendi bibi bazikukile inkatulo. <verse eid="JHN 5:29" /><verse number="30" style="v" sid="JHN 5:30" />“Ime nenke takuli ici ni botele ukutenda, kame niatula ubu nishugwila kame inkatulo jangu jili lukite kakuli tani tendi ici cijelele kwangu kono kame nitenda icici botele kwa Tata uju alanitumi.<verse eid="JHN 5:30" /></para>
  <para style="s1">Ubumpaki kuja ka Jesu</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />“Ati nanili paka ime mwini, ubu paki bwangu tali bwa conse. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Jumwinya kwali uju apaka byangu, mi nili zekelele buti ubu mpaki ubu ani mpaka nabo bwa cote. <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />Nagwa tuma abatumgwa kwa Joani, mi naje naga mpaka bya cote. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Tali buti, nila zumina ubu mpaki bo muntu, kono kame niji tungulula bulyo buti mujojeswe. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />Joani kali ituba kali jaka no kuwa ituba, mi namwa lishalila inako jo kulikola ituba lyakwe. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />“Nili kwesi ubu mpaki buita bwa Joani. Ku misebezi jejo naga niwa Tata kumaninina, imisebezi iji nikwesi kutenda jila bonisa buti ni Tata uju naga nituma. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />Mi Tata uju naga ni tuma ali ni zekelele. Kono taa mwa shugwa ijwi lyakwe kampa kubona inkumo jakwe, <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />Mi ijwi lyakwe tali kele kwenu, ukuti tamu zumini kwa jojo uju naga tuma. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />Mu balisise aman’olo mu bugongo ukuti kame mugaja buti momo, mulikwesi ubumi tabumani. Gaga ga man’olo aga ga paka byangu. <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />Kabo kame mukana keza kwangu buti mube no bumi.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />“Tanishaki kulumbigwa ku bantu, <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />kono nilimizi. Nilizi bobo tamukwesi ilato lya Nyambe mu myojo jenu. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Nila kezi mwizina lya Tata, kono tamu nizumini, kono jumwinya ati nakeza mwizina lyakwe, kuti mumuzumine. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />Buti mugolele ukuzumina ukuti mulazumina ukulumbigwa kuzwa kwenu kono tamu shaki kulumbigwa kwazwa kwa Nyambe genke? <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />Kono muleke kugaja buti, kuti kuindikiza Tata nasini. Mulegezi gwenu ni Mushe, uku jili imigajo jenu. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Ati namwa zumina Mushe, kuti muzumine neme, ukuti naga n’ola ka byangu. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Kono uku tamuzumini ibi naga n’ola, buti saka mugolele ukuzumina ibi ni gamba?”<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s1">Jesu alela abantu ba 5,000</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Aa sekula mani byebyo, Jesu kale alutela mwi silya lye iziba nene lya Galileya, ili li kugigwa kame iziba lya Tibeliya. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />Mi abantu bangi naba mu umpilila, ukuti naba bona ibisupo naga tenda byo kuoza babo aba kabalwala. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />Jesu kale akambama kwi lundu kakalako no bazigigwa bakwe. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />Umukiti go Majuda gwe Mpaseka see kagu kokelele. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />Jesu asala kotoli amensho kale ga bona ubungi bo bantu naba keza kwakwe, mi kale gatyo kwa Filipi, “Kwibo uku saka tukagule ibinkwa bya baba abantu buti balye?” <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />Naga buza bobo mukujeleka Filipi, ukuti ije kezi munzunu ibi kabotele ukutenda.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />Filipi kale ge mwitaba buti, “Kuti kushakale amashelen’i gabotele umubeleki mwi cika lye cilimo (myezi ja 6).” Mukugula ibinkwa ibingi byo kuwa umuntu gense mubuce.<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />Jumwinya go bazigigwa bakwe, Andulu, uju kali mwancegwe gwa Simoni Pitolosi kale gatyo kwakwe, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“Uju ne muloba uju akwesi ibinkwa bya tosanwe no banswi banunu bobile. Kono byebi cinzi saka bitende ku bantu bangi bobo?”<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />Jesu kale atyo, “Mukalike bantu ansi. Koo kakuli ubwiju ubungi mwaceco icibaka, mi kale bakala ansi, mi kabali bakwame basika a 5,000. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />Jesu kale ainda ibinkwa, no kuli tumela kwa Nyambe, mi kale atayangila kwa babo aba kabekele ubu kabashakila bonse. Kale atenda bobo ne kwinswi. <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />Aa seba lakuti bonse, kale atyo ku bazigigwa bakwe, “Mugwanike ubu bugulusi bula sigali, buti buleke kujonauka.” <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />Mi kale ba bugwanika no kubumba ibitundu bye kumi na byobile byo binkwa bya tosanwe byo bubugulusi ibi nabyasigala kwa babo aba nabalya.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />Ao abantu asebala boni icisupo naga tenda Jesu, kale batatika kutyo, “Niwawa joju muboni gwa Nyambe uju ka jelele ku keza mwilonga!” <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />Jesu mukuziba buti kabashaka ku mukwata buti ba mutende mfumu ko kumu indikiza, kame kale alijila elundu.<verse eid="JHN 6:15" /></para>
  <para style="s1">Jesu aa jenda amenzi</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Aa se kula tenguwi, abazigigwa ba Jesu kale baja kusezumuka kwi ziba, <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />Uku naba kangina mubwato noku lutila mwi silya lyeziba kwa Kapenauma. Se kakuli masiku, ao Jesu nasini kusika kwabo. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />Kale kwakeza inkuli inene ji unga lwini no ku bwelausa menzi. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Asebala zugi ibibima bya tosanwe kampa bya tosanwe na kakole, kale babona Jesu akeza kubwato najenda amenzi, mi kale bajoga lwini. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />Jesu kale atyo kwabo buti, “Nime! Muleke kujoga.” <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />Mi kale bashaka ku mulonga mubwato, ao bulyo ubwato kale bwaka fugika kwikamba uku kabaja.<verse eid="JHN 6:21" /></para>
  <para style="s1">Abantu aa bashaka Jesu</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Ijuba nalya nungako ubungi bo bantu nabasigala mwisilya lye kamba lye ziba, kale ba nangula buti bwato bonke ubu nabwa sigalila. Mi Jesu tala nginimo na bazigigwa bakwe kono abo naba kaja bonke. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />Cwale amato gamwinya, aga ka gazwa ku munzi gwa Tibeliya, kale ga keza kufugika afuwi ne cibaka ici abantu aa nabalila ibinkwa Umfumu aa salamani ku kumbila. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Mi abantu aa sebala nanguli buti, Jesu no bazigigwa bakwe takakele mubwato, abantu kale ba longama mu maato no kuja ku Kapenauma ku kushaka Jesu.<verse eid="JHN 6:24" /></para>
  <para style="s1">Jesu cinkwa co bumi</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />Aa se bala mugwani mwi silya lye ziba, kale batyo kwakwe, “Muzigi lusikunzi na gwa sika ko kuno?”<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />Jesu kale aba taba buti, “Za wawa nasa milungwila, nime mushaka, isini ukuti namwa bona ibisupo naga tenda kono ukuti namwalya ibinkwa no kwikuta. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Muleke ku belekela ibilyo ibi bijoneka, kono mu belekele ibilyo byo bumi tabumani, ubu na miwe Mwana Muntu. Ukuti Nyame Tata naga tula ulukanko kwakwe.”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Mi kale bemu buza buti, “Cinzi tu jelele ukutenda umusebezi ugu ashaka Nyambe?”<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />Jesu kale eba taba buti, “Umusebezi gwa Nyambe ngugogu, kuzumina kwa jojo naga tuma.”<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />Kale bamu buza buti, “Cisuponzi iji ubotele ukutenda buti tuji bone, mi tuzumine kwako? Cinzi ici saka utende? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Basukuzetu kabalyanga manna mu manguzu, sinagwe ubu kun’olelwe, ‘Naga bawa ibinkwa bizwa kwigulu buti balye.’ ”<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />Jesu kale atyo kwabo, “Nicote nasa milungwila, Tali ni Mushe uju naga miwa ibinkwa bizwa kwigulu, kono ni Tata uju amiwa ibinkwa bya cote bizwa kwigulu. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Ukuti cinkwa ca Nyambe ce cinkwa ici ci sezumuka buzwa kwigulu mi no kuwa ubumi mwilonga.”<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />Kale batyo kwakwe buti, “Mfumwentu, “Nako jonse utuwe ceci cinkwa.”<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />Jesu kale abalugwila buti, “Nime cinkwa co bumi, gense uju akeza kwangu taa nafwe injela, mi gense azumina kwangu taa nafwe inyontwa. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Kono sinagwe aa nana milugwila mula boni kono kame tamuzumini. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Cote ici saka aniwe Tata kuti nacikeze kwangu, mi gense uju akeza kwangu taa nani mutandile kule. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />Ukuti nanakeza kusezumuka kuzwa kwigulu tali kutenda ubu nishakila kono kutenda ubu ashakila uju naa nituma. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />Mi bobo ashakila uju naa nituma, mi ici ashaka Tata cokuti nile ku jonaukilwa kwa babo bonse naa niwa, kono nani babuse mwi juba lyo mamaninino. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Ukuti ici ashaka Tata cakuti umuntu gense uju alola ku Mwana no kuzumina kwakwe kuti nabe no bumi tabumani, mi kuti nani mi buse mwi juba lyo mamaninino.”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />Mi Amajuda kale ba tatika ku kumbagula ukuti katyo buti, “Nime cinkwa kaci sezumuka kuzwa kwigulu.” <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />Kale batyo buti, “Joju tali ni Jesu, Mwana Josefa, uju ba nyina nesi tuli bazekelele? Cwale cinzi aatyo buti, “Kwigulu nizwa?”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />Jesu kale eba taba buti, “Muleke ku kumbagula mukati kenu, <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />Takuli aba bajelele ku keza kwangu bwita Tata uju naga ni tuma aa muleta kwangu, mi kuti nani mu buse mwi juba lyo mamaninino. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />Ababoni ba Nyambe buti naba n’olela, “Bonse kuti na bazigigwe kwa Nyambe.’ Gense uju naga shugwa Tata no kuliziga kwakwe kwangu akeza. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />Takuli uju naga bona Tata bwita uju naga zwa kwa Nyambe, bwita uju naa bona Tata. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />Nicote nasa milugwila, gense uju azumina alikwesi bumi tabumani. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Nime cinkwa co bumi. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Basukuzenu nabalya amaana mu mangusu mi nabafwa. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Kono ici cecinkwa cisezumuka kuzwa kwigulu ici nalye muntu gense mi taa nafwe. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Nime cinkwa cijoja ici cizwa kwigulu. Gense uju alya ku cinkwa ceci kuti najoje kutwala ku mamaninino. Ceci cinkwa mubili gwangu ici naniwe co bumi bwe longa.”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />Cwale kale kwakeza inkokani mukati ko Majuda nabatyo buti, “Joju unkosi buti abotele ukutuwa umubili gwakwe tugulye?”<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />Jesu kale atyo kwabo buti, “Nicote nasa milugwila, ati ta mulyi mubili go Mwana Muntu no kunywa amalowa gakwe taa namube no bumi. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />Bonse aba balya umubili gwangu no kunywa amalowa gangu balikwesi ubumi tabumani, mi kuti nani babuse mwi juba lyo mamanino. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Ukuti umubili gwangu cilyo wawa mi no malowa gangu cinywantu wawa. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Bonse aba balya umubili gwangu no kunywa amalowa gangu kuti nabe kwangu mi neme kuti nanibe kwakwe. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />Sinagwe ni Tata uju ajoja naa nituma mi nasa joja kebaka lya Tata, gense uju alya umubili gwangu kuti najoje kebaka lyangu. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Ceci ce cinkwa nacazwa kwigulu, taci likozite na maana nabalya basukuzenu no kufwa. Uju alya ceci cinkwa kuti najoje kutwala ku mamaninino.”<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />Jesu kagagamba zezi naziga mu cinagoge mu munzi gwa Kapenauma.<verse eid="JHN 6:59" /></para>
  <para style="s1">Amajwi go bumi tabumani</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Mukushugwa bobo, ubungi bo bazigigwa bakwe kale batyo, “Gogu muzigilo mukababu nini agola kugushugwa?”<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />Kono Jesu kale anangula buti abazigigwa bakwe kame kaba kumbagula, mi kale atyo kwabo, “Kanti jeji intaba jilagola kumi fosekeza? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />Cwale buti naku kalile ati namu bona Mwana Muntu akambamina uku kakalanga? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />Umoya gwasa wa ubumi, mi umubili ta gu kwesi umusebezi. Amajwi nila gambi kwenu gali bumbite Umoya no bumi. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Mi kobali bamwinya kwenu aba taba zumini. Ukuti Jesu kezi kuzwa ku matatikilo jumwinya gwa kwabo taa ka zumina mi kuti na mulegeze. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />Mi kale atyo buti, “Mpaa kanimi gambaguza buti takuli uju agola uku keza kwangu uku Tata tala muzuminizi.”<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />Kuzwa mwa jejo inako abazigigwa bakwe kale babogola mwishule mi kale baleka ku mu umpilila. <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />Jesu kale aba buza bekumi na bobile buti, “Inwe cinzi tamu shaki kaja?”<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />Simoni Pitolosi kale ga mwi taba buti, “Mfumwangu kwani tujelele ukuja? Uli kwesi amajwi go bumi ubu tabumani. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Tula zumini no kuziba buti nigwe go Kucena Gwenke gwa Nyambe.”<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />Jesu kale ataba buti, “Cwale taa nana mishala bekumi na bobile? Mi jumwinya gwa kwenu ni diyabulosi!” <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />Kame kagamba bya Judasi, mwana Simoni Isikaliota, nanga kaali gwa bamwinya bekumi na bobile, kuti na mulegeze.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s1">Jesu na bancegwe</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Zezo aa sezilamani, Jesu kale aja mucilalanda Galileya, takashaka kuja mwa Judeya, ukuti abakulu bo Majuda kame kabashaka akaito ko kumwiyaga. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />Kono umukiti go Majuda go Tabanakele (citebule) seka guli afuwi, <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />abancegwe ba Jesu kale batyo kwakwe, “Uzwe mwa Galileya ujende kwa Judeya, buti abazigigwa bako babone imisebezi utenda. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Takuli muntu uju ashaka kuba no kakumbo ku bantu atenda ibindu mubuzinda. Mi aa utenda zezi zintu uli banaalise kwilonga. <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />Mi no bancegwe taa naba zumina kwakwe.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />Cwale Jesu kale gaba lugwila buti, “Inako jangu aano jisini kusika. Kono inako jonse jenu kojili. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />Ilonga taligoli ku mizimba, kono kuti lyasa zimba ime nigama byo misebezi gwalyo buti mibi. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Inwe mujende ku mukiti. Ime tanikaji kwa gogu mukiti inako jangu jisini kukeza.” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />Aa salamani kugamba zezi, kale akala mwa Galileya.<verse eid="JHN 7:9" /></para>
  <para style="s1">Jesu aa ja ku mukiti mwa Jelusalema</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Mi bancengwe aa seba laji ku mukiti, naje kale akaja mubuzinda. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />Cwale koko ku Mukiti abakulu bo Majuda kabalolele Jesu no kumubuza, “Kwibo ali?”<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />Mi mukati ko bungi bo bantu mo kajili mishoboto jo kushoshota Jesu. Bamwinya buti kaba batyo, “Ninkosi mulotu.” Bamwinya kale betaba, “Awa bantu alyanganisa.” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Nanga ceciba takuli uju kagola ukugamba za Jesu muku gongoza, kebaka lyo kujoga Amajuda aba ka zumina kwa Jesu.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />Akati ko masiku go mukati, Jesu kale aja mwilapa lyo Tempele no katatika ukuziga. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />Amajuda kale komokwa lwini no kubuza buti, “Buti nakwa kezela buti joju umukwame abe ne nzunu uku taa naga zigigwa?”<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />Jesu kale ataba buti, “Ukuziga kwangu tali kwangu, kono kwa Tata kuzwa kwa jojo uju naga ni tuma. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Umuntu gense uju ali shalila kutenda ici ashaka Nyambe, kuti azibe ubu zigi bwangu uku buzwa kampa kwa Nyambe kampa bwa kuligambila ime mwini. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />Abantu aba baligambila ibi bagaja ka kumbo bashaka, kono uju ashaka kuangikigwa kwa jojo uju naa mutuma muntu gwe conse, mi takuli co manya kwakwe. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />Mushe taa namiwa mulao? Takuli kwenu nanga genke uju amamela umulao. Cinzi aa mushaka ku niyaga?”<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />Akagugi kale kataba, “Mayauma ga kukwesi, nini uju ashaka kuku yaga?”<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />Jesu kale atyo kwabo, “Nana tenda icisupo co conke, mi mwense namwa komokwa lwini. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />Mushe naga miwa mukanda go kugegeleza (kono tali kwa Mushe ka guzwa, kono kubakulu katanzi), mi mwasa tula muloba mu mukanda lyo Nsabata. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />Cwale ati umuloba natuligwa mu mukanda lyo Nsabata, buti umulao gwa Mushe guleke kucoligwa, cinzi aa muni nyegelela mukuoza mubili gonse go nkosi lyo Nsabata? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Muleke kuatula ko nsobozi, kono muatule ubu ku jelelee.”<verse eid="JHN 7:24" /></para>
  <para style="s1">Jesu ni Mesiya</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Cwale bamwinya bantu bamwa Jelusalema kale batatika ubuza buti, “Joju tali nu nkosi bashaka kuyaga? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Juno kuno! Kame akwesi uku gamba ku gogonza, kame takuli cigambo bagamba kwakwe! Nicote amanduna bali nangwile buti nije Mesiya? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Kono tuli zekelele joju unkosi uku azwa, Mesiya aa na keze, takuli uju na zekelele uku azwa.”<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />Cwale Jesu, aa kasikwesi kuziga mwilapa lyo Tempele, kale ga kumba mwijwi inene buti, “Eee, mu lini zekelele! Mi muli zekelele uku nizwa. Tana na keza ke nguzu jangu, kono uju naga ni tuma gwa conse. Tamu muzekelele? <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />Kono ime nili muzekelele ukuti kwakwe nizwa mi naa nituma.”<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />Cwale kale bajeleka kumu shumina, kono takuli uju naa mukambika iganja, ukuti inako jakwe kajisini kusika. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />Kono ubungi bo bantu kale bazumina kwakwe, mi ka batyo buti, “Mesiya aa na keze, kuti na tende ibisupo biita bya joju umukwame?”<verse eid="JHN 7:31" /></para>
  <para style="s">Abalindili bo Tempele aa batumigwa kukashumina Jesu</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />Amafalisi kale ba shugwa abantu naba shoshota bya Jesu, cwale Amapulisita bakulu na Mafalisi kale ba tuma abalindili bo Tempele kuka mushumina. <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />Jesu kale atyo, “Nisi kele nenwe mwi nako ifuwi bulyo, mi cwale kuti nanikaje kwa jojo naga ni tuma. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Inwe kuti na muni shake, kono taa namu nigwane, mi uku nani kale, inwe tamu goli kezako.”<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />Amajuda kale bali gambaguza mwacabo, “Kwibo joju unkosi uku ashaka ukuja buti mane taa na tu mugwane? Ukuti kuti naje ku minzi jo Magelike uku kujoja Majuda, aka zige Magelike?”<verse eid="JHN 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 7:36" />Cinzi atalusa aa ta buti, kuti namu shake kono taa namu nigwane mi uku nikele tamu goli kezako<verse eid="JHN 7:36" /></para>
  <para style="s1">Jesu akuluwiza amenzi ga jojisa</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />Mwijuba lyo mamaninino na mwijuba inene lyo mukiti, Jesu kale azimana no ku kugiliza mwijwi inene, “Muleke umuntu gense uju afwite inyontwa akeze kwangu akeze anywe. <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />Gense uju azumina kwangu, sinagwe in’olo ana lyatyo, mu mojo gwa uju nazumina kwangu, kuti na kungonge lwizi lo menzi ga jojesa.’ ” <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />Jesu kame ka gambagula byo Moya, buti babo ka bazumina kwakwe kaba jelele kugu tambula. Ukuti Umoya nagu sini keza, Jesu kasini kulumbigwa.<verse eid="JHN 7:39" /></para>
  <para style="s1">Inkokani mukati ko Bantu</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Aa nabashugwa gaga majwi, abantu bamwinya kale batyo, “Ni wawa joju unkosi muboni gwa Nyambe.”<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />Bamwinya ka batyo buti, “Ni Mesiya.” Kono bamwinya kabatyo buti, “Buti Mesiya agola ku zwilila kwa Galileya? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Aman’olo tali buti gatyo buti Mesiya kuti nazwilile mu mukoga gwa Deviti no kuzwa mu munzi gwa Beteleema, mu munzi kajoja Deviti?” <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />Cwale kale kwaba ne nkokani mukati ko bantu kebaka lya Jesu. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Bamwinya kabashaka ku mushumina, kono takuli nanga genke uju naga tula iganja kwakwe.<verse eid="JHN 7:44" /></para>
  <para style="s">Uku sazumina ko bajendesi bo Majuda</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Kumamanino abalindili bo Tempele kale babogola ku mapulisita abakulu naku Mafalisi aba naba babuza buti, “Cinzi aa tamula muleti?”<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />Abalindili kale betaba buti, “Takuli uju ala gamba sinsgwe sinagwe joju unkosi,”<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />Amafalisi kale betaba buti, “Buti mutyo nenwe alakamiomi?” <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />Kwenu mwe bajendesi kampa kwenu mwe Mafalisi, nini uju naa zumina kwakwe? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Kono baba abantu aba taba zekelele umulao gwa Mushe, bali kwesi cikuto.”<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />Nekudema, uju sali kuja kwa Jesu ku matatikilo, uju kali jumwinya gwa kwabo kale atyo kwabo buti, <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“Kuja ko mulao gwa Mushe, umuntu alagola kuwegwa umulandu tala tegelezwa no kugwana ici naa tenda?”<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />Kale betaba buti, “Negwe kwa Galileya uzwa? Ushakisise mu man’olo mi kuti ugwane buti umuboni gwa Nyambe tajelele kuzwa mu Galileya.” <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />Ao bonse kale baja ku minzi jabo.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s1">Mwanakazi gwe cise aa kwatigwa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />Cwale Jesu kale aja kwi lundu lyo bishamu bya olive. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />Aa nabwaca amasiku–siku, Jesu kale angina mwilapa lyo Tempele umu kaba gwananine abantu bonse bumu zimbulukite, mi kale akala ansi no ku baziga. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Abazigi bo mulao no Mafalisi kale baleta mwanakazi uju na kwatigwa mukutenda icise. Kale bamuzimika mukati ko kagugi. <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />Mi kale batyo kwa Jesu, “Muzigi, joju mwanakazi naa kwatigwa natenda icise. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />Mu mulao, Mushe naga tuzuminiza uku pwacagula no mabwe mwanakazi go kukala bobo. Cwale aa no buti utyo?” <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />Kaba kwesi ku litusisa jeji impuzo buti bagwane akaito ko kumu ambika, kono Jesu kale akotama no kutatika ukun’ola mwivu ko munwe gwakwe.<verse eid="JHN 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 8:7" />Aa kaba kwesi kumu buzagula, kale akotoka no kutyo kwabo buti, “Kwenu mwense uju asini kutenda ubumangoju abe gwe tanzi kushonja ibwe kwakwe.” <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />Kame kale ga kotama no kun’ola mwivu. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />Kono aa naba shugwa bobo, bonse kale bakaja mwi nako jonke ku tatikila ku mukulu. Jesu kale ga sigala genke na zimene no mwanakazi. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />Jesu kale ga kotoka no kumubuza mwanakazi buti, “Mwanakazi kwibo bali? Takuli nanga genke uju ala sigali ku kunyansa?”<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />Umwakazi kale atyo buti, Umfumwangu, takuli nanga genke. Jesu kale atyo buti, “Cwale bulotu neme tanikuwi mulandu, kaje kono uleke kutenda kame ubumangoju.”<verse eid="JHN 8:11" /></para>
  <para style="s1">Jesu ni tuba lye longa</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />Jesu kale agamba kame ku bantu buti, “Nime tuba lye longa. Gense uju aniumpilila taa na ajende mwi fifi, kono kuti nabe netuba lyo bumi.”<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />Amafalisi kale bamu nyungulula buti, “Gwasa lipakela gwe mwini, ubu mpaki bwako bwa manya.”<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />Jesu kale etaba, “Nanga nani lipakela ne mwini, ubumpaki bwangu bwa cote, ukuti nilizi uku nizwa noku nija. Kono tamu kwesi magano go ku zekelela uku nizwa noku nija. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Inwe mwasa atula ko kuja mu migajalo jo buntu, Ime tani atuli umuntu. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />Kono ati nani atula, imigajalo jangu ja conse, ukuti tanikele nenke, ne Tata ni zimene uju naga ni tuma. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />Mu mulao gwenu ku lin’olitwe buti ubumpaki bo bantu bobile bwa cote. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Nasa lipaka ne mwini, mi umpaki gwangu jumwinya ni Tata, uju naga ni tuma.”<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />Cwale kale bamubuza buti, “Isho kwibo ali?” Jesu kale aba taba buti, “Tamu ni zekelele kame na Tata tamu zekelele. Ati kamu ni zekelele, na mu la zekeleli na Tata.”<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />Jesu kagamba gaga majwi nakwesi kuziga mwilapa lyo Tempele afuwi ne cibaka aa kaba tulanga ibitagilo. Mi takuli uju naa mushumina, ukuti inako jakwe ka jisini kusika.<verse eid="JHN 8:20" /></para>
  <para style="s1">Jesu aa sukulula byo lufwu lwakwe</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />Jesu kale aba lugwila kame buti, “kuti nani kaje mi kuti namuni shake, kono kuti namu fwile mu bumangonju bwenu. Tamu goli kaja uku nija.” <verse eid="JHN 8:21" /><verse number="22" style="v" sid="JHN 8:22" />Cwale Majuda kale batyo buti, “Kuti na liyage ge mwini? Ukuti buti atyo, ‘Uku nija, tamu goli keza?”<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />Kale atyo kwabo buti, “Inwe mwilonga lelino muzwa, kono ime kwigulu nizwa. Inwe muli balelino ilonga, kono ime tanili gwa lelino ilonga. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Nana mi gambaguza buti, kuti namu fwile mu bumangoju byenu ati tamu zumini buti nime, mi kuti namu fwile ibitendantu byenu bimangoju.”<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />Kale bamu buza buti, ni gweni? Jesu kale atyo kwabo buti, “Sinagwe ubu nana mitela ku matatikilo, <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />“Nili kwesi bingi byo kugamba mu nkatulo jenu. Kono uju naa ni tuma gwa conse, mi nasa gamba kwi longa ici nana shugwa kwakwe.”<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />Takaba shugwisisa buti Byesi ka kwesi ku ba gambaguza. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />Cwale Jesu kale atyo kwabo buti, “Cwale aa mu angike Mwana Muntu, cwale mi kuti namu zekelele buti nime, mi ta nili tendeli bulyo ko nguzu jangu kono nasa gamba bulyo ibi naa niziga Tata. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />Uju naa ni tuma ali kele neme, taa nani leka nenke, ukuti inako jonse nasatenda ibi bimujangaza.”<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />Ubungi bo bantu aba naba shugwa Jesu naa gamba bobo, kale bazumina kwakwe.<verse eid="JHN 8:30" /></para>
  <para style="s1">Jesu aziga za cote ku bantu</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Jesu atyo ku Majuda aba naba zumina kwakwe buti, “Ati namu zundamina kumu zigilo gwangu, mi wawa muli bazigigwa bangu. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />Cwale kuti namu zibe cote, mi iconse kuti naji mi jojese.”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />Mi kale bamwi taba buti, “Tulibo mukoga gwa Abulaama, mi tatulaba abaika bo bantu. Cinzi autyo buti kuti natu jojesigwe?”<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />Jesu kale etaba buti, “Niwawa nasa milugwila, umuntu gense uju alatenda ubu mangoju muika go bumangoju. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />Cwale umuika takwesi cibaka cikalilile mu luasi, kono mwana alikalilile mu cibaka ku twala ku mamaninino. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Mi ati Mwana namijojesa kuti namu jojisigwe. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Nili zekelele buti muli baluasi lwa Abulaama, kono kaito ko kuniyaga mushaka, ukuti tamu zumini ibi niziga. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Kame ni gambaguza ici nana bona kwa Tata, mi mwasa tenda ibi namwa shugwa bizwa kwe senu.”<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />Kale bemwitaba buti, “Setu ni Abulaama.” Jesu kale atyo kwabo, “Ati kamuli bana Abulaama, namu latendi ibi natenda Abulaama.<verse eid="JHN 8:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 8:40" />Bobo, kame mu shaka utuito to kuni yaga, unkosi uju nami gambaguza icote iji nana shugwa jizwa kwa Nyambe. Abulaama tana atenda byebyo bintu. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />Mwasa tenda imisebezi iji naga tenda senu.” Kale bamwi taba buti, “Tali tuli bana bamu mavuna, isetu uju tukwesi ni Nyambe bulyo.”<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />Jesu kale atyo kwabo buti, “Ati Nyambe kali isenu, namu ni shaka, ukuti nana keza aano kuzwa kwa Nyambe. Taa nana likezela nemwini kono ni Nyambe naa ni tuma. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />Cinzi aa tamu shugwisisi amajwi gangu? Ukuti tamu zumini ibi ni gamba. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />Muli bana Satani, mi imigajalo jenu ja kutenda ici ashaka isenu kali mwiyagi kuzwa ku matatikilo, mi takwesi cote, ukuti kwakwe takuli cote. Aa oma, asa gamba mu mushoba gwakwe, ukuti gwa manya mi nisi go manya. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Mi ukuti nasa gamba icote, tamu ni zumini! <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Nini kwenu iju agola kuniwa mulandu go cibi? Ati nani milugwila icote, cinzi aa tamu ni zumini? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />Gwa Nyambe gasa shugwa amajwi ga Nyambe. Ibaka aa tamu shugwi, lya kutyo tali muli ba Nyambe.”<verse eid="JHN 8:47" /></para>
  <para style="s1">Jesu na Abulaama</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />Amajuda kale bemu taba buti, “Tali bobo, aa tugamba buti nigwe Musamaliya mi mayauma ga ku kwesi?”<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />Jesu kale etaba buti, “Tani kwesi amayauma, kono nasa kutika Tata mi inwe mwasa ni shwaula. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Ime tani shaki uku lilumba ne mwini, kono kwali uju aka shaka, mi muatuli. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Za wawa nasa milugwila, gense uju azumina majwi gangu taa na bone lufwu.”<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />Amajuda kale batyo kwakwe buti, “Aano tuli zekelele buti mayauma gaku kwesi. Abulaama naga fwa mi na baboni nabafwa, kono buti utyo gense uju abika amajwi gako taa na bone lufwu. <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />Uli mukulu kwe setu Abulaama uju naafwa? Mi ababoni na bafwa. Buti ugajila buti nigweni?”<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />Jesu kale etaba buti, “Ati na nili lumba ne mwini, uku lilumba kwangu taku talusi cimwinya. Tata uju muta buti ne Nyambe gwenu, neje uju ani lumba. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />Kono inwe tamu zekelele, ime nili mu zekelele. Ati nana gamba buti tani mu zekelele, na nilabi go manya sinagwe inwe, kono nasa bika majwi gakwe. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />Isenu Abulaama naa jangala mukugaja uku bona ijuba lyangu, mi naa libona no ku tangalala.”<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />Amajuda kale batyo kwakwe buti, “Usini kusika amyaka jekumi ga tosanwe, mi nagwa bona Abulaama?”<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />Jesu kale abetaba buti, “Ni cote nasa milugwila buti, Abulaama nasini kuzaligwa, Nime.”<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />Cwale kale batola amabwe no kumu shonjagula, kono Jesu kale alibika no kuzwa mu Tempele.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s1">Jesu aa oza unkosi naga zaligwa no buofwu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Jesu aa kajenda, kale ga bona unkosi naga zaligwa no buofu. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />Abazigigwa bakwe kale bamu buza buti, “Muzigi, cibi cani, naca leta buti joju unkosi azaligwe nali ciofu? Cakwe kampa ca bazazi bakwe?”<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />Jesu kale ataba buti, “Tali neje joju unkosi naa tenda icibi kampa bazazi bakwe, kono naa zaligwa nali ciofwu buti imisebezi ja Nyambe ji bonaale aa jisebeza kwakwe. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />Tuli botele uku beleka imisebezi jakwe ja jojo uju naa ni tuma, aano kusili kamwi. Amasiku gala keza ku muntu gense aa tana beleke. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />Aano ni sikele mwilonga, nime tuba lye longa lyonse.”<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Aa salamani ku gamba bobo, Jesu kale asuwila ansi, mi kale akanda itapa komate gakwe. Mi kale alisinga mu mensho go nkosi go ciofu. <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />Jesu kale atyo kwakwe buti, “Ujende, uka shambe mukaziba ka Silowami.” (Leli ijwi lyasa talusa kutumigwa). Cwale unkosi kale akaja no kashamba, kale abogola ku munzi buwene.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />Aba kaba joja naje, na babo kaba mubonanga na kumbila, kale ba buza buti, “Tali neje joju unkosi uju kaka langa na kumbila?”<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />Bamwinya kale batyo buti, neje wawa. Kono bamwinya kale batyo buti, “Tali neje bulyo bali kozete.” Kono ije wawa kale atyo, “Nime jojo unkosi.”<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />Kale batyo kwakwe buti, “Cwale buti na kwa kezela buti amensho gako gatonde?”<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />Kale abetaba buti, “Unkosi akugigwa Jesu, naa kanda itapa no kunisinga mu mensho gangu no kutyo kwangu buti, “Ujende kwa Silowami ukashambe. Mi kale nakaja no kashamba no kutatika kutonda.” <verse eid="JHN 9:11" /><verse number="12" style="v" sid="JHN 9:12" />Kale batyo kwakwe buti, “Kwibo ali jojo unkosi?” Kale abetaba buti, “Tani zekelele.”<verse eid="JHN 9:12" /></para>
  <para style="s1">Amafalisi aba shakisisa zo kuozwa ko nkosi go ciofu</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Kale batwala jojo nkosi kaali ciofwu ku Mafalisi. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />Cwale kalili ijuba lyo Nsabata ao Jesu na kanda itapa no kuoza jojo unkosi ku buofwu bwakwe. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Amafalisi kame kale ba mubuza ubu naga tondela, mi kale atyo kwabo buti, “Litapa naga tula mu mensho gangu no kushamba mi kale natonda.” <verse eid="JHN 9:15" /><verse number="16" style="v" sid="JHN 9:16" />Amafalisi bamwinya kale batyo buti, “Joju unkosi tali kwa Nyambe azwa, ukuti takutiki ijuba lyo Nsabata.” Kono bamwinya kale batyo buti, “Buti kukezela buti unkosi go cibi atende byebi ibisupo?” Mi kale kwaba ne nkokani mukati kabo.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />Mi kale batyo ku nkosi gwe ciofu buti, “Cwale igwe buti utyo kakwe? Ukuti ala tondesi amensho gako? Unkosi kale atyo buti, “Muboni gwa Nyambe.”<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Amajuda taa na bazumina buti kali ciofu, mi ala tondi bwita naba kuga bazazi bo nkosi uju naga tonda. <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />Kale baba buza buti, “Ni mwanenu joju, uju mutyo buti naa zaligwa nali ciofu? Buti na kwa kezela buti atonde?”<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />Abazazi bakwe kale betaba buti, “Tuli zekelele buti joju ni mwanetu mi naa zaligwa nali ciofwu.” <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />Kono tatu zekelele ubu alatondeli. Mu mubuze, se mukulu kuti ali gambilile!” <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />Abazazi bakwe kaba gamba bobo ukuti kaba jogite abakulu bo Majuda, aba kaba gaja buti muntu gense uju azekelele buti Jesu kali Mesiya kuti atandilwe kunze lyo Cinagoge. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Lyelyo ibaka abazazi bakwe mpaa ka batyo buti, “Mumu libuzikize se mukulu!”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />Kale bakuga lyabili unkosi uju kali ciofu no kutyo kwakwe buti, “Ulumbe Nyambe.” Tuli zekelele buti joju unkosi gwa cibi.”<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />Kale etaba buti, “Ime tani zekelele buti gwa cibi, icintu nizi cakuti, kanili ciofu kono aano seni ia bona.”<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />Mi kale bamu buza buti, “Cinzi naa tenda kwako?” Buti naga galwila amensho gako?”<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />Jesu kale abetaba buti, “Kale nana mi gambaguza kono taa namwa shugwa. Cinzi kame aa mushaka kubi shugwa? Mula shaka kuba bazigigwa bakwe?”<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Kale bamu nyungulula na batyo buti, “Nigwe muzigigwa gwakwe? Iswe tuli bazigigwa ba Mushe. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Tuli zekelele buti Nyambe naga gamba ka Mushe, kono kwa joju unkosi tatu zekelele uku azwa.”<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />Unkosi kale etaba buti, “Cecintu ci komokisa! Tamu zekelele uku azwa, kono naga galula amensho gangu.” <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Tuli zekelele buti Nyambe ta tegelezangi ku bamangoju. Kono umuntu uju amukuti no kutenda ici ashaka joju Nyambe asa mutegeleza. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Kuzwa ku matatikilo ge longa takula shugwala umuntu na galula amensho go muntu naa zaligwa nali ciofu. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Ati joju unkosi takazwa kwa Nyambe, takuli ici nala tendi.”<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />Kale bamu taba buti, “Nagwa zalilwa noku kulila mu cibi, cwale ka mugaja uku tuziga?” Kale bamu tandila kunze jo Cinagoge.<verse eid="JHN 9:34" /></para>
  <para style="s1">Ubuofu bo Moya</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />Jesu aa ashugwa buti naba mutandila kunze, mi aa naka mugwana kale atyo kwakwe, “Ulazumina kwa Mwana Muntu?”<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />“Unkosi kale abuza buti, “Mfumwangu nini joju? Nigambaguze buti ni zumine kwakwe.”<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />Jesu kale atyo kwakwe buti, “Ula muboni, mi nije uju agambagula negwe.”<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />Mi unkosi kale atyo buti, “Mfumwangu, Nila zumina mi naga tongamina Jesu.”<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />Jesu kale atyo buti, “Nana leta inkatulo mwilonga mi ibiofu bingole kutonda, mi ababa tonda bazoke ibiofu.”<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />Abafalisi bamwinya aba kabekele naje aa bashugwa byebyo, mi kale batyo kwakwe buti, “Neswe tuli biofu?”<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />Jesu kale atyo kwabo buti, “Ati ka muli biofu taka jelele kuba no mulandu, kono buti mutyo, mula tonda ao cwale muli kwesi umu mulandu.”<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s1">Jesu umulisani umulotu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />Ni cote nasa milugwila mwe Mafalisi buti, “Gense uju tangini mu mulaka ko cinzi cengu kono bulyo aligila ambali musa no buyagi. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />Gense uju anginina acinzi mulisani gwe ngu. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />Umugaluli go cinzi gasa mu galwila, mi ingu jasa shugwa ijwi lyakwe. Asa kuga ingu jakwe ko mazina no kuji twala anze. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Aa sala ji anisizi anze jonse, asa tangilila abuso mi ingu jakwe jasa mumpilila ukuti jili zekelele ijwi lyakwe. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Kono taji umpilili unyenda mi kuti jitige kuzwa kwakwe ukuti taji zekelele ijwi lyo nyenda,”<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />Jesu naga litusisa jeji inguli, kono Amafalisi taa kaba shugwisisa ibi kaba gambaguza.<verse eid="JHN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />Jesu kame kale atyo kwabo buti, “Ni cote nasa milugwila, nime cinzi ce ngu. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Aba naba tatika ku keza nani sini kusika basa no bijoni, kono ingu tana ja tegeleza kwabo. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Nime cinzi, gense uju angina kangu kuti na jojeswe. Kuti naba ngine no kuzwa no kagwana ululemba. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />Umusa bulyo akeza kuiba, kuyaga no kujona, nana keza buti ingu jigwane bumi, no kubugwana mu bungi.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />Nime umulisani umulotu, umulisani umulotu asa tula bumi bwakwe kwi ngu. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />Umuntu uju tali mulisani mi tali mwini ngu, aa bona basibwe asa jileka no kaja magulu mi basibwe basa kwata ingu no kujimwaga. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Unkosi asa kaja magulu ukuti tali nemwini mi tenentaba nengu. <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" />“Nime mulisani mulotu, nili zekelele ingu jangu kame najo jilini zekelele. <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />Sinagwe ni Tata aa ni zekelele neme nili mu zekelele, mi na sawa ubumi bwangu kwi ngu. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />Nili kwesi ingu jimwinya iji tajikele momu mu mulaka, nili jelele ku jileta najo. Najo kuti naji shugwe ijwi lyangu mi kuti najibe mu mugono gonke ne mulisani genke.<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />“Tata ala ni shaka ukti nilili tukiseze uku tayisa ubumi bwangu buti nani bu bogolekezwe kame. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Takuli uju agola uku buni tapa, nasa butaya ubu ni shakila. Nili kwesi inguzu jo kubu taya ne nguzu jo kubu bogoza kame. Jeji ne intaelo nana wegwa kwa Tata.”<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Amajuda aba naba shugwa gaga amajwi kale ba ba ne nkonkani. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />Ubungi bo bantu ka batyo buti, “Mayauma ga mu kwesi, mi gasa bulumuka, cinzi aa mu tegeleza kwakwe?”<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />Kono bamwinya kale batyo buti, “Unkosi akwesi amayauma tagoli ku gamba bobo. Cwale amayauma ga lagola kugalula amensho go biofu?”<verse eid="JHN 10:21" /></para>
  <para style="s1">Jesu aa kanigwa</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Mi inako kale ja sika jo mukiti go kukankula mwa Jelusalema. Mi ka guli mweo, <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />mi Jesu kakwesi kujenda mwi lapa lyo Tempele, mu malibela ga Salumoni. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />Amajuda aba ka baliko kale bagwanana no ku zimbuluka Jesu, mi kale batyo kwakwe, “Ni nako ji sika kwibo iji no tukalike mwififi? Ati nigwe Mesiya utu lugwile nenja.”<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />Jesu kale abetaba buti, “Nana mi lugwila kono tana mwa zumina. Imisebezi ni tenda mwi zina lya Tata jejo ji paka byangu, <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />kono tamu zumini ukuti tali muli ingu jangu. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Ingu jasa shugwa ijwi lyangu, Nili ji zekelele mi jasa ni umpilila. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Nasa jiwa ubumi tabumani mi taa najijunde, takuli uju naji inde mwi ganja lyangu. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />Tata uju naga ji niwa, munene kuita abantu bonse, mi takuli uju agola kuji inda mwi ganja lya Tata. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />Ime na Tata tuli muntu genke.”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />Cwale Amajuda kale batatika kame uku tola amabwe ku mushonja, <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />kono Jesu kale atyo kwabo buti, “Nana misunda imisebezi jilotu jizwa kwa Tata. Gwibo kwa jeji imisebezi ugu mu shaka kuni pobagwila?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />Amajuda kale bemwitaba buti, “Ta tuku pobagwili umusebezi gwako mulotu, kono muku nyungulula ukuti igwe gwe muntu bulyo gwasa litunta buti uli Nyambe.”<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />Jesu kale abetaba buti, “Taku n’olitwe mu mulao gewnu buti, Nyame naga gamba buti muli bazimu.’ <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Ati babo uku nalya keza ijwi lya Nyambe basa kugigwa bazimu, wegwa ijwi lya Nyambe. (Mi in’olo tali goli uku coligwa.) <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />Mula gola uku gamba kwa jojo uju Tata naa cenisa no kutuma mwilonga kame anyungulula? Cwale cinzi aa mu niambika buti kame ni nyungulula ukuti nana gamba buti, “Nili Mwana Nyambe? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Ati tanitendi imisebezi ja Tata muleke kuni zumina, <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />kono ati nani tenda imisebezi nanga tamu ni zumini, mu zumine imisebezi buti mu zekelele no kushungisisa buti Tata kwangu akele mi neme kwa Tata ni kele.” <verse eid="JHN 10:38" /><verse number="39" style="v" sid="JHN 10:39" />Kame kale bashaka ku shumina Jesu kono kale ali oshola mu maganja gabo.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />Mi Jesu kale abogola kame mwisilya lyo lwizi lwa Jodani ka kala ku cibaka Joani uku ka kolobelezanga ku majuba go matatikilo. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />Mi ubungi bo bantu naba keza kwakwe, mi kale batyo buti, “Joani taa natenda icisupo, kono ibintu byonse na gamba Joani bya jojo unkosi bya cote.” <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />Mi ubungi bo bantu momo mu cibaka kale ba zumina kwa Jesu.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s1">Ulufwu lwa Lazalo</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Cwale unkosi ka kugigwa Lazalo kali mulwele, kazwa mwa Betaniya, mu munzi kazwa Maliya ne mukulwe Maleta. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />Maliya neje na singa Umfumu amafuta ga nunka nenja no ku sanza amatende ga Jesu ko nshuki zakwe, inciye Lazalo kali mulwele. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />Mi abancizi bakwe kale batuma ndagano kwa Jesu jityo buti, “Mfumwetu, musele gwako uju ushaka mulwele.”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />Jesu asala shugwi bobo, kale atyo buti, “Bobu bulwele tali ku lufwa buja kono, bwa kulumba uku cena kwa Nyambe ukuti Mwana Nyambe alumbigwe ko bulwele.” <verse eid="JHN 11:4" /><verse number="5" style="v" sid="JHN 11:5" />Jesu ka shaka Maleta no mwancegwe Maliya na Lazalo. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />Cwale Jesu aa sala shugwi buti Lazalo mulwele, kale akala majuba gobile mwa ceco icibaka kakele. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />Mi kale atyo kuba zigigwa bakwe buti, “Tujende tubogole kwa Judeya.”<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />Bazigigwa kale batyo kwakwe buti, “Muzigi aa no majuda kame ka bashaka kuku pwacagula na mabwe, mi cwale gwasa bogola ko?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />Jesu kale atyo kwabo buti, “Tali maola ge kumi ne gobile gali mwi juba? Muntu gense uju ajenda mu kamwi taa na sitagale, ukuti ali wene ituba lye longa leli. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Kono ati jumwinya najenda amasiku asa sitagala ukuti takuli ituba.” <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />Asala mani ku gamba bobo, kale anungako ku ba gambaguza buti, “Musele gwetu Lazalo bulyo alele, kono kuti nijeko ni ka mubuse.”<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />Abazigigwa bakwe kale batyo kwakwe buti, “Mfumwetu, ati bulyo alele kuti alwaluke.”<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />Mi Jesu ka gambagula byo kufwa kwakwe kono abo kabagaja buti ni n’onzi bulyo katalusa. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />Jesu kale aba lugwila buti, “Lazalo alafwi, <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />Nili jangele kebaka lyenu buti ta kanikele naje buti muzumine. Kono ndokweni tujende kwakwe,”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />Tomasi uju (akugigwa Majovu) kale agamba ku bazigigwa bonse, “Ndokweni twense tujende no muzigi buti tukafwile antuonke naje.”<verse eid="JHN 11:16" /></para>
  <para style="s1">Jesu nije buko no bumi</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Jesu aa sala kasiki, kale akagwana buti Lazalo sali kwesi amajuba gone mwibita. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />Betaniya kali afuwi no munzi gwa Jelusalema, mu bibima bigola kutenda byo tatwe, <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />mi ubungi Majuda naba keza kwa Maleta na Maliya keza kuba nyangulula mulufwu lwa ncizi jabo.<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />Maleta asala shugwi buti Jesu ala keza, kale amu cengamina ka gwanana naje, kono Maliya kale ali kalila ku njugo. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />Maleta kale atyo kwa Jesu buti, “Mfumwangu, ati kokokele ncizi jangu taa na lafwi. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Kono nili zekelele buti Nyambe kuti amiwe ibi mukumbila byonse.”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />Jesu kale atyo kwakwe buti, “Ncizi jako kuti abuke kame.”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />Maleta kale atyo kwa Jesu, “Nili zekelele kuti na buke kame mwi juba lyo kubuka ko ma maninino.”<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />Jesu kale atyo kwakwe, “Nime buko no bumi. Gense uju azumina kwangu kuti najoje nanga nafwa, <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />mi gense uju ajoja mukuzumina kwangu taa nafwe. Mula zumina bobo?”<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />Maleta kale etaba buti, “Eee Mfumwangu, nila zumina buti nigwe Mesiya, Mwana Nyambe, uju na keze mu longa.”<verse eid="JHN 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />Maleta asala gambi bobo, kale abogola no ka kugila Maliya kumbali. Kale atyo kwakwe, “Muzigi kwali, mi kame akukuga.” <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />Maliya asala shugwi bobo, bwangu bwangu kale azimana no kaja kwakwe. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />Cwale Jesu kasini kungina mu munzi, kono kasikele acibaka aa na mushangana Maleta. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />Amajuda aba kabekele no Maliya munjugo, naba mu nyangulula, kale banangula ubu naga nanukila bwangu bwangu no kaja, kale bamu umpilila, muku gaja buti kwi bita kaja kalilila ko.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />Maliya aa sala kasiki ku cibaka uku kakele Jesu mi kale amubona, kale agwila kuma tende gakwe no kutyo, “Mfumwangu, ati kokokele, ncizi jangu taa na lafwi.”<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Jesu aa sala muboni nalila, Amajuda aba kaba jenda naje nabo kale balila, kale ashugwa kushisha ku mojo lwini no kuesumuka. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />Jesu kale abuza buti, “Kwibo mula mulaliki? Kale bemutaba buti, “Mfumwetu gwize ubone.”<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />Jesu kale alila. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />Cwale Majuda kale batyo buti, “Muliwene ubu kamusha kila!”<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />Kono bamwinya kale batyo buti, “Tali neje uju naga galula amensho go nkosi go ciofu buti ali jelele ukuleka joju unkosi nafwa?”<verse eid="JHN 11:37" /></para>
  <para style="s1">Jesu aa busa Lazalo ku bumi</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />Cwale Jesu kale ashugwa kushisha ku mojo lwini kale aja kwibita. Ka lili ilambo ili nalya mfwinkigwa nebwe ku manginino. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />Jesu kale atyo buti, (“Mugalumune ko ibwe!)</para>
  <para style="p" vid="JHN 11:39">Maleta iciinzi jo mufwu kale atyo kwa Jesu, “Mfumwangu, sala nunka ukuti se majuba gone nakele momo.”<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />Jesu kale atyo kwakwe buti, “Taa nana milugwila buti ati namuzumina, kuti na mubone uku bega kwa Nyambe?” <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />Cwale kale bagalumuna ibwe, Jesu kale aligamina kwigulu, no kutyo, “Tata, nasa litumela kwako ukuti ula nishugwi. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Kani zekelele buti inako jonse ula ni shugwa, kono nasa gamba kebaka lyo bantu bakele ba zimene aano, bazumine buti nigwe nagwa ni tuma.” <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />Aa sala gambi bobo, Jesu kale akumba mwijwi linene, “Lazalo, gwize anze!” <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />Mufu kale abuka kuzwa anze, amaganja gakwe na matende aga kaga zingitwe no myala jo kukibela, nesila kali zingitwe ku kunkumo jakwe. Jesu kale atyo kwabo buti, “Mu mu zingulule amasila ga mwibita mi mu muleke ali jendele.”<verse eid="JHN 11:44" /></para>
  <para style="s1">Amajuda aa bagaja zo kwiyaga Jesu</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Ubungi bo Majuda aba naba keza kwa Maliya no ku bona ibi naga tenda Jesu, kale bazumina kwakwe. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Kono bamwinya kale baja ku Mafalisi no kaba gambaguza ibi naga tenda Jesu. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />Amapulisita abakulu no Mafalisi kale bagwanika amanduna no kutyo kwabo, “Buti tujelele ukutendela?” Ukuti joju unkosi ma makazo mangi akwesi kutenda. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Ati natu mulekelela naja butenda bobo, abantu bonse kuti bazumine kwakwe, mi impuso jo Maloma kuti naba jone Tempele jetu ne Longa lyetu.”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />Kono jumwinya gwabo uju Kayafa, uju kali mupulisita mukulu mwa gogo mwaka, kale atyo kwabo buti, “Takuli ici muzekelele!” <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Tamu nanguli buti bulo jojulya nkosi genke ali jelele kufwila abantu isini ilonga lyonse lijunde.” <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />Mi taa kali gambagwila bulyo kono ko kuba mupulisita mukulu mwagogo mwaka, Jesu kuti na fwile ilonga lyo Majuda, <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />isini kufwila ilonga bulyo kono kame nebana Nyambe baba naba mwagala kuba gwanika antuonke.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />Cwale kutatika mwa lelyo ijuba, kale bagaja uku yaga Jesu. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />Mu kutenda bobo Jesu kale aleka ukujenda akancenene mukati ka Majuda. Kale azwa mo mi kale akaja mucibaka ci mwinya ca mu mangusu mu munzi gu kugigwa Efulemu, uku naga kakala na bazigigwa bakwe.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />Mi umukiti gwe Mpaseka go Majuda see kaguli afuwi, mi ubungi bo bantu kale bazwa mwilonga kuja ku munzi gwa Jelusalema kuku licenisa umukiti nagu sini kutatika. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />Mi kale ba shakisisa Jesu, aa kaba zimene mwilapa lyo Tempele, kale bali gambaguza mwacabo buti, “Cinzi mugaja? Tala ku keze ku mukiti?” <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />Kono amapulisita bakulu no Mafalisi kale bawa indagano buti ati muntu gense na gwana uku ali Jesu, ali jelele uku ba gambaguza buti baka mushumine.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s1">Jesu aa singigwa mafuta mu Betaniya</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mateu26.6-13</ref>; <ref loc="MRK 14:3-9">Maleka14.3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Aa se kaku sigalile amajuba ga tosanwe na kakole buti Impaseka jitatike, Jesu kale aja ku munzi gwa Betaniya umu kajoja Lazalo, unkosi uju na busigwa ku bafwu. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />Momo munjugo ja Lazalo, Jesu kale awegwa iyumbu lyo mulalilo ili ka kwesi kutaya Maleta, mi Lazalo kali jumwinya gwa babo kebekele ku ntafule. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Cwale Maliya kale ga inda icika lyo mafuta gatula lwini, no kugasindila ku matende ga Jesu mi kale asingula amafuta ku matende ga Jesu ne nshuki zakwe. Injugo kale ja bumba ku mununko go sende mulotu. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />Kono jumwinya go bazigigwa bakwe Judasi Isikalioti, uju kashaka ku mulegeza kale atyo, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“Cinzi aa tana mwa gulisa gaga amafuta no kuwa amashelen’i ku bampale?” Masheleni ga gola uku sika ampei jo cika lyo cilimo. <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />Kagamba bobo tali buti katenda nenja abampale, kono kali musa. Neje ka indanga umukotana go mashelen’i mi kali tendelanga ubu ashakila.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Kono Jesu kale atyo buti, “Mumu leke Maliya! Kuli jelele buti abike gaga mafuta kutwala mwijuba ili nani zikigwe. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Kuti namube na bampale inako jonse mukati kenu, kono taa na mube neme inako jonse.”<verse eid="JHN 12:8" /></para>
  <para style="s1">Abakulu bo Majuda aa bagaja kwi yaga Lazalo</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />Ubungi bo Majuda aa naba shugwa buti Jesu mu Beteniya akele, mi kale bakaja mo tali kebaka lya Jesu kono no kabona Lazalo uju naga busigwa ku bafwu. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Cwale Amapulisita bakulu kale bagaja kame kuyaga Lazalo, <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />ukuti kebaka lyakwe ubungi bo Majuda kabaja kwa Jesu no kuzumina kwakwe.<verse eid="JHN 12:11" /></para>
  <para style="s">Jesu angina mu Jelusalema ke tuba</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mateu21.1-11</ref>; <ref loc="MRK 11:1-11">Maleka11.1-11</ref>; <ref loc="LUK 19:28-40">Luka19.28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Ijuba nalya nungako, ubungi bo bantu aba naba keza ku mukiti, kale bushugwa buti Jesu ala keza kwa Jelusalema. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />Kale bainda intabi jo bishamu byo nzalu no kaja ka shangana Jesu bukugiliza buti,</para>
  <para style="q1" vid="JHN 12:13">“Osana!”</para>
  <para style="q2" vid="JHN 12:13">“Infwijaguzi ja joju uju akeza mwi zina lyo Mfumu!”</para>
  <para style="q1" vid="JHN 12:13">“Imfwijaguzi ja Mfumu gwa Isilaele!”<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />Jesu kale agwana aka mbogologana, no ku kalija sinagwe ubu kun’olelwe buti, <verse eid="JHN 12:14" /><verse number="15" style="v" sid="JHN 12:15" />“Uleke kujoga, mwana Sione go mukazana! Uju no Mfumo akeza, nakele aka mbongologana.”<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />Ku matatikilo aba zigigwa bakwe taa na ba shugwisisa zonse zezi, bwita Jesu sala cenisigwa mi kale bagaja buti bebi bintu nabya n’oligwa kakwe mi bebi bintu nabya tendaala kakwe.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />Cwale ubungi bo bantu aba kebekele naje aa naga kuga Lazalo kuzwa mwibita no kumu busa kubafwu kabali ba mpaki. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Mi ubungi bo bantu kale baka shangana Jesu ukuti naba shugwa ama makazo natenda. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />Cwale Amafalisi kale bali gambaguza mwacabo, “Ngamulole bebi takuli uku bitutwala, muliwene ilonga lyonse kale selili mu umpilile!”<verse eid="JHN 12:19" /></para>
  <para style="s1">Jesu aa kuluwiza byo lufwu lwakwe</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />Mukati ko bantu nabaja kuku lapela ku mukiti mo kabali Amagelike. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />Cwale kale bakeza kwa Filipi uju kazwa mu munzi gwa Betisaida gwa mucilalanda ca Galileya no kutyo kwakwe buti, “Mfumwetu, kame tushaka kubona Jesu.”<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />Filipi kale aka lugwila Andulu, mi Andulu na Filipi kale babogola ka gambaguza Jesu. <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />Jesu kale abetaba buti, “Inako jilasiki ja Mwana Muntu jo kulumbigwa. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Nicote nasa milugwila, ulukwe lo maila aa talu byalwi mi lwasa fwa kuti lusigale bobo naluli bweke. Kono aa lufwa mpaa nalulete ibilyo zingi. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />Umuntu gense uju ashaka ubumi bwakwe kuti nabu jonaukilwe, kono gense uju azimbe ubumi bwakwe mumuno mwi longa kuti nabe no bumi tabumani. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />Muntu gense uju ani belekela alibotele kuni umpilila mi uku nanikale, naje umuika gwangu kuti nakale ko. Tata kuti nakutike uju ani belekela.<verse eid="JHN 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />“Cwale moya gwangu munkalilwa guli, mi cinzi nijelele uku gamba? Tata, uni lamwine kwa jeji inako? Nana keza kusika mwi nako jejino jo mapenzi. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />Tata, ulumbe izina lyako.”</para>
  <para style="p" vid="JHN 12:28">Mi kale kwazwa ijwi lizwa kwigulu lityo, “Nila lilumbi mi kuti nani lilumbe kame.”<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />Cwale ubungi aba kabekeleko aa bashagwa ijwi bamwinya kale batyo, umvula ala zumi bamwinya naba tyo buti, “Ingiloi lila gambi kwakwe!”<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />Jesu kale atyo kwabo buti, “Leli ijwi tali nime nalya tendelwa kono ninwe nalya tendelwa. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Cwale seni nako jo nkatulo lye longa, mi umfumu gwalelino ilonga kuti natandilwe anze. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />Mi ime aa seni langikigwa mwilonga kuti nani kokele abantu bonse kwangu.” <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />Ka gamba bobo ku talusa umufuta go lufwu nafwe.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />Ubungi bo bantu kale bemutaba buti, natwa shugwa mu mulao buti Mesiya kuti nakalilile, cwale cinzi aa ugamba buti, “Mwana Muntu ali jelele kuangikigwa? Nini joju Mwana Muntu?”<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />Jesu kale atyo kwabo buti, “Ituba lisikele mukati kenu mwi nako gana bulyo. Mujende aa musikwesi ituba buti ififi lileke kumigwana ukuti uju ajenda mwififi tagezi uku aja. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Muzumine kwi tuba aa musikwesi ituba buti mube bana ituba.” Jesu aa salamani kugamba bobo, kale abaleka no kalibika kwabo.<verse eid="JHN 12:36" /></para>
  <para style="s1">Uku sazumina ko Majuda</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />Nanga satenda ibisupo ibingi mukati kabo, taa kaba muzumina. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />Kakuli kubu mbilizwa ijwi lya muboni gwa Nyambe Isaya, ili kalityo,</para>
  <para style="q1" vid="JHN 12:38">“Mfumu, nini uju ala zumini ijwi lyetu</para>
  <para style="q2" vid="JHN 12:38">Mi iganja lyo Mfumu nini nalya bikululilwa?”<verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />Kebaka leli taa kaba zumina, ukuti Isaya naa gamba kame buti, <verse eid="JHN 12:39" /><verse number="40" style="v" sid="JHN 12:40" />“Nyambe naazima mensho gabo, no kukutuwisa imyojo jabo, ukuti amensho gabo galeke kutonda, mi imyojo jabo jileke kushugwisisa, mi naba zokele kwangu, nani balwalukise.”<verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />Isaya naga gamba bobo ukuti naga bona Jesu mukucena mi kagamba byakwe. <verse eid="JHN 12:41" /><verse number="42" style="v" sid="JHN 12:42" />Nanga ceciba, bamwinya bo bakulu bo Majuda kale bazumina kwakwe, kono muku joga Mafalisi takaba lumbulula akancenenene buti baleke kutandilwa anze lye Cinagoge. <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />Ukuti kaba shaka kulumbigwa ku bantu wawa kuita kulumbigwa kwa Nyambe.<verse eid="JHN 12:43" /></para>
  <para style="s1">Inkatulo lyo majwi ga Jesu</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Mi Jesu kale alila lwini no kutyo, “Muntu gense uju azumina kwangu tali kwangu bulyo zumina, kono nakwa jojo uju naa nitumi.” <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />Mi uju alola kwangu gasa bona uju naga nitumi. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Nanakeza mwilonga ketuba ukuti gense uju azumina kwangu aleke kusigala mwififi. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />Ati muntu gense asa shugwa majwi gangu mi tagabiki, ime tani muatuli. Ime taa nana keza ku kuatula ilonga kono ku kujojesa ilonga. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Uju ani kana mi tazumini majwi gangu nana gamba kwali uju namu atule. Amajwi nana gamba kuti nagabe majwi ge nkatulo jakwe mwi juba lyo mamaninino. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Ukuti tali nime ne mwini ni gamba, kono ni Tata uju naga ni tuma naga ni lugwila buti ni gambe byonse byebi nana gamba. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />Mi nili zekelele buti indagano jakwe ja bumi tabumani. Mi cwale ici ni gamba nasa ci gamba sinagwe ni Tata aa naci ni gambaguza.<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s1">Jesu aa sanza amatende go bazigigwa bakwe</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Umukiti go Mpaseka sekaguli afuwi, Jesu ka zekelele buti inako jakwe jilasiki jo kuleka lelino ilonga no kaja kwa Tata. Kashakite bakwe aba kabali mwi longa, kaba shaka kutwala ku mamanino.<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />Umulalilo aa seka gukokelele, mi Satana aa salangini mu mojo gwa Judasi Isikalioti mwana Simoni, buti alegeze Jesu. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />Jesu ka zekelele buti, Tata nagatula ibintu byonse mwinsi lyo nguzu jakwe, ukuti kazwa kwa Nyambe mi kajelele uku bogola kwa Nyambe. <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />Mi kale aleka kulya, no kujabula ici zwato cakwe cagulu, no kuzinga intaulo mu munda gwakwe. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />Mi kale asintila amenzi menzi mu kasuba, no kutatika uku sanza amatende go bazigigwa bakwe, no kuga jumisa ne ntaulo iji naa lizinga. <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />Kale akeza kwa Simoni Pitolosi, mi Pitolosi kale atyo kwakwe buti, “Mfumwangu, kuti usanze amatende gangu?”<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />Jesu kale amwitaba buti, “To shugwisisi ano ici ni tenda, kono kuti no shugwisise.”<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />Pitolosi kale atyo kwakwe buti, “Tali usanze amatende gangu!” Jesu kale amwi taba buti, “Ati tani kusanzi tano gwane ulubazu kwangu.” <verse eid="JHN 13:8" /><verse number="9" style="v" sid="JHN 13:9" />Simoni Pitolosi kale atyo kwakwe, “Mfumwangu uleke kusanza bulyo amatende gangu kono usanze amaganja no mutwi gwangu bobo!”<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />Jesu kale etaba buti, “Babo naba shamba balibotele bulyo ku sanza amatende gabo, imibili jabo jonse jili cenite. Mi mulicenite kono tali mwense mu cenite.” <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />Ukuti ka zekelele uju saka mulegeze, mi mpaa katyo tali mwense mu cenite.<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />Aa salamani uku sanza amatende go bazigigwa, kale ajabala umukanjo gwakwe no kubogola mwikalilo lyakwe ku tanfule. Jesu kale atyo kwabo buti, “Mula shugwisisa ibi nilatendi kwenu?” <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />“Mwasa ni kuga Umuzigi ne Mfumu, mulagamba nenja ukuti nime wawa. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Ati nime Umfumu no Muzigi, nila sanzi amatende genu, nenwe kamu jelele uku lisanza-sanza ku matende mwacenu. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Ime nila miwi umwanza, buti nenwe muli jelele uku tenda ibi nila tendi kwenu. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />Nicote nasa milugwila, takuli mwika uju aita Umfumwe ku bunene, kame takuli mutumigwa uju aita uju ala mutumi ku bunene. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Ati namu zekelela byebi bintu, imfwija guzi jeni ati namu bitenda.<verse eid="JHN 13:17" /></para>
  <para style="s1">Jesu atungununa byo kulegezwa kwakwe</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />“Tali kwenu mwense ni gamba, kono nili zekelele aba nana shala. Kono bumbiliza bulyo ubu ku ng’olelwe buti, ‘Uju alya neme icinkwa, ala nizokeli.’ <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />“Nasa mi gambaguza aa no nabi sinia kusini ku tendala, cwale buti aa nabi tendaale kuti namu zumine ime nimeni. <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />“Niwawa nasa milugwila buti, muntu gense uju atambula uju nana tuma neme asa ni tambula, mi gense uju asa tambula uju naa ni tuma.”<verse eid="JHN 13:20" /></para>
  <para style="r">(<ref loc="MAT 26:20-25">Mateu26.20-25</ref>; <ref loc="MRK 14:17-21">Maleka14.17-21</ref>; <ref loc="LUK 22:21-23">Luka22.21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Aa salamani ku gamba bobo, Jesu kale aa esumuka mu moya no kuwa ubumpaki buti, “Niwawa nasa milugwila jumwinya gwa kwenu kuti anilegeze.”<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />Abazigigwa bakwe kale batatika kuli lola lola, ukuti ta kabezi uju katalusa wawa mukati kabo. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Jumwinya kwa babo, umuzigigwa uju ka shakigwa kwa Jesu, kakele ku mbali na Jesu. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />Simoni Pitolosi kale alabiza jojo muzigigwa no kutyo kwakwe buti, “Mubuze Jesu nini uju ka gamba?”<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />Mi ka zendamine acizuba ca Jesu, mi kale amubuza buti, “Mfumwngu, nini wawa?”<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />Jesu kale etaba buti, “Uju saka niwe aka gomoto ko icinkwa aa senila kasunsi mu kasuba.” Cwale kale asunsa aka gomoto ko cinkwa no ku kawa Judasi, mwana Simoni Isikslioti. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />Ao bulyo Judasi aa salaindi bulyo insima, Satani kale angina kwakwe. Mi Jesu kale atyo kwakwe buti, “Ici ujelele kutenda, uci tende wangu.” <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />Kono takuli uju na shugwisisa ici ka gamba Jesu aa kabali amulalilo. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Bamwinya kaba gaja buti, ukuti Judasi neje kabikanga amashelen’i, Jesu kame kamuta buti, ukuje ukagule ibi bishakala amukiti kampa buti alijelele ukuwa abampale cimwinya.<verse eid="JHN 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30" />Ao bulyo Judasi asala mani kutambula insima, kale aja kungi, mi ka kusili masiku.<verse eid="JHN 13:30" /></para>
  <para style="s1">Umulao umuya</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Judasi aa sala kaji, Jesu kale atyo buti, “Aano Mwana Muntu asa lumbekigwa mi na Nyambe asa lumbekigwa kakwe. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />Ati Nyambe na lumbekigwa kakwe, Nyambe kuti amulumbe Mwana kakwe lwini mi kuti amulumbe wawa, <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />Banangu, nisikele nenwe mwi nako imfuwi bulyo, kuti na muni shake sinagwe aa nana gamba ku Majuda mi na kwenu nasa gamba bobo, uku nija tamu goli keza ko. <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />Nasa miwa umulao umuya, muli shake mwacenu. Sinagwe ubu nana mishakila, cwale nenwe muli jelele uku li shaka mwacenu. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Abantu bonse kuti naba zekelele buti muli bazigigwa bangu, ati namu lishaka mwacenu.”<verse eid="JHN 13:35" /></para>
  <para style="r">(<ref loc="MAT 26:31-35">Mateu26.31-35</ref>; <ref loc="MRK 14:27-31">Maleka14.27-31</ref>; <ref loc="LUK 22:31-34">Luka22.31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />Simoni Pitolosi kale atyo kwakwe buti, “Mfumwangu, uku uja kwibo?” Jesu kale etaba buti, “Uku nija aano ta mugoli uku ni umpilila, kono kwaja majuba kuti namu ni umpilile.”<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />Pitolosi kale ge buza buti, “Umfumwangu, cinzi aa tani ku umpilili aano? Kuti na niwe ubumi bwangu kwako.”<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />Mi Cwale Jesu kale etaba buti, “Kuti nowe ubumi bwako kwangu? Nasa ku lugwila wawa silukombwe nasini uku tungula, kuti no ni shampule kotatwe buti toni zekelele.”<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s1">Jesu ni nzila jija kwa Tata</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />Muleke ku lekelela imyojo jenu naji pengisigwa, mi muzumine kwa Nyambe mi muzumine na kwangu. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Injugo ja Tata jili kwesi utumpetu tungi, ati taa kakukele bobo, nani la mi gambaguzi buti nasaja nika milukisize icibaka? <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />Mi ati nani kaja ka milukiseza icibaka, kuti nani ka bogole keza ku miinda, mukakale neme uku nikele. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />Muli zekelele inzila ja ku cibaka uku nija”<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />Tomasi kale atyo kwakwe buti, “Mfumwangu, tatuzekelele uku uja, cwale buti tugola uku zekelela inzila?”<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />Jesu kale gatyo kwakwe buti, “Nime inzila, ne cote no bumi. Takuli uju akeza kwa Tata bwita kangu.” <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Ati muli ni zekelele wawa, kuti namu zekelele na Tata, kuzwa aano kuti mu muzekelele mi namwa mubona.”<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />Filipi kale gatyo kwakwe buti, “Mfumwangu, utu sunde Tata mi kuti kube nenja kwetu.”<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />Jesu kale etaba buti, “Filipi, toni zekelele? Nana kala mukati kenu inako inde, kono usini uku ni zekelela. Uju naga ni bona, naa bona Tata. Cinzi aa utyo buti, ‘Utusunde Tata?’ <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />Cwale tamu zumini buti kwa Tata nikele, mi Tata kwangu akele? Amajwi ni gamba kwenu, tanili gambili ime mwini muguzu jangu kono ni Tata uju akele kwangu, uju atende umusebezi gwakwe. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Mi muzumine kwangu aa nityo buti kwa Tata nikele mi Tata kwangu akele kampa muzumine bulyo ko bumpaki bo misebezi ni tenda. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />Nicote nasa milugwila, uju azumina kwangu kuti atende imisebezi iji nana tenda, mi kuti naba tende ibintu binene biita byebi, ukuti kwa Tata nija. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />Ibintu byonse mukumbila mwi zina lyangu, kuti nani bitende, buti Tata na lumbekigwa ka Mwane. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Ati namu kumbila cintu conse mwi zina lyangu kuti nani citende.<verse eid="JHN 14:14" /></para>
  <para style="s1">Jesu aa kuluwiza Umoya go Kucena</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />Ati mulani shaka, mukutike imilao jangu, <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />Mi kuti nani kumbile kwa Tata na miwe mugongozi jumwinya buti nakale nenwe kuja koko, <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />ugo Moya go cote. Ilonga tali sigoli uku mutambula, ukuti tali muboni mi tali muzekelele kono inwe muli muzekelele ukuti nenwe akelemi kuti nakale kwenu.<verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />Taana ni misige na muli bansigwa, kuti nani keze kwenu. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Mi kojisili inako gana, ilonga aa taana linibone kame, kono kuti namu ni bone. Ukuti nila joja mi nenwe kuti namujoje. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Mi kalyelyo ijuba kuti namu zekelele buti, kwa Tata nikele, mi nenwe kwangu mukele, mi neme kwenu nikele.<verse eid="JHN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21" />Gense uju akwesi imilao jangu no kuji kutika, neje uju ani shaka. Gense uju ani shaka na Tata kuti namu shake, mi neme kuti nani musheke no kuli bonaaza kwakwe.”<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />Cwale Judasi (tali Judasi Isikalioti) kale gatyo buti, “Mfumwangu, buti kukezela buti kuti noli bonaaze kwetu isini kwilonga?”<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />Jesu kale etaba buti, “Umuntu gense uju ani shaka kuti azumine umuzigilo gwangu, mi ne Tata kuti amushake, mi kuti tukeze kwakwe no kujaka umunzi naje. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Mi umuntu gense uju tanishaki no kusakutika amajwi gangu, mi nejwi ili mushugwa tali lyangu kono lya Tata uju naga nituma.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />“Byebi bintu nila gambi kwenu ni sikele nenwe. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />Kono umu Gongozi, ije Umoya go Kucena, ugu natume Tata kezina lyangu gogo nagumizige ibintu byonse mi nagu migulukise ibi nila mi gambaguzi byonse.<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />Mi inkozo iji ni misigila, inkozo jangu iji nimiwa, tani jimiwi ko mukwa gwe longa. Mi imyojo jenu jileke kunyegela mi jileke ukujoga ukujoga. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />“Namwa shugwa aa nana milugwila buti, ‘Nasa kaja mi kuti nani kamibogwele.’ Ati namwa nishaka namula jangali ukuti kwa Tata nija, mi Tata munene kwangu. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />Mi cwale ni lami gambaguzi byebi nabisini kutendala, mi aa sebila tendaali. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />Mi tani sigambi ibingi kwenu, ukuti umujendesi gwa leli ilonga alakeza. Mi takwesi inguzu egulu lyangu, <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />Kono nasa tenda ubu naga ni lagila Tata buti ilonga nali zekelele buti nila shaka Tata no kutenda ibi naga nilaga. “Cwale muzimane aano, tu jende.<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s1">Jesu ni veine ja wawa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />Nime igwa lya cote, mi Tata gwangu ne mubyali. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Mi kale akoshagula imitai jonse iji ta jikati imiselo kwangu, ukuti iji ji kata kale aji leka najikata ukuti jikate lwini kuitilila intikanyo. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />Kale mulaceni ukuti nilagambi nenwe ke longa. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Musigale mukati kwangu neme kuti nisigale mukati kwenu. Takuli umutai go cishamu ugu gola ukukata gomwini, guli jelele kuba kucishamu. Negwe kugwana ubumi bwita kusigala mukati kangu.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />Nime cishamu co bumi, inwe muli mitai. Ukuti mula sigala kwangu neme kwenu kuti mukate lwini imiselo, tamugoli ukutenda icintu cingi uku tanikele. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />Ukuti tamusigali kwangu, kuti mukoze sinagwe mitai iji jilashowelwi anze, imitai jejo jili botele ukuindigwa no kujishowa ko kujitenta mu mulilo. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />Ukuti mula sigala kwangu no majwi gangu gasa sigala kwenu, mukumbile conse ici mushaka mi kuti citendale kwenu. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Izina lyatata kuti lijanduluke kenu asaka mukate imiselo mingi, no kuliponaza inwe beni buti muli bazigigwa bangu. <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />Sinagwe Tata anishaka, kale ni lamishaki, ano musigale mwi lato kwangu. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />Ukuti mula bika imilao jangu, kuti musigale mwilato lyangu. Sinagwe anila biki imilao ja Tata no kusigala mwilato lyakwe.<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />Kale nana mi lugwila byebi ukuti uku jangala jangu jikale nenwe buti jenu ji bumbilile. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Intaelo jangu iji, muli shake sinagwe ubu nila mishakili. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />Takuli ilato ili liita lyeli lyo muntu uju nagawa ubumi kubasele bakwe. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />Muli basele bangu aa saka mutende ibi ni lamilagizi. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Tani simikugi abaika ukuti, umuika tezi ibi atenda Mmfumwe. Nanga ceciba, kale ni lamikugi abasele, kwa conse ici ni lalituti kwa Tata ni lacimiwi buti mucizibe. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Tana mwani shala, kono nana miwa umusebezi ukuti mu aka ibiyago ibingi, ibiyango ibi nabi kalilile, ukuti conse saka mukumbile mwizina lyangu Tata kuti acimiwe. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Gogu go mulao gwangu, muli shake.<verse eid="JHN 15:17" /></para>
  <para style="s1">Ilonga lili zimbite abazigigwa</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />Ukuti ilonga kale limizimba, muzibe buti na kumatatikilo nalyani zimba neme. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Ati kwilonga mugwila, kuti limishake kwalyo. Sinagwe ubu likalile, tana mugwila kwilonga, kono nilamiketi anze lyelonga, mpaa muwene limi zimbite. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />Mugaje ibi nana milugwila, ‘Baika tali banene kuita Umfumwabo.’ Ati kame bani pengisa nenwe kuti bamipengise. Ati naba zumina umu zigilo gwangu, kuti bazumine na gwenu. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />Kuti bami pengise kebaka lyo zina lyangu, ukuti tabamwizi uju alanitumi. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />Ukuti tanana keza no kugamba kwabo, tana bagwaninwa ne milandu kono aano tabakwesi inswalelo kububi bwabo. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />Gense uju anizimba ali zimbite na Tata. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Ukuti tananila tendi imisebezi mukati kabo takuli uju naga jitenda, tana bagwaninwa imilandu. Sinagwe akukalile, balikwesi icibi, mi kale bazimbite bantu bobile ime na Tata. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Kono koku ko ku bumbiliza ibi bi ng’olitwe mu milao jabo buti, “Kale bala nizimbi uku takuli ibaka.”<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />“Umugongoza mujo asegula kezi, nini uju saka ni tume kwenu kuzwa kwa Tata, Inkuli je niti iji jizwa kwa Tata, kuti agambe byangu. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />Negwe ulijelele ukupaka, ukuti kale ulabi neme ku matatikilo.<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />Zezi zonse nila mi gambaguza zokuti muleke kugwila anze. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Kuti bamitule anze jo Cinagogi, ni wawa inako kame ji keza, iji ji ta buti gense uju akwiyaga gasa gaja buti ko kusebeleza Nyambe. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />Kuti batende bintu bya bulyao ukuti tabala muzibi Tata kampa ime. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Kale nila milugwili zezi, ukuti inako jabo aa jikeza kuti mugaje buti naa minanguza kaabo. Taa nana mi gambaguza byebi ku matatikilo ukuti kani kele nenwe.</para>
  <para style="s" vid="JHN 16:4">Umusebezi go Moya go Kucena</para>
  <para style="p" vid="JHN 16:4">Taa nana migambaguza zezi ku matatikilo ukuti nenwe kanikele. <verse eid="JHN 16:4" /><verse number="5" style="v" sid="JHN 16:5" />Kono ano kame nija kwa jojo uju naga nituma, ukuti nanga genke gwa kwenu uju anibuza, ‘Uku uja kwi bo?’ <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Kono semuli bumbite ku nshoni, kebaka lyo kuti nilagambi zezi zintu. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Kono za wawa ni milugwila, mi tali ka bilotu byenu aa ni kaja. Bwita aa saka nije, umu gongoza mojo tali gukeze kwenu, kono ukuti kame nija, kuti nani mutume kwako. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />Aa saka akeze, kuti akeze kulukisa ilonga mububi ukuja kobubi ukuti cibi kocili no mububombo ne inkatulo. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />Ukuja kobubi, abantu taba zumini kwangu, <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />Ukuti ububombo kobuli, ukuti kwa Tata nija, uku tana munibone, <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />Imi ukuja ke nkatulo, umujendesi gwa leli ilonga kale ala atulwi.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />Nilikwesi lwini byo kugamba kwenu, bingi kuita ibi mugola kushugwa. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Kono ije, Umoya gwa cote, mi conse aa sejila kezi, kuti ami jendese mu niti jonse. Tali guli gambile ugo mwini, kono kuti agambe ici ashugwa mi kuti amigamba guze ici cibotele uku keza. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />Kuti anicenise ukuti kwangu jizwa buti, kuti atambule ibintu saka apange ibibizibala kwenu. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />Ibintu byonse ibibi botelwe kwa Tata, byangu.<verse eid="JHN 16:15" /></para>
  <para style="s1">Ukujoga no kujangala</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />Jesu kale aja egulu no kugamba buti, “Mwi nako gana tali munibone, mi kame kuti namunibone mu mashule gana.”<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />Kwa ceci, bamwinya ku bazigigwa kale bagamba kwabo, “Intaluso jibo mukugamba, ‘Mwi nako gana tana munibone, mi kame mwi nako gana kuti namunibone,’ ‘Ukuti kwa Tata ni kaja!” <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />Kale bali bika mukubuza, “Cinzi atalusa mukugamba ‘muce gana?’ Tatu shugwisisi ibi agamba!”<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />Jesu kale aziba ibi kababotele kumu buza kuja kazezi, mi kale agamba kwabo, “Kale mukwesi kuli buzagula ibi kanitalusa aa kanigamba, “Mwi nako gana tana munibone, mi mwi nako gana kuti munibone kame? <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />Wawa buti nityo, kuti namulile no kutakuma ilonga aa nalili jangale. Kuti mugene, kono ukugena kwenu kuti nakuzoke kujangala. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Umwanakazi kuzala umwana kuti ashugwe kushisha ukuti inako jakwe kale jakeza, kono mwane asala zaligwi kale azibala amanyando cibaka ce ntabo jakwe jo kuti mwane kale alazaligwi mwilonga. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Aa no kwenu, inshoni kale jakeza, kono kuti nimibone kame mi kuti mulikole, kame takuli muntu uju saka atwale kungi intabo jenu.<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />Mwi juba lyelyo takuli uju saka anibuze. Wawa buti nityo, Tata kuti amiwe conse ici saka mukumbile mwizina lyangu. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Kuzwa aano tamula kumbili cimwinya mwi zina lyangu. Mukumbile mi kuti mutambule, mi ukujangalala kwenu kuti kubumbilile.<verse eid="JHN 16:24" /></para>
  <para style="s1">Jesu naa koma ilonga</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“Kabobo kale ni migamba guza ko manguli, buti inako kame jikekeza iji saka nileke ku gamba nenwe ko manguli kono kuti ni gambe akancenene za Tata. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Mwijuba lyelyo kuti mukumbile mwizina lyangu. Tani gambi buti kuti nikumbile Tata kebaka lyenu. <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />Nee, kono Tata ije mwini ala mishaka ukuti na mwanishaka no kuni zumina buti kwa Tata nizwa. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Kwa Tata kanizwa no kungina mulonga, kono aano senila leka ilonga ni kubogola kwa Tata.”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />Cwale aba zigigwa ba Jesu kale bagamba, “Aano solagamba nenja tosigambi ko magambila sabila. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Cwale kale tulananguli buti, ulizi ibintu byonse mi toshaki umuntu nanga genke kuku buza amapuzo. Ceci cejo citu zuminiza buti kwa Nyambe kozwa.”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />“Semula zumina aano?” Jesu kale ataba. <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />“Inako jila keza mi keniti kale jila kezi aa saka mugundu muke, uju no jo ku munzi gwakwe, mi kuti nisigale nenke. Ukuti tanili nenke, na Tata nikele. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />Kale nila mi gambaguzi zezi zintu, ukuti kwangu mukale mulu jangalo. Kono kuti mukale no mapenzi mwa leli ilonga. Kono mwa kwate umujo! Ilonga nana ligola!”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s1">Jesu aa li lapelela</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Jesu aa salamani uku gamba bobo, kale ga ligamina no kulapela buti, “Tata, inako jila siki. Ulumbe Mwano, buti ne Mwano kuti akulumbe. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />Ukuti nogwa muwa inguzu egulu lyo bantu bonse buti awe bumi tabumani kwa babo bonse abantu aba naga wegwa. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />Cwale bobu ubumi tabumani, buti ku zekelele, igwe bulyo gwe cote Nyambe, mi na Jesu Kilesite uju nagwa tuma. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Nasa kulumba wawa mwi longa ko kumana umusebezi ugu nagwa niwa ukutenda. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />Cwale Tata, uni lumbe abuso bwako ke tuba ili kani kwesi negwe ilonga nali sini uku bumbigwa.<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />Mi nana ku bikulula ku bantu aba nagwa ni shalila noku baniwa mwi longa. Kabali bako mi nogwa baniwa naba shugwa ijwi lyako. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />Cwale kale ba zekelela buti ibintu byonse kwako bizwa. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />Ukuti nana bawa amajwi aga nagwa niwa mi naba ga zumina. Mi kebezi wawa buti kwako ka nizwa, no kuzumina buti nigwe nagwa ni tuma.<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />Nasa ba lapelela. Kumbilila. Tani lapeleli ilonga, kono ku babo nagwa niwa, ukuti bako. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />Byonse ibi ni kwesi byako, mi byonse ukwesi byangu, mi intumbo naja keza kwangu kebaka lyabo. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Mi taa nani kalilile mwilonga, kono mwilonga bekele, mi nasa keza kwenu. Tata go kucena, uba babalele ke nguzu je zina lyako, izina ili nagwa niwa, buti bakale abantu bonke sinagwe ubu tukalile. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Mi aa kanisikele nabo, nana baba balela no kubatula nenja ke zinz lyelyo ili nagwa niwa. Takuli nanga genke uju naga joba bwita bulyo uju ka jelele ukujoba buti aman’olo ga bumbilizwe. <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />Mi aa no kwako ni keza, kono nasa gamba nani sikele mwilonga ukuti bakale no bu bumbililwa gwe ku jangalala kwangu mukati kabo. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Cwale nana bawa ijwi lyako mi ilonga nalya bazimba, ukuti tabali belonga kame sinagwe ime aa tanikele gwelonga. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Intapelo jangu tali jokuta buti ubainde mwilonga kono uba babalele, uba babalele ku mubi. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />Tabali ba mwilonga, sinagwe ime ubu tani kalile gwa mwilonga. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Uba cenise ko cote, ijwi lyako lya cote. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Sinagwe aa nagwa ni tuma mwilonga, nana batuma mwilonga. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Mi nasa licenisa kabo, buti nabo bacenigwe mwa cote.<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />“Intapelo jangu tali jabo bonke, kono nasa lapelela kame na babo aba bazumina kwangu kuja ke ndagano jabo, <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />buti bonse bakale bantu bonke, Tata, sinagwe aukele kwangu mi neme kwako nikele. Cwale nabo kame bakale kwetu buti ilonga lizumine buti nagwa ni tuma. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Mi nana bawa ituba ili nagwa niwa, ukuti bakale bantu bonke sinagwe ubu tukalile neswe. <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />Ime kwabo mi igwe kwangu, buti nabo naba gwanane antuonke. Mi ilonga nali zekelele buti nagwa ni tuma mi ime nana bashaka sinagwe ubu nagwa ni shakila.<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />“Tata nasa shaka buti babo nagwa niwa ku kala neme uku ni kele, mi no kubona ituba lyangu, ituba ili nagwa niwa ukuti nagwa ni shaka ilonga na lisini uku bumbigwa. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />Tata go kucena, nanga buti ilonga tali ku zekelele, ime nili ku zekelele, mi nabo ba lizekelele buti nagwa ni tuma. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Nana leta buti ba zekelele izina lyako mi kuti nanilete buti ni zekelelwe, icisemo ici nagwa nishaka kalyo nalibe kwabo mi neme nibe kwabo.”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s1">Jesu ashuminigwa</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mateu26.47-56</ref>; <ref loc="MRK 14:43-50">Maleka14.43-50</ref>; <ref loc="LUK 22:47-53">Luka22.47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Aa salamani uku lapela, Jesu no bazigigwa bakwe kale ba koshokanya ciilindi ca Kidiloni. Ku lubazu lumwinya ko kakuli igwa, mi Jesu na bazigigwa bakwe kale baja momo mwigwa. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />Mi cwale Judasi uju naga mulegeza, ka zekelele icibaka, ukuti Jesu sali ku gwananamo ne bazigigwa bakwe. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />Mi Judasi kale ga keza kwigwa, najenda ne kagugi ko masole no manduna aba ka bazwa ku bapulisita bakulu no Bafalisi. Naba indite amamonyi, amalampi no bilwiso. <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />Jesu mu ku zekelela ibi jelele ukutendaala kwakwe, mi kale ga zwila anze no kaba buza buti, “Nini uju mushaka?”<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />Mi kale be taba buti, “Jesu gwa Nazaleta.” Jesu kale atyo, “Nime,” (Mi Judasi umulegezi kazimene nabo.) <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />Jesu aa naga gamba buti, “Nime ije,” mi kale kusunduluka mwishule no ku gwila ansi. <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />Mi Jesu kame kale gaba buza buti, “Nini uju mushaka?” Kale betaba buti, “Jesu gwa Nazaleta.”<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />Jesu kale getaba buti, “Kale nala milugwili buti Nime. Ati nime mushaka, cwale muleke baba abakwame bakaje.” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />“Naga gamba bobo ukuti amajwi aga naga gamba galibumbilize, taa nana jobelwa nanga genke kwaba nagwa niwa.<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />Cwale Simoni Pitolosi, uju kakwesi umupene, kale ga gukoka no ku koshola ukutwi ko mulyo ko muika go umupulisita umukulu. (Mi izina lyo muika kalili Maluko.) <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />Jesu kale gatyo kwa Pitolosi buti, “Bogoza umupene gogo mucipusu cago! Ukuti tani jelele kunywina mu nkomosi iji alaniwi Tata?”<verse eid="JHN 18:11" /></para>
  <para style="s1">Jesu aa twaligwa kwa Anasi</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Umukulu go bajendisi bo masole no manduna bo Majuda kale bakwata Jesu no kumu shumina. <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />Mi kale bamutwala tansila kwa Anasi, uju kaali umukwe gwa Kayafa uju kaali Umupulisita Umukulu gogo umwaka. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />Kayafa nije kaali muelezi go mujendisi bo Majuda ukuti kulikele nenja umuntu genke afwila abantu bonse.<verse eid="JHN 18:14" /></para>
  <para style="s1">Uku shampula kwe tanzi kwa Pitolosi</para>
  <para style="r">(<ref loc="MAT 26:69-70">Mateu26.69-70</ref>; <ref loc="MRK 14:66-68">Maleka14.66-68</ref>; <ref loc="LUK 22:55-57">Luka22.55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Simoni Pitolosi na bazigigwa ba mwinya kaba umpilile Jesu. Ukuti jojo umuzigigwa ka zekelelwe kumu pulisita umukulu, kale gakaja ne Jesu mwilapa lyo mupulisita umukulu. <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />Pitolosi aa kasikele anze lyo cinzi. Muzigigwa jumwinya uju kazekelelwe ku mupulisita umukulu, kale ga bogola no kagamba ku muika go mukazana uju kali mulindili gwa acinzi mi kale atwala Pitolosi mukati. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />Mi umuika uju kali mulindili gwa acinzi, kale gatyo kwa Pitolosi buti, “Tali nigwe jumwinya go baika bajoju umukwame? Pitolosi kale getaba buti, “Tali nime.”<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />Mi ka kutontola lwini, mi abaika no manduna kaba zelite amulilo mukujota, Pitolosi naje ka kele nabo naje nazimene bujota.<verse eid="JHN 18:18" /></para>
  <para style="s1">Abapulisita bakulu aa ba buza Jesu</para>
  <para style="r">(<ref loc="MAT 26:59-66">Mateu26.59-66</ref>; <ref loc="MRK 14:55-64">Maleka14.55-64</ref>; <ref loc="LUK 22:66-71">Luka22.66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />Cwale umupulisita umukulu kale abuza Jesu byo bazigigwa bakwe nabyo muzigilo gwakwe. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />Jesu kale abetaba buti, “Senili ku gamba akancenene kwilonga btui, “Inako jonse kaniziga mu macinagoge na mu matempele, umu kaku gwananinanga Amajuda bonse, taa kani gambanga mu buzinda. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Cinzi aa muni buza? Mubuze babo aba naba nishugwa. Balizekelele nenja ibi nana gamba.”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />Jesu aa kakwesi kugamba byebyo, jumwinya go manduna uju kazimene ambali naje kale gamukaba uluaka ku nkumo, natyo buti, “Buti bobu bobo ujelele kutabila ku mupulisita umkulu?”<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />Jesu kale ge mwitaba buti, “Ati senili kugamba ububi, uwe ubumpaki ko bubi kono ati nana gamba nenja cinzi aa unikaba?<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />Cwale Anasi kale gatuminikiza Jesu bushuminitwe kwa Kayafa umupulisita umukulu.<verse eid="JHN 18:24" /></para>
  <para style="s1">Pitolosi ashampula Jesu kame</para>
  <para style="r">(<ref loc="MAT 26:71-75">Mateu26.71-75</ref>; <ref loc="MRK 14:69-72">Maleka14.69-72</ref>; <ref loc="LUK 22:58-62">Luka22.58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Mi Simoni Pitolo si kale bamubuza ao, nakwesi uku jota umulilo buti, “Tali uli jumwinya gwa bazigigwa bakwe?” Mi kale ashampula kame buti, “Tali nime.”<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />Jumwinya muika go bapulisita abakulu, uju ali mwisika lya jojo naga kosholwa kutwi kwa Pitolosi, kale abuza buti, “Taa nana kubona naje mwigwa?”<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />Kame Pitolosi kale amushampula mi mwi nako jejo umukombwe kale gwa tatika ukutungula.<verse eid="JHN 18:27" /></para>
  <para style="s1">Jesu aletwa ku Pilato</para>
  <para style="r">(<ref loc="MAT 27:1">Mateu27.1</ref>; <ref loc="MAT 11-14">11–14</ref>; <ref loc="MRK 15:1">Maleka15.1</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Cwale ao umujendesi bo Majuda kale ainda Jesu ku Kayafa no kumu twala ku muleneng’i go mujendisi gwa Loma. Kono ao kakusili ama siku siku, kono ao kabakwesi kukana kungina mukati ke kuta ukuti balye nenja Mpaseka. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Cwale Pilato kale gazwa mukati kabo no kabuza buti, “Mulandunzi mula mugwanini joju unkosi?”<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />Kale bamutaba Pilato buti, “Ati takaali umuntu mu mangoju tana twa muleta kwako.”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />Pilato kale agamba buti, “Mu mutwale inwe beni mu muatule munguzu jo mulao gwenu.” Kale bakana buti, “kono tatu kwesi intukelo jo kuleka umuntu uju alagwa ninwi umulandu.” <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />Ceci naca tendaala muku bumbiliza ubu nagatyo Jesu ko mufuta go lufwu ulu nafwe.<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />Ao Pilato kale abogola mukati ko muleneng’i, mi kale agula Jesu insaimoni no kumubuza, “Nigwe umulena bo Majuda?”<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />Jesu kale abuza buti, “Go mugajo gwenu gogo, kampa bamwinya binzi bakwesi uku gamba kwangu?”<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />Jesu kale amubuza buti, “Buti nime mujuda?” Pilato kale ataba, “Abantu bako no bakulu bo mulao kale bakuleta kwangu. Cinzi ula tendi?”<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />Jesu kale agamba buti, “Umubuso gwangu tali gwe longa. Ukuti mboo utyo, abaika bangu nabala nilwili buti nilee ku shuminigwa ku bakulu bo Majuda. Kono umubuso gwangu kungi guzwa.”<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />Pilato kale agamba buti, “Buti uli Umfumu?”</para>
  <para style="p" vid="JHN 18:37">Jesu kale ataba buti, “Buti utyo, “Nili Umfumu. Za wawa, ibaka aa nana zaligwa no kuletwa ano elonga lyo kukeza kupaka za conse? Uju gense uju ali kulubazu lwangu ala tegeleza no kunishugwa.”<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />Pilato kale abuza, “conse jibo?” Kazezi kale aja ku Majuda no kagamba buti, “Takuli umulandu ugu nila mugwanili go kumuatula kago. <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />Ngo mukwa gwenu gogo buti ime nizwise jumwinya gwa kwenu mushuminwa muntolongo mwi nako je Mpaseka. Muli botele buti ime nizwise ‘umfumu go Majuda?”<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />Kale bakugiliza kame, “Batili, tali joju! Mutuwe Balabasi!” (Ao Balabasi kali muntu mubi.)<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="s1">Jesu aa tulelwa ulufwu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Cwale Pilato kale aa tula Jesu buti bamukabe. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />Amasole kale ba Zinga Jesu iciusi co miiga, co Bumfumu no ku mutula ku mutwi. Kale bamuzwatisa icizabalo co kubiluluka <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />kame no kuja kwakwe kame, mu kugamba, “Osho, Umfumu go Majuda!” Mi kale batatika kumukaba ku cifateo.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />Pilato kale akeza anze no keza kugamba ku Majuda ao kabakele buti, “Muliwene, kwenu nimuleta ukuti muzibe buti tanila mugwanili umulandu go kumuwa.” <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />Jesu asala zwili anze nazwesi iciusi co Bumfumu ne ciapalo co kusubila, Pilato kale agamba kwabo, “Uju ne nkosi!”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />Kono ao bulyo amapulisita bakulu no bantu babo aba mubona bulyo, kale bakugiliza nabo, “Mu mutwale acifapano! Mu mutwale acifapano!” Kono kale ataba buti, “Mu muinde inwe mu mukokotele. Kwangu ime, tanila mugwanili umulandu go kumuwa.”<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />Amajuda kale bataba Pilato nabo, “Tulikwesi umulao, ukuja ko mulao kwetu aliswanele ukufwa, ukuti kale alitumba buti ni Mwana Nyambe.”<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />Pilato asala shugwi bobo, kale ajoga lwini, <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />mi kale abogola mukati ko muleneng’i, no kumubuza buti, “Uku uzwa kwibo?” Kono Jesu tana gamutaba Pilato.<verse eid="JHN 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 19:10" />Pilato kale amubuza buti “Toshaki kugamba neme, tozi buti nilikwesi inguzu jo ku kushumununa kampa jo ku kushumina?” <verse eid="JHN 19:10" /><verse number="11" style="v" sid="JHN 19:11" />Jesu kale ataba buti, “Ta kokwesi inguzu kwangu ukuti Nyambe tana gala kuwi. Kabobo uju ala nileti mu maganja gako alikwesi icibi kuita negwe.”<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />Kuzwa ao Pilato, kale ajeleka buti alukulule Jesu, kono Amajuda kale bakugiliza nabo, “Ukuti joju unkosi gwasa mulukulula tokwesi icilikani na Sesale! Umuntu gense uju aliwa Ubumfumu kame alwisa Sesale!”<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />Pilato asala shugwi bobo, kale aleta Jesu anze no keza kukala mucipula co buatuli ici ci kugigwa ibwe (“Gabata ko Ciebelu”.) <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />Sekakuli akamwi mi kalili ijuba lyo buitukiso bo Mpaseka, Pilato kale agamba kubantu buti, “Numfumu gwenu!”<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />Kono kale bakugiliza nabo, “Muzwise! Muzwise! Mu mukokotele!”</para>
  <para style="p" vid="JHN 19:15">Pilato kale aba buza buti, “Nikokotile Umfumu gwenu?</para>
  <para style="p" vid="JHN 19:15">Umu pulisita umukulu kale ataba buti, “Tatukwesi Umfumu bwita Sesale!”<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />Ku mamanino Pilato kale agubawa buti bamu kokotele.<verse eid="JHN 19:16" /></para>
  <para style="s">Ku kankaminwa kwa Jesu</para>
  <para style="r">(<ref loc="MAT 27:32">Mateu27.32</ref>; <ref loc="MRK 15:21">Maleka15.21</ref>; <ref loc="LUK 23:26">Luka23.26</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />Jesu aa kalwalite icifapano cakwe, kale aita acibaka cikugigwa “Akatendele.” (Ni “Gologota.” Mu Cihebelu). <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />Uku naba kamu kokotela, jumwinya naje, jumwinya kulubazu, Jesu ije mukati. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />Pilato kale an'ola in'olo no kuli tula acifapano ili kali n'olitwe buti, “Jesu gwa Nazaleta,” Umfumu go Majuda. <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />Bungi bo Majuda kale babala kako akapampili, ku cibaka uku Jesu na kokotelwa afuwi ne munzi, kono ipampili kain'olitwe mu Cihebelu koci Loma muci Gelike. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />Amapulisita bakulu bo Majuda kale batyo ku Pilato, “Uleke uku n'ola “Umfumu go Majuda,’ kono joju unkosi naa ngamba buti, Nime Umfumu go Majuda.’ ”<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />Pilato kale ataba buti, “Ici nilan'oli kuti cisigale nacin’olitwe.”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />Cwale ao amasole kale balegeza Jesu, mi kale bainda ibizwato byakwe no kubilitaila mutubindi tone, konke kujumwinya. Cimwinya iciapalo kacilukitwe bulyao kumatatikilo kutwala ku mamanino gaco. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />Kale baligamba guza buti, “Tuleke ukuci n'atula, ndokweni tutende n'ela buti nini saka ciinde.” Ukuti aman'olo gabumbilizwe agagatyo,</para>
  <para style="q1" vid="JHN 19:24">“Kale balitaila ibizwato byangu mukati kabo,</para>
  <para style="q2" vid="JHN 19:24">no kutenda in'ela amukanjo kwangu.”</para>
  <para style="m" vid="JHN 19:24">Byebi mbebyo nabatenda amasole.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />Nyina Jesu kazimene afui jo cifapano no mukulwee Maria mukazi gwa Kulopa no Maria Magadalena. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />Jesu asalaboni nyina, no muzigigwa uju kashaka nazimene afuwi, kale agamba kumukazi buti, “Maa, mwano uju aa,”<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />No kumuzigigwa, “Ba noko gwako uju aa.” Kuzwa bulyo ao, joju umuzigigwa kale ainda banyina ba Jesu no kubatwala ku njugo jakwe.<verse eid="JHN 19:27" /></para>
  <para style="s1">Ulufwu lwa Jesu</para>
  <para style="r">(<ref loc="MAT 27:45">Mateu27.45</ref>; <ref loc="MRK 15:33">Maleka15.33</ref>; <ref loc="LUK 23:44">Luka23.44</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Mumashule, Jesu kale aziba buti bintu byonse nabya tendala, no kuti aman'olo gala bumbilizwi, mi kale agamba, “Ninyontwa nifwite.”<verse eid="JHN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29" />Mi ko kajikele nkwana iji kaji bumbite vinega momo, mi kale babombeka iciponji no kucitula kukashamu ka hisopa no kunanuna kuleta kukanwa kakwe. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />Jesu asala tambuli icinywantu kale atyo, “Kulamani!”</para>
  <para style="p" vid="JHN 19:30">Mi kale amaninwa ku moya gwakwe go kucena.”<verse eid="JHN 19:30" /></para>
  <para style="s1">Jesu aa ba muweja</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Lyelyo kalili ijuba lyo buitukiso bo Nsabata bunene. Amajuda aba kabajendesa takabashaka buti ibitupu bikale acifapano mwi juba lyo Nsabata mi kale bakumbila Pilato buti baba colagula amatende no mibili jabo jibikigwe. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Kabobo amasole kale bakeza no keza kucola amatende gonkosi gwa tanzi, naga jumwinya uju naga kokotelwa na Jesu. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Kono aa sebala kezi kwa Jesu kale bakeza kugwana nafwite, mi tana bakoshola amatende gakwe. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />Kono jumwinya go masole kale ainda umuwayo no kuweja Jesu mulubazu, mi kale kwazwa amalowa no menzi. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />Cwale unkosi uju naga bona ubupaki bobo, ubupaki bwakwe bwa conse. Alizi buti bya conse agamba, mi kale agamba byebyo buti nenwe muzumine. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Bintu byebi kame bitendala ukuti aman'olo gabumbilizwe. “Takuli nanga cifuwa cakwe ici nacicoke,” <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />Mi aman'olo gamwinya buti atyo, “Kuti babone uju nabaweja.”<verse eid="JHN 19:37" /></para>
  <para style="s1">Kuzikigwa kwa Jesu</para>
  <para style="r">(<ref loc="MAT 27:57">Mateu27.57</ref>; <ref loc="MRK 15:42">Maleka15.42</ref>; <ref loc="LUK 23:50">Luka23.50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Aa sekulamani zezo, Josefa mwana Alimateya kale akumbila kwa Pilato icitupu ca Jesu. Ao Josefa kali muzigigwa gwa Jesu, mi mukulibika kale akumbila icibaka ku Pilato mi kale ainda icitupu no kucitula kungi. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />Nekudemasi naje umuntu gwetanzi uku bona Jesu amasiku naje kale ga musindikiza. Nekodema kale aleta kaga zwakitwe ja mila na aloe mubulemenenwa butenda 45. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Kale bainda icitupu ca Jesu no kucibungila mumasila, ne mishamu jo kununka nenja kuja komulao go Majuda go kuzika. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />Kucibaka ceco uku Jesu nakokotelwa, kokakuli igwa, mi mwigwa momo kakuli ibita, uku tana kwa bikigwa nanga muntu genke. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Kalili ijuba lyo buitukiso bo Majuda, mi ukuti ibita kalili afuwi, uku na bazika a Jesu.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s1">Ibita lyo mukungulu</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mateu28.1-8</ref>; <ref loc="MRK 16:1-8">Maleka16.1-8</ref>; <ref loc="LUK 24:1-12">Luka24.1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Mu masiku siku mwijuba lwatanzi, nakusikele ko kusiya kanini, Maliya Magadalena kale aja kwibita no kagwana buti, ibwe kalili acinzi nalyazwa acinzi. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />Asala boni bulyao, kale akeza bubutuka kwa Simoni Pitolosi no kujumwinya muzigigwa, uju kashakigwa lwini kwa Jesu, no keza kugamba buti, “Umfumu takuli mwibita, kale bala muindi mi tatwizi uku bala mutwali!”<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />Aa sebala shugwi bulyao, Pitolosi nabazigigwa bamwinya kale baja kwibita. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />Bobile bulyao kabakwesi kubutuka, kono muzigigwa jumwinya kale aumpilila Pitolosi no kasika kwibita. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />Mi kale aenja moo no kugwana buti masila bulyo kagali mo kono tana ga ngina mwilambo. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Cwale Simoni Pitolosi kale akeza mu mashule gakwe no keza kungina mwibita. Mi kale abona isila nalikele bulyo acinzi, <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />na kasila aka kaka shuminitwe kumutwi gwakwe. Mi konke bulyo kakakele acibaka ao, mi taka kakele nesila. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Muzigigwa jumwinya gwe tanzi kusika ebita, kale angina mukati no kubona mi kale bazumina. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />(Tana bashugwisisa nenja in’olo ili kaligamba buti, Jesu kuti abuke kulufwu.) <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />Abazigigwa kale badoma uku kaba kalanga.<verse eid="JHN 20:10" /></para>
  <para style="s1">Jesu aliponaaza ku Maliya Magadalena</para>
  <para style="r">(<ref loc="MAT 28:9-10">Mateu28.9-10</ref>; <ref loc="MRK 16:9-11">Maleka16.9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />Maliya kale azimana anze lyebita nakwesi ukulila, mi ao kakwesi ukulila bulyao kale aningama no kulola mo mwibita <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />mi kale abona amangeloi gobile mu biya byo kutuba, nagakele ao kakukele icitupu ca Jesu, lyonke kumutwi lyonke ku matende. <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />Amangiloi kale gabuza mwanakazi buti, “Cinzi ukwesi ukulila?” Mwanakazi kale ataba buti, “Bala muzwisi mo Umfumu, mi tanizi uku bala mutuli!”<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />Kabobo, mwanakazi kale alola ambali mi kale abona Jesu nazimene, kono tana aziba buti ni Jesu kazimene ao. <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />Jesu kale amubuza buti, “Mwanakazi, cinzi ukwesi ukulila? Uju ushaka nini?” Mwanakazi ije, kokugaja buti ni mulimi go lwagwa bunga neje uju nagamuzwisa mo mwibita mi kale atyo buti, “Umfumu, ukuti nigwe ula muzwisi mo, unilugwile bulyo uku almutuli, mi kuti nika muinde.”<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />Jesu kale agamba buti, “Maliya!” Mi kale amubona no kutatika ukulila mu mushobo go ci Alamaiki, “Laboni!” (Ici ci talusa “Muzigi”.)<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />Jesu kale agamba ku mwanakazi buti, “Uleke kunikwata, tansila nisija kwa Tata. Ukaje kubakulwangu mi uka balugwile buti, ‘Kwa Tata nija, mi nenwe nisenu, ku Nyambe gwangu kame ni Nyambe gwenu.’”<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />Maliya Magadalena kale aja ku bazigigwa no lugambo lokuti, “Nila muboni Umfumu.” Mi kale abagamba guza buti, ala mulugwili gago amajwi.<verse eid="JHN 20:18" /></para>
  <para style="s">Jesu aliponaaza ku bazigigwa bakwe</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Kumatatikilo ge nsunda ku matengu, abazigigwa aa kabakele antu onke, na kukitwe kucinzi kujoga abakulu bo Majuda, mi Jesu kale akeza no keza kuzimana mukati kabo nokuti, “Inkozo jibe nenwe.” <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />Mu mashule go kugamba zezo, kale abasunda mumaganja na kusilya. Abazigigwa naba jangala lwini aa naba bona Umfumu. <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />Kame Jesu kale agamba buti, “Inkozo jibe nenwe, sinsgwe Tata alanitumi mi kale nimituma neme.” <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />Asala gambi bobo, kale abaujila umuuja no kugamba buti, “Mutambule Moya go Kucena.” <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />Ukuti ula kwatila abagenzenu, ibibi byabo kale bila kwatilwi, ukuti tobakwatili, tabala kwatilwi nabo.<verse eid="JHN 20:23" /></para>
  <para style="s">Jesu na Tomasi</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />Ao Tomasi (uju kakugigwa majovu), jumwinya go bekumi na tobile, takakele naba zigigwa aa nakeza Jesu. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />Abazigigwa bamwinya kale bamulugwila buti, “Tula boni Umfumu!” Kono Tomasi uju akugigwa majovu kale agamba buti, “Bunga saka ni bone aa naganginina amamapo mumanganja no kutula umunwe gwangu umu nakwanginina amamapo, no kutula amaganja gangu kulubazu lyeganja lyakwe, aiba tali bulyao tali ni zumine!”<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />Mumashule ge nsunda abazigigwa ba Jesu kame kabakele munjugo, mi Tomasi kakele nabo. Jesu kale akeza mukati kabo kucinzi nakukitwe nokeza kugamba buti, “Inkozo jibe nenwe!” <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />Mi Jesu kale agamba kwa Tomasi buti, “Bika umunwe gwako aa, bona amaganja gangu. Itisa iganja lyako kusilya mi ukwate ku lubazu lwangu. Uleke ukukana mi uzumine!”<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />Tomasi kale agamba kwakwe buti, “Mfumwangu na Nyambe gwangu!”<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />Jesu kale ata buti, “Ukuti mula ni boni, mula zumini, mi infwijaguzi jababo aba tabala boni kono balazumini.”<verse eid="JHN 20:29" /></para>
  <para style="s1">Umugajalo gwe buka</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Jesu naga tenda ibisupo bimwinya ibingi akati ko bazigigwa bakwe, ibi tabi muli momu mwi buka. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Kono byebi nabya n’oligwa buti muzumine buti Jesu ni Mesiya, Mwana Nyambe, mi muku zumina namu gwane ubumi mwi zina lyakwe.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">Jesu alibonaaza ku bazigigwa bakwe mwa Galileya</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Mu mashule gana, Jesu kame kale aliponaza kubazigigwa bakwe, ekamba lyeziba lya Tabeliyasi. Nakwa tendaala bobo buti, <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Simoni Pitolosi, Tomasi (uju azibigwa Majovu), Natanaele uju azwa kwa Kanana mwa Galileya, bana Zebedeya na bazigigwa bobile kabakele antu onke. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />Simoni Pitolosi kale agamba buti, “Kame nija kuku kwata inswi,” mi kale batyo buti,</para>
  <para style="p" vid="JHN 21:3">“Kuti tuje negwe.” Kale baja no kangina mubwato, kono gago amasiku takuli ici nabagwana. <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />Mu masikusiku, Jesu kale azimana ekamba, kono abazigigwa tana baziba buti ni Jesu. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />Kale aba buza buti, “Basele, tamukwesi cokulya?” Kale bataba nabo,</para>
  <para style="p" vid="JHN 21:5">“Takuli inswi.”<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />Kale agamba naje buti, “Mushonjele akanyandi kwi ganja lyenu lyo cilyo mi kuti mugwane.” Mi asebala tendi bulyao, kale bakwata icikutu cingi censwi. Mi aa tendi bobo, taa kaba gola uku koka akanyandi kebaka lyo bungi bwe inswi.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />Muzigigwa uju kashakigwa lwini kwa Jesu kale agamba kwa Pitolosi buti, “Ni ntaelo jo Umfumu!” Ao bwangu bulyo Simoni Pitolosi asala shugwi agamba bulyao kale atyo, “Nimfumu alatuwi,” Simoni Pitolosi kale ajabala icizabalo cakwe (ici naga zula) no kushotokela mu menzi. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />Abazigigwa bamwinya kale ba muumpilila no bwato, nabakwesi ukujambula akanyandi kaka bumbite inswi, kono taka bali kule nekamba, mu bibima bigola uku sika a 90. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />Ase bafugula, kale babona amakala gakwesi ukuzunga nenswi oo, no binkwa. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />Jesu kale agamba kwabo, “Mulete inswi zimwinya izi mulakwati.”<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />Mi Simoni Pitolosi kale ashotokela kumashule go bwato no kukokela akanyandi ekamba. Kaka bumbite kenswi zinene, za 153 zonse, nanga aa kazili ningi kono akanyandi tana kan’atuka. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />Jesu kale agamba kwabo, “Mukeze mulye umulisuko.” Kono kubazigigwa takuli uju kagongoza umojo gwakwe buti amubuze, “Ni gwe ni?” Mi kale baziba buti kaali Umfumu. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />Jesu kale akeza, kuinda icinkwa no kujibawa mi kale atenda bulyao nenswi.<verse eid="JHN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14" />Gogu kaguli umubonalilo gwe tatwe ugu naga liponaza kubazigigwa bakwe kuzwilila kulubuko lo lufu.<verse eid="JHN 21:14" /></para>
  <para style="s1">Jesu na Petolosi</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Aseba mani kulya, Jesu kale agamba ku Simoni Pitolosi buti, “Simoni mwana Joani, kuti ulanishaka lwini?”</para>
  <para style="p" vid="JHN 21:15">Mi kale ataba naje, “Ulizi buti Nila kushaka.”</para>
  <para style="p" vid="JHN 21:15">“Mi Jesu” Kale agamba buti, “Umamele abangu bangu.” <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />Jesu kame kale abuza but, “Simoni mwana Joani, ula Ni shaka?” Kale ataba naje, “Bulyao Umfumu, ulizi buti nila kushaka.”</para>
  <para style="p" vid="JHN 21:16">Jesu kale agamba naje, “Umamele abangu bangu.” <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />Umu bonalilo gwe tatwe kale agamba buti, “Simoni mwana Joani, ula ni shaka?”</para>
  <para style="p" vid="JHN 21:17">Pitolosi naga shugwa uku shisha kumojo kakuli kaguli umubuzizo go butatwe naje, “Ulanishaka?” Kale amutaba buti, “Umfumu, ulizi bintu byonse, ulizi buti ni lakushaka”</para>
  <para style="p" vid="JHN 21:17">Mi Jesu kale agamba, “Ulele ingu jangu. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Zawawa buti nityo, akosili mwanuke koli zwatikanga igwe mwini no kuja konse koshaka, kono asoli mukulu kuti ugolole amaganja gako, mi jumwinya kuti akuzwatike no kukutwala uku toshaki kuja.” <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />Jesu aa kagamba bulyao, katengulula byo lufwu lwa Pitolosi ulu saka alumbe Nyambe kalo. Cwale kale agamba kwakwe buti, “Ni umpilile!”<verse eid="JHN 21:19" /></para>
  <para style="s">Jesu na nazigigwa bamwinya</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />Pitolosi kale azoka mi kale abona umu zigigwa uju ka shakigwa kwa Jesu na mu umpilile. Uju naga zendamina acizuba ca Jesu amulalilo kale agamba, “Umfumu nini uju saka akulegeze?” <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />Pitolosi asala muboni, kale amubuza, “Umfumu, buti kwakwe?”<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />Jesu kale ataba naje, “Ukuti ni lashaka kumuleka najoja kuitila aa saka nikezele, ceco cinzi kwenu? Muli jelele uku ni umpilila!”<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />Kebaka lya bulyao, imishoboto naja janduluka mukati ko bazumini buti joju muzigigwa tali afwe. Kono Jesu tana gamba buti taa na fwe, kono naga gamba bulyo buti, “Ukuti nila shaka buti asigale, cinzi ceco kwenu?”<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />Muzigigwa joju neje apaka byebi bintu mi neje umun'oli gwabyo, kame tulizi buti ubupaki bobu bwa conse.<verse eid="JHN 21:24" /></para>
  <para style="s">Mamaninino</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Jesu kale natenda bintu bimwinya bingi ka bulyao. Kambe byonse nabya n'oligwa, nanga ilonga lyonse tana likwesi icibaka co mabuka aga naga n'oligwa.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>