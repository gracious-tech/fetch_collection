  <para style="h">Miikiyaas</para>
  <para style="toc1">Nabiiʼiyyii Miikiyaas</para>
  <para style="toc2">Miikiyaas</para>
  <para style="toc3">Mik</para>
  <para style="mt2">Nabiiʼiyyii</para>
  <para style="mt1">Miikiyaas</para>
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />Bara Yootaam, Aahaazii fi Hisqiyaas mootota Yihuudaa turan keessa dubbiin Rabbii Allaah gara Miikiyaas namicha Mooresheet dhufe; kunis mulʼata inni waaʼee Samaariyaatii fi waaʼee Yerusaalem argee dha.<verse eid="MIC 1:1" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2" />Yaa namoota, isin hundinuu dhagaʼaa;</para>
  <para style="q2" vid="MIC 1:2">lafaa fi wantoonni ishee irra jiraattan hundinuu dhaggeeffadhaa;</para>
  <para style="q1" vid="MIC 1:2">Rabbii Allaahan Gooftichi,</para>
  <para style="q2" vid="MIC 1:2">Gooftaan mana qulqullummaa isaa qulqulluu sana keessaa <optbreak /> dhugaa isinitti baʼa.<verse eid="MIC 1:2" /></para>
  <para style="s1">Murtii Samaariyaa fi Yerusaalemin Eeggatu</para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3" />Kunoo! Rabbii Allaahan iddoo jireenya isaatii dhufaa jira;</para>
  <para style="q2" vid="MIC 1:3">inni gad dhufee iddoo ol kaʼaa lafaa irra ni ejjeta.<verse eid="MIC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4" />Akkuma gagaa fuula ibiddaa dura jiruu,</para>
  <para style="q2" vid="MIC 1:4">akkuma bishaan tabba irraa gad yaaʼuu</para>
  <para style="q1" vid="MIC 1:4">tulluuwwan isa jalatti ni baqu;</para>
  <para style="q2" vid="MIC 1:4">sululawwanis gargar baqaqu.<verse eid="MIC 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5" />Wanni kun hundi sababii dogoggora Yaaʼikuubiif,</para>
  <para style="q2" vid="MIC 1:5">sababii cubbuu mana Israaʼeliif taʼe.</para>
  <para style="q1" vid="MIC 1:5">Dogoggorri Yaaʼikuub maali?</para>
  <para style="q2" vid="MIC 1:5">Samaariyaa mitii?</para>
  <para style="q1" vid="MIC 1:5">Iddoon sagadaa Yihuudaa maali?</para>
  <para style="q2" vid="MIC 1:5">Yerusaalem mitii?<verse eid="MIC 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6" />“Kanaafuu ani Samaariyaa tuullaa diigamaa,</para>
  <para style="q2" vid="MIC 1:6">lafa wayinii itti dhaabbatan nan godha.</para>
  <para style="q1" vid="MIC 1:6">Ani dhagaawwan ishee sululatti naqee,</para>
  <para style="q2" vid="MIC 1:6">hundee ishee qullaa nan hambisa.<verse eid="MIC 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7" />Waaqeffatamtoonni ishee tolfamoon hundinuu ni hurreeffamu;</para>
  <para style="q2" vid="MIC 1:7">kennaawwan mana qulqullummaa ishee hundinuu ibiddaan gubamu;</para>
  <para style="q2" vid="MIC 1:7">ani fakkii ishee hunda nan barbadeessa.</para>
  <para style="q1" vid="MIC 1:7">Isheen gatii sagaagaltootaa irraa kennaa ishee walitti waan qabatteef,</para>
  <para style="q2" vid="MIC 1:7">kennaan sun ammas gatii sagaagaltootaa taʼee ni deebiʼa.”<verse eid="MIC 1:7" /></para>
  <para style="s1">Booʼuu fi Gadduu</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8" />Sababii waan kanaatiif ani booʼee nan wawwaadha;</para>
  <para style="q2" vid="MIC 1:8">ani miilla duwwaa fi qullaa nan deema.</para>
  <para style="q1" vid="MIC 1:8">Ani akkuma waangoo iyyee,</para>
  <para style="q2" vid="MIC 1:8">akkuma urunguu nan aada.<verse eid="MIC 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9" />Madaan ishee waan hin fayyineef,</para>
  <para style="q2" vid="MIC 1:9">Yihuudaattis darbeera.</para>
  <para style="q1" vid="MIC 1:9">Karra saba koo dura gaʼeera;</para>
  <para style="q2" vid="MIC 1:9">Yerusaalemittis dhufeera.<verse eid="MIC 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10" />Isin waan kana Gaati keessatti hin dubbatinaa;</para>
  <para style="q2" vid="MIC 1:10">gonkumaa hin booʼinaa.</para>
  <para style="q1" vid="MIC 1:10">Beet Leʼafraatti,</para>
  <para style="q2" vid="MIC 1:10">awwaara keessa gangaladhaa.<verse eid="MIC 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11" />Isin warri Shaafiir keessa jiraattan,</para>
  <para style="q2" vid="MIC 1:11">qullaa fi qaaniidhaan darbaa.</para>
  <para style="q1" vid="MIC 1:11">Warri Zanaan keessa jiraatan,</para>
  <para style="q2" vid="MIC 1:11">gad hin baʼan.</para>
  <para style="q1" vid="MIC 1:11">Beet Eezel booʼicha irra jirti;</para>
  <para style="q2" vid="MIC 1:11">eegumsi ishee isin irraa fuudhameera.<verse eid="MIC 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12" />Sababii balaan Rabbii Allaah biraa dhufee</para>
  <para style="q2" vid="MIC 1:12">karra Yerusaalem iyyuu gaʼeef,</para>
  <para style="q1" vid="MIC 1:12">warri Maaroot keessa jiraatan</para>
  <para style="q2" vid="MIC 1:12">gargaarsa argachuuf wixxirfatu.<verse eid="MIC 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13" />Ati Laakkiish keessa kan jiraattu,</para>
  <para style="q2" vid="MIC 1:13">fardeen gaariitti hidhadhu.</para>
  <para style="q1" vid="MIC 1:13">Ati Intala Xiyooniif</para>
  <para style="q2" vid="MIC 1:13">jalqaba cubbuu ti;</para>
  <para style="q1" vid="MIC 1:13">dogoggorri Israaʼel</para>
  <para style="q2" vid="MIC 1:13">siʼi keessatti argamaatii.<verse eid="MIC 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14" />Kanaafuu ati Mooresheet Gaatiif</para>
  <para style="q2" vid="MIC 1:14">kennaa kennita.</para>
  <para style="q1" vid="MIC 1:14">Manneen Akziib mootota Israaʼeliif</para>
  <para style="q2" vid="MIC 1:14">gowwoomsitoota taʼu.<verse eid="MIC 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15" />Ani warra Maareeshaa keessa jiraattanitti</para>
  <para style="q2" vid="MIC 1:15">moʼataa tokko nan fida.</para>
  <para style="q1" vid="MIC 1:15">Inni ulfina Israaʼel taʼe</para>
  <para style="q2" vid="MIC 1:15">gara Adulaam ni dhufa.<verse eid="MIC 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16" />Sababii gadda ijoollee itti gammadduutiif jedhii</para>
  <para style="q2" vid="MIC 1:16">mataa kee haaddadhu;</para>
  <para style="q1" vid="MIC 1:16">akkuma goggocoroo mataa kee moleeffadhu;</para>
  <para style="q2" vid="MIC 1:16">isaan boojuudhaan sirraa fudhatamuutii.<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="s1">Karoora Namaatii fi Karoora Allaah</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1" />Warra daba karoorfatan</para>
  <para style="q2" vid="MIC 2:1">kanneen siree isaanii irra <optbreak /> ciisanii hammina yaadaniif wayyoo!</para>
  <para style="q1" vid="MIC 2:1">Sababii waan kana hojjechuun humna isaanii jala jiruuf</para>
  <para style="q2" vid="MIC 2:1">isaan ifa bariitiin kaʼanii waan sana hojjetu.<verse eid="MIC 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2" />Isaan lafa qotiisaa kajeelanii qabatu;</para>
  <para style="q2" vid="MIC 2:2">manneenis akkasuma kajeelanii fudhatu.</para>
  <para style="q1" vid="MIC 2:2">Isaan gowwoomsaadhaan mana namaa,</para>
  <para style="q2" vid="MIC 2:2">dhaala isaas ni fudhatu.<verse eid="MIC 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3" />Kanaafuu Rabbii Allaahan akkana jedha;</para>
  <para style="q1" vid="MIC 2:3">“Kunoo ani balaa isin jalaa baʼuu hin dandeenye tokko</para>
  <para style="q2" vid="MIC 2:3">saba kanatti fiduuf karoorfadheen jira.</para>
  <para style="q1" vid="MIC 2:3">Isin siʼachi of tuulummaadhaan jiraachuu hin dandeessan;</para>
  <para style="q2" vid="MIC 2:3">yeroon kun yeroo rakkinaa taʼaatii.<verse eid="MIC 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4" />Bara sana keessa namoonni isinitti gaʼisu;</para>
  <para style="q2" vid="MIC 2:4">akkana jedhaniis faaruu booʼichaa kanaan isinitti qoosu;</para>
  <para style="q1" vid="MIC 2:4">‘Nu guutumaan guutuutti barbadoofneerra;</para>
  <para style="q2" vid="MIC 2:4">qabeenyi saba kootiis gargar qooddatameera.</para>
  <para style="q1" vid="MIC 2:4">Inni narraa fudhata!</para>
  <para style="q2" vid="MIC 2:4">Lafa qotiisaa keenya warra nu moʼataniif kenna.’ ”<verse eid="MIC 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5" />Kanaafuu ati nama ixaadhaan lafa qoodu tokko illee</para>
  <para style="q2" vid="MIC 2:5">waldaa Rabbii Allaah keessaa hin qabaattu.<verse eid="MIC 2:5" /></para>
  <para style="s1">Nabiiʼiyyoota Sobaa</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6" />Nabiiʼiyyoonni isaanii, “Isin raajii hin dubbatinaa;</para>
  <para style="q2" vid="MIC 2:6">waaʼee waan kanaa raajii hin dubbatinaa;</para>
  <para style="q2" vid="MIC 2:6">salphinni nutti hin dhufu” jedhu.<verse eid="MIC 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7" />Yaa mana Yaaʼikuub, “Wanni kun akkana jedhamuu qabaa?</para>
  <para style="q2" vid="MIC 2:7">Hafuurri Rabbii Allaah obsa hin qabuu?</para>
  <para style="q2" vid="MIC 2:7">Inni waan akkasii ni hojjetaa?”</para>
  <para style="b" vid="MIC 2:7" />
  <para style="q1" vid="MIC 2:7">“Nama karaan isaa qajeelaa taʼeef</para>
  <para style="q2" vid="MIC 2:7">dubbiin koo waan gaarii hin hojjetuu?<verse eid="MIC 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8" />Sabni koo akka diinatti kaʼeera.</para>
  <para style="q2" vid="MIC 2:8">Isin namoota yaaddoo malee achiin darban</para>
  <para style="q2" vid="MIC 2:8">kanneen duulaa galaa jiran irraa uffata baafattu.<verse eid="MIC 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9" />Isin dubartoota saba kootii</para>
  <para style="q2" vid="MIC 2:9">manneen isaanii babbareedoo keessaa ariitu.</para>
  <para style="q1" vid="MIC 2:9">Eebba koos bara baraan</para>
  <para style="q2" vid="MIC 2:9">ijoollee isaanii irraa fudhattu.<verse eid="MIC 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10" />Kaʼaatii asii deemaa!</para>
  <para style="q2" vid="MIC 2:10">Iddoon kun lafa boqonnaa keessanii miti;</para>
  <para style="q2" vid="MIC 2:10">isheen xurooftee diigamtee baddeerti.<verse eid="MIC 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11" />Namni sobaa fi gowwoomsaan tokko yoo dhufee,</para>
  <para style="q2" vid="MIC 2:11">‘Ani waaʼee daadhii wayiniitii fi</para>
  <para style="q2" vid="MIC 2:11">dhugaatii cimaa raajii siif nan dubbadha’ jedhe;</para>
  <para style="q2" vid="MIC 2:11">inni nabiiʼiyyii saba kanaa taʼa!<verse eid="MIC 2:11" /></para>
  <para style="s1">Furamni Waadaa Galame</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12" />“Yaa Yaaʼikuub, ani dhugumaan</para>
  <para style="q2" vid="MIC 2:12">isin hunda walitti nan qaba;</para>
  <para style="q2" vid="MIC 2:12">ani hambaa Israaʼel walitti nan fida.</para>
  <para style="q1" vid="MIC 2:12">Ani akkuma hoolota gola keessaatti,</para>
  <para style="q2" vid="MIC 2:12">akkuma bushaayee lafa dheedaa jiraniitti walitti isaan nan fida;</para>
  <para style="q2" vid="MIC 2:12">lafti sunis tuuta namaatiin guutamti.<verse eid="MIC 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13" />Inni cabsee karaa baasu fuula isaanii dura deema;</para>
  <para style="q2" vid="MIC 2:13">isaan cabsanii karraan baʼu.</para>
  <para style="q1" vid="MIC 2:13">Mootiin isaanii isaan dura baʼa;</para>
  <para style="q2" vid="MIC 2:13">Rabbii Allaahan fuula isaanii dura deema.”<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="s1">Hooggantoonnii fi Nabiiʼiyyoonni Balaaleffataman</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1" />Ergasii ani akkanan jedhe;</para>
  <para style="q1" vid="MIC 3:1">“Isin hooggantoonni Yaaʼikuub,</para>
  <para style="q2" vid="MIC 3:1">bulchitoonni mana Israaʼel mee dhaggeeffadhaa.</para>
  <para style="q1" vid="MIC 3:1">Isin murtii qajeelaa beekuu hin qabdanii?<verse eid="MIC 3:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="MIC 3:2" />Isin warri waan gaarii jibbitanii waan hamaa jaallattan,</para>
  <para style="q1" vid="MIC 3:2">warri saba koo irraa gogaa,</para>
  <para style="q2" vid="MIC 3:2">lafee isaanii irraa immoo foon baaftan,<verse eid="MIC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3" />warri foon saba koo nyaattan,</para>
  <para style="q2" vid="MIC 3:3">kanneen gogaa isaanii irraa qunciftanii <optbreak /> lafee isaanii caccabsitan,</para>
  <para style="q1" vid="MIC 3:3">isin warri akka foon eeleetti waadamuutii fi</para>
  <para style="q2" vid="MIC 3:3">okkoteetti affeelamuu isaan ciccirtan</para>
  <para style="q2" vid="MIC 3:3">murtii qajeelaa beekuu hin qabdanii?”<verse eid="MIC 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4" />Ergasii isaan Rabbii Allaahatti iyyatu;</para>
  <para style="q2" vid="MIC 3:4">inni garuu deebii hin kennuuf.</para>
  <para style="q1" vid="MIC 3:4">Yeroo sanatti inni sababii cubbuu</para>
  <para style="q2" vid="MIC 3:4">isaan hojjetaniitiif fuula isaa isaan duraa ni dhokfata.<verse eid="MIC 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5" />Rabbii Allaahan akkana jedha:</para>
  <para style="q1" vid="MIC 3:5">“Waaʼee nabiiʼiyyoota</para>
  <para style="q2" vid="MIC 3:5">saba koo karaa irraa jalʼisanii,</para>
  <para style="q1" vid="MIC 3:5">yoo namni tokko nyaata kenneef</para>
  <para style="q2" vid="MIC 3:5">isaan ‘Nagaa’ labsu;</para>
  <para style="q1" vid="MIC 3:5">yoo inni akkas gochuu baate immoo</para>
  <para style="q2" vid="MIC 3:5">lola isatti kaasuuf qophaaʼu.<verse eid="MIC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6" />Kanaafuu utuu isin mulʼata hin argin halkan,</para>
  <para style="q2" vid="MIC 3:6">utuu isin hooda hin dubbatin immoo dukkanni isinitti dhufa.</para>
  <para style="q1" vid="MIC 3:6">Aduun nabiiʼiyyootatti dhiiti;</para>
  <para style="q2" vid="MIC 3:6">guyyaanis isaanitti dukkanaaʼa.<verse eid="MIC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7" />Ilaaltonni ni qaanaʼu;</para>
  <para style="q2" vid="MIC 3:7">warri hooda dubbatanis ni salphifamu.</para>
  <para style="q1" vid="MIC 3:7">Sababii deebiin tokko iyyuu Allaah biraa hin dhufneef</para>
  <para style="q2" vid="MIC 3:7">isaan hundi fuula haguuggatu.”<verse eid="MIC 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8" />Ani garuu Yaaʼikuubitti balleessaa isaa,</para>
  <para style="q2" vid="MIC 3:8">Israaʼelittis cubbuu isaa himuuf</para>
  <para style="q2" vid="MIC 3:8">humnaan guutameera;</para>
  <para style="q1" vid="MIC 3:8">Hafuura Rabbii Allaahatiin</para>
  <para style="q2" vid="MIC 3:8">murtii qajeelaa fi jabinaan guutameera.<verse eid="MIC 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9" />Isin hooggantoonni mana Yaaʼikuub</para>
  <para style="q2" vid="MIC 3:9">bulchitoonni mana Israaʼel</para>
  <para style="q1" vid="MIC 3:9">warri murtii qajeelaa tuffattanii</para>
  <para style="q2" vid="MIC 3:9">waan sirrii taʼe hunda jalʼiftan waan kana dhagaʼaa;<verse eid="MIC 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10" />warri dhiiga dhangalaasuudhaan Xiyoonin,</para>
  <para style="q2" vid="MIC 3:10">hamminaan immoo Yerusaalemin ijaartan waan kana dhagaʼaa.<verse eid="MIC 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11" />Hooggantoonni ishee mattaʼaa fudhatanii murtii kennu;</para>
  <para style="q2" vid="MIC 3:11">luboonni ishee gatiidhaan barsiisu;</para>
  <para style="q2" vid="MIC 3:11">nabiiʼiyyoonni ishees maallaqa fudhatanii hooda dubbatu.</para>
  <para style="q1" vid="MIC 3:11">Taʼus isaan Rabbii Allaahatti irkatanii,</para>
  <para style="q2" vid="MIC 3:11">“Rabbii Allaahan gidduu keenya jira mitii?</para>
  <para style="q2" vid="MIC 3:11">Balaan tokko iyyuu nutti hin dhufu” jedhu.<verse eid="MIC 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12" />Kanaafuu sababii keessaniif,</para>
  <para style="q2" vid="MIC 3:12">Xiyoon akkuma lafa qotiisaatti qotamti;</para>
  <para style="q1" vid="MIC 3:12">Yerusaalemis tuullaa waan diigamee taati;</para>
  <para style="q2" vid="MIC 3:12">gaarri mana qulqullummaas tabba daggalaan liqimfame taʼa.<verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="s1">Tulluu Rabbii Allaah</para>
  <para style="r">
    <ref loc="MIC 4:1-3">4:1‑3</ref> kwf – <char style="xt"><ref loc="ISA 2:1-4">Isa 2:1‑4</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1" />Bara dhumaa keessa</para>
  <para style="q1" vid="MIC 4:1">tulluun mana qulqullummaa Rabbii Allaah</para>
  <para style="q2" vid="MIC 4:1">tulluuwwan hunda keessaa ol dheeratee dhaabata;</para>
  <para style="q1" vid="MIC 4:1">inni gaarran caalaa ol ol jedha;</para>
  <para style="q2" vid="MIC 4:1">namoonnis itti yaaʼu.<verse eid="MIC 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 4:2" />Saboonni baayʼeen dhufanii akkana jedhu;</para>
  <para style="q1" vid="MIC 4:2">“Kottaa gara tulluu Rabbii Allaaha,</para>
  <para style="q2" vid="MIC 4:2">gara mana Allaah Yaaʼikuub ol baanaa.</para>
  <para style="q1" vid="MIC 4:2">Inni akka nu daandii isaa irra deemnuuf</para>
  <para style="q2" vid="MIC 4:2">karaa isaa nu barsiisa.”</para>
  <para style="q1" vid="MIC 4:2">Seerri Xiyoon keessaa,</para>
  <para style="q2" vid="MIC 4:2">dubbiin Rabbii Allaah immoo Yerusaalem keessaa dhufa.<verse eid="MIC 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3" />Inni namoota hedduu gidduutti murtii kennee</para>
  <para style="q2" vid="MIC 4:3">saboota jajjaboo gargar fagoo jiranis walitti araarsa.</para>
  <para style="q1" vid="MIC 4:3">Isaan goraadee isaanii tumanii maarashaa,</para>
  <para style="q2" vid="MIC 4:3">eeboo isaanii illee haamtuu tolfatu.</para>
  <para style="q1" vid="MIC 4:3">Sabni tokko saba biraatti goraadee hin luqqifatu</para>
  <para style="q2" vid="MIC 4:3">yookaan waraanaaf jedhanii siʼachi nama hin leenjisan.<verse eid="MIC 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4" />Namni hundi muka wayinii isaatii fi</para>
  <para style="q2" vid="MIC 4:4">muka harbuu isaa jala taaʼa;</para>
  <para style="q1" vid="MIC 4:4">Rabbii Allaahan Waan Hunda Dandaʼu dubbateeraatii</para>
  <para style="q2" vid="MIC 4:4">namni isaan sodaachisu tokko iyyuu hin jiru.<verse eid="MIC 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5" />Saboonni hundinuu</para>
  <para style="q2" vid="MIC 4:5">maqaa waaqeffatamtoota isaaniitiin deddeebiʼu;</para>
  <para style="q1" vid="MIC 4:5">nu immoo bara baraa hamma bara baraatti</para>
  <para style="q2" vid="MIC 4:5">maqaa Rabbii Allaah keenyaatiin deddeebina.<verse eid="MIC 4:5" /></para>
  <para style="s1">Karoora Rabbii Allaah</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6" />Rabbii Allaahan akkana jedha;</para>
  <para style="q2" vid="MIC 4:6">“Ani bara sana naafa walittin qaba;</para>
  <para style="q1" vid="MIC 4:6">warra boojiʼamanii fi</para>
  <para style="q2" vid="MIC 4:6">warra ani gaddisiises walittin qaba.<verse eid="MIC 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7" />Ani warra naafa hambaa,</para>
  <para style="q2" vid="MIC 4:7">warra ariʼame immoo saba jabaa nan godha.</para>
  <para style="q1" vid="MIC 4:7">Rabbii Allaahan guyyaa sanaa jalqabee</para>
  <para style="q2" vid="MIC 4:7">hamma bara baraatti Tulluu Xiyoon irratti bulchaa isaanii taʼa.<verse eid="MIC 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8" />Yaa gamoo eegumsa bushaayee,</para>
  <para style="q2" vid="MIC 4:8">yaa daʼoo Intala Xiyoon,</para>
  <para style="q1" vid="MIC 4:8">ol aantummaan durii siif ni deebifama;</para>
  <para style="q2" vid="MIC 4:8">mootummaan Intala Yerusaalem ni dhufa.”<verse eid="MIC 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9" />Ati amma maaliif akkana iyyitee boossa?</para>
  <para style="q2" vid="MIC 4:9">Ati mootii hin qabduu?</para>
  <para style="q1" vid="MIC 4:9">Wanni ati akka dubartii ciniinsuun qabee miixattuuf</para>
  <para style="q2" vid="MIC 4:9">gorsaan kee badeetii?<verse eid="MIC 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10" />Yaa Intala Xiyoon,</para>
  <para style="q2" vid="MIC 4:10">akkuma dubartii ciniinsuun qabeetti aadi;</para>
  <para style="q1" vid="MIC 4:10">ati amma bakkee keessa qubachuuf</para>
  <para style="q2" vid="MIC 4:10">magaalaa keessaa baʼuu qabdaatii.</para>
  <para style="q1" vid="MIC 4:10">Ati Baabilon dhaqxa;</para>
  <para style="q2" vid="MIC 4:10">achitti ni baraaramta.</para>
  <para style="q1" vid="MIC 4:10">Rabbii Allaahan achitti</para>
  <para style="q2" vid="MIC 4:10">harka diina keetii keessaa si fura.<verse eid="MIC 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11" />Amma garuu saboonni hedduun si marsaniiru.</para>
  <para style="q2" vid="MIC 4:11">Isaanis, “Isheen haa xurooftu;</para>
  <para style="q1" vid="MIC 4:11">iji keenya xiyyeeffatee</para>
  <para style="q2" vid="MIC 4:11">Xiyoonin haa ilaalu!” jedhu.<verse eid="MIC 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12" />Isaan garuu yaada Rabbii Allaah hin beekan;</para>
  <para style="q2" vid="MIC 4:12">isaan karoora isaa kan inni akkuma bissii</para>
  <para style="q2" vid="MIC 4:12">oobdiitti walitti qabe sana hin hubatan.<verse eid="MIC 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13" />“Yaa Intala Xiyoon kaʼiitii midhaan dhaʼi;</para>
  <para style="q2" vid="MIC 4:13">ani gaanfa sibiilaa siif nan kennaatii;</para>
  <para style="q1" vid="MIC 4:13">ani kottee naasii siif nan kenna;</para>
  <para style="q2" vid="MIC 4:13">atis saboota baayʼee caccabsita.”</para>
  <para style="q1" vid="MIC 4:13">Ati horii isaan karaa hamaadhaan argatan Rabbii Allaahaf kennita;</para>
  <para style="q2" vid="MIC 4:13">qabeenya isaaniis Gooftaa lafa hundaatiif kennita.<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="s1">Bulchaa Beetlihemii Dhufu</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 5:1" />Yaa magaalaa raayyaa waraanaa, raayyaa kee hiriirsi;</para>
  <para style="q2" vid="MIC 5:1">nu marfamneerraatii.</para>
  <para style="q1" vid="MIC 5:1">Isaan uleedhaan</para>
  <para style="q2" vid="MIC 5:1">maddii bulchaa Israaʼel dhaʼu.<verse eid="MIC 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2" />“Garuu yaa Beetlihem Efraataa,</para>
  <para style="q2" vid="MIC 5:2">ati yoo balbala Yihuudaa keessaa xinnoo taate iyyuu,</para>
  <para style="q1" vid="MIC 5:2">kan bulchaa Israaʼel taʼu,</para>
  <para style="q2" vid="MIC 5:2">kan jiraachuun isaa durumaa,</para>
  <para style="q1" vid="MIC 5:2">kan bara duriitii jalqabee ture tokko</para>
  <para style="q2" vid="MIC 5:2">si keessaa baʼee naaf dhufa.”<verse eid="MIC 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3" />Kanaafuu Israaʼel</para>
  <para style="q2" vid="MIC 5:3">hamma isheen ciniinsifachaa jirtu deessee</para>
  <para style="q1" vid="MIC 5:3">obboloonni isaa warri hafan</para>
  <para style="q2" vid="MIC 5:3">Israaʼelootatti makamuuf deebiʼanitti kophaa hafti.<verse eid="MIC 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4" />Inni jabina Rabbii Allaahatiin</para>
  <para style="q2" vid="MIC 5:4">surraa maqaa Rabbii Allaah, Allaah isaatiin</para>
  <para style="q2" vid="MIC 5:4">dhaabatee bushaayee isaa tikfata.</para>
  <para style="q1" vid="MIC 5:4">Yeroo sanatti surraan isaa</para>
  <para style="q2" vid="MIC 5:4">waan daarii lafaa gaʼuuf isaan nagaadhaan jiraatu.<verse eid="MIC 5:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5" />Inni nagaa keenya taʼa;</para>
  <para style="q2" vid="MIC 5:5">yeroo warri Asoor biyya keenya weeraranii</para>
  <para style="q2" vid="MIC 5:5">daʼannoo keenya keessa baʼanitti</para>
  <para style="q1" vid="MIC 5:5">nu tiksoota torbaa fi</para>
  <para style="q2" vid="MIC 5:5">ajajjuuwwan saddeet itti kakaasna.<verse eid="MIC 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6" />Isaan biyya Asoor goraadeedhaan</para>
  <para style="q2" vid="MIC 5:6">biyya Naamruudis goraadee luqqifameen bulchu.</para>
  <para style="q1" vid="MIC 5:6">Yeroo warri Asoor biyya keenya weeraranii</para>
  <para style="q2" vid="MIC 5:6">daarii keenya keessa baʼanitti,</para>
  <para style="q2" vid="MIC 5:6">inni warra Asoor sana jalaa nu baasa.<verse eid="MIC 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7" />Hambaan Yaaʼikuub</para>
  <para style="q2" vid="MIC 5:7">namoota hedduu gidduutti</para>
  <para style="q1" vid="MIC 5:7">akkuma fixeensa Rabbii Allaah biraa dhufuu,</para>
  <para style="q2" vid="MIC 5:7">akkuma tiifuu marga irraa</para>
  <para style="q1" vid="MIC 5:7">kan nama hin eegnee</para>
  <para style="q2" vid="MIC 5:7">yookaan ilmaan namaa hin eeggannee taʼa.<verse eid="MIC 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8" />Hambaan Yaaʼikuub saboota gidduutti,</para>
  <para style="q2" vid="MIC 5:8">uummata hedduu gidduuttis,</para>
  <para style="q1" vid="MIC 5:8">akkuma leenca bineensota bosonaa gidduu jiruu,</para>
  <para style="q2" vid="MIC 5:8">akkuma leenca saafela bushaayee gidduu jiru</para>
  <para style="q1" vid="MIC 5:8">kan irra ejjetee isaan cicciruutii fi</para>
  <para style="q2" vid="MIC 5:8">kan namni tokko iyyuu harkaa buusuu hin dandeenyee taʼa.<verse eid="MIC 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9" />Harki kee moʼannaadhaan diinota keetti kaʼa;</para>
  <para style="q2" vid="MIC 5:9">amajaajonni kee hundinuu ni barbadeeffamu.<verse eid="MIC 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10" />Rabbii Allaahan akkana jedha;</para>
  <para style="q1" vid="MIC 5:10">“Gaafas ani fardeen keessan gidduu keessanii nan balleessa;</para>
  <para style="q2" vid="MIC 5:10">gaariiwwan keessan kan waraanaas nan barbadeessa.<verse eid="MIC 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11" />Ani magaalaawwan biyya keessanii nan barbadeessa;</para>
  <para style="q2" vid="MIC 5:11">daʼannoowwan keessan hundas nan diiga.<verse eid="MIC 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12" />Ani falfaltoota keessan nan balleessa;</para>
  <para style="q2" vid="MIC 5:12">isinis deebitanii hin mortan.<verse eid="MIC 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13" />Ani fakkiiwwan kee soofamoo fi utubaawwan waaqeffannaa keetii</para>
  <para style="q2" vid="MIC 5:13">gidduu keetii nan balleessa;</para>
  <para style="q1" vid="MIC 5:13">ati siʼachi gad jettee</para>
  <para style="q2" vid="MIC 5:13">hojii harka keetiitiif hin sagaddu.<verse eid="MIC 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14" />Ani siidaa Aasheeraa gidduu keetii buqqisee</para>
  <para style="q2" vid="MIC 5:14">magaalaawwan kees nan barbadeessa.<verse eid="MIC 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15" />Ani saboota naaf hin ajajamin irratti</para>
  <para style="q2" vid="MIC 5:15">aarii fi dheekkamsaan haaloo nan baʼa.”<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="s1">Rabbii Allaahan Israaʼel Irraa Dubbii Qaba</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1" />Waan Rabbii Allaahan jedhu dhaggeeffadhaa:</para>
  <para style="q1" vid="MIC 6:1">“Ol kakkaʼaatii fuula tulluuwwanii duratti dubbii keessan dhiʼeeffadhaa;</para>
  <para style="q2" vid="MIC 6:1">gaarranis waan isin jettan haa dhagaʼan.<verse eid="MIC 6:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2" />“Yaa tulluuwwan himata Rabbii Allaah dhagaʼaa;</para>
  <para style="q2" vid="MIC 6:2">hundeewwan lafaa kanneen bara baraa isinis dhaggeeffadhaa.</para>
  <para style="q1" vid="MIC 6:2">Rabbii Allaahan saba isaa irraa dubbii qabaatii;</para>
  <para style="q2" vid="MIC 6:2">inni Israaʼel wajjin falmii qaba.<verse eid="MIC 6:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3" />“Yaa saba ko, ani maalan si godhe?</para>
  <para style="q2" vid="MIC 6:3">Ani maaliinan si dadhabsiise? Mee deebii naaf kenni.<verse eid="MIC 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4" />Ani biyya Gibxii sin baasee</para>
  <para style="q2" vid="MIC 6:4">biyya garbummaa keessaa sin fure.</para>
  <para style="q1" vid="MIC 6:4">Ani akka inni si qajeelchuuf Muusaa,</para>
  <para style="q2" vid="MIC 6:4">akkasumas Haaruunii fi Miiriyaamin siifan erge.<verse eid="MIC 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5" />Yaa saba ko, mee gorsa Baalaaq mootiin Moʼaab gaafatee fi</para>
  <para style="q2" vid="MIC 6:5">deebii Balaʼaam ilmi Beʼoor kenneef yaadadhu.</para>
  <para style="q1" vid="MIC 6:5">Ati akka hojii qajeelummaa Rabbii Allaah beektuuf</para>
  <para style="q2" vid="MIC 6:5">karaa ati Shixiimii hamma Gilgaalitti deemte sana yaadadhu.”<verse eid="MIC 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6" />Ani maaliinan fuula Rabbii Allaah dura dhufee</para>
  <para style="q2" vid="MIC 6:6">fuula Allaah ol gubbaa jiruu duratti sagada?</para>
  <para style="q1" vid="MIC 6:6">Ani aarsaa gubamuun,</para>
  <para style="q2" vid="MIC 6:6">jabbii waggaa tokkootiin fuula isaa duratti dhiʼaadhuu?<verse eid="MIC 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7" />Rabbii Allaahan korbeeyyii hoolaa kuma hedduutti,</para>
  <para style="q2" vid="MIC 6:7">zayitii laga kuma kudhaniitti ni gammadaa?</para>
  <para style="q1" vid="MIC 6:7">Ani ilma koo hangafa, sababii yakka kootiitiif,</para>
  <para style="q2" vid="MIC 6:7">sababii cubbuu lubbuu kootiitiifis dhala garaa koo aarsaa dhiʼeessuu?<verse eid="MIC 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8" />Yaa nama, inni waan gaarii si argisiiseera.</para>
  <para style="q2" vid="MIC 6:8">Rabbii Allaahan maal sirraa barbaada?</para>
  <para style="q1" vid="MIC 6:8">Murtii qajeelaa kennuu fi araara jaallachuu,</para>
  <para style="q2" vid="MIC 6:8">akka ati gad of qabdee Allaah kee wajjin deemtu <optbreak /> sirraa barbaada mitii?<verse eid="MIC 6:8" /></para>
  <para style="s1">Yakkaa fi Adabamuu Israaʼel</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9" />Isin dhaggeeffadhaa! Rabbii Allaahan akkana jedhee magaalattii waama:</para>
  <para style="q2" vid="MIC 6:9">Maqaa kee sodaachuun ogummaa dha;</para>
  <para style="q2" vid="MIC 6:9">“Ulee fi Isa ulee sana filate qalbeeffadhaa.<verse eid="MIC 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10" />Yaa mana hamaa, ani qabeenya isin dabaan argattanii fi</para>
  <para style="q2" vid="MIC 6:10">madaalii sobaa abaaramaa sana irraanfadhaa?<verse eid="MIC 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11" />Ani nama madaallii sobaatiin hojjetuu fi</para>
  <para style="q2" vid="MIC 6:11">kan madaalii sobaa korojootti baatu akkasumatti dhiisaa?<verse eid="MIC 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12" />Sooreyyiin ishee jalʼoota;</para>
  <para style="q2" vid="MIC 6:12">uummanni ishee sobdoota;</para>
  <para style="q2" vid="MIC 6:12">arrabni isaaniis gowwoomsaa dubbata.<verse eid="MIC 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13" />Kanaafuu ani sababii cubbuu keessaniitiif isin diigee,</para>
  <para style="q2" vid="MIC 6:13">isin balleessuu jalqabeera.<verse eid="MIC 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14" />Ati inuma nyaatta; garuu hin quuftu;</para>
  <para style="q2" vid="MIC 6:14">garaan kee amma illee duwwaa dha.</para>
  <para style="q1" vid="MIC 6:14">Ati ni kaaʼatta; garuu homaa siif hin kuufamu;</para>
  <para style="q2" vid="MIC 6:14">waan ati kuufattu sana ani goraadeetti kennaatii.<verse eid="MIC 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15" />Ati ni facaafatta; garuu hin haammattu;</para>
  <para style="q2" vid="MIC 6:15">ejersa ni cuunfatta; garuu zayitii isaa hin dibattu;</para>
  <para style="q2" vid="MIC 6:15">ija wayinii ni cuunfatta; garuu daadhii wayinii hin dhugdu.<verse eid="MIC 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16" />Ati sirna Omriitii fi</para>
  <para style="q2" vid="MIC 6:16">hojii mana Ahaab hunda jabeessiteerta;</para>
  <para style="q2" vid="MIC 6:16">gorsa isaaniis duukaa buuteerta.</para>
  <para style="q1" vid="MIC 6:16">Kanaafuu ani si balleessee,</para>
  <para style="q2" vid="MIC 6:16">uummata kee nan salphisa;</para>
  <para style="q2" vid="MIC 6:16">isin tuffii sabootaa ni baattu.”<verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="s1">Dhiphachuu Israaʼel</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1" />Anaaf wayyoo!</para>
  <para style="q1" vid="MIC 7:1">Ani akkuma nama yeroo qarmii bonaa funaananitti</para>
  <para style="q2" vid="MIC 7:1">wayinii walitti qabu tokkoo taʼeera;</para>
  <para style="q1" vid="MIC 7:1">hurbuun wayinii kan nyaatamu tokko iyyuu hin jiru;</para>
  <para style="q2" vid="MIC 7:1">iji harbuu jalqabaa kan ani dharraʼu tokko iyyuu hin jiru.<verse eid="MIC 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2" />Namni gaariin lafa irraa badeera;</para>
  <para style="q2" vid="MIC 7:2">namni qajeelaan tokko iyyuu hin hafne.</para>
  <para style="q1" vid="MIC 7:2">Namoonni hundinuu dhiiga <optbreak /> dhangalaasuuf riphanii eeggatu;</para>
  <para style="q2" vid="MIC 7:2">tokkoon tokkoon namaa <optbreak /> kiyyoodhaan obboleessa isaa eeggata.<verse eid="MIC 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3" />Harki lachuu waan hamaa hojjechuu barateera;</para>
  <para style="q2" vid="MIC 7:3">bulchaan kennaa barbaada;</para>
  <para style="q1" vid="MIC 7:3">abbaan murtiis mattaʼaa fudhata;</para>
  <para style="q2" vid="MIC 7:3">namni humna qabu waanuma fedhe dubbata;</para>
  <para style="q2" vid="MIC 7:3">hundi isaanii walii wajjin malatu.<verse eid="MIC 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4" />Kan isaan hunda caalaa gaarii taʼe akka sokorruu ti;</para>
  <para style="q2" vid="MIC 7:4">inni akka malee qajeelaan immoo dallaa qoraattii caala.</para>
  <para style="q1" vid="MIC 7:4">Guyyaan eegdota keetii,</para>
  <para style="q2" vid="MIC 7:4">guyyaan itti Allaahan si ilaalu dhufeera.</para>
  <para style="q2" vid="MIC 7:4">Amma yeroo itti isaan joonjaʼanii dha.<verse eid="MIC 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5" />Ollaa hin amanatin;</para>
  <para style="q2" vid="MIC 7:5">michuus hin abdatin.</para>
  <para style="q1" vid="MIC 7:5">Ishee hammattee ciiftu biratti iyyuu</para>
  <para style="q2" vid="MIC 7:5">arraba kee eeggadhu.<verse eid="MIC 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6" />Ilmi abbaa isaa tuffata;</para>
  <para style="q2" vid="MIC 7:6">intalli haadha isheetti,</para>
  <para style="q1" vid="MIC 7:6">niitiin ilmaas amaatii isheetti kaati;</para>
  <para style="q2" vid="MIC 7:6">diinonni namaa miseensotuma mana isaa taʼuutii.<verse eid="MIC 7:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7" />Ani garuu abdiidhaan Rabbii Allaah nan eeggadha;</para>
  <para style="q2" vid="MIC 7:7">fayyisaa koo Allaah nan eeggadha;</para>
  <para style="q2" vid="MIC 7:7">Allaahan koo na dhagaʼa.<verse eid="MIC 7:7" /></para>
  <para style="s1">Israaʼel ni Kaati</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8" />Yaa diina koo natti hin gammadin!</para>
  <para style="q2" vid="MIC 7:8">Ani yoon kufe iyyuu nan kaʼa.</para>
  <para style="q1" vid="MIC 7:8">Ani dukkana keessa taaʼu iyyuu</para>
  <para style="q2" vid="MIC 7:8">Rabbii Allaahan ifa naaf taʼa.<verse eid="MIC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9" />Ani sababiin cubbuu isatti hojjedheef,</para>
  <para style="q2" vid="MIC 7:9">hamma inni dubbii koo ilaalee naaf murteessutti</para>
  <para style="q2" vid="MIC 7:9">dheekkamsa Allaah nan baadha.</para>
  <para style="q1" vid="MIC 7:9">Inni ifatti na baasa;</para>
  <para style="q2" vid="MIC 7:9">anis qajeelummaa isaa nan arga.<verse eid="MIC 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10" />Ergasii diinni koo isheen,</para>
  <para style="q2" vid="MIC 7:10">“Rabbii Allaahan kee eessa jira?” naan jette sun</para>
  <para style="q2" vid="MIC 7:10">waan kana argitee qaaniin haguugamti.</para>
  <para style="q1" vid="MIC 7:10">Iji koo kufaatii ishee ni arga;</para>
  <para style="q2" vid="MIC 7:10">Isheen amma iyyuu miilla jalatti</para>
  <para style="q2" vid="MIC 7:10">akkuma dhoqqee daandii irraatti dhidhiitamti.<verse eid="MIC 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11" />Guyyaan itti dallaan kee ijaaramu,</para>
  <para style="q2" vid="MIC 7:11">guyyaan itti daangaan kee balʼifamu tokko ni dhufa.<verse eid="MIC 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12" />Gaafas namoonni</para>
  <para style="q2" vid="MIC 7:12">Asoorii fi magaalaawwan Gibxi,</para>
  <para style="q1" vid="MIC 7:12">Gibxii hamma Efraaxiisitti iyyuu,</para>
  <para style="q2" vid="MIC 7:12">galaanaa hamma galaanaatti,</para>
  <para style="q2" vid="MIC 7:12">tulluudhaa hamma tulluutti jiraatan gara kee ni dhufu.<verse eid="MIC 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13" />Sababii jiraattota isheetii fi</para>
  <para style="q2" vid="MIC 7:13">sababii waan isaan hojjetaniitiif lafti ni onti.<verse eid="MIC 7:13" /></para>
  <para style="s1">Duʼaa fi Galata</para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14" />Uummata kee, bushaayee dhaala keetii</para>
  <para style="q2" vid="MIC 7:14">kanneen ofumaan bosona keessa,</para>
  <para style="q1" vid="MIC 7:14">lafa dheedaa gabbataa irra jiraatan</para>
  <para style="q2" vid="MIC 7:14">ulee keetiin tikfadhu.</para>
  <para style="q1" vid="MIC 7:14">Isaan akkuma bara duriitti</para>
  <para style="q2" vid="MIC 7:14">Baashaanii fi Giliʼaad keessa haa bobbaʼan.<verse eid="MIC 7:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15" />“Ani akkuma yeroo ati Gibxii baatee dhufte sanaa</para>
  <para style="q2" vid="MIC 7:15">dinqii koo isaan nan argisiisa.”<verse eid="MIC 7:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16" />Saboonni arganii ni qaanaʼu;</para>
  <para style="q2" vid="MIC 7:16">humna ofii hunda iyyuu ni dhabu.</para>
  <para style="q1" vid="MIC 7:16">Isaan afaan isaanii qabatu;</para>
  <para style="q2" vid="MIC 7:16">gurri isaaniis ni duuda.<verse eid="MIC 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17" />Isaan akkuma bofaa,</para>
  <para style="q2" vid="MIC 7:17">akkuma uumamawwan lafa irra looʼanii biyyoo arraabu.</para>
  <para style="q1" vid="MIC 7:17">Isaan hollachaa holqa keessaa baʼanii dhufu;</para>
  <para style="q2" vid="MIC 7:17">Isaan Rabbii Allaah keenya sodaachuudhaan</para>
  <para style="q2" vid="MIC 7:17">deebiʼanii fuula kee dura sodaadhaan dhaabatu.<verse eid="MIC 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18" />Allaahan akka keetii kan cubbuu namaa bira darbee</para>
  <para style="q2" vid="MIC 7:18">balleessaa hambaa dhaala isaa dhiisuuf eenyu?</para>
  <para style="q1" vid="MIC 7:18">Ati araara gochuutti gammadda malee</para>
  <para style="q2" vid="MIC 7:18">bara baraan hin dheekkamtu.<verse eid="MIC 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19" />Ati deebitee garaa nuu laafta;</para>
  <para style="q2" vid="MIC 7:19">cubbuu keenya miilla kee jalatti dhidhiittee</para>
  <para style="q2" vid="MIC 7:19">balleessaa keenya hundas tuujuba galaanaatti <optbreak /> gad darbatta.<verse eid="MIC 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20" />Ati akkuma bara durii</para>
  <para style="q2" vid="MIC 7:20">abbootii keenyaaf kakatte sana</para>
  <para style="q1" vid="MIC 7:20">Yaaʼikuubiif amanamaa taata;</para>
  <para style="q2" vid="MIC 7:20">Ibraahimittis jaalala ni argisiifta.<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>