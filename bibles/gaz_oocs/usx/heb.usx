  <para style="h">Ibroota</para>
  <para style="toc1">Ibroota</para>
  <para style="toc2">Ibroota</para>
  <para style="toc3">Ibr</para>
  <para style="mt1">Ibroota</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s1">Dubbii Allaah Kan Xumuraa: Ilma Isaa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Bara durii Allaahan yeroo baayʼee fi karaa adda addaatiin nabiiʼiyyootaan abbootii keenyatti dubbatee ture; <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />bara dhumaa kana keessa garuu Ilma isaa kan inni dhaaltuu waan hundumaa godhee muudeen nutti dubbate; isumaanis addunyaawwan uume. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Ilmi calaqqisa ulfina Allaaha ti; eenyummaa Allaahas akkuma jirutti mulʼisa; dubbii isaa humna qabeessa sanaanis waan hunda hirkisee baata. Innis erga cubbuu keenya nurraa qulqulleessee booddee shamaayʼun irra mirga Allaah ulfina qabeessa sanaa taaʼe. <verse eid="HEB 1:3" /><verse number="4" style="v" sid="HEB 1:4" />Akkuma maqaan inni dhaale sun kan malaʼikkootaa caalaa guddaa taʼe sana innis malaʼikkoota caalaa guddaa dha.<verse eid="HEB 1:4" /></para>
  <para style="s1">Ilmi Malaʼikkoota Caaluu Isaa</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5" />Allaahan malaʼikkoota keessaa isa kamiin,</para>
  <para style="q1" vid="HEB 1:5">“Ati Ilma koo ti;</para>
  <para style="q2" vid="HEB 1:5">ani harʼa si dhalcheera”<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 2:7">Zab 2:7</ref></char></char></note></para>
  <para style="m" vid="HEB 1:5">Yookaan isa kamiin,</para>
  <para style="q1" vid="HEB 1:5">“Ani isaaf Abbaa nan taʼa;</para>
  <para style="q2" vid="HEB 1:5">innis Ilma naa taʼa”<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="2SA 7:14">2Sm 7:14</ref>; <ref loc="1CH 17:13">1Sn 17:13</ref></char></char></note></para>
  <para style="m" vid="HEB 1:5">jedhee beeka? <verse eid="HEB 1:5" /><verse number="6" style="v" sid="HEB 1:6" />Akkasumas Allaahan yommuu Ilma isaa hangafa gara addunyaa kanaatti ergutti,</para>
  <para style="q1" vid="HEB 1:6">“Malaʼikkoonni Allaaha hundi isa haa waaqeffatan”<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:43">KeD 32:43</ref></char></char></note></para>
  <para style="m" vid="HEB 1:6">jedha. <verse eid="HEB 1:6" /><verse number="7" style="v" sid="HEB 1:7" />Yommuu waaʼee malaʼikkootaa dubbatus,</para>
  <para style="q1" vid="HEB 1:7">“Inni malaʼikkoota isaa hafuurota,</para>
  <para style="q2" vid="HEB 1:7">tajaajiltoota isaa immoo arraba ibiddaa godha”<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 104:4">Zab 104:4</ref></char></char></note></para>
  <para style="m" vid="HEB 1:7">jedha. <verse eid="HEB 1:7" /><verse number="8" style="v" sid="HEB 1:8" />Waaʼee Ilmaa garuu akkana jedha;</para>
  <para style="q1" vid="HEB 1:8">“Yaa Allaah, teessoon kee bara baraa hamma bara baraatti ni jiraata;</para>
  <para style="q2" vid="HEB 1:8">bokkuun qajeelummaas bokkuu mootummaa keetii ni taʼa.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />Ati qajeelummaa jaallatte; jalʼina immoo ni jibbite;</para>
  <para style="q2" vid="HEB 1:9">kanaafuu Allaahan, Allaahan kan kee zayitii gammachuutiin si dibee,</para>
  <para style="q2" vid="HEB 1:9">hiriyoota kee si caalchise.”<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 45:6">Zab 45:6</ref>,<ref loc="PSA 45:7">7</ref></char></char></note><verse eid="HEB 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />Akkasumas inni akkana jedha;</para>
  <para style="q1" vid="HEB 1:10">“Yaa Gooftaa, ati jalqabatti lafa hundeessite;</para>
  <para style="q2" vid="HEB 1:10">shamaayʼuniiwwanis hojii harka keetii ti.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />Isaan ni badu; ati garuu ni jiraatta;</para>
  <para style="q2" vid="HEB 1:11">hundumti isaanii akkuma uffataa ni moofaʼu;<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />ati akkuma wayyaatti isaan marta;</para>
  <para style="q2" vid="HEB 1:12">isaan akkuma uffataatti geeddaramu;</para>
  <para style="q1" vid="HEB 1:12">ati garuu sanuma;</para>
  <para style="q2" vid="HEB 1:12">umuriin kees gonkumaa dhuma hin qabu.”<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 102:25-27">Zab 102:25‑27</ref></char></char></note><verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Allaahan malaʼikkoota keessaa isa kamiin,</para>
  <para style="q1" vid="HEB 1:13">“Hamma ani diinota kee ejjeta miilla keetii godhutti,</para>
  <para style="q2" vid="HEB 1:13">gara mirga koo taaʼi”<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:1">Zab 110:1</ref></char></char></note></para>
  <para style="m" vid="HEB 1:13">jedhe? <verse eid="HEB 1:13" /><verse number="14" style="v" sid="HEB 1:14" />Malaʼikkoonni hundinuu hafuurota tajaajilan kanneen warra fayyina dhaalan tajaajiluuf ergaman mitii?<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s1">Akeekkachiisa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Kanaafuu nu akka waan dhageenye irraa hin jalʼanneef waan sana irratti xiyyeeffannoo guddaa gochuu qabna. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Sababiin isaas erga dubbiin malaʼikkootaan dubbatame sun eegamuu qabaatee, seera cabsuu fi ajajamuu diduun hundis erga adabbii malu argatanii, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />yoos nu yoo fayyina guddaa akkanaa tuffanne, akkamitti adabbii kana jalaa baana ree? Fayyinni jalqabatti Gooftaadhaan labsame kun warra dhagaʼaniin nuuf mirkaneeffame. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Allaahan mallattoon, raajii fi hojii dinqii adda addaatiin akkasumas kennaawwan Hafuura Qulqulluu kanneen akka fedhii isaatti kennamaniin dhugaa baʼeera.<verse eid="HEB 2:4" /></para>
  <para style="s1">Iisaan Guutummaatti Nama Taasifame</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Inni addunyaa dhufuuf jiru, kan nu waaʼee isaa dubbannu sana malaʼikkoota jala hin galchine. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Namni tokko garuu iddoo tokkotti akkana jedhee dhugaa baʼeera;</para>
  <para style="q1" vid="HEB 2:6">“Akka ati isaaf yaadduuf namni maali?</para>
  <para style="q2" vid="HEB 2:6">Akka isaaf dhimmituuf ilmi namaa maali?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Ati xinnoo ishee malaʼikkootaa gad isa goote;</para>
  <para style="q2" vid="HEB 2:7">ulfinaa fi kabajaan isa gonfite; <optbreak /> hojii harka keetii irrattis isa muudde.<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />Waan hundas miilla isaa jala galchite.”<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 8:4-6">Zab 8:4‑6</ref></char></char></note></para>
  <para style="m" vid="HEB 2:8">Inni yommuu waan hunda isa jala galchetti wanni inni utuu isa jala hin galchin hambise tokko iyyuu hin jiru. Taʼus yeroo ammaa wanni hundinuu isa jala galee hin arginu. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />Garuu Iisaan inni ayyaana Allaahatiin nama hundaaf duʼa dhandhamuuf jedhee xinnoo ishee malaʼikkootaa gad taʼee ture sun dhiphina duʼaa waan dhiphateef amma ulfinaa fi kabajaan gonfamee argina.<verse eid="HEB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10" />Allaahan wanni hundi isaaf jiraatuu fi isaan jiraatu sun ilmaan baayʼee gara ulfinaatti geessuuf jedhee mataa fayyina isaanii dhiphina kan hirʼina hin qabne gochuun isaaf ni mala ture. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />Inni namoota qulqulleessuu fi kanneen qulqulleeffaman hundi kanuma abbaa tokkoo ti. Kanaafuu Iisaan obboloota jedhee isaan waamuu hin qaanaʼu. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />Inni,</para>
  <para style="q1" vid="HEB 2:12">“Maqaa kee obboloota kootti nan labsa;</para>
  <para style="q2" vid="HEB 2:12">waldaa kiristaanaa keessattis faarfannaadhaan sin jajadha”<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 22:22">Zab 22:22</ref></char></char></note></para>
  <para style="m" vid="HEB 2:12">jedha. <verse eid="HEB 2:12" /><verse number="13" style="v" sid="HEB 2:13" />Akkasumas,</para>
  <para style="q1" vid="HEB 2:13">“Ani isa nan amanadha”<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 8:17">Isa 8:17</ref></char></char></note></para>
  <para style="m" vid="HEB 2:13">jedha. Ammas inni,</para>
  <para style="q1" vid="HEB 2:13">“Anii fi ijoolleen Allaahan naa kenne kunoo ti”<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 8:18">Isa 8:18</ref></char></char></note></para>
  <para style="m" vid="HEB 2:13">jedha.<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Sababii ijoolleen sun foonii fi dhiiga qabaniif, Iisaanis duʼa ofii isaatiin ibliis isa duʼa irratti humna qabu sana balleessuuf jedhee namummaa isaanii qoodate; <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />innis warra bara jireenya isaanii hunda garbummaa sodaa duʼaatiin hidhamanii turan bilisa baasuuf jedhee waan kana godhe. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Inni dhugumaanuu sanyii Ibraahim gargaaruuf malee malaʼikkoota Allaaha gargaaruuf miti. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />Kanaafuu inni Allaah tajaajiluu keessatti akka luba ol aanaa araara qabeessaa fi amanamaa taʼuuf, akka cubbuu namootaatiif araara buusuuf waan hundaan obboloota isaa fakkaachuutu isa irra ture. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Inni mataan isaa waan dhiphina keessatti qorameef warra qoramaa jiran gargaaruu ni dandaʼa.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s1">Iisaan Muusaa Caala</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Kanaafuu yaa obboloota qulqulloota, warra waamicha shamaayʼun keessatti hirmaattan, Iisaa ergamaa fi luba ol aanaa amantii keenyaa sana ilaalaa. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />Akkuma Muusaan mana Allaaha hunda keessatti amanamaa ture sana innis isa isa muudeef amanamaa ture. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Akkuma namni mana ijaaru tokko mana sana caalaa kabaja guddaa qabu, innis Muusaa caalaa kabaja guddaa qaba. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Tokkoon tokkoon manaa namaan ijaaramaatii; kan waan hunda ijaare garuu Allaah. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Muusaan waan fuul duratti dubbatamuuf jiru dhugaa baʼuuf akka tajaajilaa tokkootti mana Allaaha hunda keessatti amanamaa ture.<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="NUM 12:7">Lak 12:7</ref></char></char></note> <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Al-Masiihiin garuu akka Ilmaatti mana Allaaha irratti amanamaa dha. Nus yoo ija jabina keenyaa fi abdii ittiin boonnu sana jabeessinee qabanne, nu mana isaa ti.<verse eid="HEB 3:6" /></para>
  <para style="s1">Akeekkachiisa Amantii Dhabuu Irratti Kenname</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Kanaafuu akkuma Hafuurri Qulqulluun jedhu:</para>
  <para style="q1" vid="HEB 3:7">“Isin yoo harʼa sagalee isaa dhageessan,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />akka yeroo qorumsaa gammoojjii</para>
  <para style="q1" vid="HEB 3:8">keessatti finciluun gootan sana,</para>
  <para style="q2" vid="HEB 3:8">mataa hin jabaatinaa;<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />abbootiin keessan achitti na qoranii na ilaalan;</para>
  <para style="q2" vid="HEB 3:9">waggaa afurtamas waan ani hojjedhe argan.<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />Kanaafuu ani dhaloota sanatti aaree,</para>
  <para style="q2" vid="HEB 3:10">‘Yeroo hunda qalbii isaaniitiin dogoggoru;</para>
  <para style="q2" vid="HEB 3:10">isaan karaa koo hin beekne’ jedhe.<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Kanaafuu ani dheekkamsa kootiin,</para>
  <para style="q2" vid="HEB 3:11">‘Isaan boqonnaa kootti hin galan’ jedhee kakadhe.”<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 95:7-11">Zab 95:7‑11</ref></char></char></note><verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Yaa obboloota, akka isin keessaa namni tokko iyyuu garaa hamaa fi hin amanne kan Allaah jiraataa irraa nama fageessu hin qabaanneef of eeggadhaa. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Garuu isin keessaa akka namni tokko iyyuu gowwoomsaa cubbuutiin mata jabeessa hin taaneef utuu “Harʼa” jedhamaa jiruu guyyuma guyyaan wal jajjabeessaa. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Nus yoo amantii keenya isa jalqabaa sana hamma dhumaatti jabeessinee qabanne Al-Masiihii wajjin hirmaattota ni taanaatii. <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />Kunis akkuma,</para>
  <para style="q1" vid="HEB 3:15">“Isin yoo harʼa sagalee isaa dhageessan,</para>
  <para style="q2" vid="HEB 3:15">akka yeroo fincilaa sana,</para>
  <para style="q2" vid="HEB 3:15">mataa hin jabaatinaa”<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 95:7">Zab 95:7</ref>,<ref loc="PSA 95:8">8</ref></char></char></note></para>
  <para style="m" vid="HEB 3:15">jedhamee barreeffamee dha.<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Warri dhagaʼanii fincilan sun eenyu? Warra Muusaan qajeelchee Gibxii baase sana hunda mitii? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />Allaahan waggaa afurtama eenyu faatti aare? Warruma cubbuu hojjetanii reeffi isaanii gammoojjii keessatti kukkufe sanatti mitii? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Yoo warruma ajajamuu didan sana taʼe malee Allaahan akka isaan gonkumaa boqonnaa isaatti hin galleef eenyu faatti kakate ree? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Kanaafuu akka isaan sababii amantii dhabuu isaaniitiif boqonnaa sanatti galuu hin dandaʼin argina.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="s1">Boqonnaa Guyyaa Sanbataa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Kanaaf waadaan boqonnaa isaatti galuu sun amma iyyuu waan jiruuf isin keessaa namni kam iyyuu utuu boqonnaa sanatti hin galin akka hin hafne of haa eeggannu. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Injiilli isaanitti lallabame nuttis lallabameeraatii; garuu dubbiin lallabame sun waan amantii isaaniitiin wal hin fudhanneef warra dhagaʼan sanaaf faayidaa tokko illee hin kennine. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Nu warri amanne boqonnaa sanatti ni galla; kunis akkuma inni,</para>
  <para style="q1" vid="HEB 4:3">“Kanaafuu ani dheekkamsa kootiin,</para>
  <para style="q2" vid="HEB 4:3">‘Isaan boqonnaa kootti</para>
  <para style="q2" vid="HEB 4:3">hin galan’ jedhee kakadhe”<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 95:11">Zab 95:11</ref></char></char></note></para>
  <para style="m" vid="HEB 4:3">jedhu sanaa dha. Taʼus hojiin isaa uumama addunyaatii jalqabee xumurameera. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Innis iddoo tokkotti waaʼee guyyaa torbaffaa; “Allaahan guyyaa torbaffaatti hojii isaa hundumaa irraa boqote”<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:2">Uma 2:2</ref></char></char></note> jedhee dubbate. <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />Ammas inni iddoodhuma kanatti, “Isaan boqonnaa kootti hin galan”<note caller="+" style="f" category="dup"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 95:11">Zab 95:11</ref></char></char></note> jedha.<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />Amma iyyuu akka namoonni tokko tokko itti galaniif iddoon boqonnaa sun hambifameera; warri duraan injiilli itti lallabame sun immoo sababii ajajamuu didaniif boqonnaa sanatti hin galle. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Kanaafuu Allaahan deebisee guyyaa tokko “Harʼa” jedhee waamuudhaan murteesse. Innis akkuma kanaan dura dubbatame sana bara dheeraa booddee karaa Daawudiitiin,</para>
  <para style="q1" vid="HEB 4:7">“Isin yoo harʼa sagalee isaa dhageessan,</para>
  <para style="q2" vid="HEB 4:7">mataa hin jabaatinaa”<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 95:7">Zab 95:7</ref>,<ref loc="PSA 95:8">8</ref></char></char></note> jedha.<verse eid="HEB 4:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 4:8" />Utuu Yushuʼaan boqonnaa sanatti isaan galchee jiraatee, silaa Allaahan ergasii waaʼee guyyaa biraa hin dubbatu tureetii. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Kanaafuu boqonnaan Sanbataa saba Allaahatiif kaaʼameera; <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />namni boqonnaa Allaahatti galu kam iyyuu akkuma Allaahan hojii isaa irraa boqote sana, innis hojii isaa irraa ni boqota.<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:2">Uma 2:2</ref></char></char></note> <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Kanaafuu akka namni tokko illee fakkeenya ajajamuu diduu jara sanaa duukaa buʼee boqonnaa sanatti galuu hin dhabneef kottaa boqonnaa sanatti galuuf ni tattaaffannaa.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />Dubbiin Allaaha jiraataa fi kan hojjetuudhaatii. Goraadee qara lama qabu kam iyyuu caalaa qaramaa dha; hamma lubbuu fi hafuura, buusaa fi dhuka gargar baasutti waraanee seena; yaadaa fi fedhii garaa namaas ni qora. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Uumama hunda keessaa wanti fuula Allaaha duraa dhokatu tokko illee hin jiru. Wanti hundi ija isaa duratti qullaa fi saaqamaa dha; nus waaʼee mataa keenyaa deebii kennuufii qabna.<verse eid="HEB 4:13" /></para>
  <para style="s1">Iisaa Luba Ol Aanaa Guddicha</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Egaa luba ol aanaa guddicha isa shamaayʼuniiwwan keessa darbe, Iisaa Ilma Allaaha waan qabnuuf kottaa amantii keenya jabeessinee qabannaa. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Nu luba ol aanaa dadhabbii keenya keessatti garaa nuu hin laafne hin qabnuutii; garuu kan waan hundaan akkuma keenya qorame qabna; taʼus inni cubbuu hin hojjenne. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Kanaafuu akka araara argannuu fi akka ayyaana yeroo nu barbaachisutti nu gargaaru argannuuf kottaa gara teessoo ayyaanaatti sodaa malee dhiʼaannaa.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Tokkoon tokkoon luba ol aanaa namoota gidduudhaa filatamee waan Allaah ilaallatu irratti namoota iddoo buʼee sababii cubbuutiif kennaa fi aarsaa dhiʼeessuuf muudama. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />Inni mataan isaa iyyuu waan dadhabbii keessa jiruuf wallaaltotaa fi warra karaa irraa jallataniif garaa laafuu ni dandaʼa. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Sababii kanaaf inni cubbuu ofii isaatiif, akkasumas cubbuu namootaatiif aarsaa dhiʼeessuu qaba. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />Nama akkuma Haaruunitti Allaahan waamame malee, namni kam iyyuu ulfina kana ofii isaatiif hin fudhatu.<verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />Al-Masiihiinis akkasuma luba ol aanaa taʼuuf of hin ulfeessine. Allaahan garuu,</para>
  <para style="q1" vid="HEB 5:5">“Ati Ilma koo ti;</para>
  <para style="q2" vid="HEB 5:5">ani harʼa si dhalcheera”<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 2:7">Zab 2:7</ref></char></char></note></para>
  <para style="m" vid="HEB 5:5">jedheen. <verse eid="HEB 5:5" /><verse number="6" style="v" sid="HEB 5:6" />Iddoo biraattis,</para>
  <para style="q1" vid="HEB 5:6">“Akkuma sirna Malkiiseedeqitti,</para>
  <para style="q2" vid="HEB 5:6">ati luba bara baraa ti”<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:4">Zab 110:4</ref></char></char></note></para>
  <para style="m" vid="HEB 5:6">jedha.<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />Iisaan yeroo lafa irra jiraachaa turetti iyya guddaa fi imimmaaniin isa duʼa isa oolchuu dandaʼu sanatti duʼaa fi waammata dhiʼeeffate; sababii inni sodaa Allaaha qabuufis duʼaan isaa ni dhagaʼameef. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Inni Ilma taʼu iyyuu dhiphina isaa sana irraa ajajamuu barate; <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />erga kan mudaa hin qabne taasifamee immoo warra isaaf ajajaman hundaaf burqaa fayyina bara baraa taʼe. <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />Akka sirna Malkiiseedeqittis luba ol aanaa jedhamee Allaahan waamame.<verse eid="HEB 5:10" /></para>
  <para style="s1">Akeekkachiisa</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Nu waaʼee isaa waan jennu baayʼee qabna; isin garuu waan hubachuutti dadhaboo taataniif isinii ibsuun rakkisaa dha. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Isin yeroo kanatti barsiistota taʼuu qabdu ture; isin immoo nama waaʼee dhugaa dubbii Allaaha kan jalqabaa irra deebiʼee isin barsiisutu isin barbaachisa. Nyaata jabaataas utuu hin taʼin aannan isin barbaachisa. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Namni aannaniin jiraatu kam iyyuu waan amma illee daaʼima taʼeef dubbii qajeelummaa hin beeku. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Nyaanni jabaataan garuu namoota bilchaatoo kanneen waan gaarii fi waan hamaa gargar baasanii beekuuf of leenjisaniif taʼa.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Kanaafuu kottaa barsiisa waaʼee Al-Masiihii isa jalqabaa sana dhiifnee gara bilchinaatti dabarraa; waaʼee hojii gara duʼaatti nama geessuu irraa deebiʼuu fi waaʼee Allaahatti amanuu lammata hundee hin buufnu; <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />akkasumas barsiisa waaʼee cuuphaa, waaʼee harka nama irra kaaʼuu, waaʼee duʼaa kaʼuu warra duʼaniitii fi waaʼee murtii bara baraa ammas hundee hin buufnu. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Nus yoo Allaahan jedhe waan kana ni goona.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Warra yeroo tokko ifni ifeefii kennaa shamaayʼun dhandhamatan, kanneen Hafuura Qulqulluu irraa qooddatan, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />warra gaarummaa dubbii Allaahatii fi humna bara dhufuuf jiru sanaa dhandhamatanii <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />ergasii garuu amantii irraa gara galan, gara qalbii jijjiirrannaatti isaan fiduun hin dandaʼamu; sababiin isaas isaan fedhuma isaaniitiin deebisanii Ilma Allaaha ni fannisu; fuula namootaa durattis salphinatti isa saaxilu. <verse eid="HEB 6:6" /><verse number="7" style="v" sid="HEB 6:7" />Lafti bokkaa yeroo baayʼee irratti roobu dhugdee warra ishee qotataniif midhaan fayyadu kennitu eebba Allaaha argatti. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Lafti qoraattii fi sokorruu biqilchitu garuu faayidaa hin qabdu; abaaramuus geesseerti. Dhumni ishees gubamuu dha.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Yaa michoota jaallatamtoota, nu yoo akkana dubbanne illee waaʼee keessan waan wayyu, waan fayyina wajjin deemus akka qabdan mirkaneeffanneerra. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Allaahan qulqulloota tajaajiluu keessanii fi ammas tajaajiluu keessaniin hojii isin hojjettanii fi jaalala maqaa isaatiif argisiiftan irraanfachuuf jalʼaa mitiitii. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Nus akka tokkoon tokkoon keessan abdii keessan mirkaneessitanii hamma dhumaatti tattaaffii akkanaa argisiiftan barbaanna. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />Nu akka isin fakkeenya warra amantii fi obsaan waan waadaa galame sana dhaalanii duukaa buutan barbaanna malee akka isin dhibaaʼoo taatan hin barbaannu.<verse eid="HEB 6:12" /></para>
  <para style="s1">Waadaan Allaaha Amanamaa Taʼuu Isaa</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Allaahan yeroo Ibraahimiif waadaa galetti kan isa caalu kan inni ittiin kakatu tokko iyyuu waan hin jirreef matuma ofiitiin kakate. <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />Innis, “Ani dhugumaan eebba, sin eebbisa; baayʼisuus si baayʼisa”<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 22:17">Uma 22:17</ref></char></char></note> jedha. <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Kanaafuu Ibraahim obsaan eeggatee waan waadaa galame sana argate.<verse eid="HEB 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16" />Namoonni kan isaan caaluun kakatu; kakuun sunis waan jedhame sana mirkaneessee akka falmiin hundumtuu fiixaan baʼu godha. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />Allaahan haala kaayyoo isaa kan hin geeddaramne sana caalaatti ibsee warra waadaa dhaalanitti argisiisuu waan barbaadeef waadaa sana kakuudhaan cimse. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />Egaa waan hin geeddaramne kan Allaahan waaʼee isaanii sobuu hin dandeenye lamatu jira; kanaafuu nu warri isatti baqanne abdii fuula keenya dura kaaʼame sana jabeessinee qabachuuf jajjabina guddaa qabna. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />Nus abdii kana akka hiituu dooniitti lubbuuf qabna. Abdiin kunis iddoo qulqulluu golgaa duuba jiru sana ol seena; <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />iddoon kunis kan Iisaan iddoo keenya buʼee nu dursee itti ol seenee dha. Innis akka sirna Malkiiseedeqitti luba ol aanaa bara baraa taʼeera.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s1">Malkiiseedeq Lubicha</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Malkiiseedeq mootii Saalemiitii fi luba Allaah Waan Hundaa Olii ture. Innis utuu Ibraahim mootota moʼatee deebiʼuu itti dhufee isa eebbise; <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />Ibraahimis waan hundumaa kudhan keessaa tokko isaaf kenne. Jalqabatti maqaan isaa, “Mootii qajeelummaa” jechuu dha; ergasii immoo, “Mootii Saalem” jechuunis, “Mootii nagaa” jechuu dha. <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />Inni abbaa yookaan haadha hin qabu; hidda dhalootaas hin qabu; jalqaba guyyootaa yookaan dhuma jireenyaas hin qabu; inni akkuma Ilma Allaahatti luba bara baraa taʼee jiraata.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Egaa Ibraahim hangafni abbootii iyyuu erga waan boojiʼe irraa kudhan keessaa tokko isaaf kennee, Malkiiseedeq hammam guddaa akka taʼe mee ilaalaa! <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Ilmaan Lewwii warri luboota taʼan yoo obboloonni isaanii sanyii Ibraahim taʼan iyyuu namoota irraa jechuunis obbolootuma isaanii irraa kudhan keessaa tokko akka fudhatan seerri ni ajaja. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Namichi sanyii isaanii irraa hin taʼin kun garuu Ibraahim isa waadaan galameef sana irraa kudhan keessaa tokko fudhatee isa eebbise. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Inni xinnaan akka isa guddaadhaan eebbifamu shakkii hin qabu. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Karaa tokkoon kudhan keessaa tokko namoota duʼa hin oolleen walitti qabama; karaa kaaniin immoo isa jiraataa taʼuun isaa dhugaa baʼameef sanaan walitti qabama. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Lewwiin inni kudhan keessaa tokko walitti qabu mataan isaa iyyuu kudhan keessaa harka tokko karaa Ibraahimiitiin baaseera jechuun ni dandaʼama; <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />Malkiiseedeq yommuu Ibraahimin simatetti Lewwiin mudhii abbaa ofii isaa keessa tureetii.<verse eid="HEB 7:10" /></para>
  <para style="s1">Iisaa Akka Malkiiseedeqiiti</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Utuu sirni lubummaa Lewwii kan hirʼina hin qabne taʼee, silaa lubni biraa kan akka sirna lubummaa Haaruunitti utuu hin taʼin lubni akka sirna lubummaa Malkiiseedeqitti filatame dhufuun isaa maaliif barbaachise ree? Seerri sirna lubummaa Lewwii kana irratti hundeeffamee sabaaf kennameetii. <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Yommuu lubummaan geeddaramu seerichis akkasuma geeddaramaatii. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Inni wanni kun waaʼee isaa dubbatame sun gosti isaa kan biraa ti; gosa kana keessaas namni tokko iyyuu takkumaa iddoo aarsaa hin tajaajille. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Gooftaan keenya akka sanyii Yihuudaa irraa dhalate beekamaadhaatii; Muusaanis gosa sana ilaalchisee waaʼee lubummaa homaa hin dubbanne. <verse eid="HEB 7:14" /><verse number="15" style="v" sid="HEB 7:15" />Yommuu lubni akka Malkiiseedeqi kan biraa kaʼutti, wanni nu dubbanne sun ittuma caalee ifa taʼa; <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />innis utuu ajaja fooniitiin hin taʼin humna jireenya hin badneetiin luba taʼe. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Waaʼee isaas,</para>
  <para style="q1" vid="HEB 7:17">“Akkuma sirna Malkiiseedeqitti,</para>
  <para style="q2" vid="HEB 7:17">ati luba bara baraa ti”<note caller="+" style="f"><char style="fr" closed="false">7:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:4">Zab 110:4</ref></char></char></note></para>
  <para style="m" vid="HEB 7:17">jedhamee dhugaa baʼameeraafiitii.<verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />Ajajni duraa sun waan dadhabaa fi kan hin fayyadne tureef diigameera. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />Sababii seerri waanuma tokko illee kan mudaa hin qabne hin godhiniif abdiin caalu kan nu ittiin gara Allaahatti dhiʼaannu tokko dhufeera.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />Kunis kakaa malee hin taane! Warri kaan immoo kakaa tokko malee luboota taʼan; <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />inni garuu yeroo Allaahan,</para>
  <para style="q1" vid="HEB 7:21">“Gooftaan, ‘Ati luba bara baraa ti’</para>
  <para style="q2" vid="HEB 7:21">jedhee kakateera;</para>
  <para style="q2" vid="HEB 7:21">inni yaada isaa hin geeddaru”<note caller="+" style="f" category="dup"><char style="fr" closed="false">7:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:4">Zab 110:4</ref></char></char></note></para>
  <para style="m" vid="HEB 7:21">isaan jedhetti kakaadhaan luba taʼe. <verse eid="HEB 7:21" /><verse number="22" style="v" sid="HEB 7:22" />Iisaan sababii kakaa kanaatiif kakuu caaluuf wabii taʼeera.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />Luboonni durii sababii duuti akka isaan tajaajila itti hin fufneef isaan dhowweef baayʼee turan; <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />Iisaan garuu waan bara baraan jiraatuuf lubummaa hin geeddaramne qaba. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Kanaaf inni yeroo hundumaa waan isaaniif duʼaa gochuuf jiraatuuf warra karaa isaatiin gara Allaaha dhufan guutumaan guutuutti fayyisuu ni dandaʼa.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />Egaa luba ol aanaa qulqulluu, kan mudaa hin qabne, kan xurii hin qabne, kan cubbamoota irraa adda taʼe, shamaayʼun olittis kan kabajame akkasii qabaachuun nu barbaachisa. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />Inni akka luboota ol aantota kaaniitti guyyuma guyyaan duraan dursee cubbuu ofii isaatiif, ergasii immoo cubbuu namootaatiif aarsaa dhiʼeessuun isa hin barbaachisu. Inni yommuu of kenne sanatti al tokko yeroo hundaaf cubbuu namootaatiif aarsaa dhiʼeesseeraatii. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Seerichi namoota dadhaboo, luboota ol aantota godhee muudaatii; dubbiin kakaa kan seera booddee dhufe garuu, Ilma Allaaha isa bara baraan mudaa hin qabne sana muuda.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s1">Luba Ol aanaa Kakuu Haaraa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Waan nu dubbannu keessaa ijoon kana: Nu luba ol aanaa shamaayʼun irra karaa mirga teessoo Isa Ulfina Qabeessa Shamaayʼun keessaa sanaa taaʼe akkasii qabna. <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />Innis iddoo qulqullummaa fi dunkaana isa dhugaa kan utuu namaan hin taʼin Gooftaadhaan dhaabame keessa tajaajila.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />Lubni ol aanaan kam iyyuu kennaa fi aarsaa dhiʼeessuuf muudama; kanaafuu lubni kun waan dhiʼeessu tokko qabaachuu qaba. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Waan luboonni akka seeraatti kennaa dhiʼeessan duraanuu jiraniif, inni utuu lafa irra jiraatee silaa luba hin taʼu ture. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />Isaanis iddoo qulqullummaa kan fakkeenyaa fi gaaddidduu wantoota shamaayʼun tajaajilu. Allaahanis yommuu Muusaan dunkaana qulqulluu dhaabuuf kaʼetti, “Waan hunda akkuma fakkeenya tulluu irratti sitti argisiifame sanaatti hojjechuu kee mirkaneeffadhu!”<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 25:40">Bau 25:40</ref></char></char></note> jedhee isa akeekkachiisuun isaa kanumaaf. <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Garuu akkuma kakuun inni Iisaa gidduu galeessa taʼeef sun kakuu moofaa akka malee caalu sana tajaajilli inni fudhates tajaajila isaanii irra guddaa dha; kakuun haaraan waadaa caalu irratti hundeeffameetii.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />Utuu kakuun jalqabaa sun mudaa qabaachuu baatee silaa kakuun lammaffaan hin barbaachisu ture. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Allaahan garuu saba sana irratti balleessaa argee akkana jedha;</para>
  <para style="q1" vid="HEB 8:8">“Yeroon ani itti mana Israaʼel wajjin,</para>
  <para style="q2" vid="HEB 8:8">mana Yihuudaa wajjinis,</para>
  <para style="q1" vid="HEB 8:8">kakuu haaraa galu ni dhufa</para>
  <para style="q2" vid="HEB 8:8">jedha Gooftaan.<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />Kakuun kunis kakuu ani,</para>
  <para style="q2" vid="HEB 8:9">yeroo biyya Gibxiitii isaan baasuuf jedhee</para>
  <para style="q1" vid="HEB 8:9">harka isaanii qabe sana</para>
  <para style="q2" vid="HEB 8:9">abbootii isaanii wajjin gale sanaan tokko miti;</para>
  <para style="q1" vid="HEB 8:9">isaan kakuu kootti jabaatanii waan hin dhaabatiniif,</para>
  <para style="q2" vid="HEB 8:9">ani isaan irraa gara galeera,</para>
  <para style="q2" vid="HEB 8:9">jedha Gooftaan.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Kakuun ani yeroo sana booddee</para>
  <para style="q2" vid="HEB 8:10">mana Israaʼel wajjin galu kanaa dha, jedha Gooftaan.</para>
  <para style="q1" vid="HEB 8:10">Ani seera koo qalbii isaanii keessa nan kaaʼa;</para>
  <para style="q2" vid="HEB 8:10">garaa isaanii keessattis nan barreessa.</para>
  <para style="q1" vid="HEB 8:10">Ani Allaah isaanii nan taʼa;</para>
  <para style="q2" vid="HEB 8:10">isaanis saba koo ni taʼu.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Sababii hundi isaanii,</para>
  <para style="q2" vid="HEB 8:11">xinnaa hamma guddaatti na beekaniif,</para>
  <para style="q1" vid="HEB 8:11">siʼachi namni kam iyyuu, ‘Gooftaa beeki’ jedhee,</para>
  <para style="q2" vid="HEB 8:11">ollaa isaa yookaan obboleessa isaa hin barsiisu.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />Ani daba isaanii nan dhiisaaf;</para>
  <para style="q2" vid="HEB 8:12">cubbuu isaaniis siʼachi hin yaadadhu.”<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 31:31-34">Erm 31:31‑34</ref></char></char></note><verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />Innis kakuu kanaan “haaraa” jedhee kakuu jalqabaa sana moofesseera; wanni moofaʼee fi wanni dulloome dafee bada.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s1">Iddoo Qulqulluu Isa Lafaa Keessatti waaqeffachuu</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Kakuun jalqabaa sun iyyuu sirna waaqeffannaatii fi iddoo qulqulluu isa lafa irraa qaba ture. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />Dunkaanni qulqulluun dhaabamee ture. Kutaan dunkaana sanaa kan jalqabaa, “Iddoo Qulqulluu” jedhama ture; kutaa kana keessas baattuu ibsaatii fi minjaala akkasumas buddeena qulqulleeffametu ture. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />Golgaa lammaffaa duubaan immoo kutaa, “Iddoo Hundumaa Caalaa Qulqulluu” jedhamu tokkotu ture. <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />Achis iddoo aarsaa ixaanaa kan warqee irraa hojjetamee fi taabota kakuu kan karaa hundaan warqee dibametu ture. Taabota sana keessas okkotee warqee kan mannaa baatu, ulee Haaruun inni latee fi gabatee dhagaa kan kakuun sun irratti barreeffametu kaaʼame. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />Taaboticha gubbaadhaanis kiirubeeliin Ulfinaa teessoo araaraa irra golboobanii turan. Amma garuu waaʼee kanaa gad fageenyaan dubbachuu hin dandeenyu.<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />Luboonni yommuu wanni hundinuu haala kanaan qopheeffametti tajaajila kennuuf jedhanii yeroo hunda dunkaana qulqulluu isa jalqabaa seenu turan. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />Dunkaana isa lammaffaa garuu luba ol aanaa qofatu waggaatti yeroo tokko qofa seena; innis dhiiga cubbuu ofii isaatiif dhiʼeessuu fi dhiiga cubbuu namoonni utuu hin beekin hojjetaniif dhiʼeessu qabatu malee hin seenu ture. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Hafuurri Qulqulluunis hamma dunkaanni jalqabaa sun dhaabatee jirutti akka karaan gara Iddoo Iddoo Hunda Caalaa Qulqulluu taʼeetti geessu sun amma illee hin mulʼifamin haala kanaan argisiisaa ture. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />Kunis fakkeenya bara ammaa ti; innis akka kennaa fi aarsaan dhiʼeeffamu sun qalbii waaqeffataa tokkoo qulqulleessuu hin dandeenye mulʼisa. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />Innis waaʼee nyaataatii fi dhugaatii, waaʼee sirna dhiqannaa garaa garaa jechuunis sirna foonii isa hamma seerichi haaromfamutti faayidaa kennaa ture qofa.<verse eid="HEB 9:10" /></para>
  <para style="s1">Dhiiga Al-Masiihii</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Al-Masiihiin garuu yommuu waan gaarii dhufuuf jiruuf luba ol aanaa taʼee dhufetti, dunkaanicha guddaa mudaa hin qabne, kan harka namaatiin hin hojjetamin jechuunis kan uumama kana irraa hin dhufin sana keessa darbe. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />Dhiiga reʼootaatii fi dhiiga jabbootaatiin hin seenne; garuu furii bara baraa nuu fiduudhaan dhiiguma ofiitiin yeroo tokko bara baraan gara Iddoo Iddoo Hunda Caalaa Qulqulluu taʼe sanaatti seene. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Erga dhiigni reʼootaa, dhiigni korommiitii fi daaraan goromsaa kan warra xuraaʼanitti facaafamu akka isaan fooniin qulqullaaʼan godhee, <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />yoos dhiigni Al-Masiihi isa karaa Hafuura bara baraatiin aarsaa hirʼina hin qabne taʼee Allaahaf of dhiʼeesse sanaa akka nu Allaah jiraataa tajaajilluuf hammam caalaa hojii gara duʼaatti nama geessu irraa qalbii keenya haa qulqulleessuu ree!<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />Sababii kanaaf akka warri waamaman dhaala bara baraa isa abdii kenname sana argataniif Al-Masiihiin araarsaa gidduu galeessa kakuu haaraa ti; inni cubbuu isaan yeroo kakuu jalqabaa jala turanitti hojjetan irraa isaan bilisoomsuuf jedhee furii taʼee duʼeeraatii.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />Iddoo dhaamsi dhaalaa jirutti duʼa namicha dhaamate sanaa mirkaneessuun barbaachisaa dha; <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />dhaamsi dhaalaa yommuu namni dhaamate sun duʼu qofa hojii irra oola malee utuu inni lubbuun jiruu hin hojjetuutii. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />Sababiin kakuun jalqabaa iyyuu dhiiga malee hojii irra hin ooliniifis kanuma. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Muusaan erga ajaja seera sanaa tokko tokkoon saba sana hundatti himee booddeetti, dhiiga jabbootaatii fi dhiiga reʼootaa bishaan wajjin, rifeensa hoolaa bildiimaa fi hiisophii fuudhee kitaaba maramaa fi saba hundatti facaase. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />Innis, “Kun dhiiga kakuu kan Allaahan isiniif ajajee dha”<note caller="+" style="f"><char style="fr" closed="false">9:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 24:8">Bau 24:8</ref></char></char></note> jedhe. <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Haaluma wal fakkaatuunis dunkaanichattii fi miʼa dunkaanicha keessatti sirna waaqeffannaatiif itti fayyadaman hundumatti dhiiga sana facaase. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Dhugumaan akka seeraatti wantoota muraasa malee wanni hundinuu dhiigaan qulqulleeffama; dhiigni dhangalaafamu malees dhiifamni cubbuu hin jiru.<verse eid="HEB 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Kanaafuu fakkeenyawwan waan shamaayʼun irraa aarsaawwan kanneeniin qulqulleeffamuun barbaachisaa ture; wanni shamaayʼun irraa mataan isaa garuu aarsaawwan waan kanneen caalaniin qulqulleeffamuu isaan barbaachisa. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />Al-Masiihiin amma iddoo keenya buʼee fuula Allaaha duratti argamuuf shamaayʼun seene malee iddoo qulqulluu kan harka namaatiin ijaarame isa fakkeenya iddoo qulqulluu kan dhugaa taʼe hin seenne. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Yookaan inni akkuma luba ol aanaa wagguma waggaan dhiiga kan isaa hin taʼin qabatee Iddoo Iddoo Hunda Caalaa Qulqulluu taʼe seenu sanaatti yeroo baayʼee of dhiʼeessuuf shamaayʼun hin seenne. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />Utuu akkas taʼee silaa Al-Masiihiin uumama addunyaatii jalqabee yeroo baayʼee dhiphachuu qaba ture. Amma garuu inni ofii isaa aarsaa godhee cubbuu balleessuuf dhuma baraatti yeroo tokko bara baraan mulʼateera. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Akkuma yeroo tokko duʼuun ergasii immoo murtiitti dhiʼaachuun namatti murteeffame sana <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />akkasuma immoo Al-Masiihiin cubbuu namoota baayʼee baachuuf jedhee yeroo tokko aarsaa taʼeera; yeroo lammaffaa immoo cubbuu baachuuf utuu hin taʼin warra isa eeggachaa jiraniif fayyina fiduuf ni mulʼata.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="s1">Al-Masiihiin Aarsaa Taʼuu Isaa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Seerri gaaddidduu waan gaarii dhufuuf jiruu qofa malee bifa dhugaa miti. Kanaafuu seerichi aarsaa utuu wal irraa hin citin wagguma waggaan dhiʼeeffamu sanaan gonkumaa namoota waaqeffachuuf dhiʼaatan sana warra mudaa hin qabne gochuu hin dandaʼu. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Utuu isaan waan kana gochuu dandaʼanii silaa aarsaan dhiʼeeffamuun isaa ni hafa ture mitii? waaqeffattoonnis siʼa tokko yeroo hundaaf ni qulqulleeffamu turaniitii; ergasii sababii cubbuu isaaniitiif yakki isaanitti hin dhagaʼamu ture. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Aarsaawwan kunneen garuu wagguma waggaan cubbuu nama yaadachiisu. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Sababiin isaas dhiigni korommiitii fi dhiigni reʼootaa gonkumaa cubbuu dhabamsiisuu hin dandaʼuutii.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />Kanaafuu Al-Masiihiin yommuu gara addunyaa dhufetti akkana jedhe:</para>
  <para style="q1" vid="HEB 10:5">“Ati aarsaa fi kennaa hin feene;</para>
  <para style="q2" vid="HEB 10:5">garuu dhagna naa qopheessite;<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />ati aarsaa gubamuu fi</para>
  <para style="q2" vid="HEB 10:6">kennaa sababii cubbuutiif</para>
  <para style="q2" vid="HEB 10:6">dhiʼeeffamutti hin gammanne.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />Yeroo sana ani, ‘Ani kunoo ti;</para>
  <para style="q2" vid="HEB 10:7">waaʼeen koo kitaaba maramaa keessatti barreeffameera;</para>
  <para style="q2" vid="HEB 10:7">yaa Allaah ko, ani fedhii kee raawwachuuf dhufeera’ nan jedhe.”<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 40:6-8">Zab 40:6‑8</ref></char></char></note><verse eid="HEB 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />Isaan akka seeraatti dhiʼeeffaman iyyuu inni jalqabatti, “Ati qalmawwanii fi aarsaawwan, aarsaawwan gubamanii fi aarsaawwan cubbuuf dhiʼeeffaman hin feene yookaan itti hin gammanne” jedhe. <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />Ergasiis inni, “Ani kunoo fedhii kee raawwachuuf dhufeera” jedhe. Innis isa lammaffaa dhaabuuf jedhee isa jalqabaa dhabamsiise. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Fedhii sanaanis nu aarsaa dhagna Iisaa Al-Masiihi isa siʼa tokko yeroo hundaaf dhiʼeeffameen qulqulleeffamneerra.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />Lubni hundinuu guyyuma guyyaan dhaabatee tajaajila isaa raawwata; aarsaa gonkumaa cubbuu dhabamsiisuu hin dandeenye sanas yeroo hunda dhiʼeessa. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Lubni kun garuu erga aarsaa tokkicha bara baraan cubbuudhaaf dhiʼeessee booddee gara mirga Allaaha taaʼe. <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />Yeroo sanaa jalqabees hamma diinonni isaa ejjeta miilla isaa taasifamanitti ni eeggata; <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />inni aarsaa tokkicha sanaan warra qulqulleeffamuutti jiran kanneen bara baraan mudaa hin qabne godheeraatii.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />Hafuurri Qulqulluunis waaʼee kanaa dhugaa nuu baʼa. Innis jalqabatti akkana jedha:<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“Kakuun ani yeroo sana booddee isaan wajjin galu kanaa dha,</para>
  <para style="q2" vid="HEB 10:16">jedha Gooftaan.</para>
  <para style="q1" vid="HEB 10:16">Ani seera koo qalbii isaanii keessa nan kaaʼa;</para>
  <para style="q2" vid="HEB 10:16">garaa isaanii keessattis nan barreessa.”<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 31:33">Erm 31:33</ref></char></char></note><verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />Ammas,</para>
  <para style="q1" vid="HEB 10:17">“Ani cubbuu fi yakka isaanii</para>
  <para style="q2" vid="HEB 10:17">siʼachi hin yaadadhu”<note caller="+" style="f"><char style="fr" closed="false">10:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 31:34">Erm 31:34</ref></char></char></note></para>
  <para style="m" vid="HEB 10:17">jedha. <verse eid="HEB 10:17" /><verse number="18" style="v" sid="HEB 10:18" />Iddoo isaan kunneen itti dhiifama argatanitti siʼachi sababii cubbuutiif aarsaa dhiʼeessuu hin barbaachisu.<verse eid="HEB 10:18" /></para>
  <para style="s1">Amantiidhaan Cimanii Dhaabachuu</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Kanaafuu yaa obboloota, nu dhiiga Iisaatiin gara Iddoo Iddoo Hunda Caalaa Qulqulluu taʼeetti galuuf ija jabina waan qabnuuf <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />karaa haaraa fi jiraataa golgaa keessaan jechuunis karaa foon isaatiin nuu baname sanaan <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />waan luba guddaa mana Allaaha irratti qabnuuf, <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />kottaa akka qalbiin keenya yaada yakka qabaachuu irraa qulqulleeffamuuf garaa keenyatti nuu facaafamee, dhagna keenyas bishaan qulqulluun dhiqannee garaa qulqulluu amantii mirkanaaʼaa guutuu qabuun Allaahatti dhiʼaannaa. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Inni waadaa gale sun waan amanamaa taʼeef kottaa nu utuu hin raafamin abdii dhugaa baanu sana jabeessinee qabannaa. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Kottaa jaalalaa fi hojii gaariif wal kakaasuuf itti yaadnaa. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />Akka namoonni tokko tokko walitti qabamuu dhiisan sana kottaa nu walitti qabamuu hin dhiifnuu; qooda kanaa akka guyyaan sun dhiʼaate waan argitaniif ittuma caalchifnee wal haa jajjabeessinu.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Nu erga beekumsa dhugaa argannee booddee yoo beekaa ittuma fufnee cubbuu hojjenne, siʼachi aarsaan cubbuuf dhiʼeeffamu hin jiraatu; <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />garuu murtii fi ibidda hamaa diinota Allaaha barbadeessu sodaan eeggachuu qofatu jiraata. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Namni seera Muusaa tuffate kam iyyuu dhuga baatota lamaan yookaan sadiin gara laafina malee ajjeefama. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Nama Ilma Allaaha irra ejjete, nama dhiiga kakuu kan ittiin qulqulleeffame sana akka waan qulqulluu hin taʼiniitti hedee fi nama Hafuura ayyaanaa arrabse tokko adabbii hammam caalaa guddaatu isaaf mala seetu? <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Nu isa, “Haaloo baasuun kan koo ti; ani gatii nan deebisa”<note caller="+" style="f"><char style="fr" closed="false">10:30 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:35">KeD 32:35</ref></char></char></note> jedhe sana beeknaatii; akkasumas, “Gooftaan saba isaatti ni mura”<note caller="+" style="f"><char style="fr" closed="false">10:30 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:36">KeD 32:36</ref>; <ref loc="PSA 135:14">Zab 135:14</ref></char></char></note> jedhe. <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />Harka Allaah jiraataatti kufuun sodaachisaa dha.<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Bara duraa yeroo erga ifni isinii ifee booddee walʼaansoo dhiphinaa guddaa obsitanii keessa dhaabattan sana yaadadhaa. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />Isin yeroo tokko tokko fuula namootaa duratti arrabsoo fi ariʼatamaaf saaxilamtanii turtan; yeroo kaan immoo namoota rakkinni akkasii irra gaʼe wajjin hirmaachaa turtan. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Isin mataan keessan akka qabeenya wayyu kan hin dabarre qabdan waan beektaniif warra hidhaman wajjin dhiphattaniirtu; yommuu qabeenyi keessan saamamus gammachuudhaan fudhattaniirtu. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />Kanaafuu ija jabina keessan isa gatii guddaa qabu sana hin gatinaa.<verse eid="HEB 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="HEB 10:36" />Yommuu fedhii Allaaha raawwattanittis akka waan inni waadaa gale sana argattaniif obsuu isin barbaachisaatii.<verse eid="HEB 10:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="HEB 10:37" />“Yeroo xinnoo keessatti,</para>
  <para style="q2" vid="HEB 10:37">inni dhufuuf jiru ni dhufa;</para>
  <para style="q2" vid="HEB 10:37">hin turus.”<note caller="+" style="f"><char style="fr" closed="false">10:37 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 26:20">Isa 26:20</ref>; <ref loc="HAB 2:3">Anb 2:3</ref></char></char></note><verse eid="HEB 10:37" /></para>
  <para style="m">
    <verse number="38" style="v" sid="HEB 10:38" />Akkasumas,</para>
  <para style="q1" vid="HEB 10:38">“Qajeelaan koo garuu amantiidhaan jiraata.</para>
  <para style="q2" vid="HEB 10:38">Kan duubatti harkifatu immoo</para>
  <para style="q2" vid="HEB 10:38">ani itti hin gammadu.”<note caller="+" style="f"><char style="fr" closed="false">10:38 </char><char style="ft" closed="false"><char style="xt"><ref loc="HAB 2:3">Anb 2:3</ref>,<ref loc="HAB 2:4">4</ref></char></char></note><verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Nu garuu warra amananii lubbuu ofii oolfatan malee warra gara badiisaatti harkifatan miti.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s1">Hojii Amantiin Hojjetu</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Amantiin waan abdannu tokko dhugumaan ni taʼa jennee fudhachuu dha; waan ijaan hin argine tokko immoo qabatamaadha jennee heduu dha. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Jaarsoliifis kanaan dhugaa baʼameetii.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />Addunyaawwan akka ajaja Allaahatiin uumaman, wanni mulʼatus akka waan mulʼatu irraa hin hojjetamin nu amantiidhaan hubanna.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />Haabiil amantiidhaan aarsaa isa Qaabiil dhiʼeesse caalu Allaahaf dhiʼeesse. Inni yommuu Allaahan waaʼee kennaa isaa dhugaa baʼameefitti nama qajeelaa taʼuun isaa amantiidhaan dhugaa baʼameef. Haabiil duʼu iyyuu hamma ammaatti amantiidhaan dubbachaa jira.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />Henook akka duʼa hin argineef amantiidhaan fudhatame; waan Allaahan isa fudhateef inni hin argamne.<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 5:24">Uma 5:24</ref></char></char></note> Inni utuu hin fudhatamin dura akka nama Allaah gammachiiseetti dhugaa baʼameefii tureetii. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Amantiidhaan malee Allaah gammachiisuun hin dandaʼamu; sababiin isaas namni gara isaa dhufu kam iyyuu akka inni jiruu fi akka inni warra isa barbaadaniif gatii kennu amanuu qaba.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />Nuuhi waaʼee waan amma illee ijaan hin argaminii Allaahan isa akeekkachiifnaan sodaatee warra mana isaa jiraatan oolfachuuf jedhee amantiin doonii tolche. Amantii isaatiinis addunyaatti mure; dhaaltu qajeelummaa amantiin argamuus taʼe.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />Ibraahim gara iddoo dhaaluuf jiruu akka dhaqu yommuu waamametti, amantiidhaan ajajame; eessa akka dhaqu iyyuu utuu hin beekin kaʼee deeme. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Innis akka keessummaa biyya ormaa jiruutti biyya isaaf waadaa galame sana keessa amantiidhaan qubate; akkuma warra isa wajjin waadaadhuma sana dhaalan, akkuma Yisihaaqii fi Yaaʼikuub dunkaana keessa jiraate. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />Inni magaalaa hundee qabdu kan Allaahan ijaaree fi tolche eeggachaa tureetii. <verse eid="HEB 11:10" /><verse number="11" style="v" sid="HEB 11:11" />Saaraan yoo umurii daʼumsaa dabartee, dhabduu turte illee isheen waan Allaah waadaa isheef gale sana amanamaa gootee fudhatteef, amantiidhaan mucaa daʼu dandeesse. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Kanaaf namicha akka waan duʼeetti ilaalamu tokkicha kana irraa sanyiin akka urjii shamaayʼun baayʼattuu fi akka cirracha qarqara galaanaa kan hin lakkaaʼamne dhalate.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />Namoonni kunneen hundinuu utuu waan waadaa galameef sana hin argatin amantii isaanii immoo utuu hin dhiisin duʼan. Waadaa sanas fagootti ilaalanii simatan. Isaanis lafa irratti akka keessummootaa fi godaantota turan beekaniiru. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Warri waan akkasii jedhan kunneen akka biyya ofii isaanii eeggachaa jiran mulʼisu. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Isaan utuu waaʼee biyya keessaa baʼan sanaa yaadaa turanii silaa, biyya isaaniitti deebiʼuuf carraa ni argatu turan. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Qooda kanaa isaan biyya wayyu tokko jechuunis biyya shamaayʼun irraa sana hawwaa turan. Kanaafuu Allaahan, Allaah isaanii jedhamee waamamuutti hin qaanaʼu; inni magaalaa isaaniif qopheesseeraatii.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />Ibraahim yeroo Allaahan isa qoretti amantiidhaan Yisihaaqin aarsaadhaaf dhiʼeesse. Isuma waadaa argate sanatu ilma isaa tokkicha aarsaa godhee dhiʼeessuuf qophaaʼe; <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />innis isuma Allaahan, “Sanyiin kee Yisihaaqiin siif waamama”<note caller="+" style="f"><char style="fr" closed="false">11:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 21:12">Uma 21:12</ref></char></char></note> jedheen sana. <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />Ibraahim akka Allaahan warra duʼan keessaa nama kaasuu dandaʼu illee hubatee ture; kunis karaa tokkoon inni ilma isaa Yisihaaqin warra duʼan keessaa deebisee argate jechuu dha.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />Yisihaaq amantiidhaan waan dhufuuf jiru irratti Yaaʼikuubii fi Esaawun eebbise.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />Yaaʼikuub yeroo duʼetti amantiidhaan ilmaan Yuusuf tokko tokkoon eebbise; mataa ulee isaatti irkatees sagade.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />Yuusufis yeroo duʼetti amantiidhaan waaʼee Gibxi keessaa baʼuu ijoollee Israaʼel dubbate; waaʼee lafee isaas ajaja kenne.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />Yeroo Muusaan dhalatetti abbaa fi haati isaa mucaa miidhagaa taʼuu isaa arganii utuu labsii mootichaa hin sodaatin amantiidhaan jiʼa sadii isa dhoksan.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />Muusaan yeroo guddatetti ilma intala Faraʼoon jedhamee waamamuu amantiidhaan dide. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Inni gammachuu cubbuutiin yeroo gabaabaaf gammaduu irra saba Allaaha wajjin dhiphachuu filate. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Inni waan badhaasa isaa of duratti ilaaleef, Al-Masiihiif jedhee salphachuu akka qabeenya Gibxi caalaa gatii guddaa qabuutti fudhate. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />Innis utuu dheekkamsa mootichaa hin sodaatin amantiidhaan Gibxi keessaa baʼe; isa hin mulʼanne sana akka waan argeetti obsee eeggate. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Akka malaʼikkaan hangafa ajjeesu sun hangafoota saba Israaʼel hin tuqneefis amantiidhaan akka Faasiikaan ayyaaneffamu, dhiignis akka facaafamu godhe.<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />Sabni Israaʼel akkuma nama lafa gogaa irra deemuutti amantiin Galaana Diimaa ceʼe; warri Gibxi garuu yommuu akkuma sanatti ceʼuu yaalanitti ni liqimfaman.<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />Dallaan Yerikoo erga guyyaa torba marfamee booddee amantiidhaan jige.<verse eid="HEB 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 11:31" />Sagaagaltuun Rahaab jedhamtu basaastota simachuu isheetiin amantiidhaan hafte malee warra hin amanin wajjin hin ajjeefamne.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />Ani egaa kana caalaa maalin jedha ree? Waaʼee Gedewoon, waaʼee Baaraq, waaʼee Saamsoon, waaʼee Yiftaa, waaʼee Daawud, waaʼee Saamuʼeelii fi waaʼee nabiiʼiyyootaa odeessuuf ani yeroo hin qabu; <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />isaan amantiidhaan mootummoota moʼatan; murtii qajeelaa kennan; waan waadaa galame argatan; afaan leencotaa cufan; <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />amantiidhaan ibidda jabaa dhaamsan; qara goraadee jalaa baʼan; dadhabbiin isaanii jabinatti geeddarame; waraana keessatti humna argatanii loltoota diinaa ariʼan. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Dubartoonnis namoonni isaanii kanneen duʼan duʼaa kaafamaniifii deebisanii fudhatan. Warri kaanis duʼaa kaʼuu wayyu argachuuf jedhanii gad dhiifamuu didanii dhiphatan. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />Warra kaanitti ni qoosame; ni garafamanis; akkasumas foncaan hidhamanii mana hidhaatti darbataman. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Dhagaadhaanis ni tumaman; iddoo lamatti baqaqfaman; goraadeedhaan ajjeefaman. Deeguudhaan, ariʼatamuu fi dhiphachuudhaan gogaa hoolotaatii fi reʼootaa uffatanii jooran; <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />addunyaan isaaniif hin maleetii. Isaanis gammoojjii fi gaara irra, holqaa fi boolla keessa jooraa turan.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />Warri kunneen hundinuu yoo sababii amantii isaaniitiif jajaman iyyuu isaan keessaa namni tokko iyyuu waan waadaa galame sana hin arganne. <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />Allaahan akka isaan nu qofa wajjin warra mudaa hin qabne taʼaniif duraan dursee waan nuuf wayyu argeera.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Kanaafuu nu waan dhuga baatota akka duumessa guddaa akkanaatiin marfamneef kottaa baʼaa hunda, cubbuu xaxee nu qabates of irraa baafnee gannaa; dorgommii fuula keenya dura jirus obsaan jabaannee fiignaa; <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />kottaa Iisaa isa jalqabaa fi fiixaan baasaa amantii keenyaa taʼe sana irra ija keenya kaaʼannaa. Innis gammachuu fuula isaa dura jiruuf jedhee qaanii fannoo tuffachuun fannoo obsee mirga teessoo Allaaha taaʼe. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />Isin akka dadhabdanii abdii hin kutanneef isa mormii cubbamoota isa irra gaʼe akkasii obse sana yaadatti qabadhaa.<verse eid="HEB 12:3" /></para>
  <para style="s1">Allaahan Ilmaan Isaa ni Adaba</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4" />Isin amma iyyuu walʼaansoo cubbuu wajjin gootan keessatti hamma dhiiga dhangalaasuutti jabaattanii hin mormine. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />Dubbii jajjabinaa kan akkuma ilmaaniitti isinitti dubbatu sana irraanfattaniirtu; innis akkana jedha:</para>
  <para style="q1" vid="HEB 12:5">“Yaa ilma ko, adabbii Gooftaa hin tuffatin;</para>
  <para style="q2" vid="HEB 12:5">yommuu inni si ifatus abdii hin kutatin;<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Gooftaan warra jaallatu ni adabaatii;</para>
  <para style="q2" vid="HEB 12:6">inni nama akka ilmaatti ilaalu kam iyyuu ni adaba.”<note caller="+" style="f"><char style="fr" closed="false">12:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 3:11">Fak 3:11</ref>,<ref loc="PRO 3:12">12</ref></char></char></note><verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />Rakkina akkuma adabbiitti obsaa; Allaahan akka ilmaan isaatti isin adabaatii. Ilmi abbaan isaa hin adabne ilma akkamii ti? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Isin yoo adabbii ijoolleen hundinuu ittiin adabaman keessatti hin hirmaanne isin diqaalota malee ijoollee dhugaa miti. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Kana malees nu hundinuu abbootii foonii kanneen nu adaban qabna turre; isaan kabajnas turre. Yoos Abbaa hafuurotaatiif immoo hammam caalaa ajajamnee jiraachuu qabna ree! <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Abbootiin keenya akkuma isaanitti gaarii fakkaatetti yeroo gabaabaaf nu adabaa turan; Allaahan garuu akka nu qulqullummaa isaa keessatti hirmaannuuf faayidaa keenyaaf jedhee nu adaba. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Adabbiin hundinuu yeroo sana waan nama gaddisiisu malee waan nama gammachiisu hin fakkaatu. Ergasii garuu warra adabbii sanaan leenjifamaniif ija qajeelummaa fi nagaa kenna.<verse eid="HEB 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Kanaafuu irree laafee fi jilba dadhabe jabeessaa. <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />Naafti akka fayyuuf malee akka karaa irraa hin jalʼanneef, “Miilla keessaniif daandii qajeelaa baafadhaa.”<note caller="+" style="f"><char style="fr" closed="false">12:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 4:26">Fak 4:26</ref></char></char></note><verse eid="HEB 12:13" /></para>
  <para style="s1">Akeekkachiisa</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Nama hunda wajjin nagaadhaan jiraachuu fi qulqulluu taʼuuf tattaaffadhaa; qulqullummaan malee namni kam iyyuu Gooftaa arguu hin dandaʼuutii. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Nama kamitti iyyuu ayyaanni Allaaha akka hin hirʼanne of eeggadhaa; hiddi hadhaaʼaan biqilee rakkina akka hin uumnee fi namoota baayʼees hin xureessineef of eeggadhaa. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />Namni kam iyyuu akka Esaawu isa mirga hangafummaa isaa nyaata tokkittiitti gurgurate sanaa sagaagaltuu yookaan nama Allaahatti hin bulle hin taaneef of eeggadhaa. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Inni ergasii yeroo eebba sana dhaaluu barbaadetti akka didame isin ni beektu. Inni yoo eebba sana imimmaaniin barbaade illee geeddarama tokko illee fiduu hin dandeenye.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />Isin gara tulluu tuqamuu dandaʼuu fi ibiddi irraa bobaʼu, gara dukkanaa, gara dimimmisaa fi bubbee hin geenye; <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />gara sagalee malakataatii fi gara sagalee dubbii dubbatuu hin geenye; warri isa dhagaʼanis akka dubbiin biraa dabalamee isaanitti hin dubbatamne kadhatan. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />Isaan waan, “Bineensi iyyuu yoo tulluu sana tuqe dhagaadhaan tumamee haa ajjeefamu”<note caller="+" style="f"><char style="fr" closed="false">12:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 19:12">Bau 19:12</ref>,<ref loc="EXO 19:13">13</ref></char></char></note> jedhamee ajajame sana obsuu hin dandeenyeetii. <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Wanti achitti mulʼates waan sodaachisaa taʼeef Muusaan, “Ani sodaadhaan hollachaan jira”<note caller="+" style="f"><char style="fr" closed="false">12:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 9:19">KeD 9:19</ref></char></char></note> jedhe.<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />Isin garuu gara Tulluu Xiyoon, gara magaalaa Allaah jiraataa jechuunis Yerusaalem ishee shamaayʼun keessaa dhuftaniirtu. Gara malaʼikkoota kumaatama gammachuun walitti qabamanii dhuftaniirtu; <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />gara waldaa kiristaanaa hangafoota maqaan isaanii shamaayʼun keessatti barreeffamee dhuftaniirtu. Gara Allaah Abbaa Murtii waan hundaa, gara hafuurota namoota qajeeltota warra mudaa hin qabne taasifamanii, <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />gara Iisaa araarsaa gidduu galeessa kakuu haaraa, gara dhiiga facaafame kan dubbii dhiigni Haabiil dubbatu sana caalaa dubbatuu dhuftaniirtu.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />Isinis akka isa dubbachaa jiru sana hin didneef of eeggadhaa. Erga isaan yeroo isa lafa irratti isaan akeekkachiise sana didanitti jalaa hin baʼin, nu immoo yoo isa shamaayʼun irraa nu akeekkachiisu sana irraa gara galle akkamitti jalaa baʼuu dandeenya ree? <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />Yeroo sanatti sagaleen isaa lafa sochoose; amma garuu inni, “Ani ammas yeroo tokko lafa qofa utuu hin taʼin shamaayʼuniiwwanis nan sochoosa”<note caller="+" style="f"><char style="fr" closed="false">12:26 </char><char style="ft" closed="false"><char style="xt"><ref loc="HAG 2:6">Hag 2:6</ref></char></char></note> jedhee waadaa galeera. <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Dubbiin, “Ammas yeroo tokko” jedhu kun akka wanni hin sochoofamne hafee jiraatuuf, wanni sochoofamu jechuunis wanni uumame baduu isaa argisiisa.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />Kanaafuu nu waan mootummaa hin sochoone argannuuf kottaa haa galateeffannu! Kabajaa fi sodaadhaanis karaa fudhatamaa taʼeen Allaah haa waaqeffannu; <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />“Allaahan keenya ibidda gubee balleessuudhaatii.”<note caller="+" style="f"><char style="fr" closed="false">12:29 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 4:24">KeD 4:24</ref></char></char></note><verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s1">Gorsa Xumuraa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Akka obbolootaatti wal jaallachuu itti fufaa. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Keessumoota simachuu hin irraanfatinaa; namoonni tokko tokko akkasiin utuu hin beekin malaʼikkoota Allaaha simataniiruutii. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Warra mana hidhaa jiran akka waan isaan wajjin hidhamtaniitti, warra dhiphina keessa jiranis akka waan ofii dhiphattaniitti yaadadhaa.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />Fuudhaa fi heerumni nama hunda biratti haa kabajamu; sireen fuudhaa fi heerumaas qulqulluu haa taʼu; Allaahan ejjitootaa fi sagaagaltootatti ni muraatii. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />Jireenya keessan jaalala maallaqaa irraa jabeessaa eeggadhaa; wanni qabdan isin haa gaʼu; Allaahan,</para>
  <para style="q1" vid="HEB 13:5">“Ani gonkumaa si hin dhiisu;</para>
  <para style="q2" vid="HEB 13:5">gonkumaas si hin gatu”<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 31:6">KeD 31:6</ref></char></char></note></para>
  <para style="m" vid="HEB 13:5">jedheeraatii. <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />Kanaaf nu ija jabinaan,</para>
  <para style="q1" vid="HEB 13:6">“Gooftaan gargaaraa koo ti; ani hin sodaadhu.</para>
  <para style="q2" vid="HEB 13:6">Namni maal na gochuu dandaʼa?”<note caller="+" style="f"><char style="fr" closed="false">13:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:6">Zab 118:6</ref>,<ref loc="PSA 118:7">7</ref></char></char></note> jenna.<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Hooggantoota keessan warra dubbii Allaaha isinitti himanii turan sana yaadadhaa. Waan jireenya isaanii irraa argames ilaalaa; amantii isaanii duukaa buʼaa. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Iisaa Al-Masiihiin kaleessa, harʼa, bara baraanis sanuma.<verse eid="HEB 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 13:9" />Barsiisa gosa hundumaa kan keessummaa taʼeen hin fudhataminaa. Garaan keenyas sirna waaʼee nyaataatiin utuu hin taʼin ayyaanaan jabina argachuu qaba; sirni waaʼee nyaataa warra isa kabajan iyyuu hin fayyadu. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />Nu iddoo aarsaa kan warri dunkaana qulqulluu keessa tajaajilan irraa nyaachuuf mirga hin qabne tokko qabna.<verse eid="HEB 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 13:11" />Lubni ol aanaan dhiiga horii qabatee sababii cubbuutiif aarsaa dhiʼeessuuf jedhee Iddoo Iddoo Hunda Caalaa Qulqulluu taʼe sana seena; foon horii sanaas qubata keessaa gad baafamee gubama. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Kanaafuu Iisaanis dhiiga ofiitiin saba qulqulleessuuf jedhee karra magaalattiitiin alatti dhiphate. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Egaa kottaa nus salphina inni baate sana baannee iddoo qubataatiin ala gara isaa haa dhaqnu. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Nu magaalaa dhufuuf jirtu eegganna malee magaalaa bara baraa asii hin qabnuutii.<verse eid="HEB 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15" />Kanaafuu kottaa utuu gargar hin kutin karaa Iisaatiin aarsaa galataa Allaahaf haa dhiʼeessinu; aarsaan kunis dubbii maqaa isaa beeksisuuf afaan keenya keessaa baʼuu dha. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Waan gaarii gochuu fi waan qabdanis namaan gaʼuu hin dhiisinaa; Allaahan aarsaa akkasiitti gammadaatii.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Hooggantoota keessaniif ajajamaa; isaaniifis bulaa. Isaan waan itti gaafatamtoota lubbuu keessanii taʼaniif isin eegu; kanas utuu gaddaan hin taʼin akka isaan gammachuun hojjetaniif isaaniif ajajamaa; yoo isaan gaddaan hojjetan isin hin fayyaduutii.<verse eid="HEB 13:17" /></para>
  <para style="s1">Akka Duʼaa Godhaniif Gaafachuu</para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Isin Allaah duratti duʼaa nuu godhaa. Nu akka karaa hundumaan qalbii qulqulluu qabnuu fi akka jireenya kabajamaa jiraachuu hawwinu mirkaneeffanneerra. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Keessumattuu akka ani dafee deebiʼee gara keessan dhufuuf akka Allaah duratti duʼaa gootan isin gorsa.<verse eid="HEB 13:19" /></para>
  <para style="s1">Eebbaa fi Dhaamsa Nagaa Xumuraa</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Allaahan nagaa inni karaa dhiiga kakuu bara baraatiin Gooftaa keenya Iisaa, Tiksee hoolotaa guddicha sana warra duʼan keessaa kaase sun, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />akka isin fedhii isaa raawwattaniif waan gaarii hundaan isin haa qopheessu; innis karaa Iisaa Al-Masiihiitiin waan isa gammachiisu nu keessatti haa hojjetu; ulfinni bara baraa hamma bara baraatti Iisaa Al-Masiihiif haa taʼu. Ameen.<verse eid="HEB 13:21" /></para>
  <para style="b" />
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Yaa obboloota nana, ani waan xalayaa gabaabaa isinii barreesseef, akka isin ergaa gorsaa kana obsaan fudhattan isin kadhadha.<verse eid="HEB 13:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="HEB 13:23" />Akka obboleessi keenya Xiimotewos mana hidhaatii hiikame akka beektan nan barbaada. Yoo inni dafee as dhufe ani isin arguuf isa wajjin nan dhufa.<verse eid="HEB 13:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Hooggantoota keessan hundaa fi qulqulloota hundatti nagaa naa himaa.</para>
  <para style="p" vid="HEB 13:24">Warri Iixaaliyaa irraa dhufanis nagaa isinii dhaamu.<verse eid="HEB 13:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />Ayyaanni isin hunda wajjin haa taʼu.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>