  <para style="h">1 Seenaa</para>
  <para style="toc1">Kitaaba Seenaa Tokkoffaa</para>
  <para style="toc2">1 Seenaa</para>
  <para style="toc3">1Sn</para>
  <para style="mt2">Kitaaba</para>
  <para style="mt1">Seenaa</para>
  <para style="mt3">Tokkoffaa</para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s1">Sanyii Aadam</para>
  <para style="s2">Hamma Ilmaan Nuuhiitti</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 1:1" />Aadam, Seeti, Enoosh,<verse eid="1CH 1:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 1:2" />Qeenaan, Mahalaleel, Yaared,<verse eid="1CH 1:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 1:3" />Henook, Matuuselaa, Laameh,</para>
  <para style="li1" vid="1CH 1:3">Noh.<verse eid="1CH 1:3" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="4" style="v" sid="1CH 1:4" />Ilmaan Nuuhi: Seem, Haam, Yaafet:<verse eid="1CH 1:4" /></para>
  <para style="s2">Yaafetoota</para>
  <para style="r">
    <ref loc="1CH 1:5-7">1:5‑7</ref> kwf – <char style="xt"><ref loc="GEN 10:2-5">Uma 10:2‑5</ref></char></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5" />Ilmaan Yaafet:</para>
  <para style="li2" vid="1CH 1:5">Goomer, Maagoog, Meedee, Yaawaan, Tuubaal, Meshekii fi Tiiraas turan.<verse eid="1CH 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 1:6" />Ilmaan Goomer:</para>
  <para style="li2" vid="1CH 1:6">Ashkenas, Riifaatii fi Toogarmaa turan.<verse eid="1CH 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7" />Ilmaan Yaawaan:</para>
  <para style="li2" vid="1CH 1:7">Al-yaasaʼaa, Tarshiish, Kitiimii fi Roodaanota turan.<verse eid="1CH 1:7" /></para>
  <para style="s2">Kaamota</para>
  <para style="r">
    <ref loc="1CH 1:8-16">1:8‑16</ref> kwf – <char style="xt"><ref loc="GEN 10:6-20">Uma 10:6‑20</ref></char></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8" />Ilmaan Haam:</para>
  <para style="li2" vid="1CH 1:8">Kuushi, Misrayim, Fuuxii fi Kanaʼaan turan.<verse eid="1CH 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9" />Ilmaan Kuushi:</para>
  <para style="li2" vid="1CH 1:9">Saabaa, Hawiilaa, Sabtaa, Raʼimaa fi Sabtekaa turan.</para>
  <para style="li1" vid="1CH 1:9">Ilmaan Raʼimaa:</para>
  <para style="li2" vid="1CH 1:9">Shebaa fi Dedaan turan.<verse eid="1CH 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 1:10" />Kuushi abbaa Naamruud;</para>
  <para style="li2" vid="1CH 1:10">Naamruudis lafa irratti loltuu jabaa taʼe.<verse eid="1CH 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11" />Misrayim immoo abbaa</para>
  <para style="li2" vid="1CH 1:11">Luudiimootaa, Anaamiimotaa, Lehaabiimotaa, Naftahiimootaa, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />Fatrusiimotaa, Kaseluhiimotaa jechuunis warra Filisxeemonni irraa dhalatanii fi Kaftooriimotaa ti.<verse eid="1CH 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13" />Kanaʼaan abbaa</para>
  <para style="li2" vid="1CH 1:13">Siidoon ilma isaa hangaftichaa akkasumas kan Heetotaa, <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />Yebuusotaa, Amoorotaa, Girgaashotaa, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />Hiiwotaa, Arkaawotaa, Siinotaa, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />Arwaadewotaa, Zemaarotaatii fi Hamaatotaa ture.<verse eid="1CH 1:16" /></para>
  <para style="s2">Seemota</para>
  <para style="r">
    <ref loc="1CH 1:17-23">1:17‑23</ref> kwf – <char style="xt"><ref loc="GEN 10:21-31">Uma 10:21‑31</ref>; <ref loc="GEN 11:10-27">11:10‑27</ref></char></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17" />Ilmaan Seem:</para>
  <para style="li2" vid="1CH 1:17">Eelaam, Ashuur, Arfaakshad, Luudii fi Arraam turan.</para>
  <para style="li1" vid="1CH 1:17">Ilmaan Arraam:</para>
  <para style="li2" vid="1CH 1:17">Uuzi, Huuli, Geterii fi Meshek turan.<verse eid="1CH 1:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18" />Arfaakshad Sheelaa dhalche;</para>
  <para style="li2" vid="1CH 1:18">Sheelaan immoo Eeberin dhalche.<verse eid="1CH 1:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 1:19" />Eeberiifis ilmaan lamatu dhalate:</para>
  <para style="li2" vid="1CH 1:19">Sababii bara isaa keessa lafti gargar qoodamteef, maqaan isa tokkoo Felegi jedhamee moggaafame; maqaan obboleessa isaa immoo Yooqxaan jedhamee moggaafame.<verse eid="1CH 1:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20" />Yooqxaan immoo</para>
  <para style="li2" vid="1CH 1:20">Almoodaad, Sheleef, Hazarmaawet, Yaaraa, <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />Hadooraam, Uuzaal, Diqlaa, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />Eebaal, Abiimaaʼeel, Shebaa, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />Oofiir, Hawiilaa fi Yoobaabin dhalche. Warri kunneen hundinuu ilmaan Yooqxaanii ti.<verse eid="1CH 1:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="1CH 1:24" />Seem, Arfaakshadi, Sheelaa,<verse eid="1CH 1:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 1:25" />Eeberi, Felegi, Reʼuu,<verse eid="1CH 1:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 1:26" />Seruugi, Naahoor, Taaraa,<verse eid="1CH 1:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 1:27" />akkasumas Ibraam kan Ibraahim jedhame sanaa dha.<verse eid="1CH 1:27" /></para>
  <para style="s1">Maatii Ibraahim</para>
  <para style="lh">
    <verse number="28" style="v" sid="1CH 1:28" />Ilmaan Ibraahim: Yisihaaqii fi Ismaʼiil.<verse eid="1CH 1:28" /></para>
  <para style="s2">Sanyiiwwan Haagaari</para>
  <para style="r">
    <ref loc="1CH 1:29-31">1:29‑31</ref> kwf – <char style="xt"><ref loc="GEN 25:12-16">Uma 25:12‑16</ref></char></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29" />Sanyiiwwan isaanii warra kanneenii dha:</para>
  <para style="li2" vid="1CH 1:29">Nabaayooti ilma Ismaʼiil hangafticha, Qeedaar, Adbiʼeel, Mibsaami, <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />Mishmaa, Duumaa, Maasaa, Hadaad, Teemaa, <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />Yexuur, Naafiishii fi Qeedmaa.</para>
  <para style="lf" vid="1CH 1:31">Isaan kunneen ilmaan Ismaʼiil.<verse eid="1CH 1:31" /></para>
  <para style="s2">Sanyiiwwan Heeturaa</para>
  <para style="r">
    <ref loc="1CH 1:32-33">1:32‑33</ref> kwf – <char style="xt"><ref loc="GEN 25:1-4">Uma 25:1‑4</ref></char></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32" />Ilmaan Qexuuraan saajjatoon Ibraahim sun deesse:</para>
  <para style="li2" vid="1CH 1:32">Zimraan, Yoqshaan, Medaan, Midiyaan, Yishbaaqii fi Shuwaa.</para>
  <para style="li1" vid="1CH 1:32">Ilmaan Yokshaan:</para>
  <para style="li2" vid="1CH 1:32">Shebaa fi Dedaan.<verse eid="1CH 1:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33" />Ilmaan Midiyaan:</para>
  <para style="li2" vid="1CH 1:33">Eefaa, Eefer, Henook, Abiidaa fi Eldaaʼaa.</para>
  <para style="lf" vid="1CH 1:33">Warri kunneen hundi sanyiiwwan Qexuuraa ti.<verse eid="1CH 1:33" /></para>
  <para style="s2">Sanyiiwwan Saaraa</para>
  <para style="r">
    <ref loc="1CH 1:35-37">1:35‑37</ref> kwf – <char style="xt"><ref loc="GEN 36:10-14">Uma 36:10‑14</ref></char></para>
  <para style="lh">
    <verse number="34" style="v" sid="1CH 1:34" />Ibraahim abbaa Yisihaaq.</para>
  <para style="li1" vid="1CH 1:34">Ilmaan Yisihaaq:</para>
  <para style="li2" vid="1CH 1:34">Esaawuu fi Israaʼel.<verse eid="1CH 1:34" /></para>
  <para style="s1">Ilmaan Esaawuu</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35" />Ilmaan Esaawu:</para>
  <para style="li2" vid="1CH 1:35">Eliifaaz, Reʼuuʼeel, Yeʼuushi, Yaʼilaamii fi Qooraahi.<verse eid="1CH 1:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36" />Ilmaan Eliifaaz:</para>
  <para style="li2" vid="1CH 1:36">Teemaan, Oomaar, Zefoo, Gaataamii fi Qenaz;</para>
  <para style="li2" vid="1CH 1:36">karaa Tiimnaatiin: Amaaleq.<verse eid="1CH 1:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37" />Ilmaan Reʼuuʼeel:</para>
  <para style="li2" vid="1CH 1:37">Nahaati, Zeraa, Shamaa fi Miizaah.<verse eid="1CH 1:37" /></para>
  <para style="s2">Namoota Seeʼiir kanneen Edoom keessa Jiraatan</para>
  <para style="r">
    <ref loc="1CH 1:38-42">1:38‑42</ref> kwf – <char style="xt"><ref loc="GEN 36:20-28">Uma 36:20‑28</ref></char></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38" />Ilmaan Seeʼiir:</para>
  <para style="li2" vid="1CH 1:38">Looxaan, Sobaal, Zibeʼoon, Aannaa, Diishoon, Eezerii fi Diishaan.<verse eid="1CH 1:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39" />Ilmaan Looxaan:</para>
  <para style="li2" vid="1CH 1:39">Hoorii fi Hoomaam, Tiimnaa obboleettii Looxaan.<verse eid="1CH 1:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40" />Ilmaan Sobaal:</para>
  <para style="li2" vid="1CH 1:40">Aliwaan, Maanahaat, Eebaal, Shefoo fi Oonaami.</para>
  <para style="li1" vid="1CH 1:40">Ilmaan Zibeʼoon:</para>
  <para style="li2" vid="1CH 1:40">Ayyaa fi Aannaa.<verse eid="1CH 1:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41" />Ilmi Aannaa:</para>
  <para style="li2" vid="1CH 1:41">Diishoon.</para>
  <para style="li1" vid="1CH 1:41">Ilmaan Diishoon:</para>
  <para style="li2" vid="1CH 1:41">Hemdaan, Eshbaan, Yitraanii fi Keraan.<verse eid="1CH 1:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42" />Ilmaan Eezeri:</para>
  <para style="li2" vid="1CH 1:42">Bilhaan, Zaawaanii fi Aqaan.</para>
  <para style="li1" vid="1CH 1:42">Ilmaan Diishaan:</para>
  <para style="li2" vid="1CH 1:42">Uuzii fi Araan.<verse eid="1CH 1:42" /></para>
  <para style="s2">Bulchitoota Edoom</para>
  <para style="r">
    <ref loc="1CH 1:43-54">1:43‑54</ref> kwf – <char style="xt"><ref loc="GEN 36:31-43">Uma 36:31‑43</ref></char></para>
  <para style="lh">
    <verse number="43" style="v" sid="1CH 1:43" />Mootonni utuu mootiin Israaʼel tokko iyyuu hin moʼin dura Edoom keessatti moʼan kanneen turan:</para>
  <para style="li1" vid="1CH 1:43">Belaa ilma Beʼoor kan magaalaan isaa Diinhaabaa jedhamee moggaafame sana.<verse eid="1CH 1:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44" />Belaa duunaan Yoobaab ilmi Zeraa namichi Bozraa iddoo isaa buʼee mootii taʼe.<verse eid="1CH 1:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45" />Yoobaab duunaan Hushaam namichi biyya Teemaan iddoo isaa buʼee mootii taʼe.<verse eid="1CH 1:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46" />Hushaam duunaan Hadaad ilmi Bedad inni biyya Moʼaabitti Midiyaanin moʼate sun iddoo isaa buʼee mootii taʼe. Maqaan magaalaa isaa Aawiit jedhame.<verse eid="1CH 1:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47" />Hadaad duunaan Samlaan namichi Masreeqaa iddoo isaa buʼee mootii taʼe.<verse eid="1CH 1:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48" />Samlaan duunaan Shaawul namichi biyya Rehoobooti ishee laga bira jirtu sanaa iddoo isaa buʼee mootii taʼe.<verse eid="1CH 1:48" /></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49" />Shaawul duunaan Baʼaal-Haanaan ilmi Akboor iddoo isaa buʼee mootii taʼe.<verse eid="1CH 1:49" /></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50" />Baʼaal-Haanaan duunaan immoo Hadaad iddoo isaa buʼee mootii taʼe. Magaalaan isaas Faaʼuu jedhame. Maqaan niitii isaa immoo Maheexabiʼeel jedhama ture; isheenis intala Maxreed, intala Mee-Zaahaab turte. <verse eid="1CH 1:50" /><verse number="51" style="v" sid="1CH 1:51" />Hadaadis ni duʼe.</para>
  <para style="b" vid="1CH 1:51" />
  <para style="lh" vid="1CH 1:51">Hangafoota saba Edoom:</para>
  <para style="li1" vid="1CH 1:51">Tiimnaa, Aalwaa, Yeteeti, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />Oholiibaamaa, Eelaa, Phiinoon, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />Qenaz, Teemaan, Mibzaar, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />Magidiiʼeelii fi Iiraam.</para>
  <para style="lf" vid="1CH 1:54">Namoonni kunneen hangafoota Edoom turan.<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s1">Ilmaan Israaʼel</para>
  <para style="r">
    <ref loc="1CH 2:1-2">2:1‑2</ref> kwf – <char style="xt"><ref loc="GEN 35:23-26">Uma 35:23‑26</ref></char></para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 2:1" />Ilmaan Israaʼel warra kanneenii dha: Ruubeen, Simiʼoon, Lewwii, Yihuudaa, Yisaakor, Zebuuloon, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />Daan, Yuusuf, Biniyaam, Niftaalem, Gaadii fi Aasheer.<verse eid="1CH 2:2" /></para>
  <para style="s1">Yihuudaa</para>
  <para style="r">
    <ref loc="1CH 2:5-15">2:5‑15</ref> kwf – <char style="xt"><ref loc="RUT 4:18-22">Rut 4:18‑22</ref>; <ref loc="MAT 1:3-6">Mat 1:3‑6</ref></char></para>
  <para style="s2">Hamma Ilmaan Hezroonitti</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3" />Ilmaan Yihuudaa:</para>
  <para style="li2" vid="1CH 2:3">Eeri, Oonaanii fi Sheelaa. Isaan kanneen sadanuu intala Shuuwaa, dubartii Kanaʼaan sanatu isaaf daʼe.</para>
  <para style="li2" vid="1CH 2:3">Eer ilmi Yihuudaa hangaftichi fuula Rabbii Allaah duratti hamaa ture. Kanaafuu Rabbii Allaahan isa ajjeese.<verse eid="1CH 2:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 2:4" />Taamaar niitiin ilma Yihuudaa Faaresii fi Zaaraa Yihuudaaf deesse.</para>
  <para style="lf" vid="1CH 2:4">Yihuudaan walumaa galatti ilmaan shan qaba ture.<verse eid="1CH 2:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5" />Ilmaan Faares:</para>
  <para style="li2" vid="1CH 2:5">Hezroonii fi Hamuul.<verse eid="1CH 2:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6" />Ilmaan Zaaraa:</para>
  <para style="li2" vid="1CH 2:6">Zimrii, Eetaan, Heemaan, Kalkoolii fi Daardaa. Isaan walumaa galatti dhiirota shan turan.<verse eid="1CH 2:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7" />Ilma Karmii:</para>
  <para style="li2" vid="1CH 2:7">Aakaar isa waan balleeffamuu qabu fudhachuudhaan Israaʼelitti rakkina fide.<verse eid="1CH 2:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8" />Ilma Eetaan:</para>
  <para style="li2" vid="1CH 2:8">Azaariyaa.<verse eid="1CH 2:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9" />Ilmaan Hezroon:</para>
  <para style="li2" vid="1CH 2:9">Yeramiʼeel, Raamii fi Kilaab.<verse eid="1CH 2:9" /></para>
  <para style="s2">Raam ilma Hezroonii jalqabee</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10" />Raam abbaa Abiinaadaab ture;</para>
  <para style="li1" vid="1CH 2:10">Amiinaadaab immoo abbaa Nahishoon hoogganaa saba Yihuudaa ture.<verse eid="1CH 2:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 2:11" />Nahishoon abbaa Salmaan;</para>
  <para style="li1" vid="1CH 2:11">Salmaan immoo abbaa Boʼeez;<verse eid="1CH 2:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 2:12" />Boʼeez abbaa Oobeedi;</para>
  <para style="li1" vid="1CH 2:12">Yoobeed immoo abbaa Isseey.<verse eid="1CH 2:12" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13" />Ilmaan Isseey:</para>
  <para style="li2" vid="1CH 2:13">Ilmi isaa hangafni Eliiyaab, lammaffaan Abiinaadaab,</para>
  <para style="li2" vid="1CH 2:13">sadaffaan Shimeʼaa, <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />Afuraffaan Naatnaaʼel,</para>
  <para style="li2" vid="1CH 2:14">shanaffaan Raadaayi, <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />jaʼaffaan Oozem,</para>
  <para style="li2" vid="1CH 2:15">torbaffaan Daawud.<verse eid="1CH 2:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="1CH 2:16" />Obboleettonni isaanii immoo Zeruuyaa fi Abiigayiil turan.</para>
  <para style="li3" vid="1CH 2:16">Ilmaan Zeruuyaa sadan Abiishaayi, Yooʼaabii fi Asaaheel turan.<verse eid="1CH 2:16" /></para>
  <para style="li3">
    <verse number="17" style="v" sid="1CH 2:17" />Abiigayiil haadha Amaasaa kan abbaan isaa Yeteer nama gosa Ismaʼiil sanaa ti.<verse eid="1CH 2:17" /></para>
  <para style="s2">Kilaab Ilma Hezroon</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18" />Kilaab ilmi Hezroon niitii isaa Azuubaa fi Yeriʼooti irraa ijoollee dhalche. Ilmaan Aazubaa kanneen turan:</para>
  <para style="li2" vid="1CH 2:18">Yeeser, Sobaabii fi Ardoon.<verse eid="1CH 2:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 2:19" />Kilaabis Azuubaan duunaan Efraataa fuudhe. Isheenis Huurin isaaf deesse.<verse eid="1CH 2:19" /></para>
  <para style="li2">
    <verse number="20" style="v" sid="1CH 2:20" />Huuri abbaa Uuri; Uuri immoo abbaa Bezaliʼeel.<verse eid="1CH 2:20" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21" />Ergasii Hezroon yommuu umuriin isaa waggaa jaatama guutetti intala abbaa Giliʼaad intala Maakiir fuudhe; isheenis Seguubin isaaf deesse.<verse eid="1CH 2:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 2:22" />Seguub immoo abbaa Yaaʼiir ture; innis biyya Giliʼaad keessaa magaalaawwan digdamii sadii qaba ture.<verse eid="1CH 2:22" /></para>
  <para style="li2">
    <verse number="23" style="v" sid="1CH 2:23" />Geshuurii fi Arraam, magaalaa Yaaʼiir akkasumas Qeenaatii fi gandoota naannoo ishee jiraniin walitti magaalaawwan jaatama irraa fudhatan.</para>
  <para style="lf" vid="1CH 2:23">Isaan kunneen hundi sanyii abbaa Giliʼaad sanyii Maakiir turan.<verse eid="1CH 2:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24" />Hezroon erga Kilaab Efraataatti duʼee booddee, niitiin isaa Abiyaan Ashihuur abbaa Teqooʼaa deesseef.<verse eid="1CH 2:24" /></para>
  <para style="s2">Yerahimiʼeel Ilma Hezroon</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25" />Ilmaan Yeramiʼeel ilma Hezroon hangafticha sanaa:</para>
  <para style="li2" vid="1CH 2:25">Raam ilma isaa hangafticha, Buunaah, Ooren, Oozemii fi Ahiiyaa. <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />Yeramiʼeel niitii biraa kan Aaxaaraa jedhamtu qaba ture; isheenis haadha Oonaam turte.<verse eid="1CH 2:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27" />Ilmaan Raam ilma Yeramiʼeel hangafticha sanaa:</para>
  <para style="li2" vid="1CH 2:27">Maʼaaz, Yaamiinii fi Eeqeer.<verse eid="1CH 2:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28" />Ilmaan Oonaam:</para>
  <para style="li2" vid="1CH 2:28">Shamaayii fi Yaadaa.</para>
  <para style="li1" vid="1CH 2:28">Ilmaan Shamaayi:</para>
  <para style="li2" vid="1CH 2:28">Naadaabii fi Abiishur. <verse eid="1CH 2:28" /><verse number="29" style="v" sid="1CH 2:29" />Niitiin Abiishur Abiihaayil jedhamti; isheenis Ahibaanii fi Mooliid isaaf deesse.<verse eid="1CH 2:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30" />Ilmaan Naadaab:</para>
  <para style="li2" vid="1CH 2:30">Seleedii fi Afayiim. Seleed utuu ijoollee hin dhalchin duʼe.<verse eid="1CH 2:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31" />Ilma Afayiim:</para>
  <para style="li2" vid="1CH 2:31">Yisheʼii; Yisheʼiin abbaa Sheeshaan. Sheeshaan immoo abbaa Ahilayi.<verse eid="1CH 2:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32" />Ilmaan Yaadaa kan obboleessa Shamaayi:</para>
  <para style="li2" vid="1CH 2:32">Yeteerii fi Yoonaataan. Yeteer utuu ijoollee hin dhalchin duʼe.<verse eid="1CH 2:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33" />Ilmaan Yoonaataan:</para>
  <para style="li2" vid="1CH 2:33">Pheletii fi Zaazaa.</para>
  <para style="lf" vid="1CH 2:33">Isaan kunneen sanyiiwwan Yeramiʼeel turan.<verse eid="1CH 2:33" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34" />Sheeshaan intallan malee ilmaan hin qabu ture.</para>
  <para style="li2" vid="1CH 2:34">Innis tajaajilaa lammii Gibxi kan Yarihaa jedhamu tokko qaba ture. <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />Sheeshaan tajaajilaa isaa Yarihaatti intala isaa ni heerumsiise; isheenis Ataayin deesseef.<verse eid="1CH 2:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36" />Ataayi abbaa Naataan;</para>
  <para style="li1" vid="1CH 2:36">Naataan immoo abbaa Zaabaadin;<verse eid="1CH 2:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 2:37" />Zaabaad abbaa Eflaal;</para>
  <para style="li1" vid="1CH 2:37">Eflaal immoo abbaa Oobeedi;<verse eid="1CH 2:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 2:38" />Oobeedi abbaa Yehuu;</para>
  <para style="li1" vid="1CH 2:38">Yehuun abbaa Azaariyaa;<verse eid="1CH 2:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 2:39" />Azaariyaa abbaa Heleez;</para>
  <para style="li1" vid="1CH 2:39">Helees immoo abbaa Eleʼaasaa ti;<verse eid="1CH 2:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 2:40" />Eleʼaasaan abbaa Sismaayi;</para>
  <para style="li1" vid="1CH 2:40">Sismaayi abbaa Shaluum;<verse eid="1CH 2:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 2:41" />Shaluum abbaa Yeqameyaa ti;</para>
  <para style="li1" vid="1CH 2:41">Yeqameyaan immoo abbaa Eliishaamaa ti.<verse eid="1CH 2:41" /></para>
  <para style="s2">Gosoota Kilaab</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42" />Ilmaan Kilaab obboleessa Yeramiʼeel:</para>
  <para style="li2" vid="1CH 2:42">Meeshaan ilmi isaa hangaftichi abbaa Ziif; Ziif abbaa Maareeshaa ti;</para>
  <para style="li2" vid="1CH 2:42">Maareeshaan immoo abbaa Kebroon.<verse eid="1CH 2:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43" />Ilmaan Kebroon:</para>
  <para style="li2" vid="1CH 2:43">Qooraahi, Tafuuʼaa, Reqemii fi Shemaa.<verse eid="1CH 2:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 2:44" />Shemaan abbaa Raham;</para>
  <para style="li2" vid="1CH 2:44">Raham immoo abbaa Yorqeʼaam.</para>
  <para style="li1" vid="1CH 2:44">Reqem abbaa Shamaayi.<verse eid="1CH 2:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 2:45" />Shamaayi abbaa Maaʼoon;</para>
  <para style="li2" vid="1CH 2:45">Maaʼoon immoo abbaa Beet Zuuri.<verse eid="1CH 2:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46" />Eefaan saajjatoon Kilaab sun haadha</para>
  <para style="li2" vid="1CH 2:46">Haaraan, Moozaa fi Gaazeez.</para>
  <para style="li2" vid="1CH 2:46">Haaraan immoo abbaa Gaazer.<verse eid="1CH 2:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47" />Ilmaan Yaahidaay:</para>
  <para style="li2" vid="1CH 2:47">Reegeem, Yootaam, Geeshaan, Phelet, Eefaa fi Shaʼaaf.<verse eid="1CH 2:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48" />Maʼakaan saajjatoon Kilaab sun haadha</para>
  <para style="li2" vid="1CH 2:48">Shebeerii fi Tirhaanaa ti.<verse eid="1CH 2:48" /></para>
  <para style="li2">
    <verse number="49" style="v" sid="1CH 2:49" />Isheen akkasumas Shaʼaaf abbaa Madmaanaa,</para>
  <para style="li2" vid="1CH 2:49">Shewwaa abbaa Makbeenaa fi abbaa Gibeʼaa deesse.</para>
  <para style="li1" vid="1CH 2:49">Kilaab intala Aaksaa jedhamtu qaba ture.<verse eid="1CH 2:49" /></para>
  <para style="lf">
    <verse number="50" style="v" sid="1CH 2:50" />Isaan kunneen sanyiiwwan Kilaab turan.</para>
  <para style="b" vid="1CH 2:50" />
  <para style="li1" vid="1CH 2:50">Ilmaan Huuri ilma Efraataa hangaftichaa:</para>
  <para style="li2" vid="1CH 2:50">Sobaal abbaa Kiriyaati Yeʼaariim, <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />Salmaan abbaa Beetlihem, Haareef abbaa Beet Gaadeer.<verse eid="1CH 2:51" /></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52" />Sanyiiwwan Sobaal kan abbaa Kiriyaati Yeʼaariim:</para>
  <para style="li2" vid="1CH 2:52">Walakkaan Menuhootaa, Haarooʼee, <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />akkasumas gosti Kiriyaati Yeʼaariim, Yitraawonni, Fuutonni, Shumaatonni, Mishiraawonni, Zoraatotaa fi Eshitaaʼoloonni gosoota isaan kanneen keessaa dhalatanii dha.<verse eid="1CH 2:53" /></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54" />Sanyiiwwan Salmaan:</para>
  <para style="li2" vid="1CH 2:54">Beetlihem, Netoofota, Atroot Beet Yooʼaab, walakkaa Maanaheetotaa, Zoraatota faʼi; <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />balbala barreessitootaa kanneen Yaabeex keessa jiraatan: Tiraatota, Shimeʼaatotaa fi Sukaatota. Isaan kunneen Qeenota mana abbaa Rekaab Hamaati keessaa dhalatanii dha.<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s2">Ilmaan Daawud</para>
  <para style="r">
    <ref loc="1CH 3:1-4">3:1‑4</ref> kwf – <char style="xt"><ref loc="2SA 3:2-5">2Sm 3:2‑5</ref></char></para>
  <para style="r">
    <ref loc="1CH 3:5-8">3:5‑8</ref> kwf – <char style="xt"><ref loc="2SA 5:14-16">2Sm 5:14‑16</ref>; <ref loc="1CH 14:4-7">1Sn 14:4‑7</ref></char></para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 3:1" />Isaan kunneen ilmaan Daawud Kebroonitti dhalchee dha:</para>
  <para style="b" vid="1CH 3:1" />
  <para style="li1" vid="1CH 3:1">Ilmi isaa hangafni Amnoon kan Ahiinooʼam dubartiin Yizriʼeel deessee dha;</para>
  <para style="li1" vid="1CH 3:1">inni lammaffaan immoo Daaniʼel kan Abiigayiil dubartiin Qarmeloos deessee dha;<verse eid="1CH 3:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 3:2" />sadaffaan Abesaaloom isa Maʼakaan intalli Talmaay mooticha Geshuur deessee dha;</para>
  <para style="li1" vid="1CH 3:2">afuraffaan Adooniyaa ilma Hagiit;<verse eid="1CH 3:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 3:3" />shanaffaan Shefaaxiyaa ilma Abiixaal;</para>
  <para style="li1" vid="1CH 3:3">jaʼaffaan Yitreʼaam kan inni niitii isaa Eglaa irraa dhalchee dha.<verse eid="1CH 3:3" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="4" style="v" sid="1CH 3:4" />Isaan jaʼaan kunneen warra yeroo Daawud Kebroonitti waggaa torbaa fi walakkaa mootii turetti isaaf dhalatanii dha.</para>
  <para style="b" vid="1CH 3:4" />
  <para style="b" vid="1CH 3:4" />
  <para style="lh" vid="1CH 3:4">Daawud Yerusaalemitti waggaa soddomii sadii mootii taʼee bulche; <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />ijoolleen achitti isaaf dhalatanis kanneenii dha:</para>
  <para style="b" vid="1CH 3:5" />
  <para style="li1" vid="1CH 3:5">Shimeʼaa, Shobaab, Naataanii fi Suleyimaan. Ilmaan afran kunneen Batisheebaa intala Amiiʼeel irraa dhalatan.<verse eid="1CH 3:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 3:6" />Akkasumas ilmaan biraa qaba ture; isaanis: Yibehaar, Eliishuuwaa, Eliiphelexi, <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />Noogaa, Nefeg, Yaafiiyaa, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />Eliishaamaa, Eliyaadaa fi Eliiphelexi; isaanis walumatti ilmaan sagal turan.<verse eid="1CH 3:8" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="9" style="v" sid="1CH 3:9" />Ilmaan saajjatoowwan isaa irraa dhalataniin alatti isaan kunneen ilmaan Daawud turan. Taamaar immoo obboleettii isaanii turte.<verse eid="1CH 3:9" /></para>
  <para style="s2">Mootota Yihuudaa</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10" />Ilmi Suleyimaan Rehooboʼaam;</para>
  <para style="li1" vid="1CH 3:10">ilmi Rehooboʼaam Abiyaa dha;</para>
  <para style="li1" vid="1CH 3:10">ilmi Abiyaa Aasaa dha;</para>
  <para style="li1" vid="1CH 3:10">ilmi Aasaa Yehooshaafaax;<verse eid="1CH 3:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 3:11" />ilmi Yehooshaafaax Yehooraam;</para>
  <para style="li1" vid="1CH 3:11">ilmi Yooraam Ahaaziyaa;</para>
  <para style="li1" vid="1CH 3:11">ilmi Ahaaziyaa Yooʼaash;<verse eid="1CH 3:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 3:12" />ilmi Yooʼaash Amasiyaa;</para>
  <para style="li1" vid="1CH 3:12">ilmi Amasiyaa Azaariyaa;</para>
  <para style="li1" vid="1CH 3:12">ilmi Azaariyaa Yootaam;<verse eid="1CH 3:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 3:13" />ilmi Yootaam Aahaaz;</para>
  <para style="li1" vid="1CH 3:13">ilmi Aahaaz Hisqiyaas;</para>
  <para style="li1" vid="1CH 3:13">ilmi Hisqiyaas Minaasee dha;<verse eid="1CH 3:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 3:14" />ilmi Minaasee Aamoon;</para>
  <para style="li1" vid="1CH 3:14">ilmi isaa immoo Yosiyaas.<verse eid="1CH 3:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15" />Ilmaan Yosiyaas:</para>
  <para style="li2" vid="1CH 3:15">Inni hangafni Yoohaanaan,</para>
  <para style="li2" vid="1CH 3:15">lammaffaan Yehooyaaqiim,</para>
  <para style="li2" vid="1CH 3:15">sadaffaan Zedeqiyaa,</para>
  <para style="li2" vid="1CH 3:15">afuraffaan immoo Shaluum.<verse eid="1CH 3:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16" />Ilmaan Yehooyaaqiim:</para>
  <para style="li2" vid="1CH 3:16">Ilma isaa Yehooyaakiinii fi</para>
  <para style="li2" vid="1CH 3:16">ilma isaa Zedeqiyaa.<verse eid="1CH 3:16" /></para>
  <para style="s2">Hidda Dhaloota Moototaa Kan Boojuu booddee ture</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17" />Ilmaan Yehooyaakiin isa boojiʼame sanaa:</para>
  <para style="li2" vid="1CH 3:17">Ilma isaa Sheʼaltiiʼeel, <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />Malkiiraam, Phedaayaa, Shenaaxaar, Yeqameyaa, Hooshaamaa fi Nedaabiyaa.<verse eid="1CH 3:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19" />Ilmaan Phedaayaa:</para>
  <para style="li2" vid="1CH 3:19">Zarubaabelii fi Shimeʼii.</para>
  <para style="li1" vid="1CH 3:19">Ilmaan Zarubaabel:</para>
  <para style="li2" vid="1CH 3:19">Meshulaamii fi Hanaaniyaa. Obboleettiin isaanii immoo Sheloomiit jedhamti. <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />Akkasumas ijoollee gara biraa shanitu ture; isaanis: Hashubaa, Oohel, Berekiyaa, Hasadiyaa fi Yooshab-Heseed.<verse eid="1CH 3:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21" />Ilmaan Hanaaniyaa:</para>
  <para style="li2" vid="1CH 3:21">Phelaatiyaa fi Yeshaayaa; akkasumas ilmaan Refaayaa, ilmaan Arnaan, ilmaan Obaadiyaatii fi ilmaan Shekaaniyaa.<verse eid="1CH 3:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22" />Ilmaan Shekaaniyaa:</para>
  <para style="li2" vid="1CH 3:22">Shemaaʼiyaa fi ilmaan isaa: Haxuush, Yigiʼaal, Baariiyaah, Naʼaariyaa fi Shaafaax; isaan walumatti jaʼa turan.<verse eid="1CH 3:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23" />Ilmaan Naʼaariyaa:</para>
  <para style="li2" vid="1CH 3:23">Eliiyooʼeenayi, Hisqiyaasii fi Azriiqaam; isaan walumatti sadii turan.<verse eid="1CH 3:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24" />Ilmaan Eliiyooʼeenayi:</para>
  <para style="li2" vid="1CH 3:24">Hoodayiwaa, Eliyaashiib, Phelaayaa, Aquub, Yoohaanaan, Delaayaa fi Anaanii; isaan walumatti torba turan.<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s2">Balbalawwan Yihuudaa Kanneen Biraa</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 4:1" />Ilmaan Yihuudaa:</para>
  <para style="li2" vid="1CH 4:1">Faares, Hezroon, Karmii, Huurii fi Sobaal.<verse eid="1CH 4:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2" />Reʼaayaan ilmi Sobaal abbaa Yahaatiiti; Yahaati immoo abbaa Ahuumaayii fi Laahadii ti. Isaan kunneen balbalawwan Zoraatotaa ti.<verse eid="1CH 4:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3" />Ilmaan Eexaam kanneenii dha:</para>
  <para style="li2" vid="1CH 4:3">Yizriʼeel, Yishmaa fi Yidbaashi. Obboleettiin isaanii immoo Hazelelphoonii jedhamti. <verse eid="1CH 4:3" /><verse number="4" style="v" sid="1CH 4:4" />Phenuuʼeel abbaa Gedoor; Eezer immoo abbaa Huushaam.</para>
  <para style="li1" vid="1CH 4:4">Isaan kunneen sanyii Huuri ilma Efraataa hangaftichaatii fi abbaa Beetlihem sanaa ti.<verse eid="1CH 4:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5" />Ashihuur abbaan Teqooʼaa niitota lama kanneen Heelaa fi Naʼaraa jedhaman qaba ture.<verse eid="1CH 4:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6" />Naʼaraan ilmaan Ahuzaam, Heefer, Teemenii fi Haaʼahashitaar jedhaman deesseef. Ilmaan Naʼaraa isaan kanneen turan.<verse eid="1CH 4:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7" />Ilmaan Heelaa:</para>
  <para style="li2" vid="1CH 4:7">Zeret, Zooharii fi Etnaan; <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />Qoosi abbaa Anuub, abbaa Hazobeebaa fi abbaa balbalawwan Ahariheel ilma Haaruumiti.<verse eid="1CH 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9" />Yaabeex nama obboloota isaa caalaa ulfina qabu ture; haatii isaa, “Ani dhiphinaanan isa daʼe” jettee Yaabeex jettee isa moggaafte. <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />Yaabeex immoo akkana jedhee Allaah Israaʼelitti iyyate; “Ati na eebbisi; biyya koos naaf balʼisi! Akka ani hin miidhamnee fi akka ani dhiphina jalaa baʼuuf harki kee na wajjin haa jiraatu.” Allaahanis waan inni duʼaa godhate sana ni kenneef.<verse eid="1CH 4:10" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11" />Kiluub obboleessi Shuhaa abbaa Mihiirii ti; Mehiir immoo abbaa Eshitooniti. <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />Eshitoonis abbaa Beet Raafaan, abbaa Faasehaa fi Tehiinaa ti; Tahiinaan immoo abbaa Iir Naahaashii ti. Isaan kunneen namoota Reekaa ti.<verse eid="1CH 4:12" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13" />Ilmaan Qenaz:</para>
  <para style="li2" vid="1CH 4:13">Onniiʼelii fi Seraayaa.</para>
  <para style="li1" vid="1CH 4:13">Ilmaan Otniiʼeel:</para>
  <para style="li2" vid="1CH 4:13">Hataatii fi Maʼoonotaayi. <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />Meʼoonotaayi abbaa Ofraa ti.</para>
  <para style="li1" vid="1CH 4:14">Seraayaan abbaa Yooʼaabii ti; Yooʼaab immoo abbaa Gee Haraashiimii ti.</para>
  <para style="li2" vid="1CH 4:14">Maqaan kun sababii isaan ogummaa hojii harkaa qabaniif kennameef.<verse eid="1CH 4:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15" />Ilmaan Kilaab ilma Yefunee:</para>
  <para style="li2" vid="1CH 4:15">Iiruu, Eelaa fi Naʼaam.</para>
  <para style="li1" vid="1CH 4:15">Ilmi Eelaa:</para>
  <para style="li2" vid="1CH 4:15">Qenaz.<verse eid="1CH 4:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16" />Ilmaan Yehaleliʼeel:</para>
  <para style="li2" vid="1CH 4:16">Ziifii, Ziifaa, Tiiriyaa fi Asareel.<verse eid="1CH 4:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17" />Ilmaan Izraa:</para>
  <para style="li2" vid="1CH 4:17">Yeteer, Mered, Eeferii fi Yaaloon.</para>
  <para style="li1" vid="1CH 4:17">Niitota Mered keessaa isheen tokko Miiriyaam, Shamaayii fi Yishibaa abbaa Eshtimoʼaa sana deesse. <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />Niitiin isaa dubartiin Yihuudaa sunis Yaared abbaa Gedoor, Hebeer abbaa Sookooniitii fi Yequutiiʼeel abbaa Zaanoʼaa deesse.</para>
  <para style="li1" vid="1CH 4:18">Isaan kunneen ijoollee Bitiyaa intala Faraʼoon kan Mered fuudhe sanaa ti.<verse eid="1CH 4:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19" />Ilmaan niitiin Hoodiyaa obboleettiin Naham sun deesse:</para>
  <para style="li2" vid="1CH 4:19">Abbaa Qeyiilaa namicha Garmii sanaatii fi Eshtimoʼaa namicha Maʼakaa ti.<verse eid="1CH 4:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20" />Ilmaan Simiʼoon:</para>
  <para style="li2" vid="1CH 4:20">Amnoon, Riinaa, Ben-Haanaanii fi Tiiloon.</para>
  <para style="li1" vid="1CH 4:20">Ilmaan Yishiʼii:</para>
  <para style="li2" vid="1CH 4:20">Zoheetii fi Ben-Zoheetii ti.<verse eid="1CH 4:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21" />Ilmaan Sheelaa ilma Yihuudaa:</para>
  <para style="li2" vid="1CH 4:21">Eer abbaa Leekaa, Laʼadaa abbaa Maareeshaatii fi balbalawwan Beet Ashibeeʼaatti warra wayyaa quncee talbaa haphii hojjetanii.<verse eid="1CH 4:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 4:22" />Yooqiim, namoota Koozeebaa, Yooʼaashii fi Saaraaf isa Moʼaabii fi Yaashubiileheem bulchu. Barreeffamni kunneenis kan bara durii ti. <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />Isaanis suphee dhooftuu Nexaayiimii fi Gedeeraa keessa jiraatan turan; jarri kun mootichaaf hojjechaa achi jiraatu ture.<verse eid="1CH 4:23" /></para>
  <para style="s1">Simiʼoon</para>
  <para style="r">
    <ref loc="1CH 4:28-33">4:28‑33</ref> kwf – <char style="xt"><ref loc="JOS 19:2-10">Iya 19:2‑10</ref></char></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24" />Ilmaan Simiʼoon:</para>
  <para style="li2" vid="1CH 4:24">Nemuuʼeel, Yaamiin, Yaariib, Zeraa fi Shaawul;<verse eid="1CH 4:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25" />Shaluum ilma Saaʼuul ture; Mibsaam ilma Shaluumiti; Mishmaa immoo ilma Mabsaamiti.<verse eid="1CH 4:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26" />Ilmaan Mishmaa:</para>
  <para style="li2" vid="1CH 4:26">Ilma isaa Hamuuʼeel, ilma isaa Zakuurii fi ilma isaa Shimeʼii.<verse eid="1CH 4:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27" />Shimeʼiin ilmaan kudha jaʼaa fi intallan jaʼa qaba ture; obboloonni isaa garuu ijoollee hedduu hin qaban ture; sababii kanaaf balbalawwan isaanii hundinuu akka gosa Yihuudaa baayʼee hin turre. <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />Isaanis Bersheebaa, Molaadaa, Hazar Shuuʼaal, <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />Bilihaa, Ezem, Toolaad, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />Betuuʼeel, Hormaa, Siiqlaag, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />Beet Markaabot, Hazar Susiim, Beet Biirii fi Shaʼarayiim keessa jiraatan. Magaalaawwan kunneen hamma bara mootummaa Daawudiitti magaalaawwan isaanii turan. <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />Akkasumas gandoota Eexaam, Ayin, Reemoon, Tookkenii fi Ashaan jechuunis magaalaa shananii fi <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />gandoota naannoo isaaniitti argaman hunda keessa hamma Baʼaaliitti jiraatu ture.</para>
  <para style="b" vid="1CH 4:33" />
  <para style="lh" vid="1CH 4:33">Kunneen iddoo isaan jiraatanii dha. Isaanis galmee hidda dhaloota isaanii kaawwatanii jiran.<verse eid="1CH 4:33" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="34" style="v" sid="1CH 4:34" />Meshoobaab, Yamleek,</para>
  <para style="li1" vid="1CH 4:34">Yooshaa ilma Amasiyaa, <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />Yooʼeel,</para>
  <para style="li1" vid="1CH 4:35">Yehuu ilma Yooshibiyaa, ilma Seraayaa, ilma Asiiʼeel,<verse eid="1CH 4:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 4:36" />akkasumas Eliiyooʼeenayi, Yaaʼiqoobaa, Yashoohayaa,</para>
  <para style="li1" vid="1CH 4:36">Asaayaa, Aadiiʼeel, Yesiimiʼeel, Benaayaa,<verse eid="1CH 4:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 4:37" />Ziizaa ilma Shiifii, ilma Aloon, ilma Yedaayaa, ilma Shimrii, ilma Shemaaʼiyaa.<verse eid="1CH 4:37" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="38" style="v" sid="1CH 4:38" />Namoonni maqaan isaanii kanaa olitti himame kunneen hooggantoota balbala isaanii turan.</para>
  <para style="b" vid="1CH 4:38" />
  <para style="p" vid="1CH 4:38">Baayʼinni maatii isaaniis akka malee dabalaa dhufe; <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />isaanis bushaayee isaaniitiif lafa dheedaa barbaacha hamma moggaa Gedoor kan gama baʼa sululaa jiru sanaatti deeman. <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />Isaanis naannoo sanatti lafa dheedaa gabbataa fi gaarii argatan; lafni sunis balʼaa, kan nagaa fi tasgabbii qabu ture. Bara durii gosoonni Haamii naannoo sana jiraachaa turan.<verse eid="1CH 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41" />Namoonni maqaan isaanii dhaʼame kunneen bara Hisqiyaas mootii Yihuudaa ture keessa dhufan. Isaan akkuma hamma harʼaatti illee mulʼatu qubata Kaamotaatii fi Meʼuunoota achi jiraachaa turanii dhaʼanii guutumaan guutuutti isaan barbadeessan. Ergasiis sababii lafa dheedaa balʼaa bushaayee isaaniitiif argataniif lafa jaraa irra ni qubatan. <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />Simiʼoonota kanneen keessaa namoonni dhibba shan ilmaan Yishiʼii Phelaatiyaa, Naʼaariyaa, Refaayaa fi Uziiʼeel hoogganamanii biyya gaaraa Seeʼiir weeraran. <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />Isaanis Amaaleqoota miliqanii hafan balleessanii hamma harʼaatti achuma jiraatan.<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s1">Ruubeen</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 5:1" />Ruubeen Israaʼeliif ilma hangafa ture; taʼus sababii inni siree abbaa isaa xureesseef mirgi hangafummaa isaa ilmaan Yuusuf ilma Israaʼel sanaatiif kenname. Kanaafuu inni akka mirga isaa kan dhalootaan argamuutti hidda dhalootaa keessatti hin galmeeffamne; <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />Yihuudaan obboloota isaa keessa nama jabaa fi kan mootummaan isa keessaa baʼe taʼu illee mirgi hangafummaa kan Yuusufii ti. <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />Ilmaan Ruubeen ilma Israaʼel hangaftichaa:</para>
  <para style="b" vid="1CH 5:3" />
  <para style="li2" vid="1CH 5:3">Henooki, Faluusoo, Hezroonii fi Karmii.<verse eid="1CH 5:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4" />Ilmaan Yooʼeel:</para>
  <para style="li2" vid="1CH 5:4">Shemaaʼiyaa ilma isaa, Googi ilma isaa,</para>
  <para style="li2" vid="1CH 5:4">Shimeʼii ilma isaa, <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />Miikaa ilma isaa,</para>
  <para style="li2" vid="1CH 5:5">Reʼaayaa ilma isaa, Baʼaal ilma isaatii fi<verse eid="1CH 5:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 5:6" />Biʼeeraa ilma isaa kan mootiin Asoor Tiiglaat-Philneeser boojiʼee fudhatee dha. Beʼeeraan hoogganaa gosa Ruubeen ture.<verse eid="1CH 5:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7" />Firoonni isaanii warri akkuma hidda dhaloota isaaniitti balbala balbalaan galmeeffaman kanneenii dha:</para>
  <para style="li2" vid="1CH 5:7">Yeʼiiʼeel hangafticha, Zakariyaa, <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />Beelaa ilma Aazaazi, ilma Shemaa, ilma Yooʼeel.</para>
  <para style="b" vid="1CH 5:8" />
  <para style="p" vid="1CH 5:8">Isaanis naannoo Aroʼeeri jalqabee hamma Neboo fi Baʼaal Meʼooniitti jiru keessa qubatan. <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />Isaanis sababii horiin isaanii Giliʼaadi keessatti baayʼateef karaa baʼa biiftuutiin hamma daarii gammoojjii kan gara laga Efraaxiisitti balʼatu sanaatti biyyattii qabatan.<verse eid="1CH 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 5:10" />Isaan jabana Saaʼol keessa Haagariitti waraana kaasan; jarris harka isaaniitti moʼataman; isaanis iddoo jireenyaa warra Haagari kan Giliʼaadiin gama baʼa biiftuu jiru guutumaan guutuutti qabatan.<verse eid="1CH 5:10" /></para>
  <para style="s1">Gaad</para>
  <para style="lh">
    <verse number="11" style="v" sid="1CH 5:11" />Gosoonni Gaad isaanitti aananii Baashaan keessa lafa hamma Salkaatti argamu irra jiraatan; isaanis:<verse eid="1CH 5:11" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="12" style="v" sid="1CH 5:12" />Yooʼeel hangaftichi, Shaafaam itti aanaan isaa, Yaʼinayii fi Shaafaax Baashaan keessa jiraatan.<verse eid="1CH 5:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13" />Firoonni isaanii maatii maatiidhaan kanneenii dha:</para>
  <para style="li2" vid="1CH 5:13">Miikaaʼiil, Meshulaam, Shebaa, Yooraay, Yaakaan, Ziiʼaa fi Eeber; walumaa galatti torba turan.<verse eid="1CH 5:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14" />Isaan kunneen immoo ilmaan Abiihaayil ilma Huuri, ilma Yaarokaa, ilma Giliʼaad, ilma Miikaaʼiil, ilma Yeshiishaayi, ilma Yakedoo, ilma Buuzii ti.<verse eid="1CH 5:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15" />Ahiin ilmi Abdiʼeel, hangafa maatii isaanii ture; Abdiʼeel immoo ilma Guunii ti.<verse eid="1CH 5:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="1CH 5:16" />Warri Gaad Giliʼaad keessa, Baashaanii fi gandoota daarii isheetti argaman, akkasumas lafa tikaa kan Shaaroon keessatti argaman hundaa fi qarqara isaa jiraatan.<verse eid="1CH 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17" />Isaan kunneen hundi jabana Yootaam mootii Yihuudaa turee fi jabana Yerobiʼaam mootii Israaʼel ture keessa galmee hidda dhalootaa keessatti galmeeffaman.<verse eid="1CH 5:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />Ruubeenonni, Gaadonnii fi walakkaan gosa Minaasee namoota dandeettii lolaa qaban 44,760 qaban ture; isaanis namoota jajjaboo warra gaachanaa fi goraadee qabachuu dandaʼan, warra xiyya darbachuu dandaʼanii fi warra waraanaaf leenjifaman turan. <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />Jarri kunis warra Haagariitti, warra Yexuuritti, Naafiishiittii fi Noodaabiitti waraana ni banan. <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />Sababii isaan waraana sana irratti gara Allaahatti iyyatanii turaniif Allaahan isaan gargaaree warra Haagariitii fi garee isaanii hunda dabarsee harka isaaniitti kenne. Innis sababii isaan isa amanataniif duʼaa isaaniitiif deebii kenne. <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />Isaanis horii warra Haagari gaala kuma shan, hoolaa kuma dhibba lamaa fi shantamaa fi harree kuma lama saaman. Akkasumas nama kuma dhibba tokkoo boojiʼan; <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />sababii lolli sun kan Allaaha tureef namoonni biraa baayʼeen ni ajjeefaman. Isaanis hamma bara boojuutti biyya sana keessa ni jiraatan.<verse eid="1CH 5:22" /></para>
  <para style="s1">Walakkaa Gosa Minaasee</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />Walakkaan gosa Minaasee baayʼee turan; isaanis Baashaanii jalqabanii hamma Baʼaal Hermooniitti, hamma Seniir Tulluu Hermoonitti biyya sana keessa qubatan.<verse eid="1CH 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 5:24" />Isaan kunneen hangafoota maatii isaanii ti: Eefer, Yishiʼii, Eliiʼeel, Azriiʼeel, Ermiyaas, Hoodayiwaa fi Yadiiʼeel. Isaan kunneen loltoota gootota, namoota bebbeekamoo fi hangafoota maatii isaanii ti. <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" />Isaan garuu Allaah abbootii isaaniitiif amanamuu didanii waaqeffatamtoota saboota biyyattii wajjin sagaagalan; saboonni kunneenis warra Allaahan fuula isaanii duraa balleessee dha. <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />Kanaafuu Allaahan Israaʼel hafuura Fohaa mooticha Asoor jechuunis hafuura Phuuli kakaasee akka inni gosoota Ruubeen, kan Gaadiitii fi walakkaa gosa Minaasee boojiʼu godhe. Innis warra kanneen gara Halaa, Haaboor, Haaraatii fi gara qarqara laga Goozaaniitti geesse; isaanis hamma harʼaatti achuma jiraatan.<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s1">Lewwii</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 6:1" />Ilmaan Lewwii:</para>
  <para style="li2" vid="1CH 6:1">Geershoon, Qohaatii fi Meraar.<verse eid="1CH 6:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2" />Ilmaan Qohaati:</para>
  <para style="li2" vid="1CH 6:2">Amraam, Yizihaar, Kebroonii fi Uziiʼeel.<verse eid="1CH 6:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3" />Ijoolleen Amraam:</para>
  <para style="li2" vid="1CH 6:3">Haaruun, Muusaa fi Miiriyaam.</para>
  <para style="li1" vid="1CH 6:3">Ilmaan Haaruun:</para>
  <para style="li2" vid="1CH 6:3">Naadaab, Abiihuu, Eleʼaazaarii fi Iitaamaar.<verse eid="1CH 6:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4" />Eleʼaazaar abbaa Fiinehaas;</para>
  <para style="li2" vid="1CH 6:4">Fiinehaas immoo abbaa Abiishuuwaa ti;<verse eid="1CH 6:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5" />Abiishuuwaan abbaa Buukii ti;</para>
  <para style="li2" vid="1CH 6:5">Bukiin immoo abbaa Uzii ti;<verse eid="1CH 6:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6" />Uzii abbaa Zeraayaa ti;</para>
  <para style="li2" vid="1CH 6:6">Zaraaʼiyaan abbaa Meraayootii ti;<verse eid="1CH 6:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7" />Meraayoot abbaa Amariyaa ti;</para>
  <para style="li2" vid="1CH 6:7">Amariyaan abbaa Ahiixuubii ti;<verse eid="1CH 6:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8" />Ahiixuub abbaa Zaadoqii ti;</para>
  <para style="li2" vid="1CH 6:8">Zaadoq abbaa Ahiimaʼazii ti;<verse eid="1CH 6:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9" />Ahiimaʼaz abbaa Azaariyaa ti;</para>
  <para style="li2" vid="1CH 6:9">Azaariyaa abbaa Yoohaanaanii ti;<verse eid="1CH 6:9" /></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10" />Yoohaanaan abbaa Azaariyaa ti;</para>
  <para style="li2" vid="1CH 6:10">inni luba taʼee mana qulqullummaa kan Suleyimaan Yerusaalemitti ijaare keessa tajaajilaa ture.<verse eid="1CH 6:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11" />Azaariyaa abbaa Amariyaa ti;</para>
  <para style="li2" vid="1CH 6:11">Amariyaan abbaa Ahiixuubii ti;<verse eid="1CH 6:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12" />Ahiixuub abbaa Zaadoqii ti;</para>
  <para style="li2" vid="1CH 6:12">Zaadoq abbaa Shaluumii ti;<verse eid="1CH 6:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13" />Shaluum abbaa Hilqiyaa ti;</para>
  <para style="li2" vid="1CH 6:13">Hilqiyaa abbaa Azaariyaa ti;<verse eid="1CH 6:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14" />Azaariyaa abbaa Seraayaa ti;</para>
  <para style="li2" vid="1CH 6:14">Seraayaan abbaa Yehoozaadaaqii ti.<verse eid="1CH 6:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 6:15" />Yeroo Rabbii Allaahan akka sabni Yihuudaatii fi Yerusaalem Nebukadnezariin boojiʼamu godhetti Yehoozaadaaqis boojiʼamee fudhatame.<verse eid="1CH 6:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16" />Ilmaan Lewwii:</para>
  <para style="li2" vid="1CH 6:16">Geershoom, Qohaatii fi Meraarii.<verse eid="1CH 6:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17" />Maqaan Ilmaan Geershoom kanaa dha:</para>
  <para style="li2" vid="1CH 6:17">Loobeenii fi Shimeʼii.<verse eid="1CH 6:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18" />Ilmaan Qohaati:</para>
  <para style="li2" vid="1CH 6:18">Amraam, Yizihaar, Kebroonii fi Uziiʼeel.<verse eid="1CH 6:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19" />Ilmaan Meraarii:</para>
  <para style="li2" vid="1CH 6:19">Mahilii fi Muusii.</para>
  <para style="b" vid="1CH 6:19" />
  <para style="lh" vid="1CH 6:19">Isaan kunneen Lewwota balbala balbala abbootii isaaniitiin lakkaaʼamanii dha:<verse eid="1CH 6:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20" />Balbala Geershoom keessaa:</para>
  <para style="li2" vid="1CH 6:20">Ilma isaa Loobeen, ilma isaa Yahaati,</para>
  <para style="li2" vid="1CH 6:20">ilma isaa Zimaati, <verse eid="1CH 6:20" /><verse number="21" style="v" sid="1CH 6:21" />ilma isaa Yooʼaa,</para>
  <para style="li2" vid="1CH 6:21">ilma isaa Iddoo, ilma isaa Zeraa fi</para>
  <para style="li2" vid="1CH 6:21">ilma isaa Yeʼaateraayi.<verse eid="1CH 6:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22" />Ilmaan Qohaati:</para>
  <para style="li2" vid="1CH 6:22">Ilma isaa Amiinaadaab, ilma isaa Qooraahi,</para>
  <para style="li2" vid="1CH 6:22">ilma isaa Asiir, <verse eid="1CH 6:22" /><verse number="23" style="v" sid="1CH 6:23" />ilma isaa Elqaanaa,</para>
  <para style="li2" vid="1CH 6:23">ilma isaa Ebiyaasaaf, ilma isaa Asiir,<verse eid="1CH 6:23" /></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24" />ilma isaa Tahaat, ilma isaa Uuriiʼeel,</para>
  <para style="li2" vid="1CH 6:24">ilma isaa Uziyaa fi ilma isaa Shaawul.<verse eid="1CH 6:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25" />Ilmaan Elqaanaa:</para>
  <para style="li2" vid="1CH 6:25">Amaasaayi, Ahiimooti,<verse eid="1CH 6:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 6:26" />ilma isaa Elqaanaa, ilma isaa Zoofayi,</para>
  <para style="li2" vid="1CH 6:26">ilma isaa Naahat, <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" />ilma isaa Eliiyaab,</para>
  <para style="li2" vid="1CH 6:27">ilma isaa Yeroohaam, ilma isaa Elqaanaa fi</para>
  <para style="li2" vid="1CH 6:27">ilma isaa Saamuʼeel.<verse eid="1CH 6:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28" />Ilmaan Saamuʼeel:</para>
  <para style="li2" vid="1CH 6:28">Ilma isaa Yooʼeel hangaftichaa fi</para>
  <para style="li2" vid="1CH 6:28">ilma isaa lammaffaa Abiyaa.<verse eid="1CH 6:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29" />Ilmaan Meraarii:</para>
  <para style="li2" vid="1CH 6:29">Mahilii, ilma isaa Loobeen,</para>
  <para style="li2" vid="1CH 6:29">ilma isaa Shimeʼii, ilma isaa Uzaa,<verse eid="1CH 6:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 6:30" />ilma isaa Shimeʼaa, ilma isaa Hagiyaa fi</para>
  <para style="li2" vid="1CH 6:30">ilma isaa Asaayaa.<verse eid="1CH 6:30" /></para>
  <para style="s2">Faarfattoota Mana Qulqullummaa</para>
  <para style="r">
    <ref loc="1CH 6:54-80">6:54‑80</ref> kwf – <char style="xt"><ref loc="JOS 21:4-39">Iya 21:4‑39</ref></char></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />Namoonni erga taabonni dhufee achi boqotee booddee Daawud akka isaan faarfannaadhaan mana Rabbii Allaah keessa tajaajilaniif muude kanneenii dha. <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />Isaanis hamma Suleyimaan Yerusaalem keessatti mana qulqullummaa Rabbii Allaah ijaaretti dunkaana qulqulluu, dunkaana wal gaʼii duratti faarfannaadhaan tajaajilaa turan. Isaanis akkuma seera isaaniif kenname sanaatti hojii isaanii hojjechaa turan.<verse eid="1CH 6:32" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="33" style="v" sid="1CH 6:33" />Maqaan namoota ilmaan isaanii wajjin tajaajilanii kanneenii dha:</para>
  <para style="b" vid="1CH 6:33" />
  <para style="li1" vid="1CH 6:33">Ilmaan Qohaatotaa keessaa:</para>
  <para style="li2" vid="1CH 6:33">Heemaan Faarfataa,</para>
  <para style="li2" vid="1CH 6:33">ilma Yooʼeel, ilma Saamuʼeel,<verse eid="1CH 6:33" /></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34" />ilma Elqaanaa, ilma Yeroohaam,</para>
  <para style="li2" vid="1CH 6:34">ilma Eliiʼeel, ilma Tooʼaa,<verse eid="1CH 6:34" /></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 6:35" />ilma Zuufi, ilma Elqaanaa,</para>
  <para style="li2" vid="1CH 6:35">ilma Mahat, ilma Amaasaayi,<verse eid="1CH 6:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36" />ilma Elqaanaa, ilma Yooʼeel,</para>
  <para style="li2" vid="1CH 6:36">ilma Azaariyaa, ilma Sefaaniyaa,<verse eid="1CH 6:36" /></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 6:37" />ilma Tahaat, ilma Asiir,</para>
  <para style="li2" vid="1CH 6:37">ilma Ebiyaasaaf, ilma Qooraahi,<verse eid="1CH 6:37" /></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 6:38" />ilma Yizihaar, ilma Qohaati,</para>
  <para style="li2" vid="1CH 6:38">ilma Lewwii, ilma Israaʼel;<verse eid="1CH 6:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39" />akkasumas Asaaf obboleessi Heemaan karaa mirgaatiin dhaabata ture:</para>
  <para style="li2" vid="1CH 6:39">Asaaf ilma Berekiyaa, ilma Shimeʼaa,<verse eid="1CH 6:39" /></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40" />ilma Miikaaʼiil, ilma Baʼaseeyaa,</para>
  <para style="li2" vid="1CH 6:40">ilma Malkiyaa, <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />ilma Etnii,</para>
  <para style="li2" vid="1CH 6:41">ilma Zeraa, ilma Adaayaa,<verse eid="1CH 6:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42" />ilma Eetaan, ilma Zimaa,</para>
  <para style="li2" vid="1CH 6:42">ilma Shimeʼii, <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />ilma Yahaati,</para>
  <para style="li2" vid="1CH 6:43">ilma Geershoom, ilma Lewwii;<verse eid="1CH 6:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44" />karaa bitaa isaatiin immoo warri isaan wajjin turan gosa Meraarii keessaa:</para>
  <para style="li2" vid="1CH 6:44">Eetaan ilma Qiisaa, ilma Abdii,</para>
  <para style="li2" vid="1CH 6:44">ilma Maluuk, <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />ilma Hashabiyaa,</para>
  <para style="li2" vid="1CH 6:45">ilma Amasiyaa, ilma Hilqiyaa,<verse eid="1CH 6:45" /></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 6:46" />ilma Amzii, ilma Baanii,</para>
  <para style="li2" vid="1CH 6:46">ilma Shemeer, <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />ilma Mahilii,</para>
  <para style="li2" vid="1CH 6:47">ilma Muusii, ilma Meraarii,</para>
  <para style="li2" vid="1CH 6:47">ilma Lewwii.<verse eid="1CH 6:47" /></para>
  <para style="b" />
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />Obboloonni isaanii Lewwonni akka hojii dunkaana qulqulluu mana Allaaha hunda hojjetaniif ramadamanii turan. <verse eid="1CH 6:48" /><verse number="49" style="v" sid="1CH 6:49" />Haaruunii fi ilmaan isaa garuu akkuma waan Muusaan garbichi Allaaha sun ajajee ture hundaatti hojii Iddoo Iddoo Hunda Caalaa Qulqulluu taʼe sanaatiif, sababii Israaʼeliitiifis araara buusuudhaaf iddoo aarsaa kan aarsaa gubamuutii fi iddoo aarsaa ixaanaa irratti aarsaawwan dhiʼeessaa turan.<verse eid="1CH 6:49" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50" />Ilmaan Haaruun kanneenii dha:</para>
  <para style="li2" vid="1CH 6:50">Ilma isaa Eleʼaazaar, ilma isaa Fiinehaas,</para>
  <para style="li2" vid="1CH 6:50">ilma isaa Abiishuuwaa, <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />ilma isaa Bukii,</para>
  <para style="li2" vid="1CH 6:51">ilma isaa Uzii, ilma isaa Zeraayaa,<verse eid="1CH 6:51" /></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52" />ilma isaa Meraayoot, ilma isaa Amariyaa,</para>
  <para style="li2" vid="1CH 6:52">ilma isaa Ahiixuub, <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />ilma isaa Zaadoqii fi</para>
  <para style="li2" vid="1CH 6:53">ilma isaa Ahiimaʼaz.<verse eid="1CH 6:53" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="54" style="v" sid="1CH 6:54" />Sababii ixaan jalqabaa isaaniif baʼeef iddoowwan kunneen Haaruunii fi ilmaan isaa kanneen balbala Qohaati keessaa dhufaniif ni kennaman; iddoowwan qubata isaanii kanneen akka biyya isaanii taʼaniif isaaniif ramadamanii dha:<verse eid="1CH 6:54" /></para>
  <para style="li1">
    <verse number="55" style="v" sid="1CH 6:55" />Kebroon isheen biyya Yihuudaa keessaatii fi lafti dheedaa kan naannoo isheetti argamtu isaaniif ni kennaman. <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />Lafti qotiisaatii fi gandoonni naannoo Kebrooniitti argaman garuu Kilaab ilma Yefuneetiif ni kennaman. <verse eid="1CH 6:56" /><verse number="57" style="v" sid="1CH 6:57" />Ilmaan Haaruuniif immoo magaalaawwan itti baqatan Kebroon, Libnaa, Yatiir, Eshtimoʼaa, <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />Hiileen, Debiir, <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />Ashaan, Yootaa fi Beet Shemeshitu lafa dheeda isaanii wajjin kenname.<verse eid="1CH 6:59" /></para>
  <para style="li1">
    <verse number="60" style="v" sid="1CH 6:60" />Qooda gosa Biniyaam keessaa immoo Gibeʼoon, Gebaa, Alemetii fi Anaatootittu lafa dheeda isaanii wajjin ni kennameef.</para>
  <para style="lf" vid="1CH 6:60">Magaalaawwan balbalawwan Qohaatotaatiif kennaman kunneen walumaa galatti kudha sadii turan.<verse eid="1CH 6:60" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="61" style="v" sid="1CH 6:61" />Ilmaan Qohaati kanneen hafaniif immoo balbala walakkaa gosa Minaasee irraa magaalaawwan kudhanitu ixaadhaan kennameef.<verse eid="1CH 6:61" /></para>
  <para style="li1">
    <verse number="62" style="v" sid="1CH 6:62" />Ilmaan Geershoomiitiif immoo qooda Yisaakor irraa, qooda Aasheer irraa, qooda Niftaalemiitii fi qooda Minaasee kan Baashaanitti argamu irraa magaalaawwan kudha sadii akkuma gosa gosa isaaniitti kennaman.<verse eid="1CH 6:62" /></para>
  <para style="li1">
    <verse number="63" style="v" sid="1CH 6:63" />Ilmaan Meraariitiif qooda gosa Ruubeen irraa, qooda gosa Gaadiitii fi qooda gosa Zebuuloon irraa magaalaawwan kudha lama akkuma balbala balbala isaaniitti ni kennaman.<verse eid="1CH 6:63" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="64" style="v" sid="1CH 6:64" />Akkasiin Israaʼeloonni magaalaawwan kanneen lafa dheeda isaanii wajjin Lewwotaaf ni kennan.<verse eid="1CH 6:64" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="65" style="v" sid="1CH 6:65" />Gosa Yihuudaa irraa, gosa Simiʼooniitii fi gosa Biniyaam irraa magaalaawwan maqaan isaanii armaan olitti dhaʼame sana ixaadhaan ni kennaniif.<verse eid="1CH 6:65" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="66" style="v" sid="1CH 6:66" />Maatiiwwan Qohaati tokko tokkos qooda gosa Efreem keessaa magaalaawwan jireenyaa argatanii turan.<verse eid="1CH 6:66" /></para>
  <para style="li1">
    <verse number="67" style="v" sid="1CH 6:67" />Biyya gaaraa Efreem keessatti magaalaawwan itti baqatan Sheekem, Geezir, <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />Yoqemiʼaam, Beet Horoon, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />Ayaaloonii fi Gat Rimoon lafa dheeda isaanii wajjin kennaniif.<verse eid="1CH 6:69" /></para>
  <para style="li1">
    <verse number="70" style="v" sid="1CH 6:70" />Akkasumas Israaʼeloonni walakkaa qooda gosa Minaasee irraa Aanerii fi Bileʼaam lafa dheeda isaanii wajjin balbalawwan Qohaati kanneen hafaniif ni kennan.<verse eid="1CH 6:70" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="71" style="v" sid="1CH 6:71" />Ilmaan Geershoom immoo:</para>
  <para style="li1" vid="1CH 6:71">Balbala walakkaa gosa Minaasee irraa Goolaan ishee Baashaan keessaa sanaa fi Ashtaaroti lafa dheeda isaanii wajjin ni argatan;<verse eid="1CH 6:71" /></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72" />gosa Yisaakor irraa</para>
  <para style="li2" vid="1CH 6:72">Qaadesh, Daaberaati, <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />Raamootii fi Aanem lafa dheeda isaanii wajjin ni argatan;<verse eid="1CH 6:73" /></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74" />gosa Aasheer irraa Maashaal, Abdoon, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />Huuqooqii fi Rehoob lafa dheeda isaanii wajjin ni argatan;<verse eid="1CH 6:75" /></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76" />gosa Niftaalem irraa immoo Qaadesh ishee Galiilaatti argamtu, Hamoonii fi Kiriyaataayimin lafa dheeda isaanii wajjin ni argatan.<verse eid="1CH 6:76" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="77" style="v" sid="1CH 6:77" />Namoonni gosa Meraarii jechuunis warri Lewwotaa kanneen hafan qooda kanaa gadii argatan:</para>
  <para style="li1" vid="1CH 6:77">Gosa Zebuuloon irraa Yooqniʼaam, Qartaa, Rimoonii fi Taaboorin lafa dheeda isaanii wajjin argatan;<verse eid="1CH 6:77" /></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78" />gosa Ruubeen kan baʼa Yerikootti Yordaanosiin gama jiru irraa Bezer ishee gammoojjii keessatti argamtu, Yaahizaa, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />Qidemootii fi Meefiʼaati lafa dheeda isaanii wajjin ni argatan.<verse eid="1CH 6:79" /></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80" />Gosa Gaad irraa Raamooti ishee Giliʼaad keessaa, Mahanayiim, <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />Heshboonii fi Yaʼizeer lafa dheeda isaanii wajjin ni argatan.<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s1">Yisaakor</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 7:1" />Ilmaan Yisaakor:</para>
  <para style="li2" vid="1CH 7:1">Toolaa, Phuwaa, Yaashuubii fi Shimroon; walumatti nama afur turan.<verse eid="1CH 7:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2" />Ilmaan Toolaa:</para>
  <para style="li2" vid="1CH 7:2">Uzii, Refaayaa, Yiriiʼeel, Yaahimaayi, Yibsaamii fi Shemuuʼeel; isaan kunneen hangafoota maatii isaanii ti. Bara mootummaa Daawud keessa ilmaan Toolaa warri hidda dhaloota isaaniitiin akka loltoota jajjabootti galmeeffaman nama 22,600 turan.<verse eid="1CH 7:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3" />Ilma Uzii:</para>
  <para style="li2" vid="1CH 7:3">Yizrahiyaa.</para>
  <para style="li1" vid="1CH 7:3">Ilmaan Yizrahiyaa:</para>
  <para style="li2" vid="1CH 7:3">Miikaaʼiil, Obaadiyaa, Yooʼeelii fi Yishiyaa. Shanan isaanii iyyuu hangafoota turan. <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />Isaanis waan niitotaa fi ijoollee hedduu qabaataniif akka hidda dhaloota maatii isaaniitti namoota lolaaf qophaaʼan 36,000 qabu ture.<verse eid="1CH 7:4" /></para>
  <para style="lf">
    <verse number="5" style="v" sid="1CH 7:5" />Firoonni loltoota jajjaboo turan kanneen balbalawwan Yisaakorii keessaa dhalatan warri akkuma hidda dhaloota isaaniitti galmeeffaman walumatti nama 87,000:<verse eid="1CH 7:5" /></para>
  <para style="s1">Biniyaam</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6" />Ilmaan Biniyaam sadan:</para>
  <para style="li2" vid="1CH 7:6">Belaa, Bekerii fi Yediiʼeel.<verse eid="1CH 7:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7" />Ilmaan Belaa:</para>
  <para style="li2" vid="1CH 7:7">Esboon, Uzii, Uziiʼeel, Yeriimootii fi Iirii walumatti shan turan; hangafoonni mana abbootii isaaniis gootota jajjaboo turan; galmeen hidda dhaloota isaanii namoota 22,034 argisiisa.<verse eid="1CH 7:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8" />Ilmaan Beker:</para>
  <para style="li2" vid="1CH 7:8">Zemiiraa, Yooʼaash, Eliiʼezer, Eliiyooʼeenayi, Omrii, Yereemooti, Abiyaa, Anaatootii fi Alaameti. Isaan kunneen hundi ilmaan Beker turan. <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />Hangafoota mana abbootii isaanii kanneen akka dhaloota isaaniitti hidda dhaloota isaaniitiin lakkaaʼaman gootota jajjaboo 20,200 turan.<verse eid="1CH 7:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10" />Ilmi Yediiʼeel:</para>
  <para style="li2" vid="1CH 7:10">Bilihaan.</para>
  <para style="li1" vid="1CH 7:10">Ilmaan Bilhaanii:</para>
  <para style="li2" vid="1CH 7:10">Yeʼuushi, Biniyaam, Eehuud, Keniʼaanaa, Zeetaan, Tarshiishii fi Ahiishahar. <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />Ilmaan Yediiʼeel kunneen hundi hangafoota maatiiwwanii turan. Isaanis namoota waraana dhaquuf qophaaʼan 17,200 qaban ture.<verse eid="1CH 7:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12" />Gosti Shufiimiitii fi Hufiim ilmaan Iiri turan; Hushiim immoo ilma Aheerii ti.<verse eid="1CH 7:12" /></para>
  <para style="s1">Niftaalem</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13" />Ilmaan Niftaalemii:</para>
  <para style="li2" vid="1CH 7:13">Yahiziiʼeel, Guunii, Yeexerii fi Shaluum; isaan kunneen sanyii Bilihaa ti.<verse eid="1CH 7:13" /></para>
  <para style="s1">Minaasee</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14" />Ilmaan Minaasee:</para>
  <para style="li2" vid="1CH 7:14">Asriiʼeel kan saajjatoon isaa isheen Arraamii dhufte sun deesseef. Isheenis Maakiir abbaa Giliʼaad deesse. <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />Maakiir immoo gosoota Hufiimiitii fi Shufiim keessaa niitii fuudhe. Maqaan obboleettii isaas Maʼakaa ture. Sanyiin isaa kan biraa immoo Salphaʼaad jedhama; Zelofehaad intallan qofa qaba ture. <verse eid="1CH 7:15" /><verse number="16" style="v" sid="1CH 7:16" />Maʼakaan niitiin Maakiirii ilma deessee maqaa isaa Phereesh jettee moggaafte. Obboleessi isaa Sheresh jedhama; ilmaan isaa immoo Uulaamii fi Reqem jedhaman.<verse eid="1CH 7:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17" />Ilmi Uulaam:</para>
  <para style="li2" vid="1CH 7:17">Bedaan.</para>
  <para style="li1" vid="1CH 7:17">Isaan kunneen ilmaan Giliʼaadii ilma Maakiirii, ilma Minaasee sanaa ti.<verse eid="1CH 7:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 7:18" />Hamolekeeti obboleettiin isaa Iisihood, Abiiʼezerii fi Mahilaa deesse.<verse eid="1CH 7:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19" />Ilmaan Shemiidaa immoo:</para>
  <para style="li2" vid="1CH 7:19">Ahiiyaan, Sheekem, Likihii fi Aniyaam turan.<verse eid="1CH 7:19" /></para>
  <para style="s1">Efreem</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20" />Ilmaan Efreem:</para>
  <para style="li2" vid="1CH 7:20">Shuutelaa, ilma isaa Bereed,</para>
  <para style="li2" vid="1CH 7:20">ilma isaa Tahaat,</para>
  <para style="li2" vid="1CH 7:20">ilma isaa Eleʼaadaa, ilma isaa Tahaat, <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />ilma isaa Zaabaadii,</para>
  <para style="li2" vid="1CH 7:21">ilma isaa Shuutelaa.</para>
  <para style="li2" vid="1CH 7:21">Eezerii fi Eliʼaad yeroo loon warra Gaati kanneen achi jiraatan sanaa boojiʼuuf gad buʼanitti harka jaraatiin ni ajjeefaman. <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />Efreem abbaan isaanii guyyaa hedduu booʼeef; firoonni isaas isa jajjabeessuu dhufan. <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />Sana booddees dhaqee niitii isaa wajjin ciise; isheenis ulfooftee ilma deesse. Innis sababii maatii isaa keessa rakkinni tureef Beriiyaa jedhee maqaa baaseef. <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />Intalli isaa immoo Sheeraa jedhamti; namni magaalaawwan Beet Horoonii kan gad aanuu fi kan ol aanu, akkasumas magaalaa Uzeen Sheeraa hundeesse ishee dha.<verse eid="1CH 7:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 7:25" />Refaa ilma isaa, Resheef ilma isaa,</para>
  <para style="li2" vid="1CH 7:25">Teelaa ilma isaa, Taahan ilma isaa,<verse eid="1CH 7:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 7:26" />Laʼadaan ilma isaa, Amiihuud ilma isaa,</para>
  <para style="li2" vid="1CH 7:26">Eliishaamaa ilma isaa, <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />Nuuni ilma isaatii fi</para>
  <para style="li2" vid="1CH 7:27">Yushuʼaa ilma isaa.<verse eid="1CH 7:27" /></para>
  <para style="lf">
    <verse number="28" style="v" sid="1CH 7:28" />Biyyoonnii fi ardaan qubata isaaniis Beetʼeelii fi gandoota naannoo ishee, karaa baʼa biiftuutiin Naʼaraan, karaa lixa biiftuutiin immoo Geezirii fi gandoota ishee akkasumas Sheekemii fi gandoota ishee kanneen hamma Ayyaa fi gandoota isheetti jiran qabata ture. <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />Daariiwwan Minaasee irra Beet Sheʼaan, Taʼanaak, Megidoo fi Dooritu gandoota isaanii wajjin ture. Sanyiiwwan Yuusuf ilma Israaʼel sanaas magaalaawwan kanneen keessa jiraatan.<verse eid="1CH 7:29" /></para>
  <para style="s1">Aseer</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30" />Ilmaan Aasheer:</para>
  <para style="li2" vid="1CH 7:30">Yimnaa, Yishwaa, Yishwii fi Beriiyaa. Obboleettiin isaanii immoo Seraa jedhamti.<verse eid="1CH 7:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31" />Ilmaan Beriiyaa:</para>
  <para style="li2" vid="1CH 7:31">Hebeerii fi Malkiiʼeel abbaa Birzaawitii.<verse eid="1CH 7:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32" />Hebeer immoo abbaa Yaafleexii, Shomeerii, Hootaamiitii fi obboleettii isaanii Shuuʼaa ti.<verse eid="1CH 7:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33" />Ilmaan Yaafleex:</para>
  <para style="li2" vid="1CH 7:33">Phaasaak, Biimihaalii fi Ashwaati.</para>
  <para style="lf" vid="1CH 7:33">Isaan kunneen ilmaan Yaafleexii ti.<verse eid="1CH 7:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34" />Ilmaan Shemeer:</para>
  <para style="li2" vid="1CH 7:34">Ahii, Rohigaa, Yehubaa fi Arraam.<verse eid="1CH 7:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35" />Ilmaan obboleessa isaa Heelem:</para>
  <para style="li2" vid="1CH 7:35">Zoofaa, Yimnaa, Sheleeshii fi Aamaal.<verse eid="1CH 7:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36" />Ilmaan Zoofaa:</para>
  <para style="li2" vid="1CH 7:36">Suuwaa, Harnefer, Shuuʼaali, Beerii, Yimraa, <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />Bezer, Hoodi, Shamaa, Shilshaa, Yitraanii fi Biʼeeraa.<verse eid="1CH 7:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38" />Ilmaan Yeteer:</para>
  <para style="li2" vid="1CH 7:38">Yefunee, Fiisiphaa fi Eraa.<verse eid="1CH 7:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39" />Ilmaan Ulaa:</para>
  <para style="li2" vid="1CH 7:39">Aaraa, Haniiʼeelii fi Riiziyaa.<verse eid="1CH 7:39" /></para>
  <para style="lf">
    <verse number="40" style="v" sid="1CH 7:40" />Isaan kunneen hundi gosoota Aasheerii turan; isaanis hangafoota maatiiwwanii, namoota filatamoo, loltoota jajjaboo fi bulchitoota bebbeekamoo turan. Akka galmee hidda dhaloota isaanii keessatti galmeeffametti namoonni isaanii kanneen dandeettii waraanaa qaban 26,000 turan.<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s1">Hidda Dhaloota Saaʼol Namicha Gosa Biniyaamii</para>
  <para style="r">
    <ref loc="1CH 8:28-38">8:28‑38</ref> kwf – <char style="xt"><ref loc="1CH 9:34-44">1Sn 9:34‑44</ref></char></para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 8:1" />Biniyaam ilma isaa hangafa Belaa, ilma isaa</para>
  <para style="li2" vid="1CH 8:1">lammaffaa Ashbeel, ilma isaa sadaffaa Aharaa,<verse eid="1CH 8:1" /></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 8:2" />ilma isaa afuraffaa Nohaa fi ilma isaa shanaffaa Raafaa dhalche.<verse eid="1CH 8:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3" />Ilmaan Belaa:</para>
  <para style="li2" vid="1CH 8:3">Adaar, Geeraa, Abiihuud, <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />Abiishuuwaa, Naʼamaan, Ahooʼaa, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />Geeraa, Shefuufaanii fi Huuraam.<verse eid="1CH 8:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6" />Isaan kun ilmaan Eehuudii kanneen hangafoota maatiiwwan warra Gebaa keessa jiraatanii boojuudhaan Maanahatitti geeffamaniiti:<verse eid="1CH 8:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7" />Naʼamaan, Ahiiyaa fi Geeraa; Geeraan kun abbaa Uzaa fi Ahiihudii ti; namni boojuudhaan fuudhee isaan geesses isa ture.<verse eid="1CH 8:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8" />Shaharaayim erga niitota isaa Hushiimii fi Baʼaraa of jalaa ariʼee booddee Moʼaab keessatti ilmaan dhalche. <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />Niitii isaa Hoodesh irraa Yoobaab, Zibiyaa, Meeshaa, Maalkaam, <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />Yeʼuuxi, Saakiyaa fi Miirmaa dhalche; isaan kunneen ilmaan isaa warra hangafoota maatii turanii dha. <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />Niitii isaa Hushiim irraa immoo Abiituubii fi Elphaʼal dhalche.<verse eid="1CH 8:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12" />Ilmaan Elphaʼalii:</para>
  <para style="li2" vid="1CH 8:12">Eeber, Mishaam, shemedi isa magaalaawwan Oonooniitii fi Lood gandoota naannoo ishee jiran wajjin ijaare; <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />Beriiyaa fi Shemaa kanneen hangafoota maatiiwwan warra Ayaaloon keessa jiraatan sanaa taʼanii jiraattota Gaatii ariʼanii biyyaa baasanii dha.<verse eid="1CH 8:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14" />Ahiiyoon, Shaashaaq, Yereemooti, <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />Zebaadiyaan, Aaraad, Ederi, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />Miikaaʼiil, Yishiphaa fi Yoohaan ilmaan Beriiyaa turan.<verse eid="1CH 8:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17" />Zebaadiyaan, Meshulaam, Hizqii, Hebeer, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />Yishimraay, Yizliyaa fi Yoobaab ilmaan Elphaʼalii turan.<verse eid="1CH 8:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19" />Yaaqiim, Zikriin, Zabdiin, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />Eliiʼeenaayi, Ziletaayi, Eliiʼeel, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />Adaayaa, Beraayaa fi Shiimraat ilmaan Shimeʼii turan.<verse eid="1CH 8:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22" />Yishiphaan, Eeber, Eliiʼeel, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />Abdoon, Zikriin Haanaan, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />Hanaaniyaa, Eelaam, Antootiiyaa, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />Yifdeyaa fi Phenuuʼeel ilmaan Shaashaaq turan.<verse eid="1CH 8:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26" />Shamisheraayi, Shehaariyaa, Ataaliyaa, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />Yaʼireshiyaa, Iliyaasii fi Zikriin ilmaan Yiroohamii turan.<verse eid="1CH 8:27" /></para>
  <para style="lf">
    <verse number="28" style="v" sid="1CH 8:28" />Isaan kunneen hundi akkuma hidda dhaloota isaanii keessatti galmeeffametti abbootii maatiitii fi hangafoota turan; isaanis Yerusaalem keessa jiraatu ture.<verse eid="1CH 8:28" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29" />Yeʼiiʼeel abbaan Gibeʼoonis Gibeʼoon keessa jiraata ture;</para>
  <para style="li2" vid="1CH 8:29">maqaan niitii isaa Maʼakaa dha. <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />Ilmi isaa hangafni Abdoon jedhama; kanneen isa booddee dhalatan immoo Zuuri, Qiis, Baʼaal, Neer, Naadaab, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />Gedoor, Ahiiyoo, Zekeerii fi <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />Miiqlooti abbaa Shimeʼaa turan; isaanis firoota isaanii wajjin Yerusaalem keessa jiraatan.<verse eid="1CH 8:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33" />Neer abbaa Qiishii ti; Qiis abbaa Saaʼolii ti; Saaʼol immoo abbaa Yoonaataan, Malkii-shuwaa, Abiinaadaabiitii fi Eshbaʼalii ti.<verse eid="1CH 8:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34" />Ilmi Yoonaataan:</para>
  <para style="li2" vid="1CH 8:34">Meriibaʼaal abbaa Miikaa ti.<verse eid="1CH 8:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35" />Ilmaan Miikaa:</para>
  <para style="li2" vid="1CH 8:35">Phiitoon, Meleek, Taareʼaa fi Aahaaz.<verse eid="1CH 8:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 8:36" />Aahaaz abbaa Yihooʼadaa ti; Yihooʼadaan abbaa Aalemeti, Azmaawetiitii fi Zimrii ti; Zimriin immoo abbaa Moozaa ti. <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />Moozaan abbaa Biineʼaa ti; Raafaan ilma isaa ti; Eleʼaasaan ilma isaa ti; Aazeelis ilma isaa ti.<verse eid="1CH 8:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38" />Aazeel ilmaan jaʼa qaba ture; maqaan isaaniis:</para>
  <para style="li2" vid="1CH 8:38">Azriiqaam, Bookeruu, Ismaʼiil, Sheʼariyaa, Obaadiyaa fi Haanaan. Isaan kunneen hundi ilmaan Aazeelii ti.<verse eid="1CH 8:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39" />Ilmaan obboleessa isaa Eseeqii:</para>
  <para style="li2" vid="1CH 8:39">Ilmi isaa hangafni Uulaam, ilmi isaa lammaffaan Yeʼuushi, ilmi isaa sadaffaan Eliiphelexi. <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />Ilmaan Uulaam loltoota jajjaboo xiyyaan loluu dandaʼan turan. Isaanis ilmaanii fi ilmaan ilmaanii hedduu walumatti nama 150 qabu turan.</para>
  <para style="li1" vid="1CH 8:40">Isaan kunneen hundi ilmaan Biniyaam turan.<verse eid="1CH 8:40" /></para>
  <para style="b" />
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />Israaʼeloonni hundinuu akkuma hidda dhaloota isaaniitti kitaaba mootota Israaʼel keessatti galmeeffaman.</para>
  <para style="s1" vid="1CH 9:1">Saba Yerusaalem</para>
  <para style="r" vid="1CH 9:1">
    <ref loc="1CH 9:1-17">9:1‑17</ref> kwf – <char style="xt"><ref loc="NEH 11:3-19">Nah 11:3‑19</ref></char></para>
  <para style="p" vid="1CH 9:1">Sabni Yihuudaa sababii cubbuu isaatiif boojiʼamee Baabilonitti geeffame.<verse eid="1CH 9:1" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="2" style="v" sid="1CH 9:2" />Warri jalqabatti deebiʼanii lafaa fi magaalaawwan ofii isaanii keessa qubatan Israaʼeloota tokko tokko, luboota, Lewwotaa fi tajaajiltoota mana qulqullummaa ti.<verse eid="1CH 9:2" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="3" style="v" sid="1CH 9:3" />Saboonni Yihuudaa, kan Biniyaamii, kan Efreemii fi kan Minaasee warri Yerusaalem keessa jiraachaa turan:<verse eid="1CH 9:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4" />Uutaayi ilma Amiihuud, ilma Omrii, ilma Imrii, ilma Baanii ilmaan Faares ilma Yihuudaa.<verse eid="1CH 9:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5" />Shelaanota keessaa:</para>
  <para style="li2" vid="1CH 9:5">Asaayaa ilma isaa hangaftichaa fi ilmaan isaa.<verse eid="1CH 9:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6" />Zaaraahota keessaa:</para>
  <para style="li2" vid="1CH 9:6">Yeʼuuʼeel.</para>
  <para style="lf" vid="1CH 9:6">Saboonni Yihuudaa nama 690 turan.<verse eid="1CH 9:6" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="7" style="v" sid="1CH 9:7" />Biniyaamota keessaa:</para>
  <para style="li1" vid="1CH 9:7">Saʼaaluu ilma Meshulaam, ilma Hoodayiwaa, ilma Hasenuuʼaa;<verse eid="1CH 9:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 9:8" />Bineeyaa ilma Yirooham;</para>
  <para style="li1" vid="1CH 9:8">Eelaa ilma Uzii, ilma Mikrii;</para>
  <para style="li1" vid="1CH 9:8">Meshulaam ilma Shefaaxiyaa, ilmaa Reʼuuʼeel, ilma Yibniyaa.<verse eid="1CH 9:8" /></para>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 9:9" />Sabni Biniyaam akka galmee hidda dhaloota isaanii irratti galmeeffametti nama 956 ture. Namoonni kunneen hundi hangafoota maatii isaanii turan.<verse eid="1CH 9:9" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="10" style="v" sid="1CH 9:10" />Luboota keessaa:</para>
  <para style="li2" vid="1CH 9:10">Yedaaʼiyaa; Yehooyaariib; Yaakiin;<verse eid="1CH 9:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 9:11" />Azaariyaa ilma Hilqiyaa, ilma Meshulaam, ilma Zaadoq, ilma Meraayoot, ilma Ahiixuub qondaalticha itti gaafatamaa mana Allaaha taʼe sanaa.<verse eid="1CH 9:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 9:12" />Adaayaa ilma Yerooham, ilma Phaashihuur, ilma Malkiyaa; Maʼasaayi ilma Aadiiʼeel, ilma Yahizeeraa, ilma Meshulaam, ilma Meshileemiit, ilma Imeer.<verse eid="1CH 9:12" /></para>
  <para style="lf">
    <verse number="13" style="v" sid="1CH 9:13" />Baayʼinni luboota abbootii maatii turaniis 1,760 ture. Isaan kunneen namoota dandeettii qaban kanneen tajaajila mana Allaaha keessatti itti gaafatamtoota taʼanii dha.<verse eid="1CH 9:13" /></para>
  <para style="lh">
    <verse number="14" style="v" sid="1CH 9:14" />Lewwota keessaa:</para>
  <para style="li2" vid="1CH 9:14">Shemaaʼiyaa ilma Hashuubii, ilma Azriiqaamii, ilma Hashabiyaa namicha gosa Meraarii sanaa;<verse eid="1CH 9:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 9:15" />Baqbaqar, Hereesh, Gaalaalii fi Mataaniyaa ilma Miikaa, ilma Zikrii, ilma Asaafi;<verse eid="1CH 9:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 9:16" />Obaadiyaa ilma Shemaaʼiyaa, ilma Gaalaal, ilma Yeduutuun;</para>
  <para style="li1" vid="1CH 9:16">Berekiyaa ilma Aasaa, ilma Elqaanaa kan gandoota Netoofotaa keessa jiraachaa ture sana.<verse eid="1CH 9:16" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="17" style="v" sid="1CH 9:17" />Eegdota balbalaa:</para>
  <para style="li1" vid="1CH 9:17">Shaluum, Aquub, Talmoon, Ahiimanii fi obboloota isaanii; Shaluum hangafa gosa isaanii ture; <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />innis hamma ammaatti Karra Mootii kan gama baʼaa biiftuutti ramadameera. Isaan kunneen eegdota balbala qubata Lewwotaa turan.<verse eid="1CH 9:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 9:19" />Shaluum ilmi Qooraahi ilma Ebiyaasaaf, ilma Qoraahiitii fi maatiin isaa jechuunis gosti Qoraahii kanneen isa wajjin karra eegan sun akkuma abbootiin isaanii dur itti gaafatamtoota balbala mana bultii Rabbii Allaah turan sana isaanis itti gaafatamtoota balbala dunkaanaa taʼan.<verse eid="1CH 9:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 9:20" />Bara durii keessa Fiinehaas ilmi Eleʼaazaar sun dura buʼaa eegdota balbalaa ture; Rabbii Allaahanis isa wajjin ture.<verse eid="1CH 9:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 9:21" />Zakariyaa ilmi Mesheleemiyaa immoo eegduu balbala dunkaana wal gaʼii ture.<verse eid="1CH 9:21" /></para>
  <para style="lf">
    <verse number="22" style="v" sid="1CH 9:22" />Namoonni akka balbala eeganiif filataman walumatti 212 turan. Isaanis akkuma hidda dhaloota isaaniitti gandoota isaanii keessatti galmeeffaman.</para>
  <para style="b" vid="1CH 9:22" />
  <para style="p" vid="1CH 9:22">Eegdota balbalaa kanneenis Daawudii fi Saamuʼeel nabiiʼiyyichatu hojii isaaniitti isaan ramade. <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />Isaanii fi sanyiiwwan isaanii itti gaafatamtoota eegumsa karra mana Rabbii Allaah jechuunis manicha Dunkaana jedhamu sanaa turan. <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />Eegdonni balbalaa kunneen qixa afraniin jechuunis karaa baʼa biiftuu, karaa lixa biiftuu, karaa kaabaatii fi kibbaatiin turan. <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />Obboloonni isaaniis yeroo yerootti gandoota isaanii keessaa dhufanii bultii torba torba hojii isaan gargaaraa turan. <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />Dura buutota eegdota balbalaa kanneen Lewwota turan afran garuu itti gaafatamummaa kutaalee fi qabeenya mana Allaaha keessaatu itti kenname. <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />Isaanis sababii manicha eeguu qabaniif halkan halkan naannoo mana Allaaha dhaabatanii bulu turan; ganama ganamas manicha banuuf itti gaafatamummaa qabu turan.<verse eid="1CH 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />Isaan keessaa namoonni tokko tokko toʼattoota miʼa mana qulqullummaa keessatti fayyaduu turan; isaanis miʼa kana yeroo inni gad baafamuu fi yeroo inni ol galfamu ni lakkaaʼu ture. <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />Warri kaan immoo akka miʼoota mana qulqullummaa, daakuu isaa, daadhii wayinii isaa, zayitii isaa, ixaana isaatii fi urgooftuuwwan eeganiif ramadaman. <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />Luboota keessaa tokko tokko immoo urgooftuuwwan walitti makanii qopheessu ture. <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />Lewwicha Matiitiyaa jedhamu, ilma Shaluum namicha gosa Qooraahi hangaftichatti immoo itti gaafatamummaa buddeena aarsaa tolchuutu kenname. <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />Obboloota isaanii Qohaatota tokko tokkotti immoo itti gaafatamummaa buddeena guyyaa Sanbataa hunda minjaala irra kaaʼamu qopheessuutu kenname.<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />Faarfattoonni abbootii maatiiwwani Lewwotaa turan immoo waan halkanii fi guyyaa itti gaafatamummaa hojii qabaniif kutaa mana qulqullummaa keessaa hin baʼan; hojii biraattis hin waamaman ture.<verse eid="1CH 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34" />Isaan kunneen hundinuu abbootii maatiiwwan Lewwotaa hangafoota gosaa kanneen akkuma hidda dhaloota isaaniitti galmeeffamanii dha; isaanis Yerusaalem keessa jiraatan.<verse eid="1CH 9:34" /></para>
  <para style="s1">Hidda dhaloota Saaʼol</para>
  <para style="r">
    <ref loc="1CH 9:34-44">9:34‑44</ref> kwf – <char style="xt"><ref loc="1CH 8:28-38">1Sn 8:28‑38</ref></char></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35" />Yeʼiiʼeel abbaan Gibeʼoonis Gibeʼoon keessa jiraata ture.</para>
  <para style="li2" vid="1CH 9:35">Maqaan niitii isaa Maʼakaa dha; <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />ilmi isaa hangafni Abdoon jedhama; kanneen isa booddee dhalatan immoo Zuuri, Qiis, Baʼaal, Neer, Naadaab, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />Gedoor, Ahiiyoo, Zakariyaa fi Miiqlooti. <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />Miiqlooti abbaa Shimeʼaam. Isaanis firoota isaanii wajjin Yerusaalem keessa jiraatan.<verse eid="1CH 9:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39" />Neer abbaa Qiishii ti; Qiis abbaa Saaʼolii ti; Saaʼol immoo abbaa Yoonaataan, Malkii-shuwaa, Abiinaadaabiitii fi Eshbaʼalii ti.<verse eid="1CH 9:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40" />Ilmi Yoonaataan:</para>
  <para style="li2" vid="1CH 9:40">Meriibaʼaal abbaa Miikaa ti.<verse eid="1CH 9:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41" />Ilmaan Miikaa:</para>
  <para style="li2" vid="1CH 9:41">Phiitoon, Meleek, Tahireeʼaa fi Aahaaz.<verse eid="1CH 9:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42" />Aahaaz abbaa Yaʼiraa ti; Yaʼiraan immoo abbaa Aalemeti, Azmaawetiitii fi Zimrii ti; Zimriin immoo abbaa Moozaa ti. <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />Moozaan abbaa Biineʼaa ti; Refaayaan ilma isaa ti; Eleʼaasaan ilma isaa ti; Aazeelis ilma isaa ti.<verse eid="1CH 9:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44" />Aazeel ilmaan jaʼa qaba ture; maqaan isaaniis:</para>
  <para style="li2" vid="1CH 9:44">Azriiqaam, Bookeruu, Ismaʼiil, Sheʼariyaa, Obaadiyaa fi Haanaan. Isaan kunneen ilmaan Aazeelii ti.<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s1">Saaʼol Of Ajjeese</para>
  <para style="r">
    <ref loc="1CH 10:1-12">10:1‑12</ref> kwf – <char style="xt"><ref loc="1SA 31:1-13">1Sm 31:1‑13</ref>; <ref loc="2SA 1:4-12">2Sm 1:4‑12</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />Filisxeemonni yeroo kanatti Israaʼelitti waraana kaasan; Israaʼeloonnis isaan duraa baqatan; hedduun isaaniis Tulluu Gilboʼaa irratti dhuman. <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />Filisxeemonni ittuma jabeessanii Saaʼolii fi ilmaan isaa ariʼan; isaanis ilmaan isaa jechuunis Yoonaataan, Abiinaadaabii fi Malkii-shuwaa ajjeesan. <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />Lollis naannoo Saaʼolitti baayʼee cime; warri xiyyaan lolanis isa qaqqabanii isa madeessan.<verse eid="1CH 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4" />Saaʼolis namicha miʼa lolaa isaa baatuun, “Goraadee kee luqqifadhuutii na waraani; yoo kanaa achii namoonni dhagna hin qabamin kunneen dhufanii natti taphatuu” jedhe.</para>
  <para style="p" vid="1CH 10:4">Namichi miʼa lolaa baatuuf sun garuu waan akka malee sodaateef isa hin waraanne; kanaafuu Saaʼol goraadee ofii isaa luqqifatee irratti kufe. <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />Namichi miʼa lolaa baatu sun yommuu akka Saaʼol duʼe argetti innis goraadee ofii isaa irratti kufee duʼe. <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />Kanaafuu Saaʼolii fi ilmaan isaa sadan ni duʼan; warri mana isaa hundinuus walumaan dhuman.<verse eid="1CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7" />Israaʼeloonni sulula keessa turan hundi yommuu akka loltoonni baqatan, akka Saaʼolii fi ilmaan isaas dhuman arganitti magaalaawwan isaanii dhiisanii baqatan. Filisxeemonni immoo dhufanii keessa qubatan.<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />Filisxeemonnis guyyaa itti aanutti yommuu warra dhuman irraa hidhannaa hiikkachuu dhufanitti akka Saaʼolii fi ilmaan isaa Tulluu Gilboʼaa irratti kukkufanii jiran argan. <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />Isaanis erga hidhata Saaʼolii hiikkatanii mataa isaan irraa kutanii booddee akka isaan waaqeffatamtoota tolfamoo fi namoota isaaniitti oduu gaarii labsaniif guutummaa Filisxeemiitti ergamoota ni ergan. <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />Ergasii immoo miʼa lolaa isaa mana waaqeffatamtoota tolfamoo isaanii keessa, mataa isaa immoo mana Daagon waaqeffatamaa tolfamaa sanaa keessatti ni fannisan.<verse eid="1CH 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11" />Jiraattonni Yaabeesh Giliʼaad hundi yommuu waan Filisxeemonni Saaʼolin godhan dhagaʼanitti, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />namoonni jajjaboon isaanii hundi dhaqanii reeffa Saaʼolii fi reeffa ilmaan isaa guuranii gara Yaabeeshitti ni fidan. Ergasii immoo reeffa isaanii muka guddaa Yaabeesh keessaa tokko jalatti qabbaran; guyyaa torbas ni sooman.<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />Saaʼol sababii Rabbii Allaahaf amanamaa hin taʼiniif duʼe; inni dubbii Rabbii Allaahatiif hin ajajamne; qooda kanaa ilaaltuu gorsa gaafate; <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />Rabbii Allaah gorsa hin gaafanne. Kanaaf Rabbii Allaahan isa ajjeese; mootummaa isaas dabarsee Daawud ilma Isseeyiitiif kenne.<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s1">Daawud Mootii Israaʼel Taʼe</para>
  <para style="r">
    <ref loc="1CH 11:1-3">11:1‑3</ref> kwf – <char style="xt"><ref loc="2SA 5:1-3">2Sm 5:1‑3</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />Israaʼeloonni hundinuu Kebroonitti Daawud biratti walitti dhufanii akkana jedhan; “Nu foonii fi dhiiga kee ti. <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />Duraan, yeroo Saaʼol mootii turetti iyyuu namni duula loltoota Israaʼel hoogganu siʼi ture. Rabbii Allaah Allaahan kees, ‘Situ saba koo Israaʼelin tiksa; bulchaa isaaniis ni taata’ siin jedhee ture.”<verse eid="1CH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3" />Yommuu maanguddoonni Israaʼel hundi Kebroonitti Daawud Mooticha bira dhufanitti, inni Kebroonitti fuula Rabbii Allaah duratti isaan wajjin kakuu gale. Isaanis akkuma Rabbii Allaahan karaa Saamuʼeeliin abdachiise sanatti dibanii Israaʼel irratti mootii isa godhan.<verse eid="1CH 11:3" /></para>
  <para style="s1">Daawud Yerusaalemin Moʼachuu Isaa</para>
  <para style="r">
    <ref loc="1CH 11:4-9">11:4‑9</ref> kwf – <char style="xt"><ref loc="2SA 5:6-10">2Sm 5:6‑10</ref></char></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />Daawudii fi Israaʼeloonni hundinuu gara Yerusaalemitti jechuunis Yebuusiitti ni qajeelan. Yebuusonni achi jiraatan garuu <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />Daawudiin, “Ati as hin seentu” jedhan. Taʼus Daawud daʼannoo Xiyoon jechuunis Magaalaa Daawud ni qabate.<verse eid="1CH 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6" />Daawudis, “Namni duraan dursee dhaqee Yebuusota lolu ajajaa loltootaa taʼa” jedhee ture. Yooʼaab ilmi Zeruuyaa jalqabatti baʼe; kanaafuu inni ajajaa waraanaa taʼe.<verse eid="1CH 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7" />Daawudis iddoo jireenya isaa daʼannoo sana keessa godhate; kanaafuu daʼannoon sun Magaalaa Daawud jedhamee waamame. <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />Innis Miiloodhaa jalqabee naannoo isheetti dallaa dhagaa ni ijaare; Yooʼaab immoo kutaa Magaalaa sanaa kan hafe deebisee ijaare. <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />Daawudis sababii Rabbii Allaahan Waan Hunda Dandaʼu isa wajjin tureef yeruma yeroon jabaachaa dhufe.<verse eid="1CH 11:9" /></para>
  <para style="s1">Namoota Daawud Jajjabeeyyii</para>
  <para style="r">
    <ref loc="1CH 11:10-41">11:10‑41</ref> kwf – <char style="xt"><ref loc="2SA 23:8-39">2Sm 23:8‑39</ref></char></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />Namoota Daawud warra jajjaboo keessaa hangafoonni kanneenii dha; isaanis akkuma Rabbii Allaahan waaʼee Israaʼel dubbate sanatti mootii isa gochuuf jedhanii saba Israaʼel hunda wajjin mootummaa isaa keessatti gargaarsa guddaa godhaniif. <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />Maqaan namoota Daawud warra jajjaboo kanaa dha:</para>
  <para style="p" vid="1CH 11:11">Yaashobiʼaam namichi gosa Hakmooni hangafa ajajjoota sanaa ture; innis lola tokko irratti eeboo mirmirsee namoota dhibba sadii fixe.<verse eid="1CH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12" />Kan isatti aanu immoo Eleʼaazaar namicha gosa Ahooʼaa, ilma Doodoo ture; innis namoota jajjaboo sadan sana keessaa tokko ture. <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />Eleʼaazaar yeroo Filisxeemonni waraanaaf walitti qabamanii turanitti Daawud wajjin Phaas Damiim ture. Loltoonnis lafa qotiisaa kan garbuudhaan guutame tokko biratti Filisxeemota duraa baqatan. <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />Innii fi Daawud garuu lafa qotiisaa walakkaatti iddoo qabatan. Isaanis irraa ittisuudhaan Filisxeemota fixan; Rabbii Allaahanis moʼannaa guddaa isaaniif kenne.<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />Utuma gareen Filisxeemotaa Sulula Refaayim keessa qubatee jiruu hangafoota soddomman sana keessaa namoonni sadii gara kattaa holqa Adulaamitti gara Daawud gad buʼan. <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />Yeroo sanatti Daawud daʼannoo cimaa keessa ture; loltoonni Filisxeem immoo Beetlihem turan. <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />Daawudis dheebotee, “Utuu namni tokko boolla bishaanii kan karra Beetlihem bira jiru keessaa bishaan dhugaatii naa fidee hoo!” jedhe. <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />Kanaafuu namoonni Sadan sun qubata Filisxeemotaa keessaan darbanii boolla bishaanii kan karra Beetlihem bira jiru keessaa bishaan waraabanii Daawudiif fidan. Inni garuu dhuguu ni dide; qooda kanaa bishaan sana fuula Rabbii Allaah duratti dhangalaase. <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />Innis, “Akka ani waan kana hin goone Allaahan narraa haa fageessu! Ani dhiiga namoota lubbuu ofii isaaniitti muranii dhaqan kanaa nan dhugaa?” jedhe. Sababii isaan lubbuu ofii isaaniitti muranii dhaqanii fidaniif Daawud bishaan sana hin dhugne.</para>
  <para style="p" vid="1CH 11:19">Egaa wanni namoonni jajjaboon sadan sun hojjetan kana ture.<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />Abiishaayi obboleessi Yooʼaab hoogganaa Sadan isaanii ture. Innis namoota dhibba sadiitti eeboo isaa ol kaafatee isaan fixe; akkasiin innis akkuma namoota Sadan sanaa beekamaa taʼe. <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />Inni yoo isaan keessaa tokko taʼuu baate iyyuu warra Sadan caalaa ulfina argatee ajajaa isaanii taʼe.<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />Benaayaa ilmi Yehooyaadaa loltuun cimaan biyya Qabziʼeel sunis loltuu moʼannaa gurguddaa argamsiise ture. Innis loltoota Moʼaab kanneen akka malee jajjaboo taʼan lama ajjeese. Gaafa cabbiin roobe tokkos boolla keessa seenee leenca ajjeese. <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />Namicha biyya Gibxi kan dhundhuma shan dheeratu tokko illee ni ajjeese. Namichi Gibxi sun eeboo akka danqaraa wayya dhooftuu harkaa qabaatu iyyuu Benaayaa bokkuudhaan isatti baʼe. Innis harka namicha Gibxi sanaatii eeboo butatee eeboodhuma isaatiin isa ajjeese. <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />Hojiiwwan gootummaa kanneen Benaayaa ilmi Yehooyaadaa hojjete kana faʼi; innis akkuma namoota jajjaboo sadan sanaa nama beekamaa ture. <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />Inni namoota Soddomman sana keessaa nama kam iyyuu caalaa ulfina guddaa argate; garuu namoota Sadan sanatti hin dabalamne. Daawudis ajajaa eegdota ofii isaa isa godhate.<verse eid="1CH 11:25" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="26" style="v" sid="1CH 11:26" />Namoonni jajjaboon sunis kanneenii dha:</para>
  <para style="b" vid="1CH 11:26" />
  <para style="li1" vid="1CH 11:26">Asaaheel obboleessa Yooʼaab,</para>
  <para style="li1" vid="1CH 11:26">Elhaanaan namicha Beetlihem ilma Doodoo,<verse eid="1CH 11:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 11:27" />Shamoot namicha gosa Haroor,</para>
  <para style="li1" vid="1CH 11:27">Heleez namicha gosa Pheloonaa,<verse eid="1CH 11:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 11:28" />Iiraa ilma Iqeesh nama Teqooʼaa,</para>
  <para style="li1" vid="1CH 11:28">Abiiʼezer nama Anaatoot,<verse eid="1CH 11:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 11:29" />Siibekaay nama biyya Hushaa,</para>
  <para style="li1" vid="1CH 11:29">Iilaayi nama Ahooʼaa,<verse eid="1CH 11:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 11:30" />Maharaayi nama Netoofaa,</para>
  <para style="li1" vid="1CH 11:30">Heeled ilma Baʼanaa nama Netoofaa,<verse eid="1CH 11:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 11:31" />gosa Biniyaam keessaa</para>
  <para style="li1" vid="1CH 11:31">Iitaayi ilma Riibaay, namicha Gibeʼaa,</para>
  <para style="li1" vid="1CH 11:31">Benaayaa nama Phiraatoon,<verse eid="1CH 11:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 11:32" />Huuraayi namicha sululoota Gaʼaash,</para>
  <para style="li1" vid="1CH 11:32">Abiiʼeel namicha biyya Arbaa,<verse eid="1CH 11:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 11:33" />Azmaawet namicha Baharuum,</para>
  <para style="li1" vid="1CH 11:33">Eliiyaabaa namicha Shaʼalboon,<verse eid="1CH 11:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 11:34" />ilmaan Haasheem namicha Gizoon,</para>
  <para style="li1" vid="1CH 11:34">Yoonaataan ilma Shaagee namicha Haraaraa,<verse eid="1CH 11:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 11:35" />Ahiiʼaam ilma Saakaar namicha Haraaraa,</para>
  <para style="li1" vid="1CH 11:35">Eliifaal ilma Uuri,<verse eid="1CH 11:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 11:36" />Heefer namicha Mekeeraataa,</para>
  <para style="li1" vid="1CH 11:36">Ahiiyaa namicha Pheloonaa,<verse eid="1CH 11:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 11:37" />Hezroo nama Qarmeloos,</para>
  <para style="li1" vid="1CH 11:37">Naʼaraayi ilma Ezbayi,<verse eid="1CH 11:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 11:38" />Yooʼeel obboleessa Naataanii,</para>
  <para style="li1" vid="1CH 11:38">Mibehaar ilma Hagrii,<verse eid="1CH 11:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 11:39" />Zeleq namicha gosa Amoon,</para>
  <para style="li1" vid="1CH 11:39">Nahaaraay namicha Biʼeeroot kan Yooʼaab ilma Zeruuyaatiif miʼa lolaa baatu sana,<verse eid="1CH 11:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 11:40" />Iiraas namicha gosa Yitraa,</para>
  <para style="li1" vid="1CH 11:40">Gaareeb namicha gosa Yitraa,<verse eid="1CH 11:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 11:41" />Uuriyaa namicha Heet,</para>
  <para style="li1" vid="1CH 11:41">Zaabaad ilma Ahilayi,<verse eid="1CH 11:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 11:42" />Aadiinaa ilma Shiizaa namicha gosa Ruubeen, inni hoogganaa Ruubeenotaatii fi kan namoota Soddomman isa wajjin turanii ti;<verse eid="1CH 11:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 11:43" />Haanaan ilma Maʼakaa,</para>
  <para style="li1" vid="1CH 11:43">Yooshaafaaxi namicha Miitinaa,<verse eid="1CH 11:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 11:44" />Uziyaa namicha Ashteraati,</para>
  <para style="li1" vid="1CH 11:44">Shaamaaʼii fi Yeʼiiʼeel ilmaan Hootaam namicha Aroʼeer,<verse eid="1CH 11:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 11:45" />Yediʼyaaʼeel ilma Shimrii,</para>
  <para style="li1" vid="1CH 11:45">obboleessa isaa Yoohaa namicha Tiizii,<verse eid="1CH 11:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 11:46" />Eliiʼeel namicha Mahawaa,</para>
  <para style="li1" vid="1CH 11:46">Yeriibaayii fi Yooshabiyaa ilmaan Elnaʼam,</para>
  <para style="li1" vid="1CH 11:46">Yitmaa namicha Moʼaab,<verse eid="1CH 11:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 11:47" />Eliiʼeel, Oobeedii fi Yaʼisiiʼel namicha Mezoobaa.<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s1">Loltoonni Daawuditti Dabalamuu Isaanii</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 12:1" />Namoonni kunneen warra yeroo inni sababii Saaʼol ilma Qiish sanaatiif asii fi achi sochoʼuu dadhabetti Siiqlaagitti gara Daawud dhufanii dha. Isaanis loltoota jajjaboo kanneen lola irratti isa gargaaran keessaa tokkoo dha; <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />isaan warra iddaa qabatanii harka mirgaatiin yookaan harka bitaatiin xiyya darbachuu yookaan dhagaa furrisuu dandaʼanii dha; isaanis gosa Biniyaam keessaa warra Saaʼoliif firootaa dhiigaa taʼanii dha.<verse eid="1CH 12:2" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="3" style="v" sid="1CH 12:3" />Ahiiʼezer hangafa isaanii ture; sana booddee immoo Yooʼaashitu ture; lamaan isaanii iyyuu ilmaan Shemaaʼaa namicha Gibeʼaa sanaa turan.</para>
  <para style="li1" vid="1CH 12:3">Ilmaan Azmaawet Yiziiʼeelii fi Phelet,</para>
  <para style="li1" vid="1CH 12:3">Beraakiyaa, Yehuu namicha Anaatoot, <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />Yishmaʼiyaa namichi Gibeʼoonii sun jara Soddomman keessaa nama jabaa fi hoogganaa Soddomman isaanii ture;</para>
  <para style="li1" vid="1CH 12:4">Ermiyaas, Yahiziiʼeel, Yoohaanaan, Yoozaabaad namicha Gedeeraa, <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />Elʼuuzay, Yeriimooti, Beʼaaliyaa, Shemaariyaa, Shefaaxiyaa namicha Haruufaa,<verse eid="1CH 12:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 12:6" />Elqaanaa, Yishiyaa, Azariʼeel, Yoozerii fi Yaashobiʼaam jarreen gosa Qooraahi,<verse eid="1CH 12:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 12:7" />Yooʼelaa fi Zebaadiyaa ilmaan Yeroohaam namicha Gedoor.<verse eid="1CH 12:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />Yeroo Daawud gammoojjiitti daʼoo keessa turetti namoonni gosa Gaad tokko tokko dhufanii isaatti ni dabalaman. Isaanis loltoota ciccimoo gaachanaa fi eeboo qabachuu dandaʼan kanneen waraanaaf qophaaʼan turan. Fuulli isaanii fuula leencaa fakkaata ture; isaan akkuma kuruphee tulluu gubbaa saffistoota turan.<verse eid="1CH 12:8" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9" />Eezer hoogganaa isaanii ture;</para>
  <para style="li1" vid="1CH 12:9">Obaadiyaan lamaffaa, Eliiyaab sadaffaa,<verse eid="1CH 12:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10" />Mishmanaan afuraffaa, Ermiyaas shanaffaa,<verse eid="1CH 12:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11" />Ataayi jaʼaffaa, Eliiʼeel torbaffaa,<verse eid="1CH 12:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12" />Yoohaanaan saddeettaffaa, Elzaabaad saglaffaa,<verse eid="1CH 12:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13" />Ermiyaas kurnaffaa, Makibanaayi kudha tokkoffaa ture.<verse eid="1CH 12:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14" />Jarreen gosa Gaad kunneen ajajjoota loltootaa turan; isaan keessaa inni xinnaan akka ajajaa nama dhibbaatti, inni guddaan immoo akka ajajaa nama kumaatti hedama ture. <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />Warri jiʼa jalqabaatti yeroo lagni Yordaanos guutee ededa isaa hunda irra dhangalaʼutti ceʼanii akka namoonni sululicha keessa jiraachaa turan gara baʼa biiftuutii fi gara lixa biiftuutti baqatan godhan namootuma kanneen turan.<verse eid="1CH 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />Namoonni Biniyaamiitii fi Yihuudaa tokko tokkos Daawud bira gara daʼannoo isaa ni dhufan. <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />Daawudis isaan simachuudhaaf gad baʼee akkana jedheen; “Isin yoo na gargaaruudhaaf jettanii nagaadhaan dhuftanii jiraattan, ani ofitti isin dabalachuudhaaf qophaaʼaa dha. Garuu yoo isin utuu harki koo yakka hin hojjetin diinota kootti dabarsitanii na kennuudhaaf dhuftanii jiraattan, Allaahan abbootii keenyaa ilaalee murtii haa kennu.”<verse eid="1CH 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18" />Ergasiis Hafuurri Qulqulluun Amaasaayi hoogganaa namoota Soddomman sanaa irra buʼe; innis akkana jedhe:</para>
  <para style="q1" vid="1CH 12:18">“Yaa Daawud, nu kan kee ti!</para>
  <para style="q2" vid="1CH 12:18">Yaa ilma Isseey, nu suma wajjin jirra!</para>
  <para style="q1" vid="1CH 12:18">Milkaaʼi, milkaaʼi;</para>
  <para style="q2" vid="1CH 12:18">warri si gargaaranis haa milkaaʼan;</para>
  <para style="q3" vid="1CH 12:18">Allaahan kee si gargaaraatii.”</para>
  <para style="p" vid="1CH 12:18">Kanaafuu Daawud isaan simatee dura deemtota loltoota isaa isaan godhate.<verse eid="1CH 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />Yeroo Daawud Saaʼolin loluuf jedhee Filisxeemota wajjin duuletti namoonni Minaasee tokko tokko fottoqanii gara Daawuditti ni goran. Inni garuu sababii bulchitoonni Filisxeem mariʼatanii of irraa isa ariʼaniif innii fi namoonni isaa Filisxeemota hin gargaarre. Isaanis, “Yoo inni nu dhiisee gara gooftaa isaa gara Saaʼol deebiʼe wanni kun nu ficcisiisa” jedhanii turaniitii. <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />Yeroo Daawud gara Siiqlaag deemetti namoonni Minaasee warri fottoqanii gara isaa goran kanneenii dha: Adinaahi, Yoozaabaad, Yediiʼeel, Miikaaʼiil, Yoozaabaad, Eliihuu fi Ziletaayi; isaan kunneen gosa Minaasee keessatti ajajjuuwwan kumaa turan. <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />Isaanis balaa buuftota dhaʼuu irratti Daawudin ni gargaaran; hundi isaanii loltoota jajjaboo fi ajajjoota loltoota isaa turaniitii. <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />Hamma inni loltoota guddaa akka loltoota Allaaha qabaatutti, namoonni Daawudin gargaaruudhaaf guyyaa guyyaadhaan gara isaa dhufaa ture.<verse eid="1CH 12:22" /></para>
  <para style="s1">Namoonni Biraas Kebroonitti Daawuditti Dabalaman</para>
  <para style="lh">
    <verse number="23" style="v" sid="1CH 12:23" />Baayʼinni namoota lolaaf hidhatanii akkuma Rabbii Allaahan dubbatee turetti mootummaa Saaʼol gara Daawudiitti dabarsuudhaaf jedhanii Daawud bira gara Kebroonii dhufanii kanneenii dha:<verse eid="1CH 12:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24" />Namoonni Yihuudaa kanneen gaachanaa fi eeboo qabatanii lolaaf qophaaʼan 6,800;<verse eid="1CH 12:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25" />namoonni Simiʼoonii loltoonni waraanaaf qophaaʼan 7,100;<verse eid="1CH 12:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26" />namoonni Lewwii 4,600; <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />Yehooyaadaan hoogganaa maatii Haaruun ture; namoonni 3,700 isa wajjin turan; <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />Zaadoq dargaggeessa loltuu jagnaa sanaa fi maatii isaa keessaa ajajjoota waraanaa 22;<verse eid="1CH 12:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29" />namoonni Biniyaam kanneen firoota Saaʼolii taʼan 3,000; isaan keessaas hedduun isaanii hamma yeroo sanaatti mana Saaʼoliitiif amanamoo turan;<verse eid="1CH 12:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30" />namoonni Efreem warri lolatti ciccimoo fi balbala isaanii keessatti bebeekamoo taʼan 20,800;<verse eid="1CH 12:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31" />walakkaa gosa Minaasee keessaa namoonni Daawudin mootii gochuudhaaf maqaan isaanii galmaaʼee dhufan 18,000;<verse eid="1CH 12:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32" />namoota Yisaakor keessaa warra haala yeroo hubatanii waan Israaʼeloonni gochuu qaban beekan hangafoota 200, firoota isaanii kanneen isaan jalatti bulan hunda wajjin;<verse eid="1CH 12:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33" />namoota Zebuuloon keessaa loltoonni muuxannoo qaban warri meeshaa lolaa kamiin iyyuu loluuf qophaaʼan kanneen Daawudin gargaaruuf garaan isaanii tokko taʼe 50,000;<verse eid="1CH 12:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34" />namoota Niftaalem keessaa ajajjoota 1,000; namoota gaachanaa fi eeboo qabatan 37,000 wajjin;<verse eid="1CH 12:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35" />namoota Daan kanneen lolaaf qophaaʼan 28,600;<verse eid="1CH 12:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36" />namoota Aasheer keessaa loltoonni muuxannoo qaban kanneen lolaaf qophaaʼan 40,000;<verse eid="1CH 12:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37" />gama baʼa Yordaanosiitii namoota Ruubeen, namoota Gaadiitii fi walakkaa gosa Minaasee keessaa namoota miʼa lolaa kan gosa hundaa hidhatan 120,000.<verse eid="1CH 12:37" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="38" style="v" sid="1CH 12:38" />Isaan kunneen hundinuu loltoota waraana keessa tajaajiluudhaaf of kennanii dha.</para>
  <para style="b" vid="1CH 12:38" />
  <para style="p" vid="1CH 12:38">Isaanis Israaʼel hunda irratti Daawudin mootii gochuuf kutatanii gara Kebroon ni dhufan. Israaʼeloonni hafan hundinuus Daawudin mootii gochuuf yaaduma tokko qabu turan. <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />Namoonnis sababii maatiin isaanii waan hunda isaaniif qopheessaniif nyaachaa dhugaa guyyaa sadii Daawud wajjin achi turan. <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />Akkasumas olloonni isaanii kanneen hamma Yisaakoriitti, Zebuuloonittii fi Niftaalemiitti jiran harrootatti, gaalawwanitti, gaangolii fi sangootatti nyaata feʼanii fidanii ni dhufan. Sababii Israaʼel keessa gammachuun guddaan tureefis daakuun, bixxilleen ija harbuutii fi bixxilleen ija wayinii, daadhiin wayinii, zayitiin, loonii fi hoolonni akka malee baayʼeen dhiʼeeffamanii turan.<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s1">Taabota Deebisanii Fidan</para>
  <para style="r">
    <ref loc="1CH 13:1-14">13:1‑14</ref> kwf – <char style="xt"><ref loc="2SA 6:1-11">2Sm 6:1‑11</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />Daawud ajajjoota isaa hunda ajajjoota kumaatii fi ajajjoota dhibbaa wajjin ni mariʼate. <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />Ergasii inni yaaʼii Israaʼel guutuudhaan akkana jedhe; “Yoo wanni kun waan gaarii isinitti fakkaatee fi yoo fedhii Rabbii Allaah keenyaa taʼe, kottaa mee akka isaan dhufanii nutti dabalamaniif obboloota keenya kanneen guutummaa biyya Israaʼel keessatti hafanitti akkasumas lubootaa fi Lewwota isaan wajjin magaalaawwanii fi lafa dheeda isaanii keessa jiraatanitti ergaa haa erginu. <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />Taabota Allaah keenyaa deebifnee haa fidannu; nu bara mootummaa Saaʼol keessa isa hin barbaaneetii.” <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />Sababii wanni kun saba hundatti waan qajeelaa fakkaateef guutummaan yaaʼii sanaa waan kana gochuudhaaf walii gale.<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />Kanaafuu Daawud taabota Allaaha Kiriyaati Yeʼaariimii fiduudhaaf Israaʼeloota Laga Shihoorii kan biyya Gibxiitti argamuu jalqabee hamma karra Hamaatiitti jiran hunda walitti qabe. <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />Daawudii fi Israaʼeloonni isa wajjin turan hundi taabota Allaah kiirubeelii gidduu teessoo irra jiru sanaa jechuunis taabota Maqaa Rabbii Allaahatiin waamamu sana achii fiduuf jedhanii gara Baʼaalaa jechuunis gara Kiriyaati Yeʼaariim ishee Yihuudaa keessaa sanaa ni dhaqan.<verse eid="1CH 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7" />Isaanis taabota Allaaha sana gaarii haaraatti feʼanii mana Abiinaadaabiitii ni baasan; Uzaa fi Ahiiyoon gaarii sana oofaa turan. <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />Daawudii fi Israaʼeloonni hundinuu humna isaanii guutuudhaan faarfannaa fi baganaadhaan, kiraaraa fi dibbeedhaan, kilillee fi malakataan fuula Allaaha duratti gammadanii shuubbisaa.<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />Yommuu isaan oobdii Kiidoon bira gaʼanitti waan sangoonni gufataniif Uzaan taabota sana qabuuf harka isaa hiixate. <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />Sababii Uzaan taabota irra harka isaa kaaʼeef dheekkamsi Rabbii Allaah Uzaatti bobaʼe; innis isa rukute; kanaafuu inni achumatti fuula Allaaha duratti ni duʼe.<verse eid="1CH 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11" />Daawudis sababii Rabbii Allaahan akka malee Uzaatti dheekkameef ni aare; iddoon sun hamma harʼaatti Phereez Uzaa<note caller="+" style="f"><char style="fr" closed="false">13:11 </char><char style="fq" closed="false">Phereez Uzaa </char><char style="ft" closed="false">jechuun </char><char style="fqa" closed="false">galaafatamuu </char><char style="ft" closed="false">jechuu dha.</char></note> jedhamee waamama.<verse eid="1CH 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12" />Daawudis gaafa sana Allaah sodaatee, “Ani akkamittan taabota Allaaha gara mana kootti fiduu dandaʼa?” jedhee gaafate. <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />Innis akka taabonni isa wajjin Magaalaa Daawud keessa jiraatuuf ofitti hin fudhanne. Qooda kanaa gara mana Oobeed Edoom namicha Gitii sanaatti geesse. <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />Taabonni Allaahas jiʼa sadii maatii Oobeed Edoom wajjin mana isaa keessa ture; Rabbii Allaahanis warra mana isaa jiraatanii fi waan inni qabu hunda ni eebbise.<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s1">Mana Daawudii fi Maatii Isaa</para>
  <para style="r">
    <ref loc="1CH 14:1-7">14:1‑7</ref> kwf – <char style="xt"><ref loc="2SA 5:11-16">2Sm 5:11‑16</ref>; <ref loc="1CH 3:5-8">1Sn 3:5‑8</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />Yeroo kanatti Huuraam mootiin Xiiroos akka isaan Daawudiif masaraa mootummaa ijaaraniif ergamoota wajjin muka birbirsaa, warra dhagaa soofanii fi warra ogummaa hojii mukaa qaban gara Daawuditti erge. <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />Daawudis akka Rabbii Allaahan saba Israaʼel irratti mootii godhee jabeessee isa dhaabee fi akka mootummaan isaas sababii saba Israaʼeliif akka malee guddate ni beeke.<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />Daawudis Yerusaalem keessatti niitota dabalee fuudhee ilmaanii fi intallan dabalataa dhalche. <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />Maqaan ijoollee isaa kanneen achitti isaaf dhalataniis: Shamuuʼaa, Shobaab, Naataan, Suleyimaan, <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />Yibehaar, Eliishuuwaa, Eliiphelexi, <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />Noogaa, Nefeg, Yaafiiyaa, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />Eliishaamaa, Beeliyaadaa fi Eliiphelexi jedhamu.<verse eid="1CH 14:7" /></para>
  <para style="s1">Daawud Filisxeemota Moʼate</para>
  <para style="r">
    <ref loc="1CH 14:8-17">14:8‑17</ref> kwf – <char style="xt"><ref loc="2SA 5:17-25">2Sm 5:17‑25</ref></char></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />Filisxeemonni yommuu akka Daawud dibamee guutummaa Israaʼel irratti mootii taʼe dhagaʼanitti humna guutuudhaan isa barbaacha ol baʼan; Daawud garuu waan kana dhagaʼee isaanitti baʼe. <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />Yeroo kanatti Filisxeemonni dhufanii Sulula Refaayim weeraran; <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />kanaafuu Daawud, “Ani baʼee Filisxeemota dhaʼuu? Ati dabarsitee harka kootti isaan kennitaa?” jedhee Allaah ni gaafate.</para>
  <para style="p" vid="1CH 14:10">Rabbii Allaahanis, “Baʼi; ani dhugumaan Filisxeemota dabarsee harka keetti nan kennaatii” jedhee deebiseef.<verse eid="1CH 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11" />Kanaafuu Daawudii fi namoonni isaa gara Baʼaal Pheraaziim ol baʼan; achittis isaan moʼate. Innis, “Akkuma bishaan mana isaa cabsee yaaʼu sana Allaahan harka kootiin diinota koo cabsee baʼeera” jedhe. Kanaafuu iddoon sun Baʼaal Pheraaziim jedhamee waamame. <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />Filisxeemonni waaqeffatamtoota isaanii tolfamoo achitti ni dhiisan; Daawud immoo akka waaqeffatamtoonni sun ibiddaan gubaman ni ajaje.<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />Filisxeemonni amma illee deebiʼanii sulula sana weeraran; <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />kanaafuu Daawud ammas Allaah gaafate; Allaahanis akkana jedhee deebiseef; “Qajeelumatti itti ol hin baʼin; garuu isaan marsiitii muka qilxuu duratti isaan waraani. <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />Akkuma fiixee muka qilxuu irraan sagalee duulaa dhageesseen loluuf baʼi; Allaahan loltoota Filisxeem dhaʼuudhaaf si dura baʼeera jechuudhaatii.” <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />Kanaafuu Daawud akkuma Allaahan isa ajaje sana ni godhe; isaanis Gibeʼoonii jalqabanii hamma Geeziritti loltoota Filisxeem ni dhaʼan.<verse eid="1CH 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17" />Akkasiin maqaan Daawud biyya hunda keessatti beekame; Rabbii Allaahanis akka saboonni hundinuu isa sodaatan godhe.<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s1">Taabonni Gara Yerusaalem Fidame</para>
  <para style="r">
    <ref loc="1CH 15:25-16:3">15:25–16:3</ref> kwf – <char style="xt"><ref loc="2SA 6:12-19">2Sm 6:12‑19</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />Daawud erga ofii isaatiif Magaalaa Daawud keessatti mana ijaarratee booddee taabota Allaahatiif lafa qopheessee dunkaana dhaabe. <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />Ergasiis Daawud, “Waan Rabbii Allaahan akka isaan taabota Allaaha baatanii bara baraan fuula isaa dura tajaajilaniif isaan filateef, Lewwota malee namni biraa taabota Rabbii Allaah hin baatin” jedhee ajaje.<verse eid="1CH 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3" />Daawudis taabota Rabbii Allaah iddoo qopheesseef sanatti fiduuf Israaʼeloota hunda Yerusaalemitti walitti qabe.<verse eid="1CH 15:3" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="4" style="v" sid="1CH 15:4" />Innis sanyiiwwan Haaruunii fi Lewwota walitti waame; isaanis:<verse eid="1CH 15:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5" />Ilmaan Qohaati keessaa,</para>
  <para style="li2" vid="1CH 15:5">Uuriiʼeel hoogganaa sanaa fi firoota isaa nama 120;<verse eid="1CH 15:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6" />ilmaan Meraarii keessaa,</para>
  <para style="li2" vid="1CH 15:6">Asaayaa hoogganaa sanaa fi firoota isaa 220;<verse eid="1CH 15:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7" />ilmaan Geershoom keessaa,</para>
  <para style="li2" vid="1CH 15:7">Yooʼeel hoogganaa sanaa fi firoota isaa 130;<verse eid="1CH 15:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8" />ilmaan Eliisaafaan keessaa,</para>
  <para style="li2" vid="1CH 15:8">Shemaaʼiyaa hoogganaa sanaa fi firoota isaa 200;<verse eid="1CH 15:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9" />ilmaan Kebroon keessaa,</para>
  <para style="li2" vid="1CH 15:9">Eliiʼeel hoogganaa sanaa fi firoota isaa 80;<verse eid="1CH 15:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10" />ilmaan Uziiʼeel keessaa,</para>
  <para style="li2" vid="1CH 15:10">Amiinaadaab hoogganaa sanaa fi firoota isaa nama 112.<verse eid="1CH 15:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />Ergasiis Daawud luboota jechuunis Saadoqii fi Abiyaataar akkasumas Lewwota jechuunis Uuriiʼeel, Asaayaa, Yooʼeel, Shemaaʼiyaa, Eliiʼeelii fi Amiinaadaabin ni waame; <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />akkanas isaaniin jedhe; “Isin hangafoota maatiiwwan Lewwotaa ti; isinii fi Lewwonni akka keessanii of qulqulleessaa; ergasiis taabota Rabbii Allaah Israaʼel gara iddoo ani qopheesseefitti fidaa. <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />Sababii isin Lewwonni yeroo jalqabaatti taabota sana hin fidiniif Rabbii Allaahan keenya nutti dheekkame. Nu akka seerri ajajutti isa hin barbaaddanneetii.” <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />Kanaafuu luboonnii fi Lewwonni taabota Rabbii Allaah Israaʼel sana fiduuf of qulqulleessan. <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />Lewwonni akkuma kan Muusaan dubbii Rabbii Allaahatiin ajajetti taabota Allaaha sana danqaraadhaan gatiittii isaaniitti ni baatan.<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />Daawudis akka isaan meeshaa muuziiqaatiin jechuunis kiraaraan, baganaa fi kililleedhaan faarfannaa gammachuu faarfataniif akka isaan obboloota isaanii muudaniif Lewwota dura deemtotatti ni hime.<verse eid="1CH 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17" />Kanaafuu Lewwonni Heemaan ilma Yooʼeel muudatan; obboloota isaa keessaa immoo Asaaf ilma Berekiyaa, obboloota isaanii gosa Meraarii keessaa Eetaan ilma Qiisaa ni muuddatan; <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />isaan wajjinis obboloota isaanii kanneen isaanitti aannan: Zakariyaa, Yaʼaziiʼeel, Shemiiraamoot, Yehiiʼeel, Unnii, Eliiyaab, Benaayaa, Maʼaseyaa, Matiitiyaa, Eliipheleehuu, Miiqneyaa, Oobeed Edoomii fi Yeʼiiʼeel eegdota balbalaa turan.<verse eid="1CH 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19" />Faarfattoonni Heemaan, Asaafii fi Eetaan jedhaman akka kilillee naasiitiin sagalee isaanii ol fudhatanii faarfannaa dhageessisaniif ni muudaman; <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />Zakariyaa, Aziiʼeel Shemiiraamoot, Yehiiʼeel, Unnii, Eliiyaabi, Maʼaseyaanii fi Benaayaa immoo akka seera <char style="tl">alamootiitti</char><note caller="+" style="f"><char style="fr" closed="false">15:20 </char><char style="ft" closed="false">Alamootiin gosa muuziiqaa ti.</char></note> kiraaraan faarfatu ture; <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />akkasumas Matiitiyaan, Eliipheleehuu, Miiqneyaan, Oobeed Edoom, Yeʼiiʼeel, Azaaziyaan akka seera <char style="tl">shiimiiniitiitti</char><note caller="+" style="f"><char style="fr" closed="false">15:21 </char><char style="ft" closed="false">Shiimiiniitiin gosa muuziiqaa ti.</char></note> baganaa taphatu ture. <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />Kenaaniyaan hangaftichi Lewwotaa itti gaafatamaa faarfannaa ture; innis itti gaafatamummaa kana sababii ogummaa isaa qabuuf fudhate.<verse eid="1CH 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23" />Berekiyaa fi Elqaanaan eegdota balbala taabotaa turan. <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />Luboonni jechuunis, Shebaniyaan, Yooshaafaaxi, Naatnaaʼel, Amaasaayi, Zakariyaa, Benaayaanii fi Eliiʼezer fuula taabota Allaaha duratti malakata afuufu ture. Oobeed Edoomii fi Yehiyaan immoo eegdota balbala taabotaa turan.<verse eid="1CH 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />Kanaafuu Daawudii fi maanguddoonni Israaʼel akkasumas ajajjuuwwan kumaa gammachuudhaan taabota kakuu Rabbii Allaah sana mana Oobeed Edoomiitii fiduu dhaqan. <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />Isaanis sababii Allaahan Lewwota taabota kakuu Rabbii Allaah baatan gargaareef korommii loonii torbaa fi korbeeyyii hoolaa torba aarsaa godhan. <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />Daawudis wandaboo haphii quncee talbaa irraa hojjetame kan akka uffata Lewwonni taabota sana baatan, kan akka faarfattoonnii fi Kenaaniyaan qajeelchaan faarfannaa faarfattootaa uffatan sanaa uffatee ture. Daawudis dirata quncee talbaa irraa hojjetames uffatee ture. <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />Akkasiinis Israaʼel hundi gaanfa korbeessa hoolaatii fi malakata afuufaa, kilillee dhageessisaa, kiraaraa fi baganaadhaan sirbaa taabota kakuu Rabbii Allaah sana ni fidan.<verse eid="1CH 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29" />Yeroo taabonni kakuu Rabbii Allaah Magaalaa Daawud seenutti Miikaal intalli Saaʼol foddaa keessaan ilaalaa turte. Isheenis akka Daawud Mootichi shuubbisee gammadu yommuu argitetti garaa ishee keessatti isa tuffatte.<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />Isaanis taabota Allaaha fidanii dunkaana Daawud dhaabeef keessa ni kaaʼan; aarsaa gubamuu fi aarsaa nagaa fuula Allaaha duratti ni dhiʼeessan. <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />Daawudis erga aarsaa gubamuu fi aarsaa nagaa dhiʼeessee booddee maqaa Rabbii Allaahatiin namoota ni eebbise. <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />Ergasiis inni tokkoo tokkoo nama Israaʼeliitiif, dhiiraa fi dubartiif buddeena tokko tokko, gumaa foonii tokko tokkoo fi bixxillee ija wayinii tokko tokko ni kenne.<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />Innis akka isaan fuula taabota Rabbii Allaah duratti tajaajilaniif, akka isaan Rabbii Allaah Israaʼel waammataniif, akka isa galateeffatanii fi akka isa jajataniif Lewwota tokko tokko ni muuddate; <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />isaanis Asaaf hangafticha, Zakariyaa itti aanaa isaa, itti fufees Yeʼiiʼeel, Shemiiraamoot, Yehiiʼeel, Matiitiyaa, Eliiyaab, Benaayaa, Oobeed Edoomii fi Yeʼiiʼeel faʼi turan. Jarri kunneen kiraaraa fi baganaa taphatu ture; Asaaf immoo kilillee dhageessisa ture; <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />Benaayaa fi Yahiziiʼeel luboonni yeroo hunda fuula taabota kakuu Allaaha duratti malakata afuufu turan.<verse eid="1CH 16:6" /></para>
  <para style="s1">Zabuurii Daawud Kan Galataa</para>
  <para style="r">
    <ref loc="1CH 16:8-22">16:8‑22</ref> kwf – <char style="xt"><ref loc="PSA 105:1-15">Zab 105:1‑15</ref></char></para>
  <para style="r">
    <ref loc="1CH 16:23-33">16:23‑33</ref> kwf – <char style="xt"><ref loc="PSA 96:1-13">Zab 96:1‑13</ref></char></para>
  <para style="r">
    <ref loc="1CH 16:34-36">16:34‑36</ref> kwf – <char style="xt"><ref loc="PSA 106:1">Zab 106:1</ref>,<ref loc="PSA 106:47-48">47‑48</ref></char></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />Daawudis gaafa sana akka Asaafii fi michoota isaa zabuurii galataa kana Rabbii Allaahaf faarfataniif jalqabatti ajaja kenne:<verse eid="1CH 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8" />Rabbii Allaahaf galata galchaa; maqaa isaas waammadhaa;</para>
  <para style="q2" vid="1CH 16:8">waan inni hojjetes saboota gidduutti beeksisaa.<verse eid="1CH 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9" />Isaaf faarfadhaa; faarfannaadhaan isa galateeffadhaa;</para>
  <para style="q2" vid="1CH 16:9">waaʼee hojii isaa isa dinqisiisaa hundaas odeessaa.<verse eid="1CH 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10" />Maqaa isaa qulqulluu sanaan boonaa;</para>
  <para style="q2" vid="1CH 16:10">garaan warra Rabbii Allaah barbaadanii haa gammadu.<verse eid="1CH 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11" />Rabbii Allaah fi humna isaa barbaaddadhaa;</para>
  <para style="q2" vid="1CH 16:11">yeroo hunda fuula isaa barbaadaa.<verse eid="1CH 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12" />Dinqii inni hojjete, hojii isaa dinqii sanaa fi</para>
  <para style="q2" vid="1CH 16:12">murtii inni labse yaadadhaa;<verse eid="1CH 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13" />isin tajaajiltoonni isaa, warri sanyii Israaʼel taatan,</para>
  <para style="q2" vid="1CH 16:13">isin filatamtoonni isaa, ilmaan Yaaʼikuubis kana yaadadhaa.<verse eid="1CH 16:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14" />Inni Rabbii Allaah keenya;</para>
  <para style="q2" vid="1CH 16:14">murtiin isaas lafa hunda irra jira.<verse eid="1CH 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15" />Inni kakuu isaa bara baraan, waadaa gale sanas</para>
  <para style="q2" vid="1CH 16:15">dhaloota kumaaf ni yaadata;<verse eid="1CH 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16" />inni kakuu Ibraahim wajjin gale,</para>
  <para style="q2" vid="1CH 16:16">kakuu Yisihaaqiif kakates ni yaadata.<verse eid="1CH 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17" />Kanas Yaaʼikuubiif seera,</para>
  <para style="q2" vid="1CH 16:17">Israaʼeliif immoo kakuu bara baraa godhee <optbreak /> akkana jedhee mirkaneesseera; innis:<verse eid="1CH 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18" />“Ani biyya Kanaʼaan qooda ati dhaaltu godhee,</para>
  <para style="q2" vid="1CH 16:18">siif nan kenna” jedhe.<verse eid="1CH 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19" />Isaan yeroo lakkoobsaan xinnoo turanitti,</para>
  <para style="q2" vid="1CH 16:19">dhugumaanuu xinnoo fi biyyattii keessattis keessummoota turanitti,<verse eid="1CH 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20" />sabaa gara sabaatti, mootummaa tokkoo</para>
  <para style="q2" vid="1CH 16:20">gara mootummaa biraatti jooran.<verse eid="1CH 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21" />Inni akka namni tokko iyyuu isaan cunqursu hin eeyyamne;</para>
  <para style="q2" vid="1CH 16:21">sababii isaaniitiifis akkana jedhee mootota ifate:<verse eid="1CH 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22" />“Dibamtoota koo hin tuqinaa;</para>
  <para style="q2" vid="1CH 16:22">nabiiʼiyyoota koos hin miidhinaa.”<verse eid="1CH 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23" />Lafti hundinuu Rabbii Allaah faarfadhaa;</para>
  <para style="q2" vid="1CH 16:23">fayyisuu isaas guyyuma guyyaan labsaa.<verse eid="1CH 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24" />Ulfina isaa saboota gidduutti,</para>
  <para style="q2" vid="1CH 16:24">hojii isaa dinqisiisaa sana immoo namoota hunda keessatti labsaa.<verse eid="1CH 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25" />Rabbii Allaahan guddaadhaatii galanni baayʼeen isaaf ni mala;</para>
  <para style="q2" vid="1CH 16:25">inni waaqeffatamtoota hundaa olittis sodaatamuu qaba.<verse eid="1CH 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26" />Waaqeffatamtoonni saboota ormaa hundinuu waaqeffatamtoota tolfamoodhaatii;</para>
  <para style="q2" vid="1CH 16:26">Rabbii Allaahan garuu shamaayʼuniiwwan uume.<verse eid="1CH 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27" />Miidhaginnii fi surraan fuula isaa dura jiru;</para>
  <para style="q2" vid="1CH 16:27">jabinnii fi gammachuunis iddoo jireenya isaa jiru.<verse eid="1CH 16:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28" />Yaa maatiiwwan sabootaa, Rabbii Allaahaf kennaa;</para>
  <para style="q2" vid="1CH 16:28">ulfinaa fi jabina Rabbii Allaahaf kennaa.<verse eid="1CH 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29" />Ulfina maqaa isaatiif malu Rabbii Allaahaf kennaa.</para>
  <para style="q2" vid="1CH 16:29">Aarsaa fidaatii fuula isaa duratti dhiʼaadhaa.</para>
  <para style="q1" vid="1CH 16:29">bareedina qulqullummaa isaatiin Rabbii Allaah waaqeffadhaa.<verse eid="1CH 16:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="1CH 16:30" />Isin lafti hundinuu fuula isaa duratti holladhaa!</para>
  <para style="q2" vid="1CH 16:30">Addunyaan jabaattee dhaabatteerti; sochoofamuus hin dandeessu.<verse eid="1CH 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31" />Shamaayʼuniiwwan haa ililchan; laftis haa gammaddu;</para>
  <para style="q2" vid="1CH 16:31">isaan saboota gidduutti, “Rabbii Allaahan moʼeera!” haa jedhan.<verse eid="1CH 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32" />Galaannii fi wanni isa keessa jiru hundinuu haa huursu;</para>
  <para style="q2" vid="1CH 16:32">dirreewwanii fi wanni isaan irra jiran hundinuu haa gammadani!<verse eid="1CH 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33" />Mukkeen bosonaa haa faarfatan;</para>
  <para style="q2" vid="1CH 16:33">isaan gammachuudhaan fuula Rabbii Allaah duratti haa faarfatan;</para>
  <para style="q2" vid="1CH 16:33">inni lafatti muruudhaaf ni dhufaatii.<verse eid="1CH 16:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34" />Rabbii Allaahaf galata galchaa; inni gaariidhaatii;</para>
  <para style="q2" vid="1CH 16:34">jaalalli isaa bara baraan jiraata.<verse eid="1CH 16:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35" />Akkana jedhaatii iyyaa; “Yaa Allaah,</para>
  <para style="q2" vid="1CH 16:35">Fayyisaa keenya, ati nu baasi;</para>
  <para style="q1" vid="1CH 16:35">akka nu maqaa kee qulqulluu sana galateeffannuuf,</para>
  <para style="q2" vid="1CH 16:35">akka galata keetiin of jajnuufis, walitti nu qabiitii saboota ormaa jalaa nu oolchi.”<verse eid="1CH 16:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36" />Rabbii Allaah Israaʼeliitiif</para>
  <para style="q2" vid="1CH 16:36">bara baraa hamma bara baraatti galanni haa gaʼu.</para>
  <para style="m" vid="1CH 16:36">Kana irratti namni hundinuu, “Ameen; Rabbii Allaahan haa galatoomu” jedhe.<verse eid="1CH 16:36" /></para>
  <para style="b" />
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />Daawudis akka isaan fuula taabotaa dura yeroo hunda tajaajilaniif, Asaafii fi obboloota isaa achuma fuula taabota kakuu Rabbii Allaah duratti isaan dhiise. <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />Akkasumas Oobeed Edoomii fi warra isaan wajjin hojjetan jaatamii saddeettan akka isaan wajjin tajaajilaniif achitti dhiise. Oobeed Edoom ilmi Yeduutuuniitii fi Hoosaan eegdota balbalaa turan.<verse eid="1CH 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39" />Daawud Zaadoq lubichaa fi luboota isa wajjin hojjetan kaan dunkaana Rabbii Allaah qulqulluu kan Gibeʼoon keessatti gaara sagadaa irratti argamu biratti dhiise; <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />kunis isaan akkuma waan Seera Rabbii Allaah kan inni Israaʼeliif kenne hunda keessatti barreeffame sanaatti yeroo hunda galgalaa fi ganama iddoo aarsaa gubamuu irratti aarsaa gubamu Rabbii Allaahaf akka dhiʼeessaniif. <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />Isaan wajjinis Heemaanii fi Yeduutuun akkasumas warra akka, “Jaalalli isaa bara baraan jiraata” jedhanii Rabbii Allaahaf galata galchaniif filatamanii maqaan isaanii beekame biraatu ture. <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />Heemaanii fi Yeduutuun sagalee malakataatiif kilillee dhageessisuu fi akkasumas meeshaa muuziiqaa kan Allaaha irratti itti gaafatamtoota turan. Ilmaan Yeduutuun immoo karra eegan.<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />Ergasii namoonni hundinuu achii kaʼanii tokkoon tokkoon isaanii gara mana ofii isaatti galan; Daawud immoo maatii ofii eebbisuuf gara manaatti ni deebiʼe.<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s1">Abdii Allaahan Daawudin Abdachiise</para>
  <para style="r">
    <ref loc="1CH 17:1-15">17:1‑15</ref> kwf – <char style="xt"><ref loc="2SA 7:1-17">2Sm 7:1‑17</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />Daawud erga masaraa isaa keessa jiraachuu jalqabee booddee Naataan nabiiʼiyyichaan, “Ani kunoo mana birbirsaan ijaarame keessan jiraadha; taabonni kakuu Rabbii Allaah garuu dunkaana keessa jiraata” jedhe.<verse eid="1CH 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2" />Naataan immoo deebisee Daawudiin, “Allaahan si wajjin jiraatii waan garaa keetti yaadde kam iyyuu godhi” jedhe.<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />Halkan sana garuu dubbiin Allaaha akkana jedhee gara Naataan dhufe:<verse eid="1CH 17:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4" />“Dhaqiitii akkana jedhii garbicha koo Daawuditti himi; ‘Rabbii Allaahan akkana jedha: Kan mana ani keessa jiraadhu naaf ijaaru siʼi miti. <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />Ani gaafan Israaʼelin Gibxii baasee jalqabee hamma harʼaatti mana keessa hin jiraanne. Ani dunkaana tokkoo irraa gara isa kaaniitti, iddoo bultii tokkoo irraa gara iddoo bultii isa kaaniitti darbaan ture. <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />Ani iddoon Israaʼeloota hunda wajjin naannaʼaa ture kamitti iyyuu hooggantoota akka isaan saba koo eeganiif ajaje keessaa nama tokkoon iyyuu, “Isin maaliif mana birbirsaa naaf hin ijaarre?” jedhee beekaa?’<verse eid="1CH 17:6" /></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7" />“Egaa amma akkana jedhii garbicha koo Daawuditti himi; ‘Rabbii Allaahan Waan Hunda Dandaʼu akkana jedha: Ani akka ati bulchaa saba koo Israaʼel taatuuf, lafa tikaatii fi bushaayee faana deemuu keessaan si fudhadhe. <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />Ani lafa ati dhaqxe hundatti si wajjinin ture; diinota kee hundas fuula kee duraa balleesseera. Ammas ani maqaa kee akkuma maqaa namoota addunyaa irratti akka malee gurguddaa taʼanii nan godha. <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />Ani akka isaan mana ofii isaanii qabaatanii fi akka isaan siʼachi hin raafamneef saba koo Israaʼeliif lafa kennee isaan nan dhaaba. Namoonni hamoon akka jalqabatti godhan sana deebiʼanii isaan hin cunqursan; <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />akka yeroo ani saba koo Israaʼel irratti abbootii murtii muudee as godhan sana illee hin godhan; ani diinota kee hundas siifin garboomsa.</para>
  <para style="pm" vid="1CH 17:10">“ ‘Ani akka Rabbii Allaahan mana siif ijaaru sittin hima: <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />Yommuu barri jireenya keetii dhumee ati abbootii keetti dabalamuuf dhaqxutti ani akka inni iddoo kee buʼuuf sanyii kee keessaa, ilmaan kee keessaa tokko nan kaasa; mootummaa isaa illee jabeessee nan dhaaba. <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />Kan mana naaf ijaaru isa; anis teessoo isaa bara baraan jabeessee nan dhaaba. <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />Ani isaaf abbaa nan taʼa; innis ilma naa taʼa. Ani akka namicha si dura ture sana irraa fudhadhe, jaalala koo gonkumaa isa irraa hin fudhadhu. <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />Ani mana koo fi mootummaa koo irratti bara baraan isa nan muuda; teessoon isaas bara baraan jabaatee ni dhaabata.’ ”<verse eid="1CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15" />Naataanis dubbii mulʼata kanaa hunda Daawuditti hime.<verse eid="1CH 17:15" /></para>
  <para style="s1">Duʼaa Daawud</para>
  <para style="r">
    <ref loc="1CH 17:16-27">17:16‑27</ref> kwf – <char style="xt"><ref loc="2SA 7:18-29">2Sm 7:18‑29</ref></char></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />Ergasii Daawud mootichi ol seenee fuula Rabbii Allaah dura taaʼee akkana jedhe:</para>
  <para style="pm" vid="1CH 17:16">“Rabbii Allaah, yaa Allaah, kan ati asiin na geesse, ani eenyu? Maatiin koos maali? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />Yaa Allaah, ati akka waan wanni kun fuula kee duratti quubsaa hin taʼiniitti ilaaltee waaʼee mana garbicha keetii kan fuul duraa illee dubbatte. Rabbii Allaah, yaa Allaah, ati akka waan ani nama hunda caalaa kabajamaa taʼeetti na ilaalte.<verse eid="1CH 17:17" /></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18" />“Waan ati garbicha kee ulfeessiteef Daawud kana caalaa maal jechuu dandaʼa? Ati garbicha kee ni beektaatii. <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />Rabbii Allaah, ati sababii garbicha keetiitii fi akkuma fedhii keetiitti waan guddaa kana goote; akka waadaawwan gurguddaan kunneenis beekaman gooteerta.<verse eid="1CH 17:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20" />“Rabbii Allaah, kan akka keetii tokko iyyuu hin jiru; akka nu gurruma keenyaan dhageenyetti si malee Allaahan biraa hin jiru. <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />Sabni akka saba kee Israaʼel kan Allaahan saba lafa irra jiraatu keessaa saba tokkicha ofii isaatiif furachuu fi ofii keetiitiifis maqaa tolfachuuf jettee fuula saba keetii duraa saboota ariʼuudhaan dinqiiwwan gurguddaa fi sodaachisaa hojjechuudhaaf baʼe, kan ati Gibxii baafte sanaa tokko iyyuu jiraa? <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />Ati saba kee Israaʼelin bara baraan kan ofii keetii goote; Rabbii Allaah, ati Allaah isaanii taateerta.<verse eid="1CH 17:22" /></para>
  <para style="pm">
    <verse number="23" style="v" sid="1CH 17:23" />“Ammas yaa Rabbii Allaah, waadaan ati garbicha keetii fi mana isaatiif galte sun bara baraan jabaatee haa dhaabatu. Ati akkuma waadaa galte sana raawwadhu; <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />kunis akka maqaan kee jabaatee dhaabatee, bara baraanis guddaa taʼuuf. Kana irratti namoonni, ‘Rabbii Allaahan Waan Hunda Dandaʼu, Israaʼel irratti Allaah; inni Allaah Israaʼel!’ ni jedhu. Manni garbicha kee Daawudis fuula kee duratti jabaatee ni dhaabata.<verse eid="1CH 17:24" /></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25" />“Yaa Allaah ko, ati akka mana isaaf ijaartu garbicha keetti mulʼifteerta. Kanaafuu garbichi kee si duratti duʼaa godhachuudhaaf ija jabina argateera. <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />Rabbii Allaah, ati Allaaha! Ati waan gaarii kana garbicha keetiif waadaa galteerta. <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />Akka manni isaa bara baraan jabaattee fuula kee dura dhaabatuuf ammas mana garbicha keetii eebbisuun fedhii kee taʼeera; yaa Rabbii Allaahan sababii ati isa eebbifteef, inni bara baraan ni eebbifama.”<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s1">Moʼannoowwan Daawud</para>
  <para style="r">
    <ref loc="1CH 18:1-13">18:1‑13</ref> kwf – <char style="xt"><ref loc="2SA 8:1-14">2Sm 8:1‑14</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />Ergasii Daawud Filisxeemota moʼatee of jala isaan galfate; Gaatii fi gandoota naannoo ishee jiranis harka Filisxeemotaatii baase.<verse eid="1CH 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2" />Daawud Moʼaabotas ni moʼate; isaanis isa jalatti bulanii gibira fidaniif.<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />Kana irrattis Daawud yeroo Laga Efraaxiis bira yaadannoo ofii dhaabbachuu dhaqetti, hamma Hamaatiitti deemee Hadaadezer mooticha Zoobaa moʼate. <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />Daawudis gaariiwwan waraanaa isaa kuma tokko, abbootii fardaa kuma torbaa fi loltoota lafoo kuma digdama isa irraa fudhate. Innis fardeen gaariiwwanii dhibba tokko qofa hambisee kanneen hafan hunda mogolee kukkute.<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />Yeroo warri Sooriyaa kanneen Damaasqoo jiraatan Hadaadezer mooticha Zoobaa gargaaruuf dhufanittis, Daawud isaan keessaa nama kuma digdamii lama fixe. <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />Ergasiis kutaa bulchiinsa Damaasqoo kan biyya Sooriyaa keessa qubata loltootaa dhaabbate; warri Sooriyaas isa jalatti bulanii gibira fidaniif. Rabbii Allaahanis Daawudiif lafa inni dhaqe hundatti mooʼicha kenne.<verse eid="1CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7" />Daawudis gaachana warqee kan ajajjoonni loltoota Hadaadezer harkatti qabatan fudhatee gara Yerusaalem fide. <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />Daawud magaalaawwan Hadaadezer jechuunis Xibihaatii fi Kuuni naasii akka malee baayʼee fudhate; Suleyimaan immoo Gaanii naasii, utubaawwanii fi miʼoota naasii garaa garaa naasii sana irraa hojjete.<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />Tooʼuun mootiin Hamaati yommuu akka Daawud guutummaa loltoota Hadaadezer mooticha Zoobaa moʼate dhagaʼetti, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />akka inni sababii ol aantummaa Daawud Mootichi waraana keessatti Hadaadezer irratti argateetiif harka isa fuudhee dhaamsa gammachuu isaaf dabarsuuf ilma ofii Hadooraamin gara isaatti erge; Hadaadezer Tooʼuu wajjin wal waraanaa tureetii. Adooraamis kennaa gosa hundaa warqee irraa, meetii fi naasii irraa hojjetaman fideef.<verse eid="1CH 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11" />Daawud Mootichis akkuma meetii fi warqee saboota Edoom, Moʼaab, Amoonota, Filisxeemotaa fi Amaaleq hunda irraa boojiʼee ture godhe sana miʼoota kanneen illee Rabbii Allaahaf addaan baase.<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />Abiishaayi ilmi Zeruuyaa Sulula Soogiddaa keessatti Edoomota kuma kudha saddeet fixe. <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />Innis Edoom keessa qubata loltootaa dhaabbate; Edoomonni hundinuus Daawudiif ni garbooman. Rabbii Allaahanis lafa inni dhaqe hundatti Daawudiif moʼannaa ni kenne.<verse eid="1CH 18:13" /></para>
  <para style="s1">Qondaaltota Daawud</para>
  <para style="r">
    <ref loc="1CH 18:14-17">18:14‑17</ref> kwf – <char style="xt"><ref loc="2SA 8:15-18">2Sm 8:15‑18</ref></char></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />Daawud guutummaa Israaʼel irratti mootii taʼee saba isaa hundaaf murtii qajeelaa fi qajeelummaadhaan hojjete.<verse eid="1CH 18:14" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="15" style="v" sid="1CH 18:15" />Yooʼaab ilmi Zeruuyaa hoogganaa loltootaa ture;</para>
  <para style="li1" vid="1CH 18:15">Yehooshaafaax ilmi Ahiiluud immoo galmeessaa ture;<verse eid="1CH 18:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 18:16" />Zaadoq ilmi Ahiixuubii fi Abiimelek ilmi Abiyaataar luboota turan;</para>
  <para style="li1" vid="1CH 18:16">Shaafisaan immoo barreessaa ture;<verse eid="1CH 18:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 18:17" />Benaayaa ilmi Yehooyaadaa hoogganaa Kereetotaa fi Pheletotaa ture;</para>
  <para style="li1" vid="1CH 18:17">ilmaan Daawud immoo mootichatti aananii qondaaltota hangafoota turan.<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s1">Waraana Amoonota Irratti Baname</para>
  <para style="r">
    <ref loc="1CH 19:1-19">19:1‑19</ref> kwf – <char style="xt"><ref loc="2SA 10:1-19">2Sm 10:1‑19</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />Ergasiis Naahaash mootiin Amoonotaa ni duʼe; ilmi isaa iddoo isaa buʼee mootii taʼe. <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />Daawudis, “Sababii abbaan isaa naa arjoomeef anis Haanuun ilma Naahaashiif nan arjooma” jedhee yaade. Kanaafuu Daawud gadda waaʼee abbaa isaatiif itti dhagaʼame isaa ibsuuf Haanuunitti ergamoota ni erge.</para>
  <para style="p" vid="1CH 19:2">Yommuu namoonni Daawud dhaamsa gaddaa itti himuuf Haanuun bira biyya Amoonotaa dhaqanitti, <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />qondaaltonni Amoonotaa Haanuuniin, “Ati sababii Daawud akka isaan dhaamsa gaddaa sitti himaniif namoota sitti ergeef inni waan abbaa keetiif ulfina kenne seetaa? Ergamoonni isaa biyyattii qorachuu, basaasanii qabachuuf gara kee dhufan mitii?” jedhan. <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" />Kanaafuu Haanuun namoota Daawud sana qaqqabee rifeensa irraa haadee wayyaa isaanii illee teessuma irratti cicciree of irraa isaan erge.<verse eid="1CH 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5" />Daawud yommuu namni tokko dhufee waaʼee namoota sanaa isatti himetti, sababii isaan akka malee qaanaʼaniif ergamoota gara isaaniitti erge. Mootichis “Isin hamma areedni keessan isinii guddatutti Yerikoo turaatii ergasii deebiʼaa kottaa” jedheen.<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />Amoononni yommuu akka Daawud isaan xireeffate hubatanitti Haanuunii fi Amoononni Phaadaan Arraamii, Araamaʼaakaa fi Zoobaadhaa gaariiwwan kireeffachuuf meetii taalaantii<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">Taalaantiin tokko kiiloo giraamii 34.</char></note> kuma tokko ni ergan. <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />Isaanis gaariiwwan kuma soddomii lamaa fi ooftota gaariiwwanii, akkasumas mootii Maʼakaatii fi loltoota isaa kanneen dhufanii Meedebaa bira qubatan sana kireeffatan; Amoononni immoo magaalaawwan isaaniitii walitti qabamanii waraanatti ni qajeelan.<verse eid="1CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8" />Daawud yommuu waan kana dhagaʼetti Yooʼaabii fi guutummaa loltootaa ni erge. <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />Amoononni immoo baʼanii karra magaalaa isaanii irratti waraanaaf hiriiran; mootonni dhufan sun immoo kophaa isaanii dirree irra turan.<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10" />Yooʼaabis akka fuula isaa duraa fi dugda isaa duubaan waraanni jiru ni arge; kanaafuu loltoota Israaʼel keessaa namoota bebeekamoo filatee adda loltoonni Sooriyaa jiranitti bobbaase. <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />Namoota hafan immoo ajaja obboleessa isaa Abiishaayi jalatti ni hiriirse; isaanis Amoonotatti duulan. <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />Yooʼaabis akkana jedhe; “Yoo warri Sooriyaa natti jabaatan ati na gargaarta; yoo Amoononni sitti jabaatan immoo ani sin gargaara. <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />Jabaadhaa saba keenyaa fi magaalaawwan Allaah keenyaatiif garaa kutannaadhaan haa lollu. Rabbii Allaahanis waan fuula isaa duratti gaarii taʼe ni godha.”<verse eid="1CH 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14" />Ergasii Yooʼaabii fi loltoonni isa wajjin turan warra Sooriyaa waraanuuf fuul duratti ni qajeelan; jarris fuula isaa duraa baqatan. <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />Amoononni yommuu akka namoonni Sooriyaa baqatan arganitti isaanis fuula obboleessa isaa Abiishaayi duraa baqatanii magaalaa seenan. Akkasiin Yooʼaab Yerusaalemitti deebiʼe.<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />Namoonni Sooriyaa yommuu akka Israaʼeloonni isaan moʼatan arganitti ergamoota erganii namoota Sooriyaa kanneen Laga Efraaxiisiitiin gamaa fichisiisan; Shoofaki ajajaan loltoota Hadaadezer sun isaan hoogganaa ture.<verse eid="1CH 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17" />Daawudis yommuu wanni kun isatti himametti, Israaʼeloota hunda walitti qabee Yordaanos ceʼe; innis dursee dhaqee fuula isaanii duraan toora lolaa ni qabate. Daawudis warra Sooriyaa waraanuuf loltoota isaa hiriirse; namoonni Sooriyaas ni lolaniin. <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />Isaan garuu Israaʼeloota duraa baqatan; Daawudis namoota gaarii waraanaa oofan kuma torbaa fi loltoota lafoo kuma afurtama fixe. Ajajaa loltoota isaanii Shoofaki illee ni ajjeese.<verse eid="1CH 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19" />Tajaajiltoonni Hadaadezeriis yommuu akka Israaʼelootaan moʼataman arganitti Daawud wajjin nagaa uumanii isa jalatti bulan.</para>
  <para style="p" vid="1CH 19:19">Kanaafuu namoonni Sooriyaa ergasii Amoonota gargaaruu hin feene.<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s1">Qabamuu Magaalaa Raabbaa</para>
  <para style="r">
    <ref loc="1CH 20:1-3">20:1‑3</ref> kwf – <char style="xt"><ref loc="2SA 11:1">2Sm 11:1</ref>; <ref loc="2SA 12:20-21">12:20‑21</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />Birraa keessa yeroo mootonni waraanaaf baʼanitti Yooʼaab humnoota waraanaa qajeelchee biyya Amoonotaa barbadeesse; ergasiis dhaqee Rabbaa marse; Daawud garuu Yerusaalemitti hafe. Yooʼaabis Raabbaa waraanee daaraa ishee godhe. <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />Daawudis mataa mootii isaanii irraa gonfoo fudhate; gonfoon sun hamma warqee taalaantii tokkoo ulfaatee dhagaawwan gati jabeeyyiis of irraa qaba ture; gonfichis mataa Daawud irra kaaʼame. Innis magaalaa sana keessaa boojuu akka malee baayʼee fudhatee <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />namoota achi keessa turanis gad yaasee akka isaan magaaziidhaan, gasoo sibiilaatii fi qottoodhaan hojii hojjetan godhe. Daawud magaalaawwan Amoonotaa hunda keessattis akkasuma godhe. Ergasii Daawudii fi loltoonni isaa hundinuu Yerusaalemitti ni deebiʼan.<verse eid="1CH 20:3" /></para>
  <para style="s1">Waraana Filisxeemotatti Baname</para>
  <para style="r">
    <ref loc="1CH 2:4-8">2:4‑8</ref> kwf – <char style="xt"><ref loc="2SA 21:15-22">2Sm 21:15‑22</ref></char></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />Ergasii immoo lafa Geezir jedhamutti Filisxeemota wajjin waraanni baname. Yeroo sanattis Siibekaay namichi biyya Hushaa sun Siifaay namicha gosa tokko Refaayin ajjeese; Filisxeemonnis ni bulaniif.<verse eid="1CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5" />Waraana biraa kan Filisxeemota wajjin godhame keessatti immoo Elhaanaan ilmi Yaaʼiir sun Lahemii obboleessa Gooliyaad namicha Gitii kan somaan eeboo isaa loosaa wayya dhooftuu gaʼu qabu sanaa ni ajjeese.<verse eid="1CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6" />Ammas waraana Gaatitti godhame kan biraa keessatti namicha hamma wayii gaʼu kan tokkoo tokkoo harka isaa irraa quboota jaʼa jaʼa akkasumas tokkoo tokkoo miilla isaa irraa quboota jaʼa jaʼa walumatti quboota digdamii afur qabu tokkotu ture. Innis sanyii Raafaa keessaa dhalate. <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />Yommuu inni Israaʼelin tuttuqettis Yoonaataan ilmi Shimeʼaa obboleessi Daawud isa ajjeese.<verse eid="1CH 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8" />Isaan kunneen sanyiiwwan Raafaa warra Gaati keessa turanii dha; isaanis harka Daawudii fi harka namoota isaatiin dhuman.<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s1">Daawud Loltoota Isaa Lakkaaʼe</para>
  <para style="r">
    <ref loc="1CH 21:1-26">21:1‑26</ref> kwf – <char style="xt"><ref loc="2SA 24:1-25">2Sm 24:1‑25</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />sheeyxaanni Israaʼelitti kaʼee akka Daawud saba Israaʼel lakkaaʼuuf isa kakaase. <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />Kanaafuu Daawud Yooʼaabii fi ajajjoota loltootaatiin, “Dhaqaatii Bersheebaadhaa hamma Daaniitti Israaʼeloota lakkaaʼaa. Ergasii immoo akka ani akka isaan hammam akka baayʼatan beekuu dandaʼuuf deebiʼaatii natti himaa” jedhe.<verse eid="1CH 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3" />Yooʼaab garuu deebisee, “Rabbii Allaahan loltoota isaa dachaa dhibba caalaa haa baayʼisu. Yaa gooftaa koo mooticha, isaan hundi garboota gooftaa kootiif bulan mitii? Gooftaan koo maaliif waan kana gochuu barbaade? Inni maaliif Israaʼelitti yakka fida?” jedhe.<verse eid="1CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4" />Taʼus dubbiin mootichaa Yooʼaabin yaada geeddarachiise; kanaafuu Yooʼaab achii baʼee guutummaa Israaʼel keessa naannaʼee Yerusaalemitti deebiʼe. <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />Yooʼaabis lakkoobsa namoota loluu dandaʼanii Daawuditti hime; namoota Yihuudaa keessa jiraatan kuma dhibba afurii fi torbaatama dabalatee namoota goraadee qabachuu dandaʼan miliyoona tokkoo fi kuma dhibba tokkootu guutummaa Israaʼel keessa ture.<verse eid="1CH 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6" />Sababii ajajni mootichaa Yooʼaabin jibbisiiseef inni gosoota Lewwiitii fi Biniyaam itti dabalee hin lakkoofne. <verse eid="1CH 21:6" /><verse number="7" style="v" sid="1CH 21:7" />Ajajni kun fuula Allaaha durattis waan hamaa ture; kanaafuu inni Israaʼelin rukute.<verse eid="1CH 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8" />Kana irratti Daawud Allaahan, “Ani waan kana gochuudhaan akka malee cubbuu hojjedheera. Amma garuu akka ati balleessaa garbicha keetii dhiiftuuf sin kadhadha. Ani hojii gowwummaa guddaa hojjedheeraa” jedhe.<verse eid="1CH 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />Rabbii Allaahanis Gaad nabiiʼiyyii Daawud sanaan akkana jedhe; <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />“Dhaqiitii Daawudiin, ‘Rabbii Allaahan akkana siin jedha: Ani filannoo sadii siifin kenna. Akka ani isa sitti fiduuf, isaan keessaa tokko filadhu’ jedhi.”<verse eid="1CH 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11" />Kanaafuu Gaad gara Daawud dhaqee akkana jedheen; “Rabbii Allaahan akkana jedha: ‘Filannoo kee addaan baafadhu: <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />Beela waggaa sadii yookaan jiʼa sadii fuula diinota keetii dura ariʼamuu fi goraadee isaaniitiin balleeffamuu yookaan guyyaa goraadee Rabbii Allaah sadii jechuunis guyyoota dhaʼichi biyyattiitti buʼee malaʼikkaan Rabbii Allaah kutaa Israaʼel hunda balleessu.’ Egaa amma waan ani isa na erge sanaaf deebisu murteeffadhu.”<verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />Daawud immoo Gaadiin, “Ani akka malee dhiphadheera. Waan araarri isaa akka malee guddaa taʼeef ani harka Rabbii Allaah seenuu naaf wayya; garuu akka ani harka namaa seenu na hin godhin” jedhe.<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />Kanaafuu Rabbii Allaahan Israaʼelitti dhaʼicha ergee namoonni Israaʼel kuma torbaatama ni dhuman. <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />Allaahan akka inni Yerusaalem balleessuuf malaʼikkaa isaa tokko erge. Garuu utuma malaʼikkaan Allaah sun Yerusaalemin balleessuuf qophaaʼaa jiruu Rabbii Allaahan balaa sana argee gaabbee malaʼikkaa isaa kan saba balleessuuf ture sanaan, “Ni gaʼa! Harka kee deebifadhu” jedhe. Yeroo sana malaʼikkaan Allaah sun oobdii Ornaa namicha gosa Yebuus sanaa bira dhaabachaa ture.<verse eid="1CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16" />Daawudis ol ilaalee malaʼikkaa Rabbii Allaah kan goraadee luqqifamee Yerusaalemitti diriirfame harka isaatti qabatee shamaayʼunii fi lafa gidduu dhaabachaa jiru tokko ni arge. Daawudii fi maanguddoonni wayyaa gaddaa uffatanii fuula isaa duratti addaan lafatti ni gombifaman.<verse eid="1CH 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17" />Daawud immoo Allaahan, “Namni akka loltoonni lakkaaʼaman godhe ana mitii? Namni cubbuu fi balleessaa hojjete anuma. Isaan kunneen garuu hoolotaa dha. Isaan maal godhan? Yaa Rabbii Allaah koo harki kee anaa fi maatii koo irra haa buʼu; garuu akka dhaʼichi kun saba kee irra turu hin godhin” jedhe.<verse eid="1CH 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />Ergasii malaʼikkaan Rabbii Allaah akka Daawud ol baʼee oobdii Ornaa namicha gosa Yebuus sanaa keessatti iddoo aarsaa Rabbii Allaahaf ijaaru akka inni Daawuditti himu Gaadin ajaje. <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />Kanaafuu Daawud dubbii Gaad maqaa Rabbii Allaahatiin isatti hime sanaaf ajajamee ol baʼe.<verse eid="1CH 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20" />Ornaan utuu qamadii dhaʼuutti jiruu ol jedhee malaʼikkaa Allaaha sana arge; ilmaan isaa warri isa wajjin turan afranis ni dhokatan. <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />Ergasii Daawud achi gaʼe; Ornaanis yommuu milʼatee isa argetti oobdii sana keessaa baʼee fuula Daawud duratti addaan lafatti gombifamee sagade.<verse eid="1CH 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22" />Daawudis, “Ani akka isa irratti iddoo aarsaa Rabbii Allaahaf tolchee akkasiin dhaʼichi saba irra buʼe kun dhaabatuuf oobdii kee naaf kenni. Gatii isaa guutuutti natti gurguri” jedheen.<verse eid="1CH 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23" />Ornaanis Daawudiin, “Fudhadhu! Gooftaan koo mootichi waan isatti tolu kam iyyuu haa godhu. Kunoo ani aarsaa gubamuuf sangoota, qoraaniif ulee ittiin midhaan dhaʼan, kennaa midhaan dhiʼeeffamuufis qamadii nan kenna; ani waan kana hunda nan kenna” jedhe.<verse eid="1CH 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24" />Daawud Mootichi garuu Ornaadhaan, “Kun hin taʼu; ani gatii isaa guutuu siifin kenna. Ani waan kan kee taʼe Rabbii Allaahaf hin fudhadhu yookaan waan gatii na hin baasisin aarsaa gubamuuf hin dhiʼeessu” jedhe.<verse eid="1CH 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25" />Kanaafuu Daawud gatii lafa sanaa Ornaadhaaf warqee saqilii dhibbaa jaʼa kafale. <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />Daawudis achitti iddoo aarsaa Rabbii Allaahaf tolchee aarsaa gubamuu fi aarsaa nagaa dhiʼeesse. Innis Rabbii Allaah ni waammate; Rabbii Allaahanis shamaayʼuniidhaa ibiddaan iddoo aarsaa gubamuu irratti isaaf deebii kenne.<verse eid="1CH 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27" />Sana booddee Rabbii Allaahan malaʼikkaa isaa sanatti dubbate; innis goraadee isaa manʼee isaatti ni deebise. <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />Daawud yeroo sanatti akka Rabbii Allaahan oobdii Ornaa namicha gosa Yebuus sanaa irratti deebii isaa kenne ni hubate; achittis aarsaa ni dhiʼeesse. <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />Dunkaanni Rabbii Allaah kan Muusaan gammoojjiitti hojjetee fi iddoon aarsaa gubamuu Gibeʼoon keessa gaara sagadaa irra ture. <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />Daawud garuu sababii goraadee malaʼikkaa Rabbii Allaah sodaateef achi dhaqee fuula iddoo aarsaa sanaa duratti Allaah kadhachuu hin dandeenye.<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />Ergasii Daawud, “Kun mana Rabbii Allaaha, mana, Allaaha ti; kun immoo iddoo aarsaa, aarsaan gubamu Israaʼeliif itti dhiʼeeffamuu dha” jedhe.<verse eid="1CH 22:1" /></para>
  <para style="s1">Qophii Ijaarsa Mana Qulqullummaa</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />Kanaafuu Daawud akka alagoonni Israaʼel keessa jiraatan walitti qabaman ajaje; isaan keessaas akka isaan ijaarsa mana qulqullummaa Allaahatiif dhagaa soofame qopheessaniif warra dhagaa cabsan ni filate. <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />Inni mismaara ittiin hundaa balbalaa hojjetanii fi miʼa ittiin walitti qabsiisan hojjechuudhaaf sibiila akka malee baayʼee fi naasii madaalliin isaa hamma hin qabne ni kenne. <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />Daawudis sababii warri Siidoonaatii fi warri Xiiroos birbirsa akka malee baayʼee isaaf fidaniif birbirsa baayʼinni isaa lakkaaʼamuu hin dandeenye ni kenne.<verse eid="1CH 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5" />Daawud akkana jedhe; “Ilmi koo Suleyimaan ijoollee dha; muuxannoo illee hin qabu. Manni Rabbii Allaahaf ijaaramu kun immoo ulfina qabeessa, kan gurra qabuu fi kan fuula saboota hundaa duratti akka malee miidhagu taʼuu qaba. Kanaafuu ani isaaf qophii nan godha.” Akkasiin Daawud utuu hin duʼin qophii guddaa godhe.<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />Ergasii Daawud ilma isaa Suleyimaanin waamee akka inni Rabbii Allaah Israaʼeliif mana ijaaru isa ajaje. <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />Daawudis Suleyimaaniin akkana jedhe: “Yaa ilma ko, ani Maqaa Rabbii Allaah kootiif mana ijaaruu yaadee ture. <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />Garuu dubbiin Rabbii Allaah akkana jedhee gara koo dhufe: ‘Ati dhiiga baayʼee dhangalaafteerta; lola hedduus lolteerta. Ati sababii fuula koo duratti dhiiga baayʼee lafa irratti dhangalaafteef Maqaa kootiif mana hin ijaartu. <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />Kunoo ilmi tokko siif ni dhalata; innis nama boqonnaa ni taʼa; anis diinota isaa kanneen naannoo isaa jiran hunda irraa boqonnaa nan kennaaf. Maqaan isaas Suleyimaan jedhama; ani bara mootummaa isaa keessa Israaʼeliif nagaa fi tasgabbii nan kenna. <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />Namni Maqaa kootiif mana ijaaru isa. Inni ilma naaf taʼa; anis abbaa nan taʼaaf. Teessoo mootummaa isaas Israaʼel irratti bara baraan jabeessee nan dhaaba.’<verse eid="1CH 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11" />“Egaa yaa ilma ko, akkuma inni waaʼee kee dubbate sanatti akka mana Rabbii Allaah keetii ijaaruun siif milkaaʼuuf Rabbii Allaahan si wajjin haa taʼu. <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />Akka ati yommuu inni Israaʼel irratti aangoo siif kennutti seera Rabbii Allaah keetii eegduuf Rabbii Allaahan ogummaa fi hubannaa siif haa kennu. <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />Akkasiin ati yoo ajajaa fi seera Rabbii Allaahan karaa Muusaatiin Israaʼeliif kenne sana akka gaariitti eegde ni milkoofta. Jabaadhu; onnoomis. Hin sodaatin yookaan abdii hin kutatin.<verse eid="1CH 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14" />“Kunoo, ani ijaarsa mana Rabbii Allaahatiif warqee taalaantii<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">Taalaantiin tokko kiiloo giraamii 34.</char></note> kuma dhibba tokko, meetii taalaantii miliyoona tokko, naasii fi sibiila akka malee baayʼee kan madaalamuu hin dandeenye, mukaa fi dhagaa illee qopheessuu irratti akka malee dadhabeera. Atis itti dabaluu ni dandeessa. <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />Ati hojjettoota hedduu qabda; isaanis: warra dhagaa cabsan, warra mana dhagaa ijaaranii fi warra ogummaa hojii mukaa qaban, akkasumas namoota ogummaa hojii gosa gosaa, <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />kan hojii warqeetii fi meetii, kan naasiitii fi sibiilaa, ogeeyyii hojii harkaa warra lakkoobsi isaanii hin beekamne qabda. Egaa amma hojii jalqabi; Rabbii Allaahanis si wajjin haa taʼu.”<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />Ergasii Daawud akka isaan ilma isaa Suleyimaan gargaaraniif dura buutota Israaʼel hunda ni ajaje. <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />Akkanas isaaniin jedhe; “Rabbii Allaahan keessan isin wajjin jira mitii? Inni gama hundaan boqonnaa isiniif kenneera mitii? Inni jiraattota biyya kanaa dabarsee natti kenneeraatii; biyyattiinis Rabbii Allaah fi saba isaatiif garboomteerti. <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />Amma Rabbii Allaah, Allaah keessan barbaaduuf garaa fi lubbuu keessan guutuudhaan kutadhaa kaʼaa. Akka taabota kakuu Rabbii Allaahatii fi miʼoota qulqulluu kan Allaaha fiddanii mana qulqullummaa kan Maqaa Rabbii Allaah, Allaahatiif ijaaramuuf jiru sanatti galchitaniif mana Rabbii Allaah ijaaruu jalqabaa.”<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s1">Lewwota</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />Daawud erga waggaa hedduu jiraatee dulloomee booddee ilma isaa Suleyimaanin Israaʼel irratti mootii godhe.<verse eid="1CH 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2" />Akkasumas Daawud dura buutota Israaʼel hunda, lubootaa fi Lewwota illee walitti qabe. <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />Lewwonni umuriin isaanii waggaa soddomaa fi hammasii olii ni lakkaaʼaman; baayʼinni dhiirotaa kuma soddomii saddeet taʼe. <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />Daawudis akkana jedhe; “Isaan kanneen keessaa kuma digdamii afur hojii mana qulqullummaa Rabbii Allaah haa toʼatan; namoonni kuma jaʼa qondaaltotaa fi abbootii murtii haa taʼan. <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />Kumni afur eegdota balbalaa haa taʼan; kumni afur immoo miʼoota faarfannaa kanneen ani kaayyoo kanaaf kenneen Rabbii Allaah haa galateeffatan.”<verse eid="1CH 23:5" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="6" style="v" sid="1CH 23:6" />Daawudis Lewwota akkuma gosoota Lewwiitti garee gareen gargar ni qoode; isaanis: Geershoon, Qohaatii fi Meraarii.<verse eid="1CH 23:6" /></para>
  <para style="s1">Geershoonota</para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 23:7" />Gosa Geershoon keessaa:</para>
  <para style="li2" vid="1CH 23:7">Laʼadaanii fi Shimeʼii.<verse eid="1CH 23:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8" />Ilmaan Laʼadaanii:</para>
  <para style="li2" vid="1CH 23:8">Yehiiʼeel hangafticha, Zeetaamii fi Yooʼeel; walumatti nama sadii turan.<verse eid="1CH 23:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9" />Ilmaan Shimeʼii:</para>
  <para style="li2" vid="1CH 23:9">Sheloomot, Haziiʼeelii fi Haaraan; walumatti nama sadii turan.</para>
  <para style="li2" vid="1CH 23:9">Isaan kunneen hangafoota Maatii Laʼadaan turan.<verse eid="1CH 23:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10" />Ilmaan Shimeʼii:</para>
  <para style="li2" vid="1CH 23:10">Yahaati, Ziinaa, Yeʼuushii fi Beriiyaa. Isaan kunneen ilmaan Shimeʼii ti;</para>
  <para style="li2" vid="1CH 23:10">walumatti nama afur turan.<verse eid="1CH 23:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 23:11" />Yahaati hangafa; Ziinaan lammaffaa; Yeʼuushii fi Beriiyaan garuu ilmaan baayʼee hin qaban; kanaafuu isaan akkuma maatii tokkootti lakkaaʼaman.<verse eid="1CH 23:11" /></para>
  <para style="s1">Qohaatota</para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 23:12" />Ilmaan Qohaatii:</para>
  <para style="li2" vid="1CH 23:12">Amraam, Yizihaar, Kebroonii fi Uziiʼeel; walumatti nama afur turan.<verse eid="1CH 23:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13" />Ilmaan Amraam:</para>
  <para style="li2" vid="1CH 23:13">Haaruunii fi Muusaa.</para>
  <para style="li2" vid="1CH 23:13">Haaruun akka innii fi sanyiin isaa wantoota waan hunda caalaa qulqulluu taʼan Allaahaf qulqulleessaniif, akka fuula Rabbii Allaah duratti aarsaa dhiʼeessaniif, akka fuula isaa dura tajaajilanii fi akka maqaa isaatiin eebba labsaniif bara baraan addaan baafaman. <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />Ilmaan Muusaa nama Allaaha immoo gosa Lewwiitti dabalamanii lakkaaʼaman.<verse eid="1CH 23:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15" />Ilmaan Muusaa:</para>
  <para style="li2" vid="1CH 23:15">Geershoomii fi Eliiʼezer.<verse eid="1CH 23:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16" />Ilmaan Geershoomii:</para>
  <para style="li2" vid="1CH 23:16">Shebuuʼeel hangafa.<verse eid="1CH 23:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17" />Ilmaan Eliiʼezerii keessaa:</para>
  <para style="li2" vid="1CH 23:17">Rehaabiyaa hangafa.</para>
  <para style="li2" vid="1CH 23:17">Eleʼaazaar ilmaan biraa hin qabu ture; ilmaan Rehaabiyaa garuu akka malee hedduu turan.<verse eid="1CH 23:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18" />Ilmaan Yizihaar keessaa:</para>
  <para style="li2" vid="1CH 23:18">Sheloomiit hangafta.<verse eid="1CH 23:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19" />Ilmaan Kebroon;</para>
  <para style="li2" vid="1CH 23:19">hangaftichi Yeriyaa, lammaffaan Amariyaa, sadaffaan Yahiziiʼeel, afuraffaan Yeqameʼaam.<verse eid="1CH 23:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20" />Ilmaan Uziiʼeel:</para>
  <para style="li2" vid="1CH 23:20">hangaftichi Miikaa, lammaffaan Yishiyaa.<verse eid="1CH 23:20" /></para>
  <para style="s1">Meraarota</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 23:21" />Ilmaan Meraarii:</para>
  <para style="li2" vid="1CH 23:21">Mahilii fi Muusii.</para>
  <para style="li1" vid="1CH 23:21">Ilmaan Mahilii:</para>
  <para style="li2" vid="1CH 23:21">Eleʼaazaarii fi Qiis<verse eid="1CH 23:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22" />Eleʼaazaar utuu ilmaan hin dhalchin duʼe; inni intallan qofa qaba ture. Durbiiwwan isaanii ilmaan Qiistu isaan fuudhe.<verse eid="1CH 23:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23" />Ilmaan Muusii:</para>
  <para style="li2" vid="1CH 23:23">Mahelii, Eederii fi Yereemooti; walumatti nama sadii turan.<verse eid="1CH 23:23" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="24" style="v" sid="1CH 23:24" />Isaan kunneen ilmaan Lewwii kanneen akkuma mana abbootii isaaniitti hangafoonni abbootii warri maqaa maqaadhaan galmeeffamanii tokko tokkoon lakkaaʼaman, hojjettoota umuriin isaanii waggaa digdamaa fi sanaa ol taʼe warra mana qulqullummaa Rabbii Allaah keessa tajaajilanii dha. <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />Daawud akkana jedhee tureetii; “Rabbii Allaah Allaahan Israaʼel saba isaatiif boqonnaa kenneera; bara baraanis Yerusaalem keessa ni jiraata; <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />siʼachi Lewwonni dunkaana yookaan miʼoota achi keessatti itti fayyadaman hin baatan.” <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />Akkuma qajeelcha Daawud dhuma irratti kenneetti, Lewwonni waggaa digdamaa fi sanaa olii hedamaniiruutii.<verse eid="1CH 23:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28" />Hojiin Lewwotaas tajaajila mana qulqullummaa Allaaha keessatti sanyiiwwan Haaruunii gargaaruu dha; kunis oobdiiwwanii fi kutaawwan mana qulqullummaa eeguu, miʼoota qulqulluu qulqulleessuu fi hojiiwwan biraas mana Rabbii Allaah keessatti hojjechuu dha. <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />Akkasumas buddeena minjaala irra kaaʼuu, daakuu kennaa midhaanii, buddeena utuu hin bukaaʼin tolfame, tolchuu fi waliin makuu, safartuu fi madaalii hunda irratti itti gaafatamtoota turan. <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />Isaan guyyaa guyyaadhaan Rabbii Allaah galateeffachuu fi jajachuuf ganama ganama fuula isaa dura ni dhaabatu; galgala galgalas akkasuma ni godhu; <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />yeroo aarsaan gubamu guyyaa Sanbataa Rabbii Allaahaf dhiʼeeffamutti yeroo Ayyaana Baatii Haaraa fi gaafa ayyaana yeroon isaa murtaaʼe kamii iyyuu akkanuma ni godhu. Isaan yeroo hunda akkuma lakkoobsaa fi qajeelfama isaanii kennameetti fuula Rabbii Allaah dura tajaajilu ture.<verse eid="1CH 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32" />Lewwonni akkasiin itti gaafatama dunkaana wal gaʼii fi Iddoo Qulqulluu eeguuf qaban raawwatan; akkasumas ajaja obboloota isaanii sanyiiwwan Haaruun jalatti itti gaafatamummaa mana qulqullummaa Rabbii Allaah keessatti qaban raawwachaa turan.<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s1">Ramadamuu lubootaa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />Ilmaan Haaruun akka armaan gadiitti ramadaman:</para>
  <para style="p" vid="1CH 24:1">Ilmaan Haaruun Naadaab, Abiihuu, Eleʼaazaarii fi Iitaamaar turan. <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />Naadaabii fi Abiihuu garuu utuu ijoollee hin dhalchin abbaa isaanii dursanii duʼan; kanaafuu Eleʼaazaarii fi Iitaamaar luboota taʼanii tajaajilan. <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />Daawudis gargaarsa Zaadoq sanyii Eleʼaazaar sanaatii fi Ahiimelek sanyii Iitaamaariin akkuma tajaajila isaaniitti garee gareen isaan ramade. <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />Sanyiiwwan Iitaamaarii caalaa sanyiiwwan Eleʼaazaar keessaa hooggantoonni hedduun ni argaman; isaanis akkanatti ramadaman: sanyiiwwan Eleʼaazaar keessaa abbootii maatii kudha jaʼa, sanyiiwwan Iitaamiir keessaa immoo abbootii maatii saddeet. <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />Isaan sababii sanyiiwwan Eleʼaazaarii fi sanyiiwwan Iitaamaar keessa qondaaltonni mana qulqullummaatii fi qondaaltonni Allaaha turaniif loogii malee ixaadhaan isaan ramadan.<verse eid="1CH 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6" />Shemaaʼiyaan ilmi Naatnaaʼel namicha gosa Lewwii barreessaan sun fuula mootichaatii fi qondaaltotaa duratti maqaa isaanii Zaadoq lubicha, Ahiimelek ilma Abiyaataar, abbootii maatiiwwan lubootaatii fi Lewwotaa, innis gosa Eleʼaazaar keessaa maatii tokko, gosa Iitaamaar keessaa immoo maatii tokko fuudhee barreesse.<verse eid="1CH 24:6" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7" />Ixaan jalqabaa Yehooyaariibiif,</para>
  <para style="li1" vid="1CH 24:7">lammaffaan Yedaaʼiyaaf,<verse eid="1CH 24:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8" />sadaffaan Haariimiif,</para>
  <para style="li1" vid="1CH 24:8">afuraffaan Seʼooriimiif,<verse eid="1CH 24:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9" />shanaffaan Malkiyaaf,</para>
  <para style="li1" vid="1CH 24:9">jaʼaffaan Miyaamiiniif,<verse eid="1CH 24:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10" />torbaffaan Haqoosiif,</para>
  <para style="li1" vid="1CH 24:10">saddeettaffaan Abiyaaf,<verse eid="1CH 24:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11" />saglaffaan Yeeshuuʼaaf,</para>
  <para style="li1" vid="1CH 24:11">kurnaffaan Shekaaniyaaf,<verse eid="1CH 24:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12" />kudhan tokkoffaan Eliyaashiibiif,</para>
  <para style="li1" vid="1CH 24:12">kudha lammaffaan Yaaqiimiif,<verse eid="1CH 24:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13" />kudha sadaffaan Huphaaf,</para>
  <para style="li1" vid="1CH 24:13">kudha afuraffaan Yeshebeʼaabiif,<verse eid="1CH 24:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14" />kudhan shanaffaan Bilgaaf,</para>
  <para style="li1" vid="1CH 24:14">kudha jaʼaffaan Imeeriif,<verse eid="1CH 24:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15" />kudha torbaffaan Heeziiriif,</para>
  <para style="li1" vid="1CH 24:15">kudha saddeettaffaan Haphizeeziif,<verse eid="1CH 24:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16" />kudha saglaffaan Phetaayaaf,</para>
  <para style="li1" vid="1CH 24:16">digdammaffaan Hisqiʼeeliif,<verse eid="1CH 24:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17" />digdamii tokkoffaan Yaakiiniif,</para>
  <para style="li1" vid="1CH 24:17">digdamii lammaffaan Gaamuuliif,<verse eid="1CH 24:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18" />digdamii sadaffaan Delaayaaf,</para>
  <para style="li1" vid="1CH 24:18">digdamii afuraffaan Maʼaaziyaaf baʼe.<verse eid="1CH 24:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19" />Kun seera isaan yeroo mana qulqullummaa Rabbii Allaah seenanitti ittiin tajaajilanii dha; seera kanas abbaa isaanii Haaruunitu akkuma Rabbii Allaahan Israaʼel isa ajajetti isaaniif kenne.<verse eid="1CH 24:19" /></para>
  <para style="s1">Lewwota Hafan</para>
  <para style="lh">
    <verse number="20" style="v" sid="1CH 24:20" />Ilmaan Lewwii warra hafan:</para>
  <para style="b" vid="1CH 24:20" />
  <para style="li1" vid="1CH 24:20">Ilmaan Amraamii keessaa: Shuubaaʼeel;</para>
  <para style="li2" vid="1CH 24:20">ilmaan Shuubaaʼeel keessaa: Yehideyaa.<verse eid="1CH 24:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 24:21" />Ilmaan Rehaabiyaa keessaa: Yishiyaa hangafticha.<verse eid="1CH 24:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22" />Yizihaarota keessaa: Sheloomiit;</para>
  <para style="li2" vid="1CH 24:22">ilmaan Sheloomiit keessaa immoo: Yahaati.<verse eid="1CH 24:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23" />Ilmaan Kebroon: Inni jalqabaa Yeriyaa, lammaffaan Amariyaa, sadaffaan Yahiziiʼeel, afuraffaan Yeqameʼaam.<verse eid="1CH 24:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24" />Ilma Uziiʼeel: Miikaa.</para>
  <para style="li2" vid="1CH 24:24">Ilmaan Miikaa keessaa: Shaamiir.<verse eid="1CH 24:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 24:25" />Obboleessa Miikaa: Yishiyaa;</para>
  <para style="li2" vid="1CH 24:25">Ilmaan Yishiyaa keessaa: Zakariyaa.<verse eid="1CH 24:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26" />Ilmaan Meraarii: Mahilii fi Muusii.</para>
  <para style="li2" vid="1CH 24:26">Ilma Yaʼaziyaa: Banoo.<verse eid="1CH 24:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27" />Ilmaan Meraarii:</para>
  <para style="li2" vid="1CH 24:27">Yaʼaziyaa irraa: Banoo, Shohaam, Zakuurii fi Ibrii.<verse eid="1CH 24:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28" />Mahilii irra: Eleʼaazaar; namichi kun ilmaan hin qabu ture.<verse eid="1CH 24:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29" />Qiis irraa: Yeramiʼeel ilma Qiis.<verse eid="1CH 24:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30" />Ilmaan Muusii: Mahelii, Eederii fi Yeriimooti.</para>
  <para style="b" vid="1CH 24:30" />
  <para style="lf" vid="1CH 24:30">Isaan kunneen akkuma mana abbootii isaaniitti ilmaan Lewwotaa ti.<verse eid="1CH 24:30" /></para>
  <para style="b" />
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31" />Isaanis akkuma obboloota isaanii ilmaan Haaruun sana fuula Daawud Mootichaa duratti, fuula Zaadoq, Ahiimelek, fuula hangafoota maatii lubootaatii fi Lewwotaa duratti ixaa buufatan. Maatii obboleessa hangaftichaatiifis akkuma maatii obboleessa quxisuutti ixaan buʼe.<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s1">Faarfattoota</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />Daawud ajajjoota loltootaa wajjin akka isaan kiraaraan, baganaa fi kililleetti fayyadamanii raajii dubbataniif maatii Asaaf, Heemaanii fi Yeduutuun keessaa namoota addaan baafate. Maqaan namoota tajaajila kana kennaa turaniis:<verse eid="1CH 25:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2" />Ilmaan Asaaf keessaa:</para>
  <para style="li2" vid="1CH 25:2">Zakuur, Yuusuf, Naataaniyaa fi Asareelaa. Ilmaan Asaaf qajeelcha Asaaf jala turan. Asaaf immoo qajeelcha mootichaa jalatti raajii dubbachaa ture.<verse eid="1CH 25:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3" />Ilmaan Yeduutuun keessaa:</para>
  <para style="li2" vid="1CH 25:3">Gedaaliyaas, Zerii, Isaayyaas, Sameeʼi, Hashabiyaa fi Matiitiyaa. Isaan kunneen jaʼan qajeelcha abbaa isaanii Yeduutuun isa kiraaraan Rabbii Allaah galateeffachaa fi jajachaa raajii dubbachaa ture sanaa jala turan.<verse eid="1CH 25:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4" />Ilmaan Heemaan keessaa:</para>
  <para style="li2" vid="1CH 25:4">Bukiyaa, Mataaniyaa, Uziiʼeel, Shebuuʼeelii fi Yeriimooti; Hanaaniyaa, Hanaanii, Eliiʼaataa, Gidaltii fi Roomaamti-Ezer; Yoshibqaashaa, Malootii, Hootiirii fi Mahaaziyoo ti. <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />Isaan kunneen hundi ilmaan Heemaan namicha mootichaaf mulʼata argu sanaa turan. Isaan akka isa kabajaniif akkuma Allaahan abdachiise sanatti isaa ni kennaman. Allaahanis ilmaan kudha afurii fi intallan sadii Heemaaniif ni kenne.<verse eid="1CH 25:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6" />Namoonni kunneen hundi tajaajila mana Allaaha keessatti faarfannaa kililleedhaan, kiraaraa fi baganaadhaan mana qulqullummaa Rabbii Allaah keessatti faarfatamu sanaaf qajeelcha abbootii isaanii jala turan.</para>
  <para style="p" vid="1CH 25:6">Asaaf, Yeduutuunii fi Heemaan immoo qajeelcha mootichaa jala turan. <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />Isaanii fi firoonni isaanii kanneen hundi isaanii faarfannaa Rabbii Allaahaf faarfatamuun leenjifamanii ogummaa qaban walumaa galatti 288 turan. <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />Jarris ramaddii isaanii beekuudhaaf xinnaa fi guddaan, barsiisaa fi barataan haaluma wal fakkaatuun ixaa buufatan.<verse eid="1CH 25:8" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="9" style="v" sid="1CH 25:9" />Ixaan jalqabatti Asaafiif buʼe sun Yuusufiif, <optbreak /> ilmaan Yuusufiitii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaaniis kudha lama turan</para>
  <para style="li1" vid="1CH 25:9">lammaffaan Gedaaliyaasiif, <optbreak /> isaaf, firoota isaatii fi ilmaan isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 25:10" />sadaffaan Zakuuriif, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 25:11" />afuraffaan Izriif, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 25:12" />shanaffaan Naataaniyaaf, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 25:13" />jaʼaffaan Bukiyaaf, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 25:14" />torbaffaan Yishiriʼeeliif, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 25:15" />saddeettaffaan Yashaayaaf, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 25:16" />saglaffaan Mataaniyaaf, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 25:17" />kurnaffaan Shimeʼiif, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 25:18" />kudha tokkoffaan Azariʼeeliif, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 25:19" />kudha lammaffaan Hashabiyaaf, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 25:20" />kudha sadaffaan Shuubaaʼeeliif, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 25:21" />kudha afuraffaan Matiitiyaaf, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 25:22" />kudha shanaffaan Yereemootiif, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii nama kudha lama turan<verse eid="1CH 25:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 25:23" />kudha jaʼaffaan Hanaaniyaaf, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 25:24" />kudha torbaffaan Yoshibqaashaaf, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 25:25" />kudha saddeettaffaan Hanaaniif, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii nama kudha lama turan<verse eid="1CH 25:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 25:26" />kudha saglaffaan Malootiif, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 25:27" />digdammaffaan Eliyaataaf, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 25:28" />digdamii tokkoffaan Hootiiriif, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 25:29" />digdamii lammaffaan Gidaltiif, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 25:30" />digdamii sadaffaan Mahaaziyootiif, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan<verse eid="1CH 25:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 25:31" />digdamii afuraffaan Roomaamti-Ezeriif, <optbreak /> ilmaan isaatii fi firoota isaatiif baʼe; <optbreak /> baayʼinni isaanii kudha lama turan.<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s1">Eegdota Balbalaa</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 26:1" />Akka itti eegdonni karraa qoodaman:</para>
  <para style="b" vid="1CH 26:1" />
  <para style="lh" vid="1CH 26:1">Gosa qoree keessaa:</para>
  <para style="li1" vid="1CH 26:1">Ilmaan Asaaf keessaa Mesheleemiyaa ilma Qooraahi.<verse eid="1CH 26:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 26:2" />Mesheleemiyaa ilmaan qaba ture; isaanis:</para>
  <para style="li2" vid="1CH 26:2">Inni hangafti Zakariyaa, lammaffaan Yediiʼeel,</para>
  <para style="li2" vid="1CH 26:2">sadaffaan Zabaadiyaa, Afuraffaan Yatniiʼeel,<verse eid="1CH 26:2" /></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 26:3" />inni shanaffaan Eelaam, jaʼaffaan Yehohaanaan,</para>
  <para style="li2" vid="1CH 26:3">torbaffaan Eliihooʼeenayi.<verse eid="1CH 26:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 26:4" />Oobeed Edoomis akkasuma ilmaan qaba ture; isaanis:</para>
  <para style="li2" vid="1CH 26:4">Inni hangafti Shemaaʼiyaa, lammaffaan Yehoozaabaad,</para>
  <para style="li2" vid="1CH 26:4">sadaffaan Yooʼaa, afuraffaan Saakaar,</para>
  <para style="li2" vid="1CH 26:4">shanaffaan Naatnaaʼel, <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />jaʼaffaan Amiiʼeel,</para>
  <para style="li2" vid="1CH 26:5">torbaffaan Yisaakor, saddeettaffaan Pheʼuletii;</para>
  <para style="li2" vid="1CH 26:5">Allaahan Oobeed Edoomin eebbiseeraatii.<verse eid="1CH 26:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 26:6" />Shemaaʼiyaan ilmi isaas ilmaan qaba ture; isaanis waan dandeettii guddaa qabaniif qajeelchitoota maatii abbaa isaanii turan. <verse eid="1CH 26:6" /><verse number="7" style="v" sid="1CH 26:7" />Ilmaan Shemaaʼiyaa:</para>
  <para style="li2" vid="1CH 26:7">Otnii, Raafaaʼeel, Oobeedii fi Elzaabaad;</para>
  <para style="li2" vid="1CH 26:7">firoonni isaa Eliihuu fi Samaakiyaanis dandeettii guddaa qabu ture.<verse eid="1CH 26:7" /></para>
  <para style="lf">
    <verse number="8" style="v" sid="1CH 26:8" />Isaan kunneen hundi ilmaan Oobeed Edoom; isaan, ilmaan isaaniitii fi firoonni isaanii namoota jajjaboo dandeettii hojii qaban turan; ilmaan Oobeed Edoom; walumatti nama 62 turan.<verse eid="1CH 26:8" /></para>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 26:9" />Mesheleemiyaa fi firoota dandeettii guddaa qaban qaba ture; isaanis walumatti nama 18 turan.<verse eid="1CH 26:9" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="10" style="v" sid="1CH 26:10" />Hoosaan inni gosa Meraarii sun ilmaan qaba ture; isaanis:</para>
  <para style="li2" vid="1CH 26:10">Shimriin dura buʼaa ture; inni hangafa taʼuu baatu iyyuu abbaan isaa dura buʼaa isa godhee ture;<verse eid="1CH 26:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 26:11" />inni lammaffaan Hilqiyaa, inni sadaffaan Xibaliyaa,</para>
  <para style="li2" vid="1CH 26:11">inni afuraffaan Zakariyaa.</para>
  <para style="lf" vid="1CH 26:11">Ilmaanii fi firoonni Hoosaa walumatti nama 13 turan.<verse eid="1CH 26:11" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="12" style="v" sid="1CH 26:12" />Garee eegdota karraa kana keessaa hangafoota isaaniitiif hojiin akkuma firoonni isaanii hojjetan sanaa mana Rabbii Allaah keessa tajaajiluu ni kennameef. <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />Tokkoo tokkoo balbalaatiifis akkuma maatii maatii isaaniitti xinnaa guddaaf ixaan buʼe.<verse eid="1CH 26:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 26:14" />Ixaan Karra Baʼa Biiftuu Shelemiyaaf baʼe.</para>
  <para style="li1" vid="1CH 26:14">Ergasii immoo Zakariyaa ilma isaa gorsituu ogeessa sanaaf ixaan buʼe; ixaan balbala kaabaa isaaf baʼe.<verse eid="1CH 26:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 26:15" />Ixaan Karra gama kibbaa Oobeed Edoomiif, kan mankuusaa immoo ilmaan isaatiif baʼe.<verse eid="1CH 26:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 26:16" />Ixaan Karra Lixa biiftuutii fi Karra Shaleekeet kan daandii olii irratti argamu Shufiimii fi Hoosaaf baʼe.</para>
  <para style="b" vid="1CH 26:16" />
  <para style="lh" vid="1CH 26:16">Eegumsa tokko fuulleedhaan eegumsa biraatu ture:<verse eid="1CH 26:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 26:17" />Karaa baʼa biiftuutiin guyyaa guyyaatti Lewwota jaʼa,</para>
  <para style="li1" vid="1CH 26:17">karaa kaabaatiin guyyaa guyyaatti afur,</para>
  <para style="li1" vid="1CH 26:17">karaa kibbaatiin guyyaa guyyaatti afur</para>
  <para style="li1" vid="1CH 26:17">karaa mankuusaa immoo yeroo tokkotti lamatu ture.<verse eid="1CH 26:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 26:18" />Oobdii gama lixa biiftuutiin jiruuf daandii irra afur, waltajjicha gubbaa immoo lamatu ture.<verse eid="1CH 26:18" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="19" style="v" sid="1CH 26:19" />Isaan kunneen garee eegdota karraa kanneen ilmaan Qooraahiitii fi Meraarii keessaa dhufanii dha.<verse eid="1CH 26:19" /></para>
  <para style="s1">Toʼattoota Qabeenyaatii fi Qondaaltota Biraa</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />Lewwota keessaa Ahiiyaan itti gaafatamaa qabeenya mana Allaahatii fi itti gaafatamaa miʼoota qulqulleeffamanii ture.<verse eid="1CH 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21" />Sanyiiwwan Laʼadaan kanneen karaa Laʼadaaniitiin Geershunota taʼan warri hangafoota maatii Laʼadaan namicha gosa Geershoon sanaa turan: Yehiiʼeelii, <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" />ilmaan Yehiiʼeelii, Zeetaamii fi obboleessa isaa Yooʼeel. Isaan kunis itti gaafatamtoota qabeenya mana qulqullummaa Rabbii Allaah turan.<verse eid="1CH 26:22" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="23" style="v" sid="1CH 26:23" />Amraamota keessaa, Yizihaarota keessaa, Kebroonota keessaa, Uziiʼeel keessaa:<verse eid="1CH 26:23" /></para>
  <para style="b" />
  <para style="li2">
    <verse number="24" style="v" sid="1CH 26:24" />Shebuuʼeel ilmi Geershoom ilma Muusaa sanaa itti gaafatamaa qabeenyaa hangafa ture. <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" />Namoonni karaa Eliiʼezeriitiin firoota isaa taʼan immoo: ilma isaa Rehaabiyaa, ilma isaa Isaayyaas, ilma isaa Yooraam, ilma isaa Zikrii fi ilma isaa Sheloomiit. <verse eid="1CH 26:25" /><verse number="26" style="v" sid="1CH 26:26" />Sheloomiitii fi firoonni isaa mankuusaa miʼoota Daawud mootichi, hangafoonni maatiiwwanii kanneen ajajjuuwwan kumaatii fi ajajjuuwwan dhibbaa turan, akkasumas ajajjoonni loltootaa biraa Allaahaf addaan baasan irratti itti gaafatamtoota turan. <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />Isaan boojuu waraanaan argame keessaa gara tokko haaromsuu mana qulqullummaa Rabbii Allaahatiif addaan baasanii kennan. <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />Waan Saamuʼeel namichi mulʼata argu sun, Saaʼol ilmi Qiish, Abneer ilmi Neerii fi Yooʼaab ilmi Zeruuyaa dhiʼeessanii fi waan Allaahaf addaan baafame hunda Sheloomiitii fi firoota isaatu eega ture.<verse eid="1CH 26:28" /></para>
  <para style="li2">
    <verse number="29" style="v" sid="1CH 26:29" />Yizihaarota keessaa:</para>
  <para style="li2" vid="1CH 26:29">Kenaaniyaa fi ilmaan isaa hojii mana qulqullummaatiin ala taʼetti Israaʼeloota irratti qondaaltotaa fi abbootii murtii taʼanii ramadaman.<verse eid="1CH 26:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 26:30" />Kebroonota keessaa:</para>
  <para style="li2" vid="1CH 26:30">Hashabiyaa fi firoonni isaa kanneen dandeettii qaban kuma tokkoo fi dhibba torba biyya Israaʼel kan Yordaanosiin gama lixa biiftuu jirutti hojii Rabbii Allaah hundaa fi tajaajila mootichaa irratti itti gaafatamtoota turan. <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />Kebroonota keessaa akkuma galmee hiddaa dhaloota maatii isaaniitti Yeriyaan hangafa isaanii ture.</para>
  <para style="li2" vid="1CH 26:31">Bara mootummaa Daawud keessa waggaa afurtamaffaatti galmeewwan ilaalamanii gosa Kebroon keessaa namoonni dandeettii qaban Yaʼizeer biyya Giliʼaadi keessaa sanatti argaman. <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />Yiriiyaan firoota dandeettii qaban kanneen hangafoota maatii turan kuma lamaa fi dhibba torba qaba ture; Daawud mootichis waan kan Allaaha taʼeef dhimma mootichaa hunda irratti gosa Ruubeen gosa Gaadii fi walakkaa gosa Minaasee toʼattoota godhe.<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s1">Kutaawwan Loltootaa</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 27:1" />Lakkoobsi ijoollee Israaʼel hangafoonni maatii isaanii, ajajjuuwwan kumaa, ajajjuuwwan dhibbaatii fi qondaaltonni isaanii warri waan kutaawwan loltootaa kanneen waggaa guutuu jiʼa jiʼaan hojiitti ramadaman sanaa ilaalu hunda irratti mooticha tajaajilan kanaa dha. Tokkoon tokkoon kutaawwan loltootaa kunis nama 24,000 of keessaa qaba ture.<verse eid="1CH 27:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="1CH 27:2" />Jiʼa jalqabaatiif ajajaan kutaa loltootaa kan duraa Yaashobiʼaam ilma Zabdiiʼel ture. Kutaa loltoota isaa keessas loltoota 24,000 ture. <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />Innis sanyii Faaresii fi hangafa ajajjoota kutaa loltoota hundaa kan jiʼa jalqabaa ture.<verse eid="1CH 27:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 27:4" />Doodaayi namichi Ahooʼaa ajaja kutaa waraanaa kan jiʼa lammaffaaf ture; Miiqlooti hoogganaa kutaa waraana isaa ture. Kutaan waraana isaas namoota 24,000 of keessaa qaba ture.<verse eid="1CH 27:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 27:5" />Ajajaan kutaa waraanaa sadaffaan kan jiʼa sadaffaa immoo Benaayaa ilma Yehooyaadaa lubichaa ture. Innis hangafa; kutaan waraana isaa namoota 24,000 of keessaa qaba ture. <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />Benaayaa kun isuma warra soddoma keessaa nama jabaa fi ajajaa warra soddoma sanaa ture sanaa dha. Amiizaabaad ilmi isaa immoo ajajaa kutaa waraana isaa ture.<verse eid="1CH 27:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 27:7" />Jiʼa afuraffaaf ajajaan kuta afuraffaa Asaaheel obboleessa Yooʼaab ture; kan iddoo isaa buʼe immoo ilma isaa Zebaadiyaa dha. Kutaa isaa keessa namoota 24,000 turan.<verse eid="1CH 27:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 27:8" />Jiʼa shanaffaaf ajajaan kutaa shanaffaa Shamhuuti namicha Yizraa ture. Kutaa isaa keessa namoota 24,000 turan.<verse eid="1CH 27:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 27:9" />Jiʼa jaʼaffaaf Iiraa ilmi Iqeesh namicha Teqooʼaa sanaa ajajaa jaʼaffaa ture. Kutaan isaa keessa namoota 24,000 turan.<verse eid="1CH 27:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 27:10" />Jiʼa torbaffaaf Heleez namichi Pheloonaa kan gosa Efreem sun ajajaa torbaffaa ture. Kutaa isaa keessa namoota 24,000 turan.<verse eid="1CH 27:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 27:11" />Jiʼa saddeettaffaaf Siibekaay namichi biyya Hushaa kan gosa Zaarotaa ajajaa saddeettaffaa ture; kutaa isaa keessa namoota 24,000 turan.<verse eid="1CH 27:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 27:12" />Jiʼa saglaffaaf Abiiʼezer namicha Anaatootii kan gosa Biniyaam sanattu ajajaa saglaffaa ture; kutaa isaa keessaa namoota 24,000 turan.<verse eid="1CH 27:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 27:13" />Jiʼa kurnaffaaf Maharaayi namicha Netoof kan gosa Zaaraa sanatu ajajaa kurnaffaa ture. Kutaa isaa keessa namoota 24,000 turan.<verse eid="1CH 27:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 27:14" />Jiʼa kudha tokkoffaaf ajajaan kudha tokkoffaan Benaayaa namicha Phiraatoon kan gosa Efreem sana ture. Kutaa isaa keessa namoota 24,000 turan.<verse eid="1CH 27:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 27:15" />Jiʼa kudha lammaffaaf ajajaan kudha lammaffaan Heldaayi namicha Netoof kan gosa Otniiʼeel sana ture. Kutaa isaa keessa namoota 24,000 turan.<verse eid="1CH 27:15" /></para>
  <para style="s1">Hangafoota Gosootaa</para>
  <para style="lh">
    <verse number="16" style="v" sid="1CH 27:16" />Hangafoonni gosoota Israaʼel:</para>
  <para style="b" vid="1CH 27:16" />
  <para style="li1" vid="1CH 27:16">Gosa Ruubeen irratti: Eliiʼezer ilma Zikrii;</para>
  <para style="li1" vid="1CH 27:16">gosa Simiʼoon irratti: Shefaaxiyaa ilma Maʼakaa;<verse eid="1CH 27:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 27:17" />gosa Lewwii irratti: Hashabiyaa ilma Qemuuʼeel;</para>
  <para style="li1" vid="1CH 27:17">gosa Haaruun irratti: Zaadoq;<verse eid="1CH 27:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 27:18" />gosa Yihuudaa irratti: Eliihuu obboleessa Daawud;</para>
  <para style="li1" vid="1CH 27:18">gosa Yisaakor irratti: Omrii ilma Miikaaʼiil;<verse eid="1CH 27:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 27:19" />gosa Zebuuloon irratti: Yishmaʼiyaaʼuu ilma Obaadiyaa;</para>
  <para style="li1" vid="1CH 27:19">gosa Niftaalem irratti: Yeriimooti ilma Azriiʼeel;<verse eid="1CH 27:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 27:20" />gosa Efreem irratti: Hoosheeʼaa ilma Azaziyaa;</para>
  <para style="li1" vid="1CH 27:20">walakkaa gosa Minaasee irratti: Yooʼeel ilma Phedaayaa;<verse eid="1CH 27:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 27:21" />walakkaa gosa Minaasee kan Giliʼaad keessa jiraatuu irratti:</para>
  <para style="li1" vid="1CH 27:21">Iddoo ilma Zakariyaa; gosa Biniyaam irratti: Yaʼisiiʼel ilma Abneer;<verse eid="1CH 27:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 27:22" />gosa Daan irratti: Azariʼeel ilma Yirooham.</para>
  <para style="b" vid="1CH 27:22" />
  <para style="lf" vid="1CH 27:22">Hangafoonni gosoota Israaʼel isaan kanneen turan.<verse eid="1CH 27:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23" />Daawud sababii Rabbii Allaahan saba Israaʼel akkuma urjiiwwan shamaayʼuniitti baayʼisuuf waadaa galeef dhiira waggaa digdamaatii fi digdamaa gad taʼe hin lakkoofne. <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />Yooʼaab ilmi Zeruuyaa dhiirota lakkaaʼuu jalqabe malee lakkaaʼee hin fixne; sababii lakkoobsa kanaatiifis dheekkamsi Allaaha Israaʼelitti dhufe; kanaafuu warri hedaman iyyuu galmee Daawud mootichaa keessatti hin galmeeffamne.<verse eid="1CH 27:24" /></para>
  <para style="s1">Shuumota Mootichaa</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 27:25" />Azmaawet ilmi Aadiiʼeel shuumii mankuusaa qabeenya mootii ture.</para>
  <para style="li1" vid="1CH 27:25">Yoonaataan ilmi Uziyaa immoo shuumii miʼoota aanaalee, magaalaawwan, kan gandootaatii fi gamoowwan eegumsaa ture.<verse eid="1CH 27:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 27:26" />Ezeriin ilmi Kiluub shuumii qonnaan bultootaa ture.<verse eid="1CH 27:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 27:27" />Shimeʼiin namichi Raamaatii sun itti gaafatamaa iddoo dhaabaa wayinii ture.</para>
  <para style="li1" vid="1CH 27:27">Zabdiin namichi Shifaamii sun itti gaafatamaa mana cuunfaa wayinii iddoo dhaabaa wayinii keessaa ture.<verse eid="1CH 27:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 27:28" />Baʼaal-Haanaan namichi Gedeeraa sun shuumii mukkeen ejersaatii fi harbuu tabbawwan gaarran gama lixa biiftuutti argamanii ture.</para>
  <para style="li1" vid="1CH 27:28">Yooʼaash immoo shuumii mana zayitii ejersaa ture.<verse eid="1CH 27:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 27:29" />Shitraayi namichi Shaaroon shuumii karra loonii kan Shaaroonitti bobbaʼuu ture.</para>
  <para style="li1" vid="1CH 27:29">Shaafaax ilmi Aadilaay shuumii karra loowwan sulula keessa jiranii ture.<verse eid="1CH 27:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 27:30" />Oobiil namichi gosa Ismaʼiil sun shuumii gaalawwanii ture.</para>
  <para style="li1" vid="1CH 27:30">Yehideyaan namichi gosa Meeroonotaa shuumii harrootaa ture.<verse eid="1CH 27:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 27:31" />Yaaziiz namichi gosa Haagar itti gaafatamaa bushaayee ture.</para>
  <para style="lf" vid="1CH 27:31">Isaan kunneen hundi shuumota qabeenya Daawud mootichaa turan.<verse eid="1CH 27:31" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="32" style="v" sid="1CH 27:32" />Yoonaataan eessumni Daawud namichi beekaan barreessaan sun gorsituu ture;</para>
  <para style="li1" vid="1CH 27:32">Yehiiʼeel ilmi Hakmoonii immoo eegduu ilmaan mootichaa ture.<verse eid="1CH 27:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 27:33" />Ahiitofel gorsaa mootichaa ture.</para>
  <para style="li1" vid="1CH 27:33">Huushaayi namichi gosa Arki immoo michuu mootichaa ture.<verse eid="1CH 27:33" /></para>
  <para style="lf">
    <verse number="34" style="v" sid="1CH 27:34" />Yehooyaadaan ilmi Benaayaatii fi Abiyaataar iddoo Ahiitofel buʼan.</para>
  <para style="li1" vid="1CH 27:34">Yooʼaab immoo ajajaa eegdota mootummaa ture.<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s1">Karoora Daawud Mana Qulqullummaatiif Baase</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />Daawud akka isaan Yerusaalemitti walitti qabamaniif hangafoota Israaʼel hunda ni waame; isaanis: Geggeessitoota gosootaa, tajaajila mootummaa keessatti ajajjoota kutaawwan loltootaa, ajajjoota kumaatii fi ajajjoota dhibbaa, warra qabeenyaa fi horii mootichaatii fi kan ilmaan isaa irratti itti gaafatamtoota taʼan, qondaaltota masaraa mootummaa, namoota jajjaboo fi gootota waraanaa hunda.<verse eid="1CH 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2" />Ergasii Daawud Mootichi kaʼee dhaabatee akkana jedhe: “Yaa obboloota koo fi yaa saba ko, mee na dhagaʼaa. Ani taabota kakuu Rabbii Allaahatiif iddoo inni boqotu, Allaah keenyaaf immoo iddoo inni miilla dhaabatu ijaaruu yaadee qophaaʼeera. <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />Allaahan garuu, ‘Ati sababii lola hedduu loltee dhiiga baayʼee dhangalaafteef maqaa kootiif mana hin ijaartu’ naan jedhe.<verse eid="1CH 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4" />“Taʼus Rabbii Allaahan, Allaahan Israaʼel akka ani bara baraan Israaʼel irratti mootii taʼuuf mana abbaa koo keessaa na filate. Akka inni dura buʼaa taʼuufis Yihuudaa filate; mana Yihuudaa keessaa maatii koo filate; ilmaan abbaa kootii keessaa immoo akka ani guutummaa Israaʼel irratti mootii taʼu jaallate. <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />Rabbii Allaahan ilmaan baayʼee naa kenneera; ilmaan koo hunda keessaa immoo akka inni teessoo mootummaa Rabbii Allaah irra taaʼee saba Israaʼel bulchuuf ilma koo Suleyimaanin filate. <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />Akkanas naan jedhe; ‘Kan mana koo fi oobdiiwwan koo naaf ijaaru ilma kee Suleyimaanii dha; ani akka inni ilma naa taʼuuf isa filadheeraatii; anis abbaa isaa nan taʼa. <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />Yoo inni akkuma ammaa kanatti ittuma fufee ajaja koo fi seera koo eege ani bara baraan mootummaa isaa jabeessee nan dhaaba.’<verse eid="1CH 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8" />“Kanaafuu akka isin lafa gaarii kana dhaaltanii ilmaan keessaniif dhaala bara baraa dabarsitaniif, akka isin ajaja Rabbii Allaah keessanii hunda eegdanii fi isa duukaa buutaniif ani amma fuula Israaʼeloota hundaa duratti, waldaa Rabbii Allaah duratti, akkasumas utuu Allaahan keenya dhagaʼuu isinin ajaja.<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />“Yaa ilma koo Suleyimaan atis Allaah abbaa keetii beekii garaa tokkoo fi qalbii fedhii qabuun isa tajaajili; Rabbii Allaahan waan garaa namaa keessa jiru hunda qoree karooraa fi yaada hunda hubataatii. Yoo ati isa barbaadde inni siif argama; yoo ati isa dhiifte garuu inni bara baraan si dhiisa. <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />Amma qalbeeffadhu; Rabbii Allaahan akka ati mana iddoo qulqulluu taʼu tokko ijaartuuf si filateeraatii. Jajjabaadhuu hojjedhu.”<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />Ergasii Daawud karoora gardaafoo mana qulqullummaa, kan ijaarsa isaa, kutaawwan miʼi keessa kaaʼamu, kan kutaawwan ol aananiitii fi kutaawwan keessaa, akkasumas karoora iddoo teessoo araaraa ilma isaa Suleyimaanitti kenne. <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />Akkasumas karoora waan Hafuurri qulqulluun isa yaachisee kan oobdii mana qulqullummaa Rabbii Allaaha, kan kutaawwan naannoo isaa jiranii, kutaawwan mana miʼa mana qulqullummaa Allaahatii fi kan mankuusaa miʼoota Allaahatiif addaan baafamanii hunda itti kenne. <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />Karoora ramaddii hojii lubootaatii fi Lewwotaa, tajaajila mana qulqullummaa Rabbii Allaah keessatti kennamuu maluu hunda, miʼoota mana qulqullummaa keessatti tajaajilaaf oolan irrattis qajeelfama ni kenneef. <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />Ulfina warqee miʼoota warqee irraa hojjetamanii tajaajila garaa garaatiif oolan hundaatii fi ulfina meetii miʼoota meetii irraa hojjetamanii tajaajila garaa garaatiif oolan hundaas isa beeksise: <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />Kunis ulfina baattuuwwan ibsaa kanneen warqee irraa hojjetamaniitii fi ibsaawwan isaanii, ulfina warqee tokkoo tokkoo baattuu ibsaatii fi ibsaa isaanii wajjin, akkasumas akkuma hojii tokkoo tokkoo baattuu ibsaa sanaatti ulfina meetii tokkoo tokkoo baattuu ibsaatii fi ibsaawwan isaa, <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />ulfina warqee tokkoo tokkoo minjaala buddeenni qulqulluun irra kaaʼamuu, ulfina meetii minjaalli irraa hojjetame, <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />ulfina warqee qulqulluu falʼaana, waciitii fi kubbaayyaa, ulfina warqee tokkoo tokkoo caabii warqee irraa hojjetame; ulfina meetii tokkoo tokkoo caabii meetii irraa hojjetame; <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />akkasumas ulfina warqee qulqulleeffame kan iddoo aarsaa ixaanaatiif qopheeffame. Karoora gaarii jechuunis kiirubeelii warqee irraa hojjetaman kanneen qoochoo isaanii babalʼisanii taabota kakuu Rabbii Allaah haguugan itti kenne.<verse eid="1CH 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19" />Daawudis, “Ani waan kana hunda harka Rabbii Allaah kan narra jiru sanaan barreeffamaan argadhe; innis karoora hojii kanaa hunda irratti hubannaa naaf kenne” jedhe.<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />Daawud ilma isaa Suleyimaaniin akkana jedhe; “Cimi; jajjabaadhus; hojii sanas hojjedhu. Hin sodaatin; abdiis hin kutatin; Rabbii Allaahan, Allaah Gooftaan, Allaahan koo si wajjin jiraatii. Inni hamma hojiin tajaajila mana qulqullummaa Rabbii Allaah dhumutti si hin dhiisu yookaan si hin gatu. <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />Gareen lubootaatii fi Lewwotaa ijaarsa mana qulqullummaa Allaahatiif qophaaʼoo dha. Namni fedhii qabu kan ogummaa hojii gosa kamii iyyuu qabu hundii hojii hunda si gargaara. Qondaaltonnii fi namoonni hundii ajaja kee hunda ni fudhatu.”<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s1">Kennaa Ijaarsa Mana Qulqullummaatiif Kenname</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />Ergasii Daawud mootichi yaaʼii guutuudhaan akkana jedhe; “Ilmi koo Suleyimaan inni Allaahan filate ijoollee fi nama muuxannoo hin qabnee dha. Manni qulqullummaa kun kan Rabbii Allaah, Allaahati malee waan kan namaa hin taʼiniif hojiin isaa guddaa dha. <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />Anis waanan kennuu dandaʼu hunda mana qulqullummaa Allaah kootiif, hojii warqeetiif warqee, kan meetiitiif meetii, kan naasiitiif naasii, kan sibiilaatiif sibiila, kan mukaatiif muka akkasumas waan bareedina duuba isaatiif oolu sardooniksii, keelqedoon, dhagaawwan babbareedoo fi dhagaa adii baayʼinaan qopheesseera. <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />Kana malees ani jaalalan mana Allaah kootiif qabuun waanan duraan kennee turetti dabalee qabeenya ofii koo irraa warqee fi meetii mana qulqullummaa Allaah kootiif nan kenna; <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />kunis keenyan manichaatti uffisuuf warqee qulqulluu warqee, Oofiirii taalaantii kuma sadii fi meetii qulqulleeffame taalaantii kuma torba, <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />akka hojiin hundi ogeeyyii hojii harkaatiin hojjetamuuf warqee hojii warqeetiif, meetii illee hojii meetiif kenneera. Egaa harʼa eenyutu fedhii isaatiin Rabbii Allaahaf addaan of baasa?”<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />Ergasii qajeelchitoonni maatii, ajajjoonni gosoota Israaʼel, ajajjuuwwan kumaa, ajajjuuwwan dhibbaatii fi qondaaltonni hojii mootii toʼatan kennaa isaanii fedhiidhaan kennan. <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />Isaanis hojii ijaarsa mana qulqullummaa Allaahatiif warqee taalaantii kuma shan, warqee daariikii kuma kudhan, meetii taalaantii kuma kudhan, naasii taalaantii kuma kudha saddeetii fi sibiila taalaantii kuma dhibba tokko ni kennan. <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />Namni dhagaawwan gati jabeeyyii qabu hundinuus harka Yehiiʼeel namicha gosa Geershoonitti mankuusaa mana qulqullummaa Rabbii Allaahatti ni galche. <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />Kana irratti waan dura deemtonni isaa fedhii fi garaa guutuudhaan Rabbii Allaahaf kennaniif sabni sun ni gammade. Daawud mootichis akka malee ni gammade.<verse eid="1CH 29:9" /></para>
  <para style="s1">Duʼaa Daawud</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />Daawud yaaʼii guutuu duratti akkana jedhee Rabbii Allaah galateeffate;</para>
  <para style="q1" vid="1CH 29:10">“Rabbii Allaah, Allaah abbaa keenya Israaʼel</para>
  <para style="q2" vid="1CH 29:10">bara baraa hamma bara baraatti</para>
  <para style="q2" vid="1CH 29:10">galanni siif haa taʼu.<verse eid="1CH 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11" />Rabbii Allaah sababii wanni shamaayʼun fi</para>
  <para style="q2" vid="1CH 29:11">lafa irra jiru hundi kan kee taʼeef guddinnii fi humni,</para>
  <para style="q2" vid="1CH 29:11">ulfinni, surraa fi simboon kan kee ti.</para>
  <para style="q1" vid="1CH 29:11">Rabbii Allaah mootummaan kan kee ti;</para>
  <para style="q2" vid="1CH 29:11">ati waan hunda irratti mataa ol ol jettee dha.<verse eid="1CH 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12" />Badhaadhummaa fi kabajamuun si biraa argama;</para>
  <para style="q2" vid="1CH 29:12">ati bulchaa waan hundaa ti.</para>
  <para style="q1" vid="1CH 29:12">Ol ol guddisuu fi waan hundaaf</para>
  <para style="q2" vid="1CH 29:12">jabina kennuuf, jabinnii fi humni si harka jira.<verse eid="1CH 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13" />Ammas yaa Allaah keenya, si galateeffanna;</para>
  <para style="q2" vid="1CH 29:13">maqaa kee ulfina qabeessa sanas ni jajanna.<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14" />“Garuu arjummaa akkasii gochuuf ani eenyu? Sabni koos eenyu? Wanni hundi si biraa dhufe; nu waanuma harka keetii dhufe sana qofa siif kennine. <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />Nu akkuma abbootiin keenya hundi turan sana fuula kee duratti alagootaa fi keessummoota; barri jireenya keenyaas lafa irratti akkuma gaaddidduu ti; abdii illee hin qabnu. <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />Yaa Rabbii Allaah keenya, wanni nu Maqaa kee Qulqullichaaf mana qulqullummaa siif ijaaruuf kennine kun hundinuu harka keetii dhufe; hundi isaas keetuma. <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />Yaa Allaah koo akka ati garaa qortuu fi qajeelummaa jaallattu ani beeka. Anis waan kana hunda amanamummaa fi fedhiidhaanan kenne. Ammas akka sabni kee kan as jiru kun fedhiidhaan siif kenne ani argee gammadeera. <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />Yaa Rabbii Allaah abbootii keenyaa, Allaah Ibraahim, Allaah Yisihaaq, Allaah Israaʼel fedhii kana bara baraan garaa saba keetii keessa tursi; akka garaan isaaniis amanamaa siif taʼu godhi. <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />Ilma koo Suleyimaaniifis akka inni ajaja kee, qajeelchaa fi labsii kee eegu, akka inni waan kana hunda hojjetee mana qulqullummaa kan ani gumaata godheef kana illee ijaaruuf fedhii garaa guutuu kenniif.”<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />Sana booddees Daawud yaaʼii guutuudhaan, “Rabbii Allaah keessan galateeffadhaa” jedhe. Kanaafuu hundi isaanii Rabbii Allaah abbootii isaanii ni galateeffatan; fuula Rabbii Allaahatii fi fuula mootichaa duratti addaan gombifamanii ni sagadan.<verse eid="1CH 29:20" /></para>
  <para style="s1">Suleyimaan Mootii Taʼuun Isaa Beekame</para>
  <para style="r">
    <ref loc="1CH 29:21-25">29:21‑25</ref> kwf – <char style="xt"><ref loc="1KI 1:28-53">1Mt 1:28‑53</ref></char></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />Isaanis guyyaa itti aanutti Rabbii Allaahaf qalma qalanii aarsaa gubamu dhiʼeessan; aarsaan maqaa Israaʼelootaatiin dhiʼaates: korommii loonii kuma tokko, korbeeyyii hoolaa kuma tokko, korbeeyyii hoolaa xixinnaa kuma tokko, dhibaayyuu fi aarsaawwan biraa baayʼee dha. <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />Isaanis gaafa sana fuula Rabbii Allaah duratti gammachuu guddaadhaan nyaatanii dhugan.</para>
  <para style="p" vid="1CH 29:22">Ergasii immoo Suleyimaan ilma Daawud mootii godhanii akka inni bulchaa taʼuuf fuula Rabbii Allaah duratti yeroo lammaffaa diban; Zaadoqiin immoo luba godhan. <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />Kanaafuu Suleyimaan iddoo abbaa isaa Daawud mootii taʼee teessoo Rabbii Allaah irra taaʼe. Ni milkaaʼes; Israaʼeloonni hundis isaaf ajajaman. <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />Ajajjoonni waraanaatii fi namoonni jajjaboon hundi akkasumas ilmaan Daawud mootichaa hundi amanamummaa isaanii Suleyimaan Mootichaaf mirkaneessan.<verse eid="1CH 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 29:25" />Rabbii Allaahanis Israaʼeloota duratti Suleyimaanin ol ol kaase; ulfina mootummaa kan mootonni isa dura turan tokko iyyuu Israaʼel keessatti hin qabaatin ni kenneef.<verse eid="1CH 29:25" /></para>
  <para style="s1">Duʼa Daawud</para>
  <para style="r">
    <ref loc="1CH 29:26-28">29:26‑28</ref> kwf – <char style="xt"><ref loc="1KI 2:10-12">1Mt 2:10‑12</ref></char></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />Daawud ilmi Isseey guutummaa Israaʼel irratti mootii ture. <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />Innis waggaa afurtama Israaʼelin bulche; waggaa torba Kebroon taaʼee, waggaa soddomii sadii immoo Yerusaalem taaʼee ni bulche. <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />Daawud bara dheeraa jiraatee, badhaadhummaa fi ulfina argatee dulloomee duʼe. Ilmi isaa Suleyimaan mootii taʼee iddoo isaa buʼe.<verse eid="1CH 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 29:29" />Hojiin bara mootummaa Daawud Mootichaa keessa jalqabaa hamma dhumaatti hojjetame kitaaba Seenaa Saamuʼeel namicha mulʼata argu sanaa keessatti, kitaaba seenaa Naataan nabiiʼiyyichaa keessattii fi kitaaba seenaa Gaad namicha mulʼata argu sanaa keessatti, <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />bulchiinsi isaa hundii fi humni isaa, barri inni, Israaʼelii fi mootummoonni biyyoota hundaa keessa darban barreeffameera.<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>