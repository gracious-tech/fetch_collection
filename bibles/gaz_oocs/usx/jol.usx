  <para style="h">Yooʼeel</para>
  <para style="toc1">Nabiiʼiyyii Yooʼeel</para>
  <para style="toc2">Yooʼeel</para>
  <para style="toc3">Yoe</para>
  <para style="mt2">Nabiiʼiyyii</para>
  <para style="mt1">Yooʼeel</para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />Dubbii Rabbii Allaah kan gara Yooʼeel ilma Phetuuʼeel dhufe.<verse eid="JOL 1:1" /></para>
  <para style="b" />
  <para style="s1">Weerara Hawwaannisaa</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2" />Yaa maanguddoota, waan kana dhagaʼaa;</para>
  <para style="q2" vid="JOL 1:2">warri biyyattii keessa jiraattan hundinuu dhaggeeffadhaa.</para>
  <para style="q1" vid="JOL 1:2">Wanni akkanaa takkumaa bara keessan keessa</para>
  <para style="q2" vid="JOL 1:2">yookaan bara abbootii keessanii keessa taʼee beekaa?<verse eid="JOL 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3" />Isin waan kana ijoollee keessanitti himaa;</para>
  <para style="q2" vid="JOL 1:3">ijoolleen keessanis ijoollee ofii isaaniitti haa himan;</para>
  <para style="q2" vid="JOL 1:3">ijoolleen isaanii immoo dhaloota itti aanutti haa dabarsan.<verse eid="JOL 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4" />Waan tuunni hawwaannisaa dhiise,</para>
  <para style="q2" vid="JOL 1:4">hawwaannisni guddaan fixe;</para>
  <para style="q1" vid="JOL 1:4">waan hawwaannisni guddaan dhiise,</para>
  <para style="q2" vid="JOL 1:4">hawwaannisni xixinnaan nyaatee fixe;</para>
  <para style="q1" vid="JOL 1:4">waan hawwaannisni xixinnaan dhiise immoo</para>
  <para style="q2" vid="JOL 1:4">hawwaannisni biraa dhufee nyaate.<verse eid="JOL 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5" />Yaa machooftota, kaʼaatii booʼaa!</para>
  <para style="q2" vid="JOL 1:5">Isin warri daadhii wayinii dhugdan <optbreak /> hundinuu wawwaadhaa;</para>
  <para style="q1" vid="JOL 1:5">sababii daadhii wayinii haaraatiif <optbreak /> wawwaadhaa;</para>
  <para style="q2" vid="JOL 1:5">inni afaan keessan irraa butameeraatii.<verse eid="JOL 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6" />Sabni jabaan akka malee baayʼeen tokko</para>
  <para style="q2" vid="JOL 1:6">biyya koo weerareera;</para>
  <para style="q1" vid="JOL 1:6">inni ilkaan leencaa,</para>
  <para style="q2" vid="JOL 1:6">qarriffaa leenca dhalaa qaba.<verse eid="JOL 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7" />Inni muka wayinii koo onsee</para>
  <para style="q2" vid="JOL 1:7">harbuu koos barbadeesseera.</para>
  <para style="q1" vid="JOL 1:7">Inni qola isaanii irraa quncisee lafatti gatee</para>
  <para style="q2" vid="JOL 1:7">dameelee isaanii duwwaa hambise.<verse eid="JOL 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8" />Isin akkuma durba wayyaa gaddaa uffattee</para>
  <para style="q2" vid="JOL 1:8">dhirsa ijoollummaa isheetiif gaddituutti booʼaa.<verse eid="JOL 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9" />Kennaan midhaaniitii fi dhibaayyuun</para>
  <para style="q2" vid="JOL 1:9">mana Rabbii Allaah irraa citaniiru.</para>
  <para style="q1" vid="JOL 1:9">Luboonni fuula Rabbii Allaah dura tajaajilan</para>
  <para style="q2" vid="JOL 1:9">booʼaa jiru.<verse eid="JOL 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10" />Lafti qotiisaa oneera;</para>
  <para style="q2" vid="JOL 1:10">laftis gogeera;</para>
  <para style="q1" vid="JOL 1:10">midhaan barbadaaʼeera;</para>
  <para style="q2" vid="JOL 1:10">daadhiin wayinii haaraan dhumeera;</para>
  <para style="q2" vid="JOL 1:10">zayitiinis dhabameera.<verse eid="JOL 1:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11" />Yaa qonnaan bultoota, isin raafamaa;</para>
  <para style="q2" vid="JOL 1:11">warri wayinii dhaabbattan booʼaa;</para>
  <para style="q1" vid="JOL 1:11">sababii midhaan lafa qotiisaa keessanii</para>
  <para style="q2" vid="JOL 1:11">barbadaaʼeef qamadii fi garbuudhaaf booʼaa.<verse eid="JOL 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12" />Wayiniin gogeera;</para>
  <para style="q2" vid="JOL 1:12">harbuunis coollageera;</para>
  <para style="q1" vid="JOL 1:12">roomaaniin, meexxii fi hudhaan,</para>
  <para style="q2" vid="JOL 1:12">mukkeen lafa qotiisaa hundinuu goganiiru.</para>
  <para style="q1" vid="JOL 1:12">Dhugumaan gammachuun ilmaan namaa</para>
  <para style="q2" vid="JOL 1:12">irraa badeera.<verse eid="JOL 1:12" /></para>
  <para style="s1">Waamicha Qalbii Jijjiirrachuu</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13" />Yaa luboota, wayyaa gaddaa uffadhaatii booʼaa;</para>
  <para style="q2" vid="JOL 1:13">isin warri iddoo aarsaa dura tajaajiltan wawwaadhaa.</para>
  <para style="q1" vid="JOL 1:13">Isin warri fuula Allaah koo dura tajaajiltan</para>
  <para style="q2" vid="JOL 1:13">kottaatii wayyaa gaddaa uffadhaa bulaa;</para>
  <para style="q1" vid="JOL 1:13">kennaan midhaaniitii fi dhibaayyuun</para>
  <para style="q2" vid="JOL 1:13">mana Allaaha irraa hambifamaniiruutii.<verse eid="JOL 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14" />Sooma qulqulluu labsaa;</para>
  <para style="q2" vid="JOL 1:14">waldaa qulqulluu waamaa.</para>
  <para style="q1" vid="JOL 1:14">Maanguddootaa fi</para>
  <para style="q2" vid="JOL 1:14">warra biyyattii keessa jiraatan hunda</para>
  <para style="q1" vid="JOL 1:14">gara mana Rabbii Allaah, Allaah keessaniitti waamaatii</para>
  <para style="q2" vid="JOL 1:14">Rabbii Allaahatti booʼaa.<verse eid="JOL 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15" />Badne kaa! Guyyaan sun dhiʼaateera.</para>
  <para style="q2" vid="JOL 1:15">Guyyaan Rabbii Allaah gaʼeeraatii;</para>
  <para style="q2" vid="JOL 1:15">inni akkuma badiisaatti <optbreak /> Allaah Waan Hunda Dandaʼu biraa dhufa.<verse eid="JOL 1:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16" />Ijuma keenya duratti</para>
  <para style="q2" vid="JOL 1:16">nyaanni cite;</para>
  <para style="q1" vid="JOL 1:16">ilillee fi gammachuunis</para>
  <para style="q2" vid="JOL 1:16">mana Allaah keenyaa irraa hin cinnee?<verse eid="JOL 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17" />Sanyiin lafa keessatti</para>
  <para style="q2" vid="JOL 1:17">tortoree hafe.</para>
  <para style="q1" vid="JOL 1:17">Mankuusni diigameera;</para>
  <para style="q2" vid="JOL 1:17">gombisaan caccabeera;</para>
  <para style="q2" vid="JOL 1:17">midhaan gogee hafeeraatii.<verse eid="JOL 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18" />Loon akkam marʼatu!</para>
  <para style="q2" vid="JOL 1:18">Karri loonii sababii waan dheedu dhabeef</para>
  <para style="q1" vid="JOL 1:18">asii fi achi joora;</para>
  <para style="q2" vid="JOL 1:18">bushaayeenis dhiphataniiru.<verse eid="JOL 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19" />Rabbii Allaah ani sin waammadha;</para>
  <para style="q2" vid="JOL 1:19">ibiddi lafa dheedaa barbadeessee</para>
  <para style="q2" vid="JOL 1:19">arrabni ibiddaa immoo mukkeen diidaa hunda gubee fixeeraatii.<verse eid="JOL 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20" />Bineensonni bosonaa sitti gaggabu;</para>
  <para style="q2" vid="JOL 1:20">lagni bishaanii gogeera;</para>
  <para style="q2" vid="JOL 1:20">ibiddis dirree dheedaa gubee balleesseera.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s1">Raayyaa Hawwaanisaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1" />Xiyoon keessatti malakata afuufaa;</para>
  <para style="q2" vid="JOL 2:1">gaara koo qulqulluu irratti sagalee <optbreak /> akeekkachiisaa dhageessisaa.</para>
  <para style="b" vid="JOL 2:1" />
  <para style="q1" vid="JOL 2:1">Guyyaan Rabbii Allaah dhufaa jiraatii;</para>
  <para style="q2" vid="JOL 2:1">warri lafa irra jiraatan hundi haa hollatan.</para>
  <para style="q1" vid="JOL 2:1">Guyyaan sun dhiʼaateera;<verse eid="JOL 2:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="JOL 2:2" />guyyaan dukkanaatii fi dimimmisaa,</para>
  <para style="q2" vid="JOL 2:2">guyyaan duumessaatii fi dukkana hamaa ni dhufa.</para>
  <para style="q1" vid="JOL 2:2">Sabni guddaa fi jabaan tokko</para>
  <para style="q2" vid="JOL 2:2">akkuma ifa ganama tulluuwwan irratti baʼuutti ni dhufa;</para>
  <para style="q1" vid="JOL 2:2">wanni akkasii takkumaa bara durii keessa taʼee hin beeku</para>
  <para style="q2" vid="JOL 2:2">yookaan dhaloota dhufuuf jiru keessatti illee hin taʼu.<verse eid="JOL 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3" />Fuula isaanii duraa ibiddi ni barbadeessa;</para>
  <para style="q2" vid="JOL 2:3">dugda isaanii duubaan immoo arraba ibiddaatu bobaʼa.</para>
  <para style="q1" vid="JOL 2:3">Fuula isaanii duraan lafti iddoo biqiltuu Eeden fakkaata;</para>
  <para style="q2" vid="JOL 2:3">dugda isaanii duubaan immoo lafti akkuma gammoojjii onee ti;</para>
  <para style="q2" vid="JOL 2:3">wanni tokko iyyuu isaan duraa hin miliqu.<verse eid="JOL 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4" />Isaan bifa fardeenii qabu;</para>
  <para style="q2" vid="JOL 2:4">akkuma fardeen lolaas ni gulufu.<verse eid="JOL 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5" />Isaan sagalee akka gaarii waraanaatiin</para>
  <para style="q2" vid="JOL 2:5">fiixee tulluu irra utaalu;</para>
  <para style="q1" vid="JOL 2:5">akkuma ibidda yeroo qarmii gubutti xaaxaʼuu,</para>
  <para style="q2" vid="JOL 2:5">akkuma waraana jabaa lolaaf baʼe tokkoo ti.<verse eid="JOL 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6" />Saboonni jara arginii dhiphatu;</para>
  <para style="q2" vid="JOL 2:6">fuulli nama hundaas ni gurraachaʼa.<verse eid="JOL 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7" />Isaan akkuma namoota jajjaboo fiigu;</para>
  <para style="q2" vid="JOL 2:7">akkuma loltootaa dallaa yaabbatanii seenu.</para>
  <para style="q1" vid="JOL 2:7">Hundi isaanii tarree galanii deemu;</para>
  <para style="q2" vid="JOL 2:7">isaan keessaa tokko iyyuu daandii isaa irraa hin jalʼatu.<verse eid="JOL 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8" />Isaan wal hin dhiiban;</para>
  <para style="q2" vid="JOL 2:8">hundi isaanii qajeelanii fuula duratti deemu.</para>
  <para style="q1" vid="JOL 2:8">Utuu toora isaanii hin dhiisin</para>
  <para style="q2" vid="JOL 2:8">ittisa cabsanii seenu.<verse eid="JOL 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9" />Isaan magaalaa keessa asii fi achi fiigu;</para>
  <para style="q2" vid="JOL 2:9">dallaa irra fiigu.</para>
  <para style="q1" vid="JOL 2:9">Isaan mana yaabbatu;</para>
  <para style="q2" vid="JOL 2:9">akkuma hattuus foddaadhaan ol seenu.<verse eid="JOL 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10" />Fuula isaanii duratti lafti ni sochooti;</para>
  <para style="q2" vid="JOL 2:10">shamaayʼuniin ni raafama;</para>
  <para style="q1" vid="JOL 2:10">aduu fi jiʼi ni dukkanaaʼu;</para>
  <para style="q2" vid="JOL 2:10">urjiiwwan deebiʼanii hin ibsan.<verse eid="JOL 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11" />Rabbii Allaahan fuula loltoota isaa duratti</para>
  <para style="q2" vid="JOL 2:11">sagalee dhageessisa;</para>
  <para style="q1" vid="JOL 2:11">loltoonni isaa akka malee baayʼee dha;</para>
  <para style="q2" vid="JOL 2:11">warri ajaja isaa eegan jajjaboo dha.</para>
  <para style="q1" vid="JOL 2:11">Guyyaan Rabbii Allaah sun guddaa dha;</para>
  <para style="q2" vid="JOL 2:11">guyyaan sun akka malee nama sodaachisa.</para>
  <para style="q2" vid="JOL 2:11">Eenyutu dura dhaabachuu dandaʼa?<verse eid="JOL 2:11" /></para>
  <para style="s1">Cubbuu Irraa Deebiʼaa</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12" />“Amma iyyuu garaa guutuudhaan,</para>
  <para style="q2" vid="JOL 2:12">soomaan, booʼichaa fi gaddaan</para>
  <para style="q2" vid="JOL 2:12">gara kootti deebiʼaa” jedha Rabbii Allaahan.<verse eid="JOL 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13" />Isin utuu wayyaa keessan hin taʼin</para>
  <para style="q2" vid="JOL 2:13">garaa keessan tarsaasaa.</para>
  <para style="q1" vid="JOL 2:13">Gara Rabbii Allaah keessaniitti deebiʼaa;</para>
  <para style="q2" vid="JOL 2:13">inni arjaa fi gara laafessaatii;</para>
  <para style="q1" vid="JOL 2:13">inni dafee hin aaru; jaalalli isaa baayʼee dha;</para>
  <para style="q2" vid="JOL 2:13">inni badiisa erguu irraa of qusata.<verse eid="JOL 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14" />Maaltu beeka? Tarii inni deebiʼee gaabbee</para>
  <para style="q2" vid="JOL 2:14">eebba, kennaa midhaaniitii fi kennaa dhugaatii</para>
  <para style="q1" vid="JOL 2:14">kan Rabbii Allaah keessaniif taʼu</para>
  <para style="q2" vid="JOL 2:14">isiniif hambisa taʼa.<verse eid="JOL 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15" />Xiyoon keessatti malakata afuufaa;</para>
  <para style="q2" vid="JOL 2:15">sooma qulqulluu labsaa;</para>
  <para style="q2" vid="JOL 2:15">waldaa qulqulluu waamaa.<verse eid="JOL 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16" />Saba walitti qabaa;</para>
  <para style="q2" vid="JOL 2:16">waldaa sana qulqulleessaa;</para>
  <para style="q1" vid="JOL 2:16">maanguddoota walitti fidaa;</para>
  <para style="q2" vid="JOL 2:16">ijoollee walitti qabaa;</para>
  <para style="q2" vid="JOL 2:16">daaʼimman harma hodhan illee hin hambisinaa.</para>
  <para style="q1" vid="JOL 2:16">Misirrichi kutaa isaa keessaa haa baʼu;</para>
  <para style="q2" vid="JOL 2:16">misirrittiinis diinqa isheetii haa baatu.<verse eid="JOL 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17" />Luboonni fuula Rabbii Allaah dura tajaajilan</para>
  <para style="q2" vid="JOL 2:17">gardaafoo fi iddoo aarsaa gidduutti haa booʼan.</para>
  <para style="q1" vid="JOL 2:17">Isaan akkana haa jedhan; “Rabbii Allaah saba kee baraari.</para>
  <para style="q2" vid="JOL 2:17">Handhuuraa kee waan qoosaa,</para>
  <para style="q2" vid="JOL 2:17">saboota gidduuttis waan kolfaa hin godhin.</para>
  <para style="q1" vid="JOL 2:17">Isaan maaliif namoota gidduutti,</para>
  <para style="q2" vid="JOL 2:17">‘Allaahan isaanii eessa jira?’ jedhu?”<verse eid="JOL 2:17" /></para>
  <para style="s1">Deebii Rabbii Allaahan Kenne</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18" />Rabbii Allaahan biyya isaatiif ni hinaafa;</para>
  <para style="q2" vid="JOL 2:18">saba isaatiifis garaa laafa.<verse eid="JOL 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOL 2:19" />Rabbii Allaahan akkana jedhee deebii kennaaf:</para>
  <para style="q1" vid="JOL 2:19">“Ani midhaan, daadhii wayinii haaraa fi zayitii ejersaa</para>
  <para style="q2" vid="JOL 2:19">kan isin quubsu isiniif nan erga;</para>
  <para style="q1" vid="JOL 2:19">ani lammata saboota gidduutti</para>
  <para style="q2" vid="JOL 2:19">waan qoosaa isin hin godhu.<verse eid="JOL 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20" />“Ani loltoota kaabaa isin duraa balleessee</para>
  <para style="q2" vid="JOL 2:20">gara lafa gogaa fi duwwaatti isaan ariʼa;</para>
  <para style="q1" vid="JOL 2:20">loltoonni fuula duraan yaaʼan galaana baʼa biiftuu,</para>
  <para style="q2" vid="JOL 2:20">kanneen dugda duubaan yaaʼan immoo <optbreak /> galaana gama lixa biiftuu seenu.</para>
  <para style="q1" vid="JOL 2:20">Reeffi isaanii ni xiraaʼa;</para>
  <para style="q2" vid="JOL 2:20">xiraan isaaniis ol baʼa.”</para>
  <para style="b" vid="JOL 2:20" />
  <para style="q1" vid="JOL 2:20">Dhugumaan inni waan guddaa hojjeteera!<verse eid="JOL 2:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="JOL 2:21" />Yaa biyya Yihuudaa, hin sodaatin;</para>
  <para style="q2" vid="JOL 2:21">gammadiitii ililchi.</para>
  <para style="q1" vid="JOL 2:21">Rabbii Allaahan dhugumaan waan guddaa hojjeteera!<verse eid="JOL 2:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOL 2:22" />Yaa bineensota bosonaa, isinis hin sodaatinaa;</para>
  <para style="q2" vid="JOL 2:22">dirreen dheedaa gabbachaa jiraatii.</para>
  <para style="q1" vid="JOL 2:22">Mukkeen ija naqachaa,</para>
  <para style="q2" vid="JOL 2:22">harbuu fi wayiniinis ija kennaa jiru.<verse eid="JOL 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23" />Yaa uummata Xiyoon gammadi;</para>
  <para style="q2" vid="JOL 2:23">Rabbii Allaah keetti gammadi;</para>
  <para style="q1" vid="JOL 2:23">inni qajeelummaadhaan</para>
  <para style="q2" vid="JOL 2:23">rooba arfaasaa siif kenneeraatii.</para>
  <para style="q1" vid="JOL 2:23">Inni akkuma durii bokkaa baayʼee,</para>
  <para style="q2" vid="JOL 2:23">rooba arfaasaa fi kan birraa siif erga.<verse eid="JOL 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24" />Oobdiin midhaaniin guutama;</para>
  <para style="q2" vid="JOL 2:24">boolli itti wayinii cuunfanis daadhii wayinii haaraa fi <optbreak /> zayitiidhaan guutamanii dhangalaasu.<verse eid="JOL 2:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25" />“Ani waan bara hawwaannisni nyaate,</para>
  <para style="q2" vid="JOL 2:25">waan hawwaannisni gurguddaa fi xixinnaan nyaate,</para>
  <para style="q2" vid="JOL 2:25">waan hawwaannisni kaanii fi tuunni hawwaannisaa</para>
  <para style="q1" vid="JOL 2:25">jechuunis loltoonni koo jajjaboon ani gidduu keessanitti erge sun <optbreak /> yaatan iddoo isiniif nan buusa.<verse eid="JOL 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26" />Isin waan hamma quuftanitti nyaattan baayʼee ni qabaattu;</para>
  <para style="q2" vid="JOL 2:26">maqaa Rabbii Allaah keessanii</para>
  <para style="q2" vid="JOL 2:26">kan waan dinqii isiniif hojjete sanaa ni galateeffattu;</para>
  <para style="q1" vid="JOL 2:26">uummanni koo lammata hin qaaneffamu.<verse eid="JOL 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27" />Ergasii isin akka ani Israaʼel keessa jiru</para>
  <para style="q2" vid="JOL 2:27">akka ani Rabbii Allaah keessan taʼe,</para>
  <para style="q2" vid="JOL 2:27">akka ana malee Allaahan biraa hin jirre ni beektu;</para>
  <para style="q1" vid="JOL 2:27">uummanni koo lammata hin qaaneffamu.<verse eid="JOL 2:27" /></para>
  <para style="s1">Guyyaa Rabbii Allaah</para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28" />“Anis kana booddee,</para>
  <para style="q2" vid="JOL 2:28">Hafuura koo nama hunda irratti nan dhangalaasa.</para>
  <para style="q1" vid="JOL 2:28">Ilmaanii fi intallan keessan raajii dubbatu;</para>
  <para style="q2" vid="JOL 2:28">jaarsoliin keessan abjuu abjootu;</para>
  <para style="q2" vid="JOL 2:28">dargaggoonni keessan mulʼata argu.<verse eid="JOL 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29" />Bara sana keessa, garboota koo</para>
  <para style="q2" vid="JOL 2:29">warra dhiiraa fi dubartii irratti illee</para>
  <para style="q2" vid="JOL 2:29">Hafuura koo nan dhangalaasa.<verse eid="JOL 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30" />Ani ol shamaayʼun irratti dinqii,</para>
  <para style="q2" vid="JOL 2:30">gad lafa irrattis dhiiga,</para>
  <para style="q2" vid="JOL 2:30">ibiddaa fi hurrii aaraa nan argisiisa.<verse eid="JOL 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31" />Utuu guyyaan Rabbii Allaah inni guddichii fi</para>
  <para style="q2" vid="JOL 2:31">sodaachisaan sun hin dhufin dura,</para>
  <para style="q2" vid="JOL 2:31">aduun dukkanatti geeddaramti;</para>
  <para style="q2" vid="JOL 2:31">jiʼi immoo dhiigatti geeddarama.<verse eid="JOL 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32" />Namni maqaa Rabbii Allaah waammatu</para>
  <para style="q2" vid="JOL 2:32">hundinuu ni fayya;</para>
  <para style="q1" vid="JOL 2:32">akkuma Rabbii Allaahan dubbatettis</para>
  <para style="q2" vid="JOL 2:32">Tulluu Xiyoon irraa fi</para>
  <para style="q2" vid="JOL 2:32">Yerusaalem keessa, furamatu jiraata;</para>
  <para style="q1" vid="JOL 2:32">hambaa gidduuttis warri Rabbii Allaahan</para>
  <para style="q2" vid="JOL 2:32">isaan waame ni argamu.<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s1">Sabootatti Murame</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1" />“Bara sana keessa, yeroo sanatti,</para>
  <para style="q2" vid="JOL 3:1">ani yommuun boojuu Yihuudaatii fi <optbreak /> Yerusaalem deebisutti,<verse eid="JOL 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2" />saboota hunda walitti qabeen</para>
  <para style="q2" vid="JOL 3:2">gara Sulula Yehooshaafaaxitti <optbreak /> gad isaan nan buusa.</para>
  <para style="q1" vid="JOL 3:2">Anis achitti sababii dhaala koo,</para>
  <para style="q2" vid="JOL 3:2">sababii Israaʼeliif isaanitti nan mura;</para>
  <para style="q1" vid="JOL 3:2">isaan saboota gidduutti saba koo</para>
  <para style="q2" vid="JOL 3:2">bittinneessanii biyya koos gargar qooddataniiruutii.<verse eid="JOL 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3" />Isaan uummata kootti ixaa buufatanii</para>
  <para style="q2" vid="JOL 3:3">ijoollee dhiiraas sagaagalummaatti geeddarataniiru;</para>
  <para style="q2" vid="JOL 3:3">akka dhuganiif dubara illee daadhii wayiniitti gurguratan.<verse eid="JOL 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4" />“Yaa Xiiroosii fi Siidoonaa, isin kutaaleen Filisxeem hundinuu, amma maal narraa qabdu? Isin waan ani godheef haaloo na baafachaa jirtuu? Yoo isin haaloo na baafachaa jirtu taʼe ani dafee ariitiidhaan waan isin hojjettan sana matuma keessanittin deebisa. <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />Isin meetii fi warqee koo guurrattanii qabeenya koo filatamaas mana waaqeffannaa keessanitti geeffattaniirtuutii. <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />Isin biyya isaanii irraa isaan fageessitanii uummata Yihuudaatii fi Yerusaalem Giriikotatti gurgurattan.<verse eid="JOL 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7" />“Kunoo, ani biyya isin itti isaan gurgurattan keessaa isaan baasee waan isin hojjettan sana matuma keessanitti nan deebisa. <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />Ani ilmaanii fi intallan keessan saba Yihuudaatti nan gurgura; isaan immoo saba fagoo jiru kan Saabaa jedhamutti dabarsanii isaan gurguratu.” Rabbii Allaahan dubbateeraatii.<verse eid="JOL 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9" />Waan kana saboota gidduutti labsaa:</para>
  <para style="q2" vid="JOL 3:9">Waraanaaf qophaaʼaa!</para>
  <para style="q1" vid="JOL 3:9">Gootota kakaasaa!</para>
  <para style="q2" vid="JOL 3:9">Loltoonni hundi dhiʼaatanii haa lolan.<verse eid="JOL 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10" />Maarashaa keessan tumaatii goraadee godhadhaa;</para>
  <para style="q2" vid="JOL 3:10">haamtuu keessanis tumaatii eeboo godhadhaa.</para>
  <para style="q1" vid="JOL 3:10">Namni laafaan,</para>
  <para style="q2" vid="JOL 3:10">“Ani jabaa dha!” haa jedhu.<verse eid="JOL 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11" />Isin saboonni qixa hundaan dafaa kottaattii</para>
  <para style="q2" vid="JOL 3:11">achitti walitti qabamaa.</para>
  <para style="b" vid="JOL 3:11" />
  <para style="q1" vid="JOL 3:11">Rabbii Allaah, loltoota kee gad ergi!<verse eid="JOL 3:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12" />“Saboonni haa kaʼan;</para>
  <para style="q2" vid="JOL 3:12">isaan dafanii gara Sulula Yehooshaafaax haa dhufan;</para>
  <para style="q1" vid="JOL 3:12">ani saboota gama hundaan jiranitti muruuf</para>
  <para style="q2" vid="JOL 3:12">achi nan taaʼaatii.<verse eid="JOL 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13" />Midhaan gaʼeeraatii</para>
  <para style="q2" vid="JOL 3:13">haamtuu itti kaaʼaa.</para>
  <para style="q1" vid="JOL 3:13">Kottaatii ija wayinii dhidhiitaa;</para>
  <para style="q2" vid="JOL 3:13">boolli itti wayinii cuunfan guuteeraatii;</para>
  <para style="q2" vid="JOL 3:13">sababii hamminni isaanii guddaa taʼeef</para>
  <para style="q1" vid="JOL 3:13">boolli itti wayinii cuunfan guutee irra dhangalaʼeera!”<verse eid="JOL 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14" />Waldaan guddaan, waldaan nama baayʼee</para>
  <para style="q2" vid="JOL 3:14">sulula murtii keessatti wal gaʼeera!</para>
  <para style="q1" vid="JOL 3:14">Guyyaan Rabbii Allaaha</para>
  <para style="q2" vid="JOL 3:14">sulula murtii keessatti dhufuu gaʼeeraatii.<verse eid="JOL 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15" />Biiftuu fi addeessi ni dukkanaaʼu;</para>
  <para style="q2" vid="JOL 3:15">urjiiwwanis siʼachi ifa hin kennan.<verse eid="JOL 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16" />Rabbii Allaahan Xiyoon irraa ni iyya;</para>
  <para style="q2" vid="JOL 3:16">Yerusaalem keessaas sagalee dhageessisa;</para>
  <para style="q2" vid="JOL 3:16">lafaa fi shamaayʼuniin ni raafamu.</para>
  <para style="q1" vid="JOL 3:16">Rabbii Allaahan garuu saba isaatiif iddoo itti baqatan,</para>
  <para style="q2" vid="JOL 3:16">saba Israaʼeliif immoo daʼoo ni taʼa.<verse eid="JOL 3:16" /></para>
  <para style="s1">Eebba Saba Allaahatiif kenname</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17" />“Ergasii isin akka ani Rabbii Allaahan keessan Xiyoon keessa,</para>
  <para style="q2" vid="JOL 3:17">gaara koo qulqulluu sana irra jiraadhu ni beektu.</para>
  <para style="q1" vid="JOL 3:17">Yerusaalem qulqulluu taati;</para>
  <para style="q2" vid="JOL 3:17">namoonni biyya alaa gonkumaa lammata ishee hin weeraran.<verse eid="JOL 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18" />“Gaafas tulluuwwan daadhii wayinii haaraa ni coccobsu;</para>
  <para style="q2" vid="JOL 3:18">gaarranis aannan yaasu;</para>
  <para style="q2" vid="JOL 3:18">lageen Yihuudaa hundinuu bishaaniin guutamu.</para>
  <para style="q1" vid="JOL 3:18">Burqaan tokko mana Rabbii Allaah keessaa</para>
  <para style="q2" vid="JOL 3:18">burqee sulula Shixiim ni obaasa.<verse eid="JOL 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19" />Gibxi garuu ni onti;</para>
  <para style="q2" vid="JOL 3:19">Edoomis duwwaa hafti;</para>
  <para style="q1" vid="JOL 3:19">isaan dhiiga nama yakka hin qabnee biyyattii keessatti <optbreak /> dhangalaasuudhaan</para>
  <para style="q2" vid="JOL 3:19">saba Yihuudaatti daba hojjetaniiruutii.<verse eid="JOL 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20" />Yihuudaan bara baraan,</para>
  <para style="q2" vid="JOL 3:20">Yerusaalemis dhaloota hundaaf iddoo jireenyaa ni taati.<verse eid="JOL 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21" />Ani dhiiga isaanii kan yakka hin qabne sana</para>
  <para style="q2" vid="JOL 3:21">utuun haaloo hin baʼin nan dhiisaa?</para>
  <para style="q2" vid="JOL 3:21">Lakkii, hin dhiisu.”</para>
  <para style="b" vid="JOL 3:21" />
  <para style="qc" vid="JOL 3:21">Rabbii Allaahan Xiyoon keessa jiraata!<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>