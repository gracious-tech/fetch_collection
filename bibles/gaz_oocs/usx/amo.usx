  <para style="h">Amoos</para>
  <para style="toc1">Nabiiʼiyyii Amoos</para>
  <para style="toc2">Amoos</para>
  <para style="toc3">Amo</para>
  <para style="mt2">Nabiiʼiyyii</para>
  <para style="mt1">Amoos</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />Kun mulʼata Amoos inni tikseewwan Teqooʼaa keessaa tokko ture sun bara Uziyaan mootii Yihuudaa, Yerobiʼaam ilmi Yooʼaash immoo mootii Israaʼel turetti, utuu sochiin lafaa hin taʼin waggaa lama dura waaʼee Israaʼel argee dha.<verse eid="AMO 1:1" /></para>
  <para style="b" />
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2" />Innis akkana jedhe:</para>
  <para style="q1" vid="AMO 1:2">“Rabbii Allaahan Xiyoon keessaa iyya;</para>
  <para style="q2" vid="AMO 1:2">Yerusaalem keessaa sagalee dhageessisa;</para>
  <para style="q1" vid="AMO 1:2">dirreen tiksoonni itti bobbaasan ni goga;</para>
  <para style="q2" vid="AMO 1:2">fiixeen gaara Qarmeloosis ni coollaga.”<verse eid="AMO 1:2" /></para>
  <para style="s1">Murtii Olloota Israaʼelitti Murame</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />Rabbii Allaahan akkana jedha:</para>
  <para style="q1" vid="AMO 1:3">“Ani cubbuu Damaasqoo sadiif,</para>
  <para style="q2" vid="AMO 1:3">afuriifis dheekkamsa koo duubatti hin deebisu.</para>
  <para style="q1" vid="AMO 1:3">Sababii isaan meeshaa ittiin midhaan dhaʼan</para>
  <para style="q2" vid="AMO 1:3">kan ilkaan sibiilaa qabuun Giliʼaadin tumaniif,<verse eid="AMO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4" />ani ibidda daʼannoo Ben-Hadaad</para>
  <para style="q2" vid="AMO 1:4">barbadeessu tokko, mana Hazaaʼeelitti nan erga.<verse eid="AMO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5" />Ani karra Damaasqoo nan cabsa;</para>
  <para style="q2" vid="AMO 1:5">mootii Sulula Aween keessa jiruu fi</para>
  <para style="q1" vid="AMO 1:5">isa Beet Eden keessatti bokkuu qabatu nan balleessa.</para>
  <para style="q2" vid="AMO 1:5">Uummanni Sooriyaa boojiʼamee Qiiritti ni geeffama”</para>
  <para style="q2" vid="AMO 1:5">jedha Rabbii Allaahan.<verse eid="AMO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />Rabbii Allaahan akkana jedha:</para>
  <para style="q1" vid="AMO 1:6">“Ani cubbuu Gaazaa sadiif,</para>
  <para style="q2" vid="AMO 1:6">afuriifis dheekkamsa koo duubatti hin deebisu.</para>
  <para style="q1" vid="AMO 1:6">Sababii isheen hawaasa hunda boojitee</para>
  <para style="q2" vid="AMO 1:6">Edoomitti gurguratteef,<verse eid="AMO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7" />ani ibidda daʼannoo ishee barbadeessu tokko</para>
  <para style="q2" vid="AMO 1:7">dallaa Gaazaatti nan erga.<verse eid="AMO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8" />Ani mootii Ashdoodii fi isa Ashqaloon keessatti</para>
  <para style="q2" vid="AMO 1:8">bokkuu qabatu sana nan balleessa.</para>
  <para style="q1" vid="AMO 1:8">Ani hamma hambaan Filisxeemotaa duʼuutti</para>
  <para style="q2" vid="AMO 1:8">harka koo Eqroonitti nan deebifadha”</para>
  <para style="q2" vid="AMO 1:8">jedha Rabbii Allaahan Gooftaan.<verse eid="AMO 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />Rabbii Allaahan akkana jedha:</para>
  <para style="q1" vid="AMO 1:9">“Ani cubbuu Xiiroos sadiif,</para>
  <para style="q2" vid="AMO 1:9">afuriifis dheekkamsa koo duubatti hin deebisu.</para>
  <para style="q1" vid="AMO 1:9">Sababii isheen walii galtee obbolummaa cabsitee</para>
  <para style="q2" vid="AMO 1:9">hawaasa boojiʼame guutuu Edoomitti gurguratteef<verse eid="AMO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10" />ani ibidda daʼannoo ishee barbadeessu tokko</para>
  <para style="q2" vid="AMO 1:10">dallaa Xiiroositti nan erga.”<verse eid="AMO 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />Rabbii Allaahan akkana jedha:</para>
  <para style="q1" vid="AMO 1:11">“Ani cubbuu Edoom sadiif,</para>
  <para style="q2" vid="AMO 1:11">afuriifis dheekkamsa koo duubatti hin deebisu.</para>
  <para style="q1" vid="AMO 1:11">Sababii inni gara laafina hunda gatee</para>
  <para style="q2" vid="AMO 1:11">obboleessa isaa goraadeedhaan ariʼeef,</para>
  <para style="q1" vid="AMO 1:11">sababii aariin isaa ittuma fufee hoʼee</para>
  <para style="q2" vid="AMO 1:11">dheekkamsi isaas utuu hin dhowwamin bobaʼeef,<verse eid="AMO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12" />ani ibidda daʼannoo Bozraa barbadeessu tokko</para>
  <para style="q2" vid="AMO 1:12">Teemaanitti nan erga.”<verse eid="AMO 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />Rabbii Allaahan akkana jedha:</para>
  <para style="q1" vid="AMO 1:13">“Ani cubbuu Amoon sadiif,</para>
  <para style="q2" vid="AMO 1:13">afuriifis dheekkamsa koo duubatti hin deebisu.</para>
  <para style="q1" vid="AMO 1:13">Sababii inni daangaa isaa babalʼifachuuf jedhee</para>
  <para style="q2" vid="AMO 1:13">dubartoota Giliʼaad kanneen ulfa qaban baqaqseef<verse eid="AMO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14" />ani guyyaa lolaatti wacaan,</para>
  <para style="q2" vid="AMO 1:14">guyyaa qilleensa hamaatti immoo bubbee jabaadhaan</para>
  <para style="q1" vid="AMO 1:14">ibidda daʼannoo ishee barbadeessu tokko</para>
  <para style="q2" vid="AMO 1:14">dallaa Rabbaatti nan erga.<verse eid="AMO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15" />Mootiin ishee boojiʼamee innii fi</para>
  <para style="q2" vid="AMO 1:15">qondaaltonni isaa wajjin ni boojiʼamu”</para>
  <para style="q2" vid="AMO 1:15">jedha Rabbii Allaahan.<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />Rabbii Allaahan akkana jedha:</para>
  <para style="q1" vid="AMO 2:1">“Ani cubbuu Moʼaab sadiif,</para>
  <para style="q2" vid="AMO 2:1">afuriifis dheekkamsa koo duubatti hin deebisu.</para>
  <para style="q1" vid="AMO 2:1">Sababii inni lafee mootii Edoom</para>
  <para style="q2" vid="AMO 2:1">gubee daaraa godheef,<verse eid="AMO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2" />ani ibidda daʼannoo Keriiyooti barbadeessu tokko</para>
  <para style="q2" vid="AMO 2:2">Moʼaabitti nan erga.</para>
  <para style="q1" vid="AMO 2:2">Moʼaab iyya waraanaatii fi</para>
  <para style="q2" vid="AMO 2:2">sagalee malakataatiin duʼa.<verse eid="AMO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3" />Ani bulchaa ishee ajjeesee</para>
  <para style="q2" vid="AMO 2:3">qondaaltota ishee hundas isa wajjinin fixa”</para>
  <para style="q2" vid="AMO 2:3">jedha Rabbii Allaahan.<verse eid="AMO 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />Rabbii Allaahan akkana jedha:</para>
  <para style="q1" vid="AMO 2:4">“Ani cubbuu Yihuudaa sadiif,</para>
  <para style="q2" vid="AMO 2:4">afuriifis dheekkamsa koo duubatti hin deebisu.</para>
  <para style="q1" vid="AMO 2:4">Sababii isaan seera Rabbii Allaah didanii</para>
  <para style="q2" vid="AMO 2:4">ajaja isaas hin eeginiif,</para>
  <para style="q1" vid="AMO 2:4">sababii isaan waaqeffatamtoota sobaa,</para>
  <para style="q2" vid="AMO 2:4">waaqeffatamtoota abbootiin isaanii duukaa buʼan sanaan <optbreak /> karaa irraa jalʼataniif,<verse eid="AMO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5" />ani ibidda daʼannoo Yerusaalem barbadeessu tokko</para>
  <para style="q2" vid="AMO 2:5">Yihuudaatti nan erga.”<verse eid="AMO 2:5" /></para>
  <para style="s1">Murtii Israaʼelitti Murame</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />Rabbii Allaahan akkana jedha:</para>
  <para style="q1" vid="AMO 2:6">“Ani cubbuu Israaʼel sadiif,</para>
  <para style="q2" vid="AMO 2:6">afuriifis dheekkamsa koo duubatti hin deebisu.</para>
  <para style="q1" vid="AMO 2:6">Isaan qajeeltota meetiitti,</para>
  <para style="q2" vid="AMO 2:6">rakkattoota immoo kophee cimdii tokkotti gurguratan.<verse eid="AMO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7" />Isaan akkuma biyyoo lafaatti</para>
  <para style="q2" vid="AMO 2:7">mataa hiyyeeyyii irra ijaajjanii</para>
  <para style="q2" vid="AMO 2:7">cunqurfamaas murtii qajeelaa dhowwatan.</para>
  <para style="q1" vid="AMO 2:7">Abbaa fi ilmi durba tokkotti galanii</para>
  <para style="q2" vid="AMO 2:7">akkasiin maqaa koo qulqulluu xureessan.<verse eid="AMO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8" />Isaan uffata qabdiidhaan nama irraa</para>
  <para style="q2" vid="AMO 2:8">fudhatan irra iddoo aarsaa hunda bira ciciisan.</para>
  <para style="q1" vid="AMO 2:8">Isaan daadhii wayinii kan warra adabaman biraa dhufe,</para>
  <para style="q2" vid="AMO 2:8">mana waaqeffatamaa isaanii tolfamaa keessatti dhugu.<verse eid="AMO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9" />“Inni akkuma birbirsaa dheeratee</para>
  <para style="q2" vid="AMO 2:9">akka qilxuu jabaatu iyyuu,</para>
  <para style="q2" vid="AMO 2:9">ani namicha Amoor sana fuula isaanii duratti galaafadheera.</para>
  <para style="q1" vid="AMO 2:9">Ani gubbaadhaa ija isaa,</para>
  <para style="q2" vid="AMO 2:9">jalaan immoo hidda isaa balleesseera.<verse eid="AMO 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10" />“Ani biyya Amoorotaa isiniif kennuuf jedhee,</para>
  <para style="q2" vid="AMO 2:10">biyya Gibxiitii isin baasee</para>
  <para style="q2" vid="AMO 2:10">waggaa afurtama gammoojjii keessa isinan geggeesse.<verse eid="AMO 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11" />“Akkasumas ani ilmaan keessan gidduudhaa nabiiʼiyyoota,</para>
  <para style="q2" vid="AMO 2:11">dargaggoota keessan gidduudhaa immoo Naaziroota kaaseera.</para>
  <para style="q1" vid="AMO 2:11">Yaa saba Israaʼel, wanni kun dhuguma mitii?”</para>
  <para style="q2" vid="AMO 2:11">jedha Rabbii Allaahan.<verse eid="AMO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12" />“Isin garuu Naaziroota daadhii wayinii obaaftanii</para>
  <para style="q2" vid="AMO 2:12">akka nabiiʼiyyoonnis raajii hin dubbanne ajajjan.<verse eid="AMO 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13" />“Ani akkuma gaariin yommuu midhaaniin guutamu caccabu sana,</para>
  <para style="q2" vid="AMO 2:13">amma isinan caccabsa.<verse eid="AMO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14" />Saffisaan hin miliqu;</para>
  <para style="q2" vid="AMO 2:14">namoonni jajjaboon humna isaanii hin jabeeffatan;</para>
  <para style="q2" vid="AMO 2:14">loltuunis lubbuu isaa hin oolfatu.<verse eid="AMO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15" />Abbaan xiyyaa jabaatee dhaabachuu hin dandaʼu;</para>
  <para style="q2" vid="AMO 2:15">loltuun saffisaan fiigee jalaa hin baʼu;</para>
  <para style="q2" vid="AMO 2:15">abbaan fardaas lubbuu isaa oolfachuu hin dandaʼu.<verse eid="AMO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16" />Loltoonni akka malee jajjaboon iyyuu</para>
  <para style="q2" vid="AMO 2:16">gaafas qullaa isaanii baqatu”</para>
  <para style="q2" vid="AMO 2:16">jedha Rabbii Allaahan.<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="s1">Dhuga baatota Israaʼelitti Dhugaa Baʼan</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />Yaa saba Israaʼel, dubbii Rabbii Allaahan isiniin mormuudhaan, maatii ani biyya Gibxii baasee fide hundaan mormuudhaan dubbate kana dhagaʼaa:<verse eid="AMO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2" />“Ani maatiiwwan lafa irra jiraatan</para>
  <para style="q2" vid="AMO 3:2">hunda keessaa isin qofa filadheera;</para>
  <para style="q1" vid="AMO 3:2">kanaafuu ani cubbuu keessan</para>
  <para style="q2" vid="AMO 3:2">hundaaf isinan adaba.”<verse eid="AMO 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3" />Yoo walii galan malee</para>
  <para style="q2" vid="AMO 3:3">namoonni lama wajjin ni deemuu?<verse eid="AMO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4" />Leenci tokko yoo waan adamsu hin argatin</para>
  <para style="q2" vid="AMO 3:4">bosona keessaa ni aadaa?</para>
  <para style="q1" vid="AMO 3:4">Inni yoo waa qabate malee</para>
  <para style="q2" vid="AMO 3:4">holqa isaa keessaa ni aadaa?<verse eid="AMO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5" />Simbirri tokko lafa kiyyoon hin kaaʼaminitti</para>
  <para style="q2" vid="AMO 3:5">kiyyoo keessa ni seentii?</para>
  <para style="q1" vid="AMO 3:5">Kiyyoon tokko yoo wanni qabamu hin jirre</para>
  <para style="q2" vid="AMO 3:5">akkasumatti lafaa ni utaalaa?<verse eid="AMO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6" />Yoo magaalaa keessatti malakanni afuufame,</para>
  <para style="q2" vid="AMO 3:6">namoonni hin raafamanii?</para>
  <para style="q1" vid="AMO 3:6">Balaan magaalaa tokkotti yoo dhufe,</para>
  <para style="q2" vid="AMO 3:6">Rabbii Allaahatu waan sana fide mitii?<verse eid="AMO 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7" />Dhugumaan Rabbii Allaahan Gooftaan</para>
  <para style="q2" vid="AMO 3:7">utuu tajaajiltoota isaa nabiiʼiyyootatti hin mulʼisin</para>
  <para style="q2" vid="AMO 3:7">waan tokko illee hin hojjetu.<verse eid="AMO 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8" />Leenci aadeera;</para>
  <para style="q2" vid="AMO 3:8">eenyutu hin sodaanne ree?</para>
  <para style="q1" vid="AMO 3:8">Rabbii Allaahan Gooftaan dubbateera;</para>
  <para style="q2" vid="AMO 3:8">yoos eenyutu raajii hin dubbanne ree?<verse eid="AMO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9" />Daʼannoo Ashdoodiitii fi</para>
  <para style="q2" vid="AMO 3:9">daʼannoo Gibxitti akkana jedhaa labsaa:</para>
  <para style="q1" vid="AMO 3:9">“Tulluuwwan Samaariyaa irratti walitti qabamaa;</para>
  <para style="q2" vid="AMO 3:9">jeequmsa guddaa ishee keessa jiruu fi</para>
  <para style="q2" vid="AMO 3:9">cunqursaa uummata ishee keessa jiru ilaalaa.”<verse eid="AMO 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10" />“Warri daʼannoo isaanii keessatti waan boojiʼamee fi <optbreak /> waan saamame kuufatan</para>
  <para style="q2" vid="AMO 3:10">akka itti waan qajeelaa hojjetan hin beekan”</para>
  <para style="q2" vid="AMO 3:10">jedha Rabbii Allaahan.<verse eid="AMO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11" />Kanaafuu Rabbii Allaahan Gooftaan akkana jedha:</para>
  <para style="q1" vid="AMO 3:11">“Diinni biyya keessan marsa;</para>
  <para style="q2" vid="AMO 3:11">jabina keessan gad buusa;</para>
  <para style="q2" vid="AMO 3:11">daʼannoowwan keessanis ni saama.”<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />Rabbii Allaahan akkana jedha:</para>
  <para style="q1" vid="AMO 3:12">“Akkuma tikseen tokko lafee miilla lamaanii</para>
  <para style="q2" vid="AMO 3:12">yookaan fiixee gurraa qofa afaan leencaatii buusu sana,</para>
  <para style="q1" vid="AMO 3:12">Israaʼeloonni Samaariyaa keessa, qarqara siree isaanii irra,</para>
  <para style="q2" vid="AMO 3:12">Damaasqoo keessas siree isaanii dinkii irra taaʼan</para>
  <para style="q2" vid="AMO 3:12">akkasuma ni baraaramu.”<verse eid="AMO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13" />“Waan kana dhagaʼaatii mana Yaaʼikuubitti dhugaa baʼaa” jedha Gooftaan, Rabbii Allaahan, Allaahan Waan Hunda Dandaʼu.<verse eid="AMO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14" />“Guyyaa ani cubbuu isheetiif jedhee Israaʼelin adabutti,</para>
  <para style="q2" vid="AMO 3:14">iddoowwan aarsaa Beetʼeel nan barbadeessa;</para>
  <para style="q1" vid="AMO 3:14">gaanfawwan iddoo aarsaas caccabanii</para>
  <para style="q2" vid="AMO 3:14">lafatti ni harcaʼu.<verse eid="AMO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15" />Ani mana gannaatii fi</para>
  <para style="q2" vid="AMO 3:15">mana bonaa nan diiga;</para>
  <para style="q1" vid="AMO 3:15">manneen ilka arbaatiin miidhagfaman ni diigamu;</para>
  <para style="q2" vid="AMO 3:15">manneen gurguddaanis ni balleeffamu”</para>
  <para style="q2" vid="AMO 3:15">jedha Rabbii Allaahan.<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="s1">Israaʼel Gara Allaahatti Hin deebine</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1" />Isin yaa saawwan Baashaan kanneen Tulluu Samaariyaa irra jirtan,</para>
  <para style="q2" vid="AMO 4:1">yaa dubartoota, isin warri hiyyeeyyii fi rakkattoota cunqursitanii</para>
  <para style="q2" vid="AMO 4:1">dhirsoota keessaniin, “Dhugaatii nuuf fidaa!” jettan <optbreak /> dubbii kana dhagaʼaa.<verse eid="AMO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2" />Rabbii Allaahan Gooftaan akkana jedhee <optbreak /> qulqullummaa isaatiin kakateera:</para>
  <para style="q2" vid="AMO 4:2">“Yeroon isin itti hokkoodhaan,</para>
  <para style="q1" vid="AMO 4:2">isin keessaa namni dhumaa immoo qabduu qurxummiitiin</para>
  <para style="q2" vid="AMO 4:2">qabamu tokko dhugumaan ni dhufa.<verse eid="AMO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3" />Isin tokko tokkoon qajeeltanii</para>
  <para style="q2" vid="AMO 4:3">qaawwa dallaatiin ni baatu;</para>
  <para style="q1" vid="AMO 4:3">gara Harmoonittis ni darbatamtu”</para>
  <para style="q2" vid="AMO 4:3">jedha Rabbii Allaahan.<verse eid="AMO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4" />“Beetʼeel dhaqaatii cubbuu hojjedhaa;</para>
  <para style="q2" vid="AMO 4:4">Gilgaal dhaqaatii cubbuu baayʼee hojjedhaa.</para>
  <para style="q1" vid="AMO 4:4">Ganama ganama aarsaa keessan dhiʼeessaa;</para>
  <para style="q2" vid="AMO 4:4">waggaa sadii sadiitti immoo kennaa keessan harka kudhan keessaa <optbreak /> harka tokko fidaa.<verse eid="AMO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5" />Buddeena raacitii qabu aarsaa galataa godhaatii gubaa;</para>
  <para style="q2" vid="AMO 4:5">aarsaa fedhiidhaan kennitan labsaa; beeksisaas;</para>
  <para style="q1" vid="AMO 4:5">yaa Israaʼeloota, wanni isin hojjechuu jaallattan kanaatii,</para>
  <para style="q2" vid="AMO 4:5">ittiin boonaa”</para>
  <para style="q2" vid="AMO 4:5">jedha Rabbii Allaahan Gooftaan.<verse eid="AMO 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6" />“Ani magaalaa hunda keessatti garaa duwwaa isiniif kenneera;</para>
  <para style="q2" vid="AMO 4:6">magaalaa hunda keessattis buddeena isin dhabsiiseera;</para>
  <para style="q1" vid="AMO 4:6">isin garuu gara kootti hin deebine”</para>
  <para style="q2" vid="AMO 4:6">jedha Rabbii Allaahan.<verse eid="AMO 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7" />“Ani yeroo midhaan haamamuuf jiʼi sadii hafutti</para>
  <para style="q2" vid="AMO 4:7">bokkaa isin irraa nan kute.</para>
  <para style="q1" vid="AMO 4:7">Ani magaalaa tokkotti bokkaa ergee</para>
  <para style="q2" vid="AMO 4:7">kaan irraa immoo nan dhaabe.</para>
  <para style="q1" vid="AMO 4:7">Lafti qonnaa tokko bokkaa argatee</para>
  <para style="q2" vid="AMO 4:7">kaan garuu homaa dhabee goge.<verse eid="AMO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8" />Uummanni bishaan barbaacha magaalaadhaa gara magaalaatti joore;</para>
  <para style="q2" vid="AMO 4:8">garuu waan dhugaatiif isa gaʼu hin arganne;</para>
  <para style="q1" vid="AMO 4:8">taʼus isin gara kootti hin deebine”</para>
  <para style="q2" vid="AMO 4:8">jedha Rabbii Allaahan.<verse eid="AMO 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9" />“Ani yeroo hedduu iddoo biqiltuutii fi</para>
  <para style="q2" vid="AMO 4:9">wayinii keessan waagii fi awwaaroodhaan dhaʼeen balleesse.</para>
  <para style="q1" vid="AMO 4:9">Hawwaannisni harbuu fi ejersa keessan barbadeesse;</para>
  <para style="q2" vid="AMO 4:9">taʼus isin gara kootti hin deebine”</para>
  <para style="q2" vid="AMO 4:9">jedha Rabbii Allaahan.<verse eid="AMO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10" />“Ani akkuman biyya Gibxi godhe sana</para>
  <para style="q2" vid="AMO 4:10">dhaʼicha isinitti nan erge.</para>
  <para style="q1" vid="AMO 4:10">Ani fardeen isin boojitan wajjin</para>
  <para style="q2" vid="AMO 4:10">dargaggoota keessan goraadeedhaan nan fixe.</para>
  <para style="q1" vid="AMO 4:10">Ajaa qubata keessaniitiin funyaan keessan nan guute;</para>
  <para style="q2" vid="AMO 4:10">isin garuu gara kootti hin deebine”</para>
  <para style="q2" vid="AMO 4:10">jedha Rabbii Allaahan.<verse eid="AMO 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11" />“Ani akkuman Sodoomii fi Gomoraa garagalche sana</para>
  <para style="q2" vid="AMO 4:11">isin keessaa nama tokko tokko garagalcheera.</para>
  <para style="q1" vid="AMO 4:11">Isin akkuma muka bobaʼu kan ibidda keessaa butamee ti;</para>
  <para style="q2" vid="AMO 4:11">taʼus isin gara kootti hin deebine”</para>
  <para style="q2" vid="AMO 4:11">jedha Rabbii Allaahan.<verse eid="AMO 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12" />“Kanaafuu yaa Israaʼel, ani akkanan isin godha;</para>
  <para style="q2" vid="AMO 4:12">sababii ani akkana isin godhuuf</para>
  <para style="q2" vid="AMO 4:12">yaa Israaʼel Allaah kee arguuf qophaaʼi.”<verse eid="AMO 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13" />Inni tulluuwwan tolchee</para>
  <para style="q2" vid="AMO 4:13">bubbee uumee yaada isaa namatti mulʼisu sun,</para>
  <para style="q1" vid="AMO 4:13">inni barii dukkaneessee</para>
  <para style="q2" vid="AMO 4:13">iddoowwan lafa ol kaʼoo irra ejjetu sun,</para>
  <para style="q2" vid="AMO 4:13">maqaan isaa Rabbii Allaah, <optbreak /> Allaah Waan Hunda Dandaʼuu dha.<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s1">Faaruu Booʼichaatii fi Waamicha Qalbii Jijjiirrachuu</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />Yaa mana Israaʼel dubbii kana, faaruu booʼichaa kan ani waaʼee keessaniif booʼu kana dhagaʼaa:<verse eid="AMO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2" />“Durbi qulqullittiin Israaʼel kufteerti;</para>
  <para style="q2" vid="AMO 5:2">isheen lammata hin kaatu;</para>
  <para style="q1" vid="AMO 5:2">biyyuma ishee keessatti gatamtee</para>
  <para style="q2" vid="AMO 5:2">nama ol ishee qabu tokko illee dhabde.”<verse eid="AMO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />Rabbii Allaahan Gooftaan akkana jedha:</para>
  <para style="q1" vid="AMO 5:3">“Magaalaa loltoota kuma tokko Israaʼeliif bobbaafteef</para>
  <para style="q2" vid="AMO 5:3">dhibba tokko qofatu hafa;</para>
  <para style="q1" vid="AMO 5:3">magaalaa loltoota dhibba tokko bobbaafteef</para>
  <para style="q2" vid="AMO 5:3">kudhan qofatu hafa.”<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />Rabbii Allaahan mana Israaʼeliin akkana jedha:</para>
  <para style="q1" vid="AMO 5:4">“Na barbaaddadhaatii jiraadhaa;<verse eid="AMO 5:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 5:5" />Beetʼeelin hin barbaaddatinaa;</para>
  <para style="q1" vid="AMO 5:5">Gilgaal hin dhaqinaa;</para>
  <para style="q2" vid="AMO 5:5">Bersheebaattis hin ceʼinaa.</para>
  <para style="q1" vid="AMO 5:5">Gilgaal dhugumaan ni boojiʼamti;</para>
  <para style="q2" vid="AMO 5:5">Beetʼeelis ni dhabamti.”<verse eid="AMO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6" />Rabbii Allaah barbaaddadhaatii jiraadhaa;</para>
  <para style="q2" vid="AMO 5:6">yoo kanaa achii inni akkuma ibiddaa <optbreak /> mana Yuusuf keessa baʼee haxaaʼaa;</para>
  <para style="q1" vid="AMO 5:6">ibiddi sun ishee guba;</para>
  <para style="q2" vid="AMO 5:6">Beetʼeelis nama irraa dhaamsu tokko iyyuu <optbreak /> hin qabaattu.<verse eid="AMO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7" />Isin warra murtii qajeelaa hadhaatti geeddartanii</para>
  <para style="q2" vid="AMO 5:7">qajeelummaas lafatti harcaaftanii dha.<verse eid="AMO 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8" />Inni urjiiwwan Torbii fi urjiiwwan Sadee uume,</para>
  <para style="q2" vid="AMO 5:8">kan dukkana bariitti geeddaru,</para>
  <para style="q2" vid="AMO 5:8">inni guyyaa dukkaneessee halkan godhu,</para>
  <para style="q1" vid="AMO 5:8">kan galaana keessaa bishaan ol waamee</para>
  <para style="q2" vid="AMO 5:8">fuula lafa gogaa irratti dhangalaasu</para>
  <para style="q2" vid="AMO 5:8">maqaan isaa Rabbii Allaah dha.<verse eid="AMO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9" />Inni daʼoo jabaatti badiisa tasaa fida;</para>
  <para style="q2" vid="AMO 5:9">magaalaa dallaa jabaa qabdus ni barbadeessa.<verse eid="AMO 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10" />Isaan nama karra irratti nama ifatu ni jibbu;</para>
  <para style="q2" vid="AMO 5:10">kan dhugaa dubbatus ni balfu.<verse eid="AMO 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11" />Isin hiyyeeyyii dhidhiittanii</para>
  <para style="q2" vid="AMO 5:11">akka isaan midhaan isinii kennan dirqisiiftu.</para>
  <para style="q1" vid="AMO 5:11">Kanaafuu isin manneen dhagaa yoo ijaarrattan iyyuu</para>
  <para style="q2" vid="AMO 5:11">manneen sana keessa hin jiraattan;</para>
  <para style="q1" vid="AMO 5:11">isin iddoowwan qotiisaa gaarii keessa wayinii yoo dhaabbattan iyyuu</para>
  <para style="q2" vid="AMO 5:11">daadhii wayinii isaanii hin dhugdan.<verse eid="AMO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12" />Balleessaan keessan hammam akka baayʼatuu fi</para>
  <para style="q2" vid="AMO 5:12">cubbuun keessanis hammam guddaa akka taʼe nan beekaatii.</para>
  <para style="b" vid="AMO 5:12" />
  <para style="q1" vid="AMO 5:12">Isaan qajeeltota hacuucanii mattaʼaa irraa fudhatu;</para>
  <para style="q2" vid="AMO 5:12">hiyyeeyyiis mana murtii keessatti murtii qajeelaa dhowwatu.<verse eid="AMO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13" />Kanaafuu namni qalbeeffataan yeroo akkasiitti afaan qabata;</para>
  <para style="q2" vid="AMO 5:13">barri kun bara hamaadhaatii.<verse eid="AMO 5:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14" />Akka lubbuudhaan jiraattaniif</para>
  <para style="q2" vid="AMO 5:14">waan hamaa dhiisaatii waan gaarii barbaadaa.</para>
  <para style="q1" vid="AMO 5:14">Yoos akkuma isin jettan sana</para>
  <para style="q2" vid="AMO 5:14">Rabbii Allaahan, Allaahan Waan Hunda Dandaʼu isin wajjin taʼa.<verse eid="AMO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15" />Waan hamaa jibbaa; waan gaarii jaalladhaa;</para>
  <para style="q2" vid="AMO 5:15">mana murtii keessatti murtii qajeelaa jabeessaa;</para>
  <para style="q1" vid="AMO 5:15">Rabbii Allaahan, Allaahan Waan Hunda Dandaʼu</para>
  <para style="q2" vid="AMO 5:15">tarii hambaa Yuusufiif garaa laafa taʼaatii.<verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />Kanaafuu Gooftaan, Rabbii Allaahan, Allaahan Waan Hunda Dandaʼu akkana jedha:</para>
  <para style="q1" vid="AMO 5:16">“Daandii hunda irra booʼicha,</para>
  <para style="q2" vid="AMO 5:16">oobdii uummataa hunda irra immoo iyya dhiphinaatu jira.</para>
  <para style="q1" vid="AMO 5:16">Qonnaan bultoonni akka booʼaniif,</para>
  <para style="q2" vid="AMO 5:16">warri booʼan immoo akka wawwaataniif ni waamamu.<verse eid="AMO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17" />Ani gidduu keessan waanan darbuuf</para>
  <para style="q2" vid="AMO 5:17">iddoo dhaabaa wayinii hunda keessaa booʼichatu taʼa”</para>
  <para style="q2" vid="AMO 5:17">jedha Rabbii Allaahan.<verse eid="AMO 5:17" /></para>
  <para style="s1">Guyyaa Rabbii Allaah</para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18" />Isin warra guyyaa Rabbii Allaah</para>
  <para style="q2" vid="AMO 5:18">arguu hawwitaniif wayyoo!</para>
  <para style="q1" vid="AMO 5:18">Isin maaliif guyyaa Rabbii Allaah arguu hawwitu!</para>
  <para style="q2" vid="AMO 5:18">Guyyaan sun dukkana malee ifa hin taʼuutii.<verse eid="AMO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19" />Wanni kun akkuma nama leenca jalaa baʼee</para>
  <para style="q2" vid="AMO 5:19">afaan amaaketaa buʼu tokkoo ti;</para>
  <para style="q1" vid="AMO 5:19">yookaan akka nama mana isaa seenee</para>
  <para style="q2" vid="AMO 5:19">harka isaa keenyan manaa irra kaaʼatee</para>
  <para style="q2" vid="AMO 5:19">bofti isa idde tokkoo ti.<verse eid="AMO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20" />Guyyaan Rabbii Allaah ifa utuu hin taʼin dukkana miti?</para>
  <para style="q2" vid="AMO 5:20">Dukkana hamaa ifa tokko illee of keessaa hin qabne mitii?<verse eid="AMO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21" />“Ani ayyaana amantaa keessanii nan jibba; nan tuffadhas;</para>
  <para style="q2" vid="AMO 5:21">waldaa keessanittis hin gammadu.<verse eid="AMO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22" />Utuu isin aarsaa gubamuu fi kennaa midhaanii naaf fiddanii iyyuu</para>
  <para style="q2" vid="AMO 5:22">ani jaalladhee isin irraa hin fudhadhu.</para>
  <para style="q1" vid="AMO 5:22">Utuu isin aarsaa nagaa filatamaa naaf fiddanii iyyuu</para>
  <para style="q2" vid="AMO 5:22">ani homaattuu isa hin lakkaaʼu.<verse eid="AMO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23" />Waca faarfannaa keessanii asii balleessaa!</para>
  <para style="q2" vid="AMO 5:23">Ani muuziiqaa baganaa keessanii hin dhaggeeffadhu.<verse eid="AMO 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24" />Garuu murtiin qajeelaan akkuma lagaa,</para>
  <para style="q2" vid="AMO 5:24">qajeelummaanis akkuma burqaa hin gognee haa yaaʼu!<verse eid="AMO 5:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25" />“Yaa mana Israaʼel isin waggaa afurtama</para>
  <para style="q2" vid="AMO 5:25">gammoojjii keessatti takkumaa aarsaa fi kennaa naaf fiddaniirtuu?<verse eid="AMO 5:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26" />Isin waan harkuma keessaniin tolfattan</para>
  <para style="q2" vid="AMO 5:26">jechuunis galma waaqeffannaa mootii keessanii,</para>
  <para style="q2" vid="AMO 5:26">utubaa waaqeffatamaa keessan tolfamaatii fi</para>
  <para style="q2" vid="AMO 5:26">fakkii urjii waaqeffatamaa keessan tolfamaa ol fuutaniirtu.<verse eid="AMO 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27" />Kanaafuu ani akka isin boojiʼamtaniif,</para>
  <para style="q2" vid="AMO 5:27">Damaasqoodhaan gamatti isinan erga”</para>
  <para style="q2" vid="AMO 5:27">jedha Rabbii Allaahan inni maqaan isaa <optbreak /> Allaah Waan Hunda Dandaʼu taʼe sun.<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s1">Warra Yaaddoo Malee Jiraataniif Wayyoo</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1" />Yaa warra yaaddoo malee Xiyoon keessa jiraattan,</para>
  <para style="q2" vid="AMO 6:1">kanneen Tulluu Samaariyaa irra waan nagaadhaan jiraatan seetan,</para>
  <para style="q1" vid="AMO 6:1">isaan namoota ulfaatoo saba durii,</para>
  <para style="q2" vid="AMO 6:1">kanneen sabni Israaʼel gara isaanii dhufuuf wayyoo!<verse eid="AMO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2" />Gara Kaalneetti darbaatii ilaalaa;</para>
  <para style="q2" vid="AMO 6:2">achii kaʼaatii gara Hamaati guddichaa dhaqaa;</para>
  <para style="q2" vid="AMO 6:2">ergasii immoo Gaati Filisxeem keessaatti gad buʼaa.</para>
  <para style="q1" vid="AMO 6:2">Isaan mootummoota keessan lamaan caaluu?</para>
  <para style="q2" vid="AMO 6:2">Biyyi isaanii biyya keessan caalaa balʼataa?<verse eid="AMO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3" />Isin guyyaa hamaa fageessitanii</para>
  <para style="q2" vid="AMO 6:3">bulchiinsa jeequmsaa fiddu.<verse eid="AMO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4" />Isin siree ilka arbaatiin miidhagfame irra ciiftu;</para>
  <para style="q2" vid="AMO 6:4">siree keessan dinkii irra boqottu.</para>
  <para style="q1" vid="AMO 6:4">Isin xobbaallaa hoolaa filatamoo fi</para>
  <para style="q2" vid="AMO 6:4">jabbii coccoomoo nyaattu.<verse eid="AMO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5" />Isin sagalee baganaatiin weedduu faayidaa hin qabne weeddiftu;</para>
  <para style="q2" vid="AMO 6:5">akkuma Daawudis meeshaa muuziiqaa qaqqajeelfattu.<verse eid="AMO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6" />Isin xoofoo keessaa daadhii wayinii dhugdu;</para>
  <para style="q2" vid="AMO 6:6">dibata akka malee gaarii dibattu;</para>
  <para style="q2" vid="AMO 6:6">garuu badiisa Yuusufiif hin gadditan.<verse eid="AMO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7" />Kanaafuu isin warra jalqabatti boojiʼaman wajjin <optbreak /> boojiʼamtanii fudhatamtu;</para>
  <para style="q2" vid="AMO 6:7">burraaquu fi bashannanuun keessan ni hafa.<verse eid="AMO 6:7" /></para>
  <para style="s1">Rabbii Allaahan Of Tuulummaa Israaʼel Jibba</para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />Rabbii Allaahan Gooftaan ofii isaatiin kakateera; Rabbii Allaahan, Allaahan Waan Hunda Dandaʼu akkana jedha:</para>
  <para style="q1" vid="AMO 6:8">“Ani of tuulummaa Yaaʼikuub nan balfa;</para>
  <para style="q2" vid="AMO 6:8">daʼannoo isaas nan jibba;</para>
  <para style="q1" vid="AMO 6:8">ani magaalattii fi waan ishee keessa jiru hunda</para>
  <para style="q2" vid="AMO 6:8">dabarsee nan kenna.”<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />Namoonni kudhan yoo mana tokko keessatti hafan isaanis ni dhumu. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />Yoo firri reeffa baasee gubu tokko mana sana keessaa baasuuf dhufee nama dhokatee achi jiru kamiin iyyuu, “Namni tokko iyyuu si wajjin jiraa?” jedhee gaafatee namichi sun, “Hin jiru” jedheen, inni “Calʼisi! Nu maqaa Rabbii Allaah dhaʼuu hin qabnu” jedhaan.<verse eid="AMO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11" />Kunoo Rabbii Allaahan ajaja kenneeraatii,</para>
  <para style="q2" vid="AMO 6:11">manneen gurguddaan ni barbadaaʼu;</para>
  <para style="q2" vid="AMO 6:11">manneen xixinnoonis ni caccabu.<verse eid="AMO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12" />Fardeen kattaawwan irra ni fiiguu?</para>
  <para style="q2" vid="AMO 6:12">Namni tokko qotiyyoodhaan achi ni qotaa?</para>
  <para style="q1" vid="AMO 6:12">Isin garuu murtii qajeelaa gara summiitti,</para>
  <para style="q2" vid="AMO 6:12">ija qajeelummaas gara hadhaatti geeddartaniirtu;<verse eid="AMO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13" />isin warra Lodebaar moʼachuutti gammaddanii,</para>
  <para style="q2" vid="AMO 6:13">“Nu humna keenyaan Qaarnaayim qabanne mitii?” jettanii dha.<verse eid="AMO 6:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14" />Rabbii Allaahan, Allaahan Waan Hunda Dandaʼu akkana jedhaatii;</para>
  <para style="q2" vid="AMO 6:14">“Yaa mana Israaʼel, ani saba Leeboo Hamaatii jalqabee</para>
  <para style="q1" vid="AMO 6:14">hamma sulula Arabbaatti</para>
  <para style="q2" vid="AMO 6:14">karaa keessan hunda irratti isin cunqursu tokko isinittin kaasa.”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s1">Hawwaannisa, Ibiddaa fi Tumbii</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />Rabbii Allaahan Gooftaan waan kana natti argisiise: Inni erga qoodni mootichaa haamamee booddee, utuma midhaan lammaffaan gaʼaa jiruu tuuta hawwaannisaa qopheesse. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />Anis erga hawwaannisni sun lafa barbadeessee booddee, “Rabbii Allaah Gooftaa, nuuf araarami! Yaaʼikuub akkamiin dandaʼee badiisa irraa hafa? Inni daaʼima xinnaa dha!” jedheen iyye.<verse eid="AMO 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3" />Kanaafuu Rabbii Allaahan ni gaabbe.</para>
  <para style="p" vid="AMO 7:3">Rabbii Allaahanis, “Wanni kun hin taʼu” jedhe.<verse eid="AMO 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />Rabbii Allaahan Gooftaan waan kana natti argisiise; Rabbii Allaahan Gooftaan murtii kennuuf ibidda waamaa ture; ibiddi sunis tuujuba guddaa gogsee lafas ni barbadeesse. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />Kana irratti ani, “Rabbii Allaah Gooftaa, ani sin kadhadhaa, waan kana nurraa dhaabi! Yaaʼikuub akkamiin waan kana irraa hafa? Inni daaʼima xinnaa dha!” jedheen iyye.<verse eid="AMO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6" />Kanaafuu Rabbii Allaahan ni gaabbe.</para>
  <para style="p" vid="AMO 7:6">Rabbii Allaahan Gooftaan, “Wanni kunis hin taʼu” jedhe.<verse eid="AMO 7:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />Inni waan kana na argisiise: Gooftaan tumbii harkatti qabatee dallaa tumbiidhaan ijaarame bira dhaabachaa ture. <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />Rabbii Allaahanis, “Amoos, ati maal arguutti jirta?” jedhee na gaafate.</para>
  <para style="p" vid="AMO 7:8">Anis, “Tumbii nan arga” jedheen deebise.</para>
  <para style="p" vid="AMO 7:8">Gooftaanis akkana naan jedhe; “Kunoo ani saba koo Israaʼel gidduu tumbii tokko nan kaaʼa; ani siʼachi isaan hin baraaru.<verse eid="AMO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9" />“Iddoowwan sagadaa Yisihaaq ni barbadaaʼu;</para>
  <para style="q2" vid="AMO 7:9">iddoon qulqulluun Israaʼelis ni ona;</para>
  <para style="q2" vid="AMO 7:9">ani goraadee kootiin mana Yerobiʼaamitti nan kaʼa.”<verse eid="AMO 7:9" /></para>
  <para style="s1">Amoosii fi Amasiyaa</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />Ergasii Amasiyaa lubni Beetʼeel akkana jedhee Yerobiʼaam mooticha Israaʼelitti ergaa tokko erge; “Amoos garaa Israaʼel keessatti sitti malateera. Dubbii isaa hunda lafti iyyuu baachuu hin dandeessu. <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />Amoos akkana jedheeraatii:</para>
  <para style="q1" vid="AMO 7:11">“ ‘Yerobiʼaam goraadeedhaan duʼa;</para>
  <para style="q2" vid="AMO 7:11">Israaʼelis dhugumaan boojiʼamee</para>
  <para style="q2" vid="AMO 7:11">biyya isaatii ni fudhatama.’ ”<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />Kana irratti Amasiyaan Amoosiin akkana jedhe; “Yaa ilaaltuu nana, sokki! Biyya Yihuudaatti deebiʼi. Achitti buddeena nyaadhu; raajiis dubbadhu. <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />Sababii inni iddoo qulqulluu mootichaatii fi mana qulqullummaa mootummaa taʼeef ati lammata Beetʼeel keessatti raajii hin dubbatin.”<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />Amoos immoo akkana jedhee Amasiyaaf deebise; “Ani nabiiʼiyyii yookaan ilma nabiiʼiyyii miti; garuu ani tiksee fi eegduu muka harbuun ture. <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />Rabbii Allaahan garuu tika bushaayee keessaa na fuudhee, ‘Dhaqii saba koo Israaʼelitti raajii dubbadhu’ naan jedhe. <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />Egaa amma dubbii Rabbii Allaah dhagaʼi. Ati akkana jetta;</para>
  <para style="q1" vid="AMO 7:16">“ ‘Ati Israaʼeliin mormuudhaan raajii hin dubbatin;</para>
  <para style="q2" vid="AMO 7:16">mana Yisihaaq mormuudhaan lallabuu dhiisi.’<verse eid="AMO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17" />“Kanaafuu Rabbii Allaahan akkana jedha:</para>
  <para style="q1" vid="AMO 7:17">“ ‘Niitiin kee magaalaa keessatti sagaagaltuu taati;</para>
  <para style="q2" vid="AMO 7:17">ilmaan keetii fi intallan kee goraadeedhaan dhumu.</para>
  <para style="q1" vid="AMO 7:17">Biyyi kee safaramtee gargar qoodamti;</para>
  <para style="q2" vid="AMO 7:17">ati mataan kee iyyuu biyya ormaatti duuta.</para>
  <para style="q1" vid="AMO 7:17">Israaʼel dhugumaan boojiʼamee</para>
  <para style="q2" vid="AMO 7:17">biyya isaatii ni fuudhama.’ ”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s1">Guuboo Ija Bilchaateen Guutame</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />Rabbii Allaahan Gooftaan waan kana natti argisiise: kun guuboo ija bilchaateen guutamee dha. <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />Innis, “Amoos, ati maal arguutti jirta?” jedhee na gaafate.</para>
  <para style="p" vid="AMO 8:2">Ani immoo, “Guuboo ija bilchaateen guutame tokko” jedheen deebiseef.</para>
  <para style="p" vid="AMO 8:2">Ergasii Rabbii Allaahan akkana naan jedhe; “Saba koo Israaʼelitti yeroon dhufeera; ani siʼachi isaan hin baraaru.”<verse eid="AMO 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3" />Rabbii Allaahan Gooftaan akkana jedha; “Gaafas faarfannaan mana qulqullummaa keessaa booʼichatti geeddarama. Reeffi akka malee hedduun lafa hundatti gatama! Calʼisuunis ni taʼa!”<verse eid="AMO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4" />Isin warri rakkattoota dhidhiittanii</para>
  <para style="q2" vid="AMO 8:4">hiyyeeyyii biyyattii balleessitan waan kana dhagaʼaa;<verse eid="AMO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 8:5" />isin akkana jettu;</para>
  <para style="q1" vid="AMO 8:5">“Akka nu midhaan gurgurannuuf</para>
  <para style="q2" vid="AMO 8:5">Baatiin Haaraan yoom goobana?</para>
  <para style="q1" vid="AMO 8:5">Akka nu qamadii gabaa baafannuuf</para>
  <para style="q2" vid="AMO 8:5">Sanbanni yoom darba?”</para>
  <para style="q1" vid="AMO 8:5">Isin warri safartuu xinnootti fayyadamtanii</para>
  <para style="q2" vid="AMO 8:5">gatii immoo ol kaaftan, madaalii sobaatiin</para>
  <para style="q2" vid="AMO 8:5">nama gowwoomsitanii saamtu;<verse eid="AMO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6" />hiyyeeyyii meetiidhaan,</para>
  <para style="q2" vid="AMO 8:6">rakkataa immoo kophee miilla lamaaniitiin bitattanii</para>
  <para style="q2" vid="AMO 8:6">girdiis qamadii wajjin gurgurattu.<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />Rabbii Allaahan akkana jedhee ulfina Yaaʼikuubiin kakateera; “Ani gonkumaa waan isaan hojjetan tokko illee hin irraanfadhu.<verse eid="AMO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8" />“Sababii kanaaf lafti kirkirtee</para>
  <para style="q2" vid="AMO 8:8">namoonni ishee keessa jiraatan hundi hin booʼanii?</para>
  <para style="q1" vid="AMO 8:8">Guutummaan biyya sanaa akkuma laga Abbayyaa ol kaʼa;</para>
  <para style="q2" vid="AMO 8:8">isheen akkuma laga Gibxi</para>
  <para style="q2" vid="AMO 8:8">ol dadarbatamtee liqimfamti.”<verse eid="AMO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9" />Rabbii Allaahan Gooftaan akkana jedha; “Bara sana,</para>
  <para style="q1" vid="AMO 8:9">“Ani akka aduun saafaadhaan dhiitee</para>
  <para style="q2" vid="AMO 8:9">laftis guyyuma adiidhaan dukkanooftu nan godha.<verse eid="AMO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10" />Ani ayyaana amantii keessanii gaddatti,</para>
  <para style="q2" vid="AMO 8:10">sirba keessan hundas booʼichatti nan geeddara.</para>
  <para style="q1" vid="AMO 8:10">Ani akka isin hundi wayyaa gaddaa uffattanii</para>
  <para style="q2" vid="AMO 8:10">mataa keessan haaddattan nan godha.</para>
  <para style="q1" vid="AMO 8:10">Ani yeroo sana akkuma booʼicha ilma tokkichaa,</para>
  <para style="q2" vid="AMO 8:10">dhuma isaas akka guyyaa hadhaaʼaa nan godha.”<verse eid="AMO 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11" />Rabbii Allaahan Gooftaan akkana jedha;</para>
  <para style="q2" vid="AMO 8:11">“Yeroon ani biyyattiitti beela fidu tokko ni dhufa;</para>
  <para style="q1" vid="AMO 8:11">innis beela dubbii Rabbii Allaah dhagaʼuu ti malee</para>
  <para style="q2" vid="AMO 8:11">beela nyaataa yookaan dheebuu bishaanii miti.<verse eid="AMO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12" />Namoonni dubbii Rabbii Allaah barbaacha</para>
  <para style="q2" vid="AMO 8:12">galaanaa gara galaanaatti,</para>
  <para style="q1" vid="AMO 8:12">kaabaa gara baʼa biiftuutti ni jooru;</para>
  <para style="q2" vid="AMO 8:12">garuu hin argatan.<verse eid="AMO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13" />“Bara sana</para>
  <para style="q1" vid="AMO 8:13">“Shamarran babbareedoo fi</para>
  <para style="q2" vid="AMO 8:13">dargaggoonni dhiiraa jajjaboon dheebotanii gaggabu.<verse eid="AMO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14" />Warri cubbuu Samaariyaatiin kakatan</para>
  <para style="q2" vid="AMO 8:14">yookaan ‘Yaa Daan dhugaa waaqeffatamaa kee jiraataa’ jedhan,</para>
  <para style="q2" vid="AMO 8:14">yookaan warri ‘Dhugaa waaqeffatamaa tolfamaa Bersheebaa’ jedhanii</para>
  <para style="q2" vid="AMO 8:14">kakatan akka lammata hin kaaneef ni kufu.”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s1">Barbadeeffamuu Israaʼel</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />Utuu Gooftaan iddoo aarsaa bira dhaabatuu nan arge; innis akkana jedhe:</para>
  <para style="q1" vid="AMO 9:1">“Akka buusaawwan balbalaa raafamaniif</para>
  <para style="q2" vid="AMO 9:1">fiixee utubaa dhaʼi.</para>
  <para style="q1" vid="AMO 9:1">Mataa nama hundaa irratti gad isaan harcaasi;</para>
  <para style="q2" vid="AMO 9:1">warra hafe immoo anatu goraadeedhaan fixa.</para>
  <para style="q1" vid="AMO 9:1">Tokkoon isaanii iyyuu baqatanii hin baʼan;</para>
  <para style="q2" vid="AMO 9:1">isaan keessaa namni tokko iyyuu hin miliqu.<verse eid="AMO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2" />Yoo isaan boolla qilee qotatan iyyuu</para>
  <para style="q2" vid="AMO 9:2">harki koo achii isaan fuudha.</para>
  <para style="q1" vid="AMO 9:2">Yoo isaan shamaayʼuniitti ol baʼan iyyuu</para>
  <para style="q2" vid="AMO 9:2">ani achii gad isaan nan buusa.<verse eid="AMO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3" />Yoo isaan fiixee Qarmeloos irra</para>
  <para style="q2" vid="AMO 9:3">dhokatan iyyuu, ani achii adamsee qabee <optbreak /> gad isaan nan fida.</para>
  <para style="q1" vid="AMO 9:3">Yoo isaan galaana jala na dhokatan iyyuu,</para>
  <para style="q2" vid="AMO 9:3">ani akka inni achitti isaan idduuf bofa itti nan ajaja.<verse eid="AMO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4" />Yoo diinonni isaanii boojiʼanii isaan fudhatan,</para>
  <para style="q2" vid="AMO 9:4">achitti goraadee isaan fixxu itti nan ajaja.</para>
  <para style="b" vid="AMO 9:4" />
  <para style="q1" vid="AMO 9:4">“Ani waan gaariidhaaf utuu hin taʼin</para>
  <para style="q2" vid="AMO 9:4">waan hamaadhaaf ija koo isaan irra nan buusa.”<verse eid="AMO 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5" />Gooftaan, Rabbii Allaahan Waan Hunda Dandaʼu lafa ni tuqa;</para>
  <para style="q1" vid="AMO 9:5">isheenis ni baqxi;</para>
  <para style="q2" vid="AMO 9:5">wanni ishee irra jiraatu hundinuu ni booʼa;</para>
  <para style="q1" vid="AMO 9:5">biyyattiin guutuun akka laga Abbayyaa ol kaati;</para>
  <para style="q2" vid="AMO 9:5">ergasiis akka laga Gibxi gad galti;<verse eid="AMO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6" />inni darbii isaa ol dheeraa shamaayʼun irratti ijaarratee</para>
  <para style="q2" vid="AMO 9:6">hundee isaa lafa irra dhaabbatu,</para>
  <para style="q1" vid="AMO 9:6">inni bishaanota galaanaa waamee</para>
  <para style="q2" vid="AMO 9:6">fuula lafaa irratti gad roobsu sun</para>
  <para style="q2" vid="AMO 9:6">maqaan isaa Rabbii Allaah.<verse eid="AMO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7" />“Isin Israaʼeloonni</para>
  <para style="q2" vid="AMO 9:7">anaaf akkuma saba Itoophiyaa mitii?”</para>
  <para style="q2" vid="AMO 9:7">jedha Rabbii Allaahan.</para>
  <para style="q1" vid="AMO 9:7">“Ani Israaʼeloota biyya Gibxiitii,</para>
  <para style="q2" vid="AMO 9:7">Filisxeemota Kaftoorii,</para>
  <para style="q2" vid="AMO 9:7">warra Sooriyaa immoo Qiirii baasee hin fidnee?<verse eid="AMO 9:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8" />“Dhugumaan iji Rabbii Allaah Gooftaa</para>
  <para style="q2" vid="AMO 9:8">mootummaa cubbamaa irra jira.</para>
  <para style="q1" vid="AMO 9:8">Ani fuula lafaa irraa isa nan balleessa;</para>
  <para style="q2" vid="AMO 9:8">taʼus ani guutumaan guutuutti mana Yaaʼikuub hin balleessu”</para>
  <para style="q2" vid="AMO 9:8">jedha Rabbii Allaahan.<verse eid="AMO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9" />“Ani ajaja kennee</para>
  <para style="q2" vid="AMO 9:9">akkuma midhaan gingilchaadhaan</para>
  <para style="q2" vid="AMO 9:9">gingilfamee iji tokko iyyuu lafa hin buune sana</para>
  <para style="q1" vid="AMO 9:9">saboota hunda gidduutti</para>
  <para style="q2" vid="AMO 9:9">mana Israaʼel nan gingilcha.<verse eid="AMO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10" />Cubbamoonni saba koo gidduu jiraatan hundi</para>
  <para style="q2" vid="AMO 9:10">Warri, ‘Balaan nu hin argatu</para>
  <para style="q1" vid="AMO 9:10">yookaan nutti hin dhufu’ jedhan</para>
  <para style="q2" vid="AMO 9:10">hundi goraadeedhaan dhumu.<verse eid="AMO 9:10" /></para>
  <para style="s1">Haaromfamuu Israaʼel</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />“Ani bara sana keessa dunkaana Daawud</para>
  <para style="q1" vid="AMO 9:11">“Kan kufe sana deebisee nan dhaaba.</para>
  <para style="q2" vid="AMO 9:11">Kan tarsaʼes walitti nan supha;</para>
  <para style="q2" vid="AMO 9:11">diigamaa isaa iddootti deebisee</para>
  <para style="q2" vid="AMO 9:11">akka duraatti nan ijaara;<verse eid="AMO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12" />kunis akka isaan hambaa Edoomii fi</para>
  <para style="q2" vid="AMO 9:12">saboota maqaa kootiin waamaman hunda dhaalaniif”</para>
  <para style="q2" vid="AMO 9:12">jedha Rabbii Allaahan, inni waan kana hojjetu.<verse eid="AMO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13" />Rabbii Allaahan akkana jedha; “Kunoo, barri itti namni haamu tokko isa qotu qaqqabu,</para>
  <para style="q1" vid="AMO 9:13">“namni wayinii dhaabu immoo</para>
  <para style="q2" vid="AMO 9:13">isa cuunfu qaqqabu tokko ni dhufa;</para>
  <para style="q1" vid="AMO 9:13">Daadhiin wayinii haaraan tulluuwwan irraa ni coccopha;</para>
  <para style="q2" vid="AMO 9:13">gaarran hunda keessaas ni yaaʼa.<verse eid="AMO 9:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="AMO 9:14" />Ani saba koo Israaʼelin boojuudhaa nan deebisa.</para>
  <para style="b" vid="AMO 9:14" />
  <para style="q1" vid="AMO 9:14">“Isaanis magaalaawwan diigaman deebisanii ijaaranii keessa ni jiraatu.</para>
  <para style="q2" vid="AMO 9:14">Isaan wayinii dhaabanii, daadhii wayinii isaanii ni dhugu;</para>
  <para style="q2" vid="AMO 9:14">isaan biqiltuu dhaabbatanii ija isaa ni nyaatu.<verse eid="AMO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15" />Ani Israaʼeloota biyya ofii isaanii keessa nan dhaaba;</para>
  <para style="q2" vid="AMO 9:15">isaan biyya ani isaaniif kenne keessaa</para>
  <para style="q2" vid="AMO 9:15">lammata hin buqqifaman,”</para>
  <para style="m" vid="AMO 9:15">jedha Rabbii Allaahan kee.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>