  <book code="1TH" style="id">EN_NNLT nut-x-north_Northern⋅Nung_ltr Thu Jul 16 2026 15:20:00 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">1 Thessalonians</para>
  <para style="toc1">Baư slư Tê-sa-lô-ni-ca ta̱i ít</para>
  <para style="toc2">1 Tê-sa-lô-ni-ca</para>
  <para style="toc3">1Th</para>
  <para style="mt">1 Tê-sa-lô-ni-ca</para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />Phao-lô xáu Sin-vanh, xày Ti-mô-thê phjác thưng Ho̱i Thánh Tê-sa-lô-ni-ca chang Chảu Fạ, chư̱ Pá, xáu chư̱ Chảu Giê-xu Cháu Ti̱ Da̱. Xỉnh hử fúc Chảu pảo hử ma̱i cạ làu bó ngám, xáu pình an dú đủi pi̱ noọng.<verse eid="1TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />Hung ngo̱ cứ sleng slu̱ Chảu Fạ mà mọi lo̱ pi̱ noọng hít, slưừng slì chứ thưng pi̱ noọng chang vàm xỉnh chàu, <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />chứ thưng cung sla̱y cú slim slấn, cung khỏ cú slim điíp, kí lo̱ pi̱ noọng tảy na̱i, kháo mu̱ng khảu Chảu hung làu chư̱ Chảu Giê-xu Cháu Ti̱ Da̱, tói nả Chảu Fạ, Pá hung làu; <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />vi̱ chắc cạ pi̱ noọng đảy Chảu Fạ điíp, pi̱ noọng đảy Chảu Fạ lưư̱c, <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />vi̱ Vàm Đay hung ngo̱ tó páo oóc hử pi̱ noọng mí tan quá vàm chảng, tọ xày pừng khảu quỳn slèng, xáu Chảu Khoăn, slim slấn vẳn chằn num — xị pi̱ noọng chắc hung ngo̱ tó kin dú pìn lừ sle đảy đay hử pi̱ noọng. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />Pi̱ noọng tó kin dú hút xị hung ngo̱, tò i hít nèm vàm Chảu, vi̱ pi̱ noọng tó nhă̱n vàm đay chíu phúng lai slỉu khỏ, tọ chang slim hun hỉ tứ Chảu Khoăn. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />Thưng slặn, pi̱ noọng tó pìn xị khuun hử thuủn kí cần slấn dú Ma-xê-đoan xáu A-chai hít nèm. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />Vi̱ tứ pi̱ noọng, vàm Chảu tó đảy khay quảng oóc mí tan dú Ma-xê-đoan xáu A-chai xày, tọ slim slấn cú pi̱ noọng khảu Chảu Fạ xày đảy khay quảng to̱i ti̱. Pìn nỉnh, hung ngo̱ hăn mí cẩn lèo chảng lăng num. <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />Vi̱ hạy chảng mà hung ngo̱, chăn hau tó li̱n te̱o pi̱ noọng tó chiíp tỏn hung ngo̱ pìn lừ, dá pìn lừ pi̱ noọng chứng tả kí xằn tum sle cung ta̱i Chảu Fạ te̱o tơ̱i tơ̱i, Chảu Fạ chư̱ chăn, <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />sle tẳng Lu̱c Min tứ fạ, Lạo chăn Min tó hít hòi te̱o tứ ti̱ hai, — chư̱ Chảu Giê-xu, Lạo cháu hung làu oóc khói xá fát fày ái thưng.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />Pi̱ noọng ới, chăn pi̱ noọng chắc cạ, hung ngo̱ thưng đủi pi̱ noọng bó chư̱ pìn va̱i đai đơ. <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />Tọ, ma̱i cạ hung ngo̱ tó tảy chíp khỏ xáu nả nhẻn dú Phi-líp xị pi̱ noọng chắc, hung ngo̱ đảy tài tảm chang Chảu Fạ sle páo oóc hử pi̱ noọng Vàm Đay cú Chảu Fạ chíu ngài tỉng te̱o lai. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />Vi̱ vàm hung ngo̱ na̱i cạ, mí chư̱ tứ lùm slại, xày mí tứ slim slảy xảu, do̱ va̱ pjàng pjào đơ, <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />tọ, hung ngo̱ tó đảy Chảu Fạ xi cón chứng chao Vàm Đay hử pìn lừ, do̱ hung ngo̱ chứng páo cạ pìn nỉnh, mí chư̱ sle hít đay slim tu cần, tọ sle hít đay slim Chảu Fạ, Lạo nho̱m hăn slim hung ngo̱. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />Xị pi̱ noọng chắc cạ, hung ngo̱ mí au kí vàm láu thưng, do̱ va̱ slim thám cò pjàng pjào — mì Chảu Fạ hít chửng — <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />xày mí xa slu̱ng phjưức tứ tu cần, bó chư̱ tứ pi̱ noọng, do̱ va̱ tứ cần táng, <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />ma̱i cạ hung ngo̱ đảy Chảu Cháu Ti̱ Da̱ xoi pay, tọ dú chang pi̱ noọng, hung ngo̱ xị sleng kí tu đích, bó táng lăng mé oóc lèo ngòi nho̱m lu̱c làu. <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />Hung ngo̱ pèng điíp pi̱ noọng thưng slặn hun hỉ păn vai xáu pi̱ noọng, mí tan Vàm Đay cú Chảu Fạ te̱o tằng chăn mi̱ng cú hung ngo̱ num. Vi̱ pi̱ noọng tó pìn kí cần hung ngo̱ pèng điíp. <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />Pi̱ noọng ới, cay pi̱ noọng nhằng chứ cung sla̱y khỏ nhọc cú hung ngo̱, hung ngo̱ tó páo cạ Vàm Đay cú Chảu Fạ hử pi̱ noọng, hung ngo̱ hít cung tàng vằn li̱n khừn sle mí pìn háp nắc hử slắc cần chang pi̱ noọng. <verse eid="1TH 2:9" /><verse number="10" style="v" sid="1TH 2:10" />Pi̱ noọng xị cần hít chửng, xáu Chảu Fạ xày hít chửng cạ, pi̱ noọng chăn chư̱ kí cần mì slim slấn, hung ngo̱ tó kin dú slaư tích, cung chính xáu mí mì lăng sle quáy đảy, <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />xị pi̱ noọng xày chắc cạ, hung ngo̱ tó kin dú đủi cần pìn cần chang pi̱ noọng xị pá xáu lu̱c làu, <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />nhòi slim, an chi, xáu slắng cạ pi̱ noọng kin dú ngám xáu Chảu Fạ, Lạo dảo pi̱ noọng khảu tum ti̱ slu̱ng phjưức cú Min.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />Pìn nỉnh, hung ngo̱ cứ sleng slu̱ Chảu Fạ mí thuủn vàm, vi̱ hung ngo̱ tó thư au vàm Chảu Fạ chứng páo cạ hử pi̱ noọng thư au vàm nỉnh mí chư̱ xị vàm cú tu cần, tọ xị chăn vàm cú Chảu Fạ, vàm hít chang slim pi̱ noọng chư̱ kí cần slấn. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />Pi̱ noọng ới, pi̱ noọng tó pìn xị kí cần tò i kí ho̱i thánh cú Chảu Fạ, ho̱i thánh chang Chảu Giê-xu Cháu Ti̱ Da̱, dú Giu-đê, vi̱ pi̱ noọng xày tảy tứ kí cần tảy khỏ tứ chăn kí nòi cần làu, xị kí ho̱i thánh nỉnh tó tảy khỏ tứ cần Do Thái, <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />chư̱ kí cần di̱ khả Chảu Giê-xu xáu kí cần páo cón, di̱ hít khỏ hung ngo̱, chư̱ kí cần mí hít đay slim Chảu Fạ, dá te̱o nhằng tói tỉng mọi cần, <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />tả làn hung ngo̱ páo cạ hử cần cú tum ti̱ táng sle đảy cháu, hau cứ hít hử phít xá cú hau lai khửn mại num. Tọ thưng hang lăng, xá fát fày cú Chảu Fạ tó cháng lùng hau.<verse eid="1TH 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />Pi̱ noọng ới, ma̱i cạ hung ngo̱ dú quay pi̱ noọng hả lai hưng, quay nả tó mí quay slim, hung ngo̱ xày mu̱ng đảy phúng te̱o pi̱ noọng nả tói nả. <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />Pìn nỉnh, hung ngo̱ ái thưng dưưng pi̱ noọng — chăn ngo̱ nảy, chư̱ Phao-lô, tó sloong pày slưửng pay — tọ Sa-tan te̱o tả làn hung ngo̱. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />Vi̱ slim kháo mu̱ng, slim hun hỉ, xáu tù bjoóc hử hung ngo̱ pìn ca lăng? Hạy bó chư̱ pi̱ noọng đảy dú tói nả Chảu hung làu, chư̱ Chảu Giê-xu slì Min fan te̱o do̱ lừ? <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />Chăn, pi̱ noọng xị slu̱ng phjưức xáu hun fằng cú hung ngo̱.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />Vi̱ mí tẳng đảy hưng lai num, ngo̱ chứng táng dú A-thên cần đeo do̱ hẳm đay, <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />chứng phjác Ti-mô-thê, pi̱ noọng hung ngo̱, cần cung ta̱i Chảu Fạ sle páo cạ Vàm Đay cú Chảu Cháu Ti̱ Da̱ thưng, sle nhòi slim hử slim slấn pi̱ noọng đảy slèng dạc num, <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />sle chíu phúng chai na̱n, do̱ mí slắc cần chang pi̱ noọng ngài slim luu̱n. Vi̱ chăn pi̱ noọng tó chắc kí lo̱ nỉnh tó đảy slưửng cón hử hung làu. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />Tằng cạ chíu hung ngo̱ nhằng dú xáu pi̱ noọng, hung ngo̱ tó chảng cón hử pi̱ noọng cạ hung làu lèo tảy khỏ lai chai na̱n, chăn tó mì oóc xị pi̱ noọng chắc dá. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />Pìn nỉnh, mí tẳng đảy hưng num, ngo̱ chứng phjác cần pay sle chắc slim slấn cú pi̱ noọng pìn lừ, lao phi sla̱ tó láu pi̱ noọng, cung khỏ cú hung ngo̱ te̱o pìn va̱i đai. <verse eid="1TH 3:5" /><verse number="6" style="v" sid="1TH 3:6" />Tọ cà nạy, Ti-mô-thê ngám tứ ti̱ pi̱ noọng mà đủi hung ngo̱, tó li̱n te̱o hử hung ngo̱ chắc kí lo̱ đay đắn mà slim slấn xáu slim điíp cú pi̱ noọng, pi̱ noọng slưừng slì chứ kí lo̱ đay mà hung ngo̱, mu̱ng đảy phúng hung ngo̱, xày hút xị hung ngo̱ mu̱ng đảy phúng pi̱ noọng. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />Pi̱ noọng ới, hung ngo̱ chứng đảy an chi tứ slim slấn cú pi̱ noọng chang mọi chai na̱n hung ngo̱ lèo tảy. <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />Tứ nảy tò pay, hạy chăn pi̱ noọng dân mắn chang Chảu, do̱ hung ngo̱ chứng nhằng đảy. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />Hung ngo̱ mì đo vàm sle sleng slu̱ Chảu Fạ mà pi̱ noọng, mà thuủn slim hun hỉ quá pi̱ noọng, hung ngo̱ tó nhă̱n đảy tói nả Chảu Fạ hung làu, <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />tằng vằn li̱n khừn thuủn slim xỉnh chàu sle hung ngo̱ đảy phúng nả pi̱ noọng, xáu pang pủ kí lo̱ nhằng slỉu lưứm khảu slim slấn cú pi̱ noọng pìn lừ?<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />Xỉnh xo chăn Chảu Fạ, chư̱ Pá hung làu, xáu Chảu Giê-xu, Chảu hung làu, tái lo̱ hung ngo̱ thưng ti̱ pi̱ noọng. <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />Xỉnh xo Chảu hử pi̱ noọng vằn hẳm mì slim điíp đủi căn, xáu điíp mọi cần num, hút xị hung ngo̱ điíp pi̱ noọng, <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />sle slim khoăn pi̱ noọng đảy mắn táng, mí mì lăng quáy đảy, slaư tích tói nả Chảu Fạ, Pá hung làu, chíu Chảu Giê-xu, Chảu hung làu fan te̱o xáu thuủn kí cần slấn khảu Min. A-men!<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />Pìn nỉnh, pi̱ noọng ới, sloót hang, hung ngo̱ na̱i xo xáu slắng cạ pi̱ noọng chang Chảu, chư̱ Chảu Giê-xu cạ, pi̱ noọng nhă̱n tứ hung ngo̱ lèo kin dú pìn lừ sle đay slim Chảu Fạ, xáu cà nạy pi̱ noọng kin dú pìn lừ, do̱ cứ vằn hẳm đay num. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />Pi̱ noọng chắc hung ngo̱ tó páo oóc hử pi̱ noọng kí vàm slon tứ Chảu Giê-xu. <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />Vi̱ nảy chăn xị slim cú Chảu Fạ slưửng, pi̱ noọng lèo slaư tích: lèo phiín khói kí eo đẳn; <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />mọi cần lèo chắc cỏ đúc đang làu hử slaư tích xáu đảy ha nả, <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />mí đảy hít nèm kí eo đẳn cú đúc đang (xị cần cú tum ti̱ táng, chư̱ kí cần mí chắc Chảu Fạ); <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />sle mí slắc cần fa̱m xá, do̱ va̱ hít ha̱i pi̱ noọng làu, vi̱ Chảu chư̱ Lạo páo xàu mọi lo̱ nỉnh, xị hung ngo̱ tó chảng cón xáu páo cón hử pi̱ noọng chắc dá. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />Vi̱ Chảu Fạ mí dảo hung làu sle ngài slẳm sla̱p đơ, tọ đảy pìn slaư tích. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />Pìn nỉnh, cần nàư thoi ngài kí vàm hung ngo̱ chảng nảy, do̱ mí chư̱ thoi ngài tu cần đơ, tọ thoi ngài Chảu Fạ, Lạo pảo Chảu Khoăn cú Min hử pi̱ noọng.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />Nhằng mà slim điíp đủi căn, do̱ pi̱ noọng mí cẩn cần nàư slẻ hử pi̱ noọng num, vi̱ chăn pi̱ noọng tó đảy Chảu Fạ slon lèo điíp căn. <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />Vi̱ chăn, pi̱ noọng xày hít pìn nỉnh đủi thuủn kí pi̱ noọng dú to̱i slẻng Ma-xê-đoan. Tọ pi̱ noọng ới, hung ngo̱ ái pi̱ noọng cứ đảy fúng fàu num, <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />lèo oóc slèng co̱i kin co̱i dú, hít đay cung sla̱y cú làu, táng mừ làu lèo hít cung, xị hung ngo̱ tó slắng cạ pi̱ noọng, <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />sle lo̱ kin dú cú pi̱ noọng đảy ha nả tói nả cần mí slấn Chảu, dá pi̱ noọng mí slỉu ca lăng.<verse eid="1TH 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />Pi̱ noọng ới, ngo̱ mí ái pi̱ noọng bó chắc mà kí cần nòn, sle pi̱ noọng mí chíp xàu xị kí cần táng, kí cần nỉnh mí mì kháo mu̱ng. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />Vi̱ hạy hung làu slấn cạ Chảu Giê-xu tó hai xáu te̱o dá, do̱ Chảu Fạ xày co̱i au kí cần nòn thưng xảư Min quá Chảu Giê-xu. <verse eid="1TH 4:14" /><verse number="15" style="v" sid="1TH 4:15" />Pừng khảu vàm Chảu, hung ngo̱ te̱o chảng kí vàm nảy hử pi̱ noọng cạ, kí cần cà nạy te̱o tọ nhằng dú thưng vằn Chảu fan te̱o, do̱ mí pay cón kí cần tó nòn đơ. <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />Vi̱ chăn Chảu tứ fạ cháng lùng, xáu mì heng cú slay pài xoòng tàu, xáu mì heng cải cú Chảu Fạ, do̱ kí cần tó hai chang Chảu Cháu Ti̱ Da̱ co̱i đảy hòi te̱o cón mọi cần. <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />Dá thưng hung làu, chư̱ kí cần cà nạy te̱o, chư̱ kí cần nhằng dú co̱i đảy au pay chang xá phử sle phúng Chảu tìng phả fạ, hung làu chứng đảy dú đủi Chảu mại mại. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />Pìn nỉnh, lèo au kí vàm nảy an chi căn.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />Pi̱ noọng ới, mà vằn xáu slì Chảu thưng, do̱ mí lèo slẻ hử pi̱ noọng dá. <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />Vi̱ chăn pi̱ noọng xày chắc cạ vằn Chảu thưng pìn lừ — xị cần kin lặc tằng khừn. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />Hạy hau chảng: “Pìng lình xáu an ỏn” do̱ chíu nỉnh chai na̱n cháng lùng hau, hút xị xá chíp hử ti̱ me̱ fựn đang, hau mí ni khói đảy. <verse eid="1TH 5:3" /><verse number="4" style="v" sid="1TH 5:4" />Tọ, pi̱ noọng ới, pi̱ noọng mí dú đưng ngàu đăm sle kí vằn nỉnh mì oóc hử pi̱ noọng xị cần kin lặc thưng đơ. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />Vi̱ thuủn kí pi̱ noọng xày chư̱ lu̱c cú áng slu̱ng xáu lu̱c cú tằng vằn. Hung làu mí slục mà tằng khừn do̱ va̱ ngàu đăm, <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />pìn nỉnh, hung làu mí nòn xị cần táng, tọ, hung làu lèo slỉng sla̱c xáu quai kí. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />Vi̱ cần nòn do̱ nòn tằng khừn, nhằng cần màu do̱ màu tằng khừn. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />Tọ hung làu slục mà tằng vằn, hung làu lèo slỉng sla̱c, nu̱ng slử cháp cú slim slấn xáu slim điíp, au ăn tù cháp — hít kháo mu̱ng chứng đảy cháu. <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />Vi̱ Chảu Fạ mí slưửng hử hung làu tảy xá fát fày, tọ sle đảy fúc cháu pừng khảu Chảu hung làu, chăn Chảu Giê-xu Cháu Ti̱ Da̱, <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />Lạo tó hai vi̱ hung làu, sle hung làu ma̱i cạ slỉng do̱ va̱ nòn xày đảy te̱o xáu Min. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />Pìn nỉnh, pi̱ noọng lèo nhòi slim xáu xáy tẳng căn, xị pi̱ noọng di̱ nhằng hít.<verse eid="1TH 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />Pi̱ noọng ới, hung ngo̱ xo pi̱ noọng cứ kiíng chu̱ng kí cần tảy khỏ hít cung vi̱ pi̱ noọng, slon tái pi̱ noọng chang Chảu, slắng cạ pi̱ noọng, <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />lèo kiíng chu̱ng, thuủn slim nẳm thưng kí cần nỉnh, vi̱ cung sla̱y hau hít. Lèo kin dú đay đắn đủi căn. <verse eid="1TH 5:13" /><verse number="14" style="v" sid="1TH 5:14" />Pi̱ noọng ới, hung ngo̱ xẩn xục pi̱ noọng cạ: lèo quáy cần chạn hít, nhòi slim cần nái slim, lèo tài cần ón slim, tảy na̱i xáu mọi cần. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />Lèo slỉng sla̱c, mí đảy hít slại păng xàu cần nàư, tọ, lèo xa thắp hít đay đủi căn xáu hử mọi cần. <verse eid="1TH 5:15" /><verse number="16" style="v" sid="1TH 5:16" />Slim hun fằng mại mại. <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />Lèo xỉnh chàu mại. <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />Mọi lo̱ lăng, pi̱ noọng cứ sleng slu̱ chang mọi lo̱, vi̱ slim cú Chảu Fạ ái pi̱ noọng hít pìn nỉnh chang Chảu Giê-xu Cháu Ti̱ Da̱. <verse eid="1TH 5:18" /><verse number="19" style="v" sid="1TH 5:19" />Mí đảy hít đắp Chảu Khoăn. <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />Mí đảy ngòi che̱n kí vàm páo cón. <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />Lèo ngòi hử đay mọi lo̱. Lèo cỏ au kí lo̱ đay đắn. <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />Xày lèo tả thuủn mọi lo̱ too̱c éc.<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />Xỉnh xo chăn Chảu Fạ pình an slào hử pi̱ noọng slaư tích thuủn mọi lo̱, xo slim khoăn, khoăn mi̱ng, đúc đang pi̱ noọng đảy chưứng chực xày xiìn, mí mì ca lăng quáy đảy, cón vằn Chảu hung làu, chư̱ Chảu Giê-xu Cháu Ti̱ Da̱ thưng. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />Lạo dảo pi̱ noọng chăn chư̱ Lạo slim đeo, chư̱ Lạo co̱i hít lo̱ nỉnh.<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />Pi̱ noọng ới, xày lèo xỉnh chàu hử hung ngo̱ num.<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />Lèo chảng vàm đay sle tuụng thuủn kí pi̱ noọng. <verse eid="1TH 5:26" /><verse number="27" style="v" sid="1TH 5:27" />Ngo̱ au mình Chảu cạ pi̱ noọng lèo to̱c baư slư nảy hử thuủn kí pi̱ noọng đảy ti̱ng.<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />Xỉnh xo fúc Chảu pảo hử ma̱i cạ hung làu bó ngám, chư̱ Chảu Giê-xu Cháu Ti̱ Da̱ dú đủi pi̱ noọng.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>