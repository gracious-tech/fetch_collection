<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">EN_NNLT nut-x-north_Northern⋅Nung_ltr Thu Jul 16 2026 15:20:00 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Luke</para>
  <para style="toc1">Vàm Đay Lu-ca</para>
  <para style="toc2">Lu-ca</para>
  <para style="toc3">Luk</para>
  <para style="mt">Lu-ca</para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />Vi̱ mì lai cần tó oóc slèng slẻ oóc sle li̱n te̱o mà kí lo̱ tó đảy hít pìn xình chang hung làu, <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />chăn xị kí cần tứ xo tàu tó đảy hăn xáu cần cung ta̱i vàm Chảu chảng te̱o hử hung làu chắc, <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />pìn nỉnh, lăng slì ngòi vẳn chằn mọi lo̱ tứ xo tàu, ngo̱ nẳm hăn cẩn slẻ slặp cón lăng hử ni̱, Thê-ô-phi-lơ pèng điíp ới, <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />sle ni̱ chắc mà kí lo̱ làu đảy slon chăn chư̱ mắn táng.<verse eid="LUK 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />Chang tơ̱i Hê-rốt, hít huùng cú búng Giu-đê, mì slay pài xoòng nưng mìng hít Xa-cha-ri, slục nòi A-bi-gia. Me̱ ké mìng hít Ê-li-sa-bét, lu̱c slao cú nòi A-rôn. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />Tằng sloong po̱ me̱ xày cung chính tói nả Chảu Fạ, kin dú mí mì lăng quáy đảy chang mọi vàm xáu luật cú Chảu slon cạ. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />Hau mí mì lu̱c, vi̱ Ê-li-sa-bét ngài măn, xáu tằng sloong tó lai pi dá.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />Lo̱ nảy mì oóc chíu ké hít cung sla̱y cú slay pài xoòng tói nả Chảu Fạ, thưng pày cú phang làu, <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />xị mọi pày thưng cú phang pài xoòng, pày nảy ké tó slải sló đảy khảu lưừn slớ cú Chảu Fạ sle chang dưưng. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />Tằng pan đung dú noo̱c xày xỉnh chàu chíu chang dưưng. <verse eid="LUK 1:10" /><verse number="11" style="v" sid="LUK 1:11" />Chíu nỉnh, mì cần tang nả Chảu oóc nả đủi Xa-cha-ri, dân bưửng sla xoòng xằn chang dưưng. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />Xa-cha-ri slim luu̱n vi̱ hăn cần tang nả fạ, ké chứng he lai. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />Tọ cần tang nả fạ cạ ké: “Xa-cha-ri, mí đảy lao, vi̱ vàm xỉnh chàu cú ni̱ tó đảy nhă̱n, Ê-li-sa-bét, me̱ cú ni̱, co̱i sleng lu̱c báo nưng hử ni̱, ni̱ lèo tặt mìng hử lu̱c hít Giăng. <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />Đích báo nỉnh co̱i hít hử ni̱ hun hỉ fằng fừ, xáu lai cần co̱i hun hỉ vi̱ tu đích đảy sleng oóc. <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />Vi̱ đích báo nỉnh co̱i đảy ngòi đay tói nả Chảu Fạ, min mí kin lảu mác ít do̱ va̱ kí thìng nặm hít hử màu mè, xáu tó đảy tim Chảu Khoăn tứ chíu nhằng dú chang toọng mé dá. <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />Tu đích nỉnh co̱i hít hử lai cần Y-sơ-ra-ên fan te̱o đủi Chảu chăn chư̱ Chảu Fạ cú hau. <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />Chăn min co̱i au ching xằn xáu quỳn slèng cú Ê-li pay tói nả Chảu, sle au slim cú cần pá fan te̱o đủi kí lu̱c, kí cần mí ti̱ng vàm co̱i đảy quai kí xị cần cung chính — sle chắp xặp nòi cần nưng ính xình hử Chảu.”<verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />Xa-cha-ri dăng cần tang nả fạ: “Hít lừ ngo̱ chắc làu đảy lo̱ nảy? Vi̱ ngo̱ tó ké, nhằng me̱ cú ngo̱ do̱ lai pi dá.” <verse eid="LUK 1:18" /><verse number="19" style="v" sid="LUK 1:19" />Cần tang nả fạ hòi vàm ké: “Ngo̱ chư̱ Gáp-ri-ên, dân tói nả Chảu Fạ mại, ngo̱ đảy xoi mà cạ ni̱ xáu páo vàm đay nảy hử ni̱. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />Ti̱ng ne̱, ni̱ co̱i ngài vặp, mí chảng đảy thưng vằn kí lo̱ nảy mì oóc, vi̱ ni̱ mí slấn vàm ngo̱, chư̱ kí vàm co̱i đảy lình ính khảu chăn slì.” <verse eid="LUK 1:20" /><verse number="21" style="v" sid="LUK 1:21" />Chíu nỉnh, phang cần tẳng Xa-cha-ri, hau hăn lạ vi̱ ké dú chang lưừn slớ hưng. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />Chíu oóc pay, ké mí chảng đảy xáu phang cần, hau chứng chắc ké đảy hăn chang slim khoăn dú chang lưừn slớ, nhằng ké cứ oóc ha̱o hử hau vi̱ di̱ nhằng ngài vặp. <verse eid="LUK 1:22" /><verse number="23" style="v" sid="LUK 1:23" />Slì quá kí vằn cung ta̱i dú lưừn slớ, ké fan mừ lưừn làu.<verse eid="LUK 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 1:24" />Lăng kí vằn nỉnh, me̱ ké mìng hít Ê-li-sa-bét làm đang, hả bưưn mí oóc khói lưừn, da̱ chảng <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />cạ: “Chảu Fạ tó hít pìn nỉnh hử ngo̱, chang kí vằn Chảu Fạ điíp ngo̱, sle ngo̱ khói ngài nả nhẻn tói nả mọi cần.”<verse eid="LUK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />Thưng bưưn ta̱i húc, Chảu Fạ xoi cần tang nả mìng hít Gáp-ri-ên thưng slẻng Na-xa-rét, slục búng Ga-li-lê, <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />phúng slao nóm nưng mìng hít Ma-ri, tó tham háp xáu cần báo mìng hít Giô-sép, slục nòi huùng Đa-vít. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />Chíu phúng da̱ dá, cần tang nả fạ cạ: “Hun hỉ hử ni̱ vi̱ đảy fúc! Chảu dú đủi ni̱.” <verse eid="LUK 1:28" /><verse number="29" style="v" sid="LUK 1:29" />Tọ Ma-ri slim luu̱n lai mà kí vàm nảy xáu táng nẳm vàm tuụng nỉnh mì ý xí lăng. <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />Cần tang nả fạ te̱o cạ: “Ma-ri ới, mí đảy lao, vi̱ ni̱ tó đảy fúc tói nả Chảu Fạ. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />Ne̱, ni̱ co̱i làm đang, dá sleng lu̱c báo nưng, ni̱ tặt mìng hít Giê-xu. <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />Lu̱c báo nỉnh co̱i đảy ha nả, đảy dảo hít Lu̱c cú Lạo Ta̱i Slung, đảy Chảu chăn chư̱ Chảu Fạ pảo hử Min táp tắng huùng Đa-vít, cúc chỏ Min. <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />Min co̱i cai cuủn lưừn Gia-cốp thưng tơ̱i tơ̱i, tum ti̱ Min nhằng mì mại mại.” <verse eid="LUK 1:33" /><verse number="34" style="v" sid="LUK 1:34" />Ma-ri dăng cần tang nả fạ: “Hít lừ lo̱ nỉnh mì oóc đảy, ngo̱ xằng kin nòn xáu cần ti̱ po̱ haư num?” <verse eid="LUK 1:34" /><verse number="35" style="v" sid="LUK 1:35" />Cần tang nả fạ hòi vàm da̱: “Chảu Khoăn co̱i dú tìng ni̱, xáu quỳn slèng cú Lạo Ta̱i Slung co̱i dà pao ni̱. Pìn nỉnh Lu̱c Thánh sleng oóc co̱i đảy dảo hít Lu̱c Chảu Fạ. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />Nho̱m cà, Ê-li-sa-bét, pi̱ noọng đủi ni̱ — xày làm đang lu̱c báo nưng chíu tó ké cắc dá, da̱ nỉnh tó ngài măn tọ cà nạy làm đang đảy húc bưưn dá. <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />Vi̱ bó mì vàm lăng đảy Chảu Fạ chảng te̱o bó mì oóc.” <verse eid="LUK 1:37" /><verse number="38" style="v" sid="LUK 1:38" />Chíu nỉnh, Ma-ri dăng: “Ngo̱ nảy, chư̱ slao khỏi cú Chảu. Xo lo̱ nỉnh đảy pìn hử ngo̱ xị vàm Chảu cạ!” Dá cần tang nả fạ pja̱c khói Ma-ri.<verse eid="LUK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />Chang kí vằn nỉnh, Ma-ri tấn dân, slim hun hỉ pay mà ti̱ pò phja, thưng slẻng nưng cú Giu-đa, <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />dá pay khảu lưừn Xa-cha-ri xáu tuụng Ê-li-sa-bét. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />Ê-li-sa-bét ngám ti̱ng heng Ma-ri tuụng, do̱ tu đích chang toọng liìn dét fằng, nhằng Ê-li-sa-bét đảy tim Chảu Khoăn. <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />Da̱ moòng cải khửn cạ: “Ni̱ chăn đảy fúc quá kí cần ti̱ me̱, tu đích chang toọng ni̱ xày đảy fúc. <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />Hít lừ ngo̱ đảy ha nả pìn nảy, chư̱ mé cú Chảu mà dưưng ngo̱ mí? <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />Nho̱m cà, chíu xu ngo̱ ngám ti̱ng heng ni̱, do̱ tu đích chang toọng ngo̱ liìn dét fằng. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />Fúc hử ni̱ tó slấn, vi̱ vàm Chảu cạ ni̱ co̱i đảy lình ính.” <verse eid="LUK 1:45" /><verse number="46" style="v" sid="LUK 1:46" />Ma-ri chảng:</para>
  <para style="q1" vid="LUK 1:46">“Khoăn mi̱ng cú ngo̱ tài slung Chảu,<verse eid="LUK 1:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="LUK 1:47" />slim khoăn cú ngo̱ fằng fừ chang Chảu Fạ, chăn chư̱ Lạo Cháu ngo̱.<verse eid="LUK 1:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48" />Vi̱ Min tó điíp sliít slăn fă̱n che̱n chạ cú slao khỏi cú Min.</para>
  <para style="q1" vid="LUK 1:48">Nho̱m ne̱, tứ nảy mà lăng, mọi xám cần co̱i că̱n ngo̱ đảy fúc,<verse eid="LUK 1:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="LUK 1:49" />vi̱ Lạo Quỳn Slèng tó hít kí lo̱ cải hử ngo̱,</para>
  <para style="q1" vid="LUK 1:49">mình Min chăn chư̱ thánh,<verse eid="LUK 1:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50" />slim điíp sliít cú Min hử tứ xám cần nảy thưng xám cần lăng xáu kí cần kiíng lao Min.<verse eid="LUK 1:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51" />Min tó au mừ Min hít kí lo̱ quỳn slèng;</para>
  <para style="q1" vid="LUK 1:51">Min hít slán slác kí cần nẳm háo cao chang slim.<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />Min te̱p kí cần đé đẩn khói ti̱ nă̱ng,</para>
  <para style="q1" vid="LUK 1:52">xáu dảu kí cần che̱n chạ khửn slung.<verse eid="LUK 1:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53" />Min tó hít hử cần dác đảy ím kí cú kin đay,</para>
  <para style="q1" vid="LUK 1:53">tọ te̱p cần fát xài mà mừ đai.<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54" />Chảu cháu cần Y-sơ-ra-ên, chư̱ kí cần khỏi cú Min,</para>
  <para style="q1" vid="LUK 1:54">sle hau chứ te̱o slim điíp sliít,<verse eid="LUK 1:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55" />xị Min tó pao xình đủi cúc chỏ hung làu — xáu Áp-ra-ham xáu nòi cần cú min thưng tơ̱i tơ̱i.”<verse eid="LUK 1:55" /></para>
  <para style="m">
    <verse number="56" style="v" sid="LUK 1:56" />Ma-ri dú đủi Ê-li-sa-bét slắc slam bưưn, dá fan mừ lưừn làu.<verse eid="LUK 1:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />Chíu nỉnh, thưng vằn dú bưưn, Ê-li-sa-bét sleng oóc đích báo nưng. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />Kí cần chang bản co̱n xáu pi̱ noọng đảy nghìn da̱ đảy Chảu điíp sliít lai, xày thưng hun hỉ đủi da̱.<verse eid="LUK 1:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59" />Thưng vằn ta̱i pét, hau thưng sle slắp năng hử đích báo, hau ái tặt mìng hít Xa-cha-ri nèm mìng pá cú min. <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />Tọ da̱ hòi vàm cạ: “Mí, tọ lèo tặt mìng hử ò đích hít Giăng.” <verse eid="LUK 1:60" /><verse number="61" style="v" sid="LUK 1:61" />Hau chảng đủi da̱ cạ: “Mí mì cần nàư chang pi̱ noọng ni̱ tặt mìng pìn nỉnh.” <verse eid="LUK 1:61" /><verse number="62" style="v" sid="LUK 1:62" />Hau oóc ha̱o tham ngòi pá ò đích ái tặt mìng lăng hử lu̱c. <verse eid="LUK 1:62" /><verse number="63" style="v" sid="LUK 1:63" />Ké cạ au kép pẻn sláy thưng, dá slẻ: “Mìng ò đích hít Giăng.” Mọi cần xày hăn lạ. <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />Chích slì, pác xáu lịn ké khay oóc, dá ké chảng đảy, că̱n Chảu Fạ. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />Tằng kí cần chang bản co̱n xày he, hau tàm đủi căn mà kí lo̱ nỉnh to̱i búng pò phja Giu-đê. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />Mọi cần ti̱ng do̱ chứ chang slim, táng tham cạ: “Mư̱ lăng, tu đích nảy co̱i pìn lừ?” Vi̱ chăn mừ Chảu tó dú đủi min.<verse eid="LUK 1:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />Xa-cha-ri, pá tu đích nỉnh, đảy tim Chảu Khoăn, ké páo cón, cạ:<verse eid="LUK 1:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />“Că̱n Chảu, chăn chư̱ Chảu Fạ cú Y-sơ-ra-ên,</para>
  <para style="q1" vid="LUK 1:68">vi̱ Min tó dưưng xáu cháu cần cú Min,<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />Min tó tài khửn hử hung làu ăn coóc sle cháu chang lưừn Đa-vít, cần khỏi cú Min,<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />(xị Min tó au pác kí cần thánh sle páo cón vàm Chảu tứ mư̱ pày),<verse eid="LUK 1:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71" />Min co̱i cháu hung làu khói kí cần tói tàu,</para>
  <para style="q1" vid="LUK 1:71">xáu khói mừ mọi cần slim xằng hung làu;<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />Min hử cúc chỏ hung làu hăn slim điíp sliít,</para>
  <para style="q1" vid="LUK 1:72">sle chứ te̱o vàm chao kiít thánh cú Min,<verse eid="LUK 1:72" /></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73" />chăn xị vàm Min tó pao xình đủi Áp-ra-ham, cúc chỏ hung làu, sle pảo hử hung làu<verse eid="LUK 1:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74" />slì hung làu đảy cháu khói mừ cú cần tói tàu,</para>
  <para style="q1" vid="LUK 1:74">sle đảy cung ta̱i Min bó nhằng lao dan lăng chạy,<verse eid="LUK 1:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75" />sle dú slaư tích xáu cung chính tói nả Min, thưng muu̱t tơ̱i hung làu.<verse eid="LUK 1:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />Đích ới, hau co̱i dảo lu̱c hít cần páo cón cú Lạo Ta̱i Slung,</para>
  <para style="q1" vid="LUK 1:76">vi̱ lu̱c co̱i pay tói nả Chảu, sle fọn lo̱ cú Min,<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />sle cần cú Min đảy chắc fúc cháu,</para>
  <para style="q1" vid="LUK 1:77">hau co̱i đảy sla phít xá,<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />pừng khảu slim điíp sliít cú Chảu Fạ hung làu,</para>
  <para style="q1" vid="LUK 1:78">áng slu̱ng tứ tìng slung chứng dưưng hung làu,<verse eid="LUK 1:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79" />sle xoi slu̱ng kí cần nă̱ng dú chang ngàu đăm khít xáu chang ngàu cú ti̱ hai,</para>
  <para style="q1" vid="LUK 1:79">sle tái kha hung làu khảu lo̱ pình an.”<verse eid="LUK 1:79" /></para>
  <para style="m">
    <verse number="80" style="v" sid="LUK 1:80" />Tu đích nỉnh cải khửn, slim khoăn slèng dạc, dú ti̱ tu̱ng lẹng thưng vằn đảy oóc tói nả cần Y-sơ-ra-ên.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />Chang kí vằn nỉnh, Sê-sa Au-gút-tơ oóc lịng to̱i ti̱ da̱ sle tiỉm xà mọi cần. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />Nảy pìn pày tiỉm xà ta̱i tàu, đảy hít chang tơ̱i Qui-ri-ni-u, cai cuủn ti̱ Sy-ri. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />Mọi cần xày lèo khửn lo̱ fan te̱o ti̱ chỏ làu sle slẻ mìng khảu sló. <verse eid="LUK 2:3" /><verse number="4" style="v" sid="LUK 2:4" />Giô-sép slục nòi cần lưừn Đa-vít xày pay tứ Ga-li-lê, pja̱c slẻng Na-xa-rét pay thưng búng Giu-đê khảu slẻng Đa-vít, đảy dảo hít Bết-lê-hem, <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />sle slẻ mìng làu xáu Ma-ri, cần tó tham háp đủi làu, làm đang. <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />Chíu sloong cần dú ti̱ nỉnh, do̱ thưng vằn Ma-ri dú bưưn. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />Da̱ sleng lu̱c báo tàu, au khưn poo̱c lu̱c làu, dá tặt ò đích khảu lằng nhả, vi̱ lưừn to̱ mí mì ti̱ váng hử hau.<verse eid="LUK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />Dú ti̱ nỉnh, xày mì kỉ cần hen chiin dú noo̱c tu̱ng, tằng khừn mí nòn sle pạư pháu chiin. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />Cần tang nả Chảu oóc nả xáu hau, slu̱ng phjưức cú Chảu xoi slu̱ng to̱i nỉnh, hau chứng lao dan lai. <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />Tọ cần tang nả fạ cạ hau: “Dá xảy lao, ngòi ne̱, vi̱ ngo̱ páo hử kí cần ni̱ vàm đay nưng, vàm đay nảy co̱i pìn hun hỉ hử mọi cần. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />Vi̱ vằn nảy dú slẻng Đa-vít, Lạo Cháu, tó đảy sleng oóc hử mọi cần, Min chư̱ Chảu Cháu Ti̱ Da̱, chư̱ Chảu. <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />Nảy pìn ha̱o sle kí cần ni̱ nhă̱n oóc Min: Kí cần ni̱ co̱i phúng tu đích nưng poo̱c khưn nòn chang lằng nhả.” <verse eid="LUK 2:12" /><verse number="13" style="v" sid="LUK 2:13" />nỉnh cà, mì tài pả thiin ping oóc nả tò xày cần tang nả fạ că̱n Chảu Fạ, cạ:<verse eid="LUK 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14" />“Slu̱ng phjưức slục mà mình Chảu Fạ dú ti̱ ta̱i slung xáu tìng tum,</para>
  <para style="q1" vid="LUK 2:14">pình an đủi kí cần dú chang slim đay cú Chảu.”<verse eid="LUK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />Chíu kí cần tang nả pja̱c khói hau khửn fạ dá, kí cần hen chiin chảng đủi căn: “Chăn, hung làu cứ pay thưng slẻng Bết-lê-hem ngòi kí lo̱ nỉnh ngám mì oóc, xị Chảu hử hung làu chắc.” <verse eid="LUK 2:15" /><verse number="16" style="v" sid="LUK 2:16" />Hau slỉnh slảng pay, phúng tằng Ma-ri xáu Giô-sép, dá hăn tu đích nòn chang lằng nhả. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />Slì hăn pìn nỉnh, hau chứng li̱n te̱o kí vàm cần tang nả fạ páo cón mà tu đích nảy. <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />Hạy cần nàư ti̱ng vàm kí cần hen chiin tàm te̱o xày hăn he. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />Nhằng Ma-ri te̱o chứ mọi vàm nỉnh, xáu nẳm chang slim. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />Kí cần hen chiin fan te̱o, tài slung xáu că̱n Chảu Fạ mà mọi lo̱ hau tó đảy ti̱ng xáu hăn, chăn xị vàm tó đảy páo cón hử hau.<verse eid="LUK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />Chíu ò đích đảy pét vằn, do̱ slắp năng hử min, dá hau tặt mìng hít Giê-xu, cần tang nả fạ tó tặt mìng hử chíu ò đích đảy làm đang đưng toọng mé.<verse eid="LUK 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22" />Slì thuủn kí vằn slào slaư nèm luật Môi-se dá, pá mé au ò đích khửn slẻng Giê-ru-sa-lem sle pài hử Chảu <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />(xị tó slẻ chang luật fáp cú Chảu, cạ: “Mọi đích báo tàu lèo sle oóc pìn thánh hử tan Chảu”), <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" />dá pài sleng lình: “tói nục khăn nưng, do̱ va̱ tói nục cu lu̱c” xị luật fáp cú Chảu slon. <verse eid="LUK 2:24" /><verse number="25" style="v" sid="LUK 2:25" />Chíu nỉnh, mì cần nưng cung chính xáu slim đay mìng hít Si-mê-ôn, dú slẻng Giê-ru-sa-lem. Ké mu̱ng tẳng lo̱ an chi cú cần Y-sơ-ra-ên, xáu Chảu Khoăn dú đủi ké. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />Chảu Khoăn hử ké chắc cón cạ ké co̱i mí hai, cón vằn đảy hăn Lạo Cháu Ti̱ Da̱ cú Chảu. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />Chảu Khoăn hử ké pay khảu lưừn slớ, chíu pá mé au Giê-xu thưng sle hít hử min kí lo̱ nèm xị luật fáp, <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />ké ủm ò đích tìng mừ, xáu că̱n Chảu Fạ, cạ:<verse eid="LUK 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29" />“Pái Chảu, cà nạy xo Chảu hử cần khỏi Chảu pay pình an, nèm xị vàm Chảu.<verse eid="LUK 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30" />Vi̱ ha lu̱c đảy hăn lo̱ cháu cú Chảu,<verse eid="LUK 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="LUK 2:31" />Chảu tó chắp xặp tói nả mọi nòi cần:<verse eid="LUK 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32" />Áng slu̱ng xoi lo̱ hử kí cần cú tum ti̱ táng, xáu pìn slu̱ng phjưức hử cần Y-sơ-ra-ên cú Min.”<verse eid="LUK 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />Pá mé tu đích hăn lạ mà kí vàm ké ngám chảng mà tu đích nỉnh. <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />Dá Si-mê-ôn pảo fúc hử hau, xáu cạ Ma-ri, mé ò đích cạ: “Ngòi cà, ò đích nảy tó đảy lưư̱c sle hít hử lai cần chang Y-sơ-ra-ên toỏng lụp do̱ va̱ tấn khửn, xáu pìn ha̱o nưng hử hau tói tỉng — <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />tọ, mì ma̱c dáng nưng xày co̱i chặc quá slim ni̱ — sle kí slim slưửng bưửng đưng lai cần đảy dẻng oóc.” <verse eid="LUK 2:35" /><verse number="36" style="v" sid="LUK 2:36" />Xày mì da̱ nưng hít cần páo cón mìng hít An-ne, lu̱c slao cú Pha-nu-ên, slục nòi A-se. Da̱ ké pi dá, da̱ dú đủi po̱ đảy chất pi, tứ chíu da̱ nhằng slao nóm, <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />dá da̱ dú mải thưng cà nạy tó đảy pét slíp slí pi, tọ bó oóc khói lưừn slớ slắc pày, tằng vằn li̱n khừn cứ cung ta̱i căm kin xáu xỉnh chàu. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />Chăn tiỉm nỉnh, da̱ sleng slu̱ Chảu Fạ dá chảng mà ò đích hử thuủn mọi cần mu̱ng tẳng slẻng Giê-ru-sa-lem đảy cháu. <verse eid="LUK 2:38" /><verse number="39" style="v" sid="LUK 2:39" />Chíu hau hít thuủn mọi lo̱ nèm luật cú Chảu dá, Giô-sép xáu Ma-ri fan te̱o slẻng Na-xa-rét cú làu slục búng Ga-li-lê.<verse eid="LUK 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 2:40" />Ò đích cải khửn slèng dạc; đảy tim quai kí, xáu min đảy Chảu Fạ pảo fúc hử xáu dú đủi min.<verse eid="LUK 2:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />Mọi pi, pá mé Min pay thưng slẻng Giê-ru-sa-lem kin le̱ Khảm Quá. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />Chíu Min đảy slíp nhi̱ pi, hau pay le̱ xị mọi pày. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />Slì kí vằn le̱ quá dá, pá mé mừ lưừn, nhằng đích báo Giê-xu do̱ dú slẻng Giê-ru-sa-lem, tọ pá mé Min te̱o mí chắc. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />Hau cứ la̱i Min xày pay đủi pan đung, pay lo̱ đảy vằn nưng, chứng xa Min chang kí pi̱ noọng xáu kí pàng dạu. <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />Mí xa hăn Min, ké da̱ chứng fan te̱o slẻng Giê-ru-sa-lem, lằm chặp thắp. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />Slam vằn lăng, hau chứng phúng Min đưng lưừn slớ nă̱ng dú tu̱ng chang đủi kí slay, di̱ ti̱ng di̱ tham hau lai lo̱. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />Mọi cần ti̱ng Min xày he mà kí thung slụ xáu vàm Min tói táp. <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />Pá mé hăn Min, do̱ he dá mé Min cạ: “Lu̱c ới, hít lăng lu̱c hít pìn nảy xáu pá mé? Ngòi ne̱, slim pá mé chíp xàu pay xa lu̱c.” <verse eid="LUK 2:48" /><verse number="49" style="v" sid="LUK 2:49" />Min hòi vàm: “Hít lừ pá mé te̱o xa lu̱c? Pá mé tó mí chắc cạ lu̱c lèo dú chang lưừn Pá lu̱c do̱ lừ?” <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />Tọ hau mí slụ vàm Min ngám chảng. <verse eid="LUK 2:50" /><verse number="51" style="v" sid="LUK 2:51" />Dá Min pay nèm pá mé fan te̱o Na-xa-rét, ti̱ng vàm hau. Nhằng mé Min do̱ chứ thuủn mọi vàm nỉnh khảu slim.<verse eid="LUK 2:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 2:52" />Chảu Giê-xu quai kí lai num, đúc đang cải luung, hẳm đảy đay slim tói nả Chảu Fạ xáu mọi cần.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />Khảu pi slíp hả cú tơ̱i huùng Sê-sa Ti-be-rơ — slì Bôn-xơ Phi-lát hít quan cải ti̱ Giu-đê, Hê-rốt hít huùng khen kha búng Ga-li-lê, nhằng Phi-líp, noọng huùng nỉnh, hít huùng khen kha búng Y-tu-rê xáu Tra-cô-nít, Ly-sa-ni-a hít huùng khen kha búng A-bi-len, <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />chíu An-ne xáu Cai-phe hít slay pài xoòng ta̱i tàu — do̱ mì vàm Chảu Fạ cạ Giăng, lu̱c báo Xa-cha-ri, chang tu̱ng lẹng. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />Giăng pay to̱i kí búng xảư xảng ta̱ Giô-đanh, páo oóc fép báp-têm mà slim cho̱i xá sle hau đảy fúc sla xá. <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />Xị vàm tó slẻ chang xéc mà kí vàm cú Ê-sai, cần páo cón:</para>
  <para style="q1" vid="LUK 3:4">“Mì heng cần moòng khửn chang tu̱ng lẹng:</para>
  <para style="q1" vid="LUK 3:4">‘Lèo fọn lo̱ cú Chảu,</para>
  <para style="q1" vid="LUK 3:4">hít hử dàu kí tèo lo̱ Min.<verse eid="LUK 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5" />Mọi slu̱ng lèo pùn hử tim,</para>
  <para style="q1" vid="LUK 3:5">mọi phja đung lèo tán hử tắm;</para>
  <para style="q1" vid="LUK 3:5">lo̱ khuung lèo cho̱i hử dàu,</para>
  <para style="q1" vid="LUK 3:5">lo̱ khúc khoắm lèo hít hử phiing phiít;<verse eid="LUK 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6" />xáu mọi nòi cần co̱i đảy hăn fúc cháu cú Chảu Fạ.’”<verse eid="LUK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />Giăng cạ phang cần kẻo thưng sle đảy ké hít báp-têm: “Nòi ngù too̱c nỉnh ới, cần nàư tó páo hử kí cần chắc sle le̱n ni khói xá fát fày ái thưng? <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />Pìn nỉnh, lèo pìn mác sle đảy ngám xáu slim cho̱i xá; mí đảy táng nẳm: ‘Hung làu mì Áp-ra-ham, chăn chư̱ cúc chỏ’ vi̱ ngo̱ chảng hử kí cần ni̱ chắc cạ: Chảu Fạ nhằng hít kí hin nảy pìn lu̱c lan Áp-ra-ham đảy. <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />Ma̱c fủ tó tặt tem cúc mạy dá. Pìn nỉnh, co haư mí pìn mác đay do̱ lèo ngài bác dá vẻng khảu fày.” <verse eid="LUK 3:9" /><verse number="10" style="v" sid="LUK 3:10" />Phang cần tham ké cạ: “Pìn nỉnh hung ngo̱ lèo hít lăng?” <verse eid="LUK 3:10" /><verse number="11" style="v" sid="LUK 3:11" />Ké hòi vàm hau: “Cần nàư mì sloong slử cứ păn hử cần mí mì; cần nàư mì cú kin do̱ hít pìn nỉnh.” <verse eid="LUK 3:11" /><verse number="12" style="v" sid="LUK 3:12" />Xày mì kí cần slau slé thưng sle nhă̱n báp-têm, hau tham ké cạ: “Slay ới, hung ngo̱ lèo hít lăng?” <verse eid="LUK 3:12" /><verse number="13" style="v" sid="LUK 3:13" />Ké cạ hau: “Mí đảy slau lai quá kí lo̱ ngo̱ cạ pi̱ noọng.” <verse eid="LUK 3:13" /><verse number="14" style="v" sid="LUK 3:14" />Kỉ cần lỉnh xày tham ké: “Nhằng hung ngo̱ lèo hít lăng?” Ké hòi vàm: “Mí đảy há pả do̱ va̱ la̱i xan cần nàư, tọ lèo ngám slim đủi chèn cung cú làu.”<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />Tọ, vi̱ phang cần mu̱ng tẳng xáu lặc nẳm chang slim mà Giăng cạ Giăng chư̱ Chảu Cháu Ti̱ Da̱ va̱, <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />Giăng chứng hòi vàm hau: “Ngo̱ hít báp-têm hử kí cần ni̱ chang nặm; tọ mì Lạo nưng ái thưng, quỳn hẳm cải quá ngo̱, ngo̱ mí ngám kẻ slai cài cú Min. Min co̱i hít báp-têm hử kí cần ni̱ chang Chảu Khoăn xáu chang fày, <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />mừ Lạo nỉnh căm ăn cào lình sle cào slaư sla̱ng co̱n khảu cú làu, xáu slau slặp khảu khảu xang, tọ Min pung nhủng nháp khảu fày bó đắp slắc pày.”<verse eid="LUK 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18" />Ké chứng cạ hau lai vàm num sle páo oóc vàm đay hử phang cần. <verse eid="LUK 3:18" /><verse number="19" style="v" sid="LUK 3:19" />Tọ chíu Hê-rốt, huùng khen kha, ngài Giăng quáy vi̱ au Hê-rô-đia, me̱ cú noọng làu, xáu mà mọi lo̱ too̱c éc Hê-rốt tó hít, <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />do̱ huùng te̱o fa̱m xá slảy khum num: ké hử cặp Giăng xăng khảu ngục.<verse eid="LUK 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />Tọ, chíu phang cần xày nhă̱n báp-têm, Chảu Giê-xu xày nhă̱n báp-têm. Chíu Min xỉnh chàu, do̱ kí tẳm fạ khay oóc, <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />dá Chảu Khoăn cháp lùng Min, bưửng noọc hút xị nục cu, te̱o mì heng tứ fạ cạ: “Lu̱c chăn chư̱ Lu̱c Cau pèng điíp, Lu̱c hít đay slim Cau.”<verse eid="LUK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />Chảu Giê-xu xo tàu cung sla̱y chíu Min đảy slắc slam slíp pi, (xị hau slấn cạ) Min chăn chư̱ lu̱c Giô-sép, Giô-sép lu̱c Hê-li, <verse eid="LUK 3:23" /><verse number="24" style="v" sid="LUK 3:24" />Hê-li lu̱c Mát-tát, Mát-tát lu̱c Lê-vi, Lê-vi lu̱c Mên-chi, Mên-chi lu̱c Gia-nê, Gia-nê lu̱c Giô-sép, <verse eid="LUK 3:24" /><verse number="25" style="v" sid="LUK 3:25" />Giô-sép lu̱c Ma-ta-thia, Ma-ta-thia lu̱c A-mốt, A-mốt lu̱c Na-hum, Na-hum lu̱c Ếch-li, Ếch-li lu̱c Na-ghê, <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />Na-ghê lu̱c Ma-át, Ma-át lu̱c Ma-ta-thia, Ma-ta-thia lu̱c Sê-mê-in, Sê-mê-in lu̱c Giô-sếch, Giô-sếch lu̱c Giô-đa, <verse eid="LUK 3:26" /><verse number="27" style="v" sid="LUK 3:27" />Giô-đa lu̱c Giô-a-nan, Giô-a-nan lu̱c Rê-sa, Rê-sa lu̱c Xô-rô-ba-bên, Xô-rô-ba-bên lu̱c Sa-la-thi-ên, Sa-la-thi-ên lu̱c Nê-ri, <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />Nê-ri lu̱c Mên-chi, Mên-chi lu̱c A-đi, A-đi lu̱c Cô-sam, Cô-sam lu̱c Ên-ma-đan, Ên-ma-đan lu̱c Ê-rơ, <verse eid="LUK 3:28" /><verse number="29" style="v" sid="LUK 3:29" />Ê-rơ lu̱c Giô-suê, Giô-suê lu̱c Ê-li-ê-se, Ê-li-ê-se lu̱c Giô-rim, Giô-rim lu̱c Mát-thát, Mát-thát lu̱c Lê-vi, <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />Lê-vi lu̱c Si-mê-ôn, Si-mê-ôn lu̱c Giu-đa, Giu-đa lu̱c Giô-sép, Giô-sép lu̱c Giô-nam, Giô-nam lu̱c Ê-li-a-kim, <verse eid="LUK 3:30" /><verse number="31" style="v" sid="LUK 3:31" />Ê-li-a-kim lu̱c Mê-lê-a, Mê-lê-a lu̱c Men-na, Men-na lu̱c Mát-ta-tha, Mát-ta-tha lu̱c Na-than, Na-than lu̱c Đa-vít, <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />Đa-vít lu̱c Gie-sê, Gie-sê lu̱c Ô-bết, Ô-bết lu̱c Bô-ô, Bô-ô lu̱c Sanh-môn, Sanh-môn lu̱c Na-ách-son, <verse eid="LUK 3:32" /><verse number="33" style="v" sid="LUK 3:33" />Na-ách-son lu̱c A-mi-na-đáp, A-mi-na-đáp lu̱c Át-min, Át-min lu̱c A-rơ-ni, A-rơ-ni lu̱c Ếch-rôm, Ếch-rôm lu̱c Pha-rê, Pha-rê lu̱c Giu-đa, <verse eid="LUK 3:33" /><verse number="34" style="v" sid="LUK 3:34" />Giu-đa lu̱c Gia-cốp, Gia-cốp lu̱c Y-sác, Y-sác lu̱c Áp-ra-ham, Áp-ra-ham lu̱c Tha-rê, Tha-rê lu̱c Na-cô, <verse eid="LUK 3:34" /><verse number="35" style="v" sid="LUK 3:35" />Na-cô lu̱c Sê-rúc, Sê-rúc lu̱c Rê-hu, Rê-hu lu̱c Bê-léc, Bê-léc lu̱c Hê-be, Hê-be lu̱c Sa-la, <verse eid="LUK 3:35" /><verse number="36" style="v" sid="LUK 3:36" />Sa-la lu̱c Cai-nam, Cai-nam lu̱c A-pác-sát, A-pác-sát lu̱c Sem, Sem lu̱c Nô-ê, Nô-ê lu̱c Lê-méc, <verse eid="LUK 3:36" /><verse number="37" style="v" sid="LUK 3:37" />Lê-méc lu̱c Mê-tu-sê-la, Mê-tu-sê-la lu̱c Hê-nóc, Hê-nóc lu̱c Giê-rệt, Giê-rệt lu̱c Ma-ha-la-ên, Ma-ha-la-ên lu̱c Kê-nan, <verse eid="LUK 3:37" /><verse number="38" style="v" sid="LUK 3:38" />Kê-nan lu̱c Ê-nót, Ê-nót lu̱c Sết, Sết lu̱c A-đam, A-đam lu̱c Chảu Fạ.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />Chảu Giê-xu đảy tim Chảu Khoăn, tứ ta̱ Giô-đanh fan te̱o xáu đảy Chảu Khoăn tái khảu chang tu̱ng lẹng, <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />sle nhă̱n phi sla̱ láu slí slíp vằn. Chang kí vằn nỉnh, Min mí kin lăng mòn; thuủn kí vằn nỉnh dá do̱ Min chứng dác. <verse eid="LUK 4:2" /><verse number="3" style="v" sid="LUK 4:3" />Phi sla̱ chảng đủi Min: “Hạy ni̱ chăn chư̱ Lu̱c Chảu Fạ, do̱ cứ hít hử hin nảy pìn pẻng pay.” <verse eid="LUK 4:3" /><verse number="4" style="v" sid="LUK 4:4" />Chảu Giê-xu hòi vàm min: “Mì vàm slẻ cạ: ‘Tu cần te̱o đảy bó chư̱ tan pừng khảu pẻng xày đơ.’” <verse eid="LUK 4:4" /><verse number="5" style="v" sid="LUK 4:5" />Phi sla̱ tái Min khửn slung, hử Min hăn thuủn kí cuúc cha tìng ti̱ da̱ chang dắp nưng, <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />Dá phi sla̱ chảng đủi Min: “Cau co̱i hử ni̱ mọi quỳn xáu slu̱ng phjưức nảy, vi̱ quỳn xáu slu̱ng phjưức cú kí cuúc cha nỉnh tó đảy chao hử cau, cau ái hử cần nàư tó đảy. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />Pìn nỉnh, hạy ni̱ quỳ kháu tói nả ngo̱ do̱ mọi cần co̱i pay đủi ni̱.” <verse eid="LUK 4:7" /><verse number="8" style="v" sid="LUK 4:8" />Chảu Giê-xu hòi vàm: “Mì vàm slẻ: ‘Mưng lèo pái slớ Chảu, chư̱ Chảu Fạ cú mưng, lèo tan cung ta̱i Min xày.’” <verse eid="LUK 4:8" /><verse number="9" style="v" sid="LUK 4:9" />Dá, phi sla̱ xày tái Min thưng slẻng Giê-ru-sa-lem, sle Min tìng pài lưừn slớ dá cạ Min: “Hạy ni̱ chăn chư̱ Lu̱c Chảu Fạ, do̱ cứ pu̱ng làu lùng pay. <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />Vi̱ mì vàm slẻ, cạ:</para>
  <para style="q1" vid="LUK 4:10">‘Chảu co̱i oóc lịng hử kí cần tang nả Min ngòi nho̱m lu̱c,’<verse eid="LUK 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LUK 4:11" />dá cạ: ‘Kí lạo nỉnh co̱i tỏn lu̱c tìng mừ,</para>
  <para style="q1" vid="LUK 4:11">lao kha lu̱c te̱o toỏng khảu hin.’”<verse eid="LUK 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="LUK 4:12" />Chảu Giê-xu hòi vàm phi sla̱, cạ: “Mì vàm cạ: ‘Mưng mí đảy xi Chảu chư̱ Chảu Fạ mưng.’”<verse eid="LUK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13" />Lăng slì hít thuủn mọi lo̱ láu, phi sla̱ tả Min pay, tẳng chúng slì táng.<verse eid="LUK 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />Chảu Giê-xu fan te̱o búng Ga-li-lê chang quỳn slèng cú Chảu Khoăn, xáu mình Min đảy tàm oóc to̱i kí búng xảư xảng. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />Min slon cạ chang kí lưừn ho̱i cú phang cần, đảy mọi cần că̱n.<verse eid="LUK 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />Chảu Giê-xu pay thưng slẻng Na-xa-rét, ti̱ Min cải khửn, xị mọi pày, Min khảu lưừn ho̱i chang vằn Sa-bát, tấn dân sle to̱c cải. <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />Mì cần chao hử Min quỷn xéc Ê-sai, cần páo cón, Min khay oóc, xa hăn quỷn xéc mì ti̱ slẻ pìn nảy:<verse eid="LUK 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18" />“Chảu Khoăn cú Chảu dú tìng cau,</para>
  <para style="q1" vid="LUK 4:18">vi̱ Min tó ma̱t dù hử cau sle páo vàm đay hử cần khỏ.</para>
  <para style="q1" vid="LUK 4:18">Min tó xoi cau sle páo oóc hử kí cần ngài xăng đảy pjúi,</para>
  <para style="q1" vid="LUK 4:18">cần bót đảy slu̱ng ha,</para>
  <para style="q1" vid="LUK 4:18">cần ngài há pả đảy pjúi,<verse eid="LUK 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="LUK 4:19" />xáu páo oóc pi fúc đay cú Chảu.”<verse eid="LUK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />Min quỷn xéc khảu, păng hử cần cung ta̱i le̱, dá nă̱ng lùng. Mọi cần đưng lưừn ho̱i xày pắc pí nho̱m Min. <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />Dá, Min xo tàu cạ hau: “Vằn nảy vàm Chảu Fạ xu pi̱ noọng ngám ti̱ng đảy lình ính dá.” <verse eid="LUK 4:21" /><verse number="22" style="v" sid="LUK 4:22" />Mọi cần xày hít chửng đay mà Min, hau he mà kí vàm tim fúc đay oóc tứ pác Min, hau tham: “Bó chư̱ cần nảy lu̱c báo cú Giô-sép do̱ lừ?” <verse eid="LUK 4:22" /><verse number="23" style="v" sid="LUK 4:23" />Min cạ hau: “Cay pi̱ noọng ái chảng đủi ngo̱ pỉ xì nảy: ‘Slay nhả ới, cứ táng da đay làu pay. Kí lo̱ hung ngo̱ đảy ti̱ng tó mì oóc dú slẻng Ca-bê-na-um dá, do̱ ni̱ xày hít dú ti̱ chỏ nảy pay de̱.’” <verse eid="LUK 4:23" /><verse number="24" style="v" sid="LUK 4:24" />Min te̱o cạ: “Chăn, ngo̱ cạ pi̱ noọng, mí cần páo cón haư đảy tỏn tuụng dú ti̱ chỏ làu. <verse eid="LUK 4:24" /><verse number="25" style="v" sid="LUK 4:25" />Chăn, ngo̱ cạ pi̱ noọng, mì lai me̱ mải dú Y-sơ-ra-ên, chang tơ̱i Ê-li, chíu fạ ngài hắp mắn chang slam pi húc bưưn, to̱i ti̱ nỉnh ngài dác kin lai, <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />tọ, Ê-li mí đảy xoi thưng sle pang cho̱i cần nàư chang kí cần hau, tan me̱ mải nưng dú Sa-rép-ta, slẻng Si-đôn xày. <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" />Xày mì lai cần dú Y-sơ-ra-ên pìn hảu chang tơ̱i Ê-li-sê hít cần páo cón, tọ mí mì slắc cần chang hau đảy slaư, tan Na-a-man, cần Sy-ri đảy slaư xày.” <verse eid="LUK 4:27" /><verse number="28" style="v" sid="LUK 4:28" />Ti̱ng kí vàm nỉnh, mọi cần chang lưừn ho̱i fát slíng lai. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />Hau tấn dân, tái Min oóc noo̱c slẻng, kẻo Min khửn nhoo̱t phja, ti̱ hau xáy slẻng, sle vẻng Min lùng. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />Tọ Min phiín khói hau dá quá ti̱ đai.<verse eid="LUK 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />Min lùng slẻng Ca-bê-na-um slục búng Ga-li-lê dá slon cạ phang cần chang vằn sa-bát. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />Mọi cần xày he mà vàm Min slon cạ, vi̱ vàm Min hử hăn tim quỳn slèng. <verse eid="LUK 4:32" /><verse number="33" style="v" sid="LUK 4:33" />Chang lưừn ho̱i mì cần nưng ngài slẳm khoăn cú phi sla̱ dắp khảu, hài cải: <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />“Á, Giê-xu Na-xa-rét, hung ngo̱ xáu Chảu quén sla̱y lăng Chảu thưng sle chii̱t hung ngo̱ chư̱ mí? Ngo̱ chắc Chảu — chăn chư̱ Lạo Thánh cú Chảu Fạ!” <verse eid="LUK 4:34" /><verse number="35" style="v" sid="LUK 4:35" />Tọ Chảu Giê-xu quáy min, cạ: “Hắp pác khảu, xáu oóc khói cần nảy!” Phi sla̱ liìn khao lụp cần nỉnh lùng chang pan đung, dá phi sla̱ oóc khói tọ mí hít báo nỉnh chíp. <verse eid="LUK 4:35" /><verse number="36" style="v" sid="LUK 4:36" />Mọi cần xày he, chảng đủi căn, cạ: “Đạo lăng nảy, thưng slặn ké nảy au quỳn fép lăng oóc lịng hử kí slẳm khoăn hít boong min lèo oóc khói?” <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />Mình cú Min đảy tàm oóc to̱i kí ti̱ xảư xảng.<verse eid="LUK 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />Chảu Giê-xu tấn dân, pja̱c lưừn ho̱i, khảu lưừn Si-môn. Chíu nỉnh, me̱ da̱ cú Si-môn fát nắc; hau xo Chảu da pi̱ng hử da̱. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />Min thưng nghiíng đang khảu vè da̱, quáy xá fát, xá fát oóc khói da̱, dá da̱ chích slì tấn dân cung ta̱i mọi cần.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />Chíu ha vằn lặm, mọi cần au kí cần pìn đo kí thìng pi̱ng thưng xảư Min, Min chứng tặt mừ tìng cần pìn cần xáu da đay hử hau. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />Kí phi sla̱ xày oóc khói lai cần, dá hài cải cạ: “Min chăn chư̱ Lu̱c Chảu Fạ!” Min quáy, mí hử phi sla̱ chảng, vi̱ phi sla̱ chắc Min chăn chư̱ Chảu Cháu Ti̱ Da̱.<verse eid="LUK 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />Fạ ngám slu̱ng, Min pja̱c khói hau, pay khảu ti̱ quẹng, nhằng phang cần pay xa Min, phúng đảy dá, hau oóc slèng cỏ Min te̱o, mí hử pay khói hau. <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />Tọ Min cạ hau: “Ngo̱ lèo páo oóc vàm đay cú tum ti̱ Chảu Fạ hử lai slẻng táng num, vi̱ ngo̱ đảy xoi thưng sle páo oóc vàm đay.”<verse eid="LUK 4:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 4:44" />Dá Min lằm chặp páo cạ chang kí lưừn ho̱i dú búng Giu-đê.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />Pày táng nưng, phang cần ngă̱m nge̱ xảư Min sle ti̱ng vàm Chảu Fạ, chíu Min dân dú cằn thum Ghê-nê-xa-rết, <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />Min hăn sloong ăn lừ tom xảư cằn thum; nhằng kí cần tức pja tó oóc khói lừ, sle slặc khe dá. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />Min khửn ăn nưng chang sloong ăn lừ, ăn lừ nỉnh cú Si-môn, Min cạ ké chủng chảng oóc quay cằn íng nưng. Min nă̱ng tìng lừ slon cạ phang cần. <verse eid="LUK 5:3" /><verse number="4" style="v" sid="LUK 5:4" />Slì slon cạ dá, Min cạ Si-môn: “Cứ chủng chảng oóc noo̱c ti̱ nặm đắc, dá pjuúng khe lùng sle tức pja.” <verse eid="LUK 5:4" /><verse number="5" style="v" sid="LUK 5:5" />Si-môn hòi vàm: “Slay ới, hung lu̱c tó hít cung quá că̱m tọ mí cặp đảy lăng mòn, tọ ti̱ng vàm slay, ngo̱ co̱i pjuúng khe.” <verse eid="LUK 5:5" /><verse number="6" style="v" sid="LUK 5:6" />Hau pjuúng khe lùng, cặp đảy lai pja, nhằng ái khát tằng khe. <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />Hau oóc ha̱o dảo kí pàng dạu tức pja dú lừ táng thưng pang cho̱i, kí cần nỉnh thưng, kẻo pja khửn tim tằng sloong lừ, thưng slặn ái dăm lừ. <verse eid="LUK 5:7" /><verse number="8" style="v" sid="LUK 5:8" />Chíu hăn pìn nỉnh, Si-môn Phi-e-rơ qu̱y lùng tảư kha Chảu Giê-xu, dăng: “Pái Chảu, xo pja̱c khói ngo̱, vi̱ ngo̱ chăn chư̱ cần phít xá.” <verse eid="LUK 5:8" /><verse number="9" style="v" sid="LUK 5:9" />Vi̱ ké xáu thuủn kí cần dú nỉnh đủi ké xày he mà bát tức pja nỉnh, <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />Xày pìn nỉnh, tằng Gia-cơ xáu Giăng, chư̱ sloong lu̱c báo cú Xê-bê-đê, pàng dạu cú Si-môn. Chảu Giê-xu cạ Si-môn: “Dá xảy lao! Tứ nảy tò pay, ni̱ co̱i pìn cần tức khe cần.” <verse eid="LUK 5:10" /><verse number="11" style="v" sid="LUK 5:11" />Hau au lừ khảu cằn, dá tả mọi lo̱ sle pay nèm Min.<verse eid="LUK 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />Chíu Chảu Giê-xu dú đưng slẻng nỉnh, mì cần nưng pìn hảu tim đang. Hăn Chảu Giê-xu do̱ củm nả lùng na̱i xo, cạ: “Chảu ới, hạy Chảu ái, Chảu hít ngo̱ đảy slaư!” <verse eid="LUK 5:12" /><verse number="13" style="v" sid="LUK 5:13" />Chảu Giê-xu dặc mừ oóc tu̱ng khảu cần nỉnh, cạ: “Ngo̱ ái, cứ slaư pay!” Chích slì, pi̱ng hảu liìn oóc khói cần nỉnh. <verse eid="LUK 5:13" /><verse number="14" style="v" sid="LUK 5:14" />Dá Min slắng báo nỉnh mí đảy chảng đủi cần nàư, tọ lèo cạ: “Cứ pay phúng kí slay pài xoòng xáu pài cú cái vi̱ ni̱ đảy slaư, xị vàm Môi-se slon, sle hít chửng hử hau.” <verse eid="LUK 5:14" /><verse number="15" style="v" sid="LUK 5:15" />Mọi lo̱ Min hít vằn hẳm đảy tàm oóc lai; phang cần đung lai kẻo căn thưng sle ti̱ng xáu đảy Min da đay pi̱ng. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />Tọ Min phiín khảu ti̱ quẹng sle xỉnh chàu.<verse eid="LUK 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />Vằn nưng, chíu Chảu Giê-xu slon cạ, do̱ mì kí cần Pha-ri-si xáu kí slay slon luật nă̱ng dú nỉnh, hau tứ to̱i kí bản chang búng Ga-li-lê, Giu-đê xáu tứ slẻng Giê-ru-sa-lem thưng, quỳn slèng cú Chảu dú đủi Min sle da đay khảy chíp. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />Nho̱m cà, mì kỉ cần ham cần ti̱ po̱ ngài pại mu̱i nòn tìng slàng, hau xa lo̱ au cần nỉnh khảu đưng lưừn sle tặt tói nả Min. <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />Mí hít lừ ham cần pại mu̱i khảu đảy, vi̱ đung cần lai, hau chứng pay khửn pài lưừn, li̱t ngọa oóc, dá pjúi tằng cần xáu slàng lùng tu̱ng chang pan đung, tói nả Chảu Giê-xu. <verse eid="LUK 5:19" /><verse number="20" style="v" sid="LUK 5:20" />Chíu hăn slim slấn cú hau, Min cạ: “Ni̱ ới, phít xá cú ni̱ đảy sla dá!” <verse eid="LUK 5:20" /><verse number="21" style="v" sid="LUK 5:21" />Kí slay slon luật fáp xáu cần Pha-ri-si xo tàu slẳm slẻ cạ: “Cần nảy chư̱ cần nàư te̱o cảm chảng fa̱m pìn nỉnh? Tan Chảu Fạ mì quỳn sla xá, cần nàư mì quỳn hít pìn nỉnh?” <verse eid="LUK 5:21" /><verse number="22" style="v" sid="LUK 5:22" />Tọ Chảu Giê-xu chắc hau nẳm lăng, Min chứng chảng cạ: “Hít lừ kí cần ni̱ tiíp cò chang slim pìn nỉnh? <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />Hạy chảng: ‘Phít xá ni̱ đảy sla dá,’ do̱ va̱: ‘Cứ tấn dân dá phjải pay,’ do̱ chảng pìn lừ hẳm nga̱i quá? <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />Tọ sle kí cần ni̱ chắc cạ, Lu̱c Cú Cần mì quỳn sla xá.” Min te̱o cạ cần pại mu̱i: “Ngo̱ cạ ni̱: Cứ tấn dân, béc slàng fan mừ lưừn pay!” <verse eid="LUK 5:24" /><verse number="25" style="v" sid="LUK 5:25" />Chích slì cần pại mu̱i tấn dân tói nả hau, béc slàng túc cón nòn, pay mừ lưừn, tài slung Chảu Fạ. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />Mọi cần xày he, hau tài slung Chảu Fạ, slim lao dan chảng: “Vằn nảy hung làu đảy hăn kí lo̱ chăn pjòi.”<verse eid="LUK 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />Lăng nỉnh, Chảu Giê-xu pay khói nỉnh, nho̱m hăn cần slau slé mìng hít Lê-vi, nă̱ng dú ti̱ slau slé, do̱ Min cạ ké: “Pay nèm ngo̱!” <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />Lê-vi tấn dân, tả thuủn mọi lo̱ sle pay nèm Min.<verse eid="LUK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29" />Lê-vi khay sli̱c cải ta̱i Min dú lưừn làu; mì lai cần slau slé xáu kí cần táng nă̱ng xày xoòng đủi hau. <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" />Nhằng kí cần Pha-ri-si xáu kí slay slon luật hài ha̱c xáu cần nèm slon Min, cạ: “Hít lăng kí ké te̱o kin đủi fưừng slau slé xáu kí cần phít xá?” <verse eid="LUK 5:30" /><verse number="31" style="v" sid="LUK 5:31" />Chảu Giê-xu hòi vàm hau: “Cần slèng dạc mí cẩn slay nhả đơ, tọ cần khảy màu chứng cẩn. <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />Ngo̱ mí thưng sle dảo cần cung chính, tọ dảo cần phít xá cho̱i xá.”<verse eid="LUK 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />Tọ, hau chảng đủi Min: “Kí cần nèm slon cú Giăng slưừng slì căm kin xáu xỉnh chàu, kí cần nèm slon cú cần Pha-ri-si xày pìn nỉnh. Nhằng kí cần nèm slon ni̱ te̱o cứ kin!” <verse eid="LUK 5:33" /><verse number="34" style="v" sid="LUK 5:34" />Chảu Giê-xu hòi vàm hau: “Kí cần ni̱ pắt khéc thưng kin sli̱c căm kin chíu po̱ khưi nhằng dú đủi hau, đảy do̱ lừ? <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />Tọ thưng vằn po̱ khưi đảy au pay khói hau. Chang kí vằn nỉnh, hau chứng căm kin.” <verse eid="LUK 5:35" /><verse number="36" style="v" sid="LUK 5:36" />Min xày li̱n hử hau pỉ xì nưng: “Mí mì cần nàư xẻ kép slử máư te̱o phung khảu cùng slử cáu. Hạy hít pìn nỉnh, slử máư co̱i khát, xáu kép phải máư xày mí ngám đủi slử cáu. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />Xày mí cần nàư đíng lảu máư khảu pình năng cáu. Hạy pìn nỉnh, lảu máư hít phéc pình năng cáu, lảu lay oóc noọc, pình năng xày ngài va̱i. <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />Tọ, lèo đíng lảu máư khảu pình năng máư. <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />Xày mí cần nàư kin lảu cáu dá te̱o ái kin lảu máư, vi̱ cần nỉnh chảng cạ: ‘Lảu cáu hẳm van.’”<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />Chíu khảu vằn Sa-bát, Chảu Giê-xu pay khoang quá tu̱ng nà khảu me̱c va, kí cần nèm slon Min bít kỉ sluùng khảu, au mừ po dá kin. <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />Tọ mì kỉ cần Pha-ri-si chảng: “Hít lừ kí cần nảy hít lo̱ mí đảy hít chang vằn Sa-bát?” <verse eid="LUK 6:2" /><verse number="3" style="v" sid="LUK 6:3" />Chảu Giê-xu hòi vàm hau: “Kí ké xằng đảy slon mà kí lo̱ Đa-vít tó hít chíu huùng xáu kí cần dú đủi ngài dác kin do̱ lừ? <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />Huùng khảu đưng lưừn Chảu Fạ, au pẻng pài hử Chảu, kin xáu hử kí cần pay nèm kin num, ma̱i cạ pẻng nỉnh tan slay pài xoòng chứng đảy kin xày.” <verse eid="LUK 6:4" /><verse number="5" style="v" sid="LUK 6:5" />Dá Min cạ hau: “Lu̱c Cú Cần chăn chư̱ Chảu cú vằn Sa-bát.”<verse eid="LUK 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />Khảu vằn sa-bát táng nưng, Chảu Giê-xu khảu lưừn ho̱i slon cạ, dú nỉnh, mì cần nưng phả mừ sla ngài slau. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />Nhằng kí slay slon luật xáu cần Pha-ri-si ngòi chư̱ Min da pi̱ng chang vằn Sa-bát mí, sle hau xa lo̱ cáp xá Min. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />Tọ Min chắc hau nẳm lăng, chứng cạ cần ngài slau phả mừ: “Cứ tấn dân oóc chang mọi cần.” Cần nỉnh tấn, dá oóc dân chang nỉnh. <verse eid="LUK 6:8" /><verse number="9" style="v" sid="LUK 6:9" />Chảu Giê-xu cạ hau: “Ngo̱ tham kí cần ni̱, hạy chăn luật, khảu vằn sa-bát, đảy fép hít cung sla̱y đay do̱ va̱ hít lo̱ slại, cháu cần do̱ va̱ chii̱t pay?” <verse eid="LUK 6:9" /><verse number="10" style="v" sid="LUK 6:10" />Lăng slì nho̱m mọi cần to̱i nỉnh, Min cạ cần pi̱ng: “Ni̱ cứ dặc mừ oóc.” Cần nỉnh dặc mừ oóc do̱ mừ đảy đay. <verse eid="LUK 6:10" /><verse number="11" style="v" sid="LUK 6:11" />Tọ hau fát slíng, xùm xưừng đủi căn ngòi hít lăng đảy đủi Chảu Giê-xu mí.<verse eid="LUK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />Chang kí vằn nỉnh, Chảu Giê-xu pay khửn phja sle xỉnh chàu; Min tó slỉng quá khừn sle xỉnh chàu đủi Chảu Fạ. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />Thưng naư lăng, Min dảo kí cần nèm slon thưng, dá lưư̱c au slíp nhi̱ cần, dảo hít cần đảy xoi pay, mì: <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />Si-môn, cần đảy Min dảo hít Phi-e-rơ, noọng báo ké nỉnh dảo hít Anh-rê, Gia-cơ, Giăng, Phi-líp, Ba-thê-lê-my, <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />Ma-thi-ơ, Thô-ma, Giăng lu̱c cú A-phê, Si-môn nhằng dảo hít Xê-lốt, <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />Giu-đa, lu̱c cú Gia-cơ, xáu Giu-đa Ích-ca-ri-ốt chăn chư̱ cần mà lăng fản tảu <verse eid="LUK 6:16" /><verse number="17" style="v" sid="LUK 6:17" />Pay lùng đủi kí cần đảy xoi pay dá, Min dân dú ti̱ tum phiing, mì lai cần nèm slon Min xáu phang cần đung lai tứ to̱i búng Giu-đê, slẻng Giê-ru-sa-lem, xáu xảư hải Ty-rơ, Si-đôn <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />kẻo thưng sle ti̱ng Min slon cạ xáu đảy da đay pi̱ng. Kí cần ngài slẳm khoăn mủ xày đảy da đay. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />Tằng phang cần xày xa lo̱ tu̱ng khảu Min, vi̱ quỳn slèng tứ Min da đay hử thuủn mọi cần.<verse eid="LUK 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />Chảu Giê-xu slè ha nho̱m kí cần nèm slon xáu cạ: “Fúc hử kí pi̱ noọng, chư̱ kí cần slỉu khỏ, vi̱ tum ti̱ Chảu Fạ slục mà kí pi̱ noọng. <verse eid="LUK 6:20" /><verse number="21" style="v" sid="LUK 6:21" />Fúc hử kí pi̱ noọng cà nạy lèo dác, vi̱ co̱i đảy ím đo. Fúc hử kí pi̱ noọng cà nạy hảy hấm, vi̱ pi̱ noọng co̱i đảy khu fằng. <verse eid="LUK 6:21" /><verse number="22" style="v" sid="LUK 6:22" />Fúc hử kí pi̱ noọng vi̱ ngài hau xằng, ngài te̱p khói, ngài nả nhẻn, ngài tả mìng xị kí cần too̱c éc vi̱ Lu̱c Cú Cần. <verse eid="LUK 6:22" /><verse number="23" style="v" sid="LUK 6:23" />Chang kí vằn nỉnh, kí pi̱ noọng cứ hun hỉ dét fằng, vi̱ nho̱m cà, fă̱n slưởng cú kí pi̱ noọng dú tìng fạ chăn cải lai, vi̱ cúc chỏ xày tói ta̱i đủi kí cần páo cón pìn nỉnh. <verse eid="LUK 6:23" /><verse number="24" style="v" sid="LUK 6:24" />Tọ, slói hử kí cần ni̱, chư̱ kí cần fát xài, vi̱ pi̱ noọng tó đảy an chi dá! <verse eid="LUK 6:24" /><verse number="25" style="v" sid="LUK 6:25" />Slói hử pi̱ noọng, chư̱ kí cần cà nạy đảy ím, vi̱ pi̱ noọng co̱i dác. Slói hử pi̱ noọng cà nạy khu fằng, vi̱ pi̱ noọng co̱i chíp xàu xáu thán hảy. <verse eid="LUK 6:25" /><verse number="26" style="v" sid="LUK 6:26" />Slói hử pi̱ noọng, slì đảy mọi cần chảng đay, vi̱ cúc chỏ hau xày tói ta̱i pìn nỉnh xáu kí cần chá páo vàm Chảu!<verse eid="LUK 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />Tọ ngo̱ cạ kí pi̱ noọng cà nạy ti̱ng, lèo điíp cần tói tàu làu, hít đay hử cần xằng làu. <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />Lèo cung fúc hử cần bjắc bjỏi làu, lèo xỉnh chàu hử cần há pả làu. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />Cần nàư táp nả kí pi̱ noọng bưửng nảy, do̱ cứ dèn tằng nả bưửng nỉnh hử hau, nhằng cần nàư cưứp slử noo̱c cú pi̱ noọng, do̱ mí đảy cỏ slử đưng hử làu num. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />Cần nàư xo, pi̱ noọng cứ hử, cần nàư au cú cái cú kí pi̱ noọng, do̱ mí đảy to̱i te̱o. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" />Kí pi̱ noọng ái hau hít hử làu pìn lừ, do̱ cứ hít hử hau pìn nỉnh. <verse eid="LUK 6:31" /><verse number="32" style="v" sid="LUK 6:32" />Hạy kí pi̱ noọng điíp kí cần điíp làu, do̱ đảy fúc lăng haư Vi̱ tằng cần phít xá xày điíp kí cần điíp hau. <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />Hạy kí pi̱ noọng hít đay hử cần hít đay đủi làu, do̱ đảy fúc lăng? Vi̱ tằng cần phít xá xày hít pìn nỉnh. <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />Hạy pi̱ noọng hử hau dim te̱o mu̱ng hau păng te̱o, do̱ đảy fúc lăng? Tằng cần phít xá xày hử cần phít xá dim, sle đảy nhă̱n te̱o pìn nỉnh. <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" />Tọ kí pi̱ noọng lèo điíp cần tói tàu làu, lèo hít đay đủi hau, cứ hử dim tọ mí mu̱ng đảy păng te̱o, do̱ fă̱n slưởng cú kí pi̱ noọng co̱i cải lai, chăn chư̱ lu̱c cú Lạo Ta̱i Slung, vi̱ Min slim quảng tói ta̱i xáu cần lùm fúc xáu cần too̱c éc. <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />Lèo mì slim điíp sliít, xị Pá kí pi̱ noọng slưừng slì điíp sliít. <verse eid="LUK 6:36" /><verse number="37" style="v" sid="LUK 6:37" />Mí đảy ứn chá cần nàư, do̱ kí pi̱ noọng co̱i mí ngài ứn chá. Mí đảy phúc xá, do̱ kí pi̱ noọng co̱i mí ngài phúc xá. Lèo sla dưư̱ng hử hau, do̱ kí pi̱ noọng chứng đảy sla dưư̱ng. <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />Lèo pảo hử, do̱ kí pi̱ noọng co̱i đảy pảo hử: fă̱n đíng tim, — đé lùng, sláu thưng slặn tim fư̱t — hau co̱i đíng khảu pàu slử kí pi̱ noọng. Vi̱ kí pi̱ noọng to hử hau tùng haư, do̱ co̱i đảy hử te̱o tùng nỉnh.”<verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />Min xày cạ hau pỉ xì nưng: “Cần fàng tái cần fàng đảy mí? Bó chư̱ tằng sloong tò lụp lùng lù do̱ lừ? <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" />Cần nèm slon do̱ mí quá slay, tọ mọi cần nèm slon đảy slon đo, do̱ co̱i hút xị slay làu. <verse eid="LUK 6:40" /><verse number="41" style="v" sid="LUK 6:41" />Hít lừ pi̱ noọng nho̱m hăn tèo lịn đưng ha pi̱ noọng làu, te̱o mí hăn khỏ mạy chang ha làu? <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />Hít lăng pi̱ noọng cạ pi̱ noọng làu: ‘Ni̱ ới, sle ngo̱ au tèo lịn chang ha pi̱ noọng oóc,’ nhằng chăn pi̱ noọng te̱o mí hăn khỏ mạy chang ha làu? Cần pjàng mja̱p ới! Lèo au khỏ mạy oóc khói ha làu pay cón, dá chứng hăn khan sle au tèo lịn khói ha pi̱ noọng làu đảy. <verse eid="LUK 6:42" /><verse number="43" style="v" sid="LUK 6:43" />Mí mì co đay haư pìn mác too̱c; xày bó mì co too̱c haư oóc mác đay. <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" />Vi̱ ngòi mác do̱ chắc co. Hau mí bít mác ngo̱a ti̱ pá nam, xày mí bít mác ít ti̱ co slại. <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" />Cần đay tứ slim hom lo̱ đay sleng oóc lo̱ đay, nhằng cần xảu tứ slim hom lo̱ too̱c éc sleng oóc lo̱ too̱c éc. Vi̱ tim chang slim pác chứng chảng oóc.<verse eid="LUK 6:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />Hít lăng kí pi̱ noọng dảo ngo̱: ‘Chảu, Chảu!’ te̱o mí hít nèm vàm ngo̱ cạ? <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />Ngo̱ co̱i hử kí pi̱ noọng chắc cần nàư mà đủi ngo̱, ti̱ng vàm ngo̱ xáu hít nèm kí vàm nỉnh do̱ hút xị cần nàư. <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />Cần nỉnh hút xị cần nưng xáy lưừn, tào tum lùng đắc lai xáu tặt ti̱ choóc tìng khảng hin. Slì nặm noòng phu khửn, lày nặm lay cải slọ khảu lưừn nỉnh, tọ lưừn nỉnh mí tu̱ng fèn đảy, vi̱ lưừn tó đảy xáy mắn táng. <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />Tọ cần nàư ti̱ng vàm te̱o mí hít nèm, do̱ hút xị cần nưng xáy lưừn tìng tum mí tặt ti̱ choóc, slì lày nặm lay cải slọ khảu, lưừn nỉnh chứng túm lùng xáu va̱i nắc lai.”<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />Chảng mọi vàm nỉnh hử phang cần ti̱ng dá, do̱ Chảu Giê-xu khảu slẻng Ca-bê-na-um.<verse eid="LUK 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 7:2" />Chíu nỉnh, cần khỏi cú lạo căm tàu pan lỉnh, đảy ké ngòi pèng ngài pi̱ng nắc lai, ái hai. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />Slì đảy nghìn mà Chảu Giê-xu, ké xoi kỉ lạo ké Do Thái pay đủi Min, sle xo Min da pi̱ng hử cần khỏi cú làu. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />Hau pay phúng Chảu Giê-xu, na̱i xo Min cạ: “Ké nỉnh chăn ngám đảy slay pang cho̱i hử, <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />vi̱ ké điíp nòi cần hung làu, ké xáy tẳng lưừn ho̱i thánh hử hung làu.” <verse eid="LUK 7:5" /><verse number="6" style="v" sid="LUK 7:6" />Pìn nỉnh, Chảu Giê-xu pay đủi kí cần nèm slon. Tọ chíu Min xằng pay thưng xảư lưừn, do̱ cần căm tàu pan lỉnh mà dăng đủi Min cạ: “Pái Chảu, mí đảy táng hít khỏ pìn nỉnh, vi̱ ngo̱ mí ngám tỏn Chảu khảu lưừn. <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />Ngo̱ chứng nẳm làu mí ngám đảy mà nảy phúng Chảu. Tọ tan xo Chảu cạ vàm nưng, do̱ cần khỏi cú ngo̱ đảy đay lố. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />Vi̱ chăn ngo̱ xày dú tảư quỳn cần táng, ngo̱ xày mì pan lỉnh tảư quỳn làu, ngo̱ cạ cần nảy: ‘Pay pay’ do̱ min pay; dá cạ cần táng: ‘Mà nảy’ do̱ min thưng; xáu cạ cần khỏi cú ngo̱: ‘Lèo hít cung sla̱y nảy’ do̱ min hít.” <verse eid="LUK 7:8" /><verse number="9" style="v" sid="LUK 7:9" />Ti̱ng kí vàm nỉnh, Chảu Giê-xu hăn lạ mà cần căm tàu pan lỉnh, váy te̱o chảng xáu phang cần pay nèm: “Ngo̱ cạ pi̱ noọng, tằng nòi cần Y-sơ-ra-ên, ngo̱ xằng hăn cần nàư mì slim slấn cải pìn nỉnh.” <verse eid="LUK 7:9" /><verse number="10" style="v" sid="LUK 7:10" />Kí cần đảy xoi pay fan mừ lưừn, do̱ hăn cần khỏi slèng dá.<verse eid="LUK 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />Vằn lăng, Chảu Giê-xu pay khảu slẻng nưng dảo hít Na-in; mì kí cần nèm slon xáu phang cần đung lai pay đủi Min. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />Slì Min thưng xảư pác tu slẻng, hăn hau ngám ham cần hai oóc, chăn lu̱c báo đeo cú mé (da̱ pìn me̱ mải), mì lai cần dú slẻng nỉnh pay slúng phi đủi da̱. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />Chíu hăn da̱, Chảu điíp sliít chứng cạ: “Dá xảy hảy è.” <verse eid="LUK 7:13" /><verse number="14" style="v" sid="LUK 7:14" />Dá Min khảu xảư, tu̱ng mừ khảu mạy quan, do̱ kí cần ham dân dú. Min cạ: “Phủ báo ới, ngo̱ cạ ni̱, tấn dân pay.” <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />Cần hai chứng nă̱ng khửn, xo tàu chảng, dá Chảu Giê-xu chao báo nỉnh te̱o hử mé min. <verse eid="LUK 7:15" /><verse number="16" style="v" sid="LUK 7:16" />Mọi cần xày lao dan, hau tài slung Chảu Fạ, cạ: “Mì cần páo cón cải tó oóc nả chang hung làu,” xáu cạ: “Chảu Fạ tó dưưng cần cú Min.” <verse eid="LUK 7:16" /><verse number="17" style="v" sid="LUK 7:17" />Vàm mà Min đảy tàm oóc to̱i búng Giu-đê xáu kí ti̱ xảư xảng.<verse eid="LUK 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />Cần nèm slon cú Giăng li̱n te̱o hử ké thuủn mọi lo̱ nỉnh. Ké dảo sloong cần nèm slon, do̱ Giăng <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />cạ hau thưng dăng đủi Chảu Giê-xu: “Chăn slay chư̱ Lạo lèo thưng dá, do̱ va̱ hung ngo̱ nhằng lèo tẳng Lạo táng.” <verse eid="LUK 7:19" /><verse number="20" style="v" sid="LUK 7:20" />Hau thưng đủi Chảu Giê-xu, dăng cạ: “Giăng Báp-tít xoi hung ngo̱ mà tham slay: ‘Slay chăn chư̱ Lạo lèo thưng, do̱ va̱ hung ngo̱ nhằng lèo tẳng Lạo táng?’ ” <verse eid="LUK 7:20" /><verse number="21" style="v" sid="LUK 7:21" />Chăn chíu nỉnh, Chảu Giê-xu da đay lai cần khảy chíp, cần phú slưứng, cần ngài slẳm khoăn to̱ xáu hít hử lai cần fàng đảy nho̱m hăn. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />Dá Min hòi vàm hau: “Cứ mừ li̱n te̱o hử Giăng kí lo̱ hung ni̱ đảy hăn xáu ti̱ng: cần fàng đảy slu̱ng ha, cần què pay đảy, cần hảu đảy slaư, cần nuúc ti̱ng đảy, cần hai đảy hòi te̱o, cần khỏ đảy ti̱ng vàm đay, <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />xáu fúc hử cần nàư mí ngài toỏng lụp vi̱ ngo̱!”<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />Chíu kí cần tang nả Giăng pay dá, Chảu Giê-xu xo tàu chảng đủi phang cần mà Giăng: “Pi̱ noọng pay khảu tu̱ng lẹng sle nho̱m lăng? Co mạy ỏ ngài lầm fèn do̱ lừ? <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />Pi̱ noọng oóc nho̱m lăng num? Cần nưng nu̱ng slử khóa pèng do̱ lừ? nỉnh cà, kí cần nu̱ng slử khóa pèng xáu fí fái do̱ dú chang cung các huùng! <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />Tọ, pi̱ noọng nhằng pay nho̱m lăng num? Cần páo cón nưng do̱ lừ? Chăn, ngo̱ cạ pi̱ noọng, cần nỉnh nhằng quá tằng cần páo cón num. <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" />Mì vàm slẻ mà cần nỉnh cạ:</para>
  <para style="q1" vid="LUK 7:27">‘Ne̱, Cau xoi cần tang nả Cau pay tói nả Lu̱c,</para>
  <para style="q2" vid="LUK 7:27">min co̱i fọn lo̱ cú Lu̱c tói nả Lu̱c.’<verse eid="LUK 7:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="LUK 7:28" />Ngo̱ chảng hử pi̱ noọng chắc, chang kí cần đảy ti̱ me̱ sleng oóc, mí mì cần nàư slung pèng quá Giăng; tọ cần sláy ta̱i ít chang tum ti̱ Chảu Fạ nhằng slung pèng quá ké nỉnh.” <verse eid="LUK 7:28" /><verse number="29" style="v" sid="LUK 7:29" />(Ti̱ng pìn nỉnh dá, do̱ mọi cần, tằng kí cần slau slé xày nhă̱n Chảu Fạ chư̱ cung chính, dá nhă̱n báp-têm cú Giăng. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />Tọ cần Pha-ri-si xáu kí slay slon luật do̱ thoi ngài slim slưửng cú Chảu Fạ, mí nhă̱n Giăng hít báp-têm hử hau.) <verse eid="LUK 7:30" /><verse number="31" style="v" sid="LUK 7:31" />“Pìn nỉnh, ngo̱ co̱i pỉ kí cần cú xám cần nảy đủi ca lăng đảy? Hau hút xị cần nàư? <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />Hau hút xị tu đích nă̱ng dú noo̱c háng, dảo căn thưng, dá cạ: ‘Hung cau páu lầm tọ hung mưng mí dét mủ. Hung cau xưứng sli slưưng, hung mưng te̱o mí hảy thán.’ <verse eid="LUK 7:32" /><verse number="33" style="v" sid="LUK 7:33" />Vi̱ Giăng Báp-tít tó thưng, mí kin pẻng, xày bó kin lảu, do̱ kí ké cạ: ‘Ké nỉnh ngài phi sla̱ to̱.’ <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />Nhằng Lu̱c Cú Cần thưng, kin xáu nhẳm, do̱ pi̱ noọng te̱o cạ: ‘Nho̱m cà, chăn chư̱ cần thám kin thám nhẳm, pàng dạu cú cần slau slé xáu cần phít xá!’ <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />Tọ, slim quai kí đảy nho̱m hăn quá kí lu̱c cú chăn làu.”<verse eid="LUK 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />Chíu nỉnh, mì cần Pha-ri-si nưng xỉnh Chảu Giê-xu kin đủi làu. Min khảu lưừn cần Pha-ri-si nỉnh dá nă̱ng khảu xoòng kin. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />Dú slẻng nỉnh, mì cần ti̱ me̱ phít xá nưng. Chắc đảy Min nă̱ng kin dú lưừn cần Pha-ri-si, do̱ au mà pình pảo to tim dù hom, <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />da̱ chứng dân dú pạng lăng, hảy xảư ti̱ kha Chảu Giê-xu, nặm ha lút pưứt tằng kha Min, dá da̱ au phjâm tìng hu làu ma̱t, chúp kha dá ma̱t dù hom hử Min. <verse eid="LUK 7:38" /><verse number="39" style="v" sid="LUK 7:39" />Cần Pha-ri-si tó xỉnh Min kin, hăn pìn nỉnh, ké lặc nẳm: “Hạy ké nảy chăn chư̱ cần páo cón, do̱ cay tó chắc cần ti̱ me̱ tu̱ng khảu làu nỉnh chư̱ cần nàư, khảu thìng cần haư, vi̱ da̱ chăn chư̱ cần phít xá.” <verse eid="LUK 7:39" /><verse number="40" style="v" sid="LUK 7:40" />Chảu Giê-xu cạ ké: “Si-môn ới, ngo̱ mì kỉ vàm chảng đủi ni̱.” Ké dăng: “Xo slay cứ chảng.” <verse eid="LUK 7:40" /><verse number="41" style="v" sid="LUK 7:41" />“Cần chảu nỉ hử sloong cần dim chèn. Cần nưng dim hả pác đơ-ni-ê, nhằng cần nỉnh dim hả xục. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />Vi̱ sloong cần xày mí mì lăng sle păng, chảu nỉ chứng sla hử tằng sloong. Pìn nỉnh, cần nàư chang sloong cần nỉnh hẳm điíp chảu nỉ quá?” <verse eid="LUK 7:42" /><verse number="43" style="v" sid="LUK 7:43" />Si-môn dăng cạ: “Ngo̱ nẳm, cần chảu nỉ tó sla hử hẳm lai nỉ.” Chảu Giê-xu cạ: “Ni̱ nẳm chăn chư̱ lai.” <verse eid="LUK 7:43" /><verse number="44" style="v" sid="LUK 7:44" />Min váy te̱o vè cần ti̱ me̱ xáu cạ Si-môn: “Ni̱ hăn cần ti̱ me̱ nảy mí? Ngo̱ khảu đưng lưừn ni̱. Ni̱ mí hử ngo̱ nặm slào kha, nhằng da̱ nỉnh tó au nặm ha ma̱t pưứt kha ngo̱, dá au phjâm làu ma̱t. <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />Ni̱ mí chúp ngo̱ slắc bát, nhằng da̱ nỉnh, tứ slì ngo̱ khảu lưừn ni̱, tó chúp kha ngo̱ mại. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />Ni̱ bó ma̱t dù khửn hu ngo̱, nhằng da̱ nỉnh au dù hom ma̱t kha ngo̱. <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />Pìn nỉnh, ngo̱ chứng cạ ni̱, phít xá cú cần ti̱ me̱ nảy lai lai, tọ tó đảy sla dưư̱ng dá, da̱ nỉnh chứng điíp lai. Nhằng cần nàư đảy sla nọi, do̱ điíp nọi.” <verse eid="LUK 7:47" /><verse number="48" style="v" sid="LUK 7:48" />Dá Min cạ cần ti̱ me̱ nỉnh: “Ni̱ đảy sla phít xá dá.” <verse eid="LUK 7:48" /><verse number="49" style="v" sid="LUK 7:49" />Kí cần nă̱ng xày xoòng xáu Min chảng đủi căn: “Cần nảy chư̱ cần nàư te̱o mì quỳn sla phít xá?” <verse eid="LUK 7:49" /><verse number="50" style="v" sid="LUK 7:50" />Tọ Min cạ cần ti̱ me̱: “Slim slấn cú ni̱ cháu ni̱ dá. Cứ pay pình an.”<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />Lăng nỉnh, Chảu Giê-xu khửn lo̱ pay tứ slẻng nảy, bản táng, slon cạ xáu páo oóc vàm đay mà tum ti̱ Chảu Fạ, mì slíp nhi̱ cần đảy xoi pay đủi Min, <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />xày mì kỉ cần ti̱ me̱, chư̱ kí cần đảy da đay khói slẳm khoăn xáu khảy chíp: Ma-ri, nhằng dảo hít Ma-đơ-len, chư̱ cần đảy Chảu cháu khói chất phi sla̱ xan; <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />Gian-nơ, me̱ Chu-xa, cần cuủn cha xài cú huùng Hê-rốt; Xu-xa-nơ; xáu lai cần ti̱ me̱ táng num; hau tó au cú cái làu mì sle cung ta̱i Chảu xáu kí cần nèm slon.<verse eid="LUK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />Slì phang cần đung kẻo tứ kí slẻng mà đủi Chảu Giê-xu, do̱ Min au pỉ xì slon cạ hau: <verse eid="LUK 8:4" /><verse number="5" style="v" sid="LUK 8:5" />“Mì cần nưng oóc pay ván fằn, chíu min ván fằn, kỉ múi lút to̱i lo̱, ngài ta̱p tảư kha, dá nục fạ kin thuủn múi. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />Kỉ múi táng lút tìng hin, chíu ngám buút khửn, chứng liìn pọi pay, vi̱ slỉu dáu; <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />Kỉ múi táng num lút khảu chang pá nam, xày buút khửn, dá ngài nam hít hử cặp kẹp. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />Te̱o mì kỉ múi táng num lút khảu ti̱ tum đay, buút khửn, pìn mác lai quá pác pày.” Chíu cạ kí vàm nỉnh dá, Min chảng cải: “Cần nàư mì xu sle ti̱ng, lèo ti̱ng.”<verse eid="LUK 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />Dá kí cần nèm slon tham Min: “Pỉ xì nỉnh pìn lừ?” <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />Min hòi vàm: “Pi̱ noọng đảy pảo hử thung slụ mà kí dăm dò cú tum ti̱ Chảu Fạ; nhằng cần táng do̱ au pỉ xì, sle hau nho̱m te̱o mí hăn, ti̱ng te̱o mí slụ <verse eid="LUK 8:10" /><verse number="11" style="v" sid="LUK 8:11" />Pỉ xì nỉnh mì ý xí pìn nảy: Múi fằn xị vàm Chảu Fạ. <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />Kí múi lút to̱i lo̱ xị kí cần tó đảy ti̱ng vàm đay, tọ mư̱ lăng, phi sla̱ mà cưứp au vàm nỉnh khói slim hau, sle hau mí slấn, khói đảy cháu. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />Nhằng kí múi lút tìng hin xị kí cần ti̱ng vàm slon, do̱ hun hỉ tỏn au đạo. Tọ hau mí mì la̱c, hau tan slấn dắp nưng, thưng slì phúng xi cha̱m do̱ hau chứng tả pay. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />Nhằng kí múi lút khảu chang pá nam xị kí cần tó đảy ti̱ng vàm đay, tọ sle kí dau hí, fát xài, pjuúng pjúi cú tơ̱i nảy hít hử cặp kẹp, hau chứng mí cải khửn đảy. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />Tọ kí múi fằn lút tìng tum đay, xị kí cần hít nèm chăn slim, chăn xình, ti̱ng vàm đay dá cỏ au, slim tảy nẳm chứng đảy pìn mác.<verse eid="LUK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />Mí cần nàư tẻm tưng dá, te̱o au thủng tằn te̱o, do̱ va̱ tặt tảư slàng. Tọ lèo tặt tìng kha tưng, sle kí cần khảu lưừn chứng hăn áng slu̱ng đảy. <verse eid="LUK 8:16" /><verse number="17" style="v" sid="LUK 8:17" />Vi̱ mí mì lo̱ lăng đảy dăm dò te̱o mí ngài dẻng oóc, xày mí mì lo̱ lăng lặc lu̱m hít te̱o mí ngài hau chắc thưng dá au oóc áng slu̱ng. <verse eid="LUK 8:17" /><verse number="18" style="v" sid="LUK 8:18" />Pìn nỉnh, lèo slỉu slim mà kí lo̱ pi̱ noọng ti̱ng, vi̱ cần nàư mì dá co̱i đảy hử num, nhằng cần nàư mí mì, ma̱i cạ nẳm làu mì xày ngài au pay khói cần nỉnh.”<verse eid="LUK 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />Mé xáu kí noọng cú Chảu Giê-xu mà xa Min, tọ vi̱ đung cần chứng mí khảu xảư Min đảy. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />Mì cần páo hử Min chắc: “Mé xáu kí noọng slay dân dú bưửng noo̱c, ái phúng slay.” <verse eid="LUK 8:20" /><verse number="21" style="v" sid="LUK 8:21" />Tọ Min hòi vàm hau: “Nảy chăn chư̱ mé ngo̱ xáu pi̱ noọng ngo̱, chư̱ kí cần ti̱ng xáu hít nèm vàm Chảu Fạ.”<verse eid="LUK 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />Vằn nưng, Chảu Giê-xu đủi kí cần nèm slon lùng lừ, dá Min cạ hau: “Hung làu lèo quá cằn bưửng nỉnh thum.” Dá hau chủng lừ pay. <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />Chang slì hau chủng lừ pay, do̱ Min nòn. Mì xá lầm cải nưng pa̱o khửn tìng hải thum, nặm khảu tim lừ, dá hau phúng dii̱m. <verse eid="LUK 8:23" /><verse number="24" style="v" sid="LUK 8:24" />Kí cần nèm slon thưng xảư pjúc Min tấn, cạ: “Slay ới, Slay ới! Hung làu ái hai dá lố!” Min tấn dân, quáy lầm xáu fư̱t nặm, do̱ boong min liìn đử dú dá mọi lo̱ ti̱ng xích. <verse eid="LUK 8:24" /><verse number="25" style="v" sid="LUK 8:25" />Min cạ kí cần nèm slon: “Slim slấn kí pi̱ noọng dú càư?” Cần nèm slon lao dan xáu he chứng tham căn: “Slay chư̱ cần nàư te̱o oóc lịng tằng lầm xáu nặm xày lèo ti̱ng vàm slay?”<verse eid="LUK 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />Min xáu kí cần nèm slon khửn lừ thưng búng Giê-ra-sê, ti̱ tói nả búng Ga-li-lê. <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />Chíu Chảu Giê-xu khửn cằn, mì cần dú slẻng nỉnh mà phúng Min, cần nảy ngài phi sla̱ to̱. Tứ hưng dá, báo nỉnh mí nu̱ng slử khóa, mí dú lưừn, tọ dú noo̱c ti̱ fằn. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />Slì hăn Chảu Giê-xu, báo nỉnh chứng hài khửn, qu̱y kháu lùng tói nả Min chảng cải: “Giê-xu ới, Lu̱c Chảu Fạ Ta̱i Slung, ngo̱ quén sla̱y lăng thưng Chảu haư? Ngo̱ xo Chảu mí đảy hít khỏ ngo̱.” <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />Vi̱ Chảu Giê-xu tó oóc lịng slẳm khoăn lèo oóc khói báo nỉnh. Tó lai pày phi sla̱ to̱ khảu min; hau phúc, cu̱m xáu ngài pạư dá, min nhằng ẻo chưư̱c, kẻ cu̱m, ngài phi sla̱ la̱c khảu ti̱ tu̱ng lẹng đảy. <verse eid="LUK 8:29" /><verse number="30" style="v" sid="LUK 8:30" />Chảu Giê-xu tham: “Mưng mìng lăng?” Phi sla̱ hòi vàm: “Lai xiin lỉng” vi̱ lai phi sla̱ lai tó to̱ khảu báo nỉnh. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />Kí phi sla̱ na̱i xo Min, dá te̱p boong min lùng vằng đắc. <verse eid="LUK 8:31" /><verse number="32" style="v" sid="LUK 8:32" />Chíu nỉnh, mì xá mu nưng đung lai kin dú tìng phja, kí phi sla̱ chứng xo Chảu Giê-xu hử boong min dắp khảu xá mu nỉnh. Chảu chứng hử fép. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />Kí phi sla̱ chứng oóc khói cần nỉnh xáu dắp khảu xá mu. Dá xá mu tứ pàn lính pu̱ng lùng thum, ngài hai dăm thuủn. <verse eid="LUK 8:33" /><verse number="34" style="v" sid="LUK 8:34" />Kí cần hen mu hăn pìn nỉnh, do̱ le̱n ni xáu li̱n te̱o mọi lo̱ nỉnh to̱i kí slẻng, kí bản. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />Phang cần pu̱ng thưng nho̱m mọi lo̱ ngám mì oóc, hau thưng xảư Chảu Giê-xu, hăn cần ngám đảy te̱p kí phi sla̱ oóc khói, nă̱ng dú tảư kha Chảu Giê-xu, nu̱ng slử khóa, slim ki slỉng sla̱c, do̱ hau lao dan lai. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />Kí cần đảy hăn li̱n te̱o hử mọi cần ti̱ng mà cần ngài phi sla̱ to̱ đảy da đay pìn lừ. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />Tằng phang cần to̱i búng Giê-ra-sê xo Chảu Giê-xu oóc khói ti̱ hau, vi̱ hau lao dan lai. Pìn nỉnh, Min chứng lùng lừ fan mừ. <verse eid="LUK 8:37" /><verse number="38" style="v" sid="LUK 8:38" />Cần đảy Chảu Giê-xu te̱p phi sla̱ oóc khói chứng xo pay đủi Min, tọ Min cạ báo nỉnh mừ, slắng cạ: <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />“Ni̱ cứ mừ lưừn, li̱n te̱o mọi lo̱ Chảu Fạ tó hít hử ni̱.” Dá min chứng pay, páo oóc to̱i slẻng mà mọi lo̱ Chảu Giê-xu tó hít hử làu.<verse eid="LUK 8:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />Chíu Chảu Giê-xu fan te̱o, do̱ pan đung tỏn chiíp Min, vi̱ mọi cần xày mu̱ng tẳng Min. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />Mì cần nưng mìng hít Giai-ru, cuủn lị lưừn ho̱i mà pái lùng tảư kha Chảu Giê-xu xáu na̱i xo Min khảu lưừn làu, <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />vi̱ ké tan mì lu̱c slao đeo slíp nhi̱ pi, tu đích te̱o ái hai. Slì Chảu Giê-xu pay lo̱, do̱ phang cần ngă̱m nge̱ Min tứ slí chái.<verse eid="LUK 8:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 8:43" />Mì cần ti̱ me̱ nưng ngài lưư̱t lài lùng lai đảy slíp nhi̱ pi dá; ma̱i cạ túc lai chèn cú hử lai slay nhả, tọ mí cần nàư da đay đảy hử da̱. <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />Da̱ thưng pạng lăng dá tu̱ng khảu tin slử Min, do̱ chích slì lưư̱t lài căm te̱o. <verse eid="LUK 8:44" /><verse number="45" style="v" sid="LUK 8:45" />Chảu Giê-xu cạ: “Cần nàư ngám tu̱ng khảu ngo̱?” Mí cần nàư nhă̱n chạy, Phi-e-rơ chứng chảng: “Slay ới, pan đung kẻo mà ngă̱m nge̱ to̱i slay nảy cà!” <verse eid="LUK 8:45" /><verse number="46" style="v" sid="LUK 8:46" />Chảu Giê-xu cạ: “Mì cần nàư tu̱ng khảu ngo̱, vi̱ ngo̱ chắc mì quỳn slèng nưng tứ ngo̱ oóc.” <verse eid="LUK 8:46" /><verse number="47" style="v" sid="LUK 8:47" />Chíu cần ti̱ me̱ hăn làu mí dăm đảy dá, chứng slằn lao mà pái lùng tói nả Min, chảng chăn hử mọi cần chắc hít lừ da̱ chứng tu̱ng khảu Min xáu đảy da đay pìn lừ. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />Chảu Giê-xu cạ da̱: “Lu̱c slao ới, slim slấn cú lu̱c da đay hử lu̱c dá. Cứ pay pình an.”<verse eid="LUK 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />Chang slì Min nhằng chảng, do̱ mì cần tứ lưừn cần cuủn lị lưừn ho̱i mà páo cạ: “Lu̱c slao ké hai dá. Mí đảy cảo na̱o slay num.” <verse eid="LUK 8:49" /><verse number="50" style="v" sid="LUK 8:50" />Tọ Chảu Giê-xu ti̱ng đảy chứng cạ Giai-ru: “Dá xảy lao, tan lèo slấn, do̱ tu đích co̱i đảy cháu.” <verse eid="LUK 8:50" /><verse number="51" style="v" sid="LUK 8:51" />Khảu thưng lưừn, Chảu Giê-xu mí hử cần nàư khảu đủi Min, tan Phi-e-rơ, Giăng, Gia-cơ, xáu pá mé tu đích. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />Mọi cần nhằng thán hảy túp ức mà tu đích; tọ Chảu Giê-xu cạ: “Dá xảy hảy, tu đích xằng hai đơ, tọ nòn xày.” <verse eid="LUK 8:52" /><verse number="53" style="v" sid="LUK 8:53" />Hau chứng khu slủm Min vi̱ chắc tu đích tó hai dá. <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />Chảu Giê-xu căm mừ tu đích, Min dảo cải: “Đích ới, tấn pay.” <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />Khoăn mi̱ng te̱o mà, tu đích liìn tấn khửn, dá Chảu Giê-xu cạ hau hử tu đích kin. <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />Pá mé tu đích he lai, tọ Chảu Giê-xu oóc lịng hử hau mí đảy chảng đủi slắc cần mà mọi lo̱ tó mì oóc.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />Chảu Giê-xu dảo slíp nhi̱ cần đảy xoi pay ho̱p te̱o, pảo quỳn, slèng cải quá kí phi sla̱ sle da pi̱ng, <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />dá Min xoi hau pay páo cạ mà tum ti̱ Chảu Fạ, xáu da đay cần pi̱ng. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />Min cạ hau: “Slì pay lo̱ mí đảy au ca lăng mòn pay nèm, mí đảy au tèo tạu, ta̱y ngàm, pẻng, ngừn chèn; xày mí đảy au sloong cùng slử. <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />Pi̱ noọng khảu lưừn haư, cứ dú nỉnh thưng slì pay. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" />Ti̱ haư hau mí chiíp kí pi̱ noọng, do̱ chíu oóc khói slẻng nỉnh, cứ phu mư̱n khói kha, xị vàm chửng tỉng te̱o hau.” <verse eid="LUK 9:5" /><verse number="6" style="v" sid="LUK 9:6" />Pìn nỉnh, kí cần đảy xoi pay khửn lo̱, quá kí bản co̱n, páo oóc vàm đay xáu da đay khảy chíp to̱i ti̱.<verse eid="LUK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />Chíu nỉnh, Hê-rốt hít huùng khen kha ti̱ng nghìn mà mọi lo̱ mì oóc do̱ slim luu̱n lai, vi̱ mì kỉ cần chảng cạ Giăng tứ ti̱ hai hòi te̱o dá, <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />tọ mì kỉ cần te̱o cạ: “Ê-li oóc nả”, nhằng kỉ cần táng num do̱ cạ cần nưng chang kí cần páo cón mư̱ pày hòi te̱o dá. <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />Hê-rốt chảng: “Ngo̱ tó ke̱t bảu Giăng dá, ni̱ chư̱ cần nàư te̱o hít kí lo̱ pìn nỉnh?” Huùng chứng xa lo̱ phúng Chảu Giê-xu.<verse eid="LUK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />Kí cần đảy xoi pay fan mừ, chảng te̱o hử Chảu Giê-xu mọi lo̱ hau tó hít. Dá Min tái hau phiín pay, thưng slẻng nưng dảo hít Bết-sai-đa. <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />Chíu phang đung nhă̱n oóc, do̱ hau pay nèm Min. Chảu Giê-xu tỏn hau, slon hử hau mà tum ti̱ Chảu Fạ, da đay hử kí cần cẩn đảy da đay. <verse eid="LUK 9:11" /><verse number="12" style="v" sid="LUK 9:12" />Chíu fạ ái đăm, slíp nhi̱ cần đảy xoi pay mà, dăng Chảu: “Xo slay hử phang cần pay mừ, sle hau thưng kí bản co̱n to̱i nảy thắp ti̱ to̱ xáu xa cú kin, vi̱ ti̱ hung làu dú nảy quẹng xích.” <verse eid="LUK 9:12" /><verse number="13" style="v" sid="LUK 9:13" />Min cạ: “Chăn kí pi̱ noọng lèo hử hau kin.” Tọ, kí cần đảy xoi pay dăng: “Hung ngo̱ tan mì hả ăn pẻng xáu sloong tu pja xày, hạy mí pay slự cú kin hử tằng phang cần nảy né.” <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />(Vi̱ mì thưng slắc hả xiin cần ti̱ po̱.) Min chứng cạ kí cần nèm slon: “Cứ cạ hau nă̱ng pìn phang, mọi phang slắc hả slíp cần.” <verse eid="LUK 9:14" /><verse number="15" style="v" sid="LUK 9:15" />Kí cần nèm slon hít nèm dá cạ mọi cần nă̱ng lùng kin. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />Chảu Giê-xu au hả ăn pẻng xáu sloong tu pja, slè ha khửn fạ, sleng slu̱ xáu ẻo pẻng oóc, chao hử kí cần nèm slon sle păn hử pan đung. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />Mọi cần xày kin, múc ím pứng, hau hom te̱o đảy slíp nhi̱ xoỏng tim kí tỏn pẻng lứ.<verse eid="LUK 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />Chíu Chảu Giê-xu xỉnh chàu cần đeo, kí cần nèm slon ho̱p to̱i Min, Min chứng tham hau: “Phang cần cạ ngo̱ chư̱ cần nàư?” <verse eid="LUK 9:18" /><verse number="19" style="v" sid="LUK 9:19" />Hau dăng: “Cần nảy do̱ chảng Giăng Báp-tít, nhằng cần táng te̱o cạ Ê-li; cần táng num te̱o cạ slay chư̱ cần nưng chang kí cần páo cón mư̱ pày hòi te̱o.” <verse eid="LUK 9:19" /><verse number="20" style="v" sid="LUK 9:20" />Min te̱o tham hau: “Nhằng kí pi̱ noọng do̱ cạ ngo̱ chư̱ cần nàư?” Chíu nỉnh, Phi-e-rơ dăng: “Slay chăn chư̱ Lạo Cháu Ti̱ Da̱, Lu̱c cú Chảu Fạ.” <verse eid="LUK 9:20" /><verse number="21" style="v" sid="LUK 9:21" />Chảu Giê-xu oóc lịng hử kí cần nèm slon mí đảy chảng lo̱ nảy xáu slắc cần, <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />dá Min te̱o cạ: “Lu̱c Cú Cần lèo tảy lai chíp khỏ, ngài kí lạo ké, kí slay pài xoòng tàu xáu kí slay slon luật fáp thoi ngài, ngài khả, thưng vằn ta̱i slam co̱i hòi te̱o.” <verse eid="LUK 9:22" /><verse number="23" style="v" sid="LUK 9:23" />Min cạ mọi cần: “Hạy cần nàư ái pay nèm ngo̱, lèo tả chăn làu, mọi vằn béc mạy các khoáy pay nèm ngo̱. <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" />Vi̱ hạy cần nàư ái cháu mi̱ng làu, do̱ co̱i túc, nhằng cần nàư vi̱ ngo̱ te̱o túc mi̱ng làu do̱ co̱i đảy cháu mi̱ng làu. <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />Hạy cần nàư đảy tằng ti̱ da̱ te̱o táng hít va̱i chăn làu pay, do̱ mì lăng đay? <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />Vi̱ hạy cần nàư nả nhẻn mà ngo̱ xáu vàm ngo̱, do̱ Lu̱c Cú Cần xày nả nhẻn mà cần nỉnh, slì Min thưng chang slu̱ng phjưức cú làu, cú Pá xáu kí cần tang nả thánh. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />Chăn, ngo̱ cạ kí pi̱ noọng, mì kỉ cần dân dú nảy co̱i mí lèo hai, thưng slì đảy hăn tum ti̱ Chảu Fạ.”<verse eid="LUK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />Cạ kí vàm nảy dá, slắc pét vằn lăng, Chảu Giê-xu tái Phi-e-rơ, Giăng xáu Gia-cơ pay khửn phja sle xỉnh chàu. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />Chíu xỉnh chàu, slưứng nả Min piín táng, slử khóa pìn khao slác, slu̱ng slực. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />nỉnh cà, mì sloong cần chảng cỏ đủi Min, nỉnh chăn chư̱ Môi-se xáu Ê-li, <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />hau oóc nả chang slu̱ng phjưức, chảng cạ Min co̱i nhă̱n hai ái đảy ính xình dú slẻng Giê-ru-sa-lem. <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />Phi-e-rơ xáu kí pàng dạu màu nòn lai, tọ chíu slỉng dá, hau hăn Chảu Giê-xu slu̱ng phjưức xáu sloong cần dân xảư Min. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />Chíu sloong cần nỉnh pja̱c khói Chảu Giê-xu, Phi-e-rơ dăng xáu Min cạ: “Slay ới, hung làu dú nảy đay lai, xo hử hung ngo̱ tẳng slam ăn le̱o, ăn nưng hử slay, ăn nưng hử Môi-se xáu ăn nưng hử Ê-li.” (Ké chảng tọ bó chắc làu chảng lăng). <verse eid="LUK 9:33" /><verse number="34" style="v" sid="LUK 9:34" />Phi-e-rơ nhằng chảng, do̱ mì xá phử nưng kẻo mà dà pao hau; chíu hăn làu khảu chang xá phử kí cần nèm slon lao dan. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" />Dá tứ chang xá phử mì heng chảng cạ: “Nảy chăn chư̱ Lu̱c Cau, Min tó đảy lưư̱c. Hèo ti̱ng vàm Min.” <verse eid="LUK 9:35" /><verse number="36" style="v" sid="LUK 9:36" />Chíu heng nỉnh ngám thuủn, do̱ tan nhằng cần đeo Chảu Giê-xu xày. Kí cần nèm slon xày đỉ dú, mí chảng hử cần nàư chắc mà kí lo̱ làu tó đảy hăn chang kí vằn nỉnh.<verse eid="LUK 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />Vằn lăng, chíu Chảu xáu cần nèm slon tứ phja lùng, mì phang cần đung thưng phúng Min. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />Nho̱m cà, mì cần nưng tứ pan đung moòng khửn cạ: “Slay ới, xo slay điíp lu̱c báo ngo̱ đủi, vi̱ ngo̱ tan mì ò đeo xày. <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />Nho̱m cà, phi sla̱ to̱ khảu, lan min chứng moòng cải, dá khao min lụp lùng thưng slặn nài oóc pác, mí oóc khói, cứ hít đúc đang min cắm chíp. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />Ngo̱ tó xo kí cần nèm slon slay te̱p phi sla̱ oóc, tọ hau te̱p mí đảy.” <verse eid="LUK 9:40" /><verse number="41" style="v" sid="LUK 9:41" />Chảu Giê-xu hòi vàm: “Xám cần mí mì slim slấn xáu luu̱n slại nỉnh ới, ngo̱ co̱i dú xáu pi̱ noọng, tảy nẳm pi̱ noọng thưng mư̱ haư? Cứ tái lu̱c báo ni̱ mà nảy!” <verse eid="LUK 9:41" /><verse number="42" style="v" sid="LUK 9:42" />Chíu ò đích ngám thưng, phi sla̱ khao min lùng tum, sláu min slèng lai. Tọ Chảu Giê-xu quáy slẳm khoăn xáu da đay ò đích nỉnh, dá au ò đích hử pá min. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />Dá mọi cần xày he mà quỳn slèng cú Chảu Fạ. Tọ chíu mọi cần nhằng he mà mọi lo̱ Chảu Giê-xu tó hít, do̱ Min cạ kí cần nèm slon: <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" />“Xu pi̱ noọng lèo ti̱ng hử đay kí vàm nảy: Lu̱c Cú Cần ái ngài no̱p khảu mừ hau dá.” <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />Tọ, kí cần nèm slon mí slụ vàm nỉnh, vi̱ vàm nỉnh nhằng ngài dà pay, hau chứng mí slụ đảy, tọ hau lao, mí cảm tham Min mà kí vàm nỉnh.<verse eid="LUK 9:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />Dá kí cần nèm slon tói pác đủi căn, ngòi cần nàư chăn chư̱ cần hẳm cải. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />Tọ Chảu Giê-xu chắc slim hau nẳm lăng, chứng au tu đích nỉnh dân xảư làu, <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />dá cạ hau: “Hạy cần nàư au mình ngo̱ te̱o chiíp tu đích nảy chư̱ chiíp ngo̱, nhằng cần nàư chiíp ngo̱ do̱ xị chiíp Lạo tó xoi ngo̱. Vi̱ cần nàư sláy ta̱i ít chang thuủn kí pi̱ noọng, chăn chư̱ cần slung pèng ta̱i ít.”<verse eid="LUK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />Giăng chảng cạ: “Slay ới, hung ngo̱ tó hăn mì cần au mình slay sle te̱p phi sla̱, hung ngo̱ chứng mí hử cần nỉnh te̱p, vi̱ cần nỉnh mí pay nèm hung làu.” <verse eid="LUK 9:49" /><verse number="50" style="v" sid="LUK 9:50" />Tọ Chảu Giê-xu cạ ké: “Mí đảy căm hau te̱p, vi̱ cần nàư mí tói tỉng pi̱ noọng do̱ chung ý đủi pi̱ noọng.”<verse eid="LUK 9:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />Xảư thưng vằn Chảu Giê-xu đảy dò khửn fạ, Min chứng slưửng pay thưng slẻng Giê-ru-sa-lem. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />Min xoi kí cần tang nả pay cón, hau pay khảu bản nưng cú cần Sa-ma-ri sle chắp xặp hử Min. <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />Tọ cần Sa-ma-ri mí chiíp Min, vi̱ Min pay thưng dưứng slẻng Giê-ru-sa-lem. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />Kí cần nèm slon mìng hít Gia-cơ xáu Giăng hăn pìn nỉnh, chứng tham: “Pái Chảu, Chảu ái hung ngo̱ dảo fày tứ fạ lùng sliu mảy hau mí?” <verse eid="LUK 9:54" /><verse number="55" style="v" sid="LUK 9:55" />Tọ Chảu Giê-xu váy te̱o quáy hau, <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />dá Min xáu kí cần nèm slon pay quá bản táng.<verse eid="LUK 9:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />Pay to̱i lo̱, cần nưng mà dăng Chảu Giê-xu: “Slay pay haư, ngo̱ co̱i nèm nỉnh.” <verse eid="LUK 9:57" /><verse number="58" style="v" sid="LUK 9:58" />Chảu Giê-xu hòi vàm báo nỉnh: “Tu hin mì thẳm, nục fạ mì lằng, tọ Lu̱c Cú Cần mí mì ti̱ tặt hu.” <verse eid="LUK 9:58" /><verse number="59" style="v" sid="LUK 9:59" />Min cạ cần táng nưng: “Pay nèm ngo̱.” Tọ cần nỉnh dăng: “Pái Chảu, hử ngo̱ mà phăng pá ngo̱ cón è.” <verse eid="LUK 9:59" /><verse number="60" style="v" sid="LUK 9:60" />Tọ Chảu Giê-xu cạ báo nỉnh: “Cứ sle cần hai phăng cần hai cú hau. Nhằng ni̱, lèo pay páo cạ mà tum ti̱ Chảu Fạ.” <verse eid="LUK 9:60" /><verse number="61" style="v" sid="LUK 9:61" />Dá mì cần táng nưng num dăng: “Pái Chảu, ngo̱ co̱i pay nèm Chảu, tọ xo hử ngo̱ mừ slắng kí cần đưng lưừn cón.” <verse eid="LUK 9:61" /><verse number="62" style="v" sid="LUK 9:62" />Tọ, Chảu Giê-xu hòi vàm: “Mí cần nàư căm ma̱c thay te̱o nho̱m mà bưửng lăng, do̱ ngám hử tum ti̱ Chảu Fạ.”<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />Túc lăng, Chảu Giê-xu xày lưư̱c au chất slíp nhi̱ cần nèm slon num, dá xoi pìn tói pay cón, khảu thuủn kí slẻng xáu kí ti̱ chăn Min co̱i thưng. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />Min cạ hau: “Ma̱i cạ khảu do̱ slúc lai, tọ cần cùn do̱ nọi. Pìn nỉnh, lèo xỉnh xo Chảu mù cùn xoi lai cần pay cùn khảu hử Min. <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" />Lèo khửn lo̱! Nho̱m ne̱, ngo̱ xoi kí pi̱ noọng pay xị chiin lu̱c dú chang xá ma này. <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />Mí đảy au nèm ta̱y chèn, ta̱y ngàm, cài, xáu mí đảy tuụng cần nàư to̱i lo̱ pay. <verse eid="LUK 10:4" /><verse number="5" style="v" sid="LUK 10:5" />Hạy pi̱ noọng khảu lưừn haư, ta̱i tàu cứ cung fúc: ‘Pìng an dú đủi lưừn nảy!’ <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />Hạy lu̱c cú pình an dú nỉnh, do̱ pình an cú pi̱ noọng co̱i dú đủi cần nỉnh; hạy mí, do̱ pình an co̱i fan te̱o đủi pi̱ noọng <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" />Cứ dú lưừn nỉnh, kin đủi hau, vi̱ cần hít cung ngám sle đảy păng chèn cung. Mí đảy pay tứ lưừn nảy quá lưừn đai. <verse eid="LUK 10:7" /><verse number="8" style="v" sid="LUK 10:8" />Hạy slẻng haư tỏn chiíp kí pi̱ noọng khảu, do̱ cứ kin mọi lo̱ hau tọn hử pi̱ noọng, <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />Lèo da đay cần pi̱ng dú nỉnh dá cạ hau: ‘Tum ti̱ Chảu Fạ tó thưng xảư kí pi̱ noọng.’ <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" />Nhằng hạy slẻng haư pi̱ noọng khảu, tọ hau te̱o mí chiíp tỏn pi̱ noọng, do̱ cứ pay oóc noo̱c kha lo̱ cú slẻng nỉnh, dá cạ: <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" />‘Tằng mư̱n tum dú slẻng kí cần ni̱ nem khảu kha, hung ngo̱ tó ma̱t slaư, tỉng te̱o kí cần ni̱! Tọ lèo chắc pìn nảy: tum ti̱ Chảu Fạ tó thưng xảư dá.’ <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" />Ngo̱ cạ kí pi̱ noọng cạ, thưng vằn ứn chá, slẻng Sô-đôm co̱i tảy fa̱t hẳm bau quá slẻng nỉnh. <verse eid="LUK 10:12" /><verse number="13" style="v" sid="LUK 10:13" />Slói hử mưng, slẻng Cô-ra-xin! Slói hử mưng, slẻng Bết-sai-đa! Vi̱ hạy kí lo̱ quỳn slèng đảy hít dú ti̱ pi̱ noọng, te̱o au hít dú slẻng Ty-rơ xáu slẻng Si-đôn, do̱ hau tó nu̱ng slử pán, nă̱ng tìng pja̱u cho̱i xá tứ hưng dá. <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />Pìn nỉnh, khảu vằn ứn chá, Ty-rơ xáu Si-đôn tảy fa̱t hẳm bau quá hung mưng. <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />Nhằng mưng, slẻng Ca-bê-na-um, mưng co̱i đảy dảu slung thưng fạ do̱ lừ? Mưng co̱i ngài vẻng lùng slặn ti̱ dăm. <verse eid="LUK 10:15" /><verse number="16" style="v" sid="LUK 10:16" />Cần nàư ti̱ng pi̱ noọng chư̱ ti̱ng ngo̱; cần nàư thoi ngài pi̱ noọng, chư̱ thoi ngài ngo̱, tọ cần nàư thoi ngài ngo̱, chăn chư̱ thoi ngài Lạo tó xoi ngo̱.”<verse eid="LUK 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />Chất slíp nhi̱ cần nèm slon hun hỉ fan mừ, dăng cạ: “Pái Chảu, chang mình Chảu, tằng cạ kí phi sla̱ lèo fục hung ngo̱.” <verse eid="LUK 10:17" /><verse number="18" style="v" sid="LUK 10:18" />Chảu Giê-xu cạ hau: “Ngo̱ tó hăn Sa-tan tứ fạ lút lùng xị me̱p. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />Ne̱, ngo̱ pảo hử pi̱ noọng quỳn sle dă̱m ta̱p ngù, khỉ khíp xáu ta̱p mọi quỳn cú cần tói tàu tảư kha, chứng bó mì lo̱ lăng hít ha̱i kí pi̱ noọng đảy. <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />Tọ, mí đảy hun fằng vi̱ kí phi sla̱ fục pi̱ noọng, tọ lèo hun fằng vi̱ mìng pi̱ noọng tó đảy slẻ tìng thiin ti̱.”<verse eid="LUK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />Chăn tiỉm nỉnh, Chảu Giê-xu hun hỉ chang Chảu Khoăn xáu cạ: “Pái Chảu, chăn chư̱ Chảu cú fạ xáu tum, lu̱c că̱n Pá, vi̱ Pá tó dăm kí lo̱ nảy khói cần quai kí xáu cần thung slụ tọ hử lu̱c đích chắc! Chăn pìn nỉnh, Pá ới, pìn nỉnh đay tói nả Pá. <verse eid="LUK 10:21" /><verse number="22" style="v" sid="LUK 10:22" />Pá tó chao mọi lo̱ hử lu̱c. Mí cần nàư chắc Lu̱c đảy, tan Pá chắc Lu̱c xày, mí cần nàư chắc Pá, tan Lu̱c xáu cần nàư Lu̱c ái hử chắc.” <verse eid="LUK 10:22" /><verse number="23" style="v" sid="LUK 10:23" />Dá Min váy te̱o, cạ tan kí cần nèm slon: “Fúc hử ha cần nàư đảy hăn lo̱ kí pi̱ noọng đảy hăn! <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />Vi̱ ngo̱ cạ kí pi̱ noọng chắc, mì lai cần páo cón xáu huùng mu̱ng hăn lo̱ kí pi̱ noọng hăn te̱o mí hăn đảy, mu̱ng ti̱ng lo̱ kí pi̱ noọng ti̱ng te̱o bó ti̱ng đảy.”<verse eid="LUK 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />nỉnh cà, mì cần thung slụ luật fáp nưng tấn dân tham sle xi Chảu Giê-xu, cạ: “Slay ới, ngo̱ lèo hít lăng sle đảy lo̱ te̱o tơ̱i tơ̱i?” <verse eid="LUK 10:25" /><verse number="26" style="v" sid="LUK 10:26" />Min hòi vàm cần nỉnh: “Chang luật fáp slẻ lăng? Ni̱ to̱c hăn pìn lừ?” <verse eid="LUK 10:26" /><verse number="27" style="v" sid="LUK 10:27" />Cần nỉnh dăng: “Lu̱c lèo thuủn slim, thuủn khoăn mi̱ng, thuủn slèng, thuủn slim ki điíp Chảu chăn chư̱ Chảu Fạ lu̱c; xáu điíp cần xảư xảng xị chăn làu.” <verse eid="LUK 10:27" /><verse number="28" style="v" sid="LUK 10:28" />Chảu Giê-xu cạ: “Ni̱ chảng chư̱ lai. Lèo hít pìn nỉnh do̱ ni̱ co̱i đảy te̱o.” <verse eid="LUK 10:28" /><verse number="29" style="v" sid="LUK 10:29" />Tọ ké nỉnh ái hử chắc làu chư̱ cần cung chính, chứng dăng xáu Chảu Giê-xu: “Pìn nỉnh do̱ cần nàư chư̱ cần xảư xảng ngo̱?” <verse eid="LUK 10:29" /><verse number="30" style="v" sid="LUK 10:30" />Chảu Giê-xu hòi vàm: “Mì cần nưng tứ slẻng Giê-ru-sa-lem lùng slẻng Giê-ri-cô ngài cà khảu mừ boong cưứp, hau kẻ thuủn slử khóa, cọn chíp cắm, dá tả pay, tả sle cần nỉnh te̱o bó te̱o, hai bó hai. <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />Chíu nỉnh, mì slay pài xoòng nưng pay quá lo̱ nỉnh, hăn cần phúng chai na̱n, do̱ pay phiín quá bưửng nỉnh. <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" />Xày pìn nỉnh, cần Lê-vi nưng xày thưng ti̱ nỉnh, hăn cần phúng na̱n tọ phiín quá bưửng nỉnh pay. <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" />Tọ mì cần Sa-ma-ri pay lo̱, thưng xảư cần phúng na̱n, do̱ hăn slim điíp sliít. <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />Chứng khảu xảư, au dù xáu lảu ma̱t khảu ti̱ chíp, dá tài cần chíp khửn tu lừ cú làu xáu tái thưng lưừn to̱ sle ngòi nho̱m cần nỉnh. <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />Vằn lăng, ké au sloong đơ-ni-ê păng hử chảu lưừn to̱ xáu slắng: ‘Lèo ngòi nho̱m cần nảy, hạy thuủn hẳm lai chèn num, slì fan te̱o ngo̱ co̱i păng hử.’ <verse eid="LUK 10:35" /><verse number="36" style="v" sid="LUK 10:36" />Ni̱ nẳm, chang slam cần nỉnh, cần nàư pìn cần xảư xảng đủi cần ngài cưứp?” <verse eid="LUK 10:36" /><verse number="37" style="v" sid="LUK 10:37" />Slay slon luật fáp dăng: “nỉnh chư̱ cần tó mì slim điíp sliít đủi cần ngài ha̱i.” Chảu Giê-xu chứng cạ ké: “Cứ pay, hít hút pìn nỉnh.”<verse eid="LUK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />Chảu Giê-xu xáu kí cần nèm slon te̱o khửn lo̱, Min khảu bản nưng, mì cần ti̱ me̱ mìng hít Ma-thê tỏn Min khảu lưừn. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />Ma-thê mì noọng slao mìng hít Ma-ri, nă̱ng xảư kha Chảu sle ti̱ng vàm Min. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />Nhằng Ma-thê cứ chắp xặp, chứng mà dăng: “Pái Chảu, noọng ngo̱ tả ngo̱ táng cung ta̱i cần đeo, Chảu mí to sla̱y thưng do̱ lừ? Xo Chảu cạ min pang cho̱i ngo̱!” <verse eid="LUK 10:40" /><verse number="41" style="v" sid="LUK 10:41" />Chảu cạ: “Ma-thê, Ma-thê ới, ni̱ dau hí xáu slim luu̱n mà lai lo̱, <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />tọ tan lèo hít lo̱ nưng xày. Ma-ri tó lưư̱c fă̱n đay, chư̱ fă̱n co̱i mí cần nàư au khói min đảy.”<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />Chíu Chảu Giê-xu xỉnh chàu dú ti̱ nỉnh, mì cần nèm slon nưng mà tham Min: “Pái Chảu, xo slon hung ngo̱ xỉnh chàu, xị Giăng tó slon kí cần nèm slon.” <verse eid="LUK 11:1" /><verse number="2" style="v" sid="LUK 11:2" />Min cạ hau: “Chíu pi̱ noọng xỉnh chàu, cứ chảng:</para>
  <para style="q1" vid="LUK 11:2">‘Pái Pá, xo mình Pá đảy tài thánh.</para>
  <para style="q2" vid="LUK 11:2">Xo tum ti̱ Pá đảy thưng.<verse eid="LUK 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3" />Xo hử hung lu̱c cú kin cẩn hử mọi vằn.<verse eid="LUK 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4" />Xo sla phít xá hử hung lu̱c,</para>
  <para style="q2" vid="LUK 11:4">vi̱ hung lu̱c xày sla dưư̱ng hử cần pìn phít xá hung lu̱c.</para>
  <para style="q1" vid="LUK 11:4">Xo mí đảy sle hung lu̱c ngài láu.’”<verse eid="LUK 11:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="LUK 11:5" />Dá Min cạ hau: “Cần nàư chang pi̱ noọng mì pàng dạu nưng, chang khừn thưng lưừn cạ cần nỉnh: ‘Ni̱ ới, hử ngo̱ dim slam ăn pẻng, <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />vi̱ pàng dạu ngo̱ tứ quay ngám mà, ngo̱ te̱o mí mì lăng sle tọn hử cần nỉnh.’ <verse eid="LUK 11:6" /><verse number="7" style="v" sid="LUK 11:7" />Hạy cần nỉnh tứ đưng lưừn hòi vàm: ‘Mí đảy hít fàn ngo̱. Tu hắp khảu dá, kí lu̱c xáu ngo̱ tó pay nòn. Ngo̱ mí tấn au pẻng hử ni̱ đảy đơ.’ <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />Ngo̱ cạ kí pi̱ noọng, ma̱i cạ cần nỉnh mí tấn dân au pẻng hử pàng dạu làu, tọ vi̱ pàng dạu cứ na̱i xo mại chứng tấn khửn au hử pàng dạu đo pẻng cần nỉnh cẩn du̱ng. <verse eid="LUK 11:8" /><verse number="9" style="v" sid="LUK 11:9" />Ngo̱ xày cạ pi̱ noọng, cứ xo, pi̱ noọng co̱i đảy; cứ thắp, pi̱ noọng co̱i phúng; cứ hói tu, do̱ tu co̱i khay oóc hử pi̱ noọng. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />Vi̱ xắn cần nàư xo do̱ đảy; cần nàư thắp do̱ phúng; xáu tu co̱i đảy khay hử cần nàư hói. <verse eid="LUK 11:10" /><verse number="11" style="v" sid="LUK 11:11" />Mì cần pá nàư chang kí pi̱ noọng, slì lu̱c làu xo pja te̱o hử min ngù tháy vi̱ pja mí? <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />Do̱ va̱ xo xáy, te̱o hử tu khỉ khíp mí? <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />Pìn nỉnh, hạy kí pi̱ noọng chư̱ cần xảu, nhằng chắc hử lu̱c làu kí ăn đay, do̱ Pá dú tìng fạ co̱i pảo Chảu Khoăn hẳm lai hử cần xo Min?”<verse eid="LUK 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />Chảu Giê-xu te̱p tu phi vặp nưng. Dá chíu phi sla̱ oóc khói dá, cần vặp liìn chảng đảy, phang cần chứng he. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />Tọ mì kỉ cần chang kí cần hau chảng: “Ké nỉnh te̱p phi sla̱ pừng khảu Bê-ên-xê-bun, chư̱ chảu phi sla̱.” <verse eid="LUK 11:15" /><verse number="16" style="v" sid="LUK 11:16" />Nhằng kỉ cần táng, xi Min, hau chứng to̱i Min hít ha̱o pjòi nưng tứ fạ. <verse eid="LUK 11:16" /><verse number="17" style="v" sid="LUK 11:17" />Tọ Chảu Giê-xu chắc hau nẳm lăng chứng cạ: “Tum ti̱ haư táng păn pja̱c, táng tỉng te̱o do̱ co̱i ngài hít hử túm tác, lưừn haư táng tỉng te̱o do̱ lưừn nỉnh slán slác. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />Hạy Sa-tan táng păn pja̱c tỉng te̱o min, do̱ tum ti̱ cú min hít lăng nhằng đảy? Vi̱ kí ké cạ ngo̱ pừng khảu Bê-ên-xê-bun sle te̱p phi sla̱. <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />Hạy ngo̱ pừng Bê-ên-xê-bun sle te̱p phi sla̱, do̱ kí lu̱c lan kí ké pừng khảu cần nàư sle te̱p phi sla̱? Pìn nỉnh, chăn hau co̱i ứn chá kí ké. <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />Tọ, hạy ngo̱ pừng khảu quỳn cú Chảu Fạ sle te̱p phi sla̱, do̱ tum ti̱ Chảu Fạ tó mà đủi kí ké dá. <verse eid="LUK 11:20" /><verse number="21" style="v" sid="LUK 11:21" />Slì cần nàư mì slèng, mì đo pjạ dáng pạư lưừn làu do̱, cha xài cần nỉnh đảy pình an, <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />tọ slì mì cần hẳm slèng quá cần nỉnh pu̱ng khảu, hình đảy, do̱ cheng au pjạ dáng cú cần nỉnh pừng khảu, dá au pay păn cú cái tó cưứp au đảy. <verse eid="LUK 11:22" /><verse number="23" style="v" sid="LUK 11:23" />Cần nàư mí dú đủi ngo̱ do̱ tói tỉng te̱o ngo̱, cần nàư mí slan cáp đủi ngo̱ do̱ slán slác. <verse eid="LUK 11:23" /><verse number="24" style="v" sid="LUK 11:24" />Slì slẳm khoăn oóc khói cần nưng, min pay quá kí ti̱ lẹng sle xa ti̱ diít cha̱i. Tọ mí xa đảy, phi sla̱ chảng: ‘Cau co̱i fan mừ lưừn cau, ti̱ cau ngám oóc khói.’ <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />Mà thưng lưừn dá, hăn lưừn đảy fọn slaư xáu chang chỉng. <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />Min chứng pay xù chất phi sla̱ táng hẳm xan tò khảu dú lưừn nỉnh. Pìn nỉnh, mư̱ lăng cú cần nỉnh nhằng hại đát quá mư̱ cón.”<verse eid="LUK 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />Chíu Chảu Giê-xu cạ kí vàm nỉnh, mì cần ti̱ me̱ tứ chang phang cần khửn heng dăng: “Fúc hử múc tó làm đang slay xáu nùm tó hử slay kin!” <verse eid="LUK 11:27" /><verse number="28" style="v" sid="LUK 11:28" />Tọ Min hòi vàm: “Kí cần nàư ti̱ng xáu hít nèm vàm Chảu Fạ nhằng hẳm đảy fúc quá!”<verse eid="LUK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />Chíu phang cần ho̱p căn te̱o hẳm đung, Min khay vàm cạ: “Xám cần nảy chư̱ xám cần too̱c éc. Hau xa ha̱o pjòi nưng, tọ co̱i mí mì ha̱o pjòi haư pảo hử hau, tan ha̱o pjòi cú Giô-na. <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />Vi̱ Giô-na tó hít ha̱o hử cần slấn dú Ni-ni-ve pìn lừ, do̱ Lu̱c Cú Cần xày co̱i hít ha̱o hử kí cần xám nảy pìn nỉnh. <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" />Chang vằn ứn chá, Da̱ Huùng Nàm Fuung co̱i tấn khửn tói tỉng te̱o kí cần cú xám nảy, xáu cáp xá hau; vi̱ tứ slặn ti̱ hang tum, da̱ mà ti̱ng vàm quai kí cú huùng Sô-lô-môn, nho̱m ne̱, dú nảy mì Lạo nhằng cải quá Sa-lô-môn num! <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" />Chang vằn ứn chá, cần Ni-ni-ve co̱i tấn khửn tói tỉng xám cần nảy dá cáp xá hau, vi̱ hau tó đảy ti̱ng vàm Giô-na páo cạ dá cho̱i xá, ne̱, dú nảy mì Lạo nhằng cải quá Giô-na num.<verse eid="LUK 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />Mí cần nàư tẻm tưng, te̱o tặt dú ti̱ lặm do̱ va̱ dú tảư ăn thủng, tọ tặt tìng kha tưng sle kí cần phjải khảu nho̱m hăn áng slu̱ng đảy. <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />Ha cú pi̱ noọng xị tưng cú đúc đang. Hạy ha pi̱ noọng đay do̱ tằng đúc đang xày slu̱ng, tọ hạy ha va̱i do̱ tằng đúc đang pi̱ noọng xày đăm. <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />Pìn nỉnh, lèo vẳn chằn, lao áng slu̱ng chang pi̱ noọng te̱o pìn ngàu đăm. <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />Hạy tằng đúc đang pi̱ noọng tim áng slu̱ng, mí mì fă̱n haư đăm, do̱ min co̱i đảy slu̱ng thuủn, xị nhoo̱t tưng xoi slu̱ng hử pi̱ noọng.”<verse eid="LUK 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />Chíu Chảu Giê-xu chảng dá, mì cần Pha-ri-si xỉnh Min mà lưừn kin đủi ké. Min phjải khảu, nă̱ng khảu xoòng kin. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />Cần Pha-ri-si nảy hăn lạ, vi̱ mí hăn Min slào mừ cón tón kin. <verse eid="LUK 11:38" /><verse number="39" style="v" sid="LUK 11:39" />Tọ Chảu cạ: “Cà nạy, cần Pha-ri-si kí ké slào slaư bưửng noo̱c thủi cha̱m, nhằng bưửng đưng do̱ tim kí thám cò xáu too̱c éc. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />Kí cần bả nỉnh ới! Bó chư̱ Lạo tó hít pìn bưửng noo̱c xày hít pìn bưửng đưng num do̱ lừ? <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />Tọ lèo pang slí hử hau kí lo̱ làu mì, do̱ mọi lo̱ chứng pìn slaư tích hử kí ké.<verse eid="LUK 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42" />Slói hử cần Pha-ri-si kí ké, vi̱ kí ké no̱p đo fă̱n slíp phjắc hom, mác chác, xáu mọi thìng phjắc đưng la̱y, tọ te̱o ngòi che̱n cung lị xáu slim điíp Chảu Fạ! Pi̱ noọng lèo hít kí lo̱ nảy tọ mí đảy lùm kí lo̱ nỉnh. <verse eid="LUK 11:42" /><verse number="43" style="v" sid="LUK 11:43" />Slói hử cần Pha-ri-si kí ké, vi̱ kí ké ái nă̱ng ti̱ hẳm đay chang lưừn ho̱i, xáu mu̱ng đảy hau tuụng chang háng. <verse eid="LUK 11:43" /><verse number="44" style="v" sid="LUK 11:44" />Slói hử kí ké, vi̱ kí ké hút xị ăn fằn tả đai, hau khảm quá tìng te̱o mí chắc.”<verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />Cần thung slụ luật fáp nưng chứng chảng: “Slay ới, slay xày chảng pìn nỉnh sle hít xảu nả tằng hung ngo̱ num.” <verse eid="LUK 11:45" /><verse number="46" style="v" sid="LUK 11:46" />Chảu Giê-xu hòi vàm: “Slói hử kí cần thung slụ luật fáp! Vi̱ kí ké slọ hử hau háp nắc khỏ thư, nhằng chăn kí ké do̱ hu nịu mừ nưng tó mí tu̱ng thưng háp nắc nỉnh! <verse eid="LUK 11:46" /><verse number="47" style="v" sid="LUK 11:47" />Slói hử kí ké, vi̱ kí ké xáy fằn hử kí cần páo cón, nhằng chăn cúc chỏ kí ké te̱o khả hai hau! <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />Pìn nỉnh, kí ké hít chửng xáu khảu cò kí lo̱ cúc chỏ làu hít, vi̱ hau tó khả kí cần páo cón, nhằng kí ké te̱o xáy fằn hử kí cần nỉnh. <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />Pìn nỉnh, quai kí cú Chảu Fạ tó cạ: ‘Cau co̱i xoi kí cần páo cón xáu cần đảy xoi pay thưng đủi hung min, tọ hung min co̱i khả cần, hít khỏ lai cần hau’ <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />sle xám cần nảy co̱i ngài to̱i nỉ lưư̱t cú thuủn kí cần páo cón tó đíng oóc tứ vằn chí oóc ti̱ da̱, <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />tứ lưư̱t cú A-bên thưng lưư̱t Xa-cha-ri ngài khả dú chang ti̱ xoòng xằn xáu lưừn slớ. Chăn, ngo̱ cạ kí ké, xám cần nảy co̱i ngài to̱i nỉ lưư̱t nỉnh. <verse eid="LUK 11:51" /><verse number="52" style="v" sid="LUK 11:52" />Slói hử kí cần thung slụ luật kí ké, vi̱ kí ké tó căm slì slả cú thung slụ, chăn kí ké mí khảu, tọ kí cần táng ái khảu, kí ké te̱o mí hử khảu.”<verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />Chíu Chảu Giê-xu oóc khói nỉnh, kí slay slon luật fáp xáu cần Pha-ri-si xo tàu tói tỉng Min xảm lai, xáu slẳm tham Min mà lai lo̱, <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />sle hảng mọi vàm tứ pác Min chảng oóc.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />Chíu nỉnh, mì pan đung ho̱p tằng fa̱n cần, thưng slặn dă̱m ta̱p khửn căn. Chảu Giê-xu chứng cạ kí cần nèm slon làu: “Lèo slỉu slim khói bư phù cú cần Pha-ri-si, chư̱ kí cần quén lứ pjàng mja̱p. <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" />Tọ, bó mì lo̱ lăng ngài dăm dà te̱o bó ngài lo̱i oóc, ca lăng lặc lu̱m hít te̱o mí ngài hau chắc. <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />Pìn nỉnh, hạy kí lo̱ pi̱ noọng tó chảng chang ngàu đăm, co̱i đảy ti̱ng dú ti̱ slu̱ng; kí lo̱ pi̱ noọng lặc lu̱m chảng dú píc xu đưng hó co̱i đảy páo oóc tìng pài lưừn. <verse eid="LUK 12:3" /><verse number="4" style="v" sid="LUK 12:4" />Ngo̱ chứng cạ pi̱ noọng chư̱ pàng dạu ngo̱, mí đảy lao kí cần khả đảy đúc đang, dá mư̱ lăng te̱o mí nhằng hít lăng đảy num. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />Tọ ngo̱ hử pi̱ noọng chắc lèo lao cần nàư. Lèo lao Lạo, slì tó khả hai đúc đang dá, nhằng mì quỳn vẻng hau lùng ngục fày. Chăn pìn nỉnh, ngo̱ cạ pi̱ noọng, lèo lao Lạo nỉnh. <verse eid="LUK 12:5" /><verse number="6" style="v" sid="LUK 12:6" />Bó chư̱ hả tu nục choóc tan khai đảy sloong mưn chèn do̱ lừ? Tọ, bó mì slắc tu càư chang kí tu nỉnh ngài tả lùm tói nả Chảu Fạ. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />Tằng cạ phjâm dú tìng hu pi̱ noọng nhằng đảy án thuủn dá. Mí đảy lao, vi̱ pi̱ noọng hẳm pèng quá tu nục choóc. <verse eid="LUK 12:7" /><verse number="8" style="v" sid="LUK 12:8" />Ngo̱ cạ pi̱ noọng, hạy cần nàư nhă̱n ngo̱ tói nả mọi cần, do̱ Lu̱c Cú Cần xày co̱i nhă̱n cần nỉnh tói nả kí cần tang nả Chảu Fạ, <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />nhằng cần nàư thoi ngài ngo̱ tói nả mọi cần, do̱ cần nỉnh xày co̱i ngài thoi ngài tói nả kí cần tang nả Chảu Fạ. <verse eid="LUK 12:9" /><verse number="10" style="v" sid="LUK 12:10" />Cần nàư chảng vàm fa̱m đủi Lu̱c Cú Cần do̱ co̱i đảy sla dưư̱ng, tọ cần nàư chảng fa̱m thưng Chảu Khoăn co̱i mí đảy sla dưư̱ng đơ. <verse eid="LUK 12:10" /><verse number="11" style="v" sid="LUK 12:11" />Chíu hau tái pi̱ noọng thưng kí lưừn ho̱i, tói nả kí cần cai cuủn xáu cần căm quỳn, do̱ mí đảy dau lèo chảng pìn lừ sle khảu cò làu, do̱ va̱ chảng ca lăng, <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />vi̱ chăn chíu nỉnh, Chảu Khoăn co̱i slon hử pi̱ noọng chắc kí lo̱ lèo chảng.”<verse eid="LUK 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />Túc lăng, mì cần nưng chang phang cần dăng đủi Chảu Giê-xu: “Slay ới, xo cạ pi̱ báo ngo̱ păn cha xài hử ngo̱.” <verse eid="LUK 12:13" /><verse number="14" style="v" sid="LUK 12:14" />Min hòi vàm cần nỉnh: “Ne̱, ni̱ ới, cần nàư tặt ngo̱ hít quan ứn chá do̱ va̱ cần păn cha xài hử kí cần ni̱?” <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />Dá Min cạ hau: “Lèo slỉu slim mà mọi lo̱ thám cò, vi̱ tu cần te̱o đảy bó chư̱ pừng khảu cú cái làu fúng fàu đơ.” <verse eid="LUK 12:15" /><verse number="16" style="v" sid="LUK 12:16" />Min te̱o li̱n hử hau pỉ xì nảy: “Nà la̱y cú cần fát xài nỉnh đảy mù lai, <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />báo nỉnh lặc nẳm: ‘Làu lèo hít lăng, vi̱ nhằng mí đo ti̱ sle to khảu bắp?’ <verse eid="LUK 12:17" /><verse number="18" style="v" sid="LUK 12:18" />Báo nỉnh cạ: ‘Làu co̱i hít pìn nảy: “Làu co̱i hít túm kí xang nảy, sle xáy kí ăn táng hẳm cải, sle thuủn khảu bắp xáu mọi cú cái đay khảu đưng nỉnh.” <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />Dá táng cạ khoăn mi̱ng làu cạ: “Khoăn ới, ni̱ tó đảy lai cú cái sle du̱ng lai pi. Cứ diít cha̱i, kin, xáu hun hỉ.”’ <verse eid="LUK 12:19" /><verse number="20" style="v" sid="LUK 12:20" />Tọ Chảu Fạ cạ cần nỉnh: ‘Cần bả nỉnh ới, chăn că̱m nảy khoăn mi̱ng ni̱ co̱i ngài to̱i te̱o, kí cú cái mưng tó hom sle co̱i slục mà cần nàư?’ <verse eid="LUK 12:20" /><verse number="21" style="v" sid="LUK 12:21" />Cần nàư slau slặp cú cái hử làu, te̱o mí fát xài tói nả Chảu Fạ xày bả pìn nỉnh.”<verse eid="LUK 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />Chảu Giê-xu cạ kí cần nèm slon: “Pìn nỉnh, ngo̱ cạ pi̱ noọng, mí đảy dau làu kin ca lăng; do̱ va̱ mí đảy dau đúc đang nu̱ng ca lăng. <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />Vi̱ mi̱ng te̱o nhằng pèng quá cú kin, đúc đang nhằng pèng quá slử khóa. <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />Cứ nho̱m chủng nục ca, min mí ván, mí cùn, xày mí mì xang to, Chảu Fạ te̱o nhằng chưựng min. Pi̱ noọng nhằng pèng quá chủng nục lai! <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />Dá, mì cần nàư chang pi̱ noọng pừng khảu dau hí, te̱o hít hử tơ̱i làu lì pjặp ha num mí? <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />Pìn nỉnh, hạy kí pi̱ noọng mí hít đảy ca lăng sláy pìn nỉnh, do̱ hít lừ pi̱ noọng te̱o dau mà kí lo̱ táng? <verse eid="LUK 12:26" /><verse number="27" style="v" sid="LUK 12:27" />Cứ ngòi bjoóc huệ — min cải khửn pìn lừ: Boong min bó hít cung khỏ, xày mí kẻo may. Tọ ngo̱ cạ pi̱ noọng, tằng cạ huùng Sa-lô-môn slu̱ng phjưức thưng haư, xày mí đảy nu̱ng đay xị bjoóc nưng chang kí bjoóc nảy. <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />Kí cần nọi slim slấn nỉnh ới, hạy Chảu Fạ nhằng nu̱ng đay pìn nỉnh hử bjoóc nhả dú tu̱ng, vằn nảy nhằng te̱o, vằn chục ngài vẻng khảu coong fày, do̱ pi̱ noọng nhằng pèng thưng haư. <verse eid="LUK 12:28" /><verse number="29" style="v" sid="LUK 12:29" />Pìn nỉnh, pi̱ noọng mí đảy dau làu kin lăng, xày mí đảy dau hí lai. <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />Vi̱ kí nòi cần tìng ti̱ da̱ nảy xày xa thắp kí lo̱ nỉnh, tọ Pá cú pi̱ noọng tó chắc pi̱ noọng cẩn kí lo̱ nỉnh dá. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />Tọ lèo xa thắp tum ti̱ Chảu Fạ, do̱ pi̱ noọng chứng đảy kí lo̱ nỉnh num. <verse eid="LUK 12:31" /><verse number="32" style="v" sid="LUK 12:32" />Kí lu̱c eng ới, mí đảy lao, vi̱ Pá cú pi̱ noọng tó hun fằng pảo tum ti̱ Chảu Fạ hử pi̱ noọng dá. <verse eid="LUK 12:32" /><verse number="33" style="v" sid="LUK 12:33" />Lèo khai cú cái làu mì sle pang cho̱i cần khỏ. Lèo chí hử làu kí ta̱y chèn mí va̱i túc — chăn kí xang pảo dú tìng fạ, ti̱ ò lặc mí thưng xảư đảy, mèng mảu mí hít va̱i đảy. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />Vi̱ cú cái pi̱ noọng dú haư, do̱ slim pi̱ noọng xày dú nỉnh.<verse eid="LUK 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />Lăng cú pi̱ noọng lèo hảng khảu, tưng lèo tẻm mảy khửn, <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" />pi̱ noọng lèo hít xị kí cần mu̱ng tẳng chảu làu dú sli̱c lảu mà, sle chíu chảu mà thưng xáu hói tu, do̱ hau făn fi khay hử chảu. <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />Fúc hử kí cần khỏi nỉnh, chiu chảu mà hăn hau nhằng slỉng sle pạư! Chăn, ngo̱ cạ pi̱ noọng, chảu co̱i hảng lăng, xỉnh kí cần khỏi nă̱ng khảu xoòng kin, dá chảu cung ta̱i hau. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />Hạy tứ tằng că̱m thưng chíu fạ ái slu̱ng, chảu mà hăn kí cần khỏi pìn nỉnh, do̱ chăn chư̱ fúc hử hau. <verse eid="LUK 12:38" /><verse number="39" style="v" sid="LUK 12:39" />Lèo chắc pìn nảy, hạy chảu lưừn chắc mư̱ haư ò lặc thưng, do̱ cay mí sle min khảu lưừn làu. <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />Pi̱ noọng xày lèo ính xình, vi̱ chíu kí pi̱ noọng mí nẳm thưng, do̱ Lu̱c Cú Cần mà.”<verse eid="LUK 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />Phi-e-rơ tham: “Pái Chảu, Chảu chảng pỉ xì nảy tan hử hung ngo̱, do̱ va̱ xày hử mọi cần num?” <verse eid="LUK 12:41" /><verse number="42" style="v" sid="LUK 12:42" />Chảu hòi vàm: “Pìn nỉnh, cần nàư pìn cần cuủn cha xài slim đeo, quai kí, đảy chảu lưừn hử cuủn lị kí cần khỏi sle dau păn cú kin hử hau khảu chăn slì? <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />Fúc hử cần khỏi nỉnh, chíu chảu lưừn mà hăn hít chăn pìn nỉnh. <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />Chăn, ngo̱ cạ pi̱ noọng, chảu lưừn co̱i chao hử cần khỏi nỉnh cuủn lị thuủn kí cha xài làu. <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />Tọ hạy cần khỏi nỉnh lặc nẳm đưng slim, cạ: ‘Lạo chảu làu nhằng hưng chứng mà,’ chứng xo tàu cọn thuúp kí cần báo slao khỏi, dá kin, nhẳm màu mè, <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />do̱ chảu cú cần khỏi nỉnh co̱i mà chang vằn cần khỏi mí nẳm thưng, khảu slì min mí chắc, chảu khả hai, dá tặt min khảu đủi cần mí chăn chính. <verse eid="LUK 12:46" /><verse number="47" style="v" sid="LUK 12:47" />Cần khỏi nỉnh tó chắc ý chảu làu te̱o mí chắp xặp, mí hít nèm slim chảu, co̱i ngài cọn lai. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />Nhằng cần khỏi haư mí chắc te̱o hít kí lo̱ tảy fa̱t do̱ co̱i ngài fa̱t nọi. Dá kí cần nàư đảy pảo hử lai, do̱ co̱i ngài to̱i te̱o lai, cần nàư tó đảy chao hử lai quá, do̱ ngài to̱i te̱o hẳm lai.<verse eid="LUK 12:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />Ngo̱ tó thưng sle vẻng fày lùng tum, ngo̱ mu̱ng hử fày mảy khửn đảy dá! <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" />Tọ ngo̱ nhằng lèo tảy báp-têm nưng, ngo̱ chíp đát kỉ lai thưng slì báp-têm nỉnh đảy hít thuủn! <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />Pi̱ noọng la̱i cạ ngo̱ thưng sle ti̱ da̱ nảy đảy pình an do̱ lừ? Mí chư̱ đơ, ngo̱ cạ kí pi̱ noọng, ngo̱ thưng sle păn pja̱c do̱ hẳm chư̱. <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />Vi̱ tứ nảy, co̱i mì hả cần tò xày dú lưừn nưng ngài păn pja̱c căn — slam cần tò tỉng xáu sloong, sloong cần tói tỉng xáu slam. <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />Hau ngài păn pja̱c căn, pá tói tỉng xáu lu̱c báo, lu̱c báo tói tỉng xáu pá, mé tói tỉng xáu lu̱c slao, lu̱c slao tói tỉng xáu mé, me̱ da̱ tói tỉng xáu me̱ lù, me̱ lù tói tỉng xáu me̱ da̱.”<verse eid="LUK 12:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />Min te̱o cạ phang cần: “Hạy pi̱ noọng hăn xá phử dú bưửng slay, pi̱ noọng chứng chảng: ‘Fạ co̱i phân,’ do̱ chăn mì pìn nỉnh. <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />Nhằng chíu lầm nàm te̱o pa̱o, pi̱ noọng chảng cạ: ‘Fạ co̱i đét mảy,’ do̱ chăn mì pìn nỉnh. <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />Kí cần pjàng mja̱p ới! Pi̱ noọng chắc ngòi kí ha̱o cú tum, fạ, tọ hít lăng mí chắc făn khay slì tiỉm cà nạy? <verse eid="LUK 12:56" /><verse number="57" style="v" sid="LUK 12:57" />Hít lăng pi̱ noọng mí táng nẳm ngòi lo̱ lăng chư̱ chăn? <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />Vi̱ chíu pi̱ noọng pay đủi cần cáo làu thưng tói nả cần cai cuủn, do̱ lèo oóc slèng hít đay đủi hau tìng to̱i lo̱ pay, sle hau mí kẻo pi̱ noọng thưng ti̱ ứn chá, cần ứn chá chao hử cần pạư ngục xăng pi̱ noọng khảu ngục. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />Ngo̱ cạ pi̱ noọng, pi̱ noọng co̱i mí đảy oóc khói ngục, thưng slì pi̱ noọng păng thuủn mưn chèn sláy slít.”<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />Mì kỉ cần dú nỉnh, li̱n te̱o hử Chảu Giê-xu mà kí cần Ga-li-lê ngài Phi-lát khả, hít lưư̱t chào xăm sleng lình hau pài. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />Min hòi vàm hau: “Kí ké la̱i cạ kí cần Ga-li-lê nỉnh fa̱m xá lai quá mọi cần Ga-li-lê táng, vi̱ hau ngài chíp khỏ pìn nỉnh do̱ lừ? <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />Ngo̱ cạ kí ké, mí chư̱ đơ. Tọ hạy kí ké bó cho̱i xá, do̱ mọi cần xày ngài chii̱t thuủn pìn nỉnh. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />Do̱ va̱ xị slíp pét cần nỉnh, ngài các slung Si-lô-ê lụp lùng đé hau hai: Kí ké la̱i phít xá hau lai quá phít xá mọi cần dú slẻng Giê-ru-sa-lem do̱ lừ? <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />Ngo̱ cạ kí ké, mí chư̱. Tọ hạy kí ké bó cho̱i xá, do̱ co̱i ngài chii̱t thuủn pìn nỉnh.”<verse eid="LUK 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />Dá Min li̱n pỉ xì nảy: “Cần nưng chay co ngo̱a chang la̱y mác ít cú làu, ké mà xa tọ bó hăn co mì mác. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />Ké cạ cần chay mác ít: ‘Ni̱ nho̱m cà, tó đảy slam pi ngo̱ mà au mác ti̱ co ngo̱a nảy, tọ bó hăn mì mác. Lèo bác min pay, sle min hít tum va̱i đai hít lăng?’ <verse eid="LUK 13:7" /><verse number="8" style="v" sid="LUK 13:8" />Cần chay mác ít dăng lạo chảu: ‘Lạo chảu ới, cứ sle min dú pi nưng num, tẳng ngo̱ tào tum to̱i cúc dá đíng khún khảu. <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />Cay mư̱ lăng min co̱i pìn mác; nhằng hạy mí oóc mác, chảu co̱i bác pay!’”<verse eid="LUK 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />Chíu Chảu Giê-xu slon cạ dú chang lưừn ho̱i, khảu vằn Sa-bát, <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />nỉnh cà, mì cần ti̱ me̱ ngài slẳm khoăn to̱ slíp pét pi dá, hít hử lăng ngài kho lùng, mí dân dàu đảy. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />Chíu hăn da̱ nỉnh, Chảu Giê-xu dảo khảu xảư dá cạ: “Ni̱ ới, ni̱ tó đảy cháu khói khảy chíp dá.” <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />Min tặt mừ khửn da̱. Chích slì, da̱ dân dàu đảy, chứng tài slung Chảu Fạ. <verse eid="LUK 13:13" /><verse number="14" style="v" sid="LUK 13:14" />Tọ chíu cần cuủn lị lưừn ho̱i khửn heng cạ, vi̱ hăn Chảu Giê-xu da pi̱ng chang vằn Sa-bát, do̱ fát slíng chứng cạ phang cần: “Mì húc vằn lèo hít cung. Pìn nỉnh lèo mà chăn kí vằn nỉnh sle đảy da đay, tó mí chư̱ thưng khảu vằn Sa-bát.” <verse eid="LUK 13:14" /><verse number="15" style="v" sid="LUK 13:15" />Tọ Chảu Giê-xu hòi vàm ké: “Thìng pjàng mja̱p nỉnh ới! Bó chư̱ khảu vằn Sa-bát, mọi cần kí ké xày kẻ chưư̱c mò do̱ va̱ lừ cú làu khói lằng nhả, dá tái min pay kin nặm do̱ lừ? <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />Nhằng da̱ nảy, chăn chư̱ lu̱c slao cú Áp-ra-ham, ngài Sa-tan phúc slíp pét pi dá, min te̱o mí cẩn đảy kẻ chưư̱c oóc khói éc nảy khảu vằn Sa-bát do̱ lừ?” <verse eid="LUK 13:16" /><verse number="17" style="v" sid="LUK 13:17" />Chíu Min cạ kí vàm nỉnh, mọi cần tói tỉng Min xày nả nhẻn, nhằng tằng phang cần do̱ hun hỉ mà mọi lo̱ chăn pjòi Min tó hít.<verse eid="LUK 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />Pìn nỉnh, Chảu Giê-xu cạ: “Tum ti̱ Chảu Fạ hút xị lăng, ngo̱ co̱i au lăng sle pỉ đảy? <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />Tum ti̱ nỉnh hút xị múi fằn cát, hau au pay ván chang la̱y, min buút pìn co, dá nục fạ hít lằng tìng cáng.”<verse eid="LUK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />Min te̱o cạ: “Ngo̱ co̱i pỉ tum ti̱ Chảu Fạ đủi lăng? <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />Tum ti̱ nỉnh hút xị bư phù đảy cần ti̱ me̱ au chào khảu slam xạu bư, thưng slì bư fát khửn thuủn.”<verse eid="LUK 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />Chảu Giê-xu pay quá kí slẻng, kí bản, di̱ slon cạ di̱ lằm chă̱p pay thưng slẻng Giê-ru-sa-lem. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />Chíu nỉnh, mì cần dăng xáu Min: “Pái Chảu, chư̱ tan mì kỉ cần đảy cháu mí?” Min chứng cạ hau: <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />“Cứ oóc slèng sle pay khảu tu cặp, vi̱ ngo̱ cạ hử pi̱ noọng chắc, lai cần co̱i xa lo̱ khảu nỉnh tọ mí đảy. <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" />Chíu chảu lưừn tấn hắp tu khảu dá, pi̱ noọng chứng dân dú noo̱c hói tu, dăng cạ: ‘Pái Chảu, xo khay hử hung ngo̱.’ Lạo chảu co̱i hòi vàm: ‘Ngo̱ mí chắc kí cần ni̱ dú càư thưng đơ.’ <verse eid="LUK 13:25" /><verse number="26" style="v" sid="LUK 13:26" />Chíu nỉnh, pi̱ noọng co̱i dăng: ‘Hung ngo̱ tó kin tói nả chảu, dá chảu tó slon cạ hung ngo̱ dú kí kha lo̱.’ <verse eid="LUK 13:26" /><verse number="27" style="v" sid="LUK 13:27" />Tọ chảu lưừn co̱i cạ pi̱ noọng: ‘Ngo̱ mí chắc pi̱ noọng tứ càư thưng. Thói oóc khói ngo̱ khoái, kí cần hít dăm cung nỉnh ới!’ <verse eid="LUK 13:27" /><verse number="28" style="v" sid="LUK 13:28" />Chíu nỉnh, pi̱ noọng co̱i hăn ti̱ hảy hấm xáu cắt fằn. Áp-ra-ham, Y-sác, đủi Gia-cốp xáu tằng kí cần páo cón xày dú chang tum ti̱ Chảu Fạ, nhằng pi̱ noọng do̱ ngài vẻng oóc noo̱c. <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />Dá tứ tung, slay, nàm, pắc, hau co̱i mà nă̱ng kin sli̱c chang tum ti̱ Chảu Fạ. <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" />Chăn pìn nỉnh, mì kí cần sloót hang te̱o pìn ta̱i tàu, xáu kí cần ta̱i tàu te̱o pìn sloót hang.”<verse eid="LUK 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />Chăn tiỉm nỉnh, mì kỉ cần Pha-ri-si thưng xảư, chảng xáu Chảu Giê-xu: “Slay pay khói ti̱ nảy pay, vi̱ Hê-rốt slưửng khả slay cà.” <verse eid="LUK 13:31" /><verse number="32" style="v" sid="LUK 13:32" />Min hòi vàm hau: “Cứ pay cạ tu hin nỉnh: ‘Ngo̱ te̱p phi sla̱ da pi̱ng vằn nảy, vằn chục, thưng vằn ta̱i slam, ngo̱ co̱i hít thuủn mọi lo̱ cú ngo̱.’ <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />Tọ, vằn nảy, vằn chục, xáu vằn lừ ngo̱ lèo lằm chă̱p phjải pay, vi̱ cần páo cón do̱ mí đảy hai dú bưửng noo̱c slẻng Giê-ru-sa-lem. <verse eid="LUK 13:33" /><verse number="34" style="v" sid="LUK 13:34" />Giê-ru-sa-lem, Giê-ru-sa-lem ới, mưng khả kí cần páo cón xáu bẳn hin kí cần đảy xoi mà đủi làu! Chắc kỉ lai pày ngo̱ ái tom kí lu̱c mưng xị cáy me̱ cúc cáy lu̱c khảu, sle phòm tảư pích tọ hung mưng te̱o mí ái. <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />Ne̱, lưừn cú hung mưng co̱i ngài tả đai. Cau cạ hung mưng, hung mưng co̱i mí nhằng hăn cau thưng slì hung mưng chảng: ‘Fúc hử Lạo au mình Chảu mà thưng.’”<verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />Khảu vằn Sa-bát, Chảu Giê-xu khảu lưừn cần căm tàu fưừng Pha-ri-si kin, hau chứng pắc pí kem Min. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />nỉnh cà, mì cần nưng pìn fù dú tói nả Min. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />Chảu Giê-xu chảng đủi kí cần thung slụ luật fáp xáu cần Pha-ri-si, cạ: “Đảy fép da pi̱ng khảu vằn Sa-bát mí?” <verse eid="LUK 14:3" /><verse number="4" style="v" sid="LUK 14:4" />Tọ hau xày ti̱ng xích. Da Min tài au cần pi̱ng khửn, da đay dá hử pay mừ. <verse eid="LUK 14:4" /><verse number="5" style="v" sid="LUK 14:5" />Min cạ hau: “Cần nàư chang kí ké mì ò lu̱c do̱ va̱ tu mò lụp lùng bó chang vằn Sa-bát, te̱o mí chích slì kẻo min khửn mí?” <verse eid="LUK 14:5" /><verse number="6" style="v" sid="LUK 14:6" />Hau mí hòi vàm đảy.<verse eid="LUK 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />Min li̱n hử hau pỉ xì nưng, vi̱ hăn thuủn kí cần đảy xỉnh xày ái nă̱ng ti̱ đảy ha nả, chứng cạ hau: <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" />“Slì kí ké đảy hau xỉnh pay kin sli̱c lảu, mí đảy nă̱ng ti̱ đảy ha nả, lao chang kí khéc đảy xỉnh thưng te̱o mì cần hẳm cẩn díu quá kí cần ni̱, <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />chíu cần xỉnh kí cần ni̱ xáu kí cần táng thưng, cạ ni̱: ‘Lèo nhưư̱ng ti̱ hử cần nảy nă̱ng,’ do̱ kí ké co̱i ngài nả nhẻn vi̱ lèo lùng nă̱ng ti̱ sloót hang. <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />Tọ, chíu kí ké đảy xỉnh, cứ nă̱ng ti̱ xoòng sloót hang, sle slì chảu sli̱c thưng cạ kí ké: ‘Pàng dạu ới, cứ nă̱ng khửn ti̱ hẳm slung’. Do̱ chíu nỉnh kí ké co̱i đảy ha nả tói nả kí cần nă̱ng xày xoòng đủi làu. <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" />Vi̱ cần nàư táng tài làu khửn, co̱i ngài au lùng, nhằng cần nàư táng tặt làu lùng co̱i đảy tài khửn slung.”<verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />Min xày cạ chảu sli̱c: “Hạy ni̱ ta̱i kin tón ngài do̱ va̱ tón pjàu, mí đảy xỉnh pàng dạu, pi̱ noọng, do̱ va̱ bản co̱n fát xài, lao hau xày xỉnh te̱o sle păng fúc hử ni̱. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />Tọ, chíu ni̱ ta̱i sli̱c, cứ xỉnh kí cần khỏ khát, phú slưứng, què tắc, fàng bót, <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />do̱ ni̱ chứng đảy fúc, vi̱ hau mí mì lăng păng hử ni̱. Ni̱ co̱i đảy păng te̱o chang vằn cần cung chính hòi te̱o.”<verse eid="LUK 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />Cần nưng nă̱ng xày xoòng đủi Chảu Giê-xu ti̱ng kí lo̱ nảy, do̱ dăng xáu Min: “Fúc hử cần nàư đảy kin pẻng chang tum ti̱ Chảu Fạ!” <verse eid="LUK 14:15" /><verse number="16" style="v" sid="LUK 14:16" />Tọ Min hòi vàm ké: “Mì cần nưng tọn sli̱c cải, xỉnh lai cần mà kin. <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />Thưng slì kin, ké xoi cần khỏi pay chảng đủi kí cần đảy xỉnh cạ: ‘Cứ mà, mọi lo̱ tó ính xình dá.’ <verse eid="LUK 14:17" /><verse number="18" style="v" sid="LUK 14:18" />Tọ thuủn mọi cần xày xa lo̱ mí thưng. Cần ta̱i ít chảng: ‘Ngo̱ slự la̱ư nà nưng, lèo pay ngòi. Xo hử ngo̱ mí thưng.’ <verse eid="LUK 14:18" /><verse number="19" style="v" sid="LUK 14:19" />Cần táng chảng: ‘Ngo̱ slự hả tói mò, lèo pay nho̱m min slèng mí. Xo hử ngo̱ mí thưng.’ <verse eid="LUK 14:19" /><verse number="20" style="v" sid="LUK 14:20" />Cần táng num chảng: ‘Ngo̱ ngám au me̱, pìn nỉnh, ngo̱ mí pay đảy.’ <verse eid="LUK 14:20" /><verse number="21" style="v" sid="LUK 14:21" />Cần khỏi fan mừ, li̱n te̱o kí lo̱ nỉnh hử chảu làu. Lạo chảu fát slíng, cạ cần khỏi: ‘Cứ pay oóc noo̱c kha lo̱ xáu kí tèo lo̱ đưng slẻng, tái kí cần khỏ khát, phú slưứng, fàng bót xáu què tắc mà nảy khoái.’ <verse eid="LUK 14:21" /><verse number="22" style="v" sid="LUK 14:22" />Cần khỏi te̱o chảng: ‘Lạo chảu ới, ngo̱ tó hít vàm chảu slắng dá, tọ di̱ nhằng ti̱ váng.’ <verse eid="LUK 14:22" /><verse number="23" style="v" sid="LUK 14:23" />Chảu lưừn te̱o cạ cần khỏi: ‘Cứ oóc noo̱c kha lo̱ xáu to̱i kha lị xỉnh hau khảu nảy hử tim lưừn ngo̱. <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />Vi̱ ngo̱ cạ ni̱, bó mì slắc cần chang kí cần tó đảy xỉnh cón nỉnh, đảy kin tón kin cú ngo̱.’”<verse eid="LUK 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />Chíu nỉnh, mì phang cần đung tò pay đủi Chảu Giê-xu; Min váy te̱o cạ hau: <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" />“Hạy cần nàư mà nèm ngo̱ te̱o mí slim xằng pá mé, me̱ lu̱c, pi̱ noọng slao báo làu, xáu chăn mi̱ng te̱o làu num, do̱ mí pìn cần nèm slon ngo̱ đảy. <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" />Cần nàư mí béc mạy các khoáy làu pay nèm ngo̱, do̱ xày mí hít cần nèm slon ngo̱ đảy. <verse eid="LUK 14:27" /><verse number="28" style="v" sid="LUK 14:28" />Vi̱ mì cần nàư chang pi̱ noọng ái xáy ăn các slung, te̱o mí cay ngòi thuủn kỉ lai chèn, sle chắc làu mì đo chèn hít thuủn đảy mí? <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />Hạy mí, slì tó tặt ti̱ choóc dá te̱o mí hít thuủn đảy, do̱ mọi cần hăn, co̱i khu slủm min, <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />chảng cạ: ‘Cần nảy khay cung xáy lưừn te̱o mí hít thuủn đảy!’ <verse eid="LUK 14:30" /><verse number="31" style="v" sid="LUK 14:31" />Do̱ va̱ mì huùng haư, ái pay oóc chă̱n tò cọn huùng táng, te̱o mí nă̱ng lùng xùm xưừng cón, ngòi làu tái slíp xiin lỉnh pay, do̱ tói tỉng đảy huùng mì nhi̱ slíp xiin lỉnh mí? <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />Hạy mí đảy, slì huùng nỉnh nhằng dú quay do̱ huùng xoi cần tang nả pay xo pình lình. <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />Pìn nỉnh, hạy cần nàư chang pi̱ noọng bó tả mọi lo̱ làu mì, do̱ mí hít cần nèm slon ngo̱ đảy. <verse eid="LUK 14:33" /><verse number="34" style="v" sid="LUK 14:34" />Cư chăn chư̱ đay, tọ hạy cư mí nhằng kìm, do̱ hít lừ sle min kìm te̱o đảy? <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />Cư nỉnh mí ván lùng tum do̱ va̱ chào khún đảy. Hau lèo vẻng min oóc noo̱c. Cần nàư mì xu sle ti̱ng, lèo ti̱ng.”<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />Chíu nỉnh, kí cần slau slé xáu cần phít xá xày thưng xảư Chảu Giê-xu sle ti̱ng Min slon cạ. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />Dá, tằng cần Pha-ri-si xáu kí slay slon luật fáp hài ha̱c cạ: “Cần nảy chiíp tỏn kí cần phít xá xáu xày kin đủi hau.”<verse eid="LUK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3" />Min chứng li̱n hử hau pỉ xì nảy: <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" />“Mì cần nàư chang kí ké mì pác tu chiin, hạy túc pay tu nưng, te̱o mí sle cảu slíp cảu tu nỉnh dú tu̱ng quẹng dá pay xa thưng đảy hăn tu chiin ngài túc mí? <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />Chíu xa đảy hăn dá, cần nỉnh hun hỉ béc min khửn bá. <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />Chíu mà thưng lưừn, cần nỉnh dảo kí pàng dạu xáu bản co̱n thưng dá cạ: ‘Cứ ta̱i cha hun hỉ đủi ngo̱, vi̱ ngo̱ tó xa đảy tu chiin ngài túc pay dá.’ <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />Xày pìn nỉnh, ngo̱ cạ pi̱ noọng, tìng fạ co̱i hun hỉ mà cần phít xá nhă̱n cho̱i xá quá cảu slíp cảu cần cung chính mí cẩn cho̱i xá.<verse eid="LUK 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />Do̱ va̱ mì cần ti̱ me̱ càư mì slíp mưn ngừn, hạy túc mưn nưng te̱o mí tẻm tưng, quét lưừn sle xa thưng đảy mí? <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />Chíu xa đảy hăn, min dảo kí pàng dạu xáu kí cần chang bản co̱n thưng, chảng: ‘Cứ ta̱i cha hun hỉ xáu ngo̱, vi̱ ngo̱ tó xa đảy mưn ngừn ngài túc dá.’ <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />Xày pìn nỉnh, ngo̱ cạ kí ké, kí cần tang nả Chảu Fạ co̱i hun hỉ mà cần phít xá nưng nhă̱n cho̱i xá.”<verse eid="LUK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />Túc lăng, Min te̱o cạ: “Ké nưng mì sloong ò lu̱c báo, <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />ò noọng chảng đủi pá: ‘Pá ới, xo hử lu̱c fă̱n cha xài slục mà lu̱c.’ Dá ké chứng păn cha xài hử sloong ò lu̱c. <verse eid="LUK 15:12" /><verse number="13" style="v" sid="LUK 15:13" />Xằng đảy kỉ lai vằn, ò noọng hom thuủn cú cái dá pay thưng ti̱ quay; dú nỉnh, min kin du̱ng pjuúng pjúi, slái va̱i thuủn fă̱n cha xài cú làu. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />Thưng slì min kin du̱ng thuủn cú cái dá, to̱i ti̱ nỉnh mì na̱n dác kin cải, min chứng khảu lo̱ slỉu khát. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />Dá min lèo pay hít có hử cần dú nỉnh, min ngài lạo chảu xoi oóc tu̱ng khun mu. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />Min tan mu̱ng đảy kin năng thú sle hử mu sle khói dác, tọ bó cần nàư hử. <verse eid="LUK 15:16" /><verse number="17" style="v" sid="LUK 15:17" />Chíu nỉnh min chứng lặc nẳm, cạ: ‘Chắc kỉ lai cần hít khỏi hử pá làu nhằng đảy cú kin ím đo, làu dú nảy te̱o lèo hai dác! <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />Làu lèo tấn dân, fan mà xáu dăng đủi pá, chảng cạ: “Pá ới, lu̱c tó fa̱m xá đủi fạ đủi pá. <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />Lu̱c bó nhằng ngám đảy dảo hít lu̱c cú pá dá. Xo pá ngòi lu̱c xị cạ cần hít khỏi cú pá tó đảy.”’ <verse eid="LUK 15:19" /><verse number="20" style="v" sid="LUK 15:20" />Pìn nỉnh, min chứng tấn dân, fan mà đủi pá. Tọ slì nhằng dú ti̱ quay, pá hăn min do̱ điíp sliít, le̱n oóc cót cò, chúp au ò lu̱c. <verse eid="LUK 15:20" /><verse number="21" style="v" sid="LUK 15:21" />Chíu nỉnh, ò lu̱c chảng cạ: ‘Pá ới, lu̱c chăn fa̱m xá đủi fạ đủi pá. Lu̱c bó nhằng ngám đảy dảo hít lu̱c cú pá dá.’ <verse eid="LUK 15:21" /><verse number="22" style="v" sid="LUK 15:22" />Tọ cần pá cạ kí cần khỏi: ‘Au cùng slử hẳm đay nu̱ng hử min, thư pjoóc khảu mừ, nu̱ng cài khảu kha khoái. <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />Cứ cặp tu mò nhe bẻo khả hít nự, sle hung làu ta̱i cha kin hun hỉ đủi căn. <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />Vi̱ ò lu̱c nảy cú ngo̱ hai dá cà nạy hòi te̱o, tó túc dá cà nạy te̱o xa đảy.’ Dá hau kin hun hỉ đủi căn. <verse eid="LUK 15:24" /><verse number="25" style="v" sid="LUK 15:25" />Mư̱ nỉnh, ò lu̱c báo tàu cú ké dú noo̱c tu̱ng, chíu mà xảư thưng lưừn, đảy nghìn xưứng hí dét mủ. <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />Chứng dảo cần khỏi, sle tham ngòi mì ca lăng. <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />Cần khỏi dăng cạ: ‘Noọng báo ni̱ tó fan mà, dá pá ni̱ chứng khả tu mò nhe bẻo, vi̱ ké hăn noọng cú ni̱ mà lưừn đảy pình an mọi lo̱.’ <verse eid="LUK 15:27" /><verse number="28" style="v" sid="LUK 15:28" />Tọ ò lu̱c báo tàu fát slíng, mí slém khảu lưừn, cần pá lèo oóc pay slon cạ min. <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />Tọ, báo nỉnh hòi vàm pá: ‘Pá ngòi, lu̱c cung ta̱i pá tó kỉ lai pi, xằng hít pắn lịng pá slắc pày, pá nhằng xằng hử lu̱c tu bẻ haư, sle ta̱i cha kin hun hỉ xáu pàng dạu lu̱c, <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />nhằng ò lu̱c nỉnh cú pá, min tó slái va̱i cha xài cú pá hử kí slao eo, do̱ pá te̱o khả mò nhe bẻo kin hun hỉ hử min.’ <verse eid="LUK 15:30" /><verse number="31" style="v" sid="LUK 15:31" />Cần pá hòi vàm: ‘Lu̱c ới, slì haư lu̱c xày dú đủi pá, thuủn cha xài cú pá xày chư̱ cú lu̱c. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />Tọ làu lèo tọn xoòng kin hun hỉ, vi̱ ò noọng lu̱c tó hai dá cà nạy te̱o hòi, túc dá cà nạy te̱o xa hăn.’”<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />Chảu Giê-xu te̱o cạ kí cần nèm slon: “Cần fát xài nỉnh mì cần cuủn cha xài nưng ngài cáo tó hít slái va̱i cha xài cú chảu lưừn. <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />Pìn nỉnh, chảu dảo báo nỉnh mà xáu cạ: ‘Ngo̱ đảy nghìn hau cáo ni̱ mà lo̱ lăng è? Ni̱ lèo făn khay mà cung sla̱y cú ni̱ pay, vi̱ ni̱ mí đảy cuủn cha xài dá!’ <verse eid="LUK 16:2" /><verse number="3" style="v" sid="LUK 16:3" />Cần cuủn lưừn táng lặc nẳm: ‘Chảu lưừn mí hử làu cuủn cha xài dá, làu co̱i hít lăng? Cuúc tum do̱ làu mí đo slèng, nhằng pay kin xo do̱ xảu nả. <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />Làu chắc lèo hít lăng sle slì mí đảy cuủn lưừn nảy dá, hau co̱i chiíp làu khảu lưừn.’ <verse eid="LUK 16:4" /><verse number="5" style="v" sid="LUK 16:5" />Pìn nỉnh, báo nỉnh dảo pày pìn pày kí cần slỉu nỉ cú chảu lưừn thưng, dá cạ cần ta̱i ít: ‘Ni̱ slỉu nỉ chảu ngo̱ kỉ lai?’ <verse eid="LUK 16:5" /><verse number="6" style="v" sid="LUK 16:6" />Cần nỉnh cạ: ‘Pác thủng dù ô-liu nưng.’ Cần cuủn cha xài chứng cạ min: ‘Căm baư chỉ nỉ khoái, nă̱ng lùng slẻ, slỉu hả xục!’ <verse eid="LUK 16:6" /><verse number="7" style="v" sid="LUK 16:7" />Dá báo nỉnh cạ cần ta̱i nhi̱: ‘Nhằng ni̱ slỉu nỉ kỉ lai?’ Cần nỉnh hòi vàm: ‘Pác pao khảu me̱c va nưng.’ Cần cuủn cha xài cạ: ‘Căm au baư chỉ nỉ slẻ, slỉu pét xục.’ <verse eid="LUK 16:7" /><verse number="8" style="v" sid="LUK 16:8" />Lạo chảu că̱n cần cuủn cha xài mí chăn chính vi̱ chắc hít quai quẳm. Vi̱ kí lu̱c lan cú tơ̱i nảy hẳm quai quẳm quá kí lu̱c lan cú áng slu̱ng xày xám cần đủi hung min. <verse eid="LUK 16:8" /><verse number="9" style="v" sid="LUK 16:9" />Nhằng ngo̱ cạ kí pi̱ noọng, lèo au chèn cú dăm cung hít pàng dạu, sle chíu thuủn chèn nỉnh dá, hau co̱i chiíp kí pi̱ noọng khảu lưừn tơ̱i tơ̱i. <verse eid="LUK 16:9" /><verse number="10" style="v" sid="LUK 16:10" />Cần nàư slim đeo chang lo̱ sláy ta̱i ít xày slim đeo chang lo̱ cải, cần nàư dăm cung chang lo̱ sláy ta̱i ít xày dăm cung chang lo̱ cải. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />Pìn nỉnh, hạy kí pi̱ noọng mí slim đeo mà cú cái dăm cung, do̱ cần nàư co̱i chao hử kí pi̱ noọng cú cái chăn? <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />Hạy kí pi̱ noọng mí slim đeo mà cú cái cần táng, do̱ cần nàư co̱i chao hử kí pi̱ noọng cú cái cú tan kí pi̱ noọng? <verse eid="LUK 16:12" /><verse number="13" style="v" sid="LUK 16:13" />Mí cần khỏi haư cung ta̱i sloong chảu đảy, vi̱ co̱i slim xằng chảu nảy te̱o điíp chảu nỉnh, do̱ va̱ kiíng chu̱ng chảu nảy tọ ngòi che̱n chảu nỉnh. Pi̱ noọng mí di̱ cung ta̱i Chảu Fạ te̱o di̱ cung ta̱i ngừn chèn đảy.”<verse eid="LUK 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />Chíu nỉnh, cần Pha-ri-si chăn chư̱ kí cần thám ngừn chèn, ti̱ng kí vàm nỉnh do̱ khu slủm Min. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />Min cạ hau: “Kí ké hít xị cần cung chính tói nả hau, tọ Chảu Fạ chắc slim kí ké. Vi̱ lo̱ hau ngòi pèng te̱o chăn chư̱ lằm xì tói nả Chảu Fạ. <verse eid="LUK 16:15" /><verse number="16" style="v" sid="LUK 16:16" />Luật fáp xáu kí vàm páo cón mì thưng tơ̱i cú Giăng. Tứ nỉnh tò pay, tum ti̱ Chảu Fạ đảy páo oóc xáu mọi cần oóc slèng sle khảu nỉnh. <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" />Chăn, tum fạ quá pay nhằng hẳm nga̱i quá ma̱t chi̱ nưng chang luật fáp.<verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />Cần nàư lư me̱ sle au cần đai do̱ fa̱m xá pay chụ, nhằng cần nàư au cần ti̱ me̱ ngài po̱ lư do̱ xày fa̱m xá pay chụ.<verse eid="LUK 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />Mì cần fát xài nưng, nu̱ng slử đeng xáu slử phải pán lưứn, vằn vằn kin sli̱c fí fái. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />Te̱o mì cần khỏ mìng hít La-xa-rơ, đúc đang pìn dan tim khít, hau tặt dú pác tu lưừn cần fát xài, <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />tan mu̱ng đảy kin kí ám lút tìng xoòng cần fát xài lùng. Xày mì kỉ tu ma thưng lì khít cú min num. <verse eid="LUK 16:21" /><verse number="22" style="v" sid="LUK 16:22" />Cần khỏ hai, đảy cần tang nả fạ au tặt khảu pàu Áp-ra-ham. Dá cần fát xài xày hai xáu hau au min pay phăng. <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />Cần fát xài dú ti̱ dăm, ngài chíp đát, slè ha khửn, hăn Áp-ra-ham tứ ti̱ quay, xáu La-xa-rơ dú chang pàu Áp-ra-ham. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />Cần fát xài moòng khửn: ‘Cúc chỏ Áp-ra-ham ới, xo điíp sliít lu̱c, xoi La-xa-rơ au hu nịu mừ dụp khảu nặm hít lưừng lịn lu̱c, vi̱ lu̱c dú chang fày nảy khỏ lai.’ <verse eid="LUK 16:24" /><verse number="25" style="v" sid="LUK 16:25" />Tọ Áp-ra-ham hòi vàm: ‘Lu̱c ới, lèo chứ chíu nhằng te̱o, lu̱c tó đảy táp kí dưư̱ng đay dá, nhằng La-xa-rơ lèo tảy khỏ lai. Cà nạy, min dú nảy đảy an chi, nhằng lu̱c lèo ngài chíp khỏ. <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />Te̱o nhằng mì vằng đắc nưng cải păn ti̱ hung cau xáu ti̱ lu̱c, thưng slặn cần nàư mu̱ng tứ nảy quá ti̱ lu̱c tó mí đảy, cần nàư mu̱ng tứ ti̱ lu̱c quá ti̱ hung cau xày mí đảy.’ <verse eid="LUK 16:26" /><verse number="27" style="v" sid="LUK 16:27" />Cần fát xài te̱o chảng: ‘Cúc chỏ ới, pìn nỉnh do̱ xo xoi La-xa-rơ thưng lưừn pá lu̱c — <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />vi̱ lu̱c nhằng mì hả pi̱ noọng — sle báo nỉnh quáy hau, lao hau xày lèo ngài lùng ti̱ chíp khỏ nảy.’ <verse eid="LUK 16:28" /><verse number="29" style="v" sid="LUK 16:29" />Tọ Áp-ra-ham hòi vàm: ‘Hau mì Môi-se xáu kí cần páo cón dá; hau lèo ti̱ng kí cần nỉnh!’ <verse eid="LUK 16:29" /><verse number="30" style="v" sid="LUK 16:30" />Cần fát xài te̱o chảng: ‘Hau mí ti̱ng đơ, cúc chỏ Áp-ra-ham ới, hạy mì cần hai hòi te̱o mà xáu hau, do̱ hau co̱i cho̱i xá.’ <verse eid="LUK 16:30" /><verse number="31" style="v" sid="LUK 16:31" />Áp-ra-ham hòi vàm: ‘Hạy hau mí slém ti̱ng Môi-se xáu kí cần páo cón, do̱ ma̱i cạ cần hai hòi te̱o, hau xày mí slấn đơ.’”<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />Chảu Giê-xu cạ kí cần nèm slon: “Hít lừ te̱o mí mì kí lo̱ hít hử toỏng lụp, tọ slói tháy hử cần nàư hít oóc lo̱ nỉnh! <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />Nhă̱n phúc chục hin khảu cò cần nỉnh dá vẻng lùng hải nhằng đay quá sle min hít hử cần nưng chang kí tu đích nảy fa̱m xá. <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" />Kí pi̱ noọng lèo slỉu slim! Hạy pi̱ noọng làu fa̱m xá, do̱ lèo quáy; hạy hau cho̱i xá, do̱ lèo sla dưư̱ng hử. <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />Ma̱i cạ cần nỉnh fa̱m phít xá đủi pi̱ noọng chất pày, xáu chất pày fan te̱o đủi pi̱ noọng cạ: ‘Ngo̱ cho̱i xá’ do̱ pi̱ noọng xày lèo sla dưư̱ng hử cần nỉnh.”<verse eid="LUK 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />Kí cần đảy xoi pay dăng Chảu: “Xo hử hung ngo̱ slim slấn num.” <verse eid="LUK 17:5" /><verse number="6" style="v" sid="LUK 17:6" />Chảu chứng cạ: “Hạy pi̱ noọng mì slim slấn tùng múi fằn cát nưng, do̱ hạy pi̱ noọng cạ co mọn nảy: ‘Mưng lèo ngài lúc khửn dá te̱o chay tảư hải’ do̱ min co̱i ti̱ng vàm pi̱ noọng. <verse eid="LUK 17:6" /><verse number="7" style="v" sid="LUK 17:7" />Cần nàư chang pi̱ noọng mì cần khỏi pay thay nà, do̱ va̱ pay hen chiin, chíu min ngám dú noo̱c tu̱ng mà cạ: ‘Mà nảy nă̱ng khảu xoòng kin pay!’ <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />Tọ, bó chư̱ lạo chảu cạ min: ‘Tọn hử ngo̱ kin, hảng lăng slử cung ta̱i ngo̱, thưng slì ngo̱ kin, dá ni̱ chứng đảy kin’ do̱ lừ? <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />Cần khỏi ti̱ng vàm slắng, do̱ chảu lưừn lèo sleng slu̱ min, chư̱ mí? <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />Pi̱ noọng xày pìn nỉnh, slì hít thuủn mọi lo̱ đảy lịng lèo hít, do̱ cứ chảng: ‘Hung ngo̱ pìn kí cần khỏi mí hít đảy lăng. Hung ngo̱ tó hít kí lo̱ hung ngo̱ lèo hít xày.’”<verse eid="LUK 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />Chíu tìng lo̱ pay thưng slẻng Giê-ru-sa-lem, Chảu Giê-xu pay khoang quá chái chang Sa-ma-ri xáu Ga-li-lê. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />Chíu khảu slẻng nỉnh, mì slíp cần hảu mà tỏn Min, tọ hau dân dú ti̱ quay <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />dá hau cạ: “Chảu Giê-xu ới, xo điíp hung ngo̱ đủi!” <verse eid="LUK 17:13" /><verse number="14" style="v" sid="LUK 17:14" />Chíu hăn hau, Min cạ: “Cứ pay oóc tói nả kí slay pài xoòng.” Chíu hau pay, do̱ hau đảy đay. <verse eid="LUK 17:14" /><verse number="15" style="v" sid="LUK 17:15" />Mì cần nưng chang hau, chíu hăn làu tó đảy da đay liìn fan te̱o, khửn heng tài slung Chảu Fạ. <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />Báo nỉnh mà pái lùng tảư kha Chảu Giê-xu sle sleng slu̱ Min. Cần nỉnh chăn chư̱ cần Sa-ma-ri. <verse eid="LUK 17:16" /><verse number="17" style="v" sid="LUK 17:17" />Chảu Giê-xu cạ: “Bó chư̱ slíp cần tó đảy slaư thuủn do̱ lừ? Nhằng cảu cần nỉnh dú càư? <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />Hít lăng bó hăn slắc cần fan te̱o tài slung Chảu Fạ, tan mì cần cú tum ti̱ táng nảy xày?” <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />Dá Min cạ cần nỉnh: “Cứ tấn dân xáu pay. Slim slấn ni̱ tó da đay ni̱ dá.”<verse eid="LUK 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />Chíu cần Pha-ri-si tham, mư̱ haư tum ti̱ Chảu Fạ chứng thưng, Min hòi vàm: “Tum ti̱ Chảu Fạ mí thưng xị ca lăng nho̱m hăn đảy. <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />Hau co̱i mí chảng: ‘Nho̱m cà, dú nảy!’ do̱ va̱ ‘Dú nỉnh!’ Vi̱ tum ti̱ Chảu Fạ cà này dú bưửng đưng kí ké.”<verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />Min te̱o cạ kí cần nèm slon: “Co̱i mì vằn pi̱ noọng mu̱ng tẳng đảy hăn vằn nưng chang kí vằn cú Lu̱c Cú Cần tọ mí hăn đảy. <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />Hau co̱i cạ pi̱ noọng: ‘Min dú nỉng’ do̱ va̱ ‘Min dú nảy!’ Do̱ mí đảy pay, mí đảy le̱n pay nèm hau, <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />vi̱ xị me̱p slu̱ng tứ fuung fạ nảy thưng fuung fạ nỉnh, do̱ Lu̱c Cú Cần chang vằn Min thưng xày pìn nỉnh. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />Tọ ta̱i tàu, Min lèo tảy chíp đát lai xáu ngài xám cần nảy thoi ngài. <verse eid="LUK 17:25" /><verse number="26" style="v" sid="LUK 17:26" />Xị chang tơ̱i Nô-ê pìn lừ, do̱ chang tơ̱i Lu̱c Cú Cần xày pìn nỉnh. <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />Hau kin, au me̱, au po̱, thưng vằn Nô-ê khảu fỏ xiìn, dá nặm noòng fư̱t khửn khả chii̱t thuủn mọi lo̱. <verse eid="LUK 17:27" /><verse number="28" style="v" sid="LUK 17:28" />Tơ̱i cú Lót xày pìn nỉnh, hau kin, khai, slự, chay ván, xáy tằng, <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />tọ thưng vằn Lót oóc khói Sô-đôm, do̱ hít fạ phân fày xáu diim slinh cháng lùng, khả chii̱t thuủn mọi lo̱. <verse eid="LUK 17:29" /><verse number="30" style="v" sid="LUK 17:30" />Thưng vằn Lu̱c Cú Cần oóc nả xày pìn nỉnh. <verse eid="LUK 17:30" /><verse number="31" style="v" sid="LUK 17:31" />Chang vằn nỉnh, cần nàư dú tìng pài lưừn mì cú cái đưng lưừn, do̱ mí đảy lùng au; xày pìn nỉnh, cần nàư dú noo̱c tu̱ng do̱ mí đảy fan mừ lưừn. <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />Lèo chứ te̱o me̱ cú Lót. <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" />Cần nàư xa lo̱ cháu mi̱ng te̱o làu, do̱ co̱i túc, nhằng hạy cần nàư túc mi̱ng te̱o làu co̱i đảy te̱o. <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />Ngo̱ cạ kí pi̱ noọng, chang că̱m nỉnh, sloong cần nòn tò xày slàng nưng. Cần nưng co̱i đảy au pay, nhằng cần nỉnh ngài tả te̱o. <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />Sloong cần tò xày mu̱ chục dú ti̱ đeo. Cần nưng co̱i đảy au pay, nhằng cần nỉnh ngài tả te̱o.” <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />[Sloong cần dú noo̱c tu̱ng, cần nưng co̱i đảy au pay, nhằng cần nỉnh ngài tả te̱o.] <verse eid="LUK 17:36" /><verse number="37" style="v" sid="LUK 17:37" />Kí cần nèm slon dăng Min: “Chảu ới, dú càư è?” Min hòi vàm: “Chạp hai dú càư, do̱ nục lă̱m xày tom thưng nỉnh.”<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />Chảu Giê-xu li̱n hử cần nèm slon pỉ xì nưng, sle hau hăn cẩn lèo slưừng slì xỉnh chàu, mí đảy nái slim, <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />cạ: “Dú slẻng nỉnh, mì quan ứn chá nưng, mí kiíng lao Chảu Fạ, xày mí ngòi ha nả cần nàư chạy. <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />Đưng slẻng nỉnh xày mì me̱ mải cứ mà xo quan ứn chá, cạ: ‘Xo ứn chá cung lị hử ngo̱, sle tỉng te̱o cần tói tàu ngo̱.’ <verse eid="LUK 18:3" /><verse number="4" style="v" sid="LUK 18:4" />Quan ứn chá thoi ngài sla̱o nưng, tọ túc lăng, ké lặc nẳm: ‘Ma̱i cạ làu bó lao Chảu Fạ xày bó dưư̱ng nả slắc cần, <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />tọ vi̱ me̱ mải nảy cảo na̱o lai, làu chứng co̱i ứn chá cung phình hử da̱, mí do̱ da̱ te̱o mà hít fàn làu mại.’” <verse eid="LUK 18:5" /><verse number="6" style="v" sid="LUK 18:6" />Chảu cạ: “Ti̱ng vàm quan ứn chá mí chăn chính nỉnh chảng cà. <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />Pìn nỉnh, Chảu Fạ te̱o bó ứn chá cung phình hử kí cần đảy Min lưư̱c, chư̱ kí cần vằn li̱n khừn xo Min, Min te̱o pắt hau lèo tẳng mại do̱ lừ? <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />Ngo̱ cạ kí pi̱ noọng, Min co̱i ứn chá cung phình hử hau khoái xày. Tọ, chíu Lu̱c Cú Cần thưng, do̱ Min nhằng hăn slim slấn tìng tum mí?”<verse eid="LUK 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />Chảu Giê-xu te̱o li̱n pỉ xì nảy hử kỉ cần táng cạ làu cung chính te̱o ngòi che̱n kí cần đai: <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />“Mì sloong cần khửn lưừn slớ xỉnh chàu — cần Pha-ri-si nưng, nhằng cần nỉnh do̱ hít slau slé. <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" />Cần Pha-ri-si tấn dân, táng xỉnh chàu pìn nảy: ‘Pái Chảu Fạ, lu̱c sleng slu̱ Chảu, vi̱ lu̱c mí chư̱ xị kí cần táng — thám cò, dăm cung, pay chụ — xày mí chư̱ xị cần slau slé nảy. <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />Cứ chất vằn lu̱c te̱o căm kin sloong pày. Lu̱c no̱p đo fă̱n slíp mà mọi lo̱ xa đảy.’ <verse eid="LUK 18:12" /><verse number="13" style="v" sid="LUK 18:13" />Tọ cần slau slé dân dú hả lai quay, nhằng mí cảm slè ha khửn fạ, tan túp ức, dăng: ‘Pái Chảu Fạ, xo điíp sliít lu̱c, vi̱ lu̱c fa̱m phít xá!’ <verse eid="LUK 18:13" /><verse number="14" style="v" sid="LUK 18:14" />Ngo̱ cạ pi̱ noọng, cần nảy fan mừ lưừn làu do̱ đảy dảo cung chính, tó mí chư̱ cần nỉnh, vi̱ cần nàư táng tài làu khửn co̱i ngài au lùng, nhằng cần nàư táng tặt làu lùng co̱i đảy tài khửn.”<verse eid="LUK 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />Hau xày tái kí tu đích mà đủi Chảu Giê-xu sle Min tu̱ng khảu boong min, tọ chíu hăn pìn nỉnh, kí cần nèm slon quáy kí cần tái mà. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />Tọ Chảu Giê-xu dảo hau thưng, dá cạ: “Lèo au kí tu đích mà đủi ngo̱, mí đảy căm boong min. Vi̱ tum ti̱ Chảu Fạ slục mà kí cần hút xị kí tu đích nỉnh. <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />Chăn, ngo̱ cạ kí pi̱ noọng, hạy cần nàư mí tỏn au tum ti̱ Chảu Fạ xị tu đích nưng, do̱ cần nỉnh co̱i bó khảu nỉnh đảy.”<verse eid="LUK 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />Mì lạo quan nưng tham Chảu Giê-xu, cạ: “Slay slim đay ới, ngo̱ lèo hít lăng sle đảy te̱o tơ̱i tơ̱i?” <verse eid="LUK 18:18" /><verse number="19" style="v" sid="LUK 18:19" />Min hòi vàm cần nỉnh: “Hít lừ ni̱ cạ ngo̱ slim đay? Bó mì cần nàư slim đay chạy, tan Chảu Fạ slim đay xày. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />Cay ni̱ tó chắc kí vàm slon cạ — mí đảy fa̱m xá pay chụ, mí đảy khả cần, mí đảy lặc cưứp, mí đảy hít chửng pjàng, lèo ngòi đay pá mé.” <verse eid="LUK 18:20" /><verse number="21" style="v" sid="LUK 18:21" />Tọ báo nỉnh dăng: “Ngo̱ tó hít nèm thuủn mọi lo̱ nảy tứ slì nhằng báo ón dá.” <verse eid="LUK 18:21" /><verse number="22" style="v" sid="LUK 18:22" />Tọ, Chảu Giê-xu ti̱ng vàm dá do̱ cạ cần nỉnh: “Ni̱ nhằng slỉu lo̱ nưng. Lèo khai thuủn kí lo̱ ni̱ mì sle păn hử cần khỏ, do̱ ni̱ co̱i mì xang pảo dú tìng fạ, dá chứng mà nảy, pay nèm ngo̱.” <verse eid="LUK 18:22" /><verse number="23" style="v" sid="LUK 18:23" />Tọ slì ti̱ng kí vàm nỉnh, báo nỉnh slim xàu, vi̱ min fát xài lai. <verse eid="LUK 18:23" /><verse number="24" style="v" sid="LUK 18:24" />Dá Chảu Giê-xu nho̱m ké xáu cạ: “Cần mì lai cú cái khảu tum ti̱ Chảu Fạ chăn chư̱ khỏ lai! <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />Vi̱ tu lạc đà chún quá lù khim nhằng hẳm nga̱i quá cần fát xài khảu tum ti̱ Chảu Fạ!” <verse eid="LUK 18:25" /><verse number="26" style="v" sid="LUK 18:26" />Kí cần ti̱ng vàm nỉnh tham cạ: “Pìn nỉnh do̱, cần nàư đảy cháu è?” <verse eid="LUK 18:26" /><verse number="27" style="v" sid="LUK 18:27" />Min hòi vàm: “Lo̱ lăng tu cần mí hít đảy, do̱ Chảu Fạ hít đảy.” <verse eid="LUK 18:27" /><verse number="28" style="v" sid="LUK 18:28" />Phi-e-rơ dăng: “Ne̱, hung ngo̱ tó tả mọi lo̱ làu mì sle pay nèm slay dá.” <verse eid="LUK 18:28" /><verse number="29" style="v" sid="LUK 18:29" />Min hòi vàm hau: “Chăn, ngo̱ cạ kí pi̱ noọng, mí cần nàư tả lưừn la̱ng, pá mé, pi̱ noọng, me̱, lu̱c vi̱ tum ti̱ Chảu Fạ <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />te̱o mí đảy nhă̱n quá lai pày chang tơ̱i nảy, dá tơ̱i lăng co̱i đảy te̱o tơ̱i tơ̱i.”<verse eid="LUK 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />Chảu Giê-xu tan au slíp nhi̱ cần đảy xoi pay oóc, dá cạ hau: “Ne̱, hung làu pay khửn slẻng Giê-ru-sa-lem; mọi lo̱ kí cần páo cón tó slẻ mà Lu̱c Cú Cần co̱i đảy lình ính. <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />Vi̱ Min co̱i ngài no̱p hử cần cú tum ti̱ táng, ngài khu slủm, ngài hít xảu nả, ngài phjí nài khảu nả. <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />Min co̱i ngài hau cọn càn, ngài khả hai; thưng vằn ta̱i slam, Min co̱i hòi te̱o.” <verse eid="LUK 18:33" /><verse number="34" style="v" sid="LUK 18:34" />Tọ kí cần nèm slon mí slụ lăng mòn, vi̱ ý xí kí vàm nỉnh nhằng ngài dăm dò đủi hau, hau chứng mí slụ Chảu ái chảng lăng.<verse eid="LUK 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />Slì Chảu Giê-xu thưng xảư slẻng Giê-ri-cô, mì cần fàng nưng nă̱ng kin xo cằn kha lo̱. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />Ti̱ng phang đung pay khoang quá, báo nỉnh tham ngòi mì ca lăng. <verse eid="LUK 18:36" /><verse number="37" style="v" sid="LUK 18:37" />Hau hử báo nỉnh chắc Chảu Giê-xu, cần Na-xa-rét ái pay khoang quá nỉnh. <verse eid="LUK 18:37" /><verse number="38" style="v" sid="LUK 18:38" />Cần fàng liìn moòng khửn, cạ: “Pái Giê-xu, lu̱c huùng Đa-vít, xo điíp sliít ngo̱.” <verse eid="LUK 18:38" /><verse number="39" style="v" sid="LUK 18:39" />Kí cần pay cón quáy min, cạ mí đảy chảng. Tọ báo hẳm moòng hẳm cải: “Lu̱c huùng Đa-vít ới, xo điíp sliít ngo̱!” <verse eid="LUK 18:39" /><verse number="40" style="v" sid="LUK 18:40" />Chảu Giê-xu đử dú, oóc lịng au cần fàng mà. Dá báo khảu xảư, Min tham: <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />“Ni̱ ái ngo̱ hít lăng hử ni̱?” Báo dăng: “Pái Chảu, xo hử ha ngo̱ nho̱m hăn đảy.” <verse eid="LUK 18:41" /><verse number="42" style="v" sid="LUK 18:42" />Chảu Giê-xu cạ: “Ha nho̱m hăn đảy pay! Slim slấn cú ni̱ tó da đay ni̱ dá.” <verse eid="LUK 18:42" /><verse number="43" style="v" sid="LUK 18:43" />Chích slì, ha cần fàng nho̱m hăn đảy dá pay nèm Min, tài slung Chảu Fạ, mọi cần hăn pìn nỉnh xày că̱n Chảu Fạ.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />Chíu khảu bửng đưng, Chảu Giê-xu pay khoang quá slẻng Giê-ri-cô. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />Cứ ngòi cần nưng, dảo hít Xa-chê, ké fát xài lai, đảy căm tàu kí cần slau slé. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />Ké xa lo̱ sle ngòi Chảu Giê-xu chư̱ cần nàư, tọ mí hăn đảy, vi̱ phang cần do̱ đung, nhằng ké te̱o tắm. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />Pìn nỉnh, Xa-chê chứng le̱n pay cón xáu mén khửn co đứ sle đảy hăn Chảu, vi̱ Min ái pay quá lo̱ nỉnh. <verse eid="LUK 19:4" /><verse number="5" style="v" sid="LUK 19:5" />Chíu Chảu Giê-xu thưng ti̱ nỉnh, do̱ slè ha khửn cạ ké: “Xa-chê ới, lùng khoái, vi̱ vằn nảy ngo̱ lèo dú lưừn ni̱.” <verse eid="LUK 19:5" /><verse number="6" style="v" sid="LUK 19:6" />Xa-chê chứng slỉnh slảng mén lùng xáu fằng fừ tỏn chiíp Min. <verse eid="LUK 19:6" /><verse number="7" style="v" sid="LUK 19:7" />Hăn pìn nỉnh, mọi cần xày hài ha̱c, chảng cạ: “Min xày khảu lưừn cần phít xá to̱ vớ!” <verse eid="LUK 19:7" /><verse number="8" style="v" sid="LUK 19:8" />Tọ Xa-chê tấn dân dăng Chảu cạ: “Pái Chảu, ngòi ne̱, ngo̱ au pún cha xài cú ngo̱ păn hử cần khỏ, hạy hít ha̱i cần nàư ca lăng, ngo̱ co̱i păng te̱o lai quá slí pày.” <verse eid="LUK 19:8" /><verse number="9" style="v" sid="LUK 19:9" />Chảu Giê-xu cạ ké: “Vằn nảy, fúc cháu khảu lưừn nảy dá, vi̱ cần nảy xày chư̱ lu̱c lan cú Áp-ra-ham. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" />Vi̱ Lu̱c Cú Cần tó thưng sle xa xáu cháu cần ngài va̱i túc.”<verse eid="LUK 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />Chíu hau ti̱ng kí vàm nỉnh, do̱ Chảu Giê-xu li̱n pỉ xì nưng num, vi̱ Min dú xảư slẻng Giê-ru-sa-lem, hau chứng la̱i cạ tum ti̱ Chảu Fạ ái oóc nả dá. <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />Pìn nỉnh, Min cạ: “Mì cần slung pèng nưng pay thưng ti̱ quay sle đảy hít huùng, dá co̱i fan te̱o. <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />Ké dảo slíp chang kí cần khỏi cú ké thưng, chao hử hau slíp mi-na dá cạ hau: ‘Lèo hít min cha̱n oóc slì ngo̱ pay quay.’ <verse eid="LUK 19:13" /><verse number="14" style="v" sid="LUK 19:14" />Tọ phang cần dú ti̱ ké slim xằng ké chứng xoi cần tang nả pay lăng ké dá chảng: ‘Hung ngo̱ mí ái cần nảy cai cuủn làu.’ <verse eid="LUK 19:14" /><verse number="15" style="v" sid="LUK 19:15" />Lăng slì đảy tài hít huùng, ké dảo kí cần khỏi tó nhă̱n ngừn thưng, ngòi hau hít cha̱n oóc đảy kỉ lai. <verse eid="LUK 19:15" /><verse number="16" style="v" sid="LUK 19:16" />Cần khỏi ta̱i ít thưng, cạ: ‘Lạo chảu ới, mi-na cú chảu tó cha̱n oóc đảy slíp mi-na.’ <verse eid="LUK 19:16" /><verse number="17" style="v" sid="LUK 19:17" />Lạo chảu cạ: ‘Cần khỏi slim đay cú ngo̱ ới, đảy lai. Vi̱ ni̱ tó slim đeo chang lo̱ sláy, ni̱ chứng đảy căm quỳn slíp slẻng.’ <verse eid="LUK 19:17" /><verse number="18" style="v" sid="LUK 19:18" />Cần ta̱i nhi̱ thưng, cạ: ‘Lạo chảu ới, mi-na cú chảu tó cha̱n oóc đảy hả mi-na.’ <verse eid="LUK 19:18" /><verse number="19" style="v" sid="LUK 19:19" />Lạo chảu xày cạ: ‘Ni̱ đảy cai cuủn hả slẻng.’ <verse eid="LUK 19:19" /><verse number="20" style="v" sid="LUK 19:20" />Cần khỏi táng thưng, dăng cạ: ‘Lạo chảu ới, nảy cà, mi-na cú chảu ngo̱ tó dò khảu tèo khưn, <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />ngo̱ lao chảu, vi̱ chảu chư̱ cần kheng khên. Lạo chảu au dú ti̱ mí tặt, cùn dú ti̱ mí ván oóc.’ <verse eid="LUK 19:21" /><verse number="22" style="v" sid="LUK 19:22" />Lạo chảu cạ cần nỉnh: ‘Ne̱, cần khỏi too̱c éc ới, ngo̱ co̱i ứn chá xị vàm ni̱ chảng. Chư̱ ni̱ tó chắc ngo̱ kheng khên, au dú ti̱ mí tặt, cùn dú ti̱ mí ván mí? <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />Pìn nỉnh, hít lừ ni̱ mí chao ngừn cú ngo̱ hử cần khai puún ngừn, sle chíu ngo̱ mà, co̱i au tằng cúc xăm cha̱n?’ <verse eid="LUK 19:23" /><verse number="24" style="v" sid="LUK 19:24" />Dá lạo chảu cạ kí cần dân dú nỉnh: ‘Au mi-na cú min hử cần mì slíp mi-na.’ <verse eid="LUK 19:24" /><verse number="25" style="v" sid="LUK 19:25" />Hau dăng ké: ‘Lạo chảu ới, cần nỉnh tó mì slíp mi-na dá né!’ <verse eid="LUK 19:25" /><verse number="26" style="v" sid="LUK 19:26" />‘Ngo̱ cạ pi̱ noọng chắc, cần nàư mì dá co̱i đảy hử lai num, tọ cần nàư mí mì, do̱ co̱i ngài au pay tằng fă̱n hau mì num. <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" />Nhằng mà fă̱n kí cần tói tàu đủi ngo̱, kí cần mí ái ngo̱ cai cuủn, cứ tái boong min mà nảy, khả hai tói nả ngo̱.’”<verse eid="LUK 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />Cạ kí vàm nỉnh dá, Chảu Giê-xu pay cón, thưng slẻng Giê-ru-sa-lem.<verse eid="LUK 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 19:29" />Chíu Chảu Giê-xu thưng xảư Bết-pha-giê xáu Bê-tha-ni, thưng xảư phja dảo hít Ô-liu, Min xoi sloong cần nèm slon pay, <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />xáu slắng: “Pay khảu bản tói nả, chíu khảu bản dá, kí pi̱ noọng co̱i hăn tu lừ lu̱c nưng xằng cần nàư khúy, ngài phúc chưư̱c. Cứ kẻ chưư̱c oóc xáu chung min mà nảy. <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />Hạy mì cần tham pi̱ noọng: ‘Hít lăng kí cần ni̱ kẻ chưư̱c oóc?’ do̱ pi̱ noọng co̱i hòi vàm cạ: ‘Chảu cẩn min.’” <verse eid="LUK 19:31" /><verse number="32" style="v" sid="LUK 19:32" />Sloong cần đảy xoi pay phúng mọi lo̱ chăn xị Chảu tó chảng đủi hau. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />Chíu hau kẻ chưư̱c phúc lừ lu̱c oóc, do̱ kí lạo chảu cú tu lừ tham hau: “Hít lăng kí cần ni̱ kẻ lừ lu̱c nảy oóc?” <verse eid="LUK 19:33" /><verse number="34" style="v" sid="LUK 19:34" />Hau hòi vàm: “Chảu cẩn min.” <verse eid="LUK 19:34" /><verse number="35" style="v" sid="LUK 19:35" />Dá hau chung lừ mà hử Chảu Giê-xu, pjái slử làu khửn lăng lừ lu̱c, hau tài Min khửn khúy khửn tìng. <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />Chíu Chảu Giê-xu khúy lừ pay quá, mì lai cần pjái slử pao tìng lo̱. <verse eid="LUK 19:36" /><verse number="37" style="v" sid="LUK 19:37" />Chíu Min thưng xảư lính phja Ô-liu, tằng kí cần nèm slon xo tàu fằng fừ xáu că̱n Chảu Fạ mà thuủn kí lo̱ quỳn slèng hau tó đảy hăn, <verse eid="LUK 19:37" /><verse number="38" style="v" sid="LUK 19:38" />cạ: “Fúc tháy hử huùng au mình Chảu thưng! pình an dú nư fạ, slu̱ng phjưức tìng ti̱ ta̱i slung!” <verse eid="LUK 19:38" /><verse number="39" style="v" sid="LUK 19:39" />Mì kỉ cần Pha-ri-si dú chang phang cần đung chảng đủi Min: “Slay ới, xo quáy kí cần nèm slon slay!” <verse eid="LUK 19:39" /><verse number="40" style="v" sid="LUK 19:40" />Min hòi vàm: “Ngo̱ cạ kí ké, hạy hau ti̱ng xích do̱ kí ca̱o hin nảy co̱i moòng cải khửn.”<verse eid="LUK 19:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />Chíu thưng xảư, nho̱m hăn slẻng Giê-ru-sa-lem, Chảu Giê-xu hảy mà slẻng nỉnh, <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />dá cạ: “Mu̱ng hử vằn nảy, chăn mưng chắc đảy kí lo̱ hít hử mưng pình an! Tọ cà nạy, kí lo̱ nỉnh ngài dà khói ha mưng. <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />Vi̱ thưng vằn, ni̱ co̱i ngài cần tói tàu hắp cằn, pao hảng to̱i quằng xáu xáy mắn to̱i slí chái. <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />Hau co̱i khả chii̱t mưng, xáu lu̱c lan cú mưng num. Hau co̱i mí nhằng sle ca̱o hin haư táp tìng ca̱o hin haư, vi̱ mưng mí chắc mư̱ haư làu đảy Chảu Fạ dưưng.”<verse eid="LUK 19:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />Chảu Giê-xu khảu lưừn slớ, xo tàu te̱p thuủn kí cần khai slự oóc khói nỉnh, <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />xáu cạ hau: “Mì vàm slẻ: ‘Lưừn Cau co̱i pìn lưừn xỉnh chàu’, tọ hung mưng tó hít ti̱ nảy pìn ‘thẳm lặc cưứp.’”<verse eid="LUK 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47" />Vằn vằn, Min cứ slon cạ chang lưừn slớ. Nhằng kí slay pài xoòng tàu, kí slay slon luật fáp, xáu kí cần căm tàu phang cần xa lo̱ khả Min, <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />tọ hau xằng chắc lèo hít lừ, vi̱ phang cần xày dặn ti̱ng Min slon cạ.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />Vằn nưng, chíu Chảu Giê-xu slon cạ phang cần chang lưừn slớ xáu páo cạ Vàm Đay, do̱ kí slay pài xoòng tàu, kí slay slon luật fáp, kí lạo ké thưng <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />tham Min cạ: “Slay hử hung ngo̱ chắc pừng khảu quỳn haư te̱o hít đảy kí lo̱ nảy, do̱ va̱ cần nàư tó hử slay quỳn nỉnh?” <verse eid="LUK 20:2" /><verse number="3" style="v" sid="LUK 20:3" />Min hòi vàm hau: “Ngo̱ xày tham vàm nưng, kí ké lèo chảng hử ngo̱ chắc: <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />Fép báp-têm cú Giăng tứ fạ do̱ va̱ tứ tu cần thưng?” <verse eid="LUK 20:4" /><verse number="5" style="v" sid="LUK 20:5" />Hau chứng xùm xưừng đủi căn, chảng cạ: “Hạy hung làu dăng: ‘Tứ fạ,’ do̱ ké co̱i tham: ‘Pìn nỉnh do̱ hít lăng kí ké mí slấn Giăng?’ <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />Nhằng hạy hung làu chảng: ‘Tứ tu cần,’ do̱ tằng phang cần co̱i bẳn hin hung làu, vi̱ hau xày slấn Giăng chăn chư̱ cần páo cón.” <verse eid="LUK 20:6" /><verse number="7" style="v" sid="LUK 20:7" />Pìn nỉnh, hau chứng hòi vàm cạ hau mí chắc báp-têm nỉnh tứ haư thưng. <verse eid="LUK 20:7" /><verse number="8" style="v" sid="LUK 20:8" />Chảu Giê-xu hòi vàm hau: “Ngo̱ xày mí chảng hử kí ké chắc pừng khảu quỳn haư ngo̱ te̱o hít kí lo̱ nỉnh.”<verse eid="LUK 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />Chảu Giê-xu te̱o li̱n pỉ xì nảy hử phang cần: “Lạo chảu nưng chay la̱y mác ít xáu hử kí cần chay mác ít có, dá pay thưng ti̱ đai dú hả lai hưng. <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />Thưng mù, lạo chảu xoi cần khỏi mà phúng kí cần chay co mác ít sle au fă̱n mác slau đảy tứ la̱y mác ít. Tọ kí cần chay mác ít cọn, dá te̱p min mà mừ đai. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />Lạo chảu xoi cần khỏi táng num thưng, tọ hau xày cọn, hít xảu nả xáu te̱p mà mừ đai. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />Lạo chảu te̱o xoi cần khỏi ta̱i slam num thưng, tọ hau xày thuúp min chíp, xáu te̱p pay. <verse eid="LUK 20:12" /><verse number="13" style="v" sid="LUK 20:13" />Chíu nỉnh, chảu la̱y mác ít chảng: ‘Làu lèo hít lăng? Làu co̱i xoi cần lu̱c báo pèng điíp cú làu thưng. Cay hau co̱i dưư̱ng nả min.’ <verse eid="LUK 20:13" /><verse number="14" style="v" sid="LUK 20:14" />Tọ kí cần chay mác ít ngám hăn lu̱c báo nỉnh, do̱ xùm xưừng đủi căn: ‘Nảy chăn chư̱ ò lu̱c đảy táp cha xài. Hung làu khả min pay, do̱ fă̱n cha xài cú min co̱i pìn mà hung làu.’ <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />Hau chứng vẻng lu̱c báo nỉnh khói la̱y mác ít, dá khả pay. Pìn nỉnh chảu la̱y mác ít co̱i hít pìn lừ đủi kí cần nỉnh? <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />Ké nỉnh co̱i thưng chii̱t boong chay la̱y mác ít nỉnh, dá sle la̱y hử cần táng.” Ti̱ng kí vàm nỉnh dá, phang cần cạ: “Mí pìn nỉnh đảy!” <verse eid="LUK 20:16" /><verse number="17" style="v" sid="LUK 20:17" />Chảu Giê-xu nho̱m hau dá cạ: “Pìn nỉnh do̱ vàm nảy mì ý xí lăng:</para>
  <para style="q1" vid="LUK 20:17">‘Ca̱o hin ngài cần xáy lưừn tả oóc,</para>
  <para style="q1" vid="LUK 20:17">tó pìn ca̱o hin slảng?’<verse eid="LUK 20:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18" />Cần nàư lụp khảu hin nỉnh do̱ co̱i ngài slụp slé. Nhằng ca̱o hin lút khảu cần nàư do̱ co̱i bjải bjác cần nỉnh.”<verse eid="LUK 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />Chăn chíu nỉnh, kí slay slon luật fáp xáu kí slay pài xoòng tàu xa lo̱ cặp Min, tọ hau lao phang cần, vi̱ hau chắc Min au pỉ xì nỉnh chảng hau. <verse eid="LUK 20:19" /><verse number="20" style="v" sid="LUK 20:20" />Hau chứng pay kem Chảu Giê-xu, xoi kí cần mó mé chá hít cần cung chính, sle la̱i xan vàm Min chảng, dá hít chửng no̱p hử cần căm quỳn xáu quan cải. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />Kí cần nỉnh tham Chảu Giê-xu cạ: “Slay ới, hung ngo̱ chắc slay chảng xáu slon chư̱ lai, mí nghiíng mà cần nàư, tọ slon chăn nèm lo̱ cú Chảu Fạ. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />Hung ngo̱ no̱p slé hử Sê-sa chư̱ luật do̱ mí chư̱?” <verse eid="LUK 20:22" /><verse number="23" style="v" sid="LUK 20:23" />Chắc slim hau xan xảo, Min chứng cạ: <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />“Cứ hử ngo̱ ngòi mưn đơ-ni-ê nưng. mưn chèn nảy mì slưứng xáu mình cú cần nàư?” Hau hòi vàm: “Cú Sê-sa.” <verse eid="LUK 20:24" /><verse number="25" style="v" sid="LUK 20:25" />Min cạ: “Pìn nỉnh do̱ lèo păng hử Sê-sa kí lo̱ cú Sê-sa; cú Chảu Fạ do̱ lèo păng hử Chảu Fạ.” <verse eid="LUK 20:25" /><verse number="26" style="v" sid="LUK 20:26" />Hau mí hảng đảy slắc vàm haư tói nả phang cần, Min hòi vàm hít hử hau he, chứng lèo đỉ dú.<verse eid="LUK 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />Mì kỉ cần Sa-đu-sê thưng xảư, kí cần nảy cạ mí mì lo̱ hòi te̱o, hau tham Chảu Giê-xu: <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />“Slay ới, Môi-se tó slẻ luật nảy hử hung làu, hạy cần nưng mì pi̱ báo au me̱ dá te̱o hai pay, tọ xằng mì lu̱c, do̱ noọng cú cần nỉnh lèo au me̱ mải nỉnh, sle mì lu̱c táp nòi hử pi̱ báo làu. <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />Pìn nỉnh, hạy lưừn nưng mì chất pi̱ noọng báo, có tài au me̱ dá hai, tọ xằng mì lu̱c; <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />cần ta̱i nhi̱ <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />cần ta̱i slam au pi̱ lù, dá tằng chất cần xày au me̱ nỉnh, tọ xày hai te̱o mí mì lu̱c. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />Sloót hang, cần ti̱ me̱ nỉnh xày hai. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />Thưng vằn hòi te̱o, cần ti̱ me̱ nỉnh co̱i pìn me̱ cú cần nàư? Vi̱ tằng chất cần xày au min hít me̱ dá.” <verse eid="LUK 20:33" /><verse number="34" style="v" sid="LUK 20:34" />Chảu Giê-xu hòi vàm hau: “Kí lu̱c lan tơ̱i nảy au me̱, au po̱, <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />Nhằng kí cần đảy ngòi ngám sle đảy fúc fă̱n mà tơ̱i lăng xáu đảy hòi te̱o tứ ti̱ hai, do̱ mí au me̱ do̱ va̱ au po̱. <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />Hau xày mí hai dá, vi̱ hau đảy hút xị kí cần tang nả fạ; chư̱ lu̱c cú Chảu Fạ, chăn lu̱c cú lo̱ hòi te̱o. <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" />Nhằng mà lo̱ cần hai hòi te̱o, tằng cạ Môi-se tó hử hăn quá tèo cỏ mà pá nam, chíu dảo Chảu hít Chảu Fạ cú Áp-ra-ham, Chảu Fạ cú Y-sác xáu Chảu Fạ cú Gia-cốp. <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />Pìn nỉnh, Min mí chư̱ Chảu Fạ cú cần hai, tọ chăn chư̱ Chảu Fạ cú cần te̱o; vi̱ mọi cần xày te̱o đủi Min.” <verse eid="LUK 20:38" /><verse number="39" style="v" sid="LUK 20:39" />Mì kỉ slay slon luật fáp chảng đủi Min: “Pái slay, slay chảng chư̱ lai.” <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />Dá hau mí cảm tham Min slắc vàm haư num.<verse eid="LUK 20:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />Dá, Chảu Giê-xu chảng đủi hau: “Hít lừ do̱ kí cần nèm slon táng cạ Chảu Cháu Ti̱ Da̱ pìn lu̱c Đa-vít? <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" />Vi̱ chang xéc Sli Thiin, chăn huùng Đa-vít tó chảng cạ:</para>
  <para style="q1" vid="LUK 20:42">‘Chảu cạ Chảu ngo̱:</para>
  <para style="q1" vid="LUK 20:42">“Cứ nă̱ng bưửng sla Cau,<verse eid="LUK 20:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="LUK 20:43" />thưng slì Cau tặt kí cần tói tàu cú Lu̱c hít ti̱ te̱m kha hử Lu̱c.”’<verse eid="LUK 20:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44" />Huùng Đa-vít chứng dảo Min hít ‘Chảu’, do̱ hít lừ Min te̱o pìn lu̱c cú huùng nỉnh đảy è?”<verse eid="LUK 20:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />Chíu phang cần nhằng ti̱ng, do̱ Chảu cạ kí cần nèm slon: <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />“Lèo slỉu slim đủi kí slay slon luật fáp, chư̱ kí cần ái nu̱ng slử lì pay li̱u la̱i, nắt đảy hau tuụng chang ti̱ háng, mu̱ng đảy nă̱ng tắng cẩn díu ta̱i ít dú kí lưừn ho̱i xáu ti̱ đảy ha nả chang kí tón kin, <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />hau nận au lưừn cú kí me̱ mải, te̱o chả loóc to̱c vàm xỉnh chàu lì loạt. Hau co̱i ngài cáp xá hẳm nắc num.”<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />Chảu Giê-xu slè ha khửn, hăn kí cần fát xài pài cú cái khảu xang lưừn slớ. <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />Min xày hăn me̱ mải nưng khỏ, pài khảu xang sloong mưn chèn sláy. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />Min cạ: “Chăn, ngo̱ cạ kí pi̱ noọng, me̱ mải khỏ nảy tó pài lai chèn quá kí cần táng, <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />vi̱ mọi cần xày au cú cái làu lứ sle khảu. Nhằng me̱ mải nảy slỉu khỏ lai, tọ te̱o pài khảu thuủn kí lo̱ da̱ mì.”<verse eid="LUK 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />Chíu kỉ cần chảng mà lưừn slớ đảy chang chỉng hin đay xáu cú cái pài khảu slu̱ng slực, do̱ Chảu Giê-xu cạ: <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />“Kí pi̱ noọng hăn nảy co̱i thưng vằn ngài túm tác thuủn, bó nhằng ca̱o hin haư táp tìng ca̱o hin haư.” <verse eid="LUK 21:6" /><verse number="7" style="v" sid="LUK 21:7" />Hau tham Min cạ: “Slay ới, mư̱ haư kí lo̱ nảy co̱i mì oóc, mì ha̱o lăng hử chắc kí lo̱ nảy ái mì oóc mí?” <verse eid="LUK 21:7" /><verse number="8" style="v" sid="LUK 21:8" />Min hòi vàm: “Lèo slỉng sla̱c, mí đảy sle kí pi̱ noọng ngài pjàng pjào. Vi̱ co̱i mì lai cần au mình ngo̱ chảng cạ: ‘Chăn Cau chư̱ lạo nỉng’ xáu ‘Slì sloót hang thưng xảư dá.’ Kí pi̱ noọng mí đảy pay nèm hau. <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />Chíu kí pi̱ noọng đảy nghìn mì tức căn, luu̱n lạo do̱ mí đảy he, vi̱ lo̱ nỉnh lèo mì oóc cón, tọ chíu nỉnh xằng chư̱ sloót hang đơ.”<verse eid="LUK 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10" />Dá Min te̱o cạ hau: “Nòi cần nảy co̱i tấn khửn tỉng xáu nòi cần táng, tum ti̱ nảy tỉng te̱o tum ti̱ nỉnh. <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />Co̱i mì kí xá fựn tum cải, slỉu dác, hai la̱ dú lai ti̱. Co̱i mì tằng kí lo̱ ma̱o mẹc xáu ha̱o pjòi cải tứ fạ. <verse eid="LUK 21:11" /><verse number="12" style="v" sid="LUK 21:12" />Tọ chíu kí lo̱ nỉnh xằng mì oóc, kí pi̱ noọng co̱i ngài hau oóc mừ hít khỏ, chao no̱p hử kí lưừn ho̱i xáu ngài xăng, la̱c pi̱ noọng thưng tói nả kí huùng xáu kí quan cải. <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />Nảy chư̱ chúng slì đay sle pi̱ noọng hít chửng mà ngo̱. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" />Pìn nỉnh, pi̱ noọng lèo chứ chang slim cạ, mí đảy dau nẳm cón lèo khảu cò làu pìn lừ, <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />vi̱ ngo̱ co̱i pảo hử kí pi̱ noọng kin chảng quai kí, mí cần tói tàu haư tỉng cà do̱ va̱ ke̱o te̱o đảy. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />Pi̱ noọng co̱i ngài pá mé, pi̱ noọng, pàng dạu làu pắt no̱p, dá hau co̱i khả kỉ cần chang pi̱ noọng. <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />Pi̱ noọng co̱i ngài mọi cần slim xằng vi̱ mình ngo̱. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />Tọ tèo phjâm nưng tìng hu pi̱ noọng xày mí ngài túc đơ. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />Pừng khảu slim tảy nẳm, pi̱ noọng chứng cỏ au đảy khoăn mi̱ng làu.<verse eid="LUK 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />Hạy chíu pi̱ noọng hăn slẻng Giê-ru-sa-lem ngài pan lỉnh pao to̱i do̱ chắc cạ min ái ngài túm tác dá. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />Chíu nỉnh, cần nàư dú chang búng Giu-đê cứ ni khửn phja; cần nàư dú đưng slẻng, cứ pay oóc noo̱c; cần nàư dú noo̱c tu̱ng, mí đảy fan khảu đưng slẻng. <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" />Vi̱ nỉnh chăn chư̱ kí vằn păng xàu, sle mọi vàm Chảu Fạ tó slẻ đảy lình ính. <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />Slói tháy hử cần ti̱ me̱ làm đang xáu kí me̱ nhằng hử lu̱c kin nùm chang kí vằn nỉnh! Vi̱ co̱i mì chai na̱n cải tìng tum xáu xá fát fày cháng lùng nòi cần nảy. <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />Hau co̱i lụp tảư lịn ma̱c dáng xáu ngài au pay hít khỏi chang kí tum ti̱, xáu slẻng Giê-ru-sa-lem co̱i ngài cần cú tum ti̱ táng dă̱m ta̱p, thưng chíu slì ha̱n cú kí cần cú tum ti̱ táng đảy hít thuủn.<verse eid="LUK 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />Co̱i mì kí ha̱o pjòi tìng ha vằn, puúng hai xáu kí đao đí, nhằng tảư tum, kí nòi cần xàu hí luu̱n lạo vi̱ hải hài xáu nặm cải fư̱t khửn. <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />Hau he dá đỉn pay chíu tẳng kí lo̱ ái cháng lùng hử mọi cần dú tìng tum, vi̱ kí quỳn dú tìng fạ co̱i ngài tu̱ng fèn. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" />Mư̱ nỉnh mọi cần tìng ti̱ da̱ co̱i hăn Lu̱c Cú Cần au ta̱i quỳn slu̱ng phjưức cải lùng chang xá phử. <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />Mư̱ haư kí lo̱ nỉnh xo tàu mì oóc, lèo dân dàu, tẳng hu khửn, vi̱ pi̱ noọng ái đảy cháu dá.”<verse eid="LUK 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />Min te̱o li̱n hử hau pỉ xì ứn: “Cứ ngòi co ngo̱a xáu thuủn kí co mạy táng. <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />Chíu min ngám xo tàu oóc nhoo̱t, pi̱ noọng hăn do̱ táng chắc cạ mù đứt ái thưng xảư dá. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />Xày pìn nỉnh, slì kí pi̱ noọng hăn kí lo̱ nỉnh mì oóc, do̱ pi̱ noọng chắc cạ tum ti̱ Chảu Fạ tó xảư lai dá. <verse eid="LUK 21:31" /><verse number="32" style="v" sid="LUK 21:32" />Chăn, ngo̱ cạ pi̱ noọng, xám cần nảy co̱i bó quá pay thưng slì mọi lo̱ nỉnh mì oóc. <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />Tum fạ co̱i quá pay, tọ kí vàm ngo̱ cạ co̱i mí quá slắc pày đơ.<verse eid="LUK 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />Tọ, lèo slỉu slim, sle slim pi̱ noọng mí ngài nắc nái, kin nhẳm quá mạ, màu mè, dau hí mà tơ̱i nảy, thưng slặn vằn nỉnh lặm li̱t lùng pi̱ noọng <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />xị ăn hảng, vằn nỉnh xày thưng hử mọi cần dú to̱i ti̱ da̱. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />Pìn nỉnh, lèo slỉng sla̱c xáu xỉnh chàu mại sle kí pi̱ noọng đo slèng phiín khói mọi lo̱ co̱i mì oóc, sle đảy dân tói nả Lu̱c Cú Cần.”<verse eid="LUK 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />Tằng vằn, Chảu Giê-xu slon cạ chang lưừn slớ, nhằng thưng pài đăm, Min pay khửn phja Ô-liu dá dú nỉnh quá khừn. <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />Naư xạu, tằng phang cần thưng xảư Min, sle ti̱ng Min slon cạ chang lưừn slớ.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />Le̱ Pẻng Mí Lùng Bư Phù, đảy dảo hít le̱ Khảm Quá thưng xảư dá. <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />Kí slay pài xoòng tàu xáu kí slay slon luật fáp xa lo̱ sle khả Chảu Giê-xu, vi̱ hau lao phang cần.<verse eid="LUK 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3" />Chíu nỉnh, Sa-tan dắp khảu Giu-đa, dảo hít Ích-ca-ri-ốt, cần nưng chang slíp nhi̱ cần đảy xoi pay. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />Giu-đa pay xùm xưừng đủi kí slay pài xoòng tàu xáu kí cần cuủn lị lỉnh pạư lưừn slớ sle xa lo̱ chao Min hử hau. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />Hau fằng lai, pao xình co̱i hử min ngừn chèn. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />Giu-đa chung ý chứng xa chúng slì sle no̱p Chảu Giê-xu chíu phang cần mí dú nỉnh.<verse eid="LUK 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />Thưng vằn le̱ Pẻng Mí Lùng Bư Phù, vằn nỉnh hau lèo khả chiin lu̱c hít le̱ Khảm Quá, <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />Chảu Giê-xu xoi Phi-e-rơ xáu Giăng pay, slắng cạ: “Cứ pay chắp xặp le̱ Khảm Quá sle hung làu ta̱i cha kin.” <verse eid="LUK 22:8" /><verse number="9" style="v" sid="LUK 22:9" />Sloong cần dăng Min: “Slay ái hung ngo̱ chắp xặp le̱ nỉnh dú càư?” <verse eid="LUK 22:9" /><verse number="10" style="v" sid="LUK 22:10" />Min hòi vàm hau: “Chíu khảu slẻng, cần béc cú nặm nưng co̱i phúng pi̱ noọng. Cứ pay nèm, cần nỉnh khảu lưừn haư, do̱ pi̱ noọng xày khảu nỉnh. <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />Pi̱ noọng co̱i chảng xáu chảu lưừn: ‘Slay tham ké cạ: Hó khéc sle slay xáu kí cần nèm slon co̱i kin le̱ Khảm Quá dú càư?’ <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />Chảu lưừn co̱i chỉ hử kí pi̱ noọng ăn hó cải nưng đảy chang chỉng tìng các, mọi lo̱ ính xình dá. Cứ tọn xoòng kin dú nỉnh.” <verse eid="LUK 22:12" /><verse number="13" style="v" sid="LUK 22:13" />Pìn nỉnh, sloong cần nèm slon pay, phúng mọi lo̱ chăn xị Min tó cạ hau. Dá hau chắp xặp le̱ Khảm Quá.<verse eid="LUK 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />Thưng slì hít le̱, Min nă̱ng khảu xoòng, kí cần đảy xoi pay xày nă̱ng xáu Min. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />Min cạ hau: “Ngo̱ ái kin le̱ Khảm Quá nảy đủi pi̱ noọng cón slì ngo̱ tảy chíp đát. <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />Vi̱ ngo̱ cạ kí pi̱ noọng, ngo̱ co̱i mí kin le̱ nảy num thưng kí vằn le̱ nỉnh đảy hít pìn chang tum ti̱ Chảu Fạ.” <verse eid="LUK 22:16" /><verse number="17" style="v" sid="LUK 22:17" />Min căm choóc, sleng slu̱ dá cạ: “Cứ căm au choóc nảy, dá păn hử căn. <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />Vi̱ ngo̱ cạ pi̱ noọng, tứ nảy tò pay ngo̱ co̱i mí kin nặm mác ít nảy num, thưng slì tum ti̱ Chảu Fạ thưng.” <verse eid="LUK 22:18" /><verse number="19" style="v" sid="LUK 22:19" />Dá Min au pẻng, sleng slu̱, ẻo oóc, păn hử kí cần nèm slon, dá cạ: “Nảy chăn chư̱ đúc đang ngo̱, slỉ vi̱ pi̱ noọng. Lèo hít lo̱ nảy sle chứ thưng ngo̱.” <verse eid="LUK 22:19" /><verse number="20" style="v" sid="LUK 22:20" />Slì Min kin dá, au choóc, xáu cạ: “Choóc nảy chăn chư̱ chao kiít máư chang lưư̱t ngo̱, lưư̱t đíng oóc vi̱ pi̱ noọng. <verse eid="LUK 22:20" /><verse number="21" style="v" sid="LUK 22:21" />Nảy cà, phả mừ cần fản ngo̱ tò tặt tìng xoòng đủi ngo̱. <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />Vi̱ Lu̱c Cú Cần pay xị mọi lo̱ tó slưửng cón, tọ slói tháy hử cần chao no̱p Min!” <verse eid="LUK 22:22" /><verse number="23" style="v" sid="LUK 22:23" />Kí cần nèm slon xo tàu tham căn ngòi cần nàư chang kí cần hau slưửng fản Min.<verse eid="LUK 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />Kí cần nèm slon chứng cheng ke̱o đủi căn ngòi cần nàư chang hau chư̱ cần cải tàu. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />Tọ Min cạ hau: “Kí huùng cú cần cú tum ti̱ táng au quỳn sle cai cuủn, kí cần căm quỳn đảy dảo hít ‘cần pảo fúc.’ <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />Pi̱ noọng do̱ mí đảy pìn nỉnh. Tọ, cần nàư cải tàu chang pi̱ noọng do̱ lèo pìn xị cần sláy ta̱i ít, cần nàư căm tàu do̱ lèo pìn xị cần cung ta̱i. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />Vi̱ cần nă̱ng kin xáu cần cung ta̱i, cần nàư hẳm cải? Bó chư̱ cần nă̱ng kin á? Tọ ngo̱ dú chang pi̱ noọng te̱o xị cần cung ta̱i. <verse eid="LUK 22:27" /><verse number="28" style="v" sid="LUK 22:28" />Kí pi̱ noọng chăn slim đeo xáu ngo̱ chang kí vằn ngo̱ phúng xi cha̱m. <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />Ngo̱ chứng pảo hử pi̱ noọng xị Pá ngo̱ xày pảo tum ti̱ hử ngo̱, <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" />sle pi̱ noọng đảy kin xày xoòng ngo̱ chang tum ti̱ ngo̱ xáu đảy nă̱ng tìng tắng ứn chá slíp nhi̱ nòi cần Y-sơ-ra-ên.<verse eid="LUK 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />Si-môn ới, Si-môn, nho̱m cà, Sa-tan to̱i phắt ni̱ xị khảu me̱c va. <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />Tọ ngo̱ tó xỉnh chàu hử chăn ni̱, sle ni̱ mí slỉu slim slấn. Pìn nỉnh, chíu ni̱ fan te̱o, lèo hít hử pi̱ noọng làu đảy slèng dạc.” <verse eid="LUK 22:32" /><verse number="33" style="v" sid="LUK 22:33" />Phi-e-rơ dăng: “Chảu ới, ngo̱ tó ính xình tò ngài xăng xày hai xáu Chảu.” <verse eid="LUK 22:33" /><verse number="34" style="v" sid="LUK 22:34" />Chảu Giê-xu hòi vàm: “Phi-e-rơ ới, ngo̱ cạ hử ni̱ chắc, vằn nảy chíu cáy xằng khăn, ni̱ co̱i chảng mí chắc ngo̱ slam pày.”<verse eid="LUK 22:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />Min te̱o cạ hau: “Chíu ngo̱ xoi pi̱ noọng pay, mí au ta̱y chèn, ta̱y ngàm, cài, pi̱ noọng slỉu lăng, chư̱ mí?” Kí cần nèm slon dăng: “Mí slỉu lăng chạy.” <verse eid="LUK 22:35" /><verse number="36" style="v" sid="LUK 22:36" />Min cạ hau: “Tọ cà nạy, cần nàư mì ta̱y chèn, cứ au pay nèm; cần nàư mì ta̱y ngàm, xày pìn nỉnh. Cần nàư mí mì ma̱c dáng, cứ khai slử pao sle slự. <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />Vi̱ ngo̱ cạ pi̱ noọng, vàm Chảu Fạ nảy lèo đảy lình ính quá ngo̱: ‘Min tó ngài tàm khảu fưừng cần fa̱m fáp.’ Chăn pìn nỉnh, vàm slẻ mà ngo̱ lèo đảy lình ính.” <verse eid="LUK 22:37" /><verse number="38" style="v" sid="LUK 22:38" />Dá hau dăng: “Pái Chảu, nho̱m cà, dú nảy mì sloong ma̱c dáng.” Min cạ: “Pìn nỉnh do̱ đo dá.”<verse eid="LUK 22:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />Lăng nỉnh, Chảu Giê-xu oóc pay khửn phja Ô-liu xị mọi pày, nhằng kí cần nèm slon tò pay nèm Min. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />Chíu pay thưng ti̱ dá, Min cạ kí cần nèm slon: “Lèo xỉnh chàu sle khói ngài láu.” <verse eid="LUK 22:40" /><verse number="41" style="v" sid="LUK 22:41" />Dá Min pay khói kí cần nèm slon đảy tùng hau vẻng ca̱o hin nưng dá qu̱y kháu lùng, Min xỉnh chàu cạ: <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />cạ “Pái Pá, hạy Pá ái, xo dò choóc nảy khói Lu̱c. Tọ, mí chư̱ nèm slim Lu̱c, xo ý Pá đảy pìn.” <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />[Mì cần tang nả tứ fạ oóc nả, hử Min slèng num. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />Chang xá chíp tót, Min xỉnh chàu ta̱i cẩn díu, oóc hứ pìn xị kí múi lưư̱t lút lùng tum.] <verse eid="LUK 22:44" /><verse number="45" style="v" sid="LUK 22:45" />Chíu tấn dân khói ti̱ xỉnh chàu dá, Min fan te̱o ti̱ kí cần nèm slon, hăn hau nòn vi̱ slim xàu. <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />Min cạ hau: “Hít lừ pi̱ noọng nòn? Tấn khửn xỉnh chàu sle pi̱ noọng khói ngài láu.”<verse eid="LUK 22:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />Chíu Min nhằng chảng, nỉnh cà, pan đung nưng thưng, Giu-đa chư̱ cần nưng chang slíp nhi̱ cần đảy xoi pay, tái tàu. Giu-đa khảu xảư Chảu Giê-xu sle chúp Min. <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />Tọ Chảu Giê-xu cạ: “Giu-đa ới, ni̱ chúp sle fản Lu̱c Cú Cần do̱ lừ?” <verse eid="LUK 22:48" /><verse number="49" style="v" sid="LUK 22:49" />Kí cần dú xảư Min hăn lo̱ ái mì oóc chứng tham: “Chảu ới, hung ngo̱ au ma̱c dáng oóc cọn đảy mí?” <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />Dá cần nưng chang kí cần hau cọn cần khỏi cú slay pài xoòng ta̱i tàu xáu ke̱t co̱t xu bưửng sla min. <verse eid="LUK 22:50" /><verse number="51" style="v" sid="LUK 22:51" />Tọ Chảu Giê-xu cạ: “Đo dá! Mí đảy cọn!” Dá Min tu̱ng khảu xu, da đay hử cần khỏ. <verse eid="LUK 22:51" /><verse number="52" style="v" sid="LUK 22:52" />Chảu Giê-xu cạ kí slay pài xoòng tàu, kí cần cuủn lỉnh pạư lưừn slớ xáu kí lạo ké mà cặp Min, cạ: “Hít lừ kí ké au ma̱c dáng xáu tạu mà cặp ngo̱ xị cặp ò cưứp pìn nảy? <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />Vằn vằn ngo̱ dú chang lưừn slớ đủi kí ké, kí ké te̱o mí cặp ngo̱. Tọ nảy chư̱ slì tiỉm cú kí ké, xáu cú quỳn đăm khít.”<verse eid="LUK 22:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />Dá hau cặp Chảu Giê-xu, tái Min pay thưng lưừn slay pài xoòng ta̱i tàu. Nhằng Phi-e-rơ pay nèm Min hả lai quay. <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />Hau pung fày dú chang co̱n dá nă̱ng đủi căn, Phi-e-rơ xày nă̱ng đủi hau. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />Chíu nỉnh, cần slao khỏi nưng hăn Phi-e-rơ nă̱ng xảư tuủng fày, do̱ nho̱m ké pắc pí dá slao cạ: “Ké nảy xày dú đủi cần nỉnh.” <verse eid="LUK 22:56" /><verse number="57" style="v" sid="LUK 22:57" />Tọ Phi-e-rơ liìn thoi ngài, cạ: “Slao nỉnh ới, ngo̱ mí chắc ké nỉnh đơ!” <verse eid="LUK 22:57" /><verse number="58" style="v" sid="LUK 22:58" />Dắp lăng nưng, te̱o mì cần táng hăn Phi-e-rơ, do̱ cạ: “Ké nảy xày slục fưừng nỉnh!” Tọ, Phi-e-rơ hòi vàm: “Ni̱ ới, mí chư̱ ngo̱ đơ!” <verse eid="LUK 22:58" /><verse number="59" style="v" sid="LUK 22:59" />Slắc tiỉm lăng nưng, mì cần táng num chảng mắn cạ: “Chăn ké nảy xày dú đủi Giê-xu cà, vi̱ min xày chư̱ cần Ga-li-lê.” <verse eid="LUK 22:59" /><verse number="60" style="v" sid="LUK 22:60" />Tọ Phi-e-rơ cạ: “Hày ni̱, ngo̱ mí chắc ni̱ chảng lăng!” Chíu Phi-e-rơ nhằng chảng, do̱ cáy khăn. <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />Chảu váy quá nho̱m Phi-e-rơ, dá Phi-e-rơ chứ te̱o vàm Chảu chảng xáu ké cạ: “Vằn nảy, chíu cáy xằng khăn, ni̱ co̱i chảng mí chắc ngo̱ slam pày.” <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />Dá Phi-e-rơ pay oóc noo̱c, hảy khum phít.<verse eid="LUK 22:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />Kí cần pạư Chảu Giê-xu khu slủm, cọn Min chíp. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />Hau dà ha Min te̱o, dá tỏ Min cạ: “Chảng ngòi! Cần nàư cọn ni̱ è?” <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />Hau nhằng chảng lai vàm hít xảu nả Min num.<verse eid="LUK 22:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />Thưng naư lăng, kí lạo ké cú phang cần, kí slay pài xoòng tàu xáu kí slay slon luật fáp ho̱p te̱o, dá hau tái Chảu Giê-xu thưng tói nả Pan cần Ứn chá, <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />tham: “Hạy ni̱ chư̱ Chảu Cháu Ti̱ Da̱, cứ chảng hử hung ngo̱ chắc.” Tọ Min hòi vàm: “Hạy ngo̱ cạ kí ké, cay kí ké tó mí slấn; <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />nhằng hạy ngo̱ tham, do̱ kí ké tó mí hòi vàm. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />Tọ tứ nảy mà lăng, Lu̱c Cú Cần co̱i nă̱ng bưửng sla Chảu Fạ quỳn slèng.” <verse eid="LUK 22:69" /><verse number="70" style="v" sid="LUK 22:70" />Dá mọi cần xày tham: “Pìn nỉnh, ni̱ chư̱ Lu̱c Chảu Fạ do̱ lừ?” Min hòi vàm: “Chăn kí ké tó cạ ngo̱ chư̱ Lạo nỉnh.” <verse eid="LUK 22:70" /><verse number="71" style="v" sid="LUK 22:71" />Hau cạ: “Hung làu nhằng cẩn vàm chửng hít lăng num? Chăn hung làu tó đảy ti̱ng tứ pác min chảng oóc dá.”<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />Tằng Pan cần Ứn chá tấn dân, tái Min thưng tói nả Phi-lát. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />Hau xo tàu cáo Min, cạ: “Hung ngo̱ tó hăn cần nảy láu phang cần hung ngo̱, mí hử hung ngo̱ no̱p slé hử Sê-sa, xáu táng cạ làu chăn chư̱ Chảu Cháu Ti̱ Da̱, chư̱ huùng.” <verse eid="LUK 23:2" /><verse number="3" style="v" sid="LUK 23:3" />Phi-lát chứng tham Min: “Ni̱ chư̱ Huùng cú cần Do Thái mí?” Chảu Giê-xu hòi vàm ké: “Chăn ni̱ tó chảng pìn nỉnh.” <verse eid="LUK 23:3" /><verse number="4" style="v" sid="LUK 23:4" />Phi-lát cạ kí slay pài xoòng tàu xáu phang cần: “Ngo̱ mí hăn cần nảy mì phít xá lăng.” <verse eid="LUK 23:4" /><verse number="5" style="v" sid="LUK 23:5" />Tọ hau cứ chảng vàm đeo: “Cần nảy xẩn xục phang cần, slon cạ to̱i búng Giu-đê, xo tàu tứ búng Ga-li-lê thưng slặn ti̱ nảy.” <verse eid="LUK 23:5" /><verse number="6" style="v" sid="LUK 23:6" />Phi-lát ti̱ng vàm nỉnh dá chứng tham Min chăn chư̱ cần Ga-li-lê mí. <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />Slì chắc đảy Min tảư quỳn cú huùng Hê-rốt, Phi-lát tái Min pay hử Hê-rốt, chíu nỉnh huùng xày dú slẻng Giê-ru-sa-lem.<verse eid="LUK 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8" />Hê-rốt hăn Chảu Giê-xu do̱ hun hỉ lai, vi̱ huùng đảy ti̱ng hau tàm mà Min, chứng ái đảy phúng Min tứ hưng lai dá, mu̱ng phúng sle nho̱m Min hít ha̱o pjòi. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />Pìn nỉnh, huùng tham Min lai vàm, tọ Min mí hòi vàm lăng chạy. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />Nhằng kí slay pài xoòng tàu xáu kí slay slon luật fáp dân xảư nỉnh cáo Min xảm lai. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />Hê-rốt xáu pan lỉnh ngòi che̱n xáu khu slủm Min, nu̱ng hử Min cùng slử lài nưng dá tái Min chao te̱o hử Phi-lát. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />Chíu nỉnh, Hê-rốt xáu Phi-lát xằng căn, tọ tứ vằn nỉnh hau pìn pàng dạu.<verse eid="LUK 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />Phi-lát chiu xỉnh kí slay pài xoòng tàu, kí cần căm tàu xáu phang cần, <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />ké chảng đủi hau cạ: “Kí ké tái cần nảy mà no̱p hử ngo̱ vi̱ xẩn xục phang cần hít luu̱n, tọ ngo̱ tó slẳm min tói nả kí ké, do̱ hăn cần nảy mí mì phít xá xị kí ké cáo tỉng te̱o min né. <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />Hê-rốt xày hăn pìn nỉnh, chứng chao min te̱o hử hung ngo̱, ngòi ne̱, cần nảy mí hít lăng sle ngài khả hai chạy. <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />Ngo̱ chứng cọn dá co̱i pjúi min oóc.” <verse eid="LUK 23:16" /><verse number="17" style="v" sid="LUK 23:17" />[Xị mọi pày, khảu vằn le̱, quan lèo pjúi cần ngài xăng nưng hử phang cần.] <verse eid="LUK 23:17" /><verse number="18" style="v" sid="LUK 23:18" />Tọ hau xày moòng cải khửn, cạ: “Cứ tíu cần nảy khửn xáu pjúi Ba-ra-ba oóc hử hung ngo̱!” <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />(Ba-ra-ba do̱ chư̱ cần ngài xăng vi̱ hít luu̱n dú đưng slẻng xáu khả cần hai) <verse eid="LUK 23:19" /><verse number="20" style="v" sid="LUK 23:20" />Chíu nỉnh, Phi-lát ái pjúi Chảu Giê-xu chứng te̱o cạ phang cần num. <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />Tọ hau moòng khửn: “Lèo toóc teng min! Toóc teng min tìng mạy các khoáy!” <verse eid="LUK 23:21" /><verse number="22" style="v" sid="LUK 23:22" />Phi-lát te̱o cạ hau thưng pày ta̱i slam: “Cần nảy tó fa̱m xá lăng? Ngo̱ mí xa hăn min fa̱m xá lăng lèo ngài khả hai chạy. Vi̱ pìn nỉnh, ngo̱ co̱i cọn dá pjúi min oóc.” <verse eid="LUK 23:22" /><verse number="23" style="v" sid="LUK 23:23" />Tọ hau te̱o hài hẳm cải num, to̱i lèo toóc teng Min, dá heng hài cải cú hau tó hình đảy. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />Pìn nỉnh, Phi-lát oóc lịng xị vàm hau to̱i xo. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />Ké pjúi cần ngài xăng, vi̱ hít luu̱n xáu khả cần, cần đảy phang cần xo pjúi, dá chao Chảu Giê-xu nèm slim hau mu̱ng.<verse eid="LUK 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />Chíu hau tái Chảu Giê-xu pay, chứng pắt cần nưng mìng hít Si-môn, cần Sy-ren nưng, tứ bản khửn, sle pắt cần nỉnh béc mạy các khoáy nèm lăng Min.<verse eid="LUK 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 23:27" />Mì phang cần đung lai pay nèm Chảu Giê-xu, xáu mì lai ti̱ me̱ thán hảy hử Min. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />Tọ Chảu Giê-xu váy quá cạ kí cần ti̱ me̱: “Lu̱c slao Giê-ru-sa-lem ới, mí đảy hảy hử ngo̱, tọ cứ hảy hử chăn ni̱ xáu kí lu̱c lan cú ni̱. <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />Vi̱ tứ nảy tò pay, co̱i mì vằn hau chảng: ‘Fúc hử cần ti̱ me̱ măn, hử toọng mí làm đang xáu nùm mí hử lu̱c kin nùm.’ <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" />Dá hau cạ kí pò phja: ‘Túm lùng hung ngo̱ pay,’ xáu cạ pò đung, ‘Pùn dà hung ngo̱ de̱.’ <verse eid="LUK 23:30" /><verse number="31" style="v" sid="LUK 23:31" />Vi̱ hạy co kheo hau nhằng hít pìn nỉnh, do̱ co ngoòng co̱i pìn lừ?”<verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />Hau xày tái sloong cần fa̱m xá táng sle khả hai xáu Min.<verse eid="LUK 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 23:33" />Chíu thưng ti̱ nưng dảo hít Pò Đúc Hu, do̱ hau toóc teng Min dú nỉnh tò xày sloong cần fa̱m xá — cần nưng bưửng sla, cần nưng bưửng slại Min. <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />Dá hau tỏ slải sló sle păn căn slử pao cú Min. <verse eid="LUK 23:34" /><verse number="35" style="v" sid="LUK 23:35" />Phang cần do̱ dân dú nỉnh nho̱m, nhằng kí cần căm tàu, do̱ khu slủm Min, cạ: “Min cháu đảy cần táng. Hạy min chăn chư̱ Lạo Cháu Ti̱ Da̱, Lạo đảy Chảu Fạ lưư̱c, do̱ cứ sle min táng cháu min pay!” <verse eid="LUK 23:35" /><verse number="36" style="v" sid="LUK 23:36" />Pan lỉnh xày khu slủm Min, khảu xảư dèn nặm mí hử Min kin, <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />dá cạ: “Hạy mưng chư̱ Huùng cú cần Do Thái, do̱ táng cháu mưng pay!” <verse eid="LUK 23:37" /><verse number="38" style="v" sid="LUK 23:38" />Ti̱ tìng hu Min xày mì chi̱ slư: Cần nảy chăn chư̱ Huùng cần Do Thái.<verse eid="LUK 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39" />Ò nưng chang sloong cần fa̱m xá ngài tíu xày khu slủm Min, cạ: “Ké mí chư̱ Chảu Cháu Ti̱ Da̱ do̱ lừ? Táng cháu au làu, xáu cháu tằng hung ngo̱ num de̱.” <verse eid="LUK 23:39" /><verse number="40" style="v" sid="LUK 23:40" />Tọ ò nỉnh quáy min: “Mưng xày tảy xá pìn nỉnh, nhằng mí chắc lao Chảu Fạ do̱ lừ? <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />Hung làu ngài fa̱t pìn nảy chư̱ lai, vi̱ ngám xáu phít xá làu tó hít, tọ cần nảy mí hít lo̱ lăng slại né.” <verse eid="LUK 23:41" /><verse number="42" style="v" sid="LUK 23:42" />Dá báo nỉnh chảng: “Pái Giê-xu, chíu Chảu khảu tum ti̱ làu dá, xo chứ thưng ngo̱ đủi.” <verse eid="LUK 23:42" /><verse number="43" style="v" sid="LUK 23:43" />Chảu Giê-xu hòi vàm báo nỉnh: “Chăn, ngo̱ cạ ni̱, vằn nảy ni̱ co̱i đảy dú đủi ngo̱ chang Ba-ra-đi.”<verse eid="LUK 23:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />Chíu nỉnh, khảu tiỉm ta̱i húc dá, to̱i ti̱ xày đăm khít thưng tiỉm ta̱i cảu. <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />Ha vằn pìn đăm khít. Nhằng phén chưứng chang lưừn slớ ngài xẻ pìn sloong. <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />Chảu Giê-xu moòng cải khửn cạ: “Pái Pá, Lu̱c xo chao khoăn mi̱ng Lu̱c khảu mừ Pá.” Ngám chảng thuủn vàm, do̱ Min khát chaư. <verse eid="LUK 23:46" /><verse number="47" style="v" sid="LUK 23:47" />Hăn mọi lo̱ mì oóc dá, cần căm tàu pan lỉnh tài slung Chảu Fạ cạ: “Cần nảy chăn chư̱ cung chính!” <verse eid="LUK 23:47" /><verse number="48" style="v" sid="LUK 23:48" />Tằng phang cần dú nảy xỏn xặp te̱o; slì hăn kí lo̱ tó mì oóc do̱ hau túp ức pay mừ. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />Nhằng thuủn kí cần quén Chảu Giê-xu xáu kí cần ti̱ me̱ pay nèm Min tứ Ga-li-lê dân tứ quay nho̱m mọi lo̱ nỉnh.<verse eid="LUK 23:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50" />Mì cần nưng mìng hít Giô-sép, cần nưng chang Pan cần Ứn chá, chư̱ cần slim đay xáu cung chính, <verse eid="LUK 23:50" /><verse number="51" style="v" sid="LUK 23:51" />(tó mí lùng cò mà lo̱ kí cần nỉnh slưửng hít) Giô-sép ti̱ chỏ dú A-ri-ma-thê, ti̱ slẻng cú cần Do Thái, chư̱ cần mu̱ng tẳng tum ti̱ Chảu Fạ. <verse eid="LUK 23:51" /><verse number="52" style="v" sid="LUK 23:52" />Ké pay phúng Phi-lát sle xo sli hài Chảu Giê-xu. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />Giô-sép tặt sli hài Min lùng, au phải pán sle khảu khắp, dá tặt Min khảu ti̱ fằn tó đảy cha̱c chang khảng hin, ti̱ xằng phăng cần nàư chạy. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />Chíu nỉnh khảu vằn Chắp Xặp xáu vằn Sa-bát ái thưng. <verse eid="LUK 23:54" /><verse number="55" style="v" sid="LUK 23:55" />Kí ti̱ me̱ tò pay đủi Chảu tứ búng Ga-li-lê xày pay nèm sle nho̱m ti̱ fằn xáu ngòi hau phăng sli hài Min pìn lừ. <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />Dá hau mừ, chắp xặp dù hom xáu kí thìng hom.</para>
  <para style="p" vid="LUK 23:56">Thưng vằn Sa-bát hau diít cha̱i nèm luật.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />Vằn ta̱i ít chang chất vằn, chíu fạ ái slu̱ng, kí ti̱ me̱ nỉnh au dù hom tó chắp xặp thưng fằn. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />Tọ, hau hăn khảng hin tó lă̱n khói pác tu fằn, <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />tọ phjải khảu đưng, do̱ mí hăn sli hài Chảu Giê-xu haư chạy. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />Chang slì hau nhằng lằng lừ mà lo̱ nỉnh, do̱ nho̱m cà, mì sloong cần ti̱ po̱ nu̱ng slử slu̱ng xác dân xảư hau. <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />Chíu kí da̱ nhằng lao dan, củm nả lùng tum, do̱ sloong cần nỉnh cạ hau: “Hít lăng pi̱ noọng xa cần te̱o chang kí cần hai? <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />Min mí dú nảy đơ, tọ hòi te̱o dá! Cứ chứ te̱o, Min tó cạ pi̱ noọng pìn lừ, chíu nhằng dú Ga-li-lê <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />cạ Lu̱c Cú Cần lèo ngài no̱p khảu mừ cần phít xá, ngài toóc teng tìng mạy các khoáy, dá thưng vằn ta̱i slam, lèo hòi te̱o.” <verse eid="LUK 24:7" /><verse number="8" style="v" sid="LUK 24:8" />Hau chứ te̱o kí vàm Min cạ, <verse eid="LUK 24:8" /><verse number="9" style="v" sid="LUK 24:9" />tứ fằn tò mà, hau li̱n te̱o mọi lo̱ nỉnh hử slíp ít cần nèm slon xáu kí cần táng. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />Kí cần nỉnh mì Ma-ri Ma-đơ-len, Gian-nơ, Ma-ri mé cú Gia-cơ, xáu kí ti̱ me̱ tò pay đủi hau, li̱n te̱o kí lo̱ nỉnh hử kí cần đảy xoi pay. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />Tọ kí cần đảy xoi pay ti̱ng kí vàm nỉnh xị chảng khoang, chứng mí slấn kí cần ti̱ me̱ nỉnh. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />Ma̱i cạ pìn nỉnh, Phi-e-rơ tấn dân, le̱n thưng ti̱ fằn xáu củm lùng nho̱m khảu đưng, tọ tan hăn phải pán xày. Ké fan mừ lưừn, táng tham mà mọi lo̱ ngám mì oóc.<verse eid="LUK 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />Xày khảu vằn nỉnh, mì sloong cần chang kí cần nèm slon pay thưng bản nưng dảo hít Em-ma-út, dú quay slẻng Giê-ru-sa-lem slắc húc slíp ếch-ta-đơ, <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />hau chảng cỏ đủi căn mà mọi lo̱ tó mì oóc. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />Chíu hau chảng cỏ xáu xùm xưừng đủi căn, do̱ chăn Chảu Giê-xu thưng xảư, tò pay đủi hau. <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />Tọ ha sloong cần nỉnh ngài dà quá, mí nhă̱n oóc Min. <verse eid="LUK 24:16" /><verse number="17" style="v" sid="LUK 24:17" />Chíu nỉnh, Min cạ hau: “Chíu pay lo̱, kí cần ni̱ xùm xưừng lăng đủi căn è?” Hau dân đử dú, nả xàu. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />Dá cần nưng, mìng hít Cơ-lê-ô-ba, hòi vàm: “Cay tan ké chư̱ khéc dú slẻng Giê-ru-sa-lem mí chắc kí lo̱ mì oóc dú nỉnh kỉ vằn nảy?” <verse eid="LUK 24:18" /><verse number="19" style="v" sid="LUK 24:19" />Min tham: “Lo̱ lăng è?” Hau hòi vàm Min: “Lo̱ nỉnh mì oóc hử Giê-xu cần Na-xa-rét, chư̱ cần páo cón mì quỳn slèng chang vàm chảng xáu lo̱ hít tói nả Chảu Fạ xáu tằng phang cần, <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />tọ mí chắc pìn lừ kí slay pài xoòng tàu xáu kí cần căm tàu cú hung ngo̱ tó no̱p Min sle ngài cáp xá lèo hai, dá toóc teng Min tìng mạy các khoáy. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />Nhằng hung ngo̱ tó kháo mu̱ng Min chăn chư̱ Lạo thưng sle cháu cần Y-sơ-ra-ên. Ma̱i cạ pìn lừ, do̱ lo̱ nảy tó mì oóc đảy slam vằn dá. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />Tọ, mì kỉ cần ti̱ me̱ chang hung ngo̱ tó hít hử hung ngo̱ he, hau thưng fằn, chíu fạ ái slu̱ng <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />bó hăn sli hài Min haư chạy, hau mừ, nhằng li̱n te̱o slim khoăn đảy hăn mì cần tang nả fạ cạ Min nhằng te̱o. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />Kỉ cần chang hung ngo̱ xày pay nho̱m fằn xáu hăn mọi lo̱ chăn xị vàm kí da̱ nỉnh cạ, tọ hau mí hăn Min.” <verse eid="LUK 24:24" /><verse number="25" style="v" sid="LUK 24:25" />Dá Chảu Giê-xu cạ hau: “Kí pi̱ noọng chăn bả bứt, mí mì slim slấn khảu kí vàm cần páo cón chảng! <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />Bó chư̱ Chảu Cháu Ti̱ Da̱ lèo tảy chíp khỏ pìn nỉnh, dá chứng đảy khảu ti̱ slu̱ng phjưức cú Min do̱ lừ?” <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />Dá Min făn khay hử sloong ké kí vàm chảng mà Min chang thuủn xéc Vàm Chảu Fạ, xo tàu tứ kí xéc Môi-se thưng kí xéc cú cần páo cón. <verse eid="LUK 24:27" /><verse number="28" style="v" sid="LUK 24:28" />Slì sloong cần nèm slon thưng xảư bản slưửng thưng dá, do̱ Chảu Giê-xu hít xị nhằng ái pay hẳm quay num. <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />Tọ hau na̱i Min, cạ: “Xo dú đủi hung ngo̱, vi̱ fạ ái đăm dá.” Pìn nỉnh, Min khảu dú đủi hau. <verse eid="LUK 24:29" /><verse number="30" style="v" sid="LUK 24:30" />Chíu nă̱ng kin xáu sloong cần, Min căm pẻng, sleng slu̱, ẻo oóc, dá chao hử hau. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />Mư̱ nỉnh ha hau khay oóc xáu nhă̱n oóc Min, tọ Min te̱o phiín pay khói hau. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />Sloong cần chứng chảng đủi căn: “Bó chư̱ slim hung làu pìn xị fát mảy chíu Min chảng cỏ xáu făn khay ý xí cú Vàm Chảu Fạ hử hung làu to̱i lo̱ pay do̱ lừ?” <verse eid="LUK 24:32" /><verse number="33" style="v" sid="LUK 24:33" />Chăn tiỉm nỉnh, hau liìn tấn dân fan te̱o slẻng Giê-ru-sa-lem, phúng slíp ít cần đảy xoi pay xáu kí cần nèm slon táng tom te̱o dú nỉnh dủi hau, <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />xáu cạ: “Chảu chăn hòi te̱o xáu oóc nả đủi Si-môn đảy hăn!” <verse eid="LUK 24:34" /><verse number="35" style="v" sid="LUK 24:35" />Dá sloong cần nèm slon li̱n te̱o mọi lo̱ tó mì oóc chíu pay lo̱, xáu Min hử hau nhă̱n oóc chíu ẻo pẻng pìn lừ.<verse eid="LUK 24:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />Chíu sloong cần nèm slon nhằng chảng mà kí lo̱ nỉnh, do̱ chăn Chảu Giê-xu oóc tói nả hau dá cạ: “Pìng an hử pi̱ noọng.” <verse eid="LUK 24:36" /><verse number="37" style="v" sid="LUK 24:37" />Kí cần nèm slon xày he xáu túc dan, cứ la̱i đảy hăn slín lình. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />Min cạ hau: “Hít lừ kí pi̱ noọng slim luu̱n, xáu slim kí pi̱ noọng di̱ nhằng la̱i pìn nỉnh? <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />Cứ nho̱m mừ xáu kha ngo̱ nảy, chăn chư̱ ngo̱ né. Cứ khảu xảư tu̱ng khảu ngo̱ ngòi! Slín lình do̱ mí mì đúc đang đơ, tọ kí pi̱ noọng hăn ngo̱ mì đúc đang nảy cà.” <verse eid="LUK 24:39" /><verse number="40" style="v" sid="LUK 24:40" />Chảng vàm nỉnh dá, Min dặc mừ xáu kha oóc hử hau nho̱m. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />Chíu kí cần nèm slon nhằng xằng slấn vi̱ hun hỉ xáu he lai do̱ Min tham hau: “Dú nảy kí pi̱ noọng mì lăng kin mí?” <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />Kí cần nèm slon dèn hử Min ám pja pỉnh nưng; <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />Min căm au, dá kin tói nả hau.<verse eid="LUK 24:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44" />Lăng nỉnh, Min cạ hau: “Ngo̱ tó cạ kí vàm nảy slì ngo̱ nhằng dú đủi kí pi̱ noọng, mọi lo̱ tó slẻ mà ngo̱ chang luật fáp Môi-se, kí xéc páo cón, xáu kí Sli Thiin lèo đảy lình ính.” <verse eid="LUK 24:44" /><verse number="45" style="v" sid="LUK 24:45" />Chíu nỉnh, Min khay slim ki hử kí cần nèm slon sle slụ đảy Vàm Chảu Fạ, Min cạ hau: <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />pìn nảy: “Xị mì vàm slẻ: Chảu Cháu Ti̱ Da̱ lèo tảy chíp đát, thưng vằn ta̱i slam co̱i hòi te̱o tứ ti̱ hai, <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />hau lèo au mình Min sle páo cạ hử thuủn kí nòi cần, cạ lèo cho̱i xá sle đảy sla xá, xo tàu tứ slẻng Giê-ru-sa-lem. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />Kí pi̱ noọng chư̱ kí cần hít chửng mà mọi lo̱ nỉnh. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" />Ngo̱ nảy co̱i pảo hử kí pi̱ noọng mọi lo̱ Pá ngo̱ pao xình. Tọ fă̱n kí pi̱ noọng, cứ dú đưng slẻng tẳng thưng slì đảy nhă̱n au quỳn slèng tứ tìng slung.”<verse eid="LUK 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />Túc lăng, Min tái kí cần nèm slon thưng xảư bản Bê-tha-ni, dá Min dặc mừ khửn pảo fúc hử hau. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />Chíu Min nhằng pảo fúc, Min pja̱c kí cần nèm slon dá đảy dò khửn fạ. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />Kí cần nèm slon pái slớ Min, slim hau hun hỉ lai dá fan te̱o slẻng Giê-ru-sa-lem, <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />hau cứ dú chang lưừn slớ, tài slung Chảu Fạ.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>