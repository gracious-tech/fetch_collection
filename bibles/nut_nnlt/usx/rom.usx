  <book code="ROM" style="id">EN_NNLT nut-x-north_Northern⋅Nung_ltr Thu Jul 16 2026 15:20:00 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Romans</para>
  <para style="toc1">Baư slư Rô-ma</para>
  <para style="toc2">Rô-ma</para>
  <para style="toc3">Rom</para>
  <para style="mt">Rô-ma</para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />Phao-lô, cần khỏi cú Chảu Giê-xu Cháu Ti̱ Da̱, cần đảy Chảu xoi pay, cần đảy dảo, đảy tan sle hử Vàm Đay cú Chảu Fạ, <verse eid="ROM 1:1" /><verse number="2" style="v" sid="ROM 1:2" />chư̱ vàm Min tó pao xình tứ mư̱ pày quá kí cần páo cón cú Min chang Vàm Chảu Fạ, <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />mà Lu̱c Cú Min — Lạo đảy sleng oóc tứ nòi huùng Đa-vít nèm đúc đang; <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />Lạo đảy cạ chăn Lu̱c Chảu Fạ tứ quỳn slèng ho̱i te̱o tứ ti̱ hai nèm Slín lình slaư tích — chư̱ Chảu Giê-xu Cháu Ti̱ Da̱, Chảu hung làu, <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />pừng khảu Min, hung ngo̱ đảy nhă̱n fúc ma̱i cạ làu bó ngám, đảy cung sla̱y cần đảy xoi pay, sle thuủn kí nòi cần noo̱c slấn mình Min, <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />chang kí cần nỉnh, pi̱ noọng xày chư̱ kí cần đảy dảo sle slục mà Chảu Giê-xu Cháu Ti̱ Da̱. <verse eid="ROM 1:6" /><verse number="7" style="v" sid="ROM 1:7" />Phjác thưng thuủn kí cần dú slẻng Rô-ma, chư̱ kí cần đảy Chảu Fạ pèng điíp, đảy dảo hít cần slấn thánh. Xỉnh xo fúc đay xáu pình an tứ Chảu Fạ, Pá hung làu, xáu tứ Chảu, chư̱ Chảu Giê-xu Cháu Ti̱ Da̱ dú đủi pi̱ noọng!<verse eid="ROM 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />Ta̱i tàu, pừng khảu Chảu Giê-xu Cháu Ti̱ Da̱ ngo̱ sleng slu̱ Chảu Fạ cú ngo̱ mà thuủn kí pi̱ noọng, vi̱ slim slấn cú pi̱ noọng đảy páo oóc to̱i ti̱ da̱ dá. <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />Vi̱ Chảu Fạ chăn chư̱ cần hít chửng hử ngo̱ cạ, Lạo ngo̱ thuủn slim cung ta̱i chang Vàm Đay cú Lu̱c Cú Min, ngo̱ slưừng slì nẳm thưng pi̱ noọng, <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />chíu na̱i xo chang vàm làu xỉnh chàu cạ, hạy đảy do̱ cà nạy do̱ va̱ slì haư, ngo̱ co̱i pay thưng ti̱ pi̱ noọng chăn xị slim Chảu Fạ slưửng. <verse eid="ROM 1:10" /><verse number="11" style="v" sid="ROM 1:11" />Vi̱ ngo̱ mu̱ng đảy phúng pi̱ noọng, sle ngo̱ đảy păn vai xáu pi̱ noọng kí lo̱ Chảu khoăn pảo hử, sle pi̱ noọng đảy mắn slèng, <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />sle ngo̱ đảy nhòi slim đủi pi̱ noọng, pừng khảu slim slấn dú chang mọi cần, xị slim slấn cú tằng pi̱ noọng xáu ngo̱. <verse eid="ROM 1:12" /><verse number="13" style="v" sid="ROM 1:13" />Pi̱ noọng ới, ngo̱ mí ái pi̱ noọng bó chắc cạ tó lai pày ngo̱ slưửng pay dưưng pi̱ noọng (tọ thưng cà nạy ngo̱ di̱ nhằng ngài làn) sle slau slặp bjoóc mác tứ pi̱ noọng, xày xị tứ kí cần cú tum ti̱ táng; <verse eid="ROM 1:13" /><verse number="14" style="v" sid="ROM 1:14" />Ngo̱ slỉu nỉ tằng cần Hy Lạp xáu kí nòi cần táng, tằng cần thung slụ xáu cần tăn bả. <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />Pìn nỉnh, ngo̱ xày hàn chang múc slảy sle đảy páo oóc Vàm Đay hử pi̱ noọng cà nạy dú Rô-ma num.<verse eid="ROM 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />Chăn ngo̱ mí hăn nả nhẻn mà Vàm Đay đơ, vi̱ nảy chăn chư̱ quỳn slèng cú Chảu Fạ, sle cháu mọi cần slấn, sle cón hử kí cần Do Thái, xáu hử tằng cần Hy Lạp num. <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />Vi̱ lo̱ cung chính cú Chảu Fạ đảy hăn chang Vàm Đay nảy, tứ slim slấn thưng slim slấn, xị mì vàm slẻ: “Tọ cần cung chính pừng khảu slim slấn co̱i đảy te̱o.”<verse eid="ROM 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />Vi̱ xá fát fày cú Chảu Fạ tứ fạ đảy hử hăn sle tói tỉng te̱o mọi phít xá xáu dăm cung cú hau, chăn kí cần tỉng te̱o chăn lị, <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />vi̱ lo̱ lăng hau chắc mà Chảu Fạ, do̱ khát sla̱t dá, vi̱ Chảu Fạ tó hử hau chắc. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />Vi̱ tứ chíu Chảu Fạ chí oóc ti̱ da̱, kí lo̱ lăng mí hăn đảy, tằng cạ quỳn slèng xáu slín tơ̱i tơ̱i cú Min, đảy slim ki tu cần chắc khan quá kí lo̱ Min hít oóc, sle hau mí táng cho̱i xá hử làu đảy. <verse eid="ROM 1:20" /><verse number="21" style="v" sid="ROM 1:21" />Vi̱ ma̱i cạ chắc Chảu Fạ, tọ hau mí tài slung Min chăn chư̱ Chảu Fạ, xày mí sleng slu̱ Min. Tọ, slim ki hau ngài va̱i đai; slim tăn bả ngài đăm khít. <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />Hau táng cạ làu quai kí, tọ te̱o hử cần táng hăn làu tăn bả dá, <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />xáu hau tó tói slu̱ng phjưức cú Chảu Fạ mí va̱i slé sle au dưư̱ng slưứng va̱i slé cú tu cần, xày xị chủng nục, tu cú xáu kí chủng tu chàn tìng tum.<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />Pìn nỉnh, Chảu Fạ đo đứ hau khảu kí slém mu̱ng cú đúc đang làu, hít kí lo̱ slẳm sla̱p, hít va̱i đúc đang hau, <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />vi̱ hau tó tói chăn lị cú Chảu Fạ sle au pjàng pjào; pái slớ xáu cung ta̱i kí lo̱ mừ làu hít oóc, tháy vi̱ pái slớ chăn Lạo Chí Oóc, chư̱ Lạo ngám sle đảy că̱n thưng tơ̱i tơ̱i. A-men.<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />Vi̱ pìn nỉnh, Chảu Fạ chứng đo đứ hau khảu kí slém mu̱ng slẳm sla̱p, vi̱ kí ti̱ me̱ tói kí lo̱ kin nòn hít pìn táng. <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />Kí ti̱ po̱ xày pìn nỉnh, tó tả lo̱ kin nòn đủi ti̱ me̱ te̱o tảy kí slém mu̱ng đủi căn, sle ti̱ po̱ kin nòn đủi ti̱ po̱, dá chăn hau lèo tảy fa̱t ngám xáu lo̱ lùm slại cú làu.<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />Hau xày mí hăn lèo mì Chảu Fạ chang slim ki làu pìn đay, Chảu Fạ chứng đo đứ hử slim ki va̱i xảu sle fa̱m khảu kí lo̱ mí ngám, <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />slim ki hau tim mọi lo̱ dăm cung, xan éc, thám cò, too̱c éc, kí lo̱ cò că̱ng, khả cần, tò ke̱o, pjàng pjào, slảy khum; kí vàm chảng xảu, <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />la̱i slỉ, xằng Chảu Fạ, dúc dác, háo cao, ảng slưứng, nắt hít slại, mí ti̱ng vàm pá mé; <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />bả bứt, hít slại chao kiít, mí mì slim điíp, mí mì slim điíp sliít. <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />Ma̱i cạ hau chắc slim slưửng cung chính cú Chảu Fạ, hử kí cần nàư fa̱m kí phít xá pìn nỉnh do̱ lèo hai, tọ hau bó tan hít kí lo̱ nỉnh xày, hau te̱o nhằng khảu cò hử cần táng fa̱m num.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />Pìn nỉnh, ni̱ ới, ma̱i cạ cần nàư ứn chá, hạy ni̱ mí táng pang cho̱i hử xá làu đảy, vi̱ slì ni̱ ứn chá cần táng dá te̱o táng ứn chá làu, do̱ ni̱ xày pìn cần ứn chá, xày fa̱m kí lo̱ nỉnh. <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />Nhằng hung làu tó chắc cạ Chảu Fạ ứn chá nèm chăn lị sle tỉng te̱o kí cần fa̱m kí lo̱ nỉnh. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />Cần nỉnh ới, hạy ni̱ ứn chá kí cần fa̱m kí lo̱ pìn nỉnh, tọ chăn ni̱ te̱o xày hít, chư̱ ni̱ la̱i cạ làu co̱i khói ngài Chảu Fạ ứn chá mí? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />Do̱ va̱ ni̱ ngòi che̱n lo̱ fúng fàu cú slim quảng, slim tảy nẳm xáu tảy na̱i cú Min, vi̱ ni̱ mí chắc cạ slim quảng cú Chảu Fạ sle pang ni̱ cho̱i xá do̱ lừ? <verse eid="ROM 2:4" /><verse number="5" style="v" sid="ROM 2:5" />Tọ slim ni̱ kheng kích xáu mí nhă̱n cho̱i xá, do̱ táng hom fát fày hử ni̱ chang vằn fát fày, co̱i đảy hăn slì Chảu Fạ ứn chá cung phình, <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />vi̱ Chảu Fạ co̱i păng xàu hử mọi cần ngám xáu cung sla̱y hau hít. <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />Bửng nưng co̱i đảy te̱o tơ̱i tơ̱i hử kí cần xa slu̱ng phjưức, ngòi đay ha nả, xáu mắn slim hít kí lo̱ đay, <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />nhằng bưửng nỉnh, xá fát fày xáu fát slính sle hử cần nàư slảy khum, tỉng te̱o chăn lị tọ fục kí lo̱ dăm cung. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />Chai na̱n xáu chíp khỏ co̱i cháng lùng slim khoăn cú kí cần hít slại, ta̱i tàu hử cần Do Thái, lăng hử cần Hy Lạp. <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />Tọ slu̱ng phjưức, ha nả, xáu pình an co̱i pảo hử cần hít đay, ta̱i tàu hử cần Do Thái, lăng hử cần Hy Lạp. <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />Vi̱ Chảu Fạ mí nghiíng mà cần nàư chạy. <verse eid="ROM 2:11" /><verse number="12" style="v" sid="ROM 2:12" />Hạy kí cần nàư fa̱m xá te̱o mí mì luật fáp, do̱ co̱i hai vi̱ mí mì luật fáp; nhằng kí cần nàư mì luật fáp te̱o fa̱m xá, do̱ co̱i ngài luật fáp ứn chá. <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />Vi̱ bó chư̱ kí cần ti̱ng mà luật fáp do̱ đảy cung chính tói nả Chảu Fạ, tọ kí cần hít nèm luật fáp chứng đảy dảo cung chính. <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />Vi̱ kí cần cú tum ti̱ táng mí mì luật fáp, tọ táng hít kí lo̱ luật fáp slon cạ, do̱ ma̱i cạ hau mí mì luật fáp, hau tó táng pìn luật fáp hử chăn làu dá, <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />kí cần nỉnh hử hăn cạ kí lo̱ luật fáp slon cạ đảy slẻ chang slim hau dá; chíu slim hau xày hít chửng hử, hau táng nẳm chang slim, slì do̱ hử làu slại, slì do̱ hử làu chăn chư̱ <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />khảu vằn Chảu Fạ co̱i ứn chá kí lo̱ dăm dò cú tu cần quá Chảu Giê-xu Cháu Ti̱ Da̱, xị Vàm Đay ngo̱ páo oóc.<verse eid="ROM 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />Nhằng hạy ni̱ cạ làu chư̱ cần Do Thái, te̱o pừng khảu luật fáp, ảng slưứng vi̱ mì Chảu Fạ, <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />thung slụ slim slưửng Min, chắc kí lo̱ chăn xáu lo̱ chư̱ vi̱ đảy slon tứ luật fáp, <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />xáu hạy ni̱ slấn cạ làu chư̱ cần tái lo̱ hử kí cần fàng, áng slu̱ng hử kí cần dú chang ngàu đăm <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />tái lo̱ hử kí cần tăn, hít slay slon cần ón bả, vi̱ la̱i cạ làu thung slụ xáu mì chăn lị chang luật fáp, <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />pìn nỉnh, ni̱ slon cạ cần táng, te̱o mí táng slon cạ chăn làu do̱ lừ? Ni̱ slon cần táng mí kin lặc, ni̱ kin lặc mí? <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />Ni̱ cạ mí đảy fa̱m xá pay chụ, ni̱ pay chụ mí? Ni̱ xằng kí xằn tum, ni̱ kin lặc kí ti̱ thỏ cung mí? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />Ni̱ táng ảng slưứng làu vi̱ mì luật fáp hít, ni̱ fa̱m fáp hít xảu nả Chảu Fạ mí? <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />Vi̱ “mình Chảu Fạ ngài hung mưng hít xảu nả chang kí cần cú tum ti̱ táng,” chăn xị vàm slẻ. <verse eid="ROM 2:24" /><verse number="25" style="v" sid="ROM 2:25" />Chăn, slắp năng chăn chư̱ đay hạy ni̱ hít nèm luật fáp; tọ hạy ni̱ fa̱m fáp, do̱ ni̱ slắp năng te̱o bó slắp năng. <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />Pìn nỉnh, hạy cần nưng xằng slắp năng te̱o hít nèm kí vàm man chang luật fáp slon, do̱ bó chư̱ hau xằng slắp năng, te̱o đảy ngòi xị nhă̱n slắp năng dá do̱ lừ? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />Slì hít nèm luật fáp, kí cần xằng slắp năng mà đúc đang co̱i ứn chá ni̱, chăn kí cần nèm slư ha xáu slắp năng, te̱o pìn fa̱m fáp. <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />Vi̱ mí chư̱ cần nưng tan ngòi bưửng noo̱c do̱ pìn cần Do Thái chăn, xày bó chư̱ tứ đúc đang bưửng noo̱c do̱ pìn slắp năng chăn. <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />Tọ, lèo ngòi bưửng đưng chứng chắc chư̱ cần Do Thái; xáu lo̱ slắp năng chăn tứ slim oóc vi̱ Chảu Khoăn, bó chư̱ nèm slư ha, bó chư̱ cần nỉnh đảy tu cần că̱n, tọ đảy Chảu Fạ că̱n.<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />Pìn nỉnh hít cần Do Thái do̱ đảy lăng mí? Do̱ va̱ slắp năng do̱ đảy lăng mí? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />Đảy đay mọi lo̱! Ta̱i tàu, cần Do Thái đảy chao vàm Chảu Fạ. <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />Sle hít lăng hạy mì kỉ cần mí slấn? Chư̱ slim hau mí slấn te̱o hít hử slim đeo cú Chảu Fạ oóc va̱i đai mí? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />Mí pìn nỉnh đảy! Tọ, Chảu Fạ chư̱ chăn, nhằng mọi cần xày pjàng pjào. Xị mì vàm slẻ cạ:</para>
  <para style="q1" vid="ROM 3:4">“Ma̱i cạ pìn lừ do̱ Chảu cung chính chang vàm cú Min,</para>
  <para style="q1" vid="ROM 3:4">dá Min co̱i hình slì ngài ứn chá.”<verse eid="ROM 3:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="ROM 3:5" />Tọ hạy kí lo̱ mí cung chính cú hung làu hử hăn lo̱ cung chính cú Chảu Fạ, do̱ hung làu co̱i chảng pìn lừ? Chư̱ Chảu Fạ dăm cung slì Min cháng xá fát fày tìng hung làu mí? (Ngo̱ chảng xị cần tơ̱i nảy). <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />Bó pìn nỉnh đảy! Vi̱ hạy pìn nỉnh do̱ hít lừ Chảu Fạ ứn chá ti̱ da̱ đảy? <verse eid="ROM 3:6" /><verse number="7" style="v" sid="ROM 3:7" />Nhằng hạy chăn lị cú Chảu Fạ hít hử Min slu̱ng phjưức quá kí lo̱ pjàng pjào num, do̱ hít lăng ngo̱ nhằng ngài cáp xá xị cần phít xá? <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />Mí chư̱ (xị hung ngo̱ ngài kỉ cần la̱i xan hung ngo̱ chảng cạ) “Hung làu lèo hít lo̱ slại sle đảy lo̱ đay,” do̱ lừ? Hau ngài ứn chá chăn ngám lai.<verse eid="ROM 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />nỉnh do̱ pìn lừ? Hung làu mì lăng hẳm đay mí? Mí mì lăng chạy. Vi̱ hung ngo̱ tó cạ tằng cần Do Thái xáu cần Hy Lạp, xày lèo dú tảư quỳn cú phít xá, <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />Xị mì vàm slẻ cạ:</para>
  <para style="q1" vid="ROM 3:10">“Bó mì slắc cần cung chính chạy, ma̱i cạ cần nưng tó mí mì.<verse eid="ROM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ROM 3:11" />Bó mì slắc cần thung slụ.</para>
  <para style="q1" vid="ROM 3:11">Bó mì slắc cần xa thắp Chảu Fạ.<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />Mọi cần xày pay lùm slại. Hung min xày pìn va̱i đai.</para>
  <para style="q1" vid="ROM 3:12">Bó mì slắc cần hít lo̱ đay, ma̱i cạ cần nưng tó mí mì.”<verse eid="ROM 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />“Slai cò hung min xị ăn fằn khay quạc.</para>
  <para style="q1" vid="ROM 3:13">Au lịn làu sle pjàng pjào.</para>
  <para style="q1" vid="ROM 3:13">Nọc ngù too̱c dú tảư phi pác cú hung min,”<verse eid="ROM 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ROM 3:14" />“pác hung min tim kí vàm bjắc bjỏi xáu khum phít.”<verse eid="ROM 3:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />“Kha hung min nắt hít lay lưư̱t,<verse eid="ROM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ROM 3:16" />Hít oóc chai na̱n xáu chíp khỏ tìng lo̱ hung min pay.<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />Hung min bó chắc tèo lo̱ pình lình.”<verse eid="ROM 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ROM 3:18" />“Ha hung min mí kiính lao Chảu Fạ.”<verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />Hung làu chắc kí lo̱ luật fáp slon cạ, sle chảng hử kí cần nàư dú tảư luật fáp, sle mọi phi pác lèo hắp khảu, xáu tằng mọi cần tìng ti̱ da̱ xày nhă̱n xá làu tói nả Chảu Fạ; <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />tói nả Min, bó mì slắc cần đảy dảo cung chính tứ kí cung sla̱y hít nèm luật fáp; vi̱ hau nhă̱n chắc phít xá làu quá luật fáp.<verse eid="ROM 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />Tọ cà nạy, lo̱ cung chính cú Chảu Fạ đảy hử hăn te̱o mí cẩn thưng luật fáp, slì đảy luật fáp xáu kí cần páo cón hít chửng dá, <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />tọ lo̱ cung chính cú Chảu Fạ, pừng khảu slim slấn ti̱ Chảu Giê-xu Cháu Ti̱ Da̱, hử mọi cần mì slim slấn, vi̱ bó păn pjết cần nàư chạy; <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />vi̱ mọi cần xày fa̱m xá, chứng slỉu pay slu̱ng phjưức cú Chảu Fạ; <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />hau đảy dảo cung chính te̱o mí lèo păng lăng mòn, pừng khảu fúc ma̱i cạ làu bó ngám đảy Min pảo hử quá Chảu Giê-xu Cháu Ti̱ Da̱, <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />Lạo đảy Chảu Fạ slưửng cón sle hít sleng lình cháu phít xá hử kí cần mì slim slấn khảu lưư̱t Lạo nỉnh, sle hử hăn lo̱ cung chính cú Chảu Fạ, vi̱ Min mí án thưng kí phít xá mư̱ cón. <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />Tọ slim tảy nẳm cú Chảu Fạ ái hử hăn cạ Min chư̱ cung chính, sle hít hử cần slấn khảu Chảu Giê-xu đảy dảo cung chính.<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />Pìn nỉnh do̱, ảng slưứng khảu haư? Bó mì lăng sle ảng slưứng chạy. Pừng khảu luật fáp haư? Luật cú cung sla̱y làu hít do̱ lừ? Mí chư̱! Tọ pừng khảu luật cú slim slấn. <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />Vi̱ hung làu slấn cạ cần nưng đảy dảo cung chính pừng khảu slim slấn, tọ mí chư̱ pừng kí lo̱ làu hít nèm luật fáp. <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />Chảu Fạ tan cú cần Do Thái xày do̱ lừ? Mí chư̱ cú cần cú tum ti̱ táng num do̱ lừ? Chư̱ vớ! Min xày chư̱ Chảu Fạ cú cần cú tum ti̱ táng num, <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />vi̱ tan mì Chảu Fạ đeo, chư̱ Lạo co̱i hít hử cần nhă̱n slắp năng đảy dảo cung chính pừng slim slấn, xáu hử cần mí nhă̱n slắp năng pừng slim slấn nỉnh num. <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />Pìn nỉnh, hung làu te̱o tả luật fáp vi̱ slim slấn nỉnh do̱ lừ? Mí pìn nỉnh đảy! Tọ, hung làu lèo hít mắn táng luật fáp.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />Pìn nỉnh, hung làu lèo chảng mà Áp-ra-ham, cúc chỏ cú hung làu mà fă̱n đúc đang, tó đảy lăng? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />Vi̱ hạy Áp-ra-ham đảy dảo cung chính vi̱ kí lo̱ min hít, do̱ ké mì cúc căn sle ảng slưứng làu, tọ mí chư̱ tói nả Chảu Fạ. <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />Vi̱ Vàm Chảu Fạ chảng lăng? “Áp-ra-ham slấn Chảu Fạ, pìn nỉnh ké chứng đảy dảo cung chính.” <verse eid="ROM 4:3" /><verse number="4" style="v" sid="ROM 4:4" />Tọ, cần hít cung, do̱ chèn cung mí đảy ngòi xị fúc, tọ pìn xị nỉ. <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />Nhằng xáu cần mí hít cung, te̱o slấn khảu Lạo hít hử cần phít xá đảy pìn cung chính, do̱ slim slấn cú cần nỉnh đảy dảo xị cung chính. <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />Xị huùng Đa-vít chảng mà fúc cú cần đảy Chảu Fạ dảo hít cung chính te̱o mí chư̱ pừng lo̱ hau hít:<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />“Fúc hử cần nàư mì phít xá đảy sla dưư̱ng,</para>
  <para style="q1" vid="ROM 4:7">xáu phít xá làu đảy pùn dà!<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />Fúc hử cần nàư Chảu mí án thưng phít xá cú min!”<verse eid="ROM 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="ROM 4:9" />Pìn nỉnh, fúc đay nỉnh tan sle hử kí cần nhă̱n slắp năng, do̱ va̱ hử tằng cần mí nhă̱n slắp năng num? Vi̱ hung làu chảng cạ: “Slim slấn nỉnh đảy pìn cung chính hử Áp-ra-ham.” <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />Tọ slim slấn nỉnh đảy dảo cung chính pìn lừ? Chíu nhă̱n slắp năng dá do̱ va̱ chíu xằng nhă̱n slắp năng? Mí chư̱ chíu nhă̱n slắp năng dá, tọ chíu xằng nhă̱n slắp năng? <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />Ké tó nhă̱n ha̱o slắp năng xị ín chửng hử slim slấn cung chính, tứ slim slấn chíu xằng slắp năng, sle ké pìn cúc chỏ cú kí cần slấn tọ xằng slắp năng, sle kí cần nỉnh đảy dảo cung chính; <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />xày sle ké pìn cúc chỏ cú kí cần đảy slắp năng, mí chư̱ tan đảy slắp năng, te̱o nhằng pìn kí cần hít nèm slim slấn Áp-ra-ham, cúc chỏ hung làu, chíu xằng slắp năng.<verse eid="ROM 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />Vàm pao xình hử Áp-ra-ham xáu nòi cần cú ké, sle min đảy nhă̱n ti̱ da̱, mí chư̱ tứ luật fáp, tọ pừng khảu cung chính cú slim slấn. <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />Vi̱ hạy kí cần pừng khảu luật fáp chứng đảy táp cha xài, do̱ slim slấn pìn va̱i đai, xáu vàm pao xình tó mí pìn lăng. <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />Vi̱ luật fáp hít pìn xá fát fày, tọ ti̱ haư mí mì luật fáp do̱ mí mì cần fa̱m xá. <verse eid="ROM 4:15" /><verse number="16" style="v" sid="ROM 4:16" />Pìn nỉnh, kí cần pừng slim slấn đảy táp cha xài, đảy nhă̱n fúc ma̱i cạ làu bó ngám, sle vàm pao xình nỉnh mắn táng hử kí xám cần lăng: mí tan hử kí cần tảư quỳn luật fáp, tọ nhằng hử kí cần mì slim slấn xị Áp-ra-ham, xày chư̱ cúc chỏ cú thuủn hung làu, <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />xị mì vàm slẻ: “Cau tó tặt lu̱c hít pá cú lai nòi cần,” dú tói nả Lạo min tó slấn, chư̱ Chảu Fạ, Lạo hít hử cần hai đảy te̱o, dảo kí lo̱ mí mì xị tó mì dá; <verse eid="ROM 4:17" /><verse number="18" style="v" sid="ROM 4:18" />ké tó slấn pừng khảu slim kháo mu̱ng ma̱i cạ mí nhằng lăng sle kháo mu̱ng; sle ké nhằng pìn pá cú lai nòi cần, xị vàm tó cạ ké: “Nòi cần cú lu̱c co̱i lai pìn nỉnh.” <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />Ké nhằng slấn mắn, ma̱i cạ ké hăn đúc đang xị ái hai dá (ké ái đảy pác pi), nhằng da̱ Sa-ra do̱ tọng lu̱c tó kháư dá. <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />Tọ slấn khảu vàm Chảu Fạ pao xình, slim slấn ké bó la̱i slắc í, pắn te̱o, slim slấn ké hẳm mắn táng, chíu pài slu̱ng phjưức hử Chảu Fạ, <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />vi̱ ké thuủn slim slấn cạ vàm Chảu Fạ tó pao xình, do̱ Min mì quỳn slèng sle hít pìn <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />Pìn nỉnh, slim slấn cú ké đảy dảo cung chính. <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />Tọ xị vàm slẻ cạ: “slim slấn cú ké đảy dảo cung chính” mí chư̱ chảng mà tan ké đơ <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />te̱o nhằng hử hung làu, hử kí cần slấn co̱i đảy dảo cung chính, chăn chư̱ hử kí cần slấn khảu Lạo tó hít hử Chảu Giê-xu, Chảu hung làu, hòi te̱o tứ ti̱ hai, <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />Min tó ngài no̱p vi̱ phít xá cú hung làu, dá hòi te̱o sle hung làu đảy dảo cung chính.<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />Pìn nỉnh, slì đảy dảo cung chính pừng khảu slim slấn, hung làu đảy pay te̱o xáu Chảu Fạ quá Chảu hung làu, chăn chư̱ Chảu Giê-xu Cháu Ti̱ Da̱, <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />quá Lạo nỉnh, pừng slim slấn hung làu chứng đảy khảu táp fúc Chảu pảo hử ma̱i cạ làu bó ngám, xị hung làu cà nạy đảy mắn táng, dá hung làu te̱o nhằng hun hỉ mà slim kháo mu̱ng slu̱ng phjưức cú Chảu Fạ <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />Tọ mí tan pìn nỉnh, hung làu nhằng hun hỉ chíu phúng kí chíp khỏ num, vi̱ chắc cạ quá chíp khỏ do̱ chứng tảy na̱i đảy; <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />hạy tảy na̱i đảy do̱ slim slấn chứng đảy cung nhă̱n, nhằng slim slấn đảy cung nhă̱n do̱ chứng mì kháo mu̱ng, <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />Kháo mu̱ng nỉnh bó hít nả nhẻn, vi̱ Chảu Fạ tó đíng slim điíp khảu slim hung làu, quá Chảu Khoăn chư̱ Lạo tó đảy pảo hử hung làu. <verse eid="ROM 5:5" /><verse number="6" style="v" sid="ROM 5:6" />Xằng thuủn, slì hung làu nhằng ón slim, do̱ khảu chúng slì Chảu Cháu Ti̱ Da̱ tó hai tháy phít xá hung làu dá. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />Chăn khỏ lai chứng mì cần nhă̱n hai tháy hử cần cung chính. Ma̱i cạ mì cần xày cảm hai tháy hử cần đay. <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />Tọ Chảu Fạ hử hăn slim điíp cú Min xáu hung làu, slì hung làu nhằng chư̱ kí cần phít xá, do̱ Chảu Cháu Ti̱ Da̱ tó hai tháy hử hung làu. <verse eid="ROM 5:8" /><verse number="9" style="v" sid="ROM 5:9" />Pìn nỉnh, cà nạy hung làu tó đảy dảo cung chính pừng khảu lưư̱t Min dá, do̱ pừng khảu Min hung làu co̱i đảy cháu khói xá fát fày hẳm lai num. <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />Vi̱ hạy hung làu ma̱i cạ nhằng tói tàu, tó đảy pìn đay xáu Chảu Fạ quá lo̱ hai cú Lu̱c Min, do̱ đảy hít pìn đay dá, hung làu hẳm đảy cháu pừng khảu lo̱ te̱o cú Lu̱c Min num. <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />Mí tan pìn nỉnh, hung làu te̱o nhằng hun hỉ chang Chảu Fạ, vi̱ pừng Chảu hung làu, chăn Chảu Giê-xu Cháu Ti̱ Da̱, quá Min, cà nạy hung làu chứng đảy hít đay xáu Chảu Fạ.<verse eid="ROM 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />Vi̱ pìn nỉnh, xị tan quá cần nưng phít xá tó khảu ti̱ da̱, xáu vi̱ phít xá chứng mì lo̱ hai, pìn nỉnh mọi cần xày lèo hai, vi̱ thuủn mọi cần tó fa̱m xá. <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />Vi̱ chíu xằng mì luật fáp, do̱ tó mì phít xá chang ti̱ da̱ dá, tọ phít xá do̱ mí đảy chảng thưng hạy xằng mì luật fáp. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />Tọ, lo̱ hai tó cai cuủn tứ tơ̱i A-đam thưng tơ̱i Môi-se, thưng tằng kí cần mí fa̱m xá hút xị phít xá cú A-đam, chăn ké chư̱ slưứng ngàu cú Lạo lèo thưng.<verse eid="ROM 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 5:15" />Tọ, phít xá mí hút xị kí lo̱ đảy Chảu Fạ pảo hử. Vi̱ hạy tứ phít xá cú tan cần nưng, hít hử mọi cần táng te̱o lèo hai, do̱ fúc đay tứ cần nưng, chăn chư̱ cú Chảu Fạ tứ fúc đay cú Chảu Giê-xu Cháu Ti̱ Da̱ pảo hử lai cần ma̱i cạ hau bó ngám, te̱o hẳm fúng fàu thưng haư num! <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />Kí lo̱ pảo hử nảy mí hút xị quá phít xá cú cần nưng. Vi̱ ma̱i cạ tứ tan cần nưng, te̱o hít hử mọi cần ngài ứn chá sle ngài cáp xá, fa̱m xá kỉ lai pày pay num, xày đảy pảo hử pìn cung chính. <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />Hạy tan vi̱ phít xá cú cần nưng, lo̱ hai te̱o cai cuủn quá cần nỉnh, do̱ kí cần nhă̱n đảy fúc Chảu pảo hử ma̱i cạ cần nỉnh bó ngám, xáu fă̱n slưởng cung chính co̱i cai cuủn hẳm lai chang lo̱ te̱o quá cần nưng, chăn chư̱ Chảu Giê-xu Cháu Ti̱ Da̱. <verse eid="ROM 5:17" /><verse number="18" style="v" sid="ROM 5:18" />Pìn nỉnh, vi̱ tan cần nưng fa̱m xá, mọi cần táng chứng ngài cáp xá, xày vi̱ tan cần nưng hít lo̱ cung chính, do̱ mọi cần táng chứng đảy dảo cung chính cú lo̱ te̱o pìn nỉnh. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />Vi̱, xị tan cần nưng mí ti̱ng vàm cú Chảu Fạ, mọi cần chứng fa̱m xá, do̱ xày pìn nỉnh, vi̱ cần nưng ti̱ng vàm mọi cần táng te̱o đảy cung chính. <verse eid="ROM 5:19" /><verse number="20" style="v" sid="ROM 5:20" />Luật fáp tó hít hử phít xá lai khửn. Tọ ti̱ haư phít xá lai khửn, do̱ fúc Chảu pảo hử ma̱i cạ làu bó ngám, te̱o hẳm fúng fàu num, <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />sle phít xá cai cuủn lo̱ hai pìn lừ, do̱ fúc đay xày cai cuủn cung chính pìn nỉnh, sle đảy te̱o tơ̱i tơ̱i pừng Chảu Giê-xu Cháu Ti̱ Da̱, chăn Chảu hung làu.<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />Pìn nỉnh, hung làu co̱i chảng pìn lừ? Hung làu cứ dú chang phít xá sle hẳm đảy nhă̱n fúc ma̱i cạ làu bó ngám do̱ lừ? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />Mí pìn nỉnh đảy! Hung làu tó hai fă̱n phít xá, do̱ hít lừ hung làu nhằng dú chang phít xá đảy? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />Pi̱ noọng mí chắc cạ hạy cần nàư nhă̱n báp-têm chang Chảu Giê-xu Cháu Ti̱ Da̱ do̱ đảy nhă̱n báp-têm chang lo̱ hai cú Min do̱ lừ? <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />Pìn nỉnh, hung làu tó đảy phăng khảu lo̱ hai xáu Min quá báp-têm, sle Chảu Cháu Ti̱ Da̱ pừng slu̱ng phjưức cú Pá đảy hòi te̱o tứ ti̱ hai pìn lừ, do̱ hung làu xày đảy phjải pay chang lo̱ te̱o máư pìn nỉnh. <verse eid="ROM 6:4" /><verse number="5" style="v" sid="ROM 6:5" />Vi̱ hạy hung làu tó đảy hai hút xị Min tó hai, do̱ hung làu co̱i xày đảy hòi te̱o xáu Min; <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />vi̱ chắc cạ, tu cần cáu cú hung làu xày ngài toóc teng khảu mạy các khoáy xáu Min, sle đúc đang phít xá ngài chii̱t pay, bó nhằng hít khỏi hử phít xá dá. <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />Vi̱ cần nàư tó hai do̱ đảy oóc khói phít xá. <verse eid="ROM 6:7" /><verse number="8" style="v" sid="ROM 6:8" />Tọ hạy hung làu xày hai đủi Chảu Cháu Ti̱ Da̱, do̱ hung làu slấn cạ làu xày co̱i tò te̱o đủi Min. <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />Vi̱ chắc cạ chíu tó hòi te̱o tứ ti̱ hai, do̱ Chảu Cháu Ti̱ Da̱ mí nhằng hai slắc pày num; lo̱ hai mí nhằng cai cuủn tìng Min. <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />Vi̱ Min tó hai, chư̱ hai hử phít xá, Min hai pày nưng do̱ đo dá. Nhằng Min te̱o, chư̱ Min te̱o hử Chảu Fạ. <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />Xày pìn nỉnh, pi̱ noọng xày lèo ngòi làu xị cần hai mà fă̱n phít xá, sle te̱o hử Chảu Fạ chang Chảu Giê-xu Cháu Ti̱ Da̱.<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />Pìn nỉnh, mí đảy sle phít xá cai cuủn đúc đang lèo hai cú pi̱ noọng num, sle pi̱ noọng lèo hít nèm kí slém mu̱ng cú min. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />Xày mí đảy no̱p kí fă̱n đúc đang làu cung ta̱i dăm cung hử phít xá. Tọ lèo sle đúc đang làu hử Chảu Fạ, xị kí cần tứ ti̱ hai hòi te̱o, au đúc đang làu hít lo̱ cung chính hử Chảu Fạ <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />Vi̱ phít xá co̱i mí nhằng cai cuủn tìng pi̱ noọng dá, vi̱ pi̱ noọng mí nhằng dú tảư luật fáp, tọ đảy Chảu pảo fúc ma̱i cạ làu bó ngám.<verse eid="ROM 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />nỉnh do̱ pìn lừ? Chư̱ hung làu fa̱m xá vi̱ bó pừng luật fáp, tọ pừng fúc Chảu pảo hử ma̱i cạ làu bó ngám mí? Bó pìn nỉnh đảy! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />Pi̱ noọng mí chắc cạ hạy no̱p đúc đang hử ca lăng, do̱ pìn xị hít khỏi hử kí lo̱ làu fục do̱ lừ? Ma̱i cạ hít khỏi hử phít xá do̱ co̱i lèo hai, do̱ va̱ fục sle đảy pìn cung chính. <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />Tọ sleng slu̱ Chảu Fạ, vi̱ mư̱ cón pi̱ noọng hít khỏi hử phít xá, tọ te̱o thuủn slim hít nèm ta̱o lị làu đảy slon cạ. <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />Nhằng pi̱ noọng tó đảy oóc khói phít xá, pi̱ noọng te̱o pìn hít khỏi hử kí lo̱ cung chính. <verse eid="ROM 6:18" /><verse number="19" style="v" sid="ROM 6:19" />Ngo̱ chảng xị tu cần vi̱ đúc đang pi̱ noọng nhằng ón. Pi̱ noọng tó no̱p kí fă̱n đúc đang làu hít khỏi kí lo̱ slẳm sla̱p, too̱c éc pìn lừ, do̱ cà nạy, xày lèo sle đúc đang làu hít khỏi hử kí lo̱ cung chính sle đảy slaư tích pìn nỉnh. <verse eid="ROM 6:19" /><verse number="20" style="v" sid="ROM 6:20" />Slì nhằng hít khỏi hử phít xá, do̱ pi̱ noọng ái hít do̱ mí hít kí lo̱ cung chinh tó đảy. <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />Chíu nỉnh, pi̱ noọng đảy lăng, cà nạy te̱o táng hăn xảu nả? Vi̱ hang lăng cú kí lo̱ nỉnh co̱i lèo hai. <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />Tọ cà nạy, đảy oóc khói phít xá xáu hít khỏi hử Chảu Fạ, do̱ hang lăng pi̱ noọng đảy slaư tích, sloót hang co̱i đảy te̱o tơ̱i tơ̱i. <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />Vi̱ chèn cung cú phít xá chư̱ lèo hai, tọ Chảu Fạ pảo hử lo̱ te̱o tơ̱i tơ̱i chang Chảu Giê-xu Cháu Ti̱ Da̱, Chảu hung làu.<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />Pi̱ noọng ới — vi̱ ngo̱ chảng đủi kí cần chắc luật fáp — pi̱ noọng mí chắc cạ luật fáp tan mì quỳn tìng tu cần slì nhằng te̱o xày do̱ lừ? <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />Vi̱ cần ti̱ me̱ mì po̱ ngài luật fáp pắt lèo nèm po̱ nhằng te̱o, tọ hạy po̱ hai, do̱ me̱ đảy kẻ oóc luật fáp khói cần po̱ nỉnh. <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />Pìn nỉnh, chíu po̱ nhằng te̱o, hạy me̱ pay au cần ti̱ po̱ đai, do̱ me̱ co̱i ngài dảo cạ cần pay chụ. Tọ hạy po̱ hai, do̱ me̱ đảy sla khói luật fáp, mí chư̱ ti̱ me̱ pay chụ ma̱i cạ pay au po̱ đai. <verse eid="ROM 7:3" /><verse number="4" style="v" sid="ROM 7:4" />Xày pìn nỉnh, pi̱ noọng cú ngo̱ ới, chăn pi̱ noọng xày hai mà luật fáp pừng khảu đúc đang cú Chảu Cháu Ti̱ Da̱. Sle pi̱ noọng slục mà cần táng, chư̱ đảy hòi te̱o tứ ti̱ hai, sle hung làu pìn mác hử Chảu Fạ <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />Slì hung làu nhằng dú chang đúc đang, do̱ kí slém mu̱ng cú phít xá quá luật fáp, tó hít chang kí fă̱n đúc đang hung làu co̱i pìn mác hử lo̱ hai. <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />Tọ cà nạy hung làu đảy oóc khói luật fáp, vi̱ tó hai đủi kí lo̱ tó xăng hung làu, sle hung làu cung ta̱i nèm lo̱ máư cú Chảu Khoăn, tó mí nèm lo̱ cáu cú slư ha dá.<verse eid="ROM 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />Pìn nỉnh, hung làu co̱i chảng pìn lừ? Luật fáp chư̱ phít xá do̱ lừ? Mí pìn nỉnh đảy! Tọ, hạy ngo̱ mí pừng khảu luật fáp, do̱ mí chắc thưng phít xá. Hạy luật fáp mí chảng cạ: “Mưng mí đảy thám cò” do̱ ngo̱ tó mí chắc thám cò pìn lừ lố. <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />Tọ phít xá, tó căm au chúng slì quá vàm man, khay oóc đo mọi lo̱ slém mu̱ng chang ngo̱. Vi̱ mí mì luật fáp do̱ phít xá co̱i hai. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />Mư̱ cón, mí mì luật fáp do̱ ngo̱ te̱o; tọ tứ slì mì vàm man do̱ phít xá tó hòi te̱o, <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />nhằng ngo̱ do̱ hai. Hạy vàm man lèo hít hử ngo̱ te̱o, do̱ luật fáp te̱o tái ngo̱ thưng lo̱ hai. <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />Vi̱ chíu tẳng chúng slì pừng khảu vàm man, phít xá tó pjàng pjào sle khả hai ngo̱. <verse eid="ROM 7:11" /><verse number="12" style="v" sid="ROM 7:12" />Pìn nỉnh, luật fáp chăn thánh, vàm man xày pìn thánh, cung phình xáu chăn đay.<verse eid="ROM 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 7:13" />Pìn nỉnh, chư̱ lo̱ đay tó pìn lo̱ hai hử ngo̱ mí? Mí pìn nỉnh đảy! Tọ quá lo̱ đay sle phít xá chứng ngài dẻng oóc, tái ngo̱ thưng lo̱ hai, dá quá vàm man, phít xá te̱o pìn hẳm too̱c éc num. <verse eid="ROM 7:13" /><verse number="14" style="v" sid="ROM 7:14" />Vi̱ hung làu chắc cạ luật fáp chăn chư̱ lình ính; nhằng ngo̱ chư̱ cần đúc đang, tó ngài khai hử phít xá dá. <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />Ngo̱ mí slụ lo̱ làu hít. Vi̱ bó chư̱ ngo̱ hít lo̱ làu ái. Tọ te̱o hít lo̱ làu xằng. <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />Tọ hạy ngo̱ hít lo̱ làu mí ái, do̱ ngo̱ chắc luật fáp chư̱ đay. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />Tọ cà nạy chăn ngo̱ mí nhằng hít lo̱ nỉnh dá, tọ phít xá dú chang ngo̱ hít. <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />Ngo̱ chắc cạ lo̱ đay mí dú chang ngo̱, chư̱ chang đúc đang ngo̱. Vi̱ ngo̱ mu̱ng hít lo̱ đay, tọ ngo̱ mí hít lo̱ đay đảy. <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />Vi̱ lo̱ đay ái hít ngo̱ te̱o mí hít, tọ lo̱ slại làu mí ái, do̱ ngo̱ te̱o hít. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />Nhằng hạy ngo̱ hít lo̱ làu mí ái, do̱ mí nhằng chư̱ ngo̱ hít dá, tọ chăn phít xá nhằng dú chang ngo̱ hít. <verse eid="ROM 7:20" /><verse number="21" style="v" sid="ROM 7:21" />Pìn nỉnh, ngo̱ hăn mì luật nảy, slì ngo̱ ái hít lo̱ đay, do̱ lo̱ slại nhằng chắp khảu ngo̱. <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />Vi̱ ngo̱ hun fằng chang slim mà luật cú Chảu Fạ lai. <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />Tọ ngo̱ nho̱m hăn mì luật táng nưng chang kí fă̱n đúc đang làu tò tức xáu luật cú slim ki, pắt ngo̱ lèo hít nèm luật cú phít xá, chư̱ luật dú chang kí fă̱n đúc đang ngo̱. <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />Ngo̱ chăn khỏ lai! Cần nàư co̱i cháu ngo̱ khói đúc đang lèo hai nảy? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />Sleng slu̱ Chảu Fạ, pừng khảu Chảu Giê-xu Cháu Ti̱ Da̱, chư̱ Chảu hung làu! Pìn nỉnh, chăn slim ki làu fục luật fáp cú Chảu Fạ, tọ nèm đúc đang, do̱ fục luật cú phít xá.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />Pìn nỉnh do̱, cà nạy, bó mì án fạt càư hử kí cần dú chang Chảu Giê-xu Cháu Ti̱ Da̱ dá. <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />Vi̱ luật cú Chảu Khoăn pảo lo̱ te̱o chang Chảu Giê-xu Cháu Ti̱ Da̱ tó cháu ngo̱ oóc khói luật cú phít xá xáu lo̱ hai. <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />Lo̱ lăng luật fáp mí hít đảy, vi̱ ngài fă̱n đúc đang hít hử ón pát, do̱ Chảu Fạ, Min tó xoi chăn Lu̱c Min au đúc đang hút xị đúc đang phít xá, vi̱ phít xá, Min tó ngài cáp xá chang đúc đang, <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />sle kí lo̱ cung chính luật fáp pắt lèo hít đảy xày xiìn chang hung làu, chư̱ kí cần mí kin dú nèm đúc đang, tọ kin dú nèm Chảu Khoăn. <verse eid="ROM 8:4" /><verse number="5" style="v" sid="ROM 8:5" />Vi̱ kí cần kin dú nèm đúc đang, do̱ tặt slim khảu kí lo̱ slục mà đúc đang; nhằng kí cần kin dú nèm Chảu Khoăn, do̱ tặt slim khảu kí lo̱ slục mà Chảu Khoăn. <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />Vi̱ tặt slim khảu đúc đang sleng oóc lo̱ hai, nhằng tặt slim khảu Chảu Khoăn, do̱ đảy te̱o xáu đảy pình an <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />hạy slim ki cú đúc đang do̱ tói tàu đủi Chảu Fạ, min mí fục luật fáp cú Chảu Fạ; vi̱ min xày mí fục đảy. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />Nhằng cần nàư kin dú nèm đúc đang, do̱ mí hít đay slim Chảu Fạ đảy. <verse eid="ROM 8:8" /><verse number="9" style="v" sid="ROM 8:9" />Tọ, hạy pi̱ noọng mí dú chang đúc đang, tọ dú chang Chảu Khoăn, hạy Chảu Khoăn cú Chảu Fạ dú chang làu. Nhằng hạy cần nàư mí mì Chảu Khoăn cú Chảu Cháu Ti̱ Da̱, do̱ cần nỉnh bó slục mà Min. <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />Tọ, hạy Chảu Cháu Ti̱ Da̱ dú chang pi̱ noọng, do̱ ma̱i cạ đúc đang pi̱ noọng hai vi̱ phít xá, tọ Chảu Khoăn nhằng te̱o đảy vi̱ pừng khảu cung chính. <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />Nhằng hạy Chảu Khoăn cú Lạo tó hít Chảu Giê-xu hòi te̱o tứ ti̱ hai dú chang pi̱ noọng, do̱ Lạo tó hít hử Chảu Giê-xu Cháu Ti̱ Da̱ hòi te̱o tứ ti̱ hai xày pảo hử đúc đang fục tảư lo̱ hai cú pi̱ noọng, quá Chảu Khoăn cú Min dú chang pi̱ noọng.<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />Pi̱ noọng ới, hung làu mí slỉu nỉ đúc đang, sle lèo kin dú nèm đúc đang. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />Vi̱ hạy pi̱ noọng kin dú nèm đúc đang do̱ pi̱ noọng lèo hai; tọ hạy pừng Chảu Khoăn hít hử hai cung sla̱y cú đúc đang do̱ pi̱ noọng co̱i đảy te̱o. <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />Vi̱ kí cần nàư đảy Chảu Khoăn cú Chảu Fạ tái lo̱, do̱ kí cần nỉnh xày chư̱ lu̱c cú Chảu Fạ. <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />Vi̱ pi̱ noọng tó mí nhă̱n au chinh xằn hít khỏi sle cứ kin dú chang lo̱ lao dan, tọ tó nhă̱n au Chảu Khoăn hít lu̱c chưựng, pừng khảu nỉnh, hung làu đảy dảo cạ: “A-ba! Pá!” <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />Chăn Chảu Khoăn hít chửng hử slim khoăn hung làu cạ hung làu chư̱ lu̱c cú Chảu Fạ. <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />Hạy pìn lu̱c, do̱ xày đảy táp cha xài: di̱ chư̱ cần táp cha xài cú Chảu Fạ, di̱ chư̱ cần xày táp cha xài đủi Chảu Cháu Ti̱ Da̱ — hạy hung làu chăn tảy khỏ đủi Min, do̱ hung làu co̱i xày đảy slu̱ng phjưức đủi Min.<verse eid="ROM 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />Ngo̱ nẳm cạ kí chíp khỏ cà nạy mí ngám pỉ đủi slu̱ng phjưức mư̱ lăng hung làu co̱i đảy hăn <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />Vi̱ mu̱ng tẳng thưng vằn mọi lo̱ đảy hăn slu̱ng phjưức cú lu̱c Chảu Fạ. <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />Mọi lo̱ tó ngài fục lo̱ va̱i đai, bó chư̱ tan vi̱ hau ái, tọ vi̱ Lạo hít hau fục, xáu kháo mu̱ng, <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />chăn mọi lo̱ xày co̱i đảy oóc khói đúc đang hít khỏi cú lo̱ va̱i slé, sle đảy tự do chang slu̱ng phjưức cú lu̱c Chảu Fạ. <verse eid="ROM 8:21" /><verse number="22" style="v" sid="ROM 8:22" />Vi̱ hung làu chắc cạ thuủn mọi lo̱ đảy hít oóc xày dau thán ngài chíp tót thưng vằn nảy; <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />Tọ, mí tan pìn nỉnh xày, tọ tằng hung làu mì mác tàu mù cú Chảu Khoăn, chăn hung làu xày dau thán, mu̱ng đảy hít lu̱c chưựng, sle đảy cháu đúc đang hung làu num. <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />Vi̱ hung làu đảy cháu chang kháo mu̱ng nỉnh. Tọ kháo mu̱ng hạy nho̱m hăn đảy do̱ mí nhằng chư̱ kháo mu̱ng num. Vi̱ cần nàư te̱o kháo mu̱ng khảu lo̱ làu đảy hăn è? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />Tọ hạy hung làu tặt kháo mu̱ng khảu lo̱ làu xằng hăn, do̱ hung làu cứ tảy na̱i mu̱ng tẳng.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />Pìn nỉnh, Chảu Khoăn xày pang cho̱i slim ón cú hung làu. Vi̱ hung làu mí chắc lèo xỉnh chàu lo̱ lăng chứng chư̱, tọ chăn Chảu Khoăn au mọi lo̱ dau thán mí chảng pìn vàm sle xỉnh chàu. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />Nhằng Lạo hăn thuủn slim cần, chắc khan Chảu Khoăn ái chảng lăng, vi̱ Chảu Khoăn xỉnh chàu tháy hử kí cần slấn nèm chăn slim Chảu Fạ slưửng. <verse eid="ROM 8:27" /><verse number="28" style="v" sid="ROM 8:28" />Hung làu chắc cạ Chảu Fạ hít mọi lo̱ xỏn khảu sle đay hử kí cần nàư điíp Min, chư̱ hử kí cần đảy dảo nèm slim Min slưửng dá. <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />Vi̱ kí cần Min tó chắc cón, do̱ Min xày slưửng cón sle hút xị dưư̱ng slưứng Lu̱c Min, sle Lu̱c nỉnh pìn lu̱c tàu chang lai pi̱ noọng <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />Nhằng kí cần Min tó slưửng cón, do̱ Min xày dảo dá. Xáu kí cần Min tó dảo, do̱ Min xày dảo cung chính dá. Nhằng kí cần Min tó dảo cung chính, do̱ Min xày hít hử slu̱ng phjưức dá.<verse eid="ROM 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />Pìn nỉnh, hung làu co̱i chảng lăng mà kí lo̱ nảy? Hạy Chảu Fạ tháy hung làu, do̱ nhằng cần nàư tỉng te̱o hung làu đảy? <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />Min chăn bó sliít Lu̱c cú làu, tọ tó slỉ Lu̱c nỉnh sle tháy hử hung làu, do̱ Min te̱o mí pảo mọi lo̱ tò xày đủi Lu̱c nỉnh hử hung làu do̱ lừ? <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />Cần nàư co̱i cáp xá te̱o kí cần đảy Chảu Fạ lưư̱c? Chăn Chảu Fạ chư̱ Lạo hít hử pìn cung chính. <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />Cần nàư co̱i cáp xá? Chư̱ Chảu Giê-xu Cháu Ti̱ Da̱, Lạo tó hai dá đảy hòi te̱o, Lạo nỉnh nă̱ng dú bưửng sla Chảu Fạ — cà nạy xỉnh chàu tháy hử hung làu mí? <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />Cần nàư co̱i păn pja̱c hung làu khói slim điíp cú Chảu Cháu Ti̱ Da̱? Chư̱ chíp khỏ, chai na̱n, ngài hít khỏ, dác, kẻ ca̱ng, dii̱m, do̱ va̱ pảng dáng mí? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />Xị mì vàm slẻ cạ:</para>
  <para style="q1" vid="ROM 8:36">“Chăn vi̱ Chảu, hung lu̱c vằn vằn ngài khả;</para>
  <para style="q1" vid="ROM 8:36">Hung lu̱c ngài ngòi xị chiin au pay sle hít nự.”<verse eid="ROM 8:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37" />Pắn te̱o, chang mọi lo̱ nỉnh, hung làu te̱o hình thuủn pừng Lạo điíp làu, <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />Vi̱ ngo̱ slấn cạ bó mì lo̱ hai, lo̱ te̱o, bó mì kí cần tang nả fạ, kí cần căm quỳn, lo̱ cà nạy, lo̱ mư̱ lăng, bó mì quỳn fép, <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />tàng slung, tàng đắc, do̱ va̱ lo̱ lăng đảy hít oóc, xày hít hung làu păn pja̱c khói slim điíp cú Chảu Fạ, chang Chảu Giê-xu Cháu Ti̱ Da̱, Chảu hung làu đảy.<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />Ngo̱ chảng chăn chang Chảu Cháu Ti̱ Da̱. Ngo̱ mí chảng pjàng, slim slảy ngo̱ xày hít chửng hử ngo̱ chang Chảu Khoăn <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />cạ ngo̱ slim xàu lai, slim ngo̱ chíp tót tằng vằn li̱n khừn <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />Vi̱ ngo̱ mu̱ng chăn làu ngài bjắc bjỏi, pja̱c khói Chảu Cháu Ti̱ Da̱ tháy hử pi̱ noọng chư̱ kí cần xăn xích tó đảy; <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />chăn hau chư̱ cần Y-sơ-ra-ên, kí cần tó đảy nhă̱n hít lu̱c chưựng, slu̱ng phjưức, đảy pảo hử vàm chao kiít, luật fáp, lo̱ pái slớ xáu kí vàm pao xình; <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />hau oóc tứ kí cúc chỏ, xáu Chảu Cháu Ti̱ Da̱ đảy sleng oóc tứ hau (nèm fă̱n đúc đang) Min chư̱ Lạo tìng thuủn mọi lo̱, chư̱ Chảu Fạ ngám sle đảy că̱n thưng tơ̱i tơ̱i. A-men.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />Tọ, mí chư̱ vàm Chảu Fạ tó pìn va̱i đai. Vi̱ mí chư̱ thuủn kí cần sleng oóc dú Y-sơ-ra-ên do̱ pìn cần Y-sơ-ra-ên <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />Xày bó chư̱ thuủn kí lu̱c lan cú Áp-ra-ham pìn nòi cần cú ké. Tọ chăn: “Vi̱ tứ Y-sác, nòi cần cú lu̱c đảy dảo nèm mìng lu̱c.” <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />Chăn cạ lu̱c lan mà fă̱n đúc đang, kí cần nỉnh mí chư̱ lu̱c lan Chảu Fạ. Tọ lu̱c lan cú vàm pao xình chứng đảy dảo chăn nòi. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />Vi̱ vàm nảy chăn chư̱ vàm pao xình: “Pi lăng, khảu slì nảy Cau co̱i fan te̱o, co̱i mì lu̱c báo nưng hử Sa-ra.” <verse eid="ROM 9:9" /><verse number="10" style="v" sid="ROM 9:10" />Mí tan pìn nỉnh, slì Rê-bê-ca làm đang tứ Y-sác, cúc chỏ hung làu; <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />vi̱ chíu tu lu̱c xằng đảy sleng oóc, xằng hít lăng đay do̱ va̱ xảu — sle slim Chảu Fạ slưửng lưư̱c đảy chưứng mắn, <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />mí pừng khảu lo̱ tu cần hít, tọ pừng khảu Lạo tó dảo — da̱ tó đảy páo cón cạ: “Ò pi̱ co̱i hít khỏi hử ò noọng.” <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />Xị mì vàm slẻ: “Cau điíp Gia-cốp, tọ Cau xằng Ê-sau.”<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />Pìn nỉnh, hung làu co̱i chảng pìn lừ? Chư̱ Chảu Fạ mí cung phình mí? Mí chư̱ pìn nỉnh! <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />Vi̱ Min cạ Môi-se: “Cau co̱i slim quảng xáu cần nàư Cau ái múc quảng, Cau co̱i điíp sliít cần nàư Cau ái điíp sliít.” <verse eid="ROM 9:15" /><verse number="16" style="v" sid="ROM 9:16" />Pìn nỉnh, mí chư̱ vi̱ tu cần ái do̱ va̱ oóc slèng, tọ vi̱ đảy Chảu Fạ điíp sliít, Lạo mì slim điíp sliít. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />Vi̱ Vàm Chảu Fạ chảng mà Pha-ra-ôn cạ: “Cau tó tài mưng khửn sle hau hăn quỳn slèng cú Cau quá mưng, sle mình Cau đảy páo oóc to̱i ti̱ da̱.” <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />Pìn nỉnh, Min điíp sliít cần nàư Min ái, tọ Min hít kheng slim cần nàư Min ái.<verse eid="ROM 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />Pìn nỉnh do̱ pi̱ noọng co̱i cạ ngo̱: “Hạy pìn nỉnh hít lừ Min nhằng quáy? Vi̱ cần nàư tói tỉng te̱o slim slưửng Min đảy?” <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />Pàng dạu ới, ni̱ chư̱ cần nàư te̱o cảm tò ke̱o xáu Chảu Fạ? Hít lăng ăn làu hít oóc te̱o chảng đủi cần hít pìn làu cạ: “Hít lừ mưng nă̱n cau oóc pìn nảy?” <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />Cần nă̱n tum te̱o mí mì quỳn tìng tum sle nă̱n oóc kí thìng táng căn tứ ca̱o tum nưng, ăn do̱ sle hít lo̱ pèng, ăn do̱ hít lo̱ che̱n chạ do̱ lừ? <verse eid="ROM 9:21" /><verse number="22" style="v" sid="ROM 9:22" />Nhằng hạy Chảu Fạ ái hử hăn xá fát fày xáu hử chắc quỳn slèng cú Min, tó tảy nẳm tẳng kí ăn pình tảy xá fát fày sle ngài khả chii̱t; <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />sle Min hử chắc fát xài cú slu̱ng phjưức Min xáu kí thìng ngám sle đảy điíp sliít, đảy Min chắp xặp hử hau đảy slu̱ng phjưức, <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />tằng cạ hung làu, chư̱ kí cần Min tó dảo, mí tan tứ cần Do Thái, tọ nhằng tứ kí cần cú tum ti̱ táng, do̱ hít lăng? <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />Xị Min xày cạ chang xéc Ô-sê:</para>
  <para style="q1" vid="ROM 9:25">“Cau co̱i dảo kí cần bó chư̱ nòi cần cú Cau, pìn ‘nòi cần cú Cau,’</para>
  <para style="q1" vid="ROM 9:25">xáu kí cần mí đảy điíp pìn ‘cần đảy điíp pèng’.<verse eid="ROM 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ROM 9:26" />Xáu chăn dú ti̱ vàm tó cạ hau: ‘Hung mưng mí chư̱ nòi cần cú Cau,’</para>
  <para style="q1" vid="ROM 9:26">do̱ chăn dú ti̱ nỉnh, hau co̱i đảy dảo hít ‘kí lu̱c cú Chảu Fạ te̱o tơ̱i tơ̱i.’”<verse eid="ROM 9:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ROM 9:27" />Nhằng Ê-sai tó chảng mà cần Y-sơ-ra-ên, cạ:</para>
  <para style="q1" vid="ROM 9:27">“Ma̱i cạ lu̱c lan cần Y-sơ-ra-ên mì lai xị slài dú hải,</para>
  <para style="q1" vid="ROM 9:27">do̱ tan mì fă̱n nưng nhằng lưứm te̱o co̱i đảy cháu xày,<verse eid="ROM 9:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ROM 9:28" />vi̱ Chảu co̱i hít vàm cú Min tìng tum,</para>
  <para style="q1" vid="ROM 9:28">hít xày xiìn khoái xày.”<verse eid="ROM 9:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="ROM 9:29" />Ê-sai xày páo cón cạ:</para>
  <para style="q1" vid="ROM 9:29">“Hạy Chảu quỳn slèng mí sle hử hung làu cần táp nòi,</para>
  <para style="q1" vid="ROM 9:29">do̱ cay hung làu tó pìn xị slẻng Sô-đôm,</para>
  <para style="q1" vid="ROM 9:29">xáu ngài hít hút xị slẻng Gô-mô-rơ dá.”<verse eid="ROM 9:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />Pìn nỉnh, hung làu co̱i chảng pìn lừ? Kí cần cú tum ti̱ táng, kí cần mí xa lo̱ sle đảy pìn cung chính, do̱ te̱o đảy cung chính; tọ cung chính nỉnh tứ slim slấn. <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />Nhằng cần Y-sơ-ra-ên, oóc slèng pừng khảu luật fáp sle đảy pìn cung chính te̱o mí hít xày xiìn đảy luật fáp. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />Vi̱ lăng? Vi̱ mí pừng khảu slim slấn, tọ pừng khảu cung sla̱y hau hít. Hau tó toỏng kha khảu ca̱o hin tả làn, <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />xị mì vàm slẻ:</para>
  <para style="q1" vid="ROM 9:33">“Ngòi ne̱, Cau tặt dú Si-ôn ca̱o hin nưng, khảng hin co̱i hít hử toỏng lụp,</para>
  <para style="q1" vid="ROM 9:33">cần nàư slấn khảu hin nỉnh co̱i mí ngài nả nhẻn.”<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />Pi̱ noọng ới, slim ngo̱ kháo mu̱ng xáu vàm ngo̱ xỉnh chàu Chảu Fạ tháy sle hau đảy cháu. <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />Ngo̱ hít chửng hử hau cạ, hau thuủn slim đủi Chảu Fạ, tọ mí chư̱ slỉu thung slụ đơ. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />Vi̱ hau bó chắc cung chính cú Chảu Fạ chứng oóc slèng cú làu, sle đảy cung chính, hau chứng mí fục lo̱ cung chính cú Chảu Fạ. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />Vi̱ Chảu Cháu Ti̱ Da̱ hít thuủn luật fáp, sle mọi cần slấn xày đảy dảo cung chính. <verse eid="ROM 10:4" /><verse number="5" style="v" sid="ROM 10:5" />Môi-se slẻ mà cung chính oóc tứ luật fáp, cạ: “Cần nàư hít nèm kí lo̱ luật fáp slon, do̱ cần nỉnh pừng khảu co̱i đảy te̱o.” <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />Nhằng mà lo̱ pìn cung chính pừng khảu slim slấn, do̱ mì vàm slẻ pìn nảy: “Dá táng chảng chang slim cạ: ‘Cần nàư co̱i khửn thưng fạ?’ (ái chảng cạ, sle au Chảu Cháu Ti̱ Da̱ lùng); <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />do̱ va̱: ‘Cần nàư co̱i lùng vằng đắc?’” (ái chảng cạ au Chảu Cháu Ti̱ Da̱ tứ ti̱ hai khửn). <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />Tọ vàm nỉnh chảng lăng? “Vàm Chảu Fạ dú xảư lu̱c, chang pác xáu chang slim lu̱c.”</para>
  <para style="p" vid="ROM 10:8">nỉnh chư̱ vàm slim slấn hung ngo̱ tó páo oóc. <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />Vi̱ hạy pác pi̱ noọng nhă̱n Chảu Giê-xu chư̱ Chảu, xáu slấn chang cạ Chảu Fạ tó hít Min tứ ti̱ hai hòi te̱o, do̱ pi̱ noọng co̱i đảy cháu. <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />Vi̱ cần nàư slấn chang slim, do̱ đảy dảo cung chính, nhằng pác cần nàư chảng oóc do̱ co̱i đảy cháu. <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />Vi̱ vàm Chảu Fạ chảng: “Cần nàư slấn Min co̱i mí ngài nả nhẻn.” <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />Mí mì ca lăng păn pjết cần Do Thái xáu cần Hy Lạp, vi̱ mọi cần xày mì Chảu nưng, chư̱ Lạo pảo fúc fúng fàu hử mọi cần xỉnh xo Min. <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />Vi̱, “Mọi cần, ma̱i cạ cần nàư dảo mình Chảu, do̱ xày co̱i đảy cháu.” <verse eid="ROM 10:13" /><verse number="14" style="v" sid="ROM 10:14" />Tọ hau xằng slấn Min do̱ xỉnh xo pìn lừ đảy? Xằng ti̱ng mà Min do̱ hít lừ slấn? Mí mì cần páo oóc do̱ ti̱ng pìn lừ đảy? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />Hạy mí mì cần nàư đảy xoi pay do̱ hít lăng páo oóc? Xị mì vàm slẻ: “Pàm kha cú kí cần páo oóc Vàm Đay chăn chư̱ đay lai!”<verse eid="ROM 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 10:16" />Tọ mí chư̱ mọi cần xày ti̱ng Vàm Đay đơ; vi̱ chăn Ê-sai tó chảng: “Pái Chảu, cần nàư nhă̱n slấn vàm hung ngo̱?” <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />Pìn nỉnh, slim slấn thưng tứ kí vàm hau ti̱ng, kí vàm nỉnh tứ vàm cú Chảu Cháu Ti̱ Da̱ đảy páo oóc. <verse eid="ROM 10:17" /><verse number="18" style="v" sid="ROM 10:18" />Tọ, ngo̱ xo tham: Chư̱ hau mí đảy ti̱ng mí? Chăn hau tó đảy ti̱ng, vi̱:</para>
  <para style="q1" vid="ROM 10:18">“Heng cú kí cần nỉnh tó chảng oóc to̱i tum ti̱,</para>
  <para style="q1" vid="ROM 10:18">vàm cú hau tó páo oóc thưng to̱i ti̱ da̱.”<verse eid="ROM 10:18" /></para>
  <para style="b" />
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />Ngo̱ te̱o tham: Chư̱ cần Y-sơ-ra-ên mí nhă̱n oóc? Ta̱i tàu, Môi-se tó chảng:</para>
  <para style="q1" vid="ROM 10:19">“Chăn Cau co̱i hít hử hung mưng cò că̱ng xáu kí cần mí chư̱ nòi cần nưng;</para>
  <para style="q1" vid="ROM 10:19">Cau co̱i hít hử hung mưng fát slíng đủi kí cần tăn bả.”<verse eid="ROM 10:19" /></para>
  <para style="b" />
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />Dá Ê-sai te̱o tài tảm chảng cạ:</para>
  <para style="q1" vid="ROM 10:20">“Kí cần mí xa Cau do̱ tó phúng đảy Cau;</para>
  <para style="q1" vid="ROM 10:20">Cau chứng hử kí cần mí tham Cau đảy chắc Cau.”<verse eid="ROM 10:20" /></para>
  <para style="b" />
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21" />Tọ nhằng cần Y-sơ-ra-ên, Min cạ: “Vằn vằn, Cau dặc mừ dảo kí cần mí ti̱ng vàm xáu cò kheng.”<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />Pìn nỉnh ngo̱ xo tham: Chư̱ Chảu Fạ tả nòi cần cú Min mí? Mí chư̱ pìn nỉnh! Vi̱ chăn ngo̱ chư̱ cần Y-sơ-ra-ên, tứ nòi cần Áp-ra-ham, slục nòi Bên-gia-min. <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />Chảu Fạ mí tả nòi cần cú Min, chư̱ nòi cần Min tó chắc cón. Pi̱ noọng mí chắc Vàm Chảu Fạ chảng lăng mà Ê-li, chíu ké chảng xáu Chảu Fạ tỉng te̱o cần Y-sơ-ra-ên pìn lừ mí? <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />“Pái Chảu, hau tó khả kí cần páo cón, hít tấm tắc xoòng xằn cú Chảu; tan nhằng lu̱c, hau xày xa khả tằng lu̱c num.” <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />Tọ vàm lình ính cạ ké pìn lừ? “Cau tó táng sle hử tan Cau chất xiin cần ti̱ po̱, kí cần nảy mí qu̱y kháu tói nả slín Ba-anh.” <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />Xày pìn nỉnh, cà nạy mì fă̱n nưng nhằng lưứm te̱o đảy lưư̱c vi̱ đảy pảo fúc ma̱i cạ làu bó ngám. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />Tọ hạy cứ pừng khảu fúc Chảu pảo hử ma̱i cạ làu bó ngám, do̱ bó cẩn thưng cung sla̱y làu hít. Hạy pừng cung sla̱y làu hít, do̱ mí nhằng chư̱ fúc Chảu pảo hử ma̱i cạ làu bó ngám dá. <verse eid="ROM 11:6" /><verse number="7" style="v" sid="ROM 11:7" />nỉnh do̱ pìn lừ? Kí lo̱ cần Y-sơ-ra-ên xa thắp te̱o mí xa hăn, tọ kí cần đảy lưư̱c do̱ đảy dá, tọ fă̱n nhằng lưứm te̱o do̱ pìn cò kheng, <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />xị mì vàm slẻ cạ: “Chảu Fạ tó hít slim khoăn hau pìn tăn bả, ha bó nho̱m hăn, xu mí ti̱ng đảy, mại thưng vằn nảy.” <verse eid="ROM 11:8" /><verse number="9" style="v" sid="ROM 11:9" />Đa-vít do̱ cạ:</para>
  <para style="q1" vid="ROM 11:9">“Mu̱ng hử xoòng kin cú hau pìn ăn khe hảng,</para>
  <para style="q1" vid="ROM 11:9">ca̱o hin toỏng kha sle hau ngài páo xàu;<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />Cứ sle ha hau ngài bót sle mí nhằng hăn đảy,</para>
  <para style="q1" vid="ROM 11:10">hít hử lăng hau cứ kho mại!”<verse eid="ROM 11:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />Pìn nỉnh, ngo̱ xo tham: “Chư̱ hau tó toỏng kha sle lèo lụp lùng mí?” Mí chư̱ pìn nỉnh! Tọ vi̱ hau fa̱m xá, kí cần cú tum ti̱ táng đảy cháu sle hau lèo cò că̱ng. <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />Hạy vi̱ hau fa̱m xá te̱o hít ti̱ da̱ đảy fúc fúng fàu, xáu vi̱ hau tăn bả te̱o hít fúng fàu hử cần cú tum ti̱ táng, do̱ hau co̱i đảy fúc fúng fàu thưng haư? <verse eid="ROM 11:12" /><verse number="13" style="v" sid="ROM 11:13" />Nhằng cà nạy, ngo̱ chảng đủi pi̱ noọng chư̱ kí cần cú tum ti̱ táng, chăn ngo̱ nhằng hít cần đảy xoi pay hử cần cú tum ti̱ táng, do̱ ngo̱ co̱i hít slu̱ng phjưức cung sla̱y cú làu, <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />sle hít slim pi̱ noọng làu mà fă̱n đúc đang lèo cò că̱ng, dá cháu đảy kỉ cần pi̱ noọng làu. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />Hạy vi̱ hau ngài tả oóc ti̱ da̱ te̱o đảy hít đay đủi Chảu Fạ, do̱ hau đảy nhă̱n lăng, hạy bó chư̱ lo̱ hai sle khảu lo̱ te̱o? <verse eid="ROM 11:15" /><verse number="16" style="v" sid="ROM 11:16" />Hạy fă̱n bư ta̱i tàu slaư tích, do̱ tằng tuủng bư xày slaư tích; hạy la̱c chư̱ slaư tích do̱ tằng kí cáng xày slaư tích. <verse eid="ROM 11:16" /><verse number="17" style="v" sid="ROM 11:17" />Tọ hạy mì kỉ cáng ngài slắp pay, nhằng pi̱ noọng xị cáng co ô-liu táng khửn, đảy cáp khảu ti̱ kí cáng co nỉnh, sle đảy păn dang te̱o tứ la̱c cú co ô-liu <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />do̱ mí đảy khửn nả xáu kí cáng nỉnh. Hạy pi̱ noọng khửn nả, do̱ mí chư̱ pi̱ noọng tảy nẳm ăn la̱c, tọ ăn la̱c tảy nẳm pi̱ noọng. <verse eid="ROM 11:18" /><verse number="19" style="v" sid="ROM 11:19" />Pìn nỉnh do̱, pi̱ noọng co̱i chảng: “Kí cáng nỉnh tó ngài slắp pay sle chăn ngo̱ đảy cáp khảu.” <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />Chăn pìn nỉnh! Kí cáng nỉnh tó ngài slắp pay vi̱ slim min mí slấn, nhằng pi̱ noọng dân mắn đảy tan pừng khảu slim slấn. Mí đảy nẳm háo cao, tọ lèo lao dan. <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />Vi̱ hạy Chảu Fạ tó mí sliít kí cáng cú co đảy chay, do̱ Min xày bó sliít pi̱ noọng đơ. <verse eid="ROM 11:21" /><verse number="22" style="v" sid="ROM 11:22" />Pìn nỉnh lèo nhă̱n chắc slim quảng xáu kheng khên cú Chảu Fạ: Kheng khên xáu kí cần tó lụp, tọ Chảu Fạ slim quảng xáu pi̱ noọng, hạy pi̱ noọng cứ pừng khảu slim quảng cú Min; hạy mí, tằng pi̱ noọng xày ngài bác tả pay. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />Nhằng kí cần nỉnh, hạy hau cứ mí nhă̱n slấn, do̱ hau co̱i đảy cáp khảu, vi̱ Chảu Fạ mì quỳn te̱o cáp hau khảu co. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />Hạy pi̱ noọng tó ngài bác khói co ô-liu táng khửn, nhằng đảy slắp xáu cáp khảu co ô-liu chay, do̱ hau tó chư̱ kí cáng ô-liu đảy chay, hau te̱o ngám sle đảy cáp khảu chăn co ô-liu cú làu num.<verse eid="ROM 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />Pi̱ noọng ới, ngo̱ ái pi̱ noọng slụ lo̱ dăm dò nảy, sle pi̱ noọng mí táng khửn nả nẳm cạ làu quai kí, fă̱n cần Y-sơ-ra-ên nưng cứ cò kheng thưng slì cần cú tum ti̱ táng đảy cáp khảu tim đo. <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />Pìn nỉnh, tằng cần Y-sơ-ra-ên co̱i đảy cháu, xị mì vàm slẻ:</para>
  <para style="q1" vid="ROM 11:26">“Lạo cháu co̱i tứ Si-ôn thưng,</para>
  <para style="q1" vid="ROM 11:26">Min tả pay kí lo̱ too̱c éc khói lưừn Gia-cốp.<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />nỉnh chăn chư̱ chao kiít Cau hít xáu hau,</para>
  <para style="q1" vid="ROM 11:27">slì Cau sla dưư̱ng phít xá cú hau.”<verse eid="ROM 11:27" /></para>
  <para style="b" />
  <para style="m">
    <verse number="28" style="v" sid="ROM 11:28" />Nèm Vàm Đay, hau chư̱ cần tói tàu cú Chảu Fạ, lo̱ nỉnh đay hử pi̱ noọng; tọ nho̱m khảu fúc đảy lưư̱c, hau đảy pèng điíp pừng khảu kí cúc chỏ hau; <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />vi̱ Chảu Fạ pảo fúc xáu dảo hau bó tói táng slắc pày <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />Xị chăn pi̱ noọng mư̱ cón mí ti̱ng vàm Chảu Fạ, tọ cà nạy đảy điíp sliít, vi̱ hau mí ti̱ng vàm Min. <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />Xày pìn nỉnh, kí cần nảy, cà nạy mí ti̱ng vàm điíp sliít, sle cà nạy hau xày đảy điíp sliít. <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />Vi̱ Chảu Fạ tó xăng mọi cần khảu ti̱ mí ti̱ng vàm, sle Min điíp sliít mọi cần.<verse eid="ROM 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />Dỏ! Pjòi tháy mà slim thung slụ xáu quai kí cú Chảu Fạ slung đắc thưng haư! Lo̱ ứn chá cú Chảu mí cần nàư chắc đảy, tèo lo̱ cú Chảu mí cần nàư slụ đảy!<verse eid="ROM 11:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34" />Vi̱, “Cần nàư chắc đảy slim ki Chảu?</para>
  <para style="q1" vid="ROM 11:34">Do̱ va̱ cần nàư hít tham khắm hử Min?<verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />Do̱ va̱ cần nàư tó hử Chảu cón,</para>
  <para style="q1" vid="ROM 11:35">dá sle đảy Min păng te̱o?”<verse eid="ROM 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ROM 11:36" />Vi̱ mọi lo̱ xày tứ Min oóc, pừng khảu Min xáu dưứng mà Min. Slu̱ng phjưức slục mà Min thưng tơ̱i tơ̱i. A-men.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />Pi̱ noọng ới, vi̱ Chảu Fạ điíp sliít hung làu, ngo̱ na̱i xo pi̱ noọng cứ pài đúc đang làu hử Chảu Fạ, xị sleng lình te̱o, slaư tích xáu đay slim Min, nỉnh chăn chư̱ lo̱ sle pi̱ noọng pái slớ Min. <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />Mí đảy hít nèm tơ̱i nảy, tọ lèo đảy tói máư slim ki làu, sle pi̱ noọng păn pjết slim slưửng đay đắn, đay slim xáu xày xiìn cú Chảu Fạ pìn lừ.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />Vi̱ pừng khảu fúc Chảu pảo hử ma̱i cạ ngo̱ bó ngám, ngo̱ xo chảng xáu mọi cần chang pi̱ noọng, mí đảy nẳm làu hẳm slung, tọ lèo nẳm ngám chư̱, xị slim slấn Chảu Fạ pảo hử cần pìn cần. <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />Hút xị hung làu mì lai fă̱n chang đúc đang đeo, tọ kí fă̱n te̱o mí tò xày cung sla̱y nưng, <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />do̱ xày pìn nỉnh, hung làu mì lai cần tọ tan pìn đúc đang đeo chang Chảu Cháu Ti̱ Da̱; mọi cần xày chư̱ kí fă̱n đúc đang cú căn. <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />Tọ hung làu đảy Chảu pảo hử fúc đay táng căn, ngòi khảu fúc Chảu pảo hử ma̱i cạ làu bó ngám: cần đảy pảo hử sle páo cón, do̱ lèo chảng pìn lừ sle ngám xáu slim slấn; <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />cần đảy pảo hử sle cung ta̱i, do̱ lèo cung ta̱i; cần đảy pảo hử sle slon cạ, do̱ cứ slon cạ; <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />đảy pảo hử sle nhòi slim, do̱ cứ nhòi slim; đảy pảo hử sle păn vai, do̱ thuủn slim păn vai; đảy pảo hử sle căm tàu, do̱ lèo thuủn slim hít; đảy pảo hử sle pang cho̱i cần khỏ, do̱ lèo hun hỉ hít.<verse eid="ROM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />Slim điíp lèo chăn xình, lèo xằng lo̱ too̱c éc sle xa thắp lo̱ đay; <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />lèo pèng điíp xị pi̱ noọng đủi căn; lèo thuủn slim kiính điíp căn; <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />mí lằng lừ, lèo thuủn slim hít chang chinh xằn cung ta̱i Chảu; <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />hun hỉ chang kháo mu̱ng, tảy na̱i chang chíp khỏ, mắn slim xỉnh chàu <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />păn vai kí lo̱ cẩn du̱ng hử kí cần slấn; lèo chiíp tỏn khéc hử đay <verse eid="ROM 12:13" /><verse number="14" style="v" sid="ROM 12:14" />Lèo cung fúc hử kí cần hít khỏ pi̱ noọng; lèo cung fúc, mí đảy bjắc bjỏi; <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />sle hun fằng đủi cần hun fằng, sle hảy đủi kí cần hảy <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />pay te̱o đay đắn đủi căn; mí đảy nẳm háo cao, tọ lèo cáp xỏn xáu kí cần sláy tắm. Mí đảy táng hử làu quai kí quá cần táng; <verse eid="ROM 12:16" /><verse number="17" style="v" sid="ROM 12:17" />mí au too̱c éc păng too̱c éc hử cần nàư; lèo chăn slim hít lo̱ đay tói nả mọi cần; <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />hạy đảy, do̱ thuủn slim kin dú đay đắn đủi mọi cần; <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />pi̱ noọng pèng điíp ới, làu mí đảy táng păng xàu cần nàư, tọ lèo sle hử xá fát fày cú Chảu Fạ; vi̱ mì vàm: “Chảu Fạ cạ: ‘Chăn Cau co̱i păng xàu.’”<verse eid="ROM 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ROM 12:20" />“Tọ, hạy cần tói tàu pi̱ noọng dác, lèo hử min kin.</para>
  <para style="q1" vid="ROM 12:20">Hạy min cò khấư, lèo hử min nặm.</para>
  <para style="q1" vid="ROM 12:20">Vi̱ hít pìn nỉnh xị pi̱ noọng tặt thán fày tìng hu min.”<verse eid="ROM 12:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 12:21" />Mí đảy sle lo̱ too̱c éc tức pa̱i đảy làu, tọ lèo au lo̱ đay hình lo̱ too̱c éc.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />Mọi cần lèo fục cần căm quỳn làu; vi̱ mí mì quỳn haư te̱o mí tứ Chảu Fạ oóc; nhằng kí cần căm quỳn xày tứ Chảu Fạ tặt hử hít. <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />Pìn nỉnh, cần nàư tỉng te̱o cần căm quỳn, hút xị tỉng te̱o lịnh cú Chảu Fạ tặt oóc, kí cần hít pìn nỉnh co̱i ngài ứn chá. <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />Vi̱ hít lo̱ đay, do̱ mí lao cần căm quỳn, hít lo̱ slại chứng lèo lao. Nhằng pi̱ noọng ái khói lèo lao cần căm quỳn. Cứ hít lo̱ đay pay, do̱ pi̱ noọng co̱i đảy hau că̱n, <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />vi̱ cần nỉnh hít khỏi cú Chảu Fạ sle hít đay hử pi̱ noọng. Tọ hạy pi̱ noọng hít slại, do̱ lèo lao, vi̱ cần căm quỳn căm ma̱c dáng bó chư̱ mí mì lăng đơ; hau xị cần khỏi cú Chảu Fạ, sle cháng xá fát fày lùng cần hít slại. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />Pìn nỉnh, lèo fục cần căm quỳn, mí tan vi̱ lao xá fát fày, tọ nhằng vi̱ slim làu num. <verse eid="ROM 13:5" /><verse number="6" style="v" sid="ROM 13:6" />Xày pìn nỉnh pi̱ noọng chứng no̱p slé; vi̱ cần căm quỳn hít khỏi cú Chảu Fạ, thuủn slim làu sle dau cung sla̱y nảy <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />Lèo păng hử hau kí ăn làu slỉu nỉ: no̱p slé hử cần slau slé; no̱p chèn hử cần làu lèo no̱p: lao cần làu lèo lao; kiính chu̱ng cần ngám đảy kiính chu̱ng.<verse eid="ROM 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />Mí xảy slỉu nỉ cần nàư ca lăng, tan lèo slim điíp căn xày; vi̱ cần nàư điíp cần xảư xảng làu, do̱ hít xày xiìn luật fáp dá <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />Vi̱ kí vàm man nảy: “Lu̱c mí đảy fa̱m xá pay chụ, mí đảy khả cần, mí đảy lặc cưứp, mí đảy thám cò,” xáu hạy nhằng kí vàm man táng, xày xỏn tẩn chang vàm nảy: “Lu̱c lèo điíp cần xảư xảng lu̱c.” <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />Slim điíp mí hít ha̱i cần xảư xảng. Pìn nỉnh, slim điíp do̱ lèo hít xày xiìn luật fáp.<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />Xày hít pìn nỉnh, vi̱ chắc cà nạy làu dú slì haư, tó thưng slì pi̱ noọng lèo slỉnh nòn. Vi̱ vằn Chảu Fạ cháu hung làu hẳm xảư quá chíu hung làu ngám slấn. <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />Că̱m ái quá, nhằng vằn do̱ thưng xảư. Pìn nỉnh hung làu lèo tả kí lo̱ đăm khít sle nu̱ng au slử cháp slu̱ng loa̱ng. <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />Lèo phjải pay đay đắn xị pay chang tằng vằn, mí đảy choóc chéc màu mè, eo đẳn, pjuúng pjúi, tò cọn, cò că̱ng. <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />Tọ, lèo nu̱ng au Chảu, chư̱ Chảu Giê-xu Cháu Ti̱ Da̱, mí đảy xa lo̱ hít cò lùng kí eo đẳn cú đúc đang.<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />Lèo chiíp nhă̱n cần ón slim slấn, mí đảy ứn chá mà kí lo̱ hau nẳm. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />Tọ cần nảy slấn kin đảy mọi dưư̱ng; nhằng cần ón slim slấn do̱ tan kin mằn phjắc xày. <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />Cần kin mí đảy ngòi che̱n cần mí kin, nhằng cần mí kin mí đảy ứn chá cần kin; vi̱ Chảu Fạ tó chiíp nhă̱n min. <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />Hít lăng pi̱ noọng cảm ứn chá cần khỏi cú cần táng? Min dân do̱ va̱ lụp xáu chảu cú min. Tọ min co̱i dân, vi̱ Chảu mì quỳn hử min dân mắn. <verse eid="ROM 14:4" /><verse number="5" style="v" sid="ROM 14:5" />Cần nảy cạ vằn nảy xáu vằn nỉnh, nhằng cần táng do̱ nẳm mọi vằn xày đay. Mọi cần cứ slấn mắn khảu slim ki làu. <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />Cần cỏ vằn chăn chư̱ cỏ vi̱ Chảu; cần kin xày kin vi̱ Chảu, vi̱ cần nỉnh sleng slu̱ Chảu Fạ; nhằng cần mí kin xày mí kin vi̱ Chảu, cần nỉnh xày sleng slu̱ Chảu Fạ. <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />Mí cần nàư chang hung làu te̱o hử chăn làu, xày xị mí cần nàư hai hử chăn làu. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />Vi̱ hạy hung làu te̱o, chư̱ te̱o hử Chảu, hung làu hai xày chư̱ hai hử Chảu. Pìn nỉnh, ma̱i cạ hung làu te̱o do̱ va̱ hai, do̱ hung làu xày slục mà Chảu. <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />Chăn pìn nỉnh, Chảu Cháu Ti̱ Da̱ tó hai dá hòi te̱o, sle hít Chảu cú tằng cần hai xáu cần te̱o. <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" />Tọ ni̱ ới, hít lăng ni̱ te̱o ứn chá pi̱ noọng làu? Nhằng cần nỉnh, hít lừ te̱o ngòi che̱n pi̱ noọng làu? Vi̱ thuủn hung làu xày co̱i ngài ứn chá tói nả Chảu Fạ. <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />Vi̱ mì vàm slẻ:</para>
  <para style="q1" vid="ROM 14:11">“Chảu cạ: Xị Cau te̱o tơ̱i tơ̱i, mọi hu kháu co̱i qu̱y lùng tói nả Cau,</para>
  <para style="q1" vid="ROM 14:11">xáu mọi lịn co̱i că̱n Chảu Fạ.”<verse eid="ROM 14:11" /></para>
  <para style="b" />
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />Pìn nỉnh, mọi cần chang hung làu lèo li̱n te̱o mà mọi lo̱ làu hít xáu Chảu Fạ.<verse eid="ROM 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />Pìn nỉnh, hung làu mí đảy ứn chá căn num, tọ cứ hít pìn nảy do̱ hẳm đay: mí xảy tặt ca̱o hin hít toỏng kha do̱ va̱ tả làn hử pi̱ noọng làu. <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />Ngo̱ chắc xáu slấn chang Chảu Giê-xu cạ, bó mì dưư̱ng lăng chăn min táng slẳm sla̱p; tan slẳm sla̱p xáu cần nho̱m min pìn slẳm sla̱p xày. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />Hạy pi̱ noọng làu điíp lèo dau xàu vi̱ íng cú kin nưng, do̱ pi̱ noọng tó mí kin dú nèm slim điíp dá. Mí đảy vi̱ íng cú kin nưng te̱o hít va̱i túc cần tó đảy Chảu Cháu Ti̱ Da̱ hai tháy hử. <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />Pìn nỉnh mí đảy sle hau khu slủm lo̱ đay cú pi̱ noọng hít. <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />Vi̱ tum ti̱ Chảu Fạ mí chư̱ tứ kí cú kin, tọ chăn tứ kí lo̱ cung chính, pình an, hun hỉ chang Chảu Khoăn. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />Vi̱ cần nàư cung ta̱i Chảu Cháu Ti̱ Da̱ pìn nỉnh, do̱ đay slim Chảu Fạ, đảy tu cần ngòi đay ha nả. <verse eid="ROM 14:18" /><verse number="19" style="v" sid="ROM 14:19" />Pìn nỉnh, hung làu lèo xa kí lo̱ đay sle xáy tẳng căn. <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />Mí đảy hít va̱i cung sla̱y cú Chảu Fạ vi̱ cú kin. Chăn mọi cú kin xày slaư tích, tọ pìn phít xá hử cần kin sle toỏng lụp. <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />Đay quá do̱ mí kin nự, mí kin lảu do̱ va̱ ca lăng hít hử pi̱ noọng làu pìn phít xá do̱ va̱ pìn ón slim slấn. <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />Pi̱ noọng mì slim slấn pìn lừ, do̱ lèo cỏ au tói nả Chảu Fạ. Fúc hử cần nàư mí táng phúc xá mà kí lo̱ làu tó chắc chăn chư̱. <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />Tọ cần nàư nhằng lằng lừ te̱o cứ kin, do̱ ngài phúc xá dá, vi̱ mí hít nèm slim slấn. Lo̱ lăng mí thưng tứ slim slấn xày chư̱ phít xá.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />Pìn nỉnh, hung làu xị kí cần slèng, lèo háp kí slỉu lưứm cú cần mí sla̱i slèng, tó mí chư̱ tan hít đay slim làu. <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />Mọi cần hung làu lèo hít đay slim cần xảư xảng làu, sle pang cho̱i, xáy tẳng slim slấn cần nỉnh. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />Vi̱ Chảu Cháu Ti̱ Da̱ xày mí táng hít ngám slim làu. Tọ, xị mì vàm slẻ: “Kí vàm chíp slim cú cần bjắc bjỏi Min tó đíng tìng lu̱c.” <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />Kí vàm mư̱ pày slẻ chang xéc Vàm Chảu Fạ tó slon cạ hung làu, kí vàm nỉnh hít hử hung làu tảy na̱i, sle nhòi slim, hung làu chứng mì slim kháo mu̱ng <verse eid="ROM 15:4" /><verse number="5" style="v" sid="ROM 15:5" />Xỉnh xo Chảu Fạ cú kí lo̱ tảy na̱i, nhòi slim sle pi̱ noọng xày mì slim ki đủi căn, xị Chảu Giê-xu Cháu Ti̱ Da̱, <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />sle pi̱ noọng xày slim đeo, pác đeo tài slung Chảu Fạ, Pá cú Chảu hung làu, chăn chư̱ Chảu Giê-xu Cháu Ti̱ Da̱.<verse eid="ROM 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />Pìn nỉnh, lèo tỏn chiíp căn, xị Chảu Cháu Ti̱ Da̱ tó tỏn nhă̱n pi̱ noọng, sle tò xày khảu slu̱ng phjưức cú Chảu Fạ. <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />Ngo̱ xo chảng, Chảu Cháu Ti̱ Da̱ tó đảy pìn cần khỏi cú kí cần đảy slắp năng vi̱ chăn lị cú Chảu Fạ, sle hít mắn kí vàm pao xình cú kí cúc chỏ, <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />sle kí cần cú tum ti̱ táng đảy tài slung Chảu Fạ pừng khảu slim điíp sliít cú Min, xị mì vàm slẻ:</para>
  <para style="q1" vid="ROM 15:9">“Pìn nỉnh, lu̱c co̱i nhă̱n Chảu dú chang mọi nòi cần xáu khửn heng tài slung mình Chảu.”<verse eid="ROM 15:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10" />Te̱o mì vàm slẻ cạ:</para>
  <para style="q1" vid="ROM 15:10">“Ne̱, kí cần cú tum ti̱ táng ới, lèo hun fằng tò xày mọi nòi cần cú Chảu.”<verse eid="ROM 15:10" /></para>
  <para style="b" />
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11" />Ti̱ táng num te̱o cạ:</para>
  <para style="q1" vid="ROM 15:11">“Thuủn kí cần cú tum ti̱ táng ới, lèo că̱n Chảu;</para>
  <para style="q1" vid="ROM 15:11">thuủn mọi nòi cần lèo khửn heng tài slung mình Min.”<verse eid="ROM 15:11" /></para>
  <para style="b" />
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />Ê-sai xày chảng:</para>
  <para style="q1" vid="ROM 15:12">“Tứ Gie-sê co̱i oóc ăn la̱c nưng, chăn chư̱ Lạo co̱i cai cuủn cần cú tum ti̱ táng;</para>
  <para style="q1" vid="ROM 15:12">kí cần cú tum ti̱ táng co̱i kháo mu̱ng khảu Min.”<verse eid="ROM 15:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />Xỉnh xo Chảu Fạ cú slim kháo mu̱ng pảo hử pi̱ noọng tim hun fằng xáu pình an chang slim slấn, sle hít hử pi̱ noọng đảy fúng fàu kháo mu̱ng pừng khảu quỳn cú Chảu Khoăn!<verse eid="ROM 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />Pi̱ noọng cú ngo̱ ới, chăn ngo̱ xày slấn mắn mà pi̱ noọng cạ chăn pi̱ noọng tó mì slim quảng, vi̱ đảy tim thung slụ, sle chắc slắng slon căn. <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />Tọ chang baư slư ngo̱ slẻ hử pi̱ noọng, mì lai ti̱ ngo̱ tó chảng hẳm slèng, xị sle cạ hử pi̱ noọng, pừng khảu fúc Chảu pảo hử ma̱i cạ ngo̱ bó ngám đảy, <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />sle ngo̱ đảy hít khỏi hử Chảu Giê-xu Cháu Ti̱ Da̱ chang kí cần cú tum ti̱ táng, chíu cung ta̱i Vàm Đay cú Chảu Fạ, sle sleng lình cú kí cần cú tum ti̱ táng đảy Chảu Khoăn piín tói slaư tích. <verse eid="ROM 15:16" /><verse number="17" style="v" sid="ROM 15:17" />Pìn nỉnh, chang Chảu Giê-xu Cháu Ti̱ Da̱, ngo̱ mì quỳn đảy ảng slưứng mà cung sla̱y cung ta̱i Chảu Fạ. <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />Vi̱ ngo̱ mí cảm chảng vàm haư táng, tan kí lo̱ Chảu Cháu Ti̱ Da̱ tó hít quá ngo̱, sle kí cần cú tum ti̱ táng lèo ti̱ng vàm — tứ vàm chảng thưng lo̱ hít, <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />tứ quỳn slèng cú kí ha̱o pjòi, fép lạ, xáu quỳn slèng tứ Khoăn cú Chảu Fạ — thưng slặn ngo̱ tó páo oóc Vàm Đay cú Chảu Cháu Ti̱ Da̱ to̱i ti̱, tứ Giê-ru-sa-lem xáu kí búng xảư xảng thưng Y-ly-ri. <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />Pìn nỉnh, ngo̱ kháo mu̱ng páo oóc Vàm Đay bó chư̱ tan dú kí ti̱ Chảu Cháu Ti̱ Da̱ tó đảy chắc thưng, sle khói xáy tìng ti̱ choóc cú cần táng tặt. <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />Tọ, xị mì vàm slẻ:</para>
  <para style="q1" vid="ROM 15:21">“Kí cần xằng đảy chắc mà Min, do̱ co̱i hăn,</para>
  <para style="q1" vid="ROM 15:21">kí cần xằng ti̱ng thưng, do̱ co̱i slụ Min.”<verse eid="ROM 15:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />Chăn pìn nỉnh, chứng lai pày ngo̱ xày ngài làn, mí pay dưưng pi̱ noọng đảy. <verse eid="ROM 15:22" /><verse number="23" style="v" sid="ROM 15:23" />Tọ cà nạy, vi̱ mí nhằng ti̱ dú nảy dá, slim ngo̱ mu̱ng pay dưưng pi̱ noọng tứ lai pi, <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />hạy ngo̱ khửn lo̱ pay Tây Ban Nha; ngo̱ chăn kháo mu̱ng quá dưưng pi̱ noọng, phúng đảy pi̱ noọng dá, đảy pi̱ noọng pang cho̱i xáu hun fằng đủi pi̱ noọng íng nưng. <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />Nhằng cà nạy, ngo̱ pay Giê-ru-sa-lem sle pang cho̱i kí cần slấn. <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />Vi̱ cần Ma-xê-đoan xáu A-chai lùng cò tò cáp cú cái sle pang cho̱i kí cần slấn nhằng slỉu khỏ dú Giê-ru-sa-lem. <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />Hau chăn slim hít pìn nỉnh, xáu chăn hau xày slỉu nỉ kí cần nỉnh num. Vi̱ hạy cần cú tum ti̱ táng tó đảy păn kí fúc slục khoăn, do̱ hau lèo au cú cái làu mì sle pang cho̱i te̱o hử cần táng. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />Pìn nỉnh, chíu hít thuủn cung sla̱y nảy, chíu tó păn kí cú cái hử hau dá, ngo̱ co̱i khửn lo̱, quá dưưng pi̱ noọng chứng pay quá Tây Ban Nha. <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />Ngo̱ chắc cạ, chíu quá dưưng pi̱ noọng dá, ngo̱ co̱i mà xáu tim fúc fúng fàu cú Chảu Cháu Ti̱ Da̱.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />Pi̱ noọng ới, vi̱ Chảu cú hung làu chăn chư̱ Chảu Giê-xu Cháu Ti̱ Da̱ xáu vi̱ slim điíp cú Chảu Khoăn, ngo̱ na̱i xo pi̱ noọng lèo tò tức xáu ngo̱ quá kí vàm xỉnh chàu tháy ngo̱ khửn Chảu Fạ, <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />sle ngo̱ đảy pình an khói kí cần mí slấn dú Giu-đê, dá sle kí cần slấn thánh dú Giê-ru-sa-lem co̱i nhă̱n au cung sla̱y cú ngo̱; <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />sle đay slim Chảu Fạ, ngo̱ hun hỉ đảy thưng xáu xày đảy diít cha̱i đủi pi̱ noọng. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />Xỉnh xo Chảu Fạ pình an dú đủi thuủn kí pi̱ noọng! A-men.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />Ngo̱ xày hử pi̱ noọng chắc ché Phê-bê, pi̱ noọng hung ngo̱, xày chư̱ cần cung ta̱i Ho̱i Thánh dú Sen-cơ-rê, <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />sle pi̱ noọng tỏn chiíp ché chang Chảu, ngám xị chiíp kí cần slấn thánh, dá cứ hít mọi lo̱ min cẩn pi̱ noọng pang cho̱i. Vi̱ chăn min tó pang cho̱i lai cần, pang cho̱i tằng ngo̱ num.<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />Xo phjác vàm tuụng tham Bê-rít-sin xáu A-qui-la, chư̱ kí cần tò xày hít cung xáu ngo̱, sle cung ta̱i Chảu Giê-xu Cháu Ti̱ Da̱, <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />sloong cần nảy tó phún mi̱ng sle cháu ngo̱, mí tan ngo̱, lèo sleng slu̱ hau, tằng thuủn ho̱i thánh cú cần cú tum ti̱ táng num, <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />xáu xo phjác vàm tuụng tham ho̱i thánh ho̱p dú lưừn hau. Xo phjác vàm tuụng tham Ê-bai-nết chư̱ pàng dạu pèng điíp cú ngo̱, chư̱ cần ta̱i tàu slấn Chảu Cháu Ti̱ Da̱ dú ti̱ A-si. <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />Phjác vàm tuụng tham Ma-ri, cần tảy khỏ hít cung vi̱ pi̱ noọng <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />Phjác vàm tuụng tham An-trô-ni-cơ xáu Giu-ni-a, pi̱ noọng chang lưừn ngo̱ xáu pàng dạu xày ngài xăng đủi ngo̱, sloong cần đảy ha nả chang kí cần đảy xoi pay, xáu slấn Chảu Cháu Ti̱ Da̱ cón ngo̱. <verse eid="ROM 16:7" /><verse number="8" style="v" sid="ROM 16:8" />Phjác vàm tuụng tham thưng A-li-a, cần ngo̱ pèng điíp chang Chảu. <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />Phjác vàm tuụng tham thưng U-rơ-banh, pàng dạu tò xày hít cung đủi ngo̱ chang Chảu Cháu Ti̱ Da̱, xáu Ếch-ta-chy, pàng dạu ngo̱ pèng điíp. <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />Phjác vàm tuụng tham thưng A-be-lơ, cần đảy tỏn chiíp chang Chảu Cháu Ti̱ Da̱. Xo tuụng tham thưng kí cần dú chang lưừn A-rích-tô-bu. <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />Phjác vàm tuụng tham Hê-rô-đi-ôn, pi̱ noọng ngo̱. Xo tuụng tham kí cần chang lưừn Nạt-xít, kí cần dú chang Chảu <verse eid="ROM 16:11" /><verse number="12" style="v" sid="ROM 16:12" />Xo tuụng tham Try-phe-nơ xáu Try-phô-sơ, sloong cần tảy khỏ vi̱ Chảu. Xo tuụng tham Bẹt-si-đơ pèng điíp, cần tảy khỏ hít cung hử Chảu <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" />Xo tuụng tham Ru-phu, cần đảy Chảu lưư̱c, xáu xo tuụng tham mé báo nỉnh xày chư̱ mé cú ngo̱. <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />Xo tuụng tham A-sin-cơ-rích, Phơ-lê-gôn, Hẹt-me, Ba-trô-ba, Hẹt-ma, xáu kí pi̱ noọng dú đủi hau. <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />Xo tuụng tham Phi-lô-lô-gơ xáu Giu-li, Nê-rê xáu pi̱ slao cú báo nỉnh, Ô-lim, xáu thuủn kí cần slấn dú đủi hau. <verse eid="ROM 16:15" /><verse number="16" style="v" sid="ROM 16:16" />Lèo au vàm đay sle tuụng tham căn. Thuủn kí ho̱i thánh cú Chảu Cháu Ti̱ Da̱ phjác vàm tuụng tham pi̱ noọng.<verse eid="ROM 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />Pi̱ noọng ới, ngo̱ cạ pi̱ noọng lèo slỉnh sla̱c đủi kí cần hít oóc kí phang xáu hít hử toỏng lụp, tỉng te̱o kí lo̱ pi̱ noọng tó đảy slon, lèo phiín khói hau pay. <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />Vi̱ kí cần nỉnh bó cung ta̱i Chảu Cháu Ti̱ Da̱ hung làu, tọ cung ta̱i chăn ăn múc cú hau; hau au vàm van pác sle láu kí cần chăn slim. <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />Vi̱ slim pi̱ noọng ti̱ng vàm sle khay quảng thưng mọi cần. Pìn nỉnh, ngo̱ chứng hun hỉ mà pi̱ noọng, tọ ngo̱ mu̱ng pi̱ noọng đảy quai kí hít lo̱ đay xáu slaư tích, mí hít lo̱ slại. <verse eid="ROM 16:19" /><verse number="20" style="v" sid="ROM 16:20" />Chảu Fạ pình an co̱i dă̱m ta̱p Sa-tan tảư kha pi̱ noọng khoái. Xỉnh xo fúc Chảu pảo hử ma̱i cạ làu bó ngám, chư̱ Chảu Giê-xu Cháu Ti̱ Da̱ dú đủi pi̱ noọng.<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />Ti-mô-thê, cần tò xày hít cung đủi ngo̱, xáu Lu-si-út, Gia-sôn xáu Sô-xi-ba-tê, kí cần chang lưừn cú ngo̱ xày tuụng tham pi̱ noọng. <verse eid="ROM 16:21" /><verse number="22" style="v" sid="ROM 16:22" />Ngo̱, Tẹt-tiu, cần slẻ baư slư nảy, tuụng tham pi̱ noọng chang Chảu. <verse eid="ROM 16:22" /><verse number="23" style="v" sid="ROM 16:23" />Gai-út, cần chiíp tỏn ngo̱ xáu tằng ho̱i thánh, tuụng tham pi̱ noọng. Ê-ra-tu, cần cuủn lị xang ngừn cú slẻng, xáu Qua-tu, xáu cần pi̱ noọng, phjác vàm tuụng tham pi̱ noọng num. <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />[Xỉnh xo fúc Chảu hung làu pảo hử ma̱i cạ làu bó ngám, chư̱ Chảu Giê-xu Cháu Ti̱ Da̱ dú đủi thuủn pi̱ noọng. A-men.]<verse eid="ROM 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />Că̱n Lạo mì quỳn hít pi̱ noọng đảy mắn slèng nèm Vàm Đay cú ngo̱ páo cạ mà Chảu Giê-xu Cháu Ti̱ Da̱, xị đảy hăn chang slim khoăn mà lo̱ dăm dò tó mì quá lai tơ̱i, <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />tọ cà nạy đảy hăn quá kí xéc páo cón nèm lịng cú Chảu Fạ tơ̱i tơ̱i, tó đảy páo oóc hử mọi nòi cần xày chắc, sle hau slấn, <verse eid="ROM 16:26" /><verse number="27" style="v" sid="ROM 16:27" />xáu slu̱ng phjưức slục mà Min, chư̱ Chảu Fạ đeo, quai kí pừng Chảu Giê-xu Cháu Ti̱ Da̱, thưng tơ̱i tơ̱i. A-men!<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>