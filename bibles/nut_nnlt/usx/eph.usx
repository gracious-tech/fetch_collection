  <book code="EPH" style="id">EN_NNLT nut-x-north_Northern⋅Nung_ltr Thu Jul 16 2026 15:20:00 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Ephesians</para>
  <para style="toc1">Baư slư Ê-phê-sô</para>
  <para style="toc2">Ê-phê-sô</para>
  <para style="toc3">Eph</para>
  <para style="mt">Ê-phê-sô</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Phao-lô, nèm slim Chảu Fạ slưửng đảy Chảu Giê-xu Cháu Ti̱ Da̱ xoi pay, phjác thưng kí cần slấn dú Ê-phê-sô, chư̱ kí cần slim đeo chang Chảu Giê-xu Cháu Ti̱ Da̱. <verse eid="EPH 1:1" /><verse number="2" style="v" sid="EPH 1:2" />Xỉnh xo fúc Chảu pảo hử ma̱i cạ làu bó ngám, pình an tứ Chảu Fạ, Pá hung làu, xáu tứ Chảu chư̱ Chảu Giê-xu Cháu Ti̱ Da̱ pảo hử pi̱ noọng.<verse eid="EPH 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />Tài slung Chảu Fạ, Pá cú Chảu Giê-xu Cháu Ti̱ Da̱, Chảu hung làu, Lạo pảo hử hung làu mọi fúc đay, mọi fúc đay slục khoăn dú kí ti̱ tìng fạ chang Chảu Cháu Ti̱ Da̱, <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />tằng cạ vi̱ điíp Min chứng lưư̱c hung làu chang Chảu Cháu Ti̱ Da̱, chíu ti̱ da̱ nảy xằng đảy chí oóc, sle hung làu đảy slaư tích xáu mí mì lắng quáy đảy tói nả Min, <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />Min tó slưửng cón hử hung làu đảy hít lu̱c chưựng cú Min quá Chảu Giê-xu Cháu Ti̱ Da̱, nèm slim slưửng đay đắn cú Min, <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />sle tài slung fúc Chảu pảo hử ma̱i cạ làu bó ngám, slu̱ng phjưức Min pảo hử hung làu chang Lu̱c Min Pèng Điíp, <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />chang Lu̱c nỉnh, hung làu đảy cháu quá lưư̱t Min, đảy sla phít xá xị lo̱ fúng fàu cú fúc Chảu pảo hử ma̱i cạ làu bó ngám, <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />chăn fúc Chảu pảo hử ma̱i cạ hung làu bó ngám, đảy fúng fàu mọi lo̱ quai kí xáu thung slụ, <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />hít hử hung làu chắc đảy lo̱ dăm dò cú slim Min slưửng, nèm lo̱ đay đắn Min tó slưửng cón chang Chảu Cháu Ti̱ Da̱, <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />sle thưng slì xày xiìn, nèm slim slưửng, Min tom xỏn mọi lo̱ chang Chảu Cháu Ti̱ Da̱, tằng kí lo̱ tìng fạ xáu tảư tum, <verse eid="EPH 1:10" /><verse number="11" style="v" sid="EPH 1:11" />Chang Lạo hung làu xày đảy lưư̱c hít cần táp cha xài, đảy slưửng cón nèm slim cú Lạo hít mọi lo̱ nèm slim Min ái, <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />sle hung làu, kí cần ta̱i tàu tặt kháo mu̱ng khảu Chảu Cháu Ti̱ Da̱, chứng đảy că̱n mà slu̱ng phjưức cú Min. <verse eid="EPH 1:12" /><verse number="13" style="v" sid="EPH 1:13" />Chang Min, pi̱ noọng tó đảy ti̱ng vàm chăn lị, chư̱ Vàm Đay pi̱ noọng đảy cháu, pi̱ noọng slấn khảu Min đảy toỏng ín xị vàm Chảu Khoăn pao xình làu, <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />tọ Lạo nỉnh ín chửng mà cha xài cú hung làu thưng chíu kí cần slục mà Min đảy cháu, sle că̱n slu̱ng phjưức cú Min.<verse eid="EPH 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Pìn nỉnh, chíu ngo̱ ti̱ng mà slim slấn cú pi̱ noọng chang Chảu, chư̱ Chảu Giê-xu, xáu slim điíp cú pi̱ noọng hử kí cần slấn, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />do̱ ngo̱ lằm chă̱p sleng slu̱ Chảu Fạ vi̱ pi̱ noọng mại, nẳm thưng pi̱ noọng chang mọi vàm làu xỉnh chàu, <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />na̱i xo Chảu Fạ cú Chảu Giê-xu Cháu Ti̱ Da̱, Chảu hung làu, Pá slu̱ng phjưức, pảo hử pi̱ noọng khoăn quai kí xáu kí lo̱ đảy hăn chang slim khoăn, sle pi̱ noọng nhă̱n chắc Min, <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />hử múi ha cú slim pi̱ noọng đảy xoi slu̱ng, sle chắc kháo mu̱ng khảu Chảu tó dảo pi̱ noọng, sle chắc cha xài fúng fàu cú slu̱ng phjưức Min hử kí cần slấn pìn lừ, <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />sle pi̱ noọng chắc quỳn slèng cải luung mí au lăng pỉ đảy cú Min hử kí cần slấn xị hung làu pìn lừ, nèm kí cung sla̱y quỳn slèng cải luung cú Min, <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />chư̱ quỳn slèng Min tó hít quá Chảu Cháu Ti̱ Da̱ chíu hít Chảu Cháu Ti̱ Da̱ tứ ti̱ hai hòi te̱o, tặt nă̱ng bưửng sla Min dú kí ti̱ tìng fạ, <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />khảm quá mọi quỳn đé đẩn, mọi quỳn, mọi slèng, mọi cần căm quỳn, mọi mìng, mí tan chang tơ̱i nảy tọ tằng tơ̱i ái thưng num. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />Min tó tặt mọi lo̱ fục tảư kha Chảu Cháu Ti̱ Da̱, tặt Chảu Cháu Ti̱ Da̱ hít hu tìng mọi lo̱ vi̱ ho̱i thánh, <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />ho̱i thánh chăn chư̱ đúc đang Min, chư̱ xày xiìn cú Lạo hít đo mọi lo̱ chang mọi dưư̱ng.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />Pi̱ noọng tó hai vi̱ fa̱m fáp xáu phít xá cú làu, <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />chăn kí lo̱ pi̱ noọng kin dú xị kí cần tơ̱i nảy, hít nèm cần căm quỳn tìng khuung fạ, chư̱ slín cà nạy hít chang kí cần mí ti̱ng fục, <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />mư̱ cón, hung làu xày kin dú xị kí xám cần nỉnh, pjuúng pjúi nèm kí slém mu̱ng cú đúc đang, to̱i nèm kí slém mu̱ng cú đúc đang xáu slim ki. Pìn nỉnh, ngám sleng oóc hung làu tó chư̱ lu̱c cú xá fát fày xị mọi cần táng. <verse eid="EPH 2:3" /><verse number="4" style="v" sid="EPH 2:4" />Tọ Chảu Fạ, chư̱ Lạo tim slim điíp sliít, vi̱ Min au slim điíp cải luung sle điíp hung làu, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />ma̱i cạ hung làu tó hai vi̱ kí phít xá, do̱ Min hít hung làu tò te̱o xáu Chảu Cháu Ti̱ Da̱ — nỉnh chăn chư̱ pừng khảu fúc Chảu pảo hử ma̱i cạ làu bó ngám do̱ pi̱ noọng chứng đảy cháu — <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />xáu Min tó hít hung làu đảy hòi te̱o, dá co̱i đảy nă̱ng đủi Min dú kí ti̱ tìng fạ chang Chảu Giê-xu Cháu Ti̱ Da̱, <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />sle kí xám cần ái thưng chắc Min fúng fàu, quá fúc Chảu pảo hử ma̱i cạ làu bó ngám, slim quảng xáu hung làu chang Chảu Giê-xu Cháu Ti̱ Da̱. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />Vi̱ pi̱ noọng đảy cháu pừng khảu fúc Chảu pảo hử ma̱i cạ làu bó ngám, xáu quá slim slấn làu, lo̱ nảy mí tứ pi̱ noọng, tọ đảy Chảu Fạ pảo hử, <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />xày mí pừng khảu kí lo̱ hung làu hít, sle mí cần nàư ảng slưứng đảy. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Vi̱ hung làu chư̱ cung sla̱y cú mừ Min, đảy hít pìn quá Chảu Giê-xu Cháu Ti̱ Da̱, sle hung làu hít nèm kí lo̱ đay đảy Chảu Fạ slưửng cón hử hung làu.<verse eid="EPH 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Pìn nỉnh, lèo chứ cạ, mư̱ cón pi̱ noọng xị cần cú tum ti̱ táng mà fă̱n đúc đang, ngài kí cần đảy slắp năng chang đúc đang, dảo pi̱ noọng chư̱ cần xằng đảy slắp năng, tứ mừ tu cần, <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />vi̱ chíu nỉnh, pi̱ noọng dú quay Chảu Cháu Ti̱ Da̱, mí mì quỳn cú cần Y-sơ-ra-ên, mí quén sla̱y thưng chao kiít cú vàm pao xình, chứng mí mì kháo mu̱ng, xày mí mì Chảu Fạ dú ti̱ da̱ nảy. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />Tọ chang Chảu Giê-xu Cháu Ti̱ Da̱, pi̱ noọng chư̱ cần mư̱ cón dú quay, cà nạy đảy dú xảư quá lưư̱t cú Chảu Cháu Ti̱ Da̱. <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />Vi̱ chăn Min chư̱ pình an cú hung làu, Lạo tó cáp tằng cần Do Thái xáu kí cần cú tum ti̱ táng pìn nòi cần đeo, hít túm pha xình păn pja̱c hít hử xằng căn, chang đúc đang Min, <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />hít va̱i đai luật fáp xáu kí vàm slon cạ đảy slẻ pìn le̱ lài, sle Min hít tằng sloong bưửng pìn nòi cần máư đeo chang Min, chứng hít pìn lo̱ pình an, <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />xáu Min tó hít hử tằng sloong bưửng đảy đay đủi Chảu Fạ quá đúc đang đeo, Min xày chii̱t kí lo̱ tói tỉng tìng mạy các khoáy dá. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />Pìn nỉnh, Min thưng sle páo cạ pình an hử pi̱ noọng dú quay, xáu pình an hử kí cần dú xảư, <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />vi̱ pừng khảu Min, tằng sloong bưửng chứng đảy cáp khảu Chảu Khoăn đeo sle thưng đủi Pá. <verse eid="EPH 2:18" /><verse number="19" style="v" sid="EPH 2:19" />Pìn nỉnh, pi̱ noọng mí nhằng xị kí cần bó quén căn, xị kí cần cú tum ti̱ táng num. Tọ pìn cần tò xày pỏn ti̱ xáu kí cần slấn, pìn pi̱ noọng chang lưừn cú Chảu Fạ, <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />pi̱ noọng đảy xáy tìng ti̱ choóc cú kí cần đảy Chảu xoi pay xáu kí cần páo cón, nhằng Chảu Giê-xu Cháu Ti̱ Da̱ chăn chư̱ ca̱o hin slảng, <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />chang Min, tằng ăn lưừn đảy cáp đủi căn xáy pìn lưừn slớ thánh đeo chang Chảu, <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />xày chang Min, pi̱ noọng xày đảy xáy khảu lưừn nỉnh, sle pìn ti̱ Chảu Fạ dú chang Chảu Khoăn.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Pìn nỉnh, Phao-lô chứng pìn cần ngài xăng cú Chảu Giê-xu Cháu Ti̱ Da̱, vi̱ pi̱ noọng cú tum ti̱ táng — <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />cay pi̱ noọng tó đảy ti̱ng cạ ngo̱ đảy Chảu Fạ chao hử cai cuủn fúc Chảu pảo hử ma̱i cạ ngo̱ bó ngám sle pang hử pi̱ noọng, <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />xáu Min hử ngo̱ đảy hăn chang slim khoăn mà kí lo̱ dăm dò pìn lừ, xị ngo̱ tó slẻ tẩn hử pi̱ noọng dá. <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />To̱c thưng nỉnh, do̱ pi̱ noọng chắc ngo̱ thung slụ mà kí lo̱ dăm dò cú Chảu Cháu Ti̱ Da̱ pìn lừ, <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />kí lo̱ dăm dò nảy, Chảu Fạ mí hử kí xám cần mư̱ cón đảy chắc, tọ cà nạy Chảu Khoăn hử kí cần đảy Min xoi pay thánh xáu kí cần páo cón đảy chắc — <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />lo̱ dăm dò nỉnh xị cạ: kí cần cú tum ti̱ táng xày đảy táp cha xài xáu cần tò xày hít pìn đúc đang đeo, kí cần đảy păn vai vàm pao xình chang Chảu Giê-xu Cháu Ti̱ Da̱ pừng khảu Vàm Đay, <verse eid="EPH 3:6" /><verse number="7" style="v" sid="EPH 3:7" />pừng khảu Vàm Đay nỉnh, ngo̱ đảy fúc Chảu pảo hử ma̱i cạ làu ngo̱ ngám nèm xị quỳn slèng cú Min. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />Chảu Fạ tó pảo fúc ma̱i cạ ngo̱ bó ngám — cần sláy slít chang kí cần slấn — sle páo cạ hử cần cú tum ti̱ táng mà lo̱ fúng fàu mí án đảy cú Chảu Cháu Ti̱ Da̱, <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />xáu hử mọi cần chắc Chảu Fạ, Lạo chí oóc mọi lo̱ tó cai cuủn kí dăm dò quá kí tơ̱i cần, <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />sle cà nạy, quá ho̱i thánh, lo̱ quai kí fúng fàu cú Chảu Fạ đảy hử kí cần căm tàu, kí cần căm quỳn dú kí ti̱ tìng fạ chắc, <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />nèm chăn slim tơ̱i tơ̱i Min tó slưửng hít xày xiìn chang Chảu Giê-xu Cháu Ti̱ Da̱, chăn chư̱ Chảu hung làu, <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />chang Lạo nỉnh, pừng slim slấn khảu Min, hung làu chứng đảy tài tảm xáu mắn slim thưng xảư Chảu Fạ. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Pìn nỉnh, ngo̱ xo pi̱ noọng mí đảy nái slim vi̱ kí chai na̱n ngo̱ tảy vi̱ pi̱ noọng, kí chai na̱n nỉnh chăn chư̱ slu̱ng phjưức cú pi̱ noọng.<verse eid="EPH 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Vi̱ lo̱ nỉnh, ngo̱ qu̱y kháu tói nả Pá, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />tứ Min mọi nòi cần dú tìng fạ, tảư tum đảy tặt mìng, <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />ngo̱ xỉnh xo cạ nèm lo̱ fúng fàu cú slu̱ng phjưức Min, pảo hử pi̱ noọng quỳn cú Khoăn Min, sle hít tu cần bưửng đưng cú pi̱ noọng pìn slèng dạc, <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />sle Chảu Cháu Ti̱ Da̱ dú chang slim pi̱ noọng pừng khảu slim slấn, chứng đảy chắp la̱c xáu mắn slèng chang slim điíp, <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />sle tò xày kí cần slấn, pi̱ noọng slụ đảy tàng khoang, tàng lì, tàng slung, tàng đắc pìn lừ, <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />xáu sle chắc đảy slim điíp cú Chảu Cháu Ti̱ Da̱ khảm quá mọi lo̱ thung slụ, sle pi̱ noọng đảy Chảu Fạ đíng hử tim mọi lo̱ fúng fàu.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />Xo nẳm thưng Lạo au quỳn slèng hít chang hung làu, hít đảy lai quá mọi lo̱ hung làu xỉnh xo do̱ va̱ nẳm thưng, <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />xo Min đảy slu̱ng phjưức chang ho̱i thánh xáu chang Chảu Giê-xu Cháu Ti̱ Da̱ quá mọi xám cần, thưng tơ̱i tơ̱i. A-men.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Pìn nỉnh, ngo̱ ngài xăng chang Chảu, ngo̱ na̱i xo pi̱ noọng lèo kin dú ngám xáu kí lo̱ Chảu dảo pi̱ noọng, <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />lèo thuủn slim nhă̱n nhưư̱ng, on van xáu tảy na̱i, lèo tảy nẳm căn chang slim điíp, <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />lèo oóc slèng chưứng mắn slim đeo đủi căn chang Chảu Khoăn. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />Tan mì đúc đang đeo, Chảu Khoăn đeo, xị pi̱ noọng tó đảy dảo thưng kháo mu̱ng đeo, <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />tan mì Chảu đeo, slim slấn đeo, báp-têm đeo, <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />tan mì Chảu Fạ đeo, Pá cú mọi cần, Lạo dú tìng mọi cần, tu̱ng chang mọi cần xáu đưng mọi cần. <verse eid="EPH 4:6" /><verse number="7" style="v" sid="EPH 4:7" />Tọ fúc Chảu pảo hử moi cần chang hung làu ma̱i cạ hung làu bó ngám, ngòi khảu slim cú Chảu Cháu Ti̱ Da̱ pảo hử. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />Pìn nỉnh, mì vàm slẻ:</para>
  <para style="q1" vid="EPH 4:8">“Chíu tó khửn ti̱ slung,</para>
  <para style="q1" vid="EPH 4:8">Min tái nèm kí cần ngài xăng,</para>
  <para style="q1" vid="EPH 4:8">pảo lai fúc đay hử tu cần.”<verse eid="EPH 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />Tọ, “Min tó khửn” do̱ mì ý xí lăng, hạy mí chư̱ Min tó lùng kí ti̱ hẳm tắm dú tảư tum? <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Chăn Lạo tó lùng xày chư̱ Lạo tó khửn tìng slung quá thuủn kí tẳm fạ sle Min hít xày xiìn đảy mọi lo̱. <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />Chăn Min pảo hử kỉ cần hít cần đảy xoi pay, kỉ cần đảy páo cón, kỉ cần táng pay páo cạ Vàm Đay, kỉ cần do̱ hít mục sư xáu hít slay slon cạ, <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />sle chắp xặp kí cần slấn hử cung sla̱y cung ta̱i, sle xáy tẳng đúc đang Chảu Cháu Ti̱ Da̱, <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />thưng slì thuủn hung làu đảy slim đeo đủi căn chang slim slấn, đảy thung slụ mà Lu̱c Chảu Fạ, sle pìn cần cứ cải khửn, dá pìn xày xiìn xị Chảu Cháu Ti̱ Da̱, <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />sle hung làu co̱i mí nhằng xị lu̱c đích, ngài quỷn nèm kí lo̱ slon cạ lùm slại, tứ kí màu, pjàng pjào, xan xảo cú tu cần. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />Min ái hung làu chảng chăn lị chang slim điíp, sle đảy cải khửn chang mọi lo̱, dưứng mà Min, Lạo chăn chư̱ hu, nhằng dảo hít Chảu Cháu Ti̱ Da̱, <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />chăn Min hít tằng đúc đang slan cáp mắn xáu căn tứ kí tèo dần, xị mọi fă̱n hít chăn cung sla̱y cú làu, do̱ tằng đúc đang đảy cải khửn, xáu xáy tẳng chang slim điíp.<verse eid="EPH 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Pìn nỉnh, ngo̱ chảng xáu na̱i xo pi̱ noọng chang mình Chảu, sle mí nhằng cần nàư kin dú hút xị cần mí slấn num, vi̱ hau kin dú nèm mọi lo̱ làu nẳm va̱i đai. <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />Slim ki hau pìn đăm khít, dú quay lo̱ te̱o cú Chảu Fạ pảo hử, vi̱ slim hau tăn bả xáu kheng kháng. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />Hau tó túc tằng slim ki, pjuúng pjúi chang phít xá, slém mu̱ng mọi lo̱ slẳm sla̱p. <verse eid="EPH 4:19" /><verse number="20" style="v" sid="EPH 4:20" />Tọ, pi̱ noọng tó mí slon chắc Chảu Cháu Ti̱ Da̱ pìn nỉnh đơ, <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />vi̱ cay pi̱ noọng tó đảy ti̱ng, đảy slon mà Chảu Giê-xu, nèm xị chăn lị, <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />cạ pi̱ noọng lèo tả kí lo̱ kin dú cú tu cần mư̱ cón, tó ngài va̱i vi̱ kí slém mu̱ng pjàng pjào, <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />pi̱ noọng lèo pừng khảu Chảu Khoăn sle slim ki làu đảy tói máư, <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />dá nu̱ng au tu cần máư, chư̱ tu cần đảy hít pìn hút xị dưư̱ng slưứng Chảu Fạ — sle kin dú cung chính xáu slaư tích nèm chăn lị.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />Pìn nỉnh, mọi cần lèo tả kí lo̱ pjàng pjào, lèo chảng chăn xáu cần xảư xảng làu, vi̱ hung làu xày chư̱ kí fă̱n đúc đang đủi căn. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />Chíu pi̱ noọng fát slíng do̱ mí đảy fa̱m xá. Mí đảy fát slíng thưng slì ha vằn lặm, <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />mí đảy hít pìn chúng slì đay hử phi sla̱. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />Cần quén kin lặc, mí đảy kin lặc num. Tọ lèo tảy khỏ, táng mừ làu hít lo̱ đay sle pang cho̱i đảy cần slỉu khỏ do̱ hẳm đay. <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />Mí đảy chảng oóc vàm slẳm sla̱p haư tứ pác pi̱ noọng, tọ lèo chảng vàm đay đắn, sle cần ti̱ng vàm nỉnh chíu phúng chíp khỏ, đảy xáy tẳng xáu co̱i đảy fúc, <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />xáu mí đảy hít xàu Chảu Khoăn cú Chảu Fạ, vi̱ chang Min, pi̱ noọng đảy ín chửng thưng vằn đảy cháu. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />Pi̱ noọng lèo tả kí lo̱ khum phít, fát fày, fát slíng, đá căn, bjắc bjỏi xáu mọi lo̱ too̱c éc khói slim pay. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />Tọ, lèo kin dú slim quảng, điíp slít căn, sla dưư̱ng căn xị Chảu Fạ tó sla dưư̱ng pi̱ noọng chang Chảu Cháu Ti̱ Da̱.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />Pìn nỉnh, pi̱ noọng lèo hít nèm Chảu Fạ, xị kí lu̱c đảy Min pèng điíp, <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />lèo kin dú chang slim điíp xị Chảu Cháu Ti̱ Da̱ tó điíp hung làu, Min slỉ mi̱ng vi̱ hung làu xị cú cái xáu sleng lình mì mi̱ hom pài khửn Chảu Fạ.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />Nhằng kí lo̱ eo đẳn xáu mọi lo̱ slẳm sla̱p, thám cò, do̱ pi̱ noọng mí đảy nẳm thưng; pìn nỉnh chứng ngám chư̱ kí cần slấn, <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />mí đảy chảng lảo, chảng quàng, chảng bả — chảng kí vàm mí ngám — tọ lèo sleng slu̱ do̱ hẳm đay. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />Pi̱ noọng lèo chắc khan kí cần eo đẳn, slẳm sla̱p, thám cò — kí cần pái slớ xằn tum — xày mí đảy táp cha xài chang tum ti̱ cú Chảu Cháu Ti̱ Da̱ xáu Chảu Fạ. <verse eid="EPH 5:5" /><verse number="6" style="v" sid="EPH 5:6" />Mí đảy sle cần nàư au kí vàm pjáu lưứng pjàng pjào pi̱ noọng, chăn vi̱ kí lo̱ nỉnh xá fát fày cú Chảu Fạ chứng cháng lùng nòi cần mí ti̱ng vàm. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Pìn nỉnh, pi̱ noọng mí đảy pang fă̱n đủi hau, <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />mư̱ cón pi̱ noọng nhằng dú chang ngàu đăm, tọ cà nạy chang Chảu, pi̱ noọng xị áng slu̱ng. Lèo kin dú xị lu̱c cú áng slu̱ng <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />(vi̱ mác cú áng slu̱ng chăn chư̱ mọi lo̱ đay đắn, cung chính xáu lạo slặt), <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />Lèo slỉu slim ngòi kí lo̱ lăng do̱ đay slim Chảu. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Mí đảy pang fă̱n xáu kí lo̱ va̱i đai cú ngàu đăm, tọ lèo dẻng kí lo̱ nỉnh oóc do̱ hẳm đay, <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />vi̱ tan chảng thưng kí lo̱ hau lặc lu̱m hít tó xảu nả dá. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />Tọ thuủn mọi lo̱ đảy dẻng oóc noo̱c áng slu̱ng, vi̱ kí lo̱ lăng ngài lo̱i oóc xày chư̱ áng slu̱ng. <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />Pìn nỉnh, mì vàm slẻ cạ:</para>
  <para style="q1" vid="EPH 5:14">“Hày kí cần nòn, tấn khoái vảy,</para>
  <para style="q1" vid="EPH 5:14">lèo pu̱ng tấn tứ chang kí cần hai,</para>
  <para style="q1" vid="EPH 5:14">do̱ Chảu Cháu Ti̱ Da̱ co̱i xoi slu̱ng mưng.”<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Pìn nỉnh, lèo ngòi hử vẳn chằn kí lo̱ pi̱ noọng kin dú — mí đảy hút xị cần bả bứt, tọ lèo xị cần quai kí, <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />lèo du̱ng slì slằn hử đay, vi̱ kí vằn chăn xảu. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />Pìn nỉnh, mí đảy pìn xị cần bả bứt, tọ lèo chắc slim Chảu slưửng pìn lừ. <verse eid="EPH 5:17" /><verse number="18" style="v" sid="EPH 5:18" />Mí đảy màu lảu, vi̱ màu lảu tái thưng pjuúng pjúi. Tọ, lèo fúng fàu Chảu Khoăn, <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />lèo đủi căn au sli thiin, kí tèo sli thánh, xáu kí tèo sli slim khoăn; thuủn slim xưứng sli sle tài slung Chảu, <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />Chang mọi lo̱, lèo slưừng slì au mình Chảu Giê-xu Cháu Ti̱ Da̱ sle sleng slu̱ Chảu Fạ, chư̱ Pá hung làu, <verse eid="EPH 5:20" /><verse number="21" style="v" sid="EPH 5:21" />pi̱ noọng lèo ti̱ng fục căn, kiíng lao Chảu Cháu Ti̱ Da̱ —<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />Hày cần hít me̱, lèo fục po̱ làu xị fục Chảu, <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Vi̱ po̱ xị hu cú me̱, xị Chảu Cháu Ti̱ Da̱ xị hu cú ho̱i thánh — chăn Min chư̱ Lạo Cháu đúc đang. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Pìn nỉnh, xị ho̱i thánh fục Chảu Cháu Ti̱ Da̱ pìn lừ, do̱ me̱ xày lèo fục po̱ làu chang mọi lo̱ pìn nỉnh. <verse eid="EPH 5:24" /><verse number="25" style="v" sid="EPH 5:25" />Hày cần hít po̱, lèo điíp me̱ làu xị Chảu Cháu Ti̱ Da̱ tó điíp ho̱i thánh, slỉ mi̱ng vi̱ ho̱i thánh, <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />sle Min au nặm xáu vàm đay slào, sle ho̱i thánh đảy slaư tích, <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />sle ho̱i thánh slu̱ng phjưức dân tói nả Min, mí mì lòi slẳm, mí nháu, mí ngài lòi lăng, tọ sle đảy slaư tích xáu mí mì lăng quáy đảy. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />Xày pìn nỉnh, po̱ lèo điíp me̱ xị chăn đúc đang làu. Cần po̱ điíp me̱ xị cạ điíp chăn làu. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />Vi̱ mí mì cần nàư xằng chăn làu, tọ chưựng xáu ngòi nho̱m min xị Chảu Cháu Ti̱ Da̱ hít xáu ho̱i thánh, <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />vi̱ hung làu xị kí fă̱n cú đúc đang Min. <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />“Chăn pìn nỉnh, cần ti̱ po̱ co̱i pja̱c pá mé sle cáp xáu me̱ làu, tằng sloong xày pìn đang nưng.” <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />Kí dăm do̱ nảy chăn cải luung — tọ, ngo̱ ái chảng thưng Chảu Cháu Ti̱ Da̱ xáu chảng mà ho̱i thánh. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />Pìn nỉnh do̱ — mọi cần — chang pi̱ noọng, po̱ lèo điíp me̱ xị chăn làu, nhằng me̱ do̱ lèo kiíng chu̱ng po̱.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />Hày kí cần hít lu̱c, lèo ti̱ng vàm pá mé làu chang Chảu, vi̱ nảy chăn lo̱ chư̱. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />“Lèo ngòi đay pá mé lu̱c” (nỉng chư̱ vàm slon cạ ta̱i ít, nèm vàm pao xìng), <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />“sle lu̱c đảy fúc xáu đảy dú lai pi ké tìng tum.” <verse eid="EPH 6:3" /><verse number="4" style="v" sid="EPH 6:4" />Hày kí cần hít pá, mí đảy hít hử lu̱c làu fát slíng. Tọ lèo chưựng hung min kheng khên xị vàm Chảu Fạ slon cạ.<verse eid="EPH 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />Hày kí cần hít khỏi, lèo chăn slim fục lạo chảu nèm đúc đang, slằn lao xị xáu Chảu Cháu Ti̱ Da̱, <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />mí chư̱ tan fục tói nả, xị kí cần ái đảy slim tu cần, tọ xị kí cần hít khỏi cú Chảu Cháu Ti̱ Da̱, thuủn slim hít nèm slim Chảu Fạ slưửng, <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />lèo thuủn slim cung ta̱i căn xị cung ta̱i Chảu, tó mí chư̱ cung ta̱i hau, <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />vi̱ chắc cạ, cần hít khỏi do̱ va̱ cần táng hít chảu, hạy hít cung đay do̱ mọi cần co̱i đảy Chảu păng cung tùng căn.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />Hày cần hít chảu, lèo tói ta̱i đay xáu kí cần hít khỏi, mí đảy há pả hau, vi̱ chắc cạ tằng hau xáu pi̱ noọng tan mì Lạo Chảu đeo dú tìng fạ, xáu Min mí nghiíng mà slắc cần chạy.<verse eid="EPH 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />Sloót hang, pi̱ noọng lèo mắn slèng chang Chảu, xáu pừng khảu quỳn slèng cú Min. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />Pi̱ noọng lèo nu̱ung slử cháp cú Chảu Fạ au pay tức slức, do̱ chứng dân mắn dá tỉng te̱o đảy kí màu cú phi sla̱. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Vi̱ hung làu tức slức, mí chư̱ tỉng te̱o lưư̱t xáu nự, tọ tỉng te̱o kí cần đé đẩn, kí quỳn, kí cần căm tàu ti̱ da̱ đăm khít nảy, xáu kí slín xan dú kí ti̱ tìng fạ. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />Pìn nỉnh, lèo nu̱ng slử cháp cú Chảu Fạ, au pay tức slức, sle chang vằn chai na̱n, pi̱ noọng tỉng te̱o đảy, xáu slì hình dá, do̱ dân đảy mắn táng. <verse eid="EPH 6:13" /><verse number="14" style="v" sid="EPH 6:14" />Pìn nỉnh, pi̱ noọng lèo dân mắn, au chăn lị hít slai hảng lăng, nu̱ng slử cháp cung chính, <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />thư cài khảu kha, ính xình hử Vàm Đay pình an, <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />slưừng slì au slim slấn hít ăn tảng mại, pừng khảu nỉnh, pi̱ noọng chứng đắp đảy mọi pưn fày cú cần too̱c éc. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />Lèo thư tù cú lo̱ cháu xáu căm dáng cú Chảu Khoăn, chăn chư̱ vàm Chảu Fạ, <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />lèo au mọi vàm xỉnh chàu, na̱i xo sle xỉnh chàu Chảu Khoăn, cứ, slỉng sla̱c, tảy na̱i xỉnh chàu hử kí cần slấn, <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />xày xỉnh chàu hử ngo̱ num, sle slì ngo̱ khay pác slon cạ, do̱ đảy tài tảm páo oóc lo̱ dăm dò cú Vàm Đay <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />(ngo̱ chứng pìn cần tang nả hử Vàm Đay nảy chang cu̱m lích), cứ xỉnh chàu sle ngo̱ tài tảm páo oóc vàm đay nỉnh xị pỏn fă̱n ngo̱ lèo chảng.<verse eid="EPH 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />Ty-chi-cơ, pi̱ noọng pèng điíp xáu cần slim đeo cung ta̱i Chảu, co̱i li̱n te̱o hử pi̱ noọng mọi lo̱ sle pi̱ noọng xày chắc đảy cà nạy ngo̱ pìn lừ xáu hít lăng, <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />ngo̱ xoi min thưng đủi pi̱ noọng, sle pi̱ noọng chắc cà nạy ngo̱ pìn lừ, xáu sle nhòi slim pi̱ noọng.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />Xỉnh hử pi̱ noọng đảy pình an, mì slim điíp xáu slim slấn tứ Chảu Fạ chư̱ Pá, xáu tứ Chảu chư̱ Chảu Giê-xu Cháu Ti̱ Da̱. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />Xỉnh hử fúc Chảu pảo hử ma̱i cạ làu bó ngám dú đủi thuủn kí cần mì slim pèng điíp Chảu hung làu, chăn chư̱ Chảu Giê-xu Cháu Ti̱ Da̱ mại mại.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>