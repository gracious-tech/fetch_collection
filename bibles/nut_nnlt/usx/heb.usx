  <book code="HEB" style="id">EN_NNLT nut-x-north_Northern⋅Nung_ltr Thu Jul 16 2026 15:20:00 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Hebrews</para>
  <para style="toc1">Baư slư Hê-bơ-rơ</para>
  <para style="toc2">Hê-bơ-rơ</para>
  <para style="toc3">Heb</para>
  <para style="mt">Hê-bơ-rơ</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Tứ mư̱ ké, quá lai pày, lai lo̱, Chảu Fạ du̱ng kí cần páo cón slon cạ cúc chỏ dá, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />do̱ khảu kí vằn sloót hang nảy, Min tó slon cạ hung làu quá Lu̱c Min, chư̱ Lạo Min tó tặt sle hít Cần Táp Cha Xài mọi lo̱; xày quá Lu̱c nỉnh, Min tó chí oóc mọi lo̱ tìng ti̱ da̱ nảy; <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Lu̱c nỉnh chăn chư̱ áng slu̱ng, slu̱ng phjưức, dưư̱ng slưứng chăn cú Min, au vàm quỳn slèng sle tài mọi lo̱, slào slaư phít xá dá, Lu̱c nỉnh chứng đảy nă̱ng bưửng sla Lạo Ta̱i Luung dú tìng slung; <verse eid="HEB 1:3" /><verse number="4" style="v" sid="HEB 1:4" />đảy slung pèng quá kí cần tang nả fạ kỉ lai, do̱ mình Lu̱c đảy slung pèng quá mình kí cần tang nả fạ tùng nỉnh lai. <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />Vi̱ mì slắc pày Min cạ cần tang nả fạ haư:</para>
  <para style="q1" vid="HEB 1:5">“Mưng chư̱ Lu̱c Cau.</para>
  <para style="q1" vid="HEB 1:5">Vằn nảy Cau tó sleng oóc Lu̱c”?</para>
  <para style="m" vid="HEB 1:5">Xáu mì slắc pày cạ:</para>
  <para style="q1" vid="HEB 1:5">“Cau co̱i hít Pá cú Mưng,</para>
  <para style="q1" vid="HEB 1:5">Mưng co̱i hít Lu̱c cú Cau”?<verse eid="HEB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6" />Tọ nhằng quá pìn nỉnh, chíu Min au Lu̱c Tàu khảu ti̱ da̱, Min cạ: “Mọi cần tang nả Chảu Fạ lèo pái slớ Lu̱c nỉnh.” <verse eid="HEB 1:6" /><verse number="7" style="v" sid="HEB 1:7" />Chảng mà kí cần tang nả, do̱ Min cạ:</para>
  <para style="q1" vid="HEB 1:7">“Lạo hít hử kí cần tang nả lủm xị lầm,</para>
  <para style="q1" vid="HEB 1:7">xáu kí cần khỏi pìn kí piu fày.”<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Tọ chảng mà Lu̱c nỉnh, do̱ mì vàm cạ:</para>
  <para style="q1" vid="HEB 1:8">“Pái Chảu Fạ, ti̱ Min nă̱ng nhằng mì mại mại,</para>
  <para style="q1" vid="HEB 1:8">quỳn cú tum ti̱ Chảu chăn chư̱ quỳn cung chính.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />Min ái lo̱ cung chính, xằng lo̱ slảy khum.</para>
  <para style="q1" vid="HEB 1:9">Pìn nỉnh, Chảu Fạ chư̱ Chảu Fạ cú Min,</para>
  <para style="q1" vid="HEB 1:9">tó ma̱t dù hun hỉ hử Min cải quá kí pàng dạu Min.”<verse eid="HEB 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 1:10" />“Chảu Fạ ới, chíu tàu Chảu tó tặt tum ti̱ da̱,</para>
  <para style="q1" vid="HEB 1:10">xáu kí tẳm fạ chăn chư̱ cung sla̱y cú Min hít!<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />Tum fạ co̱i quá pay, tọ Chảu xày nhằng mì mại;</para>
  <para style="q1" vid="HEB 1:11">mọi lo̱ co̱i cáu pay hút xị cùng slử lì,<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />xị cùng slử pao, Chảu co̱i quỷn hung min khảu,</para>
  <para style="q1" vid="HEB 1:12">xị cùng slử noo̱c, lèo ngài vư̱n cùng slử táng,</para>
  <para style="q1" vid="HEB 1:12">tọ Min xày mí piín tói,</para>
  <para style="q1" vid="HEB 1:12">kí pi bưưn cú Min tó mí thuủn slắc pày.”<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Tọ, mì slắc pày Min cạ cần tang nả haư:</para>
  <para style="q1" vid="HEB 1:13">“Lèo nă̱ng bưửng sla Cau,</para>
  <para style="q1" vid="HEB 1:13">thưng slì Cau tặt kí cần tói tàu hít ti̱ te̱m kha hử Lu̱c”?<verse eid="HEB 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />Bó chư̱ thuủn kí cần tang nả fạ nỉnh chư̱ kí slín cung ta̱i, đảy xoi lùng sle cung ta̱i kí cần co̱i đảy fúc cháu do̱ lừ?<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Pìn nỉnh, hung làu chứng lèo tặt slim hẳm lai num, khảu kí vàm tó đảy ti̱ng, lao làu te̱o ngài quỷn pay va̱. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Vi̱ hạy vàm cú cần tang nả fạ páo oóc chăn chư̱ mắn táng, mọi phít xá xáu cần mí ti̱ng vàm xày ngám ngài páo xàu, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />do̱ hít lừ hung làu khói ngài fa̱t đảy, hạy hung làu ngòi che̱n fúc cháu cải pìn nỉnh? Fúc cháu nỉng đảy Chảu páo oóc tứ tẳm tàu, chăn kí cần đảy ti̱ng hít chửng hử hung làu dá. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Chảu Fạ xày hít chửng quá kí ha̱o pjòi, fép lạ, lai lo̱ quỳn slèng táng căn, xáu đảy Chảu Khoăn pảo hử kí lo̱ nèm slim cú Min slưửng.<verse eid="HEB 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Bó chư̱ hử kí cần tang nả Chảu Fạ pắt lèo fục tảư quỳn ti̱ da̱ mư̱ lăng, tọ ti̱ da̱ cà nạy hung làu chảng thưng. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Tọ mì cần tó hít chửng, cạ:</para>
  <para style="q1" vid="HEB 2:6">“Tu cần chư̱ ca lăng te̱o đảy Chảu chứ thưng,</para>
  <para style="q1" vid="HEB 2:6">lu̱c tu cần chư̱ ca lăng, te̱o đảy Chảu tặt slim thưng?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Chảu tó tặt min hẳm tắm quá kí cần tang nả fạ dắp nưng;</para>
  <para style="q1" vid="HEB 2:7">Chảu tó thư hử min tù bjoóc slu̱ng phjưức xáu đảy ha nả.<verse eid="HEB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8" />Chảu tặt mọi lo̱ fục tảư kha min.”</para>
  <para style="p" vid="HEB 2:8">Chíu pắt mọi lo̱ fục pìn nỉnh, Chảu Fạ bó sle lo̱ lăng mí fục min. Tọ, cà nạy hung làu xằng hăn mọi lo̱ fục min, <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />tọ hung làu đảy hăn Chảu Giê-xu, Lạo ngài tặt hẳm tắm quá kí cần tang nả fạ chang dắp nưng, đảy thư tù bjoóc slu̱ng phjưức xáu đảy ha nả vi̱ Min tó tảy chíp khỏ, tảy hai, sle pừng khảu fúc Chảu pảo hử ma̱i cạ làu bó ngám, Min tó xìm lo̱ hai sle mọi cần đảy cháu. <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />Vi̱ Chảu Fạ, mọi lo̱ chứng mì đảy, sle au lai lu̱c thưng slu̱ng phjưức, Min chứng hít Lạo Hít Tàu cú fúc cháu cú hau lèo tảy quá mọi chíp khỏ sle đảy xày xiìn. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />Vi̱ tằng Lạo slào slaư xáu tằng kí cần đảy slào slaư nỉnh tan tứ cần nưng oóc xày. Pìn nỉnh, Min mí hăn nả nhẻn dảo hau chư̱ pi̱ noọng đơ, <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />chíu cạ:</para>
  <para style="q1" vid="HEB 2:12">“Lu̱c co̱i páo cạ mình Chảu hử kí pi̱ noọng Lu̱c;</para>
  <para style="q1" vid="HEB 2:12">Lu̱c co̱i xưứng că̱n Chảu dú chang phang cần.”<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />Xày te̱o cạ:</para>
  <para style="q1" vid="HEB 2:13">“Cau co̱i slấn khảu Chảu Fạ.”</para>
  <para style="m" vid="HEB 2:13">Dá Min nhằng cạ:</para>
  <para style="q1" vid="HEB 2:13">“Ne̱, ngo̱ xáu kí lu̱c đích Chảu Fạ pảo hử ngo̱.”<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Vi̱ kí tu đích mì fă̱n tò xày lưư̱t nưng, chăn Min xày mì fă̱n xáu lưư̱t hút xị hau, sle quá lo̱ hai, Min xày chii̱t phi sla̱ chư̱ cần căm quỳn cú lo̱ hai đảy, <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />xáu cháu kí cần nỉnh, kí cần lao hai, te̱o hít khỏi thưng muu̱t tơ̱i. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Vi̱ chăn, mí chư̱ Min ngòi nho̱m kí cần tang nả fạ, tọ ngòi nho̱m lu̱c lan Áp-ra-ham, <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />pìn nỉnh, Min lèo đảy hút xị pi̱ noọng làu mà mọi lo̱, sle pìn slay pài xoòng ta̱i tàu tim slim điíp sliít xáu slim đeo quá cung sla̱y cung ta̱i Chảu Fạ, sle đảy fúc Chảu pảo hử ma̱i cạ làu bó ngám sle cháu phít xá hử phang cần cú Min. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Vi̱ chíu Min tó tảy khỏ slì ngài láu, chứng pang cho̱i đảy kí cần ngài láu.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Pìn nỉnh, pi̱ noọng chư̱ kí cần slaư tích, kí cần đảy táp fúc tìng fạ, cứ nẳm thưng Kí Cần Tang Nả xáu Slay Pài Xoòng Ta̱i Tàu, slim hung làu nhă̱n slấn khảu Chảu Giê-xu, <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />chíu tó slim đeo xáu Lạo tó tặt Min hử cung sla̱y nỉnh, xày xị Môi-se slim đeo chang lưừn Chảu Fạ né. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Lạo nảy đảy cung nhă̱n ngám sle đảy slu̱ng phjưức cải luung quá Môi-se lai fă̱n, xày xị càn xáy lưừn hẳm đảy ha nả quá chăn ăn lưừn kỉ lai. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Chăn pìn nỉnh, mọi ăn lưừn xày lèo mì cần tẳng khửn, tọ Chảu Fạ chư̱ Lạo hít oóc mọi lo̱. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Môi-se xị cần khỏi slim đeo chang tằng lưừn cú Chảu Fạ, sle hít chửng mà kí lo̱ co̱i đảy chảng thưng mư̱ lăng; <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />tọ Chảu Cháu Ti̱ Da̱ do̱ xị Lu̱c báo cai cuủn lưừn Chảu Fạ (hung làu chư̱ lưừn cú Min, tọ hạy hung làu cỏ mắn slim slấn ảng slưứng mà slim kháo mu̱ng cú hung làu). <verse eid="HEB 3:6" /><verse number="7" style="v" sid="HEB 3:7" />Pìn nỉnh, xị Chảu Khoăn cạ:</para>
  <para style="q1" vid="HEB 3:7">“Vằn nảy hạy kí lu̱c ti̱ng heng Min,<verse eid="HEB 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 3:8" />do̱ slim kí lu̱c mí đảy kheng xị chíu hít luu̱n,</para>
  <para style="q1" vid="HEB 3:8">xị chíu ngài xi cha̱m dú tu̱ng lẹng<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />ti̱ cúc chỏ kí lu̱c hăn cung sla̱y Cau hít,</para>
  <para style="q1" vid="HEB 3:9">te̱o nhằng xi Cau!<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />Quá slí slíp pi. Pìn nỉnh, Cau chứng fát slíng xám cần nỉnh,</para>
  <para style="q1" vid="HEB 3:10">Cau cạ: ‘Slim hung min lùm slại mại, mí nhă̱n chắc kí tèo lo̱ Cau.’<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Cau chứng pao xình chang xá fát fày cạ:</para>
  <para style="q1" vid="HEB 3:11">‘… Hung min co̱i bó đảy khảu lo̱ cha̱i choo̱c cú Cau!’”<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Pi̱ noọng ới, lèo slỉu slim, lao mì cần nàư slảy khum chang pi̱ noọng, túc slim slấn te̱o pja̱c khói Chảu Fạ te̱o tơ̱i tơ̱i va̱. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Tọ, vằn vằn pi̱ noọng lèo nhòi slim căn, thưng slì nhằng đảy dảo hít “vằn nảy,” sle mí mì slắc cần chang pi̱ noọng ngài phít xá pjàng pjào te̱o hít slim kheng. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Vi̱ hạy hung làu đảy mì fă̱n xáu Chảu Cháu Ti̱ Da̱, hạy hung làu cỏ mắn slim slấn ta̱i tàu cú làu thưng vằn sloót hang, <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />xị mì vàm slẻ cạ:</para>
  <para style="q1" vid="HEB 3:15">“Vằn nảy, hạy kí lu̱c ti̱ng heng Min,</para>
  <para style="q1" vid="HEB 3:15">do̱ mí đảy slim kheng xị chíu hít luu̱n.”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Cần nàư đảy ti̱ng heng dá te̱o hít Min fát slíng? Bó chư̱ kí cần đảy Môi-se tái oóc khói Ai Cập do̱ lừ? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />Nhằng Chảu Fạ tó fát slíng cần nàư quá slí slíp pi? Bó chư̱ kí cần fa̱m xá, sli hài cú hau tó lụp chang tu̱ng lẹng do̱ lừ? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Min xày pao xình xáu slắc cần cạ: Hau co̱i mí đảy khảu ti̱ cha̱i choóc cú Min, hạy bó chư̱ cạ kí cần mí ti̱ng vàm Min do̱ lừ? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Pìn nỉnh, hung làu hăn kí cần hau mí khảu nỉnh đảy vi̱ slim mí slấn.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Pìn nỉnh, hung làu lèo chắc slằn, lao vàm pao xình khảu lo̱ cha̱i choo̱c cú Chảu nhằng dú nỉnh, do̱ mì slắc cần chang pi̱ noọng te̱o ngài tả oóc. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Vi̱ hút xị hau, hung làu xày páo oóc Vàm Đay. Tọ ti̱ng vàm pìn nỉnh bó mì lăng đay hử hau, vi̱ chíu ti̱ng, hau mí au slim slấn nhă̱n au. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Mà fă̱n hung làu, chư̱ kí cần slấn dá, do̱ phjải khảu lo̱ cha̱i choo̱c nỉnh, xị vàm Chảu Fạ cạ:</para>
  <para style="q1" vid="HEB 4:3">“Xị Cau pao xình chang xá fát fày dá,</para>
  <para style="q1" vid="HEB 4:3">‘… hung min co̱i bó phjải khảu lo̱ cha̱i choo̱c cú Cau!’”</para>
  <para style="m" vid="HEB 4:3">Ma̱i cạ cung sla̱y cú Min tó hít thuủn tứ slì hít oóc ti̱ da̱. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Vi̱ mì ti̱ Min cạ mà vằn ta̱i chất cạ:</para>
  <para style="q1" vid="HEB 4:4">“Chảu Fạ cha̱i mọi cung sla̱y Min khảu vằn ta̱i chất.”<verse eid="HEB 4:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="HEB 4:5" />Min te̱o cạ dú ti̱ nưng num:</para>
  <para style="q1" vid="HEB 4:5">“… Hung min co̱i bó đảy phjải khảu lo̱ cha̱i choo̱c cú Cau.”<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />Pìn nỉnh, chíu vàm pao xình di̱ nhằng sle hử kỉ cần khảu lo̱ cha̱i choo̱c, tọ kí cần mư̱ cón tó đảy ti̱ng Vàm Đay tọ mí đảy khảu nỉnh vi̱ mí ti̱ng vàm, <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />do̱ Chảu Fạ te̱o slưửng vằn táng nưng, dảo hít “Vằn nảy,” chíu cạ đủi Đa-vít hả lai hưng, xị tó chảng tìng nỉnh:</para>
  <para style="q1" vid="HEB 4:7">“Vằn nảy hạy kí lu̱c ti̱ng heng Min,</para>
  <para style="q1" vid="HEB 4:7">do̱ mí đảy slim kheng.”<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />Vi̱ hạy Giô-suê tó hử hau cha̱i choo̱c, do̱ cay Chảu Fạ mí nhằng chảng mà vằn táng nưng num. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Pìn nỉnh do̱, di̱ nhằng vằn cha̱i choo̱c Sa-bát hử cần slục mà Chảu Fạ. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />Vi̱ cần nàư phjải khảu lo̱ cha̱i choo̱c cú Chảu Fạ, do̱ cần nỉnh cha̱i cung sla̱y làu, xày xị Chảu Fạ tó cha̱i cung sla̱y cú Min. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Pìn nỉnh, hung làu lèo oóc slèng phjải khảu lo̱ cha̱i choo̱c nỉnh, sle mí slắc cần lụp khảu, vi̱ hít nèm kí cần mí ti̱ng vàm nỉnh. <verse eid="HEB 4:11" /><verse number="12" style="v" sid="HEB 4:12" />Vi̱ vàm cú Chảu Fạ chư̱ vàm te̱o xáu lình ính, hầm quá ma̱c dáng sloong lịn, chặc thưng slặn păn oóc slim xáu khoăn, păn tằng đúc xáu tị, ứn chá kí slim ki xáu slim cú tu cần slưửng. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Bó mì lo̱ lăng dăm dò đảy tói nả Chảu. Tọ thuủn mọi lo̱ lèo đảy lo̱i xáu dẻng oóc tói nả Min, chư̱ Lạo hung làu lèo xỉnh khửn.<verse eid="HEB 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Pìn nỉnh, chíu hung làu mì slay pài xoòng ta̱i tàu cải luung tó khảm quá kí tẳm fạ, chăn chư̱ Chảu Giê-xu, Lu̱c Chảu Fạ, pìn nỉnh do̱ hung làu lèo cỏ mắn mà kí vàm làu chảng oóc. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Vi̱ bó chư̱ hung làu mì slay pài xoòng ta̱i tàu, mí to sla̱y thưng slim ón cú hung làu, tọ te̱o mì Lạo ngài láu đo mọi lo̱ xị hung làu, tọ bó mì phít xá lăng. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Pìn nỉnh, hung làu cứ mắn slim thưng xảư fúc Chảu pảo hử ma̱i cạ làu bó ngám, sle nhă̱n đảy slim điíp sliít xáu xa đảy fúc pang cho̱i hung làu chúng slì.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Mọi slay pài xoòng ta̱i tàu, chíu đảy lưư̱c tứ chang phang cần xáu đảy tặt tháy hử phang cần cung ta̱i Chảu Fạ, sle pài cú cái xáu sleng lình cháu phít xá; <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />chíu chắc kí cần tăn bả, lùm slại, vi̱ chăn ké xày ngài slim ón pắt fục. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Chứng vi̱ pìn nỉnh, min chứng lèo pài sleng lình cháu phít xá cú phang cần pìn lừ, do̱ xày hử chăn làu pìn nỉnh. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />Mí slắc cần táng nhă̱n ha nả nỉnh hử làu đảy, tọ lèo đảy Chảu Fạ dảo, hút xị A-rôn đảy dảo. <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />Xày pìn nỉnh, Chảu Cháu Ti̱ Da̱ mí táng tài làu hít slay pài xoòng ta̱i tàu. Tọ đảy Lạo tó cạ xáu Min:</para>
  <para style="q1" vid="HEB 5:5">“Lu̱c chư̱ Lu̱c Cau;</para>
  <para style="q1" vid="HEB 5:5">vằn nảy Cau tó sleng oóc Lu̱c.”<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />Xị Lạo nỉnh xày cạ dú ti̱ táng nưng:</para>
  <para style="q1" vid="HEB 5:6">“Lu̱c hít slay pài xoòng thưng tơ̱i tơ̱i,</para>
  <para style="q1" vid="HEB 5:6">nèm nòi Mên-chi-xê-đéc.”<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />Slì nhằng chang đúc đang, Min tó khửn heng cẩn díu pài kí vàm xỉnh chàu xáu na̱i xo xăm nặm ha khửn Lạo mì quỳn cháu làu khói hai; vàm Min xo đảy nhă̱n, vi̱ chăn slim kiíng lao. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Ma̱i cạ hít Lu̱c, tọ Min xày slon chắc ti̱ng fục tứ kí chíp khỏ làu tảy quá; <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />Xáu chíu đảy xày xiìn dá, Min pìn cúc cáng cú fúc cháu tơ̱i tơ̱i hử mọi cần ti̱ng vàm Min, <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />xáu đảy Chảu Fạ tặt hít slay pài xoòng ta̱i tàu nèm nòi Mên-chi-xê-đéc, <verse eid="HEB 5:10" /><verse number="11" style="v" sid="HEB 5:11" />mà lo̱ nảy, hung làu mì lai lo̱ lèo chảng, tọ khay vàm do̱ khỏ lai, vi̱ pi̱ noọng tó mí thuủn slim ti̱ng sle slụ đảy. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Thưng cà nạy, pi̱ noọng lèo hít slay dá chứng chư̱; tọ pi̱ noọng di̱ nhằng cẩn hau slon hử làu kí tèo slon ta̱i tàu cú vàm Chảu Fạ, pi̱ noọng nhằng lèo kin nùm, tó mí kin đảy cú kheng. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Cần nàư tan kin nùm do̱ xằng slụ vàm cung chính, vi̱ cần nỉnh di̱ nhằng xị lu̱c đích. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Tọ cú kin kheng tan sle hử cần cải, chư̱ kí cần nhă̱n hít chứng chắc đảy lo̱ đay xáu tằng lo̱ slại.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Pìn nỉnh, chíu hung làu tả kí lo̱ slon cạ ta̱i tàu mà Chảu Cháu Ti̱ Da̱, hung làu lèo cải khửn, mí đảy chảng thưng kí lo̱ slon cạ tứ ta̱i tàu xị: cho̱i xá mà kí cung sla̱y hai, mà slim slấn khảu Chảu Fạ, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />lo̱ slon cạ mà fép báp-têm, lo̱ tặt mừ, cần hai đảy hòi te̱o, lo̱ ứn chá tơ̱i tơ̱i. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Hung làu co̱i hít đảy, hạy Chảu Fạ hử fép. <verse eid="HEB 6:3" /><verse number="4" style="v" sid="HEB 6:4" />Vi̱ kí cần tó đảy xoi slu̱ng pày nưng, tó đảy xi quá fúc đay tứ fạ, do̱ cần nỉnh co̱i đảy fă̱n xáu Chảu Khoăn <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />tó xi quá vàm đay cú Chảu Fạ, xáu đảy hăn quỳn slèng cú tơ̱i mư̱ lăng ái thưng <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />hạy toỏng lụp — hít kí cần nỉnh hòi te̱o dá cho̱i xá đảy, chíu hau toóc teng Lu̱c Chảu Fạ pày nưng num, xáu hít Min oóc nả nhẻn. <verse eid="HEB 6:6" /><verse number="7" style="v" sid="HEB 6:7" />Vi̱ tu̱ng nà haư đảy chám nặm phân moóc lùng mại, chứng sleng oóc bjoóc mác, đay hử cần hít nà la̱y, do̱ tum nỉnh đảy fúc cú Chảu Fạ, <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />nhằng hạy oóc pá nam xáu nhả nhác, do̱ tum nỉnh mí mì lăng đay, co̱i ngài bjắc bjỏi, sloót hang lèo ngài fày pung pay.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Pi̱ noọng pèng điíp ới, ma̱i cạ chảng pìn nỉnh, hung ngo̱ slấn mắn mà kí cung sla̱y hẳm đay sle đảy fúc cháu. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Vi̱ Chảu Fạ mí chư̱ dăm cung thưng slặn lùm cung sla̱y cú pi̱ noọng, xáu slim điíp pi̱ noọng tó hử hau hăn vi̱ mình Min, chíu cung ta̱i kí cần slấn, xáu cà nạy di̱ nhằng cung ta̱i hau num. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Tọ hung ngo̱ kháo mu̱ng cạ, mọi cần chang pi̱ noọng lèo hử hau hăn làu thuủn slim, sle chưứng mắn slim kháo mu̱ng thưng sloót hang, <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />sle pi̱ noọng mí chạn hít, tọ cứ hút xị kí cần pừng khảu slim slấn, slim tảy na̱i te̱o đảy táp au kí vàm pao xình.<verse eid="HEB 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Chíu Chảu Fạ pao xình đủi Áp-ra-ham, vi̱ mí au mình cần nàư cải quá sle pao xình, Min chứng au chăn mình làu pao xình, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />cạ: “Chăn Cau co̱i pảo fúc lùng hử lu̱c, hạy oóc lai, do̱ Cau co̱i hít lu̱c oóc lai num.” <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Pìn nỉnh, ké tảy na̱i mu̱ng tẳng, ké chứng nhă̱n đảy vàm pao xình nỉnh. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />Chăn pìn nỉnh, hau slưừng slì pừng khảu mình lạo nưng cải quá làu pao xình, dá vàm pao xình nỉnh hít thuủn mọi lo̱ hau cheng ke̱o, <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />xày pìn nỉnh, vi̱ ái hử kí cần đảy táp vàm pao xình bó piín tói slắc pày tứ slim Min slưửng, do̱ Chảu Fạ au vàm pao xình sle pao xình <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />sle pừng khảu sloong vàm pao xình xày mí piín tói, chíu pao xình, Chảu Fạ xày mí chảng pjàng đảy, nhằng hung làu xị kí cần le̱n thưng đỏ xảư Min, hung làu đảy an chi, sle cỏ mắn slim kháo mu̱ng khảu Min; <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />hung làu cỏ slim kháo mu̱ng nảy xị ăn slai lích cú khoăn mi̱ng, di̱ mắn táng, di̱ vẳn chằn, đắc khảu bưửng đưng phén ma̱n, <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />ti̱ Chảu Giê-xu tó khảu xị Lạo pay cón tháy hử hung làu, dá pìn slay pài xoòng ta̱i tàu thưng tơ̱i tơ̱i nèm nòi Mên-chi-xê-đéc.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Mên-chi-xê-đéc nảy chăn chư̱ huùng cú Sa-lem, slay pài xoòng cú Chảu Fạ Ta̱i Slung, cần tó tỏn Áp-ra-ham chíu min hình đảy kí huùng fan mà dá cung fúc hử ké; <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />Áp-ra-ham tó au fă̱n slíp tứ mọi cú cái sle pài hử huùng nỉnh; ta̱i tàu Mên-chi-xê-đéc mì ý xí cạ “huùng cung chíng”, xáu te̱o pìn huùng cú Sa-lem, ý xí cạ “huùng pình lình”, <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />huùng bó mì pá, bó mì mé, xày bó mì cúc chỏ, bó mì vằn sleng oóc, xày bó mì vằn quá tơ̱i, tọ hút Lu̱c Chảu Fạ, huùng hít slay pài xoòng thưng tơ̱i tơ̱i.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Lèo nẳm ngòi huùng nỉnh cải luung thưng haư! Chăn cúc chỏ Áp-ra-ham pài hử huùng fă̱n slíp nưng tứ kí cú cái hẳm đay làu tức đảy. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Nhằng kí cần tứ nòi cần Lê-vi, chíu đảy hít slay pài xoòng, do̱ co̱i nhă̱n đảy fă̱n slíp nưng tứ chang phang cần nèm lịng chang luật fáp, xị cạ tứ kí pi̱ noọng làu, ma̱i cạ chăn hau xày tứ Áp-ra-ham oóc. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Tọ huùng tó mí chư̱ tứ nòi cần Lê-vi oóc, te̱o nhằng nhă̱n fă̱n slíp nưng cú Áp-ra-ham, xáu pảo fúc hử ké đảy nhă̱n kí vàm pao xình. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Cần dú ti̱ slung pảo fúc hử cần ti̱ tắm, do̱ mí mì lăng ke̱o đảy. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Dú nảy, kí cần lèo hai nhă̱n au fă̱n slíp cú cái, nhằng dú nỉnh, huùng đảy ngòi xị nhằng te̱o. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Xày chảng cạ Lê-vi nhă̱n fă̱n slíp nưng, xày đảy nhă̱n fă̱n slíp quá Áp-ra-ham, <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />vi̱ chíu Lê-vi nhằng chang pàu cúc chỏ, do̱ Mên-chi-xê-đéc tó pay phúng nả Áp-ra-ham dá.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Hạy cung sla̱y pài xoòng cú cần Lê-vi đảy xày xiìn (vi̱ cúc cáng cú cung sla̱y pài xoòng nỉnh, phang cần chứng đảy pảo hử luật fáp), do̱ hít lăng nhằng lèo tặt oóc slay pài xoòng táng, nèm nòi Mên-chi-xê-đéc tó mí chư̱ nèm nòi A-rôn num? <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Hạy cung sla̱y pài xoòng ngài piín tói, do̱ luật fáp xày lèo piín tói. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Vi̱ chăn Lạo hung làu chảng thưng nảy, đảy sleng oóc tứ nòi cần táng, nòi cần mí xằng cung ta̱i dú ti̱ xoòng xằn. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Vi̱ chăn Chảu cú hung làu tứ nòi Giu-đa sleng oóc, nòi cần nỉnh mí đảy Môi-se chảng lăng thưng cung sla̱y pài xoòng. <verse eid="HEB 7:14" /><verse number="15" style="v" sid="HEB 7:15" />Mọi lo̱ nảy hẳm khát sla̱t quá num, hạy mì slay pài xoòng táng nưng đảy tặt khửn, hút xị dưư̱ng slưứng cú Mên-chi-xê-đéc, <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />Lạo pìn slay pài xoòng mí chư̱ hít nèm kí luật fáp cú tu cần, tọ hít nèm quỳn slèng cú lo̱ te̱o tơ̱i tơ̱i. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Vi̱ Min đảy hau hít chửng cạ:</para>
  <para style="q1" vid="HEB 7:17">“Lu̱c hít slay pài xoòng tơ̱i tơ̱i, nèm nòi Mên-chi-xê-đéc.”<verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />Pìn nỉnh, bưửng nưng vàm slon cạ mư̱ cón ngài tả oóc noo̱c, mí sla̱i đay xáu vi̱ mí mì quỳn lăng <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />(vi̱ luật fáp mí hít lo̱ lăng pìn xày xiìn đảy); bưửng táng, mì kháo mu̱ng hẳm đay đảy pảo hử, sle pừng khảu nỉnh hung làu đảy thưng xảư Chảu Fạ. <verse eid="HEB 7:19" /><verse number="20" style="v" sid="HEB 7:20" />Bó chư̱ lo̱ nảy đảy pìn tọ mí quá vàm pao xình, vi̱ ma̱i cạ kí cần nỉnh bó mì vàm pao xình do̱ tó đảy hít slay pài xoòng dá, <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />nhằng Chảu Giê-xu te̱o đảy tặt hít slay pài xoòng quá vàm Chảu Fạ pao xình đủi Min cạ:</para>
  <para style="q1" vid="HEB 7:21">“Chảu tó pao xình, do̱ co̱i mí tói slim:</para>
  <para style="q1" vid="HEB 7:21">Lu̱c chăn chư̱ slay pài xoòng thưng tơ̱i tơ̱i.” —<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />Pìn nỉnh, Chảu Giê-xu chứng pìn Lạo pao xình hử chao kiít hẳm đay quá. <verse eid="HEB 7:22" /><verse number="23" style="v" sid="HEB 7:23" />Mì lai cần hít slay pài xoòng hưng dá, vi̱ hau lèo hai chứng mí lằm chă̱p hít cung sla̱y nỉnh, <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />tọ Chảu Giê-xu cỏ cung sla̱y pài xoòng mại mại, vi̱ Min nhằng te̱o thưng tơ̱i tơ̱i, <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />pìn nỉnh, Min xày mì quỳn cháu đảy thuủn kí cần pừng khảu Min sle thưng xảư Chảu Fạ, vi̱ Min te̱o tơ̱i tơ̱i sle xỉnh chàu tháy hử hau. <verse eid="HEB 7:25" /><verse number="26" style="v" sid="HEB 7:26" />Chăn pìn nỉnh, Min chư̱ slay pài xoòng ta̱i tàu hung làu cẩn thưng: Lạo slaư tích, mí mì phít xá, mí slẳm sla̱p, đảy au oóc khói cần mì phít xá, đảy tài slung quá kí tẳm fạ; <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />Lạo nỉnh mí hút kí slay pài xoòng ta̱i tàu táng, lèo pài sleng lình, cón chư̱ sle cháu phít xá cú làu, lăng chư̱ sle cháu phít xá hử phang cần. Min pài chăn làu hít sleng lình pày nưng tó đo thuủn dá. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Vi̱ luật fáp tặt kí tu cần slim ón hít slay pài xoòng ta̱i tàu; nhằng vàm pao xình thưng lăng luật fáp do̱ tặt Lu̱c, chư̱ Lạo đảy xày xiìn thưng tơ̱i tơ̱i.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Pìn nỉnh, lo̱ cà nạy chăn chư̱ cúc cắn làu chảng thưng: Hung làu mì slay pài xoòng ta̱i tàu slung pèng, Lạo nă̱ng bưửng sla tắng kim cú Lạo Ta̱i Luung tìng kí tẳm fạ, <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />chư̱ cần cung ta̱i dú ti̱ thánh, chư̱ lưừn slớ cha̱m chăn, đảy Chảu tẳng khửn, mí chư̱ tứ tu cần. <verse eid="HEB 8:2" /><verse number="3" style="v" sid="HEB 8:3" />Thuủn slay pài xoòng ta̱i tàu đảy tặt sle pài tằng cú cái xăm sleng lình; pìn nỉnh, Lạo nảy xày lèo mì ăn lăng sle pài khửn. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Hạy Min nhằng dú tìng tum, do̱ cay Min bó hít slay pài xoòng, vi̱ tó mì kí slay pài xoòng pài cú cái xị luật fáp slon; <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />kí cần nảy cung ta̱i xị slưứng xáu ngàu cú kí lo̱ tìng fạ, xị Môi-se ái tẳng lưừn slớ cha̱m, do̱ Chảu Fạ slắng cạ: “Lèo slỉu slim, hít mọi lo̱ xị chăn lu̱c đảy hăn tìng phja nảy.” <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Tọ cà nạy, Min đảy nhă̱n cung sla̱y slung pèng quá, vi̱ Min chư̱ Lạo Khen Chang cú chao kiít hẳm đay, vi̱ chao kiít đảy tặt khửn tìng vàm pao xình hẳm đay quá. <verse eid="HEB 8:6" /><verse number="7" style="v" sid="HEB 8:7" />Vi̱ hạy chao kiít ta̱i tàu đảy xày xiìn dá, do̱ bó lèo cẩn tặt chao kiít ta̱i nhi̱ num. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Tọ chíu quáy phang cần, Chảu Fạ cạ:</para>
  <para style="q1" vid="HEB 8:8">“Nho̱m ne̱, ái thưng kí vằn, Chảu cạ:</para>
  <para style="q1" vid="HEB 8:8">dá Cau tặt chao kiít máư</para>
  <para style="q2" vid="HEB 8:8">xáu lưừn Y-sơ-ra-ên đủi lưừn Giu-đa;<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />mí hút xị chao kiít</para>
  <para style="q2" vid="HEB 8:9">Cau tặt xáu kí cúc chỏ hau,</para>
  <para style="q1" vid="HEB 8:9">chang vằn Cau căm mừ tái hau oóc khói Ai Cập,</para>
  <para style="q1" vid="HEB 8:9">vi̱ hau mí slim đeo cỏ chao kiít Cau,</para>
  <para style="q2" vid="HEB 8:9">Cau chứng tả hau,</para>
  <para style="q1" vid="HEB 8:9">Chảu cạ pìn nỉnh.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Nảy chăn chư̱ chao kiít</para>
  <para style="q2" vid="HEB 8:10">Cau co̱i tặt xáu lưừn Y-sơ-ra-ên</para>
  <para style="q1" vid="HEB 8:10">lăng kí vằn nỉnh,</para>
  <para style="q2" vid="HEB 8:10">Chảu cạ,</para>
  <para style="q1" vid="HEB 8:10">chíu tặt luật fáp Cau chang slim ki hau,</para>
  <para style="q1" vid="HEB 8:10">xáu cha̱c khảu slim hau,</para>
  <para style="q1" vid="HEB 8:10">Cau co̱i hít Chảu Fạ hau,</para>
  <para style="q1" vid="HEB 8:10">xáu hau co̱i hít cần cú Cau.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Mí nhằng cần nàư lèo slon cần làu</para>
  <para style="q1" vid="HEB 8:11">xáu pi̱ noọng làu cạ: ‘Lèo nhă̱n chắc Chảu,’</para>
  <para style="q1" vid="HEB 8:11">vi̱ thuủn mọi cần xày co̱i chắc Cau,</para>
  <para style="q1" vid="HEB 8:11">tứ cần sláy ta̱i ít thưng cần cải ta̱i ít.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />Cau co̱i hử hăn slim điíp sliít xáu kí lo̱ slảy khum cú hau,</para>
  <para style="q1" vid="HEB 8:12">xáu Cau co̱i mí nhằng chứ thưng phít xá cú hau num.”<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />Dảo chao kiít máư, do̱ Min cạ chao kiít ta̱i ít pìn cáu; xáu ăn lăng cáu ké, do̱ co̱i quá pay.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Cà nạy do̱, chao kiít ta̱i ít xày mì kí luật mà pái slớ xáu ti̱ thánh nưng tảư tum, <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />vi̱ mì lưừn slớ cha̱m nưng đảy tẳng khửn, fă̱n ta̱i ít mì kha tưng, xoòng xáu tằng kí ăn pẻng pài hử Chảu, đảy dảo hít “Ti̱ Thán”, <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />nhằng bưửng lăng phén ma̱n ta̱i nhi̱ do̱ mì le̱o nưng đảy dảo hít “Ti̱ Ta̱i Thánh”, <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />mì ăn xoòng xằn kim sle chang dưưng xáu slưưng chao kiít, poo̱c chi̱n kim, bưửng đưng mì ăn pìng kim to ma-na, tèo tạu oóc bjoóc cú A-rôn, xáu kí pưứng chao kiít, <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />nhằng bưửng tìng slưưng chao kiít mì kí chê-ru-bim slu̱ng phjưức dà pha cháu phít xá, tọ cà nạy mí chảng thuủn ăn pìn ăn kí thìng nỉnh đảy. <verse eid="HEB 9:5" /><verse number="6" style="v" sid="HEB 9:6" />Mọi lo̱ nỉnh tó đảy chắp xặp pìn nỉnh, kí slay pài xoòng slưừng slì khảu fă̱n ta̱i ít cú lưừn slớ cha̱m sle hít kí cung ta̱i pái slớ; <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />tọ tan slay pài xoòng ta̱i tàu chứng đảy khảu fă̱n ta̱i nhi̱ mọi pi pày nưng, lèo au nèm lưư̱t sle pài sleng lình cháu phít xá tháy hử chăn làu xáu hử phang cần. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Chảu Khoăn hử chắc lo̱ khảu ti̱ ta̱i thánh xằng đảy khay oóc, hạy lưừn slớ cha̱m ta̱i ít nhằng dú nỉnh, <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />nỉnh sle pỉ mà slì cà nạy, hít pìn nỉnh do̱ tằng cú cái xáu sleng lình đảy pài khửn mí hít hử slim cú cần pái slớ xày xiìn đảy, <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />tọ tan quén thưng cú kin, nặm kin xáu kí le̱ slào slaư táng căn, chư̱ kí luật pắt đúc đang lèo hít nèm thưng slì mọi lo̱ tói máư.<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Tọ slì Chảu Cháu Ti̱ Da̱ oóc nả xị slay pài xoòng ta̱i tàu cú kí lo̱ đay đắn mư̱ lăng, do̱ quá lưừn slớ cha̱m máư hẳm cải xáu xày xiìn quá — tó mí tứ mừ tu cần tẳng khửn, do̱ mí slục mà kí lo̱ tơ̱i nảy — <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />mí chư̱ au lưư̱t bẻ tực xáu tu mò nhe, tọ au chăn lưư̱t làu, Min phjải khảu ti̱ ta̱i thánh pày nưng do̱ đo dá, táng xa đảy thưng lo̱ cháu tơ̱i tơ̱i. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Vi̱ hạy lưư̱t cú bẻ tực, mò tực xáu phắc pja̱u cú mò slảo tìng kí cần ngài slẳm sla̱p nhằng slào hử đúc đang hau slaư tích đảy, <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />do̱ lưư̱t cú Chảu Cháu Ti̱ Da̱, chư̱ Lạo pừng Chảu Khoăn tơ̱i tơ̱i, pài chăn làu mí mì lòi slẳm hử Chảu Fạ, co̱i slào slaư slim pi̱ noọng khói ngài hai, sle cung ta̱i Chảu Fạ te̱o tơ̱i tơ̱i nhằng cải thưng haư! <verse eid="HEB 9:14" /><verse number="15" style="v" sid="HEB 9:15" />Vi̱ pìn nỉnh, Min chư̱ Lạo Khen Chang cú chao kiít máư, sle cháu kí phít xá hau fa̱m tảư chao kiít ta̱i ít, kí cần đảy dảo chứng đảy nhă̱n vàm pao xình mà fă̱n cha xài tơ̱i tơ̱i. <verse eid="HEB 9:15" /><verse number="16" style="v" sid="HEB 9:16" />Vi̱ ti̱ haư mì baư slư păn cha xài, do̱ dú nỉnh lèo tẳng thưng slì cần slẻ baư slư nỉnh hai. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Baư slư păn cha xài tan mì chá slì cần slẻ tó hai dá, pìng nỉnh hạy cần slẻ nhằng te̱o do̱ min mí mì chá lăng. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />Pìn nỉnh, tằng cạ chao kiít ta̱i ít xày mí đảy hít pìn hạy mí mì lưư̱t. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Vi̱ chíu Môi-se slon cạ luật fáp hử phang cần, ké au lưư̱t cú tu mò nhe xáu bẻ tực chào xăm nặm, tèo len đeng cắm xáu cáng bài hom phắc tìng quỷn xéc xáu tằng phang cần, <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />dá chảng: “Nảy chăn chư̱ lưư̱t cú chao kiít Chảu Fạ tó slon hử kí pi̱ noọng.” <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Xày hít pìn nỉnh, ké phắc lưư̱t tìng lưừn slớ cha̱m xáu thuủn kí cú du̱ng sle pái slớ. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Nèm luật fáp, ái thuủn mọi cú du̱ng xày đảy lưư̱t hít slaư tích, mí mì lưư̱t đíng oóc do̱ mí đảy sla dưư̱ng.<verse eid="HEB 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Pìn nỉnh, hạy kí slưứng ngàu chảng mà kí lo̱ dú tìng fạ lèo pừng kí sleng lình nỉnh sle đảy slaư, do̱ chăn kí lo̱ dú tìng fạ lèo pừng kí sleng lình hẳm đay quá chứng đảy slaư, <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />chăn Chảu Cháu Ti̱ Da̱ tó mí khảu ti̱ thánh đảy mừ tu cần hít oóc, chư̱ kí slưứng ngàu cú ti̱ thánh chăn, tọ khảu chăn thiin ti̱, sle cà nạy tang nả hung làu thưng tói nả Chảu Fạ, <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Min xày mí pài chăn làu lai pày, xị slay pài xoòng ta̱i tàu mọi pi khảu kí ti̱ thánh pài lưư̱t cú cần táng; <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />vi̱ hạy pìn nỉnh, tứ vằn chí oóc ti̱ da̱ thưng cà nạy, Min tó lèo tảy khỏ lai pày dá. Tọ cà nạy, khảu slì sloót hang cú mọi ta̱i, Min đảy oóc nả tan pày nưng quá lo̱ hai sle sláu thuủn phít xá pay. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Xị tó slưửng hử tu cần lèo hai pày nưng, dá chứng ngài ứn chá, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />xày pìn nỉnh, Chảu Cháu Ti̱ Da̱ tó pài chăn làu tan pày nưng sle háp phít xá cú lai cần; Min te̱o oóc nả pày ta̱i nhi̱, mí chư̱ sle háp phít xá num, tọ sle pảo fúc cháu hử kí cần nắt níu mu̱ng tẳng Min.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Vi̱ luật fáp — tan mì ngàu cú kí lo̱ đay đắn ái thưng, tó mí chư̱ slưứng chăn cú kí lo̱ nỉnh — hau cứ pài kí sleng lình tứ pi nảy quá pi táng xày mí hít kí cần thưng xảư Chảu Fạ pìn xày xiìn đảy. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Hạy đảy, do̱ hau mí pài sleng lình dá, vi̱ kí cần pái slớ đảy hít slaư pày nưng do̱ đo dá, hau bó nhằng hăn nả nhẻn vi̱ phít xá num do̱ lừ? <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Tọ, kí sleng lình nỉnh tan sle mọi pi hau chứ te̱o phít xá. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Vi̱ lưư̱t cú mò tực xáu bẻ tực mí sláu slaư phít xá pay đảy. <verse eid="HEB 10:4" /><verse number="5" style="v" sid="HEB 10:5" />Pìn nỉnh, chíu khảu ti̱ da̱, Min cạ:</para>
  <para style="q1" vid="HEB 10:5">“Chảu mí ái sleng lình,</para>
  <para style="q2" vid="HEB 10:5">xày bó ái cú cái pài,</para>
  <para style="q2" vid="HEB 10:5">tọ Chảu tó chắp xặp đúc đang nưng hử Lu̱c;<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />Chảu xày bó hun fằng</para>
  <para style="q2" vid="HEB 10:6">mà sleng lình chi̱n sliu xáu sleng lình cháu phít xá.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />Lăng nỉnh, ngo̱ dăng: ‘Nho̱m cà, Lu̱c thưng —</para>
  <para style="q2" vid="HEB 10:7">xị vàm chang kí quỷn xéc slẻ mà lu̱c,</para>
  <para style="q1" vid="HEB 10:7">sle hít xị slim Min slưửng, Chảu Fạ ới.’”<verse eid="HEB 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8" />Chíu Min cạ dú tìng nỉnh: “Chảu mí ái kí sleng lình xáu cú cái, sleng lình chi̱n sliu xáu sleng lình cháu phít xá. Min xày bó ái (kí cú cái pài nèm luật fáp), <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />lăng nỉnh, Min cạ: Nho̱m nè, Lu̱c thưng sle hít nèm slim Min slưửng.” Min tả thuủn mọi lo̱ ta̱i ít sle hít pìn lo̱ ta̱i nhi̱. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Nèm slim slưửng nỉnh, hung làu đảy slào slaư pừng Chảu Giê-xu Cháu Ti̱ Da̱ tó pài đúc đang làu hít sleng lình tan pày nưng do̱ đo dá. <verse eid="HEB 10:10" /><verse number="11" style="v" sid="HEB 10:11" />Chăn, vằn vằn mọi slay pài xoòng dân cung ta̱i xáu slưừng slì pài kí sleng lình, tọ kí sleng lình nỉnh bó sláu slaư phít xá đảy slắc pày. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Tọ Min tan pài sleng lình đeo sle cháu phít xá thưng tơ̱i tơ̱i, dá nă̱ng dú bưửng sla Chảu Fạ, <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />tẳng tứ nỉnh tò pay thưng vằn kí cần tói tàu Min ngài tặt lùng hít ti̱ te̱m kha hử Min. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Vi̱ tan pài sleng lình đeo, Min hít hử kí cần đảy slào slaư pìn xày xiìn thưng mại mại. <verse eid="HEB 10:14" /><verse number="15" style="v" sid="HEB 10:15" />Chảu Khoăn xày hít chửng hử hung làu pìn nỉnh, vi̱ lăng slì tó cạ, <verse eid="HEB 10:15" /><verse number="16" style="v" sid="HEB 10:16" />Chảu cạ:</para>
  <para style="q1" vid="HEB 10:16">“Nảy chăn chư̱ chao kiít Cau tặt xáu hau,</para>
  <para style="q2" vid="HEB 10:16">lăng kí vằn nỉnh,</para>
  <para style="q1" vid="HEB 10:16">Cau co̱i tặt luật fáp Cau khảu slim hau,</para>
  <para style="q2" vid="HEB 10:16">xáu cha̱c khảu slim ki hau.”<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />Xáu cạ:</para>
  <para style="q1" vid="HEB 10:17">“Cau co̱i bó nhằng chứ thưng phít xá</para>
  <para style="q2" vid="HEB 10:17">xáu kí lo̱ too̱c éc cú hau num.”<verse eid="HEB 10:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 10:18" />Ti̱ haư đảy sla dưư̱ng phít xá, do̱ mí cẩn pài sleng lình sle cháu phít xá num.<verse eid="HEB 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Pìn nỉnh, pi̱ noọng ới, vi̱ pừng lưư̱t Chảu Giê-xu, hung làu chứng đảy tài tảm phjải khảu kí ti̱ thánh, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />Lạo tó khay hử hung làu tèo lo̱ máư xáu te̱o quá phén ma̱n, chăn chư̱ quá đúc đang Min; <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />xáu hung làu mì slay pài xoòng nưng ta̱i luung cai cuủn lưừn Chảu Fạ, <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />hung làu chứng au chăn slim xáu slim slấn mắn táng, slim slảy đảy slào slaư khói lo̱ slảy khum, đúc đang đảy nặm slaư tích slào slaư sle thưng xảư Chảu. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Hung làu lèo chưứng mắn vàm chảng oóc mà slim kháo mu̱ng bó tu̱ng fèn, vi̱ Lạo tó pao xình xáu hung làu chăn chư̱ slim đeo. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Hung làu lèo tặt slim đủi căn, nhòi slim căn mà slim điíp xáu hít kí lo̱ đay, <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />mí đảy tả kí pày tom te̱o xị kỉ cần quén hít, tọ lèo slắng cạ căn, hạy pi̱ noọng hăn vằn cú Chảu hẳm xảư thưng haư do̱ hẳm lèo hít pìn nỉnh thưng nỉnh.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Vi̱ hạy hung làu nhă̱n chắc đo mà chăn lị dá, te̱o nhằng oóc slèng fa̱m xá, do̱ mí nhằng mì sleng lình haư cháu phít xá đảy num, <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />tọ tan lèo ma̱o mi̱ng tẳng thưng vằn ứn chá, dá piu fày co̱i sliu pung kí cần tói tàu. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Cần nàư fa̱m luật fáp Môi-se, hạy mì sloong slam cần hít chửng, do̱ ngài hai tọ mí đảy điíp sliít. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Te̱o cạ cần ta̱p Lu̱c Chảu Fạ, ngòi che̱n lưư̱t cú chao kiít, chư̱ lưư̱t slào slaư làu, te̱o nhằng fa̱m thưng Chảu Khoăn cú fúc Chảu pảo hử ma̱i cạ làu bó ngám, do̱ cần nỉnh bó ngám tảy fa̱t hẳm nắc quá do̱ lừ? <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Vi̱ hung làu chắc Lạo tó cạ: “Chăn Cau co̱i pjá xàu, chăn Cau co̱i păng xàu.” Te̱o mì vàm cạ: “Chảu co̱i ứn chá cần cú Min.” <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />Lụp khảu mừ Chảu Fạ te̱o tơ̱i tơ̱i, do̱ chăn chư̱ ma̱o mi̱ng lai!<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Tọ cứ chứ te̱o kí vằn mư̱ cón, chíu đảy khay slu̱ng, pi̱ noọng lèo tảy lai kí chíp khỏ, <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />chíu nảy do̱ pi̱ noọng tảy ngài nả nhẻn xáu hít ha̱i tói nả mọi cần, nhằng chíu nỉnh do̱ đảy păn vai xáu kí cần xày ngài hít ha̱i pìn nỉnh. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Vi̱ pi̱ noọng xày mì slim điíp đủi kí cần ngài xăng, xáu hun fằng nhă̱n sle cú cái làu ngài cưứp, vi̱ pi̱ noọng chắc làu mì cú cái hẳm đay xáu di̱ nhằng mại. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />Pìn nỉnh, mí đảy tả slim slấn mắn táng cú làu, vi̱ slim slấn nỉnh co̱i đảy nhă̱n fă̱n slưởng cải lai. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Pi̱ noọng lèo tảy na̱i, sle slì hít nèm slim Chảu Fạ slưửng, do̱ co̱i nhă̱n đảy kí vàm pao xình.<verse eid="HEB 10:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="HEB 10:37" />“Ái thưng slì dá,</para>
  <para style="q1" vid="HEB 10:37">Lạo lèo thưng co̱i thưng; Min mí ma̱n xì đơ.<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />Tọ cần cung chính cú Cau co̱i pừng khảu slim slấn chứng đảy te̱o,</para>
  <para style="q1" vid="HEB 10:38">nhằng hạy thói mà bưửng lăng, do̱ khoăn mi̱ng Cau bó hun hỉ mà min.”<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Tọ hung làu mí chư̱ cần thói pay sle ngài chi̱it đơ, tọ pìn cần chưứng mắn slim slấn sle cháu đảy khoăn mi̱ng làu.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Slim slấn pao xình hử kí lo̱ làu kháo mu̱ng, hít chửng hử kí lo̱ làu bó hăn đảy. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Chăn pìn nỉnh, pừng slim slấn, cần mư̱ pày tó đảy Chảu hít chửng đay. <verse eid="HEB 11:2" /><verse number="3" style="v" sid="HEB 11:3" />Pừng slim slấn, hung làu chắc cạ vàm cú Chảu Fạ hít oóc ti̱ da̱ nảy, sle kí lo̱ hăn đảy hít tứ kí lo̱ mí hăn đảy. <verse eid="HEB 11:3" /><verse number="4" style="v" sid="HEB 11:4" />Pừng slim slấn, A-bên tó pài hử Chảu Fạ sleng lình nưng hẳm đay quá cú Ca-in, ké chứng đảy dảo cung chính slì Chảu Fạ nhă̱n au cú cái nỉnh, xáu pừng slim slấn, ma̱i cạ tó hai dá A-bên di̱ nhằng chảng đảy. <verse eid="HEB 11:4" /><verse number="5" style="v" sid="HEB 11:5" />Pừng slim slấn Hê-nóc đảy dò khửn, mí ngài xi quá lo̱ hai, hau mí hăn ké dá, vi̱ Chảu Fạ tó tỏn ké pay. Vi̱ chíu xằng đảy tỏn pay, ké tó đảy chửng nhă̱n cạ kin dú đay slim Chảu Fạ. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Tọ, mí mì slim slấn do̱ mí pìn lừ hít đay slim Chảu Fạ đảy, vi̱ cần nàư thưng xảư Chảu Fạ lèo slấn cạ mì Chảu Fạ xáu slấn Min chăn chư̱ Lạo pảo fă̱n slưởng hử kí cần xa Min. <verse eid="HEB 11:6" /><verse number="7" style="v" sid="HEB 11:7" />Pừng slim slấn, Nô-ê đảy Chảu páo hử chắc mà kí lo̱ xằng hăn slắc pày, xáu chăn slim kiíng lao, ké toóc ăn lừ nưng sle cháu mọi cần chang lưừn làu, dá ké chứng cáp xá ti̱ da̱ xáu pìn cần đảy táp lo̱ cung chính pừng khảu slim slấn. <verse eid="HEB 11:7" /><verse number="8" style="v" sid="HEB 11:8" />Vi̱ slim slấn, Áp-ra-ham đảy dảo do̱ lèo hít lăng sle pay thưng ti̱ ké nhă̱n pìn cúc căn, tọ ké thung hăn làu pay haư cần nàư kháo mu̱ng. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Pừng slim slấn, ké dú cha̱m chang tum ti̱ đảy pao xình xị kí cần dú tum ti̱ táng, dú đưng kí le̱o xáu Y-sác đủi Gia-cốp, xày chư̱ kí cần xày đảy táp nèm vàm pao xình, <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />Vi̱ ké mu̱ng tẳng slẻng nưng mì ti̱ choóc đảy Chảu Fạ chăn chư̱ Cần Ve̱ xáu Xáy Tẳng khửn. <verse eid="HEB 11:10" /><verse number="11" style="v" sid="HEB 11:11" />Pừng slim slấn, ma̱i cạ chăn Sa-ra tó ké cắc xáu măn, tọ di̱ nhằng oóc lu̱c đảy, vi̱ da̱ slấn cạ Lạo tó pao xình chăn chư̱ slim đeo. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Vi̱ pìn nỉnh, xày tứ cần nưng — ngài ngòi xị hai dá, te̱o oóc đảy lai kí lu̱c lan, đung xị đao đí tìng fạ, xị slài cằn hải, bó án thuủn đảy. <verse eid="HEB 11:12" /><verse number="13" style="v" sid="HEB 11:13" />Chang slim slấn, thuủn kí cần nỉnh xày hai chíu xằng nhă̱n đảy kí vàm pao xình, tan hăn xáu tuụng tỏn kí lo̱ nỉnh tứ ti̱ quay, táng cạ làu chư̱ cần cha̱m dú tum ti̱ hau, tan chư̱ khéc tìng tum. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Vi̱ kí cần chảng pìn nỉnh, hử hăn cạ hau pay xa ti̱ chỏ nưng. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Hạy hau tó chứ mà ti̱ chỏ làu tứ nỉnh oóc pay, do̱ cay hau di̱ nhằng mì vằn fan te̱o. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Tọ cà nạy hau mu̱ng ti̱ chỏ hẳm đay quá, chư̱ ti̱ chỏ tìng fạ, Chảu Fạ chứng mí hăn nả nhẻn slì cạ làu chư̱ Chảu Fạ cú hau, vi̱ Min tó chắp xặp slẻng nưng hử hau. <verse eid="HEB 11:16" /><verse number="17" style="v" sid="HEB 11:17" />Pừng slim slấn, Áp-ra-ham pài Y-sác chíu ngài xi, ké nhằng nhă̱n đảy vàm pao xình, chứng ính xình pài ò lu̱c đeo cú làu, <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />chư̱ tu lu̱c Chảu Fạ tó cạ: “Quá Y-sác, nòi cần tứ lu̱c sleng oóc co̱i đảy tặt mìng,” <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />ké táng nẳm cạ Chảu Fạ mì quỳn hít cần hai hòi te̱o, chảng nèm slưứng ngàu, ké chứng nhă̱n te̱o lu̱c làu tứ ti̱ hai. <verse eid="HEB 11:19" /><verse number="20" style="v" sid="HEB 11:20" />Pừng slim slấn, Y-sác pảo fúc hử Gia-cốp xáu Ê-sau mà kí lo̱ mư̱ lăng mì oóc. <verse eid="HEB 11:20" /><verse number="21" style="v" sid="HEB 11:21" />Pừng slim slấn, chíu Gia-cốp ái quá tơ̱i tó pảo fúc hử kí lu̱c báo cú Giô-sép, xáu ai khảu hu tèo tạu làu, ké qu̱y kháu pái slớ. <verse eid="HEB 11:21" /><verse number="22" style="v" sid="HEB 11:22" />Pừng slim slấn, chíu Giô-sép ái quá tơ̱i tó chảng mà pày lu̱c lan Y-sơ-ra-ên oóc khói Ai Cập xáu slắng cạ mà sli hài hau. <verse eid="HEB 11:22" /><verse number="23" style="v" sid="HEB 11:23" />Pừng slim slấn, chíu ngám đảy sleng oóc, Môi-se đảy pá mé au pay dò slam bưưn, vi̱ ké da̱ hăn tu lu̱c đay đắn, chứng mí lao lịng cú huùng. <verse eid="HEB 11:23" /><verse number="24" style="v" sid="HEB 11:24" />Pừng slim slấn, chíu Môi-se cải khửn, thoi ngài mí hử hau dảo làu pìn lu̱c cú lu̱c slao huùng Pha-ra-ôn, <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Ké nhă̱n ta̱i cha tảy chíp khỏ xáu cần cú Chảu Fạ nhằng đay quá đảy hun fằng cha̱m mà phít xá. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Ké ngòi nả nhẻn cú cần đảy ma̱t dù nhằng hẳm pèng quá kí xang pảo cú cần Ai Cập, vi̱ ké mu̱ng tẳng fă̱n slưởng mư̱ lăng. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />Pừng slim slấn, ké pja̱c Ai Cập te̱o mí lao huùng fát slíng, vi̱ ké tảy na̱i xị nho̱m hăn Lạo mí hăn đảy. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Pừng slim slấn, ké hít Le̱ Khảm Quá xáu phắc lưư̱t, sle cần tang nả fạ mí khả chii̱t thưng kí lu̱c tàu cần Y-sơ-ra-ên. <verse eid="HEB 11:28" /><verse number="29" style="v" sid="HEB 11:29" />Pừng slim slấn, cần Y-sơ-ra-ên khảm quá Hải Đeng xị pay tìng tum lẹng, tọ cần Ai Cập oóc slèng te̱p nèm te̱o ngài nận. <verse eid="HEB 11:29" /><verse number="30" style="v" sid="HEB 11:30" />Pừng slim slấn, kí pha xình slẻng Giê-ri-cô ngài túm lùng, lăng slì cần Y-sơ-ra-ên pay to̱i slẻng chất vằn. <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />Pừng slim slấn, me̱ đị Ra-háp mí hai xáu cần bó slấn, vi̱ min tó mì slim đay tỏn chiíp kí cần pay tham khắm. <verse eid="HEB 11:31" /><verse number="32" style="v" sid="HEB 11:32" />Ngo̱ nhằng chảng lăng num? Vi̱ mí đo slì slằn, hạy ngo̱ ái chảng mà Ghi-đê-ôn, Ba-rác, Sam-sôn, Giép-thê, Đa-vít, Sa-mu-ên xáu kí cần páo cón, <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />kí cần nỉnh pừng slim slấn tó hình đảy kí tum ti̱, hít nèm cung lị, nhă̱n đảy kí vàm pao xình, chắt pác tu kì lằn, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />đắp piu fày luung, ni khói ma̱c dáng, hình đảy slim ón, pìn cần tài tảm slì pay tò tức, tức hử kí ò slức lèo le̱n ni. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Mì lai ti̱ me̱ hăn kí cần slăn làu tó hai dá hòi te̱o; mì kí cần ngài cọn chíp te̱o mí ái đảy cháu khói sle đảy táp lo̱ te̱o hẳm đay đắn quá; <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />nhằng kí cần táng ngài khu slủm, cọn thuúp, te̱o nhằng ngài cu̱m xáu ngài xăng num. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Hau tó ngài bẳn hin, ngài cứ hít sloong, ngài ma̱c dáng khả; pàn pa̱c ti̱ túc ti̱, nu̱ng slử năng tu chiin, năng bẻ, ngài slỉu khỏ, ngài há pả xáu ngài ngòi che̱n; <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />(tọ ti̱ da̱ mí ngám hử hau dú), ngài pa̱n pa̱c ti̱ túc ti̱ chang tu̱ng lẹng, tìng phja slung, chang thẳm, chang kí khum dú tảư tum. <verse eid="HEB 11:38" /><verse number="39" style="v" sid="HEB 11:39" />Ma̱i cạ đảy hít chửng đay, tọ kí cần nỉnh xằng nhă̱n đảy vàm Chảu Fạ pao xình hử làu, <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />vi̱ Chảu Fạ tó slưửng hử hung làu fúc fă̱n hẳm đay quá, hạy mí mì hung làu, hau mí pìn xày xiìn đảy.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Pìn nỉnh, vi̱ hung làu xị xá phử cải luung, đảy lai cần dú xảư hít chửng, do̱ hung làu xày tả mọi háp nắc xáu phít xá cà nạy làn làu, xày tảy na̱i le̱n nèm phang cần tò cheng sle cón hử hung làu, <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />ha pắc pí nho̱m khảu Chảu Giê-xu, Lạo Chí Oóc, Lạo Hít Xày Xiìn slim slấn, chư̱ Lạo vi̱ hun hỉ tặt tói nả làu háp mạy các khoáy, ngòi che̱n kí lo̱ hít hử nả nhẻn, sle đảy nă̱ng dú bưửng sla tắng kim Chảu Fạ. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />Pìn nỉnh, pi̱ noọng cứ nẳm thưng Lạo tó tảy sle kí cần phít xá tói tỉng làu, sle pi̱ noọng khói nái slim, lụp slim.<verse eid="HEB 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4" />Pi̱ noọng xằng tỉng te̱o phít xá thưng slặn lèo lay lưư̱t, <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />pi̱ noọng tó lùm vàm slắng, slắng pi̱ noọng xị lu̱c, cạ:</para>
  <para style="q1" vid="HEB 12:5">“Lu̱c cau ới, mí đảy ngòi che̱n vàm Chảu slon cho̱i,</para>
  <para style="q1" vid="HEB 12:5">xày mí đảy nái slim chíu Min quáy.<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Vi̱ cần Chảu điíp, do̱ Min slon cho̱i,</para>
  <para style="q1" vid="HEB 12:6">xáu cọn kí cần Min đảy tỏn nhă̱n.”<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />Pi̱ noọng tảy cho̱i fa̱t; nỉnh chư̱ Chảu Fạ tói ta̱i pi̱ noọng xị lu̱c; vi̱ mì tu lu̱c haư pá te̱o mí slon cho̱i? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Tọ hạy pi̱ noọng mí nhă̱n cho̱i fa̱t, xị mọi cần lu̱c xày lèo tảy, do̱ pi̱ noọng xị lu̱c cú cần pay chụ, tó mí chư̱ kí cần lu̱c chăn. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Te̱o cạ num, hung làu mì pá mà fă̱n đúc đang, cho̱i fa̱t hung làu te̱o nhằng kiíng lao, te̱o cạ Pá mà fă̱n khoăn, hung làu te̱o bó fục hẳm lai quá sle đảy te̱o do̱ lừ? <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Vi̱ pá mà fă̱n đúc đang cho̱i fa̱t tan dắp nưng xị cạ hau hăn hẳm đay đá, tọ Chảu Fạ vi̱ ái đay hử hung làu chứng cho̱i fa̱t, sle hung làu đảy păn fă̱n khảu lo̱ slaư tích cú Min. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Ngám chíu ngài cho̱i fa̱t do̱ mí chư̱ hun fằng, tan hít hử slim xàu, tọ mư̱ lăng, kí cần nhă̱n slon cho̱i co̱i oóc bjoóc mác pình an cú cung chính. <verse eid="HEB 12:11" /><verse number="12" style="v" sid="HEB 12:12" />Pìn nỉnh, lèo dặc phả mừ ón én xáu hu kháu loom lưứng num, <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />lèo cho̱i hử dàu tèo lo̱ cú kha pi̱ noọng, sle cần què khói ngài mja̱y kha, tọ đảy da đay pi̱ng num.<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Pi̱ noọng lèo oóc slèng kin dú đay đắn đủi mọi cần, xáu lèo hít nèm lo̱ slaư tích; vi̱ hạy mí slaư tích, do̱ bó slắc cần đảy nho̱m hăn Chảu, <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />lèo slỉu slim lao mì cần te̱o túc fúc Chảu Fạ pảo hử ma̱i cạ làu bó ngám, lao la̱c khum chứng buút oóc, hít luu̱n xáu hít hử lai cần slẳm sla̱p va̱, <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />lao mì cần eo đẳn, do̱ va̱ ngòi che̱n xị Ê-sau, tan vi̱ íng cú kin nưng te̱o nhă̱n khai quỳn lu̱c tàu. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Chăn pìn nỉnh, pi̱ noọng chắc cạ, mư̱ lăng, chíu ké ái đảy pảo fúc, tọ mí đảy, ma̱i cạ lút tằng nặm ha, vi̱ ké bó xa lo̱ cho̱i xá.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />Pi̱ noọng mí thưng xảư kí lo̱ tu̱ng thưng đảy, fày mảy cải, xáu ngàu đăm khít, khăm nhám, xáu xá lầm pắn pé <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />heng pí lè, xáu heng kí cần ti̱ng xày lèo na̱i xo, sle hau bó lèo ti̱ng vàm nỉnh num. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />Vi̱ hau bó tảy đảy lịng, cạ: “Ma̱i cạ tu cú tu̱ng khảu phja nảy, do̱ xày ngài bẳn hin.” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Lo̱ hau hăn nỉnh chăn ma̱o mi̱ng, thưng slặn Môi-se chảng cạ: “Ngo̱ he xáu slằn slặt.” <verse eid="HEB 12:21" /><verse number="22" style="v" sid="HEB 12:22" />Tọ pi̱ noọng tó thưng xảư Phja Si-ôn, slẻng cú Chảu Fạ te̱o tơ̱i tơ̱i, xáu Giê-ru-sa-lem tìng fạ, xảư kí cần tang nả fạ hun hỉ pao to̱i, <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />xảư ho̱i thánh cú kí lu̱c tàu đảy slẻ mìng khửn kí tẳm fạ, xảư Chảu Fạ chư̱ Lạo Ứn Chá mọi cần, xảư khoăn mi̱ng cần cung chính tó đảy hít hử xày xiìn, <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />xảư Chảu Giê-xu, Lạo Khen Chang cú chao kiít máư, chư̱ lưư̱t đảy phắc oóc, chư̱ lưư̱t hẳm đay quá lưư̱t cú A-bên. <verse eid="HEB 12:24" /><verse number="25" style="v" sid="HEB 12:25" />Lèo slỉu slim, lao pi̱ noọng te̱o thoi ngài Lạo slon cạ làu. Vi̱ hạy mí thoi ngài cần chảng vàm quáy dú tảư tum đảy, te̱o cạ hung làu tỉng te̱o Lạo oóc tứ tìng fạ, <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />heng cú Lạo nỉnh cạ tó hít hử tum tu̱ng fèn, tọ cà nạy Min te̱o pao xình cạ: “Nhằng pày nưng num, chăn Cau co̱i hít luu̱n lạo, mí tan tum xày, tọ nhằng hít tằng fạ num.” <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Kí chi̱: “Nhằng pày nưng num” hử hăn cạ lèo tả mọi lo̱ slưừng slì ngài tu̱ng fèn, chư̱ kí lo̱ đảy hít pìn, sle kí lo̱ mí ngài tu̱ng fèn đảy nhằng. <verse eid="HEB 12:27" /><verse number="28" style="v" sid="HEB 12:28" />Pìn nỉnh, hung làu nhă̱n đảy tum ti̱ nưng mí luu̱n lạo, hung làu lèo au slim kiíng lao pái slớ sle đay slim Chảu Fạ, <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />vi̱ Chảu Fạ hung làu xị cạ piu fày sliu pung.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Cứ cỏ slim điíp xáu căn mại. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Mí đảy lùm, lèo thuủn slim chiíp tỏn khéc vi̱ hít pìn nỉnh, mì cần chiíp tỏn cần tang nả fạ te̱o mí chắc. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Lèo chứ thưng kí cần cà nạy ngài xăng, xị chăn làu ngài xăng đủi hau; xáu cần ngài chíp khỏ, pìn nỉnh pi̱ noọng chứng dú chang đúc đang nưng hút xị hau. <verse eid="HEB 13:3" /><verse number="4" style="v" sid="HEB 13:4" />Po̱ me̱ lèo kiíng chu̱ng căn, mí đảy hít slàng nòn oóc slẳm sla̱p; vi̱ Chảu Fạ co̱i fa̱t cần eo đẳn xáu cần pay chụ. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />Pi̱ noọng mí đảy thám chèn, lèo cò lùng xáu kí lo̱ làu mì, vi̱ chăn Chảu Fạ tó cạ: “Cau co̱i bó pja̱c lu̱c, Cau xày bó tả lu̱c slắc pày đơ,” <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />thưng slặn hung làu tài tảm chảng cạ:</para>
  <para style="q1" vid="HEB 13:6">“Chảu pang cho̱i ngo̱, ngo̱ co̱i mí lao.</para>
  <para style="q1" vid="HEB 13:6">Cần tơ̱i nảy hít lăng ngo̱ đảy?”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Cứ chứ kí cần căm tàu làu, chư̱ cần páo cạ Vàm Chảu Fạ hử làu, cứ ngòi hử đay hang lăng tơ̱i hau pìn lừ sle tò i nèm slim slấn hau. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Chảu Giê-xu Cháu Ti̱ Da̱ vằn và, vằn nảy, thưng tơ̱i tơ̱i bó tói táng. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />Mí đảy sle kí lo̱ slon cạ táng la̱c quỷn làu pay. Vi̱ pừng fúc Chảu pảo hử ma̱i cạ làu bó ngám chứng đảy mắn táng, tó mí chư̱ pừng kí luật mà cú kin, chư̱ kí dưư̱ng bó mì lăng đay hử hau. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />Hung làu mì xoòng xằn nưng, kí cần cung ta̱i dú lưừn slớ cha̱m mí đảy quỳn kin. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Fă̱n lưư̱t cú tu cú sle pài hít sleng lình cháu phít xá, đảy slay pài xoòng ta̱i tàu au khảu ti̱ thánh, nhằng ăn chạp cú min do̱ pung bưửng noo̱c le̱o lỉnh. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Vi̱ pìn nỉnh, Chảu Giê-xu tó tảy chíp khỏ dú bưửng no̱oc pác tu slẻng, sle au lưư̱t làu slào slaư phang cần. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Hung làu chứng oóc noo̱c le̱o lỉnh, sle thưng xảư Min, háp au kí nả nhẻn Min tó tảy. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Vi̱ hung làu bó mì slẻng haư mắn táng dú nảy, tọ cà nạy hung làu lèo xa slẻng nưng ái thưng. <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />Pừng Chảu Giê-xu, hung làu chứng pài sleng lình sleng slu̱ khửn Chảu Fạ, xị bjoóc mác cú phi pác sle că̱n mình Min. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Mí đảy lùm hít lo̱ đay xáu pang cho̱i căn, vi̱ Chảu Fạ hăn hun fằng mà kí sleng lình pìn nỉnh. <verse eid="HEB 13:16" /><verse number="17" style="v" sid="HEB 13:17" />Lèo ti̱ng fục kí cần căm tàu pi̱ noọng, vi̱ hau pạư khoăn mi̱ng cú pi̱ noọng xị cần lèo xỉnh vàm khửn, hít hử slim hau hun hỉ te̱o mí hài ha̱c, vi̱ kí lo̱ nỉnh bó mì lăng đay hử pi̱ noọng.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Cứ xỉnh chàu hử hung ngo̱, vi̱ hung ngo̱ chắc cạ làu mì slim đay, ái kin dú slim chịch quá mọi lo̱. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Ngo̱ na̱i xo pi̱ noọng hít pìn nỉnh hẳm lai num, sle ngo̱ đảy fan te̱o đủi pi̱ noọng khoái.<verse eid="HEB 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Chảu Fạ pình an, Lạo tó au lưư̱t chao kiít tơ̱i tơ̱i hít Lạo Cải Hen Chiin, chăn chư̱ Chảu Giê-xu cú hung làu ho̱i te̱o tứ ti̱ hai, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />xo Chảu pảo hử pi̱ noọng mọi fúc đay, sle hít nèm slim Min slưửng, hít kí lo̱ đay slim Min, quá Chảu Giê-xu Cháu Ti̱ Da̱, Lạo slu̱ng phjưức dưứng mà Min thưng tơ̱i tơ̱i. A-men.<verse eid="HEB 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Pi̱ noọng ới, ngo̱ xo pi̱ noọng cứ hun hỉ nhă̱n au kí vàm nhòi slim nảy, vi̱ ngo̱ tan slẻ hử pi̱ noọng kỉ vàm nảy xày. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />Pi̱ noọng chắc cạ Ti-mô-thê pi̱ noọng cú hung làu tó đảy pjúi dá, hạy min mà khoái, ngo̱ xáu min co̱i ta̱i cha pay dưưng pi̱ noọng.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Xo phjác vàm tuụng thuủn kí cần căm tàu pi̱ noọng xáu thuủn kí cần slấn. Kí cần slấn tứ Y-ta-li tuụng tham pi̱ noọng.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />Xo fúc Chảu pảo hử ma̱i cạ làu bó ngám, dú đủi thuủn kí pi̱ noọng!<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>