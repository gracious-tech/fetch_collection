  <book code="COL" style="id">EN_NNLT nut-x-north_Northern⋅Nung_ltr Thu Jul 16 2026 15:20:00 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Colossians</para>
  <para style="toc1">Baư slư Cô-lô-se</para>
  <para style="toc2">Cô-lô-se</para>
  <para style="toc3">Col</para>
  <para style="mt">Cô-lô-se</para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />Phao-lô hít cần đảy Chảu Giê-xu Cháu Ti̱ Da̱ xoi pay, nèm slim Chảu Fạ slưửng, xáu Ti-mô-thê, pi̱ noọng cú hung làu, <verse eid="COL 1:1" /><verse number="2" style="v" sid="COL 1:2" />xo phjác thưng kí cần slấn, kí pi̱ noọng slim đeo chang Chảu Cháu Ti̱ Da̱ dú Cô-lô-se. Xỉnh xo Chảu Fạ, Pá hung làu, pảo fúc Chảu pảo hử ma̱i cạ làu bó ngám, xáu pình an tứ Chảu Giê-xu Cháu Ti̱ Da̱ hử pi̱ noọng.<verse eid="COL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />Hung ngo̱ sleng slu̱ Chảu Fạ, Pá cú Chảu hung làu chăn chư̱ Chảu Giê-xu Cháu Ti̱ Da̱, chang mọi vàm xỉnh chàu hử pi̱ noọng, <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />vi̱ hung ngo̱ đảy ti̱ng mà slim slấn cú pi̱ noọng chang Chảu Giê-xu Cháu Ti̱ Da̱ xáu pi̱ noọng mì slim điíp hử mọi kí cần slấn, <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />vi̱ slim kháo mu̱ng nỉnh đảy sle cón hử pi̱ noọng dú tìng fạ, mư̱ cón pi̱ noọng tó đảy ti̱ng chang vàm chăn lị, chư̱ Vàm Đay, <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />chăn cà nạy dú chang pi̱ noọng, Vàm Đay pìn mác dá khay quảng oóc to̱i ti̱ da̱ pìn lừ, do̱ xày pìn nỉnh chang pi̱ noọng, tứ vằn pi̱ noọng ti̱ng xáu slụ mà fúc Chảu pảo hử ma̱i cạ làu bó ngám cú Chảu Fạ chang chăn lị, <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />xị pi̱ noọng đảy slon chắc tứ Ê-pháp-ra, pàng dạu pèng điíp tò xày hít cung đủi hung ngo̱, min xị cần khỏi slim đeo đủi Chảu Cháu Ti̱ Da̱, tháy hung ngo̱, <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />chăn min tó hử hung ngo̱ chắc slim điíp cú pi̱ noọng chang Chảu Khoăn.<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />Pìn nỉnh, tứ vằn hung ngo̱ ti̱ng đảy pìn nỉnh, hung ngo̱ xỉnh chàu hử pi̱ noọng mại, xo pi̱ noọng đảy slim thung slụ, chắc slim Min slưửng quá mọi lo̱ quai kí, thung slụ slục khoăn, <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />sle pi̱ noọng kin dú ngám hử Chảu, đay slim Min mọi lo̱, pìn mác chang tằng mọi lo̱ đay, đảy thung slụ mà Chảu Fạ vằn hẳm lai khửn, <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />đảy tim quỳn slèng ngòi khảu slu̱ng phjưức cú Min, sle slim đảy hun hỉ chứng tảy nẳm đảy mọi lo̱, <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />pi̱ noọng cứ sleng slu̱ Pá, chư̱ Lạo tó hít hử pi̱ noọng ngám đảy fă̱n cha xài cú kí cần slấn chang áng slu̱ng. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />Chăn Lạo nỉnh cháu hung làu oóc khói quỳn cú ngàu đăm, sle tái hung làu thưng tum ti̱ Lu̱c pèng điíp cú Min, <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />chang Lu̱c nỉnh, hung làu đảy cháu, đảy sla phít xá. <verse eid="COL 1:14" /><verse number="15" style="v" sid="COL 1:15" />Lu̱c nỉnh chăn chư̱ dưư̱ng slưứng cú Chảu Fạ mí hăn đảy, chư̱ Lạo sleng oóc cón thuủn mọi lo̱ đảy hít pìn. <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />Vi̱ chang Lu̱c, mọi lo̱ tìng fạ, tảư tum, lo̱ hăn đảy do̱ va̱ lo̱ mí hăn đảy xày đảy hít oóc. Ma̱i cạ ti̱ nă̱ng cú huùng, kí cần đé đẩn, kí cần căm tàu, kí cần căm quỳn xày đảy Lu̱c nỉnh hít oóc xáu đảy hít oóc hử Lu̱c nỉnh. <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />Lu̱c nỉnh mì cón mọi lo̱, xáu mọi lo̱ đảy cáp mắn đủi căn chang Min. <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />Lu̱c nỉnh xày chư̱ hu cú đúc đang, xị cạ ho̱i thánh. Chăn Lu̱c nỉnh chư̱ ta̱i tàu cú mọi lo̱, chư̱ Lạo ta̱i tàu đảy hòi te̱o tứ chang kí cần hai, sle Lu̱c nỉnh đảy pìn Lạo tàu chang mọi lo̱. <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />Vi̱ Chảu Fạ tó hun hỉ tặt mọi lo̱ xày xiìn cú làu khảu chang Min, <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />quá Lu̱c nỉnh khen chang mọi lo̱ xáu chăn Min, tằng cạ kí lo̱ dú tảư tum xáu kí lo̱ dú tìng fạ, pừng lưư̱t tìng mạy các khoáy cú Lu̱c nỉnh chứng đảy khen chang. <verse eid="COL 1:20" /><verse number="21" style="v" sid="COL 1:21" />Mư̱ cón pi̱ noọng ngài ngòi xị kí cần dú quay xáu pìn tói tàu Chảu Fạ chang slim ki xáu hít slại, <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />tọ cà nạy, quá lo̱ hai cú đúc đang Lu̱c, sle tói nả Min pi̱ noọng đảy khen chang, slaư tích, mí mì lòi slẳm xáu mí mì lăng quáy đảy, <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />sle đảy pìn nỉnh, do̱ pi̱ noọng cứ lèo dú chang slim slấn, oóc la̱c, dân mắn, mí pja̱c khói kháo mu̱ng cú Vàm Đay pi̱ noọng đảy thư, chư̱ Vàm Đay tó đảy páo cạ hử mọi lo̱ dú tảư fạ, xị ngo̱, Phao-lô, tó pìn cần cung ta̱i Vàm Đay nỉnh.<verse eid="COL 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />Cà nạy, ngo̱ hun hỉ đảy tảy khỏ vi̱ pi̱ noọng, xáu vi̱ đúc đang làu, ngo̱ cứ tảy tò háp kí fă̱n chíp khỏ xáu Chảu Cháu Ti̱ Da̱, chư̱ đúc đang Min, chư̱ ho̱i thánh, <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />ngo̱ pìn cần cung ta̱i, nèm xị Chảu Fạ tó chao hử ngo̱, sle páo cạ xày xiìn vàm Chảu Fạ hử pi̱ noọng, <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />chăn chư̱ kí dăm dò quá kí tơ̱i, kí xám cần mư̱ cón, tọ cà nạy te̱o páo cạ hử kí cần slấn Min đảy chắc, <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />hử cần Chảu Fạ ái hử đảy chắc kí dăm dò nảy fúng fàu xáu slu̱ng phjưức thưng haư, hử chăn kí cần cú tum ti̱ táng, Chảu Cháu Ti̱ Da̱ dú chang pi̱ noọng pảo hử slim kháo mu̱ng mà slu̱ng phjưức. <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />Chăn chư̱ Lạo hung ngo̱ páo cạ, hung ngo̱ au thuủn mọi lo̱ quai kí sle quáy mọi cần, slon cạ mọi cần, sle mọi cần đảy pìn xày xiìn chang Chảu Cháu Ti̱ Da̱. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />Pìn nỉnh ngo̱ chứng oóc slèng hít cung khỏ, tò tức pừng khảu quỳn slèng cú Min hít dú chang ngo̱.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />Chăn vi̱ ngo̱ ái pi̱ noọng chắc ngo̱ lèo tò tức pìn lừ hử pi̱ noọng, hử kí cần slấn dú Lao-đi-xê, xáu kí cần xằng hăn nả ngo̱ mà fă̱n đúc đang, <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />sle hau đảy nhòi slim, cáp đủi căn chang slim điíp, đảy thung slụ fúng fàu, pang hau chắc đảy lo̱ dăm dò cú Chảu Fạ, chăn chư̱ Chảu Cháu Ti̱ Da̱; <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />chang Min mì mọi xang pảo quai kí xáu thung slụ. <verse eid="COL 2:3" /><verse number="4" style="v" sid="COL 2:4" />Ngo̱ chảng pìn nảy sle mí cần nàư au vàm chảng on van pjàng pjào đảy pi̱ noọng. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />Ma̱i cạ đúc đang ngo̱ dú quay, tọ slim khoăn ngo̱ dú đủi pi̱ noọng, hun fằng hăn slim slấn pi̱ noọng đảy slèng dạc chang Chảu Cháu Ti̱ Da̱.<verse eid="COL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />Pìn nỉnh, chíu pi̱ noọng tó nhă̱n Chảu Giê-xu Cháu Ti̱ Da̱ hít Chảu pìn lừ, do̱ cứ phjải pay chang Min pìn nỉnh, <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />lèo chắp la̱c xáu tặt ti̱ chang Min, lèo hít hử slim slấn slèng dạc xị pi̱ noọng tó đảy slon cạ, sle slim pi̱ noọng mì lai lo̱ sleng slu̱ num.<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />Lèo slỉng sla̱c, mí đảy sle cần nàư au slim ki quai kí xáu vàm pjàng pjào pjáu lưứng pay nèm cỏ le̱ cú tu cần, pay nèm kí slín lình cú ti̱ da̱ hảng pi̱ noọng, tọ mí pay nèm Chảu Cháu Ti̱ Da̱. <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />Vi̱ chang đúc đang Min, mì mọi lo̱ xày xiìn cú slín Chảu Fạ, <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />pi̱ noọng chứng đảy Min hít hử mọi lo̱ xày xiìn, Lạo hít hu cú mọi quỳn cai cuủn, <verse eid="COL 2:10" /><verse number="11" style="v" sid="COL 2:11" />chang Lạo nỉnh, pi̱ noọng xày đảy slắp năng, mí chư̱ slắp năng tứ mừ tu cần hít, tọ slắp năng tứ Chảu Cháu Ti̱ Da̱ loo̱c tả tu cần phít xá cú hung làu, <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />pi̱ noọng tó đảy phăng xáu Min chang báp-têm, do̱ xày đảy hòi te̱o xáu Min quá slim slấn pừng khảu quỳn slèng cú Chảu Fạ, Lạo tó hít Min hòi te̱o tứ ti̱ hai. <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" />Fă̱n pi̱ noọng chíu đúc đang xằng slắp năng tó hai vi̱ phít xá, do̱ Min hít hử pi̱ noọng đảy te̱o xáu Min, vi̱ Min tó sla dưư̱ng mọi phít xá hử hung làu, <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />Min tó xẻ baư chỉ nỉ cáp xá tỉng te̱o hung làu, kí luật tỉng te̱o hung làu, dò baư chỉ khói hung làu, toóc teng baư chỉ nỉ khảu mạy các khoáy, <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />Min tó hít kí cần cai cuủn, kí quỳn slèng, dẻng xảu min oóc khu fằng tói nả mọi cần tìng ti̱ da̱, hình mọi lo̱ tìng mạy các khoáy.<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />Pìn nỉnh, mí đảy sle cần nàư ứn chá pi̱ noọng mà cú kin, nặm kin, mà vằn le̱, vằn vằng hai máư, do̱ va̱ vằn Sa-bát, <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />mọi lo̱ nỉnh tan xị ngàu cú kí lo̱ ái thưng, nhằng slưứng ngàu do̱ slục mà Chảu Cháu Ti̱ Da̱. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />Mí đảy sle làu túc fă̱n slưởng vi̱ kí cần chá xị cần nhă̱n nhưư̱ng, pái slớ kí cần tang nả fạ pừng khảu kí lo̱ ha làu nho̱m hăn, hau pìn háo cao, vi̱ nẳm nèm nèm đúc đang làu, <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />hau bó slan cáp mắn xáu Chảu Giê-xu chăn xị Hu, đúc đang te̱o đảy chưựng, đảy slan cáp xáu căn tứ kí khỏ đúc, tèo dần, đúc đang nỉnh cải khửn nèm slèng Chảu Fạ.<verse eid="COL 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />Hạy pi̱ noọng tó hai xáu Chảu Cháu Ti̱ Da̱, oóc khói kí slín lình cú ti̱ da̱, do̱ hít lừ pi̱ noọng nhằng kin dú xị làu nhằng slục mà ti̱ da̱, hít lăng nhằng fục kí le̱ lài nỉnh: <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />“Mí đảy căm, mí đảy xìm, mí đảy tu̱ng khảu!” <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />mọi lo̱ nỉnh xày va̱i đai hạy tu̱ng thưng, vi̱ tan chư̱ kí le̱ lài xáu vàm slon tứ tu cần xày? <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />Chăn kí lo̱ nỉnh, ma̱i cạ bưửng noo̱c nho̱m xị quai kí vi̱ pái slớ xị slim làu slưửng, hít xị nhă̱n nhưư̱ng, đúc đang chẳn khỏ, tọ mí hít pìn lừ tỉng te̱o slém mu̱ng cú đúc đang đảy.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />Pìn nỉnh, hạy pi̱ noọng tó đảy hít hử hòi te̱o xáu Chảu Cháu Ti̱ Da̱, do̱ lèo xa kí lo̱ dú tìng fạ, ti̱ Chảu Cháu Ti̱ Da̱ nă̱ng bưửng sla Chảu Fạ. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />Lèo tặt slim khảu kí lo̱ dú tìng fạ, mí chư̱ tặt slim khảu kí lo̱ dú tìng tum, <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />Vi̱ pi̱ noọng tó hai, lo̱ te̱o máư cú pi̱ noọng ngài dăm dò đủi Chảu Cháu Ti̱ Da̱ chang Chảu Fạ dá. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />Thưng chíu Chảu Cháu Ti̱ Da̱ chăn chư̱ lo̱ te̱o cú pi̱ noọng, oóc nả, do̱ pi̱ noọng xày co̱i oóc nả xáu Min chang slu̱ng phjưức.<verse eid="COL 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />Pìn nỉnh, lèo khả hai kí lo̱ slục mà ti̱ da̱ — xị pay chụ, slẳm sla̱p, eo đẳn, slém mu̱ng xảu slại xáu thám cò, vi̱ thám cò xày hút xị pái slớ xằn tum, <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />vi̱ kí lo̱ nảy, xá fát fày cú Chảu Fạ chứng thưng, <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />chíu mư̱ cón pi̱ noọng xày kin dú pìn nỉnh, hít pìn nỉnh. <verse eid="COL 3:7" /><verse number="8" style="v" sid="COL 3:8" />Tọ cà nạy, pi̱ noọng lèo tả thuủn mọi lo̱ xị — fát fày, fát slíng, too̱c éc, chảng fa̱m thưng fạ, xáu kí vàm chảng slẳm sla̱p tứ pác làu pay. <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />Mí đảy chảng pjàng căn, vi̱ pi̱ noọng tó loo̱c tả tu cần cáu xáu kí cung sla̱y xảu nỉnh dá, <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />sle đảy nu̱ng au tu cần máư, chư̱ cần cà nạy đảy tói máư chang slim ki nèm dưư̱ng slưứng Lạo hít oóc cần nỉnh, <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />ti̱ nỉnh mí nhằng cần Hy Lạp do̱ va̱ cần Do Thái, cần nhă̱n slắp năng do̱ va̱ cần mí nhă̱n slắp năng, cần slỉu thung slụ, cần Sy-the, cần hít khỏi do̱ va̱ cần táng hít chảu; Chảu Cháu Ti̱ Da̱ chăn chư̱ mọi lo̱, dú chang mọi cần.<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />Pi̱ noọng xị cần đảy Chảu Fạ lưư̱c, đảy slaư tích, đảy pèng điíp lai, lèo nu̱ng au slim điíp sliít, slim quảng, nhă̱n nhưư̱ng, slìn ta̱o, tảy nẳm, <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />do̱ pi̱ noọng xày lèo tảy nẳm căn, sla dưư̱ng hử căn pìn nỉnh, hạy cần nưng chang pi̱ noọng mì lăng hài ha̱c xáu cần táng, xị Chảu tó sla dưư̱ng hử pi̱ noọng pìn lừ, do̱ lèo tảy xáu sla dưư̱ng hử căn pìn nỉnh. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />Tọ cải quá kí lo̱ nỉnh, lèo nu̱ng au slim điíp chăn chư̱ tèo chưư̱c slan cáp xày xiìn. <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />Mu̱ng hử pình an cú Chảu Cháu Ti̱ Da̱ cai cuủn slim pi̱ noọng, chăn pình an pi̱ noọng tó đảy dảo thưng chang đúc đang đeo xáu lèo chắc sleng slu̱. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />Mu̱ng hử vàm cú Chảu Cháu Ti̱ Da̱ dú chang slim pi̱ noọng chăn fúng fàu, pi̱ noọng lèo au thuủn slim quai kí sle slon xáu nhòi slim căn, xưứng sli thiin, sli thánh, tèo sli slim khoăn sle sleng slu̱ Chảu Fạ. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />Ma̱i cạ pi̱ noọng chảng do̱ va̱ hít lo̱ lăng, do̱ lèo hít mọi lo̱ chang mình Chảu, chăn chư̱ Chảu Giê-xu, pừng khảu Min sleng slu̱ Chảu Fạ, chăn chư̱ Pá.<verse eid="COL 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />Hày kí cần hít me̱, lèo fục po̱ làu, pìn nỉnh chứng ngám slục mà Chảu. <verse eid="COL 3:18" /><verse number="19" style="v" sid="COL 3:19" />Hày kí cần hít po̱, lèo điíp me̱ làu, mí đảy hít chíp slim me̱. <verse eid="COL 3:19" /><verse number="20" style="v" sid="COL 3:20" />Hày kí cần hít lu̱c, lèo ti̱ng vàm pá mé mọi lo̱, vi̱ pìn nỉnh chứng đay slim Chảu. <verse eid="COL 3:20" /><verse number="21" style="v" sid="COL 3:21" />Hày kí cần hít pá, mí đảy hít hử lu̱c làu fát slíng, sle hung min mí nái slim. <verse eid="COL 3:21" /><verse number="22" style="v" sid="COL 3:22" />Ne̱ kí cần hít khỏi, lèo ti̱ng mọi vàm chảu làu mà fă̱n đúc đang, mí tan ti̱ng vàm tói nả, xị cần oóc slèng hít đay slim tu cần, tọ vi̱ chăn slim, kiíng lao Chảu. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />Hạy hít lăng, lèo thuủn slim hít, xị hít hử Chảu tó mí chư̱ hít hử hau, <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />vi̱ chắc cạ pi̱ noọng co̱i nhă̱n đảy fă̱n slưởng tứ Chảu hít cha xài. Cà nạy pi̱ noọng cung ta̱i Chảu chăn chư̱ Chảu Cháu Ti̱ Da̱. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />Cần nàư hít slại co̱i lèo ngài păng xàu ngám xáu lo̱ dăm cung làu tó hít, mí đảy slắc cần khảu cò chạy.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />Kí cần hít chảu ới, lèo tói ta̱i ngám chư̱, cung phình đủi kí cần khỏi cú làu, vi̱ chắc cạ pi̱ noọng xày mì Chảu nưng dú tìng fạ.<verse eid="COL 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />Lèo chăn slim xỉnh chàu, lèo slỉng sla̱c chíu xỉnh chàu, lèo sleng slu̱, <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />xày lèo xỉnh chàu tháy hử hung ngo̱, sle Chảu Fạ khay tu hử hung ngo̱ páo cạ, chảng oóc lo̱ dăm dò cú Chảu Cháu Ti̱ Da̱, xày vi̱ lo̱ dăm dò nỉnh ngo̱ chứng ngài xăng, <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />xỉnh chàu sle ngo̱ chắc chảng khát sla̱t kí lo̱ dăm dò, xị ngo̱ lèo chảng oóc. <verse eid="COL 4:4" /><verse number="5" style="v" sid="COL 4:5" />Lèo kin dú quai kí xáu kí cần mí slấn Chảu, lèo chắc du̱ng slì slằn hử quai kí. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />Pi̱ noọng lèo chảng vàm đay ti̱ng, tức íng cư nưng khảu num, sle pi̱ noọng chắc lèo tói ta̱i pìn lừ xáu mọi cần hẳm đay.<verse eid="COL 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />Ti-chi-cơ chăn chư̱ pàng dạu pèng điíp, cần slim đeo cung ta̱i, xày chư̱ cần tò hít cung xáu ngo̱ chang Chảu, co̱i chảng hử pi̱ noọng chắc mọi lo̱ ngo̱ hít, <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />ngo̱ chứng xoi min thưng phúng pi̱ noọng, sle pi̱ noọng chắc đảy cà nạy hung ngo̱ pìn lừ, sle pi̱ noọng đảy nhòi slim, <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />tò xày pay đủi min nhằng mì Ô-nê-sim, cần pi̱ noọng slim đeo xáu pèng điíp, cần xày pỏn ti̱ xáu pi̱ noọng, hau co̱i chảng hử pi̱ noọng chắc mọi lo̱ dú nảy.<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />A-ri-tạc, cần xày ngài xăng xáu ngo̱, phjác vàm tuụng tham pi̱ noọng, xáu Mác noọng cú Ba-na-ba xày pìn nỉnh (pi̱ noọng tó nhă̱n đảy kí vàm slắng mà min dá, hạy Mác thưng ti̱ pi̱ noọng, lèo chiíp tỏn min hử đay), <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />Giê-su, nhằng dảo hít Giúc-tu xày phjác vàm tuụng tham pi̱ noọng. Chang kí cần nhă̱n slắp năng, tan mì kí cần nảy tò xày hít cung xáu ngo̱ hử tum ti̱ Chảu Fạ, chăn hau xày an chi hử ngo̱. <verse eid="COL 4:11" /><verse number="12" style="v" sid="COL 4:12" />Ê-pháp-ra, phjác vàm tuụng tham pi̱ noọng, min xày dú pỏn ti̱ xáu pi̱ noọng, cần khỏi nưng cú Chảu Giê-xu Cháu Ti̱ Da̱, min tò tức vi̱ pi̱ noọng chang vàm xỉnh chàu, sle pi̱ noọng đảy mắn táng, slèng dạc, slấn nèm xị slim Chảu Fạ slưửng. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />Vi̱ ngo̱ hít chửng mà min cạ, min tó hít cung khỏ vi̱ pi̱ noọng, xày vi̱ kí cần slấn ti̱ Lao-đi-xê xáu dú Hi-ê-ra-bô-li. <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />Lu-ca, slay da pi̱ng pèng điíp, xáu Đê-ma, tuụng tham pi̱ noọng. <verse eid="COL 4:14" /><verse number="15" style="v" sid="COL 4:15" />Lèo tuụng tham kí pi̱ noọng dú Lao-đi-xê, xáu Nim-pha xày ho̱i thánh tom te̱o dú lưừn da̱ nỉnh. <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />Chíu to̱c baư slư nảy dá, do̱ pi̱ noọng cứ phjác thưng Ho̱i thánh Lao-đi-xê num; pi̱ noọng lèo xày to̱c baư slư tứ Lao-đi-xê phjác thưng num. <verse eid="COL 4:16" /><verse number="17" style="v" sid="COL 4:17" />Hang lăng, lèo chảng đủi A-chíp, cạ: “Lèo slỉu slim hít cung, sle hít thuủn cung sla̱y tó nhă̱n tứ Chảu.”<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />Vàm tuụng tham nảy chăn mừ ngo̱, Phao-lô, slẻ oóc. Lèo chứ cạ ngo̱ nhằng ngài xăng. Xỉnh xo fúc Chảu pảo hử ma̱i cạ hung làu bó ngám, dú đủi pi̱ noọng.<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>