  <book code="PHM" style="id">EN_NNLT nut-x-north_Northern⋅Nung_ltr Thu Jul 16 2026 15:20:00 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Philemon</para>
  <para style="toc1">Baư slư Phi-lê-môn</para>
  <para style="toc2">Phi-lê-môn</para>
  <para style="toc3">Phm</para>
  <para style="mt">Phi-lê-môn</para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />Phao-lô, cần ngài xăng cú Chảu Giê-xu Cháu Ti̱ Da̱, xáu Ti-mô-thê, pi̱ noọng hung làu, xo phjác thưng Phi-lê-môn pàng dạu pèng điíp, tò xày hít cung đủi hung ngo̱; <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />hử Áp-bi, pi̱ noọng cú hung ngo̱; hử A-chíp, pàng dạu hung ngo̱; xáu hử ho̱i thánh dú lưừn ké. <verse eid="PHM 1:2" /><verse number="3" style="v" sid="PHM 1:3" />Xỉnh xo fúc Chảu pảo hử ma̱i cạ làu bó ngám, pình an tứ Chảu Fạ, Pá hung làu, xày pìn Chảu hung làu, chư̱ Chảu Giê-xu Cháu Ti̱ Da̱, dú đủi pi̱ noọng.<verse eid="PHM 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />Ngo̱ slưừng slì sleng slu̱ Chảu Fạ làu, chíu ngo̱ chứ thưng ni̱ chang vàm xỉnh chàu, <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />vi̱ ngo̱ di̱ nhằng đảy ti̱ng mà slim điíp cú ni̱, chắc slim ni̱ slấn khảu Chảu Giê-xu, xáu hử kí cần slấn, <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />thưng slặn, slim slấn cú ni̱ đảy thung slụ, mà mọi lo̱ đay đắn hung làu đảy nhă̱n tứ Chảu Cháu Ti̱ Da̱. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />Ni̱ ới, slim ngo̱ hun fằng, đảy an chi lai, vi̱ chăn slim điíp cú ni̱ tó hít hử kí cần slấn đảy máư num.<verse eid="PHM 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />Pìn nỉnh, ma̱i cạ ngo̱ mì quỳn chang Chảu Cháu Ti̱ Da̱, sle oóc lịng hử ni̱ mà lo̱ lèo hít, <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />tọ vi̱ slim điíp, ngo̱ chứng na̱i xo ni̱ do̱ hẳm đay — hạy ngo̱, Phao-lô nảy, tó ké cắc dá, tọ cà nạy nhằng ngài xăng vi̱ Chảu Giê-xu Cháu Ti̱ Da̱ — <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />Ngo̱ chứng na̱i xo ni̱, tháy hử ò lu̱c cú ngo̱, Ô-nê-sim, cần ngo̱ sleng oóc chíu ngài xăng chang cu̱m lích. <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />Mư̱ cón, cần nỉnh bó hít đảy lăng đay hử ni̱, tọ cà nạy do̱ đay hử ni̱, đay tằng hử ngo̱ num, <verse eid="PHM 1:11" /><verse number="12" style="v" sid="PHM 1:12" />chăn cần ngo̱ xoi mà phúng ni̱, chăn min, cần nảy chăn xị slim ngo̱. <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />Ngo̱ mu̱ng cạ cứ cỏ cần nỉnh dú đủi làu, sle tháy ni̱ hít cung pang cho̱i ngo̱ chíu ngài cu̱m lích vi̱ Vàm Đay. <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />Tọ, ngo̱ mí ái hít lăng hạy ni̱ xằng chung ý, sle slim đay ni̱ hít bó chư̱ vi̱ ngài pắt, tọ chăn slim táng ái hít. <verse eid="PHM 1:14" /><verse number="15" style="v" sid="PHM 1:15" />Cay vi̱ pìn nỉnh Ô-nê-sim chứng pay quay khói ni̱ hả lai hưng, sle ni̱ te̱o nhă̱n min mại mại, <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />mí nhằng xị cần hít khỏi dá, tọ hẳm pèng quá cần hít khỏi nưng — chư̱ cần pi̱ noọng pèng điíp xáu ngo̱, te̱o hẳm pèng điíp xáu ni̱ quá num, fă̱n tu cần xáu tu cần đủi căn, tằng fă̱n pi̱ noọng chang Chảu num. <verse eid="PHM 1:16" /><verse number="17" style="v" sid="PHM 1:17" />Pìn nỉnh, hạy ni̱ ngòi ngo̱ xị pàng dạu tò xày hít cung, do̱ cứ tỏn chiíp cần nỉnh xị chiíp tỏn ngo̱. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />Nhằng hạy min hít ha̱i xáu nhằng slỉu nỉ ni̱ ca lăng, do̱ cứ cay thuủn hử ngo̱. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />Chăn ngo̱, Phao-lô, tó slẻ vàm nảy tứ chăn mừ làu: chăn ngo̱ táng păng hử ni̱ thuủn — sle mí lèo chảng đủi ni̱ cạ, chăn ni̱ tó nhằng slỉu nỉ ngo̱! <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />Chăn, ni̱ ới, xo ni̱ hử ngo̱ đảy slim hun hỉ chang Chảu; xo ni̱ hít hử slim ngo̱ đảy máư chang Chảu Cháu Ti̱ Da̱.<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />Vi̱ ngo̱ slấn cạ ni̱ co̱i chung ý, chứng slẻ sư hử ni̱, chắc cạ ni̱ nhằng hít lai quá vàm ngo̱ na̱i xo. <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />Xỉnh xo chắp xặp ti̱ nưng hử ngo̱, vi̱ ngo̱ kháo mu̱ng quá vàm xỉnh chàu cú kí pi̱ noọng, ngo̱ co̱i đảy pjúi mừ đủi kí noọng.<verse eid="PHM 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />Ê-pháp-ra, cần xày ngài xăng đủi ngo̱ chang Chảu Giê-xu Cháu Ti̱ Da̱, phjác vàm tuụng tham ni̱. <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />Mác, A-ri-tạc, Đê-ma, xáu Lu-ca, kí cần tò xày hít cung đủi ngo̱, xày phjác vàm tuụng tham ni̱.<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />Xỉnh xo fúc Chảu pảo hử ma̱i cạ hung làu bó ngám, chăn chư̱ Chảu Giê-xu Cháu Ti̱ Da̱, dú đủi slim khoăn pi̱ noọng. A-men!<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>