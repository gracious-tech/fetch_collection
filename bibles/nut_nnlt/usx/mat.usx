  <book code="MAT" style="id">EN_NNLT nut-x-north_Northern⋅Nung_ltr Thu Jul 16 2026 15:20:00 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Matthew</para>
  <para style="toc1">Vàm Đay Ma-thi-ơ</para>
  <para style="toc2">Ma-thi-ơ</para>
  <para style="toc3">Mat</para>
  <para style="mt">Ma-thi-ơ</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Cúc chỏ cú Chảu Giê-xu Cháu Ti̱ Da̱, lu̱c lan Đa-vít, lu̱c lan Áp-ra-ham: <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />Áp-ra-ham sleng Y-sác; Y-sác sleng Gia-cốp; Gia-cốp sleng Giu-đa xáu pi̱ noọng cú ké, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Giu-đa au Ta-ma sleng Phê-rết xáu Sê-rách; Phê-rết sleng Hết-rôn; Hết-rôn sleng A-ram, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />A-ram sleng A-mi-na-đáp; A-mi-na-đáp sleng Na-ách-son; Na-ách-son sleng Sanh-môn, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Sanh-môn au Ra-háp sleng Bô-ô; Bô-ô au Ru-tơ sleng Ô-bết; Ô-bết sleng Gie-sê, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Gie-sê sleng huùng Đa-vít, Đa-vít au me̱ cú U-ri sleng Sa-lô-môn.<verse eid="MAT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 1:7" />Sa-lô-môn sleng Rô-bô-am; Rô-bô-am sleng A-bi-gia; A-bi-gia sleng A-sa, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />A-sa sleng Giô-sa-phát; Giô-sa-phát sleng Giô-ram; Giô-ram sleng Ô-xia. <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Ô-xia sleng Giô-tam; Giô-tam sleng A-cha; A-cha sleng Ê-xê-chia, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Ê-xê-chia sleng Ma-na-se; Ma-na-se sleng A-môn; A-môn sleng Giô-si-a, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Giô-si-a sleng Giê-cô-nia xáu kí noọng cú ké, chíu ngài cháy choóc quá Ba-by-lôn.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Lăng slì ngài cháy choóc quá Ba-by-lôn, Giê-cô-nia sleng Sa-la-thi-ên; Sa-la-thi-ên sleng Xô-rô-ba-bên, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Xô-rô-ba-bên sleng A-bi-út; A-bi-út sleng Ê-li-a-kim; Ê-li-a-kim sleng A-xô, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />A-xô sleng Sa-đốc; Sa-đốc sleng A-chim; A-chim sleng Ê-li-út, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Ê-li-út sleng Ê-lê-a-xa; Ê-lê-a-xa sleng Ma-than; Ma-than sleng Gia-cốp, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Gia-cốp sleng Giô-sép po̱ cú Ma-ri; Ma-ri chư̱ cần sleng Giê-xu, Lạo đảy dảo hít Chảu Cháu Ti̱ Da̱. <verse eid="MAT 1:16" /><verse number="17" style="v" sid="MAT 1:17" />Pìn nỉnh, kí xám cần tứ Áp-ra-ham thưng Đa-vít mì slíp slí xám cần; tứ Đa-vít thưng slì cháy choóc quá Ba-by-lôn mì slíp slí xám cần; xáu tứ slì cháy choóc quá Ba-by-lôn thưng Chảu Cháu Ti̱ Da̱ xày mì slíp slí xám cần.<verse eid="MAT 1:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Chảu Giê-xu Cháu Ti̱ Da̱ cháng sleng pìn nảy: Ma-ri mé Min, tó tham háp xáu Giô-sép, tọ xằng kin dú đủi căn, do̱ da̱ chắc làu làm đang tứ Chảu Khoăn. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Nhằng Giô-sép, po̱ cú da̱, chư̱ cần cung chính, mí ái hít xảu da̱ chứng slưửng lặc lu̱m lư da̱. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Tọ, chíu Giô-sép nẳm mà kí lo̱ nảy, do̱ mì cần tang nả cú Chảu oóc nả đủi ké chang făn hăn, cạ: “Giô-sép lu̱c lan Đa-vít ới, ni̱ mí đảy lao au Ma-ri hít me̱, vi̱ tu đích da̱ mì nỉnh tứ Chảu Khoăn. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Da̱ co̱i sleng lu̱c báo nưng; ni̱ lèo tặt mìng hít Giê-xu, vi̱ chăn lu̱c báo nỉnh co̱i cháu cần làu oóc khói xá.” <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />Kí lo̱ nảy mì oóc sle lình ính xị vàm Chảu tó chảng cón quá kí cần páo cón, cạ:<verse eid="MAT 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23" />“Nỉnh cà, slao nóm co̱i làm đang, xáu sleng lu̱c báo nưng, hau co̱i tặt mìng Min hít Em-ma-nu-ên” — đảy slụ cạ “Chảu Fạ dú đủi hung làu.”<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Chíu nòn tấn, Giô-sép hít chăn xị vàm cú cần tang nả cú Chảu tó cạ, dá au Ma-ri hít me̱. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Tọ Giô-sép mí kin dú đủi da̱ thưng slì da̱ sleng lu̱c báo nưng. Dá tặt mìng tu đích nỉnh hít Giê-xu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Chíu Chảu Giê-xu đảy sleng oóc dú Bết-lê-hem búng Giu-đê, khảu tơ̱i huùng Hê-rốt, mì kỉ cần thung slụ tứ bưửng tung mà ti̱ Giê-ru-sa-lem, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />tham cạ: “Lạo ngám đảy sleng oóc sle hít Huùng cú cần Do Thái dú haư? Vi̱ hung ngo̱ đảy hăn đao đí Min dú bưửng tung, chứng mà nảy sle pái slớ Min.” <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />Tọ slì ti̱ng pìn nỉnh, huùng Hê-rốt xáu tằng slẻng Giê-ru-sa-lem xày slim luu̱n xị ké. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Huùng chiu xỉnh kí slay pài xoòng tàu xáu kí slay slon luật chang phang cần mà, dá tham hau: “Chảu Cháu Ti̱ Da̱ đảy sleng oóc dú haư?” <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Hau dăng huùng: “Dú Bết-lê-hem búng Giu-đê; vi̱ mì vàm đảy slẻ pìn nỉnh quá cần páo cón,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />‘Nhằng Bết-lê-hem, cú tum ti̱ Giu-đa ới,</para>
  <para style="q1" vid="MAT 2:6">mưng mí chư̱ sláy chang kí cần căm tàu cú Giu-đa,</para>
  <para style="q1" vid="MAT 2:6">vi̱ tứ mưng co̱i sleng oóc Lạo căm tàu nưng,</para>
  <para style="q1" vid="MAT 2:6">lạo nỉnh co̱i hen tái Y-sơ-ra-ên, cần cú Cau.’”<verse eid="MAT 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 2:7" />Chíu nỉnh, Hê-rốt lặc lu̱m xỉnh kí cần thung slụ thưng sle tham hau mà slì slằn đao đí oóc nả. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Xoi hau pay thưng Bết-lê-hem dá, ké slắng: “Kí ké pay tham đay đay mà lu̱c đích nỉnh; slì phúng đảy dá, do̱ hử ngo̱ chắc sle ngo̱ xày pay pái slớ Min.” <verse eid="MAT 2:8" /><verse number="9" style="v" sid="MAT 2:9" />Ti̱ng huùng slắng dá, hau chứng pay, nỉnh cà, đao đí hau hăn dú bưửng tung pay cón hau thưng ti̱ tu đích dú chứng đử dú. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Nho̱m hăn đao đí, hau hun fằng lai. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Khảu thưng lưừn, hau nho̱m hăn tu đích xáu Ma-ri, mé Min, chứng qu̱y kháu pái slớ Min, chíu khay ăn chắp pảo oóc, hau pài hử Min kí cú cái: tứ kim, dang hom xáu nhả hom. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Vi̱ chang făn hăn hau đảy slắng cạ mí đảy fan te̱o ti̱ huùng Hê-rốt, hau chứng pay lo̱ táng mừ tum ti̱ làu.<verse eid="MAT 2:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Chíu hau pay dá, cần tang nả Chảu oóc nả đủi Giô-sép chang făn hăn, cạ: “Chíu nòn tấn, do̱ au tu đích xáu mé min ni quá Ai Cập, dá dú nỉnh thưng slì ngo̱ cạ ni̱, vi̱ huùng Hê-rốt slưửng xa khả tu đích nỉnh pay.” <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Nòn tấn dá, Giô-sép au tu đích xáu mé Min ni quá Ai Cập tằng khừn, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />dá cứ dú nỉnh thưng chíu huùng Hê-rốt quá tơ̱i, sle đảy lình ính vàm Chảu cạ quá cần páo cón: “Cau tó dảo lu̱c cú Cau oóc khói Ai Cập.”<verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Chíu nỉnh Hê-rốt chắc làu ngài kí cần thung slụ chảng pjàng, do̱ fát slíng lai, chứng oóc lịng khả thuủn kí ò đích tứ sloong pi tò lùng dú slẻng Bết-lê-hem xáu chang kí ti̱ xảư xảng, nèm xị chíu huùng tham tứ kí cần thung slụ. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Pìn nỉnh, vàm đảy páo cón quá Giê-rê-mi đảy lình ính, cạ:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“Hau ti̱ng dú slẻng Ra-ma,</para>
  <para style="q1" vid="MAT 2:18">mì heng thán, hảy đỉn hảy đát,</para>
  <para style="q1" vid="MAT 2:18">Ra-chên hảy hử kí lu̱c làu,</para>
  <para style="q1" vid="MAT 2:18">tọ mí nhă̱n đảy an chi, vi̱ hung min mí nhằng dá.”<verse eid="MAT 2:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Lăng slì Hê-rốt quá tơ̱i, do̱ nỉnh cà, mì cần tang nả Chảu oóc nả đủi Giô-sép chang făn hăn dú Ai Cập, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />cạ: “Nòn tấn dá, do̱ au tu đích xáu mé min fan te̱o ti̱ Y-sơ-ra-ên, vi̱ kí cần xa khả tu đích tó hai dá.” <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Dá chíu Giô-sép nòn tấn, au tu đích xáu mé Min, fan te̱o ti̱ Y-sơ-ra-ên. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Chíu ti̱ng nghìn A-chê-la-u cai cuủn búng Giu-đê tháy hử huùng Hê-rốt, do̱ Giô-sép lao, mí cảm mừ ti̱ nỉnh. Tọ slì đảy páo chang făn hăn, ké chứng thin mà búng Ga-li-lê, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />thưng ti̱ nỉnh dá, ké to̱ dú slẻng dảo hít Na-xa-rét, sle lình ính vàm đảy cạ quá kí cần páo cón, Min co̱i đảy dảo hít cần Na-xa-rét.<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Chang kí vằn nỉnh, Giăng Báp-tít mà páo cạ chang tu̱ng lẹng Giu-đê, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />cạ: “Lèo cho̱i xá, vi̱ thiin ti̱ tó thưng xảư.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Vi̱ nảy chăn chư̱ cần đảy Ê-sai, cần páo cón chảng thưng:</para>
  <para style="q1" vid="MAT 3:3">“Mì heng cần moòng cải chang tu̱ng lẹng:</para>
  <para style="q1" vid="MAT 3:3">‘Lèo fọn cón lo̱ cú Chảu,</para>
  <para style="q1" vid="MAT 3:3">lèo hít phiing kí tèo lo̱ Min.’”<verse eid="MAT 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Giăng nu̱ng slử hít tứ khuân lạc đà, lăng hảng slai năng, kin mèng hem xáu kin mèng thưưng. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Dá phang cần tứ slẻng Giê-ru-sa-lem, búng Giu-đê xáu kí búng xảư to̱i ta̱ Giô-đanh xày mà đủi ké, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />chíu hau nhă̱n xá làu, dá đảy ké hít báp-têm tảư ta̱ Giô-đanh. <verse eid="MAT 3:6" /><verse number="7" style="v" sid="MAT 3:7" />Chíu hăn lai cần Pha-ri-si xáu Sa-đu-sê mà nhă̱n báp-têm, Giăng cạ hau: “Lu̱c lan ngù too̱c nỉnh ới! Cần nàư páo hử kí cần ni̱ chắc sle le̱n ni khói xá fát fày ái thưng? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Pìn nỉnh, chứng lèo pìn mác ngám xáu slim cho̱i xá. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Kí ké mí đảy la̱i táng chảng đủi căn cạ: ‘Hung làu tó mì cúc chỏ Áp-ra-ham’. Vi̱ ngo̱ chảng hử pi̱ noọng chắc cạ Chảu Fạ nhằng hít pìn lu̱c lan Áp-ra-ham tứ kí ca̱o hin nảy đảy. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Ma̱c fủ đảy tặt tem cúc mạy dá, pìn nỉnh, hạy co haư mí pìn mác đay do̱ ngài bác lùng dá vẻng khảu fày. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Ngo̱ au nặm hít báp-têm hử pi̱ noọng cho̱i xá. Tọ Lạo mà lăng ngo̱, mì quỳn slèng quá ngo̱, ngo̱ mí ngám căm cài cú Min. Min co̱i hít báp-têm hử pi̱ noọng chang Chảu Khoăn xáu chang fày; <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />mừ cú Min căm ăn cào lình ính, Min cào slaư sla̱ng co̱n fa̱t khảu cú làu, dá hom khảu cú Min khảu xang. Tọ Min pung nhủng nháp chang fày bó đắp slắc pày đảy.”<verse eid="MAT 3:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Chíu nỉnh, Chảu Giê-xu tứ búng Ga-li-lê pay thưng ta̱ Giô-đanh, ti̱ cú Giăng, sle đảy ké hít báp-têm hử. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Tọ Giăng cứ oóc slèng tả làn Min, cạ: “Chăn ngo̱ chứng cẩn Chảu hít báp-têm hử, hít lăng Chảu te̱o mà đủi ngo̱?” <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />Chảu Giê-xu hòi vàm ké: “Cà nạy, cứ hít pìn nỉnh pay, vi̱ pìn nỉnh chứng chư̱ ngám sle hung làu hít nèm mọi lo̱ cung chính.” Dá Min sle ké hít. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />Chíu nỉnh, đảy báp-têm dá, Chảu Giê-xu ngám khửn khói nặm, nho̱m cà, kí tẳm fạ đảy khay oóc, Min hăn Chảu Khoăn cú Chảu Fạ cháng lùng xị nục cu, cháp tìng Min, <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />xáu nỉnh cà, mì heng tứ kí tẳm fạ chảng: “Nảy chăn chư̱ Lu̱c pèng điíp cú Ngo̱, slim Ngo̱ hun hỉ mà Lu̱c nỉnh.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Dá Chảu Giê-xu đảy Chảu Khoăn tái khảu tu̱ng lẹng, sle nhă̱n phi sla̱ láu. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Căm kin đảy slí slíp vằn, slí slíp că̱m dá, do̱ Min dác. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Phi sla̱ khảu xảư, dá chảng đủi Min: “Hạy ni̱ chăn chư̱ Lu̱c Chảu Fạ, do̱ cứ oóc lịnh hử kí ca̱o hin nảy pìn pẻng pay.” <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />Tọ Min hòi vàm: “Mì vàm slẻ cạ: ‘Tu cần te̱o đảy bó chư̱ tan pừng khảu pẻng đơ, tọ xày pừng khảu mọi vàm chảng oóc tứ pác Chảu Fạ.’” <verse eid="MAT 4:4" /><verse number="5" style="v" sid="MAT 4:5" />Dá phi sla̱ au Min khảu đưng slẻng thánh, hử Min dân tìng nhoo̱t pài lưừn slớ, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />dá cạ Min: “Hạy ni̱ chăn chư̱ Lu̱c Chảu Fạ, do̱ cứ pu̱ng làu lùng pay, vi̱ mì vàm đảy slẻ, cạ: ‘Chảu co̱i oóc lịng hử kí cần tang nả Min, Hau co̱i au mừ tài lu̱c, lao kha lu̱c te̱o toỏng khảu hin va̱.’”<verse eid="MAT 4:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Chảu Giê-xu cạ phi sla̱: “Xày mì vàm slẻ cạ: ‘Lu̱c mí đảy tỏ Chảu, chăn chư̱ Chảu Fạ lu̱c.’ ” <verse eid="MAT 4:7" /><verse number="8" style="v" sid="MAT 4:8" />Phi sla̱ te̱o au Min khửn nhoo̱t phja slung pày nưng num, dá hử Min hăn thuủn kí tum ti̱ tìng ti̱ da̱ xáu slu̱ng phjưức cú min. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Dá phi sla̱ chảng đủi Min: “Ngo̱ co̱i hử ni̱ thuủn mọi lo̱ nảy, hạy ni̱ củm lùng pái slớ ngo̱,” <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />Chíu nỉnh, Chảu Giê-xu cạ phi sla̱: “Sa-tan ới, thói pay! Vi̱ mì vàm slẻ: ‘Lu̱c lèo pái slớ Chảu chăn chư̱ Chảu Fạ cú lu̱c, xáu lu̱c tan cung ta̱i Min xày.’” <verse eid="MAT 4:10" /><verse number="11" style="v" sid="MAT 4:11" />Dá phi sla̱ tả Min pay, nỉnh cà, mì kí cần tang nả fạ mà cung ta̱i Min.<verse eid="MAT 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Chíu nỉnh, chắc đảy Giăng ngài cặp dá, Chảu Giê-xu chứng fan te̱o búng Ga-li-lê. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Chíu pja̱c khói Na-xa-rét dá, Min mà dú slẻng Ca-bê-na-um xảư cằn hải, chang ti̱ Sa-bu-lôn xáu Nép-ta-li, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />sle vàm cú cần páo vàm cạ quá Ê-sai đảy lình ính, cạ:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Tum Sa-bu-lôn xáu tum Nép-ta-li,</para>
  <para style="q1" vid="MAT 4:15">tèo lo̱ oóc hải, bưửng nỉnh ta̱ Giô-đanh,</para>
  <para style="q1" vid="MAT 4:15">búng Ga-li-lê cú cần cú tum ti̱ táng —<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />nòi cần nă̱ng chang ngàu đăm,</para>
  <para style="q1" vid="MAT 4:16">đảy hăn áng slu̱ng cải,</para>
  <para style="q1" vid="MAT 4:16">xáu kí cần nă̱ng chang tum ti̱ ngàu hai,</para>
  <para style="q1" vid="MAT 4:16">do̱ áng slu̱ng tó chíu tìng hau.”<verse eid="MAT 4:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Tứ chíu nỉnh, Chảu Giê-xu xo tàu páo cạ: “Lèo cho̱i xá, vi̱ thiin ti̱ tó thưng xảư.” <verse eid="MAT 4:17" /><verse number="18" style="v" sid="MAT 4:18" />Chíu pay to̱i cằn hải Ga-li-lê, Min hăn sloong pi̱ noọng Si-môn, đảy dảo hít Phi-e-rơ, xáu Anh-rê, noọng min, pjuúng khe tảư hải, vi̱ hau hít pjuúng khe. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Min cạ hau: “Pay nèm ngo̱, do̱ ngo̱ co̱i hít hử pi̱ noọng pìn kí cần tức khe cần.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Chích slì hau tả khe làu, pay nèm Min. <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />Pay íng nưng num, Min hăn sloong pi̱ noọng Gia-cơ xáu Giăng, lu̱c cú Xê-bê-đê phung khe dú chang lừ. Min dảo hau, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />sloong cần liìn tả lừ xáu pá làu, hau pay nèm Min.<verse eid="MAT 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Chảu Giê-xu pay to̱i búng Ga-li-lê, slon cạ chang kí lưừn ho̱i, páo oóc Vàm Đay mà thiin ti̱, xáu da đay hử mọi phú slưứng, mọi khảy chíp chang phang cần. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Hau tàm mà Min oóc thuủn to̱i ti̱ Sy-ri, dá hau au kí cần khảy màu, ngài lai thìng khảy chíp táng căn, ngài phi sla̱ to̱, bả mu, pại thưng hử Min, xáu Min da đay hử hau. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Phang cần đung pay nèm Min, tứ Ga-li-lê, Đê-ca-bô-lơ, Giê-ru-sa-lem, Giu-đê xáu bưửng nỉnh ta̱ Giô-đanh.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Chíu nho̱m hăn phang cần, Chảu Giê-xu pay khửn tìng phja, chíu Min nă̱ng lùng, kí cần nèm slon chứng mà xảư Min. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Min khay pác slon hau, cạ:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“Fúc hử kí cần khỏ chang slim khoăn,</para>
  <para style="q2" vid="MAT 5:3">vi̱ thiin ti̱ chăn chư̱ cú hau.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Fúc hử kí cần thán hảy,</para>
  <para style="q2" vid="MAT 5:4">vi̱ hau co̱i đảy an chi.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Fúc hử kí cần slìn tào,</para>
  <para style="q2" vid="MAT 5:5">vi̱ hau co̱i đảy táp tum.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Fúc hử kí cần dác xáu kháư kí lo̱ cung chính,</para>
  <para style="q2" vid="MAT 5:6">vi̱ slim hau co̱i đảy ím đo.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Fúc hử kí cần mì slim điíp sliít,</para>
  <para style="q2" vid="MAT 5:7">vi̱ hau co̱i đảy điíp sliít.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Fúc hử kí cần mì slim slaư tích,</para>
  <para style="q2" vid="MAT 5:8">vi̱ hau co̱i đảy hăn Chảu Fạ.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Fúc hử kí cần khen chang,</para>
  <para style="q2" vid="MAT 5:9">vi̱ hau co̱i đảy dảo hít kí lu̱c cú Chảu Fạ.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Fúc hử kí cần ngài hít khỏ vi̱ dú cung chính,</para>
  <para style="q2" vid="MAT 5:10">vi̱ thiin ti̱ chăn chư̱ cú hau.<verse eid="MAT 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 5:11" />Pi̱ noọng đảy fúc chíu ngài hau hít xảu nả, ngài hau hít ha̱i, ngài chảng mọi vàm la̱i xan tỉng te̱o vi̱ slay.<verse eid="MAT 5:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 5:12" />Cứ hun hỉ fằng fừ, vi̱ fă̱n slưởng cú pi̱ noọng cải lai dú tìng thiin ti̱, vi̱ hau xày hít khỏ kí cần páo cón, cón pi̱ noọng pìn nỉnh.<verse eid="MAT 5:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Pi̱ noọng xị cư cú tum. Tọ hạy cư túc kìm, do̱ hít lừ hử min kìm te̱o đảy? Tan ngài vẻng tả oóc noọc, ngài hau dă̱m tảư kha, do̱ min bó mì lăng đay num. <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />Pi̱ noọng xị áng slu̱ng cú ti̱ da̱. Ăn slẻng dú tìng phja, do̱ mí hít lăng ngài dà pay đảy. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Xày mí cần nàư tẻm tưng, te̱o tặt tảư ăn thủng, tọ lèo tặt tìng kha tưng, sle min xoi slu̱ng hử mọi cần đưng lưừn. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Xày pìn nỉnh, áng slu̱ng cú pi̱ noọng lèo xoi slu̱ng tói nả mọi cần, sle hau hăn kí lo̱ đay cú pi̱ noọng hít, dá că̱n Pá pi̱ noọng dú tìng thiin ti̱.<verse eid="MAT 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />mí đảy nẳm cạ ngo̱ thưng sle hít va̱i luật fáp do̱ va̱ kí vàm páo cón. Tọ ngo̱ thưng, mí chư̱ sle hít va̱i tọ sle hít hử xày xiìn. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Vi̱ chăn, ngo̱ cạ pi̱ noọng, thưng slì tum fạ nảy quá pay, do̱ mí chẳm haư, tiỉm haư chang luật fáp mí quá pay đảy, thưng slì mọi lo̱ đảy hít pìn. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Pìn nỉnh, hạy cần nàư tả vàm slon cạ sláy ta̱i ít chang kí vàm nảy dá te̱o slon hau hít nèm num, do̱ cần nỉnh co̱i ngài dảo sláy ta̱i ít chang thiin ti̱. Tọ cần nàư hít nèm dá te̱o slon hau num, do̱ co̱i đảy dảo cải chang thiin ti̱. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Vi̱ ngo̱ chảng đủi pi̱ noọng chắc cạ hạy pi̱ noọng mí kin dú cung chính quá kí slay slon luật xáu cần Pha-ri-si, do̱ pi̱ noọng co̱i mí khảu thiin ti̱ đảy.<verse eid="MAT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Pi̱ noọng tó ti̱ng vàm slon cạ hử cần ké cạ: ‘Mí đảy khả cần,’ hạy ‘Cần nàư khả cần do̱ lèo ngài ứn chá.’ <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Tọ ngo̱ chảng đủi pi̱ noọng cạ, mọi cần fát slính pi̱ noọng làu co̱i ngài ứn chá. Nhằng cần nàư cạ pi̱ noọng làu: ‘Tăn bả!’ do̱ ngài tái oóc tói nả kí cần ứn chá. Nhằng cần nàư đá: ‘Ngu̱ng!’ do̱ ngài fa̱t dú ti̱ ngục fày. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Hạy pi̱ noọng au cú cái pài tìng xoòng xằn, dá te̱o chứ thưng cần làu nhằng mì lăng mí đay đủi làu, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />do̱ cứ sle cú cái dú xoòng xằn dá pay hít đay đủi pi̱ noọng làu cón, dá co̱i mà pài cú cái. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />Chíu pi̱ noọng tò xày pay lo̱ đủi cần cáo làu, lèo khoái hít đay đủi cần nỉnh, lao cần nỉnh co̱i no̱p pi̱ noọng hử cần ứn chá, cần ứn chá co̱i chao hử cần pạư ngục, dá pi̱ noọng co̱i ngài xăng khảu ngục. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Chăn, ngo̱ cạ pi̱ noọng, pi̱ noọng co̱i mí oóc khói ti̱ xăng đảy thưng slì pi̱ noọng păng thuủn chèn.<verse eid="MAT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Pi̱ noọng đảy ti̱ng vàm nảy, vàm slon cạ: ‘Mí đảy fa̱m xá pay chụ.’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Tọ ngo̱ chảng hử pi̱ noọng chắc cạ, xắn cần nàư nho̱m cần ti̱ me̱ te̱o slém mu̱ng, do̱ chang slim làu tó fa̱m xá pay chụ đủi cần ti̱ me̱ dá. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Hạy ha bưửng sla cú pi̱ noọng hít hử fa̱m xá, lèo bói dá vẻng min pay quay! Vi̱ pi̱ noọng nhă̱n va̱i fă̱n đúc đang nưng, nhằng đay quá tằng đúc đang pi̱ noọng mí ngài khảu ngục fày. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Hạy mừ sla cú pi̱ noọng hít hử fa̱m xá, lèo bác dá vẻng min pay quay! Vi̱ pi̱ noọng, nhă̱n va̱i fă̱n đúc đang nưng ngài va̱i, nhằng đay quá tằng đúc đang pi̱ noọng mí ngài khảu ngục fày. <verse eid="MAT 5:30" /><verse number="31" style="v" sid="MAT 5:31" />Nhằng mì vàm slon cạ: ‘Cần nàư lư me̱, lèo hử slao chỉ hít chửng lư căn.’ <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Tọ ngo̱ chảng đủi pi̱ noọng cạ, cần nàư lư me̱, tọ mí chư̱ vi̱ pay chụ, do̱ hít hử me̱ pìn cần pay chụ. Xáu hạy cần nàư au cần ti̱ me̱ ngài lư, do̱ fa̱m xá pay chụ.<verse eid="MAT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Pi̱ noọng đảy ti̱ng vàm slon tứ cần ké chảng cạ: ‘Mí đảy chảng pjàng vàm pao xình, tọ lèo hít chăn xị vàm làu pao xình xáu Chảu.’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Tọ ngo̱ cạ pi̱ noọng, mí đảy pao xình lăng chạy, xày mí đảy chỉ fạ pao xình, vi̱ fạ chăn chư̱ tắng kim cú Chảu Fạ; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />mí đảy chỉ tum chảng pao xình, vi̱ tum hít ti̱ sle Min tẻm kha; mí đảy chỉ slẻng Giê-ru-sa-lem pao xình, vi̱ slẻng nỉnh cú Huùng cải. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Pi̱ noọng mí đảy chỉ khửn hu cú làu pao xình, vi̱ pi̱ noọng mí táng hít hử tèo phjâm pìn khao do̱ pìn đăm đảy. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Tọ, pi̱ noọng tan lèo chảng cạ: ‘Chư̱, do̱ chư̱’ do̱ va̱ ‘Mí, do̱ mí’. Nhằng au lo̱ lăng khảu num do̱ tứ phi xan oóc xày.<verse eid="MAT 5:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />Pi̱ noọng đảy ti̱ng mì vàm slon cạ: ‘Ha chảo ha, khẻo chảo khẻo.’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Tọ ngo̱ cạ pi̱ noọng, mí đảy tỉng te̱o cần too̱c éc. Tọ, hạy cần nàư táp khảu nả bưửng sla pi̱ noọng, do̱ cứ dèn tằng nả bưửng slại hử cần nỉnh. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Hạy cần nàư ái oóc ti̱ ứn chá cáo, sle au slử đưng cú pi̱ noọng, do̱ cứ sle cần nỉnh au tằng slử noọc. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Hạy cần nàư pắt pi̱ noọng pay ca̱o hin nưng, do̱ cứ pay đủi cần nỉnh sloong ca̱o hin. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Cần nàư tham xo pi̱ noọng, do̱ mí đảy váy nả khói cần ái dim làu.<verse eid="MAT 5:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />Pi̱ noọng đảy ti̱ng vàm slon cạ nảy: ‘Lèo điíp cần xảư xảng làu, xáu xằng cần tói tàu làu.’ <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Tọ ngo̱ cạ pi̱ noọng lèo điíp cần tói tàu làu xáu xỉnh chàu hử cần hít khỏ làu, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />sle pi̱ noọng đảy pìn lu̱c cú Pá làu dú tìng thiin ti̱. Vi̱ Min hít ha vằn khửn tìng cần too̱c éc xáu cần đay, dá Min pảo phân tìng cần cung chính xáu tằng cần dăm cung. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Vi̱ hạy pi̱ noọng tan điíp kí cần điíp làu, do̱ pi̱ noọng đảy lăng haư? Bó chư̱ kí cần slau slé xày hít pìn nỉnh do̱ lừ? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Hạy pi̱ noọng tan tỏn tuụng pi̱ noọng làu xày, do̱ pi̱ noọng mì lăng đay quá cần nàư haư? Bó chư̱ kí cần cú tum ti̱ táng xày hít pìn nỉnh do̱ lừ? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Pìn nỉnh, pi̱ noọng lèo pìn đay thuủn mọi lo̱, hút xị Pá pi̱ noọng dú thiin ti̱ đay thuủn mọi lo̱.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Lèo slỉu slim hít kí lo̱ cung chính, mí hít tói nả sle hau đảy hăn, tọ hạy mí chư̱ pìn nỉnh, do̱ cay pi̱ noọng bó đảy fă̱n slưởng lăng tứ Pá cú làu dú thiin ti̱. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />Pìn nỉnh, chíu pi̱ noọng slí hử, mí đảy páu pí lè tói nả làu xị kí cần pjàng mja̱p hít chang kí lưừn ho̱i xáu noo̱c kha lo̱, sle đảy hau că̱n. Chăn, ngo̱ cạ pi̱ noọng, hau tó đảy đo fă̱n slưởng cú hau dá. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Tọ, slì pi̱ noọng slí hử, mí đảy sle mừ slại chắc mừ sla làu hít lăng, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />sle kí lo̱ pi̱ noọng slí hử dú ti̱ khít lít; dá Pá cú pi̱ noọng, Lạo hăn chang ti̱ khít lít, co̱i pảo fă̱n slưởng hử pi̱ noọng.<verse eid="MAT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Chíu pi̱ noọng xỉnh chàu, do̱ mí đảy hít xị kí cần pjàng mja̱p, vi̱ hau ái xỉnh chàu chang kí lưừn ho̱i xáu ti̱ coóc háng sle mọi cần xày hăn. Chăn, ngo̱ cạ pi̱ noọng, hau tó đảy đo fă̱n slưởng cú làu dá. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Nhằng, chíu pi̱ noọng xỉnh chàu, cứ khảu đưng hó, hắp tu khảu, dá xỉnh chàu xáu Pá cú làu chang ti̱ khít lít, xáu Pá cú pi̱ noọng, Lạo hăn chang ti̱ khít lít, co̱i pảo fă̱n slưởng hử pi̱ noọng. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Chíu pi̱ noọng xỉnh chàu, mí đảy chảng pay chảng te̱o xị cần cú tum ti̱ táng; vi̱ hau la̱i cạ, xắn làu chảng lai do̱ co̱i đảy. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Pi̱ noọng mí đảy hít xị hau, vi̱ Pá pi̱ noọng tó chắc pi̱ noọng cẩn lăng chíu pi̱ noọng xằng xỉnh xo Min dá. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Pìn nỉnh, pi̱ noọng cứ xỉnh chàu pìn nảy:</para>
  <para style="q1" vid="MAT 6:9">‘Pái Pá hung lu̱c dú tìng thiin ti̱,</para>
  <para style="q2" vid="MAT 6:9">xo Mình Pá đảy tài slung.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Tum ti̱ cú Pá đảy thưng,</para>
  <para style="q2" vid="MAT 6:10">xo slim slưửng Pá đảy pìn,</para>
  <para style="q2" vid="MAT 6:10">dú tum xị dú tìng fạ.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Xo pảo hử hung lu̱c vằn nảy cú kin đo vằn;<verse eid="MAT 6:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 6:12" />xo sla phít xá hử hung lu̱c,</para>
  <para style="q2" vid="MAT 6:12">xị hung lu̱c tó sla hử kí cần mì phít xá đủi hung lu̱c;<verse eid="MAT 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 6:13" />xo mí đảy sle hung lu̱c ngài láu,</para>
  <para style="q2" vid="MAT 6:13">tọ cháu hung lu̱c khói cần too̱c éc.’<verse eid="MAT 6:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Vi̱ hạy pi̱ noọng sla phít xá hử hau, do̱ Pá pi̱ noọng dú tìng thiin ti̱ xày co̱i sla dưư̱ng hử pi̱ noọng. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Tọ hạy pi̱ noọng mí sla phít xá hử hau, do̱ Pá pi̱ noọng xày co̱i mí sla phít xá hử pi̱ noọng.<verse eid="MAT 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Chíu pi̱ noọng căm kin, mí đảy hít nả xàu bứ xị kí cần pjàng mja̱p, vi̱ hau hít ha nả múc slủm sle mọi cần chắc làu căm kin. Chăn, ngo̱ cạ pi̱ noọng, hau tó nhă̱n đảy đo fă̱n slưởng cú làu dá. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Tọ, slì pi̱ noọng căm kin, cứ ma̱t dù khửn hu xáu slào nả làu, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />sle mọi cần mí chắc pi̱ noọng căm kin, tọ tan Pá pi̱ noọng dú ti̱ khít lít, chư̱ Lạo chắc thuủn mọi lo̱ chang ti̱ khít lít, co̱i slưởng hử pi̱ noọng.<verse eid="MAT 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Mí đảy hom hử làu kí cú cái dú tảư tum, chư̱ ti̱ mì mèng mảu, ngài ngừn hít va̱i, ti̱ ò lặc khảu kin lặc. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Tọ lèo hom cú cái dú tìng fạ, ti̱ nỉnh bó mì mèng mảu, bó ngài niỉng hít va̱i, xày mí mì ò lặc khảu kin lặc đảy. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Vi̱ cú cái cú pi̱ noọng dú càư, do̱ slim pi̱ noọng xày dú nỉnh. <verse eid="MAT 6:21" /><verse number="22" style="v" sid="MAT 6:22" />Ha xị tưng cú đúc đang. Hạy ha pi̱ noọng đay do̱ tằng đúc đang pi̱ noọng co̱i tim áng slu̱ng. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Tọ hạy ha pi̱ noọng pìn xảu, do̱ tằng đúc đang pi̱ noọng co̱i ngài ngàu đăm. Pìn nỉnh, hạy áng slu̱ng chang pi̱ noọng pìn ngàu đăm, do̱ ngàu đăm nỉnh chăn cải lai! <verse eid="MAT 6:23" /><verse number="24" style="v" sid="MAT 6:24" />Mí cần nàư cung ta̱i sloong chảu đảy; vi̱ co̱i xằng chảu nảy tọ điíp chảu nỉnh, do̱ va̱ thuủn slim đủi chảu nảy tọ ngòi che̱n chảu nỉnh. Pi̱ noọng mí di̱ cung ta̱i Chảu Fạ te̱o di̱ cung ta̱i ngừn chèn đảy. <verse eid="MAT 6:24" /><verse number="25" style="v" sid="MAT 6:25" />Pìn nỉnh, ngo̱ cạ pi̱ noọng: mí đảy dau mi̱ng làu te̱o lèo kin ăn lăng, mí đảy dau hử đúc đang làu lèo nu̱ng lăng. Bó chư̱ mi̱ng te̱o nhằng pèng quá cú kin, đúc đang, slử khóa do̱ lừ? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Cứ ngòi chủng nục fạ: mí ván, mí cùn, mí hom cú cái khảu xang, tọ Pá pi̱ noọng tìng fạ nhằng chưựng boong min. Pi̱ noọng te̱o bó pèng quá chủng nục do̱ lừ? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Te̱o cạ, mì cần nàư chang pi̱ noọng dau hí te̱o hít hử tơ̱i làu lì pjặp ha nưng num mí? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />Pi̱ noọng dau mà slử khóa hí hít lăng? Cứ nho̱m ngòi kí bjoóc noo̱c tu̱ng, min buút khửn pìn lừ. Boong min bó hít cung nắc khỏ, xày mí lèo kẻo may. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Tọ ngo̱ cạ pi̱ noọng, ma̱i cạ huùng Sa-lô-môn slu̱ng phjưức thưng haư, xày mí đảy nu̱ng đay xị bjoóc nưng chang kí bjoóc nảy. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Hạy Chảu Fạ nhằng hử kí bjoóc noọc tu̱ng nu̱ng đay pìn nỉnh, hạy kí lo̱ vằn nảy te̱o, vằn chục ngài vẻng khảu coong fày, do̱ kí cần nọi slim slấn nỉnh ới, Min bó hít đảy hẳm lai quá do̱ lừ? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Pìn nỉnh, pi̱ noọng mí đảy dau hí te̱o chảng cạ: ‘Hung làu co̱i kin lăng?’ do̱ va̱ ‘Kin ca lăng?’ do̱ va̱ ‘Hung làu nu̱ng lăng?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Vi̱ thuủn kí lo̱ nảy, kí cần cú tum ti̱ táng xày xa thắp; xáu Pá pi̱ noọng dú tìng fạ tó chắc pi̱ noọng cẩn mọi lo̱ nỉnh dá. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Tọ ta̱i tàu, lèo xa thắp tum ti̱ Chảu Fạ xáu lo̱ cung chính cú Min, do̱ mọi lo̱ nỉnh co̱i đảy pảo hử pi̱ noọng num. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Pìn nỉnh, pi̱ noọng mí đảy dau mà vằn chục; vi̱ vằn chục co̱i táng dau hử vằn chục. Khỏ nhọc cú vằn haư đo hử vằn nỉnh.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Mí đảy ứn chá, sle pi̱ noọng mí ngài ứn chá. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Vi̱ hạy pi̱ noọng ứn chá, do̱ pi̱ noọng xày ngài ứn chá, pi̱ noọng to hử hau thưng haư, do̱ pi̱ noọng xày co̱i ngài to te̱o tùng nỉnh. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Hít lừ pi̱ noọng hăn tèo lịn đưng ha pi̱ noọng làu, te̱o mí hăn khỏ mạy chang ha làu? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Hít lừ ni̱ cạ pi̱ noọng làu pìn nảy: ‘Sle ngo̱ au tèo lịn oóc khói ha ni̱,’ tọ khỏ mạy di̱ nhằng dú chang ha làu cà? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Ne̱ cần pjàng mja̱p nỉnh ới! Ta̱i tàu, lèo au khỏ mạy khói ha làu pay, dá chứng hăn khan sle au tèo lịn khói ha pi̱ noọng làu đảy. <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />Pi̱ noọng mí đảy hử ma kí cú cái thánh cú làu tói nả, mí đảy vẻng hin pảo hử xá mu. Lao boong min te̱o ta̱p kí thìng nỉnh tảư kha, dá váy quá khấp xẻ pi̱ noọng oóc pìn kép va̱.<verse eid="MAT 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Cứ xo, do̱ pi̱ noọng co̱i đảy. Cứ thắp, pi̱ noọng co̱i phúng. Cứ hói tu, do̱ tu co̱i khay oóc hử pi̱ noọng. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Vi̱ xắn cần nàư xo do̱ đảy; cần nàư xa do̱ phúng; xáu tu co̱i đảy khay hử cần hói. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Mì cần nàư chang pi̱ noọng, hạy lu̱c làu xo pẻng — te̱o hử tu lu̱c hin mí? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Do̱ va̱ tu lu̱c xo pja — te̱o hử min ngù mí? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Pìn nỉnh, hạy pi̱ noọng tó chư̱ cần xảu, nhằng chắc hử lu̱c làu kí thìng đay, do̱ Pá pi̱ noọng dú tìng thiin ti̱ te̱o mí pảo hử kí thìng đay hử cần xo Min do̱ lừ? <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Pìn nỉnh, hạy pi̱ noọng mu̱ng hau hít lăng hử làu, do̱ pi̱ noọng lèo hít pìn nỉnh hử hau, vi̱ pìn nỉnh chứng chư̱ luật fáp xáu vàm páo cón.<verse eid="MAT 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Lèo khảu tu cặp. Vi̱ tu quảng xáu lo̱ cải tái thưng khả chii̱t, xáu mì lai cần khảu nỉnh. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Nhằng tu cặp xáu lo̱ sláy, tái thưng lo̱ te̱o, tọ mì nọi cần xa hăn đảy.<verse eid="MAT 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Lèo slỉu slim kí cần chá páo cón, chư̱ kí cần nu̱ng slử chiin mà xáu pi̱ noọng, tọ bưửng đưng slim xị ma này chi̱n khấp xẻ. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Pi̱ noọng nhă̱n chắc pừng khảu bjoóc mác cú hau. Mì cần nàư íp mác ít ti̱ pá nam, do̱ va̱ mác ngo̱a ti̱ pá nam slắc pày mí? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Pìn nỉnh, hạy co đay, do̱ pìn mác đay; nhằng co too̱c do̱ pìn mác too̱c. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Co đay co̱i mí pìn mác too̱c đảy, nhằng co too̱c xày mí pìn mác đay đảy. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Co haư mí pìn mác đay, do̱ ngài bác dá vẻng khảu fày. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Pìn nỉnh, nho̱m khảu bjoóc mác, pi̱ noọng co̱i nhă̱n chắc hau tứ mác cú hau. <verse eid="MAT 7:20" /><verse number="21" style="v" sid="MAT 7:21" />Mí chư̱ cần nàư chảng đủi ngo̱: ‘Pái Chảu, pái Chảu’, do̱ đảy khảu thiin ti̱ đơ, tọ tan cần nàư hít nèm ý cú Pá ngo̱ dú tìng thiin ti̱ xày. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Khảu vằn nỉnh, lai cần co̱i dăng ngo̱: ‘Pái Chảu, pái Chảu, bó chư̱ hung lu̱c au mình Chảu pay páo cón, au mình Chảu te̱p phi sla̱, au mình Chảu hít lai lo̱ quỳn slèng do̱ lừ?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Chíu nỉnh, ngo̱ co̱i chảng khát sla̱t xáu hau cạ: ‘Ngo̱ bó chắc pi̱ noọng slắc pày! Ne̱ kí cần hít slại ới, thói oóc khói Ngo̱ pay!’<verse eid="MAT 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Pìn nỉnh, cần nàư ti̱ng vàm ngo̱ chảng nảy, xáu hít nèm, do̱ hút xị cần quai kí, xáy lưừn làu tìng khảng hin. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Phân lùng, nặm noòng mà, lầm pa̱o cải khảu lưừn nỉnh xày mí túm lùng, vi̱ tó đảy xáy tìng khảng hin. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Mọi cần ti̱ng vàm ngo̱ chảng nảy, tọ mí hít nèm, do̱ hút xị cần tăn bả, xáy lưừn tìng slài. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Fạ phân lùng, nặm noòng mà, lầm pa̱o cải tu̱p khảu, do̱ lưừn nỉnh co̱i tấm lùng, va̱i nắc lai.”<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Chíu Chảu Giê-xu slon cạ kí vàm nảy dá, phang cần he mà vàm slon cạ cú Min, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />vi̱ Min slon hau mì quỳn, mí chư̱ hút xị kí slay slon luật cú hau.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Chíu Chảu Giê-xu tứ tìng phja lùng, kí phang cần đung lai pay nèm Min. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Nho̱m cà, mì cần hảu nưng mà qu̱y tói nả Min xáu dăng: “Pái Chảu, hạy Chảu ái, Chảu mì quỳn hít ngo̱ đảy slaư.” <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Chảu Giê-xu dàu mừ oóc, tu̱ng khảu cần nỉnh, dá cạ: “Ngo̱ ái. Slaư pay.” Chích slì, cần nỉnh đảy slào slaư hảu. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Chảu Giê-xu slắng cần nỉnh: “Lèo vẳn chằn, mí đảy chảng đủi cần nàư, tọ cứ pay chảng đủi slay pài xoòng xáu pài cú cái Môi-se tó slon cạ, xị vàm chửng hử hau.”<verse eid="MAT 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Chíu nỉnh, Chảu Giê-xu khảu slẻng Ca-bê-na-um, mì cần căm tàu pan lỉnh thưng, na̱i xo Min <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />cạ: “Chảu ới, cần khỏi cú lại ngài pại, nòn mu̱i dú lưừn, chíp đát lai.” <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Chảu Giê-xu cạ ké: “Ngo̱ co̱i pay, da đay pi̱ng hử min.” <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Cần căm tàu pan lỉnh dăng: “Pái Chảu, lại mí ngám sle tỏn Chảu khảu lưừn, tọ xo Chảu cạ vàm nưng, do̱ cần khỏi cú lại co̱i đảy đay. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Vi̱ lại dú tảư quỳn hau, xày mì pan lỉnh tảư quỳn lại. Lại cạ cần nảy: ‘Pay pay!’ do̱ min pay, cạ cần táng: ‘Mà nảy!’ do̱ min mà, xáu cạ cần khỏi cú lại: ‘Hít cung sla̱y nảy,’ do̱ min hít.” <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Ti̱ng pìn nỉnh, Chảu Giê-xu hăn he dá cạ xáu kí cần pay nèm Min: “Chăn, ngo̱ cạ pi̱ noọng, ngo̱ xằng hăn slắc cần mì slim slấn cải pìn nảy tứ chang cần Y-sơ-ra-ên. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Tọ, ngo̱ cạ pi̱ noọng chắc co̱i mì lai cần tứ bưửng tung, slay fuung mà nă̱ng kin đủi Áp-ra-ham, Y-sác, xáu Gia-cốp chang thiin ti̱. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Tọ kí lu̱c cú thiin ti̱ te̱o ngài vẻng khảu ti̱ đăm khít bưửng noo̱c, ti̱ co̱i mì thán hảy xáu cắt fằn.” <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Dá Chảu Giê-xu cạ cần căm tàu pan lỉnh: “Cứ pay pay! Xị ni̱ slấn pìn lừ, do̱ co̱i đảy hít pìn nỉnh.” Chăn tiỉm nỉnh, cần khỏi đảy đay.<verse eid="MAT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Lăng nỉnh, Chảu Giê-xu khảu lưừn Phi-e-rơ, Min hăn me̱ da̱ ké ngài fát, nòn tìng slàng. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Min tu̱ng khảu mừ da̱, xá fát oóc khói da̱; dá da̱ tấn dân cung ta̱i Min. <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />Thưng đăm, hau au mà hử Min lai cần ngài phi sla̱ to̱, Min au vàm chảng sle te̱p phi sla̱ oóc xáu da đay hử mọi cần khảy chíp, <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Sle vàm páo cón cú Ê-sai đảy lình ính: “Chăn Min tó háp au phú slưứng cú hung làu, xáu háp thuủn khảy chíp cú hung làu.”<verse eid="MAT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Chíu hăn phang cần dú xảư làu, Chảu Giê-xu oóc lịng pay quá cằn hải bưửng nỉnh. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Slay slon luật nưng thưng xảư chảng xáu Min cạ: “Slay ới, Slay pay haư, lại co̱i pay nèm.” <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Chảu Giê-xu hòi vàm ké: “Tu hin mì thẳm, tu nục fạ mì lằng, tọ Lu̱c Cú Cần mí mì ti̱ sle tặt hu.” <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />Dá mì cần nèm slon táng nưng te̱o chảng xáu Min: “Pái Chảu, xo hử ngo̱ mừ phăng pá ngo̱ cón.” <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Tọ Chảu Giê-xu hòi vàm: “Cứ pay nèm ngo̱, sle cần hai phăng cần hai cú hau.”<verse eid="MAT 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Chảu Giê-xu khảu lừ, kí cần nèm slon pay nèm Min. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Nho̱m cà, mì xá lầm cải pặt khửn tìng hải, thưng slặn nặm noòng fựt khảu lừ. Tọ Min nhằng nòn. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Kí cần nèm slon khảu xảư, pjúc Min tấn cạ: “Chảu ới, xo cháu hung làu pay! Hung làu ái hai dá lố!” <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />Min cạ hau: “Kỉ cần nọi slim slấn nỉnh ới, hít lừ pi̱ noọng lao?” Dá Min chứng tấn dân, quáy lầm xáu hải, do̱ min xày ti̱ng xích. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />Kí cần nèm slon he lai, tham cạ: “Cần nảy pìn lừ te̱o hít tằng lầm xáu hải ti̱ng vàm min?”<verse eid="MAT 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Chíu Min quá cằn bưửng nỉnh, thưng tum ti̱ cần Ga-đa-ra, sloong cần ngài phi sla̱ to̱ tứ kí ti̱ fằn oóc pay phúng Min, boong min xan lai, thưng slặn mí cần nàư cảm pay quá lo̱ nỉnh. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Nho̱m cà, kí phi sla̱ moòng khửn, cạ: “Pái Lu̱c Chảu Fạ, hung ngo̱ quén sla̱y lăng thưng Chảu? Chư̱ Chảu mà nảy sle hít khỏ hung ngo̱ cón slì ha̱n mí?” <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />Chíu nỉnh, mì xá mu đung lai kin, mí kỉ lai quay xáu hau. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Kí phi sla̱ na̱i xo Chảu Giê-xu cạ: “Hạy Chảu te̱p hung ngo̱ oóc, do̱ xo hử hung ngo̱ dắp khảu xá mu nỉnh.” <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Min cạ: “Oóc pay!” Kí phi sla̱ chứng oóc khói dá dắp khảu xá mu; nho̱m cà, tằng xá mu tứ pàn lính pu̱ng lùng hải, hai dăm thuủn tảư nặm. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Chíu nỉnh, kí cần khuân mu le̱n ni, mừ thưng slẻng, hau li̱n te̱o mọi lo̱, tằng lo̱ mì oóc hử sloong cần ngài phi sla̱ to̱. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Tằng slẻng kẻo căn oóc pay sle phúng Chảu Giê-xu. Chíu ngám hăn Min, do̱ na̱i xo Min pay khói ti̱ cú hau.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Chảu Giê-xu khảu lừ, Min khảm hải fan mừ slẻng làu. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Hau au mà hử Min cần pại mu̱i nưng nòn tìng phục. Chảu Giê-xu hăn slim slấn cú hau, do̱ chảng đủi cần pại mu̱i: “Lu̱c ới, cứ mắn slim. Phít xá cú lu̱c tó đảy sla dá.” <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />Chíu nỉnh, mì kỉ slay slon luật chảng đủi căn cạ: “Cần nảy chảng fa̱m.” <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />Chảu Giê-xu chắc hau nẳm lăng chứng cạ: “Kí ké nẳm xảu chang slim sle hít lăng? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Chảng pìn lừ do̱ hẳm nga̱i: ‘Kí phít xá cú lu̱c tó đảy sla,’ do̱ va̱ chảng ‘Cứ tấn dân dá phjải pay’? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Tọ, sle kí ké chắc cạ Lu̱c Cú Cần mì quỳn dú ti̱ da̱ sla xá …” chíu nỉnh, Min te̱o cạ xáu cần pại mu̱i: “Cứ tấn dân, quỷn phục khửn, dá pay mừ lưừn làu.” <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Cần pại mu̱i tấn dân dá pay mừ lưừn làu. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Hăn pìn nỉnh, phang cần xày lao dan, dá tài slung Chảu Fạ, vi̱ tó pảo hử tu cần đảy quỳn slèng pìn nỉnh. <verse eid="MAT 9:8" /><verse number="9" style="v" sid="MAT 9:9" />Tứ ti̱ nỉnh pay, Chảu Giê-xu nho̱m hăn cần nưng mìng hít Ma-thi-ơ nă̱ng dú ti̱ slau slé. Min cạ ké: “Pay nèm ngo̱.” Ké chứng tấn dân, pay nèm Min.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Chíu Min nă̱ng kin đưng lưừn, do̱ mì lai cần slau slé xáu cần phít xá mà nă̱ng khảu xoòng kin đủi Chảu Giê-xu xày kí cần nèm slon Min. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Hăn pìn nỉnh, cần Pha-ri-si chảng đủi kí cần nèm slon Min: “Hít lăng slay kí cần ni̱ te̱o kin tò xày cần slau slé xáu kí cần phít xá?” <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />Ti̱ng pìn nỉnh, Chảu Giê-xu cạ: “Cần slèng mí cẩn thưng slay nhả, tọ cần khảy màu. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Pay khói dá,, lèo slon hử slụ vàm nảy: ‘Ngo̱ ái slim điíp sliít tó mí chư̱ sleng lình.’ Vi̱ mí chư̱ ngo̱ mà sle dảo cần cung chính, tọ dảo cần phít xá.”<verse eid="MAT 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Chíu nỉnh kí cần nèm slon cú Giăng mà xảư, tham Chảu Giê-xu: “Hít lăng hung ngo̱ xáu cần Pha-ri-si slưừng slì căm kin, nhằng kí cần nèm slon cú slay do̱ mí căm kin?” <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />Chảu Giê-xu hòi vàm hau: “Mì pàng dạu haư dú sli̱c lảu te̱o slim xàu chíu po̱ khưi nhằng dú đủi hau mí? Tọ thưng vằn po̱ khưi đảy au pay khói hau, do̱ chíu nỉnh hau chứng căm kin. <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />Mí cần nàư phung kép phải máư khảu slử cáu, vi̱ kép phung máư co̱i hít khát slử cáu, ti̱ khát te̱o khát quạc num. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Xày mí mì cần nàư đíng lảu máư khảu pình năng cáu. Hạy hít pìn nỉnh, pình co̱i phéc, lảu lay oóc, xáu pình ngài va̱i. Tọ hau đíng lảu máư khảu pình năng máư, sle tằng sloong đảy nhằng.”<verse eid="MAT 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Chíu Chảu Giê-xu nhằng chảng kí vàm nảy đủi hau, do̱ mì cần căm tàu lưừn ho̱i thưng, qu̱y kháu tói nả Min, na̱i xo: “Lu̱c slao lại ngám hai, tọ xo slay pay tặt mừ tìng tu lan, do̱ min co̱i te̱o.” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Chảu Giê-xu tấn dân, xáu kí cần nèm slon Min pay nèm cần nỉnh. <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />Chíu nỉnh, mì cần ti̱ me̱ ngài lưư̱t lài lùng lai tó slíp nhi̱ pi, mà bưửng lăng tu̱ng khảu tin slử Min, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Vi̱ da̱ táng nẳm cạ: “Hạy làu tan tu̱ng đảy khảu slử Min xày, do̱ làu co̱i đảy đay lố.” <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Chảu Giê-xu váy te̱o, hăn da̱ chứng cạ: “Lu̱c slao ới, cứ mắn slim, slim slấn cú lu̱c tó da đay lu̱c dá.” Chăn tứ tiỉm nỉnh, cần ti̱ me̱ nảy đảy đay pi̱ng. <verse eid="MAT 9:22" /><verse number="23" style="v" sid="MAT 9:23" />Chảu Giê-xu khảu lưừn cần căm tàu lưừn ho̱i, hăn kí cần páu pí lè xáu pan đung hít lặc la̱y, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />cạ: “Thói pay, vi̱ tu lan nảy mí chư̱ hai đơ, tọ min nòn xày.” Hau chứng khu slủm Min. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Chíu pan đung ngài te̱p oóc noọc dá, Min phjải khảu, căm mừ tu đích, do̱ min táng nă̱ng khửn. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Kí lo̱ nảy đảy li̱n oóc to̱i ti̱ nỉnh.<verse eid="MAT 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Chíu Chảu Giê-xu pja̱c ti̱ nỉnh pay, mì sloong cần bót pay nèm Min, moòng cải cạ: “Pái Lu̱c huùng Đa-vít, xo điíp sliít hung ngo̱!” <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />Chíu khảu đưng lưừn dá, sloong cần bót mà xảư Min. Chảu Giê-xu chảng đủi hau: “Chư̱ pi̱ noọng slấn ngo̱ hít đảy kí lo̱ nỉnh mí?” Hau dăng Min: “Chư̱, Chảu ới.” <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Min tu̱ng khảu ha hau, cạ: “Pi̱ noọng slấn pìn lừ, do̱ co̱i mì oóc pìn nỉnh.” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Ha hau đảy khay oóc. Chảu Giê-xu quáy hau: “Lèo slỉu slim, pi̱ noọng mí đảy hử cần nàư chắc hả.” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Tọ hau oóc pay, tàm kí lo̱ nỉnh to̱i ti̱.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Chíu pay khói ti̱ nỉnh, hau au mà hử Min cần nưng ngài phi vặp to̱. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Phi sla̱ ngài te̱p oóc, dá cần vặp chảng đảy, pan cần he lai, chứng chảng cạ: “Xằng hăn pìn nảy quá dú Y-sơ-ra-ên slắc pày!” <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />Tọ, kí cần Pha-ri-si te̱o cạ: “Ké nảy pừng khảu chảu phi sla̱ sle te̱p phi sla̱.”<verse eid="MAT 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Chảu Giê-xu pay to̱i kí slẻng, kí bản, slon cạ chang kí lưừn ho̱i cú phang cần, páo oóc Vàm Đay mà thiin ti̱ xáu da đay mọi dưư̱ng khảy chíp. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Chíu hăn kí phang cần đung lai. Min slim điíp sliít tháy hau, vi̱ hau ngài mủ xáu slán slác xị chiin mí mì cần hen. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Min cạ kí cần nèm slon: “Khảu do̱ đảy lai, tọ cần tan khảu do̱ nọi. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Pìn nỉnh, cứ xỉnh xo Chảu mù cùn xoi cần cùn khảu chang mù cùn cú Min.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Chảu Giê-xu dảo slíp nhi̱ cần nèm slon thưng, Min pảo quỳn sle hau te̱p đảy kí slẳm khoăn, xáu da đay mọi phú slưứng, khảy màu. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Mìng cú slíp nhi̱ cần đảy Chảu xoi pay pìn nảy: Ta̱i tàu, Si-môn (đảy dảo hít Phi-e-rơ), xáu Anh-rê, noọng báo min. Gia-cơ, lu̱c cú Xê-bê-đê, xáu Giăng, noọng báo min; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Phi-líp xáu Ba-thê-lê-my; Thô-ma xáu Ma-thi-ơ, sloong cần slau slé; Gia-cơ lu̱c cú A-phê, xáu Tha-đê; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Si-môn Xê-lốt, xáu Giu-đa Ích-ca-ri-ốt, xày chư̱ cần fản Min.<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Chảu Giê-xu xoi slíp nhi̱ cần nảy pay xáu slắng cạ hau: “Dá xảy pay lo̱ cú ti̱ cần cú tum ti̱ táng, xáu mí đảy khảu đưng slẻng cú cần Sa-ma-ri. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Tọ cứ pay thưng ti̱ kí tu chiin túc cú lưừn Y-sơ-ra-ên do̱ hẳm đay. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Chíu nỉnh, to̱i lo̱ pay, pi̱ noọng lèo páo cạ: ‘Thiin ti̱ mà xảư dá.’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Cứ da đay hử cần khảy chíp, hít cần hai hòi te̱o, hít slaư cần hảu, xáu te̱p kí phi sla̱. Pi̱ noọng tó nhă̱n đai, do̱ lèo hử đai. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Mí đảy dò kim, ngừn, do̱ va̱ chèn chang tảy chèn hảng lăng cú pi̱ noọng, <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />pay lo̱ xày mí đảy au ta̱y ngàm, do̱ va̱ sloong slử, do̱ va̱ cài, do̱ va̱ tèo tạu, vi̱ cần hít cung ngám sle đảy cú kin. <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />Nhằng chíu pi̱ noọng khảu slẻng haư do̱ va̱ bản haư, lèo tham ngòi dú nảy cần nàư ngám, dá cứ dú nỉnh thưng slì haư pi̱ noọng pay. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Xắn khảu đưng lưừn haư, cứ pảo pình an hử lưừn nỉnh. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />hạy lưừn nỉnh ngám, do̱ pình an cú pi̱ noọng co̱i dú nỉnh; hạy lưừn nỉnh mí ngám, do̱ pình an cú pi̱ noọng lèo đảy fan mừ đủi pi̱ noọng. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Hạy cần nàư mí chiíp, do̱ va̱ mí ti̱ng vàm pi̱ noọng, do̱ slì pay khói lưừn do̱ va̱ slẻng nỉnh, cứ phu mư̱n tảư kha pi̱ noọng. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Chăn, ngo̱ cạ pi̱ noọng, thưng vằn ứn chá, ti̱ Sô-đôm xáu Gô-mô-rơ co̱i bau quá slẻng nỉnh.<verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Ne̱, ngo̱ xoi pi̱ noọng pay xị tu chiin dú chang xá ma này, pìn nỉnh, lèo quai kí xị ngù, xáu slìn tào xị nục cu. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Lèo slỉu slim xáu cần tơ̱i nảy, vi̱ hau co̱i no̱p pi̱ noọng hử kí cần ứn chá dá hau cọn càn pi̱ noọng chang lưừn ho̱i; <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />dá pi̱ noọng co̱i ngài tái thưng tói nả kí quan cải xáu kí huùng mà ngo̱, sle hít chửng hử hau xáu hít chửng hử kí cần cú tum ti̱ táng. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Tọ chíu hau no̱p pi̱ noọng, mí đảy dau lèo chảng pìn lừ, do̱ va̱ lèo chảng lăng, vi̱ khảu chăn tiỉm nỉnh, pi̱ noọng co̱i đảy hử chắc. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Vi̱ mí chư̱ pi̱ noọng táng chảng đơ, tọ Chảu Khoăn cú Pá pi̱ noọng co̱i chảng quá pi̱ noọng. <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />Pi̱ co̱i no̱p noọng khảu ti̱ hai, pá do̱ no̱p lu̱c, lu̱c co̱i tấn khửn tỉng te̱o pá mé, hít hử hau lèo hai. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Pi̱ noọng co̱i ngài mọi cần xằng pè vi̱ mình ngo̱, tọ cần tảy đảy thưng sloót hang, do̱ cần nỉnh co̱i đảy cháu. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Hạy hau hít ha̱i pi̱ noọng dú slẻng nảy, lèo ni quá slẻng táng; vi̱ chăn, ngo̱ cạ pi̱ noọng, pi̱ noọng mí pay thuủn kí slẻng cú Y-sơ-ra-ên, thưng chíu Lu̱c Cú Cần tó thưng dá.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Cần nèm slon do̱ mí quá slay, cần khỏi xày mí quá chảu làu. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Cần nèm slon hít lừ sle đảy xị slay, cần khỏi đảy xị chảu, do̱ đo dá. Hạy hau dảo chảu lưừn hít Bê-ên-xê-bun, te̱o cạ cần lưừn cú chảu nhằng xảu tọ haư! <verse eid="MAT 10:25" /><verse number="26" style="v" sid="MAT 10:26" />Pìn nỉnh, mí đảy lao hau; vi̱ bó mì lo̱ lăng ngài dà quá te̱o bó lèo dẻng oóc; ngài dăm dò te̱o mí đảy chắc. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Kí lo̱ ngo̱ cạ xáu pi̱ noọng ti̱ lặm đăm nảy, lèo páo oóc noo̱c áng slu̱ng; kí lo̱ pi̱ noọng ti̱ng dú pạng xu, lèo páo oóc tìng pài lưừn. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Mí đảy lao kí cần khả đảy đúc đang te̱o mí khả đảy slim khoăn. Tọ nhă̱n lao Lạo khả chii̱t đảy tằng khoăn mi̱ng xăm đúc đang chang ngục fày do̱ hẳm đay. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Bó chư̱ sloong tu nục choóc tan khai đảy mưn nưng do̱ lừ? Tọ, bó mì tu càư lút lùng tum hạy Pá pi̱ noọng mí slưửng pìn nỉnh. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Tằng cạ phjâm tìng hu pi̱ noọng tó đảy án thuủn dá. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Pìn nỉnh, mí đảy lao, vi̱ pi̱ noọng pèng hẳm lai quá kí tu nục choóc. <verse eid="MAT 10:31" /><verse number="32" style="v" sid="MAT 10:32" />Pìn nỉnh do̱, xắn cần nàư nhă̱n ngo̱ tói nả mọi cần, do̱ ngo̱ xày co̱i nhă̱n cần nỉnh tói nả Pá ngo̱ dú thiin ti̱. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Nhằng cần nàư thoi ngài ngo̱ tói nả mọi cần, do̱ ngo̱ xày co̱i thoi ngài cần nỉnh tói nả Pá ngo̱ dú tìng thiin ti̱.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Dá la̱i ngo̱ mà sle pình an hử ti̱ da̱. Ngo̱ mí chư̱ thưng sle hử pình an, tọ pảng dáng. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Ngo̱ mà sle hít lu̱c báo tỉng te̱o pá làu, lu̱c slao tỉng te̱o mé làu, me̱ lù tỉng te̱o me̱ da̱ làu; <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />cần tói tàu hau te̱o pìn cần lưừn cú hau. <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />Cần nàư điíp pá do̱ va̱ mé quá ngo̱, do̱ mí ngám xáu ngo̱; cần nàư điíp lu̱c báo do̱ va̱ lu̱c slao quá ngo̱, do̱ xày mí ngám hử ngo̱. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Cần nàư mí béc mạy các khoáy làu pay nèm ngo̱, do̱ bó ngám hử ngo̱. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Cần nàư xa mi̱ng te̱o làu do̱ co̱i túc; nhằng cần nàư vi̱ ngo̱ te̱o túc mi̱ng làu do̱ co̱i xa đảy. <verse eid="MAT 10:39" /><verse number="40" style="v" sid="MAT 10:40" />Cần nàư chiíp tỏn pi̱ noọng chăn chư̱ chiíp ngo̱; cần nàư chiíp ngo̱ chăn chư̱ chiíp Lạo tó xoi ngo̱.<verse eid="MAT 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 10:41" />Cần nàư chiíp tỏn cần páo cón nưng, vi̱ cần nỉnh chư̱ cần páo vàm Chảu, do̱ co̱i đảy nhă̱n fă̱n slưởng cú cần páo cón; cần nàư chiíp cần cung chính nưng, vi̱ nỉnh chư̱ cần cung chính, do̱ co̱i nhă̱n fă̱n slưởng cú cần cung chính. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Hạy cần nàư hử cần nưng chang kí cần sláy sliít nảy tan kin choóc nặm cắt nưng, vi̱ cần nỉnh hít cần nèm slon, do̱ chăn, ngo̱ cạ pi̱ noọng, cần nỉnh co̱i mí túc fă̱n slưởng cú làu đơ.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Slì Chảu Giê-xu tó slon cạ hử slíp nhi̱ cần nèm slon dá, Min pja̱c ti̱ nỉnh pay slon cạ xáu páo oóc chang kí slẻng cú hau. <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />Chíu nỉnh, Giăng ngài xăng dú chang ngục ti̱ng mà kí cung sla̱y cú Chảu Cháu Ti̱ Da̱, chứng xoi kí cần nèm slon làu pay, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />mà dăng xáu Min: “Slay chăn chư̱ Lạo lèo thưng mí, do̱ va̱ hung ngo̱ nhằng lèo tẳng Lạo táng?” <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Chảu Giê-xu hòi vàm hau: “Cứ pay, li̱n te̱o hử Giăng kí lo̱ pi̱ noọng đảy ti̱ng xáu hăn. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Cần bót đảy nho̱m hăn, cần què phjải pay, cần hảu đảy slaư, cần nuúc ti̱ng đảy, cần hai đảy hòi te̱o xáu cần khỏ đảy slon Vàm Đay. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Hạy cần nàư mí toỏng lụp vi̱ ngo̱, do̱ cần nỉnh đảy fúc.”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Chíu kí cần nỉnh khửn lo̱ dá, Chảu Giê-xu chứng chảng đủi phang cần mà Giăng cạ: “Pi̱ noọng oóc tu̱ng lẹng sle nho̱m lăng — co mạy ỏ ngài lầm hít tu̱ng fèn chư̱ mí? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Bó chư̱ pìn nỉnh do̱ pi̱ noọng oóc pay sle nho̱m lăng — cần đảy nu̱ng slử pèng chư̱ mí? nỉnh cà, kí cần nu̱ng slử pèng do̱ dú chang lưừn huùng. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Pi̱ noọng te̱o oóc pay sle nho̱m lăng num — cần páo cón chư̱ mí? Ngo̱ cạ chăn pi̱ noọng, mì cần nhằng quá tằng cần páo cón num. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Mà cần nỉnh, mì vàm slẻ cạ:</para>
  <para style="q1" vid="MAT 11:10">‘Ne̱, Ngo̱ xoi cần tang nả cú Ngo̱ pay tói nả lu̱c, nin co̱i fọn lo̱ cú lu̱c tói nả lu̱c.’<verse eid="MAT 11:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />Chăn, ngo̱ cạ pi̱ noọng, mí mì slắc cần đảy lưư̱c chang kí cần đảy cần ti̱ me̱ sleng oóc slung pèng quá Giăng Báp-tít, tọ, cần sláy ta̱i ít chang thiin ti̱ do̱ slung pèng quá ké. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Tọ, tứ vằn Giăng Báp-tít thưng cà nạy, thiin ti̱ ngài tói tỉng lai lai, xáu cần tói tỉng oóc slèng slưửng cháp au tum ti̱ nỉnh. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Mọi cần páo cón xáu luật fáp xày páo thưng tơ̱i cú Giăng; <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Hạy pi̱ noọng nhă̱n slấn, do̱ ké nỉnh chăn chư̱ Ê-li, cần lèo thưng. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Cần nàư mì xu sle ti̱ng, lèo ti̱ng. <verse eid="MAT 11:15" /><verse number="16" style="v" sid="MAT 11:16" />Tọ ngo̱ co̱i lèo pỉ xám cần nảy xáu lăng? Xám cần nảy hút xị kí lu̱c đích nă̱ng dú noo̱c háng, dảo căn, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />cạ: ‘Hung ngo̱ páu lầm hử kí pàng dạu, tọ kí pàng dạu te̱o mí dét mủ; Hung ngo̱ thán, kí pàng dạu te̱o mí hảy.’ <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Vi̱ Giăng tó thưng, bó kin, do̱ hau cạ: ‘Giăng ngài phi sla̱ to̱.’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Lu̱c Cú Cần thưng, kin do̱ hau te̱o chảng: ‘Nỉnh cà, min thám kin, ái nhẳm; hít pàng dạu đủi kí cần slau slé xáu cần phít xá!’ Tọ, quai kí chăn đảy nho̱m hăn quá kí lu̱c lan cú min.”<verse eid="MAT 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Min chứng quáy kí slẻng, ti̱ Chảu Giê-xu tó hít đảy lai fép lạ, vi̱ hau mí cho̱i xá. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“Slói hử mưng, slẻng Cô-ra-xin! Slói hử mưng, slẻng Bết-sai-đa! Vi̱ hạy kí lo̱ quỳn slèng đảy hít ti̱ hung mưng đảy hít dú Ty-rơ xáu Si-đôn, do̱ hau tó cho̱i xá, quỷn phải pán, thư pja̱u tứ hưng dá. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Pìn nỉnh, Cau cạ hung mưng, thưng vằn ứn chá, Ty-rơ xáu Si-đôn co̱i tảy ứn chá bau quá hung mưng. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Nhằng mưng, slẻng Ca-bê-na-um, mưng co̱i đảy dảu slung thưng slặn fạ do̱ lừ? Mưng co̱i ngài vẻng lùng ti̱ dăm. Vi̱ hạy kí lo̱ quỳn slèng đảy hít dú ti̱ mưng, hạy đảy hít dú Sô-đôm, do̱ slẻng nỉnh tó nhằng thưng vằn nảy. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Pìn nỉnh, Cau cạ hung mưng, chang vằn ứn chá, ti̱ Sô-đôm co̱i tảy ứn chá bau quá hung mưng.”<verse eid="MAT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Chíu nỉnh, Chảu Giê-xu khay vàm cạ: “Pá ới, Chảu cú tum xáu fạ, lu̱c că̱n Pá, vi̱ Pá tó dăm dò kí lo̱ nảy khói cần quai kí xáu cần thung slụ, tọ hử lu̱c đích chắc. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Chăn, Pá ới, vi̱ pìn nỉnh hít đay slim Pá. <verse eid="MAT 11:26" /><verse number="27" style="v" sid="MAT 11:27" />Mọi lo̱ ngo̱ đảy Pá chao hử; mí cần nàư chắc Lu̱c, tan Pá chắc, xày mí cần nàư chắc Pá, tan Lu̱c xáu kí cần Lu̱c ái hử chắc. <verse eid="MAT 11:27" /><verse number="28" style="v" sid="MAT 11:28" />Cứ mà đủi ngo̱, kí cần ón nhọc xáu háp nắc ới, ngo̱ co̱i hử pi̱ noọng đảy diít cha̱i. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Pi̱ noọng cứ háp au éc cú ngo̱ xáu slon tứ ngo̱, vi̱ ngo̱ mì slim slìn tào, nhă̱n nhưư̱ng, do̱ khoăn mi̱ng pi̱ noọng co̱i đảy diít cha̱i. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Vi̱ éc cú ngo̱ nga̱i dú xáu háp cú ngo̱ bau bính.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Chíu nỉnh, Chảu Giê-xu pay khoang quá tu̱ng nà, khảu vằn Sa-bát, kí cần nèm slon Min dác chứng bít sluùng khảu kin. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Hăn pìn nỉnh, kí cần Pha-ri-si chảng đủi Min: “Nho̱m nè, kí cần nèm slon slay hít lo̱ mí đảy fép hít chang vằn Sa-bát.” <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />Tọ, Min hòi vàm hau: “Pi̱ noọng mí to̱c mà tèo cỏ Đa-vít tó hít chíu huùng xáu kí cần pay nèm ngài dác do̱ lừ? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Huùng tó khảu đưng lưừn cú Chảu Fạ kin pẻng, pẻng nỉnh mí hử huùng xáu kí cần pay nèm kin, tan kí slay pài xoòng chứng đảy kin. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Do̱ va̱ kí ké xằng to̱c chang xéc luật fáp cạ, khảu vằn sa-bát, kí slay pài xoòng chang lưừn slớ fa̱m luật vằn Sa-bát, te̱o mí pìn xá do̱ lừ? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Tọ, ngo̱ chảng đủi pi̱ noọng cạ, cà nạy mì Lạo nưng cải quá lưừn slớ dú nảy. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Hạy pi̱ noọng slụ đảy ý xí cú vàm nảy: ‘Ngo̱ ái slim điíp sliít, mí ái sleng lìng’, do̱ pi̱ noọng tó mí phúc xá cần mí mì phít xá dá. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Vi̱ Lu̱c Cú Cần chăn chư̱ Chảu cú vằn sa-bát.”<verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Pja̱c ti̱ nỉnh, Chảu Giê-xu pay khảu lưừn ho̱i. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Dú nỉnh, mì cần slau phả mừ nưng, hau tham Chảu Giê-xu cạ: “Chư̱ vằn sa-bát đảy fép da pi̱ng mí?” hau tham sle cáo Min. <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />Min cạ hau: “Mì cần nàư chang pi̱ noọng, mì tu chiin ngài lút lùng lù khảu vằn sa-bát, cần nỉnh te̱o mí căm mắn dá kẻo min khửn mí? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Te̱o cạ tu cần nhằng pèng quá tu chiin nhỉnh lai! Pìn nỉnh, chang vằn sa-bát đảy fép hít lo̱ đay.” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Dá, Min cạ cần slau phả mừ: “Cứ dặc mừ cú ni̱ oóc!” Cần nỉnh dặc mừ oóc, do̱ mừ đảy đay, xị mừ nỉnh. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Chíu pay khói, kí cần Pha-ri-si oóc kí màu tói tỉng sle xa lo̱ khả Min.<verse eid="MAT 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Tọ chắc pìn nỉnh, Chảu Giê-xu chứng pay khói ti̱ nỉnh. Mì lai cần pay nèm Min, dá Min da đay thuủn hử hau, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />dá Min slắng hau mí đảy hử cần nàư chắc Min, <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />sle vàm cú Ê-sai páo cón đảy lình ính, cạ:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Nảy chăn chư̱ cần khỏi cú Ngo̱,</para>
  <para style="q1" vid="MAT 12:18">Cần Ngo̱ lưư̱c, Cần Ngo̱ pèng điíp, đay slim khoăn Ngo̱ mọi lo̱.</para>
  <para style="q1" vid="MAT 12:18">Ngo̱ co̱i tặt Chảu Khoăn Ngo̱ tìng Min,</para>
  <para style="q1" vid="MAT 12:18">Min co̱i páo oóc kí lo̱ cung chính hử cần cú tum ti̱ táng.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Min co̱i mí cheng ke̱o,</para>
  <para style="q1" vid="MAT 12:19">bó hài khửn xày mí cần nàư ti̱ng heng Min noo̱c kha lo̱.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Min co̱i bó ẻo co mạy ỏ tó ngài slé,</para>
  <para style="q1" vid="MAT 12:20">Min mí đắp slim tưng ái đắp,</para>
  <para style="q1" vid="MAT 12:20">thưng slì Min hít hử cung chính đảy hình,<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />xáu kí cần cú tum ti̱ táng tặt kháo mu̱ng khảu mình Min.”<verse eid="MAT 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Chíu nỉnh, hau au mà hử Chảu Giê-xu cần nưng ngài phi sla̱ fàng xáu vặp to̱, dá Min da đay, thưng slặn cần nỉnh vặp te̱o chảng đảy xáu hăn đảy. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Tằng phang cần xày he, chảng cạ: “Cay cần nảy pìn Lu̱c cú Đa-vít lố?” <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />Nhằng kí cần Pha-ri-si ti̱ng pìn nỉnh, te̱o cạ: “Ké nảy mí te̱p slẳm khoăn đảy, hạy mí pừng khảu Bê-ên-xê-bun, chảu cú phi sla̱.” <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Tọ Min tó chắc hau nẳm lăng, chứng cạ: “Tum ti̱ haư táng tỉng te̱o, do̱ co̱i ngài slán slác, slẻng haư do̱ va̱ lưừn haư táng păn pja̱c tỉng te̱o, do̱ co̱i mí dân mắn đảy. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Hạy Sa-tan te̱p Sa-tan, do̱ min táng tỉng te̱o làu. Hít lừ tum ti̱ min dân mắn đảy? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Hạy ngo̱ pừng khảu Bê-ên-xê-bun, sle te̱p phi sla̱, do̱ kí lu̱c pi̱ noọng pừng khảu cần nàư, sle te̱p phi sla̱? Pìn nỉnh, chăn hau co̱i ứn chá pi̱ noọng. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Nhằng hạy ngo̱ pừng khảu Chảu Khoăn cú Chảu Fạ sle te̱p phi sla̱, do̱ tum ti̱ Chảu Fạ tó thưng xáu pi̱ noọng dá. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />Hít lừ hau khảu lưừn cú cần slèng sle cưứp cha xài đảy, hạy ta̱i tàu mí phúc cần slèng te̱o? Dá lăng nỉnh chứng cưứp lưừn cú min. <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />Cần nàư mí dú xáu ngo̱ chăn chư̱ tói tỉng te̱o ngo̱, xáu cần nàư mí slan cáp đủi ngo̱ do̱ slán slác. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Pìn nỉnh, ngo̱ chứng cạ pi̱ noọng, mọi phít xá xáu vàm chảng fa̱m đảy sla hử hau; tọ vàm chảng fa̱m thưng Chảu Khoăn co̱i mí đảy sla đơ. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Hạy cần nàư chảng fản Lu̱c Cú Cần, do̱ co̱i đảy sla. Tọ cần nàư chảng fản đủi Chảu Khoăn, do̱ ma̱i cạ tơ̱i nảy xáu tằng tơ̱i lăng xày co̱i bó đảy sla. <verse eid="MAT 12:32" /><verse number="33" style="v" sid="MAT 12:33" />Hạy, co đay do̱ mác xày đay, hạy co xảu do̱ mác xày xảu; vi̱ nho̱m mác do̱ chắc co. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Nòi cần ngù too̱c nỉnh ới, vi̱ pi̱ noọng xảu, hít lừ chảng đảy kí vàm đay? Vi̱ pác chảng oóc kí lo̱ tim tứ chang múc slảy. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Vi̱ cần đay, tứ kí lo̱ đay làu hom đảy chứng hít kí lo̱ đay; nhằng cần xảu, tứ kí lo̱ xảu hom khảu chứng hít kí lo̱ xảu. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Tọ, ngo̱ cạ pi̱ noọng, hau co̱i chảng mọi vàm va̱i đai làu tó chảng oóc chang vằn ứn chá. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Vi̱ pừng khảu vàm chảng, kí pi̱ noọng chứng đảy dảo cung chính, xày tứ vàm chảng, pi̱ noọng co̱i ngài cáp xá.”<verse eid="MAT 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Chíu nỉnh, mì kỉ slay slon luật xáu cần Pha-ri-si chảng đủi Min cạ: “Slay ới, hung ngo̱ ái ngòi slay hít ha̱o pjòi nưng.” <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Min hòi vàm: “Xám cần too̱c éc, luu̱n slại xa thắp ha̱o pjòi nưng, tọ co̱i bó mì ha̱o pjòi haư hử min, tan ha̱o pjòi cú Giô-na páo cón xày. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Vi̱ xị Giô-na dú chang múc tu pja cải slam vằn slam că̱m pìn lừ, do̱ Lu̱c Cú Cần co̱i dú tảư tum slam vằn slam că̱m pìn nỉnh. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Chang vằn ứn chá, cần Ni-ni-ve co̱i tấn khửn xáu xám cần nảy xáu cáp xá min. Vi̱ nòi cần nảy tó ti̱ng vàm páo cạ cú Giô-na dá cho̱i xá, tọ dú nảy mì Lạo nưng nhằng cải quá Giô-na. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Chang vằn ứn chá, da̱ huùng bưửng Nàm co̱i tấn khửn xáu xám cần nảy sle ứn chá min, vi̱ da̱ tứ tàu cú ti̱ da̱, mà nảy sle ti̱ng vàm quai kí cú Sa-lô-môn, tọ nỉnh cà, dú nảy mì Lạo nưng nhằng cải quá Sa-lô-môn. <verse eid="MAT 12:42" /><verse number="43" style="v" sid="MAT 12:43" />Chíu slẳm khoăn oóc khói cần nưng, min pay quá kí ti̱ kháư lẹng, xa ti̱ cha̱i tọ mí hăn. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Chíu nỉnh, min chảng: ‘Làu co̱i fan te̱o lưừn làu, ti̱ làu ngám oóc khói.’ Mừ thưng, hăn lưừn đai, đảy fọn slaư sla̱ng, chang chỉnh đay đắn. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Slẳm khoăn chứng pay kẻo mà chất phi sla̱ táng nhằng xan quá min, xày khảu dú nỉnh. Dá, mư̱ lăng cú cần nỉnh nhằng hại đát quá mư̱ cón. Xám cần too̱c éc nảy xày co̱i pìn nỉnh.”<verse eid="MAT 12:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Slì Chảu Giê-xu nhằng cạ phang cần, do̱ mé xáu kí noọng Min thưng, dân dú noo̱c xáu xa lo̱ chảng cỏ xáu Min. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Mì cần nưng chảng đủi Min cạ: “Nỉnh cà, mé xáu kí noọng slay dân dú noo̱c nỉnh, xa lo̱ chảng cỏ đủi slay.” <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Tọ, Min hòi vàm hau: “Cần nàư chứng chư̱ mé ngo̱, cần nàư chư̱ kí noọng ngo̱?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Dá chíu Min dặc mừ mà vè kí cần nèm slon xáu cạ: “Nảy chứng chư̱ mé ngo̱ xáu kí noọng ngo̱! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Vi̱ hạy cần nàư hít nèm slim Pá ngo̱ slưửng dú tìng thiin ti̱, do̱ cần nỉnh chứng chư̱ kí noọng báo, noọng slao, xáu mé cú ngo̱ xày.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Chang vằn nỉnh, chíu pja̱c khói lưừn dá, Chảu Giê-xu nă̱ng dú cằn hải. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Phang cần đung lai ho̱p to̱i Min. Thưng slặn, Min lèo lùng lừ nă̱ng, nhằng phang cần do̱ dân tìng cằn. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Min au pỉ xì sle cạ hau lai lo̱, cạ: “Mì cần nưng oóc pay ván fằn. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Chang ván fằn, kỉ múi lút to̱i lo̱, nục fạ mà kin thuủn. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Kỉ múi táng lút tìng tum hin, mí mì tum nự. Múi fằn chứng bút khửn, vi̱ mí mì tum pùn lùng đắc <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Tọ chíu ha vằn khửn, ngài đét sliu pung, do̱ min ngoòng pọi vi̱ mí mì la̱c. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Nhằng kỉ múi táng lút chang pá nam, do̱ nam cải khửn hít hử min cặp kẹp. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Kỉ múi táng num lút tìng ti̱ tum đay chứng pìn bjoóc mác: múi do̱ oóc pác nưng, múi do̱ oóc húc slíp, múi do̱ oóc slam slíp. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Cần nàư mì xu, lèo ti̱ng!”<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Dá kí cần nèm slon mà xảư tham Min: “Hít lăng slay te̱o au pỉ xì sle cạ phang cần?” <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Min chứng hòi vàm hau cạ: “Kí lu̱c đảy pảo hử sle chắc đảy kí dăm dò mà thiin ti̱, nhằng kí cần nỉnh, do̱ mí đảy pảo hử. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Vi̱ cần nàư mì, do̱ co̱i đảy hử num, sle đảy fúng fàu. Tọ cần nàư mí mì, do̱ co̱i ngài dò pay kí lo̱ cần nỉnh tó mì dá. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Pìn nỉnh, ngo̱ au pỉ xì sle chảng đủi hau; vi̱ ma̱i cạ hau nho̱m tọ mí hăn đảy, kèng xu ti̱ng tọ mí đảy nghìn, xày mí slụ đảy. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Vàm páo cón cú Ê-sai đảy lình ính, cạ:</para>
  <para style="q1" vid="MAT 13:14">‘Kí lu̱c kèng xu ti̱ng, tọ mí slụ,</para>
  <para style="q1" vid="MAT 13:14">slè ha nho̱m, tọ kí lu̱c bó hăn lăng.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Vi̱ slim nòi cần nảy kheng lai;</para>
  <para style="q1" vid="MAT 13:15">xu hau nắc,</para>
  <para style="q1" vid="MAT 13:15">hau tó lắp ha,</para>
  <para style="q1" vid="MAT 13:15">cay ha hau nho̱m đảy,</para>
  <para style="q1" vid="MAT 13:15">xu ti̱ng đảy,</para>
  <para style="q1" vid="MAT 13:15">slim slụ đảy,</para>
  <para style="q1" vid="MAT 13:15">dá hau fan mà cho̱i xá,</para>
  <para style="q1" vid="MAT 13:15">Ngo̱ chứng da đay hử hau.’<verse eid="MAT 13:15" /></para>
  <para style="b" />
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Tọ fúc tháy hử ha pi̱ noọng, vi̱ nho̱m đảy; fúc hử xu pi̱ noọng vi̱ ti̱ng đảy! <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Chăn, ngo̱ cạ pi̱ noọng, mì lai cần páo cón, lai cần cung chính mu̱ng hăn lo̱ pi̱ noọng hăn tọ mí đảy hăn; mu̱ng ti̱ng kí lo̱ pi̱ noọng ti̱ng te̱o bó đảy ti̱ng. <verse eid="MAT 13:17" /><verse number="18" style="v" sid="MAT 13:18" />Pìn nỉnh, pi̱ noọng lèo ti̱ng pỉ xì mà cần ván fằn. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Cần nàư ti̱ng vàm đay mà thiin ti̱, te̱o mí slụ, do̱ phi sla̱ mà cưứp pay kí lo̱ tó ván chang slim cần nỉnh. Nảy chăn chư̱ múi fằn lút to̱i lo̱. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Nhằng múi fằn ván ngài lút tìng tum hin, xị cần ti̱ng vàm đay, do̱ liìn hun hỉ thư au; <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />tọ cần nỉnh mí chắp la̱c chang slim, tan dú dắp slì, pìn nỉnh, chíu phúng chai na̱n do̱ va̱ ngài hít khỏ vi̱ vàm đay, do̱ cần nỉnh liìn toỏng lụp. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Múi fằn ván lút chang pá nam, hút xị cần ti̱ng vàm đay, tọ slim dau hí mà tơ̱i nảy, slém mu̱ng fát xài hít hử vàm đay nỉnh ngài cặp kẹp chứng mí pìn mác. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Tọ múi fằn ván tìng tum đay, xị cần ti̱ng slụ vàm đay chứng pìn mác, múi pìn pác nưng, múi pìn húc slíp, múi pìn slam slíp.”<verse eid="MAT 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Chảu Giê-xu cạ hau pỉ xì táng nưng: “Thiin ti̱ đảy pỉ xị cần ván fằn đay chang tu̱ng nà làu. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Tọ chíu hau nòn, do̱ cần tói tàu cú cần nỉnh thưng, ván nhả văng chang khảu dá pay khói. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Chíu khảu bút khửn xáu oóc luùng, do̱ nhả văng xày bút khửn. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Kí cần khỏi cú chảu lưừn mà dăng ké cạ: ‘Lạo chảu ới, bó chư̱ chảu tó ván múi fằn đay chang nà cú chảu do̱ lừ? Pìn nỉnh, nhả văng tứ haư te̱o oóc?’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Lạo chảu chứng hòi vàm hau: ‘Cần tói tàu nưng tó hít pìn nỉnh.’ Dá kí cần khỏi dăng ké cạ: ‘Pìn nỉnh, chảu ái hung ngo̱ oóc lúc nhả nỉnh pay mí?’ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Lạo chảu hòi vàm: ‘Mí lèo, lao chíu lúc nhả văng, pi̱ noọng lúc tằng khảu num. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Cứ sle tằng sloong cải khửn thưng mù cùn; khảu mù cùn, ngo̱ co̱i slắng cần cùn. Lèo hom nhả văng cón, pỏ te̱o pìn ủm dá pung fày pay; nhằng khảu do̱ slau slặp khảu xang cú ngo̱.’”<verse eid="MAT 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Min chảng đủi hau pỉ xì táng, cạ: “Thiin ti̱ hút xị múi fằn cát nưng, đảy cần nỉnh au pay ván lùng nà; <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />ma̱i cạ múi fằn nỉnh sláy ta̱i ít chang thuủn kí múi fằn, tọ slì cải khửn, do̱ te̱o pìn cải tàu chang kí thìng co dú đưng la̱y, thưng slặn nục fạ mà hít lằng tìng cáng min.” <verse eid="MAT 13:32" /><verse number="33" style="v" sid="MAT 13:33" />Min li̱n hử hau pỉ xì táng nưng: “Thiin ti̱ hút xị mác pẻng, đảy cần ti̱ me̱ nỉnh au mà chào khảu slam xạu bư thưng slì tằng tuủng bư fát khửn.” <verse eid="MAT 13:33" /><verse number="34" style="v" sid="MAT 13:34" />Chảu Giê-xu tó au pỉ xì chảng đủi phang cần, Min mí chảng đủi hau lo̱ lăng te̱o mí quá pỉ xì, <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />sle lình ính vàm cú cần páo cón, cạ:</para>
  <para style="q1" vid="MAT 13:35">“Ngo̱ co̱i khay pác Ngo̱ sle chảng kí pỉ xì.</para>
  <para style="q1" vid="MAT 13:35">Ngo̱ co̱i páo oóc kí lo̱ dăm dò tứ tẳm chí oóc ti̱ da̱.”<verse eid="MAT 13:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Chíu pjạc khói pan đung dá, Chảu Giê-xu pay khảu lưừn. Kí cần nèm slon Min thưng, dăng cạ: “Xo făn khay hử hung lu̱c ý xí cú pỉ xì mà co nhả văng chang tu̱ng nà.” <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />Min chứng hòi vàm: “Cần ván fằn đay hút xị Lu̱c Cú Cần, <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />tu̱ng nà xị cạ ti̱ da̱; nhằng fằn đay — xị cạ kí lu̱c cú thiin ti̱. Nhả văng te̱o xị kí lu̱c cú cần xảu, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />nhằng cần tói tàu, xị cần tó ván nhả, chăn chư̱ phi sla̱. Nhằng mù cùn xị vằn sloót hang cú ti̱ da̱; cần cùn khảu xị kí cần tang nả fạ. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Pìn nỉnh, xị nhả văng đảy hom te̱o sle pung chang fày pìn lừ, do̱ khảu vằn sloót hang cú ti̱ da̱ xày pìn nỉnh; <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Lu̱c Cú Cần co̱i xoi cần tang nả Min, hau co̱i hom mọi cần hít toỏng lụp xáu mọi cần hít slại khói tum ti̱ Min, <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />dá vẻng min khảu coong fày, ti̱ co̱i mì hảy hấm xáu cắt fằn. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Chíu nỉnh, kí cần cung chính co̱i xoi slu̱ng xị ha vằn chang tum ti̱ cú Pá làu. Cần nàư mì xu, lèo ti̱ng.”<verse eid="MAT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“Thiin ti̱ pỉ xị xang pảo đảy phăng dò chang tu̱ng nà, cần nưng xa đảy do̱ dò pay. Hun hỉ khửn lo̱, pay khai thuủn mọi lo̱ làu mì sle slự tu̱ng nà nỉnh.” <verse eid="MAT 13:44" /><verse number="45" style="v" sid="MAT 13:45" />“Thiin ti̱ te̱o hút xị cần khai puún nưng pay xa múi hin pèng. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Chíu xa đảy múi hin pèng dá, cần nỉnh chứng pay khai mọi lo̱ làu mì sle slự múi hin pèng nỉnh.”<verse eid="MAT 13:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Thiin ti̱ xày hút xị ăn khe nưng pjúi lùng hải, cặp đảy đo mọi thìng pja, <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />đảy khe tim, hau kẻo khửn cằn, dá nă̱ng lùng lưư̱c pja đay sle khảu lỏ, nhằng pja xảu do̱ vẻng oóc noọc. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Thưng vằn sloót hang cú ti̱ da̱ xày pìn nỉnh: Kí cần tang nả fạ co̱i pay, păn cần too̱c éc khói kí cần cung chính, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />dá vẻng cần too̱c éc khảu coong fày; dú nỉnh co̱i mì hảy hấm xáu cắt fằn. <verse eid="MAT 13:50" /><verse number="51" style="v" sid="MAT 13:51" />“Pi̱ noọng slụ thuủn kí vàm nỉnh mí?” Hau dăng Min: “Ờ.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Min cạ hau: “Pìn nỉnh, kí slay slon luật tó đảy slon mà thiin ti̱, xày hút xị chảu lưừn nỉnh, au kí ăn máư xăm cáu oóc khói xang pảo cú làu.” <verse eid="MAT 13:52" /><verse number="53" style="v" sid="MAT 13:53" />Chíu Chảu Giê-xu li̱n mà kí pỉ xì nỉnh dá, Min pja̱c khói ti̱ nỉnh.<verse eid="MAT 13:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 13:54" />Mà thưng ti̱ chỏ làu, Min slon cạ phang cần chang lưừn ho̱i, thưng slặn hau he lai xáu cạ: “Tứ haư cần nảy te̱o đảy quai kí xáu hít đảy kí fép lạ pìn nỉnh? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Bó chư̱ cần nảy pìn lu̱c báo ké cha̱c mạy á? Mé min dảo hít Ma-ri, xáu kí noọng min mì Gia-cơ, Giô-sép, Si-môn xáu Giu-đa do̱ lừ? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Bó chư̱ kí noọng slao min xày dú đủi hung làu do̱ lừ? Pìn nỉnh, tứ haư cần nảy hít đảy mọi lo̱ nỉnh?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Hau toỏng lụp vi̱ Min. Tọ Chảu Giê-xu cạ hau: “Cần páo cón tan ngài ti̱ chỏ xáu cần chang lưừn làu ngòi che̱n xày.” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Min mí hít lai fép lạ dú nỉnh, vi̱ slim hau mí slấn.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Chíu nỉnh, huùng Hê-rốt đảy nghìn mà Chảu Giê-xu. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Huùng cạ kí quan tảư quỳn làu: “Nảy chư̱ Giăng Báp-tít. Cần đảy hòi te̱o tứ ti̱ hai, chứng hít đảy kí lo̱ quỳn slèng nảy.” <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />Hê-rốt, tó cặp, phúc dá xăng Giăng khảu ngục vi̱ da̱ Hê-rô-đia, me̱ Phi-líp, noọng cú huùng. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Vi̱ Giăng tó chảng đủi huùng: “Huùng mí đảy fép au da̱ nỉnh.” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Ma̱i cạ slưửng khả Giăng, tọ huùng te̱o lao phang cần, vi̱ hau ngòi Giăng xị cần páo cón. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />Tọ, khảu vằn lảu khoăn Hê-rốt, lu̱c slao cú Hê-rô-đia dét mủ dú sli̱c lảu, hít lùng cò Hê-rốt, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />huùng chứng pao xình, hạy slao xo lăng, huùng tó hử mọi lo̱ slao xo. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Ngài mé xẩn xục, slao chứng cạ: “Cà nạy, xo hử lu̱c ăn bảu cú Giăng Báp-tít tặt tìng xoòng.” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Huùng hăn xàu bứ, tọ vi̱ vàm làu pao xình xáu kí khéc nă̱ng kin, huùng chứng oóc lịng hít xị vàm slao xo. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Huùng xoi cần pay ke̱t bảu Giăng chang ngục, <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Bảu cú Giăng đảy tặt tìng xoòng dá chao hử slao nỉnh, slao te̱o au hử mé làu. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Lăng nỉnh, kí cần nèm slon cú Giăng thưng, au sli hài pay phăng, dá pay li̱n te̱o hử Chảu Giê-xu chắc.<verse eid="MAT 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Ti̱ng pìn nỉnh dá, Chảu Giê-xu pja̱c khói nỉnh, lùng lừ, pay thưng ti̱ quẹng xích dú cần đeo. Chắc pìn nỉnh, phang cần tứ kí slẻng phjải kha pay nèm Min. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Ngám oóc khói lừ, Chảu Giê-xu hăn phang cần đung, do̱ chạư quá, chứng da đay hử kí cần pi̱ng. <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />Thưng pài đăm, kí cần nèm slon thưng xáu Min, dăng: “Ti̱ nảy quẹng xích, cà nạy fạ do̱ đăm dá. Xo slay hử phang cần pay khảu kí bản, sle hau slự cú kin.” <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Chảu Giê-xu cạ: “Hau mí lèo pay haư đơ. Chăn pi̱ noọng lèo hử hau kin.” <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />Kí cần nèm slon dăng Min cạ: “Dú nảy, hung lu̱c tan mì hả ăn pẻng xáu sloong tu pja.” <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Min chứng cạ: “Cứ au mà nảy hử ngo̱.” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Lăng slì cạ phang cần nă̱ng tìng pá nhả, Min căm hả ăn pẻng xáu sloong tu pja, slè ha khửn fạ sleng slu̱ dá ẻo pẻng oóc dèn hử kí cần nèm slon, hau păn hử phang cần kin. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Mọi cần xày kin ím pứng. Hau hom te̱o — đảy slíp nhi̱ xoỏng tim kí pẻng slán lứ. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Kí cần kin mì slắc hả xiin cần ti̱ po̱, xằng án thưng ti̱ me̱ xáu lu̱c đích.<verse eid="MAT 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Lăng nỉnh, Min xẩn xục kí cần nèm slon lùng lừ, pay cón quá cằn hải bưửng nỉnh, chang slì Min hử phang cần mừ. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Chíu hử phang cần mừ dá, Min pay khửn phja cần đeo sle xỉnh chàu. Thưng đăm, Min xày dú nỉnh cần đeo. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Nhằng ăn lừ oóc chang hải dá, do̱ ngài nặm foòng slèng vi̱ lầm pặt tò te̱o. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Că̱m nỉnh, khảu tiỉm ta̱i slí, Chảu Giê-xu đủi kí cần nèm slon phjải pay tìng hải. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Chíu hăn Min phjải pay tìng hải, kí cần nèm slon he xáu cạ: “Nỉnh chư̱ phi sla̱!” dá hau hài khửn vi̱ lao dan. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Tọ Chảu Giê-xu liìn cạ hau: “Cứ ỏn slim è, Ngo̱ nảy cà, mí đảy lao!” <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />Phi-e-rơ dăng Min cạ: “Pái Chảu, hạy chăn chư̱ Chảu, xo hít hử lu̱c pay tìng nặm thưng đủi Chảu.” <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />Min cạ: “Cứ mà nảy!” Phi-e-rơ chứng oóc khói lừ, phjải pay tìng nặm, mà đủi Chảu Giê-xu. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Tọ hăn lầm cải, Phi-e-rơ slằn lao, chíu ái ngài dăm lùng nặm chứng hài khửn, cạ: “Chảu ới, xo cháu lu̱c!” <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Chích slì, Chảu Giê-xu dặc mừ oóc căm au Phi-e-rơ xáu cạ: “Cần nọi slim slấn nỉnh ới, hít lăng lu̱c te̱o la̱i?” <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Chíu hau phjải khảu lừ, do̱ lầm ti̱ng xích. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Nhằng kí cần dú đưng lừ pái Min, xáu cạ: “Chăn, slay chăn chư̱ Lu̱c Chảu Fạ!”<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Chíu quá thưng cằn bưửng nỉnh dá, hau khảu cằn dú ti̱ Ghê-nê-xa-rết. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Phang cần nhă̱n oóc Min, hau chứng xoi cần páo to̱i kí búng xảư xảng, hau au mà đủi Min thuủn kí cần pi̱ng. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Hau tan na̱i xo Min hử hau đảy tu̱ng khảu tân slử Min, dá kí cần tu̱ng khảu xày đảy đay.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Lăng nỉnh, mì kí cần Pha-ri-si xáu slay slon luật tứ slẻng Giê-ru-sa-lem mà phúng Chảu Giê-xu, tham cạ: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Hít lăng kí cần nèm slon slay fa̱m khảu cỏ le̱ cú kí lạo ké? Vi̱ hau mí slào mừ cón chứng kin pẻng.” <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Min hòi vàm hau: “Hít lăng kí ké te̱o fa̱m vàm slon cạ cú Chảu Fạ vi̱ kí cỏ le̱ cú làu? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Vi̱ Chảu Fạ tó slon cạ: ‘Lèo ngòi đay pá mé cú lu̱c;’ xáu ‘Cần nàư bjắc bjỏi pá mé, lèo khả hai cần nỉnh.’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Tọ kí ké te̱o cạ: ‘Cần nàư chảng đủi pá mé làu cạ: “Hạy lo̱ lăng lu̱c hít đay hử pá mé xày pìn xị cú cái pài khửn Chảu Fạ dá,”’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />do̱ mí chư̱ cần nỉnh ngòi đay pá mé làu. Pìn nỉnh, kí ké tó tả vàm cú Chảu Fạ vi̱ cỏ le̱ cú làu. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Kí cần pjàng mja̱p ới! Ê-sai chư̱ chăn slì chảng cón mà kí ké cạ:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />‘Phang cần nảy tài slung Ngo̱ du phi pác,</para>
  <para style="q1" vid="MAT 15:8">tọ slim hung min do̱ dú quay Ngo̱ lai.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Hung min pái slớ Ngo̱ pìn va̱i đai,</para>
  <para style="q1" vid="MAT 15:9">vi̱ slon cạ tan chư̱ kí luật cú tu cần.’”<verse eid="MAT 15:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="MAT 15:10" />Lăng nỉnh, Min dảo phang cần thưng dá cạ hau: “Lèo ti̱ng xáu slụ: <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Bó chư̱ ăn lăng khảu pác hít hử slẳm sla̱p tu cần; tọ lo̱ lăng tứ pác oóc, lo̱ nỉnh chứng hít slẳm sla̱p tu cần xày.” <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />Lăng nỉnh kí cần nèm slon khảu xảư, dăng xáu Min: “Slay chắc kí cần Pha-ri-si hăn ngài chảng fa̱m slì ti̱ng vàm nảy mí?” <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />Min hòi vàm: “Co haư Pá tìng fạ cú ngo̱ mí chay do̱ lèo lúc tằng la̱c pay. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Cứ đo đứ hau! Hau xị kí cần bót fàng tái lo̱. Hạy cần fàng tái cần fàng, do̱ tằng sloong xày lụp lùng lù.” <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Phi-e-rơ hòi vàm Chảu cạ: “Xo făn khay pỉ xì nỉnh hử hung ngo̱ chắc.” <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Tọ Chảu Giê-xu cạ: “Thưng cà nạy, pi̱ noọng nhằng mí slụ do̱ lừ? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Pi̱ noọng mí chắc cạ, mọi lo̱ lăng khảu đưng pác do̱ lùng múc slảy, dá ngài slọ oóc noo̱c chỉng khỉ do̱ lừ? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Tọ kí lo̱ lăng tứ pác chảng xày tứ chang slim oóc, kí lo̱ nỉnh chứng hít slẳm sla̱p tu cần. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Vi̱ tứ chang slim nẳm xảu, khả cần, pay chụ, eo đẳn, cưứp lặc, hít chửng pjàng, xáu chảng kí vàm la̱i xan. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Kí lo̱ nỉnh hít slẳm sla̱p tu cần; nhằng chíu kin xằng slào mừ, do̱ bó hít slẳm sla̱p tu cần đơ.”<verse eid="MAT 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Oóc khói nỉnh, Chảu Giê-xu pay khảu kí ti̱ dú slẻng Ty-rơ xáu Si-đôn. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Nho̱m cà, mì cần ti̱ me̱ Ca-na-an nưng tứ ti̱ nỉnh thưng moòng xo, cạ: “Pái Chảu, Lu̱c cú huùng Đa-vít, xo điíp sliít ngo̱ đủi! Lu̱c slao cú ngo̱ ngài phi sla̱ to̱ nắc lai.” <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Tọ Min bó hòi slắc vàm lăng. Kí cần nèm slon thưng xảư, na̱i xo Min, cạ: “Xo slay cạ da̱ nỉnh mừ pay, vi̱ da̱ cứ pay lăng na̱i xo hung làu mại.” <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />Min hòi vàm: “Ngo̱ bó đảy xoi mà, hạy mí chư̱ vi̱ hử kí chiin túc cú lưừn Y-sơ-ra-ên xày.” <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Tọ cần ti̱ me̱ nảy mà, qu̱y lùng tói nả Min, dăng cạ: “Pái Chảu, xo pang cho̱i ngo̱ đủi.” <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Min chứng hòi vàm: “Au pẻng cú kí lu̱c dá vẻng hử tu ma kin do̱ mí đảy.” <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />Cần ti̱ me̱ te̱o dăng cạ: “Pái Chảu, chăn pìn nỉnh, tọ kỉ tu ma do̱ đảy kin kí ám pẻng slán tứ xoòng cú chảu min lút lùng.” <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />Min cạ: “Cần ti̱ me̱ nỉnh ới, slim slấn cú ni̱ cải lai! Lo̱ ni̱ mu̱ng co̱i đảy pìn!” Lu̱c slao da̱ đảy đay khảu chăn tiỉm nỉnh.<verse eid="MAT 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Chảu Giê-xu pja̱c khói ti̱ nỉnh, pay to̱i cằn hải Ga-li-lê, chíu Min khửn tìng phja, dá nă̱ng dú nỉnh. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Dá mì kí phang cần đung lai mà xảư Min, mì kí cần què, cần fàng, cần phú slưứng, cần vặp, xáu lai cần khảy chíp táng. Hau tặt dú ti̱ kha Chảu Giê-xu, dá Min da đay hử kí cần nỉnh, <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />thưng slặn, phang cần he lai vi̱ hăn cần vặp chảng đảy, cần phú slưứng đảy đay, cần què pay đảy xáu cần fàng hăn đảy; dá hau că̱n Chảu Fạ cú Y-sơ-ra-ên.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Chíu nỉnh, Chảu Giê-xu dảo kí cần nèm slon thưng, dá cạ: “Ngo̱ hăn điíp phang cần nảy, vi̱ hau dú đủi làu slam vằn dá tọ mí mì ca lăng kin. Ngo̱ mí ái sle hau múc dác pay mừ, lao hau te̱o đỉn pay to̱i lo̱.” <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Kí cần nèm slon dăng Chảu: “Chang ti̱ tu̱ng lẹng nảy, hung làu xa haư đảy lai pẻng hử phang cần đung nỉnh kin ím?” <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Chảu Giê-xu tham kí cần nèm slon: “Pi̱ noọng mì kỉ lai pẻng?” Hau dăng: “Mì chất ăn pẻng, xáu kỉ tu pja sláy.” <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Min cạ phang đung nă̱ng lùng tum, <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Min căm chất ăn pẻng xáu kỉ tu pja, sleng slu̱, dá ẻo oóc hử kí cần nèm slon, sle hau păn oóc hử phang cần. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Mọi cần xày kin ím. Hau hom đảy chất xoỏng tim kí tỏn pẻng lứ. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Mì slí xiin cần ti̱ po̱ kin. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Lăng slì hử phang cần mừ, Min khảu lừ sle pay quá búng Ma-ga-đan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Kí cần Pha-ri-si xáu Sa-đu-sê khảu xảư — sle xi Chảu Giê-xu — hử hau hăn ha̱o pjòi nưng tứ fạ. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Tọ Min hòi vàm hau: [“Chíu pài thưng, kí ké cạ: ‘Fạ đay, vi̱ phả fạ đeng.’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Nhằng khảu naư chạu te̱o cạ: ‘Fạ phân pa̱o, vi̱ phả fạ đeng xáu khăm nhám.’ Kí ké chắc nho̱m fạ te̱o mí păn pjết đảy kí ha̱o cú slì slằn.”] <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />“Xám cần too̱c éc eo đẳn nảy xa ha̱o pjòi nưng, tọ hau co̱i mí đảy pảo hử ha̱o pjòi haư, tan đảy ha̱o pjòi cú Giô-na.” Min chứng tả hau pay khói.<verse eid="MAT 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Kí cần nèm slon lùm au nèm pẻng, chíu thưng cằn bưửng nỉnh. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Chảu Giê-xu cạ hau: “Lèo slỉu slim xáu slỉng sla̱c đủi bư phù cú kí cần Pha-ri-si xáu Sa-đu-sê.” <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Tọ, kí cần nèm slon tò ke̱o xáu căn cạ: “Vi̱ hung làu mí au pẻng pay nèm.” <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Chắc pìn nỉnh, Chảu Giê-xu chứng cạ: “Kí cần nọi slim slấn ới, hít lăng pi̱ noọng te̱o tò ke̱o căn vi̱ làu mí mì pẻng? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Pi̱ noọng nhằng xằng slụ, mí chứ hả ăn pẻng đo hử hả xiin cần kin, dá pi̱ noọng hom đảy kỉ lai xoỏng pẻng lứ do̱ lừ? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Do̱ va̱ chất ăn pẻng đo hử slí xiin cần kin, dá pi̱ noọng hom đảy kỉ lai xoỏng pẻng lứ? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Hít lăng pi̱ noọng mí chắc cạ ngo̱ mí ái chảng xáu pi̱ noọng mà pẻng? Tọ lèo slỉu slim mà bư phù cú cần Pha-ri-si xáu Sa-đu-sê.” <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Chíu nỉnh, kí cần nèm slon chứng slụ Min mí cạ hau lèo slỉu slim mà bư phù sle hít pẻng, tọ lèo slỉu slim mà lo̱ slon cạ cú kí cần Pha-ri-si xáu Sa-đu-sê.<verse eid="MAT 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Chíu khảu thưng tum ti̱ Sê-sa-rê Phi-líp, Chảu Giê-xu tham kí cần nèm slon, cạ: “Hau chảng Lu̱c Cú Cần chư̱ cần nàư?” <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Kí cần nèm slon dăng: “Mì kỉ cần do̱ cạ Giăng Báp-tít, nhằng fă̱n ứn cạ chư̱ Ê-li, fă̱n táng num te̱o cạ chư̱ Giê-rê-mi do̱ va̱ cần nưng chang kí cần páo cón.” <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />Min cạ hau: “Nhằng pi̱ noọng do̱ cạ ngo̱ chư̱ cần nàư?” <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Si-môn Phi-e-rơ chứng dăng: “Slay chăn chư̱ Chảu Cháu Ti̱ Da̱, Lu̱c Chảu Fạ te̱o tơ̱i tơ̱i.” <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Chảu Giê-xu cạ ké: “Si-môn, lu̱c Giô-na ới, fúc hử ni̱, vi̱ mí chư̱ nự xáu lưư̱t hử ni̱ đảy chắc lo̱ nảy, tọ chăn Pá ngo̱ dú tìng fạ hử chắc. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Nhằng ngo̱ xày cạ ni̱ chư̱ Phi-e-rơ, tìng khảng hin nảy, ngo̱ co̱i tẳng ho̱i thánh cú ngo̱, kí pha tu dú ti̱ dăm mí hình đảy ho̱i thánh nỉnh. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Ngo̱ co̱i chao kí slì slả thiin ti̱ hử ni̱, hạy lo̱ lăng ni phúc dú tảư tum do̱ co̱i ngài phúc dú tìng thiin ti̱, xáu lo̱ lăng ni̱ khay dú tảư tum do̱ đảy khay dú tìng thiin ti̱.” <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Dá Min căm kí cần nèm slon chảng hử cần nàư chắc Min chăn chư̱ Chảu Cháu Ti̱ Da̱.<verse eid="MAT 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Tứ chíu nỉnh, Chảu Giê-xu Cháu Ti̱ Da̱ xo tàu hử kí cần nèm slon chắc cạ Min lèo pay thưng slẻng Giê-ru-sa-lem, lèo tảy lai chíp khỏ tứ kí lạo ké, kí slay pài xoòng tàu xáu kí slay slon luật, xáu lèo ngài khả hai, thưng vằn ta̱i slam đảy hòi te̱o. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />Phi-e-rơ kẻo Min oóc bưửng nưng xáu quáy Min, cạ: “Pái Chảu, Chảu Fạ slim đay xáu slay! Lo̱ nảy co̱i mí oóc mà hử slay slắc pày đơ.” <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Tọ Min váy lăng te̱o, dá cạ Phi-e-rơ: “Sa-tan ới, thói oóc lăng Ngo̱ khoái! Ni̱ xị ca̱o hin hít toỏng kha ngo̱; vi̱ ni̱ bó nẳm thưng kí cung sla̱y cú Chảu Fạ, te̱o tan nẳm thưng cung sla̱y cú tu cần.” <verse eid="MAT 16:23" /><verse number="24" style="v" sid="MAT 16:24" />Dá Chảu Giê-xu chảng đủi kí cần nèm slon Min: “Hạy cần nàư ái pay nèm ngo̱, do̱ cần nỉnh lèo tả chăn làu, lèo béc mạy các khoáy cú làu pay nèm ngo̱. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Vi̱ xắn cần nàư ái cháu mi̱ng te̱o làu, do̱ co̱i túc, nhằng cần nàư túc mi̱ng làu vi̱ ngo̱, do̱ co̱i xa te̱o đảy. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Hạy cần nưng đảy tằng ti̱ da̱, tọ túc khoăn mi̱ng làu do̱ đảy lăng? Cần nỉnh co̱i au ca lăng sle tói te̱o khoăn mi̱ng làu đảy? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Vi̱ Lu̱c Cú Cần co̱i thưng chang slu̱ng phjưức cú Pá Min tò xày kí cần tang nả Min. Chíu nỉnh, Min co̱i păng hử cần pìn cần, nèm xị lo̱ hau hít. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Chăn, ngo̱ cạ pi̱ noọng, mì kỉ cần dân dú nảy co̱i mí hai, thưng slì đảy hăn Lu̱c Cú Cần khảu chang tum ti̱ cú Min.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Húc vằn lăng, Chảu Giê-xu au tan Phi-e-rơ, Gia-cơ xáu Giăng, noọng Gia-cơ, pay đủi Min khửn nhoo̱t phja slung nưng. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Bưửng noo̱c Min piín tói, tói nả hau, nả Min slu̱ng xác xị ha vằn, nhằng slử Min pìn khao xị áng slu̱ng. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />nỉnh cà, mì Môi-se đủi Ê-li oóc nả, chảng cỏ xáu Min. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Phi-e-rơ dăng Chảu Giê-xu: “Pái Chảu, hung làu dú nảy đay lai. Hạy slay ái, ngo̱ co̱i tẳng dú nảy slam ăn le̱o — ăn nưng hử slay, ăn nưng hử Môi-se xáu ăn nưng hử Ê-li.” <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />Chíu Phi-e-rơ nhằng chảng, mì xá phử nưng slu̱ng slực dà quá hau; dá tứ chang xá phử mì heng chảng cạ: “Nảy chăn chư̱ Lu̱c Ngo̱ pèng điíp, đay slim Ngo̱. Lèo ti̱ng vàm Lu̱c nỉnh!” <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Kí cần nèm slon ti̱ng heng nỉnh dá, do̱ lụp nả lùng tum, ta̱i tu̱m he. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Dá Chảu Giê-xu thưng xảư, tu̱ng khảu hau cạ: “Tấn dân pay, mí đảy lao.” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Tọ, kí cần nèm slon slè ha khửn, do̱ mí hăn cần nàư táng, tan Chảu Giê-xu xày.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Chíu kí cần nèm slon tứ tìng phja lùng, Min oóc lịng hử hau: “Dá xảy li̱n te̱o hử cần nàư kí lo̱ nảy, thưng slì Lu̱c Cú Cần tứ ti̱ hai hòi te̱o.” <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />Kí cần nèm slon tham Min, cạ: “Pìn nỉnh do̱ hít lăng kí slay slon luật te̱o chảng Ê-li lèo thưng cón?” <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Min chứng hòi vàm: “Chăn Ê-li lèo thưng sle hòi te̱o mọi lo̱. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Tọ ngo̱ cạ pi̱ noọng, Ê-li tó thưng dá, hau te̱o mí nhă̱n oóc ké. Tọ hít nèm slim hau slưửng đo mọi lo̱ đủi ké. Lu̱c Cú Cần xày co̱i tảy khỏ na̱n tứ hau pìn nỉnh.” <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Chíu nỉnh, kí cần nèm slon slụ cạ Min chảng đủi hau mà Giăng Báp-tít.<verse eid="MAT 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Slì Chảu Giê-xu thưng đủi phang cần, do̱ mì cần ti̱ po̱ thưng, qu̱y kháu tói nả Min <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />dăng: “Pái Chảu, xo điíp sliít thưng lu̱c báo lại, lan min ngài bả mu, chíp đát lai; min cứ ngài lụp khảu fày, dá slưừng slì lụp lùng nặm. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Lại tó au min mà hử kí cần nèm slon Chảu, tọ hau mí da hử min đay đảy.” <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />Chảu Giê-xu hòi vàm: “Xám cần mí mì slim slấn xáu cò kheng nỉnh ới, ngo̱ co̱i dú đủi pi̱ noọng thưng mư̱ haư? Ngo̱ co̱i tảy nẳm pi̱ noọng kỉ lai hưng num? Au ò đích mà nảy hử ngo̱.” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Chảu Giê-xu quáy phi sla̱, phi sla̱ chứng oóc khói ò đích; ò đích đảy đay tứ chăn tiỉm nỉnh.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Kí cần nèm slon mà phúng tan Chảu Giê-xu, dăng cạ: “Hít lăng hung ngo̱ mí te̱p phi sla̱ nỉnh đảy?” <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />Min hòi vàm hau: “Vi̱ pi̱ noọng nọi slim slấn. Chăn, ngo̱ cạ chăn đủi pi̱ noọng, hạy pi̱ noọng mì slim slấn tan tùng múi fằn cát nưng, do̱ pi̱ noọng cạ pò phja nảy cạ: ‘Cứ pja̱c tứ ti̱ nảy quá ti̱ nỉnh’ do̱ min co̱i pja̱c pay; xáu bó mì lo̱ lăng pi̱ noọng mí hít đảy.” <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />[Tọ kí phi sla̱ nỉnh mí te̱p đảy, hạy mí xỉnh chàu xáu căm kin.]<verse eid="MAT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Chíu nỉnh, kí cần nèm slon ho̱p te̱o dú Ga-li-lê, Chảu Giê-xu cạ hau: “Lu̱c Cú Cần ái ngài no̱p khảu mừ kí cần hau, <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />hau co̱i khả Min hai, tọ thưng vằn ta̱i slam, Min co̱i hòi te̱o.” Kí cần nèm slon chứng chíp xàu lai.<verse eid="MAT 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Hau pay thưng slẻng Ca-bê-na-um, kí cần slau slé cú lưừn slớ mà tham Phi-e-rơ: “Slay cú kí cần ni̱ no̱p slé khảu lưừn slớ do̱ lừ?” <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />Phi-e-rơ dăng: “No̱p.” Chíu Phi-e-rơ khảu đưng lưừn dá, Chảu Giê-xu tham ké cón: “Si-môn ới, ni̱ nẳm lăng? Kí huùng tìng slí chái slau slé tứ cần nàư? Tứ lu̱c lan hau do̱ va̱ tứ cần noo̱c?” <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Phi-e-rơ dăng: “Tứ cần noo̱c.” Min cạ: “Pìn nỉnh, do̱ kí lu̱c mí lèo no̱p. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Tọ sle hung làu khói hít hử hau toỏng lụp, ni̱ cứ oóc hải téng au tu pja khửn cón. Khay pác tu pja oóc, co̱i hăn siếc-lơ nưng, dá au mà no̱p slé hử ngo̱ đủi ni̱.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Chíu nỉnh kí cần nèm slon mà xảư Chảu Giê-xu, dăng: “Cần nàư chư̱ cải tàu chang thiin ti̱?” <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Min dảo ò đích nưng mà, tặt ò đích dú chang <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />xáu cạ: “Chăn, ngo̱ cạ pi̱ noọng, hạy pi̱ noọng mí piín tói xáu pìn xị kí tu đích, pi̱ noọng co̱i mí đảy khảu chang thiin ti̱ đơ. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Pìn nỉnh, cần nàư nhă̱n nhưư̱ng xị tu đích nảy, cần nỉnh co̱i pìn cải tàu chang thiin ti̱. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Nhằng cần nàư au mình ngo̱ chiíp tu nưng đích pìn nảy, do̱ cần nỉnh chiíp ngo̱. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Tọ cần nàư hít hử tu đích nưng chang kí tu đích sláy nảy lụp khảu phít xá, chư̱ kí cần slấn ngo̱, do̱ nhă̱n phúc chục hin khảu cò cần nỉnh, dá vẻng dăm lùng hải đắc nhằng đay quá.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />Slói tháy hử ti̱ da̱ mà kí lo̱ hít hử toỏng lụp! Vi̱ kí lo̱ hít hử toỏng lụp lèo mì oóc, tọ slói tháy hử cần nàư chư̱ cần hít toỏng lụp! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Hạy mừ do̱ kha pi̱ noọng hít hử pi̱ noọng fa̱m xá, cứ bác xáu vẻng min pay khói! Vi̱ nhă̱n pi̱ noọng què kha do̱ co̱t mừ tọ đảy khảu lo̱ te̱o, nhằng đay quá mì đo tằng sloong mừ, sloong kha tọ ngài vẻng khảu fày tơ̱i tơ̱i. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Nhằng hạy ha pi̱ noọng hít hử pi̱ noọng fa̱m xá, cứ bói xáu vẻng min pay khói! Vi̱ nhă̱n pi̱ noọng tan nhằng ha nưng tọ đảy khảu lo̱ te̱o, nhằng đay quá đo tằng sloong ha tọ ngài vẻng khảu ngục fày. <verse eid="MAT 18:9" /><verse number="10" style="v" sid="MAT 18:10" />Lèo slỉu slim, mí đảy ngòi che̱n tu haư chang kí tu đích sláy nảy! Vi̱ ngo̱ cạ pi̱ noọng, kí cần tang nả cú min dú tìng fạ slưừng slì hăn nả Pá ngo̱ dú tìng thiin ti̱ mại. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />[Vi̱ Lu̱c Cú Cần tó thưng sle cháu cần ngài va̱i túc.] <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />Pi̱ noọng nẳm lăng? Hạy cần nưng mì pác tu chiin nưng, te̱o túc pay tu nưng, do̱ bó sle cảu slíp cảu tu chiin dú tìng đung sle khửn lo̱ thắp tu ngài túc pay do̱ lừ? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Hạy cần nỉnh thắp đảy, do̱ chăn, ngo̱ chảng đủi pi̱ noọng cạ, cần nỉnh co̱i hun hỉ mà tu chiin nỉnh quá cảu slíp cảu tu chiin mí ngài túc. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Xày pìn nỉnh, Pá pi̱ noọng dú tìng thiin ti̱ mí ái sle slắc cần chang kí cần sláy nảy ngài va̱i túc.<verse eid="MAT 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Hạy cần nưng cú pi̱ noọng fa̱m xá đủi pi̱ noọng, cứ pay phúng tan min dá quáy. Hạy min nhă̱n ti̱ng pi̱ noọng, do̱ pi̱ noọng te̱o đảy pi̱ noọng làu. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Tọ hạy min mí slém ti̱ng, do̱ cứ tái cần nưng do̱ sloong cần pay đủi pi̱ noọng, sle pừng khảu vàm cú sloong do̱ slam cần hít chửng, do̱ mọi vàm đảy cung nhă̱n. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Nhằng hạy cần nỉnh mí slém ti̱ng hau, do̱ cứ páo hử ho̱i thánh. Dá hạy cần nỉnh mí slém ti̱ng ho̱i thánh, do̱ cứ ngòi cần nỉnh xị cần mí slấn xáu cần slau slé. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />Chăn, ngo̱ cạ pi̱ noọng, xắn lo̱ lăng pi̱ noọng phúc dú tảư tum, xày co̱i ngài phúc dú tìng fạ; xáu hạy lo̱ lăng pi̱ noọng khay dú tảư tum, do̱ co̱i đảy khay dú tìng fạ. <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />Ngo̱ te̱o cạ pi̱ noọng pày nưng num, hạy sloong cần chang pi̱ noọng slim đeo đủi căn dú tảư tum xỉnh xo mọi lo̱ lăng, do̱ Pá ngo̱ dú tìng thiin ti̱ co̱i hít pìn hử hau. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Vi̱ ti̱ haư mì sloong do̱ va̱ slam cần au mình ngo̱ ho̱p căn te̱o, do̱ ngo̱ co̱i dú chang hau.”<verse eid="MAT 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Chíu nỉnh, Phi-e-rơ khảu xảư Chảu Giê-xu xáu tham: “Chảu ới, hạy pi̱ noọng ngo̱ fa̱m xá xáu ngo̱, do̱ ngo̱ co̱i lèo sla hử hau kỉ lai pày? Chư̱ thưng chất pày mí?” <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />Min hòi vàm: “Ngo̱ mí cạ ni̱ tan chất pày đơ, tọ thưng chất slíp pày chất. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Pìn nỉnh, thiin ti̱ pỉ xị cần nỉnh hít huùng, cần nỉnh ái cay sló xáu kí cần khỏi cú làu. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Chíu huùng xo tàu cay sló, hau au mà hử huùng cần nưng slỉu nỉ slíp xiin ta-lâng. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Tọ cần nỉnh mí mì lăng sle păng, huùng chứng oóc lịng cần nỉnh lèo khai me̱ lu̱c xáu mọi cha xài làu mì, sle păng nỉ. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Cần khỏi chứng qu̱y lùng, na̱i xo huùng: ‘Lạo chảu ới, xo tảy na̱i hử lại đủi, lại co̱i păng thuủn nỉ hử chảu.’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Lạo chảu hăn điíp, chứng pjúi cần khỏi mừ xáu sla nỉ hử min. <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" />Tọ chíu cần khỏi nỉnh oóc noo̱c, phúng cần nưng xày hít khỏi đủi căn, slỉu nỉ min pác đơ-ni-ê nưng, do̱ căm cò cần nỉnh xáu cạ: ‘Mưng slỉu nỉ lăng do̱ păng thuủn pay.’ <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Cần khỏi tò xày hít cung đủi min chứng qu̱y lùng, na̱i cạ: ‘Xo tảy na̱i hử ngo̱, dá ngo̱ co̱i păng hử ni̱.’ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Tọ cần nảy mí khửng, pắt cần nỉnh xăng khảu ngục thưng slì păng thuủn chèn nỉ. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Kí cần hít khỏi táng hăn pìn nỉnh do̱ slim xàu lai, mà li̱n te̱o xáu lạo chảu mọi lo̱ tó mì oóc. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Túc lăng, lạo chảu dảo cần khỏi nỉnh thưng dá cạ: ‘Cần khỏi too̱c éc nỉnh ới, ngo̱ tó sla thuủn nỉ hử ni̱, vi̱ ni̱ na̱i xo ngo̱. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Hít lăng ni̱ te̱o mí điíp sliít pàng dạu làu, xị ngo̱ tó điíp sliít ni̱?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Lạo chảu fát slíng, chứng chao min hử cần pạư ngục cọn thưng mư̱ haư min păng thuủn nỉ. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />Pá tìng fạ cú ngo̱ xày tói ta̱i xáu pi̱ noọng pìn nỉnh, hạy mọi cần chang pi̱ noọng mí thuủn slim sla dưư̱ng hử pi̱ noọng làu.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Chíu Chảu Giê-xu slon cạ kí vàm nảy dá, Min pja̱c khói Ga-li-lê pay thưng búng Giu-đê, bưửng nỉnh ta̱ Giô-đanh. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Kí phang cần đung lai pay nèm Min; dá Min da đay pi̱ng hử hau dú nỉnh.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Kí cần Pha-ri-si mà xảư sle xi xáu tham Min: “Cần ti̱ po̱ đảy fép lư me̱ vi̱ lo̱ lăng mí?” <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />Min hòi vàm: “Kí ké xằng to̱c cạ Lạo chí oóc mọi lo̱, tứ tàu slì tó hít pìn cần ti̱ po̱ xáu cần ti̱ me̱, <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />xáu cạ: ‘Pìn nỉnh, cần ti̱ po̱ co̱i pja̱c khói pá mé sle tò cáp đủi me̱ làu, xáu sloong cần co̱i pìn nự nâng’ do̱ lừ? <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Thưng slặn, po̱ me̱ mí nhằng chư̱ sloong cần dá, te̱o tan chư̱ nự đeo xày. Pìn nỉnh, kí cần đảy Chảu Fạ tò cáp do̱ tu cần mí đảy pja̱c căn.” <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />Hau te̱o tham Min: “Hạy pìn nỉnh, hít lăng Môi-se te̱o slon cần ti̱ po̱ lèo hít chỉ lư, dá chứng tả me̱?” <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Min hòi vàm hau cạ: “Vi̱ slim kí ké kheng lai, Môi-se chứng hử fép kí ké lư me̱, tọ tứ xo tàu mí pìn nỉnh đơ. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Nhằng ngo̱ cạ kí ké, hạy mí chư̱ vi̱ me̱ pay chụ, te̱o lư me̱ dá pay au cần táng do̱ fa̱m xá pay chụ; cần au cần ngài lư xày fa̱m xá pay chụ.” <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />Kí cần nèm slon dăng Min cạ: “Hạy cần ti̱ po̱ tan lư me̱ vi̱ pìn nỉnh, do̱ nhă̱n mí au me̱ nhằng hẳm đay.” <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Tọ Min hòi vàm hau: “Mí chư̱ cần nàư tó nhă̱n đảy vàm nảy đơ, tọ tan sle hử kí cần đảy pảo hử xày. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Vi̱ mì kí cần ton, chư̱ kí cần tứ chíu đảy sleng oóc tứ tọng mé tó pìn nỉnh dá; mì cần do̱ ngài hau ton, mì cần te̱o táng ton vi̱ thiin ti̱. Cần nàư nhă̱n đảy vàm nảy, cứ nhă̱n pay.”<verse eid="MAT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Túc lăng, hau au kí tu đích mà, sle đảy Min tặt mừ xáu xỉnh chàu, tọ kí cần nèm slon quáy hau. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Tọ, Chảu Giê-xu cạ: “Cứ sle kí tu đích nảy mà xáu ngo̱, dá tả làn hung min, vi̱ thiin ti̱ slục mừ kí cần hút xị kí tu đích nỉnh.” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Min tặt mừ tìng kí tu đích, dá tứ nỉnh khửn lo̱.<verse eid="MAT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Chíu nỉnh, mì cần nưng mà tham Min, cạ: “Slay ới, ngo̱ lèo hít lo̱ đay haư sle đảy te̱o tơ̱i tơ̱i?” <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />Chảu Giê-xu hòi vàm: “Hít lăng ni̱ tham ngo̱ mà lo̱ đay? Tan mì Lạo nưng đay đắn xày, nhằng hạy ni̱ mu̱ng đảy khảu lo̱ te̱o, do̱ lèo hít nèm kí vàm slon cạ.” <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />Cần nỉnh tham Chảu: “Kí vàm slon cạ haư?” Chảu Giê-xu hòi vàm: “Dá xảy khả cần; mí đảy pay chụ; mí đảy lặc cưứp, mí đảy hít chửng pjàng, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />lèo ngòi đay pá mé, xáu mì slim điíp cần xảư xảng ni̱ xị chăn pỏn slăn làu.” <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />Cần phủ báo nỉnh dăng Chảu: “Ngo̱ tó hít nèm thuủn kí lo̱ nảy. Ngo̱ nhằng slỉu lo̱ lăng mí?” <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />Chảu Giê-xu hòi vàm: “Hạy ni̱ ái đảy xày xiìn, cứ pay, khai kí lo̱ làu mì dá păn hử cần khỏ, do̱ ni̱ co̱i mì xang pảo dú tìng thiin ti̱; dá co̱i pay nèm ngo̱!” <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Tọ, ti̱ng vàm nảy dá, phủ báo nỉnh slim xàu tả pay, vi̱ min mì lai cú cái lai.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Chảu Giê-xu chứng cạ kí cần nèm slon làu: “Chăn, ngo̱ cạ pi̱ noọng, cần fát xài khảu thiin ti̱ chăn chư̱ khỏ lai. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Ngo̱ te̱o cạ pi̱ noọng, sle tu lạc đà chún quá lù khim nhằng hẳm nga̱i quá cần fát xài khảu chang tum ti̱ Chảu Fạ.” <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />Kí cần nèm slon ti̱ng vàm nảy, do̱ hăn he lai chứng tham: “Pìn nỉnh do̱ cần nàư đảy cháu à?” <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />Chảu Giê-xu pắc pí nho̱m hau dá cạ: “Tu cần mí hít đảy lo̱ nảy, tọ Chảu Fạ hít đảy mo̱i lo̱.” <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />Phi-e-rơ dăng Chảu: “Slay ngòi ne̱, hung ngo̱ tó tả thuủn pay nèm slay. Pìn nỉnh do̱ hung ngo̱ co̱i đảy lăng?” <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />Chảu Giê-xu hòi vàm hau: “Chăn, ngo̱ cạ pi̱ noọng, thưng slì mọi lo̱ tói máư, chíu Lu̱c Cú Cần co̱i nă̱ng tìng tắng kim slu̱ng phjưức cú Min, do̱ pi̱ noọng chư̱ kí cần tó pay nèm ngo̱, xày co̱i đảy nă̱ng tìng slíp nhi̱ tắng kim, sle ứn chá slíp nhi̱ nòi cần Y-sơ-ra-ên. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Hạy cần nàư tả lưừn la̱ng, pi̱ noọng, ché, noọng, pá mé, me̱ lu̱c, nà la̱y vi̱ mình ngo̱, do̱ cần nỉnh co̱i đảy nhă̱n quá pác pày num, xáu đảy lo̱ te̱o tơ̱i tơ̱i. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Tọ mì lai cần tàu co̱i pìn hang, dá cần hang te̱o pìn tàu.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Vi̱ thiin ti̱ hút xị chảu la̱y nà, naư chạu pay oóc sle có cần hít cung hử la̱y mác ít cú làu. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Lăng slì tó chung ý xáu kí cần hít cung păng mọi vằn đơ-ni-ê nưng, lạo chảu xoi hau khảu la̱y mác ít hít hử làu. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Thưng tiỉm ta̱i slam, lạo chảu oóc pay, hăn kí cần đai đảy váng dân dú chang háng. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Ké cạ hau: ‘Kí báo cứ khảu la̱y mác, ngo̱ co̱i păng chèn cung ngám hử kí cần ni̱.’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Dá hau pay nèm, Slắc tiỉm ta̱i húc xáu tiỉm ta̱i cảu, lạo chảu te̱o oóc pay, ké xày hít pìn nỉnh. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Slắc tiỉm slíp ít, lạo chảu oóc pay, hăn kí cần táng dân dú, do̱ cạ hau: ‘Hít lăng kí cần ni̱ dân đai dú nảy quá vằn?’ <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Hau hòi vàm ké: ‘Vi̱ mí mì cần nàư có hung ngo̱ né.’ Lạo chảu chứng cạ hau: ‘Kí cần ni̱ cứ pay khảu đưng la̱y mác ít.’ <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />Thưng pài đăm, chảu la̱y mác ít cạ cần cuủn: ‘Cứ dảo kí cần hít cung mà sle păng chèn cung hử hau, xo tàu tứ kí cần hang thưng kí cần tàu.’ <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Kí cần đảy có tứ tiỉm slíp ất thưng, mọi cần đảy nhă̱n đơ-ni-ê nưng. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Nhằng kí cần tàu thưng, hau la̱i cạ làu co̱i nhă̱n đảy hẳm lai, tọ hau xày nhă̱n đảy đơ-ni-ê nưng xày. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Chíu nhă̱n chèn cung, hau cắt nháu lạo chảu la̱y, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />cạ: ‘Kí cần hang nảy tan hít tiỉm đeo, chảu te̱o păng hau tùng xị hung ngo̱, chư̱ kí cần tó hít cung nắc khỏ, xáu dẻng đét quá vằn.’ <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Tọ, lạo chảu hòi vàm cần nưng chang phang hau, cạ: ‘Ni̱ ới, ngo̱ mí tói ta̱i mí đay xáu ni̱ đơ! Bó chư̱ ni̱ tó chung ý xáu ngo̱ đơ-ni-ê nưng do̱ lừ? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Cứ căm au chèn cung cú ni̱, dá pay pay. Nhằng ngo̱ ái păng hử cần hang nảy tùng xị tó păng hử ni̱. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Do̱ va̱ ngo̱ bó đảy fép hít kí lo̱ ngo̱ mì xị làu ái a? Do̱ va̱ ni̱ đẳn ha vi̱ ngo̱ slim đay do̱ lừ?’ <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />Pìn nỉnh, cần hang co̱i pìn tàu, nhằng cần tàu te̱o pìn hang.”<verse eid="MAT 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Chíu pay khửn slẻng Giê-ru-sa-lem, Chảu Giê-xu au slíp nhi̱ cần nèm slon táng sle hử làu, tìng lo̱ pay, Min cạ hau: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Nho̱m ne̱, hung làu pay khửn slẻng Giê-ru-sa-lem, Lu̱c Cú Cần co̱i ngài no̱p hử kí slay pài xoòng tàu xáu kí slay slon luật, dá hau co̱i cáp xá khả hai Min <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />dá hau co̱i chao Min hử cần cú tum ti̱ táng sle hau khu slủm, cọn càn, xáu toóc teng Min tìng mạy các khoáy. Dá thưng vằn ta̱i slam, Min co̱i hòi te̱o.”<verse eid="MAT 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Chíu nỉnh, Xê-bê-đê xáu sloong lu̱c báo mà xảư Chảu Giê-xu, qu̱y lùng xáu xo Min lo̱ nưng. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />Min chảng đủi da̱: “Ni̱ ái xo lo̱ lăng?” Da̱ dăng: “Xo hử sloong lu̱c báo cú ngo̱ nảy, ò nưng đảy nă̱ng bưửng sla, ò nưng đảy nă̱ng bưửng slại cú tum ti̱ Chảu.” <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />Tọ Chảu Giê-xu hòi vàm: “Slam cần mí chắc lo̱ làu xo đơ. Sloong pi̱ noọng kin đảy choóc ngo̱ ái kin mí?” Hau dăng: “Hung ngo̱ kin đảy.” <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />Min cạ hau: “Pi̱ noọng co̱i kin choóc cú ngo̱, đảy nhằng nă̱ng bưửng sla do̱ bưửng slại ngo̱, do̱ ngo̱ mí hử đảy, tọ ti̱ nỉnh sle hử kí cần Pá ngo̱ chắp xặp xày.” <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />Ti̱ng pìn nỉnh dá, slíp cần nèm slon nỉnh fát slíng sloong pi̱ noọng nảy lai. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Tọ Chảu Giê-xu dảo hau thưng, dá cạ: “Pi̱ noọng chắc kí cần căm quỳn kí cần cú tum ti̱ táng do̱ đé đẩn cần làu, nhằng kí quan cải do̱ au quỳn sle cai cuủn hau. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Chang pi̱ noọng do̱ mí chư̱ pìn nỉnh. Tọ, hạy cần nàư ái hít cải chang pi̱ noọng, do̱ cần nỉnh lèo cung ta̱i pi̱ noọng, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />nhằng cần nàư ái hít tàu, do̱ lèo hít khỏi hử pi̱ noọng, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />tằng cạ Lu̱c Cú Cần thưng, mí chư̱ sle đảy cung ta̱i làu, tọ sle cung ta̱i dá slỉ mi̱ng làu sle cháu lai cần.”<verse eid="MAT 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Chíu Chảu Giê-xu xáu kí cần nèm slon tứ slẻng Giê-ri-cô oóc pay, mì phang cần nưng đung lai pay nèm Min. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Nho̱m nè, mì sloong cần fàng nă̱ng dú bưửng lo̱. Chíu đảy nghìn Chảu Giê-xu pay khoang quá nỉnh, do̱ hau moòng khửn cạ: “Pái Chảu, Lu̱c huùng Đa-vít, xo điíp sliít hung ngo̱!” <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Phang cần quáy sloong cần cạ, sle hau dú nim; tọ hau moòng hẳm cải: “Pái Chảu, Lu̱c huùng Đa-vít, xo điíp hung ngo̱ đủi.” <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />Chảu Giê-xu đử dú, dảo hau mà tham cạ: “Pi̱ noọng ái ngo̱ hít lăng hử pi̱ noọng?” <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Hau dăng: “Pái Chảu, xo hử ha hung ngo̱ đảy slu̱ng.” <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Chảu Giê-xu hăn chạư quá, chứng tu̱ng khảu ha hau. Chích slì hau đảy slu̱ng ha dá pay nèm Min.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Chíu Chảu Giê-xu xáu kí cần nèm slon thưng xảư slẻng Giê-ru-sa-lem, pay khảu bản Bết-pha-giê, bưửng Phja Ô-liu. Dú nỉnh, Min xoi sloong cần nèm slon pay cón, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />slắng hau cạ: “Cứ pay khảu bản tói nả, pi̱ noọng co̱i făn fi hăn tu lừ me̱ nưng ngài phúc, mì tu lừ lu̱c dú xảư. Cứ kẻ chưư̱c dá chung mà hử ngo̱. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Hạy mì cần nàư tham lăng, pi̱ noọng cứ hòi vàm cạ: ‘Chảu cẩn thưng boong min,’ dá cần nỉnh co̱i făn fi hử chung lừ pay.” <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />Lo̱ nảy oóc mà sle vàm cú cần páo cón đảy lình ính, cạ:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“Cứ cạ lu̱c slao Si-ôn cạ:</para>
  <para style="q1" vid="MAT 21:5">‘Nho̱m cà, Huùng mưng mà đủi mưng,</para>
  <para style="q1" vid="MAT 21:5">sli̱n ta̱o, khúy lừ</para>
  <para style="q1" vid="MAT 21:5">— nă̱ng tìng lừ lu̱c, chăn chư̱ lu̱c cú lừ me̱.’”<verse eid="MAT 21:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="MAT 21:6" />Sloong cần nèm slon chứng pay, hít chăn xị vàm Chảu Giê-xu tó slắng slon hau, <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />hau chung lừ me̱ xáu lừ lu̱c mà, pjái slử pao tìng lăng lừ, dá Min khúy khửn tìng. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Mì lai phang cần, pjái slử pao cú làu tìng lo̱, nhằng kỉ cần táng do̱ hẳm cáng mạy pjái tìng lo̱. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Kí phang cần pay cón, cần pay lăng xày khửn heng moòng, cạ:</para>
  <para style="q1" vid="MAT 21:9">“Hô-sa-na Lu̱c huùng Đa-vít!</para>
  <para style="q1" vid="MAT 21:9">Tài slung Lạo au mình Chảu mà thưng!</para>
  <para style="q1" vid="MAT 21:9">Hô-sa-na tìng ti̱ ta̱i slung!”<verse eid="MAT 21:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="MAT 21:10" />Chíu Min khảu Giê-ru-sa-lem, tằng slẻng xày moòng vang, chảng cạ: “Cần nàư nảy?” <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Phang cần hòi vàm: “Cần nảy chăn chư̱ Giê-xu, cần páo cón dú Na-xa-rét, slục búng Ga-li-lê.”<verse eid="MAT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Chảu Giê-xu khảu chang lưừn slớ, dá Min te̱p thuủn kí cần khai slự chang lưừn slớ, tảo xoòng cú kí cần chảo chèn xáu tảo tắng cú kí cần khai nục cu. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Min cạ hau: “Mì vàm slẻ: ‘Lưừn Ngo̱ co̱i đảy dảo cạ lưừn xỉnh chàu’, tọ kí ké hít ti̱ nảy pìn thẳm lặc cưứp.” <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />Kí cần fàng xáu què thưng xảư Min chang lưừn slớ, Min xày da đay hử hau. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Tọ slì kí slay pài xoòng tàu xáu kí slay slon luật hăn kí ha̱o pjòi Min hít, xáu hăn kí tu đích moòng khửn chang lưừn slớ: “Hô-sa-na Lu̱c huùng Đa-vít” do̱ hau fát slíng lai. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Hau chảng đủi Min: “Slay đảy nghìn kí tu đích nảy chảng lăng mí?” Tọ Chảu Giê-xu cạ hau: “Đảy nghìn. Kí ké xằng slắc pày to̱c cạ: ‘Chảu tó chắp xặp pác đích ón xáu kí đích nhằng kin nùm sle că̱n,’ do̱ lừ?” <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />Dá Min pja̱c hau, oóc khói slẻng sle pay thưng bản Bê-tha-ni dá quá khừn dú nỉnh.<verse eid="MAT 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Thưng naư lăng, chíu fan te̱o slẻng, do̱ Min dác. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Hăn co ngo̱a dú bưửng lo̱, Min thưng xảư tọ bó hăn mì lăng táng, tan chi̱n baư. Min cạ co ngo̱a: “Mưng co̱i bó pìn mác slắc pày dá,” co ngo̱a chứng ngoòng pay. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />Hăn pìn nỉnh, kí cần nèm slon he lai, chảng cạ: “Hít pìn lừ co ngo̱a te̱o ngoòng khoái pìn nảy?” <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Chảu Giê-xu hòi vàm hau: “Chăn, ngo̱ chảng đủi pi̱ noọng, hạy pi̱ noọng mì slim slấn, bó la̱i slắc í do̱ pi̱ noọng mí tan hít đảy pìn nảy hử co ngo̱a, te̱o nhằng cạ pò phja nảy: ‘Táng dảu khửn dá pu̱ng lùng hải pay’ tó nhằng đảy. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Hạy lo̱ lăng pi̱ noọng au slim slấn sle xỉnh chàu, do̱ pi̱ noọng xày co̱i nhă̱n đảy.”<verse eid="MAT 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Chảu Giê-xu khảu lưừn slớ, kí slay pài xoòng tàu xáu kí lạo ké chang phang cần mà tham chíu Min slon cạ: “Pừng khảu quỳn haư slay te̱o hít đảy kí lo̱ nảy, xáu cần nàư tó hử slay quỳn nỉnh?” <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Chảu Giê-xu hòi vàm hau: “Ngo̱ xày tham kí ké vàm nưng, hạy hòi vàm đảy, do̱ ngo̱ co̱i chảng hử kí ké chắc pừng khảu quỳn haư ngo̱ hít đảy kí lo̱ nảy. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Báp-têm cú Giăng — tứ haư thưng? Tứ fạ do̱ tứ tu cần?” Hau chứng lặc nẳm đủi căn: “Hạy hung làu chảng: ‘Tứ fạ,’ do̱ ké nỉnh co̱i tham hung làu: ‘Pìn nỉnh, hít lăng kí ké mí slấn Giăng?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Nhằng hạy hung làu cạ: ‘Tứ tu cần’ do̱ hung làu lao phang cần, vi̱ mọi cần xày ngòi Giăng chăn chư̱ cần páo vàm Chảu.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Hau chứng hòi vàm Chảu Giê-xu: “Hung ngo̱ mí chắc.” Min cạ hau: “Ngo̱ xày mí chảng hử kí ké chắc pừng khảu quỳn haư ngo̱ hít đảy kí lo̱ nảy.” <verse eid="MAT 21:27" /><verse number="28" style="v" sid="MAT 21:28" />“Kí ké nẳm lăng? Cần nưng mì sloong lu̱c báo; ké cạ ò lu̱c ta̱i tàu: ‘Lu̱c ới, vằn nảy lu̱c pay hít chang la̱y mác ít.’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Cần lu̱c báo nỉnh hòi vàm: ‘Lu̱c mí ái pay,’ tọ lăng slì nẳm te̱o, do̱ min pay. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Ké pay phúng ò lu̱c ta̱i nhi̱, xày chảng pìn nỉnh. Ò lu̱c nảy dăng: ‘Ờ, lu̱c pay,’ tọ min te̱o mí pay. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Chang sloong lu̱c báo nỉnh, cần nàư hít nèm slim pá?” Hau dăng: “Cần lu̱c ta̱i ít.” Chảu Giê-xu cạ hau: “Chăn, ngo̱ cạ kí ké, kí cần slau slé xáu slao hít eo co̱i đảy khảu tum ti̱ Chảu Fạ cón kí ké. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Vi̱ Giăng thưng sle cạ kí ké pay lo̱ cung chính, tọ kí ké mí slấn. Nhằng kí cần slau slé xáu slao hít eo tó slấn. Tọ kí ké hăn pìn nỉnh dá te̱o mí cho̱i xá sle slấn Giăng.<verse eid="MAT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Lèo ti̱ng pỉ xì táng nưng. Mì lạo chảu nưng chay la̱y mác ít nưng, lọm to̱i la̱y, bưửng đưng tào lù nưng sle ta̱p lảu, tẳng các slung sle pạư, hử kí cần chay mác ít có la̱y, dá ké pay quay quá ti̱ đai. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Thưng mù slau slặp mác ít, chảu xoi kí cần khỏi mà phúng kí cần chay mác ít sle slau fă̱n mác cú làu. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Tọ kí cần chay mác ít cặp kí cần khỏi cú chảu la̱y, cọn cần nảy, khả cần nỉnh, dá bẳn hin khảu cần táng. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Lạo chảu te̱o xoi kí cần khỏi táng thưng, hẳm đung cần quá phang cón, do̱ hau xày tói ta̱i xáu kí cần khỏi pìn nỉnh. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Sloót hang, lạo chảu xoi chăn lu̱c báo làu phúng hau, vi̱ nẳm cạ: ‘Hau co̱i dưư̱ng nả lu̱c báo làu.’ <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Tọ slì kí cần chay mác ít hăn cần lu̱c báo nỉnh do̱ chảng đủi căn: ‘Nảy chăn chư̱ ò lu̱c đảy táp cha xài. Hày, hung làu cứ khả min pay dá cheng au fă̱n cha xài cú min.’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Hau cặp cần lu̱c báo nỉnh, vẻng oóc noo̱c la̱y mác ít dá khả hai. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />Pìn nỉnh, slì chảu la̱y mác ít mà co̱i hít lăng xáu fưừng chay mác ít nỉnh?” <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Hau hòi vàm Min: “Lạo chảu co̱i khả hai phang cần too̱c éc nỉnh chíp tót lai, dá hử kí cần chay mác ít táng có la̱y, kí cần co̱i no̱p fă̱n mác hử ké khảu chăn mù.” <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />Chảu Giê-xu cạ hau: “Kí ké xằng to̱c vàm nảy chang Vàm Chảu Fạ do̱ lừ:</para>
  <para style="q1" vid="MAT 21:42">‘Ca̱o hin ngài po̱ xáy tả oóc,</para>
  <para style="q1" vid="MAT 21:42">tó pìn ca̱o hin cẩn díu cú ăn lưừn.</para>
  <para style="q1" vid="MAT 21:42">Chảu hít lo̱ nảy,</para>
  <para style="q1" vid="MAT 21:42">lo̱ nảy chăn chư̱ đay pjòi cón ha hung làu?’<verse eid="MAT 21:42" /></para>
  <para style="b" />
  <para style="m">
    <verse number="43" style="v" sid="MAT 21:43" />Pìn nỉnh, ngo̱ cạ kí ké, tum ti̱ Chảu Fạ co̱i ngài dò khói kí ké, tọ pảo hử nòi cần co̱i pìn mác hử tum ti̱ nỉnh. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Cần nàư lụp khảu hin nảy co̱i ngài phéc slé, nhằng hin nỉnh lút khảu cần nàư, do̱ co̱i bjải bjác cần nỉnh.” <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />Kí slay pài xoòng tàu xáu cần Pha-ri-si ti̱ng Min chảng kí pỉ xì do̱ chắc Min chảng mà làu. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Hau xa lo̱ cặp Min tọ te̱o lao phang cần, vi̱ mọi cần xày ngòi Min chăn chư̱ cần páo cón.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Chảu Giê-xu te̱o au pỉ xì cạ hau: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“Thiin ti̱ hút xị po̱ huùng nưng chắp xặp sli̱c lảu hử lu̱c làu. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Huùng xoi cần khỏi pay dảo kí cần đảy xỉnh mà sli̱c lảu, tọ hau mí ái thưng. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Huùng te̱o xoi kí cần khỏi táng pay, cạ: ‘Cứ dảo kí cần đảy xỉnh thưng: “Nỉnh cà, cú kin tó tọn oóc dá, kí tu mò xáu kí tu cú bẻo tó khả hít nự dá, mọi lo̱ hung slúc dá. Cứ mà nảy kin sli̱c.”’ <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Tọ hau tả pay, bó to sla̱y lăng thưng vàm xỉnh, cần do̱ pay oóc nà, cần do̱ pay khai slự. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Nhằng cần táng, do̱ cặp kí cần khỏi cú huùng, hít xảu nả, dá khả pay. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Huùng fát slíng, chứng xoi phang lỉnh pay chii̱t kí cần khả cần nỉnh, dá pung mảy slẻng cú hau. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Lăng nỉnh, huùng cạ kí cần khỏi cú làu: ‘Sli̱c lảu tó ính xình dá, tọ kí cần đảy xỉnh, do̱ bó cần nàư ngám sle kin. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Pìn nỉnh, cứ pay oóc kí lo̱ cải, xắn pi̱ noọng phúng cần nàư, do̱ xỉnh thuủn mà sli̱c lảu.’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Kí cần khỏi pay to̱i kí kha lo̱, xỏn xặp thuủn kí cần haư hau phúng, tằng cần đay, cần xảu, slảnh sli̱c lảu chứng tim khéc mà kin. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />Tọ, chíu khảu ngòi khéc kin sli̱c, huùng hăn cần nưng mí nu̱ng slử khóa sli̱c lảu. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Huùng cạ cần nỉnh: ‘Hày pàng dạu, hít lừ ni̱ mí nu̱ng slử khóa sli̱c lảu te̱o khảu sli̱c đảy?’ Tọ, cần nỉnh mí chảng đảy slắc vàm. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Huùng cạ kí cần khỏi: ‘Phúc mừ kha min khảu dá vẻng oóc ti̱ ngàu đăm bưửng noo̱c nỉnh, ti̱ co̱i mì hảy hấm xáu cắt fằn.’ <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Vi̱ lai cần đảy dảo, tọ nọi cần đảy lưư̱c.”<verse eid="MAT 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Kí cần Pha-ri-si chứng tả pay, oóc kí màu, xa lo̱ sle hảng Chảu Giê-xu mà vàm chảng. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Hau xoi kí cần nèm slon làu xáu kí cần cú fưừng Hê-rốt mà dăng xáu Chảu Giê-xu, cạ: “Slay ới, hung ngo̱ chắc slay chư̱ cần chăn chính, slon lo̱ cú Chảu Fạ chăn slim, mí nghiíng mà slắc cần, vi̱ slay mí nho̱m bưửng noo̱c hau. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Pìn nỉnh, xo hử hung ngo̱ chắc slay nẳm pìn lừ: Đảy no̱p slé hử Sê-sa mí?” <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />Tọ Chảu Giê-xu chắc slim hau xan chứng hòi vàm: “Kí cần pjàng mja̱p nỉnh ới, hít lăng kí ké xi ngo̱? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Cứ hử ngo̱ nho̱m mưn chèn au pay no̱p slé.” Hau au hử Min mưn đơ-ni-ê nưng. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Min tham hau: “Slưứng xáu mình nảy cú cần nàư?” <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Hau dăng: “Cú Sê-sa.” Min chứng cạ hau: “Pìn nỉnh, cứ păng hử Sê-sa kí lo̱ cú Sê-sa, xáu păng hử Chảu Fạ kí lo̱ cú Chảu Fạ.” <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Ti̱ng vàm nỉnh, hau hăn lạ dá tả Min pay.<verse eid="MAT 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Khảu vằn nỉnh, kí cần Sa-đu-sê, vi̱ phang cần nảy cạ mí mì lo̱ hòi te̱o, chứng mà xảư tham Min, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />cạ: “Slay ới, Môi-se tó cạ: ‘Hạy cần nưng hai te̱o mí mì lu̱c do̱ noọng báo cần nỉnh lèo au me̱ cú pi̱ báo sle mì lu̱c hử pi̱ báo làu.’ <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Cà nạy, chang hung ngo̱ mì chất pi̱ noọng báo; cần ta̱i tàu au me̱, dá hai, tọ te̱o sle me̱ làu hử noọng báo vi̱ mí mì lu̱c. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Cần ta̱i nhi̱, dá cần ta̱i slam, thưng cần ta̱i chất xày pìn nỉnh. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Sloót hang, cần ti̱ me̱ xày hai pay. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Pìn nỉnh, chíu hòi te̱o, cần ti̱ me̱ nỉnh co̱i pìn me̱ cú cần nàư chang chất cần? Vi̱ thuủn chất cần xày tó au me̱ nỉnh.” <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />Chảu Giê-xu hòi vàm hau: “Kí ké lùm dá, vi̱ di̱ mí chắc Vàm Chảu Fạ, di̱ mí chắc quỳn fép cú Chảu Fạ. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Vi̱ chíu hòi te̱o, hau co̱i bó au me̱, xày bó au po̱, tọ hau hút xị cần tang nả dú tìng fạ xày. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Nhằng mà lo̱ cần hai hòi te̱o, do̱ kí ké xằng to̱c vàm Chảu Fạ cạ làu, cạ: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Ngo̱ chăn chư̱ Chảu Fạ cú Áp-ra-ham, Chảu Fạ cú Y-sác, Chảu Fạ cú Gia-cốp’ Chảu Fạ mí chư̱ cú cần hai, tọ cú cần te̱o.” <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />Chíu phang cần ti̱ng vàm nảy, hau he mà vàm Min slon cạ lai.<verse eid="MAT 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Chíu đảy nghìn Chảu Giê-xu tó hít hử phang Sa-đu-sê lèo hắp pác, do̱ kí cần Pha-ri-si ho̱p căn te̱o. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Slay luật nưng chang phang hau tham, sle xi Min — <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Slay ới, chang luật fáp, vàm slon cạ haư cải ta̱i tàu?” <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Chảu Giê-xu hòi vàm cần nỉnh: “‘Lèo thuủn slim kiính điíp Chảu chư̱ Chảu Fạ cú lu̱c, lèo thuủn khoăn mi̱ng, thuủn slim ki cú lu̱c.’ <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Vàm slon cạ nỉnh chăn chư̱ cải xáu cẩn díu tàu. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Nhằng vàm slon cạ ta̱i nhi̱ xày hút pìn nỉnh — ‘Lu̱c lèo điíp cần xảư xảng xị chăn làu.’ <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Thuủn luật fáp xáu vàm páo cón cú Chảu xày slục khảu sloong vàm slon cạ nảy.”<verse eid="MAT 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Chíu nỉnh, kí cần Pha-ri-si ho̱p căn te̱o, Chảu Giê-xu tham hau, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />cạ: “Kí ké nẳm pìn lừ mà Chảu Cháu Ti̱ Da̱? Min pìn lu̱c cú cần nàư?” Hau hòi vàm Min: “Lu̱c huùng Đa-vít.” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Min cạ hau: “Pìn nỉnh, hít lăng huùng Đa-vít chang Chảu Khoăn te̱o dảo Min hít Chảu, xáu cạ:<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />‘Chảu cạ xáu Chảu ngo̱:</para>
  <para style="q1" vid="MAT 22:44">“Cứ nă̱ng dú bưửng sla Ngo̱,</para>
  <para style="q1" vid="MAT 22:44">thưng slì Ngo̱ tặt cần tói tàu lu̱c tảư kha lu̱c”’?<verse eid="MAT 22:44" /></para>
  <para style="b" />
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Hạy huùng Đa-vít dảo Min hít ‘Chảu’ do̱ hít lừ Min te̱o pìn lu̱c cú huùng nỉnh đảy?” <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Mí mì cần nàư dăng đảy slắc vàm, tứ vằn nỉnh, mí cần nàư nhằng cảm tham Min lo̱ lăng dá.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Túc lăng, Chảu Giê-xu cạ phang cần xáu kí cần nèm slon làu, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />cạ: “Kí slay slon luật xáu cần Pha-ri-si xày nă̱ng tìng tắng cú Môi-se. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Pìn nỉnh, hạy hau cạ pi̱ noọng hít nèm xáu cỏ mọi lo̱. Tọ mí đảy hít nèm kí lo̱ hau hít, vi̱ hau tan chảng đai te̱o mí hít. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Hau phúc xáu tặt kí háp nắc mí háp đảy tìng bá cần đai, nhằng chăn hau do̱ bó ái tu̱ng nịu mừ khảu. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Hung min hít mọi lo̱ tan sle cần táng nho̱m hăn. Vi̱ hau hít kí kép pí kinh luật chăn cải, slan kí cùng slử mì fáu chăn chư̱ lì. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Hau nắt nă̱ng ti̱ mì ha nả chang tón kin xáu kí tắng cẩn díu ta̱i tàu chang kí lưừn ho̱i, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />xáu mu̱ng đảy phang cần tuụng chang háng, xáu đảy dảo hít ‘Ra-bi.’ <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Tọ pi̱ noọng mí đảy sle cần nàư dảo làu hít ‘Ra-bi’, vi̱ pi̱ noọng tan mì slay nưng, nhằng mọi cần xày chư̱ pi̱ noọng đủi căn. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Xày mí đảy dảo slắc cần nàư tìng tum nảy hít ‘pá’ vi̱ pi̱ noọng tan mì Pá nưng dú tìng fạ. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Xày mí đảy sle cần nàư dảo làu hít ‘chảu,’ vi̱ pi̱ noọng tan mì Chảu nưng — chư̱ Chảu Cháu Ti̱ Da̱. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Cần nàư cải tàu chang pi̱ noọng, lèo hít khỏi hử pi̱ noọng. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Xắn cần nàư táng tài làu khửn, do̱ co̱i ngài au lùng; nhằng cần nàư táng tặt làu lùng, do̱ co̱i đảy tài khửn.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Slói hử kí ké, kí slay slon luật xáu cần Pha-ri-si, chư̱ kí cần pjàng mja̱p! Vi̱ pi̱ noọng hắp tu thiin ti̱ tói nả hau. Vi̱ kí ké tó mí khảu, tọ te̱o mí hử kí cần ái mu̱ng khảu nỉnh num. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />[Slói hử kí ké, kí slay slon luật xáu cần Pha-ri-si, chư̱ kí cần pjàng mja̱p nỉnh! Vi̱ kí ké cưứp au lưừn me̱ mải, te̱o chả loóc xỉnh chàu hử lì, Pìn nỉnh, kí ké co̱i ngài fa̱t nắc num.] <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />Slói hử kí ké, kí slay slon luật xáu cần Pha-ri-si, chăn chư̱ kí cần pjàng mja̱p! Vi̱ pi̱ noọng pay quá hải xáu tum lẹng sle hít hử cần nưng khảu đạo; tọ slì hăn cần nỉnh khảu đạo dá, kí ké te̱o hít hử cần nỉnh pìn lu̱c cú ngục fày slặp sloong kí ké.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Slói hử kí ké, kí cần tái lo̱ bót fàng, kí ké chảng cạ: ‘Hạy cần nàư chỉ lưừn slớ pao xình, do̱ bó ngài lăng. Tọ cần nàư chỉ khảu kim cú lưừn slớ pao xình, do̱ co̱i ngài phúc khảu vàm pao xình nỉnh.’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Hày kí cần tăn bả xáu bót fàng nỉnh ới! Kim do̱ va̱ lưừn slớ hít kim pìn slaư tích, ăn haư hẳm cẩn díu? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Te̱o nhằng chảng cạ: ‘Hạy cần nàư chỉ xoòng xằn pao xình, do̱ bó ngài lăng. Tọ hạy cần nàư cạ cú cái pài tìng xoòng xằn pao xình, do̱ ngài phúc khảu nỉnh.’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Kí cần tăn bả xáu bót fàng nỉnh ới! Cú cái do̱ va̱ xoòng xằn hít hử cú cái pìn thánh, ăn haư hẳm cẩn díu? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Pìn nỉnh, cần nàư chỉ xoòng xằn pao xình, do̱ chăn chư̱ chỉ xoòng xằn tằng cú cái tìng nỉnh pao xình dá. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Cần nàư chỉ lưừn slớ pao xình, do̱ chăn chư̱ chỉ lưừn slớ xáu tằng Lạo dú ti̱ nỉnh pao xình. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Cần nàư chỉ fạ pao xình, chư̱ chỉ tắng kim cú Chảu Fạ xáu tằng Lạo nă̱ng dú tìng tắng kim nỉnh pao xình.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Slói hử kí ké, kí slay slon luật xáu cần Pha-ri-si, chư̱ kí cần pjàng mja̱p! Vi̱ kí ké pài fă̱n slíp phjắc hom, dìm sli, xáu phjắc cần, tọ te̱o lùm kí lo̱ cẩn díu chang luật fáp — xị cạ cung chính, slim điíp sliít, xáu slim slấn. Kí ké lèo hít kí lo̱ nảy, tọ xày mí đảy tả kí lo̱ nỉnh. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Hày kí cần tái lo̱ bót fàng nỉnh ới, pi̱ noọng tả tu mèng nhùng sláy slít, te̱o nận tằng tu lạc đà!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Slói hử kí ké, kí slay slụ luật xáu cần Pha-ri-si, chư̱ kí cần pjàng mja̱p! Vi̱ kí ké slào slaư bưửng noo̱c thủi cha̱m, tọ bưửng đưng do̱ tim kí lo̱ thám cò xáu pjuúng pjúi. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Hày cần Pha-ri-si bót fàng nỉnh ới! Ta̱i tàu, lèo slào bưửng đưng thủi cha̱m, sle bưửng noo̱c xày đảy slaư.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Slói hử kí ké, kí slay slon luật xáu cần Pha-ri-si, chư̱ kí cần pjàng mja̱p! Vi̱ kí ké hút xị kí ăn fằn pải hoi khao, nho̱m đay đắn bưửng noo̱c, tọ bưửng đưng do̱ tim đúc cần hai xáu mọi lo̱ slẳm sla̱p. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Xày pìn nỉnh, bưửng noo̱c kí ké hít xị cung chính tói nả hau, tọ bưửng đưng kí ké do̱ tim kí lo̱ too̱c éc xáu pjàng mja̱p.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Slói hử kí ké, kí slay slon luật xáu cần Pha-ri-si, chư̱ kí cần pjàng mja̱p! Vi̱ kí ké xáy fằn cú kí cần páo cón, chang chỉnh đay đắn fằn cú kí cần cung chính. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Kí ké chảng: ‘Hạy hung ngo̱ dú xày tơ̱i đủi kí cúc chỏ làu, cay hung ngo̱ mí tò xày hau khả kí cần páo cón lố.’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Pìn nỉnh, kí ké táng hít chửng cạ làu chư̱ lu̱c lan cú kí cần khả hai kí cần páo cón, <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />kí ké cứ đíng hử tim fựn phít xá cú cúc chỏ kí ké pay! <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Chủng ngù kheo too̱c éc nỉnh ới, hít lừ kí ké ni khói ngục fày ứn chá đảy? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Pìn nỉnh, ngo̱ xoi kí cần páo cón, kí cần quai kí, kí slay slon luật mà đủi kí ké, kí ké co̱i khả xáu toóc teng kí cần nảy khảu mạy các khoáy, kí ké cọn hau chang lưừn ho̱i xáu hít khỏ hau tứ slẻng nảy thưng slẻng đai, <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />sle, lưư̱t cú thuủn kí cần cung chính tó lay oóc tìng tum xày đíng tìng kí ké, tứ lưư̱t cú A-bên, cần cung chính thưng lưư̱t cú Xa-cha-ri lu̱c báo Ba-ra-chi, cần kí ké tó khả hai dú chang lưừn slớ xáu xoòng xằn. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Chăn, ngo̱ cạ kí ké, mọi lo̱ nỉnh co̱i mì oóc hử xám cần nảy.”<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“Giê-ru-sa-lem, Giê-ru-sa-lem ới, mưng khả hai kí cần páo cón dá bẳn hin kí cần đảy xoi mà đủi mưng! Tó kỉ lai pày ngo̱ ái xỏn lu̱c mưng xị cáy me̱ cúc cáy lu̱c dú tảư pích tọ hung mưng mí ái! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Ne̱, lưừn cú kí ké co̱i ngài tả đai. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Vi̱ ngo̱ cạ kí ké, kí ké co̱i mí hăn ngo̱ tứ cà nạy thưng chíu kí ké chảng: ‘Fúc hử Lạo au mình Chảu Fạ mà thưng!’”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Slì Chảu Giê-xu oóc khói lưừn slớ, kí cần nèm slon mà xảư chỉ hử Min ngòi thuủn mọi ăn lưừn chang lưừn slớ. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Min cạ: “Pi̱ noọng nho̱m mí hăn mọi lo̱ nảy a? Chăn, ngo̱ cạ pi̱ noọng, ti̱ nảy co̱i mí nhằng ca̱o hin haư táp tìng ca̱o hin táng te̱o mí ngài tấm lùng.”<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Chíu nă̱ng tìng phja Ô-liu, kí cần nèm slon mà tham tan Min, cạ: “Xo chảng hử hung ngo̱ chắc mư̱ haư kí lo̱ nỉnh co̱i mì oóc, xáu mì ha̱o lăng páo cón mà vằn slay fan te̱o xáu vằn sloót hang?” <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Chảu Giê-xu hòi vàm hau: “Lèo slỉng sla̱c, sle mí cần nàư hít hử pi̱ noọng lùm slại. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Vi̱ co̱i mì lai cần chá au mình ngo̱ mà chảng cạ: ‘Chăn ngo̱ chư̱ Chảu Cháu Ti̱ Da̱’ sle hít hử lai cần lùm slại. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Pi̱ noọng co̱i ti̱ng mì tức căn xáu kí vàm slình mà tức căn. Pi̱ noọng lèo slỉu slim, mí đảy slim luu̱n, vi̱ kí lo̱ nảy lèo mì oóc, tọ xằng chư̱ sloót hang đơ. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Vi̱ cần tum ti̱ nảy co̱i fản khửn tói tỉng xáu cần tum ti̱ táng, tum ti̱ nảy tói tỉng xáu tum ti̱ táng, dá slỉu dác, fựn tum co̱i mì oóc dú lai ti̱. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Thuủn kí lo̱ nảy tan chư̱ khay cúc cú kí xá chíp fựn đang. <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />Chíu nỉnh, hau co̱i hít hử pi̱ noọng ngài chai na̱n dá khả hai pi̱ noọng, pi̱ noọng co̱i ngài mọi nòi cần xằng vi̱ mình ngo̱. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Dá lai cần co̱i ngài toỏng lụp, fản căn, xằng pè căn. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Lai cần chá páo vàm Chảu co̱i oóc nả, hít hử lai cần lùm slại. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Vi̱ too̱c éc lai khửn, slim điíp cú lai cần chứng co̱i lưừng pay. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Tọ cần nàư mắn slim thưng sloót hang, do̱ cần nỉnh co̱i đảy cháu. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Vàm Đay mà thiin ti̱ co̱i đảy páo oóc to̱i ti̱ da̱ sle hít chửng hử mọi nòi cần; chíu nỉnh chứng thưng vằn sloót hang.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />Chíu pi̱ noọng hăn lo̱ slẳm sla̱p hít slán slác chang ti̱ thánh, xị vàm Đa-ni-ên páo cón” (cần nàư to̱c lèo slụ), <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />“chíu nỉnh, cần nàư dú búng Giu-đê, cứ ni thưng ti̱ phja; <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />cần nàư dú tìng pài lưừn, mí đảy lùng au cú cái lăng khói lưừn làu, <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />cần nàư dú noo̱c tu̱ng, mí đảy fan te̱o sle au slử pao. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Slói tháy hử kí ti̱ me̱ làm đang xáu kí me̱ nhằng hử lu̱c kin nùm chang kí vằn nỉnh! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Lèo xỉnh chàu sle pi̱ noọng mí lèo le̱n ni khảu mù đảng do̱ va̱ khảu vằn Sa-bát. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Vi̱ chíu nỉnh co̱i mì chai na̱n cải, tứ tẳm chí oóc ti̱ da̱ thưng cà nạy xằng hăn mì, xáu mư̱ lăng xày bó mì pìn nỉnh slắc pày. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Hạy kí vằn nỉnh mí đảy thót tẩn do̱ cay bó mì cần nàư đảy cháu. Tọ, vi̱ kí cần đảy lưư̱c kí vằn nỉnh chứng co̱i đảy thót tẩn. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Chíu nỉnh, hạy mì cần nàư cạ pi̱ noọng: ‘Nỉnh cà, Chảu Cháu Ti̱ Da̱ dú nảy,’ do̱ va̱ ‘dú nỉnh’ do̱ pi̱ noọng mí đảy slấn. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Vi̱ kí cần chá mình chảu xáu kí cần chá páo cón co̱i oóc nả xáu hít lai ha̱o pjòi fép lạ cải sle hít hử lùm slại; hạy đảy, hau pjàng pjào tằng kí cần đảy lưư̱c. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Ne̱, ngo̱ tó cạ cón hử pi̱ noọng dá. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />Pìn nỉnh, hạy hau cạ pi̱ noọng: ‘Nỉnh cà, Chảu dú chang tu̱ng lẹng’ do̱ pi̱ noọng mí đảy oóc nỉnh. Xáu cạ: ‘Nỉnh cà, Chảu dú chang kí hó khít lít’ do̱ pi̱ noọng mí đảy slấn. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Vi̱ xị me̱p slu̱ng tứ bưửng tung, me̱p slu̱ng thưng bưửng slay pìn lừ, do̱ Lu̱c Cú Cần xày co̱i thưng pìn nỉnh. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Hạy chạp hai dú càư, nục lă̱m tom thưng nỉnh.<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Lăng kí vằn chai na̱n nỉnh, ha vằn co̱i đăm, puúng hai co̱i mí xoi slu̱ng, kí đao đí co̱i tứ fạ lút lùng, dá kí quỳn slèng tìng fạ co̱i ngài dỏn slim. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Chíu nỉnh, ha̱o mà Lu̱c Cú Cần co̱i mì oóc dú tìng fạ, mọi nòi cần tìng ti̱ da̱ thán hảy. Hau co̱i hăn Lu̱c Cú Cần au quỳn fép xáu slu̱ng phjưức tứ phử fạ mà thưng. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Min co̱i xoi cần tang nả fạ au pí lè moòng vang, sle ho̱p kí cần đảy lưư̱c dú to̱i slí chái, tứ hang fuung fạ nảy thưng hang fuung fạ nỉnh.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />Cứ nẳm mà pỉ xì tứ co ngo̱a. Chíu cáng min ón xáu bút nhoo̱t, oóc baư do̱ pi̱ noọng chắc mù đưứt ái thưng. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Xày pìn nỉnh, slì pi̱ noọng hăn mọi lo̱ nảy, do̱ chắc cạ Lu̱c Cú Cần tó mà xảư, dú ngay pác tu. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Chăn, ngo̱ cạ pi̱ noọng, xám cần nảy co̱i mí quá pay thưng slì mọi lo̱ nỉnh mì oóc. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Tum fạ nảy co̱i quá pay, tọ kí vàm ngo̱ cạ co̱i mí quá pay slắc pày đơ. <verse eid="MAT 24:35" /><verse number="36" style="v" sid="MAT 24:36" />Nhằng mà vằn xáu tiỉm nỉnh, do̱ mí cần nàư chắc đảy, tằng kí cần tang nả fạ do̱ va̱ Lu̱c xày pìn nỉnh, tan Pá chắc xày. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Xị chang tơ̱i Nô-ê pìn lừ, do̱ Lu̱c Cú Cần xày co̱i thưng pìn nỉnh. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Chang kí vằn xằng mì nặm noòng, hau kin nhẳm, au me̱, au po̱, thưng vằn Nô-ê khảu fỏ xiìn, <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />hau bó chắc lăng thưng slì nặm noòng mà xáu quỷn pay thuủn — slì Lu̱c Cú Cần thưng xày co̱i pìn nỉnh. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Chíu nỉnh, mì sloong cần dú noo̱c tu̱ng — cần nưng đảy au pay, cần nưng ngài tả dú. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Sloong cần ti̱ me̱ mu̱ chục — cần nưng đảy au pay, cần nưng ngài tả dú. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />Pìn nỉnh, lèo slỉng sla̱c, vi̱ pi̱ noọng mí chắc vằn haư Chảu làu co̱i mà. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Tọ, pi̱ noọng lèo chắc pìn nảy, hạy chảu lưừn chắc mư̱ haư ò lặc thưng, do̱ cay ké co̱i slỉng sla̱c, sle ò lặc mí khảu lưừn làu. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Pìn nỉnh, pi̱ noọng xày lèo ính xình, vi̱ Lu̱c Cú Cần thưng khảu tiỉm pi̱ noọng mí nẳm thưng.<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Pìn nỉnh, cần nàư hít khỏi slim đeo xáu quai kí, đảy chảu hử hít cuủn lưừn làu sle păn cú kin chăn tiỉm? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Fúc hử cần khỏi nỉnh, slì chảu mà hăn hít pìn nỉnh. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Chăn, ngo̱ cạ pi̱ noọng, chảu co̱i chao hử cần khỏi nỉnh cai cuủn mọi cha xài cú làu. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Tọ hạy cần khỏi too̱c éc nỉnh lặc nẳm cạ: ‘Chảu làu xằng mà cà nạy đơ,’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />dá xo tàu cọn kí pàng dạu tò hít khỏi xị làu, kin nhẳm xáu fưừng lảu màu, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />lạo chảu co̱i mà chang vằn khỏi mí nẳm thưng, chang slì min mí chắc. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Chảu co̱i fa̱t min nắc lai, hử min tảy nèm fă̱n xáu kí cần pjàng mja̱p; dú ti̱ co̱i mì hảy hấm xáu cắt fằn.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Pìn nỉnh, thiin ti̱ co̱i pỉ xị slíp slao nóm căm tưng pay tỏn po̱ khưi. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Chang nỉnh, mì hả slao bả xáu hả slao quai. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Kí slao bả au tưng tọ mí au dù pay nèm. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Nhằng kí slao quai tức dù khảu pình xáu tằng tưng pay nèm. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Vi̱ po̱ khưi thưng lả, kí slao chứng slừ nòn dá nòn lưứt pay. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />Tọ thưng chang khừn, mì heng dảo: ‘Po̱ khưi thưng nỉnh cà! Oóc tỏn min pay.’ <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Kí slao nóm nỉnh tấn xáu chắp xặp tưng cú làu. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Kí slao bả chứng cạ slao quai: ‘Xo hử hung lại íng dù nưng vi̱ tưng cú hung lại ái đắp dá.’ <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Tọ kí slao quai hòi vàm: ‘Mí đảy đơ, co̱i mí đo hử tằng kí noọng xáu kí ché. Kí noọng pay thưng ti̱ cần khai dù slự au hẳm đay.’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Tọ, chang slì hau pay slự, do̱ po̱ khưi thưng, kí cần tó ính xình do̱ pay đủi po̱ khưi khảu sli̱c lảu, dá pha tu đảy hắp khảu. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />Lăng íng nưng, kí slao nóm bả xày thưng, dăng cạ: ‘Chảu ới, chảu ới, xo khay tu hử hung ngo̱ đủi.’ <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Tọ lạo chảu hòi vàm: ‘Ngo̱ cạ chăn xáu kí slao, ngo̱ mí chắc kí slao đơ.’ <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />Pìn nỉnh, lèo slỉng sla̱c, vi̱ pi̱ noọng mí chắc vằn, xày mí chắc tiỉm.<verse eid="MAT 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />Vi̱ thiin ti̱ co̱i hút xị cần nưng ái khửn lo̱ pay quay, dảo kí cần khỏi te̱o xáu chao cha xài làu hử hau. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Lạo chảu chao hử cần nảy hả ta-lâng, cần đai sloong, cần táng num ta-lâng — nưng, nho̱m khảu slèng cú cần pìn cần. Dá chảu khửn lo̱ pay quay. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Lạo chảu pay khói dá, cần đảy nhă̱n hả ta-lâng chứng pay hít cha̱n oóc đảy hả ta-lâng num. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Cần nhă̱n sloong ta-lâng xày hít oóc đảy sloong ta-lâng num. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Tọ, cần tó nhă̱n đảy ta-lâng nưng do̱ pay tào tum dá dò ngừn cú chảu làu. <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />Lăng hả lai hưng, chảu cú kí cần khỏi nảy fan te̱o sle cay sló đủi hau. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Cần tó nhă̱n hả ta-lâng thưng, au nèm hả ta-lâng num, chảng cạ: ‘Lạo chảu ới, chảu tó chao hử lại hả ta-lâng, nảy cà, lại tó hít cha̱n oóc đảy hả ta-lâng num.’ <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Lạo chảu cạ cần nỉnh: ‘Đảy vớ, cần khỏi slim đay xáu slim đeo nỉnh ới. Ni̱ tó slim đeo chang cung sla̱y sláy. Ngo̱ co̱i tặt ni̱ cai cuủn lai. Cứ khảu nảy tò hun hỉ đủi chảu ni̱.’ <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Cần tó nhă̱n sloong ta-lâng xày thưng xáu cạ: ‘Lạo chảu ới, chảu tó chao hử lại sloong ta-lâng, nảy cà, lại tó hít cha̱n oóc đảy sloong ta-lâng num.’ <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Lạo chảu cạ cần nỉnh: ‘Đảy lai, cần khỏi slim đay xáu slim đeo nỉnh ới! Ni̱ tó slim đeo chang cung sla̱y sláy, ngo̱ co̱i tặt ni̱ cai cuủn lai. Cứ khảu nảy tò hun hỉ đủi chảu ni̱.’ <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Nhằng cần tó nhă̱n ta-lâng nưng xày thưng xáu cạ: ‘Lạo chảu ới, lại chắc chảu chư̱ cần kheng khên, cùn ti̱ làu mí ván, slau ti̱ làu mí ván oóc. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Lại lao, chứng dò pay ta-lâng cú chảu dú tảư tum. Nảy, xo păng te̱o hử chảu kí lo̱ cú chảu.’ <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Tọ chảu hòi vàm: ‘Cần khỏi too̱c éc xáu chạn hít nỉnh ới! Chư̱ ni̱ chắc cạ ngo̱ cùn ti̱ ngo̱ mí ván, xáu slau ti̱ ngo̱ mí ván mí? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Pìn nỉnh do̱, ni̱ lèo chao ngừn cú ngo̱ hử kí cần puún ngừn, sle slì fan te̱o ngo̱ co̱i nhă̱n tằng cúc xăm cha̱n. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Pìn nỉnh, cứ au ta-lâng khói cần nảy dèn hử cần mì slíp ta-lâng. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Vi̱ cần nàư mì, co̱i đảy hử num — sle hau đảy fúng fàu. Tọ cần nàư mí mì, co̱i ngài dò pay tằng kí lo̱ hau mì num. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Nhằng cần khỏi va̱i đai nỉnh, cứ vẻng min oóc ti̱ ngàu đăm bưửng noo̱c, ti̱ nỉnh co̱i mì hảy hấm xáu cắt fằn.’<verse eid="MAT 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Chíu Lu̱c Cú Cần mà chang slu̱ng phjưức làu xáu kí cần tang nả fạ, do̱ Min co̱i nă̱ng tìng tắng kim slu̱ng phjưức. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Mọi nòi cần co̱i kẻo mà tói nả Min; xáu Min co̱i păn hau oóc xị cần hen păn tu chiin oóc khói tu bẻ. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Min sle chiin dú bưửng sla, nhằng bẻ dú bưửng slại. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Chíu nỉnh, Huùng co̱i cạ kí cần dú bưửng sla: ‘Kí cần đảy Pá Ngo̱ pảo fúc nỉnh ới, cứ mà nảy táp au thiin ti̱ tó đảy chắp xặp hử pi̱ noọng tứ slì tum fạ đảy hít pìn. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Vi̱ Ngo̱ dác, kí lu̱c hử Ngo̱ kin; Ngo̱ cò khấư, kí lu̱c hử Ngo̱ kin nặm; Ngo̱ xị khéc, kí lu̱c nhằng chiíp tỏn Ngo̱; <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Ngo̱ kẻ ca̱ng, kí lu̱c nu̱ng hử Ngo̱; Ngo̱ khảy màu, kí lu̱c chưứng chực Ngo̱; Ngo̱ ngài xăng, kí lu̱c mà dưưng Ngo̱.’ <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Chíu nỉnh, kí cần cung chính dăng Min, cạ: ‘Pái Chảu, mì slắc pày hung lu̱c hăn Chảu dác te̱o hử kin, do̱ va̱ cò khấư te̱o hử kin nặm haư? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Mì slắc pày hung lu̱c hăn Chảu xị khéc te̱o chiíp tỏn, do̱ va̱ kẻ ca̱ng te̱o nu̱ng hử Chảu haư? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Do̱ va̱ mì slắc pày hung lu̱c hăn Chảu khảy màu do̱ va̱ ngài xăng te̱o mà dưưng Chảu haư?’ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Huùng co̱i hòi vàm hau cạ: ‘Chăn, Ngo̱ cạ kí lu̱c, slì kí lu̱c hít lo̱ nỉnh hử cần tắm sláy ta̱i ít chang kí pi̱ noọng nảy cú Ngo̱, chăn xị kí lu̱c tó hít hử Ngo̱.’ <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />Dá Huùng xày cạ kí cần dú bưửng slại: ‘Hày kí cần ngài bjắc bjỏi ới, cứ thói oóc khói Ngo̱, pay khảu fày tơ̱i tơ̱i tó chắp xặp hử kí chảu phi sla̱ xáu kí phi sla̱ cú min. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Vi̱ Ngo̱ dác, pi̱ noọng mí hử Ngo̱ kin; Ngo̱ cò khấư, pi̱ noọng mí hử Ngo̱ kin nặm; <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Ngo̱ xị khéc, pi̱ noọng mí chiíp tỏn Ngo̱; Ngo̱ kẻ ca̱ng, pi̱ noọng mí nu̱ng hử Ngo̱; Ngo̱ khảy màu xáu ngài xăng pi̱ noọng mí dưưng Ngo̱.’ <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Chíu nỉnh, kí cần nảy xày hòi vàm: ‘Pái Chảu, mì slì haư hung lại hăn Chảu dác, do̱ va̱ cò khấư, do̱ va̱ xị khéc, do̱ va̱ kẻ ca̱ng, do̱ va̱ khảy màu, do̱ va̱ ngài xăng te̱o mí cung ta̱i Chảu haư?’ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Huùng co̱i hòi vàm hau cạ: ‘Chăn, Ngo̱ cạ kí cần ni̱, hạy kí cần ni̱ mí hít pìn nỉnh hử cần sláy ta̱i ít chang kí cần nảy, do̱ kí cần ni̱ tó mí hít hử Ngo̱.’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Dá kí cần nảy co̱i pay khảu ti̱ fa̱t tơ̱i tơ̱i, nhằng kí cần cung chính co̱i đảy khảu lo̱ te̱o tơ̱i tơ̱i.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Chíu Chảu Giê-xu cạ thuủn kí vàm nỉnh dá, Min te̱o cạ kí cần nèm slon làu: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Pi̱ noọng chắc cạ nhằng sloong vằn num thưng le̱ Khảm Quá, xáu Lu̱c Cú Cần co̱i ngài no̱p sle tảy toóc teng tìng mạy các khoáy.” <verse eid="MAT 26:2" /><verse number="3" style="v" sid="MAT 26:3" />Chíu nỉnh, kí slay pài xoòng tàu xáu kí lạo ké chang phang cần ho̱p te̱o dú slảnh cú slay pài xoòng ta̱i tàu, mìng hít Cai-phe. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Hau oóc kí màu sle cặp xáu khả hai Chảu Giê-xu. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Tọ hau cạ: “Mí đảy oóc mừ chang vằn le̱, sle mí hít luu̱n lạo phang cần.”<verse eid="MAT 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Chíu Chảu Giê-xu dú bản Bê-tha-ni, lưừn Si-môn, ngài hảu, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />mì cần ti̱ me̱ nưng au pình pảo to dù hom tảy lai chèn mà xảư Min, đíng khửn hu Min chíu Min nă̱ng dú xoòng kin. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Hăn pìn nỉnh do̱ kí cần nèm slon fát slíng chứng cạ: “Hít lừ te̱o hít va̱i đai dù pìn nỉnh? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Vi̱ co̱i khai dù đảy lai chèn, sle pang cho̱i cần khỏ.” <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />Tọ Chảu Giê-xu chắc pìn nỉnh chứng cạ kí cần nèm slon: “Hít lăng pi̱ noọng hít khỏ cần ti̱ me̱ nảy? Cần nảy tó hít lo̱ đay nưng hử ngo̱. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Vi̱ pi̱ noọng mì cần khỏ dú xảư làu mại, tọ mí chư̱ slì haư xày mì ngo̱ đơ. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Cần ti̱ me̱ đíng dù nảy khửn đúc đang ngo̱, sle chắp xặp hử lo̱ phăng dò ngo̱. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Chăn, ngo̱ cạ pi̱ noọng, tìng to̱i ti̱ da̱, hạy ti̱ haư Vàm Đay nảy đảy páo oóc, do̱ lo̱ cần ti̱ me̱ nảy tó hít co̱i đảy chảng thưng sle chứ thưng min.”<verse eid="MAT 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Chíu nỉnh, mì cần nưng chang slíp nhi̱ cần nèm slon, mìng hít Giu-đa Ích-ca-ri-ốt, mà phúng kí slay pài xoòng tàu, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />xáu cạ: “Kí ké co̱i păng hử ngo̱ kỉ lai, hạy ngo̱ no̱p Min hử kí ké?” Hau păng hử cần nỉnh slam slíp siếc-lơ ngừn. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Tứ chíu nỉnh, Giu-đa xa chúng slì đay sle fản no̱p Min.<verse eid="MAT 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Chíu nỉnh, khảu vằn ta̱i ít cú le̱ Pẻng Mí Lùng Bư Phù, kí cần nèm slon mà xảư Chảu Giê-xu dăng cạ: “Slay ái hung ngo̱ chắp xặp hử slay kin le̱ Khảm Quá dú haư?” <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />Min cạ: “Cứ khảu slẻng, phúng cần nưng dá cạ cần nỉnh: ‘Slay cạ: “Tiỉm cú ngo̱ xảư thưng; ngo̱ xáu kí cần nèm slon co̱i hít le̱ Khảm Quá dú lưừn cú ni̱.”’” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Kí cần nèm slon hít chăn xị vàm Chảu Giê-xu tó slắng, dá hau chắp xặp le̱ Khảm Quá.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Thưng đăm, Min nă̱ng kin xáu slíp nhi̱ cần nèm slon. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Chíu kin, Min cạ: “Chăn, ngo̱ cạ pi̱ noọng, cần nưng chang pi̱ noọng co̱i fản ngo̱.” <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Kí cần nèm slon slim xàu lai, dá cần pìn cần xày tham: “Chảu ới, chư̱ ngo̱ mí?” <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Min hòi vàm: “Cần nàư chẳm mừ khảu cha̱m xáu ngo̱, do̱ cần nỉnh co̱i fản ngo̱. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Lu̱c Cú Cần co̱i hai, xị vàm tó slẻ mà Min; tọ slói tháy hử cần fản Lu̱c Cú Cần! Hạy min mí sleng oóc nhằng đay quá hử mi.” <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />Giu-đa, cần fản Chảu, tham: “Slay ới, chư̱ ngo̱ mí?” Min hòi vàm: “Chăn ni̱ táng chảng pìn nỉnh.”<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Chíu hau kin, Chảu Giê-xu au pẻng, sleng slu̱, xáu ẻo oóc. Dá dèn hử kí cần nèm slon, cạ: “Cứ au, kin pay! Nảy chư̱ đúc đang ngo̱.” <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Min te̱o au choóc, sleng slu̱, dá dèn hử kí cần nèm slon, xáu cạ: “Thuủn pi̱ noọng, cứ kin choóc nảy pay. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Vi̱ nảy chăn chư̱ lưư̱t cú chao kiít ngo̱ tó đíng oóc hử lai cần đảy sla phít xá. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Ngo̱ cạ pi̱ noọng, tứ nảy tò pay, ngo̱ co̱i mí kin nặm mác ít nảy num, thưng vằn ngo̱ xáu pi̱ noọng co̱i kin nặm mác ít máư chang tum ti̱ cú Pá ngo̱.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Lăng slì xưứng tèo sli thánh, Chảu Giê-xu xáu kí cần nèm slon oóc pay, khửn phja Ô-liu. <verse eid="MAT 26:30" /><verse number="31" style="v" sid="MAT 26:31" />Chíu nỉnh, Min cạ hau: “Că̱m nảy thuủn pi̱ noọng co̱i toỏng lụp vi̱ ngo̱, xị đảy slẻ cạ:</para>
  <para style="q1" vid="MAT 26:31">‘Ngo̱ co̱i cọn cần hen chiin</para>
  <para style="q1" vid="MAT 26:31">dá chiin chang xá co̱i slán slác.’<verse eid="MAT 26:31" /></para>
  <para style="b" />
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />Tọ mư̱ lăng ngo̱ hòi te̱o, ngo̱ co̱i thưng búng Ga-li-lê cón pi̱ noọng.” <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />Phi-e-rơ hòi vàm Min: “Ma̱i cạ mọi cần xày toỏng lụp vi̱ slay, tọ ngo̱ co̱i mí toỏng lụp slắc pày đơ.” <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />Chảu Giê-xu hòi vàm cạ: “Chăn, ngo̱ cạ ni̱, chăn că̱m nảy, cáy xằng khăn, ni̱ co̱i thoi ngài ngo̱ slam pày.” <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />Phi-e-rơ dăng Min: “Ma̱i cạ lèo hai xáu slay pay num, ngo̱ co̱i bó thoi ngài slay slắc pày đơ.” Thuủn kí cần nèm slon xày chảng pìn nỉnh.<verse eid="MAT 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Lăng nỉnh, Chảu Giê-xu xáu kí cần nèm slon pay thưng ti̱ nưng dảo hít Ghết-sê-ma-nê, dá Min cạ hau: “Cứ nă̱ng nảy, chang slì ngo̱ pay xỉnh chàu dú ti̱ nỉnh.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Dá Min au Phi-e-rơ xáu sloong lu̱c báo Xê-bê-đê tò pay. Min xo tàu hăn chíp xàu xáu slim luu̱n. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Min cạ hau: “Khoăn mi̱ng cú ngo̱ chíp xàu thưng hai. Pi̱ noọng cứ dú nảy xáu slỉng sla̱c đủi ngo̱.” <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Pay íng nưng num, Min củm nả lùng xỉnh chàu: “Pá cú lu̱c ới, hạy đảy, xo choóc nảy pja̱c khói lu̱c! Tọ, xo nèm slim Pá slưửng, mí nèm slim lu̱c.” <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />Dá Min fan te̱o xáu kí cần nèm slon, hăn hau nòn, do̱ Min cạ Phi-e-rơ: “Pi̱ noọng mí slỉng xáu ngo̱ đảy tiỉm nưng do̱ lừ? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Lèo slỉng sla̱c xáu xỉnh chàu, sle pi̱ noọng mí lụp khảu lo̱ láu. Slim khoăn do̱ mu̱ng lai, tọ đúc đang te̱o ón én.” <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />Min te̱o pay pày ta̱i nhi̱ dá xỉnh chàu, cạ: “Pá ới! Hạy choóc nảy mí dò pay đảy tọ lu̱c lèo kin choóc nảy, do̱ xo hử slim slưửng Pá đảy pìn.” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Min fan te̱o, hăn kí cần nèm slon nhằng nòn, vi̱ ha hau tó nắc lai dá. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Min chứng pja̱c hau, te̱o pay xỉnh chàu pày ta̱i slam, xỉnh chàu kí vàm xị pày cón. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Dá Min mà xáu kí cần nèm slon dá cạ hau: “Pi̱ noọng di̱ nhằng nòn xáu diít cha̱i đảy do̱ lừ? nỉnh cà, ái thưng slì dá, Lu̱c Cú Cần co̱i ngài fản sle chao khảu mừ kí cần phít xá. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Cứ tấn dân, hung làu pay á vớ! Nho̱m cà, cần fản ngo̱ tó thưng dá.”<verse eid="MAT 26:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Chíu Chảu Giê-xu nhằng chảng, do̱ Giu-đa, cần nưng chang slíp nhi̱ cần nèm slon pu̱ng khảu, min pay đủi phang đung nưng căm ma̱c dáng xáu tèo tạu đảy kí slay pài xoòng tàu xáu kí lạo ké cú phang cần xoi thưng. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Chíu nỉnh, cần fản Min oóc ha̱o hử hau: “Xắn ngo̱ chúp cần nàư, do̱ chăn chư̱ cần nỉnh. Cặp cần nỉnh khảu.” <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Giu-đa chứng khảu xảư Chảu Giê-xu, cạ: “Ra-bi á!” dá chúp Min. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />Tọ Chảu Giê-xu cạ min: “Pàng dạu ới, pàng dạu thưng sle hít pìn nỉnh!” Dá hau khảu xảư, au mừ căm Chảu Giê-xu xáu cặp Min. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />nỉnh cà, cần nưng chang kí cần pay đủi Chảu Giê-xu dàu mừ thót ma̱c dáng oóc bác dá ke̱t khát xu cần khỏi cú slay pài xoòng ta̱i tàu. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Chảu Giê-xu cạ cần nỉnh: “Cứ dò ma̱c dáng khảu pjoóc, vi̱ xắn cần nàư căm ma̱c dáng, do̱ co̱i ngài hai vi̱ ma̱c dáng. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Pi̱ noọng la̱i cạ ngo̱ mí đảy quỳn xo Pá, dá Min co̱i chích slì xoi mà hử ngo̱ quá slíp nhi̱ phang cần tang nả fạ do̱ lừ? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Hạy pìn nỉnh do̱, hít lừ lình ính Vàm Chảu Fạ, cạ, lo̱ nảy lèo mì oóc đảy?” <verse eid="MAT 26:54" /><verse number="55" style="v" sid="MAT 26:55" />Ngám chíu nỉnh, Chảu Giê-xu cạ phang đung: “Hít lăng kí ké au dáng xáu tạu mà cặp ngo̱ xị cặp ò cưứp pìn nảy? Vằn vằn ngo̱ nă̱ng slon cạ chang lưừn slớ, kí ké te̱o mí cặp ngo̱. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Tọ, mọi lo̱ nảy mì oóc, sle vàm cú kí cần páo cón đảy lình ính.” Chíu nỉnh, thuủn kí cần nèm slon tả Min ni pay.<verse eid="MAT 26:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Kí cần tó cặp Chảu Giê-xu tái Min thưng lưừn slay pài xoòng ta̱i tàu Cai-phe, ti̱ kí slay slon luật xáu kí lạo ké ho̱p đủi căn. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Phi-e-rơ pay nèm Min quay quay, thưng co̱n cú slảnh slay pài xoòng ta̱i tàu. Khảu bưửng đưng nă̱ng đủi kí lỉnh pạư sle ngòi hang lăng pìn lừ. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Chíu nỉnh, kí slay pài xoòng tàu xáu thuủn Kí cần Ứn chá xa chửng pjàng tỉng te̱o Chảu Giê-xu sle cáp xá khả hai Min. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Tọ hau mí xa đảy lăng chạy, ma̱i cạ mì lai cần dân oóc hít chửng pjàng. Túc lăng, mì sloong cần phjải oóc, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />cáo cạ: “Cần nảy tó chảng: ‘Min hít tấm lưừn slớ cú Chảu Fạ, dá tẳng te̱o chang slam vằn.’” <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />Slay pài xoòng ta̱i tàu tấn dân cạ Min: “Ni̱ mí hòi vàm kí cần nảy la̱i slỉ ni̱ do̱ lừ?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Tọ Chảu Giê-xu đỉ dú. Kí slay pài xoòng ta̱i tàu te̱o chảng đủi Min cạ: “Ngo̱ pắt ni̱ dăng tói nả Chảu Fạ te̱o tơ̱i tơ̱i xáu cạ hử hung ngo̱ chắc, ni̱ chư̱ Chảu Cháu Ti̱ Da̱, Lu̱c Chảu Fạ mí?” <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />Chảu Giê-xu hòi vàm ké: “Chăn ni̱ táng chảng pìn nỉnh. Tọ Ngo̱ cạ kí cần ni̱ chắc, mư̱ lăng kí cần ni̱ co̱i hăn Lu̱c Cú Cần nă̱ng bưửng sla Lạo Quỳn slèng xáu khúy phử fạ lùng mà.” <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />Chíu nỉnh, slay pài xoòng ta̱i tàu xẻ slử làu dá cạ: “Min tó chảng fa̱m thưng fạ. Hung làu nhằng cẩn cần hít chửng hít lăng num? Kí ké ngám ti̱ng vàm min chảng fa̱m thưng fạ dá. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Kí ké nẳm pìn lừ?” Hau chứng hòi vàm: “Min lèo hai.” <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />Dá hau phí nài khảu nả, cọn xáu táp khảu nả Min, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />cạ: “Chảu Cháu Ti̱ Da̱ ới, cứ chảng hử hung ngo̱ chắc pay! Cần nàư cọn ni̱ è?”<verse eid="MAT 26:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Chíu nỉnh, Phi-e-rơ nă̱ng dú noo̱c co̱n, mì slao khỏi khảu xảư ké, cạ: “Ni̱ xày dú đủi Giê-xu, cần Ga-li-lê.” <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />Tọ Phi-e-rơ thoi ngài tói nả mọi cần cạ: “Ngo̱ mí chắc ni̱ chảng lăng.” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Slì oóc pác tu, mì cần slao khỏi táng num hăn Phi-e-rơ, do̱ chảng đủi kí cần dú xảư nỉnh, cạ: “Ké nảy dú xáu Giê-xu, cần Na-xa-rét.” <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />Tọ Phi-e-rơ te̱o thoi ngài xáu pao xình, cạ: “Ngo̱ mí chắc cần nỉnh!” <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />Lăng íng nưng, kí cần dú xảư nỉnh cạ Phi-e-rơ: “Ni̱ xày chư̱ cần nưng chang phang hau chăn cà lại, cứ ti̱ng heng ké nỉnh do̱ chắc ngay lố.” <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Tọ Phi-e-rơ bjắc bjỏi xáu pao xình cạ: “Ngo̱ mí chắc cần nảy,” chăn chíu nỉnh, cáy khăn. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Phi-e-rơ chứ te̱o vàm Chảu Giê-xu tó chảng, cạ: “Cáy nhằng xằng khăn, do̱ ni̱ tó thoi ngài ngo̱ slam pày lố.” Dá ké oóc pay xáu hảy hấm khum phít.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Thưng slu̱ng, thuủn kí slay pài xoòng tàu xáu kí lạo ké cú phang cần oóc kí màu tói tỉng te̱o Chảu Giê-xu sle khả hai Min. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Hau phúc Min khảu, dá tái pay chao no̱p hử quan cải Phi-lát.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Chíu nỉnh, Giu-đa, cần fản Min, hăn Min ngài cáp xá, do̱ sliít xá, au slam slíp siếc-lơ ngừn păng te̱o hử kí slay pài xoòng tàu xáu kí lạo ké, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />dá chảng cạ: “Ngo̱ tó fa̱m xá vi̱ no̱p lưư̱t cần mí mì phít xá!” Tọ hau chảng: “Quén sla̱y lăng thưng hung ngo̱? Ni̱ táng tảy au pay.” <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />Giu-đa vẻng siếc-lơ ngừn khảu lưừn slớ, oóc pay dá khoen cò hai. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Tọ kí slay pài xoòng tàu íp kí mưn siếc-lơ ngừn khửn xáu cạ: “Mí đảy fép sle ngừn nảy khảu xang lưừn slớ, vi̱ ngừn nảy xị chá cú lưư̱t.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Pìn nỉnh, hau xùm xưừng đủi căn, au ngừn slự tu̱ng nà cú cần nă̱n tum, sle phăng dò kí cần cú tum ti̱ táng. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Pìn nỉnh, tu̱ng nà nảy chứng đảy dảo hít “Nà Lưư̱t” thưng vằn nảy. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Vàm páo cón cú Giê-rê-mi chứng đảy lình ính, cạ: “Hau au slam slíp siếc-lơ ngừn, chư̱ chá tứ cần Y-sơ-ra-ên tó tặt oóc hử Min, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />xáu hau du̱ng ngừn nỉnh slự tu̱ng nà cú cần nă̱n tum, xị Chảu tó oóc lịng hử ngo̱.”<verse eid="MAT 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Chíu nỉnh, Chảu Giê-xu dân tói nả quan cải; ké tham Min, cạ: “Ni̱ chư̱ Huùng cú cần Do Thái mí?” Chảu Giê-xu hòi vàm ké: “Chăn ni̱ tó chảng pìn nỉnh.” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Tọ Min ngài kí slay pài xoòng tàu xáu kí lạo ké cáo, Min mí hòi slắc vàm. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Phi-lát tham Min: “Ni̱ mí ti̱ng kí vàm hau hít chửng tói tỉng te̱o ni̱ do̱ lừ?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Tọ Chảu Giê-xu mí hòi vàm ké slắc vàm, thưng slặn hít hử cần quan cải hăn lạ lai. <verse eid="MAT 27:14" /><verse number="15" style="v" sid="MAT 27:15" />Xị mọi pày, cứ khảu vằn le̱, quan cải pjúi cần ngài xăng nưng xị phang cần lưư̱c. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Chíu nỉnh, hau xăng cần nưng fa̱m lai phít xá lai, mìng hít Ba-ra-ba. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Pìn nỉnh, slì hau ho̱p te̱o, do̱ Phi-lát tham hau: “Pi̱ noọng ái ngo̱ pjúi cần nàư? Ba-ra-ba do̱ va̱ Giê-xu dảo hít Chảu Cháu Ti̱ Da̱?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Ké chắc cạ, hau no̱p Min hử ké vi̱ slim xằng. <verse eid="MAT 27:18" /><verse number="19" style="v" sid="MAT 27:19" />Chíu ké nă̱ng tìng tắng ứn chá, me̱ ké hử cần mà dăng ké, cạ: “Mu̱ng hử mí mì lăng hử ni̱ xáu cần cung chính nỉnh, vi̱ vằn nảy, ngo̱ ngài nắc nái lai chang făn hăn mà cần nảy.” <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />Nhằng kí slay pài xoòng tàu xáu kí lạo ké xẩn xục phang cần, hau xo pjúi Ba-ra-ba tọ khả Chảu Giê-xu. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Quan cải te̱o tham hau: “Chang sloong cần nảy pi̱ noọng mu̱ng ngo̱ pjúi cần nàư?” Hau dăng: “Ba-ra-ba.” <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Phi-lát cạ hau: “Pìn nỉnh, ngo̱ lèo hít lăng xáu Giê-xu, cần đảy dảo hít Chảu Cháu Ti̱ Da̱?” Hau xày hòi vàm: “Min lèo ngài toóc teng tìng mạy các khoáy.” <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Quan cải tham: “Cần nảy tó hít lăng slại?” Tọ hau te̱o hài hẳm cải, cạ: “Min lèo ngài toóc teng tìng mạy các khoáy.” <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />Pìn nỉnh, Phi-lát hăn làu bó hít đảy lăng, tọ lao phang cần te̱o hít luu̱n, chứng au nặm slào mừ tói nả phang cần, dá chảng: “Ngo̱ mí mì phít xá mà lưư̱t cú cần nảy; Kí cần ni̱ táng tảy au.” <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />Tằng phang cần xày hòi vàm: “Xo lưư̱t cú min đíng tìng hung ngo̱ xáu tìng lu̱c lan hung ngo̱.” <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />Pìn nỉnh, Phi-lát pjúi Ba-ra-ba oóc hử hau, dá cọn Chảu Giê-xu, ké chao Min hử hau sle tảy toóc teng khảu mạy các khoáy.<verse eid="MAT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Lăng nỉnh, hau au Chảu Giê-xu khảu slảnh quan cải dá, kí lỉnh cú quan cải ho̱p căn tói nả Min. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Hau kẻ slử Min oóc, xáu hảng hử Min cùng slử pao đeng nưng. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Slan ăn tù nam nưng, dá thư khửn hu Min, xáu tặt co mạy ỏ khảu mừ sla Min, qu̱y tói nả Min, khu slủm Min cạ: “Pái Huùng cú cần Do Thái!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Hau phí nài khảu Min, au co mạy ỏ cọn khảu hu Min. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Hau khu slủm Min dá, chứng kẻ slử pao oóc, nu̱ng slử cú Min khảu, dá la̱c Min pay sle toóc teng khảu mạy các khoáy.<verse eid="MAT 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Chíu oóc pay, hau phúng cần Sy-ren mìng hít Si-môn, xáu pắt cần nảy béc mạy các khoáy cú Chảu Giê-xu. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Chíu thưng ti̱ dảo hít Gô-gô-tha, ý xí cạ “Ti̱ Đúc Hu,” <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />hau hử Min kin lảu quảy xăm đi khum; Min xìm dá, tọ mí kin. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Chíu toóc teng Min khảu mạy các khoáy, hau tỏ slải sló sle păn căn slử khóa cú Min, <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />dá hau nă̱ng dú nỉnh, pạư Min. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Bưửng tìng hu Min, sle kép pẻn cáp xá Min đảy slẻ cạ: “Nảy chăn chư̱ Giê-xu, Huùng cú cần Do Thái.” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Chíu nỉnh, mì sloong ò cưứp xày ngài toóc teng xáu Min: ò nưng dú bưửng sla, nhằng ò nưng dú bưửng slại. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Kí cần pay quá xày khu slủm Min, vắc bảu <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />xáu cạ: “Cần hít tấm lưừn slớ dá tẳng te̱o chang slam vằn nỉnh ới, cứ táng cháu làu pay! Hạy mưng chăn chư̱ Lu̱c Chảu Fạ, do̱ lùng khói mạy các khoáy pay!” <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Xày pìn nỉnh, kí slay pài xoòng tàu, xáu kí slay slon luật, kí lạo ké xày khu slủm Min, cạ: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Min tó cháu cần táng, te̱o mí táng cháu làu đảy. Min hít huùng Y-sơ-ra-ên né! Cà nạy min lèo lùng khói mạy các khoáy pay, do̱ hung làu chứng slấn min. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Min slấn khảu Chảu Fạ; do̱ cà nạy cứ sle Chảu Fạ cháu min, hạy Chảu Fạ pèng điíp min. Vi̱ min cạ: ‘Ngo̱ chăn chư̱ Lu̱c Chảu Fạ.’” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Chăn sloong ò cưứp xày ngài toóc teng xáu Min, tó bjắc bjỏi Min pìn nỉnh.<verse eid="MAT 27:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Chíu nỉnh, tứ tiỉm ta̱i húc, ngàu đăm dà pao thuủn to̱i ti̱, thưng tiỉm ta̱i cảu. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Slắc tiỉm ta̱i cảu, Chảu Giê-xu moòng vàm nưng cải, cạ: “Ê-li, Ê-li, la-ma sa-bách-tha-ni?” ý xí cạ: “Chảu Fạ cú lu̱c ới! Chảu Fạ cú lu̱c ới! Hít lăng Chảu pja̱c khói lu̱c?” <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Ti̱ng pìn nỉnh, kỉ cần dân dú nỉnh chảng cạ: “Cần nảy dảo Ê-li.” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Cần nưng chang phang hau chứng le̱n pay au ám bung, chẳm nặm mí, sle tìng hu co mạy ỏ xáu dèn hử Min kin. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Tọ kí cần táng te̱o cạ: “Đo đứ min. Hung làu cứ tẳng ngòi Ê-li mà cháu min mí.” <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Chảu Giê-xu moòng vàm cải nưng num, dá khát chaư. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />nỉnh cà, phén chưứng bưửng đưng lưừn slớ ngài xẻ pìn sloong tứ tìng lùng tảư, nhằng tum tu̱ng fèn, khảng hin cải ngài phéc oóc. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Lai ăn fằn ngài khay oóc, lai sli hài cú kí cần thánh quá tơ̱i đảy hòi te̱o. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Lăng slì Chảu Giê-xu hòi te̱o, hau oóc khói fằn, dá pay khảu slẻng thánh xáu oóc nả hử lai cần. <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Chíu hăn tum tu̱ng fèn xáu kí lo̱ tó mì oóc, cần căm tàu phang lỉnh, xáu phang lỉnh pạư Chảu Giê-xu, xày he lai chứng chảng cạ: “Chăn, Cần nảy chăn chư̱ Lu̱c Chảu Fạ.” <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />Dú nỉnh mì lai cần ti̱ me̱, nho̱m tứ quay, chư̱ kí cần tó pay nèm Chảu Giê-xu tứ búng Ga-li-lê, sle cung ta̱i Min. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Chang kí cần nỉnh mì Ma-ri Ma-đơ-len, Ma-ri mé Gia-cơ đủi Giô-sép, tò xày mé cú sloong lu̱c báo Xê-bê-đê.<verse eid="MAT 27:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Thưng pài đăm, mì cần fát xài dú slẻng A-ri-ma-thê thưng, mìng hít Giô-sép, xày chư̱ kí cần nèm slon Chảu Giê-xu. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Mà phúng Phi-lát xáu xo nhă̱n sli hài Chảu Giê-xu. Phi-lát oóc lịng chao hử ké. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Giô-sép nhă̱n sli hài xáu au phải pán slaư sle quỷn sli hài khảu, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />dá tặt sli hài khảu ăn fằn máư sle hử làu, tó cha̱c hin cón. Ké lă̱n khảng hin cải, sle hắp pác tu fằn khảu, dá pay. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Ma-ri Ma-đơ-len xáu Ma-ri táng dú nỉnh, nă̱ng tói nả fằn.<verse eid="MAT 27:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Vằn lăng, khảu lăng vằn Chắp Xặp, kí slay pài xoòng tàu xáu kí cần Pha-ri-si ho̱p te̱o dú tói nả Phi-lát, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />xáu cạ: “Quan ới, hung ngo̱ nhằng chứ cạ cần pjàng pjào nảy chíu nhằng te̱o tó cạ: ‘Lăng slam vằn, ngo̱ đảy hòi te̱o.’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Pìn nỉnh, xo quan oóc lịng sle pạư ti̱ fằn hử đay thưng vằn ta̱i slam. Lao kí cần nèm slon min te̱o mà lặc sli hài pay, dá chảng đủi mọi cần cạ ‘Min tứ ti̱ hai hòi te̱o dá,’ do̱ lo̱ pjàng pjào mư̱ lăng nhằng hại đát quá mư̱ cón.” <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Phi-lát cạ hau: “Kí ké mì lỉnh pạư, cứ pay pạư ti̱ fằn hử vẳn chằn xị kí ké chắc.” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Pìn nỉnh hau pay, phung khảng hin đủi lỉnh pạư, dá cạ lỉnh pạư ti̱ fằn vẳn chằn.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Lăng vằn Sa-bát, chíu da̱p da̱ chạu vằn ta̱i ít chang chất vằn le̱, Ma-ri Ma-đơ-len xáu Ma-ri ứn mà dưưng fằn. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />nỉnh cà, tum tu̱ng fèn lai, vi̱ mì cần tang nả Chảu tứ fạ lùng, khảu xảư lă̱n khảng hin oóc dá nă̱ng khửn tìng. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Slưứng cú cần tang nả fạ slu̱ng xị fạ me̱p, nhằng slử do̱ khao xị mươi. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Kí lỉnh pạư hăn chứng lao dan lai, slằn pìn xị cần hai. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Tọ cần tang nả fạ chảng đủi kí cần ti̱ me̱ cạ: “Kí pi̱ noọng mí đảy lao dan, vi̱ ngo̱ chắc pi̱ noọng pay xa Chảu Giê-xu, Lạo tó ngài toóc teng. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Min mí dú nảy đơ, Min hòi te̱o dá, xị vàm Min tó cạ. Mà nảy ngòi ti̱ Min nòn. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Cứ pay chảng hử kí cần nèm slon Min chắc khoái, cạ: ‘Min tó đảy hòi te̱o tứ ti̱ hai. Dá, Min pay thưng Ga-li-lê cón pi̱ noọng. Dú nỉnh, pi̱ noọng co̱i phúng Min.’ Chăn ngo̱ páo hử pi̱ noọng chắc hả.” <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />Sloong cần ti̱ me̱ nảy cẩn cản pay khói fằn, di̱ lao di̱ hun hỉ, le̱n pay páo hử kí cần nèm slon Min. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />nỉnh cà, Chảu Giê-xu phúng hau, cạ: “Pjòm pi̱ noọng!” Hau khảu xảư, cót kha Min xáu pái slớ Min. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Chảu Giê-xu cạ hau: “Dá xảy lao. Cứ pay, páo cạ hử kí pi̱ noọng ngo̱ sle hau khửn lo̱ thưng Ga-li-lê, hau co̱i phúng ngo̱ dú nỉnh.”<verse eid="MAT 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Chíu sloong cần ti̱ me̱ nảy pay, do̱ kỉ cần lỉnh pạư fằn pay khảu slẻng, li̱n te̱o hử kí slay pài xoòng tàu mọi lo̱ tó mì oóc. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Kí lạo ké xáu kí slay pài xoòng ho̱p đủi căn dá, do̱ hau hử kí cần lỉnh lai chèn lai, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />dá slắng cạ: “Cứ pay chảng cạ: ‘Tằng khừn, kí cần nèm slon min thưng lặc au sli hài pay chíu hung ngo̱ nhằng nòn.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Hạy vàm nảy thưng xu quan cải, hung ngo̱ co̱i xa lo̱ hít hử ké nỉnh slấn, sle mí quén lăng thưng kí cần ni̱.” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Kí cần lỉnh nhă̱n chèn, hít xị vàm slay pài xoòng slắng. Tèo cỏ nảy đảy tàm oóc dú ti̱ cần Do Thái thưng vằn nảy.<verse eid="MAT 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Slíp ít cần nèm slon pay thưng Ga-li-lê, thưng nhoo̱t phja Chảu Giê-xu tó cạ hau. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Phúng đảy Min dá, do̱ hau pái slớ Min, tọ mì kỉ cần nhằng la̱i. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Chảu Giê-xu thưng xảư, cạ hau: “Mọi quỳn tìng fạ tảư tum tó chao hử ngo̱. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Pìn nỉnh, pi̱ noọng cứ pay, hít hử mọi nòi cần pìn cần nèm slon ngo̱, au mình Chảu Po̱, Chảu Lu̱c xáu Chảu Khoăn sle hít báp-têm hử hau; <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />xáu slon hau hít nèm mọi lo̱ ngo̱ tó slon hử pi̱ noọng. Nảy, ngo̱ dú đủi pi̱ noọng mại thưng vằn sloót hang cú ti̱ da̱.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>