  <book code="1TI" style="id">EN_NNLT nut-x-north_Northern⋅Nung_ltr Thu Jul 16 2026 15:20:00 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">1 Timothy</para>
  <para style="toc1">Baư slư Ti-mô-thê ta̱i ít</para>
  <para style="toc2">1 Ti-mô-thê</para>
  <para style="toc3">1Ti</para>
  <para style="mt">1 Ti-mô-thê</para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />Phao-lô, cần đảy Chảu Giê-xu Cháu Ti̱ Da̱ xoi pay nèm lịng cú Chảu Fạ, Chảu Cháu hung làu, xáu cú Chảu chư̱ Chảu Giê-xu Cháu Ti̱ Da̱, lo̱ kháo mu̱ng cú hung làu,<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />xo phjác thưng Ti-mô-thê, lu̱c chăn cú cau chang slim slấn: Xỉnh xo lu̱c đảy fúc Chảu pảo hử ma̱i cạ làu bó ngám, slim điíp sliít, pình an tứ Chảu Fạ, chu̱ Pá, xáu Chảu Giê-xu Cháu Ti̱ Da̱, Chảu hung làu:<verse eid="1TI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />Xị chíu khửn lo̱ pay thưng Ma-xê-đoan, cau tó slắng lu̱c dú Ê-phê-sô sle cạ kỉ cần nỉnh mí đảy slon ta̱o lị haư táng, <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />xày mí đảy to sla̱y thưng kí tèo cỏ ta̱i va̱ xáu kí cúc chỏ lì loạt, kí lo̱ nỉnh tan oóc kí cheng ke̱o, tó mí chư̱ khay oóc cung sla̱y hử Chảu Fạ, cung sla̱y tứ slim slấn. <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />Hung làu lèo slon cạ tứ slim điíp tứ slim slảy slaư tích, slim đay xáu slim slấn chăn xình, <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />tọ kỉ cần táng do̱ tó pay slại, khảu kí pày tói pác bả bứt, <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />hau ái hít slay slon luật fáp, tọ mí slụ kí vàm hau chảng, kí lo̱ hau hít.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />Tọ, hung làu chắc cạ, luật fáp chăn đay hạy hau chắc du̱ng chăn chư̱, <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />xáu chắc cạ, luật fáp mí chư̱ đảy tặt oóc hử cần cung chính, tọ hử kí cần fa̱m fáp xáu fản tảu, kí cần mí fục, mí kiíng chu̱ng, cần fa̱m xá, kí cần mí slấn đạo, kí cần khả pá mé, xáu kí cần khả cần, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />kí cần eo đẳn, xáu ti̱ me̱ kin nòn xáu ti̱ me̱, ti̱ po̱ kin nòn xáu ti̱ po̱, kí cần puún cần, chảng pjàng, hít chửng slại, xáu thuủn kí lo̱ tỉng te̱o đủi kí lo̱ slon cạ chăn chư̱ <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />chăn xị lo̱ slon cạ tứ Vàm Đay slu̱ng phjưức cú Chảu Fạ fúc đay tó chao hử cau.<verse eid="1TI 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />Cau sleng slu̱ Lạo pảo fúc hử làu, chăn chư̱ Chảu Giê-xu Cháu Ti̱ Da̱, Chảu hung làu, vi̱ Min tó chắc ngo̱ ngám sle đảy hít cung sla̱y nảy, <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />ma̱i cạ mư̱ cón, pìn kí cần chảng fa̱m, há pả, too̱c éc, tọ te̱o đảy điíp sliít, vi̱ chíu nỉnh mí chắc, chứng hít kí lo̱ tăn bả vi̱ slim mí slấn. <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />Tọ, fúc đay, fúc Chảu pảo hử ma̱i cạ làu bó ngám chăn fúng fàu, xáu slim slấn chang Chảu Giê-xu Cháu Ti̱ Da̱.<verse eid="1TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15" />Vàm nảy chăn ngám sle slấn xáu nhă̱n au, “Chảu Giê-xu Cháu Ti̱ Da̱ tó thưng ti̱ da̱ sle cháu kí cần fa̱m phít xá,” — chang kí cần nỉnh, cau pìn tàu. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />Tọ, cau tó nhă̱n đảy slim điíp sliít, sle Chảu Giê-xu Cháu Ti̱ Da̱ chứng hử mọi cần hăn slim tảy nẳm xày xiìn dú xáu cau, cần phít xá ta̱i tàu, sle kí cần slấn Min ngòi khảu sle đảy lo̱ te̱o tơ̱i tơ̱i. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />Mọi lo̱ kiíng chu̱ng xáu slu̱ng phjưức slục mà Huùng cú mọi xám cần, chư̱ Chảu Fạ đeo, bó hai, bó dưư̱ng slưứng thưng tơ̱i tơ̱i. A-men.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />Ti-mô-thê lu̱c cú cau ới, cau oóc lịng nảy hử lu̱c, xị kí vàm páo cón mà lu̱c, sle pừng kí vàm nỉnh lu̱c chứng pu̱ng khửn tức tài tảm, <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />cỏ mắn slim slấn xáu slim đay, vi̱ mì kỉ cần thoi ngài, chứng lụp slim slấn, <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />chăn, chang kí cần nỉnh mì Hy-mê-nê xáu A-léc-xan-đơ, min tó đảy Chảu Fạ chao hử Sa-tan, sle slon cạ mí đảy chảng fa̱m thưng fạ num.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />Pìn nỉnh, cau chứng slắng lèo xẩn xục kí vàm na̱i xo, xỉnh chàu, sleng slu̱ tháy hử mọi cần cón, <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />hử kí huùng, hử kí cần căm tàu, sle hung làu đảy dú pình an, an ỏn xáu thuủn slim slấn kiíng lao xáu slim đay. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />nỉnh chăn chư̱ đay đắn xáu đay slim tói nả Chảu Fạ, Chảu Cháu hung làu, <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />chăn Lạo ái mọi cần đảy cháu sle chắc nhă̱n chăn lị. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />Vi̱ tan mì Chảu Fạ đeo, tan mì Lạo nưng dú tu̱ng chang Chảu Fạ xáu tu cần — chư̱ Chảu Giê-xu Cháu Ti̱ Da̱, chư̱ tu cần, <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />Lạo tó slỉ chăn mi̱ng làu sle cháu mọi cần, xị vàm chửng khảu chăn slì ha̱n, <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />vi̱ vàm chửng nỉnh, cau chứng đảy tặt hít cần páo cạ xáu đảy xoi pay — cau chảng chăn chang Chảu Cháu Ti̱ Da̱, mí chảng pjàng — hít slay slon hử kí cần cú tum ti̱ táng chắc mà slim slấn xáu chăn lị.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />Pìn nỉnh, cau ái kí cần ti̱ po̱ dú to̱i ti̱ lèo dặc mừ slaư tích khửn xỉnh chàu, mí đảy fát slíng xáu cheng ke̱o, <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />cau xày ái cạ, kí cần ti̱ me̱ lèo hít đay slim, kin nu̱ng đay đắn, lèo lùng slim, táng hít chảu, mí slan phjâm, thư kim, thư hin pèng do̱ va̱ nu̱ng slử khóa tảy lai chèn, <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />tọ hít kí lo̱ đay, chứng ngám chư̱ cần ti̱ me̱ kiíng lao Chảu Fạ.<verse eid="1TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 2:11" />Ti̱ me̱ lèo slon ti̱ng xích, slim fục mọi lo̱. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />Cau mí hử cần ti̱ me̱ đảy slon cạ do̱ va̱ căm quỳn kí cần ti̱ po̱, tọ lèo ti̱ng xích. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />Vi̱ A-đam đảy hít oóc cón, dá chứng thưng Ê-va, <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />xáu A-đam mí ngài pjàng pjào, tọ cần ti̱ me̱ ngài pjàng pjào chứng fa̱m xá. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />Tọ, cần ti̱ me̱ co̱i đảy cháu khảu slì sleng lu̱c, hạy slim hau cứ lằm chă̱p slấn, chang slim điíp, xáu slim slaư tích, slim quai kí.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />Vàm nảy chăn chư̱ vàm ngám sle slấn: “Hạy mì cần mu̱ng hít cần cung ta̱i chang ho̱i thánh, do̱ cần nỉnh tó mu̱ng hít cung sla̱y pèng điíp. <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />Pìn nỉnh, cần hen chiin lèo mí mì lo̱ lăng quáy đảy, tan mì po̱ me̱ đeo, slỉng sla̱c, táng hít chảu, ngám kiíng chu̱ng, ái chiíp tỏn khéc, slon cạ híu, <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />mí đảy dặn lảu, mí too̱c éc, tọ lèo sli̱n ta̱o, on van, mí thám chèn, <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />lèo cai cuủn lưừn làu híu, lu̱c lan chắc ti̱ng vàm xáu slim kiíng chu̱ng <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />(vi̱ hạy cần mí chắc cai cuủn lưừn làu, do̱ hít lăng hen tái Ho̱i Thánh cú Chảu Fạ đảy?), <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />cần ngám slấn mí đảy căm tàu, sle mí đảy háo cao te̱o ngài lụp khảu ti̱ fa̱t xị phi sla̱. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />Tọ, cần hen xày lèo đảy kí cần dú noo̱c Ho̱i Thánh hít chửng đay, sle cần nỉnh mí ngài nả nhẻn xáu lụp khảu ăn hảng cú phi sla̱.<verse eid="1TI 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />Kí cần cung ta̱i ho̱i thánh lèo đay đắn, mí chảng khoang chảng khoáy, mí dặn lảu, mí đảy thám, <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />lèo au slim slaư tích cỏ ăn dăm dò slim slấn. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />Tọ, hau lèo tảy xi cha̱m cón, hạy mí mì lăng quáy đảy, do̱ chứng đảy hít cần cung ta̱i ho̱i thánh.<verse eid="1TI 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 3:11" />Kí cần ti̱ me̱ xày pìn nỉnh, lèo chang chỉng, mí đảy chảng xảu, ngám chư̱, slim đeo hít thuủn mọi lo̱.<verse eid="1TI 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 3:12" />Kí cần cung ta̱i ho̱i thánh lèo mì po̱ đeo, au me̱ đeo, cai cuủn lu̱c xáu tằng lưừn làu hử đay. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />Kí cần nàư cung ta̱i ho̱i thánh đay co̱i đảy ti̱ slung pèng, xáu mì slim slấn tài tảm khảu Chảu Giê-xu Cháu Ti̱ Da̱.<verse eid="1TI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />Cau slẻ kỉ vàm nảy hử lu̱c, mu̱ng đảy thưng dưưng lu̱c khoái, <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />tọ hạy cau ma̱n thưng, do̱ lu̱c xày chắc lèo hít pìn lừ chang lưừn Chảu Fạ, xị Ho̱i Thánh cú Chảu Fạ te̱o tơ̱i tơ̱i, xị slau cú chăn lị. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />Kí lo̱ dăm dò cú slim kiíng lao chăn chư̱ cải luung, cạ:</para>
  <para style="q" vid="1TI 3:16">Lạo đảy oóc nả chang đúc đang,</para>
  <para style="q" vid="1TI 3:16">đảy dảo cạ cung chính chang Chảu Khoăn,</para>
  <para style="q" vid="1TI 3:16">đảy kí cần tang nả fạ nho̱m hăn,</para>
  <para style="q" vid="1TI 3:16">đảy páo cạ chang mọi nòi cần,</para>
  <para style="q" vid="1TI 3:16">đảy mọi cần tìng slí chái slấn,</para>
  <para style="q" vid="1TI 3:16">đảy dò khửn chang slu̱ng phjưức.”<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />Chảu Khoăn cạ khát sla̱t, chang slì sloót hang co̱i mì lai cần thoi ngài slim slấn, pay nèm kí slín pjàng pjào xáu ta̱o lị cú phi sla̱, <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />vi̱ hau pjàng mja̱p, slim chứng pìn kheng ma̱n dá, <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />căm au po̱ au me̱, căm cỏ kí cú kin Chảu Fạ hít oóc sle kí cần slấn, thung slụ chăn lị do̱ thuủn slim sleng slu̱ nhă̱n au. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />Vi̱ mọi lo̱ Chảu Fạ hít pìn xày đay đắn, bó mì ca lăng ngám tả pay, tọ lèo sleng slu̱ nhă̱n au, <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />vi̱ cú kin đảy slaư tích pừng khảu vàm Chảu Fạ xáu vàm xỉnh chàu.<verse eid="1TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />Hạy lu̱c tặt kí lo̱ nỉnh tói nả pi̱ noọng, do̱ lu̱c co̱i xị cần khỏi slim đay cú Chảu Giê-xu Cháu Ti̱ Da̱, đảy chưựng cải tứ vàm cú slim slấn xáu lo̱ slon cạ chăn chính lu̱c chứng slấn. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />Lèo tả kí tèo cỏ vi̱ va̱i, khoang khoáy cú kỉ da̱ ké. Tọ lèo táng slon hử làu slim slấn kiíng lao, <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />vi̱ “slon hử đúc đang tan đay dắp nưng, tọ slon slim kiíng lao do̱ đay thuủn mọi lo̱, vi̱ mì vàm pao xình hử cà nạy xáu tằng mư̱ lăng num.” <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />Vàm nảy chăn chư̱ ngám sle mọi cần slấn xáu nhă̱n au, <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />vi̱ hung làu tảy khỏ xáu tò tức hử lo̱ nảy, xáu tặt kháo mu̱ng khảu Chảu Fạ te̱o tơ̱i tơ̱i, Min chăn chư̱ Chảu Cháu mọi cần, ta̱i tàu cú kí cần slấn.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />Lèo slắng cạ xáu slon cạ kí vàm nỉnh. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />Mí đảy sle cần nàư ngòi che̱n lu̱c vi̱ nhằng ón, tọ lèo kin chảng, lo̱ kin dú, slim điíp, slim slấn xáu slim slaư tích hử kí cần slấn tò i hít nèm. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />Lu̱c lèo tảy khỏ to̱c xéc, slắng cạ xáu slon cạ thưng slì cau thưng. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />Mí đảy lùm fúc đay, chăn fúc đay pảo hử lu̱c quá vàm páo cón, xáu chíu kí lạo ké tặt mừ tìng lu̱c.<verse eid="1TI 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 4:15" />Lèo slỉu slim kí lo̱ nỉnh, lèo thuủn slim hít, sle cung sla̱y cú lu̱c đảy xày xiìn tói nả mọi cần. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />Lèo slỉu slim mà chăn lu̱c xáu kí lo̱ lu̱c slon cạ. Lèo tảy na̱i mọi lo̱ nỉnh, vi̱ pìn nỉnh, tằng lu̱c xáu kí cần ti̱ng lu̱c xày đảy cháu.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />Mí đảy chảng nắc vàm đá lạo ké, tọ lèo an chi hau xị pá, lèo ngòi kí cần ón xị pi̱ noọng, <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />kí da̱ ké xị mé, kí slao nóm xị pi̱ noọng slao, chang slim slaư tích.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />Lèo ngòi đay kí me̱ mải — kí me̱ mải chăn. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />Tọ hạy me̱ mải haư mì lu̱c do̱ va̱ lan, do̱ ta̱i tàu lu̱c lan lèo slon hử chắc kiíng chu̱ng cần đưng lưừn làu xáu păng cung pá mé, vi̱ pìn nỉnh chứng đay slim Chảu Fạ. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />Tọ, me̱ mải chăn, tan dú cần đeo, tặt kháo mu̱ng khảu Chảu Fạ do̱ cứ tảy na̱i xỉnh chàu na̱i xo vằn li̱n khừn. <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />Nhằng me̱ mải haư kin dú fí fái do̱ ma̱i cạ nhằng te̱o, tọ xị hai dá. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />Lèo slắng cạ kí lịng nảy sle hau mí mì lăng quáy đảy. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />Tọ hạy cần nàư mí păn hử pi̱ noọng làu, tằng cạ kí cần chang lưừn làu num, do̱ min tó fản slim slấn dá tùng xị cần xảu quá mọi cần mí slấn.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />Me̱ mải ái đảy slẻ mìng khảu xéc, lèo đo húc slíp pi tò pay, tan au po̱ đeo xày, <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />lèo đảy că̱n quá kí cung sla̱y đay xị: slon chưựng lu̱c lan, chiíp tỏn khéc, slào kha hử kí cần slấn, pang cháu cần phúng chai na̱n, tảy khỏ hít cung đay mí.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />Tọ lèo thoi ngài slẻ mìng kí me̱ mải nhằng ón, vi̱ hạy eo đẳn hít hử hau tỉng te̱o Chảu Cháu Ti̱ Da̱, do̱ hau nhằng ái au po̱ num, <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />hau chứng ngài cáp xá, vi̱ tó tả vàm làu pao xình mư̱ cón. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />Hau xày chạn hít, li̱u la̱i tứ lưừn nảy quá lưừn táng, mí tan chạn hít, nhằng quén lứ chảng đíp chảng đai num, hau cheng khảu cỏ cú cần đai, chảng kí vàm mí ngám chảng. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />Pìn nỉnh, cau ái kí me̱ mải ón au po̱, oóc lu̱c, cai cuủn lưừn làu do̱ hẳm đay, sle mí hít pìn chúng slì đay hử cần tói tàu chảng xảu. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />Vi̱ mì kỉ cần tói tàu pay nèm Sa-tan dá.<verse eid="1TI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16" />Hạy lưừn cần ti̱ me̱ haư slấn Chảu mì me̱ mải, do̱ lèo pang cho̱i hau, sle Ho̱i Thánh khói ngài háp nắc, sle Ho̱i Thánh pang cho̱i kí me̱ mải chăn.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />Kí lạo ké lèo cai cuủn Ho̱i Thánh híu do̱ lèo đảy kiíng chu̱ng hẳm lai, ta̱i tàu chư̱ kí cần tảy khỏ pay páo oóc Vàm Chảu xáu slon cạ. <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />Vi̱ Vàm Chảu Fạ slon: “Mưng mí đảy hắp pác chíu tu mò ta̱p khảu,” xáu “Cần hít cung do̱ đảy nhă̱n chèn cung ngám xáu cung khỏ làu hít.” <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />Mí đảy nhă̱n vàm cáo tỉng te̱o lạo ké nưng, hạy mí đo sloong do̱ va̱ slam cần hít chửng. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />Lèo quáy cần fa̱m xá tói nả mọi cần, sle kí cần táng chứng chắc lao. <verse eid="1TI 5:20" /><verse number="21" style="v" sid="1TI 5:21" />Cau ái slắng lu̱c tói nả Chảu Fạ xáu Chảu Giê-xu Cháu Ti̱ Da̱, xày kí cần tang nả fạ đảy lưư̱c cạ, lu̱c lèo hít kí lịng nảy, mí đảy păn pjết, xày mí đảy hít lo̱ lăng vi̱ slim khảu cò.<verse eid="1TI 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1TI 5:22" />Mí đảy tặt mừ khửn cần nàư, xày mí đảy tò cheng khảu phít xá cú cần táng num. Lèo cỏ làu slaư tích.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />Lu̱c mí tan kin nặm xày, tọ cứ kin íng lảu nưng, vi̱ toọng múc cú lu̱c slưừng slì chíp.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />Phít xá cú kỉ cần do̱ chăn khát sla̱t dá, tọ xày mì phít xá lèo ngài ứn chá chứng lo̱i oóc. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />Xày pìn nỉnh, mì cung sla̱y đay do̱ khát sla̱t, nhằng mì cung sla̱y táng, do̱ mí dăm dò mại đảy.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />Hạy cần nàư dú tảư éc hít khỏi, lèo thuủn slim kiíng chu̱ng lạo chảu làu, sle mình Chảu Fạ xáu lo̱ slon cạ cú hung làu khói ngài chảng xảu. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />Tọ kí cần hít khỏi mì chảu chư̱ cần slấn, do̱ mí đảy vi̱ hau pìn pi̱ noọng te̱o ngòi che̱n, tọ lèo thuủn slim cung ta̱i hau num, vi̱ hau chư̱ cần slấn, cần cung ta̱i, đảy pèng điíp. Lu̱c lèo slon xáu slắng cạ hau kí lo̱ nỉnh.<verse eid="1TI 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />Hạy cần nàư slon táng pay, mí nhă̱n vàm chăn chính, vàm cú Chảu hung làu, chư̱ Chảu Giê-xu Cháu Ti̱ Da̱, xáu kí vàm slon cạ mà slim kiíng chu̱ng, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />do̱ cần nỉnh chăn chư̱ háo cao, bó chắc lăng, tọ nắt tói pác, tò ke̱o mà slư ha, chứng cò că̱ng, tói tỉng, chảng fa̱m khu slủm, nẳm xảu căn, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />cheng ke̱o, chang kí cần slim ki va̱i xảu, mí mì chăn lị, ngòi slim kiíng lao xị lo̱ sle hít li̱ hử làu.<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />Tọ slim slấn kiíng lao xáu slim làu hăn đo, do̱ chăn chư̱ li̱ lai dá. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />Vi̱ hung làu mí au lăng khảu ti̱ da̱, do̱ xày mí au lăng pay đảy. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />Hạy mì khảu kin, slử nu̱ng do̱ slim lèo hăn đo đá. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />Nhằng kí cần ái đảy fát xài do̱ lụp khảu láu màu, cà khảu ăn hảng, lai kí slém mu̱ng bả bứt, xáu hít ha̱i, chư̱ kí lo̱ hít tu cần dăm khảu lo̱ va̱i túc xáu khả chii̱t. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />Vi̱ cúc la̱c cú mọi lo̱ too̱c éc chư̱ thám ngừn chèn, kỉ cần vi̱ thém mu̱ng lai chứng pja̱c khói slim slấn, táng háp au lai chíp xàu.<verse eid="1TI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />Tọ lu̱c, chư̱ cần cú Chảu Fạ, lèo phiín khói kí lo̱ nỉnh, sle xa thắp lo̱ cung chính, kiíng lao, mì slim slấn, slim điíp, tảy na̱i, on van. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />Lèo mì slim slấn sle tò tức tài tảm, lèo cỏ mắn lo̱ te̱o tơ̱i tơ̱i, chư̱ lo̱ te̱o lu̱c đảy dảo thưng, chứng mì vàm đay chảng oóc tói nả lai cần hít chửng. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />Cau oóc lịng hử lu̱c tói nả Chảu Fạ, Lạo pảo hử mọi dưư̱ng đảy te̱o, xáu tói nả Chảu Giê-xu Cháu Ti̱ Da̱, Lạo mì vàm đay chảng oóc tói nả Bôn-xơ Phi-lát, <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />lu̱c lèo cỏ vàm slon cạ nảy hử đay, mí mì ca lăng quáy đảy, thưng vằn Chảu hung làu chư̱ Chảu Giê-xu Cháu Ti̱ Da̱ oóc nả, <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />chư̱ Lạo đảy Chảu Fạ Ta̱i Slung ngám sle đảy că̱n, Lạo đeo, chư̱ Huùng cú kí huùng, Chảu cú kí chảu, co̱i hử chắc khảu chúng slì đay, <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />tan Min bó hai slắc pày, dú chang áng slu̱ng mí cần nàư thưng xảư đảy, chư̱ Lạo xằng mì slắc cần hăn, xày bó slắc cần hăn đảy, xỉnh hử kiíng chu̱ng xáu quỳn fép tơ̱i tơ̱i slục mà Min. A-men.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />Lèo slắng cạ kí cần fát xài dú tơ̱i nảy mí đảy háo cao, xày mí đảy tặt kháo mu̱ng khảu cú cái mí mắn táng, tọ lèo tặt kháo mu̱ng khảu Chảu Fạ, chư̱ Lạo pảo hử hung làu mọi lo̱ fúng fàu sle hung làu đảy hun du̱ng, <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />lèo cạ hau hít cung đay, fúng fàu pang cho̱i, kin dú mì slim quảng, ính xình păn vai, <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />hau slau slặp ti̱ đay đắn nưng hử mư̱ lăng, sle cỏ đảy lo̱ te̱o chăn.<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />Ti-mô-thê ới, lu̱c lèo cỏ au kí lo̱ lu̱c đảy chao, phiín khói kí vàm khoang khoáy vi̱ va̱i, xáu kí vàm cheng ke̱o te̱o la̱i cạ quai kí, <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />mì cần tó la̱i pìn nỉnh chứng túc slim slấn. Xỉnh xo fúc Chảu pảo hử ma̱i cạ làu bó ngám, dú đủi kí pi̱ noọng!<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>