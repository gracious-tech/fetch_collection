<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Tichurong</book>
  <para style="h">मत्ति</para>
  <para style="toc1">मत्ति</para>
  <para style="toc2">मत्ति</para>
  <para style="toc3">मत्ति</para>
  <para style="mt2">मत्तीले लेखेको सुसमचार</para>
  <para style="mt1">मत्ति टिटिबि लोन ल</para>
  <para style="imt">किताब ङोस्येयाप</para>
  <para style="ip">मत्ति नानाइबा च्वरा क्याइना लोन ल सारबा ठिमयि किताब स्यियि नाङने च्यि ना। काङति येशु ख्रिष्टयि मिजेयि मनङि क्याकिन। हतिबा पोरोला “लोन ल ”नेन। काङति खुँ लोन ल ना। हति किताबतेबा येशु स्यि छारते च्येला मत्ति, मर्कुस, लुका राङ युहान्नायि लाम्ला टिटिबा ना। छोइ होएतातेबे मत्ति लाम्ला क्याइना लोन ल नाम टिटिबा ना थारका मिति छ्या मेता, लेइराङयि अनुमान किन कि हिन्नाङ धि हा:लाम ख्रिष्ट क्येक्येबि ६० लो झोमयि च्येमे ताम ना। ङ्याबो, धि काँहा टिटिबा हिना नाङानयि सा याङ छ्या मेता, हिन्नाङ लेइराङयि छोए किन कि धि प्यालेस्टाइन राङ हा:लाम यरुश्लेम भजारला याङ टिटिबा हिनोम।</para>
  <para style="ip">ढिङानते मत्ति ना, काङते येशुयि रेँ लोब्टु सोयापले ताङला कर तुइङान मिझि ना। खोला लेवि नाइरे याङ ङोस्येयिनलो। लोब्टु च्युनङियि नाङने च्यि हिना राङ तेहि ख्युइ यहुदि पाठबे चाला टिटिबा हिनालो। ङिङबा ठिमयि पवित्रशास्त्रायि ६० लोले माहा टिटिबि तरिकाने धि चाङमा क्याइरे हा:को ङ्युइकिन। ख्युइ येशु ख्रिष्ट, कजसुबायि धाधामि मुक्तिदाता हिनालो नाइरे तोनसोम किनलो, काङति भारेला ङोन्सेखिखिला होतो। मत्ति याङ कजसुबायि राज्ययि भारेला लेइराङ टिटिबा होतो। यहुदिबे ख्रिष्ट राजनिति राज्यि क्यालबो होङयाप लेइराङ आशा पोपोरा होतो। मत्तियि कजसुबायि आत्मिक छोइयि राज्यियि मनङि क्यापते हति हिछे किङानला चुनौति तेरयापला लेइराङ साबधानि क्याइसोङ।</para>
  <para style="ip">मत्तियि च्वरा क्याइना लोन ल सारबा करार सुरु कियापला ल किताब ना। चिचालानाना धि टिटिबि तरिका पोरो ङिङबा करारयि ठिमला होतो। धि ठिम ङिला थुकिन। छोइ होएता मितेबे धि याङ सुझाप पिपिना होतो कि मत्तियि यि मोशायि किताबतेबे धोला ढानकियापला फाकिन ताताता होरोम, काङते ङिङबा करारयि ताङमे किताब ङाते ना। येशुयि रिला खाइकोए ५-६०० ङाला कजसुबायि मोशाला ठिम पिपिनातेबा ङ्याबो थु ङ्युकिन। <char style="xt"><ref loc="MAT 19:3-23:33">१९:३—२३:३३</ref> </char></para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">ला येशु ख्रिष्ट क्येक्येबा राङ ख्युइ स्यापच्यि स्युस्युइबि भारेला बिताइ कि राङ लोन ल सुरु किन। <char style="ior"><ref loc="MAT 1-4">१—४</ref> </char></para>
  <para style="io1">स्यान ला येशुयि स्याच्यि राङ ख्युइ लेइराङ छोइयि मनङि क्याकिन। <char style="ior"><ref loc="MAT 5-25">५—२५</ref> </char></para>
  <para style="io1">मत्तियि च्येस्युवा खण्डति येशुयि स्यिस्यिया राङ खो स्यिरे सोम्बो च्युङदे लाँलाँबाला च्यापच्यियि शिखरयि भारेला ना। <char style="ior"><ref loc="MAT 26-28">२६—२८</ref> </char></para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">येशु ख्रिष्टयि क्यालाक्युइ</para>
  <para style="r">
    <ref loc="LUK 3:23-38">लुका ३:२३-३८</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />धि दाउदयि क्यालाक्युइ अब्राहामयि क्यालाक्युइ येशु ख्रिष्टयि ताङबुइ क्युइतेबे पालि छालि ना। <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />अब्राहाम इसहाकयि आके हिना, इसहाक याकुबयि आके हिना, यहुदा राङ हति आज्यो भाइतेबे आके, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />यहुदा फोरस राङ जाहेरयि आके हिना हतिबे आमा तामर हिना फारेस हस्रोनयि आके हेस्रोन आरामयि आके <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />आराम अम्मिनादबयी आके, अम्‍मीनादाब नहशोनयि आके, नहशोन सल्मोनयी आके, <note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="RUT 4:19-20">रुथ ४:१९-२०</ref> </char></note> <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />सल्मोन बोअजयि आके हिना। हति आमा राहाब हिना। बोअज ओबेदयि आके हिना। मुइ आमा रुथ हिना ओबेदा यिशैयायि आके, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />यिशै दाउद क्यालबोयि आके हिना। दाउद सोलोमनयि आके हिना। सोलोमनयि आमा उरियाहयि केरमान हिना। <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />सोलोमन रहबामयी आके, रहबाम अबियायी आके, अबिया आसायी आके, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />आसा यहोशापातयि आके, यहोशापात यहोरामयि आके, यहोराम उज्जियाहयी आके, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />उज्जियाह योतामयि आके, योताम आहाजयी आके, आहाज हिजकियायि आके <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />हिजकिया मनश्शेयि आके, मनश्शे ओमनयी आके, आमोन योशियाहयि आके, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />योशियाह यकोनियास राङ हेतिबे भाइतेबे आके हिना, हतिबाला बेबिलोनला यहुदितेबाला बन्दि सोइरे खेरयापले ताङला क्येक्येबा हिना।<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="JER 27:20">यर्मिया २७:२०</ref></char></note> <verse eid="MAT 1:11" /><verse number="12" style="v" sid="MAT 1:12" />बेबिलोनला बन्दि सोइरे खेर छारते च्येला यकोनियास शालतिएलयी आके हिना, शालतिएल यरुबाबेलयि आके, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />यरुबाबेल अबिउदयि आके, अबिउद एल्याकिमयि आके, एल्याकिम आजोरयि आके, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />आजोर सादोकयी आके, सादोक आखिमयि आके, आखिम एलिउदयि आके, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />एलिउद एलाजारयि आके, एलाजार मत्तानयि आके, मत्तान याकुबयि आके, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />याकुब हेतिराङ योसेफयि आके हिना, हति केरमान मरियम हिना। हति मरियमला लाराङ येशु क्येक्येबा हिना, काङतेला ख्रिष्ट नेनलो। <verse eid="MAT 1:16" /><verse number="17" style="v" sid="MAT 1:17" />हति च्वरा क्याइरे अब्राहामने राङ दाउद थु मिराब च्युबझि च्युङदेलो, राङ दाउदयि भेलाने राङ बेबिलोनला बन्दि सोसोइबि भेला थु मिराब च्युबझि, राङ बेबिलोनला बन्दि सोसोबि भेलाने राङ ख्रिष्टयि भेला थु मिराब च्युबझि च्युङदेलो।<verse eid="MAT 1:17" /></para>
  <para style="s">येशु ख्रिष्ट क्येक्येबा</para>
  <para style="r">
    <ref loc="LUK 2:1-7">लुका २:१-७</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />येशु ख्रिष्ट धिरिया किङगा क्येसोङ कि ख्हुइ आमा मरियमयि योसेफला लाँरेलो, हिन्नाङ हतिबे मिजे होङयापले ताङला मिरियम पवित्र आत्माने टोपा खुखुरा हा:कोरेलो। <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />हिन्नाङ मुइ ख्योबो योसेफ केवाकिङान च्युच्युङाति, खोला ङो छाजे मिसोयापयि सम क्याइरे मोला फा:ला राङ तोङयापयि सम क्याइसोङ। <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />हिन्नाङ जब ख्युइ धि ताम विचार किन ताताता होतोलो, मिलामला प्रभुयि तेङलायि लोन खेरङान थोङदे, खोला जु नाइसोङ, “योसेफ, दाउदयि पिजा, ख्युइ केरमान मरियमला खाला ङ्यान्दे खिमला ख्योङयापला माझि, चिचालानाना काङते मुइ टोपाला होतो, खो पवित्र आत्माने ना। <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />मुइ पिजा झि क्येरु झ्युङान ना, राङ ख्युइ ख्हुइ मिनला येशु भोरङान ना, चिचालानाना ख्युइ रेँ मितेबाला हतिबे तिक्पाने क्योपङान ना।” <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />ङोन्सेखिलङानयि लाम्ला परमप्रभुयि नानाइबि वचन पुरा होङयापला राङ धि पोरो च्युच्युङा ना<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="ISA 22:14">यशैया २२:१४</ref></char></note> <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“तोइ, मिजे माक्याइबायि टोपा खुरङान ना, राङ हति पिजा झि क्येरु झ्युङान ना, राङ हति मिन इम्मानोएल भोरङान ना,”काङति खु, “कजसुबा हु ङ्याबो।”<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">यशैया ७:१४</ref></char></note> <verse eid="MAT 1:23" /><verse number="24" style="v" sid="MAT 1:24" />योसेफ ङि सातेलो, राङ कजसुबायि तेङलायि लोन खेरङानतेबे खोला नानाइबा च्वरा क्याइना मरियमला रेँ केरमानयि धोला खिमला ख्योरेलो। <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />मिरयमयि पिजा क्येरु माच्यु थु योसेफ मो ङ्याबो मिङ्यालालो। योसेफयि ख्युइ मिनला येशु तारेलो।<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">लाक्पि चा ताङानतेबा येशुला स्यारने ठातु लेलेबा</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />हेरोद क्यालबोयि भेलाला यहुदियायि प्रदेशयि बेथलेहेम भजारला येशु क्येदु, राङ स्यारयि देशने लाक्पि चा ताङानतेबा पोरो यरुश्लेमला लेप्सोङ। <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />तेहि हतिबे नाइसोङ, “यहुदिबे क्यालबो च्युङदे क्येङानते काँहा धुइ? चिचालानाना ङि ख्युइ कार्मा थोनङान थोङसोङ राङ खोला छ्या भुलदु लेलेबा ना।”<note caller="-" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="NUM 24:16">गन्ति २४:१६</ref></char></note><verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />जब हेरोद क्यालबोयि धि ताम थोइरे, खो खाने ताम मोथोनङान च्युङसोङ, राङ खो ङ्याबो यरुश्लेमयि मि पोरो बैरा लाँसोङ। <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />तेहि ख्युइ घोबा पुजारितेबा पोरो राङ जनतायि शास्त्रितेबाला याङ झोमदु च्युक्तेलो, राङ “ख्रिष्ट काँहा क्येयाप ना?” नाइरे ढियाला छेलसोङ। <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />हतिबे खोला नाइसोङ, “यहुदियायि बेथलेहेम भजारला। चिचालानाना ङोन्सेखिलङानतेबे लाम्ला धि टिटिदु। <verse eid="MAT 2:5" /><verse number="6" style="v" sid="MAT 2:6" />‘ए बेथलेहेम, यहुदायि सायि युल, ख्योए च्हिरु क्याइरे याङ यहुदायि आङकिङानयि उइला सुले याङ कम मिधु, चिचालानाना ख्योएने आङकिङान झि थोनङान ना, काङति ङाहि मि, इस्राएलला घोधोन किङान ना।’” <verse eid="MAT 2:6" /><verse number="7" style="v" sid="MAT 2:7" />तेहि हेरोदयि हति स्यारयि लेलेबि लाक्पि चा ताङानतेबाला फाला क्ये ताङदे कार्मा काङ ठिक्क काङ भेलाला थोथोङा ना, सो हतिबाने हा:कोरेलो। <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />ख्युइ हतिबाला जु नाइरे बेथलेहेमला चाँरेलो, “क्यु, राङ ल क्याइरे हति च्यिटाला फोए। हतिला ठे छारते च्येला ङाला लोन नाङ, राङ ङा याङ खोला छ्या भुल ज्याइ।” <verse eid="MAT 2:8" /><verse number="9" style="v" sid="MAT 2:9" />तेहि क्यालबुइ ताम थोइरे हतिबा रेँ लाम स्युरे पुतेलो। काङ कार्माते हतिबे स्यारला थोङदे, हति कार्मा हतिबे ताङ ताङला पुतेलो, राङ च्यिटा होएते साला क्योप छारते हति कार्मा हतिया राङ घारते तातेलो। <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />जब हतिबे कार्मा थोङदे हति लाक्पि चा ताङानतेबा आन्नद च्युङदे सम कारेलो।<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="LUK 2:20">लुका २:२०</ref></char></note> <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />तेहि खिमयि नाङला स्युरे हतिबे च्यिटातेला मुइ आमा मरियम ङ्याबो थोङदे, राङ कुरकुर क्याइरे खोला छ्या पुलसोङ। तेहि रेँ बागासातेबा पेरे खोला सेर, टिमा स्यिबो पोइ राङ मुर्रयि भेटि पुलसोङ। <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />तेहि हेरोदयि तेहा लक्ते माढो नाङान मिलामला हा:कोरे हतिबा स्यान लामयि लाम्ला रेँ देशला लक्तेलो।<verse eid="MAT 2:12" /></para>
  <para style="s">मिश्रदेशला पुपुता</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />हतिबा पुइ छारते, कजसुबायि तेङलायि लोन खेरङान झि मिलामला योसेफला थोङदे राङ ख्युइ जु नाइसोङ, “ल्हँ” च्यिटा टिमा राङ ख्युइ आमाला ङ्याबो खेरते मिश्रदेशला टोइरे क्यु, राङ ङाहि मानाइ थु हतिया त्योए, हेरोदयि च्यिटाला सोएयापयि चाला खोला फाकिन्दु। <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />तेहि युसुफ लाँरे च्यिटा राङ ख्युइ आमाला ङ्याबो खेर्ते हति छाम्मु राङ मिश्रदेशला प्हुते। <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />राङ हेरोद मास्यि थु युसुफ मिश्रदेशला राङ ताते ङोन्सेखिलङानयि लाम्ला कजसुबायी नानाइबा वचन धिरिया किङगा पुरा च्युङदे। ङाहि ङारि पिजाला मिश्रदेशने सअ नाइरे।<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">होशे ११:१</ref></char></note><verse eid="MAT 2:15" /></para>
  <para style="s">बेतलेहेमना हेरोदयि च्यिटा पोराला सासाता</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />तेहि लाक्पि चा ताङानतेबे खोला फट्टि क्याक्याइबि ताम हेरोदयि हा:कोरे, खोला स्येताङ लाँदु। तेहि लाक्पि चा ताङानतेबाने हो:कोकुवाये भेला अनुसार बेथलेहेम राङ हति इलाकायि नाङला लो ङि हतिले टिमा च्यिटाका पोरोला सोतु च्युसोङ। <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />तेहि यर्मिया ङोन्सेखिलङानयि नानाइबि वचन पुरा च्युङसोङ, <verse eid="MAT 2:17" /><verse number="18" style="v" sid="MAT 2:18" />“रामाला छि झि थोइसोङ, क्ये धोनिन-धोनिन ङुङुइबा राङ छिमा ताताङि क्ये छेया, राहेल रेँ च्यिटातेबे चाला ङुङुइबा, समस्यु ख्हुइ खाला माङ्यानालो, चिचालानाना ख्युइ च्यिटातेबा ता स्यि छारसोङ।”<note caller="-" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="JER 31:15">यर्मिया ३१:१५</ref></char></note><verse eid="MAT 2:18" /></para>
  <para style="s">मिश्रदेशने लक्ते लेलेबा</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />हेरोद स्यि छारते च्येला, परमप्रभुयि लोन खेरङान झि योसेफयि मिलामला मिश्रला थोङसोङ। <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />राङ जु नाइसोङ, “ल्हँ, च्यिटा राङ हति आमाला ङ्याबो खेरते इस्राएल देशला क्यु, चिचालानाना च्यिटायि उ च्योएसोम किङानतेबा ता स्यि छारतु।”<note caller="-" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="EXO 4:19">प्रस्थान ४:१९</ref></char></note><verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />तेहि युसुफ लाँरे च्यिटा राङ हति आमा ङ्याबो ख्योँरे इस्राएल देशला लक्ते लेप्सोङ। <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />तेहि यहुदियाला रेँ हेरोद साला हति भेलाला अखिर्लाउस राज्य किन ताताता धु नाइरे थोइरे खो हतिया ढोयाज्याइला झिरे, राङ रेँ मिलामला चेतावानि खुँरे खो गालिलयि प्रदेशला पुइसोङ। <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />खो नासरत नाङानयि भजारला पुते त्येसोङ। हति च्वरा क्याइरे ङोन्सेखिलङानतेबे नानाइबि वचन पुरा च्युङसोङ “खोला नासरि नाङान ना।<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MRK 1:24">मर्कुस १:२४</ref>; <ref loc="LUK 2:39">लुका २:३९</ref>; <ref loc="JHN 1:45">युहान्ना १:४५</ref></char></note>”<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">बाप्तिस्मा तेरङान युहन्नायी टाइक्ये</para>
  <para style="r">
    <ref loc="MRK 1:1-8">मर्कुस १:१-८</ref>; <ref loc="LUK 3:1-9">लुका ३:१-९</ref>; <ref loc="LUK 15:1">१५:१</ref>; <ref loc="JHN 1:19-28">युहान्ना १:१९-२८</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />हति भेलालाराङ बप्तिस्मा तेराङान युहान्ना यहुदियायि च्याङ मेते साला लेप्सोङ, राङ जु नेन राङ टाइक्ये किताला छेलसोङ, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />ख्युइ नाइसोङ, “रेँ तिक्पाने लक्ते सअ, चिचालानाना तेङलायि राज्य धुनला लेलेबा धु।” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />चिचालानाना धि हतिराङ ना, काङयि भारेला ङोन्सेखिलङान यशैयायि जु नानाइबा होतो “च्याङ मेते साला क्ये छेया धोनङान झिकि क्ये, ‘कजसुबायि लाम तयार सोइ, ख्युइ लाम थारका सोइ।’”<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">यशैया ४०:३</ref></char></note> <verse eid="MAT 3:3" /><verse number="4" style="v" sid="MAT 3:4" />युहान्ना उटयि पुइ कोहिला कोनिनलो, राङ केप्पाला पाबुइ कारा छिङिन। ख्युइ पानापाना राङ झङगलयि राहाङ सेनलो।<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">२ राजा १:८</ref></char></note> <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />यरुश्लेम भजार राङ यहुदिया पोरो, राङ यर्दनयि चाङबोयि फाला छुलुइ इलाकायि मि पोरो ख्युइ तेहा पुइसोङ, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />राङ रेँ तिक्पा ङ्यानकिन राङ यर्दन चाङबोला ख्युइ लाम्ला बप्तिस्मा खेराला छेलसोङ। <verse eid="MAT 3:6" /><verse number="7" style="v" sid="MAT 3:7" />हिन्नाङ फरिसिबा राङ सदुकितेबे नाङने लेइराङला बप्तिस्मा खेरतु लेलेबा थोङदे ख्युइ हतिबाला नाइसोङ, “रुलयि च्यिटाकाबा, होङानयि स्येताङने टोइरे ढोयापला खेला चेतावानि सुइ पिनसुइ?” <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />हतिचाला घ्योप्पा क्याइरे सुहाइ किङान ढेबु छ्यातु छ्यु। <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />अब्रहाम राङ हुइ आके ना नाइरे रेँ नाङला नारे माके। चिचालानाना ङा खेला नाज्याइ, कजसुबायि धि टोउतेबाने अब्राहामयि चाला सन्तन क्येरु झ्युङ्युइकिन। <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />थाल्ला राङ तोङबोङयि काँचाला तरि काल छारतु। हतिचाला ढेबु ल क्येरु मिझ्युङान तोङबोङ पोरो तुप्ते ढिमकिन, राङ मेला झ्युकिन। <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />“ङा ता खेला घ्योप्पायि कियापयि चाला छुयि बप्तिस्मा तेरिन, हिन्नाङ ङाहि च्येला होङान ङाले याङ लेइराङ छेया ना, काङति पौला खुरयापयि झ्योधायि याङ ङा मेता। ख्युइ खेला पवित्र आत्मा राङ मेयि बप्तिस्मा तेरङान ना। <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />खुरि लाक्पि राङ टिस्यिप खेरङान ना, राङ तेहि ख्युइ खुरि खलाला चाङमा चाङ क्याङ सोङान ना, राङ रेँ टो क्युसासाला सारे भोरङान ना, हिन्नाङ फुमाते मे मिस्यिङानयि नाङला मेला क्याङान ना।”<verse eid="MAT 3:12" /></para>
  <para style="s">येशुयी बाप्तिस्मा</para>
  <para style="r">
    <ref loc="MRK 1:9-11">मर्कुस १:९-११</ref>; <ref loc="LUK 3:21-22">लुका ३:२१-२२</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />तेहि येशु गालिलने युहान्नायि तेहा हतिबे लाम्ला बप्तिस्मा खेरतु यर्दनला लेप्सोङ। <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />हिन्नाङ युहान्नायि जु नेन राङ खोला घा च्युइ क्याइसोङ, “बरु ङाला पु ख्योएने बप्तिस्मा खेर कोहि होतो, राङ ख्योए ङाहि तेहा होङज्ये च्हि?” <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />हिन्नाङ येशुयि हतिबाला नाइसोङ, “थाल्ला धि च्वरा राङ होङदु छ्यु। चिचालानाना धि च्वरा क्याइरे राङ ङि केवा पोरो पुरा कि कोहि हुन।” तेहि युहान्ना ङ्यान्देलो। <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />तेहि येशु बप्तिस्मा खेर छारते तुरुन्तै छ्युने थोला थोनसोङ, तेहि तेङला पेसोङ, राङ ख्युइ कजसुबायि आत्माला ङोम्मु च्वरा क्याइरे पुपङान राङ रेँ थोला पापाबा थोङसोङ। <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />तेहि तेङलाने धि क्येझि लेप्सोङ, “धि ङाहि करि पिजा ना, खो ङ्याबो ङा लेइराङ काका होए।”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">येशुला छोए ताताइबा</para>
  <para style="r">
    <ref loc="MRK 1:12-13">मर्कुस १:१२-१३</ref>; <ref loc="LUK 4:1-13">लुका ४:१-१३</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />तेहि तुइयि लाम्ला छोए तायापला पवित्र आत्मायि लाम्ला येशुला च्याङ मेते साला खेरसोङ। <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />खो ङिन छान खलङि वर्तला ताते च्येला टोपा तसोङ।<note caller="-" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="EXO 34:28">प्रस्थान ३४:२८</ref></char></note> <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />तेहि छोए ताङानति ख्युइ तेहा लेप्ते नाइसोङ, “ख्योए कजसुबायि पिजा हिन्ना टोउतेबाला लोटा होङवार सह नाइरे आदेश पिन।”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />“हिन्नाङ येशुयि जवाक पिन्सोङ” “टिटिबा धु, ‘मि लोटायि मात्रा माना’ हिन्नाङ कजसुबायि खाने थोथोना वचन पोरोने सोम्बो लुइकिन।” <verse eid="MAT 4:4" /><verse number="5" style="v" sid="MAT 4:5" />तेहि तुइयि खोला पवित्र भजारला खेरते मोनलाम क्यासि खिमयि टुपु लाङसोङ, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />राङ खोला नाइसोङ, “ख्योए कजसुबायि पिजा हिन्ना, धिने हअला फोर, चिचालानाना धि च्वरा टिधु, ‘ख्युइ रेँ तेङलायि लोन खेरङानयि आदेश ख्योएला तेराङान ना राङ हतिबे खेला रेँ लाक्पाला राङ सुङान ना, स्यान अर्थात ख्युइ काङबा टोउला फोङान ना।’”<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">भजनसंग्रह ९१:११-१२</ref></char></note> <verse eid="MAT 4:6" /><verse number="7" style="v" sid="MAT 4:7" />येशुयि हतिला नाइसोङ, “टिटिबा धु, ‘ख्योए रेँ कजसुबाला छोए माता।’”<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="DEU 3:16">व्यवस्था ३:१६</ref></char></note> <verse eid="MAT 4:7" /><verse number="8" style="v" sid="MAT 4:8" />याङ तुइयि खोला थो छेया रिला खेरते संसारयी राज्य पोरो राङ हति ङोम खोला तान्सोङ, <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />तेहि खोला नाइसोङ, “ख्युइ ङाला कुरकुर क्याइरे छ्या पुलना, ङा धिबा पोरो ख्योएला तेरच्याइ।” <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />तेहि येशुयी हतिला नाइसोङ, “तुइ ख्योए घ्याबोला त्योए! चिचालानाना टिटीबा धु, ‘ख्युइ परमप्रभु रेँ कजसुबाला छ्या फुल, राङ ख्युइ मात्रा स्यापच्यि स्युइ।’”<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">व्यवस्था ६:१३</ref> </char></note> <verse eid="MAT 4:10" /><verse number="11" style="v" sid="MAT 4:11" />तेहि तुइ येशुला पोरते पुइसोङ राङ तेङलायि लोन खेरङान लेप्ते खोला स्यापच्यि स्युइसोङ।<verse eid="MAT 4:11" /></para>
  <para style="s">येशुयी गालिलला रेँ लाइ सुरु किनलो</para>
  <para style="r">
    <ref loc="MRK 1:14-15">मर्कुस १:१४-१५</ref>; <ref loc="LUK 4:14-15">लुका ४:१४-१५</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />बप्तिस्मा तेरङान युहान्ना झ्यालला पुइतु ना थोइरे येशु गालिल प्रदेश यहला पुइसोङ। <note caller="-" style="x"><char style="xo" closed="false">4:12</char><char style="xt" closed="false"><ref loc="MAT 14:3">मत्ति १४:३</ref>; <ref loc="MRK 6:17">मर्कुस ६:१७</ref>; <ref loc="LUK 3:19-20">लुका ३:१९-२०</ref></char></note> <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />नासरत ताङदे कफर्नहुम भजारला पुते हतिया तोताला छेलसोङ। धि भजार जबुलुन राङ नप्तालियि छेत्रला, छोयि नेमुला परि हुन। <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />यशैया ङोन्सेखिलङानयि नानाइबि वचन धि च्वरा क्याइरे पुरा च्युङसोङ: <verse eid="MAT 4:14" /><verse number="15" style="v" sid="MAT 4:15" />“जबुलुनयी युल राङ नप्तालियि युल, यर्दन चाङबुइ फारकानला, छो छोम्मुवा यहला, यहुदि मान्ते मितेबे गालिल” <verse eid="MAT 4:15" /><verse number="16" style="v" sid="MAT 4:16" />मुन्नाला त्योएङान मितेबे होए छोम्मुवा झि थोथोङा होतो। कालयि टिप्सोयि देशला त्योएङानतेबे थोला होए झि स्यारतु। <verse eid="MAT 4:16" /><verse number="17" style="v" sid="MAT 4:17" />हति भेलाने टाइक्ये किन राङ येशु नाला छेलसोङ, “तिक्पाने सम लक्ते ख्याला कि, चिचालानाना तेङलायि राज्य धुनला लेलेबा धु।”<verse eid="MAT 4:17" /></para>
  <para style="s">येशुयी ङ्या सुङान स्यिला क्ये ताताङा</para>
  <para style="r">
    <ref loc="MRK 1:16-20">मर्कुस १:१६-२०</ref>; <ref loc="LUK 5:1-11">लुका ५:१-११</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />गालिल छोयि नेमुला ढुइतुइना ख्युइ पत्रुस नाङान सिमोन राङ हति भाइ अन्द्रियास, ङिकार भाइतेबाला छोयि जालि झुकिन ताताता थोङदे। हतिबा ङ्या सुङान हिना। <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />येशुयी हतीबाला नाइसोङ, “ङाहि च्येला सह, राङ ङा खेला मि सुङान सोज्याइ।” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />तेहि हतितुइना राङ झालतेबा पोरते हतिबा येशुयी च्येला पुइसोङ। <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />हतिने ढुन-ढुन ख्युइ स्यान भाइ ङि, जब्दियायि पिजातेबा राङ याकुब राङ हति भाइ युहान्नाला हतिबे आके जब्दिया ङ्याबो डुङगाला रेँ झाल सुन ताताता थोङदे, राङ ख्युइ हतिबाला क्ये ताङदेलो। <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />तेहि हतितुइना राङ डुङगा राङ हतिबे आकेला ताङदे हतिबा ख्युइ च्येला लेप्सोङ।<verse eid="MAT 4:22" /></para>
  <para style="s">येशुयि लोबिन, टाइक्ये किन राङ टाक्तु झ्युकिन</para>
  <para style="r">
    <ref loc="LUK 6:17-19">लुका ६:१७-१९</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />तेहि येशु हतिबे यहुदि झोमसि खिमतेबाला लोबिन राङ, राज्ययि लोन ल टाइक्ये किन राङ, मितेबाला होएता कुरकुरु नाझा राङ स्हु कमजोर च्युच्युङा टाक्तु झ्युकिन राङ गालिल पोरोला युसोङ।<note caller="-" style="x"><char style="xo" closed="false">4:23 </char><char style="xt" closed="false"><ref loc="MAT 9:35">मत्ति ९:३५</ref>; <ref loc="MRK 1:39">मर्कुस १:३९</ref> </char></note> <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />ख्युइ क्याक्याइबि लाइ सिरिया काङ राङ टाइक्ये च्युङसोङ, राङ नाप्पातेबा, अर्थात कुरुकुरु नाझा राङ समतुयि खाँखाँबा, ढे ताताइबा, राङ स्हा फोफोकि नाझा, फफका, राङ स्हु मिघुलङनयि नाझा होएता पोरोला मितेबे ख्युइ तेहा ख्योसोङ। ख्युइ हतिबाला टाक्तु च्युसोङ। <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />तेहि गालिल प्रदेश, डेकापोलिस, यरुश्लेम भजार, यहुदिया राङ यर्दन चाङबुइ फारकानला थोङानयि मि तुम छोम्मुवातेबा ख्युइ च्येला लेप्सोङ।<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">सुरकि छोइ</para>
  <para style="r">
    <ref loc="LUK 6:20-23">लुका ६:२०-२३</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />मियि तुमतेबाला थोङदे खो रिला झिसोङ, राङ खो च्येला त्ये छारते लोब्टुतेबा ख्युइ तेहा लेप्सोङ। <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />ख्युइ खा पेसोङ राङ हतिबाला खाइकोए झ्युकाला छेलसोङ:<verse eid="MAT 5:2" /></para>
  <para style="s">तेम्बारे किप्पो</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 5:3" />“किप्पो आत्माला टाङना होएतातेबा, चिचालानाना तेङलायि राज्य हतिबे ना।” <verse eid="MAT 5:3" /><verse number="4" style="v" sid="MAT 5:4" />किप्पो समतु किङानतेबा, चिचालानाना हतिबाला छिमा फिङान खुङान ना। <verse eid="MAT 5:4" /><verse number="5" style="v" sid="MAT 5:5" />किप्पो टुङबोतेबा, चिचालानाना खेला पिरथिवि आङ खुङान ना। <verse eid="MAT 5:5" /><verse number="6" style="v" sid="MAT 5:6" />किप्पो केवायि चाला टोपा तङान राङ खा कोकोमातेबा, चिचालानाना हतिबा खा ङोमङान ना। <verse eid="MAT 5:6" /><verse number="7" style="v" sid="MAT 5:7" />किप्पो ङिङच्येङानतेबा, चिचालानाना खेला कजसुबाने ङिङ्च्ये खुङान ना। <verse eid="MAT 5:7" /><verse number="8" style="v" sid="MAT 5:8" />किप्पो सम चाङमातेबा, चिचालानाना हतिबे कजसुबाला थोङान ना। <verse eid="MAT 5:8" /><verse number="9" style="v" sid="MAT 5:9" />किप्पो ढिक्तु झ्युङानतेबा, चिचालानाना हतिबाला कजसुबायि सन्तन नाङान ना। <verse eid="MAT 5:9" /><verse number="10" style="v" sid="MAT 5:10" />किप्पो केवायि चाला तुरि खुङानतेबा, चिचालानाना तेङलायि राज्य हतिबे ना।<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="1PE 3:14">१ पत्रुस ३:१४</ref> </char></note> <verse eid="MAT 5:10" /><verse number="11" style="v" sid="MAT 5:11" />“किप्पो ना खे, जब मितेबे ङाहि चाला खि फाला ताम नेन राङ तुरि तेरिन, राङ चुन नाइरे खि विरोधला कुरकुरु अल तामतेबा नाङान ना।”<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="1PE 4:14">१ पत्रुस ४:१४</ref> </char></note> <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />हतितुइना सम को, राङ लेइराङ सम किप्पो कि, चिचालानाना तेङलाला खेला इनाम छेया खुङान ना। चिचालानाना धि च्वरा क्याइरे राङ खि ताङमे ङोन्सेखिलङानतेबाला हतिबे तुका पिपिना होतो।<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="2CH 36:16">२ इतिहास ३६:१६</ref>; <ref loc="ACT 7:52">प्रेरित ७:५२</ref> </char></note><verse eid="MAT 5:12" /></para>
  <para style="s">छा राङ होए</para>
  <para style="r">
    <ref loc="MRK 9:50">मर्कुस ९:५०</ref>; <ref loc="MRK 4:21">४:२१</ref>; <ref loc="LUK 4:34-35">लुका ४:३४-३५</ref>; <ref loc="LUK 8:16">८:१६</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />“खे पिरथिवियि छा ना, हिन्नाङ छायि टोप्ला पुइना याङ च्हिरु क्याइरे याङ छायि क्युरमु टोप्ला सोज्याइ?” हति ता फिला ढिमयाप राङ मितेबे काङबि लेयाप अर्थात स्यान च्याङ फान मिहा। <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />“खे संसारयि होए ना। रिला छुछुबि भजार भाइरे भोर मिङ्युइबा।”<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="JHN 8:12">युहान्ना ८:१२</ref>; <ref loc="JHN 9:5">९:५</ref> </char></note> <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />मितेबे बत्ति च्येते फकटिन ता घा मिङ्युइबा, हिन्नाङ बत्ति भोरसाला भोरिन, राङ खिमला होएते पोरोयि चाला हति साल्बो सुन।<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="MRK 4:21">मर्कुस ४:२१</ref>; <ref loc="LUK 8:16">लुका ८:१६</ref>; <ref loc="LUK 11:33">११:३३</ref> </char></note> <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />हति च्वरा क्याइरे खि होए मितेबे धुनला होए भाभारा होङ वार सह, राङ हतिबे खि किप्पोयि मिजे थोङोङ, राङ तेङलाला होएता खि आकेयि छे तेयोङ।<note caller="-" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">१ पत्रुस २:१२</ref> </char></note><verse eid="MAT 5:16" /></para>
  <para style="s">ठिम भारेला लालाबा</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />“मोशायि ठिम अर्थात ङोन्सेखिलङानतेबाला माना नाङान ङा लेलेबा नाङान समला माटान।” ङा हति स्यिक्तु माना, हिन्नाङ पुरा कितु लेलेबा ना।<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="ROM 10:4">रोमन १०:४</ref></char></note> <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />चिचालानाना तेम्बारे ङा खेला नाज्याइ, जब थु तेङला राङ पिरथिवि सिन्दे मिढुवा हति थु ठिमयि ताम पोरो पुरा मा च्युङा च्हिरु क्याइरे याङ च्हि या हतिने थोपा झि मात्रा सिनङान माना ना।<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="LUK 16:17">लुका १६:१७</ref></char></note> <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />हतिचाला सुइ धि आदेशबे नाङने पोरोले छुवातेला खाला मिङ्याना, राङ मितेबाला हति च्वरा कियाप लोपङान ना, तेङलायि राज्यला हति पोरोले छुवा नाङान ना। हिन्नाङ सुइ हति आदेशतेबा ङ्यान किन राङ लोबिन, तेङलायि राज्यला हति छेया नाङान ना। <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />चिचालानाना ङा खेला नाज्याइ, खि केवायि शास्त्रि राङ फरिसिबाले मा माच्युङना खेला काङ च्याने तेङलायि राज्यला स्यु मिङ्युइबा।<verse eid="MAT 5:20" /></para>
  <para style="s">स्येताङ भारेला छोइ</para>
  <para style="r">
    <ref loc="LUK 12:57-59">लुका १२:५७-५९</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />“खि थोथोइबा होतो, ताङबुइ मितेबाला जु नानाइबा होतो, ‘ख्योए मि मास्योए, राङ सुइ स्योएयापयि लाइ किन हतिला ङेबा खुकिन।’”<note caller="-" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="EXO 20:13">प्रस्थान २०:१३</ref>; <ref loc="DEU 5:17">व्यवस्था ५:१७</ref> </char></note> <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />हिन्नाङ ङा खेला नाज्याइ, सुइ याङ रेँ भाइला स्येताङ किन, हति ङेबा खुयापयि झ्योदायि होङान ना, राङ सुइ रेँ भाइयि ना च्योकिन, हति मि झोमसा छेया तेहा जवाक तेर मिङ्युइङान होङान ना। हिन्नाङ सुइ रेँ भाइला ख्योए मुर्ख नेन हति ङ्यालबायि मेला परि होङयापयि जोखिमला हुन। <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />हतिचाला ख्युइ वेदिला रेँ भेटि भुलि तुइना ख्युइ भाइयि समला ख्युइ विरोधला चिगा नायाप होतो नाङान ख्योएला टाम्बा च्युङना। <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />ख्युइ भेटि हति वेदियि धुनला पोर, राङ क्यु। ताङला ख्युइ भाइ ङ्याबो ढिका कि, राङ तेहि हतिने लेप्ते रेँ भेटि फुल। <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />“ख्युइ विरोधि ङ्याबो अदालतला ढुइतुइना लामला राङ ढि च्युइ कि, स्यान अर्थात विरोधियि ख्योएला ल अल भेङानयि लाला टोएङान ना राङ ल अल भेङानयि आङकिङानयि लाला टोएङान ना, राङ ख्योए झ्यालला झ्युङान ना।” <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />तेम्बारे, ङा खेला नाज्याइ, ख्युइ आलाइ पोरो माच्या थु ख्योए हतिने थाराङान माना ना।<verse eid="MAT 5:26" /></para>
  <para style="s">व्यभिचारयि भारेला लालाबा</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />खि जु नानाइबा थोथोइबा होतोइ, “ख्योए व्यभिचार माके।”<note caller="-" style="x"><char style="xo" closed="false">5:27 </char><char style="xt" closed="false"><ref loc="EXO 20:14">प्रस्थान २०:१४</ref>; <ref loc="DEU 5:18">व्यवस्था ५:१८</ref> </char></note> <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />हिन्नाङ ङा खेला नाज्याइ, सुइ पुमो रेनला व्यभिचारयि समयि तेन, हतिचाला ताङलाने राङ रेँ समला हति ङ्याबो व्यभिचार क्याइ छाछारा हुन। <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />तेम्बारे ख्युइ मि याइबि ख्योएला तिक्पा कितु झ्यु ना हतिला तोन्दे टिम, चिचालानाना ख्युइ स्हु पोरो ङ्यालबाला ढिमि पु बरु ख्युइ स्हु अंगतेबे नाङने च्हि मेता सोयाप ख्युइ चाला ल ना।<note caller="-" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">मत्ति १८:९</ref>; <ref loc="MRK 9:47">मर्कुस ९:४७</ref> </char></note> <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />ख्युइ लाक्पा याइबि ख्योएला तिक्पा कितु झ्युना हतिला तुप्ते टिम। चिचालानाना ख्युइ स्हु पोरो ङ्यालबाला ढुवाले बरु ख्युइ स्हुयि अंकतेबे नाङने च्हि मेता सोयाप ख्युइ चाला ल ना।<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">मत्ति १८:८</ref>; <ref loc="MRK 9:43">मर्कुस ९:४३</ref></char></note><verse eid="MAT 5:30" /></para>
  <para style="s">मिजे क्याइरे प्येयापयि भारेला छोइ</para>
  <para style="r">
    <ref loc="MAT 19:9">मत्ति १९:९</ref>; <ref loc="MRK 10:11-12">मर्कुस १०:११-१२</ref>; <ref loc="LUK 16:18">लुका १६:१८</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />जु याङ नानाइबा धु, कि सुइ रेँ केरमानला तोङिन, हति तोङयापयि स्यु ला टि।<note caller="-" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="MAT 24:1-4">२४:१-४</ref>; <ref loc="MAT 19:7">मत्ति १९:७</ref>; <ref loc="MRK 10:4">मर्कुस १०:४</ref> </char></note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />हिन्नाङ ङा खेला नाज्याइ, सुइ रेँ केरमानला व्यभिचारयि चाला अर्थात स्यानयि चाला तोङिन नाइ, हति मोला व्यभिचार सुन, राङ सुइ ताताङि पोमुवा ङ्याबो मिजे किनाइ, हति व्यभिचार किन।<note caller="-" style="x"><char style="xo" closed="false">5:32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">मत्ति १९:९</ref>; <ref loc="MRK 10:11-12">मर्कुस १०:११-१२</ref>; <ref loc="1CO 7:10-11">१ कोरिन्थि ७:१०-११</ref> </char></note><verse eid="MAT 5:32" /></para>
  <para style="s">ना क्येलयापयि भारेला छोइ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“याङ खि थोथोइबा होतो, कि यि ताङबुइ मितेबाला नानाइबा होतो, ‘ख्युइ चुन ना माक्येल, हिन्नाङ कजसुबायि चाला ना क्याक्यालाते ख्युइ पुरा कि।’<note caller="-" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="LEV 19:12">लेवि १९:१२</ref>; <ref loc="NUM 30:2">गन्ति ३०:२</ref>; <ref loc="DEU 23:21">व्यवस्था २३:२१</ref></char></note> <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />हिन्नाङ ङा ख्योएला नाज्याइ, ना क्येल राङ मा क्येल। तेङलायि मिनला ना मा क्येल, चिचालानाना हति कजसुबायि क्याल ठि ना।<note caller="-" style="x"><char style="xo" closed="false">5:34 </char><char style="xt" closed="false"><ref loc="JAS 5:12">याकुब ५:१२</ref>; <ref loc="ISA 66:1">यशैया ६६:१</ref>; <ref loc="MAT 23:22">मत्ति २३:२२</ref> </char></note> <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />न त पिरथिवियि, चिचालानाना हति ख्युइ तिङबा भोरसा ना, न त यरुश्लेम, चिचालानाना हति क्यालबोतेबे भजार ना।<note caller="-" style="x"><char style="xo" closed="false">5:35 </char><char style="xt" closed="false"><ref loc="ISA 66:1">यशैया ६६:१</ref>; <ref loc="PSA 48:2">भजनसंग्रह ४८:२</ref></char></note> <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />रेँ घोबुइ ना माकेल, चिचालानाना ख्युइ स्येबु झिला कारबो राङ नाक्पो सो मिङ्युइबा। <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />खि नानाइबि वचनते ‘हिना’ नाइना ‘हिना’ ‘माना’ नाइन ‘माना’ मात्र सह। धिले याङ माते अलतेबाने हुन।<verse eid="MAT 5:37" /></para>
  <para style="s">खिसियी भारेला येशुयी छोइ</para>
  <para style="r">
    <ref loc="LUK 6:29-30">लुका ६:२९-३०</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“खि थोथोइबा होतो, जु नानाइबा धु, ‘मियि छापला मि, राङ सोयि छापला सो।’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />हिन्नाङ ङा ख्योएला नाज्याइ, अलयि माकुवाला माके। सुइ खि ढाबा याइबाला थालच्या क्याकिन, हतिला स्यान ढाबा याङ स्ये। <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />तेम्बारे मि सुइ याङ मद्दा च्युक्ते ख्युइ भनदि खेर च्युइ क्याइना, हतिला ख्युइ जकेर याङ पिन। <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />तेम्बारे सुइ याङ ख्योएला किलोमिटर झि ढोयपला बाध्य सोइना हति ङ्याबो किलोमिटर ङि क्यु। <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />ख्योएला लोङानला पिन, राङ ख्योएने पुलेन खेर सोम किङानला मितेर माना।<verse eid="MAT 5:42" /></para>
  <para style="s">टाहाला करि कि</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“ख्युइ जु नानाइबा थोथोइबा होतोइ, ‘ख्युइ खिमजेला करि कि, राङ ख्युइ टाहाला मिका कि।’<note caller="-" style="x"><char style="xo" closed="false">5:43 </char><char style="xt" closed="false"><ref loc="LEV 19:18">लेवि १९:१८</ref> </char></note> <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />हिन्नाङ ङा खेला नाज्याइ, रेँ टातेबाला याङ करि कि, राङ ख्योएला तुका तेराङानतेबे चाला मोनलाम क्योप, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />राङ खे तेङलाला होएते आकेतेबे पिजा होङान ना। ख्युइ अल राङ ल ङिकारला ङिमायि टोए तेरिन, राङ केवाकिङान राङ तिक्पा किङान ङिकारला नाम तेरिन। <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />चिचालानाना तेम्बारे खे ङ्याबो करि किङानतेबा मात्र करि किना खेला च्हि इनाम होतो? च्हि कर तुइङानतेबे याङ धि च्वरा राङ मिकि ताइ च्हि? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />खि रेँ आज्यो भाइला मात्र नमास्ते कि ना यहुदि मान्ते मितेबाले माहा च्हि क्याइरे? च्हि हिछे मिकिङान याङ जु राङ मिकि ताइ च्हि? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />हतिचाला च्हिरु खि तेङलाला होएता आके कालो ताङताङ होतो, खे याङ हति च्वरा कालो ताङताङ होङ कोइ हुन।” <note caller="-" style="x"><char style="xo" closed="false">5:48 </char><char style="xt" closed="false"><ref loc="LEV 19:2">लेवि १९:२</ref>; <ref loc="DEU 18:13">व्यवस्था १८:१३</ref> </char></note><verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">दान तेरयापयि भारेला छोइ</para>
  <para style="r">
    <ref loc="LUK 11:2-4">लुका ११:२-४</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />“च्याङबो क्याइरे त्योए, खे मितेबाला तोनयापयि चाला केवायि लाइ माके। स्यान अर्थात तेङलाला होएता खि आकेने खेला च्याङ इनाम खुङान माना ना।” <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />“हतिचाला जब खे दान तेरिन, हतितुइना रेँ धुनला केलिङ मा तुङ, च्हिरु क्याइरे चुन नाङान मितेबे यहुदि झोमसि खिमतेबा राङ लामतेबाला मितेबाने छे धेयाप खुयापला किन।” तेम्बारे, ङा खेला नाज्याइ, खि रेँ इनाम खु छाछारा होतो। <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />हिन्नाङ जब ख्योए दान तेरिन, ख्युइ लाक्पा याइबि च्हि किनदुइ सो लाक्पा योमबि हा:कोरु मा झ्यु। <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />ख्युइ दान फा:ला पोर, राङ फा:ला थोङान ख्युइ आकि ख्योएला इनाम तेराङान ना।<verse eid="MAT 6:4" /></para>
  <para style="s">मोनलामयि भरेला छोइ</para>
  <para style="r">
    <ref loc="LUK 11:2-4">लुका ११:२-४</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />“जब ख्योए मोनलाम क्याकिन हतितुइना समनाँ च्वरा मायोङ, चिचालानाना हतिबा यहुदि झोमसि खिमतेबा राङ लामतेबे कुनाला मितेबे थोङोङ नाइरे लाँरे मोनलाम क्याक च्याइ करि किन।” तेम्बारे, ङा खेला नाज्याइ, खेला रेँ इनाम खुँ छाछारा होतो।<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="LUK 18:10-14">लुका १८:१०-१४</ref> </char></note> <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />हिन्नाङ जब ख्योए मोनलाम क्याकिन, रेँ नाङयि कोठाला क्यु, राङ को क्यापते रेँ हुइ फा:ला होएते तेङलायि कजसुबा आकेला मोनलाम क्योप, राङ फा:ला थोङान खि आकि ख्योएला इनाम तेराङान ना। <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />“राङ मोनलाम क्याकितुइना यहुदि मान्ते मि च्वरा फानमेते ताम सम नाङला माना। चिचालानाना छि लेइराङला नेतुइना खि ङ्यानयाप हुन नाङान हतिबा विचार किन्दु। <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />हतिचाला हतिबा च्वरा मायोङ। चिचालानाना खि खोला लोङाले केना ताङला राङ खेला काङ-काङ कोइबा होए, सो खि तेङलायि आकि हा:कुन। <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />हिन्नाङ खे धि च्वरा क्याइरे मोनलाम क्योप, ‘हे हुइ आके, काङते तेङलाला होतो, ख्युइ मिन पवित्र सह।<note caller="-" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="LUK 12:2">लुका १२:२</ref></char></note> <verse eid="MAT 6:9" /><verse number="10" style="v" sid="MAT 6:10" />ख्युइ राज्य सह। ख्युइ धोप्पा तेङलाला च्हिरु होए, हति च्वरा राङ धि पिरथिविला सह। <verse eid="MAT 6:10" /><verse number="11" style="v" sid="MAT 6:11" />ङेला तिरिङ बारतैयि ङ्योपा नाङ। <verse eid="MAT 6:11" /><verse number="12" style="v" sid="MAT 6:12" />ङि तिक्पा माप कि, च्हिरु क्याइरे ङि रेँ अभराधिला माप क्याइरे। <verse eid="MAT 6:12" /><verse number="13" style="v" sid="MAT 6:13" />ङेला छोए तायापला परि होङदु मा झ्यु, हिन्नाङ अलतेबाने पेरे पोर चिचालानाना राज्य, पराक्रम राङ छे बारतैयि चाला ख्युरि ना, आमेन।’” <verse eid="MAT 6:13" /><verse number="14" style="v" sid="MAT 6:14" />चिचालानाना ख्युइ मितेबे अपराध माप क्याइना खि तेङलाला होएता आकि याङ खेला माप किङान ना।<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="MRK 11:25-26">मर्कुस ११:२५-२६</ref> </char></note> <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />हिन्नाङ खि मितेबे अबराध माप माक्याइना खि आकि खि अपराध माप किङान माना ना।<verse eid="MAT 6:15" /></para>
  <para style="s">वर्त भारेला छोइ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />“जब खे वर्त तोकिन, हतितुइना समनाँतेबा च्वरा च्ये मुन्ना मातोन।” चिचालानाना मितेबाला वर्त ताताता तोनयापला हतिबा रेँ च्ये मुन्ना सुन। तेम्बारे, ङा खेला नाज्याइ खि रेँ इनाम खु छाछारा होतो। <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />हिन्नाङ खे वर्त तोतितुइना रेँ घोबोला मोरकु कुइ, राङ रेँ च्ये ठुइ। <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />राङ ख्युइ वर्त मितेबे माना, हिन्नाङ फा:ला होएते खि आकि थोङोङ, राङ फा:ला थोङानयि ख्युइ आकि ख्योएला इनाम तेरङान ना।<verse eid="MAT 6:18" /></para>
  <para style="s">तेङलायि क्युनोर</para>
  <para style="r">
    <ref loc="LUK 12:33-34">लुका १२:३३-३४</ref>; <ref loc="LUK 16:13">१६:१३</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />रेँ चाला पिरथिविला क्यु सम्पति मासाहा, काँहा भु राङ या क्यापते हति मासि सुन राङ काँहा कुम्मातेबे खिम तोल्दे हति कुन।<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="JAS 5:2-3">याकुब ५:२-३</ref></char></note> <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />हिन्नाङ रेँ चाला तेङलाला क्यु सम्पति सह, काँहा भु या-या क्याप्ते मासि मिसुवा, राङ कुम्मायि याङ मिकुवा। <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />चिचालानाना काँहा ख्युइ क्युनोर हुन, हतिया ख्युइ सम याङ हुन।<verse eid="MAT 6:21" /></para>
  <para style="s">स्हुयि होए</para>
  <para style="r">
    <ref loc="LUK 11:34-36">लुका ११:३४-३६</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />“मिइ स्हुयि होए ना। हतिचाला तेम्बारे ख्युइ मि ल होएना, ख्युइ स्हु पोरो साल्बो हुन। <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />हिन्नाङ ख्युइ मिइ नानाइबा होएना, ख्युइ स्हु पोरो मुन्ना हुन। हतिचाला ख्युइ नाङला होएता साल्बोते मुन्ना च्युङना, हति मुन्ना च्हिरु नाथुमे हुन।”<verse eid="MAT 6:23" /></para>
  <para style="s">कजसुबा राङ क्युनोर</para>
  <para style="r">
    <ref loc="LUK 16:13">लुका १६:१३</ref>; <ref loc="LUK 12:22-33">१२:२२-३३</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />सुइयाङ ताक्पो ङियि स्यापच्यि स्यु मिङ्युइबा। चिचालानाना हति च्यिला मिका किन राङ स्यानतेला करि किन। अर्थात हति च्यिकि थोला भक्ति भोरिन राङ, स्यानतेला हति मिका किन। खि कजसुबा राङ क्यु ङिकारला स्यापच्यि स्यु मिङ्युइबा।<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />हतिचाला ङा खेला नाज्याइ, “च्हि साज्याइ, च्हि थुङ ज्याइ नाइरे रेँ उयि चाला राङ ‘च्हि कोन ज्याइ’ नाइरे रेँ स्हुयि चाला चिन्ता माके। च्हि मिजे सायापले राङ स्हुयि कोहिलाले हा:छेया मानाइ?” <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />पान्नाङयि च्याचिउतेबाला तोइ। हतिबे न सावोन जुकिन, न भालि तुकिन, न कामला रुरे भोरिन, हिन्नाङ खि तेङलायि आकि खेला स्योमकिन। च्हि खे हतिबाले घोङ छेया मानाइ च्हि? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />खि नाङने सुइ रेँ लो छाङ छारते मिजेयि टिझि भेला याङ थपि कि ङ्युइकिन? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />“तेहि कोहिलायि चाला खे चिला समतु किन? थाङयि लिलि मिधोला तोइ, हति च्हिरु क्याइरे छारिन धुइ। हति न तुक्का किन, न-न थोउ च्योकिन। <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />हिन्नाङ ङा खेला नाज्याइ, सोलोमन क्याल:बो याङ रेँ ङोमला खि नाङने च्हि चोम याङ छाछाइबा मेतालो। <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />तिरिङ होएता राङ ङाइटो भुबाला ढिमङानयि चा कजसुबायि धि च्वरा क्याइरे घेबिन नाना, ए हिछे टिझि किङान बा, च्हि ख्योएला ख्युइ धिले याङ मा मिघेबाइ च्हि? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />हतिचाला ‘च्हि साजाइ?’ कि च्हि थुङजाइ? कि ‘च्हि कोनज्याइ?’ नाइरे समतु माके। <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />चिचालानाना यहुदि मान्ते मितेबे धि पोरो फाकिन, राङ खि तेङलाला होएता आकि खेला धि पोरोयि कोइबा होतो नाइरे हा:कुन।<note caller="-" style="x"><char style="xo" closed="false">6:32 </char><char style="xt" closed="false"><ref loc="LUK 12:31">लुका १२:३१</ref></char></note> <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />हिन्नाङ ताङला ख्युइ कजसुबायि राज्य राङ ख्युइ पवित्रता फोए, राङ धि पोरो क्यु खि चाला थपिकिङान ना। <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />हतिचाला ङाइटुइ चाला समतु माके, चिचालानाना ङाटुइ ङिनयि चाला ङाइटो राङ समतु किङान ना। तिरिङयि तुक्का तिरिङयि चाला थारे ना।”<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">स्यान न्याय मिकियाप</para>
  <para style="r">
    <ref loc="LUK 6:37-38">लुका ६:३७-३८</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />“स्यानला न्याय माके, राङ कजसुबायि याङ खेला न्याय मिकिता।” <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />चिचालानाना च्हिरु क्याइरे खे स्यानला न्याय किन, हति च्वरा क्याइरे खेला याङ न्याय किन। काङ नापि कियापयि खे छे क्याकिन, हति च्वरा क्याइरे खे चाला याङ नापि किन।<note caller="-" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="MRK 4:24">मर्कुस ४:२४</ref> </char></note> <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />चिला ख्योए रेँ भाइयि, मिला होएता साबियि धोक्पो थोङिन, हिन्नाङ ख्युइ रेँ मिला होएता ठोस्योते हा:मिकुवा। <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />“अर्थात ख्युइ रेँ मिला ठोस्यो होएना च्हिरु क्याइरे ख्योए ख्युरि भाइला नाङ्युइकिन। ‘ङाला ख्युइ मिने साबेयि धकपोते धोनदु छ्यु,’ <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />ए समनाँ, ताङला रेँ मिने ठोस्यो थोन, तेहि ख्युइ भाइयि मिने साबेयि धोक्पो धोनयापला साल्बो क्याइरे थोङ्युइकिन।” <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />“काङते पवित्र होतो हति किबोला मातेर। रेँ थाति क्युतेबा फायि धुनला माढिम, स्यान अर्थात हति रेँ काङबायि हतिला नोनयाप राङ लक्ते ख्योएला मुरे रोलदु लेबोङ।”<verse eid="MAT 7:6" /></para>
  <para style="s">ल्हँ, फोए, त्हुँ,</para>
  <para style="r">
    <ref loc="LUK 11:9-13">लुका ११:९-१३</ref></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />ल्हँ ख्योएला तेराङान ना, फोए ख्योएला खुङान ना, को तु ख्युइ चाला भेङान ना। <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />चिचालानाना सुइ लोङिन, हतिला खुकिन, सुइ फाकिन, हतिला खुकिन, सुइ को तुइ, हति चाला को भेङान ना। <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />खि नाङने काङ मिते ना, सुइ पिजायि लोटा लोङितुइना हतिला टोउ तेरिन? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />कि ङ्या लोङितुइना हतिला रुल तेरिन? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />हतिचाला खे अल च्युङदे रेँ च्यिटाकाला ल क्यु तेरयाप हा:कुन नाना, तेङलाला होएता खि आकि खोला लोङान ला चोम ल क्याइरे ल क्यु पिनोङङि।<note caller="-" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="LUK 11:13">लुका ११:१३</ref></char></note><verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />मि खेला च्हिरु व्यवाहार कि नाइबा खि सम हुन धुइ, खि याङ हतिबाला हति च्वरा व्यवाहार कि, चिचालानाना धि राङ ठिम राङ मोशा ङोन्सेखिलङानयि छोइयि काक्पा ना।<note caller="-" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="LUK 6:31">लुका ६:३१</ref> </char></note><verse eid="MAT 7:12" /></para>
  <para style="s">को तोका</para>
  <para style="r">
    <ref loc="LUK 13:24">लुका १३:२४</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />“को तोकाने नाङला सु, चिचालानाना मासि लोङानयि को यहाबो राङ लाइला हुन, राङ हति नाङला सुङान लेइराङ मि हुन। <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />चिचालानाना मिजेला केलङानयि को तोका हुन राङ लाम काबो हुन, काङति मिजेला केलकिन, राङ हतिला क्योपङान ङ्युवा हुन।”<verse eid="MAT 7:14" /></para>
  <para style="s">तोङबोङ राङ हति ढेबु</para>
  <para style="r">
    <ref loc="LUK 6:43-44">लुका ६:४३-४४</ref>; <ref loc="LUK 13:25-27">१३:२५-२७</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“चुन ङोन्सेखिलङानतेबाने च्याङबो क्याइरे त्योए, सु खि तिया लुला चुइरे हुन, हिन्नाङ नाङलाते झ्यिझ्यिरा वाजे च्वरा हुन।<note caller="-" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="JER 22:27">यर्मिया २२:२७</ref></char></note> <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />हतिबे ढेबुने खि हतिबाला ङोसेङान ना। च्हि छेरमि भोटिने अंगुर अर्थात सिउडिने भेलडु थुनाइ च्हि? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />हति च्वरा क्याइरे पोरो ल तोङबोङयि ल ढेबु छ्यातुझुकिन। हिन्नाङ अल तोङबोङयि अल ढेबु छ्यातुझुकिन। <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />ल तोङबोङयि अल ढेबु छ्यातु झ्युमिङ्युइबा, न अल तोङबोङयि ढेबु ल छ्यातुझु ङ्युइकिन। <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />ढेबु ल छातु मिझुङान तोङबोङ पोरो तुप्ते गेलिन, राङ मेला ढिमिन।<note caller="-" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="MAT 3:10">मत्ति ३:१०</ref>; <ref loc="LUK 3:9">लुका ३:९</ref> </char></note> <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />धि च्वरा क्याइरे ङोन्सेखिलङानबाला हतिबे लाइयि लाम्ला ङोसेङान ना।”<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="MAT 12:33">मत्ति १२:३३</ref> </char></note><verse eid="MAT 7:20" /></para>
  <para style="s">ङाहि ख्योएला नामयाङ ङोमिस्येबा</para>
  <para style="r">
    <ref loc="LUK 13:25-27">लुका १३:२५-२७</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“ङाला ‘प्रभु, प्रभु’ नाङान पोरो तेङलायि राज्यला सु मिङ्युइबा। तेङलाला होएता ङाहि आकि धोप्पा ङ्यानङान मिते मात्रा तेङलायि राज्यला सु ङान ना। <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />हति ङिन लेइराङयि ङाला नाङान ना, ‘प्रभु, प्रभु, च्हि ङि ख्युइ मिनला ङोन्सेखिलखिला मानाइबाइ? ख्युइ मिनला ढे मातेता। राङ ख्युइ मिनला स्यान याङ लेइराङ हा:लाइयापयि लाइ माक्याइबाइ?’” <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />तेहि ङा खेला चाङमा क्याइरे नाज्याइ। “ङाहि ख्योएला नामयाङ ल क्याइरे ङोस्येस्येबा राङ मेता। ए लाइ अल किङानबा ङाने घ्याबोला त्योए।”<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="PSA 6:8">भजनसंग्रह ६:८</ref> </char></note><verse eid="MAT 7:23" /></para>
  <para style="s">खिम ङि सोङानतेबा</para>
  <para style="r">
    <ref loc="LUK 6:47-49">लुका ६:४७-४९</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“हतिचाला सुइ ङाहि वचन ङ्यानकिन राङ पालाना किन, ङा हतिला मि बुद्दिमानि झि ङ्याबो थुकच्याइ, सुइ रेँ खिम ट्हायि थोला सोइरे। <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />तेहि जब क्यापते, राङ श्यलह लेप्ते, तेहि हुरबो छोम्मुवा क्यापते राङ हति खिमयि थोला फसोङ, राङ हति खिम मातिबा। चिचालानाना हति खिम टाहयि थोला सोसोइबाति ना। <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />सुइ ङाहि धि वचन ङ्यानदे याङ पालाना मिकिता, हति मि ङा मि मुर्ख झि ङ्याबो थुकच्याइ, सुइ रेँ खिम पेमायि थोला सोइरे। <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />जब क्यापसोङ, राङ श्यलह क्यापसोङ, तेहि हुरबो छोम्मुवा क्यापसोङ राङ हति खिमयि थोला थुसोङ राङ हति खिम तिपसोङ, तेहि हति छेया मासि च्युङसोङ।”<verse eid="MAT 7:27" /></para>
  <para style="s">येशुयि आङ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />येशुयि धि तामबा नाइ छारते च्येला मयि तुम ख्युइ छोइ ङ्यानदे हा: लाइसोङ।<note caller="-" style="x"><char style="xo" closed="false">7:28 </char><char style="xt" closed="false"><ref loc="MRK 1:22">मर्कुस १:२२</ref>; <ref loc="LUK 4:32">लुका ४:३२</ref> </char></note> <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />चिचालानाना ख्युइ हतिबे शास्त्रिबा च्वरा माना, हिन्नाङ आङ होएते मियि च्वरा क्याइरे लोबिनलो।<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">कोरयि नाजा होएता झिला टाटाका</para>
  <para style="r">
    <ref loc="MRK 1:40-45">मर्कुस १:४०-४५</ref>; <ref loc="LUK 5:12-16">लुका ५:१२-१६</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />येशु रिने माला पापछारते च्येला मियि तुम छोम्मुवा झि ख्युइ क्यापला लेप्सोङ। <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />लाक्पा काकामि नाझा होएता मिझि ख्युइ तेहा लेप्सोङ, राङ ख्युइ धुनला पुइमु चुरे जु नाइसोङ, “हे प्रभु, ख्युइ धोप्पा चुङना ङाला टाक्तु जु ङ्युइकिनाइ?” <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />ख्युइ रेँ लाक्पा तेक्ते खोला छुइ क्याइसोङ, राङ नाइसोङ, “ङा धोप्पा किन होए, ख्योए टा सह।” हतितुइना राङ खुइ लाक्पा काकामि नाझा टा छारसोङ। <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />तेहि येशुयि हतिला नाइसोङ, “सुला हाङ माना। हिन्नाङ क्यु, राङ राङला पुजारितेबे तेहा तोन, राङ मोशायि आदेश पिपिनि भेटिते फुल, राङ मितेबाला साछि होङ।”<note caller="-" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">लेवि १४:१-३२</ref> </char></note><verse eid="MAT 8:4" /></para>
  <para style="s">येशुयि रोमि कप्तानयि यक्पुवाला टाक्तु च्युच्युका</para>
  <para style="r">
    <ref loc="LUK 7:1-10">लुका ७:१-१०</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />येशु कफर्नहुम भजारला स्युबितुइना कप्तान झि ख्युइ तेहा लेप्ते स्युवा क्याकाला छेलसोङ। ख्युइ नाइसोङ, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />“हे प्रभु, ङाहि यक्पुवा लेइराङ स्हुयि चाराङ मि घुलङानयि नाझि तुइरे नाइरे खिमला मालसाला राङ ङ्याङ्याला धु।”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />येशुयि हतिला नाइसोङ, “ङा लेप्ते हतिला टाक्तु झ्युकच्याइ।”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />हिन्नाङ घोबायि नाइसोङ, “हे प्रभु,” “ख्योएला ङाहि खिमला स्वगात कियापयि झ्योदायि ङा मेता। हिन्नाङ वचन मात्रा नोइ, राङ ङाहि यक्पुवा टाङान ना। <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />चिचालानाना ङा याङ आङकिङानबे हअला होए, राङ ङाहि हअला सिपाहितेबा होतो। ङा च्हि;ङा ‘क्यु’ नेन, तेहि हति ढुन, राङ स्यान झिला ‘सअ’ नेन, तेहि हति हुन। ङाहि यक्पुवाला ‘जु कि नेन, तेहि ख्युइ हति किन।’”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />ख्युइ ताम थोहिरे येशु ह:लाइसोङ, राङ ख्युइ च्येला होङान मितेबाला नाइसोङ, “ङा तेम्बारे खेला नाज्याइ, इस्राएलला याङ ङाहि झिम छेया हिछे किङान माखुसोङ। <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />ङा खेला नाज्याइ, स्यार राङ नुपने लेइराङ मि होङान ना, राङ अब्राहाम, इसहाक राङ याकुब ङ्याबो तेङलायि राज्ययि भत्यारला त्योएङान ना।<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="LUK 13:29">लुका १३:२९</ref> </char></note> <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />हिन्नाङ राज्ययि सन्तन फिला मुन्नाला ढिम्ङा ना। हतिया मितेबा ङुङान ना राङ सो च्हिरु झ्युङान ना।”<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 22:13">मत्ति २२:१३</ref>; <ref loc="MAT 25:30">२५:३०</ref>; <ref loc="LUK 13:28-29">लुका १३:२८-२९</ref> </char></note> <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />तेहि येशुयि घोबाला नाइसोङ, “क्यु, च्हिरु क्याइरे ख्युइ हिछे क्याइरे, हति च्वरा ख्योएला होङ।” तेहि हति यक्पुवा हतितुइना राङ टासोङ।<verse eid="MAT 8:13" /></para>
  <para style="s">येशुयि नाप्पा लेइराङला टाक्तु च्युच्युका</para>
  <para style="r">
    <ref loc="MRK 1:29-34">मर्कुस १:२९-३४</ref>; <ref loc="LUK 4:38-41">लुका ४:३८-४१</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />पत्रुसयि खिमना लेप छारते च्येला येशुयि ख्युइ इबिला छ्याबा फोक्ते खाटाला ङेरे ताताता थोङदु। <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />ख्युइ हति लाक्पा सुङदेलो, राङ छयाबायि हतिला ताङदे। तेहि हति लाँरे, राङ ख्युइ रुवा क्याइसोङ। <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />जब कमु च्युङदे, हतितुइना हतिबे ख्युइ तेहा ढे काकाला लेइराङ मि ख्योसोङ। राङ ख्युइ वचनने राङ क्याइरे ढे तेबाला फिला तोन्सोङ, राङ चोम नाप्पा होतो, पोरोला टाक्तु च्युक्तेलो। <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />यशैया ङोन्सेखिलङानयि नानाइबि ङोन्सेखिखिला पुरा होङयापला धि च्युच्युवा हिना, “खो खुरि हुइ तुक्का तेबा खेरतेलो, राङ ङि नाझा तेबा खुरते खेरसोङ।”<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="ISA 53:4">यशैया ५३:४</ref></char></note><verse eid="MAT 8:17" /></para>
  <para style="s">येशुयि क्यापला ढुइतुइना च्योङयापयि घोङ</para>
  <para style="r">
    <ref loc="LUK 9:57-62">लुका ९:५७-६२</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />जब येशुयि रेँ फाला छ्युला मियि तुम छोम्मुवा झि थोङसोङ, ख्युइ रेँ लोब्टुबाला छोयि फारकानला ढोयापयि आदेश च्युसोङ। <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />शास्त्रि झि ख्युइ तेहा लेप्सोङ, राङ खोला नाइसोङ, “गुरुज्यु, ख्योए काँहा-काँहा डुन, ङा ख्युइ क्याप क्यापला होङज्याइ।”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />येशुयि हतिला नाइसोङ, “स्यालयि फु राङ पान्नाङयि च्याचिउतेबे छाङ हुन, हिन्नाङ मि पिजायि चाला ता घोबो ङेयापयि सा याङ मिधु।” <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />ख्युइ लोब्टुबे नाङने स्यान चियि नाइसोङ, “प्रभु, ताङला पुते ङाला ङाहि आकेला कुङयापयि आङ नाङ।”<note caller="-" style="x"><char style="xo" closed="false">8:21 </char><char style="xt" closed="false"><ref loc="1KI 19:20-21">१ राजा १९:२०-२१</ref></char></note> <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />हिन्नाङ येशुयि हतिला नाइसोङ, “ङाहि च्येला सअ स्यिस्यियायि राङ हतिबे रेँ स्यिस्यिया कुहोङ।”<verse eid="MAT 8:22" /></para>
  <para style="s">येशुयि हुरबो छोम्मुवा छोम मुवाला खुचुमे सोसोइबा</para>
  <para style="r">
    <ref loc="MRK 4:35-41">मर्कुस ४:३५-४१</ref>; <ref loc="LUK 8:22-25">लुका ८:२२-२५</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />येशु डुङगाला श्योन छारते ख्युइ लोब्टुतेबा ख्युइ च्येला लेप्सोङ। <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />अकस्मत छोला हुरबो छोम्मुवा-छोम्मुवा झि लेप्सोङ। राङ भाल्लापयि डुङगाला घेबाला छेलसोङ, हिन्नाङ येशु ङि टोटुवा राङ धु। <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />लोब्टुबा लेप्ते झु नेन राङ खोला लाङसोङ, “क्योप प्रभु! ङे स्यियाला छेलसोङ।” <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />येशुयि हतिबाला नाइसोङ, “हिछे टिझि किङान मिबा, खे चिला झिकिन?” तेहि खो लाँरे ख्युइ हुरबो छोम्मुवा राङ छो छोम्मुवाला ङारसोङ, राङ हुरबो छोम्मुवा च्यामाना त्येसोङ। <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />“धि च्हिरु मिने, चिचालानाना हुरबो छोम्मुवा राङ छो छोम्मुवा याङ धि आदेश ङ्यानकिन धु” नाइरे हति मिबा हा:लाइसोङ।<verse eid="MAT 8:27" /></para>
  <para style="s">ढो काकालि मि ङि</para>
  <para style="r">
    <ref loc="MRK 5:1-20">मर्कुस ५:१-२०</ref>; <ref loc="LUK 8:26-39">लुका ८:२६-३९</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />जब खो छोयि फारकान यहला गदरिनियि छेत्रला लेप्सोङ, हतितुइना ढे काकालि मि ङि तुरसाने हुइतुइना खोला ठेसोङ। हतिबा झोम झिझिरा धु, कि सु याङ हतिने होङयाप ढोयाप मिकितालो। <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />हतिबे जु नेन राङ क्ये तोनसोङ, “हे कजसुबायि पिजा, ख्युइ ङे ङ्याबो च्हि सरकार? ङि भेला माछाङि तुका तेरतु ख्योए ङिहा लेलेबा हिनाइ?” <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />हतिबेने आरोङ घ्याबोला फायि तुम छे्या झि छुन ताताता धुलो।<note caller="-" style="x"><char style="xo" closed="false">8:30 </char><char style="xt" closed="false"><ref loc="LUK 4:34">लुका ४:३४</ref></char></note> <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />ढेतेबे खोला जु नेनेगा स्युवा क्यापसोङ, “ख्योए ङेला धोन्ना, ङेला फायि तुमयि नाङला स्युतु छ्यु।” <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />तेहि ख्युइ हतिबाला नाइसोङ, “क्यु।” तेहि हतिबा थोन्दे फायि नाङला स्युसोङ, राङ फायि तुम पोरो टाने छो यहला छारसोङ राङ छ्युला नुपते स्यिसोङ। <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />फा छोङानतेबा टोइसोङ राङ भजारला पुते पोरो ताम राङ हति ढे काकालातेबाला च्हि च्युङ पोरो स्यातेलो। <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />तेहि भजारयि मि पोरो येशुला ठातु लेप्सोङ, राङ खोला थोङदे मितेबे हतिबे साने क्यु नाइरे खोला स्युवा क्यापतेलो।<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">येशुयि स्हुयि चा राङ स्हु मिघुङानयि नाझा होएताला टाक्तु च्युच्युका</para>
  <para style="r">
    <ref loc="MRK 2:1-12">मर्कुस २:१-१२</ref>; <ref loc="LUK 5:17-26">लुका ५:१७-२६</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />हति च्येला येशु डुङगाला स्योन्दे छोयि फारकानला पुइसोङ, राङ खुरि भजारला लेप्सोङ। <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />मितेबे खाटाला ङ्याङ्यालि स्हु च्याङ मिघुङानयि मिझिला ख्युइ तेहा ख्योसोङ। येशुयि हतिबे हिछे थोङदे स्हु च्याङ मिघुलङानयि मिला नाइसोङ, “पिजा, हिम्मत कि। ख्युइ तिक्पा माप च्युङदे।” <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />शास्त्रिबे नाङने लेइराङयि खोरे नाङला नाला छेलसोङ, “धि मिता कजसुबाला अल नेन्दु।” <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />येशुयि हतिबे समयि विचार हा:कोरे नाइसोङ, “खे चिचाला रेँ समला अल विचार किन? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />चिचालानाना काङ नायाप लाइला होतो, ‘ख्युइ तिक्पा माप च्युङसोङ,’ नायाप राङ ‘ल्हँ राङ क्यु’ नायाप? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />हिन्नाङ मि पिजाला पिरथिविला तिक्पा माप कियापयि आङ होतो नाइरे खि हा:को।” तेहि ख्युइ हति स्हु च्याङ मिघुलङान मितेला नाइसोङ, “ल्हँ, ख्युइ खाटा खुर, राङ खिमला क्यु।” <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />तेहि हति लाँसोङ राङ, रेँ खिमला पुइसोङ। <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />जब मिझोमयि धि थोङदे, तेहि हतिबा झिसोङ, राङ मिला धि च्वरायि शक्ति तेराङानयि कजसुबायि छे त्येसोङ।<verse eid="MAT 9:8" /></para>
  <para style="s">मत्तिला क्ये ताताङा</para>
  <para style="r">
    <ref loc="MRK 2:13-17">मर्कुस २:१३-१७</ref>; <ref loc="LUK 5:27-32">लुका ५:२७-३२</ref></para>
  <para style="r">
    <ref loc="MRK 2:13-17">मर्कुस २:१३-१७</ref>; <ref loc="LUK 5:27-32">लुका ५:२७-३२</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />येशु हतिने ढुइतुइना मत्ति नाङान मिझि मिला कर तुइङानयि अड्डाला ताताता थोङदे, राङ हतिबाला नाइसोङ, “ङाहि च्येला सअ।” तेहि खो लाँरे ख्युइ च्येला लेप्सोङ।<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />येशु मत्ति खिमला सेन ताताति भेलाला, कर तुइङान लेइराङ राङ तिक्पा किङानबा लेप्ते येशु राङ ख्युइ लोब्टु ङ्याबो सारु त्येसोङ। <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />जब फरिसिबे धि थोङदे, तेहि ख्युइ लोब्टुबाला नाइसोङ, “चिला खि गुरु कर तुइङानबा राङ तिक्पा किङानबा ङ्याबो सारु तोकिन?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />धि थोइरे येशुयि नाइसोङ, “नाझा मेताला डक्टर कोइबा मिहा, हिन्नाङ नाझा होएताबाला हुन। <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />हिन्नाङ पुते ‘धि च्हि ना खे स्ये: ङा भोल माना, ङिङ्च्ये धोप्पा किन।’ चिचालानाना ङा केवाकिङानला माना, हिन्नाङ तिक्पा किङान बाला क्ये तोङदु लेलेबाना।”<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="MAT 12:7">मत्ति १२:७</ref>; <ref loc="HOS 6:6">होशे ६:६</ref></char></note><verse eid="MAT 9:13" /></para>
  <para style="s">बर्तयि भारे ढियाप</para>
  <para style="r">
    <ref loc="MRK 2:18-22">मर्कुस २:१८-२२</ref>; <ref loc="LUK 5:33-39">लुका ५:३३-३९</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />तेहि युहान्नायि लोब्टुबा ख्युइ तेहा लेप्सोङ, राङ खोला टिसोङ, “चिला हु राङ फरिसिबा बर्त तोकिन, हिन्नाङ ख्युइ लोब्टुबा वर्त मितोता?” <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />येशुयि हतिबाला नाइसोङ, “जब थु ख्योबो लारकियाबा ङ्याबो तोकिन, च्हि हतिबा सम तु हुनाइ? हिन्नाङ हति ङिन होङान ना ख्योबो हतिबाने ख्योबोते खेराङान ना। तेहि हतिबा वर्त त्योएङान ना।<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“सुइ याङ कोहिला ङिङबाला सारबा कोहिलायि ल्हामबा मिक्याका। चिचालानाना सारबा ल्हामा कोहिला रालदु झुकिन, राङ कोहिला हतिलेयाङ मा रालिन। <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />सुइ याङ ङिङबा पाबुइ किउला सारबा छ्याङ मिभोरा, स्यान अर्थात च्हुटि छाकिन, राङ छ्याङ पुन, राङ च्हुटि मासि हुन। हिन्नाङ सारबा छ्याङ सारबा किउला भोरिन, राङ ङिकारला च्याङ मिहा।”<verse eid="MAT 9:17" /></para>
  <para style="s">याइरसयि पोमु राङ नाप्पा पोमुवा टाक्तु च्युच्युका</para>
  <para style="r">
    <ref loc="MRK 2:18-22">मर्कुस २:१८-२२</ref>; <ref loc="LUK 5:33-39">लुका ५:३३-३९</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />जब येशुयि हतिबाला धि ताम नेन ताताता होतो, तेहि यहुदि झोमसि खिमयि आङकिङान झि लेप्सोङ, राङ खोला छ्या चालदे नाइसोङ, “ङाहि पोमु थाल्लाका स्यिसोङ, हिन्नाङ लेप्ते मुइ थोला ख्युइ लाक्पा पोर, राङ हति सोम्बो होङान ना।” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />येशु लाँरे राङ ख्युइ लोब्टु ङ्याबो आङकिङानयि च्येला पुइसोङ। <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />हति भेलाला राङ लो च्युनङिने ठा झाङानयि नाझा होएता पुमो झि क्यापने लेप्ते येशुयि कोहिलायि नेमु झिला घुलसोङ।<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="MAT 14:36">मत्ति १४:३६</ref></char></note> <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />चिचालानाना मुइ सम नाङ नाङला टान्दुलो कि, “ङाहि ख्युइ कोहिला झि छुइ क्याइनाङ ङा टाङान ना नाइरे।” <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />फरक्याला क्यापला लक्ते तेतुइना येशुयि हति पुमोला थोङसोङ, राङ नाइसोङ, “पोमु, हिम्मत कि, ख्युइ हिछेयि ख्योएला टाक्तु च्युसोङ।” हति पोमु हति भेलाला राङ टासोङ।<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />तेहि जब येशु आङकिङानयि खिमला क्योपते, ख्युइ लिउ भुङानतेबा राङ मिझोमयि क्ये लोङ कुइलोङ किङान थोङसोङ। <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />ख्युइ हतिबाला नाइसोङ, “फिला क्यु, चिचालानाना नोज्युङते स्यिस्यिया मि धु, हिन्नाङ ङ्याङ्याला धु।” हतिबे खोला कोतेलो। <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />मिझोमला फिला तोन्छारते खो नाङला स्युसोङ, राङ हति पुमोयि लाक्पा सुङसोङ, तेहि हति पुमो हो:प्तेमेला लाँसोङ। <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />हति लाइयि टाइक्ये छेत्र पोरोला टाइक्ये च्युङसोङ।<verse eid="MAT 9:26" /></para>
  <para style="s">येशुयि मि कानाला ङिला टाक्तु च्युच्युका</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />येशु हतिने ढुइतुइना मि काना ङि “हे दाउदयि पिजा, ङि थोला ङिङ्च्ये कि” नेन राङ ख्युइ च्येच्येला लेप्सोङ। <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />खो खिमयि नाङला स्युरे हति काना मितेबा ख्युइ तेहा लेप्सोङ। येशुयि हतिबाला नाइसोङ, “ङाहि टाक्तु झ्यु ङ्युकिन नाइरे च्हि खे हिछे किनाइ?” हतिबे खोला नाइसोङ, “ज्यु, प्रभु।”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />तेहि येशुयि हतिबे मिला घुल्दे नाइसोङ, “खि हिछे क्याक्याइबा च्वरा खेला सअ।” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />तेहि हतिबे मि पेसोङ। येशुयि हतिबाला जु नाइरे कडा चतावानि पिन्सोङ, “धि ताम सुला हा:कोरु माझ्यु।” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />हिन्नाङ हतिबा पुइसोङ, राङ हति देश काङ ख्युइ क्याक्याइबि लाइयि टाइक्ये च्युङसोङ।<verse eid="MAT 9:31" /></para>
  <para style="s">ताम ना मिङ्युइङान मिझिला येशुयि टाक्तु च्युच्युका</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />जब हतिबे थोन्दे ढुन ताताता होतो, हतितुइना ढे काकाला ताम ना मिङ्युइङान मिझि येशुयि तेहा ख्योसोङ। <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />ढे तोन्दे च्येला हति ताम ना मिङ्युइङान ताम नाइसोङ। तेहि “इस्राएलला जबयाङ माथोङालो” नाइरे मिझोम हा:लाइसोङ। <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />हिन्नाङ फरिसिबे नाला छेलसोङ, “ढेयि ताक्पोने क्याइरे हति ढे धोनकिन।”<verse eid="MAT 9:34" /></para>
  <para style="s">येशु मितेबाला ङिङच्यिन</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />येशु लेइराङ भजारतेबा राङ युल यला हतिबे यहुदि झोमसि खिमतेबाला छोइ तेकिन राङ, राज्ययि लोन ल टाइक्ये किनराङ राङ कुरुकुरु नाझा राङ नोप्पुवातेबा टाक्तु झुकिन राङ पुइसोङ।<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 4:23">मत्ति ४:२३</ref>; <ref loc="MRK 1:39">मर्कुस १:३९</ref>; <ref loc="LUK 4:44">लुका ४:४४</ref></char></note> <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />हिन्नाङ मिझोमतेबाला थोङदे ख्युइ सम हतिबे चाला ङिङच्येयि खाँसोङ। चिचालानाना हतिबा रच्चिया मेता लु च्वरा रुवा किङान मेता राङ घो ख्यख्यामा च्वरा धु।<note caller="-" style="x"><char style="xo" closed="false">9:36 </char><char style="xt" closed="false"><ref loc="NUM 27:17">गन्ति २७:१७</ref>; <ref loc="1KI 22:17">१ राजा २२:१७</ref>; <ref loc="2CH 18:16">२ इतिहास १८:१६</ref>; <ref loc="EZK 34:5">इजकिएल ३४:५</ref>; <ref loc="MRK 6:24">मर्कुस ६:२४</ref></char></note> <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />तेहि ख्युइ रेँ लोब्टुबाला नाइसोङ, “तोङगि ढेबु लेइराङ धु, हिन्नाङ स्यिङला लाइकिङानतेबा ङ्युवा धु। <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />हतिचाला भालियि प्रभुला मोनलाम क्योप, राङ खो खुरि तोङगि ढेबु तुप्यापला स्यिङयि लाइकिङान चाँहोङ।”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">लोब्टु च्युनङि</para>
  <para style="r">
    <ref loc="MRK 3:13-19">मर्कुस ३:१३-१९</ref>; <ref loc="LUK 6:12-16">लुका ६:१२-१६</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />ख्हुइ रेँ च्युनङि लोब्टुबाला क्ये ताङदे भाभा ढेतेबाला धोनयापयि राङ च्हिरु नाझा च्युङ नाङ टाक्तु झुयापयि आङ हतिबाला पिन्सोङ। <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />च्युनङि लोब्टुतेबे मिन धिना, ताङस्युवा पत्रुस नाङान सिमोन राङ हति भाइ अन्द्रियास, जब्दियायि पिजा याकुब राङ हति भाइ युहान्ना, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />फिलिप राङ बारथोलोमाइ, थोमा राङ कर तुइङान मत्ति, अल्फयसयि पिजा याकुब राङ थेदियस, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />सिमोन कनानि राङ यहुदा इस्करियोत, सुइ येशुला सुङदु च्युकते।<verse eid="MAT 10:4" /></para>
  <para style="s">लोब्टु च्युनङियि स्यापच्यि लाइ</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />येशुयि हति लोब्टु च्युनङिला जु नाइरे आदेश च्युक्ते चाँरेलो, “यहुदि मान्ते मितेबे उइला माढो, राङ सामरियायि भजारला मास्यु।<note caller="-" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="JER 50:6">यर्मिया ५०:६</ref></char></note> <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />हिन्नाङ इस्राएल मितेबायि तोतोरि लुतेबे चिना क्यु। <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />‘तेङलायि राज्य धुनला होङलेके धु नाइरे,’ टाइक्ये कि। <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />नाप्पातेबाला टाक्तु छ्यु, स्यिस्यियातेबाला सोम्बो सोइ, लाक्पा काकामि नाझा होएतातेबाला चाङमा सोइ, ढेतेबाला थोन। खेला लाइला क्याइरे कुँरे, लाइला ला राङ पिन। <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />खे रेँ काराला सेर, ङुल राङ स्हायि सिक्का माखुर, <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />ढुल कियापयि चाला झोला, झोर ङि कोचिया, पौला, पेरका माखेर। चिचालानाना स्यिङयि लाइकिङानयि ख्युइ ङ्योप्पा खुकोइ हुन।”<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="1CO 9:14">१ कोरिन्थि ९:१४</ref>; <ref loc="1TI 5:18">१ तिमोथि ५:१८</ref></char></note> <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />“काङ भजार कि युलाला खे स्युकिन, हतिया सु झ्योनबो धु नाइरे फोए, राङ हतिने छुट्टि मा च्युङथु हतिया राङ त्योए। <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />हति खिमयि नाङला स्युभि तुइना नमस्ते कि। <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />हति खिम ल होएना, खि शान्ति हति खिमला सअ। हिन्नाङ हति खिम ल मेना, खि शान्ति खेला राङ लक्ते सअ। <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />तेम्बारे सुइ याङ खेला माङ्यान ना वा खि ताम माङ्यान ना, हति खिम अर्थात भजारने थोतुनिइना रेँ काङबायि साबे स्यु।<note caller="-" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">प्रेरित १३:५१</ref></char></note> <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />तेम्बारे ङा खेला नाज्याइ, ल अल भेयापयि ङिनला हति भजारयि दशाले बरु सदोम राङ गमोरायि हालत लेइराङ सहिकि ङ्युङान होङान ना।”<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 11:24">मत्ति ११:२४</ref>; <ref loc="GEN 19:24-28">उत्पत्ति १९:२४-२८</ref></char></note><verse eid="MAT 10:15" /></para>
  <para style="s">होङानयि तुरि</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />“तोइ, ङा खेला वाजेबे तुमयि उइला लु च्वरा क्याइरे चोँङिन होए, हतिचाला खे रुल च्वरा च्याङबो राङ ङोम्मु लेम्बा सअ।<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="LUK 10:3">लुका १०:३</ref></char></note> <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />हिन्नाङ मितेबाने च्याङबो कि, चिचालानाना हतिबे खेला अदालतला स्योएङान ना राङ हतिबे यहुदि झोमसि खिमला खेला च्यायि छेरमा क्याङान ना। <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />खेला ङाहि चाला हाकिमतेबा राङ क्यालबोतेबे धुनला लाँतु झ्युङान ना राङ खे राङ यहुदि मान्ते मितेबे चाला साछि होङान ना। <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />हिन्नाङ जब हतिबे ख्योएला सुङदु झ्युकिन, तेहि च्हिरु क्याइरे राङ च्हि नाज्याइ नाइरे सम तु माके। चिचालानाना खि च्हि नायाप ना, हति भेलाला खेला नाङान ना। <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />चिचालानाना नाङान खे राङ होङान ना, हिन्नाङ खि आकि आत्मा खि लाम्ला नाङान ना।” <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />“भाइयि भाइला सोएयापयि चाला सुङदु झुङान ना राङ आकि पिजाला, पोमुला राङ पिजा राङ पोमु आके आमायि विरोधला लाँङान ना राङ हतिबाला सोतु झ्युङान ना। <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />ङाहि मिनयि चाला पोरोने खे अल होङान ना। हिन्नाङ सु सिनसिन थु तोकिन, हति थारथोनङान ना। <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />जब हतिबे खेला भजार झिला तुक्का तेरिन तेहि हतितुइना स्यान झिला टोइरे क्यु। चिचालानाना ङा तेम्बारे खेला नाज्याइ, मि पिजा होङयापले ताङला खे च्हि क्याइरे याङ इस्राएलयि भजार पोरो खि खिरि लाइ चाचारा होङान माना ना।”<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />“लोब्टु रेँ गुरुले राङ यक्पुवा रेँ ताक्पोले छेया मिहा। <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />लोब्टु रेँ गुरु च्वरा राङ यक्पुवा रेँ ताक्पो च्वरा होङयाप ढुक्क होतो तेम्बारे खि खिमयि ताक्पोला राङ बालजिबुल<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="ft" closed="false">तुइ</char></note> नानाइबा होएना, हति प्येराला झन चोम नेन?”<verse eid="MAT 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />“हतिचाला हतिबाला माझि। चिचालानाना कापते मिथोन याप राङ भाइरे हा:मिकोङान सुयाङ मिहा। <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />काङ ङा खेला मन्नाला नेन, हति खे साल्बोला नोइ, राङ काङ खि नामज्योला थोयिन, हति खिमयि खानाने टाइक्ये कि। <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />हतिबाला माझि सुइ स्हुते सोकिन, हिन्नाङ समला सयोए मिङ्युइबा। बरु सम राङ सु ङिकारला ङ्यालबाला मासि लोङ ङ्युइङान कजसुबाला झि। <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />च्हि आलाइ ङेला च्यिलपा ङि मि घ्युराइ? हति नाङने च्हि याङ खि आकि धोप्पा माक्याइना साला मिछारा। <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />खि घोबुइ स्येबु पोरो टाँगा चिरे च्हि क्याक्याइबा होतो। <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />हतिचाला खे माझि, खे लेइराङ च्यिलपाले याङ घोङछेया होतो।”<verse eid="MAT 10:31" /></para>
  <para style="s">येशुला स्विकार राङ अस्विकार</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“हतिचाला पोरो सुइ ङाला मियि धुनला ङ्यानकिम, ङा याङ हतिला तेङला ना होएता ङाहि आकि धुनला ङ्यानज्याइ। <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />हिन्नाङ पोरो सुइ ङाला मितेबे धुनला ङोमिस्येबा नेन, ङा याङ हतिला तेङलाना होएता ङाहि आकि धुनला ङोमिस्येबा नाज्याइ।”<verse eid="MAT 10:33" /></para>
  <para style="s">शान्ति माना हिन्नाङ तोरबालि</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />“ङा पिरथिविला शान्ति ख्योङदु लेलेबा ना नाइरे माटान। शान्ति ख्योङदु माना, हिन्नाङ तोरवालि चलाइ कितु लेलेबा ना। <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />चिचालानाना ङा मिला हति आकि विरोधला राङ पोमुला हति आमायि विरोधला राङ जबला हति इबियि विरोधला कितु लेलेबा ना।” <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />मियि टा रेँ खिमयि प्येरे नाङने राङ होङान ना। <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />“सुइ ङाले याङ मा रेँ आके राङ आमाला करि किन, हति ङाहि लोब्टुयि झोदायि मिहा। सुइ ङाले याङ मा रेँ पिजा याङ पोमुला किन, हति ङाहि लोब्टुयि झ्योदायि मिहा। <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />सु रेँ क्रुस खुरते ङाहि च्येला मिहा, हति ङाहि लोब्टुयि झ्योदायि मिहा। <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />सुइ रेँ उ क्योबिन, ख्युइ हति मासिलोङिन, राङ रेँ उ ङाहि चाला मासि लोङानति हतिला मिजे खुङान ना।<verse eid="MAT 10:39" /></para>
  <para style="s">इनाम</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />“खेला ङ्यानङानति ङाला ङ्यानकिन, राङ ङाला ङ्यानङानति ङाला चोँङानला ङ्यानकिन। <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />सुइ कजसुबायि ङोन्सेखिलङानला स्वागत किन चिचालानाना खो कजसुबायि ङोन्सेखिलङान ना, खोला ख्युइ इनाम खुङान ना। राङ सुइ केवाकिङान मिला स्वागत किन चिचालानाना हति केवा किङान मि ना, खोला ख्युइ इनाम खुङान ना। <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />सुइ धि टिमाबे नाङने चिला ङाहि लोब्टु मानि क्याइरे भोटो झि छ्यु टाङमु झि मात्रा याङ थुङयापला पिन्ना, तेम्बारे ङा खेला नाज्याइ, हति रेँ इनाम नामयाङ मासि मिलुँवा।”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">येशु राङ बप्तिस्मा तेराङान युहान्ना</para>
  <para style="r">
    <ref loc="LUK 7:18-35">लुका ७:१८-३५</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />रेँ लोब्टु च्युङिला आदेश पिन छारते येशु हतिने हतिबे भजारला लोप्तु राङ लोन ल टाइक्ये कितु पुइसोङ। <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />बप्तिस्मा तेरङान युहान्नायि ख्रिष्टयि लाइतेबे टाइक्ये झ्याल्ला थोइसोङ, राङ रेँ लोब्टुतेबाला ख्युइ तेहा धि ताम ढिरु चाँसोङ। <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />हतिबे येशुला टिसोङ “होङानते ख्योराङ ना, कि ङे स्यानला कुँरे तोच्याइ?” <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />येशुयि हतिबाला नाइसोङ, “खि थोथोइबा राङ थोथोङि ताम युहान्नाला नोइ, <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />कानातेबाला मि खुङान ना, राङ ढुढियातेबा काङबि ढोङान ना। लाक्पा काकामि नाझा होएतातेबा टाङान ना। नामज्यो होहोनातेबा थोइ ङ्युङान ना। स्यिस्यियातेबा सोम्बो च्युङदे लाँलाँबा धु, राङ टाङनाबाला लोन ल टाइक्ये किनराङ धु।<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">यशैया ३५:५-६</ref>; <ref loc="ISA 61:1">६१:१</ref> </char></note> <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />‘काङानतेबा सुइ ङाहि थोला संका मिकिता।’”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />तेहि युहान्नायि लोब्टुतेबा पुते येशुयि युहान्नायि भारेला मिझोमतेबाला नाला छेलसोङ, “जब खे युहान्नाला तारु च्याङ मेते साला पुते च्हि थोङसुइ? च्हि हुरबुइ ङ्युमि ङोलोला स्युस्युबा? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />हतितुइना खे चिला थोन्दे? च्हि कोहिला झ्याबो कोकोनि मिला तारु? कोहिला झ्याबो कोकोनाता क्यालबुइ खिमला तोकिन। <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />खे चिला थोन्दे? ङोन्सेखिलङानला तारु? हिनाइ, ङा ख्योएला नाज्याइ, ङोन्सेखिलङान याङ मि छेयाला। <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />चिचालानाना युहान्ना हति मि ना सुइ भारेला पवित्र शास्त्राला टिटिबा धु, ‘तोइ, ङा ङाहि तेङलायि लोन खेराङानला ख्युइ ताङ ताङला चोङज्याइ, सुइ ख्युइ धुनला ख्युइ लाम तयार सोङान ना।’<note caller="-" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">मलाकि ३:१</ref> </char></note> <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />तेम्बारे ङा खेला नाज्याइ, पुमोला क्येक्येबाने बप्तिस्मा तेरङान युहान्नाले छेया स्यान सु याङ मेता। हचु हिन्नाङ तेङलायि राज्यला सु पोरोले छुवा होए, हतिते युहान्ना छेया ना। <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />बप्तिस्मा तेराङान युहान्नायि टाइक्ये किति भेलाने थाल्ला थु तेङलायि राज्ययि सु छेया क्याइरे याला-याला डुन राङ धु, तेहि आङ छेया मितेबा तोप राङ ङ्याबो हतिला सुङिन। <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />चिचालानाना युहान्नायि भेला थु ङोन्सेखिलङानतेबा पोरो राङ मोशयि ठिमयि कजसुबायि राज्यि भारेला ङोन्सेखिखिला होतो। <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />खे ङ्यानयापला तयार होएना, होङानयि एलिया धि राङ ना।<note caller="-" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="MAL 4:5">मलाकि ४:५</ref>; <ref loc="MAT 17:10-13">मत्ति १७:१०-१३</ref>; <ref loc="MRK 9:11-13">मर्कुस ९:११-१३</ref> </char></note> <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />सुला ङ्यानयापयि नामज्यो होए, हति ङ्योन।” <verse eid="MAT 11:15" /><verse number="16" style="v" sid="MAT 11:16" />“ता ङा धि पुस्ता काङ ङ्याबो थुक च्याइ? धि ता भजारला आलिचेङान च्यिटा टिमा च्वरा ना, सुइ हतिबे रुवाला क्येतुइ, राङ नेन, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />‘ङि खि चाला लिउ पुइरे, हिन्नाङ खे मा छ्यामसोङ। ङि बैरायि लु लाँरे, हिन्नाङ खि छिमा मापिसोङ।’ <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />चिचालानाना युहान्ना सेन राङ थुङिन मालेबा, राङ हतिबा खोला ढे काकाला धु नाइरे नेन्दु। <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />मि पिजा सेन राङ थुङिन लेप्सोङ, राङ हतिबा नेन्दु, ‘तोइ, साढिया, छहझिया, कर तुइङान राङ तिक्पा किङानबे रुवा!’ कजसुबायि बुद्धि थारका ना नाङानयि ताम हति लाइने राङ प्रमाणित हुन।”<verse eid="MAT 11:19" /></para>
  <para style="s">हिमिछेकिङान भजारबा</para>
  <para style="r">
    <ref loc="LUK 10:13-15">लुका १०:१३-१५</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />काङ-काङ भजारला येशयि लेइराङ शक्तिशालि लाइतेबा क्याक्याइबा होतो, ख्युइ हतिबाला ङारतु च्युसोङ, खुँते हतिबे घ्योप्पा माकाइबालो। <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“धिक्कार ख्योएला, ए खोराजिन! धिक्कार ख्योएला, ए बेथसेदा! चिचालानाना खि तिया क्याक्याबि शक्तिशालि लाइबा टुरोस राङ सिदोनला क्याइबा नाना हतिबे ख्युइ राङ पुवायि कोहिला कोन्दे कघि थाबे कुइरे घ्योप्पा क्याइछाराना।<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">यशैया २३:१-१८</ref>; <ref loc="EZK 26:1-21">इजकिएल २६:१-२१</ref></char></note> <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />हिन्नाङ ङा खेला नाज्याइ, ल अल भेयापयि ङिनला खेले केना ता टुरोस राङ सिदोनयि हालत लेइराङ कुइरे त्योएयाप हुन। <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />ए कफर्नहुम, च्हि ख्योए पान्नाङ थु धेकिनाइ च्हि? ख्योए हअलु थु ढिमङान ना। चिचालानाना ख्युइ तिया क्याक्याइबि शक्तिशालि लाइतेबा सदोमला क्याइबा नाना हति तिरिङयि ङिन थु लुइलुइबा होतोना।<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">यशैया १४:१३-१५</ref>; <ref loc="GEN 19:24-28">उत्पत्ति १९:२४-२८</ref> </char></note> <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />हिन्नाङ ङा ख्योएला नाज्याइ, ल अल भेयापयि ङिनला ख्योएले ता सदोम मुलुयि हालत लेइ कुइरे त्योएयाप होङान ना।”<verse eid="MAT 11:24" /></para>
  <para style="s">ङाहि तेहा सअ राङ ङालसोइ</para>
  <para style="r">
    <ref loc="LUK 10:21-22">लुका १०:२१-२२</ref></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />हति भेलाला येशुयि नाइसोङ, “हे आके, तेङला राङ पिरथिवियि प्रभु, ङा ख्योएला कटिनक्या नाज्याइ, चिचालानाना ख्युइ धि ताम बुद्धिमान राङ स्येरे भाइरे पोरसोङ, हिन्नाङ च्यिबातेबाला हति थोङदु च्युसोङ।” <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />हिना, आके, चिचालानाना ख्योएला धि ल स्येदु। <verse eid="MAT 11:26" /><verse number="27" style="v" sid="MAT 11:27" />“ङाहि आकि पोरो क्यु ङाला स्यास्याता होतो। आकि अर्थात पिजाला सुइयाङ ङोमिस्येबा, राङ पिजि अर्थात आकेला सुइ याङ ङोमिस्येबा, तेहि हतिबे याङ ङोसेकिन सुला पिजि आके थोङदु झुयापयि धोप्पा किन।”<note caller="-" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="JHN 3:35">युहान्ना ३:३५</ref>; <ref loc="JHN 1:18">१:१८</ref>; <ref loc="JHN 10:15">१०:१५</ref> </char></note> <verse eid="MAT 11:27" /><verse number="28" style="v" sid="MAT 11:28" />“हे पोरो क्यु राङ सम तुयि खाँखाँबा बा, ङाहि तेहा सअ, ङा खेला ङालसोरु झ्युकच्याइ। <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />ङाहि ङेरस्यिङ रेँ थोला खेर, राङ ङा ङ्याबो लोप, चिचालानाना ङा सम याबो राङ सम सिपोयि मिना, तेहि खि रेँ समला ङाल्सो खुङान ना।<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="JER 6:16">यर्मिया ६:१६</ref> </char></note> <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />चिचालानाना ङाहि ङेरस्यिङ लाइला होतो, राङ ङाहि खुरबो याँ होतो।”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">ङालसुइ ङिनयि भारेला टिटिबा</para>
  <para style="r">
    <ref loc="MRK 2:23-28">मर्कुस २:२३-२८</ref>; <ref loc="MRK 3:1-6">३:१-६</ref>; <ref loc="LUK 6:1-11">लुका ६:१-११</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />हति भेलाला येशु ङालसुइ ङिनला बालियि स्यिङबा च्युङदे ढुन त्येतु। ख्युइ लोब्टुबा टोपा ततबा धुलो राङ तोन भालियि ङिमा तुइरे साहाला छेलसोङ। <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />हिन्नाङ फरिसिबे धि थोङदे येशुला नाइसोङ, “तोइ, ख्युइ लोब्टुबा ङालसुइ ङिनला काङ कियाप ल माना, हति किनदु।” <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />हिन्नाङ येशुयि हतिबाला नाइसोङ, “दाउदयि, खो राङ खो ङ्याबो होएता च्हि क्याइरे, च्हि खि टटबा मेताइ?<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">१ शमुएल २१:१-६</ref> </char></note> <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />च्हिरु क्याइरे ख्युइ कजसुबायि खिमयि नाङला पुते पुपुलि लोटा साइरे? हति लोटा सायाप ता खोला न खो ङ्याबो होएताला, हिन्नाङ मात्रा पुजारिबाला मात्रा ल होतो।” <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />अर्थात च्हि मोशायि ठिमला टटबा मेताइ, च्हिरु क्याइरे ङालसुइ ङिनला पुजारिबे मोनलाम क्यासि खिमला ङालसुइ ङिनला भाभा सोइरे, राङ याङ दोषि मेता सोइरे?<note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="NUM 28:9-10">गन्ति २८:९-१०</ref></char></note> <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />हिन्नाङ ङा खोला नाज्याइ, “मोनलाम क्यासि खिमले हा:छेया ङिहा सु याङ होतोइ। <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />हिन्नाङ पवित्रशास्त्रा नेन्दु, ‘ङा भोल क्यायाप माना, ङिङ्च्ये धोप्पा किन’ नानाइबि खुँ चिना सो खि हा:कोकुवा नाना खि दोषि मान्ताला ख्योङान दोषि मासोइबा ना।<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="MAT 9:13">मत्ति ९:१३</ref>; <ref loc="HOS 6:6">होशे ६:६</ref></char></note> <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />चिचालानाना मियि पिजा ङालसुइ ङिनयि प्रभु ना।”<verse eid="MAT 12:8" /></para>
  <para style="s">लाक्पि चा मिघुलङानयि मिझि</para>
  <para style="r">
    <ref loc="MRK 3:1-6">मर्कुस ३:१-६</ref>; <ref loc="LUK 6:6-11">लुका ६:६-११</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />हतिने थोन्दे येशु हतिबे यहुदि झोमसि खिमला पुतेलो। <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />हतिया लाक्पा काकामा मिझि धुलो। हतिबे येशुला दोष सोयापयि विचारयि खोला टिरेलो, “च्हि ङालसुइ ङिनला सुलाङ टाक्तु झ्युयाप ल हिनाइ?”<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />येशुयि हतिबाला नाइसोङ, “खि नाङने सुइ याङ लु झि होतो, राङ ङालसुइ ङिनला हति तोङला छार रच्चिया नाना, च्हि ख्योए हतिला सुङदे फिला मिधोनाइ? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />लु ले मि चोमयि घोङ छेया ना? हतिचाला ङालसुइ ङिनला ठिमयि अनुसार ल कियाप ल ना।” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />तेहि ख्युइ हति मिला नाइसोङ, “ख्युइ लाक्पा क्योङ।” हति लाक्पा क्याङसोङ, राङ हति लाक्पा स्यानति च्वरा थारका च्युङसोङ। <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />हिन्नाङ फरिसिबे फिला पुते खोला च्हिरु क्याइरे सोच्याइ नाइरे ख्युइ विरोधला टोइ किताला छेलसोङ।<verse eid="MAT 12:14" /></para>
  <para style="s">कजसुबायि धाधामि स्यापच्यि</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />तेहि हति ताम हा:कोरे येशु हतिने पुइ छारसोङ, राङ लेइराङ ख्युइ च्येला लेप्सोङ, राङ ख्युइ हतिबा पोरोला टाक्तु च्युसोङ, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />राङ खो सु हिना सुला याङ मिनायापयि हतिबाला चेतावानि पिन्सोङ। <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />यशैया ङोन्सेखिलङानयि लाम्ला कजसुबायि नानाइबि वचन पुरा होङ नाइरे राङ धि नानाइबा ना, <verse eid="MAT 12:17" /><verse number="18" style="v" sid="MAT 12:18" />“ङाहि यक्पुवा सुला ङाहि धाम्दे, ङाहि करि मि सु ङ्याबो ङा काका होतो, ङा ङाहि आत्मा हतिला भोर च्याइ, राङ हति यहुदि मान्ते मितेबाला न्याययि टाइक्ये किङान ना। <verse eid="MAT 12:18" /><verse number="19" style="v" sid="MAT 12:19" />हति न क्याइरे च्येङान ना न लेइराङ क्ये धोनङान ना, न त सुइ याङ ख्युइ क्ये युलयि लाम्ना माला थोइङान ना। <verse eid="MAT 12:19" /><verse number="20" style="v" sid="MAT 12:20" />छ्याछ्याकि ङ्युमा हति च्योङान माना ना, राङ स्ययाला छेलङान किङानयि छोएमे हति सोएङान मानाना। राङ च्येस्युवाला ल अल भेयापला क्यालदु झ्युङान ना। <verse eid="MAT 12:20" /><verse number="21" style="v" sid="MAT 12:21" />ख्युइ मिनला रास्ट्र रास्ट्रयि मि पोरोयि आशा भोरङान ना।”<verse eid="MAT 12:21" /></para>
  <para style="s">येशु राङ बालजिबुल</para>
  <para style="r">
    <ref loc="MRK 3:20-30">मर्कुस ३:२०-३०</ref>; <ref loc="LUK 6:43-45">लुका ६:४३-४५</ref>; <ref loc="LUK 11:14-23">११:१४-२३</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />तेहि ख्युइ तेहा ढे काकाला च्हि काना राङ लेम्बा मि ख्योरेलो। येशयि हतिला टाक्तु च्युसोङ, धि थु कि, हति लेम्बा मि ताम ना ङ्युङान राङ थोङान च्युङसोङ। <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />तेहि मिझोम पोरो हा:लाइरे नाइसोङ, “च्हि धि दाउदयि पिजा राङ हिन होएरोए?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />हिन्नाङ धि थोइरे फरिसिबे नाइसोङ, “धि मियि तुइतेबे ताक्पो बालजिबुलयि लाम्ला मात्र ढेतेबाला धेकिन?”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />हिन्नाङ येशुयि हतिबे विचार हा:कोरे हतिबाला नाइसोङ, “ङ्याबो खा पेपेया पोरो राज्य मासि सोङान ना, राङ पोरो भजार अर्थात रेँ खिमयि प्येरा च्यिकि नाङला ठुझि च्युङना हति मिलुइबा। <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />तेम्बारे तुइयि तुइला धोन्ना ता, हति रेँ विरोधला खा पिन, राङ हचु हिन्ना च्हिरु क्याइरे हति राज्य लुइकिन? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />तेम्बारे ङाहि बालजिबुलयि लाम्ला ढेतेबा धेना, खि पिजातेबे सुइ चाने हति धोनकिन? हतिचाला हतिबा राङ खि ल अल भेङान होङान ना। <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />हिन्नाङ तेम्बारे कजसुबायि आत्मायि लाम्ला ङा ढेतेबा धेकिन नाइना कजसुबायि राज्य खि तेहा लेप छारते।” <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />“ताङला स्युछेया मिला मातामना। हति खिमयि नाङला स्युरे सुइ हति क्यु सामान खेरते ढो ङ्युकिन? हति तोप छेयायि मितेला तामदे च्येला मात्रा हति खिमने कु ङ्युइकिन।” <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />“सु ङा ङ्याबो मेता, हति ङाहि विरोध्ला होतो, राङ सुइ ङा ङ्याबो मितुता, हति थोरतु झ्युकिन। <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />हतिचाला ङा खेला नाज्याइ, मियि क्याक्याइबि तिक्पा पोरो राङ कजसुबाला अल नानाइबा माप खुङान ना, हिन्नाङ पवित्र आत्मायि विरोधला अल नानाइबा माप मिहा। <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />सुइ याङ मियि पिजायि विरोधला चिगा नाइना हतिला माप खुकिन, हिन्नाङ सुइ याङ पवित्र आत्मायि विरोधला नाइना हतिला धि काल्बा राङ होङानयि कालबा लायाङ माप मिखुबा।”<verse eid="MAT 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />“कि तोङबोङला ल सोइ राङ हति ढेबु ल होङान ना। कि तोङबोङला अल सोइ राङ हति ढेबु याङ अल होङान ना, चिचालानाना ढेबु ने राङ तोङबोङ ङोसेकिन।<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="MAT 7:20">मत्ति ७:२०</ref> </char></note> <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />ए रुलयि च्यिटा च्वरा चुन नाङान मिबा! खे-खे राङ अल धु, ल ताम च्हिरु क्याइरे ना ङ्युइकिन? चिचालानाना समला ला खाँखाँबि ताम राङ खाने थोनकिन।<note caller="-" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="MAT 3:7">मत्ति ३:७</ref>; <ref loc="MAT 23:33">२३:३३</ref>; <ref loc="MAT 15:18">१५:१८</ref>; <ref loc="LUK 3:7">लुका ३:७</ref> </char></note> <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />ल मियि रेँ नाङला खाँखाँबि ल क्युने ल क्यु राङ धोनकिन, हिन्नाङ अल मियि राङला खाँखाँबि अलने अल क्यु धोनकिन।”<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />“ङा खे ला नाज्याइ, पोरो छ्योमेतायि ताम काङ मितेबा नेन, ल अल भेयापयि ङिनला हतिबे हति टिरे तेरकोइहुन। <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />चिचालानाना ख्युइ वचनबाने ख्योए च्याङ माक्याइबि मि होङान ना, राङ ख्युइ वचनबने ख्योए दोषि होङान ना।”<verse eid="MAT 12:37" /></para>
  <para style="s">हा:लाइयापयि लाइयि माग</para>
  <para style="r">
    <ref loc="MRK 8:11-12">मर्कुस ८:११-१२</ref>; <ref loc="LUK 11:29-32">लुका ११:२९-३२</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />तेहि शास्त्रिबा राङ फरिसितेबे नाङने रेन रेनयि खोला नाइसोङ, “गुरुज्यु, ङे ख्योएने हा:लाइयापयि लाइ झि ता सोम होए।”<note caller="-" style="x"><char style="xo" closed="false">12:38 </char><char style="xt" closed="false"><ref loc="MAT 16:1">मत्ति १६:१</ref>; <ref loc="MRK 8:11">मर्कुस ८:११</ref></char></note> <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />येशुयि हतिबाला जवाक पिन्सोङ, “अल राङ व्यभिचार यि पालियि हा:लाइयापयि लाइ फाकिन। हिन्नाङ धि पालि ला योना ङोन्सेखिलङानयि हा:लाइयापयि लाइ अर्थात स्यान हा:लाइयापयि लाइ तोनङान मानाना।<note caller="-" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 16:4">मत्ति १६:४</ref>; <ref loc="MRK 8:12">मर्कुस ८:१२</ref> </char></note> <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />चिचालानाना च्हिरु क्याइरे योना ङिन सुम छान सुम ङ्या छेया झिकि टोपायि नाङला ताते, हति च्वरा क्याइरे मियि पिजा याङ पिरथिवि टोपि नाङला ङिन सुम छान सुम त्योएङान ना।<note caller="-" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="JON 1:17">योना १:१७</ref> </char></note> <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />निनवेयि मितेबा कजसुबायि ल अल भेयापयि ङिनला धि पालि ङ्याबो लाँङान ना, राङ हतिला दोषि सोङान ना, चिचालानाना हतिबे योनायि टाइक्ये कितितुइना घ्योप्पा क्याइसोङ, हिन्नाङ तोइ, योनाले छेया ङिहा सु याङ होतोइ।<note caller="-" style="x"><char style="xo" closed="false">12:41 </char><char style="xt" closed="false"><ref loc="JON 3:5">योना ३:५</ref> </char></note> <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />लोयि क्यालमु ल अल भेयापयि ङिनला धि पालि ङ्याबो लाँङान ना, राङ हतिला दोषि सोङान ना, चिचालानाना हति पिरथिवियि मोइ धुन्ने सोलोमनयि बुद्दि तामबा ङ्यान दु लेप्तेलो। हिन्नाङ तोइ, सोलोमनले छेया ङिया सु याङ ङिहा होतोइ।<note caller="-" style="x"><char style="xo" closed="false">12:42</char><char style="xt" closed="false"><ref loc="1KI 10:1-10">१ राजा १०:१-१०</ref>; <ref loc="2CH 9:1-12">२ इतिहास ९:१-१२</ref> </char></note><verse eid="MAT 12:42" /></para>
  <para style="s">ढे याङ क्येक्येबा</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“जब अल आत्मा मियि नाङने फिला थोन्दे ढुन, हति ङालसो फाकिन राङ ओबानोयि सा यहला युकिन राङ ढुनलो, हिन्नाङ काँहा याङ मिखुबा। <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />तेहि हति नेन लो, काने ङा थोन्दे लेप्ते, हतिया राङ ङा रेँ खिमला ‘ङा लक्ते ढोज्याइ।’ लक्ते हुइतुइना हति खिम तोङबा चाङमा सोसोइबा, राङ पोरो राङ ठाकिनलो। <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />तेहि हति ढुन राङ राङले याङ लेइराङ अल स्यान तुन थाबा ढे राङ ङ्याबो ख्योङिन, राङ नाङला स्युरे हतिबा हतिया ढोम्बोला तोकिनलो, राङ हति मियि च्येमा दसा ताङलाने तरह अल हुन। धि अल पालि ला याङ हति च्वरा होङान ना।”<verse eid="MAT 12:45" /></para>
  <para style="s">येशुयि आमा राङ भाइबा</para>
  <para style="r">
    <ref loc="MRK 3:31-35">मर्कुस ३:३१-३५</ref>; <ref loc="LUK 8:19-21">लुका ८:१९-२१</ref></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />येशु मिझोमबा ङ्याबो ताम नेन तातताला, ख्युइ आमा राङ भाइबा फिला लाँरे त्येतु, राङ खो ङ्याबो ताम ना सोम धुलो नाइरे मिझिला लोन चाँधु। <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />तेहि चिकि येशुला नाइसोङ, “तोइ, ख्युइ आमा राङ ख्युइ भाइबा फिला लाँरे त्येतु, राङ ख्योए ङ्याबो ताम नासोम किन्दु।” <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />हिन्नाङ खो ङ्याबो ताम नाङानला येशुयि नाइसोङ, “ङाहि आमा सुना? ङाहि भाइबा सुना?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />तेहि ख्युइ रेँ लाक्पि तोनिन राङ लोब्टुबाला नाइसोङ, “तोइ ङाहि आमा राङ भाइबा। <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />चिचालानाना सुइ तेङलाना होएता ङाहि आकि धोप्पा ङ्यानकिन, हति राङ ङाहि भाइ, राङ भैनि, राङ ङाहि आमा ना।”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">सावोन झुयापयि प्ये</para>
  <para style="r">
    <ref loc="MRK 4:1-12">मर्कुस ४:१-१२</ref>; <ref loc="LUK 8:4-10">लुका ८:४-१०</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />हति ङिन येशु खिमने थोन्दे छो छोम्मुवायि नेमुला छोलि लोप्तु त्येसोङ। <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />तेहि होचोम मियि तुमछेया झि छो छोम्मुवायि नेमुला झोम्सोङ, “कि खो डुङगाला स्योनदे त्येसोङ, तेहि मि पोरो नेमुला लाँरे त्येसोङ।”<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">लुका ५:१-३</ref></char></note> <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />ख्युइ हतिबाला प्येला लेइराङ ताम नाइसोङ। ख्युइ नाइसोङ, “ङिन झि सावोन झुङान मिझि सावोन झुतु पुइसोङ। <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />हति च्वरा क्याइरे सावोन झुबितुइना रेन सावोन लामला छारसोङ, राङ च्याचिउ लेप्ते हति साइसोङ। <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />रेन सावोन टोउ होएताला छारसोङ, काँहा लेइराङ टोउ मिधु, राङ सा तिङरिङमुवा मेताति हति घ्यबो राङ क्येसोङ। <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />हिन्नाङ जब ङिमा स्यारते हति रेछारसोङ, राङ प्हारा मेता ति हति कामछारसोङ। <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />रेन छेरमि उइला छारसोङ, हिन्नाङ छेरमातेबा छारिन लेप्ते हतिला लेसोङ। <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />सावोन रेन ल तेबा साला छारसोङ, राङ रेनयि क्या, राङ रेनयि खलसुम, रेनयि सुम च्यु गुणा ढेबु पिन्देलो।”<verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />तेहि येशुयि नाइसोङ, “सुइ नामज्यो होए, हति ङ्योन।”<verse eid="MAT 13:9" /></para>
  <para style="s">प्येला नायापयि खुँ</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />तेहि लोब्टुतेबा लेप्ते खोला नाइसोङ, “ख्योए चिला हतिबा ङ्याबो प्येला ताम नेन?” <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />ख्युइ हतिबाला जवाक पिन्सोङ, “खेला ता तेङलायि राज्ययि हा:मिकोङानबे तामयि छोइ पिपिना होतो, हिन्नाङ हतिबाला पिपिना मेता। <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />चिचालानाना सुला होतो, हतिला तरह लेइराङ तेरङान ना, राङ हतिला लेइराङ होङान ना। हिन्नाङ सुला मे, हतिला होएता तेयाङ हतिने ठङान ना।<note caller="-" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="MAT 25:29">मत्ति २५:२९</ref>; <ref loc="MRK 4:25">मर्कुस ४:२५</ref>; <ref loc="LUK 8:18">लुका ८:१८</ref>; <ref loc="LUK 19:26">१९:२६</ref> </char></note> <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />हतिचाला ङा खे ङ्याबो प्येला ताम नेन ‘चिचालानाना खे ताज्याइ ता तेन धु, हिन्नाङ मिथुवा, ङ्यान ज्याइता ङ्यानकिनदु, हिन्नाङ थोइरे हाङ हा:मिकुवा।’ <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />यशैयायि ङोन्सेखिखिला खेने पुरा च्युच्युवा होतो ङ्यानज्याइ ता खे ङ्यानकिनदु, हिन्नाङ जब याङ हा:मिकुवा, ताज्याइ ता तेनदु, हिन्नाङ जबयाङ मिथोङा। <verse eid="MAT 13:14" /><verse number="15" style="v" sid="MAT 13:15" />चिचालानाना धि मितेबे सम लेम्बा च्युङदु राङ हतिबे नामज्यो होनदु, राङ हतिबे रेँ मि चुमदे त्येतु, स्यान अर्थात हतिबे मियि थोङान ना, नामज्योयि थोइङान ना, समयि हा:कोङान ना, राङ लक्ते होङान ना, राङ ङा खेला टाक्तु झ्युङान ना।” <verse eid="MAT 13:15" /><verse number="16" style="v" sid="MAT 13:16" />हिन्नाङ खि सोरे ना, चिचालानाना हति थोङिन्दु। खि नामज्यो सोरे ना, चिचालानाना हति थोयिन।<note caller="-" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="LUK 10:23-24">लुका १०:२३-२४</ref> </char></note> <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />तेम्बारे ङा खेला नाज्याइ, खि थोथोङि ताम लेइराङ ङोन्सेखिलङानतेबे राङ केवाकिङानबे मितेबे तायाप लेइराङ धोप्पा क्याइसोङ, हिन्नाङ माथोङा, तेहि खि थोथोइबायि ताम ङ्यानयापयि धोप्पा क्याइसोङ, हिन्नाङ माङ्याना।<verse eid="MAT 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“सावोन झुङानयि प्ये खुँ ङ्योन। <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />जब सुइ मियि तेङलायि राज्ययि वचन ङ्यानकिन, राङ सो हा:मिकुवा, तेहि अल होङिनलो राङ हति समला काङ थोरतु च्युच्युका होतो सो ठरे खेरकिनलो। लामला चुचुबायि सावोनते हति राङ ना। <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />टोउ होएते साला चुचुबि सावोनते हति ना, सुइ वचन ङ्यानि पाल्ला केन राङ हति ङ्यानकिन। <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />हिन्नाङ हति रेँ प्हारा मेताति हति टिझि थु मात्रा तोकिनलो, राङ वचनयि चाला तुका या दशा घर लेबि पाल्ला हति मासि हुन। <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />छेरमाला सावोन चुचुबाते हतिना, सुइ वचन ङ्यानकिन, हिन्नाङ हति संसारयि समतु राङ क्युनोरयि छलति वचनला लेकिन, राङ हति ढेबु मितेरङान हुन। <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />हिन्नाङ ल साला चिचुबाते सावोनते हति ना, सुइ वचन ङ्यानकि न, राङ हा:कुनलो, राङ तेम्बारे ढेबु छ्यातु झ्युकिनलो। हतिने ताताबयि सावोनयि क्या गुणा, खलसुम गुणा राङ सुम च्यु गुणा ङिमा छ्याकिनलो।”<verse eid="MAT 13:23" /></para>
  <para style="b" />
  <para style="s">युरमि ङोलयि प्ये</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />येशुयि याङ हतिला स्यान प्ये झि स्येसोङ तेङलायि राज्य मिझि च्वरा ना, सुइ रेँ स्यिङला ल सावोन धेपकिन। <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />हिन्नाङ मितेबा ङ्यालिन ताताताला ख्युइ टा लेप्सोङ, राङ ढुतेबे उइला युरमा सावोन धेपकिन-धेपकिन पुइसोङ। <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />जब भोटि थोन्दे हतिला छ्यारे, तेहि युरमा याङ थोङसोङ। <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />खिमयि ताक्पोयि यक्पुवातेबा लेप्ते खोला नाइसोङ, “‘हजुर, च्हि ख्युइ रेँ स्यिङला ल सावोन ताताबा मानाइ? ङिहा युरमा काने लेप्ते?’” <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />“खिमयि ताक्पोयि हतिबाला नाइसोङ, ‘सु टाझिकि धि च्वरा क्याक्याइबा ना।’ यक्पुवातेबे हतिला नाइसोङ, ‘च्हि ङे पुते हति घके?’” <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />“हिन्नाङ ख्युइ नाइसोङ, ‘हति च्वरा माके, स्यान अर्थात खि युरमा घोकितुइना ढु याङ ङ्याबो घङान ना।’ <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />तोनतुइयापयि भेला थु हति ङि कारला ङ्याबो-ङ्याबो छारतु छ्यु। तोनतुइयापयि भेलाला ङाङानतेबाला ङा नाज्याइ, ‘ताङला युरमा कोक्ते मेला क्यायापला छ्याक्पा-छ्याक्पा तोम, हिन्नाङ ढुते ङाहि कुटिला पोर।’”<verse eid="MAT 13:30" /></para>
  <para style="s">रोयायि सावोन राङ सोढायि प्ये ङि</para>
  <para style="r">
    <ref loc="MRK 4:30-34">मर्कुस ४:३०-३४</ref>; <ref loc="LUK 13:18-21">लुका १३:१८-२१</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />येशुयि हतिला स्यान प्ये झि नाइसोङ, “तेङलायि राज्ययि रोयायि सावोन च्वरा ना, सुइ मिझिकि खेरते रेँ भारिला चुसोङ। <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />हति सावोन पोरोले छुवा हिना, हिन्नाङ जब छारकिन, तेहि हति पोरो सागले छेया हुन राङ तोङबोङ राङ हुन। पान्नाङयि च्याचिउतेबा लेप्ते हति ढालातेबाला छाङ सुनलो।” <verse eid="MAT 13:32" /><verse number="33" style="v" sid="MAT 13:33" />ख्युइ हतिबाला स्यान झि प्ये नाइसोङ, “तेङलायि राज्य सोढा<note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="ft" closed="false">सोटा च्वरा कारबो फे हतिते लोटा क्याकितुइना स्यिन</char></note> च्वरा ना, काङते पुमो झिकि ङि स्यु राङ च्यु किलोग्राम फेला स्येरे, राङ हति पोरो सोढायि भोइरे ल माच्युङ थु हतिला सा झिला पोरते।” <verse eid="MAT 13:33" /><verse number="34" style="v" sid="MAT 13:34" />येशुयि धि ताम पोरो प्येला नाइसोङ। प्ये मेताला ख्युइ हतिबाला च्याङ मानाइसोङ। <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />ङोन्सेखिलङानयि लाम्ला धि नानाइबा वचन पुरा च्युङसोङ, “ङा रेँ खा प्येतेबाला भेज्याइ, संसारके काल्बा छ्याने भाभाइबि ताम ङा नाज्याइ।”<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">भजनसंग्रह ७८:२</ref> </char></note><verse eid="MAT 13:35" /></para>
  <para style="s">युरमा प्येयि खुँ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />तेहि खो मिझोमला ताङदे येशु खिमला पुइसोङ, राङ ख्युइ लोब्टुतेबा ख्युइ तेहा लेप्ते नाइसोङ, “स्यिङयि युरमायि भारेला प्येयि खुँ ङेला नोइ।”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />येशुयि हतिबाला जवाक पिन्सोङ, “ल सावोन धेपङानते मियि पिजा ना। <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />तेहि स्यिङ संसार ना। ल सावोनते राज्ययि सन्तन ना, राङ युरमा अलयि सन्तन ना। <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />युरमा झुङानते टा तुइते ना। भालि तुइयापयि भेलाते काल्बा सिनयापयि च्येस्युवाते ना। स्यिङयि लाइ किङानतेबा तेङलायि लोन खेरङानतेबाना।” <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />“च्हिरु क्याइरे युरमा कोक्ते मेला झुकिन, काल्बा तँबितुइना याङ हति च्वरा होङान ना। <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />मि पिजा रेँ तेङलायि लोन खेरङानबा चोङान ना, राङ तिक्पा कितु झ्युङान पोरो क्यु राङ लाइ अल कितु झ्युङान पोरोला हतिबाला हति राज्यने तुइङान ना, <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />राङ हतिबाला मेयि मेरतोला ढिमङान ना। हतिया मितेबा ङुङान ना राङ सो चेङान ना। <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />तेहि केवाकिङानतेबा रेँ तेङलायि आकि राज्यला ङिमा च्वरा होए क्याङान ना। सुइ नामज्यो होतो, हति ङ्योन।<verse eid="MAT 13:43" /></para>
  <para style="s">कुकुबि क्युनोरयि प्ये</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“तेङलायि राज्य स्यिङ झिला कुँरे पोपोरि कुकुबि क्यु च्वरा ना, काङते मिझिला खुरे भाइरे भोरकिन, राङ आन्नद च्युङदे खो ढुन राङ राङला होएता पोरो छोङिनम राङ हति स्यिङ ङ्युन।<verse eid="MAT 13:44" /></para>
  <para style="s">घोङछेया नोरबु प्ये</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />“याङ तेङलायि राज्य ल नोरबु फेङान छोङ क्याङान झि च्वरा ना। <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />हति घोङ छोम्मुवा नोरबु झि खु छारते पुते राङला होएता पोरो चोँरे हति नोरबु ङयोइसोङ।<verse eid="MAT 13:46" /></para>
  <para style="s">झालोयि प्ये</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“तेङलायि राज्य छो छोम्मुवाला चुचुबि झालि झि च्वरा ना, काङला कुरु-कुरु ङ्या पोरो थेपबिन। <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />तेहि झाल खाँ छारते मितेबे हतिला नेमुला टुते तोन्सोङ, राङ ताते ल तेबाला धाम्दे स्हभुला च्युसोङ राङ, अलतेबा पोरोला फिला टिम्सोङ, <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />काल्बा तँबितुइना हति च्वरा राङ होङान ना, तेङलायि लोन खेरङान लेप्ते अल तेबाला केवाकिङानतेबे उइने भेङान ना, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />राङ हतिबाला मेयि मेरतोला ढिमङान ना। हतिया मितेबा ङुङान ना राङ सो च्येरु झ्युङान ना।”<verse eid="MAT 13:50" /></para>
  <para style="s">सारबा राङ ङिङबा तेम्बा</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />येशुयि टिसोङ, “च्हि खि धि तामबा पोरो हा:कोसुइये?” हतिबे खोला जवाक पिन्सोङ, “हा:कोसोङ।”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />तेहि येशुयि हतिबाला नाइसोङ, “हतिचाला तेङलायि राज्ययि छोइ खुखुबा पोरो शास्त्रि खिम झिकि ताक्पो च्वरा ना, सुइ रेँ झुप्पुने सारबा राङ ङिङबा घोङछेया सामानतेबा फिला धोनिन।”<verse eid="MAT 13:52" /></para>
  <para style="s">नासारातला येशुला इनकार</para>
  <para style="r">
    <ref loc="MRK 6:1-6">मर्कुस ६:१-६</ref>; <ref loc="LUK 4:16-30">लुका ४:१६-३०</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />धि प्येतेबा नाइछारते च्येला येशु हतिने पुइसोङ। <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />तेहि रेँ भजारला लेप्छारते ख्युइ हतिबे यहुदि झोमसि खिमला हतिबाला धि च्वरा छोइ पिन्देलो, कि हा:लइरे हतिबे नाइसोङ, “धिला धि बुद्धि राङ हा:लाइयापयि लाइ कियापयि शक्ति काने खरे? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />च्हि हति स्यिझुवायि पिजा मानाइ? च्हि ख्युइ आमायि मिन मरियम, राङ ख्युइ भाइतेबा याकुब, योसेफ, सिमोन राङ यहुदा मानाइ? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />च्हि ख्युइ इझि भैनिबा पोरो हु ङ्याबो मेताइ च्हि? हचु हिन्ना खोला धिबा पोरो काने खुरे?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />तेहि हतिबा खोला सेताङ क्याइसोङ। हिन्नाङ येशुयि हतिबाला नाइसोङ, “ङोन्सेखिलङानला रेँ अल मुलु राङ रेँ अल खिमला अर्थात स्यान पोरो साला सम्मान किन।” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />तेहि हतिबे हिमिछेयि क्याइरे हतिया ख्युइ शक्तियि लाइ स्यान लेइ मा क्याइबालो।<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">बप्तिसमा तेराङान युहान्ना स्यिस्यिया</para>
  <para style="r">
    <ref loc="MRK 6:14-29">मर्कुस ६:१४-२९</ref>; <ref loc="LUK 9:7-9">लुका ९:७-९</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />हति भेलाला गालिल प्रदेशयि आङकिङान हेरोदयि येशुयि भारेला थोइदु। <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />ख्युइ रेँ यक्पुवातेबाला नाइसोङ, “खो बप्तिस्मा तेराङान युहान्ना ना। खो स्यिस्यियाने सोम्बो लाँधु। हतिचाला शक्तिने धि लाइबा ख्युइ लाम्ला हुन्दु।” <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />चिचालानाना हेरोदयि रेँ भाइ, फिलिपयि केरमान हेरोदियासयि चाला युहान्ना ला सुङदे ताम्दे झ्याल्ला च्युच्युका होतो। <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />युहान्नायि हेरोदला जु नानाइबा होतो, “ख्युइ मोला केरमान सोइरे भोरयाप ठिमयि अनुसार ल मिहा।”<note caller="-" style="x"><char style="xo" closed="false">14:4 </char><char style="xt" closed="false"><ref loc="LEV 18:16">लेवि १८:१६</ref>; <ref loc="LEV 20:21">२०:२१</ref> </char></note> <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />हतिचाला हेरोदयि हतिला सोएयापयि धोप्पा क्याइसोङ, हिन्नाङ मितेबाला झिकिनलो, चिचालानाना हतिबे खोला ङोन्सेखिलङान मानि किनलो। <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />हिन्नाङ जब हेरोदयि क्येक्येबि ङिन लेप्ते, तेहि हेरोदियासयि पिजि हतिबे उइला छ्यामदे हेरोदला लेइराङ कारु च्युसोङ। <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />हति च्वरा च्युङदे ख्युइ हतिला च्हि लाँ नाङ तेरयापयि ना क्यालदे ङ्यानसोङ। <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />हिन्नाङ हति आमि लालाबा च्युच्युवाति हति नाइसोङ, “बप्तिस्मा तेराङान युहान्नायि घोबो ङाला धि तेरमायि नाङला नाङ।” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />तेहि क्यालबो बैरा च्युङसोङ रेँ ना क्याक्याला राङ ढोम्बोतेबे चाला ख्युइ हति च्वरा कियापयि आदेश पिन्देलो। <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />ख्युइ झ्याल्ला मितेबाला चाँरे युहान्नायि घोबो तुप्तु च्युक्तेलो। <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />तेहि ख्युइ घोबो तेरमाला ख्योँरे हति पुमोला पिन्सोङ। मुइ हति रेँ अमायि तेहा ख्योसोङ। <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />हति च्येला युहान्नायि लोब्टुबा लेप्ते ख्युइ स्यिस्यियायि स्हु खेरते कुहुरेलो, तेहि हतिबा पुते येशुला लोन पिन्सोङ।<verse eid="MAT 14:12" /></para>
  <para style="s">येशुयि तोङ ङाला स्यास्यामा</para>
  <para style="r">
    <ref loc="MRK 6:30-44">मर्कुस ६:३०-४४</ref>; <ref loc="LUK 9:10-17">लुका ९:१०-१७</ref>; <ref loc="JHN 6:1-14">युहान्ना ६:१-१४</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />जब येशुयि धि थोइरे खो डुङगाला स्योन्दे हतिने कुरु च्हि च्याङ मेता खुसिमे साला पुतेलो। धि थारे भजारने मियि तुमतेबे काङबि पुते राङ ख्युइ च्येला लेप्तेलो। <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />छोयि नेमुला क्योपते हति मि झोम छेयातेला थोङदे ख्युइ हतिबाला ङिङच्येसोङ, राङ हतिबे नाप्पाबाला टाक्तु च्युसोङ। <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />कमु च्युङ छारते लोब्टुबा जु नेन राङ ख्युइ तेहा लेप्सोङ, “धि च्याङ मेते साना, राङ ङिन पुइ छारसोङ। मिझोमला क्यु नोइ। राङ धिबे युल-युल ला पुते रेँ चाला सायाप ङ्योयोङ।” <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />हिन्नाङ येशुयि हतिबाला नाइसोङ, “हतिबाला ढोकोइ मेता। खे राङ धिबाला सायाप पिन।” <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />हतिबे खोला नाइसोङ, “ङिहा ङेला लोटा ङा राङ ङ्या ङि अर्थात मेता।”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />तेहि येशुयि नाइसोङ, “हतिबा पोरो ङाहि तेहा ख्याला।” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />ख्युइ मिझोमला चाला त्योएयापयि आदेश पिन्सोङ, राङ हगति लोटा ङा राङ ङ्या ङि खेरते तेङला यहला ताइरे कजसुबाला कटिनक्या नाइसोङ, राङ लोटातेबा च्याक्ते लोब्टुबाला पिन्सोङ, राङ लोब्टुबे मितेबाला पिन्सोङ। <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />हतिबा पोरोयि साइरे ढासोदु, राङ लहालाका तुबुतेबा लोब्टुतेबे फुगो च्युनङिन काङ तुइरेलो। <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />पुमो राङ पिजा पुमोतेबा अर्थात साङानतेबा हालाम तोङ ङा पिजा धुलो।<verse eid="MAT 14:21" /></para>
  <para style="s">येशु छुयि थोला पुपुता</para>
  <para style="r">
    <ref loc="MRK 6:45-56">मर्कुस ६:४५-५६</ref>; <ref loc="JHN 6:15-21">युहान्ना ६:१५-२१</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />ख्युइ मिझोमला बिदा क्याइ छारि पाल्ला लोब्टुबाला डुङगाला स्योनदु च्युक्ते खोले ताङला छोयि फारकानला ढोयापला ढिप्पि क्याइसोङ। <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />मिझोमला बिदा क्याइ छारते खो चिक्पा मोनलाम क्याक्तु रिला झिरे पुतेलो। नोमझ्यु रुबितुइना खो चिक्पा हतिया धुलो। <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />हिन्नाङ डुङगा हति भेला थु नेमुने छो छोम्मुवाला घ्याबोला पुइ छारसोङ। तेहि हुरबो छोम्मुवा घल ला क्याबाति डुङगा भाल्लापयि थोला पुइतुलो। <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />नामे तिन बजेने छ बजेयि उइला खो छो छोम्मुवायि थोला काङबि हतिबे तेहा लेप्सोङ। <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />जब लोब्टुबे खोला छो छोम्मुवायि थोला ढुन ताताता थोङदे, तेहि झिरे हतिबे नाइसोङ, “धिनि तुइना!” राङ हतिबा झिरे क्ये तोन्देलो। <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />हिन्नाङ येशुयि हतितुइना राङ हतिबाला जु नाइसोङ, “हिम्मत कि, ङा राङ ना, माझि।” <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />पत्रुसयि खोला नाइसोङ, “हे प्रभु, ख्योए राङ हिन्ना, ङाला ख्युइ तेहा छ्युयि थोला होङयापयि आदेश नाङ।” <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />ख्युइ नाइसोङ, “सअ।” पत्रुस डुङगाने पुप्ते येशुयि तेहा ढोयापयि चाला छुयि थोला ढुवाला छेलसोङ। <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />हिन्नाङ हुरबो छोम्मुवा स्यु छोम्मुवा क्याक्याइबा थोङदे खो झिरे, राङ जब नुबाला छेलसोङ तेहि ख्युइ क्ये तोन्दे नाइसोङ, “हे प्रभु, ङाला क्योप।” <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />तेहि येशुयि लाक्पा क्याङदे हतिला सुङ छारसोङ, राङ खोला नाइसोङ, “ए टिझि अर्थात हिछे टिझि किङान, चिला संका क्याइरे?” <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />जब हतिबा डुङगाला स्योनदे हतितुइना हुरबो छोम्मुवा छ्यासोङ। <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />डुङगाला होएतातेबे खोला छ्या पुलसोङ, राङ नाइसोङ, “तेम्बारे ख्योए कजसुबायि पिजा ना।”<verse eid="MAT 14:33" /></para>
  <para style="s">गनसरेला येशुयि नाप्पा लेइराङला टाक्तु च्युच्युका</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />येशु राङ ख्युइ लोब्टुबा फारकानला क्योपते हतिबा गनेसरेतयि साला क्योपसोङ। <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />जब हति सायि मितेबे येशुला ङोस्येरे तेहि हतिबे फाला छुलोयि सालातेबाला लोन चाँरेलो, राङ मितेबे नाप्पा पोरोला ख्युइ तेहा ख्योसोङ। <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />हतिबे ख्युइ कोहिलायि टुप्पु झि हिन्नाङ घुल्दु छ्यु नाइरे खोला स्युवा क्यापसोङ, राङ चोमयि घुल्दे हतिबा टाक्तेलो।<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">ताङबुइ मितेबे खाइकोए</para>
  <para style="r">
    <ref loc="MRK 7:1-13">मर्कुस ७:१-१३</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />तेहि यरुश्लेमने लेलेबा रेन फरिसितेबा राङ शास्त्रितेबा येशुयि तेहा लेप्सोङ, राङ नाइसोङ। <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“ख्युइ लोब्टुबे चिचिला ताङबुइ का:नाबे लुलाम तहतु झुकिन? चिचालानाना हतिबा सायापले ताङला रेँ लाक्पा मिठुता।” <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />ख्युइ हतिबाला नाइसोङ, “खे याङ चिचाला रेँ लुलामयि चाला कजसुबायि आदेश मिङ्याना? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />चिचालानाना कजसुबायि नानाइबा होतो, ‘रेँ आके राङ आमायि सम्मान कि,’ राङ आके या आमायि विरोधला छारझुकिन, हति सिकोइ राङ हुन।<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">प्रस्थान २०:१२</ref>; <ref loc="EXO 21:17">२१:१७</ref>; <ref loc="DEU 5:16">व्यवस्था ५:१६</ref>; <ref loc="LEV 20:9">लेवि २०:९</ref> </char></note> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />हिन्नाङ खे नेन्दु, सु रेँ आमा या आकेला नेन, ‘ख्युइ ङाने च्हि खु ङ्युइकिन, सो कजसुबाला पुपुला होतो।’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />ख्युइ खुरि आकि सम्मान कि मिकोइबा, हति च्वरा क्याइरे खि याङ रेँ लुलामयि चाला कजसुबायि वचनला मासि सोइदु। <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />समनाँतेबा, यशैयायि खि भारेला थारे ङोन्सेखिखिला ना, <verse eid="MAT 15:7" /><verse number="8" style="v" sid="MAT 15:8" />‘धि मिबा ङाला खायि मात्रा सम्मान किन्दु, हिन्नाङ हतिबे सम ङाले घ्याबोला होतो।<note caller="-" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ISA 29:13">यशैया २९:१३</ref> </char></note> <verse eid="MAT 15:8" /><verse number="9" style="v" sid="MAT 15:9" />हतिबा फानमेताला ङाहि बर्त किन्दु, हिन्नाङ हतिबे छोइ मितेबे लालाबि ठिम मात्रा ना।’” <verse eid="MAT 15:9" /><verse number="10" style="v" sid="MAT 15:10" />येशुयि लेइराङ मितेबाला रेँ चिना क्ये ताङसोङ, राङ हतिबाला नाइसोङ, “ङ्योन राङ हा:को। <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />काङ खायि नाङला स्युकिन, हति मिला भाभा मिसुवा। हिन्नाङ काङ मायि नाङने फिला थोनकिन, हति मिला भाभा सुन।” <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />तेहि हति च्येला लोब्टुबा लेप्ते खोला नाइसोङ, “च्हि ख्योएला छ्या होतोइ, फरिसिबा ख्युइ ताम थोइरे स्येताङ लाँदु?” <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />हिन्नाङ येशुयि नाइसोङ, “तेङला ना होएते ङाहि आकेयि मा चुबि तोङबोङ पोरो क्कते ढिमकिन।” <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />हतिबाला तोङ, हति काना लामतोन ङान ना। कानायि कानाला ठिते खेरना, हति ङि कार तोङला सोक्याङान ना।<note caller="-" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="LUK 6:39">लुका ६:३९</ref> </char></note> <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />पत्रुसयि खोला नाइसोङ, “ङेला धि प्येयि खुँ नोइ।”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />येशुयि नाइसोङ, “च्हि खे तरह याङ हा:मिकोङान होतोइ? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />च्हि खेला छ्या मेताइ, काङ खायि नाङला स्युकिन हति टोपा नाङला स्युकिन, राङ स्हुने फिला थोन छारकिन। <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />हिन्नाङ काङ तामतेबा खाने फिला थोनकिन, हति समयि नाङने थोनकिन, राङ हति राङ मिला भाभा सुन। <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />चिचालानाना समने राङ, विचार अल, मिजे क्याइरे प्येयाप, पतार कियाप, स्यानयि केरमान वा ख्योबो ङ्याबो व्यभिचार कियाप, कुम्मा, चुन साछि, राङ कजसुबायि लामा सायाप फिला थोन्किन। <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />धि तामबे मिला भाभा सुन। हिन्नाङ लाक्पा मा टुइबा सासाइबा ति खोला भाभा मिसुवा।”<verse eid="MAT 15:20" /></para>
  <para style="s">कनानि पुमोयि हिछे</para>
  <para style="b" />
  <para style="r">
    <ref loc="MRK 7:24-30">मर्कुस ७:२४-३०</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />तेहि येशु हतिने थोन्देलो, राङ टुरोस राङ सिदोनयि सातेबाला पुतेलो। <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />हति साने च्हि कनानि पुमो थोन्दे क्ये धोनिन राङ नाला छेलसोङ, “हे प्रभु, दाउदयि पिजा, ङाहि थोला ङिङ्च्ये। ङाहि पुमोला ढेयि लेइराङ तुका पिन्दु।” <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />येशयि हतिला च्याङ जवाक मापिनसोङ। ख्युइ लोब्टुबा लेप्ते खोला स्युवा क्यापसोङ, “धिला बिदा कि, चिचालानाना धि क्ये ङुन राङ हुइ च्येला हुन्दु।” <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />ख्युइ नाइसोङ, “ङा इस्राएल मितेबे क्युक्युरि लुतेबाला फेयापयि चाला मात्रा चाँचाँबा ना।” <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />हिन्नाङ हति पुमो ख्युइ धुनला पुइमु चुरे नाइसोङ, “हे प्रभु, ङाला रुवा कि।”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />येशुयि नाइसोङ, “च्यिटाकायि लोटा खेरते किबोला ढिमयाप ल मिहा।” <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />यहुदि मान्ते पुमोति नाइसोङ, “हिना प्रभु, हिन्नाङ किबुइ याङ रेँ ताक्पोयि च्योकचेने छाछारि तुबुतेबा सेन।” <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />तेहि येशुयि हतिला जवाक पिन्सोङ, “ए पुमो, ख्युइ हिछे छेया धु। ख्युइ धोप्पा क्याक्याइबा च्वरा ख्योएला सअ।” मुइ पुमो हति भेलाला राङ टाक्तेलो।<verse eid="MAT 15:28" /></para>
  <para style="s">येशुयि लेइराङला टाक्तु च्युच्युका</para>
  <para style="r">
    <ref loc="MRK 8:1-10">मर्कुस ८:१-१०</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />येशु हतिने थोन्दे गालिलयि छो छोम्मुवायि नेमु ने पुतेलो, राङ रियि थोला त्येसोङ। <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />तेहि तुम छेया-छेया ख्युइ धुनला लेप्सोङ, राङ हतिबा ङ्याबो ख्योख्योबा ढुढिया, लेम्बा, काना, ताम ना मिङ्युइङान स्यान लेइराङला ख्युइ धुन्ना पोरते, तेहि ख्युइ हतिबाला टाक्तु च्युक्तेलो। <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />धि थु कि, ताम ना मिङ्युइङान ताम नाङान, लेम्बा बा टाटाका, ढुढीया काङबि पुपुता राङ कानाबे मि पेपेया थोङदे मितेबा हा:लाइरेलो, राङ हतिबे इस्राएलयि कजसुबायि छे तेक्तेलो।<verse eid="MAT 15:31" /></para>
  <para style="s">येशुयि स्यान लेइराङ मियि तुमला स्यास्यामा</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />तेहि येशुयि रेँ लोब्टुबाला रेँ चिना क्ये ताङदे नाइसोङ, “धि मितेबाला ङिङच्यिन धु, चिचालानाना धिबा ङा ङ्याबो ताताता तिरिङयि ङिन सुम च्युङसोङ, तेहि धिबाला सायापयि चाला च्याङ मेता। धिबाला तबा चोङयाबयि सम मेता। स्यान अर्थात हतिबा लम्मा विहोशला ढुन।” <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />लोब्टुबे खोला नाइसोङ, “धि च्वरा तुम छेयाला धि च्याङ मेते साला स्योमयापयि चाला काने झोम लोटा खुकिन?” <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />येशुयि हतिबाला नाइसोङ, “खेला लोटा चोम लोटा होतो?” हतिबे नाइसोङ, “लोटा तुन राङ रेन ङ्या टिमा होतो।” <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />ख्युइ तुमला साला त्योएयापयि आदेश पिन्सोङ। <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />ख्युइ हति लोटा तुन राङ ङ्या खेरते कजसुबाला कटिनक्या नाइछारते च्येला च्याक्ते लोब्टुबाला पिन्सोङ, तेहि लोब्टुबे मितेबाला पिन्सोङ। <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />हतिबा पोरोयि स्याइरे राङ ढारेलो। राङ लालाकि तुबुतेबा हतिबे फुगो तून काङ तुइरेलो। <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />पुमो राङ च्यिटाका माङोइबा साङानतेबा तोङ स्यि पिजा होतो। <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />तेहि मिझोमला बिदा क्याइ छारते खो डुङगाला स्योनदेलो, राङ मगादानयि सा यहला पुतेलो।<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">हा:लाइयापयि लाइ लाँलाँबा</para>
  <para style="r">
    <ref loc="MRK 8:11-13">मर्कुस ८:११-१३</ref>; <ref loc="LUK 12:54-56">लुका १२:५४-५६</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />फरिसिबा राङ सदुकिबा लेप्सोङ, राङ खोला छोएतारु तेङलाने हा:लाइतु झ्युयापयि लाइ तोनयापयि खोला माग क्याइसोङ। <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />हिन्नाङ ख्युइ हतिबाला जवाक पिन्सोङ, “कमु च्युङदे खे नेन दु, ‘मोउसम ल होङान ना, चिचालानाना पान्नाङ मोरु धु।’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />जबेते नेन्दु, ‘पान्नाङ मोरु राङ मुक्पायि काकाबा धु, तिरिङ हुरबो छोम्मुवा होङयाप हिना’ खे पान्नाङयि अबस्था ताइरे ङिन च्हिरु हुन भेङ्युइकिन, हिन्नाङ भेलायि हा:लाइयापयि लाइयि खुँ भे मिङ्युइबा। <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />अल राङ व्यभिचारयि पालि हा:लाइयापयि लाइ फाकिन, हिन्नाङ योनायि हा:लाइयापयि लाइ अर्थात हतिला स्यान हा:लाइयापयि लाइ तोनङान माना ना।” तेहि हतिबाला ताङदे खो पुइसोङ।<verse eid="MAT 16:4" /></para>
  <para style="s">फरिसि राङ सदुकियि सोढा</para>
  <para style="r">
    <ref loc="MRK 8:14-21">मर्कुस ८:१४-२१</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />लोब्टुबा छो फारकानला क्योबितुइना हतिबे लोटा ख्योङ ज्याइ टाम्बा च्येङान ना। <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />येशुयि हतिबाला नाइसोङ, “ल क्याइरे ङ्योन, फरिसि राङ सदुकितेबे हुरस्युइने लोङयापने च्याङबो क्याइरे त्योए।” <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />हतिबा ख्होरे नाङला नारे क्याइसोङ, “हुइ लोटा माख्योबाइ, राङ ख्युइ धि च्वरा नानाइबा हिना।” <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />येशुयि धि हा:कोरे नाइसोङ, “ए हिछे टिझि किङानबा! खेला लोटा मेता नाइरे चिला खिरि नाङला नारे किन? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />च्हि खे तरह हा:मिकुवा धुये? तोङ ङाहि चाला लोटा ङाहि ताम खेला तरह टाम्बा मेताइ? खि फुगो चोम रुरुबा होतो?<note caller="-" style="x"><char style="xo" closed="false">16:9</char><char style="xt" closed="false"><ref loc="MAT 14:17-21">मत्ति १४:१७-२१</ref> </char></note> <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />तेहि तोङ स्यियि चाला फुगो चोम खि रुरुबा होतो?<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">मत्ति १५:३४-३८</ref> </char></note> <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />तोङ स्यियि चाला लोटा तुन, राङ ङाहि खेला लोटायि भारेला नानाइबा माना नाइरे खे चिला हा:मिकुवा? हिन्नाङ फरिसि राङ सदुकितेबे हुरस्युइ लालाँने च्याङबो क्याइरे त्योए।” <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />तेहि हतिबे हा:कोरेलो, कि ख्युइ लोटायि हुइस्युइ लाँलाँङाने माना हिन्नाङ फरिसि राङ सदुकिबे सोढाने च्याङबो त्योए नानाइबा हिना।<verse eid="MAT 16:12" /></para>
  <para style="s">येशुयि भारेला पत्रुसयि घोषना</para>
  <para style="r">
    <ref loc="MRK 8:27-30">मर्कुस ८:२७-३०</ref>; <ref loc="LUK 9:18-21">लुका ९:१८-२१</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />येशु कैसरिया फिलिप्पियि छेत्रला लेप्छारते च्येला, ख्युइ रेँ लोब्टुबाला टिसोङ, “मि मियि पिजाला सुना नाइरे नेन धुइ?” <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />हतिबे जवाक पिन्सोङ, “रेन यि बप्तिस्मा तेराङान युहान्ना, रेनयि एलिया, राङ रेनयि यर्मिया वा ङोन्सेखिलङानबे नाङने च्हि हिना नाइरे नेन्दु।” <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />ख्युइ हतिबाला टिसोङ, “खे च्हि नेन, ङा सुना?” <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />सिमोन पत्रुसयि जवाक पिन्सोङ, “ख्योए ख्रिष्ट ना, सोम्बो कजसुबायि पिजा।” <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />येशुयि हतिला नाइसोङ, “योनायि पिजा सिमोन, ख्योए किप्पो ना। चिचालानाना स्यायि मिने ख्योएला धि लेलेबा माना, हिन्नाङ तेङलाला त्योएङानयि कजसुबे धि ताताना ना। <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />ङा ख्योएला नाज्याइ, कि ख्योए पत्रुस टा ना। ङा ङारि चर्च धि टायि थोला लोङ सोच्याइ, राङ हअलुयि कोतेबा धि थोला क्यालङान मानाना। <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />ङा खेला तेङलायि राज्ययि धिमितेबा तेर च्याइ। काङ खि पृथ्‍वीला तेमकिन, सो तेङला ना तेमङान ना, राङ काङ ख्युइ पिरथिविला ढोलिन, सो तेङला ना ढोलङान ना।”<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">मत्ति १८:१८</ref>; <ref loc="JHN 20:23">युहान्ना २०:२३</ref></char></note> <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />खो ख्रिष्ट हिना नाइरे सुला याङ माना नाइरे येशुयि लोब्टुबाला आदेश पिन्सोङ।<verse eid="MAT 16:20" /></para>
  <para style="s">येशुयि राङला तरि खुयाप राङ स्यियापयि भारेला ङोन्स्येखिखिला</para>
  <para style="r">
    <ref loc="MRK 8:31-9:1">मर्कुस ८:३१—९:१</ref>; <ref loc="LUK 9:22-27">लुका ९:२२-२७</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />खो च्हिरु यरुश्लेमला च्हिरु क्याइरे ढोकोइ हुन, राङ केवाकिङान गुरु राङ घोबा पुजारि राङ शास्त्रितेबाने लेइराङ तुक्का ङ्योङकोइहुन, सिकोइ हुन राङ ङिन सुबाला सोम्बो च्युङदे लाँकोइ हुन नाङान येशुयि हति भेलाने ख्युइ लोब्टुबाला नाला छेलसोङ। <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />पत्रुसयि खोला यह चिला खेरते ङाराला छेलसोङ, “कजसुबे जु माके, प्रभु, ख्युइ थोला धि च्वरा जब याङ मिहा।” <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />हिन्नाङ लक्ते ख्युइ पत्रुसला नाइसोङ, “ए तुइ, ङाहि धुन्ने क्यु, ख्योए ङाहि चाला पारछे ना। चिचालानाना ख्योए कजसुबायि तामला माना, हिन्नाङ मियि तामला ध्यान तेरकिनदु।” <verse eid="MAT 16:23" /><verse number="24" style="v" sid="MAT 16:24" />तेहि येशुयि ख्युइ लोब्टुबाला नाइसोङ, “सु याङ ङाहि च्येला होङसोम किना, ख्युइ राङला माना नोइ राङ रेँ क्रुस खुरते ङाहि च्येला सअ।<note caller="-" style="x"><char style="xo" closed="false">16:24 </char><char style="xt" closed="false"><ref loc="MAT 10:38">मत्ति १०:३८</ref>; <ref loc="LUK 14:27">लुका १४:२७</ref> </char></note> <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />चिचालानाना सुइ रेँ उ क्योपसोम किन, ख्युइ हति मासि हुन, हिन्नाङ सुइ रेँ उ ङाहि चाला मासि लुइ, हतिला हति खुङान ना।<note caller="-" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्ति १०:३९</ref>; <ref loc="LUK 17:33">लुका १७:३३</ref>; <ref loc="JHN 12:25">युहान्ना १२:२५</ref> </char></note> <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />पोरो संसार खुँरे याङ रेँ उ मासि च्युङना, हति मिला च्हि ल हुन? अर्थात मियि रेँ उयि तोप्पोला च्हि तेर ङ्युकिन? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />चिचालानाना मियि पिजा रेँ आकेयि छे रेँ तेङलायि लोन खेरङान ङ्याबो होङान ना, राङ हति भेलाला ख्युइ मि पोरोला हतियि लाइ च्वरा ढेबु तेराङान ना।<note caller="-" style="x"><char style="xo" closed="false">16:27 </char><char style="xt" closed="false"><ref loc="MAT 25:31">मत्ति २५:३१</ref>; <ref loc="PSA 62:12">भजनसंग्रह ६२:१२</ref>; <ref loc="ROM 2:5">रोमन २:५</ref></char></note> <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />तेम्बारे, ङा खे ला नाज्याइ, ङिहा लाँलाँबि नाङने चोमयि मियि पिजाला रेँ राज्यला लेलेबा माथोङ थु स्यियाप च्हि हिना हति टोप्ला मिङ्योङा।”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">येशुयि ध घ्युघ्युरा</para>
  <para style="r">
    <ref loc="MRK 9:2-13">मर्कुस ९:२-१३</ref>; <ref loc="LUK 9:28-36">लुका ९:२८-३६</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />हति ङि टुयि च्येला येशुयि पत्रुस, याकुब राङ हति भाइ युहान्नाला खो राङ ङ्याबो च्हि थो छेया रिला करुला खेरतेलो। <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />हतिबे धुन ला ख्युइ धो घ्युसोङ। ख्युइ च्ये ङिमा च्वरा होए भारकिन, राङ ख्हुइ कोहिला होए च्वरा कारबो च्युङसोङ। <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />तेहि मोशा राङ एलिया येशु ङ्याबो ताम नाङान थोङसोङ। <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />पत्रुसयि येशुला नाइसोङ, “हे प्रभु, ङे ङिहा होएता ल च्युङसोङ। ख्युइ धोप्पा च्युङना ङा ङिहा कुर सुम सोज्याइ, च्हि ख्युइ चाला, च्हि मोशायि चाला राङ च्हि एलियायि चाला।” <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />हति नेन-नेन, होए क्याङान मुक्पायि हतिबाला कापसोङ, राङ हति मुक्पाने क्ये झि लेप्सोङ, “धि ङाहि करि पिजा ना, खो ङ्याबो लेइराङ काका होए, धि ताम ङ्योन।” <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />जब लोब्टुबे धि थोहिरे, तेहि हतिबा झिरे साला घेलसोङ। <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />हिन्नाङ येशु लेप्ते हतिबाला घुल्दे नाइसोङ, “लोँ, माझि।” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />जब हतिबे रेँ मि तक्ते, येशु अर्थात हतिबे स्यान सु याङ माथुवालो। <verse eid="MAT 17:8" /><verse number="9" style="v" sid="MAT 17:9" />जब हतिबा रिने पापतेलो, येशुयि हतिबाला आदेश पिन्देलो, “जब थु मि पिजा स्यिस्यियाने सोम्बो च्युङदे मिलाबा, हति थु खि धि झ्याझ्यालायि ताम सुलाङ माना।” <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />तेहि लोब्टुबे खोला जु नाइरे टिरेलो, “तेहि चिला शास्त्रिबे ताङला एलिया होङकोइ हुन नेन?” <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />येशुयि हतिबाला नाइसोङ, “एलिया तेम्बारे हुन, राङ मुइ याङ पोरो सोलाइ किङान ना। <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />हिन्नाङ ङा खेला नाज्याइ, ‘एलिया ताङलाने राङ लेप्छारतु,’ तेहि मितेबे, मोला ङोमास्येबा, हिन्नाङ मोला हतिबे च्हि सम नोइ हति क्यायइदु। हति च्वरा क्याइरे मि पिजायि याङ हतिबे लाने तुरि ङ्योङकोइ हुन।”<note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="MAT 11:14">मत्ति ११:१४</ref></char></note> <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />तेहि ख्युइ बप्तिस्मा तेराङान युहान्ना यि भारेला हतिबाला नानाइबा ना नाइरे लोब्टुबे हा:कोरे।<verse eid="MAT 17:13" /></para>
  <para style="s">ढे काकाला पिजा</para>
  <para style="r">
    <ref loc="MRK 9:14-29">मर्कुस ९:१४-२९</ref>; <ref loc="LUK 9:37-43">लुका ९:३७-४३</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />तेहि हतिबा तुम होएता सातेला लेप्ते च्येला मि झिकि ख्युइ धुनला लेप्ते पुइमु चुरे नाइसोङ, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />“प्रभु, ङाहि पिजायि थोला ङिङ्च्ये, चिचालानाना स्हा फोफोकि नाझा फतु, राङ लेइराङ तुक्का ङ्योङिनदु। हति तुइका मेला घेलिन्दु, तुइका छ्युला घेलिन्दु। <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />ङाहि हतिला ख्युइ लोब्टुबे तेहा ख्योरे, हिन्नाङ हतिबे खोला टाक्तु झ्यु माङ्युइसोङ।” <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />तेहि येशुयि नाइसोङ, “ए टिझि अर्थात हिछे मिकिङान राङ घो ख्याख्यामा सन्तनबा, जब थु ङा खे ङ्याबो तोकिन? जब थु ङा खेला सहि किच्याइ? हतिला ङिहा ङाहि तेहा ख्याला।” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />येशुयि हतिला ङ्योइसोङ, राङ ढे हति नाङने थोनसोङ। हति पिजा हतितुइना राङ टासोङ। <verse eid="MAT 17:18" /><verse number="19" style="v" sid="MAT 17:19" />तेहि लोब्टुयि येशुयि तेहा फाला लेप्ते नाइसोङ, “ङि हतिला चिला धोन माङ्युबा?” <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />ख्युइ हतिबाला नाइसोङ, “खि हिमिछेयि चाला ना। तेम्बारे, ङा खेला नाज्याइ, कि खेला रोयायि सावोन चोमयि हिछे होतो नाना धि रिला ‘धिने क्यु’ नाइना हति ढुन। राङ खि चाला च्याङ मियोङयाप मिहा।<note caller="-" style="x"><char style="xo" closed="false">17:20 </char><char style="xt" closed="false"><ref loc="MAT 21:21">मत्ति २१:२१</ref>; <ref loc="MRK 11:23">मर्कुस ११:२३</ref>; <ref loc="1CO 13:2">१ कोरिन्थि १३:२</ref> </char></note> <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />हचु हिन्नाङ धि च्वरे ढेते मोनलाम राङ बर्त माक्याइना धोन मिङ्युइबा।”<verse eid="MAT 17:21" /></para>
  <para style="s">राङ स्यियापयि भारेला येशुयि लाम्मा ङिबा नेन्दु</para>
  <para style="r">
    <ref loc="MRK 9:30-32">मर्कुस ९:३०-३२</ref>; <ref loc="LUK 9:43-45">लुका ९:४३-४५</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />हतिबा गालिलला झोमितुइना येशुयि हतिबाला नाइसोङ, “मि पिजा मितेबे लाला स्योएङान ना। <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />तेहि हतिबे खोला स्योएङान ना, हिन्नाङ ङिन सुबाला खो सोम्बो च्युङदे लाँङान ना।” तेहि लोब्टुबा लेइराङ सम तुसोङ।<verse eid="MAT 17:23" /></para>
  <para style="s">मोनलाम क्यासि खिमयि कर</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />जब हतिबा कफर्नहुमला लेप्ते, मोनलाम क्यासि खिमला कर तुइङानति पत्रुसयि तेहा लेप्ते नाइसोङ, “च्हि खि गुरुयि मन्दिरयि कर मिच्योङाइ?” <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />ख्युइ नाइसोङ, “हिना, च्योङकिन।” पत्रुस खिमयि नाङला स्युरे च्येला येशुयि खोला ताङला राङ नाइसोङ, “सिमोन, ख्युइ विचार च्हि होतो? पिरथिवियि क्यालबुइ मोनलाम क्यासि खिमयि कर वा कर सुने तुकिन? रेँ पिजाबाने कि स्यानतेबाने?” <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />“स्यानतेबाने,” पत्रुसयि जवाक पिन्सोङ। येशुयि हतिला नाइसोङ, “हचु हिन्ना पिजाबाला छुट खुदु। <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />हिन्नाङ हतिबे हुने छिक्पा मि सायापयि चाला, छो छोम्मुवाला पुते झालि छ्यु, राङ ताङस्युवा थेथेबा ङ्या ख्याला। हति खा भि तुइना ख्योएला ङुलयि सिक्का झि खुङान ना। हति खेरते ख्योए राङ ङाहि चाला हतिबाला पिन।”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">तेङलायि राज्यला पोरोले छेया</para>
  <para style="r">
    <ref loc="MRK 9:33-37">मर्कुस ९:३३-३७</ref>; <ref loc="LUK 9:46-48">लुका ९:४६-४८</ref>; <ref loc="LUK 17:1-2">१७:१-२</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />हति भेला राङ लोब्टुतेबा येशुयि तेहा लेप्ते टिसोङ, “तेङलायि राज्यला पोरोले छेया सुना?” <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />ख्युइ च्यिटा टिमा झिला धुनला क्ये ताङदे हतिबे उइला लाङसोङ। <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />राङ नाइसोङ, “तेम्बारे, ङा खेला नाज्याइ, सम घ्युरतु च्यक्ते खे च्यिटा टिमाबा च्वरा माच्युङना जब याङ तेङलायि राज्यला स्यु मिङ्युइबा। <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />सुइ धि टिमा च्यिटा च्वरा राङला टुङबो सुन, हति राङ तेङलायि राज्यला पोरोले छेया होङान ना। <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />सुइ ङाहि मिनला धि च्वरा च्यिटाला ङ्यानकिन, हति ङाला ङ्यान किन।”<verse eid="MAT 18:5" /></para>
  <para style="s">तिक्पि परिनाम</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />“हिन्नाङ सुइ ङाहि थोला हिछेकिङान धि टिमाबे नाङने चिला तिक्पा कितु झ्युकिन, बरु हति झिङबाला लाकोर छेयायि टोउ तारे तिङरिङमुवा छो छोम्मुवाला धोयाप लना।” <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />“तिक्पा कितु झ्युयापयि छोएयि चाला धि संसारला धिक्कार! तिक्पा कितु ख्योङान छोएता हुन, हिन्नाङ धिक्कार, हति मिला सुइ चाने तिक्पा कितु झ्युयापयि छोए हुन। <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />ख्युइ लाक्पा या काङबि ख्योएला तिक्पा कितु झ्यु ना हतिला तुप्ते टिम। लाक्पा ङि कार राङ काङबा ङिकार नामयाङ मिस्यिङानयि मेला ढिमाले त बरु लेम्बा राङ ढुडिया च्युङदे मिजेयि नाङला स्युयाप ख्युइ चाला ल होङान ना। <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />ख्युइ मियि ख्योएला तिक्पा कितु झ्युना हतिला तोन्दे टिम। मि ङि कार ङ्याबो ङ्यालबायि मेला ढिमाले ता मिजि च्युङदे मिजेयि नाङला स्युयाप ख्युइ चाला ल हुन।”<verse eid="MAT 18:9" /></para>
  <para style="s">क्युक्युरायि लुयि प्ये</para>
  <para style="r">
    <ref loc="LUK 15:3-7">लुका १५:३-७</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />च्याङबो क्याइरे त्योए, खे धि टिमातेबे नाङने सु छ्युङदोए माके। चिचालानाना ङा खेला नाज्याइ, तेङलाला हतिबे तेङलायि लोन खेरङानतेबे ङाहि आकेला बारतै झ्यालज्याइ खुङान ना। <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />चिचालानाना मियि पिजा क्युक्युरातेबाला क्योतु लेलेबा ना।<note caller="-" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="LUK 19:10">लुका १९:१०</ref> </char></note> <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />“खे च्हि विचार किन? मि रिनयि लु क्याने लु झि घोख्यामदे पुइना, ख्युइ खला सि राङ च्युरकु ला ताङदे टायि होला पुते हति घोख्यामदे ढोङान चिला फातु मिढुवाइ? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />तेम्बारे ख्युइ हतिला ठेना, तेम्बारे ङा ख्योएला नाज्याइ, हति घोख्यामदे मिढोङान हति खला सि याङ च्युरकुले क्येना हति चिकि चाला खो काङान ना। <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />हति च्वरा क्याइरे तेङला ना हो एता खि आकेयि धोप्पा धि धु, कि धि टिमाबे नाङने याङ च्हि याङ मासि मायोङ।”<verse eid="MAT 18:14" /></para>
  <para style="s">तिक्पा किङान भाइ वा भैनि</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />“ख्युइ भाइयि ख्युइ विरोध्रला अपराध क्याइना, पुते खे ङि मात्र होतितुइना हति दोष तोन। हति ख्युइ ताम ङ्यान ना, ख्युइ भाइ ख्युरि च्युङदे।<note caller="-" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="LUK 17:3">लुका १७:३</ref> </char></note> <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />हिन्नाङ ख्युइ माङ्यान ना राङ ङ्याबो मिरको च्हि वा चिले मा ङि खेर राङ ङि या सुम साछि लाम्ला ताम पोरो पक्का कि।<note caller="-" style="x"><char style="xo" closed="false">18:16 </char><char style="xt" closed="false"><ref loc="DEU 19:15">व्यवस्था १९:१५</ref> </char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />तेम्बारे हति हतिबे ताम ङ्यानयाप याङ माङ्यान ना, चर्चला नोइ। हति चर्चयि नानाइबा याङ माङ्यान ना, हति ख्युइ चाला यहुदि मान्ते मि राङ कर तुइङान च्वरा ना।”<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />“तेम्बारे, ङा खेला नाज्याइ, खि पिरथिविला च्हि तेमकिन, हति तेङलाला तेमङान ना। तेहि खि पिरथिविला काङ ढोलिन, हति तेङलालाङ ढोलङान ना।” <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />“याङ तेम्बारे ङा खेला नाज्याइ, पिरथिविला खि नाङने ङि ताम ढिक्ते चिगा लाना, हति तेङलायि ङाहि आकेने खि चाला होङान ना। <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />चिचालानाना काँहा ङि या सुम ङाहि मिनला झोमिन, हतिया ङा मितेबे उइला हुन।”<verse eid="MAT 18:20" /></para>
  <para style="s">माप मिकिङानयि यक्पुवायि प्ये</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />तेहि येशुयि तेहा लेप्ते पत्रुसयि नाइसोङ, “प्रभु, ङाहि भाइयि लाम्मा चोम ङाहि विरोधला अपराध क्याइसोङ ङाहि हतिला माप तेरच्ये? च्हि लाम्मा तुन थु?”<note caller="+" style="f"><char style="fr" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="LUK 17:3-4">लुका १७:३-४</ref> </char></note> <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />येशुयि हतिला नाइसोङ, “ङा खेला नाज्याइ, लम्मा तुन माना, खलसुम राङ च्यु गुणा लाम्मा तुन।” <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />“हतिचाला तेङलायि राज्य क्याल:बो झि ङ्याबो थु ङ्युइकिन, सुइ रेँ यक्पुवा ङ्याबो च्हि खेरयापयि धोप्पा क्याइरे। <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />जब हति च्हि खेराला छेलसोङ, तोङ च्यु सेरयि सिक्का रिन खेराङान मिझि ख्युइ तेहा ख्योसोङ। <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />हिन्नाङ हति मियि च्योङ माङ्युबा राङ हति ताक्पोयि हतिला राङ हति केरमानला राङ पिजा पोमु राङ हति पोरो क्यु चोँरे रिन च्योङयापयि आदेश च्युक्तेलो।” <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />“तेहि हति यक्पुवायि पुइमु चुरे हति काङबाला छ्या पुलदे नाला छेलसोङ, ‘ताक्पो, ङाला टझि कु, ङा ख्युइ रिन पोरो च्यातोङ।’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />तेहि हति यक्पुवायि ताक्पोयि ङिङच्येरे हतिला ताङदेलो, राङ हति रिन माप क्याइसोङ।” <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" />“हिन्नाङ हति यक्पुवा थोन्दे ढुइतुइना राङ ङ्याबो होएता यक्पुवाबे नाङने चिला ठातेलो, सु ख्युइ ङुलयि क्या सिक्कायि रिनयि हिनालो। हतिला झ्यिङबाला सुङदे हतिला नाइसोङ, ‘ख्युइ रिन च्योङ।’” <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />“हिन्नाङ हति ङ्याबोयि यक्पुवायि घो कुरे हतिला स्युवा क्यापसोङ, ‘ङाला टिझि कु, ङा ख्योएला पोरो च्योङ ज्याइ।’” <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />“हिन्नाङ हति माङ्यानसोङ, राङ पुते रिन माच्योङथु हतिला माच्योङ थु खोला झ्याल्ला तिरेलो। <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />हति ङ्याबोयि यक्पुवातेबे हतिबा पोरो थोङदे राङ सम तु च्युङदेलो। हतिबा पुते धि पोरो च्युच्युवा रेँ ताक्पोला स्यातेलो।”<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />“तेहि ताक्पोयि हति यक्पुवाला रेँ चिना क्ये ताङदे नाइसोङ, ‘ए सम अल यक्पुवा, ख्युइ ङाला स्युवा क्यापसोङ, राङ ङाहि ख्योएला ख्युइ रिन माप क्याइरे। <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />ङाहि ख्युइ थोला ङिङच्येच्येबा च्वरा ख्युइ याङ ख्युइ ङ्याबोयि यक्पुवाला ङिङच्येयाप मानाइ?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />तेहि हति ताक्पोयि स्येताङ लाँरे हतिला रिन पोरो मा च्योङथु सिपाहितेबे लाला स्यातेलो।”<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />तेहि येशुयि च्युइ झि क्याइसोङ, “खि रेँ समने माप माक्याइ थु तेङला ला होएता ङाहि आकि खेला हति च्वरा व्यवाहार किङान ना।”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">येशुयि मिजे क्याइरे पेयापयि भारेला छोइ लालाबा</para>
  <para style="r">
    <ref loc="MRK 10:1-12">मर्कुस १०:१-१२</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />धि तामबा नाइछारते येशु गालिल प्रदेशने यर्दन चाङबोयि फारकानला यहुदियायि छेत्र यहला पुइसोङ। <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />मि झोमयि तुम छेया झि ख्युइ च्येला लेप्सोङ राङ ख्युइ हतिया मितेबाला टाक्तु च्युसोङ। <verse eid="MAT 19:2" /><verse number="3" style="v" sid="MAT 19:3" />फरिसि रेन ख्युइ तेहा लेप्ते खोला छोए ताज्याइ नाइरे खोला टिसोङ, “च्हि सुइयाङ तोन होएताला केरमान ङ्याबो पेयाप ठिम च्वरा क्याइना ल हिनाइ?” <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />हिन्नाङ ख्युइ नाइसोङ, “च्हि खि टटबा मेताइ, कि पोरो सोङानयि हतिबाला ताङला राङ पिजा राङ पुमो सोइरे, <note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">उत्पत्ति १:२७</ref>; <ref loc="GEN 5:2">५:२</ref> </char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />राङ नाइसोङ, ‘हतिचाला मियि रेँ आके राङ आमाला पोरते रेँ केरमान ङ्याबो ढिकिन, राङ हति ङि कार स्हु च्हि होङान ना।’ <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />ता हति ङि माना, हिन्नाङ स्हु च्हि राङ होङान ना। हतिचाला कजसुबायि सुलाङ च्हि थुथुता होतो, हतिला सुइ याङ पेरु माझ्यु।”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />फरिसिबे येशुला टिसोङ, “मोशायि चिला मिजे क्याइरे पेयापयि स्युगु पिन्दे केरमानला पेयापयि आदेश पिन्दे?” <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />येशुयि हतिबाला नाइसोङ, “खि सम क्योङबोयि क्याइरे राङ मोशायि केरमानला तोङयापयि स्युगु खेला पिपिना ना। हिन्नाङ ताङलाने धि च्वरा मेता। <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />ङा खेला नाज्याइ, सुइ याङ पातान्नि क्याक्याबि चाला अर्थात रेँ केरमानला ताङदे स्यान ङ्याबो मिजे किन, हति पतार किन, राङ सुइ ताताङा तेला मिजे किन, हति याङ व्यभिचार किन।” <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />लोब्टुबे खोला नाइसोङ, “ख्योबो केरमानयि च्वरा टाल हिन्ना ता, मिजे मिकियाप राङ ल ना।” <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />येशुयि हतिबाला जवाक पिन्दे नाइसोङ, “मि पोरोयि धि वचन ङ्यान मिङ्युइबा, मात्रा हति ङ्युइकिन सुला धि पिपिना होतो। <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />चिचालानाना रेन किये भेलाने राङ फोलोमोलो हुन राङ स्यान मितेबे भेला आरोङयि च्येला हति च्वरा क्याक्याइबा हुन। रेन रेँ राङला तेङलायि राज्ययि चाला मिजे माक्याइबा हुन सुइ धि ङ्यानकिन, हति-हति ङ्यानरो कि।”<verse eid="MAT 19:12" /></para>
  <para style="s">येशु च्यिबा टिमातेबा च्यिनलाब पिपिना</para>
  <para style="r">
    <ref loc="MRK 10:13-16">मर्कुस १०:१३-१६</ref>; <ref loc="LUK 18:15-17">लुका १८:१५-१७</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />येशुयि च्यिबातेबे थोला लाक्पा पोरते मोनलाम क्याबोङ नाइरे मितेबे हतिबाला ख्युइ तेहा ख्योसोङ। तेहि लोब्टुतेबे हति मिबाला ङ्योइसोङ। <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />हिन्नाङ येशुयि नाइसोङ, “टिमा च्यिबातेबाला ङाहि तेहा होङदु छ्यु, हतिबाला माघा। चिचालानाना तेङलायि राज्य धि टिमा च्यिबातेबे च्वरा मितेबे ना।” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />तेहि येशुयि च्यिटातेबे थोला लाक्पा पोरते च्यिनलाब पिन्छारते येशु हतिने पुइसोङ।<verse eid="MAT 19:15" /></para>
  <para style="s">छ्युक्पो स्यारा मिझि</para>
  <para style="r">
    <ref loc="MRK 10:17-31">मर्कुस १०:१७-३१</ref>; <ref loc="LUK 18:18-30">लुका १८:१८-३०</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />येशुयि तेहा लेप्ते मिझिकि नाइसोङ, “हे गुरु, ङाहि नामयाङ किसिनयापयि किप्पो मिजेयि खुँयापयि चाला च्हि ल लाइ किकोइ हुन?” <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />येशुयि हतिला नाइसोङ, “ल काङना हति भारेला ख्योए ङाला चिला ढिन? ल ता च्हि मात्रा होतो। हिन्नाङ ख्योए मिजेला स्युसोम किना, आदेशतेबा ङ्योन।” <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />ख्युइ हतिला नाइसोङ, “काङ काङते खाइकोएतेबा?” येशुयि नाइसोङ, “ख्युइ च्याङ मासोए, ख्योए व्यभिचार माके, ख्योए कुम्मा माकु, ख्योए चुन साछि मातेर। <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />रेँ आके आमायि सम्मान कि, राङ रेँ खिमजेला राङ च्वरा करि कि।” <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />हति स्यारा मितेबे खोला नाइसोङ, “धिबा पोरो ता ङाहि ङ्यानकिन राङ लेलेबा होतो। ता ङाला च्हि कमि धुइ?”<note caller="-" style="x"><char style="xo" closed="false">19:20 </char><char style="xt" closed="false"><ref loc="EXO 20:12">प्रस्थान २०:१२</ref>; <ref loc="DEU 5:16">व्यवस्था ५:१६</ref>; <ref loc="LEV 19:18">लेवि १९:१८</ref> </char></note> <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />येशुयि हतिला नाइसोङ, “ख्योए कजसुबायि धुनला पवित्र होङसोम होएना, पुते ख्योएला होएता पोरो चोँरे टाङनाबाला पिन, राङ ख्युइ तेङलाला क्यु खुङान ना, तेहि लेप्ते ङाहि च्येला सह।” <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />जब हति स्यारा मितेबे धि ताम थोइरे, हति सम तुक्ते पुइ छारसोङ, चिचालानाना हतिला क्यु सम्पति लेइराङ धुलो। <verse eid="MAT 19:22" /><verse number="23" style="v" sid="MAT 19:23" />तेहि येशुयि रेँ लोब्टु तेबाला नाइसोङ, “तेम्बारे, ङा खेला नाज्याइ, तेङलायि राज्य छ्युक्पो मिला स्युयाप काबो हुन। <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />याङ ङा खेला नाज्याइ, छ्युक्पो मिला कजसुबायि राज्य नाङला स्युयापले बरु उटला खापयि मिने नाङला झ्युयाप लाइला हुन।” <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />हति थोइरे लोब्टुबा हा:लाइरे टिरेलो, “हचु हिन्ना सुला मुक्ति खुकिन?” <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />येशुयि हतिबाला मि ताइरे नाइसोङ, “मितेबे चाला धि कि मिङ्युइयाप होतो, हिन्नाङ कजसुबायि चाला धि पोरो ङ्युइयाप हुन।” <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />तेहि पत्रुसयि खोला नाइसोङ, “तोइ ङि क्यु पोरो ताङदे ख्युइ क्यापला लेलेबा होए। ङेला ता च्हि खुकिन?” <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />येशुयि हतिबाला नाइसोङ, “तेम्बारे, ङा खेला नाज्याइ, खे सु ङाहि च्येला लेलेबा होए, सारबा पोरो सोसोइबाला जब मियि पिजा रेँ छे तेतेकायि क्याल: ठिला तोकिन, तेहि खे याङ च्युनङि क्याल ठिला त्योएङान ना, राङ इस्राएलयि च्युनङि क्युइयि थोला न्याय किङान ना।<note caller="-" style="x"><char style="xo" closed="false">19:28 </char><char style="xt" closed="false"><ref loc="MAT 25:31">मत्ति २५:३१</ref>; <ref loc="LUK 22:30">लुका २२:३०</ref> </char></note> <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />पोरो सुइ ङाहि मिनयि चाला खिम, आज्यो भाइ वा इझि भोइनि अर्थात आके आमा पिजा पोमु वा सा स्यिङ ताताङा हुन, हतिला क्याले याङ मा खुङान ना, राङ नामयाङ मिसिनङान मिजेयि आङ खुङान ना। <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />हिन्नाङ लेइराङ सु ताङला होतो हति च्येला होङान ना राङ, च्येला होएतातेबा ताङला होङान ना।” <note caller="-" style="x"><char style="xo" closed="false">19:30 </char><char style="xt" closed="false"><ref loc="MAT 20:16">मत्ति २०:१६</ref>; <ref loc="LUK 13:30">लुका १३:३०</ref> </char></note><verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">अंगुरयि भारिला लाइकिङानबा प्ये</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“तेङलायि राज्य सायि ताक्पो झि च्वरा ना, सु जब थरह रेँ अंगुरयि भारिला लाइकिङानतेबाला खला ला लाइ फातु फिला थोन्सोङ। <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />लाइकोङानबाला खुँयायि ङिन झिकि ङुलयि सिक्का झि पिन्दे ख्युइ हतिबाला रेँ अंगुरयि भारिला चाँसोङ।” <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />“जब खो नौ बजे झोमला फिला थोन्दे, ख्युइ स्यानतेबाला भजारयि चोकला लाइ मेला लाँरे ताताता थोङदे। <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />राङ ख्युइ हतिबाला नाइसोङ, ‘खे याङ अंगुरयि भारिला लाइ कितु क्यु, राङ काङ ल होतो हति ङा खेला तेरच्याइ।’” <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />तेहि हतिबा पुतेलो। “याङ ख्युइ च्युनङि बजे ना माला राङ ङिमा झारायि तिन बजेना माला फिला थोन्दे हति च्वरा क्याइसोङ। <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />ख्युइ पाँच बजेना माला फिला थोन्दे स्यानतेबा लाङ लाँरे ताताता ठेसोङ, राङ हतिबाला नाइसोङ, ‘खे ङिन खेरे लाइ मेला चिला लाँरे तोकिन?’” <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />“हतिबे खोला नाइसोङ। ‘सुइ याङ ङेला खला पिन्दे लाइ कोकोइबा मेता।’” “ख्युइ हतिबाला नाइसोङ, ‘खे याङ अंगुरयि भारिला क्यु राङ लाइ कि।’” <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />“जब कमु च्युङदे, हतितुइना अंगुरयि भारियि ताक्पोयि खुरि लाइ किङानतेबाला नाइसोङ, ‘लाइ किङानबाला क्ये ताङदे च्येस्युवा होङानने क्याइरे ताङला होङान थुला हतिबे खला पिन।’” <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />“पाँच भजेला लाइला लेलेबातेबा याङ लेप्सोङ, राङ हतिबा पोरोयि ङिन झिकि ङुलयि सिक्का खुसोङ। <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />जब ताङला ङुलयि सिक्काला खेखेरातेबा लेप्सोङ, तेहि हतिबे धिले याङ मा खुकिन नाइरे विचार क्याइसोङ, हिन्नाङ हतिबा पोरोला ङि झिकि खला खुरेलो। <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />खला खुरे सायि ताक्पोयि विरोध्रला हतिबा फा ताम नाला छेलसोङ। <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />हतिबे नाला छेलसोङ, ‘धिबा च्येला घण्टा झि मात्रा लाइ क्याइसोङ, हिन्नाङ ख्युइ हतिबाला ङे ङिन खुरबो खुरङान राङ ङिमा छाला लेइराङ तुरि क्याइरे।’”<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />“हिन्नाङ ख्युइ हतिबे नाङने चिला जवाक पिन्सोङ, ‘रुवा,’ ङाहि ख्युइ थोला अन्य रच्चिया क्याक्याइबा मेता। च्हि ख्युइ ङा ङ्याबो पुरा ङिन झिकि खलाला लाइ कियाप ङ्याङ्याना माना च्हि? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />ख्योएला खुयापयि आलाइ खुरते खिमला क्यु। धि च्येमे मिते लाङ ख्योएला पिपिना चोम ङा तेर सोम होए। <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />ङाहि चोम होतो, हति ङारि धोप्पा क्याक्याइबा च्वरा कि मिङ्युबाइ? ङाहि आलाइला ख्योए चिला ठाधो किन?”<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />“धि च्वरा क्याइरे च्येमा ताङला होङान ना राङ ताङमा च्येमा होङान ना।”<note caller="-" style="x"><char style="xo" closed="false">20:16 </char><char style="xt" closed="false"><ref loc="MAT 19:30">मत्ति १९:३०</ref>; <ref loc="MRK 10:31">मर्कुस १०:३१</ref>; <ref loc="LUK 13:30">लुका १३:३०</ref></char></note><verse eid="MAT 20:16" /></para>
  <para style="s">येशुयि राङ स्यियापयि भारेला लाम्मा सुभा नानाइबा</para>
  <para style="r">
    <ref loc="MRK 10:32-34">मर्कुस १०:३२-३४</ref>; <ref loc="LUK 18:31-34">लुका १८:३१-३४</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />यरुश्लेम यहला ढुइतुइना येशुयि लोब्टु च्युनङिबाला करुला खेरते हतिबाला लामला नाइसोङ, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“हु यरुश्लेम यहला ढुन होतो। ता मि पिजा घोबा पुजारितेबा राङ शास्त्रितेबे लाला स्योएङान ना, राङ हतिबे खोला स्योएयापयि ङेबायि दोषि सोङान ना। <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />ख्युइ नाच्योङान, च्यायि छेरमा क्याङान, राङ क्रुसला धयाप नाइरे हतिबे खोला स्यान यहुदि मान्ते मितेबे लाला स्योएङान ना, राङ ङिन सुभाला खो सोम्बो च्युङदे लाँङान ना।”<verse eid="MAT 20:19" /></para>
  <para style="s">आमा झिकि स्युवा</para>
  <para style="r">
    <ref loc="MRK 10:35-45">मर्कुस १०:३५-४५</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />तेहि जब्दियायि केरमानयि रेँ पिजाबाला ङ्याबो खेरते ख्युइ धुनला पुइमु चुरे खोला स्युवा क्यापतेलो। <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />ख्युइ मोला टिसोङ, “ख्योए च्हि धोप्पा किन?” मुइ खोला नाइसोङ, “आदेश छ्यु राङ ख्युइ राज्यला, ङाहि धि पिजा ङि नाङने च्हि ख्युइ लाक्पा याइ यहला, राङ स्यानते ख्युइ योन यहला तोच्याइ खु।” <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />हिन्नाङ येशुयि जवाक पिन्सोङ, “खे च्हि लोङिन सो छ्यामेता। काङ भोटो ङा थुङाला छेछेला होए, च्हि ख्योए हति थुङ ङ्युकिनाइ?” हतिबे नाइसोङ, “ङ्युइकिन।” <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />ख्युइ नाइसोङ, “ङाहि भोटो खे थुङान ना, हिन्नाङ ङाहि याइ राङ योन यहला तोतु झुयापयि ताम ङाहि लाला मेता। धि सा हतिबे ना, सुइ चाला ङाहि आकि तयार क्याइ छारते।” <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />धि थोइरे लोब्टु च्यु गार हति भाइ ङि ङ्याबो ठोइरेलो। <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />हिन्नाङ येशुयि हतिबाला पोरोला रेँ चिना क्ये ताङदे नाइसोङ, “खेला छ्या राङ मेति, कि यहुदि मान्ते मि आङकिङानबे हतिबे थोला कडा आङकिन, राङ छ्येछ्येतेबे हतिबे थोला आङ किन।<note caller="-" style="x"><char style="xo" closed="false">20:25 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">लुका २२:२५-२६</ref> </char></note> <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />खि उइला हति च्वरा मिहा, हिन्नाङ सु खि नाङने छ्ये होङयापयि धोप्पा किन, हति खि स्यापच्यि होङ कोयिन।<note caller="-" style="x"><char style="xo" closed="false">20:26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">मत्ति २३:११</ref>; <ref loc="LUK 22:26">लुका २२:२६</ref> </char></note> <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />सु खि नाङने ताङस्युवा होङयापयि धोप्पा किन, हति खि यक्पुवा होङकोइ हुन, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />च्हिरु क्याइरे मि पिजा याङ स्यापच्यि खुयापला माना हिन्नाङ स्यापच्यि स्युरु राङ थारथोनयापयि तोनयि चाला रेँ उ तेरतु लेलेबाना।”<verse eid="MAT 20:28" /></para>
  <para style="s">येशुयि मि काना ङेला टाक्तु च्युच्युका</para>
  <para style="r">
    <ref loc="MRK 10:46-52">मर्कुस १०:४६-५२</ref>; <ref loc="LUK 18:35-43">लुका १८:३५-४३</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />येशु राङ ख्युइ लोब्टुबा यरिहोने ढुइतुइना, मि झोमयि तुम छेया झि ख्युइ क्यापला लेप्सोङ। <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />लामयि धुनला ताताति मि काना ङि येशु हति लामने डुनदु ना थोइरे जु नेनगा क्ये तोनसोङ, “हे प्रभु, दाउदयि पिजा, ङाहि थोला ङिङ्च्ये।” <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />मि झोमयि हतिबाला च्यामाना त्योए नाइरे ङारसोङ, हिन्नाङ हतिबा जु नेन राङ झन क्ये छेया क्याइरे क्ये तोन्देलो, “हे प्रभु, दाउदयि पिजा, ङि थोला ङिङ्च्ये।” <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />तेहि येशु कुरेलो राङ हतिबाला क्ये ताङदे नाइसोङ, “खे च्हि धोप्पा किन? ङा खि चाला च्हि किच्याइ?” <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />हतिबे खोला नाइसोङ, “हे प्रभु, ङि मि फेया।” <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />येशुयि ङिङच्येरे हतिबे मिला घुलसोङ राङ हतितुइना राङ थोङान च्युङसोङ राङ हतिबा ख्युइ च्येला पुइसोङ।<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">यरुश्लेमला येशुयि क्याक्यादे ढुल क्याक्याइबा</para>
  <para style="r">
    <ref loc="MRK 11:1-11">मर्कुस ११:१-११</ref>; <ref loc="LUK 19:28-40">लुका १९:२८-४०</ref>; <ref loc="JHN 12:12-19">युहान्ना १२:१२-१९</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />जब हतिबा यरुश्लेमयि धुनला जैतुन रियि बेथफागेला लेप्छारते, तेहि येशुयि लोब्टु ङेला जु नाइरे चाँसोङ, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />“खे धुनयि युलला क्यु। हतिया क्योबि पाल्ला खेला टे झि राङ हति टेटु तातामा ठेङान ना। हतिला टोलदे ङाहि तेहा ख्याला। <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />सुइ याङ खेला चिगा नाइना, ‘प्रभुला धि कोइबा धु’ नाइ राङ हति हतितुइना राङ हति चोँङान ना।” <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />ङोन्सेखिलङानबे नानाइबा वचन पुरा होङ नाइरे धि च्युच्युवा हिना, <verse eid="MAT 21:4" /><verse number="5" style="v" sid="MAT 21:5" />“सियोनयि पुमोला नोइ, तोइ, खि क्याल:बो खि तेहा हुन्दु, लेम्बा च्युङदे टेयि थोला स्योन्दे, टेयि च्यिबा, टेटु झिकि थोला।”<note caller="-" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">जकरिया ९:९</ref> </char></note> <verse eid="MAT 21:5" /><verse number="6" style="v" sid="MAT 21:6" />तेहि लोब्टुबा पुइसोङ, राङ येशुयि हतिबाला लाइ कोकोइबा च्वरा क्याइसोङ। <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />हतिबे टे राङ हति टेटु ख्योसोङ, राङ हति थोला रेँ कोहिला राराला तिङदे, राङ खो हति थोला स्योनसोङ। <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />मितेबे तुमला लेइराङयि रेँ कोहिला लामला तिङदेलो, राङ स्यानतेबे तोङबोङयि ढाला तुप्ते लामला तिङदेलो। <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />ख्युइ ताङला राङ च्येला ढोङान मि झोमतेबे जु नेन राङ क्ये तोन्देलो, “दाउदयि पिजा होसन्ना! किप्पो खो, सु परमप्रभुयि मिनला हुन! परमप्रभुला होसन्ना!”<note caller="-" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">भजनसंग्रह ११८:२५-२६</ref> </char></note><verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />जब येशु यरुश्लेमला स्युरेलो, भजार पोरोला टाइक्ये च्युङसोङ। मितेबे ढियाला छेलसोङ, “धि सु ना?” <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />मि झोमयि मितेबे जवाक पिनसोङ, “धि गालिलयि नासरतने लेलेबि ङोन्सेखिलङान, येशु ना।”<verse eid="MAT 21:11" /></para>
  <para style="s">येशु मोनलाम क्यासि खिमला</para>
  <para style="r">
    <ref loc="MRK 11:15-19">मर्कुस ११:१५-१९</ref>; <ref loc="LUK 19:45-48">लुका १९:४५-४८</ref>; <ref loc="JHN 2:13-22">युहान्ना २:१३-२२</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />येशु कजसुबायि मोनलाम क्यासि खिमला स्युसोङ। तेहि ख्युइ मोनलाम क्यासि खिमला ङ्योङान छोङान पोरोला त्येसोङ, राङ आलाइ च्येङानयि च्यकचे, राङ ङोम्मु छोङानयि त्योएसा ल-ल क्यापसोङ। <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />ख्युइ हतिबाला नाइसोङ, “धि पवित्रशास्त्रला टिटिबा धु, ‘ङाहि खिम मोनलाम क्यासि खिम नेन।’ हिन्नाङ खि धिला डाकुतेबे अड्डा सोइदु।”<note caller="-" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">यशैया ५६:७</ref>; <ref loc="JER 7:11">यर्मिया ७:११</ref> </char></note> <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />काना राङ ढुढियातेबा मोनलाम क्यासि खिमला ख्युइ तेहा लेप्सोङ, राङ ख्युइ हतिबाला टाक्तु च्युसोङ। <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />हिन्नाङ जब घोबा पुजारितेबा राङ शास्त्रिबे ख्युइ क्याक्याइबि हा:लाइयापयि लाइ थोङदे, राङ स्यारा नोज्युङयि मोनलाम क्यासि खिमला, “दाउदयि पिजाला होसन्ना” नेन राङ क्ये तोतोना थोइरे, हतितुइना हतिबा स्येताङ लाँरेलो, <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />राङ हतिबे खोला नाइसोङ, “थोयिन धु, धिबे च्हि नेन धुइ?” तेहि येशुयि हतिबाला नाइसोङ, “हो, थयिनदु। खि टटबा मेताइ, ‘च्यिटाका राङ होमा थुङान च्यिबातेबे खाने ख्युइ पुरा छे तेतेका होतो?’”<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />तेहि येशु हतिबाला पोरते खो यरुश्लेम भजारने थोन्दे बेथानियाला पुते हतिया छान झि ढोम्बोला ताते।<verse eid="MAT 21:17" /></para>
  <para style="s">येशुयि भेलडुयि तोङबोङला छार चुसोङ</para>
  <para style="r">
    <ref loc="MRK 11:12-14">मर्कुस ११:१२-१४</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />नामे थरह भजारला हुइतुइना येशु टोपा तसोङ। <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />लामयि नेमुला ख्युइ भेलडुयि तोङबोङ झि थोङसोङ। खो हति तोङबोङयि धुन्ना लेप्सोङ, हिन्नाङ हतिला ङोलो अर्थात स्यान च्याङ माखुसोङ। तेहि ख्युइ हतिला नाइसोङ, “ता याङ ख्योएला नामयाङ ढेबु मा छ्या” राङ हति भेलडुयि तोङबोङ हतितुइना राङ काम छारसोङ। <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />धि थोङदे लोब्टुतेबे हा:लाइरे नाइसोङ, “धि भेलडुयि तोङबोङ च्हिरु क्याइरे युप्पु झिला काम छारसुइ?” <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />येशुयि जवाक पिन्दे हतिबाला नाइसोङ, “तेम्बारे, ङा खेला नाज्याइ, खेला हिछे होतो राङ जबयाङ संका माक्याइना, भेलडुयि तोङबोङला च्हि क्याइरे हति मात्रा माना, हिन्नाङ धि रिला याङ ‘कोकदे छो छोम्मुवाला ङिल’ नाइनाङ सो होङान ना। <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />हिछे क्याइरे मोनलामला च्हि लाँनाङ हति ख्योएला खुङान ना।”<verse eid="MAT 21:22" /></para>
  <para style="s">येशुयि आङयि भारेला टिटिबा</para>
  <para style="r">
    <ref loc="MRK 11:27-33">मर्कुस ११:२७-३३</ref>; <ref loc="LUK 20:1-8">लुका २०:१-८</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />खो मोनलाम क्यासि खिमयि नाङला स्युसोङ, तेहि ख्युइ छोइ तेरितुइना घोबा पुजारि राङ जनतायि केवाकिङान गुरुतेबा ख्युइ तेहा लेप्सोङ, राङ नाइसोङ, “काङ आङयि ख्योए धि लाइ किन, राङ सुइ ख्योएला धि आङ पिन्सुइ?” <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />येशुयि हतिबाला जवाक पिन्सोङ, “ङा याङ खेला टिवा जि ढिज्याइ। ङाला हति जवाक पिन्ना, ङा काङ आङयि धि लाइकिन, सो खेला स्येतोङ। <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />युहान्नायि बप्तिस्मा काने च्युच्युवा ना? तेङलाने कि मिने?” हतिबा राँराँसा जु नेन राङ फाला छ्युला नारे क्याइसोङ, “तेङलाने नाइना, ख्युइ ‘हति हिन्ना खि खोला चिला हिछे माक्यइबा?’ नाङान ना। <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />हिन्नाङ मिने नाइना, ङेला मितेबे झिटा होतो। चिचालानाना पोरोयि युहान्नाला ङोन्सेखिलङान हिना नाइरे मानि किन।” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />हतिचाला हतिबे येशुला जवाक पिन्देलो, “ङेला छ्या मेता।” ख्युइ हतिबाला नाइसोङ, “ङा याङ काङ आङने धि लाइ किन, सो खेला मिना।”<verse eid="MAT 21:27" /></para>
  <para style="s">पिजा ङि प्ये</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />“खे च्हि विचार किन? मि झिकि पिजा ङि होतोलो। ख्युइ छेयायि तेहा पुते नाइसोङ, ‘पिजा पुते तिरिङ अंगुरयि भारिला लाइ कि।’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />हति जवाक पिन्सोङ। ‘ङा मिढो।’ हिन्नाङ तेहि च्येला घ्योप्पा केरे पुतेलो।” <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />“तेहि स्यान ङिबायि तेहा पुते ख्युइ हति च्वरा राङ नाइसोङ। हति जवाक पिन्सोङ, ‘ङा ढोज्याइ।’ हिन्नाङ मापुतालो।” <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />“ता धि ङि नाङने सुइ आकि धोप्पा ङ्यानसुइ?” हतिबे जवाक पिन्सोङ, “छेयाति।” येशुयि हतिबाला नाइसोङ, “तेम्बारे, ङा खेला नाज्याइ, कर तुइङान राङ पातान्नितेबा खेले ताङला कजसुबायि राज्यला स्युकिन। <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />चिचालानाना बप्तिस्मा तेरङान युहान्ना खि तेहा केवायि लाम तोन्दु लेप्ते, हिन्नाङ खि ख्युइ थोला हिछे माक्याइसोङ। हिन्नाङ कर तुइङान राङ पातान्नितेबे ख्युइ थोला हिछे क्याइसोङ। खि धि थोङदे याङ घ्योप्पा माक्याइसोङ, तेहि ख्युइ थोला हिछे माक्याइसोङ।”<verse eid="MAT 21:32" /></para>
  <para style="s">अंगुरयि भारिला स्याइला लाइ किङान</para>
  <para style="r">
    <ref loc="MRK 12:1-12">मर्कुस १२:१-१२</ref>; <ref loc="LUK 20:9-19">लुका २०:९-१९</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />येशुयि नाइसोङ, “स्यान प्ये ङ्योन। स्हा स्यिङ छेया होएते मिझि होतो, सुइ अंगुरयि भारि सोइसोङ, तेहि हति फाला छुलोला भार क्यापते हतिया अंगुर स्युङयापयि स्योङबा पोरते, राङ सो क्यासि खिम सोइसोङ। तेहि स्याइला पिपिनि मिबाला हति जिम्मा पिन्दे खो फियि देशला पुतेलो।”<note caller="-" style="x"><char style="xo" closed="false">21:33 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">यशैया ५:१-२</ref> </char></note> <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />जब ढेबयि भेला धुनला लेप्सोङ, ख्युइ स्याइला पिनि मितेबे तेहा ढेबुयि रेँ थोपयापयि भागते लोङदु यक्पुवाबाला चाँरेलो। <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />“हिन्नाङ स्याइयि मितेबे ख्युइ यक्पुवातेबाला सुङदे चिला क्यापसोङ राङ, स्यानतेला सेसोङ, राङ स्यानतेला टोउयि क्यापसोङ। <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />याङ ख्युइ ताङलाने केना मा यक्पुवा चाँरेलो, राङ हतिबे हतिबा लाङ हति च्वरा राङ बानि व्यवाहार क्याइसोङ। <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />‘ङाहि पिजाला ता हतिबे सम्मान क्यायोङ’ नाइरे टन्दे, च्येस्युवाला ख्युइ रेँ पिजाला याङ हतिबे तेहा चाँसोङ।” <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />“हिन्नाङ स्याइयि मितेबे पिजाला थोङदे खोरे नाङला नारे क्याइसोङ, ‘धि नि ता होङानयि आङकिङान मिना। सअ, हतिला सोता, राङ हति आङ लाला ख्युवा।’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />तेहि हतिबे खोला सुङदे अंगुरयि भारि फिला खेरसोङ राङ हतिला सेसोङ।” <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />“हतिचाला जब अंगुरयि भारि ताक्पो हुन, हतितुइना हति स्याइ मितेबाला च्हि क्यायोङङि?” <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />हतिबे खोला नाइसोङ, “ख्युइ हति अल मितेबे स्युल राङ ततु झुङान ना, राङ अंगुरयि भारि स्यान स्याइयि मिला जिम्मा तेराङान ना, सुइ खोला ढेबुयि भाग भेलाला केलकिन।” <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />येशुयि हतिबाला नाइसोङ, “च्हि ख्युइ जबयाङ पवित्रशास्त्रला माटबाइ? ‘काङ टोउला खिम सोङानतेबे टिम्दे हतिते सुरयि तेम्मा टोउ च्युङसोङ, धि कजसुबाने च्युच्युवा ना, तेहि हुइ मिलाधि हा:लइयाप धु।’”<note caller="-" style="x"><char style="xo" closed="false">21:42</char><char style="xt" closed="false"><ref loc="PSA 118:22-23">भजनसंग्रह ११८:२२-२३</ref></char></note> <verse eid="MAT 21:42" /><verse number="43" style="v" sid="MAT 21:43" />“हतिचाला ङा खेला नाज्याइ, कजसुबायि राज्य खेने ठङान ना, राङ च्हि हति च्वरा मितेबाला तेरङान ना, सुइ हति ढेबु छ्यातु झ्युकिन। <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />हति टोउयि थोला ङिलङानते तुबु-तुबु होङान ना, हिन्नाङ सुइ थोला हति टोउ ङिलकिन, हति हतिला तारे फेरु सोङान ना।” <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />जब घोबा पुजारितेबा राङ फरिसितेबे ख्युइ प्ये ङ्यानसोङ, तेहि हतिबे भारेला राङ ख्युइ नानाइबा ना नाइरे हा:कोरसोङ। <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />हतिबे खोला सुङ च्युइ क्याइसोङ, हिन्नाङ हतिबा मि झोमला झिरे, चिचालानाना मितेबे खोला ङोन्सेखिलङान हिना नाइरे सामकिनलो।<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">मिजि भत्यारयि प्ये</para>
  <para style="r">
    <ref loc="LUK 14:15-24">लुका १४:१५-२४</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />येशुयि याङ हतिबाला प्येला नाइसोङ, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“तेङलायि राज्य क्याल:बो झि ङ्याबो थु ङ्युइकिन, सुइ रेँ पिजायि मिजेयि भत्यार तयार क्याइरे। <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />राङ भत्यारला पोपोइबि मितेबाला क्ये तोङदु नाइरे रेँ यक्पुवाबाला चाँरेलो, हिन्नाङ हतिबे होङसोम माक्याइबालो।” <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />“याङ ख्युइ स्यान यक्पुवाबाला जु नाइरे चाँरेलो, पोपोइबि मिबाला नोइ, तोइ, ङाहि ङारि भत्यार तयार सोइरे, ङाहि लोङबा राङ छोम्बो-छोम्बो तुढोबा सासाता होतो, राङ पोरो क्यु तयार होतो। मिजेयि भत्यारला सअ।” <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />“हिन्नाङ हतिबे मदलब राङ म, आचेबा रेँ च्हि भारि राङ स्यिङ यहला, स्यानतेबा रेँ छोङ कितु पुतेलो। <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />स्यानतेबे ख्युइ यक्पुवातेबाला सुङदे क्यापसोङ राङ हतिबाला स्येसोङ।” <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />तेहि क्याल:बो सेताङ लाँदु, राङ रेँ कोराबातेबाला चाँरेलो हति मिपसोएतेबाला सातेलो, हतिबे भजारला मे क्यापतेलो। <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />“तेहि ख्युइ रेँ यक्पुवातेबाला नाइसोङ, ‘मिजेयि भत्यार तयार धु, हिन्नाङ पोपोइबातेबा झोदायि मिधु। <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />हतिचाला खे चोकतेबाला क्यु, राङ चोम ठे नाङ हतिबाला मिजेयि भत्यारयि चाला पोइ।’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />तेहि हति यक्पुवातेबा चोकतेबाला पुते ठाठाता पोरोला, अल राङ ल ङि कारला, जम्मा क्याइसोङ, राङ मिजेयि खिम ढोम्बोतेबे खाँसोङ।” <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />“हिन्नाङ जब क्याल:बो ढोम्बोबाला तारु नाइरे नाङला लेप्तेलो, तेहि हतितुइना ख्युइ मिजेयि कोहिला मकोनि मिझिला थोङदे। <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />क्यालबुइ हतिला टिसोङ, ‘रुवा, मिजेयि कोहिला माकोनि ख्योए च्हिरु क्याइरे धि नाङला लेप्ते?’ हति जवाक मेता च्युङसोङ।” <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />“तेहि क्यालबुइ स्यापच्यि स्युङानतेबाला नाइसोङ, ‘हति लाक्पा काङबा किरे फिला मुन्नाला टिम, काँहा मितेबा ङुङान ना राङ सो चेङान ना।’<note caller="-" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="MAT 8:12">मत्ति ८:१२</ref>; <ref loc="MAT 25:30">२५:३०</ref>; <ref loc="LUK 13:28">लुका १३:२८</ref> </char></note> <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />येशुयि धि ताम स्यालसोङ, चिचालानाना क्ये ताताङा लेइराङ होतो हिन्नाङ धाधामा टिझि।”<verse eid="MAT 22:14" /></para>
  <para style="s">कर च्योङयापयि भारेला टिटिबा</para>
  <para style="r">
    <ref loc="MRK 12:13-17">मर्कुस १२:१३-१७</ref>; <ref loc="LUK 20:20-26">लुका २०:२०-२६</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />तेहि फरिसिबा पुते खुरि तामला खोला च्हिरु क्याइरे फसाइ किच्याइ नाइरे टोइ क्याइसोङ। <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />हतिबे रेँ लोब्टुबला हेरोदि तुमयि मितेबा ङ्याबो ख्युइ तेहा चाँरेलो। हतिबे नाइसोङ, “हे गुरुज्यु, ङेला छ्या होतो, ख्योए तेम्बा ना, राङ कजसुबायि लाम तेम्बा क्याइरे लोबिन्दु, राङ ख्योए सुलाङ मिझिबा, चिचालानाना ख्योए मितेबे च्ये ताइरे लाइ मिकिता। <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />ख्युइ विचार च्हि होतो ङेला नोइ, कैसरला<note caller="+" style="f"><char style="fr" closed="false">22:17 </char><char style="ft" closed="false">रोमियि क्यालबो</char></note> कर च्योङयाप ल हिना कि माना?” <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />हिन्नाङ येशुयि हतिबे सम ना हा:कोरे नाइसोङ, “समनाँबा हो, खे ङाला चिला छोएतेन? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />कर च्योङयापयि सिक्का ङाला तोन।” राङ हतिबे ख्युइ तेहा सिक्का झि ख्योरेँलो। <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />ख्युइ हतिबाला नाइसोङ, “धि भुट्टा सुइना, तेहि सुइ मिन कोए क्यापतुइ?” <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />हतिबे खोला नाइसोङ, “कैसरयि।” तेहि ख्युइ हतिबाला नाइसोङ, “हतिचाला च्हि कैसरयि हिना, हति कैसरला पिन, राङ काङ कजसुबायि हिना हति कजसुबाला पिन।” <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />हति थोहिरे हतिबा हा:लाइरेलो, राङ खोला ताङदे रेँ लामला पुइसोङ।<verse eid="MAT 22:22" /></para>
  <para style="s">स्यिस्यियाने सोम्बो च्युङदे लाँलाँबा राङ मिजे</para>
  <para style="r">
    <ref loc="MRK 12:18-27">मर्कुस १२:१८-२७</ref>; <ref loc="LUK 20:27-40">लुका २०:२७-४०</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />स्यिस्यियाने सोम्बो मिलाबा नाङान सदुकिबा हति ङिन राङ ख्युइ तेहा लेप्सोङ, राङ हतिबे खोला धि टिवा टिसोङ<note caller="-" style="x"><char style="xo" closed="false">22:23 </char><char style="xt" closed="false"><ref loc="ACT 23:8">प्रेरित २३:८</ref> </char></note>, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“गुरुज्यु, मोशायि नाइदु, सु मि याङ च्यिबा माच्युङा स्यिना ख्युइ भाइयि आज्योयि केरमानला मिजे क्याइरे आज्योयि सन्तन लोङकोइ हुन। <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />ङि उइला आज्यो भाइ तुन होतो। छे सोयि मिजे क्याइरे खो स्यिसोङ, राङ सन्तन माच्युङाति ख्युइ भाइयि चाला केरमान पोरते पुइसोङ। <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />हति च्वरा क्याइरे पारकाति राङ पारकायि छाम्माति, राङ तुन गारयि हति च्वरा क्याइसोङ। <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />हतिबा पोरो सिरे हति पुमो याङ स्यिसोङ। <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />हतिचाला स्यिस्यियातेबा याङ सोम्बो च्युङदे लाँबितुइना हति तुन गारयि नाङने हति पुमो सुइ केरमान हुन? चिचालानाना हति पोरोयि केरमान च्युङ छारते।” <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />येशुयि हतिबाला जवाक पिनसोङ, “खे घो ख्यामदु, चिचालानाना खे पवित्रशास्त्रा राङ कजसुबायि शक्ति हा:मिकुवा। <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />चिचालानाना मि स्यिस्यियाने सोम्बो लाँलाँबा मितेबे मिजे मिकिता, न मिजे क्याइरे तेरिन, हिन्नाङ हतिबा तेङलायि-तेङलायि लोन खेरङान च्वरा हुन। <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />हिन्नाङ मि स्यिस्यियातेबा सोम्बो लाँलाँबि भारेला;ङा कजसुबायि खेला च्हि नाइदुइ, हति खि टटबा मेता? <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘ङा अब्राहामयि कजसुबा, इसहाकयि कजसुबा राङ याकुबयि कजसुबा ना।’ कजसुबा स्यिस्यियातेबे कजसुबा माना, हिन्नाङ सोम्बोतेबे कजसुबा ना।”<note caller="-" style="x"><char style="xo" closed="false">22:32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">प्रस्थान ३:६</ref> </char></note> <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />धि थोइरे मिझोमतेबा ख्युइ छोइला हा:लाइसोङ।<verse eid="MAT 22:33" /></para>
  <para style="s">पोरो हा:छेया आदेश</para>
  <para style="r">
    <ref loc="MRK 12:28-34">मर्कुस १२:२८-३४</ref>; <ref loc="LUK 10:25-28">लुका १०:२५-२८</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />येशुयि सदुकिला च्यामाना सोइरसोङ नाङान थोइरे फरिसिबा ख्युइ तेहा झोम्देलो। <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />हतिबे नाङने च्हि शास्त्रियि खोला छोएतायापयि विचारयि खोला टिरेलो, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“गुरुज्यु, मोशायि ठिमला हा:छेस्युवा आदेश काते ना?” <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />ख्युइ हतिला नाइसोङ, “ख्युइ कजसुबा रेँ कजसुबाला रेँ सम पोरोने, राङ रेँ उ पोरोने, राङ रेँ पोरो हा:कोयाप पोरोने करि कि।<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">व्यवस्था ६:५</ref> </char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />छे स्युवा राङ ताङस्युवा आदेश धि राङ ना। <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />ङिबा आदेश तेयाङ धि च्वरा राङ होतो, ख्युइ रेँ खिमजेला राङ च्वरा करि कि।<note caller="-" style="x"><char style="xo" closed="false">22:39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">लेवि १९:१८</ref> </char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />मोशायि ठिम पोरो राङ ङोन्सेखिलङानयि छोइयि हा:कोयाप राङ धि आदेश ङि तेना।”<note caller="-" style="x"><char style="xo" closed="false">22:40 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">लुका १०:२५-२८</ref></char></note><verse eid="MAT 22:40" /></para>
  <para style="s">येशुयि भारेला टिटिबा</para>
  <para style="r">
    <ref loc="MRK 12:35-37">मर्कुस १२:३५-३७</ref>; <ref loc="LUK 20:41-44">लुका २०:४१-४४</ref></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />जब फरिसिबा झोझोमा होतोलो, हतितुइना येशुयि हतिला टिवा झि क्याइसोङ, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“ख्रिष्टयि भारेला खे च्हि टानकिनधुइ? खो सुइ पिजा ना।” हतिबे खोला नाइसोङ, “दाउदयि पिजा।” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />येशुने हतिबाला टिसोङ, “हति च्वरा हिन्ना दाउदला आत्मायि शक्तिने खुँरे खोला च्हिरु क्याइरे प्रभु नाइरे क्ये तोङकिन? खो नेन धु,” <verse eid="MAT 22:43" /><verse number="44" style="v" sid="MAT 22:44" />कजसुबायि ङाहि प्रभुला नाइसोङ, “ख्योए ङाहि याइ यहला त्योए, जब थु ङा ख्युइ टातेबाला ख्युइ काङबि तिङभि हअला मिभोरा।”<note caller="-" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजनसंग्रह ११०:१</ref> </char></note> <verse eid="MAT 22:44" /><verse number="45" style="v" sid="MAT 22:45" />तेम्बारे दाउदयि खोला प्रभु नाना, “खो च्हिरु क्याइरे ख्युइ पिजा हुन?” <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />तेहि सुइ याङ जवाकला तामझि याङ ना माङ्युइसोङ। हति ङिनने सुलाहाङ खोला ताम ढियापयि हाम माकेसोङ।<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">शास्त्रि राङ फरिसिबाला चेतावानि पिपिना</para>
  <para style="r">
    <ref loc="MRK 12:38-40">मर्कुस १२:३८-४०</ref>; <ref loc="LUK 11:39-52">लुका ११:३९-५२</ref>; <ref loc="LUK 20:45-47">२०:४५-४७</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />तेहि येशुयि मियि तुमबा राङ रेँ लोब्टुबाला झु नाइसोङ; <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />शास्त्रि राङ फरिसिबा मोशायि त्योएसि कुरच्यिला तोकिन। <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />हतिचाला हतिबे नानाइबि ताम कि राङ ङ्योन, हिन्नाङ हतिबे क्याक्याइबा च्वरा माके, चिचालानाना हतिबे छेइता तेरकिन, हिन्नाङ हति च्वरा मिकिता। <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />हतिबे काबो राङ खुर मिङ्युइङान खुरबो ताम्दे मितेबे ठाला भोरङान ना। हिन्नाङ हतिबा खोराङते धेयापला झु जि याङ मि घुला। <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />“हिन्नाङ हतिबे रेँ लाइ पोरो मिला तोनयापयि चाला किन। चिचालानाना हतिबा रेँ टाला राङ नाला ठिमयि पाबुइ खोल छेया सुन, राङ रेँ कोहिलायि ङोम छेयासुनलो।<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="NUM 15:38">गन्ति १५:३८</ref>; <ref loc="DEU 6:8">व्यवस्था ६:८</ref>; <ref loc="MAT 6:1">मत्ति ६:१</ref></char></note> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />भत्यारतेबाला हतिबा सम्मानयि सा राङ यहुदि झोमसि खिमतेबाला घोयि त्योएसातेबाला करि किन, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />भजारतेबाला नमस्ते फाकिनलो राङ मितेबे गुरु नानाइबा केनलो।” <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />“हिन्नाङ खेला सुइ याङ ‘गुरुज्यु’ माना, चिचालानाना खि गुरु च्हि मात्रा होतो, राङ खे पोरो आज्यो राङ भाइना। <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />खे पिरथिविला सुला याङ रेँ आके माना, चिचालानाना तेङलाला खि आके झि मात्रा होतो। <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />खेला सुइ याङ ‘गुरु’ माना, चिचालानाना खि गुरु च्यि मात्रा ख्रिष्ट ना। <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />खि नाङने सु पोरोले छेया हिना, हति खि स्यापच्यि स्युङान होङान ना।<note caller="-" style="x"><char style="xo" closed="false">23:11 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">मत्ति २०:२६-२७</ref>; <ref loc="MRK 9:35">मर्कुस ९:३५</ref>; <ref loc="LUK 22:26">लुका २२:२६</ref>; <ref loc="MRK 1:43-44">मर्कुस १:४३-४४</ref></char></note> <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />सुइ राङला छेयया नेन, हति टिमा हुन, राङ सुइ राङला टिमा सुन, हति छेया हुन।”<note caller="-" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="LUK 14:11">लुका १४:११</ref>; <ref loc="LUK 18:14">१८:१४</ref> </char></note><verse eid="MAT 23:12" /></para>
  <para style="s">येशु हतिबे समनाँला अल नेन</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“धिक्कार, खेला, शास्त्रि राङ फरिसिबा, समनाँतेबा! चिचालानाना खे मितेबे धुनला तेङलायि राज्ययि कोतेबा क्याकिनदु। खे न खेरा सुकिनदु, न स्युयापयि धोप्पा होएतातेबाला स्युतु झुकिनदु।” <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />“धिक्कार खेला, शास्त्रि राङ फरिसिबा, समनाँ! चिचालानाना खे राढितेबे खिम सेन्दु, राङ रिङमुवा-रिङमुवा मोनलाम क्यायापयि ढान किन्दु। हतिचाला स्यानले केना खेला ङेबा मा खुङान ना।”<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />“धिक्कार खेला, शास्त्रि राङ फरिसिबा, समनाँ! चिचालानाना खे चिला रेँ हिछेयि छ्याला ख्योङयापयि चाला छो छोम्मुवा राङ सा कालकिनदु, राङ हति खि हिछेयि छ्याला लेप छारते हतिला राङले गुना ङि ङ्यालबायि पिजा सुनलो।” <verse eid="MAT 23:15" /><verse number="16" style="v" sid="MAT 23:16" />“धिक्कार खेला, काना लाम तोनङानबा, सुइ नेन, ‘सुइ याङ मोनलाम क्यासि खिमयि नाकेलाला च्याङ मिहा, हिन्नाङ मोनलाम क्यासि खिमयि सेरयि ना केलितुइना हति ना क्याक्यालि ताम्दे भोरङान ना।’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />मुर्ख राङ कानातेबा, काङते छेया ना? सेर कि सेरला पवित्र सोङान मोनलाम क्यासि खिम? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />‘सुइ याङ वेदियि ना केलितुइना च्याङ मिहा, हिन्नाङ हति थोला पोपोरि भेटियि ना केलितुइना ना क्याक्यालि तातामा धु।’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />ए काना मितेबा, काङते छेयाना? भेटि या भेटिला पवित्र सोङान वेदिते? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />हतिचाला वेदिला नाके केलङानयि किताब राङ हति थोकि पोरो क्युयि ना केलिन। <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />मोनलाम क्यासि खिमयि ना केलङानयि मिति मोनलाम क्यासि खिम राङ हति नाङला त्योएङान कजसुबायि ना केलिनलो। <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />तेङलायि ना केलङानयि कजसुबे क्याल ठि राङ हति थोला त्योएङानगि याङ ना केलिनलो।”</para>
  <para style="p" vid="MAT 23:22">
    <note caller="-" style="x">
      <char style="xo" closed="false">23:22 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 66:1">यशैया ६६:१</ref>; <ref loc="MAT 5:34">मत्ति ५:३४</ref> </char>
    </note> <verse eid="MAT 23:22" /><verse number="23" style="v" sid="MAT 23:23" />“धिक्कार खेला, शास्त्रि राङ फरिसिबा, समनाँतेबा! चिचालानाना खे पुदिना राङ सुप राङ जिरायि दशंशा तेरिनदु, हिन्नाङ ठिमयि ङोधो भारेतेबा, मदलब न्याय, ङिङ्च्ये राङ हिछे वास्ता क्याक्याइबा होतो। खि दशंशा तेरयापयि लाइ किकोइहुन, तेहि हति गहकिला भारेबे अवहेलाना मक्याइबा नाना हुन।”<note caller="-" style="x"><char style="xo" closed="false">23:23 </char><char style="xt" closed="false"><ref loc="LEV 27:30">लेवि २७:३०</ref> </char></note> <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />“काना लाम तोनङानतेबा, खे मछ्यार च्वरा क्याइरे ढिन्दु, हिन्नाङ उटला मिछारकिन दु।”<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />“धिक्कार खेला, शास्त्रि राङ फरिसिबा, समनाँबा! चिचालानाना खे भोटो राङ तेरमायि फि चाङमा सुन्दु, हिन्नाङ नाङ यहला नाना समना राङ सवरथि खाँखाँबा हुन। <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />काना फरिसिबा, ताङला भोटो राङ तेरमायि नाङ चाङमा सोइ, राङ हति फियाङ चाङमा होङ।”<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />“धिक्कार खेला, शास्त्रि राङ फरिसिबा, समनाँबा! चिचालानाना खे सागार कुकुइबि तुर च्वरा ना, काङते फिला लेबो थोङिन, हिन्नाङ नाङला नाना स्यिस्यिया मियि रुइको राङ पोरो भाभायि खाँखाँबा हुन।<note caller="-" style="x"><char style="xo" closed="false">23:27 </char><char style="xt" closed="false"><ref loc="ACT 23:3">प्रेरित २३:३</ref> </char></note> <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />हति च्वरा क्याइरे खे याङ फिला नाना मितेबे धुनला केवाकिङान थोङिन राङ, हिन्नाङ नाङला नाना समनाँ राङ अलयि खाँखाँबा हुन।”<verse eid="MAT 23:28" /></para>
  <para style="s">येशुयि हतिबाला ङेबायि भारेला ङन्सेखिखिला</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“धिक्कार खेला, शास्त्रि राङ फरिसिबा, समनाँतेबा! चिचालानाना खे ङोन्सेखिलङानबे तुरतेबा सुन, राङ केवाकिङानतेबे तुरतेबा सजाइकिन, <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />राङ नेन, ‘ङे ङि ताङबुइ मितेबे भेलाला नाना ता ङे ङोन्सेखिलङानयि ठा क्युतु झ्युयापला हतिबा ङ्याबो सहभागि होङान माना ना।’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />धि च्वरा क्याइरे खे ङोन्सेखिलङानतेबाला सोएङानयि सन्तन ना नाङानयि साछि खे खेराङ तेकिन्दु। <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />खि ताङबोयि मि सुरु क्याक्याइबि लाइ पुरा कि।” <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />“रुलतेबा, रुलयि च्यिटातेबा, खे ङ्यालबि ङेबाने च्हिरु क्याइरे थारच्याइ?<note caller="-" style="x"><char style="xo" closed="false">23:33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">मत्ति ३:७</ref>; <ref loc="MAT 12:34">१२:३४</ref>; <ref loc="LUK 3:7">लुका ३:७</ref> </char></note> <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />हतिचाला ङा खि तेहा ङोन्सेखिलङान राङ, रिक्पा होएता मितेबा राङ शास्त्रिबा चोङ ज्याइ। हतिबे नाङने चोमला खि सोकिन राङ क्रुसला धोङान ना, राङ चोमला खि यहुदि झोमसि खिमला च्यायि छेरमा क्याङान ना, राङ भजार भजारला तुक्का तेराङान ना। <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />पिरथिविला चाँचाँबि पोरो केवाकिङानयि ठा च्याङ माक्याइबि मियि हाबिलयि ठाने क्याइरे बेरेक्याहयि पिजा जकरियायि ठा थु, सुला खि पवित्र सा राङ वेदितेबे उइला साते सो खिरि घोबोला फङान ना। <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />तेम्बारे, ङा खेला नाज्याइ, धि पोरो ताम धि काल्बि मितेबे थोला होङान ना।<verse eid="MAT 23:36" /></para>
  <para style="s">येरुसलेमयि चाला येशुयि करि</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“ए यरुश्लेम, ए यरुश्लेम, ख्योए सुइ ङोन्सेखिलङानबाला साते राङ ख्युइ तेहा चाँचाँबातेबाला टोउयि क्यापसोङ! च्हिरु क्याइरे च्यामुयि रेँ च्योपरुतेबाला श्यकपायि हअला रुकिन राङ, हति च्वरा क्याइरे ङाहि याङ लेइराङ ख्युइ चहिबाबाला रुयापयि धोप्पा क्याइरे, हिन्नाङ ख्युइ माङ्यानसोङ। <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />तोइ, खि खिम याङ मेतासुन।<note caller="-" style="x"><char style="xo" closed="false">23:38 </char><char style="xt" closed="false"><ref loc="JER 22:5">यर्मिया २२:५</ref> </char></note> <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />चिचालानाना ङा ख्योएला नाज्याइ, ‘कजसुबायि मिनला होङान ल ना’ मानाइ थु खि ङाला मिथुवा।”<note caller="-" style="x"><char style="xo" closed="false">23:39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">भजनसंग्रह ११८:२६</ref> </char></note><verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">येशुयि मोनलाम क्यासि खिम तिपयापयि भारेला ताम नानाइबा</para>
  <para style="r">
    <ref loc="MRK 13:1-37">मर्कुस १३:१-३७</ref>; <ref loc="LUK 21:5-38">लुका २१:५-३८</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />हति च्येला येशु मोनलाम क्यासि खिमने थोन्दे ढुइतुइना ख्युइ लोब्टुतेबा खोला मोनलाम क्यासि खिमयि भवनतेबा तोनयाप नाइरे ख्युइ धुनला लेप्तेसोङ। <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />हिन्नाङ ख्युइ हतिबाला नाइसोङ, “खि धि पोरो थोङिनदु, मानाइ च्हि? तेम्बारे, ङा खेला नाज्याइ, टोउ झि कि थोला टोउ झि मितोता, पोरो तिप्ते ढिमङान ना।” <verse eid="MAT 24:2" /><verse number="3" style="v" sid="MAT 24:3" />येशु जैतुन रिला तोतितुइना लोब्टुबा खो चिक्पा होएताला ख्युइ तेहा लेप्ते टिरेलो, “ङेला नोइ, धि तामबा जब हुन, राङ ख्युइ क्य राङ धि काल्बायि सिनि ता:च्हि हुन?” <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />तेहि येशुयि हतिबाला जवाक नाइसोङ, “च्याङबो क्याइरे त्योए, सुइ याङ खेला आच्या माच्याला माभोर। <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />चिचालानाना लेइराङ ङाहि मिनला ‘ख्रिष्ट हिना’ नेनगा होङान ना, राङ लेइराङला आच्या माच्या सोङान ना। <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />खि मा राङ मायि क्येतेबा थोइङान ना। माझि, चिचालानाना धि होङकोइ राङ हुन, हिन्नाङ सिनयाप हतितुइना राङ मिहा। <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />चिचालानाना मितेबे विरोधला मितेबे, राङ राज्ययि विरोधला राज्य लाँङान ना, देशयि विरोधला देश, कुरु कुरुला साला अनिकाल राङ सोङुल होङान ना। <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />हिन्नाङ धि पोरो ता च्यिटा क्येयापयि तुकि सुरु मात्रा ना।” <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />“तेहि हतिबे खेला तुका खुँयापयि चाला स्योएङान ना, राङ खेला सोएङान ना, राङ ङाहि मिनयि चाला पोरो मितेबायि खेला सम अल किङान ना।<note caller="-" style="x"><char style="xo" closed="false">24:9 </char><char style="xt" closed="false"><ref loc="MAT 10:22">मत्ति १०:२२</ref></char></note> <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />तेहि मि लेइराङ घो ख्यामङान ना, राङ धोका तेरङान ना, राङ चिकि स्यानला विश्वाशघात क्याइरे स्योएङान राङ सम अल किङान ना। <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />लेइराङ चुन ङोन्सेखिलङान लाँङान ना राङ लेइराङला घोख्यामदु झुङान ना। <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />अल मा च्युच्युवाति लेइराङयि करि ङ्युङदु ढोङान ना। <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />हिन्नाङ अखमरि थु त्योएङानते क्योपङान ना।<note caller="-" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">मत्ति १०:२२</ref></char></note> <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />तेहि कजसुबायि राज्यि धि लोन ल पोरो संसारला मितेबा पोरोयि साछियि चाला टाइक्ये किङान ना, हति च्येला च्येस्युवा सिनयापते होङान ना।”<verse eid="MAT 24:14" /></para>
  <para style="s">झिझिरा ख्यारख्याररा</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“हतिचाला जब खि दानिएल ङोन्सेखिलङाने नानाइबि मासि होङयापयि अल क्यु पवित्र साला ल्हाँल्हाँबा थोङान ना।<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">दानिएल ९:२७</ref>; <ref loc="DAN 11:31">११:३१</ref>; <ref loc="DAN 12:11">१२:११</ref> </char></note> टङानति हा:कुवा कि, <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />तेहि यहुदियाला होङानतेबा रि यहला टोइरे क्यु। <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />खिमयि खानाला होएतातेबा रेँ खिमला होएता क्यु धोनयापयि चाला हअला मापुप।<note caller="-" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="LUK 17:31">लुका १७:३१</ref> </char></note> <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />स्यिङ राङ भारिला होएता तेबा रेँ कोहिला लेन्दु लक्ते मायोङ। <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />हाय! टोपा होएतातेबा राङ होमा लुइङान हति ङिनला चोम झिझिरा हुन। <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />हिन्नाङ कुङघाला या ङालसुइ ङिनला खे टोइरे ढोज्याइ मायोङ नाइरे कजसुबाला मोनलाम क्योप। <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />चिचालानाना हति भेलाला धि च्वरा दसा घर होङान ना, काङते काल्बा छ्याने राङ थाल्ला थु च्युच्युवा मेता, न त याङ जब याङ हुन।<note caller="-" style="x"><char style="xo" closed="false">24:21</char><char style="xt" closed="false"><ref loc="DAN 12:1">दानिएल १२:१</ref>; <ref loc="REV 7:14">प्रकास ७:१४</ref> </char></note> <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />कजसुबायि हति ङिन ङुयुवा मासोइबाझि नाना सु मि याङ सोन मिङ्युइबा, हिन्नाङ धाधामाबे चाला हति ङिन घटाइ किङान ना। <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />तेहि खेला सुइ याङ हति भेलाला ‘तोइ, ख्रिष्ट ङिहा होतो, कि हतिया होतो’ नाइना हिछे माके। <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />चिचालानाना चुन ख्रिष्टतेबा, चुन ङोन्सेखिलङानतेबा लाँङान ना, राङ च्युङना ता कजसुबायि धाधामाला याङ घोख्यामदु झुयापयि चाला छेया-छेया तातेबा राङ हा:लाइयापयि लाइतेबा तोनङान ना। <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />टामबाला पोर, ङाहि खेला भेला होङयापले ताङलाराङ नाइ छाछारा होए।” <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />“तेम्बारे हतिबे ख्योएला ‘तोइ, खो च्याङ मेते साला धु’ नाइरे नाइना फिला थोन्दे माढो। तेहि ‘तोइ, मो नाङयि कोठाला हिप्ते त्यतु नाइनाङ’ याङ हिछे माके।<note caller="+" style="f"><char style="fr" closed="false">24:26 </char><char style="xt" closed="false"><ref loc="LUK 17:23-24">लुका १७:२३-२४</ref> </char></note> <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />चिचालानाना च्हिरु क्याइरे बिजुलि स्यारने होए भारितुइना नुप थु राङ साल्बो हुन, हति च्वरा क्याइरे मि पिजा याङ क्येरे होङान ना। <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />काँहा स्यिस्यियायि रो हुन, हतिया च्यारक्योए याङ झोम्दे तोकिन।”<note caller="-" style="x"><char style="xo" closed="false">24:28 </char><char style="xt" closed="false"><ref loc="LUK 17:37">लुका १७:३७</ref> </char></note><verse eid="MAT 24:28" /></para>
  <para style="s">मियि पिजा लेलेबा</para>
  <para style="r">
    <ref loc="MRK 13:28-31">मर्कुस १३:२८-३१</ref>; <ref loc="LUK 21:29-33">लुका २१:२९-३३</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“हति दशा घरयि ङिनयि च्येला, ङिमा मुन्ना होङान ना, राङ धा:यि रेँ होए तेरङान माना ना, राङ कार्मातेबा पान्नाङने ङिलङान ना, अर्थात पान्नाङयि शक्तितेबा घुलङान ना।<note caller="-" style="x"><char style="xo" closed="false">24:29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">यशैया १३:१०</ref>; <ref loc="ISA 34:4">३४:४</ref>; <ref loc="EZK 32:7">इजकिएल ३२:७</ref>; <ref loc="JOL 2:10-31">योएल २:१०-३१</ref>; <ref loc="JOL 3:15">३:१५</ref>; <ref loc="REV 6:12-13">प्रकास ६:१२-१३</ref></char></note> <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />तेहि मि पिजायि हा: लाइयापयि लातेबा पान्नाङला थोङान ना, राङ पिरथिवियि पोरो मितेबा टाङतुङान ना, राङ हति भेलाला हतिबे मियि पिजाला पान्नाङयि मुक्पातेबाला शक्ति राङ छेया छे ङ्याबो होङान थोङान ना।<note caller="-" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानिएल ७:१३</ref>; <ref loc="ZEC 12:10-14">जकरिया १२:१०-१४</ref>; <ref loc="REV 1:7">प्रकास १:७</ref> </char></note> <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />ख्युइ रेँ तेङलायि लोन खेरङान तेबाला केलिङयि छेया क्ये ङ्याबो चोङान ना, राङ हतिबे पान्नाङयि धुन झिने स्यानयि धुन थु छ्ह सिने ख्युइ धाधामातेबाला झोमधु झुङान ना।”<verse eid="MAT 24:31" /></para>
  <para style="s">भेलडुयि तोङबोङने छोइ</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“हिन्नाङ भेलडुयि तोङबोङने छोइ झि खेर: जब हति ढालाबाला ङोलो भुइकिन राङ तोङबोङयि ध परिवर्तन हुन, तेहि याकार लेप्तु नाइरे खि हा:कुन। <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />धि च्वरा क्याइरे खि याङ जब धि ताम पोरो च्युच्युवा थोङिन, तेहि भेला कोयि धुनला धु नाइरे हा:कुवा कि। <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />तेम्बारे, ङा खेला नाज्याइ, कि धि पोरो पुरा होङ-होङ थु धि काल्बा मि तोरे मिढुवा। <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />तेङला राङ पिरथिवि स्यिक्ते ढुन, हिन्नाङ ङाहि वचन नामयाङ स्यिक्ते मिढुवा।”<verse eid="MAT 24:35" /></para>
  <para style="s">सुइ याङ हति ङिन राङ भेला हा: मिकुवा</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“हिन्नाङ हति ङिन राङ भेलायि भारेला आकि अर्थात स्यान सुलाङ च्याङ छ्या मेता, न त तेङलायि लोन खेरङानतेबा न कजसुबायि पिजाला। <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />मि पिजायि केयाप राङ नोआयि ङिन च्वरा होङान ना।<note caller="-" style="x"><char style="xo" closed="false">24:37 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">उत्पत्ति ६:५-८</ref> </char></note> <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />चिचालानाना च्हिरु क्याइरे श्यलले ताङला नोआ डुङगा छोम्मुवायि नाङला स्युभि ङिन थु, मितेबा सेन राङ, थुङिन राङ मिजे किन ताताता हुन, <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />तेहि श्यल लेप्ते हतिबाला पोरोला च्हारे माखेर थु हतिबे हा:माकुवा लो। मियि पिजा केयाप याङ हति च्वरा होङान ना।<note caller="-" style="x"><char style="xo" closed="false">24:39 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">उत्पत्ति ७:६-२४</ref> </char></note> <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />हति भेलाला मि ङि भारि राङ श्यिङला लाइ किङान होङान ना, च्यिते खेराङान ना राङ, स्यानते भोरङान ना। <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />पुमो ङि लाकोर कोरिन ताताता होङान ना, च्हि खेराङान ना, स्यानते भोरङान ना।”<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />“हतिचाला लाँरे त्योए, चिचालानाना काङ ङिन खि प्रभु हुन, सो खेला छ्या मेता। <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />हिन्नाङ धि हा:को कि खिमयि ताक्पोयि कुम्मा छाम्मुयि काङ भेलाला हुन हा:कुवा नाना, खो लाँरे राङ त्योएङान ना, राङ रेँ खिम तोल्दु झ्युङान मानाना।<note caller="-" style="x"><char style="xo" closed="false">24:43 </char><char style="xt" closed="false"><ref loc="LUK 12:39-40">लुका १२:३९-४०</ref> </char></note> <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />हतिचाला खे याङ तयार त्योए, चिचालानाना मि पिजा विचार माक्याइबि भेलाला होङान ना।”<verse eid="MAT 24:44" /></para>
  <para style="s">हिछे होएता यक्पुवा राङ हिछेमेते यक्पुवा</para>
  <para style="r">
    <ref loc="LUK 12:41-48">लुका १२:४१-४८</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“हिछेकिङान राङ बुद्धि होएता यक्पुवा सुना, काङला हति ताक्पोयि रेँ प्येरायि यक्पुवाबाला थारे भेलाला ङ्योप्पा पिनोङ नाइरे लाइ कोकोइबा हुनाइ? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />हति यक्पुवा ल ना, सुला ताक्पो हुइ तुइना हति च्वरा क्याक्याइबा ठेङान ना। <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />तेम्बारे, ङा खेला नाज्याइ, ताक्पोयि हतिला रेँ क्यु पोरोयि थोला जिम्मा क्यायाप धामङान ना। <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />हिन्नाङ तेम्बारे हति अल यक्पुवायि ‘ताक्पो पुला हुन नाइरे’ सम ला टान्ना, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />राङ ङ्याबो लाइ किङान यक्पुवातेबाला क्याक्तु राङ स्यिस्यिया ङ्याबो सारु राङ थुङाला छेल ना, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />हति यक्पुवायि ताक्पो हति माकुबि ङिन राङ विचार माक्याइबि ङिन होङान ना। <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />तेहि ताक्पोयि खोला तुबु-तुबु सोङान ना राङ हतिला समनाँतेबे उइला ढिमङान ना राङ, काँहा मितेबा ङुङान ना राङ सो चेङान ना।”<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="b" />
  <para style="s">मिजे माक्याइबा च्युयि प्ये</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />“तेहि तेङलायि राज्य च्यु मिजे माक्याइबा ङ्याबो थु ङ्युइकिन। हतिबे राँ राँसि बत्ति खेरते ख्योबोतेबा ठातु पुतेलो।<note caller="-" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="LUK 12:35">लुका १२:३५</ref> </char></note> <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />हतिबे नाङने ङाते रिक्पा मेता राङ ङाते रिक्पा होएता धुलो। <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />चिचालानाना जब रिक्पा मेतातेबे रेँ बत्ति खेरते, हतितुइना हतिबे ङ्याबो मोरकु माखेरालो। <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />हिन्नाङ रिक्पा होएतातेबे रेँ बत्ति ङ्याबो चुटिला मोरकु खेरतेलो। <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />तेहि ख्योबोति हुइतुइना पुला क्याइरे, हतिबा पोरो ङि सिरेलो राङ ङ्यालदेलो।”<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />“हिन्नाङ छान फेला ‘ख्योबो तोइ, खोला ठातु सअ,’ नाङानयि क्ये लेप्सोङ।”<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />“तेहि हति मिजे माक्याइबा पोरो पुमो लाँरेलो, राङ राँ राँसि बत्ति तयार सोइसोङ। <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />रिक्पा मेते मिजे माक्याइबि पुमोतेबे रिक्पा होएतातेबाला नाइसोङ, ‘खि मोरकुयि नाङने ङेला टिझि नाङ, चिचालानाना ङि बत्तिनि सिहाला छेलसोङ।’” <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />“हिन्नाङ रिक्पा होएतातेबे जु नेनगा जवाक पिनसोङ, ‘ङे राङ खे ङिकारला छाङयापयि होचोम मोरकु मेरो, बरु पसला तिया पुते राङ रेँ चाला ङ्योइ।’” <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />“हतिबा ङ्योरु ढुइतुइना ख्योबो लेप छारसोङ, राङ तयार होङानतेबा खो ङ्याबो मिजेयि भतयारला नाङला स्युसोङ, तेहि को रुपसोङ।” <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />“तेहि च्येला हति स्यान मिजे माक्याइबा पुमोतेबा हाङ लेप्सोङ राङ झु नाला छेलसोङ, ‘प्रभु-प्रभु, ङि चाला को फे!’”<note caller="-" style="x"><char style="xo" closed="false">25:11 </char><char style="xt" closed="false"><ref loc="LUK 13:25">लुका १३:२५</ref> </char></note> <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />“हिन्नाङ ख्युइ जवाक पिन्दे नाइसोङ, ‘तेम्बारे, ङा ख्योएला नाज्याइ, ङाहि ख्योएला ङोमिस्येबा।’” <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />येशुयि जवाक पिन्सोङ, “हतिचाला लाँरे त्योए, चिचालानाना हति ङिन राङ हति भेला खेला छ्या मेता।”<verse eid="MAT 25:13" /></para>
  <para style="s">यक्पुवा सुमयि प्ये</para>
  <para style="r">
    <ref loc="LUK 19:11-27">लुका १९:११-२७</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />“चिचालानाना हति भेलाते तेङलायि राज्य धि च्वरा धु, सु फियि देशला ढुइतुइना रेँ यक्पुवातेबाला रेँ क्यु सम्पत्ति हतिबाला जिम्मा टोते। <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />ख्युइ पोरोला रेँ झ्योदा होएता चोम चिला सेरयि सिक्का तोङ ङा, स्यानला सेरयि सिक्का तोङ ङि राङ स्यानला सेरयि सिक्का तोङ झि पिन्दे हति बाहिर देशला पुइ छारसोङ। <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />तेहि सेरयि सिक्का तोङ ङा खुङानति हतितुइना राङ पुते हति छोङला खोलदेलो राङ स्यान सेरयि सिक्का तोङ ङा कमाइ क्याइसोङ। <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />हति च्वरा क्याइरे सेरयि सिक्का तोङ ङि खुङानति याङ स्यान सेरयि सिक्का तोङ ङि कमाइ क्याइसोङ। <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />हिन्नाङ सेरयि सिक्का तोङ झि खुङानति पुते सा टुइरे रेँ ताक्पोयि क्यु भाइरे पोरसोङ।”<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />“लेइराङ भेलि च्येला हति यक्पुवातेबे ताक्पो लेप्तेलो, राङ ख्युइ हतिबाला च्हि लाँरेलो। <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />तेहि सेरयि सिक्का तोङ ङा खुङान यक्पुवाति स्यान सेरयि सिक्का तोङ ङा ख्योरे धुन्ना लेप्ते जु नाइसोङ, ‘हजुर, ख्युइ ङाला सिक्का ङाहि जिम्मा टोएसोङ। तोइया, ङाहि स्यान सेर सिक्का तोङ ङा कमाइ क्याइरे।’”<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />“ताक्पोयि हतिला नाइसोङ, ‘स्याबास, ल राङ हिछे होएते यक्पुवा! ख्योए टिजिला हिछे च्युङसोङ, ता ङा ख्योएला लेइराङयि जिम्मा टोच्याइ। ख्योए रेँ ताक्पोयि काकाला ढिक्ते त्योए।’”<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />“सेरयि सिक्का तोङ ङि खुङानति याङ लेप्ते नाइसोङ, ‘हजुर, ख्युइ ङाला सेरयि सिक्का तोङ ङि पिपिना होतो। तोइया, ङाहि स्यान सिक्का ङि कमाइ क्याक्याइबा होतो।’” <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />“हति ताक्पोयि हतिला नाइसोङ, ‘स्याबास, ल राङ हिछे होएते यक्पुवा, ख्योए टिझि क्युला हिछे क्याइसोङ, ता ङा ख्योएला लेइराङ तामला जिम्मा टोच्याइ। ख्योए रेँ ताक्पोयि काकाला ढिक्ते त्योए।’”<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />“हति मि सुला सेरयि सिक्का तोङ झि खुरे हति लेप्ते नाइसोङ, ‘हजुर, माचुबि साने भालि तुइङान राङ माचुभि साने तुइङान ख्योए क्योङबो हिना नाङान ङाला छ्या होतो। <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />हतिचाला ङा झिसोङ, राङ पुते ख्युइ सिक्का ङाहि सायि नाङला कुँरे पोरते। तोइ, धि ख्युइ सिक्का।’”<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />“हति ताक्पोयि हतिला जवाक पिन्देलो, ‘ए सम अल, अल्छि यक्पुवा, मा चुबि साने भालि तुकिन राङ मातोरि साने रुकिन नाङान ख्योएला छ्या होतो नाना, <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />ख्युइ ङाहि क्यु छुक्पोयि तेहा भोर च्याइ मान, तेहि लेप्ते ङाहि ङारि क्यु ब्याज समेत क्याइरे लक्ते खुङान माने। <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />हतिचाला हतिने हति सिक्का झिते ठह, राङ सुला सिक्का च्यु धुइ हतिला पिन। <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />चिचालानाना सुला होतो हतिला धिले याङ महा तेरिन, राङ हतिला लेइराङ होङान ना। हिन्नाङ सुला मेता हतिला होएताते याङ ठङान ना।<note caller="-" style="x"><char style="xo" closed="false">25:29 </char><char style="xt" closed="false"><ref loc="MAT 13:12">मत्ति १३:१२</ref>; <ref loc="MRK 4:25">मर्कुस ४:२५</ref>; <ref loc="LUK 8:18">लुका ८:१८</ref> </char></note> <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />हति भेला थु फान मेते यक्पुवाला फिला मुन्नाला टिम, काँहा मितेबा ङुङान ना राङ सो चेङान ना।’”<note caller="-" style="x"><char style="xo" closed="false">25:30 </char><char style="xt" closed="false"><ref loc="MAT 8:12">मत्ति ८:१२</ref>; <ref loc="MAT 22:13">२२:१३</ref>; <ref loc="LUK 13:28">लुका १३:२८</ref> </char></note><verse eid="MAT 25:30" /></para>
  <para style="s">च्येस्युवा ल अल भेयापयि ङिन</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“जब मियि पिजा पोरो तेङलायि लोन खेरङान ङ्याबो रेँ छे धेकिन राङ होङान ना, तेहि खो रेँ छे तेतेकि क्याल ठिला त्योएङान ना।<note caller="-" style="x"><char style="xo" closed="false">25:31 </char><char style="xt" closed="false"><ref loc="MAT 16:27">मत्ति १६:२७</ref>; <ref loc="MAT 19:28">१९:२८</ref> </char></note> <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />राङ ख्युइ धुनला पृथिवियि मितेबा पोरो झोमङान ना, राङ च्हिरु क्याइरे रच्चियायि लु राङ राला भिन, हति च्वरा क्याइरे ख्युइ हतिबाला चिला स्यानने कुरु क्याइरे भेङान ना। <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />ख्युइ लुतेबाला रेँ याइ यहला, राङ रोरुतेबा योन यहला भोरङान ना।”<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />“तेहि क्यालबुइ रेँ याइ यहला होएतातेबाला नाङान ना, ‘सअ, ङाहि आकि च्यिनलाब होएता सअ! मुलुयि काल्बा छ्याबितुइने राङ खि चाला सोसोइबि राज्यला आङ कि। <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />चिचालानाना ङा टोपा ततबा होतो, खि ङाला ङ्योप्पा पिनसोङ। ङा खा कोकोमा होतो, खि ङाला थुङयापयि चाला छ्यु पिन्सोङ। ङा फि देशयि मिना, खि ङाला ढोम्बोला पोरसोङ। <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />चेपटाका होतो, खि ङाला कोहिला कापसोङ। नाप्पा होतो, खे ङाला तारु लेप्सोङ। झ्यालला होतो, खे ङाहि तेहा लेप्सोङ।’” <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />“तेहि केवाकिङानतेबे खोला जवाक नाइसोङ, ‘हे प्रभु, जब ङि ख्योएला टोपा ततबा थोङदे, राङ सायाप पिन्दे? अर्थात खा कोकोमा थोङदे, राङ थुङयापयि चाका छ्यु थुङयापयि चाला पिन्दे? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />जब ङि ख्योएला फियि मि थोङदे, राङ ख्योएला खिमला ढोम्बोला पोरते? अर्थात चेपटाका थोङदे राङ कोहिला कापते? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />राङ जब ङि ख्योएला नाप्पा राङ झ्यालला थोङदे, राङ ख्युइ तेहा तारु लेप्ते?’” <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />“तेहि क्यालबुइ हतिबाला जवाक पिन्दे नाङान ना, ‘तेम्बारे, ङा खेला नाज्याइ, खि धि ङाहि भाइबे नाङने पोरोले छ्युवा च्यिला चोम क्याइ, हति खि ङाला राङ क्याक्याइबा ना।’”<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />“हति च्येला ख्युइ योन यहयि मिला नाङान ना, ‘छार चुचुबि मिबा! घ्याबोला क्यु, राङ तुइ राङ हति लोन खेरङानयि चाला तयार सोसोइबि नामयाङ मिस्यिङानयि मेला क्यु। <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />चिचालानाना ङा टोपा ततबा होतो, खि ङाला ङ्योप्पा मापिनसोङ। खा कोकोमा होतो, खि ङाला थुङयापयि चाला छ्यु मापिन्सोङ। <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />ङा फि मि हिना, खि ङाला खिमला ढोम्बोला मा पोरसोङ। चेपटाका होतो, राङ खि ङाला कोहिला माकापसोङ, नाप्पा राङ झ्याल्ला होतो, राङ खे ङाला तारु मालेप्सोङ।’”<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />“हतिबे याङ झु नेनगा जवाक तेराङन ना, ‘प्रभु, जब ङि ख्योएला टोपा ततबा वा खा कोकोमा थोङदे, फि मि या चेपटाका वा नाप्पा थोङदे, वा झ्याल्ला थोङदे, राङ ख्युइ स्यापच्यि मा स्युइबा?’” <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />“तेहि ख्युइ हतिबाला जवाक तेराङान ना, ‘तेम्बारे ङा खेला नाज्याइ, धिबा पोरोले टिमातेबे नाङने चिला चोम कियापना माक्याइ, हति खि ङाहि चाला माक्याइबा।’”<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />“तेहि हतिबा बारतैयि चाला ङेबायि भागेदार होङान ना, ‘हिन्नाङ केवाकिङानतेबा जबयाङ मिसिनयापयि किप्पोयि मिजेला स्युङान <note caller="-" style="x"><char style="xo" closed="false">25:46</char><char style="xt" closed="false"><ref loc="DAN 12:2">दानिएल १२:२</ref> </char></note>ना।’”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">येशुला विरोधला छल</para>
  <para style="r">
    <ref loc="MRK 14:1-2">मर्कुस १४:१-२</ref>; <ref loc="LUK 22:1-2">लुका २२:१-२</ref>; <ref loc="JHN 11:45-53">युहान्ना ११:४५-५३</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />येशुयि धि ताम पोरो नाइ छारते च्येला खुरि लोब्टुबाला नाइसोङ, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“खेला छ्या होतो, तिरिङ यि ङिन ङि च्येला निस्तार कालापसोल हुन, तेहि मि पिजाला क्रुसला धयापयि चाला सुङान ना।”<note caller="-" style="x"><char style="xo" closed="false">26:2 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">प्रस्थान १२:१-२७</ref> </char></note> <verse eid="MAT 26:2" /><verse number="3" style="v" sid="MAT 26:3" />तेहि कैयाफा मिन क्याक्याइबि घोबा पुजारि क्यालखाङला जनतायि केवाकिङान गुरुतेबा झोमसोङ। <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />राङ हतिबे येशुला च्हिरु ल्यायिरे सुङयाप राङ स्योएयापयि च्युइ क्याइसोङ। <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />हिन्नाङ हतिबे नाइसोङ, “कालापसोलयि भेलाला माना।” स्यान अर्थात मितेबे उइला ठुझि होङान ना।<verse eid="MAT 26:5" /></para>
  <para style="s">येशुला बेथानियाला घोबोला अत्तर कुकुइबा</para>
  <para style="r">
    <ref loc="MRK 14:3-9">मर्कुस १४:३-९</ref>; <ref loc="JHN 12:1-8">युहान्ना १२:१-८</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />येशु बेथानियाला सिमोन लाक्पा काकामि नाझा होएता खिमला धु, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />पुमो झि च्हुटि शिशाला नाङला घोङ छेया अत्तर खेरते ख्युइ तेहा लेप्सोङ, राङ खो सेतुइना मुइ हति ख्युइ घोबोला च्योसोङ।<note caller="-" style="x"><char style="xo" closed="false">26:7</char><char style="xt" closed="false"><ref loc="LUK 7:37-38">लुका ७:३७-३८</ref> </char></note> <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />धि थोङदे लोब्टुबाला सेताङ लासोङ, राङ हतिबाला नाइसोङ, “च्हि चाला झोम मासि सुन? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />चिचालानाना धि अत्तर घोङ छेयाला च्हरे हति आलाइ टाङनाबाला तेरयाप हुन।” <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />हिन्नाङ येशुयि धि ताम हा:कोरे हतिबाला नाइसोङ, “खे धि पुमोला चिला तुक्का तेरिन? मुइ ता ङाहि चाला लाइ ल क्याइसोङ। <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />चिचालानाना टाङनाबा खे ङ्याबो बारतै हुन। हिन्नाङ ङा खे ङ्याबो बारतै मिहा।<note caller="-" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="DEU 15:11">व्यवस्था १५:११</ref> </char></note> <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />मुइ धि अत्तर ङाहि स्हुला च्योरे कुङयापयि चाला ङाला तयार सोसोइबा ना। <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />तेम्बारे, ङा ख्योएला नाज्याइ, पोरो संसारला काँहा धि लोन ल टाइक्ये हुन, धि पुमोयि च्हि क्याइरे हति टाइक्ये मुइ याकि चाला किङान ना।”<verse eid="MAT 26:13" /></para>
  <para style="s">यहुदा येशुला धोका तेरयापयि चाला खाला ङ्यानसोङ</para>
  <para style="r">
    <ref loc="MRK 4:10-11">मर्कुस ४:१०-११</ref>; <ref loc="LUK 22:3-6">लुका २२:३-६</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />तेहि लोब्टु च्युनङियि नाङने च्यि यहुदा इस्करियोत नाङानते घोबा पुजारियि तेहा पुइसोङ, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />राङ नाइसोङ, “तेम्बारे ङाहि खोला येशुला लाक्पाला स्येना, ङाला च्हि तेच्याइ?” हतिबे खोला ङुलयि सिक्का सुम च्यु पिन्देलो। <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />हति भेलाने यहुदायि खोला सुङयापयि मौका पाताला छेलसोङ।<verse eid="MAT 26:16" /></para>
  <para style="s">येशुयि लोब्टुबा ङ्याबो निस्तार कालापसोङ सोइसोङ</para>
  <para style="r">
    <ref loc="MRK 14:12-26">मर्कुस १४:१२-२६</ref>; <ref loc="LUK 22:7-23">लुका २२:७-२३</ref>; <ref loc="MRK 13:21-30">मर्कुस १३:२१-३०</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />ता अखमरियि लोटायि कालापसोलयि ताङसह ङिन लोब्टुबे येशुयि तेहा लेप्ते नाइसोङ, “ख्युइ चाला निस्तार कालापसोलयि भतयार सायापयि व्यवास्था ङि तेहा किता?” <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />ख्युइ नाइसोङ, “भजारला मि झिकि तेहा ढो, राङ हतिला नोइ ‘गुरुज्यु नेन दु, ङाहि भेला धुन्ना लेलेबा धु। ङा ङारि लोब्टुबा ङ्याबो ख्युइ खिमला निस्तार कालापसोल मानि किच्याइ।’” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />तेहि येशुयि आदेश अनुसार लोब्टुबे क्याइसोङ राङ हतिबे निस्तार कालापसोलयि चाला तयार क्याइसोङ।<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />कमु च्युङदे खो च्युनङि गार लोब्टु ङ्याबो ङ्योप्पा सारु तेसोङ। <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />हतिबा सेन तातितुइना ख्युइ नाइसोङ, “तेम्बारे, ङा खेला नाज्याइ, खि नाङने चिकि ङाला टायि सुङदु जुङान ना।” <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />तेहि हतिबा लेइराङ सम अल च्युङदे चिकि च्येला च्हि खोला ढियाला छेलसोङ, “प्रभु, च्हि हति ङा हिनाइ?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />तेहि ख्युइ नाइसोङ, “सुइ ङा ङ्याबो तेरमाला लोटा पिपिला होतो, हति राङ ङाला सुङदु झ्युङान ना।<note caller="-" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="PSA 41:9">भजनसंग्रह ४१:९</ref> </char></note> <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />मि पिजा ता ख्युइ भारेला पवित्रशास्त्रला टिटिबा च्वरा ढोङान ना। हिन्नाङ धिक्कार हति मिला। सुइ लाम्ला मि पिजा सुङदु झ्युङान ना। हति मिता माकेबा नाना हति मि चाला ल हुन।” <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />तेहि खोला सुङदु झुङान यहुदायि टिसोङ, “गुरुज्यु च्हि हति ङा हिनाइ?” ख्युइ हतिला नाइसोङ, “ख्योए-ख्योए राङ नेन्दु।”<verse eid="MAT 26:25" /></para>
  <para style="s">प्रभुयि भोज</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />हतिबा ङ्योप्पा सेन ताताताला येशुयि लोटा झि खेरसोङ राङ च्यिनलाब पिन छारते ख्युइ हति च्यासोङ राङ लोब्टुबाला पिनसोङ राङ नाइसोङ, “खेर, सो, धि ङाहि स्हु ना।” <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />तेहि याङ भोटो याङ खेरते कटिनक्या नाइरे ख्युइ हतिबाला जु नाइरे पिनसोङ, “खे पोरो धि नाङने थुङ। <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />चिचालानाना धि सारबा वाचायि ङाहि ठा ना, काङते लेइराङयि चाला तिक्पा माप कियापयि चाला क्युङान ना।<note caller="-" style="x"><char style="xo" closed="false">26:28 </char><char style="xt" closed="false"><ref loc="EXO 24:8">प्रस्थान २४:८</ref>; <ref loc="JER 31:31-34">यर्मिया ३१:३१-३४</ref> </char></note> <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />हिन्नाङ ङा खेला नाज्याइ, कि अंगुरयि धि ढेबुने ङा हति थु मि थुङ जब थु ङारि आकि राज्यला खे ङ्याबो सारबा अंगुरयि खुवा मिथुङ।” <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" />भजन झि लाँ छारते च्येला हतिबा जैतुन रिला यहला थोन्दे पुइसोङ।<verse eid="MAT 26:30" /></para>
  <para style="s">येशुयि पत्रुसयि इनकार ङन्सेखिखिला</para>
  <para style="r">
    <ref loc="MRK 14:12-26">मर्कुस १४:१२-२६</ref>; <ref loc="LUK 22:7-23">लुका २२:७-२३</ref>; <ref loc="JHN 13:21-30">युहान्ना १३:२१-३०</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />तेहि येशुयि हतिबाला नाइसोङ, “तिरिङ छाम्मु ङा चाला खे च्येला हटिकिङान ना। चिचालानाना पवित्रशास्त्राला धि च्वरा टिधु, ‘कजसुबा आके रच्चियाला क्याङान ना, राङ तुमयि लुबा कार च्युङ च्युङला थोराङान ना।’<note caller="-" style="x"><char style="xo" closed="false">26:31 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">जकरिया १३:७</ref> </char></note> <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />हिन्नाङ ङा स्यिस्यियाने सोम्बो च्युङदे खेले ताङला गालिल छेत्रला ढोङान ना।”<note caller="-" style="x"><char style="xo" closed="false">26:32 </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्ति २८:१६</ref> </char></note> <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />पत्रुसयि खोला जवाक पिनसोङ, “ख्युइ चाला पोरो च्येला हटि क्याइनाङ ङा ख्योएला नामयाङ मितोङ।” <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />येशुयि हतिला नाइसोङ, “तेम्बारे ङा ख्योएला नाज्याइ, तिरिङ छाम्मु च्याबो भोएयापले ताङला ख्युइ ङाला लाम्मा सुम ङोमिस्येबा नाइरे इनकार किङान ना।” <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />पत्रुसयि खोला नाइसोङ, “ङा ख्योए ङ्याबो सिकोइ च्युङ ना याङ ङाहि ख्योएला ङोमिस्येबा नाइरे इनकार मिके।” स्यान लोब्टुतेबे याङ हति च्वरा राङ नाइसोङ।<verse eid="MAT 26:35" /></para>
  <para style="s">येशुयि गेतसमनिला मोनलाम क्याक्याइबा</para>
  <para style="r">
    <ref loc="MRK 14:32-42">मर्कुस १४:३२-४२</ref>; <ref loc="LUK 22:39-46">लुका २२:३९-४६</ref></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />तेहि येशु गेतसमनि नाङान बगैचा साला हतिबा ङ्याबो पुइसोङ, राङ लोब्टुबाला नाइसोङ, “खे हतिया राङ त्योए, ङा टिझि फाला पुते मोनलाम क्याकच्याइ।” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />राङ ङ्याबो पत्रुस राङ जब्दियायि पिजा ङि पिजातेबाला खेरते खो बैरा राङ छरा किताला छेलसोङ। <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />तेहि ख्युइ हतिबाला नाइसोङ, “ङाहि उ तिङरिङमुवा बैरायि स्यिस्यिया च्वरा च्युङदु। राङ खे ङेहा राङ त्योए, ङा ङ्याबो लाँरे राङ त्योए।” <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />तेहि ख्युइ टिझि धुनला पुते खोलबु क्यापते मोनलाम क्यापसोङ, “हे ङाहि आके, च्युङना, धि भोटो ङाने घ्याबोला खेर। हिन्नाङ ङाहि धोप्पा क्याक्याइबा च्वरा माना, हिन्नाङ ख्युइ धोप्पा क्याक्याइबा च्वरा सअ।” <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />तेहि ख्युइ लोब्टुबे तेहा पुते हतिबा ङ्याङ्याला ठातेलो, राङ पत्रुसला नाइसोङ, “च्हि खे ङा ङ्याबो घण्टा चियाङ त्योए मिङ्युइबाइ? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />लाँरे त्योए, मोनलाम क्योप, राङ छोए ताताइबाला मायोङ। आत्मा ता तेम्बारे तयार होतोलो, हिन्नाङ स्हु नोप्पुवा धु।”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />याङ ख्युइ लाम्मा ङिबा पुते मोनलाम क्यापसोङ, “ङाहि आके, ङाहि धि तुरि भोटो मातुभि मिहा नाना ख्युइ धोप्पा पुरा सअ।” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />खो याङ लेप्ते हतिबा ङ्याङ्याला राङ धुलो, चिचालानाना हतिबे मि राराता राङ धुलो। <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />हतिचाला याङ ख्युइ हतिबा ताङदेलो, राङ पुते याङ हति छि राङ याङ लोलाइ क्याइरे लाम्मा सुबा मोनलाम क्यापसोङ।<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />तेहि खो लोब्टुबे तेहा लेप्ते हतिबाला नाइसोङ, “खे तरह ङ्याङ्याला राङ ङालसुन ताताता हिनाइ? तोइ, भेला धुनला लेप छारतु। मि पिजा तिक्पा किङानयि लाला थेबाला छेल छारतु। <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />लह, ढो। तोइ। ङाला सुङदु झ्युङान धुनला राङ धु।”<verse eid="MAT 26:46" /></para>
  <para style="s">येशुला सुसुवा</para>
  <para style="r">
    <ref loc="MRK 14:43-50">मर्कुस १४:४३-५०</ref>; <ref loc="LUK 22:47-53">लुका २२:४७-५३</ref>; <ref loc="JHN 18:3-12">युहान्ना १८:३-१२</ref></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />येशुयि नेन-नेन राङ, च्युनङियि नाङने च्हि, मदलब यहुदा मिन क्याक्याइबि लोब्टु लेप्सोङ। हति ङ्याबो घोबा पुजारि राङ जनतायि केवा किङान गुरु चाँचाँबि च्हि तुम छोम्मुवा झि तोरबालि राङ पेरका ख्योरे लेप्सोङ। <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />खोला सुङदु झुङान मितेबे हतिबाला ता झि पिन्देलो। “काङ मिला ङा पा च्योर च्याङ, हति राङ ना, हति राङला सुङ।”<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />होप:तामेला येशुयि तेहा पुते हति नाइसोङ, “हे गुरु नामास्ते!” राङ हति खोला पा च्यारसोङ।<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />येशुयि हतिला नाइसोङ, “रुवा, ख्योए च्हि कितु लेप्ते, हति कि।” तेहि हतिबा धुन्ना लेप्ते येशुला सुङदे खेरतेलो। <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />येशु ङ्याबो होएता नाङने च्हि कि लाक्पा च्युक्ते रेँ तोरबालि तोन्देलो, राङ घोबा पुजारियि यक्पुवाला क्याप सोङ, राङ हति नामज्यो तुप्सोङ। <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />तेहि येशुयि हतिला नाइसोङ, “ख्युइ तोरबालि धोपस्युप छ्यु। चिचालानाना तोरवालि खेराङान पोरो तोरवालिने राङ मासि हुन। <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />ख्योए च्हि ठानिकिन, च्हि ङा रेँ आकेला स्युवाक्या मिङ्युइबाइ, राङ ख्युइ हतितुइना राङ तेङलायि लोन खेरङान सिपाहिले किना मा ङाहि चाला मिचोवाइ च्हि? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />हिन्नाङ हति च्युङ छारते धि ताम धि च्वरा क्याइरे होङकोइ हुन नाइरे पवित्रशास्त्रला टिटिबि धि ताम च्हिरु क्याइरे पुरा हुन?” <verse eid="MAT 26:54" /><verse number="55" style="v" sid="MAT 26:55" />हति भेलाला राङ येशुयि हति मिझोमला नाइसोङ, “डाकुयि विरोध्रला लेलेबा च्वरा ङाला सुङदु तोरबालि राङ पेरका ख्योरे खे चिला लेप्ते? ङा बारतै मोनलाम क्यासि खिमला छोइ तेरिन राङ ताते, राङ खि ङाला मा सुङसोङ।<note caller="-" style="x"><char style="xo" closed="false">26:55</char><char style="xt" closed="false"><ref loc="LUK 19:47">लुका १९:४७</ref>; <ref loc="LUK 21:37">२१:३७</ref> </char></note> <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />हिन्नाङ ङोन्सेखिलङानयि पवित्रशास्त्रा पुरा होङ नाइरे राङ धि पोरो च्युच्युङाना।” तेहि लोब्टु पोरो खोला पोरते टोइरे पुइसोङ।<verse eid="MAT 26:56" /></para>
  <para style="s">यहुदियि नेतातेबा झोझोमि सायि धुनला येशु</para>
  <para style="r">
    <ref loc="MRK 14:53-65">मर्कुस १४:५३-६५</ref>; <ref loc="LUK 22:54-55">लुका २२:५४-५५</ref>,<ref loc="LUK 22:62-71">६२-७१</ref>; <ref loc="JHN 18:13-14">युहान्ना १८:१३-१४</ref>,<ref loc="JHN 18:19-24">१९-२४</ref></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />येशुला सुङानतेबे खोला घोबा पुजारि कैयाफायि तेहा खेरतेलो। हतिया शास्त्रि राङ केवाकिङान गुरुतेबा झोमधुलो। <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />हिन्नाङ पत्रुस घ्याबोने घोबा पुजारियि खिमयि क्य थु ख्युइ च्येच्येला लेप्तेलो, राङ च्येला च्हि हुन, सो तायापयि चाला नाङला स्युरे कोराबातेबा ङ्याबो त्येसोङ। <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />ता घोबा पुजारि राङ पोरो यहुदि नेतातेबा झोझोमि सायि मितेबे येशुला सोएयापयि ङेबा तेरयापला ख्युइ विरोधला चुन साछि फाताला छेलसोङ। <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />लेइराङ चुन साछि तेरङानतेबा लेप्सोङ, हिन्नाङ हतिबाला च्याङ साछि माखुबालो। च्येला मि ङि धुनला लेप्सोङ। <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />राङ नाइसोङ, “धि मियि ‘ङा कजसुबे मोनलाम क्यासि खिम तिप्ते ङिन सुमला याङ लोङ ङ्युइकिन’ नाइसोङ।”<note caller="-" style="x"><char style="xo" closed="false">26:61</char><char style="xt" closed="false"><ref loc="JHN 2:19">युहान्ना २:१९</ref> </char></note> <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />तेहि घोबा पुजारि लाँरे खोला नाइसोङ, “च्हि ख्योए च्याङ जवाक मितेराइ? धि मितेबे ख्युइ विरोधला साछि पिपिना चिना?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />हिन्नाङ येशु च्यामाना त्येसोङ। घोबा पुजारियि येशुयि नाइसोङ, “सोम्बो कजसुबायि मिनला ना क्यालदे नाज्याइ, ङेला नोइ, च्हि ख्योए कजसुबायि पिजा ख्रिष्ट हिनाइ?” <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />येशुयि हतिला नाइसोङ, “ख्युइ राङ नाइसोङ। हचु हिन्नाङ ङा ख्योएला नाज्याइ, ता याङ ख्युइ मियि पिजाला पोरो हा:छेयायि लाक्पा याइबा यहला ताताता राङ पान्नाङयि मुक्पि थोला लेलेबा थोङान ना।” <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />तेहि घोबा पुजारियि रेँ कोहिला रालदे नाइसोङ, “धि नि कजसुबाला अल नाइसोङ। ता हुला स्यान साछि च्हि कोइबा? थाल्ला ख्युइ धि कजसुबाला अल नानाइबा थोइ छारसोङ।<note caller="-" style="x"><char style="xo" closed="false">26:65 </char><char style="xt" closed="false"><ref loc="LEV 24:16">लेवि २४:१६</ref></char></note> <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />खि च्हि सम होतो?” हतिबे जवाक पिनसोङ, “खो अपराधि ना राङ सोएयापयि ङेबा होङयाप ना।” <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />तेहि हतिबे ख्युइ खाला छिमा तापते खोला भक्सिन क्यापसोङ, राङ रेन रेनयि जु नेन राङ थालच्या क्यापसोङ, <note caller="-" style="x"><char style="xo" closed="false">26:67 </char><char style="xt" closed="false"><ref loc="ISA 50:6">यशैया ५०:६</ref> </char></note> <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />“हे ख्रिष्ट, लौ, ङोन्सेखेन! ख्योएला क्याङान सु ना?”<verse eid="MAT 26:68" /></para>
  <para style="s">पत्रुसयि येशुला इनकार</para>
  <para style="r">
    <ref loc="MRK 14:66-72">मर्कुस १४:६६-७२</ref>; <ref loc="LUK 22:56-62">लुका २२:५६-६२</ref>; <ref loc="JHN 18:15-18">युहान्ना १८:१५-१८</ref>,<ref loc="JHN 18:25-27">२५-२७</ref></para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />पत्रुस फिला क्यला ताताता धुलो। यक्मुवा झि ख्युइ तेहा लेप्ते नाइसोङ, “ख्योए याङ गालिलला त्योएङान येशु ङ्याबो होतोइ?”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />हिन्नाङ पत्रुसयि हतिबा पोरोयि धुनला माना नाइरे नाइसोङ, “ख्योए च्हि नेन, ङाहि ङमिस्येबा।” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />खो फिला क्यला लेप छारते च्येला स्यान झिकि खोला थोङदे राङ हतिया होएतातेबाला नाइसोङ, “धि मि याङ येशु नासरि ङ्याबो धु।” <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />ख्युइ याङ ना क्यालदे माना नाइसोङ, “ङाहि हति मिला ङमिस्येबा।” <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />टिझि च्येला हतिया होएतातेबा धुनला लेप्ते पत्रुसला नाइसोङ, “तेम्बारे, ख्योए याङ हतिबे नाङने चिना, चिचालानाना ख्युइ ताम नाताने राङ हा:कुन्दु।” <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />तेहि पत्रुसयि खुरि खो राङला छार झुकिन राङ कजसुबायि ना क्येलाला छेलसोङ “ङाहि हति मिला ङोसे राङ मिसेबा।” तेहि हतितुइना राङ च्याबो पोइसोङ। <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />तेहि पत्रुसला येशुयि नानाइबि धि ताम याका च्युङसोङ, “च्याबो भोएयापले ताङला ख्युइ ङाला लाम्मा सुम थाबा माना नाङान ना।” तेहि खो फिला पुते मुन छुनछुन लेइराङ ङुइसोङ।<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">येशुला पिलातसयि तेहा खेखेरा</para>
  <para style="r">
    <ref loc="LUK 23:1-5">लुका २३:१-५</ref>,<ref loc="LUK 23:13-25">१३-२५</ref>; <ref loc="JHN 18:28-38">युहान्ना १८:२८-३८</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />नामजेन थरह, पोरो घोबा पुजारि राङ जनतायि केवाकिङान गुरुयि येशुला सोएयापयि ङेबा तेरयाप नाइरे खुइ विरोधला टोइ क्याइसोङ। <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />तेहि हतिबे खोला च्यालतायि ताम्दे खेरसोङ, राङ हाकिम पिलातसयि तेहा स्येसोङ।<verse eid="MAT 27:2" /></para>
  <para style="s">यहुदा स्यिस्यिया</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />तेहि खोला सुङदु झुङान यहुदायि ख्युइ थोला ङेबा पिपिना थोङदे घ्योप्पा क्याइसोङ, राङ घोबा पुजारि राङ केवाकिङान गुरुला ङुलयि सिक्का सुमच्यु लक्ते तेरयाप क्याइसोङ, <note caller="-" style="x"><char style="xo" closed="false">27:3 </char><char style="xt" closed="false"><ref loc="ACT 1:18-19">प्रेरित १:१८-१९</ref> </char></note> <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />राङ नाइसोङ, “ङाहि च्याङ माक्याइबि मिला धोका पिन्दे तिक्पा क्याइदु।” हिन्नाङ हतिबे नाइसोङ, “ङेला च्हि मदलब? त खो राङ सेङान धु।”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />तेहि हति ङुलयि सिक्का तेबा मोनलाम क्यासि खिमला टिम्दे यहुदा पुइसोङ, राङ हति झिङबाला थक्पा तारे रेँ राङला सेसोङ। <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />हिन्नाङ घोबा पुजारितेबे ङुलयि हति सिक्का तेबा खेरते नाइसोङ, “मोनलाम क्यासि खिमयि क्युनोर भोरसि बागासाला धि भोरयाप ल माना, चिचालानाना धि ठायि धोक्पो ना।” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />हतिबे नाङला रुताम क्याइरे हति आलाइयि फिमितेबा कुङसा कुमालयि सा ङ्योइसोङ। <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />हतिचाला हति साला तिरिङ थु ठायि सा नेन। <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />तेहि यर्मिया ङोन्सेखिलङानयि नानाइबि वचन पुरा च्युङसोङ, “हतिबे ङुलयि सिक्का सुमच्यु खेरसोङ, हति घोङयि धला, काङ घोङ इस्राएलयि पिजाबे हति थोला तोकि क्याक्याइबा होतो, <note caller="-" style="x"><char style="xo" closed="false">27:9 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">जकरिया ११:१२-१३</ref> </char></note> <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />राङ कजसुबायि ङाला आदेश च्युच्युका च्वरा कुमालयि सा ङ्योइरे।”<verse eid="MAT 27:10" /></para>
  <para style="s">पिलातसयि धुनला येशु</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />येशु रोमयि हाकिमयि पिलातसयि लाँसोङ, राङ हति येशुला टिसोङ, “च्हि ख्योए यहुदिबे क्याल:बो हिनाइ?” येशुयि नाइसोङ, “ख्योए राङ झु नेन धु।” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />तेहि घोबा पुजारिबा राङ केवाकिङान गुरुतेबे ख्युइ थोला दोष लाइ क्याइसोङ, हिन्नाङ ख्युइ च्याङ जवाक मापिनसोङ। <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />तेहि पिलातसयि खोला नाइसोङ, “ख्युइ विरोधला हतिबा च्युच्युङ कुच्युङ तामतेबे साछि तेरिन्दु, च्हि ख्युइ मिथोइबा धोए?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />हिन्नाङ येशुयि हतिला दोष चियि याङ जवाक मा पिनसोङ। हाकिम याङ धि तामला लेइराङ हा:लाइसोङ।<verse eid="MAT 27:14" /></para>
  <para style="s">येशुला स्यियापयि ङेबा तेरिन</para>
  <para style="r">
    <ref loc="MRK 15:6-15">मर्कुस १५:६-१५</ref>; <ref loc="LUK 23:13-25">लुका २३:१३-२५</ref>; <ref loc="JHN 18:38">युहान्ना १८:३८</ref>; <ref loc="JHN 19:16">१९:१६</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />निस्तार कालापसोङला मिझोमयि धोप्पा क्याक्याइबा च्वरा रोमयि हाकिमयि झ्याल ला तितिबा झिला तोङयापयि लुलाम होतोलो। <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />हति भेलाला बारब्बा मिन क्याक्याइबि च्हि टाइक्ये छ्योएछयोएति कैदि झि होतोलो। <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />जब मितेबा झोमदे, पिलातसयि हतिबाला टिरेलो, “खे च्हि धोप्पा किन? ङा खि चाला सुला तोङज्याइ? बारब्बा कि ख्रिष्ट नाङान येशुला?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />चिचालानाना यहुदिबे आङकिङानबे येशुला ठाधोयि राङ स्यास्याता ना नाइरे पिलातसला छ्या होतोलो।<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />तेहि अदालत भेसाला तोतितुइना पिलातसयि केरमानयि झु नाइरे लोन कुरसोङ, “हति-हति केवाकिङान मिला च्याङ माके, चिचालानाना तेरिङ मिलामला ख्युइ चाला ङाहि लेइराङ तुक्का ङ्योङ्योङा होए।” <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />हिन्नाङ घोबा पुजारि राङ केवाकिङान गुरु बारब्बा तोङयाप राङ येशुला ङेबा तेरयापयि माग क्याइरे मितेबाला हुइ:स्युइ लाङसोङ। <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />रोमि पिलातस हाकिमयि याङ खोला टिरेलो, “धि ङि नाङने काङते ङा खि चाला तोङ ज्याइ नाइरे खे धोप्पा किन?” हतिबे नाइसोङ, “बारब्बाला।” <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />पिलातसयि हतिबाला नाइसोङ, “ता ङा ख्रिष्ट नाङान येशुला ङा च्हि किच्याइ?” हतिबा पोरोयि खोला जवाक पिन्दे नाइसोङ, “हतिला क्रुसला थह। <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />पिलातसयि नाइसोङ, चिला? ख्युइ च्हि नोनोबि लाइ क्याइदुइ?” हिन्नाङ हतिबा याङ धिले याङ क्ये छेया क्याइरे नाइसोङ, “हति क्रुसला थ्ह।” <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />हिन्नाङ च्याङ च्युइ माचुवा थोङदे, ठुझि हुन नाइरे झिरे पिलातसयि छ्यु खेरते मितेबे धुन्नला रेँ लाक्पा टुइरे नाइसोङ, “खे-खे राङ हा:कुवा कि, ङा धि मियि ठा: थोङ्दे निर्दोष होतो।” <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />मि पोरोयि जवाक पिनसोङ, “येशु सासाति ठा ङे राङ ङि सन्तनबे थोला फ।” <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />तेहि पिलातसयि हतिबे चाला बारब्बाला ताङदेलो, हिन्नाङ येशुला छेरमा क्यापते सिपाहिला क्रुसला धोयापला स्यातेलो।<verse eid="MAT 27:26" /></para>
  <para style="s">सिपाहि तेबे येशुला चेचेता</para>
  <para style="r">
    <ref loc="MRK 15:16-20">मर्कुस १५:१६-२०</ref>; <ref loc="JHN 19:2-3">युहान्ना १९:२-३</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />तेहि पिलातस सिपाहितेबे येशुला क्याल:खाङला खेरतेलो, राङ सिपाहिबा पोरोला ख्युइ धुन्नला झोम्दु च्युक्तेलो। <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />हतिबे ख्युइ कोहिला पुते खोला मोरु कोहिला कापसोङ। <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />हतिबे छेरमि टोपो चेम्दे ख्युइ घोबोला कापसोङ, राङ ख्युइ लाक्पा याइबा यहला ङ्युमा पिन्देलो, राङ ख्युइ धुनला काङबा चुरे खोला जु नेन राङ नाचेसोङ, “हे यहुदियि क्यालबो, छेरिया त्योए।” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />तेहि हतिबे खोला छिमा ताप्तेलो, राङ ङ्युमा खेरते खोला घोबोला क्यापसोङ। <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />ख्युइ नाचेछारते च्येला हतिबे हति कोहिला पुतेलो, राङ ख्युइ रेँ कोहिला काप्ते खोला क्रुसला धतु खेरसोङ।<verse eid="MAT 27:31" /></para>
  <para style="s">येशुला क्रुसला ताताबा</para>
  <para style="r">
    <ref loc="MRK 15:21-32">मर्कुस १५:२१-३२</ref>; <ref loc="LUK 23:26-43">लुका २३:२६-४३</ref>; <ref loc="JHN 19:17-27">युहान्ना १९:१७-२७</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />ढुनढुन हतिबे सिमोन मिन क्याक्याइबि कुरेनि भजारयि मिझिला ठातेलो, राङ हतिबे खोला ख्युइ क्रुस खुरयापला कर क्याइसोङ। <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />जब हतिबा गलगथा नाङान साला क्योपतेलो, काङला कबलियि सा नेन लो, <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />तेहि हतिबे खोला खाडे स्येस्येबि छ्याङ थुङदु च्युसोङ, हिन्नाङ ख्युइ छोए ताइरे ख्युइ थुङयापयि धोप्पा क्याइसोङ।<note caller="-" style="x"><char style="xo" closed="false">27:34 </char><char style="xt" closed="false"><ref loc="PSA 69:21">भजनसंग्रह ६९:२१</ref> </char></note> <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />हतिबे येशुला क्रुसला तारे च्येला, चिट्टा क्यापते ख्युइ कोहिलातेबा रेँ नाङला कोहिरेलो। <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />तेहि हतिबा हतिया ताते खोला स्युङाला छेलसोङ। <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />“येशु, यहुदिबे क्याल:बो नाङान ख्युइ विरोधयि दोष पत्र ख्युइ घोबुइ थोला च्यारसोङ।” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />खो ङ्याबो डाकु ङि क्रुसला ताताबा धुलो, च्हि ख्युइ याइ यहला राङ स्यानते योन यहला। <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />हतिने होङान ढोङानतेबे राँ राँसि झिङबा स्युरे ख्युइ ना च्येसोङ, <note caller="-" style="x"><char style="xo" closed="false">27:39 </char><char style="xt" closed="false"><ref loc="PSA 22:7">भजनसंग्रह २२:७</ref>; <ref loc="PSA 109:25">१०९:२५</ref> </char></note> <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />राङ नाइसोङ, “ए मोनलाम क्यासि खिम तिपङान राङ ङिन सुमला लोङान, राङला क्योप, राङ कजसुबायि पिजा हिन्ना, क्रुसने पुप्ते हअला सआ।”<note caller="-" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="MAT 26:61">मत्ति २६:६१</ref>; <ref loc="JHN 2:19">युहान्ना २:१९</ref> </char></note> <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />हति च्वरा क्याइरे घोबा पुजारितेबे याङ शास्त्रितेबे राङ केवा किङान गुरुबा ङ्याबो-ङ्याबो ख्युइ ना च्योकिन राङ नाइसोङ, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“हति स्यान ता क्योपसोङ, ‘खो राङला क्योप माङ्युइ सोङ। धि इस्राएलयि क्याल:बो हिनाइ। थाल्ला क्रुसने माला पाप्ते सअ, राङ ङे धिला हिछे किच्याइ। <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />धि कजसुबाला हिछे भोरकिन। कजसुबे धिला धोप्पा क्याइना ख्युइ धिला थाल्ला राङ तोङिन राङ, चिचालानाना धि ङा कजसुबे पिजा ना,’ नाइरे नेन्दु।”<note caller="-" style="x"><char style="xo" closed="false">27:43 </char><char style="xt" closed="false"><ref loc="PSA 22:8">भजनसंग्रह २२:८</ref> </char></note> <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />तेहि खो ङ्याबो क्रुसला ताताबि हति डाकुतेबे याङ हति च्वरा क्याइरे ख्युइ नाच्येसोङ।<verse eid="MAT 27:44" /></para>
  <para style="s">येशु स्यिस्यिया</para>
  <para style="r">
    <ref loc="MRK 15:33-41">मर्कुस १५:३३-४१</ref>; <ref loc="LUK 23:44-49">लुका २३:४४-४९</ref>; <ref loc="JHN 19:28-30">युहान्ना १९:२८-३०</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />तेहि ङिमा फेयि बाह्र बजेने तिन बजे थु देश पोरोला राङ मुन्ना च्युङसोङ। <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />तिन बजे झोमला येशुयि जु नेन राङ क्ये तोनसोङ, “इलोइ, इलोइ, लामा सबखथनि?” मदलब, “हे ङाहि कजसुबा, हे ङाहि कजसुबा, ख्युइ ङाला चिला ताङदे?”<note caller="-" style="x"><char style="xo" closed="false">27:46 </char><char style="xt" closed="false"><ref loc="PSA 22:1">भजनसंग्रह २२:१</ref> </char></note> <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />हतिया लाँलाँबाबे नाङने चोमयि धि थोहिरे नाइसोङ, “धि मि एलियाला क्ये तोङिनदु।” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />हतिबे नाङने च्हि होप्तामेला स्युइते पुइसोङ च्हि कपासला खेरते खाडे खुवाला पिल्दे ङ्युमाला पोरते खोला थङदु च्युसोङ।<note caller="-" style="x"><char style="xo" closed="false">27:48 </char><char style="xt" closed="false"><ref loc="PSA 69:21">भजनसंग्रह ६९:२१</ref> </char></note> <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />हिन्नाङ ल्हामातेबे नाइसोङ, “ता, अर्थात एलिया खोला क्योपतु लेबोङ कि?” <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />तेहि याङ येशु क्ये छ्येया क्याइरे क्ये तोन्सोङ राङ रेँ उ च्येसोङ। <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />हति भेलाला राङ मोनलाम क्यासि खिमयि तन्ना टुपुने स्याम थु भाग ङि च्युङदे रालसोङ, राङ सा धाराला छेलसोङ राङ टातेबा छ्यासोङ।<note caller="-" style="x"><char style="xo" closed="false">27:51 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">प्रस्थान २६:३१-३३</ref> </char></note> <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />तुरसातेबा लाँरे लेप्सोङ, राङ ङ्याङ्यालि लेइराङ कजसुबायि पवित्र मि स्यिस्यियायि स्हु सोम्बो च्युङदे लाँसोङ, <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />राङ हतिबा तुरसाने थोन्देलो राङ स्यिस्यियाने येशु सोम्बो ला छारते च्येला हतिबे पवित्र भजारला स्युरेलो राङ लेइराङयि तेहा थोङदे। <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />जब घोबा राङ खो ङ्याबो येशुला ताङान सिपाहितेबे साघुल राङ हतिया च्युच्युङि घटना थोङदे, तेहि लेइराङ झिटा च्युङदे हतिबे जु नाइसोङ, “तेम्बारे, धि कजसुबायि पिजा हिना।” <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />हतिया गालिलने लेलेबा लेइराङ पुमो याङ धुलो, हतिबा घ्याबोने धि पोरो तेन ताताता धुलो। हतिबा खोला स्यापच्यि स्युन राङ गालिलने राङ येशुयि च्येच्येला लेलेबा हिना।<note caller="-" style="x"><char style="xo" closed="false">27:55 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">लुका ८:२-३</ref> </char></note> <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />हतिबे नाङने मरियम मग्दलिनि, राङ याकुब राङ योसेफयि आमा मरियम, राङ जब्दियायि पिजायि आमाते याङ धुलो।<verse eid="MAT 27:56" /></para>
  <para style="s">येशु कुकुबा</para>
  <para style="r">
    <ref loc="MRK 15:42-47">मर्कुस १५:४२-४७</ref>; <ref loc="LUK 23:50-56">लुका २३:५०-५६</ref>; <ref loc="JHN 19:38-42">युहान्ना १९:३८-४२</ref></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />कमु च्युङ छारते अरिमाथिया भजारयि योसेफ मिन क्याक्याइबि मि छ्युक्पो झि लेप्सोङ। खो खोराङ येशुयि लोब्टु हिना। <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />ख्युइ पिलातसयि तेहा पुते येशुयि स्यिस्यियायि स्हु लाँसोङ, राङ पिलातसयि खोला तेरयापयि आदेश च्युसोङ। <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />योसेफयि स्यिस्यियायि स्हु खेरते मलमलयि चाङमा कोहिलायि ताम्देलो। <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />राङ ख्युइ टाला सारबा कोहिरे सोसोइबा तुरसातेला हति पोरते, राङ तुरसायि खाने टोउ छोम्मुवा झि कापसोङ, राङ खो पुइसोङ। <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />तुरसायि धुनला मरियम मग्दलिनि राङ स्यान मरियम याङ ताताता धुलो।<verse eid="MAT 27:61" /></para>
  <para style="s">तुरसला कोराबा</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />ङाइटोतेला, अर्थात छेलयापयि ङिनयि ङाहिटोतेला, घोबा पुजारि राङ फरिसिबा पिलातसयि तेहा पुतेलो। <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />राङ नाइसोङ, “हजुर, ङहेला टाम्बा होतो, कि फट्टियि सोम्बो होतोला, ङिन सुम च्येला ङा याङ लाँरे होङज्याइ नाइसोङ।<note caller="-" style="x"><char style="xo" closed="false">27:63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">मत्ति १६:२१</ref>; <ref loc="MAT 17:23">१७:२३</ref>; <ref loc="MAT 20:19">२०:१९</ref>; <ref loc="MRK 8:31">मर्कुस ८:३१</ref>; <ref loc="MRK 9:31">९:३१</ref>; <ref loc="LUK 9:22">लुका ९:२२</ref>; <ref loc="LUK 18:31-33">१८:३१-३३</ref> </char></note> <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />हतिचाला ङिन सुम थु हति तुर च्याङ होङदु माच्युका भोरयापला आदेश पिन, स्यान मान्ना हति लोब्टुबा लेप्ते हति कुइरे खेरोङ, राङ ‘हतिता स्यिस्यियाने सोम्बो च्युङदे लाँदु’ नाइरे मितेबाला नाङान ना, राङ हति च्येमे धोका ताङमाले याङ अल होङान ना।”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />पिलातसयि हतिबाला नाइसोङ, “खे खिरि कोराबा होएराङ धु। क्यु, खि चोम ङ्युइ हतिबाला च्याङ होङदु माझ्यु।” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />तेहि हतिबा पुते टोउला छाप क्यापसोङ, राङ कोराबातेबा लाइ कोइरे तुरसा सुङदे पोरसोङ।<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">स्यिस्यियाने येशु याङ सोम्बो च्युङदे लाँलाँबा</para>
  <para style="r">
    <ref loc="MRK 16:1-11">मर्कुस १६:१-११</ref>; <ref loc="LUK 24:1-12">लुका २४:१-१२</ref>; <ref loc="JHN 20:1-18">युहान्ना २०:१-१८</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />ङालसुइ ङिनयि च्येला, हप्तायि ङिमा ताङसह च्याबो ताङमे तुइना मरियम मग्दलिनि राङ स्यान मरियम तुरसा तारु लेप्सोङ। <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />साघुल छेया झि लेप्सोङ, चिचालानाना कजसुबायि तेङलायि लोन-लोन खेरङान झि लायुने हअला लेप्सोङ, राङ लेप्ते टोउ फाला क्याइरे हति थोला त्येसोङ। <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />हति च्ये बत्ति च्वरा राङ कोहिला खा: च्वरा कारबो धुलो। <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />खोला झिरे हति कोराबातेबा थरथर धारतेलो, राङ स्यिस्यिया च्वरा च्युङसोङ। <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />हिन्नाङ तेङलायि लोन खेरङानति हति पुमोला नाइसोङ, “खे माझि, चिचालानाना ङाला छ्या होतो, खे क्रुसला ताताबि येशुला फातु लेलेबाना। <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />खो ङिहा मेता, चिचालानाना ख्युइ नानाइबा च्वरा खो सोम्बो च्युङदे लाँलाँबा होतो। सअ, ख्युइ स्यिस्यियायि स्हु पोपोरि साला तोइ। <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />तेहि घ्यबो पुते ख्युइ लोब्टुबाला लोन पिन, कि खो स्यिस्यियाने सोम्बो च्युङदे लाँ छारतु, राङ खो खेले ताङला गालिलला ढुनत्येतु। खि खोला हतिया थोङान ना। टाम्बा कि, ङाहि खेला नाइछारते।” <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />तेहि हतिबा झिटा राङ केनराङ होप्तेमेला तुरने थोन्दे पुइसोङ, राङ ख्युइ लोब्टुबाला लोन नारु स्युरतेलो। <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />हो:प्तामेला येशु हतिबाला ठाते नाइसोङ, “शान्ति!” हतिबा धुन्ना लेप्ते ख्युइ काङबा सुङदे छ्या पुलसोङ। <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />तेहि येशुयि खोला नाइसोङ, “माझि, पुते ङाहि भाइबाला गालिलला क्यु नोइ, राङ हतिया हतिबे ङाला थोङान ना।”<verse eid="MAT 28:10" /></para>
  <para style="s">कोराबायि लोन</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />जब हति पुमोतेबा लामला ढुन ताताता होतो, रेन-रेन कोराबातेबा भजारला पुते घोबा पुजारिबाला हतिया च्युच्युङि घटनायि भारेला लोन पिन्सोङ। <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />जब घोबा पुजारिबा धर्म गुरुबा ङ्याबो झोम्दे त्येसोङ, हतिबे रुताम क्याइसोङ राङ सिपाहिबाला झु नेनगा लेइराङ आलाइ पिनसोङ, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />“खे नोइ कि ‘ङे ङ्याङ्याला ला हति लोब्टुबा लेप्ते हतिला कुइरे खेरतु।’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />माचुङना रोमि आङकिङान यि नामज्योला धि ताम क्योपना, ङि खोला घोकोरते खेला क्ययोप च्याइ।”<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />तेहि कोराबातेबे आलाइ खेरसोङ, राङ लालाबा च्वरा क्याइरे लो, राङ यहुदिला थाल्लि ङिन थु धि ताम राङ टाइक्ये च्युच्युङा होतोलो।<verse eid="MAT 28:15" /></para>
  <para style="s">छ्येस्युवा आदेश</para>
  <para style="r">
    <ref loc="MRK 16:14-18">मर्कुस १६:१४-१८</ref>; <ref loc="LUK 24:36-49">लुका २४:३६-४९</ref>; <ref loc="JHN 20:19-23">युहान्ना २०:१९-२३</ref>; <ref loc="ACT 1:6-8">प्रेरित १:६-८</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />हति लोब्टु च्युचि गार गालिलयि हति सुरकाला पुतेलो, क्हा येशुयि हतिबाला ढोयापयि लोन पिपिना होतोलो।<note caller="-" style="x"><char style="xo" closed="false">28:16 </char><char style="xt" closed="false"><ref loc="MAT 26:32">मत्ति २६:३२</ref>; <ref loc="MRK 14:28">मर्कुस १४:२८</ref> </char></note> <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />हतिबे खोला थोङदे छ्या पुलसोङ, हिन्नाङ हतिबा रेनयि शङ्का क्याइसोङ। <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />तेहि येशु हतिबे तेहा पुते नाइसोङ, “तेङला राङ पिरथिवि पोरो आङ ङाला पिपिना होतो। <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />हतिचाला क्यु, राङ पोरो देशयि मितेबाला लोब्टु सोइ, आके पुत्र राङ पवित्र आत्मायि मिनला हतिबाला बप्तिस्मा पिन, <note caller="-" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 1:8">प्रेरित १:८</ref> </char></note> <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />ङाहि खेला आदेश च्युच्युकि पोरो ताम पालना कियाप हतिबाला लोप। ङा काल्बा सिनसिन थु बारतै खे ङ्याबो होङान ना।”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>