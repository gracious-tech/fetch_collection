<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Tichurong</book>
  <para style="toc1">फिलेमोन</para>
  <para style="toc2">फिलेमोन</para>
  <para style="toc3">फिलिमोन</para>
  <para style="mt2">पावलले फिलिमोनलाइ लेखेको पत्र</para>
  <para style="mt1">पावलयि फिलिमोनला टिटिबि पत्र</para>
  <para style="imt">किताबयि ङोस्ये</para>
  <para style="ip">फिलिमोनयि किताब तुइमा लोब्टु पावलने टिटिबा हिनालो <char style="xt"><ref loc="PHM 1:1">१:१</ref> </char>पावल झ्याल्ला होतोलो नाम ख्युइ धि टिरे, काङति तोन हिनालो कि ख्युइ धि रोमने टिरेलो। तेम्बारे खो रोमला होतो नाना धि ख्रिष्ट क्येयापले ताङला हा:लामलो ६१ च्येला टिटिबा हिनालो, काङते ख्युइ कलसियनतेबाला टिटिबि भेला ना। ख्युइ धि पत्र फिलिमोन मि क्याक्याइबि मितेला टिरेलो। फिलिमोन चर्चयि दास राङ ताक्पो याङ हिनालो। पावलयि फिलिमोन टोइरे पुपुता खुरि दास ओनासिमसला ङेबा मितेर नाइरे ढियापला याङ धि पत्र टिरेलो। रोमियि ठिम च्वरा क्याइना फिलिमोनला ओनिसिमसला सोएयापयि ङेबा तेरयापयि आङ होतोलो। अनोसिमसला क्रिस्तिच्यन भाइयि धोला हिना नाइरे खाला ङ्यानयापला फिलिमोनला समस्यु तेरयापला पावलयि कोशिश पोरो खोकिनलो राङ ओनेसिमसला पावल ङ्याबो स्यापच्यि स्युयापला आङ तेरतु याङ सुझाप तेरिनलो। <char style="xt"><ref loc="PHM 1:13-14">१:१३-१४</ref></char></para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">पावलयि फिलिमोनला <char style="xt"><ref loc="PHM 1:1-3">१:१-३</ref></char> ला खामसाँ नेनलो।</para>
  <para style="io1">हतिच्येला पवलयि ओनेसिमसलायि तर्फने फिलिमोनला क्रिस्चिन भाइयि धो ङा हिना नाइरे खाला ङ्यानयाप नाइरे ढिनलो <char style="xt"><ref loc="PHM 1:4-21">१:४-२१</ref> </char></para>
  <para style="io1">पावलयि ढुल कि सोमयि थकच्योए क्याइरे राङ खामसाँ कुरते सिनिनलो <char style="xt"><ref loc="PHM 1:22-25">१:२२-२५</ref></char></para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />ख्रिष्ट येशुयि कैदि पावल राङ हुइ भाइ तिमोथिने, हुला करि रुवा किङान फिलिमोन, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />हुइ भैनि अप्फिया राङ हु ङ्याबो होएता सिपाहि अर्खिप्‍पस, राङ खि खिमयि चर्चला:<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="COL 4:17">कल्स्सि ४:१७</ref></char></note> <verse eid="PHM 1:2" /><verse number="3" style="v" sid="PHM 1:3" />खे ङिङच्ये राङ हुइ आके कजसुबा राङ प्रभु येशु ख्रिष्टने शान्ति!<verse eid="PHM 1:3" /></para>
  <para style="s">कटिनक्याँ नायाप राङ मोनलाम</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />ङाहि मोनलामला जब ङा खेला टानकिनहोए हतितुइना ङाहि कजसुबाला बारतै कटिनक्याँ नेन, <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />चिचालानाना प्रभु येशु ख्रिष्टयि थोला खि हिछेयि भारेला राङ कजसुबायि मियि थोला करि भरेला थोयिन्दु। <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />ङा मोनलाम क्याकच्याइ कि खि हिछेयि सभागितायि ख्रिष्टला होएता हुइ ताम ल पोरोयि छोइयि रिक्पा कि ङ्युइयोङ। <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />ङाहि भाइबा, ख्युइ करिने ङाला लेइराङ आन्नद राङ छिमा फिङान खुँखुँबा होए, चिचालानाना ख्युइ लाम्ला कजसुबायि मितेबे सम याङ सोमा च्युच्युङा धु।<verse eid="PHM 1:7" /></para>
  <para style="s">ओनेसिमसयि चाला पावलयि स्युवा</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />ख्युइ च्हि कियाप ना, सो कियापला आदेश तेरयापला ख्रिष्टला ङाला हा:म होए नाङ, <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />करियि चाला ङा खेला बरु स्युवा क्यासोम किन होए, ङा कमजोर पावल, तेहि थाल्ला येशु ख्रिष्टयि कैदि <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />ङाहि पिजा ओनेसिमसयि चाला ङाह निवेदन किच्याइ, सुइ चाला ङाहि कैदि अवस्थाला ङा आके च्युच्युङा होतो।<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="COL 4:9">कल्स्सि ४:९</ref></char></note> <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />ख्होए धुनला ख्युइ चाला फान मेता च्युङसोङ, हिन्नाङ थाल्ला ख्युइ चाला राङ ङाहि चाला फान थोङान च्युच्युङा धु। <verse eid="PHM 1:11" /><verse number="12" style="v" sid="PHM 1:12" />ङा ख्योएला, सुते ङारि समयि तुबु ना, ख्युइ तेहा लक्ते चोँज्याइ। <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />खोला ङा ङ्याबो भोरयाप ङा काका होतो ना, चिचालानाना लोन लयि चाला ङाहि बन्दि अवस्थाला ख्युइ छापला ख्युइ ङाला स्यापच्यि स्युङ्युइकिन, <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />हिन्नाङ ख्युइ आङयि विना ङा च्याङ किसोम मे, तेहि हचु क्याइरे ख्योएला ल करकापयि क्याक्याइबा मायोङ, हिन्नाङ ख्योए ख्युरि धोप्पि क्याक्याइबा सअ। <verse eid="PHM 1:14" /><verse number="15" style="v" sid="PHM 1:15" />हा:लाम ख्योएने आरोङ भेलायि चाला खो कुरु च्युच्युङा होतो, तेहि हचु क्याइरे खो बारतैयि चाला ख्योए ङ्याबो त्योए ङ्युयोङ <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />ता हति यक्पुवा च्वरा माना, हिन्नाङ यक्पुवाले मा, करि भाइ च्वरा, खास क्याइरे ङाहि चाला, हिन्नाङ तरह लेइराङ स्हु राङ प्रभुला समेत, ख्युइ चाला।<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />हतिचाला तेम्बारे ख्युइ ङाला रेँ पिमा हिना नाइबा क्याइना ङाला च्वरा हतिला ग्रहण कि। <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />तेम्बारे ख्युइ ख्योएला चिगा अल क्याक्याइबा होए नामयाङ, अथवा चगे खोला रिन होएना याङ, हति ङाहि हिसाबला पोर। <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />ङा पावल, ङारि लाक्पि धि ढिज्याइ। हति ऋण ङा ङाराङ च्योङज्याइ। खेला नाकोइराङ मिहा, कि रेँ चाला याङ खे ङाहि ऋणी होतो। <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />करि भाइबा, ख्युइ चाने प्रभुला चिगा ल होङ नाङान ङा सम किन होए। ख्रिष्टला ङाहि समला याङ सोमा सोइ। <verse eid="PHM 1:20" /><verse number="21" style="v" sid="PHM 1:21" />ख्युइ आदेश पालाना क्याक्याइबाला हिछे पोरते ङाहि लाँलाँबाले झन मा किच्याइ नाइबा क्याइरे ङा ख्योएला ढिन होए। <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />ङ्याबो ङाहि चाला ढोम्बो त्योएसा कोटा ल क्याइरे सोइरे पोर, चिचालानाना ख्युइ मोनलामयि लाम्ला ङा याङ ख्युइ तेहा होङ ङ्युइयोङ कि नाङान आशा किन होए।<verse eid="PHM 1:22" /></para>
  <para style="s">च्येस्युवा खामसाँ</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />येशु ख्रिष्टला ङ्याबोयि कैदि इपाफ्रासयि ख्योएला खाँमसाँ कुकुरा धु।<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="COL 1:7">कल्स्सि १:७</ref>; <ref loc="COL 4:12">४:१२</ref></char></note> <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />हति च्वरा क्याइरे रुवा किङान मर्कुस, अरिस्‍तार्खस, डेमास राङ लुकायि याङ।<note caller="-" style="x"><char style="xo" closed="false">1:24 </char><char style="xt" closed="false"><ref loc="ACT 12:12">प्रेरित १२:१२</ref>,<ref loc="ACT 12:25">२५</ref>; <ref loc="ACT 13:13">१३:१३</ref>; <ref loc="ACT 15:37-39">१५:३७-३९</ref>; <ref loc="ACT 19:29">१९:२९</ref>; <ref loc="ACT 27:2">२७:२</ref>; <ref loc="COL 4:10-14">कल्स्सि ४:१०-१४</ref>; <ref loc="2TI 4:10-11">२ तिमोथि ४:१०-११</ref></char></note> <verse eid="PHM 1:24" /><verse number="25" style="v" sid="PHM 1:25" />प्रभु येशु ख्रिष्टयि ङिङच्ये खि आत्मा ङ्याबो त्येयोङ।<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>