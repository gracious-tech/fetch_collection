<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Tichurong</book>
  <para style="h">युहान्ना</para>
  <para style="toc3">युहान्ना</para>
  <para style="toc2">युहान्ना</para>
  <para style="toc1">युहान्ना</para>
  <para style="mt2">युह्न्नायी टि:टिबि</para>
  <para style="mt1">युह्न्नायी टि:टिबि</para>
  <para style="imt">पुस्‍तक परिचय</para>
  <para style="ip">युहान्नायि अनुसार क्याइना लोन ल सारबा ठिमयि किताब स्यि थाबि नाङने च्हि ना काङ ति येशु ख्रिष्टयि मिजि मनङि क्याकिन। हतिबे नाङने पोरोला “लोन ल” नेन, काङति तोन “लोन ल” ना। हतिबा मत्ति, मर्कुस, लुका, राङ युहान्नायि येशु स्यिछारते टिटिबा ना। युहान्नायि अनुसार लोन ल ख्रिष्ट क्येयापले हा:लाम ९० लोयि च्येला लोब्टु युहान्नायि टिटिबा ना। किताबयि ढिङान युहान्ना हिना मानाइ नाङ कानि ढियापयि सैलि १ युहान्ना २ युहान्ना राङ ३ युहान्ना अछेरबा ङ्याबो ढियाप दु। रेन ताङबुइ ढिङानतेबे धि भेलाला युहान्नाला एफिससयि भजारला पोपोरा होतो हतिचाला धि किताब एफीसिसला टिटिबा हिनोम नाइबा हुन्दु। युहान्नायि साल्बो क्याइरे धि किताबयि उदस्य नाइरे मितेबाला येशु राङ ख्रिष्ट हिना नाइरे, सोम्बो कजसुबायि पिजा हिना नाङान रुवा कियाप हिना नाइरे स्योकिन <char style="xt"><ref loc="JHN 20:31">२०:३१</ref></char> धि हिछे क्याइरे हुइ ख्युइ मिनला मिजे खाँ ङ्युइकिन। किताब यहुदि राङ यहुदि मान्ते टङानतेबे चाला टिटिबा ना।</para>
  <para style="ip">युहान्नायि लोन ल यि किताब स्यान लोन लयि किताबले कुरु होतो। ख्युइ येशुयि क्याक्याइबि हा:लाइयापयि ध्यान ढुइयापला क्याक्याइबा ना राङ ख्युइ प्येतेबे भारेला लेइराङ माटिबा। येशुयि बप्तिस्मा राङ च्याङ मेते साला ख्युइ क्याक्याइबि लाइ लतेबा च्वरा मुख्य घटनातेबा याङ धि लोन ल टिटिबा मेता।</para>
  <para style="iot">धो रेखा।</para>
  <para style="io1">युहान्नायि ला लोन ल सुरु किन। <char style="ior"><ref loc="JHN 1:1-18">१:१-१८</ref></char></para>
  <para style="io1">हतिच्येला ख्युइ येशुयि क्याक्याइबि लेइराङ हा:लाइयापयि लाइ भारेला ढिन। <char style="ior"><ref loc="JHN 1:19-12:50">१:१९—१२:५०</ref></char></para>
  <para style="io1">हतिच्येला ख्युइ येशुयि मिजेला लेइराङ घटनातेबा मनङि क्याकिन काङते ख्युइ स्यियाप राङ सिरे याङ सोम्बो च्युङदे लाँलाँबि भारे थु क्योबिन। <char style="ior"><ref loc="JHN 13:1-20:31">१३:१—२०:३१</ref></char></para>
  <para style="io1">४ युहान्नायि अध्याय २१ ला लोन लयि अन्य किन जब येशु स्यिस्यियातेबाने सोम्बो च्युङदे लाँछारते मितेबे धुनला थोङसोङ राङ हतिच्येला किताब टिटिबि उदेश्ययि भारेला याङ स्यातेलो।</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">वचन सुला केसोङ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />ताङबो वचन होतो, वचन कजसुबा ङ्याबो होतो, तेहि वचन कजसुबा हिना, <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />खो ताङबो कजसुबा ङ्याबो होतो। <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />पार चानला होएता पोरो खोने स्यिसोङ, पार च्यानला होएता पोरो खो मेताला मासोइबालो। <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />हतिला मिजे होतो राङ, हति मिजेते मितेबे होए हिना <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />हति होएते मुन्नाला होए भारिनलो, राङ मुन्नायि हतिला जब याङ हा को माङ्युइबा।<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />कजसुबाने चाँचाँबि लोन खोरङान मिजि होतो, सुइ मिन युहान्ना हिना<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="MAT 3:1">मत्ति ३:१</ref>; <ref loc="MRK 1:4">मर्कुस १:४</ref>; <ref loc="LUK 3:1-2">लुका ३:१-२</ref></char></note> <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />हति हतिबे होएतेबे भारेला साछि तेरायापयि चाला साछि च्युङदे लेप्ते, कि मि पोरो ख्युइ चाने हिछे क्यायोङ। <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />खो राङ हति होए मानालो हिन्नाङ हति होएयि साछि तेरतु लेलेबालो <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />हति तेम्बा होए हिना। हति होए काङ संसारला हुन राङ मि पोरोला होए भारिनलो। <verse eid="JHN 1:9" /><verse number="10" style="v" sid="JHN 1:10" />खि संसारला धुलो, संसार खोने सोइरसोङ, हति हिन्नाङ संसारयि खोला ङोमास्येसोङ। <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />खो खुरि मि तेहा लेप्सोङ, हिन्नाङ खुरि मितेबे खोला हिछे माक्याइसोङ <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />हिन्नाङ चोमयि खोला हिछे क्याइरे राङ ख्युइ मिनला हिछे क्याइरे, ख्युइ हतिबाला कजसुबे मि हिना नाङानयि आङ पिन्देलो। <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />हतिबा ठाने, स्हुयि धोप्पाने, राङ मि रेनयि धोप्पाने माना हिन्नाङ कजसुबाने क्येक्येबा हिना।<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />तेहि वचन स्हुला क्येसोङ, राङ ङाहि ङिङच्येने तेम्बि खारे हुइ उइला ते सोङ। हुइ ख्युइ छे तेतेका थोङसोङ, हति छेते काङ आकेने लेलेबि चिक्पा झि मात्रा पिजि धोला खुखुबा ध्हु।<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xq" closed="false">ध्हु। </char><char style="xt" closed="false"><ref loc="1JN 4:9">१ युहान्ना ४:९</ref></char></note> <verse eid="JHN 1:14" /><verse number="15" style="v" sid="JHN 1:15" />युहान्नायि ख्युइ भारेला साछि तेरिन राङ क्ये छेया क्याइरे नाइसोङ, “को हति मि राङ ना, सुइ भारेला ङाहि नाइरे, ‘ङाहि च्येला होङान ङाले हाङ छेयाना चिचालानाना खो ङा कोयापयि ताङलाने होतो।’”<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />ख्युइ ङाहि ङिङच्येने हुइ पोरो च्यिनलाब जि ने स्यान च्यिनलाब जि खुखुबा होतो। <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />चिचालानाना ठिम मोशाने पिपिना ना, ङिङच्येने राङ तेम्बाते येशु ख्रिष्टने लेलेबाना। <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />कजसुबाला सुइ याङ नामयाङ थोथोवा मेतालो। आके पाङला त्योएङान चिक्पा झि मात्रा पिजियि खोला ताताना हिना।<verse eid="JHN 1:18" /></para>
  <para style="s">बप्तिस्मा<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">तासोम थु क्याक्याबि तिक्पा झयाप राङ ता फान्ने तिक्पा मिकियाप छ्युला न्हुपते थोनयाप कजसुबे लुलाम</char></note> तेरङान युहान्नि लोन</para>
  <para style="r">
    <ref loc="MAT 3:1-12">मत्ति ३:१-१२</ref>; <ref loc="MRK 1:1-8">मर्कुस १:१-८</ref>; <ref loc="LUK 3:1-18">लुका ३:१-१८</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />जब यरुश्लेमने यहुदि आङकिङानबे पुजारिबा राङ लेविबाला युहान्नायि तिया “ख्योए सुना” नाङयि ताम ढिरु चाँरेलो। तेहि युहान्नायि साछि धि ना।<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />युहान्नायि जवाक तेरयापला माना मानाइबा, हिन्नाङ चाङमा क्याइरे नाइरेलो, ङा ख्रिष्ट माना। <verse eid="JHN 1:20" /><verse number="21" style="v" sid="JHN 1:21" />तेहि हतिबे ख्हेला टिसोङ, “तेहि च्हि ख्योए एलिया हिनाइ?” ख्युइ नाइरेलो “ङा अर्थात।” “च्हि ख्योए हति ङोन्सेखिलङान हिनाइ?” ख्युइ जवाक पिन्सोङ, “अर्थात।” <verse eid="JHN 1:21" /><verse number="22" style="v" sid="JHN 1:22" />हतिबे खिला नाइसोङ, “ख्योए स्यु ना? ङेला नोइ, राङ ङेला चोँङानला ङाहि जवाक तेरयाप हो। ख्योए खुरि भारेला च्हि नाज्याइ?” <verse eid="JHN 1:22" /><verse number="23" style="v" sid="JHN 1:23" />युहान्नायि जवाक पिन्देलो “यशैया ङोन्सेखिलङानयि नानाइबा च्वरा ‘कजसुबे लाम थारका सोइ’ नाङान सा थुवाला क्ये धोनङान मिझिकि क्येते ङ्याना।”* <verse eid="JHN 1:23" /><verse number="24" style="v" sid="JHN 1:24" />हतिबाला फरिसिबे चाँचाँबा हिना। <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />तेहि हतिबे खोला टिसोङ “ख्योए ख्रिष्ट याङ मानाइ, एलिया याङ मानाइ, हति ङोन्सेखिलङान याङ अर्थात, चिचाला बप्तिसमा तेरिन?”<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />युहान्नायि हतिबाला जवाक पिन्देलो, “ङाता छ्युइ बप्तिसमा तेरिन हिन्नाङ खि उइला मिझि लाँरे तोकिन, सुला खि ङो मिस्येबा। <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />ङाहि च्येला होङान खोराङन ना। ख्हुइ पौलायि ताना ढोलयापयि झ्योदायि मि ङा माना।” <verse eid="JHN 1:27" /><verse number="28" style="v" sid="JHN 1:28" />धि ताम यर्दन च्याङभुइ फारकानला बेथानियाला च्युङदेलो, का युहान्नायि बप्तिसमा तेरिन ताता होतो।<verse eid="JHN 1:28" /></para>
  <para style="s">कजसुबायि भोल क्यायाप लु</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />ङाहि टो तेला युहान्नायि येशु खो यहला होङान थोङसोङ नाइरेलो, “तेहि, संसारयि तिक्पा खुरते खेरङान कजसुबे लु!<note caller="-" style="x"><char style="xo" closed="false">1:29 </char><char style="xt" closed="false"><ref loc="1PE 1:19">१ पत्रुस १:१९</ref>; <ref loc="ISA 53:6">यशैया ५३:६</ref></char></note> <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />हति खो राङना, स्यु भारेला ङाहि नानाइबा होतो, ‘ङाहि च्येला मिझि हुन, स्युरे ङाले छेया ना चिचालानाना खो ङा केयापले ताङला राङ होतो।’ <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />ङा ङारि खोला ङो स्येस्येबा मेता हिन्नाङ खो इस्राएलि लेभोङ नाइरे राङ छ्युइ बप्तिसमा तेरिन राङ ङा लेप्ते।” <verse eid="JHN 1:31" /><verse number="32" style="v" sid="JHN 1:32" />युहान्नायि जु नेन राङ साछि पिन्देलो, “ङाहि पवित्र आत्माला ङोम्मुइ धोला तेङला ने पुप्ते लेप्ते ख्युइ थोला पापते होङान थोङसोङ। <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />ङाहि खोला ङो स्येस्येबा मेता हिन्नाङ सुइ ङाला छ्युइ बप्तिसमा पिन नाइरे चाँरे, ख्युइ राङ ङाला नाइसोङ, ‘सुइ थोला ख्युइ पवित्र आत्मा पुपङान राङ त्योएङान थोङान ना, पवित्र आत्मायि बप्तिस्मा तेरङान हति राङ ना’ <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />ङाहि थोथोवा होतो, राङ साछि पिपिना होतो, कि कजसुबे पिजा खो राङ ना।”<verse eid="JHN 1:34" /></para>
  <para style="s">येशुयि ताङ ताङस्युवायि लोब्टुतेबा</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />याङ स्यान ङिनते युहान्ना खुरि लोब्टुबे नाङने ङाहि लोब्टुबा ङ्याबो लाँरे त्येतु। <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />ख्युइ येशु ढुन ताताता थोङसोङ नाइरेलो, “तेहि, कजसुबे लु!”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />ङिकार लोब्टुयि ख्युइ धि नाङान थोइरे राङ येशु ङ्याबो पुइसोङ। <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />येशुयि लक्ते ताइरेलो, राङ हतिबा च्येच्येला होङान थोङसोङ हतिबाला टिरेलो, “खे च्हि फाकिन?” हतिबे खोला नाइरेलो, “रब्बि काङयि तोन गुरुज्यु ख्योए का तोकिन?” <verse eid="JHN 1:38" /><verse number="39" style="v" sid="JHN 1:39" />ख्युइ हतिबाला नाइरेलो, “सअ, तेहि खि थोङान ना।” हतिबा पुइसोङ, तेहि खो त्योएसा थोङसोङ। हतिबा हति ङिन खो ङ्याबो त्येसोङ, चिचालानाना हा:लाम चार बजे च्युङ छारतुलो।<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />युहान्नायि नानाइबि ताम थोइरे राङ येशुयि च्येच्येला ढोङान ङाहियि नाङने च्यिते सिमोन पत्रुसयि भाइ अन्‍द्रियास हिना। <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />ख्युइ ताङला खुरि भाइ सिमोनला ठातेलो, तेहि खोला नाइरेलो “ङाहि मसिहला तोन ना ख्रिष्ट ठातेलो। <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />हति सिमोनला येशुयि तेहा ख्योसोङ। येशुयि खोला ताइरे नाइसोङ, ख्योए युहान्नायि पिजा सिमोन हिनाइ, ख्योए केफास मदलब काङयि खुँ पत्रुस च्वरा टा ना नाङान ना।”<verse eid="JHN 1:42" /></para>
  <para style="s">येशुयि फिलिप राङ नाथेनेल ला के ताताङा</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />ङाइटोतेला येशु गालिलला ढोयापयि थाकच्योए क्याइसोङ। राङ फिलिपला ठाते ख्युइ खोला नाइसोङ, “ङाहि च्येला सअ।” <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />अन्‍द्रियास राङ पत्रुस च्वरा फिलिप याङ बेथसेदा भजारयि हिना। <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />फिलिपयि नथानेलला ठाते नाइसोङ, “काङयि भारेला मोशायि ठिम राङ ङोन्सेखिलङानयि टिटिबा होतो, योसेफयि पिजा नासरतयि येशुला ङाहि ठाठाता होतो।” <verse eid="JHN 1:45" /><verse number="46" style="v" sid="JHN 1:46" />नथानेलयि हतिला टिसोङ, “च्हि नासरत ने ताम ल लेभोङ ङेला?” फिलिपयि खोला जवाक पिन्सोङ, “लेप्ते तेहि।” <verse eid="JHN 1:46" /><verse number="47" style="v" sid="JHN 1:47" />येशुयि नथानेल खुरि तेहा होङान थोङसोङ ख्युइ भारेला नाइसोङ, “च्हि इस्राएलि तेम्बा क्याइरे तेहि, काङला च्याङ नोठुल मेता।” <verse eid="JHN 1:47" /><verse number="48" style="v" sid="JHN 1:48" />नथानेलयि टिरेलो, “ख्युइ ङाला च्हिरु क्याइरे ङो ङोस्येसुइ?” येशुयि खोला जवाक तेरिनराङ नाइसोङ, “फिलिपयि सअ क्ये ताताते ताङला, भेलडुयि तोङबोङ यि हअला ङाहि ख्योएला थोथुवा होतो।” <verse eid="JHN 1:48" /><verse number="49" style="v" sid="JHN 1:49" />नथानेलयि खोला नाइसोङ, “रब्बि, ख्योए कजसुबे पिजा ना, ख्योए इस्राएलयि क्यालबो ना।” <verse eid="JHN 1:49" /><verse number="50" style="v" sid="JHN 1:50" />येशुयि खोला जवाक तेरिन राङ नाइसोङ “ङाहि खेला भेलडुयि तोङबोङयि हअला थोसोङ नाङान तेला हिछे किनाइ? ख्युइ धि ताम लेहाङ ताम छेया लेइ राङ थोङान ना।” <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />तेहि ख्युइ हतिला नाइसोङ, “तेम्बारे, ङा खेला नाज्याइ, खि तेङला पोपिया राङ कजसुबे तेङलायि लोन खेरङानला मि पिजा थोला झ्येङान राङ पुपङान थोङान ना।”<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">काना भजारला मिजे</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />ङिन सुबा तेला गालिलयि काना भजारला मिजे किन्दुलो। येशुयि आमा हतिया धुलो। <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />येशु राङ हति लोब्टुतेबाला याङ मिजेला पोइसोङ। <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />छ्याङ सिन येशुयि आमि खोला नाइसोङ, “हतिबे तेहा छ्याङ मिदु।” <verse eid="JHN 2:3" /><verse number="4" style="v" sid="JHN 2:4" />येशुयि हतिबाला नाइसोङ, “हे पोमु ङाहि च्हि किकोइ होतो ङाला माना। ङाहि भेला तरह लेलेबा मेता।” <verse eid="JHN 2:4" /><verse number="5" style="v" sid="JHN 2:5" />मुइ आमायि यक्पुवातेबाला ला नाइसोङ, “ख्युइ नानाइबा च्वरा खे कि।” <verse eid="JHN 2:5" /><verse number="6" style="v" sid="JHN 2:6" />ता यहुदिबे चाङमा सोयापयि लुलामयि चाला हतिया हा:लाम लिटर क्या झि स्योङान टोउयि ट्हु थाबा क्याङबा पोरतुइ। <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />येशुयि हतिबाला नाइसोङ, “क्याङबा बा छ्युयि खोङ।” हतिबे काङभि खा थु छ्युयि काङदेलो। <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />ख्युइ हतिबाला नाइरेलो, “टिझि खापेरे भत्यारयि ङोधो मितेबाला खेर।” हतिबे नानाइबा च्वरा केन राङ खेरसोङ। <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />भत्यारयि ङोधो मितेबायि हति छ्यु तुरेलो, काङते ता छ्याङला घ्युरतुलो। हति ल काने लेलेबाना खोला छ्या मेतालो हिन्नाङ छ्यु घाङानयि यक्पुवातेबाला छ्या होतो। तेहि भत्यारयि ङिन हतिबे ख्योबोतेला क्ये ताङदे नाइरेलो। <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />“ताङस्युवा मि पोरोयि ल छ्याङ पोरते ढुनलो तेहि मि तेबे लेइ राङ त्हु मात्रा अल छ्याङ भोरिनलो। ख्युइनि थल्ला थु ल छ्याङते पोरतु।” <verse eid="JHN 2:10" /><verse number="11" style="v" sid="JHN 2:11" />येशुयि ख्युइ ताङस्युवा हा:लाइतु झ्युयापयि लाइते गालिलयि काना भजारला क्याइसोङ। हतिच्वरा क्याइरे ख्युइ खुरि छे त्येसोङ, तेहि ख्युइ लोब्टुबे खोला हिछे क्याइसोङ। <verse eid="JHN 2:11" /><verse number="12" style="v" sid="JHN 2:12" />हतिच्येला खो खुरि आमा, भाइतेबा राङ लोब्टुतेबा ङ्याबो कफर्नहुमला पुइसोङ। ङिन रेन हतिया तातेलो।<verse eid="JHN 2:12" /></para>
  <para style="s">येशु यरुशलेम मोनलाम क्यासि खिमला पुइसोङ</para>
  <para style="r">
    <ref loc="MAT 21:12-13">मत्ति २१:१२-१३</ref>; <ref loc="MRK 11:15-17">मर्कुस ११:१५-१७</ref>; <ref loc="LUK 19:45-46">लुका १९:४५-४६</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />यहुदिबे निस्तार कालापसोल याङ धुनला हुन्दु, राङ येशु यरुश्लेमला पुइसोङ।<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">प्रस्थान १२:१-२७</ref></char></note> <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />ख्युइ मोनलाम क्यासि खिमला लोङ, लु, ङोम्मु छोङान राङ आलाइ च्येङानतेबा ङ्युन छोङिन ताताता ठेसोङ। <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />तेहि थाक्पि चापकि झि सोइरे ख्युइ हति पोरोला, हतिबे लु राङ लोङ हाङ मोनलाम क्यासि खिमने त्येसोङ, आलाइ च्येङानबे टेबुल खोलबु क्याप्ते हतिबे टेबुल लला क्याप्सोङ। <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />ङोम्मु छोङान तेबाला ख्युइ नाइसोङ, “धिने धिबा पोरो खेर। ङाहि आकि खिमला छोङ क्यायापयि खिम मासो।” <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />ख्युइ लोब्टुबे शास्त्रला नानाइबा हा:कोरेलो, “ख्युइ खिमयि जोश तरह ङाला झ्योपतु झ्युङान ना।” <verse eid="JHN 2:17" /><verse number="18" style="v" sid="JHN 2:18" />यहुदि आङ किङानबा ख्युइ तेहा टिवा जि ख्योँरे लेप्सोङ, “ख्योए धि लाइ किन्दु, ख्योए धि चाला ङेला काङ हा:लाइयापयि लाइ तोन ज्याइ?” <verse eid="JHN 2:18" /><verse number="19" style="v" sid="JHN 2:19" />येशुयि हतिबाला जवाक पिन्सोङ, “धि मोनलाम क्यासि खिम तिप, राङ ङा ङिन सुमला लोङ ज्याइ।”<note caller="-" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="MAT 26:61">मत्ति २६:६१</ref>; <ref loc="MAT 27:40">२७:४०</ref>; <ref loc="MRK 14:58">मर्कुस १४:५८</ref>; <ref loc="MRK 15:29">१५:२९</ref></char></note> <verse eid="JHN 2:19" /><verse number="20" style="v" sid="JHN 2:20" />“तेहि यहुदिबे नाइसोङ, धि मोनलाम क्यासि खिम सोज्याइला लो खलङि राङ टु थसोङ, राङ ङिन सुमला ख्युइ धि मोनलाम क्यासि खिम लोङ ङ्युयि नाइ च्हि?” <verse eid="JHN 2:20" /><verse number="21" style="v" sid="JHN 2:21" />हिन्नाङ काङ मोनलाम क्यासि खिम यि भारेला ख्युइ नानाइबा होतो, हति ख्युइ स्हु हिना; <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />जब खो स्यिरे लाँहिन, तेहि येशुयि नानाइबि धि ताम लोब्टुबाला टाम्बा सोइसोङ, राङ हतिबे पवित्रशास्त्रयि थोला राङ येशुयि नानाइबि वचनयि थोला हिछे क्याइसोङ।<verse eid="JHN 2:22" /></para>
  <para style="s">येशु मियि सम हा:कुनलो</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />जब येशु निस्तार कालापसोलयि तुना यरुश्लेमला होतो, हतितुइना ख्युइ क्याक्याइबि हा:लाइयापयितेबा थोङसोङ लेइ राङ यि ख्युइ मिनला हिछे क्याइसोङ। <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />हिन्नाङ येशुयि खोराङला हतिबे भरला मापोरसोङ, चिचालानाना ख्युइ पोरोला ङोस्येयिनलो। <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />चिचालानाना मि च्हिना नाइरे खोला छ्या होतो। खोला मि भारेला सुइ नाकोइ मेतालो चिचालानाना मि सम च्हिरु हुन खो खुरि हा:कुनलो।<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">निकोदेमस राङ येशु</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />फरिसिबे नाङने निकोदेमस नाङान मि झि होतो। खो यहुदिबे झोमसि नाङने घोबा झि हिना। <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />खो छाम्मु येशुयि तेहा लेप्सोङ, राङ खोला नाइरेलो, “गुरुज्यु, ङेला छ्या होतो ख्योए कजसुबाने लेलेबि गुरु झिना चिचालानाना कजसुबा ङ्याबो मेना ख्युइ क्याक्याइबि धि हा:लाइयापयि लाइतेबा सुइ याङ कि मिङ्युइबा।” <verse eid="JHN 3:2" /><verse number="3" style="v" sid="JHN 3:3" />येशुयि खोला जवाक पिन्सोङ, “तेम्बारे ङा खेला नाज्याइ, सु याङ सारबा क्याइरे माकेना ख्युइ कजसुबे राज्य मिथुवालो।” <verse eid="JHN 3:3" /><verse number="4" style="v" sid="JHN 3:4" />निकोदेमसयि खोला नाइसोङ, “मि काप्पो च्युङदे च्हिरु क्याइरे किन? च्हि खो याङ आमायि टोपाला लाम्मा ङिबा सुरे याङ क्येङ्युइ किनाइ?”<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />येशुयि जवाक पिन्सोङ, “तेम्बारे ङा खेला नाज्याइ, रेन छ्यु राङ आत्माने माकेना कजसुबे राज्यला ढो मिङ्युइबा। <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />स्हुने क्येक्येबि सुना, राङ आत्ममाने क्येक्येबा आत्माने। <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />ङाहि खेला सारबा क्याइरे क्ये नाइरे हा:मालाइ। <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />हुरबो छोम्मुवा काङ यहला ढोसोम होए हति यहला ढुन। ख्युइ हुरबुइ क्ये ङ्यानकिन हिन्नाङ हति काङ योने हुन राङ काङ यहला ढुन, हति हा:मिकुवा। आत्माने क्येक्येबि मि पोरो हति च्वरा राङ हुन।”<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="ECC 11:5">उपदेशक ११:५</ref></char></note> <verse eid="JHN 3:8" /><verse number="9" style="v" sid="JHN 3:9" />निकोदेमसयि हतिला टिसोङ, “धि च्हिरु क्याइरे हुन?” <verse eid="JHN 3:9" /><verse number="10" style="v" sid="JHN 3:10" />येशुयि हतिला जवाक पिन्सोङ, “ख्योए इस्राएलयि छिया गुरु ना, झोमयाङ हा:मिकुवाइ?” <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />तेम्बारे, ङा खेला नाज्याइ, हुइ च्हि हा:कुन हति नेन, राङ हुइ च्हि थोङ हति साछि तेरिन हिन्नाङ खे ङाहि साछि हिमिछेबालो। <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />ङाहि खेला पृथवियि ताम नाइरे, हति हिन्नाङ हिमिछेबा, तेहि खेला तेङलायि ताम नाइना च्हिरु क्याइरे हिछे कि ङ्युइ किन? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />तेङलाने पापाबि मि पिजा अर्थात सु याङ तेङला लाला पुपुता मेता लो।<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="JHN 6:38">युहान्ना ६:३८</ref></char></note> <verse eid="JHN 3:13" /><verse number="14" style="v" sid="JHN 3:14" />च्हिरु क्याइरे मोशायि रुल्ला च्याङ मेते साला तेक्ते, हति च्वरा क्याइरे मि पिजा धेकोइ हुन<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="NUM 21:9">गन्ति २१:९</ref></char></note> <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />ओर सुगे खोला हिछे क्याइ, हतिला नामयाङ मिसिनयापयि मिजे खुयिन। <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />“चिचालानाना कजसुबे संसारला धि च्वरा करि क्याइसोङ, कि खोला रेँ पिजा चिक्पा तेहाङ पिन्देलो, हति क्याइरे सुइ याङ खोला हिछे किङान सुवाङ मासि मायोङ नाइरे, हिन्नाङ नामयाङ मिसिनयाप मिजे खु। <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />चिचालानाना कजसुबे संसारला दोषि सोयाप नाइरे पिजाला संसारला चाँचाँबा मानालो, हिन्नाङ खोने संसार क्योबोङ नाइरे चाँचाँबा ना। <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />सुइ पिजाला हिछे क्याइ, हति घल मिहा हिन्नाङ हिमिछे किङानते ताङलाने राङ घल च्युङ चिचालानाना ख्युइ कजसुबे पिजा चिक्पायि मिनला हिछे मा क्याइबालो। <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />ल अल भेयापते छाछाराते धि राङ ना होए संसारला लेप्तु, राङ मि तेबे होएले ले याङ मुन्ना केनलो चिचालानाना हतिबे लाइ अल किन लो। <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />चिचालानाना लाइ अल किङान पोरो होएला मि कालो, राङ होएला मिहालो, स्यान अर्थात ख्युइ लाइ थोङिन। <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />तेम्बाला मिजे क्योङानयि मि होएला हुन, राङ हति च्वरा क्याइरे ख्युइ क्याक्याइबि लाइ कजसुबे तेहा क्याक्याइबा हिना नाइरे साल्बो थोङसोङ।”<verse eid="JHN 3:21" /></para>
  <para style="s">येशु राङ युहान्ना</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />हतिच्येला येशु राङ ख्युइ लोब्टुतेबा यहुदियायि प्रदेशला पुइसोङ, तेहि हतिया हतिबा ङ्याबो ङिन रेन ढोम्बोला त्येसोङ राङ बप्तिस्मा पिन्सोङ। <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />युहान्नायि याङ सालिम यी धुनयि एनोनला बप्तिस्मा तेरिनलो चिचालानाना हतिया छ्यु लेइ राङ धुलो। हतिया मितेबा हुन राङ बप्तिसमा खेरिनलो। <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />हति भेला थु युहान्ना झ्याल्ला पुपुता मेतालो।<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />हति भेलाला राङ युहान्नायि लोब्टु झि यहुदि ङ्याबो चाङमा सोयाप यि भारेला नारे च्युङसोङ। <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />युहान्नायि तेहा लेप्ते हतिबे खोला नाइसोङ, “गुरुज्यु, यर्दनयि स्यार छोयि फारकानला सु ख्योए ङ्याबो होतो, सुइ भारेला ख्युइ साछि पिन्दे, तेहि, खो बप्तिस्मा तेरिन तेतु, राङ पोरो ख्युइ तिया ढुन्दु।” <verse eid="JHN 3:26" /><verse number="27" style="v" sid="JHN 3:27" />युहान्नायि जवाक पिन्देलो, “मिला तेङलाने मा पिन थु च्याङ मिखुबा।” <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" /><note caller="-" style="x"><char style="xo" closed="false">3:28 </char><char style="xt" closed="false"><ref loc="JHN 1:20">युहान्ना १:२०</ref>; <ref loc="MAL 3:1">मलाकि ३:१</ref></char></note> ङा ख्रिष्ट माना हिन्नाङ ङा खोले ताङला चाँचाँबा हिना नाङानयि ङाहि साछि खेराङ तेरिन्दु। <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />सु ङ्याबो नामा होतो, ख्योबो हति राङ ना। ख्योबोयि रेँ रुवा सु ख्युइ धुनला लाँरे तोकिन, ख्युइ क्ये थोइरे लेइराङ किप्पो हुन। हतिचाला ता ङाहि किप्पो पुरा च्युङसोङ। <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />खो याला राङ ङा माला होङकोइ राङ होतो।<verse eid="JHN 3:30" /></para>
  <para style="s">खो सु तेङलाने लेप्ते</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />कोङने होङान ते पोरो ले छेया ना। पिरथिविते पिरथिविने राङ ना, राङ पिरथिवि राङ ताम नेन। तेङलाने लेलेबा ते पोरोले छेना।<note caller="-" style="x"><char style="xo" closed="false">3:31 </char><char style="xt" closed="false"><ref loc="JHN 8:23">युहान्ना ८:२३</ref></char></note> <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />ख्युइ च्हि थोङ राङ थोइरे, हति साछि हति राङ तेरिन हिन्नाङ ख्युइ साछि सुइयाङ मिङ्यानालो। <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />सुइ ख्युइ साछि ङ्यानकिन, हति कजसुबा तेम्बा हिना नाङानयि तामयि प्रमान तेरिन। <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />चिचालानाना सुला कजसुबायि चाँरे, हतियि कजसुबे वचन नेन चिचालानाना कजसुबे छे माक्याइबा पवित्र आत्मा तेरिनलो। <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />आकि ख्युइ पिजाला करि किनलो, राङ क्यु पोरो खुरि लाला टोटोता होतो।<note caller="-" style="x"><char style="xo" closed="false">3:35 </char><char style="xt" closed="false"><ref loc="MAT 11:27">मत्ति ११:२७</ref>; <ref loc="LUK 10:22">लुका १०:२२</ref></char></note> <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />सुइ पिजाला हिछे किन, हतिला नामयाङ मिसिनयापयि मिजे खु। सुइ पिजायि आदेस मिङ्याना, हति मिजे मिथुवालो, हिन्नाङ कजसुबे स्येताङ हति थोला ताताति ताताता किनलो।<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">येशु राङ समरि पोमु</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />युहान्नाले याङ येशुयि लोब्टु मा सुन्दु राङ बप्तिस्मा तेरिन धुलो नाङान फरिसिबे थोइसोङ। <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />तेम्बा तेला येशु खुरि ता माना, हिन्नाङ ख्युइ लोब्टुतेबे बप्तिस्मा तेरिनलो <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />तेहि येशुयि धि थोइरे, खि यहुदिया ताङदे याङ गालिलला लक्ते पुइसोङ। <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />खि सामरिया लाम च्युङदे ढोकोइ च्युङदेलो<verse eid="JHN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5" />खि सामरियायि सुखार नाङान भजारने लेप्सोङ हति भजारते याकुब खुरि पिजा योसेफला पिपिना सायि धुनला धुलो।<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="GEN 33:19">उत्पत्ति ३३:१९</ref>; <ref loc="JOS 24:32">यहोशु २४:३२</ref></char></note> <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />हतिया याकुबयि ठोम्पा धुलो। येशु हुनहुन थाङछ्याते हति ठोम्पि धुनला ङाला सोइ सोङ। हा:लाम ङिम्मुइ भेला च्युङदुलो।<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />सामरिया पोमुवा झि छ्यु घाङदु हतिया लेप्सोङ। येशुयि हतिला नाइसोङ, “ङाला छ्यु थुङदु छ्यु।” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />ख्युइ लोब्टुतेबा भजारला सायाप ङ्योरु पुइसोङ।<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />तेहि सामरि पोमुवायि खोला नाइसोङ, “ख्योए युहुदि क्याइरे ङा समरियायि लाने छ्यु च्हिरु क्याइरे थुङज्याइ?” यहुदिबे समरिया ङ्याबो च्याङ नाता मिभोरा।<note caller="-" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="EZR 4:1-5">एज्रा ४:१-५</ref>; <ref loc="NEH 4:1-2">नहेम्हास ४:१-२</ref></char></note> <verse eid="JHN 4:9" /><verse number="10" style="v" sid="JHN 4:10" />येशुयि हतिला नाइसोङ, “ख्युइ कजसुबे च्यिनलाब राङ ख्योएला छ्यु लोङान मिला ङोस्येस्येबा हिन्ना ख्युइ खोला लोङान ना, राङ ख्युइ ख्योएला सोम्बो छ्यु तेरङान ना।” <verse eid="JHN 4:10" /><verse number="11" style="v" sid="JHN 4:11" />हति पोमुवायि खोला नाइसोङ, “प्रभु, ख्योएला छ्यु धोनयापयि नोचे मेताइ, राङ ठोम्पि याङ तिङरिङमुवा दु। तेहि ख्योए काने सोम्बो छ्यु ख्योङ ज्याइ? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />च्हि ख्योए ङाहि ताङबुइ याकुबले छेया हिनाइ? ख्युइ ङेला धि ठोम्पा सोइ सोङ, राङ खो खुरि, ख्युइ मि राङ ख्युइ पालाङतेबे धि ठोम्पि छ्यु राङ त्हुरेलो।”<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />येशुयि हतिला जवाक पिन्सोङ, “धि छ्यु थुङान पोरो याङ खाकोमङान ना, <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />हिन्नाङ सुइ ङाहि पिपिनि छ्यु थुङिन हति जब याङ खामि कोमा। काङ छ्यु ङा खोला तेर च्याइ, हति हतिला नामयाङ मिसिनयापयि मिजेयि चाला छ्यु भेलङानयि क्याकपा होङान ना!”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />हति पोमुयि खोला नाइसोङ, “प्रभु, ङाला हति छ्यु राङ नाङ, राङ तेहि ङा खा कोमङान माना ना, राङ तेहि ङेला छ्यु घाङदु होङकोइ याङ मिहा।” <verse eid="JHN 4:15" /><verse number="16" style="v" sid="JHN 4:16" />येशुयि हतिला नाइसोङ, “कु, ख्युइ ख्योबोला सअ नोइ।” <verse eid="JHN 4:16" /><verse number="17" style="v" sid="JHN 4:17" />हति पोमुयि नाइसोङ, “ङाहि ख्योबो मेता।” येशुयि हतिला नाइसोङ, “ख्युइ ख्योबो मेता नाइरे ख्युइ तेम्बा नाइसोङ, <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />चिचालानाना ख्युइ ख्योबो ङा थाबा च्युङ छारतु, राङ सु थाल्ला ख्योए ङ्याबो दु, हति ख्युइ ख्योबो माना। ख्युइ धि तेम्बा नानाइबा ना।”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />हति पोमुयि खोला नाइसोङ, “हजुर, ख्योए ङोन्सेखिलङान हिना नाइरे ङाला छ्या होतो। <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />ङाहि ताङबुइ मि धि सुरला कजसुबायि पुजा क्याइरे, तेहि खे यहुदि नेन्दु, आराधाना किसि सा यरुश्लेमने नेन्दु।”<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />येशुयि हतिला नाइसोङ, “ए पोमु ङाला हिछे कि, हति भेला हुन राङ दु, जब खे न त धि सुरला, न यरुश्लेमला आकि आराधाना किकोइ हुन।”<verse eid="JHN 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 4:22" />खे समरिया काङ आराधाना किन खि हा:मिकुवा। ङे च्हि आराधाना किन ङेला छ्या होतो चिचालानाना मुक्तिते यहुदिबाने हुन। <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />हिन्नाङ भेला हुन राङ दु, राङ हति भेला थाल्ला राङ ना, जब तेम्बा आराधाना किङानबे आकेला आत्मा राङ तेम्बाला आरा किङान ना। चिचालानाना आराधाना किङान च्वरा आराधाना किङानला आके फाकिनलो। <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />कजसुबा आत्मा ना, राङ खोला आराधाना किङानतेबे आत्मा राङ तेम्बा ला आराधाना किकोइ हुन। <verse eid="JHN 4:24" /><verse number="25" style="v" sid="JHN 4:25" />हति पोमुयि खोला नाइसोङ, “ङाला छ्या होतो, कि थारथोनदु झ्युङान हुन काङला ख्रिष्ट नेन, राङ जब खो हुन, हतितुइना ङेला ताम पोरो नेन।” <verse eid="JHN 4:25" /><verse number="26" style="v" sid="JHN 4:26" />येशुयि हतिला नाइसोङ, “ख्योए ङ्याबो ताम नाङान, ङा हति राङ ना।” <verse eid="JHN 4:26" /><verse number="27" style="v" sid="JHN 4:27" />हतितुइना राङ ख्युइ लोब्टुतेबा लेप्सोङ, राङ खो पोमु झि ङ्याबो ताम नाङान थोङसोङ हा:लाइरेलो हिन्नाङ “ख्योए ल च्हि कोयिन?” अर्थात “ख्योए धि पोमु ङ्याबो चिचाला ताम नेन?” नाइरे सुइ याङ मा टिसोङ।<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />तेहि हति पोमु घारि पोरते भजार यहला पुइसोङ, राङ मि तेबाला नाइसोङ, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“सअ, मि झिला तेहि, सुइ ङाहि क्याक्याइबि लाइ पोरो ङाला नाइसोङ। हति राङ ख्रिष्ट हिनोम?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />तेहि हतिबा भजारने थोन्दे येशुयि तेहा पुइसोङ। <verse eid="JHN 4:30" /><verse number="31" style="v" sid="JHN 4:31" />हति उइला लोब्टुबे खोला जु नाइरे स्युवा<note caller="+" style="f"><char style="fr" closed="false">4:31 </char><char style="fq" closed="false">स्युवा </char></note> क्यापसोङ, “गुरुज्यु, चिगा सो।” <verse eid="JHN 4:31" /><verse number="32" style="v" sid="JHN 4:32" />हिन्नाङ ख्युइ हतिबाला नाइसोङ, “ङाला सायापयि चाला धि च्वरा ङ्योपा होतो, काङते खेला छ्या मेता।” <verse eid="JHN 4:32" /><verse number="33" style="v" sid="JHN 4:33" />हतिचाला लोब्टुतेबे चिकि च्हि नारे क्याइसोङ, “च्हि रेनयि खोला ङ्योपा ख्योँरे पिनोम का कि च्हिरु?”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />येशुयि हतिबाला नाइसोङ, “ङाला चोँङानयि धोप्पा च्वरा कि, राङ ख्युइ लाइ पुरा कियाप राङ ङाहि ङ्योपा ना। <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />च्हि खे मिनाइ, तरह धा सि लाँमा दु, तेहि भालि तुइयापयि भेला हुन? ङा खेला नाज्याइ, रेँ मि तेक्ते स्यिङ राङ भारि तोइ, भालि तुइयापला भालि छोहि छारतु। <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />सुइ भालि तुकिन हतिला ला खुकिन, नामयाङ मिसिनयापयि मिजेयि चाला ढेबु रुकिन, राङ जु ङान राङ तुइङान ङाहि कार ङ्याबो किप्पो किनलो। <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />चिचालानाना ‘चिकि झुयिन, राङ स्यानति तुबिनलो,’ नाङानयि वचन धिला राङ तेम्बा हुन। <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />ङाहि ख्योएला हतिया तुप्तु चाँरे, काँहा तुका क्याक्याइबा मेता। स्यान तेबे तुका क्याक्याइबा होतो, राङ खि तुका क्याक्याइबि ढेबु खेराङला खुदु।”<note caller="-" style="x"><char style="xo" closed="false">4:38 </char><char style="xt" closed="false"><ref loc="MIC 6:15">मिका ६:१५</ref></char></note><verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />“ङाहि च्हि क्याइ हति पोरो ख्युइ नाइसोङ हति पोमुवायि साछि क्याइरे हति भजारयि सामरितेबे नाङने लेइराङयि ख्युइ थोला हिछे क्याइसोङ।” <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />हतिचाला जब सामरि ख्युइ तेहा लेप्ते, हतितुइना हतिबे खोला खोङ ङ्याबो त्योएयापयि स्युवा क्यापतु, राङ येशु ङिन ङा खोङ ङ्याबो तातेलो।<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />तेहि ख्युइ वचनयि चाला तरह याङ लेइराङयि ख्हुइ थोला हिछे क्याइसोङ। <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />हति पोमुला हतिबे नाइसोङ, “ता ख्युइ नानाइबि तामयि चाला ङाहि हिछे क्याक्याइबा माना हिन्नाङ ङे ङिरि थोथोइबि चाला तेम्बारे खो संसारयि मुक्तिदाता हिना नाइरे ङाहि हा:कोसोङ।”<verse eid="JHN 4:42" /></para>
  <para style="s">येशुयि घोबा मि पिजाला टाक्तु च्युच्युका</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />ङिन ङाहि च्येला येशु हतिने थोन्दे गालिलला पुइसोङ। <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />येशु खुरि साछि पिन्सोङ, कि रेँ अल देशला ङोन्सेखिलङानला सम्मान राङ मिदु नाइरे<note caller="-" style="x"><char style="xo" closed="false">4:44</char><char style="xt" closed="false"><ref loc="MAT 13:57">मत्ति १३:५७</ref>; <ref loc="MRK 6:4">मर्कुस ६:४</ref>; <ref loc="LUK 4:24">लुका ४:२४</ref></char></note> <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />जब खो गालिलला लेप्ते, तेहि ख्युइ यरुश्लेमला निस्तार कालापसोलयि भेलाला च्हि क्याक्याइबा होतो हति पोरो लाइ थोङसोङ गालिलयि मितेबे ल क्याइरे सअ नाइरेलो चिचालानाना हतिबा हाङ कालापसोलला पुइसोङ।<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />हतिच्येला येशु गालिलयि काना भजारला लेप्सोङ, काँहा ख्युइ छ्युला आरा स्यिरेलो। कफर्नहुमला घोबा आङकिङान झि धुलो, सुइ पिजा नाप्पा धुलो। <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />येशु यहुदियाने गालिलला लेप्तुना थोइरे खो ख्युइ तेहा लेप्सोङ, तेहि ख्युइ पिजा टाक्तु छ्यु नाइरे स्युवा क्यापसोङ चिचालानाना ख्युइ पिजा स्यिलेके धुलो। <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />येशुयि खोला नाइसोङ, “खे शक्ति राङ हा:लाइयापयि लाइ माक्याइ थु हिछे राङ मिकिता।”<note caller="-" style="x"><char style="xo" closed="false">4:48 </char><char style="xt" closed="false"><ref loc="DAN 4:2">दानिएल ४:२</ref></char></note> <verse eid="JHN 4:48" /><verse number="49" style="v" sid="JHN 4:49" />हति घोबा आङकिङानति खोला नाइसोङ, “प्रभु, ङाहि पिजा स्यियापले ताङला ङा ङ्याबो सअ।” <verse eid="JHN 4:49" /><verse number="50" style="v" sid="JHN 4:50" />येशुयि खोला नाइसोङ, “क्यु, ख्युइ पिजा सोम्बो दु।” येशुयि नानाइबि धि वचनला ख्युइ हिछे क्याइसोङ, राङ खुरि लाम स्युसोङ। <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />तेहि खो लामला ढुन ताताताला ख्युइ यक्पुवातेबा खोला ठाते ख्युइ पिजा सोम्बो दु नाइरे खोला स्येसोङ। <verse eid="JHN 4:51" /><verse number="52" style="v" sid="JHN 4:52" />चोम भेलाने खो टाकाला छेलसुइ नाइरे टिरे हतिबे नाइसोङ, “धाङ ङिम्मुइ एक भजेने खोला छायोएयि ताङसोङ।” <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />येशुयि हतिला, “ख्युइ पिजा सोनङान ना” नेतुइने राङ हिना नाइरे आकि हा:कोरेलो। तेहि खो राङ ख्युइ प्येरा पोरोयि हिछे क्याइसोङ। <verse eid="JHN 4:53" /><verse number="54" style="v" sid="JHN 4:54" />यहुदियाने गालिलला लेप्ते येशुयि क्याक्याइबि हा:लाइयापयि लाइ लाम्मा ङिबा हिना।<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">खिल छ्युला नाप्पा टाक्तु च्युच्युका</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />हतिच्येला यहुदिबे कालापसोङ हिना, राङ येशु यरुश्लेमला पुइसोङ। <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />यरुश्लेमला लु त्येसि कोयि धुनला क्य ङा थाबा होएता ठोम्पा धुलो, काङला हिब्रु क्येला बेथसेदा नेनलो। <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />हतिया लेइराङ नाझा होएता, मदलभ मि लोँलोँवा, काङबा खोरिया, नाप्पा तेबा स्यियिन। हतिबा छ्यु जब घुलिन नाइरे कहुरे तोकिनलो। <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />चिचालानाना कजसुबे तेङलायि लोन खेरङान झिकि छ्यु किकिलाला छोएछोएला पुपते झ्युनलो, राङ छ्यु योमयोम क्याइरे च्येला स्यु ताङला छ्युइ नाङला स्यु, च्हिरु नाप्पा थ्‌हुवा च्युङनाङ, हति टाकिन लो। <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />हतिया लो ङिस्यु राङ क्येने नाङान मिझि धुलो। <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />येशुयि हति ङेरे ताताता थोङसोङ तेहि खो लेइ राङ ताङलाने राङ नाङान हिना नाइरे हा:कोरे येशुयि हतिला नाइसोङ, “च्हि ख्योए टासोम होतोइ?”<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />नाप्पाति खोला नाइसोङ, “प्रभु, जब छ्यु थोरिन हतितुइना ङाला खिल छ्यु थु केलङान ङाहि सुवाङ मेता, ङा ढुनढुन ङाले ताङला मि स्यान पुते स्युयिनदु।”<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />येशुयि हतिला नाइसोङ, “लाँरे त्योए, राङ खुरि तान तुइ, तेहि क्यु।” <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />हतितुइना राङ हति मि टासोङ, राङ खुरि तान तुरे पुइसोङ। हति ङालसुइ ङिन हिना। <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />हतिचाला नाप्पा टाक्तु च्युच्युका मि तेला यहुदिबे नाइसोङ, “धिनि ङालसुइ ङिन हिना, ख्युइ तान खुर च्याइ ल माना।” <note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="JER 17:21">यर्मिया १७:२१</ref></char></note> <verse eid="JHN 5:10" /><verse number="11" style="v" sid="JHN 5:11" />हति हतिबाला जवाक पिन्सोङ, “सुइ ङाला टाक्तु च्युकते ख्युइ राङ नाइसोङ ‘रेँ तान खुरते क्यु।’” <verse eid="JHN 5:11" /><verse number="12" style="v" sid="JHN 5:12" />हतिबे खोला टिसोङ, “ख्योएला तान खुरते क्यु नाङान मि सु ना?” <verse eid="JHN 5:12" /><verse number="13" style="v" sid="JHN 5:13" />हिन्नाङ टाक्तु च्युच्युकि मि ति येशु सुना नाइरे ङोस्येस्येबा मेतालो चिचालानाना हति साला मि लेइराङ च्युवा राङ खो हतिने पुइछारतुलो। <verse eid="JHN 5:13" /><verse number="14" style="v" sid="JHN 5:14" />हतिच्येला येशुयि खोला मोनलाम क्यासि खिमला ठाते नाइसोङ, “तेहि, ख्योए टातु। याङ तिक्पा मा क्ये, राङ ख्युइ थोला याङ अल मायोङ।”<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />खोला टाक्तु झ्युङान नि येशु हिना नाइरे हति मि पुते यहुदि आङकिङानतेबाला नाइसोङ।<verse eid="JHN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16" />हतिचाला यहुदिबे येशुयि तुका तेराला छेलसोङ चिचालानाना ख्युइ धि लाइ ङालसुइ ङिनला क्याइसोङ। <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />तेहि येशुयि हतिबाला नाइसोङ, “ङाहि आके बारतै लाइ किन राङ ङा याङ लाइ किनराङ होए।” <verse eid="JHN 5:17" /><verse number="18" style="v" sid="JHN 5:18" />हतिचाला यहुदिबे येशुला सोएयाप हतिले मा च्युइ क्याइरे चिचालानाना ख्युइ ङालसुइ ङिनयि ठिम मासि लाँलाँबा मात्रा माना, हिन्नाङ खोराङ ला कजसुबा च्वरा हिना नानाइबा राङ ख्युइ कजसुबाला खुरि आके हिना नाइसोङ।<verse eid="JHN 5:18" /></para>
  <para style="s">पिजायि आङ</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />येशुयि हतिबाला नाइसोङ, “तेम्बारे, ङा खेला नाज्याइ, पिजा खुरि च्याङ कि मिङ्युइबा, हिन्नाङ आकि च्हि क्याक्याइबा थोङ हति किन, चिचालानाना आकि च्हि क्याइ, पिजि याङ हति किन। <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />चिचालानाना आकि पिजाला करि किन, राङ खो खुरि क्याक्याबि लाइ पोरो पिजाला तोनिन। हतिले याङ लाइ ल ख्युइ पिजाला तोनिन, राङ खे हा:लाइङान ना। <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />चिचालानाना च्हिरु क्याइरे आकि मि स्यिस्यियातेबाला लोङिन राङ खोला मिजे तेरिन, हति च्वरा क्याइरे पिजि याङ सुला धोप्पा होए, हतिला मिजे तेरिन। <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />चिचालानाना आकि सुइ याङ ल अल भेयापयि मिकिता हिन्नाङ पोरो ल अल भेयापयि कियापयि लाइ पिजाला पिपिना होतो, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />तेहि पोरोयि पिजि सम्मान किन नाइरे, च्हिरु क्याइरे हतिबा आकि सम्मान किन। पिजि सम्मान मि किङानयि खोला चोँङान आकि याङ सम्मान मि किता।”<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />“तेम्बारे, ङा खेला नाज्याइ, सुइ ङाहि वचन ङ्यान राङ ङाला चोँङान यि थोला हिछे क्याइ, हतिला नामयाङ मिसिनयापयि मिजे होतो। हति ल अल भेयापयिला मिहा हिन्नाङ स्यियापले मिजेला लेप छारते।” <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />तेम्बारे, ङा खेला नाज्याइ, हति भेला हुन्दु, राङ हति भेला थाल्ला ना जब स्यिस्यियातेबे कजसुबे पिजि क्ये ङ्यानकिन राङ, ङ्यान ङान तेबा सोम्बो होङान ना। <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />चिचालानाना च्हिरु क्याइरे आके खोराङला मिजे दु, हति च्वरा क्याइरे ख्युइ पिजाला याङ खोराङला मिजेयि क्याक्याला होङयापयि आङ पिन्देलो। <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />तेहि खोला ल अल भेयापयि था च्योएयापयि आङ पिन्देलो चिचालानाना खो मि पिजा ना। <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />“धिला हा:मालाइ चिचालानाना भेला हुन राङ दु, जब तुरसाला होएता पोरोयि ख्युइ क्ये थोइङान ना, <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />तेहि तुरने फिला थोन्दे होङान ना लाइ ल किङान तेबा स्येताङयिस्यिने मिजेला लाँयायि चाला राङ लाइ अल किङान तेबा ङेबायि चाला स्यिस्यियाने लायाप।”<note caller="-" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="DAN 12:2">दानिएल १२:२</ref></char></note><verse eid="JHN 5:29" /></para>
  <para style="s">येशुयि साछि</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />“ङा ङारि च्याङ कि मिङ्युइबा। च्हिरु क्याइरे ङा कजसुबे ङ्यानकिन, हति च्वरा क्याइरे ङा ल अल भेयापयि किन, राङ ङाहि ल अल भेयापयि तेम्बा हुन चिचालानाना ङा ङारि धोप्पा मि फाता हिन्नाङ ङाला चोँङानयि धोप्पा फाकिन।”<verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />“तेम्बारे ङा ङारि भारेला साछि पिन्ना ङाहि साछि तेम्बा मिहा।” <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />ङाहि भारेला साछि तेरङान मि स्यान हुन, राङ ङाला छ्या होतो, कि ङाहि भारे ख्युइ च्हि साछि तेरिन, हति साछि तेम्बा ना। <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />“खि युहान्नायि तेहा ढोरु चाँदु, तेहि ख्युइ तेम्बि साछि पिन्दु।<note caller="-" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="JHN 1:19-27">युहान्ना १:१९-२७</ref>; <ref loc="JHN 3:27-30">३:२७-३०</ref></char></note> <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />हिन्नाङ ङा ङारि भारेला मि साछि कोइ सोम मिकिता, याङ ङा धि ताम हति चाला नेन, कि खे थारथोनोङ नाइरे <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />युहान्ना छेङान राङ होए भारङानयि छ्योएमे हिना, राङ खे ख्युइ होएला टिझि थु किप्पो कियापला राजि च्युङसोङ।”<verse eid="JHN 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 5:36" />हिन्नाङ ङाला ङ्याबो काङ साछि होतो, हति युहान्नाले छेया होतो। चिचालानाना काङ लाइ कियाप यि चाला आकि ङाला पिपिना होतो, हति लाइ ङा किनराङ होतो, तेहि हतिराङ ङाहि भारेला साछि तेरिन्दु कि आकि ङाला चाँचाँबा ना। <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />ङाला चोँङान आकि खुरि राङ ङाहि भारेला साछि तेरिन्दु। ख्युइ क्ये खि जब याङ थोथोइबा मेता, तेहि ख्युइ च्ये जब याङ थोथोवा मेता।<note caller="-" style="x"><char style="xo" closed="false">5:37 </char><char style="xt" closed="false"><ref loc="MAT 3:17">मत्ति ३:१७</ref>; <ref loc="MRK 1:11">मर्कुस १:११</ref>; <ref loc="LUK 3:22">लुका ३:२२</ref></char></note> <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />ख्युइ वचन खेला मितोता, चिचालानाना सुला ख्युइ चाँरे, खे हति थोला हिछे मिकिता। <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />खे पवित्रशास्त्राला फाकिन्दु, चिचालानाना हतिया नामयाङ मिसिनयापयि मिजे होतो नाइबा खे किन्दु। ङाहि भारेला साछि तेरङान हति पवित्रशास्त्रा राङ ना, <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />हचु हिन्नाङ खे मिजे थोपयापला ङाहि तेहा होङसोम मिकिता।<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />“ङा मियि छे धेयाप धोप्पा मिकिता” <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />हिन्नाङ ङाला छ्या होतो कि, खि च्हिरु मि हिना नाइरे, याङ ङाला छ्या होतो कि, ख्युइ समला कजसुबायि चाला करि च्याङ मिदु। <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />ङा ङारि आकि मिनला लेलेबा होतो, हिन्नाङ खे ङाहि काला मि ङ्याना। स्यान सु याङ ङाहि मिनला लेपन्ना हतिला हिना नाइरे खाला ङ्यान ङानना। <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />खे च्हिरु क्याइरे हिछे कि ङ्युइ किन्दुइये, जब कि खे खिरी नाङने सम्मान प्येरे किन्दु, तेहि चिकि चिने सम्मान फाकिन्दु, काङ छे ते च्हि मात्रा कजसुबाने हुन? <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />“धि हिना नाइरे समला मास्यार कि ङा आकि धुनला खेला घल सुन नाइरे। खेला घल सोङान ता मोशा होतोना, सुला खि रेँ भरोसा पोपोरा होतो। <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />चिचालानाना खि मोशाला हिछे क्याक्याइबा नाना ङाला हाङ हिछे किन, चिचालानाना ख्युइ ङाहि भारेला टिटिबा होतो।<note caller="-" style="x"><char style="xo" closed="false">5:46 </char><char style="xt" closed="false"><ref loc="LUK 24:27">लुका २४:२७</ref></char></note> <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />हिन्नाङ खे ख्युइ टिटिबि तामला हिछे मि किना, ङाहि तामला च्हिरु क्याइरे हिछे किच्याइ?”<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">येशुयि तोङ ङा थोला स्यास्यामा</para>
  <para style="r">
    <ref loc="MAT 14:13-21">मत्ति १४:१३-२१</ref>; <ref loc="MRK 6:30-44">मर्कुस ६:३०-४४</ref>; <ref loc="LUK 9:9-10">लुका ९:९-१०-१७</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />धि तामयि च्येला येशु गालिल, मदलभ तिबेरियास छो छियि फारकानला पुइसोङ। <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />तेहि तुम छोम्मुवा झि ख्युइ च्येला लेप्सोङ चिचालानाना ख्युइ नाप्पातेबाला क्याक्याइबि हा:लाइयापयि लाइतेबा हतिबे थोङसोङ। <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />येशु स्हुरयि थोला पुइसोङ, राङ खुरि लोब्टुबा ङ्याबो त्येसोङ। <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />यहुदिबे कालापसोङ, निस्तार-कालापसोलयि भेला धुनला धुलो, <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />तेहि येशुयि फालाछुला ताइरे तुम छोम्मुवा झि खो यहला होङान थोङसोङ ख्युइ फिलिपला नाइसोङ, “धिबाला स्योमयापयि चाला हु काने लोटा ङ्योज्याइ?” <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />ख्युइ खोला छोए तायापयि चाला धि नानाइबा ना, चिचालानाना को च्हि कितु पुते, सो खोला छ्या होतो।<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />फिलिपयि खोला नाइसोङ, “पोरोला टिझिटिझि खुनाङ ङाहि ङुलयि सिक्कि क्या लोटा हतिबाला छाँमिदु।” <verse eid="JHN 6:7" /><verse number="8" style="v" sid="JHN 6:8" />ख्युइ लोब्टुबे नाङने च्हि सिमोन पत्रुसयि भाइ अन्‍द्रियासयि नाइसोङ, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“ङ्या पिजा झि दु, हतिला जौकायि लोटा ङा राङ ङ्या ङाहि दु। हिन्नाङ झोम मि चाला झोबा झि कि काँहा छाङिन?”<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />येशुयि नाइसोङ, “मितेबाला तोतुछ्‌यु।” हतिया चा लेइराङ क्येक्येबि थाङ धुलो। तेहि तोङ ङा थाबा पिजा हतिया त्येसोङ। <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />तेहि येशुयि लोटा खेरसोङ, राङ कजसुबा ला कटिनक्याँ नाइरे च्येला त्योएङान तेबाला कोहििसोङ, हतिच्वरा क्याइरे ङ्या याङ कोहििसोङ। हतिबाला चोम कोइबा होए होचोम पिन्सोङ। <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />तेहि ख्होए ढ्हाढ्हा थु साइ सोङ ख्युइ खुरि लोब्टुतेबाला नाइसोङ, “ला मा लुलुइबि तुबुतेबा तुइ, चियाङ मासहि होङदु माजु।” <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />साङानतेबे लालाकि जौका हति लोटा ङाहि तुभुइ हतिबे तुरे ख्योए फुगो च्युनङि खाँसोङ। <verse eid="JHN 6:13" /><verse number="14" style="v" sid="JHN 6:14" />हतिचाला ख्युइ क्याक्याइबि धि हा:लाइयापयि लाइतेबा थोङसोङ मितेबे नाइसोङ, “संसारला होङान ङोन्सेखिलङान तेम्बारे खो राङ हिना।”<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="MAT 21:11">मत्ति २१:११</ref></char></note> <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />हतिबा लेप्ते खोला बलजफति ङ्याबो क्यालबो सोज्याइ फाकिन्दु नाइरे हा:कोरे येशु याङ चिक्पा सुरला पुइसोङ।<verse eid="JHN 6:15" /></para>
  <para style="s">येशु छ्युयि ङाला पुपुता</para>
  <para style="r">
    <ref loc="MAT 14:22-23">मत्ति १४:२२-२३</ref>; <ref loc="MRK 6:45-52">मर्कुस ६:४५-५२</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />कमु च्युङदे येशु लोब्टुतेबा छो यहला पुइसोङ। <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />राङ डुङगाला स्योन्दे हतिबा छो छोम्मुवा फारकानला कफर्नहुम यहला ढुवाला छेलसोङ। हतितुइना स्योरुपलेके धुलो, राङ येशु थल्ला थु ख्होए तेहा लेलेबा मेतालो। <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />तेहि हुरबो छोम्मुवा क्याक्याबाति, छो छोम्मुवायि भाल्लाप क्याकाला छेलसोङ। <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />ङा ट्हु किलोमिटर डुङगा चलाइ क्याइरे पुते हतिबे येशु छो छोम्मुवायि थोला काङबि डुङगायि धुनला होङान थोङसोङ, तेहि हतिबा झिसोङ। <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />हिन्नाङ ख्युइ हतिबाला नाइसोङ, “ङ्याना माझि।” <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />हतिबे खोला क्येन राङ ङ्याबो डुङगाला पोरसोङ, राङ हतिबा ढुन ताताति साला डुङगा लेप छारसोङ।<verse eid="JHN 6:21" /></para>
  <para style="s">मियि येशुला पापाता</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />छो छोम्मुवायि फारकान ला होएता मि झोम ति थाहि टो तेला हतिया डुङगा झि मात्रा थोङसोङ। हतिबाला छ्या होतो, कि येशु खुरि लोब्टुबा ङ्याबो डुङगाला स्योस्योना मेता नाइरे हिन्नाङ खुरि लोब्टुबा मात्रा पुते नाइरे। <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />तेहि तिबेरियासने स्यान डुङगा तेबा हति साला लेप्सोङ, का प्रभुयि कटिन क्या नाइरे हतिबे लोटा सासायिबा तेहा। <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />येशु राङ ख्युइ लोब्टुबा हतिया मेता छ्या च्युङदे हतिबा येशुला फाकिन डुङगाला स्योन्दे कफर्नहुम पुइसोङ।<verse eid="JHN 6:24" /></para>
  <para style="s">येशु मिजेयि लोटा</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />ख्होए येशुला छो छोम्मुवा यि फारकानला ठाते खोला टिरेलो, “गुरुज्यु, ख्योए ङिहा जब लेप्ते?” <verse eid="JHN 6:25" /><verse number="26" style="v" sid="JHN 6:26" />येशुयि हतिबाला जवाक तेरिन ताङ नाइसोङ, “तेम्बारे ङा खेला नाज्याइ, खि हा:लाइयापयि लाइतेबा थोङसोङ माना हिन्नाङ ढ्हाढ्हा थु लोटा सासाइबि चाला ङाला फातु लेलेबाना। <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />मासि होङान यि ङ्योपि चाला तुका माके, हिन्नाङ नामयाङ मिसिनयापयि मिजे तु त्योएङानयि ङ्योपायि चाला तुका कि, काङते मि पिजि खेला तेरङान ना। चिचालानाना कजसुबा आकि ख्युइ थोला छाप च्याच्यारा होतो।”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />हतिबे खोला नाइसोङ, “कजसुबे धोप्पा होएते लाइ किच्याइला ङाहि च्हि कि कोइ हुन?” <verse eid="JHN 6:28" /><verse number="29" style="v" sid="JHN 6:29" />येशुयि हतिबाला नाइसोङ, “कजसुबे लाइ हति राङना सुला ख्युइ चाँचाँबा होतो हतिला खे हिछे कि।” <verse eid="JHN 6:29" /><verse number="30" style="v" sid="JHN 6:30" />हतिचाला हतिबे खोला नाइसोङ, “ख्योए काङ हा:लाइयापयि लाइ तोनिन्दु, सो ङे ताज्याइ, तेहि ख्योएला हिछे किता? ख्योए च्हि किच्याइ?<note caller="-" style="x"><char style="xo" closed="false">6:30 </char><char style="xt" closed="false"><ref loc="EXO 16:4-15">प्रस्थान १६:४-१५</ref>; <ref loc="PSA 78:24">भजनसंग्रह ७८:२४</ref> </char></note> <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />ङाहि ताङबुइ मि च्याङ मेते साला मन्न साइरेलो, पवित्रशास्त्रला धि च्वरा नाइरे टिदु, ‘ख्युइ हतिबाला सायापला तेङलाने लोटा पिन्सोङ।’” <verse eid="JHN 6:31" /><verse number="32" style="v" sid="JHN 6:32" />येशुयि हतिबाला नाइसोङ, “तेम्बारे, ङा खेला नाज्याइ, खेला तेङलाने लोटा तेरङान मोशा माना हिन्नाङ तेङलाने खेला तेम्बा लोटा तेरङान ङाहि आके ना। <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />चिचालानाना कजसुबे लोटा हति राङना, काङते तेङलाने हुन राङ, संसारला मिजे तेरिन।”<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />हतिबे येशु नाइसोङ, “प्रभु, हति लोटा ङेला बारतै नाङ।” <verse eid="JHN 6:34" /><verse number="35" style="v" sid="JHN 6:35" />येशुयि हतिबाला नाइसोङ, “मिजेयि लोटा ङ्याना। ङाहि तेहा होङान टोपा मितोबा, राङ ङाहि थोला हिछे किङान नामयाङ खा मिकोमा। <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />हिन्नाङ ङाहि खेला नानाइबा राङ होए, खि ङाला थोथोवा होतो, राङ हिछे मिकिता। <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />आकि ङाला पिपिना पोरो ङाहि तेहा होङान ना, राङ ङाहि तेहा होङान च्यिलाङ ङा मासि मिसो। <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />ङा ङारि धोप्पा पुरा कितु ङा तेङलाने लेलेबा माना हिन्नाङ ङाला चोँङानयि धोप्पा पुरा कितु लेलेबाना। <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />तेहि ङाला चोँङान यि धोप्पा धि ना, कि ख्युइ ङाला पिपिनि नाङने सुलाङ ङाहि ढोरु झ्युयाप माना, हिन्नाङ खेला सिनि ङिन सोम्बो सोइरे लोङयापयि चाला। <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />चिचालानाना ङाहि आकि धोप्पा धिना, कि पिजाला ताङानला राङ ख्युइ थोला हिछे किङान पोरोला नामयाङ मिसिनयापयि मिजे होङ राङ, राङ ङा हतिला सिनि ङिन सोम्बो सोज्याइ।”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />यहुदिबा येशुयि विरोधला नाला छेलसोङ चिचालानाना ख्युइ नाइसोङ, “तेङलाने पुपुबि लोटा ङा राङना।” <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />हतिबे नाइसोङ, “च्हि धि योसेफयि पिजा, येशु मानाइ? ख्युइ आके राङ आमाला हुइ ङोमिस्येबाइ च्हि? थाल्ला धि च्हिरु ‘ङा तेङलाने लेप्ते’ नाइरे नेन्दु?”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />येशुयि हतिबाला जवाक पिन्सोङ, “खे खिरि नाङला स्युताम नारे माके। <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />ङाला चोँङानयि आकि मा टुइना सुइ याङ ङाहि तिया होङ मिङ्युइबा, राङ ङा हतिला सिनि ङिन सोम्बो सोज्याइ। <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />‘तेहि हति पोरो कजसुबाने लोपङान ना नाइरे’ ङोन्सेखिलङानयि किताबला टिटिबा दु। पोरो सुइ आकेने ङ्यानिन राङ स्येयिन हति ङाहि तेहा हुन।<note caller="-" style="x"><char style="xo" closed="false">6:45 </char><char style="xt" closed="false"><ref loc="ISA 54:13">यशैया ५४:१३</ref></char></note> <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />आकेला मि सुइ याङ थोथोवा मेता मात्रा हति थोथोवा मेता। सुइ कजसुबाने लेलेबा होतो, हति राङ आकेला थोथोवा होतो। <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />तेम्बारे ङा खेला नाज्याइ, सुइ हिछे क्याइ हतिला नामयाङ मिसिनयापयि मिजे होतो। <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />ङा मिजेयि लोटा ना। <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />खि ताङबुइ कानाने साथुवाला मन्न साइरे हाङ स्यिरे पुइसोङ। <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />हिन्नाङ तेङलाने पापते होङानयि लोटा धि राङ ना, सुइ हति साइ हति मिस्यिया। <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />तेङलाने पापाबि सोम्बो लोटा ङा राङ ना। सुइ धि लोटा साइ हति बारतै मिसिया तोकिन। राङ काङ लोटा ङा संसारयि मिजेयि चाला तेरच्याइ, हतिते ङाहि स्हु ना।”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />तेहि यहुदिबा ख्होरे नाङला नारे किताला छेलसोङ, “धि मि च्हिरु क्याइरे खुरि स्हु हुला सारु जु ङ्युइकिन?” <verse eid="JHN 6:52" /><verse number="53" style="v" sid="JHN 6:53" />येशुयि हतिबाला नाइसोङ, “तेम्बारे, ङा खेला नाज्याइ, खि मि पिजि स्हु मासाइना, राङ ख्युइ ठा मातुना, खेला मिजे मिहा।” <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />ङाहि स्हु साङान राङ ङाहि ठा थुङान ला नामयाङ मिसिनयापयि मिजे दु, राङ सिनि ङिन हतिला सोम्बो सोज्याइ। <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />चिचालानाना ङाहि स्हु तेम्बारे सायापयि क्यु ना, राङ ङाहि ठा तेम्बारे थुङयाप यि क्यु ना। <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />ङाहि स्हु साङान राङ, ङाहि ठा थुङान ङाहि तेहा तोकिन, राङ ङा हतिला तोकिन। <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />च्हिरु क्याइरे सोम्बो आकि ङाला चाँरे, राङ ङा आकि चाला सोम्बो होतो, हति च्वरा क्याइरे ङाला साङान याङ ङाहि क्याइरे सोम्बो लुइङान ना। <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />“तेङलाने लेलेबि धि लोटा धि च्वरा माना काङते ताङबुइ काने साइनाङ स्यिरे पुते। धि लोटा साङान ते बारतै सोम्बो त्योएङान ना।” <verse eid="JHN 6:58" /><verse number="59" style="v" sid="JHN 6:59" />ख्युइ धि ताम कफर्नहुम यहुदि झोमसि खिमला छोइ लोबितुइना नाइरेलो।<verse eid="JHN 6:59" /></para>
  <para style="s">नामयाङ मिसिनयापयि मिजेयि वचन</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />धि ताम थोइरे ख्युइ लोब्टु लेइराङ नाङने नाइसोङ, “धि वचन काबोदु, सुइ धि ङयान ङ्युइकिनाइ?” <verse eid="JHN 6:60" /><verse number="61" style="v" sid="JHN 6:61" />हिन्नाङ ख्युइ लोब्टुतेबा भारेला ख्होरे नाङला नारे किन्दु नाइरे हा:कोरे येशुयि हतिबाला नाइसोङ, “च्हि धि ताम खि चाला पारछ्ये हुन दुये? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />खि मि पिजा ताङला खो काँहा होए हतिने पुपकिन ताताता थोङसोङ कि च्हिरु? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />मिजे तेरङान कजसुबायि आत्मा ना, स्हुने च्याङ मिहा। काङ वचन ङाहि खेला नाइरे, हति कजसुबायि आत्मा राङ मिजे ना। <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />हिन्नाङ खि नाङने चोम होतो, सुइ हिछे मि किता” चिचालानाना खोला हिछे मि किङान सुगासुगा ना, राङ खोला धोका तेरङान सु हुन नारे येशुला ताङलाने राङ छ्या होतो। <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />येशुयि नाइसोङ, “हति चाला ङाहि नानाइबा होए आकि आङ मा पिनथु सुयाङ ङा होएसा ना होङ मिङ्युइबा।” <verse eid="JHN 6:65" /><verse number="66" style="v" sid="JHN 6:66" />हतिच्येला ख्युइ लोब्टु लेइराङ क्यापला पुइसोङ राङ खो ङ्याबो टालटियाप ताङदेलो। <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />येशुयि लोब्टु च्युनङिगारला नाइरेलो, “च्हि खे याङ ङाला तादे ढोज्ये?” <verse eid="JHN 6:67" /><verse number="68" style="v" sid="JHN 6:68" />सिमोन पत्रुसयि जवाक पिन्देलो, “हे प्रभु, ङे सुइ तेहा ढोज्याइ? ख्योए ङ्याबो नामयाङ मिसिनयापयि मिजेयि वचन दु।<note caller="-" style="x"><char style="xo" closed="false">6:68 </char><char style="xt" closed="false"><ref loc="MAT 16:16">मत्ति १६:१६</ref>; <ref loc="MRK 8:29">मर्कुस ८:२९</ref>; <ref loc="LUK 9:20">लुका ९:२०</ref></char></note> <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />राङ ङाहि हिछे क्याक्याइबा होतो राङ ङोस्येस्येबा होतो, ख्योए कजसुबे पवित्र मि ना।” <verse eid="JHN 6:69" /><verse number="70" style="v" sid="JHN 6:70" />येशुयि हतिबाला जवाक पिन्सोङ, “च्हि ङा ङारि खे च्युनङिगारला धाधामा मानाइ? तेहि खि नाङने च्हि ते तुइ ना।” <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />धि ख्युइ सिमोन इस्करियोतयि पिजा यहुदायि भारेला नानाइबा हिना, चिचालानाना च्युनङियि नाङने च्हि क्याइरे याङ ख्युइ येशुला धोका तेर च्युइ क्याइसोङ।<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">येशु राङ ख्युइ भाइतेबा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />हतिच्येला येशु गालिलला राङ युकिन त्येसोङ हिन्नाङ खो यहुदियाला ढोसोम मेतालो चिचालानाना यहुदि आङकिङान खोला सोयापयि च्युइला होतो। <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />तेहि यहुदिबे छाप्रो कालापसोल धुनला होतो। <note caller="-" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="LEV 23:34">लेवि २३:३४</ref>; <ref loc="DEU 16:13">व्यवस्था १६:१३</ref></char></note> <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />हतिचाला येशुयि भाइतेबे खोला नाइरेलो, “धि सा ताङदे यहुदियाला क्यु, राङ ख्युइ क्याक्याइबि लाइतेबा ख्युइ लोब्टुतेबे थोङोङ। <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />सु मियि तहोन तुइच्याइ धोप्पा किन, हति फाला लाइ मिकिता। ख्युइ धि लाइतेबा किना संसारला थोङदु छ्यु।” <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />चिचालानाना ख्युइ भाइतेबे याङ खोला हिछे मिकितालो। <verse eid="JHN 7:5" /><verse number="6" style="v" sid="JHN 7:6" />येशुयि हतिबाला नाइसोङ, “ङाहि थारका भेला तरह लेलेबा मेता, हिन्नाङ खि चालाता पोरो भेला थारका हिना। <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />संसारयि खेला मिका कि मिङ्युइबा, हिन्नाङ ङाला मिका किन, चिचालानाना संसारयि भारेला ख्युइ लाइ तेबा अल दु नाइरे ङा साछि तेरच्याइ। <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />खे धि कालापसोङला क्यु। ङा धि कालापसोङ ला मिढो चिचालानाना ङाहि भेला थाल्ला थु पुरा च्युच्युङा मेता।” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />हतिबाला जु नाइरे खो गालिलला राङ त्येसोङ।<verse eid="JHN 7:9" /></para>
  <para style="s">कुरयि कालापसोलला येशु</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />हिन्नाङ ख्युइ भाइतेबा कालापसोलला पुते खो याङ मनस्याङ ला माना, हिन्नाङ येशु हिबिनहिबिन पुइसोङ। <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />कालापसोलला यहुदि आङकिङनबे खोला फाकिन त्येतु, राङ “खो काँहा होतो?” नाइरे ढुन्दु।<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />मि झोमयि उइला ख्युइ भारेला ह:लाइ धुलो। रेन नेन धुलो, “खो ल होतो।” स्यानयि नेन्दुलो, माना, “ख्युइ मि तेबाला आच्यामाच्या सुन्दु।” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />हिन्नाङ यहुदि आङकिङानतेबा झिरे सुङ धुनला ताम मिनालो।<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />कालापसोलयि उइला येशु मोनलाम क्यासि खिमला नाङला स्युसोङ, राङ छोइ पिन्सोङ।<verse eid="JHN 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 7:15" />यहुदिबा हा:लाइरे जु नाइसोङ, “च्याङ छोइ मालाबि धि च्हिरु क्याइरे धि झोम छोइ स्येबे?” <verse eid="JHN 7:15" /><verse number="16" style="v" sid="JHN 7:16" />तेहि येशुयि हतिबाला जवाक तेरिन राङ नाइसोङ, “ङाहि छोइ ङाहि माना, हिन्नाङ कजसुबे ना, सुइ ङाला चाँरे। <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />तेम्बारे सुङ मि कजसुबे धोप्पा ङ्यान्सोम होएना, ङाहि छोइ कजसुबाने ना, कि ङाहि चाने ना खो खुरि हा:कोङान ना। <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />सुइ रेँ चाने नेन, खो खुरि सम्मान फाकिन, हिन्नाङ सुइ रेँ चोँङान यि सम्मान फाकिन हति तेम्बाना, राङ खोला चुन मेता। <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />च्हि मोशायि खेला ठिम मापिन्सोए? हिन्नाङ खे सुइयाङ हति ठिम मिङ्याना। खे ङाला चिचाला सोए च्युइ किन?” <verse eid="JHN 7:19" /><verse number="20" style="v" sid="JHN 7:20" />मि झोम यि जवाक पिन्सोङ, “ख्योएला ढे कालदु?” “सुइ ख्योएला सोए च्युइ क्यासुइ?” <verse eid="JHN 7:20" /><verse number="21" style="v" sid="JHN 7:21" />येशुयि जवाक तेरिन राङ हतिबाला नाइसोङ, “हा:लाइयापयि लाइ झि ङाहि क्याइरे, तेहि खे पोरो हतिला हा:लाइन्दु। <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />मोशायि खेला खतनायि ठिम पिन्दु यिनज्याइता हति मोशाने ता माना हिन्नाङ ताङबुइ कानाने ना, तेहि याङ ङालसुइ ङिनला खे मिला खतना <note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">पिजे धुनयि फायि टुपुते तुइपयाप</char></note>किन्दु।<note caller="-" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="GEN 17:10">उत्पत्ति १७:१०</ref>; <ref loc="LEV 12:3">लेवि १२:३</ref></char></note> <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />मोशायि ठिम मासि मायोङ नाइरे तेम्बारे मि सुयाङ ङालसुइ ङिनला खतना क्याइ ना, ङाहि ङालसुइ ङिनला मिझि टाक्तु च्युक्ते नाइरे च्हि खे ङाला स्येताङ किनाइ?” <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />च्ये ताइरे माना, हिन्नाङ ल क्याइरे तेम्बा ल अल फे।<note caller="-" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="ISA 11:3">यशैया ११:३</ref>; <ref loc="JHN 8:15">युहान्ना ८:१५</ref></char></note><verse eid="JHN 7:24" /></para>
  <para style="s">च्हि खो ख्रिष्ट हिनाइ?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />यरुश्लेमला मि रेनरेनयि नाइसोङ, “च्हि धि खो मानाइ, सुला यहुदि आङकिङानतेबे सोच्याइ फाकिन्दु? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />तेहि, धिनि मनस्याङ क्याइरे ताम नेन दु, हिन्नाङ हतिबा धिला च्याङ मिना! च्हि धि राङ ख्रिष्ट हिना नाइरे आङकिङानतेबे तेम्बारे हा:कोरेइ? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />हिन्नाङ जब ख्रिष्ट हुन, खो काँहा होतो नाइरे सुइ याङ हा:मिकुवा।” हिन्नाङ ङेला छ्या होतो धि मि काने लेलेबा ना। <verse eid="JHN 7:27" /><verse number="28" style="v" sid="JHN 7:28" />तेहि येशुयि यरुशलेम मोनलाम क्यासि खिमला छोइ लोभि तुइना, ख्युइ क्ये छेया क्याइरे नाइसोङ, “खि ङाला ङोस्येयिन, राङ ङा काने लेलेबाना, हति याङ छ्या होतो। ङा ङारि धोप्पि लेलेबा माना हिन्नाङ सुइ ङाला चाँरे हति तेम्बा ना। खि खोला ङोमिस्येबा <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />हिन्नाङ ङाहि खोला ङोस्येयिन, चिचालानाना ङा खोने लेलेबाना राङ ख्युइ ङाला चाँचाँबाना।” <verse eid="JHN 7:29" /><verse number="30" style="v" sid="JHN 7:30" />हतिचाला खि खोला सुङज्याइ पाते, हिन्नाङ सुइ याङ लाक्पा माक्याङसोङ, चिचालानाना ख्युइ भेला तरह लेलेबा मेता। <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />हिन्नाङ मि झोमयि मि लेइ ख्युइ थोला हिछे क्याइसोङ। हतिबे नाइसोङ, “जब ख्रिष्ट हुन, हतितुइना च्हि धि क्याक्याइबि धि हा:लाइयापयि लाइले महा हा:लाइयापयि लाइ ख्युइ क्यायोङ ङे च्हि?”<verse eid="JHN 7:31" /></para>
  <para style="s">येशुला सुङदु कोराबाला चाँरेलो</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />मि झोमयि येशुयि भारेला हल्ला क्याक्याइबा फरिसिबे थोइसोङ। तेहि घोबा पुजारितेबा राङ फरिसिबे तुमयि खोला सुङयापयि चाला कोराबातेबे तुम झि चाँसोङ। <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />येशुयि नाइसोङ, “तरह हाङ टिझिथु ङा खे ङ्याबो हुन, हतिच्येला ङा ङाला चोँङानयि तेहा ढोज्याइ। <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />खि ङाला फेङान ना हिन्नाङ खुङान मानाना, राङ काँहा ङा हुन, खे हतिया होङ मिङ्युइबा।” <verse eid="JHN 7:34" /><verse number="35" style="v" sid="JHN 7:35" />तेहि यहुदिबे नाङला नारे क्याइसोङ, “खो काँहा ढोज्याइ लुइ, राङ हु खोला ङान ठेङान माना ना? च्हि खो ग्रिक भजारयि यि उइला थोरते ताताति यहुदिबे तेहा पुते ग्रिकबाला छोइ तेरसोम किन दुये? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />ख्युइ नानाइबि धि वचन चिना? ‘खि ङा ला फेङान ना, राङ खुङान मानाना, राङ काँहा ङा हुन, खे होङ मिङ्युइबा?’”<verse eid="JHN 7:36" /></para>
  <para style="s">मिजे तेरङानयि छुयि लुङबा</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />तेहि कालापसोलयि ङिमा च्येमाते, मदलब कालापसोलयि ङोधो ङिनला, लाँरे येशुयि क्ये छोम्मुवाला जु नाइसोङ, “तेम्बारे सुङ खा कोम ना ङाहि तेहा सअ राङ थुङ।<note caller="-" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="LEV 23:36">लेवि २३:३६</ref></char></note> <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />सुइ ङाला हिछे क्याइ, पवित्रशास्त्राला नानाइबाला च्वरा क्याइना ‘ख्युइ टोपि तिङने सोम्बो छ्युयि लुङबा थोन्देहुन।’” <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />हिन्नाङ ख्युइ धि ताम पवित्र आत्मायि भारेला नानाइबाना, काङ पवित्र आत्माते ख्युइ थोला हिछे किङानतेबे खुबाला छेलसोङ। चिचालानाना पवित्र आत्मा थाल्ला थु पिपिना मेतालो, चिचालानाना येशुयि छे ङाला थु तेतेका मेतालो।<verse eid="JHN 7:39" /></para>
  <para style="s">मियि उइला पेपेया</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />धि ताम थोइङान मि रेन रेनयि जु नाइसोङ, “धिनि तेम्बारे ङोन्सेखिलङान हिना।” <note caller="-" style="x"><char style="xo" closed="false">7:40 </char><char style="xt" closed="false"><ref loc="MAT 21:11">मत्ति २१:११</ref></char></note> <verse eid="JHN 7:40" /><verse number="41" style="v" sid="JHN 7:41" />स्यानतेबे नाइसोङ, “धि ख्रिष्ट ना।” हिन्नाङ रेनरेनयि नाइसोङ, “च्हि ख्रिष्ट गालिलने हुनाइ च्हि? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />च्हि पवित्रशास्त्रयि मानाइ दुये च्हि, कि ख्रिष्ट दाउदयि ख्युइने राङ दाउदयि भजार बेथलेहेमने हुन?”<note caller="-" style="x"><char style="xo" closed="false">7:42 </char><char style="xt" closed="false"><ref loc="2SA 7:12">२ शमुएल ७:१२</ref>; <ref loc="MIC 5:2">मिका ५:२</ref></char></note> <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />हतिचाला येशु चाला मितेबे उइला तुम ङि खा पे सोङ। <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />हतिबे नाङने चोमयि खोला सुङ च्युइ क्याइसोङ, हिन्नाङ ख्युइ थोला सुइ याङ लाक्पा माक्याङालो।<verse eid="JHN 7:44" /></para>
  <para style="s">यहुदि आङकिङानबे हिमिछे</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />तेहि मोनलाम क्यासि खिमयि कोराबातेबा घोबा पुजारितेबा राङ फरिसितेबे तेहा लेप्सोङ। हतिबे हतिबाला नाइरेलो, “खि हतिला चिचाला माख्योँबा?” <verse eid="JHN 7:45" /><verse number="46" style="v" sid="JHN 7:46" />कोराबातेबे जवाक पिन्सोङ, “हति मि च्वरा सुइ याङ नामयाङ मानाइसोङ!” <verse eid="JHN 7:46" /><verse number="47" style="v" sid="JHN 7:47" />फरिसिबे हतिबाला नाइसोङ, “खे याङ ख्युइ तामला भुलि च्युङसुइ कि च्हिरु? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />च्हि आङकिङान आथावा फरिसिबे नाङने सुइ याङ ख्युइ थोला हिछे क्याइ दुये? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />हिन्नाङ धि मिझोम, सुइ मोशायि ठिम हा:मिकुवा, हतिला कजसुबायि छार चुचुबा हुन।”<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />हतिबे नाङने च्हि फरिसि सुइ मिन निकोदेमस ना, सु ताङला लाम्मा झि येशुयि तेहा लेप्सोङ, ख्युइ नाइरेलो, <note caller="-" style="x"><char style="xo" closed="false">7:50 </char><char style="xt" closed="false"><ref loc="JHN 3:1-2">युहान्ना ३:१-२</ref></char></note> <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“च्हि हुइ ठिमयि ताङस्युवा मिति नानाइबा माना राङ हति च्हि क्याइरे नाइरे हा:माकुवा हतिला दोषि नाज्याइ खुकिनाइ?” <verse eid="JHN 7:51" /><verse number="52" style="v" sid="JHN 7:52" />हतिबे खोला जवाक पिन्सोङ, “च्हि ख्योए याङ गालिलयि हिनाइ? पवित्र शास्त्रा पाते तेहि, राङ तेहि खि थोङान ना, कि गालिलने ङोन्सेखिलङान मिथोना।” <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />तेहि पोरो राँ राँसि खिमला पुइसोङ।<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">पतार वातारला थेथेबा पोमुवाबा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />हिन्नाङ येशु जैतून सुरला पुइसोङ। <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />खो जब थरह याङ मोनलाम क्यासि खिमला पुइसोङ, राङ मि पोरो ख्युइ तेहा लेप्सोङ, राङ खो त्येसोङ, राङ हतिबाला छोइ पिन्सोङ। <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />शास्त्रि राङ फरिसिबाबे पतारला थेथेबि पोमुवा झिला ख्योँदु, राङ हतिला उइला लाङसोङ। <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />हतिइ येशुला नाइसोङ, “गुरुज्यु, धि पोमुवा पातार कितितुइना सुसुङा ना। <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />ठिमला मोशायि धि च्वरा पोमुवाला टोउ क्याप नाइरे हुला आदेश च्युतु ख्योए धि भारेला च्हि नाज्याइ?” <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />हिन्नाङ हतिबे खोला छोए तायापला राङ ख्युइ थोला आरोप जुयाप ङ्युइन नारे जु नाइरेलो। येशुयि साला क्हुरकुर क्याइरे झुयि टिसोङ।<verse eid="JHN 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 8:7" />हिन्नाङ जब ख्होए येशुला ढिन राङ ताताता होतो, हतितुइना ख्युइ लाँरे हतिबाला नाइसोङ, “खि नाङने सु तिक्पा माक्याइबा होए हति राङ धि पोमुला ताङस्युवा टोउ क्योप।” <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />याङ ख्युइ कुरकुर क्याइरे साला झुयि टिसोङ। <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />हिन्नाङ जब हतिबे धि थोइरे, हतितुइना छोम्मुवाने सुरु क्याइरे टिमा थु च्यिच्यि क्याइरे पुइसोङ, राङ येशुला हति पोमु ङ्याबो चिक्पा पोरसोङ, तेहि हति पोमुते ख्युइ धुन्नला लाँरे त्येसोङ।<verse eid="JHN 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 8:10" />येशुयि हति पोमुला ताइरे नाइसोङ, “ए पोमु हतिबा काँहा पुइसुइ? च्हि सुयाङ ख्योएला ङेबा मापिन्सोए?” <verse eid="JHN 8:10" /><verse number="11" style="v" sid="JHN 8:11" />हति नाइसोङ, “प्रभु, सुइ याङ मा पिन्सोङ।” येशुयि नाइसोङ, “ङा ख्योएला ङेबा मितेर। कु, याङ तिक्पा माके।”<verse eid="JHN 8:11" /></para>
  <para style="s">येशु संसारयि होए</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />येशुयि याङ हतिबाला नाइसोङ, “ङा संसारयि होए ना। ङाहि च्येच्येला होङान मुन्नाला युङान मानाना, हिन्नाङ हतिला मिजेयि होए खुङान ना।”<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="JHN 9:5">युहान्ना ९:५</ref></char></note> <verse eid="JHN 8:12" /><verse number="13" style="v" sid="JHN 8:13" />तेहि फरिसिबे खोला नाइसोङ, “ख्योए खुरि भारेला साछि तेरिन्दु। ख्युइ साछि तेम्बा मिहा।”<note caller="-" style="x"><char style="xo" closed="false">8:13 </char><char style="xt" closed="false"><ref loc="JHN 5:31">युहान्ना ५:३१</ref></char></note><verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />येशुयि जवाक पिन्सोङ, “ङा ङारि भारेला साछि तेरच्याइ, हिन्नाङ ङाहि साछि तेम्बा ना। ङाला छ्या होतो, ङा काने लेलेबा ना, राङ का ढोयाप ना। हिन्नाङ खेला छ्या मेता ङा काने लेलेबाना, राङ काँहा ढोयाप ना।” <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />खे मि लुलामने ल अल भिन्दु। ङा सुलाङ ल अल भेयापयि लाइ मिकिता। <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />ङाहि ल अल भेयापयि लाइ क्याइना, ङाहि ल अल भेयापयि लाइ तेम्बा मिहा। चिचालानाना ल अल भेयापयि लाइ किङान ङा चिक्पा मेता, हिन्नाङ ङा होतो, राङ ङाला चोँङान आके होतो। <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />खि या ठिमला मि ङाहि साछि तेम्बा हुन नाइरे टिटिबादु।<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="DEU 19:15">व्यवस्था १९:१५</ref></char></note> <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />ङाहि भारेला ङा ङाराङ साछि तेरच्याइ, राङ ङाला चोँङानयि आकेयि ङाहि भारेला साछि तेरिन। <verse eid="JHN 8:18" /><verse number="19" style="v" sid="JHN 8:19" />हतिबे खोला नाइसोङ, “ख्युइ आके काँहा होतो?” येशुयि जवाक पिन्सोङ, “खि न ङाला ङोस्येयिन न ङाहि आकेला। खि ङाला ङो स्येस्येबा हिन ना ता ङाहि आकेला हाङ ङोस्येङान ना।”<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />धि ताम ख्युइ मोनलाम क्यासि खिमला छोइ लोबितुइना आलाइ तुइङान दान तोङानयि धुनला नानाइबा ना। तेहि सुइ याङ खोला मा सुङङा, चिचालानाना येशु भेला तरह लेलेबा मेता।<verse eid="JHN 8:20" /></para>
  <para style="s">ङा काँहा ढुन हतिया खे ढो मि ङ्युइबा</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />येशुयि याङ हतिबाला नाइसोङ, “ङा ढो छारच्याइ, राङ खि ङाला फेङान ना, खे खिरि तिक्पाला स्यिङान ना। काँहा ङा होतो, खे होङ मि ङ्युइबा।”<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />यहुदि आङकिङानबे नाइसोङ, “धिनि खो राङ रेँ राङला स्योएङान यिनटा कि च्हिरु? चिचालानाना ‘खो काँहा ढुन खे होङ मिङ्युइबा’ नाइरे नेन्दु।”<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />तेहि येशुयि हतिबाला नाइसोङ, “खे हकिना। ङा कोङी ना। खे धि संसारयि ना। ङा दु संसार यि माना। <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />ङाहि खेला नाइरे, ‘खे खेरि तिक्पाला स्यिङान ना, चिचालानाना ङा हति राङ ना नाइरे खि हिछे माक्याइना खिरि तिक्पाला स्यिङान ना।’”<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />हतिबे येशुला टिसोङ, “ख्योए सुना?” येशुयि हतिबाला नाइसोङ, “ङा हति राङ ना, काङते ङाहि खेला ताङलाने राङ नेन ताता होतो। <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />ङाहि खि भारेला ल अल भेयाप राङ समलो तोङयाप लेइराङ होतो हिन्नाङ ङाला चोँङान तेम्बा होतो, राङ ख्युइ चाने ङाहि च्हि थोइ संसारला हति ताम राङ नेन।”<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />आकि भारेला येशुयि नानाइबा हिना नाइरे हतिबे हा:माकुवा। <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />हतिचाला येशुयि नाइसोङ, “जब खि मि पिजा याला धेकिन, ङा हति राङ हिना नाइरे हा:कोङान्ना, राङ ङा ङारि आङ यि च्याङ मिकिता हिन्नाङ आकि लालाबि तामतेबा नेन नाइरे ङाला छ्या होतो। <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />ङाला चोँङान ङा ङ्याबो होतो। ख्युइ ङाला चिक्पा पोपोरा मेता चिचालानाना ङा बारतै ख्युइ सम क्याप यि लाइ मात्रा किन।” <verse eid="JHN 8:29" /><verse number="30" style="v" sid="JHN 8:30" />येशुयि धि ताम नेतुइना ता ङ्यान ङान लेइराङयि ख्युइ थोला हिछे क्याइसोङ।<verse eid="JHN 8:30" /></para>
  <para style="s">तेम्बा ख्योएला स्वतन्त्र सुन</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />येशुयि खुरि थोला हिछे किङान यहुदिबाला नाइसोङ, “खे ङाहि वचनला त्येना ङाहि तेम्बा लोब्टु ना। <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />तेहि खि तेम्बा च्हि ना नाइरे हा:कोङान ना, राङ तेम्बि खेला मनस्याङ सोङान ना।”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />हतिबे खोला जवाक पिन्सोङ, “ङे अब्राहामयि ख्युइ ना, राङ ङेला थाल्ला थु सुइयाङ यक्पुवा च्युङदे ताताता मेता। ‘खे मनस्याङ होङान ना’ नाइरे च्हिरु क्याइरे नेन?”<note caller="-" style="x"><char style="xo" closed="false">8:33 </char><char style="xt" closed="false"><ref loc="MAT 3:9">मत्ति ३:९</ref>; <ref loc="LUK 3:8">लुका ३:८</ref></char></note><verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />येशुयि हतिबाला जवाक पिन्सोङ, “तेम्बारे, ङा खेला नाज्याइ, तिक्पा किङान पोरो तिक्पि यक्पुवा ना। <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />यक्पुवा बारतै खिमला मितोता हिन्नाङ पिजा ते बारतै खिमला तोकिन।<note caller="-" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="GAL 4:30">गलाति ४:३०</ref></char></note> <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />हतिचाला पिजि खेला मनस्याङ सोइना खे तेम्बारे मनस्याङ होङान ना। <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />ङाला छ्या होतो, खे अब्राहामयि ख्युइ ना। हिन्नाङ खे ङाला सोच्याइ फाकिन्दु, चिचालानाना ङाहि वचनला खि तेहा त्योएसा मिखुबा। <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />काङकाङ ङाहि ङारि आके होतोला थोथोवा होतो, हति ङा नेन। खे याङ च्हि खि आकेने थोइ, हति किन।” <verse eid="JHN 8:38" /><verse number="39" style="v" sid="JHN 8:39" />हतिबे खोला नाइसोङ, “ङाहि आके नि आब्रहाम हिना।” येशुयि हतिबाला नाइसोङ, “खे आब्रहमयि मि हिन नाता, अब्राहामयि च्हि लाइ क्याइ हति किङान ना। <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />ङाहि कजसुबाने तेम्बा थोथोइबाते खेला नानाइबा होए, हिन्नाङ थाल्ला खे ङाला सोच्याइ फाकिन्दु। अब्राहाम धि च्वरा लाइ माक्याइबा। <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />खि आकि च्हि लाइ क्याइ खि याङ हति लाइ किन।” हतिबे खोला नाइसोङ, “ङा पातान्नि च्युङदे क्येक्येबा माना! ङाहि आके च्हि राङ होतो, हति कजसुबाना।”<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />येशुयि हतिबाला नाइसोङ, “कजसुबा खि आके हिना ता खि ङाला करि क्यायोङ ना, चिचालानाना ङा कजसुबाने थोथोना ना। ङा ङारि धोप्पि लेलेबा माना, हिन्नाङ ख्हुइ ङाला चाँचाँबा ना। <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />ङाहि नानाइबा खि चिचाला हा:मिकुवा धुइ? चिचालानाना खि ङाहि वचन ङ्यान मिङ्युइबा। <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />खे खिरि आके दियाबलसयि ना, खे खिरि आकि धोप्पा पुरा कियापला ख्युइ च्हि धोप्पा किन हति किन। खो ता ताङलाने राङ मिसोए हिना, राङ तेम्बा ङ्याबो खोला च्याङ मदलब मेता। चिचालानाना हतिला च्याङ तेम्बा मेता। जब खो चुन नेन, हति खुरि बानि च्वरा क्याइरे नेन। चिचालानाना हति चुन ना राङ चुनयि आके ना।<note caller="-" style="x"><char style="xo" closed="false">8:44 </char><char style="xt" closed="false"><ref loc="ACT 13:10">प्रेरित १३:१०</ref></char></note> <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />ङा तेम्बा नेन, हिन्नाङ खे ङाला हिछे मिकिता। <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />खि नाङने सुइ ङाला तिक्पि दोषि नाङ्युइकिन? तेम्बारे ङा तेम्बा नाना चिचाला खे ङाहि थोला हिछे मिकिता? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />सु कजसुबाने हुन, हति कजसुबे वचन ङ्यानकिन हिन ज्याइता खे कजसुबाने माना, हतिचाला खे मिङ्याना।”<verse eid="JHN 8:47" /></para>
  <para style="s">येशु राङ अब्राहाम</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />यहुदिबे खोला जवाक पिन्सोङ, “च्हि ङाहि धि नानाइबा तेम्बा मानाइ, कि ख्योए सामरि ना राङ ख्योएला ढे कालदु?” <verse eid="JHN 8:48" /><verse number="49" style="v" sid="JHN 8:49" />येशुयि जवाक पिन्सोङ, “ङाला ढे क्याकाला मेता, हिन्नाङ ङा ङारि आकि सम्मान किन, राङ खे ङाहि सम्मान किन्दु। <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />हिन्नाङ ङा ङारि छे मिफाता, च्हि होतो सुइ खुरि छे फाकिन राङ ल अल भेयापयि किन। <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />तेम्बारे ङा खेला नाज्याइ, तेम्बारे सुइ ङाहि वचन ङ्यान हति नामयाङ मिसिया।” <verse eid="JHN 8:51" /><verse number="52" style="v" sid="JHN 8:52" />यहुदिबे खोला नाइसोङ, “ता ङेला छ्या च्युङसोङ, ख्योएला ढे कालदु। अब्राहाम स्यिरे पुइसोङ, ङोन्सेखिलङान याङ स्यिसोङ, हिन्नाङ ख्योए नेन्दु, ‘सु ङाहि वचन ङ्यान हति नामयाङ मिसिया नाइरे।’ <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />च्हि ङाहि ताङबुइ अब्राहामले ख्योए छेया हिनाइ? खो स्यिरे पुइसोङ, तेहि ङोन्सेखिलङान याङ स्यिरे पुइसोङ। ख्योए ते ख्योराङ सु हिना नाइरे दाबि किन?” <verse eid="JHN 8:53" /><verse number="54" style="v" sid="JHN 8:54" />येशुयि जवाक पिन्सोङ, “तेम्बारे ङा ङारि छे त्येना ङाहि छे तेतेका फान मिहा। ङाहि छे धेङान ङाहि आके होतो, काङला खि ङाहि कजसुबा नेन। <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />खि खोला जब याङ ङोस्येस्येबा मेता, हिन्नाङ ङाहि खोला ङोस्येयिन। ङाहि खोला ङोमिस्येबा नाइना ङा खे च्वरा चुन हुन। हिन्नाङ ङाहि खोला ङोस्येयिन, राङ ख्युइ वचन ङ्यान किन। <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />खि ताङबुइ अब्राहाम ङाहि धि ङिन थोङज्याइला क्याका होतो, राङ ख्युइ थोङसोङ राङ कारे।” <verse eid="JHN 8:56" /><verse number="57" style="v" sid="JHN 8:57" />हतिचाला यहुदिबे खोला नाइरेलो “ख्योए तरह लो ङोपच्यु माक्योबि, चिला अब्राहामला थोङसोङ नेन?” <verse eid="JHN 8:57" /><verse number="58" style="v" sid="JHN 8:58" />येशुयि हतिबाला नाइसोङ, “तेम्बारे ङा खेला नाज्याइ, अब्राहामले होङ ज्याइले ताङला राङ ङा होतो।” <verse eid="JHN 8:58" /><verse number="59" style="v" sid="JHN 8:59" />तेहि हतिबे खोला क्याकच्याइ नाइरे टोउ तुरेलो, हिन्नाङ येशु हिप्ते मोनलाम क्यासि खिमने फिला थोन्दे पुइसोङ।<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">येशुयि क्येने राङ कानाला मिला टाक्तु च्युच्युका</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />हतिने ढुन ताताताला येशुयि क्येने राङ काना झिला थोङसोङ। <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />ख्युइ लोब्टुबे खोला टिसोङ, “गुरुज्यु, सुइ तिक्पा क्याइरे, धि कि धिबे आके आमायि, राङ धि काना च्युङदे?” <verse eid="JHN 9:2" /><verse number="3" style="v" sid="JHN 9:3" />येशुयि जवाक पिन्सोङ, “न त धि तिक्पा क्याइरे न त धि आके आमायि, हिन्नाङ धि चाला च्युङदे कि कजसुबे लाइ धि मि मिजेला सअ नाइरे। <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />जब थु ङिन होतो हति थु हु राङला चोङानयि लाइ कि कोयिन, छान स्यारिन दु स्यान सुइ याङ लाइ कि मिङ्युइबा। <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />ङा संसारला होएहोए थु ङा संसारयि होए ना।”<note caller="-" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="MAT 5:14">मत्ति ५:१४</ref>; <ref loc="JHN 8:12">युहान्ना ८:१२</ref></char></note><verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />धि ताम नाइरे ख्युइ साला छिमा ताप्सोङ, राङ छिमायि साबे च्हिरे धाबा स्यिरे हति मिला कुइसोङ। <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />तेहि ख्युइ हतिला नाइसोङ, “कु, सिलोआमयि चाँचाँबि चिङला पुते स्योल।” हति पुते टिसो राङ थोङान च्युङदे लेप्सोङ। <verse eid="JHN 9:7" /><verse number="8" style="v" sid="JHN 9:8" />हति खिमजे राङ हतिला लोङमा लोङान थोङानतेबे नाइसोङ, “ताते लोङान ते धि मानाइ च्हि?” <verse eid="JHN 9:8" /><verse number="9" style="v" sid="JHN 9:9" />रेनरेनयि नाइसोङ, “धि हति राङ ना।” “स्यानतेबे नाइसोङ, माना, हति च्वरा थोङिन्दु।” हति नाइसोङ, “ङा हति राङ ना” <verse eid="JHN 9:9" /><verse number="10" style="v" sid="JHN 9:10" />तेहि हतिबे हतिला टिसोङ, “ख्युइ मि ख्योए च्हिरु क्याइरे थोङ ङ्युइङान च्युङसुइ?” <verse eid="JHN 9:10" /><verse number="11" style="v" sid="JHN 9:11" />हति जवाक पिन्सोङ, “येशु नाङान मि झिकि साबि धाबा सोइरे थाहि मिला कुइरे ङाला नाइसोङ, ‘सिलोआमला कु राङ सोल।’ तेहि पुते ङाहि टिरे, तेहि ङा तोङान च्युङसोङ।” <verse eid="JHN 9:11" /><verse number="12" style="v" sid="JHN 9:12" />हतिबे हतिला नाइसोङ, “खो का धुइ?” हति नाइसोङ, “ङाला छ्या मेता।”<verse eid="JHN 9:12" /></para>
  <para style="s">टाटाकाति भारेला ढोयाप फेयाप</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />तेकि काना होएता हति मितेला हतिबे फरिसिबे तेहा ख्योँदु सोङ। <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />काङ ङिन येशुयि साबि धाबा मिला कुइरे मि प्येसुइ हति ङिनते ङालसुइ ङिन हिना। <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />फरिसिबे हतिला टिसोङ, “ख्योए च्हिरु क्याइरे थोङान च्युङसुइ?” हति हतिबाला नाइसोङ, “ख्युइ ङाहि मिला साबि धाबा कुइसोङ, तेहि ङाहि स्यालदे राङ थोङान च्युङसोङ।”<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />फरिसिबे नाङने रेनरेनयि नाइसोङ, “हति मि कजसुबाने लेलेबा माना, चिचालानाना हति ङालसुइ ङिन मानि मिकिता” हिन्नाङ स्यानतेबे नाइसोङ, “च्हिरु क्याइरे तिक्पा किङान मिबे धि च्वरा हा:लाइयापयि लाइ किङ्युइ किन?” राङ हतिबे उइला पेयाला छेलसोङ। <verse eid="JHN 9:16" /><verse number="17" style="v" sid="JHN 9:17" />हतिबे हति मि कानाला याङ टिसोङ, “ख्हुइ ख्युइ मि पेदु, ता ख्योए ख्युइ भारेला च्हि नाज्याइ?” हति जवाक पिन्सोङ, “खो ङोन्सेखिलङान मि ना।”<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />मि पेपेयि आके आमाला मा ख्योँरे मा टि थु यहुदिबे खो मि काना हिना राङ थोङान च्युङदे नाइरे हिछे मा क्याइबालो। <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />तेहि हतिबे हतिबाला टिसोङ, “च्हि धि खि च्यिबा हिनाइ स्यु काना क्येक्येबा होतो नारे खे नेन्दु? ता खो च्हिरु क्याइरे थोङान च्युङसुइ?” <verse eid="JHN 9:19" /><verse number="20" style="v" sid="JHN 9:20" />हति आके आमायि हतिबाला नाइसोङ, “ङेला छ्या होतो धि ङाहि पिजा हिना, राङ काना राङ क्येक्येबा ना। <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />ता धि च्हिरु क्याइरे थोङान च्युङदे नाइरे ङेला छ्या मेता, धि मि सुइ पेरे ङेला छ्या मेता। ख्युइ लो छाँछाँ होतो खोराङ ला टि। खुरि भारेला खो खोराङ नाङान ना।” <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />ख्युइ आके आमायि धि ताम नाइसोङ, चिचालानाना हतिबा यहुदि आङकिङानला झियिनलो। चिचालानाना सुइ याङ हतिला ख्रिष्ट हिना नाइरे ङ्यान ना, हतिला यहुदि झोमसि खिमने धोन कोकिन नाइरे यहुदिबे तेकि राङ रुताम क्याइसोङ। <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />हतिचाला हति आके आमायि नाइसोङ, “ख्युइ हा:कोङान च्युङ छाछारा होतो, धि राङ ला टि।”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />हतिबे हति मिला सु क्येने राङ काना होतो, याङ लक्ते सह नाइरे, हतिला नाइसोङ, “कजसुबायि धुनला नाक्योल कि ख्योए तेम्बा ताम नाज्याइ! ङेला छ्या होतो कि हति पिजा सुइ ख्योएला थारका सोइरे हति राङ तिक्पा किङान ना।” <verse eid="JHN 9:24" /><verse number="25" style="v" sid="JHN 9:25" />हति जवाक पिन्सोङ, “खो तिक्पा किङान हिना कि माना ङाला छ्या मेता। ताम झि मात्रा ङाला छ्या होतो कि ङा काना होतो, हिन्नाङ ता थोङान च्युङसोङ।” <verse eid="JHN 9:25" /><verse number="26" style="v" sid="JHN 9:26" />तेहि हतिबे खोला नाइसोङ, “हति ख्योएला च्हि क्याइ सुइ? ख्हुइ ख्युइ मि च्हिरु क्याइरे पेसुइ?” <verse eid="JHN 9:26" /><verse number="27" style="v" sid="JHN 9:27" />हति हतिबाला जवाक पिन्सोङ, “ङाहि खेला तेकि राङ नाइछारते, हिन्नाङ खि माङ्यानसोङ। ता याङ चिचाला ङ्यान्सोम हुन्दुइ? खे याङ ख्युइ लोब्टु होङ सोम हुन्दुये कि च्हिरु?”<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />हतिबे हतिला ङारकिन राङ नाइसोङ, “ख्योए पु ख्युइ लोब्टुना, हिन्नाङ ङेता मोशायि लोब्टु ना। <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />ङेला छ्या होतो मोशा ङ्याबो कजसुबे ताम नाइरे, हिन्नाङ ङेला छ्या मेता धि मिते सुना।” <verse eid="JHN 9:29" /><verse number="30" style="v" sid="JHN 9:30" />हति मि हतिबाला जवाक तेरिन राङ नाइसोङ, “हा:लाइयापयि ताम! खो काने लेलेबा ना ता खेला छ्या मेता हिन्नाङ ङाहि मि ख्युइ प्येसुइ। <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />ङेला छ्या होतो कि कजसुबे मि तिक्पा किङानयि ताम मिङ्याना हिन्नाङ कजसुबाला झिङान राङ ख्युइ धोप्पा ङ्यानङानयि मि ताम कजसुबे ङयान किन।<note caller="-" style="x"><char style="xo" closed="false">9:31 </char><char style="xt" closed="false"><ref loc="PRO 15:29">हितोपदेश १५:२९</ref></char></note> <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />संसार सुरु च्युङने राङ थाल्ला थु क्येने राङ कानायि मि पेपेयि ताम नामयाङ माथोइ। <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />तेम्बारे धि मि कजसुबाने लेलेबा अर्थात धि च्याङ कि मिङ्युइबा।” <verse eid="JHN 9:33" /><verse number="34" style="v" sid="JHN 9:34" />हतिबे खोला जवाक तेरिन राङ नाइसोङ, “ख्योए ता तिक्पाला राङ क्येक्येबाना, राङ च्हि ता ख्योए ङेला लोप्सोम हुनदुये?” तेहि हतिबे खोला फिला तोन्सोङ।<verse eid="JHN 9:34" /></para>
  <para style="s">आत्मिक धने काना</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />हतिबे हतिला फिला तोन्सोङ नाङानयि ताम येशुयि थोइसोङ, राङ हतिला ठाते नाइसोङ, “च्हि ख्योए मि पिजि थोला हिछे किनाइ?” <verse eid="JHN 9:35" /><verse number="36" style="v" sid="JHN 9:36" />हतिला जवाक तेरिन राङ नाइसोङ, “प्रभु, खो सुना? ङा ख्युइ थोला हिछे किच्याइ?” <verse eid="JHN 9:36" /><verse number="37" style="v" sid="JHN 9:37" />येशुयि हतिला नाइसोङ, “ख्युइ खोला थोथोङा होतो, तेहि ख्योए ङ्याबो ताम नाङान हति राङ ना।” <verse eid="JHN 9:37" /><verse number="38" style="v" sid="JHN 9:38" />तेहि हति नाइसोङ, “प्रभु, ङा हिछे किन” राङ हति खोला काङबाला छ्या क्याइसोङ। <verse eid="JHN 9:38" /><verse number="39" style="v" sid="JHN 9:39" />तेहि येशुयि नाइसोङ, “ङा ल अल भेयापयि चाला धि संसारला लेप्ते, कि मिथोङानतेबा थोङान राङ थोङान तेबा मिथोङान हुन नाइरे।” <verse eid="JHN 9:39" /><verse number="40" style="v" sid="JHN 9:40" />धि ताम थोइरे ख्युइ धुनला होएता फरिसि रेनरेनयि नाइसोङ, “च्हि ङे हाङ काना हिनाइ च्हि?” <verse eid="JHN 9:40" /><verse number="41" style="v" sid="JHN 9:41" />येशुयि हतिबाला नाइसोङ, “खे काना हिन नाता तिक्पि दोषि होङान माना ना, हिन्नाङ ङि थोङिन दु, नेन्दु, हतिचाला खि तिक्पा ताताति ताताता किन।”<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">रच्चियायि भारेला पे</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />येशुयि नाइसोङ, “तेम्बारे, ङा खेला नाज्याइ, काङ लु रायि कोने नाङला मिसुबा, हिन्नाङ स्यानयोने झिरे स्युयिन, हतिते कुम्मा राङ डाकुना, <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />हिन्नाङ कोने नाङला स्युङानते लुयि रच्चिया ना। <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />को भेङानयि ख्युइ चाला को भिन, राङ लु तेबे ख्युइ क्ये ङ्यान किन राङ ख्युइ खुरि रेँ लु तेबाला मिन नेननेन क्ये तोङिन, तेहि हतिबाला फिला खेरिनलो। <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />जब ख्युइ खुरि लु पोरोला फिला तोन्दे खेरिन, खो हतिबे ताङताङला ढुन, राङ लु तेबे ख्युइ क्यापला हुन, चिचालानाना हतिबे ख्युइ क्ये ङोस्येयिनलो। <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />हिन्नाङ ङो मिस्येङानयि क्यापला हतिबा मिढुवा, हिन्नाङ हति टोइरे ढुनलो। चिचालानाना ङो मि स्येङानयि मि क्ये ङोमिस्येबालो” <verse eid="JHN 10:5" /><verse number="6" style="v" sid="JHN 10:6" />येशुयि हतिबाला हति प्ये नाइसोङ, हिन्नाङ ख्युइ हतिबाला नानाइबि तामयि तोन हतिबे हा:माकुवलो।<verse eid="JHN 10:6" /></para>
  <para style="s">येशु रच्चिया ल</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />हतिचाला येशुयि याङ हतिबाला नाइसोङ, “तेम्बारे, ङा खेला नाज्याइ, लुबे को ङाराङ ना। <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />ङाले ताङला होङान पोरो कुम्मा राङ डाकु ना, हिन्नाङ लुबे हतिबे ताम ङ्यानङान ना।<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="JER 23:1">यर्मिया २३:१</ref>; <ref loc="JHN 10:27">युहान्ना १०:२७</ref></char></note> <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />को ङाराङ ना, तेम्बारे सु मि याङ ङाने नाङला स्युना हति सोनङान ना, राङ नाङ फि किङान ना, राङ कोप्पोला छोङान ना।” <note caller="-" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="PSA 118:20">भजनसंग्रह ११८:२०</ref></char></note> <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />“कुम्मानि कुरु, सोतु राङ मासि सोरु मात्रा होङान ना। ङानि खेला मिजे खुहोङ राङ हति लेइराङला खुहोङ नाइरे लेलेबा ना।”<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />ङा ल रच्चिया ना। ल रच्चियायि रेँ लुयि चाला उ तेरिन। <note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="PSA 23:1">भजनसंग्रह २३:१</ref>; <ref loc="ISA 40:11">यशैया ४०:११</ref>; <ref loc="EZK 34:1">इजकिएल ३४:१</ref></char></note> <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />आलाइ पिन्दे ख्योख्योबि मिते लुयि मिते लु खुरि रच्चिया च्वरा माना। हतिता वाजे लेलेबा थोङसोङ लुबाला पोरते ढुन, राङ वाजे ल तेबाला गाजिला खेरिन, राङ कार च्युङच्युङला चोँङिन। <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />हति टोइरे ढुन, चिचालानाना हति आलाइ पिन्दे ख्योख्योबि मिना, हति लुला ल क्याइरे मिता।<verse eid="JHN 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 10:14" />“ङा ल रच्चिया ना, ङाहि ङारि लुला ङोस्येयिन, तेहि ङाहि लुयि ङाला ङोस्येयिन। <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />च्हिरु क्याइरे आकि ङाला ङोस्येयिन, ङाहि याङ आकेला ङोस्येङान ना, तेहि लुबे चाला ङारि उ तेरच्याइ।” <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />“ङाहि लु स्यान याङ हति, काङते धि रायि माना। हतिबा लाङ ङाहि ख्योङ कोहिि दु, राङ हतिबे ङाहि क्ये ङ्यानङान ना, राङ हतिबे तुमझि होङान ना, राङ रच्चिया झिला त्योएङान ना।<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="ISA 5:8">यशैया ५:८</ref>; <ref loc="EZK 37:24">इजकिएल ३७:२४</ref></char></note> <verse eid="JHN 10:16" /><verse number="17" style="v" sid="JHN 10:17" />आकि ङाला हति चाला करि किन, चिचालानाना ङा ङारि, मिजे याङ लक्ते ख्योङ ङ्युइकिन नाइरे तेरिन।” <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />सुइ याङ ङाहि चाने ङाहि मिजे खेर मिङ्युइबा हिन्नाङ ङा ङारि धोप्पि ङारि उ तेरिन। ङा ङारि उ तेरयापयि आङ ङाला होतो, तेहि ख्योङयापयि आङ याङ ङाला होतो। धि आदेश ङाहि आकेने खुँखुँबाना। <verse eid="JHN 10:18" /><verse number="19" style="v" sid="JHN 10:19" />धि वचनयि चाला याङ यहुदिबे उइला खा पेसोङ। <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />हतिबे नाङने लेइराङ यि नाइसोङ, “धिला ढे कालदु राङ धि ङ्युन दु। खे धि ताम च्हिला ङ्यान किन?” <verse eid="JHN 10:20" /><verse number="21" style="v" sid="JHN 10:21" />स्यान तेबे नाइसोङ, “ढे कालयापयि ताम धि च्वरा मिहा। च्हि ढेयि मि कानायि मि भे ङ्युइकिनाइ?”<verse eid="JHN 10:21" /></para>
  <para style="s">येशुला माना नानाइबा</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />यरुश्लेमला मोनलाम क्यासि खिमला कजसुबाला चिगा भुलयापयि कालापसोलयि भेला हिना। हति कुङघायि भेला हिना <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />येशु मोनलाम क्यासि खिमयि नाङला सोलोमनयि क्यला ढुनतेतुलो। <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />यहुदिबे ख्युइ फालाछुला पोरोला ताते टिसोङ, “जब थु ख्योए ङेला आच्यामाच्याला भोर च्याइ? ख्योए ख्रिष्ट हिन्ना ङेला ल क्याइरे नोइ।”<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />येशुयि हतिबाला जवाक पिन्सोङ, “ङाहि खेला नाइ छाछारा होतो हिन्नाङ खे हिछे मिकिता। ङाहि आकि मिनला ङा च्हि लाइ क्ये हति राङ साछि तेरिन।” <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />हिन्नाङ खे हिछे मि किता चिचालानाना खे ङाहि लुबे नाङने माना। <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />“ङाहि लुबे ङाहि क्ये ङ्यानकिन राङ हतिबे ङाला ङोस्येयिन, राङ हतिबा ङाहि च्येला हुन। <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />हतिबाला ङा नामयाङ मिसिनयापयि मिजे तेरच्याइ, राङ हतिबा नामयाङ मासि मिहा, राङ सुइ याङ हतिबाला ङाहि लाने खेर मिङ्युइबा। <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />ङाहि आकि ङाला पिपिना होतो; खो पोरोले छेयाना। आकि लाने सुइयाङ खेरमिङ्युइबा। <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />आके राङ ङा च्हिराङ ना।”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />यहुदिबे धि ताम थोइरे च्येला याङ येशुला क्याकच्याइ नाइरे टोउ तुइसोङ। <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />येशुयि हतिबाला नाइसोङ, “ङाहि खेला ङाहि आकि चाने लेइराङ लाइ ल तान्दे, हति नाङने काङ लाइयि चाला ङाला खे टोउ क्याकच्याइ?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />यहुदिबे येशुला जवाक पिन्सोङ, “लाइ लयि चाला ङे ख्योएला टोउ मिक्याका हिन्नाङ कजसुबाला अल नानाइबि चाला चिचालानाना ख्योए मि च्युङदे हाङ ख्योराङ ला कजसुबा नेन्दु।”<note caller="-" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="LEV 24:16">लेवि २४:१६</ref></char></note><verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />येशुयि हतिबाला जवाक पिन्सोङ, “ठिमला टिटिबा धु, कजसुबा नेन्दु खे ला ना।<note caller="-" style="x"><char style="xo" closed="false">10:34 </char><char style="xt" closed="false"><ref loc="PSA 82:6">भजनसंग्रह ८२:६</ref></char></note> <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />ङेला छ्या होतो कि पवित्रशास्त्रा च्हि नेन हति बारतै तेम्बा हुन: हतिबाला कजसुबायि ला नाइरे सुला ख्युइ लोन पिन्दे।” <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />ख्युइ भारेला च्हि, सुला रेँ पवित्र सोइरे कुरु पोरते राङ संसारला चाँरे? याङ ख्योए ङाला चिला ला ना च्योकिन्दु नाइरे आरोप लाइ किन चिचालाना ङाहि नाइरे, “ङा कजसुबे पिजा ना।” <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />तेम्बारे ङाहि आकि धोप्पा क्याक्याइबा लाइ ङाहि मकाइना ङाला हिछे माके। <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />हिन्नाङ “तेम्बारे ङा आकि लाइ किन राङ ङाहि थोला हिछे मिकिना धि लाइतेबे थोला हिछे कि, राङ खि हा:कोङान ना, कि आके ङाला होतो, राङ ङा आकेला।”<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />हतिबे याङ खोला सुङ ज्याइयि च्युइ क्याइसोङ हिन्नाङ खो हतिबे लाने थारसोङ। <verse eid="JHN 10:39" /><verse number="40" style="v" sid="JHN 10:40" />तेहि याङ येशु यर्दन चाङबोयि यि फारकानला हति साला पुइसोङ, काँहा युहान्नाले ताङला बप्तिसमा तेरिनलो, राङ खो हतिया त्येसोङ।<note caller="-" style="x"><char style="xo" closed="false">10:40 </char><char style="xt" closed="false"><ref loc="JHN 1:28">युहान्ना १:२८</ref></char></note> <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />मि लेइराङ ख्युइ तेहा होङाला छेलसोङ, युहान्नायि च्याङ हा:लाइयापयि लाइ माक्याइसोङ राङ “युहान्नायि ख्युइ भारेला च्हि नाइ हति पोरो तेम्बा ना।” <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />तेहि हतिया लेइराङ मियि येशुयि थोला हिछे क्याइसोङ।<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">लाजारस स्यियाप</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />लाजारस मिन क्याक्याइबा नाप्पा मिझि होतो। हति मरियम राङ ख्युइ इझि मार्थायि युल बेथानियायि हिना।<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="LUK 10:38-39">लुका १०:३८-३९</ref></char></note> <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />प्रभुला अत्तर कुइरे ख्युइ काङबा फिङान मरियम धि राङ हिना। हति भाइ लाजारस नाप्पा हिना।<note caller="-" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="JHN 12:3">युहान्ना १२:३</ref></char></note> <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />हति इझि ङिबुइ येशुयि तेहा जु नाइरे लोन कुरसोङ, “प्रभु, सुला ख्योए करि किन, हति नाप्पा दु।”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />हिन्नाङ धि थोइरे येशुयि नाइसोङ, “धि नानाइबि सिरु काल थु मिखेरा, हिन्नाङ धि कजसुबे छे धेयापयि चाला ना, तेहि धि ने कजसुबे पिजायि छे तेतेका होङ।” <verse eid="JHN 11:4" /><verse number="5" style="v" sid="JHN 11:5" />येशुयि मार्था, मुइ भैनि राङ लाजारसला करि किनलो, <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />हति हिन्नाङ लाजारस नाप्पा होतो नाइरे थोइरे हाङ खो काँहा होतो, हतिया, तरह ङिन ङि येशु हतिया राङ तातेलो। <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />हतिच्येला ख्युइ लोब्टुतेबाला नाइरेलो, “ल, ता याङ हु यहुदियाला लक्ते क्यु।” <verse eid="JHN 11:7" /><verse number="8" style="v" sid="JHN 11:8" />लोब्टुबे खोला नाइसोङ, “गुरुज्यु, थाल्ला काँहा यहुदिबे ख्योएला टोउ क्याकच्याइ प्येसुइ, राङ च्हि ख्योए याङ हतिया राङ ढो च्युइ फाकिनाइ?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />येशुयि जवाक पिन्सोङ, “च्हि ङिनला घण्टा च्युनङि मिहाइ? ङिम्मु ढोज्याइला नातो मिक्याका, चिचालानाना हति धि संसारयि होए थोङिन। <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />हिन्नाङ छाम्मु फाला छुलो किच्याइला नातो क्याकिन, चिचालानाना हति मिला साल्बो मिहा।” <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />हतिच्येला येशुयि हतिबाला नाइसोङ, “हुइ रबो लाजारस ङि टोदुलो, हिन्नाङ ख्युइ ङि सोतु ङा हतिया ढोज्याइ।” <verse eid="JHN 11:11" /><verse number="12" style="v" sid="JHN 11:12" />लोब्टुतेबे खोला नाइसोङ, प्रभु, “खो ङि टोदु नाइना खो टाकिनाइ।”<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />येशुयि हति स्यिस्यियायि भारेला नानाइबा हिना, हिन्नाङ हतिबे च्युका उलतोएला च्वरा ङि टोटुवा हिना नाइबा क्याइसोङ।<verse eid="JHN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 11:14" />येशुयि हतिबाला ल क्याइरे नाइरेलो, “लाजारस स्यिदु। <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />खि हिछे क्यायोङ नाइरे खि चाला ङा हतिया मेता ला ङा क्याका होए, च्हि हिन्नाङ हु हतिया ढो।”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />तेहि दिदुमास नाङान थोमायि खुरि तुमयि लोब्टुतेबाला नाइसोङ, “ल, हुङ ढो, राङ खो ङ्याबो स्यिया।”<verse eid="JHN 11:16" /></para>
  <para style="s">येशु स्यिरे सोम्बो च्युङदे लाँङान राङ मिजे</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />जब येशु क्योपते, तेहि लाजारसला तुरला पोरते ङिन सि पुइतु। <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />बेथानिया यरुश्लेमयि धुला हा:लाम किलोमिटर सुम घ्याबोला धुलो। <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />यहुदि लेइराङ मार्था राङ मरियमयि तेहा हतिबे भाइयि भारेला मोला छिमा फिक्तु लेप्तुलो। <verse eid="JHN 11:19" /><verse number="20" style="v" sid="JHN 11:20" />येशु हुनतेतु नाइरे थोइरे मार्था पुइसोङ, राङ खोला ठातेलो। हिन्नाङ मरियम खिमला राङ तातेलो।<verse eid="JHN 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 11:21" />तेहि मार्थायि येशुला नाइसोङ, “प्रभु, ख्योए ङिहा होतो नाना ङाहि भाइ मास्यि होएरो।” <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />हिन्नाङ ङाला छ्या होतो, ख्युइ कजसुबाला च्हि लाँ, कजसुबायि हति तेरकिन। <verse eid="JHN 11:22" /><verse number="23" style="v" sid="JHN 11:23" />येशुयि मोला नाइसोङ, “ख्युइ भाइ याङ सोम्बो हुन।”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />मार्थायि खोला नाइसोङ, “ङाला छ्या होतो, कि सिनि ङिनयि चाला याङ सोम्बो च्युङदे लाँयिन।”<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="ACT 24:15">प्रेरित २४:१५</ref></char></note><verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />येशुयि हतिला नाइसोङ, “स्यिरे लाँङान राङ मिजे ङाराङ ना। ङाला हिछे किङान स्यि नाङ सोम्बो हुन। <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />तेहि सोनङान राङ ङाहि थोला हिछे किङान नामयाङ मिस्यिया। च्हि ख्योए धि हिछे किनाइ?” <verse eid="JHN 11:26" /><verse number="27" style="v" sid="JHN 11:27" />मुइ येशुला नाइसोङ, “प्रभु, ङा हिछे किन, ख्योए संसारला होङान ख्रिष्ट, कजसुबे पिजा ना।”<verse eid="JHN 11:27" /></para>
  <para style="s">येशु ङुइरे</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />होचोम नाइरे मार्था पुइ छारसोङ, राङ मुरि भैनि मरियमला चामाना क्ये ताङदे नाइसोङ, गुरुज्यु; लेप्छारसोङ, “राङ ख्योएला क्ये तोङिन्दु।” <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />धि थोइरे मरियम हो:प्तामेला लाँरे ख्युइ तेहा पुइसोङ। <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />हति थुहाङ येशु युलाला लेप्छाछारा मेतालो, हिन्नाङ खो हतिया राङ धुलो काँहा मार्थायि खोला ठातु लेप्सोङ। <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />खिमला छिमा फिक्तु होङान यहुदिबे मरियम हो:प्तेमेला लाँरे फिला पुपुता थोङसोङ, मो हति तुरला ङुरु पुते नाइबा क्याइरे, मुइ च्येला पुइसोङ।<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />जब मरियम येशु होएते साला लेप्ते, राङ खोला थोङसोङ, तेहि जु नेनराङ ख्युइ काङबाला टाला च्यार सोङ, “हे प्रभु, ख्योए ङिया होतो नाना ङाहि भाइ मास्यि होएरो।” <verse eid="JHN 11:32" /><verse number="33" style="v" sid="JHN 11:33" />जब येशुयि मो राङ मो ङ्याबो होङान यहुदिबा ङुङान थोङसोङ, तेहि ख्युइ सम याङ तुसोङ तेहि सम अल च्युङसोङ। <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />ख्युइ हतिबाला टिसोङ, “खि खोला काँहा पोरते?” हतिबे खोला नाइसोङ, “प्रभु, लेप्ते तोइ।” <verse eid="JHN 11:34" /><verse number="35" style="v" sid="JHN 11:35" />येशु याङ ङुइसोङ। <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />हतिचाला यहुदिबे नाइसोङ, “तेहि, ख्हुइ ख्योएला चोम करि किन्दुइ।” <verse eid="JHN 11:36" /><verse number="37" style="v" sid="JHN 11:37" />हिन्नाङ रेनरेनयि नाइसोङ, “च्हि कानायि मि भेङान धि मिलाङ स्यिस्यियाने सोम्बो सो ङ्युइकिनाइ?”<verse eid="JHN 11:37" /></para>
  <para style="s">लाजारसला सोम्बो सोइसोङ</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />तेहि याङ येशुयि लेइराङ सम तुक्ते तुरला पुइसोङ। हति तुर ते फु झिला धुलो। हति खा टोउ झिकि क्यापतु। <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />येशुयि नाइसोङ, “टोउ फाला कि।” स्यिस्यियायि मिति इझि मार्थायि खोला नाइसोङ, “हे प्रभु, धि भेला थु ता हति टिमा खाला छेल होएरो, चिचालानाना खो स्यिरे ङिन स्यि पुइछारसोङ।” <verse eid="JHN 11:39" /><verse number="40" style="v" sid="JHN 11:40" />येशुयि हतिला नाइसोङ, “च्हि ङाहि खेला नानाइबा मानाइ च्हि, ‘खि हिछे क्याइना कजसुबे छे तेतेका थोङान ना?’” <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />हतिबे टोउ फाला क्याइसोङ। तेहि येशुयि मि क्येल्ला क्याइरे नाइसोङ, “हे आके, ङा ख्योएला कटिनक्या नाज्याइ, चिचालानाना ख्युइ ङाहि स्युवा ङ्यन्सोङ। <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />ङाला छ्या होतो, ख्युइ ङाहि स्युवा बारतै ङ्यानकिन। हिन्नाङ ङिया लाँरे ताताता मि झोमयि चाला ङाहि धि नानाइबाना, तेहि ख्युइ ङाला चाँचाँबा हिना नाइरे खि हिछे कि।” <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />तेहि धि ताम नाइ छारते ख्युइ क्ये छेया क्याइरे क्ये ताङसोङ, “लाजारस, फिला थोन।” <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />हति स्यिस्यिया मिते हति लाक्पा काङबा राइयि तातामा राङ च्ये कोहिलायि तुतुमा राङला फिला थोन्दे लेप्सोङ। येशुयि हतिबाला नाइसोङ, “खोला तातामाते ठोल, राङ हतिला ढोरु छ्यु।”<verse eid="JHN 11:44" /></para>
  <para style="s">येशुयि विरोधला दोष</para>
  <para style="r">
    <ref loc="MAT 26:1-5">मत्ति २६:१-५</ref>; <ref loc="MRK 14:1-2">मर्कुस १४:१-२</ref>; <ref loc="LUK 22:1-2">लुका २२:१-२</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />मरियमयि तेहा लेलेबि यहुदि लेइराङयि येशुयि क्याक्याइबि लाइ थोङसोङ हिछे क्याइसोङ। <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />हिन्नाङ हतिबे नाङने रेनते फरिसिबे तेहा पुइसोङ, राङ येशुयि क्याक्याइबि लाइतेबा स्येसोङ। <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />तेहि घोबा पुजारि राङ फरिसिबे झोमसा छेयायि स्दस्यतेबाला क्ये ताङदे हतिबाला नाइसोङ, “ता हु च्हि किच्याइ? चिचालानाना धि मिनि लेइराङ हा:लाइयापयि लाइ तोनिन्दु। <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />धिला चुका ताङना पोरोयि धिला हिछे किङान ना राङ रोमि आङकिङानबा लेप्ते हुइ मोनलाम क्यासि खिम राङ हुइ मि देश ङिकार मासि लोङान ना।” <verse eid="JHN 11:48" /><verse number="49" style="v" sid="JHN 11:49" />हिन्नाङ हतिबे नाङने च्हि, कैयाफा, काङते हति लोयि घोबा पुजारि हिना, ख्युइ हतिबाला नाइसोङ, “खि च्याङ मिस्येबा! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />लेइराङ राष्ट मासि होङयापले जनताबे चाला मिझि स्यियाप राङ खि चाला ल हुवा नाइरे खि हा:मिकुवा धुये।” <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />धि खुरि चाने नानाइबा माना, हिन्नाङ धि लोयि घोबा पुजारि च्युच्युवाति राष्टयि चाला येशु स्यि कोइ नाइरे ङोन्सेखिलदे नानाइबाना। <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />राष्टयि चाला मात्रा ख्युइ धि नानाइबा माना, हिन्नाङ कार च्युङच्युङला होएते कजसुबायि सन्तनला लाम्मा झिला ङ्याबो स्योएयापला नानाइबा ना। <verse eid="JHN 11:52" /><verse number="53" style="v" sid="JHN 11:53" />हतिचाला हति ङिनने यहुदि आङकिङानबे येशुला हतिबे सोयापयि टपि क्याइसोङ। <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />हतिचाला याङ येशु यहुदिबे उइला मनस्याङ क्याइरे फालाछुला माक्याइबालो, हिन्नाङ सा थोवाला धुनला होएता एफ्रइम नाङान भजारला पुइसोङ, राङ हतिया लोब्टुतेबा ङ्याबो त्येसोङ। <verse eid="JHN 11:54" /><verse number="55" style="v" sid="JHN 11:55" />यहुदिबे निस्तार कालापसोल धुनला धुलो, राङ युलयुलने लेइराङ रेँ राङला चाङमा सोरु ताङला यरुश्लेमला पुइसोङ।<note caller="-" style="x"><char style="xo" closed="false">11:55 </char><char style="xt" closed="false"><ref loc="2CH 30:17">२ इतिहास ३०:१७</ref></char></note> <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />तेहि हतिबे येशुला पातेलो, तेहि हतिबा मोनलाम क्यासि खिमला लाँरे तोतितुइना खोरे नाङला नारे क्याइसोङ, “खेला च्हि लागि हुनधुइ, च्हि खो कालापसोङला लेबोङङे?” <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />घोबा पुजारि राङ फरिसिबेते येशुला सुङज्याइ नाइरे खो काँहा धुइ नाइरे सुलाङ छ्या होएना लोन कुर नाइरे आदेश पिपिना होतो।<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">बेथानियाला येशुयि अभिशेक</para>
  <para style="r">
    <ref loc="MAT 26:6-13">मत्ति २६:६-१३</ref>; <ref loc="MRK 14:6-9">मर्कुस १४:६-९</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />निस्तार कालापसोलयि ङिन टुयि ताङला येशु बेथानियाला पुइसोङ। हतिया लाजारस तोकिनलो, सुला येशुयि स्यिस्यियाने सोम्बो सोइरसोङ। <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />हतिबे येशुयि चाला मुइ ङ्योपा तयार सोइसोङ। मार्था स्यापच्यि स्युनलो, तेहि लाजारस ते खो ङ्याबो ताते साङान झिकि नाङने च्यि। <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />तेहि मरियमयि लिटर फे कुना ङोलोयि उइयि टिमा होङान चाङमा पहझि ख्योँरे येशुयि काङबा ला कुइरेलो, तेहि ख्युइ काङबा रेँ स्येभुइ पिरेलो, राङ अत्तरयि टिमि खिम खाँसोङ।<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">लुका ७:३७-३८</ref></char></note> <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />हिन्नाङ येशुयि लोब्टुबे नाङने च्हि मदलब खोला धोका तेरङान यहुदा इस्करियोतयि नाइसोङ, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“धि अत्तर सुमला क्या ङुलयि सिक्काला चोँरे हति आलाइ टाङनाला पिन्ना मिहाइ?” <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />हिन्नाङ ख्युइ हति टाङनाला ताइरे नानाइबा माना, चिचालानाना हति कुम्मा ना, राङ आलाइयि किउ ख्युइ पोरते, तेहि हतिने कुनलो।<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />येशुयि नाइसोङ, “धिला च्याङ माना, ङाहि कुङयापयि ङिनयि चाला खोला पोरते सह। <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />चिचालानाना टाङनाबा बारतै खे ङ्याबो हुन।” ङा बारतै खे ङ्याबो मिहा।<note caller="-" style="x"><char style="xo" closed="false">12:8 </char><char style="xt" closed="false"><ref loc="JHN 15:11">१५:११</ref></char></note><verse eid="JHN 12:8" /></para>
  <para style="s">लाजरसयि विरोधला छल</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />यहुदितेबे तुम छेया झिकि खो हतिया होतो नाइरे हा:कोसोङ, राङ येशुयि चाला मात्रा माना, हिन्नाङ ख्युइ स्यिस्यियाने सोम्बो सोसोइबि लाजरसला याङ तायापयि चाला हतिबा लेप्तु लो। <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />हतिचाला घोबा पुजारितेबे लाजारस लायाङ सोएयापयि टोइ क्याइसोङ। <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />चिचालानाना हति क्याइरे यहुदिबे नाङने लेइराङ हतिबाने पेरे पुते येशुला हिछे क्याइसोङ।<verse eid="JHN 12:11" /></para>
  <para style="s">येरुश्लेमला येशु क्यालदे ढुल क्याक्याइबा</para>
  <para style="r">
    <ref loc="MAT 21:1-11">मत्ति २१:१-११</ref>; <ref loc="MRK 11:1-11">मर्कुस ११:१-११</ref>; <ref loc="LUK 19:28-40">लुका १९:२८-४०</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />ङिमा च्येमातेला निस्तार कालापसोङ होङान तुम छोम्मुवाति तेहि येशु यरुश्लेमला हुन्दु नाइरे थोइरेलो, <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />राङ मितेबा खजुरयि ढाला खुरते खोल स्वगत कितु क्ये धोनिन राङ थोन्सोङ, “होसन्ना! धन्य कजसुबयि मिनला होङान इस्राएलयि क्यालबो!” <verse eid="JHN 12:13" /><verse number="14" style="v" sid="JHN 12:14" />तेहि टेयि टेटुझि ठाते येशुयि हति थोला स्योन्सोङ, नाइरे पवित्रशास्त्राला टिदु, <verse eid="JHN 12:14" /><verse number="15" style="v" sid="JHN 12:15" />“सियोनयि पोमु माझि। तोइ ख्युइ क्यालबो टेयि टेटुयि थोला स्योन्दे हुन राङ धु।”<note caller="-" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">जकरिया ९:९</ref></char></note><verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />धि ताम ताङला ख्युइ लोब्टुतेबे हा:माकोसोङ। हिन्नाङ येशुयि छे ते छारते धि ताम ख्युइ भारेला पवित्रशास्त्रला टिदुलो, राङ धि लाइ ख्युइ चाला हतिबे क्याक्याइबा ना नाइरे हतिबे हा:कोरेलो। <verse eid="JHN 12:16" /><verse number="17" style="v" sid="JHN 12:17" />येशुयि लाजारसला तुरने क्ये ताङदे स्यिस्यियाने सोम्बो सुइतुइना खो ङ्याबो होएता मि तुमतेबे ख्युइ साछि तेरिन राङ तातेलो।<verse eid="JHN 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 12:18" />ख्युइ धि हा:लाइयापयि लाइ क्याइसोङ नाइरे थोथोइबातेबे याङ खोला ठातु पुइतु। <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />तेहि फरिसिबे खोरे नाङला नारे क्याइसोङ, “तेहि, खेने च्याङ मिहा। तेनराङ होए, संसार ख्युइ च्येला पुइसोङ!”<verse eid="JHN 12:19" /></para>
  <para style="s">ग्रिक रेनयि येशुला पापाता</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />कालापसोङ ला आराधाना कितु ढोङान यि नाङने रेनरेन ग्रिक याङ धुलो। <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />हतिबा गालिलयि बेथसेदाला त्योएङान फिलिपयि तेहा लेप्ते जु नाइरे स्युवा क्यापसोङ, “हजुर, ङे येशुला ठेसोम होए।”<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />फिलिप पुते आन्द्रियासला नाइसोङ, अन्‍द्रियास राङ फिलिप हति ङिबो पुते येशुला नाइसोङ। <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />येशुयि हतिबाला जवाक पिन्सोङ, “मि पिजि छे धेयापयि भेला लेप्छारतु। <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />तेम्बारे, ङा खेला नाज्याइ, ढुयि घेरा साला छारते मासिना हति चिक्पा लुइयिन। हिन्नाङ हति स्यिना लेइराङ ढेबु क्येरु झ्युकिन। <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />रेँ उला करि किङानयि हति मेता सुन, हिन्नाङ रेँ उल धि संसारला अल नाङानते नामयाङ मिसिनयापयि मिजेयि चाला सुरछित भोरिन।<note caller="-" style="x"><char style="xo" closed="false">12:25 </char><char style="xt" closed="false" /><char style="xt" closed="false">मत्ति १०:३९; १६:२५; मर्कुस ८:३५; लुका ९:२४; १७:३३</char></note> <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />सुइ याङ ङाहि स्यापच्यि स्युना हति ङाहि च्येला सअ राङ ङा काँहा होए, ङाला स्यापच्यि स्युङानतेबा याङ हतिया हुन। सुइ याङ ङाहि स्यापच्यि स्युना आकि याङ हति सम्मान किन।<verse eid="JHN 12:26" /></para>
  <para style="s">येशु राङ स्यियापयि भारेला ङोन्स्येखिखिला</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />“ता ङाहि सम अल च्युङसोङ, राङ ङा च्हि नाज्याइ? हे आके, धि भेलाने क्योप? माना, धि चाला राङ ङा धि भेला थु कोप्सोङ। <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />हे आके ङा ख्युइ मिनला छे धेक च्याइ।” तेहि तेङलाने धि च्वरा क्ये झि लेप्सोङ, “ङाहि हति छे तेतेका होए याङ किच्याइ।”<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />हतिया लाँलाँबि मि झोमयि हति थोइरे नाइसोङ, “धि लोमार क्याक्याइबा ना!” स्यानतेबे नाइसोङ, “तेङलायि लोन खेरङानतेबा खो ङ्याबो ताम नानाइबाना!”<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />येशुयि हतिबाला जवाक पिन्सोङ, “धि वचन ङाहि चाला च्युच्युवा माना हिन्नाङ खि चाला ना। <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />ता धि संसारला ल अल भेयापयि लाइ हुन। धि संसारयि क्यालबो फिला ढिमङान ना। <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />तेहि जब पिरथिवि धेकिन, ङा मि पोरोला ङा यहला ढुच्याइ।” <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />खो च्हिरु क्याइरे स्यिन, सो ता तोनयापयि चाला जु नानाइबाना।<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />मि झोमयि खोला टिसोङ, “ख्रिष्ट बारतै सोम्बो तोकिन नाइरे ठिमने ङि थोथोइबा होतो। ख्योए च्हिरु क्याइरे नाङ्युकिन, मि पिजा धेराङ कोयिन नाइरे? धि मि पिजा ते सुना?”<note caller="-" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="PSA 110:4">भजनसंग्रह ११०:४</ref>; <ref loc="ISA 9:7">यशैया ९:७</ref> </char></note><verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />येशुयि हतिबाला नाइसोङ, “तरह टिझि थु होए खे ङ्याबो धु। होए खे ङ्याबो होएहोए थु फालाछुला कि, तेहि मुन्नायि खेला घाङान अर्थात। सुवाङ मुन्नाला फालाछुला किना, हति खो काँहा ढुन खो राङ ला छ्या मिहा। <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />जब थु होए खे ङ्याबो होए हति थु हिछे पोर, राङ खे होएयि सन्तन ना।” धि ताम नाइरे, येशु हतिने पुइसोङ, राङ हतिबाने हिप्ते त्येसोङ।<verse eid="JHN 12:36" /></para>
  <para style="s">मितेबे हिमिछे</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />येशुयि हतिबे धुनला झोमयि हा:लाइयापयि क्याक्याइबा होतो, हचु हिन्नाङ हतिबे खोला हिछे माक्याइसोङ। <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />हति कोइबा होतो, यशैया ङोन्सेखिलङानयि वचन पुरा सह, “हे प्रभु, हुइ लोन सुइ हिछे क्याइ सुइ? तेहि कजसुबे शक्ति सुला तानसुइ?”<note caller="-" style="x"><char style="xo" closed="false">12:38 </char><char style="xt" closed="false"><ref loc="ISA 53:1">यशैया ५३:१</ref></char></note> <verse eid="JHN 12:38" /><verse number="39" style="v" sid="JHN 12:39" />हतिचाला हतिबे हिछे कि माङ्युइ सोङ, चिचालानाना यशैयायि याङ जु नानाइबा होतो, <verse eid="JHN 12:39" /><verse number="40" style="v" sid="JHN 12:40" />“ख्युइ हतिबे मि क्याकाका होतो, राङ हतिबे सम क्योङबो सोसोइबा होतो, हति च्वरा क्याइरे हतिबे मियि मि थोङयाप राङ समयि हा:मिकोयाप, स्यान अर्थात हतिबा लाँङान ना राङ ङाहि हतिबाला टाक्तु झ्युकोहि होङान ना।”<note caller="-" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false" /><char style="xt" closed="false">यशैया ६:१०</char></note> <verse eid="JHN 12:40" /><verse number="41" style="v" sid="JHN 12:41" />यशैयायि धि ताम नाइरेलो, चिचालानाना ख्युइ हति छे तेतेका थोङसोङ, राङ ख्युइ भारेला नाइसोङ। <verse eid="JHN 12:41" /><verse number="42" style="v" sid="JHN 12:42" />हिन्नाङ यहुदि आङकिङानबे नाङने लेइराङयि येशुला हिछे क्याइसोङ, हिन्नाङ फरिसिबे झिटायि, राङ हतिबाला यहुदि झोमसि खिमने धोनिन नाइरे झिटायि हति माङ्याना लो। <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />चिचालानाना कजसुबे छे धेयापले मा हतिबा मियि छे धेयाप करि किनलो।<verse eid="JHN 12:43" /></para>
  <para style="s">येशुयि वचनने ल अल भेयापयि लाइ</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />येशुयि क्ये छेया क्याइरे नाइसोङ, “ङाला हिछे किङानयि ङाला माना, हिन्नाङ ङाला चोँङानयि हिछे किन। <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />सुइ याङ ङाला थोङान ना, हति ङाला चोङान ला थोङिन। <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />ङा संसारला होए च्युङदे लेलेबा होतो, तेहि ङाला हिछे किङान मुन्नाला मियोङ नाइरे।”<verse eid="JHN 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 12:47" />“सुइ ङाहि वचन ङ्यानकिन राङ हति खाला मिङ्यान ना, ङा हति ल अल भेयापयि लाइ मिके। चिचालानाना ङा संसारयि ल अल भेयापयि लाइ कितु लेलेबा माना, हिन्नाङ संसारला क्योपतु लेलेबा ना। <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />ङाला माना नाङन राङ ङाहि वचन मिङ्यानङानयि चाला च्हि ल अल भेङानयि लाइ किङान झि होतो। काङ वचन ङाहि सिनि ङिनला ल अल भेयापयि लाइ किङान ना। <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />चिचालानाना ङाहि चाने नानाइबा माना हिन्नाङ ङाहि च्हि नायाप हिना, ङाला चोँङानयि आके खोराङयि ङाला आदेश पिन्सोङ। <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />ङाला छ्या होतो, कि ख्युइ आदेश नामयाङ मिसिनयापयि मिजे ना। हतिचाला ङा च्हि नेन, आकि नानाइबा च्वरा नेन।”<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">येशुयि खुरि लोब्टुबे काङबा टुटुइबा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />निस्तार कालापसोलले ताङला धि संसारने बिदा च्युङदे आकि तेहा ढोयापयि भेला लेप्तु नाङान येशुयि हा:कोदुलो, तेहि संसारला होएता खुरि मितेबे करि क्याइरे ख्युइ हतिबाला सिनसिन थु राङ करि क्याइसोङ।<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />येशु राङ येशुयि लोब्टु कमुइ ङ्योपाला दियाबलसयि सिमोनयि पिजा यहुदा इस्करियोतयि समला खोला सुङदु झ्युयापयि विचार ताङलाने राङ क्याइ छारतु। <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />आकि क्यु पोरो येशुयि लाला टोए छारतुलो, राङ खो कजसुबाने लेलेबा ना, राङ कजसुबे तेहा राङ ढुन नाङान येशुला छ्या होतो। <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />तेहि खो ङ्योपा साइरे लाँरेलो, राङ फिला कोहिला यि च्हिला पोरते रुमाल झि रेँ केप्पाला च्यीसोङ। <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />तेहि ख्युइ भाटाला छ्यु च्योसोङ, राङ लोब्टुबे काङबा ठुताला छेलसोङ, राङ ख्युइ रेँ कोकोनि रुमालयि हतिबे काङबा फिकाला छेलसोङ। <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />जब खो सिमोन पत्रुसयि तेहा लेप्ते, ख्युइ येशुला नाइसोङ, “प्रभु, च्हि ख्योए ङाहि काङबा ठुच्ये?”<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />येशुयि खोला जवाक पिन्सोङ, “ङा च्हि किन थाल्ला खेला छ्या मेता, हिन्नाङ च्येला हा:कोङान ना।” <verse eid="JHN 13:7" /><verse number="8" style="v" sid="JHN 13:8" />पत्रुसयि खोला नाइसोङ, “ख्युइ ङाहि काङबा नामयाङ ठुच्याइ मिखुबा।” येशुयि हतिला जवाक पिन्सोङ, “ङाहि माटुइना ख्योए ङाहि लोब्टु मिहा।” <verse eid="JHN 13:8" /><verse number="9" style="v" sid="JHN 13:9" />सिमोन पत्रुसयि खोला नाइसोङ, “हे प्रभु, ङाहि काङबा मात्रा माना हिन्नाङ ङाहि लाक्पा राङ घोबो याङ ठुइ।” <verse eid="JHN 13:9" /><verse number="10" style="v" sid="JHN 13:10" />येशुयि हतिला नाइसोङ, “ठुइ क्याप छाछाराला मिइ काङबा माना स्यान च्याङ ठुइकोइ मिहा, धि पोरो चाङमा राङ धु। तेहि खे पोरो चाङमा धु, हिन्नाङ पोरो ता माना।” <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />चिचालानाना खोला धोका तेरङानते येशु ङोस्येदु। हतिचाला ख्युइ नाइसोङ, “खे पोरो चाङमा मिदु।” <verse eid="JHN 13:11" /><verse number="12" style="v" sid="JHN 13:12" />हतिबे काङबा टुइ चारते च्येला रेँ खो फि कोहिला कोन्दे खो याङ त्येसोङ। तेहि येशु हतिबाला नाइसोङ, “च्हि खेला छ्या होतो, ङाहि खि चाला च्हि क्याइरे?<note caller="-" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="LUK 22:27">लुका २२:२७</ref></char></note> <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />खे ङाला ‘गुरु राङ प्रभु’ नेन्दु, धि खे तेम्बा नेन्दु, चिचालानाना ङा हति राङ ना। <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />तेम्बारे खि गुरु राङ प्रभु च्युङदे ङाहि खि काङबा टुटुइबा हिन्ना खि याङ चिकि च्यियि काङबा ठुइ कोहि हुन, <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />चिचालानाना ङाहि खेला प्ये झि मात्रा तान्दे, राङ च्हिरु ङाहि खि चाला क्याइरे। खे याङ हति च्वरा कि। <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />तेम्बारे ङा खेला नाज्याइ, यक्पुवा ख्युइ ताक्पो ले छे मिहा, तेहि तेङलायि लोन खेरङान लोन कुरङान ले छेया मिहा<note caller="-" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="MAT 10:24">मत्ति १०:२४</ref>; <ref loc="LUK 6:40">लुका ६:४०</ref>; <ref loc="JHN 15:20">युहान्ना १५:२०</ref></char></note> <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />तेम्बारे खि धि तेम्बा ताम हा:कोरे राङ क्याइना, खे धन्य होङान ना।”<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />“ङाहि खे पोरोयि भारेला नानाइबा माना, ङाहि सुला धाम्दे हतिला ङाहि ङोस्येयिन। हिन्नाङ पवित्रशास्त्रा पुरा होङ नाइरे धि च्युङसोङ, कि ‘ङाहि लोटा साङानयि ङाहि थोला तोति क्यापसोङ।’”<note caller="-" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">भजनसंग्रह ४१:९</ref></char></note> <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />“धि होङज्याइले ताङला राङ ङा खेला नाज्याइ, तेहि जब हति हुन, ङा हति राङ ना नाइरे खेला हिछे होङ।<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="JHN 14:29">युहान्ना १४:२९</ref></char></note> <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />तेम्बारे ङा खेला नाज्याइ, ‘सुला ङा चोँङिन, हतिला हिना नाइरे खाला ङ्यानङानला ङा याङ हिना नाइरे खाला ङ्यानज्याइ, तेहि ङाला हिना नाइरे खला ङ्यानङानयि ङाला चोँङानयि मिला याङ हिना नाइरे खाला ङ्यानकिन।’”<note caller="-" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="MAT 10:40">मत्ति १०:४०</ref>; <ref loc="MRK 9:37">मर्कुस ९:३७</ref>; <ref loc="LUK 9:48">लुका ९:४८</ref>; <ref loc="LUK 10:16">१०:१६</ref></char></note><verse eid="JHN 13:20" /></para>
  <para style="s">येशु खोराङला धोका तेरङानयि भारेला ङोन्सेखिखिला</para>
  <para style="r">
    <ref loc="MAT 26:20-25">मत्ति २६:२०-२५</ref>; <ref loc="MRK 14:17-21">मर्कुस १४:१७-२१</ref>; <ref loc="LUK 22:21-23">लुका २२:२१-२३</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />धि ताम नाइछारते येशुयि सम तुसोङ राङ ख्युइ साछि तेरिन राङ नाइसोङ, “तेम्बारे ङा खेला नाज्याइ, खि नाङने च्हि कि ङाला टायि लाला सुङदु झ्युङान ना।” <verse eid="JHN 13:21" /><verse number="22" style="v" sid="JHN 13:22" />येशुयि धि सुला नानाइबा ना नाइरे हा:माकुवा लोब्टुतेबा चिकि चिला तारे क्याइसोङ। <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />ख्युइ लोब्टुबे नाङने येशुयि करि किङान झि ख्युइ धुनला ङेरे रेँ त्येतु। <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />तेहि सिमोन पत्रुसयि खोला मिता क्याकिन राङ टिसोङ, खोला टि “ख्युइ धि ताम सुइ भारेला नानाइबाना?” <verse eid="JHN 13:24" /><verse number="25" style="v" sid="JHN 13:25" />तेहि हति लोब्टु येशुयि टाङला जु क्याइरे ङेरे राङ खोला टिसोङ, “प्रभु, हति सुना?” <verse eid="JHN 13:25" /><verse number="26" style="v" sid="JHN 13:26" />येशुयि जवाक पिन्सोङ, “सुला ङा लोटायि तुबु पहारे तेरच्याइ, खो हति राङ ना।” तेहि ख्युइ लोटायि तुबु पासोङ, राङ तोन्दे सिमोनयि पिजा यहुदा इस्करियोतला पिन्सोङ। <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />लोटायि तुबु खेरछारते तुइ हति नाङला स्युसोङ। तेहि येशुयि हतिला नाइसोङ, “ख्योएला च्हि किसोम होए, सो घ्योबो कि।” <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />हिन्नाङ येशुयि हतिला च्हि नानाइबा ना नाइरे ङ्योपा सारु ताताति सुइ याङ हा:माकोसोङ। <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />चिचालानाना रेनरेनयि धि नाइबा क्याइरे लो, कि यहुदाला आलाइयि किउ होतो, हति येशुयि हतिला कालापसोलयि चाला कोइबा आलमाल ङ्योयोङ, अर्थात हति टाङनाबाला चिगा पिनोङ नानाइबा ना। <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />तेहि लोटायि तुबु साइरे यहुदा इस्करियोत हो:प्तामेला फिला थोन्दे पुइसोङ। हति तुना छाम्मु च्युङछरतु।<verse eid="JHN 13:30" /></para>
  <para style="s">सारबा आदेश</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />जब खो फिला पुते तेहि येशुयि नाइसोङ, “ता मि पिजायि छे तेतेका च्युङ छारते, राङ कजसुबा हतिला छे तेतेका च्यङछारते। <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />तेम्बारे कजसुबा हतिला छे तेतेका च्युच्युवा होएना कजसुबा यि खोराङला छे धेङान ना, तेहि हतिला थाल्ला राङ छे धेङान ना।”<verse eid="JHN 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 13:33" />“च्यिबा टिमाबा, टिझि थु ङा खे ङ्याबो हुन! खि ङाला फे ङान ना, राङ च्हिरु ङाहि यहुदि आङकिङनबाला नाइरे, ता ङा खेलाङ नाज्याइ, ‘का ङा ढुन, खे होङ मिङ्युइबा।’”<note caller="-" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="JHN 7:34">युहान्ना ७:३४</ref> </char><char style="xt" closed="false"><ref loc="JHN 7:34">युहान्ना ७:३४</ref></char></note> <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />“ङा खेला आदेश सारबा झि तेरच्याइ :खे चिकि च्हिला करि कि। खेला ङाहि च्हिरु करि क्याइ, खेयाङ हति च्वरा क्याइरे करि कि।<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="JHN 15:12-17">युहान्ना १५:१२-१७</ref>; <ref loc="1JN 3:23">१ युहान्ना ३:२३</ref>; <ref loc="2JN 1:5">२ युहान्ना ५</ref></char></note> <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />तेम्बारे खि चिकि चिला करि क्याइना हतिने राङ हा:कुन कि खे ङाहि लोब्टु ना।”<verse eid="JHN 13:35" /></para>
  <para style="s">येशुयि पत्रुसयि माना नानाइबि भारेला ङोन्सेखिखिला</para>
  <para style="r">
    <ref loc="MAT 26:31-35">मत्ति २६:३१-३५</ref>; <ref loc="MRK 14:27-31">मर्कुस १४:२७-३१</ref>; <ref loc="LUK 22:31-34">लुका २२:३१-३४</ref></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />सिमोन पत्रुसयि खोला नाइसोङ, “हे प्रभु, ख्होए काँहा ढुन?” येशुयि जवाक पिन्सोङ, “ङा काँहा ढुन थाल्ला खि होङ मिङ्युइबा, हिन्नाङ च्येला खे ङाहि च्येला होङान ना।” <verse eid="JHN 13:36" /><verse number="37" style="v" sid="JHN 13:37" />पत्रुसयि खोला नाइसोङ, “प्रभु, ङा चिचाला थाल्ला राङ ख्युइ च्येला होङ मिङ्युइबा? ख्युइ चाला ङाहि उ तेरच्याइ।” <verse eid="JHN 13:37" /><verse number="38" style="v" sid="JHN 13:38" />येशुयि जवाक पिन्सोङ, “च्हि ख्योए ङाहि चाला उ तेरच्ये? तेम्बारे ङा ख्योएला नाज्याइ, ख्युइ ङाला लाम्मा सुमला माना मानाइबा ताङला च्याबो मिभोता।”<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">येशुयि आके थु ढोयापयि लाम</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />“खि सम तुकि तु। येशुयि हतिबाला नाइसोङ खे कजसुबायि थोला हिछे किन्दु, ङाहि थोला याङ हिछे कि। <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />ङाहि आकि खिमला त्योएसा लेइराङ होतो। हति च्वरा अर्थात ङाहि खेला नेनाइ, कि खि चाला ङा तोएसा तयार सोरु ढुन होए? <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />तेहि खि चाला तोएसा सोइरे ङा याङ लक्ते होङज्याइ, राङ खेला ङा ङाहि तेहा खेरच्याइ, राङ ङा काँहा होतो, हतिया खे याङ होङान ना। <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />ङा काँहा ढुन, खे हाङ हतिया ढोसि लाम हा:कोङान ना।”<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />थोमायि येशुला नाइसोङ, “हे प्रभु, ख्योए काँहा ढुन, ङेला छ्या होतो, तेहि ङाहि लाम च्हिरु क्याइरे ङोस्येच्याइ?”<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />येशुयि हतिबाला नाइसोङ, “लाम, तेम्बा राङ मिजे ङा राङ ना। ङा ने अर्थात आकि तेहा सुवाङ ढोमिङ्युइबा। <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />खि ङाला ङोस्येस्येबा हिन्ना, ङाहि आके लाङ ङोस्येयिन। ताने ङोस्येयिन राङ खोला थोङसोङ।” <verse eid="JHN 14:7" /><verse number="8" style="v" sid="JHN 14:8" />फिलिपयि खोला नाइसोङ, “हे प्रभु, ङेला आके तोन होचोम च्युङना ङेला हुन।” <verse eid="JHN 14:8" /><verse number="9" style="v" sid="JHN 14:9" />येशुयि हतिला नाइसोङ, “फिलिप, झोम भेला थु ङा खे ङ्याबो होतो, हचु हिन्नाङ खि ङाला ङोमास्येसोङ? सुइ ङाला थोथोवा होतो, हति आकेला याङ थोथोवा होतो। ख्होए च्हिरु क्याइरे नाङ्युइ किन, ‘ङेला आके तोन?’” <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />ङा आकेला, राङ आके ङाला होतो नाङान च्हि फिलिप ख्योए हिछे मिकिताइ? काङ वचन ङा खेला नेन, हति ङारि आङने नानाइबा माना हिन्नाङ ङाला ताताता आकि लाइ क्याक्याइबा ना। <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />ङाला हिछे कि, कि ङा आकेला होतो, राङ आके ङाला। अर्थात धि लाइ यि चाला हिछे कि। <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />“तेम्बारे, ङा खेला नाज्याइ, सुइ ङाला हिछे किन, हति ङाहि क्याक्याइबि लाइ याङ कि ङ्युइकिन, राङ हतिले याङ लाइ छेया किन, चिचालानाना ङा आकि तेहा ढुनहोए।” <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />खि ङाहि मिनला च्हि लाँना याङ पिजाला आकि छे तेतेका होङ नाइरे ङा हति कि च्याइ। <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />खि ङाहि मिनला च्हि लाँ नाङ हति ङा किच्याइ।<verse eid="JHN 14:14" /></para>
  <para style="s">पवित्र आत्मायि ना क्याक्याला</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />“खि ङाला करि क्याक्याइबा हिन नाता ङाहि आदेश तेबा ङ्यानकिन। <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />राङ ङा आकेला स्युवा क्याकच्याइ, राङ ख्युइ खेला स्यान टोइकिङान तेरङान ना, राङ खो खे ङ्याबो बारतै त्योएङान ना। <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />धि तेम्बि आत्मा ना, काङला संसारयि हिना नाइरे खाला मिङ्याना, चिचालानाना संसारयि खोला न त थोङिन न त ङोस्येयिन। खि खोला ङोस्येयिन। चिचालानाना खो खे ङ्याबो तोकिन, राङ खो खे ङ्याबो राङ त्योएङान ना।” <verse eid="JHN 14:17" /><verse number="18" style="v" sid="JHN 14:18" />“ङा खेला चिक्पा टोकिया मिभोर। ङा खि तेहा याङ होङज्याइ। <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />ता टिझि च्येला संसारयि ङाला नामयाङ थोङान माना ना, हिन्नाङ खि ङाला थोङान ना। ङा सोम्बो होतोति, खे याङ सोम्बो त्योएङान ना। <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />हति ङिन खि हा:कोङान ना, कि ङा ङारि आकेला होतो, राङ खे ङाला, राङ ङा खेला होतो।<verse eid="JHN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21" />“ङाला करि किङान हति राङ ना सुला ङाहि आदेश होतो राङ हति खाला ङ्यानकिन। तेहि ङाला करि किङानला ङाहि आकि करि किन। ङा हतिला करि किच्याइ, राङ ङा ङाराङला हतिया थोङदु झ्युक च्याइ।”<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />यहुदा इस्करियोत माना ख्युइ नाइरेलो, “प्रभु, ख्युइ च्हि नाइरे, ख्योए-ख्योए राङला ङाहि तेहा थोङदु झ्युक च्याइ, राङ संसार तेला मानाइ?”<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />येशुयि हतिला जवाक तेरिन राङ नाइसोङ, “सुइ ङाला करि किन, हति ङाहि वचन ङ्यानकिन, राङ ङाहि आकि हतिला करि किन, राङ हु हति तेहा होङान ना, राङ हति तेहा त्योएङान ना। <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />ङाला करि मिकिङानयि ङाहि वचन खाला मिङ्याना। काङ वचनते खे ङ्यान किन, हति ङाहि माना, हिन्नाङ ङाला चोँङान आकि ना।”<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />“धि ताम ङा खे ङ्याबो होतोला राङ नानाइबाना। <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />हिन्नाङ टोइकिङानते, मदलब पवित्र आत्मा, सुला आकि ङाहि मिनला चोँङान ना, ख्युइ खेला ताम पोरो लोप्ङान ना, राङ ङाहि खेला नानाइबि ताम पोरो याका लोङान ना।” <verse eid="JHN 14:26" /><verse number="27" style="v" sid="JHN 14:27" />किप्पो ङा खे ङ्याबो राङ पोरते ढोज्याइ। ङा ङारि शान्ति खेला तेरच्याइ। संसारयि पिपिना च्वरा ङा खेला मितेर। खि सम मातु राङ माझि। <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />“ङाहि खेला ‘ङा ढुन होए, राङ खि तेहा होङज्याइ’ नानाइबा खि थोइसोए। खि ङाला करि क्याक्याइबा हिन्ना ङा आकि तेहा ढुन होए नानाइबा थोइरे खे काङान ना, चिचालानाना आके ङाले छेना। <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />ता धि होङज्याइले ताङला राङ ङाहि खेला नाइछारते, राङ तेहि धि जब हुन तेहि खि हिछे ङ्युइयोङ। <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />ङा ता खे ङ्याबो ताम मा मिना, चिचालानाना धि संसारयि क्यालबो हुन्दु। हति ङाहि थोला च्याङ शक्ति मेता। <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />हिन्नाङ ङा आकेला करि किन, राङ च्हिरु आकि ङाला आदेश पिन्दे हति अनुसार राङ किन नाइरे संसारयि हा:कोहोङ। ल्हो, हु धि साने ढो।”<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">येशु तेम्बा अंगुरयि जालि</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />“तेम्बा अंगुरयि तोङभोङ ङ्याना, राङ ङाहि आके स्यिङयि लाइ किङान ना।” <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />ङाला होएता पोरो ढाला काङयि ढेबु मितेरा हतिला तुप्ते ल सोयाप राङ ढेबु तेरङान पोरो ढालाला हतिले याङ झन मा तेरिन नाइरे झन तुप्ते भे क्याकिन। <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />ङाहि खेला नानाइबि वचनयि खे तेकि राङ चाङमा च्युङ छारते। <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />ङाला त्योए, राङ ङा खेला तोच्याइ। च्हिरु क्याइरे ढाला अंगुरयि तोङभोङला मात्येना हति खुरि ढेबु छ्या मिङ्युइबा, हति च्वरा क्याइरे खे ङाला मात्येना खि याङ ढेबु छ्या मि ङ्युइबा।<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />“अंगुरयि भोटि ङा ना, खे ढालातेबा ना। तेम्बारे सुवाङ ङा ङ्याबो त्येना, राङ ङा हतिला त्येना, हति ढेबु लेइराङ छ्यातु झ्युङान ना चिचालानाना ङाने कुरु ताते खि च्याङ कि मिङ्युइबा।” <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />मि सुवाङ ङाला मा त्येना, हति ढाला च्वरा फिला ढिमङान ना, राङ हति कामछारङान ना। हतिच्वरा ढालातेबा मितेबे थुन राङ मेला झ्युकिन, राङ हति झ्योप छारकिन। <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />खे ङाला त्येना, राङ ङाहि ताम खेला त्येना, खेला च्हि धोप्पा होतो लोँ, राङ हति खि चाला होङान ना। <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />खि लेइराङ ढेबु छ्या च्युक्ते ङाहि लोब्टु हिना नाइरे प्रमाण क्याइना हतिला राङ ङाहि आकि छे तेतेका होङान ना। <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />“आकि च्हिरु क्याइरे ङाला करि क्याइरे, ङाहि याङ खेला करि क्याइरे खे ङाहि करिला त्योए।” <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />तेम्बारे खि ङाहि आदेश खाला ङयान ना खे ङाहि करिला त्योएङान ना, च्हिरु क्याइरे ङाहि आकि आदेश खालाङ्यान्दे, राङ ख्युइ करिला तोकिन।<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />ङाहि धि ताम खेला धि चाला नानाइबा ना, कि ङाहि किप्पो खेला होङ, राङ खि किप्पो पुरा होङ। <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />“ङाहि आदेश धि राङ ना, कि ङाहि खेला च्हिरु क्याइरे करि क्याइरे, खि याङ चिकि चिला हति च्वरा क्याइरे करि कि।”<note caller="-" style="x"><char style="xo" closed="false">15:12 </char><char style="xt" closed="false"><ref loc="JHN 13:34">युहान्ना १३:३४</ref>; <ref loc="JHN 15:17">१५:१७</ref>; <ref loc="1JN 3:23">१ युहान्ना ३:२३</ref>; <ref loc="2JN 1:5">२ युहान्ना ५</ref></char></note> <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />रेँ रुवायि चाला रेँ उ तेरच्याइले छेया करि स्यान सुवाङ मिहा। <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />ङाहि खेला आदेश पिन, हति ख्युइ खाला ङ्यान्ना, खे ङाहि रबो ना। <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />ता ङा खेला योक्पुवा मिना, चिचालानाना ख्युइ ताक्पो च्हि किन ख्युइ हा:मिकुवा। हिन्नाङ ङाहि खेला रबो नानाइबा होए, चिचालानाना च्हि ङाहि आकेने थोइरे, ङाहि हति पोरो खेला स्यास्याता होए। <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />ङाला खि माधामा, हिन्नाङ ङाहि खेला धाम्दे, कि खे क्यु, ढेबु छ्यातु छ्यु, तेहि खि ढेबु छ्याछ्याबा राङ त्योए। हतिचाला आकेला ङाहि मिनला च्हि लाँ, ख्युइ खेला हति तेरङान ना। <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />ङा खेला धि आदेश तेरच्याइ, कि खे चिकि चिला करि कि।<verse eid="JHN 15:17" /></para>
  <para style="s">मुइ मिका</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />“तेम्बारे संसारयि खेला अल किना, खे हा:कुवा कि, कि खेला अल किच्याइले ताङला ङाला अल क्याक्याइबा ना। <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />तेम्बारे खे धि संसारयि हिननाता खेला रेँ मि नाइरे करि क्यायोङ ना। हिन्नाङ खे धि संसारयि माना। खेला संसारने ङाहि धाम्दे, हतिचाला संसारयि खेला अल नेन। <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />ङाहि खेला नानाइबि वचन टाम्बाला पोर, ‘यक्पुवा खिमयि ताक्पोले छेया मिहा।’ हतिबे ङाला तुका पिन्न खेला हाङ तुका तेरङान ना। खि ङाहि वचन खालाङ्यान ना खि वचन याङ खाला ङ्यानङान ना।<note caller="-" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="MAT 10:24">मत्ति १०:२४</ref>; <ref loc="LUK 6:40">लुका ६:४०</ref>; <ref loc="JHN 13:16">युहान्ना १३:१६</ref></char></note> <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />हिन्नाङ हतिबे धि ताम पोरो ङाहि मिनला खेला किङान ना, चिचालानाना ख्होए ङाला चोँङानला ङोमिस्येबा। <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />ङा मालेबा नाना रेँ राङ हतिबाला मानाइबा झिनाना खे तिक्पि दोषि होङान अर्थात, हिन्नाङ ता खिरि तिक्पा ङ्याबो च्याङ ताम सोयाप मिहा। <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />सुइ ङाला मिका किन हति ङाहि आके लाङ मिका किन। <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />तेम्बारे स्यान सुइयाङ माक्याइबि लाइ ङाहि हतिबे उइला माक्याइबा झि नाना हतिबा तिक्पि दोषि होङान अर्थात। हिन्नाङ ता हतिबे ङा राङ ङाहि आके ङिकारला थोथोवा होतो राङ मिका क्याक्याइबा होतो। <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />हिन्नाङ ठिमला टिटिबि धि वचन पुरा होङयापयि चाला धि च्युच्युवा ना, ‘खि ङाला चुराङडि मिका क्याइसोङ।’”<note caller="-" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="PSA 35:19">भजनसंग्रह ३५:१९</ref>; <ref loc="PSA 69:4">६९:४</ref>; <ref loc="PSA 109:3">१०९:३</ref></char></note><verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />“जब टोइकिङान हुन, सुला ङा आकि तर्फने खि तेहा चोङज्याइ, मदलब तेम्बि आत्मा, काङते आकेने हुन, ख्युइ राङ ङाहि भारेला साछि तेरङान ना। <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />खे ताङस्युवाने राङ ङा ङ्याबो होतो ति, खे याङ ङाहि साछि ना।”<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />“खि हिछे मा तोङ नाइरे राङ ङाहि धि ताम खेला नानाइबा ना। <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />हतिबे खेला यहुदि झोमसि खिमने खेला धोन्ङान ना। तेम्बा तेला धि च्वरा भेला हुन्दु, जब खेला मिपसोएयि कजसुबे स्यापच्यि स्युन नाइरे ठानि किङान ना। <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />हतिबे धि लाइ किङान ना, चिचालानाना हतिबे आकेला ङोस्येस्येबा मेता, राङ ङा लाङ ङोमिस्येबा। <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />हिन्नाङ धि ताम ङाहि खेला स्यास्याता होए, कि जब हति भेला हुन, तेहि खेला च्हि नेन सो स्मरण हुन। ताङला राङ ङाहि खेला धि ताम मानाइबा, चिचालानाना ङा खे ङ्याबो होतो।”<verse eid="JHN 16:4" /></para>
  <para style="s">पवित्र आत्मायि लाइ</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />“ता ङा ङाला चोँङान यि तेहा ढुन, हिन्नाङ ‘ङा काँहा ढुन?’” नाइरे खे सु याङ ङाला मिढिया। <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />हचु हिन्नाङ ङाहि खेला धि ताम नानाइबि तोनयि सम शोकयि खाँखाँबा धु। <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />हचु हिन्नाङ ङा खेला तेम्बा ताम नाज्याइ, ङा ढोयाप ला राङ खेला ल हुन। चिचालानाना ङा मापुइना, टोइकिङान खि तेहा होङान मानाना। हिन्नाङ पुइना ङा खोला खि तेहा चोङज्याइ। <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />तेहि खो जब हुन, ख्युइ संसारला तिक्पा राङ केवा, ल अल भेयापयि लाइ भारेला दोष सोङान ना। <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />तेहि तिक्पि भारेला, गलग दु चिचालानाना हतिबा ङाहि थोला हिछे मिकिता, <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />केवायि भारेला, चिचालानाना ङा आकि तेहा ढोज्याइ, राङ खि ङालाङ थोङान मानाना। <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />राङ ल अल भेयापयि लायि भारेला संसारयि ठिमयि आङकिङान दोषि सोइछारसोङ। <verse eid="JHN 16:11" /><verse number="12" style="v" sid="JHN 16:12" />“ङाहि खेला नायापयि ताम तरह लेइराङ होतो, हिन्नाङ थाल्ला खि हति ताम ङ्यान मिङ्युइबा।”<verse eid="JHN 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 16:13" />जब खो मदलब तेम्बि आत्मा हुन, तेहि ख्युइ खे पोरोला तेम्बाला ठिङान ना। खो खुरि चाने नाङान मानाना। ख्युइ च्हि थोइ हतिराङ नाङान ना, राङ होङानयि तामतेबा खेला किङान ना। <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />ख्युइ ङाहि छे धेङाना, चिचालानाना काङते ङाहि ना, हति ङाने खेरते खेला सो क्याइसोङ। <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />चोम आकेला होए, हति पोरो ङाहि ना। हतिचाला ङाहि नाइरे, काङ ङाहि हिन हति ङाने खेरते आत्मायि खेला किङान ना।<verse eid="JHN 16:15" /></para>
  <para style="s">तुक्का राङ किप्पो</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />“टिझि च्येला याङ खि ङाला थोङान मानाना, याङ टिझि च्येला खि ङाला थोङान ना।”<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />तेहि ख्युइ लोब्टु रेनरेन खोरे नाङला नारे क्याइसोङ, “ख्युइ हुला धि नानाइबा चिना? ‘टिझि च्येला खि ङाला थोङान माना ना, तेहि याङ टिझि च्येला ङाला खि थोङान ना, राङ चिचालानाना ङा आकि तेहा ढुन ताताता होए।’” <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />हतिबे नाइसोङ, “ख्युइ ‘टिझि थु’ नानाइबि तोन च्हिना? ङेला छ्या मेता, ख्युइ च्हि नानाइबा ना नाइरे।” <verse eid="JHN 16:18" /><verse number="19" style="v" sid="JHN 16:19" />हतिबे येशुला ढिसोम किन्दु नाइरे येशुयि हा:कोदु, राङ ख्युइ नाइसोङ, “‘टिझि च्येला खि ङाला थोङान मानाना, तेहि टिझि च्येला थोङान ना’ नाङानयि तामयि तोन च्हि ना नाङान यि भारेला च्हि खे खिरि उइला नारे किनाइ?” <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />तेम्बारे ङा खेला नाज्याइ, खे ङुङान ना राङ सम अल होङान ना। हिन्नाङ संसार काङान ना। खे सम तुङान ना, हिन्नाङ तुका किप्पोला घ्युरङान ना। <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />च्यिबा कितुइना पोमुवातेबाला तुका हुन, चिचालानाना हति भेला लेलेबा हुन। हिन्नाङ जब मुइ च्यिबा क्येरु झ्युकिन, हतितुना हति तुका टाम्बा मिहा चिचालानाना संसारला च्यिबा झि क्येसोङ नाङान ला केनलो।<note caller="-" style="x">९:१७ मिका ४<char style="xo" closed="false">16:21 </char><char style="xt" closed="false"><ref loc="ISA 26">यशैया २६</ref></char></note> <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />हति च्वरा क्याइरे थाल्ला खेला तुका हुन, हिन्नाङ याङ ङा खेला थोङान ना, राङ खि सम किप्पो होङान ना। तेहि सुइ याङ खि किप्पो खेने ठोमिङ्युइबा।<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />जब हति ङिन खि ङाला होङान ना खि ङाला च्याङ ढिङान मानाना। तेम्बारे ङा खेला नाज्याइ, खि ङाहि मिनला आके ला च्हि लाँ, ख्युइ खेला हति तेरङान ना। <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />थाल्ला थु खि ङाहि मिनला च्याङ लाँलाँबा मेता। लँ, तेहि खेला खुङान ना। धि च्वरा क्याइरे खि किप्पो पुरा सअ।<verse eid="JHN 16:24" /></para>
  <para style="s">संसारयि थोला क्याक्याला</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“धि ताम ङाहि खेला प्येला नानाइबा ना। हिन्नाङ भेला हुन्दु, जब ङा खेला ला क्याइरे ताम नाङान मानाना, हिन्नाङ जब ङा याङ खे ङ्याबो प्येला ताम नाङान माना ना, हिन्नाङ आकि भारेला चाङमा क्याइरे नाज्याइ। <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />हति ङिन खि ङाहि मिनला लोङान ना। ङा खि चाला आकेला स्युवा क्याकिन नाइरे खेला मिना, <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />चिचालानाना आके खुरि खेला करि किन। चिचालानाना खि ङाला करि क्याक्याइबा होतो, राङ ङा कजसुबाने लेलेबा ना नाइरे हिछे क्याक्याइबा होतो। <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />ङा आकेने लेप्ते, तेहि संसारला लेप्ते, राङ याङ ङा संसारला ताङदे आकि तेहा ढुन होए।”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />येशुयि लोब्टुतेबे नाइसोङ, “ता ख्योए ताम चाङमा क्याइरे नेन्दु, प्येल माना। <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />ता ङाहि हा:कोसोङ, ख्युइ ताम पोरो हा:कुन्दु, तेहि ता ख्योए सुलाङ ढि कोइ मिदु। हतिचाला ङे हिछे किन कि ख्योए कजसुबाने लेलेबा ना।”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />येशुयि हतिबाला जवाक पिन्सोङ, “च्हि ता खे हिछे किनाइ? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />तेहि, भेला हुन्दु, तेम्बा तेला लेप्तु, जब खे थोरते रेँ खिमला ढुन राङ ङाला चिक्पा भोरङान ना। हचु हिन्नाङ ङा चिक्पा मेता चिचालानाना आके ङा ङ्याबो होतो।<note caller="-" style="x"><char style="xo" closed="false">16:32 </char><char style="xt" closed="false"><ref loc="JHN 8:29">युहान्ना ८:२९</ref></char></note> <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />ङाहि धि ताम खेला धि चाला नानाइबा ना, कि ङाला खे शान्ति होङ। संसारला खेला तुका होङान ना, हिन्नाङ सम छेया कि, ङाहि संसारले क्याक्याला होतो।”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">येशुयि रेँ लोब्टुबे चाला मोनलाम क्याक्याइबा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />धि ताम नाइ छारते येशुयि तेङला यहला मि केल्ला ताइरे नाइसोङ, “हे आके, भेला छारतु, ख्युइ पिजि छे धेयाप थोङान ना, राङ पिजि ख्युइ छे तेतेका थोङदु झ्युङान ना।” <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />चिचालानाना ख्युइ हतिला मि पोरोयि थोला आङ पिपिना होतो, तेहि ख्युइ खोला पिपिना पोरोला ख्युइ नामयाङ मिसिनयापयि मिजे पिनोङ। <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />ता नामयाङ मिसिनयापयि मिजे धि राङ ना, कि हतिबे ख्योएला, च्हि मात्रा तेम्बा कजसुबा ङोस्येयोङ, राङ ख्युइ चाँचाँबि येशु ख्रिष्टला ङोस्येयोङ। <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />काङ लाइ ख्युइ ङाला पिन्दे, हति पुरा क्याइरे ख्योएला पिरथिवि ङाहि छे तेतेका होतो। <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />ता हे आके, संसार सोयापले ताङला ख्युइ धुनला ङाहि काङ छे तेतेका होतो, हति ख्योए राङ ताताताला ङाला छे थे।<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />“संसारने काङ मितेबा ख्युइ ङाला पिन्दे हतिबाला ख्युइ मिन ङाहि थोङदु च्युच्युका होतो। हतिबा ख्युइ ना, तेहि ख्युइ हतिबा ङाला पिन्सोङ, राङ हतिबे ख्युइ वचन खाला ङ्याङ्याना होतो।” <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />ता हतिबाला ता छ्या होतो, कि ख्युइ ङाला पिपिना पोरो क्यु ख्योएने लेलेबाना। <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />चिचालानाना काङ वचन ख्युइ ङाला पिपिना होतो, ङाहि खेला पिन्दे, राङ खि याङ हति ङ्यान्दे। राङ ङा ख्योएने लेलेबा ना नाइरे हतिबे तेम्बारे हा:कोदु, तेहि ख्युइ ङाला चाँचाँबा ना नाइरे हतिबे हिछे क्याक्याइबा होतो।<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />ङा हतिबे चाला मोनलाम क्याकच्याइ, संसारयि चाला ङा मोन्लाम मिक्या, हिन्नाङ हतिबे चाला, सुला ख्युइ ङाला पिन्दे। चिचालानाना हतिबा ख्युइ राङ ना। <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />ङाला च्हि होतो हतिबा पोरो ख्युइ ना, ख्युइ च्हि होए ङाहि ना। ङाहि छे तेतेका खि तेहा थोथोङा होतो। <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />“ता ङा याङ संसारला मितोए, हिन्नाङ हतिबा ता संसारला तोकिन। ङा ख्युइ तेहा हुन होए। पवित्र आके, ख्युइ ङाला पिपिना ख्युइ मिनला ता क्याप्ते पोर, राङ हु च्वरा हतिबा हाङ च्हि ना।” <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />जब थु ङा खे ङ्याबो होतो, ख्युइ ङाला पिपिना ख्युइ मिनलाता क्याप्ते पोर। हतिबाला च्याङ होङदु माजु। तेहि हतिबाने मासि होङयाप ते अर्थात सुवाङ मासि मा च्युङसोङ चिचालानाना पवित्रशास्त्रा पुरा होङ कोहिि राङ होतो<note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="PSA 18:9">भजनसंग्रह १८:९</ref>; <ref loc="JHN 13:18">युहान्ना १३:१८</ref>; <ref loc="JHN 18:9">युहान्ना १८:९</ref></char></note>। <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />“ता ङा ख्युइ तेहा हुन होए। संसारला होतितुइना ङा धि ताम नेन, कि खेला ङाहि जब याङ मिसिनयापयि हतिबाला ङाहि कायाप पुरा होङ।” <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />ङाहि हतिबाला ख्युइ वचन पिन्दे हिन्नाङ संसारयि खेला अल क्याइसोङ चिचालानाना खे संसारयि माना, च्हिरु क्याइरे ङा संसारयि माना। <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />ख्युइ हतिबाला संसारने खेर नाइरे ङा मोनलाम मिका हिन्नाङ हतिबाला अलने क्याप। <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />हतिबा संसारयि माना, च्हिरु क्याइरे ङा धि संसारयि माना। <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />हतिबाला तेम्बाला पवित्र सोइ, ख्युइ वचन तेम्बा ना। <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />च्हिरु क्याइरे ख्युइ ङाला संसारला चाँरे, ङाहि याङ हतिबाला संसारला चाँरे। <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />हतिबे चाला ङा ङारि ङाराङला पवित्र स्युन होए, तेहि हतिबा हाङ तेम्बाला पवित्र होङ।<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />ङा हतिबे चाला मात्रा मोनलाम मिक्या, हिन्नाङ हतिबे लोनने ङाहि थोला हिछे किङानयि चाला हाङ मोनलाम क्याकच्याइ, <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />कि खे पोरो च्हि होङ हे आके, च्हिरु क्याइरे ख्योए ङाहि तेहा होतो, राङ ङा ख्योएला, हति च्वरा क्याइरे हुला होङ, राङ ख्युइ ङाला चाँरे नाइरे संसारयि हिछे क्यायोङ। <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />काङ छे ख्युइ ङाला पिपिना होतो, ङाहि हतिबाला पिन्दे, तेहि हु च्हि च्युच्युवा च्वरा हतिबा हाङ च्हि होङ। <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />ङा हतिबाला, तेहि ङा खेला, राङ खे पोरो काङ च्याने च्हि होङ, राङ ख्युइ ङाला चाँचाँबा ना, तेहि ङाला करि क्याक्याइबा च्वरा हतिबा लाङ क्यायोङ नाइरे संसारयि हा:कोहोङ।<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />“आके ङा धोप्पा कि च्याइ, कि ख्युइ ङा ला पिपिना तेबा ङा काँहा होए, ङा ङ्याबो त्येयोङ राङ ङाहि छे थोङङोङ, काङ छे, संसारयि सोयापले ताङला ङाला करि क्याक्याइबा ति ख्युइ ङाला पिपिना होतो।” <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />“तेम्बायि आके, संसारयि ख्योएला ङोमिस्येबा, हिन्नाङ ङाहि ख्योएला ङोस्येयिन तेहि ख्युइ ङाला चाँरे नाइरे धिबाला छ्या होतो। <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />ङाहि ख्युइ मिन धिबाला थोङदु च्युकते, तेहि ख्युइ मिन धिबाला थोङदु च्युच्युकि च्युच्युका कि च्याइ, तेहि काङ करि ख्युइ ङाला करि क्याइरे, धि हतिबाला त्येयोङ, राङ ङा खेला त्येयोङ।”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">येशुला स्युस्युवा</para>
  <para style="r">
    <ref loc="MAT 26:47-56">मत्ति २६:४७-५६</ref>; <ref loc="MRK 14:43-50">मर्कुस १४:४३-५०</ref>; <ref loc="LUK 22:47-53">लुका २२:४७-५३</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />धि च्येला मोनलाम क्याप्ते येशु खुरि लोब्टुबा ङ्याबो किद्रोनला पुइसोङ। हतिया पाङ झि धुलो। येशु खुरि लोब्टुबा ङ्याबो हतिया स्युसोङ। <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />खोला सुङदु झ्युङान यहुदाला हाङ हति सा छ्या होतो, चिचालानाना येशु माङछेया खुरि लोब्टुबा ङ्याबो हतिया झोम्दे तोकिनलो। <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />तेहि भिजोउलि, म्हे राङ लाकच्या ख्योक्योबि सिपाहियि तुम झि राङ घोबा पुजारि राङ फरिसिबे चाँचाँबि कोराबा ख्योरे यहुदा हति पाङला लेप्सोङ। <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />तेहि रेँ थोला होङयापयि ताम पोरो हा:कोरे येशु धुनला लेप्सोङ, राङ हतिबाला नाइसोङ, “खे सुला फाकिन?”<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />हतिबे खोला नाइसोङ, “नासरतयि येशुला।” येशुयि हतिबाला नाइसोङ, “ङा हति राङ ना।” तेहि खोला सुङदु झ्युङान यहुदा याङ हतिया लाँरे तेतु। <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />जब ख्युइ हतिबाला “ङा हति राङ ना” नाइरे तेहि हतिबा क्यापला पुइसोङ, तेहि साला घेलसोङ। <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />याङ ख्युइ हतिबाला टिसोङ, “खे सुला फा किन?” हतिबे नाइसोङ, “नासरतयि येशुला।” <verse eid="JHN 18:7" /><verse number="8" style="v" sid="JHN 18:8" />येशुयि जवाक पिन्सोङ, “ङाहि खेला नाइछारते, ङा हति राङ ना। हति चाला खे ङाला फेना धि मितेबाला ढोरु छ्यु।” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />“ख्युइ ङाला पिपिनि नाङने च्हि याङ ङाहि मासि मालाङा नाइरे नानाइबि वचन पुरा होङ नाइरे धि च्युङसोङ।”<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />सिमोन पत्रुसयि खो राङला होएता तोरबालि तोन्दे हति यक्पुवाला क्यापते हति जब नामज्यो याइबाते तुप्ते क्युरसोङ। घोबा पुजारि यक्पुवायि ति मिन माल्खस हिना। <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />येशुयि पत्रुसला नाइसोङ, “तोरबालि तोर स्युपला छ्यु। च्हि आकि पिपिनि भोटोला ङा मिथुवाइ?”<verse eid="JHN 18:11" /></para>
  <para style="s">हन्नासयि धुनला येशु</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />हतिच्येला रोमि सिपाहियि तुम, हतिबे घोबा, राङ यहुदिबे कोराबाबे येशुला सुङसोङ, राङ खोला ताम्सोङ। <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />ताङला हतिबे खोला हन्‍नासयि तेहा खेरसोङ, सुते धि लोयि घोबा पुजारि कैयाफायि मेमे हिना। <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />खो हति कैयाफा राङ हिना, सुइ जनतातेबे चाला मिझि स्योएयाप राङ ल हुन नाइरे यहुदिबाला टोइ क्याइसोङ।<note caller="-" style="x"><char style="xo" closed="false">18:14 </char><char style="xt" closed="false"><ref loc="JHN 11:49-50">युहान्ना ११:४९-५०</ref></char></note><verse eid="JHN 18:14" /></para>
  <para style="s">पत्रुसयि ताङस्युवा माना नानाइबा</para>
  <para style="r">
    <ref loc="MAT 26:69-70">मत्ति २६:६९-७०</ref>; <ref loc="MRK 14:66-68">मर्कुस १४:६६-६८</ref>; <ref loc="LUK 22:55-57">लुका २२:५५-५७</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />सिमोन पत्रुस राङ येशुयि स्यान लोब्टु झि येशुयि च्येला पुइसोङ। हति स्यानते घोबा पुजारि ङोस्येस्येबा हिना, राङ येशु ङ्याबो राङ क्यला स्युरे। <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />हिन्नाङ पत्रुस फिला कोना राङ लाँरे तेतु। हति स्यान लोब्टुते, सुते घोबा पुजारि ङोस्येङान हिना लो, फिला कोना त्योएङानयि पोमुला नाइरे पत्रुसला नाङला ख्योसोङ। <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />तेहि हति कोना त्योएङान यक्मुवाति पत्रुसला नाइसोङ, “च्हि ख्योए याङ धि मि लोब्टुयि नाङने च्हि हिनाइ?” पत्रुसयि नाइरेलो, “ङा माना।” <verse eid="JHN 18:17" /><verse number="18" style="v" sid="JHN 18:18" />हतिया कोराबा रच्चिया यक्पुवातेबा लाँरे म्हे धि त्येतु चिचालानाना टाङ मि धुलो। तेहि पत्रुस याङ लाँरे हतिबा ङ्याबो म्हे धियाला छेलसोङ।<verse eid="JHN 18:18" /></para>
  <para style="s">येशुला घोबा पुजारि ताम टिटिबा</para>
  <para style="r">
    <ref loc="MAT 26:59-66">मत्ति २६:५९-६६</ref>; <ref loc="MRK 14:55-64">मर्कुस १४:५५-६४</ref>; <ref loc="LUK 22:66-71">लुका २२:६६-७१</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />तेहि घोबा पुजारि येशुयि लोब्टु राङ ख्युइ छोइ यि भारेला टिसोङ। <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />येशुयि हतिला जवाक पिन्सोङ, “ङाहि संसारला मिसाँबा नाइरे। ङाहि बारतै यहुदि झोमसि खिम राङ मोनलाम क्यासि खिमला छोइ पिपिना होतो, काँहा यहुदिबा पोरो झोमिन। ङाहि फाला च्याङ नानाइबा मेता। <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />ङाला च्हिला ढिन? ङाहि खेला च्हि नाइरे ङ्यानङानतेबा ला राङ टि। ङाहि नानाइबि ताम तेबा हतिबाला छ्या होतो।”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />येशुयि धि तामतेबा नेतुइना धुनला लाँलाँबि कोराबाझि कि जु नेन राङ येशुला थालच्या क्यापसोङ, “च्हि घोबा पुजारि ङ्याबो धि च्वरा क्याइरे जवाक तेरिनाइ?”<note caller="-" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="MIC 5:1">मिका ५:१</ref> </char></note> <verse eid="JHN 18:22" /><verse number="23" style="v" sid="JHN 18:23" />येशुयि हतिला नाइसोङ, “ङाहि घल नाइना हति प्रमाण नाङ हिन्नाङ तेम्बारे ङाहि थारका नाइना च्हिला ङाला क्याप्ते?” <verse eid="JHN 18:23" /><verse number="24" style="v" sid="JHN 18:24" />तेहि हन्‍नासयि तातामा ला राङ घोबा पुजारि कैयाफा यि तेहा चाँसोङ।<verse eid="JHN 18:24" /></para>
  <para style="s">पत्रुसयि ङिबा राङ सुबा माना नानाइबा</para>
  <para style="r">
    <ref loc="MAT 26:71-75">मत्ति २६:७१-७५</ref>; <ref loc="MRK 14:69-72">मर्कुस १४:६९-७२</ref>; <ref loc="LUK 22:58-62">लुका २२:५८-६२</ref></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />सिमोन पत्रुस लाँरे म्हे धि तेतु। हतिबे खोला नाइसोङ, “च्हि ख्युइ लोब्टुबे नाङने च्हि ख्योए याङ मानाइ च्हि?” हति माना नाइरे नाइसोङ, “ङा माना।” <verse eid="JHN 18:25" /><verse number="26" style="v" sid="JHN 18:26" />घोबा पुजारि यक्पुवायि नाङने च्हि, सुइ पुल्लायि जब पत्रुसयि तुप्तु, हति टिसोङ, “च्हि ङाहि ख्योएला खो ङ्याबो पाङला माथोङाइ च्हि?” <verse eid="JHN 18:26" /><verse number="27" style="v" sid="JHN 18:27" />तेहि याङ पत्रुसयि माना नाइसोङ। तेहि होप:तामेला च्याबो पोइसोङ।<verse eid="JHN 18:27" /></para>
  <para style="s">पिलातसयि धुनला येशु</para>
  <para style="r">
    <ref loc="MAT 27:1-2">मत्ति २७:१-२</ref>; <ref loc="MAT 11:14">११:१४</ref>; <ref loc="MRK 15:1-5">मर्कुस १५:१-५</ref>; <ref loc="LUK 23:1-55">लुका २३:१-5५</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />तेहि हतिबे येशुला कैयाफायि खिमने खिम छोम्मुवा हअला खेरसोङ। हति तुना नामे हिना। झोम्दे निस्तार कालापसोलयि भत्यार साज्याइ मिखुबा नाइरे हतिबा खिम छोम्मुवायि नाङला मास्युवालो। <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />तेहि हतिबे तेहा फिला थोन्दे पिलातसयि नाइसोङ, “धि मि विरोधला खे च्हि आरोप लाइ किन?” <verse eid="JHN 18:29" /><verse number="30" style="v" sid="JHN 18:30" />हतिबे खोला नाइसोङ, “तेम्बारे धि मि अपराधि माना नाना ता ङे ख्योएला चिचाला सोच्याइ।”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />पिलातसयि हतिबाला नाइसोङ, “खे धिला खेर, राङ खिरि ठिमने धिला ठिम कि।” यहुदिबे खोला नाइसोङ, “मि सुलाङ स्योएपयि आङ ङेला, मेता।” <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />खो च्हिरु क्याइरे सिन नाइरे हति ता पिन्दे येशुयि नानाइबि वचन पुरा होङ नाइरे धि च्वरा च्युच्युङा ना।<note caller="-" style="x"><char style="xo" closed="false">18:32 </char><char style="xt" closed="false"><ref loc="JHN 3:14">युहान्ना ३:१४</ref>; <ref loc="JHN 12:32">१२:३२</ref></char></note> <verse eid="JHN 18:32" /><verse number="33" style="v" sid="JHN 18:33" />पिलातस याङ खिम छोम्मुवायि नाङला स्यु सोङ, राङ ख्युइ येशुला क्ये ताङदे नाइसोङ, “च्हि ख्योए यहुदिबे क्यालबो हिनाइ?” <verse eid="JHN 18:33" /><verse number="34" style="v" sid="JHN 18:34" />येशुयि जवाक पिन्सोङ, “ख्योए ख्योएराङ धि च्वरा नेन्दु, वा ङाहि भारेला ख्योएला स्यान यि नाइसुइ?”<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />पिलातसयि जवाक पिन्सोङ, “च्हि ङा यहुदि हिन दुये? ख्युइ मितेबा राङ घोबा पुजारि ख्योएला ङाला टोएसोङ। ख्युइ च्हि क्याइरे?” <verse eid="JHN 18:35" /><verse number="36" style="v" sid="JHN 18:36" />येशुयि जवाक पिन्सोङ, “ङाहि राज्य धि संसारयि माना। ङाहि राज्य धि संसारयि हिना ता ङाला रुवा किङान तेबा ङाहि चाला रुवा किङान ना, राङ ङा यहुदिबे लला थेपङान माना ना। हिन्नाङ ङाहि राज्य धि संसारयि माना।” <verse eid="JHN 18:36" /><verse number="37" style="v" sid="JHN 18:37" />पिलातसयि खोला टिसोङ, “च्हि ख्योए क्यालबो राङ हिनाइ?” येशुयि जवाक पिन्सोङ, “ङा क्यालबो ना नाइरे ख्योए राङ नेन दु, धि चाला राङ ङा क्येक्येबा ना, राङ हति चाला राङ धि संसारला तेम्बि साछि तेरतु लेलेबा ना। पोरो सु तेम्बि छ्याला होतो, हति ङाहि क्ये थोयिन।”<note caller="-" style="x"><char style="xo" closed="false">18:37 </char><char style="xt" closed="false"><ref loc="1JN 4:6">१ युहान्ना ४:६</ref></char></note> <verse eid="JHN 18:37" /><verse number="38" style="v" sid="JHN 18:38" />पिलातसयि खोला टिसोङ, “तेम्बा च्हि ना?” होचोम नाइरे यहुदिबे तेहा फिला थोन्दे पुइसोङ, राङ हतिबाला नाइसोङ, “ङाहि खोला च्याङ दोष मि ठाता।”<verse eid="JHN 18:38" /></para>
  <para style="s">येशुला सोयापयि आदेश</para>
  <para style="r">
    <ref loc="MAT 27:15-21">मत्ति २७:१५-२१</ref>; <ref loc="MRK 15:1-5">मर्कुस १५:१-५</ref>; <ref loc="LUK 23:13-15">लुका २३:१३-१५</ref></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 18:39" />निस्तार कालापसोलला ङाहि मिझिला खि चाला तोङयाप खि माग होतो। च्हि खे धोप्पा किनाइ, कि यहुदियि क्यालबोला तोङज्ये? <verse eid="JHN 18:39" /><verse number="40" style="v" sid="JHN 18:40" />हिन्नाङ हतिबे जु नेन राङ क्ये तोन्सोङ, “धि ला माना हिन्नाङ बारब्बाला।” बारब्बा ते डाकु हिना।<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />तेहि पिलातसयि येशुला खेरते च्यायि छेरिमिन च्यालता क्याक्तु च्युसोङ। <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />तेहि सिपाहितेबे ख्युइ घोबोला छेरमि टोपो कापसोङ, राङ खोला बैजनी छोइयि कोहिला कापसोङ, <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />राङ ख्युइ धुनला लेप्ते नाइसोङ, “खामसाँ, यहुदिबे क्यालबो!” तेहि हतिबे खोला थालच्या क्यापसोङ।<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />याङ फिला थोन्दे पिलातसयि हतिबाला नाइसोङ, “तोइ, ङाहि खोला खि तेहा ख्युहि होए, राङ खेला हा:कोरु झ्युकच्याइ, ङाहि खोला च्याङ दोष मिथुवा।” <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />तेहि छेरमि टोपो राङ बैजनी छोइयि कोहिला कोकोना येशु फिला लेप्सोङ, राङ पिलातसयि हतिबाला नाइसोङ, “तोइ, धि मिला!”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />जब घोबा पुजारि राङ कोराबातेबे खोला थोङसोङ, हतिबे जु नेन राङ क्ये तोन्सोङ, “हतिला क्रुसला थ्ह, हतिला क्रुसला थ्ह!” पिलातसयि नाइसोङ, “खे राङ धिला क्रुसला पुते थ्ह, चिचालानाना ङाहि धि ला च्याङ दोष मिखुबा!” <verse eid="JHN 19:6" /><verse number="7" style="v" sid="JHN 19:7" />यहुदिबे खोला नाइसोङ, “ङि ठिम झि होतो, राङ हति ठिम च्वरा हिन्ना धि सि कोहिराङ हुन, चिचालानाना खो खोराङ कजसुबे पिजा हिना नेन्दु।”<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />धि ताम थोइरे पिलातस झन ख्यारसोङ।<note caller="-" style="x"><char style="xo" closed="false">19:8 </char><char style="xt" closed="false"><ref loc="LEV 24:16">लेवि २४:१६</ref></char></note> <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />खो याङ खिम छोम्मुवायि नाङला स्युरे येशुला टिसोङ, “ख्योए काने ना?” हिन्नाङ येशुयि खोला च्याङ मानाइसोङ। <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />हतिचाला पिलातसयि खोला नाइसोङ, “च्हि ख्योए ङा ङ्याबो ताम मिनाइ? ख्योएला तोङयापयि आङ ङाला होतो, राङ ख्योएला क्रुसला धपापयि आङ याङ ङाला होतो नाङान ख्योएला छ्या मेताइ?”<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />येशुयि जवाक पिन्सोङ, “ख्योएला कजसुबे मापिना नाना ङाहि थोला च्याङ आङ मिहा। हति चाला ङाला ख्युइ लाला तेरङानते झन तिक्पि दोषि हुन।” <verse eid="JHN 19:11" /><verse number="12" style="v" sid="JHN 19:12" />हतिच्येला पिलातसयि खोला तोङयापयि लेइराङ कोशिश क्याइसोङ। हिन्नाङ यहुदिबे जु नेन राङ क्ये तोन्सोङ, “तेम्बारे ख्युइ धि मिला ताङना ख्योए कैसरयि रबो माना। रेँ राङला क्यालबो हिना नाङान पोरो कैसरयि विरोधला लाँयिन।”<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />पिलातसयि धि ताम थोइरे येशुला फिला ख्योसोङ, राङ खो? “टोउयि” छ्या नाङानयि साला काङतेला हिब्रुला गब्बथा नेन ल अल भेयापयि ठिला त्येसोङ। <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />हति भेलाते निस्तार कालापसोलयि तयारि ङिन हिना, ङिम्मुइ हा:लाम च्युनङि बजेना माला हिना। पिलातसयि यहुदिबाला नाइसोङ, “तोइ खि क्यालबो!” <verse eid="JHN 19:14" /><verse number="15" style="v" sid="JHN 19:15" />हिन्नाङ हतिबे जु नेन राङ क्ये तोन्सोङ, “धिला सोए, सोए, धिला क्रुसला थ्ह!” घोबा पुजारिबे जवाक पिन्सोङ, पिलातसयि हतिबाला टिसोङ, “च्हि ङा खि क्यालबोला क्रुसला ध्हच्ये?” “कैसर अर्थात ङि स्यान सुङ क्यालबो मेता।” <verse eid="JHN 19:15" /><verse number="16" style="v" sid="JHN 19:16" />तेहि ख्युइ येशुला क्रुसला धतु हतिबे लाला सातेलो। हति चाला सिपाहितेबे जिम्माला खेरसोङ।<verse eid="JHN 19:16" /></para>
  <para style="s">येशु क्रुसला ताताबा</para>
  <para style="r">
    <ref loc="MAT 27:32-44">मत्ति २७:३२-४४</ref>; <ref loc="MRK 15:21-32">मर्कुस १५:२१-३२</ref>; <ref loc="LUK 23:26-43">लुका २३:२६-४३</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />खो खुरि क्रुस खुरते खप्पेर नाङान साला पुइसोङ, काङला हिब्रुला गलगथा नेनलो। <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />हतिया खोला क्रुसला तारेलो राङ खो ङ्याबो स्यान ङि लाङ तारेलो, च्हिला यि च्हिला राङ स्यानतेला स्यान यहला तारेलो, राङ उइला येशुला। <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />पिलातसयि दोष पाना झि याङ टिसोङ, तेहि क्रुसला च्यारसोङ। हतिला धि टि धुलो, “नासरतयि येशु, यहुदिबे क्यालबो।” <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />तेहि यहुदि लेइराङयि हति दोष पानाते टसोङ, चिचालानाना येशु क्रुसला ताताबि सा भजारयि धुनला धुलो। हति हिब्रु, लाटिन राङ ग्रिक क्येला टिदुलो। <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />यहुदिबे घोबा पुजारियिति पिलातसला नाइसोङ, “‘यहुदिबे क्यालबो’ नायाप माना, हिन्नाङ हति यहुदिबे क्यालबो हिना नाइसोङ नाइरे ढोयाप ना।” <verse eid="JHN 19:21" /><verse number="22" style="v" sid="JHN 19:22" />पिलातसयि जवाक पिन्सोङ, “ङाहि च्हि टिरे, टिरे।”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />जब सिपाहियि येशुला क्रुसला तारेलो, हतितुइना ख्युइ कोहिला खेरते ओरला च्यिच्यि थोपयापयि हिसाबला भाग च्हि सोइसोङ। ख्युइ फि कोहिला याङ खेरसोङ, हति कोहिला ते चेचेमा माना तोएने राङ म्हे थु लालाइबा किरबो हिना। <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />हतिचाला हतिबे ख्होरे नाङला नारे क्याइसोङ, “धि मारोल हिन्नाङ धि सुइ होङयाप हिना नाइरे क्यान स्यिङ क्याका।” पवित्रशास्त्रा पुरा होङ नाइरे राङ धि च्युङ शास्त्रा “हतिबे ङाहि कोहिला राराला साला कोइसोङ, फि कोहिलाते क्यानसिङ क्यापसोङ।”<note caller="-" style="x"><char style="xo" closed="false">19:24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">भजनसंग्रह २२:१८</ref></char></note><verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />हति चाला सिपाहितेबे धि लाइ क्याइरे लो। तेहि येशुयि क्रुसयि धुनला ख्युइ आमा, ख्युइ आमायि भैनि, क्लोपासयि भैनि मरियम राङ मरियम मग्‍दलिनि लाँरे तेतु। <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />जब येशुयि खुरि आमा राङ ख्युइ करि किङान लोब्टु टुला लालाबा थोङसोङ, हतितुइना ख्युइ खुरि आमाला नाइसोङ, “पोमु तेहि, ख्युइ पिजा!” <verse eid="JHN 19:26" /><verse number="27" style="v" sid="JHN 19:27" />तेहि हति लोब्टुतेलाङ नाइसोङ, “तेहि ख्युइ आमा!” हति भेला ने हति लोब्टुति मोला खुरि खिमला खेरसोङ।<verse eid="JHN 19:27" /></para>
  <para style="s">येशु स्यिस्यियायि</para>
  <para style="r">
    <ref loc="MAT 26:45-56">मत्ति २६:४५-५६</ref>; <ref loc="MRK 15:33-41">मर्कुस १५:३३-४१</ref>; <ref loc="LUK 23:44-49">लुका २३:४४-४९</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />तहि च्येलाता येशुयि ताम पोरो सिन्सोङ नाइरे हा:कोरे पवित्रशास्त्रा पुरा होङ नाइरे नाइसोङ, “ङा खा कोम्सोङ।”<note caller="-" style="x"><char style="xo" closed="false">19:28 </char><char style="xt" closed="false"><ref loc="PSA 22:15">भजनसंग्रह २२:१५</ref>; <ref loc="PSA 69:21">६९:२१</ref></char></note> <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />खाडे खुवायि खाँखाँबि सअबुझि धुलो। खुवायि खाखा बे कपास होसपयि ढालाला पोरते हति ख्युइ खाला क्यालसोङ।<note caller="-" style="x"><char style="xo" closed="false">19:29 </char><char style="xt" closed="false"><ref loc="PSA 69:21">भजनसंग्रह ६९:२१</ref></char></note> <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />तेहि येशुयि खाडे खुवातेबा तुँसोङ, तेहि ख्युइ नाइसोङ, “ता सिन्सोङ,”तेहि ख्युइ घोबो थुल्ला क्याइरे रेँ उ च्येसोङ।<note caller="-" style="x"><char style="xo" closed="false">19:30 </char><char style="xt" closed="false"><ref loc="LUK 23:46">लुका २३:४६</ref>; <ref loc="MRK 15:37">मर्कुस १५:३७</ref></char></note><verse eid="JHN 19:30" /></para>
  <para style="s">येशुयि टाङ तोतोला</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />हति ङिन छेलयापयि ङिनलो। हति चाला यहुदि आङकिङानबे ङालसुइ ङिन स्यिस्यियायि स्हु क्रुसला माभोर नाइरे पिलातसला स्युवा क्याप्सोङ, राङ हतिबे काङ च्याक्ते हतिबा ला खेर नाइरे माग क्याइसोङ <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />तेहि सिपाहि तेबा लेप्ते खो ङ्याबो क्रुसला ताताबातेबे काङबा च्यासोङ, ताङला चिकि राङ च्हिला स्यान त्हि। <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />तेहि हतिबा येशुयि तेहा लेप्सोङ हतिबे थोङसोङ, कि येशु तेकि राङ स्यिदु नाइरे, राङ ख्युइ काङबा माच्याँका लो। <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />हिन्नाङ सिपाहतिबे नाङने च्यियि ख्युइ चिमाला च्यायि पोरकि चासोङ, तेहि युप्पु झिला ठा राङ छ्यु थोन्सोङ। <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />खे याङ हिछे कि नाइरे थोङान तेबे साछि पिपिना ना। राङ ख्युइ साछि तेम्बा ना, राङ तेम्बा नेन नाइरे हा:कोरेलो। <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />“ख्युइ रेँ रुइको च्हि याङ च्यकोइ मिदु” नाङान यि पवित्रशास्त्रयि धि वचन पुरा होङ नाइरे धि ताम च्युङसोङ।<note caller="-" style="x"><char style="xo" closed="false">19:36 </char><char style="xt" closed="false"><ref loc="EXO 12:46">प्रस्थान १२:४६</ref>; <ref loc="NUM 9:12">गन्ति ९:१२</ref>; <ref loc="PSA 34:20">भजनसंग्रह ३४:२०</ref></char></note> <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />याङ स्यान साला पवित्रशास्त्रा नेनदु, “काङला खि सुरतु हतिबे खोला ताङान माना ना।”<note caller="-" style="x"><char style="xo" closed="false">19:37 </char><char style="xt" closed="false"><ref loc="ZEC 12:10">जकरिया १२:१०</ref>; <ref loc="REV 1:7">प्रकास १:७</ref></char></note><verse eid="JHN 19:37" /></para>
  <para style="s">येशुयि रो तोयाप</para>
  <para style="r">
    <ref loc="MAT 27:57-61">मत्ति २७:५७-६१</ref>; <ref loc="MRK 15:42-47">मर्कुस १५:४२-४७</ref>; <ref loc="LUK 23:50-56">लुका २३:५०-५६</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />हतिच्येला अरिमाथियायि योसेफ, काङते यहुदिबाला झिरे फा:ला मात्रा येशुयि लोब्टु हिना, हति पिलातसला येशुयि रो खेरच्याइ नाइरे स्युवा क्यापसोङ। पिलातसयि आङ पिन्सोङ। तेहि खो लेप्ते स्यिस्यिये स्हु खेरसोङ। <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />तेहि तकि छाम्मु होङान निकोदेमस याङ हा:लाम ङिस्यु राङ च्यु किलो मुर्र राङ एलवा स्येस्येबा ल टिमायि मोरकु ख्योहोरे लेप्सोङ।<note caller="-" style="x"><char style="xo" closed="false">19:39 </char><char style="xt" closed="false"><ref loc="JHN 3:1">युहान्ना ३:१</ref></char></note> <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />हति च्वरा क्याइरे येशुयि स्यु यहुदिबे रो तहयापयि लुलाम च्वरा क्याइरे टिमा स्यिबो मलम राङ ङ्याबो कोहिलायि तुम्सोङ। <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />खोला क्रुसला ताताबि साला हतिया पाङ झि धु। हति पाङला च्याङ मापोरि तुर झि धु। <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />चिचालानाना यहुदिबे तयारियि ङिन हिना, तेहि हति तुर याङ धुनला धु, राङ तेहि हतिबे येशुयि स्हु हति तुरला राङ पोरसोङ।<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">तोङबा तुर</para>
  <para style="r">
    <ref loc="MAT 28:1-8">मत्ति २८:१-८</ref>; <ref loc="MRK 16:1-8">मर्कुस १६:१-८</ref>; <ref loc="LUK 24:1-12">लुका २४:१-१२</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />हप्तायि ताङस्युवा ङिन नामे मुन्नाला राङ मरियम मग्‍दलिनि नाङान तुरला लेप्सोङ, राङ मुइ टोउ तुरने टिटिमा थोङसोङ। <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />हति सिमोन पत्रुस राङ येशुयि करि किङान स्यान लोब्टुते स्युरते पुइसोङ, तेहि हतिबाला नाइसोङ, हतिबे प्रभुला तुरने फिला खेरतु, राङ खोला काँहा पोरते, ङेला छ्या मेता। <verse eid="JHN 20:2" /><verse number="3" style="v" sid="JHN 20:3" />तेहि पत्रुस राङ स्यान लोब्टुते फिला थोन्दे तुर यहला पुइसोङ। <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />हतिबा ङिकार ङ्याबोङ्याबो स्युरे पुइसोङ, तेहि स्यान लोब्टुते पत्रुसला पोरते ताङला तुरला लेप्सोङ। <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />तुरयि नाङला घोबो कहुरे तेतुइना, ख्युइ तेकि लाइ तातामि सुतियि कोहिला मात्रा होएता थोङसोङ, हिन्नाङ खो नाङला मास्युसोङ। <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />सिमोन पत्रुस च्येच्येला लेप्सोङ, राङ तुरयि नाङला स्युसोङ, ख्युइ याङ मलमलयि तातामि कोहिला मात्रा थोङसोङ। <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />ख्युइ घोबोला तातामि रुमालते मलमलयि कोहिला ङ्याबो मिधु हिन्नाङ कुरु सा झिला ताप्ते पोरतुलो। <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />तेहि तुरला ताङला होङान स्यान लोब्टुते हाङ नाङला स्युसोङ, राङ हति थोङसोङ हति हिछे क्याइसोङ। <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />चिचालानाना हतिबे खो स्यिरे लाँ कोहिहुन नाङान पवित्रशास्त्रायि ताम थाल्ला थु हा:कोकुवा मेता।<note caller="-" style="x"><char style="xo" closed="false">20:9 </char><char style="xt" closed="false"><ref loc="PSA 16:10">भजनसंग्रह १६:१०</ref></char></note> <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />हतिच्येला हति लोब्टुबा खिमला लक्ते पुइसोङ।<verse eid="JHN 20:10" /></para>
  <para style="s">येशु मरियम मग्दलिनियि तेहा थोथोङा</para>
  <para style="r">
    <ref loc="MAT 28:9-10">मत्ति २८:९-१०</ref>; <ref loc="MRK 16:9-11">मर्कुस १६:९-११</ref></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />हिन्नाङ मरियम तुरयि फिला ङुन राङ तेतु। मो ङुन राङ तुर यहला घो कहुरे ताइसोङ, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />राङ काँहा येशुयि स्यिस्यियायि स्हु पोपोरा होतो, हतिया कारबो कोहिला कोकोना तेङलायि लोन खेरङान ङेला च्यिते घोबोला राङ च्यि काङबा यहला ताताता मुइ थोङसोङ। <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />हतिबे मोला नाइसोङ, “पोमु चिचाला ङुन?” मुइ हतिबाला नाइसोङ, “हतिबे ङाहि प्रभुला खेरतु, खोला काँहा पोरते, ङाला छ्या मेता।”<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />धि ताम नाइरे छारते मो क्याप यहला ताइसोङ, राङ मुइ येशु लाँरे ताताता थोङसोङ हिन्नाङ येशु राङ हिना नाइरे ङोमास्येसोङ। <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />येशुयि हतिला नाइसोङ, “पोमु ख्योए चिला ङुन? सुला फाकिन?” मुइ हतिला पाङयि चा तुप्ङान हिना नाइरे नाइसोङ, “हजुर, ख्युइ खोला धिने खेखेरा हिन्ना, काँहा पोरते ङाल नोइ, राङ ङा खोला खेरच्याइ।” <verse eid="JHN 20:15" /><verse number="16" style="v" sid="JHN 20:16" />येशुयि हतिला नाइसोङ, “मरियम!” ख्युइ लक्ते मोला हिब्रुला नाइसोङ, “रब्बिनि” मदलब “हे गुरुज्युनि!” <verse eid="JHN 20:16" /><verse number="17" style="v" sid="JHN 20:17" />येशुयि मोला नाइसोङ, “ङाला लाक्पा माधो, चिचालानाना ङा थाल्ला थु आकि तेहा मा पुता। हिन्नाङ ङाहि भाइबे तेहा पुते हतिबाला नोइ, ‘ङाहि आके राङ खि आके, राङ ङाहि कजसुबा राङ खि कजसुबे तेहा ढुन होए।’” <verse eid="JHN 20:17" /><verse number="18" style="v" sid="JHN 20:18" />मरियम मग्दलिनि पुइसोङ, राङ लोब्टुबाला स्येसोङ, “ङाहि प्रभुला थोङसोङ।” तेहि ख्युइ नानाइबि ताम हतिबाला मुइ नाइसोङ।<verse eid="JHN 20:18" /></para>
  <para style="s">येशु लोब्टुबे तेहा थोङसोङ</para>
  <para style="r">
    <ref loc="MAT 28:16-20">मत्ति २८:१६-२०</ref>; <ref loc="MRK 16:14-18">मर्कुस १६:१४-१८</ref>; <ref loc="LUK 24:36-49">लुका २४:३६-४९</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />हति ङिन, मदलब हप्तायि ङिन ताङस्युवा कमु, जब लोब्टुबा यहुदिबाला झिरे को क्यापते नाङला ताताता धुलो, येशु लेप्ते हतिबे उइला लाँरे त्येसोङ, राङ हतिबाला नाइसोङ, “खेला शान्ति!” <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />हति नाइरे हतिबाला रेँ टाङ राङ लाक्पा तान्सोङ। प्रभुला थोङदे लोब्टुबा कासोङ। <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />तेहि याङ येशुयि हतिबाला नाइसोङ, “खेला शान्ति! च्हिरु क्याइरे आकि ङाला चाँसोङ, हति च्वरा क्याइरे ङा खे ला चोङज्याइ।” <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />तेहि होचोम नाइरे ख्युइ हतिबे थोला उ ताङदे नाइसोङ, “पवित्र आत्मा खेर। <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />सुइ मियि तिक्पा खे माप किन हतिबे तिक्पा झ्हयिन, राङ सुइ तिक्पा माप मिकिता हति तिक्पा माप मिहा।”<verse eid="JHN 20:23" /></para>
  <para style="s">येशु राङ थोमा</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />येशु हुइतुइना च्युनङियि नाङने चि, दिदुमास नाङान थोमाते, हतिबा ङ्याबो मिधु। <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />हतिचाला स्यान लोब्टुतेबे खोला नाइसोङ, “ङाहि प्रभुला थोङसोङ।” हिन्नाङ ख्युइ हतिबाला नाइसोङ, “जब थु ङाहि ख्युइ लक्पाला किलोयि मेटा मिथुवा, राङ किलोयि मेटाला झु मिसुरा, ख्युइ टाङला लाक्पा मिसुरा, हति थु ङा हिछे मिके”<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />ङिन क्येयि च्येला याङ ख्युइ लोब्टुतेबा खिमयि नाङला राङ धु। थोमा याङ हतिबा ङ्याबो धु। को तेबा क्यापतु हिन्नाङ येशु नाङला स्युसोङ, राङ उइला लाँरे नाइसोङ, “खेला शान्ति!” <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />तेहि ख्युइ थोमाला नाइसोङ, “ख्युइ झु ङिया पोर, राङ ङाहि लाक्पातेबा तोइ। ख्युइ लाक्पा ख्योरे ङाहि टोपाला छ्यु। हिमिछे माके राङ हिछे किङान सह।” <verse eid="JHN 20:27" /><verse number="28" style="v" sid="JHN 20:28" />थोमायि खोला नाइसोङ, “ङाहि प्रभु, राङ ङाहि कजसुबा!”<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />येशुयि हतिला नाइसोङ, “ख्युइ ङाला थोथोति चाला ङाला हिछे क्याइसोङ? धन्य ना हतिबा, सुइ ङाला थोथोङा मेता हिन्नाङ हिछे किन्दु।”<verse eid="JHN 20:29" /></para>
  <para style="s">धि किताबयि उदेश्य</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />येशुयि लेइराङ हा:लाइयापयि लाइतेबा लोब्टुबे धुनला क्याइसोङ, काङते धि किताबला टिटिबा मेता। <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />हिन्नाङ धि टिटिबा होतो, कि खि येशु कजसुबे पिजा, ख्रिष्ट होतो नाइरे हिछेयि लाम्ला ख्युइ मिनला खेला मिजे खुवार सह।<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">येशु लोब्टु तुनयि तेहा थोथोवा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />हतिच्येला लोब्टुबे तेहा तिबेरियास छो छोम्मुवायि धुनला येशुयि याङ खो राङला तानसोङ। ख्युइ खो राङला धि च्वरा क्याइरे थोङदु च्युसोङ: <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />सिमोन पत्रुस, दिदुमास नाङ थोमा, गालिलयि काना भजारयि नथानेल, जब्दियायि पिजा ङिबो राङ ख्युइ लोब्टुबे नाङने स्यान ङिबो ङ्याबो धुलो। <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />सिमोन पत्रुसयि हतिबाला नाइसोङ, “ङा ङ्या सोतु ढुन होए।” हतिबे खोला नाइसोङ, “ङेला याङ ख्योए ङ्याबो होङज्याइ।” हतिबा पुते डुङगाला स्योसोङ हिन्नाङ हति छाम्मु हतिबे च्याङ मासुङा।<note caller="-" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="LUK 5:5">लुका ५:५</ref></char></note> <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />नामे हुवाला छेलसोङ, येशु छ्युइ नेमुला लाँरे तेतु। हिन्नाङ लोब्टुबे खो येशु राङ हिना नाइरे ङोमास्येबा। <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />येशुयि हतिबाला नाइसोङ, “च्हिटाबा, खेला ङ्या रेन होतोइ?” हतिबे खोला जवाक पिन्सोङ, “मेता।”<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />ख्युइ हतिबाला नाइसोङ, “झालि डुङगायि याइ यहला छ्यु, तेहि खुङान ना।” तेहि हतिबे झालि च्युसोङ, राङ ङ्या माहारा छेरे हतिबे धोन माङ्युइसोङ।<note caller="-" style="x"><char style="xo" closed="false">21:6 </char><char style="xt" closed="false"><ref loc="LUK 5:6">लुका ५:६</ref></char></note> <verse eid="JHN 21:6" /><verse number="7" style="v" sid="JHN 21:7" />येशुला करि किङान लोब्टुति येशुला नाइसोङ, “खो प्रभु हिना ये।” “खो प्रभु हिना” नाङान थोइरे सिमोन पत्रुसयि रेँ फियि कोहिला केप्पाला तामसोङ, चिचालानाना ख्युइ कोहिला पुइतु राङ छुला फारसोङ। <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />स्यान लोब्टुतेबा डुङगाला राङ ताते ङ्या थेथेबि झालि ढुन किनराङ लेप्सोङ। हतिबा छोयि नेमुला घ्याबोला माना, हिन्नाङ हा:लाम मिटर क्या झि झोमयि घ्याबोला धु। <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />जब हतिबा नेमुला पुप्ते, हतितुइना हतिबे सोलायि थपुङला ङ्या पोपोरा लोटा थोङसोङ। <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />येशुयि हतिबाला नाइसोङ, “थाल्ला खि सुसुङायि ङ्याने रेन ख्याला।” <verse eid="JHN 21:10" /><verse number="11" style="v" sid="JHN 21:11" />तेहि सिमोन पत्रुस पुते डुङगाला स्योन्दे क्या राङ ङोपच्यु राङ सुम थाबा ङ्या छोम्मुवायि खाँखाँबि झालि पाङला टुइसोङ, हिन्नाङ होचोम होएनाङ झालि मारालसोङ। <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />येशुयि हतिबाला नाइसोङ, “लेप्ते सो।” लोब्टुबे नाङने सुइ याङ “ख्योए सुना?” नाइरे ढि माङ्युइसोङ, चिचालानाना खो प्रभु हिना नाङान छ्या होतो। <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />येशु लेप्सोङ राङ हतिबाला लोटा पिन्सोङ। हति च्वरा क्याइरे ङ्यायाङ पिन्सोङ। <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />स्यिरे सोम्बो च्युङदे लाँरे लेलेबा येशु लोब्टुबे तेहा थोथोङा लाम्मा सुबा हिना।<verse eid="JHN 21:14" /></para>
  <para style="s">येशु राङ पत्रुस</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />जब हतिबे साइ छारसोङ, हतितुइना येशुयि सिमोन पत्रुसला नाइसोङ, “युहान्नायि पिजा सिमोन, च्हि ख्योए धिबाले म्हा ङाला करि किनाइ?” हति खोला नाइसोङ, “ज्यु प्रभु, ख्योएला छ्या होतो ङा ख्योएला करि किन।” ख्युइ हतिला नाइसोङ, “ङाहि लुतेबाला सायाप पिन।” <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />ख्युइ याङ लाम्मा सुबा हतिला नाइसोङ, “युहान्नायि पिजा सिमोन, च्हि ख्योए ङाला करि किनाइ?” ख्युइ खोला नाइसोङ, “ज्यु, प्रभु, ख्योएला छ्या होतो, ङा ख्योएला करि किन।” ख्युइ हतिला नाइसोङ, “ङाहि लुबाला ल क्याइरे तोइ।” <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />ख्युइ हतिला लाम्मा सुबा टिसोङ, “युहान्नायि पिजा सिमोन, च्हि ख्योए ङाला करि किनाइ?” पत्रुसयि सम तुसोङ, चिचालानाना ख्युइ लाम्मा सुबा खोला “च्हि ख्योए ङाला करि किनाइ?” नाइसोङ। ख्युइ हतिला नाइसोङ। “प्रभु, ख्योएला ताम पोरो छ्या होतो।” ङा ख्योएला करि किन नाइरे ख्योएला छ्या होतो येशुयि हतिला नाइरेलो, “ङाहि लुबाला तोइ।” <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />तेम्बारे, “ङा ख्योएला नाज्याइ, जब ख्योए स्यारा होतो ख्योए खुरि कारा ख्युरि किसोङ, राङ काँहा ढोसोम होए ढुन्दु। हिन्नाङ जब ख्योए काप्पो हुन, तेहि ख्योए खुरि लाक्पा क्योङान ना, राङ स्यानयि ख्युइ कारा छिङान ना, राङ काँहा ख्योए ढोसोम म्हे हतिया खेरङान ना।” <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />च्हिरु क्याइरे स्यिरे ख्युइ कजसुबे छे धेकिन, हति ता तोनिन राङ ख्युइ धि नानाइबा ना। झोम नाइरे येशुयि पत्रुसला नाइसोङ, “ङाहि च्येला सअ।”<verse eid="JHN 21:19" /></para>
  <para style="s">येशु रच्चिया स्यान लोब्टु</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />पत्रुसयि क्यापला लक्ते तेतुइना येशुयि करि किङान लोब्टुला च्येला हुन ताताता थोङसोङ। ख्युइ राङ कमुइ ङ्योपि तुइना ख्युइ टाङला ङेरे, “प्रभु, ख्योएला सुङान सुना?” नाइरे टिसोङ।<note caller="-" style="x"><char style="xo" closed="false">21:20 </char><char style="xt" closed="false"><ref loc="JHN 13:25">युहान्ना १३:२५</ref></char></note> <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />खोला थोङदे पत्रुसयि येशुला नाइसोङ, “प्रभु, ख्युइते च्हि हुन?” <verse eid="JHN 21:21" /><verse number="22" style="v" sid="JHN 21:22" />येशुयि पत्रुसला नाइसोङ, “ङा मालेप थु खो त्येना ङाहि धोप्पा ख्योएला च्हि? ख्योए ङाहि च्येला सअ।” <verse eid="JHN 21:22" /><verse number="23" style="v" sid="JHN 21:23" />हतिचाला हति लोब्टु मिस्यिया नाङान भाइबे नाङला टाइक्ये च्युङसोङ। येशुयि खो मिस्यिया नानाइबा माना हिन्नाङ “ङा मालेप थु खो कहुरे सोम्बो त्येना ङाहि धोप्पा ख्योएला च्हि?” नानाइबा हिना। <verse eid="JHN 21:23" /><verse number="24" style="v" sid="JHN 21:24" />धि हति लोब्टु राङ ना सुइ धि तामबे भारेला साछि तेरिन, राङ धि तामबा टिदु, तेहि ङेला छ्या होतो कि ख्युइ साछि तेम्बा ना।<verse eid="JHN 21:24" /></para>
  <para style="s">सिनितुइना</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />येशुयि स्यान लाइ याङ लेइराङ क्याइसोङ। हतिबे नाङने च्यिच्यि क्याइरे ढीङान नाना, ङाला धि च्वरा लागि हुन्दु, कि ख्युइ टिटिबि किताब संसारला राङ मिस्युवा।<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>