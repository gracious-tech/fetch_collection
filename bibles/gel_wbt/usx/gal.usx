<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Fakai Translation</book>
  <para style="h">Garatiya-ne̱</para>
  <para style="toc3">Gara</para>
  <para style="toc2">Garatiya-ne̱</para>
  <para style="toc1">Ran-u Burus u̱ do̱'e̱ u̱du̱ Garatiya</para>
  <para style="mt2">Ran-u Burus u̱ do̱'e̱ u̱du̱</para>
  <para style="mt1">Garatiya-ne̱</para>
  <chapter number="1" style="c" sid="GAL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">1:1. </char>
    </note>Uno̱ ran-o̱ o̱o̱n du̱gu̱-du̱ Burus, Wa-to̱m-u̱ Ye̱so̱ Kiristi wu̱ o̱o̱ge̱ u̱zu̱ ne̱t-to̱ dage̱ wa da, ko̱ du̱gu̱-du̱ waku̱n ne̱t wa da. Se̱di Ye̱so̱ Kiristi wa dage̱ me̱ u̱ u-Ru̱ ne̱ u̱ U̱so, wu̱ yu̱nse̱ Ye̱so̱ du̱gu̱ m-mar. <verse eid="GAL 1:1"/><verse number="2" style="v" sid="GAL 1:2"/>A-doru̱ Ye̱so̱ ne̱ be̱e̱t i o̱o̱ge̱ u̱r-kot u̱ me̱ ne̱ to̱mo̱tto̱n uno̱ ran-o̱ u̱du̱ mo̱ro̱g-tu̱ a-dor-ne̱ tu̱ o̱o̱ge̱ u̱ dak-u̱ Garatiya:<verse eid="GAL 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3"/>U̱m no̱ng u̱s-to̱o̱g u̱zu̱ u-Ru̱ U̱so-u in u̱ Wa-ko-uyan Ye̱so̱ Kiristi ne̱ ya' no̱ u-nya u̱ ru̱s-du̱ jab ne̱. <verse eid="GAL 1:3"/><verse number="4" style="v" sid="GAL 1:4"/>Ye̱so̱ yaste̱ fat-u̱r wa sha-mu̱ to̱o̱g u̱ remu̱ ba'as-u̱t in remu̱ wa guut in du̱gu̱ dak-u yo̱-o̱ uno̱. Uno̱ no̱ng u̱ka cite̱ mu̱ Ru̱-u in u̱ U̱so ne̱. <verse eid="GAL 1:4"/><verse number="5" style="v" sid="GAL 1:5"/>Yage̱ inya m-sek u̱du̱ u-Ru̱ m-mo̱mmo̱! U̱ shu̱'u̱t iya.<verse eid="GAL 1:5"/></para>
  <para style="s1">Rem-su̱ m-Re̱me̱r <optbreak/> su̱ u̱t-nip</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6"/>U̱m no̱ng m-zap u̱zu̱ no̱ o̱ byu̱rru̱ u-dim m-ho̱r du̱gu̱-du̱ u-Ru̱, wu̱ dage̱ no̱ remu̱ nya-u Kiristi. No̱ o̱ do̱rru̱ se̱ke̱n fu̱n-se̱ su̱ o̱o̱ge̱ bam u̱ Rem-su̱ m-Re̱me̱r ne̱ su̱ u̱m no̱mu̱ no̱ bu̱t-tu̱ se̱. <verse eid="GAL 1:6"/><verse number="7" style="v" sid="GAL 1:7"/>Se̱di u̱t-nip a Rem-su̱ m-Re̱me̱r se̱ da. M-ha iya ne̱ to̱ku̱n ne̱t-to̱ o̱ro tu̱ o̱o̱ge̱ e̱ngu̱sse̱ no̱ tu̱msu̱ e̱ u̱t-sa e̱ bargu̱sse̱ Rem-su̱ m-Re̱me̱r su̱ mo̱t-u̱t Kiristi. <verse eid="GAL 1:7"/><verse number="8" style="v" sid="GAL 1:8"/>Se̱di ko̱ da u̱zu̱ it, ko̱ wa-to̱m u-Ru̱ wu̱ o̱o̱ge̱ du̱gu̱ do̱m u-ru̱ wa no̱mu̱ no̱ bu̱t-tu̱ Rem-su̱ m-Re̱me̱r su̱ o̱o̱ge̱ bam u̱ Rem-su̱ m-Re̱me̱r ne̱, su̱ it no̱mu̱ no̱ u̱t-bu̱t du̱gu̱ u̱r-taku̱n, yage̱ nu-u yo̱-o̱ u-Ru̱ he̱e̱n u̱-do̱m-u̱ hi-u̱r wa. <verse eid="GAL 1:8"/><verse number="9" style="v" sid="GAL 1:9"/>U̱ka it war-tu̱ no̱ u̱r-taku̱n, u̱ da-o̱ u̱m swu̱ru̱g m-waru̱ no̱: A waku̱n no̱mu̱ no̱ bu̱t-tu̱ Rem-su̱ m-Re̱me̱r su̱ o̱o̱ge̱ bam u̱ Rem-su̱ m-Re̱me̱r ne̱, su̱ no̱ o̱nke̱ du̱gu̱-du̱ it, u̱m ko̱nu̱g u̱zu̱ Ru̱-u̱ ya' go̱ ne̱t-u̱ wa u̱r-ko̱b sok.<verse eid="GAL 1:9"/></para>
  <para style="s1">Ru̱-o̱ fage̱ Burus shu̱'u̱te̱ <optbreak/> Wa-to̱m-u̱ Ye̱so̱</para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10"/>¿U̱m u̱t-sa u̱ da-o̱ u̱zu̱ ne̱t-tu̱ ho̱g zwar-u̱r ri, ko̱ u-Ru̱? ¿Ko̱ sha-mu̱ o̱ro u̱zu̱ ne̱t-to̱ u̱m u̱t-sa to̱ ho̱g re̱me̱r-m ri? A mu̱ne̱ u̱zu̱ u̱m o̱mo̱n u̱t-sa u̱ ne̱t-tu̱ ho̱g re̱me̱r-m ri, u̱m da shu̱'u̱te̱ to̱k-u̱ Kiristi da. <verse eid="GAL 1:10"/><verse number="11" style="v" sid="GAL 1:11"/>U̱ da-o̱ u̱m u̱t-sa no̱ nap o̱r-u̱t ri ne̱, u̱zu̱ Rem-su̱ m-Re̱me̱r su̱ u̱m no̱mu̱ no̱ a du̱gu̱-du̱ ne̱t de̱ se̱ rwu̱u̱ne̱ da. <verse eid="GAL 1:11"/><verse number="12" style="v" sid="GAL 1:12"/>U̱m kab-u̱g se̱ du̱gu̱-du̱ waku̱n ne̱t wa da, ko̱ waku̱n wa iise̱ me̱ da. Ye̱so̱ Kiristi wa hi-u̱r wa kwu̱re̱ se̱ rem-se̱ u̱du̱ ri.<verse eid="GAL 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13"/>Remu̱ no̱ ho̱k u̱ka u̱m o̱tte̱ u̱r-yu̱ da-u̱ u̱m o̱o̱ge̱ do̱rru̱ fu̱n-yu̱ Yahuda-ne̱. U̱m yaag a-doru̱ Ye̱so̱ i o̱o̱ge̱ ne̱t-tu̱ u-Ru̱ u̱r-ko̱b so̱k. U̱m no̱ng no̱mu̱ u̱m do̱'e̱ u̱t-ker u̱m ho̱ru̱sse̱ u̱n. <verse eid="GAL 1:13"/><verse number="14" style="v" sid="GAL 1:14"/>U̱m o̱o̱g u̱-shu̱ o̱r-u̱t ri ne̱ u-tát i o̱o̱ge̱ u̱s-hak u̱s-gan u̱ me̱ ne̱ u̱ do̱rru̱ fu̱n-yu̱ Yahuda-ne̱. Rem u̱zu̱ u̱m wa'ag jab sok u̱ do̱rru̱ kim-su̱ u̱so-tu̱ u̱so-u̱t ri ne̱. <verse eid="GAL 1:14"/><verse number="15" style="v" sid="GAL 1:15"/>Se̱di kanda na mat me̱, Ru̱-u dak me̱ tu̱msu̱ wa fu̱g me̱ remu̱ nya-u wa. Tu̱msu̱ Ru̱-u̱ hog u̱r-zwar, <verse eid="GAL 1:15"/><verse number="16" style="v" sid="GAL 1:16"/>u̱zu̱ wa ko̱se̱ Wa'-u̱ wa u̱du̱ ri rem u̱m no̱m-u̱t bu̱t-tu̱ Rem-su̱ m-Re̱me̱r su̱ mo̱t-u̱t wa u̱-me̱ a-za Yahuda-ne̱. Da-u̱ no̱m-u̱t to̱ no̱me̱ u̱m shu̱k-u̱t waku̱n ne̱t wa mo̱ttu̱ no̱m-u̱ to̱ o̱o̱ge̱ u̱t-zu̱ u̱t-be̱e̱t ko̱ no̱m-u̱ u̱m do̱'e̱ u̱t-no̱m da. <verse eid="GAL 1:16"/><verse number="17" style="v" sid="GAL 1:17"/>Tu̱msu̱ u̱m haag u̱ Urusharima re̱mu̱ u̱m shit a-to̱mu̱ Ye̱so̱ i ba'e̱ me̱ m-haan da. Se̱di u̱m aru̱k m-ha dak-u̱ Arabiya tu̱msu̱ da tase̱ u̱m mu̱u̱n u̱-me̱ bo̱-u̱ Dimaku.<verse eid="GAL 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 1:18"/>Se̱ da-u̱ hak-su̱ u̱s-tu̱t arke̱ u̱m aru̱k m-ha Urusharima rem u̱m nu̱pu̱t Biturus, tu̱msu̱ u̱m shu̱'u̱t u̱ wa ne̱ m-roog o̱p u̱t-tan. <verse eid="GAL 1:18"/><verse number="19" style="v" sid="GAL 1:19"/>Se̱di u̱m hyanu̱g waku̱n u̱ te̱k-u̱ a-to̱mu̱ Ye̱so̱ u̱ da-u o̱ da se̱di Yakubu hu̱u̱b u̱r-matu̱ Wa-ko-uyan. <verse eid="GAL 1:19"/><verse number="20" style="v" sid="GAL 1:20"/>U̱m o̱ warru̱ no̱ u̱t-nip u̱-shu̱ u-Ru̱, no̱m-u̱ u̱m o̱o̱ge̱ panu̱ no̱ a bi-se̱ da. <verse eid="GAL 1:20"/><verse number="21" style="v" sid="GAL 1:21"/>Da tase̱ u̱m aru̱k m-ha gas-su̱ Suriya u̱ Kirikiya ne̱. <verse eid="GAL 1:21"/><verse number="22" style="v" sid="GAL 1:22"/>Se̱di a-doru̱ Ye̱so̱ ne̱ i o̱o̱ge̱ gas-u̱ Yahudiya e̱ tamu̱g hyan-du̱ me̱ u̱r-is u̱ u̱r-is ne̱ da. <verse eid="GAL 1:22"/><verse number="23" style="v" sid="GAL 1:23"/>E̱ ho̱k kyak u̱ mo̱t-u̱t ri ne̱ u̱zu̱: &lt;&lt;Burus, wu̱ o̱o̱ge̱ da-u o̱ m-ya in u̱r-ko̱b wa o̱o̱ge̱ da-o̱ u̱ bu̱t-tu̱ Rem-su̱ m-Re̱me̱r su̱ yadu̱ jab su̱ wa o̱o̱ge̱ u̱t-sa wa ho̱ru̱sse̱.&gt;&gt; <verse eid="GAL 1:23"/><verse number="24" style="v" sid="GAL 1:24"/>Tu̱msu̱ e̱ no̱nge̱ u-Ru̱ u̱t-vam u̱ remu̱ ri.<verse eid="GAL 1:24"/></para>
  <chapter eid="GAL 1"/>
  <chapter number="2" style="c" sid="GAL 2"/>
  <para style="s1">A-to̱mu̱ Ye̱so̱ kabu̱g Burus</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1"/>Se̱di da-u̱ hak-su̱ o̱p u̱s-nas arke̱, u̱m sur m-ha Urusharima, uno̱ da-o̱ u̱ Baraba ne̱. U̱m ku̱b Titus tu̱msu̱. <verse eid="GAL 2:1"/><verse number="2" style="v" sid="GAL 2:2"/>U̱m haag u̱ ku̱n re̱mu̱ zu̱ Ru̱-u̱ ko̱sku̱ me̱ u-hyan u̱zu̱ u̱m do̱'e̱. Da-u̱ u̱m o̱o̱ge̱ ku̱n u̱m shu̱'u̱te̱ m-yasa u̱ tu̱-shu̱ a-doru̱ Ye̱so̱ ne̱, tu̱msu̱ u̱m yu̱' e̱ zu̱n-mu̱ Rem-su̱ m-Re̱me̱r su̱ u̱m o̱o̱ge̱ bu̱t-tu̱ se̱ u̱ te̱k-u̱ i za-yahuda-ne̱. U̱m o̱o̱g u̱m cwang u̱zu̱ hi-u̱t it u̱ u̱n ne̱ o̱ u̱r-be u̱r-gan, remu̱ u-gye̱r u̱ shu̱'u̱t u̱zu̱ ank-m ri u̱ da-u̱ ar-ke̱ u̱ uno̱ da-o̱ ne̱ o̱o̱g m-zan da. <verse eid="GAL 2:2"/><verse number="3" style="v" sid="GAL 2:3"/>Se̱di Titus wu̱ o̱o̱ge̱ u̱r-kot u̱ me̱ ne̱, ko̱ ba shu̱'u̱te̱ u̱zu̱ wa ne̱t-u̱ wa-za-Yahuda wa, tu̱-shu̱ wa'ag wa no̱m u̱r-pe̱s za wa cwan da. <verse eid="GAL 2:3"/><verse number="4" style="v" sid="GAL 2:4"/>Sin-se̱ rem-se̱ yu̱ngu̱n remu̱ u̱zu̱ to̱ko̱n ne̱t-to̱ tu̱ o̱o̱ge̱ u̱s-bi u̱zu̱ a-dor-ne̱ e̱ o̱o̱ge̱, e̱ cwagu̱n m-yasa rem e̱ got u̱ku̱r u̱ in kume̱ u̱ same̱-du̱ u̱t-hi in u̱ Kiristi Ye̱so̱ ne̱. E̱ u̱t-sa e̱ muut in to̱k-ne̱ u̱du̱ no̱m-du̱ no̱m-u̱ bo̱r-tu̱ Yahuda-ne̱ zu̱ye̱. <verse eid="GAL 2:4"/><verse number="5" style="v" sid="GAL 2:5"/>Se̱di it yaag u̱n u̱r-ke̱r da ko̱ u-da cashi, remu̱ Rem-su̱ m-Re̱me̱r su̱ u̱t-nip se̱ shu̱'u̱t u̱ remu̱ swu̱r-m no̱.<verse eid="GAL 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6"/>Tu̱msu̱ i o̱o̱ge̱ tu̱-shu̱ a-doru̱ Ye̱so̱ e̱ swu̱ru̱g o̱ko̱n u̱-me̱ rem-u̱s ri da. (Shu̱u̱t-u̱r u̱n tu̱-shu̱ zatte̱ mo̱ko̱n swas-mo̱ u̱du̱ ri da, remu̱ zu̱ Ru̱-u̱ ko̱ste̱ m-ku̱u̱k da.) <verse eid="GAL 2:6"/><verse number="7" style="v" sid="GAL 2:7"/>O̱o̱g ba tu̱-shu̱ sur o̱kon u̱ rem-u̱s ri, e̱ nu̱p u̱zu̱ Ru̱-u̱ yaag me̱ ank-mu̱ bu̱t-tu̱ Rem-su̱ m-Re̱me̱r u̱du̱ a-za Yahuda-ne̱, tu̱msu̱ wa yu̱' Biturus ank-mu̱ bu̱t-tu̱ gandi rem-u̱s se̱ u̱du̱ Yahuda-ne̱. <note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">Girik i za-Yahuda-ne̱ e̱ na zu̱ a-za u̱r-pe̱s-ne̱, Yahuda-ne̱ e̱ na zu̱ a-u̱r-pe̱s-ne̱.</char></note> <verse eid="GAL 2:7"/><verse number="8" style="v" sid="GAL 2:8"/>Remu̱ gandi Ru̱-u̱ wa'e̱ Biturus shu̱'u̱t Wa-to̱m-u̱ Ye̱so̱ remu̱ ank-mu̱ u̱t-bu̱t u̱du̱ Yahuda-ne̱<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">Girik zu̱, &lt;&lt;u̱r-pe̱s.&gt;&gt; </char></note>, tu̱msu̱ wa wa'e̱ u̱m shu̱'u̱t Wa-to̱m-u̱ Ye̱so̱ u̱du̱ i za-yahuda-ne̱. <verse eid="GAL 2:8"/><verse number="9" style="v" sid="GAL 2:9"/>Da-u̱ Yakubu, u̱ Biturus u̱ Yohanna ne̱, i o̱o̱ge̱ tu̱-shu̱ a-doru̱ Ye̱so̱ ne̱, e̱ nu̱p u̱zu̱ Ru̱-u̱ yaag me̱ uno̱ nya-o̱. E̱ so u̱t-kom u̱ Baraba ne̱ u̱ me̱ ne̱. E̱ ees u̱zu̱ it de'e̱ u̱ it no̱m m-ank u̱du̱ i za-yahuda-ne̱, tu̱msu̱ e̱ no̱m m-ank u̱-me̱ Yahuda-ne̱. <verse eid="GAL 2:9"/><verse number="10" style="v" sid="GAL 2:10"/>No̱m-u̱ u̱n ko̱ne̱ it u̱ war-o̱ u̱zu̱ it re̱ u-shu̱ u̱ gwat-du̱ I o̱o̱ge̱ u̱r-ko̱b, no̱m-u̱ u̱m o̱o̱ge̱ u̱ssa u̱zu̱ u̱m no̱mo̱g u-da u-be̱e̱t.<verse eid="GAL 2:10"/></para>
  <para style="s1">Burus hagu̱sse̱ Biturus</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11"/>Se̱di da-u̱ Biturus<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fq" closed="false">Biturus </char><char style="ft" closed="false">Biturus u̱t-Girik na zu̱ wa Kefas.</char></note> haane̱ bo̱-u̱ Antakiya, u̱m baste̱ wu̱n u̱-shu̱ a-dor-ne̱, remu̱ u̱zu̱ no̱m-u wa o̱o̱g u̱t-no̱m o̱ za ho̱n-ho̱n da. <verse eid="GAL 2:11"/><verse number="12" style="v" sid="GAL 2:12"/>Remu̱ da-u̱ wa teene̱ u̱r-taku̱n, wa o̱o̱g m-re̱ no̱m u̱t-re̱ u̱ i za-Yahuda-ne̱. Se̱di a tase̱, da-u̱ to̱ko̱n ne̱t-to̱ haan du̱gu̱-du̱ Yakubu, wa he̱e̱se̱ mu̱u̱du̱ u-dim tu̱msu̱ wa mot hi-u̱r wa du̱gu̱-du̱ u̱n. Wa o̱ gye̱r-u̱ Yahuda-ne̱ i zu̱ye̱ se̱ na no̱ngu̱ i za-yahuda-ne̱ da u̱r-pe̱s. <verse eid="GAL 2:12"/><verse number="13" style="v" sid="GAL 2:13"/>Tu̱msu̱ Yahuda-ne̱ u-tát e̱ same̱ u̱t-hi u̱ ha-mu̱ u̱r-no̱ wu̱n ne̱, ko̱ Baraba hi-u̱r wa u̱n e̱ngu̱sse̱ wa tu̱msu̱ wa dor u̱n u̱ ha-mu̱ u̱r-no̱ u̱n ne̱.<verse eid="GAL 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 2:14"/>Da-u̱ u̱m hyane̱ u̱n yakke̱ do̱rru̱ fu̱n-yu̱ u̱t-nip yu̱ Rem-su̱ m-Re̱me̱r, u̱m zu̱ Biturus u-shu̱ ko̱wan, &lt;&lt;Bo̱ ne̱t-u̱ Yahuda wa, m-ha iya ne̱ bo̱ zaar do̱rru̱ bo̱r-tu̱ Mosa yasu̱ Yahuda-ne̱ da. ¿Re̱-o̱ no̱m-te̱ u̱ da-o̱ bo̱ o̱tte̱ wadu̱ a-za Yahuda-ne̱ e̱ dor bo̱r-tu̱ Yahuda-ne̱?&gt;&gt;<verse eid="GAL 2:14"/></para>
  <para style="s1">Ru̱-u̱ gwu̱u̱g Yahuda-ne̱ u̱ a-za Yahuda-ne̱</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15"/>Burus re shu̱ u̱t-zu̱ ne̱, &lt;&lt;In Yahuda-ne̱ e̱ u̱du̱ u̱r-mat, za &lt;a-za Yahuda-ne̱ i na foge̱ a-u̱t-ba'as-ne̱ da.&gt;<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">Remu̱ u̱zu̱ Yahuda-ne̱ o̱tte̱ bo̱r-u Mosa tu̱msu̱ e̱ no̱m u̱r-pe̱s e̱ ku̱b hi-u̱r e̱ a jab-u̱ so̱-o̱ ne̱. A-za Yahuda-ne̱ e̱ zatte̱ u̱t-bo̱r da nom-u̱t u̱r-pe̱s da, Yahuda-ne̱ ku̱b e̱ u̱ka a-u̱t-ba'as-ne̱.</char></note> <verse eid="GAL 2:15"/><verse number="16" style="v" sid="GAL 2:16"/>Se̱di in nak u̱zu̱ waku̱n zaar u̱t-shu̱u̱t ho̱n-ho̱n u̱du̱ do̱rru̱ bo̱r-tu̱ Ru̱-u̱ yase̱ Mosa da, se̱di u̱du̱ yadu̱ jab u̱du̱ Ye̱so̱ Kiristi. Tu̱msu̱ in Yahuda-ne̱ i ya'e̱ jab u̱-me̱ Kiristi Ye̱so̱, remu̱ in shu̱'u̱te̱ za u̱t-ba'as u̱du̱ u-Ru̱ u̱ yadu̱ jab ne̱ u̱-me̱ Kiristi, tu̱msu̱ za u̱du̱ do̱rru̱ bo̱r-tu̱ Ru̱-u̱ yase̱ Mosa da. Remu̱ waku̱n zaar u̱t-shu̱u̱t za u̱t-ba'as u̱du̱ do̱rru̱ bo̱r-tu̱ Mosa yasu̱ Yahuda-ne̱ da.<verse eid="GAL 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17"/>&lt;&lt;Se̱di a mu̱ne̱ zu̱ da-u̱ in u̱t-sa in shu̱'u̱t ho̱n-ho̱n u̱du̱ u-Ru̱ u̱-me̱ Kiristi, in bit hi-u̱r in u̱t-ba'as ne̱ sha-mu̱ a-za Yahuda-ne̱, ¿u̱t-shu̱'u̱t u̱zu̱ Kiristi yaag in shiriktin-mu̱ u̱t-ba'as? A-a! Iya-o̱ da! <verse eid="GAL 2:17"/><verse number="18" style="v" sid="GAL 2:18"/>No̱m-u̱ u̱m u̱t-war o̱ u̱zu̱, a-mu̱u̱ne̱ u̱zu̱ u̱m byu̱ru̱g u-dim u̱ do̱rru̱ u̱t-bo̱r remu̱ u̱m shu̱'u̱te̱ ho̱n-ho̱n u̱du̱ u-Ru̱, shu̱'u̱te̱ u̱ka u̱m swu̱ru̱g m-ma ma-u̱ u̱m duuse̱ u̱r-taku̱n. <verse eid="GAL 2:18"/><verse number="19" style="v" sid="GAL 2:19"/>Re̱mu̱ bo̱r-tu̱ ko̱ske̱ me̱ u̱zu̱ u̱m o̱ u̱ka ne̱t-u̱ mare̱ u̱du̱ u̱t-bo̱r, rem iya u̱m o̱ u̱r-yu̱ re̱mu u-Ru̱, shu̱'u̱te̱ u̱ka zu̱ na taru̱g me̱ u-do̱m u-kan u̱r-ko̱t u̱ Ye̱so̱ Kiristi ne̱ u̱-do̱m u-kan. <verse eid="GAL 2:19"/><verse number="20" style="v" sid="GAL 2:20"/>Remu̱ da-o̱, u̱m zamu̱n u̱r-yu̱ da, se̱di Kiristi wa o̱o̱ge̱ u̱r-yu̱ u-me̱ ri. Tu̱msu̱ u̱ka u̱m o̱tte̱ u̱r-yu̱ u̱ uno̱ war-u̱ u-dak o̱, u̱m o̱ yu̱-du̱ fat-u̱r ri u̱du̱ yadu̱ jab u̱du̱ Wa' u-Ru̱, wu̱ cwane̱ me̱ tu̱msu̱ wa yase̱ hi-u̱r wa remu̱ ri. <verse eid="GAL 2:20"/><verse number="21" style="v" sid="GAL 2:21"/>U̱m muute̱ nya u-Ru̱ m-zan da. Remu̱ a-mu̱u̱ne̱ u̱zu̱ do̱rru̱ bo̱r-tu̱ Ru̱-u̱ yase̱ Mosa in shu̱'u̱t za u̱t-ba'as u̱du̱ u-Ru̱, shu̱'u̱te̱ u̱zu̱ Kiristi maru̱g m-zan!&gt;&gt;<verse eid="GAL 2:21"/></para>
  <chapter eid="GAL 2"/>
  <chapter number="3" style="c" sid="GAL 3"/>
  <para style="s1">Yadu̱ jab ko̱ do̱rru̱ bo̱r-u Mosa</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1"/>No̱ ragne̱ Garatiya-ne̱! ¿Wana e̱ngu̱sse̱ jab-u̱s no̱? Remu̱ u̱m wargu̱ no̱ m-zu̱n mo̱ttu̱ mar-m Ye̱so̱ Kiristi u̱-do̱m u-kan. <verse eid="GAL 3:1"/><verse number="2" style="v" sid="GAL 3:2"/>Waru̱n me̱ u-no̱m u-gan: Ko̱ no̱ o̱nkte̱ Yar u-He̱n remu̱ do̱rru̱ u̱t-bo̱r tu̱ Yahuda-ne̱, ¿ko̱ remu̱ ya-du̱ jab u̱-me̱ rem-su̱ no̱ ho̱ge̱ u̱ mo̱t-u̱t Ye̱so̱ Kiristi ne̱? <verse eid="GAL 3:2"/><verse number="3" style="v" sid="GAL 3:3"/>¿Yan o̱ wu̱te̱ no̱ o̱tte̱ m-rag ne̱ u-tát? Ba no̱ tak-ne̱ u̱ Yar u-He̱n, ¿yan-o̱ wu̱te̱ no̱ otte̱ u̱t-sa no̱ vaste̱ ank-mu̱ u-Ru̱ u̱ be̱b-du̱ u-war? <verse eid="GAL 3:3"/><verse number="4" style="v" sid="GAL 3:4"/>¿Ko̱b-du̱ no̱ swaye̱ u-tát du̱ m-zan de̱? Za u-sakna o̱ da shu̱'u̱t o̱ku̱n no̱mo̱! <verse eid="GAL 3:4"/><verse number="5" style="v" sid="GAL 3:5"/>¿U̱m o̱ shu̱t-du̱ no̱ tu̱msu̱, u̱t-shu̱'u̱t u̱zu̱ Ru̱-u̱ yaag no̱ Yar u-He̱n u̱ ank-mu̱ no̱m-tu̱ m-shin u̱ te̱k-u̱ no̱ remu̱ zu̱ no̱ do̱ro̱g u̱t-bo̱r? Iya-o̱ da! Wa yaag no̱ remu̱ u̱zu̱ no̱ yaag jab-u̱ re̱m-su̱ no̱ ho̱ge̱ u̱ mo̱t-u̱t Kiristi ne̱.<verse eid="GAL 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6"/>Gwat Ibrahi: &lt;&lt;Wa yaag jab u̱du̱ u-Ru̱ tu̱msu̱ Ru̱-u̱ og wu̱n ne̱t ho̱n-ho̱n.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="GEN 15:6">Taku̱ 15:6</ref>; <ref loc="ROM 4:3">Roma 4:3</ref></char>.</note> <verse eid="GAL 3:6"/><verse number="7" style="v" sid="GAL 3:7"/>No̱ nap u̱zu̱, ya'ag-u̱ Ibrahi i u̱t-nip e̱ o̱o̱ge̱ i ya'e̱ jab u̱du̱ u-Ru̱. <verse eid="GAL 3:7"/><verse number="8" style="v" sid="GAL 3:8"/>Tu̱msu̱ remu̱ Ran-u̱ u-Ru̱, Ru̱-u̱ zu̱u̱g Ibrahi da-u̱ dim u̱zu̱, a-za Yahuda-ne̱ do̱'e̱ u̱t-shu̱'u̱t ho̱n-ho̱n u̱du̱ u-Ru̱ remu̱ yadu̱ jab-u̱ e̱ u̱du̱ wa. Ru̱-u̱ zu̱ Ibrahi: &lt;&lt;Ne̱t-tu̱ u̱t-dak u̱t-be̱e̱t e̱ do̱'e̱ kwu̱m-du̱ nu-u so̱-o̱ du̱gu̱-du̱ ró.&gt;&gt; <verse eid="GAL 3:8"/><verse number="9" style="v" sid="GAL 3:9"/>Remu̱ iya, i wa'e̱ yadu̱ jab-u̱s e̱ u̱du̱ Kiristi e̱ kwu̱mu̱g gandi nu-u so̱-o̱ u̱ Ibrahi o̱nke̱ remu̱ yadu̱ jab-u̱ wa.<verse eid="GAL 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10"/>Ko̱wana wu̱ to̱ste̱ u̱du̱ do̱rru̱ u̱t-bo̱r u̱ remu̱ wa muute̱ hi-u̱r wa ho̱n-ho̱n u̱du̱ u-Ru̱ wa o̱ u̱r-yu̱ u̱-me̱ nu-u yo̱-o̱. Remu̱ zu̱ o̱ m-pan u̱-me̱ Ran-u̱ u-Ru̱: &lt;&lt;Ko̱wana wu̱ gu̱gme̱ re̱-du̱ u-shu̱ u̱ no̱m-du̱ ko-uyan u̱ o̱o̱ge̱ m-pan u̱-me̱ ran u-bo̱r wa o̱ u̱ nu-u yo̱-o̱ ne̱!&gt;&gt; <verse eid="GAL 3:10"/><verse number="11" style="v" sid="GAL 3:11"/>O̱ m-zu̱n u̱zu̱ waku̱n zaar u̱t-shu̱'u̱t ho̱n-ho̱n u̱du̱ u-Ru̱ remu̱ do̱rru̱ u̱t-bo̱r da. U̱m zu̱u̱g inya remu̱ o̱ m-pan u̱-me̱ Ran-u̱ u-Ru̱: &lt;&lt;Se̱ remu̱ yadu̱ jab ne̱t o̱ ho̱n-ho̱n de̱te̱ u̱r-fat.&gt;&gt; <verse eid="GAL 3:11"/><verse number="12" style="v" sid="GAL 3:12"/>Inya fu̱n-yu̱ yadu̱ jab ya zaar u̱s-gan u̱ fu̱n-yu̱ u̱t-bo̱r ne̱ da, yu̱ zu̱ye̱, &lt;&lt;Se̱ u̱du̱ do̱rru̱ u̱t-bo̱r de̱ ne̱t do̱te̱ kwu̱m-du̱ u̱r-fat.&gt;&gt; <verse eid="GAL 3:12"/><verse number="13" style="v" sid="GAL 3:13"/>Se̱di Kiristi gwu̱u̱g in du̱gu̱ nu-u yo̱-o̱ u̱ u-bo̱r du̱ wa shu̱'u̱te̱ nu-u yo̱-o̱ remu̱ in. Rem u̱zu̱ o̱ m-pan u̱-me̱ Ran-u̱ u-Ru̱: &lt;&lt;Nu-u yo̱-o̱ u̱du̱ ko̱wana na tare̱ do̱m u-te.&gt;&gt; <verse eid="GAL 3:13"/><verse number="14" style="v" sid="GAL 3:14"/>Wa gwu̱u̱g in remu̱ nu-u so̱-o̱ u̱ Ru̱-u̱ ya'e̱ Ibrahi o̱ u̱t-haan u̱du̱ a-za Yahuda-ne̱ remu̱ Kiristi Ye̱so̱. Na no̱ng iya remu̱ in o̱nkte̱ este̱du̱ u̱s-rem du̱ Yar u-Ru̱ remu̱ yadu̱ jab.<verse eid="GAL 3:14"/></para>
  <para style="s1">U-bo̱r yu̱ o̱ bam u̱ <optbreak/> este̱du̱ u̱s-rem ne̱</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15"/>O̱r-u̱t ri a-dor-ne̱ yage̱ u̱m ya' no̱ sha-mu̱ ko̱du̱he̱ ho̱-de̱. Da-u̱ ne̱t-ne̱ yu̱r wa'e̱ u-kom u-ran e̱ cin u̱s-rem, waku̱n zaar wu̱ do̱'e̱ has-tu̱ se̱ ko̱ wa sur o̱ku̱n da. Iya o̱tte̱ u̱ sin-se̱ rem-se̱. <verse eid="GAL 3:15"/><verse number="16" style="v" sid="GAL 3:16"/>Ru̱-u̱ yaste̱ este̱du̱ u̱s-rem wa u̱du̱ Ibrahi tu̱msu̱ u̱du̱ wa'-u̱ wa ne̱. Napu̱n u̱zu̱ Ran-u̱ zu̱u̱g da &lt;&lt;U̱du̱ ya'ag-u̱ ró&gt;&gt; U̱ka na zu̱ ko̱-u̱t wa. Se̱di, o̱ zu̱u̱g &lt;&lt;U̱du̱ wa'-u̱ ró,&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="GEN 12:7">Taku̱ 12:7</ref>; <ref loc="GEN 13:15">13:15</ref>; <ref loc="GEN 17:7">17:7</ref>; <ref loc="GEN 24:7">24:7</ref></char>.</note> no̱mu̱ o̱ o̱o̱ge̱ u̱t-war ne̱t gan, u̱du̱ Kiristi. <verse eid="GAL 3:16"/><verse number="17" style="v" sid="GAL 3:17"/>No̱m u̱m o̱o̱ge̱ u̱t-zu̱ ya: Bo̱r-u̱t Mosa, tu̱ haane̱ u̱s-hak u̱t-ko̱k u̱t-nas u̱ hak-su̱ u̱r-shik u̱s-o̱p ba wa no̱me̱ Ibrahi este̱du̱ u̱s-rem, to̱ haste̱ este̱du̱ u̱s-rem su̱ Ru̱-u̱ no̱me̱ m-tumb ne̱ da, remu̱ zu̱ Ru̱-u̱ haste̱ este̱du̱ u̱s-rem wa da. <verse eid="GAL 3:17"/><verse number="18" style="v" sid="GAL 3:18"/>Remu̱ a mu̱ne̱ u̱zu̱ na o̱nk-u̱ o̱g-du̱ u̱r-mat u̱du̱ do̱rru̱ bo̱r-u Mosa, se̱ zaar u̱t-shu̱'u̱t u̱zu̱ u̱ remu̱ este̱du̱ u̱s-rem da. Se̱di Ru̱-u̱ yaste̱ este̱du̱ u̱s-rem u̱ka nya-u̱ m-ho̱s u̱du̱ Ibrahi.<verse eid="GAL 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19"/>¿Rem-u yan-o̱ Ru̱-u̱ ya'aste̱ bo̱r-u̱t Mosa? Wa ya'aste̱ u̱t-bo̱r u̱ remu̱ to̱ ko̱ste̱ u̱t-ne̱t ba'as-u̱t e̱. Se̱di Ru̱-u̱ cu̱nu̱g u̱zu̱ u̱ bo̱r-tu̱ tumb u̱ war-to̱ m-te haan-du̱ wa' wu̱ Ru̱-u̱ nomte̱ este̱du̱ u̱s-rem u̱ mo̱t-u̱t wa. Ru̱-u̱ ya'aste̱ bo̱r-u̱t wa u̱du̱ a-to̱m u-Ru̱ m-ha u̱du̱ Mosa, wu̱ eese̱ te̱k-u̱ u-Ru̱ u̱t-ne̱t ne̱. <verse eid="GAL 3:19"/><verse number="20" style="v" sid="GAL 3:20"/>U̱ da-o̱ wa-u̱r-ees u̱-te̱k o̱tte̱ u̱r-se̱ge̱ a-mu̱u̱ne̱ zu̱ m-zu̱u̱g kir-du̱ u̱t-ne̱t u̱r-gan u̱t-sa e̱ egu̱sse̱ u̱s-rem. Se̱di u-Ru̱, wu̱ o̱o̱ge̱ u-gan, wa no̱ng m-ank u̱ wa-u̱r-ees u̱-te̱k da-u̱ wa yase̱ este̱du̱ u̱s-rem u̱du̱ Ibrahi da.<verse eid="GAL 3:20"/></para>
  <para style="s1">No̱m-u̱ wu̱te̱ Ru̱-u̱ <optbreak/> ya'aste̱ u̱t-bo̱r</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21"/>¿Shu̱'u̱te̱ u̱zu̱ bo̱r-tu̱ gu̱gu̱mte̱ este̱du̱ u̱s-rem su̱ Ru̱-u̱ no̱me̱? A'a, iya-o̱ da! Remu̱ a mu̱ne̱ u̱zu̱ bo̱r-u̱t Mosa tu̱ na yaase̱ to̱ keru̱ yadu̱ u̱r-fat, shu̱'u̱t du̱ ho̱n-ho̱n za haagu̱n du̱gu̱-du̱ u-bo̱r. <verse eid="GAL 3:21"/><verse number="22" style="v" sid="GAL 3:22"/>Se̱di Ran-u̱ u-Ru̱ o̱ u̱t-war u̱zu̱ ba'as-to̱ do̱r-tu̱ u-dak u-be̱e̱t. Remu̱ iya Ru̱-u̱ yu̱ este̱du̱ u̱s-rem su̱ u̱ku̱r u̱du̱ i ya'e̱ jab-u̱ e̱ u̱du̱ Ye̱so̱ Kiristi.<verse eid="GAL 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23"/>Kanda din-de̱ yadu̱ jab haan, in o̱o̱g u̱ me̱n-tu̱ u̱r-tage̱ u̱du̱ do̱rru̱ u-bo̱r. In o̱o̱g u̱r-tage̱ kanda na upse̱ in yadu̱ jab. <verse eid="GAL 3:23"/><verse number="24" style="v" sid="GAL 3:24"/>Remu̱ bo̱r-u̱t o̱o̱g u̱ dor-tu̱ u-dak u-be̱e̱t kanda Kiristi haan. No̱mu̱ wu̱te̱ wa haatu̱n remu̱ na muute̱ in ho̱n-ho̱n u̱du̱ u-Ru̱ remu̱ yadu̱ jab. <verse eid="GAL 3:24"/><verse number="25" style="v" sid="GAL 3:25"/>Se̱di da-o̱ yadu̱ jab haagu̱n, bo̱r-u̱t zamu̱n u̱ dor-tu̱ in da.<verse eid="GAL 3:25"/></para>
  <para style="s1">Yaag-u̱ u-Ru̱ remu̱ <optbreak/> yadu̱ jab</para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26"/>Remu̱ u̱du̱ same̱-du̱ u̱t-hi no̱ u̱ Kiristi Ye̱so̱ ne̱ ya'ag u-Ru̱ no̱ o̱o̱ge̱ be̱e̱t remu̱ yadu̱ jab. <verse eid="GAL 3:26"/><verse number="27" style="v" sid="GAL 3:27"/>Tu̱msu̱ ne̱t-ne̱ be̱e̱t i same̱ u̱t-hi u̱ Kiristi ne̱ u̱-me̱ u̱t-yu̱bu̱sse̱ m-bu̱ e̱ wa'ag Kiristi u̱ka na wu̱te̱ kus-u̱t po-to̱. <verse eid="GAL 3:27"/><verse number="28" style="v" sid="GAL 3:28"/>Remu̱ i o̱o̱ge̱ same̱-du̱ u̱t-hi u̱ Kiristi ne̱ mo̱ttu̱ Yahuda-ne̱ ko̱ a-za Yahuda-ne̱, to̱k ko̱ za m-to̱k, campa ko̱ ne̱ta to̱ zamu̱n da. Remu̱ no̱ be̱e̱t no̱ shu̱'u̱te̱ u̱s-gan u̱-me̱ Kiristi Ye̱so̱. <verse eid="GAL 3:28"/><verse number="29" style="v" sid="GAL 3:29"/>Tu̱msu̱ a mu̱ne̱ no̱ ne̱t-u̱t Kiristi to̱, no̱ ko̱-u̱r Ibrahi de̱ no̱ o̱o̱ge̱. No̱ do̱'e̱ re̱-du̱ o̱g-du̱ u̱r-mat-u̱ wu̱n. Tu̱msu̱ este̱du̱ u̱s-rem su̱ u-Ru̱ u̱du̱ Ibrahi du̱ no̱ de̱.<verse eid="GAL 3:29"/></para>
  <chapter eid="GAL 3"/>
  <chapter number="4" style="c" sid="GAL 4"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1"/>U̱ da-o̱ no̱m-u̱ u̱m o̱o̱ge̱ u̱t-zu̱ ya: Abite̱ zu̱ wa re̱-du̱ o̱g-du̱ u̱r-mat o̱mo̱n wa'-u̱ re̱k-wa, wa o̱ u̱s-gan u̱ka to̱k, ko̱ u̱zu̱ wa o̱tte̱ ko̱-uyan u̱ u̱so wa o̱tte̱. <verse eid="GAL 4:1"/><verse number="2" style="v" sid="GAL 4:2"/>Tu̱msu̱ ne̱t-tu̱ o̱ro tu̱ gwat-du̱ wa, se̱ wa teeg da-u̱ u̱so wa cine̱. <verse eid="GAL 4:2"/><verse number="3" style="v" sid="GAL 4:3"/>Iya o̱ in o̱tte̱ kanda Kiristi haan. In o̱o̱g sha-mu̱ ya'ag-u̱ re̱k-e̱ in o̱ u̱-me̱ m-to̱k u̱ ta-u̱ yar-u̱t yo̱-to̱ tu̱ o̱o̱ge̱ u̱r-faru̱k du̱ uno̱ dak-o̱. <verse eid="GAL 4:3"/><verse number="4" style="v" sid="GAL 4:4"/>Se̱di da da-u̱ na cine̱ teene̱, Ru̱-u̱ to̱mo̱n Wa'-u̱ wa. Wu̱ ne̱ta mate̱ tu̱msu̱ wa dor bo̱r-tu̱ Ru̱-u̱ yase̱ Mosa. <verse eid="GAL 4:4"/><verse number="5" style="v" sid="GAL 4:5"/>Ru̱-u̱ to̱mo̱n wu̱n remu̱ wa guut ne̱t-u̱t to̱ tu̱ o̱o̱ge̱ do̱rru̱ bo̱r-u̱t Yahuda-ne̱ remu̱ in o̱nkte̱ o̱g-u̱r in du̱ shu̱yi-shu̱yi, u̱ka ya'ag-u̱ u-Ru̱. <verse eid="GAL 4:5"/><verse number="6" style="v" sid="GAL 4:6"/>Tu̱msu̱ rem u̱zu̱ no̱ ya'ag-u̱ wu̱n ne̱, Ru̱-u̱ to̱mo̱n Yar-u̱ Wa'-u̱ wa u̱-me̱ jab-u̱s in, Yar-u wa wu̱' in fog u-Ru̱, &lt;&lt;U̱so ri! U̱so ri!&gt;&gt; <verse eid="GAL 4:6"/><verse number="7" style="v" sid="GAL 4:7"/>Remu̱ iya, bo̱ zamu̱n to̱k da, se̱di wa'-u̱ u-Ru̱ bo̱ o̱o̱ge̱. Tu̱msu̱ remu̱ u̱zu̱ bo̱ o̱ wa'-u̱ wu̱n, wa wa'ag bo̱ re̱ o̱g-du̱ u̱r-mat-u̱ wa.<verse eid="GAL 4:7"/></para>
  <para style="s1">Burus e̱ku̱ste̱ <optbreak/> remu̱ Garatiya-ne̱</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8"/>U̱r-taku̱n, da-u̱ no̱ nape̱ u-Ru̱ da, no̱ o̱o̱g to̱k-ne̱ u̱du̱ ru̱-tu̱ za u̱r-fat. <verse eid="GAL 4:8"/><verse number="9" style="v" sid="GAL 4:9"/>Se̱di u̱ da-o̱ ba no̱ haane̱ u̱-me̱ same̱-du̱ u̱t-hi u̱ u-Ru̱ ne̱ ko̱ u̱m zu̱, Ru̱-u̱ haagu̱n u̱-me̱ same̱-du̱ u̱t-hi u̱ no̱ ne̱, ¿re̱-o̱ no̱ o̱tte̱ u̱t-sa no̱ sur m-mu̱ u-dim tu̱msu̱ no̱ shu̱'u̱t to̱k-ne̱ u̱du̱ yar-tu̱ za u̱r-be̱b tu̱msu̱ tu̱ m-zan tu̱msu̱ u̱du̱ yar-u̱t to̱ ne̱ tu̱ o̱o̱ge̱ u̱r-faru̱k u̱-me̱ uno̱ dak-o̱? <verse eid="GAL 4:9"/><verse number="10" style="v" sid="GAL 4:10"/>No̱ dor to̱ku̱n ho̱-to̱ sok u̱s-pyat ne̱ u̱ u-da ne̱ u̱ u̱s-hak ne̱ u̱ no̱ kum-u̱t hyu̱-m pus-mo̱ u̱du̱ u-Ru. <verse eid="GAL 4:10"/><verse number="11" style="v" sid="GAL 4:11"/>U̱m ho̱k u-gye̱r remu̱ no̱. Jiya pama-u̱s ri u̱ no̱ne̱ o̱o̱g m-zan.<verse eid="GAL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12"/>U̱m ko̱n-u̱g no̱ o̱r-u̱t ri ne̱, shu̱'u̱tu̱n sha-m ri u̱ka u̱m kumte̱ u̱t-pos du̱gu̱ to̱ no̱m-to̱, remu̱ u̱zu̱ u̱m shu̱'u̱te̱ sha-m no̱ a-za Yahuda-ne̱ i poste̱ du̱gu̱ bo̱r-u̱t to̱. No̱ no̱ngu̱ me̱ no̱m-tu̱ za ho̱n-ho̱n da. <verse eid="GAL 4:12"/><verse number="13" style="v" sid="GAL 4:13"/>No̱ baku̱s u̱zu̱ u̱r-taku̱n remu̱ ko̱b-du̱ m-yar de̱ u̱m no̱mtu̱ no̱ do̱nse̱-du̱ Rem-su̱ m-Re̱me̱r. <verse eid="GAL 4:13"/><verse number="14" style="v" sid="GAL 4:14"/>Tu̱msu̱ ko̱ ba shu̱'u̱te̱ ko̱b-du̱ m-yar ri shu̱'u̱te̱ m-reg u̱du̱ no̱, no̱ ju̱ru̱m me̱ ko̱ no̱ gu̱gu̱m me̱ da. No̱ o̱nkte̱ me̱ tu̱msu̱ no̱ ku̱b me̱ u̱ka u̱zu̱ u̱m o̱ wa-to̱m u-Ru̱, no̱ ku̱b me̱ u̱ka Kiristi Ye̱so̱ hi-u̱r wa. <verse eid="GAL 4:14"/><verse number="15" style="v" sid="GAL 4:15"/>¿Yan-o̱ kume̱ so̱-u̱r no̱ u̱r-be̱e̱t? U̱m nak u̱zu̱ abite̱ o̱o̱g u̱t-no̱me̱, no̱ za hoste̱ is-u̱t no̱ tu̱msu̱ no̱ yase̱ to̱ u̱du̱ ri. <verse eid="GAL 4:15"/><verse number="16" style="v" sid="GAL 4:16"/>¿U̱m shu̱'u̱te̱ hu̱u̱b-u̱ yo̱-o̱ no̱ u̱ da-o̱ remu̱ zu̱ u̱m o̱ waru̱ no̱ u̱t-nip? <verse eid="GAL 4:16"/><verse number="17" style="v" sid="GAL 4:17"/>To̱-to̱ ne̱t-to̱ e̱ku̱ste̱ to̱ ku̱bu̱s jab-u̱s no̱, se̱di no̱m-u̱ u̱n o̱o̱ge̱ zo̱ng-su̱ u̱t-no̱m o̱ zaar so̱-o̱ da. E̱ u̱t-sa e̱ hast no̱ du̱gu̱-du̱ ri remu̱ no̱ muute̱ jab-u̱s no̱ u̱du̱ u̱n. <verse eid="GAL 4:17"/><verse number="18" style="v" sid="GAL 4:18"/>Ko̱ re̱-o̱ nomte̱, o̱tte̱ u̱r-zwar waku̱n ya' jab-u̱ remu̱ no̱mu so̱-o̱, uda u-be̱e̱t, za da-u̱ u̱m o̱o̱ge̱ no̱ne̱ war-o̱ da. <verse eid="GAL 4:18"/><verse number="19" style="v" sid="GAL 4:19"/>Yaag-u̱ ri! U̱ka ne̱ta yu̱ o̱ u̱-me̱ re̱mu̱ me̱n-tu̱ u̱r-mat, iya-o̱ u̱m otte̱ u̱t-swu̱r m-ho̱g gandi go̱-du̱ re̱-mo̱ se̱ Kiristi shu̱u̱g u̱t-rogom u̱-me̱ jab-u̱s no̱. <verse eid="GAL 4:19"/><verse number="20" style="v" sid="GAL 4:20"/>U̱m cwang u̱m haan tu̱msu̱ u̱m shu̱'u̱t u̱r-kot u̱ no̱ ne̱ u̱ da-o̱ tu̱msu̱ u̱m swase̱ cwar-yu̱ u̱s-rem ri, rem u̱zu̱ u̱m e̱ku̱ste̱ mo̱t-u̱t no̱ ne̱.<verse eid="GAL 4:20"/></para>
  <para style="s1">Hajaratu u̱ Saratu</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21"/>Waru̱n me̱, no̱ i o̱o̱ge̱ u̱t-sa no̱ shu̱'u̱t u̱ ta-u̱ bo̱r-tu̱ Yahuda-ne̱, ¿no̱ nak no̱m-u̱ bo̱r-tu̱ zu̱ye̱? <verse eid="GAL 4:21"/><verse number="22" style="v" sid="GAL 4:22"/>Ran-u̱ u-Ru̱ o̱ u̱t-zu̱ Ibrahi o̱tte̱ ya'ag yu̱r. Wagan o̱o̱g du̱gu̱ to̱k-u̱ ne̱ta, tu̱msu̱ wagan o̱o̱g du̱gu̱-du̱ ne̱ta wu̱ zaare̱ me̱ m-to̱k da. <verse eid="GAL 4:22"/><verse number="23" style="v" sid="GAL 4:23"/>Se̱di wa'-u̱ o̱o̱ge̱ du̱gu̱-du̱ to̱k-u̱ ne̱ta na mak-u̱t wa u̱ka na vette̱; se̱di wu̱ na mate̱ du̱gu̱-du̱ ne̱ta wu̱ zaare̱ me̱ m-to̱k da wa o̱o̱g u̱ka shu̱-du̱ este̱du̱ u̱s-rem su̱ u-Ru̱ u̱du̱ Ibrahi. <verse eid="GAL 4:23"/><verse number="24" style="v" sid="GAL 4:24"/>Ne̱ta-u̱t tun-to̱ u̱t-yu̱r to̱ o̱ sha-mu̱ este̱du̱ u̱s-rem su̱ u-Ru̱ u̱s-yu̱r. Hajaratu, wa o̱ u̱ka Ro̱r-du̱ Sinai be-du̱ ne̱t-tu̱ o̱nkte̱ bo̱r-tu̱ Yahuda-ne̱, tu̱ mute̱ e̱ to̱k-ne̱. <verse eid="GAL 4:24"/><verse number="25" style="v" sid="GAL 4:25"/>U̱ da-o̱ Hajaratu o̱ ees-mu̱ Ro̱r-du̱ Sinai u̱-me̱ dak-u̱ Arabiya, tu̱msu̱ ees-mu̱ Urusharima u̱ ya-o̱. Remu̱ wa o̱ u̱-me̱ m-to̱k u̱du̱ u-bo̱r u̱r-kot u̱ yaag-u̱ wa ne̱. <verse eid="GAL 4:25"/><verse number="26" style="v" sid="GAL 4:26"/>Se̱di unwa jit ne̱ta wa, Saratu, wa o̱ ees-mu̱ Urusharima u̱ o̱o̱ge̱ u̱-do̱m u-ru̱. Wa zaar me̱ m-to̱k da tu̱msu̱ wa o̱ sha-mu̱ ino̱-u in. <verse eid="GAL 4:26"/><verse number="27" style="v" sid="GAL 4:27"/>Remu̱ zu̱ o̱ m-pan:</para>
  <para style="q1" vid="GAL 4:27">&lt;&lt;No̱m u̱r-so̱, ne̱ta za u̱r-mat,</para>
  <para style="q2" vid="GAL 4:27">wu̱ mate̱ ya'ag da.</para>
  <para style="q1" vid="GAL 4:27">No̱m u̱t-jar m-yat,</para>
  <para style="q2" vid="GAL 4:27">wu̱ tame̱ nap-du̱ re̱mu̱ u̱r-mat da.</para>
  <para style="q1" vid="GAL 4:27">Remu̱ u̱zu̱ ne̱ta wu̱ campa wa gu̱gme̱,</para>
  <para style="q2" vid="GAL 4:27">u̱ da-o̱ wa o̱tte̱ ya'ag,</para>
  <para style="q1" vid="GAL 4:27">m-ze̱g wu̱ o̱o̱ge̱ u̱r-yu̱ e̱ campa wa.<note caller="+" style="f"><char style="fr" closed="false">4:27 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 54:1">Isha 54:1</ref>.</char></note>&gt;&gt;<verse eid="GAL 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28"/>Tu̱msu̱ da-o̱ no̱ o̱r-u̱t ri ne̱, no̱ o̱ ya'ag i na mate̱ sha-mu̱ shu̱-du̱ este̱du̱ u̱s-rem su̱ u-Ru̱, u̱ka Ishaku. <verse eid="GAL 4:28"/><verse number="29" style="v" sid="GAL 4:29"/>Se̱di u̱ da-u o̱ wa' wu̱ na mate̱ u̱ka na vette̱ wa yu̱' wa'-u̱ na mate̱ u̱du̱ be̱b-du̱ u-yar u̱r-ko̱b. Gandi no̱m-u̱t to̱ o̱o̱ge̱ m-da u̱ da-o̱. <verse eid="GAL 4:29"/><verse number="30" style="v" sid="GAL 4:30"/>Se̱di ¿yan-o̱ Ran-u̱ u-Ru̱ zu̱ye̱ u̱ mo̱t-tu̱ iya ne̱? &lt;&lt;Buz to̱k-u̱ ne̱ta-u ya u̱ wa'-u̱ wa ne̱. Rem u̱zu̱ wa'-u̱ to̱k-u̱ ne̱ta wa zaar u̱ re̱-du̱ o̱g-du̱ u̱r-mat-u̱ wa'-u̱ ne̱ta wu̱ zaare̱ m-to̱k da.&gt;&gt; <verse eid="GAL 4:30"/><verse number="31" style="v" sid="GAL 4:31"/>Remu̱ iya o̱r-u̱t ri ne̱, in zaar ya'ag-u̱ to̱k-u̱ ne̱ta da, se̱di ya'ag-u̱ ne̱ta yu̱ zaare̱ me̱ m-to̱k da.<verse eid="GAL 4:31"/></para>
  <chapter eid="GAL 4"/>
  <chapter number="5" style="c" sid="GAL 5"/>
  <para style="s1">Kwu̱m-du̱ u-u̱ku̱r <optbreak/> u̱-me Kiristi</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1"/>Kiristi ruute̱ in remu̱ in shu̱'u̱te̱ i na ruute̱ u̱t-nip. Se̱ no̱ ees u̱r-be̱b ne̱ u̱-me̱ yadu̱ hi-u̱t no̱, tu̱msu̱ a no̱ shu̱'u̱t to̱k-ne̱ u̱du̱ do̱rru̱ bo̱r-u̱t Yahuda-ne̱ da.<verse eid="GAL 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2"/>E̱re̱n! Me̱, Burus, u̱m o̱ waru̱ no̱ iya: A no̱ to̱ste̱ jab-u̱s no̱ u̱du̱ no̱m-du̱ u̱r-pe̱s u̱ remu̱ no̱ shu̱'u̱te̱ ho̱n-ho̱n u̱du̱ u-Ru̱, se̱di shu̱'u̱te̱ u̱zu̱ no̱m-u̱ Kiristi no̱me̱ remu̱ no̱ zatte̱ mo̱ko̱n swu̱r-mo̱ u̱du̱ no̱ da. <verse eid="GAL 5:2"/><verse number="3" style="v" sid="GAL 5:3"/>Tu̱msu̱ u̱m do̱'e̱ u̱t-sur waru̱ no̱ ko̱wana yage̱ na no̱mu̱ wa u̱r-pe̱s, se̱ wa do̱ro̱g no̱mu̱ bo̱r-u̱t Yahuda-ne̱ zu̱ye̱ u̱t-be̱e̱t. <verse eid="GAL 5:3"/><verse number="4" style="v" sid="GAL 5:4"/>Tu̱msu̱ a no̱ o̱o̱ge̱ u̱t-sa no̱ no̱m ho̱n-ho̱n u̱-shu̱ u-Ru̱ u̱du̱ do̱rru̱ u-bo̱r, no̱ kupu̱ste̱ hi-u̱r no̱ du̱gu̱-du̱ same̱-du̱ u̱t-hi no̱ u̱ Kiristi ne̱. No̱ byu̱ru̱g shin-u̱t no̱ du̱gu̱-du̱ nya-u̱ u-Ru̱. <verse eid="GAL 5:4"/><verse number="5" style="v" sid="GAL 5:5"/>Se̱di u̱du̱ in, Yar-o̱ yu̱'e̱ in u̱r-be̱b in o̱ wadu̱ jab u̱-me̱ yadu̱ jab tu̱msu̱ u̱du̱ shu̱'u̱t-du̱ jab-u̱ so̱-o̱ u̱ u-Ru̱ no̱me̱ in este̱du̱ u̱s-rem. <verse eid="GAL 5:5"/><verse number="6" style="v" sid="GAL 5:6"/>Remu̱ da-u̱ in o̱o̱ge̱ same̱-du̱ u̱t-hi u̱ Kiristi Ye̱so̱, u̱r-pe̱s ko̱ ko̱b-du̱ u̱r-pe̱s zatte̱ mo̱ko̱n swu̱r-mo̱ da. No̱m-u̱ na o̱o̱ge̱ u̱t-gwat u̱ war-o̱ yadu̱ jab-u̱ o̱ ko̱se̱ hi-u̱r o̱ u̱du̱ u̱t-cwan.<verse eid="GAL 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7"/>No̱ o̱o̱g u̱ so̱m-mu̱ maga u̱ka ku̱mte̱, ¿wana kupse̱ no̱ u-fu̱n du̱gu̱ do̱rru̱ u̱t-nip? <verse eid="GAL 5:7"/><verse number="8" style="v" sid="GAL 5:8"/>U-Ru̱, wu̱ dage̱ no̱, a wa wa'e̱ no̱ nom-u̱t go̱-du̱ se̱ dorogse̱ da! <verse eid="GAL 5:8"/><verse number="9" style="v" sid="GAL 5:9"/>Tun-to̱ ko̱se̱-tu̱ u̱s-bi to̱ o̱ sha-mu̱ &lt;&lt;yisti cashi mo̱ wu̱' u̱r-tu̱ng u̱r-be̱e̱t de̱ yu̱ne̱.&gt;&gt; <verse eid="GAL 5:9"/><verse number="10" style="v" sid="GAL 5:10"/>U̱m to̱ste̱ jab u̱du̱ Wa-ko-uyan u̱zu̱ wa do̱'e̱ e̱'-du̱ no̱ du̱gu̱ do̱rru̱ ko̱se̱-tu̱ u̱s-bi. Se̱di Ru̱-u̱ do̱'e̱ no̱mu̱ ne̱t wa kwu̱p-du̱ u̱s-rem, wu̱ o̱o̱ge̱ e̱ngu̱sse̱ no̱. <verse eid="GAL 5:10"/><verse number="11" style="v" sid="GAL 5:11"/>U̱ da-o̱ o̱r-u̱t ri ne̱, a mu̱ne̱ u̱zu̱ u̱m o̱mo̱n u̱t-bu̱t u̱zu̱ se̱ na no̱ngu̱ no̱ u̱r-pe̱s, ¿yan-o̱ wa-e̱ na o̱mton u̱ yadu̱ me̱ u̱r-ko̱b? A mu̱ne̱ u̱zu̱ u̱m o̱ u̱t-ko̱se̱ u̱zu̱ se̱ na no̱nge̱ i ya'e̱ jab u̱r-pe̱s, ne̱t-tu̱ za hok-u̱t ryab-su̱ mo̱ttu̱ bu̱t-tu̱ rem-su̱ u-kan da. <verse eid="GAL 5:11"/><verse number="12" style="v" sid="GAL 5:12"/>U̱m cwang u̱zu̱ a-yu̱nsu̱ u̱s-jab ne̱ i o̱o̱ge̱ u̱ssa e̱ ho̱nsu̱ no̱ u̱r-pe̱s u̱zu̱ e̱ no̱mu̱ hi-u̱r e̱ u̱r-vu.<verse eid="GAL 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13"/>Remu̱ na fak no̱ u̱ no̱ no̱m u̱r-yu̱ u̱-me̱ u-u̱ku̱r o̱r-u̱t ri ne̱. Se̱di a no̱ yage̱ u̱ku̱r u̱ no̱ kume̱ o̱ shu̱'u̱t ke̱rru̱ yage̱-du̱ cwan-tu̱ u-waru̱ no̱ du̱u̱t no̱ da. Se̱di no̱mo̱n m-ank u̱ u̱ku̱r-u̱ no̱ kume̱ no̱ no̱me̱ o̱r-u̱t no̱ ne̱ u̱s-pama u-me̱ u̱t-cwan. <verse eid="GAL 5:13"/><verse number="14" style="v" sid="GAL 5:14"/>Remu̱ bo̱r-u̱t Yahuda-ne̱ na samge̱ to̱ u̱t-be̱e̱t u̱-me̱ u-bo̱r u-gan: &lt;&lt;Cwan ko̱wan u̱ka bo̱ tonte̱ hi-u̱r ró.&gt;&gt; <verse eid="GAL 5:14"/><verse number="15" style="v" sid="GAL 5:15"/>Se̱di a no̱ u̱t-no̱m sha-mu̱ u̱t-bisa, u̱ tu̱du̱ o̱r-u̱t no̱ ne̱ tu̱msu̱ u̱ ho̱nsu̱ e̱ ne̱, gwatu̱n sok, tass no̱ ho̱ru̱sse̱ o̱r-u̱t no̱ ne̱ da.<verse eid="GAL 5:15"/></para>
  <para style="s1">U̱r-yu̱ u̱du̱ Yar u-Ru̱</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16"/>Se̱di u̱m o̱ u̱t-zu̱, yagu̱n u̱ Yar-u̱ du̱u̱t fat-u̱t no̱. A no̱ no̱me̱ iya, no̱ zaar u̱ shu̱ksu̱ cwan-tu̱ u-war u̱ no̱. <verse eid="GAL 5:16"/><verse number="17" style="v" sid="GAL 5:17"/>Remu̱ zu̱ cwan-tu̱ u-waru̱ no̱ ton no̱m-u̱ Yar-u̱ u-Ru̱ zare̱ u̱t-sa da, tu̱msu̱ Yar-u̱ u-Ru̱ ton no̱m-u̱ cwan-tu̱ u-waru̱ no̱ tonte̱ da. Tunto̱ no̱m-to̱ u̱t-yu̱r to̱ o̱ m-dum o̱r-u̱t e̱ ne̱, tass bo̱ no̱m no̱m-u̱ cwan-tu̱ u-war u̱ no̱ u̱t-sa da. <verse eid="GAL 5:17"/><verse number="18" style="v" sid="GAL 5:18"/>Se̱di a no̱ no̱me̱ no̱m-u̱ Yar-u̱ waru̱ no̱, no̱ zamu̱n u̱ ta-u̱ ko̱se̱-tu̱ bo̱r-u̱t Yahuda-ne̱ da.<verse eid="GAL 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19"/>U̱ da-o̱ ank-mu̱ ba'as-tu̱ u-war o̱ m-zu̱n. To̱ o̱:</para>
  <para style="li" vid="GAL 5:19">M-o̱,</para>
  <para style="li" vid="GAL 5:19">Ko̱b-du̱ u-he̱n,</para>
  <para style="li" vid="GAL 5:19">Cwan-tu̱ ho̱g-du̱ re̱me̱r-mu̱ u-war,<verse eid="GAL 5:19"/></para>
  <para style="li">
    <verse number="20" style="v" sid="GAL 5:20"/>Do̱rru̱ ru̱-tu̱ zare̱ u̱r-fat,</para>
  <para style="li" vid="GAL 5:20">M-bo̱n ne̱,</para>
  <para style="li" vid="GAL 5:20">U̱t-gu̱gu̱m ne̱,</para>
  <para style="li" vid="GAL 5:20">U-har ne̱,</para>
  <para style="li" vid="GAL 5:20">U̱r-shu̱b ne̱,</para>
  <para style="li" vid="GAL 5:20">U̱ du̱u̱s-du̱ jab ne̱,</para>
  <para style="li" vid="GAL 5:20">U̱ cwan-tu̱ m-ze̱g ne̱,</para>
  <para style="li" vid="GAL 5:20">U̱ ko̱b-du̱ shu̱'u̱t-du̱ m-yar ne̱,</para>
  <para style="li" vid="GAL 5:20">U̱ mo̱t-du̱ u̱t-hi ne̱,<verse eid="GAL 5:20"/></para>
  <para style="li">
    <verse number="21" style="v" sid="GAL 5:21"/>shu̱b-du̱ re̱ u-shu̱ e̱ke̱n,</para>
  <para style="li" vid="GAL 5:21">U̱ swa ne̱,</para>
  <para style="li" vid="GAL 5:21">Cwan-tu̱ mo̱ro̱g-du̱ m-zan ne̱,</para>
  <para style="li" vid="GAL 5:21">U̱ to̱ko̱n no̱m-u̱t yo̱-to̱ ne̱.</para>
  <para style="m" vid="GAL 5:21">U̱m o̱ no̱mu̱ no̱ u̱t-him u̱ka u̱m no̱mtu̱ no̱ u̱r-taku̱n, ko̱wana o̱ no̱m-du̱ go̱-du̱ to̱ no̱m-to̱ wa za re̱-du̱ o̱g-du̱ Faru̱k-du̱ u-Ru̱ da.<verse eid="GAL 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22"/>Se̱di Yar-u̱ mu̱t go̱-du̱ tun-to̱ no̱m-to̱ u̱-me̱ fat-u̱t in:</para>
  <para style="li1" vid="GAL 5:22">U̱t-cwan,</para>
  <para style="li1" vid="GAL 5:22">U̱r-so̱ ne̱,</para>
  <para style="li1" vid="GAL 5:22">Ru̱s-du̱ jab ne̱,</para>
  <para style="li1" vid="GAL 5:22">Gag-du̱ jab ne̱,</para>
  <para style="li1" vid="GAL 5:22">U̱r-o̱n ne̱,</para>
  <para style="li1" vid="GAL 5:22">No̱m-du̱ no̱m-u̱t so̱-to̱ ne̱,</para>
  <para style="li1" vid="GAL 5:22">Yadu̱ jab ne̱,<verse eid="GAL 5:22"/></para>
  <para style="li">
    <verse number="23" style="v" sid="GAL 5:23"/>Swu̱u̱mse̱ du̱ u̱r-hi,</para>
  <para style="li1" vid="GAL 5:23">U̱ shu̱pdu̱ u̱r-hi ne̱.</para>
  <para style="m" vid="GAL 5:23">Bo̱r-yu̱ zaar yu̱ do̱'e̱ u̱t-zu̱ a ne̱t-tu̱ no̱m no̱m-to̱ da. <verse eid="GAL 5:23"/><verse number="24" style="v" sid="GAL 5:24"/>Tu̱msu̱ i o̱o̱ge̱ i Kiristi Ye̱so̱ e̱ taru̱g cwan-tu̱ ba'as-tu̱ u-war u̱ cwan-tu̱ no̱m-u̱t yo̱-to̱ ne̱. <verse eid="GAL 5:24"/><verse number="25" style="v" sid="GAL 5:25"/>Ba shu̱'u̱te̱ u̱zu̱ in o̱ u̱r-yu̱ u̱du̱ u-Yar, yage̱ in no̱mo̱n u̱r-no̱k u-me̱ du̱'u̱t-du̱ Yar-u̱. <verse eid="GAL 5:25"/><verse number="26" style="v" sid="GAL 5:26"/>Taas in shu̱'u̱t hi-u̱t yat-to̱ ne̱ da, ko̱ in wa o̱r-u̱t in ne̱ du̱u̱s jab da, ko̱ in no̱m shu̱b-du̱ o̱r-u̱t in ne̱ da.<verse eid="GAL 5:26"/></para>
  <chapter eid="GAL 5"/>
  <chapter number="6" style="c" sid="GAL 6"/>
  <para style="s1">No̱m-du̱ no̱m-u̱t so̱-to̱ u̱du̱ ko̱wan</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1"/>O̱r-u̱t ri ne̱, a ba'as-tu̱ shipe̱ waku̱n, no̱ i Yar-u̱ o̱o̱ge̱ u̱t-du̱'u̱t se̱ no̱ mu̱tu̱n go̱-du̱ ne̱t-u̱ wa u-fu̱n u̱-te̱k u̱t-swu̱u̱mse̱. Se̱di gwatu̱n hi-u̱r no̱ sok, tass no̱ he u̱ gandi go̱-du̱ mo̱ reg-mo̱ da. <verse eid="GAL 6:1"/><verse number="2" style="v" sid="GAL 6:2"/>Kabu̱n no-mu̱ o̱r-u̱t no̱ ne̱, tu̱msu̱ a no̱ no̱me̱ iya no̱ o̱ do̱rru̱ bo̱r-u̱t Kiristi. <verse eid="GAL 6:2"/><verse number="3" style="v" sid="GAL 6:3"/>A waku̱n u̱s-dorog u̱zu̱ o̱ko̱n-o̱ wa o̱o̱ge̱, tu̱msu̱ wa zaar o̱ko̱n da, wa o̱ e̱ngu̱sse̱ hi-u̱r wa. <verse eid="GAL 6:3"/><verse number="4" style="v" sid="GAL 6:4"/>Yage̱ ko̱wan no̱mu̱ hi-u̱r wa m-reg, da-u o̱ wa kere̱ no̱m-du̱ u̱t-u̱k u̱ hi-u̱r wa, a se̱ wa samge̱ hi-u̱r wa u̱ waku̱n ne̱ da. <verse eid="GAL 6:4"/><verse number="5" style="v" sid="GAL 6:5"/>Remu̱ zu̱ kowan do̱'e̱ kabdu̱ no-mu̱ no̱m-u̱ wa no̱me̱.<verse eid="GAL 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6"/>Ko̱wana wu̱ o̱ o̱nk-du̱ u̱t-bo̱r du̱gu̱-du̱ rem-su̱ u-Ru̱ se̱ wa yaag a-u̱t-ko̱se̱ wa ne̱, u̱du̱ mo̱t-du̱ no̱m-u̱t so̱-to̱ wa u̱t-be̱e̱t.<verse eid="GAL 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7"/>Taas no̱ e̱ngu̱sse̱ hi-u̱r no̱ da. Waku̱n nomte̱ u-Ru̱ ho̱r da, no̱m-u̱ ne̱t-u̱ kawe̱ o̱ wa do̱'e̱ u̱t-ke̱t. <verse eid="GAL 6:7"/><verse number="8" style="v" sid="GAL 6:8"/>Remu̱ i o̱o̱ge̱ yu̱du̱ ho̱k-su̱ war-tu̱ u̱t-ba'as e̱ m-re̱me̱r e̱ do̱'e̱ ke̱t-du̱ u̱t-zu̱m, u̱ka wa-u̱r-to̱m wu̱ ku̱we̱ go̱ za so̱-ye̱, wa do̱'e̱ ke̱t-du̱ ya-tu̱ za so̱-to̱. Se̱di ne̱t wu̱ o̱o̱ge̱ yu̱du̱ ho̱k-se̱ du̱ u-Yar m-re̱me̱r, wa do̱'e̱ kwu̱m-du̱ fat-du̱ m-mo̱mmo̱ du̱gu̱-du̱ u-Yar, u̱ka wa-u̱r-to̱m wu̱ kawe̱ go̱ so̱-ye̱ wa do̱'e̱ ke̱t-du̱ ya-u̱t so̱-to̱. <verse eid="GAL 6:8"/><verse number="9" style="v" sid="GAL 6:9"/>Se̱di a in pó u̱ no̱m-du̱ no̱m-u̱t so̱-to̱ ne̱ da. Remu̱ da-u̱ kame̱, in do̱'e̱ no̱m-du̱ ke̱t-u̱ so̱-o̱, a in ku̱u̱su̱n da. <verse eid="GAL 6:9"/><verse number="10" style="v" sid="GAL 6:10"/>Remu̱ iya, ko̱dahe̱ in kume̱ u̱r-ke̱r, yage̱ in no̱mu̱ ko̱wan no̱m-u so̱-o̱, hadde̱ i o̱o̱ge̱ me̱ bu-u̱ a-yadu̱ jab ne̱.<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">Wata a-doru̱ Ye̱so̱. </char></note><verse eid="GAL 6:10"/></para>
  <para style="s1">Him-tu̱ m-vaste̱</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11"/>Gwatu̱n pan-u̱s yasse̱ su̱ u̱m no̱me̱ u̱ka u̱m o̱tte̱ panu̱ no̱ tun-to̱ gom-tu̱ m-vaste̱ u̱ kom-u ri.<verse eid="GAL 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 6:12"/>I o̱o̱ge̱ u̱t-sa e̱ wa no̱ no̱m-du̱ pe̱s-du̱ za cwan e̱ u̱t-sa e̱ke̱n gwat e̱ ne̱t-u̱t so̱-to̱. No̱mu̱ wa'e̱ u̱n no̱m-u̱t iya e̱ zaar u̱t-sa na ya' e̱ u̱r-ko̱b da remu̱ e̱ o̱ no̱m-du̱ u̱t-ko̱se̱ u̱zu̱ mar-m Kiristi u-kan u̱ war-ya na do̱te̱ kwu̱m-du̱ u-u̱ku̱r. <verse eid="GAL 6:12"/><verse number="13" style="v" sid="GAL 6:13"/>Remu̱ i na no̱me̱ u̱r-pe̱s e̱ dor-u̱t u-bo̱r u̱ hi-u̱r e̱ da. Se̱di e̱ u̱t-sa na no̱mu̱ no̱ u̱r-pe̱s ko̱ e̱ no̱m u̱t-u̱k u̱ mo̱ttu̱ do̱rru̱ u̱r-pe̱s no̱. <verse eid="GAL 6:13"/><verse number="14" style="v" sid="GAL 6:14"/>Se̱di me̱, u̱m zatte̱ no̱m-u̱ u̱m do̱'e̱ u̱t-u̱k da se̱ kan-u Wa-ko-uyan in Ye̱so̱ Kiristi. Remu̱ kan-u ya, cwan-u̱t ri remu̱ uno̱ dak-o̱ to̱ maru̱g. Tu̱msu̱ cwan-tu̱ uno̱ dak-o̱ remu̱ ri to̱ maru̱g. <verse eid="GAL 6:14"/><verse number="15" style="v" sid="GAL 6:15"/>U̱r-pe̱s, ko̱ za u̱r-pe̱s o̱ zaar o̱kon no̱m-o̱ da. No̱m-u̱ zu̱ge̱ u̱r-zwar u̱zu̱ Ru̱-u̱ muute̱ in ne̱t-u̱t po-to̱. <verse eid="GAL 6:15"/><verse number="16" style="v" sid="GAL 6:16"/>U̱m no̱ng u̱s-ko̱n Ru̱-u̱ ya' ru̱s-du̱ jab-u̱ u̱r-o̱n ne̱ u̱du̱ i do̱re̱ tun-to̱ ko̱se̱-to̱ be̱e̱t. E̱ o̱ Isra-ne̱ u̱t-nip i u-Ru̱.<verse eid="GAL 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17"/>M-vaste̱, a waku̱n o̱ e̱kse̱ me̱ u̱ tun-to̱ no̱m-to̱ da. Rem u̱m o̱tte̱ u̱t-ran u̱ war-u ri su̱ ko̱se̱ u̱zu̱ me̱ yu̱ Ye̱so̱ wa u̱m o̱o̱ge̱.<verse eid="GAL 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18"/>O̱r-u̱t ri ne̱, nya-u Wa-ko-uyan in Ye̱so̱ Kiristi o̱ u̱r-kot u̱ yar-u no̱ ne̱. U̱ shu̱'u̱t iya.<verse eid="GAL 6:18"/></para>
  <chapter eid="GAL 6"/>
</usx>
