<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Fakai Translation</book>
  <para style="h">U̱r-Taku̱n</para>
  <para style="toc3">Taku̱</para>
  <para style="toc2">U̱r-Taku̱n</para>
  <para style="toc1">U̱r-Taku̱n</para>
  <para style="mt2">Ran-u̱</para>
  <para style="mt1">U̱r-Taku̱n</para>
  <chapter number="1" style="c" sid="GEN 1"/>
  <para style="s1">Taku̱n-du̱ ko̱-uyan</para>
  <para style="pi">
    <verse number="1" style="v" sid="GEN 1:1"/>U̱r-taku̱n, Ru̱-u̱ no̱mu̱g do̱m u-ru̱, u-dak-ne̱. <verse eid="GEN 1:1"/><verse number="2" style="v" sid="GEN 1:2"/>U̱ da-u o̱ dak-u̱ zatte̱ u̱ka u̱t-senu̱sse̱ da, tu̱msu̱ o̱ zatte̱ o̱ko̱n da, cwu̱m-u̱ taku̱ste̱ shu̱-u̱ radu̱ m-bu̱, tu̱msu̱ Yar-u u-Ru̱ o̱ u̱t-riig u̱-do̱m m-bu̱.<verse eid="GEN 1:2"/></para>
  <para style="li">
    <verse number="3" style="v" sid="GEN 1:3"/>Se̱ Ru̱-u̱ zu̱, &lt;&lt;Yage̱ u̱ zu̱n-mu̱ rwu̱u̱n.&gt;&gt; Se̱ zu̱n-mu̱ mok. <verse eid="GEN 1:3"/><verse number="4" style="v" sid="GEN 1:4"/>Se̱ Ru̱-u̱ hog u̱r-zwar u̱ zu̱n-mu̱ mok-te̱. Se̱ wa ké m-zu̱n du̱gu̱ u-cwu̱m. <verse eid="GEN 1:4"/><verse number="5" style="v" sid="GEN 1:5"/>Ru̱-u̱ fog m-zu̱n &lt;&lt;U-ho̱.&gt;&gt; Tu̱msu̱ wa fog u-cwu̱m &lt;&lt;M-gyu̱p.&gt;&gt; U̱ da-u o̱ na kume̱ m-rim tu̱msu̱ na kum u̱r-wu̱n. De̱ o̱ ho̱-du̱ u̱r-taku̱n.<verse eid="GEN 1:5"/></para>
  <para style="li">
    <verse number="6" style="v" sid="GEN 1:6"/>Se̱ Ru̱-u̱ zu̱, &lt;&lt;Yage̱ hu̱k-du̱ shu̱'u̱t du̱ do̱'e̱ u̱ ke̱-du̱ bu̱-mu̱ o̱ do̱m u̱ bu̱-mu̱ o̱ ta u-dak-ne̱, tu̱msu̱ yage̱ de̱ kè̱ m-bu̱ u-yu̱r.&gt;&gt; <verse eid="GEN 1:6"/><verse number="7" style="v" sid="GEN 1:7"/>Ru̱-u̱ nom u̱r-hu̱k de̱ keet-u̱t m-bu̱ mu̱ o̱o̱ge̱ do̱m-u̱ hu̱k-du̱ u-ru̱ u̱ bu̱-mu̱ o̱o̱ge̱ u̱-ta u̱r-hu̱k ne̱. Tu̱msu̱ iya o̱ nomte̱ u̱ka Ru̱-u̱ zu̱tte̱. <verse eid="GEN 1:7"/><verse number="8" style="v" sid="GEN 1:8"/>Ru̱-u̱ fog hu̱k-u̱r re̱, &lt;&lt;Hu̱k-du̱ do̱m u-ru̱.&gt;&gt; U̱ da-u o̱ na kume̱ m-rim tu̱msu̱ na kum u̱r-wu̱n, de̱ o̱ ho̱-du̱ u-yu̱ru̱mse̱.<verse eid="GEN 1:8"/></para>
  <para style="li">
    <verse number="9" style="v" sid="GEN 1:9"/>Se̱ Ru̱-u̱ zu̱, &lt;&lt;Yage̱ bu̱-mu̱ o̱o̱ge̱ ta-u̱ hu̱k-du̱ do̱m u-ru̱ mo̱ karu̱g u̱r-be u̱r-gan, tu̱msu̱ yage̱ u̱ dak-u u-gagu̱n rwu̱u̱n.&gt;&gt; Tu̱msu̱ iya o̱ nomte̱ u̱ka Ru̱-u̱ zu̱tte̱. <verse eid="GEN 1:9"/><verse number="10" style="v" sid="GEN 1:10"/>Ru̱-u̱ fog gas-u̱ o̱o̱ge̱ u-gagu̱n &lt;&lt;u-dak.&gt;&gt; Tu̱msu̱ bu̱-mu̱ karge̱ u̱r-be u̱r-gan wa fog mo̱ &lt;&lt;M-sa.&gt;&gt; Se̱ Ru̱-u̱ hyen no̱m-u̱ wa no̱me̱ no̱ng u̱ so̱-o̱.<verse eid="GEN 1:10"/></para>
  <para style="pi">
    <verse number="11" style="v" sid="GEN 1:11"/>Se̱ Ru̱-u̱ zu̱, &lt;&lt;Yage̱ dak-u̱ apu̱n go̱-tu̱ u̱t-ku̱wu̱t u̱s-te ne̱ su̱ mu̱te̱ u̱t-ya u̱ go̱ ne̱ u̱-me̱ to̱. Ko̱yu̱he̱ u̱ka du̱ wa go̱-de̱.&gt;&gt; Tu̱msu̱ iya o̱ nomte̱ u̱ka Ru̱-u̱ zu̱tte̱. <verse eid="GEN 1:11"/><verse number="12" style="v" sid="GEN 1:12"/>Iya o̱ hen dak-u̱ apu̱n go̱-tu̱ u̱t-ku̱wu̱t tu̱ mat-du̱ go̱ ko̱yu̱he̱ u̱ka go̱-u̱r wa o̱tte̱ u̱ u̱s-te ne̱ su̱ mu̱te̱ u̱t-ya u̱ go̱ ne̱ me̱. Se̱ Ru̱-u̱ hyen no̱m-u̱ wa no̱me̱ no̱ng u̱ so̱-o̱. <verse eid="GEN 1:12"/><verse number="13" style="v" sid="GEN 1:13"/>U̱ da-u o̱ na kume̱ m-rim tu̱msu̱ na kum u̱r-wu̱n, de̱ o̱ u̱ ho̱-du̱ u-tu̱tu̱rse̱.<verse eid="GEN 1:13"/></para>
  <para style="li">
    <verse number="14" style="v" sid="GEN 1:14"/>Se̱ Ru̱-u̱ zu̱, &lt;&lt;Yage̱ zu̱n-mu̱ shu̱'u̱t u̱ hu̱k-du̱ do̱m u-ru̱ u̱ kè̱ u-ho̱ u̱ m-gyu̱p ne̱, tu̱msu̱ yage̱ to̱ shu̱'u̱t u̱s-nap su̱ ko̱se̱-du̱ u-da, u̱t-ho̱ ne̱, tu̱msu̱ u̱s-hak ne̱. <verse eid="GEN 1:14"/><verse number="15" style="v" sid="GEN 1:15"/>Tu̱msu̱ yage̱ to̱ shu̱'u̱t u̱ka m-zu̱n u̱ hu̱k-du̱ do̱m u-ru̱ u̱ ya' m-zu̱n u̱-do̱m u-dak.&gt;&gt; Tu̱msu̱ iya o̱ nomte̱ u̱ka Ru̱-u̱ zu̱tte̱. <verse eid="GEN 1:15"/><verse number="16" style="v" sid="GEN 1:16"/>Ru̱-u̱ no̱ng zu̱n-m yat-mo̱ m-yu̱r, zu̱n-m yat-mo̱ mo̱ no̱m faru̱k-du̱ u-ho̱ tu̱msu̱ zu̱nu̱n-m re̱k-mo̱ no̱m faru̱k-du̱ m-gyu̱p. Tu̱msu̱ wa nom re̱ge̱r. <verse eid="GEN 1:16"/><verse number="17" style="v" sid="GEN 1:17"/>Ru̱-u̱ sak u̱r-ho̱, u-pyaat u̱ re̱ge̱r ne̱ u̱-do̱m u-ru̱, remu̱ e̱ ye'et m-zu̱n u-dak, <verse eid="GEN 1:17"/><verse number="18" style="v" sid="GEN 1:18"/>remu̱ e̱ no̱m-u̱t faru̱k-du̱ u-ho̱ m-gyu̱p ne̱, tu̱msu̱ u̱ kè̱ m-zu̱n du̱gu̱ u-cwu̱m. Se̱ Ru̱-u̱ hyen no̱m-u̱ wa no̱me̱ no̱ng u̱ so̱-o̱. <verse eid="GEN 1:18"/><verse number="19" style="v" sid="GEN 1:19"/>U̱ da-u o̱ na kume̱ m-rim tu̱msu̱ na kum u̱r-wu̱n, de̱ o̱o̱ge̱ ho̱-du̱ u-nasu̱rse̱.<verse eid="GEN 1:19"/></para>
  <para style="li">
    <verse number="20" style="v" sid="GEN 1:20"/>Se̱ Ru̱-u̱ zu̱, &lt;&lt;Yage̱ u̱ bu̱-mu̱ rwu̱u̱tu̱n no̱m u̱r-fat u̱ shi m-bu̱, tu̱msu̱ u̱ no ne̱ u̱ yu̱ne̱ u̱t-kap u̱ do̱m hu̱k-du̱ u-ru̱.&gt;&gt; <verse eid="GEN 1:20"/><verse number="21" style="v" sid="GEN 1:21"/>Iya o̱ Ru̱-u̱ nomte̱ no̱m-u̱ u̱r-fat i-yate̱ m-sa, tu̱msu̱ ko̱yu̱he̱ no̱m u̱r-fat ne̱ tu̱ o̱o̱ge̱ m-yu̱ u̱-me̱ m-bu̱, ko̱wan u̱ du̱ wa go̱-de̱, tu̱msu̱ u̱ ko̱yu̱he̱ no yu̱ u̱t-kap ne̱ ko̱wan u̱ du̱ wa go̱de̱. Se̱ Ru̱-u̱ hyen no̱m-u̱ wa no̱me̱ o̱ u̱ so̱-o̱. <verse eid="GEN 1:21"/><verse number="22" style="v" sid="GEN 1:22"/>Se̱ Ru̱-u̱ wa'-u̱ to̱ nu-u so̱-o̱ wa zu̱, &lt;&lt;De̱e̱n no̱ mat yaag no̱ sur u-tát no̱ shi m-sa, tu̱msu̱ yage̱ no e̱ sur u-tát e̱ shi u-dak.&gt;&gt; <verse eid="GEN 1:22"/><verse number="23" style="v" sid="GEN 1:23"/>U̱ da-u o̱ na kume̱ m-rim tu̱msu̱ na kum u̱r-wu̱n, de̱ o̱ ho̱-du̱ u-tanu̱rse̱.<verse eid="GEN 1:23"/></para>
  <para style="li">
    <verse number="24" style="v" sid="GEN 1:24"/>Ru̱-u̱ zu̱, &lt;&lt;Yage̱ dak-u̱ rwu̱tu̱n ko̱-uyan go̱-du̱ no̱m-tu̱ u̱r-fat tu̱ o̱o̱ge̱ u̱t-kurup kowan u̱du̱ wa go̱-de̱, bisa-tu̱ u-bu u̱ no̱m u̱r-fat ne̱ u̱ i o̱o̱ge̱ u̱t-kurup ne̱ u̱-do̱m u-dak u̱ bisa-tu̱ u̱r-do̱g ne̱ u̱ ko̱-uyan no̱m-u̱ u̱r-fat ne̱.&gt;&gt; Iya o̱ nomte̱ u̱ka Ru̱-u̱ zu̱tte̱. <verse eid="GEN 1:24"/><verse number="25" style="v" sid="GEN 1:25"/>Iya o̱ Ru̱-u̱ nomte̱ bisa-tu̱ u-dak u̱t-be̱e̱t ko̱-uyan no̱m u̱r-fat be̱e̱t ko̱yu̱he̱ u̱ka du̱ wa go̱-de̱. Wa no̱mu̱g bisa-tu̱ u-bu u̱ no̱m u̱r-fat ne̱ u̱ i u̱t-kurup be̱e̱t u-dak ko̱yu̱he̱ u̱du̱ ya go̱-de̱. Se̱ Ru̱-u̱ hyen no̱m-u̱ wa no̱me̱ no̱ng u̱ so̱-o̱.<verse eid="GEN 1:25"/></para>
  <para style="pi">
    <verse number="26" style="v" sid="GEN 1:26"/>Se̱ Ru̱-u̱ zu̱, &lt;&lt;Yage̱ it no̱m ne̱t wu̱ o̱tte̱ u-ryu̱n u̱ sha-m in. Yage̱ e̱ no̱m u̱r-faru̱k u̱ do̱m-u̱ jan m-bu̱, u̱ do̱m-u̱ no ne̱, tu̱msu̱ u̱ do̱m-u̱ bisa-tu̱ u-bu ne̱, tu̱msu̱ dak u-be̱e̱t ne̱, tu̱msu̱ no̱m-u̱ u̱r-fat ne̱ be̱e̱t i o̱ u̱t-kurup u̱ u-dak u-be̱e̱t.&gt;&gt;<verse eid="GEN 1:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 1:27"/>I ya-o̱ Ru̱-u̱ no̱m-te̱</para>
  <para style="q2" vid="GEN 1:27">ne̱t u̱-me̱ sha-m wa,</para>
  <para style="q1" vid="GEN 1:27">u̱-me̱ sha-mu̱ Ru̱-u̱ o̱,</para>
  <para style="q2" vid="GEN 1:27">Ru̱-u̱ no̱m-te̱ ne̱t,</para>
  <para style="q1" vid="GEN 1:27">campa u̱ ne̱ta Ru̱-u̱ nom e̱.<verse eid="GEN 1:27"/></para>
  <para style="pi">
    <verse number="28" style="v" sid="GEN 1:28"/>Se̱ Ru̱-u̱ wa'-u̱ u̱n nu-u so̱-o̱ wa zu̱, &lt;&lt;De̱e̱n no̱ mat yaag, yage̱ e̱ no̱m u-tát, e̱ shi u-dak u-be̱e̱t tu̱msu̱ e̱ no̱m faru̱k-du̱ o̱. E̱ no̱m faru̱k-du̱ jan-u̱ me̱ m-sa, tu̱msu̱ u̱ do̱m-u̱ no ne̱ i do̱m-u̱ u-ru̱, tu̱msu̱ u̱ do̱m-u̱ ko̱-uyan no̱m-u̱ u̱r-fat u̱ o̱ u̱-do̱m u-dak.&gt;&gt;<verse eid="GEN 1:28"/></para>
  <para style="pi">
    <verse number="29" style="v" sid="GEN 1:29"/>Se̱ Ru̱-u̱ zu̱, &lt;&lt;U̱m yaag no̱ ko̱-uyan go̱-du̱ ku̱-u o̱ u-be̱e̱t u̱ mu̱te̱ yaag u-dak u-be̱e̱t tu̱msu̱ u̱ ko̱-uyan go̱-yu̱ u-te yu̱ o̱tte̱ u̱t-ya u̱ go̱ ne̱ u̱-me̱ ya. To̱ shu̱'u̱t no̱m-tu̱ u̱t-re̱ no̱. <verse eid="GEN 1:29"/><verse number="30" style="v" sid="GEN 1:30"/>U̱m yaag u̱t-ran u̱t-gwa ne̱ u̱t-be̱e̱t to̱ u̱ shu̱'u̱t no̱m u̱t-re̱ u̱du̱ ko̱-uyan bisa-o̱ u̱ o̱ u-dak, ko̱-uyan no-ya u̱-do̱m u-ru̱, tu̱msu̱ ko̱yu̱he̱ no̱m-yu̱ u̱r-fat ya yu̱ o̱ u̱t-kurup u-dak, u̱ no̱m-u̱ o̱ u̱r-fat ne̱ u-be̱e̱t.&gt;&gt; Tu̱msu̱ iya o̱ nomte̱ u̱ka Ru̱-u̱ zu̱tte̱.<verse eid="GEN 1:30"/></para>
  <para style="pi">
    <verse number="31" style="v" sid="GEN 1:31"/>Se̱ Ru̱-u̱ hyen no̱m-u̱ wa no̱me̱ u-be̱e̱t, o̱ no̱mu̱g u̱ so̱-o̱ sok. Se̱ na kum u̱r-wu̱n tu̱msu̱ na kum m-rim, de̱ o̱ ho̱-du̱ u̱t-shishin.<verse eid="GEN 1:31"/></para>
  <chapter eid="GEN 1"/>
  <chapter number="2" style="c" sid="GEN 2"/>
  <para style="pi">
    <verse number="1" style="v" sid="GEN 2:1"/>Iya-o̱ Ru̱-u̱ taaste̱ no̱m-du̱ do̱m u-ru̱ u-dak-ne̱, u̱ no̱m-tu̱ o̱ me̱ ne̱ u̱t-be̱e̱t.<verse eid="GEN 2:1"/></para>
  <para style="li">
    <verse number="2" style="v" sid="GEN 2:2"/>Kanda ho̱-du̱ u̱r-ta'er u̱, Ru̱-u̱ taaste̱ no̱m-du̱ ank-mu̱ wa o̱o̱ge̱ u̱t-no̱m u-be̱e̱t; se̱ wa hure̱ du̱gu̱ ank-m wa u̱ ho̱-du̱ u̱r-ta'er. <verse eid="GEN 2:2"/><verse number="3" style="v" sid="GEN 2:3"/>Se̱ Ru̱-u̱ wa'-u̱ ho̱-du̱ u̱r-ta'er nu-u so̱-o̱, wa muut de̱ ho̱-du̱ u-he̱n. Ru̱-u̱ no̱ng iya remu̱ zu̱ u̱ ho̱-u̱r re̱ wa hure̱ du̱gu̱ ank-mu̱ wa no̱me̱ m-be̱e̱t.<verse eid="GEN 2:3"/></para>
  <para style="s1">Ru̱-u̱ no̱mu̱g ne̱t-tu̱ u̱r-taku̱n <optbreak/> Adamu e̱ Hawa</para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 2:4"/>Tun-to̱ to̱ o̱o̱ge̱ ogu̱r-tu̱ do̱m u-ru̱ u̱ u-dak-ne̱ da na tase̱ no̱m-du̱ to̱.</para>
  <para style="p" vid="GEN 2:4">Da Yawe u-Ru̱ no̱me̱ u-dak u̱ do̱m u-ru̱ ne̱, <verse eid="GEN 2:4"/><verse number="5" style="v" sid="GEN 2:5"/>tu̱msu̱ gwa-tu̱ zaar tu̱ apne̱ u-dak da. Tu̱msu̱ ku̱w-u̱t tu̱ zaar tu̱ rwu̱ne̱ u-dak da, remu̱ zu̱ Yawe Ru̱-u̱ wa'ag yu̱-u̱ rob da uro, tu̱msu̱ ne̱t zaar wu̱ de̱ u̱ ku̱w u̱r-to̱m ne̱ u-dak da. <verse eid="GEN 2:5"/><verse number="6" style="v" sid="GEN 2:6"/>Se̱di rap-u̱t u̱ rwu̱u̱n du̱gu̱ u-dak, o̱ mu̱st u-dak u-be̱e̱t. <verse eid="GEN 2:6"/><verse number="7" style="v" sid="GEN 2:7"/>Se̱ Yawe u-Ru̱ nom ne̱t u̱ rwab-tu̱ u-dak. Wa fur mya-mu̱ u̱r-fat u̱ swa-du̱ ne̱t, se̱ ne̱t kum u̱r-fat.<verse eid="GEN 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8"/>Yawe u-Ru̱ zo̱ngte̱ u-tak, u̱ de̱ku̱n be-de̱ du̱ na foge̱ Idin, gas-u̱ ho̱-du̱ rwu̱tu̱n. Ku̱na wa cinte̱ ne̱t-u̱ wa no̱me̱. <verse eid="GEN 2:8"/><verse number="9" style="v" sid="GEN 2:9"/>Yawe u-Ru̱ wa'ag ko̱-uyan go̱-du̱ u-te ya u̱ apu̱n ku̱n, te-su̱ o̱ zwarru̱ m-hyan ne̱ tu̱msu̱ u̱ zwarru̱ u̱t-re̱ ne̱. Te-yu̱ u̱r-fat o̱ro te̱k-u̱ tak-u o̱. U̱ te-yu̱ wadu̱ ne̱t-ne̱ u̱ nap-mu̱ no̱m-u̱ so̱-o̱ u̱ no̱m-u yo̱-o̱ ne̱.<verse eid="GEN 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10"/>Gi-yu̱ yu̱'e̱ u-tak m-bu̱ ya jagu̱n du̱gu̱ Idin, du̱gu̱ ku̱n ya mot m-te u̱s-gi u̱s-nas. <verse eid="GEN 2:10"/><verse number="11" style="v" sid="GEN 2:11"/>Dim-du̱ gi-yu̱ u̱r-taku̱n na zu̱ ya Piso̱n. Gi-u ya gu̱pe̱ m-nar gas-u̱ dak-u̱ Havira u-be̱e̱t, be-du̱ o̱tte̱ kwam-tu̱ shik tu̱ bu̱-mu̱ u̱t-ro. <verse eid="GEN 2:11"/><verse number="12" style="v" sid="GEN 2:12"/>Kwam-tu̱ shik tu̱ dak-u̱ Havira to̱ zatte̱ u̱r-waak u̱ o̱ko̱n no̱m-o̱ ne̱ u̱ de̱ naasu̱ o̱ da. Tu̱msu̱ u̱n o̱tte̱ dap-mu̱ wu̱s u-haku̱n, u̱ ta'ar-u̱t rim-to̱ ne̱ tu̱ shik sok. <verse eid="GEN 2:12"/><verse number="13" style="v" sid="GEN 2:13"/>Dim-du̱ gi-yu̱ u-yu̱ru̱mse̱ na zu̱ ya Giho̱n, gi-u ya gu̱p m-nar u̱ gas-u̱ dak-u̱ Kus u-be̱e̱t. <verse eid="GEN 2:13"/><verse number="14" style="v" sid="GEN 2:14"/>Dim-du̱ gi-yu̱ u-tu̱tu̱rse̱ Tigris, ja-mu̱ gi-u ya gu̱p u̱ gas-u̱ u-do̱m u̱ gu̱r-u̱ Asur. Dim-du̱ gi-yu̱ u-nasu̱rse̱ na zu̱ ya Yupireti.<verse eid="GEN 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15"/>Yawe u-Ru̱ wu̱ ne̱t u̱-me̱ u-tak u̱ Idin, remu̱ ne̱t-u̱ no̱m-u̱t to̱m-du̱ o̱ tu̱msu̱ wa gwat o̱. <verse eid="GEN 2:15"/><verse number="16" style="v" sid="GEN 2:16"/>Se̱ Yawe u-Ru̱ no̱mu̱ ne̱t-u̱ wa u̱t-him, &lt;&lt;Bo̱ keru̱ re̱-du̱ yaa-tu̱ u̱s-te u̱s-be̱e̱t su̱ o̱ u-tak, <verse eid="GEN 2:16"/><verse number="17" style="v" sid="GEN 2:17"/>se̱di A-bo̱ re̱ yaa-tu̱ te-yu̱ nap-mu̱ no̱m-u̱t so̱-to̱ u̱ tu̱ yo̱-to̱ ne̱ da, remu̱ zu̱ ho̱-du̱ bo̱ re̱ yaa-tu̱ te-u ya bo̱ de̱ m-mar za u-sakna.&gt;&gt;<verse eid="GEN 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18"/>Se̱ Yawe u-Ru̱ zu̱, &lt;&lt;No̱ng u̱r-zwar u̱ ne̱t u̱ shu̱'u̱t wa u-gan da. Yage̱ u̱m no̱mu̱ wa, wa-u̱r-se̱ge̱ wu̱ o̱ ho̱n-ho̱n u̱ wu̱n ne̱.&gt;&gt;<verse eid="GEN 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 2:19"/>Du̱gu̱ u-dak Yawe u-Ru̱ nomte̱ ko̱-uyan go̱-du̱ u̱t-bisa u̱ no ne̱. Wa hatu̱n e̱ u̱du̱ ne̱t wa te̱'e̱ e̱ u̱t-dim, tu̱msu̱ ko̱-uyan dim-de̱ wa fogte̱ bisa-u̱t to̱ u̱ no ne̱, de̱ shu̱'u̱te̱ dim-u̱r wa. <verse eid="GEN 2:19"/><verse number="20" style="v" sid="GEN 2:20"/>Adamu te̱'e̱ bisa-u̱t to̱ u̱ no ne̱ u̱ bisa-tu̱ u̱r-do̱g u̱t-be̱e̱t u̱t-dim.</para>
  <para style="p" vid="GEN 2:20">Ko̱ ba shu̱'u̱te̱ iya Adamu zatte̱ wa-u̱r-se̱ge̱ ho̱n-ho̱n u̱ wa ne̱ da.<note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="ft" closed="false">Adamu: Dim-de̱ rem-du̱ u̱t-Ibraniya, de̱ na foge̱ ne̱t u̱r-taku̱n &lt;&lt;Ne̱t&gt;&gt;.</char></note> <verse eid="GEN 2:20"/><verse number="21" style="v" sid="GEN 2:21"/>Se̱ Yawe u-Ru̱ wu̱ roog-m yat-mo̱ ship ne̱t-u̱ wa. Da-u̱ wa o̱ te̱k m-roog, Ru̱-u̱ for shar-yu̱ u-gas u-gan yu̱ ne̱t-u̱ wa, se̱ wa zwape̱ be-u̱r re̱ du̱ wa forte̱ shar-yu̱ u-gas u̱ ap-mu̱ u-war. <verse eid="GEN 2:21"/><verse number="22" style="v" sid="GEN 2:22"/>Iya o̱ Yawe u-Ru̱ ku̱bte̱ shar-yu̱ u-gas yu̱ wa fare̱ du̱gu̱-du̱ ne̱t-u̱ wa, wa nom ne̱ta. Se̱ wa haatu̱n ne̱ta-u ya u̱du̱ ne̱t-u̱ wa.<verse eid="GEN 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 2:23"/>Se̱ ne̱t-u̱ wa zu̱,</para>
  <para style="q1" vid="GEN 2:23">&lt;&lt;M-vaste̱! Sham-m ri ya,</para>
  <para style="q2" vid="GEN 2:23">shar-ya yu̱ rwu̱ne̱</para>
  <para style="q2" vid="GEN 2:23">du̱gu̱ shar-u̱t ri,</para>
  <para style="q1" vid="GEN 2:23">Tu̱msu̱ ap-m wa</para>
  <para style="q2" vid="GEN 2:23">du̱gu̱ ap-m ri.</para>
  <para style="q1" vid="GEN 2:23">Na de̱ fag-du̱ wa &lt;Ne̱ta,&gt;</para>
  <para style="q2" vid="GEN 2:23">remu̱ zu̱, Ru̱-o̱</para>
  <para style="q2" vid="GEN 2:23">rwu̱tu̱n ne̱ta du̱gu̱ war-u̱ ne̱t.&gt;&gt;<verse eid="GEN 2:23"/></para>
  <para style="m">
    <verse number="24" style="v" sid="GEN 2:24"/>Remu̱ iya, campa de̱ yagu̱ u̱so-u wa u̱ ino-u wa ne̱, wa dap ne̱ta wa, e̱ shu̱'u̱te̱ u-war u-gan.<verse eid="GEN 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25"/>Ne̱t-u̱ wa e̱ ne̱ta wa ne̱ be̱e̱t e̱ o̱ u̱t-so, se̱di e̱ ho̱k m-'e̱ da.<verse eid="GEN 2:25"/></para>
  <chapter eid="GEN 2"/>
  <chapter number="3" style="c" sid="GEN 3"/>
  <para style="s1">Adamu e̱ Hawa no̱mu̱g u̱t-ba'as</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1"/>Fa-yu̱ ze̱k ko̱-uyan bisa-tu̱ Yawe u-Ru̱ no̱me̱ u̱s-ve̱r. Se̱ fa-yu̱ zu̱ ne̱ta, &lt;&lt;¿Ko̱ Ru̱-u̱ zu̱u̱g A no̱ re̱ u̱ te̱k-u̱ yaa-tu̱ ko̱-uyan te ya yu̱ o̱ me̱ tak-u̱ Idin da?&gt;&gt;<verse eid="GEN 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2"/>Se̱ ne̱ta zu̱ u-fa, &lt;&lt;Ru̱-u̱ zu̱u̱g it u̱ kere̱ re̱-du̱ yaatu̱ u̱s-te su̱ o̱o̱ge̱ u-tak, <verse eid="GEN 3:2"/><verse number="3" style="v" sid="GEN 3:3"/>Se̱di Ru̱-u̱ zu̱u̱g, &lt;A no̱ jaru̱n no̱ re̱ yaa-tu̱ te-u ya yu̱ o̱o̱ge̱ u̱-te̱k u-tak da, tu̱msu̱ A no̱ tam ya da, taas no̱ mar da.&gt; &gt;&gt;<verse eid="GEN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4"/>Tu̱msu̱ fa-yu̱ zu̱ ne̱ta, &lt;&lt;Iya o̱ da, no̱ za m-mar da. <verse eid="GEN 3:4"/><verse number="5" style="v" sid="GEN 3:5"/>Ru̱-u̱ zu̱u̱g iya remu̱ zu̱ wa nak u̱zu̱ a no̱ re̱ye̱ is-u̱ no̱ de̱ u̱t-upus, no̱ shu̱'u̱t u̱ka u-Ru̱, no̱ nap no̱m-u̱t so̱-to̱ u̱ tu̱ yo̱-to̱ ne̱.&gt;&gt;<verse eid="GEN 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6"/>Da-u̱ ne̱ta-yu̱ hyane̱ u̱zu̱ yaatu̱ u-te̱ o̱ so̱-to̱ u̱du̱ u̱t-re̱, tu̱msu̱ o̱tte̱ zwarru̱ m-hyan, u̱t-no̱m u̱r-zwar remu̱ ya-du̱ m-nap; se̱ wa ku̱ wa re. Wa yaase̱ to̱ko̱n u̱du̱ campa wa, wu̱ o̱o̱ge̱ u̱r-kot u̱ wa ne̱, se̱ wa re. <verse eid="GEN 3:6"/><verse number="7" style="v" sid="GEN 3:7"/>Za rem se̱ is-u̱ u̱n be̱e̱t u-pus u̱n nu̱p u̱zu̱ so-to̱ u̱n o̱ye̱. Se̱ e̱ saan ran-tu̱ u-te yu̱ mu̱te̱ u̱t-ya yu̱ na foge̱ te-yu̱ u-rumba.<verse eid="GEN 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8"/>Da-u̱ rim-mu̱ tore̱ se̱ e̱ hog ram-u̱s Yawe u-Ru̱ u-tak. Ne̱t-u̱ wa e̱ ne̱ta wa e̱ pu̱k te-su̱ u-tak, taas u̱ Ru̱-u̱ hyan e̱ da. <verse eid="GEN 3:8"/><verse number="9" style="v" sid="GEN 3:9"/>Se̱ Yawe u-Ru̱ fog ne̱t-u̱ wa u̱zu̱, &lt;&lt;¿He̱ bo̱ o̱tte̱?&gt;&gt;<verse eid="GEN 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10"/>Se̱ wa zu̱, &lt;&lt;U̱m ho̱k ram-u̱s ró u-tak, se̱di u̱m ho̱k u-gye̱r, remu̱ zu̱ so-de̱ u̱m o̱ye̱, se̱ u̱m pu̱k.&gt;&gt;<verse eid="GEN 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11"/>Yawe u-Ru̱ zu̱, &lt;&lt;¿Wana waru̱ bo̱ u̱zu̱ so̱-de̱ bo̱ o̱ye̱? ¿Ko̱ bo̱ re̱ m-re̱ yaatu̱ u-te tu̱ u̱m zu̱ a-bo̱ re̱ da?&gt;&gt;<verse eid="GEN 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12"/>Se̱ ne̱t-u̱ wa zu̱, &lt;&lt;Ne̱ta wa wu̱ bo̱ ya me̱ wa ya' me̱ yaatu̱ te-u ya, tu̱msu̱ u̱m re.&gt;&gt;<verse eid="GEN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13"/>Se̱ u-Ru̱ Yawe zu̱ ne̱ta-u ya, &lt;&lt;¿Yan-o̱ bo̱ no̱me̱ inya?&gt;&gt;</para>
  <para style="p" vid="GEN 3:13">Se̱ ne̱ta-u ya zu̱, &lt;&lt;Fa-ya e̱ngu̱sse̱ me̱ se̱ u̱m re.&gt;&gt;<verse eid="GEN 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14"/>Se̱ Yawe u-Ru̱ zu̱ u-fa, Remu̱ zu̱ bo̱ e̱ngu̱sse̱ ne̱ta,</para>
  <para style="q1" vid="GEN 3:14">U̱m wa'agu̱ bo̱ nu-u yo̱-o̱ bo̱</para>
  <para style="q2" vid="GEN 3:14">o̱ do̱'e̱ u̱t-do̱r u̱ war ró</para>
  <para style="q2" vid="GEN 3:14">u̱-me̱ bisa-tu̱ u-bu</para>
  <para style="q1" vid="GEN 3:14">u̱ bisa-tu̱ u̱r-do̱g ne̱ u̱t-be̱e̱t.</para>
  <para style="q1" vid="GEN 3:14">Bo̱ de̱ u̱t-fu̱k u̱t-me̱n</para>
  <para style="q2" vid="GEN 3:14">tu̱msu̱ huug-mo̱ de̱ shu̱'u̱tu̱</para>
  <para style="q2" vid="GEN 3:14">no̱m u̱t-re̱ ró u̱ yu̱u̱r-u̱r ró u̱r-be̱e̱t.<verse eid="GEN 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 3:15"/>Me̱ wa'-u̱ yu̱-u̱r yo̱-de̱</para>
  <para style="q2" vid="GEN 3:15">u̱ te̱k-u̱ ko̱-u̱r ró u̱ du̱ ne̱ta-u ya ne̱,</para>
  <para style="q1" vid="GEN 3:15">ko̱-u̱r ne̱ta tu̱msu̱ u̱ ko̱-u̱r ró ne̱, <note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">Gom-du̱ u̱r-ko̱ du̱ ne̱ta, rem-su̱ ko̱-du̱ campa-ne̱ se̱ tu̱msu̱ su̱ ne̱t gan. U̱t-ne̱t u-tát kabu̱g u̱zu̱ rem-su̱ haan-u̱r Ye̱so̱ Kiristi se̱.</char></note></para>
  <para style="q2" vid="GEN 3:15">Wa jangu̱ hi-u̱r ró</para>
  <para style="q1" vid="GEN 3:15">tu̱msu̱ hen bo̱ de̱ ke̱t-du̱ du̱ku̱nte̱-u̱t e̱.<verse eid="GEN 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16"/>Se̱ Ru̱-u̱ zu̱ ne̱ta,</para>
  <para style="q1" vid="GEN 3:16">&lt;&lt;Me̱ swu̱ru̱ bo̱ swadu̱</para>
  <para style="q2" vid="GEN 3:16">u̱r-ko̱b u̱du̱ u̱r-mat,</para>
  <para style="q1" vid="GEN 3:16">u̱ te̱k-u̱ swadu̱ u̱r-ko̱b de̱ bo̱</para>
  <para style="q2" vid="GEN 3:16">do̱te̱ mat-du̱ yaag-u̱ ró,</para>
  <para style="q1" vid="GEN 3:16">Cwan-u̱t ró do̱'e̱ u̱t-shu̱'u̱t</para>
  <para style="q2" vid="GEN 3:16">remu̱ campa ró,</para>
  <para style="q1" vid="GEN 3:16">se̱di wa de̱ u̱t-shu̱'u̱t yu̱-Yat-ya ró.&gt;&gt;<verse eid="GEN 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17"/>Wa zu̱ Adamu, &lt;&lt;Remu̱ bo̱ erte̱ cwar-yu̱ ne̱ta ró, bo̱ re yaatu̱ te̱-u ya, &lt;yu̱ u̱m zu̱ bo̱ a-bo̱ re̱ da,&gt;</para>
  <para style="q1" vid="GEN 3:17">&lt;&lt;U̱m wa'agu̱ u-dak nu-u</para>
  <para style="q2" vid="GEN 3:17">yo̱-o̱ remu̱ ró,</para>
  <para style="q1" vid="GEN 3:17">se̱ bo̱ no̱ng m-ank sok mu̱</para>
  <para style="q2" vid="GEN 3:17">swadu̱ u̱r-ko̱b kanda bo̱ kum no̱m u̱t-re̱</para>
  <para style="q2" vid="GEN 3:17">u̱ bo̱ de̱ u̱t-re̱,</para>
  <para style="q1" vid="GEN 3:17">u̱ yu̱-u̱r ró u̱r-be̱e̱t.<verse eid="GEN 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 3:18"/>Dak-u̱ do̱'e̱ apu̱n-du̱ u̱s-hir</para>
  <para style="q2" vid="GEN 3:18">m-baat ne̱ remu̱ ró,</para>
  <para style="q1" vid="GEN 3:18">u̱ same̱ u̱s-gwa ne̱</para>
  <para style="q2" vid="GEN 3:18">su̱ na-su̱ u̱t-ku̱wu̱t.<verse eid="GEN 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 3:19"/>U̱s-hund se̱</para>
  <para style="q2" vid="GEN 3:19">bo̱ do̱te̱ re̱-du̱ no̱m u̱t-re̱,</para>
  <para style="q1" vid="GEN 3:19">M-te̱ ho̱-du̱ bo̱ do̱'e̱ m-mar</para>
  <para style="q2" vid="GEN 3:19">tu̱msu̱ bo̱ de̱ mu̱-du̱ u-dak,</para>
  <para style="q1" vid="GEN 3:19">remu̱ zu̱ du̱gu̱ me̱</para>
  <para style="q2" vid="GEN 3:19">u-dak o̱ bo̱ rwu̱ne̱.</para>
  <para style="q1" vid="GEN 3:19">Bo̱ rwab-to̱</para>
  <para style="q2" vid="GEN 3:19">tu̱msu̱ bo̱ de̱ u̱t-baru̱m u̱t-rwab.&gt;&gt;<verse eid="GEN 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20"/>Ne̱t-u̱ wa fog dim-du̱ ne̱ta wa Hawa, remu̱ zu̱ wa o̱ye̱ ino-u̱ u̱t-ne̱t u̱t-be̱e̱t tu̱ o̱ u̱r-fat.<verse eid="GEN 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 3:21"/>Se̱ Yawe u-Ru̱ no̱mu̱ Adamu e̱ ne̱ta wa u̱t-kus u̱ ka-tu̱ u̱t-bisa tu̱msu̱ wa taku̱s so-u̱t u̱n.<verse eid="GEN 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22"/>Se̱ Yawe u-Ru̱ zu̱ hi-u̱r wa, &lt;&lt;Gwat u̱ da-o̱ ne̱t shu̱'u̱te̱ u̱s-gan u̱ in ne̱, wa o̱tte̱ nap-mu̱ no̱m-u̱ so̱-o̱ u̱ yo̱-o̱ ne̱. Na zaaru̱ yage̱ wu̱n u jaku̱s u-kom u̱ wa ka yaatu̱ te-yu̱ u̱r-fat, taas wa re̱, u̱ wa no̱m u̱r-yu̱ m-mo̱mmo̱ da.&gt;&gt; <verse eid="GEN 3:22"/><verse number="23" style="v" sid="GEN 3:23"/>Remu̱ iya Yawe u-Ru̱ wa yanu̱g Adamu e̱ Hawa du̱gu̱ tak-u̱ Idin, remu̱ zu̱ Adamu nom-u̱t u̱r-to̱m u̱ dak-u̱ Ru̱-u̱ nom-tu̱ wa. <verse eid="GEN 3:23"/><verse number="24" style="v" sid="GEN 3:24"/>Da-u̱ Yawe u-Ru̱ buze̱ Adamu e̱ Hawa du̱gu̱ me̱ tak-u̱ Idin, se̱ wa wu̱' e̱ke̱n a-to̱mu̱ wa i na foge̱ ke̱ro̱bin u̱r-'e u̱r-kot u-van ne̱ yu̱ o̱ m-re̱ sha-mu̱ u-ra m-baku̱t ne̱, u̱ gas-u̱ u-do̱m e̱ no̱m u̱r-'e u̱ fu̱n-yu̱ cwadu̱ be-du̱ te-yu̱ u̱r-fat.<verse eid="GEN 3:24"/></para>
  <chapter eid="GEN 3"/>
  <chapter number="4" style="c" sid="GEN 4"/>
  <para style="s1">Kayinu e̱ E̱be̱r</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1"/>Adamu roogte̱ u̱ ne̱ta wa ne̱ Hawa, wa nom u̱t-me̱n, wa mu̱t Kayinu. Hawa zu̱, &lt;&lt;U̱m kwu̱mu̱g ya-du̱ u̱r-campa, remu̱ se̱ge̱-u̱r Yawe.&gt;&gt; <verse eid="GEN 4:1"/><verse number="2" style="v" sid="GEN 4:2"/>Hawa mu̱t tu̱msu̱ hu̱no̱-u wa, wa te̱'e̱ wa u̱r-dim Habira.</para>
  <para style="p" vid="GEN 4:2">Habira shu̱'u̱t wa-gwat-du̱ ban-du̱ u̱t-bisa, Kayinu shu̱'u̱t wa-u̱r-to̱m. <verse eid="GEN 4:2"/><verse number="3" style="v" sid="GEN 4:3"/>U̱ te̱k-u̱ da-u o̱ Kayinu haatu̱n nya-u̱ no̱m-tu̱ u̱r-to̱mu̱ wa u̱ du̱ Yawe.<verse eid="GEN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 4:4"/>Tu̱msu̱ Habira haatu̱n mat-tu̱ u̱r-taku̱n u̱ te̱k-u̱ ban-du̱ bisa-u̱t wa tu̱ se̱me̱, Yawe ku̱b nya-u Habira, Habira kum hyu̱-m pus-mo̱ u̱ nya-u̱ wa haatu̱n. <verse eid="GEN 4:4"/><verse number="5" style="v" sid="GEN 4:5"/>Se̱di Yawe o̱nkte̱ Kayinu u̱ nya-u wa no̱me̱ ne̱ da, se̱ Kayinu hog u̱s-ryab sok, wa naas u-shu̱.<verse eid="GEN 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 4:6"/>Ku̱na Yawe zu̱tte̱ Kayinu, &lt;&lt;¿Yan-o̱ wa'e̱ jab-u̱ ró nu̱u̱t? ¿Yan-o̱ wa'e̱ bo̱ naaste̱ u-shu̱? <verse eid="GEN 4:6"/><verse number="7" style="v" sid="GEN 4:7"/>Me̱ kabu̱ nya-u ró, a-bo̱ no̱me̱ no̱m-tu̱ u-ho̱n-ho̱n. Ba'as-tu̱ ya u̱r-e' u̱ bo̱n-du̱ is, a-bo̱ gu̱gme̱ no̱m-du̱ no̱m-tu̱ u-ho̱n-ho̱n; to̱ o̱ u̱t-sa to̱ ship bo̱. Se̱ bo̱ ze̱k be̱b-du̱ to̱.&gt;&gt;<verse eid="GEN 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8"/>U̱ te̱k-u̱ da-u o̱ Kayinu zu̱ du̱-fade̱ wa Habira, &lt;&lt;Haane̱ in cwa u̱r-do̱g.&gt;&gt; Da-u̱ e̱ o̱ u̱r-do̱g, Kayinu ku̱t du̱-fade̱ wa Habira se̱ wa ho wa.<verse eid="GEN 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9"/>Da-u̱ waase̱, Yawe zu̱ Kayinu, &lt;&lt;¿Du̱-fade̱ ró Habira yu̱?&gt;&gt;</para>
  <para style="p" vid="GEN 4:9">Wa shu̱s wa zu̱, &lt;&lt;U̱m nak da! ¿Me̱ wa o̱ wa-gwat-du̱ du̱-fade̱ ri?&gt;&gt;<verse eid="GEN 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10"/>Yawe zu̱, &lt;&lt;¿Yan o̱ bo̱ no̱me̱ inya? Hyu̱-mu̱ du̱-fade̱ ró no̱ng u̱s-kan du̱gu̱ u-dak u̱ haan u̱du̱ ri! <verse eid="GEN 4:10"/><verse number="11" style="v" sid="GEN 4:11"/>U̱ da-o̱, bo̱ o̱ nu-u yo̱-o̱ ne̱ tu̱msu̱ u̱m de̱ bu̱z-du̱ bo̱ du̱gu̱ u-dak, u̱ upse̱ u-nu o̱ so hyu̱-mu̱ du̱-fade̱ ró du̱gu̱ kom-u̱t ró. <verse eid="GEN 4:11"/><verse number="12" style="v" sid="GEN 4:12"/>Da-u̱ bo̱ no̱me̱ u̱r-to̱m bo̱ za kwu̱m-du̱ no̱m-tu̱ u̱r-to̱m da, bo̱ de̱ u̱t-shu̱'u̱t wa-za u̱r-hure̱ wa riig-tu̱ m-zan u-dak.&gt;&gt;<verse eid="GEN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13"/>Se̱ Kayinu zu̱ Yawe, &lt;&lt;kwu̱p-du̱ u̱s-rem ri, ze̱k be̱b-u̱r ri. <verse eid="GEN 4:13"/><verse number="14" style="v" sid="GEN 4:14"/>Bo̱ yanu̱g me̱ du̱gu̱ u-dak, tu̱msu̱ du̱gu̱ shu̱ ró, tu̱msu̱ u̱m de̱ u̱t-shu̱'u̱t wa-za u̱r-hure̱ u̱ riig-tu̱ m-zan u-dak. Tu̱msu̱ ko̱wana hyane̱ me̱ wa de̱ ho̱-du̱ me̱.&gt;&gt;<verse eid="GEN 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15"/>Tu̱msu̱ Yawe zu̱ wu̱n, &lt;&lt;Iya-o̱ da! Ko̱wana ho̱ bo̱, u̱m de̱ to̱p-u̱ bo̱ u̱r-mag u-u̱so u-ta'er.&gt;&gt; Se̱ Yawe wa'-u̱ Kayinu u̱s-nap su̱ u̱t-him remu̱ u̱zu̱ ko̱wana hyanu̱ wa, wa za ho̱ wa da. <verse eid="GEN 4:15"/><verse number="16" style="v" sid="GEN 4:16"/>Kayinu yu̱ne̱ wa aru̱k du̱gu̱-du̱ Yawe, wa do̱'e̱ wa shu̱'u̱t u̱ dak-u̱ No̱d, u-dom u̱ Idin ne̱.<verse eid="GEN 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17"/>Kayinu roog u̱ ne̱ta wa ne̱, wa no̱m u̱t-me̱n se̱ wa mu̱t E̱no̱k. U̱ da-u o̱ Kayinu o̱ ma-du̱ o̱ko̱n bo̱-o̱, se̱ wa te̱'e̱ bo̱-u o̱ dim-du̱ zwar-u̱ wa E̱no̱k. <verse eid="GEN 4:17"/><verse number="18" style="v" sid="GEN 4:18"/>E̱no̱k o̱tte̱ zwar wu̱ na foge̱ Irad, tu̱msu̱ Irad wa mate̱ Mehujaye̱r, tu̱msu̱ Mehujaye̱r wa mate̱ Metushaye̱r, tu̱msu̱ Metushaye̱r wa mate̱ Rame̱k.<verse eid="GEN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 4:19"/>Rame̱k gaag ne̱ta-ne̱ yu̱r, wa u̱r-taku̱n na zu̱ wa Ada, wa-u-yu̱ru̱mse̱ na zu̱ wa Zira. <verse eid="GEN 4:19"/><verse number="20" style="v" sid="GEN 4:20"/>Ada wa mate̱ Jabar, wu̱na o̱ ne̱t u̱r-taku̱n wu̱ he̱e̱se̱ gwat-du̱ u̱t-bisa tu̱msu̱ wa yi u̱t-rimpa. <verse eid="GEN 4:20"/><verse number="21" style="v" sid="GEN 4:21"/>Dim-du̱ o̱r-u̱ wu̱n wa na zu̱ye̱ Jubar, wu̱na o̱ taku̱n-du̱ a o̱s-du̱ u-mo̱ro̱ u̱r-tu̱kku̱rma ne̱. <verse eid="GEN 4:21"/><verse number="22" style="v" sid="GEN 4:22"/>Zira wu̱ o̱ye̱ ne̱ta u-yu̱ru̱mse̱, wa mate̱ Tubar-Kayinu wa shu̱'u̱te̱ wu̱ tak-ne̱ m-ank u̱ kwam-tu̱ bu̱-mu̱ u-dak tu̱ shik tu̱ no̱m-du̱ to̱ko̱n no̱m-to̱ ne̱. Hu̱no-u̱ wa-ne̱ta Tubar-Kayinu dim-u̱r wa Naama.<verse eid="GEN 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23"/>De̱ku̱n ho̱-de̱ Ramek zu̱ ne̱ta-u̱t wa,</para>
  <para style="q1" vid="GEN 4:23">&lt;&lt;Ada e̱ Zira, ganu̱n u̱t-to̱ u̱du̱-ri,</para>
  <para style="q2" vid="GEN 4:23">ne̱ta-u̱t Rame̱k,</para>
  <para style="q1" vid="GEN 4:23">ho̱go̱n no̱m-u̱ u̱m de̱ waru̱ no̱.</para>
  <para style="q2" vid="GEN 4:23">U̱m ho̱o̱g wa'-u̱ zwar,</para>
  <para style="q1" vid="GEN 4:23">Remu̱ zu̱ wa zwargu̱n me̱</para>
  <para style="q2" vid="GEN 4:23">tu̱msu̱ wa ho̱nse̱ me̱.<verse eid="GEN 4:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 4:24"/>A mu̱ne̱ u̱zu̱ na ya'u̱ wu̱ ho̱ye̱ Kayinu</para>
  <para style="q2" vid="GEN 4:24">u̱r-ko̱b u-so u-ta'er,</para>
  <para style="q1" vid="GEN 4:24">ko̱wana ho̱ me̱,</para>
  <para style="q2" vid="GEN 4:24">wa de̱ swadu̱ u̱r-ko̱b u-so u̱t-shik u̱t-tu̱t</para>
  <para style="q2" vid="GEN 4:24">u̱ o̱p-u̱ ta'e̱r [77].&gt;&gt;<verse eid="GEN 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25"/>Adamu roog u̱ ne̱ta wa ne̱ tu̱msu̱. Hawa no̱m u̱t-me̱n, wa sur m-mat ya-du̱ u̱r-campa. Hawa te̱'e̱ wa u̱r-dim Se̱t.<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">No̱mu̱ na zu̱ye̱ dim-u̱r re̱ u-nya.</char></note> Wa zu̱, &lt;&lt;Ru̱-u̱ yaag me̱ de̱ku̱n ya-du̱ u̱r-campa de̱ u̱ swas-m Habira wu̱ Kayinu ho̱ye̱.&gt;&gt; <verse eid="GEN 4:25"/><verse number="26" style="v" sid="GEN 4:26"/>Da-u̱ Se̱t rogme̱ wa kum zwar wu̱ na zu̱ye̱ E̱no̱sh. U̱ da-u o̱ ne̱t-tu̱ he̱e̱se̱ no̱mu̱ dim-u̱r Yawe u̱t-huuk.<verse eid="GEN 4:26"/></para>
  <chapter eid="GEN 4"/>
  <chapter number="5" style="c" sid="GEN 5"/>
  <para style="s1">Yaag-u̱ Adamu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1"/>Tun-to̱ o̱ dim-tu̱ ya'ag-u̱ ko̱-u̱r Adamu.</para>
  <para style="p" vid="GEN 5:1">Da-u̱ Ru̱-u̱ no̱me̱ ne̱t, wa nom wa u̱ka sha-m wa. <verse eid="GEN 5:1"/><verse number="2" style="v" sid="GEN 5:2"/>Wa no̱mu̱g campa u̱ ne̱ta-ne̱, se̱ wa wa'-u̱ e̱ nu-u so̱-o̱. Da-u̱ wa no̱mu̱ u̱n, wa foge̱ &lt;&lt;u̱t-ne̱t.&gt;&gt;<verse eid="GEN 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 5:3"/>Da-u̱ Adamu no̱me̱ u̱r-yu̱ u̱s-hak u-ko̱k u-gan u̱r-shik u̱ o̱p [130], wa kum zwar wu̱ o̱tte̱ sha-m wa, u̱-me̱ ryu̱n-u wa u̱ sha-m wa; tu̱msu̱ wa te̱'e̱ wa u̱r-dim Se̱t. <verse eid="GEN 5:3"/><verse number="4" style="v" sid="GEN 5:4"/>Ba Adamu mate̱ Se̱t, Adamu no̱m u̱r-yu̱ u̱s-hak u̱t-ko̱k u̱t-nas [800] u̱ te̱k-u̱ hak-su̱ u̱t-ko̱k u̱t-nas wa kum e̱ke̱n ya'ag-u̱ campa-ne̱ u̱ yaat u̱t-gwu̱p-ne̱. <verse eid="GEN 5:4"/><verse number="5" style="v" sid="GEN 5:5"/>Adamu no̱ng u̱r-yu̱ u̱s-hak u̱t-ko̱k u̱t-jwu̱u̱r u̱r-shik u̱ o̱p [930] se̱ wa mu̱ru̱s.<verse eid="GEN 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6"/>Da-u̱ Se̱t no̱me̱ u̱r-yu̱ u̱s-hak u̱t-shik u̱t-tan u̱s-tan [105], wa mu̱t E̱no̱sh. <verse eid="GEN 5:6"/><verse number="7" style="v" sid="GEN 5:7"/>Tu̱msu̱ ba wa mate̱ E̱no̱sh, Se̱t sur m-no̱m u̱r-yu̱ u̱s-hak u̱t-ko̱k u̱t-eer u̱s-ta'er [807] u̱ te̱k-u̱ hak-su̱ u̱t-ko̱k u̱t-nas u̱s-ta'er wa sur m-mat e̱ke̱n ya'ag-u̱ campa-ne̱ u̱ yaat u̱t-gwu̱p-ne̱. <verse eid="GEN 5:7"/><verse number="8" style="v" sid="GEN 5:8"/>Hak-su̱ Se̱t no̱me̱ se̱ o̱ u̱s-hak u̱t-ko̱k u̱t-jwu̱u̱r u̱ o̱p u̱s-yu̱r [912], se̱ wa mu̱ru̱s.<verse eid="GEN 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9"/>Da-u̱ E̱no̱sh no̱me̱ u̱r-yu̱ u̱s-hak u̱t-shik u̱t-nas u̱-o̱p [90], wa mu̱t zwar wu̱ na zu̱ye̱ Kenan. <verse eid="GEN 5:9"/><verse number="10" style="v" sid="GEN 5:10"/>Tu̱msu̱ ba wa mate̱ Kenan, E̱no̱sh sur m-no̱m u̱s-hak u̱t-ko̱k u̱t-eer u̱ o̱p u̱t-tan [815] u̱ te̱k-u̱ hak-su̱ u̱t-ko̱k u̱s-nas u̱ o̱p u̱s-tan wa mu̱t e̱ke̱n ya'ag-u̱ campa-ne̱ u̱ yaat u̱t-gwu̱p-ne̱. <verse eid="GEN 5:10"/><verse number="11" style="v" sid="GEN 5:11"/>Hak-u̱s E̱no̱sh su̱ wa nome̱ u̱s-be̱e̱t se̱ o̱ u̱s-hak u̱t-ko̱k u̱t-nas u̱ o̱p u̱s-tan [905], wa mu̱ru̱s.<verse eid="GEN 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12"/>Da-u̱ Kenan no̱me̱ u̱r-yu̱ u̱s-hak u̱t-shik u̱t-tu̱t u̱ o̱p [70] wa mu̱t Maharare̱r. <verse eid="GEN 5:12"/><verse number="13" style="v" sid="GEN 5:13"/>Ba wa mate̱ Maharare̱r, Kenan sur m-no̱m u̱s-hak u̱t-ko̱k u̱t-eer u̱ u̱t-shik u̱t-yu̱r [840], u̱ te̱k-u̱ hak-su̱ u̱t-ko̱k u̱t-nas u̱t-shik u̱t-yu̱r wa mu̱t e̱ke̱n ya'ag-u̱ campa-ne̱ u̱ yaat u̱t-gwu̱p-ne̱. <verse eid="GEN 5:13"/><verse number="14" style="v" sid="GEN 5:14"/>Hak-su̱ Kenan no̱me̱ se̱ o̱ u̱t-ko̱k u̱t-jwu̱u̱r u̱ u̱s-o̱p [910] se̱ wa mu̱ru̱s.<verse eid="GEN 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15"/>Da-u̱ Maharare̱r no̱me̱ u̱r-yu̱ u̱s-hak u̱t-shik u̱t-tu̱t u̱s-tan [65] wa mu̱t Jare̱d. <verse eid="GEN 5:15"/><verse number="16" style="v" sid="GEN 5:16"/>Ba Maharare̱r mate̱ Jare̱d, wa sur m-no̱m u̱s-hak u̱t-ko̱k u̱t-eer u̱r-shik-u̱ o̱p [830] u̱ te̱k-u̱ hak-su̱ u̱t-ko̱k u̱t-nas u̱ u̱r-shik-u̱ o̱p wa mu̱t e̱ke̱n ya'ag-u̱ campa-ne̱ u̱ yaat u̱t-gwu̱p-ne̱. <verse eid="GEN 5:16"/><verse number="17" style="v" sid="GEN 5:17"/>Hak-su̱ Maharare̱r no̱me̱ se̱ o̱ u̱t-ko̱k u̱t-eer u̱ u̱t-shik u̱t-nas u̱ o̱p u̱s-tan [895], se̱ wa mu̱ru̱s.<verse eid="GEN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18"/>Da-u̱ Jare̱d no̱me̱ u̱r-yu̱ u̱s-hak u-ko̱k u-gan u̱t-shik u̱t-tu̱t u̱s-yu̱r [162], wa mu̱t E̱no̱k. <verse eid="GEN 5:18"/><verse number="19" style="v" sid="GEN 5:19"/>Tu̱msu̱ ba Jare̱d mate̱ E̱no̱k, wa sur m-no̱m u̱s-hak u̱t-ko̱k u̱t-eer [800] u̱ te̱k-u̱ hak-su̱ u̱t-nas wa mu̱t e̱ke̱n ya'ag-u̱ campa-ne̱ u̱ yaat u̱t-gwu̱p-ne̱. <verse eid="GEN 5:19"/><verse number="20" style="v" sid="GEN 5:20"/>Hak-u̱s Jare̱d su̱ wa no̱me̱ se̱ o̱ u̱t-ko̱k u̱t-jwu̱u̱r u̱t-shik u̱t-tu̱t u̱s-yu̱r [962], se̱ wa mu̱ru̱s.<verse eid="GEN 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21"/>Da-u̱ E̱no̱k no̱me̱ u̱r-yu̱ u̱s-hak u̱t-shik u̱t-tu̱t u̱s-tan [65] wa mu̱t Me̱tuse̱ra. <verse eid="GEN 5:21"/><verse number="22" style="v" sid="GEN 5:22"/>Tu̱msu̱ ba wa mate̱ Me̱tuse̱ra, E̱no̱k no̱m u̱s-hak u̱t-ko̱k u̱t-tu̱t [300], wa no̱ng m-ha u̱r-kot u-Ru̱-ne̱, tu̱msu̱ wa sur m-mat e̱ke̱n ya'ag-u̱ campa-ne̱ u̱ yaat u̱t-gwu̱p-ne̱. <verse eid="GEN 5:22"/><verse number="23" style="v" sid="GEN 5:23"/>Hak-su̱ E̱no̱k no̱me̱ se̱ o̱ u̱t-ko̱k u̱t-tu̱t u̱t-shik u̱t-tu̱t u̱s-tan [365]. <verse eid="GEN 5:23"/><verse number="24" style="v" sid="GEN 5:24"/>E̱no̱k no̱ng m-ha u̱r-kot u-Ru̱-ne̱, se̱ Ru̱-u̱ ku̱b wu̱n, wa umus wu̱n m-da u-ru̱.<verse eid="GEN 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25"/>Da-u̱ Me̱tuse̱ra no̱me̱ u̱r-yu̱ u̱s-hak u-ko̱k u-gan u̱t-shik u̱t-nas u̱s-ta'e̱r [187], se̱ wa mu̱t Rame̱k. <verse eid="GEN 5:25"/><verse number="26" style="v" sid="GEN 5:26"/>Tu̱msu̱ ba wa mate̱ Rame̱k, Me̱tuse̱ra sur m-no̱m u̱s-hak u̱t-ko̱k u̱t-ta'er u̱t-shik u̱t-nas u̱t-yu̱r [782], u̱ te̱k-u̱ hak-su̱ u̱t-ko̱k u̱t-ta'er u̱t-shik u̱t-nas u̱t-yu̱r wa mu̱t e̱ke̱n ya'ag-u̱ campa-ne̱ u̱ yaat u̱t-gwu̱p-ne̱. <verse eid="GEN 5:26"/><verse number="27" style="v" sid="GEN 5:27"/>Hak-su̱ Me̱tuse̱ra no̱me̱ u̱s-be̱e̱t se̱ o̱ u̱s-hak u̱t-ko̱k u̱t-jwu̱u̱r u̱t-shik u̱t-tu̱t u̱s-jwu̱u̱r [969], se̱ wa mu̱ru̱s.<verse eid="GEN 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28"/>Da-u̱ Rame̱k no̱me̱ u̱s-hak u-ko̱k u-gan u̱t-shik u̱t-nas u̱s-yu̱r [182], se̱ wa mu̱t ya-du̱ u̱r-campa. <verse eid="GEN 5:28"/><verse number="29" style="v" sid="GEN 5:29"/>Rame̱k te̱'e̱ wa u̱r-dim Nuhu, wa zu̱, &lt;&lt;Yage̱ unwa hatu̱n it ru̱s-du̱ jab du̱gu̱ pama-u swadu̱ u̱r-ko̱b-u̱ it u̱ remu̱ ank-mu̱ u̱t-kom mu̱ it ne̱ u̱ dak-u̱ Yawe wa'e̱ nu-u yo̱-o̱.&gt;&gt; <verse eid="GEN 5:29"/><verse number="30" style="v" sid="GEN 5:30"/>Ba Rame̱k mate̱ Nuhu, Rame̱k no̱m u̱s-hak u̱t-ko̱k u̱t-tan u̱t-shik u̱t-nas u̱ o̱p u̱s-tan [595], u̱ te̱k-u̱ hak-su̱ u̱t-ko̱k u̱t-tan u̱t-shik u̱t-nas u̱ o̱p u̱s-tan wa mu̱t e̱ke̱n ya'ag-u̱ campa-ne̱ u̱ yaat u̱t-gwu̱p-ne̱. <verse eid="GEN 5:30"/><verse number="31" style="v" sid="GEN 5:31"/>Hak-su̱ Rame̱k no̱me̱ u̱s-be̱e̱t se̱ o̱ u̱s-hak u̱t-ko̱k u̱t-ta'er u̱t-shik u̱t-tu̱t u̱ o̱p-u̱s ta'er [777], se̱ wa mu̱ru̱s.<verse eid="GEN 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32"/>Ba Nuhu no̱me̱ u̱s-hak u̱t-ko̱k u̱t-tan [500], se̱ wa mu̱t She̱m, Ham, u̱ Jape̱t ne̱.<verse eid="GEN 5:32"/></para>
  <chapter eid="GEN 5"/>
  <chapter number="6" style="c" sid="GEN 6"/>
  <para style="s1">Me̱n-u̱t jas-to̱ tu̱ ne̱t-ne̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1"/>Se̱ ne̱t-ne̱ he̱e̱se̱ u̱t-no̱m u-tát u-dak, tu̱msu̱ na matu̱ u̱n ya-u̱t-gwu̱p. <verse eid="GEN 6:1"/><verse number="2" style="v" sid="GEN 6:2"/>Se̱ to̱ko̱n yar-tu̱ m-mya tu̱ do̱m u-ru̱ hyen ya-u̱t-gwu̱p u̱t-ne̱t o̱ so̱-ye̱ so̱k, tu̱msu̱ u̱n gaan ya-u̱t-gwu̱p i he̱ u̱n u̱ jab. <verse eid="GEN 6:2"/><verse number="3" style="v" sid="GEN 6:3"/>Yawe zu̱, &lt;&lt;Yar-u ri zaru̱ u̱t-shu̱'u̱t u̱-me̱ ne̱t m-mo̱mmo̱ da, remu̱ zu̱ war-tu̱ m-mar to̱ u̱n o̱tte̱. Se̱di u̱ ane̱ u-shu̱, hak-u̱s wa zaar u̱t-ze̱g u-ko̱k u-gan u̱r-shik [120].&gt;&gt;<verse eid="GEN 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 6:4"/>U̱ da-u o̱, tu̱msu̱ da tase̱, to̱ko̱n ne̱t-to̱ o̱ró be̱b-ne̱ i na zu̱ye̱ &lt;&lt;Nepirim.&gt;&gt; E̱ o̱ u̱r-yu̱ u-dak, da-u̱ to̱ko̱n yar-tu̱ m-mya tu̱ do̱m u-ru̱ rooge̱ u̱ ya'at u̱t-gwu̱p u̱ ne̱t-ne̱, se̱ e̱ matu̱ e̱ yaag. E̱ shu̱'u̱te̱ campa-ne̱ tu̱msu̱ be̱b-ne̱ i na o̱ m-ho̱g u̱ e̱ ne̱ i da-u̱ dim.<verse eid="GEN 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5"/>Se̱ Yawe hyen jab-u̱ yo̱-o̱ ne̱t no̱ng u-tát u-dak, dorog-su̱ jab-u̱ wa u̱s-be̱e̱t o̱ko̱n zarra se̱ no̱m-u̱t yo̱-to̱ u-da u-be̱e̱t. <verse eid="GEN 6:5"/><verse number="6" style="v" sid="GEN 6:6"/>Yawe nom namu̱ jab sok u̱ wa nomte̱ ne̱t u-dak, tu̱msu̱ wa shi u̱ remu̱ jab. <verse eid="GEN 6:6"/><verse number="7" style="v" sid="GEN 6:7"/>Se̱ Yawe zu̱, &lt;&lt;Me̱ hastu̱ u̱t-ne̱t u̱t-be̱e̱t tu̱ u̱m no̱me̱, du̱gu̱ me̱ u-dak, ne̱t-ne̱, u̱t-bisa ne̱ u̱ no̱m-tu̱ o̱o̱ge̱ u̱t-kurup ne̱, u̱ no ne̱ e̱ o̱ u̱t-riig u̱-do̱m u-ru̱, remu̱ jab naag me̱ u̱m no̱m-tu̱ e̱.&gt;&gt; <verse eid="GEN 6:7"/><verse number="8" style="v" sid="GEN 6:8"/>Se̱di Nuhu kwu̱mu̱g hyu̱-m pusmo̱ u̱du̱ Yawe.<verse eid="GEN 6:8"/></para>
  <para style="s1">Nuhu</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9"/>Tun-to̱ o̱o̱ge̱ ogor-tu̱ ko̱-u̱r Nuhu.</para>
  <para style="p" vid="GEN 6:9">Nuhu ne̱t-u̱ gye̱r u-Ru̱ wa, wa zatte̱ u̱r-pyap u̱ ne̱t-tu̱ da-u wa da. Tu̱msu̱ wa no̱ng m-ha u̱r-kot u-Ru̱-ne̱. <verse eid="GEN 6:9"/><verse number="10" style="v" sid="GEN 6:10"/>Nuhu mak-u̱t ya'ag-u̱ campa-ne̱ tu̱t: She̱m u̱ Ham u̱ Jape̱t ne̱.<verse eid="GEN 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 6:11"/>Se̱di Ru̱-u̱ hyen u̱zu̱ ne̱t-tu̱ u-dak u̱ naag tu̱msu̱ o̱ shu̱g u̱ yu̱nu̱s-du̱ jab ne̱. <verse eid="GEN 6:11"/><verse number="12" style="v" sid="GEN 6:12"/>Ru̱-u̱ hyen u̱ka dak-u̱ nu̱u̱te, ne̱t-tu̱ u-dak u̱t-be̱e̱t e̱ naag u̱ yu̱u̱r e̱. <verse eid="GEN 6:12"/><verse number="13" style="v" sid="GEN 6:13"/>Ru̱-u̱ zu̱ Nuhu, &lt;&lt;U̱m no̱ng u̱s-dorog u̱zu̱ me̱ ho̱ru̱ssu̱ u̱t-ne̱t u̱t-be̱e̱t, remu̱ zu̱ u̱n shu̱u̱ste̱ u-dak u̱ jab-u̱s yo̱-se̱ ne̱. Iya o̱ hen, u̱m de̱ ho̱ru̱ssu̱ u̱n be̱e̱t u-dak-ne̱! <verse eid="GEN 6:13"/><verse number="14" style="v" sid="GEN 6:14"/>De̱'e̱ bo̱ no̱mu̱ hi-u̱r ró u-hat u̱ u̱t-bak tu̱ te-yu̱ u-jarin. Bo̱ no̱m u̱t-kur tu̱msu̱ bo̱ rake̱ o̱ dap-mu̱ u-te, u̱-do̱ ne̱. <verse eid="GEN 6:14"/><verse number="15" style="v" sid="GEN 6:15"/>Ka bo̱ do̱te̱ u̱ no̱m-du̱ hat-u ya: wu̱r-mu̱ hat-u ya do̱'e̱ u̱t-shu̱'u̱t u̱s-na u̱t-ko̱k u̱t-nas u̱t-shik u̱t-yu̱r o̱p [450], bo̱ no̱m m-hu̱k u̱s-na u̱t-shik u̱t-tu̱t u̱ o̱p u̱s-tan [75], tu̱msu̱ ja-mu̱ shu̱'u̱t u̱s-na u̱t-shik u̱t-yu̱r u̱ u̱s-tan [45]. <verse eid="GEN 6:15"/><verse number="16" style="v" sid="GEN 6:16"/>Bo̱ no̱mu̱ hat-u ya u̱r-byam, bo̱ yage̱ u-na u-gan u̱r-mo̱t du̱gu̱ do̱m. Se̱ bo̱ no̱m u-is u̱-me̱ gas-yu̱ u-hat. Bo̱ no̱m ya u̱t-kur u̱t-tu̱t ko̱-u̱-he̱ do̱m-u̱ o̱ru̱ wa. <verse eid="GEN 6:16"/><verse number="17" style="v" sid="GEN 6:17"/>Gwat! U̱m do̱'e̱ tage̱ du̱ u-dak u̱ bu̱-mu̱ do̱'e̱ re̱-du̱ u-dak, mu̱ do̱'e̱ ho̱ru̱sse̱ no̱m-tu̱ u̱r-fat u̱t-be̱e̱t tu̱ u̱s-vu̱'e̱. Ko̱-uyan u-dak o̱ do̱'e̱ u̱t-mar. <verse eid="GEN 6:17"/><verse number="18" style="v" sid="GEN 6:18"/>Se̱di u̱m de̱ este̱du̱ u̱s-rem ri u̱ bo̱ ne̱, tu̱msu̱ bo̱ de̱ cwadu̱ u-hat, bo̱ u̱ ya'ag-u̱ ró ne̱ u̱ ne̱ta ró ne̱ u̱ ne̱ta-tu̱ ya'ag-u̱ ró ne̱ u̱r-kot u̱ bo̱ ne̱. <verse eid="GEN 6:18"/><verse number="19" style="v" sid="GEN 6:19"/>Tu̱msu̱ u̱m o̱ u̱t-sa u̱m guu ko̱yu̱he̱ go̱-tu̱ no̱m-tu̱ na no̱me̱ u̱t-be̱e̱t. Remu̱ iya se̱ bo̱ haatu̱n yu̱r u̱-me̱ no̱m-tu̱ u̱r-fat u̱t-be̱e̱t, u-so̱ u̱ u-gob ne̱ u̱ no̱mu̱ o̱o̱ge̱ u̱t-kurup ne̱ u-dak, u̱-me̱ u-hat u̱r-kot u̱ bo̱ ne̱, ko̱ e̱ u̱t-kwu̱s u̱r-fat. <verse eid="GEN 6:19"/><verse number="20" style="v" sid="GEN 6:20"/>Kab yu̱r u̱ te̱k-u̱ go̱-tu̱ ko̱yu̱he̱ bisa ya m-cwa u̱-me̱ u-hat u-so̱ u̱ u-gob ne̱ tu̱msu̱ ko̱yu̱he̱ no ya ne̱, ko̱ e̱ u̱t-kwu̱s u̱r-fat. <verse eid="GEN 6:20"/><verse number="21" style="v" sid="GEN 6:21"/>Bo̱ do̱'e̱ u̱ kab-du̱ go̱-du̱ no̱m-tu̱ u̱t-re̱ u̱ do̱'e̱ ko̱ru̱ bo̱ u̱t-be̱e̱t u̱ ne̱t-tu̱ u-bu ró ne̱ u̱ no̱m-tu̱ u̱r-fat ne̱ u̱t-be̱e̱t.&gt;&gt;<verse eid="GEN 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 6:22"/>Nuhu no̱m ko-uyan u̱ka Ru̱-u̱ zu̱tte̱ wa no̱m u-be̱e̱t.<verse eid="GEN 6:22"/></para>
  <chapter eid="GEN 6"/>
  <chapter number="7" style="c" sid="GEN 7"/>
  <para style="s1">Bu̱-mu̱ taku̱ste̱ u-dak</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1"/>Se̱ Yawe zu̱ Nuhu, &lt;&lt;Cwa u-hat, bo̱ u̱ bu-u̱ ró ne̱ be̱e̱t, remu̱ zu̱ u̱m hyanu̱g bo̱ wa jab-u̱ so̱-o̱ wa u̱-me̱ ne̱t-tu̱ uno̱ da-o̱. <verse eid="GEN 7:1"/><verse number="2" style="v" sid="GEN 7:2"/>Bisa-tu̱ u-he̱n u̱t-be̱e̱t, kab kag ta'er u̱ so̱ ne̱ ta'er du̱gu̱ ko̱du̱he̱ go̱-de̱. Bisa-tu̱ za u-he̱n u̱t-be̱e̱t, kab u-kag u-gan u̱ so̱ ne̱ u-gan du̱gu̱ ko̱du̱he̱ go̱-de̱.<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">bisa-tu̱ u-he̱n to̱ o̱o̱ge̱ no̱m-tu̱ na ya-e̱ Yahuda-ne̱ ke̱rru̱ u̱t-tu̱, bisa-tu̱ za u-he̱n to̱ o̱o̱ge̱ tu̱ na hose̱ u̱t-tu̱.</char></note> <verse eid="GEN 7:2"/><verse number="3" style="v" sid="GEN 7:3"/>Go̱-tu̱ no u̱t-be̱e̱t, kab kag ta'er u̱ ro̱b ne̱ ta'er, u̱ remu̱ go̱-u̱t e̱ reet u-shu̱ u̱r-yu̱ ne̱ da-u̱ bu̱-mu̱ re̱-du̱ u-dak arke̱. <verse eid="GEN 7:3"/><verse number="4" style="v" sid="GEN 7:4"/>Kwu̱ku̱s m-roog u̱t-ta'er du̱gu̱ da-o̱, u̱m do̱'e̱ kasnu̱ u-yu̱ u̱ re̱-du̱ u-dak u̱t-ho̱ u̱t-shik u̱t-yu̱r [40] m-gye̱p ne̱ u̱t-ho̱ u̱t-shik u̱t-yu̱r [40], har se̱ u̱m haste̱ no̱m-tu̱ u̱r-fat tu̱ u̱m no̱me̱ u-dak u-be̱e̱t.&gt;&gt;<verse eid="GEN 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 7:5"/>Se̱ Nuhu no̱m ko̱-uyan u̱ka Yawe zu̱tte̱ wa no̱m.<verse eid="GEN 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6"/>U̱ da-u o̱ Nuhu o̱o̱g u̱s-hak u̱t-ko̱k u̱t-shishin [600] da-u̱ bu̱-mu̱ takse̱ u-dak. <verse eid="GEN 7:6"/><verse number="7" style="v" sid="GEN 7:7"/>Tu̱msu̱ Nuhu, u̱ ya'ag-u̱ wane̱, u̱ ne̱ta wa ne̱, u̱ ne̱ta-tu̱ ya'ag-u̱ wa ne̱, e̱ to u-hat remu̱ e̱ poste̱ bu̱-mu̱ do̱'e̱ re̱-du̱ u-dak. <verse eid="GEN 7:7"/><verse number="8-9" style="v" sid="GEN 7:8-9"/>U̱ dame̱ ya-ubu Nuhu ne̱, bisa-tu̱ to u-me̱ u-hat: u̱t-bisa u̱t-go̱ u̱t-go̱ tu̱ u-he̱n u̱ tu̱ za u-he̱n ne̱, u̱ go̱-tu̱ no ne̱ u̱ no̱mu̱ ho̱g ne̱ i o̱ u̱t-riig u-dak. E̱ to u-hat u-so̱ u̱ u-gob ne̱ yu̱r yu̱r ka Ru̱-u̱ zu̱tte̱ Nuhu. <verse eid="GEN 7:8-9"/><verse number="10" style="v" sid="GEN 7:10"/>Da-u̱ roog-mu̱ u̱t-ta'er no̱me̱, se̱ bu̱-mu̱ re̱-du̱ u-dak haan mo̱ taku̱s u-dak.<verse eid="GEN 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11"/>Da-u̱ Nuhu o̱ u̱s-hak u̱t-ko̱k u̱t-shishin [600], u̱ ho̱-du̱ o̱p u̱t-ta'er [17] u̱ pyaat-yu̱ u-yu̱r, bu̱-mu̱ ta u-dak mo̱ bo̱ko̱n du̱gu̱ me̱ u-dak, na nom yu̱-u̱ u̱t-tu̱ru̱m so̱k du̱gu̱ do̱m u-ru̱. <verse eid="GEN 7:11"/><verse number="12" style="v" sid="GEN 7:12"/>Yu̱-u̱ re u-shu̱ u̱r-rob ne̱ m-te u̱t-ho̱ u̱t-shik u̱t-yu̱r [40] u̱ m-gyu̱p ne̱.<verse eid="GEN 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 7:13"/>U̱ gandi ho̱-u̱r re̱ de̱ Nuhu to u-hat, u̱r-kot u̱ ya'ag-u̱ wa ne̱ She̱m, Ham, u̱ Jape̱t ne̱, u̱r-kot u̱ ne̱ta wa ne̱ u̱ ne̱ta-tu̱ ya'ag-u̱ wa ne̱ tu̱t. <verse eid="GEN 7:13"/><verse number="14" style="v" sid="GEN 7:14"/>U̱n to u-hat u̱ ko̱-uyan go̱-du̱ u̱t-bisa tu̱ u-bu, u̱ ko̱-uyan bisa-tu̱ u̱r-do̱g ne̱ tu̱ o̱ u̱t-riig u-dak kowan u̱ du̱ wa go̱de̱, u̱ ko̱-uyan bisa-tu̱ u̱t-kurup ne̱ u̱r-kot, u̱ no ne̱ u̱t-go̱ u̱t-go̱. <verse eid="GEN 7:14"/><verse number="15" style="v" sid="GEN 7:15"/>No̱m u̱r-fat i ko̱-uyan go̱-de̱ e̱ haan u̱du̱ Nuhu u-kag u-so̱ ne̱ e̱ to u-hat. <verse eid="GEN 7:15"/><verse number="16" style="v" sid="GEN 7:16"/>Campa u̱ ne̱ta-ne̱ u̱ go̱-tu̱ u̱t-bisa ne̱ u̱t-be̱e̱t e̱ to u-hat u̱ka Ru̱-u̱ zu̱tte̱ Nuhu. Se̱ Yawe tage̱ u-is yu̱ u-hat u̱-dim.<verse eid="GEN 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17"/>M-roog u̱t-shik u̱t-yu̱r [40] na o̱ u̱ rob-du̱ u-yu̱ u-dak, bu̱-mu̱ hu̱ swu̱ru̱n, mo̱ hu̱ jak-su̱ u-hat du̱gu̱ u-dak m-da u-ru̱. <verse eid="GEN 7:17"/><verse number="18" style="v" sid="GEN 7:18"/>Se̱ bu̱-mu̱ sur m-no̱m u-tát mo̱ no̱m m-ja so̱k du̱gu̱ u-dak, hat-yu̱ hu̱ u̱t-riig u̱-do̱m m-bu̱. <verse eid="GEN 7:18"/><verse number="19" style="v" sid="GEN 7:19"/>M-vaste̱ bu̱-mu̱ taku̱s m-ha ro̱r-tu̱ zu̱ge̱ m-ja u̱t-be̱e̱t u-dak. <verse eid="GEN 7:19"/><verse number="20" style="v" sid="GEN 7:20"/>Bu̱-mu̱ nom m-ja mo̱ pu̱s ja-mu̱ u̱t-ro̱r m-te u̱s-na u̱r-shik [20], tu̱msu̱ mo̱ taku̱s u̱t-ro̱r u̱t-be̱e̱t. <verse eid="GEN 7:20"/><verse number="21" style="v" sid="GEN 7:21"/>No̱m-tu̱ u̱r-fat u̱t-be̱e̱t tu̱ o̱o̱ge̱ u-dak to̱ mu̱ru̱s. E̱ mu̱ru̱mu̱ste̱ be̱e̱t: u̱ no ne̱, u̱ bisa-tu̱ u-bu ne̱, u̱ bisa-tu̱ u̱r-do̱g ne̱, u̱ no̱m-tu̱ u̱r-fat tu̱ re̱k-to̱ u̱ i o̱o̱ge̱ u̱t-riig u-dak, u̱ ne̱t-ne̱ u̱t-be̱e̱t. <verse eid="GEN 7:21"/><verse number="22" style="v" sid="GEN 7:22"/>No̱m-tu̱ u̱r-fat u̱t-be̱e̱t, e̱ mu̱rmu̱sse̱, tu̱ nome̱ u̱s-vu̱'e̱ i o̱o̱ge̱ u̱t-riig u̱ dak-u gagu̱n. <verse eid="GEN 7:22"/><verse number="23" style="v" sid="GEN 7:23"/>Ru̱-u̱ hast no̱m-tu̱ o̱o̱ge̱ u-dak u̱t-be̱e̱t, ne̱t-ne̱ u̱t-bisa ne̱ u̱ no̱m u̱r-fat ne̱ i o̱ u̱t-riig u-dak u̱ no do̱m u-ru̱ ne̱ be̱e̱t na hast e̱ du̱gu̱ me̱ u-dak. Nuhu wa Ru̱-u̱ yage̱ u̱ i o̱ u̱r-kot u̱ wa ne̱ u-hat.<verse eid="GEN 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 7:24"/>Bu̱-mu̱ re̱-du̱ u-dak mo̱ rees u-dak m-te m-roog u-ko̱k u-gan u̱ roog-mu̱ u̱r-shik u̱t-yu̱r u̱ o̱p [150].<verse eid="GEN 7:24"/></para>
  <chapter eid="GEN 7"/>
  <chapter number="8" style="c" sid="GEN 8"/>
  <para style="s1">Bu̱-mu̱ re̱-du̱ u-dak <optbreak/> he̱e̱ste̱ u̱r-aru̱k</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1"/>Se̱di Ru̱-u̱ baku̱ste̱ Nuhu u̱ bisa-tu̱ u̱r-do̱g ne̱ u̱t-be̱e̱t u̱ bisa-tu̱ u-bu ne̱, tu̱ o̱o̱ge̱ u̱r-kot u̱ wa ne̱ u-hat. Se̱ wa yagne̱ m-mya u-dak, tu̱msu̱ bu̱-mu̱ hu̱b. <verse eid="GEN 8:1"/><verse number="2" style="v" sid="GEN 8:2"/>Se̱ Ru̱-u̱ wu̱ bu̱-mu̱ u-dak yage̱ u̱r-rwu̱n, tu̱msu̱ wa wu̱ bu̱-mu̱ do̱m u-ru̱ yage̱ u̱r-rob. <verse eid="GEN 8:2"/><verse number="3" style="v" sid="GEN 8:3"/>Se̱ bu̱-mu̱ he̱e̱se̱ u̱t-hab u-dak cashi cashi, da-u̱ roog-mu̱ u̱t-shik u̱t-ta'er u̱ o̱p [150] arke̱, se̱ bu̱-mu̱ hu̱b m-cu̱m. <verse eid="GEN 8:3"/><verse number="4" style="v" sid="GEN 8:4"/>Tu̱msu̱ u̱ ho̱-du̱ o̱p u̱t-ta'er [17] u̱ pyat-yu̱ u-ta'er se̱ hat-yu̱ ees u̱ do̱m-u̱ ro̱r-tu̱ Ararat. <verse eid="GEN 8:4"/><verse number="5" style="v" sid="GEN 8:5"/>Bu̱-mu̱ re̱ u-shu̱ m-hab m-te taku̱n-du̱ pyat-yu̱ u-o̱p, u̱ taku̱n-du̱ pyat-u ya, do̱s-tu̱ u̱t-ro̱r rwu̱u̱n u̱-do̱.<verse eid="GEN 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6"/>Da-u̱ to̱ku̱n ho̱-to̱ u̱t-shik u̱t-yu̱r [40] arke̱, Nuhu upus pyam-yu̱ wa no̱me̱ u-hat. <verse eid="GEN 8:6"/><verse number="7" style="v" sid="GEN 8:7"/>Se̱ wa tom u-ryag, se̱ ya hu̱ u̱t-riig ya hu̱ pam-du̱ u̱t-kap u-dim u-shu̱ ne̱ se̱ da bu̱-mu̱ hose̱ du̱gu̱ u-dak. <verse eid="GEN 8:7"/><verse number="8" style="v" sid="GEN 8:8"/>Tu̱msu̱ wa tom u̱r-gorop u̱ de̱ hyan u̱zu̱ bu̱-mu̱ hab-u̱g ko̱ de̱ hyanu̱ gagu̱n u-dak. <verse eid="GEN 8:8"/><verse number="9" style="v" sid="GEN 8:9"/>Se̱di gorop-du̱ kwu̱mu̱g be-du̱ u̱r-ju̱z da remu̱ zu̱ bu̱-mu̱ taku̱ste̱ u-dak, se̱ de̱ barmu̱n u-hat. Tu̱msu̱ se̱ Nuhu nu̱b u-kom wa maas de̱ wa muut de̱ u̱ me̱n-tu̱ u-hat. <verse eid="GEN 8:9"/><verse number="10" style="v" sid="GEN 8:10"/>Wa sur m-e̱ste̱ m-roog u̱t-ta'er se̱ wa sur m-to̱m u̱r-gorop du̱gu̱ u-hat. <verse eid="GEN 8:10"/><verse number="11" style="v" sid="GEN 8:11"/>Da-u̱ gorop-du̱ mu̱u̱ne̱ u̱du̱ wu̱n m-rim, se̱ wa mu̱u̱n u̱ ran-u yar-o̱ ne̱ u̱ te̱-yu̱ ze̱tun u-nu! Se̱ Nuhu nu̱p u̱zu̱ bu̱-mu̱ habu̱g du̱gu̱ u-dak. <verse eid="GEN 8:11"/><verse number="12" style="v" sid="GEN 8:12"/>Wa sur m-e̱ste̱ to̱ko̱n ho̱-to̱ u̱t-ta'er, se̱ wa sur m-to̱m u̱r-gorop, se̱di u̱ da-u o̱ de̱ swu̱ru̱g m-mu̱u̱n u̱du̱ wu̱n da.<verse eid="GEN 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13"/>U̱ ho̱-du̱ u̱r-taku̱n du̱ u-pyaat, da-u̱ Nuhu no̱me̱ u̱s-hak u̱t-ko̱k u̱t-shishin u-gan [601], se̱ bu̱-mu̱ tu̱u̱s du̱gu̱ u-dak. Se̱ Nuhu hast is-yu̱ u-hat se̱ wa hyen dak-u̱ gu̱u̱ste̱. <verse eid="GEN 8:13"/><verse number="14" style="v" sid="GEN 8:14"/>M-vaste̱ da-u̱ pyat-yu̱ rooge̱ u̱r-shik u̱t-ta'er u̱ pyaat-yu̱ u-yu̱r dak-u̱ gu̱u̱s u-be̱e̱t.<verse eid="GEN 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15"/>Se̱ Ru̱-u̱ zu̱ Nuhu, <verse eid="GEN 8:15"/><verse number="16" style="v" sid="GEN 8:16"/>&lt;&lt;Rwu̱u̱ne̱ du̱gu̱ me̱ u-hat, no̱ be̱e̱t u̱ ne̱ta ró ne̱, u̱ ya'ag-u̱ ró ne̱, u̱ ne̱ta-u̱t u̱n ne̱. <verse eid="GEN 8:16"/><verse number="17" style="v" sid="GEN 8:17"/>Rwu̱tu̱n go̱-tu̱ no̱m-tu̱ u̱r-fat u̱t-be̱e̱t tu̱ o̱o̱ge̱ u̱r-kot u̱ bo̱ ne̱: u̱ no ne̱, u̱ bisa-tu̱ u-bu ne̱, u̱ no̱m-tu̱ na no̱me̱ ne̱ u̱t-be̱e̱t tu̱ o̱o̱ge̱ u̱r-da u-dak. No̱m iya ko̱ e̱ u̱t-no̱m u̱r-ke̱s u-dak e̱ no̱m u-tát u-dak.&gt;&gt;<verse eid="GEN 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 8:18"/>Nuhu rwu̱u̱n u̱-do̱, u̱r-kot u̱ ne̱ta wa ne̱, u̱ yaag-u̱ wa ne̱, u̱ ne̱ta-tu̱ yaag-u̱ wa ne̱. <verse eid="GEN 8:18"/><verse number="19" style="v" sid="GEN 8:19"/>U̱t-bisa u̱t-be̱e̱t u̱ no̱m-tu̱ u̱r-fat ne̱ u̱t-be̱e̱t tu̱ o̱o̱ge̱ u̱t-riig u-dak u̱ no ne̱ be̱e̱t, u̱ ko̱-uyan u̱ o̱o̱ge̱ u̱r-no̱k u-dak rwu̱u̱n du̱gu̱ u-hat, ko̱yu̱he̱ u̱ du̱ wa go̱-de̱.<verse eid="GEN 8:19"/></para>
  <para style="s1">Sak-u̱r Nuhu</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20"/>Se̱ Nuhu ma-u̱ Yawe u̱r-sak. Se̱ wa ku̱b to̱ku̱n bisa-tu̱ u-he̱n to̱ u̱t-be̱e̱t u̱ no ne̱ i u-he̱n, wa yu̱' u̱r-to̱o̱g u̱-do̱m u̱r-sak. <verse eid="GEN 8:20"/><verse number="21" style="v" sid="GEN 8:21"/>Yawe hog wu̱s u-haku̱n se̱ wa zu̱ u̱-me̱ jab-u̱ wa: &lt;&lt;U̱m zamu̱n u̱t-sur wa'-u̱ u-dak nu-u yo̱-o̱ re̱mu̱ ne̱t da, ko̱ ba shu̱'u̱te̱ u̱zu̱ dorog-u̱s wa du̱gu̱ u̱r-ya no̱m-u̱t yo̱-to̱ to̱. U̱m zamu̱n u̱t-sur ho̱ru̱sse̱te̱ no̱m-tu̱ u̱r-fat da, ka u̱m nomte̱.<verse eid="GEN 8:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 8:22"/>&lt;&lt;Abite̱ dak u-be̱e̱t o̱ro:</para>
  <para style="q2" vid="GEN 8:22">na no̱mu̱ da-u̱ ku̱w</para>
  <para style="q1" vid="GEN 8:22">u̱ da-u̱ ket ne̱,</para>
  <para style="q2" vid="GEN 8:22">da-u̱ m-to̱r u̱ da-u̱ hund ne̱,</para>
  <para style="q1" vid="GEN 8:22">da-u̱ u-go̱s u̱ da-u̱</para>
  <para style="q2" vid="GEN 8:22">u-zwu̱u̱n ne̱,</para>
  <para style="q1" vid="GEN 8:22">u-ho̱ m-gyu̱p ne̱,</para>
  <para style="q2" vid="GEN 8:22">to̱ zamu̱n u̱t-yage̱ da.&gt;&gt;<verse eid="GEN 8:22"/></para>
  <chapter eid="GEN 8"/>
  <chapter number="9" style="c" sid="GEN 9"/>
  <para style="s1">Ru̱-u̱ no̱ng este̱du̱ u̱s-rem <optbreak/> u̱ Nuhu ne̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1"/>Se̱ Ru̱-u̱ wa'-u̱ Nuhu u̱ ya'ag-u̱ campa-ne̱ wa nu-u so̱-o̱. Tu̱msu̱ wa waru̱ e̱, Matu̱n yaag tu̱msu̱ no̱ no̱m u-tát, no̱ shu̱u̱s u-dak. <verse eid="GEN 9:1"/><verse number="2" style="v" sid="GEN 9:2"/>Bisa-tu̱ u-dak u̱t-be̱e̱t, u̱ no do̱m u-ru̱ ne̱ be̱e̱t, bisa-m re̱k-mo̱ m-be̱e̱t i o̱ u̱t-riig u-dak, tu̱msu̱ u̱ jan ne̱ me̱ m-bu̱, e̱ do̱'e̱ ho̱g-du̱ gye̱r-u no̱. U̱m wa'ag to̱ u̱t-be̱e̱t u̱ ta-u̱ be̱b-u̱r no̱. <verse eid="GEN 9:2"/><verse number="3" style="v" sid="GEN 9:3"/>No̱m-u̱ o̱o̱ge̱ u̱r-fat tu̱msu̱ u̱t-riig u̱m yaag no̱ to̱ shu̱'u̱t no̱m u̱t-re̱ no̱ u̱t-be̱e̱t. U̱ka u̱m yete̱ no̱ hyu̱ u̱t-ran ne̱, u̱m yaag no̱ ko̱-uyan u̱ da-o̱ u-be̱e̱t.<verse eid="GEN 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 9:4"/>A no̱ jaru̱n no̱ tu̱ ap-mu̱ bisa-yu̱ za na pan da. <verse eid="GEN 9:4"/><verse number="5" style="v" sid="GEN 9:5"/>Ko̱wana kabe̱ fat-du̱ ne̱t, na no̱mu̱ wa kwu̱p-du̱ u̱s-rem. A bisa-yu̱ u̱r-do̱g u̱ ho̱ye̱ ne̱t, na ho̱ ya. Tu̱msu̱ ko̱wana ho̱ o̱r-u̱ wa ne̱t ko̱wana ho̱ wa.<verse eid="GEN 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 9:6"/>&lt;&lt;Ko̱wana azge̱</para>
  <para style="q2" vid="GEN 9:6">hyu̱-mu̱ o̱r-u̱ wa ne̱t,</para>
  <para style="q1" vid="GEN 9:6">ne̱t wa do̱'e̱ u̱ ho̱-du̱ wa,</para>
  <para style="q1" vid="GEN 9:6">Remu̱ u̱zu̱ sha-mu̱ u-Ru̱ mo̱</para>
  <para style="q2" vid="GEN 9:6">na nomte̱ ne̱t.<verse eid="GEN 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 9:7"/>&lt;&lt;U̱ da-o̱ matu̱n yaag no̱ no̱m u-tát, tu̱msu̱ no̱ sur m-shu̱s u-dak.&gt;&gt;<verse eid="GEN 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8"/>Se̱ Ru̱-u̱ waru̱ Nuhu u̱ ya'ag-u̱ campa wa ne̱ tu̱msu̱ wa zu̱, <verse eid="GEN 9:8"/><verse number="9" style="v" sid="GEN 9:9"/>&lt;&lt;U̱ da-o̱ u̱m no̱ng este̱du̱ u̱s-rem u̱ bo̱ ne̱ u̱ yaag-u̱ ró ne̱ i do̱'e̱ haan, <verse eid="GEN 9:9"/><verse number="10" style="v" sid="GEN 9:10"/>tu̱msu̱ u̱t-bisa ne̱ tu̱ o̱o̱ge̱ u-hat u̱ bo̱ ne̱ u̱ no ne̱, u̱ bisa-tu̱ u-bu ne̱, tu̱msu̱ u̱ bisa-tu̱ u̱r-do̱g ne̱, u̱ no̱m-tu̱ na no̱me̱ ne̱ tu̱ o̱o̱ge̱ u-dak. <verse eid="GEN 9:10"/><verse number="11" style="v" sid="GEN 9:11"/>U̱m no̱ng este̱du̱ u̱s-rem ri u̱ no̱ ne̱: U̱m zamu̱n tu̱msu̱ ho̱-du̱ no̱m-u̱ u̱r-fat u-be̱e̱t u̱ bu̱-mu̱ re̱-du̱ u-dak da, u̱m zamu̱n tu̱msu̱ no̱m-du̱ bu̱-mu̱ re̱-du̱ u-dak mu̱ de̱ ho̱-du̱ u-dak da.&gt;&gt;<verse eid="GEN 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 9:12"/>Se̱ Ru̱-u̱ zu̱, &lt;&lt;U̱m o̱ ko̱se̱ no̱ sha-mu̱ este̱du̱ remu̱-u̱s ri tu̱msu̱ u̱ no̱m-tu̱ u̱t-fat ne̱ u̱t-be̱e̱t, este̱du̱ u̱s-rem u̱ ne̱t-tu̱ da-u̱ do̱'e̱ u̱ haan ne̱ u̱t-be̱e̱t. <verse eid="GEN 9:12"/><verse number="13" style="v" sid="GEN 9:13"/>U̱m wa'ag u-ro̱ko̱ro̱mb u̱t-ku̱'u̱t. Ya o̱ ko̱se̱-du̱ sha-mu̱ este̱du̱ u̱s-remu̱ ri u̱ no̱ ne̱ tu̱msu̱ u-dak-ne̱ u-be̱e̱t. <verse eid="GEN 9:13"/><verse number="14" style="v" sid="GEN 9:14"/>Da-u̱ u̱m haatu̱n u̱t-ku̱'u̱t u̱-do̱m u-ru̱, ro̱ko̱ro̱mb-yu̱ do̱'e̱ u̱t-rwu̱n u̱t-ku̱'u̱t, <verse eid="GEN 9:14"/><verse number="15" style="v" sid="GEN 9:15"/>tu̱msu̱ me̱ baksu̱ este̱du̱ u̱s-remu̱ ri u̱ no̱ ne̱ tu̱msu̱ u̱ no̱m-tu̱ u̱r-fat ne̱ u̱t-be̱e̱t. U̱m zamu̱n u̱ ho̱-du̱ u̱t-fat u̱ bu̱-mu̱ re̱-du̱ u-dak da. <verse eid="GEN 9:15"/><verse number="16" style="v" sid="GEN 9:16"/>Da-u̱ u̱m hyane̱ u-ro̱ko̱ro̱mb u̱t-ku̱'u̱t, me̱ baksu̱ este̱du̱ u̱s-rem su̱ m-mo̱mmo̱ su̱ u̱m no̱me̱ u̱ no̱m u̱r-fat ne̱ u-dak.&gt;&gt;<verse eid="GEN 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 9:17"/>Ru̱-u̱ zu̱ Nuhu &lt;&lt;Inya ya o̱ u̱t-ko̱se̱ sha-mu̱ este̱du̱ u̱s-rem su̱ u̱m no̱me̱ u̱ mo̱t-tu̱ no̱m-tu̱ u̱m no̱me̱ tu̱ u-dak u-be̱e̱t.&gt;&gt;<verse eid="GEN 9:17"/></para>
  <para style="s1">Yaag-u̱ campa-ne̱ Nuhu</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18"/>Yaag-u̱ campa-ne̱ Nuhu i rwu̱ne̱ du̱gu̱ me̱ u-hat u̱ uso-u e̱ ne̱ na zu̱ e̱: She̱m, Ham u̱ Jape̱t (Ham wa mate̱ Kan'ana). <verse eid="GEN 9:18"/><verse number="19" style="v" sid="GEN 9:19"/>U̱n tu̱t e̱ o̱ yaag-u̱ Nuhu, du̱gu̱-du̱ e̱ de̱ na kume̱ ne̱t-tu̱ bu̱rgu̱sse̱te̱ u-dak.<verse eid="GEN 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20"/>Da-u̱ bu̱-mu̱ arke̱, Nuhu he̱e̱se̱ u̱r-to̱m u-dak, tu̱msu̱ wa o̱o̱ge̱ ne̱t wu̱ tak-ne̱ kau-du̱ u-tak u̱ inabi. <verse eid="GEN 9:20"/><verse number="21" style="v" sid="GEN 9:21"/>Da-u̱ wa swaye̱ ke̱, se̱ ke̱ ho̱ wa. Wa ru̱t u̱r-so u̱ rimpa-u̱r wa. <verse eid="GEN 9:21"/><verse number="22" style="v" sid="GEN 9:22"/>Ham (u̱so u̱ Kan'ana) wa hyen u̱zu̱ u̱so-u wa o̱ u̱r-so, wa aru̱k m-rwu̱ u̱-do̱ wa waru̱ o̱r-u̱t wa ne̱. <verse eid="GEN 9:22"/><verse number="23" style="v" sid="GEN 9:23"/>Se̱di She̱m ne̱ e̱ Jape̱t e̱ ku̱b u-kus e̱ ho̱bo̱g o̱ u̱ zag u̱t-kap-u̱ e̱. E̱ hu̱ m-ha m-targadim e̱ do̱'e̱ e̱ taku̱s so-du̱ u̱so-u e̱. Se̱ e̱ hast shu̱u̱t e̱ u̱ kit taas e̱ hyan so-du̱ u̱so-u e̱ da.<verse eid="GEN 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 9:24"/>Da-u̱ Nuhu yu̱ne̱ du̱gu̱ ho̱du̱ ke̱, wa nu̱p no̱mu̱ vaste̱-u̱r wa no̱mu̱ wa. <verse eid="GEN 9:24"/><verse number="25" style="v" sid="GEN 9:25"/>Se̱ wa wa'-u̱ Kan'ana nu-u yo̱-o̱,</para>
  <para style="q1" vid="GEN 9:25">&lt;&lt;Yage̱ u̱ Kan'ana</para>
  <para style="q2" vid="GEN 9:25">shu̱'u̱t u̱ nu-u yo̱-o̱ ne̱!</para>
  <para style="q1" vid="GEN 9:25">Yage̱ tu̱msu̱ wa shu̱'u̱t to̱k</para>
  <para style="q2" vid="GEN 9:25">u̱ te̱k-u̱ o̱r-u̱t wa ne̱.&gt;&gt;<verse eid="GEN 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 9:26"/>Tu̱msu̱ wa zu̱,</para>
  <para style="q1" vid="GEN 9:26">&lt;&lt;Yage̱ Yawe,</para>
  <para style="q2" vid="GEN 9:26">Ru̱-u̱ She̱m, wa wa'-u̱</para>
  <para style="q2" vid="GEN 9:26">She̱m nu-u so̱-o̱,</para>
  <para style="q1" vid="GEN 9:26">tu̱msu̱ Kan'ana do̱'e̱</para>
  <para style="q2" vid="GEN 9:26">shu̱'u̱t to̱k-u̱ She̱m.<verse eid="GEN 9:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 9:27"/>Yage̱ Ru̱-u̱ sur tat-u̱</para>
  <para style="q2" vid="GEN 9:27">kwu̱m-u̱t Jape̱t,</para>
  <para style="q1" vid="GEN 9:27">yage̱ Jape̱t no̱m u̱r-yu̱</para>
  <para style="q2" vid="GEN 9:27">rimpa-u̱t She̱m,</para>
  <para style="q1" vid="GEN 9:27">tu̱msu̱ u̱ Kan'ana</para>
  <para style="q2" vid="GEN 9:27">shu̱'u̱t to̱k-u̱ Jape̱t.&gt;&gt;<verse eid="GEN 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28"/>Da-u̱ bu̱-mu̱ re̱-du̱ u-dak arke̱, Nuhu sur m-no̱m se̱ke̱n hak-se̱ u̱t-ko̱k u̱t-tu̱t u̱ u̱t-shik u̱t-yu̱r u̱ o̱p [350]. <verse eid="GEN 9:28"/><verse number="29" style="v" sid="GEN 9:29"/>Nuhu no̱ng u̱s-hak u̱t-ko̱k u̱t-jwu̱r u̱r-shik u̱t-yu̱r u̱ o̱p [950], se̱ wa mu̱ru̱s.<verse eid="GEN 9:29"/></para>
  <chapter eid="GEN 9"/>
  <chapter number="10" style="c" sid="GEN 10"/>
  <para style="s1">Yaag-u̱ campa-ne̱ Nuhu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1"/>Tun-to̱ o̱ ogor-tu̱ ya'ag-u̱ Nuhu: She̱m, Ham, u̱ Jape̱t. Na mak-u̱t ya'ag-u̱ campa-ne̱ e̱ da-u̱ bu̱-mu̱ re̱-du̱ u-dak arke̱.<verse eid="GEN 10:1"/></para>
  <para style="s1">Ban-du̱ ya'ag-u̱ Jape̱t</para>
  <para style="li1">
    <verse number="2" style="v" sid="GEN 10:2"/>Yaag-u̱ campa-ne̱ Jape̱t e̱ o̱ye̱:</para>
  <para style="li2" vid="GEN 10:2">Gomar, Mago̱g, Midiya, Jaban, Tubar, Meshek, u̱ Tiras.<verse eid="GEN 10:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="GEN 10:3"/>Yaag-u̱ campa-ne̱ Gomar e̱ o̱ye̱:</para>
  <para style="li2" vid="GEN 10:3">Asukenaz, Ripat, u̱ Togarma.<verse eid="GEN 10:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="GEN 10:4"/>Yaag-u̱ campa-ne̱ Jaban e̱ o̱ye̱:</para>
  <para style="li2" vid="GEN 10:4">Erisha, Tarshish, Kittim, u̱ Rodanin. <verse eid="GEN 10:4"/><verse number="5" style="v" sid="GEN 10:5"/>Ine̱ ya'ag-u̱ ne̱t-u̱t to̱ ne̱, e̱ rwu̱ne̱ du̱gu̱ ko̱-u̱r Jaban i o̱ u̱r-yu̱ u̱-kit m-sa. Yaag-u̱ e̱ shu̱'u̱t u̱t-ko̱, ko̱wan u̱du̱ e̱ rem-de̱, u̱ dak-u e̱ ne̱.<verse eid="GEN 10:5"/></para>
  <para style="s1">Ban-du̱ ya'ag-u̱ Ham</para>
  <para style="li1">
    <verse number="6" style="v" sid="GEN 10:6"/>Yaag-u̱ campa-ne̱ Ham e̱ o̱ye̱:</para>
  <para style="li2" vid="GEN 10:6">Kush, Masar, Put, u̱ Kan'ana.<verse eid="GEN 10:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="GEN 10:7"/>Yaag-u̱ campa-ne̱ Kush e̱ o̱ye̱:</para>
  <para style="li2" vid="GEN 10:7">Seba, Havira, Sabata, Raama, u̱ Sabateka.</para>
  <para style="li1" vid="GEN 10:7">Yaag-u̱ campa-ne̱ Raama e̱ o̱ye̱:</para>
  <para style="li2" vid="GEN 10:7">Sheba u̱ Dedan.<verse eid="GEN 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 10:8"/>Kush wa mate̱ Nimro̱, wa o̱ye̱ ne̱t u̱r-taku̱n wu̱ shu̱'u̱te̱ u-ke̱g u̱du̱ m-gag u-dak. <verse eid="GEN 10:8"/><verse number="9" style="v" sid="GEN 10:9"/>Wa o̱ye̱ yu̱-shu̱ a u-sa ne̱ u̱-shu̱ Yawe; &lt;&lt;O̱ wa-e̱ na zu̱t Nimro̱, wa o̱ yu̱-shu̱ a u-sa ne̱ u̱-shu̱ Yawe.&gt;&gt; <verse eid="GEN 10:9"/><verse number="10" style="v" sid="GEN 10:10"/>Bo̱-tu̱ wu̱n taktu̱n u̱r-faru̱k to̱ o̱o̱ge̱ Babira, u̱ Ere̱k, Akat u̱ Karne̱ ne̱. Bo̱-u̱t to̱ u̱t-nas u̱t-be̱e̱t to̱ o̱ me̱ dak-u̱ Shinar. <verse eid="GEN 10:10"/><verse number="11" style="v" sid="GEN 10:11"/>Du̱gu̱ dak-u̱ o̱ wa aru̱k m-ha Asur, se̱ wa mu̱ bo̱-tu̱ Neneba, Rehobot-Ir, Kara-ne̱, <verse eid="GEN 10:11"/><verse number="12" style="v" sid="GEN 10:12"/>tu̱msu̱ Resen, u̱ o̱o̱ge̱ u̱-te̱k u̱ Neneba u̱ Kara-ne̱; o̱ o̱ye̱ bo̱-u yat-o̱.<verse eid="GEN 10:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 10:13"/>Masar wa mate̱:</para>
  <para style="li2" vid="GEN 10:13">Ruda-ne̱, Anama-ne̱, Rehabita-ne̱, u̱ Naputa-ne̱, <verse eid="GEN 10:13"/><verse number="14" style="v" sid="GEN 10:14"/>Patarus-ne̱, Kasaruhi-ne̱ (ku̱na Firistiya-ne̱ rwu̱tu̱n), u̱ Kapator-ne̱.<verse eid="GEN 10:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="GEN 10:15"/>Kan'ana wa mate̱:</para>
  <para style="li2" vid="GEN 10:15">Sidon, Sidon mat-du̱ u̱r-taku̱n wa, tu̱msu̱ u̱ He̱t-ne̱, <verse eid="GEN 10:15"/><verse number="16" style="v" sid="GEN 10:16"/>u̱ Jebusi-ne̱, u̱ Amoriya-ne̱, u̱ Giragashi-ne̱, <verse eid="GEN 10:16"/><verse number="17" style="v" sid="GEN 10:17"/>u̱ Hiwi-ne̱, u̱ Araki-ne̱, u̱ Sinite-ne̱, <verse eid="GEN 10:17"/><verse number="18" style="v" sid="GEN 10:18"/>u̱ Awadi-ne̱, u̱ Zemara-ne̱, u̱ Hamati-ne̱.</para>
  <para style="p" vid="GEN 10:18">Da-u̱ tase̱ ko̱-u̱r Kan'ana, se̱ e̱ bu̱ru̱g ko̱he̱ne̱. <verse eid="GEN 10:18"/><verse number="19" style="v" sid="GEN 10:19"/>Tu̱msu̱ bo̱r-su̱ Kan'ana teeg du̱gu̱ Sidon m-ha gas-u̱ Gerar m-te Gaza, tu̱msu̱ m-te bo̱-tu̱ So̱do̱m, u̱ Gomora, u̱ Adma, u̱ Zeboyim ne̱ (u̱t-mo̱r u̱ Rasha ne̱).<verse eid="GEN 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 10:20"/>Tunto̱ o̱ye̱ ko̱-tu̱ ya'ag-u̱ campa-ne̱ ko̱-u̱r Ham, ko̱du̱he̱ ko̱-de̱ u̱ du̱ wa rem-de̱, tu̱msu̱ dak-u wa ne̱.<verse eid="GEN 10:20"/></para>
  <para style="s1">Ya'ag-u̱ campa-ne̱ She̱m</para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21"/>Na mak-tu̱ She̱m ya'ag-u̱ campa-ne̱, wu̱ o̱o̱ge̱ yu̱-wu̱ya Jape̱t. Tu̱msu̱ She̱m wa o̱o̱ge̱ u̱so-u̱ ko̱-u̱r Eber u̱r-be̱e̱t.<verse eid="GEN 10:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="GEN 10:22"/>Yaag-u̱ campa-ne̱ She̱m e̱ o̱ye̱:</para>
  <para style="li2" vid="GEN 10:22">Eram, Ashu̱r, Arpazad, Rud, u̱ Aram.<verse eid="GEN 10:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 10:23"/>Yaag-u̱ Aram e̱ o̱ye̱:</para>
  <para style="li2" vid="GEN 10:23">Uz, Hur, Geta, u̱ Mash.<verse eid="GEN 10:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 10:24"/>Arpazad wa mate̱ Shera,</para>
  <para style="li2" vid="GEN 10:24">Shera wa mate̱ Eber.<verse eid="GEN 10:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 10:25"/>Eber wa mate̱ ya'ag-u̱ campa-ne̱ yu̱r,</para>
  <para style="li2" vid="GEN 10:25">Wa gan na zu̱ wa Pereg, remu̱ u̱ da-u o̱ dak-u̱ mo̱te̱, du̱-dim-u̱ wa na zu̱ wa Jokta.<verse eid="GEN 10:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 10:26"/>Jokta wa mate̱:</para>
  <para style="li2" vid="GEN 10:26">Armodad, Sherep, Hazaramave̱t, Jera, <verse eid="GEN 10:26"/><verse number="27" style="v" sid="GEN 10:27"/>Hadoram, Uzar, Dikara, <verse eid="GEN 10:27"/><verse number="28" style="v" sid="GEN 10:28"/>O̱bar, Abimayer, Sheba, <verse eid="GEN 10:28"/><verse number="29" style="v" sid="GEN 10:29"/>Opir, Havira u̱ Jobab. Ayan-ne̱ o̱ye̱ ya'ag-u̱ ko̱-u̱r Jokta be̱e̱t.<verse eid="GEN 10:29"/></para>
  <para style="m">
    <verse number="30" style="v" sid="GEN 10:30"/>Gas-u̱ dak-u̱ u̱n shu̱'u̱te̱ o̱ yu̱nge̱ du̱gu̱ Mesha m-ha Separ m-ha gas-u̱ ro̱r-tu̱ u-do̱m.<verse eid="GEN 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 10:31"/>Tunto̱ o̱o̱ge̱ ko̱-tu̱ ya'ag-u̱ She̱m u̱ka ko̱-u̱t e̱ u̱ rem-u̱t e̱ ne̱, be-tu̱ u̱r-shu̱'u̱t-u̱ e̱ u̱ dak-u̱t e̱ ne̱.<verse eid="GEN 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32"/>Armo̱ ne̱ o̱ye̱ ko̱-du̱ ya'ag-u̱ Nuhu, du̱gu̱ taku̱n-u̱r e̱. Du̱gu̱-du̱ e̱ de̱ rem-tu̱ bu̱rge̱ u-dak u-be̱e̱t, da-u̱ bu̱-mu̱ re̱-du̱ u-dak arke̱.<verse eid="GEN 10:32"/></para>
  <chapter eid="GEN 10"/>
  <chapter number="11" style="c" sid="GEN 11"/>
  <para style="s1">Ma-u̱ Babira</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1"/>U̱ da-u̱ taku̱n-du̱ u-dak rem-de̱ u̱r-gan du̱ ne̱t-tu̱ nomte̱ u̱s-rem. <verse eid="GEN 11:1"/><verse number="2" style="v" sid="GEN 11:2"/>Da-u̱ ne̱t-tu̱ rwu̱ne̱ du̱gu̱ u-do̱m, e̱ kum dak-u̱ o̱o̱ge̱ nu̱ru̱gse̱ u̱-me̱ dak-u̱ Shinar e̱ shu̱'u̱t u̱ku̱n.<verse eid="GEN 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 11:3"/>E̱ zu̱ o̱r-u̱t e̱ ne̱, &lt;&lt;Haanu̱n in no̱m u̱t-kunku in zom-to̱ so̱k.&gt;&gt; U̱n no̱m u̱t-kunku to̱ shu̱'u̱t u̱ka u̱t-taar, tu̱msu̱ rwab-tu̱ shu̱'u̱t u̱ka m-kwarta. <verse eid="GEN 11:3"/><verse number="4" style="v" sid="GEN 11:4"/>E̱ zu̱, &lt;&lt;Haanu̱n, in no̱mu̱ hi-du̱ war in u-bo̱, u̱ ma-u̱ m-wu̱r u̱ do̱'e̱ te-du̱ do̱m u-ru̱ in no̱mo̱n hi-du̱ war in u̱r-dim taas in bu̱ru̱gse̱ u-dak da.&gt;&gt;<verse eid="GEN 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5"/>Tu̱msu̱ Yawe cu̱zu̱n u̱ remu̱ wa got bo̱-u̱ ma-u̱ m-wu̱r u̱ ya'ag-u̱ u̱t-ne̱t o̱ u̱t-ma. <verse eid="GEN 11:5"/><verse number="6" style="v" sid="GEN 11:6"/>Yawe zu̱, &lt;&lt;A-mu̱u̱ne̱ zu̱ ne̱t-tu̱ o̱ same̱-du̱ u̱t-hi ne̱ tu̱msu̱ e̱ wu̱r u̱r-rem u̱r-gan e̱ taku̱n no̱m-du̱ go̱-du̱ u̱no̱ no̱m-o̱, o̱ko̱n zaar u̱ e̱ do̱'e̱ u̱t-zo̱ng u̱t-no̱m u̱ do̱'e̱ ze̱g-du̱ be̱b-u̱r e̱ da. <verse eid="GEN 11:6"/><verse number="7" style="v" sid="GEN 11:7"/>Haane̱, in ciz u-dak, in wagu̱sse̱ rem-u̱r u̱n, u̱ka u̱n zatte̱ u̱t-nap rem-du̱ o̱r-u̱t u̱n ne̱ o̱ u̱t-war da.&gt;&gt;<verse eid="GEN 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 11:8"/>Iya-o̱ Yawe bu̱rgu̱sse̱ u̱n ko̱he̱ne̱ u-dak u-be̱e̱t, se̱ u̱n yage̱ ma-du̱ u-bo̱. <verse eid="GEN 11:8"/><verse number="9" style="v" sid="GEN 11:9"/>Remu̱ iya na fogte̱ be-u̱r re̱ Babira, remu̱ zu̱ ku̱na Yawe e̱ngu̱sse̱ u̱t-rem tu̱ u-dak u-be̱e̱t, u̱ ku̱na Yawe bu̱rgu̱sse̱ u̱t-ne̱t u-dak u-be̱e̱t.<verse eid="GEN 11:9"/></para>
  <para style="s1">Ko̱-u̱r She̱m u̱ haan u̱ Ibram</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10"/>Tun-to̱ o̱o̱ge̱ ogor-tu̱ ya'ag-u̱ ko̱-u̱r She̱m.</para>
  <para style="p" vid="GEN 11:10">Da-u̱ hak-su̱ u̱s-yu̱r arke̱ ba na tase̱ bu̱-mu̱ re̱-du̱ u-dak, She̱m wa mu̱te̱ Arpazad. Da-u She̱m o̱ u̱s-hak u̱t-shik u̱t-tan [100]. <verse eid="GEN 11:10"/><verse number="11" style="v" sid="GEN 11:11"/>Ba wa mate̱ Arpazad, She̱m sur m-no̱m u̱s-hak u̱t-ko̱k u̱t-tan [500], u̱ te̱k-u̱ hak-su̱ u̱t-ko̱k u̱t-tan wa mu̱t e̱ke̱n ya'ag-u̱ campa-ne̱ u̱ yaat u̱t-gwu̱p-ne̱.<verse eid="GEN 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12"/>Da-u̱ Arpazad no̱me̱ u̱r-yu̱ u̱s-hak u̱r-shik u̱ o̱p u̱s-tan [35], se̱ wa mu̱t Shera. <verse eid="GEN 11:12"/><verse number="13" style="v" sid="GEN 11:13"/>Ba wa mate̱ Shera, Arpazad sur m-no̱m u̱r-yu̱ u̱s-hak u̱t-ko̱k u̱t-nas u̱s-tu̱t [403], u̱ te̱k-u̱ hak-su̱ u̱t-ko̱k u̱t-nas u̱ o̱p u̱s-tu̱t wa mu̱t e̱ke̱n ya'ag-u̱ campa-ne̱ u̱ yaat u̱t-gwu̱p-ne̱.<verse eid="GEN 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 11:14"/>Da-u̱ Shera no̱me̱ u̱r-yu̱ u̱s-hak u̱r-shik-u̱ o̱p [30], wa mu̱t Eber. <verse eid="GEN 11:14"/><verse number="15" style="v" sid="GEN 11:15"/>Ba wa mate̱ Eber, Shera sur m-no̱m u̱s-hak u̱t-ko̱k u̱t-nas u̱s-tu̱t [403], u̱ te̱k-u̱ hak-su̱ u̱t-ko̱k u̱t-nas u̱s-tu̱t wa mu̱t e̱ke̱n ya'ag-u̱ campa-ne̱ u̱ yaat u̱t-gwu̱p-ne̱.<verse eid="GEN 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16"/>Da-u̱ Eber no̱me̱ u̱r-yu̱ u̱s-hak u̱r-shik u̱s-o̱p u̱s-nas [34], wa mu̱t Pereg. <verse eid="GEN 11:16"/><verse number="17" style="v" sid="GEN 11:17"/>Ba wa mate̱ Pereg, Eber sur m-no̱m u̱s-hak u̱t-ko̱k u̱t-nas u̱r-shik u̱ o̱p [430], u̱ te̱k-u̱ hak-su̱ u̱t-ko̱k u̱t-nas u̱ o̱p wa mu̱t e̱ke̱n ya'ag-u̱ campa-ne̱ u̱ yaat u̱t-gwu̱p-ne̱.<verse eid="GEN 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18"/>Da-u̱ Pereg no̱me̱ u̱r-yu̱ u̱s-hak u̱r-shik u̱ o̱p [30], se̱ wa mu̱t Re̱wi. <verse eid="GEN 11:18"/><verse number="19" style="v" sid="GEN 11:19"/>Tu̱msu̱ ba wa mate̱ Re̱wi, Pereg sur m-no̱m u̱s-hak u̱t-ko̱k u̱t-yu̱r u̱ hak-su̱ u̱s-jwu̱r [209], u̱ te̱k-u̱ hak-su̱ u̱t-ko̱k u̱t-yu̱r u̱ o̱p wa mu̱t e̱ke̱n ya'ag-u̱ campa-ne̱ u̱ yaat u̱t-gwu̱p-ne̱.<verse eid="GEN 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20"/>Da-u̱ Re̱wi no̱me̱ u̱r-yu̱ u̱s-hak u̱r-shik u̱ o̱p u̱s-yu̱r [32], se̱ wa mu̱t Shu̱ru̱g. <verse eid="GEN 11:20"/><verse number="21" style="v" sid="GEN 11:21"/>Ba wa mate̱ Shu̱ru̱g, Re̱wi sur m-no̱m u̱s-hak u̱t-ko̱k u̱t-yu̱r u̱s-ta'e̱r [207], u̱ te̱k-u̱ hak-su̱ u̱t-ko̱k u̱t-yu̱r u̱s-ta'e̱r wa mu̱t e̱ke̱n ya'ag-u̱ campa-ne̱ u̱ yaat u̱t-gwu̱p-ne̱.<verse eid="GEN 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22"/>Da-u̱ Shu̱ru̱g no̱me̱ u̱r-yu̱ u̱s-hak u̱r-shik u̱s-o̱p [30], se̱ wa mu̱t Naho̱r. <verse eid="GEN 11:22"/><verse number="23" style="v" sid="GEN 11:23"/>Ba wa mate̱ Naho̱r, Shu̱ru̱g sur m-no̱m u̱s-hak u̱t-ko̱k u̱t-yu̱r [200], u̱ te̱k-u̱ hak-su̱ u̱t-ko̱k u̱t-yu̱r wa mu̱t e̱ke̱n ya'ag-u̱ campa-ne̱ u̱ yaat u̱t-gwu̱p-ne̱.<verse eid="GEN 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24"/>Da-u̱ Naho̱r no̱me̱ u̱r-yu̱ u̱s-hak u̱r-shik u̱s-jwu̱r [29], se̱ wa mu̱t Tera. <verse eid="GEN 11:24"/><verse number="25" style="v" sid="GEN 11:25"/>Ba wa mate̱ Tera, Naho̱r sur m-no̱m u̱s-hak u̱t-shik u̱t-tan u̱ o̱p u̱s-jwu̱r [119], u̱ te̱k-u̱ hak-su̱ u̱t-shik u̱t-tan u̱ o̱p u̱s-jwu̱u̱r wa mu̱t e̱ke̱n ya'ag-u̱ campa-ne̱ u̱ yaat u̱t-gwu̱p-ne̱.<verse eid="GEN 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26"/>Ba Tera no̱me̱ u̱r-yu̱ u̱s-hak u̱t-shik u̱t-tu̱t u̱ o̱p [70], se̱ wa mu̱t Ibram, Naho̱r u̱ Haran.<verse eid="GEN 11:26"/></para>
  <para style="s1">Ko̱-u̱t Tera</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27"/>Tun-to̱ o̱ ogu̱r-tu̱ ko̱-u̱r ya'ag-u̱ Tera.</para>
  <para style="p" vid="GEN 11:27">Tera wa mate̱ Ibram, u̱ Naho̱r u̱ Haran. Tu̱msu̱ Haran wa mate̱ Ro̱t. <verse eid="GEN 11:27"/><verse number="28" style="v" sid="GEN 11:28"/>Da-u̱ u̱so-u wu̱n Tera o̱o̱ge̱ u̱r-fat, Haran mu̱ru̱s u̱ bo̱-u̱ Ur u̱ dak-u̱ Kardiya-ne̱, be-du̱ u̱r-mat u̱ wa. <verse eid="GEN 11:28"/><verse number="29" style="v" sid="GEN 11:29"/>Ibram no̱mu̱g u̱r-gu̱, tu̱msu̱ Naho̱r nom u̱r-gu̱. Dim-du̱ ne̱ta Ibram wa na zu̱ye̱ Sera, ne̱ta Naho̱r wana zu̱ye̱ Mirka. Mirka u̱ hu̱no-u wa Iska e̱ o̱ye̱ yaat u̱t-gwu̱p u̱ Haran. <verse eid="GEN 11:29"/><verse number="30" style="v" sid="GEN 11:30"/>Sera o̱ u-maku̱t wa zatte̱ yaag da.<verse eid="GEN 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31"/>Tera kagu̱b wa'-u̱ wa Ibram, u̱ Ro̱t ne̱ zwaru̱ wa'-u̱ wa Haran, u̱ Sera ne̱ ku̱mu̱wa wu̱ o̱ ne̱ta wa'-u̱ wa Ibram. E̱ aru̱k u̱r-kot du̱gu̱ bo̱-u̱ Ur dak-u̱ Kardiya-ne̱ m-ha u̱ dak-u̱ Kan'ana. Tu̱msu̱ da-u̱ e̱ tene̱ bo̱-u̱ Haran, e̱ shu̱'u̱t u̱ku̱n.<verse eid="GEN 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 11:32"/>Tera no̱mu̱g u̱s-hak u̱t-ko̱k u̱t-yu̱r u̱s-tan [205], se̱ wa mu̱ru̱s u̱ Haran.<verse eid="GEN 11:32"/></para>
  <chapter eid="GEN 11"/>
  <chapter number="12" style="c" sid="GEN 12"/>
  <para style="s1">Ru̱-u̱ fak Ibram</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1"/>Yawe zu̱ Ibram, &lt;&lt;Yu̱ne̱, bo̱ yage̱ dak-u ró, u̱ ne̱t-u̱t ró ne̱, u̱ bu-u̱ u̱so-u ró ne̱, bo̱ do̱'e̱ u̱ dak-u̱ u̱m de̱ ko̱su̱ bo̱.<verse eid="GEN 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 12:2"/>&lt;&lt;Me̱ ya'u̱ bo̱ ya'ag,</para>
  <para style="q2" vid="GEN 12:2">tu̱msu̱ ko̱-u̱r ro u̱t-shu̱'u̱t</para>
  <para style="q2" vid="GEN 12:2">dak-u yat-o̱,</para>
  <para style="q1" vid="GEN 12:2">me̱ wa'-u̱ bo̱ nu-u so̱-o̱;</para>
  <para style="q2" vid="GEN 12:2">Me̱ u̱t-wa bo̱ no̱m u̱r-dim so̱k,</para>
  <para style="q1" vid="GEN 12:2">remu̱ bo̱ shu̱'u̱te̱ fu̱n-yu̱</para>
  <para style="q2" vid="GEN 12:2">kwu̱m-du̱ nu-u so̱-o̱ u̱du̱ e̱ke̱n.<verse eid="GEN 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 12:3"/>Me̱ wa'-u̱ nu-u so̱-o̱,</para>
  <para style="q2" vid="GEN 12:3">u̱du̱ i wa'-u̱ bo̱ nu-u so̱-o̱.</para>
  <para style="q1" vid="GEN 12:3">Tu̱msu̱ ko̱wana wa'-u̱ bo̱</para>
  <para style="q2" vid="GEN 12:3">nu-u yo̱-o̱ me̱ wa'-u̱</para>
  <para style="q2" vid="GEN 12:3">wa nu-u yo̱-o̱,</para>
  <para style="q1" vid="GEN 12:3">Ko̱-tu̱ u-dak u̱t-be̱e̱t</para>
  <para style="q2" vid="GEN 12:3">e̱ kwu̱m-u̱ nu-u so̱-o̱ du̱gu̱-du̱ ró.&gt;&gt;<verse eid="GEN 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4"/>Se̱ Ibram aru̱k, u̱ka Yawe war-tu̱ wa, se̱ Ro̱t dor wa. Da-u̱ wa arke̱ du̱gu̱ bo̱-u̱ Haran, Ibram o̱ u̱s-hak u̱t-shik u̱t-tu̱t u̱ o̱p u̱s-tan [75]. <verse eid="GEN 12:4"/><verse number="5" style="v" sid="GEN 12:5"/>Ibram ku̱b ne̱ta wa Sera, u̱ Ro̱t wa'-u̱ yu̱-wu̱ya wa, u̱ no̱m-tu̱ wa otte̱ ne̱ u̱t-be̱e̱t, u̱ ca wa u̱ na u̱ wa u̱ gwar-u̱ wa u̱ to̱k-ne̱ i u-bu wa ne̱ be̱e̱t tu̱ wa kargu̱sse̱ u̱ dak-u̱ Haran, wa aru̱k m-ha u̱ dak-u̱ Kan'ana. U̱n te ku̱n.<verse eid="GEN 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 12:6"/>Ibram u̱ ne̱t-tu̱ bu-u wa yu̱ne̱ e̱ aru̱k m-ha me̱n-tu̱ bo̱-u̱ She̱ke̱m. Wa de̱ wa cu̱st-u̱ kug-du̱ yaku̱n te-yu̱ O̱k yu̱ na foge̱ More. U̱ da-u o̱, ne̱t-tu̱ Kan'ana to̱ o̱o̱ge̱ u̱ shu̱'u̱t u̱ku̱n. <verse eid="GEN 12:6"/><verse number="7" style="v" sid="GEN 12:7"/>Yawe ko̱se̱ hi-u̱r wa u̱du̱ Ibram wa zu̱, &lt;&lt;Me̱ ya'u̱ bo̱ uno̱ dak-o̱ u̱du̱ ko̱-u̱r ró.&gt;&gt; Se̱ Ibram ma'e̱ Yawe u̱r-sak, wu̱ ko̱se̱ hi-u̱r wa u̱du̱ rò.<verse eid="GEN 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 12:8"/>Du̱gu̱ ku̱na wa arke̱ m-ha u̱ gas-u̱ ro̱r-tu̱ u-do̱m u̱ Be̱te̱r ne̱. Wa nom rimpa-u̱r wa u̱ku̱n, u̱ te̱k-u̱ Be̱te̱r u̱ gas-u̱ u-ta tu̱msu̱ Ai u̱ gas-u̱ u-do̱m. Wa mu̱ u̱r-sak du̱ no̱m-du̱ to̱o̱g u̱ku̱n wa no̱mu̱ Yawe u̱t-huuk. <verse eid="GEN 12:8"/><verse number="9" style="v" sid="GEN 12:9"/>Ibram yu̱ne̱ wa re u-shu̱ m-haane̱ m-sa gas-u̱ Ne̱giv.<verse eid="GEN 12:9"/></para>
  <para style="s1">Ibram e̱ Saratu haag <optbreak/> u̱ Masar u-da cashi</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10"/>U̱ da-u o̱ na no̱ng u̱s-me̱r u̱ dak-u̱ Kan'ana sok, wa'ag Ibram u̱ cwadu̱ dak-u̱ Masar. Wa shu̱'u̱t u̱ku̱n u̱ka ham-u̱t u-da cashi. <verse eid="GEN 12:10"/><verse number="11" style="v" sid="GEN 12:11"/>Da-u̱ e̱ nome̱ u̱t-mo̱r u̱ cwadu̱ Masar ne̱, Ibram zu̱ ne̱ta wa Sera, &lt;&lt;U̱m nak u̱zu̱ bo̱ ne̱ta so̱-wa wa bo̱ o̱o̱ge̱. <verse eid="GEN 12:11"/><verse number="12" style="v" sid="GEN 12:12"/>Da-u̱ ne̱t-tu̱ dak-u̱ Masar u̱ hyane̱ bo̱, e̱ do̱'e̱ u̱t-zu̱, &lt;Ne̱ta wu̱nu̱ ya.&gt; E̱ do̱'e̱ ho̱-du̱ me̱ se̱di e̱ yagu̱ bo̱ u̱r-fat. <verse eid="GEN 12:12"/><verse number="13" style="v" sid="GEN 12:13"/>Zu̱ u̱n bo̱ hu̱no-u ri o̱, remu̱ zu̱ a-bo̱ waru̱ u̱n iya, u̱nu̱ yagu̱ me̱ u̱r-fat. U̱n za ho̱-du̱ me̱ da u̱ remu̱ ró.&gt;&gt;<verse eid="GEN 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 12:14"/>Da-u̱ Ibram tene̱ Masar, ne̱t-tu̱ Masar hyen u̱zu̱ Sera o̱ so̱-ya so̱k. <verse eid="GEN 12:14"/><verse number="15" style="v" sid="GEN 12:15"/>Da-u̱ tu̱-yat-to̱ pyu̱-u̱ faru̱k hyane̱ wu̱n, se̱ e̱ no̱m-u̱ wu̱n u̱t-vam u̱-shu̱ Faru̱k-u̱ Masar, na ku̱b wa m-cwa u̱ pyu̱-u̱ faru̱k. <verse eid="GEN 12:15"/><verse number="16" style="v" sid="GEN 12:16"/>Remu̱ iya Faru̱k-u̱ Masar no̱m-u̱ Ibram u-nya u-tát u̱ remu̱ Sera: ban-du̱ ca, u̱ gwar-ne̱, u̱ na-ne̱, u̱ so-u̱ janka ne̱, u̱ gob-u̱ janka ne̱, u̱ to̱k-ne̱ ne̱ta-ne̱, u̱ to̱k-ne̱ campa-ne̱, u̱ rakum-ne̱.<verse eid="GEN 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 12:17"/>Tu̱msu̱ Yawe haatu̱n go̱m-u̱s yasse̱, u̱ bu-u̱ Faru̱k-u̱ Masar u-be̱e̱t u̱ remu̱ Sera, wu̱ o̱o̱ge̱ ne̱ta Ibram. <verse eid="GEN 12:17"/><verse number="18" style="v" sid="GEN 12:18"/>Se̱ Faru̱k-u̱ Masar fog Ibram, wa zu̱, &lt;&lt;¿Yan o̱ bo̱ no̱mu̱ me̱ iya? ¿Remu̱ yan-o̱ wa-e̱ bo̱ wargu̱ me̱ u̱zu̱ ne̱ta ró wa da? <verse eid="GEN 12:18"/><verse number="19" style="v" sid="GEN 12:19"/>¿Remu̱ yan-o̱ bo̱ no̱mtu̱ me̱, u̱s-bi u̱zu̱ hu̱no-u ró wa? Bo̱ za nom-u̱t iya da! U̱ da-o̱ kab ne̱ta ró, bo̱ yage̱ be-u̱r rinde̱ bo̱ aru̱k.&gt;&gt; <verse eid="GEN 12:19"/><verse number="20" style="v" sid="GEN 12:20"/>Se̱ Faru̱k-u̱ Masar wu̱ e̱ke̱n to̱k-ne̱ wa u̱ e̱ shu̱'e̱ Ibram u̱ ne̱t-u̱t wa ne̱. Se̱ u̱n ku̱b Ibram tu̱msu̱ u̱n tok wa, wa aru̱k, u̱ ne̱ta wa ne̱ u̱ no̱mu̱ wa otte̱ ne̱ u-be̱e̱t.<verse eid="GEN 12:20"/></para>
  <chapter eid="GEN 12"/>
  <chapter number="13" style="c" sid="GEN 13"/>
  <para style="s1">Ibram e̱ Ro̱t mo̱ko̱t <optbreak/> be-du̱ u̱r-shu̱'u̱t</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1"/>Ibram e̱ ne̱ta wa e̱ yage̱ Masar, e̱ ku̱b no̱m-tu̱ e̱ o̱tte̱ u̱t-be̱e̱t, tu̱msu̱ Ro̱t dor u̱n m-no̱k m-cwa do̱g-du̱ Ne̱giv <verse eid="GEN 13:1"/><verse number="2" style="v" sid="GEN 13:2"/>Ibram shu̱'u̱te̱ wa u̱t-kwu̱m sok, u̱t-bisa ne̱, u̱ kwam-tu̱ shik ne̱ tu̱ bu̱-mu̱ u̱t-ro u̱ tu̱ pus-to̱ ne̱.<verse eid="GEN 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 13:3"/>Ibram ne̱ hu̱ u̱t-riig du̱gu̱ Ne̱giv m-te bo̱-u̱ Be̱te̱r m-ha de̱ku̱n be-de̱ u̱ te̱k-u̱ bo̱-u̱ Be̱te̱r u̱ bo̱-u̱ Ai ne̱, e̱ tamu̱g u̱t-cu̱st e̱ nom rimpa-u̱t e̱ u̱ be-u̱r re̱. <verse eid="GEN 13:3"/><verse number="4" style="v" sid="GEN 13:4"/>Tu̱msu̱ be-du̱ Ibram maate̱ Yawe u̱r-sak. Ku̱na Ibram nomte̱ Yawe u̱t-huuk u̱ku̱n.<verse eid="GEN 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5"/>Ro̱t, wu̱ no̱me̱ m-ha e̱ Ibram, ko̱wa wa o̱tte̱ ban-tu̱ ca, u̱ ban-tu̱ gwaar ne̱, u̱ ban-tu̱ na ne̱, u̱t-rimpa ne̱ u-tát. <verse eid="GEN 13:5"/><verse number="6" style="v" sid="GEN 13:6"/>Se̱di e̱ o̱tte̱ u̱t-bisa u-tát, tu̱ do̱'e̱ hosu̱ u̱n u̱r-shu̱'u̱t u̱r-be u̱r-gan. Do̱g-du̱ gwat-du̱ u̱t-bisa nom u̱n cashi u̱ bu̱-mu̱ u̱s-swa ne̱, u̱ no̱m-tu̱ u̱t-re̱ tu̱ u̱t-bisa ne̱. <verse eid="GEN 13:6"/><verse number="7" style="v" sid="GEN 13:7"/>Se̱ har u̱ to u̱ te̱k-u̱ a-gwat-du̱ bisa-u̱t Ro̱t ne̱ u̱ a-gwat-du̱ bisa-u̱t Ibram ne̱. Tu̱msu̱ ne̱t-tu̱ Kan'ana u̱ ne̱t-tu̱ Periziya-ne̱ o̱ shu̱'u̱t u̱ku̱n u̱ da-u o̱.<verse eid="GEN 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8"/>Ibram zu̱ Ro̱t, &lt;&lt;Remu̱ u̱zu̱ in hu̱u̱b-tu̱ u̱r-mat to̱ na o̱o̱ge̱, no̱ng u̱r-zwar na ho̱g in u-har da, ko̱ te̱k-u̱ a-gwat-du̱ u̱t-bisa ró u̱ a-gwat-du̱ u̱t-bisa ri ne̱ da. <verse eid="GEN 13:8"/><verse number="9" style="v" sid="GEN 13:9"/>¿Dak-u u-no u-be̱e̱t o̱ za u̱-shu̱ ró da? Du̱ste̱ gas-u̱ cite̱ bo̱ u̱ bo̱ o̱o̱ge̱ u̱ssa, u̱ yu̱-u mo̱t. Abite̱ Gas-u̱ kom u̱r-beer o̱ bo̱ o̱o̱ge̱ u̱ssa, se̱ u̱m kab Gas-u̱ kom u̱t-cwa. Abite̱ u̱zu̱ kom u̱t-cwa o̱ bo̱ o̱o̱ge̱ u̱ssa, se̱ u̱m kab Gas-u̱ kom u̱r-beer.&gt;&gt;<verse eid="GEN 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10"/>Ro̱t jaku̱s is-u̱ wa wa hyen gas-u̱ fu̱g-yu̱ Jodan u-be̱e̱t, m-te Zo̱war, o̱tte̱ m-bu̱ ko̱he̱ne̱. Gas-u o̱ u-be̱e̱t, be-to̱ so̱-to̱ u̱ka tak-u̱ Yawe tu̱msu̱ u̱ka dak-u̱ Masar. (Na no̱ng iya kanda Yawe ho̱ru̱sse̱ So̱do̱m u̱ Gomora ne̱.) <verse eid="GEN 13:10"/><verse number="11" style="v" sid="GEN 13:11"/>Se̱ Ro̱t du̱stu̱ hi-du̱ war-wa gas-u̱ gote̱ fu̱g-yu̱ Jodan m-sa gas-u u-do̱m. Wa aru̱k u̱ gas-u o̱ u̱ bisa-u̱t wa ne̱ u̱ to̱k-ne̱ wa ne̱ be̱e̱t, tu̱msu̱ e̱ bu̱rgu̱sse̱ e̱ Ibram. <verse eid="GEN 13:11"/><verse number="12" style="v" sid="GEN 13:12"/>Ibram aru̱k u̱ gas-u̱ dak-u̱ Kan'ana, Ro̱t shu̱'u̱t u̱ gas-u̱ bo̱-tu̱ gi-yu̱ Jodan se̱ wa ku̱ u̱t-rimpa u̱ dapu̱s So̱do̱m. <verse eid="GEN 13:12"/><verse number="13" style="v" sid="GEN 13:13"/>Ne̱t-tu̱ bo̱-u̱ So̱do̱m ne̱t-u̱t yo̱-to̱ to̱ tu̱msu̱ e̱ o̱ yu̱-du̱ u̱t-ba'as sok u̱du̱ Yawe.<verse eid="GEN 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14"/>U̱-dim da-u̱ Ibram mo̱te̱ u̱ Ro̱t ne̱, Yawe zu̱ Ibram, &lt;&lt;Bir bo̱ gwat be-du̱ bo̱ o̱tte̱ u̱r-be̱e̱t. Gwat gas-u̱ kom u̱r-beer gas-u̱ kom u̱t-cwa ne̱, u-do̱m u-ta ne̱. <verse eid="GEN 13:14"/><verse number="15" style="v" sid="GEN 13:15"/>Me̱ ya'u̱ bo̱ dak-u u-no u-be̱e̱t, bo̱ u̱ ya'ag-u̱ ró ne̱ m-mo̱mmo̱. <verse eid="GEN 13:15"/><verse number="16" style="v" sid="GEN 13:16"/>Me̱ u̱t-wa ko̱-u̱r ró no̱m u-tát u̱ka tat-u̱ m-hereg! Wu̱ kere̱ o̱gru̱ hereg-mu̱ u-gi wa keru̱ o̱gru̱ u̱ ko̱-u̱t ró. <verse eid="GEN 13:16"/><verse number="17" style="v" sid="GEN 13:17"/>Yu̱ne̱ bo̱ nar dak-u o̱ u-be̱e̱t ko̱he̱ne̱, u̱m o̱ yasu̱ bo̱ o̱.&gt;&gt;<verse eid="GEN 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 13:18"/>Se̱ Ibram hast rimpa-u̱t wa, wa aru̱k, wa shu̱'u̱t u̱ dapu̱s se̱ke̱n te-u̱s yat-se̱ su̱ O̱k u̱ Mamre u̱ bo̱-u̱ He̱bro̱n. U̱ be-u̱r re̱, wa maate̱ Yawe u̱r-sak du̱ to̱o̱g.<verse eid="GEN 13:18"/></para>
  <chapter eid="GEN 13"/>
  <chapter number="14" style="c" sid="GEN 14"/>
  <para style="s1">Ibram gwu̱u̱g Ro̱t</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1"/>U̱ da-u o̱ gag-mu̱ yu̱nne̱ u̱ gas-u o̱. U̱ da-u̱ Amraper faru̱k-u̱ Shinar, u̱ Ariyo faru̱k-u̱ u̱ Erasar, u̱ Kedoramar faru̱k-u̱ Eram, u̱ Tidar faru̱k-u̱ Goyim, <verse eid="GEN 14:1"/><verse number="2" style="v" sid="GEN 14:2"/>e̱ ru u̱ remu̱ e̱ nom-u̱t m-gag u̱ Bera ne̱ faru̱k-u̱ So̱do̱m ne̱, Birha faru̱k-u̱ Gomora, Shinab faru̱k-u̱ Adma, u̱ Shimeba faru̱k-u̱ Zeboyim, u̱ faru̱k-u̱ Bera ne̱ Tu̱msu̱ ne̱t-tu̱ fog bo̱-u̱ Bera &lt;&lt;Zo̱war.&gt;&gt; <verse eid="GEN 14:2"/><verse number="3" style="v" sid="GEN 14:3"/>Tun-to̱ faru̱k-to̱ u̱t-tan e̱ same̱ ne̱t-tu̱ m-gagu̱ e̱ fu̱g-yu̱ Sidim &lt;&lt;yu̱ na foge̱ Sa-mu̱ u̱t-ma.&gt;&gt; <note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">o̱ na foge̱ sa-mu̱ m-mar.</char></note> <verse eid="GEN 14:3"/><verse number="4" style="v" sid="GEN 14:4"/>U̱s-hak o̱p u̱s-yu̱r e̱ o̱ do̱rru̱ Kedoramar faru̱k-u̱ Eram, se̱di u̱ hak-yu̱ o̱p u-tu̱tu̱rse̱ u̱n nom gu̱g-mu̱ u̱s-rem u̱ wa ne̱. <verse eid="GEN 14:4"/><verse number="5" style="v" sid="GEN 14:5"/>U̱ hak-yu̱ o̱p u̱s-nas [14], se̱ Kedoramar faru̱k-u̱ Eram u̱ farkina-ne̱ i o̱o̱ge̱ u̱r-kot u̱ wa ne̱, e̱ do̱'e̱ e̱ re ne̱t-tu̱ bo̱-u̱ Refatis m-gag u̱ bo̱-u̱ Asterot Karayin ne̱, u̱ ne̱t-tu̱ Zuzi-ne̱ u̱ bo̱-u̱ Ham, tu̱msu̱ ne̱t-tu̱ Emim-ne̱ ne̱ u̱ bo̱-u̱ She̱ve̱ u̱ Kiriyatim ne̱, <verse eid="GEN 14:5"/><verse number="6" style="v" sid="GEN 14:6"/>u̱ ne̱t-tu̱ Hori ne̱ u̱ do̱m-u̱ ro̱r-du̱ Seyir, m-sa gas-u̱ Er-paran-ne̱ u̱ dapu̱s u̱r-do̱g. <verse eid="GEN 14:6"/><verse number="7" style="v" sid="GEN 14:7"/>Se̱ u̱n mu̱u̱n u-dim u̱n do̱'e̱ u̱ bo̱-u̱ Mispat (du̱ na foge̱ u̱ da-u o̱ Kades). U̱n re gas-u̱ ne̱t-tu̱ Amerek o̱tte̱ u̱ shu̱'u̱t m-gag, tu̱msu̱ u̱r-kot u̱ Amoriya-ne̱ i o̱ shu̱'u̱t bo̱-u̱ Hazazon Tamar.<verse eid="GEN 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8"/>Se̱ farku̱ So̱do̱m u̱ farku̱ Gomora ne̱, u̱ faru̱k-u̱ Adma ne̱, u̱ faru̱k-u̱ Zeboyim ne̱ u̱ faru̱k-u̱ Bera (tu̱msu̱ u̱ na zu̱ye̱ Zo̱war) e̱ do̱'e̱ e̱ nom zo̱ng-su̱ m-gag fu̱g-yu̱ Sidim.<verse eid="GEN 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 14:9"/>E̱ ru e̱ nom m-gag u̱ Kedoramar ne̱ faru̱k-u̱ Eram, u̱ Tidar ne̱ faru̱k-u̱ Goyim, u̱ Amraper ne̱ faru̱k-u̱ Shinar, u̱r-kot u̱ Ariyo ne̱ faru̱k-u̱ Erasar. U̱t-faru̱k u̱t-nas to̱ nom m-gag u̱ faru̱k-tu̱ u̱t-tan ne̱. <verse eid="GEN 14:9"/><verse number="10" style="v" sid="GEN 14:10"/>Fu̱g-yu̱ Sidim otte̱ u̱t-kub u̱ u-rwabu̱r ne̱. Tu̱msu̱ da-u̱ faru̱k-u̱ So̱do̱m u̱ faru̱k-u̱ Gomora ne̱ ku̱sme̱, to̱ko̱n ne̱t-to̱ heemse̱ u-rwabu̱r tu̱msu̱ e̱ke̱n som m-da do̱m u̱t-ro̱r. <verse eid="GEN 14:10"/><verse number="11" style="v" sid="GEN 14:11"/>Faru̱k-tu̱ u̱t-nas e̱ ku̱b cwu̱-tu̱ ne̱t-tu̱ So̱do̱m u̱ Gomora ne̱ u̱ no̱m-tu̱ u̱t-re̱ e̱ ne̱ u̱t-be̱e̱t, se̱ e̱ yu̱ne̱ e̱ aru̱k. <verse eid="GEN 14:11"/><verse number="12" style="v" sid="GEN 14:12"/>Tu̱msu̱ u̱n maas Ro̱t wa'-u̱ yu̱wu̱ya Ibram. Ro̱t o̱ u̱ shu̱'u̱t u̱ So̱do̱m, tu̱msu̱ u̱n ku̱b no̱m-tu̱ wa otte̱ ne̱ u̱t-be̱e̱t.<verse eid="GEN 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13"/>Se̱di wa-gan u̱ te̱k-u̱ ne̱t-u̱t Ro̱t wa ku̱su̱m wa do̱'e̱ wa waru̱ Ibram no̱mu̱ u̱n no̱me̱ u-be̱e̱t u̱ ne̱t-u̱t Eber-ne̱. Da-u o̱ Ibram o̱ shu̱'u̱t u̱ dapu̱s te-u̱s yat-se̱ su̱ Mamre, ne̱tu̱ Amoriya-ne̱. Ibram no̱ng este̱du̱ u̱s-rem u̱ Mamre u̱ o̱r-u̱t wa ne̱ yu̱r Esko̱r u̱ Aner ne̱, e̱ same̱ u̱t-hi u̱ Ibram ne̱. <verse eid="GEN 14:13"/><verse number="14" style="v" sid="GEN 14:14"/>Da-u̱ Ibram ho̱ge̱ u̱zu̱ na maste̱ wa'-u̱ yu̱-wu̱ya wa Ro̱t, wa kargu̱sse̱ ne̱t-tu̱ na iise̱ m-gag ne̱t-tu̱ me̱ bu-u wa u̱t-ko̱k u̱t-tu̱t u̱ o̱p-u̱ eer [318]. E̱ yu̱ne̱ e̱ buz karma-ne̱ Kedoramar m-ha u̱ Dan. <verse eid="GEN 14:14"/><verse number="15" style="v" sid="GEN 14:15"/>Da-u̱ gyu̱p-mu̱ no̱me̱, Ibram mo̱t ne̱t-u̱t wa u̱t-kir u̱t-kir. E̱ he̱e̱se̱ karma-ne̱ u̱n m-gag ko̱yu̱he̱ gas-ya u̱n re e̱ m-gag. U̱n buz u̱n m-te Hoba, u̱ o̱o̱ge̱ u̱ m-eru̱g mu̱ kom u̱r-beer u̱ bo̱-u̱ Dimaskus ne̱. <verse eid="GEN 14:15"/><verse number="16" style="v" sid="GEN 14:16"/>Ibram o̱nku̱n no̱m-tu̱ na kabe̱ u̱t-be̱e̱t. Wa o̱nku̱n Ro̱t wa'-u̱ yu̱wu̱ya wa u̱ no̱m-tu̱ Ro̱t otte̱ ne̱ u̱t-be̱e̱t u̱ ne̱ta wa ne̱ u̱ to̱ku̱n ne̱t-to̱ ne̱.<verse eid="GEN 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17"/>Ba Ibram mu̱u̱ne̱ da wa tase̱ re̱-du̱ ne̱t-tu̱ Kedoramar u̱ ne̱t-u̱t wa ne̱ m-gag, faru̱k-u̱ So̱do̱m do̱'e̱ wa bit Ibram u̱ fu̱g-yu̱ She̱ve̱ (yu̱ na zu̱ye̱ Fu̱g-yu̱ Faru̱k).<verse eid="GEN 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 14:18"/>Merkize̱de̱k faru̱k-u̱ Sare̱m wa rwu̱tu̱n u̱r-be̱re̱di u̱ ke̱ ne̱. Wa o̱o̱ge̱ wa-to̱o̱g yu̱ u-Ru̱ wu̱ Zu̱ge̱ u̱r-Be̱b. <verse eid="GEN 14:18"/><verse number="19" style="v" sid="GEN 14:19"/>Se̱ wa wa'-u̱ Ibram nu-u so̱-o̱, wa zu̱,</para>
  <para style="q1" vid="GEN 14:19">&lt;&lt;Yage̱ u-Ru̱ wu̱ Ze̱ge̱ u̱r-Be̱b,</para>
  <para style="q2" vid="GEN 14:19">wu̱ no̱me̱ do̱m u-ru̱ u-dak-ne̱,</para>
  <para style="q1" vid="GEN 14:19">u̱ wa wa'-u̱ bo̱ nu-u so̱-o̱.<verse eid="GEN 14:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 14:20"/>Yage̱ na no̱mu̱ u-Ru̱ wu̱ ze̱ge̱ u̱t-vam,</para>
  <para style="q2" vid="GEN 14:20">wu̱ ya'u̱ bo̱ re̱-du̱ u̱r-ko̱rro̱</para>
  <para style="q1" vid="GEN 14:20">do̱m-u̱ hu̱u̱b-u̱t yo̱-to̱ ró.&gt;&gt;</para>
  <para style="m" vid="GEN 14:20">Se̱ Ibram yase̱ Merkize̱de̱k u̱r-kwu̱s u̱r-gan u̱ te̱k u̱t-o̱p u̱-me̱ no̱m-tu̱ wa o̱nko̱n u̱ kom-u̱t u̱n u̱t-be̱e̱t.<verse eid="GEN 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21"/>Se̱ faru̱k-u̱ So̱do̱m zu̱ Ibram, &lt;&lt;Mu̱tu̱n me̱ ne̱t-u̱t ri tu̱ na mase̱. Se̱di cinu̱ hi-du̱ war ró cwu̱-tu̱ bo̱ o̱nku̱n u̱t-be̱e̱t.&gt;&gt;<verse eid="GEN 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22"/>Se̱ Ibram zu̱ faru̱k-u̱ So̱do̱m, &lt;&lt;U̱m no̱ngu̱ Yawe este̱du̱ u̱s-rem, u-Ru̱ wu̱ Zu̱ge̱ u̱r-Be̱b, wu̱ nome̱ do̱m u-ru̱ u-dak-ne̱. <verse eid="GEN 14:22"/><verse number="23" style="v" sid="GEN 14:23"/>U̱m zu̱u̱g u̱m zaar u̱ kab-du̱ o̱ko̱n no̱m-o̱ du̱gu̱-du̱ ró da, ko̱ u-randi u-gan, ko̱ na-u̱ u-kaat u-gan, remu̱ zu̱ taas bo̱ zu̱, &lt;Me̱ wa wa'e̱ Ibram kum-u̱t no̱m u̱t-kom.&gt; <verse eid="GEN 14:23"/><verse number="24" style="v" sid="GEN 14:24"/>Me̱ o̱nk-u̱ no̱mu̱ ya'ag-u̱ be̱b-ne̱ ri i m-gag tase̱ u̱t-rees u̱ war-o. Tu̱msu̱ u̱m o̱ u̱ ko̱n-u̱s ró bo̱ ya' hu̱u̱b-u̱t ri Aner, Esko̱r, u̱ Mamre o̱g-du̱ cwu̱-tu̱ e̱ o̱nku̱n m-gag.&gt;&gt;<verse eid="GEN 14:24"/></para>
  <chapter eid="GEN 14"/>
  <chapter number="15" style="c" sid="GEN 15"/>
  <para style="s1">Este̱du̱ u̱s-rem su̱ <optbreak/> u-Ru̱ e̱ Ibram</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1"/>Ba da-u̱ arke̱, Yawe no̱m u̱s-rem u̱ Ibram ne̱ u̱ bo' u̱zu̱,</para>
  <para style="q1" vid="GEN 15:1">&lt;&lt;Ibram, a-bo̱ ho̱g u-gye̱r da,</para>
  <para style="q2" vid="GEN 15:1">remu̱ u̱zu̱ me̱ u̱t-e̱' bo̱,</para>
  <para style="q1" vid="GEN 15:1">o̱g-u̱r ró u̱t-no̱m u-tát.&gt;&gt;<verse eid="GEN 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2"/>Ibram zu̱, &lt;&lt;Yawe, U̱so-u̱ u-bu ri, ¿remu̱ re̱me̱r-mu̱ yan-o̱ bo̱ do̱te̱ ya'u̱ me̱ tun-to̱ no̱m-to̱ me̱ ya u̱m zatte̱ wa' da? Bo̱ yaag me̱ ya'ag da, ¿ko̱ Eriyazer du̱gu̱ Dimaskus, to̱k u-bu ri wa do̱'e̱ u̱ re̱-du̱ no̱m u̱t-kom-u̱ ri? <verse eid="GEN 15:2"/><verse number="3" style="v" sid="GEN 15:3"/>Bo̱ yaag me̱ ya'ag da, to̱k-u̱ u-bu ri de̱ shu̱'u̱tu̱ wa re̱-du̱ no̱m-u̱ u̱t-kom ri.&gt;&gt;<verse eid="GEN 15:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4"/>Se̱ Yawe no̱m u̱s-rem, &lt;&lt;Iya-o̱ da, to̱k-u̱ ró zaar u̱t-shu̱'u̱t wu̱ do̱'e̱ u̱ re̱-du̱ o̱g-du̱ u-bu ró da. Bo̱ do̱'e̱ u̱ kwu̱m-du̱ ya-du̱ u̱r-campa du̱ hi-u̱r ró wa do̱'e̱ u̱ re̱-du̱ no̱m-u̱ u̱t-kom tu̱ u-bu ró.&gt;&gt; <verse eid="GEN 15:4"/><verse number="5" style="v" sid="GEN 15:5"/>Wa-ko-uyan rwu̱tu̱n wu̱n u̱-do̱ wa zu̱ wu̱n, &lt;&lt;Jakse̱ is bo̱ gwat do̱m u-Ru̱ bo̱ ogor re̱ge̱r abite̱ bo̱ u̱t-ker. Iya-o̱ ko̱-u̱r ró do̱te̱ u̱t-shu̱'u̱t.&gt;&gt;<verse eid="GEN 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6"/>Se̱ Ibram ye jab u̱du̱ Yawe, tu̱msu̱ Yawe got wu̱n wa no̱m-du̱ no̱m-u̱t so̱-to̱ u̱ remu̱ yadu̱ jab-u̱ wu̱n u̱du̱ u-Ru̱.<verse eid="GEN 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7"/>Se̱ wa zu̱ wu̱n, &lt;&lt;Me̱ wa Yawe wu̱ rwu̱tu̱n bo̱ du̱gu̱ Ur dak-u̱ Kardiya-ne̱ remu̱ u̱m ye'et bo̱ uno̱ dak-o̱, o̱ shu̱'u̱t u̱ ró.&gt;&gt;<verse eid="GEN 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8"/>Se̱ Ibram shu̱s wa zu̱, &lt;&lt;U̱so-u̱ u-bu ri Yawe ¿re̱-o̱ u̱m do̱te̱ u̱t-nap u̱zu̱ dak-u uno̱ u̱t-shu̱'u̱t u̱ ri?&gt;&gt;<verse eid="GEN 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9"/>Yawe zu̱ wu̱n, &lt;&lt;Haatu̱n me̱ so̱-yu̱ u-na yu̱ u̱s-hak u̱s-tu̱t, u̱ so̱-yu̱ u-gwaar ne̱ yu̱ u̱s-hak u̱s-tu̱t, u̱ kag-yu̱ u-ca ne̱ yu̱ u̱s-hak u̱s-tu̱t, u̱r-gorop ne̱, u̱r-tu̱ntu̱bu̱r ne̱.&gt;&gt;<verse eid="GEN 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 15:10"/>Ibram haatu̱n no̱m-u̱t to u̱t-be̱e̱t u̱du̱ u-Ru̱. Se̱ wa kwu̱pu̱rse̱ bisa-u̱t to̱ wa mot to̱ u-yu̱r ho̱n-ho̱n wa cin to̱ ko̱wan m-gwat o̱r-u̱ wa. Se̱di wa kwu̱pu̱rte̱ no e̱ da. <verse eid="GEN 15:10"/><verse number="11" style="v" sid="GEN 15:11"/>Da-u̱ sagra he̱e̱ne̱ u-dak e̱ tu̱'u̱t ap-mu̱ no̱m-u̱t to̱, Ibram buz e̱.<verse eid="GEN 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12"/>Da-u̱ ho̱-du̱ do̱'e̱ m-he̱, roog-mu̱ ho Ibram, se̱ cwu̱m-yu̱ ya-du̱ u-gye̱r taku̱s wu̱n. <verse eid="GEN 15:12"/><verse number="13" style="v" sid="GEN 15:13"/>Se̱ Yawe zu̱ Ibram, &lt;&lt;Nap u̱zu̱ ko̱-u̱r ró u̱t-shu̱'u̱t u̱ka u̱t-hamu̱t u̱ dak-u̱ zaare̱ dak-u e̱ da. Na do̱'e̱ wadu̱ e̱ m-to̱k tu̱msu̱ e̱ do̱'e̱ swadu̱ u̱r-ko̱b u̱s-hak u̱t-ko̱k u̱t-nas [400]. <verse eid="GEN 15:13"/><verse number="14" style="v" sid="GEN 15:14"/>Se̱di me̱ u̱t-ya dak-u̱ u̱n no̱me̱ m-to̱k u̱r-ko̱b, da tase̱ u̱m do̱'e̱ u̱t-wa u̱n ru du̱gu̱ dak-u o̱ u̱ no̱m-u̱ u̱t-kwu̱m ne̱ u-tát. <verse eid="GEN 15:14"/><verse number="15" style="v" sid="GEN 15:15"/>Bo̱ tu̱msu̱, bo̱ u̱t-ha u̱du̱ u̱so-u̱t ró m-yar tu̱msu̱ na do̱'e̱ u̱ jwak-du̱ bo̱ u̱ teku̱ wu̱u̱r so̱-de̱. <verse eid="GEN 15:15"/><verse number="16" style="v" sid="GEN 15:16"/>Ba te̱k-u̱ cara-u u-nasu̱rse̱<note caller="+" style="f"><char style="fr" closed="false">15:16 </char><char style="ft" closed="false">u-cara u-gan o̱ u̱s-hak u-ko̱k u-gan.</char></note> ko̱-u̱r ró do̱'e̱ u̱t-mu̱u̱n u̱ ane̱, tu̱msu̱ e̱ kab dak-u uno̱ u̱ e̱ re ne̱t-tu̱ Amoriya-ne̱ m-gag remu̱ zu̱ ba'as-tu̱ ne̱t-u̱t to̱ shu̱u̱g u-ro ne̱ da u̱ na do̱te̱ ya-du̱ e̱ u̱r-ko̱b da.&gt;&gt;<verse eid="GEN 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17"/>Da-u̱ ho̱-du̱ he̱ye̱ dak-u̱ no̱ngo̱n u-cwu̱m, se̱ Ibram hyen rem-du̱ u-ra u̱ rwu̱du̱ m-fu̱'u̱t u̱ u-ra ne̱ u̱ o̱ m-to̱k de̱ rwu̱u̱n, de̱ haan de̱ o̱ m-da u̱ te̱k-u̱ ap-mu̱ Ibram keme̱. <verse eid="GEN 15:17"/><verse number="18" style="v" sid="GEN 15:18"/>U̱ ho̱-u̱r re, Yawe no̱m este̱du̱ u̱s-rem u̱ Ibram ne̱ wa zu̱, &lt;&lt;Me̱ ya'u̱ ya'ag-u̱ ró uno̱ dak-o̱, du̱gu̱ gi-yu̱ Masar m-ha u̱ gi-u yat-ya yu̱ Yupireti ne̱. <verse eid="GEN 15:18"/><verse number="19" style="v" sid="GEN 15:19"/>Me̱ u̱t-ya bo̱ dak-u̱ Keni-ne̱, u̱ Kenizi-ne̱, u̱ Kadmona-ne̱, <verse eid="GEN 15:19"/><verse number="20" style="v" sid="GEN 15:20"/>u̱ ne̱t-tu̱ He̱t-ne̱, u̱ Periziya-ne̱, u̱ Rifatis-ne̱, <verse eid="GEN 15:20"/><verse number="21" style="v" sid="GEN 15:21"/>u̱ Amoriya-ne̱, u̱ Kan'ana-ne̱, u̱ Giragashi-ne̱, u̱ Jebusi-ne̱.&gt;&gt;<verse eid="GEN 15:21"/></para>
  <chapter eid="GEN 15"/>
  <chapter number="16" style="c" sid="GEN 16"/>
  <para style="s1">Hajaratu ne̱ e̱ Ismaru</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1"/>Sera ne̱ta Ibram, wa mak-tu̱ wa yaag da, se̱di wa o̱tte̱ to̱k-u̱ ne̱ta wu̱ o̱o̱ge̱ ne̱tu̱ dak-u̱ Masar wu̱ na zu̱ye̱ Hajara. <verse eid="GEN 16:1"/><verse number="2" style="v" sid="GEN 16:2"/>Sera zu̱ Ibram, &lt;&lt;Yawe hooste̱ me̱ u̱r-mat, cwa bo̱ roog u̱ to̱k-u̱ ri ne̱, jiya me̱ u̱t-kwu̱m yaag du̱gu̱-du̱ wa.&gt;&gt;</para>
  <para style="p" vid="GEN 16:2">Ibram ees u̱ no̱mu̱ Sera waru̱ wa ne̱. <verse eid="GEN 16:2"/><verse number="3" style="v" sid="GEN 16:3"/>Da-u̱ Ibram no̱me̱ u̱s-hak u̱s-o̱p u̱ shu̱'u̱t dak-u̱ Kan'ana, Sera, ne̱ta wa, ku̱b Hajara wu̱ Masar wa yasu̱ Ibram u̱ wa shu̱'u̱t ne̱ta wa. <verse eid="GEN 16:3"/><verse number="4" style="v" sid="GEN 16:4"/>Ibram roog u̱ Hajara ne̱, wa nom me̱n-tu̱ ub.</para>
  <para style="p" vid="GEN 16:4">Da-u̱ Hajara hyane̱ u̱zu̱ wa u̱t-me̱n ne̱, wa hu̱ u̱ ju̱rmu̱ ino-u̱ u-bu wa. <verse eid="GEN 16:4"/><verse number="5" style="v" sid="GEN 16:5"/>Sera zu̱ Ibram, &lt;&lt;Bo̱ wa wa-e̱ uno̱ no̱m o̱ u-be̱e̱t. U̱m ya'aste̱ bo̱ Hajara, da-u̱ wa hyane̱ wa kwu̱mu̱g me̱n-tu̱ ub wa hu̱ u̱ ju̱rmu̱ me̱. Yage̱ Yawe no̱mu̱ in kwu̱b-du̱ u̱s-rem u̱ no̱m-u uno̱ u̱ bo̱ no̱mu̱ me̱.&gt;&gt;<verse eid="GEN 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6"/>Ibram shasu̱ Sera, &lt;&lt;To̱k-u̱ ró wa, no̱mu̱ wu̱n u̱ka cittu̱ bo̱.&gt;&gt; Se̱ Sera hu̱ ko̱su̱ wu̱n m-to̱k, se̱ Hajara som du̱gu̱-du̱ wa.<verse eid="GEN 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7"/>Wa-to̱m-u̱ Yawe<note caller="+" style="f"><char style="fr" closed="false">16:7 </char><char style="ft" closed="false">Wa-to̱m-u̱ Yawe unwa wu̱ haane̱ Ru̱-o̱ ko̱se̱ hi-u̱r wa u̱-me wa-u̱ ne̱.</char></note> hyen Hajara u̱ kit-u̱ pe̱r-mu̱ m-bu̱ u̱r-do̱g, u̱ dapu̱s fu̱n-yu̱ ha-mu̱ bo̱-u̱ Shur. <verse eid="GEN 16:7"/><verse number="8" style="v" sid="GEN 16:8"/>Wa zu̱, &lt;&lt;Hajara to̱k-u̱ Sera ¿du̱gu̱ he̱ne̱ o̱ bo̱ o̱o̱ne̱, tu̱msu̱ he̱ bo̱ o̱tte̱ m-ha?&gt;&gt;</para>
  <para style="p" vid="GEN 16:8">Wa zu̱, &lt;&lt;U̱m so̱mgo̱n du̱gu̱-du̱ ino-u̱ u-bu ri Sera.&gt;&gt;<verse eid="GEN 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9"/>Wa-to̱m Yawe zu̱ wu̱n, &lt;&lt;Barme̱ u̱du̱ ino-u̱ u-bu ró, bo̱ yase̱ hi-u̱r ró u̱du̱ wa.&gt;&gt; <verse eid="GEN 16:9"/><verse number="10" style="v" sid="GEN 16:10"/>Wa-to̱m Yawe sur m-zu̱ wu̱n, &lt;&lt;Me̱ u̱t-wa ya'ag-u̱ ró no̱m u-tát, na za ke̱rru̱ ogru̱ e̱ da.&gt;&gt;<verse eid="GEN 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 16:11"/>Wa-to̱m Yawe zu̱ wu̱n,</para>
  <para style="q1" vid="GEN 16:11">&lt;&lt;Bo̱ ya me̱n-tu̱ ub ne̱,</para>
  <para style="q2" vid="GEN 16:11">bo̱ do̱'e̱ u̱ mat-du̱ ya-du̱ u̱r-campa.</para>
  <para style="q1" vid="GEN 16:11">Bo̱ te̱'e̱ wa'-u̱ wa u̱r-dim Ismaru,<note caller="+" style="f"><char style="fr" closed="false">16:11 </char><char style="ft" closed="false">no̱mu̱ na zu̱ye̱ Ru̱-u̱ hokos.</char></note></para>
  <para style="q2" vid="GEN 16:11">remu̱ zu̱ Yawe ho̱k kan-u̱s rò</para>
  <para style="q1" vid="GEN 16:11">su̱ swadu̱ u̱r-ko̱b ro ne̱.<verse eid="GEN 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 16:12"/>Wa do̱'e̱ u̱t-shu̱'u̱t u̱ka</para>
  <para style="q2" vid="GEN 16:12">janka-yu̱ u̱r-do̱g<note caller="+" style="f"><char style="fr" closed="false">16:12 </char><char style="ft" closed="false">No̱m-u̱ na o̱ u̱t-war wa de̱ no̱m-du̱ u̱r-yu̱ du̱ waku̱n zaar wu̱ do̱'e̱ dor-tu̱ wa da.</char></note> yu̱ ne̱t,</para>
  <para style="q1" vid="GEN 16:12">Tu̱msu̱ wa do̱'e̱ u̱ no̱m-du̱</para>
  <para style="q2" vid="GEN 16:12">shu̱'u̱t-u̱r yo̱-de̱ u̱ ko̱wan ne̱,</para>
  <para style="q1" vid="GEN 16:12">ko̱wan do̱'e̱ u̱ no̱m-du̱ shu̱'u̱t-u̱r</para>
  <para style="q2" vid="GEN 16:12">yo̱-de̱ u̱ wu̱n ne̱.</para>
  <para style="q1" vid="GEN 16:12">Wa do̱'e̱ u̱t-shu̱'u̱t</para>
  <para style="q2" vid="GEN 16:12">m-ra u̱ o̱r-u̱t wa ne̱.&gt;&gt;<verse eid="GEN 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13"/>Du̱gu̱ ku̱n, Hajara fog Yawe u̱ de̱ku̱n dimde̱, wu̱ no̱me̱ u̱s-rem u̱ wane̱, wa zu̱, &lt;&lt;Bo̱ wa u-Ru̱ u̱ hyene̱ me̱.&gt;&gt; Wa sur m-zu̱, &lt;&lt;¿Nip-to̱ u̱zu̱ u̱m hyanu̱g wu̱ hyene̱ me̱?&gt;&gt; <verse eid="GEN 16:13"/><verse number="14" style="v" sid="GEN 16:14"/>Remu̱ iya-o̱ wu̱te̱ na fog-u̱t du-u̱r re̱ Beer-Rahai Roi, wata &lt;&lt;Ru̱-u̱ u̱r-fat wu̱ hyene̱ me̱.&gt;&gt; De̱ o̱ u̱ku̱n u̱ te̱k-u̱ bo̱-tu̱ Kades u̱ Bered ne̱.<verse eid="GEN 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15"/>Hajara matu̱ Ibram ya-du̱ u̱r-campa, Ibram te̱'e̱ wa u̱r-dim Ismaru. <verse eid="GEN 16:15"/><verse number="16" style="v" sid="GEN 16:16"/>Ibram o̱o̱g u̱s-hak u̱t-shik u̱t-nas u̱s-shishin [86] da-u̱ Hajara matu̱ wa Ismaru.<verse eid="GEN 16:16"/></para>
  <chapter eid="GEN 16"/>
  <chapter number="17" style="c" sid="GEN 17"/>
  <para style="s1">Este̱du̱ u̱s-rem su̱ u̱r-pe̱s</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1"/>Da-u̱ Ibram no̱me̱ u̱s-hak u̱t-shik u̱t-nas u̱ o̱p u̱s-jwu̱u̱r [99], Yawe haan u̱du̱ wu̱n wa zu̱ wu̱n, &lt;&lt;Me̱ wa Yawe u-Ru̱ wu̱ o̱tte̱ be̱b-du̱ ko̱-uyan, no̱mu̱ me̱ m-to̱k u-me̱ jab-u̱ so̱-o̱ tu̱msu̱ bo̱ shu̱'u̱t za u̱r-pyap. <verse eid="GEN 17:1"/><verse number="2" style="v" sid="GEN 17:2"/>Me̱ u̱t-no̱m este̱du̱ u̱s-rem u̱ bo̱ ne̱, me̱ u̱t-wa ko̱-u̱r ró e̱ no̱m u-tát sok.&gt;&gt;<verse eid="GEN 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 17:3"/>Se̱ Ibram kaku̱s hi-u̱r wa u-dak, tu̱msu̱ Ru̱-u̱ zu̱ wa, <verse eid="GEN 17:3"/><verse number="4" style="v" sid="GEN 17:4"/>&lt;&lt;Este̱du̱ u̱s-rem-u̱ ri ya u̱ bo̱ ne̱, ne̱t-tu̱ u̱t-dak u-tát to̱ do̱'e̱ u̱t-shu̱'u̱t ko̱-u̱t ró. <verse eid="GEN 17:4"/><verse number="5" style="v" sid="GEN 17:5"/>Na zamu̱n u̱ fag-du̱ bo̱ Ibram da, dim-u̱r ró do̱'e̱ u̱t-shu̱'u̱t Ibrahi, rem u̱zu̱ u̱m wa'ag bo̱ shu̱'u̱t u̱so u̱ u̱t-dak u-tát. <verse eid="GEN 17:5"/><verse number="6" style="v" sid="GEN 17:6"/>Me̱ u̱t-wa bo̱ mat yaag u-tát, ya'ag-u̱ ró do̱'e̱ u̱t-shu̱'u̱t u̱t-dak u-tát, du̱gu̱-du̱ ró de̱ faru̱k-tu̱ do̱te̱ u̱ rwu̱u̱n. <verse eid="GEN 17:6"/><verse number="7" style="v" sid="GEN 17:7"/>Me̱ u̱t-no̱m este̱du̱ u̱s-rem su̱ m-mo̱mmo̱ u̱ bo̱ ne̱ tu̱msu̱ u̱ ya'ag-u̱ ró ne̱ u̱ ko̱-u̱r ró du̱ do̱'e̱ u̱ haan ne̱. U̱m shu̱'u̱t Ru̱-u ró u̱ Ru̱-u̱ ko̱-u̱t ró ne̱ tu̱ do̱'e̱ u̱ haan u̱ dim-u̱ ró. <verse eid="GEN 17:7"/><verse number="8" style="v" sid="GEN 17:8"/>Dak-u̱ Kan'ana u-be̱e̱t, u̱ bo̱ o̱o̱ge̱ shu̱'u̱t-du̱ u̱r-hamu̱t o̱, me̱ ya'u̱ bo̱ dak-u o̱ u̱ o̱ shu̱'u̱t u̱ ró m-mo̱mmo̱ u̱ ya'ag-u̱ ró ne̱ i do̱'e̱ haan u̱ dim-u̱ ró, me̱ u̱t-shu̱'u̱t Ru̱-u e̱.&gt;&gt;<verse eid="GEN 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9"/>Ru̱-u̱ zu̱ Ibrahi, &lt;&lt;Se̱di bo̱ u̱m u̱t-sa bo̱ ship este̱du̱ u̱s-rem-u ri, bo̱ u̱ ko̱-u̱t ró ne̱ be̱e̱t i do̱'e̱ u̱ haan u̱ dim-u̱ ró remu̱ dak-tu̱ de̱ haan. <verse eid="GEN 17:9"/><verse number="10" style="v" sid="GEN 17:10"/>Este̱du̱ u̱s-rem u̱ ri ya su̱ u̱m o̱o̱ge̱ u̱t-no̱m u̱ bo̱ ne̱ u̱ ya'ag-u̱ ró ne̱, ya-du̱ u̱r-campa u̱r-be̱e̱t se̱ na no̱ngu̱ de̱ u̱r-pe̱s. <verse eid="GEN 17:10"/><verse number="11" style="v" sid="GEN 17:11"/>Se̱ na no̱ngu̱ no̱ u̱r-pe̱s, u̱t-ko̱se̱ u̱zu̱ u̱m no̱ng este̱du̱ u̱s-rem u̱ no̱ ne̱. <verse eid="GEN 17:11"/><verse number="12" style="v" sid="GEN 17:12"/>Du̱gu̱ u-cara m-te̱ o̱ko̱n cara-o̱, ya-du̱ u̱r-campa u̱r-be̱e̱t se̱ na no̱ngu̱ de̱ u̱r-pe̱s u̱ ho̱-du̱ roog-mu̱ u̱t-eer u̱r-mat ne̱. Za ya-ubu ró ne̱ war-e̱ da tu̱msu̱ u̱ to̱k-ne̱ i na mate̱ bu-u ró tu̱msu̱ u̱ to̱k-ne̱ i bo̱ o̱ne̱ u̱ shik du̱gu̱ do̱ i mate̱. <verse eid="GEN 17:12"/><verse number="13" style="v" sid="GEN 17:13"/>Se̱ na no̱ngu̱ e̱ be̱e̱t u̱r-pe̱s, ko̱ i na mate̱ bu-u̱t no̱ ko̱ i na o̱ne̱ u̱ shik, war-u̱t no̱ do̱'e̱ ko̱se̱-du̱ sha-mu̱ este̱du̱ rem-u̱s ri su̱ m-mo̱mmo̱. <verse eid="GEN 17:13"/><verse number="14" style="v" sid="GEN 17:14"/>Campa u-be̱e̱t wu̱ na no̱me̱ u̱r-pe̱s da, na ruutu̱ wa du̱gu̱ o̱r-u̱t wa remu̱ zu̱ wa paku̱s este̱du̱ u̱s-rem.&gt;&gt;<verse eid="GEN 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15"/>Se̱ Ru̱-u̱ sur m-no̱m u̱s-rem u̱ Ibrahi ne̱, &lt;&lt;Ne̱ta ró Sera na za u̱t-swu̱r m-fag wa Sera da, dim-u̱r wa do̱'e̱ u̱t-shu̱'u̱t &lt;Saratu.&gt; <verse eid="GEN 17:15"/><verse number="16" style="v" sid="GEN 17:16"/>Me̱ wa'-u̱ wu̱n nu-u so̱-o̱, me̱ u̱t-wa wu̱n matu̱ bo̱ ya-du̱ u̱r-campa. Me̱ wa'-u̱ Saratu nu-u so̱-o̱, tu̱msu̱ ne̱t-tu̱ u̱t-dak u-tát to̱ shu̱'u̱t ko̱-u̱t ró, faru̱k-tu̱ do̱'e̱ u̱ rwu̱u̱n du̱gu̱-du̱ ko̱-u̱r Saratu.&gt;&gt;<verse eid="GEN 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17"/>Ibrahi kaku̱s hi-u̱r wa u-dak. Wa no̱m u̱t-nu̱mu̱s wa o̱ u̱s-dorog jab-u̱ wa, wa zu̱, &lt;&lt;¿U̱t-no̱me̱ ne̱nge̱n-yu̱ u̱s-hak u̱t-shik u̱t-tan [100] nazu wa shu̱'u̱te̱ u̱so u̱ wa'? ¿U̱t-no̱me̱ Saratu u̱t-shik u̱t-nas u̱ o̱p [90] na zu̱ wa maku̱t u̱r-ya?&gt;&gt; <verse eid="GEN 17:17"/><verse number="18" style="v" sid="GEN 17:18"/>Ibrahi zu̱ u-Ru̱, &lt;&lt;Yage̱ Ismaru u̱ kum nu-u so̱-o̱ u̱du̱ ró!&gt;&gt;<verse eid="GEN 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19"/>Se̱di Ru̱-u̱ zu̱, &lt;&lt;E̱, ne̱ta ró Saratu wa matu̱ bo̱ ya-du̱ u̱r-campa. Bo̱ te̱'e̱ wa u̱ wa u̱r-dim Ishaku. Me̱ shu̱su̱ este̱du̱ u̱s-rem su̱ u̱m no̱me̱ u̱ bo̱ ne̱ u̱du̱ ko̱-u̱r wa. Este̱du̱ u̱s-rem se̱ u̱t-shu̱'u̱t m-mo̱mmo̱ u̱du̱ wa u̱ ko̱-u̱r wa ne̱. <verse eid="GEN 17:19"/><verse number="20" style="v" sid="GEN 17:20"/>Se̱di ko̱n-u̱s ró mo̱ttu̱ Ismaru ne̱, u̱m ho̱k ko̱n-u̱s ró. Me̱ wa'-u̱ wu̱n nu-u so̱-o̱ tu̱msu̱ me̱ ya'u̱ wu̱n yaag u-tát. Me̱ u̱t-wa ya'ag-u̱ wu̱n e̱ no̱m u-tát. Wa u̱t-shu̱'u̱t u̱so u̱t-faru̱k o̱p u̱ u̱t-yu̱r. Me̱ u̱t-ya wu̱n u̱t-ko̱ u-tát wu̱ do̱'e̱ u̱t-shu̱'u̱t dak-u yat-o̱. <verse eid="GEN 17:20"/><verse number="21" style="v" sid="GEN 17:21"/>Se̱di este̱du̱ u̱s-rem-u̱ ri u̱ Ishaku ne̱. Hak-yu̱ o̱o̱ne̱, Saratu do̱'e̱ matu̱ bo̱ Ishaku.&gt;&gt; <verse eid="GEN 17:21"/><verse number="22" style="v" sid="GEN 17:22"/>Da-u̱ Ru̱-u̱ tase̱ u̱s-rem u̱ Ibrahi ne̱, se̱ wa aru̱k.<verse eid="GEN 17:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23"/>U̱ gandi ho̱-u̱r de̱, Ibrahi ku̱b wa'-u̱ wa Ismaru, u̱ yaag-u̱ campa-ne̱ be̱e̱t i o̱o̱ge̱ bu-u wa, u̱r-kot i na mate̱ ne̱ bu-u wa, tu̱msu̱ u̱ i wa o̱o̱ne̱-ne̱. Se̱ wa no̱mu̱ e̱ u̱r-pe̱s be̱e̱t, ka Ru̱-u̱ zu̱tte̱ wa no̱m. <verse eid="GEN 17:23"/><verse number="24" style="v" sid="GEN 17:24"/>Da-u̱ na no̱mu̱ Ibrahi u̱r-pe̱s, wa o̱o̱g u̱s-hak u̱t-shik u̱t-tan za u-gan [99]. <verse eid="GEN 17:24"/><verse number="25" style="v" sid="GEN 17:25"/>Da-u o̱ wa'-u̱ wa Ismaru o̱ u̱s-hak u̱s-o̱p u̱s-tu̱t da-u̱ na no̱mu̱ wa u̱r-pe̱s [13]. <verse eid="GEN 17:25"/><verse number="26" style="v" sid="GEN 17:26"/>U̱ gandi ho̱-du̱ u̱r-ganu̱ de̱, na no̱mu̱ Ibrahi ne̱ e̱ Ismaru u̱r-pe̱s. <verse eid="GEN 17:26"/><verse number="27" style="v" sid="GEN 17:27"/>Campa-ne̱ be̱e̱t i o̱o̱ge̱ me̱ bu-u Ibrahi, u̱ i na o̱o̱ne̱ ne̱ u̱ shik du̱gu̱ do̱, na no̱mu̱ e̱ u̱r-pe̱s u̱ wa ne̱.<verse eid="GEN 17:27"/></para>
  <chapter eid="GEN 17"/>
  <chapter number="18" style="c" sid="GEN 18"/>
  <para style="s1">Ru̱-u̱ no̱ngu̱ Sera <optbreak/> este̱du̱ u̱s-rem su̱ u̱r-ya</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1"/>Da-u̱ Ibrahi o̱o̱ge̱ u̱ shu̱'u̱t u̱ is-yu̱ cwadu̱ rimpa-u̱r wa u̱ da-u̱ ho̱-yu̱ du̱nge̱ sok, Yawe haan u̱du̱ Ibrahi u̱ dapu̱s se̱ke̱n te-u̱s yat-se̱ su̱ O̱k su̱ Mamre. <verse eid="GEN 18:1"/><verse number="2" style="v" sid="GEN 18:2"/>Se̱ Ibrahi jaku̱s is u-ru̱ wa hyen ne̱t-ne̱ tu̱t u̱ ees u̱ dapu̱s wa. Da-u̱ wa hyane̱ u̱n, se̱ wa ku̱su̱m m-so̱m du̱gu̱ is-yu̱ rimpa-u̱r wa m-ha u̱du̱ u̱n. Wa he̱ u̱t-kwu̱ku̱t u-dak u̱ yadu̱ m-ze̱g.<verse eid="GEN 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 18:3"/>Ibrahi zu̱, &lt;&lt;U̱so-u̱ u-bu ri, a u̱m kume̱ hyu̱-m pusmo̱ u̱du̱ ró, a-bo̱ aru̱k bu-u ri da. <verse eid="GEN 18:3"/><verse number="4" style="v" sid="GEN 18:4"/>Yagu̱n na haatu̱n no̱ m-bu̱, u̱ no̱ jaas na-u̱s no̱, u̱ no̱ hure̱ u̱ kug-du̱ te-u inya. <verse eid="GEN 18:4"/><verse number="5" style="v" sid="GEN 18:5"/>Yage̱ u̱m haatu̱n no̱ no̱m u̱t-re̱ u̱ no̱ re̱, ko̱ no̱ kumu̱ be̱b-du̱ u̱r-no̱k. Bashu̱te̱ no̱ haagu̱n u̱ bu-u̱ to̱k-u̱ no̱, yagu̱n u̱m no̱m iya.&gt;&gt;</para>
  <para style="p" vid="GEN 18:5">U̱n zu̱, &lt;&lt;No̱nge̱, no̱m u̱ka cittu̱ bo̱.&gt;&gt;<verse eid="GEN 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6"/>Ibrahi aru̱k m-mu̱ m-so̱m u̱ rimpa-u̱r wa. Wa zu̱ Saratu, &lt;&lt;No̱m m-ho̱r, bo̱ kab ko̱k-tu̱ m-hyu̱ u̱t-tu̱t, bo̱ kwu̱u̱t to̱, bo̱ no̱m u̱t-kak.&gt;&gt;<verse eid="GEN 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 18:7"/>Se̱ Ibrahi do̱'e̱ u̱du̱ ban-du̱ bisa-u̱t wa, wa du̱g gob-du̱ u-na du̱ o̱ so̱-de̱ wa yasu̱ to̱k-u̱ wa, se̱ to̱k-u̱ wa do̱'e̱ wa ho̱ tu̱msu̱ wa mang ya m-ho̱r m-ho̱r. <verse eid="GEN 18:7"/><verse number="8" style="v" sid="GEN 18:8"/>Da-u̱ na tase̱ no̱m-du̱ no̱m u̱t-re̱, Ibrahi ku̱b no̱mtu̱ m-be̱ngu m-me̱ ne̱ u̱ ap-mu̱ na mange̱ mo̱ ne̱, wa hu̱u̱tu̱ hamu̱t-u̱t wa. Da-u̱ u̱n o̱ te̱k-u̱ re̱-du̱ no̱m u̱t-re̱, Ibrahi ees u̱ kit-u̱ u̱n u̱ dapu̱s yaku̱n te-ya.<verse eid="GEN 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9"/>Da-u̱ u̱n tase̱ re̱-du̱ no̱m u̱t-re̱, u̱n shit wa, &lt;&lt;¿Ne̱ta ró Saratu yu̱?&gt;&gt;</para>
  <para style="p" vid="GEN 18:9">Wa zu̱ u̱n, &lt;&lt;Wa o̱ me̱n-tu̱ u̱r-rimpa.&gt;&gt;<verse eid="GEN 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10"/>Wa-gan u̱ te̱k-u̱ ne̱t-u̱t to̱ wa zu̱, &lt;&lt;Hak-yu̱ o̱ne̱ badane̱, u̱m o̱ u̱ mu̱u̱n u̱du̱ ró, Saratu ne̱ta ró wa u̱t-kab u̱r-ya.&gt;&gt;</para>
  <para style="p" vid="GEN 18:10">Saratu o̱ u̱ e̱rru̱ wu̱n u̱ u̱r-rimpa. <verse eid="GEN 18:10"/><verse number="11" style="v" sid="GEN 18:11"/>U̱ da-u o̱ Saratu ne̱ e̱ Ibrahi e̱ wu̱u̱mte̱, Saratu yakke̱ hyan-du̱ u-pyaat. <verse eid="GEN 18:11"/><verse number="12" style="v" sid="GEN 18:12"/>Saratu no̱m u̱t-nu̱mu̱s u̱ war-wa u̱zu̱, &lt;&lt;U̱r-wu̱ ba me̱ ne̱, tu̱msu̱ u̱so u-bu ri wa wu̱mte̱ ko̱wa. ¿U̱m zamtu̱n m-ho̱g zwarru̱ m-roog u̱ campa-ne̱ u̱m do̱te̱ u̱r-mat da?&gt;&gt;<verse eid="GEN 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13"/>Se̱ Yawe zu̱ Ibrahi, &lt;&lt;¿Yan o̱ wa'e̱ Saratu u̱t-nu̱mu̱s? ¿Remu̱ yan-o̱ wa zu̱tte̱, &lt;U̱r-mang ba me̱ ne̱ u̱t-kab u̱r-ya?&gt; <verse eid="GEN 18:13"/><verse number="14" style="v" sid="GEN 18:14"/>¿Oko̱n o̱ro u̱ ze̱ge̱ be̱b-u̱r Yawe? Me̱ u̱t-mu̱u̱n m-moon u̱ go̱-du̱ da-u uno̱, Saratu u̱t-kab u̱r-ya du̱ u̱r-campa.&gt;&gt;<verse eid="GEN 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15"/>Saratu hog u-gye̱r, wa no̱m m-se mu̱ no̱mu̱ wa ware̱. Wa zu̱, &lt;&lt;U̱m nu̱mu̱ste̱ da.&gt;&gt;</para>
  <para style="p" vid="GEN 18:15">Se̱di Yawe zu̱ wu̱n, &lt;&lt;Bo̱ no̱ng u̱t-nu̱mu̱s.&gt;&gt;<verse eid="GEN 18:15"/></para>
  <para style="s1">Ibrahi no̱ng u̱s-ko̱n u̱ <optbreak/> remu̱ So̱do̱m</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16"/>Da-u̱ ne̱t-ne̱ tu̱t-u̱ e̱ yu̱ne̱ u̱r-aru̱k, Ibrahi shu̱'u̱ u̱n. Da-u̱ u̱n o̱ te̱k-u̱ u̱r-no̱k u̱ fu̱n-u u̱n, u̱n teen de̱ku̱n be-de̱. E̱ gwatu̱n u-dak u-fu̱g, e̱ hyen bo̱-u̱ So̱do̱m. <verse eid="GEN 18:16"/><verse number="17" style="v" sid="GEN 18:17"/>Se̱ Yawe zu̱ hi-u̱r wa, &lt;&lt;No̱ng u̱r-zwar u̱zu̱ u̱m yase̱ Ibrahi no̱m-u̱ u̱m zo̱nge̱ u̱t-no̱m da. <verse eid="GEN 18:17"/><verse number="18" style="v" sid="GEN 18:18"/>Ko̱-u̱r Ibrahi u̱t-shu̱'u̱t dak-u yat-o̱ tu̱msu̱ u̱r-be̱b ne̱ so̱k, tu̱msu̱ dak-tu̱ u-dak u-be̱e̱t u̱t-kwu̱m nu-u so̱-o̱ du̱gu̱-du̱ wa. <verse eid="GEN 18:18"/><verse number="19" style="v" sid="GEN 18:19"/>U̱m dak Ibrahi remu̱ zu̱ wa wartu̱ ya'ag-u̱ wa u̱ a bu-u wa ne̱ i do̱'e̱ u̱ haan u̱ dim-u̱ wa e̱ ship fu̱n-u̱ Yawe, u̱ remu̱ no̱m-du̱ no̱m-tu̱ o̱ tu̱ so̱-to̱ u̱r-zwar ne̱. U̱ da-u o̱ u̱m do̱'e̱ no̱mu̱ Ibrahi no̱m-u̱ u̱m nomte̱ este̱du̱ u̱s-rem.&gt;&gt;<verse eid="GEN 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20"/>Se̱ Yawe waru̱ Ibrahi, &lt;&lt;U̱m ho̱k u̱s-rem u-tát su̱ nom-u̱t yo̱-to̱ u̱ mo̱ttu̱ So̱do̱m u̱ Gomora ne̱, remu̱ zu̱ ba'as-u̱t e̱ no̱ng u-tát. <verse eid="GEN 18:20"/><verse number="21" style="v" sid="GEN 18:21"/>U̱m do̱'e̱ u̱t-cu̱zu̱n u̱m hyan ko̱ u̱zu̱ ko̱ yu̱r u̱n no̱ng u̱ yo̱-de̱ u̱ka u̱m ho̱kte̱ re̱, u̱m u̱t-sa u̱m nap.&gt;&gt;<verse eid="GEN 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22"/>Se̱ ne̱t-u̱t to̱ aru̱k du̱gu̱ ku̱n m-ha So̱do̱m, se̱di Yawe kus u̱ ees u̱-shu̱ Ibrahi. <verse eid="GEN 18:22"/><verse number="23" style="v" sid="GEN 18:23"/>Ibrahi hikne̱ u̱ kit-u̱ wu̱n. Wa zu̱, &lt;&lt;¿Bo̱ ho̱rru̱sse̱ a-jab-u̱s so̱-se̱ ne̱ u̱ a-za-jab-u̱s yo̱-se̱ ne̱? <verse eid="GEN 18:23"/><verse number="24" style="v" sid="GEN 18:24"/>A-na kume̱ ne̱t-ne̱ a-jab-u̱s so̱-se̱ ne̱ u̱t-shik u̱t-yu̱r u̱ o̱p [50] u-bo̱, ¿bo̱ ho̱ru̱sse̱ u̱n be̱e̱t bo̱ za yage̱ e̱ u̱ remu̱ ne̱t-ne̱ u̱t-shik u̱t-yu̱r u̱ o̱p a-jab-u̱s so̱-se̱? <verse eid="GEN 18:24"/><verse number="25" style="v" sid="GEN 18:25"/>U̱m nu̱pu̱ste̱ bo̱ zaar u̱ no̱m-du̱ go̱ no̱m-u o̱ da, bo̱ ho̱ru̱sse̱ a-jab-u̱s so̱-se̱ ne̱ u̱r-kot u̱ i yo̱-ye̱ ne̱. ¿Remu̱ yan-o̱ bo̱ do̱te̱ u̱ ho̱ru̱sse̱ i yo̱-ye̱ u̱s-gan u̱ i so̱-ye̱ ne̱? Za u-sakna bo̱ zaar u̱ no̱m-du̱ go̱-o̱ no̱m-o̱ iya da. Bo̱ de̱ no̱mu̱ u-dak u-be̱e̱t kwu̱p-du̱ u̱s-rem, tu̱msu̱ bo̱ no̱mu̱ no̱m-u̱ o̱o̱ge̱ ho̱n-ho̱n.&gt;&gt;<verse eid="GEN 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26"/>Yawe shu̱s wa zu̱, &lt;&lt;A mu̱ne̱ u̱zu̱ u̱m kwu̱mu̱g ne̱t-ne̱ u̱t-shik u̱t-yu̱r u̱ o̱p u̱ bo̱-u̱ So̱do̱m a-jab-u̱s so̱-se̱ ne̱, me̱ yage̱ bo̱-u o̱ u-be̱e̱t u̱ remu̱ a-jab-u̱s so̱-se̱ ne̱.&gt;&gt;<verse eid="GEN 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27"/>Ibrahi sur m-shas wa zu̱, &lt;&lt;Remu̱ u̱zu̱ u̱m ke̱rge̱ no̱m-du̱ u̱s-rem za u-gye̱r u̱du̱ U̱so-u̱ u-bu ri, ko̱ u̱zu̱ a waku̱n wa u̱m o̱o̱ge̱ da se̱di m-huug m-cwa ne̱, <verse eid="GEN 18:27"/><verse number="28" style="v" sid="GEN 18:28"/>a mu̱ne̱ u̱zu̱ na kwu̱mu̱g ne̱t-ne̱ u̱t-shik u̱t-yu̱r u̱ tan [45] a-jab-u̱s so̱-se̱ ne̱, ¿bo̱ u̱t-ho̱ u-bo̱ u-be̱e̱t u̱ remu̱ ko̱b-du̱ tan?&gt;&gt;</para>
  <para style="p" vid="GEN 18:28">Yawe zu̱, &lt;&lt;U̱m za ho̱ru̱sse̱ o̱ da a mu̱ne̱ zu̱ u̱m kwu̱mu̱g ne̱t ne̱ u̱t-shik u̱t-yu̱r u̱ tan [45] ne̱t-tu̱ o̱ u̱ku̱n.&gt;&gt;<verse eid="GEN 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29"/>Ibrahi sur m-zu̱, &lt;&lt;¿M-ha iya ne̱ bo̱ ho̱ru̱sse̱ bo-u̱ So̱do̱m, a mu̱ne̱ u̱zu̱ na kwu̱mu̱g ne̱t-ne̱ a-jab-u̱s so̱-se̱ ne̱ u̱t-shik u̱t-yu̱r [40]?&gt;&gt;</para>
  <para style="p" vid="GEN 18:29">Yawe zu̱, &lt;&lt;U̱m za ho̱ru̱sse̱ u̱n da u̱ remu̱ ne̱t-ne̱ jab-u̱s so̱-se̱ ne̱ u̱t-shik yu̱r [40].&gt;&gt;<verse eid="GEN 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30"/>Ibrahi zu̱, &lt;&lt;U̱so-u̱ u-bu ri, a jab-u̱ ró na u̱ re̱mu ri da, yage̱ u̱m no̱m u̱s-rem. ¿Bo̱ ho̱ru̱sse̱ bo̱-u̱ So̱do̱m, a mu̱ne̱ u̱zu̱ shik-de̱ na kume̱ u̱ o̱p [30] a-jab-u̱s so̱-se̱ ne̱?&gt;&gt;</para>
  <para style="p" vid="GEN 18:30">Se̱ wa zu̱ wu̱n, &lt;&lt;U̱m za ho̱-du̱ u̱n da, a mu̱ne̱ zu̱ u̱m kwu̱mu̱g ne̱t-ne̱ u̱r-shik u̱ o̱p [30] u̱ku̱n a-jab-u̱s so̱-se̱ ne̱.&gt;&gt;<verse eid="GEN 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31"/>Ibrahi zu̱, &lt;&lt;U̱ da-o̱ remu̱ zu̱ u̱m kwu̱mu̱g be̱b-du̱ u̱s-rem u̱ U̱so-u̱ u-bu ri ne̱, a mu̱ne̱ u̱zu̱ shik-de̱ [20] na kume̱ warre̱ u̱ku̱n ne̱.&gt;&gt;</para>
  <para style="p" vid="GEN 18:31">Wa zu̱, &lt;&lt;U̱ remu̱ kwaz-u̱r re̱ [20], u̱m zaar u̱ ho̱ru̱ssu̱ bo̱-u o̱ da.&gt;&gt;<verse eid="GEN 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32"/>Ibrahi zu̱, &lt;&lt;U̱so-u̱ u-bu ri, a jab-u̱ ró na da, yage̱ u̱m sur m-no̱m u̱s-rem u-so̱ u-gan. ¿A mu̱ne̱ u̱zu̱ ne̱t-ne̱ o̱p e̱ na kume̱ a-jab-u̱s so̱-se̱ ne̱?&gt;&gt;</para>
  <para style="p" vid="GEN 18:32">Yawe zu̱ wu̱n, &lt;&lt;A u̱m kume̱ ne̱t-ne̱ o̱p a-jab-u̱s so̱-se̱ ne̱, u̱m zaar u̱ ho̱ru̱sse̱ bo̱-u o̱ da.&gt;&gt;<verse eid="GEN 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 18:33"/>Da-u̱ Yawe tase̱ u̱s-rem u̱ Ibrahi ne̱, wa aru̱k wa, se̱ Ibrahi aru̱k m-mu̱ u̱ rimpa-u̱r wa.<verse eid="GEN 18:33"/></para>
  <chapter eid="GEN 18"/>
  <chapter number="19" style="c" sid="GEN 19"/>
  <para style="s1">Ba'as-u̱t So̱do̱m</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1"/>A-to̱m u-Ru̱ ne̱ yu̱r e̱ haan u̱ So̱do̱m m-rim, tu̱msu̱ Ro̱t o̱ u̱ shu̱'u̱t u̱ is-yu̱ cwadu̱ u-bo̱. Da-u̱ wa hyane̱ u̱n, wa yu̱ne, wa bit u̱n, wa kwu̱ku̱t u̱t-jwu̱n u-dak wa kaku̱s shu̱-u wa u-dak. <verse eid="GEN 19:1"/><verse number="2" style="v" sid="GEN 19:2"/>Wa zu̱ u̱n, &lt;&lt;Haanu̱n u̱ bu-u̱ to̱k-u̱ no̱, u̱ no̱ jaas naas no̱ tu̱msu̱ no̱ roog u̱ ane̱ a is-u̱ gase̱ u̱r-wu̱n te̱p te̱p se̱ no̱ aru̱k m-mu̱.&gt;&gt;</para>
  <para style="p" vid="GEN 19:2">Se̱di u̱n zu̱ wa, &lt;&lt;O'o, yage̱ it roog u̱ ane̱ kat-du̱ u-bo̱.&gt;&gt;<verse eid="GEN 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3"/>Se̱ Ro̱t e̱kse̱ u̱n, da tase̱ u̱n aru̱k m-mu̱ u̱nu̱ e̱ ne̱ u̱ bu-u wa. Ro̱t zo̱nge̱ u̱n mo̱ro̱g-du̱ re̱-du̱ no̱m u̱t-re̱, wa no̱mu̱ u̱n u̱r-be̱re̱di du̱ za m-yis, se̱ u̱n re. <verse eid="GEN 19:3"/><verse number="4" style="v" sid="GEN 19:4"/>Kandi u̱n toot m-roog, campa-ne̱ i o̱o̱ge̱ bo̱-u̱ So̱do̱m u-be̱e̱t, u̱ yaag-u̱ be̱b-ne̱ u̱t-ne̱nge̱n ne̱ gu̱nu̱s bu-u̱ u̱n o̱tte̱. <verse eid="GEN 19:4"/><verse number="5" style="v" sid="GEN 19:5"/>Se̱ u̱n fog Ro̱t, u̱n zu̱, &lt;&lt;¿Ne̱t-u̱t to̱ yu̱ tu̱ haane̱ u̱du̱ ró m-gyu̱p? Rwu̱tu̱n u̱n u̱ ane̱ u̱du̱ it, it roog u̱ e̱ ne̱!&gt;&gt;<verse eid="GEN 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6"/>Se̱ Ro̱t aru̱k m-rwu̱ u̱-do̱ wa tage̱ u-is u̱ dim-u̱ wa, wa do̱'e̱ u̱nu̱ e̱ ne̱ no̱m u̱s-rem. <verse eid="GEN 19:6"/><verse number="7" style="v" sid="GEN 19:7"/>Wa zu̱ u̱n, &lt;&lt;Gagu̱n jab, o̱r-u̱t ri, a no̱ jaru̱n no̱ no̱m go̱ no̱m-u yo̱-o̱ uno̱ da. <verse eid="GEN 19:7"/><verse number="8" style="v" sid="GEN 19:8"/>Gwatu̱n, u̱m o̱ yaat u̱t-gwu̱p-ne̱ yu̱r i tame̱ nap-du̱ campa da. Yagu̱n u̱m rwu̱tu̱n no̱ e̱ u̱du̱ no̱, u̱ no̱ nom no̱m-u̱ citu̱ no̱ u̱ e̱ ne̱. Se̱di a no̱ no̱mu̱ ne̱t-u̱t tun-to̱ oko̱n da, ham-tu̱ u̱t-ri to̱ u̱ bu-u ri.&gt;&gt;<verse eid="GEN 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9"/>Se̱di u̱n zu̱ wa, &lt;&lt;Ya it u̱r-be!&gt;&gt; Tu̱msu̱ u̱n zu̱ hi-u̱r u̱n, &lt;&lt;Unwa ne̱t wa ham-u̱t wa, se̱di wa o̱ u̱ssa wa shu̱'u̱t wa kwu̱pu̱ in u̱s-rem. U̱ da-o̱ it u̱ no̱mu̱ bo̱ m-ze̱g no̱mu̱ it o̱o̱ge̱ u̱ssa u̱ u̱n ne̱.&gt;&gt; Se̱ u̱n hu̱ e̱kse̱ Ro̱t so̱k. U̱n o̱ u̱t-sa u̱n vu̱ku̱s is-yu̱ u-bu.<verse eid="GEN 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 19:10"/>Se̱di hamu̱t-u̱t to̱ nabu̱n u-kom e̱ nu̱k Ro̱t m-cwa u-bu. Se̱ e̱ tage̱ is-yu̱ u-bu. <verse eid="GEN 19:10"/><verse number="11" style="v" sid="GEN 19:11"/>Se̱ u̱n muut ne̱t-u̱t to̱ po̱-ne̱ be̱e̱t, u̱ ya'ag-u̱ campa-ne̱, u̱t-ne̱nge̱n ne̱, i o̱o̱ge̱ u̱ ees u̱ is-yu̱ u-bu, taas e̱ hyan is-yu̱ cwadu̱ u-bu da.<verse eid="GEN 19:11"/></para>
  <para style="s1">Ro̱t so̱mo̱g du̱gu̱ So̱do̱m</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12"/>Se̱ ne̱t-ne̱ yu̱r-u̱ e̱ zu̱ Ro̱t, &lt;&lt;¿Ko̱ bo̱ o̱tte̱ waku̱n u̱ ane̱, ko̱ maan-u̱t ró, ya'ag-u̱ campa-ne̱ ko̱ yaat u̱t-gwu̱p, ko̱ waku̱n u̱-me̱ bo̱-u uno̱ wu̱ o̱o̱ge̱ wu̱ ró? Rwu̱tu̱n e̱ du̱gu̱ ane̱, <verse eid="GEN 19:12"/><verse number="13" style="v" sid="GEN 19:13"/>remu̱ u̱zu̱ it do̱'e̱ u̱ ho̱ru̱ssu̱ bo̱-u uno̱ u-be̱e̱t. Yawe ho̱k u̱zu̱ no̱m-u̱t yo̱-to̱ ne̱t-u̱t tunto̱ no̱ng u-tát o̱ wa'e̱ wa to̱mto̱n it ho̱ru̱sse̱ bo̱-u uno̱.&gt;&gt;<verse eid="GEN 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14"/>Se̱ Ro̱t aru̱k m-rwu̱ wa do̱'e̱ wa no̱m u̱s-rem u̱ maan-u̱t wa ne̱, e̱ sa'e̱ gu̱tu̱ ya-u̱t-gwu̱p-u̱ wa. Wa zu̱ e̱, &lt;&lt;Zo̱ngu̱n no̱ aru̱k m-rwu̱ du̱gu̱ ane̱, remu̱ zu̱ Yawe o̱ mo̱ttu̱ ho̱ru̱ssu̱ bo̱-u uno̱!&gt;&gt; Se̱di maan-u̱t wa ku̱b u̱zu̱ ho̱ro̱ wa o̱tte̱.<verse eid="GEN 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15"/>Da-u̱ is u̱t-sa u̱t-gas, se̱ a-to̱m u-Ru̱ ne̱ waru̱ Ro̱t u̱zu̱, &lt;&lt;No̱m m-ho̱r, bo̱ kab ne̱ta ró u̱ ya-u̱t-gwu̱p-u̱ ró ne̱ yu̱r i o̱o̱ge̱ ane̱, taas na haan na ho̱ru̱ssu̱ bo̱-u uno̱ u̱r-kot u̱ no̱ ne̱ remu̱ ba'as-u̱t u̱n da.&gt;&gt;<verse eid="GEN 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 19:16"/>Da-u̱ Ro̱t gu̱gme̱ no̱m-du̱ m-ho̱r, se̱ ne̱t-u̱t to̱ shipu̱s wa u-kom, u̱ ne̱ta wa ne̱, u̱ yaat u̱t-gwu̱pu̱ wa ne̱ yu̱r, e̱ ruut u̱n m-yar du̱gu̱ bo̱-u o̱, remu̱ zu̱ Yawe o̱ ho̱g-du̱ o̱n-u̱r u̱n. <verse eid="GEN 19:16"/><verse number="17" style="v" sid="GEN 19:17"/>Da-u̱ na ruute̱ u̱n m-yar du̱gu̱ bo̱-u o̱, wa-to̱m u-Ru̱ wa-gan zu̱ u̱n, &lt;&lt;Somtu̱n fat-u̱t no̱! A no̱ gwat u-dim da ko̱ no̱ ees u̱ be̱du̱ o̱ nu̱ru̱gse̱ da. Du̱su̱n u̱ do̱m-u̱ u̱r-ro̱r, taas na ho̱ru̱ssu̱ no̱ da.&gt;&gt;<verse eid="GEN 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18"/>Se̱di Ro̱t zu̱ u̱n, &lt;&lt;O'o, U̱so-tu̱ u-bu ri. <verse eid="GEN 19:18"/><verse number="19" style="v" sid="GEN 19:19"/>U̱m kwu̱mu̱g hyu̱-m pusmo̱ du̱gu̱-du̱ no̱, no̱ gu fat-u̱r ri u̱ no̱mu so̱-o̱ u̱ no̱ no̱mu̱ me̱. U̱m zaar u̱ kerru̱ te-du̱ do̱m-u̱ u̱r-ro̱r kanda bo̱ ho̱ru̱sse̱ So̱do̱m da. U̱no̱ no̱m-u yo̱-o̱ u̱ masu̱ me̱, tu̱msu̱ me̱ u̱t-mar. <verse eid="GEN 19:19"/><verse number="20" style="v" sid="GEN 19:20"/>Gwat, o̱ko̱n bo̱-u re̱k-o̱ o̱ro u̱ kit-u̱ ku̱n. Yage̱ u̱m do̱'e̱ u̱ku̱n, no̱ hyang o̱ re̱k-o̱, u̱ da-u o̱ fat-u̱r ri u̱t-ku̱su̱m.&gt;&gt;<verse eid="GEN 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21"/>Wa-to̱m u-Ru̱ shu̱s wa zu̱ wu̱n, &lt;&lt;U̱m ho̱k ko̱n-u̱s ró, u̱m zaar u̱ ho̱-du̱ bo̱-u re̱k-o̱ o̱ da. <verse eid="GEN 19:21"/><verse number="22" style="v" sid="GEN 19:22"/>Zo̱nge̱ m-ho̱r-m-ho̱r bo̱ so̱m m-ha u̱ku̱n, u̱m zaar u̱ no̱m-du̱ o̱ko̱n da se̱ bo̱ teeg ku̱n.&gt;&gt; (O̱ wa-e̱ na fog-u̱t bo̱-u o̱ Zo̱war, wata be-u̱r re̱k-de̱).<verse eid="GEN 19:22"/></para>
  <para style="s1">Ru̱-u̱ ho̱ru̱sse̱ bo̱-u̱ So̱do̱m <optbreak/> u̱ Gomora ne̱</para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23"/>Da-u̱ ho̱-du̱ o̱o̱ge̱ u̱ rwu̱u̱n, Ro̱t u̱ bu-u wa ne̱ te u-bo̱ u̱ na foge̱ Zo̱war. <verse eid="GEN 19:23"/><verse number="24" style="v" sid="GEN 19:24"/>Se̱ Yawe hu̱ u̱ dasu̱n eng-tu̱ u-ra du̱gu̱ do̱m u-ru̱ u̱ bo̱-tu̱ So̱do̱m u̱ Gomora ne̱. <verse eid="GEN 19:24"/><verse number="25" style="v" sid="GEN 19:25"/>Wa ho̱ru̱sse̱te bo̱-u̱t to̱ u̱ ne̱t-tu̱ o̱o̱ge̱ u̱r-yu̱ ne̱ u̱-me̱ to̱, u̱ bo̱-tu̱ o̱ nu̱ru̱gse̱ ne̱ u̱t-be̱e̱t, u̱t-ran ne̱ u̱t-be̱e̱t. <verse eid="GEN 19:25"/><verse number="26" style="v" sid="GEN 19:26"/>Se̱di ne̱ta Ro̱t bir u-dim da-u̱ wa o̱o̱ge̱ u̱ do̱rru̱ dim-u̱ wa, se̱ wa baru̱m kirru̱ u̱t-ma.<verse eid="GEN 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27"/>Da-u̱ is gase̱ u̱r-wu̱n te̱p te̱p, Ibrahi baru̱m m-mu̱ u-dim u̱ be-du̱ wa tamte̱ u̱r-ees u̱-shu̱ Yawe. <verse eid="GEN 19:27"/><verse number="28" style="v" sid="GEN 19:28"/>Se̱ wa gwatu̱n u-dak u̱ gas-u̱ So̱do̱m u̱ Gomora ne̱, u̱ be-du̱ o̱ nu̱ru̱gse̱ ne̱ u̱r-be̱e̱t, wa hyu̱n fu̱'u̱t-u yat-o̱ u̱ rwu̱u̱n du̱gu̱ me̱ bo̱-u̱t to̱ sha-mu̱ m-fu̱'u̱t du̱gu̱ ra-u yat-o̱.<verse eid="GEN 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 19:29"/>Se̱di Ru̱-u̱ ho̱k ko̱n-u̱s Ibrahi, wa yage̱ Ro̱t u̱r-fat. Wa ruut Ro̱t du̱gu̱ swadu̱ u̱r-ko̱b du̱ he̱e̱ne̱ bo̱-u̱t to̱.<verse eid="GEN 19:29"/></para>
  <para style="s1">Taku̱n-du̱ Mowab <optbreak/> u̱ Amo̱n-ne̱</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30"/>Da-u̱ tase̱ Ro̱t yage̱ bo̱-u̱ Zo̱war remu̱ zu̱ wa o̱ gye̱r-u̱ ne̱t-tu̱ o̱o̱ge̱ u̱ku̱n. Wa do̱'e̱ wa shu̱'u̱t u̱ do̱m-u̱ u̱r-ro̱r u-so' u̱ ya-u̱t-gwu̱p-u̱ wa ne̱ yu̱r. <verse eid="GEN 19:30"/><verse number="31" style="v" sid="GEN 19:31"/>De̱ku̱n ho̱-de̱ yu̱-wu̱ya zu̱ hu̱no-u wa, &lt;&lt;Campa-ne̱ zamu̱n u̱ gas-u̱ uno̱ da. In zaar u̱ kwu̱m-du̱ campa wu̱ do̱'e̱ ga-du̱ in u̱ka na nomte̱ da. Za m-tumb u̱so in do̱'e̱ no̱m-du̱ u̱r-wu̱' za yaag. <verse eid="GEN 19:31"/><verse number="32" style="v" sid="GEN 19:32"/>Haane̱, yage̱ yu̱-u ya' wu̱n ke̱ wu̱n swa, se̱ yu̱-u roog u̱ wu̱n ne̱, ko̱ in u̱ cinu̱ go̱ du̱gu̱-du̱ u̱so-u in.&gt;&gt;<verse eid="GEN 19:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 19:33"/>Da-u̱ gye̱p-mu̱ no̱me̱, u̱n yu̱' wa ke̱ e̱ ho wa, se̱ yu̱-wu̱ya to wa roog u̱ wu̱n ne̱. Wu̱n nak da-u̱ gwu̱p-u̱ wu̱n ru̱te̱ da ko̱ da-u̱ wa yu̱ne̱ da.<verse eid="GEN 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34"/>Da-u̱ is gase̱ yu̱-wu̱ya zu̱ hu̱no-u wa, &lt;&lt;Gyu̱p-ne̱, u̱m roogte̱ u̱ u̱so ri ne̱, yage̱ u̱ in sur m-ya wu̱n ke̱ u̱ da-o̱ m-gye̱p. Se̱ bo̱ cwa u̱ no̱ wa ne̱ roog u̱ wu̱n ne̱ ko̱ in u̱ cinu̱ yaag du̱gu̱-du̱ u̱so-u in.&gt;&gt; <verse eid="GEN 19:34"/><verse number="35" style="v" sid="GEN 19:35"/>Se̱ u̱n wu̱' u̱so-u u̱n wa swa ke̱ e̱ ho wa u̱ gyu̱p-m mo̱. Se̱ du̱-dim to wa roog u̱ wa ne̱. Wu̱n nak da-u̱ gwu̱p-u̱ wu̱n ru̱te̱ da ko̱ da-u̱ wa yu̱ne̱ da.<verse eid="GEN 19:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 19:36"/>U̱ remu̱ iyane̱, ya-u̱t-gwu̱p-u̱ Ro̱t be̱e̱t u̱n no̱m me̱n-tu̱ uub du̱gu̱-du̱ u̱so-u u̱n. <verse eid="GEN 19:36"/><verse number="37" style="v" sid="GEN 19:37"/>Yu̱-wu̱ya mu̱t ya-du̱ u̱r-campa, wa te̱'e̱ de̱ u̱r-dim Mowab, ya'ag-u̱ Mowab e̱ na fu̱ge̱ da-o̱ Mowab-ne̱. <verse eid="GEN 19:37"/><verse number="38" style="v" sid="GEN 19:38"/>Du̱-dim sur m-mat ya-du̱ u̱r-campa, wa te̱'e̱ wa u̱r-dim Amona. Wa na foge̱ ya-du̱ ne̱t-u̱t ri, ya'ag-u̱ Amona e̱ na fu̱ge̱ Amona-ne̱ u̱ haan da-u uno̱.<verse eid="GEN 19:38"/></para>
  <chapter eid="GEN 19"/>
  <chapter number="20" style="c" sid="GEN 20"/>
  <para style="s1">Ibrahi no̱ngu̱ Abime̱re̱k u̱s-bi</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1"/>Ibrahi u̱ ne̱t-u̱t wa ne̱ e̱ yu̱ne̱ u̱n aru̱k, se̱ da-u̱ e̱ te̱ye̱ gas-u̱ do̱g-du̱ Ne̱giv. E̱ do̱'e̱ e̱ shu̱'u̱t u̱ te̱k-u̱ bo̱-tu̱ Kades u̱ Shur ne̱ u-da cashi. Se̱ wa shu̱'u̱t sha-mu̱ ham-u̱t bo̱-u̱ Gerar. <verse eid="GEN 20:1"/><verse number="2" style="v" sid="GEN 20:2"/>U̱ku̱n Ibrahi ware̱ u̱t-ne̱t u̱zu̱ Saratu, &lt;&lt;Hu̱no-u ri wa.&gt;&gt; Se̱ Abime̱re̱k, faru̱k-u̱ Gerar, to̱m na fagu̱n Saratu wa ku̱b wa.<verse eid="GEN 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 20:3"/>M-gyu̱p Ru̱-u̱ haan u̱du̱ Abime̱re̱k u̱ bo' wa zu̱ wa, &lt;&lt;Bo̱ u̱ wu̱ mare̱ ganse̱ u̱ remu̱ ne̱ta wu̱ bo̱ kabne̱, ne̱ta waku̱n wa.&gt;&gt;<verse eid="GEN 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4"/>Se̱di Abime̱re̱k haag u̱ kit-u̱ wu̱n da, se̱ wa zu̱, &lt;&lt;U̱so-u̱ u-bu ri, ¿bo̱ ho̱ru̱sse̱te̱ ne̱t-tu̱ za u̱t-ba'as? <verse eid="GEN 20:4"/><verse number="5" style="v" sid="GEN 20:5"/>Ibrahi wa zu̱ me̱ hu̱no-u wa o̱, tu̱msu̱ Saratu u̱ hi-u̱r wa zu̱u̱g me̱ iya, &lt;O̱ru̱ ri wa.&gt; U̱m to̱ u̱ sa'u wa jab gan, kom-u̱t ri zatte̱ u̱t-ba'as da.&gt;&gt;<verse eid="GEN 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6"/>Se̱ Ru̱-u̱ zu̱ wu̱n, &lt;&lt;E̱, u̱m nak u̱zu̱ bo̱ saag wa jab gan. O̱ wa'e̱ u̱m hooste̱ bo̱ no̱m-du̱ u̱t-ba'as u̱du̱ ri, tu̱msu̱ o̱ wa'e̱ u̱m hooste̱ bo̱ tamdu̱ wu̱n. <verse eid="GEN 20:6"/><verse number="7" style="v" sid="GEN 20:7"/>U̱ da-o̱ muute̱ campa-u ya ne̱ta wa, wa no̱mu̱ bo̱ u̱s-to̱o̱g. Wa-warru̱ rem-su̱ u-Ru̱ wa, u̱ da-u o̱ bo̱ u̱t-no̱m u̱r-fat. Se̱di a-bo̱ gu̱gme̱ muutu̱ ne̱ta-u ya u̱du̱ campa wa, bo̱ nap u̱zu̱ bo̱ u̱ ne̱t-tu̱ u-bu-u ró ne̱ u̱t-be̱e̱t no̱ u̱t-mar.&gt;&gt;<verse eid="GEN 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8"/>Da-u̱ is gase̱ u̱r-wu̱n te̱ te̱p Abime̱re̱k fog mo̱ro̱g-du̱ to̱k-ne̱ wa be̱e̱t. Da-u o̱ wa waru̱ e̱ no̱mu̱ na no̱me̱, u̱n hog u-gye̱r u̱n be̱e̱t. <verse eid="GEN 20:8"/><verse number="9" style="v" sid="GEN 20:9"/>Se̱ Abime̱re̱k fog Ibrahi wa zu̱, &lt;&lt;¿Yan-o̱ bo̱ no̱mu̱ it inya? ¿Yan ba'as-to̱ u̱m no̱mu̱ bo̱? Bo̱ haatu̱n me̱ tun-to̱ no̱m-u̱t yo̱-to̱ yatto̱ tunto̱ u̱ dak-u ri u̱ ne̱t-u̱t ri ne̱ u̱t-be̱e̱t. Bo̱ no̱ngu̱ me̱ no̱mtu̱ kame̱ da.&gt;&gt; <verse eid="GEN 20:9"/><verse number="10" style="v" sid="GEN 20:10"/>Abime̱re̱k shit Ibrahi, &lt;&lt;¿Remu̱ yan-o̱ bo̱ nomte̱ go̱-du̱ uno̱ no̱m-o̱?&gt;&gt;<verse eid="GEN 20:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11"/>Ibrahi zu̱, &lt;&lt;U̱m no̱mu̱g u̱s-dorog u̱zu̱, &lt;Gye̱r u-Ru̱ zaar u̱du̱ ne̱t-tu̱ dinde̱ be-de̱ da, e̱ keru̱ ho̱-du̱ me̱ e̱ kab ne̱ta ri.&gt; <verse eid="GEN 20:11"/><verse number="12" style="v" sid="GEN 20:12"/>U̱t-nip hu̱no̱ ri wa. U̱so-u it u̱ wa ne̱ o̱ u-gan, se̱di ko̱wan o̱ u̱ ino-u wa, se̱di u̱m gu̱ wa. <verse eid="GEN 20:12"/><verse number="13" style="v" sid="GEN 20:13"/>Da-u̱ Ru̱-u̱ fagu̱ me̱ u̱m yage̱ bu-u̱ u̱so-u ri, u̱m zu̱ Saratu, &lt;Ka bo̱ de̱ttte̱ u̱ ko̱su̱ me̱ u̱t-cwanu̱ ya, be-du̱ yu̱-u hu̱u̱te̱ u̱r-be̱e̱t, bo̱ zu̱ me̱ hu̱no-u ró wa u̱m o̱o̱ge̱.&gt; &gt;&gt;<verse eid="GEN 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14"/>Se̱ Abime̱re̱k ku̱b e̱ke̱n u̱ te̱k-u̱ ban-tu̱ ca wa u̱ gwaar ne̱ u̱ na ne̱, tu̱msu̱ u̱ to̱k-ne̱ ne̱ta-ne̱ u̱ campa-ne̱, wa yasu̱ Ibrahi e̱, tu̱msu̱ wa mu̱tu̱n Saratu ne̱ta wa. <verse eid="GEN 20:14"/><verse number="15" style="v" sid="GEN 20:15"/>Abime̱re̱k zu̱ Ibrahi, &lt;&lt;Dak-u ri ya u̱ku̱n u̱du̱ ró, shu̱'u̱te̱ u̱ be-du̱ citu̱ bo̱.&gt;&gt;<verse eid="GEN 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 20:16"/>Se̱ Abime̱re̱k zu̱ Saratu, &lt;&lt;U̱m yaag campa ró kwam-u̱t pus-to̱ tu̱ shik u̱t-ko̱k u̱t-o̱p [1,000], remu̱ zu̱ u̱ shu̱'u̱t u̱s-nap u̱ ne̱t-tu̱ bo̱ o̱o̱ge̱ u̱ to̱ ne̱ u̱t-be̱e̱t u̱zu̱ bo̱ no̱mu̱g o̱ko̱n u̱ za so̱-o̱ da.&gt;&gt;<verse eid="GEN 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 20:17"/>Ibrahi no̱m u̱s-ko̱n u̱du̱ u-Ru̱, Ru̱-u̱ yu̱ Abime̱re̱k m-yar, u̱ ne̱t-u̱t wa ne̱ u̱ to̱k-u̱ wa ne̱, ne̱ta-ne̱, ko̱ e̱ kumu̱ mat-du̱ yaag tu̱msu̱, <verse eid="GEN 20:17"/><verse number="18" style="v" sid="GEN 20:18"/>remu̱ zu̱ Yawe wa'ag ne̱ta-ne̱ be̱e̱t i o̱o̱ge̱ u̱ bu-u Abime̱re̱k, u̱zu̱ e̱ za u̱r-mat da remu̱ zu̱ Abime̱re̱k kab-u̱g ne̱ta Ibrahi Saratu.<verse eid="GEN 20:18"/></para>
  <chapter eid="GEN 20"/>
  <chapter number="21" style="c" sid="GEN 21"/>
  <para style="s1">Mat-u̱r Ishaku</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1"/>Yawe este̱ u̱s-rem tu̱msu̱ wa no̱mu̱ Saratu no̱mu̱ wa zu̱ wa u̱t-no̱m. <verse eid="GEN 21:1"/><verse number="2" style="v" sid="GEN 21:2"/>No̱ng ho̱n-ho̱n u̱ da-u̱ Ru̱-u̱ waru̱ Ibrahi, Saratu ku̱b me̱n-tu̱ ub, se̱ wa matu̱ Ibrahi ya-du̱ u̱r-campa u̱ da-u̱ wu̱-u̱r wa. <verse eid="GEN 21:2"/><verse number="3" style="v" sid="GEN 21:3"/>Ibrahi te̱'e̱ ya-du̱ u̱r-campa wa u̱r-dim Ishaku. <verse eid="GEN 21:3"/><verse number="4" style="v" sid="GEN 21:4"/>Da-u̱ Ishaku no̱me̱ m-roog u̱t-eer, Ibrahi no̱mu̱ wa u̱r-pe̱s u̱ka Ru̱-u̱ zu̱tte̱ wa no̱m. <verse eid="GEN 21:4"/><verse number="5" style="v" sid="GEN 21:5"/>Ibrahi no̱ng u̱s-hak u̱t-shik u̱t-tan [100] da-u̱ wa mate̱ Ishaku.<verse eid="GEN 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 21:6"/>Saratu zu̱, &lt;&lt;Ru̱-u̱ wa'ag me̱ u̱t-nu̱mu̱s; ko̱wana ho̱ge̱ wa se̱gu̱ me̱ no̱m-du̱ u̱t-nu̱mu̱s. <verse eid="GEN 21:6"/><verse number="7" style="v" sid="GEN 21:7"/>¿Wana tame̱ u̱t-zu̱ Ibrahi u̱zu̱ Saratu u̱ wu̱rgu̱ wa'? M-ha iyane̱ u̱m mak-tu̱ Ibrahi ya-du̱ u̱r-campa u̱ da-u̱ wu̱-u̱r wa.&gt;&gt;<verse eid="GEN 21:7"/></para>
  <para style="s1">Ibrahi yanu̱g Hajara e̱ <optbreak/> wa'-u̱ wa Ismaru</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8"/>Da-u̱ Ishaku rogme̱ na o̱ u̱ mo̱ttu̱ kasdu̱ wa u̱r-de̱, Ibrahi bu̱n mo̱ro̱g-u̱r yat-de̱ du̱ u̱r-so̱.<verse eid="GEN 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 21:9"/>De̱ku̱n ho̱-de̱, Ismaru wa'-u̱ Hajara wa dak-u̱ Masar o̱ ho̱r e̱ Ishaku, Saratu hyen Ismaru u̱ no̱mu̱ Ishaku nu̱mu̱s-tu̱ u̱s-ju̱ru̱m. <verse eid="GEN 21:9"/><verse number="10" style="v" sid="GEN 21:10"/>Se̱ Saratu zu̱ Ibrahi, &lt;&lt;Buz to̱k-u̱ ne̱ta unwa e̱ wa'-u̱ wa ne̱, wa za re̱-du̱ no̱m-u̱ u̱t-kom ri u̱r-kot u̱ Ishaku wa'-u̱ ri ne̱ da!&gt;&gt;<verse eid="GEN 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 21:11"/>Rem-u̱s se̱ tu̱m jab-u̱ Ibrahi sok remu̱ zu̱ Ismaru wa'-u̱ rò wa. <verse eid="GEN 21:11"/><verse number="12" style="v" sid="GEN 21:12"/>Se̱ Ru̱-u̱ zu̱ Ibrahi, &lt;&lt;A jab-u̱ ró na u̱ remu̱ bu̱z-du̱ to̱k-u̱ ne̱ta unwa Hajara e̱ wa'-u̱ wa ne̱ da. No̱m no̱m-u̱ Saratu zu̱ bo̱ no̱m, remu̱ zu̱ du̱gu̱-du̱ Ishaku de̱ na do̱te̱ fag-du̱ ko̱-u̱r ró. <verse eid="GEN 21:12"/><verse number="13" style="v" sid="GEN 21:13"/>Se̱di me̱ u̱t-no̱m dak-u yat-o̱ du̱gu̱-du̱ wa'-u̱ to̱k-u̱ ne̱ta ró wa shu̱'u̱t u-dak, remu̱ zu̱ wa'-u̱ ró wa o̱o̱ge̱ ko̱wa.&gt;&gt;<verse eid="GEN 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14"/>Se̱ Ibrahi yu̱ne̱ u̱r-wu̱n te̱p te̱p, wa ku̱b no̱m u̱t-re̱ u̱ kub-du̱ m-bu̱ ne̱, wa yasu̱ Hajara. Ibrahi su̱bgu̱ Hajara to̱ u̱t-kap, wa yasu̱ Hajara wa zu̱ wa aru̱k u̱ wa'-u̱ e̱ ne̱. Se̱ Hajara aru̱k, wa hu̱ u̱t-riig u̱r-do̱g du̱ o̱ dapu̱s bo̱-u̱ Be̱rshe̱ba.<verse eid="GEN 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 21:15"/>Da-u̱ bu̱-mu̱ u̱r-kub tu̱se̱, se̱ Hajara ru̱st u̱r-ya u̱ kug-du̱ m-yara u̱ yaku̱n te-ya u̱r-do̱g. <verse eid="GEN 21:15"/><verse number="16" style="v" sid="GEN 21:16"/>Se̱ wa aru̱k, wa do̱'e̱ m-ra wa shu̱'u̱t u̱ka ra-mu̱ ta-u̱ u-ta, wa dorog u̱ jab-u̱ wa u̱zu̱, &lt;&lt;U̱m za u̱ssa u̱m hyan mar-mu̱ wa'-u̱ ri da.&gt;&gt; Se̱ wa hu̱ u̱s-kan.<verse eid="GEN 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17"/>Se̱di da-u̱ Ru̱-u̱ ho̱ge̱ kan-su̱ u̱r-ya, wa-to̱m u-Ru̱ fog Hajara. Wa zu̱, &lt;&lt;Hajara, ¿yan-o̱ no̱me̱? A-bo̱ ho̱g u-gye̱r da, Ru̱-u̱ ho̱k kan-su̱ u̱r-ya u̱ be-du̱ de̱ o̱tte̱ m-ru̱t. <verse eid="GEN 21:17"/><verse number="18" style="v" sid="GEN 21:18"/>De̱'e̱, bo̱ yu̱nu̱s wa'-u̱ wa, u̱ bo̱ par wa, remu̱ zu̱ du̱gu̱ ko̱-u̱r wa de̱, u̱m do̱te̱ kadu̱ dak-u yat-o̱.&gt;&gt;<verse eid="GEN 21:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 21:19"/>Se̱ Ru̱-u̱ upus is-u̱ Hajara, wa hyen du-du̱ m-bu̱. Wa do̱'e̱ wa shu̱u̱s kub-du̱ m-bu̱ wa yu̱ ya-u̱r wa, wa so.<verse eid="GEN 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 21:20"/>Ru̱-u̱ o̱ u̱r-kot u̱ wa'-u̱ wa ne̱, wa nen. Wa nom u̱r-yu̱ u̱-me u̱r-do̱g wa shu̱'u̱t wa nap-mu̱ ta-u̱ u-ta. <verse eid="GEN 21:20"/><verse number="21" style="v" sid="GEN 21:21"/>Da-u̱ wa o̱o̱ge̱ shu̱'u̱t do̱g-du̱ Paran, ino̱-u rò kwu̱mnu̱ wu̱n ne̱ta du̱gu̱ dak-u̱ Masar.<verse eid="GEN 21:21"/></para>
  <para style="s1">Ibrahi no̱ng este̱du̱ u̱s-rem <optbreak/> e̱ Abime̱re̱k</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22"/>U̱ te̱k-u̱ da-u o̱, Abime̱re̱k e̱ Piko̱r yu̱-Yat-ya karma-ne̱ e̱ do̱'e̱ u̱du̱ Ibrahi. E̱ zu̱ wa, &lt;&lt;Ru̱-u̱ o̱ u̱r-kot u̱ bo̱ ne̱ u̱ te̱k-u̱ no̱m-u̱ bo̱ o̱o̱ge̱ u̱t-no̱m u-be̱e̱t. <verse eid="GEN 21:22"/><verse number="23" style="v" sid="GEN 21:23"/>Remu̱ iyane̱, to̱n-de̱ u-Ru̱ ne̱ u̱zu̱ bo̱ zaru̱ re̱ ra-u ri da, u̱ ya'ag-u̱ ri ne̱, ko̱ a ko̱-u̱r ri ne̱. No̱mu̱ me̱ no̱m-u̱t so̱-to̱, u̱ dak-u ri ne̱ u̱ bo̱ o̱tte̱ shu̱'u̱t mu̱ u̱r-hamu̱t u̱ka u̱m nomte̱ bo̱.&gt;&gt;<verse eid="GEN 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24"/>Ibrahi zu̱, &lt;&lt;U̱m to̱ndte̱.&gt;&gt;<verse eid="GEN 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25"/>Ibrahi haatu̱n Abime̱re̱k u̱s-kan u̱ mo̱ttu̱ du-du̱ m-bu̱ du̱ to̱k-ne̱ Abime̱re̱k ru̱mse̱ u̱r-be̱b du̱gu̱-du̱ to̱k-ne̱ Ibrahi. <verse eid="GEN 21:25"/><verse number="26" style="v" sid="GEN 21:26"/>Abime̱re̱k zu̱, &lt;&lt;U̱m nak wu̱ no̱me̱ uno̱ no̱m-o̱ da. Bo̱ wargu̱ me̱ da, taku̱n-du̱ m-ho̱g-u̱ ri ya u̱ ya-o̱.&gt;&gt;<verse eid="GEN 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 21:27"/>Se̱ Ibrahi yu̱ Abime̱re̱k ban-du̱ ca u̱ gwaar ne̱ u̱ na ne̱, se̱ e̱ yu̱r e̱ no̱m este̱du̱ u̱s-rem. <verse eid="GEN 21:27"/><verse number="28" style="v" sid="GEN 21:28"/>Ibrahi du̱gu̱r ya'ag-u̱ ca ta'e̱r du̱gu̱ me̱ ban-du̱ ca wa. <verse eid="GEN 21:28"/><verse number="29" style="v" sid="GEN 21:29"/>Abime̱re̱k zu̱ Ibrahi, &lt;&lt;¿Rem-u yan-o̱ bo̱ du̱gu̱rte̱ ine̱ yaag-u̱ ca-ye̱ u̱ war-e̱?&gt;&gt;<verse eid="GEN 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30"/>Wa zu̱, &lt;&lt;Kab ca e̱, e̱ shu̱'u̱t u̱s-nap u̱zu̱ me̱ wa kawe̱ du-u̱r re̱.&gt;&gt;<verse eid="GEN 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 21:31"/>Remu̱ iya na fu̱g dim-du̱ be-u̱r re̱ Be̱rshe̱ba, <note caller="+" style="f"><char style="fr" closed="false">21:31 </char><char style="fqa" closed="false">No̱mu̱ na zu̱ye̱ Be̱rshe̱ba </char><char style="ft" closed="false">ko̱ </char><char style="fqa" closed="false">Du-du̱ u̱s-to̱nd. </char></note> remu̱ zu̱ ku̱na e̱ nomte̱ u̱s-to̱nd.<verse eid="GEN 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 21:32"/>Da-u̱ e̱ taase̱ no̱m-du̱ u̱s-to̱nd u̱ be-du̱ na zu̱ye̱ &lt;&lt;Du-du̱ u̱s-to̱nd,<note caller="+" style="f"><char style="fr" closed="false">21:32 </char><char style="ft" closed="false">Be̱rshe̱ba.</char></note>&gt;&gt; se̱ Abime̱re̱k e̱ Piko̱r yu̱-Yat-ya karma-ne̱, e̱ yu̱ne̱ e̱ aru̱k m-mu̱ u̱ dak-u̱ Firistiya-ne̱. <verse eid="GEN 21:32"/><verse number="33" style="v" sid="GEN 21:33"/>Ibrahi ser u-te go̱-du̱ te-yu̱ m-yara u̱ Be̱rshe̱ba ku̱na wa fu̱kte̱ u̱ te̱k-u̱ dim-u̱r Yawe, u-Ru̱ u̱ za u̱r-ma. <verse eid="GEN 21:33"/><verse number="34" style="v" sid="GEN 21:34"/>Se̱ Ibrahi shu̱'u̱t wa dak-u̱ Firistiya-ne̱.<verse eid="GEN 21:34"/></para>
  <chapter eid="GEN 21"/>
  <chapter number="22" style="c" sid="GEN 22"/>
  <para style="s1">Ru̱-u̱ no̱ng reg-mu̱ ya-du̱ <optbreak/> jab-u̱ Ibrahi</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1"/>Da-u̱ na no̱me̱ u̱s-hak u-tát, se̱ Ru̱-u̱ re̱g ya-du̱ jab-u̱ Ibrahi, se̱ Ru̱-u̱ fu̱g wu̱n wa zu̱, &lt;&lt;Ibrahi!&gt;&gt;</para>
  <para style="p" vid="GEN 22:1">Ibrahi zu̱, &lt;&lt;Me̱ ya.&gt;&gt;<verse eid="GEN 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2"/>Se̱ Ru̱-u̱ zu̱, &lt;&lt;Kab wa'-u̱ ró, ya-du̱ u̱r-gan u̱ ró Ishaku, wu̱ bo̱ zege̱ u̱t-cwan, bo̱ aru̱k m-ha u̱ dak-u̱ na zu̱ye̱ Moriya. Bo̱ yasu̱ wu̱n u̱ku̱n sha-mu̱ ya-du̱ to̱o̱g u̱ do̱m-u̱ de̱ku̱n ro̱r-de̱ du̱ u̱m do̱'e̱ ko̱su̱ bo̱.&gt;&gt;<verse eid="GEN 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3"/>Ibrahi yu̱ne̱ u̱r-wu̱n te̱p te̱p. Wa zo̱ng janka-u wa, wa zu̱ to̱k-ne̱ yu̱r u̱ do̱r wa, u̱ wa'-u̱ wa ne̱ Ishaku. Da-u̱ wa bu̱kre̱ u̱t-te tu̱ no̱m-du̱ to̱o̱g, se̱ e̱ he̱e̱se̱ m-ha u̱ be-du̱ Ru̱-u̱ waru̱ wu̱n. <verse eid="GEN 22:3"/><verse number="4" style="v" sid="GEN 22:4"/>Da-u̱ e̱ no̱me̱ m-roog u̱t-tu̱t, Ibrahi jaku̱s is wa hyan be-u̱r re̱ du̱gu̱ m-ra. <verse eid="GEN 22:4"/><verse number="5" style="v" sid="GEN 22:5"/>Ibrahi zu̱ to̱k-ne̱ wa, &lt;&lt;E̱stu̱n it u̱ ane̱ u-janka ne̱, it u̱ Ishaku do̱'e̱ m-ha u̱ ane̱ jit, it no̱mo̱n u̱t-huuk, it do̱'e̱ u̱t-mu̱u̱n u̱du̱ no̱.&gt;&gt;<verse eid="GEN 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6"/>Ibrahi to̱ksu̱ Ishaku u̱t-te tu̱ no̱m-du̱ to̱o̱g, wa ku̱b u-ra u-van ne̱, e̱ wane̱ aru̱k m-no̱k u̱r-kot. <verse eid="GEN 22:6"/><verse number="7" style="v" sid="GEN 22:7"/>Ishaku bir wa got Ibrahi, wa zu̱, &lt;&lt;U̱so-u ri.&gt;&gt;</para>
  <para style="p" vid="GEN 22:7">Ibrahi zu̱, &lt;&lt;Wa'-u̱ ri, me̱ ya.&gt;&gt;</para>
  <para style="p" vid="GEN 22:7">Ishaku shit wa zu̱, &lt;&lt;U̱m hyanu̱g u-ra, u̱t-te ne̱, se̱di u̱m hyanu̱g ca-yu̱ na do̱te̱ no̱m-du̱ to̱o̱g da.&gt;&gt;<verse eid="GEN 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8"/>Ibrahi shu̱s wa zu̱, &lt;&lt;Wa'-u̱ ri, Ru̱-u̱ de̱ haatu̱n ca-yu̱ to̱o̱g.&gt;&gt; Se̱ u̱n re shu̱ m-ha ne̱ u̱n yu̱r.<verse eid="GEN 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9"/>Da-u̱ u̱n teye̱ be-du̱ Ru̱-u̱ waru̱ wu̱n, Ibrahi no̱m u̱r-sak wa su̱k u̱t-te u-do̱m. Wa gu̱gru̱sse̱ wa'-u̱ wa Ishaku, wa su̱k wa u̱-do̱m u̱r-sak, u̱-do̱m u̱t-te. <verse eid="GEN 22:9"/><verse number="10" style="v" sid="GEN 22:10"/>Se̱ Ibrahi kabu̱n u-van, u̱ remu̱ wa pu̱nu̱t wa'-u̱ wa. <verse eid="GEN 22:10"/><verse number="11" style="v" sid="GEN 22:11"/>U̱ da-u o̱ wa-to̱m Yawe fog wu̱n du̱gu̱ do̱m u-ru̱, wa zu̱, &lt;&lt;Ibrahi! Ibrahi!&gt;&gt;</para>
  <para style="p" vid="GEN 22:11">Wa shu̱s, &lt;&lt;Me̱ ya.&gt;&gt;<verse eid="GEN 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12"/>Wa zu̱ wu̱n, &lt;&lt;A-bo̱ ho̱ wa'-u̱ ró da, u̱ da-o̱ u̱m nak u̱zu̱ bo̱ wa u-gye̱r u-Ru̱ wa bo̱ o̱ye̱, remu̱ zu̱ bo̱ hooste̱ me̱ wa'-u̱ ró da, ya-du̱ u̱r-gan u̱ ró.&gt;&gt;<verse eid="GEN 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13"/>Se̱ Ibrahi jaku̱s u̱r-hi, wa hyu̱n kag-yu̱ u-ca kar-u̱s wa su̱rgu̱sse̱ u̱s-hir, se̱ Ibrahi do̱'e̱ wa maas ca-u ya, wa do̱'e̱ wa nom to̱o̱g u̱ ya u̱ swas-mu̱ wa'-u̱ wa. <verse eid="GEN 22:13"/><verse number="14" style="v" sid="GEN 22:14"/>Ibrahi te̱'e̱ be-u̱r re̱ u̱r-dim, &lt;&lt;Yawe de̱'e u̱t-ya.&gt;&gt; Iya o̱ na fu̱gte̱ u̱ haan u̱ da-o̱, &lt;&lt;U̱ do̱m-u̱ u̱r-ro̱r de̱ Yawe do̱te̱ u̱t-ya.&gt;&gt;<verse eid="GEN 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15"/>Se̱ wa-to̱m Yawe sur m-fag Ibrahi du̱gu̱ do̱m u-ru̱, u-yu̱ru̱mse̱. <verse eid="GEN 22:15"/><verse number="16" style="v" sid="GEN 22:16"/>Se̱ wa Yawe zu̱, &lt;&lt;Remu̱ zu̱ bo̱ ho̱k re̱m-u̱s ri bo̱ hoostu̱ me̱ wa'-u̱ ró da, ya-du̱ u̱r-gan-u̱ ró, u̱m no̱ng u̱s-to̱nd u̱ hi-du̱ war ri ne̱, me̱ wa'-u̱ bo̱ nu-u so̱-o̱ tu̱msu̱ ko̱-u̱r ró do̱'e̱ u̱t-no̱m u-tát. <verse eid="GEN 22:16"/><verse number="17" style="v" sid="GEN 22:17"/>Me̱ wa'-u̱ bo̱ nu-u so̱-o̱, u̱m wa ko̱-u̱r ró de̱ shu̱'u̱t u-tát u̱ka re̱ge̱r i do̱m u-ru̱, de̱ shu̱'u̱t tu̱msu̱ u̱ka hereg-mu̱ u-gi, ya'ag-u̱ ró de̱ re̱-du̱ dak-tu̱ hu̱u̱b-u̱t yo̱-to̱ ró m-gag. <verse eid="GEN 22:17"/><verse number="18" style="v" sid="GEN 22:18"/>Du̱gu̱-du̱ ya'ag-u̱ ró de̱ ne̱t-tu̱ u-dak u̱t-be̱e̱t to̱ do̱te̱ u̱ kwu̱m-du̱ kom-u u-Ru̱ remu̱ zu̱ bo̱ do̱ro̱g rem-u̱s ri.&gt;&gt;<verse eid="GEN 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 22:19"/>Se̱ Ibrahi e̱ Ishaku mu̱u̱n u̱ be-du̱ to̱k-ne̱ wa o̱tte̱ e̱stu̱ u̱n, u̱nu̱ e̱ ne̱ aru̱k m-mu̱ u̱ Be̱rshe̱ba. Ku̱na Ibrahi retu̱ u-shu̱ u̱r-yu̱ ne̱ u̱ bo̱-u̱ u̱ Be̱rshe̱ba.<verse eid="GEN 22:19"/></para>
  <para style="s1">Yaag-u̱ campa-ne̱ Naho̱r</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20"/>Da-u̱ sure̱ m-waas, na waru̱ Ibrahi u̱zu̱, &lt;&lt;Mirka mak-tu̱ Naho̱r hu̱no-u rò ya'ag-u̱ campa-ne̱ eer.&gt;&gt; <verse eid="GEN 22:20"/><verse number="21" style="v" sid="GEN 22:21"/>Wa u̱r-taku̱n na zu̱ wa Uz, hu̱no-u wa na zu̱ wa Buz, u̱ Ke̱muwe̱r (Ke̱muwe̱r wa o̱ u̱so-u̱ Aram), <verse eid="GEN 22:21"/><verse number="22" style="v" sid="GEN 22:22"/>Ke̱sed, Hazo, Pirdas, Jidrab u̱ Be̱tuwe̱r ne̱. <verse eid="GEN 22:22"/><verse number="23" style="v" sid="GEN 22:23"/>Be̱tuwe̱r wa matu̱ Rebeka, Mirka wa matu̱ hu̱no-u Ibrahi Naho̱r ya'ag-u̱ campa-ne̱ eer. <verse eid="GEN 22:23"/><verse number="24" style="v" sid="GEN 22:24"/>Naho̱r mu̱t yaag nas du̱gu̱ ne̱ta wu̱ do̱, wu̱ na zu̱ye̱ Re̱ma, dim-tu̱ ya'ag-u̱ e̱ na zu̱: Teba, u̱ Gaham, u̱ Tahas, u̱ Maaka ne̱.<verse eid="GEN 22:24"/></para>
  <chapter eid="GEN 22"/>
  <chapter number="23" style="c" sid="GEN 23"/>
  <para style="s1">Saratu maru̱g Ibrahi o̱ <optbreak/> be-du̱ jwak-du̱ wa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1"/>Saratu no̱mu̱g u̱s-hak u-ko̱k u-gan u̱r-shik u̱s-ta'er [127]. <verse eid="GEN 23:1"/><verse number="2" style="v" sid="GEN 23:2"/>Wa maru̱g u̱ bo̱-u̱ Kiriyat Arba (be-du̱ na fu̱ge̱ u̱ da-o̱ He̱bro̱n) dak-u̱ Kan'ana. Ibrahi no̱m u̱s-kan sok, wa no̱m u̱t-bomos u̱ remu̱ mar-m Saratu.<verse eid="GEN 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3"/>Se̱ Ibrahi yage̱ u-du̱ ne̱ta wa, wa de̱'e wa no̱m u̱s-rem u̱ ne̱t-tu̱ He̱t-ne̱. Wa zu̱ u̱n, <verse eid="GEN 23:3"/><verse number="4" style="v" sid="GEN 23:4"/>&lt;&lt;Me̱ ham-u̱t wa u̱m o̱o̱ge̱ u̱du̱ no̱, babu̱n me̱ u̱r-ke̱ngi, u̱ de̱ shu̱'u̱t be-du̱ u-dok-u̱ ri ko̱ me̱ jwak-u̱ ne̱ta ri.&gt;&gt;<verse eid="GEN 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5"/>Ne̱t-tu̱ He̱t e̱ shasu̱ Ibrahi, e̱ zu̱, <verse eid="GEN 23:5"/><verse number="6" style="v" sid="GEN 23:6"/>&lt;&lt;U̱so u-bu it, e̱r rem-u̱s it, bo̱ ne̱t-u̱ yat-o̱ wa bo̱ o̱ye̱ it. Dag be-u̱r so̱-de̱ du̱ bo̱ u̱t-sa, bo̱ jwak ne̱ta ró u̱ku̱n. Waku̱n zaar u̱ te̱k-u̱ it wu̱ do̱'e̱ u̱t-zu̱ wa gu̱gu̱m ya-du̱ bo̱ be-du̱ jwak-du̱ ne̱ta ró da.&gt;&gt;<verse eid="GEN 23:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7"/>Se̱ Ibrahi he̱ u̱t-jwu̱n u̱-shu̱ ne̱t-tu̱ dak-u He̱t. <verse eid="GEN 23:7"/><verse number="8" style="v" sid="GEN 23:8"/>Wa zu̱ u̱n, &lt;&lt;Remu̱ zu̱ no̱ o̱ u̱ssa no̱ no̱mu̱ me̱ u̱r-se̱ge̱, u̱m o̱ u̱ssa no̱ ko̱nu̱ me̱ Eparo̱n wa'-u̱ Zohar. <verse eid="GEN 23:8"/><verse number="9" style="v" sid="GEN 23:9"/>Wa babu̱ me̱ u-pu̱ku̱s u̱ jwak-du̱ u̱t-ne̱t u̱ Mape̱ra u̱ o̱o̱ge̱ u-ta u̱ madu̱ tak-u wa, shu̱tu̱n me̱ wu̱n wa babu̱ me̱ be-u̱r re̱ me̱ u̱t-to̱p no̱m-u̱ wa zu̱ u̱m to̱p. U̱m u̱t-sa ke̱ngi-u̱r re̱ u̱ka de̱ do̱te̱ shu̱'u̱t ke̱ngi-u̱r ri du̱ mo̱mmo du̱ jwak-du̱ me̱ u̱ ne̱t-tu̱ bu-u ri.&gt;&gt;<verse eid="GEN 23:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10"/>Eparo̱n o̱g u̱ shu̱'u̱t u̱ku̱n u̱r-kot u̱ ne̱t-tu̱ He̱t-ne̱. Wa zu̱ Ibrahi u̱ ho̱g-mu̱ ne̱t-tu̱ He̱t u̱t-be̱e̱t i haane̱ u̱ku̱n u̱ is-yu̱ u-bo̱. <verse eid="GEN 23:10"/><verse number="11" style="v" sid="GEN 23:11"/>Se̱ wa zu̱ Ibrahi, &lt;&lt;U̱so u-bu ri, iya-o̱ da, e̱r rem-u̱s ri. Me̱ ya bo̱ u̱r-ke̱ngi u-pu̱ku̱s ne̱, u̱ ane̱ u̱ shu̱ ne̱t-u̱t ri u̱t-be̱e̱t, bo̱ jwak u-du̱ ne̱ta ró.&gt;&gt;<verse eid="GEN 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12"/>Ibrahi kwu̱ku̱t u̱t-jwu̱n u̱ shu̱ ne̱t-tu̱ dak-u o̱. <verse eid="GEN 23:12"/><verse number="13" style="v" sid="GEN 23:13"/>Se̱ wa no̱m rem-su̱ no̱m-u̱t to̱ u̱du̱ Eparo̱n u̱ ho̱g-mu̱ ne̱t-tu̱ o̱ u̱ku̱n u̱t-be̱e̱t, &lt;&lt;U̱m ko̱no̱g no̱, a no̱ eese̱, me̱ to̱p-u̱ shik-u̱ be-u̱r re̱ u̱r-be̱e̱t remu̱ u̱m kum-u̱t be-du̱ u̱m do̱te̱ u̱ ha jwak-du̱ ne̱t-u̱t ri a e̱ mare̱ u̱ku̱n.&gt;&gt;<verse eid="GEN 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14"/>Eparo̱n shasu̱ Ibrahi wa zu̱, <verse eid="GEN 23:14"/><verse number="15" style="v" sid="GEN 23:15"/>&lt;&lt;U̱so u-bu ri, e̱r me̱, be-u̱r re̱ teeg kwam-u̱t pus-to̱ tu̱ shik u̱t-ko̱k u̱t-nas [400], u̱ka shu̱'u̱t-u̱r yu̱-u shik-u̱ e̱ o̱ko̱n no̱m-o̱ o̱ da, do̱'e̱ bu̱ jwak ne̱ta ró.&gt;&gt;<verse eid="GEN 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 23:16"/>Ibrahi hog re̱m-u̱s Eparo̱n, wa to̱p wa no̱mu̱ wa zu̱ye̱ wa to̱p kwam-u̱t pus-to̱ tu̱ shik u̱t-ko̱k u̱t-nas [400] iya na bu̱bte̱ u-tu̱rru̱. Wa no̱ng no̱m-u̱t to̱ u̱t-be̱e̱t u̱-shu̱ ne̱nge̱n-tu̱ He̱t.<verse eid="GEN 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17"/>Iya-o̱ tak-u Eparo̱n u̱ o̱ u̱ Mape̱ra u̱-dapu̱s Mamre, u̱ u̱r-dame̱ u-pu̱ku̱s ne̱, u̱s-te ne̱ u̱s-be̱e̱t su̱ o̱ bo̱r-yu̱ u-tak, shu̱'u̱t u̱ Ibrahi u-be̱e̱t. <verse eid="GEN 23:17"/><verse number="18" style="v" sid="GEN 23:18"/>Se̱ be-u̱r re̱ shu̱'u̱t be-u̱r Ibrahi du̱ m-mo̱mmo̱ u̱ shu̱ ne̱nge̱n-tu̱ He̱t u̱ is u-bo̱. <verse eid="GEN 23:18"/><verse number="19" style="v" sid="GEN 23:19"/>Se̱ Ibrahi dok ne̱ta wa Saratu u̱ku̱n u̱ me̱n-tu̱ Kan'ana, pu̱ku̱s u̱ Mape̱ra u̱ dapu̱s Mamre (u̱ na foge̱ He̱bro̱n) <verse eid="GEN 23:19"/><verse number="20" style="v" sid="GEN 23:20"/>Iya-o̱ tak-u o̱ u-pu̱ku̱s ne̱ u̱ o̱ ne̱t-tu̱ He̱t babu̱ Ibrahi o̱ shu̱'u̱t be-u̱r wa du̱ u-dok.<verse eid="GEN 23:20"/></para>
  <chapter eid="GEN 23"/>
  <chapter number="24" style="c" sid="GEN 24"/>
  <para style="s1">To̱k-u̱ Ibrahi sagu̱n <optbreak/> Ishaku ne̱ta</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1"/>Ibrahi wu̱'u̱mte̱ tu̱msu̱ hak-u̱s wa no̱ng u-tát, tu̱msu̱ Yawe wa'-u̱ wu̱n nu-u so̱-o̱ u̱-me no̱m-u̱ wa o̱ u̱t-no̱m u-be̱e̱t. <verse eid="GEN 24:1"/><verse number="2" style="v" sid="GEN 24:2"/>De̱ku̱n ho̱-de̱ Ibrahi zu̱ to̱k-u̱ wa wu̱ ze̱ge̱ m-tumb, wu̱ shu̱'u̱te̱ wa-gwat-du̱ bu-u wa, Ibrahi zu̱, &lt;&lt;Kab to̱nd bo̱ wa kom-u̱t ró u̱-ta kut-u̱t ri. <verse eid="GEN 24:2"/><verse number="3" style="v" sid="GEN 24:3"/>U̱m o̱ u̱t-sa bo̱ to̱n-de̱ Yawe ne̱ wu̱ no̱me̱ dom-u u-ru̱ u-dak-ne̱ u̱zu̱ bo̱ za yage̱ wa'-u̱ ri unwa ga ne̱ta-tu̱ dak-u̱ Kan'ana tun-to̱ da. <verse eid="GEN 24:3"/><verse number="4" style="v" sid="GEN 24:4"/>Se̱di bo̱ ha u̱ dak-u ri u̱ te̱k-u̱ ko̱-u̱r ri bo̱ kwu̱mnu̱ wa'-u̱ ri Ishaku ne̱ta u̱r-gu̱.&gt;&gt;<verse eid="GEN 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5"/>Se̱ to̱k-u̱ wa zu̱ wu̱n, &lt;&lt;A mu̱ne̱ u̱zu̱ gwu̱p cwanu̱g wa do̱ro̱n it u̱ mu̱u̱n u̱ dak-u uno̱ da, ¿U̱m shu̱'e̱ wa'-u̱ ró m-mu̱ u̱ dak-u̱ bo̱ rwu̱tu̱n?&gt;&gt;<verse eid="GEN 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6"/>Ibrahi zu̱ wu̱n, &lt;&lt;Gwat so̱k taas bo̱ jaru̱n bo̱ kab wa'-u̱ ri m-mu̱ be-du̱ u̱m rwu̱tu̱n da! <verse eid="GEN 24:6"/><verse number="7" style="v" sid="GEN 24:7"/>Yawe, Ru̱-u̱ do̱m u-ru̱, wu̱ rwu̱tu̱n me̱ du̱gu̱ dak-u̱ u̱so-u ri u̱ ko̱-u̱r ri ne̱, wa no̱ng este̱du̱ u̱s-rem u̱s-to̱nd ne̱ u̱zu̱ wa ya' dak-u uno̱ u̱du̱ ya'ag-u̱ ri. Wa de̱ to̱mnu̱ wa-to̱mu̱-u̱ wa u̱-shu̱ ró wa de̱ u̱t-wa bo̱ kwu̱mnu̱ wa'-u̱ ri ne̱ta u̱ku̱n. <verse eid="GEN 24:7"/><verse number="8" style="v" sid="GEN 24:8"/>Abite̱ u̱zu̱ wa zaar u̱ssa wa do̱ro̱n bo̱ u̱ mu̱u̱n da, bo̱ rwu̱u̱g du̱gu̱ to̱nd-su̱ u̱m no̱me̱ bo̱ ne̱. Se̱di ko̱ re̱ o̱ nomte̱ a-bo̱ jaru̱n bo̱ muut wa'-u̱ ri u̱ku̱n da.&gt;&gt; <verse eid="GEN 24:8"/><verse number="9" style="v" sid="GEN 24:9"/>Se̱ to̱k-u̱ wa ku̱b to̱nd-u̱s se̱ wa wu̱ komu̱t wa kut-u u̱so u-bu wa Ibrahi. Wa nom este̱du̱ u̱s-rem u̱zu̱ wa do̱r no̱m-u̱ wa zu̱ wa u̱t-no̱m.<verse eid="GEN 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10"/>Se̱ to̱k-u̱ wa ku̱b rakum Ibrahi o̱p tu̱msu̱ wa saku̱ e̱ cwu̱-tu̱ shik tu̱ u-nya u̱t-go̱ u̱t-go̱ du̱gu̱ u̱so-u̱ u-bu wa. Se̱ wa dor u-fu̱n m-ha dak-u̱ Aram, m-te bo̱-u̱ Naho̱r. <verse eid="GEN 24:10"/><verse number="11" style="v" sid="GEN 24:11"/>Se̱ wa wu̱ rakum e̱ he̱ u̱t-jwu̱n u̱ dapu̱s du-du̱ ne̱t-tu̱ soye̱ u̱-do̱ u-bo̱, rim-mu̱ no̱mu̱g u̱ da-u o̱ ne̱ta-ne̱ o̱ haan u̱ yu̱bdu̱ bu̱-mu̱ u̱t-swa u̱ du-u̱r re̱.<verse eid="GEN 24:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 24:12"/>Se̱ wa nom u̱s-to̱o̱g, &lt;&lt;Yawe, Ru̱-u̱ u̱so u̱ u-bu ri Ibrahi, ya me̱ re̱ u-shu̱ bo̱ ko̱se̱ cwan-u̱t ró u̱du̱ u̱so u-bu ri Ibrahi. <verse eid="GEN 24:12"/><verse number="13" style="v" sid="GEN 24:13"/>Me̱ ya ees u̱ is-u̱ u̱r-dù, ya-u̱t-gwu̱p i bo̱-u uno̱ de̱ haan u̱ du-u̱r rinde̱ u̱ yu̱bdu̱ m-bu̱. <verse eid="GEN 24:13"/><verse number="14" style="v" sid="GEN 24:14"/>Sin-se̱ se̱ o̱ ko̱n-u̱s ri, me̱ u̱t-shu̱t wa-gan, &lt;Ya me̱ m-bu̱ mu̱ u̱t-swa du̱gu̱ kub-du̱ m-bu̱ wa,&gt; a wa zu̱ye̱ me̱, &lt;Swa m-bu̱ tu̱msu̱ me̱ u̱t-ya rakum-u̱ ró e̱ swa&gt; — yage̱ wa shu̱'u̱t ne̱ta wu̱ bo̱ du̱ste̱ Ishaku. Iya o̱ u̱m do̱te̱ u̱t-nap u̱zu̱ bo̱ ko̱ske̱ cwan-u̱t ró u̱du̱ u̱so u-bu ri.&gt;&gt;<verse eid="GEN 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15"/>Kanda wu̱n taaste̱ u̱s-to̱o̱g, Rebeka rwu̱n u̱ shar-du̱ m-bu̱ wa ne̱ m-sak u̱t-kap, wa o̱ wa'-u̱ gwu̱p-u̱ Be̱tuwe̱r wu̱ o̱ wa'-u̱ zwaru̱ Mirka wu̱ o̱o̱ge̱ ne̱ta hu̱no-u Ibrahi Naho̱r. <verse eid="GEN 24:15"/><verse number="16" style="v" sid="GEN 24:16"/>Rebeka gwu̱p-u̱ So̱-wa wa so̱k wa maag ha-mu̱ u̱r-gu̱, se̱di wa nak campa da. Wa aru̱k m-he̱ u̱ be-du̱ yu̱bdu̱ m-bu̱, wa shu̱su̱n shar-du̱ m-bu̱ wa rwu̱n.<verse eid="GEN 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 24:17"/>To̱k-u̱ wa no̱m m-ho̱r wa bit wu̱n, wa zu̱ wa, &lt;&lt;U̱m o̱ u̱ ko̱n-u̱s ró, ya me̱ m-bu̱ mu̱ shar-u̱r ró cashi u̱m swa.&gt;&gt;<verse eid="GEN 24:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18"/>Gwu̱p-u̱ wa zu̱ wu̱n, &lt;&lt;U̱so u-bu ri, o̱nko̱ bo̱ swa.&gt;&gt; Se̱ wa no̱m m-ho̱r wa cu̱st sharru̱ m-bu̱ wa du̱gu̱ zagu̱ u̱t-kap-u̱ wa, wa yasu̱ wu̱n, wu̱n swa.<verse eid="GEN 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 24:19"/>Da-u̱ wa ya'e̱ wu̱n bu̱-mu̱ u̱t-swa, wa zu̱, &lt;&lt;Me̱ u̱t-ya rakum-u̱ ró ko̱ e̱ m-bu̱ e̱ swa u̱ ko̱ru̱ e̱.&gt;&gt; <verse eid="GEN 24:19"/><verse number="20" style="v" sid="GEN 24:20"/>Wa nom m-ho̱r wa daas bu̱-mu̱ u̱r-sharu̱ wa u-kora u̱ ya-du̱ u̱t-bisa m-bu̱ wa baru̱m u̱du̱ u̱r-dù u̱ yu̱bu̱ndu̱ m-bu̱ wa yu̱'u̱t rakum-u̱ wa be̱e̱t. <verse eid="GEN 24:20"/><verse number="21" style="v" sid="GEN 24:21"/>To̱k-u̱ wa ho'u̱s u̱s-ram wa o̱ gwat-du̱ wu̱n. Wa o̱ u̱s-dorog u̱zu̱ ko̱ Yawe yaag wu̱n re̱-du̱ u-shu̱ u̱du̱ sa-u̱ Ishaku ne̱ta.<verse eid="GEN 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22"/>Da-u̱ rakum tase̱ swadu̱ m-bu̱, se̱ to̱k-u̱ wa ku̱b kwat-yu̱ u̱r-swa u̱ u̱s-kwa ne̱ su̱ u̱t-kom su̱ kwam-tu̱ bu̱-mu̱ u̱t-ro su̱ shik so̱k wa yasu̱ Rebeka. <verse eid="GEN 24:22"/><verse number="23" style="v" sid="GEN 24:23"/>Se̱ wa shit Rebeka u̱zu̱, &lt;&lt;¿Gwu̱p-u̱ wan wa bo̱ o̱ye̱? Gye̱r jab waru̱ me̱, ¿ko̱ u̱so-u ró o̱tte̱ kur-tu̱ it do̱te̱ m-roog u̱ gyu̱p-mu̱ ya-o̱?&gt;&gt;<verse eid="GEN 24:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24"/>Wa shu̱s wa zu̱, &lt;&lt;U̱so-u ri wa na zu̱ye̱ Be̱tuwe̱r, tu̱msu̱ u̱so-u rò u̱ ino-u rò ne̱ e̱ na zu̱ye̱ Naho̱r e̱ Mirka.&gt;&gt; <verse eid="GEN 24:24"/><verse number="25" style="v" sid="GEN 24:25"/>Wa sur m-zu̱ wu̱n, &lt;&lt;It o̱tte̱ u̱t-zan u̱ no̱m-tu̱ u̱t-re̱ ne̱ tu̱ rakum, u̱ kur-tu̱ m-roog ne̱ tu̱ u̱t-hamu̱t ne̱.&gt;&gt;<verse eid="GEN 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26"/>Se̱ to̱k-u̱ wa kug wa nom Yawe u̱t-huuk. <verse eid="GEN 24:26"/><verse number="27" style="v" sid="GEN 24:27"/>Wa zu̱, &lt;&lt;U̱t-vam u̱du̱ Yawe, Ru̱-u̱ u̱so-u ri Ibrahi, Yawe ko̱ske̱ cwan-u̱t wa nip-u̱t wa ne̱ jab-u̱ so̱-o̱ wa ne̱ u̱du̱ u̱so-u̱ u-bu ri, remu̱ u̱zu̱ wa dor-u̱t te̱ me̱ m-ha u̱du̱ ko̱-du̱ u̱so-u̱ u-bu ri.&gt;&gt;<verse eid="GEN 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28"/>Wa-gwu̱pu̱ aru̱k m-mu̱ m-so̱m wa waru̱ a-u-bu ne̱ no̱m-u̱ no̱me̱ u-be̱e̱t. <verse eid="GEN 24:28"/><verse number="29" style="v" sid="GEN 24:29"/>Rebeka o̱tte̱ yu̱-wu̱ya wu̱na zu̱ye̱ Raban, wa ku̱su̱m m-so̱m u̱ haan u̱ be-du̱ ne̱t-u̱ wa o̱tte̱ u̱-kit u̱r-du. <verse eid="GEN 24:29"/><verse number="30" style="v" sid="GEN 24:30"/>Da-u̱ wa hyane̱ kwat-yu̱ u̱r-swa ya u̱du̱ Rebeka, u̱ kwasu̱ u̱t-kom ne̱ su̱ o̱ m-wa u̱ ko̱m-u̱t wa, tu̱msu̱ wa ho̱k no̱m-u̱ Rebeka ware̱ u-be̱e̱t no̱m-u̱ ne̱t-u̱ wa zu̱ye̱, wa ru m-ha u̱ du-du̱ m-bu̱ de̱, be-du̱ ne̱t-u̱ wa o̱tte̱ ees u̱-kit u-rakum. <verse eid="GEN 24:30"/><verse number="31" style="v" sid="GEN 24:31"/>Raban zu̱ wu̱n, &lt;&lt;Bo̱ yu̱ Yawe wa'e̱ nu-u so̱-o̱. Haane̱ bo̱ shu̱'u̱t u̱ it ne̱. ¿Rem yan-o̱ bo̱ o̱tte̱ u̱ shu̱'u̱t u̱ ane̱ u̱-dim u-bo̱? Me̱ ya u̱m mangte̱ bo̱ u̱t-kur u̱ be-du̱ cu̱n-du̱ rakum-u̱ ró ne̱.&gt;&gt;<verse eid="GEN 24:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32"/>Se̱ ne̱t-u̱ wa aru̱k m-ha bu-u Raban. Raban cu̱st-u̱ rakum cwu̱-tu̱ e̱ o̱tte̱ u̱-do̱ m-sak, wa yu̱' e̱ u̱t-zan tu̱ e̱ do̱'e̱ u̱t-roog u̱t-tu̱. Se̱ wa hatu̱n ne̱t-u̱ wa m-bu̱ u̱ remu̱ i o̱ nak-du̱ rakum ne̱ e̱ jaaste na-u̱s e̱ be̱e̱t. <verse eid="GEN 24:32"/><verse number="33" style="v" sid="GEN 24:33"/>Wa haatu̱n wa no̱m u̱t-re̱, se̱ to̱k-u̱ wa zu̱ wu̱n, &lt;&lt;U̱m za re̱-du̱ no̱m u̱t-re̱ uno̱ da se̱ u̱m wargu̱ bo̱ no̱m-u̱ hatu̱n me̱.&gt;&gt;</para>
  <para style="p" vid="GEN 24:33">Raban zu̱ wu̱n, &lt;&lt;Waru̱ me̱ no̱m-u̱ hatu̱n bo̱.&gt;&gt;<verse eid="GEN 24:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34"/>Se̱ wa zu̱ wu̱n, &lt;&lt;Me̱ to̱k-u̱ Ibrahi wa u̱m o̱ye̱. <verse eid="GEN 24:34"/><verse number="35" style="v" sid="GEN 24:35"/>Yawe wa'agu̱ u̱so u-bu ri ko̱m-u u-Ru̱, wa shu̱'u̱te̱ ne̱t wu̱ o̱tte̱ no̱m-u̱ u̱t-kom. Ru̱-u̱ yaag wu̱n ban-tu̱ ca, u̱ ban-tu̱ gwaar ne̱, u̱ ban-du̱ na ne̱, u̱ kwam-u̱t pus-to̱ u̱ tu̱ bu̱-mu̱ u̱t-ro ne̱ tu̱ shik, u̱ to̱k-ne̱ u-tát (campa-ne̱ u̱ ne̱ta-ne̱) u̱ janka ne̱, u̱ rakum ne̱. <verse eid="GEN 24:35"/><verse number="36" style="v" sid="GEN 24:36"/>Da-u̱ Saratu ne̱ta u̱so-u̱ u-bu ri wu̱u̱me̱ so̱k, se̱ wa mu̱t ya-du̱ u̱r-campa, u̱so u-bu ri yase̱ wu̱n no̱m u̱t-kom-u̱ wa u-be̱e̱t. <verse eid="GEN 24:36"/><verse number="37" style="v" sid="GEN 24:37"/>U̱so u-bu ri to̱ndu̱ste̱ me̱ u̱zu̱, &lt;A-bo̱ yage̱ u̱ wa'-u̱ ri wa ga ne̱ta-tu̱ dak-u̱ Kan'ana da i u̱m o̱o̱ge̱ u̱ shu̱'u̱t dak-u e̱. <verse eid="GEN 24:37"/><verse number="38" style="v" sid="GEN 24:38"/>Se̱di bo̱ do̱'e̱ bu-u u̱so-u ri, du̱gu̱ me̱ ko̱-du̱ u̱so-u ri bo̱ kwu̱mnu̱ wa'-u̱ ri ne̱ta.&gt;<verse eid="GEN 24:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 24:39"/>&lt;&lt;U̱m zu̱ u̱so u-bu ri, &lt;¿A mu̱ne̱ u̱zu̱ u̱m kwu̱mu̱g wa'-u̱ gwu̱p wu̱ zu̱ wa do̱rnu̱ me̱ da?&gt;<verse eid="GEN 24:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 24:40"/>&lt;&lt;Wa zu̱ me̱, &lt;Yawe, wu̱ u̱m o̱ u̱t-do̱r, wa to̱mnu̱ Wa-to̱m-u̱ wa u̱r-kot u̱ bo̱ ne̱. Wa do̱'e̱ u̱t-wa bo̱ kum re̱-u̱ u-shu̱ u̱ no̱mu̱ bo̱ u̱t-no̱m ne̱. Ka u̱t-no̱m zarra se̱ bo̱ kwu̱mgu̱n wa'-u̱ ri ne̱ta du̱gu̱ ko̱-du̱ u̱so-u ri, u̱du̱ me̱ ne̱t-tu̱ bu-u̱ u̱so-u ri. <verse eid="GEN 24:40"/><verse number="41" style="v" sid="GEN 24:41"/>Da-u̱ bo̱ do̱'e̱ u̱du̱ u̱so-u̱t ri, bo̱ rwu̱u̱g du̱gu̱ u̱s-to̱nd ko̱ da zu̱ e̱ gu̱gu̱mte̱ yanu̱ bo̱ ne̱ta bo̱ rwu̱u̱g du̱gu̱ sese to̱nd se̱.&gt;<verse eid="GEN 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42"/>&lt;&lt;Da-u̱ u̱m haane̱ be-du̱ du-du̱ m-bu̱ u̱ ya-o̱, se̱ u̱m no̱m u̱s-to̱o̱g u̱zu̱, &lt;Yawe, Ru̱-u̱ u̱so u-bu ri Ibrahi no̱me̱ u̱t-huuk, ya me̱ re̱-u̱ u-shu̱ u̱ ha-m m-mo̱. <verse eid="GEN 24:42"/><verse number="43" style="v" sid="GEN 24:43"/>Gwat, me̱ ya ees u̱-kit-u̱ du-du̱ m-bu̱ dinde̱, to̱o̱g-u̱s se̱ u̱zu̱, da-u̱ wa'-u̱ gwu̱p-u̱ haane̱ u̱ nak-du̱ m-bu̱, u̱m do̱'e̱ zu̱ du̱ wa, &lt;&lt;Ya me̱ m-bu̱ u̱m swa du̱gu̱ sharru̱ m-bu̱ ró.&gt;&gt; <verse eid="GEN 24:43"/><verse number="44" style="v" sid="GEN 24:44"/>Se̱di wa zu̱ me̱, &lt;&lt;Swa, me̱ u̱t-ya rakum-u̱ ró m-bu̱ ko̱ya,&gt;&gt; yage̱ wa shu̱'u̱t ne̱ta wu̱ Yawe dage̱ wa'-u̱ u̱so-u̱ u-bu ri.&gt;<verse eid="GEN 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 24:45"/>&lt;&lt;Kanda u̱m taaste̱ u̱s-to̱o̱g jab-u̱ ri, Rebeka rwu̱u̱n u̱r-shar ne̱ m-sak u̱ do̱s u̱ wa, wa aru̱k m-sa u̱r-du wa yu̱bu̱n m-bu̱, se̱ u̱m zu̱ wa, &lt;Ya me̱ m-bu̱ m-swa.&gt;<verse eid="GEN 24:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 24:46"/>&lt;&lt;Wa no̱m m-ho̱r m-ho̱r wa cu̱st sharru̱ m-bu̱ du̱gu̱ zagu̱ zag-u̱t-kap wa zu̱, &lt;Swa, me̱ u̱t-ya rakum-u̱ ró ko̱ e̱,&gt; se̱ u̱m so, wa yu̱ rakum ko̱'e̱ e̱ so.<verse eid="GEN 24:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="GEN 24:47"/>&lt;&lt;Se̱ u̱m shit wa, &lt;¿Gwu̱p-u̱ wan wa bo̱ o̱ye̱?&gt;</para>
  <para style="p" vid="GEN 24:47">&lt;&lt;Wa zu̱ me̱, &lt;Gwu̱p-u̱ Be̱tuwe̱r yu̱ wa'-u̱ Naho̱r, wu̱ Mirka matu̱ wa.&gt;</para>
  <para style="p" vid="GEN 24:47">&lt;&lt;Da-u o̱ u̱m wa'-u̱ wu̱n u-kwaat u̱r-swa u̱ kwa-yu̱ u̱t-kom ne̱. <verse eid="GEN 24:47"/><verse number="48" style="v" sid="GEN 24:48"/>Se̱ u̱m he̱ u̱t-jwu̱n u̱m no̱me̱ Yawe u̱t-huuk, tu̱msu̱ u̱m no̱mu̱ Yawe u̱t-vam, Ru̱-u u̱so u-bu ri Ibrahi, remu̱ zu̱ wa dor-u̱t te̱ me̱ fu̱n-yu̱ u̱t-nip m-ha u̱du̱ ko̱-du̱ u̱so-u wa remu̱ u̱m kwu̱mtu̱n wa'-u̱ wa ne̱ta. <verse eid="GEN 24:48"/><verse number="49" style="v" sid="GEN 24:49"/>U̱ da-o̱, abite̱ u̱zu̱ bo̱ u̱t-re̱ u-shu̱ u̱ ko̱su̱ jab-u̱ so̱-o̱ u̱du̱ u̱so-u̱ u-bu ri, waru̱ me̱, abite̱ bo̱ zaar u̱t-ko̱se̱ da waru̱ me̱, ko̱ me̱ u̱t-nap fu̱n-yu̱ u̱m do̱'e̱ u̱t-do̱r.&gt;&gt;<verse eid="GEN 24:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50"/>Ku̱na Raban ne̱ e̱ Be̱tuwe̱r zu̱, &lt;&lt;Yawe hattu̱n bo̱ u̱ ane̱, o̱ko̱n no̱m-o̱ zaar u̱ it do̱'e̱ u̱t-zu̱ da. <verse eid="GEN 24:50"/><verse number="51" style="v" sid="GEN 24:51"/>Rebeka ya u̱-shu̱ ró, kab wa bo̱ aru̱k, yage̱ wa shu̱'u̱t ne̱ta wa'-u̱ u̱so-u̱ u-bu ró u̱ka Yawe zu̱tte̱.&gt;&gt;<verse eid="GEN 24:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 24:52"/>Da-u̱ to̱k-u̱ Ibrahi ho̱ge̱ shas-u u̱n, wa he̱ u-dak u̱t-jwu̱n wa no̱me̱ Yawe u̱t-huuk. <verse eid="GEN 24:52"/><verse number="53" style="v" sid="GEN 24:53"/>Se̱ to̱k-u̱ wa rwu̱tu̱n kwam-u̱t pus-to̱ u̱ kwam-tu̱ bu̱-mu̱ u̱t-ro ne̱ u̱s-re̱ge̱z ne̱ su̱ shik so̱k u̱ cwu̱-tu̱ m-wa ne̱ tu̱ so̱-to̱ wa yase̱ Rebeka, se̱ tu̱msu̱ wa yu̱ u-nya u̱ no̱m-tu̱ shik u̱du̱ yu̱-wu̱ya wa u̱ ino̱-u wa ne̱. <verse eid="GEN 24:53"/><verse number="54" style="v" sid="GEN 24:54"/>Se̱ to̱k-u̱ Ibrahi u̱ campa-ne̱ o̱ u̱r-kot u̱ wa ne̱, re e̱ so tu̱msu̱ e̱ roog u̱ku̱n.</para>
  <para style="p" vid="GEN 24:54">Se̱ e̱ yu̱ne̱ u̱r-wu̱n, wa zu̱, &lt;&lt;Yagu̱n it aru̱k m-mu̱ u̱du̱ u̱so-u̱ u-bu ri.&gt;&gt;<verse eid="GEN 24:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55"/>Se̱di yu̱-wu̱ya Rebeka u̱ ino-u rò ne̱ shu̱s e̱ zu̱, &lt;&lt;It u̱t-sa u̱ Rebeka shu̱'u̱t u̱ it ne̱ m-ha m-roog u̱t-o̱p, kanda no̱ aru̱k.&gt;&gt;<verse eid="GEN 24:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56"/>Se̱ wa zu̱ u̱n, &lt;&lt;A no̱ naas it u-da u̱ ane̱ da, Yawe yaag me̱ re̱ u-shu̱ u̱ ha-m ri, yagu̱n it aru̱k, it mu u̱du̱ u̱so-u̱ u-bu ri.&gt;&gt;<verse eid="GEN 24:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57"/>Se̱ u̱n zu̱, &lt;&lt;Yage̱ it fagu̱n gwu̱p it shit wa u̱ mo̱t-u̱t to̱ ne̱ it ho̱g.&gt;&gt; <verse eid="GEN 24:57"/><verse number="58" style="v" sid="GEN 24:58"/>Se̱ u̱n fagu̱n Rebeka u̱n shit wa, &lt;&lt;¿Bo̱ do̱ru̱ ne̱t-u̱ wa m-mu̱?&gt;&gt;</para>
  <para style="p" vid="GEN 24:58">Wa shu̱s wa zu̱, &lt;&lt;Me̱ u̱t-do̱r wu̱n.&gt;&gt;<verse eid="GEN 24:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59"/>Se̱ u̱n yage̱ u̱ Rebeka u̱ ne̱ta waru̱g wa ne̱, u̱ to̱k-u̱ Ibrahi ne̱ u̱ hu̱u̱b-tu̱ m-ha wa ne̱ e̱ aru̱k. <verse eid="GEN 24:59"/><verse number="60" style="v" sid="GEN 24:60"/>Se̱ u̱n wa'-u̱ Rebeka nu-u so̱-o̱ kanda wa aru̱k, u̱n zu̱ wa,</para>
  <para style="q1" vid="GEN 24:60">&lt;&lt;Hu̱no-u it, u̱ bo̱ shu̱'u̱t</para>
  <para style="q2" vid="GEN 24:60">ino̱ u̱ yaag u̱t-zo̱ngu</para>
  <para style="q2" vid="GEN 24:60">u̱-do̱m u̱t-zo̱ngu</para>
  <para style="q1" vid="GEN 24:60">Yage̱ ya'ag-u̱ ró e̱ re u̱r-ko̱rro̱</para>
  <para style="q2" vid="GEN 24:60">u̱ e̱ o̱nk bo̱-tu̱ hu̱u̱b-u̱t yo̱-to̱ e̱ ne̱.&gt;&gt;<verse eid="GEN 24:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61"/>Se̱ Rebeka u̱ to̱k-u̱t wa ne̱, e̱ du̱u̱s u̱-do̱m u-rakum e̱ do̱r ne̱t-u̱ wa. Se̱ to̱k-u̱ Ibrahi ku̱b Rebeka e̱ aru̱k m-mu̱.<verse eid="GEN 24:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62"/>U̱ da-u o̱ Ishaku mu̱gu̱n du̱gu̱ Beer-Rahai Roi wa o̱ shu̱'u̱t do̱g-du̱ Ne̱giv. <verse eid="GEN 24:62"/><verse number="63" style="v" sid="GEN 24:63"/>De̱ku̱n ho̱-de̱ Ishaku rwu̱gu̱n m-rim wa o̱ m-da tu̱msu̱ wa o̱ u̱s-dorog, se̱ wa jaku̱s u̱r-hi, wa hyen rakum u̱ daan. <verse eid="GEN 24:63"/><verse number="64" style="v" sid="GEN 24:64"/>Da-u̱ Rebeka jakse̱ is wa hyan Ishaku, wa no̱m m-ho̱r wa cu̱zu̱n du̱gu̱ u-rakum yu̱ wa o̱tte̱ m-sak. <verse eid="GEN 24:64"/><verse number="65" style="v" sid="GEN 24:65"/>Rebeka zu̱ to̱k-u̱ Ibrahi, &lt;&lt;¿Wana unwa jit wu̱ o̱ haan u̱du̱ ine̱?&gt;&gt;</para>
  <para style="p" vid="GEN 24:65">To̱k-u̱ wa zu̱, &lt;&lt;U̱so u-bu ri Ishaku wa.&gt;&gt; Rebeka ku̱b u-ge̱re̱ wa taku̱s shu̱-u wa.<verse eid="GEN 24:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66"/>Se̱ to̱k-u̱ wa waru̱ Ishaku no̱m-u̱ wa no̱me̱ u-be̱e̱t. <verse eid="GEN 24:66"/><verse number="67" style="v" sid="GEN 24:67"/>Ishaku ku̱b Rebeka wa hu̱u̱t wa u̱ be-du̱ rimpa-du̱ ino̱-u wa Saratu, se̱ wa gu Rebeka. Wa shu̱'u̱t ne̱ta wa, wa cwanu̱g wa so̱k; iya o̱ hen Ishaku kumte̱ ru̱s-du̱ jab ba ino-u wa mare̱.<verse eid="GEN 24:67"/></para>
  <chapter eid="GEN 24"/>
  <chapter number="25" style="c" sid="GEN 25"/>
  <para style="s1">E̱ke̱n ya'ag-u̱ Ibrahi</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1"/>Ibrahi gu̱ yaku̱n ne̱ta ya dim-u̱r wa Ketura. <verse eid="GEN 25:1"/><verse number="2" style="v" sid="GEN 25:2"/>Ketura mu̱t ya'ag-u̱ campa-ne̱ shishin e̱ na foge̱ Zimran, Jokshan, Medan, Midiya, Ishbak, u̱ Suya ne̱. <verse eid="GEN 25:2"/><verse number="3" style="v" sid="GEN 25:3"/>Jokshan wa mate̱ Sheba u̱ Dedan. Yaag-u̱ Dedan e̱ na zu̱ye̱ Assur-ne̱, u̱ Retushi-ne̱, u̱ Remin-ne̱. <verse eid="GEN 25:3"/><verse number="4" style="v" sid="GEN 25:4"/>Yaag-u̱ campa-ne̱ Midiya e̱ o̱ye̱:</para>
  <para style="li1" vid="GEN 25:4">Epa ne̱,</para>
  <para style="li1" vid="GEN 25:4">u̱ Epe̱r ne̱,</para>
  <para style="li1" vid="GEN 25:4">u̱ Hano̱k ne̱,</para>
  <para style="li1" vid="GEN 25:4">u̱ Abida ne̱,</para>
  <para style="li1" vid="GEN 25:4">u̱ Erdak ne̱.</para>
  <para style="p" vid="GEN 25:4">Ine̱ be̱e̱t e̱ o̱o̱ge̱ ko̱r Ibrahi du̱gu̱ gasu Ketura.<verse eid="GEN 25:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5"/>Ibrahi yasu̱ no̱m-u̱ u̱t-ko̱mu̱ wa u-be̱e̱t u̱du̱ Ishaku. <verse eid="GEN 25:5"/><verse number="6" style="v" sid="GEN 25:6"/>Kanda Ibrahi mu̱r-u̱t, wa no̱mu̱ ya'ag-u̱ ne̱ta-tu̱ u̱s-kit-u̱ wa u-nya wa tom e̱ be̱e̱t m-ha dak-u̱ u-do̱m, m-ra u̱ Ishaku ne̱.<verse eid="GEN 25:6"/></para>
  <para style="s1">Mar-m Ibrahi</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7"/>Ibrahi no̱ng u̱s-hak u̱t-shik u̱t-eer u̱ o̱p u̱s-tan [175] <verse eid="GEN 25:7"/><verse number="8" style="v" sid="GEN 25:8"/>Ibrahi maru̱g u̱ te̱k-u̱ u̱s-hak su̱ so̱-se̱, ne̱nge̱n-yu̱ u̱s-hak u-tát, wa dor u̱so-tu̱ u̱so-u̱t wa. <verse eid="GEN 25:8"/><verse number="9" style="v" sid="GEN 25:9"/>Yaag-u̱ wu̱n Ishaku ne̱ e̱ Ismaru, e̱ dok wu̱n u̱ pu̱ku̱s u̱ Mape̱ra, u̱ dapu̱s Mamre u̱-me tak-u Eparo̱n wa'-u̱ Zohar ne̱t-u̱ He̱t-ne̱. <verse eid="GEN 25:9"/><verse number="10" style="v" sid="GEN 25:10"/>Tak-u o̱ Ibrahi o̱ye̱ du̱gu̱-du̱ He̱t-ne̱ ku̱na wa dokte̱ Saratu ne̱ta wa. <verse eid="GEN 25:10"/><verse number="11" style="v" sid="GEN 25:11"/>Da-u̱ Ibrahi mare̱, Ru̱-u̱ wa'-u̱ Ishaku nu-u so̱-o̱, wu̱ shu̱'u̱te̱ dap-u̱s bo̱-u̱ na foge̱ Beer-Rahai.<verse eid="GEN 25:11"/></para>
  <para style="s1">Ko̱-u̱r Ismaru</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12"/>Uno̱ o̱ ogu̱r-tu̱ ya'ag-u̱ Ismaru wa'-u̱ Ibrahi. Hajara ne̱t-u̱ dak-u̱ Masar to̱k-u̱ Saratu, wa matu̱ Ismaru.<verse eid="GEN 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 25:13"/>Dim-tu̱ ya'ag-u̱ campa-ne̱ Ismaru ya, na pang to̱ u̱ka mat-u̱r e̱: Nebayo̱t wa o̱o̱ge̱ mat-du̱ u̱r-taku̱n Ismaru, u̱ Kedar, u̱ Adbeer, u̱ Misam, <verse eid="GEN 25:13"/><verse number="14" style="v" sid="GEN 25:14"/>u̱ Mishma, u̱ Duma, u̱ Masa, <verse eid="GEN 25:14"/><verse number="15" style="v" sid="GEN 25:15"/>u̱ Hada, u̱ Tema, u̱ Je̱tur, u̱ Napu̱hish, u̱ Kedema ne̱. <verse eid="GEN 25:15"/><verse number="16" style="v" sid="GEN 25:16"/>Ine̱ o̱ ya'ag-u̱ Ismaru, tu̱msu̱ tun-to̱ to̱ o̱ dim-tu̱ faru̱k-tu̱ u̱t-ko̱ e̱ ko̱wan u̱ be-du̱ u̱r-shu̱'u̱t-u̱ wa ne̱. <verse eid="GEN 25:16"/><verse number="17" style="v" sid="GEN 25:17"/>Ismaru no̱mu̱g u̱s-hak u̱t-shik u̱t-shishin u̱ o̱p-u̱ ta'er [137], se̱ mu̱ru̱s wa do̱r u̱so-tu̱ u̱so-u̱t wa. <verse eid="GEN 25:17"/><verse number="18" style="v" sid="GEN 25:18"/>Yaag-u̱ wa e̱ shu̱'u̱t u̱ gas-u̱ bo̱-u̱ Havira, m-ha Shur ne̱. U̱ dapu̱s bo̱r-yu̱ Masar, a-bo̱ o̱o̱ge̱ m-ha u̱ bo̱-u̱ Asur. Tu̱msu̱ e̱ nom shu̱'u̱t-u̱r yo̱-de̱ u̱ hu̱no-tu̱ u̱r-mat-u̱ e̱ ne̱ u̱t-be̱e̱t.<verse eid="GEN 25:18"/></para>
  <para style="s1">Mat-u̱r Isuwa ne̱ <optbreak/> e̱ Yakubu</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19"/>Uno̱ o̱ ogor-tu̱ ya'ag-u̱ Ishaku wa'-u̱ Ibrahi.</para>
  <para style="p" vid="GEN 25:19">Ibrahi wa matu̱ Ishaku. <verse eid="GEN 25:19"/><verse number="20" style="v" sid="GEN 25:20"/>Da-u̱ Ishaku o̱o̱ge̱ u̱s-hak u̱t-shik u̱t-yu̱r [40], wa gu̱ Rebeka gwu̱p-u̱ Be̱tuwe̱r, ne̱t-u̱ bo̱-u̱ Aram du̱gu̱ Padan-aram hu̱no̱ Raban ne̱t-u̱ Aram-ne̱.<verse eid="GEN 25:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 25:21"/>Ishaku nom u̱s-to̱o̱g u̱du̱ Yawe u̱ remu̱ ne̱ta wa, remu̱ zu̱ wa matu̱k yaag da. Ru̱-u̱ o̱nk to̱o̱g-u̱s Ishaku, se̱ Rebeka ku̱b me̱n-tu̱ ya'ag-u̱ yu̱r. <verse eid="GEN 25:21"/><verse number="22" style="v" sid="GEN 25:22"/>Se̱ ya'ag-u̱ e̱ hu̱ u̱t-noos u̱ me̱n-tu̱ u̱t-me̱n. Se̱ Rebeka do̱'e̱ wa shit Yawe, wa zu̱ &lt;&lt;¿Yan-o̱ wa e̱ uno̱ no̱m o̱ o̱tte̱ u̱t-no̱m ne̱?&gt;&gt;<verse eid="GEN 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 25:23"/>Se̱ Yawe zu̱ wu̱n,</para>
  <para style="q1" vid="GEN 25:23">&lt;&lt;Ne̱t-ne̱ yu̱r e̱ o̱ye̱ u̱ me̱n-u̱t ró</para>
  <para style="q2" vid="GEN 25:23">damra tu̱ u̱t-dak to̱ u̱t-yu̱r.</para>
  <para style="q1" vid="GEN 25:23">Du̱gu̱ u̱r-taku̱n,</para>
  <para style="q2" vid="GEN 25:23">dak-tu̱ u̱t-yu̱r u̱ to̱ do̱'e̱</para>
  <para style="q1" vid="GEN 25:23">u̱t-mo̱t du̱gu̱ me̱ u̱t-me̱n.</para>
  <para style="q2" vid="GEN 25:23">Wa-gan do̱'e̱ ze̱g-du̱</para>
  <para style="q2" vid="GEN 25:23">wa-gan u̱r-be̱b,</para>
  <para style="q1" vid="GEN 25:23">ya'ag-u̱ e̱ wu̱ do̱'e̱ rwu̱u̱n u̱r-taku̱n</para>
  <para style="q2" vid="GEN 25:23">wa do̱'e̱ no̱mu̱ wu̱ m-vaste̱ m-to̱k.&gt;&gt;<verse eid="GEN 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24"/>Da-u̱ ho̱-tu̱ u̱r-mat no̱me̱, Rebeka nu̱p u̱zu̱ ya'ag-u̱ yu̱r e̱ wa o̱tte̱ mu̱n-u̱t wa. <verse eid="GEN 25:24"/><verse number="25" style="v" sid="GEN 25:25"/>Wu̱ rwu̱ne̱ u̱r-taku̱n wa o̱ jaz-ya, war-u wa o̱ u̱s-can ne̱ sha-mu̱ can-tu̱ u-gwaar, na wa'-u̱ wa u̱r-dim Isuwa. Iya-o̱ na fogte̱ dim-u̱r re̱ u̱ rem-du̱ Ibra-ne̱. &lt;&lt;Wa u̱s-can.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">25:25 </char><char style="ft" closed="false">Isuwa </char><char style="ft" closed="false">u̱t-kere̱ u̱t-shu̱'u̱t </char><char style="fq" closed="false">u̱s-can</char><char style="ft" closed="false">; na fog wa E̱do̱m, u̱ na zu̱ye̱ </char><char style="fq" closed="false">jaz-ya</char><char style="ft" closed="false">.</char></note><verse eid="GEN 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 25:26"/>Se̱ wu̱ rwu̱ne̱ u-yu̱ru̱mse̱ na mak-u̱t wa m-shu̱p-u̱ du̱ku̱nte̱-u̱r Isuwa ne̱, dim-u̱r wa de̱ Yakubu. U̱ rem-du̱ Ibra-ne̱ iya-o̱ na fogte̱ dim-u̱r re̱ &lt;&lt;U̱r-du̱ku̱nte̱.&gt;&gt; Da-u̱ na mate̱ ya'ag-u̱ yu̱r, Ishaku o̱ u̱s-hak u̱t-shik u̱t-tu̱t [60].<verse eid="GEN 25:26"/></para>
  <para style="s1">Isuwa bu̱pu̱ste̱ o̱g-du̱ <optbreak/> mat-du̱ u-shu̱ wa</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27"/>Da-u̱ ya'ag-u̱ campa-ne̱ e̱ ne̱ne̱, Isuwa shu̱'u̱t wa sa-u̱ u̱r-do̱g, wa o̱ u̱ka ne̱t u̱r-do̱g. Se̱di Yakubu wa zatte̱ u̱s-rem da, wa ze̱k-u̱ cwan-tu̱ shu̱'u̱t-du̱ u̱t-rimpa. <verse eid="GEN 25:27"/><verse number="28" style="v" sid="GEN 25:28"/>Ishaku ze̱k-u̱ cwan-u̱t Isuwa remu̱ zu̱ wa ze̱k-u̱ cwan-tu̱ ap-mu̱ u̱r-do̱g, se̱di Rebeka ze̱k-u̱ cwan-u̱t Yakubu.<verse eid="GEN 25:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29"/>De̱ku̱n ho̱-de̱ Yakubu o̱ u̱ no̱m-du̱ cwa-su̱ m-re̱re̱m, Isuwa mu̱u̱n du̱gu̱ u̱r-do̱g wa pogu̱n wa-o u̱ ho̱g-du̱ u̱s-me̱r. <verse eid="GEN 25:29"/><verse number="30" style="v" sid="GEN 25:30"/>Wa zu̱ Yakubu, &lt;&lt;Gye̱r jab, u̱m o̱ ho̱g-du̱ u̱s-me̱r, ya me̱ cwa-u̱s jasse̱ su̱ m-re̱re̱m-u̱ ró se̱ u̱m re̱!&gt;&gt; (Iya o̱ Isuwa kumte̱ dim-u̱r re̱, du̱ na zu̱ye̱ Edo̱m tu̱msu̱ na zu̱ de̱ &lt;&lt;jas-de̱.&gt;&gt;)<verse eid="GEN 25:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31"/>Yakubu shu̱s wa zu̱, &lt;&lt;Me̱ ya bo̱, se̱di u̱m o̱ u̱ssa bo̱ babu̱ me̱ o̱g-du̱ mat-du̱ u-shu̱ ró.&gt;&gt;<verse eid="GEN 25:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32"/>Isuwa zu̱, &lt;&lt;Me̱ ya u̱m o̱ m-mar u̱s-me̱r, ¿yan-o̱ shu̱'u̱t-u̱r ri mat-du̱ u-shu̱ no̱mu̱ me̱ u̱ da-o̱?&gt;&gt;<verse eid="GEN 25:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33"/>Yakubu zu̱, &lt;&lt;U̱ da-o̱ u̱m o̱ u̱ssa bo̱ to̱n-de̱ u̱zu̱ bo̱ yasu̱ me̱ o̱g-du̱ mat-du̱ u-shu̱.&gt;&gt; Da-u o̱ Isuwa to̱n-de̱, wa bu̱psu̱ Yakubu du̱-dim-u̱ wa o̱g-du̱ mat-du̱ u-shu̱ wa.<verse eid="GEN 25:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 25:34"/>Da-u o̱ Yakubu ya'e̱ Isuwa u̱t-be̱re̱di u̱ cwa-su̱ yaar ne̱, Isuwa re̱ no̱m u̱t-re̱, wa yu̱ne wa aru̱k.</para>
  <para style="p" vid="GEN 25:34">Iya o̱ Isuwa ju̱ru̱mte̱ o̱g-du̱ mat-du̱ u-shu̱ wa.<verse eid="GEN 25:34"/></para>
  <chapter eid="GEN 25"/>
  <chapter number="26" style="c" sid="GEN 26"/>
  <para style="s1">Ishaku ne̱ e̱ Abime̱re̱k</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1"/>U̱ da-u o̱ na no̱ng se̱ke̱n me̱r-u̱s yasse u-dak, u̱ka na nomte̱ da-u Ibrahi. Ishaku aru̱k m-ha u̱du̱ Abime̱re̱k faru̱k-u̱ Firistiya-ne̱ bo̱-u̱ Gerar. <verse eid="GEN 26:1"/><verse number="2" style="v" sid="GEN 26:2"/>Yawe haan u̱du̱ Ishaku wa zu̱ wa, &lt;&lt;A-bo̱ o̱ m-ha dak-u̱ Masar da, se̱di bo̱ no̱m ka u̱m zu̱tte̱ bo̱. <verse eid="GEN 26:2"/><verse number="3" style="v" sid="GEN 26:3"/>Shu̱'u̱te̱ ane̱ sha-mu̱ ham-u̱t u-dak, me̱ u̱t-no̱m u̱r-kot u̱ bo̱ ne̱. Tu̱msu̱ me̱ wa'-u̱ bo̱ nu-u so̱-o̱, me̱ ya'u̱ bo̱ u̱ ko̱-u̱r ró ne̱ uno̱ dak-o̱. U̱m shu̱u̱s to̱nd-u̱s ri su̱ u̱m no̱me̱ u̱ u̱so-u ró ne̱ Ibrahi. <verse eid="GEN 26:3"/><verse number="4" style="v" sid="GEN 26:4"/>Me̱ u̱t-wa ya'ag-u̱ ró e̱ shu̱'u̱t u-tát u̱ka re̱ge̱r i do̱m u-ru̱, tu̱msu̱ me̱ yasu̱ e̱ uno̱ dak-o̱. Tu̱msu̱ du̱gu̱-du̱ ya'ag-u̱ ró de̱ ne̱t-tu̱ dak-u uno̱ u-be̱e̱t e̱ do̱te̱ kwu̱m-du̱ kom-u so̱-o̱ u̱ u-Ru̱. <verse eid="GEN 26:4"/><verse number="5" style="v" sid="GEN 26:5"/>Me̱ no̱mu̱ uno̱ no̱m-o̱ remu̱ zu̱ Ibrahi ho̱k rem-u̱s ri tu̱msu̱ wa no̱mu̱g no̱m-tu̱ u̱m zu̱ye̱ wa no̱m, wa do̱ro̱g rem-u̱s ri, u̱ bo̱r-u̱t ri ne̱ u̱t-be̱e̱t.&gt;&gt; <verse eid="GEN 26:5"/><verse number="6" style="v" sid="GEN 26:6"/>Ishaku shu̱'u̱t Gerar.<verse eid="GEN 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 26:7"/>Da-u̱ ne̱t-tu̱ o̱ shu̱'u̱t u̱ku̱n e̱ shite̱ Ishaku mo̱ttu̱ ne̱ta wa, wa zu̱ u̱n, &lt;&lt;Hu̱no-u ri wa.&gt;&gt; Rem u̱zu̱ wa o̱ u̱ ho̱g-du̱ u-gye̱r wa zu̱, &lt;&lt;Ne̱ta ri wa.&gt;&gt; Wa no̱ng u̱s-dorog u̱zu̱, &lt;&lt;Taas u̱ ne̱t-u̱t tun-to̱ ho̱ me̱ u̱ remu̱ Rebeka, remu̱ zu̱ wa so̱-ya sok.&gt;&gt;<verse eid="GEN 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 26:8"/>Da-u̱ Ishaku tumbe̱ u̱ku̱n, Abime̱re̱k faru̱k-u̱ Firistiya-ne̱ wa wu̱kse̱ du̱gu̱ pyam-yu̱ u-kur wa hyu̱n Ishaku o̱ tamgu̱ war-u̱ ne̱ta wa Rebeka. <verse eid="GEN 26:8"/><verse number="9" style="v" sid="GEN 26:9"/>Za naas u-da, Abime̱re̱k fog Ishaku. Wa zu̱, &lt;&lt;Za o̱ko̱n sakna o̱ ne̱ta rò wa! ¿Remu̱ yan-o̱ bo̱ zu̱tte̱, &lt;Hu̱no-u ri wa&gt;?&gt;&gt;</para>
  <para style="p" vid="GEN 26:9">Ishaku shu̱s wa zu̱, &lt;&lt;U̱m o̱ ho̱g-du̱ u-gye̱r u̱zu̱ na ho̱ me̱ na kab ne̱ta ri.&gt;&gt;<verse eid="GEN 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10"/>Abime̱re̱k zu̱, &lt;&lt;¿Yan-o̱ wa'e̱ bo̱ no̱mtu̱ it go̱-du̱ uno̱ no̱m-o̱? Waku̱n u̱ te̱k-u̱ ne̱t-u̱t ri wa kere̱ m-roog u̱ wa ne̱, a-za shu̱'u̱te̱ iya bo̱ za wa'ag it no̱m-du̱ baas-u̱t u̱t-yatto̱!&gt;&gt;<verse eid="GEN 26:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 26:11"/>Se̱ Abime̱re̱k no̱m u̱r-do̱nse̱, wa nu̱k ne̱t-ne̱ u̱t-to̱. Wa zu̱ e̱, &lt;&lt;Ko̱wan wu̱ tame̱ ne̱t unwa ko̱ ne̱ta wa na ho̱ wa.&gt;&gt;<verse eid="GEN 26:11"/></para>
  <para style="s1">Du-tu̱ m-bu̱ Ishaku</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12"/>Da-u̱ Ishaku kawe̱ no̱m-tu̱ u-go̱s u̱ hak-u ya, wa kum no̱m-tu̱ u̱r-to̱m u-so u-ko̱k u-gan m-ze̱g no̱mu̱ wa kawe̱, Yawe wa'agu̱ wa kom-u so̱-o̱. <verse eid="GEN 26:12"/><verse number="13" style="v" sid="GEN 26:13"/>Wa shu̱'u̱t wa-u̱t-kwu̱m so̱k, no̱m u̱t-kom-u̱ wa re̱ u-shu̱ m-swu̱r-ne̱. <verse eid="GEN 26:13"/><verse number="14" style="v" sid="GEN 26:14"/>Wa kum ban-tu̱ ca u̱ ban-tu̱ gwaar ne̱, u̱ ban-tu̱ na ne̱, u̱ to̱k-ne̱ u-bu ne̱ u-tát, Firistiya-ne̱ hu̱ shu̱b-u̱r wa. <verse eid="GEN 26:14"/><verse number="15" style="v" sid="GEN 26:15"/>Firistiya-ne̱ e̱ shu̱u̱s du-tu̱ m-bu̱ tu̱ to̱k-ne̱ u̱so-u wa Ibrahi kawe̱ m-huug.<verse eid="GEN 26:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16"/>Abime̱re̱k zu̱ Ishaku, &lt;&lt;Yu̱ne̱ bo̱ yage̱ bo̱-u it, remu̱ zu̱ bo̱ be̱b-u̱r it.&gt;&gt;<verse eid="GEN 26:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 26:17"/>Se̱ Ishaku yu̱ne̱ wa muus u̱ gas-u̱ fu̱g-yu̱ Gerar, ku̱na wa ku̱u̱te u̱r-rimpa, wa shu̱'u̱t u̱ku̱n. <verse eid="GEN 26:17"/><verse number="18" style="v" sid="GEN 26:18"/>Ishaku sur m-kaw du-tu̱ u̱so-u wa kawe̱, du-tu̱ Firistiya-ne̱ takse̱ da-u̱ Ibrahi mare̱, wa muut dim-tu̱ na o̱o̱ge̱ na wa'agu̱ du̱-u̱t to̱ wa wa'-u̱ go̱-du̱ dim-du̱ Ibrahi te̱'e̱ to̱.<verse eid="GEN 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19"/>To̱k-ne̱ Ishaku e̱ ku̱w de̱ku̱n du-de̱ u̱ me̱n-tu̱ fu̱g-u ya e̱ kum bu̱-m so̱-mo̱. <verse eid="GEN 26:19"/><verse number="20" style="v" sid="GEN 26:20"/>Se̱di ne̱t-tu̱ Gerar haan e̱ hu̱ kadu̱ gwu̱z-u̱ a-gwat-du̱ u̱t-bisa ne̱ Ishaku e̱ zu̱, &lt;&lt;Du-du̱ m-bu̱ e̱ de̱!&gt;&gt; Se̱ Ishaku te̱'e̱ du-u̱r re̱ u̱r-dim E̱sek no̱m-u̱ na zu̱ye̱ kadu̱ &lt;&lt;u-gwu̱z.&gt;&gt; <verse eid="GEN 26:20"/><verse number="21" style="v" sid="GEN 26:21"/>Se̱ ne̱t-u̱t Ishaku sur m-kaw de̱ku̱n du-de̱ tu̱msu̱ na sur m-ka gwu̱z-u̱ de̱ ne̱. Se̱ Ishaku sur m-te̱'e̱ du-u̱r re̱ u̱r-dim, &lt;&lt;U̱t-gu̱gu̱m.&gt;&gt; <verse eid="GEN 26:21"/><verse number="22" style="v" sid="GEN 26:22"/>Wa yu̱ne̱ be-u̱r re̱ wa sur m-kaw de̱ku̱n du-de̱, se̱di e̱ swu̱ru̱g m-ka gwu̱z-u̱ de̱ ne̱ da. Se̱ wa fog du-u̱r re̱ u̱r-dim Rehobo̱t, du̱ na foge̱, Be-du̱ na upse̱ remu̱ zu̱ wa zu̱u̱g, &lt;&lt;Yawe upuste̱ u̱r-ke̱ngi u-tát du̱ it do̱te̱ u̱t-shu̱'u̱t m-yang ne̱ u-dak.&gt;&gt;<verse eid="GEN 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23"/>Du̱gu̱ ku̱n Ishaku aru̱k m-ha Be̱rshe̱ba. <verse eid="GEN 26:23"/><verse number="24" style="v" sid="GEN 26:24"/>U̱ gyu̱p-m mo̱ Yawe haan u̱du̱ rò wa zu̱, &lt;&lt;Me̱ wa o̱ u-Ru̱ u̱ u̱so-u ró Ibrahi. Wa zu̱ wu̱n a-bo̱ ho̱g u-gye̱r da u̱m o̱ u̱r-kot u̱ bo̱ ne̱ tu̱msu̱ me̱ wa'-u̱ bo̱ nu-u so̱-o̱. Me̱ u̱t-wa ya'ag-u̱ ró no̱m u-tát, e̱ do̱'e̱ u̱t-shu̱'u̱t damra u-dak. Me̱ u̱t-no̱m iya remu̱ este̱du̱ u̱s-rem su̱ it u̱ Ibrahi to̱k-u̱ ri no̱me̱.&gt;&gt;<verse eid="GEN 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 26:25"/>Ishaku mu̱ u̱r-sak du̱ no̱m-du̱ to̱o̱g u̱ku̱n wa no̱mu̱ Yawe u̱t-huuk. Wa nom rimpa-u̱r wa u̱ku̱n, se̱ to̱k-ne̱ wa e̱ sur m-kaw de̱ku̱n du-de̱.<verse eid="GEN 26:25"/></para>
  <para style="s1">Este̱du̱ u̱s-rem su̱ Ishaku <optbreak/> e̱ Abime̱re̱k</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26"/>Da-u̱ arke̱ Abime̱re̱k tamge̱ haan du̱gu̱ Gerar, u̱ Ahuzza wa ya-du̱ wa u̱s-rem, u̱ Piko̱r ne̱ yu̱-Yat-ya karma wa ne̱. <verse eid="GEN 26:26"/><verse number="27" style="v" sid="GEN 26:27"/>Ishaku zu̱ u̱n &lt;&lt;¿Rem u-yan o no̱ haatu̱n u̱ ane̱? No̱ gu̱gu̱mte̱ me̱ sok, no̱ yanu̱g me̱ du̱gu̱ dak-u no̱!&gt;&gt;<verse eid="GEN 26:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28"/>E̱ shu̱s, e̱ zu̱, &lt;&lt;It hyanu̱g u̱ is-u̱ it u̱zu̱ Yawe o̱ u̱r-kot u̱ bo̱ ne̱. Remu̱ iya it o̱ u̱ssa it no̱m u̱s-to̱nd su̱ same̱-du̱ u̱t-hi u̱ bo̱ ne̱, yage̱ in no̱mo̱n este̱du̱ u̱s-rem u̱ bo̱ ne̱. <verse eid="GEN 26:28"/><verse number="29" style="v" sid="GEN 26:29"/>It o̱ u̱ssa u̱zu̱ bo̱ to̱n-de̱ bo̱ za no̱mu̱ it no̱m-u̱t yo̱-to̱ da, u̱ka it no̱m-tu̱ bo̱ da. U-da u-be̱e̱t it o̱ no̱mu̱ bo̱ no̱m-u̱t so̱-to̱, it buz bo̱ du̱gu̱ dak-u it m-yar, u̱ da-o̱ it gwak-u̱t u̱ka Yawe watu̱ bo̱ kom-u so̱-o̱.&gt;&gt;<verse eid="GEN 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 26:30"/>Se̱ Ishaku no̱mu̱ u̱n mo̱ro̱g-du̱ este̱du̱ u̱s-rem, u̱n re̱ no̱m u̱t-re̱ u̱ no̱m-u̱t u̱t-swa ne̱. <verse eid="GEN 26:30"/><verse number="31" style="v" sid="GEN 26:31"/>Tun u̱r-wu̱n, u̱n nom u̱s-to̱nd su̱ m-yar u̱ o̱r-u̱t u̱n ne̱, se̱ Ishaku to̱k u̱n m-mu̱, u̱n aru̱k u̱n yage̱ wa m-yar.<verse eid="GEN 26:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32"/>U̱ ho̱-u̱r re̱ to̱k-ne̱ Ishaku haan e̱ waru̱ wa mo̱ttu̱ du-u̱r po-de̱ du̱ e̱ kawe̱, e̱ zu̱, &lt;&lt;It kwu̱ng m-bu̱!&gt;&gt; <verse eid="GEN 26:32"/><verse number="33" style="v" sid="GEN 26:33"/>Se̱ Ishaku fog dim-du̱ be-u̱r re̱ Shiba, du̱ na foge̱ du-du̱ u̱s-to̱nd u̱r-ma u̱ haan u̱ uno̱ da-o̱, iya-o̱ na fogte̱ be-u̱r re̱ Be̱rshe̱ba du̱ na foge̱ Be̱rsheba.<verse eid="GEN 26:33"/></para>
  <para style="s1">Ne̱ta-u̱t Isuwa</para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34"/>Da-u̱ Isuwa o̱o̱ge̱ u̱t-shik u̱t-yu̱r (40), wa gu̱ Judit gwu̱p-u̱ Beeri ne̱t-u̱ He̱t-ne̱, tu̱msu̱ u̱ Basemat ne̱ gwu̱p-u̱ Ero̱n ne̱t-u̱ He̱t-ne̱. <verse eid="GEN 26:34"/><verse number="35" style="v" sid="GEN 26:35"/>Se̱di ne̱ta-u̱t to̱ naknu̱ Ishaku namu̱ jab-u̱ Rebeka.<verse eid="GEN 26:35"/></para>
  <chapter eid="GEN 26"/>
  <chapter number="27" style="c" sid="GEN 27"/>
  <para style="s1">Ishaku wa'agu̱ Yakubu <optbreak/> nu-u so̱-o̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1"/>De̱ku̱n ho̱-de̱ da-u̱ Ishaku wu̱u̱me̱ tu̱msu̱ wa he̱e̱ste̱ m-po̱, se̱ wa fog Isuwa, mat-du̱ u-shu̱ wa, wa zu̱, &lt;&lt;Wa'-u̱ ri.&gt;&gt;</para>
  <para style="p" vid="GEN 27:1">Wa shu̱s wa zu̱, &lt;&lt;Me̱ ya.&gt;&gt;<verse eid="GEN 27:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2"/>Ishaku zu̱, &lt;&lt;U̱ da-o̱ u̱m wu̱u̱mte̱ u̱m nak ho̱-du̱ m-mar u̱ ri da. <verse eid="GEN 27:2"/><verse number="3" style="v" sid="GEN 27:3"/>U̱ da-o̱ kab ta-u ró u-por ne̱ u̱s-e̱r ne̱, bo̱ cwa u̱r-do̱g bo̱ ho̱o̱nu̱ me̱ ap-mu̱ u̱r-do̱g. <verse eid="GEN 27:3"/><verse number="4" style="v" sid="GEN 27:4"/>Bo̱ no̱mu̱ me̱ no̱m u̱t-re̱ m-re̱re̱m u̱ u̱m ze̱ge̱ u̱t-cwan, bo̱ hatu̱n me̱ u̱m re̱, da-u o̱ me̱ wa'-u̱ bo̱ nu-u so̱-o̱ u̱ o̱o̱ge̱ u̱ mat-du̱ u-shu̱ kanda u̱m mar.&gt;&gt;<verse eid="GEN 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5"/>Se̱di Rebeka o̱ u̱ ho̱g-du̱ no̱m-u̱ Ishaku o̱o̱ge̱ waru̱ wa'-u̱ wa Isuwa. Da-u Isuwa arke̱ m-cwa u̱r-do̱g u̱ sa-u̱ ap-mu̱ u̱r-do̱g, <verse eid="GEN 27:5"/><verse number="6" style="v" sid="GEN 27:6"/>Rebeka zu̱ Yakubu, &lt;&lt;U̱m ho̱k no̱mu̱ u̱so-u ró o̱o̱ge̱ waru̱ o̱r-u̱ ró Isuwa. <verse eid="GEN 27:6"/><verse number="7" style="v" sid="GEN 27:7"/>Wa zu̱ wa, &lt;Ho̱o̱nu̱ me̱ ap-mu̱ u̱r-do̱g, bo̱ ryu̱su̱ me̱ no̱m u̱t-re̱ u̱ m-re̱re̱m da-u o̱ u̱m wa'-u̱ bo̱ nu-u so̱-o̱ Yawe m-ho̱g kanda u̱m mar.&gt; <verse eid="GEN 27:7"/><verse number="8" style="v" sid="GEN 27:8"/>U̱ da-o̱ wa'-u̱ ri ho̱g no̱m u̱m do̱'e̱ waru̱ bo̱ u-be̱e̱t: <verse eid="GEN 27:8"/><verse number="9" style="v" sid="GEN 27:9"/>De̱'e̱ bo̱ cwa me̱n-tu̱ ban-du̱ gwaar bo̱ haatu̱n ya'ag-u̱ gwaar yu̱r. U̱m do̱'e̱ ryu̱su̱ u̱so-u ró no̱m u̱t-re̱ m-re̱re̱m u̱ wa o̱o̱ge̱ u̱t-cwan. <verse eid="GEN 27:9"/><verse number="10" style="v" sid="GEN 27:10"/>Da-u o̱ bo̱ do̱'e̱ u̱ kabdu̱ no̱m u̱t-re̱ o̱ bo̱ hu̱u̱tu̱ uso-u ró wa re̱, wa wa'-u̱ bo̱ nu-u so̱-o̱ kanda wa mar.&gt;&gt;<verse eid="GEN 27:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11"/>Se̱ Yakubu zu̱ Rebeka, &lt;&lt;Yu̱-wu̱ya ri Isuwa o̱tte̱ war u̱t-can, me̱ u̱m zatte̱ da. <verse eid="GEN 27:11"/><verse number="12" style="v" sid="GEN 27:12"/>¿A mu̱ne̱ u̱zu̱ u̱so-u̱ ri tamu̱g war-u ri? Wa do̱'e̱ u̱t-gwat u̱zu̱ u̱m o̱ u̱ssa u̱m no̱mu̱ wa u̱s-ve̱r, wa do̱'e̱ wa'-u̱ me̱ nu-u yo̱-o̱ m-ze̱g nu-u so̱-o̱.&gt;&gt;<verse eid="GEN 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13"/>Se̱di ino-u rò zu̱ wu̱n, &lt;&lt;Yage̱ nu-u yo̱-o̱ mu̱u̱nu̱ me̱ wa'-u̱ ri. Bo̱ di no̱m no̱m-u̱ u̱m zu̱ bo̱, do̱'e̱ bo̱ masu̱n gwaar bo̱ hatu̱n me̱.&gt;&gt;<verse eid="GEN 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 27:14"/>Se̱ Yakubu do̱'e̱ wa masu̱n gwaar yu̱r, wa hatu̱n ino-u wa. Rebeka ku̱b e̱ wa do̱'e̱ wa ryu̱su̱n no̱m u̱t-re̱ m-re̱rem, u̱ka Ishaku o̱tte̱ u̱t-cwan ne̱. <verse eid="GEN 27:14"/><verse number="15" style="v" sid="GEN 27:15"/>Rebeka kabu̱n cwu̱-u̱t so̱-to̱ tu̱ Isuwa wa'-u̱ u̱r-taku̱n wa, tu̱ o̱o̱ge̱ u̱ku̱n u-bu, wa kabu̱n to̱ wa wa'-u̱ Yakubu du̱-fade̱ Isuwa. <verse eid="GEN 27:15"/><verse number="16" style="v" sid="GEN 27:16"/>Se̱ wa ku̱b can-tu̱ u-gwaar wa wa'-u̱ Yakubu, u̱t-kom u̱ ge̱ksu̱ wa ne̱ be-tu̱ o̱o̱ge̱ za u̱t-can. <verse eid="GEN 27:16"/><verse number="17" style="v" sid="GEN 27:17"/>Se̱ wa ku̱b no̱m u̱t-re̱ u̱ wu̱s u-haku̱n wa yasu̱ Yakubu u̱r-be̱re̱di ne̱ du̱ wa no̱me̱.<verse eid="GEN 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18"/>Yakubu ku̱b no̱m u̱t-re̱ o̱ wa yasu̱ u̱so-u wa, wa zu̱ &lt;&lt;Uso-u ri.&gt;&gt;</para>
  <para style="p" vid="GEN 27:18">Wa shu̱s wa zu̱, &lt;&lt;Wa'-u̱ ri.&gt;&gt;</para>
  <para style="p" vid="GEN 27:18">Ishaku shu̱s wa zu̱, &lt;&lt;¿Bo̱ na zu̱ wane̱?&gt;&gt;<verse eid="GEN 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19"/>Yakubu shu̱s wa zu̱, &lt;&lt;Me̱ wa Isuwa wa'-u̱ u̱r-taku̱n u̱ ró. U̱m no̱mu̱g u̱ka bo̱ zu̱tte̱ u̱m no̱m, ap-mu̱ u̱r-do̱g-u̱ mo̱ ya. Yu̱ne̱ u̱r-shu̱'u̱t bo̱ re̱ ko̱ bo̱ wa'-u̱ me̱ nu-u so̱-o̱.&gt;&gt;<verse eid="GEN 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20"/>Ishaku zu̱, &lt;&lt;Wa'-u̱ ri ¿Re̱ o̱ bo̱ kwu̱mtu̱n iya m-ho̱r m-ho̱r?&gt;&gt;</para>
  <para style="p" vid="GEN 27:20">Yakubu shu̱s wa zu̱, &lt;&lt;Yawe Ru̱-u ró wa no̱mu̱ me̱ u̱r-se̱ge̱ u̱m kwu̱mtu̱n.&gt;&gt;<verse eid="GEN 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21"/>Ishaku zu̱ Yakubu, &lt;&lt;Hane̱ u̱ kit-u̱ ri u̱m tam bo̱, u̱m nu̱pu̱t u̱zu̱ ko̱ bo̱ wa Isuwa.&gt;&gt;<verse eid="GEN 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 27:22"/>Se̱ Yakubu do̱'e̱ u̱ kit-u̱ u̱so-u wa. Ishaku tu̱m wu̱n, wa zu̱, &lt;&lt;Cwar-u Yakubu ya, se̱di u̱t-kom tu̱ Isuwa to̱.&gt;&gt;<verse eid="GEN 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 27:23"/>Se̱di wa kerge̱ u̱t-nap u̱zu̱ Yakubu wa da, remu̱ kom-u̱t Yakubu o̱ u̱t-can ne̱ sha-m Isuwa. Se̱ Ishaku zo̱ng wa wa'-u̱ wu̱n nu-u so̱-o̱. <verse eid="GEN 27:23"/><verse number="24" style="v" sid="GEN 27:24"/>Wa shit wu̱n, &lt;&lt;¿Bo̱ wa u̱t-nip wa'-u̱ ri Isuwa?&gt;&gt; Yakubu zu̱, &lt;&lt;Me̱ wa.&gt;&gt;<verse eid="GEN 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25"/>Ishaku zu̱, &lt;&lt;Hatu̱n me̱ ap-mu̱ u̱r-do̱g u̱m tu̱ da-u o̱ se̱ u̱m wa'-u̱ bo̱ nu-u so̱-o̱.&gt;&gt;</para>
  <para style="p" vid="GEN 27:25">Se̱ Yakubu ku̱b no̱m u̱t-re̱ o̱ wa hu̱u̱tu̱ u̱so-u wa, Ishaku re̱ no̱m u̱t-re̱ o, wa so ke̱ i Yakubu hatu̱n wa. <verse eid="GEN 27:25"/><verse number="26" style="v" sid="GEN 27:26"/>Se̱ Ishaku zu̱ Yakubu &lt;&lt;Wa'-u̱ ri, gag jab haane̱ kit-u̱ ri bo̱ ham-u̱t me̱.&gt;&gt;<verse eid="GEN 27:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 27:27"/>Yakubu do̱'e̱ wa ham-u̱t wu̱n. Da-u̱ Ishaku ho̱ge̱ wu̱s-u̱ kus-tu̱ war-u wu̱n, da-u o̱ wa he̱e̱se̱ wa'-u̱ wu̱n nu-u so̱-o̱, wa zu̱,</para>
  <para style="q1" vid="GEN 27:27">&lt;&lt;Wu̱s-u̱ kus-tu̱ wa'-u̱ ri</para>
  <para style="q2" vid="GEN 27:27">to̱ o̱ sha-mu̱ wu̱s-u̱ u̱r-do̱g ne̱,</para>
  <para style="q1" vid="GEN 27:27">wu̱ Yawe wa'e̱ nu-u so̱-o̱.<verse eid="GEN 27:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="GEN 27:28"/>Yage̱ Ru̱-u̱ ya bo̱ u̱t-rapu̱t</para>
  <para style="q2" vid="GEN 27:28">tu̱ do̱m u-ru̱,</para>
  <para style="q1" vid="GEN 27:28">u̱ no̱m u̱t-kom ne̱ u-dak,</para>
  <para style="q2" vid="GEN 27:28">yage̱ Ru̱-u̱ ya bo̱ no̱m-tu̱ u̱r-to̱m u-tát,</para>
  <para style="q1" vid="GEN 27:28">tu̱msu̱ m-mu̱di ne̱.<verse eid="GEN 27:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="GEN 27:29"/>Yage̱ ne̱t-tu̱ u-dak</para>
  <para style="q2" vid="GEN 27:29">u̱ no̱m-u̱ bo̱ m-to̱k</para>
  <para style="q1" vid="GEN 27:29">tu̱msu̱ e̱ kwu̱ktu̱ bo̱ u̱t-jwu̱n.</para>
  <para style="q2" vid="GEN 27:29">Bo̱ shu̱'u̱t yu̱-Yat-ya o̱r-u̱t ró ne̱,</para>
  <para style="q1" vid="GEN 27:29">yage̱ ya'ag-u̱ ino̱ ró</para>
  <para style="q2" vid="GEN 27:29">e̱ kwu̱ktu̱ bo̱ u̱t-jwu̱n.</para>
  <para style="q1" vid="GEN 27:29">Ko̱wana wa'-u̱ bo̱ nu-u yo̱-o̱</para>
  <para style="q2" vid="GEN 27:29">yage̱ u̱ nu-u yo̱-o̱ mu u̱du̱ wa,</para>
  <para style="q1" vid="GEN 27:29">tu̱msu̱ ko̱wana wa'-u̱ bo̱</para>
  <para style="q2" vid="GEN 27:29">nu-u so̱-o̱ u̱ nu-u so̱-o̱ mu u̱du̱ wa.&gt;&gt;<verse eid="GEN 27:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30"/>Da-u̱ Ishaku tase̱ wa'-u̱ Yakubu nu-u so̱-o̱, ba Yakubu o̱ yage̱ u-kur du̱gu̱-du̱ u̱so-u wa, se̱ Isuwa mu̱u̱n du̱gu̱ u-sa. <verse eid="GEN 27:30"/><verse number="31" style="v" sid="GEN 27:31"/>Isuwa ryu̱su̱n no̱m u̱t-re̱ m-re̱re̱m wa haatu̱n u̱so-u wa. Se̱ wa zu̱, &lt;&lt;U̱so-u ri, yu̱ne̱, bo̱-tu̱ ap-mu̱ u̱r-do̱g remu̱ bo̱ watu̱ me̱ nu-u so̱-o̱ ró.&gt;&gt;<verse eid="GEN 27:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32"/>Ishaku shit wu̱n, &lt;&lt;¿Bo̱ wa na zu̱ wa ne̱?&gt;&gt;</para>
  <para style="p" vid="GEN 27:32">Isuwa shu̱s wa zu̱, &lt;&lt;Wa'-u̱ ró wa, mat-du̱ u-shu̱ ró, Isuwa.&gt;&gt;<verse eid="GEN 27:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33"/>Ishaku he̱e̱se̱ zap-mu̱ namu̱ jab sok, wa zu̱, &lt;&lt;¿Wana haatu̱n me̱ ap-mu̱ u̱r-do̱g? U̱m taaste̱ u̱t-re̱, tu̱msu̱ u̱m wa'agu̱ wa nu-u so̱-o̱ kanda bo̱ mu̱u̱n, tu̱msu̱ za o̱ko̱n sakna o̱ wa shu̱'u̱te̱ wa nu-u so̱-o̱!&gt;&gt;<verse eid="GEN 27:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34"/>Da-u̱ Isuwa ho̱ge̱ no̱mu̱ u̱so wa zu̱ye̱, se̱ wa kau̱s u-jar yu̱ u̱s-kan m-yat. Wa no̱m u̱s-ko̱n wa zu̱ u̱so-u wa, &lt;&lt;U̱so ri, ¿re̱-o̱ me̱ ho̱mo̱? Wa-u̱ me̱ nu-u so̱-o̱ ko̱me̱!&gt;&gt;<verse eid="GEN 27:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35"/>Ishaku shu̱s wa zu̱, &lt;&lt;Hu̱no-u ró haagu̱n u̱ ane̱, wa no̱mu̱ me̱ u̱s-ve̱r, wa o̱nkte̱ nu-u so̱-o̱ ró u-be̱e̱t.&gt;&gt;<verse eid="GEN 27:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36"/>Isuwa zu̱, &lt;&lt;Rekku̱n ho̱n-ho̱n u̱ka dim-u̱r rò Yakubu, &lt;Wa re̱-u̱ u-ra.&gt; Remu̱ zu̱ wa e̱ngu̱sse̱ ve̱r-u̱s ri u-so u-yu̱r. U̱r-taku̱n, wa kabu̱g o̱g-du̱ mat-du̱ u-shu̱ ri, tu̱msu̱ wa ku̱b nu-u so̱-o̱ ri.&gt;&gt; Se̱ wa shit, &lt;&lt;¿Bo̱ zatte̱ nu-u so̱-o̱ u̱ bo̱ kwu̱su̱ me̱ da?&gt;&gt;<verse eid="GEN 27:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37"/>Ishaku shu̱s wa zu̱ Isuwa, &lt;&lt;Wa'-u̱ ri, u̱m wa'ag Yakubu wa shu̱'u̱t yu̱-Yat-ya ró. Tu̱msu̱ u̱m zu̱u̱g o̱r-u̱t wa ne̱ be̱e̱t e̱ do̱'e̱ u̱t-shu̱'u̱t to̱k-u̱ wa ne̱, u̱ no̱m-tu̱ u̱r-to̱m tu̱ u-tak u̱ wa ne̱, u̱ ke̱ ne̱. U̱ da-o ¿yan-o̱ u̱m do̱'e̱ no̱m-u̱ bo̱?&gt;&gt;<verse eid="GEN 27:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38"/>Isuwa zu̱ u̱so wa, &lt;&lt;¿Bo̱ zamu̱n u̱ nu-u so̱-o̱ ko̱ u-gan da? U̱so ri, wa'-u̱ me̱ ko̱me̱ nu-u so̱-o̱!&gt;&gt;</para>
  <para style="p" vid="GEN 27:38">Isuwa ku̱st gu̱t-du̱ u̱s-kan.<verse eid="GEN 27:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39"/>M-vaste̱ u̱so-u rò Ishaku zu̱ wu̱n,</para>
  <para style="q1" vid="GEN 27:39">&lt;&lt;Bu-u ró do̱'e̱ u̱t-shu̱'u̱t</para>
  <para style="q2" vid="GEN 27:39">m-ra u̱ kwu̱m-tu̱ u-dak-ne̱,</para>
  <para style="q1" vid="GEN 27:39">tu̱msu̱ o̱ do̱'e̱ u̱t-shu̱'u̱t</para>
  <para style="q2" vid="GEN 27:39">m-ra u̱ rapu̱t ne̱ du̱gu̱ do̱m-u̱ u-ru̱ ne̱.<verse eid="GEN 27:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="GEN 27:40"/>Van-yu̱ m-wu̱r ró</para>
  <para style="q2" vid="GEN 27:40">ya bo̱ do̱te̱ u̱r-yu̱,</para>
  <para style="q1" vid="GEN 27:40">tu̱msu̱ bo̱ do̱'e̱ no̱mu̱</para>
  <para style="q2" vid="GEN 27:40">hu̱no̱ ró m-to̱k.</para>
  <para style="q1" vid="GEN 27:40">Se̱di a-bo̱ o̱o̱ge̱ u̱ssa u̱</para>
  <para style="q2" vid="GEN 27:40">bo̱ ru du̱gu̱ m-to̱k,</para>
  <para style="q1" vid="GEN 27:40">bo̱ keru̱ cu̱st-u̱ nom-mo̱</para>
  <para style="q2" vid="GEN 27:40">du̱gu̱ ge̱ksu̱ ró.&gt;&gt;<verse eid="GEN 27:40"/></para>
  <para style="s1">Yakubu so̱mo̱g m-ha u̱du̱ yu̱-wu̱ya <optbreak/> ino-u wa Raban</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41"/>Du̱gu̱ da-u o̱ Isuwa gu̱gu̱m hu̱no-u wa Yakubu, remu̱ zu̱ u̱so wa ya'aste̱ Yakubu nu-u so̱-o̱. Isuwa he̱e̱se̱ u̱s-dorog u̱zu̱, &lt;&lt;Da-u̱ u̱so-u ri mare̱, it taas namu̱ jab, da-u o̱ u̱m de̱ ho̱-du̱ Yakubu!&gt;&gt;<verse eid="GEN 27:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42"/>Se̱di Rebeka ho̱k no̱m-u̱ Isuwa u̱t-sa u̱t-no̱m, se̱ wa-to̱m na fagnu̱ wa Yakubu wa waru̱ wa, wa zu̱, &lt;&lt;E̱r me̱, Isuwa wa'agu̱ jab-u̱ wa, wa no̱ng u̱s-dorog wa de̱ ho̱-du̱ bo̱. <verse eid="GEN 27:42"/><verse number="43" style="v" sid="GEN 27:43"/>Wa'-u̱ ri, u̱m o̱ u̱ssa bo̱ e̱r me̱ sok. So̱m za naas u-da m-ha u̱du̱ yu̱-wu̱ya ri campa wu̱ na zu̱ye̱ Raban u̱ bo̱-u̱ Haran. <verse eid="GEN 27:43"/><verse number="44" style="v" sid="GEN 27:44"/>De̱'e̱ bo̱ shu̱'u̱t u̱ku̱n u̱ wu̱n ne̱, se̱ da-u̱ jab-u̱ hu̱no̱ ró ru̱te. <verse eid="GEN 27:44"/><verse number="45" style="v" sid="GEN 27:45"/>Da-u̱ jab-u̱ wa ru̱te u̱zu̱ kaag wa u̱t-to̱ u̱ no̱m-u̱ bo̱ no̱mu̱ wa ne̱, me̱ u̱t-to̱mo̱n bo̱ mu̱u̱n. ¿Remu̱ yan-o̱ u̱m do̱te̱ u̱t-taag u̱ no̱ ne̱ be̱e̱t u̱r-ho̱ u̱r-gan?&gt;&gt;<verse eid="GEN 27:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46"/>Rebeka zu̱ Ishaku, &lt;&lt;Me̱ ha u̱m zatte̱ m-yar da remu̱ ne̱ta-tu̱ He̱t tun-to̱ ne̱. U̱t-ze̱g m-ku̱k u̱zu̱ mar-to̱ u̱m mare̱ u̱ Yakubu gu̱u̱t u̱ te̱k-u̱ ne̱ta-u̱t tun-to̱.&gt;&gt;<verse eid="GEN 27:46"/></para>
  <chapter eid="GEN 27"/>
  <chapter number="28" style="c" sid="GEN 28"/>
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1"/>Se̱ Ishaku fog Yakubu, se̱ wa wa'-u̱ wa nu-u so̱-o̱, wa zu̱, &lt;&lt;A-bo̱ jaru̱n bo̱ o̱ m-ga u̱ te̱k-u̱ ne̱ta-tu̱ dak-u̱ Kan'ana tun-to̱ da. <verse eid="GEN 28:1"/><verse number="2" style="v" sid="GEN 28:2"/>De̱'e̱ u̱ dak-u̱ Padan-aram u̱ bu-u Be̱tuwe̱r, u̱so ino-u ró. Bo̱ ga waku̱n u̱ te̱k-u̱ ya-u̱t-gwu̱p Raban, yu̱-wu̱ya ino-u ró. <verse eid="GEN 28:2"/><verse number="3" style="v" sid="GEN 28:3"/>Yage̱ u-Ru̱ wu̱ o̱tte̱ be̱b-du̱ ko̱-uyan be̱e̱t, wa wa'-u̱ bo̱ kom-u so̱-o̱ tu̱msu̱ bo̱ mat ya'agu̱ e̱ tu̱msu̱ yage̱ Ru̱-u̱ wa bo̱ shu̱'u̱t u̱so u̱ u̱t-dak u-tát. <verse eid="GEN 28:3"/><verse number="4" style="v" sid="GEN 28:4"/>Yage̱ Ru̱-u̱ wa'-u̱ bo̱ u̱ ya'ag-u̱ ró ne̱ nu-u so̱-o̱ u̱ka wa watu̱ Ibrahi, remu̱ bo̱ reet dak-u uno̱ u̱ bo̱ o̱tte̱ shu̱'u̱t u̱ka ham-u̱t, dak-u̱ Ru̱-u̱ ya-e̱ Ibrahi.&gt;&gt; <verse eid="GEN 28:4"/><verse number="5" style="v" sid="GEN 28:5"/>Ishaku tok Yakubu wa aru̱k, se̱ wa aru̱k m-ha u̱ Padan-Aram, u̱du̱ Raban wa'-u̱ Be̱tuwe̱r ne̱t-u̱ Aram, yu̱-wu̱ya Rebeka, wu̱ o̱o̱ge̱ ino̱ Yakubu e̱ Isuwa.<verse eid="GEN 28:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6"/>Se̱ Isuwa nu̱p u̱zu̱ u̱so-u wa Ishaku wa'agu̱ Yakubu nu-u so̱-o̱, wa tom wa m-ha u̱ Padan-Aram u̱ wa gatu̱n ne̱ta u̱ku̱n, tu̱msu̱ Ishaku nong-u̱ Yakubu u̱t-him u̱zu̱, &lt;&lt;A-bo̱ jaru̱n bo̱ o̱ m-ga ne̱ta ne̱ta-tu̱ Kan'ana da.&gt;&gt; <verse eid="GEN 28:6"/><verse number="7" style="v" sid="GEN 28:7"/>Wa nu̱p tu̱msu̱ u̱zu̱ Yakubu kabu̱g him-tu̱ i matu̱ wa, Yakubu aru̱k m-ha Padan-Aram. <verse eid="GEN 28:7"/><verse number="8" style="v" sid="GEN 28:8"/>Isuwa nu̱p u̱zu̱ u̱so-u wa Ishaku zaru̱ cwan-tu̱ ne̱ta-tu̱ Kan'ana da. <verse eid="GEN 28:8"/><verse number="9" style="v" sid="GEN 28:9"/>Se̱ Isuwa do̱'e̱ u̱du̱ Ismaru wa gaan Maharat, Maharat wa o̱ hu̱no-u Nebayo̱t u̱ gwu̱p-u̱ Ismaru ne̱ wa'-u̱ Ibrahi, u̱r-dame̱ ne̱ta-tu̱ wa ba-e̱ m-gaan u̱r-taku̱n ne̱.<verse eid="GEN 28:9"/></para>
  <para style="s1">Bo-u̱ Yakubu u̱ Be̱te̱r</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10"/>Yakubu yage̱ bo̱-u̱ Be̱rshe̱ba wa do̱'e̱ Haran. <verse eid="GEN 28:10"/><verse number="11" style="v" sid="GEN 28:11"/>Da-u̱ wa teye̱ de̱ku̱n be-de̱, wa ees remu̱ zu̱ gyu̱p-mu̱ no̱mu̱g ho̱-du̱ he̱e̱g. Se̱ wa ku̱b u̱r-ta'ar, wa peg u̱r-hi wa ru̱t u̱ wa roogte̱. <verse eid="GEN 28:11"/><verse number="12" style="v" sid="GEN 28:12"/>M-gyu̱p wa o̱ u̱ te̱k m-roog, se̱ wa hyu̱n u-kan du̱gu̱ u-dak m-da u̱ do̱m u-ru̱, se̱ wa hyen a-to̱m u-Ru̱ e̱ o̱ u̱r-da u̱-cu̱zu̱n u̱-do̱m u-kan. <verse eid="GEN 28:12"/><verse number="13" style="v" sid="GEN 28:13"/>Se̱ wa hyen Yawe u̱ ees u̱-do̱m u-kan, se̱ wa zu̱, &lt;&lt;Me̱ wa Yawe, Ru̱-u̱ u̱so-u̱ u̱so no̱ Ibrahi, tu̱msu̱ Ru̱-u̱ u̱so-u no̱ Ishaku. Dak-u̱ no̱ o̱tte̱ m-ru̱t o̱, u̱m o̱ ya-du̱ o̱ u̱du̱ ró u̱ ya'ag-u̱ ró ne̱. <verse eid="GEN 28:13"/><verse number="14" style="v" sid="GEN 28:14"/>Yaag-u̱ ró do̱'e̱ u̱t-shu̱'u̱t u-tát ba huug-mu̱ u-dak, no̱ do̱'e̱ u̱t-bu̱ru̱g u-do̱m u-ta ne̱, tu̱msu̱ no̱ do̱'e̱ u̱t-bu̱ru̱g kom-u̱ u̱t-cwa u̱ kom u̱r-beer ne̱. Tu̱msu̱ du̱gu̱-du̱ ró u̱ ya'ag-u̱ ró de̱ u-dak u-be̱e̱t e̱ do̱te̱ kwu̱m-du̱ kom-u so̱-o̱. <verse eid="GEN 28:14"/><verse number="15" style="v" sid="GEN 28:15"/>U̱m o̱ u̱r-kot u̱ bo̱ ne̱ me̱ u̱t-gwat bo̱ ko̱he̱ne̱ o̱ bo̱ o̱tte̱ m-ha. Tu̱msu̱ me̱ mu̱u̱tu̱n bo̱ u̱ uno̱ dak-o̱. U̱m da yaag-u̱ bo̱ da se̱ u̱m taaste̱ ya-du̱ bo̱ u̱t-no̱m u̱t-be̱e̱t tu̱ u̱m no̱mu̱ bo̱ este̱du̱ u̱s-rem su̱ u̱m no̱mu̱ bo̱.&gt;&gt;<verse eid="GEN 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16"/>Da-u̱ Yakubu yu̱ne̱ du̱gu̱ m-roog, wa zu̱, &lt;&lt;Nip-to̱ Yawe o̱ro u̱ be-u̱r rin-de̱, se̱di u̱m nak da.&gt;&gt; <verse eid="GEN 28:16"/><verse number="17" style="v" sid="GEN 28:17"/>Se̱di wa o̱ u̱ ho̱g-du̱ u-gye̱r, wa zu̱, &lt;&lt;Be-u̱r rin-de̱ o̱ u-gye̱r ne̱, za u-sakna be-u̱r rin-de̱ bu-u̱ u-Ru̱ o̱, is-yu̱ cwa-du̱ do̱m u-Ru̱.&gt;&gt;<verse eid="GEN 28:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18"/>Tun u̱r-wu̱n Yakubu ku̱b ta'ar-du̱ wa pegte̱ u̱r-hi, wa yu̱nu̱s de̱ m-kim u̱ka ta'ar-du̱ u̱t-hu̱ktin wa da'as m-no̱o̱g u̱ do̱m-u̱ de̱. <verse eid="GEN 28:18"/><verse number="19" style="v" sid="GEN 28:19"/>Wa fog dim-du̱ be-u̱r re̱ Be̱te̱r (du̱ na foge̱ &lt;&lt;bu-u̱ u-Ru̱&gt;&gt;) na o̱o̱g m-fag be-u̱r re̱ bo̱-u̱ Ruz.<verse eid="GEN 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 28:20"/>Se̱ Yakubu no̱m u̱s-to̱nd, wa zu̱, &lt;&lt;Abite̱ u̱zu̱ Ru̱-u̱ o̱ u̱r-kot ne̱, tu̱msu̱ wa u̱t-gwat me̱ u̱ ha-mu̱ u̱m o̱tte̱, tu̱msu̱ wa ya' me̱ no̱m u̱t-re̱ u̱ cwu̱-tu̱ m-wa ne̱, <verse eid="GEN 28:20"/><verse number="21" style="v" sid="GEN 28:21"/>A u̱m mu̱ne̱ m-yar u̱ bu-u̱ u̱so-u ri, Yawe u̱t-shu̱'u̱t Ru̱-u ri. <verse eid="GEN 28:21"/><verse number="22" style="v" sid="GEN 28:22"/>Tu̱msu̱ din-de̱ ta'ar-de̱ du̱ u̱m yu̱nse̱ m-kim be-u̱r re̱ u̱t-shu̱'u̱t be-du̱ u̱t-huuk, me̱ u̱t-ya u-Ru̱ u̱t-ho̱ o̱p no̱m-u̱ wa ya' me̱ u-be̱e̱t.&gt;&gt;<verse eid="GEN 28:22"/></para>
  <chapter eid="GEN 28"/>
  <chapter number="29" style="c" sid="GEN 29"/>
  <para style="s1">Yakubu teeg bu-u Raban</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1"/>Yakubu re̱ u-shu̱ u̱ ha-m wa ne̱ wa te dak-u̱ ne̱t-tu̱ u-do̱m. <verse eid="GEN 29:1"/><verse number="2" style="v" sid="GEN 29:2"/>Wa hyu̱n u̱r-du du̱ m-bu̱ du̱gu̱ m-ra, u̱ ban-tu̱ ca u̱ gwaar ne̱ u̱t-tu̱t e̱ o̱ ru̱ku̱sse̱ u̱ dapu̱s u̱r-du, e̱ o̱ u̱r-e' na ya' e̱ m-bu̱ e̱ swa, se̱di damra u-ta'ar o̱ na zwapte̱ nu-u̱ du-u̱r re̱. <verse eid="GEN 29:2"/><verse number="3" style="v" sid="GEN 29:3"/>Da-u̱ ca karge̱ be̱e̱t u̱ku̱n, a-gwat-du̱ ca ne̱ karu̱g be̱e̱t da-u o̱ e̱ haste̱ u̱r-ta'ar du̱gu̱ nu-u̱ u̱r-du e̱ yu̱ ban-tu̱ ca e̱ m-bu̱ e̱ so, da-u o̱ tu̱msu̱ e̱ karge̱ e̱ muut ta'ar-u̱r re̱ u̱ nu-u̱ u̱r-du e̱ tage̱.<verse eid="GEN 29:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4"/>Yakubu do̱'e̱ u̱du̱ a-gwat-du̱ ca ne̱ wa shit, &lt;&lt;Hu̱u̱b-u̱t ri, ¿du̱gu̱ he̱ no̱ rwu̱ne̱?&gt;&gt;</para>
  <para style="p" vid="GEN 29:4">E̱ zu̱ wu̱n, &lt;&lt;It rwu̱gu̱n du̱gu̱ Haran.&gt;&gt;<verse eid="GEN 29:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5"/>Wa zu̱ e̱, &lt;&lt;¿No̱ nak waku̱n wu̱na zu̱ye̱ Raban, wa'-u̱ Be̱tuwe̱r, wa'-u̱ Naho̱r?&gt;&gt;</para>
  <para style="p" vid="GEN 29:5">U̱n zu̱ wa, &lt;&lt;It nak wa.&gt;&gt;<verse eid="GEN 29:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6"/>Yakubu zu̱ u̱n, &lt;&lt;¿Wa o̱ m-yar?&gt;&gt;</para>
  <para style="p" vid="GEN 29:6">Se̱ u̱n zu̱ wa, &lt;&lt;Wa o̱ m-yar, gwu̱p-u̱ wa Rahira ya jit u̱ daan u̱ ban-du̱ ca ne̱.&gt;&gt;<verse eid="GEN 29:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7"/>Yakubu zu̱, &lt;&lt;Ho̱-du̱ o̱mo̱n teeg da-u̱ kargu̱sse̱ ban-tu̱ ca da. Ya ca m-bu̱ bo̱ muut e̱ u̱du̱ u̱t-re̱e̱g.&gt;&gt;<verse eid="GEN 29:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8"/>Se̱ u̱n zu̱ wa, &lt;&lt;It zaar u̱t-kere̱ da se̱ ban-tu̱ ca karu̱gte̱ u̱t-be̱e̱t na hast u̱r-ta'ar du̱gu̱ nu-u̱ u̱r-du. Da-u o̱ it do̱'e̱ u̱ ya-du̱ ca m-bu̱.&gt;&gt;<verse eid="GEN 29:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9"/>Yakubu o̱ te̱k-u̱ no̱mu̱ u̱n u̱s-rem se̱ Rahira teen u̱ ban-du̱ ca du̱ u̱so-u wa ne̱, wu̱na gote̱ ca e̱. <verse eid="GEN 29:9"/><verse number="10" style="v" sid="GEN 29:10"/>Da-u̱ Yakubu hyane̱ Rahira gwu̱p-u̱ Raban, yu̱-wu̱ya ino̱-u wa, u̱ ban-du̱ ca Raban ne̱ wa do̱'e̱ wa hast u̱r-ta'ar du̱gu̱ nu-u u̱r-du wa yu̱' ca yu̱-wu̱ya ino̱-u wa m-bu̱. <verse eid="GEN 29:10"/><verse number="11" style="v" sid="GEN 29:11"/>Se̱ Yakubu ham-u̱t Rahira, wa ku̱st gu̱t-du̱ u̱s-kan su̱ u̱r-so̱. <verse eid="GEN 29:11"/><verse number="12" style="v" sid="GEN 29:12"/>Yakubu tamu̱g waru̱ Rahira u̱zu̱, &lt;&lt;Me̱ du̱gu̱ ko̱-du̱ u̱so-u ró de̱, Rebeka wa matu̱ me̱.&gt;&gt; Se̱ wa ku̱su̱m m-so̱m wa waru̱ u̱so-u wa.<verse eid="GEN 29:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 29:13"/>Da-u̱ Raban ho̱ge̱ u̱zu̱ Yakubu, wa'-u̱ du̱-dim-u̱ wa tegen, wa ku̱su̱m m-so̱m wa bit wa. Se̱ wa shipis wa, wa ham-u̱t wu̱n tu̱msu̱ wa mu̱u̱tu̱n wa u-bu. Se̱ Yakubu waru̱ wu̱n no̱mu̱ no̱me̱ u-be̱e̱t. <verse eid="GEN 29:13"/><verse number="14" style="v" sid="GEN 29:14"/>Raban zu̱ wu̱n, &lt;&lt;Nip-to̱, war-u ri bo̱ o̱o̱ge̱ u̱ hyu̱-m ri ne̱.&gt;&gt;</para>
  <para style="s1" vid="GEN 29:14">Yakubu gaag Riya ne̱ <optbreak/> e̱ Rahira</para>
  <para style="p" vid="GEN 29:14">Yakubu shu̱'u̱t u̱ku̱n u-pyat u-gan. <verse eid="GEN 29:14"/><verse number="15" style="v" sid="GEN 29:15"/>Raban zu̱ Yakubu, &lt;&lt;Remu̱ zu̱ bo̱ wa ko̱-u̱r ri wa bo̱ o̱ye̱, bo̱ za no̱mu̱ me̱ m-to̱k za u-top da. Waru̱ me̱ no̱mu̱ u̱m do̱'e̱ to̱p-du̱ bo̱.&gt;&gt;<verse eid="GEN 29:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 29:16"/>Raban o̱tte̱ ya-u̱t-gwu̱p yu̱r, yu̱ wu̱ya na zu̱ wa Riya, yu̱ dim tu̱msu̱ na zu̱ wa Rahira. <verse eid="GEN 29:16"/><verse number="17" style="v" sid="GEN 29:17"/>Riya zatte̱ is-u̱t so̱-to̱ so̱k da, se̱di Rahira o̱tte̱ shu̱-u so̱-o̱ u̱ war-u so̱-o̱ ne̱. <verse eid="GEN 29:17"/><verse number="18" style="v" sid="GEN 29:18"/>Yakubu o̱ u̱t-cwan e̱ Rahira, wa waru̱ u̱so wa, u̱zu̱, &lt;&lt;Abite̱ bo̱ ya'u̱ me̱ Rahira, gwu̱p-u̱ re̱k-wa ró wa shu̱'u̱t ne̱ta ri, me̱ no̱m-u̱ bo̱ m-to̱k u̱s-hak u̱s-ta'er.&gt;&gt;<verse eid="GEN 29:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19"/>Raban zu̱, &lt;&lt;U̱m eeste̱, u̱m yasu̱ bo̱ Rahira du̱ u̱m ya'aste̱ waku̱n Rahira. Bo̱ shu̱'u̱t u̱ ane̱ u̱ me̱ ne̱.&gt;&gt; <verse eid="GEN 29:19"/><verse number="20" style="v" sid="GEN 29:20"/>Yakubu nom go̱ro̱m u̱s-hak u̱s-ta'er remu̱ wa gu̱u̱t Rahira. Se̱di hak-u̱s se̱ wa hyen se̱ cashi remu̱ cwan-tu̱ wa o̱tte̱ Rahira.<verse eid="GEN 29:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21"/>Se̱ Yakubu zu̱ Raban, &lt;&lt;Ya me̱ ne̱ta ri, remu̱ zu̱ hak-su̱ go̱rmu̱ ri taag, u̱m o̱ u̱ssa u̱m ga Rahira u̱ da-o̱.&gt;&gt;<verse eid="GEN 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 29:22"/>Raban kargu̱sse̱ a-u̱s-bo̱r-u̱ wa ne̱, wa bu̱n mo̱ro̱g-du̱ gag-du̱ u̱r-gu̱ du̱ re̱-du̱ no̱m u̱t-re̱. <verse eid="GEN 29:22"/><verse number="23" style="v" sid="GEN 29:23"/>Se̱di da-u̱ gyu̱p-mu̱ no̱me̱ Raban ku̱b Riya wa hu̱u̱tu̱ Yakubu, wa roog u̱ wa ne̱. <verse eid="GEN 29:23"/><verse number="24" style="v" sid="GEN 29:24"/>(Raban yase̱ gwu̱p-u̱ wa-m-to̱k-u̱ wa Zirpa u̱du̱ gwu̱p-u̱ wa Riya wa shu̱'u̱t wa-m-to̱k-u̱ wa.)<verse eid="GEN 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 29:25"/>Se̱di da-u̱ Yakubu yu̱ne̱ u̱r-wu̱n se̱ wa hyen Riya! Wa zu̱ Raban, &lt;&lt;¿Yan-o̱ bo̱ no̱mu̱ me̱ inya? ¿U̱m no̱ng m-to̱k u̱ remu̱ Rahira, ko̱ iya o̱ da? ¿Rem-u yan-o̱ bo̱ no̱m-tu̱ me̱ u̱s-bi?&gt;&gt;<verse eid="GEN 29:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26"/>Raban zu̱, &lt;&lt;U̱r-ma it ho̱n-ho̱n o̱ da, u̱ du̱-dim-u̱ gwu̱p wa ba yu̱-wu̱ya m-ha u̱r-gu̱ da. <verse eid="GEN 29:26"/><verse number="27" style="v" sid="GEN 29:27"/>Yage̱ ho̱-tu̱ u̱t-ta'er tu̱ po-mu̱ u̱r-gu̱ u̱ aru̱k, it do̱'e̱ ya'u̱ bo̱ Rahira tu̱msu̱, se̱di se̱ bo̱ swu̱ru̱g m-no̱m u̱s-hak u̱s-ta'er su̱ go̱ro̱m.&gt;&gt;<verse eid="GEN 29:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28"/>Yakubu ees wa sur se̱ku̱n hak-se̱ u̱s-ta'er. Da-u̱ roog-mu̱ u̱t-ta'er mu̱ e̱ nomte̱ u̱r-gu̱ e̱ Riya arke̱, Raban yasu̱ wu̱n Rahira tu̱msu̱. <verse eid="GEN 29:28"/><verse number="29" style="v" sid="GEN 29:29"/>(Raban yase̱ gwu̱p-u̱ wa-m-to̱k-u̱ wa Biru̱ha u̱du̱ gwu̱p-u̱ wa Rahira wa shu̱'u̱t wa-m-to̱k-u̱ wa.) <verse eid="GEN 29:29"/><verse number="30" style="v" sid="GEN 29:30"/>Yakubu roog tu̱msu̱ u̱ Rahira ne̱. Wa cwanu̱g Rahira m-ze̱g Riya. Se̱di wa sur m-no̱mu̱ Raban m-to̱k u̱s-hak u̱s-ta'er.<verse eid="GEN 29:30"/></para>
  <para style="s1">Yaag-u̱ Yakubu mate̱</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31"/>Da-u̱ Yawe hyane̱ Yakubu cwanu̱g Rahira m-ze̱g Riya, se̱ wa yu̱' wa mat-du̱ yaag, se̱di Rahira kwu̱ng u̱r-mat da. <verse eid="GEN 29:31"/><verse number="32" style="v" sid="GEN 29:32"/>Se̱ Riya no̱m u̱t-me̱n wa mu̱t ya-du̱ u̱r-campa. Se̱ wa te̱'e̱ wa u̱r-dim Rube̱n, no̱mu̱ na zu̱ye̱ dim-u̱r re̱ u̱ rem-du̱ u̱t-Ibra-ne̱, gwat, u̱r-ya. Riya zu̱u̱g, &lt;&lt;Remu̱ u̱zu̱ Yawe gwak-u̱t swadu̱ u̱r-ko̱b-u̱ ri. Za u-sakna campa ri u̱t-cwan me̱ u̱ da-o̱.&gt;&gt;<verse eid="GEN 29:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 29:33"/>Wa sur m-no̱m u̱t-me̱n tu̱msu̱ wa kum de̱ku̱n ya-du̱ u̱r-campa de̱, wa te̱'e̱ wa u̱r-dim Simiyo̱n, u̱ka na fogte̱ dim-u̱r re̱ na zu̱, &lt;&lt;Yawe hokos.&gt;&gt; Se̱ wa zu̱, &lt;&lt;Yawe ho̱k u̱zu̱ na cwanu̱g me̱ sok da se̱ wa sur m-ya me̱ de̱ku̱n ya-du̱ u̱r-campa de̱.&gt;&gt;<verse eid="GEN 29:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 29:34"/>Se̱ wa sur m-no̱m u̱t-me̱n, da-u̱ wa mate̱ ya-du̱ u̱r-campa, wa zu̱, &lt;&lt;U̱ da-o̱ u̱m nak u̱zu̱ campa ri u̱ dapu̱rse̱ me̱, remu̱ u̱m maktu̱ wa ya'ag-u̱ campa-ne̱ tu̱t.&gt;&gt; Se̱ wa te̱'e̱ wa u̱r-dim Re̱wi u̱ka na fogte̱ dim-u̱r re̱ u̱ rem-du̱ u̱t-Ibra-ne̱ na zu̱, &lt;&lt;u̱t-same̱ u̱r-be u̱r-gan.&gt;&gt;<verse eid="GEN 29:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 29:35"/>Tu̱msu̱ Riya sur m-no̱m me̱n-tu̱ ub wa mu̱t de̱ku̱n ya-du̱ u̱r-campa de̱. Wa wa'-u̱ wa u̱r-dim Yahuda, haka na fu̱kte̱ dim-u̱r re na zu̱ de̱ &lt;&lt;U̱t-vam.&gt;&gt; Wu̱n zu̱, &lt;&lt;U̱ da-o̱ me̱ no̱me̱ Yawe u̱t-vam.&gt;&gt; Se̱ Riya te̱'e̱ wu̱n u̱r-dim Yahuda. Se̱ Riya yage̱ mat-du̱ yaag.<verse eid="GEN 29:35"/></para>
  <chapter eid="GEN 29"/>
  <chapter number="30" style="c" sid="GEN 30"/>
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1"/>Da-u̱ Rahira hyane̱ wa maktu̱ Yakubu ya'ag da, wa hu̱ shu̱b-du̱ yu̱-wu̱ya wa. Wa kon Yakubu wa zu̱, &lt;&lt;Ya me̱ yaag ko̱ u̱m mar!&gt;&gt;<verse eid="GEN 30:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2"/>Yakubu ho̱g u̱s-ryab, wa zu̱ Rahira, &lt;&lt;¿Me̱ wa u-Ru̱, wu̱ hose̱ bo̱ u̱r-mat-du̱ yaag?&gt;&gt;<verse eid="GEN 30:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3"/>Rahira zu̱, &lt;&lt;Kab Biru̱ha to̱k-u̱ ri, no̱ wa ne̱ roog ko̱ wa matu̱ me̱ yaag ko̱me̱ u̱t-kwu̱m yaag du̱gu̱-du̱ wa.&gt;&gt;<verse eid="GEN 30:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 30:4"/>Se̱ wa yasu̱ wa Biru̱ha to̱k-u̱ wa u̱ wa shu̱'u̱t ne̱ta wa, Yakubu roog u̱ wa ne̱. <verse eid="GEN 30:4"/><verse number="5" style="v" sid="GEN 30:5"/>Biru̱ha nom me̱n-tu̱ ub wa matu̱ Yakubu ya-du̱ u̱r-campa. <verse eid="GEN 30:5"/><verse number="6" style="v" sid="GEN 30:6"/>Rahira zu̱, &lt;&lt;Ru̱-u̱ no̱ngu̱ me̱ kwu̱p-du̱ u̱s-rem su̱ so̱-se̱ wa ho̱k kan-u̱s ri wa ye me̱ u̱r-ya du̱ u̱r-campa.&gt;&gt; Se̱ wa te̱'e̱ wa u̱r-dim Dan, no̱m-u̱ na zu̱ye̱ dim-u̱r re̱ u̱ rem-du̱ u̱t-Ibra-ne̱ na zu̱ &lt;&lt;kwu̱p-du̱ u̱s-rem ho̱n-ho̱n.&gt;&gt;<verse eid="GEN 30:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 30:7"/>Rahira to̱k-u̱ Biru̱ha nom u̱t-me̱n u-yu̱ru̱mse̱ wa matu̱ Yakubu ya-du̱ u̱r-campa. <verse eid="GEN 30:7"/><verse number="8" style="v" sid="GEN 30:8"/>Se̱ Rahira zu̱, &lt;&lt;U̱m no̱ng u̱t-noos so̱k u̱ yu̱-wu̱ya ri ne̱, u̱m re̱e̱g m-gag.&gt;&gt; Se̱ wa te̱'e̱ ya-u̱r re̱ u̱r-dim Napari u̱ka na fogte̱ dim-u̱r re u̱ rem-du̱ u̱t-Ibra-ne̱ na zu̱ &lt;&lt;u̱t-noos.&gt;&gt;<verse eid="GEN 30:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9"/>Da-u̱ Riya hyane̱ wa yakke̱ u̱r-mat, wa ku̱b to̱k-u̱ wa Zirpa, wa yasu̱ Yakubu wa shu̱'u̱t ne̱ta wa. <verse eid="GEN 30:9"/><verse number="10" style="v" sid="GEN 30:10"/>Riya to̱k-u̱ Zirpa matu̱ Yakubu ya-du̱ u̱r-campa. <verse eid="GEN 30:10"/><verse number="11" style="v" sid="GEN 30:11"/>Se̱ Riya te̱'e̱ wa u̱r-dim Gad, dim-u̱r re̱ na zu̱ye̱ &lt;&lt;Re̱ u̱r-ko̱rro̱,&gt;&gt; remu̱ zu̱ wa zu̱u̱g, &lt;&lt;U̱m re̱e̱g u̱r-ko̱rro̱!&gt;&gt;<verse eid="GEN 30:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 30:12"/>Riya to̱k-u̱ Zirpa matu̱ Yakubu ya-du̱ u̱r-campa du̱ u-yu̱ru̱mse̱. <verse eid="GEN 30:12"/><verse number="13" style="v" sid="GEN 30:13"/>Se̱ Riya zu̱, &lt;&lt;Me̱ wa u̱r-so̱ wa m-o̱ge̱, ne̱ta-ne̱ do̱'e̱ fag-du̱ me̱ u̱r-so̱.&gt;&gt; Wa te̱'e̱ wa u̱r-dim Ashu̱r, no̱mu̱ na zu̱ye̱ Ashu̱r &lt;&lt;U̱r-so̱.&gt;&gt;<verse eid="GEN 30:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14"/>Da-u̱ gos-mu̱ fat no̱me̱, se̱ Rube̱n to u̱r-do̱g wa kwu̱mu̱n u̱s-baat su̱ kab-du̱ u̱t-me̱n su̱ cwu̱u̱ne̱ wa ge̱tu̱n se̱ wa mu̱tu̱n ino-u wa Riya. Se̱ Rahira ko̱n Riya wa zu̱, &lt;&lt;Gag jab, ya me̱ baat-su̱ kab-du̱ u̱t-me̱n su̱ zwaru̱ ró getnu̱ bo̱.&gt;&gt;<verse eid="GEN 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15"/>Se̱di Riya zu̱ wu̱n, &lt;&lt;¿No̱m-u̱ bo̱ no̱mu̱ me̱ u-be̱e̱t u̱ bo̱ o̱nkte̱ me̱ campa o̱ ko̱rge̱ bo̱ da? ¿U̱ da-o̱ tu̱msu̱ bo̱ u̱t-sa bo̱ o̱nk baat-su̱ zwaru̱ ri mu̱tu̱n me̱ tu̱msu̱?&gt;&gt;</para>
  <para style="p" vid="GEN 30:15">Rahira zu̱, &lt;&lt;U̱ gyu̱p-mu̱ ya-o̱ me̱ zu̱ campa ri u̱ roog u̱ bo̱ ne̱ abite̱ u̱zu̱ bo̱ ya me̱ baat-su̱ kab-du̱ u̱t-me̱n su̱ zwaru̱ ró saannu̱ bo̱.&gt;&gt;<verse eid="GEN 30:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16"/>U̱ ho̱-u̱r re̱ m-rim, da-u̱ Yakubu o̱o̱ge̱ mu̱u̱n du̱gu̱ u-tak, se̱ Riya do̱'e̱ wa bit wa. Riya zu̱ Yakubu, &lt;&lt;Se̱ bo̱ roogte̱ me̱ ne̱ u̱ ya-o̱ m-gyu̱p, u̱m ooste̱ bo̱ u̱ baat-su̱ kab-du̱ u̱t-me̱n su̱ zwaru̱ ri sanu̱ me̱.&gt;&gt; Se̱ u̱ gyu̱p-m mo̱ wa roog u̱ Riya ne̱.<verse eid="GEN 30:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17"/>Ru̱-u̱ o̱nk to̱o̱g-u̱s Riya, wa no̱m me̱n-tu̱ ub. Wa matu̱ Yakubu ya-du̱ u̱r-campa du̱ u̱r-tanu̱rse̱. <verse eid="GEN 30:17"/><verse number="18" style="v" sid="GEN 30:18"/>Se̱ Riya zu̱, &lt;&lt;Ru̱-u̱ yaag me̱ o̱g-u̱r so̱-de̱ remu̱ u̱m ya'aste̱ campa ri gwu̱p m-to̱k-u̱ ri.&gt;&gt; Se̱ wa te̱'e̱ wa u̱r-dim Issakar, no̱m-u̱ na fu̱ge̱ dim-u̱r re̱ u̱ rem-du̱ u̱t-Ibra-ne̱ &lt;&lt;u-to̱p.&gt;&gt;<verse eid="GEN 30:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 30:19"/>Riya sur m-no̱m me̱n-tu̱ ub wa matu̱ Yakubu ya-du̱ u̱r-campa du̱ u-shishin. <verse eid="GEN 30:19"/><verse number="20" style="v" sid="GEN 30:20"/>Riya zu̱, &lt;&lt;Ru̱-u̱ no̱ngu̱ me̱ nya-u so̱-o̱, uno̱ da-o̱ campa ri ya'u̱ me̱ m-ze̱g, remu̱ zu̱ u̱m maktu̱ wa ya'ag-u̱ campa-ne̱ shishin.&gt;&gt; Wa te̱'e̱ wa u̱r-dim Ze̱burun. No̱m-u̱ na zu̱ Ze̱be̱run o̱ &lt;&lt;m-ze̱g.&gt;&gt;<verse eid="GEN 30:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 30:21"/>Da-u̱ wa sure̱ m-mat ya-du̱ u̱r-gwu̱p wa te̱'e̱ de̱ u̱r-dim Dinatu.<verse eid="GEN 30:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22"/>Se̱ Ru̱-u̱ baku̱s u̱ Rahira ne̱, wa e̱r ko̱n-u̱s wa se̱ wa yu̱ wa u̱r-mat. <verse eid="GEN 30:22"/><verse number="23" style="v" sid="GEN 30:23"/>Wa no̱m u̱t-me̱n wa mu̱t ya-du̱ u̱r-campa. Wa zu̱, &lt;&lt;Ru̱-u̱ haste̱ me̱ m-'e̱.&gt;&gt; <verse eid="GEN 30:23"/><verse number="24" style="v" sid="GEN 30:24"/>Se̱ Rahira te̱'e̱ wa u̱r-dim Yusuhu, no̱m-u̱ na zu̱ dim-u̱r re̱ m-swu̱r, remu̱ zu̱ wu̱n zu̱u̱g, &lt;&lt;Yawe swu̱ru̱ wu̱n de̱ku̱n ya-de̱ bu-u ri.&gt;&gt;<verse eid="GEN 30:24"/></para>
  <para style="s1">No̱m u̱t-kom-u̱ <optbreak/> Yakubu swu̱ru̱g</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25"/>Da-u̱ Rahira mate̱ Yusuhu, Yakubu zu̱ Raban, &lt;&lt;U̱m o̱ u̱ssa bo̱ yagu̱ iya u̱m u̱t-sa u̱m mu u̱ dak-u ri iya. <verse eid="GEN 30:25"/><verse number="26" style="v" sid="GEN 30:26"/>Ya me̱ ya'ag-u̱ ri u̱ ne̱ta-u̱t ri ne̱, i u̱m no̱m-tu̱ bo̱ m-to̱k, u̱m u̱t-sa u̱m mu, bo̱ nak tat-u̱ m-ank mu̱ u̱m no̱m-u̱ bo̱.&gt;&gt;<verse eid="GEN 30:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27"/>Raban zu̱ wu̱n, &lt;&lt;A u̱m kume̱ hyu̱-m pusmo̱ u̱du̱ ró, gag jab e̱r me̱, u̱m shu̱'u̱te̱ wa no̱m u̱t-kom so̱k, u̱m nak du̱gu̱ u-gwat u̱zu̱ Yawe wa'agu̱ me̱ kom-u so̱-o̱ u̱ rem-u ró. <verse eid="GEN 30:27"/><verse number="28" style="v" sid="GEN 30:28"/>Waru̱ me̱ no̱m-u̱ bo̱ doru̱ me̱, me̱ to̱p-u̱ bo̱.&gt;&gt;<verse eid="GEN 30:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29"/>Yakubu zu̱ wu̱n, &lt;&lt;Bo̱ nak u̱zu̱ u̱m nong-u̱ bo̱ m-to̱k, bo̱ nak u̱ka bisa-u̱t ró surte̱ u̱ kom-u̱t ri. <verse eid="GEN 30:29"/><verse number="30" style="v" sid="GEN 30:30"/>Bisa-u̱t ró o̱o̱g cashi kanda u̱m haan, se̱di no̱m u̱t-kom-u̱ ró swu̱ru̱g u-tát sok. Yawe wa'agu̱ bo̱ kom-u so̱-o̱ u̱ ko̱-uyan u̱m no̱me̱ u-be̱e̱t. ¿Se̱di u̱ da-o̱, re̱ne̱ o̱ me̱? ¿Mu̱ne̱ o̱ u̱m do̱'e̱ he̱e̱se̱ cu̱n-du̱ o̱kon remu̱ ya'ag-u̱ ri?&gt;&gt;<verse eid="GEN 30:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31"/>Raban shit Yakubu, &lt;&lt;¿Yan-o̱ u̱m do̱'e̱ ya-du̱ bo̱?&gt;&gt;</para>
  <para style="p" vid="GEN 30:31">Yakubu shu̱s wa zu̱, &lt;&lt;A-bo̱ ya me̱ o̱ko̱n no̱m-o̱ da. Se̱di abite̱ u̱zu̱ bo̱ no̱m-u̱ me̱ u-no̱m u-gan, me̱ u̱t-re̱ u-shu̱ u̱ gwat-du̱ ban-tu̱ ca ró: <verse eid="GEN 30:31"/><verse number="32" style="v" sid="GEN 30:32"/>Yage̱ u̱m cwa ban-tu̱ u̱t-bisa ró u̱ ya-o̱, u̱m hast ca u̱ gwaar ne̱ i o̱tte̱ daku̱r-u̱t rim-to̱, u̱ same̱ u̱ ya-tu̱ kag-u̱ ca ne̱ tu̱ o̱o̱ge̱ rim-to̱ u̱t-be̱e̱t. Bo̱ ya me̱ to̱ u̱t-be̱e̱t e̱ shu̱'u̱t o̱g-du̱ m-ank-u̱ ri. <verse eid="GEN 30:32"/><verse number="33" style="v" sid="GEN 30:33"/>U̱ ane̱ u-shu̱, a-bo̱ gwate̱ bisa-tu̱ bo̱ ya'u̱ me̱ to̱ shu̱'u̱t o̱g-u̱r ri, bo̱ u̱t-kere̱ u̱t-nap u̱zu̱ me̱ wa-u̱t-nip wa. Abite̱ u̱zu̱ bo̱ hyanu̱g gwaar i zatte̱ u̱t-daku̱r da ko̱ kag-u̱ ca i za rim-e̱ da, bo̱ nak u̱zu̱ hiw-to̱ u̱m hiwe̱ du̱gu̱-du̱ ró.&gt;&gt;<verse eid="GEN 30:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34"/>Raban zu̱, &lt;&lt;Yage̱ u̱ shu̱'u̱t u̱ka bo̱ zu̱tte̱.&gt;&gt; <verse eid="GEN 30:34"/><verse number="35" style="v" sid="GEN 30:35"/>U̱ gandi ho̱-u̱r re̱ Raban hast gob-u̱ gwaar e̱ o̱tte̱ u̱s-ker u̱t-daku̱r ne̱, u̱ so-u̱ gwaar ne̱ be̱e̱t i o̱tte̱ u̱t-daku̱r ko̱ daku̱r-u̱t pus-to̱ ne̱, u̱ kag-u̱ ca rim-e̱ ne̱ be̱e̱t, wa yasu̱ ya'ag-u̱ wa e̱ ha u̱t-gwat. <verse eid="GEN 30:35"/><verse number="36" style="v" sid="GEN 30:36"/>Se̱ Raban ku̱b u̱t-bisa wa no̱m ha-mu̱ m-roog u̱t-tu̱t, rem u̱zu̱ wa o̱ u̱ssa wa no̱m m-ra u̱ Yakubu ne̱, Yakubu re̱ u-shu̱ u̱ gwat-du̱ ban-du̱ u̱t-bisa Raban tu̱ kuse̱.<verse eid="GEN 30:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37"/>Se̱ Yakubu ge̱tu̱n fe̱-su̱ tesu̱ po̱pra u̱ te-yu̱ armo̱m ne̱ u̱ te̱-yu̱ pe̱re̱n ne̱, wa nyu̱u̱k kwu̱k-tu̱ do̱m, wa yage̱ me̱r-du̱ u-te u̱ pus-de̱. <verse eid="GEN 30:37"/><verse number="38" style="v" sid="GEN 30:38"/>Wa ku̱b fe̱-su̱ u̱s-te̱ se̱ wa guns be-du̱ ban-du̱ bisa-u̱t sote̱ m-bu̱, remu̱ zu̱ ku̱na e̱ nom-tu̱ u̱s-naar da-u̱ e̱ haane̱ u̱ swadu̱ m-bu̱. <verse eid="GEN 30:38"/><verse number="39" style="v" sid="GEN 30:39"/>Da-u̱ e̱ no̱me̱ u̱s-naar u-shu̱ fe̱-su̱ u̱s-te̱ su̱ pusse̱ se̱, e̱ mu̱t yaag i o̱tte̱ u̱s-ke̱r u̱t-daku̱r ne̱ u̱ war-u̱t e̱. <verse eid="GEN 30:39"/><verse number="40" style="v" sid="GEN 30:40"/>Yakubu hast kag-u̱ ca e̱ du̱gu̱ ban-du̱ ca Raban, da-u̱ e̱ o̱ u̱s-naar se̱ wa muut e̱ m-gwat bisa-u̱t Raban tu̱ o̱o̱ge̱ u̱ daku̱r-u̱t rim-to̱ ne̱. Iya-o̱ wa nomte̱ u̱t-bisa wa reet u-shu̱, wa ku̱ngu̱sse̱ bisa-u̱t wa du̱gu̱-du̱ bisa-u̱t Raban. <verse eid="GEN 30:40"/><verse number="41" style="v" sid="GEN 30:41"/>Da-u̱ bisa-tu̱ zege̱ m-yar o̱ u̱s-naar, se̱ Yakubu ru̱st fe̱-su̱ te-u̱s se̱ su̱ wa ku̱na u̱-shu̱ ban-du̱ bisa-u̱t to̱. Remu̱ e̱ no̱m-u̱t u̱s-naar u̱-shu̱ fe̱-su̱ te-u̱s se̱. <verse eid="GEN 30:41"/><verse number="42" style="v" sid="GEN 30:42"/>Se̱di wa no̱m-u̱t iya u̱ i o̱o̱ge̱ za m-yar da. Ban-du̱ u̱t-bisa tu̱ zatte̱ u̱r-be̱b so̱k da e̱ muus u̱du̱ Raban, i o̱o̱ge̱ u̱r-be̱b e̱ muus u̱du̱ Yakubu. <verse eid="GEN 30:42"/><verse number="43" style="v" sid="GEN 30:43"/>Iya-o̱ hen, Yakubu kumte̱ re̱-u̱ u-shu̱ so̱k, wa kum ban-du̱ u̱t-bisa u̱ gwaar ne̱ u-tát, u̱ to̱k-ne̱ campa-ne̱ u̱ to̱k-ne̱ ne̱ta-ne̱, u̱ rakum ne̱ u̱ janka ne̱.<verse eid="GEN 30:43"/></para>
  <chapter eid="GEN 30"/>
  <chapter number="31" style="c" sid="GEN 31"/>
  <para style="s1">Yakubu so̱mo̱g <optbreak/> du̱gu̱-du̱ Raban</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1"/>Yakubu ho̱k ya'ag-u̱ campa-ne̱ Raban u̱s-rem u̱zu̱, &lt;&lt;Yakubu kooste̱ no̱mu̱ u̱so-u in o̱tte̱ u-be̱e̱t tu̱msu̱ wa kwu̱mu̱g no̱m u̱t-kom uno̱ u-be̱e̱t du̱gu̱ no̱m-tu̱ o̱o̱ge̱ tu̱ uso-u in.&gt;&gt; <verse eid="GEN 31:1"/><verse number="2" style="v" sid="GEN 31:2"/>Yakubu hyen u̱zu̱ jab-u̱ Raban zamu̱n u̱ wa ne̱ u̱ka o̱tte̱ da.<verse eid="GEN 31:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 31:3"/>Se̱ Yawe zu̱ Yakubu, &lt;&lt;Barme̱ m-mu̱ u̱ dak-u̱ u̱so-u ró u̱ bu-u wa ne̱, me̱ u̱t-no̱m u̱r-kot u̱ bo̱ ne̱.&gt;&gt;<verse eid="GEN 31:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4"/>Se̱ Yakubu fog Riya e̱ Rahira e̱ haan u̱r-do̱g u̱ be-du̱ wa o̱tte̱ u̱ gwat-du̱ ban-du̱ bisa-u̱t wa. <verse eid="GEN 31:4"/><verse number="5" style="v" sid="GEN 31:5"/>Wa zu̱ e̱, &lt;&lt;U̱m hyanu̱g jab-u̱ u̱so-u no̱ o̱ zamu̱n u̱ka it u̱ wa ne̱ o̱tte̱ da, se̱di Ru̱-u̱ u̱so-u ri o̱ u̱r-kot u̱-me̱ ne̱. <verse eid="GEN 31:5"/><verse number="6" style="v" sid="GEN 31:6"/>No̱ nak u̱ka u̱m nomte̱ u̱so-u no̱ m-to̱k u̱ be̱b-du̱ war-u̱ ri ne̱ u̱r-be̱e̱t. <verse eid="GEN 31:6"/><verse number="7" style="v" sid="GEN 31:7"/>Se̱di wa no̱ngu̱ me̱ no̱m-u yo̱-o̱, wa swaske̱ o̱g-u̱r ri u̱so u-o̱p. Se̱di Ru̱-u̱ yaag wu̱n fu̱n-yu̱ wa do̱te̱ u̱ ho̱n-su̱ me̱ da. <verse eid="GEN 31:7"/><verse number="8" style="v" sid="GEN 31:8"/>A wa zu̱ye̱, &lt;Gwaar i u̱t-kaap e̱ o̱o̱ge̱ i ri,&gt; se̱ gwaar be̱e̱t e̱ ha mat-du̱ yaag u̱t-kaap ne̱. Tu̱msu̱ a wa swase̱ jab-u̱ wa u̱zu̱, &lt;Gwaar i u̱s-ker u̱s-ker e̱ o̱o̱ge̱ o̱g-u̱r rò,&gt; se̱ ban-du̱ gwaar be̱e̱t e̱ ha mat-du̱ yaag u̱s-ker u̱s-ker. <verse eid="GEN 31:8"/><verse number="9" style="v" sid="GEN 31:9"/>Iya o Ru̱-u̱ nomte̱, wa ku̱b bisa-tu̱ u̱so-u no̱, wa yasu̱ me̱.<verse eid="GEN 31:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10"/>&lt;&lt;Da-u̱ kab-du̱ u̱t-me̱n u̱ ban-du̱ u̱t-bisa no̱me̱, u̱m no̱mu̱g bo'. U̱m hyen gob-u̱ gwaar e̱ o̱ u̱s-naar u̱ so̱-yu̱ u-gwaar ne̱ e̱ o̱ u̱s-ker u̱s-ker, ko̱ u̱t-daku̱r, ko̱ u̱t-kaap ne̱. <verse eid="GEN 31:10"/><verse number="11" style="v" sid="GEN 31:11"/>Se̱ bo' u̱m no̱me̱, Wa-to̱m u-Ru̱ zu̱ me̱, &lt;Yakubu!&gt; se̱ u̱m zu̱ wa &lt;Me̱ ya.&gt; <verse eid="GEN 31:11"/><verse number="12" style="v" sid="GEN 31:12"/>Wa-to̱m-u-Ru̱ zu̱ me̱, &lt;Gwat, bo̱ hyan gob-u̱ gwaar i o̱o̱ge̱ u̱s-naar ban-du̱ u̱t-bisa i o̱ u̱s-ker u̱s-ker, ko̱ u̱t-daku̱r, ko̱ u̱t-kaap ne̱, remu̱ zu̱ u̱m hyanu̱g no̱m-u̱ Raban o̱o̱ge̱ no̱m-u̱ bo̱ u-be̱e̱t. <verse eid="GEN 31:12"/><verse number="13" style="v" sid="GEN 31:13"/>Me̱ o̱o̱ge̱ u-Ru̱ u̱ Be̱te̱r, be-du̱ na watu̱ bo̱ yu̱nu̱ste̱ u̱t-ta'ar m-kim u̱ka ta'ar-du̱ u̱t-hu̱ktin tu̱msu̱ be-du̱ bo̱ nomte̱ u̱s-to̱nd u̱-me̱ ne̱. U̱ da-o̱ yage̱ dak-u uno̱ za naas u-da bo̱ mu u̱ dak-u̱ u̱r-mat-u̱ ró.&gt; &gt;&gt;<verse eid="GEN 31:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14"/>Rahira e̱ Riya e̱ shu̱s, e̱ zu̱, &lt;&lt;No̱ng it u̱r-zwar sok, it zamu̱n u̱ re̱-du̱ no̱m-tu̱ u̱t-kom tu̱ u̱so-u it. <verse eid="GEN 31:14"/><verse number="15" style="v" sid="GEN 31:15"/>Wa muute̱ it u̱ka ham-u̱t ne̱. Wa babu̱g it, tu̱msu̱ wa ho̱ru̱sse̱ shik-u̱ bo̱ to̱pe̱ remu̱ it be̱e̱t. <verse eid="GEN 31:15"/><verse number="16" style="v" sid="GEN 31:16"/>No̱m-u̱ u̱t-kom u̱ Ru̱-u̱ ya bo̱ du̱gu̱-du̱ u̱so-u it, o̱g-u̱r it de̱ u̱ ya'ag-u̱ it ne̱, u̱ remu̱ iya no̱mo̱n no̱m-u̱ Ru̱-u̱ zu̱ bo̱ no̱m.&gt;&gt;<verse eid="GEN 31:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17"/>Se̱ Yakubu su̱k ne̱ta-u̱t wa u̱ ya'ag-u̱ wa ne̱ u̱-do̱m rakum. <verse eid="GEN 31:17"/><verse number="18" style="v" sid="GEN 31:18"/>Se̱ wa yu̱n bisa-u̱t wa u̱t-be̱e̱t u̱ shu̱ wa, wa kargu̱sse̱ u̱ no̱m-tu̱ wa kume̱ ne̱ u̱t-be̱e̱t u̱ Padan-aram se̱ wa aru̱k m-mu̱ u̱ dak-u̱ Kan'ana, u̱ Gas-u̱ u̱so-u wa Ishaku o̱tte̱ u̱ shu̱'u̱t.<verse eid="GEN 31:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 31:19"/>Kanda Yakubu u̱ ne̱ta-u̱t wa, u̱ ya'ag-u̱ wa ne̱ aru̱k, Raban o̱ m-ra remu̱ wa or-u̱t can-tu̱ ca. Rahira hiwis ru̱-tu̱ u-bu tu̱ na maye̱ tu̱ e'-du̱ bu-u tu̱ o̱o̱ge̱ tu̱ Raban. Tu̱msu̱ wa aru̱k u̱ to̱ ne̱. <verse eid="GEN 31:19"/><verse number="20" style="v" sid="GEN 31:20"/>Yakubu e̱ngu̱sse̱ ve̱r-u̱s Raban ne̱t-u̱ Aram, u̱ wa gu̱gu̱mte̱ waru̱ wa u̱zu̱ wa do̱'e̱ u̱ aru̱k. <verse eid="GEN 31:20"/><verse number="21" style="v" sid="GEN 31:21"/>Yakubu aru̱k u̱ no̱m-tu̱ wa o̱tte̱ ne̱ u̱t-be̱e̱t. Wa pu̱s gi-yu̱ Yufiretis, wa aru̱k m-da u̱-do̱mu̱ ro̱r-tu̱ dak-u̱ Giriyad.<verse eid="GEN 31:21"/></para>
  <para style="s1">Raban do̱ro̱g Yakubu</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22"/>Da-u̱ rooge̱ u̱t-tu̱t, na waru̱ Raban u̱zu̱ Yakubu so̱mo̱g. <verse eid="GEN 31:22"/><verse number="23" style="v" sid="GEN 31:23"/>Se̱ wa kargu̱sse̱ ne̱t-tu̱ bu-u wa u̱t-be̱e̱t u̱r-ko̱t u̱ wa ne̱ e̱ aru̱k m-so̱m m-do̱r Yakubu m-roog u̱t-ta'er. Wa o̱ do̱rru̱ dim-u̱ wa u̱t-mo̱r u̱ wa ne̱ m-te̱ ro̱r-tu̱ dak-u̱ Giriyad. <verse eid="GEN 31:23"/><verse number="24" style="v" sid="GEN 31:24"/>Se̱ Ru̱-u̱ haan u̱du̱ Raban ne̱t-u̱ Aram u̱ bo' m-gyu̱p da-u̱ wa o̱o̱ge̱ m-roog, wa zu̱ wa, &lt;&lt;A-bo̱ o̱ jaru̱n bo̱ zu̱ Yakubu o̱ko̱n no̱m-o̱ da, ko̱ u̱ so̱-o̱ ko̱ u̱ yo̱-o̱ da.&gt;&gt;<verse eid="GEN 31:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 31:25"/>Raban bit wu̱n da-u̱ is gase̱ u̱ be-du̱ wa nomte̱ u̱r-rimpa u̱ do̱m-u̱ ro̱r-du̱ dak-u̱ Giriyad, Raban u̱ ne̱t-u̱t wa ne̱ e̱ nom du̱ e̱ rimpa-de̱ u̱t-mo̱r u̱ Yakubu ne̱.<verse eid="GEN 31:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 31:26"/>Raban zu̱ Yakubu, &lt;&lt;¿Yan-o̱ bo̱ no̱mu̱ me̱ iya? Bo̱ e̱ngu̱sse̱ me̱ u̱s-ve̱r, tu̱msu̱ bo̱ ku̱b ya-u̱t-gwu̱p-u̱ ri m-no̱k sha-mu̱ to̱k-ne̱ i m-gag. <verse eid="GEN 31:26"/><verse number="27" style="v" sid="GEN 31:27"/>¿Rem-u yan-o̱ bo̱ somte̱ m-yasa bo̱ e̱ngu̱sse̱ me̱ u̱s-ve̱r? ¿Remu̱ yan-o̱ bo̱ gu̱gu̱mte̱ waru̱ me̱, se̱ u̱m yage̱ bo̱ aru̱k m-yar u̱-te̱k u̱r-so̱, u̱t-se̱p ne̱, u̱ go̱ngu tu̱ u̱r-so̱ ne̱, u̱s-mo̱ro̱ ne̱? <verse eid="GEN 31:27"/><verse number="28" style="v" sid="GEN 31:28"/>¿Yan-o̱ hose̱ bo̱ yage̱ u̱m ham-u̱t ya-u̱t-gwu̱p-u̱ ri u̱ ya'ag-u̱ ya'ag-u̱ ri ne̱ u̱m waru̱ e̱ u̱zu̱ se̱ u̱r-ho̱? Bo̱ no̱mu̱g no̱m-tu̱ m-rag. <verse eid="GEN 31:28"/><verse number="29" style="v" sid="GEN 31:29"/>U̱m o̱ u̱r-be̱b ne̱, du̱ u̱m do̱te̱ u̱ ho̱n-su̱ bo̱, se̱di gyu̱p-ne̱ m-gyu̱p Ru̱-u̱ u̱so-u ró hyu̱mu̱g me̱ u̱zu̱, a u̱m o̱ jaru̱n u̱m zu̱ bo̱ o̱ko̱n, ko̱ u̱ so̱-o̱ ko̱ u̱ yo̱-o̱ da. <verse eid="GEN 31:29"/><verse number="30" style="v" sid="GEN 31:30"/>U̱ da-o̱ bo̱ aru̱kte̱ remu̱ zu̱ bo̱ e̱ku̱ste̱ m-tumb ne̱ u̱zu̱ bo̱ mu u̱ bu-u̱ u̱so ró. ¿Se̱di remu̱ yan-o̱ wa-e̱ bo̱ hiwiste̱ me̱ u̱t-ru̱?&gt;&gt;<verse eid="GEN 31:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31"/>Yakubu shu̱s, wa zu̱ Raban, &lt;&lt;U̱m o̱ ho̱g-du̱ u-gye̱r, u̱m kabu̱g u̱ jab-u̱ ri u̱zu̱ bo̱ kab ya-u̱t-gwu̱p-u̱ ró du̱gu̱-du̱ ri u̱r-be̱b. <verse eid="GEN 31:31"/><verse number="32" style="v" sid="GEN 31:32"/>Se̱di a-bo̱ hyane̱ waku̱n u̱ ru̱-u ró ne̱, wa za u̱t-shu̱'u̱t u̱r-fat da. U̱ shu̱ ne̱t-tu̱ ko̱-u̱r ró be̱e̱t, gwat u̱ hi-du̱ warró ko̱ abite̱ zu̱ o̱ko̱n o̱ro u̱ it kabne̱ du̱gu̱-du̱ ró u̱ ane̱ u̱du̱ ri. A-bo̱ hyane̱, se̱ bo̱ kab.&gt;&gt; Yakubu nak hyen u̱zu̱ Rahira hiwistu̱n cu̱n-du̱ e'-du̱ u-bu Raban da.<verse eid="GEN 31:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33"/>Raban to rimpa-u̱r Yakubu u̱ku̱n, wa to me̱ rimpa-u̱r Riya wa got, wa to tu̱msu̱ be-du̱ rimpa-du̱ to̱k-ne̱ ne̱ta-u̱t rò u̱t-yu̱r se̱di wa hyanu̱g o̱ko̱n da. M-vaste̱ wa to rimpa-u̱r Rahira. <verse eid="GEN 31:33"/><verse number="34" style="v" sid="GEN 31:34"/>Se̱di, Rahira kabgu̱n ru̱-tu̱ u-bu tu̱ na maye̱ tu̱ e'-du̱ bu-u tu̱ o̱o̱ge̱ tu̱ Raban wa guns u̱ no̱m-du̱ u̱r-shu̱'u̱t u̱ do̱m-u̱ u-rakum wa shu̱'u̱t u̱ do̱m-u̱ de̱. Raban gotu̱sse̱ ko̱he̱ne̱ wa hyanu̱g o̱ku̱n da.<verse eid="GEN 31:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 31:35"/>Rahira zu̱ u̱so-u wa, &lt;&lt;U̱so u-bu ri, a jab-u̱ ró na u̱-me̱ ne̱ da. U̱m da ke̱rre̱ u̱r-yu̱ne̱ u̱-shu̱ ró da, remu̱ zu̱ u̱m o̱ hyu̱-mu̱ u-pyaat yu̱ ne̱ta-ne̱.&gt;&gt; Se̱ wa go̱tu̱sse̱ wa hyanu̱g ru̱-u̱ e'-du̱ u-bu wa da.<verse eid="GEN 31:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 31:36"/>Jab-u̱ Yakubu nu̱ so̱k wa shit Raban u̱zu̱, &lt;&lt;¿Yan-o̱ u̱m no̱me̱ u̱ yo̱-o̱? ¿Yan ba'as-to̱ u̱m no̱mu̱ bo̱, tu̱ bo̱ o̱tte̱ u̱ gotu̱ me̱? <verse eid="GEN 31:36"/><verse number="37" style="v" sid="GEN 31:37"/>Bo̱ cwagu̱sse̱ cwu̱-u̱t ri u̱t-be̱e̱t tu̱ u̱m o̱tte̱. U̱ da-o̱ ko̱su̱ me̱ o̱kon o̱ro u̱ bo̱ hyane̱ u̱ o̱o̱ge̱ u̱ ró! Cin o̱ u̱ ane̱ u̱-shu̱ it, u̱-shu̱ ne̱t-u̱t in, u̱ ko̱wan u̱ hyan. Yage̱ e̱ no̱mu̱ in kwu̱p-du̱ u̱s-rem!<verse eid="GEN 31:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 31:38"/>&lt;&lt;U̱m shu̱'u̱te̱ u̱ bo̱ ne̱ u̱s-hak u̱r-shik (20). Mangu̱ ca ró u̱ so-u̱ gwar-u̱ ró ne̱ e̱ tamu̱g naas-du̱ u̱t-me̱n da. U̱m tamu̱g tu̱-du̱ ko̱ u-ca u-gan ban-du̱ ca ró da. <verse eid="GEN 31:38"/><verse number="39" style="v" sid="GEN 31:39"/>U̱m tamu̱g mu̱tu̱n bo̱ u-du̱ u-bisa u̱ no̱m-yu̱ u̱r-do̱g ho̱ye̱ da, bo̱ wu̱ me̱ u̱m to̱p no̱m-u̱ e̱nke̱ u-be̱e̱t. Tu̱msu̱ bo̱ zu̱ u̱m to̱p bo̱ i na hiwe̱ ko̱ u-ho̱ ko̱ m-gyu̱p. <verse eid="GEN 31:39"/><verse number="40" style="v" sid="GEN 31:40"/>U̱m swaag u̱r-ko̱b u̱ no̱m-u̱ bo̱ m-ank u-ho̱, m-tor ne̱, u̱m kum-u̱t m-roog m-gyu̱p da. <verse eid="GEN 31:40"/><verse number="41" style="v" sid="GEN 31:41"/>Iya-o̱ hak-u̱s ri u̱r-shik u̱m o̱ no̱m-u̱ bo̱ m-to̱k u̱ bu-u ró! U̱m no̱ng u̱s-hak o̱p u̱s-nas [14] u̱ remu̱ bo̱ ye'et me̱ ya-u̱t-gwu̱p-u̱ ró, tu̱msu̱ u̱s-hak u̱s-shishin u̱ remu̱ ban-du̱ bisa-u̱t ró. Bo̱ swase̱ me̱ no̱m-u̱ o̱o̱ge̱ o̱g-u̱r ri u-so u-o̱p. <verse eid="GEN 31:41"/><verse number="42" style="v" sid="GEN 31:42"/>U̱zu̱ u-Ru̱ u̱ u̱so-u̱t ri, Ru̱-u Ibrahi tu̱msu̱ u̱ Ru̱-u̱ u̱so-u ri Ishaku wu̱ wa no̱me̱ m-zap u̱ gye̱r-u wa ne̱, u̱zu̱ wa o̱ u̱r-ko̱t u̱-me̱ ne̱ da, bo̱ za yanu̱g me̱ u̱t-kom zan. Se̱di Ru̱-u̱ hyanu̱g pama-u ri tu̱msu̱ u̱ka u̱m nomte̱ m-ank sok, o̱ wa'e̱ wa nomte̱ bo̱ u̱t-him gyu̱p-ne̱ m-gye̱p u̱zu̱ a-bo̱ jaru̱n bo̱ zu̱ me̱ o̱kon da.&gt;&gt;<verse eid="GEN 31:42"/></para>
  <para style="s1">Yakubu ne̱ e̱ Raban e̱ <optbreak/> no̱mu̱g este̱du̱ u̱s-rem</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43"/>Raban zu̱ Yakubu, &lt;&lt;Ne̱ta-u̱t ró ya'ag-u̱ ri e̱, ya'ag-u̱ e̱ ya'ag-u̱ ri e̱, ban-du̱ bisa-u̱t ró tun-to̱ tu̱ ri to̱, no̱m-u̱ bo̱ hyane̱ u-be̱e̱t u̱ ri o̱, bo̱ o̱ m-ha ne̱ ¿yan-o̱ u̱m do̱'e̱ u̱t-no̱m u̱ da-o̱ u̱ mo̱ttu̱ ya'ag-u̱ ri ne̱, ko̱ u̱ ya'ag-u̱ e̱, mate̱ ne̱? <verse eid="GEN 31:43"/><verse number="44" style="v" sid="GEN 31:44"/>Haane̱ u̱ da-o̱, u̱ yo-u no̱m este̱du̱ u̱s-rem, yage̱ u̱ shu̱'u̱t u̱s-nap u̱du̱ yo-u.&gt;&gt;<verse eid="GEN 31:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45"/>Yakubu kabu̱n u̱r-ta'ar wa ser de̱ u-dak m-kim u̱ka ta'ar-du̱ u̱t-hu̱ktin, u̱ shu̱'u̱t u̱s-nap. <verse eid="GEN 31:45"/><verse number="46" style="v" sid="GEN 31:46"/>Se̱ Yakubu zu̱ ne̱t-u̱t wa, &lt;&lt;Kargu̱ssu̱n u̱t-ta'ar.&gt;&gt; Se̱ e̱ kabu̱n u̱t-ta'ar e̱ kargu̱sse̱ to̱ u̱r-kir, e̱ re no̱m u̱t-re̱ u̱ kit-u̱ kir-ru̱ u̱t-ta'aru̱ de̱. <verse eid="GEN 31:46"/><verse number="47" style="v" sid="GEN 31:47"/>Raban te'e be-u̱r re̱ u̱r-dim Jegar-sahaduta, no̱m-u̱ na zu̱ iya (u̱r-kir du̱ u̱t-baku̱s) tu̱msu̱ Yakubu fog be-u̱r re̱ Gareed, no̱m-u̱ na zu̱ye̱ iya tu̱msu̱ u̱ rem-du̱ Ibraniyawa &lt;&lt;u̱r-kir du̱ u̱t-baku̱s.&gt;&gt;<verse eid="GEN 31:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="GEN 31:48"/>Raban zu̱ Yakubu, &lt;&lt;Dinde̱ kir-du̱ u̱t-ta'ar de̱ du̱ u̱s-nap de̱ u̱du̱ ró ne̱ u̱ ya-o̱.&gt;&gt; O̱ wu̱te̱ na fog-u̱t de̱ Gareed. <verse eid="GEN 31:48"/><verse number="49" style="v" sid="GEN 31:49"/>Na fog be-u̱r re̱ tu̱msu̱ Mizupa, (no̱m-u̱ na zu̱ye̱ iya be-du̱ wadu̱ u̱r-is), remu̱ zu̱ Raban zu̱u̱g, &lt;&lt;Yage̱ Yawe wa u̱r-is u̱ do̱m-u̱ yo, yo-u ship este̱du̱ u̱s-remu̱ din-de̱, da-u̱ waku̱n zare̱ u hyan-du̱ o̱ru̱ wa da. <verse eid="GEN 31:49"/><verse number="50" style="v" sid="GEN 31:50"/>A mu̱ne̱ u̱zu̱ bo̱ no̱ngu̱ ya'ag-u̱ ri no̱m-u̱ yo̱-o̱ ko̱ bo̱ sur m-ga to̱ko̱n ne̱ta to̱, ko̱ ba shu̱'u̱te̱ u̱zu̱ waku̱n zaaru̱ kit-u̱ yo-u da, bakse̱ u̱zu̱ Ru̱-u̱ gwat-du̱ yo.&gt;&gt;<verse eid="GEN 31:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 31:51"/>Raban zu̱ Yakubu, &lt;&lt;Kir-du̱ u̱t-ta'ar u̱ dinde̱, tu̱msu̱ u̱ ta'ar u̱r-dinde̱ du̱ u̱m se̱re̱ u̱ te̱k-u̱ me̱ yo. <verse eid="GEN 31:51"/><verse number="52" style="v" sid="GEN 31:52"/>Dinde̱ kir-de̱ de̱ o̱ u̱s-nap, tu̱msu̱ damra du̱ u̱r-ta'ar dinde̱ de̱ de'e̱ bak-su̱ yo-u, u̱zu̱ u̱m zaaru̱ pas-du̱ ta'ar-du̱ rinde̱ rem u̱m no̱m-tu̱ bo̱ no̱m-u yo̱-o̱ da, tu̱msu̱ bo̱ zaaru̱ pas-du̱ de̱ rem bo̱ no̱m-tu̱ me̱ no̱mu yo̱-o̱ da. <verse eid="GEN 31:52"/><verse number="53" style="v" sid="GEN 31:53"/>Yage̱ Ru̱-u Ibrahi u̱ Ru̱-u Naho̱r ne̱, u̱ Ru̱-u̱ u̱so-u e̱ ne̱, u̱ wa no̱m-u̱ yo-u kwu̱p-du̱ u̱s-rem.&gt;&gt;</para>
  <para style="p" vid="GEN 31:53">Yakubu no̱m u̱s-to̱nd u̱ dim-du̱ u-Ru̱ u̱ ya-du̱ u-gye̱r u̱ u̱so-u wa Ishaku. <verse eid="GEN 31:53"/><verse number="54" style="v" sid="GEN 31:54"/>Yakubu yaag u̱r-to̱o̱g u̱du̱ u-Ru̱ u̱ku̱n u̱-do̱m u̱r-ro̱r wa bu̱n ko̱-u̱r wu̱n e̱ haan u̱ be-du̱ re̱-du̱ no̱m u̱t-re̱. Da-u̱ e̱ tase̱ re̱-du̱ no̱m u̱t-re̱, ku̱na e̱ roogte̱ u̱ gyu̱p-m mo̱.<verse eid="GEN 31:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 31:55"/>Da-u̱ is gase̱ u̱r-wu̱n te̱p te̱p, Raban ham-u̱t ya-u̱t u̱t-gwu̱p u̱ wa u̱ ya'ag-u̱ ya'ag-u̱ wa ne̱ wa wa'-u̱ e̱ nu-u so̱-o̱. Wa yu̱ne̱ wa aru̱k m-mu̱.<verse eid="GEN 31:55"/></para>
  <chapter eid="GEN 31"/>
  <chapter number="32" style="c" sid="GEN 32"/>
  <para style="s1">Yakubu zo̱ngte̱ wa gotu̱n <optbreak/> e̱ Isuwa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1"/>Yakubu tu̱msu̱ wa re u-shu̱ u̱ ha-m wa ne̱, a-to̱m u-Ru̱ haan e̱ bit wu̱n do̱m-u̱ u-fu̱n. <verse eid="GEN 32:1"/><verse number="2" style="v" sid="GEN 32:2"/>Da-u̱ Yakubu hyane̱ u̱n, wa zu̱, &lt;&lt;Din-de̱ be-de̱, be-du̱ u-Ru̱ de̱.&gt;&gt; Wa wa'-u̱ be-u̱r re̱ u̱r-dim Mahanayim. No̱mu̱ na zu̱ye̱ Mahanayim &lt;&lt;u̱t-rimpa u̱t-yu̱r.&gt;&gt;<verse eid="GEN 32:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3"/>Yakubu tom a-to̱mu̱ wa ne̱ u̱-shu̱ wa m-ha u̱du̱ yu̱-wu̱ya wa Isuwa u̱ gas-u̱ Seyir, dak-u̱ Edo̱m. <verse eid="GEN 32:3"/><verse number="4" style="v" sid="GEN 32:4"/>Wa zu̱ u̱n, &lt;&lt;No̱m-u̱ no̱ de̱ zu̱ Isuwa u̱so u-bu ri o̱r-u̱ ri ya, &lt;No̱m-u̱ to̱k-u̱ ró Yakubu zu̱ye̱ ya, u̱m shu̱'u̱te̱ u̱du̱ Raban tu̱msu̱ ku̱na u̱m o̱tte̱ m-te uno̱ da-o̱. <verse eid="GEN 32:4"/><verse number="5" style="v" sid="GEN 32:5"/>U̱m o̱tte̱ ban-du̱ na, u̱ ca ne̱, u̱ janka ne̱, u̱ gwaar ne̱, u̱ to̱k-ne̱ ne̱ta-ne̱ u̱ campa-ne̱. U̱ da-o̱ u̱m o̱ to̱mtu̱n sin-se̱ rem-se̱ u̱du̱ u̱so u-bu ri, u̱zu̱ ko̱me̱ kwu̱mu̱ hyu̱-m pusmo̱ u̱du̱ ró.&gt; &gt;&gt;<verse eid="GEN 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6"/>Da-u̱ a-to̱m ne̱ mu̱u̱ne̱ u̱du̱ Yakubu, e̱ zu̱, &lt;&lt;It haag u̱du̱ o̱r-u̱ ró Isuwa, wa o̱o̱n u̱ campa-ne̱ u̱t-ko̱k u̱t-nas [400], u̱ no̱ wa ne̱ gotu̱n.&gt;&gt;<verse eid="GEN 32:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 32:7"/>Yakubu hog u-gye̱r sok u̱ no̱m-u̱ na waru̱ wa ne̱, se̱ wa mot ne̱t-tu̱ o̱o̱ge̱ u̱r-kot u̱ wa, u̱ ban-tu̱ ca ne̱ u̱ gwaar ne̱ u̱ rakum ne̱, u̱t-ban u̱t-yu̱r. <verse eid="GEN 32:7"/><verse number="8" style="v" sid="GEN 32:8"/>Wa no̱ng u̱s-dorog u̱zu̱, &lt;&lt;Ko̱ da Isuwa kwu̱ku̱p ban-du̱ u̱r-gan, jiya ban-du̱ u̱r-gan u̱t-ku̱su̱m.&gt;&gt;<verse eid="GEN 32:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9"/>Se̱ Yakubu no̱m u̱s-to̱o̱g, &lt;&lt;Ru̱-u̱ u̱so-u ri Ibrahi, Ru̱-u̱ u̱so-u ri Ishaku, Yawe, bo̱ zu̱ me̱, &lt;Arke̱ m-mu̱ u̱ dak-u ró u̱ ko̱-u̱r ró ne̱, tu̱msu̱ me̱ u̱t-wa bo̱ re̱ u-shu̱.&gt; <verse eid="GEN 32:9"/><verse number="10" style="v" sid="GEN 32:10"/>Me̱ u̱m ko̱rge̱ na zu̱ bo̱ ko̱sku̱ me̱ cwan-u̱t ró tu̱msu̱ nip-u̱t ró ne̱ tu̱ bo̱ ko̱su̱ me̱ da, me̱ yu̱ o̱o̱ge̱ to̱k-u̱ ró. Da-u̱ u̱m yage̱ u-bu tu̱msu̱ u̱m pu̱s gi-yu̱ Jodan, u̱m zatte̱ o̱ko̱n da se̱ ko̱m-yu̱ m-ha, me̱ ya u̱ da-o̱ bu-u ri shu̱'u̱te̱ u̱ yat-o̱ u̱t-ban u̱t-yu̱r. <verse eid="GEN 32:10"/><verse number="11" style="v" sid="GEN 32:11"/>Yawe, me̱ ya u̱m o̱ u̱s-to̱o̱g u̱du̱ ró, bo̱ gu me̱ du̱gu̱ kom-tu̱ o̱r-u̱ ri Isuwa. U̱m o̱ ho̱g-du̱ u-gye̱r u̱zu̱ wa o̱o̱n u̱ zwarnu̱ it m-dum, u̱ ya'ag-u̱ ri ne̱ u̱ ne̱ta-u̱t ri ne̱. <verse eid="GEN 32:11"/><verse number="12" style="v" sid="GEN 32:12"/>Bakse̱ u̱zu̱ bo̱ no̱ngu̱ me̱ este̱du̱ u̱s-rem, bo̱ u̱t-wa u̱m re̱ u-shu̱ tu̱msu̱ bo̱ u̱t-wa u̱ ya'ag-u̱ ri shu̱'u̱t u-tát ba m-hereg mu̱ m-sa, mu̱ zaare̱ u̱t-ogre̱ da.&gt;&gt;<verse eid="GEN 32:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13"/>Yakubu roog u̱ku̱n be-du̱ wa o̱tte̱ m-gyu̱p m-gan, se̱ wa du̱gu̱r cwu̱-tu̱ u-nya du̱gu̱ no̱m-tu̱ u̱t-kom-u̱ wa, wa tom-u̱t to̱ u̱du̱ yu̱-wu̱ya wa Isuwa: <verse eid="GEN 32:13"/><verse number="14" style="v" sid="GEN 32:14"/>Mangu̱ gwaar ne̱ u̱t-ko̱k u̱t-yu̱r [200], gob-u̱ gwaar u̱r-shik [20], mangu̱ ca ne̱ u̱t-ko̱k u̱t-yu̱r [200], tu̱msu̱ kag-u̱ ca u̱r-shik [20], <verse eid="GEN 32:14"/><verse number="15" style="v" sid="GEN 32:15"/>u̱ rakum ne̱ u̱r-shik u̱ o̱p [30], u̱ mangu̱ na ne̱ u̱t-shik u̱t-yu̱r [40], gob-u̱ na o̱p, mangu̱ janka u̱r-shik [20], tu̱msu̱ gob-u̱ janka o̱p. <verse eid="GEN 32:15"/><verse number="16" style="v" sid="GEN 32:16"/>Wa wu̱ to̱k-ne̱ wa e̱ gwat bisa-u̱t to̱, u̱t-ban u̱t-ban, wa zu̱ to̱k-ne̱ wa, &lt;&lt;Arku̱n u̱ shu̱ ri, u̱ no̱ ya' u̱r-ke̱r u̱ ko̱du̱he̱ ban-du̱ u̱t-bisa de̱.&gt;&gt;<verse eid="GEN 32:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 32:17"/>Wa zu̱ ban-du̱ o̱o̱ge̱ u̱ shu̱, &lt;&lt;Da-u̱ o̱r-u̱ ri Isuwa haane̱ u̱du̱ no̱ wa shit no̱, &lt;¿No̱ ne̱t wan to̱ no̱ o̱o̱ge̱? ¿Tu̱msu̱ he̱ne̱ o̱ no̱ o̱tte̱ m-ha? ¿Wana tu̱msu̱ o̱tte̱ tun-to̱ bisa to̱ tu̱ no̱ o̱tte̱ u̱t-be̱e̱t?&gt; <verse eid="GEN 32:17"/><verse number="18" style="v" sid="GEN 32:18"/>Se̱ no̱ zu̱ wa, &lt;Bisa-tu̱ to̱k-u̱ ró Yakubu to̱. Se̱di tu̱ u-nya to̱ tu̱ wa zu̱ na yase̱ u̱so u-bu ri Isuwa. Wa o̱o̱n u̱ dim-u̱ it.&gt; &gt;&gt;<verse eid="GEN 32:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 32:19"/>Wa sur m-no̱mu̱ ban-du̱ u-yu̱ru̱mse̱ u̱t-him, u̱du̱ u-tu̱tu̱rse̱ ne̱ u̱ i o̱o̱ge̱ u̱ gwat-du̱ ban-tu̱ u̱t-bisa ne̱ u̱t-be̱e̱t: &lt;&lt;No̱ be̱e̱t no̱ do̱'e̱ zu̱ Isuwa no̱m-u̱ u-gan u̱ka u̱m zu̱tte̱ o̱r-u̱t no̱ ne̱. <verse eid="GEN 32:19"/><verse number="20" style="v" sid="GEN 32:20"/>Se̱di no̱ do̱'e̱ zu̱du̱ wu̱n, &lt;Gwat to̱k-u̱ ró Yakubu o̱o̱n u̱ dim-u̱ it.&gt; &gt;&gt; Yakubu no̱ng u̱s-dorog u̱zu̱ &lt;&lt;U̱m o̱ u̱ssa u̱m swaan hi-u̱r rò u̱ remu̱ nya-u̱ u̱m tomte̱ u̱-shu̱ ri, da-u̱ u̱m hyane̱ wu̱n, jiya wu̱nu̱ kabu̱ me̱ u̱t-kom u̱t-yu̱r.&gt;&gt; <verse eid="GEN 32:20"/><verse number="21" style="v" sid="GEN 32:21"/>Se̱ cwu̱-tu̱ u-nya tu̱ Yakubu aru̱k u̱-shu̱ wa, se̱di Yakubu roog u̱-dim m-gyu̱p u̱r-rimpa.<verse eid="GEN 32:21"/></para>
  <para style="s1">Yakubu no̱ng <optbreak/> u̱t-noos u-Ru̱ ne̱</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22"/>Da-u̱ gyu̱p-mu̱ no̱me̱ Yakubu yu̱ne̱ wa ku̱b ne̱ta-u̱t wa u̱t-yu̱r, u̱ to̱k-u̱ ne̱ta-u̱t wa ne̱, u̱ ya'ag-u̱ campa-ne̱ wa ne̱ o̱p u-gan wa pu̱s gi-yu̱ Jabok u̱ e̱ ne̱. <verse eid="GEN 32:22"/><verse number="23" style="v" sid="GEN 32:23"/>Da-u̱ wa pase̱ u̱ u̱n ne̱ u̱ din-de̱ jit gwu̱g-du̱ u-koor de̱, wa pu̱st no̱m-tu̱ wa o̱tte̱ u̱t-be̱e̱t. <verse eid="GEN 32:23"/><verse number="24" style="v" sid="GEN 32:24"/>Yakubu wa kuse̱ u̱ war-wa u̱ku̱n, yaku̱n campa-ya haan wa nom u̱t-noos u̱ wu̱n ne̱ se̱ u̱r-gas is. <verse eid="GEN 32:24"/><verse number="25" style="v" sid="GEN 32:25"/>Da-u̱ ne̱tu̱ wa hyane̱ wa kerge̱ wu̱n da, se̱ wa tu̱m sharru̱ u-kut u̱ Yakubu de̱ shate̱ da-u̱ wa o̱o̱ge̱ u̱t-noos u̱ campa-u ya ne̱. <verse eid="GEN 32:25"/><verse number="26" style="v" sid="GEN 32:26"/>Se̱ ne̱tu̱ wa zu̱, &lt;&lt;Yage̱ me̱ u̱m aru̱k, is haag m-gas.&gt;&gt;</para>
  <para style="p" vid="GEN 32:26">Yakubu shu̱s wa zu̱, &lt;&lt;U̱m da yagu̱ bo̱ da se̱ bo̱ wage̱ me̱ nu-u so̱-o̱.&gt;&gt;<verse eid="GEN 32:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27"/>Ne̱tu̱ wa shit wa zu̱, &lt;&lt;¿Dim-u̱r ró de̱ na zu̱ wane̱?&gt;&gt;</para>
  <para style="p" vid="GEN 32:27">Wa shu̱s wa zu̱, &lt;&lt;Dim-u̱r ri de̱ na zu̱ye̱ Yakubu.&gt;&gt;<verse eid="GEN 32:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28"/>Se̱ ne̱tu̱ wa zu̱ wu̱n, &lt;&lt;Na zamu̱n u̱t-swu̱r m-fag bo̱ Yakubu da, se̱di Isra, rem u̱zu̱ bo̱ no̱ng u̱t-noos u-Ru̱ ne̱ u̱t-ne̱t ne̱ tu̱msu̱ bo̱ re u̱r-ko̱rro̱.&gt;&gt;<verse eid="GEN 32:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29"/>Yakubu shit wu̱n, wa zu̱, &lt;&lt;Gag jab waru̱ me̱ dim-u̱r ró.&gt;&gt;</para>
  <para style="p" vid="GEN 32:29">Wu̱n zu̱ wa, &lt;&lt;¿Remu̱ u-yan o̱ bo̱ o̱tte̱ u̱ssa bo̱ nap dim-u̱r ri?&gt;&gt; Se̱ wa wa'-u̱ Yakubu nu-u so̱-o̱ u̱ku̱n.<verse eid="GEN 32:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30"/>Se̱ Yakubu fog dim-du̱ be-u̱r re̱ Peniye̱r du̱ na zu̱ye̱, &lt;&lt;Shu̱-u̱ u-Ru̱ remu̱ zu̱ u̱m hyanu̱g u-Ru̱ u-shu̱ u-shu̱ ne̱, m-ha iya ne̱ u̱m maru̱g da.&gt;&gt;<verse eid="GEN 32:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 32:31"/>Da-u̱ ho̱-du̱ o̱ rwu̱u̱n se̱ Yakubu yage̱ Pe̱niye̱r, wa o̱ m-da u̱s-teger remu̱ sharru̱ u-kut-u̱ wa shakte̱. <verse eid="GEN 32:31"/><verse number="32" style="v" sid="GEN 32:32"/>De̱ wu̱te̱ Isra-ne̱ tu̱-u̱t ap-mu̱ u-kut da, u̱ haan u̱ da-o̱, remu̱ zu̱ kut-o̱ na tu̱mte̱ Yakubu.<verse eid="GEN 32:32"/></para>
  <chapter eid="GEN 32"/>
  <chapter number="33" style="c" sid="GEN 33"/>
  <para style="s1">Yakubu gogon e̱ Isuwa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1"/>Se̱ Yakubu jaku̱s is wa hyen Isuwa, u̱ daan u̱ campa-ne̱ wa ne̱ u̱t-ko̱k u̱t-nas [400], se̱ wa mo̱t ya'ag-u̱ wa u̱ te̱k-u̱ Riya, Rahira, u̱ to̱k-ne̱ ne̱ta-u̱t wa ne̱ u̱t-yu̱r. <verse eid="GEN 33:1"/><verse number="2" style="v" sid="GEN 33:2"/>Se̱ wa wu̱ to̱k-ne̱ ne̱ta-u̱t wa u̱ ya'ag-u̱ e̱ ne̱ u̱-shu̱, Riya do̱ro̱n e̱ u̱ ya'ag-u̱ wa ne̱, tu̱msu̱ Rahira ne̱ e̱ Yusuhu m-vaste̱. <verse eid="GEN 33:2"/><verse number="3" style="v" sid="GEN 33:3"/>Yakubu aru̱k u̱ nu-du̱. Da-u̱ wa no̱me̱ mo̱ttu̱ te-du̱ be-du̱ Isuwa o̱tte̱, wa do̱'e̱ wa he̱ u̱t-jwu̱n u̱ shu̱ wa u-dak u̱so u-ta'er.<verse eid="GEN 33:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 33:4"/>Se̱di Isuwa nom m-so̱m wa bit wu̱n wa ham-u̱t wu̱n, se̱ wa haatu̱n hi-u̱r wu̱n u̱ zag u̱t-kap-u̱ wa, ko̱wan su gu̱t-du̱ o̱r-u̱ wa. U̱n be̱e̱t ko̱wan hu̱ u̱s-kan. <verse eid="GEN 33:4"/><verse number="5" style="v" sid="GEN 33:5"/>Isuwa got u̱t-ne̱ta u̱ yaag ne̱. Wa shit, &lt;&lt;¿Ne̱t-u̱t tun-to̱ tu̱ o̱o̱ge̱ u̱r-kot u̱ bo̱ ne̱ wanne̱ e̱?&gt;&gt;</para>
  <para style="p" vid="GEN 33:5">Yakubu zu̱, &lt;&lt;Yaag-u̱ u-Ru̱ ya'u̱ to̱k-u̱ ró e̱.&gt;&gt;<verse eid="GEN 33:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 33:6"/>Se̱ to̱k-ne̱ ne̱ta-u̱t rò, da-u̱ e̱ o̱ mo̱ttu̱ be-du̱ wu̱n o̱tte̱ e̱ hikne̱ e̱ haan e̱ he u̱t-jwu̱n shu̱-u e̱ u-dak u̱ ya'ag-u̱ e̱ ne̱. <verse eid="GEN 33:6"/><verse number="7" style="v" sid="GEN 33:7"/>Riya haan u̱ i wa yaag-e̱ ne̱, e̱ so̱ko̱t u-dak u̱ shu̱ wu̱n. M-vaste̱ Rahira haan e̱ Yusuhu e̱ he u̱t-jwu̱n u̱ shu̱ wu̱n.<verse eid="GEN 33:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8"/>Isuwa shit, &lt;&lt;¿Yan-o̱ dorog-u̱s ró, u̱m hyanu̱g ban-tu̱ u̱t-bisa tun-to̱, ca, u̱ gwaar ne̱, u̱ na ne̱ tu̱ u̱m goone̱ u̱ to̱ ne̱ u-fu̱n?&gt;&gt;</para>
  <para style="p" vid="GEN 33:8">Wa zu̱ wu̱n, &lt;&lt;U̱so u-bu ri, u̱m u̱t-sa u̱m kum hyu̱-m pusmo̱ u̱du̱ ró.&gt;&gt;<verse eid="GEN 33:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9"/>Se̱di Isuwa zu̱, &lt;&lt;U̱m o̱tte̱ no̱m-tu̱ ko̱ru̱ me̱, shipse̱ no̱m-u̱t ró hi-du̱ war ró.&gt;&gt;<verse eid="GEN 33:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10"/>Yakubu zu̱, &lt;&lt;O'o, gag jab, abite̱ u̱m kwu̱mu̱g hyu̱-m pusmo̱ u̱du̱ ró, kab nya-u ri, remu̱ u̱zu̱ hyan-du̱ shu̱-u ró o̱ sha-mu̱ hyan-du̱ shu̱-u u-Ru̱, bo̱ ya u̱ da-o̱ bo̱ kabu̱g me̱ u̱ te̱k u̱r-so̱. <verse eid="GEN 33:10"/><verse number="11" style="v" sid="GEN 33:11"/>Gag jab o̱nke̱ nya-u̱ u̱m haatu̱n bo̱, remu̱ zu̱ u-Ru̱ o̱ u̱r-kot u̱-me̱ ne̱ u̱m o̱tte̱ no̱m-u̱ u̱m o̱ u̱ssa u-be̱e̱t.&gt;&gt; Yakubu e̱kse̱ wu̱n, wu̱n kab no̱m-tu̱ wa to̱mtu̱n wu̱n, Isuwa o̱nk to̱ u̱t-be̱e̱t.<verse eid="GEN 33:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12"/>Isuwa zu̱, &lt;&lt;To̱, zo̱nge̱ yo-u no̱k, me̱ ko̱su̱ bo̱ u-fu̱n.&gt;&gt;<verse eid="GEN 33:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13"/>Se̱di Yakubu zu̱, &lt;&lt;U̱so u-bu ri, bo̱ hyanu̱g ya'ag-u̱ ri e̱ke̱n o̱mo̱n u̱ re̱k-e̱, tu̱msu̱ ban-tu̱ u̱t-bisa e̱ke̱n o̱tte̱ ya-u̱t re̱kto̱ ko̱'e̱, a it buze e̱ m-so̱m, e̱ u̱t-mu̱rmu̱sse̱ be̱e̱t. <verse eid="GEN 33:13"/><verse number="14" style="v" sid="GEN 33:14"/>U̱so u-bu ri, gag jab, arke̱ u̱-shu̱ to̱k-u̱ ró, it no̱ko̱n cashi cashi, u̱ka bisa-tu̱ do̱te̱ u̱ ke̱rru̱ u̱r-no̱k u̱ ya-u̱t e̱ ne̱, me̱ bitu̱ bo̱ u̱ Seyir.&gt;&gt;<verse eid="GEN 33:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15"/>Isuwa zu̱, &lt;&lt;Yage̱ u̱m yage̱ to̱ko̱n ne̱t-u̱t ri to̱ u̱du̱ ró.&gt;&gt;</para>
  <para style="p" vid="GEN 33:15">Se̱di Yakubu zu̱ wu̱n, &lt;&lt;U̱so u-bu ri, a se̱ bo̱ no̱ng iya da! No̱m-u̱ u̱m o̱o̱ge̱ u̱ssa bo̱ ho̱g re̱me̱r-m ri.&gt;&gt;<verse eid="GEN 33:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 33:16"/>U̱ gandi ho̱-u̱r re̱ Isuwa aru̱k m-mu̱ u̱ dak-u̱ Seyir. <verse eid="GEN 33:16"/><verse number="17" style="v" sid="GEN 33:17"/>Yakubu aru̱k m-mu̱ u̱ dak-u̱ Sukot, ku̱na wa muute̱ u̱r-be remu̱ a-u-bu wa ne̱ nom-u̱t u̱r-yu̱ u̱ku̱n. Tu̱msu̱ wa no̱me̱ bisa-u̱t wa u-shingi, o̱ wa-e̱ wa fog-u̱t be-u̱r re̱ Sukot, no̱m-u̱ na zu̱ye̱ Sukot be-du̱ u̱r-hure̱.<verse eid="GEN 33:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18"/>M-vaste̱, da-u̱ Yakubu haane̱ du̱gu̱ Padan-Aram, wa teeg bo̱-u̱ She̱ke̱m m-yar, dak-u̱ Kan'ana, wa no̱m u̱r-rimpa u̱t-mo̱r u-bo̱ ne̱. <verse eid="GEN 33:18"/><verse number="19" style="v" sid="GEN 33:19"/>Yakubu o̱o̱g u̱r-ke̱ngi du̱ u-tak be-du̱ wa nomte̱ u̱r-shu̱m u̱ kwam-u̱t pus-to̱ tu̱ u-ko̱k u-gan [100]. Du̱gu̱-du̱ a-u-bu Hamor, u̱so-u She̱ke̱m, wa babe̱ Yakubu ke̱ngi-u̱r re. <verse eid="GEN 33:19"/><verse number="20" style="v" sid="GEN 33:20"/>Ku̱na wa mate u̱r-sak wa wa'-u̱ de̱ u̱r-dim E̱r E̱ro̱hi Isra, dim-u̱r re̱ na zu̱ye̱, Ru̱-u̱ Isra-ne̱.<verse eid="GEN 33:20"/></para>
  <chapter eid="GEN 33"/>
  <chapter number="34" style="c" sid="GEN 34"/>
  <para style="s1">Dinatu e̱ ne̱t-tu̱ She̱ke̱m</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1"/>De̱ku̱n ho̱-de̱ Dinatu, gwu̱p-u̱ Yakubu ne̱ e̱ Riya, wa do̱'e̱ u̱ wa hatu̱ e̱ke̱n ya-u̱t-gwu̱p u̱t-riig i o̱o̱ge̱ u̱ shu̱'u̱t u̱ dak-u o̱. <verse eid="GEN 34:1"/><verse number="2" style="v" sid="GEN 34:2"/>Se̱di da-u̱ zwar-u̱ Hamor ne̱t-u̱ Hiwi, faru̱k-u̱ dak-u̱ She̱ke̱m hyane̱ Dina, wa ku̱b wa, wa no̱m-u̱ wa u̱r-ryapu̱k u̱r-be̱b. <verse eid="GEN 34:2"/><verse number="3" style="v" sid="GEN 34:3"/>Jab-u̱ wa to u̱du̱ Dinatu gwu̱p-u̱ Yakubu. Wa o̱ cwan-tu̱ gwu̱p-u̱ wa sok, wa no̱m u̱s-rem u̱ka wa do̱te̱ u̱ nak-du̱ jab-u̱ Dinatu u̱ gom-u̱t wa. <verse eid="GEN 34:3"/><verse number="4" style="v" sid="GEN 34:4"/>Se̱ She̱ke̱m zu̱ u̱so wa Hamor, &lt;&lt;U̱m o̱ u̱t-sa bo̱ kwu̱mnu̱ me̱ gwu̱p unwa, u̱ wa shu̱'u̱t ne̱ta ri.&gt;&gt;<verse eid="GEN 34:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5"/>Yakubu hog u̱zu̱ Shekem naaste̱ gwu̱p-u̱ wa Dinatu. Ba shu̱'u̱te̱ u̱zu̱ ya'ag-u̱ campa-ne̱ wa zaar u-bu da e̱ o̱ u̱r-do̱g u̱ be-du̱ gwat-du̱ u̱t-bisa, wa zu̱u̱g o̱ko̱n da se̱ da-u̱ e̱ mu̱ne̱.<verse eid="GEN 34:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 34:6"/>Hamor, u̱so She̱ke̱m, wa haan u̱du̱ Yakubu wa no̱m u̱s-rem u̱ wa ne̱. <verse eid="GEN 34:6"/><verse number="7" style="v" sid="GEN 34:7"/>Da-u̱ e̱ o̱ te̱k u̱s-rem, ya'ag-u̱ campa-ne̱ Yakubu mu̱u̱n du̱gu̱ u̱r-do̱g. Da-u̱ e̱ ho̱ge̱ no̱m-u̱ no̱me̱, jab-u̱ e̱ nu̱ sok, remu̱ zu̱ Shekem no̱mu̱g no̱m-tu̱ m-'e̱ u̱ te̱k-u̱ ne̱t-tu̱ Isra du̱ wa roogte̱ u̱ gwu̱p-u̱ Yakubu ne̱, no̱m-u̱ kame̱ da.<verse eid="GEN 34:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 34:8"/>Hamor nom u̱s-rem u̱ Yakubu u̱ ya'ag-u̱ wa ne̱. Wa zu̱, &lt;&lt;Zwaru̱ ri She̱ke̱m o̱ u̱ cwan-tu̱ gwu̱p-u̱ no̱, u̱m o̱ u̱s-ko̱n, no̱ ya' wa'-u̱-gwu̱p-u̱ no̱, Dina shu̱'u̱t ne̱ta wa. <verse eid="GEN 34:8"/><verse number="9" style="v" sid="GEN 34:9"/>U̱m o̱ u̱ssa u̱ in no̱m u̱t-gu̱ u̱ te̱k-u̱ in, u̱ no̱ ya' ya-u̱t-gwu̱p-u̱ no̱ u̱du̱ ya'ag-u̱ campa-ne̱ it, tu̱msu̱ it u̱t-ya no̱ ya-u̱t-gwu̱p-u̱ it u̱du̱ ya'ag-u̱ campa-ne̱ no̱. <verse eid="GEN 34:9"/><verse number="10" style="v" sid="GEN 34:10"/>No̱ u̱t-kere̱ u̱r-shu̱'u̱t it, dak-u it u̱ ya u̱du̱ no̱. Shu̱'u̱tu̱n u̱no̱ no̱m u-cerpa u̱ it ne̱, a no̱ kume̱ u-tak u̱ no̱ o̱o̱ge̱ u̱ssa, no̱ u̱t-kere̱ u̱t-o̱.&gt;&gt;<verse eid="GEN 34:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11"/>She̱ke̱m no̱m u̱s-rem u̱ u̱so-u Dinatu ne̱ u̱ tu̱-wu̱to̱ wa ne̱. Wa zu̱, &lt;&lt;Yagu̱n u̱m kum hyu̱-m pusmo̱ u̱du̱ no̱, me̱ ya'u̱ no̱ no̱m-u̱ no̱ zu̱ye̱ u-be̱e̱t. <verse eid="GEN 34:11"/><verse number="12" style="v" sid="GEN 34:12"/>Kwu̱pu̱n me̱ shik-u̱ go̱ro̱m u̱ cwu̱-tu̱ u̱r-gu̱ ne̱ u-tát u̱ka no̱ o̱tte̱ u̱ssa, me̱ u̱t-to̱p no̱mu̱ no̱ u̱ssa u-be̱e̱t. No̱m-u̱ u̱m o̱o̱ge̱ u̱ssa u̱ war-o̱ ya me̱, wa-gwu̱p ko̱ wa u̱t-shu̱'u̱t ne̱ta ri.&gt;&gt;<verse eid="GEN 34:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13"/>Remu̱ zu̱ She̱ke̱m naaste̱ Dinatu, ya'ag-u̱ campa-ne̱ Yakubu po̱o̱t She̱ke̱m e̱ u̱so-u wa Hamor. <verse eid="GEN 34:13"/><verse number="14" style="v" sid="GEN 34:14"/>E̱ zu̱ u̱n, &lt;&lt;It zaar u̱ keru̱ u̱t-no̱m iya da. It za ya-du̱ gwu̱p-u̱ it u̱du̱ i zatte̱ u̱r-pe̱s da, u̱t-shu̱'u̱t no̱m-tu̱ m-'e̱ u̱du̱ it. <verse eid="GEN 34:14"/><verse number="15" style="v" sid="GEN 34:15"/>Fu̱n-yu̱ u̱t-do̱ru̱ ya, yu̱ it do̱te̱ u̱t-ees, abite̱ zu̱ no̱ u̱t-ees na no̱ no̱mu̱ no̱ u̱r-pe̱s u̱ka it o̱tte̱. <verse eid="GEN 34:15"/><verse number="16" style="v" sid="GEN 34:16"/>Da-u o̱ it do̱'e̱ ya'u̱ no̱ ya-u̱t-gwu̱p-u̱ it, it u̱t-kab ya-u̱t-gwu̱p-u̱ no̱, it-u̱ u̱t-shu̱'u̱t u̱-me̱ no̱, in shu̱'u̱tu̱n u̱s-gan. <verse eid="GEN 34:16"/><verse number="17" style="v" sid="GEN 34:17"/>Se̱di a no̱ gu̱gme̱ u̱t-ees u̱ na no̱m-u̱ no̱ u̱r-pe̱s, it-u̱ kabu̱ hu̱no̱ it Dinatu, it aru̱k u̱ su̱ it.&gt;&gt;<verse eid="GEN 34:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18"/>Hamor e̱ wa'-u̱ wa She̱ke̱m e̱ ees u̱ no̱mu̱ u̱n waru̱ e̱ ne̱. <verse eid="GEN 34:18"/><verse number="19" style="v" sid="GEN 34:19"/>She̱ke̱m naaste̱ u-da u̱ no̱m-du̱ ko̱n-u̱s sin-se̱ da, remu̱ wa o̱ u̱ cwan-tu̱ gwu̱p-u̱ Yakubu sok. She̱ke̱m wa na ze̱ge̱ m-ya m-ze̱g a-u-bu wa ne̱. <verse eid="GEN 34:19"/><verse number="20" style="v" sid="GEN 34:20"/>Hamor ne̱ e̱ She̱ke̱m e̱ aru̱k, e̱ hu̱u̱t rem-u̱s se̱ u̱du̱ ne̱nge̱n-tu̱ u-bo̱ u̱ is-yu̱ u-bo̱. <verse eid="GEN 34:20"/><verse number="21" style="v" sid="GEN 34:21"/>E̱ zu̱ u̱n, &lt;&lt;Ne̱t-u̱t tun-to̱ hu̱u̱b-u̱t in to̱, in yagu̱n u̱n shu̱'u̱t in u̱ ane̱ jab gan. Dak-u̱ uno̱ o̱ u-tát o̱ ko̱rge̱ cu̱ndu̱ u̱n. Se̱ in gaan ya-u̱t-gwu̱p-u̱ u̱n tu̱msu̱ in yasu̱n u̱n ya-u̱t-gwu̱p-u̱ in e̱ ga. <verse eid="GEN 34:21"/><verse number="22" style="v" sid="GEN 34:22"/>Se̱di u̱n u̱t-shu̱'u̱t u̱ in ne̱ u̱ ane̱ in shu̱'u̱t u̱s-gan u̱ u̱n ne̱ a shu̱'u̱te̱ u̱zu̱ inu̱ campa-ne̱ in u̱t-no̱m u̱r-pe̱s, u̱ka u̱n o̱tte̱. <verse eid="GEN 34:22"/><verse number="23" style="v" sid="GEN 34:23"/>Se̱di a in no̱me̱ iya, bisa-u̱t u̱n u̱ no̱m-tu̱ u̱n o̱tte̱ ne̱ to̱ u̱t-shu̱'u̱t tu̱ in, yagu̱n in ees u̱ rem-u̱s u̱n ne̱, u̱n shu̱'u̱t u̱ in ne̱.&gt;&gt;<verse eid="GEN 34:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 34:24"/>Ne̱t-tu̱ haane̱ u̱t-be̱e̱t u̱ be-du̱ u̱r-mo̱ro̱g du̱ u-bo̱ e̱ ees e̱ ku̱b Hamor ne̱ e̱ She̱ke̱m. Na no̱mu̱ campa-ne̱ be̱e̱t i o̱ u-bo̱ u̱r-pe̱s.<verse eid="GEN 34:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25"/>Ba rooge̱ u̱t-tu̱t, ba shu̱'u̱te̱ u̱n o̱mo̱n u̱ ho̱g-du̱ m-re̱ mu̱ u̱r-pe̱s, ya'ag-u̱ Yakubu yu̱r, Simiyo̱n e̱ Re̱wi, tu̱-wu̱to̱ Dinatu, e̱ yu̱ne̱ e̱ ku̱b u̱s-van, e̱ do̱'e̱ e̱ he̱e̱se̱ u-bo̱ za nap-u̱r e̱, e̱ ho̱ru̱sse̱ ya'ag-u̱ campa-ne̱ be̱e̱t, <verse eid="GEN 34:25"/><verse number="26" style="v" sid="GEN 34:26"/>m-ha Hamor ne̱ e̱ wa'-u̱ wa Shekem. U̱n ho̱ru̱sse̱ e̱ u̱ van-su̱ m-wu̱r u̱ u̱n, se̱ u̱n kabu̱n Dinatu du̱gu̱ bu-u She̱ke̱m m-mu̱ rimpa-u̱r e̱. <verse eid="GEN 34:26"/><verse number="27" style="v" sid="GEN 34:27"/>Se̱ ya'ag-u̱ campa-ne̱ Yakubu, i kuse̱, e̱ haan u̱ be-du̱ u-tu̱ ne̱t-ne̱ tu̱t o̱tte̱, u-bo̱ e̱ koos no̱m-tu̱ e̱ o̱tte̱ u̱t-be̱e̱t, remu̱ zu̱ e̱ naaste̱ hu̱no-u e̱. <verse eid="GEN 34:27"/><verse number="28" style="v" sid="GEN 34:28"/>E̱ haan e̱ koos ban-du̱ na u̱n, u̱ ca ne̱, u̱ janka ne̱, u̱ no̱m-tu̱ u̱n o̱tte̱ u̱t-be̱e̱t u-bo̱ tu̱msu̱ u̱-do̱ ne̱ u̱t-ke̱ngi. <verse eid="GEN 34:28"/><verse number="29" style="v" sid="GEN 34:29"/>E̱ ku̱b no̱m-tu̱ u̱t-kom-u̱ u̱n ne̱ u̱ ya'ag-u̱ u̱n ne̱ u̱ ne̱ta-u̱t u̱n ne̱, u̱ no̱m-tu̱ u̱n o̱tte̱ bu-u̱t u̱n ne̱ u̱t-be̱e̱t.<verse eid="GEN 34:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30"/>Yakubu zu̱ Simiyo̱n e̱ Re̱wi, &lt;&lt;No̱ hattu̱n me̱ swa-u̱ u̱r-ko̱b. No̱ wa'ag u̱m shu̱'u̱te̱ no̱m u̱t-gu̱gu̱m u̱du̱ ne̱t-tu̱ Kan'ana u̱ ne̱t-tu̱ Periziya-ne̱, ne̱t-tu̱ o̱ u̱ shu̱'u̱t u̱ dak-u uno̱. In za u-tát da, a u̱n same̱ ne̱t-u̱t u̱n, u̱n he̱e̱se̱ me̱ m-dum, u̱nu̱ ho̱ me̱ u̱ bu-u ri ne̱.&gt;&gt;<verse eid="GEN 34:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31"/>Se̱ u̱n shu̱s u̱n zu̱, &lt;&lt;It zaar u̱ yage̱ u̱n no̱mu̱ du̱-dim-u̱ it iya da. Dina a gwu̱p wa wu̱ ko̱wan do̱'e̱ m-roog u̱ wa ne̱ da.&gt;&gt;<verse eid="GEN 34:31"/></para>
  <chapter eid="GEN 34"/>
  <chapter number="35" style="c" sid="GEN 35"/>
  <para style="s1">Yakubu aru̱kte̱ m-mu̱ u̱ Be̱te̱r</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1"/>Ru̱-u̱ zu̱ Yakubu, &lt;&lt;Yu̱ne̱ bo̱ zo̱ng bo̱ aru̱k m-mu̱ Be̱te̱r bo̱ shu̱'u̱t u̱ku̱n. Bo̱ ma-u̱ u-Ru̱ be-du̱ to̱o̱g wu̱ haane̱ u̱du̱ ró da-u̱ bo̱ so̱me̱ du̱gu̱-du̱ hu̱no-u ró Isuwa.&gt;&gt;<verse eid="GEN 35:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2"/>Yakubu zu̱ ne̱t-tu̱ u-bu wa u̱ ne̱t-tu̱ o̱ u̱r-kot u̱ wa ne̱, &lt;&lt;U̱ ko̱wan u̱ ru̱st ham-u̱t tu̱ u̱t-ru̱ tu̱ za u̱r-fat tu̱ wa o̱ u̱ to̱ ne̱, tu̱msu̱ mu̱u̱tu̱n hi-u̱r no̱ u-he̱n ne̱ tu̱msu̱ no̱ swase̱ cwu̱-tu̱ u-war u̱ no̱. <verse eid="GEN 35:2"/><verse number="3" style="v" sid="GEN 35:3"/>Yu̱nu̱n in no̱ko̱n m-ha u̱ Be̱te̱r, be-du̱ u̱m do̱te̱ ma-u̱ u-Ru̱ u̱r-sak du̱ to̱o̱g, wu̱ o̱nke̱ ko̱n-u̱s ri da-u̱ u̱m o̱o̱ge̱ u̱ swadu̱ u̱r-ko̱b wu̱ o̱o̱ge̱ u̱r-kot ne̱ ko̱he̱ne̱ o̱ u̱m hu̱u̱te̱.&gt;&gt; <verse eid="GEN 35:3"/><verse number="4" style="v" sid="GEN 35:4"/>Se̱ u̱n yasu̱ Yakubu ham-u̱t tu̱ u̱t-ru̱ tu̱ u̱n o̱tte̱ u̱ no̱m-tu̱ u̱t-to̱ u̱n ne̱. Yakubu ku̱b no̱m-u̱t to̱ wa taku̱s u-dak u̱ kug-du̱ yaku̱n teyu̱ u-kwu̱k ya u̱ bo̱-u̱ She̱ke̱m. <verse eid="GEN 35:4"/><verse number="5" style="v" sid="GEN 35:5"/>Da-u u̱n zo̱nge̱ u̱n aru̱k, se̱ gye̱r-u̱ haan du̱gu̱-du̱ u-Ru̱ maas ne̱t-tu̱ bo̱-tu̱ kit-su̱ bo̱-u o̱ u-be̱e̱t waku̱n kerge̱ no̱m-du̱ m-dum u̱ Yakubu ne̱ da.<verse eid="GEN 35:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 35:6"/>Yakubu u̱ ne̱t-tu̱ o̱o̱ge̱ u̱r-kot u̱ wa ne̱ haan u̱ bo̱-u̱ Ruz (u̱ na zu̱ye̱ Be̱te̱r) u̱ dak-u̱ Kan'ana. <verse eid="GEN 35:6"/><verse number="7" style="v" sid="GEN 35:7"/>Yakubu mu̱ be-du̱ to̱o̱g, u̱ku̱n wa te̱'e̱ de̱ u̱r-dim Er-Be̱te̱r, (no̱m-u̱ na zu̱ye̱, u-Ru̱ u̱ Be̱te̱r) remu̱ zu̱ ku̱na Ru̱-u̱ hatu̱n u̱du̱ wu̱n u̱ku̱n da-u̱ wa o̱o̱ge̱ u̱ so̱m-mu̱ o̱r-u̱ wa Isuwa.<verse eid="GEN 35:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 35:8"/>Da-u̱ Debora wu̱ wu̱rge̱ Rebeka mare̱, se̱ na dok wa u̱ kug-du̱ te̱-yu̱ u-kwu̱k u-ta u̱ Be̱te̱r ne̱. Se̱ na fog dim-du̱ be-u̱r re̱ Aron-bekot (na zu̱ &lt;&lt;te-yu̱ u-kwu̱k yu̱ u̱s-kan&gt;&gt;).<verse eid="GEN 35:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9"/>Da-u̱ Yakubu mu̱ne̱ du̱gu̱ Padan-Aram, Ru̱-u̱ sur m-haan u̱du̱ wu̱n, wa wa'-u̱ wu̱n nu-u so̱-o̱. <verse eid="GEN 35:9"/><verse number="10" style="v" sid="GEN 35:10"/>Ru̱-u̱ zu̱ wu̱n, &lt;&lt;Dim-u̱r ró de̱ na zu̱ye̱ Yakubu se̱di na zamu̱n u̱t-swu̱r m-fag bo̱ Yakubu da. Du̱gu̱ da-o̱ dim-u̱r ró do̱'e̱ u̱t-shu̱'u̱t Isra.&gt;&gt; Ru̱-u te̱'e̱ wu̱n u̱r-dim Isra.<verse eid="GEN 35:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 35:11"/>Ru̱-u̱ zu̱, &lt;&lt;Me̱ wa Ru̱-u̱ o̱tte̱ u̱r-be̱b du̱ ko-uyan. No̱m u̱r-mat u̱ bo̱ kum yaag u-tát, u̱t-dak u-tát to̱ de̱ rwu̱u̱n, faru̱k-tu̱ do̱'e̱ u̱ rwu̱u̱n du̱gu̱ ya'ag-u̱ ró. <verse eid="GEN 35:11"/><verse number="12" style="v" sid="GEN 35:12"/>Tu̱msu̱ me̱ ya'u̱ bo̱ dak-u̱ u̱m tame̱ ya-du̱ Ibrahi ne̱ e̱ Ishaku. Me̱ ya'u̱ bo̱ dak-u o̱ u̱du̱ ya'ag-u̱ ró I do̱'e̱ haan u̱ dim-u̱ ró.&gt;&gt; <verse eid="GEN 35:12"/><verse number="13" style="v" sid="GEN 35:13"/>Ru̱-u̱ aru̱k wa yagu̱ wu̱n u̱ku̱n u̱ be-du̱ wa nomte̱ u̱s-rem u̱ wu̱n ne̱.<verse eid="GEN 35:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 35:14"/>Yakubu ser taar-u̱r yadde̱ u̱ka ta'ar-du̱ u̱t-hu̱ktin wa yu̱nu̱s de̱ m-kim be-du̱ Ru̱-u̱ nomte̱ u̱s-rem u̱ wa ne̱, se̱ wa agu̱z ke̱ u̱-do̱m sha-mu̱ ya-du̱ to̱o̱g u̱ no̱m-tu̱ u̱t-swa ne̱ u̱-do̱m, wa daas m-no̱o̱g u̱-do̱m tu̱msu̱. <verse eid="GEN 35:14"/><verse number="15" style="v" sid="GEN 35:15"/>Yakubu fu̱g be-du̱ Ru̱-u̱ nomte̱ u̱s-rem u̱ wa ne̱ Be̱te̱r.<verse eid="GEN 35:15"/></para>
  <para style="s1">Mar-m Rahira ne̱ <optbreak/> e̱ Ishaku</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16"/>Se̱ u̱n aru̱k u̱n yage̱ Be̱te̱r. Tun u̱n o̱ m-ra u̱ bo̱-u̱ Eparat ne̱, Rahira he̱e̱se̱ re̱mu̱ u̱t-me̱n tu̱ u̱r-mat wa so̱ u̱r-ko̱b so̱k. <verse eid="GEN 35:16"/><verse number="17" style="v" sid="GEN 35:17"/>Da-u̱ wa swa u̱r-ko̱b u̱du̱ u̱r-mat, ne̱ta wu̱ gwat-du̱ wu̱n u̱du̱ u̱r-mat zu̱ wu̱n, &lt;&lt;A-bo̱ ho̱g u-gye̱r da, u̱ da-o̱ bo̱ swu̱ru̱g m-kwu̱m ya-du̱ u̱r-campa de̱.&gt;&gt; <verse eid="GEN 35:17"/><verse number="18" style="v" sid="GEN 35:18"/>Da-u̱ Rahira o̱o̱ge̱ u̱ mo̱ttu̱ m-mar, se̱di u̱ vu̱'e̱ su̱ m-vaste̱ wa, wa fu̱g dim-du̱ ya-du̱ u̱r-campa wa Benomi (no̱m-u̱ na zu̱ye̱ iya, &lt;&lt;Wa'-u̱ swadu̱ u̱r-ko̱b&gt;&gt;). U̱so u̱r-ya fu̱g u̱r-ya Banyamin (na zu̱ &lt;&lt;Wa'-u̱ kom u̱t-cwa u̱ ri&gt;&gt;).<verse eid="GEN 35:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19"/>Rahira mu̱ru̱s na dok wa u̱ fu̱n-yu̱ ha-mu̱ Eparat (na zu̱ Be̱tarami). <verse eid="GEN 35:19"/><verse number="20" style="v" sid="GEN 35:20"/>Yakubu ser u̱r-ta'ar du̱ u̱t-baku̱s u̱ saag-u Rahira, had da-o̱ ta'ar-u̱r re̱ o̱mo̱n u̱ku̱n.<verse eid="GEN 35:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 35:21"/>Isra sur m-hikne̱ wa do̱'e̱ wa ser u̱r-rimpa u̱ Migdar Edar. <verse eid="GEN 35:21"/><verse number="22" style="v" sid="GEN 35:22"/>Da-u̱ Isra o̱o̱ge̱ u̱ shu̱'u̱t u̱ku̱n, Rube̱n roog u̱ Biru̱ha ne̱, ne̱ta u̱r-kit u̱ u̱so wa. Yakubu hog rem-u̱s se̱ za naas u-da.</para>
  <para style="m" vid="GEN 35:22">Yakubu o̱tte̱ ya'ag-u̱ campa-ne̱ o̱p u̱ yu̱r.<verse eid="GEN 35:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 35:23"/>Yaag-u̱ campa-ne̱ Riya:</para>
  <para style="li" vid="GEN 35:23">Rube̱n (mat-du̱ u-shu̱ Yakubu),</para>
  <para style="li1" vid="GEN 35:23">u̱ Simiyo̱n,</para>
  <para style="li1" vid="GEN 35:23">u̱ Re̱wi,</para>
  <para style="li1" vid="GEN 35:23">u̱ Yahuda,</para>
  <para style="li1" vid="GEN 35:23">u̱ Issakar,</para>
  <para style="li1" vid="GEN 35:23">u̱ Ze̱burun.<verse eid="GEN 35:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 35:24"/>Yaag-u̱ campa-ne̱ Rahira o̱:</para>
  <para style="li1" vid="GEN 35:24">Yusuhu u̱ Banyamin.<verse eid="GEN 35:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 35:25"/>Yaag-u̱ campa-ne̱ Biru̱ha,</para>
  <para style="li1" vid="GEN 35:25">to̱k-u̱ Rahira o̱:</para>
  <para style="li1" vid="GEN 35:25">Dan u̱ Napari.<verse eid="GEN 35:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 35:26"/>Yaag-u̱ campa-ne̱ Zirpa,</para>
  <para style="li1" vid="GEN 35:26">to̱k-u̱ Riya o̱:</para>
  <para style="li1" vid="GEN 35:26">Gad u̱ Ashu̱r.</para>
  <para style="p" vid="GEN 35:26">Tun-to̱ to̱ o̱o̱ge̱ dim-tu̱ ya'ag-u̱ campa-ne̱ Yakubu e̱ na matu̱ wa u̱ Padan-Aram.<verse eid="GEN 35:26"/></para>
  <para style="s1">Mar-m Ishaku</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27"/>Yakubu haan u-bu u̱du̱ u̱so wa Ishaku u̱ Mamre, u̱ dapu̱s Kiriyat Arba (u̱ na zu̱ye̱ He̱bro̱n), be-du̱ Ibrahi ne̱ e̱ Ishaku shu̱'u̱te̱. <verse eid="GEN 35:27"/><verse number="28" style="v" sid="GEN 35:28"/>Ishaku no̱ng u̱s-hak u̱t-shik u̱t-jwu̱r [180]. <verse eid="GEN 35:28"/><verse number="29" style="v" sid="GEN 35:29"/>Ishaku no̱m vu̱'e̱ su̱ m-vaste̱ wa, wa mu̱ru̱s wa bit u̱so-tu̱ u̱so-u̱t wa. Wa no̱ng u̱s-hak u-tát, ya'ag-u̱ campa-ne̱ wa Isuwa ne̱ e̱ Yakubu dok wa.<verse eid="GEN 35:29"/></para>
  <chapter eid="GEN 35"/>
  <chapter number="36" style="c" sid="GEN 36"/>
  <para style="s1">Yaag-u̱ Isuwa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1"/>Unto̱ to̱ o̱o̱ge̱ ogu̱r-tu̱ ko̱-u̱r Isuwa (Tu̱msu̱ wa na fu̱ge̱ Edo̱m).<verse eid="GEN 36:1"/></para>
  <para style="pi1">
    <verse number="2" style="v" sid="GEN 36:2"/>Isuwa gaan ya-u̱t-gwu̱p yu̱r du̱gu̱ Kan'ana: Ada, gwu̱p-u̱ Ero̱n ya-He̱t-ne̱, u̱ O̱ho̱ribama, gwu̱p-u̱ A-na tu̱msu̱ wa'-u̱ wa'-u̱ Zibe̱yon wa-Hiwi-ne̱. <verse eid="GEN 36:2"/><verse number="3" style="v" sid="GEN 36:3"/>Isuwa sur m-ga ne̱ta u-tu̱tu̱rse̱ wu̱ na foge̱ Basemat. Basemat wa o̱o̱ge̱ gwu̱p-u̱ Ismaru tu̱msu̱ du̱-dim-u̱ Nebayo̱t.<verse eid="GEN 36:3"/></para>
  <para style="pi1">
    <verse number="4" style="v" sid="GEN 36:4"/>Ada matu̱ Isuwa Eripa, Basemat mu̱t Re̱we̱r. <verse eid="GEN 36:4"/><verse number="5" style="v" sid="GEN 36:5"/>Tu̱msu̱ O̱ho̱ribama mu̱t ya'ag-u̱ campa-ne̱, Jewus, Jaram, u̱ Kora ne̱. Yaag-u̱ campa-ne̱ e̱ be̱e̱t na mak-tu̱ Isuwa e̱ dak-u̱ Kan'ana.<verse eid="GEN 36:5"/></para>
  <para style="pi1">
    <verse number="6" style="v" sid="GEN 36:6"/>Isuwa ku̱b ne̱ta-u̱t wa, u̱ ya'ag-u̱ wa ne̱ u̱ no̱m-tu̱ u-bu wa ne̱ u̱t-be̱e̱t bisa-u̱t wa ne̱, u̱ no̱m-tu̱ u̱t-kom-u̱ wa kume̱ u̱ dak-u̱ Kan'ana u̱t-be̱e̱t, wa hate̱ m-ra du̱gu̱-du̱ hu̱no̱ wa Yakubu. <verse eid="GEN 36:6"/><verse number="7" style="v" sid="GEN 36:7"/>Remu̱ tat-u̱ bisa-u̱t u̱n, za u̱t-no̱me̱ u̱n shu̱'u̱t u̱r-be u̱r-gan da, be-du̱ u̱n o̱tte̱ u̱ shu̱'u̱t de̱ zaar u̱ ko̱ru̱ u̱n be̱e̱t da. <verse eid="GEN 36:7"/><verse number="8" style="v" sid="GEN 36:8"/>Isuwa (wu̱ na zu̱ye̱ Edo̱m) shu̱'u̱t u̱ gas-u̱ ro̱r-tu̱ dak-u̱ Seyir.<verse eid="GEN 36:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9"/>Unto̱ o̱o̱ge̱ ogu̱r-tu̱ ya'ag-u̱ Isuwa, ne̱t-u̱ Edo̱m, wu̱ o̱o̱ge̱ u̱ shu̱'u̱t u̱ gas-u̱ ro̱r-tu̱ dak-u̱ Seyir.<verse eid="GEN 36:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="GEN 36:10"/>Dim-tu̱ ya'ag-u̱ campa-ne̱ Isuwa ya:</para>
  <para style="li2" vid="GEN 36:10">E̱ripaz (wa'-u̱ Ada ne̱ta Isuwa) u̱ Re̱we̱r (wa'-u̱ Basemat ne̱ta Isuwa).<verse eid="GEN 36:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="GEN 36:11"/>Yaag-u̱ campa-ne̱ E̱ripaz:</para>
  <para style="li2" vid="GEN 36:11">Te̱man, u̱ O̱mar, u̱ Ze̱paho, u̱ Gatama, u̱ Kenaz.<verse eid="GEN 36:11"/></para>
  <para style="li2">
    <verse number="12" style="v" sid="GEN 36:12"/>Eripaz o̱tte̱ ne̱ta u̱r-kit wu̱ na foge̱ Timu̱na. Wa mate̱ Amare̱k wu̱ o̱o̱ge̱ ne̱ta u̱s-kit E̱ripaz. E̱ o̱o̱ge̱ ya'ag-u̱ ya'ag-u̱ campa-ne̱ i ne̱ta Isuwa Ada.<verse eid="GEN 36:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 36:13"/>Yaag-u̱ campa-ne̱ Re̱we̱r:</para>
  <para style="li2" vid="GEN 36:13">Nahat, u̱ Zera, u̱ Shamma, u̱ Miza. Ine̱ e̱ o̱ ya'ag-u̱ ya'ag-u̱ ne̱ta Isuwa Basemat.<verse eid="GEN 36:13"/></para>
  <para style="li4">
    <verse number="14" style="v" sid="GEN 36:14"/>Yaag-u̱ campa-ne̱ ne̱ta Isuwa O̱ho̱ribama gwu̱p-u̱ Ana tu̱msu̱ wa'-u̱ wa'-u̱ Zibe̱yon, e̱ wa mate̱ Isuwa:</para>
  <para style="li2" vid="GEN 36:14">Jewus, u̱ Jaram, u̱ Kora ne̱.<verse eid="GEN 36:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15"/>Ine̱ e̱ o̱o̱ge̱ u̱t-faru̱k u̱ te̱k-u̱ ya'ag-u̱ Isuwa wu̱ shu̱'u̱te̱ yu̱-Yat-ya u̱t-ko̱ u-tát.</para>
  <para style="li1" vid="GEN 36:15">Yaag-u̱ campa-ne̱ E̱ripaz mat-du̱ u-shu̱ Isuwa,</para>
  <para style="li2" vid="GEN 36:15">Wa shu̱'u̱te̱ yu̱-Yat-ya ko̱-u̱r Te̱man, O̱mar, Ze̱paho, Kenaz, <verse eid="GEN 36:15"/><verse number="16" style="v" sid="GEN 36:16"/>u̱ Kora, u̱ Gatama, u̱ Amare̱k ne̱. Ine̱ e̱ o̱o̱ge̱ i-yate̱ u̱r-ko̱ dak-u̱ Edo̱m wu̱ rwu̱ne̱ du̱gu̱ E̱ripaz. Ine̱ be̱e̱t e̱ o̱o̱ge̱ ya'ag-u̱ ya'ag-u̱ Ada.<verse eid="GEN 36:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="GEN 36:17"/>Yaag-u̱ campa-ne̱ wa'-u̱ Isuwa Re̱we̱r:</para>
  <para style="li2" vid="GEN 36:17">Nahat, u̱ Zera, u̱ Shamma, u̱ Miza ne̱. Ine̱ i-yate̱ ko̱du̱ rwu̱ne̱ du̱gu̱ Re̱we̱r Edo̱m; e̱ o̱o̱ge̱ ko̱-du̱ ya'ag-u̱ ne̱ta Isuwa Basemat.<verse eid="GEN 36:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="GEN 36:18"/>Yaag-u̱ campa-ne̱ ne̱ta Isuwa Ohoribama:</para>
  <para style="li2" vid="GEN 36:18">Yu̱-Yat-ya Jewus, u̱ Jaram, u̱ Kora ne̱. E̱ o̱o̱ge̱ i-yate̱ i rwu̱ne̱ du̱gu̱ ne̱ta Isuwa O̱ho̱ribama gwu̱p-u̱ Ana.<verse eid="GEN 36:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 36:19"/>Ine̱ o̱ ya'ag-u̱ campa-ne̱ Isuwa (wu̱ na zu̱ Edo̱m), tu̱msu̱ tunto̱ o̱ faru̱k-u̱t e̱.<verse eid="GEN 36:19"/></para>
  <para style="s1">Yaag-u̱ Seyir</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20"/>Tunto̱ o̱ dim-tu̱ u̱t-ko̱ tu̱ ya'ag-u̱ campa-ne̱ i rwu̱ne̱ du̱gu̱-du̱ Seyir ya-Ho̱ri-ne̱, e̱ o̱ u̱ shu̱'u̱t u̱ dak-u̱ Edo̱m:</para>
  <para style="li2" vid="GEN 36:20">Ro̱tan, Shobar Zibe̱yon, Ana, <verse eid="GEN 36:20"/><verse number="21" style="v" sid="GEN 36:21"/>Dishon, Ezer, u̱ Dishan. Ine̱ o̱ i-yate̱ ko̱-du̱ ya'ag-u̱ campa-ne̱ Hori, ya'ag-u̱ Seyir, e̱ o̱ shu̱'u̱t u̱ dak-u̱ Edo̱m.<verse eid="GEN 36:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="GEN 36:22"/>Yaag-u̱ campa-ne̱ Ro̱tan e̱ o̱: Hori u̱ Heman, hu̱no̱-u ya-i ne̱ta Ro̱tan wa na zu̱ye̱ Timna.<verse eid="GEN 36:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 36:23"/>Yaag-u̱ campa-ne̱ Shobar:</para>
  <para style="li2" vid="GEN 36:23">Arban, Manahat, Ebar, Shepaho, u̱ Onam ne̱.<verse eid="GEN 36:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 36:24"/>Yaag-u̱ campa-ne̱ Zibe̱yon e̱ o̱:</para>
  <para style="li2" vid="GEN 36:24">Aya u̱ Ana. A-na wu̱ hyane̱ fu̱g-su̱ m-pe̱r yu̱ bu̱-mu̱ m-du̱ng u̱r-do̱g da-u̱ wa o̱o̱ge̱ u̱ gwat-du̱ janka u̱so wa.<verse eid="GEN 36:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 36:25"/>Ana o̱tte̱ yaag yu̱r:</para>
  <para style="li2" vid="GEN 36:25">Ya-du̱ u̱r-campa na zu̱ wa Dishon tu̱msu̱ ya-du̱ u̱r-gwu̱p na zu̱ wa O̱ho̱ribama.<verse eid="GEN 36:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 36:26"/>Yaag-u̱ campa-ne̱ Dishon e̱ o̱:</para>
  <para style="li1" vid="GEN 36:26">Hemadan, Eshaban, Itaran, u̱ Keran.<verse eid="GEN 36:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="GEN 36:27"/>Yaag-u̱ campa-ne̱ Ezer e̱ o̱:</para>
  <para style="li2" vid="GEN 36:27">Birhan, Zaaban, u̱ Akan ne̱.<verse eid="GEN 36:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="GEN 36:28"/>Yaag-u̱ campa-ne̱ Dishan e̱ o̱:</para>
  <para style="li2" vid="GEN 36:28">Uz u̱ Aran ne̱.<verse eid="GEN 36:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="GEN 36:29"/>Ine̱ e̱ o̱ i-yate̱ ko̱-du̱ Hori:</para>
  <para style="li2" vid="GEN 36:29">Ro̱tan, Shobar, Zibe̱yon, Ana, <verse eid="GEN 36:29"/><verse number="30" style="v" sid="GEN 36:30"/>Dishon, Ezer, u̱ Dishan. Na panu̱g dim-tu̱ ko̱-u̱r Hori u̱ dim-tu̱ i-yate̱ ne̱, e̱ o̱ u̱ shu̱'u̱t u̱ dak-u Seyir.<verse eid="GEN 36:30"/></para>
  <para style="s1">Faru̱k-tu̱ Edo̱m</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31"/>Tunto̱ o̱ dim-tu̱ u̱t-faru̱k tu̱ o̱o̱ge̱ u̱r-faru̱k u̱ dak-u̱ Edo̱m kanda waku̱n faru̱k wa no̱m u̱r-faru̱k dak-u̱ Isra:<verse eid="GEN 36:31"/></para>
  <para style="li2">
    <verse number="32" style="v" sid="GEN 36:32"/>Bera (zwaru̱ Beyor), wa shu̱'u̱t faru̱k-du̱ Edo̱m. Dim-du̱ bo̱-u na zu̱ye̱ Dinahaba.<verse eid="GEN 36:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="GEN 36:33"/>Da-u̱ Bera mare̱, Jobab zwaru̱ Zera du̱gu̱ Bozara, wa shu̱'u̱t u̱r-faru̱k.<verse eid="GEN 36:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="GEN 36:34"/>Da-u̱ Jobab mare̱, Husan du̱gu̱ dak-u̱ Tema-ne̱ wa du̱u̱s u̱r-faru̱k.<verse eid="GEN 36:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="GEN 36:35"/>Da-u̱ Husan mare̱, Hadad zwaru̱ Bedad wu̱ re̱ bo̱-u̱ Midiya dak-u̱ Mowab, wa re̱ u̱r-faru̱k. Dim-du̱ bo̱-u wa o̱ na zu̱ye̱ Afit.<verse eid="GEN 36:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="GEN 36:36"/>Da-u̱ Hadad mare̱, Samara wu̱ rwu̱ne̱ du̱gu̱ bo̱-u̱ Masare̱ka wa shu̱'u̱t faru̱k.<verse eid="GEN 36:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="GEN 36:37"/>Da-u̱ Samara mare̱, Shawuru wu̱ rwu̱ne̱ du̱gu̱ bo̱-u̱ Rehobot u̱ Gas-u̱ gi-yu̱ Yufiretis wa shu̱'u̱t faru̱k.<verse eid="GEN 36:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="GEN 36:38"/>Da-u̱ Shawuru mare̱, Baar-hanan (zwaru̱ Akubor) wa du̱u̱s u̱r-faru̱k.<verse eid="GEN 36:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="GEN 36:39"/>Ba Baar-hanan zwaru̱ Akubor mare̱, Hadar shu̱'u̱t faru̱k, dim-du̱ bo̱-u wa na zu̱ye̱ Pawa. Dim-du̱ ne̱ta wu̱n de̱ na zu̱ye̱ Mehetaber gwu̱p-u̱ Matad, gwu̱p-u̱ Mezahab.<verse eid="GEN 36:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 36:40"/>Tun-to̱ to̱ o̱ dim-tu̱ i-yate̱ i rwu̱ne̱ du̱gu̱-du̱ Isuwa, i o̱o̱ge̱ u̱ shu̱'u̱t u̱t-be e̱ te̱'e̱ u̱ka ko̱-u̱t e̱:</para>
  <para style="li2" vid="GEN 36:40">Timna, Arba, Jetet, <verse eid="GEN 36:40"/><verse number="41" style="v" sid="GEN 36:41"/>Ohoribama, Era, Pinon, <verse eid="GEN 36:41"/><verse number="42" style="v" sid="GEN 36:42"/>Ke̱naz, Te̱man, Mibazar, <verse eid="GEN 36:42"/><verse number="43" style="v" sid="GEN 36:43"/>Magadiyer u̱ Iram ne̱.</para>
  <para style="p" vid="GEN 36:43">E̱ o̱o̱ge̱ i-yate̱ Edo̱m, u̱ e̱ o̱tte̱ u̱ shu̱'u̱t u̱ dak-u̱ e̱ o̱tte̱.</para>
  <para style="p" vid="GEN 36:43">Isuwa o̱o̱ge̱ u̱so u̱ Edo̱m-ne̱.<verse eid="GEN 36:43"/></para>
  <chapter eid="GEN 36"/>
  <chapter number="37" style="c" sid="GEN 37"/>
  <para style="s1">Yusuhu no̱ng bo'</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1"/>Yakubu shu̱'u̱t u̱ dak-u̱ Kan'ana, be-du̱ u̱so wa tamte̱ shu̱'u̱t-du̱ u̱r-hamu̱t.<verse eid="GEN 37:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 37:2"/>Ogor-tu̱ ya'ag-u̱ Yakubu ya:</para>
  <para style="p" vid="GEN 37:2">Da-u̱ Yusuhu o̱o̱ge̱ u̱s-hak o̱p u̱s-ta'e̱r [17], wa o̱ u̱ gwat-du̱ ban-du̱ u̱t-bisa u̱ tu̱-wu̱to̱ wa ne̱, ya'ag-u̱ campa-ne̱ Biru̱ha u̱ ya'ag-u̱ campa-ne̱ Zirpa, ne̱ta-tu̱ u̱so-u wa, se̱ wa haatu̱n u̱so e̱ rem-su̱ za so̱-se̱ u̱ mo̱ttu̱ no̱mu̱ tu̱-wu̱to̱ wa o̱o̱ge̱ u̱t-no̱m.<verse eid="GEN 37:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3"/>Isra cwanu̱g Yusuhu m-ze̱g ya'ag-u̱ campa-ne̱ wa be̱e̱t, remu̱ zu̱ wa matu̱k wa' u̱ da-u̱ ne̱nge̱n-u̱r wa. Isra no̱mu̱ Yusuhu to̱ggo̱-u so̱-ya. <verse eid="GEN 37:3"/><verse number="4" style="v" sid="GEN 37:4"/>Da-u̱ tu̱-wu̱to̱ wa hyane̱ u̱zu̱ u̱so-u e̱ ze̱k-u̱ cwan-u̱t wu̱n, e̱ gu̱gu̱m wu̱n. E̱ no̱mtu̱ wu̱n rem-u̱s so̱-se̱ da.<verse eid="GEN 37:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5"/>Yusuhu nom bo' da-u̱ wa ware̱ tu̱-wu̱to̱ wa ne̱ bo'u̱ wa no̱me̱, e̱ sur m-gu̱gu̱m wa. <verse eid="GEN 37:5"/><verse number="6" style="v" sid="GEN 37:6"/>Wa zu̱ u̱n &lt;&lt;Ho̱go̱n bo'u̱ u̱m no̱me̱. <verse eid="GEN 37:6"/><verse number="7" style="v" sid="GEN 37:7"/>Da-u̱ in o̱o̱ge̱ u̱ gu̱gu̱r-du̱ gu̱g-tu̱ fat u-tak se̱ du̱ ri gu̱g-de̱ yu̱ne̱ u̱r-ees m-kim, da-u o̱ tu̱ no̱ gu̱g-to̱ haane̱ to̱ gu̱nu̱s du̱ ri gu̱g-de̱ to̱ kwu̱ku̱t u-dak.&gt;&gt;<verse eid="GEN 37:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8"/>Tu̱-wu̱to̱ wu̱n zu̱ wu̱n, &lt;&lt;¿Bo̱ u̱t-sa bo̱ shu̱'u̱t faru̱k u̱-do̱mu̱ it? ¿Bo̱ u̱t-gwat u̱zu̱ bo̱ u̱t-shu̱'u̱t faru̱k-u̱ it?&gt;&gt; Se̱ e̱ sur m-gu̱gu̱m wu̱n remu̱ bo'u̱ wa no̱me̱ u̱ no̱m-u̱ wa waru̱ e̱ ne̱.<verse eid="GEN 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9"/>Da tase̱ sur m-no̱m o̱ko̱n bo' o̱. Wa waru̱ tu̱-wu̱to̱ bo'-u̱ o̱, wa zu̱, &lt;&lt;Ho̱go̱n, u̱m swu̱ru̱g m-no̱m o̱ko̱n bo' o̱, se̱di u̱ uno̱ da-o̱, u̱r-ho̱, u̱ pyaat ne̱, u̱ re̱ge̱r ne̱ o̱p-u̱ yu̱r e̱ he u̱t-jwu̱n u̱ shu̱ ri.&gt;&gt;<verse eid="GEN 37:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10"/>Uno̱ da-o̱ wu̱n wargu̱ u̱so rò bó̱-u̱ o̱ u̱ka wa wartu̱ o̱r-u̱t wa ne̱, se̱ u̱so wu̱n hagu̱sse̱ wu̱n. Wa zu̱ wu̱n, &lt;&lt;¿Bo̱ m-hyan u̱zu̱ ino̱ ró u̱-me̱ ne̱ u̱ tu̱-wu̱to̱ ró ne̱ it-u̱ u̱t-haan it he̱ u̱t-jwu̱n u-dak u̱-shu̱ ró?&gt;&gt; <verse eid="GEN 37:10"/><verse number="11" style="v" sid="GEN 37:11"/>Se̱di tu̱-wu̱to̱ Yusuhu o̱ u̱r-shu̱b, u̱so wu̱n hu̱ u̱s-dorog u̱zu̱, yan-o̱ bo'u̱ no̱ o̱o̱ge̱ u̱t-zu̱.<verse eid="GEN 37:11"/></para>
  <para style="s1">Tu̱-wu̱to̱ Yusuhu <optbreak/> bu̱pu̱ste̱ wa</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12"/>De̱ku̱n ho̱-de̱ o̱r-u̱t wu̱n o̱ u̱ gwat-du̱ ban-du̱ u̱t-bisa tu̱ u̱so e̱ u̱ She̱ke̱m. <verse eid="GEN 37:12"/><verse number="13" style="v" sid="GEN 37:13"/>Isra zu̱ Yusuhu, &lt;&lt;U̱ka bo̱ nu̱pte̱, tu̱-wu̱to̱ ró o̱ u̱ gwat-du̱ u̱t-bisa u̱ dapu̱s She̱ke̱m. Zo̱nge̱ u̱m to̱m bo̱ u̱du̱ e̱.&gt;&gt;</para>
  <para style="p" vid="GEN 37:13">Wa zu̱ wu̱n, &lt;&lt;U̱m zo̱ngte̱.&gt;&gt;<verse eid="GEN 37:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14"/>Se̱ u̱so u̱n zu̱ wu̱n, &lt;&lt;De̱'e̱, bo̱ hyan tu̱-wu̱to̱ ró ne̱ u̱ ban-du̱ u̱t-bisa ne̱ u̱ka e̱ o̱tte̱, se̱ bo̱ mu̱n bo̱ waru̱ me̱ u̱ka e̱ o̱tte̱.&gt;&gt; Yakubu tom Yusuhu du̱gu̱ fu̱g-yu̱ He̱bro̱n m-ha Gas-u̱ She̱ke̱m.</para>
  <para style="p" vid="GEN 37:14">Da-u̱ Yusuhu teye̱ bo̱-u̱ She̱ke̱m, <verse eid="GEN 37:14"/><verse number="15" style="v" sid="GEN 37:15"/>waku̱n ne̱t wa hyen wu̱n u̱t-riig u̱r-do̱g wa shit wu̱n, wa zu̱ wu̱n, &lt;&lt;¿Yan-o̱ bo̱ o̱o̱ge̱ u̱t-goot?&gt;&gt;<verse eid="GEN 37:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16"/>Yusuhu zu̱, &lt;&lt;U̱m o̱ gotu̱ tu̱-wu̱to̱ ri ne̱. Gag jab, ¿ko̱ bo̱ waru̱ me̱ be-du̱ e̱ o̱tte̱ u̱ gwat-du̱ u̱t-bisa?&gt;&gt;<verse eid="GEN 37:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17"/>Se̱ ne̱t-u̱ wa zu̱ wu̱n, &lt;&lt;U̱, u̱n yu̱nge̱ du̱gu̱ ane̱, se̱di u̱m ho̱k u̱n o̱ u̱t-zu̱, &lt;Yage̱ in de̱'e u̱ gas-u̱ Dotan.&gt; &gt;&gt;</para>
  <para style="p" vid="GEN 37:17">Se̱ Yusuhu dor o̱r-u̱t wa ne̱ m-ha Dotan, wa bit u̱n u̱ku̱n u̱ Dotan.<verse eid="GEN 37:17"/></para>
  <para style="s1">Na bu̱pu̱ste̱ Yusuhu m-to̱k</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 37:18"/>Da-u̱ o̱r-u̱t Yusuhu hyanne̱ wa u̱ daan, e̱ nu̱p wa du̱gu̱ m-ra. Da-u̱ wa no̱mne̱ u̱t-mo̱r u̱ u̱n ne̱, u̱n gu̱g nu-u̱t u̱n u̱zu̱ u̱n ho̱ Yusuhu. <verse eid="GEN 37:18"/><verse number="19" style="v" sid="GEN 37:19"/>U̱n zu̱ o̱r-u̱t u̱n ne̱, &lt;&lt;Wa-bo'-u̱ wa ya jit u̱ o̱ne̱. <verse eid="GEN 37:19"/><verse number="20" style="v" sid="GEN 37:20"/>Haanu̱n, yagu̱n in ho̱o̱n wu̱n na guns wu̱n u̱ me̱n-tu̱ u̱r-gan u̱-me̱ du̱-u̱t tun-to̱ se̱ na zu̱ no̱m-yu̱ u̱r-do̱g hooste̱ wu̱n. Na hyan ma-du̱ bo'-u̱ wu̱n u̱ka o̱ do̱te̱ u̱t-no̱m!&gt;&gt;<verse eid="GEN 37:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21"/>Da-u̱ Rube̱n ho̱ge̱ no̱m-u̱ u̱n o̱ u̱t-sa u̱t-no̱m, wa su̱ wa ruut wu̱n du̱gu̱ kom-u̱t u̱n, Rube̱n zu̱ u̱n, &lt;&lt;Ana ho̱ wu̱n da. <verse eid="GEN 37:21"/><verse number="22" style="v" sid="GEN 37:22"/>Ana agu̱z m-hyu̱ da. Gunsu̱n wu̱n u̱ me̱n-tu̱ ut-u̱r u̱r-dù u̱ ane̱ u̱-me u̱r-do̱g, se̱di taas u̱ waku̱n o̱ m-tam wu̱n da.&gt;&gt; Rube̱n zu̱u̱g iya remu̱ u̱zu̱ wa ruut te̱ wu̱n m-yasa du̱gu̱-du̱ e̱ u̱ wa muut wu̱n u̱du̱ u̱so wu̱n.<verse eid="GEN 37:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 37:23"/>Da-u̱ Yusuhu teene̱ be-du̱ o̱r-u̱t wa ne̱ o̱tte̱, se̱ e̱ kemu̱sse̱ to̱ggo̱-u so̱-ya yu̱ wu̱n o̱tte̱ m-wa e̱ host ya. <verse eid="GEN 37:23"/><verse number="24" style="v" sid="GEN 37:24"/>Se̱ u̱n ku̱b wa, u̱n guns wa u̱ me̱n-tu̱ u̱r-dù du̱ zatte̱ m-bu̱ da, bu̱-mu̱ zaar de̱ da.<verse eid="GEN 37:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25"/>U̱n o̱ u̱ shu̱'u̱t u̱ re̱-du̱ no̱m u̱t-re̱, se̱ u̱n jaku̱s is u̱n hyan ban-du̱ Isma'iru-ne̱ a-u-ce̱rpa-ne̱, e̱ o̱o̱n du̱gu̱ Giriyad. E̱ gakku̱n rakum-u̱ e̱ cwu̱-tu̱ wu̱s u-haku̱n ne̱ u̱t-go̱ u̱t-go̱, u̱ no̱o̱g-mu̱ mu̱r ne̱, e̱ o̱ do̱m-u̱ u-fu̱n u̱ hu̱u̱tu̱ to̱ u̱ Masar u̱t-bab.<verse eid="GEN 37:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 37:26"/>Yahuda zu̱ hu̱no̱-u̱t wa, &lt;&lt;¿Yan swu̱rmo̱ in do̱'e̱ u̱t-kwu̱m a in ho̱o̱n o̱r-u̱ in tu̱msu̱ in taku̱s hyu̱-m wa? <verse eid="GEN 37:26"/><verse number="27" style="v" sid="GEN 37:27"/>Haanu̱n, in bu̱pu̱s wu̱n u̱du̱ ne̱t-u̱ Isma'iru-ne̱. A in o̱ m-tam wu̱n da, ba shu̱'u̱te̱ o̱r-u̱ in wa u o̱ye̱. War-u in o̱ u̱ hyu̱-m in ne̱.&gt;&gt; O̱r-u̱t wu̱n ees u̱ no̱mu̱ wu̱n waru̱ e̱ ne̱.<verse eid="GEN 37:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 37:28"/>Da-u̱ ne̱tu̱ u-ce̱rpa tu̱ Midiya-ne̱ ne̱ haane̱, tu̱-wu̱to̱ Yusuhu rwu̱tu̱n wa du̱gu̱ ut-u̱ u̱r-dù. E̱ bu̱pu̱s wa u̱du̱ ne̱t-u̱t to̱ kwam-u̱t pus-to̱ shik u̱r-shik [20], na ku̱b wa m-cwa u̱ Masar.<verse eid="GEN 37:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29"/>Da-u̱ Rube̱n barme̱ u̱ be-du̱ du-u̱r re̱ wa hyanu̱g Yusuhu da, se̱ wa kemu̱sse̱ cwu̱-tu̱ u-war u̱ wa u̱ remu̱ namu̱ jab. <verse eid="GEN 37:29"/><verse number="30" style="v" sid="GEN 37:30"/>Wa aru̱k m-mu̱ u̱du̱ o̱r-u̱t wa ne̱ wa zu̱ e̱, &lt;&lt;Wa'-u̱ wa zamu̱n u̱ku̱n da, u̱ da-o̱ ¿re̱-o̱ u̱m do̱te̱ u̱t-no̱m?&gt;&gt;<verse eid="GEN 37:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31"/>Se̱ o̱r-u̱t Yusuhu ho gobor-du̱ u-gwaar, e̱ guns to̱ggo̱-u Yusuhu hyu̱-mu̱ u-gwaru̱ mo̱. <verse eid="GEN 37:31"/><verse number="32" style="v" sid="GEN 37:32"/>U̱n ku̱b to̱ggo̱-u so̱-ya ya u̱n muutu̱ u̱so u̱n tu̱msu̱ u̱n zu̱, &lt;&lt;It kwu̱mu̱g to̱ggo̱-u inya. Gwat bo̱ hyan ko̱ to̱ggo̱-yu̱ zwaru̱ ró ya re̱.&gt;&gt;<verse eid="GEN 37:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33"/>Wa nu̱p ya. Wa zu̱, &lt;&lt;To̱ggo̱-yu̱ zwaru̱ ri ya, yaku̱n no̱m-yu̱ u̱r-do̱g tu̱u̱ste̱ wa, za u-sakna na tu̱u̱ste̱ Yusuhu.&gt;&gt;<verse eid="GEN 37:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 37:34"/>Yakubu kemu̱sse̱ to̱ggo̱-yu̱ u-waru̱ wa. Wa wu̱ cwu̱-tu̱ ko̱se̱-du̱ namu̱ jab wa no̱m m-roog u-tát wa o̱ dorog-u̱s Yusuhu. <verse eid="GEN 37:34"/><verse number="35" style="v" sid="GEN 37:35"/>Yaag-u̱ wa be̱e̱t e̱ haan e̱ ru̱stu̱ wa jab, se̱di e̱ kerge̱ ru̱stu̱ jab-u̱ wa da. Wa zu̱, &lt;&lt;U̱ te̱k-u̱ namu̱ jab se̱, u̱m he̱e̱g u-sag u̱ be-du̱ zwaru̱ ri o̱tte̱.&gt;&gt; Se̱ wa nom u̱s-kan u̱ remu̱ Yusuhu.<verse eid="GEN 37:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36"/>Da tase̱, ne̱t-tu̱ Midiya-ne̱ e̱ bu̱pse̱ Yusuhu u̱du̱ Potipa wu̱ o̱o̱ge̱ u̱ te̱k-u̱ i-yate̱ Faru̱k-u̱ Masar, Po̱tipa wa o̱o̱ge̱ yu̱-Yat-ya e'-du̱ pyu̱.<verse eid="GEN 37:36"/></para>
  <chapter eid="GEN 37"/>
  <chapter number="38" style="c" sid="GEN 38"/>
  <para style="s1">Yahuda e̱ Tamar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1"/>U̱ da-u o̱, Yahuda yage̱ tu̱-wu̱to̱ wa u̱ tu̱-dimu̱ wa ne̱. Wa do̱'e̱ wa shu̱'u̱t u̱du̱ waku̱n campa wa wu̱ bo̱-u̱ Aduram na zu̱ wa Hira. <verse eid="GEN 38:1"/><verse number="2" style="v" sid="GEN 38:2"/>Ku̱na Yahuda hyente̱ gwu̱p ne̱t-u̱ Kan'ana wa'-u̱ Shuwa. Yahuda gu̱ wa wa roog u̱ wa ne̱. <verse eid="GEN 38:2"/><verse number="3" style="v" sid="GEN 38:3"/>Wa no̱m u̱t-me̱n wa mu̱t ya-du̱ u̱r-campa, na te̱'e̱ wa u̱r-dim Er. <verse eid="GEN 38:3"/><verse number="4" style="v" sid="GEN 38:4"/>Wa sur m-no̱m u̱t-me̱n wa mu̱t ya-du̱ u̱r-campa na te̱'e̱ wa u̱r-dim Onan. <verse eid="GEN 38:4"/><verse number="5" style="v" sid="GEN 38:5"/>Wa mu̱t tu̱msu̱ ya-du̱ u̱r-campa wa te̱'e̱ de̱ u̱r-dim Shera. U̱ da-u̱ Yahuda o̱ Kezib da-u o̱ wa matu̱ Shera.<verse eid="GEN 38:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6"/>Yahuda no̱ngu̱ mat-du̱ u-shu̱ wa Er u̱r-gu̱, na zu̱ ne̱ta wa Tamar. <verse eid="GEN 38:6"/><verse number="7" style="v" sid="GEN 38:7"/>Se̱di Er, mat-du̱ u-shu̱ Yahuda, ne̱t-u̱ yo̱-wa wa u̱du̱ Yawe; se̱ Yawe ho wa.<verse eid="GEN 38:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 38:8"/>Se̱ Yahuda zu̱ Onan, &lt;&lt;Rooge̱ u̱ ne̱ta yu̱-wu̱ya ró ne̱, yu̱-wu̱ya ró maru̱g za wa'. Remu̱ iya ga bomsu̱ wa bo̱ roog u̱ wa ne̱ ko̱ bo̱ kwu̱mu̱ yu̱-wu̱ya ró yaag i do̱'e̱ re̱-du̱ o̱g-u̱r wa rem u̱zu̱ iya-o̱ kim-u̱s in zu̱tte̱ bo̱ no̱m.&gt;&gt; <verse eid="GEN 38:8"/><verse number="9" style="v" sid="GEN 38:9"/>Se̱di Onan nu̱p u̱zu̱ ya'ag-u̱ e̱ za shu̱'u̱tu̱ ya'ag-u̱ wa da; da-u̱ wa o̱o̱ge̱ m-roog u̱ ne̱ta yu̱-wu̱ya wa ne̱, se̱ wa daas u̱t-bas u-dak u̱ taas wa matu̱ yu̱-wu̱ya wa yaag da. <verse eid="GEN 38:9"/><verse number="10" style="v" sid="GEN 38:10"/>Se̱di no̱m-u̱ wa no̱me̱ shu̱'u̱te̱ no̱m-u yo̱-o̱ u̱du̱ Yawe; se̱ wa ku̱b fat-u̱r rò.<verse eid="GEN 38:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 38:11"/>Yahuda zu̱ Tamar ku̱mu̱ wa, &lt;&lt;Shu̱'u̱te̱ u̱ka bom-u̱s u̱ bu-u̱ u̱so-u ró, se̱ Shera zwaru̱ ri rogomte̱.&gt;&gt; Wa no̱ng iya remu̱ zu̱ wa no̱ng u̱s-dorog u̱zu̱, &lt;&lt;Wa kere̱ u̱t-mar ko̱wa, u̱ka tu̱-wu̱to̱ wa.&gt;&gt; Se̱ Tamar aru̱k m-mu̱ wa shu̱'u̱t u̱ bu-u̱ u̱so wa.<verse eid="GEN 38:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12"/>Da-u̱ hak-su̱ no̱me̱ u-tát ne̱ta Yahuda, gwu̱p-u̱ Shuwa, maru̱g. Da-u̱ Yahuda tase̱ namu̱ jab, wa do̱'e̱ u̱ Timna, u̱du̱ ne̱t-tu̱ o̱o̱ge̱ o̱rru̱ can-tu̱ ca wa, u̱ hu̱u̱b-u̱ wu̱n ne̱ Hira ne̱tu̱ Aduram wa do̱'e̱ u̱ wu̱n ne̱.<verse eid="GEN 38:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 38:13"/>Da-u̱ na waru̱ Tamar, &lt;&lt;U̱zu̱ u̱so-u campa rò u̱ fu̱n-yu̱ ha-mu̱ Timna u̱ remu̱ wa or-u̱t ca wa.&gt;&gt; <verse eid="GEN 38:13"/><verse number="14" style="v" sid="GEN 38:14"/>Tamar nak u̱zu̱ Shera rogomte̱, se̱di o̱kon no̱mo̱ zaar u̱ na nome̱ u̱zu̱ u̱ wa haan wa ga wa da. Remu̱ iya wa host cwu̱-tu̱ u̱t-bomos wa ho̱bo̱gse̱ hi-u̱r wa u-ge̱re̱ remu̱ wa e̱ngu̱sse̱ hi-u̱r wa. Se̱ Tamar shu̱'u̱t u̱ kit u-fu̱n yu̱ na tote̱ me̱ bo̱-u re̱k-o̱ u̱ na zu̱ye̱ Enayim, yu̱ o̱o̱ge̱ do̱m-u̱ fu̱n-yu̱ ha-mu̱ Timna.<verse eid="GEN 38:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15"/>Da-u̱ Yahuda hyane̱ wu̱n, wa ku̱b u̱zu̱ wa-u-as wa, remu̱ u̱zu̱ wa ho̱gopte̱ shu̱-u wa u-ge̱re̱. <verse eid="GEN 38:15"/><verse number="16" style="v" sid="GEN 38:16"/>Wa nak u̱zu̱ ku̱mu̱ wa da, wa do̱'e̱ u̱du̱ wa u̱ kit-u̱ fu̱n. Wa zu̱, &lt;&lt;Haane̱ u̱m roog-u̱ bo̱ ne̱.&gt;&gt;</para>
  <para style="p" vid="GEN 38:16">Se̱ Tamar zu̱, &lt;&lt;¿Yan o̱ bo̱ de̱ ya'u̱ me̱ u̱ bo̱ roogte̱ u̱-me̱ ne̱?&gt;&gt;<verse eid="GEN 38:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17"/>Se̱ wa zu̱, &lt;&lt;Me̱ ya'u̱ bo̱ ya-u gwaar ban-du̱ gwaar-u̱ ri.&gt;&gt;</para>
  <para style="p" vid="GEN 38:17">Tamar zu̱, &lt;&lt;¿O̱ko̱n o̱ro u̱ bo̱ do̱'e̱ ya'u̱ me̱ u̱ do̱'e̱ u̱t-shu̱'u̱t u̱s-nap kanda bo̱ to̱mtu̱n me̱ u-gwaar?&gt;&gt;<verse eid="GEN 38:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18"/>Wa zu̱, &lt;&lt;¿Yan go̱-du̱ u̱s-nap se̱ bo̱ u̱t-sa?&gt;&gt;</para>
  <para style="p" vid="GEN 38:18">Tamar zu̱ wu̱n, &lt;&lt;Hatu̱n me̱ ko̱m-yu̱ m-ha ró, u-re̱ge̱z yu̱ ge̱ke̱s ne̱ u̱ kwat-yu̱ u-kom u̱ ró ne̱ yu̱ o̱tte̱ dim-u̱r ró ne̱.&gt;&gt; Se̱ wa yase̱ to̱ u̱du̱ wu̱n. Se̱ Yahuda roog u̱ wu̱n ne̱, se̱ Tamar nom u̱t-me̱n du̱gu̱-du̱ wu̱n. <verse eid="GEN 38:18"/><verse number="19" style="v" sid="GEN 38:19"/>Da u̱n tase̱, Tamar yu̱ne̱ m-mu̱, wa hast ge̱rre̱-yu̱ wa ho̱pse̱, se̱ wa wu̱ cwu̱-tu̱ u̱t-bomos wa.<verse eid="GEN 38:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20"/>Da tase̱ Yahuda tom hu̱u̱b-u̱ wa Hira ne̱tu̱ Aduram u̱ ya-u gwaar ne̱, u̱ remu̱ wa kabtu̱n no̱m-tu̱ wa yase̱ ne̱ta-u ya, se̱di Hira hyanu̱g Tamar da. <verse eid="GEN 38:20"/><verse number="21" style="v" sid="GEN 38:21"/>Se̱ wa shit campa-ne̱ i o̱o̱ge̱ u̱ku̱n, wa zu̱, &lt;&lt;¿He̱ne̱ o̱ kaar-yu̱ be-du̱ m-gir yu̱ o̱o̱ge̱ u̱ ana o̱tte̱, kaar-yu̱ nome̱ u̱t-huuk u̱ Enayim u̱ kit u-fu̱n?&gt;&gt;</para>
  <para style="p" vid="GEN 38:21">E̱ zu̱ wu̱n, &lt;&lt;Yaku̱n kaar ya yu̱ be-du̱ m-gir zaar u̱ shu̱'u̱t u̱ ane̱ da.&gt;&gt;<verse eid="GEN 38:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22"/>Se̱ wa mu u̱du̱ Yahuda, wa zu̱, &lt;&lt;U̱m hyanu̱g wu̱n da. Ne̱t-tu̱ o̱ u̱ku̱n e̱ zu̱u̱g, &lt;E̱ tamu̱g nap-du̱ u-kaar o̱ u̱ku̱n u̱ be-du̱ m-gir da.&gt; &gt;&gt;<verse eid="GEN 38:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23"/>Yahuda zu̱, &lt;&lt;Yage̱ wa shipu̱s no̱m-tu̱ wa o̱tte̱, taas in shu̱'u̱t no̱mtu̱ u̱t-nu̱mu̱s da. Me̱ ya u̱m tom-u̱t te̱ wu̱n ya-u gwaar yu̱ o̱ yu̱nne̱, se̱di bo̱ hyanu̱g wu̱n da.&gt;&gt;<verse eid="GEN 38:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24"/>Da pyaat-su̱ u̱s-tu̱t arke̱, na waru̱ Yahuda, &lt;&lt;Ku̱mu̱ ró Tamar cwaag u̱ fu̱n-yu̱ m-kaar, u̱ remu̱ iya wa o̱ u̱t-me̱n ne̱.&gt;&gt;</para>
  <para style="p" vid="GEN 38:24">Yahuda zu̱, &lt;&lt;Rwu̱tu̱n wu̱n u̱ dim-u u-bo̱, no̱ doos wu̱n u-ra se̱ wa maru̱g.&gt;&gt;<verse eid="GEN 38:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25"/>Da-u̱ na rwu̱tu̱n Tamar u̱ remu̱ na hoot wa, se̱ wa no̱m to̱m u̱du̱ ku̱mu̱wa u̱zu̱, &lt;&lt;Se̱ wa zu̱ u̱m o̱ u̱t-me̱n ne̱ du̱gu̱-du̱ ne̱t wu̱ o̱tte̱ tun-to̱ no̱m-to̱. Gwatu̱n to̱ no hyan ko̱ wana otte̱ to̱. Ko̱m-yu̱ m-ha wa ya u̱ kwat-yu̱ u-kom u̱ wa ne̱ u̱ re̱ge̱z yu̱ ge̱ku̱s wa ne̱.&gt;&gt;<verse eid="GEN 38:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26"/>Se̱ Yahuda baku̱s no̱m-u̱t to̱. Wa zu̱ iya o̱ &lt;&lt;Wu̱n ze̱k me̱ u̱r-mo̱t, remu̱ zu̱ u̱m yaag wu̱n wa'-u̱ ri Shera wa ga wu̱n da. U̱m no̱m-u̱g no̱mu so̱-o̱ da.&gt;&gt; Wa swu̱ru̱g m-roog u̱ wu̱n ne̱ tu̱msu̱ da.<verse eid="GEN 38:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27"/>Da da-u̱ u̱r-mat no̱me̱, se̱ Tamar mu̱t ya-u̱t-zwar yu̱r. <verse eid="GEN 38:27"/><verse number="28" style="v" sid="GEN 38:28"/>Da-u̱ wa o̱o̱ge̱ u̱r-mat, wa-gan rwu̱tu̱n ko̱m-u wa u̱-do̱; Se̱ wu̱ o̱o̱ge̱ u̱ mastu̱ wu̱n wa ku̱b u-randi wa gagu̱ wa u̱r-kwaz-du̱ u-kom. Wa zu̱, &lt;&lt;Unwa wa ba-e̱ m-rwu̱u̱n.&gt;&gt; <verse eid="GEN 38:28"/><verse number="29" style="v" sid="GEN 38:29"/>Se̱di da-u̱ wa haste̱ ko̱mu wa, oru̱ wa bu̱ m-rwu̱u̱n. Wa mastu̱ wu̱n zu̱, &lt;&lt;Gwat u̱ka bo̱ mo̱rtu̱n m-yat iya!&gt;&gt; Se̱ wa te̱'e̱ wa u̱r-dim Pe̱re̱z. <verse eid="GEN 38:29"/><verse number="30" style="v" sid="GEN 38:30"/>Du̱-dim rwu̱u̱n u̱ randi-u jaz-ya ne̱ m-gag u̱ kom-u wa, na zu̱ wa Ze̱ra.<verse eid="GEN 38:30"/></para>
  <chapter eid="GEN 38"/>
  <chapter number="39" style="c" sid="GEN 39"/>
  <para style="s1">Yusuhu u̱ ne̱ta Potipa ne̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1"/>Da tase̱, ko̱-du̱ Isma'iru-ne̱ e̱ ku̱b Yusuhu m-ha u̱ Masar. Ku̱na Potipa o̱o̱t-u̱n Yusuhu du̱gu̱-du̱ u̱n. Potipa ne̱t-u̱ Masar wa wu̱ o̱o̱ge̱ u̱ te̱k-u̱ i-yate̱ Faru̱k tu̱msu̱ yu̱-Yat-ya yu̱ u̱r-e' wu̱ no̱me̱ e'-du̱ faru̱k.<verse eid="GEN 39:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 39:2"/>Yawe o̱ u̱r-kot u̱ Yusuhu ne̱. Da-u̱ wa o̱o̱ge̱ u̱ shu̱'u̱t u̱ bu-u̱ yu̱-Yat-ya wa ne̱tu̱ Masar, wa shu̱'u̱t wa re̱-du̱ u̱r-ko̱rro̱ u̱ no̱m-u̱ wa o̱ u̱t-no̱m u-be̱e̱t. <verse eid="GEN 39:2"/><verse number="3" style="v" sid="GEN 39:3"/>Potipa hyanu̱g u̱zu̱ Yawe u-Ru̱ o u̱r-koto u̱ Yusuhu ne̱, remu̱ zu̱ wa yaag Yusuhu re̱-du̱ u̱r-ko̱rro̱ u̱ no̱m-u̱ wa o̱ u̱t-no̱m u-be̱e̱t. <verse eid="GEN 39:3"/><verse number="4" style="v" sid="GEN 39:4"/>Yusuhu kum hyu̱-m pus-mo̱ u̱du̱ Potipa wa no̱m u̱r-so̱ u̱ wa ne̱. Wa wu̱ Yusuhu shu̱'u̱t wa-gwat-du̱ bu-u wa u̱ no̱mu̱ wa otte̱ ne̱ u-be̱e̱t. <verse eid="GEN 39:4"/><verse number="5" style="v" sid="GEN 39:5"/>Du̱gu̱ da-u o̱ Potipa wu̱ Yusuhu wa shu̱'u̱t yu̱-Yat-ya bu-u wa u̱ no̱mu̱ wa o̱tte̱ ne̱ u-be̱e̱t, Yawe wa'agu̱ bu-u ne̱t-u̱ Masar Potipa nu-u so̱-o̱ u̱ rem-u Yusuhu. No̱m-tu̱ u-bu wu̱n u̱t-be̱e̱t to̱ hu̱ m-da ho̱n-ho̱n, u̱ no̱m-tu̱ u̱r-to̱mu̱ wu̱n ne̱, u̱ bisa-tu̱ u-bu ne̱ to̱ hu̱ u̱ re̱-u̱ u-shu̱. <verse eid="GEN 39:5"/><verse number="6" style="v" sid="GEN 39:6"/>Potipa yasu̱ gwat-du̱ no̱m-tu̱ wa o̱tte̱ u̱t-be̱e̱t, ko̱-uyan shu̱'u̱t u̱ kom-u̱t Yusuhu. Potipa ruus-u̱ fu̱n-u̱ ko̱-uyan u-be̱e̱t. Ga-du̱ u̱t-re̱ de̱ Potipa do̱te̱ u no̱m-du̱ u̱s-dorog u̱ warre̱.</para>
  <para style="p" vid="GEN 39:6">Yusuhu o̱tte̱ u-ma u-war u̱ so̱-o̱ u zwarru̱ m-hyan u̱ zwarru̱ u-shu̱ ne̱. <verse eid="GEN 39:6"/><verse number="7" style="v" sid="GEN 39:7"/>Remu̱ iya, da o̱ku̱n da-o̱ no̱me̱ ne̱ta Potipa got war-u Yusuhu wa he̱e̱se̱ cwan-u̱t Yusuhu. De̱ku̱n ho̱-de̱ wa zu̱ wa, &lt;&lt;Haane̱ bo̱ roog u̱-me̱ ne̱!&gt;&gt;<verse eid="GEN 39:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 39:8"/>Yusuhu gu̱gu̱m, wa zu̱ ne̱ta yu̱-Yat-ya wa, &lt;&lt;Gwat! U̱so u-bu ri, za wadu̱ jab-u̱ o̱ko̱n u̱ bu-u uno̱ da. No̱m-u̱ wa o̱tte̱ u-be̱e̱t wa ya'aste̱ ko̱-uyan u̱ kom-u̱t ri u̱m ha gwat-du̱ to̱. <verse eid="GEN 39:8"/><verse number="9" style="v" sid="GEN 39:9"/>U-bu ane̱ waku̱n zaar wu̱ ze̱ge̱ me̱ da. Yu̱-Yat-ya ri hooste̱ me̱ o̱ko̱n u̱ ana da se̱ bo̱, u̱ remu̱ zu̱ bo̱ ne̱ta wa bo̱ o̱ye̱. ¿Re̱-o̱ u̱m do̱te̱ u̱ no̱m-du̱ no̱m-u̱t yo̱-to̱ u̱t-ba'as ne̱ u̱ shu̱ u-Ru̱?&gt;&gt; <verse eid="GEN 39:9"/><verse number="10" style="v" sid="GEN 39:10"/>Ne̱ta-u ya re u-shu̱ no̱mu̱ Yusuhu u̱s-rem ko̱-uyan ho̱-de̱, Yusuhu gu̱gu̱m wa roog u̱ wu̱n ne̱, ko wa dapu̱rse̱ wu̱n.<verse eid="GEN 39:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11"/>De̱ku̱n ho̱-de̱ Yusuhu cwaag u-bu remu̱ wa no̱m-u̱t ank-mu̱ u-bu, u̱ te̱k-u̱ to̱k-ne̱ waku̱n zaar u-bu da. <verse eid="GEN 39:11"/><verse number="12" style="v" sid="GEN 39:12"/>Se̱ ne̱ta-u ya shipis to̱ggo̱-u Yusuhu. Wa zu̱, &lt;&lt;Rooge̱ u̱-me̱ ne̱!&gt;&gt; Yusuhu ru m-so̱m u̱-do̱, se̱di wa yage̱ to̱ggo̱-u wa u̱ kom-u̱t wu̱n.<verse eid="GEN 39:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 39:13"/>Da-u̱ wu̱n hyane̱ Yusuhu somo̱g, wa yage̱ kus-tu̱ m-wa u̱ wa u̱du̱ wu̱n wa aru̱k m-so̱m m-rwu̱ u̱-do̱, <verse eid="GEN 39:13"/><verse number="14" style="v" sid="GEN 39:14"/>se̱ ne̱ta-u ya fog to̱k-ne̱ u-bu wa. Wa zu̱ u̱n, &lt;&lt;Gwatu̱n! Campa ri haatu̱n to̱k ne̱tu̱ Ibra-ne̱ u̱ ane̱ wa muute̱ na ragne̱! Wa cwagu̱n u̱ kur-u ri u̱ remu̱ wa no̱mtu̱ me̱ u̱r-ryapu̱k, u̱m nom u̱t-jar m-yat. <verse eid="GEN 39:14"/><verse number="15" style="v" sid="GEN 39:15"/>Da-u̱ wa ho̱ge̱ u̱m no̱ng u̱t-jar, se̱ wa ru u-bu m-so̱m, wa yage̱ to̱ggo̱-yu̱ do̱ u̱ wa u̱du̱ ri.&gt;&gt;<verse eid="GEN 39:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16"/>Wa cin to̱ggo̱-yu̱ u-war u̱ Yusuhu se̱ da-u̱ yu̱-Yat-ya wa mu̱u̱ne̱. <verse eid="GEN 39:16"/><verse number="17" style="v" sid="GEN 39:17"/>Se̱ wu̱n ware̱ campa rò no̱mu̱ no̱me̱, u̱zu̱, &lt;&lt;To̱k-u̱ wa wu̱ bo̱ kabne̱ in du̱gu̱ Ibra-ne̱, wa cwagu̱n u̱-me̱ kur-u ri wa o̱ u̱ssa wa no̱mu̱ me̱ u̱r-ryapu̱k. <verse eid="GEN 39:17"/><verse number="18" style="v" sid="GEN 39:18"/>Tu̱msu̱ da u̱m no̱me̱ u̱t-jar, wa aru̱k m-so̱m. Wa yage̱ to̱ggo̱-yu̱ do̱ wa u̱ kom-u̱t ri, wa som m-rwu̱ u̱-do̱.&gt;&gt;<verse eid="GEN 39:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19"/>Da-u̱ yu̱-Yat-ya Yusuhu ho̱ge̱ no̱mu̱ ne̱ta wa ware̱, u̱zu̱ iya o̱ to̱k-u̱ wa nomte̱ ne̱ta wa, se̱ Potipa no̱m jab so̱k. <verse eid="GEN 39:19"/><verse number="20" style="v" sid="GEN 39:20"/>Se̱ yu̱-Yat-ya Yusuhu hu̱u̱t wa u̱ bu m-to̱k be-du̱ faru̱k cinte̱ i no̱me̱ wa u̱t-ba'as, wa shu̱'u̱t u̱r-kot u̱ to̱k-ne̱.<verse eid="GEN 39:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 39:21"/>Yawe o̱ u̱r-kot u̱ Yusuhu ne̱ u̱ bu-u̱ m-to̱k, wa ko̱se̱ wa u̱t-cwan, wa kum hyu̱-m pusmo̱ u̱du̱ wa e'-du̱ bo̱-u̱ m-to̱k. <verse eid="GEN 39:21"/><verse number="22" style="v" sid="GEN 39:22"/>Yu̱-Yat-ya a e'-du̱ bu-u̱ m-to̱k yasu̱ Yusuhu gwadu̱ a-bu-u̱ m-to̱k, ko̱-uyan o̱ na o̱ u̱t-no̱m Yusuhu wa o̱ yu̱-Yat-ya. <verse eid="GEN 39:22"/><verse number="23" style="v" sid="GEN 39:23"/>Yu̱-Yat-ya a-bu-u̱ m-to̱k yage̱ ko̱-uyan u̱ kom-u̱t Yusuhu. Yawe o̱ u̱r-kot u̱ Yusuhu ne̱, wa yaag wa re̱-du̱ u̱r-ko̱rro̱ u̱ bu-u̱ m-to̱k.<verse eid="GEN 39:23"/></para>
  <chapter eid="GEN 39"/>
  <chapter number="40" style="c" sid="GEN 40"/>
  <para style="s1">Yusuhu wargu̱ a-bu-u̱ m-to̱k ne̱ <optbreak/> yu̱r bo'-su̱ e̱ no̱me̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1"/>Da-u̱ o̱ko̱n da-o̱ arke̱, se̱ to̱k-ne̱ Faru̱k-u̱ Masar yu̱r no̱m no̱m-u̱ nase̱ faru̱k jab. Yu̱-Yat-ya ya-du̱ faru̱k no̱mtu̱ u̱t-swa u̱ yu̱-Yat-ya zwa-u̱ wa u̱r-be̱re̱di ne̱ e̱ be̱e̱t e̱ no̱mu̱ yu̱-Yat-ya e̱ no̱m-u̱ na-su̱ Faru̱k-u̱ Masar jab. <verse eid="GEN 40:1"/><verse number="2" style="v" sid="GEN 40:2"/>Se̱ Faru̱k-u̱ Masar naas jab so̱k u̱ remu̱ i-yate̱ wa ne̱ yu̱r, yu̱-Yat-ya ya-du̱ faru̱k no̱mtu̱ u̱t-swa u̱ yu̱-Yat-ya zwa-u̱ wa u̱r-be̱re̱di ne̱. <verse eid="GEN 40:2"/><verse number="3" style="v" sid="GEN 40:3"/>Wa tage̱ e̱ u̱ bu-u̱ yu̱-Yat-ya a-gwat-du̱ bu-u m-to̱k ne̱ u̱ be-du̱ Yusuhu o̱tte̱ tage̱. <verse eid="GEN 40:3"/><verse number="4" style="v" sid="GEN 40:4"/>Yu̱-Yat-ya a-gwat-du̱ bu-u̱ m-to̱k wu̱' Yusuhu wa shu̱'u̱t wa-gwat-du̱ u̱n.</para>
  <para style="p" vid="GEN 40:4">Da-u̱ u̱n o̱o̱ge̱ me̱ bu-u̱ m-to̱k u-da u-tát. <verse eid="GEN 40:4"/><verse number="5" style="v" sid="GEN 40:5"/>M-gyu̱p m-gan, yu̱-Yat-ya ya-du̱ faru̱k no̱mtu̱ u̱t-swa u̱ yu̱-Yat-ya zwa-u̱ wa u̱r-be̱re̱di ne̱ e̱ nom bo' u-da u-gan bu-u̱ m-to̱k, bo' u̱n be̱e̱t ko̱wan o̱ mu̱ wa sha-mo̱.<verse eid="GEN 40:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 40:6"/>Da-u̱ Yusuhu haane̱ u̱du̱ u̱n u̱r-wu̱n, wa hyen u̱zu̱ u̱n o̱ namu̱ jab. <verse eid="GEN 40:6"/><verse number="7" style="v" sid="GEN 40:7"/>Yusuhu shit i-yate̱ i o̱ m-to̱k u̱du̱ Faru̱k-u̱ Masar, i o̱ye̱ u̱r-kot u̱ wa ne̱ u̱ bu-u̱ m-to̱k-u̱ yu̱-Yat-ya wa. Wa zu̱ e̱, &lt;&lt;¿Yan-o̱ no̱ o̱tte̱ u̱ na-su̱ shu̱u̱t no̱ inya?&gt;&gt;<verse eid="GEN 40:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8"/>E̱ zu̱ wu̱n, &lt;&lt;It no̱ng bo' it yu̱r. Waku̱n zaar hen wu̱ de̱ waru̱ it zu̱n-mu̱ bo'-u̱s o̱ da.&gt;&gt;</para>
  <para style="p" vid="GEN 40:8">Se̱ Yusuhu zu̱ u̱n, &lt;&lt;Ru̱-o̱ yu̱'e̱ zu̱n-mu̱ ko̱-uyan, waru̱n me̱ bo̱'-su̱ no̱ no̱me̱.&gt;&gt;<verse eid="GEN 40:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9"/>Yu̱-Yat-ya ya-du̱ faru̱k no̱m-tu̱ u̱t-swa waru̱ Yusuhu bo'-u̱ wa no̱me̱, wa zu̱, &lt;&lt;U̱-me̱ bo' u̱m hyang te̱-yu̱ inabi u̱-shu̱ ri. <verse eid="GEN 40:9"/><verse number="10" style="v" sid="GEN 40:10"/>Te̱-yu̱ inabi ya o̱ u̱s-fe̱ ne̱ u̱s-tu̱t. A wa tak-ne̱ no̱m-du̱ u̱t-ran, se̱ pyak-u̱t tu̱ rwu̱u̱n, za wa'as ya'ag-u̱ inabi rwu̱u̱n. <verse eid="GEN 40:10"/><verse number="11" style="v" sid="GEN 40:11"/>Me̱ hen u̱m o̱ m-shu̱p u̱ ko̱k-u̱ m-bu̱ faru̱k ne̱ u̱ kom-u ri, se̱ u̱m ku̱b yaag-u̱ inabi u̱m vins e̱ ko̱k-du̱ m-bu̱ tu̱msu̱ u̱m yasu̱ Faru̱k-u̱ Masar de̱ u̱ kom-u wa.&gt;&gt;<verse eid="GEN 40:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12"/>Yusuhu zu̱ wu̱n, &lt;&lt;Zu̱n-mu̱ bo'-u̱ ró ya. Fe̱-u̱s se̱ u̱s-tut roog-mo̱ u̱t-tu̱t. <verse eid="GEN 40:12"/><verse number="13" style="v" sid="GEN 40:13"/>Ba roog-mu̱ u̱t-tu̱t ar-ke̱, Faru̱k-u̱ Masar do̱'e̱ rwu̱tu̱n bo̱ du̱gu̱ bu-u̱ m-to̱k, wa de̱ mutu̱ bo̱ u̱ o̱g-u̱r ró. Tu̱msu̱ bo̱ shu̱'u̱t wa ya-du̱ faru̱k no̱m-tu̱ u̱t-swa u̱ka bo̱ o̱tte m-no̱m u̱r-taku̱n. <verse eid="GEN 40:13"/><verse number="14" style="v" sid="GEN 40:14"/>Bakse̱ me̱ a no̱mu̱ u̱m waru̱ bo̱ shiye̱. No̱mu̱ me̱ u̱r-se̱ge̱ bo̱ no̱mu̱ Faru̱k-u̱ Masar u̱s-rem u̱ remu̱ ri, u̱ remu̱ na rwu̱u̱tu̱n me̱ du̱gu̱ bu-u̱ m-to̱k uno̱. <verse eid="GEN 40:14"/><verse number="15" style="v" sid="GEN 40:15"/>Me̱ na kabu̱n me̱ u̱r-be̱b du̱gu̱ dak-u̱ Ibra-ne̱, u̱ haan u̱ Masar. U̱m no̱ng o̱ko̱n u̱ ko̱re̱ u̱zu̱ na hatu̱n me̱ u̱ ana bu-u̱ m-to̱k da.&gt;&gt;<verse eid="GEN 40:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16"/>Da-u̱ wu̱ zwa-u̱ Faru̱k u̱t-be̱re̱di ho̱ge̱ zu̱n-m so̱mo̱ mu̱ na ya'e̱ wa ya-du̱ faru̱k no̱mtu̱ u̱t-swa u̱ bo'-u̱ wa, se̱ wa zu̱ Yusuhu, &lt;&lt;Ko̱ me̱ u̱m no̱mu̱g bo' u̱m o̱ ko̱o̱r-tu̱ u̱t-be̱re̱di ne̱ u̱t-tu̱t u̱-do̱mu̱ hi-u̱r ri. <verse eid="GEN 40:16"/><verse number="17" style="v" sid="GEN 40:17"/>U̱-do̱m ko̱o̱r-du̱ shu̱u̱g u̱ no̱m u̱t-re̱ so̱-to̱ ne̱ u̱t-go̱ u̱t-go̱ u̱ na no̱me̱ remu̱ Faru̱k-u̱ Masar, tu̱msu̱ no o̱ re̱-du̱ o̱ du̱gu̱ ko̱o̱r-du̱ o̱ hi-u̱r ri.&gt;&gt;<verse eid="GEN 40:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18"/>Yusuhu zu̱, &lt;&lt;Zu̱n-mu̱ bo' ró ya, ko̱o̱r-u̱t to̱ u̱t-tu̱t roog-mo̱ u̱t-tu̱t. <verse eid="GEN 40:18"/><verse number="19" style="v" sid="GEN 40:19"/>No̱m-u̱ bo' o̱ ya-du̱ m-zu̱nu̱ ya. U̱ te̱k-u̱ ro̱o̱g-mu̱ u̱t-tu̱t, Faru̱k-u̱ Masar de̱ kupsu̱ hi-u̱r ró, du̱gu̱ war-u ró. No u̱r-do̱g do̱'e̱ tu̱-du̱ war-u ró.&gt;&gt;<verse eid="GEN 40:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20"/>U̱ ho̱-du̱ u̱r-tu̱tu̱rse̱, de̱ o̱ye̱ ho̱-du̱ baku̱s-du̱ mat-u̱r Faru̱k-u̱ Masar ne̱, wa zo̱ngte̱ i-yate̱ wa u̱r-mo̱ro̱g. Se̱ wa rwu̱u̱tu̱n wa yu̱-Yat-ya ya-du̱ faru̱k-u̱ no̱m-tu̱ u̱t-swa, u̱ yu̱-Yat-ya zwa-u̱ faru̱k u̱r-be̱re̱di ne̱, wa haatu̱n e̱ u̱ shu̱ ne̱nge̱n-u̱t wa. <verse eid="GEN 40:20"/><verse number="21" style="v" sid="GEN 40:21"/>Se̱ wa muut yu̱-Yat-ya ya-du̱ faru̱k no̱m-tu̱ u̱t-swa u̱ o̱g-du̱ wa o̱tte, ko̱wa u̱t-re̱ u-shu̱ u̱ ya-du̱ Faru̱k-u̱ Masar m-bu̱ u̱ kom-u wa. <verse eid="GEN 40:21"/><verse number="22" style="v" sid="GEN 40:22"/>Tu̱msu̱ Faru̱k-u̱ Masar tu̱r yu̱-Yat-ya a zwa-du̱ u̱t-be̱re̱di u-ho u̱-do̱m u-te u̱ka Yusuhu wartu̱ u̱n da-u̱ wa o̱o̱ge̱ ya-du̱ u̱n m-zu̱n.<verse eid="GEN 40:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 40:23"/>M-ha iya ne̱ yu̱-Yat-ya ya-du̱ faru̱k no̱m-tu̱ u̱t-swa baku̱ste̱ u̱ Yusuhu ne̱ da, wa ku̱u̱s u̱t-to̱ wa ne̱.<verse eid="GEN 40:23"/></para>
  <chapter eid="GEN 40"/>
  <chapter number="41" style="c" sid="GEN 41"/>
  <para style="s1">Bo'-u̱s Faru̱k-u̱ Masar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1"/>Da-u̱ shu̱-du̱ hak-su̱ u̱s-yu̱r arke̱, Faru̱k-u̱ Masar nom bo', u̱zu̱ wa o̱ ees u̱ kit-u̱ gi-yu̱ Niru. <verse eid="GEN 41:1"/><verse number="2" style="v" sid="GEN 41:2"/>Da-u̱ na' ta'er, i o̱ye̱ m-yar ne̱, u̱t-birig ne̱, rwu̱u̱n du̱gu̱ gi-yu̱ Niru. E̱ he̱e̱se̱ tu̱du̱ gwa-tu̱ o̱ye̱ u̱-kit u-gi. <verse eid="GEN 41:2"/><verse number="3" style="v" sid="GEN 41:3"/>Se̱ e̱ke̱n na'-e̱ ya ta'er za u̱t-birig, m-ga ne̱ za so̱-ye̱, e̱ rwu̱u̱n tu̱msu̱ du̱gu̱ gi-yu̱ Niru. E̱ ees u̱ dim-u̱ na' ta'er i o̱tte̱ u̱t-birig ne̱ dap-u̱s u-gi. <verse eid="GEN 41:3"/><verse number="4" style="v" sid="GEN 41:4"/>Se̱ na' i m-ga i za so̱-ye̱ toromse̱ na' u̱t-birig. Da-u o̱ Faru̱k-u̱ Masar zu̱te̱.<verse eid="GEN 41:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 41:5"/>Tu̱msu̱ roog-mu̱ kos wa. Wa sur m-no̱m bo' u-yu̱ru̱mse̱, ro̱p-tu̱ hyu̱ u̱t-ta'er, tu̱ so̱-to̱ sok tu̱ shu̱u̱se̱ yaag sok, to̱ cwu̱n u̱-do̱mu̱ kamb-yu̱ u-hyu u-gan. <verse eid="GEN 41:5"/><verse number="6" style="v" sid="GEN 41:6"/>U̱ dim-u̱ u̱n, se̱ke̱n kamb-su̱ hyu̱ se̱ u̱s-ta'er se̱ apu̱n, su̱ za u̱t-birig. Da-u̱ mya-mu̱ udo̱m fu̱rne̱, se̱ ro̱p-tu̱ hyu̱ to̱ ryamu̱sse̱, to̱ gu̱u̱s. <verse eid="GEN 41:6"/><verse number="7" style="v" sid="GEN 41:7"/>Ro̱p-tu̱ hyu̱ to̱ tu̱ za u̱t-birig to̱ toromse̱ ro̱p-tu̱ hyu̱ u̱t-ta'er tu̱ m-yar, tu̱ shu̱se̱ yaag. Se̱ Faru̱k-u̱ Masar zu̱te̱; wa hyen u̱zu̱ bo' o̱.<verse eid="GEN 41:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 41:8"/>Se̱ u̱r-wu̱n, jab-u̱ Faru̱k-u̱ Masar nu̱u̱s. Se̱ wa tom na fagnu̱ wa a-u-gwat-ne̱ u̱ a-m-nap-ne̱ i dak-u̱ Masar be̱e̱t. Se̱ wa waru̱ e̱ bo'-u̱s wa. Na kwu̱mu̱g wu̱ waru̱ wa nu-du̱ bo'-u̱s se̱ da.<verse eid="GEN 41:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9"/>Da-u o̱ yu̱-Yat-ya ya-du̱ Faru̱k-u̱ Masar no̱m-tu̱ u̱t-swa zu̱ye̱, &lt;&lt;U̱ ya-o̱, u̱m baku̱ste̱ u̱ baas-u̱t ri ne̱. <verse eid="GEN 41:9"/><verse number="10" style="v" sid="GEN 41:10"/>Faru̱k-u̱ Masar hog u̱s-ryap u̱ to̱k-u̱ wa ne̱, tu̱msu̱ Faru̱k-u̱ Masar hu̱u̱t me̱ u̱ wa zwa-u̱ faru̱k u̱r-be̱re̱di ne̱ u̱ bu-u̱ yu̱-Yat-ya a-gwat-du̱ bu-u m-to̱k ne̱. <verse eid="GEN 41:10"/><verse number="11" style="v" sid="GEN 41:11"/>It no̱mu̱g u̱s-bo' it be̱e̱t m-gyu̱p m-gan, ko̱he̱ne̱ bo' o̱ o̱tte̱ mu̱ wa zu̱n-mo̱. <verse eid="GEN 41:11"/><verse number="12" style="v" sid="GEN 41:12"/>Waku̱n zwar-wa o̱ro u̱ku̱n u̱r-ko̱t u̱ it ne̱, ne̱t-u̱ Ibra-ne̱, to̱k-u̱ yu̱-Yat-ya a-gwat-du̱ bu-u m-to̱k ne̱. It waru̱ wa bo'-u̱s it, se̱ wa waru̱ it zu̱n-mu̱ bo'-u̱s it. Wa waru̱ ko̱wan zu̱n-mu̱ bo'-u̱ wa no̱me̱. <verse eid="GEN 41:12"/><verse number="13" style="v" sid="GEN 41:13"/>Ko̱-uyan nom ho̱n-ho̱n u̱ka wa zu̱tte̱. Na mu̱tu̱n me̱ u̱ o̱g-u̱r ri u̱ka wa zu̱tte̱ wu̱ ya-du̱ faru̱k no̱m-tu̱ u̱t-swa. Wa zwa-u̱ faru̱k u̱r-be̱re̱di na ho wa.&gt;&gt;<verse eid="GEN 41:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14"/>Da-u̱ faru̱k ho̱ge̱ iya, wa tom to̱k-ne̱, na fagu̱n Yusuhu. E̱ do̱'e̱ e̱ fagu̱n Yusuhu, du̱gu̱ bu-u̱ m-to̱k. Da-u̱ Yusuhu tase̱ u-o̱r se̱ wa wu̱ to̱ko̱n kus-to̱, wa aru̱k m-cwa wa ees u̱-shu̱ Faru̱k-u̱ Masar.<verse eid="GEN 41:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 41:15"/>Faru̱k-u̱ Masar zu̱ Yusuhu, &lt;&lt;U̱m no̱mu̱g bo'. U̱m kwu̱mu̱g waku̱n wu̱ waru̱ me̱ zu̱n-mu̱ bo'-u̱ o̱ da. Tu̱msu̱ u̱m ho̱k u̱zu̱ bo̱ ye'e̱ zu̱n-mu̱ bo'.&gt;&gt;<verse eid="GEN 41:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16"/>Yusuhu zu̱ Faru̱k-u̱ Masar, &lt;&lt;Me̱ wa ye'e̱ zu̱n-mu̱ bo' da, se̱di Ru̱-o̱ ya'u̱ Faru̱k-u̱ Masar zu̱n-mu̱ wa o̱o̱ge̱ u̱ssa.&gt;&gt;<verse eid="GEN 41:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17"/>Se̱ Faru̱k-u̱ Masar zu̱ Yusuhu, &lt;&lt;U̱ bo'-u̱ ri, u̱m o̱ ees u̱ kit-u̱ gi-yu̱ Niru. <verse eid="GEN 41:17"/><verse number="18" style="v" sid="GEN 41:18"/>Se̱ na' ta'e̱r rwu̱u̱n m-yar ne̱, u̱t-birig ne̱, du̱gu̱ me̱ u-gi yu̱ Niru, se̱ e̱ he̱e̱se̱ tu̱-du̱ gwa-tu̱ o̱ u̱ kit-u̱ u-gi. <verse eid="GEN 41:18"/><verse number="19" style="v" sid="GEN 41:19"/>Tu̱msu̱ e̱ke̱n na'-e̱ rwu̱u̱n u̱ dim-u̱ e̱ za u̱t-birig, za so̱-ye̱. U̱m tamu̱g hyan-du̱ go̱-du̱ e̱ u̱ dak-u̱ Masar da. <verse eid="GEN 41:19"/><verse number="20" style="v" sid="GEN 41:20"/>Se̱ na' ta'er, i za u̱t-birig i za so̱-ye̱, toromse̱ na' ta'er i u̱t-birig. <verse eid="GEN 41:20"/><verse number="21" style="v" sid="GEN 41:21"/>Tu̱msu̱ da u̱n toromse̱ e̱, waku̱n zaar u̱t-nap u̱zu̱ u̱n cwaru̱g o̱ko̱n da, remu̱ zu̱ e̱ o̱mo̱n m-ga ne̱ u̱ka u̱r-taku̱n. Da-u o̱ u̱m yu̱ne̱.<verse eid="GEN 41:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 41:22"/>&lt;&lt;Se̱ roog-mu̱ sur m-kab me̱, tu̱msu̱ u̱m no̱m o̱kon bo' o̱, u̱m hyanu̱g ro̱p-tu̱ hyu̱ u̱t-ta'er, to̱ shu̱u̱se̱ yaag sok tu̱ so̱-to̱, to̱ cwu̱gu̱n u̱-do̱m u-kamb u-gan. <verse eid="GEN 41:22"/><verse number="23" style="v" sid="GEN 41:23"/>U̱ dim-u̱ e̱, to̱ko̱n ro̱p-tu̱ hyu̱ to̱ u̱t-ta'er to̱ cwu̱u̱n to̱ zatte̱ yaag da. Da-u̱ mya-mu̱ udo̱m fu̱rne̱, se̱ ro̱p-tu̱ tu̱ hyu̱ to̱ ryamu̱sse̱, to̱ gu̱u̱s. <verse eid="GEN 41:23"/><verse number="24" style="v" sid="GEN 41:24"/>Se̱ ro̱p-tu̱ ryaamse̱ toros ro̱p-tu̱ hyu̱ u̱t-ta'er tu̱ so̱-to̱ to̱. U̱m wargu̱ a-u-gwat-ne̱ se̱di waku̱n kerge̱ waru̱ me̱ bo'-u̱ ri da.&gt;&gt;<verse eid="GEN 41:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25"/>Yusuhu zu̱ Faru̱k-u̱ Masar, &lt;&lt;Bo'-u̱s ró o̱ u̱s-gan. Ru̱-u̱ wargu̱ Faru̱k-u̱ Masar nom-u̱ wa o̱o̱ge̱ u̱ssa u̱t-no̱m. <verse eid="GEN 41:25"/><verse number="26" style="v" sid="GEN 41:26"/>Na'-u̱ so̱-ye̱ ta'er hak-se̱ u̱s-ta'er, ro̱p-tu̱ hyu̱ to̱ u̱t-ta'er hak-se̱ u̱s-ta'er, no̱m-o̱ u-gan tu̱msu̱ bo'-se̱ u̱s-gan. <verse eid="GEN 41:26"/><verse number="27" style="v" sid="GEN 41:27"/>Na' ta'er i o̱tte̱ m-ga za u̱t-birig, i rwu̱u̱ne̱ u̱-dim tu̱msu̱ hak-se̱ u̱s-ta'er. Tu̱msu̱ ro̱p-tu̱ hyu̱ to̱ u̱t-ta'er za yaag i mya-mu̱ u-do̱m fu̱rne̱ e̱ ryamu̱sse̱: to̱ o̱o̱ge̱ hak-su̱ u̱s-ta'er su̱ u̱s-me̱r.<verse eid="GEN 41:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 41:28"/>&lt;&lt;Iya o̱tte̱ u̱ka u̱m zu̱tte̱ Faru̱k-u̱ Masar, Ru̱-u̱ ko̱ksu̱ Fir'una no̱mu̱ wa do̱'e̱ u̱t-no̱m. <verse eid="GEN 41:28"/><verse number="29" style="v" sid="GEN 41:29"/>Na do̱'e̱ u̱ no̱m-du̱ u̱s-hak u̱s-ta'e̱r su̱ no̱m-u̱t-re̱ so̱k dak-u̱ Masar u-be̱e̱t. <verse eid="GEN 41:29"/><verse number="30" style="v" sid="GEN 41:30"/>Se̱di hak-su̱ u̱s-me̱r u̱s-ta'er do̱'e̱ u̱ do̱rnu̱ dim. U̱ da-u o̱ na do̱'e̱ u̱ ku̱'u̱s u̱t-to̱ u̱ no̱m u̱t-re̱ u̱ na no̱me̱ ne̱ u-be̱e̱t u̱ dak-u Masar. Tu̱msu̱ me̱r-su̱ do̱'e̱ u̱ no̱m-du̱ u-tát u-dak u-be̱e̱t. <verse eid="GEN 41:30"/><verse number="31" style="v" sid="GEN 41:31"/>Me̱r-su̱ do̱'e̱ u̱t-shu̱'u̱t u̱ka zu̱ na tamu̱g no̱m-du̱ no̱m u̱t-re̱ u̱ Masar da, u̱ remu̱ tat-u̱ u̱s-me̱r su̱ na do̱'e̱ u̱t-no̱m. <verse eid="GEN 41:31"/><verse number="32" style="v" sid="GEN 41:32"/>No̱mu̱ wa-e̱ bo' hatu̱n u̱s-fu̱n u̱s-yu̱r u̱du̱ Faru̱k-u̱ Masar na o̱ u̱ssa wa nap no̱mu̱ do̱'e̱ u̱t-no̱m u̱zu̱ Ru̱-o̱ no̱me̱ dorog-su̱ no̱m-du̱ o̱ no̱m-o u̱ hi-du̱ war-wa, tu̱msu̱ Ru̱-u̱ do̱'e̱ u̱ no̱m-du̱ o̱ za m-tumb.<verse eid="GEN 41:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 41:33"/>&lt;&lt;Remu̱ iya, yage̱ Faru̱k-u̱ Masar sa ne̱t wa-m-nap u̱ ne̱t wu̱ o̱tte̱ dorog-u̱s so̱-se̱ ne̱, wa shu̱'u̱t yu̱-Yat-ya u̱ gwat-du̱ dak-u̱ Masar. <verse eid="GEN 41:33"/><verse number="34" style="v" sid="GEN 41:34"/>Yage̱ Faru̱k-u̱ Masar wa i-yate̱ u-dak u̱ Masar. E̱ kargu̱sse̱ u-gan u̱t-tan u̱ te̱k-u̱ no̱m-tu̱ u̱r-to̱m tu̱ na do̱'e̱ u̱t-kwu̱m hak-su̱ u̱s-ta'er su̱ na do̱te̱ no̱m-du̱ no̱m u̱t-re̱ sok. <verse eid="GEN 41:34"/><verse number="35" style="v" sid="GEN 41:35"/>E̱ do̱'e̱ u̱ kargu̱sse̱ no̱m-tu̱ u̱t-re̱ tu̱ hak-u̱s so̱-se̱ su̱ no̱m u̱t-re̱ su̱ o̱ne̱ u̱ te̱k-u̱ be̱b-u̱r Faru̱k-u̱ Masar, na cin to̱ u̱t-bo̱ u̱ na kum-u̱t no̱m u̱t-re̱. <verse eid="GEN 41:35"/><verse number="36" style="v" sid="GEN 41:36"/>No̱m u̱t-re̱ o̱ do̱'e̱ u̱t-shu̱'u̱t u̱r-cu̱n u̱ re̱mu u-dak, u̱ na kum-u̱t no̱m u̱t-re̱ u̱ hak-su̱ u̱s-ta'e̱r su̱ u̱s-me̱r su̱ do̱'e̱ u̱ haan dak-u̱ Masar, taas u̱ ne̱t-tu̱ u-dak u̱ mar u̱s-me̱r da.&gt;&gt;<verse eid="GEN 41:36"/></para>
  <para style="s1">Faru̱k-u̱ Masar wa'ag Yusuhu <optbreak/> yu̱-Yat-ya u̱ dak-u̱ Masar</para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37"/>Rem-u̱s se̱ nom Faru̱k-u̱ Masar u̱r-zwar u̱ tu̱-yat-to̱ wa ne̱. <verse eid="GEN 41:37"/><verse number="38" style="v" sid="GEN 41:38"/>Faru̱k-u̱ Masar zu̱ tu̱-yat-to̱, &lt;&lt;¿Inu̱ kwu̱mu̱ ne̱t go̱-du̱ wa wu̱ o̱tte̱ Yar u-Ru̱?&gt;&gt;<verse eid="GEN 41:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 41:39"/>Faru̱k-u̱ Masar zu̱ Yusuhu, &lt;&lt;Remu̱ zu̱ Ru̱-u̱ ko̱ksu̱ bo̱ tun-to̱ no̱m-to̱, waku̱n zaar wa dorog-u̱s so̱-se̱ wa-m-nap u̱ka bo̱ da. <verse eid="GEN 41:39"/><verse number="40" style="v" sid="GEN 41:40"/>Bo̱ shu̱'u̱t yu̱-Yat-ya u̱ pada-u ri. Tu̱msu̱ ne̱t-u̱t ri u̱t-be̱e̱t e̱ do̱'e̱ yasu̱ hi-du̱ war-e̱ u̱du̱ ró, e̱ ya bo̱ m-ze̱g. U̱-do̱mu̱ pora-du̱ u̱r-faru̱k de̱ u̱m do̱te̱ u̱ ze̱g-du̱ bo̱ u̱ warre̱.&gt;&gt;<verse eid="GEN 41:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 41:41"/>Faru̱k-u̱ Masar zu̱ Yusuhu, &lt;&lt;Gwat, u̱ da-o̱ u̱m wa'ag bo̱ shu̱'u̱t u̱r-faru̱k dak-u̱ Masar u-be̱e̱t.&gt;&gt; <verse eid="GEN 41:41"/><verse number="42" style="v" sid="GEN 41:42"/>Se̱ Faru̱k-u̱ Masar host kwaat-yu̱ u̱t-komu̱ wa, wa wa'-u̱ Yusuhu ya u-jo̱-u, tu̱msu̱ wa wa'-u̱ Yusuhu cwu̱-u̱t so̱-to̱. Tu̱msu̱ faru̱k wa'-u̱ wu̱n re̱ge̱z shik yu̱ u-kwam yu̱ bu̱-mu̱ u̱t-ro u̱ ge̱ksu̱ wa. <verse eid="GEN 41:42"/><verse number="43" style="v" sid="GEN 41:43"/>Faru̱k-u̱ Masar zo̱nge̱ Yusuhu wa sak u̱-do̱mu̱ ke̱ke̱-yu̱ u-jwaak ka wa u̱r-se̱ge̱ wa, remu̱ wa shu̱'u̱t wa u̱r-se̱ge̱ faru̱k. Se̱ ne̱t-tu̱ yu̱ne̱ u̱t-jar u̱zu̱, &lt;&lt;Ya u̱n u̱r-be!&gt;&gt; Na wa'ag Yusuhu wa shu̱'u̱t yu̱-Yat-ya dak-u̱ Masar u-be̱e̱t.<verse eid="GEN 41:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="GEN 41:44"/>Se̱ Faru̱k-u̱ Masar zu̱ Yusuhu, &lt;&lt;Me̱ o̱ Faru̱k-u̱ Masar, tu̱msu̱ da ees-u̱t ró ne̱ da, waku̱n zaar Masar wu̱ do̱'e̱ u̱ no̱m-du̱ o̱kon no̱mo̱ da.&gt;&gt; <verse eid="GEN 41:44"/><verse number="45" style="v" sid="GEN 41:45"/>Faru̱k-u̱ Masar wa'-u̱ Yusuhu dim-u̱r po-de̱ na zu̱ Zapena-Paneya. Se̱ wa yu̱ Yusuhu Asenat gwu̱p-u̱ Potipara u̱r-gu̱ wa-to̱o̱g bo̱-u̱ O̱n. Yusuhu aru̱k m-cwa dak-u̱ Masar u-be̱e̱t, u̱ wa shu̱'u̱t ne̱ta wa.<verse eid="GEN 41:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 41:46"/>U̱ da-u o̱ Yusuhu o̱ u̱s-hak u̱r-shik-u̱ o̱p [30], da-u̱ wa cwaye̱ u̱ no̱mu̱ Faru̱k-u̱ Masar m-ank. Remu̱ wa no̱m-u̱t ank-m wa, wa yage̱ u-pada u̱ faru̱k m-caw dak-u̱ Masar. <verse eid="GEN 41:46"/><verse number="47" style="v" sid="GEN 41:47"/>Da u̱ hak-su̱ u̱s-ta'e̱r no̱me̱ su̱ no̱m-u̱t-re̱ no̱m u̱t-re̱ no̱m u-tát u-dak u-be̱e̱t. <verse eid="GEN 41:47"/><verse number="48" style="v" sid="GEN 41:48"/>Yusuhu kargu̱sse̱ no̱m u̱t-re̱ u̱ hak-su̱ u̱s-ta'e̱r su̱ no̱m-u̱t-re̱ u̱ dak-u̱ Masar. Tu̱msu̱ wa cin no̱m u̱t-re̱ u̱t-bo̱. Ko̱-u̱-he̱ bo̱-o̱ wa wu̱ na kargu̱sse̱ no̱m u̱t-re̱ u̱ na gwaye̱ u̱ tak-tu̱ u̱s-kit u̱t-be̱e̱t. <verse eid="GEN 41:48"/><verse number="49" style="v" sid="GEN 41:49"/>Yusuhu kargu̱sse̱ no̱m u̱t-re̱ u-tát, u̱ka hereg-mu̱ u-gi. Se̱ wa yage̱ u̱t-ogor remu̱ zu̱ waku̱n zaar u̱ keru̱ u̱t-ogor da.<verse eid="GEN 41:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50"/>Kanda hak-su̱ u̱s-me̱r u̱ teen, Asenat gwu̱p-u̱ Potipara wa-to̱o̱g-u̱ bo̱-u̱ O̱n, ne̱ta Yusuhu wa matu̱ Yusuhu yaag-u̱ campa-ne̱ yu̱r. <verse eid="GEN 41:50"/><verse number="51" style="v" sid="GEN 41:51"/>Yusuhu te̱'e̱ mat-du̱ u̱r-taku̱n u̱r-dim Manase. Wa zu̱, &lt;&lt;Ru̱-u̱ wa'ag u̱m ku̱u̱ste̱ u̱t-to̱ u̱ to̱k-m ri ne̱ u̱ ne̱t-tu̱ bu-u̱ u̱so ri ne̱.&gt;&gt; <verse eid="GEN 41:51"/><verse number="52" style="v" sid="GEN 41:52"/>Ya-du̱ u̱r-zwar du̱ u-yu̱ru̱mse̱ Yusuhu zu̱ wa Ifaramu. Wa zu̱, &lt;&lt;Remu̱ zu̱ Ru̱-u̱ yaag me̱ yaag u̱ dak-u̱ u̱m nomte̱ m-to̱k.&gt;&gt;<verse eid="GEN 41:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53"/>Hak-su̱ u̱s-ta'e̱r su̱ no̱m u̱t-re̱ u-tát teeg u̱r-ma u̱ dak-u̱ Masar. <verse eid="GEN 41:53"/><verse number="54" style="v" sid="GEN 41:54"/>Se̱ hak-su̱ u̱s-ta'e̱r su̱ u̱s-me̱r taku̱n, u̱ka Yusuhu zu̱tte̱. Se̱ me̱r-su̱ haan u̱ dak-tu̱ o̱ m-gan u̱ Masar u̱t-be̱e̱t. Se̱di Masar no̱m u̱t-re̱ o̱ró. <verse eid="GEN 41:54"/><verse number="55" style="v" sid="GEN 41:55"/>Da-u̱ me̱r-su̱ he̱e̱se̱ Masar, ne̱t-tu̱ do̱'e̱ u̱du̱ Faru̱k-u̱ Masar e̱ no̱mu̱ wa u̱s-kan u̱zu̱ no̱m u̱t-re̱ zarra. Se̱ wa zu̱ u̱n &lt;&lt;De̱e̱n u̱du̱ Yusuhu, no̱m-u̱ wa zu̱ no̱ u-be̱e̱t, se̱ no̱ no̱m.&gt;&gt;<verse eid="GEN 41:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 41:56"/>Da-u̱ me̱r-su̱ goone̱ ko̱he̱ne̱ u-dak u-be̱e̱t, Yusuhu tu̱ku̱s be-tu̱ no̱m u̱t-re̱ o̱tte̱. Wa babu̱ u̱n remu̱ zu̱ me̱r-su̱ no̱mu̱g u-tát Masar. <verse eid="GEN 41:56"/><verse number="57" style="v" sid="GEN 41:57"/>Tu̱msu̱ ne̱t-tu̱ haan du̱gu̱ dak-tu̱ u̱s-kit u̱ Masar e̱ oot no̱m u̱t-re̱ u̱du̱ Yusuhu, remu̱ zu̱ me̱r-su̱ no̱ng u-tát u-dak u-be̱e̱t.<verse eid="GEN 41:57"/></para>
  <chapter eid="GEN 41"/>
  <chapter number="42" style="c" sid="GEN 42"/>
  <para style="s1">Tu̱-wu̱to̱ Yusuhu haag u̱ dak-u̱ <optbreak/> Masar u̱ sa-u̱ no̱m u̱t-re̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1"/>Da-u̱ Yakubu nape̱ u̱zu̱ no̱m u̱t-re̱ o̱ro u̱ dak-u̱ Masar, wa zu̱ ya-u̱t-zwaru̱ wa, &lt;&lt;¿Remu-u yan o̱ no̱ o̱tte̱ u̱ shu̱'u̱t u̱ gwat-du̱ hi-du̱ war-no̱? <verse eid="GEN 42:1"/><verse number="2" style="v" sid="GEN 42:2"/>U̱m ho̱k u̱zu̱ no̱m u̱t-re̱ o̱ro u̱ Masar, de̱e̱n no̱ o̱o̱nu̱ in no̱m u̱t-re̱ ko̱ in u̱t-no̱m u̱r-fat, u̱ taas in mar da.&gt;&gt;<verse eid="GEN 42:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 42:3"/>Se̱ tu̱-wu̱to̱ Yusuhu ne̱t-ne̱ o̱p e̱ aru̱k m-ha u̱ Masar, u̱ remu̱ e̱ o̱o̱tu̱n no̱m u̱t-re̱. <verse eid="GEN 42:3"/><verse number="4" style="v" sid="GEN 42:4"/>Se̱di Yakubu to̱mo̱g Banyamin hu̱no-u Yusuhu da, wa o̱ u̱t-ge̱r taas o̱ko̱n no̱m-u yo̱-o̱ kum wa da. <verse eid="GEN 42:4"/><verse number="5" style="v" sid="GEN 42:5"/>Ya-u̱t-zwaru̱ Isra yu̱ne̱ du̱gu̱ Kan'ana m-ha u̱ Masar e̱ o̱o̱tu̱n no̱m u̱t-re̱, remu̱ zu̱ me̱r-su̱ o̱ró Kan'ana sok.<verse eid="GEN 42:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 42:6"/>Yusuhu wa o̱ye̱ wa-u-dak u̱ Masar. Wa o̱ wa bab-du̱ hyu̱ u̱du̱ ne̱t-tu̱ haane̱ u̱ dak-u̱ Masar u-be̱e̱t. Se̱ o̱r-u̱t Yusuhu haan, e̱ he̱ u̱ shu̱ wa u̱t-jwu̱n, e̱ kaku̱s u̱t-hi u-dak. <verse eid="GEN 42:6"/><verse number="7" style="v" sid="GEN 42:7"/>Da-u̱ Yusuhu hyane̱ o̱r-u̱t wa ne̱, wa nu̱p u̱zu̱ hu̱no-u̱t wa to̱. Se̱ wa nom u̱ka ham-u̱t wa wa o̱ye̱ wa no̱mu̱ u̱n u̱s-rem u̱ namu̱ jab ne̱. Wa zu̱, &lt;&lt;¿Du̱gu̱ he̱ne̱ no̱ rwu̱ne̱?&gt;&gt;</para>
  <para style="p" vid="GEN 42:7">E̱ zu̱, &lt;&lt;It rwu̱gu̱n du̱gu̱ dak-u̱ Kan'ana, it haagu̱n it o̱ no̱m u̱t-re̱.&gt;&gt;<verse eid="GEN 42:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8"/>Yusuhu nak o̱r-u̱t wa, se̱di e̱ baku̱ste̱ u̱zu̱ ne̱t wu̱ o̱o̱ge̱ ees u̱-shu̱ e̱ Yusuhu wa da. <verse eid="GEN 42:8"/><verse number="9" style="v" sid="GEN 42:9"/>Yusuhu baku̱s bo'-u̱ wa no̱me̱. Wa zu̱ u̱n, &lt;&lt;No̱ haan m-haan, remu̱ no̱ gwat u̱ka dak-u it o̱tte̱. A-gwat-du̱ u-dak-ne̱ e̱ no̱ o̱ye̱.&gt;&gt;<verse eid="GEN 42:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10"/>E̱ zu̱ wa, &lt;&lt;O'o u̱so u-bu ri, to̱k-ne̱ ró hagu̱n remu̱ e̱ o̱ no̱m u̱t-re̱. <verse eid="GEN 42:10"/><verse number="11" style="v" sid="GEN 42:11"/>It ya'ag-u̱ wa-gan ne̱ it o̱ye̱ be̱e̱t. It ne̱t-tu̱ u̱t-nip to̱ to̱k-ne̱ ró e̱. A-gwat-du̱ u-dak-ne̱ e̱ da.&gt;&gt;<verse eid="GEN 42:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12"/>Yusuhu zu̱ u̱n, &lt;&lt;O'o, no̱ haan m-haan remu̱ no̱ hyen-u̱t u̱ka be̱b-du̱ dak-u̱ it o̱tte̱.&gt;&gt;<verse eid="GEN 42:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13"/>Se̱ e̱ zu̱ wu̱n, &lt;&lt;It rwu̱gu̱n u-bu u-gan, it ya'ag-u̱ wa-gan ne̱, it o̱ o̱p u̱ yu̱r [12] campa-ne̱. It haagu̱n du̱gu̱ dak-u̱ Kan'ana. Vaste̱-u̱r it o̱ u̱r-ko̱t u̱ u̱so-u it ne̱, wa-gan it wa zamu̱n u̱r-fat da.&gt;&gt;<verse eid="GEN 42:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14"/>Yusuhu zu̱ u̱n, &lt;&lt;U̱ka u̱m zu̱tte̱ no̱, no̱ a-gwat-du̱ u-dak-ne̱ e̱. <verse eid="GEN 42:14"/><verse number="15" style="v" sid="GEN 42:15"/>Ka u̱m do̱te̱ no̱m-du̱ reg-mu̱ rem-u̱s no̱ iya. U̱m no̱m-u̱g e̱ste̱ du̱ u̱s-rem u̱m zaar u̱ mu̱-du̱ u-dim u̱ no̱mu̱ u̱m ware̱ ne̱ da inde u̱zu̱ Faru̱k-u̱ Masar o̱ u̱r-be̱b ne̱: No̱ zaar yage̱ Masar da se̱ no̱ haagu̱n u̱ du̱-dim-u̱ no̱ ne̱ u̱ ane̱. <verse eid="GEN 42:15"/><verse number="16" style="v" sid="GEN 42:16"/>To̱mo̱n wa-gan no̱, wa do̱'e̱ wa kabu̱n du̱-fade̱ no̱. Na do̱'e̱ u̱ tagu̱ i kuse̱ u̱ bu-u̱ m-to̱k, ko̱ me̱ no̱mu̱ no̱ reg-mu̱ rem-u̱s no̱ u̱zu̱ no̱ nip-to̱ ne̱ re̱. Abite̱ nip-to̱ da, u̱m to̱ndte̱ u̱ fat-du̱ faru̱k ne̱, no̱ a-gwat-du̱ u-dak-ne̱ e̱.&gt;&gt; <verse eid="GEN 42:16"/><verse number="17" style="v" sid="GEN 42:17"/>Se̱ Yusuhu wu̱ u̱n u̱ bu-u m-to̱k m-roog u̱t-tu̱t.<verse eid="GEN 42:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18"/>U̱ ho̱-du̱ u-tu̱tu̱rse̱, Yusuhu zu̱ u̱n, &lt;&lt;Me̱ ne̱t-u̱ u-gye̱r u-Ru̱ wa. A no̱ no̱me̱ no̱m-u̱ u̱m zu̱ no̱ no̱m, no̱ u̱t-no̱m u̱r-fat. <verse eid="GEN 42:18"/><verse number="19" style="v" sid="GEN 42:19"/>A mu̱ne̱ u̱zu̱ no̱ a-u̱t-nip-ne̱ e̱, yagu̱n waku̱n wa shu̱'u̱t u̱ bu-u̱ m-to̱k, se̱ i kuse̱ e̱ mutu̱ a-u-bu u̱s-me̱r no̱ no̱m u̱t-re̱. <verse eid="GEN 42:19"/><verse number="20" style="v" sid="GEN 42:20"/>Remu̱ iya se̱ no̱ hatu̱n du̱-dim-u̱ no̱ u̱du̱ ri, ko̱ na gwat-u̱ rem-u̱s no̱ taas u̱ no̱ mar da.&gt;&gt; E̱ ees e̱ nom iya.<verse eid="GEN 42:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 42:21"/>Se̱ e̱ zu̱ hi-du̱ war-e̱, &lt;&lt;Za u-sakna na o̱ yadu̱ in u̱r-ko̱b u̱ remu̱ no̱mu̱ in no̱me̱ hu̱no-u in. In hyanu̱g ka jab-u̱ wu̱n nu̱u̱te da-u̱ wa o̱o̱ge̱ u̱ ko̱n-du̱ in u̱ remu̱ fat-u̱r rò, se̱di in gu̱gu̱m u̱t-e̱r, o̱ wa'e̱ din-de̱ swadu̱ u̱r-ko̱b de̱ haatu̱n in.&gt;&gt;<verse eid="GEN 42:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22"/>Rube̱n zu̱, &lt;&lt;¿U̱m wargu̱ no̱ u̱zu̱ a no̱ no̱mu̱ wa'-u̱ wa o̱ko̱n da? No̱ gu̱gu̱m ho̱g-du̱ me̱. Tu̱msu̱ to̱p-u̱ no̱m-u̱ in no̱mu̱ wa na o̱ no̱mu̱ in.&gt;&gt; <verse eid="GEN 42:22"/><verse number="23" style="v" sid="GEN 42:23"/>U̱n nak u̱zu̱ Yusuhu o̱ ho̱gu̱ u̱n da, u̱ remu̱ zu̱ a wa o̱ u̱s-rem u̱ u̱n ne̱ waku̱n o̱ u̱t-bargu̱sse̱ u̱t-war.<verse eid="GEN 42:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 42:24"/>Se̱ Yusuhu hast shu̱-u wa u̱-kit, wa hu̱ u̱s-kan. Tu̱msu̱ se̱ wa byu̱ru̱n u̱du̱ u̱n wa no̱mu̱ u̱n u̱s-rem. Wa umus Simiyo̱n du̱gu̱ me̱ u̱n wa wu̱' na gu̱ku̱s wa u̱ hyan-mu̱ is-u̱ u̱n. Na hu̱u̱t wa u̱ bu-u̱ m-to̱k.<verse eid="GEN 42:24"/></para>
  <para style="s1">Tu̱-wu̱to̱ Yusuhu <optbreak/> mu̱gu̱n u̱ Kan'ana</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25"/>Yusuhu ye u-nu u̱zu̱ na shu̱u̱s ba-tu̱ tu̱-wu̱to̱ wa ne̱ u̱ hyu̱, tu̱msu̱ na muutu̱ ko̱wan ko̱nko̱ shik-u̱ wa u̱ ba-u̱r wa. Wa zu̱ na ya u̱n no̱m u̱t-re̱ u̱n de̱ u̱t-re̱ u̱-fu̱n. Iya o̱ na no̱m-tu̱ u̱n. <verse eid="GEN 42:25"/><verse number="26" style="v" sid="GEN 42:26"/>Se̱ u̱n gagu̱ janka u̱n ba-tu̱ hyu̱, se̱ u̱n aru̱k, u̱n dor u-fu̱n m-mu̱.<verse eid="GEN 42:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 42:27"/>Be-du̱ u̱n eeste̱ remu̱ u̱n roogte̱ m-gyu̱p, wa-gan upus ba-u̱r wa u̱ remu̱ wa ye'et u-janka no̱m u̱t-re̱, Se̱ wa bit ko̱nko̱ shik-u̱ wa do̱m-u̱ ba-u̱r wa. <verse eid="GEN 42:27"/><verse number="28" style="v" sid="GEN 42:28"/>Wa zu̱ o̱r-u̱t wa, &lt;&lt;Na mu̱ttu̱n me̱ shik-u̱ ri. E̱ ya ba-u̱r ri.&gt;&gt;</para>
  <para style="p" vid="GEN 42:28">Se̱ jab-u̱ u̱n mor u̱n hog u-gye̱r ko̱wan bir wa got o̱r-u̱ wa, wa zu̱, &lt;&lt;¿Yan o̱ iya u̱ Ru̱-u̱ no̱me̱ ine̱?&gt;&gt;<verse eid="GEN 42:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29"/>Da-u̱ u̱n muye̱ u̱du̱ u̱so-u u̱n Yakubu u̱ dak-u̱ Kan'ana, u̱n waru̱ wa no̱m-u̱ no̱me̱ u-be̱e̱t. <verse eid="GEN 42:29"/><verse number="30" style="v" sid="GEN 42:30"/>E̱ zu̱ wu̱n, &lt;&lt;Ne̱t wu̱ o̱o̱ge̱ wa-u-dak u̱ Masar wa no̱ngu̱ it u̱s-rem u̱ namu̱ jab ne̱. Wa kagu̱b it a-gwat-du̱ u-dak-ne̱. <verse eid="GEN 42:30"/><verse number="31" style="v" sid="GEN 42:31"/>Tu̱msu̱ it zu̱ wa, &lt;It ne̱t-tu̱ u̱t-nip to̱, za a-gwat-du̱ u-dak-ne̱ e̱ da. <verse eid="GEN 42:31"/><verse number="32" style="v" sid="GEN 42:32"/>It ne̱t-ne̱ o̱p u̱ yu̱r [12], it ya'ag-u̱ campa-ne̱ u̱so u̱ u-gan ne̱. Wa-gan maru̱g, du̱-fade̱ it o̱ u̱r-kot u̱ u̱so-u it ne̱ u̱ Kan'ana.&gt;<verse eid="GEN 42:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 42:33"/>&lt;&lt;Ne̱t wu̱ o̱o̱ge̱, wa-u-dak zu̱ it, &lt;Ka u̱m do̱te̱ u̱t-nap u̱zu̱ no̱ ne̱t-tu̱ u̱t-nip to̱, yagu̱n wa-gan u̱ ana no̱ muut-u̱ a-u-bu no̱ ne̱ i o̱o̱ge̱ u̱s-me̱r no̱m u̱t-re̱. <verse eid="GEN 42:33"/><verse number="34" style="v" sid="GEN 42:34"/>Se̱ no̱ hattu̱n du̱-dim-u̱ no̱ u̱du̱ ri. O̱ do̱'e̱ u̱t-wa u̱m nap u̱zu̱ no̱ a-wu̱ksu̱ u-dak-ne̱ e̱ da, se̱di a-u̱t-nip-ne̱ e̱. Da-u o̱ u̱m do̱'e̱ yasu̱ no̱ du̱-dim-u̱ no̱, u̱ da-u o̱ no̱ u̱t-no̱m u-ce̱rpa dak-u uno̱.&gt; &gt;&gt;<verse eid="GEN 42:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35"/>Da-u̱ u̱n o̱ dasu̱ hyu̱ du̱gu̱ ba-u̱t u̱n, se̱ ko̱wan hyen shik-u̱ wa ba-u̱r wa. Da-u̱ u̱n u̱ u̱so u̱n ne̱ hyane̱ put-tu̱ shik, u̱n hog u-gye̱r. <verse eid="GEN 42:35"/><verse number="36" style="v" sid="GEN 42:36"/>U̱so u̱n Yakubu zu̱ u̱n, &lt;&lt;No̱ wa'ag u̱m taag u̱ yaag yu̱r, Yusuhu zarra tu̱msu̱ Simiyo̱n zarra, u̱ da-o̱ tu̱msu̱ no̱ u̱t-sa no̱ kab Banyamin. Me̱ o̱ wa swadu̱ u̱r-ko̱b u̱ no̱mu̱ o̱ m-da ne̱ u-be̱e̱t.&gt;&gt;<verse eid="GEN 42:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37"/>Rube̱n zu̱ u̱so-u e̱, &lt;&lt;Me̱ ya bo̱ ya-u̱t-zwaru̱ ri yu̱r ri yu̱r bo̱ ho̱, a u̱m mu̱tu̱n Banyamin u̱du̱ ró da. Me̱ gwat-u̱ wa, tu̱msu̱ me̱ mu̱tu̱n bo̱ wa.&gt;&gt;<verse eid="GEN 42:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38"/>Tu̱msu̱ Yakubu zu̱, &lt;&lt;Banyamin za m-ha u̱ no̱ ne̱ da, remu̱ zu̱ Yusuhu maru̱g tu̱msu̱ wa kuse̱ u̱ war-wa. A o̱ku̱n no̱mu yo̱-o̱ kume̱ wa u̱ do̱m-u u-fu̱n, no̱ u̱t-wa me̱ ne̱nge̱n-yu̱ hi-u̱r pus-de̱, m-mar u̱ remu̱ namu̱ jab.&gt;&gt;<verse eid="GEN 42:38"/></para>
  <chapter eid="GEN 42"/>
  <chapter number="43" style="c" sid="GEN 43"/>
  <para style="s1">Ha-mu̱ u-yu̱ru̱mse̱ u̱ <optbreak/> dak-u̱ Masar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1"/>Me̱r-su̱ re̱g u-shu̱ u̱ no̱m-du̱ u-tát u̱ dak-u̱ Kan'ana. <verse eid="GEN 43:1"/><verse number="2" style="v" sid="GEN 43:2"/>M-vaste̱, Yakubu u̱ ya-u-bu wa ne̱ tase̱ re-du̱ no̱m u̱t-re̱ u̱ u̱n kabne̱ du̱gu̱ dak-u̱ Masar, Yakubu zu̱ u̱n, &lt;&lt;Barmu̱n u̱ Masar no̱ sur m-o̱o̱n in no̱m u̱t-re̱.&gt;&gt;<verse eid="GEN 43:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3"/>Se̱di Yahuda zu̱ wu̱n, &lt;&lt;Ne̱t wu̱ babne̱ it no̱m u̱t-re̱ no̱ngu̱ it u̱s-rem u̱r-be̱b ne̱ u̱zu̱, &lt;A no̱ haane̱ u̱ du̱-dim-u̱ no̱ ne̱ da, no̱ za hyanu̱ shu̱-u ri da.&gt; <verse eid="GEN 43:3"/><verse number="4" style="v" sid="GEN 43:4"/>A mu̱ne̱ u̱zu̱ bo̱ yaag it do̱'e̱ u̱du̱ du̱-fade̱ it ne̱, it u̱ u̱t-ha it o̱o̱nu̱ bo̱ no̱m u̱t-re̱. <verse eid="GEN 43:4"/><verse number="5" style="v" sid="GEN 43:5"/>Tu̱msu̱ a-bo̱ zu̱ye̱ it do̱'e̱ u̱ du̱-dim-u̱ it ne̱ da, it zaar m-ha da. U̱m zu̱u̱g iya remu̱ zu̱ ne̱t-u̱ wa zu̱u̱g it, &lt;No̱ za hyanu̱ shu̱-u ri da, se̱ no̱ hagu̱n u̱ du̱-dim-u̱ no̱ ne̱.&gt; &gt;&gt;<verse eid="GEN 43:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6"/>Isra shit wa zu̱ u̱n, &lt;&lt;¿Ya wa'e̱ no̱ no̱mtu̱ me̱ no̱mtu̱ za so̱-to̱? ¿Yan-o̱ wa'e̱ no̱ wartu̱ ne̱t-u̱ wa u̱zu̱ no̱ o̱tte̱ du̱-dim?&gt;&gt;<verse eid="GEN 43:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7"/>E̱ shu̱s e̱ zu̱ wu̱n, &lt;&lt;Ne̱t-u̱ wa no̱mgu̱ it u̱r-shu̱t du̱ yu̱-du̱ u-bu it. Wa shit it, &lt;¿U̱so-u no̱ o̱mo̱n u̱r-fat? ¿No̱ o̱mo̱n u̱ du̱-dim-u̱ no̱ ne̱?&gt; Da-u o̱ it o̱nke̱ shu̱t-du̱ wa no̱me̱ it, ¿it nak u̱zu̱ wa do̱'e̱ u̱t-zu̱, &lt;Kabnu̱n du̱-dim-u̱ no̱ u̱ haan u̱ ana&gt;?&gt;&gt;<verse eid="GEN 43:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8"/>Yahuda zu̱ Isra u̱so-u wa, &lt;&lt;Yage̱ it ha u̱du̱ du̱-dim-u̱ it ne̱, remu̱ it do̱'e̱ it kwu̱mu̱n no̱m u̱t-re̱, remu̱ zu̱ tass in mar u̱ ya'ag-u̱ in ne̱ da. <verse eid="GEN 43:8"/><verse number="9" style="v" sid="GEN 43:9"/>Me̱ hi-du̱ war ri me̱ mu̱u̱tu̱n wu̱n m-yar. Gwat wu̱n u̱ ko̱m-u̱t ri, a mu̱ne̱ u̱zu̱ u̱m mu̱u̱tu̱n wu̱n u̱-shu̱ ró da, yage̱ hyu̱-m ró u̱ shu̱'u̱t u̱ hi-u̱r ri m-mo̱mmo̱. <verse eid="GEN 43:9"/><verse number="10" style="v" sid="GEN 43:10"/>Abite̱ u̱zu̱ in naaste̱ u-da da, in za haag u-yu̱r u̱ Masar kanda uno̱ da-o̱.&gt;&gt;<verse eid="GEN 43:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11"/>Se̱ u̱so-u u̱n Isra zu̱ u̱n, &lt;&lt;A mu̱ne̱ u̱zu̱ yaku̱n fu̱n-ya zaar da, se̱ no̱ kab no̱m-u̱t so̱-to̱ tu̱ u-dak no̱ wa u̱t-ba. No̱ hu̱tu̱ wu̱n u-nya. No̱m-tu̱ wu̱s u-haku̱n ne̱, u̱ bu̱-mu̱ so̱ ne̱, u̱ po̱'o̱g-tu̱ fistashiyo ne̱ u̱ po̱'o̱g-tu̱ arman ne̱. <verse eid="GEN 43:11"/><verse number="12" style="v" sid="GEN 43:12"/>Kabu̱n shik i ze̱ge̱ i no̱ kabe̱ u-so u-yu̱r, no̱ kab shik i na wa'-u̱ no̱ u̱t-ba, remu̱ jiya u̱zu̱ swas-mo̱ na no̱me̱. <verse eid="GEN 43:12"/><verse number="13" style="v" sid="GEN 43:13"/>Kabu̱n du̱-dim-u̱ no̱ Banyamin tu̱msu̱, u̱ no̱ aru̱k m-mu̱ u̱du̱ ne̱t-u̱ wa za rem. <verse eid="GEN 43:13"/><verse number="14" style="v" sid="GEN 43:14"/>Me̱ u̱t-ko̱n u-Ru̱ wa-u̱r-be̱b du̱ ko̱-uyan, u̱ wa wa' ne̱tu̱ wa ho̱g o̱n-u̱r no̱ u̱ka wa do̱te̱ yagu̱ no̱ mu̱u̱n u̱r-kot u̱ Simiyo̱n ne̱ u̱ du̱-dim-u̱ no̱ Banyamin ne̱. Se̱di me̱ a mu̱ne̱ u̱zu̱ me̱ u̱t-taag u̱ ya'ag-u̱ ri ne̱, yage̱ u̱ shu̱'u̱t iya.&gt;&gt;<verse eid="GEN 43:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15"/>Se̱ ne̱t-u̱t to̱ ku̱b nya-u̱ u̱so-u u̱n zu̱ye̱ u̱n kab, u̱ shik ne̱ i ze̱ge̱ i u̱r-taku̱n u-so u-yu̱r, se̱ e̱ ku̱b Banyamin. E̱ aru̱k m-ho̱r m-ho̱r m-ha u̱ Masar, e̱ ees shu̱ Yusuhu. <verse eid="GEN 43:15"/><verse number="16" style="v" sid="GEN 43:16"/>Da-u̱ Yusuhu hyane̱ Banyamin u̱ u̱n ne̱, wa zu̱ wa-gwat-du̱ bu-u wa, &lt;&lt;Kab ne̱t-u̱t to̱ m-ha u̱ bu-u ri. Bo̱ ho̱-u̱ e̱ u-bisa bo̱ no̱mu̱ u̱n no̱m u̱t-re̱ u-ho̱. U̱n de̱ re̱-du̱ no̱m u̱t-re̱ u̱r-ho̱ te̱k u̱ me̱ ne̱ u̱r-koto.&gt;&gt;<verse eid="GEN 43:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 43:17"/>Ne̱t-u̱ wa nom u̱ka Yusuhu zu̱tte̱ wa no̱m, wa toot e̱ u̱ bu-u Yusuhu. <verse eid="GEN 43:17"/><verse number="18" style="v" sid="GEN 43:18"/>E̱ hog u-gye̱r so̱k remu̱ zu̱ na kagu̱b e̱ m-ha u̱ bu-u Yusuhu. E̱ nom u̱s-dorog u̱zu̱, &lt;&lt;Remu̱ zu̱ na wa'ag-u̱ in shik-u̱ ba-u̱t in o̱ wa'e̱ na ku̱bu̱t in m-ha u-bu, wa u̱t-sa wa maas in u̱t-baas ne̱, u̱ remu̱ wa muut in to̱k-ne̱ tu̱msu̱ wa o̱nk janka in.&gt;&gt;<verse eid="GEN 43:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 43:19"/>Da-u̱ u̱n teene̱ is-u̱ bu-u Yusuhu, u̱n no̱mu̱ wa-gwat-du̱ bu-u Yusuhu u̱s-rem. <verse eid="GEN 43:19"/><verse number="20" style="v" sid="GEN 43:20"/>U̱n zu̱ wa, &lt;&lt;Gag jab, u̱so u-bu ri, it hagu̱n u̱ ana u̱r-taku̱n remu̱ it oot no̱m u̱t-re̱. <verse eid="GEN 43:20"/><verse number="21" style="v" sid="GEN 43:21"/>Da-u̱ it teye̱ be-du̱ it do̱te̱ u̱-cu̱s m-gye̱p, it u-pus ba-u̱t it, it bit shik i ko̱wan u̱ ba-u̱r wa. It mu̱tu̱n e̱ ho̱n-ho̱n u̱ka na ya'aste̱ it. Rem iya it mu̱u̱tu̱n e̱. <verse eid="GEN 43:21"/><verse number="22" style="v" sid="GEN 43:22"/>It haagu̱n u̱ e̱ke̱n shike̱ ne̱ remu̱ it oot o̱ko̱n no̱m u̱t-re̱ o̱. It nak ko̱wana wa'e̱ it shik u̱t-ba da.&gt;&gt;<verse eid="GEN 43:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23"/>Wa zu̱ u̱n, &lt;&lt;No̱nge̱, a no̱ ho̱g u-gye̱r da. Ru̱-u no̱, o̱ye̱ Ru̱-u̱ u̱so-u no̱, wa wa'-u̱ no̱ shik-u̱ ba-u̱t no̱, u̱m o̱nkte̱ shik no̱ to̱pe̱.&gt;&gt; Se̱ wa rwu̱tu̱n Simiyo̱n u̱ be-du̱ u̱n o̱tte̱.<verse eid="GEN 43:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 43:24"/>Wa-gwat-du̱ bu-u Yusuhu ku̱b u̱n m-ha bu-u Yusuhu. Wa ye u̱n m-bu̱ u̱n jaas u̱s-na u-bu, se̱ wa ye janka u̱n no̱m u̱t-re̱. <verse eid="GEN 43:24"/><verse number="25" style="v" sid="GEN 43:25"/>U̱n zo̱ng no̱mu̱ Yusuhu u-nya a wa mu̱ne̱ u-ho̱, remu̱ zu̱ u̱n ho̱k u̱zu̱ u̱n u̱ e̱ ne̱ do̱'e̱ no̱m-du̱ u-re̱ u̱r-kot.<verse eid="GEN 43:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 43:26"/>Da-u̱ Yusuhu mu̱ne̱ u-bu, se̱ u̱n kabnu̱ wa nya-u̱ u̱n haane̱ u̱ o̱ne̱ u-bu, u̱n he̱ u-dak u̱-shu̱ wa. <verse eid="GEN 43:26"/><verse number="27" style="v" sid="GEN 43:27"/>Wa shit u̱ka u̱n o̱tte̱, se̱ wa zu̱, &lt;&lt;¿Re̱-o̱ u-ne̱nge̱n u̱so no̱ wu̱ no̱ waru̱ me̱? ¿Wa o̱mo̱n u̱r-fat?&gt;&gt;<verse eid="GEN 43:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28"/>U̱n shu̱s u̱n zu̱, &lt;&lt;U̱, to̱k-u̱ ró u̱so-u it o̱ m-yar.&gt;&gt; Se̱ u̱n host u̱t-ka'at u̱n kaku̱s hi-u̱t u̱n u-dak u̱n yu̱ wa m-ze̱g.<verse eid="GEN 43:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29"/>Da-u̱ Yusuhu gwate̱ se̱ wa hyen du̱-dim-u̱ wa Banyamin, (wu̱ na mate̱ e̱ wane̱ u-ino̱ u-gan), wa zu̱, &lt;&lt;¿Unwa o̱ du̱-dim-u̱ no̱, wu̱ no̱ ware̱ me̱?&gt;&gt; Wa zu̱ Banyamin, &lt;&lt;Ru̱-u̱ nom u̱r-kot u̱ bo̱ ne̱, wa wa'-u̱ bo̱ u-kom, wa'-u̱ zwar.&gt;&gt; <verse eid="GEN 43:29"/><verse number="30" style="v" sid="GEN 43:30"/>Se̱ gu̱t-du̱ u̱s-kan haan Yusuhu u̱ shu̱ o̱r-u̱t wa ne̱, se̱ wa aru̱k m-cwa u-kur u̱-me̱, wa nom u̱s-kan u̱ku̱n.<verse eid="GEN 43:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 43:31"/>Da-u̱ wa tase̱ u̱s-kan, wa sa'ap u-shu̱ wa mu̱u̱n u̱du̱ u̱n. Wa garu̱g hi-u̱r wa, wa zu̱ na mo̱t no̱m u̱t-re̱.<verse eid="GEN 43:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 43:32"/>Na yu̱ Yusuhu u̱-wa no̱m u̱t-re̱ o̱, na ye tu̱-wu̱to̱ Yusuhu u̱ e̱ no̱m u̱t-re̱ o̱, na yu̱ ne̱t-u̱ Masar u̱ e̱ no̱m u̱t-re̱ o̱. E̱ no̱ng iya remu̱ zu̱ ne̱t-tu̱ Masar reet u̱r-kot u̱ Ibra-ne̱ da remu̱ zu̱ no̱m-tu̱ m-'e̱ to̱ u̱du̱ ne̱t-tu̱ Masar e̱ no̱m u-re̱ ne̱t-tu̱ Ibra-ne̱. <verse eid="GEN 43:32"/><verse number="33" style="v" sid="GEN 43:33"/>Na shu̱gu̱sse̱ o̱r-u̱t Yusuhu u̱-shu̱ wa, ko̱wan u̱ka hak-su̱ u̱r-mat-u̱ wa, du̱gu̱ yu̱-wu̱ya u̱-haan u̱ du̱-dim, u̱n got o̱r-u̱t u̱n kowan hu̱ mu̱rimmo̱. <verse eid="GEN 43:33"/><verse number="34" style="v" sid="GEN 43:34"/>Yusuhu wu̱ na ya u̱n no̱m u̱t-re̱ u̱ na haatu̱n u̱ shu̱ wa. Tu̱msu̱ na yu̱ Banyamin o̱g-u̱r yadde̱ m-ze̱g du̱ ko̱wan uso̱ u-tan, se̱ u̱n re u̱n so jab gan.<verse eid="GEN 43:34"/></para>
  <chapter eid="GEN 43"/>
  <chapter number="44" style="c" sid="GEN 44"/>
  <para style="s1">Ko̱pi du̱ m-bak-u̱t <optbreak/> (azurpa) u̱r-ba</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1"/>Yusuhu yu̱ wa-gwat-du̱ bu-u wa tun-to̱ bo̱r-to̱, &lt;&lt;Shu̱u̱se̱ ba-u̱t u̱n u̱ hyu̱ u̱ka u̱n do̱te̱ u̱t-kere̱ u̱t-kab m-mu̱, tu̱msu̱ bo̱ wa'u̱ shik-u̱ ko̱wan u̱ ba-u̱r wa.&gt;&gt; <verse eid="GEN 44:1"/><verse number="2" style="v" sid="GEN 44:2"/>Yusuhu zu̱ wa-gwat-du̱ bu wa, &lt;&lt;Wa ko̱k-du̱ swadu̱ m-bu̱ ri du̱ m-baku̱t, ba-du̱ du̱-dim-u̱ u̱n, u̱r-kot u̱ shik-u̱ hyu̱ wu̱n ne̱.&gt;&gt; Wa no̱m u̱ka Yusuhu zu̱tte̱ wa no̱m.<verse eid="GEN 44:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 44:3"/>Da-u̱ is gase̱, na tom ne̱t-u̱t to̱ e̱ aru̱k m-mu̱ u̱ janka u̱n ne̱. <verse eid="GEN 44:3"/><verse number="4" style="v" sid="GEN 44:4"/>Da-u̱ u̱n arke̱ u̱n teeg m-ra u-bo̱ ne̱ sok da, Yusuhu tom wa-gwat-du̱ bu-u wa, &lt;&lt;Abo̱ bite̱ u̱n bo̱ zu̱ u̱n, &lt;It no̱mgu̱ no̱ no̱m-u̱t so̱-to̱, ¿Remu̱ u-yan o̱ wa'e̱ no̱ top-u̱t no̱m-u so̱-o̱ u̱ yo̱-o̱? <verse eid="GEN 44:4"/><verse number="5" style="v" sid="GEN 44:5"/>¿Dinde̱ a ko̱k-du̱ m-bu̱ du̱ u̱so u-bu ri da du̱ wa gotte̱ no̱mu̱ do̱'e̱ u̱t-no̱m u-shu̱? Uno̱ no̱mu yo̱-o̱ o̱ no̱ no̱me̱.&gt; &gt;&gt;<verse eid="GEN 44:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6"/>Da-u̱ wa bite̱ u̱n, se̱ wa waru̱ u̱n no̱mu̱ Yusuhu zu̱ wa u-be̱e̱t. <verse eid="GEN 44:6"/><verse number="7" style="v" sid="GEN 44:7"/>E̱ shu̱s e̱ zu̱ wa, &lt;&lt;¿Yan o̱ wa'e̱ u̱so u-bu ri bo̱ u̱t-zu̱ inya? It to̱k-ne̱ ró e̱, it tamu̱g no̱m-du̱ o̱ko̱n go̱-du̱ uno̱ da. <verse eid="GEN 44:7"/><verse number="8" style="v" sid="GEN 44:8"/>It mu̱u̱tu̱n shik-u̱ it bite̱ u̱ ba-u̱t it da-u̱ it muye̱ Kan'ana. ¿Remu̱ yan-o̱ it do̱te̱ hiw-du̱ kwam-tu̱ shik tu̱ bu̱-mu̱ u̱t-ro u̱ tu̱ pus-to̱ ne̱ du̱gu̱-du̱ u̱so-u̱ bu-u ró? <verse eid="GEN 44:8"/><verse number="9" style="v" sid="GEN 44:9"/>A-bo̱ hyane̱ waku̱n u̱ ko̱k-du̱ m-bu̱ de̱ ne̱ it, ho̱ wa. Tu̱msu̱ it i kuse̱ be̱e̱t e̱ shu̱u̱t to̱k-ne̱ ró.&gt;&gt;<verse eid="GEN 44:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10"/>Ne̱t-u̱ wa zu̱, &lt;&lt;No̱nge̱, me̱ no̱mu̱ no̱m-u̱ no̱ zu̱ye̱. Se̱di wu̱ na hyane̱ u̱ ko̱k-du̱ m-bu̱ ne̱ wa do̱'e̱ u̱t-shu̱'u̱t to̱k-u̱ ri, no̱ i kuse̱ no̱ aru̱k m-mu̱ u-bu.&gt;&gt;<verse eid="GEN 44:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 44:11"/>Se̱ u̱n be̱e̱t kowan cu̱stu̱n ba-u̱r wa du̱gu̱ janka u̱n, tu̱msu̱ e̱ upus to̱. <verse eid="GEN 44:11"/><verse number="12" style="v" sid="GEN 44:12"/>Wa-gwat-du̱ bu-u Yusuhu he̱e̱se̱ u̱t-goot, du̱gu̱-du̱ yu̱-wu̱ya u̱ haan u̱du̱ du̱-dim. Se̱ na hyen ko̱k-du̱ m-bu̱ de̱ ba-u̱r Banyamin. <verse eid="GEN 44:12"/><verse number="13" style="v" sid="GEN 44:13"/>Remu̱ iya, se̱ e̱ keemse̱ kus-u̱t e̱. Tu̱msu̱ e̱ gagu̱ janka u̱t-cwu̱, e̱ bir m-mu̱ u-bo̱.<verse eid="GEN 44:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14"/>Da-u̱ Yahuda u̱ o̱r-u̱t wa ne̱ mu̱ne̱ u-dim, se̱ e̱ to bu-u Yusuhu. Yusuhu o̱mo̱n u̱ shu̱'u̱t, wa-gwat-du̱ Yusuhu wa waru̱ wa no̱mu̱ no̱me̱ u-be̱e̱t. Tu̱-wu̱to̱ Yusuhu ne̱ be̱e̱t e̱ he u-dak u̱-shu̱ wa. <verse eid="GEN 44:14"/><verse number="15" style="v" sid="GEN 44:15"/>Yusuhu zu̱ u̱n, &lt;&lt;¿Yan-o̱ no̱ no̱me̱ inya? ¿No̱ nak u̱zu̱ ne̱t ba me̱ u̱ napu̱ no̱mu̱ waku̱n nape̱ da?&gt;&gt;<verse eid="GEN 44:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16"/>Yahuda shu̱s, wa zu̱, &lt;&lt;U̱so u-bu ri, ¿Yan rem-se̱ it de̱ u̱t-no̱me̱? ¿Re̱-o̱ it do̱te̱ ko̱su̱ ko̱b-du̱ u̱t-ba'as u̱ it? Ru̱-o̱ no̱mu̱ it to̱p-u̱ no̱mu̱ it no̱me̱. Remu̱ iya it be̱e̱t it-u̱ u̱t-shu̱'u̱t to̱k-ne̱ u̱ wu̱ na bite̱ u̱ ko̱k-du̱ m-bu̱ ba-u̱r wa.&gt;&gt;<verse eid="GEN 44:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17"/>Yusuhu zu̱, &lt;&lt;U̱m za kere̱ no̱m-du̱ o̱ko̱n u̱ka no̱ zu̱tte̱ da, u̱ Ru̱-u̱ mang. Wu̱ hiwe̱ ko̱k-du̱ m-bu̱ wa do̱'e̱ u̱t-shu̱'u̱t to̱k-u̱ ri. No̱ kuse̱ se̱ no̱ aru̱k m-mu̱ u̱ bu-u̱ u̱so-u no̱ u̱ jab-u̱ pus-o̱.&gt;&gt;<verse eid="GEN 44:17"/></para>
  <para style="s1">Ko̱n-u̱s Yahuda <optbreak/> remu̱ Banyami</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18"/>Yahuda haan u̱du̱ Yusuhu wa zu̱, &lt;&lt;U̱so u-bu ri, gag jab, yage̱ to̱k-u̱ ró no̱m u̱s-rem u̱ bo̱ ne̱. A-bo̱ no̱m u̱s-ryab u̱ to̱k-u̱ ró da, ko̱ ba shu̱'u̱te̱ u̱zu̱ bo̱ o̱ u̱r-be̱b ne̱ u̱ka Faru̱k-u̱ Masar. <verse eid="GEN 44:18"/><verse number="19" style="v" sid="GEN 44:19"/>U̱so u-bu ri shu̱ku̱t to̱k-u̱ wa, &lt;¿No̱ o̱mo̱n u u̱so ne̱ ko̱ tu̱ dim-u̱ no̱ u̱r-fat?&gt; <verse eid="GEN 44:19"/><verse number="20" style="v" sid="GEN 44:20"/>It zu̱ u̱so u-bu ri, &lt;Wa o̱mo̱n u̱r-fat se̱di wa wu̱u̱mte̱. Se̱di wa o̱tte̱ u̱r-vaste̱ du̱ wa mate̱ da-u̱ wa wu̱u̱me̱. Yu̱-wu̱ya wa maru̱g, hu̱no-u wa kuse̱ u-gan u̱du̱ ino-u wa, u̱so-u e̱ o̱ cwan-u̱t wa sok.&gt;<verse eid="GEN 44:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 44:21"/>&lt;&lt;Bo̱ zu̱ to̱k-ne̱ ró haatu̱n wa u̱du̱ ró, bo̱ hyan wa u̱ hi-du̱ war ró. <verse eid="GEN 44:21"/><verse number="22" style="v" sid="GEN 44:22"/>It wargu̱ u̱so u-bu ri u̱zu̱, &lt;Wa'-u̱ wa yakte̱ u̱so-u wa da, u̱-re̱m u̱zu̱ awa yage̱ wa, u̱so wa u̱t-mar.&gt; <verse eid="GEN 44:22"/><verse number="23" style="v" sid="GEN 44:23"/>Bo̱ zu̱ it to̱k-u̱ ne̱ ró, &lt;A du̱-dim-u̱ no̱ haane̱ u̱r-kot u̱ no̱ ne̱ da, u̱m da yage̱ no̱ sur m-hyan shu̱-u ri da.&gt; <verse eid="GEN 44:23"/><verse number="24" style="v" sid="GEN 44:24"/>Da it muye̱ u̱du̱ u̱so-u it, it waru̱ wa no̱mu̱ u̱so u-bu ri zu̱ye̱.<verse eid="GEN 44:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 44:25"/>&lt;&lt;U̱so-u it zu̱, it mu̱u̱n it sur m-o̱o̱n no̱m u̱t-re̱. <verse eid="GEN 44:25"/><verse number="26" style="v" sid="GEN 44:26"/>Tu̱msu̱ it zu̱ wa, &lt;It zaaru̱ mu̱u̱n da, se̱ du̱-dim-u̱ it no̱k u̱r-kot u̱ it ne̱ u̱ da-u o̱ it do̱'e̱ u̱r-mu̱n. A du̱-dim-u̱ it do̱'e̱ u̱r-kot u̱ it ne̱ da, it zaar u̱t-sur m-hyan shu̱-u̱ ne̱t-u̱ wa da.&gt;<verse eid="GEN 44:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 44:27"/>&lt;&lt;To̱k-u̱ ró u̱so-u it zu̱, &lt;U̱ka no̱ nu̱pte̱, ne̱ta ri o̱tte̱ ya'ag-u̱ campa-ne̱ yu̱r, i wa mate̱ u̱du̱ ri. <verse eid="GEN 44:27"/><verse number="28" style="v" sid="GEN 44:28"/>Wa-gan aru̱kte̱ du̱gu̱-du̱ ri, se̱di u̱m zu̱, &lt;&lt;Na kemu̱sse̱ wu̱n u̱t-kik u̱t-kik.&gt;&gt; Du̱gu̱ da-u o̱, u̱m hyanu̱g wa da. <verse eid="GEN 44:28"/><verse number="29" style="v" sid="GEN 44:29"/>A no̱ kabe̱ unwa, tu̱msu̱ o̱ko̱n no̱m-o̱ kume̱ wa, no̱ wa'-u̱ hi-u̱r pus-de̱ ri de̱ ha u̱du̱ i mare̱ ne̱ u̱ remu̱ namu̱ jab.&gt;<verse eid="GEN 44:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 44:30"/>&lt;&lt;U̱-da o̱, u̱m za kere̱ u̱r-mu̱ u̱du̱ u̱so-u it za wa'-u̱ wa da. Remu̱ zu̱ jab-u̱ u̱so-u it o̱ m-sak u̱ fat-du̱ wa'-u̱ wa ne̱. <verse eid="GEN 44:30"/><verse number="31" style="v" sid="GEN 44:31"/>A mu̱ne̱ u̱zu̱ u̱so-u it hyanu̱g me̱ za wa'-u̱ wa, wa u̱t-mar. It to̱k-ne̱ ró it u̱t-wa u̱ hi-u̱r pus-de̱ u̱so-u it he̱ u-sag remu̱ namu̱ jab. <verse eid="GEN 44:31"/><verse number="32" style="v" sid="GEN 44:32"/>U̱m no̱mu̱g es-du̱ u̱s-rem u̱du̱ u̱so-u ri, u̱zu̱ me̱ mu̱tu̱n wu̱n u-bu m-yar. U̱m zu̱ wa, &lt;A mu̱ne̱ u̱zu̱ u̱m mu̱u̱tu̱n wu̱n u̱du̱ ró da, me̱ kabu̱ no̱mu̱ do̱'e̱ kwu̱m-du̱ wu̱n mo̱mmo a-mu̱u̱ne̱ u̱zu̱ u̱m mu̱u̱tu̱n wu̱n u̱ du̱ ró da.&gt;<verse eid="GEN 44:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 44:33"/>&lt;&lt;U̱ da-o̱, gag jab, yage̱ u̱ wa-m-ank-u̱ ró shu̱'u̱t to̱k-u̱ u̱so u-bu ri u̱ swas-mu̱ wa'-u̱ wa. Yage̱ wa'-u̱ wa aru̱k m-mu̱ e̱ tu̱-wu̱to̱ wa ne̱. <verse eid="GEN 44:33"/><verse number="34" style="v" sid="GEN 44:34"/>¿Re̱-o̱ u̱m do̱te̱ u̱r-mu̱ u̱du̱ u̱so-u ri, a mu̱ne̱ u̱zu̱ wa zaar u̱r-kot u̱ me̱ ne̱ da? A-bo̱ yage̱ u̱m swa u̱r-ko̱b du̱ do̱'e̱ u̱ haan u̱ u̱so ri da.&gt;&gt;<verse eid="GEN 44:34"/></para>
  <chapter eid="GEN 44"/>
  <chapter number="45" style="c" sid="GEN 45"/>
  <para style="s1">Yusuhu ko̱kse̱ hi-u̱r wa u̱du̱ <optbreak/> tu̱-wu̱to̱ wa ne̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1"/>Yusuhu ke̱rge̱ ho̱-du̱ u̱s-ram u̱ka wa o̱tte u̱t-ho̱g da. Wa zu̱ u̱ to̱k-ne̱ wa be̱e̱t e̱ aru̱k m-rwu̱ u̱-do̱ u̱ cwar-yu̱ u̱r-be̱b. E̱ yage̱ wa u-kur u̱ tu̱-wu̱to̱ wa ne̱. Da-u o̱ wa waru̱ u̱n u̱zu̱, &lt;&lt;Me̱ wa o̱ye̱ Yusuhu!&gt;&gt; <verse eid="GEN 45:1"/><verse number="2" style="v" sid="GEN 45:2"/>Wa jaku̱s cwar-yu̱ u̱s-kan m-yat! Se̱ ne̱t-tu̱ Masar tu̱ o̱o̱ge̱ u̱-do̱ hog wu̱n, tu̱msu̱ u̱ ne̱t-tu̱ pyu̱-u̱ Faru̱k-u̱ Masar ne̱ e̱ hog wu̱n.<verse eid="GEN 45:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 45:3"/>Yusuhu zu̱ o̱r-u̱t wa ne̱, &lt;&lt;Me̱ o̱ Yusuhu. ¿U̱so-u ri o̱mo̱n u̱r-fat?&gt;&gt; E̱ kerge̱ zu̱du̱ wu̱n o̱ko̱n da, remu̱ zu̱ gye̱r-yu̱ shu̱ku̱p e̱ sok.<verse eid="GEN 45:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 45:4"/>Se̱ Yusuhu zu̱ o̱r-u̱t wa, &lt;&lt;Hiknu̱n u̱t-mo̱r u̱-me̱ ne̱.&gt;&gt; Da u̱n hikne̱, wa zu̱ u̱n, &lt;&lt;Me̱ wa du̱-dim-u̱ no̱ wu̱ na zu̱ye̱ Yusuhu, wu̱ no̱ babe̱ to̱k-u̱ Masar.&gt;&gt; <verse eid="GEN 45:4"/><verse number="5" style="v" sid="GEN 45:5"/>A no̱ naas jab da ko̱ no̱ hyan na-m waku̱n da. U̱m zu̱u̱g iya remu̱ zu̱ Ru̱-o̱ ba m-haatu̱n me̱ u̱ ana remu̱ u̱m guut fat-u̱t no̱. <verse eid="GEN 45:5"/><verse number="6" style="v" sid="GEN 45:6"/>Na no̱ng u̱s-hak u̱s-yu̱r u̱s-me̱r u̱ da-o̱, kwu̱ku̱s u̱s-hak u̱s-tan, su̱ na za u̱r-to̱m da, na za tu̱msu̱ ket da. <verse eid="GEN 45:6"/><verse number="7" style="v" sid="GEN 45:7"/>Ru̱-o̱ to̱mnu̱ me̱ u̱m haan u̱-shu̱ no̱, remu̱ zu̱ na kus u̱t-ne̱t u̱-me̱ ko̱-u̱r no̱, iya o̱ fu̱n-yu̱ Ru̱-u̱ zo̱ngte̱ gwu̱du̱ no̱.<verse eid="GEN 45:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 45:8"/>&lt;&lt;Remu̱ iya a no̱ haatu̱n me̱ u̱ ana da, Ru̱-o̱ haatu̱n me̱ u̱ ana! Wa wa'ag u̱m shu̱'u̱t sha-mu̱ u̱so u̱du̱ Faru̱k-u̱ Masar. U̱m o̱ u̱so u-bu u̱ ko̱-uyan u̱-me̱ bu wa tu̱msu̱ u̱m o̱ wa-u̱r-faru̱k u̱ Masar u-be̱e̱t.&gt;&gt; <verse eid="GEN 45:8"/><verse number="9" style="v" sid="GEN 45:9"/>U̱-da o̱ no̱mo̱n m-ho̱r no̱ waru̱ u̱so u-bu ri u̱zu̱ no̱mu̱ wa'-u̱ wa Yusuhu zu̱ye̱ ya, &lt;&lt;Ru̱-u̱ muutu̱ me̱ u̱so ubu u̱ Masar u-be̱e̱t. Haane̱ u̱du̱ ri za naas u-da. <verse eid="GEN 45:9"/><verse number="10" style="v" sid="GEN 45:10"/>Bo̱ u̱t-ker shu̱'u̱t u̱t-mo̱r ne̱ u̱ Gas-u̱ Go̱sen, bo̱, u̱ ya'ag-u̱ ró ne̱, u̱ ya'ag-u̱ ya'ag-u̱ ró ne̱, u̱-ban-tu̱ ca u̱ ban-tu̱ gwaar ne̱, u̱ ban-tu̱ na-u̱ ró ne̱, u̱ ko̱-uyan u̱ o̱ye̱ u̱ ró. <verse eid="GEN 45:10"/><verse number="11" style="v" sid="GEN 45:11"/>Me̱ gwat-u̱ bo̱ u̱ hak-su̱ u̱s-tan su̱ u̱s-me̱r su̱ o̱o̱ne̱. Me̱ no̱mu̱ ka u̱m do̱te̱ u̱t-no̱m u-be̱e̱t u̱m ya bo̱ no̱m u̱t-re̱. A-bo̱ haane̱ u̱ ana da no̱ u̱ a-u-bu ró ne̱ u̱ to̱k-ne̱ ró be̱e̱t bo̱ u̱t-ho̱g u̱s-me̱r.&gt;&gt;<verse eid="GEN 45:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12"/>Yusuhu zu̱ u̱n, &lt;&lt;U̱ da-o̱ no̱ hyanu̱g hi-du̱ war-no̱, o̱r-u̱ ri Banyamin hyanu̱g u̱zu̱ me̱ wa o̱ye̱ Yusuhu, me̱ o̱ye̱ u̱s-remu̱ u̱ no̱ ne̱. <verse eid="GEN 45:12"/><verse number="13" style="v" sid="GEN 45:13"/>De̱e̱n, no̱ waru̱ u̱so-u ri u̱zu̱ na ya me̱ o̱g-u̱r yat-de̱ u̱ dak-u̱ Masar. De̱e̱n, no̱ waru̱ wu̱n no̱m-u̱ no̱ hyane̱ no̱ hatu̱n wu̱n u̱ ana za naas u-da.&gt;&gt;<verse eid="GEN 45:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14"/>Wa ham-u̱t Banyamin, wa hu̱ u̱s-kan su̱ u̱r-so̱. Banyamin ham-u̱t wa tu̱msu̱ wa hu̱ u̱s-kan. <verse eid="GEN 45:14"/><verse number="15" style="v" sid="GEN 45:15"/>Yusuhu ham-u̱t tu̱-wu̱to̱ wa ne̱ be̱e̱t wa hu̱ u̱s-kan. Da wa tase̱ se̱, e̱ he̱e̱se̱ u̱s-rem u̱ wa ne̱.<verse eid="GEN 45:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16"/>Da waku̱n hu̱u̱te̱ u̱s-rem u̱du̱ pyu̱-u̱ Faru̱k-u̱ Masar u̱zu̱ o̱r-u̱t Yusuhu hagu̱n, faru̱k-u̱ ne̱t-u̱t wa ne̱ nom u̱r-so̱ sok. <verse eid="GEN 45:16"/><verse number="17" style="v" sid="GEN 45:17"/>Faru̱k-u̱ Masar zu̱ Yusuhu, &lt;&lt;Waru̱ tu̱-wu̱to̱ ró no̱mu̱ u̱m u̱t-sa no̱ no̱m-u̱ ya: Saku̱n bisa-u̱t no̱ hyu̱ no̱ aru̱k m-mu̱ u̱ dak-u̱ Kan'ana. <verse eid="GEN 45:17"/><verse number="18" style="v" sid="GEN 45:18"/>De̱'e̱ bo̱ waru̱ u̱so-u ró u̱ ne̱t-tu̱ u-bu ró ne̱ e̱ mu̱u̱n u̱du̱ ri. Me̱ ya bo̱ dak-u̱ ze̱ge̱ u̱r-zwar, dak-u̱ Masar, bo̱ re̱ kwu̱m-tu̱ u-dak.&gt;&gt;<verse eid="GEN 45:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 45:19"/>&lt;&lt;Tu̱msu̱ waru̱ u̱n u̱zu̱, &lt;No̱mu̱ u̱m u̱t-sa no̱ no̱m-u̱ ya,&gt; Kabu̱n ke̱ke̱-yu̱ u-jwaak du̱gu̱ Masar, remu̱ no̱ kabtu̱n ya'ag-u̱ re̱k-e̱ u̱ ne̱ta-u̱t no̱ ne̱, no̱ haan u̱ u̱so-u no̱ ne̱ u̱ ana u̱ dak-u̱ Masar. <verse eid="GEN 45:19"/><verse number="20" style="v" sid="GEN 45:20"/>A no̱ naas jab-u̱ kwu̱m-u̱t no̱ ne̱ da, remu̱ zu̱ no̱m-u̱t so̱-to̱ tu̱ Masar to̱ do̱'e̱ u̱t-shu̱'u̱t tu̱ no̱. Rem iya, a se̱ no̱ kabgu̱n u̱t-no̱m du̱gu̱ Kan'ana da.&gt;&gt;<verse eid="GEN 45:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21"/>Yaag-u̱ campa-ne̱ Isra nom iya u̱ka faru̱k zu̱tte̱ e̱. Yusuhu yu̱' u̱n ke̱ke̱-su̱ jwaak u̱ka Faru̱k-u̱ Masar zu̱tte̱. Tu̱msu̱ wa yu̱' u̱n no̱m u̱t-re̱ u̱n do̱'e̱ u̱t-re̱ u̱-do̱mu̱ fu̱n. <verse eid="GEN 45:21"/><verse number="22" style="v" sid="GEN 45:22"/>Yusuhu yaag u̱n be̱e̱t kus-u̱t po-to̱, tu̱msu̱ u̱du̱ Banyamin wa yase̱ ko̱nko̱ shik u̱t-ko̱k u̱t-tu̱t [300], u̱ kus-u̱t po-to̱ ne̱ uso̱ u-tan. <verse eid="GEN 45:22"/><verse number="23" style="v" sid="GEN 45:23"/>Tu̱msu̱ no̱m-tu̱ wa to̱mtu̱n u̱so-u wa ya, no̱m-u̱t so̱-to̱ tu̱ Masar wa wu̱' to̱ do̱m-u̱ gob-u̱ janka o̱p. Wa yu̱' wu̱n hyu̱ u̱ u̱r-be̱re̱di ne̱ u̱ remu̱ ha-m wu̱n u̱ Masar tu̱msu̱ wa wu̱' to̱ do̱m-u̱ mangu̱ janka o̱p. <verse eid="GEN 45:23"/><verse number="24" style="v" sid="GEN 45:24"/>Tu̱msu̱ da u̱n o̱o̱ge̱ u̱ mo̱ttu̱ u̱r-aru̱k wa zu̱ u̱n, &lt;&lt;A no̱ no̱m u-har u̱ do̱m u-fu̱n da!&gt;&gt; Se̱ wa tok o̱r-u̱t wa ne̱ u̱n aru̱k.<verse eid="GEN 45:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25"/>E̱ yage̱ Masar, e̱ aru̱k m-mu̱ u̱du̱ u̱so-u e̱ Yakubu u̱ dak-u̱ Kan'ana. <verse eid="GEN 45:25"/><verse number="26" style="v" sid="GEN 45:26"/>U̱n zu̱ u̱so-u u̱n, &lt;&lt;Yusuhu o̱mo̱n u̱r-fat! Faru̱k-u̱ Masar wa'ag wu̱n damra ne̱t Masar.&gt;&gt; Se̱ jab-u̱ Yakubu yu̱ne̱ wa kerge̱ u̱s-rem da. <verse eid="GEN 45:26"/><verse number="27" style="v" sid="GEN 45:27"/>Da-u̱ u̱n waru̱ wa no̱m-u̱ Yusuhu zu̱ye̱ u-be̱e̱t, da-u̱ wa hyane̱ ke̱ke̱-su̱ u-jwaak su̱ wa to̱mtu̱n na kabu̱n wu̱n u̱ haan u̱ Masar, se̱ jab-u̱ u̱so u̱n Yakubu tor. <verse eid="GEN 45:27"/><verse number="28" style="v" sid="GEN 45:28"/>Tu̱msu̱ Isra zu̱, &lt;&lt;U̱m eeste̱ u̱ da-o̱ u̱zu̱ wa'-u̱ ri Yusuhu o̱mo̱n u̱r-fat. Me̱ u̱t-do̱'e̱ u̱m hyan wa kanda u̱m mar.&gt;&gt;<verse eid="GEN 45:28"/></para>
  <chapter eid="GEN 45"/>
  <chapter number="46" style="c" sid="GEN 46"/>
  <para style="s1">Yakubu haag u̱ dak-u̱ Masar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1"/>Se̱ Isra ku̱b ko̱-uyan u̱ wa o̱tte̱ wa aru̱k m-ha u̱ dak-u̱ Masar. Da-u̱ wa teene̱ bo̱-u̱ Be̱rshe̱ba, wa no̱m ya-du̱ to̱o̱g u̱du̱ Ru̱-u̱ u̱so-u wa Ishaku.<verse eid="GEN 46:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 46:2"/>M-gyu̱p Isra nom u-hyan Ru̱-u̱ no̱m u̱s-rem u̱ wa ne̱. Wa zu̱, &lt;&lt;Yakubu! Yakubu!&gt;&gt;</para>
  <para style="p" vid="GEN 46:2">Wa shu̱s wa zu̱, &lt;&lt;Me̱ ya ana!&gt;&gt;<verse eid="GEN 46:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3"/>Se̱ wa zu̱, &lt;&lt;Me̱ o̱o̱ge̱ u-Ru̱ u̱ u̱so-u ró. A-bo̱ ho̱g u-gye̱r da do̱'e̱ u̱ Masar. Remu̱ zu̱ u̱ ku̱na, u̱m do̱te̱ u̱t-wa u̱ ko̱-u̱r ró no̱m u-tát u̱ku̱n. <verse eid="GEN 46:3"/><verse number="4" style="v" sid="GEN 46:4"/>Me̱ u̱t-ha u̱ no̱ ne̱ u̱ dak-u̱ Masar, me̱ mu̱u̱tu̱n no̱ tu̱msu̱ u̱ dak-u̱ Kan'ana. Bo̱ u̱t-mar u̱ dak-u̱ Masar, wa'-u̱ ró Yusuhu wa do̱'e̱ jwak-du̱ bo̱.&gt;&gt;<verse eid="GEN 46:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5"/>Da-u̱ Yakubu yage̱ bo̱-u̱ Be̱rshe̱ba, ya'ag-u̱ campa-ne̱ wu̱n ku̱b wu̱n m-ha u̱ Masar. E̱ ku̱b Isra, u̱ yaag ne̱, u̱ ne̱ta-u̱t e̱ ne̱, u̱ ke̱ke̱-su̱ u-jwaak yu̱ Faru̱k-u̱ Masar yase̱ na kabu̱n u̱n. <verse eid="GEN 46:5"/><verse number="6" style="v" sid="GEN 46:6"/>E̱ ku̱b na e̱ u̱ bisa-tu̱ u-bu ne̱ tu̱ e̱ kume̱ u̱ dak-u̱ Kan'ana, tu̱msu̱ Yakubu u̱ ko̱-u̱r wa ne̱ u̱r-be̱e̱t e̱ aru̱k m-ha u̱ dak-u̱ Masar. <verse eid="GEN 46:6"/><verse number="7" style="v" sid="GEN 46:7"/>Yakubu aru̱k m-ha u̱ Masar u̱ ya'ag-u̱ wa ne̱ be̱e̱t, u̱ ya'ag-u̱ ya'ag-u̱ wa ne̱, ya'ag-u̱ campa-ne̱, u̱ ya'ag-u̱ ne̱ta-ne̱, u̱ ko̱-u̱r wa ne̱ u̱r-be̱e̱t.<verse eid="GEN 46:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8"/>Unto̱ to̱ o̱ye̱ dim-tu̱ ya'ag-u̱ campa-ne̱ Isra (Yakubu u̱ ko̱-u̱r wa ne̱) e̱ do̱'e̱ u̱ dak-u̱ Masar:</para>
  <para style="li1" vid="GEN 46:8">Rube̱n wa o̱ye̱ mat-du̱ u-shu̱ Yakubu.<verse eid="GEN 46:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="GEN 46:9"/>Yaag-u̱ campa-ne̱, i na mate̱ Rube̱n dim-u̱t e̱ na zu̱ye̱:</para>
  <para style="li1" vid="GEN 46:9">Hano̱k, Paru, He̱zo̱n, Hazro̱n u̱ Karami ne̱.<verse eid="GEN 46:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="GEN 46:10"/>Yaag-u̱ campa-ne̱ Simiyo̱n e̱ o̱ye̱:</para>
  <para style="li1" vid="GEN 46:10">Je̱miye̱r, Jamin, O̱had, Jakin, Zo̱har, u̱ Shawuru (wa'-u̱ ne̱ta yu̱ Kan'ana).<verse eid="GEN 46:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="GEN 46:11"/>Yaag-u̱ campa-ne̱ Re̱wi e̱ na zu̱ye̱:</para>
  <para style="li1" vid="GEN 46:11">Gaso̱n, Ko̱hat, u̱ Mirari.<verse eid="GEN 46:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="GEN 46:12"/>Yaag-u̱ campa-ne̱ Yahuda e̱ na zu̱ye̱:</para>
  <para style="li1" vid="GEN 46:12">Er, u̱ Onan, u̱ Shera, Pe̱re̱z, u̱ Ze̱ra. (Tu̱msu̱ Er u̱ Onan maru̱g u̱ dak-u̱ Kan'ana).</para>
  <para style="li1" vid="GEN 46:12">Yaag-u̱ Pe̱re̱z e̱ o̱ye̱: He̱zo̱n u̱ Hamur.<verse eid="GEN 46:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 46:13"/>Yaag-u̱ campa-ne̱ Issakar e̱ o̱ye̱:</para>
  <para style="li1" vid="GEN 46:13">Tora, u̱ Fo̱wa, u̱ Yashub, u̱ Shimaro̱n.<verse eid="GEN 46:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 46:14"/>Yaag-u̱ campa-ne̱ Ze̱burun e̱ o̱ye̱:</para>
  <para style="li1" vid="GEN 46:14">Se̱re̱, E̱ro̱n, u̱ Yareyer.<verse eid="GEN 46:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 46:15"/>Ine̱ e̱ o̱ye̱ ya'ag-u̱ campa-ne̱ Riya i wa mate̱ Yakubu u̱ dak-u̱ Padan-aram, u̱r-kot u̱ gwu̱p-u̱ e̱ ne̱ Dinatu. Tat-u̱ ya'ag-u̱ Yakubu (ya'ag-u̱ ne̱ta-ne̱ ya'ag-u̱ campa-ne̱) i wa kume̱ du̱gu̱-du̱ Riya u̱r-shik u̱r-gan u̱ o̱p-u̱ tu̱t [33].<verse eid="GEN 46:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="GEN 46:16"/>Yaag-u̱ campa-ne̱ Gad e̱ o̱ye̱:</para>
  <para style="li1" vid="GEN 46:16">Zifiyon, Hagai, Shuni, Ezbon, E̱ri, Arodi, u̱ Are̱ri.<verse eid="GEN 46:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="GEN 46:17"/>Yaag-u̱ Ashu̱r campa-ne̱ e̱ o̱ye̱:</para>
  <para style="li1" vid="GEN 46:17">Imna, Isba, Isbi, u̱ Beriya u̱ hu̱no̱ e̱ ne̱ Sera. Yaag-u̱ campa-ne̱ Beriya e̱ o̱ye̱: Heba u̱ Markiyer ne̱.<verse eid="GEN 46:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="GEN 46:18"/>Ine̱ e̱ o̱ye̱ ya'ag-u̱ Zirpa matu̱ Yakubu, i Raban yasu̱ gwu̱p-u̱ wa Riya e̱ o̱ o̱p u̱ shishin [16].<verse eid="GEN 46:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="GEN 46:19"/>Yaag-u̱ campa-ne̱ Rahira ne̱ta Yakubu, yaag-e̱ yu̱r:</para>
  <para style="li1" vid="GEN 46:19">Yusuhu ne̱ e̱ Banyamin. <verse eid="GEN 46:19"/><verse number="20" style="v" sid="GEN 46:20"/>U̱ dak-u̱ Masar, o̱ na mat-tu̱ Yusuhu Manase ne̱ e̱ Ifaramu. Dim-du̱ ino u̱n na zu̱ye̱ Asenat, gwu̱p-u̱ Potipera wa-to̱o̱g-u̱ bo̱-u̱ O̱n.<verse eid="GEN 46:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="GEN 46:21"/>Yaag-u̱ campa-ne̱ Banyamin e̱ o̱ye̱:</para>
  <para style="li1" vid="GEN 46:21">Bera, Bekar, Asaber, Gera, Na'aman, Ehi, Rosh, Muppim, Huppim, u̱ Arada.<verse eid="GEN 46:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 46:22"/>Ine̱ o̱ye̱ ya'ag-u̱ campa-ne̱ Rahira i wa matu̱ Yakubu, yaage̱ o̱p-u̱ nas [14].<verse eid="GEN 46:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 46:23"/>Ya-du̱ u̱r-campa Dan wa na zu̱ye̱:</para>
  <para style="li1" vid="GEN 46:23">Husim.<verse eid="GEN 46:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 46:24"/>Yaag-u̱ campa-ne̱ Napari e̱ na zu̱ye̱:</para>
  <para style="li1" vid="GEN 46:24">Jahazir, Guni, Jezar, u̱ Shirem.<verse eid="GEN 46:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 46:25"/>Ine̱ e̱ o̱ye̱ ya'ag-u̱ campa-ne̱ Biru̱ha i wa matu̱ Yakubu, wu̱ Raban ya'e̱ gwu̱p-u̱ wa Rahira da-u̱ wa o̱o̱ge̱ ha-mu̱ u̱r-gu̱, ya'ag-u̱ wa o̱ ta'er [7].<verse eid="GEN 46:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 46:26"/>Ne̱t-tu̱ haye̱ u̱ Masar u̱ Yakubu ne̱, i o̱ye̱ du̱gu̱ ko̱-u̱r wa, za u̱r-kot u̱ ne̱ta-tu̱ ya'ag-u̱ wa da, ne̱t-to̱ u̱t-shik u̱t-tu̱t u̱ ne̱t-tu̱ u̱t-shin [66]. <verse eid="GEN 46:26"/><verse number="27" style="v" sid="GEN 46:27"/>Yusuhu o̱tte̱ ya'ag-u̱ campa-ne̱ yu̱r i na wa matu̱ wa u̱ Masar. Ne̱t-tu̱ bu-u Yakubu i haane̱ Masar, ne̱t-to̱ u̱t-shik u̱t-tu̱t u̱ o̱p [70] i o̱o̱ge̱ shu̱'u̱t Masar.<verse eid="GEN 46:27"/></para>
  <para style="s1">Yakubu teeg me̱ Masar</para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28"/>Yakubu to̱mo̱g Yahuda, wa do̱'e̱ u̱du̱ Yusuhu u̱ remu̱ zu̱, wa ko̱snu̱ wa fu̱n-yu̱ do̱'e̱ wa u̱t-do̱r m-ha u̱ Gas-u̱ Go̱sen. Da-u̱ e̱ teene̱ Gas-u̱ Go̱sen dak-u̱ Masar. <verse eid="GEN 46:28"/><verse number="29" style="v" sid="GEN 46:29"/>Yusuhu zo̱ng ke̱ke̱-yu̱ jwaak-u̱ wa, wa yu̱ne̱ wa aru̱k m-ha u̱ Go̱sen wa bit u̱so wa Isra. Za naas u-da da wa te shu̱ wu̱n, wa ham-u̱t u̱so wa, wa tumb u̱s-kan.<verse eid="GEN 46:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 46:30"/>Isra zu̱ Yusuhu, &lt;&lt;Yage̱ u̱m m-mar u̱ da-o̱, remu̱ zu̱ u̱m hyanu̱g u̱ hi-du̱ war ri u̱zu̱ bo̱ o̱mo̱n u̱r-fat.&gt;&gt;<verse eid="GEN 46:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31"/>Se̱ Yusuhu zu̱ o̱r-u̱t wa ne̱ u̱ ne̱t-tu̱ u̱ bu-u̱ u̱so-u wa ne̱, &lt;&lt;Me̱ u̱t-do̱'e̱ u̱m no̱m u̱s-rem u̱ Faru̱k-u̱ Masar ne̱. U̱m de̱ zu̱ wa, &lt;Tu̱-wu̱to̱ ri ne̱ u̱ ne̱t-tu̱ bu-u̱ u̱so-u ri ne̱, i o̱o̱ge̱ u̱ shu̱'u̱t u̱ dak-u̱ Kan'ana, e̱ haagu̱n u̱du̱ ri. <verse eid="GEN 46:31"/><verse number="32" style="v" sid="GEN 46:32"/>Ne̱t-u̱t to̱ ne̱t-tu̱ gwat-du̱ u̱t-bisa to̱ u̱ gwaar ne̱, tu̱msu̱ e̱ haagu̱n u̱ ban-tu̱ ca e̱ ne̱ u̱ ban-tu̱ na ne̱, u̱ no̱mu̱ e̱ o̱tte̱ ne̱ u-be̱e̱t.&gt; <verse eid="GEN 46:32"/><verse number="33" style="v" sid="GEN 46:33"/>Da-u̱ Faru̱k-u̱ Masar fagu̱ no̱, wa shit, &lt;¿Yan-o̱ o̱ ank-m no̱?&gt; <verse eid="GEN 46:33"/><verse number="34" style="v" sid="GEN 46:34"/>No̱ de̱ zu̱ wa, &lt;It a-gwat-du̱ ban-tu̱ u̱t-bisa ne̱ e̱, du̱gu̱ da-u̱ it o̱o̱ge̱ ya'ag-u̱ re̱k-e̱. It a-gwat-du̱ u̱t-bisa ne̱ e̱, u̱ka u̱so-u it nomte̱.&gt; Da-u o̱ wa yagu̱ no̱ u̱ no̱ ne̱ shu̱'u̱t u̱ gas-u̱ Go̱sen, remu̱ zu̱ ne̱t-tu̱ Masar e̱ gu̱gu̱mte̱ a-gwat-du̱ u̱t-bisa ne̱ no̱m-tu̱ m-'e̱ to̱ u̱du̱ e̱.&gt;&gt;<verse eid="GEN 46:34"/></para>
  <chapter eid="GEN 46"/>
  <chapter number="47" style="c" sid="GEN 47"/>
  <para style="s1">Yakubu wa'agu̱ Faru̱k-u̱ <optbreak/> Masar nu-u so̱-o̱</para>
  <para style="p">
    <verse number="1-2" style="v" sid="GEN 47:1-2"/>Yusuhu kagu̱b o̱r-u̱t wa ne̱ ne̱t-ne̱ tan, wa do̱'e̱ u̱-shu̱ Faru̱k-u̱ Masar. Wa waru̱ wa, &lt;&lt;U̱so ri u̱ o̱r-u̱t ri ne̱ e̱ haagu̱n du̱gu̱ Kan'ana u̱ ban-tu̱ ca ne̱ u̱ ban-tu̱ gwar-u̱ e̱ ne̱, u̱ ban-tu̱ na-u̱ e̱ ne̱, u̱ no̱m-tu̱ e̱ o̱tte̱ ne̱ u̱t-be̱e̱t. E̱ o̱ da-o̱ u̱ Gas-u̱ Go̱sen.&gt;&gt; Se̱ wa ko̱se̱ o̱r-u̱t wa u̱-shu̱ Faru̱k.<verse eid="GEN 47:1-2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 47:3"/>Faru̱k-u̱ Masar shit u̱n u̱zu̱, &lt;&lt;¿Yan o̱ o̱ye̱ ank-m no̱?&gt;&gt;</para>
  <para style="p" vid="GEN 47:3">E̱ shu̱s e̱ zu̱, &lt;&lt;It a-gwat-du̱ u̱t-bisa ne̱ e̱, u̱ka u̱so-tu̱ u̱so-u̱t it.&gt;&gt; <verse eid="GEN 47:3"/><verse number="4" style="v" sid="GEN 47:4"/>Tu̱msu̱ e̱ zu̱ Faru̱k-u̱ Masar, &lt;&lt;It haagu̱n it shu̱'u̱t u-da cashi, remu̱ zu̱ me̱r-su̱ no̱ng u-tát u̱ Kan'ana. Tu̱msu̱ be-du̱ u-re̱e̱g du̱ u̱t-bisa zaar da. It o̱ u̱s-ko̱n bo̱ yage̱ to̱k-ne̱ ró it shu̱'u̱t u̱ Gas-u̱ Go̱sen.&gt;&gt;<verse eid="GEN 47:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 47:5"/>Faru̱k-u̱ Masar zu̱ Yusuhu, &lt;&lt;U̱so ró u̱ tu̱-wu̱to̱ ró ne̱ e̱ haagu̱n u̱du̱ ró. <verse eid="GEN 47:5"/><verse number="6" style="v" sid="GEN 47:6"/>E̱ u̱t-kere̱ u̱r-shu̱'u̱t ko̱he̱ne̱ dak-u̱ Masar u-be̱e̱t. Ya u̱so-u ró u̱ o̱r-u̱t ró ne̱ dak-u̱ ze̱ge̱ u̱r-zwar. E̱ kere̱ u̱r-shu̱'u̱t Go̱sen. Tu̱msu̱ abite̱ u̱zu̱ waku̱n o̱ro u̱n wu̱ nape̱ gwat-du̱ u̱t-bisa sok, bo̱ kere̱ wadu̱ wa u̱ gwat-du̱ bisa-u̱t ri.&gt;&gt;<verse eid="GEN 47:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7"/>Se̱ Yusuhu haatu̱n uso-u wa Yakubu, wa hu̱u̱t wa u̱-shu̱ Faru̱k-u̱ Masar. Tu̱msu̱ Yakubu wa'-u̱ Faru̱k-u̱ Masar nu-u so̱-o̱. <verse eid="GEN 47:7"/><verse number="8" style="v" sid="GEN 47:8"/>Faru̱k-u̱ Masar shit Yakubu, &lt;&lt;¿Hak-u̱s ró se̱ u̱s-nu̱?&gt;&gt;<verse eid="GEN 47:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9"/>Yakubu shu̱s wa zu̱ Faru̱k-u̱ Masar, &lt;&lt;U̱m no̱mu̱g u̱s-hak u̱t-shik u̱t-shishin u̱ o̱p [130]. Se̱di hak-u̱s ri o̱ cashi ana gwate̱ hak-su̱ u̱so-u̱t ri tu̱ mare̱.&gt;&gt; <verse eid="GEN 47:9"/><verse number="10" style="v" sid="GEN 47:10"/>Yakubu wa'-u̱ Faru̱k-u̱ Masar nu-u so̱-o̱, se̱ wa aru̱k m-rwu̱ du̱gu̱-du̱ wa.<verse eid="GEN 47:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 47:11"/>Yusuhu shu̱gu̱sse̱ u̱so-u wa u̱ o̱r-u̱t wa ne̱ u̱ dak-u̱ Masar. Wa yasu̱ e̱ dak-u̱ ze̱ge̱ u̱r-zwar u̱ Masar, u̱ na zu̱ye̱ Ramase, u̱ka Faru̱k-u̱ Masar zu̱tte̱. <verse eid="GEN 47:11"/><verse number="12" style="v" sid="GEN 47:12"/>Yusuhu hatu̱n u̱so-u wa u̱ tu̱-wu̱to̱ wa u̱ ne̱t-tu̱ bu-u wa ne̱ u̱t-be̱e̱t no̱m u̱t-re̱, u̱ka tat-u e̱, u̱ ya'ag-u̱ e̱ ne̱.<verse eid="GEN 47:12"/></para>
  <para style="s1">U̱s-me̱r</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13"/>U-dak u-be̱e̱t no̱m u̱t-re̱ zaar da rem u̱zu̱ me̱r-su̱ no̱ng u-tát; ne̱t-tu̱ o̱ swadu̱ u̱s-me̱r sok u̱ dak-u̱t to̱ Masar u̱ Kan'ana-ne̱. <verse eid="GEN 47:13"/><verse number="14" style="v" sid="GEN 47:14"/>Yusuhu o̱nk shik be̱e̱t i na kume̱ Masar u̱ Kan'ana-ne̱ i ne̱t-tu̱ ote̱ hyu̱, wa hu̱u̱t shik-u̱ e̱ u̱ pyu̱-u̱ Faru̱k-u̱ Masar. <verse eid="GEN 47:14"/><verse number="15" style="v" sid="GEN 47:15"/>Da-u̱ ne̱t-tu̱ Masar u̱ ne̱t-tu̱ Kan'ana tase̱ hosu̱ shik-u̱ e̱ o̱tte̱ be̱e̱t u̱ remu̱ o̱-du̱ hyu̱, ne̱t-tu̱ Masar ne̱ be̱e̱t e̱ haan u̱du̱ Yusuhu. E̱ zu̱, &lt;&lt;Ya it no̱m u̱t-re̱. ¿Re̱-o̱ it do̱te̱ u̱t-mar bo̱ gwat-du̱ it? Shik-u̱ it tu̱u̱ste̱ be̱e̱t.&gt;&gt;<verse eid="GEN 47:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16"/>Yusuhu shu̱s wa zu̱, &lt;&lt;Hatu̱n me̱ bisa-u̱t no̱, me̱ ya' no̱ no̱m u̱t-re̱ remu̱ zu̱ shik-u̱ no̱ tu̱u̱ste̱.&gt;&gt; <verse eid="GEN 47:16"/><verse number="17" style="v" sid="GEN 47:17"/>Du̱gu̱ da-u o̱, u̱n hatu̱n u̱t-bisa u̱du̱ Yusuhu, wa yu̱ u̱n nom-u̱t re̱ u̱ swas-mu̱ bisa-u̱t u̱n: jwaak ne̱, ban-tu̱ ca, u̱ gwaar ne̱, u̱ na ne̱, u̱ janka ne̱. Tu̱msu̱ u̱ hak-u ya wa yu̱ u̱n no̱m u̱t-re̱ u̱ swasmu̱ bisa-tu̱ u-bu u̱n.<verse eid="GEN 47:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18"/>Da-u̱ hak-yu̱ arke̱, yaku̱n hak-ya byu̱ru̱n u̱n haan u̱du̱ wa, u̱n zu̱, &lt;&lt;U̱so u-bu it, it zaar u̱ yasu̱ bo̱ u̱t-nip da. It zamu̱ttu̱n shik da e̱ tu̱u̱ste̱ be̱e̱t, tu̱msu̱ bisa-u̱t it u̱t-be̱e̱t to̱ mu̱u̱g tu̱ ró. O̱ko̱n zamu̱n u̱ it do̱'e̱ u̱ haatu̱n bo̱ da war-u̱t it to̱ kuse̱ u̱ tak-u̱t it ne̱. <verse eid="GEN 47:18"/><verse number="19" style="v" sid="GEN 47:19"/>¿Re̱ne̱ o̱ it do̱te̱ m-mar bo̱ gwat-du̱ it u̱ is-u̱ ró? Ya it nom-u̱t re̱ u̱ swas-mu̱ tak-u̱t it, it ya'aste̱ Faru̱k-u̱ Masar tak-u̱t it u̱ hi-du̱ war it ne̱ u̱du̱ Faru̱k-u̱ Masar it shu̱'u̱t to̱k-ne̱. Bo̱ di ya' it no̱m u̱t-re̱ taas it mar da, tu̱msu̱ taas u̱ dak-u̱ shu̱'u̱t za ne̱t sha-mu̱ u̱r-do̱g da.&gt;&gt;<verse eid="GEN 47:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20"/>Yusuhu o̱gu̱ Faru̱k-u̱ Masar dak-u̱ Masar u̱t-be̱e̱t. Ne̱t-tu̱ Masar u̱t-be̱e̱t e̱ bu̱pu̱s tak-u̱t e̱ remu̱ zu̱ me̱r-su̱ no̱ng u-tát sok, tak-tu̱ shu̱'u̱t tu̱ Faru̱k-u̱ Masar u̱t-be̱e̱t. <verse eid="GEN 47:20"/><verse number="21" style="v" sid="GEN 47:21"/>Remu̱ iya Yusuhu muut ne̱t-tu̱ Masar u̱t-be̱e̱t, ne̱t-tu̱ shu̱'u̱t to̱k-ne̱ faru̱k be̱e̱t. <verse eid="GEN 47:21"/><verse number="22" style="v" sid="GEN 47:22"/>Ko̱ ba shu̱'u̱te̱ iya, Yusuhu o̱o̱g tak-tu̱ a-to̱o̱g-ne̱ da. Remu̱ u̱zu̱ a-to̱o̱g-ne̱ o̱nk no̱m u̱t-re̱ e̱ du̱gu̱-du̱ Faru̱k-u̱ Masar. Remu̱ iya e̱ zatte̱ mo̱ttu̱ bab-du̱ tak-u̱t e̱ da.<verse eid="GEN 47:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 47:23"/>Yusuhu zu̱ u̱n, &lt;&lt;Remu̱ u̱zu̱ u̱ da-o̱ u̱m o̱o̱g no̱ u̱ tak-u̱t no̱ ne̱ u̱du̱ Faru̱k-u̱ Masar. Go̱ hyu̱ ya o̱nko̱n no̱ do̱'e̱ no̱ kaw u̱t-tak. <verse eid="GEN 47:23"/><verse number="24" style="v" sid="GEN 47:24"/>Da-u̱ no̱ tase̱ ket, no̱ de̱ yase̱ u̱r-ho̱ u̱r-gan u̱ te̱k u̱t-ho̱ u̱t-tan, u̱du̱ Faru̱k-u̱ Masar. Ho̱-tu̱ u̱t-nas tu̱ kuse̱ to̱ shu̱'u̱t go̱ i no̱ do̱'e̱ u̱t-kaw u̱ tak-u̱t no̱, tu̱msu̱ no̱m u̱t-re̱ u̱du̱ tak-u̱t no̱, u̱ ne̱t-tu̱ u-bu no̱ ne̱ be̱e̱t.&gt;&gt;<verse eid="GEN 47:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25"/>E̱ shu̱s, e̱ zu̱, &lt;&lt;Bo̱ gwu̱u̱g fat-u̱t it, yage̱ it kum hyu̱-m pusmo̱ u̱du̱ u̱so u-bu ri; it shu̱'u̱t to̱k-ne̱ Faru̱k-u̱ Masar.&gt;&gt;<verse eid="GEN 47:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 47:26"/>Yusuhu nom u̱t-bo̱r u̱ dak-u̱ Masar tu̱ o̱mne̱ m-ank u̱ haan u̱ da-o̱, u̱zu̱ u̱r-ho̱ u̱r-gan u̱-me̱ u̱t-tan du̱ no̱m-tu̱ u̱r-to̱m u̱ dak-u̱ Masar du̱ Faru̱k de̱. Se̱di tak-tu̱ a-to̱o̱g-ne̱ to̱ zare̱ tu̱ Faru̱k-u̱ Masar da.<verse eid="GEN 47:26"/></para>
  <para style="s1">Ko̱n-su̱ m-vaste̱ su̱ Yakubu</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27"/>Se̱ Isra-ne̱ e̱ shu̱'u̱t u̱ Masar u̱ gas-u̱ Go̱sen, e̱ nom u̱t-kwu̱m u-tát. E̱ mu̱t yaag u-tát, tu̱msu̱ e̱ nom u̱r-ban sok.<verse eid="GEN 47:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 47:28"/>Yakubu shu̱'u̱te̱ u̱ Masar u̱s-hak o̱p u̱s-ta'er [17], hak-u̱s Yakubu su̱ wa no̱me̱, hak-se̱ u-ko̱k u-gan u̱ hak-su̱ u̱t-shik u̱t-yu̱r u̱ hak-su̱ u̱s-ta'e̱r [147]. <verse eid="GEN 47:28"/><verse number="29" style="v" sid="GEN 47:29"/>Da-u̱ Isra nape̱ u̱zu̱ da-u̱ mar-m wa no̱ng u̱t-mo̱r, se̱ wa fog wa'-u̱ wa Yusuhu. Wa zu̱ wa, &lt;&lt;A u̱m kume̱ hyu̱-m pusmo̱ u̱du̱ ró, wa kom-u ró u̱-ta kut-u ri, bo̱ ko̱se̱ me̱ u̱t-nip u̱ yadu̱ jab ne̱ u̱zu̱ a u̱m mare̱ bo̱ za jwak-u̱ me̱ u̱ ana u̱ dak-u̱ Masar. <verse eid="GEN 47:29"/><verse number="30" style="v" sid="GEN 47:30"/>Tu̱msu̱ da-u̱ u̱m mare̱, kabu̱n war-u ri du̱gu̱ Masar m-ha u̱ be-du̱ na dokte̱ u̱so-tu̱ tu̱ u̱so-u̱t ri.&gt;&gt;</para>
  <para style="p" vid="GEN 47:30">Yusuhu zu̱, &lt;&lt;Me̱ no̱mu̱ bo̱ u̱ka bo̱ zu̱tte̱.&gt;&gt;<verse eid="GEN 47:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31"/>Yakubu zu̱, &lt;&lt;To̱nde̱ u̱zu̱ bo̱ u̱t-no̱m iya.&gt;&gt; Yusuhu to̱n-de̱ wu̱n. Da-u o̱ Isra kakse̱ hi-u̱r wa u̱-do̱mu̱ yu̱n-u̱ wa, wa nome̱ u-Ru̱ u̱t-huuk.<verse eid="GEN 47:31"/></para>
  <chapter eid="GEN 47"/>
  <chapter number="48" style="c" sid="GEN 48"/>
  <para style="s1">Yakubu wagu̱ Ifaramu e̱ <optbreak/> Manase nu-u so̱-o̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1"/>Da-u̱ wase̱ ca, na waru̱ Yusuhu u̱zu̱, u̱so-u wa o̱ za m-yar. Yusuhu ku̱b ya'ag-u̱ campa-ne̱ wa yu̱r, Manase u̱ Ifaramu u̱ wane̱, e̱ do̱'e̱, e̱ hyan u̱so-u wa. <verse eid="GEN 48:1"/><verse number="2" style="v" sid="GEN 48:2"/>Da-u̱ na ware̱ Yakubu u̱zu̱, &lt;&lt;Wa'-u̱ ró Yusuhu haagu̱n, wa hyan bo̱.&gt;&gt; Se̱ Isra sur u̱r-be̱b tu̱msu̱ wa shu̱'u̱t u̱-do̱m u-yu̱n.<verse eid="GEN 48:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 48:3"/>Yakubu zu̱ Yusuhu, &lt;&lt;Ru̱-u̱ u-be̱e̱t haagu̱n u̱du̱ ri u̱ Ruz u̱ dak-u̱ Kan'ana, tu̱msu̱ wa wa'-u̱ me̱ nu-u so̱-o̱ u̱ ku̱n. <verse eid="GEN 48:3"/><verse number="4" style="v" sid="GEN 48:4"/>Wa zu̱ me̱, &lt;Me̱ ya'u̱ bo̱ yaag, tu̱msu̱ me̱ u̱t-wa bo̱ no̱m u-tát. Me̱ u̱t-wa u̱ bo̱ shu̱'u̱t wa u̱t-ko̱ u-tát, me̱ ya'u̱ bo̱ uno̱ dak-o̱ Kan'ana, tu̱msu̱ me̱ ya'u̱ bo̱ uno̱ dak-o̱ u̱ shu̱'u̱t u̱ ko̱-u̱t ró u̱ de̱ haan dim-u̱ ró m-mo̱mmo̱.&gt; &gt;&gt;<verse eid="GEN 48:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 48:5"/>Yakubu zu̱ wu̱n, &lt;&lt;Yaag-u̱ campa-ne̱ yu̱r i na mate̱ bo̱ u̱ dak-u̱ Masar, Ifaramu u̱ Manase kanda u̱m haan u̱ ana, e̱ do̱'e̱ u̱t-shu̱'u̱t ya'ag-u̱ ri u̱ka Rube̱n u̱ Simiyo̱n. <verse eid="GEN 48:5"/><verse number="6" style="v" sid="GEN 48:6"/>Tu̱msu̱ da-u̱ ko̱-u̱r no̱ u̱r-be̱e̱t e̱ mu̱u̱ne̱ u̱ Kan'ana, ya'ag-u̱ ri ko̱wan do̱'e̱ kwu̱m-du̱ u̱r-o̱g dak-u o̱. Se̱di e̱ke̱n yaage̱ i bo̱ de̱ u̱t-kwu̱m u̱ dim-u̱ u̱n e̱ do̱'e̱ kwu̱m-du̱ o̱g-du̱ u-dak du̱gu̱ o̱ru̱ e̱ Ifaramu ko̱ Manase. <verse eid="GEN 48:6"/><verse number="7" style="v" sid="GEN 48:7"/>U̱s-hak u-tát su̱ arke̱, da u̱m o̱o̱ge̱ mu̱u̱n du̱gu̱ Padan-Aram, Rahira mu̱ru̱s dak-u̱ Kan'ana. It o̱ u̱ te̱k m-ha u̱ do̱m u-fu̱n, m-ra ne̱ du̱gu̱ bo̱-u̱ Eparat (U̱ na fu̱ge̱ Be̱tarami). U̱ te̱k-u̱ namu̱ jab se̱ u̱m dok wa u̱ kit-u̱ fu̱n-yu̱ ha-mu̱ Eparat.&gt;&gt;<verse eid="GEN 48:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8"/>Da-u̱ Isra hyanne̱ ya'ag-u̱ campa-ne̱ Yusuhu yu̱r, se̱ wa shit, &lt;&lt;¿Wa zu̱ wanne̱ e̱ ine̱?&gt;&gt;<verse eid="GEN 48:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9"/>Yusuhu shu̱s wa zu̱, &lt;&lt;E̱ o̱ye̱ yaag campa-ne̱ i Ru̱-u̱ ya'u̱ me̱ u̱ ana, da-u̱ u̱m o̱o̱ge̱ u̱ Masar.&gt;&gt;</para>
  <para style="p" vid="GEN 48:9">Yakubu zu̱, &lt;&lt;Haatu̱n u̱n u̱du̱ ri u̱m wa'-u̱ u̱n nu-u so̱-o̱.&gt;&gt;<verse eid="GEN 48:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 48:10"/>Is-u̱ Isra no̱ng u-cu̱m u̱ remu̱ u̱r-wu̱, wa hyen-u̱t sok da. Yusuhu haatu̱n ya'ag-u̱ campa-ne̱ wa yu̱r u̱du̱ Yakubu. Yakubu ham-u̱t e̱ tu̱msu̱ wa su gu̱t-u̱t e̱.<verse eid="GEN 48:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 48:11"/>Isra zu̱ Yusuhu, &lt;&lt;U̱m no̱ng u̱s-dorog u̱zu̱ me̱ hyanu̱ bo̱ da. Se̱di u̱ da-o̱ Ru̱-u̱ yakku̱ me̱ u̱m hyan ya'ag-u̱ ró tu̱msu̱.&gt;&gt;<verse eid="GEN 48:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 48:12"/>Se̱ Yusuhu hast ya'ag-u̱ wa du̱gu̱-du̱ jwu̱n-u̱t Yakubu, se̱ Yusuhu he̱ u-dak u̱t-jwu̱n wa kaku̱s hi-u̱r wa u-dak. <verse eid="GEN 48:12"/><verse number="13" style="v" sid="GEN 48:13"/>Yusuhu kagu̱b u̱n yu̱r be̱e̱t, Ifaramu u̱ kom-u̱t u̱t-cwa u̱ Yusuhu m-gwat kom u̱r-beer u̱ Isra, tu̱msu̱ Manase u̱ kom u̱r-beer Yusuhu m-gwat kom u̱t-cwa u̱ Isra. Wa haatu̱n e̱ u̱t-mo̱r u̱ Yakubu ne̱. <verse eid="GEN 48:13"/><verse number="14" style="v" sid="GEN 48:14"/>Tu̱msu̱ Isra no̱mu̱g no̱mu̱ Yusuhu u̱t-sa wa no̱m da. Se̱di wa dor kom u̱s-cwa u̱ hi-u̱r Ifaramu, ko̱ ba shu̱'u̱te̱ u̱zu̱ wa o̱ye̱ du̱-fade̱, kom u̱r-beer u̱ do̱m-u̱ hi-u̱r Manase wu̱ o̱ mat-du̱ u-shu̱.<verse eid="GEN 48:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 48:15"/>Se̱ wa wa'-u̱ Yusuhu nu-u so̱-o̱, wa zu̱,</para>
  <para style="q1" vid="GEN 48:15">&lt;&lt;Yage̱ u-Ru̱ wu̱ u̱so-u u̱so-u̱t ri</para>
  <para style="q2" vid="GEN 48:15">Ibrahi u̱ u̱so ri Ishaku ne̱ e̱ no̱nge̱ u-Ru̱ m-ank.</para>
  <para style="q1" vid="GEN 48:15">Ru̱-u̱ du̱u̱te̱ me̱ tu̱msu̱ wa got me̱</para>
  <para style="q2" vid="GEN 48:15">u̱ka wa-gwat-du̱ u̱t-bisa gotte̱ ca wa.</para>
  <para style="q1" vid="GEN 48:15">Ru̱-u̱ no̱ng iya u̱ fat-u̱r ri u̱r-be̱e̱t u̱ teen din-de̱ ho̱-de̱.<verse eid="GEN 48:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 48:16"/>Wa-to̱m u-Ru̱ wu̱ guu me̱ du̱gu̱ no̱m-u̱t yo̱-to̱,</para>
  <para style="q1" vid="GEN 48:16">u̱m no̱ng u̱s-to̱o̱g u̱zu̱,</para>
  <para style="q2" vid="GEN 48:16">wa wa'-u̱ yaag ine̱ nu-u so̱-o̱.</para>
  <para style="q1" vid="GEN 48:16">U̱m no̱ng u̱s-to̱o̱g u̱zu̱ na do̱'e̱ ha fag-du̱ u̱n u̱ dim-u̱r ri,</para>
  <para style="q2" vid="GEN 48:16">tu̱msu̱ u̱ dim-u̱r Ibrahi u̱ Ishaku ne̱ remu̱ no̱mu̱ Ru̱-u̱ no̱mu̱ u̱n.</para>
  <para style="q1" vid="GEN 48:16">U̱m no̱ng u̱s-to̱o̱g u̱zu̱ u̱n kum u̱t-ko̱ u-tát</para>
  <para style="q2" vid="GEN 48:16">i do̱'e̱ u̱r-yu̱ u-dak u-be̱e̱t.&gt;&gt;<verse eid="GEN 48:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17"/>Da-u̱ Yusuhu hyane̱ u̱so-u wa u̱ wadu̱ kom u̱t-cwa u̱ wa u̱ hi-u̱r Ifaramu, se̱ jab-u̱ wa nu̱. Se̱ wa ku̱b kom u̱t-cwa u̱ u̱so-u wa, du̱gu̱ hi-u̱r Ifaramu, wa muut o̱ u̱ hi-u̱r Manase. <verse eid="GEN 48:17"/><verse number="18" style="v" sid="GEN 48:18"/>Yusuhu zu̱ u̱so-u wa, &lt;&lt;Iya-o̱ da, u̱so-u ri, unwa wa o̱o̱ge̱ mat-du̱ u-shu̱, wa kom u̱s-cwa ró u̱ hi-u̱r wa.&gt;&gt;<verse eid="GEN 48:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19"/>Tu̱msu̱ u̱so-u wa gu̱gu̱m. Wa zu̱, &lt;&lt;U̱m nak wa'-u̱ ri, u̱m-nak, Manase do̱'e̱ u̱t-shu̱'u̱t ko̱-u̱r yat-de̱, tu̱msu̱ Ifaramu du̱-dim-u̱ Manasse̱ u̱t-shu̱'u̱t ko̱-u̱r yadde̱ m-ze̱g du̱ yu̱-wu̱ya wa, ko̱-u̱r wa u̱t-shu̱'u̱t dak-u yat-o̱.&gt;&gt; <verse eid="GEN 48:19"/><verse number="20" style="v" sid="GEN 48:20"/>Remu̱ iya Yakubu wa'-u̱ u̱n yu̱r nu-u so̱-o̱ u̱r-ho̱ u̱r-gan wa zu̱,</para>
  <para style="q1" vid="GEN 48:20">&lt;&lt;Du̱gu̱-du̱ dim-u̱r ro de̱ ne̱t-tu̱ Isra-ne̱ do̱te̱ wa'-u̱ u̱t-ne̱t nu-u so̱-o̱, e̱ do̱'e̱ u̱t-zu̱,</para>
  <para style="q2" vid="GEN 48:20">&lt;Yage̱ Ru̱-u̱ wa'-u̱ no̱ nu-u so̱-o̱ u̱ka Ifaramu ne̱ e̱ Manase.&gt; &gt;&gt;</para>
  <para style="m" vid="GEN 48:20">Remu̱ iya Yakubu wu̱ Ifaramu u̱-shu̱ Manase.<verse eid="GEN 48:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21"/>Da-u o̱ Isra zu̱ Yusuhu, &lt;&lt;Bo̱ hyanu̱g u̱m u̱t-sa m-mar, tu̱msu̱ Ru̱-o̱ u̱t-no̱m u̱r-kot u̱ bo̱ ne̱, tu̱msu̱ wa do̱'e̱ u̱ muutu̱ bo̱ dak-u̱ u̱so-tu̱ u̱so-u̱t in. <verse eid="GEN 48:21"/><verse number="22" style="v" sid="GEN 48:22"/>Tu̱msu̱ bo̱, me̱ ya bo̱ m-ze̱g no̱m-u̱ u̱m ya tu̱-wu̱to̱ ró. Me̱ ya'u̱ bo̱ tak-u̱ ze̱ge̱ u̱r-be̱b u̱ gas-u̱ She̱che̱m. U̱m o̱nkte̱ dak-u o̱ du̱gu̱ ne̱t-tu̱ Amoriya-ne̱, da-u̱ u̱m no̱me̱ m-dum u̱ e̱ ne̱ van-yu̱ m-wu̱r ri u̱ ta-u ri ne̱.&gt;&gt;<verse eid="GEN 48:22"/></para>
  <chapter eid="GEN 48"/>
  <chapter number="49" style="c" sid="GEN 49"/>
  <para style="s1">Yakubu wa'agu̱ ya'ag-u̱ <optbreak/> campa-ne̱ wa nu-u so̱-o̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1"/>Se̱ Yakubu fog ya'ag-u̱ campa-ne̱ wa tu̱msu̱ wa zu̱: &lt;&lt;Kargu̱n u̱du̱ ri, u̱m waru̱ no̱ no̱m-u̱ do̱'e̱ kwu̱m-du̱ no̱ u̱ da-u̱ de'e̱ u̱ haan.&gt;&gt;<verse eid="GEN 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2"/>&lt;&lt;Kargu̱n no̱ e̱r,</para>
  <para style="q2" vid="GEN 49:2">Yaag-u̱ ri Yakubu;</para>
  <para style="q1" vid="GEN 49:2">E̱re̱n Isra u̱so-u no̱.&gt;&gt;<verse eid="GEN 49:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3"/>Rube̱n, bo̱ o̱ye̱ mat-du̱ u-shu̱ ri.</para>
  <para style="q2" vid="GEN 49:3">Bo̱ wa u̱m mate̱ da-u̱</para>
  <para style="q1" vid="GEN 49:3">u̱m o̱o̱ge̱ u̱ fa-u̱r ri,</para>
  <para style="q2" vid="GEN 49:3">u̱ da-u̱ u̱m o̱o̱ge̱ u̱ ho̱g-mu̱ u̱r-be̱b.</para>
  <para style="q1" vid="GEN 49:3">Bo̱ wa o̱ yu̱-shu̱</para>
  <para style="q2" vid="GEN 49:3">tu̱msu̱ wu̱ ze̱ge̱ u̱r-be̱b.<verse eid="GEN 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4"/>Ko̱ ba shu̱'u̱te̱ zu̱</para>
  <para style="q2" vid="GEN 49:4">bo̱ wa-ko̱b-du̱ shu̱p-du̱ u̱r-hi wa</para>
  <para style="q1" vid="GEN 49:4">u̱ka bu̱-mu̱ u̱r-be̱b.</para>
  <para style="q2" vid="GEN 49:4">U̱ da-o̱ bo̱ za kwu̱m-du̱</para>
  <para style="q2" vid="GEN 49:4">re̱-u̱ u-shu̱ da,</para>
  <para style="q1" vid="GEN 49:4">remu̱ zu̱ bo̱ daag</para>
  <para style="q2" vid="GEN 49:4">u̱ yu̱n-u ri bo̱ naas o̱.</para>
  <para style="q1" vid="GEN 49:4">Bo̱ roogte̱ u̱ to̱k-ne̱,</para>
  <para style="q2" vid="GEN 49:4">wu̱ shu̱'u̱te̱ wa-gan</para>
  <para style="q1" vid="GEN 49:4">u̱ te̱k-u̱ ne̱ta-u̱t ri.</para>
  <para style="q2" vid="GEN 49:4">Bo̱ wa'ag me̱ u̱so-u ró</para>
  <para style="q1" vid="GEN 49:4">u̱ ho̱g-du̱ m-'e̱.<verse eid="GEN 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5"/>Simiyo̱n e̱ Re̱wi jab-u̱s e̱ o̱ u̱s-gan,</para>
  <para style="q2" vid="GEN 49:5">van-su̱ m-wu̱r u̱n</para>
  <para style="q1" vid="GEN 49:5">no̱m-tu̱ yu̱nu̱s-du̱ jab-su̱ u̱t-ne̱t se̱.<verse eid="GEN 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6"/>U̱m zaar u̱ cwadu̱ mo̱ro̱g-u̱r u̱n da,</para>
  <para style="q2" vid="GEN 49:6">U̱m za tu̱msu̱ same̱ u̱t-hi</para>
  <para style="q1" vid="GEN 49:6">u̱ no̱m-du̱ no̱m-u̱t yo̱-to̱ u̱n ne̱ da.</para>
  <para style="q1" vid="GEN 49:6">U̱n ho̱o̱rte̱ u̱t-ne̱t remu̱ ryab-u̱s u̱n.</para>
  <para style="q2" vid="GEN 49:6">Tu̱msu̱ e̱ kwu̱pru̱sse̱ tu̱ru̱g-su̱ na,</para>
  <para style="q1" vid="GEN 49:6">remu̱ ho̱g-du̱ u̱r-zwaru̱ u̱n.<verse eid="GEN 49:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="GEN 49:7"/>Nu-u yo̱-o̱ u̱du̱ ryab-u̱s u̱n,</para>
  <para style="q2" vid="GEN 49:7">remu̱ zu̱ ryab-u̱s u̱n no̱ng u-tát.</para>
  <para style="q1" vid="GEN 49:7">Me̱ bu̱ru̱gse̱ u̱n du̱gu̱ ko̱-u̱r Yakubu,</para>
  <para style="q2" vid="GEN 49:7">u̱m bu̱ru̱gse̱ u̱n du̱gu̱ me̱ Isra-ne̱.<verse eid="GEN 49:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8"/>&lt;&lt;Yahuda, o̱r-u̱t ró ne̱</para>
  <para style="q2" vid="GEN 49:8">do̱'e̱ no̱mu̱ bo̱ u̱t-vam.</para>
  <para style="q1" vid="GEN 49:8">Bo̱ do̱'e̱ u̱ shu̱p-du̱ ge̱ku̱stu̱</para>
  <para style="q2" vid="GEN 49:8">hu̱u̱b-u̱t yo̱-to̱ ró.</para>
  <para style="q1" vid="GEN 49:8">Yaag-u̱ u̱so-u ró do̱'e̱ u̱t-he̱</para>
  <para style="q2" vid="GEN 49:8">u̱t-jwu̱n u̱ shu̱ ró.<verse eid="GEN 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="GEN 49:9"/>Yahuda wa'-u̱ ri,</para>
  <para style="q2" vid="GEN 49:9">ya-du̱ u-zur de̱ wa o̱o̱ge̱,</para>
  <para style="q2" vid="GEN 49:9">wu̱ tase̱ tu̱du̱ ap-mu̱ u̱r-do̱g mu̱ wa mase̱,</para>
  <para style="q1" vid="GEN 49:9">Wa ru̱t wa nu̱ku̱s m-kim</para>
  <para style="q2" vid="GEN 49:9">da-u̱ wa tase̱ re̱-du̱ no̱m u̱t-re̱.</para>
  <para style="q1" vid="GEN 49:9">Bo̱ o̱ sha-mu̱ ya-du̱ uzur,</para>
  <para style="q2" vid="GEN 49:9">waku̱n zaar wu̱ de̱ yu̱nsu̱ bo̱ da.<verse eid="GEN 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10"/>Bo̱ Yahuda, ko̱m-yu̱ u̱r-faru̱k</para>
  <para style="q2" vid="GEN 49:10">za u̱t-rwu̱ du̱gu̱-du̱ ró da.</para>
  <para style="q2" vid="GEN 49:10">Ko̱m-yu̱ u̱r-faru̱k zaar u̱t-mo̱t</para>
  <para style="q1" vid="GEN 49:10">u̱ ne̱t-u̱t ró ne̱ da.</para>
  <para style="q2" vid="GEN 49:10">Se̱ teeg u̱du̱ wu̱ kame̱ wa re̱.</para>
  <para style="q2" vid="GEN 49:10">U̱t-dak u̱t-be̱e̱t to̱ ya'u̱ bo̱ m-ze̱g.<verse eid="GEN 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 49:11"/>Bo̱ gagu̱ janka-u ró</para>
  <para style="q2" vid="GEN 49:11">u̱ te-yu̱ inabi,</para>
  <para style="q1" vid="GEN 49:11">jwaak-u wu̱n u̱t-no̱m</para>
  <para style="q2" vid="GEN 49:11">u̱t-re̱e̱g u̱s-nag-nag su̱ cite̱ e̱,</para>
  <para style="q1" vid="GEN 49:11">Wa jasu̱ kus-u̱t wa</para>
  <para style="q2" vid="GEN 49:11">u̱ bu̱-mu̱ inabi,</para>
  <para style="q1" vid="GEN 49:11">no̱ u̱t-no̱m m-jaas</para>
  <para style="q2" vid="GEN 49:11">u̱ bu̱-mu̱ inabi mu̱ o̱</para>
  <para style="q1" vid="GEN 49:11">u̱ jaz-mo̱ u̱ka m-hyu̱.<verse eid="GEN 49:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="GEN 49:12"/>Is-u̱ ró u̱t-no̱m u̱s-rim</para>
  <para style="q1" vid="GEN 49:12">m-ze̱g bu̱-mu̱ ke̱,</para>
  <para style="q2" vid="GEN 49:12">tu̱msu̱ ni-nu̱ wu̱n u̱t-no̱m</para>
  <para style="q1" vid="GEN 49:12">u̱r-myak m-ze̱g m-me̱.<verse eid="GEN 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="GEN 49:13"/>&lt;&lt;Ze̱burun u̱t-shu̱'u̱t u̱ kit-yu̱ m-sa.</para>
  <para style="q2" vid="GEN 49:13">U̱ shu̱'u̱t be-du̱ e̱e̱s-du̱ hat-su̱ m-bu̱,</para>
  <para style="q2" vid="GEN 49:13">Ma-du̱ u-bo̱r wa u̱t-te bo̱-u̱ Sidon.<verse eid="GEN 49:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14"/>&lt;&lt;Issakar, janka-yu̱ u̱r-be̱b ya.</para>
  <para style="q2" vid="GEN 49:14">Wa o̱ m-ru̱t u̱ te̱k-u̱ kapu-tu̱</para>
  <para style="q1" vid="GEN 49:14">gag-du̱ u̱t-cwu̱ u̱t-yu̱r.<verse eid="GEN 49:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="GEN 49:15"/>Wa u̱t-hyan u̱zu̱</para>
  <para style="q1" vid="GEN 49:15">be-du̱ u̱r-hure̱ wa o̱ so̱-de̱,</para>
  <para style="q2" vid="GEN 49:15">tu̱msu̱ wa u̱t-ho̱g</para>
  <para style="q1" vid="GEN 49:15">u̱ka re̱me̱r-mu̱ u-dak o̱tte̱.</para>
  <para style="q2" vid="GEN 49:15">Wa yasu̱ shin-u wa remu̱</para>
  <para style="q1" vid="GEN 49:15">kab-du̱ cwu̱-tu̱ m-no,</para>
  <para style="q2" vid="GEN 49:15">wa yase̱ hi-u̱r wa</para>
  <para style="q1" vid="GEN 49:15">u̱ no̱m-du̱ m-to̱k mu̱ u̱r-be̱b.<verse eid="GEN 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16"/>Dan, do̱'e̱ u̱t-shu̱'u̱t wa kwu̱p-du̱ u̱s-rem</para>
  <para style="q2" vid="GEN 49:16">u-me̱ ne̱t-u̱t wa,</para>
  <para style="q1" vid="GEN 49:16">u̱ka to̱ku̱n ko̱-to̱ u̱-me̱ Isra-ne̱.<verse eid="GEN 49:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="GEN 49:17"/>Dan wa do̱'e̱ u̱t-shu̱'u̱t</para>
  <para style="q1" vid="GEN 49:17">u-fa u̱ kit-u̱ u-fu̱n,</para>
  <para style="q2" vid="GEN 49:17">fa-yu̱ m-rab u̱ kit u-fu̱n,</para>
  <para style="q1" vid="GEN 49:17">Yu̱ epe̱ du̱ku̱nte̱ du̱ jwaak,</para>
  <para style="q2" vid="GEN 49:17">remu̱ i o̱ m-sak e̱ he̱'e̱ u̱-dim.<verse eid="GEN 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18"/>Yawe, u̱m o̱ wadu̱ is u̱ u̱ku̱r-u ró.<verse eid="GEN 49:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19"/>&lt;&lt;Gad, hyu̱w-ne̱ kwu̱p-du̱ u̱s-fu̱n ne̱</para>
  <para style="q2" vid="GEN 49:19">do̱'e̱ u̱ haan u̱ bo̱,</para>
  <para style="q1" vid="GEN 49:19">se̱di bo̱ doru̱ dim-u̱ u̱n</para>
  <para style="q2" vid="GEN 49:19">wa to̱p u̱r-mag.<verse eid="GEN 49:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20"/>&lt;&lt;Ashu̱r, bo̱ no̱mu̱ no̱m u̱t-re̱</para>
  <para style="q2" vid="GEN 49:20">tu̱ m-re̱rem u-tát tu̱ farkina-ne̱.</para>
  <para style="q1" vid="GEN 49:20">Tu̱msu̱ i nome̱ no̱m-tu̱ u̱t-re̱</para>
  <para style="q2" vid="GEN 49:20">tu̱ m-re̱me̱r tu̱ faru̱k.<verse eid="GEN 49:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21"/>&lt;&lt;Napari, bo̱ do̱'e̱ u̱t-shu̱'u̱t u̱ka u-nu̱m,</para>
  <para style="q2" vid="GEN 49:21">wa do̱'e̱ mat-du̱ yaag-u̱ so̱ye̱.<verse eid="GEN 49:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22"/>&lt;&lt;Yusuhu, bo̱ matu̱ yaag u-tát,</para>
  <para style="q2" vid="GEN 49:22">bo̱ o̱ sha-mu̱ te-yu̱ inabi</para>
  <para style="q1" vid="GEN 49:22">yu̱ o̱o̱ge̱ kit-u̱ u-gi yu̱ mu̱te̱ u̱t-ya,</para>
  <para style="q2" vid="GEN 49:22">yu̱ fe̱k-u̱s wa rogme̱</para>
  <para style="q1" vid="GEN 49:22">m-pas ja-mu̱ u̱r-bo̱ngo̱.<verse eid="GEN 49:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23"/>Hu̱u̱b-u̱t yo̱-to̱ u̱n do̱'e̱ he̱e̱se̱ u̱n</para>
  <para style="q2" vid="GEN 49:23">m-dum za u̱r-o̱n,</para>
  <para style="q1" vid="GEN 49:23">hu̱u̱b-u̱t yo̱-to̱ u̱n do̱'e̱</para>
  <para style="q2" vid="GEN 49:23">tadu̱ wu̱n u̱s-ta u̱t-e̱r ne̱.<verse eid="GEN 49:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24"/>Se̱di ta-u wu̱n u̱t-shu̱'u̱t</para>
  <para style="q2" vid="GEN 49:24">u̱ go̱ri-go̱ri,</para>
  <para style="q1" vid="GEN 49:24">tu̱msu̱ kom-u̱t wu̱n</para>
  <para style="q2" vid="GEN 49:24">u̱t-shu̱'u̱t u̱r-be̱b ne̱,</para>
  <para style="q1" vid="GEN 49:24">U̱-remu̱ kom-u̱ wa-u̱r-be̱b</para>
  <para style="q2" vid="GEN 49:24">wu̱ Yakubu, tu̱msu̱ u̱</para>
  <para style="q2" vid="GEN 49:24">remu̱ wa-gwat-du̱ na,</para>
  <para style="q1" vid="GEN 49:24">ta'ar-du̱ Isra-ne̱.<verse eid="GEN 49:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25"/>U-Ru̱, wu̱ u̱m no̱me̱ u̱t-huuk,</para>
  <para style="q2" vid="GEN 49:25">wa no̱me̱ ko̱-u̱r ró u̱r-se̱ge̱.</para>
  <para style="q1" vid="GEN 49:25">Ru̱-u̱ ko̱-uyan wa wa'-u̱</para>
  <para style="q2" vid="GEN 49:25">u̱n kom-u so̱-o̱,</para>
  <para style="q1" vid="GEN 49:25">u̱ to̱mto̱n u̱n m-bu̱ du̱gu̱ do̱m u-ru̱,</para>
  <para style="q2" vid="GEN 49:25">tu̱msu̱ wa ya'u̱ u̱n bu̱-mu̱ ta u-dak,</para>
  <para style="q1" vid="GEN 49:25">m-ra u̱ ta u-dak-ne̱.</para>
  <para style="q2" vid="GEN 49:25">Wa ya'u̱ u̱n na u-tát u̱ yaag ne̱.<verse eid="GEN 49:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26"/>Yage̱ nu-u so̱-o̱ tu̱ u̱so-u ró,</para>
  <para style="q2" vid="GEN 49:26">to̱ ze̱k nu-u so̱-o̱ tu̱ ro̱r-tu̱ da-u̱</para>
  <para style="q2" vid="GEN 49:26">tu̱ arke̱ m-tumb ne̱,</para>
  <para style="q1" vid="GEN 49:26">m-te jamu̱ ro̱r-tu̱ mo̱mmo.</para>
  <para style="q2" vid="GEN 49:26">Yusuhu, u̱m no̱ng u̱s-ko̱n</para>
  <para style="q1" vid="GEN 49:26">u̱zu̱ na ya'u̱ bo̱ to̱ haan u̱du̱ ró,</para>
  <para style="q2" vid="GEN 49:26">bo̱ yu̱ shu̱'u̱te̱ yu̱-shu̱ o̱r-u̱t ró ne̱.<verse eid="GEN 49:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27"/>&lt;&lt;Banyamin bo̱ o̱ye̱ u-go yu̱ u̱r-do̱g</para>
  <para style="q2" vid="GEN 49:27">yu̱ o̱o̱ge̱ ho̱g-du̱ u̱s-me̱r,</para>
  <para style="q1" vid="GEN 49:27">u̱r-wu̱n bo̱ ho̱ hu̱u̱b-u̱ u̱t-yo̱-to̱ ró,</para>
  <para style="q2" vid="GEN 49:27">tu̱msu̱ m-rim bo̱ de̱ mo̱t-du̱ kwu̱m-tu̱</para>
  <para style="q2" vid="GEN 49:27">bo̱ o̱nke̱ du̱gu̱-du̱ hu̱u̱b-u̱t yo̱-to̱ ró.&gt;&gt;<verse eid="GEN 49:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28"/>Tun-to̱ to̱ o̱ye̱ ko̱-tu̱ Isra-ne̱ o̱p-u̱t yu̱r, tu̱msu̱ no̱mu̱ u̱so-u̱ u̱n zu̱ye̱ u̱n u̱ ya da-u̱ wa o̱o̱ge̱ wa'-u̱ u̱n nu-u so̱-o̱. Wa wa'-u̱ ko̱wan nu-u so̱-o̱ u̱ kame̱ wa.<verse eid="GEN 49:28"/></para>
  <para style="s1">Mar-m Yakubu</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29"/>Yakubu yu̱ u̱n tunto̱ bo̱r-to̱: &lt;&lt;U̱m o̱ u̱t-mo̱r m-mar ne̱ u̱m byu̱tu̱n u̱so-u̱t ri. Jwaku̱n me̱ u̱ u̱so-u̱t ri ne̱ u-pu̱ku̱s u-tak u̱ Eparo̱n ne̱t-u̱ He̱t-ne̱. <verse eid="GEN 49:29"/><verse number="30" style="v" sid="GEN 49:30"/>Pu̱ku̱s u̱ o̱o̱ge̱ tak-u̱ Mape̱ra, u̱ dapu̱s Mamre Kan'ana, u̱ Ibrahi o̱ye̱ u̱ka be-du̱ u-dok u̱du̱ Eparo̱n ne̱t-u̱ He̱t-ne̱, u̱r-same̱ u-tak ne̱. <verse eid="GEN 49:30"/><verse number="31" style="v" sid="GEN 49:31"/>Ku̱na na dokte̱ Ibrahi e̱ ne̱ta wa Saratu. Ku̱na na dokte̱ Ishaku e̱ ne̱ta wa Rebeka. Ku̱na tu̱msu̱ na dokte̱ Riya. <verse eid="GEN 49:31"/><verse number="32" style="v" sid="GEN 49:32"/>Ibrahi o̱o̱g u-tak u̱ pu̱ku̱s ne̱ du̱gu̱-du̱ ne̱t-tu̱ He̱t.&gt;&gt;<verse eid="GEN 49:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 49:33"/>Da-u̱ Yakubu tase̱ waru̱ ya'ag-u̱ wa u̱s-rem, se̱ wa ru̱t u̱-do̱m u-yu̱n. Wa nom vu̱'e̱ su̱ m-vaste̱, wa dor u̱so-u̱t wa, wa mu̱ru̱s.<verse eid="GEN 49:33"/></para>
  <chapter eid="GEN 49"/>
  <chapter number="50" style="c" sid="GEN 50"/>
  <para style="s1">Dok-u Yakubu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1"/>Yusuhu he u̱ war-u̱ u̱so-u wa, wa nom u̱s-kan, wa ham-u̱t wa. <verse eid="GEN 50:1"/><verse number="2" style="v" sid="GEN 50:2"/>Se̱ Yusuhu zu̱ a-gwat-du̱ yar-mu̱ u̱so-u wa ne̱, e̱ wa'-u̱ war-u̱ u̱so-u wa Isra u̱s-baat su̱ de̱ hoosu̱ wa u̱t-zu̱m. Se̱ a-gwat-du̱ war-u wa wa'-u̱ wa baat-su̱ hoos-du̱ u̱t-zu̱m. <verse eid="GEN 50:2"/><verse number="3" style="v" sid="GEN 50:3"/>E̱ nom m-roog u̱t-shik u̱t-yu̱r [40], to̱ o̱ye̱ roog-mu̱ kame̱ na no̱m u̱ tamu̱ u̱s-baat su̱ hoos-du̱ u̱r-u u̱t-zu̱m. Ne̱t-tu̱ Masar no̱m m-roog u̱t-shik u̱t-tu̱t u̱ o̱p e̱ o̱ namu̱ jab-u̱ rem-u wu̱n [70].<verse eid="GEN 50:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4"/>Da-u̱ ru̱ttu̱ namu̱ jab arke̱, se̱ Yusuhu no̱m u̱s-rem u̱ ne̱nge̱n-tu̱ bu-u Faru̱k-u̱ Masar ne̱. Wa zu̱, &lt;&lt;A mu̱ne̱ me̱ kwu̱mu̱ hyu̱-m pusmo̱ u̱du̱ no̱, ko̱no̱n me̱ Faru̱k-u̱ Masar u̱ no̱ no̱mu̱ wa u̱s-rem. <verse eid="GEN 50:4"/><verse number="5" style="v" sid="GEN 50:5"/>&lt;Da-u̱ u̱so-u ri o̱o̱ge̱ u̱t-sa m-mar, wa wa'ag u̱m nom u̱s-to̱nd u̱zu̱, &lt;&lt;U̱m o̱ mo̱ttu̱ m-mar, jwaku̱n me̱ u̱ sag-u̱ u̱m kawe̱ u̱ hi-u̱r ri u̱ dak-u̱ Kan'ana.&gt;&gt; Yage̱ u̱m do̱'e̱ u̱m jwaku̱n u̱so-u ri, a u̱m tase̱ jwak-du̱ wa me̱ u̱t-mu̱u̱n za naas u-da.&gt; &gt;&gt;<verse eid="GEN 50:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6"/>Se̱ Faru̱k-u̱ Masar shu̱s wa zu̱, &lt;&lt;De̱'e̱ bo̱ jwaku̱n u̱so-u ró u̱ka bo̱ to̱ndte̱ u̱zu̱ bo̱ u̱t-no̱m.&gt;&gt;<verse eid="GEN 50:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7"/>Se̱ Yusuhu aru̱k m-ha u̱ jwak-du̱ u̱so-u wa. Tu̱-yat-to̱ Faru̱k-u̱ Masar shu̱-u̱ wu̱n be̱e̱t u̱ i-yate̱ kur-tu̱ kwu̱p-du̱ u̱s-rem u̱ i-yate̱ dak-u̱ Masar ne̱ be̱e̱t. <verse eid="GEN 50:7"/><verse number="8" style="v" sid="GEN 50:8"/>Yusuhu ku̱b ne̱t-tu̱ bu-u wa u̱t-be̱e̱t, u̱ o̱r-u̱t wa ne̱ u̱ ne̱t-tu̱ o̱o̱ge̱ ya bu-u̱ u̱so wu̱n ne̱ be̱e̱t. Se̱di e̱ yage̱ ya'ag-u̱ e̱ u̱ ban-tu̱ bisa-u̱t e̱ u̱ gwaar ne̱ u̱ ca ne̱ u̱ na ne̱ u̱ gas-u̱ Go̱sen. <verse eid="GEN 50:8"/><verse number="9" style="v" sid="GEN 50:9"/>Ke̱ke̱-su̱ jwaak u̱ ya-sak-mu̱ jwaak ne̱ tu̱msu̱ e̱ dor Yusuhu m-no̱k. Ne̱t-to̱ u-tát tu̱ doru̱ Yusuhu m-ha.<verse eid="GEN 50:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10"/>Da-u̱ u̱n teene̱ be-du̱ u̱t-sogor du̱ Atad, u-do̱m u̱ gi-yu̱ Jodan, e̱ nom namu̱ jab u̱s-kan ne̱ m-yat so̱k. Tu̱msu̱ ku̱na Yusuhu nomte̱ m-roog u̱t-ta'er u̱ namu̱ jab-u̱ remu̱ u̱so-u wa. <verse eid="GEN 50:10"/><verse number="11" style="v" sid="GEN 50:11"/>Da-u̱ Kan'ana-ne̱ i o̱ye̱ u̱ shu̱'u̱t u̱ku̱n e̱ hyane̱ u̱n iya u̱ be-du̱ na nomte̱ u̱r-vu du̱ Atad, e̱ zu̱, &lt;&lt;Din-de̱ be-de̱ be-du̱ namu̱ jab de̱ sok du̱ ne̱t-tu̱ Masar!&gt;&gt; Se̱ u̱n te̱'e̱ be-u̱r re̱ u̱r-dim u̱ dapu̱s gi-yu̱ Jodan &lt;&lt;Aber-mizrayim,&gt;&gt; Aber-mizrayim o̱ na zu̱ye̱, &lt;&lt;Be-du̱ namu̱ jab mu̱ ne̱t-tu̱ Masar.&gt;&gt;<verse eid="GEN 50:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12"/>Inya-o̱ ya'ag-u̱ campa-ne̱ Yakubu nomte̱ wa u̱ka wa zu̱tte̱ e̱ no̱m. <verse eid="GEN 50:12"/><verse number="13" style="v" sid="GEN 50:13"/>E̱ ku̱b wa m-ha u̱ dak-u̱ Kan'ana. E̱ dok wa u̱ pu̱ku̱s tak-u̱ Mape̱ra, u̱ dapu̱s Mamre, u̱ tak-u̱ Ibrahi o̱ye̱ be-du̱ u-dok du̱gu̱ Eparo̱n ne̱t-u̱ He̱t-ne̱, u̱ dame̱ u-tak ne̱. <verse eid="GEN 50:13"/><verse number="14" style="v" sid="GEN 50:14"/>Da-u̱ na tase̱ jwak-du̱ Yakubu, Yusuhu arku̱n u̱ mu̱u̱n u̱ Masar u̱ o̱r-u̱t wa ne̱ u̱ i shu̱'e̱ wa ne̱ u̱ ha-mu̱ jwak-du̱ u̱so-u wa.<verse eid="GEN 50:14"/></para>
  <para style="s1">Yusuhu wargu̱ o̱r-u̱t wa ne̱ u̱zu̱ <optbreak/> wa zaar u̱ to̱p-du̱ no̱mu̱ e̱ no̱mu̱ wa da</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15"/>Da-u̱ tu̱-wu̱to̱ Yusuhu ne̱ hyane̱ u̱zu̱ u̱so-u e̱ maru̱g, se̱ e̱ zu̱, &lt;&lt;¿A mu̱ne̱ u̱zu̱ Yusuhu o̱ m-shu̱p u̱ in ne̱ u̱-jab wa to̱p no̱m-u̱t yo̱-to̱ tu̱ in no̱mu̱ wa?&gt;&gt; <verse eid="GEN 50:15"/><verse number="16" style="v" sid="GEN 50:16"/>U̱ remu̱ iya u̱n nom tom u̱du̱ Yusuhu u̱zu̱, &lt;&lt;Kandi u̱so-u in u̱ mar wa yakke̱ tun-to̱ bo̱r-to̱: <verse eid="GEN 50:16"/><verse number="17" style="v" sid="GEN 50:17"/>Waru̱n Yusuhu, &lt;Bo̱ no̱mu̱ tu̱-wu̱to̱ ró ne̱ ho̱-du̱ ba'as-u̱t e̱, no̱m-u̱t yo̱-to̱ tu̱ e̱ no̱mu̱ bo̱, u̱ka e̱ yu̱te̱ bo̱ u̱r-ko̱b.&gt; Remu̱ iya it o̱ u̱s-ko̱n bo̱ no̱mu̱ u̱n u̱r-ho̱, it to̱k-ne̱ i Ru̱-u̱ u̱so-u ró.&gt;&gt; Da-u̱ se̱ re̱m-se̱ tene̱ du̱ wu̱n, Yusuhu nom u̱s-kan.<verse eid="GEN 50:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18"/>Tu̱-wu̱to̱ wa ne̱ haan e̱ he̱ u̱-shu̱ wa u̱t-jwu̱n, e̱ zu̱, &lt;&lt;It tu̱ ya to̱ku̱ ne̱ ró e̱.&gt;&gt;<verse eid="GEN 50:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19"/>Tu̱msu̱ Yusuhu zu̱ u̱n, &lt;&lt;A no̱ ho̱g u-gye̱r da! ¿Me̱ wa u-Ru̱ u̱m do̱te̱ ya-du̱ no̱ u̱r-ko̱b? <verse eid="GEN 50:19"/><verse number="20" style="v" sid="GEN 50:20"/>No̱ zo̱ngte̱ no̱ no̱mu̱ me̱ no̱m-u̱t yo̱-to̱, se̱di Ru̱-u̱ zo̱ngte̱ to̱ no̱m-u̱t so̱-to̱ rem wa shu̱u̱ste̱ no̱m-u̱ na no̱me̱ da-o̱, u̱ rem wa guut fat-tu̱ u̱t-ne̱t u-tát. <verse eid="GEN 50:20"/><verse number="21" style="v" sid="GEN 50:21"/>Remu̱ iya a no̱ ho̱g u-gye̱r da! Me̱ ya'u̱ no̱ no̱m u̱t-re̱ u̱ de̱ ko̱ru̱ no̱ u̱ ya'ag-u̱ no̱ ne̱. Iya-o̱ wa nomte̱ wa ru̱ste̱ jab-u̱s u̱n u̱r-be u̱r-gan.&gt;&gt;<verse eid="GEN 50:21"/></para>
  <para style="s1">Mar-m Yusuhu</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22"/>Yusuhu shu̱'u̱te̱ u̱ Masar, u̱ yu̱-du̱ u-bu u̱so-u wa ne̱. Wa shu̱'u̱te̱ u̱s-hak u̱t-shik u̱t-tan u̱ o̱p [110]. <verse eid="GEN 50:22"/><verse number="23" style="v" sid="GEN 50:23"/>Yusuhu no̱ng u̱r-yu̱ u̱s-hak u-tát wa hyen ya'ag-u̱ ya'ag-u̱ Makir, wu̱ o̱o̱ge̱ zwaru̱ Manase, i wa mate̱ kandi Yusuhu mar, tu̱msu̱ Yusuhu ku̱b ya'ag-u̱ e̱, e̱ shu̱'u̱t ya'ag-u̱ wa.<verse eid="GEN 50:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 50:24"/>Se̱ Yusuhu zu̱ tu̱-wu̱to̱ wa ne̱, &lt;&lt;Da-u̱ u̱m do̱'e̱ m-mar no̱ngo̱n u̱t-mo̱r. Za o̱ku̱n sakna o̱ Ru̱-u̱ u̱t-haan u̱du̱ no̱ u̱ wa ruut no̱ du̱gu̱ dak-u̱ Masar m-ha dak-u̱ este̱du̱ u̱s-rem su̱ wa no̱mu̱ Ibrahi, Ishaku, u̱ Yakubu ne̱.&gt;&gt; <verse eid="GEN 50:24"/><verse number="25" style="v" sid="GEN 50:25"/>Se̱ Yusuhu wu̱ ya'ag-u̱ Isra e̱ no̱m u̱s-to̱nd, wa zu̱, &lt;&lt;Ru̱-o̱ u̱t-haan u̱du̱ no̱ o̱ du̱-u̱t no̱. No̱ tabbe̱ u̱zu̱ no̱ kab-u̱g shar-u̱t ri du̱gu̱ din-de̱ be-de̱.&gt;&gt;<verse eid="GEN 50:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 50:26"/>Yusuhu maru̱g wa o̱tte̱ u̱s-hak u̱t-shik u̱t-tan u̱ o̱p [110]. Da-u̱ u̱n wa'-u̱ u-u̱r wa ba'at-su̱ hoos-du̱ u̱t-zu̱m, na wu̱ u-u̱r wa u adaka u̱ cu̱ndu̱ u̱r-u u̱-me̱ Masar.<verse eid="GEN 50:26"/></para>
  <chapter eid="GEN 50"/>
</usx>
