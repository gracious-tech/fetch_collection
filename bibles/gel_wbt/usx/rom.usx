<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Fakai Translation</book>
  <para style="h">Roma-ne̱</para>
  <para style="toc1">Ran-u Burus u̱ do̱'e̱ u̱du̱ Roma-ne̱</para>
  <para style="toc2">Roma-ne̱</para>
  <para style="toc3">Roma</para>
  <para style="mt2">Ran-u Burus u̱ do̱'e̱ u̱du̱</para>
  <para style="mt1">Roma-ne̱</para>
  <chapter number="1" style="c" sid="ROM 1"/>
  <para style="s1">U̱s-vu̱k</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1"/>Me̱, Burus wa-doru̱ Kiristi Ye̱so̱, me̱ pane̱ uno̱ ran-o̱. Ru̱-u̱ dak me̱ Wa-to̱m-u̱ Ye̱so̱. Wa dak me̱ remu̱ u̱m nom-u̱t bu̱t-tu̱ Rem-su̱ m-Re̱me̱r su̱ u-Ru̱. <verse eid="ROM 1:1"/><verse number="2" style="v" sid="ROM 1:2"/>Kanda haan-u̱r Ye̱so̱, Ru̱-u̱ no̱ng este̱du̱ Rem-u̱s se̱ m-tumb ne̱, su̱ rwu̱ne̱ du̱gu̱ nu-u̱ a-warru̱ Rem-su̱ u-Ru̱ ne̱, u̱ka o̱tte̱ m-pan u̱-me̱ Ran-u̱ Rem-su̱ u-Ru̱ u-he̱n. <verse eid="ROM 1:2"/><verse number="3" style="v" sid="ROM 1:3"/>Rem-su̱ m-Re̱me̱r u̱ se̱, su̱ mo̱ttu̱ Wa'-u̱ wa se̱, wu̱ shu̱'u̱te̱ ne̱t tu̱msu̱ wa rwu̱u̱n du̱gu̱ ko̱-u̱r Dawuda. <verse eid="ROM 1:3"/><verse number="4" style="v" sid="ROM 1:4"/>Tu̱msu̱ Ru̱-u̱ ko̱ske̱ u̱zu̱ Wa'-u̱ u-Ru̱ wa Ye̱so̱ o̱ye̱. Ru̱-u̱ no̱ng iya remu̱ be̱b-du̱ Yar-u wa da-u̱ na yu̱nsu̱ Ye̱so̱ du̱gu̱ m-mar. Wu̱na o̱ Ye̱so̱ Kiristi Wa-ko-uyan in. <verse eid="ROM 1:4"/><verse number="5" style="v" sid="ROM 1:5"/>Wu̱na dage̱ me̱ remu̱ u̱m shu̱'u̱te̱ Wa-to̱m-u̱ wa. Ru̱-u̱ yaag me̱ u-nya u̱m shu̱'u̱t Wa-to̱m-u̱ Ye̱so̱. Wa no̱ng iya remu̱ i-za-Yahuda-ne̱ da, e̱ de̱ yadu̱ wu̱n m-ze̱g tu̱msu̱ e̱ do̱r rem-u̱s rò remu̱ yadu̱ jab-u̱ e̱ no̱me̱ remu̱ bu̱t-tu̱ u̱m no̱mu̱ u̱n. <verse eid="ROM 1:5"/><verse number="6" style="v" sid="ROM 1:6"/>No̱ ne̱t-tu̱ bo̱-u̱ Roma, no̱ o̱ te̱k-u̱ ne̱t-tu̱ Ru̱-u̱ fage̱ e̱ shu̱'u̱t a-doru̱ Ye̱so̱ Kiristi.<verse eid="ROM 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7"/>U̱m o̱ panu̱ no̱ uno̱ ran-o̱, no̱ a-dor-ne̱ Roma be̱e̱t i Ru̱-u̱ o̱ u̱t-cwan tu̱msu̱ wa du̱g e̱ shu̱'u̱t ne̱t-u̱t wa:</para>
  <para style="p" vid="ROM 1:7">U̱m no̱ng u̱s-to̱o̱g u̱du̱ u-Ru̱ U̱so-u in u̱ Ye̱so̱ Kiristi ne̱ Wa-ko-uyan, wa re̱ shu̱ u̱ no̱mu̱ no̱ u-nya tu̱msu̱ wa ya' no̱ jab-u̱ pus-o̱.<verse eid="ROM 1:7"/></para>
  <para style="s1">Burus cwanu̱g ha-mu̱ Roma</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8"/>No̱m u̱m u̱t-sa u̱t-zu̱ u̱r-taku̱n, u̱m no̱ng u̱t-vam remu̱ no̱ a-dor be̱e̱t i bo̱-u̱ Roma. U̱m kerge̱ no̱mu̱ u-Ru̱ u̱t-vam remu̱ no̱m-u̱ Ye̱so̱ Kiristi no̱me̱, yaag in u-fu̱n in no̱m-u̱t u̱s-rem u-Ru̱ ne̱. Tu̱msu̱ u̱m no̱me̱ u-Ru̱ u̱t-vam remu̱ zu̱ ne̱t-tu̱ o̱ rem-su̱ yadu̱ jab-u̱ no̱ u̱-me̱ u-dak u-be̱e̱t. <verse eid="ROM 1:8"/><verse number="9" style="v" sid="ROM 1:9"/>Ru̱-u̱ nak u̱ka u̱m hopte̱ no̱mu̱ no̱ u̱s-to̱o̱g ko̱-uyan da-o̱. U-ho̱ m-gyu̱p ne̱ u̱-me̱ to̱o̱g-u̱s ri u̱m haatu̱n ko̱n-u̱s no̱ u̱du̱ Ru̱-u ri, wu̱ u̱m o̱ u̱t-do̱r jab gan, tu̱msu̱ u̱m o̱ do̱nse̱-du̱ Rem-su̱ m-Re̱me̱r su̱ Wa'-u̱ wa. <verse eid="ROM 1:9"/><verse number="10" style="v" sid="ROM 1:10"/>To̱o̱g-u̱s ri ko-uyan da, Ru̱-u̱ upse̱ me̱ u-fu̱n u̱m haan u̱m hyen-u̱t no̱, abite̱ iya wa o̱tte̱ u̱ssa.<verse eid="ROM 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 1:11"/>U̱m cwanu̱g u̱r-haan u̱du̱ no̱, u̱m no̱mu̱ no̱ u̱s-to̱o̱g no̱ kum-u̱t nya-u̱ u-Yar remu̱ no̱ shu̱'u̱te̱ u̱t-mo̱r u-Ru̱ tu̱msu̱ no̱ sur m-wa jab-u̱s no̱ u̱du̱ rò. <verse eid="ROM 1:11"/><verse number="12" style="v" sid="ROM 1:12"/>Cwan-u̱t ri o̱ u̱zu̱, me̱ u̱ no̱ ne̱ in swu̱ru̱n hi-u̱t in m-shiriktin u̱ yadu̱ jab u̱du̱ Ye̱so̱. <verse eid="ROM 1:12"/><verse number="13" style="v" sid="ROM 1:13"/>O̱r-u̱t ri, u̱m u̱t-sa no̱ nap, u̱s-fu̱n u-tát, u̱m saag u̱m haan u̱du̱ no̱. Se̱di u̱m kwu̱mu̱g u̱r-ke̱r da u̱ haan u̱ da-o̱. U̱m cwanu̱g u̱m haan u̱m se̱gu̱ no̱ u̱ka no̱ do̱te̱ swu̱ru̱ u̱r-be̱b u̱-me̱ Ye̱so̱ Kiristi. U̱m cwanu̱g u̱m no̱mu̱ no̱ iya u̱ka u̱m no̱mtu̱ e̱ke̱n ne̱ i za-Yahuda-ne̱ da.<verse eid="ROM 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 1:14"/>Shu̱'u̱te̱ me̱ u̱ka u̱r-mag u̱-me̱ jab-u̱ ri u̱du̱ u̱t-ne̱t u̱t-be̱e̱t. Shu̱'u̱te̱ me̱ u̱r-mag u̱du̱ ne̱t-tu̱ Girik u̱ ya za Girik-ne̱ da, tu̱msu̱ u̱du̱ a-m-nap-ne̱ u̱ a-za-m-nap-ne̱. <verse eid="ROM 1:14"/><verse number="15" style="v" sid="ROM 1:15"/>O̱ wu̱te̱ u̱m zo̱ngte̱ u̱t-bu̱t su̱ Rem-su̱ m-Re̱me̱r u̱du̱ no̱ i o̱ bo̱-u̱ Roma.<verse eid="ROM 1:15"/></para>
  <para style="s1">Be̱b-du̱ rem-u̱s Ye̱so̱</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16"/>U̱m za ho̱g-du̱ e̱'-mu̱ warru̱ Rem-su̱ m-Re̱me̱r da. Remu̱ zu̱ Rem-su̱ m-Re̱me̱r u̱ se̱ o̱ be̱b-du̱ u-Ru̱ ne̱ du̱ u-u̱ku̱r u̱du̱ ne̱t-tu̱ ya jab: Ru̱-u̱ taku̱n u̱kru̱ Yahuda-ne̱ i ya jab, se̱ i-za-Yahuda-ne̱ da. <verse eid="ROM 1:16"/><verse number="17" style="v" sid="ROM 1:17"/>Remu̱ me̱ rem-su̱ m-Re̱me̱r jab-u̱ so̱-o̱ du̱gu̱-du̱ u-Ru̱ ko̱ske̱, jab-u̱ so̱-o̱ u̱ o̱o̱ge̱ u̱du̱ yadu̱ u̱t-nip du̱gu̱ u̱r-taku̱n m-ha m-vaste̱, u̱ka rem-su̱ u-Ru̱ pu̱nte̱ se̱ u̱zu̱ &lt;&lt;Ne̱t-u̱ jab-u̱ so̱-o̱ wa u̱t-kwu̱m u̱r-fat a wa ya' jab u̱du̱ u-Ru̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="HAB 2:4">Haba 2:4</ref></char>.</note><verse eid="ROM 1:17"/></para>
  <para style="s1">Ryab-su̱ u-Ru̱ u̱du̱ <optbreak/> a-u̱t-ba'as-ne̱</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18"/>Ru̱-u̱ ko̱ske̱ ryab-u̱s wa su̱ rwu̱ne̱ du̱gu̱ do̱m u-ru̱ u̱du̱ a-za-jab-u̱s so̱-se̱ ne̱ u̱ a no̱m-du̱ no̱m-u̱t yo̱-to̱ ne̱. Remu̱ no̱m-u̱t yo̱-to̱ tu̱ ne̱t-tu̱ o̱ u̱t-no̱m wa'ag e̱ takke̱ u̱t-nip. <verse eid="ROM 1:18"/><verse number="19" style="v" sid="ROM 1:19"/>Kamu̱g u̱ kowan u̱ nap u̱ka Ru̱-u̱ o̱tte̱, remu̱ zu̱ Ru̱-u̱ ko̱ske̱ e̱ m-zu̱n ko̱wana wa o̱o̱ge̱. <verse eid="ROM 1:19"/><verse number="20" style="v" sid="ROM 1:20"/>Du̱gu̱ da-u̱ Ru̱-u̱ no̱me̱ u-dak, no̱m-tu̱ u-Ru̱, tu̱ na hyente̱ u̱ is da, u̱ shin-m wa mu̱ za u̱t-ta da, tu̱msu̱ u̱ka wa o̱tte̱ ne̱, ko̱ske̱ m-zu̱n cas u̱-me̱ no̱m-tu̱ Ru̱-u̱ no̱me̱. Remu̱ iya ka u̱t-no̱m zarra u̱ ne̱t-u̱ zu̱ wa nak u-Ru̱ da.<verse eid="ROM 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 1:21"/>E̱ nak u-Ru̱, se̱di e̱ ye'et wa m-sek u̱ka u-Ru̱ da, tu̱msu̱ e̱ no̱m-tu̱ wa u̱t-vam remu̱ no̱m-u̱ wa no̱me̱ da. Remu̱ zu̱ dorog-u̱s u̱n shu̱'u̱te̱ m-zan, tu̱msu̱ jab-u̱s e̱ shu̱u̱g u-cwu̱m. <verse eid="ROM 1:21"/><verse number="22" style="v" sid="ROM 1:22"/>E̱ o̱ m-hyan u̱ka zu̱ u̱n o̱ u̱s-ve̱r ne̱, se̱di dorog-u̱s u̱n su̱ m-rag se̱. <verse eid="ROM 1:22"/><verse number="23" style="v" sid="ROM 1:23"/>E̱ swase̱ no̱m-du̱ u̱t-huuk u̱du̱ u-Ru̱ wu̱ za u̱r-ma da, se̱di e̱ hu̱ no̱mu̱ u̱t-ryu̱n tu̱ o̱tte̱ sha-mu̱ u̱t-ne̱t tu̱ de̱ m-mar u̱ no ne̱ u̱ u̱t-bisa ne̱ u̱ no̱m-u̱ u̱r-fat ne̱.<verse eid="ROM 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24"/>Remu̱ iya, Ru̱-u̱ yage̱ u̱n, e̱ hu̱ no̱m-du̱ no̱m-tu̱ e̱ cwane̱ u̱ jab-u̱s e̱. E̱ hu̱ yu̱-du̱ m-o̱ u̱-me̱ du̱ ko̱b-du̱ ya-du̱ war-tu̱ o̱r-u̱t u̱n ne̱ m-ze̱g. <verse eid="ROM 1:24"/><verse number="25" style="v" sid="ROM 1:25"/>E̱ yage̱ do̱rru̱ Ru̱-u̱ u̱t-nip, e̱ ship u̱s-bi. E̱ hu̱ u̱t-huuk u̱ m-to̱k ne̱ u̱du̱ no̱m-tu̱ Ru̱-u̱ no̱me̱, se̱di Ru̱-o̱ no̱me̱ u̱n be̱e̱t. Ru̱-o̱ ko̱re̱ na no̱me̱ u̱t-vam za u̱r-ma. U̱ shu̱'u̱t iya.<verse eid="ROM 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26"/>Remu̱ iya, Ru̱-u̱ yage̱ e̱, e̱ nom-u̱t no̱m-tu̱ e̱ cwane̱ tu̱ m-'e̱. Ko̱ ne̱ta-ne̱ e̱ yage̱ m-roog campa-u̱t e̱ ne̱, e̱ hu̱ m-roog u̱ o̱r-u̱t e̱ ne̱ ne̱ta-ne̱. <verse eid="ROM 1:26"/><verse number="27" style="v" sid="ROM 1:27"/>Campa-ne̱ tu̱msu̱ e̱ yage̱ m-roog u̱ ne̱ta-u̱t e̱ ne̱. Se̱di e̱ to m-o̱ u̱ o̱r-u̱t e̱ ne̱. Campa-ne̱ no̱mo̱g cwu̱-tu̱ m-'e̱ u̱ o̱r-u̱t e̱ ne̱, tu̱msu̱ e̱ swaag u̱r-ko̱b remu̱ no̱m-tu̱ e̱ no̱me̱.<verse eid="ROM 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28"/>Ba shu̱'u̱te̱ u̱zu̱ e̱ gu̱gu̱mte̱ e̱ kum nap-mu̱ u-Ru̱, se̱ wa yage̱ e̱ dor dorog-su̱ m-zan u̱n. E̱ hu̱ no̱m-du̱ no̱m-tu̱ kame̱ u̱zu̱ u̱n no̱ng da.<verse eid="ROM 1:28"/></para>
  <para style="li">
    <verse number="29" style="v" sid="ROM 1:29"/>Jab-u̱s u̱n o̱ shu̱yi-shu̱yi u̱ no̱m-u̱t yo̱-to̱.</para>
  <para style="li" vid="ROM 1:29">E̱ o̱ u̱ no̱mu̱ ne̱t-ne̱ no̱m-u̱t yo̱-to̱.</para>
  <para style="li" vid="ROM 1:29">E̱ paste̱ cwan-tu̱ m-zan.</para>
  <para style="li" vid="ROM 1:29">E̱ o̱ no̱mu̱ ne̱t-ne̱ no̱m-tu̱ de̱ naasu̱ e̱ jab.</para>
  <para style="li" vid="ROM 1:29">E̱ paste̱ u̱r-shu̱b.</para>
  <para style="li" vid="ROM 1:29">E̱ o̱ u̱ ho̱-du̱ u̱ ne̱t-ne̱.</para>
  <para style="li" vid="ROM 1:29">E̱ paste̱ u-har.</para>
  <para style="li" vid="ROM 1:29">E̱ parru̱ ne̱t-ne̱.</para>
  <para style="li" vid="ROM 1:29">E̱ o̱ jab-u̱ rim-o̱ ne̱.</para>
  <para style="li" vid="ROM 1:29">E̱ o̱ m-shat.<verse eid="ROM 1:29"/></para>
  <para style="li">
    <verse number="30" style="v" sid="ROM 1:30"/>E̱ o̱ tu̱du̱ dim-tu̱ ne̱t-ne̱.</para>
  <para style="li" vid="ROM 1:30">E̱ yakke̱ u-Ru̱.</para>
  <para style="li" vid="ROM 1:30">E̱ paste̱ ju̱rmu̱ u̱t-ne̱t.</para>
  <para style="li" vid="ROM 1:30">E̱ paste̱ jaksu̱ u̱t-do̱s.</para>
  <para style="li" vid="ROM 1:30">E̱ yu̱kke̱ hu̱k-mu̱ u̱r-hi.</para>
  <para style="li" vid="ROM 1:30">Dorog-u̱s e̱ su̱ yo̱-se̱ se̱.</para>
  <para style="li" vid="ROM 1:30">E̱ o̱ ko̱b-du̱ kab-du̱ rem-su̱ i mate̱ e̱ ne̱.<verse eid="ROM 1:30"/></para>
  <para style="li">
    <verse number="31" style="v" sid="ROM 1:31"/>E̱ zatte̱ u̱r-hi da.</para>
  <para style="li" vid="ROM 1:31">E̱ nom-u̱t no̱mu̱ e̱ cinte̱ u̱s-rem da.</para>
  <para style="li" vid="ROM 1:31">E̱ hog-u̱t o̱n-du̱ ne̱t da.<verse eid="ROM 1:31"/></para>
  <para style="m">
    <verse number="32" style="v" sid="ROM 1:32"/>E̱ nak u̱zu̱ Ru̱-u̱ zu̱u̱g, i nome̱ no̱m-u̱t to̱ e̱ ko̱rge̱ na ho̱ e̱. Se̱di e̱ ze̱nge̱ u̱ no̱m-du̱ no̱m-tu̱ za so̱-to̱. E̱ maag u̱ku̱n da, e̱ hu̱ swu̱ru̱ e̱ke̱n be̱b-du̱ no̱m-du̱ no̱m-u̱t yo̱-to̱ to̱.<verse eid="ROM 1:32"/></para>
  <chapter eid="ROM 1"/>
  <chapter number="2" style="c" sid="ROM 2"/>
  <para style="s1">Ru̱-u̱ kwu̱p-du̱ <optbreak/> u̱s-rem ho̱n-ho̱n</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1"/>O̱r-u̱ ri, bo̱ wa hyan-du̱ ba'as-tu̱ o̱r-u̱ ró, bo̱ zatte̱ no̱m-u̱t war da. Remu̱ zu̱ da-u̱ bo̱ kwu̱pu̱ waku̱n u̱s-rem, bo̱ o̱ e̱ngu̱sse̱ hi-du̱ war ró, remu̱ zu̱ no̱m-u̱ bo̱ o̱tte̱ kwu̱pu̱ waku̱n u̱s-rem, o̱ bo̱ o̱ u̱t-no̱m. <verse eid="ROM 2:1"/><verse number="2" style="v" sid="ROM 2:2"/>U̱m zu̱u̱g iya remu̱ zu̱ Ru̱-u̱ nak u̱t-nip da-u̱ wa o̱ kwu̱p-du̱ u̱s-rem su̱ ne̱t-tu̱ o̱ no̱m-du̱ go̱-du̱ no̱m-u̱t yo̱-to̱ to̱. <verse eid="ROM 2:2"/><verse number="3" style="v" sid="ROM 2:3"/>Bo̱ ne̱t, wa kwu̱pu̱ ne̱t-ne̱ u̱s-rem remu̱ no̱m-du̱ no̱m-u̱t yo̱-to̱, se̱ bo̱ o̱ no̱m-du̱ no̱m-u̱t yo̱-to̱ ko̱ bo̱, ¿Bo̱ o̱ m-hyan u̱zu̱ bo̱ ku̱s-mu̱ kwu̱p-du̱ u̱s-rem su̱ u-Ru̱? <verse eid="ROM 2:3"/><verse number="4" style="v" sid="ROM 2:4"/>Kamu̱g in napu̱n u̱zu̱ Ru̱-u̱ no̱ngu̱ in no̱m-u̱t so̱-to̱, u̱ o̱n-u̱r wa ne̱ tu̱msu̱ wa zatte̱ ho̱r-mu̱ u̱s-nip da. A in ju̱ru̱m wu̱n da remu̱ gag-du̱ jab-u̱ wa u̱du̱ in. Napu̱n u̱zu̱ Ru̱-u̱ ko̱su̱ in o̱n-u̱r wa, remu̱ in byu̱rtu̱n u̱du̱ wa tu̱msu̱ in yage̱ no̱m-du̱ u̱t-ba'as.<verse eid="ROM 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 2:5"/>Se̱di remu̱ ko̱b-du̱ ho̱g-mu̱ u̱s-rem, u̱ ko̱b-du̱ u̱t-byu̱ru̱n ne̱ u̱du̱ u-Ru̱, bo̱ o̱ naknu̱ hi-u̱r ró swadu̱ u̱r-ko̱b u̱ ho̱-du̱ ryab-su̱ u-Ru̱. U̱ Ho̱-u̱r re̱ wa de̱ no̱mu̱ ne̱t-ne̱ kwu̱p-du̱ u̱s-rem ho̱n-ho̱n. <verse eid="ROM 2:5"/><verse number="6" style="v" sid="ROM 2:6"/>Ru̱-u̱ &lt;&lt;de̱ top ko̱wan ho̱n-ho̱n u̱ go̱-du̱ pama-u̱ wa no̱me̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 62:12">Se̱pV 62:12</ref>; <ref loc="PRO 24:12">ShaR 24:12</ref></char>.</note> <verse eid="ROM 2:6"/><verse number="7" style="v" sid="ROM 2:7"/>Ru̱-u̱ de̱ yadu̱ fat-du̱ za u̱r-ma u̱du̱ ne̱t-tu̱ o̱ no̱m-du̱ no̱m-u̱t so̱-to̱, tu̱msu̱ u̱du̱ i wa jab e̱ kum u̱t-fu̱'u̱bse̱, m-sek ne̱ u̱ wadu̱ jab ne̱ u̱ Ru̱-u̱ ya u̱n fat-du̱ za u̱r-ma. <verse eid="ROM 2:7"/><verse number="8" style="v" sid="ROM 2:8"/>Se̱di to̱ko̱n ne̱t-to̱ o̱tte̱ cwan-tu̱ u̱r-hi, e̱ yaag jab-u̱ no̱m-u̱ Ru̱-u̱ zu̱ye̱ nip-to̱ da. E̱ re shu̱ u̱ no̱m-du̱ no̱m-tu̱ za so̱-to̱. Ru̱-u̱ de̱ yadu̱ u̱n u̱r-ko̱b sok. <verse eid="ROM 2:8"/><verse number="9" style="v" sid="ROM 2:9"/>Wa de̱ yadu̱ ne̱t be̱e̱t wu̱ o̱ no̱m-du̱ no̱m-u̱t yo̱-to̱ u̱r-ko̱b sok u̱ namu̱ jab ne̱, Ru̱-u̱ de̱ he̱e̱se̱ yadu̱ Yahuda-ne̱ u̱r-ko̱b, kanda wa ya' i-za-Yahuda-ne̱ u̱r-ko̱b. <verse eid="ROM 2:9"/><verse number="10" style="v" sid="ROM 2:10"/>Se̱di Ru̱-u̱ de̱ yadu̱ ko̱wan wu̱ o̱ no̱m-du̱ no̱m-u̱t so̱-to̱, m-ze̱g, m-sek ne̱, u̱ res-du̱ jab ne̱. Ru̱-u̱ de̱ u̱t-taku̱n u̱du̱ Yahuda-ne̱, kanda wa ya' i-za-Yahuda-ne̱. <verse eid="ROM 2:10"/><verse number="11" style="v" sid="ROM 2:11"/>Remu̱ zu̱ Ru̱-u̱ ko̱ste̱ m-ku̱u̱k da.<verse eid="ROM 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12"/>I za-Yahuda-ne̱ da, a e̱ no̱me̱ u̱t-ba'as, Ru̱-u̱ de̱ kwu̱pu̱ e̱ u̱s-rem ko̱ u̱ka e̱ zatte̱ bo̱r-u̱t Ru̱-u̱ yase̱ Mosa da. Tu̱msu̱ Yahuda-ne̱ i o̱tte̱ bo̱r-u̱t Mosa, a e̱ no̱me̱ u̱t-ba'as, Ru̱-u̱ de̱ kwu̱pu̱ e̱ u̱s-rem remu̱ ko̱b-du̱ do̱rru̱ u̱t-bo̱r. <verse eid="ROM 2:12"/><verse number="13" style="v" sid="ROM 2:13"/>No̱ng ho̱n-ho̱n na ya u̱n u̱r-ko̱b, remu̱ za ne̱t be̱e̱t wu̱ nape̱ bo̱r-tu̱ u-Ru̱ wa o̱ ne̱t-u̱ jab-u̱ so̱-o̱ da. Se̱di ne̱t-tu̱ o̱ do̱rru̱ no̱m-u̱ bo̱r-tu̱ Ru̱-u̱ yase̱ Mosa, Ru̱-u̱ de̱ fag-du̱ ne̱t-u̱ wa, wa jab-u̱ so̱-o̱. <verse eid="ROM 2:13"/><verse number="14" style="v" sid="ROM 2:14"/>E̱ke̱n i za-Yahuda-ne̱ dor bo̱r-tu̱ Ru̱-u̱ yase̱ Mosa. Ko̱ske̱ u̱zu̱ bo̱r-tu̱ u-Ru̱ o̱ u̱-me̱ jab-u̱s u̱n, ko̱ ba shu̱'u̱te̱ u̱zu̱ waku̱n ya'aste̱ u̱n bo̱r-tu̱ Ru̱-u̱ yaase̱ Mosa da. <verse eid="ROM 2:14"/><verse number="15" style="v" sid="ROM 2:15"/>Yu̱-u̱r u̱n ko̱ske̱ u̱zu̱ e̱ nak u̱-me̱ jab-u̱s e̱ no̱m-u̱ Ru̱-u̱ u̱t-sa u̱-me̱ u̱t-bo̱r. Remu̱ zu̱ da-u̱ e̱ no̱me̱ no̱m-u̱ za so̱-o̱, jab-u̱s e̱ ko̱su̱ e̱, tu̱msu̱ a no̱me̱ u̱ so̱-o̱ jab-u̱s e̱ ko̱su̱ e̱. <verse eid="ROM 2:15"/><verse number="16" style="v" sid="ROM 2:16"/>Remu̱ iya, u̱ka no̱ hogte̱ me̱ bu̱t-tu̱ Rem-su̱ m-Re̱me̱r o̱ u̱t-war, iya do̱te̱ shu̱'u̱te̱. Ru̱-u̱ de̱ yadu̱ Ye̱so̱ Kiristi m-shin mu̱ wa do̱te̱ kwu̱pu̱ ne̱t-ne̱ u̱s-rem, ko̱ dorog-su̱ m-yasa su̱ jab-su̱ u̱t-ne̱t u̱s-be̱e̱t.<verse eid="ROM 2:16"/></para>
  <para style="s1">Yahuda-ne̱ u̱ Bo̱r-u̱t Mosa ne̱</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17"/>Bo̱ foge̱ hi-u̱r ró &lt;&lt;Wa-Yahuda wa,&gt;&gt; bo̱ to̱ste̱ jab-u̱ ró u̱ do̱m-u̱ bo̱r-tu̱ u-Ru̱, tu̱msu̱ bo̱ o̱ u̱t-u̱k u̱ yu̱-u̱r ró u̱zu̱ bo̱ ne̱t-u̱ u-Ru̱ wa. <verse eid="ROM 2:17"/><verse number="18" style="v" sid="ROM 2:18"/>Bo̱ nak no̱m-u̱ Ru̱-u̱ o̱ u̱t-cwan. Remu̱ zu̱ ne̱t-tu̱ iis-tu̱ bo̱ bo̱r-tu̱ u-Ru̱, tu̱msu̱ bo̱ nak no̱m-tu̱ kame̱ bo̱ dag tu̱ o̱ ho̱n-ho̱n. <verse eid="ROM 2:18"/><verse number="19" style="v" sid="ROM 2:19"/>A mu̱ne̱ u̱zu̱ bo̱ zatte̱ u-sakna da u̱zu̱ bo̱ o̱o̱ge̱ dor-u̱t ne̱t-tu̱ o̱ po̱-ne̱, tu̱msu̱ bo̱ o̱ bo̱ m-zu̱n u̱du̱ ne̱t-tu̱ o̱ u̱-me̱ u-cwu̱m. <verse eid="ROM 2:19"/><verse number="20" style="v" sid="ROM 2:20"/>Bo̱ kabe̱ u̱zu̱ bo̱ wa-u̱t-ko̱se̱ a-ko̱b-du̱ m-nap ne̱ wa u̱ ya'ag-u̱ re̱k-e̱ ne̱, remu̱ zu̱ bo̱ nak u̱zu̱ bo̱r-tu̱ Ru̱-u̱ yase̱ Mosa o̱tte̱ m-nap u̱ u̱t-nip ne̱. <verse eid="ROM 2:20"/><verse number="21" style="v" sid="ROM 2:21"/>Bo̱ wa iis-u̱ e̱ke̱n, ¿bo̱ iiste̱ hi-u̱r ró? Bo̱ wu̱ o̱ u̱t-bu̱t u̱zu̱ ne̱t-tu̱ yage̱ u-hiw, ¿bo̱ gwak-u̱t no̱m-u̱ bo̱ o̱ u̱t-war u̱r-zwar ne̱ u̱zu̱ bo̱ nom-u̱t u-hiw da? <verse eid="ROM 2:21"/><verse number="22" style="v" sid="ROM 2:22"/>Bo̱ wu̱ o̱ u̱t-zu̱ a ne̱t-tu̱ no̱m m-o̱ da, ¿bo̱ gwak-u̱t no̱m-u̱ bo̱ o̱ u̱t-war u̱r-zwar ne̱ u̱zu̱ bo̱ no̱m-u̱t m-o̱ da? Bo̱ wu̱ tonte̱ m-gir da, ¿bo̱ nom-u̱t u-hiw u̱ pyu̱ m-gir da? <verse eid="ROM 2:22"/><verse number="23" style="v" sid="ROM 2:23"/>Bo̱ wu̱ o̱ u̱t-u̱k u̱zu̱ bo̱ o̱tte̱ bo̱r-tu̱ Ru̱-u̱ yase̱ Mosa. ¿Se̱di bo̱ gwak-u̱t u̱zu̱ bo̱ naaste̱ dim-du̱ u-Ru̱ da-u̱ bo̱ pase̱ rem-su̱ u-bo̱r da? <verse eid="ROM 2:23"/><verse number="24" style="v" sid="ROM 2:24"/>De̱ wu̱te̱ Rem-su̱ u-Ru̱ zu̱u̱t, &lt;&lt;No̱m-u̱ Yahuda-ne̱ o̱ u̱t-no̱m wa'ag i-za-Yahuda-ne̱ o̱tte̱ ju̱rmu̱ Ru̱-u Yahuda-ne̱ ko̱he̱ne̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 52:5">Isha 52:5</ref>; <ref loc="EZK 36:22">E̱zik 36:22</ref></char>.</note><verse eid="ROM 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25"/>No̱m-du̱ u̱r-pe̱s o̱tte̱ u̱r-zwar, a ne̱t-u̱ do̱re̱ bo̱r-tu̱ u-Ru̱. Se̱di a ne̱t do̱re̱ bo̱r-tu̱ u-Ru̱ da wa shu̱'u̱te̱ u̱s-gan u̱ ne̱t-tu̱ na no̱me̱ u̱r-pe̱s ne̱ da. <verse eid="ROM 2:25"/><verse number="26" style="v" sid="ROM 2:26"/>A shu̱'u̱te̱ zu̱ i zatte̱ u̱r-pe̱s da, e̱ o̱ do̱rru̱ bo̱r-tu̱ u-Ru̱, Ru̱-u̱ de̱ kab-du̱ e̱ ne̱t-u̱t wa. <verse eid="ROM 2:26"/><verse number="27" style="v" sid="ROM 2:27"/>Na de̱ kwu̱pu̱ no̱ u̱s-rem remu̱ zu̱ no̱ o̱tte̱ bo̱r-u̱t Mosa tu̱msu̱ no̱ no̱mo̱g u̱r-pe̱s, se̱di no̱ o̱ pas-du̱ bo̱r-u̱t to̱.<verse eid="ROM 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 2:28"/>Wa-Yahuda wu̱ u̱t-nip wa bo̱ o̱ye̱ da, a-bo̱ shu̱'u̱te̱ wa-Yahuda u-war. Se̱di o̱tte̱ u̱r-zwar bo̱ shu̱'u̱t wa-Yahuda u̱ jab u-war ne̱. <verse eid="ROM 2:28"/><verse number="29" style="v" sid="ROM 2:29"/>Wa-Yahuda u̱t-nip wa o̱ wu̱ jab-u̱ wa o̱o̱ge̱ ho̱n-ho̱n u̱du̱ u-Ru̱. Yar u-Ru̱ o̱ do̱'e̱ no̱mu̱ jab-u̱ ne̱t u̱r-pe̱s za bo̱r-tu̱ ne̱t pane̱ da. Go̱-du̱ ne̱t-u̱ wa kum u̱t-vam du̱gu̱-du̱ u-Ru̱, za du̱gu̱-du̱ ne̱t da.<verse eid="ROM 2:29"/></para>
  <chapter eid="ROM 2"/>
  <chapter number="3" style="c" sid="ROM 3"/>
  <para style="s1">Ru̱-u̱ o̱ no̱m-du̱ no̱m-u̱ <optbreak/> wa zu̱ wa u̱t-no̱m</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1"/>¿De̱ku̱n se̱ge̱-de̱ o̱ro du̱ Yahuda-ne̱ kume̱ du̱ i-za-Yahuda-ne̱ kumte̱ da? ¿Yan-o̱ ne̱t de̱ u̱t-kwu̱m ana no̱mu̱ wa u̱r-pe̱s? <verse eid="ROM 3:1"/><verse number="2" style="v" sid="ROM 3:2"/>Se̱ge̱-du̱ o̱ro du̱ ne̱t do̱'e̱ u̱t-kwu̱m u̱s-fu̱n u-tát! Ru̱-u̱ ya'aste̱ rem-u̱s wa u̱du̱ Yahuda-ne̱ remu̱ e̱ got se̱ u̱r-zwar ne̱.<verse eid="ROM 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 3:3"/>Yahuda-ne̱ u-tát e̱ zatte̱ yadu̱ jab u̱du̱ u-Ru̱ u̱ka e̱ nomte̱ este̱du̱ u̱s-rem u̱zu̱ u̱t-ya jab da. Waku̱n u̱t-kere̱ u̱t-shu̱t u̱zu̱, &lt;&lt;¿No̱ o̱ m-hyan u̱zu̱ a Yahuda-ne̱ shu̱'u̱te̱ a-ko̱b-du̱ yadu̱ jab, u̱t-wa u̱ Ru̱-u̱ yage̱ no̱m-du̱ no̱m-u̱ wa nom-tu̱ Yahuda-ne̱ es-du̱ u̱s-rem?&gt;&gt; <verse eid="ROM 3:3"/><verse number="4" style="v" sid="ROM 3:4"/>Za u̱t-no̱me̱ da iya! Ko̱ ne̱t-ne̱ be̱e̱t shu̱'u̱te̱ a-u̱s-bi, u-Ru̱ wa-u̱t-nip wa, u̱ka Rem-su̱ u-Ru̱ zu̱tte̱:</para>
  <para style="q1" vid="ROM 3:4">&lt;&lt;Remu̱ ne̱t-ne̱ hyen-u̱t u̱zu̱ no̱m-u̱</para>
  <para style="q2" vid="ROM 3:4">bo̱ ware̱ u̱ mo̱ttu̱ ba'as-u̱t u̱n nip-to̱,</para>
  <para style="q1" vid="ROM 3:4">tu̱msu̱ bo̱ re̱ u̱r-ko̱rro̱ ana</para>
  <para style="q2" vid="ROM 3:4">o̱ kwu̱p-du̱ rem-u̱s ró.&gt;&gt;<verse eid="ROM 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5"/>Abite̱ no̱m-u̱t yo̱-to̱ in o̱ u̱t-no̱m ko̱ske̱ no̱m-u̱t so̱-to̱ tu̱ Ru̱-u̱ no̱me̱, ¿In de̱e̱n u̱t-zu̱ Ru̱-u̱ no̱ng ho̱n-ho̱n da a wa ya' in u̱r-ko̱b? (Sin-se̱ dorog-su̱ u̱r-ma ne̱t se̱.) <verse eid="ROM 3:5"/><verse number="6" style="v" sid="ROM 3:6"/>Za u̱t-no̱me̱ iya da! A shu̱'u̱te̱ Ru̱-u̱ no̱me̱ ho̱n-ho̱n da ko̱-uyan da, ¿re̱ne̱ o̱ wa do̱te̱ no̱mu̱ ne̱t-tu̱ u-dak kwu̱p-du̱ u̱s-rem ho̱n-ho̱n ne̱? <verse eid="ROM 3:6"/><verse number="7" style="v" sid="ROM 3:7"/>Waku̱n wa u̱t-kere̱ u̱t-zu̱, &lt;&lt;A mu̱ne̱ u̱zu̱ bis-u̱s ri hatu̱n m-swu̱r mu̱ nip-tu̱ Ru̱-u̱ u̱ swu̱r-mu̱ ze̱g-m wa ne̱, ¿Remu̱ u-yan o̱ Ru̱-u̱ do̱te̱ kwu̱pu̱ me̱ u̱s-rem u̱zu̱ me̱ wa-u̱t-ba'as wa?&gt;&gt; <verse eid="ROM 3:7"/><verse number="8" style="v" sid="ROM 3:8"/>To̱ko̱n ne̱t-to̱ ke̱k-tu̱ it u̱s-rem u̱zu̱ it zu̱u̱g, &lt;&lt;Yage̱ it no̱m u̱t-ba'as, remu̱ no̱m-u̱t so̱-to̱ nom-u̱t.&gt;&gt; Se̱di Ru̱-u̱ de̱ kwu̱pu̱ u̱n u̱s-rem ho̱n-ho̱n.<verse eid="ROM 3:8"/></para>
  <para style="s1">Waku̱n za ne̱t-u̱ so̱-o̱ da</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9"/>¿Yan-o̱ in do̱'e̱ u̱t-zu̱? ¿In Yahuda-ne̱ ze̱g m-ze̱g i-za-Yahuda-ne̱ da? Ko̱ o̱ko̱n, na ko̱sku̱ u̱zu̱ u̱t-ne̱t u̱t-be̱e̱t! U̱ Yahuda-ne̱ u̱ i-za-Yahuda-ne̱ da ganse̱ na o̱ye̱ remu̱ be̱b-du̱ u̱t-ba'as de̱ o̱ dor-tu̱ na. <verse eid="ROM 3:9"/><verse number="10" style="v" sid="ROM 3:10"/>U̱-me̱ Rem-su̱ u-Ru̱, na panu̱g no̱m-u̱t tun-to̱ u̱t-be̱e̱t:</para>
  <para style="q1" vid="ROM 3:10">&lt;&lt;Ne̱t-u̱ jab-u̱ so̱-o̱ zarra,</para>
  <para style="q2" vid="ROM 3:10">ko̱ wa-gan;<verse eid="ROM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ROM 3:11"/>waku̱n zaar wu̱ o̱ m-nap ne̱ da,</para>
  <para style="q2" vid="ROM 3:11">waku̱n zaar wu̱ o̱ sa-u̱ u-Ru̱ da.<verse eid="ROM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12"/>Ne̱t-ne̱ be̱e̱t e̱ yakke̱ fu̱n-yu̱ u-Ru̱,</para>
  <para style="q2" vid="ROM 3:12">Ne̱t-ne̱ be̱e̱t e̱ zatte̱ fu̱n da;</para>
  <para style="q1" vid="ROM 3:12">Waku̱n zaar wu̱ nome̱ no̱m-u̱t so̱-to̱ da,</para>
  <para style="q2" vid="ROM 3:12">ko̱ wa-gan.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 14:1-3">Se̱pV 14:1-3</ref>; <ref loc="PSA 53:1-3">53:1-3</ref>; <ref loc="ECC 7:20">WBu̱t 7:20</ref></char>.</note><verse eid="ROM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13"/>&lt;&lt;Nu-u̱t e̱ o̱ u̱ka u̱t-sag tu̱ o̱ u̱r-hu̱k,</para>
  <para style="q2" vid="ROM 3:13">Rem-u̱t e̱ shu̱u̱g u̱s-bi.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 5:9">Se̱pV 5:9</ref>. </char></note></para>
  <para style="q1" vid="ROM 3:13">&lt;&lt;Rem-u̱s e̱ u̱ka m-rab mu̱ fa-u yo̱-ya.&gt;&gt; <note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 140:3">Se̱pV 140:3</ref></char>.</note><verse eid="ROM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ROM 3:14"/>&lt;&lt;Nu-u̱t e̱ shu̱u̱g u̱ rem-u̱s yo̱-se̱,</para>
  <para style="q2" vid="ROM 3:14">u̱s-pyap ne̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 10:7">Se̱pV 10:7</ref>. </char></note><verse eid="ROM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15"/>&lt;&lt;E̱ waaste̱ ho̱-du̱ ne̱t da.<verse eid="ROM 3:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16"/>Ko̱ he̱ e̱ hu̱u̱te̱ e̱ hatu̱n u-naas u̱ namu̱ jab ne̱</para>
  <para style="q1" vid="ROM 3:16">u̱du̱ u̱t-ne̱t tu̱msu̱ hi-du̱ war'e̱ ne̱.<verse eid="ROM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17"/>E̱ nak fu̱n-yu̱ res-du̱ jab da.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 59:7-8">Isha 59:7-8</ref></char>.</note><verse eid="ROM 3:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18"/>&lt;&lt;Gye̱r-u u-Ru̱ zaar u̱ jab-u̱s u̱n da.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 36:1">Se̱pV 36:1</ref></char>.</note><verse eid="ROM 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19"/>U̱ da-o̱ in nak u̱zu̱ Yahuda-ne̱ e̱ na u̱t-sa e̱ do̱r bo̱r-tu̱ u-Ru̱ tu̱ Mosa pane̱. Na no̱mo̱g iya hen remu̱ ne̱t-tu̱ taagte̱ no̱m-u̱t war, tu̱msu̱ Ru̱-u̱ de̱ kwu̱pu̱ ne̱t-tu̱ dak-u uno̱ u-be̱e̱t u̱s-rem. <verse eid="ROM 3:19"/><verse number="20" style="v" sid="ROM 3:20"/>Remu̱ iya, waku̱n zaar wu̱ de̱ u̱t-shu̱'u̱t wa za u̱t-ba'as remu̱ do̱rru̱ no̱m-u̱ bo̱r-tu̱ zu̱ na no̱m da. No̱m-u̱ bo̱r-tu̱ nome̱ o̱ ko̱su̱ ne̱t u̱ka ba'as-u̱t wa o̱tte̱.<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 143:2">Se̱pV 143:2</ref>; <ref loc="GAL 2:16">Gara 2:16</ref></char>.</note><verse eid="ROM 3:20"/></para>
  <para style="s1">Yadu̱ jab u̱du̱ Ye̱so̱ wa'ag <optbreak/> in a-jab-u̱s so̱-se̱ ne̱</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21"/>Se̱di u̱ da-o̱ Mosa u̱ a-warru̱ Rem-su̱ u-Ru̱ ne̱ ko̱ske̱ in fu̱n-yu̱ yadu̱ jab-u̱ so̱-o̱, za remu̱ do̱rru̱ no̱m-tu̱ bo̱r-tu̱ u̱t-sa da. <verse eid="ROM 3:21"/><verse number="22" style="v" sid="ROM 3:22"/>Uno̱ jab-u̱ so̱-o̱ du̱gu̱-du̱ u-Ru̱ hagu̱n du̱gu̱-du̱ yadu̱ jab u̱du̱ Kiristi u̱du̱ i ya'e̱ u̱t-nip be̱e̱t. Mo̱ko̱n ku̱u̱k-mo̱ zaar da.<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="GAL 2:16">Gara 2:16</ref></char>.</note> <verse eid="ROM 3:22"/><verse number="23" style="v" sid="ROM 3:23"/>Ne̱t-ne̱ kowan no̱ng u̱t-ba'as, tu̱msu̱ e̱ no̱mo̱g m-ra u̱ sek-mu̱ u-Ru̱ ne̱. <verse eid="ROM 3:23"/><verse number="24" style="v" sid="ROM 3:24"/>Tu̱msu̱ Ru̱-u̱ no̱ng se̱ge̱-u̱r wa remu̱ nya-u̱ wa no̱mu̱ in jab gan. Wa no̱mo̱g iya remu̱ Kiristi Ye̱so̱ wu̱ rure̱ in du̱gu̱ swadu̱ u̱r-ko̱b du̱ u̱t-ba'as. <verse eid="ROM 3:24"/><verse number="25" style="v" sid="ROM 3:25"/>Ru̱-u̱ ya'aste̱ Ye̱so̱ u̱ka u̱r-to̱o̱g du̱ hastu̱ u̱t-ba'as. Wa no̱mo̱g iya remu̱ wa mu̱tte̱ ne̱t-ne̱ za u̱t-ba'as u̱du̱ u-Ru̱ da-u̱ e̱ ya jab u̱du̱ Ye̱so̱ wu̱ mare̱ u̱ remu̱ in tu̱msu̱ wa azu̱g hyu̱-m wa. To̱o̱g-u̱ o̱ ko̱ske̱ u̱zu̱ Ru̱-u̱ zatte̱ m-ku̱u̱k da, tu̱msu̱ remu̱ gag-du̱ jab-u̱ wa, wa ruuste̱ u̱ fu̱n-u̱ ba'as-tu̱ e̱ no̱me̱ u-dim wa yaag u̱n u̱r-ko̱b da. <verse eid="ROM 3:25"/><verse number="26" style="v" sid="ROM 3:26"/>Ru̱-u̱ no̱ng gag-du̱ jab-u̱ uno̱ da-o̱ remu̱ wa ko̱ste̱ u̱zu̱ wa o̱tte̱ jab-u̱ so̱-o̱. Tu̱msu̱ ne̱t be̱e̱t wu̱ ya' jab u̱du̱ Ye̱so̱ wa de̱ u̱t-shu̱'u̱t wa jab-u̱ so̱-o̱.<verse eid="ROM 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27"/>U̱ da-o̱ hen, ¿yan-o̱ na do̱te̱ u̱t-u̱k? O̱ko̱n zarra! Ru̱-u̱ za kab-du̱ ne̱t remu̱ zu̱ a o̱ do̱rru̱ bo̱r-u̱t Mosa da, se̱di wa kab i o̱ yadu̱ jab u̱du̱ Ye̱so̱ u̱ to̱o̱g-u̱ wa ne̱. <verse eid="ROM 3:27"/><verse number="28" style="v" sid="ROM 3:28"/>In nak u̱zu̱ Ru̱-u̱ o̱ kab-du̱ u̱t-ne̱t remu̱ yadu̱ jab-u̱ e̱ za remu̱ do̱rru̱ u-bo̱r da. <verse eid="ROM 3:28"/><verse number="29" style="v" sid="ROM 3:29"/>¿Ru̱-u Yahuda-ne̱ o̱ war-o̱? ¿Ru̱-u a-za Yahuda-ne̱ wa ko̱ e̱ da? Iya o̱, Ru̱-u̱ ne̱t-ne̱ be̱e̱t o̱. <verse eid="ROM 3:29"/><verse number="30" style="v" sid="ROM 3:30"/>Ru̱-o̱ u-gan, wa de̱ muutu̱ Yahuda-ne̱ e̱ shu̱'u̱t a-jab-u̱s so̱-se̱ u̱du̱ wa, remu̱ yadu̱ jab-u̱ u̱n. Tu̱msu̱ muut i za-Yahuda-ne̱ da a-jab-u̱s so̱-se̱ u̱du̱ wa, remu̱ yadu̱ jab-u̱ u̱n. <verse eid="ROM 3:30"/><verse number="31" style="v" sid="ROM 3:31"/>¿No̱ o̱ m-hyan in mu̱u̱tu̱n bo̱r-tu̱ Ru̱-u̱ yase̱ Mosa m-zan u̱ remu̱ mo̱ttu̱ ya-du̱ jab? Ko̱ cashi iya o̱ da! Se̱di a inya jab u̱du̱ Ye̱so̱, u̱t-ko̱se̱ u̱zu̱ bo̱r-u̱t Mosa o̱tte̱ m-shin.<verse eid="ROM 3:31"/></para>
  <chapter eid="ROM 3"/>
  <chapter number="4" style="c" sid="ROM 4"/>
  <para style="s1">Yadu̱ jab-u̱ Ibrahi</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1"/>¿A in o̱ dorog-su̱ mo̱ttu̱ bo̱r-u̱t Mosa tu̱msu̱ u̱ka ne̱t do̱te̱ u̱t-shu̱'u̱t wa jab-u̱ so̱-o̱, kamu̱g in baksu̱n Ibrahi, u̱so-u̱ u̱so-u̱t Yahuda-ne̱. <verse eid="ROM 4:1"/><verse number="2" style="v" sid="ROM 4:2"/>Abite̱ remu̱ no̱m-du̱ no̱m-u̱t so̱-to̱ Ibrahi o̱ Ru̱-u̱ has-tu̱ wa u̱t-ba'as, Ibrahi za kwu̱mu̱g no̱m-u̱ u̱t-u̱k u̱-me̱ u̱t-ne̱t, se̱di wa za kum-u̱t no̱m-u̱ u̱t-u̱k u̱du̱ u-Ru̱ da. <verse eid="ROM 4:2"/><verse number="3" style="v" sid="ROM 4:3"/>Rem-su̱ u-Ru̱ zu̱u̱g, &lt;&lt;Ibrahi yaag jab u̱du̱ u-Ru̱, de̱ wu̱te̱ Ru̱-u̱ fog-u̱t wa wa-jab-u̱ so̱-o̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="GEN 15:6">Taku̱ 15:6</ref>; <ref loc="GAL 3:6">Gara 3:6</ref></char>.</note><verse eid="ROM 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 4:4"/>Da-u̱ ne̱t-u̱ no̱me̱ u-pama, to̱p-u̱ na do̱'e̱ to̱p-du̱ wa ho̱s-mo̱ da. Se̱di to̱p-u̱ no̱m-u̱ wa no̱me̱ o̱. <verse eid="ROM 4:4"/><verse number="5" style="v" sid="ROM 4:5"/>Se̱di na got ne̱t-ne̱ a-jab-u̱s so̱-se̱ ne̱, za remu̱ pama-u̱s e̱ da, se̱di remu̱ yadu̱ jab-u̱ e̱ u̱du̱ u-Ru̱ wu̱ nome̱ ho̱-du̱ u̱t-ba'as. <verse eid="ROM 4:5"/><verse number="6" style="v" sid="ROM 4:6"/>Dawuda waru̱g rem-u̱s se̱ da-u̱ wa no̱me̱ rem-su̱ kom-u̱ u-Ru̱ u̱du̱ ne̱t-u̱ wu̱ Ru̱-u̱ fage̱ wa jab-u̱ so̱-o̱ za wa no̱m o̱ko̱n pama-o̱.<verse eid="ROM 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7"/>&lt;&lt;Ne̱t-tu̱ Ru̱-u̱ no̱me̱ ho̱-du̱ ba'as-u̱t e̱,</para>
  <para style="q2" vid="ROM 4:7">e̱ o̱tte̱ Kom-u̱ u-Ru̱,</para>
  <para style="q1" vid="ROM 4:7">I na takse̱ baas-u̱t e̱</para>
  <para style="q2" vid="ROM 4:7">otte̱ kom-u̱ u-Ru̱.<verse eid="ROM 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8"/>Kom u-Ru̱ u̱du̱ ne̱t,</para>
  <para style="q2" vid="ROM 4:8">wu̱ Yawe za u̱t-baku̱s</para>
  <para style="q1" vid="ROM 4:8">u̱ no̱m-tu̱ ba'as-u̱t wa ne̱ da.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 32:1-2">Se̱pV 32:1-2</ref></char>.</note><verse eid="ROM 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9"/>¿Kom-u̱ u-Ru̱ o̱ do̱m-u̱ a-u̱r-pe̱s-ne̱ u̱ war-e̱ kyak i na no̱me̱ u̱r-pe̱s? ¿Ko̱ be̱e̱t u̱ a-za-u̱r-pe̱s-ne̱? No̱m-u̱ in o̱ u̱t-zu̱, &lt;&lt;Ibrahi o̱tte̱ yadu̱ jab u̱du̱ u-Ru̱, de̱ wu̱te̱ Ru̱-u̱ ku̱b-u̱t wu̱n, wa-jab-u̱ so̱-o̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="GEN 15:6">Taku̱ 15:6</ref></char>.</note> <verse eid="ROM 4:9"/><verse number="10" style="v" sid="ROM 4:10"/>¿Yan da-o̱ Ru̱-u̱ muutu̱ Ibrahi wa jab-u̱ so̱-o̱? ¿Da-u̱ na no̱mu̱ wa u̱r-pe̱s o̱ ko̱ kanda na no̱mu̱ wa u̱r-pe̱s? Ru̱-u̱ fak Ibrahi wa jab-u̱ so̱-o̱ kanda na no̱m-tu̱ wa u̱r-pe̱s o̱. <verse eid="ROM 4:10"/><verse number="11" style="v" sid="ROM 4:11"/>Se̱di wa kabu̱g nap-su̱ u̱r-pe̱s remu̱ yadu̱ jab-u̱ rò u̱du̱ u-Ru̱ u̱zu̱ wa haste̱ ba'as-u̱t rò. Remu̱ iya Ibrahi shu̱'u̱te̱ u-u̱so u̱ yadu̱ jab u̱du̱ a-yadu̱ jab ne̱ ko̱ ba na no̱me̱ u̱n u̱r-pe̱s da. Ru̱-u̱ o̱ hyan-du̱ u̱n a-jab-u̱s so̱-se̱ ne̱ remu̱ yadu̱ jab-u̱ u̱n. <verse eid="ROM 4:11"/><verse number="12" style="v" sid="ROM 4:12"/>Tu̱msu̱ wu̱na u̱so-u i na no̱me̱ u̱r-pe̱s, za rem u̱r-pe̱s u̱ warre̱ da se̱di do̱rru̱ da-tu̱ yadu̱ jab-u̱ u̱so-u in Ibrahi kanda na no̱me̱ wa u̱r-pe̱s.<verse eid="ROM 4:12"/></para>
  <para style="s1">Este̱du̱ u̱s-rem u-Ru̱ haagu̱n <optbreak/> u̱du̱ in remu̱ yadu̱ jab</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13"/>Ru̱-u̱ no̱ngu̱ este̱du̱ u̱s-rem u̱ yaase̱ u-dak u-be̱e̱t u̱du̱ Ibrahi u̱ ko̱-u̱r wa ne̱, za remu̱ do̱rru̱ bo̱r-tu̱ u-Ru̱ da se̱di remu̱ zu̱ Ibrahi yaag jab u̱du̱ u-Ru̱. Remu̱ iya, Ru̱-u̱ zu̱ Ibrahi ne̱t-u̱ jab-u̱ so̱-o̱. <verse eid="ROM 4:13"/><verse number="14" style="v" sid="ROM 4:14"/>Abite̱ es-du̱ u̱s-rem su̱ u-Ru̱ u̱ i o̱ do̱rru̱ u-bo̱r ne̱ o̱ u̱ war-o̱, ko̱ske̱ u̱zu̱ yadu̱ jab-u̱ ne̱t zan-mo̱, tu̱msu̱ este̱du̱ u̱s-rem su̱ Ru̱-u̱ no̱me̱ zatte̱ m-kim da. <verse eid="ROM 4:14"/><verse number="15" style="v" sid="ROM 4:15"/>U̱m zu̱u̱g iya, remu̱ zu̱ bo̱r-tu̱ naku̱n ryab-su̱ u-Ru̱. Tu̱msu̱ be-du̱ bo̱r-tu̱ zatte̱ da, ne̱t za u̱t-shu̱'u̱t wa-ko̱b-du̱ kab-du̱ rem-su̱ u-bo̱r da.<verse eid="ROM 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16"/>Remu̱ iya, este̱du̱ u̱s-rem haan u̱ remu̱ yadu̱ jab. Ru̱-u̱ no̱ngu̱ in o̱ u̱ka m-ho̱s, u̱du̱ ne̱t-tu̱ o̱ u-me̱ ko̱-u̱r Ibrahi, za ne̱t-tu̱ na yaase̱ ne̱ u-bo̱r u̱ war-e̱ da, se̱di u̱r-kot u̱ i o̱tte̱ yadu̱ jab u̱ka Ibrahi. Wu̱na o̱ u-u̱so u̱ i ya jab be̱e̱t u̱du̱ este̱du̱ u̱s-rem su̱ u-Ru̱. <verse eid="ROM 4:16"/><verse number="17" style="v" sid="ROM 4:17"/>Rem-su̱ Ru̱-u̱ waru̱g u̱zu̱, &lt;&lt;Ibrahi, u̱m wa'ag bo̱, bo̱ shu̱'u̱t u̱so-u rem-tu̱ u-dak u-tát.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:17 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="GEN 17:5">Taku̱ 17:5</ref></char>.</note> Ru̱-u̱ no̱ng iya remu̱ zu̱ Ibrahi yaag jab u̱du̱ u-Ru̱ u̱zu̱ wa o̱tte̱ be̱b-du̱ yadu̱ u̱r-fat u̱du̱ wu̱ mare̱, tu̱msu̱ wu̱ nome̱ no̱m-u̱t po-to̱ u̱-me̱ no̱m-tu̱ za o̱ko̱n da.<verse eid="ROM 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 4:18"/>Ko̱ ba shu̱'u̱te̱ u̱zu̱ Ibrahi zatte̱ o̱ko̱n u̱ wa do̱te̱ wadu̱ jab da, se̱di wa re̱e̱g shu̱ u̱ yadu̱ jab ne̱ u̱zu̱ wa de̱ shu̱'u̱te̱ u̱so-u̱ u̱t-dak u-tát, u̱ka Ru̱-u̱ zu̱tte̱ wa u̱zu̱, &lt;&lt;Iya o̱ ya'ag-u̱ ró do̱te̱ u̱t-shu̱'u̱t.&gt;&gt; <verse eid="ROM 4:18"/><verse number="19" style="v" sid="ROM 4:19"/>Ibrahi yakke̱ u̱ yadu̱ jab-u̱ wa u̱ mar da, ko̱ ba shu̱'u̱te̱ u̱zu̱ wa no̱ng u̱s-hak u̱t-shik u̱t-tan, tu̱msu̱ ne̱ta wa Saratu aru̱kte̱ da-u̱ u̱r-mat. <verse eid="ROM 4:19"/><verse number="20" style="v" sid="ROM 4:20"/>Se̱di wa no̱ng u-sakna u̱ jab remu̱ este̱du̱ u̱s-rem su̱ Ru̱-u̱ no̱me̱ da, se̱di wa swu̱ru̱g yadu̱ jab, tu̱msu̱ wa no̱mu̱ u-Ru̱ m-sek. <verse eid="ROM 4:20"/><verse number="21" style="v" sid="ROM 4:21"/>Ibrahi yaag jab, Ru̱-o̱ keru̱ no̱m-du̱ no̱mu̱ wa zu̱ wa u̱t-no̱m. <verse eid="ROM 4:21"/><verse number="22" style="v" sid="ROM 4:22"/>Remu̱ yadu̱ jab Ibrahi, Ru̱-u̱ kabu̱g wa, &lt;&lt;wa-jab-u̱ so̱-o̱.&gt;&gt; <verse eid="ROM 4:22"/><verse number="23" style="v" sid="ROM 4:23"/>U̱ka na pu̱nte̱ u̱ Rem-su̱ u-Ru̱, &lt;&lt;Ru̱-u̱ kabu̱g wu̱n wa-jab-u̱ so̱-o̱.&gt;&gt; Tu̱msu̱ za remu̱ Ibrahi o̱ war-o̱ na pu̱nte̱ da. <verse eid="ROM 4:23"/><verse number="24" style="v" sid="ROM 4:24"/>Se̱di na panu̱g rem-u̱s sin-se̱ remu̱ in, remu̱ zu̱ Ru̱-u̱ mutte̱ in a-jab-u̱s so̱-se̱, ne̱t be̱e̱t wu̱ ya' jab u̱du̱ wa, wu̱ yu̱nse̱ Ye̱so̱ Wa-ko-uyan in du̱gu̱ m-mar. <verse eid="ROM 4:24"/><verse number="25" style="v" sid="ROM 4:25"/>Remu̱ ba'as-u̱t in, to̱ ne̱t-tu̱ hote̱ wa, tu̱msu̱ wa yu̱ne̱ du̱gu̱ m-mar remu̱ wa jaaste̱ ba'as-u̱t in.<verse eid="ROM 4:25"/></para>
  <chapter eid="ROM 4"/>
  <chapter number="5" style="c" sid="ROM 5"/>
  <para style="s1">Ru̱-u̱ de̱ yadu̱ in ru̱s-du̱ jab a <optbreak/> in to̱ste̱ jab-u̱s in u̱du̱ wa</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1"/>Ba shu̱'u̱te̱ u̱zu̱, Ru̱-u̱ jaaste̱ ba'as-u̱t in remu̱ yadu̱ jab u̱du̱ Ye̱so̱, in o̱tte̱ ru̱s-du̱ jab u-me̱ Wa-ko-uyan in Ye̱so̱ Kiristi. <verse eid="ROM 5:1"/><verse number="2" style="v" sid="ROM 5:2"/>Remu̱ yadu̱ jab-u̱ in, Kiristi upuste̱ in ke̱rru̱ kwu̱m-du̱ nya-u̱ u-Ru̱ u̱ in o̱tte̱ u̱r-yu̱. Tu̱msu̱ in no̱ng u̱r-so̱ remu̱ wadu̱ jab-u̱ Ru̱-u̱ de̱ ko̱su̱ in fu̱'u̱bse̱-tu̱ u-Ru̱. <verse eid="ROM 5:2"/><verse number="3" style="v" sid="ROM 5:3"/>Tu̱msu̱ in no̱mo̱n u̱r-so̱ da-u̱ ne̱t-tu̱ o̱ yadu̱ in u̱r-ko̱b remu̱ yadu̱ jab-u̱ in u̱du̱ Kiristi, remu̱ zu̱ in nak u̱zu̱ swadu̱ u̱r-ko̱b u̱ in do̱'e̱ naknu̱ in gag-du̱ jab. <verse eid="ROM 5:3"/><verse number="4" style="v" sid="ROM 5:4"/>A ne̱t-u̱ shu̱'u̱te̱ wa gag-du̱ jab, Ru̱-u̱ de̱ muutu̱ wa ne̱t-u̱ u̱r-ka. Tu̱msu̱ a ne̱t-u̱ shu̱'u̱te̱ ne̱t-u̱ u̱r-ka, wa de̱ shu̱'u̱tu̱ wa wadu̱ jab u̱du̱ u-Ru̱. <verse eid="ROM 5:4"/><verse number="5" style="v" sid="ROM 5:5"/>Wadu̱ jab za yadu̱ bo̱ m-'e̱ da ko̱ cashi, remu̱ zu̱ Ru̱-u̱ ko̱ske̱ in cwan-u̱t u̱ wa sok. Wa yaag in Yar-u wa, u̱-me̱ jab-u̱s in.<verse eid="ROM 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6"/>Da-u̱ in za keru̱ u̱kru̱ hi-u̱r in da, regne̱ ho̱n-ho̱n da-u̱ Kiristi mare̱ remu̱ ba'as-u̱t in. <verse eid="ROM 5:6"/><verse number="7" style="v" sid="ROM 5:7"/>U̱t-po̱ ne̱ na kum-u̱t waku̱n wu̱ de̱ m-mar remu̱ waku̱n wa-jab-u̱ so̱-o̱, jiya na u̱t-kere̱ kwu̱m-du̱ ne̱t wu̱ de̱ u̱t-mar remu̱ ne̱t-u̱ o̱ no̱m-du̱ no̱m-u̱t so̱-to̱. <verse eid="ROM 5:7"/><verse number="8" style="v" sid="ROM 5:8"/>Se̱di Ru̱-u̱ ko̱ske̱ in cwan-u̱t wa, u̱ wa to̱mto̱n in Kiristi wa mu̱r u̱ remu̱ in, da-u̱ in o̱o̱ge̱ a-u̱t-ba'as-ne̱.<verse eid="ROM 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 5:9"/>Ru̱-u̱ jaaste̱ ba'as-u̱t in remu̱ hyu̱-m Kiristi, za u-sakna, wa de̱ hen u̱ u̱kru̱ in du̱gu̱ ryab-su̱ u-Ru̱. <verse eid="ROM 5:9"/><verse number="10" style="v" sid="ROM 5:10"/>Da-u̱ in o̱o̱ge̱ m-ra u-Ru̱ ne̱, Ru̱-u̱ ho̱ngu̱ssu̱ in u̱ wa ne̱ remu̱ mar-mu̱ Wa'-u̱ wa. In nak u̱zu̱ Ye̱so̱ u̱ keru̱ u̱kru̱ in, tu̱msu̱ remu̱ zu̱ wa o̱ u̱r-fat. <verse eid="ROM 5:10"/><verse number="11" style="v" sid="ROM 5:11"/>Maag u̱ku̱n da, in do̱'e̱ no̱m-du̱ u̱r-so̱ remu̱ mar-mu̱ Wa-ko-uyan Ye̱so̱ Kiristi no̱me̱ wa samge̱ in u-Ru̱ ne̱.<verse eid="ROM 5:11"/></para>
  <para style="s1">M-mar du̱gu̱-du̱ Adamu <optbreak/> u̱r-fat u̱du̱ Ye̱so̱</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12"/>U̱ka ba'as-tu̱ cwatu̱n u̱-me̱ u-dak du̱gu̱-du̱ ne̱t gan, mar-mu̱ cwaan remu̱ zu̱ ne̱t-ne̱ be̱e̱t no̱ng u̱t-ba'as. Tu̱msu̱ mar-mu̱ haan u̱du̱ u̱t-ne̱t u̱t-be̱e̱t, remu̱ ba'as-tu̱ Adamu no̱me̱. <verse eid="ROM 5:12"/><verse number="13" style="v" sid="ROM 5:13"/>Kanda na hattu̱n bo̱r-tu̱ Ru̱-u̱ yase̱ Mosa, ne̱t-tu̱ o̱ no̱m-du̱ u̱t-ba'as. Se̱di na kabu̱g se̱ u̱ka u̱t-ba'as da, remu̱ zu̱ bo̱r-tu̱ zaar tu̱ ne̱t de̱ u̱t-pas da. <verse eid="ROM 5:13"/><verse number="14" style="v" sid="ROM 5:14"/>Ko̱ ba shu̱'u̱te̱ iya, mar-mu̱ takku̱n du̱gu̱ da-u̱ Adamu u̱ haan u̱ da-u̱ Mosa, tu̱msu̱ u̱ i no̱me̱ ne̱ u̱t-ba'as remu̱ pas-du̱ u-bo̱r da u̱ka Adamu nomte̱. Adamu tu̱msu̱ wa o̱o̱ge̱ ryu̱n-u̱ wu̱ de'e̱ haan. <note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">Wu̱ do̱'e̱ haan wa o̱ Ye̱so̱.</char></note><verse eid="ROM 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 5:15"/>Se̱di hastu̱ ba'as-u̱t in tu̱ Ru̱-u̱ no̱me̱ o̱ u̱ka m-ho̱s u̱du̱ in, za u̱ka ba'as-u̱t Adamu da. Remu̱ zu̱ ba'as-u̱t wa-gan nakku̱n mar-mu̱ u̱t-ne̱t u-tát. Se̱di nya-u̱ u-Ru̱ o̱ u-tát, remu̱ ho̱s-mu̱ wa no̱me̱ u̱-me̱ ne̱t gan u̱ wa, Ye̱so̱ Kiristi hattu̱n nya-u̱ u-Ru̱ u̱du̱ u̱t-ne̱t u-tát. <verse eid="ROM 5:15"/><verse number="16" style="v" sid="ROM 5:16"/>Tu̱msu̱, nya-u u-Ru̱ ganse̱ o̱o̱ge̱ u̱ ba'as-u̱t Adamu ne̱ da. U̱m zu̱u̱g iya remu̱ ba'as-u̱t to̱ tu̱ Adamu no̱me̱ to̱ nakku̱n kwu̱p-du̱ u̱s-rem su̱ u-Ru̱ u̱du̱ ne̱t-tu̱ u-dak u̱t-be̱e̱t. Se̱di nya-u u-Ru̱ muute̱ in za u̱t-ba'as ko̱ ba in no̱me̱ u̱t-ba'as u-tát. <verse eid="ROM 5:16"/><verse number="17" style="v" sid="ROM 5:17"/>Mar-m no̱mo̱g u̱r-faru̱k u̱-me̱ u̱t-ne̱t remu̱ ba'as-tu̱ ne̱t gan, Adamu. Se̱di m-ze̱g iya, Ye̱so̱ Kiristi samge̱ in u-Ru̱ ne̱. Ru̱-u̱ yaag in wa u̱ka m-ho̱s u-tát, tu̱msu̱ i kabe̱ wa, e̱ de̱ re̱-du̱ be̱b-du̱ u̱t-ba'as m-mar ne̱ u̱-me̱ Ye̱so̱ Kiristi.<verse eid="ROM 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18"/>Remu̱ ba'as-tu̱ wa u-gan no̱me̱, to̱ haatu̱n ne̱t-ne̱ be̱e̱t swadu̱ u̱r-ko̱b, tu̱msu̱ iya-o̱ hen no̱m-u̱ u-gan u̱ Kiristi no̱me̱, o̱ haatu̱n u-u̱ku̱r u̱-me̱ ko̱wan, u̱ka Ru̱-u̱ do̱te̱ yadu̱ ne̱t-ne̱ fat-du̱ za u̱r-ma. <verse eid="ROM 5:18"/><verse number="19" style="v" sid="ROM 5:19"/>Remu̱ ba'as-u̱t ne̱t gan no̱me̱, de̱ wu̱te̱ ne̱t-ne̱ be̱e̱t e̱ shu̱'u̱te̱ a-u̱t-ba'as-ne̱. Iya-o̱ hen tu̱msu̱ remu̱ jab-u̱ so̱-o̱ u̱ ne̱t gan no̱me̱, ne̱t-ne̱ u-tát e̱ de̱ u̱t-shu̱'u̱t a-jab-u̱s so̱-se̱ ne̱.<verse eid="ROM 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20"/>Ru̱-u̱ ya'aste̱ bo̱r-u̱t wa u̱du̱ Mosa remu̱ ne̱t-tu̱ hyen-u̱t ba'as-u̱t e̱ m-zu̱n. Se̱di da-u̱ ba'as-tu̱ sure̱ u-tát, nya-u̱ u-Ru̱ zeg u-tát sok. <verse eid="ROM 5:20"/><verse number="21" style="v" sid="ROM 5:21"/>U̱ka ba'as-tu̱ nomte̱ u̱r-faru̱k u̱-me̱ u̱t-ne̱t u̱t-be̱e̱t tu̱msu̱ hatu̱n u̱n m-mar, iya o̱ hen nya-u̱ u-Ru̱ do̱te̱ no̱m-du̱ u̱r-faru̱k remu̱ jab-u̱ so̱-o̱, u̱ de̱ hatu̱n fat-du̱ za u̱r-ma remu̱ Ye̱so̱ Kiristi Wa-ko-uyan in.<verse eid="ROM 5:21"/></para>
  <chapter eid="ROM 5"/>
  <chapter number="6" style="c" sid="ROM 6"/>
  <para style="s1">Kiristi getu̱mte̱ be̱b-du̱ u̱t-ba'as</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1"/>¿Yan-o̱ in do̱'e̱ u̱t-zu̱? ¿In de̱e̱n u̱ re-du̱ shu̱ u̱ no̱m-du̱ u̱t-ba'as remu̱ wa jaaste̱ ba'as-u̱t in tu̱msu̱ wa swu̱ru̱ in u-nya? <verse eid="ROM 6:1"/><verse number="2" style="v" sid="ROM 6:2"/>Za u̱t-no̱me̱ iya da! A in kabe̱ Ye̱so̱, no̱m-tu̱ wadu̱ in u̱ yu̱-du̱ u̱t-ba'as to̱ maru̱g, ¿re̱ do̱te̱ u̱t-no̱m in ha u̱r-yu̱ u-me̱ u̱t-ba'as? <verse eid="ROM 6:2"/><verse number="3-4" style="v" sid="ROM 6:3-4"/>U̱ka na no̱m-tu̱ in u̱t-yu̱bu̱sse̱ m-bu̱, in maru̱g tu̱msu̱ na dok in u̱ Kiristi ne̱ u̱ka wa mu̱rte̱ tu̱msu̱ na dok wa. Na no̱ngu̱ in u̱t-yu̱bu̱sse̱ m-bu̱ remu̱ in nom-u̱t yu̱-u̱r po-de̱ u̱ka u̱s-gan, u̱ka Ye̱so̱ yu̱nte̱ du̱gu̱ m-mar, u̱-me̱ fu̱'u̱bse̱-tu̱ u-Ru̱ Uso-u in. Iya o̱ in kumte̱ fat-u̱r po-de̱. <note caller="+" style="f"><char style="fr" closed="false">6:3-4 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="COL 2:12">Koro 2:12</ref></char>.</note><verse eid="ROM 6:3-4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5"/>Ba in shu̱'u̱te̱ u̱s-gan u̱ Kiristi ne̱ remu̱ mar-m Kiristi, iya o̱ hen in do̱te̱ u̱t-shu̱'u̱t u̱s-gan u̱ yu̱ne̱-u̱r wa u̱r-fat u̱ka wa yu̱nte̱. <verse eid="ROM 6:5"/><verse number="6" style="v" sid="ROM 6:6"/>U̱ka in nu̱pte̱ u̱zu̱ na taru̱g yu̱-du̱ u̱t-ba'as u̱ in u̱-do̱m u-kan da-u̱ na tare̱ Ye̱so̱ u̱-do̱m u-kan, taas u̱ ba'as-tu̱ kum-u̱t u̱r-be̱b u̱ jab-u̱s in da. Na no̱mo̱g sin-se̱ u̱s-be̱e̱t taas in shu̱'u̱t to̱k-ne̱ i u̱t-ba'as da. <verse eid="ROM 6:6"/><verse number="7" style="v" sid="ROM 6:7"/>In nak u̱zu̱ ba'as-tu̱ zatte̱ u̱r-faru̱k u̱ do̱m-u̱ ne̱t-tu̱ mare̱ da.<verse eid="ROM 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 6:8"/>Ba shu̱'u̱te̱ u̱zu̱ in maru̱g u̱ Kiristi ne̱, in o̱ yadu̱ jab u̱zu̱ in do̱'e̱ u̱r-fat u̱ wa ne̱. <verse eid="ROM 6:8"/><verse number="9" style="v" sid="ROM 6:9"/>In nakku̱n u̱zu̱ Ru̱-u̱ yu̱nste̱ Kiristi du̱gu̱ m-mar, tu̱msu̱ wa zamu̱n u̱t-swu̱r m-mar da. Mar-mu̱ zatte̱ u̱r-be̱b u̱du̱ Ye̱so̱ da. <verse eid="ROM 6:9"/><verse number="10" style="v" sid="ROM 6:10"/>Remu̱ mar-mu̱ wa mare̱, ba'as-tu̱ zatte̱ u̱r-be̱b u̱-me̱ wu̱n da, tu̱msu̱ u̱ da-o̱ wa o̱ yu̱-du̱ no̱mu̱ u-Ru̱ u̱t-fu̱'u̱bse̱.<verse eid="ROM 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 6:11"/>Remu̱ iya hen, kab hi-u̱r ró u̱ka wu̱ mare̱ taas u̱ ba'as-tu̱ dor-u̱t wa da, se̱di bo̱ kab hi-u̱r ró wa u̱r-fat u̱du̱ u-Ru̱ u̱-me̱ Kiristi Ye̱so̱. <verse eid="ROM 6:11"/><verse number="12" style="v" sid="ROM 6:12"/>Remu̱ iya, a no̱ yage̱ u̱ ba'as-tu̱ no̱m u̱r-faru̱k u̱-me̱ war-u̱t no̱ tu̱ de̱ m-mar da, taas no̱ do̱r zwarru̱ no̱m-u̱ war-u̱t no̱ o̱ u̱t-sa da. <verse eid="ROM 6:12"/><verse number="13" style="v" sid="ROM 6:13"/>A no̱ yase̱ o̱g-tu̱ war-u no̱ to̱ to̱ shu̱'u̱t cwu̱-tu̱ no̱m-du̱ u̱t-ba'as da. Se̱di no̱ yase̱ hi-u̱r no̱ u̱du̱ u-Ru̱, remu̱ zu̱ no̱ o̱gu̱ maru̱g se̱di u̱ da-o̱ no̱ o̱tte̱ fat-u̱r po-de̱. Remu̱ iya yaase̱ war-u no̱ u̱ shu̱'u̱t u̱ka cwu̱-tu̱ m-ank u̱ no̱m-du̱ no̱m-u̱t so̱-to̱ remu̱ fu̱'u̱bse̱-tu̱ u-Ru̱. <verse eid="ROM 6:13"/><verse number="14" style="v" sid="ROM 6:14"/>A no̱ yage̱ u̱ ba'as-tu̱ no̱m u̱r-faru̱k u̱-me̱ no̱ da, remu̱ zu̱ bo̱r-tu̱ zatte̱ u̱r-be̱b u̱-me̱ no̱ da. Se̱di, no̱mo̱n u̱r-yu̱ u̱-me̱ shin-mu̱ nya-u̱ u-Ru̱.<verse eid="ROM 6:14"/></para>
  <para style="s1">No̱mo̱n u̱r-yu̱ u̱ka to̱k u-Ru̱ u̱ <optbreak/> no̱m-du̱ pama-u̱ jab-u̱ so̱-o̱</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15"/>Ba shu̱'u̱te̱ u̱zu̱ nya-u u-Ru̱ u̱ku̱rte̱ in du̱gu̱ u̱t-bo̱r, ¿u̱t-shu̱'u̱t u̱zu̱ na re̱ shu̱ u̱ no̱m-du̱ u̱t-ba'as ne̱? O'o! Ko̱ ca! <verse eid="ROM 6:15"/><verse number="16" style="v" sid="ROM 6:16"/>¿No̱ nak u̱zu̱ a no̱ yaase̱ hi-u̱r no̱ u̱du̱ waku̱n u̱ka to̱k-ne̱ nomte̱ m-to̱k, no̱ shu̱'u̱te̱ to̱k-u̱ wa, remu̱ zu̱ no̱ o̱ do̱rru̱ wa da? No̱ keru̱ shu̱'u̱tu̱ to̱k-ne̱ u̱t-ba'as tu̱ hu̱u̱tu̱ ne̱t-ne̱ u̱du̱ m-mar, ko̱ no̱ keru̱ do̱rru̱ Rem-su̱ u-Ru̱ su̱ de̱ wadu̱ ne̱t u̱ yu̱-du̱ jab-u̱ so̱-o̱. <verse eid="ROM 6:16"/><verse number="17" style="v" sid="ROM 6:17"/>Se̱di u̱t-vam u̱du̱ u-Ru̱, remu̱ u̱r-taku̱n no̱ o̱o̱g m-to̱k u̱-me̱ u̱t-ba'as, se̱di u̱ da-o̱ no̱ kabu̱g ko̱se̱-tu̱ it no̱mu̱ no̱ jab gan. <verse eid="ROM 6:17"/><verse number="18" style="v" sid="ROM 6:18"/>Ru̱-u̱ ruute̱ no̱ du̱gu̱ to̱k-mu̱ u̱t-ba'as, no̱ shu̱'u̱te̱ to̱k-ne̱ u̱ no̱m-du̱ yu̱-du̱ jab-u̱s so̱-se̱.<verse eid="ROM 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 6:19"/>U̱m ko̱sku̱ no̱ sha-mu̱ u̱s-rem mu̱ to̱k remu̱ no̱ gotu̱ u̱r-nu, remu̱ jab-u̱ u̱r-ma ne̱t. U̱r-taku̱n no̱ o̱o̱gu̱ yasu̱ o̱g-tu̱ war-u̱t no̱ u̱ no̱m-du̱ no̱m-tu̱ za u-he̱n tu̱msu̱ u̱ swu̱rru̱ no̱m-u̱t yo̱-to̱. Remu̱ iya u̱ da-o̱, yasu̱n o̱g-tu̱ war-u̱t no̱ remu̱ no̱ no̱m-u̱t yu̱-du̱ jab-u̱s so̱-se̱ u̱ no̱ shu̱'u̱te̱ u-he̱n ne̱. <verse eid="ROM 6:19"/><verse number="20" style="v" sid="ROM 6:20"/>U̱ da-u̱ dim, no̱ o̱o̱g to̱k-ne̱ u̱t-ba'as, waku̱n wa'ag no̱ u̱ no̱m-du̱ no̱m-u̱t so̱-to̱ u̱r-be̱b da. <verse eid="ROM 6:20"/><verse number="21" style="v" sid="ROM 6:21"/>U̱ da-u̱ dim no̱ no̱mo̱g no̱m-tu̱ no̱ ho̱g-du̱ e̱'-mu̱ no̱m-du̱ to̱ u̱ da-o̱. ¿Yan to̱p-o̱ no̱ kume̱ remu̱ no̱m-du̱ no̱m-u̱t to̱? To̱p-u̱ no̱m-u̱t to̱ mar-mo̱. <verse eid="ROM 6:21"/><verse number="22" style="v" sid="ROM 6:22"/>Se̱di u̱ da-o̱, Ru̱-u̱ rwu̱ru̱g no̱ du̱gu̱ u̱t-ba'as, no̱ shu̱'u̱te̱ to̱k-ne̱ u-Ru̱. Nya-u u-Ru̱ u̱ no̱ de̱ u̱t-kwu̱m o̱ jab u-he̱n, tu̱msu̱ no̱ de̱ kwu̱m-du̱ fat-du̱ za u̱r-ma. <verse eid="ROM 6:22"/><verse number="23" style="v" sid="ROM 6:23"/>To̱p-u̱ u̱t-ba'as mar-mo̱, se̱di nya-u u-Ru̱ fat-du̱ za u̱r-ma du̱ u̱-me̱ Ye̱so̱ Kiristi Wa-ko-uyan in.<verse eid="ROM 6:23"/></para>
  <chapter eid="ROM 6"/>
  <chapter number="7" style="c" sid="ROM 7"/>
  <para style="s1">In o̱ u̱ka u̱r-gu̱ u̱ Kiristi ne̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1"/>O̱r-u̱t ri ne̱, no̱ nak u̱ka bo̱r-tu̱ o̱tte̱, no̱ nu̱pu̱ste̱ no̱m-u̱ u̱m de̱ u̱t-war, bo̱r-tu̱ nom u̱r-faru̱k u̱-do̱m ne̱t-u̱ o̱ u̱r-fat u̱ war-to̱. <verse eid="ROM 7:1"/><verse number="2" style="v" sid="ROM 7:2"/>A in gwate̱ ne̱ta u̱r-gu̱, wa o̱ m-shu̱p u̱ bo̱r-tu̱ u̱r-gu̱ ne̱, da-u̱ campa wa o̱ u̱r-fat. Se̱di da-u̱ campa wa mare̱, wa rwu̱u̱g u̱ bo̱r-tu̱ u̱r-gu̱. <verse eid="ROM 7:2"/><verse number="3" style="v" sid="ROM 7:3"/>Remu̱ iya a wa ga waku̱n campa wa, u̱ campa wa ne̱ u̱r-fat, na zu̱ wa wa-u-as. Se̱di a campa wa mare̱, wa rwu̱u̱g u̱-me̱ ho-yu̱ u̱r-gu̱, a ne̱ta-u ya ga waku̱n, wa no̱ng m-o̱ da remu̱ zu̱ campa wa maru̱g.<verse eid="ROM 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 7:4"/>Remu̱ iya no̱ o̱ o̱r-u̱t ri ne̱, mar-m Kiristi u̱-do̱m u-kan o̱ wa'ag no̱ shu̱'u̱te̱ marimari-ne̱ u̱du̱ u-bo̱r. Iya no̱ shu̱'u̱te̱ u̱s-gan, u̱ wu̱ yu̱ne̱ du̱gu̱ m-mar ne̱ remu̱ in no̱m-tu̱ u-Ru̱ u̱s-pama. <verse eid="ROM 7:4"/><verse number="5" style="v" sid="ROM 7:5"/>Da-u̱ in o̱ shu̱'u̱t u̱-me̱ yu̱-du̱ u̱t-ba'as tu̱ o̱ u̱r-yu̱ u̱-me̱ in, ko̱se̱-tu̱ u-bo̱r to̱ yu̱nstu̱n dorog-su̱ no̱m-u̱t yo̱-to̱ tu̱ haatu̱n in m-mar. <verse eid="ROM 7:5"/><verse number="6" style="v" sid="ROM 7:6"/>Se̱di u̱ da-o̱ in kwu̱ng u-u̱ku̱r, Ru̱-u̱ rwu̱ru̱g in du̱gu̱ u̱t-bo̱r. U̱ da-o̱ hen in o̱ do̱rru̱ u-Ru̱ u̱ fu̱n-yu̱ fat-u̱r po-de̱ yu̱ Yar-u wa. Fu̱n-yu̱ u-ut yu̱ na pane̱ u̱-me̱ u̱t-bo̱r in dor-u̱t ya da.<verse eid="ROM 7:6"/></para>
  <para style="s1">Bo̱r-u̱t Mosa u̱ <optbreak/> be̱b-du̱ u̱t-ba'as ne̱</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7"/>E̱ke̱n o̱ro i o̱ u̱t-zu̱, &lt;&lt;Bo̱r-tu̱ Ru̱-u̱ yase̱ Mosa o̱ yo̱-to̱.&gt;&gt; E̱ o̱ u̱t-zu̱ nap-mu̱ u̱t-bo̱r wa'ag in u̱ no̱m-du̱ u̱t-ba'as u-tát, se̱di no̱ng u̱r-zwar e̱ no̱m u̱s-dorog iya da. Bo̱r-tu̱ u-Ru̱ to̱ ko̱su̱ me̱ ba'as-u̱t ri. U̱m za nak u̱zu̱ shu̱b-du̱ no̱m-u waku̱n ba'as-to̱ da, se̱ da-u̱ bo̱r-tu̱ zu̱, &lt;&lt;A-bo̱ wa u̱r-is u̱ no̱m-u waku̱n da.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="EXO 20:17">Rwu̱u̱ 20:17</ref>; <ref loc="DEU 5:21">Muut 5:21</ref></char>.</note> <verse eid="ROM 7:7"/><verse number="8" style="v" sid="ROM 7:8"/>Se̱di remu̱ bo̱r-tu̱ u-Ru̱ to̱, de̱ wu̱te̱ ba'as-tu̱ kum-u̱t u̱r-ke̱r to̱ yu̱nsu̱n ko̱-uyan go̱-du̱ dorog-su̱ wadu̱ u̱r-is u̱ no̱m-u waku̱n u̱-me̱ jab-u̱ ri. U̱zu̱ bo̱r-tu̱ o̱ro da, ba'as-tu̱ za o̱tte̱ u̱r-be̱b da. <verse eid="ROM 7:8"/><verse number="9" style="v" sid="ROM 7:9"/>U̱ da-u̱ dim kanda u̱m nap no̱m-u̱ bo̱r-tu̱ u̱t-sa, u̱m o̱o̱g u̱ e̱kse̱ hi-u̱r ri u̱ no̱m-tu̱ u̱m o̱ u̱t-no̱m da. Se̱di da-u̱ u̱m nape̱ ko̱se̱-tu̱ bo̱r-tu̱ u-Ru̱, za rem u̱m nu̱p u̱zu̱ u̱m o̱ no̱m-du̱ u̱t-ba'as. <verse eid="ROM 7:9"/><verse number="10" style="v" sid="ROM 7:10"/>Se̱ u̱m mu̱r, bo̱r-tu̱ kame̱ u̱zu̱ to̱ hatu̱n u̱r-fat, to̱ hatu̱n m-mar mu̱ mo̱te̱ me̱ du̱gu̱-du̱ u-Ru̱.<verse eid="ROM 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 7:11"/>Ba'as-tu̱ kwu̱ng u̱r-ke̱r, to̱ paru̱g me̱ to̱ wu̱ me̱ u̱s-dorog u̱zu̱ me̱ keru̱ no̱m-du̱ u̱t-ba'as tu̱msu̱ u̱m do̱r u̱t-bo̱r u-da u-gan u̱ka u̱m do̱te̱ kwu̱m-du̱ fat-du̱ za u̱r-ma, se̱di o̱ mo̱k-u̱t du̱gu̱-du̱ u-Ru̱.<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="GEN 3:13">Taku̱ 3:13</ref></char>.</note> <verse eid="ROM 7:11"/><verse number="12" style="v" sid="ROM 7:12"/>Ko̱ ba shu̱'u̱te̱ iya, bo̱r-u̱t u-Ru̱ to̱ o̱ u-he̱n ne̱ tu̱msu̱ no̱m-tu̱ Ru̱-u̱ zu̱ na no̱m ne̱ to̱ o̱ u-he̱n ne̱ tu̱ jab-u̱ so̱-o̱, tu̱msu̱ tu̱ so̱-to̱ sok. <verse eid="ROM 7:12"/><verse number="13" style="v" sid="ROM 7:13"/>¿Se̱di yan-o̱ in do̱'e̱ u̱t-zu̱, bo̱r-tu̱ u-Ru̱ o̱ so̱-to̱ tu̱msu̱ to̱ hatu̱n in m-mar? Iya o̱ da ko̱ cashi! Ba'as-to̱ hatu̱n me̱ m-mar. Ba'as-tu̱ do̱ro̱g dim-u̱ bo̱r-u̱t so̱-to̱, to̱ hatu̱n me̱ m-mar. No̱ hyanu̱g u̱ka ba'as-tu̱ o̱tte̱ yo̱-to̱. To̱ do̱ro̱g bo̱r-u̱t so̱-to̱ tu̱ u-Ru̱ remu̱ no̱m-du̱ no̱m-u̱t yo̱-to̱.<verse eid="ROM 7:13"/></para>
  <para style="s1">Gag-mu̱ o̱ye̱ u̱-me̱ ne̱t remu̱ ba'as-u̱t wa</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14"/>In nak u̱zu̱ bo̱r-tu̱ Ru̱-u̱ yase̱ Mosa, du̱gu̱ Yar-u u-Ru̱ o̱ rwu̱ne̱. Se̱di me̱ ne̱t-wa, tu̱msu̱ to̱k u̱-me̱ u̱t-ba'as. <verse eid="ROM 7:14"/><verse number="15" style="v" sid="ROM 7:15"/>U̱m nak no̱m-u̱ u̱m de̱ u̱t-no̱m da. Remu̱ zu̱ no̱m-u̱ u̱m u̱t-sa u̱t-no̱m, u̱m nom-u̱t o̱ da, no̱m-u̱ u̱m gu̱gme̱ o̱ u̱m o̱ u̱t-no̱m.<note caller="+" style="f"><char style="fr" closed="false">7:15 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="GAL 5:17">Gara 5:17</ref></char>.</note> <verse eid="ROM 7:15"/><verse number="16" style="v" sid="ROM 7:16"/>Abite̱ no̱m-u̱ u̱m o̱ u̱t-no̱m, o̱ u̱m u̱t-sa u̱t-no̱m da, u̱m kabu̱g u̱zu̱ bo̱r-tu̱ u-Ru̱ to̱ o̱ ho̱n-ho̱n. <verse eid="ROM 7:16"/><verse number="17" style="v" sid="ROM 7:17"/>Me̱ wa u̱ hi-u̱r ri u̱ no̱m-du̱ no̱m-u̱t yo̱-to̱ da, se̱di ba'as-tu̱ o̱ me̱n-tu̱ jab-u̱ ri. <verse eid="ROM 7:17"/><verse number="18" style="v" sid="ROM 7:18"/>U̱m nak u̱zu̱ o̱ko̱n za u̱ so̱-o̱ u̱ o̱ u̱-me̱ jab-u̱ ri u̱r-ma ne̱t da, se̱di ba'as-to̱ o̱ u̱-me̱ jab-u̱ ri. U̱m zu̱u̱g iya remu̱ zu̱ u̱m cwanu̱g u̱zu̱ u̱m no̱mo̱g no̱m-u̱t so̱-to̱, se̱di u̱m kerte̱ u̱t-no̱m da. <verse eid="ROM 7:18"/><verse number="19" style="v" sid="ROM 7:19"/>U̱m wa'ag jab u̱m no̱m no̱m-u̱t so̱-to̱, se̱di u̱m o̱ no̱m-du̱ no̱m-u̱t yo̱-to̱ tu̱ u̱m za cwan-tu̱ u̱t-no̱m da. <verse eid="ROM 7:19"/><verse number="20" style="v" sid="ROM 7:20"/>A u̱m no̱me̱ no̱m-u̱ u̱m za u̱ssa u̱t-no̱m da, ko̱ske̱ u̱zu̱ me̱ wa o̱ no̱m-du̱ no̱m-u̱t yo̱-to̱ to̱ da, se̱di ba'as-tu̱ o̱ u̱-me̱ jab-u̱ ri.<verse eid="ROM 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21"/>U̱m hyanu̱g u̱zu̱, no̱m-u̱ u̱m nome̱ ko-uyan da-o̱; a u̱m u̱t-sa no̱m-du̱ no̱m-u so̱-o̱, u̱m hyen no̱m-u̱t yo̱-to̱ u̱r-kot u̱-me̱ ne̱ remu̱ o̱ hooste̱ me̱ no̱m-du̱ no̱m-u so̱-o̱. <verse eid="ROM 7:21"/><verse number="22" style="v" sid="ROM 7:22"/>Du̱gu̱ me̱n-tu̱ jab-u̱ ri, u̱m o̱ cwan-tu̱ bo̱r-tu̱ u-Ru̱. <verse eid="ROM 7:22"/><verse number="23" style="v" sid="ROM 7:23"/>Se̱di u̱ war-u ri u̱m o̱ hyan-du̱ o̱ko̱n u̱ o̱ m-gag u̱-me̱ jab-u̱ ri. O̱ dor-tu̱ me̱, tu̱msu̱ o̱ muutu̱ me̱ to̱k u̱t-ba'as. <verse eid="ROM 7:23"/><verse number="24" style="v" sid="ROM 7:24"/>No̱m-tu̱ u̱r-o̱n to̱ u̱m o̱ye̱! Wana de̱ u̱kru̱ me̱ du̱gu̱ no̱m-u̱ war-u ri u̱t-sa, taas u̱ mo̱t me̱ du̱gu̱-du̱ u-Ru̱? <verse eid="ROM 7:24"/><verse number="25" style="v" sid="ROM 7:25"/>U̱t-vam u̱du̱ u-Ru̱ u̱-me̱ Ye̱so̱ Kiristi Wa-ko-uyan in!</para>
  <para style="p" vid="ROM 7:25">Se̱di u̱ka u̱m ku̱bte̱ iya, u̱-me̱ dorog-u̱s ri u̱m u̱t-sa u̱m do̱r no̱m-tu̱ bo̱r-tu̱ zu̱ na no̱m, se̱di war-u o̱ wadu̱ me̱ u̱m shu̱'u̱t u̱ka to̱k u̱t-ba'as.<verse eid="ROM 7:25"/></para>
  <chapter eid="ROM 7"/>
  <chapter number="8" style="c" sid="ROM 8"/>
  <para style="s1">U̱r-yu̱ u̱ shin-mu̱ <optbreak/> Yar-u u-Ru̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1"/>Remu̱ iya u̱ da-o̱, kwu̱p-du̱ u̱s-rem su̱ m-mar zamu̱n da, u̱du̱ i o̱ u̱-me̱ Kiristi Ye̱so̱. <verse eid="ROM 8:1"/><verse number="2" style="v" sid="ROM 8:2"/>Remu̱ bo̱r-tu̱ u-yar, tu̱ mu̱u̱tu̱n in u̱r-fat u̱ same̱-du̱ u̱t-hi u̱ Kiristi Ye̱so̱ ne̱, to̱ ruute̱ me̱ du̱gu̱-du̱ bo̱r-tu̱ u̱t-baas, u̱ m-mar ne̱. <verse eid="ROM 8:2"/><verse number="3" style="v" sid="ROM 8:3"/>No̱m-u̱ bo̱r-u̱t Mosa kere̱ u̱t-no̱m da remu̱ jab u̱r-ma ne̱t, Ru̱-u̱ no̱mo̱g o̱. Ru̱-u̱ to̱mgo̱n Wa'-u̱ wa u̱ war-u̱ m-ma-ne̱t remu̱ wa shu̱'u̱te̱ u̱r-to̱o̱g remu̱ u̱t-ba'as, tu̱msu̱ wa haste̱ be̱b-du̱ u̱t-ba'as du̱gu̱ war-u̱t in. <verse eid="ROM 8:3"/><verse number="4" style="v" sid="ROM 8:4"/>Ru̱-u̱ no̱ng iya, remu̱ in no̱m-u̱t no̱m-tu̱ bo̱r-tu̱ zu̱ na nom. In no̱ng iya da-u̱ Yar-u̱ u-Ru̱ o̱ dor-tu̱ in, za m-ma-ne̱t du̱ dor-u̱t in da.<verse eid="ROM 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 8:5"/>Ne̱t-tu̱ o̱ u̱r-yu̱ u̱ka dorog-su̱ jab-u̱s e̱ ko̱ste̱ e̱, jab-u̱s e̱ shu̱'u̱t u̱ shi u̱ no̱m-tu̱ dorog-su̱ u̱r-ma ne̱t u̱t-sa. Se̱di i Yar-u u-Ru̱ o̱ dor-tu̱ e̱, e̱ nom dorog-su̱ no̱m-u̱ Yar-u u-Ru̱ u̱t-sa. <verse eid="ROM 8:5"/><verse number="6" style="v" sid="ROM 8:6"/>Yagu̱ jab-u̱s no̱ u̱ no̱m-du̱ u̱t-ba'as haatu̱n m-mar, se̱di wadu̱ jab-u̱ no̱ u̱ no̱m-tu̱ Yar-u̱ u-Ru̱ haatu̱n u̱r-fat u̱ ru̱s-du̱ jab ne̱. <verse eid="ROM 8:6"/><verse number="7" style="v" sid="ROM 8:7"/>Kowan wu̱ muute̱ jab-u̱ wa u̱ dorog-su̱ u̱r-ma ne̱t, wa shu̱'u̱tu̱ hu̱u̱b-u̱ yo̱-o̱ u-Ru̱ ne̱. U̱m zu̱u̱g iya remu̱ zu̱ wa do̱ro̱g bo̱r-tu̱ u-Ru̱ da, tu̱msu̱ wa u̱t-kere̱ u̱t-do̱r da. <verse eid="ROM 8:7"/><verse number="8" style="v" sid="ROM 8:8"/>Ne̱t-tu̱ o̱ dorog-su̱ u̱r-ma ne̱t, Ru̱-u̱ za ho̱g-du̱ zwarru̱ go̱-du̱ ne̱t-u̱t to̱ da.<verse eid="ROM 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9"/>Se̱di a in yage̱ dorog-su̱ u̱r-ma ne̱t u̱ dor-u̱t in da. Yagu̱n u̱ Yar-u u-Ru̱ o̱ dor-u̱t in, remu̱ zu̱ wa o̱ u̱r-yu̱ u̱-me̱ in. Ne̱t-tu̱ zatte̱ Yar-u̱ rwu̱ne̱ u̱du̱ Kiristi da, Kiristi nak wa da. <verse eid="ROM 8:9"/><verse number="10" style="v" sid="ROM 8:10"/>A regne̱ Kiristi o̱ u̱r-shu̱'u̱t u̱-me̱ no̱, ko̱ da war-u̱t no̱ maru̱g remu̱ u̱t-ba'as, Yar-u u-Ru̱ de̱ ya' no̱ u̱r-fat remu̱ zu̱ Ru̱-u̱ kabu̱g no̱ a-jab-u̱s so̱-se̱. <verse eid="ROM 8:10"/><verse number="11" style="v" sid="ROM 8:11"/>Yar-u u-Ru̱, u̱ yu̱nse̱ Ye̱so̱ du̱gu̱ m-mar, o̱ u̱-me̱ jab-u̱s no̱. U̱ka Ru̱-u̱ yu̱nste̱ Kiristi du̱gu̱ m-mar, wa de̱ yadu̱ no̱ u̱r-fat u̱ war-u̱t no̱ tu̱ m-mar remu̱ Yar-u wa u̱ o̱ u̱-me̱ no̱.<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="1CO 3:16">1Kor 3:16</ref></char>.</note><verse eid="ROM 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12"/>Remu̱ iya, hu̱u̱b-u̱t ri ne̱, in o̱tte̱ no̱m-u̱ u̱t-no̱m, se̱di za u̱ka dorog-su̱ no̱m-tu̱ m-ma-ne̱t du̱ u̱t-sa da. <verse eid="ROM 8:12"/><verse number="13" style="v" sid="ROM 8:13"/>A-bo̱ o̱ u̱r-yu̱ u̱ka m-ma-ne̱t du̱ o̱tte̱ u̱ssa, no̱ do̱'e̱ m-mar. Se̱di abite̱ no̱ o̱ do̱rru̱ no̱m-u̱ Yar-u u-Ru̱ u̱t-sa, tu̱msu̱ no̱ yage̱ u̱t-ba'as, no̱ de̱ kwu̱m-du̱ u̱r-fat. <verse eid="ROM 8:13"/><verse number="14" style="v" sid="ROM 8:14"/>Remu̱ zu̱ i Yar-u u-Ru̱ o̱ dor-tu̱ e̱, e̱ o̱ yaag u-Ru̱. <verse eid="ROM 8:14"/><verse number="15" style="v" sid="ROM 8:15"/>No̱ kwu̱mu̱g Yar-u de̱ muutu̱ no̱ to̱k-ne̱ da, remu̱ iya a no̱ shu̱'u̱t u̱ ho̱g-du̱ u-gye̱r da. Se̱di Yar-u o̱ de̱ u̱t-wa in shu̱'u̱t yaag u-Ru̱, u̱ remu̱ shin-mu̱ Yar-u o̱ in do̱'e̱ fag-du̱ u-Ru̱, &lt;&lt;Baba! U-u̱so in!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8:15 </char><char style="ft" closed="false">U̱t-Arameki: &lt;&lt;Abba! U̱so-u in!&gt;&gt;</char></note> <verse eid="ROM 8:15"/><verse number="16" style="v" sid="ROM 8:16"/>Yar-u u-Ru̱ u̱ yar-u in ne̱ o̱ waru̱ in u̱zu̱ yaag u-Ru̱ in o̱ye̱. <verse eid="ROM 8:16"/><verse number="17" style="v" sid="ROM 8:17"/>Ba shu̱'u̱te̱ u̱zu̱ yaag u-Ru̱ in o̱ye̱, shu̱'u̱te̱ u̱zu̱ a kwu̱m-tu̱ u-U̱so in o̱ye̱. In re̱e̱n kwu̱m-tu̱ u̱t-fu̱'u̱bse̱ tu̱ u-U̱so u̱r-kot u̱ Wa'-u̱ wa Kiristi ne̱. Se̱di a in kume̱ fu̱bu̱sse̱ tu̱ U̱so, ka u̱t-no̱m zarra, se̱ in swaag u̱r-ko̱b u̱r-kot u̱ Kiristi ne̱.<note caller="+" style="f"><char style="fr" closed="false">8:17 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="GAL 4:7">Gara 4:7</ref></char>.</note><verse eid="ROM 8:17"/></para>
  <para style="s1">Ru̱-u̱ de̱ yadu̱ ya'ag-u̱ <optbreak/> wa u̱t-fu̱'u̱bse̱</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18"/>U̱m nak u̱zu̱, in za keru̱ ho̱ngu̱sse̱ fu̱'u̱bse̱-tu̱ Ru̱-u̱ de̱ yadu̱ in u̱ ko̱b-du̱ in o̱ u̱t-swa ne̱ u̱ da-o̱ da. <verse eid="ROM 8:18"/><verse number="19" style="v" sid="ROM 8:19"/>No̱m-u̱ Ru̱-u̱ no̱me̱ u-be̱e̱t du̱gu̱ taku̱n-du̱ u-dak, o̱ wadu̱ jab o̱ hyan da-u̱ Ru̱-u̱ de̱ ko̱se̱ ko̱ re̱ ya'ag-u̱ wa o̱tte̱. <verse eid="ROM 8:19"/><verse number="20" style="v" sid="ROM 8:20"/>Remu̱ no̱m-tu̱ ba'as-tu̱ no̱me̱, no̱m-tu̱ Ru̱-u̱ no̱me̱ u̱t-be̱e̱t, e̱ kerge̱ no̱m-du̱ no̱m-u̱ Ru̱-u̱ cwane̱ e̱ no̱m da. Ru̱-u̱ wa'ag jab u̱zu̱<note caller="+" style="f"><char style="fr" closed="false">8:20 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="GEN 3:17-19">Taku̱ 3:17-19</ref></char>.</note> <verse eid="ROM 8:20"/><verse number="21" style="v" sid="ROM 8:21"/>no̱m-tu̱ wa no̱me̱ to̱ u̱t-kwu̱m u̱t-wu̱z du̱gu̱ m-to̱k u̱t-zu̱m ne̱. Wa o̱ wadu̱ jab e̱ de̱ kwu̱m-du̱ u̱t-fu̱'u̱bse̱ tu̱ na de̱ yadu̱ yaag u-Ru̱.<verse eid="ROM 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 8:22"/>In nak u̱zu̱ no̱m-tu̱ Ru̱-u̱ no̱me̱ u̱t-be̱e̱t e̱ o̱ u̱r-e' u̱ haan u̱ uno̱ da-o̱ e̱ o̱ u̱s-eku̱s u̱ka ne̱ta o̱ ho̱g-du̱ re̱mu̱ u̱r-mat nomte̱. <verse eid="ROM 8:22"/><verse number="23" style="v" sid="ROM 8:23"/>Za no̱mu̱ Ru̱-u̱ no̱me̱ o̱ u̱s-eku̱s u̱ war-o̱ da, u̱ in ne̱ be̱e̱t, in i Ru̱-u̱ no̱me̱ u-nya u̱ Yar-u̱ u-Ru̱ in o̱ u̱s-eku̱s u̱-me̱ jab-u̱s in. In o̱ u̱r-'e tu̱msu̱ u̱ wadu̱ jab ne̱ da-u̱ Ru̱-u̱ de̱ muutu̱ in ya'ag-u̱ wa, tu̱msu̱ wa guut war-u̱t in.<note caller="+" style="f"><char style="fr" closed="false">8:23 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="2CO 5:2-4">2Kor 5:2-4</ref></char>.</note> <verse eid="ROM 8:23"/><verse number="24" style="v" sid="ROM 8:24"/>Remu̱ wadu̱ jab, o̱ wu̱te̱ Ru̱-u̱ u̱ku̱rte̱ in. Se̱di wadu̱ jab-u̱ no̱m-u̱ no̱ hyane̱ wadu̱ jab de̱ da. Waku̱n za wadu̱ jab-u̱ no̱m-u̱ wa o̱tte̱ u̱t-kom da. <verse eid="ROM 8:24"/><verse number="25" style="v" sid="ROM 8:25"/>Se̱di a in o̱ wadu̱ jab-u̱ no̱m-u̱ in zatte̱ da, ko̱ske̱ u̱zu̱ in o̱ u̱r-'e u̱ gag-du̱ jab ne̱.<verse eid="ROM 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26"/>Iya o̱ hen Yar-u u-Ru̱ o̱tte̱ no̱mu̱ in u̱r-se̱ge̱ u̱ ko̱b-du̱ u̱r-be̱b u̱ in. In nak u̱ka no̱m-du̱ u̱s-to̱o̱g da, se̱di Yar-u̱ u-Ru̱ o̱ u̱s-to̱o̱g u̱ u̱t-shig ne̱ u̱du̱ u-Ru̱ remu̱ in u̱t-gom ne̱ tu̱ za u̱t-ware̱ da. <verse eid="ROM 8:26"/><verse number="27" style="v" sid="ROM 8:27"/>Ru̱-o̱ nape̱ jab u̱t-ne̱t be̱e̱t. Wa nu̱p u̱ka dorog-su̱ Yar-u̱ u-Ru̱ u̱ o̱ u̱s-to̱o̱g u̱ remu̱ ne̱t-u̱t wa. Da-u̱ Yar-u̱ u-Ru̱ no̱mu̱ in u̱s-to̱o̱g wa nak no̱m-u̱ Ru̱-u̱ u̱t-sa.<verse eid="ROM 8:27"/></para>
  <para style="s1">In ze̱kku̱n i re̱ u̱r-ko̱rro̱</para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28"/>In nak u̱zu̱ u̱ te̱k-u̱ u̱t-no̱m u̱t-be̱e̱t Ru̱-u̱ o̱ no̱m-du̱ no̱m-u̱t so̱-to̱ u̱du̱ i o̱ cwan-u̱t wa ne̱. Wa nom iya u̱du̱ ne̱t-tu̱ wa dage̱ u̱ remu̱ e̱ nom-u̱t no̱m-tu̱ wa zo̱nge̱ e̱ no̱m. <verse eid="ROM 8:28"/><verse number="29" style="v" sid="ROM 8:29"/>I Ru̱-u̱ dage̱ du̱gu̱ u̱r-taku̱n wa dak wa tu̱n e̱ shu̱'u̱t sha-mu̱ wa'-u̱ wa, remu̱ wa-u̱ wa shu̱'u̱te̱ mat-du̱ u̱r-taku̱n u̱-me̱ ban-du̱ o̱r-u̱t wa ne̱. <verse eid="ROM 8:29"/><verse number="30" style="v" sid="ROM 8:30"/>Remu̱ i Ru̱-u̱ dage̱, i wa bane̱. E̱ wa jaase̱ ba'as-u̱t e̱. Tu̱msu̱ in i Ru̱-u̱ jaase̱ ba'as-u̱t e̱, wa de̱ no̱mu̱ e̱ u̱t-fu̱'u̱bse̱.<verse eid="ROM 8:30"/></para>
  <para style="s1">Waku̱n zaar wu̱ de̱ u̱t-wa u̱ <optbreak/> Ru̱-u̱ yage̱ cwan-u̱t in da</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31"/>Gwatu̱n go̱-du̱ rem-u̱s sin-se̱, ¿Yan-to̱ in do̱'e̱ u̱t-zu̱? ¿A Ru̱-u̱ o̱ u̱r-kot u̱ in ne̱, wana de̱ m-gag u̱ in ne̱? <verse eid="ROM 8:31"/><verse number="32" style="v" sid="ROM 8:32"/>Ru̱-u̱ hoostu̱ Wa'-u̱ wa m-mar u̱-do̱m u-kan remu̱ in da, se̱di wa ya'aste̱ in Wa'-u̱ wa, wa keru̱ no̱mu̱ in ho̱s-mu̱ ko̱-uyan. <verse eid="ROM 8:32"/><verse number="33" style="v" sid="ROM 8:33"/>¿Wana de̱ saku̱ i Ru̱-u̱ dage̱ u̱t-ba'as? Waku̱n zarra, remu̱ zu̱ Ru̱-u̱ muute̱ u̱n za u̱t-ba'as. <verse eid="ROM 8:33"/><verse number="34" style="v" sid="ROM 8:34"/>¿Wana de̱ kere̱ u̱t-kwu̱p u̱zu̱ na ho̱ in? Ko̱ ne̱t! Ye̱so̱ Kiristi maru̱g, wa yu̱ne̱ du̱gu̱ m-mar, u̱ da-o̱ wa o̱ shu̱'u̱t u̱ kom u̱s-cwa u-Ru̱. Wa o̱ u̱s-to̱o̱g u̱du̱ u-Ru̱ remu̱ in. <verse eid="ROM 8:34"/><verse number="35" style="v" sid="ROM 8:35"/>Waku̱n zaar wu̱ de̱ u̱t-wa u̱ Kiristi yage̱ cwan-u̱t in da! Ko̱ u-taag, Ko̱ swa-u̱ u̱r-ko̱b, ko̱ u̱s-me̱r, ko̱ u̱r-so, ko̱ u-ra, u̱r-ho̱nse̱ ne̱, ko̱ m-mar, o̱ko̱n zaar u̱ de̱ hoosu̱ u-Ru̱ cwan-u̱t in da. <verse eid="ROM 8:35"/><verse number="36" style="v" sid="ROM 8:36"/>U̱ka Rem-su̱ u-Ru̱ zu̱tte̱,</para>
  <para style="q1" vid="ROM 8:36">&lt;&lt;Remu̱ zu̱ it o̱ ne̱t-u̱t ró,</para>
  <para style="q2" vid="ROM 8:36">ne̱t-tu̱ o̱ u̱t-cwan e̱ ho̱ it.</para>
  <para style="q1" vid="ROM 8:36">E̱ o̱ kab-du̱ it u̱ka ne̱t-tu̱</para>
  <para style="q2" vid="ROM 8:36">na de̱ u̱t-ho̱,</para>
  <para style="q1" vid="ROM 8:36">u̱ka wa-u-pan ku̱bte̱ ca m-ha</para>
  <para style="q2" vid="ROM 8:36">u̱du̱ u̱t-pan.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8:36 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 44:22">Se̱pV 44:22</ref></char>.</note><verse eid="ROM 8:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37"/>Ko̱ ba shu̱'u̱te̱ u̱zu̱, no̱m-u̱t yo̱-to̱ tun-to̱ u̱t-be̱e̱t to̱ kwu̱mu̱ in, in aru̱kte̱ na fag in a re̱-du̱ u̱r-ko̱rro̱, remu̱ Kiristi o̱ cwan-u̱t in. <verse eid="ROM 8:37"/><verse number="38-39" style="v" sid="ROM 8:38-39"/>U̱m nu̱pu̱ste̱ u̱zu̱, waku̱n zaar wu̱ do̱'e̱ u̱t-wa u̱ Ru̱-u̱ yage̱ cwan-u̱t in da:</para>
  <para style="li" vid="ROM 8:38-39">ko̱ m-mar,</para>
  <para style="li" vid="ROM 8:38-39">ko̱ u̱r-fat,</para>
  <para style="li" vid="ROM 8:38-39">ko̱ a-to̱mu̱ u-Ru̱,</para>
  <para style="li" vid="ROM 8:38-39">ko̱ faru̱k-u̱ no̱m u̱s-te,</para>
  <para style="li" vid="ROM 8:38-39">ko̱ no̱m-u̱ na o̱ te̱k u̱t-no̱m,</para>
  <para style="li" vid="ROM 8:38-39">ko̱ u̱ na de̱ u̱t-no̱m u̱ da-u̱ o̱o̱n ne̱,</para>
  <para style="li" vid="ROM 8:38-39">ko̱ yan go̱-du̱ u̱r-faru̱k,</para>
  <para style="li" vid="ROM 8:38-39">ko̱ m-ja,</para>
  <para style="li" vid="ROM 8:38-39">ko̱ u̱r-ra,</para>
  <para style="li" vid="ROM 8:38-39">ko̱ o̱ko̱n no̱m-o̱ u̱t-kwu̱s u̱t-kwu̱s,</para>
  <para style="li" vid="ROM 8:38-39">to̱ ko̱rge̱ to̱ mo̱t in u̱ cwan-tu̱ Ru̱-u̱ ne̱ da. Ru̱-u̱ ko̱ske̱ u̱zu̱ wa o̱ cwan-u̱t in, u̱ wa to̱mto̱n Ye̱so̱ Kiristi Wa-ko-uyan in wa mu̱r u̱ remu̱ in.<verse eid="ROM 8:38-39"/></para>
  <chapter eid="ROM 8"/>
  <chapter number="9" style="c" sid="ROM 9"/>
  <para style="s1">Ru̱-u̱ dak ne̱t-tu̱ Isra</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1"/>Remu̱ shu̱'u̱t-u̱r ri wa-doru̱ Kiristi, u̱m o̱ warru̱ u̱t-nip, Yar-u̱ u-Ru̱ o̱ dor-tu̱ jab-u̱ ri tu̱msu̱ o̱ ko̱ske̱ u̱zu̱ bise̱ u̱m o̱tte̱ da. <verse eid="ROM 9:1"/><verse number="2" style="v" sid="ROM 9:2"/>Jab-u̱ ri naag sok, me̱n-tu̱ du̱ng-te̱ me̱ za u̱r-ma. <verse eid="ROM 9:2"/><verse number="3" style="v" sid="ROM 9:3"/>U̱m no̱mo̱g dorog-u̱s se̱ remu̱ o̱r-u̱t ri ne̱ Isra-ne̱ campa-ne̱ u̱ u̱t-ne̱ta ne̱, u̱m cwanu̱g u̱zu̱ Ru̱-u̱ yagu̱ me̱ u̱m shu̱'u̱t u̱ka ne̱t wu̱ na wa-e̱ u-nu, na mo̱t me̱ u̱ Kiristi ne̱ remu̱ u̱ku̱r u̱ ne̱t-u̱t ri Isra-ne̱. <verse eid="ROM 9:3"/><verse number="4" style="v" sid="ROM 9:4"/>Ne̱t-tu̱ Isra, to̱ o̱ ne̱t-tu̱ Ru̱-u̱ mu̱tte̱ ya'ag-u̱ wa, wa ko̱sku̱ u̱n fu̱u̱bse̱-u̱t wa. Wa no̱ngu̱ u̱n este̱du̱ u̱s-rem, wa yasu̱ u̱n Bo̱r-u̱t wa. Wa ko̱su̱ u̱n fu̱n-yu̱ u̱t-huuk u̱t-nip ne̱ tu̱msu̱ u̱ este̱du̱ u̱s-rem ne̱.<note caller="+" style="f"><char style="fr" closed="false">9:4 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="EXO 4:22">Rwu̱u̱ 4:22</ref></char>.</note> <verse eid="ROM 9:4"/><verse number="5" style="v" sid="ROM 9:5"/>Ibrahi, Ishaku, u̱ Yakubu e̱ o̱ye̱ ne̱nge̱n-tu̱ u̱so-tu̱ u̱so-u̱t in, tu̱msu̱ Kiristi wa-Isra wa u̱ mat-du̱ ne̱t. Wu̱na o̱ u-Ru̱. Wu̱na o̱ faru̱k-u̱ ko̱wan be̱e̱t, tu̱msu̱ wa ko̱rge̱ na no̱mu̱ wa u̱t-vam za u̱r-ma, U̱ shu̱'u̱t iya!<verse eid="ROM 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6"/>Za remu̱ zu̱ es-du̱ u̱s-rem u-Ru̱ zatte̱ u̱r-be̱b da, se̱di remu̱ zu̱ ne̱t-tu̱ Isra to̱ u̱t-be̱e̱t ne̱t-tu̱ u-Ru̱ da. <verse eid="ROM 9:6"/><verse number="7" style="v" sid="ROM 9:7"/>Tu̱msu̱ za ne̱t-tu̱ ko̱-u̱r Ibrahi to̱ o̱ ne̱t-tu̱ u-Ru̱ da. Remu̱ iya, Ru̱-u̱ zu̱ Ibrahi, &lt;&lt;U̱-me̱ Ishaku <note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false">Ibrahi o̱tte̱ e̱ke̱n yaage̱, se̱di Ishaku wa o̱ye̱ wa'-u̱ Ru̱-u̱ nomte̱ este̱du̱ u̱s-rem u̱zu̱ wa ya' Ibrahi. </char></note> Me̱ rwu̱u̱tu̱n bo̱ yaag i u̱m no̱mu̱ bo̱ este̱du̱ u̱s-rem, za waku̱n u̱ te̱k-u̱ me̱ ya'ag-u̱ ró da.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false">Taku̱ 21:12.</char></note> <verse eid="ROM 9:7"/><verse number="8" style="v" sid="ROM 9:8"/>Yaag-u̱ na mate̱ u-war, e̱ o̱ ya'ag-u̱ Ru̱-u̱ da, se̱di ya'ag-u̱ este̱du̱ u̱s-rem, e̱ o̱ ya'ag-u̱ Ibrahi i u̱t-nip. <verse eid="ROM 9:8"/><verse number="9" style="v" sid="ROM 9:9"/>Baksu̱n no̱m-u̱ Ru̱-u̱ zu̱ye̱, da-u̱ wa no̱me̱ este̱du̱ u̱s-rem, &lt;&lt;Ba da-u̱ shiye̱, u̱m de̱ u̱t-mu̱u̱n, Saratu de̱ mat-du̱ yadu̱ u̱r-campa.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:9 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="GEN 18:10">Taku̱ 18:10</ref>,<ref loc="GEN 18:14">14</ref></char>.</note><verse eid="ROM 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10"/>Mo̱ko̱n sha-mu̱ o̱ro tu̱msu̱. Yaag-u̱ Rebeka o̱tte̱ u-u̱so u-gan, wu̱na o̱ u̱so-u in Ishaku. <verse eid="ROM 9:10"/><verse number="11-12" style="v" sid="ROM 9:11-12"/>Se̱di kanda na mat ya'ag-u̱ e̱ yu̱r, Ru̱-u̱ wargu̱ Rebeka u̱zu̱, &lt;&lt;Wa'-u̱ yat-wa de̱ no̱mu̱ wu̱ re̱k-wa m-to̱k.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:11-12 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="GEN 25:23">Taku̱ 25:23</ref></char>.</note> Ru̱-u̱ zu̱u̱g iya kanda e̱ nom-u̱t o̱ko̱n no̱m-o̱ u̱ so̱-o̱ ko̱ u̱ yo̱-o̱. Ru̱-u̱ zu̱u̱g iya remu̱ zu̱ wu̱na dage̱ Yakubu remu̱ zu̱ iya-o̱ Ru̱-u̱ cinte̱. <verse eid="ROM 9:11-12"/><verse number="13" style="v" sid="ROM 9:13"/>U̱ka Rem-su̱ u-Ru̱ zu̱tte̱, &lt;&lt;U̱m cwanu̱g Yakubu, u̱m gu̱gu̱mte̱ Isuwa.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="MAL 1:2-3">Mara 1:2-3</ref></char>.</note><verse eid="ROM 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14"/>¿Yan-o̱ in do̱'e̱ u̱t-zu̱? ¿No̱ o̱ m-hyan u̱ka zu̱ Ru̱-u̱ no̱ng ho̱n-ho̱n da? Iya-o̱ da! Ko̱ cashi! <verse eid="ROM 9:14"/><verse number="15" style="v" sid="ROM 9:15"/>Remu̱ Ru̱-u̱ zu̱u̱g Mosa,</para>
  <para style="q1" vid="ROM 9:15">&lt;&lt;Wa u̱m cwane̱ u̱m hyan o̱n-u̱r wa,</para>
  <para style="q2" vid="ROM 9:15">me̱ ho̱gu̱ o̱n-u̱r wa,</para>
  <para style="q1" vid="ROM 9:15">wa u̱m cwane̱ u̱m no̱mu̱ u̱r-ho̱,</para>
  <para style="q2" vid="ROM 9:15">me̱ no̱mu̱ wa u̱r-ho̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:15 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="EXO 33:19">Rwu̱u̱ 33:19</ref></char>.</note><verse eid="ROM 9:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="ROM 9:16"/>Remu̱ iya, za remu̱ cwan-mu̱ ne̱t mo̱ ko̱ pama-u̱s wa da, se̱di remu̱ o̱n-du̱ u-Ru̱ kyak. <verse eid="ROM 9:16"/><verse number="17" style="v" sid="ROM 9:17"/>Rem-su̱ u-Ru̱ zu̱ye̱ Faru̱k-u̱ Masar, &lt;&lt;U̱m wa'ag bo̱ Faru̱k remu̱ u̱m ko̱ste̱ u̱t-ne̱t shin-m ri u̱du̱ ró remu̱ u-dak u-be̱e̱t nu̱pu̱t me̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:17 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="EXO 9:16">Rwu̱u̱ 9:16</ref>. </char></note> <verse eid="ROM 9:17"/><verse number="18" style="v" sid="ROM 9:18"/>Iya Ru̱-u̱ hogte̱ o̱n-du̱ wu̱ wa cwane̱ wa ho̱g o̱n-u̱r wa, tu̱msu̱ wa rindu̱sse̱ jab-u̱ wu̱ wa cwane̱ u̱t-rindu̱sse̱.<verse eid="ROM 9:18"/></para>
  <para style="s1">Ryab-su̱ u-Ru̱ u̱ <optbreak/> o̱n-u̱r wa ne̱</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19"/>Waku̱n u̱t-kere̱ u̱t-zu̱, &lt;&lt;Abite̱ iya-o̱, ¿remu̱ yan-o̱ Ru̱-u̱ o̱tte̱ hyan-du̱ ba'as-u̱t in? ¿Wana de̱ gu̱gmu̱ no̱m-u̱ Ru̱-u̱ cwane̱?&gt;&gt; <verse eid="ROM 9:19"/><verse number="20" style="v" sid="ROM 9:20"/>¿Se̱di wana bo̱ mat-du̱ ne̱t bo̱ no̱m-u̱t inan u-Ru̱ ne̱? ¿No̱m-u̱ Ru̱-u̱ no̱me̱, o̱ u̱t-kere̱ u̱t-zu̱, &lt;&lt;Remu̱ yan-o̱ bo̱ nom-tu̱ me̱ inya?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:20 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 29:16">Isha 29:16</ref>; <ref loc="ISA 45:9">45:9</ref></char>.</note> <verse eid="ROM 9:20"/><verse number="21" style="v" sid="ROM 9:21"/>Wu̱ o̱ ma-u̱ u̱t-tur, wa keru̱ kab-du̱ u̱t-rwab wa no̱m u̱ka wa o̱tte̱ u̱ssa. Wa kere̱ kab-du̱ kwu̱s-du̱ u̱t-rwab u̱r-gan, wa mu̱u̱t u̱t-tur remu̱ ho̱-du̱ u̱r-mo̱ro̱g, tu̱msu̱ to̱ko̱n tur-to̱ hen remu̱ ne̱t-tu̱ daaste̱ u̱t-opos u̱-me̱.<verse eid="ROM 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22"/>Iya Ru̱-u̱ nomte̱ pama-u̱s wa, wa ko̱se̱ ryab-u̱s wa remu̱ u̱t-ba'as tu̱msu̱ wa ko̱se̱ u̱zu̱ remu̱ shin-m wa, wa keru̱ yadu̱ ne̱t-ne̱ u̱r-ko̱b i no̱me̱ u̱t-ba'as. Se̱di wa o̱tte̱ gag-du̱ jab u̱du̱ i wa de̱ ko̱su̱ ryab-u̱s wa, ne̱t-tu̱ kame̱ wa ya' e̱ u̱r-ko̱b. <verse eid="ROM 9:22"/><verse number="23" style="v" sid="ROM 9:23"/>Iya-o̱ wa o̱tte̱ u̱ssa wa ko̱se̱ fu̱u̱bse̱-u̱t wa u̱du̱ i wa u̱t-sa wa ho̱g o̱n-u̱r e̱, i wa zo̱nge̱ u̱r-taku̱n i de̱ kwu̱m-du̱ fu̱bu̱sse̱ wa. <verse eid="ROM 9:23"/><verse number="24" style="v" sid="ROM 9:24"/>In i Ru̱-u̱ bane̱, za in Yahuda-ne̱ u̱ war in da se̱di u̱ a-za Yahuda-ne̱. <verse eid="ROM 9:24"/><verse number="25" style="v" sid="ROM 9:25"/>U̱ka wa wu̱rte̱ u̱ ran-u Hoseya u̱zu̱:</para>
  <para style="q1" vid="ROM 9:25">&lt;&lt;I za ne̱t-u̱t ri da,</para>
  <para style="q2" vid="ROM 9:25">u̱m de̱ fag-du̱ e̱ &lt;Ne̱t-u̱t ri.&gt;</para>
  <para style="q1" vid="ROM 9:25">Tu̱msu̱ ko̱-du̱ u̱m o̱o̱g gu̱gu̱mte̱,</para>
  <para style="q2" vid="ROM 9:25">u̱m de̱ fag-du̱ de̱,</para>
  <para style="q1" vid="ROM 9:25">&lt;Ko̱-du̱ u̱m o̱ u̱t-cwan.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:25 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="HOS 2:23">Hose̱ 2:23</ref></char>.</note><verse eid="ROM 9:25"/></para>
  <para style="m">
    <verse number="26" style="v" sid="ROM 9:26"/>Tu̱msu̱ &lt;&lt;U̱ be-u̱r re̱ du̱ na fog-tu̱ u̱n:</para>
  <para style="q1" vid="ROM 9:26">&lt;No̱ o̱ ne̱t-tu̱ ri i da,&gt; na de̱ fag-du̱ u̱n, &lt;Yaag-u̱ Ru̱-u̱ u̱r-fat.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:26 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="HOS 1:10">Hose̱ 1:10</ref></char>.</note><verse eid="ROM 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 9:27"/>Ishaya wa-warru̱ Rem-su̱ u-Ru̱ jaku̱s u-cwar wa no̱m u̱s-rem u̱ mo̱t-tu̱ Isra-ne̱,</para>
  <para style="q1" vid="ROM 9:27">&lt;&lt;Isra-ne̱ o̱ u-tát u̱ka hereg-mu̱ m-sa,</para>
  <para style="q2" vid="ROM 9:27">se̱di u̱ be-du̱ u̱n o̱tte̱,</para>
  <para style="q1" vid="ROM 9:27">ne̱t-to̱ cashi e̱ de̱</para>
  <para style="q2" vid="ROM 9:27">kwu̱m-du̱ u-u̱ku̱r.<verse eid="ROM 9:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ROM 9:28"/>Yawe de̱ kwu̱pu̱ u-dak u-be̱e̱t u̱s-rem za naas u-da,</para>
  <para style="q2" vid="ROM 9:28">tu̱msu̱ wa ho̱o̱g se̱ o̱ko̱n za u̱t-kwu̱s da.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:28 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 10:23">Isha 10:23</ref>. </char></note><verse eid="ROM 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ROM 9:29"/>U̱ka Ishaya wa-warru̱ Rem-su̱ u-Ru̱ zu̱tte̱ u̱ de̱ku̱n be-de̱:</para>
  <para style="q1" vid="ROM 9:29">&lt;&lt;Se̱di u̱zu̱ Yawe wu̱ ze̱ge̱ m-shin</para>
  <para style="q2" vid="ROM 9:29">yaku̱ste̱ in e̱ke̱n u̱-me̱ yaag-u̱ in da</para>
  <para style="q1" vid="ROM 9:29">In za shu̱'u̱te̱ u̱ka ne̱t-tu̱ bo̱-u̱ Saduma,</para>
  <para style="q2" vid="ROM 9:29">na za ho̱ru̱sse̱ in be̱e̱t u̱ka ne̱t-tu̱</para>
  <para style="q2" vid="ROM 9:29">bo̱-u̱ Gomora.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:29 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 1:9">Isha 1:9</ref>. </char></note><verse eid="ROM 9:29"/></para>
  <para style="s1">Isra-ne̱ yaag jab <optbreak/> u̱du̱ u-Ru̱ da</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30"/>¿Yan-o̱ in do̱'e̱ u̱t-zu̱ u̱ da-o̱? I za-Yahuda-ne̱ da, zo̱ngte̱ e̱ shu̱'u̱t ne̱t-tu̱ jab-u̱s so̱-se̱ u̱du̱ u-Ru̱ da, u̱ da-o̱ e̱ kwu̱mu̱g, jab-u̱ so̱-o̱ u̱ na kume̱ du̱gu̱-du̱ yadu̱ jab. <verse eid="ROM 9:30"/><verse number="31" style="v" sid="ROM 9:31"/>Se̱di Isra-ne̱ i cwane̱ e̱ shu̱'u̱t a-jab-u̱s so̱-se̱ u̱ do̱rru̱ fu̱n-yu̱ u-bo̱r, e̱ kwu̱mu̱g da. <verse eid="ROM 9:31"/><verse number="32" style="v" sid="ROM 9:32"/>¿Yan-o̱ wu̱te̱ iya? Remu̱ zu̱ Yahuda-ne̱ kwu̱mu̱g o̱ u̱ fu̱n-yu̱ yadu̱ jab da, se̱di u̱n cwanu̱g u̱ Ru̱-u̱ kab u̱n remu̱ no̱m-du̱ pama-u̱s so̱-se̱ u̱n. E̱ no̱ng u̱r-pu̱kse̱, &lt;&lt;U̱ do̱m-u̱ ta'ar-ru̱ wadu̱ ne̱t u̱r-pu̱kse̱.&gt;&gt; <verse eid="ROM 9:32"/><verse number="33" style="v" sid="ROM 9:33"/>U̱ka o̱tte̱ m-pan u̱-me̱ Rem-su̱ u-Ru̱ u̱zu̱:</para>
  <para style="q1" vid="ROM 9:33">&lt;&lt;Gwat! U̱m kaag u̱r-taar u̱ Sihiyona <note caller="+" style="f"><char style="fr" closed="false">9:33 </char><char style="ft" closed="false">Urusharima.</char></note></para>
  <para style="q2" vid="ROM 9:33">Taar-du̱ u̱r-pu̱kse̱,</para>
  <para style="q1" vid="ROM 9:33">Se̱di wu̱ ya' jab u̱du̱ wa,</para>
  <para style="q2" vid="ROM 9:33">na za yadu̱ wa m-e̱' da.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:33 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 8:14">Isha 8:14</ref>; <ref loc="ISA 28:16">Isha 28:16</ref>. </char></note><verse eid="ROM 9:33"/></para>
  <chapter eid="ROM 9"/>
  <chapter number="10" style="c" sid="ROM 10"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1"/>O̱r-u̱t ri ne̱, no̱m-u̱ jab-u̱ ri ze̱ge̱ m-cwan u̱ to̱o̱g-u̱s ri ne̱ u̱du̱ u-Ru̱ u̱zu̱, u̱ Isra-ne̱ kum u-u̱ku̱r. <verse eid="ROM 10:1"/><verse number="2" style="v" sid="ROM 10:2"/>U̱m nak u̱n yaag hi-u̱t u̱n u̱ no̱m-du̱ pama-su̱ u-Ru̱ sok. Se̱di o̱ za u̱ fu̱n-yu̱ nap-du̱ u̱t-nip da. <verse eid="ROM 10:2"/><verse number="3" style="v" sid="ROM 10:3"/>U̱m zu̱u̱g iya remu̱ zu̱ u̱n nak fu̱n-yu̱ Ru̱-u̱ o̱ u̱t-do̱r wa muute̱ u̱t-ne̱t a-jab-u̱s so̱-se̱ ne̱. Wa cwanu̱g u̱n kum jab-u̱ so̱-o̱ u̱ rwu̱ne̱ u̱du̱ wa. Se̱di e̱ gu̱gu̱mte̱ fu̱n-yu̱ u-Ru̱. De̱ wu̱te̱ e̱ o̱tte̱ u̱ssa e̱ kum jab-u̱ so̱-o̱ remu̱ do̱rru̱ u̱t-bo̱r. <verse eid="ROM 10:3"/><verse number="4" style="v" sid="ROM 10:4"/>Kiristi shu̱u̱ste̱ no̱m-u̱ wu̱te̱ na nom-u̱t bo̱r-u̱t Mosa, remu̱ ko̱wana ya'e̱ jab u̱du̱ u-Ru̱, Ru̱-u̱ de̱ jaasu̱ ba'as-u̱t wa.<verse eid="ROM 10:4"/></para>
  <para style="s1">U-u̱ku̱r u̱ ko̱wan o̱</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5"/>Ko̱se̱-u̱t Mosa ko̱ske̱ u̱zu̱ ne̱t de̱ keru̱ shu̱'u̱tu̱ wa jab-u̱ so̱-o̱ a wa o̱ do̱rru̱ u̱t-bo̱r. &lt;&lt;A-bo̱ u̱t-sa kwu̱m-du̱ u̱r-fat, se̱ bo̱ no̱ng no̱m-u̱ bo̱r-tu̱ zu̱ye̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="LEV 18:5">To̱o̱g 18:5</ref></char>.</note> <verse eid="ROM 10:5"/><verse number="6" style="v" sid="ROM 10:6"/>Se̱di no̱m-u̱ Rem-su̱ u-Ru̱ zu̱ye̱, u̱ka ne̱t do̱te̱ u̱t-shu̱'u̱t wa jab-u̱ so̱-o̱ remu̱ yadu̱ jab, &lt;&lt;A-bo̱ zu̱ u̱-me̱ jab-u̱ ró, &lt;¿Wana de̱ dadu̱ do̱m u-ru̱?&gt; (Remu̱ wa cu̱stu̱n Kiristi u-dak) <verse eid="ROM 10:6"/><verse number="7" style="v" sid="ROM 10:7"/>Tu̱msu̱ ko̱ no̱ zu̱, &lt;¿Wana de̱ u̱r-cwa u̱-ta u-dak&gt;?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="DEU 30:13">Muut 30:13</ref></char>.</note> (Wa yu̱ns Kiristi du̱gu̱ m-mar.) <verse eid="ROM 10:7"/><verse number="8" style="v" sid="ROM 10:8"/>Se̱di no̱m-u̱ Rem-su̱ u-Ru̱ zu̱ye̱ ya:</para>
  <para style="q1" vid="ROM 10:8">&lt;&lt;Rem-su̱ u-Ru̱ o̱ u̱t-mo̱r u̱ bo̱ ne̱,</para>
  <para style="q2" vid="ROM 10:8">se̱ o̱ me̱ nu-u ró u̱ jab-u̱ ró ne̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="DEU 30:12-14">Muut 30:12-14</ref></char>.</note></para>
  <para style="m" vid="ROM 10:8">Rem-u̱s se̱ o̱tte̱ ko̱se̱-tu̱ yadu̱ jab se̱ in o̱ u̱t-bu̱t. <verse eid="ROM 10:8"/><verse number="9" style="v" sid="ROM 10:9"/>A-bo̱ ware̱ u̱ nu-u ró u̱zu̱ Ye̱so̱ Wa-ko-uyan wa, tu̱msu̱ bo̱ yu̱' jab u̱zu̱ Ru̱-u̱ yu̱nste̱ wu̱n du̱gu̱ m-mar, bo̱ de̱ u̱t-kwu̱m u-u̱ku̱r. <verse eid="ROM 10:9"/><verse number="10" style="v" sid="ROM 10:10"/>U̱m zu̱u̱g iya remu̱ zu̱ jab o̱ ne̱t do̱te̱ yadu̱ jab wa shu̱'u̱te̱ za u̱t-ba'as u̱du̱ u-Ru̱, tu̱msu̱ nu-o̱ ne̱t do̱te̱ u̱r-do̱nse̱ wa kum-u̱t u-u̱ku̱r. <verse eid="ROM 10:10"/><verse number="11" style="v" sid="ROM 10:11"/>U̱ka o̱tte̱ m-pan u̱-me̱ Rem-su̱ u-Ru̱, &lt;&lt;Wu̱ ya' jab ro u̱du̱ wa, wa za no̱m-du̱ m-'e̱ da.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 28:16">Isha 28:16</ref></char>.</note> <verse eid="ROM 10:11"/><verse number="12" style="v" sid="ROM 10:12"/>Ru̱-u̱ ko̱ste̱ m-ku̱u̱k da. Wa o̱ hyan-du̱ Yahuda-ne̱ u̱ i-za-Yahuda-ne̱ da u̱s-gan. Ru̱-u ne̱t-ne̱ be̱e̱t o̱. Tu̱msu̱ wa no̱m u-nya u̱du̱ ne̱t-ne̱ be̱e̱t i foge̱ dim-u̱r wa. <verse eid="ROM 10:12"/><verse number="13" style="v" sid="ROM 10:13"/>U̱ka o̱tte̱ m-pan u̱-me̱ Ran-u̱ u-Ru̱ u̱zu̱, &lt;&lt;Ko̱wana fage̱ Yawe u̱ sa-u̱ u̱r-se̱ge̱, wa do̱'e̱ kwu̱m-du̱ u-u̱ku̱r.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:13 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="JOL 2:32">Jowe 2:32</ref></char>.</note><verse eid="ROM 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14"/>¿Se̱di re̱ne̱ o̱ ne̱t-tu̱ ya jab u̱du̱ ró da, e̱ do̱te̱ keru̱ fag-du̱ Yawe u̱ sa-u̱ u̱r-se̱ge̱? ¿Re̱ne̱ o̱ e̱ do̱te̱ yadu̱ jab u̱du̱ wu̱ e̱ tame̱ ho̱g-du̱ mo̱t-u̱t wa da? ¿Re̱ne̱ o̱ e̱ do̱te̱ u̱t-ho̱g a waku̱n waru̱ u̱n da? <verse eid="ROM 10:14"/><verse number="15" style="v" sid="ROM 10:15"/>¿Re̱ne̱ o̱ a-u̱t-bu̱t do̱te̱ bu̱t-tu̱ a waku̱n to̱mu̱ u̱n da? U̱ka o̱tte̱ m-pan u̱-me̱ Rem-su̱ u-Ru̱ u̱zu̱, &lt;&lt;Haan-u̱r a-bu̱t-tu̱ Rem-su̱ m-Re̱me̱r ze̱k u̱r-zwar.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:15 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 52:7">Isha 52:7</ref></char>.</note><verse eid="ROM 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 10:16"/>Se̱di ne̱t-tu̱ Isra to̱ u̱t-be̱e̱t u̱ kabe̱ Rem-su̱ m-Re̱me̱r se̱ da. U̱ka Ishaya wa-warru̱ Rem-su̱ u-Ru̱ zu̱tte̱, &lt;&lt;Yawe, ¿wana kabe̱ rem-u̱s sin-se̱ su̱ it ware̱?&gt;&gt; <verse eid="ROM 10:16"/><verse number="17" style="v" sid="ROM 10:17"/>De̱ wu̱te̱ yadu̱ jab o̱ haan u̱du̱ in u̱ fu̱n-u̱ ho̱g-du̱ Rem-su̱ M-re̱me̱r, tu̱msu̱ na hog Rem-su̱ m-Re̱me̱r u̱du̱ Rem-u̱s Kiristi. <verse eid="ROM 10:17"/><verse number="18" style="v" sid="ROM 10:18"/>Se̱di u̱m o̱tte̱ u̱r-shu̱t, &lt;&lt;¿Nip-to̱ u̱zu̱ ne̱t-tu̱ Isra-ne̱ ho̱k da?&gt;&gt; U̱ka o̱tte̱ m-pan u̱-me̱ Rem-su̱ u-Ru̱:</para>
  <para style="q1" vid="ROM 10:18">&lt;&lt;U̱n no̱ng do̱nse̱-du̱ rem-u̱s</para>
  <para style="q2" vid="ROM 10:18">se̱ u-dak u-be̱e̱t,</para>
  <para style="q1" vid="ROM 10:18">Rem-u̱s u̱n teeg ma-du̱ u-dak u-be̱e̱t.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:18 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 19:4">Se̱pV 19:4</ref></char>.</note><verse eid="ROM 10:18"/></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19"/>U̱m swu̱ru̱g m-shu̱t, &lt;&lt;¿Ne̱t-tu̱ i Isra e̱ gwa'ag nu-du̱ u̱ rem-u̱s se̱ da?&gt;&gt; U̱, e̱ gwa'ag nu-du̱ se̱, remu̱ zu̱ u̱ da-u Mosa, Ru̱-u̱ zu̱u̱g:</para>
  <para style="q1" vid="ROM 10:19">&lt;&lt;U̱m de̱ wadu̱ Isra-ne̱ no̱m shu̱b-du̱</para>
  <para style="q2" vid="ROM 10:19">ne̱t-tu̱ za-Yahuda ne̱.</para>
  <para style="q1" vid="ROM 10:19">Tu̱msu̱ u̱m de̱ u̱t-wa no̱ ho̱g u̱s-ryab</para>
  <para style="q2" vid="ROM 10:19">remu̱ ne̱t-tu̱ o̱ a-ko̱b-du̱ m-nap ne̱</para>
  <para style="q1" vid="ROM 10:19">i-za-Yahuda-ne̱ da.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:19 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="DEU 32:21">Muut 32:21</ref></char>.</note><verse eid="ROM 10:19"/></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20"/>Ishaya waru̱g Rem-su̱ u-Ru̱ jab gan:</para>
  <para style="q1" vid="ROM 10:20">&lt;&lt;Ne̱t-tu̱ sa-u̱ me̱ da,</para>
  <para style="q2" vid="ROM 10:20">e̱ de̱ kwu̱m-du̱ me̱,</para>
  <para style="q1" vid="ROM 10:20">Ne̱t-tu̱ o̱ro i shite̱ u̱ka e̱ do̱te̱ kwu̱m-du̱ me̱ da.</para>
  <para style="q2" vid="ROM 10:20">Se̱di u̱m ko̱ske̱ hi-u̱r ri m-zu̱n</para>
  <para style="q1" vid="ROM 10:20">cas u̱du̱ u̱n.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:20 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 65:1">Isha 65:1</ref></char>.</note><verse eid="ROM 10:20"/></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21"/>Se̱di mo̱ttu̱ Isra, Ru̱-u̱ swu̱ru̱g m-waru̱ u̱n,</para>
  <para style="q1" vid="ROM 10:21">&lt;&lt;Ko̱-uyan da,</para>
  <para style="q2" vid="ROM 10:21">u̱m u̱t-sa u̱m mu̱u̱tu̱n e̱ u̱du̱ ri,</para>
  <para style="q1" vid="ROM 10:21">Se̱di e̱ shu̱'u̱t a-ko̱b-du̱ do̱rru̱ u̱s-rem ne̱</para>
  <para style="q2" vid="ROM 10:21">u̱ a-ko̱b-du̱ ho̱g-mu̱ u̱s-rem ne̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:21 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 65:2">Isha 65:2</ref></char>.</note><verse eid="ROM 10:21"/></para>
  <chapter eid="ROM 10"/>
  <chapter number="11" style="c" sid="ROM 11"/>
  <para style="s1">Ru̱-u̱ ho̱k o̱n-du̱ <optbreak/> ne̱t-tu̱ Isra-ne̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1"/>A waku̱n u̱ shite̱ me̱ u̱zu̱: ¿Shu̱'u̱te̱ u̱zu̱ Ru̱-u̱ yakke̱ ne̱t-u̱t wa? Za, iya o̱ da! Ko̱ me̱ ne̱t-u̱ Isra wa, du̱gu̱ rem-u̱r Ibrahi, tu̱msu̱ du̱gu̱ ko̱-u̱r Banyami ne̱.<note caller="+" style="f"><char style="fr" closed="false">11:1 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PHP 3:5">Firi 3:5</ref></char>.</note> <verse eid="ROM 11:1"/><verse number="2" style="v" sid="ROM 11:2"/>Ru̱-u̱ yakte̱ ne̱t-u̱t wa da, i wa dage̱ du̱gu̱ u̱r-taku̱n. Baksu̱n no̱m-u̱ Rem-su̱ u-Ru̱ ware̱, u̱ka Iriya hu̱u̱te̱ rem-su̱ ne̱t-tu̱ Isra u̱du̱ u-Ru̱ wa zu̱, <verse eid="ROM 11:2"/><verse number="3" style="v" sid="ROM 11:3"/>&lt;&lt;Yawe, e̱ ho̱ru̱ssu̱ a-warru̱ rem-u̱s ró ne̱. Tu̱msu̱ e̱ yo̱'o̱kte̱ sak-u̱r ró. Me̱ wa u-gan u̱ kuse̱ u̱r-fat, tu̱msu̱ e̱ o̱ baku̱ ri remu̱ e̱ hoot.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="1KI 19:10">1Far 19:10</ref>,<ref loc="1KI 19:14">14</ref></char>.</note> <verse eid="ROM 11:3"/><verse number="4" style="v" sid="ROM 11:4"/>¿Yan go̱-du̱ u-shas o̱ Ru̱-u̱ no̱mu̱ wu̱n? Wa shaku̱s wa u̱t-zu̱, &lt;&lt;U̱m cu̱ngu̱ hi-du̱ war ri u̱t-ne̱t u̱t-zo̱ngu u̱t-ta'er i so̱kte̱ e̱ no̱mu̱ ru̱-u o̱ u̱ na foge̱ Ba'ar u̱t-huuk da.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:4 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="1KI 19:18">1Far 19:18</ref></char>.</note> <verse eid="ROM 11:4"/><verse number="5" style="v" sid="ROM 11:5"/>Ko̱ u̱ da-o̱ iya o̱tte̱. Ne̱t-tu̱ o̱ro cashi i kuse̱ i Ru̱-u̱ dage̱ remu̱ nya-u wa. <verse eid="ROM 11:5"/><verse number="6" style="v" sid="ROM 11:6"/>Du̱g-u̱t to̱ tu̱ Ru̱-u̱ no̱me̱ remu̱ nya-u wa o̱, za remu̱ u̱s-pama su̱ u̱n no̱me̱ da. U̱zu̱ iya da, nya-u u-Ru̱ za shu̱'u̱te̱ nya-u so̱-o̱ da.<verse eid="ROM 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7"/>No̱m-u̱ o̱ te̱k-u̱ ya: Ne̱t-tu̱ Isra saag fu̱n-yu̱ e̱ do̱te̱ u̱t-shu̱'u̱t ne̱t-u̱t so̱-to̱ u̱du̱ u-Ru̱. Se̱di e̱ kwu̱ng no̱m-u̱ e̱ u̱t-sa da. E̱ke̱n u̱ te̱k-u̱ me̱ u̱n i Ru̱-u̱ dage̱, e̱ kabu̱g jab-u̱ so̱-o̱ u-Ru̱, se̱di u-tát i kuse̱, e̱ shu̱'u̱te̱ a-ko̱b-du̱ ho̱g-du̱ u̱s-rem ne̱ tu̱msu̱ e̱ kwu̱mu̱g da. <verse eid="ROM 11:7"/><verse number="8" style="v" sid="ROM 11:8"/>U̱ka o̱tte̱ m-pan u̱-me̱ Rem-su̱ u-Ru̱ u̱zu̱,</para>
  <para style="q1" vid="ROM 11:8">&lt;&lt;Ru̱-u̱ muute̱ u̱n u̱ka rag-ne̱</para>
  <para style="q2" vid="ROM 11:8">tu̱msu̱ za m-nap.</para>
  <para style="q1" vid="ROM 11:8">Wa yaag u̱n is se̱di e̱ za u̱t-hyan da,</para>
  <para style="q2" vid="ROM 11:8">tu̱msu̱ wa yaag u̱n u̱t-to̱,</para>
  <para style="q1" vid="ROM 11:8">e̱ za u̱t-ho̱g da u̱ haan u̱ ya-o̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:8 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="DEU 29:4">Muut 29:4</ref>; <ref loc="ISA 29:10">Isha 29:10</ref></char>.</note><verse eid="ROM 11:8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="ROM 11:9"/>Se̱ Dawuda zu̱,</para>
  <para style="q1" vid="ROM 11:9">&lt;&lt;Yage̱ mo̱ro̱g-du̱ u-re̱</para>
  <para style="q2" vid="ROM 11:9">u̱n to̱ shu̱'u̱t u̱ka u̱r-re̱n.</para>
  <para style="q1" vid="ROM 11:9">Tu̱msu̱ yage̱ u̱ shu̱'u̱t u̱n u̱r-pu̱kse̱,</para>
  <para style="q2" vid="ROM 11:9">u̱ de̱ hatu̱n u̱n swadu̱ u̱r-ko̱b.<verse eid="ROM 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10"/>Yage̱ is-u̱ u̱n u̱ no̱m u-cwu̱m,</para>
  <para style="q2" vid="ROM 11:10">E̱ de̱ swadu̱ u̱r-ko̱b u-tát</para>
  <para style="q1" vid="ROM 11:10">u̱ka to̱k-ne̱ za u̱r-ma.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:10 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 69:22-23">Se̱pV 69:22-23</ref></char>.</note><verse eid="ROM 11:10"/></para>
  <para style="s1">I za-yahuda-ne̱ da e̱ <optbreak/> kwu̱mu̱g u-u̱ku̱r</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11"/>U̱m o̱mo̱n u̱r-shu̱t ne̱ u̱ da-o̱: ¿A Isra-ne̱ pu̱kse̱ e̱ he̱'e̱ e̱ za keru̱ u̱r-yu̱ne̱ da? Iya o̱ da! Remu̱ ba'as-tu̱ Isra-ne̱ no̱me̱, de̱ wu̱te̱ u̱ku̱r-u̱ teet ne̱t-tu̱ za-Yahuda-ne̱ da, remu̱ Isra-ne̱ nom-u̱t shu̱b-u̱r u̱n. <verse eid="ROM 11:11"/><verse number="12" style="v" sid="ROM 11:12"/>Ba'as-u̱t Isra-ne̱ haatu̱n kom u-Ru̱ u̱-me̱ u-dak u-be̱e̱t. Tu̱msu̱ ko̱b-du̱ do̱rru̱ u̱s-remu̱ u̱n haatu̱n kom u-Ru̱ u̱du̱ i za-Yahuda-ne̱ da. M-vaste̱, a Isra-ne̱ ya jab u̱du̱ u-Ru̱, in be̱e̱t in do̱'e̱ no̱m-du̱ u̱r-so̱ sok remu̱ kom u-Ru̱.<verse eid="ROM 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13"/>U̱m o̱ u̱s-rem u̱ no̱ ne̱ i-za-Yahuda-ne̱ da. Me̱ Wa-to̱m-u̱ Ye̱so̱ wa u̱du̱ i za-Yahuda-ne̱ da, u̱m o̱ u̱t-u̱k u̱ remu̱ pama-u̱s ri. <verse eid="ROM 11:13"/><verse number="14" style="v" sid="ROM 11:14"/>U̱ remu̱ iya, u̱m o̱ haan jiya me̱ keru̱ wadu̱ Isra-ne̱ e̱ no̱m u̱r-shu̱b, o̱ u̱t-wa u̱ e̱ke̱n u̱ kum u-u̱ku̱r. <verse eid="ROM 11:14"/><verse number="15" style="v" sid="ROM 11:15"/>Se̱di ba na gu̱gmu̱ u̱n, wa'ag is-yu̱ u-pus yu̱ ho̱ngu̱sse̱ ne̱t-tu̱ u-dak u̱t-be̱e̱t u-Ru̱ ne̱. Da-u̱ Yahuda-ne̱ ya jab u̱du̱ Ye̱so̱, shu̱'u̱te̱ u̱ka mu̱u̱tu̱n ne̱t-u̱ mare̱ u̱r-fat! <verse eid="ROM 11:15"/><verse number="16" style="v" sid="ROM 11:16"/>Ba Ibrahi u̱ e̱ke̱n u̱so-tu̱ u̱so-u̱t in ne̱ o̱o̱ge̱ u-he̱n ne̱, iya o̱ ko̱-u̱r e̱ do̱te̱ u̱t-shu̱'u̱t u-he̱n ne̱ u̱ka ne̱t haste̱ ro̱p-du̱ hyu̱ u-gan wa hatu̱n de̱ u̱du̱ u-Ru̱, de̱ u̱t-shu̱'u̱t u-he̱n ne̱. Shu̱'u̱te̱ u̱zu̱ gu̱g-du̱ hyu̱ de̱ u̱r-be̱e̱t de̱ u̱t-shu̱'u̱t u-he̱n ne̱. Tu̱msu̱ ana yase̱ gu̱r-yu̱ u-te na hu̱u̱t u̱du̱ u-Ru̱, ya u̱t-shu̱'u̱t u-he̱n ne̱, ko̱ske̱ u̱zu̱ ko̱ fe̱-su̱ te-u ya se̱ o̱tte̱ u-he̱n.<verse eid="ROM 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 11:17"/>No̱mo̱n u̱s-dorog u̱zu̱: ana kwu̱pre̱ fe̱-su̱ te-su̱ ze̱tun su̱ na se̱re̱, se̱ na ku̱b fe̱-yu̱ te-yu̱ ze̱tun yu̱ u̱r-do̱g na dame̱ u̱r-kot. No̱ i za ne̱t-tu̱ Yahuda-ne̱ da, no̱ o̱ u̱ka te-yu̱ ze̱tun yu̱ u̱r-do̱g, ana dame̱ no̱ u̱s-gu̱r ne̱, no̱ de̱ kwu̱m-du̱ nya-u̱ u-Ru̱ remu̱ Yahuda-ne̱.<note caller="+" style="f"><char style="fr" closed="false">11:17 </char><char style="ft" closed="false">No̱mu̱ na o̱ u̱t-war, no̱ a-za-Yahuda-ne̱ kwu̱mu̱g re̱-du̱ o̱g-du̱ rwu̱ne̱ du̱gu̱ Yahuda-ne̱ u̱s-gan u̱ka teyu̱ ze̱tun yu̱ u̱r-do̱g kumte̱ no̱m u̱t-re̱ du̱gu̱ gu̱r-su̱ tesu̱ na na kawe̱ u-tak.</char></note> <verse eid="ROM 11:17"/><verse number="18" style="v" sid="ROM 11:18"/>Remu̱ iya, a no̱ no̱m u̱t-u̱k u̱zu̱ no̱ ze̱k fe̱-u̱s se̱ su̱ na kupse̱ da. A no̱ o̱ u̱t-u̱k baksu̱n u̱zu̱, a no̱ shipe̱ u̱s-gu̱r da, se̱di gu̱r-se̱ shipe̱ no̱.<verse eid="ROM 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 11:19"/>Se̱di i-za-Yahuda-ne̱ da e̱ u̱t-kere̱ u̱t-zu̱, &lt;&lt;Ru̱-u̱ kwu̱pu̱rte̱ fe̱-su̱ Yahuda-ne̱ remu̱ wa samte̱ in u̱s-gu̱r ne̱.&gt;&gt; <verse eid="ROM 11:19"/><verse number="20" style="v" sid="ROM 11:20"/>Nip-to̱, remu̱ ko̱b-du̱ yadu̱ jab-u̱ Yahuda-ne̱, de̱ wu̱te̱ na kwu̱pu̱rte̱ u̱s-fe̱ du̱gu̱ u̱s-gu̱r. Tu̱msu̱ no̱ remu̱ yadu̱ jab-u̱ no̱ o̱ no̱ kumte̱ fu̱n-yu̱ u̱t-to̱st u̱s-gu̱r. Se̱di a no̱ no̱m u̱t-u̱k da se̱di na ho̱g u-gye̱r. <verse eid="ROM 11:20"/><verse number="21" style="v" sid="ROM 11:21"/>A Ru̱-u̱ yage̱ Yahuda-ne̱ da, u̱na o̱ u̱ka fe̱-su̱ u-te su̱ u̱r-taku̱n, wa za hen u̱ yagu̱ no̱ da.<verse eid="ROM 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 11:22"/>Iya-o̱ Ru̱-u̱ do̱te̱ keru̱ ko̱su̱ no̱m-u̱t so̱-to̱ wa u̱ ryab-u̱s wa ne̱. Wa ko̱su̱ a-u̱t-ba'as ryab-u̱s wa, se̱di wa no̱mu̱ no̱m-u̱t so̱-to̱ wa. Se̱di a no̱ kabe̱ o̱ jab gan da, na de̱ kwu̱p-ru̱ no̱ du̱gu̱ u̱s-gu̱r. <verse eid="ROM 11:22"/><verse number="23" style="v" sid="ROM 11:23"/>A Isra-ne̱ byu̱r-ne̱ du̱gu̱ ko̱b-du̱ yadu̱ jab, na same̱ e̱ u̱s-gu̱r ne̱, remu̱ zu̱ Ru̱-u̱ de̱ keru̱ muutu̱ u̱n u̱du̱ gu̱r-u ya. <verse eid="ROM 11:23"/><verse number="24" style="v" sid="ROM 11:24"/>No̱ i-za-Yahuda-ne̱ da, no̱ o̱ u̱ka te-yu̱ ze̱tun yu̱ u̱r-do̱g yu̱ na kupse̱, se̱ Ru̱-u̱ same̱ ya u̱ matu̱ te-yu̱ ze̱tun ne̱ yu̱ na se̱re̱. Yahuda-ne̱ e̱ o̱ u̱ka te-yu̱ na se̱re̱ yu̱ so̱-ya, za shu̱'u̱tu̱ no̱m-u̱ m-no u̱ Ru̱-u̱ same̱ u̱-fe̱ yu̱ Yahuda-ne̱ u̱ do̱m-u̱ u-gu̱r yu̱ e̱ rwu̱tu̱n da.<verse eid="ROM 11:24"/></para>
  <para style="s1">Ru̱-u̱ o̱ ho̱g-du̱ o̱n-du̱ <optbreak/> u̱t-ne̱t u̱t-be̱e̱t</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25"/>No̱ hu̱u̱b-u̱t ri, u̱m za u̱ssa no̱ shu̱'u̱t a-ko̱b-du̱ m-nap ne̱ u̱ remu̱ no̱m-u̱ o̱ yase̱ da, taas u̱ no̱ shu̱'u̱t a u̱t-u̱k ne̱ da. Isra-ne̱ u-tát e̱ de̱ shu̱'u̱tu̱ a-ko̱b-du̱ ho̱g-du̱ u̱s-rem ne̱, se̱ i za-Yahuda-ne̱ u-tát i Ru̱-u̱ dage̱ e̱ o̱ yadu̱ jab u̱du̱ Kiristi. <verse eid="ROM 11:25"/><verse number="26" style="v" sid="ROM 11:26"/>Iya-o̱ Isra-ne̱ be̱e̱t e̱ do̱te̱ kwu̱m-du̱ u-u̱ku̱r, u̱ka Rem-su̱ u-Ru̱ zu̱tte̱:</para>
  <para style="q1" vid="ROM 11:26">&lt;&lt;Wa-u-u̱ku̱r de̱ rwu̱u̱n u̱ Urusharima,<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">U̱t-Girik: Sihiyona.</char></note></para>
  <para style="q2" vid="ROM 11:26">wa de̱ hastu̱ jab-u̱ ko̱b-du̱ kab-du̱</para>
  <para style="q1" vid="ROM 11:26">u̱s-rem du̱gu̱ ko̱-u̱r Yakubu.<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 59:20-21">Isha 59:20-21</ref></char>.</note><verse eid="ROM 11:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27"/>Sin-se̱ o̱ este̱du̱ u̱s-rem</para>
  <para style="q2" vid="ROM 11:27">u̱ ri u̱ u̱n ne̱,</para>
  <para style="q1" vid="ROM 11:27">u̱m de̱ no̱mu̱ u̱n ho̱-du̱ ba'as-u̱t u̱n.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:27 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 27:9">Isha 27:9</ref>; <ref loc="JER 31:33-34">Irmi 31:33-34</ref></char>.</note><verse eid="ROM 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28"/>Yahuda-ne̱ shu̱'u̱te̱ hu̱u̱b-tu̱ Rem-su̱ M-re̱me̱r, tu̱msu̱ o̱ shu̱'u̱te̱ swu̱r-m no̱ a-za-Yahuda-ne̱ remu̱ zu̱ e̱ gu̱gu̱mte̱ Rem-su̱ m-Re̱me̱r, se̱di Ru̱-u̱ dak Yahuda-ne̱. Ru̱-u̱ o̱ cwan-u̱t u̱n remu̱ i mate̱ u̱so-tu̱ u̱so-u̱t u̱n. <verse eid="ROM 11:28"/><verse number="29" style="v" sid="ROM 11:29"/>In nu̱pu̱ste̱ u̱zu̱ Ru̱-u̱ re̱e̱g shu̱ u̱ cwan-u̱t u̱n ne̱ remu̱ zu̱ wa za kab-du̱ nya-u̱ wa no̱mu̱ u̱n da ko̱ ne̱t-tu̱ wa dage̱ to̱ ka wa u̱t-to̱. <verse eid="ROM 11:29"/><verse number="30" style="v" sid="ROM 11:30"/>U̱r-taku̱n no̱ i za-Yahuda-ne̱ da, no̱ no̱ng ko̱b-du̱ do̱rru̱ u̱s-rem, se̱di u̱ da-o̱ no̱ kwu̱mu̱g o̱n-du̱ u-Ru̱ remu̱ ko̱b-du̱ do̱rru̱ u̱s-rem u̱ Yahuda-ne̱. <verse eid="ROM 11:30"/><verse number="31" style="v" sid="ROM 11:31"/>U̱ da-o̱ Yahuda-ne̱ u̱ hi-u̱r e̱, e̱ shu̱'u̱te̱ a-ko̱b-du̱ do̱rru̱ Rem-su̱ u-Ru̱ u̱ka e̱ do̱te̱ kwu̱m-du̱ o̱n-du̱ u-Ru̱, o̱n-du̱ Ru̱-u̱ ko̱su̱ i-za-Yahuda-ne̱ da. <verse eid="ROM 11:31"/><verse number="32" style="v" sid="ROM 11:32"/>Ru̱-u̱ mu̱tte̱ u̱t-ne̱t u̱t-be̱e̱t Yahuda-ne̱ u̱ i za-yahuda-ne̱ da a-ko̱b-du̱ do̱rru̱ u̱s-rem. Ru̱-u̱ no̱mo̱g iya remu̱ wa ko̱ste̱ u̱t-ne̱t u̱t-be̱e̱t o̱n-u̱r wa.<verse eid="ROM 11:32"/></para>
  <para style="s1">U̱t-vam u̱du̱ u-Ru̱</para>
  <para style="q1">
    <verse number="33" style="v" sid="ROM 11:33"/>Nip-tu̱ ra-du̱ ve̱r-su̱ u-Ru̱ tu̱msu̱</para>
  <para style="q2" vid="ROM 11:33">nap-m rò zatte̱ u̱r-ma da,</para>
  <para style="q1" vid="ROM 11:33">kwu̱p-du̱ u̱s-rem u̱ rò ze̱k u̱r-shu̱t.</para>
  <para style="q2" vid="ROM 11:33">No̱m-tu̱ wa o̱ u̱t-no̱m</para>
  <para style="q1" vid="ROM 11:33">ze̱k nap-mu̱ ne̱t.<note caller="+" style="f"><char style="fr" closed="false">11:33 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 55:8">Isha 55:8</ref></char>.</note><verse eid="ROM 11:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34"/>U̱ka Rem-su̱ u-Ru̱ zu̱tte̱:</para>
  <para style="q1" vid="ROM 11:34">&lt;&lt;¿Wana nape̱ jab-u̱ Yawe?</para>
  <para style="q2" vid="ROM 11:34">¿Wana o̱ hu̱u̱b-u̱ rò,</para>
  <para style="q1" vid="ROM 11:34">wana he̱e̱se̱ yadu̱ wu̱n u̱s-rem?&gt;&gt;<verse eid="ROM 11:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35"/>&lt;&lt;Waku̱n zaar wu̱ de̱ yadu̱ u-Ru̱ o̱ko̱n no̱m-o̱</para>
  <para style="q2" vid="ROM 11:35">u̱ wa yage̱ za kum du̱gu̱-du̱ u-Ru̱ da.</para>
  <para style="q1" vid="ROM 11:35">Remu̱ iya waku̱n zaar wu̱ de̱ u̱t-zu̱</para>
  <para style="q2" vid="ROM 11:35">u̱ Ru̱-u̱ to̱p wa da.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:35 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="JOB 41:11">Ayub 41:11</ref></char>.</note><verse eid="ROM 11:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="ROM 11:36"/>Remu̱ du̱gu̱-du̱ wu̱n,</para>
  <para style="q2" vid="ROM 11:36">tu̱msu̱ u̱du̱ wu̱n,</para>
  <para style="q1" vid="ROM 11:36">tu̱msu̱ u̱du̱ du̱ wu̱n de̱</para>
  <para style="q2" vid="ROM 11:36">na no̱m-te̱ ko-uyan.</para>
  <para style="q1" vid="ROM 11:36">Yage̱ fu̱bu̱sse̱ tu̱ shu̱'u̱t u̱du̱ wu̱n</para>
  <para style="q2" vid="ROM 11:36">m-mo̱mmo̱! U̱ shu̱'u̱t iya!<note caller="+" style="f"><char style="fr" closed="false">11:36 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="1CO 8:6">1Kor 8:6</ref></char>.</note><verse eid="ROM 11:36"/></para>
  <chapter eid="ROM 11"/>
  <chapter number="12" style="c" sid="ROM 12"/>
  <para style="s1">To̱o̱g u̱r-fat u̱du̱ u-Ru̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1"/>Remu̱ iya, o̱r-u̱t ri, u̱m o̱ ko̱n-u̱s no̱ remu̱ o̱n-du̱ u-Ru̱, no̱ yaase̱ war-u̱t no̱ u̱ka u̱r-to̱o̱g, ko̱ ba no̱ o̱ u̱r-fat, se̱di no̱ yaase̱ hi-u̱t no̱ u̱ pama-u̱ u-Ru̱ u̱ka Ru̱-u̱ do̱te̱ ho̱g-du̱ zwar-u̱r no̱. Ya o̱ fu̱n-yu̱ u̱t-nip yu̱ no̱ do̱te̱ no̱mu̱ u-Ru̱ m-sek. <verse eid="ROM 12:1"/><verse number="2" style="v" sid="ROM 12:2"/>A no̱ yage̱ ne̱t-tu̱ za u̱ do̱rru̱ u-Ru̱ da, e̱ waru̱ no̱ u̱ka no̱ do̱te̱ u̱ yu̱-u̱r no̱ da. Se̱di yage̱ u̱ Ru̱-u̱ mang no̱ u̱ka wa o̱tte̱ u̱ssa, tu̱msu̱ wa ya' no̱ jab-u̱ po-o̱. Da-u o̱ no̱ do̱'e̱ nap-du̱ no̱m-u̱ Ru̱-u̱ u̱t-sa no̱ no̱m, tu̱msu̱ no̱ u̱t-nap u̱ka no̱ do̱te̱ no̱m-du̱ ko̱-uyan u̱ so̱-o̱ u̱ Ru̱-u̱ u̱t-sa.<verse eid="ROM 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3"/>Remu̱ nya-u̱ Ru̱-u̱ no̱mu̱ me̱, u̱m o̱ naku̱ no̱ u̱t-to̱ be̱e̱t, a waku̱n u̱ hu̱u̱t hi-u̱r wa u̱ be-du̱ wa teye̱ da. Se̱di no̱ nap u̱ka no̱ gotte̱ hi-u̱t no̱, se̱di no̱ kab hi-u̱t no̱ ho̱n-ho̱n u̱ka yadu̱ jab-u̱ Ru̱-u̱ ya' no̱. <verse eid="ROM 12:3"/><verse number="4" style="v" sid="ROM 12:4"/>U̱ka in ko̱wan o̱tte̱ u-war u-gan u̱t-o̱g ne̱ u-tát, tu̱msu̱ ko̱du̱he̱ o̱gde̱ o̱tte̱ pama-u̱ wa nome̱. <verse eid="ROM 12:4"/><verse number="5" style="v" sid="ROM 12:5"/>Ko̱ ba shu̱'u̱te̱ u̱zu̱ in o̱ u-tát, se̱di war-o̱ u-gan o̱ na o̱ye̱ remu̱ shu̱'u̱t-u̱r in u̱ Kiristi ne̱, tu̱msu̱ ko̱wan ganse̱ wa o̱ye̱ e̱ o̱r-u̱ wa ne̱. Taas u̱ waku̱n u̱ hyan u̱ka zu̱ Ru̱-u̱ ze̱k m-cwan wa m-ze̱g waku̱n.<note caller="+" style="f"><char style="fr" closed="false">12:5 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="1CO 12:12">1Kor 12:12</ref></char>.</note> <verse eid="ROM 12:5"/><verse number="6" style="v" sid="ROM 12:6"/>Remu̱ iya, kamu̱g in no̱mo̱n m-ank u̱ nya-u̱ Ru̱-u̱ no̱mu̱ in, u-nya u̱t-go̱ u̱t-go̱, u̱ka Ru̱-u̱ no̱m-tu̱ in nya-u o̱. A Ru̱-u̱ ya bo̱ nya-u̱ warru̱ rem-u̱s wa, war u̱ yadu̱ jab ne̱ u̱ka Ru̱-u̱ yu̱te̱ bo̱. <verse eid="ROM 12:6"/><verse number="7" style="v" sid="ROM 12:7"/>Abite̱ nya-u ró u-pama u̱ dor-u u-Ru̱ o̱, no̱m pama-u o̱. Abite̱ nya-u̱ u̱t-ko̱se̱ o̱, no̱m u̱t-ko̱se̱. <verse eid="ROM 12:7"/><verse number="8" style="v" sid="ROM 12:8"/>Abite̱ nya-u ró u̱ swu̱ru̱ ne̱t-ne̱ shiriktin-mu̱ jab mo̱, re̱ u-shu̱ u̱t-no̱m. Abite̱ nya-u̱ m-ho̱s o̱ u̱du̱ u̱t-ne̱t remu̱ u̱r-ko̱b, re̱ u-shu̱ u̱t-no̱m jab gan. Abite̱ dor-tu̱ u̱t-ne̱t o̱, no̱m o̱ jab gan. Abite̱ ho̱g-du̱ o̱n-du̱ u̱t-ne̱t de̱, no̱m-o̱ u̱ te̱k-u̱ u̱r-so̱.<note caller="+" style="f"><char style="fr" closed="false">12:8 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="1CO 12:4-11">1Kor 12:4-11</ref></char>.</note><verse eid="ROM 12:8"/></para>
  <para style="s1">Nap-du̱ wa-dor wu̱ u̱t-nip</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9"/>Cwan o̱r-u̱ ró u̱ cwan-tu̱ u̱t-nip. No̱ gu̱gu̱m no̱m-u̱t yo̱-to̱, se̱di no̱ ship no̱m-u̱ o̱ u̱ so̱-o̱ u̱t-kom u̱t-yu̱r. <verse eid="ROM 12:9"/><verse number="10" style="v" sid="ROM 12:10"/>Cwan o̱r-u̱ ró u̱ka hu̱u̱b u̱r-matu̱ ró, gwat ko̱wan u̱ka zu̱ wa ze̱k bo̱. <verse eid="ROM 12:10"/><verse number="11" style="v" sid="ROM 12:11"/>A-bo̱ shu̱'u̱t za no̱m-u̱t no̱m da, se̱di yaase̱ hi-u̱r ró u̱ pama-u̱ Wa-ko-uyan. <verse eid="ROM 12:11"/><verse number="12" style="v" sid="ROM 12:12"/>No̱m u̱r-so̱ remu̱ zu̱ bo̱ o̱ wadu̱ jab-u̱ no̱m-u̱ Ru̱-u̱ de̱ no̱mu̱ bo̱, bo̱ gag jab-u̱ te̱k-u̱ swadu̱ u̱r-ko̱b. Tu̱msu̱ re̱e̱n u-shu̱ u̱s-to̱o̱g ne̱ ko̱-uyan da. <verse eid="ROM 12:12"/><verse number="13" style="v" sid="ROM 12:13"/>A ne̱t-tu̱ u-Ru̱ o̱ swadu̱ u̱r-ko̱b, mo̱-tu̱n u̱n no̱m-u̱ no̱ o̱tte̱. Tu̱msu̱ shu̱'u̱tu̱n a cu̱st-u̱ u̱t-hamu̱t ne̱.<verse eid="ROM 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14"/>Kom-u̱ u-Ru̱ u̱du̱ ne̱t-tu̱ o̱ yadu̱ no̱ u̱r-ko̱b, waan u̱n nu-u so̱-o̱. A no̱ wa'-u̱ u̱n nu-u yo̱-o̱ da.<note caller="+" style="f"><char style="fr" closed="false">12:14 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="MAT 5:44">Mati 5:44</ref>; <ref loc="LUK 6:28">Ruka 6:28</ref></char>.</note> <verse eid="ROM 12:14"/><verse number="15" style="v" sid="ROM 12:15"/>No̱mo̱n u̱r-so̱ u̱ ne̱t-tu̱ o̱ u̱r-so̱ ne̱, tu̱msu̱ no̱ no̱m u̱s-kan u̱ i o̱ u̱s-kan ne̱. <verse eid="ROM 12:15"/><verse number="16" style="v" sid="ROM 12:16"/>No̱mo̱n shu̱'u̱t-du̱ m-yar u̱ o̱r-u̱t no̱ ne̱. A no̱ shu̱'u̱t a hu̱k-mu̱ u̱r-hi da, se̱di no̱ shu̱'u̱t u̱r-hu̱u̱b u̱du̱ ne̱t-tu̱ na gu̱gme̱ ne̱. A-bo̱ kab hi-u̱r ró u̱ka zu̱ bo̱ nak ko̱-uyan da.<note caller="+" style="f"><char style="fr" closed="false">12:16 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PRO 3:7">ShaR 3:7</ref></char>.</note><verse eid="ROM 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17"/>A waku̱n u̱ no̱mu̱ bo̱ no̱m-u yo̱-o̱, a-bo̱ to̱p wa u̱ no̱m-u yo̱-o̱ da. Re̱ shu̱ u̱ no̱m-du̱ ne̱t-tu̱ de̱ u̱t-hyan u̱zu̱ o̱ so̱-o̱. <verse eid="ROM 12:17"/><verse number="18" style="v" sid="ROM 12:18"/>No̱m no̱m-u̱ bo̱ do̱te̱ u̱t-shu̱'u̱t m-yar u̱ ko̱wan ne̱. <verse eid="ROM 12:18"/><verse number="19" style="v" sid="ROM 12:19"/>O̱r-u̱t ri ne̱, a waku̱n u̱ no̱mu̱ bo̱ no̱m-u yo̱-o̱, a-bo̱ to̱p-u̱ no̱m-u̱ yo̱-o̱ da, se̱di yage̱ u̱ Ru̱-u̱ to̱p-u̱ bo̱ u̱r-mag u̱ ryab-u̱s wa. U̱m zu̱u̱g iya remu̱ zu̱ na panu̱g u̱-me̱ Ran-u̱ u-Ru̱ u̱zu̱,</para>
  <para style="q1" vid="ROM 12:19">&lt;&lt;Me̱ Yawe, u̱m de̱ to̱p-du̱</para>
  <para style="q2" vid="ROM 12:19">ko̱wan remu̱ no̱m-u̱ wa no̱me̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">12:19 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="DEU 32:35">Muut 32:35</ref></char>.</note><verse eid="ROM 12:19"/></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 12:20"/>Rem-su̱ u-Ru̱ re̱e̱g shu̱ u̱t-zu̱,</para>
  <para style="q1" vid="ROM 12:20">&lt;&lt;Abite̱ hu̱u̱b-u̱ yo̱-o̱</para>
  <para style="q2" vid="ROM 12:20">ró o̱ ho̱g-du̱ u̱s-me̱r,</para>
  <para style="q1" vid="ROM 12:20">ya wa no̱m u̱t-re̱.</para>
  <para style="q2" vid="ROM 12:20">A wa ho̱g-du̱ u-swaat m-bu̱,</para>
  <para style="q1" vid="ROM 12:20">ya wa m-bu̱ wa swa.</para>
  <para style="q2" vid="ROM 12:20">A-bo̱ no̱me̱ iya shu̱'u̱te̱ u̱ka bo̱</para>
  <para style="q1" vid="ROM 12:20">kargu̱sse̱ eng-tu̱ u-ra u̱ hi-u̱r rò.</para>
  <para style="q2" vid="ROM 12:20">Tu̱msu̱ iya o̱ bo̱ do̱te̱ wadu̱</para>
  <para style="q1" vid="ROM 12:20">wu̱n u̱ ho̱g-du̱ m-'e̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">12:20 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PRO 25:21-22">ShaR 25:21-22</ref></char>.</note><verse eid="ROM 12:20"/></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 12:21"/>A-bo̱ yage̱ jab-u̱ yo̱-o̱ u̱ re̱ jab-u̱ ró da, se̱di bo̱ ze̱g be̱b-du̱ jab-u̱ yo̱-o̱ u̱ fu̱n-yu̱ no̱m-du̱ no̱m-u̱t so̱-to̱.<verse eid="ROM 12:21"/></para>
  <chapter eid="ROM 12"/>
  <chapter number="13" style="c" sid="ROM 13"/>
  <para style="s1">Do̱rru̱ rem-su̱ u̱t-faru̱k</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1"/>Ko̱wan wa ya' m-ze̱g u̱du̱ farkina-ne̱ i u-dak. Waku̱n zaar wu̱ de̱ shu̱'u̱tu̱ faru̱k da, se̱ wu̱ Ru̱-u̱ dage̱. Tu̱msu̱ ko̱wana shu̱'u̱te̱ faru̱k, Ru̱-o̱ gan-du̱ wa u̱r-faru̱k. <verse eid="ROM 13:1"/><verse number="2" style="v" sid="ROM 13:2"/>Remu̱ iya, ko̱wana gu̱gme̱ do̱rru̱ faru̱k-tu̱ u-dak, wa gu̱gu̱mte̱ do̱rru̱ no̱m-u̱ Ru̱-u̱ gan-de̱. Tu̱msu̱ i o̱ u̱t-no̱m iya e̱ de̱ naknu̱ hi-u̱r e̱ swadu̱ u̱r-ko̱b. <verse eid="ROM 13:2"/><verse number="3" style="v" sid="ROM 13:3"/>U̱m zu̱u̱g iya remu̱ zu̱ a no̱ o̱ no̱m-du̱ no̱m-u̱t so̱-to̱ no̱ za ho̱g-du̱ gye̱r-u u̱n da. Se̱di ne̱t-tu̱ o̱ no̱m-du̱ no̱m-u̱t yo̱-to̱ e̱ de̱ ho̱g-du̱ gye̱r-u̱ u̱t-faru̱k. A-bo̱ u̱t-sa bo̱ ru gye̱r-yu̱ ne̱t-u̱ o̱ u̱r-faru̱k, no̱m no̱m-u̱t so̱-to̱ wa de̱ hen u̱ vam-du̱ bo̱. <verse eid="ROM 13:3"/><verse number="4" style="v" sid="ROM 13:4"/>Wa de̱ vam-du̱ bo̱ remu̱ zu̱ wa to̱k wa u-Ru̱ wa remu̱ ró. Se̱di a-bo̱ o̱ ne̱t-u̱ yo̱-o̱, bo̱ u̱t-ho̱g u-gye̱r remu̱ zu̱ zan-o̱ da, farkina-ne̱ o̱tte̱ be̱b-du̱ yadu̱ bo̱ u̱r-ko̱b. To̱k u-Ru̱ wa tu̱msu̱ u̱du̱ wa de̱ Ru̱-u̱ ko̱ste̱ ryab-u̱s wa u̱du̱ ne̱t-u̱t yo̱-to̱. <verse eid="ROM 13:4"/><verse number="5" style="v" sid="ROM 13:5"/>Remu̱ iya yasu̱n hi-u̱r no̱ u̱du̱ faru̱k-tu̱ u-dak, za remu̱ gye̱r-u̱ ryab-su̱ u-Ru̱ u̱ war-o̱ da, se̱di taas u̱ dorog-u̱s no̱ u̱ hoos no̱ ru̱s-du̱ jab.<verse eid="ROM 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6"/>De̱ wu̱te̱ no̱ top-u̱t shik-u̱ tar, remu̱ zu̱ faru̱k-u̱t to̱ to̱k-ne̱ u-Ru̱ e̱, tu̱msu̱ e̱ yaase̱ da-u e̱ remu̱ e̱ nom-u̱t u̱r-faru̱k. <verse eid="ROM 13:6"/><verse number="7" style="v" sid="ROM 13:7"/>To̱po̱n ko̱wan no̱m-u̱ wa doru̱ no̱. Abite̱ shik-u̱ tar-u̱ hi-du̱ war-no̱ e̱, de̱e̱n no̱ to̱p, abite̱ hen shik-u̱ tar-u̱ no̱ e̱, to̱po̱n. Yaan m-ze̱g u̱du̱ wu̱ ko̱re̱ Ho̱go̱n gye̱r-u̱ wu̱ ko̱re̱ na ho̱g gye̱r-u wa, tu̱msu̱ no̱ ya' m-ze̱g u̱du̱ wu̱ ko̱re̱ no̱ ya' m-ze̱g.<note caller="+" style="f"><char style="fr" closed="false">13:7 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="MAT 22:21">Mati 22:21</ref>; <ref loc="MRK 12:17">Mark 12:17</ref>; <ref loc="LUK 20:25">Ruka 20:25</ref></char>.</note><verse eid="ROM 13:7"/></para>
  <para style="s1">U̱ka ku̱mte̱ in Ko̱su̱n u̱t-cwan <optbreak/> u̱du̱ o̱r-u̱t in ne̱</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8"/>A no̱ shipis no̱m-u waku̱n da. Se̱di no̱m-du̱ no̱m-tu̱ bo̱r-tu̱ u-Ru̱ zu̱ na no̱m, u̱zu̱ u̱ ne̱t-u̱ cwan o̱r-u̱t wa ne̱. U̱m zu̱u̱g iya remu̱ zu̱ wu̱ cwane̱ o̱r-u̱ wa, wa o̱ do̱rru̱ no̱m-u̱ bo̱r-tu̱ zu̱ na no̱m. <verse eid="ROM 13:8"/><verse number="9" style="v" sid="ROM 13:9"/>Bo̱r-u̱t to̱ zu̱u̱g, &lt;&lt;A-bo̱ no̱m m-o̱ da, a-bo̱ ho̱ waku̱n da,<note caller="+" style="f"><char style="fr" closed="false">13:9 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="EXO 20:13-15">Rwu̱u̱ 20:13-15</ref>,<ref loc="EXO 20:17">17</ref>; <ref loc="DEU 5:17-19">Muut 5:17-19</ref>,<ref loc="DEU 5:21">21</ref></char>.</note> a-bo̱ no̱m u-hiw da, a-bo̱ no̱m shu̱b-du̱ no̱m-u̱ ne̱t da.&gt;&gt; U̱ no̱m-tu̱ o̱ m-pan ne̱ u̱t-be̱e̱t u̱-me̱ u̱t-bo̱r, na samge̱ to̱ u̱-me̱ rem-u̱s sin-se̱ su̱ zu̱ye̱, &lt;&lt;Cwan o̱r-u̱ ró u̱ka bo̱ tonte̱ hi-du̱ war ró.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">13:9 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="LEV 19:18">To̱o̱g 19:18</ref></char>.</note> <verse eid="ROM 13:9"/><verse number="10" style="v" sid="ROM 13:10"/>A-bo̱ o̱ cwan-u̱t waku̱n, bo̱ za no̱mu̱ wa no̱m-u̱t yo̱-to̱ da. A-bo̱ cwane̱ o̱r-u̱ ró, bo̱ o̱ no̱m-du̱ bo̱r-u̱t Mosa zu̱ na no̱m.<verse eid="ROM 13:10"/></para>
  <para style="s1">Ho̱-du̱ Kiristi de̱ mu̱u̱n</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11"/>Da-u̱ Kiristi do̱'e̱ mu̱u̱n remu̱ wa ku̱b-u̱t in o̱ u̱t-mo̱r u̱ in ne̱ m-ze̱g da-u̱ u̱r-taku̱n du̱ in kabe̱ wa. Remu̱ iya gwatu̱n ka no̱ o̱tte̱ u̱r-yu̱. No̱ yu̱ne̱ du̱gu̱ m-roog. <verse eid="ROM 13:11"/><verse number="12" style="v" sid="ROM 13:12"/>Gyu̱p-mu̱ haag m-ta, is haag m-gas. Remu̱ iya, yagu̱n no̱m-du̱ no̱m-u̱t yo̱-to̱ u̱ka ne̱t-tu̱ o̱ u-cwu̱m, se̱di no̱ kab cwu̱-tu̱ m-gag tu̱ u-Ru̱ u̱ka no̱ do̱te̱ gu̱g-mu̱ faru̱k-u̱ no̱m u̱s-te. <verse eid="ROM 13:12"/><verse number="13" style="v" sid="ROM 13:13"/>In no̱mo̱n shu̱'u̱t-u̱r so̱-de̱, u̱ka ne̱t-tu̱ o̱ u̱r-yu̱ u̱-me̱ m-zu̱n. A no̱ same̱ u̱t-hi u̱ mo̱ro̱g-du̱ a-u-swa ne̱ u̱ i o̱o̱ge̱ yu̱du̱ za so̱de̱ ne̱ u̱ a-u-as ne̱ da, za me̱ u-har u̱r-shu̱b ne̱. <verse eid="ROM 13:13"/><verse number="14" style="v" sid="ROM 13:14"/>Se̱di no̱ ya' Wa-ko-uyan Ye̱so̱ Kiristi u̱r-be u̱-me̱ jab-u̱s no̱, remu̱ wa hiktu̱n u̱t-mo̱r u̱ no̱ ne̱ u̱ka cwu̱-tu̱ u-war u̱ no̱ tu̱ no̱ wu̱ye̱. A no̱ no̱m dorog-su̱ yu̱-du̱ u̱t-baas tu̱ cwan-tu̱ war-u̱t no̱ da.<verse eid="ROM 13:14"/></para>
  <chapter eid="ROM 13"/>
  <chapter number="14" style="c" sid="ROM 14"/>
  <para style="s1">No̱ kwu̱pu̱ o̱r-u̱t no̱ <optbreak/> u̱s-rem da</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1"/>Kabu̱n ne̱t-u̱ yadu̱ jab-u̱ wa zatte̱ u̱r-be̱b da. A no̱ ha inan u̱ u̱n ne̱ da, abite̱ dorog-u̱s u̱n za ho̱n-ho̱n u̱ su̱ no̱ ne̱ da. <verse eid="ROM 14:1"/><verse number="2" style="v" sid="ROM 14:2"/>To̱ko̱n ne̱t-to̱ o̱tte̱ yadu̱ jab-u̱ de̱ wadu̱ e̱ re̱-du̱ no̱m-u̱ e̱ u̱t-sa u̱t-re̱. Tu̱msu̱ e̱ke̱n o̱tte̱ yadu̱ jab u̱zu̱ Ru̱-u̱ za u̱ssa e̱ tu̱ m-ap da se̱ u̱t-ran u̱ war-to̱. <verse eid="ROM 14:2"/><verse number="3" style="v" sid="ROM 14:3"/>Wu̱ re̱ ko̱-uyan no̱m u̱t-re̱ o̱, a wa ju̱ru̱m wu̱ rete̱ da. Tu̱msu̱ wu̱ rete̱ da a wa hyan wa u̱t-re̱ u̱ka wa u̱t-ba'as da, remu̱ zu̱ Ru̱-u̱ kabu̱g e̱. <verse eid="ROM 14:3"/><verse number="4" style="v" sid="ROM 14:4"/>¿Wana bo̱, bo̱ kwu̱p-tu̱ to̱k-u̱ waku̱n u̱s-rem? Ko̱ to̱k-u̱ no̱ng no̱m-u̱t so̱-to̱ u̱du̱ u̱so-u u-bu wa ko̱ tu̱ yo̱-to̱, se̱ u̱s-be̱e̱t su̱ wa-u-bu se̱ wa kwu̱pu̱ wa u̱s-rem. Wa u̱t-kere̱ u̱t-es, remu̱ zu̱ Ru̱-o̱ keru̱ yadu̱ wu̱n be̱b-du̱ u̱r-es.<verse eid="ROM 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5"/>Waku̱n u̱t-kere̱ u̱t-zu̱ de̱ku̱n ho̱-de̱ ze̱k to̱ko̱n ho̱-to̱. U̱ hyanu̱m waku̱n ho̱-to̱ u̱s-gan. Ko̱wan u̱ no̱m no̱m-u̱ wa nape̱ Ru̱-u̱ u̱t-sa wa no̱m, a wa ha kwu̱pu̱ ne̱t-ne̱ u̱s-rem da. <verse eid="ROM 14:5"/><verse number="6" style="v" sid="ROM 14:6"/>Wu̱ o̱ hyan-du̱ u̱ka zu̱ de̱ku̱n ho̱-de̱ ze̱k to̱ko̱n ho̱-to̱, wa o̱ u̱t-no̱m iya remu̱ yadu̱ u-Ru̱ m-sek. Ne̱t-u̱ o̱ re-du̱ ko̱-uyan no̱m u̱t-re̱ o̱, wa o̱ u-re̱ remu̱ sek-mu̱ u-Ru̱, remu̱ zu̱ e̱ o̱ no̱mu̱ Wa-ko-uyan u̱t-vam remu̱ no̱m u̱t-re̱ o̱. Tu̱msu̱ ne̱t-u̱ rete̱ ko̱-uyan no̱m u̱t-re̱ o̱ da wa o̱ u̱t-no̱m iya remu̱ Se̱k-mu̱ u-Ru̱, wa o̱ no̱mu̱ u-Ru̱ u̱t-vam.<note caller="+" style="f"><char style="fr" closed="false">14:6 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="COL 2:16">Koro 2:16</ref></char>.</note> <verse eid="ROM 14:6"/><verse number="7" style="v" sid="ROM 14:7"/>Waku̱n zaar wu̱ o̱ shu̱'u̱t-mu̱ hi-du̱ war-wa da, tu̱msu̱ waku̱n zaar wu̱ de̱ m-mar remu̱ hi-du̱ war-wa da. <verse eid="ROM 14:7"/><verse number="8" style="v" sid="ROM 14:8"/>A in o̱ u̱r-fat, in o̱ u̱r-fat u̱du̱ u-Ru̱. Remu̱ iya, ko̱ u̱r-fat ne̱ ko̱ za u̱r-fat, in o̱ u̱du̱ u-Ru̱.<verse eid="ROM 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 14:9"/>Remu̱ iya, Kiristi maru̱g tu̱msu̱ wa mu̱u̱n u̱r-fat remu̱ wa shu̱'u̱te̱ Wa-ko-uyan u̱ ne̱t-tu̱ u̱r-fat u̱ marimari ne̱. <verse eid="ROM 14:9"/><verse number="10" style="v" sid="ROM 14:10"/>¿Bo̱, remu̱ yan-o̱ bo̱ o̱tte̱ kwu̱pu̱ o̱r-u̱ ró u̱s-rem? ¿Ko̱ yan-o̱ wu̱te̱ bo̱ o̱tte̱ ju̱rmu̱ o̱r-u̱ ró? U̱m zu̱u̱g iya remu̱ in be̱e̱t in do̱'e̱ u̱t-es u̱ pora-du̱ kwu̱p-du̱ u̱s-rem u-Ru̱.<note caller="+" style="f"><char style="fr" closed="false">14:10 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="2CO 5:10">2Kor 5:10</ref></char>.</note> <verse eid="ROM 14:10"/><verse number="11" style="v" sid="ROM 14:11"/>Rem-su̱ u-Ru̱ zu̱u̱g:</para>
  <para style="q1" vid="ROM 14:11">&lt;&lt;Me̱ o̱ Yawe,</para>
  <para style="q2" vid="ROM 14:11">u̱m to̱ndte̱,</para>
  <para style="q1" vid="ROM 14:11">Ko̱du̱he̱ jwu̱n-de̱ de̱</para>
  <para style="q2" vid="ROM 14:11">u̱t-kwu̱g u̱-shu̱ ri,</para>
  <para style="q1" vid="ROM 14:11">ko̱du̱he̱ rem-de̱ de̱ u̱t-war</para>
  <para style="q2" vid="ROM 14:11">u̱ nu-u wa u̱zu̱ me̱ wa u-Ru̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">14:11 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 45:23">Isha 45:23</ref></char>.</note><verse eid="ROM 14:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12"/>Remu̱ iya hen kowan de̱ warru̱ no̱m-u̱ wa no̱me̱ u̱du̱ u-Ru̱. Yaksu̱n u-Ru̱ kwu̱p-du̱ u̱s-rem.<verse eid="ROM 14:12"/></para>
  <para style="s1">A-bo̱ wa o̱r-u̱ ró u̱ <optbreak/> no̱m-du̱ u̱t-ba'as da</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13"/>Yagu̱n kwu̱pu̱ o̱r-u̱t no̱ u̱s-rem. Tu̱msu̱ yagu̱n u̱t-zu̱ u̱ Ru̱-u̱ ya' o̱r-u̱t in ne̱ a-dor u̱r-ko̱b. Se̱di in waan sin-se̱ u̱ jab-u̱s in u̱zu̱ in za no̱m-du̱ o̱ko̱n no̱m-o̱ u̱ do̱'e̱ wadu̱ waku̱n u̱r-he̱'e̱ ko̱ u̱ wadu̱ wa u̱ no̱m-du̱ u̱t-ba'as da. <verse eid="ROM 14:13"/><verse number="14" style="v" sid="ROM 14:14"/>U̱ka wa-doru̱ Wa-ko-uyan Ye̱so̱ u̱m o̱ waru̱ no̱ rem-u̱s sin-se̱. U̱m nak u̱-me̱ jab-u̱ ri u̱m zatte̱ u-sakna da u̱zu̱ ko̱-uyan no̱m u̱t-re̱ o̱ so̱-o̱. Se̱di a waku̱n u̱ zu̱ye̱, &lt;&lt;A u̱m re̱ no̱m u̱t-re̱ uno̱ me̱ u̱t-no̱m u̱t-ba'as u̱du̱ u-Ru̱,&gt;&gt; a wa re̱ no̱m u̱t-re̱ o̱ hen wa no̱ng u̱t-ba'as. <verse eid="ROM 14:14"/><verse number="15" style="v" sid="ROM 14:15"/>Abite̱ no̱m u̱t-re̱ u̱ bo̱ o̱ u̱t-re̱ o̱ de̱ haatu̱n o̱r-u̱ ró u̱r-he̱'e̱, bo̱ za cwan-u̱t wa da. Kiristi maru̱g remu̱ o̱r-u̱ ró, a-bo̱ yage̱ u̱ o̱r-u̱ ró u̱ he̱'e̱ u̱ remu̱ no̱m u̱t-re̱ da. <verse eid="ROM 14:15"/><verse number="16" style="v" sid="ROM 14:16"/>A-bo̱ yage̱ no̱m-u̱ bo̱ o̱ m-hyan u̱ka u̱ so̱-o̱, o̱ shu̱'u̱t u̱ yo̱-o̱ da. <verse eid="ROM 14:16"/><verse number="17" style="v" sid="ROM 14:17"/>U̱m zu̱u̱g iya remu̱ zu̱ faru̱k-du̱ u-Ru̱ za mo̱ttu̱ no̱m u̱t-re̱ u̱t-swa ne̱ o̱ da, se̱di mo̱ttu̱ yu̱du̱ jab-u̱ so̱-o̱, shu̱'u̱t-du̱ m-yar, u̱ u̱r-so̱ ne̱ u̱-me̱ Yar-u̱ u-Ru̱. <verse eid="ROM 14:17"/><verse number="18" style="v" sid="ROM 14:18"/>Ko̱wan wu̱ o̱ do̱rru̱ Kiristi u̱ go̱-du̱ fu̱n-u inya, Ru̱-u̱ de̱ ho̱g-du̱ zwar-u̱r wa tu̱msu̱ ne̱t-tu̱ de̱ ru̱stu̱ jab-u̱s e̱ u̱ wu̱n ne̱.<verse eid="ROM 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19"/>Yagu̱n in no̱mo̱n no̱m-u̱ de̱ haatu̱n shu̱'u̱t-du̱ m-yar a-doru̱ Ye̱so̱. Tu̱msu̱ in se̱ge̱n ne̱t-ne̱ e̱ no̱m u̱r-be̱b u̱ yadu̱ jab ne̱. <verse eid="ROM 14:19"/><verse number="20" style="v" sid="ROM 14:20"/>A-bo̱ naas no̱m-u̱ Ru̱-u̱ no̱me̱ remu̱ no̱m u̱t-re̱ da. Ko̱-uyan no̱m-u̱t u̱t-re̱ o̱ so̱-o̱, se̱di zatte̱ u̱r-zwar u̱ ne̱t u̱ re̱ no̱m u̱t-re̱ u̱ de̱ wadu̱ waku̱n u̱r-he̱'e̱ da. <verse eid="ROM 14:20"/><verse number="21" style="v" sid="ROM 14:21"/>U̱t-ze̱g u̱r-zwar a ne̱t u̱ tu̱ m-ap da ko̱ swadu̱ ke̱' ko̱ no̱m-du̱ o̱ko̱n u̱ do̱'e̱ wadu̱ waku̱n u̱r-he̱'e̱.<verse eid="ROM 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 14:22"/>Bo̱ keru̱ yadu̱ jab u̱zu̱ no̱m-u̱ bo̱ o̱ u̱t-no̱m u-be̱e̱t o̱ so̱-o̱, se̱di cin o̱ u̱ te̱k-u̱ jab-u̱ ró u̱ u-Ru̱ ne̱. Kom-u̱ u-Ru̱ u̱du̱ ne̱t wu̱ jab-u̱ wa zatte̱ u̱t-ba'as da, remu̱ no̱m-u̱ wa cwane̱ u̱t-no̱m u̱ so̱-o̱. <verse eid="ROM 14:22"/><verse number="23" style="v" sid="ROM 14:23"/>Se̱di ne̱t-u̱ wu̱ o̱tte̱ u-sakna u̱ jab-u̱ wa u̱ no̱m-u̱ wa de̱ u̱t-re̱, wa o̱ naknu̱ hi-u̱r wa kwu̱p-du̱ u̱s-rem du̱gu̱-du̱ u-Ru̱. U̱m zu̱u̱g iya remu̱ zu̱ wa zatte̱ yadu̱ jab da. Tu̱msu̱ no̱m-u̱ zatte̱ yadu̱ jab da ba'as-to̱.<verse eid="ROM 14:23"/></para>
  <chapter eid="ROM 14"/>
  <chapter number="15" style="c" sid="ROM 15"/>
  <para style="s1">Yu̱du̱ mangu̱ e̱ke̱n jab</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1"/>In i yadu̱ jab-u̱ in o̱ u̱r-be̱b ne̱, kamu̱g in se̱ge̱n i yadu̱ jab-u̱ e̱ zatte̱ u̱r-be̱b da in kabu̱n no'om e̱. Taas in no̱mo̱n cwan-tu̱ u̱r-hi da. <verse eid="ROM 15:1"/><verse number="2" style="v" sid="ROM 15:2"/>Yagu̱n u̱ ko̱wan u̱ mang jab-u̱ o̱r-u̱ wa, remu̱ wa swu̱r-tu̱ wu̱n be̱b-du̱ yadu̱ jab. <verse eid="ROM 15:2"/><verse number="3" style="v" sid="ROM 15:3"/>Ko̱ Kiristi wa no̱ng cwan-tu̱ hi-u̱r wa da. U̱ka Rem-su̱ u-Ru̱ zu̱tte̱, &lt;&lt;Pyap-su̱ i o̱ pepru̱ bo̱ u̱m o̱ ho̱g-du̱ se̱ u̱ka u̱zu̱ me̱ u̱n o̱ u̱t-pepu̱r.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:3 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 69:9">Se̱pV 69:9</ref></char>.</note> <verse eid="ROM 15:3"/><verse number="4" style="v" sid="ROM 15:4"/>No̱m-u̱ na pane̱ u-be̱e̱t u-me̱ Rem-su̱ u-Ru̱ u̱s-be̱e̱t u̱r-taku̱n, na panu̱g se̱ remu̱ na swu̱r-tu̱ in gag-du̱ jab-u̱ shiriktin-mu̱ jab ne̱, u̱ka in do̱te̱ u̱t-shu̱'u̱t u̱ wadu̱ jab ne̱.<verse eid="ROM 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 15:5"/>U̱m o̱ u̱s-ko̱n u̱du̱ u-Ru̱, wu̱ ye na gag-du̱ jab-u̱ shiriktin-mu̱ jab ne̱, u̱ka no̱ do̱te̱ u̱t-shu̱'u̱t u̱ same̱-du̱ u̱t-hi ne̱ u̱s-dorog ne̱ u̱s-gan, remu̱ do̱rru̱ da'at Kiristi Ye̱so̱. <verse eid="ROM 15:5"/><verse number="6" style="v" sid="ROM 15:6"/>A no̱ no̱me̱ iya, rem-u̱s no̱ u̱ dorog-u̱s no̱ de̱ u̱t-shu̱'u̱t u̱s-gan, u̱ka no̱ do̱te̱ vam-du̱ u-Ru̱ wu̱ o̱ U̱so-u in Wa-ko-uyan, Ye̱so̱ Kiristi.<verse eid="ROM 15:6"/></para>
  <para style="s1">Rem-su̱ m-Re̱me̱r su̱ Yahuda-ne̱ se̱ u̱ a-za Yahuda-ne̱</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7"/>U̱ka Kiristi ku̱bte̱ no̱, kabu̱n o̱r-u̱t no̱ iya remu̱ Ru̱-u̱ kum-u̱t u̱t-fu̱'u̱bse̱. <verse eid="ROM 15:7"/><verse number="8" style="v" sid="ROM 15:8"/>U̱m u̱t-sa no̱ baku̱s u̱zu̱ Kiristi no̱ngu̱ Yahuda-ne̱ u̱r-se̱ge̱ remu̱ wa ko̱ste̱ u̱zu̱ Ru̱-o̱ keru̱ no̱m-du̱ no̱m-u̱ wa zu̱ wa u̱t-no̱m. Ru̱-u̱ no̱ngu̱ i mate̱ u̱so-tu̱ u̱so-u̱t in este̱du̱ u̱s-rem u̱zu̱ wa to̱mnu̱ Kiristi. Da-u̱ Ye̱so̱ haane̱, Ru̱-u̱ nom no̱m-u̱ wa zu̱ wa u̱t-no̱m. <verse eid="ROM 15:8"/><verse number="9" style="v" sid="ROM 15:9"/>Wa haagu̱n remu̱ a-za Yahuda-ne̱, remu̱ e̱ no̱m-tu̱ u-Ru̱ u̱t-fu̱'u̱bse̱ remu̱ o̱n-u̱r wa. U̱ka Rem-su̱ u-Ru̱ zu̱tte̱:</para>
  <para style="q1" vid="ROM 15:9">&lt;&lt;Remu̱ iya,</para>
  <para style="q2" vid="ROM 15:9">U̱m de̱ vam-du̱ no̱ u̱-me̱</para>
  <para style="q2" vid="ROM 15:9">a-za Yahuda-ne̱,</para>
  <para style="q1" vid="ROM 15:9">U̱m de̱ no̱m-du̱ se̱p-tu̱</para>
  <para style="q2" vid="ROM 15:9">vam-tu̱ dim-u̱r ró.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="2SA 22:50">2Sam 22:50</ref>; <ref loc="PSA 18:49">Se̱pV 18:49</ref></char>.</note><verse eid="ROM 15:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10"/>Tu̱msu̱ Rem-su̱ u-Ru̱ sur m-zu̱:</para>
  <para style="q1" vid="ROM 15:10">&lt;&lt;No̱mo̱n u̱r-so̱ no̱ i za-Yahuda-ne̱ da, u̱r-kot u̱ ne̱t-tu̱ u-Ru̱ ne̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:10 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="DEU 32:43">Muut 32:43</ref></char>.</note><verse eid="ROM 15:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11"/>Tu̱msu̱ na sur m-zu̱:</para>
  <para style="q1" vid="ROM 15:11">&lt;&lt;No̱ be̱e̱t a-za Yahuda-ne̱</para>
  <para style="q2" vid="ROM 15:11">vamu̱n Yawe,</para>
  <para style="q1" vid="ROM 15:11">ne̱t-ne̱ be̱e̱t e̱ vam wa.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:11 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 117:1">Se̱pV 117:1</ref></char>.</note><verse eid="ROM 15:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12"/>Wa-warru̱ Rem-su̱ u-Ru̱ Ishaya zu̱u̱g:</para>
  <para style="q1" vid="ROM 15:12">&lt;&lt;Waku̱n do̱'e̱ rwu̱u̱n du̱gu̱ ko̱-u̱r Jesse,</para>
  <para style="q2" vid="ROM 15:12">wa do̱'e̱ haan wa no̱m u̱r-faru̱k u̱-me̱</para>
  <para style="q1" vid="ROM 15:12">i-za-Yahuda-ne̱ da.</para>
  <para style="q2" vid="ROM 15:12">Tu̱msu̱ e̱ do̱'e̱ wadu̱ jab u̱du̱ wa.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:12 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 11:10">Isha 11:10</ref></char>.</note><verse eid="ROM 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13"/>U̱m no̱ng u̱s-to̱o̱g u̱zu̱, Ru̱-u̱ wadu̱ jab, wa ya' no̱ ya' jab-u̱ pus-o̱ u̱ shu̱'u̱t-du̱ m-yar ne̱, no̱ o̱tte̱ yadu̱ jab u̱du̱ wa. Iya o̱ no̱ wadu̱ jab-u̱ no̱ do̱te̱ u̱t-shu̱'u̱t u-shu̱yi shu̱yi u̱ shin-mu̱ Yar-u u-Ru̱.<verse eid="ROM 15:13"/></para>
  <para style="s1">Pama-u̱s Burus u̱du̱ <optbreak/> i-za-Yahuda-ne̱ da</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14"/>Hu̱u̱b-u̱t ri, me̱ hi-du̱ war ri u̱m nak u̱zu̱ no̱ o̱tte̱ jab-u̱ no̱m-du̱ no̱m-u̱t so̱-to̱. No̱ o̱tte̱ nap-mu̱ no̱m-u̱t tun-to̱ u̱t-be̱e̱t, tu̱msu̱ no̱ keru̱ is-u̱ o̱r-u̱t no̱ ne̱ no̱m-u̱t to̱. <verse eid="ROM 15:14"/><verse number="15" style="v" sid="ROM 15:15"/>Se̱di u̱-me̱ uno̱ ran-o̱, u̱m wargu̱ no̱ no̱m-u̱ o̱ jab-u̱ ri u̱ to̱ko̱n no̱m-to̱ ne̱. U̱m wargu̱ no̱ to̱ko̱n no̱m-to̱ tu̱ u̱m u̱t-sa u̱m baksu̱n no̱, remu̱ nya-u̱ u-Ru̱ u̱ wa no̱mu̱ me̱. <verse eid="ROM 15:15"/><verse number="16" style="v" sid="ROM 15:16"/>U̱m shu̱'u̱te̱ wa pama-u̱s Kiristi Ye̱so̱ u̱du̱ a-za Yahuda-ne̱. U̱m haatu̱n no̱ Rem-su̱ m-Re̱me̱r remu̱ no̱ shu̱'u̱te̱ u̱ka u̱r-to̱o̱g u̱du̱ u-Ru̱ du̱ wa u̱t-sa du̱ u-he̱n, remu̱ Yar u-Ru̱.<verse eid="ROM 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 15:17"/>Remu̱ iya, me̱ u̱t-kere̱ gap-du̱ u-so̱k u̱ Ye̱so̱ Kiristi ne̱ tu̱msu̱ u̱ pama-u̱ u̱m o̱ u̱t-no̱m u̱du̱ u-Ru̱. <verse eid="ROM 15:17"/><verse number="18" style="v" sid="ROM 15:18"/>U̱m za keru̱ gap-du̱ u-so̱k u̱m war o̱ko̱n da, se̱di u̱m war no̱m-u̱ Kiristi no̱me̱, remu̱ u̱m wu̱'u̱t i za-Yahuda-ne̱ da u̱ do̱rru̱ u-Ru̱, remu̱ rem-u̱s ri u̱ pama-u̱s ri ne̱. <verse eid="ROM 15:18"/><verse number="19" style="v" sid="ROM 15:19"/>Ru̱-u̱ no̱ng no̱m-u̱t tun-to̱ u̱ remu̱ shin-mu̱ wa ko̱se̱ u̱ no̱m-du̱ m-shin u̱ u̱s-nap ne̱, tu̱msu̱ u̱ be̱b-du̱ Yar-u u-Ru̱. Wa takku̱n se̱ du̱gu̱ Urusharima m-ha Iririkum, u̱m no̱ng bu̱t-tu̱ Rem-su̱ m-Re̱me̱r su̱ Kiristi, se̱ da-u̱ u̱m tase̱ pama-u̱s se̱ u̱s-be̱e̱t. <verse eid="ROM 15:19"/><verse number="20" style="v" sid="ROM 15:20"/>Cwan-m ri mo̱ ko̱-uyan da-o̱, u̱m no̱m bu̱t-tu̱ Re̱m-su̱ m-Re̱me̱r su̱ u-Ru̱ u̱ be-tu̱ i nape̱ Kiristi da. U̱m no̱ng iya remu̱ zu̱ u̱m za u̱ssa u̱m shu̱'u̱t u̱ka ne̱t wu̱ no̱me̱ u-ma u̱ do̱m-u̱ ma-u waku̱n da. <verse eid="ROM 15:20"/><verse number="21" style="v" sid="ROM 15:21"/>U̱ka Rem-su̱ u-Ru̱ zu̱tte̱:</para>
  <para style="q1" vid="ROM 15:21">&lt;&lt;Ne̱t-tu̱ nape̱ wu̱n da,</para>
  <para style="q2" vid="ROM 15:21">e̱ hyan.</para>
  <para style="q1" vid="ROM 15:21">Tu̱msu̱ ne̱t-tu̱ ho̱ge̱ rem-u̱s rò da,</para>
  <para style="q2" vid="ROM 15:21">e̱ nap.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:21 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 52:15">Isha 52:15</ref></char>.</note><verse eid="ROM 15:21"/></para>
  <para style="m">
    <verse number="22" style="v" sid="ROM 15:22"/>U-da u-be̱e̱t a u̱m zo̱nge̱ m-haan u̱du̱ no̱, na hoos me̱ u̱r-haan.<note caller="+" style="f"><char style="fr" closed="false">15:22 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ROM 1:13">Roma 1:13</ref></char>.</note><verse eid="ROM 15:22"/></para>
  <para style="s1">Burus zo̱ngte̱ ha-mu̱ <optbreak/> bo̱-u̱ Roma</para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 15:23"/>U̱ da-o̱ u̱m taaste̱ pama-u̱ u̱m de̱ u̱t-no̱m remu̱ ne̱t-tu̱ ho̱k Rem-su̱ m-Re̱me̱r u̱ ru̱g-u o̱. U̱s-hak u-tát u̱m cwanu̱g u̱m haan u̱m hyan no̱. <verse eid="ROM 15:23"/><verse number="24" style="v" sid="ROM 15:24"/>U̱ da-o̱ u̱m wa'ag jab u̱r-haan ne̱ u̱ be-u̱r no̱. A u̱m o̱ m-ha u̱ gas-u̱ Asbaniya, me̱ u̱t-do̱ru̱n u̱m hyan no̱. Me̱ u̱t-ho̱g u̱r-zwar u̱m shu̱'u̱t u̱du̱ no̱ u-da cashi. Da-u̱ u̱m kume̱ se̱ge̱-u̱r no̱ se̱ u̱m re̱ shu̱ m-ha ne̱. <verse eid="ROM 15:24"/><verse number="25" style="v" sid="ROM 15:25"/>Se̱di kanda u̱m do̱'e̱ u̱ku̱n, u̱m de̱ m-ha u̱ bo̱-u̱ Urusharima remu̱ u̱m no̱m-u̱t u-nya u̱du̱ ne̱t-tu̱ u-Ru̱. <verse eid="ROM 15:25"/><verse number="26" style="v" sid="ROM 15:26"/>Ne̱t-tu̱ kabe̱ Ye̱so̱ Kiristi i o̱ u̱ gas-u̱ Makidoniya u̱ i o̱ ru̱g-u Akaya ne̱, e̱ ho̱k zwarru̱ yadu̱ cwu̱u̱t e̱ u̱du̱ o̱r-u̱t e̱ ne̱ i o̱ u̱r-ko̱b ne̱ i o̱ u̱-me̱ ne̱t-tu̱ u-Ru̱ u̱ bo̱-u̱ Urusharima.<note caller="+" style="f"><char style="fr" closed="false">15:26 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="1CO 16:1-4">1Kor 16:1-4</ref></char>.</note> <verse eid="ROM 15:26"/><verse number="27" style="v" sid="ROM 15:27"/>E̱ ho̱k zwarru̱ u̱t-no̱m iya rem u̱zu̱ e̱ ho̱k e̱ dor u̱n u̱r-mag. Remu̱ zu̱ a-za-dor ne̱ o̱nkte̱ nya-u̱ u-yar u̱ kom-u̱ u-Ru̱ u̱ rem-su̱ m-re̱me̱r du̱gu̱-du̱ a-dor-ne̱ u̱ bo̱-u̱ Urusharima, e̱ ho̱k u̱zu̱ no̱mu̱ kuse̱ e̱ no̱m u̱ e̱ top-u̱t u̱n u̱r-mag u̱zu̱ e̱ no̱mu̱ u̱n se̱ge̱-du̱ shik.<note caller="+" style="f"><char style="fr" closed="false">15:27 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="1CO 9:11">1Kor 9:11</ref></char>.</note> <verse eid="ROM 15:27"/><verse number="28" style="v" sid="ROM 15:28"/>Da-u̱ u̱m tase̱ pama-u uno̱, u̱m do̱'e̱ yasu̱ u̱n shik-u̱ u̱n, u̱m do̱'e̱ shu̱p-du̱ fu̱n-yu̱ ha-mu̱ gas-u̱ Asbaniya. A u̱m o̱ te̱k m-ha u̱ Asbaniya, me̱ u̱t-do̱ru̱n u̱m vu̱ku̱s no̱. <verse eid="ROM 15:28"/><verse number="29" style="v" sid="ROM 15:29"/>Da-u̱ u̱m teene̱ u̱ Roma, u̱m nak me̱ u̱t-teen u̱ kom-u̱ u-Ru̱ ne̱ u̱ Kiristi ne̱.<verse eid="ROM 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30"/>O̱r-u̱t ri ne̱, remu̱ Ye̱so̱ Kiristi Wa-ko-uyan tu̱msu̱ u̱t-cwan ne̱ tu̱ Yar-u ya in, u̱m o̱ ko̱n-u̱s no̱, no̱ same̱ u̱t-kom u̱ me̱ ne̱ remu̱ gag-mu̱ no̱mu̱ me̱ u̱s-to̱o̱g u̱du̱ u-Ru̱. <verse eid="ROM 15:30"/><verse number="31" style="v" sid="ROM 15:31"/>No̱mo̱n u̱s-to̱o̱g u̱ka u̱m do̱te̱ u̱t-pos du̱gu̱ kom-tu̱ i za a-doru̱ Ye̱so̱ da, in o̱ dak-u̱ Yahudiya. U̱m o̱ u̱s-to̱o̱g u̱ka se̱ge̱-du̱ u̱m do̱'e̱ u̱t-kab u̱du̱ a-dor i Urusharima e̱ kab o̱. <verse eid="ROM 15:31"/><verse number="32" style="v" sid="ROM 15:32"/>A Ru̱-u̱ tane̱, me̱ u̱t-haan u̱du̱ no̱ u̱r-so̱ ne̱ remu̱ in nomtu̱n u̱r-orop u̱r-kot du̱ de̱ ya in shiriktin-mu̱ jab-u̱ ank-mu̱ u-Ru̱. <verse eid="ROM 15:32"/><verse number="33" style="v" sid="ROM 15:33"/>U̱m o̱ no̱mu̱ no̱ u̱s-to̱o̱g u̱du̱ u-Ru̱ wu̱ shu̱'u̱t m-yar wa no̱m u̱r-kot u̱ no̱ ne̱! U̱ shu̱'u̱t iya.<verse eid="ROM 15:33"/></para>
  <chapter eid="ROM 15"/>
  <chapter number="16" style="c" sid="ROM 16"/>
  <para style="s1">U̱s-vu̱k</para>
  <para style="li1">
    <verse number="1" style="v" sid="ROM 16:1"/>Yaku̱n ne̱ta-ya o̱ro wu̱ de̱ haan u̱du̱ no̱, dim-u̱r wa Fibi. U̱m o̱ waru̱ no̱, ne̱t-u̱ m-kim wa. Tu̱msu̱ wa o̱ wa-m-ank u̱-me̱ a-doru̱ Ye̱so̱ u̱ bo̱-u̱ Kankiriya. <verse eid="ROM 16:1"/><verse number="2" style="v" sid="ROM 16:2"/>Kabu̱n wu̱n u̱t-kom u̱t-yu̱r remu̱ zu̱ wa doru̱ Wa-ko-uyan wa, u̱ka na gute̱ ne̱t-tu̱ u-Ru̱. No̱mo̱n wu̱n se̱ge̱-du̱ wa u̱t-sa u̱r-be̱e̱t, remu̱ zu̱ ko̱wa wa no̱ngu̱ ne̱t-ne̱ u-tát u̱r-se̱ge̱ tu̱msu̱ ko̱ me̱ u no̱ngu̱ me̱.<verse eid="ROM 16:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="ROM 16:3"/>Vu̱k-su̱ me̱ Biskira u̱ Akira ne̱ o̱r-u̱ ri u̱-me̱ pama-u̱s Kiristi Ye̱so̱.<note caller="+" style="f"><char style="fr" closed="false">16:3 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ACT 18:2">Pama 18:2</ref></char>.</note> <verse eid="ROM 16:3"/><verse number="4" style="v" sid="ROM 16:4"/>E̱ ya'aste̱ fat-u̱t e̱ u̱ka e̱ mar remu̱ ri. Me̱ wa u-gan u̱ o̱ vam-u̱t u̱n da, a-doru̱ Ye̱so̱ i za-Yahuda-ne̱ da e̱ no̱ng u̱t-vam ko̱'e̱.<verse eid="ROM 16:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="ROM 16:5"/>Vu̱ksu̱n mo̱ro̱g-du̱ a-dor i mo̱rge̱ u̱-me̱ bu-u u̱n.</para>
  <para style="li1" vid="ROM 16:5">Vu̱ksu̱n hu̱u̱b-u̱ ri Apanitus, wa doru̱ Kiristi u̱r-taku̱n u̱ dak-u̱ Asiya.<verse eid="ROM 16:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="ROM 16:6"/>Vu̱ksu̱n Me̱ri wu̱ no̱mu̱ u-pama u̱ remu̱ no̱ sok.<verse eid="ROM 16:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="ROM 16:7"/>Vu̱ksu̱n Andaronikus u̱ Yuniya ne̱, ne̱t-tu̱ Yahuda to̱ u̱ka u̱m o̱tte̱, it u̱ e̱ ne̱ o̱o̱ge̱ u̱ bu-u̱ m-to̱k. A-doru̱ Ye̱so̱ o̱ yadu̱ u̱n m-sek sok, tu̱msu̱ u̱m nak u̱n u̱ te̱k-u̱ a-To̱mu̱ Ye̱so̱ e̱ kabu̱g Kiristi kanda me̱.<verse eid="ROM 16:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="ROM 16:8"/>Vu̱ksu̱n Ampiriyatus, hu̱u̱b-u̱ ri u̱-me̱ Wa-ko-uyan.<verse eid="ROM 16:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="ROM 16:9"/>Vu̱ksu̱n Urbanus hu̱u̱b m-anku̱ ri u̱-me̱ Kiristi, u̱ hu̱u̱b-u̱ ri ne̱ Sitakis.<verse eid="ROM 16:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="ROM 16:10"/>Vu̱ksu̱n Aperes, to̱k-u̱ so̱-wa wu̱ Kiristi.</para>
  <para style="li1" vid="ROM 16:10">Vu̱ksu̱n ne̱t-tu̱ o̱ bu-u Aristoburus.<verse eid="ROM 16:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="ROM 16:11"/>Vu̱ksu̱n Herodiya, o̱r-u̱ ri wa-yahuda.</para>
  <para style="li1" vid="ROM 16:11">Vu̱ksu̱n a-dor u-Ru̱ i o̱ bu-u Narkisus.<verse eid="ROM 16:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="ROM 16:12"/>Vu̱ksu̱n Tirayipina u̱ Tiraposa. Ne̱ta-u̱t to̱ e̱ no̱ngu̱ Wa-ko-uyan u̱s-pama sok.</para>
  <para style="li1" vid="ROM 16:12">Vu̱ksu̱n hu̱u̱b-u̱ ri Parsis, yaku̱n ne̱ta-ya tu̱msu̱ yu̱ no̱mu̱ Wa-ko-uyan u̱s-pama.<verse eid="ROM 16:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="ROM 16:13"/>Vu̱ksu̱n Rufus, wu̱ Ru̱-u̱ dage̱, u̱ ino-u wane̱ wu̱ shu̱'u̱te̱ u̱ka u-ino u̱du̱ ri.<note caller="+" style="f"><char style="fr" closed="false">16:13 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="MRK 15:21">Mark 15:21</ref></char>.</note><verse eid="ROM 16:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="ROM 16:14"/>Vu̱ksu̱n Asinikiritus, u̱ Pirigona, u̱ He̱rme̱s, u̱ Paturubas, u̱ Haramas u̱ o̱r-u̱t u̱n i o̱ u̱r-kot u̱ u̱n ne̱.<verse eid="ROM 16:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="ROM 16:15"/>Vu̱ksu̱n Pikorogus, u̱ Juriya ne̱ ne̱ta, u̱ Niriyus ne̱ u̱ hu̱no-u wa ne̱ wa ne̱ta, u̱ Orimpas, u̱ a-doru̱ Ye̱so̱ ne̱ be̱e̱t i o̱ u̱ku̱n.<verse eid="ROM 16:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="ROM 16:16"/>Vu̱ksu̱n o̱r-u̱t no̱ ne̱ u̱ ham-u̱t tu̱ u-he̱n ne̱.</para>
  <para style="li" vid="ROM 16:16">A-doru̱ Ye̱so̱ be̱e̱t to̱mgo̱n u̱s-vu̱k.<verse eid="ROM 16:16"/></para>
  <para style="s1">Burus nak to̱-tu̱ <optbreak/> ne̱t-tu̱ Roma</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17"/>O̱r-u̱t ri ne̱, u̱m cwanu̱g m-nak no̱ u̱t-to̱ remu̱ ne̱t-tu̱ o̱ mo̱t-du̱ no̱, i wadu̱ u̱t-ne̱t e̱ yage̱ do̱rru̱ u-Ru̱ tu̱msu̱ e̱ gu̱gu̱mte̱ go̱-du̱ ko̱se̱-tu̱ na kabe̱. <verse eid="ROM 16:17"/><verse number="18" style="v" sid="ROM 16:18"/>Go̱-du̱ ne̱t-tu̱ o̱ no̱m-du̱ no̱m-u̱t to̱, e̱ za no̱mu̱ Kiristi u̱s-pama da, se̱di cwan-tu̱ war-u̱t e̱. U̱ gom-tu̱ m-re̱me̱r u̱ nu-u̱t e̱, u̱ vam-tu̱ u̱s-bi ne̱, e̱ o̱ parru̱ jab-su̱ u̱t-ne̱t i o̱ e̱r-ru̱ u̱n. Ne̱t-tu̱ o̱ e̱r-ru̱ u̱n e̱ o̱ u̱ka ya'ag-u̱ re̱k-e̱. <verse eid="ROM 16:18"/><verse number="19" style="v" sid="ROM 16:19"/>Ko̱wan ho̱k u̱ka no̱ o̱tte̱ do̱rru̱ Rem-su̱ m-Re̱me̱r. U̱m ho̱k u̱r-zwar u̱ remu̱ iya. Se̱di u̱m u̱t-sa no̱ no̱m u̱s-ve̱r u̱ no̱m-u̱ o̱ so̱-o̱. No̱ shu̱'u̱t za u̱t-ba'as tu̱msu̱ no̱ so̱m no̱m-u̱t yo̱-to̱.<verse eid="ROM 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 16:20"/>Ru̱-u̱ m-yar de̱ yadu̱ no̱ m-shin u̱ no̱ do̱te̱ jangu̱ faru̱k-u̱ no̱m u̱s-te za m-tumb. Nya-u̱ Wa-ko-uyan in Ye̱so̱ o̱ u̱r-kot u̱ no̱ ne̱!<verse eid="ROM 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21"/>Timoti hu̱u̱b m-ank ri, wa o̱ vu̱k-su̱ no̱. Iya o̱ tu̱msu̱ Rushiyos, u̱ Jaso̱n ne̱, u̱ Sosipata ne̱, e̱ o̱ vu̱k-su̱ no̱, e̱ be̱e̱t o̱r-u̱t ri ne̱ e̱ Yahuda-ne̱.<note caller="+" style="f"><char style="fr" closed="false">16:21 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ACT 16:1">Pama 16:1</ref></char>.</note><verse eid="ROM 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22"/>Me̱, Tartiyus, wu̱ pane̱ uno̱ ran-o̱, u̱m o̱ vu̱k-su̱ no̱ ne̱t-tu̱ o̱ do̱rru̱ Wa-ko-uyan.<verse eid="ROM 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23"/>Gayus o̱ vu̱k-su̱ no̱. Wa gwu̱g me̱ u̱-me̱ bu-u wa, u̱-me̱ bu-u wa o̱ a-doru̱ Ye̱so̱ u̱-me̱ bo̱-u o̱ mo̱ro̱gte̱.</para>
  <para style="p" vid="ROM 16:23">Erastus, wa-cu̱n-du̱ shik u-bo̱ wa o̱ vu̱k-su̱ no̱. Tu̱msu̱ u̱ o̱r-u̱ it ne̱ Kwartus wa o̱ vu̱k-su̱ no̱.<note caller="+" style="f"><char style="fr" closed="false">16:23 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ACT 19:29">Pama 19:29</ref>; <ref loc="1CO 1:14">1Kor 1:14</ref>; <ref loc="2TI 4:20">2Tim 4:20</ref></char>.</note><verse eid="ROM 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 16:24"/>Nya-u̱ u-Ru̱ Ye̱so̱ Kiristi o̱ u̱r-kot u̱ no̱ ne̱ be̱e̱t! U̱ shu̱'u̱t iya.<note caller="+" style="f"><char style="fr" closed="false">16:24 </char><char style="ft" closed="false">Ran-tu̱ u̱t-ut u-tát panu̱g inya fe̱-ya da.</char></note><verse eid="ROM 16:24"/></para>
  <para style="s1">U̱t-vam u̱du̱ u-Ru̱</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25"/>Yagu̱n in no̱mu̱n u-Ru̱ m-sek! Wa o̱tte̱ m-shin mu̱ no̱ do̱te̱ u̱t-ees u̱-me̱ yadu̱ jab remu̱ Rem-su̱ m-Re̱me̱r su̱ Ye̱so̱ Kiristi wu̱ u̱m o̱ do̱nse̱-u̱r wa! Rem-su̱ m-Re̱me̱r u̱ sin-se̱ na yaksu̱ se̱ m-tumb ne̱. <verse eid="ROM 16:25"/><verse number="26" style="v" sid="ROM 16:26"/>Se̱di u̱ da-o̱ na rwu̱tu̱n se̱ m-zu̱n u̱-me̱ ran-tu̱ a-warru̱ Rem-su̱ u-Ru̱ ne̱. Na no̱ng iya u̱ka Ru̱-u̱ zu̱tte̱, tu̱msu̱ na ko̱sku̱ se̱ m-zu̱n u̱du̱ u̱t-ne̱t, remu̱ i-za-Yahuda-ne̱ da e̱ yu̱'u̱t jab tu̱msu̱ e̱ do̱r rem-u̱s Ye̱so̱. <verse eid="ROM 16:26"/><verse number="27" style="v" sid="ROM 16:27"/>U̱m cwanu̱g u̱zu̱, a Ye̱so̱ Kiristi se̱gu̱ in, in do̱'e̱ no̱mu̱ u-Ru̱ u̱t-vam wu̱ o̱ wa-m-nap m-mo̱mmo̱! U̱ shu̱'u̱t iya.<verse eid="ROM 16:27"/></para>
  <chapter eid="ROM 16"/>
</usx>
